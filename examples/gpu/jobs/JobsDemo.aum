-- G15: `Jobs` exercised end to end from Austral.
--
-- The module uses the linear v2 wrappers rather than raw `rs_gpu_*` imports:
-- a buffer is submitted, the job is awaited until it is terminal, the result
-- is read back into an allocated byte buffer, and every linear token is
-- consumed (read returns the buffer, free consumes it, close consumes the
-- context). `compute` returns the byte count `read` reported for the device
-- readback, so the JIT's `--expect` compares evidence from the readback (32
-- bytes copied out of the completed result), not the service's status code.
--
-- The grants live in `module.toml` next to this file; `rs_gpu_open` and
-- `rs_gpu_close` are the v1 symbols the wrappers still call.

pragma Unsafe_Module;

import Austral.Memory (
    Address,
    Pointer,
    allocateBuffer,
    deallocate,
    nullCheck,
    nullPointer
);

import Jobs (
    Context,
    OwnedBuffer,
    InFlightJob,
    PendingJob,
    CompletedResult,
    CancelledJob,
    OpenResult,
    NewBuffer,
    SubmitOutcome,
    PollOutcome,
    ReadOutcome,
    -- Union constructors are imported by name, like the functions.
    Opened,
    Refused,
    Allocated,
    BufferRefused,
    Submitted,
    SubmitRefused,
    Pending,
    Complete,
    Cancelled,
    Failed,
    Read,
    open,
    close,
    new_buffer,
    submit,
    poll,
    poll_pending,
    read,
    release,
    free_buffer
);

module body JobsDemo is
    -- Poll until the job is terminal. Each step consumes one linear job token
    -- and returns the same `PollOutcome` the terminal step produced, so no
    -- state is duplicated.
    function await_job(waiting: PendingJob): PollOutcome is
        case poll_pending(waiting) of
            when Pending(job: PendingJob) do
                return await_job(job);
            when Complete(result: CompletedResult) do
                return Complete(result => result);
            when Cancelled(job: CancelledJob) do
                return Cancelled(job => job);
            when Failed(buffer: OwnedBuffer, status: Int64) do
                return Failed(buffer => buffer, status => status);
        end case;
    end;

    -- Consume a terminal outcome while `context` is still open.
    function settle(context: Context, outcome: PollOutcome): Int64 is
        case outcome of
            when Complete(result: CompletedResult) do
                let out: Address[Nat8] := allocateBuffer(32);
                case nullCheck(out) of
                    when Some(value: Pointer[Nat8]) do
                        case read(result, out, 32) of
                            when Read(buffer: OwnedBuffer, status: Int64) do
                                deallocate(value);
                                let freed: Int64 := free_buffer(&context, buffer);
                                let closed: Int64 := close(context);
                                if (freed = 0) and (closed = 0) then
                                    return status;
                                else
                                    return -1;
                                end if;
                        end case;
                    when None do
                        -- No memory: release the retained buffer through a
                        -- zero-length read, then free and close. Every linear
                        -- token is consumed on this path too.
                        let nowhere: Address[Nat8] := nullPointer();
                        case read(result, nowhere, 0) of
                            when Read(buffer: OwnedBuffer, status: Int64) do
                                free_buffer(&context, buffer);
                                close(context);
                                return -1;
                        end case;
                end case;
            when Cancelled(job: CancelledJob) do
                let buffer: OwnedBuffer := release(job);
                free_buffer(&context, buffer);
                close(context);
                return -2;
            when Failed(buffer: OwnedBuffer, status: Int64) do
                free_buffer(&context, buffer);
                close(context);
                return status;
            when Pending(job: PendingJob) do
                return settle(context, await_job(job));
        end case;
    end;

    function begin_job(context: Context, inflight: InFlightJob): Int64 is
        case poll(inflight) of
            when Pending(job: PendingJob) do
                return settle(context, await_job(job));
            when Complete(result: CompletedResult) do
                return settle(context, Complete(result => result));
            when Cancelled(job: CancelledJob) do
                return settle(context, Cancelled(job => job));
            when Failed(buffer: OwnedBuffer, status: Int64) do
                return settle(context, Failed(buffer => buffer, status => status));
        end case;
    end;

    function run_job(context: Context, owned: OwnedBuffer): Int64 is
        case submit(&context, owned, 8, 5) of
            when Submitted(job: InFlightJob) do
                return begin_job(context, job);
            when SubmitRefused(buffer: OwnedBuffer, status: Int64) do
                free_buffer(&context, buffer);
                close(context);
                return status;
        end case;
    end;

    function compute(): Int64 is
        case open(1, -1) of
            when Opened(context: Context) do
                case new_buffer(&context, 8) of
                    when Allocated(buffer: OwnedBuffer) do
                        return run_job(context, buffer);
                    when BufferRefused(status: Int64) do
                        close(context);
                        return status;
                end case;
            when Refused(status: Int64) do
                return status;
        end case;
    end;

    function main(): ExitCode is
        return ExitSuccess();
    end;
end module body.

-- G16b: the source half of the wgsl-f32-v1 profile fixture.
--
-- `axpy` is the ordinary affine map: one multiply and one add, both from the
-- canonical TrappingArithmetic(Float32) instance. It is compiled twice in
-- scripts/gpu-f32-profile: once for the GPU bundle and once through the C
-- backend for the CPU oracle, so a WGSL emitter that widened to f64 would
-- disagree with the C row at 2^24.
--
-- `cancel` is the cancellation-sensitive case: (x + 1) - x rounds to 0 once x
-- reaches 2^24, because the addition loses the 1. Every value stays finite and
-- normal, so the profile's admitted domain covers it.
module body F32Affine is
    function axpy(x: Float32, y: Float32): Float32 is
        return trappingAdd(trappingMultiply(x, 2.5), y);
    end;

    function cancel(x: Float32): Float32 is
        return trappingSubtract(trappingAdd(x, 1.0), x);
    end;
end module body.

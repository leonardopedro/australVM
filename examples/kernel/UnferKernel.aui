import Austral.Memory (
    Address
);

module UnferKernel is
    """
    Typed Austral bindings for the unfer probability kernel C ABI (`uk_*`).
    Byte buffers are passed as `Address[Nat8]` (raw pointer) plus an `Int64`
    length, matching the i64-centric CPS calling convention. Return values
    follow the kernel convention: `>= 0` success (handle / byte count), `< 0`
    is `-code` (see unfer docs/PROTOCOL.md).

    Model handles come in two flavours:

      * The raw `Int64` returned by `kernelModelCreate` / consumed by
        `kernelModelFree` — the direct C ABI, where freeing is caller
        discipline.

      * `Model`, a **linear** wrapper (P2.7). A `Model` value must be consumed
        exactly once by `freeModel`: forgetting it is a leak the compiler
        rejects, and consuming it twice is a use-after-free the compiler
        rejects. Prefer `Model` in module code; the linear type makes
        `uk_model_free` an obligation enforced by the type system rather than
        by convention.
    """
    type Model: Linear;

    function kernelVersion(): Int64;
    pragma Liquid_Requires(Contract => "len >= 0");
    pragma Liquid_Ensures(Contract => "result >= 0 || (result <= -1001 && result >= -1011) || (result <= -2001 && result >= -2005) || (result <= -3001 && result >= -3002) || (result <= -4001 && result >= -4005) || (result <= -4100 && result >= -4102) || (result <= -4200 && result >= -4203) || (result <= -4401 && result >= -4403) || (result <= -4501 && result >= -4501) || (result <= -4601 && result >= -4603) || (result <= -4701 && result >= -4701) || (result <= -4801 && result >= -4804) || (result <= -4901 && result >= -4913) || (result <= -5000 && result >= -5000) || (result <= -6001 && result >= -6005) || (result <= -7001 && result >= -7107) || (result <= -7201 && result >= -7203) || (result <= -7301 && result >= -7308) || (result <= -7401 && result >= -7419) || (result <= -7501 && result >= -7512)");
    function kernelInit(cfg: Address[Nat8], len: Int64): Int64;
    pragma Liquid_Requires(Contract => "len >= 0");
    pragma Liquid_Ensures(Contract => "result >= 0 || (result <= -1001 && result >= -1011) || (result <= -2001 && result >= -2005) || (result <= -3001 && result >= -3002) || (result <= -4001 && result >= -4005) || (result <= -4100 && result >= -4102) || (result <= -4200 && result >= -4203) || (result <= -4401 && result >= -4403) || (result <= -4501 && result >= -4501) || (result <= -4601 && result >= -4603) || (result <= -4701 && result >= -4701) || (result <= -4801 && result >= -4804) || (result <= -4901 && result >= -4913) || (result <= -5000 && result >= -5000) || (result <= -6001 && result >= -6005) || (result <= -7001 && result >= -7107) || (result <= -7201 && result >= -7203) || (result <= -7301 && result >= -7308) || (result <= -7401 && result >= -7419) || (result <= -7501 && result >= -7512)");
    function kernelModelCreate(spec: Address[Nat8], len: Int64): Int64;
    pragma Liquid_Requires(Contract => "model >= 0");
    pragma Liquid_Ensures(Contract => "result == 0");
    function kernelModelFree(model: Int64): Int64;

    """
    Create a model directly from a `Span[Nat8, Static]` (e.g. a JSON string
    literal): decomposes the span into its data pointer and length and forwards
    to `kernelModelCreate`. This is the ergonomic entry for module code, which
    can pass a JSON spec literal without manual pointer/length juggling.
    """
    function kernelModelCreateStr(spec: Span[Nat8, Static]): Int64;

    """
    Compute the probability of an event predicate (given as a `Span[Nat8,
    Static]` JSON) on a model handle. The kernel computes and stores the
    probability; the return is the kernel status code (`0` on success).
    """
    function kernelEventProbabilityStr(model: Int64, event: Span[Nat8, Static]): Int64;

    """
    Evolve a model for the duration/options given as a `Span[Nat8, Static]` JSON
    literal (e.g. `"{\"t\":1.0}"`): decomposes the span into pointer + length and
    forwards to `kernelEvolve`. The ergonomic evolve entry for module code.
    """
    function kernelEvolveStr(model: Int64, opts: Span[Nat8, Static]): Int64;

    """
    Wrap a raw model handle (as returned by `kernelModelCreate`) in a linear
    `Model`. From here the type system tracks the obligation to free it.
    """
    function wrapModel(handle: Int64): Model;

    """
    Read the raw handle out of a borrowed `Model` without consuming it, so a
    `Model` can drive a sequence of `kernel*` calls before being freed.
    """
    generic [R: Region]
    function modelHandle(model: &[Model, R]): Int64;

    """
    Consume a linear `Model`, freeing the underlying kernel session via
    `uk_model_free`. Returns the kernel's status code.
    """
    function freeModel(model: Model): Int64;
    function kernelSetPrior(model: Int64, json: Address[Nat8], len: Int64): Int64;
    function kernelSetHamiltonian(model: Int64, json: Address[Nat8], len: Int64): Int64;
    pragma Liquid_Requires(Contract => "model >= 0");
    pragma Liquid_Requires(Contract => "len >= 0");
    pragma Liquid_Ensures(Contract => "result >= 0 || (result <= -1001 && result >= -1011) || (result <= -2001 && result >= -2005) || (result <= -3001 && result >= -3002) || (result <= -4001 && result >= -4005) || (result <= -4100 && result >= -4102) || (result <= -4200 && result >= -4203) || (result <= -4401 && result >= -4403) || (result <= -4501 && result >= -4501) || (result <= -4601 && result >= -4603) || (result <= -4701 && result >= -4701) || (result <= -4801 && result >= -4804) || (result <= -4901 && result >= -4913) || (result <= -5000 && result >= -5000) || (result <= -6001 && result >= -6005) || (result <= -7001 && result >= -7107) || (result <= -7201 && result >= -7203) || (result <= -7301 && result >= -7308) || (result <= -7401 && result >= -7419) || (result <= -7501 && result >= -7512)");
    function kernelEvolve(model: Int64, opts: Address[Nat8], len: Int64): Int64;
    pragma Liquid_Requires(Contract => "model >= 0");
    pragma Liquid_Requires(Contract => "len >= 0");
    pragma Liquid_Ensures(Contract => "result >= 0 || (result <= -1001 && result >= -1011) || (result <= -2001 && result >= -2005) || (result <= -3001 && result >= -3002) || (result <= -4001 && result >= -4005) || (result <= -4100 && result >= -4102) || (result <= -4200 && result >= -4203) || (result <= -4401 && result >= -4403) || (result <= -4501 && result >= -4501) || (result <= -4601 && result >= -4603) || (result <= -4701 && result >= -4701) || (result <= -4801 && result >= -4804) || (result <= -4901 && result >= -4913) || (result <= -5000 && result >= -5000) || (result <= -6001 && result >= -6005) || (result <= -7001 && result >= -7107) || (result <= -7201 && result >= -7203) || (result <= -7301 && result >= -7308) || (result <= -7401 && result >= -7419) || (result <= -7501 && result >= -7512)");
    function kernelCondition(model: Int64, event: Address[Nat8], len: Int64): Int64;
    function kernelEventProbability(model: Int64, event: Address[Nat8], len: Int64): Int64;
    function kernelObserve(model: Int64, obs: Address[Nat8], len: Int64): Int64;
    pragma Liquid_Requires(Contract => "model >= 0");
    pragma Liquid_Requires(Contract => "cap >= 0");
    pragma Liquid_Ensures(Contract => "result >= 0");
    function kernelGetResult(model: Int64, buf: Address[Nat8], cap: Int64): Int64;
    pragma Liquid_Requires(Contract => "cap >= 0");
    pragma Liquid_Ensures(Contract => "result >= 0");
    function kernelLastError(buf: Address[Nat8], cap: Int64): Int64;

    """
    Consult the corrupt-snapshot recovery report of the H4 durable store:
    the fail-visible message from a torn `snapshot.bin` that could not be
    imported (the store started empty and preserved the evidence). Returns
    the report length (0 = clean open / no store); the report itself is
    copied into `buf` (min of length and `cap`). Never fails.
    """
    function kernelDurableSnapshotError(buf: Address[Nat8], cap: Int64): Int64;

    """
    Consult the durable-store live-status JSON: backend label, per-stream
    record counts, persist counter, and `snapshot_load_error` (null when
    clean). Buffer-out protocol as in `kernelDurableSnapshotError`.
    """
    function kernelDurableStatus(buf: Address[Nat8], cap: Int64): Int64;
end module.

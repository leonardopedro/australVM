; Shared test helpers: TestUtil is used by several (tests) stanzas, so it
; lives in its own library and every stanza lists explicit modules (dune
; refuses modules used across several stanzas otherwise).
(library
 (name test_util)
 (modules TestUtil)
 (wrapped false)
 (libraries austral_core ounit2))

(tests
 (names
  ExpressionParserTest
  UtilTest
  CRendererTest)
 (modules
  ExpressionParserTest
  UtilTest
  CRendererTest)
 (libraries austral_core ounit2 test_util))

(tests
 (names
  CliUtilTest
  CliParserTest
  PluginTest
  DeltanetPluginTest
  FormalizePluginTest
  CliEngineTest)
 (modules
  CliUtilTest
  CliParserTest
  PluginTest
  DeltanetPluginTest
  FormalizePluginTest
  CliEngineTest)
 ; austral_rust_bridge is needed so rust_bridge.c (which defines the au_*
 ; runtime primitives the cranelift bridge .so imports) is linked into the
 ; executable; without it the .so fails to load (undefined au_* symbol).
 (libraries austral_lib austral_rust_bridge ounit2 unix str test_util))

(tests
 (names LiquidInferTest)
 (modules LiquidInferTest)
 (libraries austral_liquid ounit2 zarith test_util))

; L9: index-carrying types over TRL terms. Same libraries as LiquidInferTest —
; the type layer, the parser, and Z for the index literals.
(tests
 (names LiquidIndexTypesTest)
 (modules LiquidIndexTypesTest)
 (libraries austral_liquid ounit2 zarith test_util))

; L9 erasure: compiles two variants of the same module and compares the emitted
; CPS bytes. Needs the compiler binary and the JIT bridge, so it links the
; bridge library and stages `austral` alongside the test executable.
(tests
 (names LiquidErasureTest)
 (modules LiquidErasureTest)
 (libraries ounit2 unix austral_rust_bridge)
 (deps ../bin/austral.exe))

; L10 Cycle B: the checker extended by extracted code. Links `austral_liquid`
; because the code under test is the extracted `LiquidMeasure` plus the pass
; that consults it.
(tests
 (names LiquidSubsetTest)
 (modules LiquidSubsetTest)
 (libraries austral_liquid austral_core ounit2 test_util))

; §5.6/§5.9/T5: the VC set itself. Drives the real compiler (so the pass runs
; where it actually runs) with `--target-type=tc`, dumps the `.mlw`, and
; compares it against a pinned golden — the same posture as the L9 erasure
; test, for the same reason: the claim is about emitted text, so the test
; reads emitted text. `austral_core` is needed for the hand-built `Tast` the
; T5 cases use (no source program can reach that branch; see the header).
(tests
 (names LiquidVCTest)
 (modules LiquidVCTest)
 (libraries austral_liquid austral_core ounit2 unix test_util)
 ; The golden is a declared dependency, not an incidental read: without it
 ; dune does not stage the file into the build tree, and the test would report
 ; the golden as missing while it sits in the source tree. `austral.exe` is
 ; the compiler the test drives.
 (deps ../bin/austral.exe
       ../lib/liquid/golden/vc-callsite-and-invariant.mlw
       ../lib/liquid/golden/vc-operators.mlw
       ../lib/liquid/golden/vc-arithmetic.mlw
       ../lib/liquid/golden/vc-projection.mlw))

(tests
 (names JitTest)
 (modules JitTest)
 (libraries austral_cps_gen austral_rust_bridge ounit2))

; avm-pkg spec task 2.1: the package totality pass and the Derivation
; JSON export (lib/Totality.ml, lib/DerivAst.ml). Hand-built typed ASTs —
; no codegen, so austral_core alone is enough.
(tests
 (names TotalityTest DerivAstTest)
 (modules TotalityTest DerivAstTest)
 (libraries austral_core ounit2 test_util))

# Build artifacts
_build/
target/
result
*.o
*.so
*.a
*.hi

# run_demo.sh compiles the hosted module in place (mathed_kernel)
examples/modules/mathed_kernel/mathed_kernel

# Editor/OS temp files
*~
\#*\#
.DS_Store

# Rust build artifacts
arctic_authority/target/

# Lean / lake build artifacts
.lake/

# Generated files
lib/BuiltInModules.ml

# Test binaries (rebuilt by make)
safestos/test/hotswap_e2e
safestos/cranelift/combined.o

# Stale binary data
*.bin

# Root-level compiled test binaries
test_const
test_cps
libaustral_cranelift_bridge.so

# Root compiler binary (built by `make`/`make bridge`; CI uploads it as an
# ephemeral artifact, never checked out and used directly)
/austral

# Docs/planning artifacts
docs/history/
examples/modules/demo_hosted/module.cps

# Compiler-generated debug output
calltree.html
error.html

# runner.py's per-run failure dump (README: "it is not checked in" — this
# makes that true; a 377 KB artifact from one bad run sat untracked)
FAILURES.txt

engram.md

# The macro-expanded Metamath dump: 523 MB, GitHub rejects any commit
# carrying it (GH001, 100 MB limit) — it is a build artifact of set.mm and
# stays on disk, out of history.
mm0/metamath/set.mmu

# Lean→MM0 corpus statement pipeline (scripts/lean-corpus-mm0): the NDJSON
# exports and compiled .mmb are regenerable intermediates; the .mm0/.mm1
# statements are the artifacts.
mm0/exports/
mm0/statements/*.mmb
scripts/__pycache__/
mm0/olean/
# A sweep's own bookkeeping (scripts/lean-corpus-sweep): the state file is what
# makes a run resumable, the logs are 883 per-module transcripts. Both describe
# one run on one host; the committed artifacts are the statements themselves.
mm0/sweep-state.tsv
mm0/sweep-logs/

# set.mm-as-MM0 pilot (mm0/pilot): the set.mm0/set.mmu library is provisioned
# toolchain state (548 MB), and the .mmb plus joined spec are regenerable from
# pilot.mm1 by `mm0-rs compile` + concatenation. Only pilot.mm1 is the artifact.
mm0/pilot/metamath
mm0/pilot/*.mmb
mm0/pilot/pilot_joined.mm0
mm0/pilot/*.mmb
mm0/pilot/joined*.mm0
mm0/pilot/ported_stmt.mm0


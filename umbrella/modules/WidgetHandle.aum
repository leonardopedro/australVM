pragma Unsafe_Module;

import Austral.Memory (
    Pointer,
    refMutToPointer
);

module body WidgetHandle is
    -- The two words a generated `__new` wrapper wrote. Linear, so the only way
    -- to end a value is `dispose`, and it can only end once.
    record Widget: Linear is
        lo: Int64;
        hi: Int64;
    end;

    function adopt(lo: Int64, hi: Int64): Widget is
        return Widget(lo => lo, hi => hi);
    end;

    -- The import names the handle's *target*, not a wrapper: the compiler
    -- derives `avm_widget__dispose` from it (that is the symbol this call
    -- lowers to) and emits the `abi handle 1` descriptor the umbrella
    -- generator turns into both wrappers, `avm_widget__new` and
    -- `avm_widget__dispose`. Both parameters are 64-bit scalars, so the call
    -- itself is word-native: the words cross as they are.
    pragma Foreign_Import(External_Name => "avm_widget");
    pragma Handle_Ownership(Object => "widget", Constructor => "avm_widget_ctor", Destructor => "avm_widget_dtor", Params => "2", Use => "avm_widget_read");
    function widgetDispose(lo: Int64, hi: Int64): Int64 is end;

    -- The reading import names the generated `<target>__use` wrapper, which
    -- resolves the words in the same registry and calls the provider's reader
    -- (`avm_widget_read`, the pragma's `Use`) to hand one word back. The out
    -- slot is a local `Pointer`, not an `Address`: the wrapper writes one word
    -- through it, a pointer is the word the C ABI takes, and this way the
    -- module needs no identity `@embed` for it — the JIT declares `__embed`
    -- with one signature per module, so a module that embeds both an
    -- allocation and an identity currently fails to compile. A refusal leaves
    -- the slot untouched.
    pragma Foreign_Import(External_Name => "avm_widget__use");
    function widgetUse(lo: Int64, hi: Int64, out: Pointer[Int64]): Int64 is end;

    generic [R: Region]
    function read(widget: &[Widget, R]): Int64 is
        var word: Int64 := -1;
        let slot: Pointer[Int64] := refMutToPointer(&!word);
        let status: Int64 := widgetUse(widget->lo, widget->hi, slot);
        if status = 0 then
            return word;
        else
            return -1;
        end if;
    end;

    function dispose(widget: Widget): Int64 is
        -- Destructuring is what discharges the linear obligation; the two
        -- words go back to the registry, which is the only place that decides
        -- whether a destructor runs.
        let { lo: Int64, hi: Int64 } := widget;
        return widgetDispose(lo, hi);
    end;

    function main(): ExitCode is
        -- The words a granted `__new` produced. Calling `__new` from source
        -- needs an out slot it can write through, and the pair read back out
        -- of it: in the JIT that is an allocation (`__embed` at two words) plus
        -- a load (`__embed` at one), and the bridge declares `__embed` once per
        -- module, so it refuses the pair -- a measured limitation, not a
        -- decision here. Until that is fixed `adopt` takes the words the
        -- wrapper test's `dlsym` call got.
        let widget: Widget := adopt(1, 2);
        -- The reading seam, called: `read` hands the words to `__use`, which
        -- resolves them in the registry and returns the provider's word. The
        -- words above name no live slot, so this is refused and `read` says
        -- so with `-1`; that refusal is the module-side witness for `__use`.
        let value: Int64 := read(&widget);
        let outcome: Int64 := dispose(widget);
        if value = -1 then
            if outcome = 0 then
                return ExitSuccess();
            else
                return ExitFailure();
            end if;
        else
            return ExitFailure();
        end if;
    end;
end module body.

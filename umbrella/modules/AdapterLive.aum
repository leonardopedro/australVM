-- umbrella/modules/AdapterLive.aum — U11's live path.
--
-- Every extern here has a signature the scalar encoding cannot pass as a raw
-- word (Int32, Bool, Float32, Float64), so the CPS lowering names
-- `<target>__adapter` and the build must generate, compile and load the wrapper
-- before the JIT can resolve the call. `compute` checks each mediated result and
-- returns one of them, so a wrong value is a wrong RESULT rather than a passing
-- run.
--
-- Floats cross as their IEEE-754 bits in the single-word CPS value model, at
-- their own width: a Float64 word is the f64 bits, a Float32 word is the f32
-- bits zero-extended (the ABI's `F32` decode refuses a word with bits above
-- bit 31, which is what keeps the two widths distinguishable).
--
-- Float64: `rs_scale` takes a float and returns one, and the CPS-lowered
-- arithmetic on the result is the bridge's f64 primitives (`au_f64_*`), not the
-- integer `Sub`/`Mul` opcodes — those would compute on the bit patterns and the
-- multiply would trap as integer overflow. 2.5 * 4 = 10.0, then
-- ((10.0 + 2.5) - 0.5) * 2.0 / 4.0 = 6.0 = 0x4018000000000000 = 4618441417868443648,
-- so a literal that is rounded on the way in, an arithmetic op that lands on the
-- integer path, or a result that is not carried as bits shows up as a different
-- number.
--
-- Float32: `rs_f32_bits(1.5)` checks a literal written straight into an argument
-- position (0x3FC00000 = 1069547520), and `rs_f32_scale(2.5, 1)` then
-- `rs_f32_bits` checks a literal held in a Float32 local (0x40200000 =
-- 1075838976) plus the parameter decode and the result encode. An f64 literal
-- in either place would arrive with bits above 31 set and the wrapper would
-- refuse it, so neither number can be produced by an unnarrowed word.
--
-- Float32 arithmetic has no bridge primitive of its own: the CPS lowering emits
-- `au_f32_to_f64` on both operands, the same `au_f64_*` op, then
-- `au_f64_to_f32`, so `(((2.5 + 1.5) * 4.0) - 2.0) / 2.0` must read back as
-- 7.0 = 0x40E00000 = 1088421888. Computing on the f32 words as integers, or
-- skipping the narrow, gives a different word.
pragma Unsafe_Module;

module body AdapterLive is
    pragma Foreign_Import(External_Name => "rs_narrow");
    pragma Rust_Ownership(Params => "owned", Return => "owned");
    function rs_narrow(width: Int32): Int64 is
    end;

    pragma Foreign_Import(External_Name => "rs_toggle");
    pragma Rust_Ownership(Params => "owned", Return => "owned");
    function rs_toggle(on: Bool): Bool is
    end;

    pragma Foreign_Import(External_Name => "rs_scale");
    pragma Rust_Ownership(Params => "owned, owned", Return => "owned");
    function rs_scale(factor: Float64, value: Int64): Float64 is
    end;

    pragma Foreign_Import(External_Name => "rs_bits");
    pragma Rust_Ownership(Params => "owned", Return => "owned");
    function rs_bits(value: Float64): Int64 is
    end;

    pragma Foreign_Import(External_Name => "rs_f32_scale");
    pragma Rust_Ownership(Params => "owned, owned", Return => "owned");
    function rs_f32_scale(factor: Float32, value: Int64): Float32 is
    end;

    pragma Foreign_Import(External_Name => "rs_f32_bits");
    pragma Rust_Ownership(Params => "owned", Return => "owned");
    function rs_f32_bits(value: Float32): Int64 is
    end;

    function compute(): Int64 is
        let width: Int32 := 7;
        let narrowed: Int64 := rs_narrow(width);
        let literal_bits: Int64 := rs_f32_bits(1.5);
        let factor: Float32 := 2.5;
        let scaled32: Float32 := rs_f32_scale(factor, 1);
        let scaled32_bits: Int64 := rs_f32_bits(scaled32);
        if narrowed = 7 then
            if rs_toggle(false) then
                if literal_bits = 1069547520 then
                    if scaled32_bits = 1075838976 then
                        let f32_arithmetic: Float32 := (((factor + 1.5) * 4.0) - 2.0) / 2.0;
                        let f32_arithmetic_bits: Int64 := rs_f32_bits(f32_arithmetic);
                        if f32_arithmetic_bits = 1088421888 then
                            let scaled: Float64 := rs_scale(2.5, 4);
                            let arithmetic: Float64 := (((scaled + 2.5) - 0.5) * 2.0) / 4.0;
                            let bits: Int64 := rs_bits(arithmetic);
                            if bits = 4618441417868443648 then
                                return bits;
                            else
                                return 0;
                            end if;
                        else
                            return 0;
                        end if;
                    else
                        return 0;
                    end if;
                else
                    return 0;
                end if;
            else
                return 0;
            end if;
        else
            return 0;
        end if;
    end;

    function main(): ExitCode is
        return ExitSuccess();
    end;
end module body.

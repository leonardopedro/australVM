axiom decl_BookProof_UnboundedPolar_sqrtOp__proof_1: $ teq (tapp (tapp (tentity 9) (tentity 0)) (tapp (tapp (tentity 9) (tapp (tentity 1) (tvar 0))) (tapp (tapp (tapp (tentity 2) (tvar 1)) (tapp (tapp (tentity 3) (tvar 1)) (tapp (tapp (tentity 4) (tvar 1)) (tapp (tapp (tentity 5) (tvar 1)) (tapp (tapp (tentity 6) (tvar 1)) (tvar 0)))))) (tapp (tapp (tentity 7) (tvar 1)) (tapp (tapp (tentity 8) (tvar 1)) (tapp (tapp (tentity 6) (tvar 1)) (tvar 0))))))) ttrue $;


delimiter $ ( ) $;

-- ── The agent signature (untyped de Bruijn terms, mirroring AgentKind) ────

term tvar (i: nat): Term;                  -- De Bruijn index (open terms)
term tapp (f a: Term): Term;               -- App agent
term tabs (b: Term): Term;                 -- Abs agent (binder)
term tint (n: nat): Term;                  -- Int64 literal (payload bits)
term tf64 (bits: nat): Term;               -- F64 literal (IEEE-754 bits)
term ttrue: Term;                          -- Bool literal
term tfalse: Term;                         -- Bool literal
term tcon (tag: nat): Term;                -- Con agent head (TagId)
term tnil: Term;                           -- constructor argument spine, end
term tcons (h t: Term): Term;              -- constructor argument spine, cons
term tfold (f i l: Term): Term;            -- Fold agent (list fold)
term tdup (level: nat): Term;              -- Dup agent (duplication level)
term tera: Term;                           -- Era agent (erasure)
term tprim (op: nat): Term;                -- Prim agent (unf.rs prim_tag byte)

term teq (t u: Term): Prop;
term timp (p q: Prop): Prop;               -- implication (the only connective
                                            -- this theory needs)
infixr timp: $->$ prec 25;

axiom teq_refl (t: Term): $ teq t t $;
axiom teq_symm (t u: Term): $ teq t u $ > $ teq u t $;
axiom teq_trans (t u v: Term): $ teq t u $ > $ teq u v $ > $ teq t v $;


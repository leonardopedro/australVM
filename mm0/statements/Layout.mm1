--
-- cic.mm0 — the MM0 target theory for the Lean4→DeltaNets→MM0 pipeline,
-- adapted to this project's *existing* term language (unfer/logos deltanet)
-- rather than a generic CIC axiomatization.
--
-- Why adapted: the generic plan (docs/lean4mm0.md) axiomatized the Calculus
-- of Inductive Constructions, but the conversion checker this project
-- actually runs is `logos::deltanet` — a first-order interaction-net
-- reducer over a fixed agent signature (App, Abs, Con, Fold, Dup, Era,
-- Prim, Lit, Entity). Definitional equality here is *net isomorphism after
-- reduction* (the unique-normal-form property), certified by the
-- isomorphism witness π from `deltanet::unf::isomorphism_witness`. This
-- theory speaks exactly that language, so a proof trace emitted for it
-- names real pipeline objects instead of hypothetical ones.
--
-- Validated end-to-end on 2026-10-23: `mm0-rs compile cic.mm0 -> cic.mmb`
-- (3 sorts, 20 terms, 11 axioms, exit 0) and `mm0-c cic.mmb < cic.mm0`
-- (exit 0). Phase D (docs/lean4mm0.md §5/§7) has landed the *theorem*
-- side: `australVM/mm0/gap_certificate.{mm0,mm1}` — generated by
-- `australVM/scripts/lean2mm0` from the nanoda-verified lean4export of
-- `../timepiece/GapCertificate.lean`, compiled by mm0-rs (3 sorts, 46
-- term/def, 39 ax/thm), verified by mm0-c; gated in
-- `australVM/scripts/verify-invariants`.
--
-- Phase-D note on rule form: the structural rules below state their
-- premises with `>` (hypothesis binders), not `->` inside the formula.
-- MM0's logic has no internal modus ponens — a `->`-inside-formula axiom
-- only proves that an *implication term* is derivable, and can never be
-- *applied* to reach a conclusion. Hypothesis form is the applicable
-- inference rule, and it is what the generated proofs consume.

provable sort Prop;
sort Term;
sort nat;                        -- index/tag/level/op/bit payloads (no
                                 -- numerals needed: see teval below)

-- Secondary-lexer delimiters: parentheses are standalone tokens in math
-- strings, so `teq (tapp f a) b` lexes (mm0-rs splits formulas on
-- whitespace otherwise). Same declaration as examples/hello.mm0.
delimiter $ ( ) $;

-- ── The agent signature (untyped de Bruijn terms, mirroring AgentKind) ────

term tvar (i: nat): Term;                  -- De Bruijn index (open terms)
term tapp (f a: Term): Term;               -- App agent
term tabs (b: Term): Term;                 -- Abs agent (binder)
term tint (n: nat): Term;                  -- Int64 literal (payload bits)
term tf64 (bits: nat): Term;               -- F64 literal (IEEE-754 bits)
term ttrue: Term;                          -- Bool literal
term tfalse: Term;                         -- Bool literal
term tcon (tag: nat): Term;                -- Con agent head (TagId)
term tnil: Term;                           -- constructor argument spine, end
term tcons (h t: Term): Term;              -- constructor argument spine, cons
term tfold (f i l: Term): Term;            -- Fold agent (list fold)
term tdup (level: nat): Term;              -- Dup agent (duplication level)
term tera: Term;                           -- Era agent (erasure)
term tprim (op: nat): Term;                -- Prim agent (unf.rs prim_tag byte)
term tentity (sym: nat): Term;             -- Entity (symbol-table-indexed name)
term tsubst (b a: Term): Term;             -- De Bruijn substitution (meta)
term teval (op n m: nat): nat;             -- the ground evaluator: the value
                                            -- the reducer folds op(n, m) to.
                                            -- Uninterpreted here; the emitter
                                            -- grounds each prim_tag byte.

-- ── Judgmental equality ──────────────────────────────────────────────────

term teq (t u: Term): Prop;
term timp (p q: Prop): Prop;               -- implication (the only connective
                                            -- this theory needs)
infixr timp: $->$ prec 25;

axiom teq_refl (t: Term): $ teq t t $;
axiom teq_symm (t u: Term): $ teq t u $ > $ teq u t $;
axiom teq_trans (t u v: Term): $ teq t u $ > $ teq u v $ > $ teq t v $;

-- Substitution is the structural congruence the beta rule needs. It is
-- axiomatized at the meta level here (the emitter never proves it; the
-- net reducer *is* the substitution engine).
axiom tsubst_beta (b a: Term): $ teq (tapp (tabs b) a) (tsubst b a) $;
axiom teq_subst (b b2 a a2: Term):
  $ teq b b2 $ > $ teq a a2 $ > $ teq (tsubst b a) (tsubst b2 a2) $;
axiom teq_app (f f2 a a2: Term):
  $ teq f f2 $ > $ teq a a2 $ > $ teq (tapp f a) (tapp f2 a2) $;

-- ── Reduction rules of the agent signature (the net rewrite system) ──────
-- Each axiom mirrors an arm of `deltanet::reducer`'s interact function.

-- Fold ↔ Con: the two Fold rules (return init / unfold one cons cell).
axiom fold_nil (f i: Term): $ teq (tfold f i tnil) i $;
axiom fold_cons (f i h t: Term):
  $ teq (tfold f i (tcons h t)) (tapp (tapp f h) (tfold f i t)) $;

-- Prim ↔ Lit, Lit: native evaluation. The reducer folds ground prims
-- natively (the graph-to-native trap), so this is the axiom schema whose
-- ground instances the emitter emits.
axiom prim_eval (op n m: nat):
  $ teq (tapp (tapp (tprim op) (tint n)) (tint m)) (tint (teval op n m)) $;

-- Era propagation: an erased agent collapses (the net-level statement the
-- reducer enforces by rewiring; here only the root-facing form is needed).
axiom era_collapse (t: Term): $ teq (tapp tera t) tera $;

-- ── The conversion certificate rule (isomorphism witness) ────────────────
-- The heart of the pipeline: two normal forms that are isomorphic as rooted
-- port graphs are judgmentally equal, and the certificate is the witness π
-- — the node permutation from `deltanet::unf::isomorphism_witness`, whose
-- kernel-side check (`IsomorphismWitness::verifies`) requires the pairing to
-- preserve agent kinds and aux-port wiring. `valid_iso` is the *checked*
-- predicate: the emitter packages a concrete π, and mm0-c's consumer checks
-- it against the two concrete net encodings; MM0 logic only records that a
-- checked certificate entails equality.

term valid_iso (t u cert: Term): Prop;     -- cert encodes a witnessed π

axiom net_isomorphism_step (t u cert: Term):
  $ valid_iso t u cert $ > $ teq t u $;

-- ── The UNF theorem (what the whole pipeline certifies) ──────────────────
-- Reduction confluent ⟹ normal forms unique ⟹ equality of normal forms
-- decides judgmental equality of the encoded terms. Corroborated by
-- `unfer/logos/lean/Confluence.lean` (kernel-computed rfl proofs, exported
-- via lean4export and re-verified in nanoda) and at runtime by the fixed-
-- point confluence self-check in `logos::translate`.


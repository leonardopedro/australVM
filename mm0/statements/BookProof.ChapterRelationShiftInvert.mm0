-- ── Reduction rules of the agent signature (the net rewrite system) ──────
-- Each axiom mirrors an arm of `deltanet::reducer`'s interact function.

-- Fold ↔ Con: the two Fold rules (return init / unfold one cons cell).
axiom fold_nil (f i: Term): $ teq (tfold f i tnil) i $;
axiom fold_cons (f i h t: Term):
  $ teq (tfold f i (tcons h t)) (tapp (tapp f h) (tfold f i t)) $;

-- Prim ↔ Lit, Lit: native evaluation. The reducer folds ground prims
-- natively (the graph-to-native trap), so this is the axiom schema whose
-- ground instances the emitter emits.
axiom prim_eval (op n m: nat):

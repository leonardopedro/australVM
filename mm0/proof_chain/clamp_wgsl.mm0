def wgsl_clamp (x: u32): u32 = $ umeet x u100 $;
theorem wgsl_clamp_matches_ir (x: u32):
  $ ueq (wgsl_clamp x) (ir_clamp x) $;
theorem wgsl_inherits_source_bound (x: u32):
  $ ule (wgsl_clamp x) u100 $;

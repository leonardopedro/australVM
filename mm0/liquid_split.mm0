-- [binder: span w]
-- [binder: number k]
term ev_w: Span;
term ev_k: Val;
-- [width: 8 (module declaration)]
term ev_width: Val;

-- [call: main calls split] — the guard is discharged by the pilot, not assumed:
-- the call's `Requires` is instantiated and decided (literal arithmetic or
-- a fact the caller already assumes).
--   guard ev_w ev_k
term ev_guarded: Prop;

-- [  conservation: 3 + 5 = 8 [checked]]
-- [  disjoint: 13 <= 13 [checked]]
--   veq (add (span_len (split_left ev_w ev_k))
--       (span_len (split_right ev_w ev_k))) (span_len ev_w)
--   vle (add (span_off (split_left ev_w ev_k))
--       (span_len (split_left ev_w ev_k)))
--       (span_off (split_right ev_w ev_k))
term ev_conservation: Prop;
term ev_disjoint: Prop;
-- [  byte ranges: left [80,104) len=24, right [104,144) len=40]
--   fits_int64 (byte_extent (split_right ev_w ev_k) ev_width)
term ev_bytes_fit: Prop;


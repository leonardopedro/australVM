-- evidence: record: Window fields base,off,len
-- evidence: union: Halves case Both slots left,right
-- evidence: decl: record id=282
-- evidence: decl: split id=289
-- evidence: decl: length id=286
-- evidence: decl: offset id=287
-- evidence: binder: span w
-- evidence: binder: number k
-- evidence: premise: ((0 <= k) && (k <= length(w)))
-- evidence: premise: k <= n
-- evidence: premise: the extent [off, off+n) fits the validated allocation domain
-- evidence: premise: an element is `width` bytes, with width > 0 (layout premise)
-- evidence: width: 8 (module declaration)
-- evidence: obligation liquid-split.extent-conservation: left = (w.off, k)
-- evidence: obligation liquid-split.extent-conservation: right = ((+ w.off k), (- w.len k))
-- evidence: obligation left.base = right.base = w.base [checked against the law]
-- evidence: obligation conservation: left.len + right.len = n [stated: L11d.2]
-- evidence: obligation disjoint: no element index belongs to both halves [stated: L11d.2]
-- evidence: obligation bytes: byte address = element index * width, checked to fit Int64 [premise: width]
-- evidence: call: main calls split
-- evidence:   operands: off=10 n=8 k=3
-- evidence:   interpretation: off=checked 10 n=checked 8 k=checked 3
-- evidence:   element ranges: left [10,13) len=3, right [13,18) len=5
-- evidence:   conservation: 3 + 5 = 8 [checked]
-- evidence:   disjoint: 13 <= 13 [checked]
-- evidence:   byte ranges: left [80,104) len=24, right [104,144) len=40
--
-- theory: self-declared vocabulary — the sorts and terms below are this
-- artifact's whole theory; it imports no rule from `cic.mm0`, `isa.mm0` or
-- `kernel_alg.mm0`, so there is no `used=` coverage list to state. The law
-- is about the split's *shape*; the arithmetic the pilot checked is quoted
-- in the evidence block, and a proof of the general identity is L11d.2's.
-- certificate: [gap — no owner approval in mm0/approved/ and no proof]

-- `provable sort Prop` is how this repo's MM0 files get a proposition sort
-- (see `mm0/clif.mm0:30`); without it `: Prop` is "sort not found" —
-- measured, not guessed.
sort Val;                       -- element offsets, extents, bases, widths
sort Span;                      -- the audited (base, off, len) wrapper
provable sort Prop;

-- Values. `add`/`sub`/`mul` are the law's notation, uninterpreted: what
-- they mean is the sentence above, where a reviewer can disagree with it,
-- and the pilot's own checked arithmetic is quoted in the evidence block.
term veq (a b: Val): Prop;      -- the law's `=` (MM0 has no built-in equality)
term vle (a b: Val): Prop;      -- the law's `<=`
term add (a b: Val): Val;
term sub (a b: Val): Val;
term mul (a b: Val): Val;

-- The law's operations on the wrapper. `split_left` / `split_right` are the
-- halves a checked `split` returns, `byte_extent` is the element extent
-- scaled by a checked width, and `fits_int64` is the byte-address premise.
term span_base (s: Span): Val;
term span_off (s: Span): Val;
term span_len (s: Span): Val;
term guard (s: Span) (k: Val): Prop;      -- the declared `Requires`
term split_left (s: Span) (k: Val): Span;
term split_right (s: Span) (k: Val): Span;
term byte_extent (s: Span) (w: Val): Span;
term extent_in_domain (s: Span): Prop;    -- premise: fits the allocation domain
term width_positive (w: Val): Prop;       -- premise: width > 0 (layout)
term fits_int64 (s: Span): Prop;          -- premise: byte address fits Int64

-- ── The law, one statement per evidence obligation ────────────────────
--
-- Each statement is a relation symbol; the formula it is a symbol *for* is
-- the comment above it. MM0 `term` declarations take no premises and no
-- body, and an `axiom` would be a claim this file is not making — the same
-- shape `mm0/clif.mm0` uses for `clif_step`. The layer the evidence gives
-- each fact is in its comment; `[stated: L11d.2]` is an obligation this
-- file names and does not prove.

-- [obligation liquid-split.extent-conservation: left = (w.off, k)]
-- [checked against the law] the left span is built from offset(s) and k:
--   guard s k  ⇒  veq (span_off (split_left s k)) (span_off s)
--   guard s k  ⇒  veq (span_len (split_left s k)) k
term law_left_off (s: Span) (k: Val): Prop;
term law_left_len (s: Span) (k: Val): Prop;

-- [obligation liquid-split.extent-conservation: right = ((+ w.off k), (- w.len k))]
-- [checked against the law] the right span is built from offset(s)+k and
-- len(s)-k:
--   guard s k  ⇒  veq (span_off (split_right s k)) (add (span_off s) k)
--   guard s k  ⇒  veq (span_len (split_right s k)) (sub (span_len s) k)
term law_right_off (s: Span) (k: Val): Prop;
term law_right_len (s: Span) (k: Val): Prop;

-- [obligation left.base = right.base = w.base [checked against the law]]
-- [checked against the law] both halves share the input's base:
--   guard s k  ⇒  veq (span_base (split_left s k)) (span_base s)
--   guard s k  ⇒  veq (span_base (split_right s k)) (span_base s)
term law_base_left (s: Span) (k: Val): Prop;
term law_base_right (s: Span) (k: Val): Prop;

-- [obligation conservation: left.len + right.len = n [stated: L11d.2]]
-- [stated: L11d.2] the halves partition the input's extent:
--   guard s k  ⇒
--   veq (add (span_len (split_left s k)) (span_len (split_right s k)))
--       (span_len s)
term law_conservation (s: Span) (k: Val): Prop;

-- [obligation disjoint: no element index belongs to both halves [stated: L11d.2]]
-- [stated: L11d.2] the left half ends at or before the right half starts:
--   guard s k  ⇒
--   vle (add (span_off (split_left s k)) (span_len (split_left s k)))
--       (span_off (split_right s k))
term law_disjoint (s: Span) (k: Val): Prop;

-- [obligation bytes: byte address = element index * width, checked to fit Int64 [premise: width]]
-- [premise: width] byte addresses are element indices scaled by the width,
-- on both halves, with the byte extent required to fit Int64:
--   guard s k  ⇒  width_positive width  ⇒
--   veq (span_off (byte_extent (split_left s k) width))
--       (mul (span_off (split_left s k)) width)          [and the right]
--   guard s k  ⇒  width_positive width  ⇒  extent_in_domain s  ⇒
--   fits_int64 (byte_extent s width)  ⇒
--   fits_int64 (byte_extent (split_right s k) width)
term law_bytes_off_left (s: Span) (k: Val) (width: Val): Prop;
term law_bytes_off_right (s: Span) (k: Val) (width: Val): Prop;
term law_bytes_fit (s: Span) (k: Val) (width: Val): Prop;

-- ── The accepted module's instantiation ──────────────────────────────
--

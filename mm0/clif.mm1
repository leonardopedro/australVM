-- clif.mm0 — the Cranelift-IR layer of the verified kernel (W9.2 of
-- PLAN_sota_kernel_verification.md).
--
-- layer: CLIF
-- measured-by: scripts/clif2mm0 --write, from
--   safestos/cranelift/target/release/clif_dump over scripts/cps-corpus
-- clif-forms: 20
-- clif-instructions: 853
-- clif-types: i64,i8
-- proves: 0 theorems
--
-- WHAT THIS IS. One declaration per instruction form the bridge's own
-- lowering emits, with the form's measured arity in its argument list and
-- its operand/result types in its name. It is a model of the *shape* of
-- the lowering's output — the thing the object digest cannot state — and
-- nothing more.
--
-- WHAT IT IS NOT. Not a semantics and not a theorem: `clif_step` and the
-- CLIF→ISA refinement are W9.3 and are not claimed here. mm0 will not let
-- a `theorem` appear in a specification without a proof in the `.mm1`, so
-- the `proves: 0 theorems` line is enforced by mm0-c rather than promised
-- by this comment. `scripts/verify-invariants` additionally re-runs this
-- generator, so a form the lowering starts emitting — or stops emitting —
-- is a diff, not a stale model.
--
-- Terminators: the value operands are counted, the branch targets are
-- blocks and are not values, so `brif` here takes one operand. That is
-- the measurement, not a simplification.

provable sort Prop;
sort val;                       -- an SSA value in a function
sort ty;                        -- a CLIF value type
sort op;                        -- an emitted instruction form

-- Value types the corpus produced.
term ty_i64: ty;
term ty_i8: ty;

-- Measured instruction forms, sorted; the comment is the count in the
-- corpus measurement. A constructor's argument list is the operand list.
term band__i64_i64__r_i64 (a b: val): op;   -- 12 use(s), 2 operand(s), 1 result(s)
term bnot__i64__r_i64 (a: val): op;   -- 1 use(s), 1 operand(s), 1 result(s)
term bor__i64_i64__r_i64 (a b: val): op;   -- 1 use(s), 2 operand(s), 1 result(s)
term brif__i8__r_none (a: val): op;   -- 37 use(s), 1 operand(s), 0 result(s)
term call__i64__r_i64 (a: val): op;   -- 35 use(s), 1 operand(s), 1 result(s)
term call__i64_i64__r_i64 (a b: val): op;   -- 63 use(s), 2 operand(s), 1 result(s)
term call__i64_i64_i64__r_i64 (a b c: val): op;   -- 3 use(s), 3 operand(s), 1 result(s)
term call__none__r_i64: op;   -- 1 use(s), 0 operand(s), 1 result(s)
term iadd__i64_i64__r_i64 (a b: val): op;   -- 60 use(s), 2 operand(s), 1 result(s)
term icmp__i64_i64__r_i8 (a b: val): op;   -- 37 use(s), 2 operand(s), 1 result(s)
term iconst__none__r_i64: op;   -- 304 use(s), 0 operand(s), 1 result(s)
term iconst__none__r_i8: op;   -- 13 use(s), 0 operand(s), 1 result(s)
term jump__none__r_none: op;   -- 38 use(s), 0 operand(s), 0 result(s)
term load__i64__r_i64 (a: val): op;   -- 113 use(s), 1 operand(s), 1 result(s)
term return__i64__r_none (a: val): op;   -- 41 use(s), 1 operand(s), 0 result(s)
term smul_overflow__i64_i64__r_i64_i8 (a b: val): op;   -- 10 use(s), 2 operand(s), 2 result(s)
term ssub_overflow__i64_i64__r_i64_i8 (a b: val): op;   -- 12 use(s), 2 operand(s), 2 result(s)
term store__i64_i64__r_none (a b: val): op;   -- 37 use(s), 2 operand(s), 0 result(s)
term store__i8_i64__r_none (a b: val): op;   -- 13 use(s), 2 operand(s), 0 result(s)
term uextend__i8__r_i64 (a: val): op;   -- 22 use(s), 1 operand(s), 1 result(s)

-- ── The step relation, and the obligation it does not discharge ──────
--
-- W9.3's obligation, stated exactly (PLAN §4b):
--
--     clif_step s o s'  ⇒  isa_step (lower o) s s'
--
-- `clif_step` is a *relation symbol*, declared so the obligation has a
-- vocabulary to be written in, and nothing asserts it: there is no
-- `axiom clif_step …` here and no theorem about it in the `.mm1`. The
-- distinction is the whole point of the layer — a specification may name
-- a relation it has not defined, but a certificate may not claim one it
-- has not proved. `scripts/verify-invariants` refuses any `axiom` or
-- `theorem` in this file, so the relation cannot quietly become either.
--
-- What the refinement *may* assume is the layer-1 vocabulary, cited by
-- content and pinned by digest — the same four artifacts `mm0/isa.mm0`
-- cites for `linear`/`typed`/`in_bounds`, plus the ISA model the CLIF
-- step has to refine into:
-- cites: mm0/isa.mm0 sha256=012db5170dd18054e9f7458dac0079f91516c9a5f0acd674c77203cec50859b6
-- cites: mm0/linearity_certificate.mm0 sha256=9eedc905fd7cd093e40f17e6735a0ea7ee763485370661fa5e0ce59fb7b336bf
-- cites: mm0/layout_certificate.mm0 sha256=20055174ee1e6942b9ef307737e44467f8eb338e67677f6427b4a0f450f6fa25
-- cites: mm0/flux1d_certificate.mm0 sha256=4ae37ccd22c8e91a543965fc887101c9b18aeb1e41df944bb884175eac5aa476
-- cites: mm0/slot_layout.mm0 sha256=67b61dc15a3b6bcc5bfe1da2a39edea08f0305e9c1978e1a9625cfa152a8965d
--
-- certificate: [gap] — `mm0/approved/` carries no approval for `isa`,
--   and an approval is the owner's commit, not a script's. So the
--   obligation is stated with citations and left uncertified on purpose;
--   `scripts/verify-invariants` fails this gap if `mm0/approved/isa.stmts`
--   appears, because then the citation must name it and a proof must
--   arrive with it. Nothing here is pinned as `approved` by itself.
sort St;                        -- a machine state: registers + memory, uninterpreted
term clif_step (s: St) (o: op) (t: St): Prop;

-- kernel certificate — flux1d (generated by scripts/au2mm0).
--
-- Source: examples/verified-kernel/flux1d/flux1d.obligations.json (sha256 bc99f23efb6649dde1f20220ac7e00ead14146af63dafbe8481a12d8badaf812)
-- Theory: docs/kernel_alg.mm0 (sha256 9a5bfb0b9bde52d850a5643e69cc9cfc14faae05ef06a37143b1acabfc16542b)
--
-- What is claimed: every obligation of the kernel is an identity in
-- the free commutative ring on the state's components, proved here as
-- a `peq` chain and carried to the numeric domain by the theory's
-- single trusted bridge (`int_ring_transfer`). Variable `nj` is
-- component j of the state: `ev (pvar nj) s` is `rcomp s j`.
--
-- What is NOT claimed: that a real-valued kernel evaluates this way.
-- Reflection (kernel source -> these polynomials) is trusted, and the
-- artifact's statements are what a reader audits: `consistency`,
-- `conservation`, `symmetry` are the kernel's own obligations, not
-- this emitter's paraphrase of them.
--
-- Coefficients are not expanded to repeated summands: each literal
-- combination is a visible `cf_` fact, counted `grounded` below and
-- re-checked by exact integer sampling before it is written.
--
-- trust-split: structural=6 grounded=15 certificates=4
-- theory coverage: used=tint,pvar,padd,pmul,pneg,peq,ev,req unused=rcomp,radd,rmul,rneg,rlit
-- assumed: 1 (uniform_state: l = r (a uniform interface))
-- witness: uniform_state: l=1 r=1 meets all 1 hypothesis/hypotheses
-- code: cps=cd65d0b46a9f8bc017953572031fc1e2c2d9b374296800f4ca11de776b5ae3c3 obj=ceed355c0e8a150e68bc0e61439eb62e85fa48eb6f50807f6d637205ec07d2cb target=host
-- code-status: recorded (cps = sha256 of the --emit-cps bytes; obj = sha256 of the AVCE capture of those bytes, arch=aarch64)
-- float-gap: idealization=integer exact probe=mm0/flux1d_probe.c tolerance=1e-8 status=tested-not-proved

-- kernel_alg.mm0 — the MM0 theory of symbolic kernel certificates (W2 of
-- PLAN_sota_kernel_verification.md).
--
-- WHY. Every certificate emitted before W2 was about a *closed* computation
-- (`teq <closed-body> ttrue`): it named one state vector, so it says nothing
-- about any other. This theory carries the other kind — an identity over a
-- *class* of states, as a polynomial congruence in ℤ[x⃗] carried to the
-- numeric domain the kernel runs on.
--
-- SHAPE of a certificate over this theory:
--   goal        req (ev p s) (ev q s)             -- residual = flux(R)-flux(L)
--   hypotheses  req (rcomp s 0) (rcomp s 1)       -- u_L = u_R
--   proof       peq (psub p (pmul (psub (pvar n0) (pvar n1)) k)) q
--               -- p - q is in the ideal of the hypotheses; each step is a
--               -- ring law or a grounded decimal fact, never a search
--   rule        int_ring_transfer                 -- the one trusted bridge
--
-- TRUST. The integer spine with `peq` is the free commutative ring on the
-- variable indices: the ring laws below *define* that object, so there is
-- nothing to prove and the list is auditable by eye. `ev (-) s` is a ring
-- homomorphism to R for every state (ev_var/lit/add/mul/neg) and `req` is
-- equality in R. `int_ring_transfer` is the only rule crossing from ℤ[x⃗] to
-- R. Literal arithmetic is uninterpreted like `teval` in docs/cic.mm0:
-- artifacts ground each instance as a visible decimal fact, counted
-- `grounded` in the trust split and cross-checked by the independent
-- evaluator. No floats — W2 emits `-- float-gap:` instead of certifying.
-- Axiomatizing `ev` follows docs/cic.mm0's `tsubst_beta` precedent ("the net
-- reducer IS the substitution engine"); here the polynomial ring is.

provable sort Prop;

sort nat;                       -- indices, literal payloads
sort Poly;                      -- integer polynomial expressions, ℤ[x⃗]
sort R;                         -- numeric values of record (real-valued)

-- Parentheses are standalone tokens in math strings (as in docs/cic.mm0).
-- The theory's own 0 and 1; artifacts declare further numerals on top.
delimiter $ ( ) $;
term n0: nat;
prefix n0: $0$ prec max;
term n1: nat;
prefix n1: $1$ prec max;

-- ── The integer spine ────────────────────────────────────────────────────
term tint (n: nat): Poly;                  -- the integer constant n
term pvar (i: nat): Poly;                  -- the variable x_i
term padd (a b: Poly): Poly;
term pmul (a b: Poly): Poly;
term pneg (a: Poly): Poly;

def psub (a b: Poly): Poly = $ padd a (pneg b) $;   -- definition, not axiom

-- ── Congruence of the polynomial presentation ────────────────────────────

term peq (a b: Poly): Prop;
axiom peq_refl (a: Poly): $ peq a a $;
axiom peq_symm (a b: Poly): $ peq a b $ > $ peq b a $;
axiom peq_trans (a b c: Poly): $ peq a b $ > $ peq b c $ > $ peq a c $;
axiom peq_cong_add (a a2 b b2: Poly):
  $ peq a a2 $ > $ peq b b2 $ > $ peq (padd a b) (padd a2 b2) $;
axiom peq_cong_mul (a a2 b b2: Poly):
  $ peq a a2 $ > $ peq b b2 $ > $ peq (pmul a b) (pmul a2 b2) $;
axiom peq_cong_neg (a a2: Poly): $ peq a a2 $ > $ peq (pneg a) (pneg a2) $;-- ── The ring presentation: the definition of Poly as a free ℤ-ring ───────
axiom padd_comm (a b: Poly): $ peq (padd a b) (padd b a) $;
axiom padd_assoc (a b c: Poly):
  $ peq (padd (padd a b) c) (padd a (padd b c)) $;
axiom padd_zero (a: Poly): $ peq (padd a (tint n0)) a $;
axiom padd_neg (a: Poly): $ peq (padd a (pneg a)) (tint n0) $;
axiom pneg_neg (a: Poly): $ peq (pneg (pneg a)) a $;
axiom pmul_comm (a b: Poly): $ peq (pmul a b) (pmul b a) $;
axiom pmul_assoc (a b c: Poly):
  $ peq (pmul (pmul a b) c) (pmul a (pmul b c)) $;
axiom pmul_one (a: Poly): $ peq (pmul a (tint n1)) a $;
axiom pmul_distrib (a b c: Poly):
  $ peq (pmul a (padd b c)) (padd (pmul a b) (pmul a c)) $;

-- Three more laws, so that the *shape* a normalizer must produce is reachable
-- one step at a time. Each is an identity of every commutative ring (a reader
-- checks them by expanding), i.e. the same standard as the laws above; they are
-- listed separately only because they concern `pneg`, which the laws above
-- mention exactly once (`padd_neg`). Without them a certificate could reorder
-- sums but never move a sign from a sum to its terms, which is what a kernel
-- difference needs.
axiom padd_zero_l (a: Poly): $ peq (padd (tint n0) a) a $;
axiom pneg_add (a b: Poly):
  $ peq (pneg (padd a b)) (padd (pneg a) (pneg b)) $;
axiom pmul_neg_l (a b: Poly): $ peq (pmul (pneg a) b) (pneg (pmul a b)) $;
axiom pmul_neg_r (a b: Poly): $ peq (pmul a (pneg b)) (pneg (pmul a b)) $;
axiom pneg_zero: $ peq (pneg (tint n0)) (tint n0) $;
axiom pmul_zero_l (a: Poly): $ peq (pmul (tint n0) a) (tint n0) $;
-- ── Literal arithmetic: uninterpreted, grounded per instance ─────────────
-- Same posture as `teval` in docs/cic.mm0: one decimal axiom per instance.
term litadd (n m: nat): nat;
term litmul (n m: nat): nat;

-- ── The numeric domain of record ─────────────────────────────────────────
term radd (x y: R): R;
term rmul (x y: R): R;
term rneg (x: R): R;
term rlit (n: nat): R;                     -- image of an integer literal
term rcomp (s i: nat): R;                  -- component i of state s

def rsub (x y: R): R = $ radd x (rneg y) $;
def r0: R = $ rlit n0 $;

term req (x y: R): Prop;
axiom req_refl (x: R): $ req x x $;
axiom req_symm (x y: R): $ req x y $ > $ req y x $;
axiom req_trans (x y z: R): $ req x y $ > $ req y z $ > $ req x z $;
axiom req_cong_add (x x2 y y2: R):
  $ req x x2 $ > $ req y y2 $ > $ req (radd x y) (radd x2 y2) $;
axiom req_cong_mul (x x2 y y2: R):
  $ req x x2 $ > $ req y y2 $ > $ req (rmul x y) (rmul x2 y2) $;
axiom req_cong_neg (x x2: R): $ req x x2 $ > $ req (rneg x) (rneg x2) $;

-- R is a commutative ring: the laws a kernel's numeric argument already
-- assumes (the ones why3/Z3 discharge for the liquid obligations).
axiom radd_comm (x y: R): $ req (radd x y) (radd y x) $;
axiom radd_assoc (x y z: R):
  $ req (radd (radd x y) z) (radd x (radd y z)) $;
axiom radd_zero (x: R): $ req (radd x r0) x $;
axiom radd_neg (x: R): $ req (radd x (rneg x)) r0 $;
axiom rmul_comm (x y: R): $ req (rmul x y) (rmul y x) $;
axiom rmul_assoc (x y z: R):
  $ req (rmul (rmul x y) z) (rmul x (rmul y z)) $;
axiom rmul_one (x: R): $ req (rmul x (rlit n1)) x $;
axiom rmul_zero (x: R): $ req (rmul r0 x) r0 $;
axiom rmul_distrib (x y z: R):
  $ req (rmul x (radd y z)) (radd (rmul x y) (rmul x z)) $;

-- Hypothesis elimination in R: with the ring laws above these derive
-- `hyp > req (ev p s) (ev q s)` from the polynomial certificate, so the
-- hypothesis form needs no rule of its own.
axiom rsub_self (x y: R): $ req x y $ > $ req (rsub x y) r0 $;
axiom rsub_eq (x y: R): $ req (rsub x y) r0 $ > $ req x y $;
-- ── Evaluation at a state: a ring homomorphism for every state ───────────
term ev (p: Poly) (s: nat): R;

axiom ev_var (i s: nat): $ req (ev (pvar i) s) (rcomp s i) $;
axiom ev_lit (n s: nat): $ req (ev (tint n) s) (rlit n) $;
axiom ev_add (a b: Poly) (s: nat):
  $ req (ev (padd a b) s) (radd (ev a s) (ev b s)) $;
axiom ev_mul (a b: Poly) (s: nat):
  $ req (ev (pmul a b) s) (rmul (ev a s) (ev b s)) $;
axiom ev_neg (a: Poly) (s: nat):
  $ req (ev (pneg a) s) (rneg (ev a s)) $;

-- ── THE transfer rule (the single trusted bridge) ────────────────────────
--
-- Justification, written once, reviewed once, hash-pinned by the artifact's
-- BUDGETS row and by scripts/verify-invariants:
--
--   `ev (-) s` is a ring homomorphism ℤ[x⃗] → R (ev_lit, ev_var, ev_add,
--   ev_mul, ev_neg); `peq` is the congruence of the free commutative ring on
--   the variables; R is a commutative ℤ-algebra. A homomorphism out of a free
--   ring respects its presentation, so congruent polynomials have equal
--   images at every state — no fact about the kernel beyond "its arithmetic
--   is this ring".
--
-- Every identity class (consistency, conservation, symmetry, any dimension)
-- instantiates this one rule; adding a second is a theory change and must
-- edit BUDGETS in the same commit.
axiom int_ring_transfer (p q: Poly) (s: nat):
  $ peq p q $ > $ req (ev p s) (ev q s) $;

term n2: nat; prefix n2: $2$ prec max;
term n3: nat; prefix n3: $3$ prec max;
term n6: nat; prefix n6: $6$ prec max;
term n9: nat; prefix n9: $9$ prec max;

theorem ring_swap(a b r: Poly): $ peq (padd b (padd a r)) (padd a (padd b r)) $;
theorem ring_pmul_swap(a b r: Poly): $ peq (pmul b (pmul a r)) (pmul a (pmul b r)) $;
axiom cf_1: $ peq (pmul (tint n2) (tint n3)) (tint n6) $;
axiom cf_2: $ peq (padd (pmul (tint n6) (pvar n0)) (pneg (pmul (tint n3) (pvar n0)))) (pmul (tint n3) (pvar n0)) $;
axiom cf_3: $ peq (padd (pmul (tint n2) (pmul (pvar n0) (pvar n0))) (pneg (pmul (pvar n0) (pvar n0)))) (pmul (pvar n0) (pvar n0)) $;
axiom cf_4: $ peq (padd (pmul (tint n3) (pvar n0)) (pmul (tint n6) (pvar n0))) (pmul (tint n9) (pvar n0)) $;
axiom cf_5: $ peq (padd (pmul (tint n9) (pvar n0)) (pneg (pmul (tint n3) (pvar n0)))) (pmul (tint n6) (pvar n0)) $;
axiom cf_6: $ peq (padd (pmul (pvar n0) (pvar n0)) (pmul (tint n2) (pmul (pvar n0) (pvar n0)))) (pmul (tint n3) (pmul (pvar n0) (pvar n0))) $;
axiom cf_7: $ peq (padd (pmul (tint n3) (pmul (pvar n0) (pvar n0))) (pneg (pmul (pvar n0) (pvar n0)))) (pmul (tint n2) (pmul (pvar n0) (pvar n0))) $;
axiom cf_8: $ peq (padd (pmul (tint n3) (pvar n1)) (pmul (tint n6) (pvar n1))) (pmul (tint n9) (pvar n1)) $;
axiom cf_9: $ peq (padd (pmul (tint n9) (pvar n1)) (pneg (pmul (tint n3) (pvar n1)))) (pmul (tint n6) (pvar n1)) $;
axiom cf_10: $ peq (padd (pmul (pvar n1) (pvar n1)) (pmul (tint n2) (pmul (pvar n1) (pvar n1)))) (pmul (tint n3) (pmul (pvar n1) (pvar n1))) $;
axiom cf_11: $ peq (padd (pmul (tint n3) (pmul (pvar n1) (pvar n1))) (pneg (pmul (pvar n1) (pvar n1)))) (pmul (tint n2) (pmul (pvar n1) (pvar n1))) $;
axiom cf_12: $ peq (padd (pmul (tint n3) (pvar n2)) (pmul (tint n6) (pvar n2))) (pmul (tint n9) (pvar n2)) $;
axiom cf_13: $ peq (padd (pmul (tint n9) (pvar n2)) (pneg (pmul (tint n3) (pvar n2)))) (pmul (tint n6) (pvar n2)) $;
axiom cf_14: $ peq (padd (pmul (pvar n2) (pvar n2)) (pmul (tint n2) (pmul (pvar n2) (pvar n2)))) (pmul (tint n3) (pmul (pvar n2) (pvar n2))) $;
axiom cf_15: $ peq (padd (pmul (tint n3) (pmul (pvar n2) (pvar n2))) (pneg (pmul (pvar n2) (pvar n2)))) (pmul (tint n2) (pmul (pvar n2) (pvar n2))) $;
theorem consistency (s: nat): $ req (ev (padd (pmul (padd (pmul (pvar n0) (tint n3)) (pmul (pvar n0) (pvar n0))) (tint n2)) (pneg (padd (pmul (pvar n0) (tint n3)) (pmul (pvar n0) (pvar n0))))) s) (ev (padd (pmul (pvar n0) (tint n3)) (pmul (pvar n0) (pvar n0))) s) $;
theorem conservation (s: nat): $ req (ev (padd (padd (padd (padd (pmul (padd (pmul (pvar n0) (tint n3)) (pmul (pvar n0) (pvar n0))) (tint n2)) (pneg (padd (pmul (pvar n1) (tint n3)) (pmul (pvar n1) (pvar n1))))) (pneg (padd (pmul (padd (pmul (pvar n1) (tint n3)) (pmul (pvar n1) (pvar n1))) (tint n2)) (pneg (padd (pmul (pvar n0) (tint n3)) (pmul (pvar n0) (pvar n0))))))) (padd (padd (pmul (padd (pmul (pvar n1) (tint n3)) (pmul (pvar n1) (pvar n1))) (tint n2)) (pneg (padd (pmul (pvar n2) (tint n3)) (pmul (pvar n2) (pvar n2))))) (pneg (padd (pmul (padd (pmul (pvar n2) (tint n3)) (pmul (pvar n2) (pvar n2))) (tint n2)) (pneg (padd (pmul (pvar n1) (tint n3)) (pmul (pvar n1) (pvar n1)))))))) (padd (padd (pmul (padd (pmul (pvar n2) (tint n3)) (pmul (pvar n2) (pvar n2))) (tint n2)) (pneg (padd (pmul (pvar n0) (tint n3)) (pmul (pvar n0) (pvar n0))))) (pneg (padd (pmul (padd (pmul (pvar n0) (tint n3)) (pmul (pvar n0) (pvar n0))) (tint n2)) (pneg (padd (pmul (pvar n2) (tint n3)) (pmul (pvar n2) (pvar n2)))))))) s) (ev (tint n0) s) $;
theorem symmetry (s: nat): $ req (ev (padd (padd (padd (pmul (padd (pmul (pvar n0) (tint n3)) (pmul (pvar n0) (pvar n0))) (tint n2)) (pneg (padd (pmul (pvar n1) (tint n3)) (pmul (pvar n1) (pvar n1))))) (pneg (padd (pmul (padd (pmul (pvar n1) (tint n3)) (pmul (pvar n1) (pvar n1))) (tint n2)) (pneg (padd (pmul (pvar n0) (tint n3)) (pmul (pvar n0) (pvar n0))))))) (padd (padd (pmul (padd (pmul (pvar n1) (tint n3)) (pmul (pvar n1) (pvar n1))) (tint n2)) (pneg (padd (pmul (pvar n0) (tint n3)) (pmul (pvar n0) (pvar n0))))) (pneg (padd (pmul (padd (pmul (pvar n0) (tint n3)) (pmul (pvar n0) (pvar n0))) (tint n2)) (pneg (padd (pmul (pvar n1) (tint n3)) (pmul (pvar n1) (pvar n1)))))))) s) (ev (tint n0) s) $;
theorem uniform_state (s: nat): $ req (ev (padd (padd (pmul (padd (pmul (pvar n1) (tint n3)) (pmul (pvar n1) (pvar n1))) (tint n2)) (pneg (padd (pmul (pvar n1) (tint n3)) (pmul (pvar n1) (pvar n1))))) (pneg (padd (pmul (padd (pmul (pvar n1) (tint n3)) (pmul (pvar n1) (pvar n1))) (tint n2)) (pneg (padd (pmul (pvar n1) (tint n3)) (pmul (pvar n1) (pvar n1))))))) s) (ev (tint n0) s) $;


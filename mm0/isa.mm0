-- isa.mm0 — the ISA layer of the verified kernel (W8 of
-- PLAN_sota_kernel_verification.md).
--
-- layer: ISA
-- instruction-table: cps-v2, 23 opcodes, measured by scripts/isa-census
-- proof-status: theory — 26 proved theorems (the encdec round trip for each of
--   the 23 emitted opcodes, and the three step refinements `add_refines`,
--   `mul_refines`, `sub_refines`) and ONE cited hypothesis
--   (`bounds_from_layout`), zero `sorry`. The split matters: what is proved is
--   the byte layer's self-consistency and that one ISA step is one CPS-IR step;
--   what is assumed is that a typed, linear state has its slots in bounds, which
--   is where the layer-1
--   certificates enter, each with a pinned citation. mm0-c rejects a theorem
--   whose proof is missing (`error: some theorems used sorry`), so the proofs
--   live in `mm0/isa.mm1` — the file mm0-rs compiles — and mm0-c checks them
--   against this specification.
--
-- theory coverage: used=req,radd,rmul,rneg,reg,setreg,neq,linear,typed,in_bounds,run_add,run_sub,run_mul,run_move,ir_add,ir_sub,ir_mul,ienc,idec,ieq,beq,ins_add,ins_and,ins_app,ins_cmp_eq,ins_cmp_gt,ins_cmp_gte,ins_cmp_lt,ins_cmp_lte,ins_cmp_neq,ins_deref,ins_if,ins_int_lit,ins_let,ins_match,ins_mul,ins_not,ins_or,ins_return,ins_store,ins_string_lit,ins_sub,ins_var,ins_while unused=n0
--
-- cites: mm0/linearity_certificate.mm0 sha256=9eedc905fd7cd093e40f17e6735a0ea7ee763485370661fa5e0ce59fb7b336bf
-- cites: mm0/layout_certificate.mm0 sha256=20055174ee1e6942b9ef307737e44467f8eb338e67677f6427b4a0f450f6fa25
-- cites: mm0/flux1d_certificate.mm0 sha256=300e763dc165ab48b7d38f716af1fa1a76652fe0d9bd888d31c53ac26d56fb7a
--
-- WHY THIS FILE IS SMALL. Building an ISA semantics from scratch here would
-- prove linear types, refinements and memory safety a second time at a lower
-- level, in a weaker fragment, and the two proofs would be free to disagree.
-- Instead each guarantee enters as a *hypothesis with a citation*: `linear`,
-- `typed` and `in_bounds` below are never proved here, they are taken from the
-- three certificates named above, and scripts/verify-invariants refuses a
-- hypothesis whose `-- gap-hypothesis:` line has no pinned citation (or whose
-- pinned digest no longer matches the artifact). That is the whole design: the
-- model fills in the gaps, and the gaps are visible.
--
-- The trade is stated rather than softened: a bug in the linearity certificate
-- propagates into the machine-code claim. The alternative — two independent
-- proofs of linearity — was rejected because they can disagree silently, which
-- is worse than a pinned dependence that a reader can follow.
--
-- WHAT IS TRUSTED. The `-- op` table below, the `run_*` axioms (one per emitted
-- arithmetic/control instruction: the step relation as a definition), the
-- `ir_*` semantics of the same instructions one layer up, and the congruence
-- laws on `req`. Every theorem in the file is proved (26 of them), and exactly
-- one statement is assumed rather than proved from this file alone:
-- `bounds_from_layout`, which cites the layout certificate. `scripts/isa-census`
-- measures the table against the instructions the JIT actually decodes, so the
-- file cannot drift into "the ISA" while the claim stays "the bytes we emit".

provable sort Prop;

sort nat;                       -- register indices, literal payloads
sort R;                         -- numeric values in a register
sort St;                        -- machine state: register file + memory
sort Ins;                       -- a decoded instruction of the emitted subset

delimiter $ ( ) $;
term n0: nat; prefix n0: $0$ prec max;
term n1: nat; prefix n1: $1$ prec max;

-- ── The instruction table (checked by scripts/isa-census) ────────────────
-- One line per opcode accepted by the CPS decoder (src/cps.rs) and emitted by
-- lib/CpsGen.ml. An opcode the decoder gains without a line here is a census
-- failure. The names are the decoder's own.
-- op 0x01 int_lit
-- op 0x02 var
-- op 0x03 let
-- op 0x04 app
-- op 0x05 add
-- op 0x06 sub
-- op 0x07 return
-- op 0x08 if
-- op 0x09 while
-- op 0x0A match
-- op 0x10 cmp_lt
-- op 0x11 cmp_gt
-- op 0x12 cmp_lte
-- op 0x13 cmp_gte
-- op 0x14 cmp_eq
-- op 0x15 cmp_neq
-- op 0x16 and
-- op 0x17 or
-- op 0x18 mul
-- op 0x19 not
-- op 0x20 deref
-- op 0x21 string_lit
-- op 0x30 store

-- ── Values and states ────────────────────────────────────────────────────
term radd (x y: R): R;
term rmul (x y: R): R;
term rneg (x: R): R;

term req (x y: R): Prop;
axiom req_refl (x: R): $ req x x $;
axiom req_symm (x y: R): $ req x y $ > $ req y x $;
axiom req_trans (x y z: R): $ req x y $ > $ req y z $ > $ req x z $;

-- R is a commutative ring: the arithmetic the emitted `add`/`sub`/`mul` steps
-- are required to implement, and the laws W2's theory already reasons in.
axiom radd_comm (x y: R): $ req (radd x y) (radd y x) $;
axiom radd_assoc (x y z: R): $ req (radd (radd x y) z) (radd x (radd y z)) $;
axiom rmul_assoc (x y z: R): $ req (rmul (rmul x y) z) (rmul x (rmul y z)) $;
axiom rmul_distrib (x y z: R): $ req (rmul x (radd y z)) (radd (rmul x y) (rmul x z)) $;

-- Registers. `setreg s i v` writes i; the distinctness side condition is a
-- hypothesis (`neq`), never assumed away: two different registers holding
-- different values is the case a wrong model would get for free.
term reg (s: St) (i: nat): R;
term setreg (s: St) (i: nat) (v: R): St;
term neq (i j: nat): Prop;

axiom reg_setreg_same (s: St) (i: nat) (v: R): $ req (reg (setreg s i v) i) v $;
axiom reg_setreg_other (s: St) (i j: nat) (v: R):
  $ neq i j $ > $ req (reg (setreg s i v) j) (reg s j) $;

-- ── The layer-1 hypotheses: cited, never proved here ─────────────────────
term linear (s: St): Prop;      -- linearity of the live bindings (H-LIN)
term typed (s: St): Prop;       -- refinement typing of live values (H-REF)
term in_bounds (s: St) (i: nat): Prop;  -- block bounds of the i-th slot (H-BND)

-- ── The step relation: definitions of the emitted subset ─────────────────
-- One axiom per instruction the certified fragment needs. "Definition-only" in
-- the sense AlphaProof uses: the trusted part is these lines, and they are
-- auditable by eye because each says "this instruction does exactly this".
term run_add (s: St) (dst a b: nat): St;
axiom run_add_def (s: St) (dst a b: nat):
  $ req (reg (run_add s dst a b) dst) (radd (reg s a) (reg s b)) $;

term run_sub (s: St) (dst a b: nat): St;
axiom run_sub_def (s: St) (dst a b: nat):
  $ req (reg (run_sub s dst a b) dst) (radd (reg s a) (rneg (reg s b))) $;

term run_mul (s: St) (dst a b: nat): St;
axiom run_mul_def (s: St) (dst a b: nat):
  $ req (reg (run_mul s dst a b) dst) (rmul (reg s a) (reg s b)) $;

term run_move (s: St) (dst a: nat): St;
axiom run_move_def (s: St) (dst a: nat):
  $ req (reg (run_move s dst a) dst) (reg s a) $;

-- ── The CPS-IR side: the same instruction, one layer up ──────────────────
-- `ir_add` is the CPS opcode 0x05; `ir_mul` is 0x18; `ir_sub` is 0x06. They are
-- separate terms on purpose: the file proves a relation *between* the two
-- layers, not an equation that would make the layers identical by fiat.
term ir_add (s: St) (dst a b: nat): St;
axiom ir_add_sem (s: St) (dst a b: nat):
  $ req (reg (ir_add s dst a b) dst) (radd (reg s a) (reg s b)) $;

term ir_mul (s: St) (dst a b: nat): St;
axiom ir_mul_sem (s: St) (dst a b: nat):
  $ req (reg (ir_mul s dst a b) dst) (rmul (reg s a) (reg s b)) $;

term ir_sub (s: St) (dst a b: nat): St;
axiom ir_sub_sem (s: St) (dst a b: nat):
  $ req (reg (ir_sub s dst a b) dst) (radd (reg s a) (rneg (reg s b))) $;

-- ── encdec: decode (encode i) = i, proved instruction by instruction ────
-- This section used to be one axiom over uninterpreted `enc`/`dec`, annotated
-- `status=measured-not-proved`. That was honest but nearly empty: an
-- uninterpreted `enc` says nothing about any byte, so the axiom could be true
-- of a model that encoded every instruction as 0. MM0 has no pattern matching
-- or recursion, so a codec cannot be *defined* here either — but it can be
-- *stated*, finitely, one equation per emitted opcode, and then the round trip
-- is a theorem of those equations rather than a promise.
--
-- What is trusted now is the table: `enc_<op>` says which byte introduces each
-- instruction, `dec_<op>` says the decoder maps it back. That is 46 short lines
-- a reader can audit against the ISA manual's opcode bytes, and it is the same
-- table `ISA_REGISTRY` holds (`scripts/isa-census` compares it to the JIT's own
-- decoder) and `lib/Cps_codec.ml` holds (`test/CpsCodecTest.ml` compares it to
-- this file). Each `encdec_<op>` theorem below is proved from exactly its two
-- table lines: no case is assumed, so a byte that no longer decodes to the
-- instruction claimed for it cannot keep its theorem.
--
-- The generated block is written by `scripts/isa-encdec --write` from
-- `ISA_REGISTRY`; `verify-invariants` refuses a stale block, re-checks the
-- proofs with mm0-rs and mm0-c, and counts the instances.
term ienc (i: Ins): nat;        -- instruction -> its opcode byte
term idec (b: nat): Ins;        -- opcode byte -> instruction (within the subset)
term ieq (a b: Ins): Prop;      -- instruction equality
term beq (a b: nat): Prop;      -- byte equality

axiom ieq_trans (a b c: Ins): $ ieq a b $ > $ ieq b c $ > $ ieq a c $;
-- Rewriting under `idec`, the one congruence the round trip needs.
axiom beq_cong_dec (a b: nat): $ beq a b $ > $ ieq (idec a) (idec b) $;

-- BEGIN GENERATED encdec (scripts/isa-encdec --write)

-- Opcode bytes used by the table below (0x.. to decimal).
term n2: nat; prefix n2: $2$ prec max;
term n3: nat; prefix n3: $3$ prec max;
term n4: nat; prefix n4: $4$ prec max;
term n5: nat; prefix n5: $5$ prec max;
term n6: nat; prefix n6: $6$ prec max;
term n7: nat; prefix n7: $7$ prec max;
term n8: nat; prefix n8: $8$ prec max;
term n9: nat; prefix n9: $9$ prec max;
term n10: nat; prefix n10: $10$ prec max;
term n16: nat; prefix n16: $16$ prec max;
term n17: nat; prefix n17: $17$ prec max;
term n18: nat; prefix n18: $18$ prec max;
term n19: nat; prefix n19: $19$ prec max;
term n20: nat; prefix n20: $20$ prec max;
term n21: nat; prefix n21: $21$ prec max;
term n22: nat; prefix n22: $22$ prec max;
term n23: nat; prefix n23: $23$ prec max;
term n24: nat; prefix n24: $24$ prec max;
term n25: nat; prefix n25: $25$ prec max;
term n32: nat; prefix n32: $32$ prec max;
term n33: nat; prefix n33: $33$ prec max;
term n48: nat; prefix n48: $48$ prec max;

-- The instruction set, one constant per opcode.
term ins_int_lit: Ins;
term ins_var: Ins;
term ins_let: Ins;
term ins_app: Ins;
term ins_add: Ins;
term ins_sub: Ins;
term ins_return: Ins;
term ins_if: Ins;
term ins_while: Ins;
term ins_match: Ins;
term ins_cmp_lt: Ins;
term ins_cmp_gt: Ins;
term ins_cmp_lte: Ins;
term ins_cmp_gte: Ins;
term ins_cmp_eq: Ins;
term ins_cmp_neq: Ins;
term ins_and: Ins;
term ins_or: Ins;
term ins_mul: Ins;
term ins_not: Ins;
term ins_deref: Ins;
term ins_string_lit: Ins;
term ins_store: Ins;

-- The table: instruction -> byte (`enc`) and byte -> instruction
-- (`dec`), then the round trip proved from the two, per instruction.
axiom enc_int_lit: $ beq (ienc ins_int_lit) n1 $;
axiom dec_int_lit: $ ieq (idec n1) ins_int_lit $;
theorem encdec_int_lit: $ ieq (idec (ienc ins_int_lit)) ins_int_lit $;
axiom enc_var: $ beq (ienc ins_var) n2 $;
axiom dec_var: $ ieq (idec n2) ins_var $;
theorem encdec_var: $ ieq (idec (ienc ins_var)) ins_var $;
axiom enc_let: $ beq (ienc ins_let) n3 $;
axiom dec_let: $ ieq (idec n3) ins_let $;
theorem encdec_let: $ ieq (idec (ienc ins_let)) ins_let $;
axiom enc_app: $ beq (ienc ins_app) n4 $;
axiom dec_app: $ ieq (idec n4) ins_app $;
theorem encdec_app: $ ieq (idec (ienc ins_app)) ins_app $;
axiom enc_add: $ beq (ienc ins_add) n5 $;
axiom dec_add: $ ieq (idec n5) ins_add $;
theorem encdec_add: $ ieq (idec (ienc ins_add)) ins_add $;
axiom enc_sub: $ beq (ienc ins_sub) n6 $;
axiom dec_sub: $ ieq (idec n6) ins_sub $;
theorem encdec_sub: $ ieq (idec (ienc ins_sub)) ins_sub $;
axiom enc_return: $ beq (ienc ins_return) n7 $;
axiom dec_return: $ ieq (idec n7) ins_return $;
theorem encdec_return: $ ieq (idec (ienc ins_return)) ins_return $;
axiom enc_if: $ beq (ienc ins_if) n8 $;
axiom dec_if: $ ieq (idec n8) ins_if $;
theorem encdec_if: $ ieq (idec (ienc ins_if)) ins_if $;
axiom enc_while: $ beq (ienc ins_while) n9 $;
axiom dec_while: $ ieq (idec n9) ins_while $;
theorem encdec_while: $ ieq (idec (ienc ins_while)) ins_while $;
axiom enc_match: $ beq (ienc ins_match) n10 $;
axiom dec_match: $ ieq (idec n10) ins_match $;
theorem encdec_match: $ ieq (idec (ienc ins_match)) ins_match $;
axiom enc_cmp_lt: $ beq (ienc ins_cmp_lt) n16 $;
axiom dec_cmp_lt: $ ieq (idec n16) ins_cmp_lt $;
theorem encdec_cmp_lt: $ ieq (idec (ienc ins_cmp_lt)) ins_cmp_lt $;
axiom enc_cmp_gt: $ beq (ienc ins_cmp_gt) n17 $;
axiom dec_cmp_gt: $ ieq (idec n17) ins_cmp_gt $;
theorem encdec_cmp_gt: $ ieq (idec (ienc ins_cmp_gt)) ins_cmp_gt $;
axiom enc_cmp_lte: $ beq (ienc ins_cmp_lte) n18 $;
axiom dec_cmp_lte: $ ieq (idec n18) ins_cmp_lte $;
theorem encdec_cmp_lte: $ ieq (idec (ienc ins_cmp_lte)) ins_cmp_lte $;
axiom enc_cmp_gte: $ beq (ienc ins_cmp_gte) n19 $;
axiom dec_cmp_gte: $ ieq (idec n19) ins_cmp_gte $;
theorem encdec_cmp_gte: $ ieq (idec (ienc ins_cmp_gte)) ins_cmp_gte $;
axiom enc_cmp_eq: $ beq (ienc ins_cmp_eq) n20 $;
axiom dec_cmp_eq: $ ieq (idec n20) ins_cmp_eq $;
theorem encdec_cmp_eq: $ ieq (idec (ienc ins_cmp_eq)) ins_cmp_eq $;
axiom enc_cmp_neq: $ beq (ienc ins_cmp_neq) n21 $;
axiom dec_cmp_neq: $ ieq (idec n21) ins_cmp_neq $;
theorem encdec_cmp_neq: $ ieq (idec (ienc ins_cmp_neq)) ins_cmp_neq $;
axiom enc_and: $ beq (ienc ins_and) n22 $;
axiom dec_and: $ ieq (idec n22) ins_and $;
theorem encdec_and: $ ieq (idec (ienc ins_and)) ins_and $;
axiom enc_or: $ beq (ienc ins_or) n23 $;
axiom dec_or: $ ieq (idec n23) ins_or $;
theorem encdec_or: $ ieq (idec (ienc ins_or)) ins_or $;
axiom enc_mul: $ beq (ienc ins_mul) n24 $;
axiom dec_mul: $ ieq (idec n24) ins_mul $;
theorem encdec_mul: $ ieq (idec (ienc ins_mul)) ins_mul $;
axiom enc_not: $ beq (ienc ins_not) n25 $;
axiom dec_not: $ ieq (idec n25) ins_not $;
theorem encdec_not: $ ieq (idec (ienc ins_not)) ins_not $;
axiom enc_deref: $ beq (ienc ins_deref) n32 $;
axiom dec_deref: $ ieq (idec n32) ins_deref $;
theorem encdec_deref: $ ieq (idec (ienc ins_deref)) ins_deref $;

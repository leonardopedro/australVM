axiom enc_store: $ beq (ienc ins_store) n48 $;
axiom dec_store: $ ieq (idec n48) ins_store $;
theorem encdec_store: $ ieq (idec (ienc ins_store)) ins_store $;

-- END GENERATED encdec


-- ── step_refines: one ISA step is one CPS-IR step ────────────────────────
-- The three refinements the emitted arithmetic needs, **proved** (proofs in
-- `mm0/isa.mm1`): `run_add` and `ir_add` both compute `radd (reg s a) (reg s b)`
-- into `dst` — `run_add_def` says so for the step relation, `ir_add_sem` says so
-- for the CPS opcode — and `req` is transitive and symmetric, so the two agree
-- on the destination register. Same shape for `mul` and `sub`.
--
-- Two things this proof measures. First, an earlier version of this file carried
-- the three as axioms, which double-counted the same assumption: they followed
-- from lines already in the file, so they were not gaps but restatements. Second,
-- the premises (`linear`, `in_bounds`) are *not used* by the proofs — the
-- refinement of arithmetic holds without them, because a register read is all
-- either side does. They stay in the statement on purpose: they are the
-- preconditions under which the step is ever *taken* in a kernel, and dropping
-- them here would quietly strengthen the claim while the world still needs them
-- (`bounds_from_layout` below is where they actually bite).
--
-- What this does NOT prove: that either side matches the hardware. That is the
-- `run_*_def`/`ir_*_sem` pair — definition-only, read by eye — plus the one
-- remaining cited hypothesis below.
theorem add_refines (s: St) (dst a b: nat):
  $ linear s $ > $ in_bounds s a $ > $ in_bounds s b $ >
  $ req (reg (run_add s dst a b) dst) (reg (ir_add s dst a b) dst) $;

theorem mul_refines (s: St) (dst a b: nat):
  $ linear s $ > $ in_bounds s a $ > $ in_bounds s b $ >
  $ req (reg (run_mul s dst a b) dst) (reg (ir_mul s dst a b) dst) $;

theorem sub_refines (s: St) (dst a b: nat):
  $ linear s $ > $ in_bounds s a $ > $ in_bounds s b $ >
  $ req (reg (run_sub s dst a b) dst) (reg (ir_sub s dst a b) dst) $;

-- ── bounds_from_layout: the memory obligations come from the layout ──────
-- The step relation needs "slot i is inside its block" at every access; the
-- layout discipline already establishes it, so the model cites rather than
-- re-proves it. A `deref` (0x20) or `store` (0x30) is in the subset only under
-- this hypothesis — that is what stops memory safety being proved twice.
-- gap-hypothesis: bounds_from_layout — cite=layout_certificate (H-BND)
axiom bounds_from_layout (s: St) (i: nat):
  $ typed s $ > $ linear s $ > $ in_bounds s i $;

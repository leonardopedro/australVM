-- isa.mm0 — the ISA layer of the verified kernel (W8 of
-- PLAN_sota_kernel_verification.md).
--
-- layer: ISA
-- instruction-table: cps-v2, 23 opcodes, measured by scripts/isa-census
-- proof-status: theory — definitions and axioms only, zero proved theorems and
--   zero `sorry`. mm0-c is the reason this file has no `theorem` line: it
--   refuses any theorem whose proof is missing (`error: some theorems used
--   sorry`), so a refinement that is not proved yet is written as an `axiom`
--   and is trusted, exactly as AlphaProof's definition-only semantics is: the
--   trusted part of an ISA model *is* its step relation, auditable line by
--   line. Each such axiom carries a `-- gap-hypothesis:` line naming the
--   layer-1 artifact that discharges its side conditions, and
--   scripts/verify-invariants refuses one whose citations are missing or whose
--   pinned digest no longer matches. Nothing here is called a theorem, so
--   nothing here can be mistaken for a proof.
--
-- theory coverage: used=req,radd,rmul,rneg,reg,setreg,neq,nat_eq,enc,dec,linear,typed,in_bounds,run_add,run_sub,run_mul,run_move,ir_add,ir_sub,ir_mul unused=n0,n1
--
-- cites: mm0/linearity_certificate.mm0 sha256=9eedc905fd7cd093e40f17e6735a0ea7ee763485370661fa5e0ce59fb7b336bf
-- cites: mm0/layout_certificate.mm0 sha256=20055174ee1e6942b9ef307737e44467f8eb338e67677f6427b4a0f450f6fa25
-- cites: mm0/flux1d_certificate.mm0 sha256=300e763dc165ab48b7d38f716af1fa1a76652fe0d9bd888d31c53ac26d56fb7a
--
-- WHY THIS FILE IS SMALL. Building an ISA semantics from scratch here would
-- prove linear types, refinements and memory safety a second time at a lower
-- level, in a weaker fragment, and the two proofs would be free to disagree.
-- Instead each guarantee enters as a *hypothesis with a citation*: `linear`,
-- `typed` and `in_bounds` below are never proved here, they are taken from the
-- three certificates named above, and scripts/verify-invariants refuses a
-- hypothesis whose `-- gap-hypothesis:` line has no pinned citation (or whose
-- pinned digest no longer matches the artifact). That is the whole design: the
-- model fills in the gaps, and the gaps are visible.
--
-- The trade is stated rather than softened: a bug in the linearity certificate
-- propagates into the machine-code claim. The alternative — two independent
-- proofs of linearity — was rejected because they can disagree silently, which
-- is worse than a pinned dependence that a reader can follow.
--
-- WHAT IS TRUSTED. The `-- op` table below, the `run_*` axioms (one per emitted
-- arithmetic/control instruction: the step relation as a definition) and the
-- nine congruence laws on `req`. Everything else is either a hypothesis with a
-- citation or a statement marked unproved. `scripts/isa-census` measures the
-- table against the instructions the JIT actually decodes, so the file cannot
-- drift into "the ISA" while the claim stays "the bytes we emit".

provable sort Prop;

sort nat;                       -- register indices, literal payloads
sort R;                         -- numeric values in a register
sort St;                        -- machine state: register file + memory
sort Ins;                       -- a decoded instruction of the emitted subset

delimiter $ ( ) $;
term n0: nat; prefix n0: $0$ prec max;
term n1: nat; prefix n1: $1$ prec max;

-- ── The instruction table (checked by scripts/isa-census) ────────────────
-- One line per opcode accepted by the CPS decoder (src/cps.rs) and emitted by
-- lib/CpsGen.ml. An opcode the decoder gains without a line here is a census
-- failure. The names are the decoder's own.
-- op 0x01 int_lit
-- op 0x02 var
-- op 0x03 let
-- op 0x04 app
-- op 0x05 add
-- op 0x06 sub
-- op 0x07 return
-- op 0x08 if
-- op 0x09 while
-- op 0x0A match
-- op 0x10 cmp_lt
-- op 0x11 cmp_gt
-- op 0x12 cmp_lte
-- op 0x13 cmp_gte
-- op 0x14 cmp_eq
-- op 0x15 cmp_neq
-- op 0x16 and
-- op 0x17 or
-- op 0x18 mul
-- op 0x19 not
-- op 0x20 deref
-- op 0x21 string_lit
-- op 0x30 store

-- ── Values and states ────────────────────────────────────────────────────
term radd (x y: R): R;
term rmul (x y: R): R;
term rneg (x: R): R;

term req (x y: R): Prop;
axiom req_refl (x: R): $ req x x $;
axiom req_symm (x y: R): $ req x y $ > $ req y x $;
axiom req_trans (x y z: R): $ req x y $ > $ req y z $ > $ req x z $;

-- R is a commutative ring: the arithmetic the emitted `add`/`sub`/`mul` steps
-- are required to implement, and the laws W2's theory already reasons in.
axiom radd_comm (x y: R): $ req (radd x y) (radd y x) $;
axiom radd_assoc (x y z: R): $ req (radd (radd x y) z) (radd x (radd y z)) $;
axiom rmul_assoc (x y z: R): $ req (rmul (rmul x y) z) (rmul x (rmul y z)) $;
axiom rmul_distrib (x y z: R): $ req (rmul x (radd y z)) (radd (rmul x y) (rmul x z)) $;

-- Registers. `setreg s i v` writes i; the distinctness side condition is a
-- hypothesis (`neq`), never assumed away: two different registers holding
-- different values is the case a wrong model would get for free.
term reg (s: St) (i: nat): R;
term setreg (s: St) (i: nat) (v: R): St;
term neq (i j: nat): Prop;

axiom reg_setreg_same (s: St) (i: nat) (v: R): $ req (reg (setreg s i v) i) v $;
axiom reg_setreg_other (s: St) (i j: nat) (v: R):
  $ neq i j $ > $ req (reg (setreg s i v) j) (reg s j) $;

-- ── The layer-1 hypotheses: cited, never proved here ─────────────────────
term linear (s: St): Prop;      -- linearity of the live bindings (H-LIN)
term typed (s: St): Prop;       -- refinement typing of live values (H-REF)
term in_bounds (s: St) (i: nat): Prop;  -- block bounds of the i-th slot (H-BND)

-- ── The step relation: definitions of the emitted subset ─────────────────
-- One axiom per instruction the certified fragment needs. "Definition-only" in
-- the sense AlphaProof uses: the trusted part is these lines, and they are
-- auditable by eye because each says "this instruction does exactly this".
term run_add (s: St) (dst a b: nat): St;
axiom run_add_def (s: St) (dst a b: nat):
  $ req (reg (run_add s dst a b) dst) (radd (reg s a) (reg s b)) $;

term run_sub (s: St) (dst a b: nat): St;
axiom run_sub_def (s: St) (dst a b: nat):
  $ req (reg (run_sub s dst a b) dst) (radd (reg s a) (rneg (reg s b))) $;

term run_mul (s: St) (dst a b: nat): St;
axiom run_mul_def (s: St) (dst a b: nat):
  $ req (reg (run_mul s dst a b) dst) (rmul (reg s a) (reg s b)) $;

term run_move (s: St) (dst a: nat): St;
axiom run_move_def (s: St) (dst a: nat):
  $ req (reg (run_move s dst a) dst) (reg s a) $;

-- ── The CPS-IR side: the same instruction, one layer up ──────────────────
-- `ir_add` is the CPS opcode 0x05; `ir_mul` is 0x18; `ir_sub` is 0x06. They are
-- separate terms on purpose: the file proves a relation *between* the two
-- layers, not an equation that would make the layers identical by fiat.
term ir_add (s: St) (dst a b: nat): St;
axiom ir_add_sem (s: St) (dst a b: nat):
  $ req (reg (ir_add s dst a b) dst) (radd (reg s a) (reg s b)) $;

term ir_mul (s: St) (dst a b: nat): St;
axiom ir_mul_sem (s: St) (dst a b: nat):
  $ req (reg (ir_mul s dst a b) dst) (rmul (reg s a) (reg s b)) $;

term ir_sub (s: St) (dst a b: nat): St;
axiom ir_sub_sem (s: St) (dst a b: nat):
  $ req (reg (ir_sub s dst a b) dst) (radd (reg s a) (rneg (reg s b))) $;

-- ── encdec: decode (encode i) = i, for the emitted subset ────────────────
-- The byte round trip is a property of two implementations (lib/CpsGen.ml
-- writes, src/cps.rs reads), not of a ring, so it is not provable in this file
-- and is not claimed to be. What exists is operational evidence and the census
-- states it: 23/23 declared opcodes are emitted by one side and accepted by the
-- other, and a module compiles only if the decoder consumes exactly the bytes
-- the encoder wrote. `status=measured-not-proved` so nobody counts it as a proof.
term enc (i: nat): nat;         -- opcode index -> byte
term dec (b: nat): nat;         -- byte -> opcode index
term nat_eq (i j: nat): Prop;

-- gap-hypothesis: encdec — pinned cite=isa-census (23/23 opcodes), status=measured-not-proved
axiom encdec (i: nat): $ nat_eq (dec (enc i)) i $;

-- ── step_refines: one ISA step is one CPS-IR step ────────────────────────
-- The three refinements the emitted arithmetic needs. Each takes the layer-1
-- hypotheses as premises rather than re-establishing them; the `-- gap-
-- hypothesis:` line names who discharges them, and the digest is pinned in the
-- header. Proving these inside mm0 is W8's remaining work — until then they are
-- axioms, which is why the header says `zero proved theorems`.
-- gap-hypothesis: add_refines — cite=linearity_certificate (H-LIN), cite=layout_certificate (H-BND)
axiom add_refines (s: St) (dst a b: nat):
  $ linear s $ > $ in_bounds s a $ > $ in_bounds s b $ >
  $ req (reg (run_add s dst a b) dst) (reg (ir_add s dst a b) dst) $;

-- gap-hypothesis: mul_refines — cite=linearity_certificate (H-LIN), cite=layout_certificate (H-BND)
axiom mul_refines (s: St) (dst a b: nat):
  $ linear s $ > $ in_bounds s a $ > $ in_bounds s b $ >
  $ req (reg (run_mul s dst a b) dst) (reg (ir_mul s dst a b) dst) $;

-- gap-hypothesis: sub_refines — cite=linearity_certificate (H-LIN), cite=layout_certificate (H-BND)
axiom sub_refines (s: St) (dst a b: nat):
  $ linear s $ > $ in_bounds s a $ > $ in_bounds s b $ >
  $ req (reg (run_sub s dst a b) dst) (reg (ir_sub s dst a b) dst) $;

-- ── bounds_from_layout: the memory obligations come from the layout ──────
-- The step relation needs "slot i is inside its block" at every access; the
-- layout discipline already establishes it, so the model cites rather than
-- re-proves it. A `deref` (0x20) or `store` (0x30) is in the subset only under
-- this hypothesis — that is what stops memory safety being proved twice.
-- gap-hypothesis: bounds_from_layout — cite=layout_certificate (H-BND)
axiom bounds_from_layout (s: St) (i: nat):
  $ typed s $ > $ linear s $ > $ in_bounds s i $;

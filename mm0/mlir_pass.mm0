-- cites: mm0/proof_chain/mlir/ir/clamp.post-nvvm.mlir sha256=7b71782b5d407e7a095c648bd874ab58896f3c15d55d2d8a1e101ea546d07340
--
-- certificate: [gap] — one stated obligation per captured boundary, no proof.
--   No `mm0/approved/mlir_pass.stmts` exists, so this is not even a W3 statement
--   of record yet; `scripts/verify-invariants` reports it as unapproved.
--
-- The obligations, in route order. Each names the pass, and the two files
-- `stage.toml` records for it; `claims` refuses a mismatch in either direction.
-- obligation: kernelir-to-mlir pre=clamp.kernelir post=clamp.mlir
-- obligation: mlir-canonicalize pre=clamp.mlir post=clamp.canonical.mlir
-- obligation: convert-nvgpu-to-nvvm pre=clamp.canonical.mlir post=clamp.seg01.mlir
-- obligation: gpu-kernel-outlining pre=clamp.seg01.mlir post=clamp.seg02.mlir
-- obligation: convert-vector-to-scf pre=clamp.seg02.mlir post=clamp.seg03.mlir
-- obligation: convert-scf-to-cf pre=clamp.seg03.mlir post=clamp.seg04.mlir
-- obligation: convert-nvvm-to-llvm pre=clamp.seg04.mlir post=clamp.seg05.mlir
-- obligation: convert-func-to-llvm pre=clamp.seg05.mlir post=clamp.seg06.mlir
-- obligation: expand-strided-metadata pre=clamp.seg06.mlir post=clamp.seg07.mlir
-- obligation: nvvm-attach-target pre=clamp.seg07.mlir post=clamp.seg08.mlir
-- obligation: lower-affine pre=clamp.seg08.mlir post=clamp.seg09.mlir
-- obligation: convert-arith-to-llvm pre=clamp.seg09.mlir post=clamp.seg10.mlir
-- obligation: convert-index-to-llvm pre=clamp.seg10.mlir post=clamp.seg11.mlir
-- obligation: canonicalize pre=clamp.seg11.mlir post=clamp.seg12.mlir
-- obligation: cse pre=clamp.seg12.mlir post=clamp.seg13.mlir
-- obligation: strip-debuginfo pre=clamp.seg13.mlir post=clamp.pre-nvvm.mlir
-- obligation: convert-gpu-to-nvvm pre=clamp.pre-nvvm.mlir post=clamp.post-nvvm.mlir

-- theory: self-declared vocabulary — the sorts and terms below are this
-- artifact's whole theory; no rule is imported from another MM0 file, and the
-- semantics the claims are *about* lives in the cited modules, not here.
--
-- `provable sort Prop` is how this repo's MM0 files get a proposition sort
-- (see `mm0/store_projection.mm0`); without it `: Prop` is "sort not found".
sort Mod;                       -- one MLIR module, uninterpreted
sort Val;                       -- the values a module computes, uninterpreted
sort Idx;                       -- observation indices, uninterpreted
provable sort Prop;

-- `denotes m i v` is intended as "module `m`, observed at `i`, computes `v`".
-- Uninterpreted: naming the observation is this layer's job, defining it is the
-- dialect semantics' job, which this repository does not have.
term denotes (m: Mod) (i: Idx) (v: Val): Prop;

-- One relation per captured boundary, named after its pass (MM0 has no
-- string-indexed relation, so the four are separate terms rather than one
-- family). Each is intended as the ∀/↔ statement in the header.
term kernelir_to_mlir_preserves (a b: Mod): Prop;
term mlir_canonicalize_preserves (a b: Mod): Prop;
-- The segment's fourteen passes share one relation, indexed by the pass's
-- position in the route (MM0 has no string-indexed terms); the obligation list
-- above says which position is which pass. The four identity-carrying passes
-- make some of these claims reflexive — `denotes a i v ↔ denotes a i v` — which
-- is a fact about this module's IR, not about the pass.
term mlir_segment_pass_preserves (p: Idx) (a b: Mod): Prop;
term convert_gpu_to_nvvm_preserves (a b: Mod): Prop;

-- cic.mm0 — the MM0 target theory for the Lean4→DeltaNets→MM0 pipeline,
-- adapted to this project's *existing* term language (unfer/logos deltanet)
-- rather than a generic CIC axiomatization.
--
-- Why adapted: the generic plan (docs/lean4mm0.md) axiomatized the Calculus
-- of Inductive Constructions, but the conversion checker this project
-- actually runs is `logos::deltanet` — a first-order interaction-net
-- reducer over a fixed agent signature (App, Abs, Con, Fold, Dup, Era,
-- Prim, Lit, Entity). Definitional equality here is *net isomorphism after
-- reduction* (the unique-normal-form property), certified by the
-- isomorphism witness π from `deltanet::unf::isomorphism_witness`. This
-- theory speaks exactly that language, so a proof trace emitted for it
-- names real pipeline objects instead of hypothetical ones.
--
-- Validated end-to-end on 2026-10-23: `mm0-rs compile cic.mm0 -> cic.mmb`
-- (3 sorts, 20 terms, 11 axioms, exit 0) and `mm0-c cic.mmb < cic.mm0`
-- (exit 0). Phase D (docs/lean4mm0.md §5/§7) has landed the *theorem*
-- side: `australVM/mm0/gap_certificate.{mm0,mm1}` — generated by
-- `australVM/scripts/lean2mm0` from the nanoda-verified lean4export of
-- `../timepiece/GapCertificate.lean`, compiled by mm0-rs (3 sorts, 46
-- term/def, 39 ax/thm), verified by mm0-c; gated in
-- `australVM/scripts/verify-invariants`.
--
-- Phase-D note on rule form: the structural rules below state their
-- premises with `>` (hypothesis binders), not `->` inside the formula.
-- MM0's logic has no internal modus ponens — a `->`-inside-formula axiom
-- only proves that an *implication term* is derivable, and can never be
-- *applied* to reach a conclusion. Hypothesis form is the applicable
-- inference rule, and it is what the generated proofs consume.

provable sort Prop;
sort Term;
sort nat;                        -- index/tag/level/op/bit payloads (no
                                 -- numerals needed: see teval below)

-- Secondary-lexer delimiters: parentheses are standalone tokens in math
-- strings, so `teq (tapp f a) b` lexes (mm0-rs splits formulas on
-- whitespace otherwise). Same declaration as examples/hello.mm0.
delimiter $ ( ) $;

-- ── The agent signature (untyped de Bruijn terms, mirroring AgentKind) ────

term tvar (i: nat): Term;                  -- De Bruijn index (open terms)
term tapp (f a: Term): Term;               -- App agent
term tabs (b: Term): Term;                 -- Abs agent (binder)
term tint (n: nat): Term;                  -- Int64 literal (payload bits)
term tf64 (bits: nat): Term;               -- F64 literal (IEEE-754 bits)
term ttrue: Term;                          -- Bool literal
term tfalse: Term;                         -- Bool literal
term tcon (tag: nat): Term;                -- Con agent head (TagId)
term tnil: Term;                           -- constructor argument spine, end
term tcons (h t: Term): Term;              -- constructor argument spine, cons
term tfold (f i l: Term): Term;            -- Fold agent (list fold)
term tdup (level: nat): Term;              -- Dup agent (duplication level)
term tera: Term;                           -- Era agent (erasure)
term tprim (op: nat): Term;                -- Prim agent (unf.rs prim_tag byte)
term tentity (sym: nat): Term;             -- Entity (symbol-table-indexed name)
term tsubst (b a: Term): Term;             -- De Bruijn substitution (meta)
term teval (op n m: nat): nat;             -- the ground evaluator: the value
                                            -- the reducer folds op(n, m) to.
                                            -- Uninterpreted here; the emitter
                                            -- grounds each prim_tag byte.

-- ── Judgmental equality ──────────────────────────────────────────────────

term teq (t u: Term): Prop;
term timp (p q: Prop): Prop;               -- implication (the only connective
                                            -- this theory needs)
infixr timp: $->$ prec 25;

axiom teq_refl (t: Term): $ teq t t $;
axiom teq_symm (t u: Term): $ teq t u $ > $ teq u t $;
axiom teq_trans (t u v: Term): $ teq t u $ > $ teq u v $ > $ teq t v $;

-- Substitution is the structural congruence the beta rule needs. It is
-- axiomatized at the meta level here (the emitter never proves it; the
-- net reducer *is* the substitution engine).
axiom tsubst_beta (b a: Term): $ teq (tapp (tabs b) a) (tsubst b a) $;
axiom teq_subst (b b2 a a2: Term):
  $ teq b b2 $ > $ teq a a2 $ > $ teq (tsubst b a) (tsubst b2 a2) $;
axiom teq_app (f f2 a a2: Term):
  $ teq f f2 $ > $ teq a a2 $ > $ teq (tapp f a) (tapp f2 a2) $;

-- ── Reduction rules of the agent signature (the net rewrite system) ──────
-- Each axiom mirrors an arm of `deltanet::reducer`'s interact function.

-- Fold ↔ Con: the two Fold rules (return init / unfold one cons cell).
axiom fold_nil (f i: Term): $ teq (tfold f i tnil) i $;
axiom fold_cons (f i h t: Term):
  $ teq (tfold f i (tcons h t)) (tapp (tapp f h) (tfold f i t)) $;

-- Prim ↔ Lit, Lit: native evaluation. The reducer folds ground prims
-- natively (the graph-to-native trap), so this is the axiom schema whose
-- ground instances the emitter emits.
axiom prim_eval (op n m: nat):
  $ teq (tapp (tapp (tprim op) (tint n)) (tint m)) (tint (teval op n m)) $;

-- Era propagation: an erased agent collapses (the net-level statement the
-- reducer enforces by rewiring; here only the root-facing form is needed).
axiom era_collapse (t: Term): $ teq (tapp tera t) tera $;

-- ── The conversion certificate rule (isomorphism witness) ────────────────
-- The heart of the pipeline: two normal forms that are isomorphic as rooted
-- port graphs are judgmentally equal, and the certificate is the witness π
-- — the node permutation from `deltanet::unf::isomorphism_witness`, whose
-- kernel-side check (`IsomorphismWitness::verifies`) requires the pairing to
-- preserve agent kinds and aux-port wiring. `valid_iso` is the *checked*
-- predicate: the emitter packages a concrete π, and mm0-c's consumer checks
-- it against the two concrete net encodings; MM0 logic only records that a
-- checked certificate entails equality.

term valid_iso (t u cert: Term): Prop;     -- cert encodes a witnessed π

axiom net_isomorphism_step (t u cert: Term):
  $ valid_iso t u cert $ > $ teq t u $;

-- ── The UNF theorem (what the whole pipeline certifies) ──────────────────
-- Reduction confluent ⟹ normal forms unique ⟹ equality of normal forms
-- decides judgmental equality of the encoded terms. Corroborated by
-- `unfer/logos/lean/Confluence.lean` (kernel-computed rfl proofs, exported
-- via lean4export and re-verified in nanoda) and at runtime by the fixed-
-- point confluence self-check in `logos::translate`.

-- quasi_rh_certificate.{mm0,mm1} — GENERATED by australVM/scripts/lean2mm0.
-- DO NOT EDIT: run `scripts/lean2mm0` to regenerate;
-- `scripts/lean2mm0 check` gates drift, `scripts/lean2mm0 verify`
-- runs the mm0-rs elaborator and the mm0-c root of trust.
--
-- Source of record : timepiece/QuasiRiemannCertificate.lean
-- Kernel export    : unfer/prob_kernel/tests/fixtures/quasi_rh_certificate.ndjson
--   sha256 cba70e2f6d7e1d20bbaa2a896ab7902fd69384c317c392f05105fd9a79916976  (lean4export 3.1.0, re-verified by nanoda
--   in unfer's prob_kernel suite)
-- Target theory    : australVM/docs/cic.mm0 (embedded verbatim below)
--
-- Each `<x>_checked : Term` is the agent-signature encoding of the Lean
-- def's unfolded body (tint / tprim at unf.rs prim_tag bytes / ttrue /
-- tfalse / tentity). Each `<x>_verified` reduces that encoding to ttrue
-- by congruence + prim_eval + grounded instances; mm0-c checks every
-- step against docs/cic.mm0.
--
-- trust-split: structural=9 grounded=0 certificates=9
--
-- Trust split (tagged on each def below — structural vs grounded):
--   9 structural: the net spine is checked by mm0-c step by step
--     (congruence teq_app, prim_eval bridges, grounded instances); its
--     literal leaves — e.g. a List.length the kernel reduced — were
--     evaluated by the emitter and cross-checked against the net's
--     own reduction before emission.
--   0 grounded: the body is ttrue because the def is pure
--     recursion, which the signature cannot encode (no recursion agent);
--     the emitter evaluated it. The anchor is nanoda's kernel-verified rfl
--     plus the emitter's two independent paths (evaluator vs net), not a
--     structural proof — mm0-c verifies only the resulting tautology.
-- theory coverage: used=tapp,tint,ttrue,tprim,tentity,teval unused=tvar,tabs,tf64,tfalse,tcon,tnil,tcons,tfold,tdup,tera,tsubst

-- Ground numerals: declared once, written as decimal tokens so the
-- emitted arithmetic reads exactly like the certificate:
--   teq (tint (teval 1 19875 555)) (tint 19320)   -- 19875 - 555
term n0: nat; prefix n0: $0$ prec max;
term n1: nat; prefix n1: $1$ prec max;
term n2: nat; prefix n2: $2$ prec max;
term n3: nat; prefix n3: $3$ prec max;
term n4: nat; prefix n4: $4$ prec max;
term n5: nat; prefix n5: $5$ prec max;
term n7: nat; prefix n7: $7$ prec max;
term n8: nat; prefix n8: $8$ prec max;
term n13: nat; prefix n13: $13$ prec max;
term n1250: nat; prefix n1250: $1250$ prec max;
term n8749: nat; prefix n8749: $8749$ prec max;
term n8750: nat; prefix n8750: $8750$ prec max;
term n9000: nat; prefix n9000: $9000$ prec max;
term n10000: nat; prefix n10000: $10000$ prec max;
term n70000: nat; prefix n70000: $70000$ prec max;

-- read_bound_verified: Lean def `read_bound_checked`, reduced to true by kernel rfl.
--   structural: net spine checked by mm0-c (trust split above).
def read_bound_checked: Term = $ (tapp (tapp (tprim 13) (tapp (tapp (tprim 3) (tint 8750)) (tint 8750))) (tapp (tapp (tprim 3) (tint 4)) (tint 4))) $;

-- bound_computes_verified: Lean def `bound_computes_checked`, reduced to true by kernel rfl.
--   structural: net spine checked by mm0-c (trust split above).
def bound_computes_checked: Term = $ (tapp (tapp (tprim 3) (tapp (tapp (tentity 0) (tapp (tapp (tprim 2) (tint 7)) (tint 10000))) (tint 8))) (tint 8750)) $;

-- bound_is_seven_eighths_verified: Lean def `bound_is_seven_eighths_checked`, reduced to true by kernel rfl.
--   structural: net spine checked by mm0-c (trust split above).
def bound_is_seven_eighths_checked: Term = $ (tapp (tapp (tprim 3) (tapp (tapp (tprim 2) (tint 7)) (tint 10000))) (tapp (tapp (tprim 2) (tint 8)) (tapp (tapp (tentity 0) (tapp (tapp (tprim 2) (tint 7)) (tint 10000))) (tint 8)))) $;

-- theta_lt_one_verified: Lean def `theta_lt_one_checked`, reduced to true by kernel rfl.
--   structural: net spine checked by mm0-c (trust split above).
def theta_lt_one_checked: Term = $ (tapp (tapp (tprim 5) (tapp (tapp (tentity 0) (tapp (tapp (tprim 2) (tint 7)) (tint 10000))) (tint 8))) (tint 10000)) $;

-- epsilon_gap_verified: Lean def `epsilon_gap_checked`, reduced to true by kernel rfl.
--   structural: net spine checked by mm0-c (trust split above).
def epsilon_gap_checked: Term = $ (tapp (tapp (tprim 3) (tapp (tapp (tprim 1) (tint 10000)) (tapp (tapp (tentity 0) (tapp (tapp (tprim 2) (tint 7)) (tint 10000))) (tint 8)))) (tint 1250)) $;

-- epsilon_is_one_eighth_verified: Lean def `epsilon_is_one_eighth_checked`, reduced to true by kernel rfl.
--   structural: net spine checked by mm0-c (trust split above).
def epsilon_is_one_eighth_checked: Term = $ (tapp (tapp (tprim 3) (tapp (tapp (tprim 2) (tapp (tapp (tprim 1) (tint 10000)) (tapp (tapp (tentity 0) (tapp (tapp (tprim 2) (tint 7)) (tint 10000))) (tint 8)))) (tint 8))) (tint 10000)) $;

-- interior_point_verified: Lean def `interior_point_checked`, reduced to true by kernel rfl.
--   structural: net spine checked by mm0-c (trust split above).
def interior_point_checked: Term = $ (tapp (tapp (tprim 5) (tapp (tapp (tentity 0) (tapp (tapp (tprim 2) (tint 7)) (tint 10000))) (tint 8))) (tint 9000)) $;

-- boundary_point_excluded_verified: Lean def `boundary_point_excluded_checked`, reduced to true by kernel rfl.
--   structural: net spine checked by mm0-c (trust split above).
def boundary_point_excluded_checked: Term = $ (tapp (tapp (tprim 5) (tint 8749)) (tapp (tapp (tentity 0) (tapp (tapp (tprim 2) (tint 7)) (tint 10000))) (tint 8))) $;

-- pole_at_one_verified: Lean def `pole_at_one_checked`, reduced to true by kernel rfl.
--   structural: net spine checked by mm0-c (trust split above).
def pole_at_one_checked: Term = $ (tapp (tapp (tprim 13) (tapp (tapp (tprim 3) (tapp (tapp (tprim 2) (tint 1)) (tint 10000))) (tint 10000))) (tapp (tapp (tprim 5) (tapp (tapp (tentity 0) (tapp (tapp (tprim 2) (tint 7)) (tint 10000))) (tint 8))) (tapp (tapp (tprim 2) (tint 1)) (tint 10000)))) $;

-- Ground evaluation of int64 redexes, via cic.mm0's prim_eval schema:
--   prim_eval gives  teq redex (tint (teval op a b)); the bridge below
--   grounds the uninterpreted `teval` at this instance (cic.mm0:
--   "the emitter grounds each prim_tag byte"). Each is a trivially
-- checkable decimal fact — the auditing stance of the spec file.
axiom teval_ground_eq_4_4: $ teq (tint (teval 3 4 4)) ttrue $;
axiom teval_ground_eq_1250_1250: $ teq (tint (teval 3 1250 1250)) ttrue $;
axiom teval_ground_eq_8750_8750: $ teq (tint (teval 3 8750 8750)) ttrue $;
axiom teval_ground_eq_10000_10000: $ teq (tint (teval 3 10000 10000)) ttrue $;
axiom teval_ground_eq_70000_70000: $ teq (tint (teval 3 70000 70000)) ttrue $;
axiom teval_ground_lt_8749_8750: $ teq (tint (teval 5 8749 8750)) ttrue $;
axiom teval_ground_lt_8750_9000: $ teq (tint (teval 5 8750 9000)) ttrue $;
axiom teval_ground_lt_8750_10000: $ teq (tint (teval 5 8750 10000)) ttrue $;
axiom teval_ground_mul_1_10000: $ teq (tint (teval 2 1 10000)) (tint 10000) $;
axiom teval_ground_mul_7_10000: $ teq (tint (teval 2 7 10000)) (tint 70000) $;
axiom teval_ground_mul_8_8750: $ teq (tint (teval 2 8 8750)) (tint 70000) $;
axiom teval_ground_mul_1250_8: $ teq (tint (teval 2 1250 8)) (tint 10000) $;
axiom teval_ground_sub_10000_8750: $ teq (tint (teval 1 10000 8750)) (tint 1250) $;

-- Directly grounded redexes: bool-valued prims (cic.mm0's prim_eval
-- codomain is tint), the unary not, and integer division — the agent
-- signature has no div primitive (austral_codegen: `/` is always F64),
-- so Nat.div is a symbol-level application; its symbol table:
--   tentity 0 = idiv (integer division)
axiom ground_and_1_1: $ teq (tapp (tapp (tprim 13) ttrue) ttrue) ttrue $;
axiom ground_idiv_70000_8: $ teq (tapp (tapp (tentity 0) (tint 70000)) (tint 8)) (tint 8750) $;

theorem read_bound_verified: $ teq read_bound_checked ttrue $;
theorem bound_computes_verified: $ teq bound_computes_checked ttrue $;
theorem bound_is_seven_eighths_verified: $ teq bound_is_seven_eighths_checked ttrue $;
theorem theta_lt_one_verified: $ teq theta_lt_one_checked ttrue $;
theorem epsilon_gap_verified: $ teq epsilon_gap_checked ttrue $;
theorem epsilon_is_one_eighth_verified: $ teq epsilon_is_one_eighth_checked ttrue $;
theorem interior_point_verified: $ teq interior_point_checked ttrue $;
theorem boundary_point_excluded_verified: $ teq boundary_point_excluded_checked ttrue $;
theorem pole_at_one_verified: $ teq pole_at_one_checked ttrue $;


  $ wceq V (cfv U cbs) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq F (cfv C cbs) $ >
  $ wceq R (cfv C csg) $ >
  $ wceq J (cfv C clspn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel Y (cdif V (csn c_0))) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wceq (cfv (cfv (csn X) N) M) (cfv (csn G) J)) $ >
  $ wi ph (wa (wcel (cv h) F) (wa (wceq (cfv (cfv (csn Y) N) M) (cfv (csn (cv h)) J)) (wceq (cfv (cfv (csn (co X Y c_mi)) N) M) (cfv (csn (co G (cv h) R)) J)))) $ >
  $ wi ph (wa (wcel (cv i) F) (wa (wceq (cfv (cfv (csn Y) N) M) (cfv (csn (cv i)) J)) (wceq (cfv (cfv (csn (co X Y c_mi)) N) M) (cfv (csn (co G (cv i) R)) J)))) $ >
  $ wceq A2 (cfv U csca) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_x (cfv C cvsca) $ >
  $ wceq O (cfv A2 c0g) $ >
  $ wi ph (wcel (cv v) B2) $ >
  $ wi ph (wceq (cv h) (co (cv u) (cv i) c_x)) $ >
  $ wi ph (wceq (co G (cv h) R) (co (cv v) (co G (cv i) R) c_x)) $ >
  $ wi ph (wne (cfv (csn G) J) (cfv (csn (cv i)) J)) $;

--| Lemma for ~ mapdpg . Baer p. 45 line 18: "vx'-vy'' = x'-uy''". (Contributed by NM, 22-Mar-2015.)
theorem mapdpglem28 {v u h i: setvar} (ph: wff v u h i) (A2: class v u h i) (B2 C: class h i) (R: class u h i) (c_x: class h i) (U F: class v u h i) (G: class u h i) (H J K M c_mi N: class v u h i) (O: class h i) (V W X Y c_0: class v u h i):
  $ wceq H (cfv K clh) $ >

  $ wceq F (cmpt x3 B2 (cif (wa (wne P Q) (wn (wbr (cv x3) W c_le))) (crio z (wral s1 (wi (wa (wn (wbr (cv s1) W c_le)) (wceq (co (cv s1) (co (cv x3) W c_an) c_or) (cv x3))) (wceq (cv z) (co (cif (wbr (cv s1) (co P Q c_or) c_le) (crio y1 (wral t (wi (wa (wn (wbr (cv t) W c_le)) (wn (wbr (cv t) (co P Q c_or) c_le))) (wceq (cv y1) E)) A2) B2) (csb t (cv s1) D)) (co (cv x3) W c_an) c_or))) A2) B2) (cv x3))) $ >
  $ wi (wa (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wa (wcel R A2) (wn (wbr R W c_le)))) (wceq (co (co R (cfv R F) c_or) W c_an) U) $;

--| Part of proof of Lemma E in [Crawley] p. 113. TODO: fix comment. (Contributed by NM, 14-Apr-2013.) (New usage is discouraged.)
theorem cdleme51finvfvN {x3 y1 z v u t s1 a b c: setvar} (A2 B2: class) (D: class u t) (P Q: class) (U: class u) (E: class v u t s1) (F: class x3 y1 z t s1) (G: class v u a b c) (H c_or K c_le c_an: class) (N: class v s1) (O: class v u t s1) (V: class s1) (W: class) (X: class b):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq U (co (co P Q c_or) W c_an) $ >
  $ wceq D (co (co (cv t) U c_or) (co Q (co (co P (cv t) c_or) W c_an) c_or) c_an) $ >
  $ wceq E (co (co P Q c_or) (co D (co (co (cv s1) (cv t) c_or) W c_an) c_or) c_an) $ >
  $ wceq F (cmpt x3 B2 (cif (wa (wne P Q) (wn (wbr (cv x3) W c_le))) (crio z (wral s1 (wi (wa (wn (wbr (cv s1) W c_le)) (wceq (co (cv s1) (co (cv x3) W c_an) c_or) (cv x3))) (wceq (cv z) (co (cif (wbr (cv s1) (co P Q c_or) c_le) (crio y1 (wral t (wi (wa (wn (wbr (cv t) W c_le)) (wn (wbr (cv t) (co P Q c_or) c_le))) (wceq (cv y1) E)) A2) B2) (csb t (cv s1) D)) (co (cv x3) W c_an) c_or))) A2) B2) (cv x3))) $ >
  $ wceq V (co (co Q P c_or) W c_an) $ >
  $ wceq N (co (co (cv v) V c_or) (co P (co (co Q (cv v) c_or) W c_an) c_or) c_an) $ >
  $ wceq O (co (co Q P c_or) (co N (co (co (cv u) (cv v) c_or) W c_an) c_or) c_an) $ >
  $ wceq G (cmpt a B2 (cif (wa (wne Q P) (wn (wbr (cv a) W c_le))) (crio c (wral u (wi (wa (wn (wbr (cv u) W c_le)) (wceq (co (cv u) (co (cv a) W c_an) c_or) (cv a))) (wceq (cv c) (co (cif (wbr (cv u) (co Q P c_or) c_le) (crio b (wral v (wi (wa (wn (wbr (cv v) W c_le)) (wn (wbr (cv v) (co Q P c_or) c_le))) (wceq (cv b) O)) A2) B2) (csb v (cv u) N)) (co (cv a) W c_an) c_or))) A2) B2) (cv a))) $ >
  $ wi (wa (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wcel X B2)) (wceq (cfv X (ccnv F)) (cfv X G)) $;

--| Part of proof of Lemma E in [Crawley] p. 113. TODO: fix comment. (Contributed by NM, 14-Apr-2013.) (New usage is discouraged.)
theorem cdleme51finvN {x3 y1 z v u t s1 a b c: setvar} (A2 B2: class) (D: class u t) (P Q: class) (U: class u) (E: class v u t s1) (F: class x3 y1 z t s1) (G: class v u a b c) (H c_or K c_le c_an: class) (N: class v s1) (O: class v u t s1) (V: class s1) (W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq U (co (co P Q c_or) W c_an) $ >
  $ wceq D (co (co (cv t) U c_or) (co Q (co (co P (cv t) c_or) W c_an) c_or) c_an) $ >
  $ wceq E (co (co P Q c_or) (co D (co (co (cv s1) (cv t) c_or) W c_an) c_or) c_an) $ >
  $ wceq F (cmpt x3 B2 (cif (wa (wne P Q) (wn (wbr (cv x3) W c_le))) (crio z (wral s1 (wi (wa (wn (wbr (cv s1) W c_le)) (wceq (co (cv s1) (co (cv x3) W c_an) c_or) (cv x3))) (wceq (cv z) (co (cif (wbr (cv s1) (co P Q c_or) c_le) (crio y1 (wral t (wi (wa (wn (wbr (cv t) W c_le)) (wn (wbr (cv t) (co P Q c_or) c_le))) (wceq (cv y1) E)) A2) B2) (csb t (cv s1) D)) (co (cv x3) W c_an) c_or))) A2) B2) (cv x3))) $ >
  $ wceq V (co (co Q P c_or) W c_an) $ >
  $ wceq N (co (co (cv v) V c_or) (co P (co (co Q (cv v) c_or) W c_an) c_or) c_an) $ >
  $ wceq O (co (co Q P c_or) (co N (co (co (cv u) (cv v) c_or) W c_an) c_or) c_an) $ >
  $ wceq G (cmpt a B2 (cif (wa (wne Q P) (wn (wbr (cv a) W c_le))) (crio c (wral u (wi (wa (wn (wbr (cv u) W c_le)) (wceq (co (cv u) (co (cv a) W c_an) c_or) (cv a))) (wceq (cv c) (co (cif (wbr (cv u) (co Q P c_or) c_le) (crio b (wral v (wi (wa (wn (wbr (cv v) W c_le)) (wn (wbr (cv v) (co Q P c_or) c_le))) (wceq (cv b) O)) A2) B2) (csb v (cv u) N)) (co (cv a) W c_an) c_or))) A2) B2) (cv a))) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wceq (ccnv F) G) $;

--| Part of proof of Lemma E in [Crawley] p. 113. ` F ` is a lattice translation. TODO: fix comment. (Contributed by NM, 10-Apr-2013.)
theorem cdleme50ltrn {x3 y1 z t s1: setvar} (A2 B2: class) (D: class t) (P Q: class) (T: class x3 y1 z t s1) (U: class) (E: class t s1) (F: class x3 y1 z t s1) (H c_or K c_le c_an W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq U (co (co P Q c_or) W c_an) $ >
  $ wceq D (co (co (cv t) U c_or) (co Q (co (co P (cv t) c_or) W c_an) c_or) c_an) $ >
  $ wceq E (co (co P Q c_or) (co D (co (co (cv s1) (cv t) c_or) W c_an) c_or) c_an) $ >
  $ wceq F (cmpt x3 B2 (cif (wa (wne P Q) (wn (wbr (cv x3) W c_le))) (crio z (wral s1 (wi (wa (wn (wbr (cv s1) W c_le)) (wceq (co (cv s1) (co (cv x3) W c_an) c_or) (cv x3))) (wceq (cv z) (co (cif (wbr (cv s1) (co P Q c_or) c_le) (crio y1 (wral t (wi (wa (wn (wbr (cv t) W c_le)) (wn (wbr (cv t) (co P Q c_or) c_le))) (wceq (cv y1) E)) A2) B2) (csb t (cv s1) D)) (co (cv x3) W c_an) c_or))) A2) B2) (cv x3))) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wcel F T) $;

--| Part of proof of Lemma E in [Crawley] p. 113. TODO: fix comment. (Contributed by NM, 14-Apr-2013.) (New usage is discouraged.)
theorem cdleme51finvtrN {x3 y1 z t s1: setvar} (A2 B2: class) (D: class t) (P Q: class) (T: class x3 y1 z t s1) (U: class) (E: class t s1) (F: class x3 y1 z t s1) (H c_or K c_le c_an W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq U (co (co P Q c_or) W c_an) $ >
  $ wceq D (co (co (cv t) U c_or) (co Q (co (co P (cv t) c_or) W c_an) c_or) c_an) $ >
  $ wceq E (co (co P Q c_or) (co D (co (co (cv s1) (cv t) c_or) W c_an) c_or) c_an) $ >
  $ wceq F (cmpt x3 B2 (cif (wa (wne P Q) (wn (wbr (cv x3) W c_le))) (crio z (wral s1 (wi (wa (wn (wbr (cv s1) W c_le)) (wceq (co (cv s1) (co (cv x3) W c_an) c_or) (cv x3))) (wceq (cv z) (co (cif (wbr (cv s1) (co P Q c_or) c_le) (crio y1 (wral t (wi (wa (wn (wbr (cv t) W c_le)) (wn (wbr (cv t) (co P Q c_or) c_le))) (wceq (cv y1) E)) A2) B2) (csb t (cv s1) D)) (co (cv x3) W c_an) c_or))) A2) B2) (cv x3))) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wcel (ccnv F) T) $;

--| Part of Lemma E in [Crawley] p. 113. TODO: fix comment. (Contributed by NM, 11-Apr-2013.)
theorem cdleme50ex {f2: setvar} (A2 P Q T: class) (H: class f2) (K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wrex f2 (wceq (cfv P (cv f2)) Q) T) $;

--| Lemma E in [Crawley] p. 113. If p,q are atoms not under hyperplane w, then there is a unique translation f such that f(p) = q. (Contributed by NM, 11-Apr-2013.)
theorem cdleme {f2: setvar} (A2 P Q T H K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wreu f2 (wceq (cfv P (cv f2)) Q) T) $;

--| Part of Lemma F in [Crawley] p. 116. TODO: should this or part of it become a stand-alone theorem? (Contributed by NM, 12-Apr-2013.)
theorem cdlemf1 {q: setvar} (A2 P U H: class) (c_or: class q) (K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel U A2) (wbr U W c_le)) (wa (wcel P A2) (wn (wbr P W c_le)))) (wrex q (w3a (wne P (cv q)) (wn (wbr (cv q) W c_le)) (wbr U (co P (cv q) c_or) c_le)) A2) $;

--| Part of Lemma F in [Crawley] p. 116. (Contributed by NM, 12-Apr-2013.)
theorem cdlemf2 {q p: setvar} (A2 U H: class) (c_or: class q p) (K c_le: class) (c_an: class q p) (W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel U A2) (wbr U W c_le))) (wrex p (wrex q (wa (wa (wn (wbr (cv p) W c_le)) (wn (wbr (cv q) W c_le))) (wceq U (co (co (cv p) (cv q) c_or) W c_an))) A2) A2) $;

--| Lemma F in [Crawley] p. 116. If u is an atom under w, there exists a translation whose trace is u. (Contributed by NM, 12-Apr-2013.)
theorem cdlemf {f2: setvar} (A2: class) (R: class f2) (T U H K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel U A2) (wbr U W c_le))) (wrex f2 (wceq (cfv (cv f2) R) U) T) $;

--| ~ cdlemf with additional constraint of non-identity. (Contributed by NM, 20-Jun-2013.)
theorem cdlemfnid {f2: setvar} (A2: class) (B2 R: class f2) (T U H K c_le W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel U A2) (wbr U W c_le))) (wrex f2 (wa (wceq (cfv (cv f2) R) U) (wne (cv f2) (cres cid B2))) T) $;

--| Special case of ~ cdlemf showing existence of non-identity translation with trace different from any 3 given lattice elements. (Contributed by NM, 24-Jul-2013.)
theorem cdlemftr3 {f2: setvar} (B2: class f2) (R T H K W X Y Z: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wrex f2 (wa (wne (cv f2) (cres cid B2)) (w3a (wne (cfv (cv f2) R) X) (wne (cfv (cv f2) R) Y) (wne (cfv (cv f2) R) Z))) T) $;

--| Special case of ~ cdlemf showing existence of non-identity translation with trace different from any 2 given lattice elements. (Contributed by NM, 25-Jul-2013.)
theorem cdlemftr2 {f2: setvar} (B2: class f2) (R T H K W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wrex f2 (w3a (wne (cv f2) (cres cid B2)) (wne (cfv (cv f2) R) X) (wne (cfv (cv f2) R) Y)) T) $;

--| Part of proof of Lemma G of [Crawley] p. 116, sixth line of third paragraph on p. 117: there is "a translation h, different from the identity, such that tr h ` =/= ` tr f." (Contributed by NM, 25-Jul-2013.)
theorem cdlemftr1 {f2: setvar} (B2: class f2) (R T H K W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wrex f2 (wa (wne (cv f2) (cres cid B2)) (wne (cfv (cv f2) R) X)) T) $;

--| Special case of ~ cdlemf showing existence of a non-identity translation. (Contributed by NM, 1-Aug-2013.)
theorem cdlemftr0 {f2: setvar} (B2: class f2) (T H K W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wrex f2 (wne (cv f2) (cres cid B2)) T) $;

--| The ordering of two Hilbert lattice elements (under the fiducial hyperplane ` W ` ) is determined by the translations whose traces are under them. (Contributed by NM, 3-Mar-2014.)
theorem trlord {f2: setvar} (A2: class f2) (B2 R T H K c_le W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wbr X W c_le)) (wa (wcel Y B2) (wbr Y W c_le))) (wb (wbr X Y c_le) (wral f2 (wi (wbr (cfv (cv f2) R) X c_le) (wbr (cfv (cv f2) R) Y c_le)) T)) $;

--| Shorter expression for ` G ` . TODO: fix comment. TODO: shorten using ~ cdleme or vice-versa? Also, if not shortened with ~ cdleme , then it can be moved up to save repeating hypotheses. (Contributed by NM, 15-Apr-2013.)
theorem cdlemg1a {x3 y1 z t f2 s1: setvar} (A2 B2: class) (D: class t) (P Q: class) (T: class x3 y1 z t s1) (U: class f2) (E: class t s1) (G: class x3 y1 z t s1) (H c_or K c_le c_an W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq U (co (co P Q c_or) W c_an) $ >
  $ wceq D (co (co (cv t) U c_or) (co Q (co (co P (cv t) c_or) W c_an) c_or) c_an) $ >
  $ wceq E (co (co P Q c_or) (co D (co (co (cv s1) (cv t) c_or) W c_an) c_or) c_an) $ >
  $ wceq G (cmpt x3 B2 (cif (wa (wne P Q) (wn (wbr (cv x3) W c_le))) (crio z (wral s1 (wi (wa (wn (wbr (cv s1) W c_le)) (wceq (co (cv s1) (co (cv x3) W c_an) c_or) (cv x3))) (wceq (cv z) (co (cif (wbr (cv s1) (co P Q c_or) c_le) (crio y1 (wral t (wi (wa (wn (wbr (cv t) W c_le)) (wn (wbr (cv t) (co P Q c_or) c_le))) (wceq (cv y1) E)) A2) B2) (csb t (cv s1) D)) (co (cv x3) W c_an) c_or))) A2) B2) (cv x3))) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wceq G (crio f2 (wceq (cfv P (cv f2)) Q) T)) $;

--| This theorem can be used to shorten ` G = ` hypothesis. TODO: Fix comment. (Contributed by NM, 18-Apr-2013.)
theorem cdlemg1b2 {x3 y1 z t f2 s1: setvar} (A2 B2: class) (D: class t) (P Q: class) (T: class x3 y1 z t s1) (U: class f2) (E: class t s1) (F: class x3 y1 z t f2 s1) (G: class x3 y1 z t s1) (H c_or K c_le c_an W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq U (co (co P Q c_or) W c_an) $ >
  $ wceq D (co (co (cv t) U c_or) (co Q (co (co P (cv t) c_or) W c_an) c_or) c_an) $ >
  $ wceq E (co (co P Q c_or) (co D (co (co (cv s1) (cv t) c_or) W c_an) c_or) c_an) $ >
  $ wceq G (cmpt x3 B2 (cif (wa (wne P Q) (wn (wbr (cv x3) W c_le))) (crio z (wral s1 (wi (wa (wn (wbr (cv s1) W c_le)) (wceq (co (cv s1) (co (cv x3) W c_an) c_or) (cv x3))) (wceq (cv z) (co (cif (wbr (cv s1) (co P Q c_or) c_le) (crio y1 (wral t (wi (wa (wn (wbr (cv t) W c_le)) (wn (wbr (cv t) (co P Q c_or) c_le))) (wceq (cv y1) E)) A2) B2) (csb t (cv s1) D)) (co (cv x3) W c_an) c_or))) A2) B2) (cv x3))) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >

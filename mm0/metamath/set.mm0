  $ wi (wa (w3a (wcel K chlt) (wa (wcel (cv p) A2) (wcel (cv s1) A2)) (wcel (cv z) A2)) (wa (wne (cv s1) (cv z)) (wbr (cv s1) (co (cv p) (cv z) c_or) c_le))) (wbr (cv p) (co (cv s1) (cv z) c_or) c_le) $;

--| Lemma for ~ paddass . Combine ~ paddasslem5 and ~ paddasslem6 . (Contributed by NM, 9-Jan-2012.)
theorem paddasslem7 (x3 y1 z: setvar) (A2 c_or K c_le: class) (s1 r p: setvar):
  $ wceq c_le (cfv K cple) $ >

--| Lemma for ~ dath . Axis of perspectivity points ` D ` and ` E ` are different. (Contributed by NM, 10-Aug-2012.)
theorem dalemdnee (ph: wff) (A2 C D P Q R S T U E c_or K c_le c_an O Y Z: class):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wceq Z (co (co S T c_or) U c_or) $ >
  $ wceq D (co (co P Q c_or) (co S T c_or) c_an) $ >
  $ wceq E (co (co Q R c_or) (co T U c_or) c_an) $ >
  $ wi ph (wne D E) $;

--| Lemma for ~ dath . Atom ` U ` (in plane ` Z = S T U ` ) belongs to the 3-dimensional volume formed by ` Y ` and ` C ` . (Contributed by NM, 21-Jul-2012.)
theorem dalem5 (ph: wff) (A2 C P Q R S T U c_or K c_le O W Y Z: class):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wceq W (co Y C c_or) $ >
  $ wi ph (wbr U W c_le) $;

--| Lemma for ~ dath . Analogue of ~ dalem5 for ` S ` . (Contributed by NM, 21-Jul-2012.)
theorem dalem6 (ph: wff) (A2 C P Q R S T U c_or K c_le O W Y Z: class):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wceq Z (co (co S T c_or) U c_or) $ >
  $ wceq W (co Y C c_or) $ >
  $ wi ph (wbr S W c_le) $;

--| Lemma for ~ dath . Analogue of ~ dalem5 for ` T ` . (Contributed by NM, 21-Jul-2012.)
theorem dalem7 (ph: wff) (A2 C P Q R S T U c_or K c_le O W Y Z: class):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >

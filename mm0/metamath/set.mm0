  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq G (crio h (wceq (cfv P (cv h)) (cv q)) T) $ >
  $ wceq c_0 (cmpt h T (cres cid B2)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wn (wbr X W c_le))) (wa (wcel Y B2) (wbr Y W c_le))) (wceq (cfv (co X Y c_an) I) (cin (cfv X I) (cfv Y I))) $;


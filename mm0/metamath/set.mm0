  $ wi ph (wral a (wceq (co (cv a) N cgcd) c1) (co c1 A2 cfz)) $ >
  $ wi ph (wral a (wbr N (co (cfv K cv1) (cfv (cfv (cv a) (cfv K czrh)) (cfv (cfv K cpl1) cascl)) (cfv (cfv K cpl1) cplusg)) c_sm) (co c1 A2 cfz)) $ >
  $ wi ph (wceq N (co P (co P N cpc) cexp)) $;

--| Ring homomorphism out of a quotient given an ideal spanned by a singleton. (Contributed by metakunt, 7-Jun-2025.)
theorem rhmqusspan {g2 q: setvar} (ph: wff) (Q F G H J K N: class g2) (X c_0: class g2 q):
  $ wceq c_0 (cfv H c0g) $ >
  $ wi ph (wcel F (co G H crh)) $ >
  $ wceq K (cima (ccnv F) (csn c_0)) $ >
  $ wceq Q (co G (co G N cqg) cqus) $ >
  $ wceq J (cmpt q (cfv Q cbs) (cuni (cima F (cv q)))) $ >
  $ wi ph (wcel G ccrg) $ >
  $ wceq N (cfv (csn X) (cfv G crsp)) $ >
  $ wi ph (wcel X (cfv G cbs)) $ >
  $ wi ph (wceq (cfv X F) c_0) $ >
  $ wi ph (wa (wcel J (co Q H crh)) (wral g2 (wceq (cfv (cec (cv g2) (co G N cqg)) J) (cfv (cv g2) F)) (cfv G cbs))) $;

--| Section 5 of ~ https://www3.nd.edu/%7eandyp/notes/AKS.pdf. Construction of a ring homomorphism out of Zn X to K. (Contributed by metakunt, 7-Jun-2025.)
theorem aks5lem1 {r q p: setvar} (ph: wff q) (P F: class r q p) (G: class r q) (H: class r q p) (K: class) (M: class q p) (N: class r):
  $ wi ph (wcel K cfield) $ >
  $ wceq P (cfv K cchr) $ >
  $ wi ph (w3a (wcel P cprime) (wcel N cn) (wbr P N cdvds)) $ >
  $ wceq F (cmpt p (cfv (cfv (cfv N czn) cpl1) cbs) (ccom G (cv p))) $ >
  $ wceq G (cmpt q (cfv (cfv N czn) cbs) (cuni (cima (cfv K czrh) (cv q)))) $ >
  $ wceq H (cmpt r (cfv (cfv K cpl1) cbs) (cfv M (cfv (cv r) (cfv K ce1)))) $ >
  $ wi ph (wcel M (cfv K cbs)) $ >
  $ wi ph (wcel (ccom H F) (co (cfv (cfv N czn) cpl1) K crh)) $;

--| Lemma for section 5 ~ https://www3.nd.edu/%7eandyp/notes/AKS.pdf. Construct the quotient for the AKS reduction. (Contributed by metakunt, 7-Jun-2025.)
theorem aks5lem2 {g2 s1 r q p: setvar} (ph: wff q) (A2: class g2 r q p) (P: class g2 s1 r q p) (R: class g2 s1 q) (F: class g2 r q p) (G: class g2 s1 r q) (H I: class g2 r q p) (K: class g2) (L: class g2 r q p) (M: class g2 s1 q p) (N: class g2 r):
  $ wi ph (wcel K cfield) $ >
  $ wceq P (cfv K cchr) $ >
  $ wi ph (w3a (wcel P cprime) (wcel N cn) (wbr P N cdvds)) $ >
  $ wceq F (cmpt p (cfv (cfv (cfv N czn) cpl1) cbs) (ccom G (cv p))) $ >
  $ wceq G (cmpt q (cfv (cfv N czn) cbs) (cuni (cima (cfv K czrh) (cv q)))) $ >
  $ wceq H (cmpt r (cfv (cfv K cpl1) cbs) (cfv M (cfv (cv r) (cfv K ce1)))) $ >
  $ wi ph (wcel M (co (cfv K cmgp) R cprimroots)) $ >
  $ wceq I (cmpt s1 (cfv A2 cbs) (cuni (cima (ccom H F) (cv s1)))) $ >
  $ wceq A2 (co (cfv (cfv N czn) cpl1) (co (cfv (cfv N czn) cpl1) L cqg) cqus) $ >
  $ wceq L (cfv (csn (co (co R (cfv (cfv N czn) cv1) (cfv (cfv (cfv (cfv N czn) cpl1) cmgp) cmg)) (cfv (cfv (cfv N czn) cpl1) cur) (cfv (cfv (cfv N czn) cpl1) csg))) (cfv (cfv (cfv N czn) cpl1) crsp)) $ >
  $ wi ph (wcel R cn) $ >
  $ wi ph (wa (wcel I (co A2 K crh)) (wral g2 (wceq (cfv (cec (cv g2) (co (cfv (cfv N czn) cpl1) L cqg)) I) (cfv (cv g2) (ccom H F))) (cfv (cfv (cfv N czn) cpl1) cbs))) $;

--| Transfer results from algebraic scalars and ZR ring homomorphisms. (Contributed by metakunt, 17-Jun-2025.)
theorem ply1asclzrhval (ph: wff) (A2 B2 C R W X: class):
  $ wceq W (cfv R cpl1) $ >
  $ wceq A2 (cfv W cascl) $ >
  $ wceq B2 (cfv W czrh) $ >
  $ wceq C (cfv R czrh) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel X cz) $ >
  $ wi ph (wceq (cfv (cfv X C) A2) (cfv X B2)) $;

--| Lemma for AKS section 5. (Contributed by metakunt, 17-Jun-2025.)
theorem aks5lem3a {y1 e f2 s1 r q p: setvar} (ph: wff y1 e f2 q) (A2: class y1 e f2 q p) (B2: class y1 e f2 r q p) (P c_sm: class y1 e f2 s1 r q p) (R: class y1 e f2 s1 q) (S: class y1 e f2 s1 r q p) (F: class y1 e f2 q p) (G: class y1 e f2 s1 r q) (H I: class y1 e f2 r q p) (K: class y1 e f2) (L: class y1 e f2 r q p) (M: class y1 e f2 s1 q p) (N: class y1 e f2):
  $ wi ph (wcel K cfield) $ >
  $ wceq P (cfv K cchr) $ >
  $ wi ph (w3a (wcel P cprime) (wcel N cn) (wbr P N cdvds)) $ >
  $ wceq B2 (co S (co S L cqg) cqus) $ >
  $ wceq L (cfv (csn (co (co R (cfv (cfv N czn) cv1) (cfv (cfv S cmgp) cmg)) (cfv S cur) (cfv S csg))) (cfv S crsp)) $ >
  $ wi ph (wcel R cn) $ >
  $ wceq c_sm (copab e f2 (w3a (wcel (cv e) cn) (wcel (cv f2) (cfv (cfv K cpl1) cbs)) (wral y1 (wceq (co (cv e) (cfv (cv y1) (cfv (cv f2) (cfv K ce1))) (cfv (cfv K cmgp) cmg)) (cfv (co (cv e) (cv y1) (cfv (cfv K cmgp) cmg)) (cfv (cv f2) (cfv K ce1)))) (co (cfv K cmgp) R cprimroots)))) $ >
  $ wceq S (cfv (cfv N czn) cpl1) $ >
  $ wceq F (cmpt p (cfv (cfv (cfv N czn) cpl1) cbs) (ccom G (cv p))) $ >
  $ wceq G (cmpt q (cfv (cfv N czn) cbs) (cuni (cima (cfv K czrh) (cv q)))) $ >
  $ wceq H (cmpt r (cfv (cfv K cpl1) cbs) (cfv M (cfv (cv r) (cfv K ce1)))) $ >
  $ wi ph (wcel M (co (cfv K cmgp) R cprimroots)) $ >
  $ wceq I (cmpt s1 (cfv B2 cbs) (cuni (cima (ccom H F) (cv s1)))) $ >
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wceq (cec (co N (co (cfv (cfv N czn) cv1) (cfv (cfv A2 (cfv (cfv N czn) czrh)) (cfv S cascl)) (cfv S cplusg)) (cfv (cfv S cmgp) cmg)) (co S L cqg)) (cec (co (co N (cfv (cfv N czn) cv1) (cfv (cfv S cmgp) cmg)) (cfv (cfv A2 (cfv (cfv N czn) czrh)) (cfv S cascl)) (cfv S cplusg)) (co S L cqg))) $ >
  $ wi ph (wceq (co N (cfv M (cfv (co (cfv K cv1) (cfv (cfv A2 (cfv K czrh)) (cfv (cfv K cpl1) cascl)) (cfv (cfv K cpl1) cplusg)) (cfv K ce1))) (cfv (cfv K cmgp) cmg)) (cfv (co N M (cfv (cfv K cmgp) cmg)) (cfv (co (cfv K cv1) (cfv (cfv A2 (cfv K czrh)) (cfv (cfv K cpl1) cascl)) (cfv (cfv K cpl1) cplusg)) (cfv K ce1)))) $;

--| Lemma for AKS section 5, reduce hypotheses. (Contributed by metakunt, 17-Jun-2025.)
theorem aks5lem4a {y1 e f2: setvar} (ph: wff y1 e f2) (A2: class y1 e f2) (B2: class y1 f2) (P c_sm R S: class y1 e f2) (K: class y1 f2) (L: class y1 e f2) (M N: class y1 f2):
  $ wi ph (wcel K cfield) $ >
  $ wceq P (cfv K cchr) $ >
  $ wi ph (w3a (wcel P cprime) (wcel N cn) (wbr P N cdvds)) $ >
  $ wceq B2 (co S (co S L cqg) cqus) $ >
  $ wceq L (cfv (csn (co (co R (cfv (cfv N czn) cv1) (cfv (cfv S cmgp) cmg)) (cfv S cur) (cfv S csg))) (cfv S crsp)) $ >
  $ wi ph (wcel R cn) $ >
  $ wceq c_sm (copab e f2 (w3a (wcel (cv e) cn) (wcel (cv f2) (cfv (cfv K cpl1) cbs)) (wral y1 (wceq (co (cv e) (cfv (cv y1) (cfv (cv f2) (cfv K ce1))) (cfv (cfv K cmgp) cmg)) (cfv (co (cv e) (cv y1) (cfv (cfv K cmgp) cmg)) (cfv (cv f2) (cfv K ce1)))) (co (cfv K cmgp) R cprimroots)))) $ >
  $ wceq S (cfv (cfv N czn) cpl1) $ >
  $ wi ph (wcel M (co (cfv K cmgp) R cprimroots)) $ >
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wceq (cec (co N (co (cfv (cfv N czn) cv1) (cfv (cfv A2 (cfv (cfv N czn) czrh)) (cfv S cascl)) (cfv S cplusg)) (cfv (cfv S cmgp) cmg)) (co S L cqg)) (cec (co (co N (cfv (cfv N czn) cv1) (cfv (cfv S cmgp) cmg)) (cfv (cfv A2 (cfv (cfv N czn) czrh)) (cfv S cascl)) (cfv S cplusg)) (co S L cqg))) $ >
  $ wi ph (wceq (co N (cfv M (cfv (co (cfv K cv1) (cfv (cfv A2 (cfv K czrh)) (cfv (cfv K cpl1) cascl)) (cfv (cfv K cpl1) cplusg)) (cfv K ce1))) (cfv (cfv K cmgp) cmg)) (cfv (co N M (cfv (cfv K cmgp) cmg)) (cfv (co (cfv K cv1) (cfv (cfv A2 (cfv K czrh)) (cfv (cfv K cpl1) cascl)) (cfv (cfv K cpl1) cplusg)) (cfv K ce1)))) $;

--| Lemma for AKS, section 5, connect to Theorem 6.1. (Contributed by metakunt, 17-Jun-2025.)
theorem aks5lem5a {y1 e f2 a: setvar} (ph: wff e f2) (A2: class e f2 a) (B2: class y1 f2 a) (P c_sm: class y1 e f2 a) (R: class y1 a) (S: class e f2 a) (K: class a) (L: class e f2 a) (N: class a):
  $ wi ph (wcel K cfield) $ >
  $ wceq P (cfv K cchr) $ >
  $ wi ph (w3a (wcel P cprime) (wcel N cn) (wbr P N cdvds)) $ >
  $ wceq B2 (co S (co S L cqg) cqus) $ >
  $ wceq L (cfv (csn (co (co R (cfv (cfv N czn) cv1) (cfv (cfv S cmgp) cmg)) (cfv S cur) (cfv S csg))) (cfv S crsp)) $ >
  $ wi ph (wcel R cn) $ >
  $ wceq c_sm (copab e f2 (w3a (wcel (cv e) cn) (wcel (cv f2) (cfv (cfv K cpl1) cbs)) (wral y1 (wceq (co (cv e) (cfv (cv y1) (cfv (cv f2) (cfv K ce1))) (cfv (cfv K cmgp) cmg)) (cfv (co (cv e) (cv y1) (cfv (cfv K cmgp) cmg)) (cfv (cv f2) (cfv K ce1)))) (co (cfv K cmgp) R cprimroots)))) $ >
  $ wceq S (cfv (cfv N czn) cpl1) $ >
  $ wi ph (wral a (wceq (cec (co N (co (cfv (cfv N czn) cv1) (cfv (cv a) (cfv S czrh)) (cfv S cplusg)) (cfv (cfv S cmgp) cmg)) (co S L cqg)) (cec (co (co N (cfv (cfv N czn) cv1) (cfv (cfv S cmgp) cmg)) (cfv (cv a) (cfv S czrh)) (cfv S cplusg)) (co S L cqg))) (co c1 A2 cfz)) $ >
  $ wi ph (wral a (wbr N (co (cfv K cv1) (cfv (cfv (cv a) (cfv K czrh)) (cfv (cfv K cpl1) cascl)) (cfv (cfv K cpl1) cplusg)) c_sm) (co c1 A2 cfz)) $;

--| Connect results of section 5 and Theorem 6.1 AKS. (Contributed by metakunt, 25-Jun-2025.)
theorem aks5lem6 {x3 y1 e f2 a b: setvar} (ph: wff e f2) (A2 P: class) (c_sm: class x3 y1 e f2 b) (R: class b) (S: class x3 f2 a b) (K: class) (L: class x3 f2 a b) (M: class e f2) (N: class) (X: class x3 y1 e f2 a b):
  $ wceq c_sm (copab e f2 (w3a (wcel (cv e) cn) (wcel (cv f2) (cfv (cfv K cpl1) cbs)) (wral y1 (wceq (co (cv e) (cfv (cv y1) (cfv (cv f2) (cfv K ce1))) (cfv (cfv K cmgp) cmg)) (cfv (co (cv e) (cv y1) (cfv (cfv K cmgp) cmg)) (cfv (cv f2) (cfv K ce1)))) (co (cfv K cmgp) R cprimroots)))) $ >
  $ wceq P (cfv K cchr) $ >
  $ wi ph (wcel K cfield) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel R cn) $ >
  $ wi ph (wcel N (cfv c3 cuz)) $ >
  $ wi ph (wbr P N cdvds) $ >
  $ wi ph (wceq (co N R cgcd) c1) $ >
  $ wceq A2 (cfv (co (cfv (cfv R cphi) csqrt) (co c2 N clogb) cmul) cfl) $ >
  $ wi ph (wbr (co (co c2 N clogb) c2 cexp) (cfv N (cfv R codz)) clt) $ >
  $ wi ph (wcel (cmpt x3 (cfv K cbs) (co P (cv x3) (cfv (cfv K cmgp) cmg))) (co K K crs)) $ >
  $ wi ph (wcel M (co (cfv K cmgp) R cprimroots)) $ >
  $ wi ph (wral b (wceq (co (cv b) N cgcd) c1) (co c1 A2 cfz)) $ >
  $ wceq S (cfv (cfv N czn) cpl1) $ >
  $ wceq L (cfv (csn (co (co R (cfv (cfv N czn) cv1) (cfv (cfv S cmgp) cmg)) (cfv S cur) (cfv S csg))) (cfv S crsp)) $ >
  $ wceq X (cfv (cfv N czn) cv1) $ >
  $ wi ph (wral a (wceq (cec (co N (co X (cfv (cv a) (cfv S czrh)) (cfv S cplusg)) (cfv (cfv S cmgp) cmg)) (co S L cqg)) (cec (co (co N X (cfv (cfv S cmgp) cmg)) (cfv (cv a) (cfv S czrh)) (cfv S cplusg)) (co S L cqg))) (co c1 A2 cfz)) $ >
  $ wi ph (wceq N (co P (co P N cpc) cexp)) $;

--| Connect results of section 5 and Theorem 6.1 AKS. (Contributed by metakunt, 25-Jun-2025.)
theorem aks5lem6_b {x3 y1 e f2 a: setvar} (ph: wff e f2) (A2 P: class) (c_sm: class x3 y1 e f2) (R: class) (S: class x3 f2 a) (K: class) (L: class x3 f2 a) (M: class e f2) (N: class) (X: class x3 y1 e f2 a):
  $ wceq c_sm (copab e f2 (w3a (wcel (cv e) cn) (wcel (cv f2) (cfv (cfv K cpl1) cbs)) (wral y1 (wceq (co (cv e) (cfv (cv y1) (cfv (cv f2) (cfv K ce1))) (cfv (cfv K cmgp) cmg)) (cfv (co (cv e) (cv y1) (cfv (cfv K cmgp) cmg)) (cfv (cv f2) (cfv K ce1)))) (co (cfv K cmgp) R cprimroots)))) $ >
  $ wceq P (cfv K cchr) $ >
  $ wi ph (wcel K cfield) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel R cn) $ >
  $ wi ph (wcel N (cfv c3 cuz)) $ >
  $ wi ph (wbr P N cdvds) $ >
  $ wi ph (wceq (co N R cgcd) c1) $ >
  $ wceq A2 (cfv (co (cfv (cfv R cphi) csqrt) (co c2 N clogb) cmul) cfl) $ >
  $ wi ph (wbr (co (co c2 N clogb) c2 cexp) (cfv N (cfv R codz)) clt) $ >
  $ wi ph (wcel (cmpt x3 (cfv K cbs) (co P (cv x3) (cfv (cfv K cmgp) cmg))) (co K K crs)) $ >
  $ wi ph (wcel M (co (cfv K cmgp) R cprimroots)) $ >
  $ wi ph (wral a (wceq (co (cv a) N cgcd) c1) (co c1 A2 cfz)) $ >
  $ wceq S (cfv (cfv N czn) cpl1) $ >
  $ wceq L (cfv (csn (co (co R (cfv (cfv N czn) cv1) (cfv (cfv S cmgp) cmg)) (cfv S cur) (cfv S csg))) (cfv S crsp)) $ >
  $ wceq X (cfv (cfv N czn) cv1) $ >
  $ wi ph (wral a (wceq (cec (co N (co X (cfv (cv a) (cfv S czrh)) (cfv S cplusg)) (cfv (cfv S cmgp) cmg)) (co S L cqg)) (cec (co (co N X (cfv (cfv S cmgp) cmg)) (cfv (cv a) (cfv S czrh)) (cfv S cplusg)) (co S L cqg))) (co c1 A2 cfz)) $ >
  $ wi ph (wceq N (co P (co P N cpc) cexp)) $;

--| Strong induction, deduction version. (Contributed by Steven Nguyen, 13-Jul-2025.)
theorem indstrd {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch th: wff y1) (A2: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ps ch) $ >
  $ wi (wceq (cv x3) A2) (wb ps th) $ >
  $ wi (w3a ph (wcel (cv x3) cn) (wral y1 (wi (wbr (cv y1) (cv x3) clt) ch) cn)) ps $ >
  $ wi ph (wcel A2 cn) $ >
  $ wi ph th $;

--| Relate sums of elements of orders and roots of unity. (Contributed by metakunt, 14-Jul-2025.)
theorem grpods {x3 k m: setvar} (ph: wff x3 m) (B2: class m) (c_ex: class k m) (G N: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wi ph (wcel G cgrp) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wceq (csu k (crab m (wbr (cv m) N cdvds) (co c1 N cfz)) (cfv (crab x3 (wceq (cfv (cv x3) (cfv G cod)) (cv k)) B2) chash)) (cfv (crab x3 (wceq (co N (cv x3) c_ex) (cfv G c0g)) B2) chash)) $;

--| Lemma for unitscyg . (Contributed by metakunt, 13-Jul-2025.)
theorem unitscyglem1 {x3 n: setvar} (ph: wff x3 n) (A2 B2 c_ex G: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wi ph (wcel G cgrp) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wral n (wbr (cfv (crab x3 (wceq (co (cv n) (cv x3) c_ex) (cfv G c0g)) B2) chash) (cv n) cle) cn) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wceq (cfv (crab x3 (wceq (co (cfv A2 (cfv G cod)) (cv x3) c_ex) (cfv G c0g)) B2) chash) (cfv A2 (cfv G cod))) $;

--| Lemma for unitscyg . (Contributed by metakunt, 13-Jul-2025.)
theorem unitscyglem2 {x3 n c: setvar} (ph: wff n c) (A2: class c) (B2: class) (D: class n) (c_ex: class c) (G: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wi ph (wcel G cgrp) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wral n (wbr (cfv (crab x3 (wceq (co (cv n) (cv x3) c_ex) (cfv G c0g)) B2) chash) (cv n) cle) cn) $ >
  $ wi ph (wcel D cn) $ >
  $ wi ph (wbr D (cfv B2 chash) cdvds) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wceq (cfv A2 (cfv G cod)) D) $ >
  $ wi ph (wral c (wi (wbr (cv c) D clt) (wi (wa (wbr (cv c) (cfv B2 chash) cdvds) (wne (crab x3 (wceq (cfv (cv x3) (cfv G cod)) (cv c)) B2) c0)) (wceq (cfv (crab x3 (wceq (cfv (cv x3) (cfv G cod)) (cv c)) B2) chash) (cfv (cv c) cphi)))) cn) $ >
  $ wi ph (wceq (cfv (crab x3 (wceq (cfv (cv x3) (cfv G cod)) D) B2) chash) (cfv D cphi)) $;

--| Lemma for unitscyg . (Contributed by metakunt, 14-Jul-2025.)
theorem unitscyglem3 {x3 n d: setvar} (ph: wff x3) (B2: class) (c_ex: class d) (G: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wi ph (wcel G cgrp) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wral n (wbr (cfv (crab x3 (wceq (co (cv n) (cv x3) c_ex) (cfv G c0g)) B2) chash) (cv n) cle) cn) $ >
  $ wi ph (wral d (wi (wa (wbr (cv d) (cfv B2 chash) cdvds) (wne (crab x3 (wceq (cfv (cv x3) (cfv G cod)) (cv d)) B2) c0)) (wceq (cfv (crab x3 (wceq (cfv (cv x3) (cfv G cod)) (cv d)) B2) chash) (cfv (cv d) cphi))) cn) $;

--| Lemma for unitscyg . (Contributed by metakunt, 14-Jul-2025.)
theorem unitscyglem4 {x3 y1 n: setvar} (ph: wff y1) (B2: class) (D: class n) (c_ex: class y1) (G: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wi ph (wcel G cgrp) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wral n (wbr (cfv (crab x3 (wceq (co (cv n) (cv x3) c_ex) (cfv G c0g)) B2) chash) (cv n) cle) cn) $ >
  $ wi ph (wcel D cn) $ >
  $ wi ph (wbr D (cfv B2 chash) cdvds) $ >
  $ wi ph (wceq (cfv (crab y1 (wceq (cfv (cv y1) (cfv G cod)) D) B2) chash) (cfv D cphi)) $;

--| Lemma for unitscyg . (Contributed by metakunt, 9-Aug-2025.)
theorem unitscyglem5 (ph: wff) (D R G: class):
  $ wceq G (co (cfv R cmgp) (cfv R cui) cress) $ >
  $ wi ph (wcel R cidom) $ >
  $ wi ph (wcel (cfv R cbs) cfn) $ >
  $ wi ph (wcel D cn) $ >
  $ wi ph (wbr D (cfv (cfv G cbs) chash) cdvds) $ >
  $ wi ph (wne (co (cfv R cmgp) D cprimroots) c0) $;

--| Lemma for aks5. We clean up the hypotheses compared to ~ aks5lem6 . (Contributed by metakunt, 9-Aug-2025.)
theorem aks5lem7 {a b: setvar} (ph: wff) (A2 P R: class) (S: class a b) (K: class) (L: class a b) (N: class) (X: class a b):
  $ wi ph (wcel (cfv (cfv K cbs) chash) cn) $ >
  $ wceq P (cfv K cchr) $ >
  $ wi ph (wcel K cfield) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel R cn) $ >
  $ wi ph (wcel N (cfv c3 cuz)) $ >
  $ wi ph (wbr P N cdvds) $ >
  $ wi ph (wceq (co N R cgcd) c1) $ >
  $ wceq A2 (cfv (co (cfv (cfv R cphi) csqrt) (co c2 N clogb) cmul) cfl) $ >
  $ wi ph (wbr (co (co c2 N clogb) c2 cexp) (cfv N (cfv R codz)) clt) $ >
  $ wi ph (wbr R (co (cfv (cfv K cbs) chash) c1 cmin) cdvds) $ >
  $ wi ph (wral a (wceq (cec (co N (co X (cfv (cv a) (cfv S czrh)) (cfv S cplusg)) (cfv (cfv S cmgp) cmg)) (co S L cqg)) (cec (co (co N X (cfv (cfv S cmgp) cmg)) (cfv (cv a) (cfv S czrh)) (cfv S cplusg)) (co S L cqg))) (co c1 A2 cfz)) $ >
  $ wi ph (wral b (wceq (co (cv b) N cgcd) c1) (co c1 A2 cfz)) $ >
  $ wceq S (cfv (cfv N czn) cpl1) $ >
  $ wceq L (cfv (csn (co (co R X (cfv (cfv S cmgp) cmg)) (cfv S cur) (cfv S csg))) (cfv S crsp)) $ >
  $ wceq X (cfv (cfv N czn) cv1) $ >
  $ wi ph (wceq N (co P (co P N cpc) cexp)) $;

--| Lemma for aks5. We clean up the hypotheses compared to ~ aks5lem6 . (Contributed by metakunt, 9-Aug-2025.)
theorem aks5lem7_b {a: setvar} (ph: wff) (A2 P R: class) (S: class a) (K: class) (L: class a) (N: class) (X: class a):
  $ wi ph (wcel (cfv (cfv K cbs) chash) cn) $ >
  $ wceq P (cfv K cchr) $ >
  $ wi ph (wcel K cfield) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel R cn) $ >
  $ wi ph (wcel N (cfv c3 cuz)) $ >
  $ wi ph (wbr P N cdvds) $ >
  $ wi ph (wceq (co N R cgcd) c1) $ >
  $ wceq A2 (cfv (co (cfv (cfv R cphi) csqrt) (co c2 N clogb) cmul) cfl) $ >
  $ wi ph (wbr (co (co c2 N clogb) c2 cexp) (cfv N (cfv R codz)) clt) $ >
  $ wi ph (wbr R (co (cfv (cfv K cbs) chash) c1 cmin) cdvds) $ >
  $ wi ph (wral a (wceq (cec (co N (co X (cfv (cv a) (cfv S czrh)) (cfv S cplusg)) (cfv (cfv S cmgp) cmg)) (co S L cqg)) (cec (co (co N X (cfv (cfv S cmgp) cmg)) (cfv (cv a) (cfv S czrh)) (cfv S cplusg)) (co S L cqg))) (co c1 A2 cfz)) $ >
  $ wi ph (wral a (wceq (co (cv a) N cgcd) c1) (co c1 A2 cfz)) $ >
  $ wceq S (cfv (cfv N czn) cpl1) $ >
  $ wceq L (cfv (csn (co (co R X (cfv (cfv S cmgp) cmg)) (cfv S cur) (cfv S csg))) (cfv S crsp)) $ >
  $ wceq X (cfv (cfv N czn) cv1) $ >
  $ wi ph (wceq N (co P (co P N cpc) cexp)) $;

--| Lemma for aks5. Clean up the conclusion. (Contributed by metakunt, 9-Aug-2025.)
theorem aks5lem8 {n p a b: setvar} (ph: wff) (A2: class n p) (P: class) (R: class n p) (S: class n p a b) (K: class n p) (L: class n p a b) (N: class) (X: class n p a b):
  $ wi ph (wcel (cfv (cfv K cbs) chash) cn) $ >
  $ wceq P (cfv K cchr) $ >
  $ wi ph (wcel K cfield) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel R cn) $ >
  $ wi ph (wcel N (cfv c3 cuz)) $ >
  $ wi ph (wbr P N cdvds) $ >
  $ wi ph (wceq (co N R cgcd) c1) $ >
  $ wceq A2 (cfv (co (cfv (cfv R cphi) csqrt) (co c2 N clogb) cmul) cfl) $ >
  $ wi ph (wbr (co (co c2 N clogb) c2 cexp) (cfv N (cfv R codz)) clt) $ >
  $ wi ph (wbr R (co (cfv (cfv K cbs) chash) c1 cmin) cdvds) $ >
  $ wi ph (wral a (wceq (cec (co N (co X (cfv (cv a) (cfv S czrh)) (cfv S cplusg)) (cfv (cfv S cmgp) cmg)) (co S L cqg)) (cec (co (co N X (cfv (cfv S cmgp) cmg)) (cfv (cv a) (cfv S czrh)) (cfv S cplusg)) (co S L cqg))) (co c1 A2 cfz)) $ >
  $ wi ph (wral b (wceq (co (cv b) N cgcd) c1) (co c1 A2 cfz)) $ >
  $ wceq S (cfv (cfv N czn) cpl1) $ >
  $ wceq L (cfv (csn (co (co R X (cfv (cfv S cmgp) cmg)) (cfv S cur) (cfv S csg))) (cfv S crsp)) $ >
  $ wceq X (cfv (cfv N czn) cv1) $ >
  $ wi ph (wrex p (wrex n (wceq N (co (cv p) (cv n) cexp)) cn) cprime) $;

--| Lemma for aks5. Clean up the conclusion. (Contributed by metakunt, 9-Aug-2025.)
theorem aks5lem8_b {n p a: setvar} (ph: wff) (A2: class n p) (P: class) (R: class n p) (S: class n p a) (K: class n p) (L: class n p a) (N: class) (X: class n p a):
  $ wi ph (wcel (cfv (cfv K cbs) chash) cn) $ >
  $ wceq P (cfv K cchr) $ >
  $ wi ph (wcel K cfield) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel R cn) $ >
  $ wi ph (wcel N (cfv c3 cuz)) $ >
  $ wi ph (wbr P N cdvds) $ >
  $ wi ph (wceq (co N R cgcd) c1) $ >
  $ wceq A2 (cfv (co (cfv (cfv R cphi) csqrt) (co c2 N clogb) cmul) cfl) $ >
  $ wi ph (wbr (co (co c2 N clogb) c2 cexp) (cfv N (cfv R codz)) clt) $ >
  $ wi ph (wbr R (co (cfv (cfv K cbs) chash) c1 cmin) cdvds) $ >
  $ wi ph (wral a (wceq (cec (co N (co X (cfv (cv a) (cfv S czrh)) (cfv S cplusg)) (cfv (cfv S cmgp) cmg)) (co S L cqg)) (cec (co (co N X (cfv (cfv S cmgp) cmg)) (cfv (cv a) (cfv S czrh)) (cfv S cplusg)) (co S L cqg))) (co c1 A2 cfz)) $ >
  $ wi ph (wral a (wceq (co (cv a) N cgcd) c1) (co c1 A2 cfz)) $ >
  $ wceq S (cfv (cfv N czn) cpl1) $ >
  $ wceq L (cfv (csn (co (co R X (cfv (cfv S cmgp) cmg)) (cfv S cur) (cfv S csg))) (cfv S crsp)) $ >
  $ wceq X (cfv (cfv N czn) cv1) $ >
  $ wi ph (wrex p (wrex n (wceq N (co (cv p) (cv n) cexp)) cn) cprime) $;

--| Existence axiom for finite fields, eventually we want to construct them. (Contributed by metakunt, 13-Jul-2025.)
axiom ax_exfinfld {k n p: setvar}:
  $ wral p (wral n (wrex k (wa (wceq (cfv (cfv (cv k) cbs) chash) (co (cv p) (cv n) cexp)) (wceq (cfv (cv k) cchr) (cv p))) cfield) cn) cprime $;

--| For any prime ` P ` and any positive integer ` N ` there exists a field ` k ` such that ` k ` contains ` P ^ N ` elements. (Contributed by metakunt, 13-Jul-2025.)
theorem exfinfldd {k: setvar} (ph: wff k) (P N: class):
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wrex k (wa (wceq (cfv (cfv (cv k) cbs) chash) (co P N cexp)) (wceq (cfv (cv k) cchr) P)) cfield) $;

--| The AKS Primality test, given an integer ` N ` greater than or equal to 3, find a coprime ` R ` such that ` R ` is big enough. Then, if a bunch of polynomial equalities in the residue ring hold then ` N ` is a prime power. Currently depends on the axiom ~ ax-exfinfld , since we currently do not have the existence of finite fields in the database. (Contributed by metakunt, 16-Aug-2025.)
theorem aks5 {n p a: setvar} (ph: wff) (A2: class n p) (R: class) (S L: class n p a) (N: class) (X: class n p a):
  $ wceq A2 (cfv (co (cfv (cfv R cphi) csqrt) (co c2 N clogb) cmul) cfl) $ >
  $ wceq X (cfv (cfv N czn) cv1) $ >
  $ wceq S (cfv (cfv N czn) cpl1) $ >
  $ wceq L (cfv (csn (co (co R X (cfv (cfv S cmgp) cmg)) (cfv S cur) (cfv S csg))) (cfv S crsp)) $ >
  $ wi ph (wcel N (cfv c3 cuz)) $ >
  $ wi ph (wcel R cn) $ >
  $ wi ph (wceq (co N R cgcd) c1) $ >
  $ wi ph (wbr (co (co c2 N clogb) c2 cexp) (cfv N (cfv R codz)) clt) $ >
  $ wi ph (wral a (wceq (cec (co N (co X (cfv (cv a) (cfv S czrh)) (cfv S cplusg)) (cfv (cfv S cmgp) cmg)) (co S L cqg)) (cec (co (co N X (cfv (cfv S cmgp) cmg)) (cfv (cv a) (cfv S czrh)) (cfv S cplusg)) (co S L cqg))) (co c1 A2 cfz)) $ >
  $ wi ph (wral a (wceq (co (cv a) N cgcd) c1) (co c1 A2 cfz)) $ >
  $ wi ph (wrex p (wrex n (wceq N (co (cv p) (cv n) cexp)) cn) cprime) $;

--| The solution of a quadratic equation via factoring. (Contributed by Luke Murphy, 10-Jul-2026.)
theorem quadfac (ph: wff) (A2 B2 C M N X: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wcel X cc) $ >
  $ wi ph (wcel M cc) $ >
  $ wi ph (wcel N cc) $ >
  $ wi ph (wceq (co M N caddc) (cneg (co B2 A2 cdiv))) $ >
  $ wi ph (wceq (co M N cmul) (co C A2 cdiv)) $ >
  $ wi ph (wb (wceq (co (co A2 (co X c2 cexp) cmul) (co (co B2 X cmul) C caddc) caddc) cc0) (wo (wceq X M) (wceq X N))) $;

--| Question 67 of 68 from a lecture Prof. Loof Lirpa held last Saturday in Lincoln Park. When asked why the smaller root wasn't reduced to 3/2, Lirpa responded "It really doesn't matter anyhow." (Contributed by Luke Murphy, 10-Jul-2026.)
theorem _25or6to4 (ph: wff) (A2 B2 C X: class):
  $ wi ph (wceq A2 c1) $ >
  $ wi ph (wceq B2 (cneg (co (cdc c5 c3) c2 cdiv))) $ >
  $ wi ph (wceq C (co (cdc c7 c5) c2 cdiv)) $ >
  $ wi ph (wcel X cc) $ >
  $ wi ph (wb (wceq (co (co A2 (co X c2 cexp) cmul) (co (co B2 X cmul) C caddc) caddc) cc0) (wo (wceq X (cdc c2 c5)) (wceq X (co c6 c4 cdiv)))) $;

--| Inference associated with ~ jarri . A consequence of ~ ax-mp and ~ ax-1 . (Contributed by SN, 14-Oct-2025.)
theorem jarrii (ph ps ch: wff):
  $ ps $ >
  $ wi (wi ph ps) ch $ >
  $ ch $;

--| Introduction of conjunct inside of a contradiction. Would be used in ~ elfvov1 . (Contributed by SN, 18-May-2025.)
theorem intnanrt (ph ps: wff):
  $ wi (wn ph) (wn (wa ph ps)) $;

--| Miscellaneous inference creating a biconditional from an implied converse implication. (Contributed by Steven Nguyen, 17-Jul-2022.)
theorem ioin9i8 (ph ps ch th: wff):
  $ wi ph (wo ps ch) $ >
  $ wi ch (wn th) $ >
  $ wi ps th $ >
  $ wi ph (wb ps th) $;

--| Double deduction form of ~ jaoi . (Contributed by Steven Nguyen, 17-Jul-2022.)
theorem jaodd (ph ps ch th ta: wff):
  $ wi ph (wi ps (wi ch th)) $ >
  $ wi ph (wi ps (wi ta th)) $ >
  $ wi ph (wi ps (wi (wo ch ta) th)) $;

--| A double syllogism inference. (Contributed by SN, 15-Sep-2024.)
theorem syl3an12 (ph ps ch th ta et: wff):
  $ wi ph ps $ >
  $ wi ch th $ >
  $ wi (w3a ps th ta) et $ >
  $ wi (w3a ph ch ta) et $;

--| Inference associated with ~ exbii . Weaker version of ~ eximii . (Contributed by SN, 14-Oct-2025.)
theorem exbiii {x3: setvar} (ph ps: wff x3):
  $ wex x3 ph $ >
  $ wb ph ps $ >
  $ wex x3 ps $;

--| A true statement is true upon substitution (deduction). A similar proof is possible for ~ icht . (Contributed by SN, 4-May-2024.)
theorem sbtd {x3 t: setvar} (ph: wff t) (ps: wff x3 t):
  $ wi ph ps $ >
  $ wi ph (wsb x3 ps t) $;

--| One direction of ~ sbor , using fewer axioms. Compare ~ 19.33 . (Contributed by Steven Nguyen, 18-Aug-2023.)
theorem sbor2 {x3 t: setvar} (ph ps: wff x3 t):
  $ wi (wo (wsb x3 ph t) (wsb x3 ps t)) (wsb x3 (wo ph ps) t) $;

--| Inference form of ~ sbalex , avoiding ~ ax-10 by using ~ ax-gen . (Contributed by SN, 12-Aug-2025.)
theorem sbalexi {x3 y1: setvar} (ph: wff x3 y1):
  $ wex x3 (wa (wceq (cv x3) (cv y1)) ph) $ >
  $ wal x3 (wi (wceq (cv x3) (cv y1)) ph) $;

--| Version of ~ nfal with an 'h' hypothesis, avoiding ~ ax-12 . (Contributed by SN, 11-Feb-2026.)
theorem nfalh {x3 y1: setvar} (ph: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wnf x3 (wal y1 ph) $;

--| An inner existential quantifier's variable is bound. (Contributed by SN, 11-Feb-2026.)
theorem nfe2 {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf x3 (wex y1 (wex x3 ph)) $;

--| An inner existential quantifier's variable is bound. (Contributed by SN, 11-Feb-2026.)
theorem nfale2 {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf x3 (wal y1 (wex x3 ph)) $;

--| ~ 19.9d in the case of an existential quantifier, avoiding the ~ ax-10 from ~ nfex that would be used for the hypothesis of ~ 19.9d , at the cost of an additional DV condition on ` y ` , ` ph ` . (Contributed by SN, 26-May-2024.)
theorem _19_9dev {x3 y1: setvar} (ph: wff x3) (ps: wff x3 y1):
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wb (wex x3 (wex y1 ps)) (wex y1 ps)) $;

--| Triple application of ~ rspcedvd . (Contributed by Steven Nguyen, 27-Feb-2023.)
theorem _3rspcedvd {x3 y1 z: setvar} (ph: wff) (ps: wff x3 y1 z) (ch: wff y1 z) (th: wff x3 z) (ta: wff x3 y1) (A2: class) (B2: class x3) (C: class x3 y1) (D: class):
  $ wi ph (wcel A2 D) $ >
  $ wi ph (wcel B2 D) $ >
  $ wi ph (wcel C D) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi (wa ph (wceq (cv y1) B2)) (wb ch th) $ >
  $ wi (wa ph (wceq (cv z) C)) (wb th ta) $ >
  $ wi ph ta $ >
  $ wi ph (wrex x3 (wrex y1 (wrex z ps D) D) D) $;

--| A condensed form of ~ axrep5 . (Contributed by SN, 21-Sep-2023.)
theorem sn_axrep5v {y1 z w: setvar} (ph: wff z w) (x3: setvar):
  $ wi (wral w (wmo z ph) (cv x3)) (wex y1 (wal z (wb (wcel (cv z) (cv y1)) (wrex w ph (cv x3))))) $;

--| ~ axprlem3 using only Tarski's FOL axiom schemes and ~ ax-rep . (Contributed by SN, 22-Sep-2023.)
theorem sn_axprlem3 {y1 z w a b: setvar} (ph: wff w a b) (x3: setvar):
  $ wex y1 (wal z (wb (wcel (cv z) (cv y1)) (wrex w (wif ph (wceq (cv z) (cv a)) (wceq (cv z) (cv b))) (cv x3)))) $;

--| Alternate proof of ~ exel , avoiding ~ ax-pr but requiring ~ ax-5 , ~ ax-9 , and ~ ax-pow . This is similar to how ~ elALT2 uses ~ ax-pow instead of ~ ax-pr compared to ~ el . (Contributed by SN, 18-Sep-2023.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem sn_exelALT {x3 y1: setvar}:
  $ wex y1 (wex x3 (wcel (cv x3) (cv y1))) $;

--| Deduction of abstraction subclass from implication. (Contributed by SN, 22-Dec-2024.)
theorem ssabdv {x3: setvar} (ph: wff) (ps: wff x3) (A2: class):
  $ wi ph (wi (wcel (cv x3) A2) ps) $ >
  $ wi ph (wss A2 (cab x3 ps)) $;

--| An unused lemma showing that many equivalences involving ~ df-iota are potentially provable without ~ ax-10 , ~ ax-11 , ~ ax-12 . (Contributed by SN, 6-Nov-2024.)
theorem sn_iotalem {x3 y1 z: setvar} (ph: wff x3):
  $ wceq (cab y1 (wceq (cab x3 ph) (csn (cv y1)))) (cab z (wceq (cab y1 (wceq (cab x3 ph) (csn (cv y1)))) (csn (cv z)))) $;

--| Corollary of ~ sn-iotalem . Compare ~ sb8iota . (Contributed by SN, 6-Nov-2024.)
theorem sn_iotalemcor {x3 y1: setvar} (ph: wff x3):
  $ wceq (cio x3 ph) (cio y1 (wceq (cab x3 ph) (csn (cv y1)))) $;

--| Originally part of ~ uniabio . Convert a theorem about ~ df-iota to one about ~ dfiota2 , without ~ ax-10 , ~ ax-11 , ~ ax-12 . Although, ~ eu6 uses ~ ax-10 and ~ ax-12 . (Contributed by SN, 23-Nov-2024.)
theorem abbi1sn {x3: setvar} (ph: wff x3) (y1: setvar):
  $ wi (wal x3 (wb ph (wceq (cv x3) (cv y1)))) (wceq (cab x3 ph) (csn (cv y1))) $;

--| Move a relation inside and outside the conditional operator. (Contributed by SN, 14-Aug-2024.)
theorem brif2 (ph: wff) (A2 B2 C R: class):
  $ wb (wbr C (cif ph A2 B2) R) (wif ph (wbr C A2 R) (wbr C B2 R)) $;

--| Move a relation inside and outside the conditional operator. (Contributed by SN, 14-Aug-2024.)
theorem brif12 (ph: wff) (A2 B2 C D R: class):
  $ wb (wbr (cif ph A2 B2) (cif ph C D) R) (wif ph (wbr A2 C R) (wbr B2 D R)) $;

--| The proper subset of a set is also a set. (Contributed by Steven Nguyen, 17-Jul-2022.)
theorem pssexg (A2 B2 C: class):
  $ wi (wa (wpss A2 B2) (wcel B2 C)) (wcel A2 cvv) $;

--| A proper superset is nonempty. (Contributed by Steven Nguyen, 17-Jul-2022.)
theorem pssn0 (A2 B2: class):
  $ wi (wpss A2 B2) (wne B2 c0) $;

--| Classes are proper subclasses if and only if their power classes are proper subclasses. (Contributed by Steven Nguyen, 17-Jul-2022.)
theorem psspwb (A2 B2: class):
  $ wb (wpss A2 B2) (wpss (cpw A2) (cpw B2)) $;

--| Proper subset theorem for Cartesian product. (Contributed by Steven Nguyen, 17-Jul-2022.)
theorem xppss12 (A2 B2 C D: class):
  $ wi (wa (wpss A2 B2) (wpss C D)) (wpss (cxp A2 C) (cxp B2 D)) $;

--| Membership in a power set, biconditional. (Contributed by Steven Nguyen, 17-Jul-2022.) (Proof shortened by Steven Nguyen, 16-Sep-2022.)
theorem elpwbi (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wb (wss A2 B2) (wcel A2 (cpw B2)) $;

--| The image of a class of ordered pairs. (Contributed by Steven Nguyen, 6-Jun-2023.)
theorem imaopab {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wceq (cima (copab x3 y1 ph) A2) (cab y1 (wrex x3 ph A2)) $;

--| Property of being the restriction of a function. Note that this is closer to ~ funssres than ~ fnssres . (Contributed by SN, 11-Mar-2025.)
theorem eqresfnbd (ph: wff) (A2 B2 R F: class):
  $ wi ph (wfn F B2) $ >
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wb (wceq R (cres F A2)) (wa (wfn R A2) (wss R F))) $;

--| Composition of two functions. Variation of ~ fmpoco with more context in the substitution hypothesis for ` T ` . (Contributed by SN, 14-Mar-2025.)
theorem fmpocos {x3 y1 z: setvar} (ph: wff z) (A2 B2: class z) (C: class) (R: class x3 y1) (S: class z) (T: class x3 y1) (F G: class x3 y1 z):
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) B2))) (wcel R C) $ >
  $ wi ph (wceq F (cmpo x3 y1 A2 B2 R)) $ >
  $ wi ph (wceq G (cmpt z C S)) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) B2))) (wceq (csb z R S) T) $ >
  $ wi ph (wceq (ccom G F) (cmpo x3 y1 A2 B2 T)) $;

--| Value of an operation given by a maps-to rule. Deduction form of ~ ovmpoga . (Contributed by SN, 14-Mar-2025.)
theorem ovmpogad {x3 y1: setvar} (ph: wff) (A2 B2: class) (C D R: class x3 y1) (S: class) (F V: class x3 y1):
  $ wceq F (cmpo x3 y1 C D R) $ >
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wceq R S) $ >
  $ wi ph (wcel A2 C) $ >
  $ wi ph (wcel B2 D) $ >
  $ wi ph (wcel S V) $ >
  $ wi ph (wceq (co A2 B2 F) S) $;

--| A function operation of unions of disjoint functions is a union of function operations. (Contributed by SN, 16-Jun-2024.)
theorem ofun (ph: wff) (A2 B2 C D R M N V W: class):
  $ wi ph (wfn A2 M) $ >
  $ wi ph (wfn B2 M) $ >
  $ wi ph (wfn C N) $ >
  $ wi ph (wfn D N) $ >
  $ wi ph (wcel M V) $ >
  $ wi ph (wcel N W) $ >
  $ wi ph (wceq (cin M N) c0) $ >
  $ wi ph (wceq (co (cun A2 C) (cun B2 D) (cof R)) (cun (co A2 B2 (cof R)) (co C D (cof R)))) $;

--| Alternate definition of quotient set. (Contributed by Steven Nguyen, 7-Jun-2023.)
theorem dfqs3 {x3: setvar} (A2 R: class):
  $ wceq (cqs A2 R) (ciun x3 A2 (csn (cec (cv x3) R))) $;

--| Equality theorem for quotient set, deduction form. (Contributed by Steven Nguyen, 30-Apr-2023.)
theorem qseq12d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq (cqs A2 C) (cqs B2 D)) $;

--| The quotient set is equal to the singleton of ` A ` when all elements are related and ` A ` is nonempty. (Contributed by SN, 8-Jun-2023.)
theorem qsalrel {x3 y1: setvar} (ph: wff) (A2 c_sm: class) (N: class x3):
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) A2))) (wbr (cv x3) (cv y1) c_sm) $ >
  $ wi ph (wer A2 c_sm) $ >
  $ wi ph (wcel N A2) $ >
  $ wi ph (wceq (cqs A2 c_sm) (csn A2)) $;

--| The supremum is the infimum of the upper bounds. (Contributed by SN, 29-Jun-2025.)
theorem supinf {x3 y1 z w: setvar} (ph: wff x3 y1 z w) (A2 B2 c_lt: class):
  $ wi ph (wor A2 c_lt) $ >
  $ wi ph (wrex x3 (wa (wral y1 (wn (wbr (cv x3) (cv y1) c_lt)) B2) (wral y1 (wi (wbr (cv y1) (cv x3) c_lt) (wrex z (wbr (cv y1) (cv z) c_lt) B2)) A2)) A2) $ >
  $ wi ph (wceq (csup B2 A2 c_lt) (cinf (crab x3 (wral w (wn (wbr (cv x3) (cv w) c_lt)) B2) A2) A2 c_lt)) $;

--| Compose two mappings. (Contributed by SN, 11-Mar-2025.)
theorem mapcod (ph: wff) (A2 B2 C F G: class):
  $ wi ph (wcel F (co A2 B2 cmap)) $ >
  $ wi ph (wcel G (co B2 C cmap)) $ >
  $ wi ph (wcel (ccom F G) (co A2 C cmap)) $;

--| A finite set is dominated by the set of natural numbers. (Contributed by SN, 6-Jul-2025.)
theorem fisdomnn (A2: class):
  $ wi (wcel A2 cfn) (wbr A2 cn csdm) $;

--| The less-than relation is a set. (Contributed by SN, 5-Jun-2025.)
theorem ltex:
  $ wcel clt cvv $;

--| The less-than-or-equal-to relation is a set. (Contributed by SN, 5-Jun-2025.)
theorem leex:
  $ wcel cle cvv $;

--| The subtraction operation is a set. (Contributed by SN, 5-Jun-2025.)
theorem subex:
  $ wcel cmin cvv $;

--| The absolute value function is a set. (Contributed by SN, 5-Jun-2025.)
theorem absex:
  $ wcel cabs cvv $;

--| The conjugate function is a set. (Contributed by SN, 5-Jun-2025.)
theorem cjex:
  $ wcel ccj cvv $;

--| Separate out the last term in a finite sum. (Contributed by Steven Nguyen, 22-Aug-2023.)
theorem fzosumm1 {k: setvar} (ph: wff) (A2: class k) (B2 M N: class):
  $ wi ph (wcel (co N c1 cmin) (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfzo))) (wcel A2 cc) $ >
  $ wi (wceq (cv k) (co N c1 cmin)) (wceq A2 B2) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wceq (csu k (co M N cfzo) A2) (co (csu k (co M (co N c1 cmin) cfzo) A2) B2 caddc)) $;

--| Cancellation law for concatenation. (Contributed by SN, 6-Sep-2023.)
theorem ccatcan2d (ph: wff) (A2 B2 C V: class):
  $ wi ph (wcel A2 (cword V)) $ >
  $ wi ph (wcel B2 (cword V)) $ >
  $ wi ph (wcel C (cword V)) $ >
  $ wi ph (wb (wceq (co A2 C cconcat) (co B2 C cconcat)) (wceq A2 B2)) $;

--| Alternate proof of ~ c0ex using more set theory axioms but fewer complex number axioms (add ~ ax-10 , ~ ax-11 , ~ ax-13 , ~ ax-nul , and remove ~ ax-1cn , ~ ax-icn , ~ ax-addcl , and ~ ax-mulcl ). (Contributed by Steven Nguyen, 4-Dec-2022.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem c0exALT:
  $ wcel cc0 cvv $;

--| Alternate proof of ~ 0cn using ~ ax-resscn , ~ ax-addrcl , ~ ax-rnegex , ~ ax-cnre instead of ~ ax-icn , ~ ax-addcl , ~ ax-mulcl , ~ ax-i2m1 . Version of ~ 0cnALT using ~ ax-1cn instead of ~ ax-icn . (Contributed by Steven Nguyen, 7-Jan-2022.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem _0cnALT3:
  $ wcel cc0 cc $;

--| Specialized version of ~ 0red without using ~ ax-1cn and ~ ax-cnre . (Contributed by Steven Nguyen, 28-Jan-2023.)
theorem elre0re (A2: class):
  $ wi (wcel A2 cr) (wcel cc0 cr) $;

--| 'Less than' is transitive. (Contributed by SN, 26-Aug-2025.)
theorem lttrii (A2 B2 C: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wcel C cr $ >
  $ wbr A2 B2 clt $ >
  $ wbr B2 C clt $ >
  $ wbr A2 C clt $;

--| ~ mulcan2d for real numbers using fewer axioms. (Contributed by Steven Nguyen, 15-Apr-2023.)
theorem remulcan2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wne C cc0) $ >
  $ wi ph (wb (wceq (co A2 C cmul) (co B2 C cmul)) (wceq A2 B2)) $;

--| Given some real number ` B ` where ` A ` acts like a right additive identity, derive that ` A ` is a left additive identity. Note that the hypothesis is weaker than proving that ` A ` is a right additive identity (for all numbers). Although, if there is a right additive identity, then by ~ readdcan , ` A ` is the right additive identity. (Contributed by Steven Nguyen, 14-Jan-2023.)
theorem readdridaddlidd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wceq (co B2 A2 caddc) B2) $ >
  $ wi (wa ph (wcel C cr)) (wceq (co A2 C caddc) C) $;

--| A shorter proof of ~ 4p4e8 if ~ 6p2e8 was moved up. The most clean way to do this would be to start with ~ 7p2e9 , then go ~ 6p2e8 , ~ 6p3e9 , etc., which is still inelegant. The idea here is that using ` 4 = 2 + 2 ` and ~ 2cn is shorter than using ` 4 = 3 + 1 ` , ~ 3cn , and ~ ax-1cn . This also works with ~ 5p4e9 . (Contributed by SN, 24-Aug-2026.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem _4p4e8ALT:
  $ wceq (co c4 c4 caddc) c8 $;

--| 1 + 3 = 4. (Contributed by SN, 19-Nov-2025.)
theorem _1p3e4:
  $ wceq (co c1 c3 caddc) c4 $;

--| 1 + 4 = 5. (Contributed by SN, 24-Aug-2026.)
theorem _1p4e5:
  $ wceq (co c1 c4 caddc) c5 $;

--| 1 + 5 = 6. (Contributed by SN, 24-Aug-2026.)
theorem _1p5e6:
  $ wceq (co c1 c5 caddc) c6 $;

--| 1 + 6 = 7. (Contributed by SN, 24-Aug-2026.)
theorem _1p6e7:
  $ wceq (co c1 c6 caddc) c7 $;

--| 1 + 7 = 8. (Contributed by SN, 24-Aug-2026.)
theorem _1p7e8:
  $ wceq (co c1 c7 caddc) c8 $;

--| 1 + 8 = 9. (Contributed by SN, 24-Aug-2026.)
theorem _1p8e9:
  $ wceq (co c1 c8 caddc) c9 $;

--| 2 + 3 = 5. (Contributed by SN, 24-Aug-2026.)
theorem _2p3e5:
  $ wceq (co c2 c3 caddc) c5 $;

--| 2 + 4 = 6. (Contributed by SN, 24-Aug-2026.)
theorem _2p4e6:
  $ wceq (co c2 c4 caddc) c6 $;

--| 2 + 5 = 7. (Contributed by SN, 24-Aug-2026.)
theorem _2p5e7:
  $ wceq (co c2 c5 caddc) c7 $;

--| 2 + 6 = 8. (Contributed by SN, 24-Aug-2026.)
theorem _2p6e8:
  $ wceq (co c2 c6 caddc) c8 $;

--| 2 + 7 = 9. (Contributed by SN, 24-Aug-2026.)
theorem _2p7e9:
  $ wceq (co c2 c7 caddc) c9 $;

--| 3 + 4 = 7. (Contributed by SN, 24-Aug-2026.)
theorem _3p4e7:
  $ wceq (co c3 c4 caddc) c7 $;

--| 3 + 5 = 8. (Contributed by SN, 24-Aug-2026.)
theorem _3p5e8:
  $ wceq (co c3 c5 caddc) c8 $;

--| 3 + 6 = 9. (Contributed by SN, 24-Aug-2026.)
theorem _3p6e9:
  $ wceq (co c3 c6 caddc) c9 $;

--| 4 + 5 = 9. (Contributed by SN, 24-Aug-2026.)
theorem _4p5e9:
  $ wceq (co c4 c5 caddc) c9 $;

--| The number 5 is nonzero. (Contributed by SN, 22-Oct-2025.)
theorem _5ne0:
  $ wne c5 cc0 $;

--| The number 6 is nonzero. (Contributed by SN, 22-Oct-2025.)
theorem _6ne0:
  $ wne c6 cc0 $;

--| The number 7 is nonzero. (Contributed by SN, 22-Oct-2025.)
theorem _7ne0:
  $ wne c7 cc0 $;

--| The number 8 is nonzero. (Contributed by SN, 22-Oct-2025.)
theorem _8ne0:
  $ wne c8 cc0 $;

--| The number 9 is nonzero. (Contributed by SN, 22-Oct-2025.)
theorem _9ne0:
  $ wne c9 cc0 $;

--| A proof of ~ 1ne2 without using ~ ax-mulcom , ~ ax-mulass , ~ ax-pre-mulgt0 . Based on ~ mul02lem2 . (Contributed by SN, 13-Dec-2023.)
theorem sn_1ne2:
  $ wne c1 c2 $;

--| A positive integer that is not 1 is a successor of some other positive integer. (Contributed by Steven Nguyen, 19-Aug-2023.)
theorem nnn1suc {x3: setvar} (A2: class):
  $ wi (wa (wcel A2 cn) (wne A2 c1)) (wrex x3 (wceq (co (cv x3) c1 caddc) A2) cn) $;

--| Reverse closure for addition: the second addend is real if the first addend is real and the sum is real. (Contributed by SN, 25-Apr-2025.)
theorem readdrcl2d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel (co A2 B2 caddc) cr) $ >
  $ wi ph (wcel B2 cr) $;

--| Swap the first two variables in an equation with addition on the right, converting it into a subtraction. Version of ~ mvrraddd with a commuted consequent, and of ~ mvlraddd with a commuted hypothesis. EDITORIAL: The label for this theorem is questionable. Do not move until it would have 7 uses: current additional uses: (none). (Contributed by SN, 21-Aug-2024.)
theorem raddswap12d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wceq A2 (co B2 C caddc)) $ >
  $ wi ph (wceq B2 (co A2 C cmin)) $;

--| Rotate the variables left in an equation with subtraction on the left, converting it into an addition. EDITORIAL: The label for this theorem is questionable. Do not move until it would have 7 uses: current additional uses: (none). (Contributed by SN, 21-Aug-2024.)
theorem lsubrotld (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wceq (co A2 B2 cmin) C) $ >
  $ wi ph (wceq (co B2 C caddc) A2) $;

--| Rotate the variables left in an equation with subtraction on the right, converting it into an addition. EDITORIAL: The label for this theorem is questionable. Do not move until it would have 7 uses: current additional uses: (none). (Contributed by SN, 4-Jul-2025.)
theorem rsubrotld (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wceq A2 (co B2 C cmin)) $ >
  $ wi ph (wceq B2 (co C A2 caddc)) $;

--| Swap the second and third variables in an equation with subtraction on the left, converting it into an addition. EDITORIAL: The label for this theorem is questionable. Do not move until it would have 7 uses: current additional uses: (none). (Contributed by SN, 23-Aug-2024.)
theorem lsubswap23d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wceq (co A2 B2 cmin) C) $ >
  $ wi ph (wceq (co A2 C cmin) B2) $;

--| Relation between sums and differences. (Contributed by Steven Nguyen, 5-Jan-2023.)
theorem addsubeq4com (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cc) (wcel B2 cc)) (wa (wcel C cc) (wcel D cc))) (wb (wceq (co A2 B2 caddc) (co C D caddc)) (wceq (co A2 C cmin) (co D B2 cmin))) $;

--| A sum squared. (Contributed by Steven Nguyen, 16-Sep-2022.)
theorem sqsumi (A2 B2: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wceq (co (co A2 B2 caddc) (co A2 B2 caddc) cmul) (co (co (co A2 A2 cmul) (co B2 B2 cmul) caddc) (co c2 (co A2 B2 cmul) cmul) caddc) $;

--| Lemma for ~ dffltz . (Contributed by Steven Nguyen, 27-Feb-2023.)
theorem negn0nposznnd (ph: wff) (A2: class):
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wn (wbr cc0 A2 clt)) $ >
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wcel (cneg A2) cn) $;

--| Value of the square of the middle term of a 3-term arithmetic progression. (Contributed by Steven Nguyen, 20-Sep-2022.)
theorem sqmid3api (A2 B2 C N: class):
  $ wcel A2 cc $ >
  $ wcel N cc $ >
  $ wceq (co A2 N caddc) B2 $ >
  $ wceq (co B2 N caddc) C $ >
  $ wceq (co B2 B2 cmul) (co (co A2 C cmul) (co N N cmul) caddc) $;

--| Commute ones place in addition. (Contributed by Steven Nguyen, 29-Jan-2023.)
theorem decaddcom (A2 B2 C: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 cn0 $ >
  $ wcel C cn0 $ >
  $ wceq (co (cdc A2 B2) C caddc) (co (cdc A2 C) B2 caddc) $;

--| The square of a number ending in 5. This shortcut only works because 5 is half of 10. (Contributed by Steven Nguyen, 16-Sep-2022.)
theorem sqn5i (A2: class):
  $ wcel A2 cn0 $ >
  $ wceq (co (cdc A2 c5) (cdc A2 c5) cmul) (cdc (cdc (co A2 (co A2 c1 caddc) cmul) c2) c5) $;

--| The square of a number ending in 5. This shortcut only works because 5 is half of 10. (Contributed by Steven Nguyen, 16-Sep-2022.)
theorem sqn5ii (A2 B2 C: class):
  $ wcel A2 cn0 $ >
  $ wceq (co A2 c1 caddc) B2 $ >
  $ wceq (co A2 B2 cmul) C $ >
  $ wceq (co (cdc A2 c5) (cdc A2 c5) cmul) (cdc (cdc C c2) c5) $;

--| Partial products algorithm for two digit multiplication, no carry. Compare ~ muladdi . (Contributed by Steven Nguyen, 9-Dec-2022.)
theorem decpmulnc (A2 B2 C D E F G: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 cn0 $ >
  $ wcel C cn0 $ >
  $ wcel D cn0 $ >
  $ wceq (co A2 C cmul) E $ >
  $ wceq (co (co A2 D cmul) (co B2 C cmul) caddc) F $ >
  $ wceq (co B2 D cmul) G $ >
  $ wceq (co (cdc A2 B2) (cdc C D) cmul) (cdc (cdc E F) G) $;

--| Partial products algorithm for two digit multiplication. (Contributed by Steven Nguyen, 10-Dec-2022.)
theorem decpmul (A2 B2 C D E F G H I: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 cn0 $ >
  $ wcel C cn0 $ >
  $ wcel D cn0 $ >
  $ wceq (co A2 C cmul) E $ >
  $ wceq (co (co A2 D cmul) (co B2 C cmul) caddc) F $ >
  $ wceq (co B2 D cmul) (cdc G H) $ >
  $ wceq (co (cdc E G) F caddc) I $ >
  $ wcel G cn0 $ >
  $ wcel H cn0 $ >
  $ wceq (co (cdc A2 B2) (cdc C D) cmul) (cdc I H) $;

--| The square of a number in terms of its digits switched. (Contributed by Steven Nguyen, 3-Jan-2023.)
theorem sqdeccom12 (A2 B2: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 cn0 $ >
  $ wceq (co (co (cdc A2 B2) (cdc A2 B2) cmul) (co (cdc B2 A2) (cdc B2 A2) cmul) cmin) (co (cdc c9 c9) (co (co A2 A2 cmul) (co B2 B2 cmul) cmin) cmul) $;

--| Variant of ~ sqdeccom12 with a three digit square. (Contributed by Steven Nguyen, 3-Jan-2023.)
theorem sq3deccom12 (A2 B2 C D: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 cn0 $ >
  $ wcel C cn0 $ >
  $ wceq (co A2 C caddc) D $ >
  $ wceq (co (co (cdc (cdc A2 B2) C) (cdc (cdc A2 B2) C) cmul) (co (cdc D B2) (cdc D B2) cmul) cmin) (co (cdc c9 c9) (co (co (cdc A2 B2) (cdc A2 B2) cmul) (co C C cmul) cmin) cmul) $;

--| 4 times 5 equals 20. (Contributed by SN, 30-Mar-2025.)
theorem _4t5e20:
  $ wceq (co c4 c5 cmul) (cdc c2 cc0) $;

--| A third of a number plus the number is four thirds of the number. (Contributed by SN, 19-Nov-2025.)
theorem _3rdpwhole (A2: class):
  $ wi (wcel A2 cc) (wceq (co (co A2 c3 cdiv) A2 caddc) (co c4 (co A2 c3 cdiv) cmul)) $;

--| The square of 4 is 16. (Contributed by SN, 26-Aug-2025.)
theorem sq4:
  $ wceq (co c4 c2 cexp) (cdc c1 c6) $;

--| The square of 5 is 25. (Contributed by SN, 26-Aug-2025.)
theorem sq5:
  $ wceq (co c5 c2 cexp) (cdc c2 c5) $;

--| The square of 6 is 36. (Contributed by SN, 26-Aug-2025.)
theorem sq6:
  $ wceq (co c6 c2 cexp) (cdc c3 c6) $;

--| The square of 7 is 49. (Contributed by SN, 26-Aug-2025.)
theorem sq7:
  $ wceq (co c7 c2 cexp) (cdc c4 c9) $;

--| The square of 8 is 64. (Contributed by SN, 26-Aug-2025.)
theorem sq8:
  $ wceq (co c8 c2 cexp) (cdc c6 c4) $;

--| The square of 9 is 81. (Contributed by SN, 30-Mar-2025.)
theorem sq9:
  $ wceq (co c9 c2 cexp) (cdc c8 c1) $;

--| The positive reals are a subset of the complex numbers. (Contributed by SN, 1-Oct-2025.)
theorem rpsscn:
  $ wss crp cc $;

--| 4 is a positive real. (Contributed by SN, 26-Aug-2025.)
theorem _4rp:
  $ wcel c4 crp $;

--| 6 is a positive real. (Contributed by SN, 26-Aug-2025.)
theorem _6rp:
  $ wcel c6 crp $;

--| 7 is a positive real. (Contributed by SN, 26-Aug-2025.)
theorem _7rp:
  $ wcel c7 crp $;

--| 8 is a positive real. (Contributed by SN, 26-Aug-2025.)
theorem _8rp:
  $ wcel c8 crp $;

--| 9 is a positive real. (Contributed by SN, 26-Aug-2025.)
theorem _9rp:
  $ wcel c9 crp $;

--| Calculate a product by long multiplication as a base comparison with other multiplication algorithms. Conveniently, ` 7 1 1 ` has two ones which greatly simplifies calculations like ` 2 3 5 x. 1 ` . There isn't a higher level ~ mulcomli saving the lower level uses of ~ mulcomli within ` 2 3 5 x. 7 ` since mulcom2 doesn't exist, but if commuted versions of theorems like ~ 7t2e14 are added then this proof would benefit more than ~ ex-decpmul . For practicality, this proof doesn't have "e167085" at the end of its name like ~ 2p2e4 or ~ 8t7e56 . (Contributed by Steven Nguyen, 10-Dec-2022.) (New usage is discouraged.)
theorem _235t711:
  $ wceq (co (cdc (cdc c2 c3) c5) (cdc (cdc c7 c1) c1) cmul) (cdc (cdc (cdc (cdc (cdc c1 c6) c7) cc0) c8) c5) $;

--| Example usage of ~ decpmul . This proof is significantly longer than ~ 235t711 . There is more unnecessary carrying compared to ~ 235t711 . Although saving 5 visual steps, using ~ mulcomli early on increases the compressed proof length. (Contributed by Steven Nguyen, 10-Dec-2022.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem ex_decpmul:
  $ wceq (co (cdc (cdc c2 c3) c5) (cdc (cdc c7 c1) c1) cmul) (cdc (cdc (cdc (cdc (cdc c1 c6) c7) cc0) c8) c5) $;

--| Membership in a successor upper set of integers. (Contributed by SN, 5-Jul-2025.)
theorem eluzp1 (M N: class):
  $ wi (wcel M cz) (wb (wcel N (cfv (co M c1 caddc) cuz)) (wa (wcel N cz) (wbr M N clt))) $;

--| Shorter proof of ~ eluzp1l . (Contributed by NM, 12-Sep-2005.) (Revised by SN, 5-Jul-2025.)
theorem sn_eluzp1l (M N: class):
  $ wi (wa (wcel M cz) (wcel N (cfv (co M c1 caddc) cuz))) (wbr M N clt) $;

--| The sum of ` N ` constant terms ( ` k ` is not free in ` C ` ). (Contributed by SN, 21-Mar-2025.)
theorem fz1sumconst {k: setvar} (ph: wff k) (C N: class):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wceq (csu k (co c1 N cfz) C) (co N C cmul)) $;

--| Add one more term to a sum. Special case of ~ fsump1 generalized to ` N e. NN0 ` . (Contributed by SN, 22-Mar-2025.)
theorem fz1sump1 {k: setvar} (ph: wff) (A2: class k) (B2 N: class):
  $ wi ph (wcel N cn0) $ >
  $ wi (wa ph (wcel (cv k) (co c1 (co N c1 caddc) cfz))) (wcel A2 cc) $ >
  $ wi (wceq (cv k) (co N c1 caddc)) (wceq A2 B2) $ >
  $ wi ph (wceq (csu k (co c1 (co N c1 caddc) cfz) A2) (co (csu k (co c1 N cfz) A2) B2 caddc)) $;

--| The Odd Number Theorem. The sum of the first ` N ` odd numbers is ` N ^ 2 ` . A corollary of ~ arisum . (Contributed by SN, 21-Mar-2025.)
theorem oddnumth {k: setvar} (N: class):
  $ wi (wcel N cn0) (wceq (csu k (co c1 N cfz) (co (co c2 (cv k) cmul) c1 cmin)) (co N c2 cexp)) $;

--| Nicomachus's Theorem. The sum of the odd numbers from ` N ^ 2 - N + 1 ` to ` N ^ 2 + N - 1 ` is ` N ^ 3 ` . Proof 2 from ~ https://proofwiki.org/wiki/Nicomachus%27s_Theorem . (Contributed by SN, 21-Mar-2025.)
theorem nicomachus {k: setvar} (N: class):
  $ wi (wcel N cn0) (wceq (csu k (co c1 N cfz) (co (co (co N c2 cexp) N cmin) (co (co c2 (cv k) cmul) c1 cmin) caddc)) (co N c3 cexp)) $;

--| The sum of the first ` N ` perfect cubes is the sum of the first ` N ` nonnegative integers, squared. This is the Proof by Nicomachus from ~ https://proofwiki.org/wiki/Sum_of_Sequence_of_Cubes using induction and index shifting to collect all the odd numbers. (Contributed by SN, 22-Mar-2025.)
theorem sumcubes {k: setvar} (N: class):
  $ wi (wcel N cn0) (wceq (csu k (co c1 N cfz) (co (cv k) c3 cexp)) (co (csu k (co c1 N cfz) (cv k)) c2 cexp)) $;

--| ` _i ` is not 1. (Contributed by SN, 25-Apr-2025.)
theorem ine1:
  $ wne ci c1 $;

--| 0 times ` _i ` equals 0. (Contributed by SN, 25-Apr-2025.)
theorem _0tie0:
  $ wceq (co cc0 ci cmul) cc0 $;

--| ` _i ` times 1 equals ` _i ` . (Contributed by SN, 25-Apr-2025.)
theorem it1ei:
  $ wceq (co ci c1 cmul) ci $;

--| 1 times ` _i ` equals ` _i ` . (Contributed by SN, 25-Apr-2025.)
theorem _1tiei:
  $ wceq (co c1 ci cmul) ci $;

--| ` _i ` times a real is real iff the real is zero. (Contributed by SN, 25-Apr-2025.)
theorem itrere (R: class):
  $ wi (wcel R cr) (wb (wcel (co ci R cmul) cr) (wceq R cc0)) $;

--| A real times ` _i ` is real iff the real is zero. (Contributed by SN, 25-Apr-2025.)
theorem retire (R: class):
  $ wi (wcel R cr) (wb (wcel (co R ci cmul) cr) (wceq R cc0)) $;

--| Adjacent intervals where the lower interval is right-closed and the upper interval is open are disjoint. (Contributed by SN, 1-Oct-2025.)
theorem iocioodisjd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cxr) $ >
  $ wi ph (wcel B2 cxr) $ >
  $ wi ph (wcel C cxr) $ >
  $ wi ph (wceq (cin (co A2 B2 cioc) (co B2 C cioo)) c0) $;

--| A positive real is its own absolute value. (Contributed by SN, 1-Oct-2025.)
theorem rpabsid (R: class):
  $ wi (wcel R crp) (wceq (cfv R cabs) R) $;

--| Lemma for ~ dffltz . For a more standard version, see ~ expgt0b . TODO-SN?: This can be used to show ~ exp11d holds for all integers when the exponent is odd. (Contributed by SN, 4-Mar-2023.)
theorem oexpreposd (ph: wff) (M N: class):
  $ wi ph (wcel N cr) $ >
  $ wi ph (wcel M cn) $ >
  $ wi ph (wn (wcel (co M c2 cdiv) cn)) $ >
  $ wi ph (wb (wbr cc0 N clt) (wbr cc0 (co N M cexp) clt)) $;

--| A nonnegative real number less than one raised to a positive integer is less than one. (Contributed by SN, 3-Jul-2025.)
theorem explt1d (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr cc0 A2 cle) $ >
  $ wi ph (wbr A2 c1 clt) $ >
  $ wi ph (wbr (co A2 N cexp) c1 clt) $;

--| A nonnegative real number is one if and only if it is one when raised to a positive integer. (Contributed by SN, 3-Jul-2025.)
theorem expeq1d (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr cc0 A2 cle) $ >
  $ wi ph (wb (wceq (co A2 N cexp) c1) (wceq A2 c1)) $;

--| A nonnegative real number is zero or one if and only if it is itself when raised to an integer greater than one. (Contributed by SN, 3-Jul-2025.)
theorem expeqidd (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel N (cfv c2 cuz)) $ >
  $ wi ph (wbr cc0 A2 cle) $ >
  $ wi ph (wb (wceq (co A2 N cexp) A2) (wo (wceq A2 cc0) (wceq A2 c1))) $;

--| ~ exp11nnd for nonzero integer exponents. (Contributed by SN, 14-Sep-2023.)
theorem exp11d (ph: wff) (A2 B2 N: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wne N cc0) $ >
  $ wi ph (wceq (co A2 N cexp) (co B2 N cexp)) $ >
  $ wi ph (wceq A2 B2) $;

--| 0 divides 0. (Contributed by SN, 15-Sep-2024.)
theorem _0dvds0:
  $ wbr cc0 cc0 cdvds $;

--| Divisibility is invariant under taking the absolute value on both sides. (Contributed by SN, 15-Sep-2024.)
theorem absdvdsabsb (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wbr M N cdvds) (wbr (cfv M cabs) (cfv N cabs) cdvds)) $;

--| ~ dvdsexpnn generalized to include zero bases. (Contributed by SN, 15-Sep-2024.)
theorem dvdsexpnn0 (A2 B2 N: class):
  $ wi (w3a (wcel A2 cn0) (wcel B2 cn0) (wcel N cn)) (wb (wbr A2 B2 cdvds) (wbr (co A2 N cexp) (co B2 N cexp) cdvds)) $;

--| ~ dvdssq generalized to positive integer exponents. (Contributed by SN, 15-Sep-2024.)
theorem dvdsexpb (A2 B2 N: class):
  $ wi (w3a (wcel A2 cz) (wcel B2 cz) (wcel N cn)) (wb (wbr A2 B2 cdvds) (wbr (co A2 N cexp) (co B2 N cexp) cdvds)) $;

--| Two ways to express " ` N ` is an integer multiple of ` M ` ". Originally a subproof of ~ zdiv . (Contributed by SN, 25-Apr-2025.)
theorem zdivgd {k: setvar} (ph: wff) (M N: class):
  $ wi ph (wcel M cc) $ >
  $ wi ph (wcel N cc) $ >
  $ wi ph (wne M cc0) $ >
  $ wi ph (wb (wrex k (wceq (co M (cv k) cmul) N) cz) (wcel (co N M cdiv) cz)) $;

--| Difference of exponents law for exponential function, deduction form. (Contributed by SN, 25-Apr-2025.)
theorem efsubd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wceq (cfv (co A2 B2 cmin) ce) (co (cfv A2 ce) (cfv B2 ce) cdiv)) $;

--| General condition for the exponential function to be one-to-one. ~ efper shows that exponentiation is periodic. (Contributed by SN, 25-Apr-2025.)
theorem ef11d {n: setvar} (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wb (wceq (cfv A2 ce) (cfv B2 ce)) (wrex n (wceq A2 (co B2 (co (co ci (co c2 cpi cmul) cmul) (cv n) cmul) caddc)) cz)) $;

--| The logarithm isn't 0 if its argument isn't 0 or 1, deduction form. (Contributed by SN, 25-Apr-2025.)
theorem logccne0d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wne A2 c1) $ >
  $ wi ph (wne (cfv A2 clog) cc0) $;

--| General condition for complex exponentiation to be one-to-one with respect to the second argument. (Contributed by SN, 25-Apr-2025.)
theorem cxp112d {n: setvar} (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel C cc) $ >
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wne C cc0) $ >
  $ wi ph (wne C c1) $ >
  $ wi ph (wb (wceq (co C A2 ccxp) (co C B2 ccxp)) (wrex n (wceq A2 (co B2 (co (co (co ci (co c2 cpi cmul) cmul) (cv n) cmul) (cfv C clog) cdiv) caddc)) cz)) $;

--| General condition for complex exponentiation to be one-to-one with respect to the first argument. (Contributed by SN, 25-Apr-2025.)
theorem cxp111d {n: setvar} (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wne B2 cc0) $ >
  $ wi ph (wne C cc0) $ >
  $ wi ph (wb (wceq (co A2 C ccxp) (co B2 C ccxp)) (wrex n (wceq (cfv A2 clog) (co (cfv B2 clog) (co (co (co ci (co c2 cpi cmul) cmul) (cv n) cmul) C cdiv) caddc)) cz)) $;

--| ` _i ` to the powers of ` A ` and ` B ` are equal iff ` A ` and ` B ` are a multiple of 4 apart. EDITORIAL: This theorem may be revised to a more convenient form. (Contributed by SN, 25-Apr-2025.)
theorem cxpi11d {n: setvar} (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wb (wceq (co ci A2 ccxp) (co ci B2 ccxp)) (wrex n (wceq A2 (co B2 (co c4 (cv n) cmul) caddc)) cz)) $;

--| Deduction form of ~ logne0 . See ~ logccne0d for a more general version. (Contributed by SN, 25-Apr-2025.)
theorem logne0d (ph: wff) (A2: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wne A2 c1) $ >
  $ wi ph (wne (cfv A2 clog) cc0) $;

--| Real exponentiation is one-to-one with respect to the second argument. (TODO: Note that the base ` C ` must be positive since ` -u C ^ A ` is ` C ^ A x. _e ^ _i _pi A ` , so in the negative case ` A = B + 2 k ` ). (Contributed by SN, 25-Apr-2025.)
theorem rxp112d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel C crp) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wne C c1) $ >
  $ wi ph (wceq (co C A2 ccxp) (co C B2 ccxp)) $ >
  $ wi ph (wceq A2 B2) $;

--| The natural logarithm is one-to-one. (Contributed by SN, 25-Apr-2025.)
theorem log11d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wne B2 cc0) $ >
  $ wi ph (wb (wceq (cfv A2 clog) (cfv B2 clog)) (wceq A2 B2)) $;

--| The natural logarithm is one-to-one on positive reals. (Contributed by SN, 25-Apr-2025.)
theorem rplog11d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wb (wceq (cfv A2 clog) (cfv B2 clog)) (wceq A2 B2)) $;

--| Real exponentiation is one-to-one with respect to the first argument. (Contributed by SN, 25-Apr-2025.)
theorem rxp11d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wne C cc0) $ >
  $ wi ph (wceq (co A2 C ccxp) (co B2 C ccxp)) $ >
  $ wi ph (wceq A2 B2) $;

--| The tangent of ` _pi / 2 ` minus a number is the cotangent, here represented by ` cos A / sin A ` . (Contributed by SN, 2-Sep-2025.)
theorem tanhalfpim (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wne (cfv A2 csin) cc0) $ >
  $ wi ph (wceq (cfv (co (co cpi c2 cdiv) A2 cmin) ctan) (co (cfv A2 ccos) (cfv A2 csin) cdiv)) $;

--| Sine of a number subtracted from ` _pi ` . (Contributed by SN, 19-Nov-2025.)
theorem sinpim (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv (co cpi A2 cmin) csin) (cfv A2 csin)) $;

--| Cosine of a number subtracted from ` _pi ` . (Contributed by SN, 19-Nov-2025.)
theorem cospim (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv (co cpi A2 cmin) ccos) (cneg (cfv A2 ccos))) $;

--| The tangent of ` _pi / 3 ` is ` sqrt 3 ` . (Contributed by SN, 2-Sep-2025.)
theorem tan3rdpi:
  $ wceq (cfv (co cpi c3 cdiv) ctan) (cfv c3 csqrt) $;

--| The sine of ` 2 x. ( _pi / 3 ) ` is ` ( sqrt 3 ) / 2 ` . (Contributed by SN, 19-Nov-2025.)
theorem sin2t3rdpi:
  $ wceq (cfv (co c2 (co cpi c3 cdiv) cmul) csin) (co (cfv c3 csqrt) c2 cdiv) $;

--| The cosine of ` 2 x. ( _pi / 3 ) ` is ` -u 1 / 2 ` . (Contributed by SN, 19-Nov-2025.)
theorem cos2t3rdpi:
  $ wceq (cfv (co c2 (co cpi c3 cdiv) cmul) ccos) (cneg (co c1 c2 cdiv)) $;

--| The sine of ` 4 x. ( _pi / 3 ) ` is ` -u ( sqrt 3 ) / 2 ` . (Contributed by SN, 19-Nov-2025.)
theorem sin4t3rdpi:
  $ wceq (cfv (co c4 (co cpi c3 cdiv) cmul) csin) (cneg (co (cfv c3 csqrt) c2 cdiv)) $;

--| The cosine of ` 4 x. ( _pi / 3 ) ` is ` -u 1 / 2 ` . (Contributed by SN, 19-Nov-2025.)
theorem cos4t3rdpi:
  $ wceq (cfv (co c4 (co cpi c3 cdiv) cmul) ccos) (cneg (co c1 c2 cdiv)) $;

--| The arcsine of ` 1 / 2 ` is ` _pi / 6 ` . (Contributed by SN, 31-Aug-2025.)
theorem asin1half:
  $ wceq (cfv (co c1 c2 cdiv) casin) (co cpi c6 cdiv) $;

--| The arccosine of ` 1 / 2 ` is ` _pi / 3 ` . (Contributed by SN, 31-Aug-2024.)
theorem acos1half:
  $ wceq (cfv (co c1 c2 cdiv) cacos) (co cpi c3 cdiv) $;

--| Condition for the union of the derivatives of two disjoint functions to be equal to the derivative of the union of the two functions. If ` A ` and ` B ` are open sets, this condition (dvun.n) is satisfied by ~ isopn3i . (Contributed by SN, 30-Sep-2025.)
theorem dvun (ph: wff) (A2 B2 S F G J K: class):
  $ wceq J (co K S crest) $ >
  $ wceq K (cfv ccnfld ctopn) $ >
  $ wi ph (wss S cc) $ >
  $ wi ph (wf A2 cc F) $ >
  $ wi ph (wf B2 cc G) $ >
  $ wi ph (wss A2 S) $ >
  $ wi ph (wss B2 S) $ >
  $ wi ph (wceq (cin A2 B2) c0) $ >
  $ wi ph (wceq (cun (cfv A2 (cfv J cnt)) (cfv B2 (cfv J cnt))) (cfv (cun A2 B2) (cfv J cnt))) $ >
  $ wi ph (wceq (cun (co S F cdv) (co S G cdv)) (co S (cun F G) cdv)) $;

--| The derivative of the absolute value, for real numbers. (Contributed by SN, 30-Sep-2025.)
theorem redvmptabs {x3: setvar} (D: class):
  $ wceq D (cdif cr (csn cc0)) $ >
  $ wceq (co cr (cmpt x3 D (cfv (cv x3) cabs)) cdv) (cmpt x3 D (cif (wbr (cv x3) cc0 clt) (cneg c1) c1)) $;

--| The antiderivative of 1/x in real numbers, without using the absolute value function. (Contributed by SN, 1-Oct-2025.)
theorem readvrec2 {x3: setvar} (D: class):
  $ wceq D (cdif cr (csn cc0)) $ >
  $ wceq (co cr (cmpt x3 D (co (cfv (co (cv x3) c2 cexp) clog) c2 cdiv)) cdv) (cmpt x3 D (co c1 (cv x3) cdiv)) $;

--| For real numbers, the antiderivative of 1/x is ln|x|. (Contributed by SN, 30-Sep-2025.)
theorem readvrec {x3: setvar} (D: class):
  $ wceq D (cdif cr (csn cc0)) $ >
  $ wceq (co cr (cmpt x3 D (cfv (cfv (cv x3) cabs) clog)) cdv) (cmpt x3 D (co c1 (cv x3) cdiv)) $;

--| The support of sin ( ~ df-supp ) restricted to the reals is an open set. (Contributed by SN, 7-Oct-2025.)
theorem resuppsinopn {y1: setvar} (D: class y1):
  $ wceq D (crab y1 (wne (cfv (cv y1) csin) cc0) cr) $ >
  $ wcel D (cfv (crn cioo) ctg) $;

--| Real antiderivative of cotangent. (Contributed by SN, 7-Oct-2025.)
theorem readvcot {x3 y1: setvar} (D: class y1):
  $ wceq D (crab y1 (wne (cfv (cv y1) csin) cc0) cr) $ >
  $ wceq (co cr (cmpt x3 D (cfv (cfv (cfv (cv x3) csin) cabs) clog)) cdv) (cmpt x3 D (co (cfv (cv x3) ccos) (cfv (cv x3) csin) cdiv)) $;

--| Real number subtraction.
term cresub: class;

--| Define subtraction between real numbers. This operator saves a few axioms over ~ df-sub in certain situations. Theorem ~ resubval shows its value, ~ resubadd relates it to addition, and ~ rersubcl proves its closure. It is the restriction of ~ df-sub to the reals: ~ subresre . (Contributed by Steven Nguyen, 7-Jan-2023.)
axiom df_resub {x3 y1 z: setvar}:
  $ wceq cresub (cmpo x3 y1 cr cr (crio z (wceq (co (cv y1) (cv z) caddc) (cv x3)) cr)) $;

--| Value of real subtraction, which is the (unique) real ` x ` such that ` B + x = A ` . (Contributed by Steven Nguyen, 7-Jan-2023.)
theorem resubval {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wceq (co A2 B2 cresub) (crio x3 (wceq (co B2 (cv x3) caddc) A2) cr)) $;

--| Lemma for ~ renegeu and similar. Derive existential uniqueness from existence. (Contributed by Steven Nguyen, 28-Jan-2023.)
theorem renegeulemv {x3 y1: setvar} (ph: wff) (A2 B2: class):
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wrex y1 (wceq (co B2 (cv y1) caddc) A2) cr) $ >
  $ wi ph (wreu x3 (wceq (co B2 (cv x3) caddc) A2) cr) $;

--| Lemma for ~ renegeu and similar. Remove a change in bound variables from ~ renegeulemv . (Contributed by Steven Nguyen, 28-Jan-2023.)
theorem renegeulem {y1: setvar} (ph: wff) (A2 B2: class):
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wrex y1 (wceq (co B2 (cv y1) caddc) A2) cr) $ >
  $ wi ph (wreu y1 (wceq (co B2 (cv y1) caddc) A2) cr) $;

--| Existential uniqueness of real negatives. (Contributed by Steven Nguyen, 7-Jan-2023.)
theorem renegeu {x3: setvar} (A2: class):
  $ wi (wcel A2 cr) (wreu x3 (wceq (co A2 (cv x3) caddc) cc0) cr) $;

--| Closure law for negative reals. (Contributed by Steven Nguyen, 7-Jan-2023.)
theorem rernegcl (A2: class):
  $ wi (wcel A2 cr) (wcel (co cc0 A2 cresub) cr) $;

--| Relationship between real negation and addition. (Contributed by Steven Nguyen, 7-Jan-2023.)
theorem renegadd (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wb (wceq (co cc0 A2 cresub) B2) (wceq (co A2 B2 caddc) cc0)) $;

--| Addition of a real number and its negative. (Contributed by Steven Nguyen, 7-Jan-2023.)
theorem renegid (A2: class):
  $ wi (wcel A2 cr) (wceq (co A2 (co cc0 A2 cresub) caddc) cc0) $;

--| Negative zero is a left additive identity. (Contributed by Steven Nguyen, 7-Jan-2023.)
theorem reneg0addlid (A2: class):
  $ wi (wcel A2 cr) (wceq (co (co cc0 cc0 cresub) A2 caddc) A2) $;

--| Lemma for ~ resubeu . A value which when added to zero, results in negative zero. (Contributed by Steven Nguyen, 7-Jan-2023.)
theorem resubeulem1 (A2: class):
  $ wi (wcel A2 cr) (wceq (co cc0 (co cc0 (co cc0 cc0 caddc) cresub) caddc) (co cc0 cc0 cresub)) $;

--| Lemma for ~ resubeu . A value which when added to ` A ` , results in ` B ` . (Contributed by Steven Nguyen, 7-Jan-2023.)
theorem resubeulem2 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wceq (co A2 (co (co cc0 A2 cresub) (co (co cc0 (co cc0 cc0 caddc) cresub) B2 caddc) caddc) caddc) B2) $;

--| Existential uniqueness of real differences. (Contributed by Steven Nguyen, 7-Jan-2023.)
theorem resubeu {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wreu x3 (wceq (co A2 (cv x3) caddc) B2) cr) $;

--| Closure for real subtraction. Based on ~ subcl . (Contributed by Steven Nguyen, 7-Jan-2023.)
theorem rersubcl (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wcel (co A2 B2 cresub) cr) $;

--| Relation between real subtraction and addition. Based on ~ subadd . (Contributed by Steven Nguyen, 7-Jan-2023.)
theorem resubadd (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wb (wceq (co A2 B2 cresub) C) (wceq (co B2 C caddc) A2)) $;

--| Relationship between subtraction and addition. Based on ~ subaddd . (Contributed by Steven Nguyen, 8-Jan-2023.)
theorem resubaddd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wb (wceq (co A2 B2 cresub) C) (wceq (co B2 C caddc) A2)) $;

--| Real subtraction is an operation on the real numbers. Based on ~ subf . (Contributed by Steven Nguyen, 7-Jan-2023.)
theorem resubf:
  $ wf (cxp cr cr) cr cresub $;

--| Addition and subtraction of equals. Compare ~ pncan2 . (Contributed by Steven Nguyen, 8-Jan-2023.)
theorem repncan2 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wceq (co (co A2 B2 caddc) A2 cresub) B2) $;

--| Addition and subtraction of equals. Based on ~ pncan3 . (Contributed by Steven Nguyen, 8-Jan-2023.)
theorem repncan3 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wceq (co A2 (co B2 A2 cresub) caddc) B2) $;

--| Law for addition and subtraction. (Contributed by Steven Nguyen, 28-Jan-2023.)
theorem readdsub (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wceq (co (co A2 B2 caddc) C cresub) (co (co A2 C cresub) B2 caddc)) $;

--| Move LHS of a sum into RHS of a (real) difference. Version of ~ mvlladdd with real subtraction. (Contributed by Steven Nguyen, 8-Jan-2023.)
theorem reladdrsub (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wceq (co A2 B2 caddc) C) $ >
  $ wi ph (wceq B2 (co C A2 cresub)) $;

--| Subtraction from both sides of 'less than'. Compare ~ ltsub1 . (Contributed by SN, 13-Feb-2024.)
theorem reltsub1 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wb (wbr A2 B2 clt) (wbr (co A2 C cresub) (co B2 C cresub) clt)) $;

--| 'Less than' relationship between addition and subtraction. Compare ~ ltsubadd2 . (Contributed by SN, 13-Feb-2024.)
theorem reltsubadd2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wb (wbr (co A2 B2 cresub) C clt) (wbr A2 (co B2 C caddc) clt)) $;

--| Cancellation law for real subtraction. Compare ~ subcan2 . (Contributed by Steven Nguyen, 8-Jan-2023.)
theorem resubcan2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wb (wceq (co A2 C cresub) (co B2 C cresub)) (wceq A2 B2)) $;

--| Law for double subtraction. Compare ~ subsub4 . (Contributed by Steven Nguyen, 14-Jan-2023.)
theorem resubsub4 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wceq (co (co A2 B2 cresub) C cresub) (co A2 (co B2 C caddc) cresub)) $;

--| Cancellation law for real subtraction. Compare ~ nnncan2 . (Contributed by Steven Nguyen, 14-Jan-2023.)
theorem rennncan2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wceq (co (co A2 C cresub) (co B2 C cresub) cresub) (co A2 B2 cresub)) $;

--| Cancellation law for real subtraction. Compare ~ npncan3 . (Contributed by Steven Nguyen, 28-Jan-2023.)
theorem renpncan3 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wceq (co (co A2 B2 cresub) (co C A2 cresub) caddc) (co C B2 cresub)) $;

--| Cancellation law for addition and real subtraction. Compare ~ pnpcan . (Contributed by Steven Nguyen, 19-May-2023.)
theorem repnpcan (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wceq (co (co A2 B2 caddc) (co A2 C caddc) cresub) (co B2 C cresub)) $;

--| Cancellation law for mixed addition and real subtraction. Compare ~ ppncan . (Contributed by SN, 3-Sep-2023.)
theorem reppncan (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wceq (co (co A2 C caddc) (co B2 C cresub) caddc) (co A2 B2 caddc)) $;

--| Lemma for ~ resubidaddlid . A special case of ~ npncan . (Contributed by Steven Nguyen, 8-Jan-2023.)
theorem resubidaddlidlem (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wceq (co A2 B2 cresub) (co B2 C cresub)) $ >
  $ wi ph (wceq (co (co A2 B2 cresub) (co B2 C cresub) caddc) (co A2 C cresub)) $;

--| Any real number subtracted from itself forms a left additive identity. (Contributed by Steven Nguyen, 8-Jan-2023.)
theorem resubidaddlid (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wceq (co (co A2 A2 cresub) B2 caddc) B2) $;

--| Distribution of multiplication over real subtraction. (Contributed by Steven Nguyen, 3-Jun-2023.)
theorem resubdi (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wceq (co A2 (co B2 C cresub) cmul) (co (co A2 B2 cmul) (co A2 C cmul) cresub)) $;

--| Equality of two left-additive identities. See ~ resubidaddlid . Uses ~ ax-i2m1 . (Contributed by SN, 25-Dec-2023.)
theorem re1m1e0m0:
  $ wceq (co c1 c1 cresub) (co cc0 cc0 cresub) $;

--| Lemma for ~ sn-00id . (Contributed by SN, 25-Dec-2023.)
theorem sn_00idlem1 (A2: class):
  $ wi (wcel A2 cr) (wceq (co A2 (co cc0 cc0 cresub) cmul) (co A2 A2 cresub)) $;

--| Lemma for ~ sn-00id . (Contributed by SN, 25-Dec-2023.)
theorem sn_00idlem2:
  $ wi (wne (co cc0 cc0 cresub) cc0) (wceq (co cc0 cc0 cresub) c1) $;

--| Lemma for ~ sn-00id . (Contributed by SN, 25-Dec-2023.)
theorem sn_00idlem3:
  $ wi (wceq (co cc0 cc0 cresub) c1) (wceq (co cc0 cc0 caddc) cc0) $;

--| ~ 00id proven without ~ ax-mulcom but using ~ ax-1ne0 . (Though note that the current version of ~ 00id can be changed to avoid ~ ax-icn , ~ ax-addcl , ~ ax-mulcl , ~ ax-i2m1 , ~ ax-cnre . Most of this is by using ~ 0cnALT3 instead of ~ 0cn ). (Contributed by SN, 25-Dec-2023.) (Proof modification is discouraged.)
theorem sn_00id:
  $ wceq (co cc0 cc0 caddc) cc0 $;

--| Real number version of ~ 0m0e0 proven without ~ ax-mulcom . (Contributed by SN, 23-Jan-2024.)
theorem re0m0e0:
  $ wceq (co cc0 cc0 cresub) cc0 $;

--| Real number version of ~ addlid . (Contributed by SN, 23-Jan-2024.)
theorem readdlid (A2: class):
  $ wi (wcel A2 cr) (wceq (co cc0 A2 caddc) A2) $;

--| ~ addlid without ~ ax-mulcom . (Contributed by SN, 23-Jan-2024.)
theorem sn_addlid (A2: class):
  $ wi (wcel A2 cc) (wceq (co cc0 A2 caddc) A2) $;

--| Real number version of ~ mul02 proven without ~ ax-mulcom . (Contributed by SN, 23-Jan-2024.)
theorem remul02 (A2: class):
  $ wi (wcel A2 cr) (wceq (co cc0 A2 cmul) cc0) $;

--| ~ 0ne2 without ~ ax-mulcom . (Contributed by SN, 23-Jan-2024.)
theorem sn_0ne2:
  $ wne cc0 c2 $;

--| Real number version of ~ mul01 proven without ~ ax-mulcom . (Contributed by SN, 23-Jan-2024.)
theorem remul01 (A2: class):
  $ wi (wcel A2 cr) (wceq (co A2 cc0 cmul) cc0) $;

--| A product is zero iff one of its factors are zero. (Contributed by SN, 24-Nov-2025.)
theorem sn_remul0ord (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wb (wceq (co A2 B2 cmul) cc0) (wo (wceq A2 cc0) (wceq B2 cc0))) $;

--| Subtraction of a real number from itself (compare ~ subid ). (Contributed by SN, 23-Jan-2024.)
theorem resubid (A2: class):
  $ wi (wcel A2 cr) (wceq (co A2 A2 cresub) cc0) $;

--| Real number version of ~ addrid without ~ ax-mulcom . (Contributed by SN, 23-Jan-2024.)
theorem readdrid (A2: class):
  $ wi (wcel A2 cr) (wceq (co A2 cc0 caddc) A2) $;

--| Real number version of ~ subid1 without ~ ax-mulcom . (Contributed by SN, 23-Jan-2024.)
theorem resubid1 (A2: class):
  $ wi (wcel A2 cr) (wceq (co A2 cc0 cresub) A2) $;

--| A real number is equal to the negative of its negative. Compare ~ negneg . (Contributed by SN, 13-Feb-2024.)
theorem renegneg (A2: class):
  $ wi (wcel A2 cr) (wceq (co cc0 (co cc0 A2 cresub) cresub) A2) $;

--| Commuted version of ~ readdcan without ~ ax-mulcom . (Contributed by SN, 21-Feb-2024.)
theorem readdcan2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wb (wceq (co A2 C caddc) (co B2 C caddc)) (wceq A2 B2)) $;

--| Commuted version of ~ renegid . (Contributed by SN, 4-May-2024.)
theorem renegid2 (A2: class):
  $ wi (wcel A2 cr) (wceq (co (co cc0 A2 cresub) A2 caddc) cc0) $;

--| Product with negative is negative of product. (Contributed by SN, 25-Jan-2025.)
theorem remulneg2d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wceq (co A2 (co cc0 B2 cresub) cmul) (co cc0 (co A2 B2 cmul) cresub)) $;

--| Proof of ~ it0e0 without ~ ax-mulcom . Informally, a real number times 0 is 0, and ` E. r e. RR r = _i x. s ` by ~ ax-cnre and ~ renegid2 . (Contributed by SN, 30-Apr-2024.)
theorem sn_it0e0:
  $ wceq (co ci cc0 cmul) cc0 $;

--| A combination of ~ cnegex and ~ cnegex2 , this proof takes ~ cnre ` A = r + _i x. s ` and shows that ` _i x. -u s + -u r ` is both a left and right inverse. (Contributed by SN, 5-May-2024.) (Proof shortened by SN, 4-Jul-2025.)
theorem sn_negex12 {b: setvar} (A2: class):
  $ wi (wcel A2 cc) (wrex b (wa (wceq (co A2 (cv b) caddc) cc0) (wceq (co (cv b) A2 caddc) cc0)) cc) $;

--| Proof of ~ cnegex without ~ ax-mulcom . (Contributed by SN, 30-Apr-2024.)
theorem sn_negex {b: setvar} (A2: class):
  $ wi (wcel A2 cc) (wrex b (wceq (co A2 (cv b) caddc) cc0) cc) $;

--| Proof of ~ cnegex2 without ~ ax-mulcom . (Contributed by SN, 5-May-2024.)
theorem sn_negex2 {b: setvar} (A2: class):
  $ wi (wcel A2 cc) (wrex b (wceq (co (cv b) A2 caddc) cc0) cc) $;

--| ~ addcand without ~ ax-mulcom . Note how the proof is almost identical to ~ addcan . (Contributed by SN, 5-May-2024.)
theorem sn_addcand (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wb (wceq (co A2 B2 caddc) (co A2 C caddc)) (wceq B2 C)) $;

--| ~ addrid without ~ ax-mulcom . (Contributed by SN, 5-May-2024.)
theorem sn_addrid (A2: class):
  $ wi (wcel A2 cc) (wceq (co A2 cc0 caddc) A2) $;

--| ~ addcan2d without ~ ax-mulcom . (Contributed by SN, 5-May-2024.)
theorem sn_addcan2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wb (wceq (co A2 C caddc) (co B2 C caddc)) (wceq A2 B2)) $;

--| ~ ixi without ~ ax-mulcom . (Contributed by SN, 5-May-2024.)
theorem reixi:
  $ wceq (co ci ci cmul) (co cc0 c1 cresub) $;

--| ~ i4 without ~ ax-mulcom . (Contributed by SN, 27-May-2024.)
theorem rei4:
  $ wceq (co (co ci ci cmul) (co ci ci cmul) cmul) c1 $;

--| A number that sums to itself is zero. Compare ~ addid0 , ~ readdridaddlidd . (Contributed by SN, 5-May-2024.)
theorem sn_addid0 (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (co A2 A2 caddc) A2) $ >
  $ wi ph (wceq A2 cc0) $;

--| ~ mul01 without ~ ax-mulcom . (Contributed by SN, 5-May-2024.)
theorem sn_mul01 (A2: class):
  $ wi (wcel A2 cc) (wceq (co A2 cc0 cmul) cc0) $;

--| ~ negeu without ~ ax-mulcom and complex number version of ~ resubeu . (Contributed by SN, 5-May-2024.)
theorem sn_subeu {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wreu x3 (wceq (co A2 (cv x3) caddc) B2) cc) $;

--| ~ subcl without ~ ax-mulcom . (Contributed by SN, 5-May-2024.)
theorem sn_subcl (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wcel (co A2 B2 cmin) cc) $;

--| ~ subf without ~ ax-mulcom . (Contributed by SN, 5-May-2024.)
theorem sn_subf:
  $ wf (cxp cc cc) cc cmin $;

--| Equivalence between real subtraction and subtraction. (Contributed by SN, 5-May-2024.)
theorem resubeqsub (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wceq (co A2 B2 cresub) (co A2 B2 cmin)) $;

--| Subtraction restricted to the reals. (Contributed by SN, 5-May-2024.)
theorem subresre:
  $ wceq cresub (cres cmin (cxp cr cr)) $;

--| A number commutes with its additive inverse. Compare ~ remulinvcom . (Contributed by SN, 5-May-2024.)
theorem addinvcom (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wceq (co A2 B2 caddc) cc0) $ >
  $ wi ph (wceq (co B2 A2 caddc) cc0) $;

--| A left multiplicative inverse is a right multiplicative inverse. Proven without ~ ax-mulcom . (Contributed by SN, 5-Feb-2024.)
theorem remulinvcom (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wceq (co A2 B2 cmul) c1) $ >
  $ wi ph (wceq (co B2 A2 cmul) c1) $;

--| Commuted version of ~ ax-1rid without ~ ax-mulcom . (Contributed by SN, 5-Feb-2024.)
theorem remullid (A2: class):
  $ wi (wcel A2 cr) (wceq (co c1 A2 cmul) A2) $;

--| Lemma for ~ sn-mullid and ~ sn-it1ei . (Contributed by SN, 27-May-2024.)
theorem sn_1ticom:
  $ wceq (co c1 ci cmul) (co ci c1 cmul) $;

--| ~ mullid without ~ ax-mulcom . (Contributed by SN, 27-May-2024.)
theorem sn_mullid (A2: class):
  $ wi (wcel A2 cc) (wceq (co c1 A2 cmul) A2) $;

--| ~ it1ei without ~ ax-mulcom . (See ~ sn-mullid for commuted version). (Contributed by SN, 1-Jun-2024.)
theorem sn_it1ei:
  $ wceq (co ci c1 cmul) ci $;

--| The multiplicative inverse of ` _i ` (per ~ i4 ) is also its additive inverse. (Contributed by SN, 30-Jun-2024.)
theorem ipiiie0:
  $ wceq (co ci (co ci (co ci ci cmul) cmul) caddc) cc0 $;

--| Commuted version of ~ remulcan2d without ~ ax-mulcom . (Contributed by SN, 21-Feb-2024.)
theorem remulcand (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wne C cc0) $ >
  $ wi ph (wb (wceq (co C A2 cmul) (co C B2 cmul)) (wceq A2 B2)) $;

--| Real number division.
term crediv: class;

--| Define division between real numbers. This operator saves ~ ax-mulcom over ~ df-div in certain situations. (Contributed by SN, 25-Nov-2025.)
axiom df_rediv {x3 y1 z: setvar}:
  $ wceq crediv (cmpo x3 y1 cr (cdif cr (csn cc0)) (crio z (wceq (co (cv y1) (cv z) cmul) (cv x3)) cr)) $;

--| Value of real division, which is the (unique) real ` x ` such that ` ( B x. x ) = A ` . (Contributed by SN, 25-Nov-2025.)
theorem redivvald {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wne B2 cc0) $ >
  $ wi ph (wceq (co A2 B2 crediv) (crio x3 (wceq (co B2 (cv x3) cmul) A2) cr)) $;

--| Existential uniqueness of real quotients. (Contributed by SN, 25-Nov-2025.)
theorem rediveud {x3: setvar} (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wne B2 cc0) $ >
  $ wi ph (wreu x3 (wceq (co B2 (cv x3) cmul) A2) cr) $;

--| Closure law for real division. (Contributed by SN, 25-Nov-2025.)
theorem sn_redivcld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wne B2 cc0) $ >
  $ wi ph (wcel (co A2 B2 crediv) cr) $;

--| Relationship between division and multiplication. (Contributed by SN, 25-Nov-2025.)
theorem redivmuld (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wne C cc0) $ >
  $ wi ph (wb (wceq (co A2 C crediv) B2) (wceq (co C B2 cmul) A2)) $;

--| Relationship between division and multiplication. (Contributed by SN, 2-Apr-2026.)
theorem redivmul2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wne C cc0) $ >
  $ wi ph (wb (wceq (co A2 C crediv) B2) (wceq A2 (co C B2 cmul))) $;

--| A cancellation law for division. (Contributed by SN, 25-Nov-2025.)
theorem redivcan2d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wne B2 cc0) $ >
  $ wi ph (wceq (co B2 (co A2 B2 crediv) cmul) A2) $;

--| A cancellation law for division. (Contributed by SN, 25-Nov-2025.)
theorem redivcan3d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wne B2 cc0) $ >
  $ wi ph (wceq (co (co B2 A2 cmul) B2 crediv) A2) $;

--| A ratio is zero iff the numerator is zero. (Contributed by SN, 25-Nov-2025.)
theorem rediveq0d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wne B2 cc0) $ >
  $ wi ph (wb (wceq (co A2 B2 crediv) cc0) (wceq A2 cc0)) $;

--| The ratio of nonzero numbers is nonzero. (Contributed by SN, 2-Apr-2026.)
theorem redivne0bd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wne B2 cc0) $ >
  $ wi ph (wb (wne A2 cc0) (wne (co A2 B2 crediv) cc0)) $;

--| Equality in terms of unit ratio. (Contributed by SN, 2-Apr-2026.)
theorem rediveq1d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wne B2 cc0) $ >
  $ wi ph (wb (wceq (co A2 B2 crediv) c1) (wceq A2 B2)) $;

--| A number divided by 1 is itself. (Contributed by SN, 2-Apr-2026.)
theorem sn_rediv1d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wceq (co A2 c1 crediv) A2) $;

--| Division into zero is zero. (Contributed by SN, 2-Apr-2026.)
theorem sn_rediv0d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wceq (co cc0 A2 crediv) cc0) $;

--| A number divided by itself is 1. (Contributed by SN, 2-Apr-2026.)
theorem sn_redividd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wceq (co A2 A2 crediv) c1) $;

--| Closure law for reciprocal. (Contributed by SN, 25-Nov-2025.)
theorem sn_rereccld (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wcel (co c1 A2 crediv) cr) $;

--| The reciprocal of a nonzero number is nonzero. (Contributed by SN, 4-Apr-2026.)
theorem rerecne0d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wne (co c1 A2 crediv) cc0) $;

--| Multiplication of a number and its reciprocal. (Contributed by SN, 25-Nov-2025.)
theorem rerecidd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wceq (co A2 (co c1 A2 crediv) cmul) c1) $;

--| Multiplication of a number and its reciprocal. (Contributed by SN, 25-Nov-2025.)
theorem rerecid2d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wceq (co (co c1 A2 crediv) A2 cmul) c1) $;

--| A number is equal to the reciprocal of its reciprocal. (Contributed by SN, 2-Apr-2026.)
theorem rerecrecd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wceq (co c1 (co c1 A2 crediv) crediv) A2) $;

--| Relationship between division and reciprocal. (Contributed by SN, 9-Apr-2026.)
theorem redivrec2d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wne B2 cc0) $ >
  $ wi ph (wceq (co A2 B2 crediv) (co (co c1 B2 crediv) A2 cmul)) $;

--| A "commutative"/associative law for division. (Contributed by SN, 9-Apr-2026.)
theorem rediv23d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wne C cc0) $ >
  $ wi ph (wceq (co (co A2 B2 cmul) C crediv) (co (co A2 C crediv) B2 cmul)) $;

--| Distribution of division over addition. (Contributed by SN, 9-Apr-2026.)
theorem redivdird (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wne C cc0) $ >
  $ wi ph (wceq (co (co A2 B2 caddc) C crediv) (co (co A2 C crediv) (co B2 C crediv) caddc)) $;

--| One-to-one relationship for division. (Contributed by SN, 9-Apr-2026.)
theorem rediv11d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wne C cc0) $ >
  $ wi ph (wb (wceq (co A2 C crediv) (co B2 C crediv)) (wceq A2 B2)) $;

--| Lemma for ~ sn-mul02 . Commuted version of ~ sn-it0e0 . (Contributed by SN, 30-Jun-2024.)
theorem sn_0tie0:
  $ wceq (co cc0 ci cmul) cc0 $;

--| ~ mul02 without ~ ax-mulcom . See ~ https://github.com/icecream17/Stuff/blob/main/math/0A%3D0.md for an outline. (Contributed by SN, 30-Jun-2024.)
theorem sn_mul02 (A2: class):
  $ wi (wcel A2 cc) (wceq (co cc0 A2 cmul) cc0) $;

--| ~ ltaddpos without ~ ax-mulcom . (Contributed by SN, 13-Feb-2024.)
theorem sn_ltaddpos (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wb (wbr cc0 A2 clt) (wbr B2 (co B2 A2 caddc) clt)) $;

--| ~ ltaddneg without ~ ax-mulcom . (Contributed by SN, 25-Jan-2025.)
theorem sn_ltaddneg (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wb (wbr A2 cc0 clt) (wbr (co B2 A2 caddc) B2 clt)) $;

--| Comparison of two numbers whose difference is positive. Compare ~ posdif . (Contributed by SN, 13-Feb-2024.)
theorem reposdif (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wb (wbr A2 B2 clt) (wbr cc0 (co B2 A2 cresub) clt)) $;

--| Comparison of a real and its negative to zero. Compare ~ lt0neg1 . (Contributed by SN, 13-Feb-2024.)
theorem relt0neg1 (A2: class):
  $ wi (wcel A2 cr) (wb (wbr A2 cc0 clt) (wbr cc0 (co cc0 A2 cresub) clt)) $;

--| Comparison of a real and its negative to zero. Compare ~ lt0neg2 . (Contributed by SN, 13-Feb-2024.)
theorem relt0neg2 (A2: class):
  $ wi (wcel A2 cr) (wb (wbr cc0 A2 clt) (wbr (co cc0 A2 cresub) cc0 clt)) $;

--| The sum of negative numbers is negative. (Contributed by SN, 25-Jan-2025.)
theorem sn_addlt0d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr A2 cc0 clt) $ >
  $ wi ph (wbr B2 cc0 clt) $ >
  $ wi ph (wbr (co A2 B2 caddc) cc0 clt) $;

--| The sum of positive numbers is positive. Proof of ~ addgt0d without ~ ax-mulcom . (Contributed by SN, 25-Jan-2025.)
theorem sn_addgt0d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr cc0 A2 clt) $ >
  $ wi ph (wbr cc0 B2 clt) $ >
  $ wi ph (wbr cc0 (co A2 B2 caddc) clt) $;

--| ~ nnne0 without ~ ax-mulcom . (Contributed by SN, 25-Jan-2025.)
theorem sn_nnne0 (A2: class):
  $ wi (wcel A2 cn) (wne A2 cc0) $;

--| ~ elznn0nn restated using ~ df-resub . (Contributed by SN, 25-Jan-2025.)
theorem reelznn0nn (N: class):
  $ wb (wcel N cz) (wo (wcel N cn0) (wa (wcel N cr) (wcel (co cc0 N cresub) cn))) $;

--| Addition is commutative for nonnegative integers. Proven without ~ ax-mulcom . (Contributed by SN, 1-Feb-2025.)
theorem nn0addcom (A2 B2: class):
  $ wi (wa (wcel A2 cn0) (wcel B2 cn0)) (wceq (co A2 B2 caddc) (co B2 A2 caddc)) $;

--| Lemma for ~ zaddcom . (Contributed by SN, 1-Feb-2025.)
theorem zaddcomlem (A2 B2: class):
  $ wi (wa (wa (wcel A2 cr) (wcel (co cc0 A2 cresub) cn)) (wcel B2 cn0)) (wceq (co A2 B2 caddc) (co B2 A2 caddc)) $;

--| Addition is commutative for integers. Proven without ~ ax-mulcom . (Contributed by SN, 25-Jan-2025.)
theorem zaddcom (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cz)) (wceq (co A2 B2 caddc) (co B2 A2 caddc)) $;

--| Move multiplication by a natural number inside and outside negation. (Contributed by SN, 25-Jan-2025.)
theorem renegmulnnass (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wceq (co (co cc0 A2 cresub) N cmul) (co cc0 (co A2 N cmul) cresub)) $;

--| Multiplication is commutative for nonnegative integers. Proven without ~ ax-mulcom . (Contributed by SN, 25-Jan-2025.)
theorem nn0mulcom (A2 B2: class):
  $ wi (wa (wcel A2 cn0) (wcel B2 cn0)) (wceq (co A2 B2 cmul) (co B2 A2 cmul)) $;

--| Lemma for ~ zmulcom . (Contributed by SN, 25-Jan-2025.)
theorem zmulcomlem (A2 B2: class):
  $ wi (wa (wa (wcel A2 cr) (wcel (co cc0 A2 cresub) cn)) (wcel B2 cn0)) (wceq (co A2 B2 cmul) (co B2 A2 cmul)) $;

--| Multiplication is commutative for integers. Proven without ~ ax-mulcom . From this result and ~ grpcominv1 , we can show that rationals commute under multiplication without using ~ ax-mulcom . (Contributed by SN, 25-Jan-2025.)
theorem zmulcom (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cz)) (wceq (co A2 B2 cmul) (co B2 A2 cmul)) $;

--| Lemma for ~ mulgt0con1d . Contraposes a positive deduction to a negative deduction. (Contributed by SN, 26-Jun-2024.)
theorem mulgt0con1dlem (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wi (wbr cc0 A2 clt) (wbr cc0 B2 clt)) $ >
  $ wi ph (wi (wceq A2 cc0) (wceq B2 cc0)) $ >
  $ wi ph (wi (wbr B2 cc0 clt) (wbr A2 cc0 clt)) $;

--| Counterpart to ~ mulgt0con2d , though not a lemma. This is the first use of ~ ax-pre-mulgt0 . One direction of ~ mulgt0b2d . (Contributed by SN, 26-Jun-2024.)
theorem mulgt0con1d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr cc0 B2 clt) $ >
  $ wi ph (wbr (co A2 B2 cmul) cc0 clt) $ >
  $ wi ph (wbr A2 cc0 clt) $;

--| Lemma for ~ mulgt0b1d and contrapositive of ~ mulgt0 . (Contributed by SN, 26-Jun-2024.)
theorem mulgt0con2d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr cc0 A2 clt) $ >
  $ wi ph (wbr (co A2 B2 cmul) cc0 clt) $ >
  $ wi ph (wbr B2 cc0 clt) $;

--| Biconditional, deductive form of ~ mulgt0 . The second factor is positive iff the product is. (Contributed by SN, 26-Jun-2024.)
theorem mulgt0b1d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr cc0 A2 clt) $ >
  $ wi ph (wb (wbr cc0 B2 clt) (wbr cc0 (co A2 B2 cmul) clt)) $;

--| ~ ltmul2d without ~ ax-mulcom . (Contributed by SN, 26-Jun-2024.)
theorem sn_ltmul2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wbr cc0 C clt) $ >
  $ wi ph (wb (wbr (co C A2 cmul) (co C B2 cmul) clt) (wbr A2 B2 clt)) $;

--| ~ ltmulgt11d without ~ ax-mulcom . (Contributed by SN, 26-Jun-2024.)
theorem sn_ltmulgt11d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr cc0 B2 clt) $ >
  $ wi ph (wb (wbr c1 A2 clt) (wbr B2 (co B2 A2 cmul) clt)) $;

--| ~ 0lt1 without ~ ax-mulcom . (Contributed by SN, 13-Feb-2024.)
theorem sn_0lt1:
  $ wbr cc0 c1 clt $;

--| ~ ltp1 without ~ ax-mulcom . (Contributed by SN, 13-Feb-2024.)
theorem sn_ltp1 (A2: class):
  $ wi (wcel A2 cr) (wbr A2 (co A2 c1 caddc) clt) $;

--| The reciprocal of a positive real is positive. (Contributed by SN, 26-Nov-2025.)
theorem sn_recgt0d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wbr cc0 A2 clt) $ >
  $ wi ph (wbr cc0 (co c1 A2 crediv) clt) $;

--| Biconditional, deductive form of ~ mulgt0 . The first factor is positive iff the product is. (Contributed by SN, 24-Nov-2025.)
theorem mulgt0b2d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr cc0 B2 clt) $ >
  $ wi ph (wb (wbr cc0 A2 clt) (wbr cc0 (co A2 B2 cmul) clt)) $;

--| ~ mulgt1d without ~ ax-mulcom . (Contributed by SN, 26-Jun-2024.)
theorem sn_mulgt1d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr c1 A2 clt) $ >
  $ wi ph (wbr c1 B2 clt) $ >
  $ wi ph (wbr c1 (co A2 B2 cmul) clt) $;

--| Negative one is a negative number. (Contributed by SN, 1-Jun-2024.)
theorem reneg1lt0:
  $ wbr (co cc0 c1 cresub) cc0 clt $;

--| The reciprocal of a negative real is negative. (Contributed by SN, 26-Nov-2025.)
theorem sn_reclt0d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wbr A2 cc0 clt) $ >
  $ wi ph (wbr (co c1 A2 crediv) cc0 clt) $;

--| Negative times positive is negative. (Contributed by SN, 26-Nov-2025.)
theorem mulltgt0d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr A2 cc0 clt) $ >
  $ wi ph (wbr cc0 B2 clt) $ >
  $ wi ph (wbr (co A2 B2 cmul) cc0 clt) $;

--| When the first term is negative, the second term is positive iff the product is negative. (Contributed by SN, 26-Nov-2025.)
theorem mullt0b1d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr A2 cc0 clt) $ >
  $ wi ph (wb (wbr cc0 B2 clt) (wbr (co A2 B2 cmul) cc0 clt)) $;

--| When the second term is negative, the first term is positive iff the product is negative. (Contributed by SN, 26-Nov-2025.)
theorem mullt0b2d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr B2 cc0 clt) $ >
  $ wi ph (wb (wbr cc0 A2 clt) (wbr (co A2 B2 cmul) cc0 clt)) $;

--| The product of two negative numbers is positive. (Contributed by SN, 1-Dec-2025.)
theorem sn_mullt0d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr A2 cc0 clt) $ >
  $ wi ph (wbr B2 cc0 clt) $ >
  $ wi ph (wbr cc0 (co A2 B2 cmul) clt) $;

--| A nonzero square is positive. (Contributed by SN, 1-Dec-2025.)
theorem sn_msqgt0d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wbr cc0 (co A2 A2 cmul) clt) $;

--| ~ inelr without ~ ax-mulcom . (Contributed by SN, 1-Jun-2024.)
theorem sn_inelr:
  $ wn (wcel ci cr) $;

--| ` _i ` times a real is real iff the real is zero. (Contributed by SN, 27-Jun-2024.)
theorem sn_itrere (R: class):
  $ wi (wcel R cr) (wb (wcel (co ci R cmul) cr) (wceq R cc0)) $;

--| Commuted version of ~ sn-itrere . (Contributed by SN, 27-Jun-2024.)
theorem sn_retire (R: class):
  $ wi (wcel R cr) (wb (wcel (co R ci cmul) cr) (wceq R cc0)) $;

--| The reals in the expression given by ~ cnre uniquely define a complex number. (Contributed by SN, 27-Jun-2024.)
theorem cnreeu {u t s1 r: setvar} (ph: wff u t s1 r):
  $ wi ph (wcel (cv r) cr) $ >
  $ wi ph (wcel (cv s1) cr) $ >
  $ wi ph (wcel (cv t) cr) $ >
  $ wi ph (wcel (cv u) cr) $ >
  $ wi ph (wb (wceq (co (cv r) (co ci (cv s1) cmul) caddc) (co (cv t) (co ci (cv u) cmul) caddc)) (wa (wceq (cv r) (cv t)) (wceq (cv s1) (cv u)))) $;

--| ~ sup2 with exactly the same proof except for using ~ sn-ltp1 instead of ~ ltp1 , saving ~ ax-mulcom . (Contributed by SN, 26-Jun-2024.)
theorem sn_sup2 {x3 y1 z: setvar} (A2: class):
  $ wi (w3a (wss A2 cr) (wne A2 c0) (wrex x3 (wral y1 (wo (wbr (cv y1) (cv x3) clt) (wceq (cv y1) (cv x3))) A2) cr)) (wrex x3 (wa (wral y1 (wn (wbr (cv x3) (cv y1) clt)) A2) (wral y1 (wi (wbr (cv y1) (cv x3) clt) (wrex z (wbr (cv y1) (cv z) clt) A2)) cr)) cr) $;

--| ~ sup3 without ~ ax-mulcom , proven trivially from ~ sn-sup2 . (Contributed by SN, 29-Jun-2025.)
theorem sn_sup3d {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2: class):
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wne A2 c0) $ >
  $ wi ph (wrex x3 (wral y1 (wbr (cv y1) (cv x3) cle) A2) cr) $ >
  $ wi ph (wrex x3 (wa (wral y1 (wn (wbr (cv x3) (cv y1) clt)) A2) (wral y1 (wi (wbr (cv y1) (cv x3) clt) (wrex z (wbr (cv y1) (cv z) clt) A2)) cr)) cr) $;

--| ~ suprcld without ~ ax-mulcom , proven trivially from ~ sn-sup3d . (Contributed by SN, 29-Jun-2025.)
theorem sn_suprcld {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wne A2 c0) $ >
  $ wi ph (wrex x3 (wral y1 (wbr (cv y1) (cv x3) cle) A2) cr) $ >
  $ wi ph (wcel (csup A2 cr clt) cr) $;

--| ~ suprubd without ~ ax-mulcom , proven trivially from ~ sn-suprcld . (Contributed by SN, 29-Jun-2025.)
theorem sn_suprubd {x3 y1: setvar} (ph: wff x3 y1) (A2: class) (B2: class x3 y1):
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wne A2 c0) $ >
  $ wi ph (wrex x3 (wral y1 (wbr (cv y1) (cv x3) cle) A2) cr) $ >
  $ wi ph (wcel B2 A2) $ >
  $ wi ph (wbr B2 (csup A2 cr clt) cle) $;

--| Avoid axioms in ~ base0 by using the discouraged ~ df-base . This kind of axiom save is probably not worth it. (Contributed by SN, 16-Sep-2025.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem sn_base0:
  $ wceq c0 (cfv c0 cbs) $;

--| The inverse of a non-subgroup-member is a non-subgroup-member. (Contributed by Steven Nguyen, 15-Apr-2023.)
theorem nelsubginvcld (ph: wff) (B2 S G N X: class):
  $ wi ph (wcel G cgrp) $ >
  $ wi ph (wcel S (cfv G csubg)) $ >
  $ wi ph (wcel X (cdif B2 S)) $ >
  $ wceq B2 (cfv G cbs) $ >
  $ wceq N (cfv G cminusg) $ >
  $ wi ph (wcel (cfv X N) (cdif B2 S)) $;

--| A non-subgroup-member plus a subgroup member is a non-subgroup-member. (Contributed by Steven Nguyen, 15-Apr-2023.)
theorem nelsubgcld (ph: wff) (B2 c_pl S G X Y: class):
  $ wi ph (wcel G cgrp) $ >
  $ wi ph (wcel S (cfv G csubg)) $ >
  $ wi ph (wcel X (cdif B2 S)) $ >
  $ wceq B2 (cfv G cbs) $ >
  $ wi ph (wcel Y S) $ >
  $ wceq c_pl (cfv G cplusg) $ >
  $ wi ph (wcel (co X Y c_pl) (cdif B2 S)) $;

--| A non-subgroup-member minus a subgroup member is a non-subgroup-member. (Contributed by Steven Nguyen, 15-Apr-2023.)
theorem nelsubgsubcld (ph: wff) (B2 S G c_mi X Y: class):
  $ wi ph (wcel G cgrp) $ >
  $ wi ph (wcel S (cfv G csubg)) $ >
  $ wi ph (wcel X (cdif B2 S)) $ >
  $ wceq B2 (cfv G cbs) $ >
  $ wi ph (wcel Y S) $ >
  $ wceq c_mi (cfv G csg) $ >
  $ wi ph (wcel (co X Y c_mi) (cdif B2 S)) $;

--| The set of injected scalars is also interpretable as the span of the identity. (Contributed by Mario Carneiro, 9-Mar-2015.)
theorem rnasclg (A2 c_1 N W: class):
  $ wceq A2 (cfv W cascl) $ >
  $ wceq c_1 (cfv W cur) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (wa (wcel W clmod) (wcel W crg)) (wceq (crn A2) (cfv (csn c_1) N)) $;

--| The domain of the free module function is a relation. (Contributed by SN, 24-Sep-2026.)
theorem reldmfrlm:
  $ wrel (cdm cfrlm) $;

--| Elements of the free module are functions. (They map an index to the coordinate at that index, see ~ frlmbasf ). (Contributed by SN, 23-Sep-2026.)
theorem frlmbasfn (ph: wff) (B2 R F I W X: class):
  $ wceq F (co R I cfrlm) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wfn X I) $;

--| Closure of scalar multiplication in a free module. (Contributed by SN, 24-Sep-2026.)
theorem frlmvscl (ph: wff) (A2 B2 R c_x F I K X: class):
  $ wceq F (co R I cfrlm) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_x (cfv F cvsca) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel A2 K) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel (co A2 X c_x) B2) $;

--| The vectors of a finite free module are the functions from ` I ` to ` N ` . (Contributed by SN, 31-Aug-2023.)
theorem frlmfielbas (B2 R F I N V X: class):
  $ wceq F (co R I cfrlm) $ >
  $ wceq N (cfv R cbs) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wi (wa (wcel R V) (wcel I cfn)) (wb (wcel X B2) (wf I N X)) $;

--| A vector of a module with indices from 0 to ` N ` is a word over the scalars of the module. (Contributed by SN, 31-Aug-2023.)
theorem frlmfzwrd (B2 S K N W X: class):
  $ wceq W (co K (co cc0 N cfz) cfrlm) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq S (cfv K cbs) $ >
  $ wi (wcel X B2) (wcel X (cword S)) $;

--| A vector of a module with indices from 0 to ` N - 1 ` is a word over the scalars of the module. (Contributed by SN, 31-Aug-2023.)
theorem frlmfzowrd (B2 S K N W X: class):
  $ wceq W (co K (co cc0 N cfzo) cfrlm) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq S (cfv K cbs) $ >
  $ wi (wcel X B2) (wcel X (cword S)) $;

--| The dimension of a vector of a module with indices from 0 to ` N - 1 ` . (Contributed by SN, 1-Sep-2023.)
theorem frlmfzolen (B2 S K N W X: class):
  $ wceq W (co K (co cc0 N cfzo) cfrlm) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq S (cfv K cbs) $ >
  $ wi (wa (wcel N cn0) (wcel X B2)) (wceq (cfv X chash) N) $;

--| The vectors of a module with indices 0 to ` N - 1 ` are the length- ` N ` words over the scalars of the module. (Contributed by SN, 1-Sep-2023.)
theorem frlmfzowrdb (B2 S K N V W X: class):
  $ wceq W (co K (co cc0 N cfzo) cfrlm) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq S (cfv K cbs) $ >
  $ wi (wa (wcel K V) (wcel N cn0)) (wb (wcel X B2) (wa (wcel X (cword S)) (wceq (cfv X chash) N))) $;

--| The concatenation of two vectors of dimension ` N ` and ` M ` forms a vector of dimension ` N + M ` . (Contributed by SN, 31-Aug-2023.)
theorem frlmfzoccat (ph: wff) (B2 C D U K L M N V W X Y Z: class):
  $ wceq W (co K (co cc0 L cfzo) cfrlm) $ >
  $ wceq X (co K (co cc0 M cfzo) cfrlm) $ >
  $ wceq Y (co K (co cc0 N cfzo) cfrlm) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq C (cfv X cbs) $ >
  $ wceq D (cfv Y cbs) $ >
  $ wi ph (wcel K Z) $ >
  $ wi ph (wceq (co M N caddc) L) $ >
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel U C) $ >
  $ wi ph (wcel V D) $ >
  $ wi ph (wcel (co U V cconcat) B2) $;

--| Scalar multiplication distributes over concatenation. (Contributed by SN, 6-Sep-2023.)
theorem frlmvscadiccat (ph: wff) (A2 B2 C D S c_xb c_x U K L M N O V W X Y Z: class):
  $ wceq W (co K (co cc0 L cfzo) cfrlm) $ >
  $ wceq X (co K (co cc0 M cfzo) cfrlm) $ >
  $ wceq Y (co K (co cc0 N cfzo) cfrlm) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq C (cfv X cbs) $ >
  $ wceq D (cfv Y cbs) $ >
  $ wi ph (wcel K Z) $ >
  $ wi ph (wceq (co M N caddc) L) $ >
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel U C) $ >
  $ wi ph (wcel V D) $ >
  $ wceq O (cfv W cvsca) $ >
  $ wceq c_xb (cfv X cvsca) $ >
  $ wceq c_x (cfv Y cvsca) $ >
  $ wceq S (cfv K cbs) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wceq (co A2 (co U V cconcat) O) (co (co A2 U c_xb) (co A2 V c_x) cconcat)) $;

--| An associative cancellation law for groups. (Contributed by SN, 29-Jan-2025.)
theorem grpasscan2d (ph: wff) (B2 c_pl G N X Y: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_pl (cfv G cplusg) $ >
  $ wceq N (cfv G cminusg) $ >
  $ wi ph (wcel G cgrp) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (co (co X (cfv Y N) c_pl) Y c_pl) X) $;

--| If two elements commute, then they commute with each other's inverses (case of the first element commuting with the inverse of the second element). (Contributed by SN, 29-Jan-2025.)
theorem grpcominv1 (ph: wff) (B2 c_pl G N X Y: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_pl (cfv G cplusg) $ >
  $ wceq N (cfv G cminusg) $ >
  $ wi ph (wcel G cgrp) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (co X Y c_pl) (co Y X c_pl)) $ >
  $ wi ph (wceq (co X (cfv Y N) c_pl) (co (cfv Y N) X c_pl)) $;

--| If two elements commute, then they commute with each other's inverses (case of the second element commuting with the inverse of the first element). (Contributed by SN, 1-Feb-2025.)
theorem grpcominv2 (ph: wff) (B2 c_pl G N X Y: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_pl (cfv G cplusg) $ >
  $ wceq N (cfv G cminusg) $ >
  $ wi ph (wcel G cgrp) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (co X Y c_pl) (co Y X c_pl)) $ >
  $ wi ph (wceq (co Y (cfv X N) c_pl) (co (cfv X N) Y c_pl)) $;

--| A submonoid of a finite group is a subgroup. This does not extend to infinite groups, as the submonoid ` NN0 ` of the group ` ( ZZ , + ) ` shows. Note also that the union of a submonoid and its inverses need not be a submonoid, as the submonoid ` ( NN0 \ { 1 } ) ` of the group ` ( ZZ , + ) ` shows: 3 is in that submonoid, -2 is the inverse of 2, but 1 is not in their union. Or simply, the subgroup generated by ` ( NN0 \ { 1 } ) ` is ` ZZ ` , not ` ( ZZ \ { 1 , -u 1 } ) ` . (Contributed by SN, 31-Jan-2025.)
theorem finsubmsubg (ph: wff) (B2 S G: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wi ph (wcel G cgrp) $ >
  $ wi ph (wcel S (cfv G csubmnd)) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wcel S (cfv G csubg)) $;

--| A class is a monoid if and only if its opposite (ring) is a monoid. (Contributed by SN, 20-Jun-2025.)
theorem opprmndb (R O: class):
  $ wceq O (cfv R coppr) $ >
  $ wb (wcel R cmnd) (wcel O cmnd) $;

--| A class is a group if and only if its opposite (ring) is a group. (Contributed by SN, 20-Jun-2025.)
theorem opprgrpb (R O: class):
  $ wceq O (cfv R coppr) $ >
  $ wb (wcel R cgrp) (wcel O cgrp) $;

--| A class is an Abelian group if and only if its opposite (ring) is an Abelian group. (Contributed by SN, 20-Jun-2025.)
theorem opprablb (R O: class):
  $ wceq O (cfv R coppr) $ >
  $ wb (wcel R cabl) (wcel O cabl) $;

--| The image of a commutative ring homomorphism is a commutative ring. (Contributed by SN, 10-Jan-2025.)
theorem imacrhmcl (ph: wff) (C S F M N: class):
  $ wceq C (co N (cima F S) cress) $ >
  $ wi ph (wcel F (co M N crh)) $ >
  $ wi ph (wcel M ccrg) $ >
  $ wi ph (wcel S (cfv M csubrg)) $ >
  $ wi ph (wcel C ccrg) $;

--| Ring isomorphism preserves (multiplicative) commutativity. (Contributed by SN, 10-Jan-2025.)
theorem riccrng1 (R S: class):
  $ wi (wa (wbr R S cric) (wcel R ccrg)) (wcel S ccrg) $;

--| A ring is commutative if and only if an isomorphic ring is commutative. (Contributed by SN, 10-Jan-2025.)
theorem riccrng (R S: class):
  $ wi (wbr R S cric) (wb (wcel R ccrg) (wcel S ccrg)) $;

--| In a domain, a (nonnegative) power of a nonzero element is nonzero. (Contributed by SN, 6-Jul-2024.)
theorem domnexpgn0cl (ph: wff) (B2 R c_ex N X c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_ex (cfv (cfv R cmgp) cmg) $ >
  $ wi ph (wcel R cdomn) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel X (cdif B2 (csn c_0))) $ >
  $ wi ph (wcel (co N X c_ex) (cdif B2 (csn c_0))) $;

--| A multiplicative inverse in a division ring is nonzero. ( ~ recne0d analog). (Contributed by SN, 14-Aug-2024.)
theorem drnginvrn0d (ph: wff) (B2 R I X c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq I (cfv R cinvr) $ >
  $ wi ph (wcel R cdr) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wne X c_0) $ >
  $ wi ph (wne (cfv X I) c_0) $;

--| Cancellation of a nonzero factor on the left for multiplication. ( ~ mulcanad analog). (Contributed by SN, 14-Aug-2024.) (Proof shortened by SN, 25-Jun-2025.)
theorem drngmullcan (ph: wff) (B2 R c_x X Y c_0 Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R cdr) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wne Z c_0) $ >
  $ wi ph (wceq (co Z X c_x) (co Z Y c_x)) $ >
  $ wi ph (wceq X Y) $;

--| Cancellation of a nonzero factor on the right for multiplication. ( ~ mulcan2ad analog). (Contributed by SN, 14-Aug-2024.) (Proof shortened by SN, 25-Jun-2025.)
theorem drngmulrcan (ph: wff) (B2 R c_x X Y c_0 Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R cdr) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wne Z c_0) $ >
  $ wi ph (wceq (co X Z c_x) (co Y Z c_x)) $ >
  $ wi ph (wceq X Y) $;

--| Inverse of a nonzero product. (Contributed by SN, 14-Aug-2024.)
theorem drnginvmuld (ph: wff) (B2 R c_x I X Y c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq I (cfv R cinvr) $ >
  $ wi ph (wcel R cdr) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wne X c_0) $ >
  $ wi ph (wne Y c_0) $ >
  $ wi ph (wceq (cfv (co X Y c_x) I) (co (cfv Y I) (cfv X I) c_x)) $;

--| Zero times a vector is the zero vector. (Contributed by SN, 24-Sep-2026.)
theorem lmod0vsd (ph: wff) (c_x F O V W X c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq O (cfv F c0g) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wceq (co O X c_x) c_0) $;

--| A scalar times the zero vector is the zero vector. (Contributed by SN, 24-Sep-2026.)
theorem lmodvs0d (ph: wff) (c_x F K W X c_0: class):
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X K) $ >
  $ wi ph (wceq (co X c_0 c_x) c_0) $;

--| In a module, scalar multiplication is a semigroup action. (Contributed by SN, 24-Sep-2026.)
theorem lmodvsassd (ph: wff) (Q R c_x c_xp F K V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_xp (cfv F cmulr) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel Q K) $ >
  $ wi ph (wcel R K) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wceq (co (co Q R c_xp) X c_x) (co Q (co R X c_x) c_x)) $;

--| A ring isomorphic to a division ring is a division ring. (Contributed by SN, 18-Feb-2025.)
theorem ricdrng1 (R S: class):
  $ wi (wa (wbr R S cric) (wcel R cdr)) (wcel S cdr) $;

--| A ring is a division ring if and only if an isomorphic ring is a division ring. (Contributed by SN, 18-Feb-2025.)
theorem ricdrng (R S: class):
  $ wi (wbr R S cric) (wb (wcel R cdr) (wcel S cdr)) $;

--| A ring is a field if and only if an isomorphic ring is a field. (Contributed by SN, 18-Feb-2025.)
theorem ricfld (R S: class):
  $ wi (wbr R S cric) (wb (wcel R cfield) (wcel S cfield)) $;

--| Two ways of saying the scalar injection is one-to-one. (Contributed by SN, 3-Jul-2025.)
theorem asclf1 {s1: setvar} (ph: wff s1) (A2 B2 S K N W c_0: class):
  $ wceq A2 (cfv W cascl) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq S (cfv W csca) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq N (cfv S c0g) $ >
  $ wi ph (wcel W crg) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wb (wf1 K B2 A2) (wral s1 (wi (wceq (cfv (cv s1) A2) c_0) (wceq (cv s1) N)) K)) $;

--| Move exponentiation in and out of absolute value. (Contributed by SN, 3-Jul-2025.)
theorem abvexp (ph: wff) (A2 B2 R c_ex F N X: class):
  $ wceq A2 (cfv R cabv) $ >
  $ wceq c_ex (cfv (cfv R cmgp) cmg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel R cnzr) $ >
  $ wi ph (wcel F A2) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (cfv (co N X c_ex) F) (co (cfv X F) N cexp)) $;

--| Lemma for ~ fimgmcyc . (Contributed by SN, 7-Jul-2025.)
theorem fimgmcyclem {o q: setvar} (ph: wff) (A2 c_x: class):
  $ wi ph (wrex o (wrex q (wa (wne (cv o) (cv q)) (wceq (co (cv o) A2 c_x) (co (cv q) A2 c_x))) cn) cn) $ >
  $ wi ph (wrex o (wrex q (wa (wbr (cv o) (cv q) clt) (wceq (co (cv o) A2 c_x) (co (cv q) A2 c_x))) cn) cn) $;

--| Version of ~ odcl2 for finite magmas: the multiples of an element ` A e. B ` are eventually periodic. (Contributed by SN, 3-Jul-2025.)
theorem fimgmcyc {o p: setvar} (ph: wff) (A2: class) (B2: class o p) (c_x: class) (M: class o p):
  $ wceq B2 (cfv M cbs) $ >
  $ wceq c_x (cfv M cmg) $ >
  $ wi ph (wcel M cmgm) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wrex o (wrex p (wceq (co (cv o) A2 c_x) (co (co (cv o) (cv p) caddc) A2 c_x)) cn) cn) $;

--| Version of ~ odcl2 for multiplicative groups of finite domains (that is, a finite monoid where nonzero elements are cancellable): one ( ` .1. ` ) is a multiple of any nonzero element. (Contributed by SN, 3-Jul-2025.)
theorem fidomncyc {n: setvar} (ph: wff n) (A2: class) (B2 R: class n) (c_1 c_ex: class) (c_0: class n):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_ex (cfv (cfv R cmgp) cmg) $ >
  $ wi ph (wcel R cdomn) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wcel A2 (cdif B2 (csn c_0))) $ >
  $ wi ph (wrex n (wceq (co (cv n) A2 c_ex) c_1) cn) $;

--| In a finite domain (a finite field), the only absolute value is the trivial one ( ~ abvtrivg ). (Contributed by SN, 3-Jul-2025.)
theorem fiabv {x3: setvar} (ph: wff) (A2: class x3) (B2 R: class) (T: class x3) (c_0: class):
  $ wceq A2 (cfv R cabv) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq T (cmpt x3 B2 (cif (wceq (cv x3) c_0) cc0 c1)) $ >
  $ wi ph (wcel R cdomn) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wceq A2 (csn T)) $;

--| A vector space is a group. (Contributed by SN, 28-May-2023.)
theorem lvecgrp (W: class):
  $ wi (wcel W clvec) (wcel W cgrp) $;

--| The scalar component of a vector space is a ring. (Contributed by SN, 28-May-2023.)
theorem lvecring (F W: class):
  $ wceq F (cfv W csca) $ >
  $ wi (wcel W clvec) (wcel F crg) $;

--| All coordinates of the zero vector are zero. (Contributed by SN, 14-Aug-2024.)
theorem frlm0vald (ph: wff) (R F I J W c_0: class):
  $ wceq F (co R I cfrlm) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel J I) $ >
  $ wi ph (wceq (cfv J (cfv F c0g)) c_0) $;

--| Given a free module with a singleton as the index set, that is, a free module of one-dimensional vectors, the function that maps each vector to its coordinate is a module isomorphism from that module to its ring of scalars seen as a module. (Contributed by Steven Nguyen, 18-Aug-2023.)
theorem frlmsnic {x3: setvar} (F I K W: class):
  $ wceq W (co K (csn I) cfrlm) $ >
  $ wceq F (cmpt x3 (cfv W cbs) (cfv I (cv x3))) $ >
  $ wi (wa (wcel K crg) (wcel I cvv)) (wcel F (co W (cfv K crglmod) clmim)) $;

--| A unit vector is a vector. (Contributed by Steven Nguyen, 16-Jul-2023.)
theorem uvccl (B2 R U I J W Y: class):
  $ wceq U (co R I cuvc) $ >
  $ wceq Y (co R I cfrlm) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wi (w3a (wcel R crg) (wcel I W) (wcel J I)) (wcel (cfv J U) B2) $;

--| A unit vector is nonzero. (Contributed by Steven Nguyen, 16-Jul-2023.)
theorem uvcn0 (B2 R U I J W Y c_0: class):
  $ wceq U (co R I cuvc) $ >
  $ wceq Y (co R I cfrlm) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wceq c_0 (cfv Y c0g) $ >
  $ wi (w3a (wcel R cnzr) (wcel I W) (wcel J I)) (wne (cfv J U) c_0) $;

--| The ring of power series is a monoid. (Contributed by SN, 25-Apr-2025.)
theorem psrmnd (ph: wff) (R S I V: class):
  $ wceq S (co I R cmps) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R cmnd) $ >
  $ wi ph (wcel S cmnd) $;

--| The composition of a monoid homomorphism and a power series is a power series. (Contributed by SN, 18-May-2025.)
theorem mhmcopsr (ph: wff) (B2 C P Q R S F H I: class):
  $ wceq P (co I R cmps) $ >
  $ wceq Q (co I S cmps) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq C (cfv Q cbs) $ >
  $ wi ph (wcel H (co R S cmhm)) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel (ccom H F) C) $;

--| Show that the ring homomorphism in ~ rhmpsr preserves addition. (Contributed by SN, 18-May-2025.)
theorem mhmcoaddpsr (ph: wff) (B2 C P c_pl c_pb Q R S F G H I: class):
  $ wceq P (co I R cmps) $ >
  $ wceq Q (co I S cmps) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq C (cfv Q cbs) $ >
  $ wceq c_pl (cfv P cplusg) $ >
  $ wceq c_pb (cfv Q cplusg) $ >
  $ wi ph (wcel H (co R S cmhm)) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel G B2) $ >
  $ wi ph (wceq (ccom H (co F G c_pl)) (co (ccom H F) (ccom H G) c_pb)) $;

--| Show that the ring homomorphism in ~ rhmpsr preserves multiplication. (Contributed by SN, 18-May-2025.)
theorem rhmcomulpsr (ph: wff) (B2 C P Q R S c_xb c_x F G H I: class):
  $ wceq P (co I R cmps) $ >
  $ wceq Q (co I S cmps) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq C (cfv Q cbs) $ >
  $ wceq c_x (cfv P cmulr) $ >
  $ wceq c_xb (cfv Q cmulr) $ >
  $ wi ph (wcel H (co R S crh)) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel G B2) $ >
  $ wi ph (wceq (ccom H (co F G c_x)) (co (ccom H F) (ccom H G) c_xb)) $;

--| Provide a ring homomorphism between two power series algebras over their respective base rings given a ring homomorphism between the two base rings. (Contributed by SN, 8-Feb-2025.)
theorem rhmpsr {p: setvar} (ph: wff) (B2 P Q: class) (R S F: class p) (H: class) (I V: class p):
  $ wceq P (co I R cmps) $ >
  $ wceq Q (co I S cmps) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq F (cmpt p B2 (ccom H (cv p))) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel H (co R S crh)) $ >
  $ wi ph (wcel F (co P Q crh)) $;

--| Provide a ring homomorphism between two univariate power series algebras over their respective base rings given a ring homomorphism between the two base rings. (Contributed by SN, 8-Feb-2025.)
theorem rhmpsr1 {p: setvar} (ph: wff) (B2: class) (P Q: class p) (R S: class) (F: class p) (H: class):
  $ wceq P (cfv R cps1) $ >
  $ wceq Q (cfv S cps1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq F (cmpt p B2 (ccom H (cv p))) $ >
  $ wi ph (wcel H (co R S crh)) $ >
  $ wi ph (wcel F (co P Q crh)) $;

--| The zero polynomial evaluates to zero. (Contributed by SN, 23-Nov-2024.)
theorem evl0 (ph: wff) (B2 Q R I O V W c_0: class):
  $ wceq Q (co I R cevl) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq W (co I R cmpl) $ >
  $ wceq O (cfv R c0g) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wceq (cfv c_0 Q) (cxp (co B2 I cmap) (csn O))) $;

--| Polynomial evaluation builder for a bag of variables. EDITORIAL: This theorem should stay in my mathbox until there's another use, since ` .0. ` and ` .1. ` using ` U ` instead of ` S ` may not be convenient. (Contributed by SN, 29-Jul-2024.)
theorem evlsbagval {v h s1: setvar} (ph: wff h) (A2: class h s1) (B2: class) (D: class h) (P Q: class v h s1) (R: class v h) (S: class h s1) (U: class v) (c_1: class v h) (c_ex F: class v h s1) (I: class s1) (K: class h s1) (M V: class v h s1) (W: class s1) (c_0: class v h):
  $ wceq Q (cfv R (co I S ces)) $ >
  $ wceq P (co I U cmpl) $ >
  $ wceq U (co S R cress) $ >
  $ wceq W (cfv P cbs) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq M (cfv S cmgp) $ >
  $ wceq c_ex (cfv M cmg) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq c_1 (cfv U cur) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq F (cmpt s1 D (cif (wceq (cv s1) B2) c_1 c_0)) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel A2 (co K I cmap)) $ >
  $ wi ph (wcel B2 D) $ >
  $ wi ph (wa (wcel F W) (wceq (cfv A2 (cfv F Q)) (co M (cmpt v I (co (cfv (cv v) B2) (cfv (cv v) A2) c_ex)) cgsu))) $;

--| Lemma for theorems using ~ evlvvval . Version of ~ evlsvvvallem2 using ~ df-evl . (Contributed by SN, 11-Mar-2025.)
theorem evlvvvallem {v h b: setvar} (ph: wff h) (A2: class v h b) (B2: class b) (D: class h) (P: class v h b) (R: class) (c_x c_ex: class v h b) (F: class v h) (I: class b) (K: class) (M V: class v h b):
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq P (co I R cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wceq c_ex (cfv M cmg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel A2 (co K I cmap)) $ >
  $ wi ph (wbr (cmpt b D (co (cfv (cv b) F) (co M (cmpt v I (co (cfv (cv v) (cv b)) (cfv (cv v) A2) c_ex)) cgsu) c_x)) (cfv R c0g) cfsupp) $;

--| Lemma for ~ evlselv . Used to re-index to and from bags of variables in ` I ` and bags of variables in the subsets ` J ` and ` I \ J ` . (Contributed by SN, 10-Mar-2025.)
theorem evlselvlem {e f2 g2 h c: setvar} (ph: wff f2 g2 h) (C D E: class f2 g2 h) (H: class e f2 g2 h c) (I: class g2) (J: class h) (V: class e f2 g2 h c):
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq E (crab g2 (wcel (cima (ccnv (cv g2)) cn) cfn) (co cn0 J cmap)) $ >
  $ wceq C (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 (cdif I J) cmap)) $ >
  $ wceq H (cmpo c e C E (cun (cv c) (cv e))) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wss J I) $ >
  $ wi ph (wf1o (cxp C E) D H) $;

--| Evaluating a selection of variable assignments, then evaluating the rest of the variables, is the same as evaluating with all assignments. (Contributed by SN, 10-Mar-2025.)
theorem evlselv (ph: wff) (A2 B2 P R T U F I J K L V: class):
  $ wceq P (co I R cmpl) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq U (co (cdif I J) R cmpl) $ >
  $ wceq T (co J U cmpl) $ >
  $ wceq L (cfv U cascl) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wss J I) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel A2 (co K I cmap)) $ >
  $ wi ph (wceq (cfv (cres A2 (cdif I J)) (cfv (cfv (ccom L (cres A2 J)) (cfv (cfv F (cfv J (co I R cslv))) (co J U cevl))) (co (cdif I J) R cevl))) (cfv A2 (cfv F (co I R cevl)))) $;

--| Induction on functions ` F : A --> B ` with finite support, or in other words the base set of the free module (see ~ frlmelbas and ~ frlmplusgval ). This theorem is structurally general for polynomial proof usage (see ~ mplelbas and ~ mpladd ). Note that hypothesis 0 is redundant when ` I ` is nonempty. (Contributed by SN, 18-May-2024.)
theorem fsuppind {x3 y1 a b: setvar} (ph: wff) (B2: class y1) (c_pl: class a b) (G: class x3 y1 a b) (H I: class) (V X: class x3 y1 a b) (c_0: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wceq c_pl (cfv G cplusg) $ >
  $ wi ph (wcel G cgrp) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel (cxp I (csn c_0)) H) $ >
  $ wi (wa ph (wa (wcel (cv a) I) (wcel (cv b) B2))) (wcel (cmpt x3 I (cif (wceq (cv x3) (cv a)) (cv b) c_0)) H) $ >
  $ wi (wa ph (wa (wcel (cv x3) H) (wcel (cv y1) H))) (wcel (co (cv x3) (cv y1) (cof c_pl)) H) $ >
  $ wi (wa ph (wa (wf I B2 X) (wbr X c_0 cfsupp))) (wcel X H) $;

--| Lemma for ~ fsuppssind . Functions are zero outside of their support. (Contributed by SN, 15-Jul-2024.)
theorem fsuppssindlem1 {x3: setvar} (ph: wff) (B2 S: class x3) (F I: class) (V W c_0: class x3):
  $ wi ph (wcel c_0 W) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wf I B2 F) $ >
  $ wi ph (wss (co F c_0 csupp) S) $ >
  $ wi ph (wceq F (cmpt x3 I (cif (wcel (cv x3) S) (cfv (cv x3) (cres F S)) c_0))) $;

--| Lemma for ~ fsuppssind . Write a function as a union. (Contributed by SN, 15-Jul-2024.)
theorem fsuppssindlem2 {x3 f2: setvar} (ph: wff x3 f2) (B2: class x3) (S F: class) (H: class x3) (I: class) (V W: class x3 f2) (c_0: class):
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wss S I) $ >
  $ wi ph (wb (wcel F (crab f2 (wcel (cmpt x3 I (cif (wcel (cv x3) S) (cfv (cv x3) (cv f2)) c_0)) H) (co B2 S cmap))) (wa (wf S B2 F) (wcel (cun F (cxp (cdif I S) (csn c_0))) H))) $;

--| Induction on functions ` F : A --> B ` with finite support (see ~ fsuppind ) whose supports are subsets of ` S ` . (Contributed by SN, 15-Jun-2024.)
theorem fsuppssind {x3 y1 s1 a b: setvar} (ph: wff) (B2: class x3 y1) (c_pl: class a b) (S: class) (G: class x3 y1 s1 a b) (H I: class) (V X: class x3 y1 s1 a b) (c_0: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wceq c_pl (cfv G cplusg) $ >
  $ wi ph (wcel G cgrp) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wss S I) $ >
  $ wi ph (wcel (cxp I (csn c_0)) H) $ >
  $ wi (wa ph (wa (wcel (cv a) S) (wcel (cv b) B2))) (wcel (cmpt s1 I (cif (wceq (cv s1) (cv a)) (cv b) c_0)) H) $ >
  $ wi (wa ph (wa (wcel (cv x3) H) (wcel (cv y1) H))) (wcel (co (cv x3) (cv y1) (cof c_pl)) H) $ >
  $ wi ph (wf I B2 X) $ >
  $ wi ph (wbr X c_0 cfsupp) $ >
  $ wi ph (wss (co X c_0 csupp) S) $ >
  $ wi ph (wcel X H) $;

--| The homogeneous polynomials of degree ` N ` are generated by the terms of degree ` N ` and addition. (Contributed by SN, 28-Jul-2024.)
theorem mhpind {x3 y1 g2 h s1 a b: setvar} (ph: wff g2 h) (B2: class x3 y1 g2 h) (D: class h) (P: class g2 h) (c_pl: class x3 y1 g2 h s1 a b) (R: class g2 h a b) (S: class x3 y1 g2 h a b) (G H: class g2 h) (I: class x3 y1 g2 s1 a b) (N: class h) (X: class x3 y1 g2 h s1 a b) (c_0: class g2 h):
  $ wceq H (co I R cmhp) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq P (co I R cmpl) $ >
  $ wceq c_pl (cfv P cplusg) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq S (crab g2 (wceq (co (co ccnfld cn0 cress) (cv g2) cgsu) N) D) $ >
  $ wi ph (wcel R cgrp) $ >
  $ wi ph (wcel X (cfv N H)) $ >
  $ wi ph (wcel (cxp D (csn c_0)) G) $ >
  $ wi (wa ph (wa (wcel (cv a) S) (wcel (cv b) B2))) (wcel (cmpt s1 D (cif (wceq (cv s1) (cv a)) (cv b) c_0)) G) $ >
  $ wi (wa ph (wa (wcel (cv x3) (cin (cfv N H) G)) (wcel (cv y1) (cin (cfv N H) G)))) (wcel (co (cv x3) (cv y1) c_pl) G) $ >
  $ wi ph (wcel X G) $;

--| Give a formula for the evaluation of a homogeneous polynomial given assignments from variables to values. The difference between this and ~ evlsvvval is that ` b e. D ` is restricted to ` b e. G ` , that is, we can evaluate an ` N ` -th degree homogeneous polynomial over just the terms where the sum of all variable degrees is ` N ` . (Contributed by SN, 5-Mar-2025.)
theorem evlsmhpvvval {g2 h i b: setvar} (ph: wff g2 h) (A2: class g2 h) (D: class h) (Q: class g2 h i b) (R: class g2 h i) (S: class g2 h) (c_x: class g2 h i b) (U: class g2) (c_ex: class g2 h i b) (F G: class g2 h i) (H: class g2 h i b) (I: class g2) (K: class g2 h) (M: class g2 h i b) (N: class h i b):
  $ wceq Q (cfv R (co I S ces)) $ >
  $ wceq H (co I U cmhp) $ >
  $ wceq U (co S R cress) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq G (crab g2 (wceq (co (co ccnfld cn0 cress) (cv g2) cgsu) N) D) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq M (cfv S cmgp) $ >
  $ wceq c_ex (cfv M cmg) $ >
  $ wceq c_x (cfv S cmulr) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel F (cfv N H)) $ >
  $ wi ph (wcel A2 (co K I cmap)) $ >
  $ wi ph (wceq (cfv A2 (cfv F Q)) (co S (cmpt b G (co (cfv (cv b) F) (co M (cmpt i I (co (cfv (cv i) (cv b)) (cfv (cv i) A2) c_ex)) cgsu) c_x)) cgsu)) $;

--| Lemma for ~ mhphf . Add several multiples of ` L ` together, in a case where the total amount of multiplies is ` N ` . (Contributed by SN, 30-Jul-2024.)
theorem mhphflem {v g2 h: setvar} (ph: wff g2 h) (B2: class v g2 h) (D: class v h) (c_x: class g2 h) (G: class v g2 h) (H: class g2 h) (I: class g2) (L: class g2 h) (N: class v h) (V: class v g2 h) (a: setvar):
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq H (crab g2 (wceq (co (co ccnfld cn0 cress) (cv g2) cgsu) N) D) $ >
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_x (cfv G cmg) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel G cmnd) $ >
  $ wi ph (wcel L B2) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi (wa ph (wcel (cv a) H)) (wceq (co G (cmpt v I (co (cfv (cv v) (cv a)) L c_x)) cgsu) (co N L c_x)) $;

--| A homogeneous polynomial defines a homogeneous function. Equivalently, an algebraic form is a homogeneous function. (An algebraic form is the function corresponding to a homogeneous polynomial, which in this case is the ` ( Q `` X ) ` which corresponds to ` X ` ). (Contributed by SN, 28-Jul-2024.) (Proof shortened by SN, 8-Mar-2025.)
theorem mhphf (ph: wff) (A2 Q R S c_x U c_ex H I K L N X: class):
  $ wceq Q (cfv R (co I S ces)) $ >
  $ wceq H (co I U cmhp) $ >
  $ wceq U (co S R cress) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq c_x (cfv S cmulr) $ >
  $ wceq c_ex (cfv (cfv S cmgp) cmg) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel L R) $ >
  $ wi ph (wcel X (cfv N H)) $ >
  $ wi ph (wcel A2 (co K I cmap)) $ >
  $ wi ph (wceq (cfv (co (cxp I (csn L)) A2 (cof c_x)) (cfv X Q)) (co (co N L c_ex) (cfv A2 (cfv X Q)) c_x)) $;

--| A homogeneous polynomial defines a homogeneous function; this is ~ mhphf with simpler notation in the conclusion in exchange for a complex definition of ` .xb ` , which is based on ~ frlmvscafval but without the finite support restriction ( ~ frlmpws , ~ frlmbas ) on the assignments ` A ` from variables to values. TODO?: Polynomials ( ~ df-mpl ) are defined to have a finite amount of terms (of finite degree). As such, any assignment may be replaced by an assignment with finite support (as only a finite amount of variables matter in a given polynomial, even if the set of variables is infinite). So the finite support restriction can be assumed without loss of generality. (Contributed by SN, 11-Nov-2024.)
theorem mhphf2 (ph: wff) (A2 Q R S c_xb c_x U c_ex H I K L N X: class):
  $ wceq Q (cfv R (co I S ces)) $ >
  $ wceq H (co I U cmhp) $ >
  $ wceq U (co S R cress) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq c_xb (cfv (co (cfv S crglmod) I cpws) cvsca) $ >
  $ wceq c_x (cfv S cmulr) $ >
  $ wceq c_ex (cfv (cfv S cmgp) cmg) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel L R) $ >
  $ wi ph (wcel X (cfv N H)) $ >
  $ wi ph (wcel A2 (co K I cmap)) $ >
  $ wi ph (wceq (cfv (co L A2 c_xb) (cfv X Q)) (co (co N L c_ex) (cfv A2 (cfv X Q)) c_x)) $;

--| A homogeneous polynomial defines a homogeneous function; this is ~ mhphf2 with the finite support restriction ( ~ frlmpws , ~ frlmbas ) on the assignments ` A ` from variables to values. See comment of ~ mhphf2 . (Contributed by SN, 23-Nov-2024.)
theorem mhphf3 (ph: wff) (A2 Q R S c_xb c_x U c_ex F H I K L M N X: class):
  $ wceq Q (cfv R (co I S ces)) $ >
  $ wceq H (co I U cmhp) $ >
  $ wceq U (co S R cress) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq F (co S I cfrlm) $ >
  $ wceq M (cfv F cbs) $ >
  $ wceq c_xb (cfv F cvsca) $ >
  $ wceq c_x (cfv S cmulr) $ >
  $ wceq c_ex (cfv (cfv S cmgp) cmg) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel L R) $ >
  $ wi ph (wcel X (cfv N H)) $ >
  $ wi ph (wcel A2 M) $ >
  $ wi ph (wceq (cfv (co L A2 c_xb) (cfv X Q)) (co (co N L c_ex) (cfv A2 (cfv X Q)) c_x)) $;

--| A homogeneous polynomial defines a homogeneous function; this is ~ mhphf3 with ` evalSub ` collapsed to ` eval ` . (Contributed by SN, 23-Nov-2024.)
theorem mhphf4 (ph: wff) (A2 Q S c_xb c_x c_ex F H I K L M N X: class):
  $ wceq Q (co I S cevl) $ >
  $ wceq H (co I S cmhp) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq F (co S I cfrlm) $ >
  $ wceq M (cfv F cbs) $ >
  $ wceq c_xb (cfv F cvsca) $ >
  $ wceq c_x (cfv S cmulr) $ >
  $ wceq c_ex (cfv (cfv S cmgp) cmg) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel L K) $ >
  $ wi ph (wcel X (cfv N H)) $ >
  $ wi ph (wcel A2 M) $ >
  $ wi ph (wceq (cfv (co L A2 c_xb) (cfv X Q)) (co (co N L c_ex) (cfv A2 (cfv X Q)) c_x)) $;

--| Extend class notation with the projective space function.
term cprjsp: class;

--| Define the projective space function. In the bijection between 3D lines through the origin and points in the projective plane (see section comment), this is equivalent to making any two 3D points (excluding the origin) equivalent iff one is a multiple of another. Note that the meaning of "projective space" is more general than the section comment might suggest. In particular, the projective space obtained from ` RR ` as a ` QQ ` -vector space is infinite-dimensional and is not of the form covered by ~ df-prjspn . Compare ~ df-lsatoms . (Contributed by BJ and SN, 29-Apr-2023.)
axiom df_prjsp {x3 y1 v b l: setvar}:
  $ wceq cprjsp (cmpt v clvec (csb b (cdif (cfv (cv v) cbs) (csn (cfv (cv v) c0g))) (cqs (cv b) (copab x3 y1 (wa (wa (wcel (cv x3) (cv b)) (wcel (cv y1) (cv b))) (wrex l (wceq (cv x3) (co (cv l) (cv y1) (cfv (cv v) cvsca))) (cfv (cfv (cv v) csca) cbs))))))) $;

--| Value of the projective space function, which is also known as the projectivization of ` V ` . (Contributed by Steven Nguyen, 29-Apr-2023.)
theorem prjspval {x3 y1 l: setvar} (B2 S c_x K: class x3 y1 l) (V: class):
  $ wceq B2 (cdif (cfv V cbs) (csn (cfv V c0g))) $ >
  $ wceq c_x (cfv V cvsca) $ >
  $ wceq S (cfv V csca) $ >
  $ wceq K (cfv S cbs) $ >
  $ wi (wcel V clvec) (wceq (cfv V cprjsp) (cqs B2 (copab x3 y1 (wa (wa (wcel (cv x3) B2) (wcel (cv y1) B2)) (wrex l (wceq (cv x3) (co (cv l) (cv y1) c_x)) K))))) $;

--| Utility theorem regarding the relation used in ` PrjSp ` . (Contributed by Steven Nguyen, 29-Apr-2023.)
theorem prjsprel {x3 y1 m l: setvar} (B2: class m l) (c_sm: class x3 y1 m l) (c_x K X Y: class):
  $ wceq c_sm (copab x3 y1 (wa (wa (wcel (cv x3) B2) (wcel (cv y1) B2)) (wrex l (wceq (cv x3) (co (cv l) (cv y1) c_x)) K))) $ >
  $ wb (wbr X Y c_sm) (wa (wa (wcel X B2) (wcel Y B2)) (wrex m (wceq X (co (cv m) Y c_x)) K)) $;

--| The relation in ` PrjSp ` is transitive. (Contributed by Steven Nguyen, 1-May-2023.)
theorem prjspertr {x3 y1 l: setvar} (B2: class l) (c_sm S: class x3 y1 l) (c_x K: class) (V: class x3 y1 l) (X Y Z: class):
  $ wceq c_sm (copab x3 y1 (wa (wa (wcel (cv x3) B2) (wcel (cv y1) B2)) (wrex l (wceq (cv x3) (co (cv l) (cv y1) c_x)) K))) $ >
  $ wceq B2 (cdif (cfv V cbs) (csn (cfv V c0g))) $ >
  $ wceq S (cfv V csca) $ >
  $ wceq c_x (cfv V cvsca) $ >
  $ wceq K (cfv S cbs) $ >
  $ wi (wa (wcel V clmod) (wa (wbr X Y c_sm) (wbr Y Z c_sm))) (wbr X Z c_sm) $;

--| The relation in ` PrjSp ` is reflexive. (Contributed by Steven Nguyen, 30-Apr-2023.)
theorem prjsperref {x3 y1 l: setvar} (B2: class l) (c_sm S: class x3 y1 l) (c_x K: class) (V: class x3 y1 l) (X: class):
  $ wceq c_sm (copab x3 y1 (wa (wa (wcel (cv x3) B2) (wcel (cv y1) B2)) (wrex l (wceq (cv x3) (co (cv l) (cv y1) c_x)) K))) $ >
  $ wceq B2 (cdif (cfv V cbs) (csn (cfv V c0g))) $ >
  $ wceq S (cfv V csca) $ >
  $ wceq c_x (cfv V cvsca) $ >
  $ wceq K (cfv S cbs) $ >
  $ wi (wcel V clmod) (wb (wcel X B2) (wbr X X c_sm)) $;

--| The relation in ` PrjSp ` is symmetric. (Contributed by Steven Nguyen, 1-May-2023.)
theorem prjspersym {x3 y1 l: setvar} (B2: class l) (c_sm S: class x3 y1 l) (c_x K: class) (V: class x3 y1 l) (X Y: class):
  $ wceq c_sm (copab x3 y1 (wa (wa (wcel (cv x3) B2) (wcel (cv y1) B2)) (wrex l (wceq (cv x3) (co (cv l) (cv y1) c_x)) K))) $ >
  $ wceq B2 (cdif (cfv V cbs) (csn (cfv V c0g))) $ >
  $ wceq S (cfv V csca) $ >
  $ wceq c_x (cfv V cvsca) $ >
  $ wceq K (cfv S cbs) $ >
  $ wi (wa (wcel V clvec) (wbr X Y c_sm)) (wbr Y X c_sm) $;

--| The relation used to define ` PrjSp ` is an equivalence relation. (Contributed by Steven Nguyen, 1-May-2023.)
theorem prjsper {x3 y1 l: setvar} (B2: class l) (c_sm S: class x3 y1 l) (c_x K: class) (V: class x3 y1 l):
  $ wceq c_sm (copab x3 y1 (wa (wa (wcel (cv x3) B2) (wcel (cv y1) B2)) (wrex l (wceq (cv x3) (co (cv l) (cv y1) c_x)) K))) $ >
  $ wceq B2 (cdif (cfv V cbs) (csn (cfv V c0g))) $ >
  $ wceq S (cfv V csca) $ >
  $ wceq c_x (cfv V cvsca) $ >
  $ wceq K (cfv S cbs) $ >
  $ wi (wcel V clvec) (wer B2 c_sm) $;

--| Two nonzero vectors are equivalent by a nonzero scalar. (Contributed by Steven Nguyen, 31-May-2023.)
theorem prjspreln0 {x3 y1 m l: setvar} (B2: class l) (c_sm S: class x3 y1 l) (c_x K: class) (V: class x3 y1 l) (X Y: class) (c_0: class x3 y1 l):
  $ wceq c_sm (copab x3 y1 (wa (wa (wcel (cv x3) B2) (wcel (cv y1) B2)) (wrex l (wceq (cv x3) (co (cv l) (cv y1) c_x)) K))) $ >
  $ wceq B2 (cdif (cfv V cbs) (csn (cfv V c0g))) $ >
  $ wceq S (cfv V csca) $ >
  $ wceq c_x (cfv V cvsca) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq c_0 (cfv S c0g) $ >
  $ wi (wcel V clvec) (wb (wbr X Y c_sm) (wa (wa (wcel X B2) (wcel Y B2)) (wrex m (wceq X (co (cv m) Y c_x)) (cdif K (csn c_0))))) $;

--| A nonzero multiple of a vector is equivalent to the vector. (Contributed by Steven Nguyen, 6-Jun-2023.)
theorem prjspvs {x3 y1 l: setvar} (B2: class l) (c_sm S: class x3 y1 l) (c_x K N: class) (V: class x3 y1 l) (X: class) (c_0: class x3 y1 l):
  $ wceq c_sm (copab x3 y1 (wa (wa (wcel (cv x3) B2) (wcel (cv y1) B2)) (wrex l (wceq (cv x3) (co (cv l) (cv y1) c_x)) K))) $ >
  $ wceq B2 (cdif (cfv V cbs) (csn (cfv V c0g))) $ >
  $ wceq S (cfv V csca) $ >
  $ wceq c_x (cfv V cvsca) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq c_0 (cfv S c0g) $ >
  $ wi (w3a (wcel V clvec) (wcel X B2) (wcel N (cdif K (csn c_0)))) (wbr (co N X c_x) X c_sm) $;

--| Two vectors are equivalent iff their spans are equal. (Contributed by Steven Nguyen, 31-May-2023.)
theorem prjsprellsp {x3 y1 l: setvar} (B2: class l) (c_sm S: class x3 y1 l) (c_x K: class) (N V: class x3 y1 l) (X Y: class):
  $ wceq c_sm (copab x3 y1 (wa (wa (wcel (cv x3) B2) (wcel (cv y1) B2)) (wrex l (wceq (cv x3) (co (cv l) (cv y1) c_x)) K))) $ >
  $ wceq B2 (cdif (cfv V cbs) (csn (cfv V c0g))) $ >
  $ wceq S (cfv V csca) $ >
  $ wceq c_x (cfv V cvsca) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq N (cfv V clspn) $ >
  $ wi (wa (wcel V clvec) (wa (wcel X B2) (wcel Y B2))) (wb (wbr X Y c_sm) (wceq (cfv (csn X) N) (cfv (csn Y) N))) $;

--| The vectors equivalent to a vector ` X ` are the nonzero vectors in the span of ` X ` . (Contributed by Steven Nguyen, 6-Jun-2023.)
theorem prjspeclsp {x3 y1 l: setvar} (B2: class) (c_sm: class x3 y1 l) (S: class x3 y1) (c_x K: class) (N V: class y1) (X: class):
  $ wceq c_sm (copab x3 y1 (wa (wa (wcel (cv x3) B2) (wcel (cv y1) B2)) (wrex l (wceq (cv x3) (co (cv l) (cv y1) c_x)) K))) $ >
  $ wceq B2 (cdif (cfv V cbs) (csn (cfv V c0g))) $ >
  $ wceq S (cfv V csca) $ >
  $ wceq c_x (cfv V cvsca) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq N (cfv V clspn) $ >
  $ wi (wa (wcel V clvec) (wcel X B2)) (wceq (cec X c_sm) (cdif (cfv (csn X) N) (csn (cfv V c0g)))) $;

--| Alternate definition of projective space. (Contributed by Steven Nguyen, 7-Jun-2023.)
theorem prjspval2 {z: setvar} (B2: class) (N: class z) (V: class) (c_0: class z):
  $ wceq c_0 (cfv V c0g) $ >
  $ wceq B2 (cdif (cfv V cbs) (csn c_0)) $ >
  $ wceq N (cfv V clspn) $ >
  $ wi (wcel V clvec) (wceq (cfv V cprjsp) (ciun z B2 (csn (cdif (cfv (csn (cv z)) N) (csn c_0))))) $;

--| Extend class notation with the n-dimensional projective space function.
term cprjspn: class;

--| Define the n-dimensional projective space function. A projective space of dimension 1 is a projective line, and a projective space of dimension 2 is a projective plane. Compare ~ df-ehl . This space is considered n-dimensional because the vector space ` ( k freeLMod ( 0 ... n ) ) ` is (n+1)-dimensional and the ` PrjSp ` function returns equivalence classes with respect to a linear (1-dimensional) relation. (Contributed by BJ and Steven Nguyen, 29-Apr-2023.)
axiom df_prjspn {k n: setvar}:
  $ wceq cprjspn (cmpo n k cn0 cdr (cfv (co (cv k) (co cc0 (cv n) cfz) cfrlm) cprjsp)) $;

--| Value of the n-dimensional projective space function. (Contributed by Steven Nguyen, 1-May-2023.)
theorem prjspnval (K N: class):
  $ wi (wa (wcel N cn0) (wcel K cdr)) (wceq (co N K cprjspn) (cfv (co K (co cc0 N cfz) cfrlm) cprjsp)) $;

--| A lemma showing that the equivalence relation used in ~ prjspnval2 and the equivalence relation used in ~ prjspval are equal, but only with the antecedent ` K e. DivRing ` . (Contributed by SN, 15-Jul-2023.)
theorem prjspnerlem {x3 y1 l: setvar} (B2 c_sm: class x3 y1 l) (S: class x3 y1) (c_x: class x3 y1 l) (K: class l) (N: class x3 y1 l) (W: class x3 y1):
  $ wceq c_sm (copab x3 y1 (wa (wa (wcel (cv x3) B2) (wcel (cv y1) B2)) (wrex l (wceq (cv x3) (co (cv l) (cv y1) c_x)) S))) $ >
  $ wceq W (co K (co cc0 N cfz) cfrlm) $ >
  $ wceq B2 (cdif (cfv W cbs) (csn (cfv W c0g))) $ >
  $ wceq S (cfv K cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wi (wcel K cdr) (wceq c_sm (copab x3 y1 (wa (wa (wcel (cv x3) B2) (wcel (cv y1) B2)) (wrex l (wceq (cv x3) (co (cv l) (cv y1) c_x)) (cfv (cfv W csca) cbs))))) $;

--| Value of the n-dimensional projective space function, expanded. (Contributed by SN, 15-Jul-2023.)
theorem prjspnval2 {x3 y1 l: setvar} (ph: wff x3 y1 l) (B2 c_sm: class x3 y1 l) (S: class x3 y1) (c_x: class x3 y1 l) (K: class l) (N: class x3 y1 l) (W: class):
  $ wceq c_sm (copab x3 y1 (wa (wa (wcel (cv x3) B2) (wcel (cv y1) B2)) (wrex l (wceq (cv x3) (co (cv l) (cv y1) c_x)) S))) $ >
  $ wceq W (co K (co cc0 N cfz) cfrlm) $ >
  $ wceq B2 (cdif (cfv W cbs) (csn (cfv W c0g))) $ >
  $ wceq S (cfv K cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel K cdr) $ >
  $ wi ph (wceq (co N K cprjspn) (cqs B2 c_sm)) $;

--| The relation used to define ` PrjSp ` (and indirectly ` PrjSpn ` through ~ df-prjspn ) is an equivalence relation. This is a lemma that converts the equivalence relation used in results like ~ prjspertr and ~ prjspersym (see ~ prjspnerlem ). Several theorems are covered in one thanks to the theorems around ~ df-er . (Contributed by SN, 14-Aug-2023.)
theorem prjspner {x3 y1 l: setvar} (ph: wff x3 y1 l) (B2: class l) (c_sm: class x3 y1 l) (S: class x3 y1) (c_x: class) (K: class l) (N: class x3 y1 l) (W: class):
  $ wceq c_sm (copab x3 y1 (wa (wa (wcel (cv x3) B2) (wcel (cv y1) B2)) (wrex l (wceq (cv x3) (co (cv l) (cv y1) c_x)) S))) $ >
  $ wceq W (co K (co cc0 N cfz) cfrlm) $ >
  $ wceq B2 (cdif (cfv W cbs) (csn (cfv W c0g))) $ >
  $ wceq S (cfv K cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wi ph (wcel K cdr) $ >
  $ wi ph (wer B2 c_sm) $;

--| A nonzero multiple of a vector is equivalent to the vector. This is ~ prjspvs with the equivalence relation converted by ~ prjspnerlem . (Contributed by SN, 8-Aug-2024.)
theorem prjspnvs {x3 y1 l: setvar} (ph: wff x3 y1 l) (B2: class l) (C: class) (c_sm: class x3 y1 l) (S: class x3 y1) (c_x: class) (K: class l) (N: class x3 y1 l) (W X: class) (c_0: class x3 y1 l):
  $ wceq c_sm (copab x3 y1 (wa (wa (wcel (cv x3) B2) (wcel (cv y1) B2)) (wrex l (wceq (cv x3) (co (cv l) (cv y1) c_x)) S))) $ >
  $ wceq W (co K (co cc0 N cfz) cfrlm) $ >
  $ wceq B2 (cdif (cfv W cbs) (csn (cfv W c0g))) $ >
  $ wceq S (cfv K cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_0 (cfv K c0g) $ >
  $ wi ph (wcel K cdr) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel C S) $ >
  $ wi ph (wne C c_0) $ >
  $ wi ph (wbr (co C X c_x) X c_sm) $;

--| A projective space is a set of subsets of the corresponding free module (a set of equivalence classes of nonzero vectors of that module). (Contributed by SN, 17-Jan-2025.)
theorem prjspnssbas (ph: wff) (B2 P K N W: class):
  $ wceq P (co N K cprjspn) $ >
  $ wceq W (co K (co cc0 N cfz) cfrlm) $ >
  $ wceq B2 (cdif (cfv W cbs) (csn (cfv W c0g))) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel K cdr) $ >
  $ wi ph (wss P (cpw B2)) $;

--| A point of a projective space is a subset of the corresponding free module (an equivalence class of nonzero vectors of that module). (Contributed by SN, 23-Sep-2026.)
theorem elprjspnss (ph: wff) (A2 B2 P K N W: class):
  $ wceq P (co N K cprjspn) $ >
  $ wceq W (co K (co cc0 N cfz) cfrlm) $ >
  $ wceq B2 (cdif (cfv W cbs) (csn (cfv W c0g))) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel K cdr) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wss A2 B2) $;

--| A projective point is nonempty. (Contributed by SN, 17-Jan-2025.)
theorem prjspnn0 (ph: wff) (A2 P K N: class):
  $ wceq P (co N K cprjspn) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel K cdr) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wne A2 c0) $;

--| Every nonzero vector of a free module has a nonzero coordinate. (Contributed by SN, 23-Sep-2026.)
theorem frlmnzcoordex {i: setvar} (ph: wff i) (B2: class i) (K N V: class) (W: class i):
  $ wceq W (co K (co cc0 N cfz) cfrlm) $ >
  $ wceq B2 (cdif (cfv W cbs) (csn (cfv W c0g))) $ >
  $ wi ph (wcel K crg) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel V B2) $ >
  $ wi ph (wne (crab i (wne (cfv (cv i) V) (cfv K c0g)) (co cc0 N cfz)) c0) $;

--| Value of ` J ` , a function that returns the index of the first nonzero coordinate of ` V ` . (Contributed by SN, 23-Sep-2026.)
theorem frlmnzcoordval {i b: setvar} (ph: wff i b) (B2: class i) (J: class i b) (K N: class i) (V: class):
  $ wceq J (cmpt b B2 (cinf (crab i (wne (cfv (cv i) (cv b)) (cfv K c0g)) (co cc0 N cfz)) cr clt)) $ >
  $ wi ph (wcel V B2) $ >
  $ wi ph (wceq (cfv V J) (cinf (crab i (wne (cfv (cv i) V) (cfv K c0g)) (co cc0 N cfz)) cr clt)) $;

--| The result ` ( J `` V ) ` is the smallest index corresponding to a nonzero coordinate. (Contributed by SN, 23-Sep-2026.)
theorem frlmnzcoordinf {i b: setvar} (ph: wff i b) (B2: class i) (I J: class i b) (K: class i) (N V: class):
  $ wceq J (cmpt b B2 (cinf (crab i (wne (cfv (cv i) (cv b)) (cfv K c0g)) (co cc0 N cfz)) cr clt)) $ >
  $ wi ph (wcel V B2) $ >
  $ wi (wa ph (wcel I (crab i (wne (cfv (cv i) V) (cfv K c0g)) (co cc0 N cfz)))) (wbr (cfv V J) I cle) $;

--| Closure of the first nonzero coordinate function ` J ` . (Contributed by SN, 23-Sep-2026.)
theorem frlmnzcoordcl {i b: setvar} (ph: wff i b) (B2: class i) (J: class i b) (K N V: class) (W: class i b):
  $ wceq J (cmpt b B2 (cinf (crab i (wne (cfv (cv i) (cv b)) (cfv K c0g)) (co cc0 N cfz)) cr clt)) $ >
  $ wceq W (co K (co cc0 N cfz) cfrlm) $ >
  $ wceq B2 (cdif (cfv W cbs) (csn (cfv W c0g))) $ >
  $ wi ph (wcel K crg) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel V B2) $ >
  $ wi ph (wcel (cfv V J) (co cc0 N cfz)) $;

--| The first nonzero coordinate is a scalar. (Contributed by SN, 24-Sep-2026.)
theorem frlmnzcoordcl2 {i b: setvar} (ph: wff i b) (B2: class i) (S J: class i b) (K N V: class) (W: class i b):
  $ wceq J (cmpt b B2 (cinf (crab i (wne (cfv (cv i) (cv b)) (cfv K c0g)) (co cc0 N cfz)) cr clt)) $ >
  $ wceq W (co K (co cc0 N cfz) cfrlm) $ >
  $ wceq B2 (cdif (cfv W cbs) (csn (cfv W c0g))) $ >
  $ wi ph (wcel K crg) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel V B2) $ >
  $ wceq S (cfv K cbs) $ >
  $ wi ph (wcel (cfv (cfv V J) V) S) $;

--| The function ` J ` gives a nonzero coordinate. (Contributed by SN, 23-Sep-2026.)
theorem frlmnzcoordn0 {i b: setvar} (ph: wff i b) (B2: class i) (J: class b) (K N V: class) (W: class i b):
  $ wceq J (cmpt b B2 (cinf (crab i (wne (cfv (cv i) (cv b)) (cfv K c0g)) (co cc0 N cfz)) cr clt)) $ >
  $ wceq W (co K (co cc0 N cfz) cfrlm) $ >
  $ wceq B2 (cdif (cfv W cbs) (csn (cfv W c0g))) $ >
  $ wi ph (wcel K crg) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel V B2) $ >
  $ wi ph (wne (cfv (cfv V J) V) (cfv K c0g)) $;

--| In a free module, scaling a vector does not change the index of its first nonzero coordinate. (Contributed by SN, 24-Sep-2026.)
theorem frlmnzcoordsca {i b: setvar} (ph: wff b) (B2: class i) (C: class) (S: class i b) (c_x: class) (J: class i b) (K N V: class) (W c_0: class i b):
  $ wceq J (cmpt b B2 (cinf (crab i (wne (cfv (cv i) (cv b)) (cfv K c0g)) (co cc0 N cfz)) cr clt)) $ >
  $ wceq W (co K (co cc0 N cfz) cfrlm) $ >
  $ wceq B2 (cdif (cfv W cbs) (csn (cfv W c0g))) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_0 (cfv K c0g) $ >
  $ wceq S (cfv K cbs) $ >
  $ wi ph (wcel K cdr) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel V B2) $ >
  $ wi ph (wcel C S) $ >
  $ wi ph (wne C c_0) $ >
  $ wi ph (wceq (cfv (co C V c_x) J) (cfv V J)) $;

--| Value of ` F ` , a function that 'normalizes' a vector ` V ` by scaling the first nonzero coordinate to 1. (Contributed by SN, 24-Sep-2026.)
theorem prjspnnormval {v: setvar} (ph: wff v) (B2 c_x: class) (F: class v) (I J V: class):
  $ wceq F (cmpt v B2 (co (cfv (cfv (cfv (cv v) J) (cv v)) I) (cv v) c_x)) $ >
  $ wi ph (wcel V B2) $ >
  $ wi ph (wceq (cfv V F) (co (cfv (cfv (cfv V J) V) I) V c_x)) $;

--| In a free module, a nonzero vector is equivalent to its normalized vector. (Contributed by SN, 24-Sep-2026.)
theorem prjspnequivnorm {x3 y1 v i b l: setvar} (ph: wff x3 y1 v i b l) (B2: class i l) (c_sm: class x3 y1 v i b l) (S: class x3 y1 v i b) (c_x: class i b) (F: class x3 y1 v i b l) (I: class i b) (J: class b) (K: class v l) (N: class x3 y1 v l) (W: class v i b) (X: class):
  $ wceq c_sm (copab x3 y1 (wa (wa (wcel (cv x3) B2) (wcel (cv y1) B2)) (wrex l (wceq (cv x3) (co (cv l) (cv y1) c_x)) S))) $ >
  $ wceq J (cmpt b B2 (cinf (crab i (wne (cfv (cv i) (cv b)) (cfv K c0g)) (co cc0 N cfz)) cr clt)) $ >
  $ wceq F (cmpt v B2 (co (cfv (cfv (cfv (cv v) J) (cv v)) I) (cv v) c_x)) $ >
  $ wceq W (co K (co cc0 N cfz) cfrlm) $ >
  $ wceq B2 (cdif (cfv W cbs) (csn (cfv W c0g))) $ >
  $ wceq S (cfv K cbs) $ >
  $ wceq I (cfv K cinvr) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wi ph (wcel K cdr) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wbr X (cfv X F) c_sm) $;

--| In a free module, two nonzero vectors are equivalent iff they have the same normalized representative. (Contributed by SN, 24-Sep-2026.)
theorem prjspnnorm {x3 y1 v i b l: setvar} (ph: wff v b l) (B2: class i l) (c_sm: class x3 y1 v i b l) (S: class x3 y1 v b) (c_x: class) (F: class x3 y1 v i b l) (I: class i b) (J: class b) (K: class v l) (N: class x3 y1 v l) (W: class v i b) (X Y: class):
  $ wceq c_sm (copab x3 y1 (wa (wa (wcel (cv x3) B2) (wcel (cv y1) B2)) (wrex l (wceq (cv x3) (co (cv l) (cv y1) c_x)) S))) $ >
  $ wceq J (cmpt b B2 (cinf (crab i (wne (cfv (cv i) (cv b)) (cfv K c0g)) (co cc0 N cfz)) cr clt)) $ >
  $ wceq F (cmpt v B2 (co (cfv (cfv (cfv (cv v) J) (cv v)) I) (cv v) c_x)) $ >
  $ wceq W (co K (co cc0 N cfz) cfrlm) $ >
  $ wceq B2 (cdif (cfv W cbs) (csn (cfv W c0g))) $ >
  $ wceq S (cfv K cbs) $ >
  $ wceq I (cfv K cinvr) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wi ph (wcel K cdr) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wb (wbr X Y c_sm) (wceq (cfv X F) (cfv Y F))) $;

--| Lemma for ~ 0prjspn . The given unit vector is a nonzero vector. (Contributed by Steven Nguyen, 16-Jul-2023.)
theorem _0prjspnlem (B2 c_1 K W: class):
  $ wceq B2 (cdif (cfv W cbs) (csn (cfv W c0g))) $ >
  $ wceq W (co K (co cc0 cc0 cfz) cfrlm) $ >
  $ wceq c_1 (cfv cc0 (co K (co cc0 cc0 cfz) cuvc)) $ >
  $ wi (wcel K cdr) (wcel c_1 B2) $;

--| In a zero-dimensional projective space, all vectors are equivalent to the unit vector. (Contributed by Steven Nguyen, 7-Jun-2023.)
theorem _0prjspnrel {x3 y1 l: setvar} (B2: class l) (c_sm: class x3 y1 l) (S c_x c_1 K: class) (W: class x3 y1 l) (X: class):
  $ wceq c_sm (copab x3 y1 (wa (wa (wcel (cv x3) B2) (wcel (cv y1) B2)) (wrex l (wceq (cv x3) (co (cv l) (cv y1) c_x)) S))) $ >
  $ wceq B2 (cdif (cfv W cbs) (csn (cfv W c0g))) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq S (cfv K cbs) $ >
  $ wceq W (co K (co cc0 cc0 cfz) cfrlm) $ >
  $ wceq c_1 (cfv cc0 (co K (co cc0 cc0 cfz) cuvc)) $ >
  $ wi (wa (wcel K cdr) (wcel X B2)) (wbr X c_1 c_sm) $;

--| A zero-dimensional projective space has only 1 point. (Contributed by SN, 9-Jun-2023.)
theorem _0prjspn (B2 K W: class):
  $ wceq W (co K (co cc0 cc0 cfz) cfrlm) $ >
  $ wceq B2 (cdif (cfv W cbs) (csn (cfv W c0g))) $ >
  $ wi (wcel K cdr) (wceq (co cc0 K cprjspn) (csn B2)) $;

--| Extend class notation with the projective curve function.
term cprjcrv: class;

--| Define the projective curve function. This takes a homogeneous polynomial and outputs the homogeneous coordinates where the polynomial evaluates to zero (the "zero set"). (In other words, scalar multiples are collapsed into the same projective point. See ~ mhphf4 and ~ prjspvs ). (Contributed by SN, 23-Nov-2024.)
axiom df_prjcrv {f2 k n p: setvar}:
  $ wceq cprjcrv (cmpo n k cn0 cfield (cmpt f2 (cuni (crn (co (co cc0 (cv n) cfz) (cv k) cmhp))) (crab p (wceq (cima (cfv (cv f2) (co (co cc0 (cv n) cfz) (cv k) cevl)) (cv p)) (csn (cfv (cv k) c0g))) (co (cv n) (cv k) cprjspn)))) $;

--| Value of the projective curve function. (Contributed by SN, 23-Nov-2024.)
theorem prjcrvfval {f2 p: setvar} (ph: wff f2 p) (P: class f2) (E: class f2 p) (H: class p) (K N: class) (c_0: class f2 p):
  $ wceq H (co (co cc0 N cfz) K cmhp) $ >
  $ wceq E (co (co cc0 N cfz) K cevl) $ >
  $ wceq P (co N K cprjspn) $ >
  $ wceq c_0 (cfv K c0g) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel K cfield) $ >
  $ wi ph (wceq (co N K cprjcrv) (cmpt f2 (cuni (crn H)) (crab p (wceq (cima (cfv (cv f2) E) (cv p)) (csn c_0)) P))) $;

--| Value of the projective curve function. (Contributed by SN, 23-Nov-2024.)
theorem prjcrvval {p: setvar} (ph: wff p) (P: class) (E: class p) (F: class) (H: class p) (K N: class) (c_0: class p):
  $ wceq H (co (co cc0 N cfz) K cmhp) $ >
  $ wceq E (co (co cc0 N cfz) K cevl) $ >
  $ wceq P (co N K cprjspn) $ >
  $ wceq c_0 (cfv K c0g) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel K cfield) $ >
  $ wi ph (wcel F (cuni (crn H))) $ >
  $ wi ph (wceq (cfv F (co N K cprjcrv)) (crab p (wceq (cima (cfv F E) (cv p)) (csn c_0)) P)) $;

--| The "curve" (zero set) corresponding to the zero polynomial contains all coordinates. (Contributed by SN, 23-Nov-2024.)
theorem prjcrv0 (ph: wff) (P K N Y c_0: class):
  $ wceq Y (co (co cc0 N cfz) K cmpl) $ >
  $ wceq c_0 (cfv Y c0g) $ >
  $ wceq P (co N K cprjspn) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel K cfield) $ >
  $ wi ph (wceq (cfv c_0 (co N K cprjcrv)) P) $;

--| Fermat's Last Theorem (FLT) for nonzero integers is equivalent to the original scope of natural numbers. The backwards direction takes ` ( a ^ n ) + ( b ^ n ) = ( c ^ n ) ` , and adds the negative of any negative term to both sides, thus creating the corresponding equation with only positive integers. There are six combinations of negativity, so the proof is particularly long. (Contributed by Steven Nguyen, 27-Feb-2023.)
theorem dffltz {x3 y1 z n a b c: setvar}:
  $ wb (wral n (wral x3 (wral y1 (wral z (wne (co (co (cv x3) (cv n) cexp) (co (cv y1) (cv n) cexp) caddc) (co (cv z) (cv n) cexp)) cn) cn) cn) (cfv c3 cuz)) (wral n (wral a (wral b (wral c (wne (co (co (cv a) (cv n) cexp) (co (cv b) (cv n) cexp) caddc) (co (cv c) (cv n) cexp)) (cdif cz (csn cc0))) (cdif cz (csn cc0))) (cdif cz (csn cc0))) (cfv c3 cuz)) $;

--| A counterexample to FLT stays valid when scaled. The hypotheses are more general than they need to be for convenience. (There does not seem to be a standard term for Fermat or Pythagorean triples extended to any ` N e. NN0 ` , so the label is more about the context in which this theorem is used). (Contributed by SN, 20-Aug-2024.)
theorem fltmul (ph: wff) (A2 B2 C S N: class):
  $ wi ph (wcel S cc) $ >
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (co (co A2 N cexp) (co B2 N cexp) caddc) (co C N cexp)) $ >
  $ wi ph (wceq (co (co (co S A2 cmul) N cexp) (co (co S B2 cmul) N cexp) caddc) (co (co S C cmul) N cexp)) $;

--| ` ( C ^ N ) ` is the largest term and therefore ` B < C ` . (Contributed by Steven Nguyen, 22-Aug-2023.)
theorem fltltc (ph: wff) (A2 B2 C N: class):
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wcel C cn) $ >
  $ wi ph (wcel N (cfv c3 cuz)) $ >
  $ wi ph (wceq (co (co A2 N cexp) (co B2 N cexp) caddc) (co C N cexp)) $ >
  $ wi ph (wbr B2 C clt) $;

--| Lemma for ~ fltnlta . A lower bound for ` A ` based on ~ pwdif . (Contributed by Steven Nguyen, 22-Aug-2023.)
theorem fltnltalem (ph: wff) (A2 B2 C N: class):
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wcel C cn) $ >
  $ wi ph (wcel N (cfv c3 cuz)) $ >
  $ wi ph (wceq (co (co A2 N cexp) (co B2 N cexp) caddc) (co C N cexp)) $ >
  $ wi ph (wbr (co (co C B2 cmin) (co (co C (co N c1 cmin) cexp) (co (co N c1 cmin) (co B2 (co N c1 cmin) cexp) cmul) caddc) cmul) (co A2 N cexp) clt) $;

--| In a Fermat counterexample, the exponent ` N ` is less than all three numbers ( ` A ` , ` B ` , and ` C ` ). Note that ` A < B ` (hypothesis) and ` B < C ` ( ~ fltltc ). See ~ https://youtu.be/EymVXkPWxyc for an outline. (Contributed by SN, 24-Aug-2023.)
theorem fltnlta (ph: wff) (A2 B2 C N: class):
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wcel C cn) $ >
  $ wi ph (wcel N (cfv c3 cuz)) $ >
  $ wi ph (wceq (co (co A2 N cexp) (co B2 N cexp) caddc) (co C N cexp)) $ >
  $ wi ph (wbr A2 B2 clt) $ >
  $ wi ph (wbr N A2 clt) $;

--| Version of ~ a1ii with the hypotheses switched. The first hypothesis is redundant so this theorem should not normally appear in a proof. Inference associated with ~ idd . (Contributed by SN, 1-Apr-2025.) (New usage is discouraged.)
theorem iddii (ph ps: wff):
  $ ph $ >
  $ ps $ >
  $ ps $;

--| Alternate proof of ~ bicomd which is shorter after expanding all parent theorems (as of 8-Aug-2024, ~ bicom depends on ~ bicom1 and ~ sylib depends on ~ syl ). Additionally, the labels ~ bicom1 and ~ syl happen to contain fewer characters than ~ bicom and ~ sylib . However, neither of these conditions count as a shortening according to ~ conventions . In the first case, the criteria could easily be broken by upstream changes, and in many cases the upstream dependency tree is nontrivial (see ~ orass and ~ pm2.31 ). For the latter case, theorem labels are up to revision, so they are not counted in the size of a proof. (Contributed by SN, 21-May-2022.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem bicomdALT (ph ps ch: wff):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb ch ps) $;

--| Alias for ~ 19.26 for easier lookup. (Contributed by SN, 12-Aug-2025.) (New usage is discouraged.)
theorem alan {x3: setvar} (ph ps: wff x3):
  $ wb (wal x3 (wa ph ps)) (wa (wal x3 ph) (wal x3 ps)) $;

--| Alias for ~ 19.43 for easier lookup. (Contributed by SN, 5-Jul-2025.) (New usage is discouraged.)
theorem exor {x3: setvar} (ph ps: wff x3):
  $ wb (wex x3 (wo ph ps)) (wo (wex x3 ph) (wex x3 ps)) $;

--| Alias for ~ r19.43 for easier lookup. (Contributed by SN, 5-Jul-2025.) (New usage is discouraged.)
theorem rexor {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb (wrex x3 (wo ph ps) A2) (wo (wrex x3 ph A2) (wrex x3 ps A2)) $;

--| Alternate proof of ~ ruv with one fewer syntax step thanks to using ~ elirrv instead of ~ elirr . However, it does not change the compressed proof size or the number of symbols in the generated display, so it is not considered a shortening according to ~ conventions . (Contributed by SN, 1-Sep-2024.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem ruvALT {x3: setvar}:
  $ wceq (cab x3 (wnel (cv x3) (cv x3))) cvv $;

--| 45 squared is 2025. (Contributed by SN, 30-Mar-2025.)
theorem sq45:
  $ wceq (co (cdc c4 c5) c2 cexp) (cdc (cdc (cdc c2 cc0) c2) c5) $;

--| The sum of the first nine perfect cubes is 2025. (Contributed by SN, 30-Mar-2025.)
theorem sum9cubes {k: setvar}:
  $ wceq (csu k (co c1 c9 cfz) (co (cv k) c3 cexp)) (cdc (cdc (cdc c2 cc0) c2) c5) $;

--| Longer proof of ~ isghm , unsuccessfully attempting to simplify ~ isghm using ~ elovmpo according to an editorial note (now removed). (Contributed by SN, 7-Jun-2025.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem sn_isghm {v u: setvar} (c_pl c_pd S T F X Y: class):
  $ wceq X (cfv S cbs) $ >
  $ wceq Y (cfv T cbs) $ >
  $ wceq c_pl (cfv S cplusg) $ >
  $ wceq c_pd (cfv T cplusg) $ >
  $ wb (wcel F (co S T cghm)) (wa (wa (wcel S cgrp) (wcel T cgrp)) (wa (wf X Y F) (wral u (wral v (wceq (cfv (co (cv u) (cv v) c_pl) F) (co (cfv (cv u) F) (cfv (cv v) F) c_pd)) X) X))) $;

--| An abuse of notation. (Contributed by Prof. Loof Lirpa, 1-Apr-2025.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem aprilfools2025 (A2: class) (f2 i o s1 r p l: setvar):
  $ wcel (cpr (cs5 A2 (cv p) (cv r) (cv i) (cv l)) (cs6 (cv f2) (cv o) (cv o) (cv l) (cv s1) cfa)) cvv $;

--| Replace ~ ax-10 in ~ nfa1 with a substitution hypothesis. (Contributed by SN, 2-Sep-2025.)
theorem nfa1w {x3 y1: setvar} (ph: wff x3) (ps: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wnf x3 (wal x3 ph) $;

--| Replace ~ ax-10 , ~ ax-12 in ~ eu6 with substitution hypotheses. (Contributed by SN, 27-May-2025.)
theorem eu6w {x3 y1 z: setvar} (ph: wff x3) (ps th: wff y1 z):
  $ wi (wceq (cv x3) (cv z)) (wb ph ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph th) $ >
  $ wb (weu x3 ph) (wex y1 (wal x3 (wb ph (wceq (cv x3) (cv y1))))) $;

--| Replace ~ ax-10 , ~ ax-11 , ~ ax-12 in ~ abbib with substitution hypotheses. (Contributed by SN, 27-May-2025.)
theorem abbibw {x3 y1: setvar} (ph ps: wff x3) (ch th: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph th) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ps ch) $ >
  $ wb (wceq (cab x3 ph) (cab x3 ps)) (wal x3 (wb ph ps)) $;

--| Replace ~ ax-10 , ~ ax-11 , ~ ax-12 in ~ absn with a substitution hypothesis. (Contributed by SN, 27-May-2025.)
theorem absnw {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (Y: class):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wceq (cab x3 ph) (csn Y)) (wal x3 (wb ph (wceq (cv x3) Y))) $;

--| Replace ~ ax-10 , ~ ax-11 , ~ ax-12 in ~ euabsn2 with substitution hypotheses. (Contributed by SN, 27-May-2025.)
theorem euabsn2w {x3 y1 z: setvar} (ph: wff x3) (ps th: wff y1 z):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wceq (cv x3) (cv z)) (wb ph th) $ >
  $ wb (weu x3 ph) (wex y1 (wceq (cab x3 ph) (csn (cv y1)))) $;

--| Cube of sum of three numbers. (Contributed by Igor Ieskov, 14-Dec-2023.)
theorem cu3addd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wceq (co (co (co A2 B2 caddc) C caddc) c3 cexp) (co (co (co (co (co A2 c3 cexp) (co c3 (co (co A2 c2 cexp) B2 cmul) cmul) caddc) (co (co c3 (co A2 (co B2 c2 cexp) cmul) cmul) (co B2 c3 cexp) caddc) caddc) (co (co (co c3 (co (co A2 c2 cexp) C cmul) cmul) (co (co (co c3 c2 cmul) (co A2 B2 cmul) cmul) C cmul) caddc) (co c3 (co (co B2 c2 cexp) C cmul) cmul) caddc) caddc) (co (co (co c3 (co A2 (co C c2 cexp) cmul) cmul) (co c3 (co B2 (co C c2 cexp) cmul) cmul) caddc) (co C c3 cexp) caddc) caddc)) $;

--| The sum of a real number to the power of N and the negative of the number to the power of N equals zero if N is a nonnegative odd integer. (Contributed by Igor Ieskov, 21-Jan-2024.)
theorem negexpidd (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wn (wbr c2 N cdvds)) $ >
  $ wi ph (wceq (co (co A2 N cexp) (co (cneg A2) N cexp) caddc) cc0) $;

--| An extended version of ~ rexlimdvv to include three set variables. (Contributed by Igor Ieskov, 21-Jan-2024.)
theorem rexlimdv3d {x3 y1 z: setvar} (ph: wff) (ps: wff x3 y1 z) (ch: wff) (A2: class x3) (B2: class x3 y1) (C: class x3 y1 z):
  $ wi ph (wi (w3a (wcel (cv x3) A2) (wcel (cv y1) B2) (wcel (cv z) C)) (wi ps ch)) $ >
  $ wi ph (wi (wrex x3 (wrex y1 (wrex z ps C) B2) A2) ch) $;

--| Lemma for ~ 3cubes . (Contributed by Igor Ieskov, 22-Jan-2024.)
theorem _3cubeslem1 (ph: wff) (A2: class):
  $ wi ph (wcel A2 cq) $ >
  $ wi ph (wbr cc0 (co (co (co A2 c1 caddc) c2 cexp) A2 cmin) clt) $;

--| Lemma for ~ 3cubes . Used to show that the denominators in ~ 3cubeslem4 are nonzero. (Contributed by Igor Ieskov, 22-Jan-2024.)
theorem _3cubeslem2 (ph: wff) (A2: class):
  $ wi ph (wcel A2 cq) $ >
  $ wi ph (wn (wceq (co (co (co (co c3 c3 cexp) (co A2 c2 cexp) cmul) (co (co c3 c2 cexp) A2 cmul) caddc) c3 caddc) cc0)) $;

--| Lemma for ~ 3cubes . (Contributed by Igor Ieskov, 22-Jan-2024.)
theorem _3cubeslem3l (ph: wff) (A2: class):
  $ wi ph (wcel A2 cq) $ >
  $ wi ph (wceq (co A2 (co (co (co (co (co c3 c3 cexp) (co A2 c2 cexp) cmul) (co (co c3 c2 cexp) A2 cmul) caddc) c3 caddc) c3 cexp) cmul) (co (co (co A2 c7 cexp) (co c3 c9 cexp) cmul) (co (co (co A2 c6 cexp) (co c3 c9 cexp) cmul) (co (co (co A2 c5 cexp) (co (co c3 c8 cexp) (co c3 c8 cexp) caddc) cmul) (co (co (co A2 c4 cexp) (co (co (co c3 c7 cexp) c2 cmul) (co c3 c6 cexp) caddc) cmul) (co (co (co A2 c3 cexp) (co (co c3 c6 cexp) (co c3 c6 cexp) caddc) cmul) (co (co (co A2 c2 cexp) (co c3 c5 cexp) cmul) (co A2 (co c3 c3 cexp) cmul) caddc) caddc) caddc) caddc) caddc) caddc)) $;

--| Lemma for ~ 3cubes . (Contributed by Igor Ieskov, 22-Jan-2024.)
theorem _3cubeslem3r (ph: wff) (A2: class):
  $ wi ph (wcel A2 cq) $ >
  $ wi ph (wceq (co (co (co (co (co (co c3 c3 cexp) (co A2 c3 cexp) cmul) c1 cmin) c3 cexp) (co (co (co (cneg (co (co c3 c3 cexp) (co A2 c3 cexp) cmul)) (co (co c3 c2 cexp) A2 cmul) caddc) c1 caddc) c3 cexp) caddc) (co (co (co (co c3 c3 cexp) (co A2 c2 cexp) cmul) (co (co c3 c2 cexp) A2 cmul) caddc) c3 cexp) caddc) (co (co (co A2 c7 cexp) (co c3 c9 cexp) cmul) (co (co (co A2 c6 cexp) (co c3 c9 cexp) cmul) (co (co (co A2 c5 cexp) (co (co c3 c8 cexp) (co c3 c8 cexp) caddc) cmul) (co (co (co A2 c4 cexp) (co (co (co c3 c7 cexp) c2 cmul) (co c3 c6 cexp) caddc) cmul) (co (co (co A2 c3 cexp) (co (co c3 c6 cexp) (co c3 c6 cexp) caddc) cmul) (co (co (co A2 c2 cexp) (co c3 c5 cexp) cmul) (co A2 (co c3 c3 cexp) cmul) caddc) caddc) caddc) caddc) caddc) caddc)) $;

--| Lemma for ~ 3cubes . (Contributed by Igor Ieskov, 22-Jan-2024.)
theorem _3cubeslem3 (ph: wff) (A2: class):
  $ wi ph (wcel A2 cq) $ >
  $ wi ph (wceq (co A2 (co (co (co (co (co c3 c3 cexp) (co A2 c2 cexp) cmul) (co (co c3 c2 cexp) A2 cmul) caddc) c3 caddc) c3 cexp) cmul) (co (co (co (co (co (co c3 c3 cexp) (co A2 c3 cexp) cmul) c1 cmin) c3 cexp) (co (co (co (cneg (co (co c3 c3 cexp) (co A2 c3 cexp) cmul)) (co (co c3 c2 cexp) A2 cmul) caddc) c1 caddc) c3 cexp) caddc) (co (co (co (co c3 c3 cexp) (co A2 c2 cexp) cmul) (co (co c3 c2 cexp) A2 cmul) caddc) c3 cexp) caddc)) $;

--| Lemma for ~ 3cubes . This is Ryley's explicit formula for decomposing a rational ` A ` into a sum of three rational cubes. (Contributed by Igor Ieskov, 22-Jan-2024.)
theorem _3cubeslem4 (ph: wff) (A2: class):
  $ wi ph (wcel A2 cq) $ >
  $ wi ph (wceq A2 (co (co (co (co (co (co (co c3 c3 cexp) (co A2 c3 cexp) cmul) c1 cmin) (co (co (co (co c3 c3 cexp) (co A2 c2 cexp) cmul) (co (co c3 c2 cexp) A2 cmul) caddc) c3 caddc) cdiv) c3 cexp) (co (co (co (co (cneg (co (co c3 c3 cexp) (co A2 c3 cexp) cmul)) (co (co c3 c2 cexp) A2 cmul) caddc) c1 caddc) (co (co (co (co c3 c3 cexp) (co A2 c2 cexp) cmul) (co (co c3 c2 cexp) A2 cmul) caddc) c3 caddc) cdiv) c3 cexp) caddc) (co (co (co (co (co c3 c3 cexp) (co A2 c2 cexp) cmul) (co (co c3 c2 cexp) A2 cmul) caddc) (co (co (co (co c3 c3 cexp) (co A2 c2 cexp) cmul) (co (co c3 c2 cexp) A2 cmul) caddc) c3 caddc) cdiv) c3 cexp) caddc)) $;

--| Every rational number is a sum of three rational cubes. See S. Ryley, The Ladies' Diary 122 (1825), 35. (Contributed by Igor Ieskov, 22-Jan-2024.)
theorem _3cubes {a b c: setvar} (A2: class):
  $ wb (wcel A2 cq) (wrex a (wrex b (wrex c (wceq A2 (co (co (co (cv a) c3 cexp) (co (cv b) c3 cexp) caddc) (co (cv c) c3 cexp) caddc)) cq) cq) cq) $;

--| The axioms of the complex numbers imply the Axiom of Infinity (in the form of ~ omex ): the map of ~ om2uzf1oi is a one-to-one onto mapping from ` _om ` onto a set of integers, so ` _om ` is a set. Compare ~ dcomex and ~ grothomex . Note that our proof depends on neither ~ ax-inf nor ~ ax-inf2 . (Contributed by Timothy J. O'Malley, 8-Oct-2026.)
theorem omexcn:
  $ wcel com cvv $;

--| The range of the transitive closure is equal to the range of the relation. (Contributed by OpenAI, 7-Jul-2020.)
theorem rntrclfvOAI (R V: class):
  $ wi (wcel R V) (wceq (crn (cfv R ctcl)) (crn R)) $;

--| Transfer at-most-one between related expressions. (Contributed by Stefan O'Rear, 12-Feb-2015.)
theorem moxfr {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class y1):
  $ wcel A2 cvv $ >
  $ weu y1 (wceq (cv x3) A2) $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wmo x3 ph) (wmo y1 ps) $;

--| Indexed intersection of an image. (Contributed by Stefan O'Rear, 22-Feb-2015.)
theorem imaiinfv {x3: setvar} (A2: class x3) (B2 F: class):
  $ wi (wa (wfn F A2) (wss B2 A2)) (wceq (ciin x3 B2 (cfv (cv x3) F)) (cint (cima F B2))) $;

--| Elementhood in a set of relative finite intersections. (Contributed by Stefan O'Rear, 22-Feb-2015.)
theorem elrfi {v: setvar} (A2 B2 C V: class):
  $ wi (wa (wcel B2 V) (wss C (cpw B2))) (wb (wcel A2 (cfv (cun (csn B2) C) cfi)) (wrex v (wceq A2 (cin B2 (cint (cv v)))) (cin (cpw C) cfn))) $;

--| Elementhood in a set of relative finite intersections of an indexed family of sets. (Contributed by Stefan O'Rear, 22-Feb-2015.)
theorem elrfirn {y1 v: setvar} (A2 B2: class y1) (F: class) (I V: class y1):
  $ wi (wa (wcel B2 V) (wf I (cpw B2) F)) (wb (wcel A2 (cfv (cun (csn B2) (crn F)) cfi)) (wrex v (wceq A2 (cin B2 (ciin y1 (cv v) (cfv (cv y1) F)))) (cin (cpw I) cfn))) $;

--| Elementhood in a set of relative finite intersections of an indexed family of sets (implicit). (Contributed by Stefan O'Rear, 22-Feb-2015.)
theorem elrfirn2 {y1 v: setvar} (A2: class y1) (B2: class) (C: class y1) (I V: class):
  $ wi (wa (wcel B2 V) (wral y1 (wss C B2) I)) (wb (wcel A2 (cfv (cun (csn B2) (crn (cmpt y1 I C))) cfi)) (wrex v (wceq A2 (cin B2 (ciin y1 (cv v) C))) (cin (cpw I) cfn))) $;

--| In a compact topology, a system of closed sets with nonempty finite intersections has a nonempty intersection. (Contributed by Stefan O'Rear, 22-Feb-2015.)
theorem cmpfiiin {k l: setvar} (ph: wff) (S: class k) (I J X: class):
  $ wceq X (cuni J) $ >
  $ wi ph (wcel J ccmp) $ >
  $ wi (wa ph (wcel (cv k) I)) (wcel S (cfv J ccld)) $ >
  $ wi (wa ph (wa (wss (cv l) I) (wcel (cv l) cfn))) (wne (cin X (ciin k (cv l) S)) c0) $ >
  $ wi ph (wne (cin X (ciin k I S)) c0) $;

--| Any function from the subsets of a set to itself, which is extensive (satisfies ~ mrcssid ), isotone (satisfies ~ mrcss ), and idempotent (satisfies ~ mrcidm ) has a collection of fixed points which is a Moore collection, and itself is the closure operator for that collection. This can be taken as an alternate definition for the closure operators. This is the first half, ~ ismrcd2 is the second. (Contributed by Stefan O'Rear, 1-Feb-2015.)
theorem ismrcd1 {x3 y1: setvar} (ph: wff) (B2 F V: class):
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wf (cpw B2) (cpw B2) F) $ >
  $ wi (wa ph (wss (cv x3) B2)) (wss (cv x3) (cfv (cv x3) F)) $ >
  $ wi (w3a ph (wss (cv x3) B2) (wss (cv y1) (cv x3))) (wss (cfv (cv y1) F) (cfv (cv x3) F)) $ >
  $ wi (wa ph (wss (cv x3) B2)) (wceq (cfv (cfv (cv x3) F) F) (cfv (cv x3) F)) $ >
  $ wi ph (wcel (cdm (cin F cid)) (cfv B2 cmre)) $;

--| Second half of ~ ismrcd1 . (Contributed by Stefan O'Rear, 1-Feb-2015.)
theorem ismrcd2 {x3 y1: setvar} (ph: wff) (B2 F V: class):
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wf (cpw B2) (cpw B2) F) $ >
  $ wi (wa ph (wss (cv x3) B2)) (wss (cv x3) (cfv (cv x3) F)) $ >
  $ wi (w3a ph (wss (cv x3) B2) (wss (cv y1) (cv x3))) (wss (cfv (cv y1) F) (cfv (cv x3) F)) $ >
  $ wi (wa ph (wss (cv x3) B2)) (wceq (cfv (cfv (cv x3) F) F) (cfv (cv x3) F)) $ >
  $ wi ph (wceq F (cfv (cdm (cin F cid)) cmrc)) $;

--| A closure function which satisfies ~ sscls , ~ clsidm , ~ cls0 , and ~ clsun defines a (unique) topology which it is the closure function on. (Contributed by Stefan O'Rear, 1-Feb-2015.)
theorem istopclsd {x3 y1 z: setvar} (ph: wff) (B2 F: class) (J: class z) (V: class):
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wf (cpw B2) (cpw B2) F) $ >
  $ wi (wa ph (wss (cv x3) B2)) (wss (cv x3) (cfv (cv x3) F)) $ >
  $ wi (wa ph (wss (cv x3) B2)) (wceq (cfv (cfv (cv x3) F) F) (cfv (cv x3) F)) $ >
  $ wi ph (wceq (cfv c0 F) c0) $ >
  $ wi (w3a ph (wss (cv x3) B2) (wss (cv y1) B2)) (wceq (cfv (cun (cv x3) (cv y1)) F) (cun (cfv (cv x3) F) (cfv (cv y1) F))) $ >
  $ wceq J (crab z (wceq (cfv (cdif B2 (cv z)) F) (cdif B2 (cv z))) (cpw B2)) $ >
  $ wi ph (wa (wcel J (cfv B2 ctopon)) (wceq (cfv J ccl) F)) $;

--| A function is a Moore closure operator iff it satisfies ~ mrcssid , ~ mrcss , and ~ mrcidm . (Contributed by Stefan O'Rear, 1-Feb-2015.)
theorem ismrc {x3 y1: setvar} (B2 F: class):
  $ wb (wcel F (cima cmrc (cfv B2 cmre))) (w3a (wcel B2 cvv) (wf (cpw B2) (cpw B2) F) (wal x3 (wal y1 (wi (wa (wss (cv x3) B2) (wss (cv y1) (cv x3))) (w3a (wss (cv x3) (cfv (cv x3) F)) (wss (cfv (cv y1) F) (cfv (cv x3) F)) (wceq (cfv (cfv (cv x3) F) F) (cfv (cv x3) F))))))) $;

--| Class of Noetherian closure systems.
term cnacs: class;

--| Define a closure system of _Noetherian type_ (not standard terminology) as an algebraic system where all closed sets are finitely generated. (Contributed by Stefan O'Rear, 4-Apr-2015.)
axiom df_nacs {x3 g2 s1 c: setvar}:
  $ wceq cnacs (cmpt x3 cvv (crab c (wral s1 (wrex g2 (wceq (cv s1) (cfv (cv g2) (cfv (cv c) cmrc))) (cin (cpw (cv x3)) cfn)) (cv c)) (cfv (cv x3) cacs))) $;

--| Expand definition of Noetherian-type closure system. (Contributed by Stefan O'Rear, 4-Apr-2015.)
theorem isnacs {g2 s1: setvar} (C F X: class):
  $ wceq F (cfv C cmrc) $ >
  $ wb (wcel C (cfv X cnacs)) (wa (wcel C (cfv X cacs)) (wral s1 (wrex g2 (wceq (cv s1) (cfv (cv g2) F)) (cin (cpw X) cfn)) C)) $;

--| In a Noetherian-type closure system, all closed sets are finitely generated. (Contributed by Stefan O'Rear, 4-Apr-2015.)
theorem nacsfg {g2: setvar} (C S F X: class):
  $ wceq F (cfv C cmrc) $ >
  $ wi (wa (wcel C (cfv X cnacs)) (wcel S C)) (wrex g2 (wceq S (cfv (cv g2) F)) (cin (cpw X) cfn)) $;

--| Express Noetherian-type closure system with fewer quantifiers. (Contributed by Stefan O'Rear, 4-Apr-2015.)
theorem isnacs2 (C F X: class):
  $ wceq F (cfv C cmrc) $ >
  $ wb (wcel C (cfv X cnacs)) (wa (wcel C (cfv X cacs)) (wceq (cima F (cin (cpw X) cfn)) C)) $;

--| Slight variation on finite generation for closure systems. (Contributed by Stefan O'Rear, 4-Apr-2015.)
theorem mrefg2 {g2: setvar} (C S F X: class):
  $ wceq F (cfv C cmrc) $ >
  $ wi (wcel C (cfv X cmre)) (wb (wrex g2 (wceq S (cfv (cv g2) F)) (cin (cpw X) cfn)) (wrex g2 (wceq S (cfv (cv g2) F)) (cin (cpw S) cfn))) $;

--| Slight variation on finite generation for closure systems. (Contributed by Stefan O'Rear, 4-Apr-2015.)
theorem mrefg3 {g2: setvar} (C S F X: class):
  $ wceq F (cfv C cmrc) $ >
  $ wi (wa (wcel C (cfv X cmre)) (wcel S C)) (wb (wrex g2 (wceq S (cfv (cv g2) F)) (cin (cpw X) cfn)) (wrex g2 (wss S (cfv (cv g2) F)) (cin (cpw S) cfn))) $;

--| A closure system of Noetherian type is algebraic. (Contributed by Stefan O'Rear, 4-Apr-2015.)
theorem nacsacs (C X: class):
  $ wi (wcel C (cfv X cnacs)) (wcel C (cfv X cacs)) $;

--| A choice-free order equivalent to the Noetherian condition on a closure system. (Contributed by Stefan O'Rear, 4-Apr-2015.)
theorem isnacs3 {s1: setvar} (C X: class):
  $ wb (wcel C (cfv X cnacs)) (wa (wcel C (cfv X cmre)) (wral s1 (wi (wcel (cfv (cv s1) cipo) cdrs) (wcel (cuni (cv s1)) (cv s1))) (cpw C))) $;

--| Transitivity induction of subsets, lemma for ~ nacsfix . (Contributed by Stefan O'Rear, 4-Apr-2015.)
theorem incssnn0 {x3: setvar} (A2 B2: class x3) (F: class):
  $ wi (w3a (wral x3 (wss (cfv (cv x3) F) (cfv (co (cv x3) c1 caddc) F)) cn0) (wcel A2 cn0) (wcel B2 (cfv A2 cuz))) (wss (cfv A2 F) (cfv B2 F)) $;

--| An increasing sequence of closed sets in a Noetherian-type closure system eventually fixates. (Contributed by Stefan O'Rear, 4-Apr-2015.)
theorem nacsfix {x3 y1 z: setvar} (C: class x3) (F: class) (X: class x3):
  $ wi (w3a (wcel C (cfv X cnacs)) (wf cn0 C F) (wral x3 (wss (cfv (cv x3) F) (cfv (co (cv x3) c1 caddc) F)) cn0)) (wrex y1 (wral z (wceq (cfv (cv z) F) (cfv (cv y1) F)) (cfv (cv y1) cuz)) cn0) $;

--| A constant (represented without dummy variables) is an element of a function set. _Note: In the following development, we will be quite often quantifying over functions and points in N-dimensional space (which are equivalent to functions from an "index set"). Many of the following theorems exist to transfer standard facts about functions to elements of function sets_. (Contributed by Stefan O'Rear, 30-Aug-2014.) (Revised by Stefan O'Rear, 5-May-2015.)
theorem constmap (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel C cvv $ >
  $ wi (wcel B2 C) (wcel (cxp A2 (csn B2)) (co C A2 cmap)) $;

--| Renaming indices in a tuple, with sethood as antecedents. (Contributed by Stefan O'Rear, 9-Oct-2014.) (Revised by Mario Carneiro, 5-May-2015.)
theorem mapco2g (A2 B2 C D E: class):
  $ wi (w3a (wcel E cvv) (wcel A2 (co B2 C cmap)) (wf E C D)) (wcel (ccom A2 D) (co B2 E cmap)) $;

--| Post-composition (renaming indices) of a mapping viewed as a point. (Contributed by Stefan O'Rear, 5-Oct-2014.) (Revised by Stefan O'Rear, 5-May-2015.)
theorem mapco2 (A2 B2 C D E: class):
  $ wcel E cvv $ >
  $ wi (wa (wcel A2 (co B2 C cmap)) (wf E C D)) (wcel (ccom A2 D) (co B2 E cmap)) $;

--| Extending a one-based mapping by adding a tuple at the end results in another mapping. (Contributed by Stefan O'Rear, 10-Oct-2014.) (Revised by Stefan O'Rear, 5-May-2015.)
theorem mapfzcons (A2 B2 C M N: class):
  $ wceq M (co N c1 caddc) $ >
  $ wi (w3a (wcel N cn0) (wcel A2 (co B2 (co c1 N cfz) cmap)) (wcel C B2)) (wcel (cun A2 (csn (cop M C))) (co B2 (co c1 M cfz) cmap)) $;

--| Recover prefix mapping from an extended mapping. (Contributed by Stefan O'Rear, 10-Oct-2014.) (Revised by Stefan O'Rear, 5-May-2015.)
theorem mapfzcons1 (A2 B2 C M N: class):
  $ wceq M (co N c1 caddc) $ >
  $ wi (wcel A2 (co B2 (co c1 N cfz) cmap)) (wceq (cres (cun A2 (csn (cop M C))) (co c1 N cfz)) A2) $;

--| A nonempty mapping has a prefix. (Contributed by Stefan O'Rear, 10-Oct-2014.) (Revised by Stefan O'Rear, 5-May-2015.)
theorem mapfzcons1cl (A2 B2 M N: class):
  $ wceq M (co N c1 caddc) $ >
  $ wi (wcel A2 (co B2 (co c1 M cfz) cmap)) (wcel (cres A2 (co c1 N cfz)) (co B2 (co c1 N cfz) cmap)) $;

--| Recover added element from an extended mapping. (Contributed by Stefan O'Rear, 10-Oct-2014.) (Revised by Stefan O'Rear, 5-May-2015.)
theorem mapfzcons2 (A2 B2 C M N: class):
  $ wceq M (co N c1 caddc) $ >
  $ wi (wa (wcel A2 (co B2 (co c1 N cfz) cmap)) (wcel C B2)) (wceq (cfv M (cun A2 (csn (cop M C)))) C) $;

--| Interpret range of a maps-to notation as a constraint on the definition. (Contributed by Stefan O'Rear, 10-Oct-2014.)
theorem mptfcl {t: setvar} (A2: class) (B2: class t) (C: class):
  $ wi (wf A2 C (cmpt t A2 B2)) (wi (wcel (cv t) A2) (wcel B2 C)) $;

--| Extend class notation to include pre-polynomial rings.
term cmzpcl: class;

--| Extend class notation to include polynomial rings.
term cmzp: class;

--| Define the polynomially closed function rings over an arbitrary index set ` v ` . The set ` ( mzPolyCld `` v ) ` contains all sets of functions from ` ( ZZ ^m v ) ` to ` ZZ ` which include all constants and projections and are closed under addition and multiplication. This is a "temporary" set used to define the polynomial function ring itself ` ( mzPoly `` v ) ` ; see ~ df-mzp . (Contributed by Stefan O'Rear, 4-Oct-2014.)
axiom df_mzpcl {x3 v f2 g2 i j p: setvar}:
  $ wceq cmzpcl (cmpt v cvv (crab p (wa (wa (wral i (wcel (cxp (co cz (cv v) cmap) (csn (cv i))) (cv p)) cz) (wral j (wcel (cmpt x3 (co cz (cv v) cmap) (cfv (cv j) (cv x3))) (cv p)) (cv v))) (wral f2 (wral g2 (wa (wcel (co (cv f2) (cv g2) (cof caddc)) (cv p)) (wcel (co (cv f2) (cv g2) (cof cmul)) (cv p))) (cv p)) (cv p))) (cpw (co cz (co cz (cv v) cmap) cmap)))) $;

--| Polynomials over ` ZZ ` with an arbitrary index set, that is, the smallest ring of functions containing all constant functions and all projections. This is almost the most general reasonable definition; to reach full generality, we would need to be able to replace ZZ with an arbitrary (semi)ring (and a coordinate subring), but rings have not been defined yet. (Contributed by Stefan O'Rear, 4-Oct-2014.)
axiom df_mzp {v: setvar}:
  $ wceq cmzp (cmpt v cvv (cint (cfv (cv v) cmzpcl))) $;

--| Substitution lemma for ` mzPolyCld ` . (Contributed by Stefan O'Rear, 4-Oct-2014.)
theorem mzpclval {x3 f2 g2 i j p: setvar} (V: class):
  $ wi (wcel V cvv) (wceq (cfv V cmzpcl) (crab p (wa (wa (wral i (wcel (cxp (co cz V cmap) (csn (cv i))) (cv p)) cz) (wral j (wcel (cmpt x3 (co cz V cmap) (cfv (cv j) (cv x3))) (cv p)) V)) (wral f2 (wral g2 (wa (wcel (co (cv f2) (cv g2) (cof caddc)) (cv p)) (wcel (co (cv f2) (cv g2) (cof cmul)) (cv p))) (cv p)) (cv p))) (cpw (co cz (co cz V cmap) cmap)))) $;

--| Substitution lemma for ` mzPolyCld ` . (Contributed by Stefan O'Rear, 4-Oct-2014.)
theorem mzpclval_b {x3 f2 p: setvar} (V: class):
  $ wi (wcel V cvv) (wceq (cfv V cmzpcl) (crab p (wa (wa (wral f2 (wcel (cxp (co cz V cmap) (csn (cv f2))) (cv p)) cz) (wral f2 (wcel (cmpt x3 (co cz V cmap) (cfv (cv f2) (cv x3))) (cv p)) V)) (wral f2 (wral x3 (wa (wcel (co (cv f2) (cv x3) (cof caddc)) (cv p)) (wcel (co (cv f2) (cv x3) (cof cmul)) (cv p))) (cv p)) (cv p))) (cpw (co cz (co cz V cmap) cmap)))) $;

--| Double substitution lemma for ` mzPolyCld ` . (Contributed by Stefan O'Rear, 4-Oct-2014.)
theorem elmzpcl {x3 f2 g2 i j: setvar} (P V: class):
  $ wi (wcel V cvv) (wb (wcel P (cfv V cmzpcl)) (wa (wss P (co cz (co cz V cmap) cmap)) (wa (wa (wral i (wcel (cxp (co cz V cmap) (csn (cv i))) P) cz) (wral j (wcel (cmpt x3 (co cz V cmap) (cfv (cv j) (cv x3))) P) V)) (wral f2 (wral g2 (wa (wcel (co (cv f2) (cv g2) (cof caddc)) P) (wcel (co (cv f2) (cv g2) (cof cmul)) P)) P) P)))) $;

--| Double substitution lemma for ` mzPolyCld ` . (Contributed by Stefan O'Rear, 4-Oct-2014.)
theorem elmzpcl_b {x3 f2: setvar} (P V: class):
  $ wi (wcel V cvv) (wb (wcel P (cfv V cmzpcl)) (wa (wss P (co cz (co cz V cmap) cmap)) (wa (wa (wral f2 (wcel (cxp (co cz V cmap) (csn (cv f2))) P) cz) (wral f2 (wcel (cmpt x3 (co cz V cmap) (cfv (cv f2) (cv x3))) P) V)) (wral f2 (wral x3 (wa (wcel (co (cv f2) (cv x3) (cof caddc)) P) (wcel (co (cv f2) (cv x3) (cof cmul)) P)) P) P)))) $;

--| The set of all functions with the signature of a polynomial is a polynomially closed set. This is a lemma to show that the intersection in ~ df-mzp is well-defined. (Contributed by Stefan O'Rear, 4-Oct-2014.)
theorem mzpclall (V: class):
  $ wi (wcel V cvv) (wcel (co cz (co cz V cmap) cmap) (cfv V cmzpcl)) $;

--| Corollary of ~ mzpclall : polynomially closed function sets are not empty. (Contributed by Stefan O'Rear, 4-Oct-2014.)
theorem mzpcln0 (V: class):
  $ wi (wcel V cvv) (wne (cfv V cmzpcl) c0) $;

--| Defining property 1 of a polynomially closed function set ` P ` : it contains all constant functions. (Contributed by Stefan O'Rear, 4-Oct-2014.)
theorem mzpcl1 (P F V: class):
  $ wi (wa (wcel P (cfv V cmzpcl)) (wcel F cz)) (wcel (cxp (co cz V cmap) (csn F)) P) $;

--| Defining property 2 of a polynomially closed function set ` P ` : it contains all projections. (Contributed by Stefan O'Rear, 4-Oct-2014.)
theorem mzpcl2 {g2: setvar} (P F V: class):
  $ wi (wa (wcel P (cfv V cmzpcl)) (wcel F V)) (wcel (cmpt g2 (co cz V cmap) (cfv F (cv g2))) P) $;

--| Defining properties 3 and 4 of a polynomially closed function set ` P ` : it is closed under pointwise addition and multiplication. (Contributed by Stefan O'Rear, 4-Oct-2014.)
theorem mzpcl34 (P F G V: class):
  $ wi (w3a (wcel P (cfv V cmzpcl)) (wcel F P) (wcel G P)) (wa (wcel (co F G (cof caddc)) P) (wcel (co F G (cof cmul)) P)) $;

--| Value of the ` mzPoly ` function. (Contributed by Stefan O'Rear, 4-Oct-2014.)
theorem mzpval (V: class):
  $ wi (wcel V cvv) (wceq (cfv V cmzp) (cint (cfv V cmzpcl))) $;

--| ` mzPoly ` is defined for all index sets which are sets. This is used with ~ elfvdm to eliminate sethood antecedents. (Contributed by Stefan O'Rear, 4-Oct-2014.)
theorem dmmzp:
  $ wceq (cdm cmzp) cvv $;

--| Polynomial closedness is a universal first-order property and passes to intersections. This is where the closure properties of the polynomial ring itself are proved. (Contributed by Stefan O'Rear, 4-Oct-2014.)
theorem mzpincl (V: class):
  $ wi (wcel V cvv) (wcel (cfv V cmzp) (cfv V cmzpcl)) $;

--| Constant functions are polynomial. See also ~ mzpconstmpt . (Contributed by Stefan O'Rear, 4-Oct-2014.)
theorem mzpconst (C V: class):
  $ wi (wa (wcel V cvv) (wcel C cz)) (wcel (cxp (co cz V cmap) (csn C)) (cfv V cmzp)) $;

--| A polynomial function is a function from the coordinate space to the integers. (Contributed by Stefan O'Rear, 5-Oct-2014.)
theorem mzpf (F V: class):
  $ wi (wcel F (cfv V cmzp)) (wf (co cz V cmap) cz F) $;

--| A projection function is polynomial. (Contributed by Stefan O'Rear, 4-Oct-2014.)
theorem mzpproj {g2: setvar} (V X: class):
  $ wi (wa (wcel V cvv) (wcel X V)) (wcel (cmpt g2 (co cz V cmap) (cfv X (cv g2))) (cfv V cmzp)) $;

--| The pointwise sum of two polynomial functions is a polynomial function. See also ~ mzpaddmpt . (Contributed by Stefan O'Rear, 4-Oct-2014.)
theorem mzpadd (A2 B2 V: class):
  $ wi (wa (wcel A2 (cfv V cmzp)) (wcel B2 (cfv V cmzp))) (wcel (co A2 B2 (cof caddc)) (cfv V cmzp)) $;

--| The pointwise product of two polynomial functions is a polynomial function. See also ~ mzpmulmpt . (Contributed by Stefan O'Rear, 4-Oct-2014.)
theorem mzpmul (A2 B2 V: class):
  $ wi (wa (wcel A2 (cfv V cmzp)) (wcel B2 (cfv V cmzp))) (wcel (co A2 B2 (cof cmul)) (cfv V cmzp)) $;

--| A constant function expressed in maps-to notation is polynomial. This theorem and the several that follow ( ~ mzpaddmpt , ~ mzpmulmpt , ~ mzpnegmpt , ~ mzpsubmpt , ~ mzpexpmpt ) can be used to build proofs that functions which are "manifestly polynomial", in the sense of being a maps-to containing constants, projections, and simple arithmetic operations, are actually polynomial functions. There is no mzpprojmpt because ~ mzpproj is already expressed using maps-to notation. (Contributed by Stefan O'Rear, 5-Oct-2014.)
theorem mzpconstmpt {x3: setvar} (C V: class):
  $ wi (wa (wcel V cvv) (wcel C cz)) (wcel (cmpt x3 (co cz V cmap) C) (cfv V cmzp)) $;

--| Sum of polynomial functions is polynomial. Maps-to version of ~ mzpadd . (Contributed by Stefan O'Rear, 5-Oct-2014.)
theorem mzpaddmpt {x3: setvar} (A2 B2: class x3) (V: class):
  $ wi (wa (wcel (cmpt x3 (co cz V cmap) A2) (cfv V cmzp)) (wcel (cmpt x3 (co cz V cmap) B2) (cfv V cmzp))) (wcel (cmpt x3 (co cz V cmap) (co A2 B2 caddc)) (cfv V cmzp)) $;

--| Product of polynomial functions is polynomial. Maps-to version of ~ mzpmulmpt . (Contributed by Stefan O'Rear, 5-Oct-2014.)
theorem mzpmulmpt {x3: setvar} (A2 B2: class x3) (V: class):
  $ wi (wa (wcel (cmpt x3 (co cz V cmap) A2) (cfv V cmzp)) (wcel (cmpt x3 (co cz V cmap) B2) (cfv V cmzp))) (wcel (cmpt x3 (co cz V cmap) (co A2 B2 cmul)) (cfv V cmzp)) $;

--| The difference of two polynomial functions is polynomial. (Contributed by Stefan O'Rear, 10-Oct-2014.)
theorem mzpsubmpt {x3: setvar} (A2 B2: class x3) (V: class):
  $ wi (wa (wcel (cmpt x3 (co cz V cmap) A2) (cfv V cmzp)) (wcel (cmpt x3 (co cz V cmap) B2) (cfv V cmzp))) (wcel (cmpt x3 (co cz V cmap) (co A2 B2 cmin)) (cfv V cmzp)) $;

--| Negation of a polynomial function. (Contributed by Stefan O'Rear, 11-Oct-2014.)
theorem mzpnegmpt {x3: setvar} (A2: class x3) (V: class):
  $ wi (wcel (cmpt x3 (co cz V cmap) A2) (cfv V cmzp)) (wcel (cmpt x3 (co cz V cmap) (cneg A2)) (cfv V cmzp)) $;

--| Raise a polynomial function to a (fixed) exponent. (Contributed by Stefan O'Rear, 5-Oct-2014.)
theorem mzpexpmpt {x3: setvar} (A2: class x3) (D V: class):
  $ wi (wa (wcel (cmpt x3 (co cz V cmap) A2) (cfv V cmzp)) (wcel D cn0)) (wcel (cmpt x3 (co cz V cmap) (co A2 D cexp)) (cfv V cmzp)) $;

--| "Structural" induction to prove properties of all polynomial functions. (Contributed by Stefan O'Rear, 4-Oct-2014.)
theorem mzpindd {x3 f2 g2: setvar} (ph: wff) (ps: wff x3) (ch th ta et ze si rh: wff f2 g2) (A2: class f2 g2) (V: class):
  $ wi (wa ph (wcel (cv f2) cz)) ch $ >
  $ wi (wa ph (wcel (cv f2) V)) th $ >
  $ wi (w3a ph (wa (wf (co cz V cmap) cz (cv f2)) ta) (wa (wf (co cz V cmap) cz (cv g2)) et)) ze $ >
  $ wi (w3a ph (wa (wf (co cz V cmap) cz (cv f2)) ta) (wa (wf (co cz V cmap) cz (cv g2)) et)) si $ >
  $ wi (wceq (cv x3) (cxp (co cz V cmap) (csn (cv f2)))) (wb ps ch) $ >
  $ wi (wceq (cv x3) (cmpt g2 (co cz V cmap) (cfv (cv f2) (cv g2)))) (wb ps th) $ >
  $ wi (wceq (cv x3) (cv f2)) (wb ps ta) $ >
  $ wi (wceq (cv x3) (cv g2)) (wb ps et) $ >
  $ wi (wceq (cv x3) (co (cv f2) (cv g2) (cof caddc))) (wb ps ze) $ >
  $ wi (wceq (cv x3) (co (cv f2) (cv g2) (cof cmul))) (wb ps si) $ >
  $ wi (wceq (cv x3) A2) (wb ps rh) $ >
  $ wi (wa ph (wcel A2 (cfv V cmzp))) rh $;

--| Relationship between multivariate Z-polynomials and general multivariate polynomial functions. (Contributed by Stefan O'Rear, 20-Mar-2015.) (Revised by AV, 13-Jun-2019.)
theorem mzpmfp (I: class):
  $ wceq (cfv I cmzp) (crn (co I czring cevl)) $;

--| Substituting polynomials for the variables of a polynomial results in a polynomial. ` G ` is expected to depend on ` y ` and provide the polynomials which are being substituted. (Contributed by Stefan O'Rear, 5-Oct-2014.)
theorem mzpsubst {x3 y1: setvar} (F G: class y1) (V W: class):
  $ wi (w3a (wcel W cvv) (wcel F (cfv V cmzp)) (wral y1 (wcel G (cfv W cmzp)) V)) (wcel (cmpt x3 (co cz W cmap) (cfv (cmpt y1 V (cfv (cv x3) G)) F)) (cfv W cmzp)) $;

--| Simplified version of ~ mzpsubst to simply relabel variables in a polynomial. (Contributed by Stefan O'Rear, 5-Oct-2014.)
theorem mzprename {x3: setvar} (R F V W: class):
  $ wi (w3a (wcel W cvv) (wcel F (cfv V cmzp)) (wf V W R)) (wcel (cmpt x3 (co cz W cmap) (cfv (ccom (cv x3) R) F)) (cfv W cmzp)) $;

--| A polynomial is a polynomial over all larger index sets. (Contributed by Stefan O'Rear, 5-Oct-2014.) (Revised by Stefan O'Rear, 5-Jun-2015.)
theorem mzpresrename {x3: setvar} (F V W: class):
  $ wi (w3a (wcel W cvv) (wss V W) (wcel F (cfv V cmzp))) (wcel (cmpt x3 (co cz W cmap) (cfv (cres (cv x3) V) F)) (cfv W cmzp)) $;

--| Lemma for ~ mzpcompact2 . (Contributed by Stefan O'Rear, 9-Oct-2014.)
theorem mzpcompact2lem {a b c: setvar} (A2: class c) (B2: class):
  $ wcel B2 cvv $ >
  $ wi (wcel A2 (cfv B2 cmzp)) (wrex a (wrex b (wa (wss (cv a) B2) (wceq A2 (cmpt c (co cz B2 cmap) (cfv (cres (cv c) (cv a)) (cv b))))) (cfv (cv a) cmzp)) cfn) $;

--| Polynomials are finitary objects and can only reference a finite number of variables, even if the index set is infinite. Thus, every polynomial can be expressed as a (uniquely minimal, although we do not prove that) polynomial on a finite number of variables, which is then extended by adding an arbitrary set of ignored variables. (Contributed by Stefan O'Rear, 9-Oct-2014.)
theorem mzpcompact2 {a b c: setvar} (A2: class c) (B2: class):
  $ wi (wcel A2 (cfv B2 cmzp)) (wrex a (wrex b (wa (wss (cv a) B2) (wceq A2 (cmpt c (co cz B2 cmap) (cfv (cres (cv c) (cv a)) (cv b))))) (cfv (cv a) cmzp)) cfn) $;

--| ~ coeq0 but without explicitly introducing domain and range symbols. (Contributed by Stefan O'Rear, 16-Oct-2014.)
theorem coeq0i (A2 B2 C D E F: class):
  $ wi (w3a (wf C D A2) (wf E F B2) (wceq (cin C F) c0)) (wceq (ccom A2 B2) c0) $;

--| Split a finite 1-based set of integers in the middle, allowing either end to be empty ( ` ( 1 ... 0 ) ` ). (Contributed by Stefan O'Rear, 8-Oct-2014.)
theorem fzsplit1nn0 (A2 B2: class):
  $ wi (w3a (wcel A2 cn0) (wcel B2 cn0) (wbr A2 B2 cle)) (wceq (co c1 B2 cfz) (cun (co c1 A2 cfz) (co (co A2 c1 caddc) B2 cfz))) $;

--| Extend class notation to include the family of Diophantine sets.
term cdioph: class;

--| A Diophantine set is a set of positive integers which is a projection of the zero set of some polynomial. This definition somewhat awkwardly mixes ` ZZ ` (via ` mzPoly ` ) and ` NN0 ` (to define the zero sets); the former could be avoided by considering coincidence sets of ` NN0 ` polynomials at the cost of requiring two, and the second is driven by consistency with our mu-recursive functions and the requirements of the Davis-Putnam-Robinson-Matiyasevich proof. Both are avoidable at a complexity cost. In particular, it is a consequence of ~ 4sq that implicitly restricting variables to ` NN0 ` adds no expressive power over allowing them to range over ` ZZ ` . While this definition stipulates a specific index set for the polynomials, there is actually flexibility here, see ~ eldioph2b . (Contributed by Stefan O'Rear, 5-Oct-2014.)
axiom df_dioph {u t k n p: setvar}:
  $ wceq cdioph (cmpt n cn0 (crn (cmpo k p (cfv (cv n) cuz) (cfv (co c1 (cv k) cfz) cmzp) (cab t (wrex u (wa (wceq (cv t) (cres (cv u) (co c1 (cv n) cfz))) (wceq (cfv (cv u) (cv p)) cc0)) (co cn0 (co c1 (cv k) cfz) cmap)))))) $;

--| Initial expression of Diophantine property of a set. (Contributed by Stefan O'Rear, 5-Oct-2014.) (Revised by Mario Carneiro, 22-Sep-2015.)
theorem eldiophb {u t k p: setvar} (D: class u t) (N: class):
  $ wb (wcel D (cfv N cdioph)) (wa (wcel N cn0) (wrex k (wrex p (wceq D (cab t (wrex u (wa (wceq (cv t) (cres (cv u) (co c1 N cfz))) (wceq (cfv (cv u) (cv p)) cc0)) (co cn0 (co c1 (cv k) cfz) cmap)))) (cfv (co c1 (cv k) cfz) cmzp)) (cfv N cuz))) $;

--| Condition for a set to be Diophantine (unpacking existential quantifier). (Contributed by Stefan O'Rear, 5-Oct-2014.)
theorem eldioph {u t: setvar} (P K N: class):
  $ wi (w3a (wcel N cn0) (wcel K (cfv N cuz)) (wcel P (cfv (co c1 K cfz) cmzp))) (wcel (cab t (wrex u (wa (wceq (cv t) (cres (cv u) (co c1 N cfz))) (wceq (cfv (cv u) P) cc0)) (co cn0 (co c1 K cfz) cmap))) (cfv N cdioph)) $;

--| Renaming and adding unused witness variables does not change the Diophantine set coded by a polynomial. (Contributed by Stefan O'Rear, 7-Oct-2014.)
theorem diophrw {a b c d: setvar} (P: class a) (S T M O: class):
  $ wi (w3a (wcel S cvv) (wf1 T S M) (wceq (cres M O) (cres cid O))) (wceq (cab a (wrex b (wa (wceq (cv a) (cres (cv b) O)) (wceq (cfv (cv b) (cmpt d (co cz S cmap) (cfv (ccom (cv d) M) P))) cc0)) (co cn0 S cmap))) (cab a (wrex c (wa (wceq (cv a) (cres (cv c) O)) (wceq (cfv (cv c) P) cc0)) (co cn0 T cmap)))) $;

--| Lemma for ~ eldioph2 . Construct necessary renaming function for one direction. (Contributed by Stefan O'Rear, 8-Oct-2014.)
theorem eldioph2lem1 {e d: setvar} (A2 N: class):
  $ wi (w3a (wcel N cn0) (wcel A2 cfn) (wss (co c1 N cfz) A2)) (wrex d (wrex e (wa (wf1o (co c1 (cv d) cfz) A2 (cv e)) (wceq (cres (cv e) (co c1 N cfz)) (cres cid (co c1 N cfz)))) cvv) (cfv N cuz)) $;

--| Lemma for ~ eldioph2 . Construct necessary renaming function for one direction. (Contributed by Stefan O'Rear, 8-Oct-2014.)
theorem eldioph2lem2 {c: setvar} (A2 S N: class):
  $ wi (wa (wa (wcel N cn0) (wn (wcel S cfn))) (wa (wss (co c1 N cfz) S) (wcel A2 (cfv N cuz)))) (wex c (wa (wf1 (co c1 A2 cfz) S (cv c)) (wceq (cres (cv c) (co c1 N cfz)) (cres cid (co c1 N cfz))))) $;

--| Construct a Diophantine set from a polynomial with witness variables drawn from any set whatsoever, via ~ mzpcompact2 . (Contributed by Stefan O'Rear, 8-Oct-2014.) (Revised by Stefan O'Rear, 5-Jun-2015.)
theorem eldioph2 {u t: setvar} (P S N: class):
  $ wi (w3a (wcel N cn0) (wa (wcel S cvv) (wss (co c1 N cfz) S)) (wcel P (cfv S cmzp))) (wcel (cab t (wrex u (wa (wceq (cv t) (cres (cv u) (co c1 N cfz))) (wceq (cfv (cv u) P) cc0)) (co cn0 S cmap))) (cfv N cdioph)) $;

--| While Diophantine sets were defined to have a finite number of witness variables consequtively following the observable variables, this is not necessary; they can equivalently be taken to use any witness set ` ( S \ ( 1 ... N ) ) ` . For instance, in ~ diophin we use this to take the two input sets to have disjoint witness sets. (Contributed by Stefan O'Rear, 8-Oct-2014.)
theorem eldioph2b {u t p: setvar} (A2: class u t) (S N: class):
  $ wi (wa (wa (wcel N cn0) (wcel S cvv)) (wa (wn (wcel S cfn)) (wss (co c1 N cfz) S))) (wb (wcel A2 (cfv N cdioph)) (wrex p (wceq A2 (cab t (wrex u (wa (wceq (cv t) (cres (cv u) (co c1 N cfz))) (wceq (cfv (cv u) (cv p)) cc0)) (co cn0 S cmap)))) (cfv S cmzp))) $;

--| Remove antecedent on ` B ` from Diophantine set constructors. (Contributed by Stefan O'Rear, 10-Oct-2014.)
theorem eldiophelnn0 (A2 B2: class):
  $ wi (wcel A2 (cfv B2 cdioph)) (wcel B2 cn0) $;

--| Define Diophantine sets in terms of polynomials with variables indexed by ` NN ` . This avoids a quantifier over the number of witness variables and will be easier to use than ~ eldiophb in most cases. (Contributed by Stefan O'Rear, 10-Oct-2014.)
theorem eldioph3b {u t p: setvar} (A2 N: class):
  $ wb (wcel A2 (cfv N cdioph)) (wa (wcel N cn0) (wrex p (wceq A2 (cab t (wrex u (wa (wceq (cv t) (cres (cv u) (co c1 N cfz))) (wceq (cfv (cv u) (cv p)) cc0)) (co cn0 cn cmap)))) (cfv cn cmzp))) $;

--| Inference version of ~ eldioph3b with quantifier expanded. (Contributed by Stefan O'Rear, 10-Oct-2014.)
theorem eldioph3 {u t: setvar} (P N: class):
  $ wi (wa (wcel N cn0) (wcel P (cfv cn cmzp))) (wcel (cab t (wrex u (wa (wceq (cv t) (cres (cv u) (co c1 N cfz))) (wceq (cfv (cv u) P) cc0)) (co cn0 cn cmap))) (cfv N cdioph)) $;

--| Membership in a lower set of integers. (Contributed by Stefan O'Rear, 9-Oct-2014.)
theorem ellz1 (A2 B2: class):
  $ wi (wcel B2 cz) (wb (wcel A2 (cdif cz (cfv (co B2 c1 caddc) cuz))) (wa (wcel A2 cz) (wbr A2 B2 cle))) $;

--| The union of a lower set of integers and an upper set of integers which abut or overlap is all of the integers. (Contributed by Stefan O'Rear, 9-Oct-2014.)
theorem lzunuz (A2 B2: class):
  $ wi (w3a (wcel A2 cz) (wcel B2 cz) (wbr B2 (co A2 c1 caddc) cle)) (wceq (cun (cdif cz (cfv (co A2 c1 caddc) cuz)) (cfv B2 cuz)) cz) $;

--| Express a one-based finite range as the intersection of lower integers with ` NN ` . (Contributed by Stefan O'Rear, 9-Oct-2014.)
theorem fz1eqin (N: class):
  $ wi (wcel N cn0) (wceq (co c1 N cfz) (cin (cdif cz (cfv (co N c1 caddc) cuz)) cn)) $;

--| Lower integers are countably infinite. (Contributed by Stefan O'Rear, 10-Oct-2014.)
theorem lzenom (N: class):
  $ wi (wcel N cz) (wbr (cdif cz (cfv (co N c1 caddc) cuz)) com cen) $;

--| ~ fresaunres2 transposed to mappings. (Contributed by Stefan O'Rear, 9-Oct-2014.)
theorem elmapresaunres2 (A2 B2 C F G: class):
  $ wi (w3a (wcel F (co C A2 cmap)) (wcel G (co C B2 cmap)) (wceq (cres F (cin A2 B2)) (cres G (cin A2 B2)))) (wceq (cres (cun F G) B2) G) $;

--| If two sets are Diophantine, so is their intersection. (Contributed by Stefan O'Rear, 9-Oct-2014.) (Revised by Stefan O'Rear, 6-May-2015.)
theorem diophin (A2 B2 N: class):
  $ wi (wa (wcel A2 (cfv N cdioph)) (wcel B2 (cfv N cdioph))) (wcel (cin A2 B2) (cfv N cdioph)) $;

--| If two sets are Diophantine, so is their union. (Contributed by Stefan O'Rear, 9-Oct-2014.) (Revised by Stefan O'Rear, 6-May-2015.)
theorem diophun (A2 B2 N: class):
  $ wi (wa (wcel A2 (cfv N cdioph)) (wcel B2 (cfv N cdioph))) (wcel (cun A2 B2) (cfv N cdioph)) $;

--| Diophantine sets are sets of tuples of nonnegative integers. (Contributed by Stefan O'Rear, 10-Oct-2014.) (Revised by Stefan O'Rear, 6-May-2015.)
theorem eldiophss (A2 B2: class):
  $ wi (wcel A2 (cfv B2 cdioph)) (wss A2 (co cn0 (co c1 B2 cfz) cmap)) $;

--| Projecting a Diophantine set by removing a coordinate results in a Diophantine set. (Contributed by Stefan O'Rear, 10-Oct-2014.)
theorem diophrex {u t: setvar} (S: class) (M: class u t) (N: class):
  $ wi (w3a (wcel N cn0) (wcel M (cfv N cuz)) (wcel S (cfv M cdioph))) (wcel (cab t (wrex u (wceq (cv t) (cres (cv u) (co c1 N cfz))) S)) (cfv N cdioph)) $;

--| This is the first of a number of theorems which allow sets to be proven Diophantine by syntactic induction, and models the correspondence between Diophantine sets and monotone existential first-order logic. This first theorem shows that the zero set of an implicit polynomial is Diophantine. (Contributed by Stefan O'Rear, 10-Oct-2014.)
theorem eq0rabdioph {t: setvar} (A2: class t) (N: class):
  $ wi (wa (wcel N cn0) (wcel (cmpt t (co cz (co c1 N cfz) cmap) A2) (cfv (co c1 N cfz) cmzp))) (wcel (crab t (wceq A2 cc0) (co cn0 (co c1 N cfz) cmap)) (cfv N cdioph)) $;

--| Diophantine set builder for equality of polynomial expressions. Note that the two expressions need not be nonnegative; only variables are so constrained. (Contributed by Stefan O'Rear, 10-Oct-2014.)
theorem eqrabdioph {t: setvar} (A2 B2: class t) (N: class):
  $ wi (w3a (wcel N cn0) (wcel (cmpt t (co cz (co c1 N cfz) cmap) A2) (cfv (co c1 N cfz) cmzp)) (wcel (cmpt t (co cz (co c1 N cfz) cmap) B2) (cfv (co c1 N cfz) cmzp))) (wcel (crab t (wceq A2 B2) (co cn0 (co c1 N cfz) cmap)) (cfv N cdioph)) $;

--| The empty set is Diophantine. (Contributed by Stefan O'Rear, 10-Oct-2014.)
theorem _0dioph (A2: class):
  $ wi (wcel A2 cn0) (wcel c0 (cfv A2 cdioph)) $;

--| The "universal" set (as large as possible given ~ eldiophss ) is Diophantine. (Contributed by Stefan O'Rear, 10-Oct-2014.)
theorem vdioph (A2: class):
  $ wi (wcel A2 cn0) (wcel (co cn0 (co c1 A2 cfz) cmap) (cfv A2 cdioph)) $;

--| Diophantine set builder for conjunctions. (Contributed by Stefan O'Rear, 10-Oct-2014.)
theorem anrabdioph {t: setvar} (ph ps: wff t) (N: class):
  $ wi (wa (wcel (crab t ph (co cn0 (co c1 N cfz) cmap)) (cfv N cdioph)) (wcel (crab t ps (co cn0 (co c1 N cfz) cmap)) (cfv N cdioph))) (wcel (crab t (wa ph ps) (co cn0 (co c1 N cfz) cmap)) (cfv N cdioph)) $;

--| Diophantine set builder for disjunctions. (Contributed by Stefan O'Rear, 10-Oct-2014.)
theorem orrabdioph {t: setvar} (ph ps: wff t) (N: class):
  $ wi (wa (wcel (crab t ph (co cn0 (co c1 N cfz) cmap)) (cfv N cdioph)) (wcel (crab t ps (co cn0 (co c1 N cfz) cmap)) (cfv N cdioph))) (wcel (crab t (wo ph ps) (co cn0 (co c1 N cfz) cmap)) (cfv N cdioph)) $;

--| Diophantine set builder for ternary conjunctions. (Contributed by Stefan O'Rear, 10-Oct-2014.)
theorem _3anrabdioph {t: setvar} (ph ps ch: wff t) (N: class):
  $ wi (w3a (wcel (crab t ph (co cn0 (co c1 N cfz) cmap)) (cfv N cdioph)) (wcel (crab t ps (co cn0 (co c1 N cfz) cmap)) (cfv N cdioph)) (wcel (crab t ch (co cn0 (co c1 N cfz) cmap)) (cfv N cdioph))) (wcel (crab t (w3a ph ps ch) (co cn0 (co c1 N cfz) cmap)) (cfv N cdioph)) $;

--| Diophantine set builder for ternary disjunctions. (Contributed by Stefan O'Rear, 10-Oct-2014.)
theorem _3orrabdioph {t: setvar} (ph ps ch: wff t) (N: class):
  $ wi (w3a (wcel (crab t ph (co cn0 (co c1 N cfz) cmap)) (cfv N cdioph)) (wcel (crab t ps (co cn0 (co c1 N cfz) cmap)) (cfv N cdioph)) (wcel (crab t ch (co cn0 (co c1 N cfz) cmap)) (cfv N cdioph))) (wcel (crab t (w3o ph ps ch) (co cn0 (co c1 N cfz) cmap)) (cfv N cdioph)) $;

--| Exchange an existential quantifier with two substitutions. (Contributed by Stefan O'Rear, 11-Oct-2014.) (Revised by NM, 24-Aug-2018.)
theorem _2sbcrex {a b c: setvar} (ph: wff a b c) (A2 B2: class a b) (C: class c):
  $ wb (wsbc a (wsbc b (wrex c ph C) B2) A2) (wrex c (wsbc a (wsbc b ph B2) A2) C) $;

--| Exchange a substitution with two existentials. (Contributed by Stefan O'Rear, 11-Oct-2014.) (Revised by NM, 24-Aug-2018.)
theorem sbc2rex {a b c: setvar} (ph: wff a b c) (A2: class a) (B2 C: class b c):
  $ wb (wsbc a (wrex b (wrex c ph C) B2) A2) (wrex b (wrex c (wsbc a ph A2) C) B2) $;

--| Exchange a substitution with four existentials. (Contributed by Stefan O'Rear, 11-Oct-2014.) (Revised by NM, 24-Aug-2018.)
theorem sbc4rex {e a b c d: setvar} (ph: wff e a b c d) (A2: class a) (B2 C D E: class e b c d):
  $ wb (wsbc a (wrex b (wrex c (wrex d (wrex e ph E) D) C) B2) A2) (wrex b (wrex c (wrex d (wrex e (wsbc a ph A2) E) D) C) B2) $;

--| Rotate a sequence of three explicit substitutions. (Contributed by Stefan O'Rear, 11-Oct-2014.) (Revised by Mario Carneiro, 11-Dec-2016.)
theorem sbcrot3 {a b c: setvar} (ph: wff a b c) (A2: class a) (B2 C: class b c):
  $ wb (wsbc a (wsbc b (wsbc c ph C) B2) A2) (wsbc b (wsbc c (wsbc a ph A2) C) B2) $;

--| Rotate a sequence of five explicit substitutions. (Contributed by Stefan O'Rear, 11-Oct-2014.) (Revised by Mario Carneiro, 11-Dec-2016.)
theorem sbcrot5 {e a b c d: setvar} (ph: wff e a b c d) (A2: class a) (B2 C D E: class e b c d):
  $ wb (wsbc a (wsbc b (wsbc c (wsbc d (wsbc e ph E) D) C) B2) A2) (wsbc b (wsbc c (wsbc d (wsbc e (wsbc a ph A2) E) D) C) B2) $;

--| Commute two explicit substitutions, using an implicit substitution to rewrite the exiting substitution. (Contributed by Stefan O'Rear, 11-Oct-2014.) (Revised by Mario Carneiro, 11-Dec-2016.)
theorem sbccomieg {a b: setvar} (ph: wff a b) (A2: class) (B2: class a b) (C: class b):
  $ wi (wceq (cv a) A2) (wceq B2 C) $ >
  $ wb (wsbc a (wsbc b ph B2) A2) (wsbc b (wsbc a ph A2) C) $;

--| Diophantine set builder for existential quantification. (Contributed by Stefan O'Rear, 10-Oct-2014.)
theorem rexrabdioph {v u t: setvar} (ph: wff t) (ps: wff v u) (ch: wff u t) (M N: class):
  $ wceq M (co N c1 caddc) $ >
  $ wi (wceq (cv v) (cfv M (cv t))) (wb ps ch) $ >
  $ wi (wceq (cv u) (cres (cv t) (co c1 N cfz))) (wb ch ph) $ >
  $ wi (wa (wcel N cn0) (wcel (crab t ph (co cn0 (co c1 M cfz) cmap)) (cfv M cdioph))) (wcel (crab u (wrex v ps cn0) (co cn0 (co c1 N cfz) cmap)) (cfv N cdioph)) $;

--| Diophantine set builder for existential quantifier, explicit substitution. (Contributed by Stefan O'Rear, 11-Oct-2014.) (Revised by Stefan O'Rear, 6-May-2015.)
theorem rexfrabdioph {v u t: setvar} (ph: wff v u) (M N: class):
  $ wceq M (co N c1 caddc) $ >
  $ wi (wa (wcel N cn0) (wcel (crab t (wsbc u (wsbc v ph (cfv M (cv t))) (cres (cv t) (co c1 N cfz))) (co cn0 (co c1 M cfz) cmap)) (cfv M cdioph))) (wcel (crab u (wrex v ph cn0) (co cn0 (co c1 N cfz) cmap)) (cfv N cdioph)) $;

--| Diophantine set builder for existential quantifier, explicit substitution, two variables. (Contributed by Stefan O'Rear, 11-Oct-2014.) (Revised by Stefan O'Rear, 6-May-2015.)
theorem _2rexfrabdioph {w v u t: setvar} (ph: wff w v u) (L M N: class):
  $ wceq M (co N c1 caddc) $ >
  $ wceq L (co M c1 caddc) $ >
  $ wi (wa (wcel N cn0) (wcel (crab t (wsbc u (wsbc v (wsbc w ph (cfv L (cv t))) (cfv M (cv t))) (cres (cv t) (co c1 N cfz))) (co cn0 (co c1 L cfz) cmap)) (cfv L cdioph))) (wcel (crab u (wrex v (wrex w ph cn0) cn0) (co cn0 (co c1 N cfz) cmap)) (cfv N cdioph)) $;

--| Diophantine set builder for existential quantifier, explicit substitution, two variables. (Contributed by Stefan O'Rear, 17-Oct-2014.) (Revised by Stefan O'Rear, 6-May-2015.)
theorem _3rexfrabdioph {x3 w v u t: setvar} (ph: wff x3 w v u) (K L M N: class):
  $ wceq M (co N c1 caddc) $ >
  $ wceq L (co M c1 caddc) $ >
  $ wceq K (co L c1 caddc) $ >
  $ wi (wa (wcel N cn0) (wcel (crab t (wsbc u (wsbc v (wsbc w (wsbc x3 ph (cfv K (cv t))) (cfv L (cv t))) (cfv M (cv t))) (cres (cv t) (co c1 N cfz))) (co cn0 (co c1 K cfz) cmap)) (cfv K cdioph))) (wcel (crab u (wrex v (wrex w (wrex x3 ph cn0) cn0) cn0) (co cn0 (co c1 N cfz) cmap)) (cfv N cdioph)) $;

--| Diophantine set builder for existential quantifier, explicit substitution, four variables. (Contributed by Stefan O'Rear, 11-Oct-2014.) (Revised by Stefan O'Rear, 6-May-2015.)
theorem _4rexfrabdioph {x3 y1 w v u t: setvar} (ph: wff x3 y1 w v u) (J K L M N: class):
  $ wceq M (co N c1 caddc) $ >
  $ wceq L (co M c1 caddc) $ >
  $ wceq K (co L c1 caddc) $ >
  $ wceq J (co K c1 caddc) $ >
  $ wi (wa (wcel N cn0) (wcel (crab t (wsbc u (wsbc v (wsbc w (wsbc x3 (wsbc y1 ph (cfv J (cv t))) (cfv K (cv t))) (cfv L (cv t))) (cfv M (cv t))) (cres (cv t) (co c1 N cfz))) (co cn0 (co c1 J cfz) cmap)) (cfv J cdioph))) (wcel (crab u (wrex v (wrex w (wrex x3 (wrex y1 ph cn0) cn0) cn0) cn0) (co cn0 (co c1 N cfz) cmap)) (cfv N cdioph)) $;

--| Diophantine set builder for existential quantifier, explicit substitution, six variables. (Contributed by Stefan O'Rear, 11-Oct-2014.) (Revised by Stefan O'Rear, 6-May-2015.)
theorem _6rexfrabdioph {x3 y1 z w v u t p: setvar} (ph: wff x3 y1 z w v u p) (H I J K L M N: class):
  $ wceq M (co N c1 caddc) $ >
  $ wceq L (co M c1 caddc) $ >
  $ wceq K (co L c1 caddc) $ >
  $ wceq J (co K c1 caddc) $ >
  $ wceq I (co J c1 caddc) $ >
  $ wceq H (co I c1 caddc) $ >
  $ wi (wa (wcel N cn0) (wcel (crab t (wsbc u (wsbc v (wsbc w (wsbc x3 (wsbc y1 (wsbc z (wsbc p ph (cfv H (cv t))) (cfv I (cv t))) (cfv J (cv t))) (cfv K (cv t))) (cfv L (cv t))) (cfv M (cv t))) (cres (cv t) (co c1 N cfz))) (co cn0 (co c1 H cfz) cmap)) (cfv H cdioph))) (wcel (crab u (wrex v (wrex w (wrex x3 (wrex y1 (wrex z (wrex p ph cn0) cn0) cn0) cn0) cn0) cn0) (co cn0 (co c1 N cfz) cmap)) (cfv N cdioph)) $;

--| Diophantine set builder for existential quantifier, explicit substitution, seven variables. (Contributed by Stefan O'Rear, 11-Oct-2014.) (Revised by Stefan O'Rear, 6-May-2015.)
theorem _7rexfrabdioph {x3 y1 z w v u t q p: setvar} (ph: wff x3 y1 z w v u q p) (G H I J K L M N: class):
  $ wceq M (co N c1 caddc) $ >
  $ wceq L (co M c1 caddc) $ >
  $ wceq K (co L c1 caddc) $ >
  $ wceq J (co K c1 caddc) $ >
  $ wceq I (co J c1 caddc) $ >
  $ wceq H (co I c1 caddc) $ >
  $ wceq G (co H c1 caddc) $ >
  $ wi (wa (wcel N cn0) (wcel (crab t (wsbc u (wsbc v (wsbc w (wsbc x3 (wsbc y1 (wsbc z (wsbc p (wsbc q ph (cfv G (cv t))) (cfv H (cv t))) (cfv I (cv t))) (cfv J (cv t))) (cfv K (cv t))) (cfv L (cv t))) (cfv M (cv t))) (cres (cv t) (co c1 N cfz))) (co cn0 (co c1 G cfz) cmap)) (cfv G cdioph))) (wcel (crab u (wrex v (wrex w (wrex x3 (wrex y1 (wrex z (wrex p (wrex q ph cn0) cn0) cn0) cn0) cn0) cn0) cn0) (co cn0 (co c1 N cfz) cmap)) (cfv N cdioph)) $;

--| Lemma for arithmetic diophantine sets. Convert polynomial-ness of an expression into a constraint suitable for ~ ralimi . (Contributed by Stefan O'Rear, 10-Oct-2014.)
theorem rabdiophlem1 {t: setvar} (A2: class t) (N: class):
  $ wi (wcel (cmpt t (co cz (co c1 N cfz) cmap) A2) (cfv (co c1 N cfz) cmzp)) (wral t (wcel A2 cz) (co cn0 (co c1 N cfz) cmap)) $;

--| Lemma for arithmetic diophantine sets. Reuse a polynomial expression under a new quantifier. (Contributed by Stefan O'Rear, 10-Oct-2014.)
theorem rabdiophlem2 {u t: setvar} (A2: class u) (M N: class):
  $ wceq M (co N c1 caddc) $ >
  $ wi (wa (wcel N cn0) (wcel (cmpt u (co cz (co c1 N cfz) cmap) A2) (cfv (co c1 N cfz) cmzp))) (wcel (cmpt t (co cz (co c1 M cfz) cmap) (csb u (cres (cv t) (co c1 N cfz)) A2)) (cfv (co c1 M cfz) cmzp)) $;

--| Diophantine set builder for nonnegativity constraints. The first builder which uses a witness variable internally; an expression is nonnegative if there is a nonnegative integer equal to it. (Contributed by Stefan O'Rear, 11-Oct-2014.)
theorem elnn0rabdioph {t: setvar} (A2: class t) (N: class):
  $ wi (wa (wcel N cn0) (wcel (cmpt t (co cz (co c1 N cfz) cmap) A2) (cfv (co c1 N cfz) cmzp))) (wcel (crab t (wcel A2 cn0) (co cn0 (co c1 N cfz) cmap)) (cfv N cdioph)) $;

--| Rewrite an existential quantification restricted to integers into an existential quantification restricted to naturals. (Contributed by Stefan O'Rear, 11-Oct-2014.)
theorem rexzrexnn0 {x3 y1: setvar} (ph: wff x3) (ps ch: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wceq (cv x3) (cneg (cv y1))) (wb ph ch) $ >
  $ wb (wrex x3 ph cz) (wrex y1 (wo ps ch) cn0) $;

--| Diophantine set builder for the "less than or equal to" relation. (Contributed by Stefan O'Rear, 11-Oct-2014.)
theorem lerabdioph {t: setvar} (A2 B2: class t) (N: class):
  $ wi (w3a (wcel N cn0) (wcel (cmpt t (co cz (co c1 N cfz) cmap) A2) (cfv (co c1 N cfz) cmzp)) (wcel (cmpt t (co cz (co c1 N cfz) cmap) B2) (cfv (co c1 N cfz) cmzp))) (wcel (crab t (wbr A2 B2 cle) (co cn0 (co c1 N cfz) cmap)) (cfv N cdioph)) $;

--| Diophantine set builder for membership in a fixed upper set of integers. (Contributed by Stefan O'Rear, 11-Oct-2014.)
theorem eluzrabdioph {t: setvar} (A2: class t) (M N: class):
  $ wi (w3a (wcel N cn0) (wcel M cz) (wcel (cmpt t (co cz (co c1 N cfz) cmap) A2) (cfv (co c1 N cfz) cmzp))) (wcel (crab t (wcel A2 (cfv M cuz)) (co cn0 (co c1 N cfz) cmap)) (cfv N cdioph)) $;

--| Diophantine set builder for positivity. (Contributed by Stefan O'Rear, 11-Oct-2014.)
theorem elnnrabdioph {t: setvar} (A2: class t) (N: class):
  $ wi (wa (wcel N cn0) (wcel (cmpt t (co cz (co c1 N cfz) cmap) A2) (cfv (co c1 N cfz) cmzp))) (wcel (crab t (wcel A2 cn) (co cn0 (co c1 N cfz) cmap)) (cfv N cdioph)) $;

--| Diophantine set builder for the strict less than relation. (Contributed by Stefan O'Rear, 11-Oct-2014.)
theorem ltrabdioph {t: setvar} (A2 B2: class t) (N: class):
  $ wi (w3a (wcel N cn0) (wcel (cmpt t (co cz (co c1 N cfz) cmap) A2) (cfv (co c1 N cfz) cmzp)) (wcel (cmpt t (co cz (co c1 N cfz) cmap) B2) (cfv (co c1 N cfz) cmzp))) (wcel (crab t (wbr A2 B2 clt) (co cn0 (co c1 N cfz) cmap)) (cfv N cdioph)) $;

--| Diophantine set builder for inequality. This not quite trivial theorem touches on something important; Diophantine sets are not closed under negation, but they contain an important subclass that is, namely the recursive sets. With this theorem and De Morgan's laws, all quantifier-free formulas can be negated. (Contributed by Stefan O'Rear, 11-Oct-2014.)
theorem nerabdioph {t: setvar} (A2 B2: class t) (N: class):
  $ wi (w3a (wcel N cn0) (wcel (cmpt t (co cz (co c1 N cfz) cmap) A2) (cfv (co c1 N cfz) cmzp)) (wcel (cmpt t (co cz (co c1 N cfz) cmap) B2) (cfv (co c1 N cfz) cmzp))) (wcel (crab t (wne A2 B2) (co cn0 (co c1 N cfz) cmap)) (cfv N cdioph)) $;

--| Divisibility is a Diophantine relation. (Contributed by Stefan O'Rear, 11-Oct-2014.)
theorem dvdsrabdioph {t: setvar} (A2 B2: class t) (N: class):
  $ wi (w3a (wcel N cn0) (wcel (cmpt t (co cz (co c1 N cfz) cmap) A2) (cfv (co c1 N cfz) cmzp)) (wcel (cmpt t (co cz (co c1 N cfz) cmap) B2) (cfv (co c1 N cfz) cmzp))) (wcel (crab t (wbr A2 B2 cdvds) (co cn0 (co c1 N cfz) cmap)) (cfv N cdioph)) $;

--| Membership in ` Dioph ` expressed using a quantified union to add witness variables instead of a restriction to remove them. (Contributed by Stefan O'Rear, 16-Oct-2014.)
theorem eldioph4b {w t p: setvar} (S N W: class):
  $ wcel W cvv $ >
  $ wn (wcel W cfn) $ >
  $ wceq (cin W cn) c0 $ >
  $ wb (wcel S (cfv N cdioph)) (wa (wcel N cn0) (wrex p (wceq S (crab t (wrex w (wceq (cfv (cun (cv t) (cv w)) (cv p)) cc0) (co cn0 W cmap)) (co cn0 (co c1 N cfz) cmap))) (cfv (cun W (co c1 N cfz)) cmzp))) $;

--| Forward-only version of ~ eldioph4b . (Contributed by Stefan O'Rear, 16-Oct-2014.)
theorem eldioph4i {w t: setvar} (P N W: class):
  $ wcel W cvv $ >
  $ wn (wcel W cfn) $ >
  $ wceq (cin W cn) c0 $ >
  $ wi (wa (wcel N cn0) (wcel P (cfv (cun W (co c1 N cfz)) cmzp))) (wcel (crab t (wrex w (wceq (cfv (cun (cv t) (cv w)) P) cc0) (co cn0 W cmap)) (co cn0 (co c1 N cfz) cmap)) (cfv N cdioph)) $;

--| Change variables in a Diophantine set, using class notation. This allows already proved Diophantine sets to be reused in contexts with more variables. (Contributed by Stefan O'Rear, 16-Oct-2014.) (Revised by Stefan O'Rear, 5-Jun-2015.)
theorem diophren {a: setvar} (S F M N: class):
  $ wi (w3a (wcel S (cfv N cdioph)) (wcel M cn0) (wf (co c1 N cfz) (co c1 M cfz) F)) (wcel (crab a (wcel (ccom (cv a) F) S) (co cn0 (co c1 M cfz) cmap)) (cfv M cdioph)) $;

--| Change variable numbers in a Diophantine class abstraction using explicit substitution. (Contributed by Stefan O'Rear, 17-Oct-2014.)
theorem rabrenfdioph {a b: setvar} (ph: wff a) (A2 B2 F: class):
  $ wi (w3a (wcel B2 cn0) (wf (co c1 A2 cfz) (co c1 B2 cfz) F) (wcel (crab a ph (co cn0 (co c1 A2 cfz) cmap)) (cfv A2 cdioph))) (wcel (crab b (wsbc a ph (ccom (cv b) F)) (co cn0 (co c1 B2 cfz) cmap)) (cfv B2 cdioph)) $;

--| Change variable numbers in a 3-variable Diophantine class abstraction. (Contributed by Stefan O'Rear, 17-Oct-2014.)
theorem rabren3dioph {a b: setvar} (ph: wff a) (ps: wff b) (N X Y Z: class):
  $ wi (w3a (wceq (cfv c1 (cv a)) (cfv X (cv b))) (wceq (cfv c2 (cv a)) (cfv Y (cv b))) (wceq (cfv c3 (cv a)) (cfv Z (cv b)))) (wb ph ps) $ >
  $ wcel X (co c1 N cfz) $ >
  $ wcel Y (co c1 N cfz) $ >
  $ wcel Z (co c1 N cfz) $ >
  $ wi (wa (wcel N cn0) (wcel (crab a ph (co cn0 (co c1 c3 cfz) cmap)) (cfv c3 cdioph))) (wcel (crab b ps (co cn0 (co c1 N cfz) cmap)) (cfv N cdioph)) $;

--| Pigeonhole principle expressed with implicit substitution. If the range is smaller than the domain, two inputs must be mapped to the same output. (Contributed by Stefan O'Rear, 19-Oct-2014.) (Revised by Stefan O'Rear, 6-May-2015.)
theorem fphpd {x3 y1: setvar} (ph: wff) (A2 B2: class) (C: class x3) (D: class y1):
  $ wi ph (wbr B2 A2 csdm) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C B2) $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq C D) $ >
  $ wi ph (wrex x3 (wrex y1 (wa (wne (cv x3) (cv y1)) (wceq C D)) A2) A2) $;

--| Pigeonhole principle for sets of real numbers with implicit output reordering. (Contributed by Stefan O'Rear, 12-Sep-2014.)
theorem fphpdo {x3 y1 z: setvar} (ph: wff) (A2: class) (B2: class x3 y1) (C: class z) (D: class x3) (E: class y1):
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wcel B2 cvv) $ >
  $ wi ph (wbr B2 A2 csdm) $ >
  $ wi (wa ph (wcel (cv z) A2)) (wcel C B2) $ >
  $ wi (wceq (cv z) (cv x3)) (wceq C D) $ >
  $ wi (wceq (cv z) (cv y1)) (wceq C E) $ >
  $ wi ph (wrex x3 (wrex y1 (wa (wbr (cv x3) (cv y1) clt) (wceq D E)) A2) A2) $;

--| An infinite subset of a countable set is countable, without using choice. (Contributed by Stefan O'Rear, 19-Oct-2014.) (Revised by Stefan O'Rear, 6-May-2015.)
theorem ctbnfien (A2 X Y: class):
  $ wi (wa (wa (wbr X com cen) (wbr Y com cen)) (wa (wss A2 X) (wn (wcel A2 cfn)))) (wbr A2 Y cen) $;

--| Infinite pigeonhole principle for partitioning an infinite set between finitely many buckets. (Contributed by Stefan O'Rear, 18-Oct-2014.)
theorem fiphp3d {x3 y1: setvar} (ph: wff) (A2 B2: class) (D: class x3):
  $ wi ph (wbr A2 cn cen) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel D B2) $ >
  $ wi ph (wrex y1 (wbr (crab x3 (wceq D (cv y1)) A2) cn cen) B2) $;

--| Lemma for ~ rencldnfi . (Contributed by Stefan O'Rear, 18-Oct-2014.)
theorem rencldnfilem {x3 y1: setvar} (A2 B2: class):
  $ wi (wa (w3a (wss A2 cr) (wcel B2 cr) (wa (wne A2 c0) (wn (wcel B2 A2)))) (wral x3 (wrex y1 (wbr (cfv (co (cv y1) B2 cmin) cabs) (cv x3) clt) A2) crp)) (wn (wcel A2 cfn)) $;

--| A set of real numbers which comes arbitrarily close to some target yet excludes it is infinite. The work is done in ~ rencldnfilem using infima; this theorem removes the requirement that A be nonempty. (Contributed by Stefan O'Rear, 19-Oct-2014.)
theorem rencldnfi {x3 y1: setvar} (A2 B2: class):
  $ wi (wa (w3a (wss A2 cr) (wcel B2 cr) (wn (wcel B2 A2))) (wral x3 (wrex y1 (wbr (cfv (co (cv y1) B2 cmin) cabs) (cv x3) clt) A2) crp)) (wn (wcel A2 cfn)) $;

--| Lemma for ~ irrapx1 . Divides the unit interval into ` B ` half-open sections and using the pigeonhole principle ~ fphpdo finds two multiples of ` A ` in the same section mod 1. (Contributed by Stefan O'Rear, 12-Sep-2014.)
theorem irrapxlem1 {x3 y1: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 crp) (wcel B2 cn)) (wrex x3 (wrex y1 (wa (wbr (cv x3) (cv y1) clt) (wceq (cfv (co B2 (co (co A2 (cv x3) cmul) c1 cmo) cmul) cfl) (cfv (co B2 (co (co A2 (cv y1) cmul) c1 cmo) cmul) cfl))) (co cc0 B2 cfz)) (co cc0 B2 cfz)) $;

--| Lemma for ~ irrapx1 . Two multiples in the same bucket means they are very close mod 1. (Contributed by Stefan O'Rear, 12-Sep-2014.)
theorem irrapxlem2 {x3 y1: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 crp) (wcel B2 cn)) (wrex x3 (wrex y1 (wa (wbr (cv x3) (cv y1) clt) (wbr (cfv (co (co (co A2 (cv x3) cmul) c1 cmo) (co (co A2 (cv y1) cmul) c1 cmo) cmin) cabs) (co c1 B2 cdiv) clt)) (co cc0 B2 cfz)) (co cc0 B2 cfz)) $;

--| Lemma for ~ irrapx1 . By subtraction, there is a multiple very close to an integer. (Contributed by Stefan O'Rear, 13-Sep-2014.)
theorem irrapxlem3 {x3 y1: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 crp) (wcel B2 cn)) (wrex x3 (wrex y1 (wbr (cfv (co (co A2 (cv x3) cmul) (cv y1) cmin) cabs) (co c1 B2 cdiv) clt) cn0) (co c1 B2 cfz)) $;

--| Lemma for ~ irrapx1 . Eliminate ranges, use positivity of the input to force positivity of the output by increasing ` B ` as needed. (Contributed by Stefan O'Rear, 13-Sep-2014.)
theorem irrapxlem4 {x3 y1: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 crp) (wcel B2 cn)) (wrex x3 (wrex y1 (wbr (cfv (co (co A2 (cv x3) cmul) (cv y1) cmin) cabs) (co c1 (cif (wbr (cv x3) B2 cle) B2 (cv x3)) cdiv) clt) cn) cn) $;

--| Lemma for ~ irrapx1 . Switching to real intervals and fraction syntax. (Contributed by Stefan O'Rear, 13-Sep-2014.)
theorem irrapxlem5 {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 crp) (wcel B2 crp)) (wrex x3 (w3a (wbr cc0 (cv x3) clt) (wbr (cfv (co (cv x3) A2 cmin) cabs) B2 clt) (wbr (cfv (co (cv x3) A2 cmin) cabs) (co (cfv (cv x3) cdenom) (cneg c2) cexp) clt)) cq) $;

--| Lemma for ~ irrapx1 . Explicit description of a non-closed set. (Contributed by Stefan O'Rear, 13-Sep-2014.)
theorem irrapxlem6 {x3 y1: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 crp) (wcel B2 crp)) (wrex x3 (wbr (cfv (co (cv x3) A2 cmin) cabs) B2 clt) (crab y1 (wa (wbr cc0 (cv y1) clt) (wbr (cfv (co (cv y1) A2 cmin) cabs) (co (cfv (cv y1) cdenom) (cneg c2) cexp) clt)) cq)) $;

--| Dirichlet's approximation theorem. Every positive irrational number has infinitely many rational approximations which are closer than the inverse squares of their reduced denominators. Lemma 61 in [vandenDries] p. 42. (Contributed by Stefan O'Rear, 14-Sep-2014.)
theorem irrapx1 {y1: setvar} (A2: class):
  $ wi (wcel A2 (cdif crp cq)) (wbr (crab y1 (wa (wbr cc0 (cv y1) clt) (wbr (cfv (co (cv y1) A2 cmin) cabs) (co (cfv (cv y1) cdenom) (cneg c2) cexp) clt)) cq) cn cen) $;

--| Lemma for ~ pellex . Arithmetical core of pellexlem3, norm lower bound. This begins Dirichlet's proof of the Pell equation solution existence; the proof here follows theorem 62 of [vandenDries] p. 43. (Contributed by Stefan O'Rear, 14-Sep-2014.)
theorem pellexlem1 (A2 B2 D: class):
  $ wi (wa (w3a (wcel D cn) (wcel A2 cn) (wcel B2 cn)) (wn (wcel (cfv D csqrt) cq))) (wne (co (co A2 c2 cexp) (co D (co B2 c2 cexp) cmul) cmin) cc0) $;

--| Lemma for ~ pellex . Arithmetical core of pellexlem3, norm upper bound. (Contributed by Stefan O'Rear, 14-Sep-2014.)
theorem pellexlem2 (A2 B2 D: class):
  $ wi (wa (w3a (wcel D cn) (wcel A2 cn) (wcel B2 cn)) (wbr (cfv (co (co A2 B2 cdiv) (cfv D csqrt) cmin) cabs) (co B2 (cneg c2) cexp) clt)) (wbr (cfv (co (co A2 c2 cexp) (co D (co B2 c2 cexp) cmul) cmin) cabs) (co c1 (co c2 (cfv D csqrt) cmul) caddc) clt) $;

--| Lemma for ~ pellex . To each good rational approximation of ` ( sqrt `` D ) ` , there exists a near-solution. (Contributed by Stefan O'Rear, 14-Sep-2014.)
theorem pellexlem3 {x3 y1 z: setvar} (D: class):
  $ wi (wa (wcel D cn) (wn (wcel (cfv D csqrt) cq))) (wbr (crab x3 (wa (wbr cc0 (cv x3) clt) (wbr (cfv (co (cv x3) (cfv D csqrt) cmin) cabs) (co (cfv (cv x3) cdenom) (cneg c2) cexp) clt)) cq) (copab y1 z (wa (wa (wcel (cv y1) cn) (wcel (cv z) cn)) (wa (wne (co (co (cv y1) c2 cexp) (co D (co (cv z) c2 cexp) cmul) cmin) cc0) (wbr (cfv (co (co (cv y1) c2 cexp) (co D (co (cv z) c2 cexp) cmul) cmin) cabs) (co c1 (co c2 (cfv D csqrt) cmul) caddc) clt)))) cdom) $;

--| Lemma for ~ pellex . Invoking ~ irrapx1 , we have infinitely many near-solutions. (Contributed by Stefan O'Rear, 14-Sep-2014.)
theorem pellexlem4 {y1 z: setvar} (D: class):
  $ wi (wa (wcel D cn) (wn (wcel (cfv D csqrt) cq))) (wbr (copab y1 z (wa (wa (wcel (cv y1) cn) (wcel (cv z) cn)) (wa (wne (co (co (cv y1) c2 cexp) (co D (co (cv z) c2 cexp) cmul) cmin) cc0) (wbr (cfv (co (co (cv y1) c2 cexp) (co D (co (cv z) c2 cexp) cmul) cmin) cabs) (co c1 (co c2 (cfv D csqrt) cmul) caddc) clt)))) cn cen) $;

--| Lemma for ~ pellex . Invoking ~ fiphp3d , we have infinitely many near-solutions for some specific norm. (Contributed by Stefan O'Rear, 19-Oct-2014.)
theorem pellexlem5 {x3 y1 z: setvar} (D: class):
  $ wi (wa (wcel D cn) (wn (wcel (cfv D csqrt) cq))) (wrex x3 (wa (wne (cv x3) cc0) (wbr (copab y1 z (wa (wa (wcel (cv y1) cn) (wcel (cv z) cn)) (wceq (co (co (cv y1) c2 cexp) (co D (co (cv z) c2 cexp) cmul) cmin) (cv x3)))) cn cen)) cz) $;

--| Lemma for ~ pellex . Doing a field division between near solutions get us to norm 1, and the modularity constraint ensures we still have an integer. Returning NN guarantees that we are not returning the trivial solution (1,0). We are not explicitly defining the Pell-field, Pell-ring, and Pell-norm explicitly because after this construction is done we will never use them. This is mostly basic algebraic number theory and could be simplified if a generic framework for that were in place. (Contributed by Stefan O'Rear, 19-Oct-2014.)
theorem pellexlem6 {a b: setvar} (ph: wff) (A2 B2 C D E F: class):
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wcel C cz) $ >
  $ wi ph (wcel D cn) $ >
  $ wi ph (wn (wcel (cfv D csqrt) cq)) $ >
  $ wi ph (wcel E cn) $ >
  $ wi ph (wcel F cn) $ >
  $ wi ph (wn (wa (wceq A2 E) (wceq B2 F))) $ >
  $ wi ph (wne C cc0) $ >
  $ wi ph (wceq (co (co A2 c2 cexp) (co D (co B2 c2 cexp) cmul) cmin) C) $ >
  $ wi ph (wceq (co (co E c2 cexp) (co D (co F c2 cexp) cmul) cmin) C) $ >
  $ wi ph (wceq (co A2 (cfv C cabs) cmo) (co E (cfv C cabs) cmo)) $ >
  $ wi ph (wceq (co B2 (cfv C cabs) cmo) (co F (cfv C cabs) cmo)) $ >
  $ wi ph (wrex a (wrex b (wceq (co (co (cv a) c2 cexp) (co D (co (cv b) c2 cexp) cmul) cmin) c1) cn) cn) $;

--| Every Pell equation has a nontrivial solution. Theorem 62 in [vandenDries] p. 43. (Contributed by Stefan O'Rear, 19-Oct-2014.)
theorem pellex {x3 y1: setvar} (D: class):
  $ wi (wa (wcel D cn) (wn (wcel (cfv D csqrt) cq))) (wrex x3 (wrex y1 (wceq (co (co (cv x3) c2 cexp) (co D (co (cv y1) c2 cexp) cmul) cmin) c1) cn) cn) $;

--| Extend class notation to include the set of square positive integers.
term csquarenn: class;

--| Extend class notation to include the class of quadrant-1 Pell solutions.
term cpell1qr: class;

--| Extend class notation to include the class of any-quadrant Pell solutions.
term cpell1234qr: class;

--| Extend class notation to include the class of positive Pell solutions.
term cpell14qr: class;

--| Extend class notation to include the Pell-equation fundamental solution function.
term cpellfund: class;

--| Define the set of square positive integers. (Contributed by Stefan O'Rear, 18-Sep-2014.)
axiom df_squarenn {x3: setvar}:
  $ wceq csquarenn (crab x3 (wcel (cfv (cv x3) csqrt) cq) cn) $;

--| Define the solutions of a Pell equation in the first quadrant. To avoid pair pain, we represent this via the canonical embedding into the reals. (Contributed by Stefan O'Rear, 17-Sep-2014.)
axiom df_pell1qr {x3 y1 z w: setvar}:
  $ wceq cpell1qr (cmpt x3 (cdif cn csquarenn) (crab y1 (wrex z (wrex w (wa (wceq (cv y1) (co (cv z) (co (cfv (cv x3) csqrt) (cv w) cmul) caddc)) (wceq (co (co (cv z) c2 cexp) (co (cv x3) (co (cv w) c2 cexp) cmul) cmin) c1)) cn0) cn0) cr)) $;

--| Define the positive solutions of a Pell equation. (Contributed by Stefan O'Rear, 17-Sep-2014.)
axiom df_pell14qr {x3 y1 z w: setvar}:
  $ wceq cpell14qr (cmpt x3 (cdif cn csquarenn) (crab y1 (wrex z (wrex w (wa (wceq (cv y1) (co (cv z) (co (cfv (cv x3) csqrt) (cv w) cmul) caddc)) (wceq (co (co (cv z) c2 cexp) (co (cv x3) (co (cv w) c2 cexp) cmul) cmin) c1)) cz) cn0) cr)) $;

--| Define the general solutions of a Pell equation. (Contributed by Stefan O'Rear, 17-Sep-2014.)
axiom df_pell1234qr {x3 y1 z w: setvar}:
  $ wceq cpell1234qr (cmpt x3 (cdif cn csquarenn) (crab y1 (wrex z (wrex w (wa (wceq (cv y1) (co (cv z) (co (cfv (cv x3) csqrt) (cv w) cmul) caddc)) (wceq (co (co (cv z) c2 cexp) (co (cv x3) (co (cv w) c2 cexp) cmul) cmin) c1)) cz) cz) cr)) $;

--| A function mapping Pell discriminants to the corresponding fundamental solution. (Contributed by Stefan O'Rear, 18-Sep-2014.) (Revised by AV, 17-Sep-2020.)
axiom df_pellfund {x3 z: setvar}:
  $ wceq cpellfund (cmpt x3 (cdif cn csquarenn) (cinf (crab z (wbr c1 (cv z) clt) (cfv (cv x3) cpell14qr)) cr clt)) $;

--| Value of the set of first-quadrant Pell solutions. (Contributed by Stefan O'Rear, 17-Sep-2014.)
theorem pell1qrval {y1 z w: setvar} (D: class):
  $ wi (wcel D (cdif cn csquarenn)) (wceq (cfv D cpell1qr) (crab y1 (wrex z (wrex w (wa (wceq (cv y1) (co (cv z) (co (cfv D csqrt) (cv w) cmul) caddc)) (wceq (co (co (cv z) c2 cexp) (co D (co (cv w) c2 cexp) cmul) cmin) c1)) cn0) cn0) cr)) $;

--| Membership in a first-quadrant Pell solution set. (Contributed by Stefan O'Rear, 17-Sep-2014.)
theorem elpell1qr {z w: setvar} (A2 D: class):
  $ wi (wcel D (cdif cn csquarenn)) (wb (wcel A2 (cfv D cpell1qr)) (wa (wcel A2 cr) (wrex z (wrex w (wa (wceq A2 (co (cv z) (co (cfv D csqrt) (cv w) cmul) caddc)) (wceq (co (co (cv z) c2 cexp) (co D (co (cv w) c2 cexp) cmul) cmin) c1)) cn0) cn0))) $;

--| Value of the set of positive Pell solutions. (Contributed by Stefan O'Rear, 17-Sep-2014.)
theorem pell14qrval {y1 z w: setvar} (D: class):
  $ wi (wcel D (cdif cn csquarenn)) (wceq (cfv D cpell14qr) (crab y1 (wrex z (wrex w (wa (wceq (cv y1) (co (cv z) (co (cfv D csqrt) (cv w) cmul) caddc)) (wceq (co (co (cv z) c2 cexp) (co D (co (cv w) c2 cexp) cmul) cmin) c1)) cz) cn0) cr)) $;

--| Membership in the set of positive Pell solutions. (Contributed by Stefan O'Rear, 17-Sep-2014.)
theorem elpell14qr {z w: setvar} (A2 D: class):
  $ wi (wcel D (cdif cn csquarenn)) (wb (wcel A2 (cfv D cpell14qr)) (wa (wcel A2 cr) (wrex z (wrex w (wa (wceq A2 (co (cv z) (co (cfv D csqrt) (cv w) cmul) caddc)) (wceq (co (co (cv z) c2 cexp) (co D (co (cv w) c2 cexp) cmul) cmin) c1)) cz) cn0))) $;

--| Value of the set of general Pell solutions. (Contributed by Stefan O'Rear, 17-Sep-2014.)
theorem pell1234qrval {y1 z w: setvar} (D: class):
  $ wi (wcel D (cdif cn csquarenn)) (wceq (cfv D cpell1234qr) (crab y1 (wrex z (wrex w (wa (wceq (cv y1) (co (cv z) (co (cfv D csqrt) (cv w) cmul) caddc)) (wceq (co (co (cv z) c2 cexp) (co D (co (cv w) c2 cexp) cmul) cmin) c1)) cz) cz) cr)) $;

--| Membership in the set of general Pell solutions. (Contributed by Stefan O'Rear, 17-Sep-2014.)
theorem elpell1234qr {z w: setvar} (A2 D: class):
  $ wi (wcel D (cdif cn csquarenn)) (wb (wcel A2 (cfv D cpell1234qr)) (wa (wcel A2 cr) (wrex z (wrex w (wa (wceq A2 (co (cv z) (co (cfv D csqrt) (cv w) cmul) caddc)) (wceq (co (co (cv z) c2 cexp) (co D (co (cv w) c2 cexp) cmul) cmin) c1)) cz) cz))) $;

--| General Pell solutions are (coded as) real numbers. (Contributed by Stefan O'Rear, 17-Sep-2014.)
theorem pell1234qrre (A2 D: class):
  $ wi (wa (wcel D (cdif cn csquarenn)) (wcel A2 (cfv D cpell1234qr))) (wcel A2 cr) $;

--| No solution to a Pell equation is zero. (Contributed by Stefan O'Rear, 17-Sep-2014.)
theorem pell1234qrne0 (A2 D: class):
  $ wi (wa (wcel D (cdif cn csquarenn)) (wcel A2 (cfv D cpell1234qr))) (wne A2 cc0) $;

--| General solutions of the Pell equation are closed under reciprocals. (Contributed by Stefan O'Rear, 18-Sep-2014.)
theorem pell1234qrreccl (A2 D: class):
  $ wi (wa (wcel D (cdif cn csquarenn)) (wcel A2 (cfv D cpell1234qr))) (wcel (co c1 A2 cdiv) (cfv D cpell1234qr)) $;

--| General solutions of the Pell equation are closed under multiplication. (Contributed by Stefan O'Rear, 18-Sep-2014.)
theorem pell1234qrmulcl (A2 B2 D: class):
  $ wi (w3a (wcel D (cdif cn csquarenn)) (wcel A2 (cfv D cpell1234qr)) (wcel B2 (cfv D cpell1234qr))) (wcel (co A2 B2 cmul) (cfv D cpell1234qr)) $;

--| A positive Pell solution is a general Pell solution. (Contributed by Stefan O'Rear, 18-Sep-2014.)
theorem pell14qrss1234 (D: class):
  $ wi (wcel D (cdif cn csquarenn)) (wss (cfv D cpell14qr) (cfv D cpell1234qr)) $;

--| A positive Pell solution is a real number. (Contributed by Stefan O'Rear, 18-Sep-2014.)
theorem pell14qrre (A2 D: class):
  $ wi (wa (wcel D (cdif cn csquarenn)) (wcel A2 (cfv D cpell14qr))) (wcel A2 cr) $;

--| A positive Pell solution is a nonzero number. (Contributed by Stefan O'Rear, 17-Sep-2014.)
theorem pell14qrne0 (A2 D: class):
  $ wi (wa (wcel D (cdif cn csquarenn)) (wcel A2 (cfv D cpell14qr))) (wne A2 cc0) $;

--| A positive Pell solution is a positive number. (Contributed by Stefan O'Rear, 18-Sep-2014.)
theorem pell14qrgt0 (A2 D: class):
  $ wi (wa (wcel D (cdif cn csquarenn)) (wcel A2 (cfv D cpell14qr))) (wbr cc0 A2 clt) $;

--| A positive Pell solution is a positive real. (Contributed by Stefan O'Rear, 19-Sep-2014.)
theorem pell14qrrp (A2 D: class):
  $ wi (wa (wcel D (cdif cn csquarenn)) (wcel A2 (cfv D cpell14qr))) (wcel A2 crp) $;

--| A general Pell solution is either a positive solution, or its negation is. (Contributed by Stefan O'Rear, 18-Sep-2014.)
theorem pell1234qrdich (A2 D: class):
  $ wi (wa (wcel D (cdif cn csquarenn)) (wcel A2 (cfv D cpell1234qr))) (wo (wcel A2 (cfv D cpell14qr)) (wcel (cneg A2) (cfv D cpell14qr))) $;

--| A number is a positive Pell solution iff it is positive and a Pell solution, justifying our name choice. (Contributed by Stefan O'Rear, 19-Oct-2014.)
theorem elpell14qr2 (A2 D: class):
  $ wi (wcel D (cdif cn csquarenn)) (wb (wcel A2 (cfv D cpell14qr)) (wa (wcel A2 (cfv D cpell1234qr)) (wbr cc0 A2 clt))) $;

--| Positive Pell solutions are closed under multiplication. (Contributed by Stefan O'Rear, 17-Sep-2014.)
theorem pell14qrmulcl (A2 B2 D: class):
  $ wi (w3a (wcel D (cdif cn csquarenn)) (wcel A2 (cfv D cpell14qr)) (wcel B2 (cfv D cpell14qr))) (wcel (co A2 B2 cmul) (cfv D cpell14qr)) $;

--| Positive Pell solutions are closed under reciprocal. (Contributed by Stefan O'Rear, 18-Sep-2014.)
theorem pell14qrreccl (A2 D: class):
  $ wi (wa (wcel D (cdif cn csquarenn)) (wcel A2 (cfv D cpell14qr))) (wcel (co c1 A2 cdiv) (cfv D cpell14qr)) $;

--| Positive Pell solutions are closed under division. (Contributed by Stefan O'Rear, 18-Sep-2014.)
theorem pell14qrdivcl (A2 B2 D: class):
  $ wi (w3a (wcel D (cdif cn csquarenn)) (wcel A2 (cfv D cpell14qr)) (wcel B2 (cfv D cpell14qr))) (wcel (co A2 B2 cdiv) (cfv D cpell14qr)) $;

--| Lemma for ~ pell14qrexpcl . (Contributed by Stefan O'Rear, 18-Sep-2014.)
theorem pell14qrexpclnn0 (A2 B2 D: class):
  $ wi (w3a (wcel D (cdif cn csquarenn)) (wcel A2 (cfv D cpell14qr)) (wcel B2 cn0)) (wcel (co A2 B2 cexp) (cfv D cpell14qr)) $;

--| Positive Pell solutions are closed under integer powers. (Contributed by Stefan O'Rear, 18-Sep-2014.)
theorem pell14qrexpcl (A2 B2 D: class):
  $ wi (w3a (wcel D (cdif cn csquarenn)) (wcel A2 (cfv D cpell14qr)) (wcel B2 cz)) (wcel (co A2 B2 cexp) (cfv D cpell14qr)) $;

--| First-quadrant Pell solutions are a subset of the positive solutions. (Contributed by Stefan O'Rear, 18-Sep-2014.)
theorem pell1qrss14 (D: class):
  $ wi (wcel D (cdif cn csquarenn)) (wss (cfv D cpell1qr) (cfv D cpell14qr)) $;

--| A positive Pell solution is either in the first quadrant, or its reciprocal is. (Contributed by Stefan O'Rear, 18-Sep-2014.)
theorem pell14qrdich (A2 D: class):
  $ wi (wa (wcel D (cdif cn csquarenn)) (wcel A2 (cfv D cpell14qr))) (wo (wcel A2 (cfv D cpell1qr)) (wcel (co c1 A2 cdiv) (cfv D cpell1qr))) $;

--| A Pell solution in the first quadrant is at least 1. (Contributed by Stefan O'Rear, 17-Sep-2014.)
theorem pell1qrge1 (A2 D: class):
  $ wi (wa (wcel D (cdif cn csquarenn)) (wcel A2 (cfv D cpell1qr))) (wbr c1 A2 cle) $;

--| 1 is a Pell solution and in the first quadrant as one. (Contributed by Stefan O'Rear, 17-Sep-2014.)
theorem pell1qr1 (D: class):
  $ wi (wcel D (cdif cn csquarenn)) (wcel c1 (cfv D cpell1qr)) $;

--| The first quadrant solutions are precisely the positive Pell solutions which are at least one. (Contributed by Stefan O'Rear, 18-Sep-2014.)
theorem elpell1qr2 (A2 D: class):
  $ wi (wcel D (cdif cn csquarenn)) (wb (wcel A2 (cfv D cpell1qr)) (wa (wcel A2 (cfv D cpell14qr)) (wbr c1 A2 cle))) $;

--| Lemma for ~ pell1qrgap . (Contributed by Stefan O'Rear, 18-Sep-2014.)
theorem pell1qrgaplem (A2 B2 D: class):
  $ wi (wa (wa (wcel D cn) (wa (wcel A2 cn0) (wcel B2 cn0))) (wa (wbr c1 (co A2 (co (cfv D csqrt) B2 cmul) caddc) clt) (wceq (co (co A2 c2 cexp) (co D (co B2 c2 cexp) cmul) cmin) c1))) (wbr (co (cfv (co D c1 caddc) csqrt) (cfv D csqrt) caddc) (co A2 (co (cfv D csqrt) B2 cmul) caddc) cle) $;

--| First-quadrant Pell solutions are bounded away from 1. (This particular bound allows to prove exact values for the fundamental solution later.) (Contributed by Stefan O'Rear, 18-Sep-2014.)
theorem pell1qrgap (A2 D: class):
  $ wi (w3a (wcel D (cdif cn csquarenn)) (wcel A2 (cfv D cpell1qr)) (wbr c1 A2 clt)) (wbr (co (cfv (co D c1 caddc) csqrt) (cfv D csqrt) caddc) A2 cle) $;

--| Positive Pell solutions are bounded away from 1. (Contributed by Stefan O'Rear, 18-Sep-2014.)
theorem pell14qrgap (A2 D: class):
  $ wi (w3a (wcel D (cdif cn csquarenn)) (wcel A2 (cfv D cpell14qr)) (wbr c1 A2 clt)) (wbr (co (cfv (co D c1 caddc) csqrt) (cfv D csqrt) caddc) A2 cle) $;

--| Positive Pell solutions are bounded away from 1, with a friendlier bound. (Contributed by Stefan O'Rear, 18-Sep-2014.)
theorem pell14qrgapw (A2 D: class):
  $ wi (w3a (wcel D (cdif cn csquarenn)) (wcel A2 (cfv D cpell14qr)) (wbr c1 A2 clt)) (wbr c2 A2 clt) $;

--| Condition for a calculated real to be a Pell solution. (Contributed by Stefan O'Rear, 19-Sep-2014.)
theorem pellqrexplicit (A2 B2 D: class):
  $ wi (wa (w3a (wcel D (cdif cn csquarenn)) (wcel A2 cn0) (wcel B2 cn0)) (wceq (co (co A2 c2 cexp) (co D (co B2 c2 cexp) cmul) cmin) c1)) (wcel (co A2 (co (cfv D csqrt) B2 cmul) caddc) (cfv D cpell1qr)) $;

--| Any lower bound of a nonempty set of real numbers is less than or equal to its infimum, one-direction version. (Contributed by Stefan O'Rear, 1-Sep-2013.) (Revised by AV, 17-Sep-2020.)
theorem infmrgelbi {x3: setvar} (A2 B2: class):
  $ wi (wa (w3a (wss A2 cr) (wne A2 c0) (wcel B2 cr)) (wral x3 (wbr B2 (cv x3) cle) A2)) (wbr B2 (cinf A2 cr clt) cle) $;

--| There is a nontrivial solution of a Pell equation in the first quadrant. (Contributed by Stefan O'Rear, 18-Sep-2014.)
theorem pellqrex {x3: setvar} (D: class):
  $ wi (wcel D (cdif cn csquarenn)) (wrex x3 (wbr c1 (cv x3) clt) (cfv D cpell1qr)) $;

--| Value of the fundamental solution of a Pell equation. (Contributed by Stefan O'Rear, 18-Sep-2014.) (Revised by AV, 17-Sep-2020.)
theorem pellfundval {x3: setvar} (D: class):
  $ wi (wcel D (cdif cn csquarenn)) (wceq (cfv D cpellfund) (cinf (crab x3 (wbr c1 (cv x3) clt) (cfv D cpell14qr)) cr clt)) $;

--| The fundamental solution of a Pell equation exists as a real number. (Contributed by Stefan O'Rear, 18-Sep-2014.)
theorem pellfundre (D: class):
  $ wi (wcel D (cdif cn csquarenn)) (wcel (cfv D cpellfund) cr) $;

--| Lower bound on the fundamental solution of a Pell equation. (Contributed by Stefan O'Rear, 19-Sep-2014.)
theorem pellfundge (D: class):
  $ wi (wcel D (cdif cn csquarenn)) (wbr (co (cfv (co D c1 caddc) csqrt) (cfv D csqrt) caddc) (cfv D cpellfund) cle) $;

--| Weak lower bound on the Pell fundamental solution. (Contributed by Stefan O'Rear, 19-Sep-2014.)
theorem pellfundgt1 (D: class):
  $ wi (wcel D (cdif cn csquarenn)) (wbr c1 (cfv D cpellfund) clt) $;

--| A nontrivial first quadrant solution is at least as large as the fundamental solution. (Contributed by Stefan O'Rear, 19-Sep-2014.) (Proof shortened by AV, 15-Sep-2020.)
theorem pellfundlb (A2 D: class):
  $ wi (w3a (wcel D (cdif cn csquarenn)) (wcel A2 (cfv D cpell14qr)) (wbr c1 A2 clt)) (wbr (cfv D cpellfund) A2 cle) $;

--| If a real is larger than the fundamental solution, there is a nontrivial solution less than it. (Contributed by Stefan O'Rear, 18-Sep-2014.)
theorem pellfundglb {x3: setvar} (A2 D: class):
  $ wi (w3a (wcel D (cdif cn csquarenn)) (wcel A2 cr) (wbr (cfv D cpellfund) A2 clt)) (wrex x3 (wa (wbr (cfv D cpellfund) (cv x3) cle) (wbr (cv x3) A2 clt)) (cfv D cpell1qr)) $;

--| The fundamental solution as an infimum is itself a solution, showing that the solution set is discrete. Since the fundamental solution is an infimum, there must be an element ge to Fund and lt 2*Fund. If this element is equal to the fundamental solution we're done, otherwise use the infimum again to find another element which must be ge Fund and lt the first element; their ratio is a group element in (1,2), contradicting ~ pell14qrgapw . (Contributed by Stefan O'Rear, 18-Sep-2014.)
theorem pellfundex (D: class):
  $ wi (wcel D (cdif cn csquarenn)) (wcel (cfv D cpellfund) (cfv D cpell1qr)) $;

--| There are no solutions between 1 and the fundamental solution. (Contributed by Stefan O'Rear, 18-Sep-2014.)
theorem pellfund14gap (A2 D: class):
  $ wi (w3a (wcel D (cdif cn csquarenn)) (wcel A2 (cfv D cpell14qr)) (wa (wbr c1 A2 cle) (wbr A2 (cfv D cpellfund) clt))) (wceq A2 c1) $;

--| The fundamental Pell solution is a positive real. (Contributed by Stefan O'Rear, 19-Sep-2014.)
theorem pellfundrp (D: class):
  $ wi (wcel D (cdif cn csquarenn)) (wcel (cfv D cpellfund) crp) $;

--| The fundamental Pell solution is never 1. (Contributed by Stefan O'Rear, 19-Sep-2014.)
theorem pellfundne1 (D: class):
  $ wi (wcel D (cdif cn csquarenn)) (wne (cfv D cpellfund) c1) $;

--| General logarithm is a real number. (Contributed by Stefan O'Rear, 19-Sep-2014.) (New usage is discouraged.) Use ~ relogbcl instead.
theorem reglogcl (A2 B2: class):
  $ wi (w3a (wcel A2 crp) (wcel B2 crp) (wne B2 c1)) (wcel (co (cfv A2 clog) (cfv B2 clog) cdiv) cr) $;

--| General logarithm preserves "less than". (Contributed by Stefan O'Rear, 19-Sep-2014.) (New usage is discouraged.) Use ~ logblt instead.
theorem reglogltb (A2 B2 C: class):
  $ wi (wa (wa (wcel A2 crp) (wcel B2 crp)) (wa (wcel C crp) (wbr c1 C clt))) (wb (wbr A2 B2 clt) (wbr (co (cfv A2 clog) (cfv C clog) cdiv) (co (cfv B2 clog) (cfv C clog) cdiv) clt)) $;

--| General logarithm preserves ` <_ ` . (Contributed by Stefan O'Rear, 19-Oct-2014.) (New usage is discouraged.) Use ~ logbleb instead.
theorem reglogleb (A2 B2 C: class):
  $ wi (wa (wa (wcel A2 crp) (wcel B2 crp)) (wa (wcel C crp) (wbr c1 C clt))) (wb (wbr A2 B2 cle) (wbr (co (cfv A2 clog) (cfv C clog) cdiv) (co (cfv B2 clog) (cfv C clog) cdiv) cle)) $;

--| Multiplication law for general log. (Contributed by Stefan O'Rear, 19-Sep-2014.) (New usage is discouraged.) Use ~ relogbmul instead.
theorem reglogmul (A2 B2 C: class):
  $ wi (w3a (wcel A2 crp) (wcel B2 crp) (wa (wcel C crp) (wne C c1))) (wceq (co (cfv (co A2 B2 cmul) clog) (cfv C clog) cdiv) (co (co (cfv A2 clog) (cfv C clog) cdiv) (co (cfv B2 clog) (cfv C clog) cdiv) caddc)) $;

--| Power law for general log. (Contributed by Stefan O'Rear, 19-Sep-2014.) (New usage is discouraged.) Use ~ relogbzexp instead.
theorem reglogexp (A2 C N: class):
  $ wi (w3a (wcel A2 crp) (wcel N cz) (wa (wcel C crp) (wne C c1))) (wceq (co (cfv (co A2 N cexp) clog) (cfv C clog) cdiv) (co N (co (cfv A2 clog) (cfv C clog) cdiv) cmul)) $;

--| General log of the base is 1. (Contributed by Stefan O'Rear, 19-Sep-2014.) (New usage is discouraged.) Use ~ logbid1 instead.
theorem reglogbas (C: class):
  $ wi (wa (wcel C crp) (wne C c1)) (wceq (co (cfv C clog) (cfv C clog) cdiv) c1) $;

--| General log of 1 is 0. (Contributed by Stefan O'Rear, 19-Sep-2014.) (New usage is discouraged.) Use ~ logb1 instead.
theorem reglog1 (C: class):
  $ wi (wa (wcel C crp) (wne C c1)) (wceq (co (cfv c1 clog) (cfv C clog) cdiv) cc0) $;

--| General log of a power of the base is the exponent. (Contributed by Stefan O'Rear, 19-Sep-2014.) (New usage is discouraged.) Use ~ relogbexp instead.
theorem reglogexpbas (C N: class):
  $ wi (wa (wcel N cz) (wa (wcel C crp) (wne C c1))) (wceq (co (cfv (co C N cexp) clog) (cfv C clog) cdiv) N) $;

--| Every positive Pell solution is a power of the fundamental solution. (Contributed by Stefan O'Rear, 19-Sep-2014.)
theorem pellfund14 {x3: setvar} (A2 D: class):
  $ wi (wa (wcel D (cdif cn csquarenn)) (wcel A2 (cfv D cpell14qr))) (wrex x3 (wceq A2 (co (cfv D cpellfund) (cv x3) cexp)) cz) $;

--| The positive Pell solutions are precisely the integer powers of the fundamental solution. To get the general solution set (which we will not be using), throw in a copy of Z/2Z. (Contributed by Stefan O'Rear, 19-Sep-2014.)
theorem pellfund14b {x3: setvar} (A2 D: class):
  $ wi (wcel D (cdif cn csquarenn)) (wb (wcel A2 (cfv D cpell14qr)) (wrex x3 (wceq A2 (co (cfv D cpellfund) (cv x3) cexp)) cz)) $;

--| Extend class notation to include the Robertson-Matiyasevich X sequence.
term crmx: class;

--| Extend class notation to include the Robertson-Matiyasevich Y sequence.
term crmy: class;

--| Define the X sequence as the rational part of some solution of a special Pell equation. See ~ frmx and ~ rmxyval for a more useful but non-eliminable definition. (Contributed by Stefan O'Rear, 21-Sep-2014.)
axiom df_rmx {n a b: setvar}:
  $ wceq crmx (cmpo a n (cfv c2 cuz) cz (cfv (cfv (co (co (cv a) (cfv (co (co (cv a) c2 cexp) c1 cmin) csqrt) caddc) (cv n) cexp) (ccnv (cmpt b (cxp cn0 cz) (co (cfv (cv b) c1st) (co (cfv (co (co (cv a) c2 cexp) c1 cmin) csqrt) (cfv (cv b) c2nd) cmul) caddc)))) c1st)) $;

--| Define the X sequence as the irrational part of some solution of a special Pell equation. See ~ frmy and ~ rmxyval for a more useful but non-eliminable definition. (Contributed by Stefan O'Rear, 21-Sep-2014.)
axiom df_rmy {n a b: setvar}:
  $ wceq crmy (cmpo a n (cfv c2 cuz) cz (cfv (cfv (co (co (cv a) (cfv (co (co (cv a) c2 cexp) c1 cmin) csqrt) caddc) (cv n) cexp) (ccnv (cmpt b (cxp cn0 cz) (co (cfv (cv b) c1st) (co (cfv (co (co (cv a) c2 cexp) c1 cmin) csqrt) (cfv (cv b) c2nd) cmul) caddc)))) c2nd)) $;

--| Value of the X sequence. Not used after ~ rmxyval is proved. (Contributed by Stefan O'Rear, 21-Sep-2014.)
theorem rmxfval {b: setvar} (A2 N: class):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel N cz)) (wceq (co A2 N crmx) (cfv (cfv (co (co A2 (cfv (co (co A2 c2 cexp) c1 cmin) csqrt) caddc) N cexp) (ccnv (cmpt b (cxp cn0 cz) (co (cfv (cv b) c1st) (co (cfv (co (co A2 c2 cexp) c1 cmin) csqrt) (cfv (cv b) c2nd) cmul) caddc)))) c1st)) $;

--| Value of the Y sequence. Not used after ~ rmxyval is proved. (Contributed by Stefan O'Rear, 21-Sep-2014.)
theorem rmyfval {b: setvar} (A2 N: class):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel N cz)) (wceq (co A2 N crmy) (cfv (cfv (co (co A2 (cfv (co (co A2 c2 cexp) c1 cmin) csqrt) caddc) N cexp) (ccnv (cmpt b (cxp cn0 cz) (co (cfv (cv b) c1st) (co (cfv (co (co A2 c2 cexp) c1 cmin) csqrt) (cfv (cv b) c2nd) cmul) caddc)))) c2nd)) $;

--| The discriminant used to define the X and Y sequences has an irrational square root. (Contributed by Stefan O'Rear, 21-Sep-2014.) (Proof shortened by AV, 2-Aug-2021.)
theorem rmspecsqrtnq (A2: class):
  $ wi (wcel A2 (cfv c2 cuz)) (wcel (cfv (co (co A2 c2 cexp) c1 cmin) csqrt) (cdif cc cq)) $;

--| The discriminant used to define the X and Y sequences is a nonsquare positive integer and thus a valid Pell equation discriminant. (Contributed by Stefan O'Rear, 21-Sep-2014.)
theorem rmspecnonsq (A2: class):
  $ wi (wcel A2 (cfv c2 cuz)) (wcel (co (co A2 c2 cexp) c1 cmin) (cdif cn csquarenn)) $;

--| This lemma implements the concept of "equate rational and irrational parts", used to prove many arithmetical properties of the X and Y sequences. (Contributed by Stefan O'Rear, 21-Sep-2014.)
theorem qirropth (A2 B2 C D E: class):
  $ wi (w3a (wcel A2 (cdif cc cq)) (wa (wcel B2 cq) (wcel C cq)) (wa (wcel D cq) (wcel E cq))) (wb (wceq (co B2 (co A2 C cmul) caddc) (co D (co A2 E cmul) caddc)) (wa (wceq B2 D) (wceq C E))) $;

--| The base of exponent used to define the X and Y sequences is the fundamental solution of the corresponding Pell equation. (Contributed by Stefan O'Rear, 21-Sep-2014.)
theorem rmspecfund (A2: class):
  $ wi (wcel A2 (cfv c2 cuz)) (wceq (cfv (co (co A2 c2 cexp) c1 cmin) cpellfund) (co A2 (cfv (co (co A2 c2 cexp) c1 cmin) csqrt) caddc)) $;

--| The solutions used to construct the X and Y sequences are quadratic irrationals. (Contributed by Stefan O'Rear, 21-Sep-2014.) (Proof shortened by SN, 23-Dec-2024.)
theorem rmxyelqirr {a c d: setvar} (A2: class) (N: class c d):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel N cz)) (wcel (co (co A2 (cfv (co (co A2 c2 cexp) c1 cmin) csqrt) caddc) N cexp) (cab a (wrex c (wrex d (wceq (cv a) (co (cv c) (co (cfv (co (co A2 c2 cexp) c1 cmin) csqrt) (cv d) cmul) caddc)) cz) cn0))) $;

--| The function used to extract rational and irrational parts in ~ df-rmx and ~ df-rmy in fact achieves a one-to-one mapping from the quadratic irrationals to pairs of integers. (Contributed by Stefan O'Rear, 21-Sep-2014.)
theorem rmxypairf1o {a b c d: setvar} (A2: class):
  $ wi (wcel A2 (cfv c2 cuz)) (wf1o (cxp cn0 cz) (cab a (wrex c (wrex d (wceq (cv a) (co (cv c) (co (cfv (co (co A2 c2 cexp) c1 cmin) csqrt) (cv d) cmul) caddc)) cz) cn0)) (cmpt b (cxp cn0 cz) (co (cfv (cv b) c1st) (co (cfv (co (co A2 c2 cexp) c1 cmin) csqrt) (cfv (cv b) c2nd) cmul) caddc))) $;

--| Lemma for ~ frmx and ~ frmy . (Contributed by Stefan O'Rear, 22-Sep-2014.)
theorem rmxyelxp {b: setvar} (A2: class) (N: class b):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel N cz)) (wcel (cfv (co (co A2 (cfv (co (co A2 c2 cexp) c1 cmin) csqrt) caddc) N cexp) (ccnv (cmpt b (cxp cn0 cz) (co (cfv (cv b) c1st) (co (cfv (co (co A2 c2 cexp) c1 cmin) csqrt) (cfv (cv b) c2nd) cmul) caddc)))) (cxp cn0 cz)) $;

--| The X sequence is a nonnegative integer. See ~ rmxnn for a strengthening. (Contributed by Stefan O'Rear, 22-Sep-2014.)
theorem frmx:
  $ wf (cxp (cfv c2 cuz) cz) cn0 crmx $;

--| The Y sequence is an integer. (Contributed by Stefan O'Rear, 22-Sep-2014.)
theorem frmy:
  $ wf (cxp (cfv c2 cuz) cz) cz crmy $;

--| Main definition of the X and Y sequences. Compare definition 2.3 of [JonesMatijasevic] p. 694. (Contributed by Stefan O'Rear, 19-Oct-2014.)
theorem rmxyval (A2 N: class):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel N cz)) (wceq (co (co A2 N crmx) (co (cfv (co (co A2 c2 cexp) c1 cmin) csqrt) (co A2 N crmy) cmul) caddc) (co (co A2 (cfv (co (co A2 c2 cexp) c1 cmin) csqrt) caddc) N cexp)) $;

--| The discriminant used to define the X and Y sequences is a positive real. (Contributed by Stefan O'Rear, 22-Sep-2014.)
theorem rmspecpos (A2: class):
  $ wi (wcel A2 (cfv c2 cuz)) (wcel (co (co A2 c2 cexp) c1 cmin) crp) $;

--| The X and Y sequences taken together enumerate all solutions to the corresponding Pell equation in the right half-plane. This is Metamath 100 proof #39. (Contributed by Stefan O'Rear, 22-Sep-2014.)
theorem rmxycomplete {n: setvar} (A2 X Y: class):
  $ wi (w3a (wcel A2 (cfv c2 cuz)) (wcel X cn0) (wcel Y cz)) (wb (wceq (co (co X c2 cexp) (co (co (co A2 c2 cexp) c1 cmin) (co Y c2 cexp) cmul) cmin) c1) (wrex n (wa (wceq X (co A2 (cv n) crmx)) (wceq Y (co A2 (cv n) crmy))) cz)) $;

--| The X and Y sequences define a solution to the corresponding Pell equation. (Contributed by Stefan O'Rear, 22-Sep-2014.)
theorem rmxynorm (A2 N: class):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel N cz)) (wceq (co (co (co A2 N crmx) c2 cexp) (co (co (co A2 c2 cexp) c1 cmin) (co (co A2 N crmy) c2 cexp) cmul) cmin) c1) $;

--| The base of exponentiation for the X and Y sequences is a positive real. (Contributed by Stefan O'Rear, 22-Sep-2014.)
theorem rmbaserp (A2: class):
  $ wi (wcel A2 (cfv c2 cuz)) (wcel (co A2 (cfv (co (co A2 c2 cexp) c1 cmin) csqrt) caddc) crp) $;

--| Negation law for X and Y sequences. JonesMatijasevic is inconsistent on whether the X and Y sequences have domain ` NN0 ` or ` ZZ ` ; we use ` ZZ ` consistently to avoid the need for a separate subtraction law. (Contributed by Stefan O'Rear, 22-Sep-2014.)
theorem rmxyneg (A2 N: class):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel N cz)) (wa (wceq (co A2 (cneg N) crmx) (co A2 N crmx)) (wceq (co A2 (cneg N) crmy) (cneg (co A2 N crmy)))) $;

--| Addition formula for X and Y sequences. See ~ rmxadd and ~ rmyadd for most uses. (Contributed by Stefan O'Rear, 22-Sep-2014.)
theorem rmxyadd (A2 M N: class):
  $ wi (w3a (wcel A2 (cfv c2 cuz)) (wcel M cz) (wcel N cz)) (wa (wceq (co A2 (co M N caddc) crmx) (co (co (co A2 M crmx) (co A2 N crmx) cmul) (co (co (co A2 c2 cexp) c1 cmin) (co (co A2 M crmy) (co A2 N crmy) cmul) cmul) caddc)) (wceq (co A2 (co M N caddc) crmy) (co (co (co A2 M crmy) (co A2 N crmx) cmul) (co (co A2 M crmx) (co A2 N crmy) cmul) caddc))) $;

--| Value of the X and Y sequences at 1. (Contributed by Stefan O'Rear, 22-Sep-2014.)
theorem rmxy1 (A2: class):
  $ wi (wcel A2 (cfv c2 cuz)) (wa (wceq (co A2 c1 crmx) A2) (wceq (co A2 c1 crmy) c1)) $;

--| Value of the X and Y sequences at 0. (Contributed by Stefan O'Rear, 22-Sep-2014.)
theorem rmxy0 (A2: class):
  $ wi (wcel A2 (cfv c2 cuz)) (wa (wceq (co A2 cc0 crmx) c1) (wceq (co A2 cc0 crmy) cc0)) $;

--| Negation law (even function) for the X sequence. The method of proof used for the previous four theorems ~ rmxyneg , ~ rmxyadd , ~ rmxy0 , and ~ rmxy1 via ~ qirropth results in two theorems at once, but typical use requires only one, so this group of theorems serves to separate the cases. (Contributed by Stefan O'Rear, 22-Sep-2014.)
theorem rmxneg (A2 N: class):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel N cz)) (wceq (co A2 (cneg N) crmx) (co A2 N crmx)) $;

--| Value of X sequence at 0. Part 1 of equation 2.11 of [JonesMatijasevic] p. 695. (Contributed by Stefan O'Rear, 22-Sep-2014.)
theorem rmx0 (A2: class):
  $ wi (wcel A2 (cfv c2 cuz)) (wceq (co A2 cc0 crmx) c1) $;

--| Value of X sequence at 1. Part 2 of equation 2.11 of [JonesMatijasevic] p. 695. (Contributed by Stefan O'Rear, 22-Sep-2014.)
theorem rmx1 (A2: class):
  $ wi (wcel A2 (cfv c2 cuz)) (wceq (co A2 c1 crmx) A2) $;

--| Addition formula for X sequence. Equation 2.7 of [JonesMatijasevic] p. 695. (Contributed by Stefan O'Rear, 22-Sep-2014.)
theorem rmxadd (A2 M N: class):
  $ wi (w3a (wcel A2 (cfv c2 cuz)) (wcel M cz) (wcel N cz)) (wceq (co A2 (co M N caddc) crmx) (co (co (co A2 M crmx) (co A2 N crmx) cmul) (co (co (co A2 c2 cexp) c1 cmin) (co (co A2 M crmy) (co A2 N crmy) cmul) cmul) caddc)) $;

--| Negation formula for Y sequence (odd function). (Contributed by Stefan O'Rear, 22-Sep-2014.)
theorem rmyneg (A2 N: class):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel N cz)) (wceq (co A2 (cneg N) crmy) (cneg (co A2 N crmy))) $;

--| Value of Y sequence at 0. Part 1 of equation 2.12 of [JonesMatijasevic] p. 695. (Contributed by Stefan O'Rear, 22-Sep-2014.)
theorem rmy0 (A2: class):
  $ wi (wcel A2 (cfv c2 cuz)) (wceq (co A2 cc0 crmy) cc0) $;

--| Value of Y sequence at 1. Part 2 of equation 2.12 of [JonesMatijasevic] p. 695. (Contributed by Stefan O'Rear, 22-Sep-2014.)
theorem rmy1 (A2: class):
  $ wi (wcel A2 (cfv c2 cuz)) (wceq (co A2 c1 crmy) c1) $;

--| Addition formula for Y sequence. Equation 2.8 of [JonesMatijasevic] p. 695. (Contributed by Stefan O'Rear, 22-Sep-2014.)
theorem rmyadd (A2 M N: class):
  $ wi (w3a (wcel A2 (cfv c2 cuz)) (wcel M cz) (wcel N cz)) (wceq (co A2 (co M N caddc) crmy) (co (co (co A2 M crmy) (co A2 N crmx) cmul) (co (co A2 M crmx) (co A2 N crmy) cmul) caddc)) $;

--| Special addition-of-1 formula for X sequence. Part 1 of equation 2.9 of [JonesMatijasevic] p. 695. (Contributed by Stefan O'Rear, 19-Oct-2014.)
theorem rmxp1 (A2 N: class):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel N cz)) (wceq (co A2 (co N c1 caddc) crmx) (co (co (co A2 N crmx) A2 cmul) (co (co (co A2 c2 cexp) c1 cmin) (co A2 N crmy) cmul) caddc)) $;

--| Special addition of 1 formula for Y sequence. Part 2 of equation 2.9 of [JonesMatijasevic] p. 695. (Contributed by Stefan O'Rear, 24-Sep-2014.)
theorem rmyp1 (A2 N: class):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel N cz)) (wceq (co A2 (co N c1 caddc) crmy) (co (co (co A2 N crmy) A2 cmul) (co A2 N crmx) caddc)) $;

--| Subtraction of 1 formula for X sequence. Part 1 of equation 2.10 of [JonesMatijasevic] p. 695. (Contributed by Stefan O'Rear, 14-Oct-2014.)
theorem rmxm1 (A2 N: class):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel N cz)) (wceq (co A2 (co N c1 cmin) crmx) (co (co A2 (co A2 N crmx) cmul) (co (co (co A2 c2 cexp) c1 cmin) (co A2 N crmy) cmul) cmin)) $;

--| Subtraction of 1 formula for Y sequence. Part 2 of equation 2.10 of [JonesMatijasevic] p. 695. (Contributed by Stefan O'Rear, 19-Oct-2014.)
theorem rmym1 (A2 N: class):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel N cz)) (wceq (co A2 (co N c1 cmin) crmy) (co (co (co A2 N crmy) A2 cmul) (co A2 N crmx) cmin)) $;

--| The X sequence is a Lucas (second-order integer recurrence) sequence. Part 3 of equation 2.11 of [JonesMatijasevic] p. 695. (Contributed by Stefan O'Rear, 14-Oct-2014.)
theorem rmxluc (A2 N: class):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel N cz)) (wceq (co A2 (co N c1 caddc) crmx) (co (co (co c2 A2 cmul) (co A2 N crmx) cmul) (co A2 (co N c1 cmin) crmx) cmin)) $;

--| The Y sequence is a Lucas sequence, definable via this second-order recurrence with ~ rmy0 and ~ rmy1 . Part 3 of equation 2.12 of [JonesMatijasevic] p. 695. JonesMatijasevic uses this theorem to redefine the X and Y sequences to have domain ` ( ZZ X. ZZ ) ` , which simplifies some later theorems. It may shorten the derivation to use this as our initial definition. Incidentally, the X sequence satisfies the exact same recurrence. (Contributed by Stefan O'Rear, 1-Oct-2014.)
theorem rmyluc (A2 N: class):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel N cz)) (wceq (co A2 (co N c1 caddc) crmy) (co (co c2 (co (co A2 N crmy) A2 cmul) cmul) (co A2 (co N c1 cmin) crmy) cmin)) $;

--| Lucas sequence property of Y with better output ordering. (Contributed by Stefan O'Rear, 16-Oct-2014.)
theorem rmyluc2 (A2 N: class):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel N cz)) (wceq (co A2 (co N c1 caddc) crmy) (co (co (co c2 A2 cmul) (co A2 N crmy) cmul) (co A2 (co N c1 cmin) crmy) cmin)) $;

--| "Double-angle formula" for X-values. Equation 2.13 of [JonesMatijasevic] p. 695. (Contributed by Stefan O'Rear, 2-Oct-2014.)
theorem rmxdbl (A2 N: class):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel N cz)) (wceq (co A2 (co c2 N cmul) crmx) (co (co c2 (co (co A2 N crmx) c2 cexp) cmul) c1 cmin)) $;

--| "Double-angle formula" for Y-values. Equation 2.14 of [JonesMatijasevic] p. 695. (Contributed by Stefan O'Rear, 2-Oct-2014.)
theorem rmydbl (A2 N: class):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel N cz)) (wceq (co A2 (co c2 N cmul) crmy) (co (co c2 (co A2 N crmx) cmul) (co A2 N crmy) cmul)) $;

--| A function defined on an upper set of integers which increases at every adjacent pair is globally strictly monotonic by induction. (Contributed by Stefan O'Rear, 24-Sep-2014.)
theorem monotuz {x3 y1: setvar} (ph: wff) (A2 B2: class) (C: class x3) (D E: class) (F G: class y1) (H: class) (I: class x3 y1):
  $ wi (wa ph (wcel (cv y1) H)) (wbr F G clt) $ >
  $ wi (wa ph (wcel (cv x3) H)) (wcel C cr) $ >
  $ wceq H (cfv I cuz) $ >
  $ wi (wceq (cv x3) (co (cv y1) c1 caddc)) (wceq C G) $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq C F) $ >
  $ wi (wceq (cv x3) A2) (wceq C D) $ >
  $ wi (wceq (cv x3) B2) (wceq C E) $ >
  $ wi (wa ph (wa (wcel A2 H) (wcel B2 H))) (wb (wbr A2 B2 clt) (wbr D E clt)) $;

--| A function which is odd and monotonic on ` NN0 ` is monotonic on ` ZZ ` . This proof is far too long. (Contributed by Stefan O'Rear, 25-Sep-2014.)
theorem monotoddzzfi {x3 y1: setvar} (ph: wff) (A2 B2 F: class):
  $ wi (wa ph (wcel (cv x3) cz)) (wcel (cfv (cv x3) F) cr) $ >
  $ wi (wa ph (wcel (cv x3) cz)) (wceq (cfv (cneg (cv x3)) F) (cneg (cfv (cv x3) F))) $ >
  $ wi (w3a ph (wcel (cv x3) cn0) (wcel (cv y1) cn0)) (wi (wbr (cv x3) (cv y1) clt) (wbr (cfv (cv x3) F) (cfv (cv y1) F) clt)) $ >
  $ wi (w3a ph (wcel A2 cz) (wcel B2 cz)) (wb (wbr A2 B2 clt) (wbr (cfv A2 F) (cfv B2 F) clt)) $;

--| A function (given implicitly) which is odd and monotonic on ` NN0 ` is monotonic on ` ZZ ` . This proof is far too long. (Contributed by Stefan O'Rear, 25-Sep-2014.)
theorem monotoddzz {x3 y1: setvar} (ph: wff) (A2 B2 C D: class) (E: class x3) (F G: class y1):
  $ wi (w3a ph (wcel (cv x3) cn0) (wcel (cv y1) cn0)) (wi (wbr (cv x3) (cv y1) clt) (wbr E F clt)) $ >
  $ wi (wa ph (wcel (cv x3) cz)) (wcel E cr) $ >
  $ wi (wa ph (wcel (cv y1) cz)) (wceq G (cneg F)) $ >
  $ wi (wceq (cv x3) A2) (wceq E C) $ >
  $ wi (wceq (cv x3) B2) (wceq E D) $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq E F) $ >
  $ wi (wceq (cv x3) (cneg (cv y1))) (wceq E G) $ >
  $ wi (w3a ph (wcel A2 cz) (wcel B2 cz)) (wb (wbr A2 B2 clt) (wbr C D clt)) $;

--| An odd function which takes nonnegative values on nonnegative arguments commutes with ` abs ` . (Contributed by Stefan O'Rear, 26-Sep-2014.)
theorem oddcomabszz {x3 y1: setvar} (ph: wff) (A2: class x3) (B2 C: class y1) (D: class) (E F: class y1):
  $ wi (wa ph (wcel (cv x3) cz)) (wcel A2 cr) $ >
  $ wi (w3a ph (wcel (cv x3) cz) (wbr cc0 (cv x3) cle)) (wbr cc0 A2 cle) $ >
  $ wi (wa ph (wcel (cv y1) cz)) (wceq C (cneg B2)) $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq A2 B2) $ >
  $ wi (wceq (cv x3) (cneg (cv y1))) (wceq A2 C) $ >
  $ wi (wceq (cv x3) D) (wceq A2 E) $ >
  $ wi (wceq (cv x3) (cfv D cabs)) (wceq A2 F) $ >
  $ wi (wa ph (wcel D cz)) (wceq (cfv E cabs) F) $;

--| Induction on nonnegative integers with two base cases, for use with Lucas-type sequences. (Contributed by Stefan O'Rear, 1-Oct-2014.)
theorem _2nn0ind {x3 y1: setvar} (ph: wff x3) (ps ch th ta et rh: wff y1) (A2: class y1):
  $ ps $ >
  $ ch $ >
  $ wi (wcel (cv y1) cn) (wi (wa th ta) et) $ >
  $ wi (wceq (cv x3) cc0) (wb ph ps) $ >
  $ wi (wceq (cv x3) c1) (wb ph ch) $ >
  $ wi (wceq (cv x3) (co (cv y1) c1 cmin)) (wb ph th) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ta) $ >
  $ wi (wceq (cv x3) (co (cv y1) c1 caddc)) (wb ph et) $ >
  $ wi (wceq (cv x3) A2) (wb ph rh) $ >
  $ wi (wcel A2 cn0) rh $;

--| Inductively transfer a property to the integers if it holds for zero and passes between adjacent integers in either direction. (Contributed by Stefan O'Rear, 1-Oct-2014.)
theorem zindbi {x3 y1: setvar} (ph: wff x3) (ps ch th ta: wff y1) (A2: class):
  $ wi (wcel (cv y1) cz) (wb ps ch) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wceq (cv x3) (co (cv y1) c1 caddc)) (wb ph ch) $ >
  $ wi (wceq (cv x3) cc0) (wb ph th) $ >
  $ wi (wceq (cv x3) A2) (wb ph ta) $ >
  $ wi (wcel A2 cz) (wb th ta) $;

--| For all nonnegative indices, X is positive and Y is nonnegative. (Contributed by Stefan O'Rear, 24-Sep-2014.)
theorem rmxypos (A2 N: class):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel N cn0)) (wa (wbr cc0 (co A2 N crmx) clt) (wbr cc0 (co A2 N crmy) cle)) $;

--| The Y-sequence is strictly monotonic on ` NN0 ` . Strengthened by ~ ltrmy . (Contributed by Stefan O'Rear, 24-Sep-2014.)
theorem ltrmynn0 (A2 M N: class):
  $ wi (w3a (wcel A2 (cfv c2 cuz)) (wcel M cn0) (wcel N cn0)) (wb (wbr M N clt) (wbr (co A2 M crmy) (co A2 N crmy) clt)) $;

--| The X-sequence is strictly monotonic on ` NN0 ` . (Contributed by Stefan O'Rear, 4-Oct-2014.)
theorem ltrmxnn0 (A2 M N: class):
  $ wi (w3a (wcel A2 (cfv c2 cuz)) (wcel M cn0) (wcel N cn0)) (wb (wbr M N clt) (wbr (co A2 M crmx) (co A2 N crmx) clt)) $;

--| The X-sequence is monotonic on ` NN0 ` . (Contributed by Stefan O'Rear, 4-Oct-2014.)
theorem lermxnn0 (A2 M N: class):
  $ wi (w3a (wcel A2 (cfv c2 cuz)) (wcel M cn0) (wcel N cn0)) (wb (wbr M N cle) (wbr (co A2 M crmx) (co A2 N crmx) cle)) $;

--| The X-sequence is defined to range over ` NN0 ` but never actually takes the value 0. (Contributed by Stefan O'Rear, 4-Oct-2014.)
theorem rmxnn (A2 N: class):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel N cz)) (wcel (co A2 N crmx) cn) $;

--| The Y-sequence is strictly monotonic over ` ZZ ` . (Contributed by Stefan O'Rear, 25-Sep-2014.)
theorem ltrmy (A2 M N: class):
  $ wi (w3a (wcel A2 (cfv c2 cuz)) (wcel M cz) (wcel N cz)) (wb (wbr M N clt) (wbr (co A2 M crmy) (co A2 N crmy) clt)) $;

--| Y is zero only at zero. (Contributed by Stefan O'Rear, 26-Sep-2014.)
theorem rmyeq0 (A2 N: class):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel N cz)) (wb (wceq N cc0) (wceq (co A2 N crmy) cc0)) $;

--| Y is one-to-one. (Contributed by Stefan O'Rear, 3-Oct-2014.)
theorem rmyeq (A2 M N: class):
  $ wi (w3a (wcel A2 (cfv c2 cuz)) (wcel M cz) (wcel N cz)) (wb (wceq M N) (wceq (co A2 M crmy) (co A2 N crmy))) $;

--| Y is monotonic (non-strict). (Contributed by Stefan O'Rear, 3-Oct-2014.)
theorem lermy (A2 M N: class):
  $ wi (w3a (wcel A2 (cfv c2 cuz)) (wcel M cz) (wcel N cz)) (wb (wbr M N cle) (wbr (co A2 M crmy) (co A2 N crmy) cle)) $;

--| ` rmY ` is positive for positive arguments. (Contributed by Stefan O'Rear, 16-Oct-2014.)
theorem rmynn (A2 N: class):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel N cn)) (wcel (co A2 N crmy) cn) $;

--| ` rmY ` is nonnegative for nonnegative arguments. (Contributed by Stefan O'Rear, 16-Oct-2014.)
theorem rmynn0 (A2 N: class):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel N cn0)) (wcel (co A2 N crmy) cn0) $;

--| ` rmY ` commutes with ` abs ` . (Contributed by Stefan O'Rear, 26-Sep-2014.)
theorem rmyabs (A2 B2: class):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel B2 cz)) (wceq (cfv (co A2 B2 crmy) cabs) (co A2 (cfv B2 cabs) crmy)) $;

--| X(n) is strictly greater than Y(n) + Y(n-1). Lemma 2.24 of [JonesMatijasevic] p. 697 restricted to ` NN ` . (Contributed by Stefan O'Rear, 3-Oct-2014.)
theorem jm2_24nn (A2 N: class):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel N cn)) (wbr (co (co A2 (co N c1 cmin) crmy) (co A2 N crmy) caddc) (co A2 N crmx) clt) $;

--| First half of lemma 2.17 of [JonesMatijasevic] p. 696. (Contributed by Stefan O'Rear, 14-Oct-2014.)
theorem jm2_17a (A2 N: class):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel N cn0)) (wbr (co (co (co c2 A2 cmul) c1 cmin) N cexp) (co A2 (co N c1 caddc) crmy) cle) $;

--| Weak form of the second half of lemma 2.17 of [JonesMatijasevic] p. 696, allowing induction to start lower. (Contributed by Stefan O'Rear, 15-Oct-2014.)
theorem jm2_17b (A2 N: class):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel N cn0)) (wbr (co A2 (co N c1 caddc) crmy) (co (co c2 A2 cmul) N cexp) cle) $;

--| Second half of lemma 2.17 of [JonesMatijasevic] p. 696. (Contributed by Stefan O'Rear, 15-Oct-2014.)
theorem jm2_17c (A2 N: class):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel N cn)) (wbr (co A2 (co (co N c1 caddc) c1 caddc) crmy) (co (co c2 A2 cmul) (co N c1 caddc) cexp) clt) $;

--| Lemma 2.24 of [JonesMatijasevic] p. 697 extended to ` ZZ ` . Could be eliminated with a more careful proof of ~ jm2.26lem3 . (Contributed by Stefan O'Rear, 3-Oct-2014.)
theorem jm2_24 (A2 N: class):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel N cz)) (wbr (co (co A2 (co N c1 cmin) crmy) (co A2 N crmy) caddc) (co A2 N crmx) clt) $;

--| Y(n) increases faster than n. Used implicitly without proof or comment in lemma 2.27 of [JonesMatijasevic] p. 697. (Contributed by Stefan O'Rear, 4-Oct-2014.)
theorem rmygeid (A2 N: class):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel N cn0)) (wbr N (co A2 N crmy) cle) $;

--| A wff of the form ` A || ( B - C ) ` is interpreted as a congruential equation. This is similar to ` ( B mod A ) = ( C mod A ) ` , but is defined such that behavior is regular for zero and negative values of ` A ` . To use this concept effectively, we need to show that congruential equations behave similarly to normal equations; first a transitivity law. Idea for the future: If there was a congruential equation symbol, it could incorporate type constraints, so that most of these would not need them. (Contributed by Stefan O'Rear, 1-Oct-2014.)
theorem congtr (A2 B2 C D: class):
  $ wi (w3a (wa (wcel A2 cz) (wcel B2 cz)) (wa (wcel C cz) (wcel D cz)) (wa (wbr A2 (co B2 C cmin) cdvds) (wbr A2 (co C D cmin) cdvds))) (wbr A2 (co B2 D cmin) cdvds) $;

--| If two pairs of numbers are componentwise congruent, so are their sums. (Contributed by Stefan O'Rear, 1-Oct-2014.)
theorem congadd (A2 B2 C D E: class):
  $ wi (w3a (w3a (wcel A2 cz) (wcel B2 cz) (wcel C cz)) (wa (wcel D cz) (wcel E cz)) (wa (wbr A2 (co B2 C cmin) cdvds) (wbr A2 (co D E cmin) cdvds))) (wbr A2 (co (co B2 D caddc) (co C E caddc) cmin) cdvds) $;

--| If two pairs of numbers are componentwise congruent, so are their products. (Contributed by Stefan O'Rear, 1-Oct-2014.)
theorem congmul (A2 B2 C D E: class):
  $ wi (w3a (w3a (wcel A2 cz) (wcel B2 cz) (wcel C cz)) (wa (wcel D cz) (wcel E cz)) (wa (wbr A2 (co B2 C cmin) cdvds) (wbr A2 (co D E cmin) cdvds))) (wbr A2 (co (co B2 D cmul) (co C E cmul) cmin) cdvds) $;

--| Congruence mod ` A ` is a symmetric/commutative relation. (Contributed by Stefan O'Rear, 1-Oct-2014.)
theorem congsym (A2 B2 C: class):
  $ wi (wa (wa (wcel A2 cz) (wcel B2 cz)) (wa (wcel C cz) (wbr A2 (co B2 C cmin) cdvds))) (wbr A2 (co C B2 cmin) cdvds) $;

--| If two integers are congruent mod ` A ` , so are their negatives. (Contributed by Stefan O'Rear, 1-Oct-2014.)
theorem congneg (A2 B2 C: class):
  $ wi (wa (wa (wcel A2 cz) (wcel B2 cz)) (wa (wcel C cz) (wbr A2 (co B2 C cmin) cdvds))) (wbr A2 (co (cneg B2) (cneg C) cmin) cdvds) $;

--| If two pairs of numbers are componentwise congruent, so are their differences. (Contributed by Stefan O'Rear, 2-Oct-2014.)
theorem congsub (A2 B2 C D E: class):
  $ wi (w3a (w3a (wcel A2 cz) (wcel B2 cz) (wcel C cz)) (wa (wcel D cz) (wcel E cz)) (wa (wbr A2 (co B2 C cmin) cdvds) (wbr A2 (co D E cmin) cdvds))) (wbr A2 (co (co B2 D cmin) (co C E cmin) cmin) cdvds) $;

--| Every integer is congruent to itself mod every base. (Contributed by Stefan O'Rear, 1-Oct-2014.)
theorem congid (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cz)) (wbr A2 (co B2 B2 cmin) cdvds) $;

--| Polynomials commute with congruences. (Does this characterize them?) (Contributed by Stefan O'Rear, 5-Oct-2014.)
theorem mzpcong {k: setvar} (F: class k) (N V X Y: class):
  $ wi (w3a (wcel F (cfv V cmzp)) (wa (wcel X (co cz V cmap)) (wcel Y (co cz V cmap))) (wa (wcel N cz) (wral k (wbr N (co (cfv (cv k) X) (cfv (cv k) Y) cmin) cdvds) V))) (wbr N (co (cfv X F) (cfv Y F) cmin) cdvds) $;

--| Every integer is congruent to some number in the fundamental domain. (Contributed by Stefan O'Rear, 2-Oct-2014.)
theorem congrep {a: setvar} (A2 N: class):
  $ wi (wa (wcel A2 cn) (wcel N cz)) (wrex a (wbr A2 (co (cv a) N cmin) cdvds) (co cc0 (co A2 c1 cmin) cfz)) $;

--| If two integers are congruent, they are either equal or separated by at least the congruence base. (Contributed by Stefan O'Rear, 4-Oct-2014.)
theorem congabseq (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cn) (wcel B2 cz) (wcel C cz)) (wbr A2 (co B2 C cmin) cdvds)) (wb (wbr (cfv (co B2 C cmin) cabs) A2 clt) (wceq B2 C)) $;

--| A wff like that in this theorem will be known as an "alternating congruence". A special symbol might be considered if more uses come up. They have many of the same properties as normal congruences, starting with reflexivity. JonesMatijasevic uses "a &#8801; &#xB1; b (mod c)" for this construction. The disjunction of divisibility constraints seems to adequately capture the concept, but it's rather verbose and somewhat inelegant. Use of an explicit equivalence relation might also work. (Contributed by Stefan O'Rear, 2-Oct-2014.)
theorem acongid (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cz)) (wo (wbr A2 (co B2 B2 cmin) cdvds) (wbr A2 (co B2 (cneg B2) cmin) cdvds)) $;

--| Symmetry of alternating congruence. (Contributed by Stefan O'Rear, 2-Oct-2014.)
theorem acongsym (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cz) (wcel B2 cz) (wcel C cz)) (wo (wbr A2 (co B2 C cmin) cdvds) (wbr A2 (co B2 (cneg C) cmin) cdvds))) (wo (wbr A2 (co C B2 cmin) cdvds) (wbr A2 (co C (cneg B2) cmin) cdvds)) $;

--| Negate right side of alternating congruence. Makes essential use of the "alternating" part. (Contributed by Stefan O'Rear, 3-Oct-2014.)
theorem acongneg2 (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cz) (wcel B2 cz) (wcel C cz)) (wo (wbr A2 (co B2 (cneg C) cmin) cdvds) (wbr A2 (co B2 (cneg (cneg C)) cmin) cdvds))) (wo (wbr A2 (co B2 C cmin) cdvds) (wbr A2 (co B2 (cneg C) cmin) cdvds)) $;

--| Transitivity of alternating congruence. (Contributed by Stefan O'Rear, 2-Oct-2014.)
theorem acongtr (A2 B2 C D: class):
  $ wi (w3a (wa (wcel A2 cz) (wcel B2 cz)) (wa (wcel C cz) (wcel D cz)) (wa (wo (wbr A2 (co B2 C cmin) cdvds) (wbr A2 (co B2 (cneg C) cmin) cdvds)) (wo (wbr A2 (co C D cmin) cdvds) (wbr A2 (co C (cneg D) cmin) cdvds)))) (wo (wbr A2 (co B2 D cmin) cdvds) (wbr A2 (co B2 (cneg D) cmin) cdvds)) $;

--| Substitution deduction for alternating congruence. (Contributed by Stefan O'Rear, 3-Oct-2014.)
theorem acongeq12d (ph: wff) (A2 B2 C D E: class):
  $ wi ph (wceq B2 C) $ >
  $ wi ph (wceq D E) $ >
  $ wi ph (wb (wo (wbr A2 (co B2 D cmin) cdvds) (wbr A2 (co B2 (cneg D) cmin) cdvds)) (wo (wbr A2 (co C E cmin) cdvds) (wbr A2 (co C (cneg E) cmin) cdvds))) $;

--| Every integer is alternating-congruent to some number in the first half of the fundamental domain. (Contributed by Stefan O'Rear, 2-Oct-2014.)
theorem acongrep {a: setvar} (A2 N: class):
  $ wi (wa (wcel A2 cn) (wcel N cz)) (wrex a (wo (wbr (co c2 A2 cmul) (co (cv a) N cmin) cdvds) (wbr (co c2 A2 cmul) (co (cv a) (cneg N) cmin) cdvds)) (co cc0 A2 cfz)) $;

--| Bound on the difference between two integers constrained to two possibly overlapping finite ranges. (Contributed by Stefan O'Rear, 4-Oct-2014.)
theorem fzmaxdif (A2 B2 C D E F: class):
  $ wi (w3a (wa (wcel C cz) (wcel A2 (co B2 C cfz))) (wa (wcel F cz) (wcel D (co E F cfz))) (wbr (co C E cmin) (co F B2 cmin) cle)) (wbr (cfv (co A2 D cmin) cabs) (co F B2 cmin) cle) $;

--| Reflection of a finite range of integers about 0. (Contributed by Stefan O'Rear, 4-Oct-2014.)
theorem fzneg (A2 B2 C: class):
  $ wi (w3a (wcel A2 cz) (wcel B2 cz) (wcel C cz)) (wb (wcel A2 (co B2 C cfz)) (wcel (cneg A2) (co (cneg C) (cneg B2) cfz))) $;

--| Two numbers in the fundamental domain are alternating-congruent iff they are equal. TODO: could be used to shorten ~ jm2.26 . (Contributed by Stefan O'Rear, 4-Oct-2014.)
theorem acongeq (A2 B2 C: class):
  $ wi (w3a (wcel A2 cn) (wcel B2 (co cc0 A2 cfz)) (wcel C (co cc0 A2 cfz))) (wb (wceq B2 C) (wo (wbr (co c2 A2 cmul) (co B2 C cmin) cdvds) (wbr (co c2 A2 cmul) (co B2 (cneg C) cmin) cdvds))) $;

--| Alternating congruence passes from a base to a dividing base. (Contributed by Stefan O'Rear, 4-Oct-2014.)
theorem dvdsacongtr (A2 B2 C D: class):
  $ wi (w3a (wa (wcel A2 cz) (wcel B2 cz)) (wa (wcel C cz) (wcel D cz)) (wa (wbr D A2 cdvds) (wo (wbr A2 (co B2 C cmin) cdvds) (wbr A2 (co B2 (cneg C) cmin) cdvds)))) (wo (wbr D (co B2 C cmin) cdvds) (wbr D (co B2 (cneg C) cmin) cdvds)) $;

--| Multiplication by a coprime number does not affect divisibility. (Contributed by Stefan O'Rear, 23-Sep-2014.)
theorem coprmdvdsb (K M N: class):
  $ wi (w3a (wcel K cz) (wcel N cz) (wa (wcel M cz) (wceq (co K M cgcd) c1))) (wb (wbr K N cdvds) (wbr K (co M N cmul) cdvds)) $;

--| Divisibility in terms of modular reduction by the absolute value of the base. (Contributed by Stefan O'Rear, 26-Sep-2014.)
theorem modabsdifz (M N: class):
  $ wi (w3a (wcel N cr) (wcel M cr) (wne M cc0)) (wcel (co (co N (co N (cfv M cabs) cmo) cmin) M cdiv) cz) $;

--| Divisibility in terms of modular reduction by the absolute value of the base. (Contributed by Stefan O'Rear, 24-Sep-2014.) (Proof shortened by OpenAI, 3-Jul-2020.)
theorem dvdsabsmod0 (M N: class):
  $ wi (w3a (wcel M cz) (wcel N cz) (wne M cc0)) (wb (wbr M N cdvds) (wceq (co N (cfv M cabs) cmo) cc0)) $;

--| Theorem 2.18 of [JonesMatijasevic] p. 696. Direct relationship of the exponential function to X and Y sequences. (Contributed by Stefan O'Rear, 14-Oct-2014.)
theorem jm2_18 (A2 K N: class):
  $ wi (w3a (wcel A2 (cfv c2 cuz)) (wcel K cn0) (wcel N cn0)) (wbr (co (co (co (co c2 A2 cmul) K cmul) (co K c2 cexp) cmin) c1 cmin) (co (co (co A2 N crmx) (co (co A2 K cmin) (co A2 N crmy) cmul) cmin) (co K N cexp) cmin) cdvds) $;

--| Lemma for ~ jm2.19 . X and Y values are coprime. (Contributed by Stefan O'Rear, 23-Sep-2014.)
theorem jm2_19lem1 (A2 M: class):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel M cz)) (wceq (co (co A2 M crmx) (co A2 M crmy) cgcd) c1) $;

--| Lemma for ~ jm2.19 . (Contributed by Stefan O'Rear, 23-Sep-2014.)
theorem jm2_19lem2 (A2 M N: class):
  $ wi (w3a (wcel A2 (cfv c2 cuz)) (wcel M cz) (wcel N cz)) (wb (wbr (co A2 M crmy) (co A2 N crmy) cdvds) (wbr (co A2 M crmy) (co A2 (co N M caddc) crmy) cdvds)) $;

--| Lemma for ~ jm2.19 . (Contributed by Stefan O'Rear, 26-Sep-2014.)
theorem jm2_19lem3 (A2 I M N: class):
  $ wi (w3a (wcel A2 (cfv c2 cuz)) (wa (wcel M cz) (wcel N cz)) (wcel I cn0)) (wb (wbr (co A2 M crmy) (co A2 N crmy) cdvds) (wbr (co A2 M crmy) (co A2 (co N (co I M cmul) caddc) crmy) cdvds)) $;

--| Lemma for ~ jm2.19 . Extend to ZZ by symmetry. TODO: use ~ zindbi . (Contributed by Stefan O'Rear, 26-Sep-2014.)
theorem jm2_19lem4 (A2 I M N: class):
  $ wi (w3a (wcel A2 (cfv c2 cuz)) (wa (wcel M cz) (wcel N cz)) (wcel I cz)) (wb (wbr (co A2 M crmy) (co A2 N crmy) cdvds) (wbr (co A2 M crmy) (co A2 (co N (co I M cmul) caddc) crmy) cdvds)) $;

--| Lemma 2.19 of [JonesMatijasevic] p. 696. Transfer divisibility constraints between Y-values and their indices. (Contributed by Stefan O'Rear, 24-Sep-2014.)
theorem jm2_19 (A2 M N: class):
  $ wi (w3a (wcel A2 (cfv c2 cuz)) (wcel M cz) (wcel N cz)) (wb (wbr M N cdvds) (wbr (co A2 M crmy) (co A2 N crmy) cdvds)) $;

--| Lemma for ~ jm2.20nn . Express X and Y values as a binomial. (Contributed by Stefan O'Rear, 26-Sep-2014.)
theorem jm2_21 (A2 J N: class):
  $ wi (w3a (wcel A2 (cfv c2 cuz)) (wcel N cz) (wcel J cz)) (wceq (co (co A2 (co N J cmul) crmx) (co (cfv (co (co A2 c2 cexp) c1 cmin) csqrt) (co A2 (co N J cmul) crmy) cmul) caddc) (co (co (co A2 N crmx) (co (cfv (co (co A2 c2 cexp) c1 cmin) csqrt) (co A2 N crmy) cmul) caddc) J cexp)) $;

--| Lemma for ~ jm2.20nn . Applying binomial theorem and taking irrational part. (Contributed by Stefan O'Rear, 26-Sep-2014.) (Revised by Stefan O'Rear, 6-May-2015.)
theorem jm2_22 {x3 i: setvar} (A2 J N: class):
  $ wi (w3a (wcel A2 (cfv c2 cuz)) (wcel N cz) (wcel J cn0)) (wceq (co A2 (co N J cmul) crmy) (csu i (crab x3 (wn (wbr c2 (cv x3) cdvds)) (co cc0 J cfz)) (co (co J (cv i) cbc) (co (co (co A2 N crmx) (co J (cv i) cmin) cexp) (co (co (co A2 N crmy) (cv i) cexp) (co (co (co A2 c2 cexp) c1 cmin) (co (co (cv i) c1 cmin) c2 cdiv) cexp) cmul) cmul) cmul))) $;

--| Lemma for ~ jm2.20nn . Truncate binomial expansion p-adicly. (Contributed by Stefan O'Rear, 26-Sep-2014.)
theorem jm2_23 (A2 J N: class):
  $ wi (w3a (wcel A2 (cfv c2 cuz)) (wcel N cz) (wcel J cn)) (wbr (co (co A2 N crmy) c3 cexp) (co (co A2 (co N J cmul) crmy) (co J (co (co (co A2 N crmx) (co J c1 cmin) cexp) (co A2 N crmy) cmul) cmul) cmin) cdvds) $;

--| Lemma 2.20 of [JonesMatijasevic] p. 696, the "first step down lemma". (Contributed by Stefan O'Rear, 27-Sep-2014.)
theorem jm2_20nn (A2 M N: class):
  $ wi (w3a (wcel A2 (cfv c2 cuz)) (wcel M cn) (wcel N cn)) (wb (wbr (co (co A2 N crmy) c2 cexp) (co A2 M crmy) cdvds) (wbr (co N (co A2 N crmy) cmul) M cdvds)) $;

--| Lemma for ~ jm2.26 . (Contributed by Stefan O'Rear, 2-Oct-2014.)
theorem jm2_25lem1 (A2 B2 C D: class):
  $ wi (w3a (wa (wcel A2 cz) (wcel B2 cz)) (wa (wcel C cz) (wcel D cz)) (wo (wbr A2 (co C D cmin) cdvds) (wbr A2 (co C (cneg D) cmin) cdvds))) (wb (wo (wbr A2 (co D B2 cmin) cdvds) (wbr A2 (co D (cneg B2) cmin) cdvds)) (wo (wbr A2 (co C B2 cmin) cdvds) (wbr A2 (co C (cneg B2) cmin) cdvds))) $;

--| Lemma for ~ jm2.26 . Remainders mod X(2n) are negaperiodic mod 2n. (Contributed by Stefan O'Rear, 2-Oct-2014.)
theorem jm2_25 (A2 I M N: class):
  $ wi (w3a (wcel A2 (cfv c2 cuz)) (wa (wcel M cz) (wcel N cz)) (wcel I cz)) (wo (wbr (co A2 N crmx) (co (co A2 (co M (co I (co c2 N cmul) cmul) caddc) crmy) (co A2 M crmy) cmin) cdvds) (wbr (co A2 N crmx) (co (co A2 (co M (co I (co c2 N cmul) cmul) caddc) crmy) (cneg (co A2 M crmy)) cmin) cdvds)) $;

--| Lemma for ~ jm2.26 . Reverse direction is required to prove forward direction, so do it separately. Induction on difference between K and M, together with the addition formula fact that adding 2N only inverts sign. (Contributed by Stefan O'Rear, 2-Oct-2014.)
theorem jm2_26a (A2 K M N: class):
  $ wi (wa (wa (wcel A2 (cfv c2 cuz)) (wcel N cz)) (wa (wcel K cz) (wcel M cz))) (wi (wo (wbr (co c2 N cmul) (co K M cmin) cdvds) (wbr (co c2 N cmul) (co K (cneg M) cmin) cdvds)) (wo (wbr (co A2 N crmx) (co (co A2 K crmy) (co A2 M crmy) cmin) cdvds) (wbr (co A2 N crmx) (co (co A2 K crmy) (cneg (co A2 M crmy)) cmin) cdvds))) $;

--| Lemma for ~ jm2.26 . Use ~ acongrep to find K', M' ~~ K, M in [ 0,N ]. Thus Y(K') ~~ Y(M') and both are small; K' = M' on pain of contradicting 2.24, so K ~~ M. (Contributed by Stefan O'Rear, 3-Oct-2014.)
theorem jm2_26lem3 (A2 K M N: class):
  $ wi (w3a (wa (wcel A2 (cfv c2 cuz)) (wcel N cn)) (wa (wcel K (co cc0 N cfz)) (wcel M (co cc0 N cfz))) (wo (wbr (co A2 N crmx) (co (co A2 K crmy) (co A2 M crmy) cmin) cdvds) (wbr (co A2 N crmx) (co (co A2 K crmy) (cneg (co A2 M crmy)) cmin) cdvds))) (wceq K M) $;

--| Lemma 2.26 of [JonesMatijasevic] p. 697, the "second step down lemma". (Contributed by Stefan O'Rear, 2-Oct-2014.)
theorem jm2_26 (A2 K M N: class):
  $ wi (wa (wa (wcel A2 (cfv c2 cuz)) (wcel N cn)) (wa (wcel K cz) (wcel M cz))) (wb (wo (wbr (co A2 N crmx) (co (co A2 K crmy) (co A2 M crmy) cmin) cdvds) (wbr (co A2 N crmx) (co (co A2 K crmy) (cneg (co A2 M crmy)) cmin) cdvds)) (wo (wbr (co c2 N cmul) (co K M cmin) cdvds) (wbr (co c2 N cmul) (co K (cneg M) cmin) cdvds))) $;

--| Lemma 2.15 of [JonesMatijasevic] p. 695. ` rmY ` is a polynomial for fixed N, so has the expected congruence property. (Contributed by Stefan O'Rear, 1-Oct-2014.)
theorem jm2_15nn0 (A2 B2 N: class):
  $ wi (w3a (wcel A2 (cfv c2 cuz)) (wcel B2 (cfv c2 cuz)) (wcel N cn0)) (wbr (co A2 B2 cmin) (co (co A2 N crmy) (co B2 N crmy) cmin) cdvds) $;

--| Lemma 2.16 of [JonesMatijasevic] p. 695. This may be regarded as a special case of ~ jm2.15nn0 if ` rmY ` is redefined as described in ~ rmyluc . (Contributed by Stefan O'Rear, 1-Oct-2014.)
theorem jm2_16nn0 (A2 N: class):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel N cn0)) (wbr (co A2 c1 cmin) (co (co A2 N crmy) N cmin) cdvds) $;

--| Lemma for ~ jm2.27 . Reverse direction after existential quantifiers are expanded. (Contributed by Stefan O'Rear, 4-Oct-2014.)
theorem jm2_27a (ph: wff) (A2 B2 C D P Q R E F G H I J: class):
  $ wi ph (wcel A2 (cfv c2 cuz)) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wcel C cn) $ >
  $ wi ph (wcel D cn0) $ >
  $ wi ph (wcel E cn0) $ >
  $ wi ph (wcel F cn0) $ >
  $ wi ph (wcel G cn0) $ >
  $ wi ph (wcel H cn0) $ >
  $ wi ph (wcel I cn0) $ >
  $ wi ph (wcel J cn0) $ >
  $ wi ph (wceq (co (co D c2 cexp) (co (co (co A2 c2 cexp) c1 cmin) (co C c2 cexp) cmul) cmin) c1) $ >
  $ wi ph (wceq (co (co F c2 cexp) (co (co (co A2 c2 cexp) c1 cmin) (co E c2 cexp) cmul) cmin) c1) $ >
  $ wi ph (wcel G (cfv c2 cuz)) $ >
  $ wi ph (wceq (co (co I c2 cexp) (co (co (co G c2 cexp) c1 cmin) (co H c2 cexp) cmul) cmin) c1) $ >
  $ wi ph (wceq E (co (co J c1 caddc) (co c2 (co C c2 cexp) cmul) cmul)) $ >
  $ wi ph (wbr F (co G A2 cmin) cdvds) $ >
  $ wi ph (wbr (co c2 C cmul) (co G c1 cmin) cdvds) $ >
  $ wi ph (wbr F (co H C cmin) cdvds) $ >
  $ wi ph (wbr (co c2 C cmul) (co H B2 cmin) cdvds) $ >
  $ wi ph (wbr B2 C cle) $ >
  $ wi ph (wcel P cz) $ >
  $ wi ph (wceq D (co A2 P crmx)) $ >
  $ wi ph (wceq C (co A2 P crmy)) $ >
  $ wi ph (wcel Q cz) $ >
  $ wi ph (wceq F (co A2 Q crmx)) $ >
  $ wi ph (wceq E (co A2 Q crmy)) $ >
  $ wi ph (wcel R cz) $ >
  $ wi ph (wceq I (co G R crmx)) $ >
  $ wi ph (wceq H (co G R crmy)) $ >
  $ wi ph (wceq C (co A2 B2 crmy)) $;

--| Lemma for ~ jm2.27 . Expand existential quantifiers for reverse direction. (Contributed by Stefan O'Rear, 4-Oct-2014.)
theorem jm2_27b (ph: wff) (A2 B2 C D E F G H I J: class):
  $ wi ph (wcel A2 (cfv c2 cuz)) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wcel C cn) $ >
  $ wi ph (wcel D cn0) $ >
  $ wi ph (wcel E cn0) $ >
  $ wi ph (wcel F cn0) $ >
  $ wi ph (wcel G cn0) $ >
  $ wi ph (wcel H cn0) $ >
  $ wi ph (wcel I cn0) $ >
  $ wi ph (wcel J cn0) $ >
  $ wi ph (wceq (co (co D c2 cexp) (co (co (co A2 c2 cexp) c1 cmin) (co C c2 cexp) cmul) cmin) c1) $ >
  $ wi ph (wceq (co (co F c2 cexp) (co (co (co A2 c2 cexp) c1 cmin) (co E c2 cexp) cmul) cmin) c1) $ >
  $ wi ph (wcel G (cfv c2 cuz)) $ >
  $ wi ph (wceq (co (co I c2 cexp) (co (co (co G c2 cexp) c1 cmin) (co H c2 cexp) cmul) cmin) c1) $ >
  $ wi ph (wceq E (co (co J c1 caddc) (co c2 (co C c2 cexp) cmul) cmul)) $ >
  $ wi ph (wbr F (co G A2 cmin) cdvds) $ >
  $ wi ph (wbr (co c2 C cmul) (co G c1 cmin) cdvds) $ >
  $ wi ph (wbr F (co H C cmin) cdvds) $ >
  $ wi ph (wbr (co c2 C cmul) (co H B2 cmin) cdvds) $ >
  $ wi ph (wbr B2 C cle) $ >
  $ wi ph (wceq C (co A2 B2 crmy)) $;

--| Lemma for ~ jm2.27 . Forward direction with substitutions. (Contributed by Stefan O'Rear, 4-Oct-2014.)
theorem jm2_27c (ph: wff) (A2 B2 C D Q E F G H I J: class):
  $ wi ph (wcel A2 (cfv c2 cuz)) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wcel C cn) $ >
  $ wi ph (wceq C (co A2 B2 crmy)) $ >
  $ wceq D (co A2 B2 crmx) $ >
  $ wceq Q (co B2 (co A2 B2 crmy) cmul) $ >
  $ wceq E (co A2 (co c2 Q cmul) crmy) $ >
  $ wceq F (co A2 (co c2 Q cmul) crmx) $ >
  $ wceq G (co A2 (co (co F c2 cexp) (co (co F c2 cexp) A2 cmin) cmul) caddc) $ >
  $ wceq H (co G B2 crmy) $ >
  $ wceq I (co G B2 crmx) $ >
  $ wceq J (co (co E (co c2 (co C c2 cexp) cmul) cdiv) c1 cmin) $ >
  $ wi ph (wa (wa (w3a (wcel D cn0) (wcel E cn0) (wcel F cn0)) (w3a (wcel G cn0) (wcel H cn0) (wcel I cn0))) (wa (wcel J cn0) (wa (wa (w3a (wceq (co (co D c2 cexp) (co (co (co A2 c2 cexp) c1 cmin) (co C c2 cexp) cmul) cmin) c1) (wceq (co (co F c2 cexp) (co (co (co A2 c2 cexp) c1 cmin) (co E c2 cexp) cmul) cmin) c1) (wcel G (cfv c2 cuz))) (w3a (wceq (co (co I c2 cexp) (co (co (co G c2 cexp) c1 cmin) (co H c2 cexp) cmul) cmin) c1) (wceq E (co (co J c1 caddc) (co c2 (co C c2 cexp) cmul) cmul)) (wbr F (co G A2 cmin) cdvds))) (wa (wa (wbr (co c2 C cmul) (co G c1 cmin) cdvds) (wbr F (co H C cmin) cdvds)) (wa (wbr (co c2 C cmul) (co H B2 cmin) cdvds) (wbr B2 C cle)))))) $;

--| Lemma 2.27 of [JonesMatijasevic] p. 697; rmY is a diophantine relation. 0 was excluded from the range of B and the lower limit of G was imposed because the source proof does not seem to work otherwise; quite possible I'm just missing something. The source proof uses both i and I; i has been changed to j to avoid collision. This theorem is basically nothing but substitution instances, all the work is done in ~ jm2.27a and ~ jm2.27c . Once Diophantine relations have been defined, the content of the theorem is "rmY is Diophantine". (Contributed by Stefan O'Rear, 4-Oct-2014.)
theorem jm2_27 {e f2 g2 h i j d: setvar} (A2 B2 C: class):
  $ wi (w3a (wcel A2 (cfv c2 cuz)) (wcel B2 cn) (wcel C cn)) (wb (wceq C (co A2 B2 crmy)) (wrex d (wrex e (wrex f2 (wrex g2 (wrex h (wrex i (wrex j (wa (wa (w3a (wceq (co (co (cv d) c2 cexp) (co (co (co A2 c2 cexp) c1 cmin) (co C c2 cexp) cmul) cmin) c1) (wceq (co (co (cv f2) c2 cexp) (co (co (co A2 c2 cexp) c1 cmin) (co (cv e) c2 cexp) cmul) cmin) c1) (wcel (cv g2) (cfv c2 cuz))) (w3a (wceq (co (co (cv i) c2 cexp) (co (co (co (cv g2) c2 cexp) c1 cmin) (co (cv h) c2 cexp) cmul) cmin) c1) (wceq (cv e) (co (co (cv j) c1 caddc) (co c2 (co C c2 cexp) cmul) cmul)) (wbr (cv f2) (co (cv g2) A2 cmin) cdvds))) (wa (wa (wbr (co c2 C cmul) (co (cv g2) c1 cmin) cdvds) (wbr (cv f2) (co (cv h) C cmin) cdvds)) (wa (wbr (co c2 C cmul) (co (cv h) B2 cmin) cdvds) (wbr B2 C cle)))) cn0) cn0) cn0) cn0) cn0) cn0) cn0)) $;

--| Lemma for ~ rmydioph . Substitution of a tuple restriction into a projection that doesn't care. (Contributed by Stefan O'Rear, 11-Oct-2014.)
theorem jm2_27dlem1 (A2 B2: class) (a b: setvar):
  $ wcel A2 (co c1 B2 cfz) $ >
  $ wi (wceq (cv a) (cres (cv b) (co c1 B2 cfz))) (wceq (cfv A2 (cv a)) (cfv A2 (cv b))) $;

--| Lemma for ~ rmydioph . This theorem is used along with the next three to efficiently infer steps like ` 7 e. ( 1 ... ; 1 0 ) ` . (Contributed by Stefan O'Rear, 11-Oct-2014.)
theorem jm2_27dlem2 (A2 B2 C: class):
  $ wcel A2 (co c1 B2 cfz) $ >
  $ wceq C (co B2 c1 caddc) $ >
  $ wcel B2 cn $ >
  $ wcel A2 (co c1 C cfz) $;

--| Lemma for ~ rmydioph . Infer membership of the endpoint of a range. (Contributed by Stefan O'Rear, 11-Oct-2014.)
theorem jm2_27dlem3 (A2: class):
  $ wcel A2 cn $ >
  $ wcel A2 (co c1 A2 cfz) $;

--| Lemma for ~ rmydioph . Infer ` NN ` -hood of large numbers. (Contributed by Stefan O'Rear, 11-Oct-2014.)
theorem jm2_27dlem4 (A2 B2: class):
  $ wcel A2 cn $ >
  $ wceq B2 (co A2 c1 caddc) $ >
  $ wcel B2 cn $;

--| Lemma for ~ rmydioph . Used with ~ sselii to infer membership of midpoints of range; ~ jm2.27dlem2 is deprecated. (Contributed by Stefan O'Rear, 11-Oct-2014.)
theorem jm2_27dlem5 (A2 B2 C: class):
  $ wceq B2 (co A2 c1 caddc) $ >
  $ wss (co c1 B2 cfz) (co c1 C cfz) $ >
  $ wss (co c1 A2 cfz) (co c1 C cfz) $;

--| ~ jm2.27 restated in terms of Diophantine sets. (Contributed by Stefan O'Rear, 11-Oct-2014.) (Revised by Stefan O'Rear, 6-May-2015.)
theorem rmydioph {a: setvar}:
  $ wcel (crab a (wa (wcel (cfv c1 (cv a)) (cfv c2 cuz)) (wceq (cfv c3 (cv a)) (co (cfv c1 (cv a)) (cfv c2 (cv a)) crmy))) (co cn0 (co c1 c3 cfz) cmap)) (cfv c3 cdioph) $;

--| X can be expressed in terms of Y, so it is also Diophantine. (Contributed by Stefan O'Rear, 15-Oct-2014.)
theorem rmxdiophlem {y1: setvar} (A2 N X: class):
  $ wi (w3a (wcel A2 (cfv c2 cuz)) (wcel N cn0) (wcel X cn0)) (wb (wceq X (co A2 N crmx)) (wrex y1 (wa (wceq (cv y1) (co A2 N crmy)) (wceq (co (co X c2 cexp) (co (co (co A2 c2 cexp) c1 cmin) (co (cv y1) c2 cexp) cmul) cmin) c1)) cn0)) $;

--| X is a Diophantine function. (Contributed by Stefan O'Rear, 17-Oct-2014.)
theorem rmxdioph {a: setvar}:
  $ wcel (crab a (wa (wcel (cfv c1 (cv a)) (cfv c2 cuz)) (wceq (cfv c3 (cv a)) (co (cfv c1 (cv a)) (cfv c2 (cv a)) crmx))) (co cn0 (co c1 c3 cfz) cmap)) (cfv c3 cdioph) $;

--| Lemma for ~ jm3.1 . (Contributed by Stefan O'Rear, 16-Oct-2014.)
theorem jm3_1lem1 (ph: wff) (A2 K N: class):
  $ wi ph (wcel A2 (cfv c2 cuz)) $ >
  $ wi ph (wcel K (cfv c2 cuz)) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr (co K (co N c1 caddc) crmy) A2 cle) $ >
  $ wi ph (wbr (co K N cexp) A2 clt) $;

--| Lemma for ~ jm3.1 . (Contributed by Stefan O'Rear, 16-Oct-2014.)
theorem jm3_1lem2 (ph: wff) (A2 K N: class):
  $ wi ph (wcel A2 (cfv c2 cuz)) $ >
  $ wi ph (wcel K (cfv c2 cuz)) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr (co K (co N c1 caddc) crmy) A2 cle) $ >
  $ wi ph (wbr (co K N cexp) (co (co (co (co c2 A2 cmul) K cmul) (co K c2 cexp) cmin) c1 cmin) clt) $;

--| Lemma for ~ jm3.1 . (Contributed by Stefan O'Rear, 17-Oct-2014.)
theorem jm3_1lem3 (ph: wff) (A2 K N: class):
  $ wi ph (wcel A2 (cfv c2 cuz)) $ >
  $ wi ph (wcel K (cfv c2 cuz)) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr (co K (co N c1 caddc) crmy) A2 cle) $ >
  $ wi ph (wcel (co (co (co (co c2 A2 cmul) K cmul) (co K c2 cexp) cmin) c1 cmin) cn) $;

--| Diophantine expression for exponentiation. Lemma 3.1 of [JonesMatijasevic] p. 698. (Contributed by Stefan O'Rear, 16-Oct-2014.)
theorem jm3_1 (A2 K N: class):
  $ wi (wa (w3a (wcel A2 (cfv c2 cuz)) (wcel K (cfv c2 cuz)) (wcel N cn)) (wbr (co K (co N c1 caddc) crmy) A2 cle)) (wceq (co K N cexp) (co (co (co A2 N crmx) (co (co A2 K cmin) (co A2 N crmy) cmul) cmin) (co (co (co (co c2 A2 cmul) K cmul) (co K c2 cexp) cmin) c1 cmin) cmo)) $;

--| Lemma for ~ expdioph . Fully expanded expression for exponential. (Contributed by Stefan O'Rear, 17-Oct-2014.)
theorem expdiophlem1 {e f2 d: setvar} (A2 B2 C: class):
  $ wi (wcel C cn0) (wb (wa (wa (wcel A2 (cfv c2 cuz)) (wcel B2 cn)) (wceq C (co A2 B2 cexp))) (wrex d (wrex e (wrex f2 (wa (wa (wcel A2 (cfv c2 cuz)) (wcel B2 cn)) (wa (wa (wcel A2 (cfv c2 cuz)) (wceq (cv d) (co A2 (co B2 c1 caddc) crmy))) (wa (wa (wcel (cv d) (cfv c2 cuz)) (wceq (cv e) (co (cv d) B2 crmy))) (wa (wa (wcel (cv d) (cfv c2 cuz)) (wceq (cv f2) (co (cv d) B2 crmx))) (wa (wbr C (co (co (co (co c2 (cv d) cmul) A2 cmul) (co A2 c2 cexp) cmin) c1 cmin) clt) (wbr (co (co (co (co c2 (cv d) cmul) A2 cmul) (co A2 c2 cexp) cmin) c1 cmin) (co (co (cv f2) (co (co (cv d) A2 cmin) (cv e) cmul) cmin) C cmin) cdvds)))))) cn0) cn0) cn0)) $;

--| Lemma for ~ expdioph . Exponentiation on a restricted domain is Diophantine. (Contributed by Stefan O'Rear, 17-Oct-2014.)
theorem expdiophlem2 {a: setvar}:
  $ wcel (crab a (wa (wa (wcel (cfv c1 (cv a)) (cfv c2 cuz)) (wcel (cfv c2 (cv a)) cn)) (wceq (cfv c3 (cv a)) (co (cfv c1 (cv a)) (cfv c2 (cv a)) cexp))) (co cn0 (co c1 c3 cfz) cmap)) (cfv c3 cdioph) $;

--| The exponential function is Diophantine. This result completes and encapsulates our development using Pell equation solution sequences and is sometimes regarded as Matiyasevich's theorem properly. (Contributed by Stefan O'Rear, 17-Oct-2014.)
theorem expdioph {a: setvar}:
  $ wcel (crab a (wceq (cfv c3 (cv a)) (co (cfv c1 (cv a)) (cfv c2 (cv a)) cexp)) (co cn0 (co c1 c3 cfz) cmap)) (cfv c3 cdioph) $;

--| Set induction for sets contained in a transitive set. If we are allowed to assume Infinity, then all sets have a transitive closure and this reduces to ~ setind ; however, this version is useful without Infinity. (Contributed by Stefan O'Rear, 28-Oct-2014.)
theorem setindtr {x3 y1: setvar} (A2 B2: class):
  $ wi (wal x3 (wi (wss (cv x3) A2) (wcel (cv x3) A2))) (wi (wex y1 (wa (wtr (cv y1)) (wcel B2 (cv y1)))) (wcel B2 A2)) $;

--| Set induction scheme without Infinity. See comments at ~ setindtr . (Contributed by Stefan O'Rear, 28-Oct-2014.)
theorem setindtrs {x3 y1 z: setvar} (ph: wff x3) (ps ch: wff y1 z) (B2: class y1):
  $ wi (wral y1 ps (cv x3)) ph $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wceq (cv x3) B2) (wb ph ch) $ >
  $ wi (wex z (wa (wtr (cv z)) (wcel B2 (cv z)))) ch $;

--| Lemma for ~ dford3 . (Contributed by Stefan O'Rear, 28-Oct-2014.)
theorem dford3lem1 {y1 b: setvar} (N: class):
  $ wi (wa (wtr N) (wral y1 (wtr (cv y1)) N)) (wral b (wa (wtr (cv b)) (wral y1 (wtr (cv y1)) (cv b))) N) $;

--| Lemma for ~ dford3 . (Contributed by Stefan O'Rear, 28-Oct-2014.)
theorem dford3lem2 {x3 y1: setvar}:
  $ wi (wa (wtr (cv x3)) (wral y1 (wtr (cv y1)) (cv x3))) (wcel (cv x3) con0) $;

--| Ordinals are precisely the hereditarily transitive classes. Definition 1.2 of [Schloeder] p. 1. (Contributed by Stefan O'Rear, 28-Oct-2014.)
theorem dford3 {x3: setvar} (N: class):
  $ wb (word N) (wa (wtr N) (wral x3 (wtr (cv x3)) N)) $;

--| ~ dford3 expressed in primitives to demonstrate shortness. (Contributed by Stefan O'Rear, 28-Oct-2014.)
theorem dford4 {a b c: setvar} (N: class):
  $ wb (word N) (wal a (wal b (wal c (wi (wa (wcel (cv a) N) (wcel (cv b) (cv a))) (wa (wcel (cv b) N) (wi (wcel (cv c) (cv b)) (wcel (cv c) (cv a)))))))) $;

--| Unrelated: Wiener pairs treat proper classes symmetrically. (Contributed by Stefan O'Rear, 19-Sep-2014.)
theorem wopprc (A2 B2: class):
  $ wb (wa (wcel A2 cvv) (wcel B2 cvv)) (wn (wcel c1o (cpr (cpr (csn A2) c0) (csn (csn B2))))) $;

--| Lemma for ~ rpnnen3 . (Contributed by Stefan O'Rear, 18-Jan-2015.)
theorem rpnnen3lem {c: setvar} (a b: setvar):
  $ wi (wa (wa (wcel (cv a) cr) (wcel (cv b) cr)) (wbr (cv a) (cv b) clt)) (wne (crab c (wbr (cv c) (cv a) clt) cq) (crab c (wbr (cv c) (cv b) clt) cq)) $;

--| Dedekind cut injection of ` RR ` into ` ~P QQ ` . (Contributed by Stefan O'Rear, 18-Jan-2015.)
theorem rpnnen3:
  $ wbr cr (cpw cq) cdom $;

--| Characterization of choice similar to ~ dffin1-5 . (Contributed by Stefan O'Rear, 6-Jan-2015.)
theorem axac10:
  $ wceq (cima cen con0) cvv $;

--| The Hartogs number of an infinite set is at least ` _om ` . _MOVABLE_ (Contributed by Stefan O'Rear, 10-Jul-2015.)
theorem harinf (S V: class):
  $ wi (wa (wcel S V) (wn (wcel S cfn))) (wss com (cfv S char)) $;

--| Deduction for weak dominance by a Cartesian product. _MOVABLE_ (Contributed by Stefan O'Rear, 10-Jul-2015.)
theorem wdom2d2 {x3 y1 z: setvar} (ph: wff y1 z) (A2: class y1 z) (B2: class z) (C: class) (V W: class x3 y1 z) (X: class y1 z):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel C X) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wrex y1 (wrex z (wceq (cv x3) X) C) B2) $ >
  $ wi ph (wbr A2 (cxp B2 C) cwdom) $;

--| Tarski's theorem about choice: ~ infxpidm is equivalent to ~ ax-ac . (Contributed by Stefan O'Rear, 4-Nov-2014.) (Proof shortened by Stefan O'Rear, 10-Jul-2015.)
theorem ttac {c: setvar}:
  $ wb wac (wal c (wi (wbr com (cv c) cdom) (wbr (cxp (cv c) (cv c)) (cv c) cen))) $;

--| Define a bijection between characteristic functions and subsets. _EDITORIAL_: extracted from ~ pw2en , which can be easily reproved in terms of this. (Contributed by Stefan O'Rear, 18-Jan-2015.) (Revised by Stefan O'Rear, 9-Jul-2015.)
theorem pw2f1ocnv {x3 y1 z: setvar} (A2: class) (F: class x3 y1 z) (V: class z):
  $ wceq F (cmpt x3 (co c2o A2 cmap) (cima (ccnv (cv x3)) (csn c1o))) $ >
  $ wi (wcel A2 V) (wa (wf1o (co c2o A2 cmap) (cpw A2) F) (wceq (ccnv F) (cmpt y1 (cpw A2) (cmpt z A2 (cif (wcel (cv z) (cv y1)) c1o c0))))) $;

--| Define a bijection between characteristic functions and subsets. _EDITORIAL_: extracted from ~ pw2en , which can be easily reproved in terms of this. (Contributed by Stefan O'Rear, 18-Jan-2015.)
theorem pw2f1o2 {x3: setvar} (A2: class) (F: class x3) (V: class):
  $ wceq F (cmpt x3 (co c2o A2 cmap) (cima (ccnv (cv x3)) (csn c1o))) $ >
  $ wi (wcel A2 V) (wf1o (co c2o A2 cmap) (cpw A2) F) $;

--| Function value of the ~ pw2f1o2 bijection. (Contributed by Stefan O'Rear, 18-Jan-2015.) (Revised by Stefan O'Rear, 6-May-2015.)
theorem pw2f1o2val {x3: setvar} (A2: class) (F: class x3) (X: class):
  $ wceq F (cmpt x3 (co c2o A2 cmap) (cima (ccnv (cv x3)) (csn c1o))) $ >
  $ wi (wcel X (co c2o A2 cmap)) (wceq (cfv X F) (cima (ccnv X) (csn c1o))) $;

--| Membership in a mapped set under the ~ pw2f1o2 bijection. (Contributed by Stefan O'Rear, 18-Jan-2015.) (Revised by Stefan O'Rear, 6-May-2015.)
theorem pw2f1o2val2 {x3: setvar} (A2: class) (F: class x3) (X Y: class):
  $ wceq F (cmpt x3 (co c2o A2 cmap) (cima (ccnv (cv x3)) (csn c1o))) $ >
  $ wi (wa (wcel X (co c2o A2 cmap)) (wcel Y A2)) (wb (wcel Y (cfv X F)) (wceq (cfv Y X) c1o)) $;

--| Limit ordinals in the sense inclusive of zero contain all successors of their members. (Contributed by Stefan O'Rear, 20-Jan-2015.)
theorem limsuc2 (A2 B2: class):
  $ wi (wa (word A2) (wceq A2 (cuni A2))) (wb (wcel B2 A2) (wcel (csuc B2) A2)) $;

--| Transfer an ordering on characteristic functions by isomorphism to the power set. (Contributed by Stefan O'Rear, 18-Jan-2015.)
theorem wepwsolem {x3 y1 z w a: setvar} (A2 R: class) (T U: class x3 y1 z w) (F: class a):
  $ wceq T (copab x3 y1 (wrex z (wa (wa (wcel (cv z) (cv y1)) (wn (wcel (cv z) (cv x3)))) (wral w (wi (wbr (cv w) (cv z) R) (wb (wcel (cv w) (cv x3)) (wcel (cv w) (cv y1)))) A2)) A2)) $ >
  $ wceq U (copab x3 y1 (wrex z (wa (wbr (cfv (cv z) (cv x3)) (cfv (cv z) (cv y1)) cep) (wral w (wi (wbr (cv w) (cv z) R) (wceq (cfv (cv w) (cv x3)) (cfv (cv w) (cv y1)))) A2)) A2)) $ >
  $ wceq F (cmpt a (co c2o A2 cmap) (cima (ccnv (cv a)) (csn c1o))) $ >
  $ wi (wcel A2 cvv) (wiso (co c2o A2 cmap) (cpw A2) U T F) $;

--| A well-ordering induces a strict ordering on the power set. _EDITORIAL_: when well-orderings are set like, this can be strengthened to remove ` A e. V ` . (Contributed by Stefan O'Rear, 18-Jan-2015.)
theorem wepwso {x3 y1 z w: setvar} (A2 R: class) (T V: class x3 y1 z w):
  $ wceq T (copab x3 y1 (wrex z (wa (wa (wcel (cv z) (cv y1)) (wn (wcel (cv z) (cv x3)))) (wral w (wi (wbr (cv w) (cv z) R) (wb (wcel (cv w) (cv x3)) (wcel (cv w) (cv y1)))) A2)) A2)) $ >
  $ wi (wa (wcel A2 V) (wwe A2 R)) (wor (cpw A2) T) $;

--| Define an enumeration of a set from a choice function; second part, it restricts to a bijection. _EDITORIAL_: overlaps ~ dfac8a . (Contributed by Stefan O'Rear, 18-Jan-2015.)
theorem dnnumch1 {x3 y1 z: setvar} (ph: wff y1 z) (A2: class) (F: class z) (G: class) (V: class x3 y1 z):
  $ wceq F (crecs (cmpt z cvv (cfv (cdif A2 (crn (cv z))) G))) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wral y1 (wi (wne (cv y1) c0) (wcel (cfv (cv y1) G) (cv y1))) (cpw A2)) $ >
  $ wi ph (wrex x3 (wf1o (cv x3) A2 (cres F (cv x3))) con0) $;

--| Define an enumeration (weak dominance version) of a set from a choice function. (Contributed by Stefan O'Rear, 18-Jan-2015.)
theorem dnnumch2 {y1 z: setvar} (ph: wff y1 z) (A2: class) (F: class z) (G: class) (V: class y1 z):
  $ wceq F (crecs (cmpt z cvv (cfv (cdif A2 (crn (cv z))) G))) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wral y1 (wi (wne (cv y1) c0) (wcel (cfv (cv y1) G) (cv y1))) (cpw A2)) $ >
  $ wi ph (wss A2 (crn F)) $;

--| Value of the ordinal injection function. (Contributed by Stefan O'Rear, 18-Jan-2015.)
theorem dnnumch3lem {x3 y1 z: setvar} (ph: wff y1 z) (w: setvar) (A2: class) (F: class z) (G: class) (V: class x3 y1 z):
  $ wceq F (crecs (cmpt z cvv (cfv (cdif A2 (crn (cv z))) G))) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wral y1 (wi (wne (cv y1) c0) (wcel (cfv (cv y1) G) (cv y1))) (cpw A2)) $ >
  $ wi (wa ph (wcel (cv w) A2)) (wceq (cfv (cv w) (cmpt x3 A2 (cint (cima (ccnv F) (csn (cv x3)))))) (cint (cima (ccnv F) (csn (cv w))))) $;

--| Define an injection from a set into the ordinals using a choice function. (Contributed by Stefan O'Rear, 18-Jan-2015.)
theorem dnnumch3 {x3 y1 z: setvar} (ph: wff y1 z) (A2: class) (F: class z) (G: class) (V: class x3 y1 z):
  $ wceq F (crecs (cmpt z cvv (cfv (cdif A2 (crn (cv z))) G))) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wral y1 (wi (wne (cv y1) c0) (wcel (cfv (cv y1) G) (cv y1))) (cpw A2)) $ >
  $ wi ph (wf1 A2 con0 (cmpt x3 A2 (cint (cima (ccnv F) (csn (cv x3)))))) $;

--| Define a well-ordering from a choice function. (Contributed by Stefan O'Rear, 18-Jan-2015.)
theorem dnwech {y1 z w v: setvar} (ph: wff y1 z) (A2: class) (F: class z) (G: class) (H V: class y1 z w v):
  $ wceq F (crecs (cmpt z cvv (cfv (cdif A2 (crn (cv z))) G))) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wral y1 (wi (wne (cv y1) c0) (wcel (cfv (cv y1) G) (cv y1))) (cpw A2)) $ >
  $ wceq H (copab v w (wcel (cint (cima (ccnv F) (csn (cv v)))) (cint (cima (ccnv F) (csn (cv w)))))) $ >
  $ wi ph (wwe A2 H) $;

--| Lemma for ~ dfac11 . This is the beginning of the proof that multiple choice is equivalent to choice. Our goal is to construct, by transfinite recursion, a well-ordering of ` ( R1 `` A ) ` . In what follows, ` A ` is the index of the rank we wish to well-order, ` z ` is the collection of well-orderings constructed so far, ` dom z ` is the set of ordinal indices of constructed ranks i.e. the next rank to construct, and ` y ` is a postulated multiple-choice function. Successor case 1, define a simple ordering from the well-ordered predecessor. (Contributed by Stefan O'Rear, 18-Jan-2015.)
theorem aomclem1 {z a b c d: setvar} (ph: wff z a b c d) (B2: class z a b c d):
  $ wceq B2 (copab a b (wrex c (wa (wa (wcel (cv c) (cv b)) (wn (wcel (cv c) (cv a)))) (wral d (wi (wbr (cv d) (cv c) (cfv (cuni (cdm (cv z))) (cv z))) (wb (wcel (cv d) (cv a)) (wcel (cv d) (cv b)))) (cfv (cuni (cdm (cv z))) cr1))) (cfv (cuni (cdm (cv z))) cr1))) $ >
  $ wi ph (wcel (cdm (cv z)) con0) $ >
  $ wi ph (wceq (cdm (cv z)) (csuc (cuni (cdm (cv z))))) $ >
  $ wi ph (wral a (wwe (cfv (cv a) cr1) (cfv (cv a) (cv z))) (cdm (cv z))) $ >
  $ wi ph (wor (cfv (cdm (cv z)) cr1) B2) $;

--| Lemma for ~ dfac11 . Successor case 2, a choice function for subsets of ` ( R1 `` dom z ) ` . (Contributed by Stefan O'Rear, 18-Jan-2015.)
theorem aomclem2 {y1 z a b c d: setvar} (ph: wff y1 z b c d) (A2 B2 C: class y1 z a b c d):
  $ wceq B2 (copab a b (wrex c (wa (wa (wcel (cv c) (cv b)) (wn (wcel (cv c) (cv a)))) (wral d (wi (wbr (cv d) (cv c) (cfv (cuni (cdm (cv z))) (cv z))) (wb (wcel (cv d) (cv a)) (wcel (cv d) (cv b)))) (cfv (cuni (cdm (cv z))) cr1))) (cfv (cuni (cdm (cv z))) cr1))) $ >
  $ wceq C (cmpt a cvv (csup (cfv (cv a) (cv y1)) (cfv (cdm (cv z)) cr1) B2)) $ >
  $ wi ph (wcel (cdm (cv z)) con0) $ >
  $ wi ph (wceq (cdm (cv z)) (csuc (cuni (cdm (cv z))))) $ >
  $ wi ph (wral a (wwe (cfv (cv a) cr1) (cfv (cv a) (cv z))) (cdm (cv z))) $ >
  $ wi ph (wcel A2 con0) $ >
  $ wi ph (wss (cdm (cv z)) A2) $ >
  $ wi ph (wral a (wi (wne (cv a) c0) (wcel (cfv (cv a) (cv y1)) (cdif (cin (cpw (cv a)) cfn) (csn c0)))) (cpw (cfv A2 cr1))) $ >
  $ wi ph (wral a (wi (wne (cv a) c0) (wcel (cfv (cv a) C) (cv a))) (cpw (cfv (cdm (cv z)) cr1))) $;

--| Lemma for ~ dfac11 . Successor case 3, our required well-ordering. (Contributed by Stefan O'Rear, 19-Jan-2015.)
theorem aomclem3 {y1 z a b c d: setvar} (ph: wff y1 z c d) (A2 B2: class y1 z a b c d) (C D: class y1 z) (E: class y1 z a b c d):
  $ wceq B2 (copab a b (wrex c (wa (wa (wcel (cv c) (cv b)) (wn (wcel (cv c) (cv a)))) (wral d (wi (wbr (cv d) (cv c) (cfv (cuni (cdm (cv z))) (cv z))) (wb (wcel (cv d) (cv a)) (wcel (cv d) (cv b)))) (cfv (cuni (cdm (cv z))) cr1))) (cfv (cuni (cdm (cv z))) cr1))) $ >
  $ wceq C (cmpt a cvv (csup (cfv (cv a) (cv y1)) (cfv (cdm (cv z)) cr1) B2)) $ >
  $ wceq D (crecs (cmpt a cvv (cfv (cdif (cfv (cdm (cv z)) cr1) (crn (cv a))) C))) $ >
  $ wceq E (copab a b (wcel (cint (cima (ccnv D) (csn (cv a)))) (cint (cima (ccnv D) (csn (cv b)))))) $ >
  $ wi ph (wcel (cdm (cv z)) con0) $ >
  $ wi ph (wceq (cdm (cv z)) (csuc (cuni (cdm (cv z))))) $ >
  $ wi ph (wral a (wwe (cfv (cv a) cr1) (cfv (cv a) (cv z))) (cdm (cv z))) $ >
  $ wi ph (wcel A2 con0) $ >
  $ wi ph (wss (cdm (cv z)) A2) $ >
  $ wi ph (wral a (wi (wne (cv a) c0) (wcel (cfv (cv a) (cv y1)) (cdif (cin (cpw (cv a)) cfn) (csn c0)))) (cpw (cfv A2 cr1))) $ >
  $ wi ph (wwe (cfv (cdm (cv z)) cr1) E) $;

--| Lemma for ~ dfac11 . Limit case. Patch together well-orderings constructed so far using ~ fnwe2 to cover the limit rank. (Contributed by Stefan O'Rear, 20-Jan-2015.)
theorem aomclem4 {z a b: setvar} (ph: wff z) (F: class z a b):
  $ wceq F (copab a b (wo (wbr (cfv (cv a) crnk) (cfv (cv b) crnk) cep) (wa (wceq (cfv (cv a) crnk) (cfv (cv b) crnk)) (wbr (cv a) (cv b) (cfv (csuc (cfv (cv a) crnk)) (cv z)))))) $ >
  $ wi ph (wcel (cdm (cv z)) con0) $ >
  $ wi ph (wceq (cdm (cv z)) (cuni (cdm (cv z)))) $ >
  $ wi ph (wral a (wwe (cfv (cv a) cr1) (cfv (cv a) (cv z))) (cdm (cv z))) $ >
  $ wi ph (wwe (cfv (cdm (cv z)) cr1) F) $;

--| Lemma for ~ dfac11 . Combine the successor case with the limit case. (Contributed by Stefan O'Rear, 20-Jan-2015.)
theorem aomclem5 {y1 z a b c d: setvar} (ph: wff y1 z c d) (A2 B2: class y1 z a b c d) (C D: class y1 z) (E F G: class y1 z a b c d):
  $ wceq B2 (copab a b (wrex c (wa (wa (wcel (cv c) (cv b)) (wn (wcel (cv c) (cv a)))) (wral d (wi (wbr (cv d) (cv c) (cfv (cuni (cdm (cv z))) (cv z))) (wb (wcel (cv d) (cv a)) (wcel (cv d) (cv b)))) (cfv (cuni (cdm (cv z))) cr1))) (cfv (cuni (cdm (cv z))) cr1))) $ >
  $ wceq C (cmpt a cvv (csup (cfv (cv a) (cv y1)) (cfv (cdm (cv z)) cr1) B2)) $ >
  $ wceq D (crecs (cmpt a cvv (cfv (cdif (cfv (cdm (cv z)) cr1) (crn (cv a))) C))) $ >
  $ wceq E (copab a b (wcel (cint (cima (ccnv D) (csn (cv a)))) (cint (cima (ccnv D) (csn (cv b)))))) $ >
  $ wceq F (copab a b (wo (wbr (cfv (cv a) crnk) (cfv (cv b) crnk) cep) (wa (wceq (cfv (cv a) crnk) (cfv (cv b) crnk)) (wbr (cv a) (cv b) (cfv (csuc (cfv (cv a) crnk)) (cv z)))))) $ >
  $ wceq G (cin (cif (wceq (cdm (cv z)) (cuni (cdm (cv z)))) F E) (cxp (cfv (cdm (cv z)) cr1) (cfv (cdm (cv z)) cr1))) $ >
  $ wi ph (wcel (cdm (cv z)) con0) $ >
  $ wi ph (wral a (wwe (cfv (cv a) cr1) (cfv (cv a) (cv z))) (cdm (cv z))) $ >
  $ wi ph (wcel A2 con0) $ >
  $ wi ph (wss (cdm (cv z)) A2) $ >
  $ wi ph (wral a (wi (wne (cv a) c0) (wcel (cfv (cv a) (cv y1)) (cdif (cin (cpw (cv a)) cfn) (csn c0)))) (cpw (cfv A2 cr1))) $ >
  $ wi ph (wwe (cfv (cdm (cv z)) cr1) G) $;

--| Lemma for ~ dfac11 . Transfinite induction, close over ` z ` . (Contributed by Stefan O'Rear, 20-Jan-2015.)
theorem aomclem6 {y1 z a b c d: setvar} (ph: wff y1) (A2: class y1) (B2: class y1 z a b c d) (C D: class y1 z) (E F: class y1 z a b c d) (G: class y1 z a b c) (H: class y1):
  $ wceq B2 (copab a b (wrex c (wa (wa (wcel (cv c) (cv b)) (wn (wcel (cv c) (cv a)))) (wral d (wi (wbr (cv d) (cv c) (cfv (cuni (cdm (cv z))) (cv z))) (wb (wcel (cv d) (cv a)) (wcel (cv d) (cv b)))) (cfv (cuni (cdm (cv z))) cr1))) (cfv (cuni (cdm (cv z))) cr1))) $ >
  $ wceq C (cmpt a cvv (csup (cfv (cv a) (cv y1)) (cfv (cdm (cv z)) cr1) B2)) $ >
  $ wceq D (crecs (cmpt a cvv (cfv (cdif (cfv (cdm (cv z)) cr1) (crn (cv a))) C))) $ >
  $ wceq E (copab a b (wcel (cint (cima (ccnv D) (csn (cv a)))) (cint (cima (ccnv D) (csn (cv b)))))) $ >
  $ wceq F (copab a b (wo (wbr (cfv (cv a) crnk) (cfv (cv b) crnk) cep) (wa (wceq (cfv (cv a) crnk) (cfv (cv b) crnk)) (wbr (cv a) (cv b) (cfv (csuc (cfv (cv a) crnk)) (cv z)))))) $ >
  $ wceq G (cin (cif (wceq (cdm (cv z)) (cuni (cdm (cv z)))) F E) (cxp (cfv (cdm (cv z)) cr1) (cfv (cdm (cv z)) cr1))) $ >
  $ wceq H (crecs (cmpt z cvv G)) $ >
  $ wi ph (wcel A2 con0) $ >
  $ wi ph (wral a (wi (wne (cv a) c0) (wcel (cfv (cv a) (cv y1)) (cdif (cin (cpw (cv a)) cfn) (csn c0)))) (cpw (cfv A2 cr1))) $ >
  $ wi ph (wwe (cfv A2 cr1) (cfv A2 H)) $;

--| Lemma for ~ dfac11 . ` ( R1 `` A ) ` is well-orderable. (Contributed by Stefan O'Rear, 20-Jan-2015.)
theorem aomclem7 {y1 z a b c d: setvar} (ph: wff y1) (A2: class y1) (B2: class y1 z a b c d) (C D: class y1 z) (E F: class y1 z a b c d) (G: class y1 z a b c) (H: class y1):
  $ wceq B2 (copab a b (wrex c (wa (wa (wcel (cv c) (cv b)) (wn (wcel (cv c) (cv a)))) (wral d (wi (wbr (cv d) (cv c) (cfv (cuni (cdm (cv z))) (cv z))) (wb (wcel (cv d) (cv a)) (wcel (cv d) (cv b)))) (cfv (cuni (cdm (cv z))) cr1))) (cfv (cuni (cdm (cv z))) cr1))) $ >
  $ wceq C (cmpt a cvv (csup (cfv (cv a) (cv y1)) (cfv (cdm (cv z)) cr1) B2)) $ >
  $ wceq D (crecs (cmpt a cvv (cfv (cdif (cfv (cdm (cv z)) cr1) (crn (cv a))) C))) $ >
  $ wceq E (copab a b (wcel (cint (cima (ccnv D) (csn (cv a)))) (cint (cima (ccnv D) (csn (cv b)))))) $ >
  $ wceq F (copab a b (wo (wbr (cfv (cv a) crnk) (cfv (cv b) crnk) cep) (wa (wceq (cfv (cv a) crnk) (cfv (cv b) crnk)) (wbr (cv a) (cv b) (cfv (csuc (cfv (cv a) crnk)) (cv z)))))) $ >
  $ wceq G (cin (cif (wceq (cdm (cv z)) (cuni (cdm (cv z)))) F E) (cxp (cfv (cdm (cv z)) cr1) (cfv (cdm (cv z)) cr1))) $ >
  $ wceq H (crecs (cmpt z cvv G)) $ >
  $ wi ph (wcel A2 con0) $ >
  $ wi ph (wral a (wi (wne (cv a) c0) (wcel (cfv (cv a) (cv y1)) (cdif (cin (cpw (cv a)) cfn) (csn c0)))) (cpw (cfv A2 cr1))) $ >
  $ wi ph (wex b (wwe (cfv A2 cr1) (cv b))) $;

--| Lemma for ~ dfac11 . Perform variable substitutions. This is the most we can say without invoking regularity. (Contributed by Stefan O'Rear, 20-Jan-2015.)
theorem aomclem8 {y1 a b: setvar} (ph: wff y1 a) (A2: class y1):
  $ wi ph (wcel A2 con0) $ >
  $ wi ph (wral a (wi (wne (cv a) c0) (wcel (cfv (cv a) (cv y1)) (cdif (cin (cpw (cv a)) cfn) (csn c0)))) (cpw (cfv A2 cr1))) $ >
  $ wi ph (wex b (wwe (cfv A2 cr1) (cv b))) $;

--| The right-hand side of this theorem (compare with ~ ac4 ), sometimes known as the "axiom of multiple choice", is a choice equivalent. Curiously, this statement cannot be proved without ~ ax-reg , despite not mentioning the cumulative hierarchy in any way as most consequences of regularity do. This is definition (MC) of [Schechter] p. 141. _EDITORIAL_: the proof is not original with me of course but I lost my reference sometime after writing it. A multiple choice function allows any total order to be extended to a choice function, which in turn defines a well-ordering. Since a well-ordering on a set defines a simple ordering of the power set, this allows the trivial well-ordering of the empty set to be transfinitely bootstrapped up the cumulative hierarchy to any desired level. (Contributed by Stefan O'Rear, 20-Jan-2015.) (Revised by Stefan O'Rear, 1-Jun-2015.)
theorem dfac11 {x3 z f2: setvar}:
  $ wb wac (wal x3 (wex f2 (wral z (wi (wne (cv z) c0) (wcel (cfv (cv z) (cv f2)) (cdif (cin (cpw (cv z)) cfn) (csn c0)))) (cv x3)))) $;

--| Kelley's choice, basic form: if a collection of sets can be cast as closed sets in the factors of a topology, and there is a definable element in each topology (which need not be in the closed set - if it were this would be trivial), then compactness (via finite intersection) guarantees that the final product is nonempty. (Contributed by Stefan O'Rear, 22-Feb-2015.)
theorem kelac1 {x3: setvar} (ph: wff) (B2 C S U: class x3) (I: class) (J: class x3):
  $ wi (wa ph (wcel (cv x3) I)) (wne S c0) $ >
  $ wi (wa ph (wcel (cv x3) I)) (wcel J ctop) $ >
  $ wi (wa ph (wcel (cv x3) I)) (wcel C (cfv J ccld)) $ >
  $ wi (wa ph (wcel (cv x3) I)) (wf1o S C B2) $ >
  $ wi (wa ph (wcel (cv x3) I)) (wcel U (cuni J)) $ >
  $ wi ph (wcel (cfv (cmpt x3 I J) cpt) ccmp) $ >
  $ wi ph (wne (cixp x3 I S) c0) $;

--| Lemma for ~ kelac2 and ~ dfac21 : knob topologies are compact. (Contributed by Stefan O'Rear, 22-Feb-2015.)
theorem kelac2lem (S V: class):
  $ wi (wcel S V) (wcel (cfv (cpr S (csn (cpw (cuni S)))) ctg) ccmp) $;

--| Kelley's choice, most common form: compactness of a product of knob topologies recovers choice. (Contributed by Stefan O'Rear, 22-Feb-2015.)
theorem kelac2 {x3: setvar} (ph: wff) (S: class x3) (I: class) (V: class x3):
  $ wi (wa ph (wcel (cv x3) I)) (wcel S V) $ >
  $ wi (wa ph (wcel (cv x3) I)) (wne S c0) $ >
  $ wi ph (wcel (cfv (cmpt x3 I (cfv (cpr S (csn (cpw (cuni S)))) ctg)) cpt) ccmp) $ >
  $ wi ph (wne (cixp x3 I S) c0) $;

--| Tychonoff's theorem is a choice equivalent. Definition AC21 of Schechter p. 461. (Contributed by Stefan O'Rear, 22-Feb-2015.) (Revised by Mario Carneiro, 27-Aug-2015.)
theorem dfac21 {f2: setvar}:
  $ wb wac (wal f2 (wi (wf (cdm (cv f2)) ccmp (cv f2)) (wcel (cfv (cv f2) cpt) ccmp))) $;

--| Extend class notation with the class of finitely generated left modules.
term clfig: class;

--| Define the class of finitely generated left modules. Finite generation of subspaces can be interpreted using ` |``s ` . (Contributed by Stefan O'Rear, 1-Jan-2015.)
axiom df_lfig {w: setvar}:
  $ wceq clfig (crab w (wcel (cfv (cv w) cbs) (cima (cfv (cv w) clspn) (cin (cpw (cfv (cv w) cbs)) cfn))) clmod) $;

--| Property of a finitely generated left module. (Contributed by Stefan O'Rear, 1-Jan-2015.)
theorem islmodfg {b: setvar} (B2 N W: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (wcel W clmod) (wb (wcel W clfig) (wrex b (wa (wcel (cv b) cfn) (wceq (cfv (cv b) N) B2)) (cpw B2))) $;

--| Property of a finitely generated left (sub)module. (Contributed by Stefan O'Rear, 1-Jan-2015.)
theorem islssfg {b: setvar} (S U N W X: class):
  $ wceq X (co W U cress) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (wa (wcel W clmod) (wcel U S)) (wb (wcel X clfig) (wrex b (wa (wcel (cv b) cfn) (wceq (cfv (cv b) N) U)) (cpw U))) $;

--| Property of a finitely generated left (sub)module, with a relaxed constraint on the spanning vectors. (Contributed by Stefan O'Rear, 24-Jan-2015.)
theorem islssfg2 {b: setvar} (B2: class b) (S U N W X: class):
  $ wceq X (co W U cress) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wi (wa (wcel W clmod) (wcel U S)) (wb (wcel X clfig) (wrex b (wceq (cfv (cv b) N) U) (cin (cpw B2) cfn))) $;

--| Finitely spanned subspaces are finitely generated. (Contributed by Stefan O'Rear, 24-Jan-2015.)
theorem islssfgi (B2 N V W X: class):
  $ wceq N (cfv W clspn) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq X (co W (cfv B2 N) cress) $ >
  $ wi (w3a (wcel W clmod) (wss B2 V) (wcel B2 cfn)) (wcel X clfig) $;

--| Finitely generated left modules are left modules. (Contributed by Stefan O'Rear, 1-Jan-2015.)
theorem fglmod (M: class):
  $ wi (wcel M clfig) (wcel M clmod) $;

--| The sum of two finitely generated submodules is finitely generated. (Contributed by Stefan O'Rear, 24-Jan-2015.)
theorem lsmfgcl (ph: wff) (A2 B2 D c_po U E F W: class):
  $ wceq U (cfv W clss) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq D (co W A2 cress) $ >
  $ wceq E (co W B2 cress) $ >
  $ wceq F (co W (co A2 B2 c_po) cress) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel A2 U) $ >
  $ wi ph (wcel B2 U) $ >
  $ wi ph (wcel D clfig) $ >
  $ wi ph (wcel E clfig) $ >
  $ wi ph (wcel F clfig) $;

--| Extend class notation with the class of Noetherian left modules.
term clnm: class;

--| A left-module is _Noetherian_ iff it is hereditarily finitely generated. (Contributed by Stefan O'Rear, 12-Dec-2014.)
axiom df_lnm {w i: setvar}:
  $ wceq clnm (crab w (wral i (wcel (co (cv w) (cv i) cress) clfig) (cfv (cv w) clss)) clmod) $;

--| Property of being a Noetherian left module. (Contributed by Stefan O'Rear, 12-Dec-2014.)
theorem islnm {i: setvar} (S M: class):
  $ wceq S (cfv M clss) $ >
  $ wb (wcel M clnm) (wa (wcel M clmod) (wral i (wcel (co M (cv i) cress) clfig) S)) $;

--| Property of being a Noetherian left module with finite generation expanded in terms of spans. (Contributed by Stefan O'Rear, 24-Jan-2015.)
theorem islnm2 {g2 i: setvar} (B2 S M N: class):
  $ wceq B2 (cfv M cbs) $ >
  $ wceq S (cfv M clss) $ >
  $ wceq N (cfv M clspn) $ >
  $ wb (wcel M clnm) (wa (wcel M clmod) (wral i (wrex g2 (wceq (cv i) (cfv (cv g2) N)) (cin (cpw B2) cfn)) S)) $;

--| A Noetherian left module is a left module. (Contributed by Stefan O'Rear, 12-Dec-2014.)
theorem lnmlmod (M: class):
  $ wi (wcel M clnm) (wcel M clmod) $;

--| A submodule of Noetherian module is finitely generated. (Contributed by Stefan O'Rear, 1-Jan-2015.)
theorem lnmlssfg (R S U M: class):
  $ wceq S (cfv M clss) $ >
  $ wceq R (co M U cress) $ >
  $ wi (wa (wcel M clnm) (wcel U S)) (wcel R clfig) $;

--| All submodules of a Noetherian module are Noetherian. (Contributed by Stefan O'Rear, 1-Jan-2015.)
theorem lnmlsslnm (R S U M: class):
  $ wceq S (cfv M clss) $ >
  $ wceq R (co M U cress) $ >
  $ wi (wa (wcel M clnm) (wcel U S)) (wcel R clnm) $;

--| A Noetherian left module is finitely generated. (Contributed by Stefan O'Rear, 12-Dec-2014.)
theorem lnmfg (M: class):
  $ wi (wcel M clnm) (wcel M clfig) $;

--| The domain of a linear function is the subspace sum of the kernel and any subspace which covers the range. (Contributed by Stefan O'Rear, 24-Jan-2015.) (Revised by Stefan O'Rear, 6-May-2015.)
theorem kercvrlsm (ph: wff) (B2 D c_po S T U F K c_0: class):
  $ wceq U (cfv S clss) $ >
  $ wceq c_po (cfv S clsm) $ >
  $ wceq c_0 (cfv T c0g) $ >
  $ wceq K (cima (ccnv F) (csn c_0)) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel F (co S T clmhm)) $ >
  $ wi ph (wcel D U) $ >
  $ wi ph (wceq (cima F D) (crn F)) $ >
  $ wi ph (wceq (co K D c_po) B2) $;

--| A homomorphism maps finitely generated submodules to finitely generated submodules. (Contributed by Stefan O'Rear, 24-Jan-2015.)
theorem lmhmfgima (ph: wff) (A2 S T U F X Y: class):
  $ wceq Y (co T (cima F A2) cress) $ >
  $ wceq X (co S A2 cress) $ >
  $ wceq U (cfv S clss) $ >
  $ wi ph (wcel X clfig) $ >
  $ wi ph (wcel A2 U) $ >
  $ wi ph (wcel F (co S T clmhm)) $ >
  $ wi ph (wcel Y clfig) $;

--| Epimorphic images of Noetherian modules are Noetherian. (Contributed by Stefan O'Rear, 24-Jan-2015.)
theorem lnmepi (B2 S T F: class):
  $ wceq B2 (cfv T cbs) $ >
  $ wi (w3a (wcel F (co S T clmhm)) (wcel S clnm) (wceq (crn F) B2)) (wcel T clnm) $;

--| If the kernel and range of a homomorphism of left modules are finitely generated, then so is the domain. (Contributed by Stefan O'Rear, 1-Jan-2015.) (Revised by Stefan O'Rear, 6-May-2015.)
theorem lmhmfgsplit (S T U F K V c_0: class):
  $ wceq c_0 (cfv T c0g) $ >
  $ wceq K (cima (ccnv F) (csn c_0)) $ >
  $ wceq U (co S K cress) $ >
  $ wceq V (co T (crn F) cress) $ >
  $ wi (w3a (wcel F (co S T clmhm)) (wcel U clfig) (wcel V clfig)) (wcel S clfig) $;

--| If the kernel and range of a homomorphism of left modules are Noetherian, then so is the domain. (Contributed by Stefan O'Rear, 1-Jan-2015.) (Revised by Stefan O'Rear, 12-Jun-2015.)
theorem lmhmlnmsplit (S T U F K V c_0: class):
  $ wceq c_0 (cfv T c0g) $ >
  $ wceq K (cima (ccnv F) (csn c_0)) $ >
  $ wceq U (co S K cress) $ >
  $ wceq V (co T (crn F) cress) $ >
  $ wi (w3a (wcel F (co S T clmhm)) (wcel U clnm) (wcel V clnm)) (wcel S clnm) $;

--| Noetherian is an invariant property of modules. (Contributed by Stefan O'Rear, 25-Jan-2015.)
theorem lnmlmic (R S: class):
  $ wi (wbr R S clmic) (wb (wcel R clnm) (wcel S clnm)) $;

--| Splitting for structure powers 4: maps isomorphically onto the other half. (Contributed by Stefan O'Rear, 25-Jan-2015.)
theorem pwssplit4 {x3 y1: setvar} (A2 B2 C D R E: class) (F: class x3 y1) (G: class) (K L: class y1) (V c_0: class):
  $ wceq E (co R (cun A2 B2) cpws) $ >
  $ wceq G (cfv E cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq K (crab y1 (wceq (cres (cv y1) A2) (cxp A2 (csn c_0))) G) $ >
  $ wceq F (cmpt x3 K (cres (cv x3) B2)) $ >
  $ wceq C (co R A2 cpws) $ >
  $ wceq D (co R B2 cpws) $ >
  $ wceq L (co E K cress) $ >
  $ wi (w3a (wcel R clmod) (wcel (cun A2 B2) V) (wceq (cin A2 B2) c0)) (wcel F (co L D clmim)) $;

--| Finite left modules are Noetherian. (Contributed by Stefan O'Rear, 24-Jan-2015.)
theorem filnm (B2 W: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wi (wa (wcel W clmod) (wcel B2 cfn)) (wcel W clnm) $;

--| Zeroeth powers are Noetherian. (Contributed by Stefan O'Rear, 24-Jan-2015.)
theorem pwslnmlem0 (W Y: class):
  $ wceq Y (co W c0 cpws) $ >
  $ wi (wcel W clmod) (wcel Y clnm) $;

--| First powers are Noetherian. (Contributed by Stefan O'Rear, 24-Jan-2015.)
theorem pwslnmlem1 {i: setvar} (W: class) (Y: class i):
  $ wceq Y (co W (csn (cv i)) cpws) $ >
  $ wi (wcel W clnm) (wcel Y clnm) $;

--| A sum of powers is Noetherian. (Contributed by Stefan O'Rear, 25-Jan-2015.)
theorem pwslnmlem2 (ph: wff) (A2 B2 W X Y Z: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq X (co W A2 cpws) $ >
  $ wceq Y (co W B2 cpws) $ >
  $ wceq Z (co W (cun A2 B2) cpws) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wceq (cin A2 B2) c0) $ >
  $ wi ph (wcel X clnm) $ >
  $ wi ph (wcel Y clnm) $ >
  $ wi ph (wcel Z clnm) $;

--| Finite powers of Noetherian modules are Noetherian. (Contributed by Stefan O'Rear, 24-Jan-2015.)
theorem pwslnm (I W Y: class):
  $ wceq Y (co W I cpws) $ >
  $ wi (wa (wcel W clnm) (wcel I cfn)) (wcel Y clnm) $;

--| Weaker version of ~ unxpwdom where a function is required only to be cancellative, not an injection. ` D ` and ` B ` are to be thought of as "large" "horizonal" sets, the others as "small". Because the operator is row-wise injective, but the whole row cannot inject into ` A ` , each row must hit an element of ` B ` ; by column injectivity, each row can be identified in at least one way by the ` B ` element that it hits and the column in which it is hit. (Contributed by Stefan O'Rear, 8-Jul-2015.) _MOVABLE_
theorem unxpwdom3 {a b c d: setvar} (ph: wff) (A2: class a d) (B2 C D c_pl: class) (V W X: class a b c d):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel D X) $ >
  $ wi (w3a ph (wcel (cv a) C) (wcel (cv b) D)) (wcel (co (cv a) (cv b) c_pl) (cun A2 B2)) $ >
  $ wi (wa (wa ph (wcel (cv a) C)) (wa (wcel (cv b) D) (wcel (cv c) D))) (wb (wceq (co (cv a) (cv b) c_pl) (co (cv a) (cv c) c_pl)) (wceq (cv b) (cv c))) $ >
  $ wi (wa (wa ph (wcel (cv d) D)) (wa (wcel (cv a) C) (wcel (cv c) C))) (wb (wceq (co (cv c) (cv d) c_pl) (co (cv a) (cv d) c_pl)) (wceq (cv c) (cv a))) $ >
  $ wi ph (wn (wbr D A2 cdom)) $ >
  $ wi ph (wbr C (cxp D B2) cwdom) $;

--| The ~ pw2f1o bijection relates finitely supported indicator functions on a two-element set to finite subsets. _MOVABLE_ (Contributed by Stefan O'Rear, 10-Jul-2015.) (Revised by AV, 14-Jun-2020.)
theorem pwfi2f1o {x3 y1: setvar} (A2: class) (S: class y1) (F: class x3 y1) (V: class):
  $ wceq S (crab y1 (wbr (cv y1) c0 cfsupp) (co c2o A2 cmap)) $ >
  $ wceq F (cmpt x3 S (cima (ccnv (cv x3)) (csn c1o))) $ >
  $ wi (wcel A2 V) (wf1o S (cin (cpw A2) cfn) F) $;

--| Finitely supported indicator functions are equinumerous to finite subsets. _MOVABLE_ (Contributed by Stefan O'Rear, 10-Jul-2015.) (Revised by AV, 14-Jun-2020.)
theorem pwfi2en {y1: setvar} (A2: class) (S: class y1) (V: class):
  $ wceq S (crab y1 (wbr (cv y1) c0 cfsupp) (co c2o A2 cmap)) $ >
  $ wi (wcel A2 V) (wbr S (cin (cpw A2) cfn) cen) $;

--| Formal linear combinations over Z/2Z are equivalent to finite subsets. _MOVABLE_ (Contributed by Stefan O'Rear, 10-Jul-2015.) (Proof shortened by AV, 14-Jun-2020.)
theorem frlmpwfi (B2 R I V Y: class):
  $ wceq R (cfv c2 czn) $ >
  $ wceq Y (co R I cfrlm) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wi (wcel I V) (wbr B2 (cin (cpw I) cfn) cen) $;

--| Being Abelian is a group invariant. _MOVABLE_ (Contributed by Stefan O'Rear, 8-Jul-2015.)
theorem gicabl (G H: class):
  $ wi (wbr G H cgic) (wb (wcel G cabl) (wcel H cabl)) $;

--| A relabeling of the elements of a group induces an isomorphism to the relabeled group. _MOVABLE_ (Contributed by Stefan O'Rear, 8-Jul-2015.) (Revised by Mario Carneiro, 11-Aug-2015.)
theorem imasgim (ph: wff) (B2 R U F V: class):
  $ wi ph (wceq U (co F R cimas)) $ >
  $ wi ph (wceq V (cfv R cbs)) $ >
  $ wi ph (wf1o V B2 F) $ >
  $ wi ph (wcel R cgrp) $ >
  $ wi ph (wcel F (co R U cgim)) $;

--| A set which is equipollent to the base set of a definable Abelian group is the base set of some (relabeled) Abelian group. (Contributed by Stefan O'Rear, 8-Jul-2015.)
theorem isnumbasgrplem1 (B2 C R: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wa (wcel R cabl) (wbr C B2 cen)) (wcel C (cima cbs cabl)) $;

--| The Hartogs number of a set is never zero. _MOVABLE_ (Contributed by Stefan O'Rear, 9-Jul-2015.)
theorem harn0 (S V: class):
  $ wi (wcel S V) (wne (cfv S char) c0) $;

--| A numerable infinite set contains a countable subset. _MOVABLE_ (Contributed by Stefan O'Rear, 9-Jul-2015.)
theorem numinfctb (S: class):
  $ wi (wa (wcel S (cdm ccrd)) (wn (wcel S cfn))) (wbr com S cdom) $;

--| If the (to be thought of as disjoint, although the proof does not require this) union of a set and its Hartogs number supports a group structure (more generally, a cancellative magma), then the set must be numerable. (Contributed by Stefan O'Rear, 9-Jul-2015.)
theorem isnumbasgrplem2 (S: class):
  $ wi (wcel (cun S (cfv S char)) (cima cbs cgrp)) (wcel S (cdm ccrd)) $;

--| Every nonempty numerable set can be given the structure of an Abelian group, either a finite cyclic group or a vector space over Z/2Z. (Contributed by Stefan O'Rear, 10-Jul-2015.)
theorem isnumbasgrplem3 (S: class):
  $ wi (wa (wcel S (cdm ccrd)) (wne S c0)) (wcel S (cima cbs cabl)) $;

--| A set is numerable iff it and its Hartogs number can be jointly given the structure of an Abelian group. (Contributed by Stefan O'Rear, 9-Jul-2015.)
theorem isnumbasabl (S: class):
  $ wb (wcel S (cdm ccrd)) (wcel (cun S (cfv S char)) (cima cbs cabl)) $;

--| A set is numerable iff it and its Hartogs number can be jointly given the structure of a group. (Contributed by Stefan O'Rear, 9-Jul-2015.)
theorem isnumbasgrp (S: class):
  $ wb (wcel S (cdm ccrd)) (wcel (cun S (cfv S char)) (cima cbs cgrp)) $;

--| A choice equivalent in abstract algebra: All nonempty sets admit a group structure. From ~ http://mathoverflow.net/a/12988 . (Contributed by Stefan O'Rear, 9-Jul-2015.)
theorem dfacbasgrp:
  $ wb wac (wceq (cima cbs cgrp) (cdif cvv (csn c0))) $;

--| Extend class notation with the class of left Noetherian rings.
term clnr: class;

--| A ring is _left-Noetherian_ iff it is Noetherian as a left module over itself. (Contributed by Stefan O'Rear, 24-Jan-2015.)
axiom df_lnr {a: setvar}:
  $ wceq clnr (crab a (wcel (cfv (cv a) crglmod) clnm) crg) $;

--| Property of a left-Noetherian ring. (Contributed by Stefan O'Rear, 24-Jan-2015.)
theorem islnr (A2: class):
  $ wb (wcel A2 clnr) (wa (wcel A2 crg) (wcel (cfv A2 crglmod) clnm)) $;

--| Left-Noetherian rings are rings. (Contributed by Stefan O'Rear, 24-Jan-2015.)
theorem lnrring (A2: class):
  $ wi (wcel A2 clnr) (wcel A2 crg) $;

--| Left-Noetherian rings have Noetherian associated modules. (Contributed by Stefan O'Rear, 24-Jan-2015.)
theorem lnrlnm (A2: class):
  $ wi (wcel A2 clnr) (wcel (cfv A2 crglmod) clnm) $;

--| Property of being a left-Noetherian ring in terms of finite generation of ideals (the usual "pure ring theory" definition). (Contributed by Stefan O'Rear, 24-Jan-2015.)
theorem islnr2 {g2 i: setvar} (B2 R U N: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R clidl) $ >
  $ wceq N (cfv R crsp) $ >
  $ wb (wcel R clnr) (wa (wcel R crg) (wral i (wrex g2 (wceq (cv i) (cfv (cv g2) N)) (cin (cpw B2) cfn)) U)) $;

--| Relate left-Noetherian rings to Noetherian-type closure property of the left ideal system. (Contributed by Stefan O'Rear, 4-Apr-2015.)
theorem islnr3 (B2 R U: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R clidl) $ >
  $ wb (wcel R clnr) (wa (wcel R crg) (wcel U (cfv B2 cnacs))) $;

--| Given an ideal in a left-Noetherian ring, there is a finite subset which generates it. (Contributed by Stefan O'Rear, 31-Mar-2015.)
theorem lnr2i {g2: setvar} (R U I N: class):
  $ wceq U (cfv R clidl) $ >
  $ wceq N (cfv R crsp) $ >
  $ wi (wa (wcel R clnr) (wcel I U)) (wrex g2 (wceq I (cfv (cv g2) N)) (cin (cpw I) cfn)) $;

--| Left principal ideal rings are left Noetherian. (Contributed by Stefan O'Rear, 24-Jan-2015.)
theorem lpirlnr (R: class):
  $ wi (wcel R clpir) (wcel R clnr) $;

--| Finite-dimensional free modules over a Noetherian ring are Noetherian. (Contributed by Stefan O'Rear, 3-Feb-2015.)
theorem lnrfrlm (R I Y: class):
  $ wceq Y (co R I cfrlm) $ >
  $ wi (wa (wcel R clnr) (wcel I cfn)) (wcel Y clnm) $;

--| Finitely-generated modules over a Noetherian ring, being homomorphic images of free modules, are Noetherian. (Contributed by Stefan O'Rear, 7-Feb-2015.)
theorem lnrfg (S M: class):
  $ wceq S (cfv M csca) $ >
  $ wi (wa (wcel M clfig) (wcel S clnr)) (wcel M clnm) $;

--| A submodule of a finitely generated module over a Noetherian ring is finitely generated. Often taken as the definition of Noetherian ring. (Contributed by Stefan O'Rear, 7-Feb-2015.)
theorem lnrfgtr (P S U M N: class):
  $ wceq S (cfv M csca) $ >
  $ wceq U (cfv M clss) $ >
  $ wceq N (co M P cress) $ >
  $ wi (w3a (wcel M clfig) (wcel S clnr) (wcel P U)) (wcel N clfig) $;

--| The leading ideal sequence used in the Hilbert Basis Theorem.
term cldgis: class;

--| Define a function which carries polynomial ideals to the sequence of coefficient ideals of leading coefficients of degree- ` x ` elements in the polynomial ideal. The proof that this map is strictly monotone is the core of the Hilbert Basis Theorem ~ hbt . (Contributed by Stefan O'Rear, 31-Mar-2015.)
axiom df_ldgis {x3 i j k r: setvar}:
  $ wceq cldgis (cmpt r cvv (cmpt i (cfv (cfv (cv r) cpl1) clidl) (cmpt x3 cn0 (cab j (wrex k (wa (wbr (cfv (cv k) (cfv (cv r) cdg1)) (cv x3) cle) (wceq (cv j) (cfv (cv x3) (cfv (cv k) cco1)))) (cv i)))))) $;

--| Value of the leading coefficient sequence function. (Contributed by Stefan O'Rear, 31-Mar-2015.)
theorem hbtlem1 {j k: setvar} (D P: class j k) (R: class) (S U: class j k) (I: class) (V: class j k) (X: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq U (cfv P clidl) $ >
  $ wceq S (cfv R cldgis) $ >
  $ wceq D (cfv R cdg1) $ >
  $ wi (w3a (wcel R V) (wcel I U) (wcel X cn0)) (wceq (cfv X (cfv I S)) (cab j (wrex k (wa (wbr (cfv (cv k) D) X cle) (wceq (cv j) (cfv X (cfv (cv k) cco1)))) I))) $;

--| Leading coefficient ideals are ideals. (Contributed by Stefan O'Rear, 1-Apr-2015.)
theorem hbtlem2 (P R S T U I X: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq U (cfv P clidl) $ >
  $ wceq S (cfv R cldgis) $ >
  $ wceq T (cfv R clidl) $ >
  $ wi (w3a (wcel R crg) (wcel I U) (wcel X cn0)) (wcel (cfv X (cfv I S)) T) $;

--| Functionality of leading coefficient ideal sequence. (Contributed by Stefan O'Rear, 4-Apr-2015.)
theorem hbtlem7 (P R S T U I: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq U (cfv P clidl) $ >
  $ wceq S (cfv R cldgis) $ >
  $ wceq T (cfv R clidl) $ >
  $ wi (wa (wcel R crg) (wcel I U)) (wf cn0 T (cfv I S)) $;

--| The leading ideal function goes to increasing sequences. (Contributed by Stefan O'Rear, 1-Apr-2015.)
theorem hbtlem4 (ph: wff) (P R S U I X Y: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq U (cfv P clidl) $ >
  $ wceq S (cfv R cldgis) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel I U) $ >
  $ wi ph (wcel X cn0) $ >
  $ wi ph (wcel Y cn0) $ >
  $ wi ph (wbr X Y cle) $ >
  $ wi ph (wss (cfv X (cfv I S)) (cfv Y (cfv I S))) $;

--| The leading ideal function is monotone. (Contributed by Stefan O'Rear, 31-Mar-2015.)
theorem hbtlem3 (ph: wff) (P R S U I J X: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq U (cfv P clidl) $ >
  $ wceq S (cfv R cldgis) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel I U) $ >
  $ wi ph (wcel J U) $ >
  $ wi ph (wss I J) $ >
  $ wi ph (wcel X cn0) $ >
  $ wi ph (wss (cfv X (cfv I S)) (cfv X (cfv J S))) $;

--| The leading ideal function is strictly monotone. (Contributed by Stefan O'Rear, 1-Apr-2015.)
theorem hbtlem5 {x3: setvar} (ph: wff x3) (P R: class x3) (S: class) (U: class x3) (I J: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq U (cfv P clidl) $ >
  $ wceq S (cfv R cldgis) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel I U) $ >
  $ wi ph (wcel J U) $ >
  $ wi ph (wss I J) $ >
  $ wi ph (wral x3 (wss (cfv (cv x3) (cfv J S)) (cfv (cv x3) (cfv I S))) cn0) $ >
  $ wi ph (wceq I J) $;

--| There is a finite set of polynomials matching any single stage of the image. (Contributed by Stefan O'Rear, 1-Apr-2015.)
theorem hbtlem6 {k: setvar} (ph: wff) (P: class k) (R S: class) (U: class k) (I: class) (N: class k) (X: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq U (cfv P clidl) $ >
  $ wceq S (cfv R cldgis) $ >
  $ wceq N (cfv P crsp) $ >
  $ wi ph (wcel R clnr) $ >
  $ wi ph (wcel I U) $ >
  $ wi ph (wcel X cn0) $ >
  $ wi ph (wrex k (wss (cfv X (cfv I S)) (cfv X (cfv (cfv (cv k) N) S))) (cin (cpw I) cfn)) $;

--| The Hilbert Basis Theorem - the ring of univariate polynomials over a Noetherian ring is a Noetherian ring. (Contributed by Stefan O'Rear, 4-Apr-2015.)
theorem hbt (P R: class):
  $ wceq P (cfv R cpl1) $ >
  $ wi (wcel R clnr) (wcel P clnr) $;

--| Extend class notation with the class of monic polynomials.
term cmnc: class;

--| Extend class notation with the class of limited-degree polynomials.
term cplylt: class;

--| Define the class of monic polynomials. (Contributed by Stefan O'Rear, 5-Dec-2014.)
axiom df_mnc {s1 p: setvar}:
  $ wceq cmnc (cmpt s1 (cpw cc) (crab p (wceq (cfv (cfv (cv p) cdgr) (cfv (cv p) ccoe)) c1) (cfv (cv s1) cply))) $;

--| Define the class of limited-degree polynomials. (Contributed by Stefan O'Rear, 8-Dec-2014.)
axiom df_plylt {x3 s1 p: setvar}:
  $ wceq cplylt (cmpo s1 x3 (cpw cc) cn0 (crab p (wo (wceq (cv p) c0p) (wbr (cfv (cv p) cdgr) (cv x3) clt)) (cfv (cv s1) cply))) $;

--| Subtracting two polynomials with the same degree and top coefficient gives a polynomial of strictly lower degree. (Contributed by Stefan O'Rear, 25-Nov-2014.)
theorem dgrsub2 (S T F G N: class):
  $ wceq N (cfv F cdgr) $ >
  $ wi (wa (wa (wcel F (cfv S cply)) (wcel G (cfv T cply))) (w3a (wceq (cfv G cdgr) N) (wcel N cn) (wceq (cfv N (cfv F ccoe)) (cfv N (cfv G ccoe))))) (wbr (cfv (co F G (cof cmin)) cdgr) N clt) $;

--| Property of a monic polynomial. (Contributed by Stefan O'Rear, 5-Dec-2014.)
theorem elmnc (P S: class):
  $ wb (wcel P (cfv S cmnc)) (wa (wcel P (cfv S cply)) (wceq (cfv (cfv P cdgr) (cfv P ccoe)) c1)) $;

--| A monic polynomial is a polynomial. (Contributed by Stefan O'Rear, 5-Dec-2014.)
theorem mncply (P S: class):
  $ wi (wcel P (cfv S cmnc)) (wcel P (cfv S cply)) $;

--| A monic polynomial has leading coefficient 1. (Contributed by Stefan O'Rear, 5-Dec-2014.)
theorem mnccoe (P S: class):
  $ wi (wcel P (cfv S cmnc)) (wceq (cfv (cfv P cdgr) (cfv P ccoe)) c1) $;

--| A monic polynomial is not zero. (Contributed by Stefan O'Rear, 5-Dec-2014.)
theorem mncn0 (P S: class):
  $ wi (wcel P (cfv S cmnc)) (wne P c0p) $;

--| Extend class notation to include the degree function for algebraic numbers.
term cdgraa: class;

--| Extend class notation to include the minimal polynomial for an algebraic number.
term cmpaa: class;

--| Define the degree of an algebraic number as the smallest degree of any nonzero polynomial which has said number as a root. (Contributed by Stefan O'Rear, 25-Nov-2014.) (Revised by AV, 29-Sep-2020.)
axiom df_dgraa {x3 p d: setvar}:
  $ wceq cdgraa (cmpt x3 caa (cinf (crab d (wrex p (wa (wceq (cfv (cv p) cdgr) (cv d)) (wceq (cfv (cv x3) (cv p)) cc0)) (cdif (cfv cq cply) (csn c0p))) cn) cr clt)) $;

--| Define the minimal polynomial of an algebraic number as the unique monic polynomial which achieves the minimum of ` degAA ` . (Contributed by Stefan O'Rear, 25-Nov-2014.)
axiom df_mpaa {x3 p: setvar}:
  $ wceq cmpaa (cmpt x3 caa (crio p (w3a (wceq (cfv (cv p) cdgr) (cfv (cv x3) cdgraa)) (wceq (cfv (cv x3) (cv p)) cc0) (wceq (cfv (cfv (cv x3) cdgraa) (cfv (cv p) ccoe)) c1)) (cfv cq cply))) $;

--| Value of the degree function on an algebraic number. (Contributed by Stefan O'Rear, 25-Nov-2014.) (Revised by AV, 29-Sep-2020.)
theorem dgraaval {p d: setvar} (A2: class):
  $ wi (wcel A2 caa) (wceq (cfv A2 cdgraa) (cinf (crab d (wrex p (wa (wceq (cfv (cv p) cdgr) (cv d)) (wceq (cfv A2 (cv p)) cc0)) (cdif (cfv cq cply) (csn c0p))) cn) cr clt)) $;

--| Properties of the degree of an algebraic number. (Contributed by Stefan O'Rear, 25-Nov-2014.) (Proof shortened by AV, 29-Sep-2020.)
theorem dgraalem {p: setvar} (A2: class):
  $ wi (wcel A2 caa) (wa (wcel (cfv A2 cdgraa) cn) (wrex p (wa (wceq (cfv (cv p) cdgr) (cfv A2 cdgraa)) (wceq (cfv A2 (cv p)) cc0)) (cdif (cfv cq cply) (csn c0p)))) $;

--| Closure of the degree function on algebraic numbers. (Contributed by Stefan O'Rear, 25-Nov-2014.)
theorem dgraacl (A2: class):
  $ wi (wcel A2 caa) (wcel (cfv A2 cdgraa) cn) $;

--| Degree function on algebraic numbers is a function. (Contributed by Stefan O'Rear, 25-Nov-2014.) (Proof shortened by AV, 29-Sep-2020.)
theorem dgraaf:
  $ wf caa cn cdgraa $;

--| Upper bound on degree of an algebraic number. (Contributed by Stefan O'Rear, 25-Nov-2014.) (Proof shortened by AV, 29-Sep-2020.)
theorem dgraaub (A2 P: class):
  $ wi (wa (wa (wcel P (cfv cq cply)) (wne P c0p)) (wa (wcel A2 cc) (wceq (cfv A2 P) cc0))) (wbr (cfv A2 cdgraa) (cfv P cdgr) cle) $;

--| A rational polynomial of degree less than an algebraic number cannot be zero at that number unless it is the zero polynomial. (Contributed by Stefan O'Rear, 25-Nov-2014.)
theorem dgraa0p (A2 P: class):
  $ wi (w3a (wcel A2 caa) (wcel P (cfv cq cply)) (wbr (cfv P cdgr) (cfv A2 cdgraa) clt)) (wb (wceq (cfv A2 P) cc0) (wceq P c0p)) $;

--| An algebraic number has exactly one monic polynomial of the least degree. (Contributed by Stefan O'Rear, 25-Nov-2014.)
theorem mpaaeu {p: setvar} (A2: class):
  $ wi (wcel A2 caa) (wreu p (w3a (wceq (cfv (cv p) cdgr) (cfv A2 cdgraa)) (wceq (cfv A2 (cv p)) cc0) (wceq (cfv (cfv A2 cdgraa) (cfv (cv p) ccoe)) c1)) (cfv cq cply)) $;

--| Value of the minimal polynomial of an algebraic number. (Contributed by Stefan O'Rear, 25-Nov-2014.)
theorem mpaaval {p: setvar} (A2: class):
  $ wi (wcel A2 caa) (wceq (cfv A2 cmpaa) (crio p (w3a (wceq (cfv (cv p) cdgr) (cfv A2 cdgraa)) (wceq (cfv A2 (cv p)) cc0) (wceq (cfv (cfv A2 cdgraa) (cfv (cv p) ccoe)) c1)) (cfv cq cply))) $;

--| Properties of the minimal polynomial of an algebraic number. (Contributed by Stefan O'Rear, 25-Nov-2014.)
theorem mpaalem (A2: class):
  $ wi (wcel A2 caa) (wa (wcel (cfv A2 cmpaa) (cfv cq cply)) (w3a (wceq (cfv (cfv A2 cmpaa) cdgr) (cfv A2 cdgraa)) (wceq (cfv A2 (cfv A2 cmpaa)) cc0) (wceq (cfv (cfv A2 cdgraa) (cfv (cfv A2 cmpaa) ccoe)) c1))) $;

--| Minimal polynomial is a polynomial. (Contributed by Stefan O'Rear, 25-Nov-2014.)
theorem mpaacl (A2: class):
  $ wi (wcel A2 caa) (wcel (cfv A2 cmpaa) (cfv cq cply)) $;

--| Minimal polynomial has degree the degree of the number. (Contributed by Stefan O'Rear, 25-Nov-2014.)
theorem mpaadgr (A2: class):
  $ wi (wcel A2 caa) (wceq (cfv (cfv A2 cmpaa) cdgr) (cfv A2 cdgraa)) $;

--| The minimal polynomial of an algebraic number has the number as a root. (Contributed by Stefan O'Rear, 25-Nov-2014.)
theorem mpaaroot (A2: class):
  $ wi (wcel A2 caa) (wceq (cfv A2 (cfv A2 cmpaa)) cc0) $;

--| Minimal polynomial is monic. (Contributed by Stefan O'Rear, 25-Nov-2014.)
theorem mpaamn (A2: class):
  $ wi (wcel A2 caa) (wceq (cfv (cfv A2 cdgraa) (cfv (cfv A2 cmpaa) ccoe)) c1) $;

--| Extend class notation with the integral-over predicate.
term citgo: class;

--| Extend class notation with the class of algebraic integers.
term cza: class;

--| A complex number is said to be integral over a subset if it is the root of a monic polynomial with coefficients from the subset. This definition is typically not used for fields but it works there, see ~ aaitgo . This definition could work for subsets of an arbitrary ring with a more general definition of polynomials. TODO: use ` Monic ` . (Contributed by Stefan O'Rear, 27-Nov-2014.)
axiom df_itgo {x3 s1 p: setvar}:
  $ wceq citgo (cmpt s1 (cpw cc) (crab x3 (wrex p (wa (wceq (cfv (cv x3) (cv p)) cc0) (wceq (cfv (cfv (cv p) cdgr) (cfv (cv p) ccoe)) c1)) (cfv (cv s1) cply)) cc)) $;

--| Define an algebraic integer as a complex number which is the root of a monic integer polynomial. (Contributed by Stefan O'Rear, 30-Nov-2014.)
axiom df_za:
  $ wceq cza (cfv cz citgo) $;

--| Value of the integral-over function. (Contributed by Stefan O'Rear, 27-Nov-2014.)
theorem itgoval {x3 p: setvar} (S: class):
  $ wi (wss S cc) (wceq (cfv S citgo) (crab x3 (wrex p (wa (wceq (cfv (cv x3) (cv p)) cc0) (wceq (cfv (cfv (cv p) cdgr) (cfv (cv p) ccoe)) c1)) (cfv S cply)) cc)) $;

--| The standard algebraic numbers ` AA ` are generated by ` IntgOver ` . (Contributed by Stefan O'Rear, 27-Nov-2014.)
theorem aaitgo:
  $ wceq caa (cfv cq citgo) $;

--| An integral element is integral over a subset. (Contributed by Stefan O'Rear, 27-Nov-2014.)
theorem itgoss (S T: class):
  $ wi (wa (wss S T) (wss T cc)) (wss (cfv S citgo) (cfv T citgo)) $;

--| All integral elements are complex numbers. (Contributed by Stefan O'Rear, 27-Nov-2014.)
theorem itgocn (S: class):
  $ wss (cfv S citgo) cc $;

--| Exponentiation is closed in number rings. (Contributed by Stefan O'Rear, 30-Nov-2014.)
theorem cnsrexpcl (ph: wff) (S X Y: class):
  $ wi ph (wcel S (cfv ccnfld csubrg)) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wcel Y cn0) $ >
  $ wi ph (wcel (co X Y cexp) S) $;

--| Finite sums are closed in number rings. (Contributed by Stefan O'Rear, 30-Nov-2014.)
theorem fsumcnsrcl {k: setvar} (ph: wff) (A2: class) (B2: class k) (S: class):
  $ wi ph (wcel S (cfv ccnfld csubrg)) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 S) $ >
  $ wi ph (wcel (csu k A2 B2) S) $;

--| Polynomials are closed in number rings. (Contributed by Stefan O'Rear, 30-Nov-2014.)
theorem cnsrplycl (ph: wff) (C P S X: class):
  $ wi ph (wcel S (cfv ccnfld csubrg)) $ >
  $ wi ph (wcel P (cfv C cply)) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wss C S) $ >
  $ wi ph (wcel (cfv X P) S) $;

--| The span of a subring is itself. (Contributed by Stefan O'Rear, 30-Nov-2014.)
theorem rgspnid (ph: wff) (A2 R S: class):
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel A2 (cfv R csubrg)) $ >
  $ wi ph (wceq S (cfv A2 (cfv R crgspn))) $ >
  $ wi ph (wceq S A2) $;

--| Adjoining one element to a ring results in a set of polynomial evaluations. (Contributed by Stefan O'Rear, 30-Nov-2014.)
theorem rngunsnply {p: setvar} (ph: wff) (B2: class) (S: class p) (V X: class):
  $ wi ph (wcel B2 (cfv ccnfld csubrg)) $ >
  $ wi ph (wcel X cc) $ >
  $ wi ph (wceq S (cfv (cun B2 (csn X)) (cfv ccnfld crgspn))) $ >
  $ wi ph (wb (wcel V S) (wrex p (wceq V (cfv X (cv p))) (cfv B2 cply))) $;

--| Finite linear combinations with an indicator function. (Contributed by Stefan O'Rear, 5-Dec-2014.)
theorem flcidc {i j: setvar} (ph: wff) (B2: class i) (S: class) (F: class j) (K: class):
  $ wi ph (wceq F (cmpt j S (cif (wceq (cv j) K) c1 cc0))) $ >
  $ wi ph (wcel S cfn) $ >
  $ wi ph (wcel K S) $ >
  $ wi (wa ph (wcel (cv i) S)) (wcel B2 cc) $ >
  $ wi ph (wceq (csu i S (co (cfv (cv i) F) B2 cmul)) (csb i K B2)) $;

--| Syntax for module endomorphism algebra.
term cmend: class;

--| Define the endomorphism algebra of a module. (Contributed by Stefan O'Rear, 2-Sep-2015.)
axiom df_mend {x3 y1 m b: setvar}:
  $ wceq cmend (cmpt m cvv (csb b (co (cv m) (cv m) clmhm) (cun (ctp (cop (cfv cnx cbs) (cv b)) (cop (cfv cnx cplusg) (cmpo x3 y1 (cv b) (cv b) (co (cv x3) (cv y1) (cof (cfv (cv m) cplusg))))) (cop (cfv cnx cmulr) (cmpo x3 y1 (cv b) (cv b) (ccom (cv x3) (cv y1))))) (cpr (cop (cfv cnx csca) (cfv (cv m) csca)) (cop (cfv cnx cvsca) (cmpo x3 y1 (cfv (cfv (cv m) csca) cbs) (cv b) (co (cxp (cfv (cv m) cbs) (csn (cv x3))) (cv y1) (cof (cfv (cv m) cvsca))))))))) $;

--| Lemma to shorten proofs of ~ algbase through ~ algvsca . (Contributed by Stefan O'Rear, 27-Nov-2014.) (Revised by Mario Carneiro, 29-Aug-2015.)
theorem algstr (A2 B2 c_pl S c_x c_xp: class):
  $ wceq A2 (cun (ctp (cop (cfv cnx cbs) B2) (cop (cfv cnx cplusg) c_pl) (cop (cfv cnx cmulr) c_xp)) (cpr (cop (cfv cnx csca) S) (cop (cfv cnx cvsca) c_x))) $ >
  $ wbr A2 (cop c1 c6) cstr $;

--| The base set of a constructed algebra. (Contributed by Stefan O'Rear, 27-Nov-2014.) (Revised by Mario Carneiro, 29-Aug-2015.)
theorem algbase (A2 B2 c_pl S c_x c_xp V: class):
  $ wceq A2 (cun (ctp (cop (cfv cnx cbs) B2) (cop (cfv cnx cplusg) c_pl) (cop (cfv cnx cmulr) c_xp)) (cpr (cop (cfv cnx csca) S) (cop (cfv cnx cvsca) c_x))) $ >
  $ wi (wcel B2 V) (wceq B2 (cfv A2 cbs)) $;

--| The additive operation of a constructed algebra. (Contributed by Stefan O'Rear, 27-Nov-2014.) (Revised by Mario Carneiro, 29-Aug-2015.)
theorem algaddg (A2 B2 c_pl S c_x c_xp V: class):
  $ wceq A2 (cun (ctp (cop (cfv cnx cbs) B2) (cop (cfv cnx cplusg) c_pl) (cop (cfv cnx cmulr) c_xp)) (cpr (cop (cfv cnx csca) S) (cop (cfv cnx cvsca) c_x))) $ >
  $ wi (wcel c_pl V) (wceq c_pl (cfv A2 cplusg)) $;

--| The multiplicative operation of a constructed algebra. (Contributed by Stefan O'Rear, 27-Nov-2014.) (Revised by Mario Carneiro, 29-Aug-2015.)
theorem algmulr (A2 B2 c_pl S c_x c_xp V: class):
  $ wceq A2 (cun (ctp (cop (cfv cnx cbs) B2) (cop (cfv cnx cplusg) c_pl) (cop (cfv cnx cmulr) c_xp)) (cpr (cop (cfv cnx csca) S) (cop (cfv cnx cvsca) c_x))) $ >
  $ wi (wcel c_xp V) (wceq c_xp (cfv A2 cmulr)) $;

--| The set of scalars of a constructed algebra. (Contributed by Stefan O'Rear, 27-Nov-2014.) (Revised by Mario Carneiro, 29-Aug-2015.)
theorem algsca (A2 B2 c_pl S c_x c_xp V: class):
  $ wceq A2 (cun (ctp (cop (cfv cnx cbs) B2) (cop (cfv cnx cplusg) c_pl) (cop (cfv cnx cmulr) c_xp)) (cpr (cop (cfv cnx csca) S) (cop (cfv cnx cvsca) c_x))) $ >
  $ wi (wcel S V) (wceq S (cfv A2 csca)) $;

--| The scalar product operation of a constructed algebra. (Contributed by Stefan O'Rear, 27-Nov-2014.) (Revised by Mario Carneiro, 29-Aug-2015.)
theorem algvsca (A2 B2 c_pl S c_x c_xp V: class):
  $ wceq A2 (cun (ctp (cop (cfv cnx cbs) B2) (cop (cfv cnx cplusg) c_pl) (cop (cfv cnx cmulr) c_xp)) (cpr (cop (cfv cnx csca) S) (cop (cfv cnx cvsca) c_x))) $ >
  $ wi (wcel c_x V) (wceq c_x (cfv A2 cvsca)) $;

--| Value of the module endomorphism algebra. (Contributed by Stefan O'Rear, 2-Sep-2015.)
theorem mendval {x3 y1: setvar} (B2: class) (c_pl S c_x c_xp: class x3 y1) (M: class) (X: class x3 y1):
  $ wceq B2 (co M M clmhm) $ >
  $ wceq c_pl (cmpo x3 y1 B2 B2 (co (cv x3) (cv y1) (cof (cfv M cplusg)))) $ >
  $ wceq c_xp (cmpo x3 y1 B2 B2 (ccom (cv x3) (cv y1))) $ >
  $ wceq S (cfv M csca) $ >
  $ wceq c_x (cmpo x3 y1 (cfv S cbs) B2 (co (cxp (cfv M cbs) (csn (cv x3))) (cv y1) (cof (cfv M cvsca)))) $ >
  $ wi (wcel M X) (wceq (cfv M cmend) (cun (ctp (cop (cfv cnx cbs) B2) (cop (cfv cnx cplusg) c_pl) (cop (cfv cnx cmulr) c_xp)) (cpr (cop (cfv cnx csca) S) (cop (cfv cnx cvsca) c_x)))) $;

--| Base set of the module endomorphism algebra. (Contributed by Stefan O'Rear, 2-Sep-2015.)
theorem mendbas (A2 M: class):
  $ wceq A2 (cfv M cmend) $ >
  $ wceq (co M M clmhm) (cfv A2 cbs) $;

--| Addition in the module endomorphism algebra. (Contributed by Stefan O'Rear, 2-Sep-2015.) (Proof shortened by AV, 31-Oct-2024.)
theorem mendplusgfval {x3 y1: setvar} (A2: class x3 y1) (B2 c_pl M: class):
  $ wceq A2 (cfv M cmend) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_pl (cfv M cplusg) $ >
  $ wceq (cfv A2 cplusg) (cmpo x3 y1 B2 B2 (co (cv x3) (cv y1) (cof c_pl))) $;

--| A specific addition in the module endomorphism algebra. (Contributed by Stefan O'Rear, 3-Sep-2015.)
theorem mendplusg (A2 B2 c_pl c_pb M X Y: class):
  $ wceq A2 (cfv M cmend) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_pl (cfv M cplusg) $ >
  $ wceq c_pb (cfv A2 cplusg) $ >
  $ wi (wa (wcel X B2) (wcel Y B2)) (wceq (co X Y c_pb) (co X Y (cof c_pl))) $;

--| Multiplication in the module endomorphism algebra. (Contributed by Stefan O'Rear, 2-Sep-2015.) (Proof shortened by AV, 31-Oct-2024.)
theorem mendmulrfval {x3 y1: setvar} (A2: class x3 y1) (B2 M: class):
  $ wceq A2 (cfv M cmend) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq (cfv A2 cmulr) (cmpo x3 y1 B2 B2 (ccom (cv x3) (cv y1))) $;

--| A specific multiplication in the module endormoprhism algebra. (Contributed by Stefan O'Rear, 3-Sep-2015.)
theorem mendmulr (A2 B2 c_x M X Y: class):
  $ wceq A2 (cfv M cmend) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_x (cfv A2 cmulr) $ >
  $ wi (wa (wcel X B2) (wcel Y B2)) (wceq (co X Y c_x) (ccom X Y)) $;

--| The module endomorphism algebra has the same scalars as the underlying module. (Contributed by Stefan O'Rear, 2-Sep-2015.) (Proof shortened by AV, 31-Oct-2024.)
theorem mendsca (A2 S M: class):
  $ wceq A2 (cfv M cmend) $ >
  $ wceq S (cfv M csca) $ >
  $ wceq S (cfv A2 csca) $;

--| Scalar multiplication in the module endomorphism algebra. (Contributed by Stefan O'Rear, 2-Sep-2015.) (Proof shortened by AV, 31-Oct-2024.)
theorem mendvscafval {x3 y1: setvar} (A2: class x3 y1) (B2: class) (S c_x E: class x3 y1) (K M: class):
  $ wceq A2 (cfv M cmend) $ >
  $ wceq c_x (cfv M cvsca) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq S (cfv M csca) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq E (cfv M cbs) $ >
  $ wceq (cfv A2 cvsca) (cmpo x3 y1 K B2 (co (cxp E (csn (cv x3))) (cv y1) (cof c_x))) $;

--| A specific scalar multiplication in the module endomorphism algebra. (Contributed by Stefan O'Rear, 3-Sep-2015.)
theorem mendvsca (A2 B2 S c_xb c_x E K M X Y: class):
  $ wceq A2 (cfv M cmend) $ >
  $ wceq c_x (cfv M cvsca) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq S (cfv M csca) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq E (cfv M cbs) $ >
  $ wceq c_xb (cfv A2 cvsca) $ >
  $ wi (wa (wcel X K) (wcel Y B2)) (wceq (co X Y c_xb) (co (cxp E (csn X)) Y (cof c_x))) $;

--| The module endomorphism algebra is a ring. (Contributed by Stefan O'Rear, 5-Sep-2015.)
theorem mendring (A2 M: class):
  $ wceq A2 (cfv M cmend) $ >
  $ wi (wcel M clmod) (wcel A2 crg) $;

--| The module endomorphism algebra is a left module. (Contributed by Mario Carneiro, 22-Sep-2015.)
theorem mendlmod (A2 S M: class):
  $ wceq A2 (cfv M cmend) $ >
  $ wceq S (cfv M csca) $ >
  $ wi (wa (wcel M clmod) (wcel S ccrg)) (wcel A2 clmod) $;

--| The module endomorphism algebra is an algebra. (Contributed by Mario Carneiro, 22-Sep-2015.)
theorem mendassa (A2 S M: class):
  $ wceq A2 (cfv M cmend) $ >
  $ wceq S (cfv M csca) $ >
  $ wi (wa (wcel M clmod) (wcel S ccrg)) (wcel A2 casa) $;

--| Limit on the number of ` N ` -th roots of unity in an integral domain. (Contributed by Stefan O'Rear, 12-Sep-2015.)
theorem idomodle {x3: setvar} (B2 R: class) (G: class x3) (N: class) (O: class x3):
  $ wceq G (co (cfv R cmgp) (cfv R cui) cress) $ >
  $ wceq B2 (cfv G cbs) $ >
  $ wceq O (cfv G cod) $ >
  $ wi (wa (wcel R cidom) (wcel N cn)) (wbr (cfv (crab x3 (wbr (cfv (cv x3) O) N cdvds) B2) chash) N cle) $;

--| Two finite sets of equal size have a union of the same size iff they were equal. (Contributed by Stefan O'Rear, 12-Sep-2015.)
theorem fiuneneq (A2 B2: class):
  $ wi (wa (wbr A2 B2 cen) (wcel A2 cfn)) (wb (wbr (cun A2 B2) A2 cen) (wceq A2 B2)) $;

--| The units of an integral domain have at most one subgroup of any single finite cardinality. (Contributed by Stefan O'Rear, 12-Sep-2015.) (Revised by NM, 17-Jun-2017.)
theorem idomsubgmo {y1: setvar} (R G N: class):
  $ wceq G (co (cfv R cmgp) (cfv R cui) cress) $ >
  $ wi (wa (wcel R cidom) (wcel N cn)) (wrmo y1 (wceq (cfv (cv y1) chash) N) (cfv G csubg)) $;

--| Any primitive ` N ` -th root of unity is a multiple of any other. (Contributed by Stefan O'Rear, 2-Nov-2015.)
theorem proot1mul (R G K N O X Y: class):
  $ wceq G (co (cfv R cmgp) (cfv R cui) cress) $ >
  $ wceq O (cfv G cod) $ >
  $ wceq K (cfv (cfv G csubg) cmrc) $ >
  $ wi (wa (wa (wcel R cidom) (wcel N cn)) (wa (wcel X (cima (ccnv O) (csn N))) (wcel Y (cima (ccnv O) (csn N))))) (wcel X (cfv (csn Y) K)) $;

--| If an integral domain has a primitive ` N ` -th root of unity, it has exactly ` ( phi `` N ) ` of them. (Contributed by Stefan O'Rear, 12-Sep-2015.)
theorem proot1hash (R G N O X: class):
  $ wceq G (co (cfv R cmgp) (cfv R cui) cress) $ >
  $ wceq O (cfv G cod) $ >
  $ wi (w3a (wcel R cidom) (wcel N cn) (wcel X (cima (ccnv O) (csn N)))) (wceq (cfv (cima (ccnv O) (csn N)) chash) (cfv N cphi)) $;

--| The complex field has primitive ` N ` -th roots of unity for all ` N ` . (Contributed by Stefan O'Rear, 12-Sep-2015.)
theorem proot1ex (G N O: class):
  $ wceq G (co (cfv ccnfld cmgp) (cdif cc (csn cc0)) cress) $ >
  $ wceq O (cfv G cod) $ >
  $ wi (wcel N cn) (wcel (co (cneg c1) (co c2 N cdiv) ccxp) (cima (ccnv O) (csn N))) $;

--| Syntax for the sequence of cyclotomic polynomials.
term ccytp: class;

--| The Nth _cyclotomic polynomial_ is the polynomial which has as its zeros precisely the primitive Nth roots of unity. (Contributed by Stefan O'Rear, 5-Sep-2015.)
axiom df_cytp {n r: setvar}:
  $ wceq ccytp (cmpt n cn (co (cfv (cfv ccnfld cpl1) cmgp) (cmpt r (cima (ccnv (cfv (co (cfv ccnfld cmgp) (cdif cc (csn cc0)) cress) cod)) (csn (cv n))) (co (cfv ccnfld cv1) (cfv (cv r) (cfv (cfv ccnfld cpl1) cascl)) (cfv (cfv ccnfld cpl1) csg))) cgsu)) $;

--| Monic polynomials are a multiplicative submonoid. (Contributed by Stefan O'Rear, 12-Sep-2015.)
theorem mon1psubm (P R U M: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq M (cfv R cmn1) $ >
  $ wceq U (cfv P cmgp) $ >
  $ wi (wcel R cnzr) (wcel M (cfv U csubmnd)) $;

--| Homomorphic property of the polynomial degree. (Contributed by Stefan O'Rear, 12-Sep-2015.)
theorem deg1mhm (B2 D P R N Y c_0: class):
  $ wceq D (cfv R cdg1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq c_0 (cfv P c0g) $ >
  $ wceq Y (co (cfv P cmgp) (cdif B2 (csn c_0)) cress) $ >
  $ wceq N (co ccnfld cn0 cress) $ >
  $ wi (wcel R cdomn) (wcel (cres D (cdif B2 (csn c_0))) (co Y N cmhm)) $;

--| Functionality of the cyclotomic polynomial sequence. (Contributed by Stefan O'Rear, 5-Sep-2015.)
theorem cytpfn:
  $ wfn ccytp cn $;

--| Substitutions for the Nth cyclotomic polynomial. (Contributed by Stefan O'Rear, 5-Sep-2015.)
theorem cytpval {r: setvar} (A2 P Q T c_mi: class r) (N: class) (O X: class r):
  $ wceq T (co (cfv ccnfld cmgp) (cdif cc (csn cc0)) cress) $ >
  $ wceq O (cfv T cod) $ >
  $ wceq P (cfv ccnfld cpl1) $ >
  $ wceq X (cfv ccnfld cv1) $ >
  $ wceq Q (cfv P cmgp) $ >
  $ wceq c_mi (cfv P csg) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wi (wcel N cn) (wceq (cfv N ccytp) (co Q (cmpt r (cima (ccnv O) (csn N)) (co X (cfv (cv r) A2) c_mi)) cgsu)) $;

--| Express a function as a subset of the Cartesian product. (Contributed by Stefan O'Rear, 25-Jan-2015.)
theorem fgraphopab {a b: setvar} (A2 B2 F: class):
  $ wi (wf A2 B2 F) (wceq F (copab a b (wa (wa (wcel (cv a) A2) (wcel (cv b) B2)) (wceq (cfv (cv a) F) (cv b))))) $;

--| Express a function as a subset of the Cartesian product. (Contributed by Stefan O'Rear, 25-Jan-2015.)
theorem fgraphxp {x3: setvar} (A2 B2 F: class):
  $ wi (wf A2 B2 F) (wceq F (crab x3 (wceq (cfv (cfv (cv x3) c1st) F) (cfv (cv x3) c2nd)) (cxp A2 B2))) $;

--| The graph of a continuous function into a Hausdorff space is closed. (Contributed by Stefan O'Rear, 25-Jan-2015.)
theorem hausgraph (F J K: class):
  $ wi (wa (wcel K cha) (wcel F (co J K ccn))) (wcel F (cfv (co J K ctx) ccld)) $;

--| The class of separable topologies.
term ctopsep: class;

--| The class of Lindel&ouml;f topologies.
term ctoplnd: class;

--| A topology is _separable_ iff it has a countable dense subset. (Contributed by Stefan O'Rear, 8-Jan-2015.)
axiom df_topsep {x3 j: setvar}:
  $ wceq ctopsep (crab j (wrex x3 (wa (wbr (cv x3) com cdom) (wceq (cfv (cv x3) (cfv (cv j) ccl)) (cuni (cv j)))) (cpw (cuni (cv j)))) ctop) $;

--| A topology is _Lindel&ouml;f_ iff every open cover has a countable subcover. (Contributed by Stefan O'Rear, 8-Jan-2015.)
axiom df_toplnd {x3 y1 z: setvar}:
  $ wceq ctoplnd (crab x3 (wral y1 (wi (wceq (cuni (cv x3)) (cuni (cv y1))) (wrex z (wa (wbr (cv z) com cdom) (wceq (cuni (cv x3)) (cuni (cv z)))) (cpw (cv x3)))) (cpw (cv x3))) ctop) $;

--| Deductive form of ~ r1sssuc . (Contributed by Noam Pasman, 19-Jan-2025.)
theorem r1sssucd (ph: wff) (A2: class):
  $ wi ph (wcel A2 con0) $ >
  $ wi ph (wss (cfv A2 cr1) (cfv (csuc A2) cr1)) $;

--| Split an open interval into two pieces at point B, Co-author TA. (Contributed by Jon Pennant, 8-Jun-2019.)
theorem iocunico (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cxr)) (wa (wbr A2 B2 clt) (wbr B2 C clt))) (wceq (cun (co A2 B2 cioc) (co B2 C cico)) (co A2 C cioo)) $;

--| The intersection of two sets that meet at a point is that point. (Contributed by Jon Pennant, 12-Jun-2019.)
theorem iocinico (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cxr)) (wa (wbr A2 B2 clt) (wbr B2 C clt))) (wceq (cin (co A2 B2 cioc) (co B2 C cico)) (csn B2)) $;

--| An open-below, closed-above real interval is measurable. (Contributed by Jon Pennant, 12-Jun-2019.)
theorem iocmbl (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cr)) (wcel (co A2 B2 cioc) (cdm cvol)) $;

--| A bounded, continuous function on an open bounded interval is integrable. The function must be bounded. For a counterexample, consider ` F = ( x e. ( 0 (,) 1 ) |-> ( 1 / x ) ) ` . See ~ cniccibl for closed bounded intervals. (Contributed by Jon Pennant, 31-May-2019.)
theorem cnioobibld {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1) (F: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel F (co (co A2 B2 cioo) cc ccncf)) $ >
  $ wi ph (wrex x3 (wral y1 (wbr (cfv (cfv (cv y1) F) cabs) (cv x3) cle) (cdm F)) cr) $ >
  $ wi ph (wcel F cibl) $;

--| The area of a rectangle whose sides are parallel to the coordinate axes in ` ( RR X. RR ) ` is its width multiplied by its height. (Contributed by Jon Pennant, 19-Mar-2019.)
theorem arearect (A2 B2 C D S: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wcel C cr $ >
  $ wcel D cr $ >
  $ wbr A2 B2 cle $ >
  $ wbr C D cle $ >
  $ wceq S (cxp (co A2 B2 cicc) (co C D cicc)) $ >
  $ wceq (cfv S carea) (co (co B2 A2 cmin) (co D C cmin) cmul) $;

--| The area of a quadrilateral with two sides which are parallel to the y-axis in ` ( RR X. RR ) ` is its width multiplied by the average height of its higher edge minus the average height of its lower edge. Co-author TA. (Contributed by Jon Pennant, 31-May-2019.)
theorem areaquad {x3 y1: setvar} (A2 B2: class) (C D S: class y1) (U: class x3) (E F: class y1) (V: class x3):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wcel C cr $ >
  $ wcel D cr $ >
  $ wcel E cr $ >
  $ wcel F cr $ >
  $ wbr A2 B2 clt $ >
  $ wbr C E cle $ >
  $ wbr D F cle $ >
  $ wceq U (co C (co (co (co (cv x3) A2 cmin) (co B2 A2 cmin) cdiv) (co D C cmin) cmul) caddc) $ >
  $ wceq V (co E (co (co (co (cv x3) A2 cmin) (co B2 A2 cmin) cdiv) (co F E cmin) cmul) caddc) $ >
  $ wceq S (copab x3 y1 (wa (wcel (cv x3) (co A2 B2 cicc)) (wcel (cv y1) (co U V cicc)))) $ >
  $ wceq (cfv S carea) (co (co (co (co F E caddc) c2 cdiv) (co (co D C caddc) c2 cdiv) cmin) (co B2 A2 cmin) cmul) $;

--| Two ways to say a union is an element of a class. (Contributed by RP, 27-Jan-2025.)
theorem uniel {x3 y1 z: setvar} (A2: class) (B2: class y1 z):
  $ wb (wcel (cuni A2) B2) (wrex x3 (wal z (wb (wcel (cv z) (cv x3)) (wrex y1 (wcel (cv z) (cv y1)) A2))) B2) $;

--| Two ways to say the union of a class is an element of a subclass. (Contributed by RP, 29-Jan-2025.)
theorem unielss {x3 y1: setvar} (A2 B2: class):
  $ wi (wss A2 B2) (wb (wcel (cuni B2) A2) (wrex x3 (wral y1 (wss (cv y1) (cv x3)) B2) A2)) $;

--| Two ways to say the union of a class is an element of that class. (Contributed by RP, 27-Jan-2025.)
theorem unielid {x3 y1: setvar} (A2: class):
  $ wb (wcel (cuni A2) A2) (wrex x3 (wral y1 (wss (cv y1) (cv x3)) A2) A2) $;

--| Two ways to say a class is a subclass of a union. (Contributed by RP, 27-Jan-2025.)
theorem ssunib {x3 y1: setvar} (A2: class y1) (B2: class):
  $ wb (wss A2 (cuni B2)) (wral x3 (wrex y1 (wcel (cv x3) (cv y1)) B2) A2) $;

--| Equality theorem for supremum of sets of ordinals. (Contributed by RP, 23-Jan-2025.)
theorem rp_intrabeq {x3 y1: setvar} (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (cint (crab x3 (wral y1 (wss (cv y1) (cv x3)) A2) con0)) (cint (crab x3 (wral y1 (wss (cv y1) (cv x3)) B2) con0))) $;

--| Equality theorem for infimum of non-empty classes of ordinals. (Contributed by RP, 23-Jan-2025.)
theorem rp_unirabeq {x3 y1: setvar} (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (cuni (crab x3 (wral y1 (wss (cv x3) (cv y1)) A2) con0)) (cuni (crab x3 (wral y1 (wss (cv x3) (cv y1)) B2) con0))) $;

--| Two ways to say the maximum element of a class of ordinals is also the supremum of that class. (Contributed by RP, 27-Jan-2025.)
theorem onmaxnelsup {x3 y1: setvar} (A2: class):
  $ wi (wss A2 con0) (wb (wn (wss A2 (cuni A2))) (wrex x3 (wral y1 (wss (cv y1) (cv x3)) A2) A2)) $;

--| If the supremum of a class of ordinals is not in that class, then the supremum is a limit ordinal or empty. (Contributed by RP, 27-Jan-2025.)
theorem onsupneqmaxlim0 (A2: class):
  $ wi (wss A2 con0) (wi (wss A2 (cuni A2)) (wceq (cuni A2) (cuni (cuni A2)))) $;

--| The supremum of a set of ordinals is an ordinal. (Contributed by RP, 23-Jan-2025.)
theorem onsupcl2 (A2: class):
  $ wi (wcel A2 (cpw con0)) (wcel (cuni A2) con0) $;

--| The union of a set of ordinals is the intersection of every ordinal greater-than-or-equal to every member of the set. Closed form of ~ uniordint . (Contributed by RP, 28-Jan-2025.)
theorem onuniintrab {x3 y1: setvar} (A2: class) (V: class x3 y1):
  $ wi (wa (wss A2 con0) (wcel A2 V)) (wceq (cuni A2) (cint (crab x3 (wral y1 (wss (cv y1) (cv x3)) A2) con0))) $;

--| The intersection of a non-empty class of ordinals is the union of every ordinal less-than-or-equal to every element of that class. (Contributed by RP, 29-Jan-2025.)
theorem onintunirab {x3 y1: setvar} (A2: class):
  $ wi (wa (wss A2 con0) (wne A2 c0)) (wceq (cint A2) (cuni (crab x3 (wral y1 (wss (cv x3) (cv y1)) A2) con0))) $;

--| If the union of a class of ordinals is not the maximum element of that class, then the union is a limit ordinal or empty. But this isn't a biconditional since ` A ` could be a non-empty set where a limit ordinal or the empty set happens to be the largest element. (Contributed by RP, 27-Jan-2025.)
theorem onsupnmax (A2: class):
  $ wi (wss A2 con0) (wi (wn (wcel (cuni A2) A2)) (wceq (cuni A2) (cuni (cuni A2)))) $;

--| The supremum of a set of ordinals is the union of that set. Lemma 2.10 of [Schloeder] p. 5. (Contributed by RP, 19-Jan-2025.)
theorem onsupuni (A2 V: class):
  $ wi (wa (wss A2 con0) (wcel A2 V)) (wceq (csup A2 con0 cep) (cuni A2)) $;

--| The supremum of a set of ordinals is the union of that set. (Contributed by RP, 22-Jan-2025.)
theorem onsupuni2 (A2: class):
  $ wi (wcel A2 (cpw con0)) (wceq (csup A2 con0 cep) (cuni A2)) $;

--| The supremum of a set of ordinals is the intersection of every ordinal greater-than-or-equal to every member of the set. Definition 2.9 of [Schloeder] p. 5. (Contributed by RP, 23-Jan-2025.)
theorem onsupintrab {x3 y1: setvar} (A2: class) (V: class y1):
  $ wi (wa (wss A2 con0) (wcel A2 V)) (wceq (csup A2 con0 cep) (cint (crab x3 (wral y1 (wss (cv y1) (cv x3)) A2) con0))) $;

--| The supremum of a set of ordinals is the intersection of every ordinal greater-than-or-equal to every member of the set. (Contributed by RP, 23-Jan-2025.)
theorem onsupintrab2 {x3 y1: setvar} (A2: class):
  $ wi (wcel A2 (cpw con0)) (wceq (csup A2 con0 cep) (cint (crab x3 (wral y1 (wss (cv y1) (cv x3)) A2) con0))) $;

--| The supremum of a set of ordinals is an ordinal. (Contributed by RP, 23-Jan-2025.)
theorem onsupcl3 {x3 y1: setvar} (A2: class) (V: class y1):
  $ wi (wa (wss A2 con0) (wcel A2 V)) (wcel (cint (crab x3 (wral y1 (wss (cv y1) (cv x3)) A2) con0)) con0) $;

--| The supremum of a set of ordinals exists. (Contributed by RP, 23-Jan-2025.)
theorem onsupex3 {x3 y1: setvar} (A2: class) (V: class y1):
  $ wi (wa (wss A2 con0) (wcel A2 V)) (wcel (cint (crab x3 (wral y1 (wss (cv y1) (cv x3)) A2) con0)) cvv) $;

--| The union of a set of ordinals is the intersection of every ordinal greater-than-or-equal to every member of the set. (Contributed by RP, 23-Jan-2025.)
theorem onuniintrab2 {x3 y1: setvar} (A2: class):
  $ wi (wcel A2 (cpw con0)) (wceq (cuni A2) (cint (crab x3 (wral y1 (wss (cv y1) (cv x3)) A2) con0))) $;

--| The infimum of a non-empty class of ordinals is the intersection of that class. (Contributed by RP, 23-Jan-2025.)
theorem oninfint (A2: class):
  $ wi (wa (wss A2 con0) (wne A2 c0)) (wceq (cinf A2 con0 cep) (cint A2)) $;

--| The infimum of a non-empty class of ordinals is the union of every ordinal less-than-or-equal to every element of that class. (Contributed by RP, 23-Jan-2025.)
theorem oninfunirab {x3 y1: setvar} (A2: class):
  $ wi (wa (wss A2 con0) (wne A2 c0)) (wceq (cinf A2 con0 cep) (cuni (crab x3 (wral y1 (wss (cv x3) (cv y1)) A2) con0))) $;

--| The infimum of a non-empty class of ordinals is an ordinal. (Contributed by RP, 23-Jan-2025.)
theorem oninfcl2 {x3 y1: setvar} (A2: class):
  $ wi (wa (wss A2 con0) (wne A2 c0)) (wcel (cuni (crab x3 (wral y1 (wss (cv x3) (cv y1)) A2) con0)) con0) $;

--| The union of a class of ordinals is an element is an element of that class if and only if there is a maximum element of that class under the epsilon relation, which is to say that the domain of the restricted epsilon relation is not the whole class. (Contributed by RP, 25-Jan-2025.)
theorem onsupmaxb (A2: class):
  $ wi (wss A2 con0) (wb (wceq (cdm (cin cep (cxp A2 A2))) A2) (wn (wcel (cuni A2) A2))) $;

--| For any ordinal, there is always a larger ordinal. (Contributed by RP, 1-Feb-2025.)
theorem onexgt {x3: setvar} (A2: class):
  $ wi (wcel A2 con0) (wrex x3 (wcel A2 (cv x3)) con0) $;

--| For any ordinal, there is always a larger product of omega. (Contributed by RP, 1-Feb-2025.)
theorem onexomgt {x3: setvar} (A2: class):
  $ wi (wcel A2 con0) (wrex x3 (wcel A2 (co com (cv x3) comu)) con0) $;

--| The product of a limit ordinal with any nonzero ordinal is a limit ordinal. (Contributed by RP, 8-Jan-2025.)
theorem omlimcl2 (A2 B2 C: class):
  $ wi (wa (wa (wcel A2 con0) (wa (wcel B2 C) (wlim B2))) (wcel c0 A2)) (wlim (co B2 A2 comu)) $;

--| For any ordinal, there is always a larger limit ordinal. (Contributed by RP, 1-Feb-2025.)
theorem onexlimgt {x3: setvar} (A2: class):
  $ wi (wcel A2 con0) (wrex x3 (wa (wlim (cv x3)) (wcel A2 (cv x3))) con0) $;

--| For any ordinal, there is always a larger power of omega. (Contributed by RP, 1-Feb-2025.)
theorem onexoegt {x3: setvar} (A2: class):
  $ wi (wcel A2 con0) (wrex x3 (wcel A2 (co com (cv x3) coe)) con0) $;

--| The infimum of a non-empty class of ordinals exists. (Contributed by RP, 23-Jan-2025.)
theorem oninfex2 {x3 y1: setvar} (A2: class):
  $ wi (wa (wss A2 con0) (wne A2 c0)) (wcel (cuni (crab x3 (wral y1 (wss (cv x3) (cv y1)) A2) con0)) cvv) $;

--| Condition when the supremum of a set of ordinals is the maximum element of that set. (Contributed by RP, 24-Jan-2025.)
theorem onsupeqmax {x3 y1: setvar} (A2 V: class):
  $ wi (wa (wss A2 con0) (wcel A2 V)) (wb (wrex x3 (wral y1 (wss (cv y1) (cv x3)) A2) A2) (wcel (cuni A2) A2)) $;

--| Condition when the supremum of a class of ordinals is not the maximum element of that class. (Contributed by RP, 27-Jan-2025.)
theorem onsupeqnmax {x3 y1: setvar} (A2: class):
  $ wi (wss A2 con0) (wb (wral x3 (wrex y1 (wcel (cv x3) (cv y1)) A2) A2) (wa (wceq (cuni A2) (cuni (cuni A2))) (wn (wcel (cuni A2) A2)))) $;

--| The supremum of a set of ordinals is the least upper bound. (Contributed by RP, 27-Jan-2025.)
theorem onsuplub {z: setvar} (A2 B2: class) (V: class z):
  $ wi (wa (wa (wss A2 con0) (wcel A2 V)) (wcel B2 con0)) (wb (wcel B2 (cuni A2)) (wrex z (wcel B2 (cv z)) A2)) $;

--| An upper bound of a set of ordinals is not less than the supremum. (Contributed by RP, 27-Jan-2025.)
theorem onsupnub {z: setvar} (A2 B2: class) (V: class z):
  $ wi (wa (wa (wss A2 con0) (wcel A2 V)) (wa (wcel B2 con0) (wral z (wss (cv z) B2) A2))) (wss (cuni A2) B2) $;

--| Sufficient condition when the supremum of a set of ordinals is the maximum element of that set. See ~ ordunifi . (Contributed by RP, 27-Jan-2025.)
theorem onfisupcl (A2 V: class):
  $ wi (wa (wss A2 con0) (wcel A2 V)) (wi (wa (wcel A2 cfn) (wne A2 c0)) (wcel (cuni A2) A2)) $;

--| Every element of a ordinal is an ordinal. Lemma 1.3 of [Schloeder] p. 1. Based on ~ onelon and ~ eloni . (Contributed by RP, 15-Jan-2025.)
theorem onelord (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 A2)) (word B2) $;

--| Every ordinal is less than its successor, relationship version. Lemma 1.7 of [Schloeder] p. 1. (Contributed by RP, 15-Jan-2025.)
theorem onepsuc (A2: class):
  $ wi (wcel A2 con0) (wbr A2 (csuc A2) cep) $;

--| The ordinals are strictly and completely (linearly) ordered. Theorem 1.9 of [Schloeder] p. 1. Based on ~ epweon and ~ weso . (Contributed by RP, 15-Jan-2025.)
theorem epsoon:
  $ wor con0 cep $;

--| The strict order on the ordinals is irreflexive. Theorem 1.9(i) of [Schloeder] p. 1. (Contributed by RP, 15-Jan-2025.)
theorem epirron (A2: class):
  $ wi (wcel A2 con0) (wn (wbr A2 A2 cep)) $;

--| The strict order on the ordinals is transitive. Theorem 1.9(ii) of [Schloeder] p. 1. (Contributed by RP, 15-Jan-2025.)
theorem oneptr (A2 B2 C: class):
  $ wi (w3a (wcel A2 con0) (wcel B2 con0) (wcel C con0)) (wi (wa (wbr A2 B2 cep) (wbr B2 C cep)) (wbr A2 C cep)) $;

--| The elementhood relation on the ordinals is transitive. Theorem 1.9(ii) of [Schloeder] p. 1. See ~ ontr1 . (Contributed by RP, 15-Jan-2025.)
theorem oneltr (A2 B2 C: class):
  $ wi (w3a (wcel A2 con0) (wcel B2 con0) (wcel C con0)) (wi (wa (wcel A2 B2) (wcel B2 C)) (wcel A2 C)) $;

--| The strict, complete (linear) order on the ordinals is complete. Theorem 1.9(iii) of [Schloeder] p. 1. (Contributed by RP, 15-Jan-2025.)
theorem oneptri (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (w3o (wbr A2 B2 cep) (wbr B2 A2 cep) (wceq A2 B2)) $;

--| Membership in the difference of ordinals. (Contributed by RP, 15-Jan-2025.)
theorem ordeldif (A2 B2 C: class):
  $ wi (wa (word A2) (word B2)) (wb (wcel C (cdif A2 B2)) (wa (wcel C A2) (wss B2 C))) $;

--| Membership in the difference of ordinal and successor ordinal. (Contributed by RP, 16-Jan-2025.)
theorem ordeldifsucon (A2 B2 C: class):
  $ wi (wa (word A2) (wcel B2 con0)) (wb (wcel C (cdif A2 (csuc B2))) (wa (wcel C A2) (wcel B2 C))) $;

--| Membership in the difference of ordinal and ordinal one. (Contributed by RP, 16-Jan-2025.)
theorem ordeldif1o (A2 B2: class):
  $ wi (word A2) (wb (wcel B2 (cdif A2 c1o)) (wa (wcel B2 A2) (wne B2 c0))) $;

--| Ordinal zero is less than every nonzero ordinal. Theorem 1.10 of [Schloeder] p. 2. Closely related to ~ ord0eln0 . (Contributed by RP, 16-Jan-2025.)
theorem ordne0gt0 (A2: class):
  $ wi (wa (word A2) (wne A2 c0)) (wcel c0 A2) $;

--| Ordinal zero is less than every nonzero ordinal, class difference version. Theorem 1.10 of [Schloeder] p. 2. See ~ ondif1 . (Contributed by RP, 16-Jan-2025.)
theorem ondif1i (A2: class):
  $ wi (wcel A2 (cdif con0 c1o)) (wcel c0 A2) $;

--| The successor of every ordinal is an element of the class of successor ordinals. Definition 1.11 of [Schloeder] p. 2. (Contributed by RP, 16-Jan-2025.)
theorem onsucelab {a b: setvar} (A2: class):
  $ wi (wcel A2 con0) (wcel (csuc A2) (crab a (wrex b (wceq (cv a) (csuc (cv b))) con0) con0)) $;

--| A limit ordinal is a nonzero ordinal which is not a successor ordinal. Definition 1.11 of [Schloeder] p. 2. (Contributed by RP, 16-Jan-2025.)
theorem dflim6 {b: setvar} (A2: class):
  $ wb (wlim A2) (w3a (word A2) (wne A2 c0) (wn (wrex b (wceq A2 (csuc (cv b))) con0))) $;

--| A limit ordinal is not an element of the class of successor ordinals. Definition 1.11 of [Schloeder] p. 2. (Contributed by RP, 16-Jan-2025.)
theorem limnsuc {a b: setvar} (A2: class):
  $ wi (wlim A2) (wn (wcel A2 (crab a (wrex b (wceq (cv a) (csuc (cv b))) con0) con0))) $;

--| If one ordinal is less than another, then the successor of the first is less than or equal to the second. Lemma 1.13 of [Schloeder] p. 2. See ~ ordsucss . (Contributed by RP, 16-Jan-2025.)
theorem onsucss (A2 B2: class):
  $ wi (wcel A2 con0) (wi (wcel B2 A2) (wss (csuc B2) A2)) $;

--| For any distinct pair of ordinals, if there is no ordinal between the lesser and the greater, the greater is the successor of the lesser. Lemma 1.16 of [Schloeder] p. 2. (Contributed by RP, 16-Jan-2025.)
theorem ordnexbtwnsuc {c: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 B2) (word B2)) (wi (wral c (wn (wa (wcel A2 (cv c)) (wcel (cv c) B2))) con0) (wceq B2 (csuc A2))) $;

--| For any distinct pair of ordinals, if the set difference between the greater and the successor of the lesser is empty, the greater is the successor of the lesser. Lemma 1.16 of [Schloeder] p. 2. (Contributed by RP, 17-Jan-2025.)
theorem orddif0suc (A2 B2: class):
  $ wi (wa (wcel A2 B2) (word B2)) (wi (wceq (cdif B2 (csuc A2)) c0) (wceq B2 (csuc A2))) $;

--| For ordinals, the successor operation is injective, so there is at most one ordinal that a given ordinal could be the successor of. Lemma 1.17 of [Schloeder] p. 2. (Contributed by RP, 18-Jan-2025.)
theorem onsucf1lem {b: setvar} (A2: class):
  $ wi (wcel A2 con0) (wrmo b (wceq A2 (csuc (cv b))) con0) $;

--| The successor operation is bijective between the ordinals and the class of successor ordinals. Lemma 1.17 of [Schloeder] p. 2. (Contributed by RP, 18-Jan-2025.)
theorem onsucf1olem {b: setvar} (A2: class):
  $ wi (w3a (wcel A2 con0) (wne A2 c0) (wn (wlim A2))) (wreu b (wceq A2 (csuc (cv b))) con0) $;

--| The successor operation is surjective onto its range, the class of successor ordinals. Lemma 1.17 of [Schloeder] p. 2. (Contributed by RP, 18-Jan-2025.)
theorem onsucrn {x3 a b: setvar} (F: class x3 a b):
  $ wceq F (cmpt x3 con0 (csuc (cv x3))) $ >
  $ wceq (crn F) (crab a (wrex b (wceq (cv a) (csuc (cv b))) con0) con0) $;

--| The successor operation is a bijective function between the ordinals and the class of successor ordinals. Lemma 1.17 of [Schloeder] p. 2. (Contributed by RP, 18-Jan-2025.)
theorem onsucf1o {x3 a b: setvar} (F: class x3):
  $ wceq F (cmpt x3 con0 (csuc (cv x3))) $ >
  $ wf1o con0 (crab a (wrex b (wceq (cv a) (csuc (cv b))) con0) con0) F $;

--| A limit ordinal is a nonzero ordinal that contains all the successors of its elements. Lemma 1.18 of [Schloeder] p. 2. Closely related to ~ dflim4 . (Contributed by RP, 17-Jan-2025.)
theorem dflim7 {b: setvar} (A2: class):
  $ wb (wlim A2) (w3a (word A2) (wral b (wcel (csuc (cv b)) A2) A2) (wne A2 c0)) $;

--| Compactly express rules for binary operations on ordinals. (Contributed by RP, 18-Jan-2025.)
theorem onov0suclim (A2 B2 C D c_xo E F: class):
  $ wi (wcel A2 con0) (wceq (co A2 c0 c_xo) D) $ >
  $ wi (wa (wcel A2 con0) (wcel C con0)) (wceq (co A2 (csuc C) c_xo) E) $ >
  $ wi (wa (wa (wcel A2 con0) (wcel B2 con0)) (wlim B2)) (wceq (co A2 B2 c_xo) F) $ >
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (w3a (wi (wceq B2 c0) (wceq (co A2 B2 c_xo) D)) (wi (wa (wceq B2 (csuc C)) (wcel C con0)) (wceq (co A2 B2 c_xo) E)) (wi (wlim B2) (wceq (co A2 B2 c_xo) F))) $;

--| Closed form expression of the value of ordinal addition for the cases when the second ordinal is zero, a successor ordinal, or a limit ordinal. Definition 2.3 of [Schloeder] p. 4. See ~ oa0 , ~ oasuc , and ~ oalim . (Contributed by RP, 18-Jan-2025.)
theorem oa0suclim {c: setvar} (A2 B2: class) (C: class c):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (w3a (wi (wceq B2 c0) (wceq (co A2 B2 coa) A2)) (wi (wa (wceq B2 (csuc C)) (wcel C con0)) (wceq (co A2 B2 coa) (csuc (co A2 C coa)))) (wi (wlim B2) (wceq (co A2 B2 coa) (ciun c B2 (co A2 (cv c) coa))))) $;

--| Closed form expression of the value of ordinal multiplication for the cases when the second ordinal is zero, a successor ordinal, or a limit ordinal. Definition 2.5 of [Schloeder] p. 4. See ~ om0 , ~ omsuc , and ~ omlim . (Contributed by RP, 18-Jan-2025.)
theorem om0suclim {c: setvar} (A2 B2: class) (C: class c):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (w3a (wi (wceq B2 c0) (wceq (co A2 B2 comu) c0)) (wi (wa (wceq B2 (csuc C)) (wcel C con0)) (wceq (co A2 B2 comu) (co (co A2 C comu) A2 coa))) (wi (wlim B2) (wceq (co A2 B2 comu) (ciun c B2 (co A2 (cv c) comu))))) $;

--| Closed form expression of the value of ordinal exponentiation for the cases when the second ordinal is zero, a successor ordinal, or a limit ordinal. Definition 2.6 of [Schloeder] p. 4. See ~ oe0 , ~ oesuc , ~ oe0m1 , and ~ oelim . (Contributed by RP, 18-Jan-2025.)
theorem oe0suclim {c: setvar} (A2 B2: class) (C: class c):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (w3a (wi (wceq B2 c0) (wceq (co A2 B2 coe) c1o)) (wi (wa (wceq B2 (csuc C)) (wcel C con0)) (wceq (co A2 B2 coe) (co (co A2 C coe) A2 comu))) (wi (wlim B2) (wceq (co A2 B2 coe) (cif (wcel c0 A2) (ciun c B2 (co A2 (cv c) coe)) c0)))) $;

--| The operations of addition, multiplication, and exponentiation are closed. Remark 2.8 of [Schloeder] p. 5. See ~ oacl , ~ omcl , ~ oecl . (Contributed by RP, 18-Jan-2025.)
theorem oaomoecl (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (w3a (wcel (co A2 B2 coa) con0) (wcel (co A2 B2 comu) con0) (wcel (co A2 B2 coe) con0)) $;

--| If the union of a set of ordinals is a successor ordinal, then that union is the maximum element of the set. This is not a bijection because sets where the maximum element is zero or a limit ordinal exist. Lemma 2.11 of [Schloeder] p. 5. (Contributed by RP, 27-Jan-2025.)
theorem onsupsucismax {b: setvar} (A2: class) (V: class b):
  $ wi (wa (wss A2 con0) (wcel A2 V)) (wi (wrex b (wceq (cuni A2) (csuc (cv b))) con0) (wcel (cuni A2) A2)) $;

--| If for every element of a set of ordinals there is an element of a subset which is at least as large, then the union of the set and the subset is the same. Lemma 2.12 of [Schloeder] p. 5. (Contributed by RP, 27-Jan-2025.)
theorem onsssupeqcond {a b: setvar} (A2: class b) (B2: class) (V: class a b):
  $ wi (wa (wss A2 con0) (wcel A2 V)) (wi (wa (wss B2 A2) (wral a (wrex b (wss (cv a) (cv b)) B2) A2)) (wceq (cuni A2) (cuni B2))) $;

--| An ordinal which is a limit ordinal is equal to its supremum. Lemma 2.13 of [Schloeder] p. 5. (Contributed by RP, 27-Jan-2025.)
theorem limexissup (A2 V: class):
  $ wi (wa (wlim A2) (wcel A2 V)) (wceq A2 (csup A2 con0 cep)) $;

--| A limit ordinal is the union of its elements, indexed union version. Lemma 2.13 of [Schloeder] p. 5. See ~ limuni . (Contributed by RP, 27-Jan-2025.)
theorem limiun {x3: setvar} (A2: class):
  $ wi (wlim A2) (wceq A2 (ciun x3 A2 (cv x3))) $;

--| An ordinal which is a limit ordinal is equal to the supremum of the class of all its elements. Lemma 2.13 of [Schloeder] p. 5. (Contributed by RP, 27-Jan-2025.)
theorem limexissupab {x3: setvar} (A2: class) (V: class x3):
  $ wi (wa (wlim A2) (wcel A2 V)) (wceq A2 (csup (cab x3 (wcel (cv x3) A2)) con0 cep)) $;

--| Ordinal one is both a left and right identity of ordinal multiplication. Lemma 2.15 of [Schloeder] p. 5. See ~ om1 and ~ om1r for individual statements. (Contributed by RP, 29-Jan-2025.)
theorem om1om1r (A2: class):
  $ wi (wcel A2 con0) (wa (wceq (co c1o A2 comu) (co A2 c1o comu)) (wceq (co A2 c1o comu) A2)) $;

--| Ordinal zero raised to any nonzero ordinal power is zero and zero to the zeroth power is one. Lemma 2.18 of [Schloeder] p. 6. (Contributed by RP, 29-Jan-2025.)
theorem oe0rif (A2: class):
  $ wi (wcel A2 con0) (wceq (co c0 A2 coe) (cif (wcel c0 A2) c0 c1o)) $;

--| While subtraction can't be a binary operation on ordinals, for any pair of ordinals there exists an ordinal that can be added to the lessor (or equal) one which will sum to the greater. Theorem 2.19 of [Schloeder] p. 6. (Contributed by RP, 29-Jan-2025.)
theorem oasubex {c: setvar} (A2 B2: class):
  $ wi (w3a (wcel A2 con0) (wcel B2 con0) (wss B2 A2)) (wrex c (wa (wss (cv c) A2) (wceq (co B2 (cv c) coa) A2)) con0) $;

--| Natural numbers are closed under ordinal addition, multiplication, and exponentiation. Theorem 2.20 of [Schloeder] p. 6. See ~ nnacl , ~ nnmcl , ~ nnecl . (Contributed by RP, 29-Jan-2025.)
theorem nnamecl (A2 B2: class):
  $ wi (wa (wcel A2 com) (wcel B2 com)) (w3a (wcel (co A2 B2 coa) com) (wcel (co A2 B2 comu) com) (wcel (co A2 B2 coe) com)) $;

--| The successor operation preserves the less-than-or-equal relationship between ordinals. Lemma 3.1 of [Schloeder] p. 7. (Contributed by RP, 29-Jan-2025.)
theorem onsucwordi (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wi (wss A2 B2) (wss (csuc A2) (csuc B2))) $;

--| The ordinal sum of any ordinal with a limit ordinal on the right is a limit ordinal. (Contributed by RP, 6-Feb-2025.)
theorem oalim2cl (A2 B2 V: class):
  $ wi (w3a (wcel A2 con0) (wlim B2) (wcel B2 V)) (wlim (co A2 B2 coa)) $;

--| Given ` C ` is a limit ordinal, the sum of any ordinal with an ordinal less than ` C ` is less than the sum of the first ordinal with ` C ` . Lemma 3.5 of [Schloeder] p. 7. (Contributed by RP, 29-Jan-2025.)
theorem oaltublim (A2 B2 C V: class):
  $ wi (w3a (wcel A2 con0) (wcel B2 C) (wa (wlim C) (wcel C V))) (wcel (co A2 B2 coa) (co A2 C coa)) $;

--| Ordinal addition of the same number on the left preserves the ordering of the numbers on the right. Lemma 3.6 of [Schloeder] p. 8. (Contributed by RP, 29-Jan-2025.)
theorem oaordi3 (A2 B2 C: class):
  $ wi (w3a (wcel A2 con0) (wcel B2 con0) (wcel C con0)) (wi (wcel B2 C) (wcel (co A2 B2 coa) (co A2 C coa))) $;

--| When the same ordinal is added on the left, ordering of the sums is equivalent to the ordering of the ordinals on the right. Theorem 3.7 of [Schloeder] p. 8. (Contributed by RP, 29-Jan-2025.)
theorem oaord3 (A2 B2 C: class):
  $ wi (w3a (wcel A2 con0) (wcel B2 con0) (wcel C con0)) (wb (wcel B2 C) (wcel (co A2 B2 coa) (co A2 C coa))) $;

--| Ordinal one plus omega is equal to omega. See ~ oaabs for the sum of any natural number on the left and ordinal at least as large as omega on the right. Lemma 3.8 of [Schloeder] p. 8. See ~ oaabs2 where a power of omega is the upper bound of the left and a lower bound on the right. (Contributed by RP, 29-Jan-2025.)
theorem _1oaomeqom:
  $ wceq (co c1o com coa) com $;

--| The right addend absorbs the sum with an ordinal iff that ordinal times omega is less than or equal to the right addend. (Contributed by RP, 19-Feb-2025.)
theorem oaabsb (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wb (wss (co A2 com comu) B2) (wceq (co A2 B2 coa) B2)) $;

--| When omega is added on the right to ordinals zero and one, ordering of the sums is not equivalent to the ordering of the ordinals on the left. Remark 3.9 of [Schloeder] p. 8. (Contributed by RP, 29-Jan-2025.)
theorem oaordnrex:
  $ wn (wb (wcel c0 c1o) (wcel (co c0 com coa) (co c1o com coa))) $;

--| When the same ordinal is added on the right, ordering of the sums is not equivalent to the ordering of the ordinals on the left. Remark 3.9 of [Schloeder] p. 8. (Contributed by RP, 29-Jan-2025.)
theorem oaordnr {a b c: setvar}:
  $ wrex a (wrex b (wrex c (wn (wb (wcel (cv a) (cv b)) (wcel (co (cv a) (cv c) coa) (co (cv b) (cv c) coa)))) con0) con0) con0 $;

--| Any nonzero ordinal product is greater-than-or-equal to the term on the left. Lemma 3.11 of [Schloeder] p. 8. See ~ omword1 . (Contributed by RP, 29-Jan-2025.)
theorem omge1 (A2 B2: class):
  $ wi (w3a (wcel A2 con0) (wcel B2 con0) (wne B2 c0)) (wss A2 (co A2 B2 comu)) $;

--| Any nonzero ordinal product is greater-than-or-equal to the term on the right. Lemma 3.12 of [Schloeder] p. 9. See ~ omword2 . (Contributed by RP, 29-Jan-2025.)
theorem omge2 (A2 B2: class):
  $ wi (w3a (wcel A2 con0) (wcel B2 con0) (wne A2 c0)) (wss B2 (co A2 B2 comu)) $;

--| The nonzero product with an limit ordinal on the right is a limit ordinal. Lemma 3.13 of [Schloeder] p. 9. (Contributed by RP, 29-Jan-2025.)
theorem omlim2 (A2 B2 V: class):
  $ wi (wa (wa (wcel A2 con0) (wne A2 c0)) (wa (wlim B2) (wcel B2 V))) (wlim (co A2 B2 comu)) $;

--| Given a limit ordinal, the product of any nonzero ordinal with an ordinal less than that limit ordinal is less than the product of the nonzero ordinal with the limit ordinal . Lemma 3.14 of [Schloeder] p. 9. (Contributed by RP, 29-Jan-2025.)
theorem omord2lim (A2 B2 C V: class):
  $ wi (wa (wa (wcel A2 con0) (wne A2 c0)) (wa (wlim C) (wcel C V))) (wi (wcel B2 C) (wcel (co A2 B2 comu) (co A2 C comu))) $;

--| Ordinal multiplication of the same nonzero number on the left preserves the ordering of the numbers on the right. Lemma 3.15 of [Schloeder] p. 9. (Contributed by RP, 29-Jan-2025.)
theorem omord2i (A2 B2 C: class):
  $ wi (wa (wa (wcel A2 con0) (wne A2 c0)) (wcel C con0)) (wi (wcel B2 C) (wcel (co A2 B2 comu) (co A2 C comu))) $;

--| When the same nonzero ordinal is multiplied on the left, ordering of the products is equivalent to the ordering of the ordinals on the right. Theorem 3.16 of [Schloeder] p. 9. (Contributed by RP, 29-Jan-2025.)
theorem omord2com (A2 B2 C: class):
  $ wi (w3a (wcel A2 con0) (wcel B2 con0) (wcel C con0)) (wb (wa (wcel B2 C) (wcel c0 A2)) (wcel (co A2 B2 comu) (co A2 C comu))) $;

--| Ordinal two times omega is omega. Lemma 3.17 of [Schloeder] p. 10. (Contributed by RP, 30-Jan-2025.)
theorem _2omomeqom:
  $ wceq (co c2o com comu) com $;

--| When omega is multiplied on the right to ordinals one and two, ordering of the products is not equivalent to the ordering of the ordinals on the left. Remark 3.18 of [Schloeder] p. 10. (Contributed by RP, 29-Jan-2025.)
theorem omnord1ex:
  $ wn (wb (wcel c1o c2o) (wcel (co c1o com comu) (co c2o com comu))) $;

--| When the same nonzero ordinal is multiplied on the right, ordering of the products is not equivalent to the ordering of the ordinals on the left. Remark 3.18 of [Schloeder] p. 10. (Contributed by RP, 4-Feb-2025.)
theorem omnord1 {a b c: setvar}:
  $ wrex a (wrex b (wrex c (wn (wb (wcel (cv a) (cv b)) (wcel (co (cv a) (cv c) comu) (co (cv b) (cv c) comu)))) (cdif con0 c1o)) con0) con0 $;

--| Any nonzero ordinal power is greater-than-or-equal to the term on the left. Lemma 3.19 of [Schloeder] p. 10. See ~ oewordi . (Contributed by RP, 29-Jan-2025.)
theorem oege1 (A2 B2: class):
  $ wi (w3a (wcel A2 con0) (wcel B2 con0) (wne B2 c0)) (wss A2 (co A2 B2 coe)) $;

--| Any power of an ordinal at least as large as two is greater-than-or-equal to the term on the right. Lemma 3.20 of [Schloeder] p. 10. See ~ oeworde . (Contributed by RP, 29-Jan-2025.)
theorem oege2 (A2 B2: class):
  $ wi (wa (wa (wcel A2 con0) (wcel c1o A2)) (wcel B2 con0)) (wss B2 (co A2 B2 coe)) $;

--| The power of an ordinal at least as large as two with a limit ordinal on thr right is a limit ordinal. Lemma 3.21 of [Schloeder] p. 10. See ~ oelimcl . (Contributed by RP, 30-Jan-2025.)
theorem rp_oelim2 (A2 B2 V: class):
  $ wi (wa (wa (wcel A2 con0) (wcel c1o A2)) (wa (wlim B2) (wcel B2 V))) (wlim (co A2 B2 coe)) $;

--| Given a limit ordinal, the power of any base at least as large as two raised to an ordinal less than that limit ordinal is less than the power of that base raised to the limit ordinal . Lemma 3.22 of [Schloeder] p. 10. See ~ oeordi . (Contributed by RP, 30-Jan-2025.)
theorem oeord2lim (A2 B2 C V: class):
  $ wi (wa (wa (wcel A2 con0) (wcel c1o A2)) (wa (wlim C) (wcel C V))) (wi (wcel B2 C) (wcel (co A2 B2 coe) (co A2 C coe))) $;

--| Ordinal exponentiation of the same base at least as large as two preserves the ordering of the exponents. Lemma 3.23 of [Schloeder] p. 11. (Contributed by RP, 30-Jan-2025.)
theorem oeord2i (A2 B2 C: class):
  $ wi (wa (wa (wcel A2 con0) (wcel c1o A2)) (wcel C con0)) (wi (wcel B2 C) (wcel (co A2 B2 coe) (co A2 C coe))) $;

--| When the same base at least as large as two is raised to ordinal powers, , ordering of the power is equivalent to the ordering of the exponents. Theorem 3.24 of [Schloeder] p. 11. (Contributed by RP, 30-Jan-2025.)
theorem oeord2com (A2 B2 C: class):
  $ wi (w3a (wa (wcel A2 con0) (wcel c1o A2)) (wcel B2 con0) (wcel C con0)) (wb (wcel B2 C) (wcel (co A2 B2 coe) (co A2 C coe))) $;

--| Any natural number at least as large as two raised to the power of omega is omega. Lemma 3.25 of [Schloeder] p. 11. (Contributed by RP, 30-Jan-2025.)
theorem nnoeomeqom (A2: class):
  $ wi (wa (wcel A2 com) (wcel c1o A2)) (wceq (co A2 com coe) com) $;

--| Ordinal 3 is the unordered triple containing ordinals 0, 1, and 2. (Contributed by RP, 8-Jul-2021.)
theorem df3o2:
  $ wceq c3o (ctp c0 c1o c2o) $;

--| Ordinal 3, fully expanded. (Contributed by RP, 8-Jul-2021.)
theorem df3o3:
  $ wceq c3o (ctp c0 (csn c0) (cpr c0 (csn c0))) $;

--| When ordinals two and three are both raised to the power of omega, ordering of the powers is not equivalent to the ordering of the bases. Remark 3.26 of [Schloeder] p. 11. (Contributed by RP, 30-Jan-2025.)
theorem oenord1ex:
  $ wn (wb (wcel c2o c3o) (wcel (co c2o com coe) (co c3o com coe))) $;

--| When two ordinals (both at least as large as two) are raised to the same power, ordering of the powers is not equivalent to the ordering of the bases. Remark 3.26 of [Schloeder] p. 11. (Contributed by RP, 4-Feb-2025.)
theorem oenord1 {a b c: setvar}:
  $ wrex a (wrex b (wrex c (wn (wb (wcel (cv a) (cv b)) (wcel (co (cv a) (cv c) coe) (co (cv b) (cv c) coe)))) (cdif con0 c1o)) (cdif con0 c2o)) (cdif con0 c2o) $;

--| Ordinal addition, multiplication, and exponentiation do not generally commute. Theorem 4.1 of [Schloeder] p. 11. (Contributed by RP, 30-Jan-2025.)
theorem oaomoencom {a b: setvar}:
  $ w3a (wrex a (wrex b (wn (wceq (co (cv a) (cv b) coa) (co (cv b) (cv a) coa))) con0) con0) (wrex a (wrex b (wn (wceq (co (cv a) (cv b) comu) (co (cv b) (cv a) comu))) con0) con0) (wrex a (wrex b (wn (wceq (co (cv a) (cv b) coe) (co (cv b) (cv a) coe))) con0) con0) $;

--| Ordinal two raised to two to the zeroth power is not the same as two squared then raised to the zeroth power. (Contributed by RP, 30-Jan-2025.)
theorem oenassex:
  $ wn (wceq (co c2o (co c2o c0 coe) coe) (co (co c2o c2o coe) c0 coe)) $;

--| Ordinal exponentiation is not associative. Remark 4.6 of [Schloeder] p. 14. (Contributed by RP, 30-Jan-2025.)
theorem oenass {a b c: setvar}:
  $ wrex a (wrex b (wrex c (wn (wceq (co (cv a) (co (cv b) (cv c) coe) coe) (co (co (cv a) (cv b) coe) (cv c) coe))) con0) con0) con0 $;

--| For terms of the form of a power of omega times a nonzero natural number, ordering of the exponents implies ordering of the terms. Lemma 5.1 of [Schloeder] p. 15. (Contributed by RP, 30-Jan-2025.)
theorem cantnftermord (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 con0) (wcel B2 con0)) (wa (wcel C (cdif com c1o)) (wcel D (cdif com c1o)))) (wi (wcel A2 B2) (wcel (co (co com A2 coe) C comu) (co (co com B2 coe) D comu))) $;

--| Given a finite number of terms of the form ` ( ( _om ^o ( A `` n ) ) .o ( M `` n ) ) ` with distinct exponents, we may order them from largest to smallest and find the sum is less than ` ( _om ^o X ) ` when ` ( A `` n ) ` is less than ` X ` and ` ( M `` n ) ` is less than ` _om ` . Lemma 5.2 of [Schloeder] p. 15. (Contributed by RP, 31-Jan-2025.)
theorem cantnfub {x3: setvar} (ph: wff) (A2: class) (F: class x3) (M: class) (N: class x3) (X: class):
  $ wi ph (wcel X con0) $ >
  $ wi ph (wcel N com) $ >
  $ wi ph (wf1 N X A2) $ >
  $ wi ph (wf N com M) $ >
  $ wceq F (cmpt x3 X (cif (wcel (cv x3) (crn A2)) (cfv (cfv (cv x3) (ccnv A2)) M) c0)) $ >
  $ wi ph (wa (wcel F (cdm (co com X ccnf))) (wcel (cfv F (co com X ccnf)) (co com X coe))) $;

--| Given a finite number of terms of the form ` ( ( _om ^o ( A `` n ) ) .o ( M `` n ) ) ` with distinct exponents, we may order them from largest to smallest and find the sum is less than ` ( _om ^o suc U. ran A ) ` when ` ( M `` n ) ` is less than ` _om ` . Lemma 5.2 of [Schloeder] p. 15. (Contributed by RP, 9-Feb-2025.)
theorem cantnfub2 {x3: setvar} (ph: wff) (A2: class) (F: class x3) (M: class) (N: class x3):
  $ wi ph (wcel N com) $ >
  $ wi ph (wf1 N con0 A2) $ >
  $ wi ph (wf N com M) $ >
  $ wceq F (cmpt x3 (csuc (cuni (crn A2))) (cif (wcel (cv x3) (crn A2)) (cfv (cfv (cv x3) (ccnv A2)) M) c0)) $ >
  $ wi ph (w3a (wcel (csuc (cuni (crn A2))) con0) (wcel F (cdm (co com (csuc (cuni (crn A2))) ccnf))) (wcel (cfv F (co com (csuc (cuni (crn A2))) ccnf)) (co com (csuc (cuni (crn A2))) coe))) $;

--| Equivalence for two classes related by an ordered-pair class abstraction. A generalization of ~ brslts . (Contributed by RP, 26-Sep-2024.)
theorem bropabg {x3 y1: setvar} (ph ps: wff x3 y1) (ch: wff) (A2 B2: class) (R: class x3 y1):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wceq R (copab x3 y1 ph) $ >
  $ wb (wbr A2 B2 R) (wa (wa (wcel A2 cvv) (wcel B2 cvv)) ch) $;

--| A Cantor normal form which sums to less than a certain power has only zeros for larger components. (Contributed by RP, 3-Feb-2025.)
theorem cantnfresb {x3: setvar} (A2 B2 C F: class):
  $ wi (wa (wa (wcel A2 (cdif con0 c2o)) (wcel B2 con0)) (wa (wcel C con0) (wcel F (cdm (co A2 B2 ccnf))))) (wb (wcel (cfv F (co A2 B2 ccnf)) (co A2 C coe)) (wral x3 (wceq (cfv (cv x3) F) c0) (cdif B2 C))) $;

--| For every ordinal, ` A ` , there is a an ordinal exponent ` b ` such that ` A ` is less than ` ( _om ^o b ) ` and for every ordinal at least as large as ` b ` there is a unique Cantor normal form, ` f ` , with zeros for all the unnecessary higher terms, that sums to ` A ` . Theorem 5.3 of [Schloeder] p. 16. (Contributed by RP, 3-Feb-2025.)
theorem cantnf2 {f2 b c: setvar} (A2: class):
  $ wi (wcel A2 con0) (wrex b (wral c (wreu f2 (wa (wa (wcel A2 (co com (cv b) coe)) (wbr (cv f2) c0 cfsupp)) (wa (wceq (cfv (cres (cv f2) (cv b)) (co com (cv b) ccnf)) A2) (wceq (cfv (cv f2) (co com (cv c) ccnf)) A2))) (cdm (co com (cv c) ccnf))) (cdif con0 (cv b))) con0) $;

--| If ` C ` is between ` A ` (inclusive) and ` ( A +o B ) ` (exclusive), there is an ordinal which equals ` C ` when summed to ` A ` . This is a slightly different statement than ~ oawordex or ~ oawordeu . (Contributed by RP, 7-Jan-2025.)
theorem oawordex2 {x3: setvar} (A2 B2 C: class):
  $ wi (wa (wa (wcel A2 con0) (wcel B2 con0)) (wa (wss A2 C) (wcel C (co A2 B2 coa)))) (wrex x3 (wceq (co A2 (cv x3) coa) C) B2) $;

--| If an ordinal, ` B ` , is in a half-open interval between some ` A ` and the next limit ordinal, ` B ` is the sum of the ` A ` and some natural number. This weakens the antecedent of ~ nnawordex . (Contributed by RP, 7-Jan-2025.)
theorem nnawordexg {x3: setvar} (A2 B2: class):
  $ wi (w3a (wcel A2 con0) (wss A2 B2) (wcel B2 (co A2 com coa))) (wrex x3 (wceq (co A2 (cv x3) coa) B2) com) $;

--| Closure law for ordinal successor. (Contributed by RP, 8-Jan-2025.)
theorem succlg (A2 B2 C: class):
  $ wi (wa (wcel A2 B2) (wo (wceq B2 c0) (wa (wceq B2 (co com C comu)) (wcel C (cdif con0 c1o))))) (wcel (csuc A2) B2) $;

--| A limit ordinal is either the proper class of ordinals or some nonzero product with omega. (Contributed by RP, 8-Jan-2025.)
theorem dflim5 {x3: setvar} (A2: class):
  $ wb (wlim A2) (wo (wceq A2 con0) (wrex x3 (wceq A2 (co com (cv x3) comu)) (cdif con0 c1o))) $;

--| Closure law for ordinal addition. Here we show that ordinal addition is closed within the empty set or any ordinal power of omega. (Contributed by RP, 5-Jan-2025.)
theorem oacl2g (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 C) (wcel B2 C)) (wo (wceq C c0) (wa (wceq C (co com D coe)) (wcel D con0)))) (wcel (co A2 B2 coa) C) $;

--| If an ordinal is less than a power of omega, the product with a natural number is also less than that power of omega. (Contributed by RP, 19-Feb-2025.)
theorem onmcl (A2 B2 N: class):
  $ wi (w3a (wcel A2 con0) (wcel B2 con0) (wcel N com)) (wi (wcel A2 (co com B2 coe)) (wcel (co A2 N comu) (co com B2 coe))) $;

--| Ordinal multiplication by a larger ordinal is absorbed when the larger ordinal is either 2 or ` _om ` raised to some power of ` _om ` . (Contributed by RP, 12-Jan-2025.)
theorem omabs2 (A2 B2 C: class):
  $ wi (wa (wa (wcel A2 B2) (wcel c0 A2)) (w3o (wceq B2 c0) (wceq B2 c2o) (wa (wceq B2 (co com (co com C coe) coe)) (wcel C con0)))) (wceq (co A2 B2 comu) B2) $;

--| Closure law for ordinal multiplication. (Contributed by RP, 12-Jan-2025.)
theorem omcl2 (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 C) (wcel B2 C)) (wo (wceq C c0) (wa (wceq C (co com (co com D coe) coe)) (wcel D con0)))) (wcel (co A2 B2 comu) C) $;

--| Closure law for ordinal multiplication. (Contributed by RP, 14-Jan-2025.)
theorem omcl3g (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 C) (wcel B2 C)) (wo (wcel C c3o) (wa (wceq C (co com (co com D coe) coe)) (wcel D con0)))) (wcel (co A2 B2 comu) C) $;

--| An ordinal number is less than or equal to the successor of an ordinal class iff the ordinal number is either less than or equal to the ordinal class or the ordinal number is equal to the successor of the ordinal class. See also ~ ordsssucim , ~ limsssuc . (Contributed by RP, 22-Feb-2025.)
theorem ordsssucb (A2 B2: class):
  $ wi (wa (wcel A2 con0) (word B2)) (wb (wss A2 (csuc B2)) (wo (wss A2 B2) (wceq A2 (csuc B2)))) $;

--| Lemma for ~ tfsconcatun . (Contributed by RP, 23-Feb-2025.)
theorem tfsconcatlem {x3 y1: setvar} (A2 B2 C F: class):
  $ wi (w3a (wcel A2 con0) (wcel B2 con0) (wcel C (cdif (co A2 B2 coa) A2))) (weu x3 (wrex y1 (wa (wceq C (co A2 (cv y1) coa)) (wceq (cv x3) (cfv (cv y1) F))) B2)) $;

--| The concatenation of two transfinite series is a union of functions. (Contributed by RP, 23-Feb-2025.)
theorem tfsconcatun {x3 y1 z a b: setvar} (A2 B2 C D: class) (c_pl: class x3 y1 z a b):
  $ wceq c_pl (cmpo a b cvv cvv (cun (cv a) (copab x3 y1 (wa (wcel (cv x3) (cdif (co (cdm (cv a)) (cdm (cv b)) coa) (cdm (cv a)))) (wrex z (wa (wceq (cv x3) (co (cdm (cv a)) (cv z) coa)) (wceq (cv y1) (cfv (cv z) (cv b)))) (cdm (cv b))))))) $ >
  $ wi (wa (wa (wfn A2 C) (wfn B2 D)) (wa (wcel C con0) (wcel D con0))) (wceq (co A2 B2 c_pl) (cun A2 (copab x3 y1 (wa (wcel (cv x3) (cdif (co C D coa) C)) (wrex z (wa (wceq (cv x3) (co C (cv z) coa)) (wceq (cv y1) (cfv (cv z) B2))) D))))) $;

--| The concatenation of two transfinite series is a transfinite series. (Contributed by RP, 22-Feb-2025.)
theorem tfsconcatfn {x3 y1 z a b: setvar} (A2 B2 C D: class) (c_pl: class x3 y1 z a b):
  $ wceq c_pl (cmpo a b cvv cvv (cun (cv a) (copab x3 y1 (wa (wcel (cv x3) (cdif (co (cdm (cv a)) (cdm (cv b)) coa) (cdm (cv a)))) (wrex z (wa (wceq (cv x3) (co (cdm (cv a)) (cv z) coa)) (wceq (cv y1) (cfv (cv z) (cv b)))) (cdm (cv b))))))) $ >
  $ wi (wa (wa (wfn A2 C) (wfn B2 D)) (wa (wcel C con0) (wcel D con0))) (wfn (co A2 B2 c_pl) (co C D coa)) $;

--| An early value of the concatenation of two transfinite series. (Contributed by RP, 23-Feb-2025.)
theorem tfsconcatfv1 {x3 y1 z a b: setvar} (A2 B2 C D: class) (c_pl: class x3 y1 z a b) (X: class a b):
  $ wceq c_pl (cmpo a b cvv cvv (cun (cv a) (copab x3 y1 (wa (wcel (cv x3) (cdif (co (cdm (cv a)) (cdm (cv b)) coa) (cdm (cv a)))) (wrex z (wa (wceq (cv x3) (co (cdm (cv a)) (cv z) coa)) (wceq (cv y1) (cfv (cv z) (cv b)))) (cdm (cv b))))))) $ >
  $ wi (wa (wa (wa (wfn A2 C) (wfn B2 D)) (wa (wcel C con0) (wcel D con0))) (wcel X C)) (wceq (cfv X (co A2 B2 c_pl)) (cfv X A2)) $;

--| A latter value of the concatenation of two transfinite series. (Contributed by RP, 23-Feb-2025.)
theorem tfsconcatfv2 {x3 y1 z a b: setvar} (A2 B2 C D: class) (c_pl: class x3 y1 z a b) (X: class a b):
  $ wceq c_pl (cmpo a b cvv cvv (cun (cv a) (copab x3 y1 (wa (wcel (cv x3) (cdif (co (cdm (cv a)) (cdm (cv b)) coa) (cdm (cv a)))) (wrex z (wa (wceq (cv x3) (co (cdm (cv a)) (cv z) coa)) (wceq (cv y1) (cfv (cv z) (cv b)))) (cdm (cv b))))))) $ >
  $ wi (wa (wa (wa (wfn A2 C) (wfn B2 D)) (wa (wcel C con0) (wcel D con0))) (wcel X D)) (wceq (cfv (co C X coa) (co A2 B2 c_pl)) (cfv X B2)) $;

--| The value of the concatenation of two transfinite series. (Contributed by RP, 24-Feb-2025.)
theorem tfsconcatfv {x3 y1 z a b d: setvar} (A2 B2 C D: class) (c_pl: class x3 y1 z a b) (X: class a b):
  $ wceq c_pl (cmpo a b cvv cvv (cun (cv a) (copab x3 y1 (wa (wcel (cv x3) (cdif (co (cdm (cv a)) (cdm (cv b)) coa) (cdm (cv a)))) (wrex z (wa (wceq (cv x3) (co (cdm (cv a)) (cv z) coa)) (wceq (cv y1) (cfv (cv z) (cv b)))) (cdm (cv b))))))) $ >
  $ wi (wa (wa (wa (wfn A2 C) (wfn B2 D)) (wa (wcel C con0) (wcel D con0))) (wcel X (co C D coa))) (wceq (cfv X (co A2 B2 c_pl)) (cif (wcel X C) (cfv X A2) (cfv (crio d (wceq (co C (cv d) coa) X) D) B2))) $;

--| The range of the concatenation of two transfinite series. (Contributed by RP, 24-Feb-2025.)
theorem tfsconcatrn {x3 y1 z a b: setvar} (A2 B2 C D: class) (c_pl: class x3 y1 z a b):
  $ wceq c_pl (cmpo a b cvv cvv (cun (cv a) (copab x3 y1 (wa (wcel (cv x3) (cdif (co (cdm (cv a)) (cdm (cv b)) coa) (cdm (cv a)))) (wrex z (wa (wceq (cv x3) (co (cdm (cv a)) (cv z) coa)) (wceq (cv y1) (cfv (cv z) (cv b)))) (cdm (cv b))))))) $ >
  $ wi (wa (wa (wfn A2 C) (wfn B2 D)) (wa (wcel C con0) (wcel D con0))) (wceq (crn (co A2 B2 c_pl)) (cun (crn A2) (crn B2))) $;

--| The concatenation of two transfinite series is onto the union of the ranges. (Contributed by RP, 24-Feb-2025.)
theorem tfsconcatfo {x3 y1 z a b: setvar} (A2 B2 C D: class) (c_pl: class x3 y1 z a b):
  $ wceq c_pl (cmpo a b cvv cvv (cun (cv a) (copab x3 y1 (wa (wcel (cv x3) (cdif (co (cdm (cv a)) (cdm (cv b)) coa) (cdm (cv a)))) (wrex z (wa (wceq (cv x3) (co (cdm (cv a)) (cv z) coa)) (wceq (cv y1) (cfv (cv z) (cv b)))) (cdm (cv b))))))) $ >
  $ wi (wa (wa (wfn A2 C) (wfn B2 D)) (wa (wcel C con0) (wcel D con0))) (wfo (co C D coa) (cun (crn A2) (crn B2)) (co A2 B2 c_pl)) $;

--| The concatentation with the empty series leaves the series unchanged. (Contributed by RP, 25-Feb-2025.)
theorem tfsconcatb0 {x3 y1 z a b: setvar} (A2 B2 C D: class) (c_pl: class x3 y1 z a b):
  $ wceq c_pl (cmpo a b cvv cvv (cun (cv a) (copab x3 y1 (wa (wcel (cv x3) (cdif (co (cdm (cv a)) (cdm (cv b)) coa) (cdm (cv a)))) (wrex z (wa (wceq (cv x3) (co (cdm (cv a)) (cv z) coa)) (wceq (cv y1) (cfv (cv z) (cv b)))) (cdm (cv b))))))) $ >
  $ wi (wa (wa (wfn A2 C) (wfn B2 D)) (wa (wcel C con0) (wcel D con0))) (wb (wceq B2 c0) (wceq (co A2 B2 c_pl) A2)) $;

--| The concatentation with the empty series leaves the series unchanged. (Contributed by RP, 28-Feb-2025.)
theorem tfsconcat0i {x3 y1 z a b: setvar} (A2 B2 C D: class) (c_pl: class x3 y1 z a b):
  $ wceq c_pl (cmpo a b cvv cvv (cun (cv a) (copab x3 y1 (wa (wcel (cv x3) (cdif (co (cdm (cv a)) (cdm (cv b)) coa) (cdm (cv a)))) (wrex z (wa (wceq (cv x3) (co (cdm (cv a)) (cv z) coa)) (wceq (cv y1) (cfv (cv z) (cv b)))) (cdm (cv b))))))) $ >
  $ wi (wa (wa (wfn A2 C) (wfn B2 D)) (wa (wcel C con0) (wcel D con0))) (wi (wceq A2 c0) (wceq (co A2 B2 c_pl) B2)) $;

--| The concatentation with the empty series leaves the finite series unchanged. (Contributed by RP, 1-Mar-2025.)
theorem tfsconcat0b {x3 y1 z a b: setvar} (A2 B2 C D: class) (c_pl: class x3 y1 z a b):
  $ wceq c_pl (cmpo a b cvv cvv (cun (cv a) (copab x3 y1 (wa (wcel (cv x3) (cdif (co (cdm (cv a)) (cdm (cv b)) coa) (cdm (cv a)))) (wrex z (wa (wceq (cv x3) (co (cdm (cv a)) (cv z) coa)) (wceq (cv y1) (cfv (cv z) (cv b)))) (cdm (cv b))))))) $ >
  $ wi (wa (wa (wfn A2 C) (wfn B2 D)) (wa (wcel C con0) (wcel D com))) (wb (wceq A2 c0) (wceq (co A2 B2 c_pl) B2)) $;

--| The concatentation of two empty series results in an empty series. (Contributed by RP, 25-Feb-2025.)
theorem tfsconcat00 {x3 y1 z a b: setvar} (A2 B2 C D: class) (c_pl: class x3 y1 z a b):
  $ wceq c_pl (cmpo a b cvv cvv (cun (cv a) (copab x3 y1 (wa (wcel (cv x3) (cdif (co (cdm (cv a)) (cdm (cv b)) coa) (cdm (cv a)))) (wrex z (wa (wceq (cv x3) (co (cdm (cv a)) (cv z) coa)) (wceq (cv y1) (cfv (cv z) (cv b)))) (cdm (cv b))))))) $ >
  $ wi (wa (wa (wfn A2 C) (wfn B2 D)) (wa (wcel C con0) (wcel D con0))) (wb (wa (wceq A2 c0) (wceq B2 c0)) (wceq (co A2 B2 c_pl) c0)) $;

--| If the domain of a transfinite sequence is an ordinal sum, the sequence can be decomposed into two sequences with domains corresponding to the addends. Theorem 2 in Grzegorz Bancerek, "Epsilon Numbers and Cantor Normal Form", Formalized Mathematics, Vol. 17, No. 4, Pages 249&ndash;256, 2009. DOI: 10.2478/v10037-009-0032-8 (Contributed by RP, 2-Mar-2025.)
theorem tfsconcatrev {x3 y1 z v u a b: setvar} (C D: class) (c_pl: class x3 y1 z a b) (F: class):
  $ wceq c_pl (cmpo a b cvv cvv (cun (cv a) (copab x3 y1 (wa (wcel (cv x3) (cdif (co (cdm (cv a)) (cdm (cv b)) coa) (cdm (cv a)))) (wrex z (wa (wceq (cv x3) (co (cdm (cv a)) (cv z) coa)) (wceq (cv y1) (cfv (cv z) (cv b)))) (cdm (cv b))))))) $ >
  $ wi (wa (wfn F (co C D coa)) (wa (wcel C con0) (wcel D con0))) (wrex u (wrex v (w3a (wceq (co (cv u) (cv v) c_pl) F) (wceq (cdm (cv u)) C) (wceq (cdm (cv v)) D)) (co (crn F) D cmap)) (co (crn F) C cmap)) $;

--| The range of the concatenation of transfinite sequences is a superset of the ranges of both sequences. Theorem 3 in Grzegorz Bancerek, "Epsilon Numbers and Cantor Normal Form", Formalized Mathematics, Vol. 17, No. 4, Pages 249&ndash;256, 2009. DOI: 10.2478/v10037-009-0032-8 (Contributed by RP, 2-Mar-2025.)
theorem tfsconcatrnss12 {x3 y1 z a b: setvar} (A2 B2 C D: class) (c_pl: class x3 y1 z a b):
  $ wceq c_pl (cmpo a b cvv cvv (cun (cv a) (copab x3 y1 (wa (wcel (cv x3) (cdif (co (cdm (cv a)) (cdm (cv b)) coa) (cdm (cv a)))) (wrex z (wa (wceq (cv x3) (co (cdm (cv a)) (cv z) coa)) (wceq (cv y1) (cfv (cv z) (cv b)))) (cdm (cv b))))))) $ >
  $ wi (wa (wa (wfn A2 C) (wfn B2 D)) (wa (wcel C con0) (wcel D con0))) (wa (wss (crn A2) (crn (co A2 B2 c_pl))) (wss (crn B2) (crn (co A2 B2 c_pl)))) $;

--| The concatenation of transfinite sequences yields elements from a class iff both sequences yield elements from that class. (Contributed by RP, 2-Mar-2025.)
theorem tfsconcatrnss {x3 y1 z a b: setvar} (A2 B2 C D: class) (c_pl: class x3 y1 z a b) (X: class a b):
  $ wceq c_pl (cmpo a b cvv cvv (cun (cv a) (copab x3 y1 (wa (wcel (cv x3) (cdif (co (cdm (cv a)) (cdm (cv b)) coa) (cdm (cv a)))) (wrex z (wa (wceq (cv x3) (co (cdm (cv a)) (cv z) coa)) (wceq (cv y1) (cfv (cv z) (cv b)))) (cdm (cv b))))))) $ >
  $ wi (wa (wa (wfn A2 C) (wfn B2 D)) (wa (wcel C con0) (wcel D con0))) (wb (wss (crn (co A2 B2 c_pl)) X) (wa (wss (crn A2) X) (wss (crn B2) X))) $;

--| The concatenation of transfinite sequences yields ordinals iff both sequences yield ordinals. Theorem 4 in Grzegorz Bancerek, "Epsilon Numbers and Cantor Normal Form", Formalized Mathematics, Vol. 17, No. 4, Pages 249&ndash;256, 2009. DOI: 10.2478/v10037-009-0032-8 (Contributed by RP, 2-Mar-2025.)
theorem tfsconcatrnsson {x3 y1 z a b: setvar} (A2 B2 C D: class) (c_pl: class x3 y1 z a b):
  $ wceq c_pl (cmpo a b cvv cvv (cun (cv a) (copab x3 y1 (wa (wcel (cv x3) (cdif (co (cdm (cv a)) (cdm (cv b)) coa) (cdm (cv a)))) (wrex z (wa (wceq (cv x3) (co (cdm (cv a)) (cv z) coa)) (wceq (cv y1) (cfv (cv z) (cv b)))) (cdm (cv b))))))) $ >
  $ wi (wa (wa (wfn A2 C) (wfn B2 D)) (wa (wcel C con0) (wcel D con0))) (wb (wss (crn (co A2 B2 c_pl)) con0) (wa (wss (crn A2) con0) (wss (crn B2) con0))) $;

--| A transfinite sequence is infinite iff its domain is greater than or equal to omega. Theorem 5 in Grzegorz Bancerek, "Epsilon Numbers and Cantor Normal Form", Formalized Mathematics, Vol. 17, No. 4, Pages 249&ndash;256, 2009. DOI: 10.2478/v10037-009-0032-8 (Contributed by RP, 1-Mar-2025.)
theorem tfsnfin (A2 B2: class):
  $ wi (wa (wfn A2 B2) (wcel B2 con0)) (wb (wn (wcel A2 cfn)) (wss com B2)) $;

--| The limit of a sequence of ordinals is the union of its range. (Contributed by RP, 1-Mar-2025.)
theorem rp_tfslim {x3: setvar} (A2 B2: class):
  $ wi (wfn A2 B2) (wceq (ciun x3 B2 (cfv (cv x3) A2)) (cuni (crn A2))) $;

--| Addition operator for functions from sets into ordinals results in a function from the intersection of sets into an ordinal. (Contributed by RP, 5-Jan-2025.)
theorem ofoafg {d: setvar} (A2 B2: class d) (C D E: class) (F V W: class d):
  $ wi (wa (w3a (wcel A2 V) (wcel B2 W) (wceq C (cin A2 B2))) (w3a (wcel D con0) (wcel E con0) (wceq F (ciun d D (co (cv d) E coa))))) (wf (cxp (co D A2 cmap) (co E B2 cmap)) (co F C cmap) (cres (cof coa) (cxp (co D A2 cmap) (co E B2 cmap)))) $;

--| Addition operator for functions from sets into power of omega results in a function from the intersection of sets to that power of omega. (Contributed by RP, 5-Jan-2025.)
theorem ofoaf (A2 B2 C D E V W: class):
  $ wi (wa (w3a (wcel A2 V) (wcel B2 W) (wceq C (cin A2 B2))) (wa (wcel D con0) (wceq E (co com D coe)))) (wf (cxp (co E A2 cmap) (co E B2 cmap)) (co E C cmap) (cres (cof coa) (cxp (co E A2 cmap) (co E B2 cmap)))) $;

--| Addition operator for functions from a set into a power of omega is an onto binary operator. (Contributed by RP, 5-Jan-2025.)
theorem ofoafo (A2 B2 C V: class):
  $ wi (wa (wcel A2 V) (wa (wcel B2 con0) (wceq C (co com B2 coe)))) (wfo (cxp (co C A2 cmap) (co C A2 cmap)) (co C A2 cmap) (cres (cof coa) (cxp (co C A2 cmap) (co C A2 cmap)))) $;

--| Closure law for component wise addition of ordinal-yielding functions. (Contributed by RP, 5-Jan-2025.)
theorem ofoacl (A2 B2 C F G V: class):
  $ wi (wa (wa (wcel A2 V) (wa (wcel B2 con0) (wceq C (co com B2 coe)))) (wa (wcel F (co C A2 cmap)) (wcel G (co C A2 cmap)))) (wcel (co F G (cof coa)) (co C A2 cmap)) $;

--| Identity law for component wise addition of ordinal-yielding functions. (Contributed by RP, 5-Jan-2025.)
theorem ofoaid1 (A2 B2 F V: class):
  $ wi (wa (wa (wcel A2 V) (wcel B2 con0)) (wcel F (co B2 A2 cmap))) (wceq (co F (cxp A2 (csn c0)) (cof coa)) F) $;

--| Identity law for component wise addition of ordinal-yielding functions. (Contributed by RP, 5-Jan-2025.)
theorem ofoaid2 (A2 B2 F V: class):
  $ wi (wa (wa (wcel A2 V) (wcel B2 con0)) (wcel F (co B2 A2 cmap))) (wceq (co (cxp A2 (csn c0)) F (cof coa)) F) $;

--| Component-wise addition of ordinal-yielding functions is associative. (Contributed by RP, 5-Jan-2025.)
theorem ofoaass (A2 B2 F G H V: class):
  $ wi (wa (wa (wcel A2 V) (wcel B2 con0)) (w3a (wcel F (co B2 A2 cmap)) (wcel G (co B2 A2 cmap)) (wcel H (co B2 A2 cmap)))) (wceq (co (co F G (cof coa)) H (cof coa)) (co F (co G H (cof coa)) (cof coa))) $;

--| Component-wise addition of natural numnber-yielding functions commutes. (Contributed by RP, 5-Jan-2025.)
theorem ofoacom (A2 F G V: class):
  $ wi (wa (wcel A2 V) (wa (wcel F (co com A2 cmap)) (wcel G (co com A2 cmap)))) (wceq (co F G (cof coa)) (co G F (cof coa))) $;

--| Addition operator for Cantor normal forms is a function into Cantor normal forms. (Contributed by RP, 2-Jan-2025.)
theorem naddcnff (S X: class):
  $ wi (wa (wcel X con0) (wceq S (cdm (co com X ccnf)))) (wf (cxp S S) S (cres (cof coa) (cxp S S))) $;

--| Addition operator for Cantor normal forms is a function. (Contributed by RP, 2-Jan-2025.)
theorem naddcnffn (S X: class):
  $ wi (wa (wcel X con0) (wceq S (cdm (co com X ccnf)))) (wfn (cres (cof coa) (cxp S S)) (cxp S S)) $;

--| Addition of Cantor normal forms is a function onto Cantor normal forms. (Contributed by RP, 2-Jan-2025.)
theorem naddcnffo (S X: class):
  $ wi (wa (wcel X con0) (wceq S (cdm (co com X ccnf)))) (wfo (cxp S S) S (cres (cof coa) (cxp S S))) $;

--| Closure law for component-wise ordinal addition of Cantor normal forms. (Contributed by RP, 2-Jan-2025.)
theorem naddcnfcl (S F G X: class):
  $ wi (wa (wa (wcel X con0) (wceq S (cdm (co com X ccnf)))) (wa (wcel F S) (wcel G S))) (wcel (co F G (cof coa)) S) $;

--| Component-wise ordinal addition of Cantor normal forms commutes. (Contributed by RP, 2-Jan-2025.)
theorem naddcnfcom (S F G X: class):
  $ wi (wa (wa (wcel X con0) (wceq S (cdm (co com X ccnf)))) (wa (wcel F S) (wcel G S))) (wceq (co F G (cof coa)) (co G F (cof coa))) $;

--| Identity law for component-wise ordinal addition of Cantor normal forms. (Contributed by RP, 3-Jan-2025.)
theorem naddcnfid1 (S F X: class):
  $ wi (wa (wa (wcel X con0) (wceq S (cdm (co com X ccnf)))) (wcel F S)) (wceq (co F (cxp X (csn c0)) (cof coa)) F) $;

--| Identity law for component-wise ordinal addition of Cantor normal forms. (Contributed by RP, 3-Jan-2025.)
theorem naddcnfid2 (S F X: class):
  $ wi (wa (wa (wcel X con0) (wceq S (cdm (co com X ccnf)))) (wcel F S)) (wceq (co (cxp X (csn c0)) F (cof coa)) F) $;

--| Component-wise addition of Cantor normal forms is associative. (Contributed by RP, 3-Jan-2025.)
theorem naddcnfass (S F G H X: class):
  $ wi (wa (wa (wcel X con0) (wceq S (cdm (co com X ccnf)))) (w3a (wcel F S) (wcel G S) (wcel H S))) (wceq (co (co F G (cof coa)) H (cof coa)) (co F (co G H (cof coa)) (cof coa))) $;

--| The successor to the union of any non-empty, finite subset of ordinals is the union of the successors of the elements. (Contributed by RP, 12-Feb-2025.)
theorem onsucunifi {x3: setvar} (A2: class):
  $ wi (w3a (wss A2 con0) (wcel A2 cfn) (wne A2 c0)) (wceq (csuc (cuni A2)) (ciun x3 A2 (csuc (cv x3)))) $;

--| The successor to the union of any singleton of a set is the successor of the set. (Contributed by RP, 11-Feb-2025.)
theorem sucunisn (A2 V: class):
  $ wi (wcel A2 V) (wceq (csuc (cuni (csn A2))) (csuc A2)) $;

--| The successor to the union of any pair of ordinals is the union of the successors of the elements. (Contributed by RP, 12-Feb-2025.)
theorem onsucunipr (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wceq (csuc (cuni (cpr A2 B2))) (cuni (cpr (csuc A2) (csuc B2)))) $;

--| The successor to the union of any triple of ordinals is the union of the successors of the elements. (Contributed by RP, 12-Feb-2025.)
theorem onsucunitp (A2 B2 C: class):
  $ wi (w3a (wcel A2 con0) (wcel B2 con0) (wcel C con0)) (wceq (csuc (cuni (ctp A2 B2 C))) (cuni (ctp (csuc A2) (csuc B2) (csuc C)))) $;

--| The class of all ordinal sums of elements from two ordinals is ordinal. Lemma for ~ oaun3 . (Contributed by RP, 13-Feb-2025.)
theorem oaun3lem1 {x3 a b: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (word (cab x3 (wrex a (wrex b (wceq (cv x3) (co (cv a) (cv b) coa)) B2) A2))) $;

--| The class of all ordinal sums of elements from two ordinals is bounded by the sum. Lemma for ~ oaun3 . (Contributed by RP, 13-Feb-2025.)
theorem oaun3lem2 {x3 a b: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wss (cab x3 (wrex a (wrex b (wceq (cv x3) (co (cv a) (cv b) coa)) B2) A2)) (co A2 B2 coa)) $;

--| The class of all ordinal sums of elements from two ordinals is an ordinal. Lemma for ~ oaun3 . (Contributed by RP, 13-Feb-2025.)
theorem oaun3lem3 {x3 a b: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wcel (cab x3 (wrex a (wrex b (wceq (cv x3) (co (cv a) (cv b) coa)) B2) A2)) con0) $;

--| The class of all ordinal sums of elements from two ordinals is less than the successor to the sum. Lemma for ~ oaun3 . (Contributed by RP, 12-Feb-2025.)
theorem oaun3lem4 {x3 a b: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wcel (cab x3 (wrex a (wrex b (wceq (cv x3) (co (cv a) (cv b) coa)) B2) A2)) (csuc (co A2 B2 coa))) $;

--| Two ways to express a class. (Contributed by RP, 13-Feb-2025.)
theorem rp_abid {x3 a: setvar} (A2: class):
  $ wceq A2 (cab x3 (wrex a (wceq (cv x3) (cv a)) A2)) $;

--| Express the set difference of a continuous sum and its left addend as a class of sums. (Contributed by RP, 13-Feb-2025.)
theorem oadif1lem {x3 y1 b: setvar} (A2 B2 c_po: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wcel (co A2 B2 c_po) con0) $ >
  $ wi (wa (wcel A2 con0) (wcel (cv b) con0)) (wcel (co A2 (cv b) c_po) con0) $ >
  $ wi (wa (wa (wcel A2 con0) (wcel B2 con0)) (wa (wss A2 (cv y1)) (wcel (cv y1) (co A2 B2 c_po)))) (wrex b (wceq (co A2 (cv b) c_po) (cv y1)) B2) $ >
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wi (wcel (cv b) B2) (wcel (co A2 (cv b) c_po) (co A2 B2 c_po))) $ >
  $ wi (wa (wcel A2 con0) (wcel (cv b) con0)) (wss A2 (co A2 (cv b) c_po)) $ >
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wceq (cdif (co A2 B2 c_po) A2) (cab x3 (wrex b (wceq (cv x3) (co A2 (cv b) c_po)) B2))) $;

--| Express the set difference of an ordinal sum and its left addend as a class of sums. (Contributed by RP, 13-Feb-2025.)
theorem oadif1 {x3 b: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wceq (cdif (co A2 B2 coa) A2) (cab x3 (wrex b (wceq (cv x3) (co A2 (cv b) coa)) B2))) $;

--| Ordinal addition as a union of classes. (Contributed by RP, 13-Feb-2025.)
theorem oaun2 {x3 y1 a b: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wceq (co A2 B2 coa) (cuni (cpr (cab x3 (wrex a (wceq (cv x3) (cv a)) A2)) (cab y1 (wrex b (wceq (cv y1) (co A2 (cv b) coa)) B2))))) $;

--| Ordinal addition as a union of classes. (Contributed by RP, 13-Feb-2025.)
theorem oaun3 {x3 y1 z a b: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wceq (co A2 B2 coa) (cuni (ctp (cab x3 (wrex a (wceq (cv x3) (cv a)) A2)) (cab y1 (wrex b (wceq (cv y1) (co A2 (cv b) coa)) B2)) (cab z (wrex a (wrex b (wceq (cv z) (co (cv a) (cv b) coa)) B2) A2))))) $;

--| Alternate expression for natural addition. (Contributed by RP, 19-Dec-2024.)
theorem naddov4 {x3 a b: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wceq (co A2 B2 cnadd) (cint (cin (crab x3 (wral a (wcel (co (cv a) B2 cnadd) (cv x3)) A2) con0) (crab x3 (wral b (wcel (co A2 (cv b) cnadd) (cv x3)) B2) con0)))) $;

--| The set of ordinals which have a natural sum less than some ordinal is transitive. (Contributed by RP, 20-Dec-2024.)
theorem nadd2rabtr {x3: setvar} (A2 B2 C: class):
  $ wi (w3a (word A2) (wcel B2 con0) (wcel C con0)) (wtr (crab x3 (wcel (co B2 (cv x3) cnadd) C) A2)) $;

--| The set of ordinals which have a natural sum less than some ordinal is an ordinal. (Contributed by RP, 20-Dec-2024.)
theorem nadd2rabord {x3: setvar} (A2 B2 C: class):
  $ wi (w3a (word A2) (wcel B2 con0) (wcel C con0)) (word (crab x3 (wcel (co B2 (cv x3) cnadd) C) A2)) $;

--| The class of ordinals which have a natural sum less than some ordinal is a set. (Contributed by RP, 20-Dec-2024.)
theorem nadd2rabex {x3: setvar} (A2 B2 C: class):
  $ wi (w3a (word A2) (wcel B2 con0) (wcel C con0)) (wcel (crab x3 (wcel (co B2 (cv x3) cnadd) C) A2) cvv) $;

--| The set of ordinals which have a natural sum less than some ordinal is an ordinal number. (Contributed by RP, 20-Dec-2024.)
theorem nadd2rabon {x3: setvar} (A2 B2 C: class):
  $ wi (w3a (word A2) (wcel B2 con0) (wcel C con0)) (wcel (crab x3 (wcel (co B2 (cv x3) cnadd) C) A2) con0) $;

--| The set of ordinals which have a natural sum less than some ordinal is transitive. (Contributed by RP, 20-Dec-2024.)
theorem nadd1rabtr {x3: setvar} (A2 B2 C: class):
  $ wi (w3a (word A2) (wcel B2 con0) (wcel C con0)) (wtr (crab x3 (wcel (co (cv x3) B2 cnadd) C) A2)) $;

--| The set of ordinals which have a natural sum less than some ordinal is an ordinal. (Contributed by RP, 20-Dec-2024.)
theorem nadd1rabord {x3: setvar} (A2 B2 C: class):
  $ wi (w3a (word A2) (wcel B2 con0) (wcel C con0)) (word (crab x3 (wcel (co (cv x3) B2 cnadd) C) A2)) $;

--| The class of ordinals which have a natural sum less than some ordinal is a set. (Contributed by RP, 20-Dec-2024.)
theorem nadd1rabex {x3: setvar} (A2 B2 C: class):
  $ wi (w3a (word A2) (wcel B2 con0) (wcel C con0)) (wcel (crab x3 (wcel (co (cv x3) B2 cnadd) C) A2) cvv) $;

--| The set of ordinals which have a natural sum less than some ordinal is an ordinal number. (Contributed by RP, 20-Dec-2024.)
theorem nadd1rabon {x3: setvar} (A2 B2 C: class):
  $ wi (w3a (word A2) (wcel B2 con0) (wcel C con0)) (wcel (crab x3 (wcel (co (cv x3) B2 cnadd) C) A2) con0) $;

--| Natural addition with 1 is same as successor. (Contributed by RP, 31-Dec-2024.)
theorem nadd1suc (A2: class):
  $ wi (wcel A2 con0) (wceq (co A2 c1o cnadd) (csuc A2)) $;

--| Natural addition of ordinal numbers is associative when the third element is 1. (Contributed by RP, 1-Jan-2025.)
theorem naddass1 (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wceq (co (co A2 B2 cnadd) c1o cnadd) (co A2 (co B2 c1o cnadd) cnadd)) $;

--| Natural addition results in a value greater than or equal than that of ordinal addition. (Contributed by RP, 1-Jan-2025.)
theorem naddgeoa (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wss (co A2 B2 coa) (co A2 B2 cnadd)) $;

--| Natural addition with a natural number on the right results in a value equal to that of ordinal addition. (Contributed by RP, 1-Jan-2025.)
theorem naddonnn (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 com)) (wceq (co A2 B2 coa) (co A2 B2 cnadd)) $;

--| When ` A ` is the sum of a limit ordinal (or zero) and a natural number and ` B ` is the sum of a larger limit ordinal and a smaller natural number, ` ( _om .o suc C ) ` lies between ` A ` and ` B ` . (Contributed by RP, 14-Feb-2025.)
theorem naddwordnexlem0 (ph: wff) (A2 B2 C D M N: class):
  $ wi ph (wceq A2 (co (co com C comu) M coa)) $ >
  $ wi ph (wceq B2 (co (co com D comu) N coa)) $ >
  $ wi ph (wcel C D) $ >
  $ wi ph (wcel D con0) $ >
  $ wi ph (wcel M com) $ >
  $ wi ph (wcel N M) $ >
  $ wi ph (wa (wcel A2 (co com (csuc C) comu)) (wss (co com (csuc C) comu) B2)) $;

--| When ` A ` is the sum of a limit ordinal (or zero) and a natural number and ` B ` is the sum of a larger limit ordinal and a smaller natural number, ` B ` is equal to or larger than ` A ` . (Contributed by RP, 14-Feb-2025.)
theorem naddwordnexlem1 (ph: wff) (A2 B2 C D M N: class):
  $ wi ph (wceq A2 (co (co com C comu) M coa)) $ >
  $ wi ph (wceq B2 (co (co com D comu) N coa)) $ >
  $ wi ph (wcel C D) $ >
  $ wi ph (wcel D con0) $ >
  $ wi ph (wcel M com) $ >
  $ wi ph (wcel N M) $ >
  $ wi ph (wss A2 B2) $;

--| When ` A ` is the sum of a limit ordinal (or zero) and a natural number and ` B ` is the sum of a larger limit ordinal and a smaller natural number, ` B ` is larger than ` A ` . (Contributed by RP, 14-Feb-2025.)
theorem naddwordnexlem2 (ph: wff) (A2 B2 C D M N: class):
  $ wi ph (wceq A2 (co (co com C comu) M coa)) $ >
  $ wi ph (wceq B2 (co (co com D comu) N coa)) $ >
  $ wi ph (wcel C D) $ >
  $ wi ph (wcel D con0) $ >
  $ wi ph (wcel M com) $ >
  $ wi ph (wcel N M) $ >
  $ wi ph (wcel A2 B2) $;

--| When ` A ` is the sum of a limit ordinal (or zero) and a natural number and ` B ` is the sum of a larger limit ordinal and a smaller natural number, every natural sum of ` A ` with a natural number is less that ` B ` . (Contributed by RP, 14-Feb-2025.)
theorem naddwordnexlem3 {x3: setvar} (ph: wff) (A2 B2 C D M N: class x3):
  $ wi ph (wceq A2 (co (co com C comu) M coa)) $ >
  $ wi ph (wceq B2 (co (co com D comu) N coa)) $ >
  $ wi ph (wcel C D) $ >
  $ wi ph (wcel D con0) $ >
  $ wi ph (wcel M com) $ >
  $ wi ph (wcel N M) $ >
  $ wi ph (wral x3 (wcel (co A2 (cv x3) cnadd) B2) com) $;

--| When ` A ` is the sum of a limit ordinal (or zero) and a natural number and ` B ` is the sum of a larger limit ordinal and a smaller natural number, some ordinal sum of ` A ` is equal to ` B ` . This is a specialization of ~ oawordex . (Contributed by RP, 14-Feb-2025.)
theorem oawordex3 {x3: setvar} (ph: wff x3) (A2 B2: class) (C D M N: class x3):
  $ wi ph (wceq A2 (co (co com C comu) M coa)) $ >
  $ wi ph (wceq B2 (co (co com D comu) N coa)) $ >
  $ wi ph (wcel C D) $ >
  $ wi ph (wcel D con0) $ >
  $ wi ph (wcel M com) $ >
  $ wi ph (wcel N M) $ >
  $ wi ph (wrex x3 (wceq (co A2 (cv x3) coa) B2) con0) $;

--| When ` A ` is the sum of a limit ordinal (or zero) and a natural number and ` B ` is the sum of a larger limit ordinal and a smaller natural number, there exists a product with omega such that the ordinal sum with ` A ` is less than or equal to ` B ` while the natural sum is larger than ` B ` . (Contributed by RP, 15-Feb-2025.)
theorem naddwordnexlem4 {x3 y1: setvar} (ph: wff x3) (A2 B2: class y1) (C D: class) (S: class y1) (M N: class x3 y1):
  $ wi ph (wceq A2 (co (co com C comu) M coa)) $ >
  $ wi ph (wceq B2 (co (co com D comu) N coa)) $ >
  $ wi ph (wcel C D) $ >
  $ wi ph (wcel D con0) $ >
  $ wi ph (wcel M com) $ >
  $ wi ph (wcel N M) $ >
  $ wceq S (crab y1 (wss D (co C (cv y1) coa)) con0) $ >
  $ wi ph (wrex x3 (w3a (wceq (co C (cv x3) coa) D) (wss (co A2 (co com (cv x3) comu) coa) B2) (wcel B2 (co A2 (co com (cv x3) comu) cnadd))) (cdif con0 c1o)) $;

--| If an ordinal is less than or equal to the successor of another, then the first is either less than or equal to the second or the first is equal to the successor of the second. Theorem 1 in Grzegorz Bancerek, "Epsilon Numbers and Cantor Normal Form", Formalized Mathematics, Vol. 17, No. 4, Pages 249&ndash;256, 2009. DOI: 10.2478/v10037-009-0032-8 See also ~ ordsssucb for a biimplication when ` A ` is a set. (Contributed by RP, 3-Jan-2025.)
theorem ordsssucim (A2 B2: class):
  $ wi (wa (word A2) (word B2)) (wi (wss A2 (csuc B2)) (wo (wss A2 B2) (wceq A2 (csuc B2)))) $;

--| The intersection of a class and its successor is itself. (Contributed by RP, 3-Jan-2025.)
theorem insucid (A2: class):
  $ wceq (cin A2 (csuc A2)) A2 $;

--| Multiplication eventually dominates addition. (Contributed by RP, 3-Jan-2025.)
theorem oaltom (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wi (wa (wcel c1o A2) (wcel A2 B2)) (wcel (co B2 A2 coa) (co B2 A2 comu))) $;

--| Two ways to square an ordinal. (Contributed by RP, 3-Jan-2025.)
theorem oe2 (A2: class):
  $ wi (wcel A2 con0) (wceq (co A2 A2 comu) (co A2 c2o coe)) $;

--| Exponentiation eventually dominates multiplication. (Contributed by RP, 3-Jan-2025.)
theorem omltoe (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wi (wa (wcel c1o A2) (wcel A2 B2)) (wcel (co B2 A2 comu) (co B2 A2 coe))) $;

--| Generalized condition for a class abstraction to be equal to some class. (Contributed by RP, 2-Sep-2024.)
theorem abeqabi {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wceq A2 (cab x3 ps) $ >
  $ wb (wceq (cab x3 ph) A2) (wal x3 (wb ph ps)) $;

--| Condition for a class abstraction to be a pair. (Contributed by RP, 25-Aug-2024.)
theorem abpr {x3: setvar} (ph: wff x3) (Y Z: class):
  $ wb (wceq (cab x3 ph) (cpr Y Z)) (wal x3 (wb ph (wo (wceq (cv x3) Y) (wceq (cv x3) Z)))) $;

--| Condition for a class abstraction to be a triple. (Contributed by RP, 25-Aug-2024.)
theorem abtp {x3: setvar} (ph: wff x3) (X Y Z: class):
  $ wb (wceq (cab x3 ph) (ctp X Y Z)) (wal x3 (wb ph (w3o (wceq (cv x3) X) (wceq (cv x3) Y) (wceq (cv x3) Z)))) $;

--| Restricted universal quantification over an ordered-pair class abstraction. (Contributed by RP, 25-Sep-2024.)
theorem ralopabb {x3 y1 o: setvar} (ph: wff x3 y1) (ps: wff o) (ch: wff x3 y1) (O: class x3 y1):
  $ wceq O (copab x3 y1 ph) $ >
  $ wi (wceq (cv o) (cop (cv x3) (cv y1))) (wb ps ch) $ >
  $ wb (wral o ps O) (wal x3 (wal y1 (wi ph ch))) $;

--| Functions into a powerset always have values which are subsets. This is dependant on our convention when the argument is not part of the domain. (Contributed by RP, 13-Sep-2024.)
theorem fpwfvss (A2 B2 C F: class):
  $ wf C (cpw B2) F $ >
  $ wss (cfv A2 F) B2 $;

--| A class that strictly dominates any set is not empty. (Suggested by SN, 14-Jan-2025.) (Contributed by RP, 14-Jan-2025.)
theorem sdomne0 (A2 B2: class):
  $ wi (wbr B2 A2 csdm) (wne A2 c0) $;

--| A class that strictly dominates any set is not empty. (Contributed by RP, 3-Sep-2024.)
theorem sdomne0d (ph: wff) (A2 B2 V: class):
  $ wi ph (wbr B2 A2 csdm) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wne A2 c0) $;

--| If ` B ` is a finite subset of ordered class ` A ` , we can safely create a small subset with the same largest element and upper bound, if any. (Contributed by RP, 1-Sep-2024.)
theorem safesnsupfiss (ph: wff) (A2 B2 R O: class):
  $ wi ph (wo (wceq O c0) (wceq O c1o)) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wss B2 A2) $ >
  $ wi ph (wor A2 R) $ >
  $ wi ph (wss (cif (wbr O B2 csdm) (csn (csup B2 A2 R)) B2) B2) $;

--| If ` B ` is a finite subset of ordered class ` A ` , we can safely create a small subset with the same largest element and upper bound, if any. (Contributed by RP, 1-Sep-2024.)
theorem safesnsupfiub {x3 y1: setvar} (ph: wff y1) (A2 B2 C R O: class x3 y1):
  $ wi ph (wo (wceq O c0) (wceq O c1o)) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wss B2 A2) $ >
  $ wi ph (wor A2 R) $ >
  $ wi ph (wral x3 (wral y1 (wbr (cv x3) (cv y1) R) C) B2) $ >
  $ wi ph (wral x3 (wral y1 (wbr (cv x3) (cv y1) R) C) (cif (wbr O B2 csdm) (csn (csup B2 A2 R)) B2)) $;

--| If ` B ` is a finite subset of ordered class ` A ` , we can safely create a small subset with the same largest element and upper bound, if any. (Contributed by RP, 1-Sep-2024.)
theorem safesnsupfidom1o (ph: wff) (A2 B2 R O: class):
  $ wi ph (wo (wceq O c0) (wceq O c1o)) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wbr (cif (wbr O B2 csdm) (csn (csup B2 A2 R)) B2) c1o cdom) $;

--| If ` B ` is a finite subset of ordered class ` A ` , we can safely create a small subset with the same largest element and upper bound, if any. (Contributed by RP, 3-Sep-2024.)
theorem safesnsupfilb {x3 y1: setvar} (ph: wff y1) (A2 B2 R O: class):
  $ wi ph (wo (wceq O c0) (wceq O c1o)) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wss B2 A2) $ >
  $ wi ph (wor A2 R) $ >
  $ wi ph (wral x3 (wral y1 (wbr (cv x3) (cv y1) R) (cif (wbr O B2 csdm) (csn (csup B2 A2 R)) B2)) (cdif B2 (cif (wbr O B2 csdm) (csn (csup B2 A2 R)) B2))) $;

--| Equality deduction for isometries. (Contributed by RP, 14-Jan-2025.)
theorem isoeq145d (ph: wff) (A2 B2 C D R S F G: class):
  $ wi ph (wceq F G) $ >
  $ wi ph (wceq A2 C) $ >
  $ wi ph (wceq B2 D) $ >
  $ wi ph (wb (wiso A2 B2 R S F) (wiso C D R S G)) $;

--| Equality deduction for equally restricted isometries. (Contributed by RP, 14-Jan-2025.)
theorem resisoeq45d (ph: wff) (A2 B2 C D R S F: class):
  $ wi ph (wceq A2 C) $ >
  $ wi ph (wceq B2 D) $ >
  $ wi ph (wb (wiso A2 B2 R S (cres F A2)) (wiso C D R S (cres F C))) $;

--| An equivalence between identically restricted order-reversing self-isometries. (Contributed by RP, 30-Sep-2024.)
theorem negslem1 (A2 B2 R F: class):
  $ wi (wceq A2 B2) (wb (wiso A2 A2 R (ccnv R) (cres F A2)) (wiso B2 B2 R (ccnv R) (cres F B2))) $;

--| Equivalence to saying the converse of an involution is the function itself. (Contributed by RP, 13-Oct-2024.)
theorem nvocnvb {x3: setvar} (A2 F: class):
  $ wb (wa (wfn F A2) (wceq (ccnv F) F)) (wa (wf1o A2 A2 F) (wral x3 (wceq (cfv (cfv (cv x3) F) F) (cv x3)) A2)) $;

--| Binary relation form of a relation, ` .< ` , which has been extended from relation ` R ` to subsets of class ` S ` . Usually, we will assume ` R Or S ` . Definition in [Alling], p. 2. Generalization of ~ brslts . (Originally by Scott Fenton, 8-Dec-2021.) (Contributed by RP, 28-Nov-2023.)
theorem rp_brsslt {x3 y1 a b: setvar} (A2 B2: class) (R S: class x3 y1) (c_lt: class x3 y1 a b):
  $ wceq c_lt (copab a b (w3a (wss (cv a) S) (wss (cv b) S) (wral x3 (wral y1 (wbr (cv x3) (cv y1) R) (cv b)) (cv a)))) $ >
  $ wb (wbr A2 B2 c_lt) (wa (wa (wcel A2 cvv) (wcel B2 cvv)) (w3a (wss A2 S) (wss B2 S) (wral x3 (wral y1 (wbr (cv x3) (cv y1) R) B2) A2))) $;

--| Extending a linear order to subsets, the empty set is less than any subset. Note in [Alling], p. 3. (Contributed by RP, 28-Nov-2023.)
theorem nla0002 {x3 y1 a b: setvar} (ph: wff x3 y1 a b) (A2: class) (R S: class x3 y1) (c_lt: class x3 y1 a b):
  $ wceq c_lt (copab a b (w3a (wss (cv a) S) (wss (cv b) S) (wral x3 (wral y1 (wbr (cv x3) (cv y1) R) (cv b)) (cv a)))) $ >
  $ wi ph (wcel A2 cvv) $ >
  $ wi ph (wss A2 S) $ >
  $ wi ph (wbr c0 A2 c_lt) $;

--| Extending a linear order to subsets, the empty set is greater than any subset. Note in [Alling], p. 3. (Contributed by RP, 28-Nov-2023.)
theorem nla0003 {x3 y1 a b: setvar} (ph: wff x3 y1 a b) (A2: class) (R S: class x3 y1) (c_lt: class x3 y1 a b):
  $ wceq c_lt (copab a b (w3a (wss (cv a) S) (wss (cv b) S) (wral x3 (wral y1 (wbr (cv x3) (cv y1) R) (cv b)) (cv a)))) $ >
  $ wi ph (wcel A2 cvv) $ >
  $ wi ph (wss A2 S) $ >
  $ wi ph (wbr A2 c0 c_lt) $;

--| Extending a linear order to subsets, the empty set is less than itself. Note in [Alling], p. 3. (Contributed by RP, 28-Nov-2023.)
theorem nla0001 {x3 y1 a b: setvar} (ph: wff x3 y1 a b) (R S: class x3 y1) (c_lt: class x3 y1 a b):
  $ wceq c_lt (copab a b (w3a (wss (cv a) S) (wss (cv b) S) (wral x3 (wral y1 (wbr (cv x3) (cv y1) R) (cv b)) (cv a)))) $ >
  $ wi ph (wbr c0 c0 c_lt) $;

--| ` B ` is called a non-limit ordinal if it is not a limit ordinal. (Contributed by RP, 27-Sep-2023.) Alling, Norman L. "Fundamentals of Analysis Over Surreal Numbers Fields." The Rocky Mountain Journal of Mathematics 19, no. 3 (1989): 565-73. http://www.jstor.org/stable/44237243.
theorem faosnf0_11b {x3: setvar} (A2: class):
  $ wi (w3a (word A2) (wn (wlim A2)) (wne A2 c0)) (wrex x3 (wceq A2 (csuc (cv x3))) con0) $;

--| A surreal number, in the functional sign expansion representation, is a function which maps from an ordinal into a set of two possible signs. (Contributed by RP, 12-Jan-2025.)
theorem dfno2 {f2: setvar}:
  $ wceq csur (crab f2 (wa (wfun (cv f2)) (wcel (cdm (cv f2)) con0)) (cpw (cxp con0 (cpr c1o c2o)))) $;

--| Every ordinal maps to a surreal number. (Contributed by RP, 21-Sep-2023.)
theorem onnoxpg (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 (cpr c1o c2o))) (wcel (cxp A2 (csn B2)) csur) $;

--| Every ordinal maps to a surreal number of that birthday. (Contributed by RP, 21-Sep-2023.)
theorem onnobdayg (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 (cpr c1o c2o))) (wceq (cfv (cxp A2 (csn B2)) cbday) A2) $;

--| Bounds formed from the birthday are surreal numbers. (Contributed by RP, 21-Sep-2023.)
theorem bdaybndex (A2 B2 C: class):
  $ wi (w3a (wcel A2 csur) (wceq B2 (cfv A2 cbday)) (wcel C (cpr c1o c2o))) (wcel (cxp B2 (csn C)) csur) $;

--| Bounds formed from the birthday have the same birthday. (Contributed by RP, 30-Sep-2023.)
theorem bdaybndbday (A2 B2 C: class):
  $ wi (w3a (wcel A2 csur) (wceq B2 (cfv A2 cbday)) (wcel C (cpr c1o c2o))) (wceq (cfv (cxp B2 (csn C)) cbday) (cfv A2 cbday)) $;

--| Every ordinal maps to a surreal number. (Contributed by RP, 21-Sep-2023.)
theorem onnoxp (A2: class):
  $ wi (wcel A2 con0) (wcel (cxp A2 (csn c2o)) csur) $;

--| Every ordinal maps to a surreal number. (Contributed by RP, 21-Sep-2023.)
theorem onnoxpi (A2: class):
  $ wcel A2 con0 $ >
  $ wcel (cxp A2 (csn c2o)) csur $;

--| Ordinal zero maps to a surreal number. (Contributed by RP, 21-Sep-2023.)
theorem _0fno:
  $ wcel c0 csur $;

--| Ordinal one maps to a surreal number. (Contributed by RP, 21-Sep-2023.)
theorem _1fno:
  $ wcel (cxp c1o (csn c2o)) csur $;

--| Ordinal two maps to a surreal number. (Contributed by RP, 21-Sep-2023.)
theorem _2fno:
  $ wcel (cxp c2o (csn c2o)) csur $;

--| Ordinal three maps to a surreal number. (Contributed by RP, 21-Sep-2023.)
theorem _3fno:
  $ wcel (cxp c3o (csn c2o)) csur $;

--| Ordinal four maps to a surreal number. (Contributed by RP, 21-Sep-2023.)
theorem _4fno:
  $ wcel (cxp c4o (csn c2o)) csur $;

--| The functional image of a function value exists. (Contributed by RP, 31-Oct-2024.)
theorem fnimafnex (A2 B2 F G: class):
  $ wfn F B2 $ >
  $ wcel (cima F (cfv A2 G)) cvv $;

--| A successor is not a limit ordinal. (Contributed by RP, 13-Dec-2024.)
theorem nlimsuc (A2: class):
  $ wi (wcel A2 con0) (wn (wlim (csuc A2))) $;

--| 1 is not a limit ordinal. (Contributed by BTernaryTau, 1-Dec-2024.) (Proof shortened by RP, 13-Dec-2024.)
theorem nlim1NEW:
  $ wn (wlim c1o) $;

--| 2 is not a limit ordinal. (Contributed by BTernaryTau, 1-Dec-2024.) (Proof shortened by RP, 13-Dec-2024.)
theorem nlim2NEW:
  $ wn (wlim c2o) $;

--| 3 is not a limit ordinal. (Contributed by RP, 13-Dec-2024.)
theorem nlim3:
  $ wn (wlim c3o) $;

--| 4 is not a limit ordinal. (Contributed by RP, 13-Dec-2024.)
theorem nlim4:
  $ wn (wlim c4o) $;

--| Given ` A e. On ` , let ` A +o 1o ` be defined to be the union of ` A ` and ` { A } ` . Compare with ~ oa1suc . (Contributed by RP, 27-Sep-2023.)
theorem oa1un (A2: class):
  $ wi (wcel A2 con0) (wceq (co A2 c1o coa) (cun A2 (csn A2))) $;

--| ` A +o 1o ` is in ` On ` . (Contributed by RP, 27-Sep-2023.)
theorem oa1cl (A2: class):
  $ wi (wcel A2 con0) (wcel (co A2 c1o coa) con0) $;

--| 0 is a finite ordinal. See ~ peano1 . (Contributed by RP, 27-Sep-2023.)
theorem _0finon:
  $ wcel c0 (cin con0 cfn) $;

--| 1 is a finite ordinal. See ~ 1onn . (Contributed by RP, 27-Sep-2023.)
theorem _1finon:
  $ wcel c1o (cin con0 cfn) $;

--| 2 is a finite ordinal. See ~ 1onn . (Contributed by RP, 27-Sep-2023.)
theorem _2finon:
  $ wcel c2o (cin con0 cfn) $;

--| 3 is a finite ordinal. See ~ 1onn . (Contributed by RP, 27-Sep-2023.)
theorem _3finon:
  $ wcel c3o (cin con0 cfn) $;

--| 4 is a finite ordinal. See ~ 1onn . (Contributed by RP, 27-Sep-2023.)
theorem _4finon:
  $ wcel c4o (cin con0 cfn) $;

--| The finite ordinals are closed under the add one operation. (Contributed by RP, 27-Sep-2023.)
theorem finona1cl (N: class):
  $ wi (wcel N (cin con0 cfn)) (wcel (co N c1o coa) (cin con0 cfn)) $;

--| The finite ordinals are a set. See also ~ onprc and ~ fiprc for proof that ` On ` and ` Fin ` are proper classes. (Contributed by RP, 27-Sep-2023.)
theorem finonex:
  $ wcel (cin con0 cfn) cvv $;

--| Union of two adjacent finite sets of sequential integers that share a common endpoint. (Suggested by NM, 21-Jul-2005.) (Contributed by RP, 14-Dec-2024.)
theorem fzunt (K M N: class):
  $ wi (wa (w3a (wcel K cz) (wcel M cz) (wcel N cz)) (wa (wbr K M cle) (wbr M N cle))) (wceq (cun (co K M cfz) (co M N cfz)) (co K N cfz)) $;

--| Union of two adjacent finite sets of sequential integers that share a common endpoint. (Contributed by RP, 14-Dec-2024.)
theorem fzuntd (ph: wff) (K M N: class):
  $ wi ph (wcel K cz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wbr K M cle) $ >
  $ wi ph (wbr M N cle) $ >
  $ wi ph (wceq (cun (co K M cfz) (co M N cfz)) (co K N cfz)) $;

--| Union of two overlapping finite sets of sequential integers. (Contributed by RP, 14-Dec-2024.)
theorem fzunt1d (ph: wff) (K L M N: class):
  $ wi ph (wcel K cz) $ >
  $ wi ph (wcel L cz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wbr K M cle) $ >
  $ wi ph (wbr M L cle) $ >
  $ wi ph (wbr L N cle) $ >
  $ wi ph (wceq (cun (co K L cfz) (co M N cfz)) (co K N cfz)) $;

--| Union of two adjacent or overlapping finite sets of sequential integers. (Contributed by RP, 14-Dec-2024.)
theorem fzuntgd (ph: wff) (K L M N: class):
  $ wi ph (wcel K cz) $ >
  $ wi ph (wcel L cz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wbr K M cle) $ >
  $ wi ph (wbr M (co L c1 caddc) cle) $ >
  $ wi ph (wbr L N cle) $ >
  $ wi ph (wceq (cun (co K L cfz) (co M N cfz)) (co K N cfz)) $;

--| Conjunction of conditional logical operators. (Contributed by RP, 18-Apr-2020.)
theorem ifpan123g (ph ps ch th ta et: wff):
  $ wb (wa (wif ph ch ta) (wif ps th et)) (wa (wa (wo (wn ph) ch) (wo ph ta)) (wa (wo (wn ps) th) (wo ps et))) $;

--| Conjunction of conditional logical operators. (Contributed by RP, 20-Apr-2020.)
theorem ifpan23 (ph ps ch th ta: wff):
  $ wb (wa (wif ph ps ch) (wif ph th ta)) (wif ph (wa ps th) (wa ch ta)) $;

--| Define or in terms of conditional logic operator. (Contributed by RP, 20-Apr-2020.)
theorem ifpdfor2 (ph ps: wff):
  $ wb (wo ph ps) (wif ph ph ps) $;

--| Corollary of commutation of or. (Contributed by RP, 20-Apr-2020.)
theorem ifporcor (ph ps: wff):
  $ wb (wif ph ph ps) (wif ps ps ph) $;

--| Define and with conditional logic operator. (Contributed by RP, 25-Apr-2020.)
theorem ifpdfan2 (ph ps: wff):
  $ wb (wa ph ps) (wif ph ps ph) $;

--| Corollary of commutation of and. (Contributed by RP, 25-Apr-2020.)
theorem ifpancor (ph ps: wff):
  $ wb (wif ph ps ph) (wif ps ph ps) $;

--| Define or in terms of conditional logic operator and true. (Contributed by RP, 20-Apr-2020.)
theorem ifpdfor (ph ps: wff):
  $ wb (wo ph ps) (wif ph wtru ps) $;

--| Define and with conditional logic operator and false. (Contributed by RP, 20-Apr-2020.)
theorem ifpdfan (ph ps: wff):
  $ wb (wa ph ps) (wif ph ps wfal) $;

--| Equivalence theorem for conditional logical operators. (Contributed by RP, 14-Apr-2020.)
theorem ifpbi2 (ph ps ch th: wff):
  $ wi (wb ph ps) (wb (wif ch ph th) (wif ch ps th)) $;

--| Equivalence theorem for conditional logical operators. (Contributed by RP, 14-Apr-2020.)
theorem ifpbi3 (ph ps ch th: wff):
  $ wi (wb ph ps) (wb (wif ch th ph) (wif ch th ps)) $;

--| Restate implication as conditional logic operator. (Contributed by RP, 20-Apr-2020.)
theorem ifpim1 (ph ps: wff):
  $ wb (wi ph ps) (wif (wn ph) wtru ps) $;

--| Restate negated wff as conditional logic operator. (Contributed by RP, 20-Apr-2020.)
theorem ifpnot (ph: wff):
  $ wb (wn ph) (wif ph wfal wtru) $;

--| Restate wff as conditional logic operator. (Contributed by RP, 20-Apr-2020.)
theorem ifpid2 (ph: wff):
  $ wb ph (wif ph wtru wfal) $;

--| Restate implication as conditional logic operator. (Contributed by RP, 20-Apr-2020.)
theorem ifpim2 (ph ps: wff):
  $ wb (wi ph ps) (wif ps wtru (wn ph)) $;

--| Equivalence theorem for conditional logical operators. (Contributed by RP, 15-Apr-2020.)
theorem ifpbi23 (ph ps ch th ta: wff):
  $ wi (wa (wb ph ps) (wb ch th)) (wb (wif ta ph ch) (wif ta ps th)) $;

--| Restatement of ~ biid . (Contributed by RP, 25-Apr-2020.)
theorem ifpbiidcor (ph: wff):
  $ wif ph ph (wn ph) $;

--| Corollary of commutation of biconditional. (Contributed by RP, 25-Apr-2020.)
theorem ifpbicor (ph ps: wff):
  $ wb (wif ph ps (wn ps)) (wif ps ph (wn ph)) $;

--| Corollary of commutation of biconditional. (Contributed by RP, 25-Apr-2020.)
theorem ifpxorcor (ph ps: wff):
  $ wb (wif ph (wn ps) ps) (wif ps (wn ph) ph) $;

--| Equivalence theorem for conditional logical operators. (Contributed by RP, 14-Apr-2020.)
theorem ifpbi1 (ph ps ch th: wff):
  $ wi (wb ph ps) (wb (wif ph ch th) (wif ps ch th)) $;

--| Negation of conditional logical operator. (Contributed by RP, 18-Apr-2020.)
theorem ifpnot23 (ph ps ch: wff):
  $ wb (wn (wif ph ps ch)) (wif ph (wn ps) (wn ch)) $;

--| Factor conditional logic operator over negation in terms 2 and 3. (Contributed by RP, 21-Apr-2020.)
theorem ifpnotnotb (ph ps ch: wff):
  $ wb (wif ph (wn ps) (wn ch)) (wn (wif ph ps ch)) $;

--| Corollary of commutation of nor. (Contributed by RP, 25-Apr-2020.)
theorem ifpnorcor (ph ps: wff):
  $ wb (wif ph (wn ph) (wn ps)) (wif ps (wn ps) (wn ph)) $;

--| Corollary of commutation of and. (Contributed by RP, 25-Apr-2020.)
theorem ifpnancor (ph ps: wff):
  $ wb (wif ph (wn ps) (wn ph)) (wif ps (wn ph) (wn ps)) $;

--| Negation of conditional logical operator. (Contributed by RP, 25-Apr-2020.)
theorem ifpnot23b (ph ps ch: wff):
  $ wb (wn (wif ph (wn ps) ch)) (wif ph ps (wn ch)) $;

--| Restatement of ~ biid . (Contributed by RP, 25-Apr-2020.)
theorem ifpbiidcor2 (ph: wff):
  $ wn (wif ph (wn ph) ph) $;

--| Negation of conditional logical operator. (Contributed by RP, 25-Apr-2020.)
theorem ifpnot23c (ph ps ch: wff):
  $ wb (wn (wif ph ps (wn ch))) (wif ph (wn ps) ch) $;

--| Negation of conditional logical operator. (Contributed by RP, 25-Apr-2020.)
theorem ifpnot23d (ph ps ch: wff):
  $ wb (wn (wif ph (wn ps) (wn ch))) (wif ph ps ch) $;

--| Define nand as conditional logic operator. (Contributed by RP, 20-Apr-2020.)
theorem ifpdfnan (ph ps: wff):
  $ wb (wnan ph ps) (wif ph (wn ps) wtru) $;

--| Define xor as conditional logic operator. (Contributed by RP, 20-Apr-2020.)
theorem ifpdfxor (ph ps: wff):
  $ wb (wxo ph ps) (wif ph (wn ps) ps) $;

--| Equivalence theorem for conditional logical operators. (Contributed by RP, 15-Apr-2020.)
theorem ifpbi12 (ph ps ch th ta: wff):
  $ wi (wa (wb ph ps) (wb ch th)) (wb (wif ph ch ta) (wif ps th ta)) $;

--| Equivalence theorem for conditional logical operators. (Contributed by RP, 15-Apr-2020.)
theorem ifpbi13 (ph ps ch th ta: wff):
  $ wi (wa (wb ph ps) (wb ch th)) (wb (wif ph ta ch) (wif ps ta th)) $;

--| Equivalence theorem for conditional logical operators. (Contributed by RP, 15-Apr-2020.)
theorem ifpbi123 (ph ps ch th ta et: wff):
  $ wi (w3a (wb ph ps) (wb ch th) (wb ta et)) (wb (wif ph ch ta) (wif ps th et)) $;

--| Restate wff as conditional logic operator. (Contributed by RP, 20-Apr-2020.)
theorem ifpidg (ph ps ch th: wff):
  $ wb (wb th (wif ph ps ch)) (wa (wa (wi (wa ph ps) th) (wi (wa ph th) ps)) (wa (wi ch (wo ph th)) (wi th (wo ph ch)))) $;

--| Restate wff as conditional logic operator. (Contributed by RP, 20-Apr-2020.)
theorem ifpid3g (ph ps ch: wff):
  $ wb (wb ch (wif ph ps ch)) (wa (wi (wa ph ps) ch) (wi (wa ph ch) ps)) $;

--| Restate wff as conditional logic operator. (Contributed by RP, 20-Apr-2020.)
theorem ifpid2g (ph ps ch: wff):
  $ wb (wb ps (wif ph ps ch)) (wa (wi ps (wo ph ch)) (wi ch (wo ph ps))) $;

--| Restate wff as conditional logic operator. (Contributed by RP, 20-Apr-2020.)
theorem ifpid1g (ph ps ch: wff):
  $ wb (wb ph (wif ph ps ch)) (wa (wi ch ph) (wi ph ps)) $;

--| Restate implication as conditional logic operator. (Contributed by RP, 25-Apr-2020.)
theorem ifpim23g (ph ps ch: wff):
  $ wb (wb (wi ph ps) (wif ch ps (wn ph))) (wa (wi (wa ph ps) ch) (wi ch (wo ph ps))) $;

--| Restate implication as conditional logic operator. (Contributed by RP, 25-Apr-2020.)
theorem ifpim3 (ph ps: wff):
  $ wb (wi ph ps) (wif ph ps (wn ph)) $;

--| Restate negated implication as conditional logic operator. (Contributed by RP, 25-Apr-2020.)
theorem ifpnim1 (ph ps: wff):
  $ wb (wn (wi ph ps)) (wif ph (wn ps) ph) $;

--| Restate implication as conditional logic operator. (Contributed by RP, 25-Apr-2020.)
theorem ifpim4 (ph ps: wff):
  $ wb (wi ph ps) (wif ps ps (wn ph)) $;

--| Restate negated implication as conditional logic operator. (Contributed by RP, 25-Apr-2020.)
theorem ifpnim2 (ph ps: wff):
  $ wb (wn (wi ph ps)) (wif ps (wn ps) ph) $;

--| Implication of conditional logical operators. The right hand side is basically conjunctive normal form which is useful in proofs. (Contributed by RP, 16-Apr-2020.)
theorem ifpim123g (ph ps ch th ta et: wff):
  $ wb (wi (wif ph ch ta) (wif ps th et)) (wa (wa (wo (wi ph (wn ps)) (wi ch th)) (wo (wi ps ph) (wi ta th))) (wa (wo (wi ph ps) (wi ch et)) (wo (wi (wn ps) ph) (wi ta et)))) $;

--| Implication of conditional logical operators. (Contributed by RP, 18-Apr-2020.)
theorem ifpim1g (ph ps ch th: wff):
  $ wb (wi (wif ph ch th) (wif ps ch th)) (wa (wo (wi ps ph) (wi th ch)) (wo (wi ph ps) (wi ch th))) $;

--| Substitute the first element of conditional logical operator. (Contributed by RP, 20-Apr-2020.)
theorem ifp1bi (ph ps ch th: wff):
  $ wb (wb (wif ph ch th) (wif ps ch th)) (wa (wa (wo (wi ph ps) (wi ch th)) (wo (wi ph ps) (wi th ch))) (wa (wo (wi ps ph) (wi ch th)) (wo (wi ps ph) (wi th ch)))) $;

--| When the first variable is irrelevant, it can be replaced. (Contributed by RP, 25-Apr-2020.)
theorem ifpbi1b (ph ps ch: wff):
  $ wb (wif ph ch ch) (wif ps ch ch) $;

--| Factor conditional logic operator over implication in terms 2 and 3. (Contributed by RP, 21-Apr-2020.)
theorem ifpimimb (ph ps ch th ta: wff):
  $ wb (wif ph (wi ps ch) (wi th ta)) (wi (wif ph ps th) (wif ph ch ta)) $;

--| Factor conditional logic operator over disjunction in terms 2 and 3. (Contributed by RP, 21-Apr-2020.)
theorem ifpororb (ph ps ch th ta: wff):
  $ wb (wif ph (wo ps ch) (wo th ta)) (wo (wif ph ps th) (wif ph ch ta)) $;

--| Factor conditional logic operator over conjunction in terms 2 and 3. (Contributed by RP, 21-Apr-2020.)
theorem ifpananb (ph ps ch th ta: wff):
  $ wb (wif ph (wa ps ch) (wa th ta)) (wa (wif ph ps th) (wif ph ch ta)) $;

--| Factor conditional logic operator over nand in terms 2 and 3. (Contributed by RP, 21-Apr-2020.)
theorem ifpnannanb (ph ps ch th ta: wff):
  $ wb (wif ph (wnan ps ch) (wnan th ta)) (wnan (wif ph ps th) (wif ph ch ta)) $;

--| Disjunction of conditional logical operators. (Contributed by RP, 18-Apr-2020.)
theorem ifpor123g (ph ps ch th ta et: wff):
  $ wb (wo (wif ph ch ta) (wif ps th et)) (wa (wa (wo (wi ph (wn ps)) (wo ch th)) (wo (wi ps ph) (wo ta th))) (wa (wo (wi ph ps) (wo ch et)) (wo (wi (wn ps) ph) (wo ta et)))) $;

--| Consequnce of implication. (Contributed by RP, 17-Apr-2020.)
theorem ifpimim (ph ps ch th ta: wff):
  $ wi (wif ph (wi ps ch) (wi th ta)) (wi (wif ph ps th) (wif ph ch ta)) $;

--| Factor conditional logic operator over biconditional in terms 2 and 3. (Contributed by RP, 21-Apr-2020.)
theorem ifpbibib (ph ps ch th ta: wff):
  $ wb (wif ph (wb ps ch) (wb th ta)) (wb (wif ph ps th) (wif ph ch ta)) $;

--| Factor conditional logic operator over xor in terms 2 and 3. (Contributed by RP, 21-Apr-2020.)
theorem ifpxorxorb (ph ps ch th ta: wff):
  $ wb (wif ph (wxo ps ch) (wxo th ta)) (wxo (wif ph ps th) (wif ph ch ta)) $;

--| A special case where implication appears to conform to a mixed associative law. (Contributed by RP, 29-Feb-2020.)
theorem rp_fakeimass (ph ps ch: wff):
  $ wb (wo ph ch) (wb (wi (wi ph ps) ch) (wi ph (wi ps ch))) $;

--| A special case where a mixture of and and or appears to conform to a mixed associative law. (Contributed by RP, 26-Feb-2020.)
theorem rp_fakeanorass (ph ps ch: wff):
  $ wb (wi ch ph) (wb (wo (wa ph ps) ch) (wa ph (wo ps ch))) $;

--| A special case where a mixture of or and and appears to conform to a mixed associative law. (Contributed by RP, 29-Feb-2020.)
theorem rp_fakeoranass (ph ps ch: wff):
  $ wb (wi ph ch) (wb (wa (wo ph ps) ch) (wo ph (wa ps ch))) $;

--| A special case where a mixture of intersection and union appears to conform to a mixed associative law. (Contributed by RP, 26-Feb-2020.)
theorem rp_fakeinunass (A2 B2 C: class):
  $ wb (wss C A2) (wceq (cun (cin A2 B2) C) (cin A2 (cun B2 C))) $;

--| A special case where a mixture of union and intersection appears to conform to a mixed associative law. (Contributed by RP, 29-Feb-2020.)
theorem rp_fakeuninass (A2 B2 C: class):
  $ wb (wss A2 C) (wceq (cin (cun A2 B2) C) (cun A2 (cin B2 C))) $;

--| A set is said to be finite if it can be put in one-to-one correspondence with all the natural numbers between 1 and some ` n e. NN0 ` . (Contributed by RP, 3-Mar-2020.)
theorem rp_isfinite5 {n: setvar} (A2: class):
  $ wb (wcel A2 cfn) (wrex n (wbr (co c1 (cv n) cfz) A2 cen) cn0) $;

--| A set is said to be finite if it is either empty or it can be put in one-to-one correspondence with all the natural numbers between 1 and some ` n e. NN ` . (Contributed by RP, 10-Mar-2020.)
theorem rp_isfinite6 {n: setvar} (A2: class):
  $ wb (wcel A2 cfn) (wo (wceq A2 c0) (wrex n (wbr (co c1 (cv n) cfz) A2 cen) cn)) $;

--| When for each element ` y ` there is a subset ` A ` which may substituted for ` x ` such that ` y ` satisfying ` ch ` implies ` x ` satisfies ` ps ` then the intersection of all ` x ` that satisfy ` ps ` is a subclass the intersection of all ` y ` that satisfy ` ch ` . (Contributed by RP, 17-Oct-2020.)
theorem intabssd {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (A2: class y1) (V: class x3 y1):
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wi ch ps) $ >
  $ wi ph (wss A2 (cv y1)) $ >
  $ wi ph (wss (cint (cab x3 ps)) (cint (cab y1 ch))) $;

--| There is only one empty set. (Contributed by RP, 1-Oct-2023.)
theorem eu0 {x3 y1: setvar}:
  $ wa (wal x3 (wn (wcel (cv x3) c0))) (weu x3 (wal y1 (wn (wcel (cv y1) (cv x3))))) $;

--| Over the ordinal numbers, one may define the relation ` A _E B ` iff ` A e. B ` and one finds that, under this ordering, ` On ` is a well-ordered class, see ~ epweon . This is a weak form of ~ epelg which only requires that we know ` B ` to be a set. (Contributed by RP, 27-Sep-2023.)
theorem epelon2 (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wb (wbr A2 B2 cep) (wcel A2 B2)) $;

--| For all ` x , y e. On ` , one and only one of the following hold: ` x e. y ` , ` y = x ` , or ` y e. x ` . This is a transparent strict trichotomy. (Contributed by RP, 27-Sep-2023.)
theorem ontric3g {x3 y1: setvar}:
  $ wral x3 (wral y1 (w3a (wb (wcel (cv x3) (cv y1)) (wn (wo (wceq (cv y1) (cv x3)) (wcel (cv y1) (cv x3))))) (wb (wceq (cv y1) (cv x3)) (wn (wo (wcel (cv x3) (cv y1)) (wcel (cv y1) (cv x3))))) (wb (wcel (cv y1) (cv x3)) (wn (wo (wcel (cv x3) (cv y1)) (wceq (cv y1) (cv x3)))))) con0) con0 $;

--| ` A ` is called a successor ordinal if it is not a limit ordinal and not the empty set. (Contributed by RP, 11-Nov-2023.)
theorem dfsucon {x3: setvar} (A2: class):
  $ wb (w3a (word A2) (wn (wlim A2)) (wne A2 c0)) (wrex x3 (wceq A2 (csuc (cv x3))) con0) $;

--| A singleton is equinumerous to ordinal one iff its content is a set. (Contributed by RP, 8-Oct-2023.)
theorem snen1g (A2: class):
  $ wb (wbr (csn A2) c1o cen) (wcel A2 cvv) $;

--| A singleton is equinumerous to ordinal one if its content is an element of it. (Contributed by RP, 8-Oct-2023.)
theorem snen1el (A2: class):
  $ wb (wbr (csn A2) c1o cen) (wcel A2 (csn A2)) $;

--| A singleton is dominated by ordinal one. (Contributed by RP, 29-Oct-2023.)
theorem sn1dom (A2: class):
  $ wbr (csn A2) c1o cdom $;

--| An unordered pair is dominated by ordinal two. (Contributed by RP, 29-Oct-2023.)
theorem pr2dom (A2 B2: class):
  $ wbr (cpr A2 B2) c2o cdom $;

--| An unordered triple is dominated by ordinal three. (Contributed by RP, 29-Oct-2023.)
theorem tr3dom (A2 B2 C: class):
  $ wbr (ctp A2 B2 C) c3o cdom $;

--| A class equinumerous to a successor is never empty. (Contributed by RP, 11-Nov-2023.) (Proof shortened by SN, 16-Nov-2023.)
theorem ensucne0 (A2 B2: class):
  $ wi (wbr A2 (csuc B2) cen) (wne A2 c0) $;

--| A class equinumerous to a successor is never empty. (Contributed by RP, 11-Nov-2023.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ensucne0OLD (A2 B2: class):
  $ wi (wbr A2 (csuc B2) cen) (wne A2 c0) $;

--| Let ` _om ` be defined to be the union of the set of all finite ordinals. (Contributed by RP, 27-Sep-2023.)
theorem dfom6:
  $ wceq com (cuni (cin con0 cfn)) $;

--| ` _om ` is the smallest infinite ordinal. (Contributed by RP, 27-Sep-2023.)
theorem infordmin {x3: setvar}:
  $ wral x3 (wss com (cv x3)) (cdif con0 cfn) $;

--| Two ways to express the property of being a cardinal number. (Contributed by RP, 8-Nov-2023.)
theorem iscard4 (A2: class):
  $ wb (wceq (cfv A2 ccrd) A2) (wcel A2 (crn ccrd)) $;

--| Given any cardinal number ` A ` , there exists an argument ` x ` , which yields the least regular uncountable value of ` aleph ` which is greater to or equal to ` A ` . This proof uses AC. (Contributed by RP, 23-Nov-2023.)
theorem minregex {x3 y1: setvar} (A2: class):
  $ wi (wcel A2 (cdif (crn ccrd) com)) (wrex x3 (wceq (cv x3) (cint (crab y1 (w3a (wcel c0 (cv y1)) (wss A2 (cfv (cv y1) cale)) (wceq (cfv (cfv (cv y1) cale) ccf) (cfv (cv y1) cale))) con0))) con0) $;

--| Given any cardinal number ` A ` , there exists an argument ` x ` , which yields the least regular uncountable value of ` aleph ` which dominates ` A ` . This proof uses AC. (Contributed by RP, 24-Nov-2023.)
theorem minregex2 {x3 y1: setvar} (A2: class):
  $ wi (wcel A2 (cdif (crn ccrd) com)) (wrex x3 (wceq (cv x3) (cint (crab y1 (w3a (wcel c0 (cv y1)) (wbr A2 (cfv (cv y1) cale) cdom) (wceq (cfv (cfv (cv y1) cale) ccf) (cfv (cv y1) cale))) con0))) con0) $;

--| Two ways to express the property of being a cardinal number. (Contributed by RP, 8-Nov-2023.)
theorem iscard5 {x3: setvar} (A2: class):
  $ wb (wceq (cfv A2 ccrd) A2) (wa (wcel A2 con0) (wral x3 (wn (wbr (cv x3) A2 cen)) A2)) $;

--| Let us define a cardinal number to be an element ` A e. On ` such that ` A ` is not equipotent with any ` x e. A ` . (Contributed by RP, 1-Oct-2023.)
theorem elrncard {x3: setvar} (A2: class):
  $ wb (wcel A2 (crn ccrd)) (wa (wcel A2 con0) (wral x3 (wn (wbr (cv x3) A2 cen)) A2)) $;

--| ` ( har `` A ) ` is the least cardinal that is greater than ` A ` . (Contributed by RP, 4-Nov-2023.)
theorem harval3 {x3: setvar} (A2: class):
  $ wi (wcel A2 (cdm ccrd)) (wceq (cfv A2 char) (cint (crab x3 (wbr A2 (cv x3) csdm) (crn ccrd)))) $;

--| For any ordinal number ` A ` let ` ( har `` A ) ` denote the least cardinal that is greater than ` A ` . (Contributed by RP, 4-Nov-2023.)
theorem harval3on {x3: setvar} (A2: class):
  $ wi (wcel A2 con0) (wceq (cfv A2 char) (cint (crab x3 (wbr A2 (cv x3) csdm) (crn ccrd)))) $;

--| All natural numbers are cardinals. (Contributed by RP, 1-Oct-2023.)
theorem omssrncard:
  $ wss com (crn ccrd) $;

--| 0 is a cardinal number. (Contributed by RP, 1-Oct-2023.)
theorem _0iscard:
  $ wcel c0 (crn ccrd) $;

--| 1 is a cardinal number. (Contributed by RP, 1-Oct-2023.)
theorem _1iscard:
  $ wcel c1o (crn ccrd) $;

--| ` _om ` is a cardinal number. (Contributed by RP, 1-Oct-2023.)
theorem omiscard:
  $ wcel com (crn ccrd) $;

--| ` _om +o 1o ` is not a cardinal number. (Contributed by RP, 1-Oct-2023.)
theorem sucomisnotcard:
  $ wn (wcel (co com c1o coa) (crn ccrd)) $;

--| For any natural number, the add one operation is results in a cardinal number. (Contributed by RP, 1-Oct-2023.)
theorem nna1iscard (N: class):
  $ wi (wcel N com) (wcel (co N c1o coa) (crn ccrd)) $;

--| The least cardinal greater than 2 is 3. (Contributed by RP, 5-Nov-2023.)
theorem har2o:
  $ wceq (cfv c2o char) c3o $;

--| A class is equinumerous to ordinal two iff it is a pair of distinct sets. (Contributed by RP, 11-Oct-2023.)
theorem en2pr {x3 y1: setvar} (A2: class):
  $ wb (wbr A2 c2o cen) (wex x3 (wex y1 (wa (wceq A2 (cpr (cv x3) (cv y1))) (wne (cv x3) (cv y1))))) $;

--| If an unordered pair is equinumerous to ordinal two, then both parts are sets. (Contributed by RP, 8-Oct-2023.)
theorem pr2cv (A2 B2: class):
  $ wi (wbr (cpr A2 B2) c2o cen) (wa (wcel A2 cvv) (wcel B2 cvv)) $;

--| If an unordered pair is equinumerous to ordinal two, then a part is a member. (Contributed by RP, 21-Oct-2023.)
theorem pr2el1 (A2 B2: class):
  $ wi (wbr (cpr A2 B2) c2o cen) (wcel A2 (cpr A2 B2)) $;

--| If an unordered pair is equinumerous to ordinal two, then a part is a set. (Contributed by RP, 21-Oct-2023.)
theorem pr2cv1 (A2 B2: class):
  $ wi (wbr (cpr A2 B2) c2o cen) (wcel A2 cvv) $;

--| If an unordered pair is equinumerous to ordinal two, then a part is a member. (Contributed by RP, 21-Oct-2023.)
theorem pr2el2 (A2 B2: class):
  $ wi (wbr (cpr A2 B2) c2o cen) (wcel B2 (cpr A2 B2)) $;

--| If an unordered pair is equinumerous to ordinal two, then a part is a set. (Contributed by RP, 21-Oct-2023.)
theorem pr2cv2 (A2 B2: class):
  $ wi (wbr (cpr A2 B2) c2o cen) (wcel B2 cvv) $;

--| An unordered pair is equinumerous to ordinal two iff both parts are sets not equal to each other. (Contributed by RP, 8-Oct-2023.)
theorem pren2 (A2 B2: class):
  $ wb (wbr (cpr A2 B2) c2o cen) (w3a (wcel A2 cvv) (wcel B2 cvv) (wne A2 B2)) $;

--| If an unordered pair is equinumerous to ordinal two, then a part is an element of the difference of the pair and the singleton of the other part. (Contributed by RP, 21-Oct-2023.)
theorem pr2eldif1 (A2 B2: class):
  $ wi (wbr (cpr A2 B2) c2o cen) (wcel A2 (cdif (cpr A2 B2) (csn B2))) $;

--| If an unordered pair is equinumerous to ordinal two, then a part is an element of the difference of the pair and the singleton of the other part. (Contributed by RP, 21-Oct-2023.)
theorem pr2eldif2 (A2 B2: class):
  $ wi (wbr (cpr A2 B2) c2o cen) (wcel B2 (cdif (cpr A2 B2) (csn A2))) $;

--| A pair of two distinct sets is equinumerous to ordinal two. (Contributed by RP, 21-Oct-2023.)
theorem pren2d (ph: wff) (A2 B2 V W: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wbr (cpr A2 B2) c2o cen) $;

--| ` ( aleph `` 1o ) ` is the least uncountable ordinal. (Contributed by RP, 18-Nov-2023.)
theorem aleph1min {x3: setvar}:
  $ wceq (cfv c1o cale) (cint (crab x3 (wbr com (cv x3) csdm) con0)) $;

--| ` aleph ` is a strictly order-preserving mapping of ` On ` onto the class of all infinite cardinal numbers. (Contributed by RP, 18-Nov-2023.)
theorem alephiso2 {x3: setvar}:
  $ wiso con0 (crab x3 (wss com (cv x3)) (crn ccrd)) cep csdm cale $;

--| ` aleph ` is a strictly order-preserving mapping of ` On ` onto the class of all infinite cardinal numbers. (Contributed by RP, 18-Nov-2023.)
theorem alephiso3:
  $ wiso con0 (cdif (crn ccrd) com) cep csdm cale $;

--| The powerclass is an element of a class closed under union and powerclass operations iff the element is a member of that class. (Contributed by RP, 21-Mar-2020.)
theorem pwelg {x3: setvar} (A2 B2: class):
  $ wi (wral x3 (wa (wcel (cuni (cv x3)) B2) (wcel (cpw (cv x3)) B2)) B2) (wb (wcel A2 B2) (wcel (cpw A2) B2)) $;

--| The powerclass of an infinite set is an infinite set, and vice-versa. Here ` B ` is a class which is closed under both the union and the powerclass operations and which may have infinite sets as members. (Contributed by RP, 21-Mar-2020.)
theorem pwinfig {x3: setvar} (A2 B2: class):
  $ wi (wral x3 (wa (wcel (cuni (cv x3)) B2) (wcel (cpw (cv x3)) B2)) B2) (wb (wcel A2 (cdif B2 cfn)) (wcel (cpw A2) (cdif B2 cfn))) $;

--| The powerclass of an infinite set is an infinite set, and vice-versa. Here ` U ` is a weak universe. (Contributed by RP, 21-Mar-2020.)
theorem pwinfi2 (A2 U: class):
  $ wi (wcel U cwun) (wb (wcel A2 (cdif U cfn)) (wcel (cpw A2) (cdif U cfn))) $;

--| The powerclass of an infinite set is an infinite set, and vice-versa. Here ` T ` is a transitive Tarski universe. (Contributed by RP, 21-Mar-2020.)
theorem pwinfi3 (A2 T: class):
  $ wi (wa (wcel T ctsk) (wtr T)) (wb (wcel A2 (cdif T cfn)) (wcel (cpw A2) (cdif T cfn))) $;

--| The powerclass of an infinite set is an infinite set, and vice-versa. (Contributed by RP, 21-Mar-2020.)
theorem pwinfi (A2: class):
  $ wb (wcel A2 (cdif cvv cfn)) (wcel (cpw A2) (cdif cvv cfn)) $;

--| A definition of the finite intersection property of a class based on closure under pairwise intersection of its elements is independent of the dummy variables. (Contributed by RP, 1-Jan-2020.)
theorem fipjust {x3 y1 v u: setvar} (A2: class):
  $ wb (wral u (wral v (wcel (cin (cv u) (cv v)) A2) A2) A2) (wral x3 (wral y1 (wcel (cin (cv x3) (cv y1)) A2) A2) A2) $;

--| The class of all sets with property ` ph ( z ) ` is closed under the binary operation on sets defined in ` R ( x , y ) ` . (Contributed by RP, 3-Jan-2020.)
theorem cllem0 {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps ch th: wff x3 y1) (R: class x3 y1) (U: class x3 y1 z) (V: class x3 z):
  $ wceq V (cab z ph) $ >
  $ wcel R U $ >
  $ wi (wceq (cv z) R) (wb ph ps) $ >
  $ wi (wceq (cv z) (cv x3)) (wb ph ch) $ >
  $ wi (wceq (cv z) (cv y1)) (wb ph th) $ >
  $ wi (wa ch th) ps $ >
  $ wral x3 (wral y1 (wcel R V) V) V $;

--| The class of all supersets of a class has the finite intersection property. (Contributed by RP, 1-Jan-2020.) (Proof shortened by RP, 3-Jan-2020.)
theorem superficl {x3 y1 z: setvar} (A2: class x3 z) (B2: class x3 y1):
  $ wceq A2 (cab z (wss B2 (cv z))) $ >
  $ wral x3 (wral y1 (wcel (cin (cv x3) (cv y1)) A2) A2) A2 $;

--| The class of all supersets of a class is closed under binary union. (Contributed by RP, 3-Jan-2020.)
theorem superuncl {x3 y1 z: setvar} (A2: class x3 z) (B2: class x3 y1):
  $ wceq A2 (cab z (wss B2 (cv z))) $ >
  $ wral x3 (wral y1 (wcel (cun (cv x3) (cv y1)) A2) A2) A2 $;

--| The class of all subsets of a class has the finite intersection property. (Contributed by RP, 1-Jan-2020.) (Proof shortened by RP, 3-Jan-2020.)
theorem ssficl {x3 y1 z: setvar} (A2: class x3 z) (B2: class x3 y1):
  $ wceq A2 (cab z (wss (cv z) B2)) $ >
  $ wral x3 (wral y1 (wcel (cin (cv x3) (cv y1)) A2) A2) A2 $;

--| The class of all subsets of a class is closed under binary union. (Contributed by RP, 3-Jan-2020.)
theorem ssuncl {x3 y1 z: setvar} (A2: class x3 z) (B2: class x3 y1):
  $ wceq A2 (cab z (wss (cv z) B2)) $ >
  $ wral x3 (wral y1 (wcel (cun (cv x3) (cv y1)) A2) A2) A2 $;

--| The class of all subsets of a class is closed under class difference. (Contributed by RP, 3-Jan-2020.)
theorem ssdifcl {x3 y1 z: setvar} (A2: class x3 z) (B2: class x3 y1):
  $ wceq A2 (cab z (wss (cv z) B2)) $ >
  $ wral x3 (wral y1 (wcel (cdif (cv x3) (cv y1)) A2) A2) A2 $;

--| The class of all subsets of a class is closed under symmetric difference. (Contributed by RP, 3-Jan-2020.)
theorem sssymdifcl {x3 y1 z: setvar} (A2: class x3 z) (B2: class x3 y1):
  $ wceq A2 (cab z (wss (cv z) B2)) $ >
  $ wral x3 (wral y1 (wcel (cun (cdif (cv x3) (cv y1)) (cdif (cv y1) (cv x3))) A2) A2) A2 $;

--| If two classes have the finite intersection property, then so does their intersection. (Contributed by RP, 1-Jan-2020.)
theorem fiinfi {x3 y1: setvar} (ph: wff) (A2 B2 C: class):
  $ wi ph (wral x3 (wral y1 (wcel (cin (cv x3) (cv y1)) A2) A2) A2) $ >
  $ wi ph (wral x3 (wral y1 (wcel (cin (cv x3) (cv y1)) B2) B2) B2) $ >
  $ wi ph (wceq C (cin A2 B2)) $ >
  $ wi ph (wral x3 (wral y1 (wcel (cin (cv x3) (cv y1)) C) C) C) $;

--| Condition when restricted class is equal to unrestricted class. (Contributed by RP, 13-Aug-2020.)
theorem rababg {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wal x3 (wi ph (wcel (cv x3) A2))) (wceq (crab x3 ph A2) (cab x3 ph)) $;

--| Two ways of saying a set is an element of the intersection of a class with the intersection of a class. (Contributed by RP, 13-Aug-2020.)
theorem elinintab {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3):
  $ wb (wcel A2 (cin B2 (cint (cab x3 ph)))) (wa (wcel A2 B2) (wal x3 (wi ph (wcel A2 (cv x3))))) $;

--| Two ways to say a set is an element of the intersection of a class of images. (Contributed by RP, 16-Aug-2020.)
theorem elmapintrab {x3 w: setvar} (ph: wff x3) (A2 B2: class) (C: class x3) (V: class x3 w):
  $ wcel C cvv $ >
  $ wss C B2 $ >
  $ wi (wcel A2 V) (wb (wcel A2 (cint (crab w (wex x3 (wa (wceq (cv w) C) ph)) (cpw B2)))) (wa (wi (wex x3 ph) (wcel A2 B2)) (wal x3 (wi ph (wcel A2 C))))) $;

--| Two ways of saying a set is an element of the intersection of a class with the intersection of a class. (Contributed by RP, 14-Aug-2020.)
theorem elinintrab {x3 w: setvar} (ph: wff x3) (A2 B2: class) (V: class x3 w):
  $ wi (wcel A2 V) (wb (wcel A2 (cint (crab w (wex x3 (wa (wceq (cv w) (cin B2 (cv x3))) ph)) (cpw B2)))) (wa (wi (wex x3 ph) (wcel A2 B2)) (wal x3 (wi ph (wcel A2 (cv x3)))))) $;

--| Upper bound on intersection of class and the intersection of a class. (Contributed by RP, 13-Aug-2020.)
theorem inintabss {x3 w: setvar} (ph: wff x3) (A2: class):
  $ wss (cin A2 (cint (cab x3 ph))) (cint (crab w (wex x3 (wa (wceq (cv w) (cin A2 (cv x3))) ph)) (cpw A2))) $;

--| Value of the intersection of class with the intersection of a nonempty class. (Contributed by RP, 13-Aug-2020.)
theorem inintabd {x3 w: setvar} (ph: wff x3 w) (ps: wff x3) (A2: class):
  $ wi ph (wex x3 ps) $ >
  $ wi ph (wceq (cin A2 (cint (cab x3 ps))) (cint (crab w (wex x3 (wa (wceq (cv w) (cin A2 (cv x3))) ps)) (cpw A2)))) $;

--| Value of the intersection of Cartesian product with the intersection of a nonempty class. (Contributed by RP, 12-Aug-2020.)
theorem xpinintabd {x3 w: setvar} (ph: wff x3 w) (ps: wff x3) (A2 B2: class):
  $ wi ph (wex x3 ps) $ >
  $ wi ph (wceq (cin (cxp A2 B2) (cint (cab x3 ps))) (cint (crab w (wex x3 (wa (wceq (cv w) (cin (cxp A2 B2) (cv x3))) ps)) (cpw (cxp A2 B2))))) $;

--| If the intersection of a class is a relation, then the class is nonempty. (Contributed by RP, 12-Aug-2020.)
theorem relintabex {x3: setvar} (ph: wff x3):
  $ wi (wrel (cint (cab x3 ph))) (wex x3 ph) $;

--| Two ways of saying a set is an element of the converse of the converse of the intersection of a class. (Contributed by RP, 20-Aug-2020.)
theorem elcnvcnvintab {x3: setvar} (ph: wff x3) (A2: class):
  $ wb (wcel A2 (ccnv (ccnv (cint (cab x3 ph))))) (wa (wcel A2 (cxp cvv cvv)) (wal x3 (wi ph (wcel A2 (cv x3))))) $;

--| Value of the intersection of a class when it is a relation. (Contributed by RP, 12-Aug-2020.)
theorem relintab {x3 w: setvar} (ph: wff x3):
  $ wi (wrel (cint (cab x3 ph))) (wceq (cint (cab x3 ph)) (cint (crab w (wex x3 (wa (wceq (cv w) (ccnv (ccnv (cv x3)))) ph)) (cpw (cxp cvv cvv))))) $;

--| A non-relation is equal to the base class with all ordered pairs removed. (Contributed by RP, 25-Oct-2020.)
theorem nonrel (A2: class):
  $ wceq (cdif A2 (ccnv (ccnv A2))) (cdif A2 (cxp cvv cvv)) $;

--| Only an ordered pair where not both entries are sets could be an element of the non-relation part of class. (Contributed by RP, 25-Oct-2020.)
theorem elnonrel (A2 X Y: class):
  $ wb (wcel (cop X Y) (cdif A2 (ccnv (ccnv A2)))) (wa (wcel c0 A2) (wn (wa (wcel X cvv) (wcel Y cvv)))) $;

--| The non-relation part of a relation is empty. (Contributed by RP, 22-Oct-2020.)
theorem relnonrel (A2: class):
  $ wb (wrel A2) (wceq (cdif A2 (ccnv (ccnv A2))) c0) $;

--| The converse of the non-relation part of a class is empty. (Contributed by RP, 18-Oct-2020.)
theorem cnvnonrel (A2: class):
  $ wceq (ccnv (cdif A2 (ccnv (ccnv A2)))) c0 $;

--| A non-relation cannot relate any two classes. (Contributed by RP, 23-Oct-2020.)
theorem brnonrel (A2 U V X Y: class):
  $ wi (wa (wcel X U) (wcel Y V)) (wn (wbr X Y (cdif A2 (ccnv (ccnv A2))))) $;

--| The domain of the non-relation part of a class is empty. (Contributed by RP, 22-Oct-2020.)
theorem dmnonrel (A2: class):
  $ wceq (cdm (cdif A2 (ccnv (ccnv A2)))) c0 $;

--| The range of the non-relation part of a class is empty. (Contributed by RP, 22-Oct-2020.)
theorem rnnonrel (A2: class):
  $ wceq (crn (cdif A2 (ccnv (ccnv A2)))) c0 $;

--| A restriction of the non-relation part of a class is empty. (Contributed by RP, 22-Oct-2020.)
theorem resnonrel (A2 B2: class):
  $ wceq (cres (cdif A2 (ccnv (ccnv A2))) B2) c0 $;

--| An image under the non-relation part of a class is empty. (Contributed by RP, 22-Oct-2020.)
theorem imanonrel (A2 B2: class):
  $ wceq (cima (cdif A2 (ccnv (ccnv A2))) B2) c0 $;

--| Composition with the non-relation part of a class is empty. (Contributed by RP, 22-Oct-2020.)
theorem cononrel1 (A2 B2: class):
  $ wceq (ccom (cdif A2 (ccnv (ccnv A2))) B2) c0 $;

--| Composition with the non-relation part of a class is empty. (Contributed by RP, 22-Oct-2020.)
theorem cononrel2 (A2 B2: class):
  $ wceq (ccom A2 (cdif B2 (ccnv (ccnv B2)))) c0 $;

--| Two ways to say a set is an element of mapped intersection of a class. Here ` F ` maps elements of ` C ` to elements of ` |^| { x | ph } ` or ` x ` . (Contributed by RP, 19-Aug-2020.)
theorem elmapintab {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3) (C: class) (E: class x3) (F: class):
  $ wb (wcel A2 B2) (wa (wcel A2 C) (wcel (cfv A2 F) (cint (cab x3 ph)))) $ >
  $ wb (wcel A2 E) (wa (wcel A2 C) (wcel (cfv A2 F) (cv x3))) $ >
  $ wb (wcel A2 B2) (wa (wcel A2 C) (wal x3 (wi ph (wcel A2 E)))) $;

--| The function value of any class under a non-relation is empty. (Contributed by RP, 23-Oct-2020.)
theorem fvnonrel (A2 X: class):
  $ wceq (cfv X (cdif A2 (ccnv (ccnv A2)))) c0 $;

--| Two ways to say a set is a member of an intersection. (Contributed by RP, 19-Aug-2020.)
theorem elinlem (A2 B2 C: class):
  $ wb (wcel A2 (cin B2 C)) (wa (wcel A2 B2) (wcel (cfv A2 cid) C)) $;

--| Two ways to say a set is a member of the converse of the converse of a class. (Contributed by RP, 20-Aug-2020.)
theorem elcnvcnvlem (A2 B2: class):
  $ wb (wcel A2 (ccnv (ccnv B2))) (wa (wcel A2 (cxp cvv cvv)) (wcel (cfv A2 cid) B2)) $;

--| Value of the relationship content of the intersection of a class. (Contributed by RP, 20-Aug-2020.)
theorem cnvcnvintabd {x3 w: setvar} (ph: wff x3 w) (ps: wff x3):
  $ wi ph (wex x3 ps) $ >
  $ wi ph (wceq (ccnv (ccnv (cint (cab x3 ps)))) (cint (crab w (wex x3 (wa (wceq (cv w) (ccnv (ccnv (cv x3)))) ps)) (cpw (cxp cvv cvv))))) $;

--| Two ways to say a set is a member of the converse of a class. (Contributed by RP, 19-Aug-2020.)
theorem elcnvlem {x3: setvar} (A2 B2 F: class x3):
  $ wceq F (cmpt x3 (cxp cvv cvv) (cop (cfv (cv x3) c2nd) (cfv (cv x3) c1st))) $ >
  $ wb (wcel A2 (ccnv B2)) (wa (wcel A2 (cxp cvv cvv)) (wcel (cfv A2 F) B2)) $;

--| Two ways of saying a set is an element of the converse of the intersection of a class. (Contributed by RP, 19-Aug-2020.)
theorem elcnvintab {x3: setvar} (ph: wff x3) (A2: class):
  $ wb (wcel A2 (ccnv (cint (cab x3 ph)))) (wa (wcel A2 (cxp cvv cvv)) (wal x3 (wi ph (wcel A2 (ccnv (cv x3)))))) $;

--| Value of the converse of the intersection of a nonempty class. (Contributed by RP, 20-Aug-2020.)
theorem cnvintabd {x3 w: setvar} (ph: wff x3 w) (ps: wff x3):
  $ wi ph (wex x3 ps) $ >
  $ wi ph (wceq (ccnv (cint (cab x3 ps))) (cint (crab w (wex x3 (wa (wceq (cv w) (ccnv (cv x3))) ps)) (cpw (cxp cvv cvv))))) $;

--| Two ways of saying the identity relation restricted to the union of the domain and range of a relation is a subset of a relation. Generalization of ~ reflexg . (Contributed by RP, 26-Sep-2020.)
theorem undmrnresiss {x3 y1: setvar} (A2 B2: class):
  $ wb (wss (cres cid (cun (cdm A2) (crn A2))) B2) (wal x3 (wal y1 (wi (wbr (cv x3) (cv y1) A2) (wa (wbr (cv x3) (cv x3) B2) (wbr (cv y1) (cv y1) B2))))) $;

--| Two ways of saying a relation is reflexive over its domain and range. (Contributed by RP, 4-Aug-2020.)
theorem reflexg {x3 y1: setvar} (A2: class):
  $ wb (wss (cres cid (cun (cdm A2) (crn A2))) A2) (wal x3 (wal y1 (wi (wbr (cv x3) (cv y1) A2) (wa (wbr (cv x3) (cv x3) A2) (wbr (cv y1) (cv y1) A2))))) $;

--| A condition weaker than reflexivity. (Contributed by RP, 3-Aug-2020.)
theorem cnvssco {x3 y1 z: setvar} (A2 B2 C: class):
  $ wb (wss (ccnv A2) (ccnv (ccom B2 C))) (wal x3 (wal y1 (wex z (wi (wbr (cv x3) (cv y1) A2) (wa (wbr (cv x3) (cv z) C) (wbr (cv z) (cv y1) B2)))))) $;

--| Reflexive relations are subsets of their self-composition. (Contributed by RP, 4-Aug-2020.)
theorem refimssco (A2: class):
  $ wi (wss (cres cid (cun (cdm A2) (crn A2))) A2) (wss (ccnv A2) (ccnv (ccom A2 A2))) $;

--| Equality implies bijection. (Contributed by RP, 24-Jul-2020.)
theorem cleq2lem (ph ps: wff) (A2 B2 R: class):
  $ wi (wceq A2 B2) (wb ph ps) $ >
  $ wi (wceq A2 B2) (wb (wa (wss R A2) ph) (wa (wss R B2) ps)) $;

--| Change of bound variable in class of supersets of a with a property. (Contributed by RP, 24-Jul-2020.)
theorem cbvcllem {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (X: class):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wceq (cab x3 (wa (wss X (cv x3)) ph)) (cab y1 (wa (wss X (cv y1)) ps)) $;

--| If a superset ` Y ` of ` X ` possesses the property parameterized in ` x ` in ` ps ` , then ` Y ` is a superset of the closure of that property for the set ` X ` . (Contributed by RP, 23-Jul-2020.)
theorem clublem {x3: setvar} (ph ps: wff x3) (ch: wff) (X Y: class):
  $ wi ph (wcel Y cvv) $ >
  $ wi (wceq (cv x3) Y) (wb ps ch) $ >
  $ wi ph (wss X Y) $ >
  $ wi ph ch $ >
  $ wi ph (wss (cint (cab x3 (wa (wss X (cv x3)) ps))) Y) $;

--| The closure of a property is a superset of the closure of a less restrictive property. (Contributed by RP, 24-Jul-2020.)
theorem clss2lem {x3: setvar} (ph: wff) (ps ch: wff x3) (X: class x3):
  $ wi ph (wi ch ps) $ >
  $ wi ph (wss (cint (cab x3 (wa (wss X (cv x3)) ps))) (cint (cab x3 (wa (wss X (cv x3)) ch)))) $;

--| Definition of identity relation as the trivial closure. (Contributed by RP, 26-Jul-2020.)
theorem dfid7 {x3 y1: setvar}:
  $ wceq cid (cmpt x3 cvv (cint (cab y1 (wa (wss (cv x3) (cv y1)) wtru)))) $;

--| Show two versions of a closure with reflexive properties are equal. (Contributed by RP, 19-Oct-2020.)
theorem mptrcllem {x3 y1 z: setvar} (ph: wff y1) (ps: wff z) (ch th: wff x3 z) (ta: wff x3 y1) (V: class):
  $ wi (wcel (cv x3) V) (wcel (cint (cab y1 (wa (wss (cv x3) (cv y1)) (wa ph (wss (cres cid (cun (cdm (cv y1)) (crn (cv y1)))) (cv y1)))))) cvv) $ >
  $ wi (wcel (cv x3) V) (wcel (cint (cab z (wa (wss (cun (cv x3) (cres cid (cun (cdm (cv x3)) (crn (cv x3))))) (cv z)) ps))) cvv) $ >
  $ wi (wcel (cv x3) V) ch $ >
  $ wi (wcel (cv x3) V) th $ >
  $ wi (wcel (cv x3) V) ta $ >
  $ wi (wceq (cv y1) (cint (cab z (wa (wss (cun (cv x3) (cres cid (cun (cdm (cv x3)) (crn (cv x3))))) (cv z)) ps)))) (wb ph ch) $ >
  $ wi (wceq (cv y1) (cint (cab z (wa (wss (cun (cv x3) (cres cid (cun (cdm (cv x3)) (crn (cv x3))))) (cv z)) ps)))) (wb (wss (cres cid (cun (cdm (cv y1)) (crn (cv y1)))) (cv y1)) th) $ >
  $ wi (wceq (cv z) (cint (cab y1 (wa (wss (cv x3) (cv y1)) (wa ph (wss (cres cid (cun (cdm (cv y1)) (crn (cv y1)))) (cv y1))))))) (wb ps ta) $ >
  $ wceq (cmpt x3 V (cint (cab y1 (wa (wss (cv x3) (cv y1)) (wa ph (wss (cres cid (cun (cdm (cv y1)) (crn (cv y1)))) (cv y1))))))) (cmpt x3 V (cint (cab z (wa (wss (cun (cv x3) (cres cid (cun (cdm (cv x3)) (crn (cv x3))))) (cv z)) ps)))) $;

--| The intersection of a class is a transitive relation if membership in the class implies the member is a transitive relation. (Contributed by RP, 28-Oct-2020.)
theorem cotrintab {x3: setvar} (ph: wff x3):
  $ wi ph (wss (ccom (cv x3) (cv x3)) (cv x3)) $ >
  $ wss (ccom (cint (cab x3 ph)) (cint (cab x3 ph))) (cint (cab x3 ph)) $;

--| The reflexive closure of a set exists. (Contributed by RP, 27-Oct-2020.)
theorem rclexi {x3: setvar} (A2: class) (V: class x3):
  $ wcel A2 V $ >
  $ wcel (cint (cab x3 (wa (wss A2 (cv x3)) (wss (cres cid (cun (cdm (cv x3)) (crn (cv x3)))) (cv x3))))) cvv $;

--| Existence of relation implies existence of union with Cartesian product of domain and range. (Contributed by RP, 1-Nov-2020.)
theorem rtrclexlem (R V: class):
  $ wi (wcel R V) (wcel (cun R (cxp (cun (cdm R) (crn R)) (cun (cdm R) (crn R)))) cvv) $;

--| The reflexive-transitive closure of a set exists. (Contributed by RP, 1-Nov-2020.)
theorem rtrclex {x3: setvar} (A2: class):
  $ wb (wcel A2 cvv) (wcel (cint (cab x3 (wa (wss A2 (cv x3)) (wa (wss (ccom (cv x3) (cv x3)) (cv x3)) (wss (cres cid (cun (cdm (cv x3)) (crn (cv x3)))) (cv x3)))))) cvv) $;

--| If a relation exists then the transitive closure has an upper bound. (Contributed by RP, 24-Jul-2020.)
theorem trclubgNEW {x3: setvar} (ph: wff x3) (R: class):
  $ wi ph (wcel R cvv) $ >
  $ wi ph (wss (cint (cab x3 (wa (wss R (cv x3)) (wss (ccom (cv x3) (cv x3)) (cv x3))))) (cun R (cxp (cdm R) (crn R)))) $;

--| If a relation exists then the transitive closure has an upper bound. (Contributed by RP, 24-Jul-2020.)
theorem trclubNEW {x3: setvar} (ph: wff x3) (R: class):
  $ wi ph (wcel R cvv) $ >
  $ wi ph (wrel R) $ >
  $ wi ph (wss (cint (cab x3 (wa (wss R (cv x3)) (wss (ccom (cv x3) (cv x3)) (cv x3))))) (cxp (cdm R) (crn R))) $;

--| The transitive closure of a set exists. (Contributed by RP, 27-Oct-2020.)
theorem trclexi {x3: setvar} (A2: class) (V: class x3):
  $ wcel A2 V $ >
  $ wcel (cint (cab x3 (wa (wss A2 (cv x3)) (wss (ccom (cv x3) (cv x3)) (cv x3))))) cvv $;

--| The reflexive-transitive closure of a set exists. (Contributed by RP, 27-Oct-2020.)
theorem rtrclexi {x3: setvar} (A2: class) (V: class x3):
  $ wcel A2 V $ >
  $ wcel (cint (cab x3 (wa (wss A2 (cv x3)) (wa (wss (ccom (cv x3) (cv x3)) (cv x3)) (wss (cres cid (cun (cdm (cv x3)) (crn (cv x3)))) (cv x3)))))) cvv $;

--| When the property ` ps ` holds for a relation substituted for ` x ` , then the closure on that property is a relation if the base set is a relation. (Contributed by RP, 30-Jul-2020.)
theorem clrellem {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (X Y: class):
  $ wi ph (wcel Y cvv) $ >
  $ wi ph (wrel X) $ >
  $ wi (wceq (cv x3) (ccnv (ccnv Y))) (wb ps ch) $ >
  $ wi ph (wss X Y) $ >
  $ wi ph ch $ >
  $ wi ph (wrel (cint (cab x3 (wa (wss X (cv x3)) ps)))) $;

--| When ` A ` , an upper bound of the closure, exists and certain substitutions hold the converse of the closure is equal to the closure of the converse. (Contributed by RP, 18-Oct-2020.)
theorem clcnvlem {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch th: wff y1) (A2: class y1) (X: class):
  $ wi (wa ph (wceq (cv x3) (cun (ccnv (cv y1)) (cdif X (ccnv (ccnv X)))))) (wi ch ps) $ >
  $ wi (wa ph (wceq (cv y1) (ccnv (cv x3)))) (wi ps ch) $ >
  $ wi (wceq (cv x3) A2) (wb ps th) $ >
  $ wi ph (wss X A2) $ >
  $ wi ph (wcel A2 cvv) $ >
  $ wi ph th $ >
  $ wi ph (wceq (ccnv (cint (cab x3 (wa (wss X (cv x3)) ps)))) (cint (cab y1 (wa (wss (ccnv X) (cv y1)) ch)))) $;

--| The converse of the trivial closure is equal to the closure of the converse. (Contributed by RP, 18-Oct-2020.)
theorem cnvtrucl0 {x3 y1: setvar} (V X: class):
  $ wi (wcel X V) (wceq (ccnv (cint (cab x3 (wa (wss X (cv x3)) wtru)))) (cint (cab y1 (wa (wss (ccnv X) (cv y1)) wtru)))) $;

--| The converse of the reflexive closure is equal to the closure of the converse. (Contributed by RP, 18-Oct-2020.)
theorem cnvrcl0 {x3 y1: setvar} (V X: class):
  $ wi (wcel X V) (wceq (ccnv (cint (cab x3 (wa (wss X (cv x3)) (wss (cres cid (cun (cdm (cv x3)) (crn (cv x3)))) (cv x3)))))) (cint (cab y1 (wa (wss (ccnv X) (cv y1)) (wss (cres cid (cun (cdm (cv y1)) (crn (cv y1)))) (cv y1)))))) $;

--| The converse of the transitive closure is equal to the closure of the converse. (Contributed by RP, 18-Oct-2020.)
theorem cnvtrcl0 {x3 y1: setvar} (V X: class):
  $ wi (wcel X V) (wceq (ccnv (cint (cab x3 (wa (wss X (cv x3)) (wss (ccom (cv x3) (cv x3)) (cv x3)))))) (cint (cab y1 (wa (wss (ccnv X) (cv y1)) (wss (ccom (cv y1) (cv y1)) (cv y1)))))) $;

--| The domain of the transitive closure is equal to the domain of its base relation. (Contributed by RP, 1-Nov-2020.)
theorem dmtrcl {x3: setvar} (V: class x3) (X: class):
  $ wi (wcel X V) (wceq (cdm (cint (cab x3 (wa (wss X (cv x3)) (wss (ccom (cv x3) (cv x3)) (cv x3)))))) (cdm X)) $;

--| The range of the transitive closure is equal to the range of its base relation. (Contributed by RP, 1-Nov-2020.)
theorem rntrcl {x3: setvar} (V: class x3) (X: class):
  $ wi (wcel X V) (wceq (crn (cint (cab x3 (wa (wss X (cv x3)) (wss (ccom (cv x3) (cv x3)) (cv x3)))))) (crn X)) $;

--| Definition of reflexive-transitive closure as a standard closure. (Contributed by RP, 1-Nov-2020.)
theorem dfrtrcl5 {x3 y1: setvar}:
  $ wceq crtcl (cmpt x3 cvv (cint (cab y1 (wa (wss (cv x3) (cv y1)) (wa (wss (cres cid (cun (cdm (cv y1)) (crn (cv y1)))) (cv y1)) (wss (ccom (cv y1) (cv y1)) (cv y1))))))) $;

--| Equality implies bijection. (Contributed by RP, 5-May-2020.) (Proof modification is discouraged.)
theorem trcleq2lemRP (A2 B2 R: class):
  $ wi (wceq A2 B2) (wb (wa (wss R A2) (wss (ccom A2 A2) A2)) (wa (wss R B2) (wss (ccom B2 B2) B2))) $;

--| Two ways of saying a complex number does not lie on the positive real axis. Lemma for ~ sqrtcval . (Contributed by RP, 17-May-2024.)
theorem sqrtcvallem1 (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wb (wi (wceq (cfv A2 cim) cc0) (wbr (cfv A2 cre) cc0 cle)) (wn (wcel A2 crp))) $;

--| Alternate expression for the absolute value of a real number. Lemma for ~ sqrtcval . (Contributed by RP, 11-May-2024.)
theorem reabsifneg (A2: class):
  $ wi (wcel A2 cr) (wceq (cfv A2 cabs) (cif (wbr A2 cc0 clt) (cneg A2) A2)) $;

--| Alternate expression for the absolute value of a real number. (Contributed by RP, 11-May-2024.)
theorem reabsifnpos (A2: class):
  $ wi (wcel A2 cr) (wceq (cfv A2 cabs) (cif (wbr A2 cc0 cle) (cneg A2) A2)) $;

--| Alternate expression for the absolute value of a real number. (Contributed by RP, 11-May-2024.)
theorem reabsifpos (A2: class):
  $ wi (wcel A2 cr) (wceq (cfv A2 cabs) (cif (wbr cc0 A2 clt) A2 (cneg A2))) $;

--| Alternate expression for the absolute value of a real number. (Contributed by RP, 11-May-2024.)
theorem reabsifnneg (A2: class):
  $ wi (wcel A2 cr) (wceq (cfv A2 cabs) (cif (wbr cc0 A2 cle) A2 (cneg A2))) $;

--| Alternate expression for the absolute value of a real number. (Contributed by RP, 22-May-2024.)
theorem reabssgn (A2: class):
  $ wi (wcel A2 cr) (wceq (cfv A2 cabs) (co (cfv A2 csgn) A2 cmul)) $;

--| Equivalent to saying that the square of the imaginary component of the square root of a complex number is a nonnegative real number. Lemma for ~ sqrtcval . See ~ imsqrtval . (Contributed by RP, 11-May-2024.)
theorem sqrtcvallem2 (A2: class):
  $ wi (wcel A2 cc) (wbr cc0 (co (co (cfv A2 cabs) (cfv A2 cre) cmin) c2 cdiv) cle) $;

--| Equivalent to saying that the absolute value of the imaginary component of the square root of a complex number is a real number. Lemma for ~ sqrtcval , ~ sqrtcval2 , ~ resqrtval , and ~ imsqrtval . (Contributed by RP, 11-May-2024.)
theorem sqrtcvallem3 (A2: class):
  $ wi (wcel A2 cc) (wcel (cfv (co (co (cfv A2 cabs) (cfv A2 cre) cmin) c2 cdiv) csqrt) cr) $;

--| Equivalent to saying that the square of the real component of the square root of a complex number is a nonnegative real number. Lemma for ~ sqrtcval . See ~ resqrtval . (Contributed by RP, 11-May-2024.)
theorem sqrtcvallem4 (A2: class):
  $ wi (wcel A2 cc) (wbr cc0 (co (co (cfv A2 cabs) (cfv A2 cre) caddc) c2 cdiv) cle) $;

--| Equivalent to saying that the real component of the square root of a complex number is a real number. Lemma for ~ resqrtval and ~ imsqrtval . (Contributed by RP, 11-May-2024.)
theorem sqrtcvallem5 (A2: class):
  $ wi (wcel A2 cc) (wcel (cfv (co (co (cfv A2 cabs) (cfv A2 cre) caddc) c2 cdiv) csqrt) cr) $;

--| Explicit formula for the complex square root in terms of the square root of nonnegative reals. The right-hand side is decomposed into real and imaginary parts in the format expected by ~ crrei and ~ crimi . <HTML> This formula can be found in section 3.7.27 of <I>Handbook of Mathematical Functions</I>, ed. M. Abramowitz and I. A. Stegun (1965, Dover Press). </HTML> (Contributed by RP, 18-May-2024.)
theorem sqrtcval (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv A2 csqrt) (co (cfv (co (co (cfv A2 cabs) (cfv A2 cre) caddc) c2 cdiv) csqrt) (co ci (co (cif (wbr (cfv A2 cim) cc0 clt) (cneg c1) c1) (cfv (co (co (cfv A2 cabs) (cfv A2 cre) cmin) c2 cdiv) csqrt) cmul) cmul) caddc)) $;

--| Explicit formula for the complex square root in terms of the square root of nonnegative reals. The right side is slightly more compact than ~ sqrtcval . (Contributed by RP, 18-May-2024.)
theorem sqrtcval2 (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv A2 csqrt) (co (cfv (co (co (cfv A2 cabs) (cfv A2 cre) caddc) c2 cdiv) csqrt) (co (cif (wbr (cfv A2 cim) cc0 clt) (cneg ci) ci) (cfv (co (co (cfv A2 cabs) (cfv A2 cre) cmin) c2 cdiv) csqrt) cmul) caddc)) $;

--| Real part of the complex square root. (Contributed by RP, 18-May-2024.)
theorem resqrtval (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv (cfv A2 csqrt) cre) (cfv (co (co (cfv A2 cabs) (cfv A2 cre) caddc) c2 cdiv) csqrt)) $;

--| Imaginary part of the complex square root. (Contributed by RP, 18-May-2024.)
theorem imsqrtval (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv (cfv A2 csqrt) cim) (co (cif (wbr (cfv A2 cim) cc0 clt) (cneg c1) c1) (cfv (co (co (cfv A2 cabs) (cfv A2 cre) cmin) c2 cdiv) csqrt) cmul)) $;

--| Example for ~ resqrtval . (Contributed by RP, 21-May-2024.)
theorem resqrtvalex:
  $ wceq (cfv (cfv (co (cdc c1 c5) (co ci c8 cmul) caddc) csqrt) cre) c4 $;

--| Example for ~ imsqrtval . (Contributed by RP, 21-May-2024.)
theorem imsqrtvalex:
  $ wceq (cfv (cfv (co (cdc c1 c5) (co ci c8 cmul) caddc) csqrt) cim) c1 $;

--| Version of ~ ax-4 for a nested implication. (Contributed by RP, 13-Apr-2020.)
theorem al3im {x3: setvar} (ph ps ch th: wff x3):
  $ wi (wal x3 (wi ph (wi ps (wi ch th)))) (wi (wal x3 ph) (wi (wal x3 ps) (wi (wal x3 ch) (wal x3 th)))) $;

--| Two ways of expressing the intersection of images of a class. (Contributed by RP, 13-Apr-2020.)
theorem intima0 {x3 a: setvar} (A2 B2: class a):
  $ wceq (ciin a A2 (cima (cv a) B2)) (cint (cab x3 (wrex a (wceq (cv x3) (cima (cv a) B2)) A2))) $;

--| Element of image of intersection. (Contributed by RP, 13-Apr-2020.)
theorem elimaint {y1 a b: setvar} (A2: class y1) (B2: class y1 a):
  $ wb (wcel (cv y1) (cima (cint A2) B2)) (wrex b (wral a (wcel (cop (cv b) (cv y1)) (cv a)) A2) B2) $;

--| Converse of indexed union. (Contributed by RP, 20-Jun-2020.)
theorem cnviun {x3: setvar} (A2: class) (B2: class x3):
  $ wceq (ccnv (ciun x3 A2 B2)) (ciun x3 A2 (ccnv B2)) $;

--| The image of an indexed union is the indexed union of the images. (Contributed by RP, 29-Jun-2020.)
theorem imaiun1 {x3: setvar} (A2 B2: class x3) (C: class):
  $ wceq (cima (ciun x3 A2 B2) C) (ciun x3 A2 (cima B2 C)) $;

--| Composition with an indexed union. Proof analogous to that of ~ coiun . (Contributed by RP, 20-Jun-2020.)
theorem coiun1 {x3: setvar} (A2: class x3) (B2: class) (C: class x3):
  $ wceq (ccom (ciun x3 C A2) B2) (ciun x3 C (ccom A2 B2)) $;

--| Element of intersection of images. (Contributed by RP, 13-Apr-2020.)
theorem elintima {x3 y1 a b: setvar} (A2: class y1 a b) (B2: class y1 a):
  $ wb (wcel (cv y1) (cint (cab x3 (wrex a (wceq (cv x3) (cima (cv a) B2)) A2)))) (wral a (wrex b (wcel (cop (cv b) (cv y1)) (cv a)) B2) A2) $;

--| The image under the intersection of relations is a subset of the intersection of the images. (Contributed by RP, 13-Apr-2020.)
theorem intimass {x3 a: setvar} (A2 B2: class):
  $ wss (cima (cint A2) B2) (cint (cab x3 (wrex a (wceq (cv x3) (cima (cv a) B2)) A2))) $;

--| The image under the intersection of relations is a subset of the intersection of the images. (Contributed by RP, 13-Apr-2020.)
theorem intimass2 {x3: setvar} (A2 B2: class):
  $ wss (cima (cint A2) B2) (ciin x3 A2 (cima (cv x3) B2)) $;

--| Requirement for the image under the intersection of relations to equal the intersection of the images of those relations. (Contributed by RP, 13-Apr-2020.)
theorem intimag {x3 y1 a b: setvar} (A2 B2: class):
  $ wi (wal y1 (wi (wral a (wrex b (wcel (cop (cv b) (cv y1)) (cv a)) B2) A2) (wrex b (wral a (wcel (cop (cv b) (cv y1)) (cv a)) A2) B2))) (wceq (cima (cint A2) B2) (cint (cab x3 (wrex a (wceq (cv x3) (cima (cv a) B2)) A2)))) $;

--| Two ways to express the image of a singleton when the relation is an intersection. (Contributed by RP, 13-Apr-2020.)
theorem intimasn {x3 a: setvar} (A2 B2: class) (V: class x3 a):
  $ wi (wcel B2 V) (wceq (cima (cint A2) (csn B2)) (cint (cab x3 (wrex a (wceq (cv x3) (cima (cv a) (csn B2))) A2)))) $;

--| Two ways to express the image of a singleton when the relation is an intersection. (Contributed by RP, 13-Apr-2020.)
theorem intimasn2 {x3: setvar} (A2 B2: class) (V: class x3):
  $ wi (wcel B2 V) (wceq (cima (cint A2) (csn B2)) (ciin x3 A2 (cima (cv x3) (csn B2)))) $;

--| Subclass theorem for indexed union. (Contributed by RP, 17-Jul-2020.)
theorem ss2iundf {x3 y1: setvar} (ph: wff x3 y1) (A2 B2 C D G Y: class x3 y1):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wnfc y1 Y $ >
  $ wnfc y1 A2 $ >
  $ wnfc y1 B2 $ >
  $ wnfc x3 C $ >
  $ wnfc y1 C $ >
  $ wnfc x3 D $ >
  $ wnfc y1 G $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel Y C) $ >
  $ wi (w3a ph (wcel (cv x3) A2) (wceq (cv y1) Y)) (wceq D G) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wss B2 G) $ >
  $ wi ph (wss (ciun x3 A2 B2) (ciun y1 C D)) $;

--| Subclass theorem for indexed union. (Contributed by RP, 17-Jul-2020.)
theorem ss2iundv {x3 y1: setvar} (ph: wff) (A2 B2: class x3) (C: class) (D: class y1) (G Y: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel Y C) $ >
  $ wi (w3a ph (wcel (cv x3) A2) (wceq (cv y1) Y)) (wceq D G) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wss B2 G) $ >
  $ wi ph (wss (ciun x3 A2 B2) (ciun y1 C D)) $;

--| Rule used to change the bound variables and classes in an indexed union, with the substitution specified implicitly by the hypothesis. (Contributed by RP, 17-Jul-2020.)
theorem cbviuneq12df {x3 y1: setvar} (ph: wff x3 y1) (A2 B2 C D F G X Y: class x3 y1):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wnfc x3 X $ >
  $ wnfc y1 Y $ >
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wnfc y1 B2 $ >
  $ wnfc x3 C $ >
  $ wnfc y1 C $ >
  $ wnfc x3 D $ >
  $ wnfc x3 F $ >
  $ wnfc y1 G $ >
  $ wi (wa ph (wcel (cv y1) C)) (wcel X A2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel Y C) $ >
  $ wi (w3a ph (wcel (cv y1) C) (wceq (cv x3) X)) (wceq B2 F) $ >
  $ wi (w3a ph (wcel (cv x3) A2) (wceq (cv y1) Y)) (wceq D G) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wceq B2 G) $ >
  $ wi (wa ph (wcel (cv y1) C)) (wceq D F) $ >
  $ wi ph (wceq (ciun x3 A2 B2) (ciun y1 C D)) $;

--| Rule used to change the bound variables and classes in an indexed union, with the substitution specified implicitly by the hypothesis. (Contributed by RP, 17-Jul-2020.)
theorem cbviuneq12dv {x3 y1: setvar} (ph: wff) (A2: class) (B2: class x3) (C: class) (D F: class y1) (G: class x3) (X: class y1) (Y: class x3):
  $ wi (wa ph (wcel (cv y1) C)) (wcel X A2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel Y C) $ >
  $ wi (w3a ph (wcel (cv y1) C) (wceq (cv x3) X)) (wceq B2 F) $ >
  $ wi (w3a ph (wcel (cv x3) A2) (wceq (cv y1) Y)) (wceq D G) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wceq B2 G) $ >
  $ wi (wa ph (wcel (cv y1) C)) (wceq D F) $ >
  $ wi ph (wceq (ciun x3 A2 B2) (ciun y1 C D)) $;

--| Deduction about composition with a class with no relational content. (Contributed by RP, 24-Dec-2019.)
theorem conrel1d (ph: wff) (A2 B2: class):
  $ wi ph (wceq (ccnv A2) c0) $ >
  $ wi ph (wceq (ccom A2 B2) c0) $;

--| Deduction about composition with a class with no relational content. (Contributed by RP, 24-Dec-2019.)
theorem conrel2d (ph: wff) (A2 B2: class):
  $ wi ph (wceq (ccnv A2) c0) $ >
  $ wi ph (wceq (ccom B2 A2) c0) $;

--| The intersection of transitive relations is a transitive relation. (Contributed by RP, 24-Dec-2019.)
theorem trrelind (ph: wff) (R S T: class):
  $ wi ph (wss (ccom R R) R) $ >
  $ wi ph (wss (ccom S S) S) $ >
  $ wi ph (wceq T (cin R S)) $ >
  $ wi ph (wss (ccom T T) T) $;

--| The intersection of a transitive relation with a Cartesian product is a transitive relation. (Contributed by RP, 24-Dec-2019.)
theorem xpintrreld (ph: wff) (A2 B2 R S: class):
  $ wi ph (wss (ccom R R) R) $ >
  $ wi ph (wceq S (cin R (cxp A2 B2))) $ >
  $ wi ph (wss (ccom S S) S) $;

--| The restriction of a transitive relation is a transitive relation. (Contributed by RP, 24-Dec-2019.)
theorem restrreld (ph: wff) (A2 R S: class):
  $ wi ph (wss (ccom R R) R) $ >
  $ wi ph (wceq S (cres R A2)) $ >
  $ wi ph (wss (ccom S S) S) $;

--| Concrete construction of a superclass of relation ` R ` which is a transitive relation. (Contributed by RP, 25-Dec-2019.)
theorem trrelsuperreldg (ph: wff) (R S: class):
  $ wi ph (wrel R) $ >
  $ wi ph (wceq S (cxp (cdm R) (crn R))) $ >
  $ wi ph (wa (wss R S) (wss (ccom S S) S)) $;

--| The class of all transitive relations has the finite intersection property. (Contributed by RP, 1-Jan-2020.) (Proof shortened by RP, 3-Jan-2020.)
theorem trficl {x3 y1 z: setvar} (A2: class x3 z):
  $ wceq A2 (cab z (wss (ccom (cv z) (cv z)) (cv z))) $ >
  $ wral x3 (wral y1 (wcel (cin (cv x3) (cv y1)) A2) A2) A2 $;

--| The converse of a transitive relation is a transitive relation. (Contributed by RP, 25-Dec-2019.)
theorem cnvtrrel (S: class):
  $ wb (wss (ccom S S) S) (wss (ccom (ccnv S) (ccnv S)) (ccnv S)) $;

--| Concrete construction of a superclass of relation ` R ` which is a transitive relation. (Contributed by RP, 20-Jul-2020.)
theorem trrelsuperrel2dg (ph: wff) (R S: class):
  $ wi ph (wceq S (cun R (cxp (cdm R) (crn R)))) $ >
  $ wi ph (wa (wss R S) (wss (ccom S S) S)) $;

--| Extend class notation with reflexive closure.
term crcl: class;

--| Reflexive closure of a relation. This is the smallest superset which has the reflexive property. (Contributed by RP, 5-Jun-2020.)
axiom df_rcl {x3 z: setvar}:
  $ wceq crcl (cmpt x3 cvv (cint (cab z (wa (wss (cv x3) (cv z)) (wss (cres cid (cun (cdm (cv z)) (crn (cv z)))) (cv z)))))) $;

--| Reflexive closure of a relation as union with restricted identity relation. (Contributed by RP, 6-Jun-2020.)
theorem dfrcl2 {x3: setvar}:
  $ wceq crcl (cmpt x3 cvv (cun (cres cid (cun (cdm (cv x3)) (crn (cv x3)))) (cv x3))) $;

--| Reflexive closure of a relation as union of powers of the relation. (Contributed by RP, 6-Jun-2020.)
theorem dfrcl3 {x3: setvar}:
  $ wceq crcl (cmpt x3 cvv (cun (co (cv x3) cc0 crelexp) (co (cv x3) c1 crelexp))) $;

--| Reflexive closure of a relation as indexed union of powers of the relation. (Contributed by RP, 8-Jun-2020.)
theorem dfrcl4 {n r: setvar}:
  $ wceq crcl (cmpt r cvv (ciun n (cpr cc0 c1) (co (cv r) (cv n) crelexp))) $;

--| A set operated on by the relation exponent to the second power is equal to the composition of the set with itself. (Contributed by RP, 1-Jun-2020.)
theorem relexp2 (R V: class):
  $ wi (wcel R V) (wceq (co R c2 crelexp) (ccom R R)) $;

--| If the domain and range of powers of a relation are disjoint then the relation raised to the sum of those exponents is empty. (Contributed by RP, 1-Jun-2020.)
theorem relexpnul (R M N V: class):
  $ wi (wa (wa (wcel R V) (wrel R)) (wa (wcel N cn0) (wcel M cn0))) (wb (wceq (cin (cdm (co R N crelexp)) (crn (co R M crelexp))) c0) (wceq (co R (co N M caddc) crelexp) c0)) $;

--| Membership in the indexed union over operator values where the index varies the second input is equivalent to the existence of at least one index such that the element is a member of that operator value. Generalized from ~ dfrtrclrec2 . (Contributed by RP, 1-Jun-2020.)
theorem eliunov2 {n r: setvar} (C R: class) (U: class n r) (c_ex N: class) (V: class n r) (X: class r):
  $ wceq C (cmpt r cvv (ciun n N (co (cv r) (cv n) c_ex))) $ >
  $ wi (wa (wcel R U) (wcel N V)) (wb (wcel X (cfv R C)) (wrex n (wcel X (co R (cv n) c_ex)) N)) $;

--| Membership in the indexed union of relation exponentiation over the natural numbers is equivalent to the existence of at least one number such that the element is a member of that relationship power. (Contributed by RP, 2-Jun-2020.)
theorem eltrclrec {n r: setvar} (C R: class) (V: class n r) (X: class r):
  $ wceq C (cmpt r cvv (ciun n cn (co (cv r) (cv n) crelexp))) $ >
  $ wi (wcel R V) (wb (wcel X (cfv R C)) (wrex n (wcel X (co R (cv n) crelexp)) cn)) $;

--| Membership in the indexed union of relation exponentiation over the natural numbers (including zero) is equivalent to the existence of at least one number such that the element is a member of that relationship power. (Contributed by RP, 2-Jun-2020.)
theorem elrtrclrec {n r: setvar} (C R: class) (V: class n r) (X: class r):
  $ wceq C (cmpt r cvv (ciun n cn0 (co (cv r) (cv n) crelexp))) $ >
  $ wi (wcel R V) (wb (wcel X (cfv R C)) (wrex n (wcel X (co R (cv n) crelexp)) cn0)) $;

--| Two classes related by the indexed union over operator values where the index varies the second input is equivalent to the existence of at least one index such that the two classes are related by that operator value. (Contributed by RP, 1-Jun-2020.)
theorem briunov2 {n r: setvar} (C R: class) (U: class n r) (c_ex N: class) (V: class n r) (X Y: class r):
  $ wceq C (cmpt r cvv (ciun n N (co (cv r) (cv n) c_ex))) $ >
  $ wi (wa (wcel R U) (wcel N V)) (wb (wbr X Y (cfv R C)) (wrex n (wbr X Y (co R (cv n) c_ex)) N)) $;

--| If two elements are connected by an indexed union of relational powers, then they are connected via ` n ` instances the relation, for some ` n ` . Generalization of ~ dfrtrclrec2 . (Contributed by RP, 21-Jul-2020.)
theorem brmptiunrelexpd {n r: setvar} (ph: wff n r) (A2 B2: class r) (C R N: class):
  $ wceq C (cmpt r cvv (ciun n N (co (cv r) (cv n) crelexp))) $ >
  $ wi ph (wcel R cvv) $ >
  $ wi ph (wss N cn0) $ >
  $ wi ph (wb (wbr A2 B2 (cfv R C)) (wrex n (wbr A2 B2 (co R (cv n) crelexp)) N)) $;

--| If the indexed union ranges over the zeroth power of the relation, then a restriction of the identity relation is a subset of the appliction of the function to the relation. (Contributed by RP, 22-Jul-2020.)
theorem fvmptiunrelexplb0d {n r: setvar} (ph: wff n r) (C: class n r) (R N: class):
  $ wceq C (cmpt r cvv (ciun n N (co (cv r) (cv n) crelexp))) $ >
  $ wi ph (wcel R cvv) $ >
  $ wi ph (wcel N cvv) $ >
  $ wi ph (wcel cc0 N) $ >
  $ wi ph (wss (cres cid (cun (cdm R) (crn R))) (cfv R C)) $;

--| If the indexed union ranges over the zeroth power of the relation, then a restriction of the identity relation is a subset of the appliction of the function to the relation. (Contributed by RP, 22-Jul-2020.)
theorem fvmptiunrelexplb0da {n r: setvar} (ph: wff n r) (C R N: class):
  $ wceq C (cmpt r cvv (ciun n N (co (cv r) (cv n) crelexp))) $ >
  $ wi ph (wcel R cvv) $ >
  $ wi ph (wcel N cvv) $ >
  $ wi ph (wrel R) $ >
  $ wi ph (wcel cc0 N) $ >
  $ wi ph (wss (cres cid (cuni (cuni R))) (cfv R C)) $;

--| If the indexed union ranges over the first power of the relation, then the relation is a subset of the appliction of the function to the relation. (Contributed by RP, 22-Jul-2020.)
theorem fvmptiunrelexplb1d {n r: setvar} (ph: wff n r) (C: class n r) (R N: class):
  $ wceq C (cmpt r cvv (ciun n N (co (cv r) (cv n) crelexp))) $ >
  $ wi ph (wcel R cvv) $ >
  $ wi ph (wcel N cvv) $ >
  $ wi ph (wcel c1 N) $ >
  $ wi ph (wss R (cfv R C)) $;

--| If two elements are connected by a value of the identity relation, then they are connected via the argument. (Contributed by RP, 21-Jul-2020.)
theorem brfvid (ph: wff) (A2 B2 R: class):
  $ wi ph (wcel R cvv) $ >
  $ wi ph (wb (wbr A2 B2 (cfv R cid)) (wbr A2 B2 R)) $;

--| If two elements are connected by a value of the identity relation, then they are connected via the argument. This is an example which uses ~ brmptiunrelexpd . (Contributed by RP, 21-Jul-2020.) (Proof modification is discouraged.)
theorem brfvidRP (ph: wff) (A2 B2 R: class):
  $ wi ph (wcel R cvv) $ >
  $ wi ph (wb (wbr A2 B2 (cfv R cid)) (wbr A2 B2 R)) $;

--| A set is a subset of its image under the identity relation. (Contributed by RP, 22-Jul-2020.)
theorem fvilbd (ph: wff) (R: class):
  $ wi ph (wcel R cvv) $ >
  $ wi ph (wss R (cfv R cid)) $;

--| A set is a subset of its image under the identity relation. (Contributed by RP, 22-Jul-2020.) (Proof modification is discouraged.)
theorem fvilbdRP (ph: wff) (R: class):
  $ wi ph (wcel R cvv) $ >
  $ wi ph (wss R (cfv R cid)) $;

--| If two elements are connected by the reflexive closure of a relation, then they are connected via zero or one instances the relation. (Contributed by RP, 21-Jul-2020.)
theorem brfvrcld (ph: wff) (A2 B2 R: class):
  $ wi ph (wcel R cvv) $ >
  $ wi ph (wb (wbr A2 B2 (cfv R crcl)) (wo (wbr A2 B2 (co R cc0 crelexp)) (wbr A2 B2 (co R c1 crelexp)))) $;

--| If two elements are connected by the reflexive closure of a relation, then they are equal or related by relation. (Contributed by RP, 21-Jul-2020.)
theorem brfvrcld2 (ph: wff) (A2 B2 R: class):
  $ wi ph (wcel R cvv) $ >
  $ wi ph (wb (wbr A2 B2 (cfv R crcl)) (wo (w3a (wcel A2 (cun (cdm R) (crn R))) (wcel B2 (cun (cdm R) (crn R))) (wceq A2 B2)) (wbr A2 B2 R))) $;

--| A restriction of the identity relation is a subset of the reflexive closure of a set. (Contributed by RP, 22-Jul-2020.)
theorem fvrcllb0d (ph: wff) (R: class):
  $ wi ph (wcel R cvv) $ >
  $ wi ph (wss (cres cid (cun (cdm R) (crn R))) (cfv R crcl)) $;

--| A restriction of the identity relation is a subset of the reflexive closure of a relation. (Contributed by RP, 22-Jul-2020.)
theorem fvrcllb0da (ph: wff) (R: class):
  $ wi ph (wrel R) $ >
  $ wi ph (wcel R cvv) $ >
  $ wi ph (wss (cres cid (cuni (cuni R))) (cfv R crcl)) $;

--| A set is a subset of its image under the reflexive closure. (Contributed by RP, 22-Jul-2020.)
theorem fvrcllb1d (ph: wff) (R: class):
  $ wi ph (wcel R cvv) $ >
  $ wi ph (wss R (cfv R crcl)) $;

--| Two classes related by the indexed union of relation exponentiation over the natural numbers is equivalent to the existence of at least one number such that the two classes are related by that relationship power. (Contributed by RP, 2-Jun-2020.)
theorem brtrclrec {n r: setvar} (C R: class) (V: class n r) (X Y: class r):
  $ wceq C (cmpt r cvv (ciun n cn (co (cv r) (cv n) crelexp))) $ >
  $ wi (wcel R V) (wb (wbr X Y (cfv R C)) (wrex n (wbr X Y (co R (cv n) crelexp)) cn)) $;

--| Two classes related by the indexed union of relation exponentiation over the natural numbers (including zero) is equivalent to the existence of at least one number such that the two classes are related by that relationship power. (Contributed by RP, 2-Jun-2020.)
theorem brrtrclrec {n r: setvar} (C R: class) (V: class n r) (X Y: class r):
  $ wceq C (cmpt r cvv (ciun n cn0 (co (cv r) (cv n) crelexp))) $ >
  $ wi (wcel R V) (wb (wbr X Y (cfv R C)) (wrex n (wbr X Y (co R (cv n) crelexp)) cn0)) $;

--| Two classes related by the indexed union over operator values where the index varies the second input is equivalent to the existence of at least one index such that the two classes are related by that operator value. The index set ` N ` is restricted to an upper range of integers. (Contributed by RP, 2-Jun-2020.)
theorem briunov2uz {n r: setvar} (C R: class) (U: class n r) (c_ex: class) (M: class n r) (N: class) (X Y: class r):
  $ wceq C (cmpt r cvv (ciun n N (co (cv r) (cv n) c_ex))) $ >
  $ wi (wa (wcel R U) (wceq N (cfv M cuz))) (wb (wbr X Y (cfv R C)) (wrex n (wbr X Y (co R (cv n) c_ex)) N)) $;

--| Membership in the indexed union over operator values where the index varies the second input is equivalent to the existence of at least one index such that the element is a member of that operator value. The index set ` N ` is restricted to an upper range of integers. (Contributed by RP, 2-Jun-2020.)
theorem eliunov2uz {n r: setvar} (C R: class) (U: class n r) (c_ex: class) (M: class n r) (N: class) (X: class r):
  $ wceq C (cmpt r cvv (ciun n N (co (cv r) (cv n) c_ex))) $ >
  $ wi (wa (wcel R U) (wceq N (cfv M cuz))) (wb (wcel X (cfv R C)) (wrex n (wcel X (co R (cv n) c_ex)) N)) $;

--| Any particular operator value is the subset of the index union over a set of operator values. Generalized from ~ rtrclreclem1 and rtrclreclem2 . (Contributed by RP, 4-Jun-2020.)
theorem ov2ssiunov2 {n r: setvar} (C R: class) (U: class r) (c_ex: class) (M: class r) (N: class) (V: class r):
  $ wceq C (cmpt r cvv (ciun n N (co (cv r) (cv n) c_ex))) $ >
  $ wi (w3a (wcel R U) (wcel N V) (wcel M N)) (wss (co R M c_ex) (cfv R C)) $;

--| The zeroth power of relationships is the same if and only if the union of their domain and ranges is the same. (Contributed by RP, 11-Jun-2020.)
theorem relexp0eq (A2 B2 U V: class):
  $ wi (wa (wcel A2 U) (wcel B2 V)) (wb (wceq (cun (cdm A2) (crn A2)) (cun (cdm B2) (crn B2))) (wceq (co A2 cc0 crelexp) (co B2 cc0 crelexp))) $;

--| Simplification of zeroth power of indexed union of powers of relations. (Contributed by RP, 19-Jun-2020.)
theorem iunrelexp0 {x3: setvar} (R V Z: class):
  $ wi (w3a (wcel R V) (wss Z cn0) (wne (cin (cpr cc0 c1) Z) c0)) (wceq (co (ciun x3 Z (co R (cv x3) crelexp)) cc0 crelexp) (co R cc0 crelexp)) $;

--| Any positive power of a Cartesian product of non-disjoint sets is itself. (Contributed by RP, 13-Jun-2020.)
theorem relexpxpnnidm (A2 B2 U N V: class):
  $ wi (wcel N cn) (wi (w3a (wcel A2 U) (wcel B2 V) (wne (cin A2 B2) c0)) (wceq (co (cxp A2 B2) N crelexp) (cxp A2 B2))) $;

--| Any power of any restriction of the identity relation is itself. (Contributed by RP, 12-Jun-2020.)
theorem relexpiidm (A2 N V: class):
  $ wi (wa (wcel A2 V) (wcel N cn0)) (wceq (co (cres cid A2) N crelexp) (cres cid A2)) $;

--| The relational power of a subset is a subset. (Contributed by RP, 17-Jun-2020.)
theorem relexpss1d (ph: wff) (A2 B2 N: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wcel B2 cvv) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wss (co A2 N crelexp) (co B2 N crelexp)) $;

--| The composition two indexed unions is sometimes a similar indexed union. (Contributed by RP, 10-Jun-2020.)
theorem comptiunov2i {i j k a b c d: setvar} (c_ex: class j k d) (I: class j b c d) (J: class c d) (K: class i j a b d) (X Y Z: class i j k a b c):
  $ wceq X (cmpt a cvv (ciun i I (co (cv a) (cv i) c_ex))) $ >
  $ wceq Y (cmpt b cvv (ciun j J (co (cv b) (cv j) c_ex))) $ >
  $ wceq Z (cmpt c cvv (ciun k K (co (cv c) (cv k) c_ex))) $ >
  $ wcel I cvv $ >
  $ wcel J cvv $ >
  $ wceq K (cun I J) $ >
  $ wss (ciun k I (co (cv d) (cv k) c_ex)) (ciun i I (co (ciun j J (co (cv d) (cv j) c_ex)) (cv i) c_ex)) $ >
  $ wss (ciun k J (co (cv d) (cv k) c_ex)) (ciun i I (co (ciun j J (co (cv d) (cv j) c_ex)) (cv i) c_ex)) $ >
  $ wss (ciun i I (co (ciun j J (co (cv d) (cv j) c_ex)) (cv i) c_ex)) (ciun k (cun I J) (co (cv d) (cv k) c_ex)) $ >
  $ wceq (ccom X Y) Z $;

--| The reflexive closure is idempotent. (Contributed by RP, 13-Jun-2020.)
theorem corclrcl:
  $ wceq (ccom crcl crcl) crcl $;

--| The indexed union of relation exponentiation over the natural numbers is the minimum transitive relation that includes the relation. (Contributed by RP, 4-Jun-2020.)
theorem iunrelexpmin1 {n s1 r: setvar} (C: class s1) (R N V: class):
  $ wceq C (cmpt r cvv (ciun n N (co (cv r) (cv n) crelexp))) $ >
  $ wi (wa (wcel R V) (wceq N cn)) (wal s1 (wi (wa (wss R (cv s1)) (wss (ccom (cv s1) (cv s1)) (cv s1))) (wss (cfv R C) (cv s1)))) $;

--| With exponents limited to the counting numbers, the composition of powers of a relation is the relation raised to the product of exponents. (Contributed by RP, 13-Jun-2020.)
theorem relexpmulnn (R I J K V: class):
  $ wi (wa (wa (wcel R V) (wceq I (co J K cmul))) (wa (wcel J cn) (wcel K cn))) (wceq (co (co R J crelexp) K crelexp) (co R I crelexp)) $;

--| With ordered exponents, the composition of powers of a relation is the relation raised to the product of exponents. (Contributed by RP, 13-Jun-2020.)
theorem relexpmulg (R I J K V: class):
  $ wi (wa (w3a (wcel R V) (wceq I (co J K cmul)) (wi (wceq I cc0) (wbr J K cle))) (wa (wcel J cn0) (wcel K cn0))) (wceq (co (co R J crelexp) K crelexp) (co R I crelexp)) $;

--| The union of relational powers to positive multiples of ` N ` is a subset to the transitive closure raised to the power of ` N ` . (Contributed by RP, 15-Jun-2020.)
theorem trclrelexplem {j k: setvar} (D: class) (N: class j):
  $ wi (wcel N cn) (wss (ciun k cn (co (co D (cv k) crelexp) N crelexp)) (co (ciun j cn (co D (cv j) crelexp)) N crelexp)) $;

--| The indexed union of relation exponentiation over the natural numbers (including zero) is the minimum reflexive-transitive relation that includes the relation. (Contributed by RP, 4-Jun-2020.)
theorem iunrelexpmin2 {n s1 r: setvar} (C: class s1) (R N V: class):
  $ wceq C (cmpt r cvv (ciun n N (co (cv r) (cv n) crelexp))) $ >
  $ wi (wa (wcel R V) (wceq N cn0)) (wal s1 (wi (w3a (wss (cres cid (cun (cdm R) (crn R))) (cv s1)) (wss R (cv s1)) (wss (ccom (cv s1) (cv s1)) (cv s1))) (wss (cfv R C) (cv s1)))) $;

--| With exponents limited to 0 and 1, the composition of powers of a relation is the relation raised to the minimum of exponents. (Contributed by RP, 12-Jun-2020.)
theorem relexp01min (R I J K V: class):
  $ wi (wa (wa (wcel R V) (wceq I (cif (wbr J K clt) J K))) (wa (wcel J (cpr cc0 c1)) (wcel K (cpr cc0 c1)))) (wceq (co (co R J crelexp) K crelexp) (co R I crelexp)) $;

--| Repeated raising a relation to the first power is idempotent. (Contributed by RP, 12-Jun-2020.)
theorem relexp1idm (R V: class):
  $ wi (wcel R V) (wceq (co (co R c1 crelexp) c1 crelexp) (co R c1 crelexp)) $;

--| Repeated raising a relation to the zeroth power is idempotent. (Contributed by RP, 12-Jun-2020.)
theorem relexp0idm (R V: class):
  $ wi (wcel R V) (wceq (co (co R cc0 crelexp) cc0 crelexp) (co R cc0 crelexp)) $;

--| Absorption law for zeroth power of a relation. (Contributed by RP, 17-Jun-2020.)
theorem relexp0a (A2 N V: class):
  $ wi (wa (wcel A2 V) (wcel N cn0)) (wss (co (co A2 N crelexp) cc0 crelexp) (co A2 cc0 crelexp)) $;

--| The composition of powers of a Cartesian product of non-disjoint sets is the Cartesian product raised to the minimum exponent. (Contributed by RP, 13-Jun-2020.)
theorem relexpxpmin (A2 B2 U I J K V: class):
  $ wi (wa (w3a (wcel A2 U) (wcel B2 V) (wne (cin A2 B2) c0)) (w3a (wceq I (cif (wbr J K clt) J K)) (wcel J cn0) (wcel K cn0))) (wceq (co (co (cxp A2 B2) J crelexp) K crelexp) (co (cxp A2 B2) I crelexp)) $;

--| The composition of two powers of a relation is a subset of the relation raised to the sum of those exponents. This is equality where ` R ` is a relation as shown by ~ relexpaddd or when the sum of the powers isn't 1 as shown by ~ relexpaddg . (Contributed by RP, 3-Jun-2020.)
theorem relexpaddss (R M N V: class):
  $ wi (w3a (wcel N cn0) (wcel M cn0) (wcel R V)) (wss (ccom (co R N crelexp) (co R M crelexp)) (co R (co N M caddc) crelexp)) $;

--| The indexed union of relation exponentiation over upper integers is a transive relation. Generalized from ~ rtrclreclem3 . (Contributed by RP, 4-Jun-2020.)
theorem iunrelexpuztr {n r: setvar} (C R: class) (M: class r) (N: class) (V: class r):
  $ wceq C (cmpt r cvv (ciun n N (co (cv r) (cv n) crelexp))) $ >
  $ wi (w3a (wcel R V) (wceq N (cfv M cuz)) (wcel M cn0)) (wss (ccom (cfv R C) (cfv R C)) (cfv R C)) $;

--| Transitive closure of a relation, expressed as indexed union of powers of relations. (Contributed by RP, 5-Jun-2020.)
theorem dftrcl3 {n r: setvar}:
  $ wceq ctcl (cmpt r cvv (ciun n cn (co (cv r) (cv n) crelexp))) $;

--| If two elements are connected by the transitive closure of a relation, then they are connected via ` n ` instances the relation, for some counting number ` n ` . (Contributed by RP, 22-Jul-2020.)
theorem brfvtrcld {n: setvar} (ph: wff n) (A2 B2 R: class):
  $ wi ph (wcel R cvv) $ >
  $ wi ph (wb (wbr A2 B2 (cfv R ctcl)) (wrex n (wbr A2 B2 (co R (cv n) crelexp)) cn)) $;

--| A set is a subset of its image under the transitive closure. (Contributed by RP, 22-Jul-2020.)
theorem fvtrcllb1d (ph: wff) (R: class):
  $ wi ph (wcel R cvv) $ >
  $ wi ph (wss R (cfv R ctcl)) $;

--| The transitive closure of a relation commutes with the relation. (Contributed by RP, 18-Jul-2020.)
theorem trclfvcom (R V: class):
  $ wi (wcel R V) (wceq (ccom (cfv R ctcl) R) (ccom R (cfv R ctcl))) $;

--| The converse of the transitive closure is equal to the transitive closure of the converse relation. (Contributed by RP, 19-Jul-2020.)
theorem cnvtrclfv (R V: class):
  $ wi (wcel R V) (wceq (ccnv (cfv R ctcl)) (cfv (ccnv R) ctcl)) $;

--| The transitive closure is idempotent. (Contributed by RP, 16-Jun-2020.)
theorem cotrcltrcl:
  $ wceq (ccom ctcl ctcl) ctcl $;

--| Lower bound for image under a transitive closure. (Contributed by RP, 1-Jul-2020.)
theorem trclimalb2 (A2 B2 R V: class):
  $ wi (wa (wcel R V) (wss (cima R (cun A2 B2)) B2)) (wss (cima (cfv R ctcl) A2) B2) $;

--| Two ways to indicate two elements are related by the transitive closure of a relation. (Contributed by RP, 1-Jul-2020.)
theorem brtrclfv2 {f2: setvar} (R U V W X Y: class):
  $ wi (w3a (wcel X U) (wcel Y V) (wcel R W)) (wb (wbr X Y (cfv R ctcl)) (wcel Y (cint (cab f2 (wss (cima R (cun (csn X) (cv f2))) (cv f2)))))) $;

--| The transitive closure of a relation may be decomposed into a union of the relation and the composition of the relation with its transitive closure. (Contributed by RP, 18-Jul-2020.)
theorem trclfvdecomr (R V: class):
  $ wi (wcel R V) (wceq (cfv R ctcl) (cun R (ccom (cfv R ctcl) R))) $;

--| The transitive closure of a relation may be decomposed into a union of the relation and the composition of the relation with its transitive closure. (Contributed by RP, 18-Jul-2020.)
theorem trclfvdecoml (R V: class):
  $ wi (wcel R V) (wceq (cfv R ctcl) (cun R (ccom R (cfv R ctcl)))) $;

--| The domain of the transitive closure is equal to the domain of the relation. (Contributed by RP, 18-Jul-2020.) (Proof modification is discouraged.)
theorem dmtrclfvRP (R V: class):
  $ wi (wcel R V) (wceq (cdm (cfv R ctcl)) (cdm R)) $;

--| The range of the transitive closure is equal to the range of the relation. (Contributed by RP, 19-Jul-2020.) (Proof modification is discouraged.)
theorem rntrclfvRP (R V: class):
  $ wi (wcel R V) (wceq (crn (cfv R ctcl)) (crn R)) $;

--| The range of the transitive closure is equal to the range of the relation. (Contributed by RP, 18-Jul-2020.) (Proof modification is discouraged.)
theorem rntrclfv (R V: class):
  $ wi (wcel R V) (wceq (crn (cfv R ctcl)) (crn R)) $;

--| Reflexive-transitive closure of a relation, expressed as indexed union of powers of relations. Generalized from ~ dfrtrcl2 . (Contributed by RP, 5-Jun-2020.)
theorem dfrtrcl3 {n r: setvar}:
  $ wceq crtcl (cmpt r cvv (ciun n cn0 (co (cv r) (cv n) crelexp))) $;

--| If two elements are connected by the reflexive-transitive closure of a relation, then they are connected via ` n ` instances the relation, for some natural number ` n ` . Similar of ~ dfrtrclrec2 . (Contributed by RP, 22-Jul-2020.)
theorem brfvrtrcld {n: setvar} (ph: wff n) (A2 B2 R: class):
  $ wi ph (wcel R cvv) $ >
  $ wi ph (wb (wbr A2 B2 (cfv R crtcl)) (wrex n (wbr A2 B2 (co R (cv n) crelexp)) cn0)) $;

--| A restriction of the identity relation is a subset of the reflexive-transitive closure of a set. (Contributed by RP, 22-Jul-2020.)
theorem fvrtrcllb0d (ph: wff) (R: class):
  $ wi ph (wcel R cvv) $ >
  $ wi ph (wss (cres cid (cun (cdm R) (crn R))) (cfv R crtcl)) $;

--| A restriction of the identity relation is a subset of the reflexive-transitive closure of a relation. (Contributed by RP, 22-Jul-2020.)
theorem fvrtrcllb0da (ph: wff) (R: class):
  $ wi ph (wrel R) $ >
  $ wi ph (wcel R cvv) $ >
  $ wi ph (wss (cres cid (cuni (cuni R))) (cfv R crtcl)) $;

--| A set is a subset of its image under the reflexive-transitive closure. (Contributed by RP, 22-Jul-2020.)
theorem fvrtrcllb1d (ph: wff) (R: class):
  $ wi ph (wcel R cvv) $ >
  $ wi ph (wss R (cfv R crtcl)) $;

--| Reflexive-transitive closure of a relation, expressed as the union of the zeroth power and the transitive closure. (Contributed by RP, 5-Jun-2020.)
theorem dfrtrcl4 {r: setvar}:
  $ wceq crtcl (cmpt r cvv (cun (co (cv r) cc0 crelexp) (cfv (cv r) ctcl))) $;

--| The composition of the reflexive and transitive closures is the reflexive-transitive closure. (Contributed by RP, 17-Jun-2020.)
theorem corcltrcl:
  $ wceq (ccom crcl ctcl) crtcl $;

--| Composition with the reflexive-transitive closure absorbs the transitive closure. (Contributed by RP, 13-Jun-2020.)
theorem cortrcltrcl:
  $ wceq (ccom crtcl ctcl) crtcl $;

--| Composition with the reflexive-transitive closure absorbs the reflexive closure. (Contributed by RP, 13-Jun-2020.)
theorem corclrtrcl:
  $ wceq (ccom crcl crtcl) crtcl $;

--| The composition of the reflexive and transitive closures is the reflexive-transitive closure. (Contributed by RP, 21-Jun-2020.)
theorem cotrclrcl:
  $ wceq (ccom ctcl crcl) crtcl $;

--| Composition with the reflexive-transitive closure absorbs the reflexive closure. (Contributed by RP, 13-Jun-2020.)
theorem cortrclrcl:
  $ wceq (ccom crtcl crcl) crtcl $;

--| Composition with the reflexive-transitive closure absorbs the transitive closure. (Contributed by RP, 13-Jun-2020.)
theorem cotrclrtrcl:
  $ wceq (ccom ctcl crtcl) crtcl $;

--| The reflexive-transitive closure is idempotent. (Contributed by RP, 13-Jun-2020.)
theorem cortrclrtrcl:
  $ wceq (ccom crtcl crtcl) crtcl $;

--| If the images of both ` { A } ` and ` U ` are subsets of ` U ` and ` B ` follows ` A ` in the transitive closure of ` R ` , then ` B ` is an element of ` U ` . Similar to Proposition 77 of [Frege1879] p. 62. Compare with ~ frege77 . (Contributed by RP, 15-Jul-2020.)
theorem frege77d (ph: wff) (A2 B2 R U: class):
  $ wi ph (wcel R cvv) $ >
  $ wi ph (wcel A2 cvv) $ >
  $ wi ph (wcel B2 cvv) $ >
  $ wi ph (wbr A2 B2 (cfv R ctcl)) $ >
  $ wi ph (wss (cima R U) U) $ >
  $ wi ph (wss (cima R (csn A2)) U) $ >
  $ wi ph (wcel B2 U) $;

--| If the image of ` U ` is a subset ` U ` , ` A ` is an element of ` U ` and ` B ` follows ` A ` in the transitive closure of ` R ` , then ` B ` is an element of ` U ` . Similar to Proposition 81 of [Frege1879] p. 63. Compare with ~ frege81 . (Contributed by RP, 15-Jul-2020.)
theorem frege81d (ph: wff) (A2 B2 R U: class):
  $ wi ph (wcel R cvv) $ >
  $ wi ph (wcel A2 U) $ >
  $ wi ph (wcel B2 cvv) $ >
  $ wi ph (wbr A2 B2 (cfv R ctcl)) $ >
  $ wi ph (wss (cima R U) U) $ >
  $ wi ph (wcel B2 U) $;

--| If the image of the union of ` U ` and ` V ` is a subset of the union of ` U ` and ` V ` , ` A ` is an element of ` U ` and ` B ` follows ` A ` in the transitive closure of ` R ` , then ` B ` is an element of the union of ` U ` and ` V ` . Similar to Proposition 83 of [Frege1879] p. 65. Compare with ~ frege83 . (Contributed by RP, 15-Jul-2020.)
theorem frege83d (ph: wff) (A2 B2 R U V: class):
  $ wi ph (wcel R cvv) $ >
  $ wi ph (wcel A2 U) $ >
  $ wi ph (wcel B2 cvv) $ >
  $ wi ph (wbr A2 B2 (cfv R ctcl)) $ >
  $ wi ph (wss (cima R (cun U V)) (cun U V)) $ >
  $ wi ph (wcel B2 (cun U V)) $;

--| If ` C ` follows ` A ` in the transitive closure of ` R ` and ` B ` follows ` C ` in ` R ` , then ` B ` follows ` A ` in the transitive closure of ` R ` . Similar to Proposition 96 of [Frege1879] p. 71. Compare with ~ frege96 . (Contributed by RP, 15-Jul-2020.)
theorem frege96d (ph: wff) (A2 B2 C R: class):
  $ wi ph (wcel R cvv) $ >
  $ wi ph (wcel A2 cvv) $ >
  $ wi ph (wcel B2 cvv) $ >
  $ wi ph (wcel C cvv) $ >
  $ wi ph (wbr A2 C (cfv R ctcl)) $ >
  $ wi ph (wbr C B2 R) $ >
  $ wi ph (wbr A2 B2 (cfv R ctcl)) $;

--| If the images of both ` { A } ` and ` U ` are subsets of ` U ` and ` C ` follows ` A ` in the transitive closure of ` R ` and ` B ` follows ` C ` in ` R ` , then ` B ` is an element of ` U ` . Similar to Proposition 87 of [Frege1879] p. 66. Compare with ~ frege87 . (Contributed by RP, 15-Jul-2020.)
theorem frege87d (ph: wff) (A2 B2 C R U: class):
  $ wi ph (wcel R cvv) $ >
  $ wi ph (wcel A2 cvv) $ >
  $ wi ph (wcel B2 cvv) $ >
  $ wi ph (wcel C cvv) $ >
  $ wi ph (wbr A2 C (cfv R ctcl)) $ >
  $ wi ph (wbr C B2 R) $ >
  $ wi ph (wss (cima R (csn A2)) U) $ >
  $ wi ph (wss (cima R U) U) $ >
  $ wi ph (wcel B2 U) $;

--| If ` B ` follows ` A ` in ` R ` then ` B ` follows ` A ` in the transitive closure of ` R ` . Similar to Proposition 91 of [Frege1879] p. 68. Comparw with ~ frege91 . (Contributed by RP, 15-Jul-2020.)
theorem frege91d (ph: wff) (A2 B2 R: class):
  $ wi ph (wcel R cvv) $ >
  $ wi ph (wbr A2 B2 R) $ >
  $ wi ph (wbr A2 B2 (cfv R ctcl)) $;

--| If ` A ` contains all elements after those in ` U ` in the transitive closure of ` R ` , then the image under ` R ` of ` A ` is a subclass of ` A ` . Similar to Proposition 97 of [Frege1879] p. 71. Compare with ~ frege97 . (Contributed by RP, 15-Jul-2020.)
theorem frege97d (ph: wff) (A2 R U: class):
  $ wi ph (wcel R cvv) $ >
  $ wi ph (wceq A2 (cima (cfv R ctcl) U)) $ >
  $ wi ph (wss (cima R A2) A2) $;

--| If ` C ` follows ` A ` and ` B ` follows ` C ` in the transitive closure of ` R ` , then ` B ` follows ` A ` in the transitive closure of ` R ` . Similar to Proposition 98 of [Frege1879] p. 71. Compare with ~ frege98 . (Contributed by RP, 15-Jul-2020.)
theorem frege98d (ph: wff) (A2 B2 C R: class):
  $ wi ph (wcel A2 cvv) $ >
  $ wi ph (wcel B2 cvv) $ >
  $ wi ph (wcel C cvv) $ >
  $ wi ph (wbr A2 C (cfv R ctcl)) $ >
  $ wi ph (wbr C B2 (cfv R ctcl)) $ >
  $ wi ph (wbr A2 B2 (cfv R ctcl)) $;

--| If either ` A ` and ` C ` are the same or ` C ` follows ` A ` in the transitive closure of ` R ` _and_ ` B ` is the successor to ` C ` , then ` B ` follows ` A ` in the transitive closure of ` R ` . Similar to Proposition 102 of [Frege1879] p. 72. Compare with ~ frege102 . (Contributed by RP, 15-Jul-2020.)
theorem frege102d (ph: wff) (A2 B2 C R: class):
  $ wi ph (wcel R cvv) $ >
  $ wi ph (wcel A2 cvv) $ >
  $ wi ph (wcel B2 cvv) $ >
  $ wi ph (wcel C cvv) $ >
  $ wi ph (wo (wbr A2 C (cfv R ctcl)) (wceq A2 C)) $ >
  $ wi ph (wbr C B2 R) $ >
  $ wi ph (wbr A2 B2 (cfv R ctcl)) $;

--| If ` B ` follows ` A ` in ` R ` , then either ` A ` and ` B ` are the same or ` B ` follows ` A ` in ` R ` . Similar to Proposition 106 of [Frege1879] p. 73. Compare with ~ frege106 . (Contributed by RP, 15-Jul-2020.)
theorem frege106d (ph: wff) (A2 B2 R: class):
  $ wi ph (wbr A2 B2 R) $ >
  $ wi ph (wo (wbr A2 B2 R) (wceq A2 B2)) $;

--| If either ` A ` and ` C ` are the same or ` C ` follows ` A ` in the transitive closure of ` R ` _and_ ` B ` is the successor to ` C ` , then either ` A ` and ` B ` are the same or ` B ` follows ` A ` in the transitive closure of ` R ` . Similar to Proposition 108 of [Frege1879] p. 74. Compare with ~ frege108 . (Contributed by RP, 15-Jul-2020.)
theorem frege108d (ph: wff) (A2 B2 C R: class):
  $ wi ph (wcel R cvv) $ >
  $ wi ph (wcel A2 cvv) $ >
  $ wi ph (wcel B2 cvv) $ >
  $ wi ph (wcel C cvv) $ >
  $ wi ph (wo (wbr A2 C (cfv R ctcl)) (wceq A2 C)) $ >
  $ wi ph (wbr C B2 R) $ >
  $ wi ph (wo (wbr A2 B2 (cfv R ctcl)) (wceq A2 B2)) $;

--| If ` A ` contains all elements of ` U ` and all elements after those in ` U ` in the transitive closure of ` R ` , then the image under ` R ` of ` A ` is a subclass of ` A ` . Similar to Proposition 109 of [Frege1879] p. 74. Compare with ~ frege109 . (Contributed by RP, 15-Jul-2020.)
theorem frege109d (ph: wff) (A2 R U: class):
  $ wi ph (wcel R cvv) $ >
  $ wi ph (wceq A2 (cun U (cima (cfv R ctcl) U))) $ >
  $ wi ph (wss (cima R A2) A2) $;

--| If either ` R ` relates ` A ` and ` B ` or ` A ` and ` B ` are the same, then either ` A ` and ` B ` are the same, ` R ` relates ` A ` and ` B ` , ` R ` relates ` B ` and ` A ` . Similar to Proposition 114 of [Frege1879] p. 76. Compare with ~ frege114 . (Contributed by RP, 15-Jul-2020.)
theorem frege114d (ph: wff) (A2 B2 R: class):
  $ wi ph (wo (wbr A2 B2 R) (wceq A2 B2)) $ >
  $ wi ph (w3o (wbr A2 B2 R) (wceq A2 B2) (wbr B2 A2 R)) $;

--| If either ` A ` and ` C ` are the same or ` C ` follows ` A ` in the transitive closure of ` R ` _and_ ` B ` is the successor to ` C ` , then either ` A ` and ` B ` are the same or ` A ` follows ` B ` or ` B ` and ` A ` in the transitive closure of ` R ` . Similar to Proposition 111 of [Frege1879] p. 75. Compare with ~ frege111 . (Contributed by RP, 15-Jul-2020.)
theorem frege111d (ph: wff) (A2 B2 C R: class):
  $ wi ph (wcel R cvv) $ >
  $ wi ph (wcel A2 cvv) $ >
  $ wi ph (wcel B2 cvv) $ >
  $ wi ph (wcel C cvv) $ >
  $ wi ph (wo (wbr A2 C (cfv R ctcl)) (wceq A2 C)) $ >
  $ wi ph (wbr C B2 R) $ >
  $ wi ph (w3o (wbr A2 B2 (cfv R ctcl)) (wceq A2 B2) (wbr B2 A2 (cfv R ctcl))) $;

--| If ` F ` is a function, ` A ` is the successor of ` X ` , and ` B ` is the successor of ` X ` , then ` A ` and ` B ` are the same (or ` B ` follows ` A ` in the transitive closure of ` F ` ). Similar to Proposition 122 of [Frege1879] p. 79. Compare with ~ frege122 . (Contributed by RP, 15-Jul-2020.)
theorem frege122d (ph: wff) (A2 B2 F X: class):
  $ wi ph (wceq A2 (cfv X F)) $ >
  $ wi ph (wceq B2 (cfv X F)) $ >
  $ wi ph (wo (wbr A2 B2 (cfv F ctcl)) (wceq A2 B2)) $;

--| If ` F ` is a function, ` A ` is the successor of ` X ` , and ` B ` follows ` X ` in the transitive closure of ` F ` , then ` A ` and ` B ` are the same or ` B ` follows ` A ` in the transitive closure of ` F ` . Similar to Proposition 124 of [Frege1879] p. 80. Compare with ~ frege124 . (Contributed by RP, 16-Jul-2020.)
theorem frege124d (ph: wff) (A2 B2 F X: class):
  $ wi ph (wcel F cvv) $ >
  $ wi ph (wcel X (cdm F)) $ >
  $ wi ph (wceq A2 (cfv X F)) $ >
  $ wi ph (wbr X B2 (cfv F ctcl)) $ >
  $ wi ph (wfun F) $ >
  $ wi ph (wo (wbr A2 B2 (cfv F ctcl)) (wceq A2 B2)) $;

--| If ` F ` is a function, ` A ` is the successor of ` X ` , and ` B ` follows ` X ` in the transitive closure of ` F ` , then (for distinct ` A ` and ` B ` ) either ` A ` follows ` B ` or ` B ` follows ` A ` in the transitive closure of ` F ` . Similar to Proposition 126 of [Frege1879] p. 81. Compare with ~ frege126 . (Contributed by RP, 16-Jul-2020.)
theorem frege126d (ph: wff) (A2 B2 F X: class):
  $ wi ph (wcel F cvv) $ >
  $ wi ph (wcel X (cdm F)) $ >
  $ wi ph (wceq A2 (cfv X F)) $ >
  $ wi ph (wbr X B2 (cfv F ctcl)) $ >
  $ wi ph (wfun F) $ >
  $ wi ph (w3o (wbr A2 B2 (cfv F ctcl)) (wceq A2 B2) (wbr B2 A2 (cfv F ctcl))) $;

--| If ` F ` is a function and (for distinct ` A ` and ` B ` ) either ` A ` follows ` B ` or ` B ` follows ` A ` in the transitive closure of ` F ` , the successor of ` A ` is either ` B ` or it follows ` B ` or it comes before ` B ` in the transitive closure of ` F ` . Similar to Proposition 129 of [Frege1879] p. 83. Comparw with ~ frege129 . (Contributed by RP, 16-Jul-2020.)
theorem frege129d (ph: wff) (A2 B2 C F: class):
  $ wi ph (wcel F cvv) $ >
  $ wi ph (wcel A2 (cdm F)) $ >
  $ wi ph (wceq C (cfv A2 F)) $ >
  $ wi ph (w3o (wbr A2 B2 (cfv F ctcl)) (wceq A2 B2) (wbr B2 A2 (cfv F ctcl))) $ >
  $ wi ph (wfun F) $ >
  $ wi ph (w3o (wbr B2 C (cfv F ctcl)) (wceq B2 C) (wbr C B2 (cfv F ctcl))) $;

--| If ` F ` is a function and ` A ` contains all elements of ` U ` and all elements before or after those elements of ` U ` in the transitive closure of ` F ` , then the image under ` F ` of ` A ` is a subclass of ` A ` . Similar to Proposition 131 of [Frege1879] p. 85. Compare with ~ frege131 . (Contributed by RP, 17-Jul-2020.)
theorem frege131d (ph: wff) (A2 U F: class):
  $ wi ph (wcel F cvv) $ >
  $ wi ph (wceq A2 (cun U (cun (cima (ccnv (cfv F ctcl)) U) (cima (cfv F ctcl) U)))) $ >
  $ wi ph (wfun F) $ >
  $ wi ph (wss (cima F A2) A2) $;

--| If ` F ` is a function and ` A ` and ` B ` both follow ` X ` in the transitive closure of ` F ` , then (for distinct ` A ` and ` B ` ) either ` A ` follows ` B ` or ` B ` follows ` A ` in the transitive closure of ` F ` (or both if it loops). Similar to Proposition 133 of [Frege1879] p. 86. Compare with ~ frege133 . (Contributed by RP, 18-Jul-2020.)
theorem frege133d (ph: wff) (A2 B2 F X: class):
  $ wi ph (wcel F cvv) $ >
  $ wi ph (wbr X A2 (cfv F ctcl)) $ >
  $ wi ph (wbr X B2 (cfv F ctcl)) $ >
  $ wi ph (wfun F) $ >
  $ wi ph (w3o (wbr A2 B2 (cfv F ctcl)) (wceq A2 B2) (wbr B2 A2 (cfv F ctcl))) $;

--| Express exclusive-or in terms of implication and negation. Statement in [Frege1879] p. 12. (Contributed by RP, 14-Apr-2020.)
theorem dfxor4 (ph ps: wff):
  $ wb (wxo ph ps) (wn (wi (wi (wn ph) ps) (wn (wi ph (wn ps))))) $;

--| Express exclusive-or in terms of implication and negation. Statement in [Frege1879] p. 12. (Contributed by RP, 14-Apr-2020.)
theorem dfxor5 (ph ps: wff):
  $ wb (wxo ph ps) (wn (wi (wi ph (wn ps)) (wn (wi (wn ph) ps)))) $;

--| Express triple-or in terms of implication and negation. Statement in [Frege1879] p. 11. (Contributed by RP, 25-Jul-2020.)
theorem df3or2 (ph ps ch: wff):
  $ wb (w3o ph ps ch) (wi (wn ph) (wi (wn ps) ch)) $;

--| Express triple-and in terms of implication and negation. Statement in [Frege1879] p. 12. (Contributed by RP, 25-Jul-2020.)
theorem df3an2 (ph ps ch: wff):
  $ wb (w3a ph ps ch) (wn (wi ph (wi ps (wn ch)))) $;

--| Express that not every set is in a class. (Contributed by RP, 16-Apr-2020.)
theorem nev {x3: setvar} (A2: class):
  $ wb (wne A2 cvv) (wn (wal x3 (wcel (cv x3) A2))) $;

--| Express that an intersection is not empty. (Contributed by RP, 16-Apr-2020.)
theorem _0pssin {x3: setvar} (A2 B2: class):
  $ wb (wpss c0 (cin A2 B2)) (wex x3 (wa (wcel (cv x3) A2) (wcel (cv x3) B2))) $;

--| The property of relation ` R ` being hereditary in class ` A ` .
term whe (A2 R: class): wff;

--| The property of relation ` R ` being hereditary in class ` A ` . (Contributed by RP, 27-Mar-2020.)
axiom df_he (A2 R: class):
  $ wb (whe A2 R) (wss (cima R A2) A2) $;

--| The property of relation ` R ` being hereditary in class ` A ` . (Contributed by RP, 27-Mar-2020.)
theorem dfhe2 (A2 R: class):
  $ wb (whe A2 R) (wss (cres R A2) (cxp A2 A2)) $;

--| The property of relation ` R ` being hereditary in class ` A ` . (Contributed by RP, 27-Mar-2020.)
theorem dfhe3 {x3 y1: setvar} (A2 R: class):
  $ wb (whe A2 R) (wal x3 (wi (wcel (cv x3) A2) (wal y1 (wi (wbr (cv x3) (cv y1) R) (wcel (cv y1) A2))))) $;

--| Equality law for relations being herditary over a class. (Contributed by RP, 27-Mar-2020.)
theorem heeq12 (A2 B2 R S: class):
  $ wi (wa (wceq R S) (wceq A2 B2)) (wb (whe A2 R) (whe B2 S)) $;

--| Equality law for relations being herditary over a class. (Contributed by RP, 27-Mar-2020.)
theorem heeq1 (A2 R S: class):
  $ wi (wceq R S) (wb (whe A2 R) (whe A2 S)) $;

--| Equality law for relations being herditary over a class. (Contributed by RP, 27-Mar-2020.)
theorem heeq2 (A2 B2 R: class):
  $ wi (wceq A2 B2) (wb (whe A2 R) (whe B2 R)) $;

--| Distribute proper substitution through herditary relation. (Contributed by RP, 29-Jun-2020.)
theorem sbcheg {x3: setvar} (A2 B2 C V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (whe C B2) A2) (whe (csb x3 A2 C) (csb x3 A2 B2))) $;

--| Subclass law for relations being herditary over a class. (Contributed by RP, 27-Mar-2020.)
theorem hess (A2 R S: class):
  $ wi (wss S R) (wi (whe A2 R) (whe A2 S)) $;

--| Any Cartesian product is hereditary in its second class. (Contributed by RP, 27-Mar-2020.) (Proof shortened by OpenAI, 3-Jul-2020.)
theorem xphe (A2 B2: class):
  $ whe B2 (cxp A2 B2) $;

--| The empty relation is hereditary in any class. (Contributed by RP, 27-Mar-2020.)
theorem _0he (A2: class):
  $ whe A2 c0 $;

--| The empty relation is hereditary in any class. (Contributed by RP, 27-Mar-2020.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem _0heALT (A2: class):
  $ whe A2 c0 $;

--| Any relation is hereditary in the empty set. (Contributed by RP, 27-Mar-2020.)
theorem he0 (A2: class):
  $ whe c0 A2 $;

--| The union of two relations hereditary in a class is also hereditary in a class. (Contributed by RP, 28-Mar-2020.)
theorem unhe1 (A2 R S: class):
  $ wi (wa (whe A2 R) (whe A2 S)) (whe A2 (cun R S)) $;

--| Any singleton is hereditary in any singleton. (Contributed by RP, 28-Mar-2020.)
theorem snhesn (A2 B2: class):
  $ whe (csn B2) (csn (cop A2 A2)) $;

--| The identity relation is hereditary in any class. (Contributed by RP, 28-Mar-2020.)
theorem idhe (A2: class):
  $ whe A2 cid $;

--| The relation between sets and their proper subsets is hereditary in the powerclass of any class. (Contributed by RP, 28-Mar-2020.)
theorem psshepw (A2: class):
  $ whe (cpw A2) (ccnv crpss) $;

--| The relation between sets and their subsets is hereditary in the powerclass of any class. (Contributed by RP, 28-Mar-2020.)
theorem sshepw (A2: class):
  $ whe (cpw A2) (cun (ccnv crpss) cid) $;

--| The case in which ` ph ` is denied, ` ps ` is affirmed, and ` ph ` is affirmed is excluded. This is evident since ` ph ` cannot at the same time be denied and affirmed. Axiom 1 of [Frege1879] p. 26. Identical to ~ ax-1 . (Contributed by RP, 24-Dec-2019.) (New usage is discouraged.)
axiom ax_frege1 (ph ps: wff):
  $ wi ph (wi ps ph) $;

--| If a proposition ` ch ` is a necessary consequence of two propositions ` ps ` and ` ph ` and one of those, ` ps ` , is in turn a necessary consequence of the other, ` ph ` , then the proposition ` ch ` is a necessary consequence of the latter one, ` ph ` , alone. Axiom 2 of [Frege1879] p. 26. Identical to ~ ax-2 . (Contributed by RP, 24-Dec-2019.) (New usage is discouraged.)
axiom ax_frege2 (ph ps ch: wff):
  $ wi (wi ph (wi ps ch)) (wi (wi ph ps) (wi ph ch)) $;

--| Simplification of triple conjunction. Compare with ~ simp2 . (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem rp_simp2_frege (ph ps ch: wff):
  $ wi ph (wi ps (wi ch ps)) $;

--| Simplification of triple conjunction. Identical to ~ simp2 . (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem rp_simp2 (ph ps ch: wff):
  $ wi (w3a ph ps ch) ps $;

--| Add antecedent to ~ ax-frege2 . More general statement than ~ frege3 . Like ~ ax-frege2 , it is essentially a closed form of ~ mpd , however it has an extra antecedent. It would be more natural to prove from ~ a1i and ~ ax-frege2 in Metamath. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem rp_frege3g (ph ps ch th: wff):
  $ wi ph (wi (wi ps (wi ch th)) (wi (wi ps ch) (wi ps th))) $;

--| Add antecedent to ~ ax-frege2 . Special case of ~ rp-frege3g . Proposition 3 of [Frege1879] p. 29. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege3 (ph ps ch: wff):
  $ wi (wi ph ps) (wi (wi ch (wi ph ps)) (wi (wi ch ph) (wi ch ps))) $;

--| Double-use of ~ ax-frege2 . (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem rp_misc1_frege (ph ps ch: wff):
  $ wi (wi (wi ph (wi ps ch)) (wi ph ps)) (wi (wi ph (wi ps ch)) (wi ph ch)) $;

--| Introducing an embedded antecedent. Alternate proof for ~ frege24 . Closed form for ~ a1d . (Contributed by RP, 24-Dec-2019.)
theorem rp_frege24 (ph ps ch: wff):
  $ wi (wi ph ps) (wi ph (wi ch ps)) $;

--| Deduction related to distribution. (Contributed by RP, 24-Dec-2019.)
theorem rp_frege4g (ph ps ch th: wff):
  $ wi (wi ph (wi ps (wi ch th))) (wi ph (wi (wi ps ch) (wi ps th))) $;

--| Special case of closed form of ~ a2d . Special case of ~ rp-frege4g . Proposition 4 of [Frege1879] p. 31. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege4 (ph ps ch: wff):
  $ wi (wi (wi ph ps) (wi ch (wi ph ps))) (wi (wi ph ps) (wi (wi ch ph) (wi ch ps))) $;

--| A closed form of ~ syl . Identical to ~ imim2 . Theorem *2.05 of [WhiteheadRussell] p. 100. Proposition 5 of [Frege1879] p. 32. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege5 (ph ps ch: wff):
  $ wi (wi ph ps) (wi (wi ch ph) (wi ch ps)) $;

--| Distribute antecedent and add another. (Contributed by RP, 24-Dec-2019.)
theorem rp_7frege (ph ps ch th: wff):
  $ wi (wi ph (wi ps ch)) (wi th (wi (wi ph ps) (wi ph ch))) $;

--| Elimination of a nested antecedent of special form. (Contributed by RP, 24-Dec-2019.)
theorem rp_4frege (ph ps ch: wff):
  $ wi (wi ph (wi (wi ps ph) ch)) (wi ph ch) $;

--| Elimination of a nested antecedent of special form. (Contributed by RP, 24-Dec-2019.)
theorem rp_6frege (ph ps ch th: wff):
  $ wi ph (wi (wi ps (wi (wi ch ps) th)) (wi ps th)) $;

--| Eliminate antecedent when it is implied by previous antecedent. (Contributed by RP, 24-Dec-2019.)
theorem rp_8frege (ph ps ch th: wff):
  $ wi (wi ph (wi ps (wi (wi ch ps) th))) (wi ph (wi ps th)) $;

--| Closed form for ~ a1dd . Alternate route to Proposition 25 of [Frege1879] p. 42. (Contributed by RP, 24-Dec-2019.)
theorem rp_frege25 (ph ps ch th: wff):
  $ wi (wi ph (wi ps ch)) (wi ph (wi ps (wi th ch))) $;

--| A closed form of ~ imim2d which is a deduction adding nested antecedents. Proposition 6 of [Frege1879] p. 33. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege6 (ph ps ch th: wff):
  $ wi (wi ph (wi ps ch)) (wi ph (wi (wi th ps) (wi th ch))) $;

--| Swap antecedents. Identical to ~ pm2.04 . This demonstrates that Axiom 8 of [Frege1879] p. 35 is redundant. Proof follows closely proof of ~ pm2.04 in ~ https://us.metamath.org/mmsolitaire/pmproofs.txt , but in the style of Frege's 1879 work. (Contributed by RP, 24-Dec-2019.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem axfrege8 (ph ps ch: wff):
  $ wi (wi ph (wi ps ch)) (wi ps (wi ph ch)) $;

--| A closed form of ~ syl6 . The first antecedent is used to replace the consequent of the second antecedent. Proposition 7 of [Frege1879] p. 34. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege7 (ph ps ch th: wff):
  $ wi (wi ph ps) (wi (wi ch (wi th ph)) (wi ch (wi th ps))) $;

--| Swap antecedents. If two conditions have a proposition as a consequence, their order is immaterial. Third axiom of Frege's 1879 work but identical to ~ pm2.04 which can be proved from only ~ ax-mp , ~ ax-frege1 , and ~ ax-frege2 . (Redundant) Axiom 8 of [Frege1879] p. 35. (Contributed by RP, 24-Dec-2019.) (New usage is discouraged.)
axiom ax_frege8 (ph ps ch: wff):
  $ wi (wi ph (wi ps ch)) (wi ps (wi ph ch)) $;

--| Identical to ~ idd . Proposition 26 of [Frege1879] p. 42. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege26 (ph ps: wff):
  $ wi ph (wi ps ps) $;

--| We cannot (at the same time) affirm ` ph ` and deny ` ph ` . Identical to ~ id . Proposition 27 of [Frege1879] p. 43. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege27 (ph: wff):
  $ wi ph ph $;

--| Closed form of ~ syl with swapped antecedents. This proposition differs from ~ frege5 only in an unessential way. Identical to ~ imim1 . Proposition 9 of [Frege1879] p. 35. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege9 (ph ps ch: wff):
  $ wi (wi ph ps) (wi (wi ps ch) (wi ph ch)) $;

--| A closed form of ~ com23 . Proposition 12 of [Frege1879] p. 37. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege12 (ph ps ch th: wff):
  $ wi (wi ph (wi ps (wi ch th))) (wi ph (wi ch (wi ps th))) $;

--| Elimination of a nested antecedent as a partial converse of ~ ja . If the proposition that ` ps ` takes place or ` ph ` does not is a sufficient condition for ` ch ` , then ` ps ` by itself is a sufficient condition for ` ch ` . Identical to ~ jarr . Proposition 11 of [Frege1879] p. 36. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege11 (ph ps ch: wff):
  $ wi (wi (wi ph ps) ch) (wi ps ch) $;

--| Closed form for ~ a1d . Deduction introducing an embedded antecedent. Identical to ~ rp-frege24 which was proved without relying on ~ ax-frege8 . Proposition 24 of [Frege1879] p. 42. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege24 (ph ps ch: wff):
  $ wi (wi ph ps) (wi ph (wi ch ps)) $;

--| A closed form of ~ com34 . Proposition 16 of [Frege1879] p. 38. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege16 (ph ps ch th ta: wff):
  $ wi (wi ph (wi ps (wi ch (wi th ta)))) (wi ph (wi ps (wi th (wi ch ta)))) $;

--| Closed form for ~ a1dd . Proposition 25 of [Frege1879] p. 42. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege25 (ph ps ch th: wff):
  $ wi (wi ph (wi ps ch)) (wi ph (wi ps (wi th ch))) $;

--| Closed form of a syllogism followed by a swap of antecedents. Proposition 18 of [Frege1879] p. 39. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege18 (ph ps ch th: wff):
  $ wi (wi ph (wi ps ch)) (wi (wi th ph) (wi ps (wi th ch))) $;

--| A closed form of ~ com45 . Proposition 22 of [Frege1879] p. 41. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege22 (ph ps ch th ta et: wff):
  $ wi (wi ph (wi ps (wi ch (wi th (wi ta et))))) (wi ph (wi ps (wi ch (wi ta (wi th et))))) $;

--| Result commuting antecedents within an antecedent. Proposition 10 of [Frege1879] p. 36. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege10 (ph ps ch th: wff):
  $ wi (wi (wi ph (wi ps ch)) th) (wi (wi ps (wi ph ch)) th) $;

--| A closed form of ~ com3l . Proposition 17 of [Frege1879] p. 39. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege17 (ph ps ch th: wff):
  $ wi (wi ph (wi ps (wi ch th))) (wi ps (wi ch (wi ph th))) $;

--| A closed form of ~ com3r . Proposition 13 of [Frege1879] p. 37. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege13 (ph ps ch th: wff):
  $ wi (wi ph (wi ps (wi ch th))) (wi ch (wi ph (wi ps th))) $;

--| Closed form of a deduction based on ~ com3r . Proposition 14 of [Frege1879] p. 37. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege14 (ph ps ch th ta: wff):
  $ wi (wi ph (wi ps (wi ch (wi th ta)))) (wi ph (wi th (wi ps (wi ch ta)))) $;

--| A closed form of ~ syl6 . Proposition 19 of [Frege1879] p. 39. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege19 (ph ps ch th: wff):
  $ wi (wi ph (wi ps ch)) (wi (wi ch th) (wi ph (wi ps th))) $;

--| Syllogism followed by rotation of three antecedents. Proposition 23 of [Frege1879] p. 42. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege23 (ph ps ch th ta: wff):
  $ wi (wi ph (wi ps (wi ch th))) (wi (wi ta ph) (wi ps (wi ch (wi ta th)))) $;

--| A closed form of ~ com4r . Proposition 15 of [Frege1879] p. 38. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege15 (ph ps ch th ta: wff):
  $ wi (wi ph (wi ps (wi ch (wi th ta)))) (wi th (wi ph (wi ps (wi ch ta)))) $;

--| Replace antecedent in antecedent. Proposition 21 of [Frege1879] p. 40. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege21 (ph ps ch th: wff):
  $ wi (wi (wi ph ps) ch) (wi (wi ph th) (wi (wi th ps) ch)) $;

--| A closed form of ~ syl8 . Proposition 20 of [Frege1879] p. 40. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege20 (ph ps ch th ta: wff):
  $ wi (wi ph (wi ps (wi ch th))) (wi (wi th ta) (wi ph (wi ps (wi ch ta)))) $;

--| Contraposition. Identical to ~ con3 . Theorem *2.16 of [WhiteheadRussell] p. 103. (Contributed by RP, 24-Dec-2019.)
theorem axfrege28 (ph ps: wff):
  $ wi (wi ph ps) (wi (wn ps) (wn ph)) $;

--| Contraposition. Identical to ~ con3 . Theorem *2.16 of [WhiteheadRussell] p. 103. Axiom 28 of [Frege1879] p. 43. (Contributed by RP, 24-Dec-2019.) (New usage is discouraged.)
axiom ax_frege28 (ph ps: wff):
  $ wi (wi ph ps) (wi (wn ps) (wn ph)) $;

--| Closed form of ~ con3d . Proposition 29 of [Frege1879] p. 43. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege29 (ph ps ch: wff):
  $ wi (wi ph (wi ps ch)) (wi ph (wi (wn ch) (wn ps))) $;

--| Commuted, closed form of ~ con3d . Proposition 30 of [Frege1879] p. 44. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege30 (ph ps ch: wff):
  $ wi (wi ph (wi ps ch)) (wi ps (wi (wn ch) (wn ph))) $;

--| Identical to ~ notnotr . Axiom 31 of [Frege1879] p. 44. (Contributed by RP, 24-Dec-2019.)
theorem axfrege31 (ph: wff):
  $ wi (wn (wn ph)) ph $;

--| ` ph ` cannot be denied and (at the same time ) ` -. -. ph ` affirmed. Duplex negatio affirmat. The denial of the denial is affirmation. Identical to ~ notnotr . Axiom 31 of [Frege1879] p. 44. (Contributed by RP, 24-Dec-2019.) (New usage is discouraged.)
axiom ax_frege31 (ph: wff):
  $ wi (wn (wn ph)) ph $;

--| Deduce ~ con1 from ~ con3 . Proposition 32 of [Frege1879] p. 44. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege32 (ph ps: wff):
  $ wi (wi (wi (wn ph) ps) (wi (wn ps) (wn (wn ph)))) (wi (wi (wn ph) ps) (wi (wn ps) ph)) $;

--| If ` ph ` or ` ps ` takes place, then ` ps ` or ` ph ` takes place. Identical to ~ con1 . Proposition 33 of [Frege1879] p. 44. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege33 (ph ps: wff):
  $ wi (wi (wn ph) ps) (wi (wn ps) ph) $;

--| If as a consequence of the occurrence of the circumstance ` ph ` , when the obstacle ` ps ` is removed, ` ch ` takes place, then from the circumstance that ` ch ` does not take place while ` ph ` occurs the occurrence of the obstacle ` ps ` can be inferred. Closed form of ~ con1d . Proposition 34 of [Frege1879] p. 45. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege34 (ph ps ch: wff):
  $ wi (wi ph (wi (wn ps) ch)) (wi ph (wi (wn ch) ps)) $;

--| Commuted, closed form of ~ con1d . Proposition 35 of [Frege1879] p. 45. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege35 (ph ps ch: wff):
  $ wi (wi ph (wi (wn ps) ch)) (wi (wn ch) (wi ph ps)) $;

--| The case in which ` ps ` is denied, ` -. ph ` is affirmed, and ` ph ` is affirmed does not occur. If ` ph ` occurs, then (at least) one of the two, ` ph ` or ` ps ` , takes place (no matter what ` ps ` might be). Identical to ~ pm2.24 . Proposition 36 of [Frege1879] p. 45. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege36 (ph ps: wff):
  $ wi ph (wi (wn ph) ps) $;

--| If ` ch ` is a necessary consequence of the occurrence of ` ps ` or ` ph ` , then ` ch ` is a necessary consequence of ` ph ` alone. Similar to a closed form of ~ orcs . Proposition 37 of [Frege1879] p. 46. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege37 (ph ps ch: wff):
  $ wi (wi (wi (wn ph) ps) ch) (wi ph ch) $;

--| Identical to ~ pm2.21 . Proposition 38 of [Frege1879] p. 46. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege38 (ph ps: wff):
  $ wi (wn ph) (wi ph ps) $;

--| Syllogism between ~ pm2.18 and ~ pm2.24 . Proposition 39 of [Frege1879] p. 46. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege39 (ph ps: wff):
  $ wi (wi (wn ph) ph) (wi (wn ph) ps) $;

--| Anything implies ~ pm2.18 . Proposition 40 of [Frege1879] p. 46. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege40 (ph ps: wff):
  $ wi (wn ph) (wi (wi (wn ps) ps) ps) $;

--| Identical to ~ notnot . Axiom 41 of [Frege1879] p. 47. (Contributed by RP, 24-Dec-2019.)
theorem axfrege41 (ph: wff):
  $ wi ph (wn (wn ph)) $;

--| The affirmation of ` ph ` denies the denial of ` ph ` . Identical to ~ notnot . Axiom 41 of [Frege1879] p. 47. (Contributed by RP, 24-Dec-2019.) (New usage is discouraged.)
axiom ax_frege41 (ph: wff):
  $ wi ph (wn (wn ph)) $;

--| Not not ~ id . Proposition 42 of [Frege1879] p. 47. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege42 (ph: wff):
  $ wn (wn (wi ph ph)) $;

--| If there is a choice only between ` ph ` and ` ph ` , then ` ph ` takes place. Identical to ~ pm2.18 . Proposition 43 of [Frege1879] p. 47. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege43 (ph: wff):
  $ wi (wi (wn ph) ph) ph $;

--| Similar to a commuted ~ pm2.62 . Proposition 44 of [Frege1879] p. 47. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege44 (ph ps: wff):
  $ wi (wi (wn ph) ps) (wi (wi ps ph) ph) $;

--| Deduce ~ pm2.6 from ~ con1 . Proposition 45 of [Frege1879] p. 47. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege45 (ph ps: wff):
  $ wi (wi (wi (wn ph) ps) (wi (wn ps) ph)) (wi (wi (wn ph) ps) (wi (wi ph ps) ps)) $;

--| If ` ps ` holds when ` ph ` occurs as well as when ` ph ` does not occur, then ` ps ` holds. If ` ps ` or ` ph ` occurs and if the occurrences of ` ph ` has ` ps ` as a necessary consequence, then ` ps ` takes place. Identical to ~ pm2.6 . Proposition 46 of [Frege1879] p. 48. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege46 (ph ps: wff):
  $ wi (wi (wn ph) ps) (wi (wi ph ps) ps) $;

--| Deduce consequence follows from either path implied by a disjunction. If ` ph ` , as well as ` ps ` is sufficient condition for ` ch ` and ` ps ` or ` ph ` takes place, then the proposition ` ch ` holds. Proposition 47 of [Frege1879] p. 48. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege47 (ph ps ch: wff):
  $ wi (wi (wn ph) ps) (wi (wi ps ch) (wi (wi ph ch) ch)) $;

--| Closed form of syllogism with internal disjunction. If ` ph ` is a sufficient condition for the occurrence of ` ch ` or ` ps ` and if ` ch ` , as well as ` ps ` , is a sufficient condition for ` th ` , then ` ph ` is a sufficient condition for ` th ` . See application in ~ frege101 . Proposition 48 of [Frege1879] p. 49. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege48 (ph ps ch th: wff):
  $ wi (wi ph (wi (wn ps) ch)) (wi (wi ch th) (wi (wi ps th) (wi ph th))) $;

--| Closed form of deduction with disjunction. Proposition 49 of [Frege1879] p. 49. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege49 (ph ps ch: wff):
  $ wi (wi (wn ph) ps) (wi (wi ph ch) (wi (wi ps ch) ch)) $;

--| Closed form of ~ jaoi . Proposition 50 of [Frege1879] p. 49. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege50 (ph ps ch: wff):
  $ wi (wi ph ps) (wi (wi ch ps) (wi (wi (wn ph) ch) ps)) $;

--| Compare with ~ jaod . Proposition 51 of [Frege1879] p. 50. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege51 (ph ps ch th: wff):
  $ wi (wi ph (wi ps ch)) (wi (wi th ch) (wi ph (wi (wi (wn ps) th) ch))) $;

--| Justification for ~ ax-frege52a . (Contributed by RP, 17-Apr-2020.)
theorem axfrege52a (ph ps ch th: wff):
  $ wi (wb ph ps) (wi (wif ph th ch) (wif ps th ch)) $;

--| The case when the content of ` ph ` is identical with the content of ` ps ` and in which a proposition controlled by an element for which we substitute the content of ` ph ` is affirmed (in this specific case the identity logical function) and the same proposition, this time where we substituted the content of ` ps ` , is denied does not take place. Part of Axiom 52 of [Frege1879] p. 50. (Contributed by RP, 24-Dec-2019.) (New usage is discouraged.)
axiom ax_frege52a (ph ps ch th: wff):
  $ wi (wb ph ps) (wi (wif ph th ch) (wif ps th ch)) $;

--| The case when the content of ` ph ` is identical with the content of ` ps ` and in which ` ph ` is affirmed and ` ps ` is denied does not take place. Identical to ~ biimp . Part of Axiom 52 of [Frege1879] p. 50. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege52aid (ph ps: wff):
  $ wi (wb ph ps) (wi ph ps) $;

--| Specialization of ~ frege53a . Proposition 53 of [Frege1879] p. 50. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege53aid (ph ps: wff):
  $ wi ph (wi (wb ph ps) ps) $;

--| Lemma for ~ frege55a . Proposition 53 of [Frege1879] p. 50. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege53a (ph ps ch th: wff):
  $ wi (wif ph th ch) (wi (wb ph ps) (wif ps th ch)) $;

--| Justification for ~ ax-frege54a . Identical to ~ biid . (Contributed by RP, 24-Dec-2019.)
theorem axfrege54a (ph: wff):
  $ wb ph ph $;

--| Reflexive equality of wffs. The content of ` ph ` is identical with the content of ` ph ` . Part of Axiom 54 of [Frege1879] p. 50. Identical to ~ biid . (Contributed by RP, 24-Dec-2019.) (New usage is discouraged.)
axiom ax_frege54a (ph: wff):
  $ wb ph ph $;

--| Synonym for logical equivalence. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege54cor0a (ph ps: wff):
  $ wb (wb ps ph) (wif ps ph (wn ph)) $;

--| Reflexive equality. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege54cor1a (ph: wff):
  $ wif ph ph (wn ph) $;

--| Lemma for ~ frege57aid . Core proof of Proposition 55 of [Frege1879] p. 50. (Contributed by RP, 24-Dec-2019.)
theorem frege55aid (ph ps: wff):
  $ wi (wb ph ps) (wb ps ph) $;

--| Necessary deduction regarding substitution of value in equality. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege55lem1a (ph ps ta: wff):
  $ wi (wi ta (wif ps ph (wn ph))) (wi ta (wb ps ph)) $;

--| Core proof of Proposition 55 of [Frege1879] p. 50. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege55lem2a (ph ps: wff):
  $ wi (wb ph ps) (wif ps ph (wn ph)) $;

--| Proposition 55 of [Frege1879] p. 50. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege55a (ph ps: wff):
  $ wi (wb ph ps) (wif ps ph (wn ph)) $;

--| Proposition 55 of [Frege1879] p. 50. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege55cor1a (ph ps: wff):
  $ wi (wb ph ps) (wb ps ph) $;

--| Lemma for ~ frege57aid . Proposition 56 of [Frege1879] p. 50. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege56aid (ph ps: wff):
  $ wi (wi (wb ph ps) (wi ph ps)) (wi (wb ps ph) (wi ph ps)) $;

--| Proposition 56 of [Frege1879] p. 50. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege56a (ph ps ch th: wff):
  $ wi (wi (wb ph ps) (wi (wif ph ch th) (wif ps ch th))) (wi (wb ps ph) (wi (wif ph ch th) (wif ps ch th))) $;

--| This is the all important formula which allows to apply Frege-style definitions and explore their consequences. A closed form of ~ biimpri . Proposition 57 of [Frege1879] p. 51. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege57aid (ph ps: wff):
  $ wi (wb ph ps) (wi ps ph) $;

--| Analogue of ~ frege57aid . Proposition 57 of [Frege1879] p. 51. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege57a (ph ps ch th: wff):
  $ wi (wb ph ps) (wi (wif ps ch th) (wif ph ch th)) $;

--| Identical to ~ anifp . Justification for ~ ax-frege58a . (Contributed by RP, 28-Mar-2020.)
theorem axfrege58a (ph ps ch: wff):
  $ wi (wa ps ch) (wif ph ps ch) $;

--| If ` A. x ph ` is affirmed, ` [ y / x ] ph ` cannot be denied. Identical to ~ stdpc4 . Axiom 58 of [Frege1879] p. 51. (Contributed by RP, 28-Mar-2020.) (New usage is discouraged.)
axiom ax_frege58a (ph ps ch: wff):
  $ wi (wa ps ch) (wif ph ps ch) $;

--| Lemma for ~ frege59a . (Contributed by RP, 17-Apr-2020.) (Proof modification is discouraged.)
theorem frege58acor (ph ps ch th ta: wff):
  $ wi (wa (wi ps ch) (wi th ta)) (wi (wif ph ps th) (wif ph ch ta)) $;

--| A kind of Aristotelian inference. Namely Felapton or Fesapo. Proposition 59 of [Frege1879] p. 51. _Note_: in the Bauer-Meenfelberg translation published in van Heijenoort's collection _From Frege to Goedel_, this proof has the ~ frege12 incorrectly referenced where ~ frege30 is in the original. (Contributed by RP, 17-Apr-2020.) (Proof modification is discouraged.)
theorem frege59a (ph ps ch th ta: wff):
  $ wi (wif ph ps th) (wi (wn (wif ph ch ta)) (wn (wa (wi ps ch) (wi th ta)))) $;

--| Swap antecedents of ~ ax-frege58a . Proposition 60 of [Frege1879] p. 52. (Contributed by RP, 17-Apr-2020.) (Proof modification is discouraged.)
theorem frege60a (ph ps ch th ta et ze: wff):
  $ wi (wa (wi ps (wi ch th)) (wi ta (wi et ze))) (wi (wif ph ch et) (wi (wif ph ps ta) (wif ph th ze))) $;

--| Lemma for ~ frege65a . Proposition 61 of [Frege1879] p. 52. (Contributed by RP, 17-Apr-2020.) (Proof modification is discouraged.)
theorem frege61a (ph ps ch th: wff):
  $ wi (wi (wif ph ps ch) th) (wi (wa ps ch) th) $;

--| A kind of Aristotelian inference. This judgement replaces the mode of inference ~ barbara when the minor premise has a particular context. Proposition 62 of [Frege1879] p. 52. (Contributed by RP, 17-Apr-2020.) (Proof modification is discouraged.)
theorem frege62a (ph ps ch th ta: wff):
  $ wi (wif ph ps th) (wi (wa (wi ps ch) (wi th ta)) (wif ph ch ta)) $;

--| Proposition 63 of [Frege1879] p. 52. (Contributed by RP, 17-Apr-2020.) (Proof modification is discouraged.)
theorem frege63a (ph ps ch th ta et: wff):
  $ wi (wif ph ps th) (wi et (wi (wa (wi ps ch) (wi th ta)) (wif ph ch ta))) $;

--| Lemma for ~ frege65a . Proposition 64 of [Frege1879] p. 53. (Contributed by RP, 17-Apr-2020.) (Proof modification is discouraged.)
theorem frege64a (ph ps ch th ta et ze si: wff):
  $ wi (wi (wif ph ps ta) (wif si ch et)) (wi (wa (wi ch th) (wi et ze)) (wi (wif ph ps ta) (wif si th ze))) $;

--| A kind of Aristotelian inference. This judgement replaces the mode of inference ~ barbara when the minor premise has a general context. Proposition 65 of [Frege1879] p. 53. (Contributed by RP, 17-Apr-2020.) (Proof modification is discouraged.)
theorem frege65a (ph ps ch th ta et ze: wff):
  $ wi (wa (wi ps ch) (wi ta et)) (wi (wa (wi ch th) (wi et ze)) (wi (wif ph ps ta) (wif ph th ze))) $;

--| Swap antecedents of ~ frege65a . Proposition 66 of [Frege1879] p. 54. (Contributed by RP, 17-Apr-2020.) (Proof modification is discouraged.)
theorem frege66a (ph ps ch th ta et ze: wff):
  $ wi (wa (wi ch th) (wi et ze)) (wi (wa (wi ps ch) (wi ta et)) (wi (wif ph ps ta) (wif ph th ze))) $;

--| Lemma for ~ frege68a . Proposition 67 of [Frege1879] p. 54. (Contributed by RP, 17-Apr-2020.) (Proof modification is discouraged.)
theorem frege67a (ph ps ch th: wff):
  $ wi (wi (wb (wa ps ch) th) (wi th (wa ps ch))) (wi (wb (wa ps ch) th) (wi th (wif ph ps ch))) $;

--| Combination of applying a definition and applying it to a specific instance. Proposition 68 of [Frege1879] p. 54. (Contributed by RP, 17-Apr-2020.) (Proof modification is discouraged.)
theorem frege68a (ph ps ch th: wff):
  $ wi (wb (wa ps ch) th) (wi th (wif ph ps ch)) $;

--| Justification for ~ ax-frege52c . (Contributed by RP, 24-Dec-2019.)
theorem axfrege52c {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wi (wceq A2 B2) (wi (wsbc x3 ph A2) (wsbc x3 ph B2)) $;

--| One side of ~ dfsbcq . Part of Axiom 52 of [Frege1879] p. 50. (Contributed by RP, 24-Dec-2019.) (New usage is discouraged.)
axiom ax_frege52c {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wi (wceq A2 B2) (wi (wsbc x3 ph A2) (wsbc x3 ph B2)) $;

--| The case when the content of ` x ` is identical with the content of ` y ` and in which a proposition controlled by an element for which we substitute the content of ` x ` is affirmed and the same proposition, this time where we substitute the content of ` y ` , is denied does not take place. In ` [ x / z ] ph ` , ` x ` can also occur in other than the argument ( ` z ` ) places. Hence ` x ` may still be contained in ` [ y / z ] ph ` . Part of Axiom 52 of [Frege1879] p. 50. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege52b {z: setvar} (ph: wff z) (x3 y1: setvar):
  $ wi (wceq (cv x3) (cv y1)) (wi (wsb z ph x3) (wsb z ph y1)) $;

--| Lemma for frege102 (via ~ frege92 ). Proposition 53 of [Frege1879] p. 50. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege53b {x3: setvar} (ph: wff x3) (y1 z: setvar):
  $ wi (wsb x3 ph y1) (wi (wceq (cv y1) (cv z)) (wsb x3 ph z)) $;

--| Reflexive equality of classes. Identical to ~ eqid . Justification for ~ ax-frege54c . (Contributed by RP, 24-Dec-2019.)
theorem axfrege54c (A2: class):
  $ wceq A2 A2 $;

--| Reflexive equality of sets (as classes). Part of Axiom 54 of [Frege1879] p. 50. Identical to ~ eqid . (Contributed by RP, 24-Dec-2019.) (New usage is discouraged.)
axiom ax_frege54c (A2: class):
  $ wceq A2 A2 $;

--| Reflexive equality of sets. The content of ` x ` is identical with the content of ` x ` . Part of Axiom 54 of [Frege1879] p. 50. Slightly specialized version of ~ eqid . (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege54b (x3: setvar):
  $ wceq (cv x3) (cv x3) $;

--| Reflexive equality. (Contributed by RP, 24-Dec-2019.)
theorem frege54cor1b {x3 y1: setvar}:
  $ wsb y1 (wceq (cv y1) (cv x3)) x3 $;

--| Necessary deduction regarding substitution of value in equality. (Contributed by RP, 24-Dec-2019.)
theorem frege55lem1b {x3 y1: setvar} (ph: wff x3 y1) (z: setvar):
  $ wi (wi ph (wsb y1 (wceq (cv y1) (cv z)) x3)) (wi ph (wceq (cv x3) (cv z))) $;

--| Lemma for ~ frege55b . Core proof of Proposition 55 of [Frege1879] p. 50. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege55lem2b {x3 z: setvar} (y1: setvar):
  $ wi (wceq (cv x3) (cv y1)) (wsb z (wceq (cv z) (cv x3)) y1) $;

--| Lemma for ~ frege57b . Proposition 55 of [Frege1879] p. 50. Note that ~ eqtr2 incorporates ~ eqcom which is stronger than this proposition which is identical to ~ equcomi . Is it possible that Frege tricked himself into assuming what he was out to prove? (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege55b {x3 y1: setvar}:
  $ wi (wceq (cv x3) (cv y1)) (wceq (cv y1) (cv x3)) $;

--| Lemma for ~ frege57b . Proposition 56 of [Frege1879] p. 50. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege56b {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi (wi (wceq (cv x3) (cv y1)) (wi (wsb z ph x3) (wsb z ph y1))) (wi (wceq (cv y1) (cv x3)) (wi (wsb z ph x3) (wsb z ph y1))) $;

--| Analogue of ~ frege57aid . Proposition 57 of [Frege1879] p. 51. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege57b {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi (wceq (cv x3) (cv y1)) (wi (wsb z ph y1) (wsb z ph x3)) $;

--| If ` A. x ph ` is affirmed, ` [ y / x ] ph ` cannot be denied. Identical to ~ stdpc4 . Justification for ~ ax-frege58b . (Contributed by RP, 28-Mar-2020.)
theorem axfrege58b {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 ph) (wsb x3 ph y1) $;

--| If ` A. x ph ` is affirmed, ` [ y / x ] ph ` cannot be denied. Identical to ~ stdpc4 . Axiom 58 of [Frege1879] p. 51. (Contributed by RP, 28-Mar-2020.) (New usage is discouraged.)
axiom ax_frege58b {x3: setvar} (ph: wff x3) (y1: setvar):
  $ wi (wal x3 ph) (wsb x3 ph y1) $;

--| If ` A. x ph ` is affirmed, ` [ y / x ] ph ` cannot be denied. Identical to ~ stdpc4 . Axiom 58 of [Frege1879] p. 51. (Contributed by RP, 28-Mar-2020.) (New usage is discouraged.)
axiom ax_frege58b_b {x3: setvar} (ph: wff x3):
  $ wi (wal x3 ph) (wsb x3 ph x3) $;

--| If ` A. x ph ` is affirmed, ` ph ` cannot be denied. Identical to ~ sp . See ~ ax-frege58b and ~ frege58c for versions which more closely track the original. Axiom 58 of [Frege1879] p. 51. (Contributed by RP, 28-Mar-2020.) (Proof modification is discouraged.)
theorem frege58bid {x3: setvar} (ph: wff x3):
  $ wi (wal x3 ph) ph $;

--| Lemma for ~ frege59b . (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege58bcor {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wal x3 (wi ph ps)) (wi (wsb x3 ph y1) (wsb x3 ps y1)) $;

--| A kind of Aristotelian inference. Namely Felapton or Fesapo. Proposition 59 of [Frege1879] p. 51. _Note_: in the Bauer-Meenfelberg translation published in van Heijenoort's collection _From Frege to Goedel_, this proof has the ~ frege12 incorrectly referenced where ~ frege30 is in the original. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege59b {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wsb x3 ph y1) (wi (wn (wsb x3 ps y1)) (wn (wal x3 (wi ph ps)))) $;

--| Swap antecedents of ~ ax-frege58b . Proposition 60 of [Frege1879] p. 52. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege60b {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wi (wal x3 (wi ph (wi ps ch))) (wi (wsb x3 ps y1) (wi (wsb x3 ph y1) (wsb x3 ch y1))) $;

--| Lemma for ~ frege65b . Proposition 61 of [Frege1879] p. 52. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege61b {y1: setvar} (ph ps: wff y1) (x3: setvar):
  $ wi (wi (wsb y1 ph x3) ps) (wi (wal y1 ph) ps) $;

--| A kind of Aristotelian inference. This judgement replaces the mode of inference ~ barbara when the minor premise has a particular context. Proposition 62 of [Frege1879] p. 52. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege62b {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wsb x3 ph y1) (wi (wal x3 (wi ph ps)) (wsb x3 ps y1)) $;

--| Lemma for ~ frege91 . Proposition 63 of [Frege1879] p. 52. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege63b {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wi (wsb x3 ph y1) (wi ps (wi (wal x3 (wi ph ch)) (wsb x3 ch y1))) $;

--| Lemma for ~ frege65b . Proposition 64 of [Frege1879] p. 53. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege64b {y1 z: setvar} (ph ps ch: wff y1 z) (x3: setvar):
  $ wi (wi (wsb y1 ph x3) (wsb y1 ps z)) (wi (wal y1 (wi ps ch)) (wi (wsb y1 ph x3) (wsb y1 ch z))) $;

--| Lemma for ~ frege65b . Proposition 64 of [Frege1879] p. 53. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege64b_b {y1 z: setvar} (ph ps ch: wff y1 z):
  $ wi (wi (wsb y1 ph z) (wsb y1 ps z)) (wi (wal y1 (wi ps ch)) (wi (wsb y1 ph z) (wsb y1 ch z))) $;

--| A kind of Aristotelian inference. This judgement replaces the mode of inference ~ barbara when the minor premise has a general context. Proposition 65 of [Frege1879] p. 53. In Frege care is taken to point out that the variables in the first clauses are independent of each other and of the final term so another valid translation could be : ` |- ( A. x ( [ x / a ] ph -> [ x / b ] ps ) -> ( A. y ( [ y / b ] ps ` ` -> [ y / c ] ch ) -> ( [ z / a ] ph -> [ z / c ] ch ) ) ) ` . But that is perhaps too pedantic a translation for this exploration. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege65b {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wi (wal x3 (wi ph ps)) (wi (wal x3 (wi ps ch)) (wi (wsb x3 ph y1) (wsb x3 ch y1))) $;

--| Swap antecedents of ~ frege65b . Proposition 66 of [Frege1879] p. 54. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege66b {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wi (wal x3 (wi ph ps)) (wi (wal x3 (wi ch ph)) (wi (wsb x3 ch y1) (wsb x3 ps y1))) $;

--| Lemma for ~ frege68b . Proposition 67 of [Frege1879] p. 54. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege67b {x3: setvar} (ph ps: wff x3) (y1: setvar):
  $ wi (wi (wb (wal x3 ph) ps) (wi ps (wal x3 ph))) (wi (wb (wal x3 ph) ps) (wi ps (wsb x3 ph y1))) $;

--| Combination of applying a definition and applying it to a specific instance. Proposition 68 of [Frege1879] p. 54. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege68b {x3: setvar} (ph ps: wff x3) (y1: setvar):
  $ wi (wb (wal x3 ph) ps) (wi ps (wsb x3 ph y1)) $;

--| Proposition 53 of [Frege1879] p. 50. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege53c {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wi (wsbc x3 ph A2) (wi (wceq A2 B2) (wsbc x3 ph B2)) $;

--| Reflexive equality. (Contributed by RP, 24-Dec-2019.) (Revised by RP, 25-Apr-2020.)
theorem frege54cor1c {x3: setvar} (A2: class) (C: class x3):
  $ wcel A2 C $ >
  $ wsbc x3 (wceq (cv x3) A2) A2 $;

--| Necessary deduction regarding substitution of value in equality. (Contributed by RP, 24-Dec-2019.)
theorem frege55lem1c {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (wi ph (wsbc x3 (wceq (cv x3) B2) A2)) (wi ph (wceq A2 B2)) $;

--| Core proof of Proposition 55 of [Frege1879] p. 50. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege55lem2c {x3 z: setvar} (A2: class x3 z):
  $ wi (wceq (cv x3) A2) (wsbc z (wceq (cv z) (cv x3)) A2) $;

--| Proposition 55 of [Frege1879] p. 50. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege55c {x3: setvar} (A2: class x3):
  $ wi (wceq (cv x3) A2) (wceq A2 (cv x3)) $;

--| Lemma for ~ frege57c . Proposition 56 of [Frege1879] p. 50. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege56c {x3: setvar} (ph: wff x3) (A2 B2: class) (C: class x3):
  $ wcel B2 C $ >
  $ wi (wi (wceq A2 B2) (wi (wsbc x3 ph A2) (wsbc x3 ph B2))) (wi (wceq B2 A2) (wi (wsbc x3 ph A2) (wsbc x3 ph B2))) $;

--| Swap order of implication in ~ ax-frege52c . Proposition 57 of [Frege1879] p. 51. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege57c {x3: setvar} (ph: wff x3) (A2 B2: class) (C: class x3):
  $ wcel A2 C $ >
  $ wi (wceq A2 B2) (wi (wsbc x3 ph B2) (wsbc x3 ph A2)) $;

--| Principle related to ~ sp . Axiom 58 of [Frege1879] p. 51. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege58c {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wcel A2 B2 $ >
  $ wi (wal x3 ph) (wsbc x3 ph A2) $;

--| A kind of Aristotelian inference. Proposition 59 of [Frege1879] p. 51. _Note_: in the Bauer-Meenfelberg translation published in van Heijenoort's collection _From Frege to Goedel_, this proof has the ~ frege12 incorrectly referenced where ~ frege30 is in the original. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege59c {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wcel A2 B2 $ >
  $ wi (wsbc x3 ph A2) (wi (wn (wsbc x3 ps A2)) (wn (wal x3 (wi ph ps)))) $;

--| Swap antecedents of ~ frege58c . Proposition 60 of [Frege1879] p. 52. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege60c {x3: setvar} (ph ps ch: wff x3) (A2 B2: class x3):
  $ wcel A2 B2 $ >
  $ wi (wal x3 (wi ph (wi ps ch))) (wi (wsbc x3 ps A2) (wi (wsbc x3 ph A2) (wsbc x3 ch A2))) $;

--| Lemma for ~ frege65c . Proposition 61 of [Frege1879] p. 52. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege61c {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wcel A2 B2 $ >
  $ wi (wi (wsbc x3 ph A2) ps) (wi (wal x3 ph) ps) $;

--| A kind of Aristotelian inference. This judgement replaces the mode of inference ~ barbara when the minor premise has a particular context. Proposition 62 of [Frege1879] p. 52. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege62c {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wcel A2 B2 $ >
  $ wi (wsbc x3 ph A2) (wi (wal x3 (wi ph ps)) (wsbc x3 ps A2)) $;

--| Analogue of ~ frege63b . Proposition 63 of [Frege1879] p. 52. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege63c {x3: setvar} (ph ps ch: wff x3) (A2 B2: class x3):
  $ wcel A2 B2 $ >
  $ wi (wsbc x3 ph A2) (wi ps (wi (wal x3 (wi ph ch)) (wsbc x3 ch A2))) $;

--| Lemma for ~ frege65c . Proposition 64 of [Frege1879] p. 53. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege64c {x3: setvar} (ph ps ch: wff x3) (A2 B2 C: class x3):
  $ wcel A2 B2 $ >
  $ wi (wi (wsbc x3 ph C) (wsbc x3 ps A2)) (wi (wal x3 (wi ps ch)) (wi (wsbc x3 ph C) (wsbc x3 ch A2))) $;

--| A kind of Aristotelian inference. This judgement replaces the mode of inference ~ barbara when the minor premise has a general context. Proposition 65 of [Frege1879] p. 53. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege65c {x3: setvar} (ph ps ch: wff x3) (A2 B2: class x3):
  $ wcel A2 B2 $ >
  $ wi (wal x3 (wi ph ps)) (wi (wal x3 (wi ps ch)) (wi (wsbc x3 ph A2) (wsbc x3 ch A2))) $;

--| Swap antecedents of ~ frege65c . Proposition 66 of [Frege1879] p. 54. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege66c {x3: setvar} (ph ps ch: wff x3) (A2 B2: class x3):
  $ wcel A2 B2 $ >
  $ wi (wal x3 (wi ph ps)) (wi (wal x3 (wi ch ph)) (wi (wsbc x3 ch A2) (wsbc x3 ps A2))) $;

--| Lemma for ~ frege68c . Proposition 67 of [Frege1879] p. 54. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege67c {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wcel A2 B2 $ >
  $ wi (wi (wb (wal x3 ph) ps) (wi ps (wal x3 ph))) (wi (wb (wal x3 ph) ps) (wi ps (wsbc x3 ph A2))) $;

--| Combination of applying a definition and applying it to a specific instance. Proposition 68 of [Frege1879] p. 54. (Contributed by RP, 24-Dec-2019.) (Proof modification is discouraged.)
theorem frege68c {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wcel A2 B2 $ >
  $ wi (wb (wal x3 ph) ps) (wi ps (wsbc x3 ph A2)) $;

--| If from the proposition that ` x ` has property ` A ` it can be inferred generally, whatever ` x ` may be, that every result of an application of the procedure ` R ` to ` x ` has property ` A ` , then we say " Property ` A ` is hereditary in the ` R ` -sequence. Definition 69 of [Frege1879] p. 55. (Contributed by RP, 28-Mar-2020.)
theorem dffrege69 {x3 y1: setvar} (A2 R: class):
  $ wb (wal x3 (wi (wcel (cv x3) A2) (wal y1 (wi (wbr (cv x3) (cv y1) R) (wcel (cv y1) A2))))) (whe A2 R) $;

--| Lemma for ~ frege72 . Proposition 70 of [Frege1879] p. 58. (Contributed by RP, 28-Mar-2020.) (Revised by RP, 3-Jul-2020.) (Proof modification is discouraged.)
theorem frege70 {y1: setvar} (A2 R: class) (V: class y1) (X: class):
  $ wcel X V $ >
  $ wi (whe A2 R) (wi (wcel X A2) (wal y1 (wi (wbr X (cv y1) R) (wcel (cv y1) A2)))) $;

--| Lemma for ~ frege72 . Proposition 71 of [Frege1879] p. 59. (Contributed by RP, 28-Mar-2020.) (Revised by RP, 3-Jul-2020.) (Proof modification is discouraged.)
theorem frege71 {z: setvar} (A2 R: class) (V: class z) (X: class) (Y: class z):
  $ wcel X V $ >
  $ wi (wi (wal z (wi (wbr X (cv z) R) (wcel (cv z) A2))) (wi (wbr X Y R) (wcel Y A2))) (wi (whe A2 R) (wi (wcel X A2) (wi (wbr X Y R) (wcel Y A2)))) $;

--| If property ` A ` is hereditary in the ` R ` -sequence, if ` x ` has property ` A ` , and if ` y ` is a result of an application of the procedure ` R ` to ` x ` , then ` y ` has property ` A ` . Proposition 72 of [Frege1879] p. 59. (Contributed by RP, 28-Mar-2020.) (Revised by RP, 5-Jul-2020.) (Proof modification is discouraged.)
theorem frege72 (A2 R U V X Y: class):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wi (whe A2 R) (wi (wcel X A2) (wi (wbr X Y R) (wcel Y A2))) $;

--| Lemma for ~ frege87 . Proposition 73 of [Frege1879] p. 59. (Contributed by RP, 28-Mar-2020.) (Revised by RP, 5-Jul-2020.) (Proof modification is discouraged.)
theorem frege73 (A2 R U V X Y: class):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wi (wi (whe A2 R) (wcel X A2)) (wi (whe A2 R) (wi (wbr X Y R) (wcel Y A2))) $;

--| If ` X ` has a property ` A ` that is hereditary in the ` R ` -sequence, then every result of a application of the procedure ` R ` to ` X ` has the property ` A ` . Proposition 74 of [Frege1879] p. 60. (Contributed by RP, 28-Mar-2020.) (Revised by RP, 5-Jul-2020.) (Proof modification is discouraged.)
theorem frege74 (A2 R U V X Y: class):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wi (wcel X A2) (wi (whe A2 R) (wi (wbr X Y R) (wcel Y A2))) $;

--| If from the proposition that ` x ` has property ` A ` , whatever ` x ` may be, it can be inferred that every result of an application of the procedure ` R ` to ` x ` has property ` A ` , then property ` A ` is hereditary in the ` R ` -sequence. Proposition 75 of [Frege1879] p. 60. (Contributed by RP, 28-Mar-2020.) (Proof modification is discouraged.)
theorem frege75 {x3 y1: setvar} (A2 R: class):
  $ wi (wal x3 (wi (wcel (cv x3) A2) (wal y1 (wi (wbr (cv x3) (cv y1) R) (wcel (cv y1) A2))))) (whe A2 R) $;

--| If from the two propositions that every result of an application of the procedure ` R ` to ` B ` has property ` f ` and that property ` f ` is hereditary in the ` R ` -sequence, it can be inferred, whatever ` f ` may be, that ` E ` has property ` f ` , then we say ` E ` follows ` B ` in the ` R ` -sequence. Definition 76 of [Frege1879] p. 60. Each of ` B ` , ` E ` and ` R ` must be sets. (Contributed by RP, 2-Jul-2020.)
theorem dffrege76 {f2 a: setvar} (B2 R: class) (U E V W: class a):
  $ wcel B2 U $ >
  $ wcel E V $ >
  $ wcel R W $ >
  $ wb (wal f2 (wi (whe (cv f2) R) (wi (wal a (wi (wbr B2 (cv a) R) (wcel (cv a) (cv f2)))) (wcel E (cv f2))))) (wbr B2 E (cfv R ctcl)) $;

--| If ` Y ` follows ` X ` in the ` R ` -sequence, if property ` A ` is hereditary in the ` R ` -sequence, and if every result of an application of the procedure ` R ` to ` X ` has the property ` A ` , then ` Y ` has property ` A ` . Proposition 77 of [Frege1879] p. 62. (Contributed by RP, 29-Jun-2020.) (Revised by RP, 2-Jul-2020.) (Proof modification is discouraged.)
theorem frege77 {a: setvar} (A2: class) (B2: class a) (R: class) (U V W: class a) (X: class) (Y: class a):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wcel R W $ >
  $ wcel A2 B2 $ >
  $ wi (wbr X Y (cfv R ctcl)) (wi (whe A2 R) (wi (wal a (wi (wbr X (cv a) R) (wcel (cv a) A2))) (wcel Y A2))) $;

--| Commuted form of ~ frege77 . Proposition 78 of [Frege1879] p. 63. (Contributed by RP, 1-Jul-2020.) (Revised by RP, 2-Jul-2020.) (Proof modification is discouraged.)
theorem frege78 {a: setvar} (A2: class) (B2: class a) (R: class) (U V W: class a) (X: class) (Y: class a):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wcel R W $ >
  $ wcel A2 B2 $ >
  $ wi (whe A2 R) (wi (wal a (wi (wbr X (cv a) R) (wcel (cv a) A2))) (wi (wbr X Y (cfv R ctcl)) (wcel Y A2))) $;

--| Distributed form of ~ frege78 . Proposition 79 of [Frege1879] p. 63. (Contributed by RP, 1-Jul-2020.) (Revised by RP, 3-Jul-2020.) (Proof modification is discouraged.)
theorem frege79 {a: setvar} (A2: class) (B2: class a) (R: class) (U V W: class a) (X: class) (Y: class a):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wcel R W $ >
  $ wcel A2 B2 $ >
  $ wi (wi (whe A2 R) (wal a (wi (wbr X (cv a) R) (wcel (cv a) A2)))) (wi (whe A2 R) (wi (wbr X Y (cfv R ctcl)) (wcel Y A2))) $;

--| Add additional condition to both clauses of ~ frege79 . Proposition 80 of [Frege1879] p. 63. (Contributed by RP, 1-Jul-2020.) (Revised by RP, 5-Jul-2020.) (Proof modification is discouraged.)
theorem frege80 {a: setvar} (A2: class) (B2: class a) (R: class) (U V W: class a) (X: class) (Y: class a):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wcel R W $ >
  $ wcel A2 B2 $ >
  $ wi (wi (wcel X A2) (wi (whe A2 R) (wal a (wi (wbr X (cv a) R) (wcel (cv a) A2))))) (wi (wcel X A2) (wi (whe A2 R) (wi (wbr X Y (cfv R ctcl)) (wcel Y A2)))) $;

--| If ` X ` has a property ` A ` that is hereditary in the ` R ` -sequence, and if ` Y ` follows ` X ` in the ` R ` -sequence, then ` Y ` has property ` A ` . This is a form of induction attributed to Jakob Bernoulli. Proposition 81 of [Frege1879] p. 63. (Contributed by RP, 1-Jul-2020.) (Revised by RP, 5-Jul-2020.) (Proof modification is discouraged.)
theorem frege81 (A2 B2 R U V W X Y: class):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wcel R W $ >
  $ wcel A2 B2 $ >
  $ wi (wcel X A2) (wi (whe A2 R) (wi (wbr X Y (cfv R ctcl)) (wcel Y A2))) $;

--| Closed-form deduction based on ~ frege81 . Proposition 82 of [Frege1879] p. 64. (Contributed by RP, 1-Jul-2020.) (Revised by RP, 5-Jul-2020.) (Proof modification is discouraged.)
theorem frege82 (ph: wff) (A2 B2 R U V W X Y: class):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wcel R W $ >
  $ wcel A2 B2 $ >
  $ wi (wi ph (wcel X A2)) (wi (whe A2 R) (wi ph (wi (wbr X Y (cfv R ctcl)) (wcel Y A2)))) $;

--| Apply commuted form of ~ frege81 when the property ` R ` is hereditary in a disjunction of two properties, only one of which is known to be held by ` X ` . Proposition 83 of [Frege1879] p. 65. Here we introduce the union of classes where Frege has a disjunction of properties which are represented by membership in either of the classes. (Contributed by RP, 1-Jul-2020.) (Revised by RP, 5-Jul-2020.) (Proof modification is discouraged.)
theorem frege83 (B2 C R S T U V W X Y: class):
  $ wcel X S $ >
  $ wcel Y T $ >
  $ wcel R U $ >
  $ wcel B2 V $ >
  $ wcel C W $ >
  $ wi (whe (cun B2 C) R) (wi (wcel X B2) (wi (wbr X Y (cfv R ctcl)) (wcel Y (cun B2 C)))) $;

--| Commuted form of ~ frege81 . Proposition 84 of [Frege1879] p. 65. (Contributed by RP, 1-Jul-2020.) (Revised by RP, 5-Jul-2020.) (Proof modification is discouraged.)
theorem frege84 (A2 B2 R U V W X Y: class):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wcel R W $ >
  $ wcel A2 B2 $ >
  $ wi (whe A2 R) (wi (wcel X A2) (wi (wbr X Y (cfv R ctcl)) (wcel Y A2))) $;

--| Commuted form of ~ frege77 . Proposition 85 of [Frege1879] p. 66. (Contributed by RP, 1-Jul-2020.) (Revised by RP, 5-Jul-2020.) (Proof modification is discouraged.)
theorem frege85 {z: setvar} (A2: class) (B2: class z) (R: class) (U V W: class z) (X: class) (Y: class z):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wcel R W $ >
  $ wcel A2 B2 $ >
  $ wi (wbr X Y (cfv R ctcl)) (wi (wal z (wi (wbr X (cv z) R) (wcel (cv z) A2))) (wi (whe A2 R) (wcel Y A2))) $;

--| Conclusion about element one past ` Y ` in the ` R ` -sequence. Proposition 86 of [Frege1879] p. 66. (Contributed by RP, 1-Jul-2020.) (Revised by RP, 7-Jul-2020.) (Proof modification is discouraged.)
theorem frege86 {w: setvar} (A2: class) (B2: class w) (R: class) (U V W: class w) (X: class) (Y Z: class w):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wcel R W $ >
  $ wcel A2 B2 $ >
  $ wi (wi (wi (whe A2 R) (wcel Y A2)) (wi (whe A2 R) (wi (wbr Y Z R) (wcel Z A2)))) (wi (wbr X Y (cfv R ctcl)) (wi (wal w (wi (wbr X (cv w) R) (wcel (cv w) A2))) (wi (whe A2 R) (wi (wbr Y Z R) (wcel Z A2))))) $;

--| If ` Z ` is a result of an application of the procedure ` R ` to an object ` Y ` that follows ` X ` in the ` R ` -sequence and if every result of an application of the procedure ` R ` to ` X ` has a property ` A ` that is hereditary in the ` R ` -sequence, then ` Z ` has property ` A ` . Proposition 87 of [Frege1879] p. 66. (Contributed by RP, 1-Jul-2020.) (Revised by RP, 7-Jul-2020.) (Proof modification is discouraged.)
theorem frege87 {w: setvar} (A2: class) (B2: class w) (R: class) (S U V W: class w) (X: class) (Y Z: class w):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wcel Z W $ >
  $ wcel R S $ >
  $ wcel A2 B2 $ >
  $ wi (wbr X Y (cfv R ctcl)) (wi (wal w (wi (wbr X (cv w) R) (wcel (cv w) A2))) (wi (whe A2 R) (wi (wbr Y Z R) (wcel Z A2)))) $;

--| Commuted form of ~ frege87 . Proposition 88 of [Frege1879] p. 67. (Contributed by RP, 1-Jul-2020.) (Revised by RP, 7-Jul-2020.) (Proof modification is discouraged.)
theorem frege88 {w: setvar} (A2: class) (B2: class w) (R: class) (S U V W: class w) (X: class) (Y Z: class w):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wcel Z W $ >
  $ wcel R S $ >
  $ wcel A2 B2 $ >
  $ wi (wbr Y Z R) (wi (wbr X Y (cfv R ctcl)) (wi (wal w (wi (wbr X (cv w) R) (wcel (cv w) A2))) (wi (whe A2 R) (wcel Z A2)))) $;

--| One direction of ~ dffrege76 . Proposition 89 of [Frege1879] p. 68. (Contributed by RP, 1-Jul-2020.) (Revised by RP, 2-Jul-2020.) (Proof modification is discouraged.)
theorem frege89 {w f2: setvar} (R: class) (U V W: class w) (X: class) (Y: class w):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wcel R W $ >
  $ wi (wal f2 (wi (whe (cv f2) R) (wi (wal w (wi (wbr X (cv w) R) (wcel (cv w) (cv f2)))) (wcel Y (cv f2))))) (wbr X Y (cfv R ctcl)) $;

--| Add antecedent to ~ frege89 . Proposition 90 of [Frege1879] p. 68. (Contributed by RP, 1-Jul-2020.) (Revised by RP, 2-Jul-2020.) (Proof modification is discouraged.)
theorem frege90 {w f2: setvar} (ph: wff w f2) (R: class) (U V W: class w) (X: class) (Y: class w):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wcel R W $ >
  $ wi (wi ph (wal f2 (wi (whe (cv f2) R) (wi (wal w (wi (wbr X (cv w) R) (wcel (cv w) (cv f2)))) (wcel Y (cv f2)))))) (wi ph (wbr X Y (cfv R ctcl))) $;

--| Every result of an application of a procedure ` R ` to an object ` X ` follows that ` X ` in the ` R ` -sequence. Proposition 91 of [Frege1879] p. 68. (Contributed by RP, 2-Jul-2020.) (Revised by RP, 5-Jul-2020.) (Proof modification is discouraged.)
theorem frege91 (R U V W X Y: class):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wcel R W $ >
  $ wi (wbr X Y R) (wbr X Y (cfv R ctcl)) $;

--| Inference from ~ frege91 . Proposition 92 of [Frege1879] p. 69. (Contributed by RP, 2-Jul-2020.) (Revised by RP, 5-Jul-2020.) (Proof modification is discouraged.)
theorem frege92 (R U V W X Y Z: class):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wcel R W $ >
  $ wi (wceq X Z) (wi (wbr X Y R) (wbr Z Y (cfv R ctcl))) $;

--| Necessary condition for two elements to be related by the transitive closure. Proposition 93 of [Frege1879] p. 70. (Contributed by RP, 2-Jul-2020.) (Revised by RP, 5-Jul-2020.) (Proof modification is discouraged.)
theorem frege93 {z f2: setvar} (R: class) (U V W: class z) (X: class) (Y: class z):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wcel R W $ >
  $ wi (wal f2 (wi (wal z (wi (wbr X (cv z) R) (wcel (cv z) (cv f2)))) (wi (whe (cv f2) R) (wcel Y (cv f2))))) (wbr X Y (cfv R ctcl)) $;

--| Looking one past a pair related by transitive closure of a relation. Proposition 94 of [Frege1879] p. 70. (Contributed by RP, 2-Jul-2020.) (Revised by RP, 5-Jul-2020.) (Proof modification is discouraged.)
theorem frege94 {w f2: setvar} (R: class) (U V W: class w) (X: class) (Y: class w f2) (Z: class w):
  $ wcel X U $ >
  $ wcel Z V $ >
  $ wcel R W $ >
  $ wi (wi (wbr Y Z R) (wi (wbr X Y (cfv R ctcl)) (wal f2 (wi (wal w (wi (wbr X (cv w) R) (wcel (cv w) (cv f2)))) (wi (whe (cv f2) R) (wcel Z (cv f2))))))) (wi (wbr Y Z R) (wi (wbr X Y (cfv R ctcl)) (wbr X Z (cfv R ctcl)))) $;

--| Looking one past a pair related by transitive closure of a relation. Proposition 95 of [Frege1879] p. 70. (Contributed by RP, 2-Jul-2020.) (Revised by RP, 7-Jul-2020.) (Proof modification is discouraged.)
theorem frege95 (A2 R U V W X Y Z: class):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wcel Z W $ >
  $ wcel R A2 $ >
  $ wi (wbr Y Z R) (wi (wbr X Y (cfv R ctcl)) (wbr X Z (cfv R ctcl))) $;

--| Every result of an application of the procedure ` R ` to an object that follows ` X ` in the ` R ` -sequence follows ` X ` in the ` R ` -sequence. Proposition 96 of [Frege1879] p. 71. (Contributed by RP, 2-Jul-2020.) (Revised by RP, 7-Jul-2020.) (Proof modification is discouraged.)
theorem frege96 (A2 R U V W X Y Z: class):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wcel Z W $ >
  $ wcel R A2 $ >
  $ wi (wbr X Y (cfv R ctcl)) (wi (wbr Y Z R) (wbr X Z (cfv R ctcl))) $;

--| The property of following ` X ` in the ` R ` -sequence is hereditary in the ` R ` -sequence. Proposition 97 of [Frege1879] p. 71. Here we introduce the image of a singleton under a relation as class which stands for the property of following ` X ` in the ` R ` -sequence. (Contributed by RP, 2-Jul-2020.) (Revised by RP, 7-Jul-2020.) (Proof modification is discouraged.)
theorem frege97 (R U W X: class):
  $ wcel X U $ >
  $ wcel R W $ >
  $ whe (cima (cfv R ctcl) (csn X)) R $;

--| If ` Y ` follows ` X ` and ` Z ` follows ` Y ` in the ` R ` -sequence then ` Z ` follows ` X ` in the ` R ` -sequence because the transitive closure of a relation has the transitive property. Proposition 98 of [Frege1879] p. 71. (Contributed by RP, 2-Jul-2020.) (Revised by RP, 6-Jul-2020.) (Proof modification is discouraged.)
theorem frege98 (A2 B2 C D R X Y Z: class):
  $ wcel X A2 $ >
  $ wcel Y B2 $ >
  $ wcel Z C $ >
  $ wcel R D $ >
  $ wi (wbr X Y (cfv R ctcl)) (wi (wbr Y Z (cfv R ctcl)) (wbr X Z (cfv R ctcl))) $;

--| If ` Z ` is identical with ` X ` or follows ` X ` in the ` R ` -sequence, then we say : " ` Z ` belongs to the ` R ` -sequence beginning with ` X ` " or " ` X ` belongs to the ` R ` -sequence ending with ` Z ` ". Definition 99 of [Frege1879] p. 71. (Contributed by RP, 2-Jul-2020.)
theorem dffrege99 (R U X Z: class):
  $ wcel Z U $ >
  $ wb (wi (wn (wbr X Z (cfv R ctcl))) (wceq Z X)) (wbr X Z (cun (cfv R ctcl) cid)) $;

--| One direction of ~ dffrege99 . Proposition 100 of [Frege1879] p. 72. (Contributed by RP, 7-Jul-2020.) (Proof modification is discouraged.)
theorem frege100 (R U X Z: class):
  $ wcel Z U $ >
  $ wi (wbr X Z (cun (cfv R ctcl) cid)) (wi (wn (wbr X Z (cfv R ctcl))) (wceq Z X)) $;

--| Lemma for ~ frege102 . Proposition 101 of [Frege1879] p. 72. (Contributed by RP, 7-Jul-2020.) (Proof modification is discouraged.)
theorem frege101 (R U V X Z: class):
  $ wcel Z U $ >
  $ wi (wi (wceq Z X) (wi (wbr Z V R) (wbr X V (cfv R ctcl)))) (wi (wi (wbr X Z (cfv R ctcl)) (wi (wbr Z V R) (wbr X V (cfv R ctcl)))) (wi (wbr X Z (cun (cfv R ctcl) cid)) (wi (wbr Z V R) (wbr X V (cfv R ctcl))))) $;

--| If ` Z ` belongs to the ` R ` -sequence beginning with ` X ` , then every result of an application of the procedure ` R ` to ` Z ` follows ` X ` in the ` R ` -sequence. Proposition 102 of [Frege1879] p. 72. (Contributed by RP, 7-Jul-2020.) (Proof modification is discouraged.)
theorem frege102 (A2 B2 C D R V X Z: class):
  $ wcel X A2 $ >
  $ wcel Z B2 $ >
  $ wcel V C $ >
  $ wcel R D $ >
  $ wi (wbr X Z (cun (cfv R ctcl) cid)) (wi (wbr Z V R) (wbr X V (cfv R ctcl))) $;

--| Proposition 103 of [Frege1879] p. 73. (Contributed by RP, 7-Jul-2020.) (Proof modification is discouraged.)
theorem frege103 (R V X Z: class):
  $ wcel Z V $ >
  $ wi (wi (wceq Z X) (wceq X Z)) (wi (wbr X Z (cun (cfv R ctcl) cid)) (wi (wn (wbr X Z (cfv R ctcl))) (wceq X Z))) $;

--| Proposition 104 of [Frege1879] p. 73. _Note_: in the Bauer-Meenfelberg translation published in van Heijenoort's collection _From Frege to Goedel_, this proof has the minor clause and result swapped. (Contributed by RP, 7-Jul-2020.) (Proof modification is discouraged.)
theorem frege104 (R V X Z: class):
  $ wcel Z V $ >
  $ wi (wbr X Z (cun (cfv R ctcl) cid)) (wi (wn (wbr X Z (cfv R ctcl))) (wceq X Z)) $;

--| Proposition 105 of [Frege1879] p. 73. (Contributed by RP, 7-Jul-2020.) (Proof modification is discouraged.)
theorem frege105 (R V X Z: class):
  $ wcel Z V $ >
  $ wi (wi (wn (wbr X Z (cfv R ctcl))) (wceq Z X)) (wbr X Z (cun (cfv R ctcl) cid)) $;

--| Whatever follows ` X ` in the ` R ` -sequence belongs to the ` R ` -sequence beginning with ` X ` . Proposition 106 of [Frege1879] p. 73. (Contributed by RP, 7-Jul-2020.) (Proof modification is discouraged.)
theorem frege106 (R V X Z: class):
  $ wcel Z V $ >
  $ wi (wbr X Z (cfv R ctcl)) (wbr X Z (cun (cfv R ctcl) cid)) $;

--| Proposition 107 of [Frege1879] p. 74. (Contributed by RP, 7-Jul-2020.) (Proof modification is discouraged.)
theorem frege107 (A2 R V Y Z: class):
  $ wcel V A2 $ >
  $ wi (wi (wbr Z Y (cun (cfv R ctcl) cid)) (wi (wbr Y V R) (wbr Z V (cfv R ctcl)))) (wi (wbr Z Y (cun (cfv R ctcl) cid)) (wi (wbr Y V R) (wbr Z V (cun (cfv R ctcl) cid)))) $;

--| If ` Y ` belongs to the ` R ` -sequence beginning with ` Z ` , then every result of an application of the procedure ` R ` to ` Y ` belongs to the ` R ` -sequence beginning with ` Z ` . Proposition 108 of [Frege1879] p. 74. (Contributed by RP, 7-Jul-2020.) (Proof modification is discouraged.)
theorem frege108 (A2 B2 C D R V Y Z: class):
  $ wcel Z A2 $ >
  $ wcel Y B2 $ >
  $ wcel V C $ >
  $ wcel R D $ >
  $ wi (wbr Z Y (cun (cfv R ctcl) cid)) (wi (wbr Y V R) (wbr Z V (cun (cfv R ctcl) cid))) $;

--| The property of belonging to the ` R ` -sequence beginning with ` X ` is hereditary in the ` R ` -sequence. Proposition 109 of [Frege1879] p. 74. (Contributed by RP, 7-Jul-2020.) (Proof modification is discouraged.)
theorem frege109 (R U V X: class):
  $ wcel X U $ >
  $ wcel R V $ >
  $ whe (cima (cun (cfv R ctcl) cid) (csn X)) R $;

--| Proposition 110 of [Frege1879] p. 75. (Contributed by RP, 7-Jul-2020.) (Proof modification is discouraged.)
theorem frege110 {a: setvar} (A2 B2 C D: class a) (R: class) (M: class a) (X Y: class):
  $ wcel X A2 $ >
  $ wcel Y B2 $ >
  $ wcel M C $ >
  $ wcel R D $ >
  $ wi (wal a (wi (wbr Y (cv a) R) (wbr X (cv a) (cun (cfv R ctcl) cid)))) (wi (wbr Y M (cfv R ctcl)) (wbr X M (cun (cfv R ctcl) cid))) $;

--| If ` Y ` belongs to the ` R ` -sequence beginning with ` Z ` , then every result of an application of the procedure ` R ` to ` Y ` belongs to the ` R ` -sequence beginning with ` Z ` or precedes ` Z ` in the ` R ` -sequence. Proposition 111 of [Frege1879] p. 75. (Contributed by RP, 7-Jul-2020.) (Revised by RP, 8-Jul-2020.) (Proof modification is discouraged.)
theorem frege111 (A2 B2 C D R V Y Z: class):
  $ wcel Z A2 $ >
  $ wcel Y B2 $ >
  $ wcel V C $ >
  $ wcel R D $ >
  $ wi (wbr Z Y (cun (cfv R ctcl) cid)) (wi (wbr Y V R) (wi (wn (wbr V Z (cfv R ctcl))) (wbr Z V (cun (cfv R ctcl) cid)))) $;

--| Identity implies belonging to the ` R ` -sequence beginning with self. Proposition 112 of [Frege1879] p. 76. (Contributed by RP, 7-Jul-2020.) (Proof modification is discouraged.)
theorem frege112 (R V X Z: class):
  $ wcel Z V $ >
  $ wi (wceq Z X) (wbr X Z (cun (cfv R ctcl) cid)) $;

--| Proposition 113 of [Frege1879] p. 76. (Contributed by RP, 7-Jul-2020.) (Proof modification is discouraged.)
theorem frege113 (R V X Z: class):
  $ wcel Z V $ >
  $ wi (wi (wbr Z X (cun (cfv R ctcl) cid)) (wi (wn (wbr Z X (cfv R ctcl))) (wceq Z X))) (wi (wbr Z X (cun (cfv R ctcl) cid)) (wi (wn (wbr Z X (cfv R ctcl))) (wbr X Z (cun (cfv R ctcl) cid)))) $;

--| If ` X ` belongs to the ` R ` -sequence beginning with ` Z ` , then ` Z ` belongs to the ` R ` -sequence beginning with ` X ` or ` X ` follows ` Z ` in the ` R ` -sequence. Proposition 114 of [Frege1879] p. 76. (Contributed by RP, 7-Jul-2020.) (Proof modification is discouraged.)
theorem frege114 (R U V X Z: class):
  $ wcel X U $ >
  $ wcel Z V $ >
  $ wi (wbr Z X (cun (cfv R ctcl) cid)) (wi (wn (wbr Z X (cfv R ctcl))) (wbr X Z (cun (cfv R ctcl) cid))) $;

--| If from the circumstance that ` c ` is a result of an application of the procedure ` R ` to ` b ` , whatever ` b ` may be, it can be inferred that every result of an application of the procedure ` R ` to ` b ` is the same as ` c ` , then we say : "The procedure ` R ` is single-valued". Definition 115 of [Frege1879] p. 77. (Contributed by RP, 7-Jul-2020.)
theorem dffrege115 {a b c: setvar} (R: class):
  $ wb (wal c (wal b (wi (wbr (cv b) (cv c) R) (wal a (wi (wbr (cv b) (cv a) R) (wceq (cv a) (cv c))))))) (wfun (ccnv (ccnv R))) $;

--| One direction of ~ dffrege115 . Proposition 116 of [Frege1879] p. 77. (Contributed by RP, 8-Jul-2020.) (Proof modification is discouraged.)
theorem frege116 {a b: setvar} (R: class) (U: class a b) (X: class):
  $ wcel X U $ >
  $ wi (wfun (ccnv (ccnv R))) (wal b (wi (wbr (cv b) X R) (wal a (wi (wbr (cv b) (cv a) R) (wceq (cv a) X))))) $;

--| Lemma for ~ frege118 . Proposition 117 of [Frege1879] p. 78. (Contributed by RP, 8-Jul-2020.) (Proof modification is discouraged.)
theorem frege117 {a b: setvar} (R: class) (U: class a b) (X: class) (Y: class a b):
  $ wcel X U $ >
  $ wi (wi (wal b (wi (wbr (cv b) X R) (wal a (wi (wbr (cv b) (cv a) R) (wceq (cv a) X))))) (wi (wbr Y X R) (wal a (wi (wbr Y (cv a) R) (wceq (cv a) X))))) (wi (wfun (ccnv (ccnv R))) (wi (wbr Y X R) (wal a (wi (wbr Y (cv a) R) (wceq (cv a) X))))) $;

--| Simplified application of one direction of ~ dffrege115 . Proposition 118 of [Frege1879] p. 78. (Contributed by RP, 8-Jul-2020.) (Proof modification is discouraged.)
theorem frege118 {a: setvar} (R: class) (U V: class a) (X Y: class):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wi (wfun (ccnv (ccnv R))) (wi (wbr Y X R) (wal a (wi (wbr Y (cv a) R) (wceq (cv a) X)))) $;

--| Lemma for ~ frege120 . Proposition 119 of [Frege1879] p. 78. (Contributed by RP, 8-Jul-2020.) (Proof modification is discouraged.)
theorem frege119 {a: setvar} (A2: class a) (R: class) (U V: class a) (X Y: class):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wi (wi (wal a (wi (wbr Y (cv a) R) (wceq (cv a) X))) (wi (wbr Y A2 R) (wceq A2 X))) (wi (wfun (ccnv (ccnv R))) (wi (wbr Y X R) (wi (wbr Y A2 R) (wceq A2 X)))) $;

--| Simplified application of one direction of ~ dffrege115 . Proposition 120 of [Frege1879] p. 78. (Contributed by RP, 8-Jul-2020.) (Proof modification is discouraged.)
theorem frege120 (A2 R U V W X Y: class):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wcel A2 W $ >
  $ wi (wfun (ccnv (ccnv R))) (wi (wbr Y X R) (wi (wbr Y A2 R) (wceq A2 X))) $;

--| Lemma for ~ frege122 . Proposition 121 of [Frege1879] p. 79. (Contributed by RP, 8-Jul-2020.) (Proof modification is discouraged.)
theorem frege121 (A2 R U V W X Y: class):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wcel A2 W $ >
  $ wi (wi (wceq A2 X) (wbr X A2 (cun (cfv R ctcl) cid))) (wi (wfun (ccnv (ccnv R))) (wi (wbr Y X R) (wi (wbr Y A2 R) (wbr X A2 (cun (cfv R ctcl) cid))))) $;

--| If ` X ` is a result of an application of the single-valued procedure ` R ` to ` Y ` , then every result of an application of the procedure ` R ` to ` Y ` belongs to the ` R ` -sequence beginning with ` X ` . Proposition 122 of [Frege1879] p. 79. (Contributed by RP, 8-Jul-2020.) (Proof modification is discouraged.)
theorem frege122 (A2 R U V W X Y: class):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wcel A2 W $ >
  $ wi (wfun (ccnv (ccnv R))) (wi (wbr Y X R) (wi (wbr Y A2 R) (wbr X A2 (cun (cfv R ctcl) cid)))) $;

--| Lemma for ~ frege124 . Proposition 123 of [Frege1879] p. 79. (Contributed by RP, 8-Jul-2020.) (Proof modification is discouraged.)
theorem frege123 {a: setvar} (R: class) (U M V: class a) (X Y: class):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wi (wi (wal a (wi (wbr Y (cv a) R) (wbr X (cv a) (cun (cfv R ctcl) cid)))) (wi (wbr Y M (cfv R ctcl)) (wbr X M (cun (cfv R ctcl) cid)))) (wi (wfun (ccnv (ccnv R))) (wi (wbr Y X R) (wi (wbr Y M (cfv R ctcl)) (wbr X M (cun (cfv R ctcl) cid))))) $;

--| If ` X ` is a result of an application of the single-valued procedure ` R ` to ` Y ` and if ` M ` follows ` Y ` in the ` R ` -sequence, then ` M ` belongs to the ` R ` -sequence beginning with ` X ` . Proposition 124 of [Frege1879] p. 80. (Contributed by RP, 8-Jul-2020.) (Proof modification is discouraged.)
theorem frege124 (R S U M V W X Y: class):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wcel M W $ >
  $ wcel R S $ >
  $ wi (wfun (ccnv (ccnv R))) (wi (wbr Y X R) (wi (wbr Y M (cfv R ctcl)) (wbr X M (cun (cfv R ctcl) cid)))) $;

--| Lemma for ~ frege126 . Proposition 125 of [Frege1879] p. 81. (Contributed by RP, 9-Jul-2020.) (Proof modification is discouraged.)
theorem frege125 (R S U M V W X Y: class):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wcel M W $ >
  $ wcel R S $ >
  $ wi (wi (wbr X M (cun (cfv R ctcl) cid)) (wi (wn (wbr X M (cfv R ctcl))) (wbr M X (cun (cfv R ctcl) cid)))) (wi (wfun (ccnv (ccnv R))) (wi (wbr Y X R) (wi (wbr Y M (cfv R ctcl)) (wi (wn (wbr X M (cfv R ctcl))) (wbr M X (cun (cfv R ctcl) cid)))))) $;

--| If ` M ` follows ` Y ` in the ` R ` -sequence and if the procedure ` R ` is single-valued, then every result of an application of the procedure ` R ` to ` Y ` belongs to the ` R ` -sequence beginning with ` M ` or precedes ` M ` in the ` R ` -sequence. Proposition 126 of [Frege1879] p. 81. (Contributed by RP, 9-Jul-2020.) (Proof modification is discouraged.)
theorem frege126 (R S U M V W X Y: class):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wcel M W $ >
  $ wcel R S $ >
  $ wi (wfun (ccnv (ccnv R))) (wi (wbr Y X R) (wi (wbr Y M (cfv R ctcl)) (wi (wn (wbr X M (cfv R ctcl))) (wbr M X (cun (cfv R ctcl) cid))))) $;

--| Communte antecedents of ~ frege126 . Proposition 127 of [Frege1879] p. 82. (Contributed by RP, 9-Jul-2020.) (Proof modification is discouraged.)
theorem frege127 (R S U M V W X Y: class):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wcel M W $ >
  $ wcel R S $ >
  $ wi (wfun (ccnv (ccnv R))) (wi (wbr Y M (cfv R ctcl)) (wi (wbr Y X R) (wi (wn (wbr X M (cfv R ctcl))) (wbr M X (cun (cfv R ctcl) cid))))) $;

--| Lemma for ~ frege129 . Proposition 128 of [Frege1879] p. 83. (Contributed by RP, 9-Jul-2020.) (Proof modification is discouraged.)
theorem frege128 (R S U M V W X Y: class):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wcel M W $ >
  $ wcel R S $ >
  $ wi (wi (wbr M Y (cun (cfv R ctcl) cid)) (wi (wbr Y X R) (wi (wn (wbr X M (cfv R ctcl))) (wbr M X (cun (cfv R ctcl) cid))))) (wi (wfun (ccnv (ccnv R))) (wi (wi (wn (wbr Y M (cfv R ctcl))) (wbr M Y (cun (cfv R ctcl) cid))) (wi (wbr Y X R) (wi (wn (wbr X M (cfv R ctcl))) (wbr M X (cun (cfv R ctcl) cid)))))) $;

--| If the procedure ` R ` is single-valued and ` Y ` belongs to the ` R ` -sequence beginning with ` M ` or precedes ` M ` in the ` R ` -sequence, then every result of an application of the procedure ` R ` to ` Y ` belongs to the ` R ` -sequence beginning with ` M ` or precedes ` M ` in the ` R ` -sequence. Proposition 129 of [Frege1879] p. 83. (Contributed by RP, 9-Jul-2020.) (Proof modification is discouraged.)
theorem frege129 (R S U M V W X Y: class):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wcel M W $ >
  $ wcel R S $ >
  $ wi (wfun (ccnv (ccnv R))) (wi (wi (wn (wbr Y M (cfv R ctcl))) (wbr M Y (cun (cfv R ctcl) cid))) (wi (wbr Y X R) (wi (wn (wbr X M (cfv R ctcl))) (wbr M X (cun (cfv R ctcl) cid))))) $;

--| Lemma for ~ frege131 . Proposition 130 of [Frege1879] p. 84. (Contributed by RP, 9-Jul-2020.) (Proof modification is discouraged.)
theorem frege130 {a b: setvar} (R: class) (U: class a b) (M: class b) (V: class a b):
  $ wcel M U $ >
  $ wcel R V $ >
  $ wi (wi (wal b (wi (wi (wn (wbr (cv b) M (cfv R ctcl))) (wbr M (cv b) (cun (cfv R ctcl) cid))) (wal a (wi (wbr (cv b) (cv a) R) (wi (wn (wbr (cv a) M (cfv R ctcl))) (wbr M (cv a) (cun (cfv R ctcl) cid))))))) (whe (cun (cima (ccnv (cfv R ctcl)) (csn M)) (cima (cun (cfv R ctcl) cid) (csn M))) R)) (wi (wfun (ccnv (ccnv R))) (whe (cun (cima (ccnv (cfv R ctcl)) (csn M)) (cima (cun (cfv R ctcl) cid) (csn M))) R)) $;

--| If the procedure ` R ` is single-valued, then the property of belonging to the ` R ` -sequence beginning with ` M ` or preceeding ` M ` in the ` R ` -sequence is hereditary in the ` R ` -sequence. Proposition 131 of [Frege1879] p. 85. (Contributed by RP, 9-Jul-2020.) (Proof modification is discouraged.)
theorem frege131 (R U M V: class):
  $ wcel M U $ >
  $ wcel R V $ >
  $ wi (wfun (ccnv (ccnv R))) (whe (cun (cima (ccnv (cfv R ctcl)) (csn M)) (cima (cun (cfv R ctcl) cid) (csn M))) R) $;

--| Lemma for ~ frege133 . Proposition 132 of [Frege1879] p. 86. (Contributed by RP, 9-Jul-2020.) (Proof modification is discouraged.)
theorem frege132 (R U M V X Y: class):
  $ wcel M U $ >
  $ wcel R V $ >
  $ wi (wi (whe (cun (cima (ccnv (cfv R ctcl)) (csn M)) (cima (cun (cfv R ctcl) cid) (csn M))) R) (wi (wbr X M (cfv R ctcl)) (wi (wbr X Y (cfv R ctcl)) (wi (wn (wbr Y M (cfv R ctcl))) (wbr M Y (cun (cfv R ctcl) cid)))))) (wi (wfun (ccnv (ccnv R))) (wi (wbr X M (cfv R ctcl)) (wi (wbr X Y (cfv R ctcl)) (wi (wn (wbr Y M (cfv R ctcl))) (wbr M Y (cun (cfv R ctcl) cid)))))) $;

--| If the procedure ` R ` is single-valued and if ` M ` and ` Y ` follow ` X ` in the ` R ` -sequence, then ` Y ` belongs to the ` R ` -sequence beginning with ` M ` or precedes ` M ` in the ` R ` -sequence. Proposition 133 of [Frege1879] p. 86. (Contributed by RP, 9-Jul-2020.) (Proof modification is discouraged.)
theorem frege133 (R S U M V W X Y: class):
  $ wcel X U $ >
  $ wcel Y V $ >
  $ wcel M W $ >
  $ wcel R S $ >
  $ wi (wfun (ccnv (ccnv R))) (wi (wbr X M (cfv R ctcl)) (wi (wbr X Y (cfv R ctcl)) (wi (wn (wbr Y M (cfv R ctcl))) (wbr M Y (cun (cfv R ctcl) cid))))) $;

--| The set of all possible relations between two sets is equinumerous to the set of all mappings from one set to the powerset of the other. See ~ rfovf1od for a demonstration of a natural one-to-one onto mapping. (Contributed by RP, 27-Apr-2021.)
theorem enrelmap (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wbr (cpw (cxp A2 B2)) (co (cpw B2) A2 cmap) cen) $;

--| The set of all possible relations between two sets is equinumerous to the set of all mappings from one set to the powerset of the other. (Contributed by RP, 27-Apr-2021.)
theorem enrelmapr (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wbr (cpw (cxp A2 B2)) (co (cpw A2) B2 cmap) cen) $;

--| The set of all mappings from one set to the powerset of the other is equinumerous to the set of all mappings from the second set to the powerset of the first. (Contributed by RP, 27-Apr-2021.)
theorem enmappw (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wbr (co (cpw B2) A2 cmap) (co (cpw A2) B2 cmap) cen) $;

--| The set of all mappings from the powerset to the powerset is equinumerous to the set of all mappings from the set to the powerset of the powerset. (Contributed by RP, 27-Apr-2021.)
theorem enmappwid (A2 V: class):
  $ wi (wcel A2 V) (wbr (co (cpw A2) (cpw A2) cmap) (co (cpw (cpw A2)) A2 cmap) cen) $;

--| Value of the operator, ` ( A O B ) ` , which maps between relations and functions for relations between base sets, ` A ` and ` B ` . (Contributed by RP, 25-Apr-2021.)
theorem rfovd {x3 y1 r a b: setvar} (ph: wff x3 y1 r) (A2: class y1) (B2: class) (O V W: class x3 y1 r a b):
  $ wceq O (cmpo a b cvv cvv (cmpt r (cpw (cxp (cv a) (cv b))) (cmpt x3 (cv a) (crab y1 (wbr (cv x3) (cv y1) (cv r)) (cv b))))) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wceq (co A2 B2 O) (cmpt r (cpw (cxp A2 B2)) (cmpt x3 A2 (crab y1 (wbr (cv x3) (cv y1) (cv r)) B2)))) $;

--| Value of the operator, ` ( A O B ) ` , which maps between relations and functions for relations between base sets, ` A ` and ` B ` , and relation ` R ` . (Contributed by RP, 25-Apr-2021.)
theorem rfovfvd {x3 y1 r a b: setvar} (ph: wff x3 y1) (A2: class y1) (B2: class) (R: class a b) (F O V W: class x3 y1 r a b):
  $ wceq O (cmpo a b cvv cvv (cmpt r (cpw (cxp (cv a) (cv b))) (cmpt x3 (cv a) (crab y1 (wbr (cv x3) (cv y1) (cv r)) (cv b))))) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel R (cpw (cxp A2 B2))) $ >
  $ wceq F (co A2 B2 O) $ >
  $ wi ph (wceq (cfv R F) (cmpt x3 A2 (crab y1 (wbr (cv x3) (cv y1) R) B2))) $;

--| Value of the operator, ` ( A O B ) ` , which maps between relations and functions for relations between base sets, ` A ` and ` B ` , relation ` R ` , and left element ` X ` . (Contributed by RP, 25-Apr-2021.)
theorem rfovfvfvd {x3 y1 r a b: setvar} (ph: wff y1) (A2: class y1) (B2: class) (R: class a b) (F G O V W: class x3 y1 r a b) (X: class r a b):
  $ wceq O (cmpo a b cvv cvv (cmpt r (cpw (cxp (cv a) (cv b))) (cmpt x3 (cv a) (crab y1 (wbr (cv x3) (cv y1) (cv r)) (cv b))))) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel R (cpw (cxp A2 B2))) $ >
  $ wceq F (co A2 B2 O) $ >
  $ wi ph (wcel X A2) $ >
  $ wceq G (cfv R F) $ >
  $ wi ph (wceq (cfv X G) (crab y1 (wbr X (cv y1) R) B2)) $;

--| Properties of the operator, ` ( A O B ) ` , which maps between relations and functions for relations between base sets, ` A ` and ` B ` . (Contributed by RP, 27-Apr-2021.)
theorem rfovcnvf1od {x3 y1 f2 r a b: setvar} (ph: wff) (A2 B2: class) (F O V: class x3 y1 f2 r a b) (W: class y1 f2 r b):
  $ wceq O (cmpo a b cvv cvv (cmpt r (cpw (cxp (cv a) (cv b))) (cmpt x3 (cv a) (crab y1 (wbr (cv x3) (cv y1) (cv r)) (cv b))))) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wceq F (co A2 B2 O) $ >
  $ wi ph (wa (wf1o (cpw (cxp A2 B2)) (co (cpw B2) A2 cmap) F) (wceq (ccnv F) (cmpt f2 (co (cpw B2) A2 cmap) (copab x3 y1 (wa (wcel (cv x3) A2) (wcel (cv y1) (cfv (cv x3) (cv f2)))))))) $;

--| Value of the converse of the operator, ` ( A O B ) ` , which maps between relations and functions for relations between base sets, ` A ` and ` B ` . (Contributed by RP, 27-Apr-2021.)
theorem rfovcnvd {x3 y1 f2 r a b: setvar} (ph: wff) (A2 B2: class) (F O V: class x3 y1 f2 r a b) (W: class y1 f2 r b):
  $ wceq O (cmpo a b cvv cvv (cmpt r (cpw (cxp (cv a) (cv b))) (cmpt x3 (cv a) (crab y1 (wbr (cv x3) (cv y1) (cv r)) (cv b))))) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wceq F (co A2 B2 O) $ >
  $ wi ph (wceq (ccnv F) (cmpt f2 (co (cpw B2) A2 cmap) (copab x3 y1 (wa (wcel (cv x3) A2) (wcel (cv y1) (cfv (cv x3) (cv f2))))))) $;

--| The value of the operator, ` ( A O B ) ` , which maps between relations and functions for relations between base sets, ` A ` and ` B ` , is a bijection. (Contributed by RP, 27-Apr-2021.)
theorem rfovf1od {x3 y1 r a b: setvar} (ph: wff) (A2 B2: class) (F O V: class x3 y1 r a b) (W: class y1 r b):
  $ wceq O (cmpo a b cvv cvv (cmpt r (cpw (cxp (cv a) (cv b))) (cmpt x3 (cv a) (crab y1 (wbr (cv x3) (cv y1) (cv r)) (cv b))))) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wceq F (co A2 B2 O) $ >
  $ wi ph (wf1o (cpw (cxp A2 B2)) (co (cpw B2) A2 cmap) F) $;

--| Value of the converse of the operator, ` ( A O B ) ` , which maps between relations and functions for relations between base sets, ` A ` and ` B ` , evaluated at function ` G ` . (Contributed by RP, 27-Apr-2021.)
theorem rfovcnvfvd {x3 y1 r a b: setvar} (ph: wff) (A2 B2: class) (F: class x3 y1 r a b) (G: class r a b) (O V: class x3 y1 r a b) (W: class y1 r b):
  $ wceq O (cmpo a b cvv cvv (cmpt r (cpw (cxp (cv a) (cv b))) (cmpt x3 (cv a) (crab y1 (wbr (cv x3) (cv y1) (cv r)) (cv b))))) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wceq F (co A2 B2 O) $ >
  $ wi ph (wcel G (co (cpw B2) A2 cmap)) $ >
  $ wi ph (wceq (cfv G (ccnv F)) (copab x3 y1 (wa (wcel (cv x3) A2) (wcel (cv y1) (cfv (cv x3) G))))) $;

--| Value of the operator, ` ( A O B ) ` , which maps between maps from one base set to subsets of the second to maps from the second base set to subsets of the first for base sets, ` A ` and ` B ` . (Contributed by RP, 25-Apr-2021.)
theorem fsovd {x3 y1 f2 a b: setvar} (ph: wff x3 y1 f2) (A2: class) (B2: class x3) (O V W: class x3 y1 f2 a b):
  $ wceq O (cmpo a b cvv cvv (cmpt f2 (co (cpw (cv b)) (cv a) cmap) (cmpt y1 (cv b) (crab x3 (wcel (cv y1) (cfv (cv x3) (cv f2))) (cv a))))) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wceq (co A2 B2 O) (cmpt f2 (co (cpw B2) A2 cmap) (cmpt y1 B2 (crab x3 (wcel (cv y1) (cfv (cv x3) (cv f2))) A2)))) $;

--| The operator which gives a 1-to-1 a mapping to a subset and a reverse mapping from elements can be composed from the operator which gives a 1-to-1 mapping between relations and functions to subsets and the converse operator. (Contributed by RP, 15-May-2021.)
theorem fsovrfovd {x3 y1 v u f2 s1 r a b: setvar} (ph: wff x3 y1 s1) (A2: class) (B2: class x3) (C R O V: class x3 y1 v u f2 s1 r a b) (W: class x3 y1 v f2 s1 r b):
  $ wceq O (cmpo a b cvv cvv (cmpt f2 (co (cpw (cv b)) (cv a) cmap) (cmpt y1 (cv b) (crab x3 (wcel (cv y1) (cfv (cv x3) (cv f2))) (cv a))))) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wceq R (cmpo a b cvv cvv (cmpt r (cpw (cxp (cv a) (cv b))) (cmpt u (cv a) (crab v (wbr (cv u) (cv v) (cv r)) (cv b))))) $ >
  $ wceq C (cmpo a b cvv cvv (cmpt s1 (cpw (cxp (cv a) (cv b))) (ccnv (cv s1)))) $ >
  $ wi ph (wceq (co A2 B2 O) (ccom (co B2 A2 R) (ccom (co A2 B2 C) (ccnv (co A2 B2 R))))) $;

--| Value of the operator, ` ( A O B ) ` , which maps between maps from one base set to subsets of the second to maps from the second base set to subsets of the first for base sets, ` A ` and ` B ` , when applied to function ` F ` . (Contributed by RP, 25-Apr-2021.)
theorem fsovfvd {x3 y1 f2 a b: setvar} (ph: wff x3 y1) (A2: class) (B2: class x3) (F: class a b) (G O V W: class x3 y1 f2 a b):
  $ wceq O (cmpo a b cvv cvv (cmpt f2 (co (cpw (cv b)) (cv a) cmap) (cmpt y1 (cv b) (crab x3 (wcel (cv y1) (cfv (cv x3) (cv f2))) (cv a))))) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wceq G (co A2 B2 O) $ >
  $ wi ph (wcel F (co (cpw B2) A2 cmap)) $ >
  $ wi ph (wceq (cfv F G) (cmpt y1 B2 (crab x3 (wcel (cv y1) (cfv (cv x3) F)) A2))) $;

--| Value of the operator, ` ( A O B ) ` , which maps between maps from one base set to subsets of the second to maps from the second base set to subsets of the first for base sets, ` A ` and ` B ` , when applied to function ` F ` and element ` Y ` . (Contributed by RP, 25-Apr-2021.)
theorem fsovfvfvd {x3 y1 f2 a b: setvar} (ph: wff x3) (A2: class) (B2: class x3) (F: class a b) (G H O V W: class x3 y1 f2 a b) (Y: class f2 a b):
  $ wceq O (cmpo a b cvv cvv (cmpt f2 (co (cpw (cv b)) (cv a) cmap) (cmpt y1 (cv b) (crab x3 (wcel (cv y1) (cfv (cv x3) (cv f2))) (cv a))))) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wceq G (co A2 B2 O) $ >
  $ wi ph (wcel F (co (cpw B2) A2 cmap)) $ >
  $ wceq H (cfv F G) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (cfv Y H) (crab x3 (wcel Y (cfv (cv x3) F)) A2)) $;

--| The operator, ` ( A O B ) ` , which maps between maps from one base set to subsets of the second to maps from the second base set to subsets of the first for base sets, ` A ` and ` B ` , gives a function between two sets of functions. (Contributed by RP, 27-Apr-2021.)
theorem fsovfd {x3 y1 f2 a b: setvar} (ph: wff x3) (A2: class) (B2: class x3) (G O V W: class x3 y1 f2 a b):
  $ wceq O (cmpo a b cvv cvv (cmpt f2 (co (cpw (cv b)) (cv a) cmap) (cmpt y1 (cv b) (crab x3 (wcel (cv y1) (cfv (cv x3) (cv f2))) (cv a))))) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wceq G (co A2 B2 O) $ >
  $ wi ph (wf (co (cpw B2) A2 cmap) (co (cpw A2) B2 cmap) G) $;

--| The ` O ` operator, which maps between maps from one base set to subsets of the second to maps from the second base set to subsets of the first for base sets, gives a family of functions that include their own inverse. (Contributed by RP, 27-Apr-2021.)
theorem fsovcnvlem {x3 y1 f2 a b: setvar} (ph: wff x3) (A2: class) (B2: class x3) (G H O V W: class x3 y1 f2 a b):
  $ wceq O (cmpo a b cvv cvv (cmpt f2 (co (cpw (cv b)) (cv a) cmap) (cmpt y1 (cv b) (crab x3 (wcel (cv y1) (cfv (cv x3) (cv f2))) (cv a))))) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wceq G (co A2 B2 O) $ >
  $ wceq H (co B2 A2 O) $ >
  $ wi ph (wceq (ccom H G) (cres cid (co (cpw B2) A2 cmap))) $;

--| The value of the converse ` ( A O B ) ` is ` ( B O A ) ` , where ` O ` is the operator which maps between maps from one base set to subsets of the second to maps from the second base set to subsets of the first for base sets, gives a family of functions that include their own inverse. (Contributed by RP, 27-Apr-2021.)
theorem fsovcnvd {x3 y1 f2 a b: setvar} (ph: wff x3) (A2 B2: class) (G H O V W: class x3 y1 f2 a b):
  $ wceq O (cmpo a b cvv cvv (cmpt f2 (co (cpw (cv b)) (cv a) cmap) (cmpt y1 (cv b) (crab x3 (wcel (cv y1) (cfv (cv x3) (cv f2))) (cv a))))) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wceq G (co A2 B2 O) $ >
  $ wceq H (co B2 A2 O) $ >
  $ wi ph (wceq (ccnv G) H) $;

--| The value of the converse of ` ( A O B ) ` , where ` O ` is the operator which maps between maps from one base set to subsets of the second to maps from the second base set to subsets of the first for base sets, evaluated at function ` F ` . (Contributed by RP, 27-Apr-2021.)
theorem fsovcnvfvd {x3 y1 f2 a b: setvar} (ph: wff x3) (A2 B2: class) (F: class a b) (G O V W: class x3 y1 f2 a b):
  $ wceq O (cmpo a b cvv cvv (cmpt f2 (co (cpw (cv b)) (cv a) cmap) (cmpt y1 (cv b) (crab x3 (wcel (cv y1) (cfv (cv x3) (cv f2))) (cv a))))) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wceq G (co A2 B2 O) $ >
  $ wi ph (wcel F (co (cpw A2) B2 cmap)) $ >
  $ wi ph (wceq (cfv F (ccnv G)) (cmpt y1 A2 (crab x3 (wcel (cv y1) (cfv (cv x3) F)) B2))) $;

--| The value of ` ( A O B ) ` is a bijection, where ` O ` is the operator which maps between maps from one base set to subsets of the second to maps from the second base set to subsets of the first for base sets. (Contributed by RP, 27-Apr-2021.)
theorem fsovf1od {x3 y1 f2 a b: setvar} (ph: wff x3) (A2 B2: class) (G O V W: class x3 y1 f2 a b):
  $ wceq O (cmpo a b cvv cvv (cmpt f2 (co (cpw (cv b)) (cv a) cmap) (cmpt y1 (cv b) (crab x3 (wcel (cv y1) (cfv (cv x3) (cv f2))) (cv a))))) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wceq G (co A2 B2 O) $ >
  $ wi ph (wf1o (co (cpw B2) A2 cmap) (co (cpw A2) B2 cmap) G) $;

--| Value of the duality operator for self-mappings of subsets of a base set, ` B ` . (Contributed by RP, 19-Apr-2021.)
theorem dssmapfvd {f2 s1 b: setvar} (ph: wff f2 s1) (B2: class) (D O V: class f2 s1 b):
  $ wceq O (cmpt b cvv (cmpt f2 (co (cpw (cv b)) (cpw (cv b)) cmap) (cmpt s1 (cpw (cv b)) (cdif (cv b) (cfv (cdif (cv b) (cv s1)) (cv f2)))))) $ >
  $ wceq D (cfv B2 O) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wceq D (cmpt f2 (co (cpw B2) (cpw B2) cmap) (cmpt s1 (cpw B2) (cdif B2 (cfv (cdif B2 (cv s1)) (cv f2)))))) $;

--| Value of the duality operator for self-mappings of subsets of a base set, ` B ` when applied to function ` F ` . (Contributed by RP, 19-Apr-2021.)
theorem dssmapfv2d {f2 s1 b: setvar} (ph: wff s1) (B2: class) (D: class f2 s1 b) (F: class b) (G O V: class f2 s1 b):
  $ wceq O (cmpt b cvv (cmpt f2 (co (cpw (cv b)) (cpw (cv b)) cmap) (cmpt s1 (cpw (cv b)) (cdif (cv b) (cfv (cdif (cv b) (cv s1)) (cv f2)))))) $ >
  $ wceq D (cfv B2 O) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wcel F (co (cpw B2) (cpw B2) cmap)) $ >
  $ wceq G (cfv F D) $ >
  $ wi ph (wceq G (cmpt s1 (cpw B2) (cdif B2 (cfv (cdif B2 (cv s1)) F)))) $;

--| Value of the duality operator for self-mappings of subsets of a base set, ` B ` when applied to function ` F ` and subset ` S ` . (Contributed by RP, 19-Apr-2021.)
theorem dssmapfv3d {f2 s1 b: setvar} (ph: wff) (B2: class) (D: class f2 s1 b) (S: class f2 b) (T: class f2 s1 b) (F: class b) (G O V: class f2 s1 b):
  $ wceq O (cmpt b cvv (cmpt f2 (co (cpw (cv b)) (cpw (cv b)) cmap) (cmpt s1 (cpw (cv b)) (cdif (cv b) (cfv (cdif (cv b) (cv s1)) (cv f2)))))) $ >
  $ wceq D (cfv B2 O) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wcel F (co (cpw B2) (cpw B2) cmap)) $ >
  $ wceq G (cfv F D) $ >
  $ wi ph (wcel S (cpw B2)) $ >
  $ wceq T (cfv S G) $ >
  $ wi ph (wceq T (cdif B2 (cfv (cdif B2 S) F))) $;

--| For any base set ` B ` the duality operator for self-mappings of subsets of that base set is its own inverse, an involution. (Contributed by RP, 20-Apr-2021.)
theorem dssmapnvod {f2 s1 b: setvar} (ph: wff) (B2: class) (D O V: class f2 s1 b):
  $ wceq O (cmpt b cvv (cmpt f2 (co (cpw (cv b)) (cpw (cv b)) cmap) (cmpt s1 (cpw (cv b)) (cdif (cv b) (cfv (cdif (cv b) (cv s1)) (cv f2)))))) $ >
  $ wceq D (cfv B2 O) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wceq (ccnv D) D) $;

--| For any base set ` B ` the duality operator for self-mappings of subsets of that base set is one-to-one and onto. (Contributed by RP, 21-Apr-2021.)
theorem dssmapf1od {f2 s1 b: setvar} (ph: wff) (B2: class) (D O V: class f2 s1 b):
  $ wceq O (cmpt b cvv (cmpt f2 (co (cpw (cv b)) (cpw (cv b)) cmap) (cmpt s1 (cpw (cv b)) (cdif (cv b) (cfv (cdif (cv b) (cv s1)) (cv f2)))))) $ >
  $ wceq D (cfv B2 O) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wf1o (co (cpw B2) (cpw B2) cmap) (co (cpw B2) (cpw B2) cmap) D) $;

--| For any base set ` B ` the duality operator for self-mappings of subsets of that base set when composed with itself is the restricted identity operator. (Contributed by RP, 21-Apr-2021.)
theorem dssmap2d {f2 s1 b: setvar} (ph: wff) (B2: class) (D O V: class f2 s1 b):
  $ wceq O (cmpt b cvv (cmpt f2 (co (cpw (cv b)) (cpw (cv b)) cmap) (cmpt s1 (cpw (cv b)) (cdif (cv b) (cfv (cdif (cv b) (cv s1)) (cv f2)))))) $ >
  $ wceq D (cfv B2 O) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wceq (ccom D D) (cres cid (co (cpw B2) (cpw B2) cmap))) $;

--| Decompose disjunction into three cases. (Contributed by RP, 5-Jul-2021.)
theorem or3or (ph ps: wff):
  $ wb (wo ph ps) (w3o (wa ph ps) (wa ph (wn ps)) (wa (wn ph) ps)) $;

--| Distribute over triple disjunction. (Contributed by RP, 5-Jul-2021.)
theorem andi3or (ph ps ch th: wff):
  $ wb (wa ph (w3o ps ch th)) (w3o (wa ph ps) (wa ph ch) (wa ph th)) $;

--| If a union of classes is equal to a singleton then at least one class is equal to the singleton while the other may be equal to the empty set. (Contributed by RP, 5-Jul-2021.)
theorem uneqsn (A2 B2 C: class):
  $ wb (wceq (cun A2 B2) (csn C)) (w3o (wa (wceq A2 (csn C)) (wceq B2 (csn C))) (wa (wceq A2 (csn C)) (wceq B2 c0)) (wa (wceq A2 c0) (wceq B2 (csn C)))) $;

--| If a binary relation holds and the relation is the value of a function, then the argument to that function is a set. (Contributed by RP, 22-May-2021.)
theorem brfvimex (ph: wff) (A2 B2 C R F: class):
  $ wi ph (wbr A2 B2 R) $ >
  $ wi ph (wceq R (cfv C F)) $ >
  $ wi ph (wcel C cvv) $;

--| If a binary relation holds and the relation is the value of a binary operation built with maps-to, then the arguments to that operation are sets. (Contributed by RP, 22-May-2021.)
theorem brovmptimex {x3 y1: setvar} (ph: wff x3 y1) (A2 B2 C D R: class x3 y1) (E: class) (F: class x3) (G H: class x3 y1):
  $ wceq F (cmpo x3 y1 E G H) $ >
  $ wi ph (wbr A2 B2 R) $ >
  $ wi ph (wceq R (co C D F)) $ >
  $ wi ph (wa (wcel C cvv) (wcel D cvv)) $;

--| If a binary relation holds and the relation is the value of a binary operation built with maps-to, then the arguments to that operation are sets. (Contributed by RP, 22-May-2021.)
theorem brovmptimex1 {x3 y1: setvar} (ph: wff x3 y1) (A2 B2 C D R: class x3 y1) (E: class) (F: class x3) (G H: class x3 y1):
  $ wceq F (cmpo x3 y1 E G H) $ >
  $ wi ph (wbr A2 B2 R) $ >
  $ wi ph (wceq R (co C D F)) $ >
  $ wi ph (wcel C cvv) $;

--| If a binary relation holds and the relation is the value of a binary operation built with maps-to, then the arguments to that operation are sets. (Contributed by RP, 22-May-2021.)
theorem brovmptimex2 {x3 y1: setvar} (ph: wff x3 y1) (A2 B2 C D R: class x3 y1) (E: class) (F: class x3) (G H: class x3 y1):
  $ wceq F (cmpo x3 y1 E G H) $ >
  $ wi ph (wbr A2 B2 R) $ >
  $ wi ph (wceq R (co C D F)) $ >
  $ wi ph (wcel D cvv) $;

--| Conditions allowing the decomposition of a binary relation. (Contributed by RP, 7-Jun-2021.)
theorem brcoffn (ph: wff) (A2 B2 C D X Y: class):
  $ wi ph (wfn C Y) $ >
  $ wi ph (wf X Y D) $ >
  $ wi ph (wbr A2 B2 (ccom C D)) $ >
  $ wi ph (wa (wbr A2 (cfv A2 D) D) (wbr (cfv A2 D) B2 C)) $;

--| Conditions allowing the decomposition of a binary relation. (Contributed by RP, 8-Jun-2021.)
theorem brcofffn (ph: wff) (A2 B2 C D E X Y Z: class):
  $ wi ph (wfn C Z) $ >
  $ wi ph (wf Y Z D) $ >
  $ wi ph (wf X Y E) $ >
  $ wi ph (wbr A2 B2 (ccom C (ccom D E))) $ >
  $ wi ph (w3a (wbr A2 (cfv A2 E) E) (wbr (cfv A2 E) (cfv (cfv A2 E) D) D) (wbr (cfv (cfv A2 E) D) B2 C)) $;

--| Conditions allowing the decomposition of a binary relation. (Contributed by RP, 8-Jun-2021.)
theorem brco2f1o (ph: wff) (A2 B2 C D X Y Z: class):
  $ wi ph (wf1o Y Z C) $ >
  $ wi ph (wf1o X Y D) $ >
  $ wi ph (wbr A2 B2 (ccom C D)) $ >
  $ wi ph (wa (wbr (cfv B2 (ccnv C)) B2 C) (wbr A2 (cfv B2 (ccnv C)) D)) $;

--| Conditions allowing the decomposition of a binary relation. (Contributed by RP, 8-Jun-2021.)
theorem brco3f1o (ph: wff) (A2 B2 C D E W X Y Z: class):
  $ wi ph (wf1o Y Z C) $ >
  $ wi ph (wf1o X Y D) $ >
  $ wi ph (wf1o W X E) $ >
  $ wi ph (wbr A2 B2 (ccom C (ccom D E))) $ >
  $ wi ph (w3a (wbr (cfv B2 (ccnv C)) B2 C) (wbr (cfv (cfv B2 (ccnv C)) (ccnv D)) (cfv B2 (ccnv C)) D) (wbr A2 (cfv (cfv B2 (ccnv C)) (ccnv D)) E)) $;

--| If (pseudo-)interior and (pseudo-)closure functions are related by the duality operator then the base set exists. (Contributed by RP, 21-May-2021.)
theorem ntrclsbex (ph: wff) (B2 D I K O: class):
  $ wceq D (cfv B2 O) $ >
  $ wi ph (wbr I K D) $ >
  $ wi ph (wcel B2 cvv) $;

--| The relative complement of the class ` S ` exists as a subset of the base set. (Contributed by RP, 25-Jun-2021.)
theorem ntrclsrcomplex (ph: wff) (B2 D S I K O: class):
  $ wceq D (cfv B2 O) $ >
  $ wi ph (wbr I K D) $ >
  $ wi ph (wcel (cdif B2 S) (cpw B2)) $;

--| Kuratowski's K0 axiom implies K0'. Neighborhood version. Also a proof the dual KA axiom implies KA' when considering the convergents. (Contributed by RP, 28-Jun-2021.)
theorem neik0imk0p {x3: setvar} (B2 N: class x3):
  $ wi (wral x3 (wcel B2 (cfv (cv x3) N)) B2) (wral x3 (wne (cfv (cv x3) N) c0) B2) $;

--| If an interior function is contracting, the interiors of disjoint sets are disjoint. Kuratowski's K2 axiom implies KB. Interior version. (Contributed by RP, 9-Jun-2021.)
theorem ntrk2imkb {t s1: setvar} (B2 I: class):
  $ wi (wral s1 (wss (cfv (cv s1) I) (cv s1)) (cpw B2)) (wral s1 (wral t (wi (wceq (cin (cv s1) (cv t)) c0) (wceq (cin (cfv (cv s1) I) (cfv (cv t) I)) c0)) (cpw B2)) (cpw B2)) $;

--| If the interiors of disjoint sets are disjoint, then the interior of the empty set is the empty set. (Contributed by RP, 14-Jun-2021.)
theorem ntrkbimka {t s1: setvar} (B2 I: class):
  $ wi (wral s1 (wral t (wi (wceq (cin (cv s1) (cv t)) c0) (wceq (cin (cfv (cv s1) I) (cfv (cv t) I)) c0)) (cpw B2)) (cpw B2)) (wceq (cfv c0 I) c0) $;

--| If the interiors of disjoint sets are disjoint and the interior of the base set is the base set, then the interior of the empty set is the empty set. Obsolete version of ~ ntrkbimka . (Contributed by RP, 12-Jun-2021.)
theorem ntrk0kbimka {t s1: setvar} (B2 I: class) (V: class t s1):
  $ wi (wa (wcel B2 V) (wcel I (co (cpw B2) (cpw B2) cmap))) (wi (wa (wceq (cfv B2 I) B2) (wral s1 (wral t (wi (wceq (cin (cv s1) (cv t)) c0) (wceq (cin (cfv (cv s1) I) (cfv (cv t) I)) c0)) (cpw B2)) (cpw B2))) (wceq (cfv c0 I) c0)) $;

--| If the base set is not empty, axiom K3 does not imply KB. A concrete example with a pseudo-closure function of ` k = ( x e. ~P b |-> ( b \ x ) ) ` is given. (Contributed by RP, 16-Jun-2021.)
theorem clsk3nimkb {t k s1 b: setvar}:
  $ wn (wal b (wral k (wi (wral s1 (wral t (wss (cfv (cun (cv s1) (cv t)) (cv k)) (cun (cfv (cv s1) (cv k)) (cfv (cv t) (cv k)))) (cpw (cv b))) (cpw (cv b))) (wral s1 (wral t (wi (wceq (cun (cv s1) (cv t)) (cv b)) (wceq (cun (cfv (cv s1) (cv k)) (cfv (cv t) (cv k))) (cv b))) (cpw (cv b))) (cpw (cv b)))) (co (cpw (cv b)) (cpw (cv b)) cmap))) $;

--| The ansatz closure function ` ( r e. ~P 3o |-> if ( r = { (/) } , { (/) , 1o } , r ) ) ` has the K0 property of preserving the nullary union. (Contributed by RP, 6-Jul-2021.)
theorem clsk1indlem0 {r: setvar} (K: class r):
  $ wceq K (cmpt r (cpw c3o) (cif (wceq (cv r) (csn c0)) (cpr c0 c1o) (cv r))) $ >
  $ wceq (cfv c0 K) c0 $;

--| The ansatz closure function ` ( r e. ~P 3o |-> if ( r = { (/) } , { (/) , 1o } , r ) ) ` has the K2 property of expanding. (Contributed by RP, 6-Jul-2021.)
theorem clsk1indlem2 {s1 r: setvar} (K: class s1 r):
  $ wceq K (cmpt r (cpw c3o) (cif (wceq (cv r) (csn c0)) (cpr c0 c1o) (cv r))) $ >
  $ wral s1 (wss (cv s1) (cfv (cv s1) K)) (cpw c3o) $;

--| The ansatz closure function ` ( r e. ~P 3o |-> if ( r = { (/) } , { (/) , 1o } , r ) ) ` has the K3 property of being sub-linear. (Contributed by RP, 6-Jul-2021.)
theorem clsk1indlem3 {t s1 r: setvar} (K: class t s1 r):
  $ wceq K (cmpt r (cpw c3o) (cif (wceq (cv r) (csn c0)) (cpr c0 c1o) (cv r))) $ >
  $ wral s1 (wral t (wss (cfv (cun (cv s1) (cv t)) K) (cun (cfv (cv s1) K) (cfv (cv t) K))) (cpw c3o)) (cpw c3o) $;

--| The ansatz closure function ` ( r e. ~P 3o |-> if ( r = { (/) } , { (/) , 1o } , r ) ) ` has the K4 property of idempotence. (Contributed by RP, 6-Jul-2021.)
theorem clsk1indlem4 {s1 r: setvar} (K: class s1 r):
  $ wceq K (cmpt r (cpw c3o) (cif (wceq (cv r) (csn c0)) (cpr c0 c1o) (cv r))) $ >
  $ wral s1 (wceq (cfv (cfv (cv s1) K) K) (cfv (cv s1) K)) (cpw c3o) $;

--| The ansatz closure function ` ( r e. ~P 3o |-> if ( r = { (/) } , { (/) , 1o } , r ) ) ` does not have the K1 property of isotony. (Contributed by RP, 6-Jul-2021.)
theorem clsk1indlem1 {t s1 r: setvar} (K: class r):
  $ wceq K (cmpt r (cpw c3o) (cif (wceq (cv r) (csn c0)) (cpr c0 c1o) (cv r))) $ >
  $ wrex s1 (wrex t (wa (wss (cv s1) (cv t)) (wn (wss (cfv (cv s1) K) (cfv (cv t) K)))) (cpw c3o)) (cpw c3o) $;

--| For generalized closure functions, property K1 (isotony) is independent of the properties K0, K2, K3, K4. <HTML> This contradicts a claim which appears in preprints of Table 2 in B&auml;rbel M. R. Stadler and Peter F. Stadler. "Generalized Topological Spaces in Evolutionary Theory and Combinatorial Chemistry." <I>J. Chem. Inf. Comput. Sci.</I>, <B>42</B>:577-585, 2002. Proceedings MCC 2001, Dubrovnik. The same table row implying K1 follows from the other four appears in the supplemental materials B&auml;rbel M. R. Stadler and Peter F. Stadler. "Basic Properties of Closure Spaces" 2001 on page 12. </HTML> (Contributed by RP, 5-Jul-2021.)
theorem clsk1independent {t k s1 b: setvar} (ph ps ch th ta: wff t k s1 b):
  $ wb ph (wceq (cfv c0 (cv k)) c0) $ >
  $ wb ps (wral s1 (wral t (wi (wss (cv s1) (cv t)) (wss (cfv (cv s1) (cv k)) (cfv (cv t) (cv k)))) (cpw (cv b))) (cpw (cv b))) $ >
  $ wb ch (wral s1 (wss (cv s1) (cfv (cv s1) (cv k))) (cpw (cv b))) $ >
  $ wb th (wral s1 (wral t (wss (cfv (cun (cv s1) (cv t)) (cv k)) (cun (cfv (cv s1) (cv k)) (cfv (cv t) (cv k)))) (cpw (cv b))) (cpw (cv b))) $ >
  $ wb ta (wral s1 (wceq (cfv (cfv (cv s1) (cv k)) (cv k)) (cfv (cv s1) (cv k))) (cpw (cv b))) $ >
  $ wn (wal b (wral k (wi (wa (wa ph ch) (wa th ta)) ps) (co (cpw (cv b)) (cpw (cv b)) cmap))) $;

--| Kuratowski's K0' and K1 axioms imply K0. Neighborhood version. (Contributed by RP, 3-Jun-2021.)
theorem neik0pk1imk0 {x3 t s1: setvar} (ph: wff t) (B2 N: class x3) (V: class x3 t s1):
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wcel N (co (cpw (cpw B2)) B2 cmap)) $ >
  $ wi ph (wral x3 (wne (cfv (cv x3) N) c0) B2) $ >
  $ wi ph (wral x3 (wral s1 (wral t (wi (wa (wcel (cv s1) (cfv (cv x3) N)) (wss (cv s1) (cv t))) (wcel (cv t) (cfv (cv x3) N))) (cpw B2)) (cpw B2)) B2) $ >
  $ wi ph (wral x3 (wcel B2 (cfv (cv x3) N)) B2) $;

--| Two different ways to say subset relation persists across applications of a function. (Contributed by RP, 31-May-2021.)
theorem isotone1 {a b: setvar} (A2 F: class):
  $ wb (wral a (wral b (wi (wss (cv a) (cv b)) (wss (cfv (cv a) F) (cfv (cv b) F))) (cpw A2)) (cpw A2)) (wral a (wral b (wss (cun (cfv (cv a) F) (cfv (cv b) F)) (cfv (cun (cv a) (cv b)) F)) (cpw A2)) (cpw A2)) $;

--| Two different ways to say subset relation persists across applications of a function. (Contributed by RP, 31-May-2021.)
theorem isotone2 {a b: setvar} (A2 F: class):
  $ wb (wral a (wral b (wi (wss (cv a) (cv b)) (wss (cfv (cv a) F) (cfv (cv b) F))) (cpw A2)) (cpw A2)) (wral a (wral b (wss (cfv (cin (cv a) (cv b)) F) (cin (cfv (cv a) F) (cfv (cv b) F))) (cpw A2)) (cpw A2)) $;

--| An interior function is both monotone and sub-linear if and only if it is finitely linear. (Contributed by RP, 18-Jun-2021.)
theorem ntrk1k3eqk13 {t s1: setvar} (B2 I: class):
  $ wb (wa (wral s1 (wral t (wi (wss (cv s1) (cv t)) (wss (cfv (cv s1) I) (cfv (cv t) I))) (cpw B2)) (cpw B2)) (wral s1 (wral t (wss (cin (cfv (cv s1) I) (cfv (cv t) I)) (cfv (cin (cv s1) (cv t)) I)) (cpw B2)) (cpw B2))) (wral s1 (wral t (wceq (cfv (cin (cv s1) (cv t)) I) (cin (cfv (cv s1) I) (cfv (cv t) I))) (cpw B2)) (cpw B2)) $;

--| If (pseudo-)interior and (pseudo-)closure functions are related by the duality operator we may characterize the relation as part of a 1-to-1 onto function. (Contributed by RP, 29-May-2021.)
theorem ntrclsf1o {i j k: setvar} (ph: wff) (B2: class) (D I K O: class i j k):
  $ wceq O (cmpt i cvv (cmpt k (co (cpw (cv i)) (cpw (cv i)) cmap) (cmpt j (cpw (cv i)) (cdif (cv i) (cfv (cdif (cv i) (cv j)) (cv k)))))) $ >
  $ wceq D (cfv B2 O) $ >
  $ wi ph (wbr I K D) $ >
  $ wi ph (wf1o (co (cpw B2) (cpw B2) cmap) (co (cpw B2) (cpw B2) cmap) D) $;

--| If (pseudo-)interior and (pseudo-)closure functions are related by the duality operator then they are related the opposite way. (Contributed by RP, 21-May-2021.)
theorem ntrclsnvobr {i j k: setvar} (ph: wff) (B2: class) (D I K O: class i j k):
  $ wceq O (cmpt i cvv (cmpt k (co (cpw (cv i)) (cpw (cv i)) cmap) (cmpt j (cpw (cv i)) (cdif (cv i) (cfv (cdif (cv i) (cv j)) (cv k)))))) $ >
  $ wceq D (cfv B2 O) $ >
  $ wi ph (wbr I K D) $ >
  $ wi ph (wbr K I D) $;

--| If (pseudo-)interior and (pseudo-)closure functions are related by the duality operator then those functions are maps of subsets to subsets. (Contributed by RP, 21-May-2021.)
theorem ntrclsiex {i j k: setvar} (ph: wff) (B2: class) (D I K O: class i j k):
  $ wceq O (cmpt i cvv (cmpt k (co (cpw (cv i)) (cpw (cv i)) cmap) (cmpt j (cpw (cv i)) (cdif (cv i) (cfv (cdif (cv i) (cv j)) (cv k)))))) $ >
  $ wceq D (cfv B2 O) $ >
  $ wi ph (wbr I K D) $ >
  $ wi ph (wcel I (co (cpw B2) (cpw B2) cmap)) $;

--| If (pseudo-)interior and (pseudo-)closure functions are related by the duality operator then those functions are maps of subsets to subsets. (Contributed by RP, 21-May-2021.)
theorem ntrclskex {i j k: setvar} (ph: wff) (B2: class) (D I K O: class i j k):
  $ wceq O (cmpt i cvv (cmpt k (co (cpw (cv i)) (cpw (cv i)) cmap) (cmpt j (cpw (cv i)) (cdif (cv i) (cfv (cdif (cv i) (cv j)) (cv k)))))) $ >
  $ wceq D (cfv B2 O) $ >
  $ wi ph (wbr I K D) $ >
  $ wi ph (wcel K (co (cpw B2) (cpw B2) cmap)) $;

--| If (pseudo-)interior and (pseudo-)closure functions are related by the duality operator then there is a functional relation between them (Contributed by RP, 28-May-2021.)
theorem ntrclsfv1 {i j k: setvar} (ph: wff) (B2: class) (D I K O: class i j k):
  $ wceq O (cmpt i cvv (cmpt k (co (cpw (cv i)) (cpw (cv i)) cmap) (cmpt j (cpw (cv i)) (cdif (cv i) (cfv (cdif (cv i) (cv j)) (cv k)))))) $ >
  $ wceq D (cfv B2 O) $ >
  $ wi ph (wbr I K D) $ >
  $ wi ph (wceq (cfv I D) K) $;

--| If (pseudo-)interior and (pseudo-)closure functions are related by the duality operator then there is a functional relation between them (Contributed by RP, 28-May-2021.)
theorem ntrclsfv2 {i j k: setvar} (ph: wff) (B2: class) (D I K O: class i j k):
  $ wceq O (cmpt i cvv (cmpt k (co (cpw (cv i)) (cpw (cv i)) cmap) (cmpt j (cpw (cv i)) (cdif (cv i) (cfv (cdif (cv i) (cv j)) (cv k)))))) $ >
  $ wceq D (cfv B2 O) $ >
  $ wi ph (wbr I K D) $ >
  $ wi ph (wceq (cfv K D) I) $;

--| If (pseudo-)interior and (pseudo-)closure functions are related by the duality operator then there is an equivalence between membership in the interior of a set and non-membership in the closure of the complement of the set. (Contributed by RP, 28-May-2021.)
theorem ntrclselnel1 {i j k: setvar} (ph: wff) (B2: class) (D: class i j k) (S: class i k) (I: class i j k) (K: class i) (O X: class i j k):
  $ wceq O (cmpt i cvv (cmpt k (co (cpw (cv i)) (cpw (cv i)) cmap) (cmpt j (cpw (cv i)) (cdif (cv i) (cfv (cdif (cv i) (cv j)) (cv k)))))) $ >
  $ wceq D (cfv B2 O) $ >
  $ wi ph (wbr I K D) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel S (cpw B2)) $ >
  $ wi ph (wb (wcel X (cfv S I)) (wn (wcel X (cfv (cdif B2 S) K)))) $;

--| If (pseudo-)interior and (pseudo-)closure functions are related by the duality operator then there is an equivalence between membership in interior of the complement of a set and non-membership in the closure of the set. (Contributed by RP, 28-May-2021.)
theorem ntrclselnel2 {i j k: setvar} (ph: wff) (B2: class) (D: class i j k) (S: class i k) (I: class i) (K O X: class i j k):
  $ wceq O (cmpt i cvv (cmpt k (co (cpw (cv i)) (cpw (cv i)) cmap) (cmpt j (cpw (cv i)) (cdif (cv i) (cfv (cdif (cv i) (cv j)) (cv k)))))) $ >
  $ wceq D (cfv B2 O) $ >
  $ wi ph (wbr I K D) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel S (cpw B2)) $ >
  $ wi ph (wb (wcel X (cfv (cdif B2 S) I)) (wn (wcel X (cfv S K)))) $;

--| The value of the interior (closure) expressed in terms of the closure (interior). (Contributed by RP, 25-Jun-2021.)
theorem ntrclsfv {i j k: setvar} (ph: wff) (B2: class) (D: class i j k) (S: class i k) (I: class i j k) (K: class i) (O: class i j k):
  $ wceq O (cmpt i cvv (cmpt k (co (cpw (cv i)) (cpw (cv i)) cmap) (cmpt j (cpw (cv i)) (cdif (cv i) (cfv (cdif (cv i) (cv j)) (cv k)))))) $ >
  $ wceq D (cfv B2 O) $ >
  $ wi ph (wbr I K D) $ >
  $ wi ph (wcel S (cpw B2)) $ >
  $ wi ph (wceq (cfv S I) (cdif B2 (cfv (cdif B2 S) K))) $;

--| If interior and closure functions are related then specific function values are complementary. (Contributed by RP, 27-Jun-2021.)
theorem ntrclsfveq1 {i j k: setvar} (ph: wff) (B2: class) (C D: class i j k) (S: class i k) (I: class i j k) (K: class i) (O: class i j k):
  $ wceq O (cmpt i cvv (cmpt k (co (cpw (cv i)) (cpw (cv i)) cmap) (cmpt j (cpw (cv i)) (cdif (cv i) (cfv (cdif (cv i) (cv j)) (cv k)))))) $ >
  $ wceq D (cfv B2 O) $ >
  $ wi ph (wbr I K D) $ >
  $ wi ph (wcel S (cpw B2)) $ >
  $ wi ph (wcel C (cpw B2)) $ >
  $ wi ph (wb (wceq (cfv S I) C) (wceq (cfv (cdif B2 S) K) (cdif B2 C))) $;

--| If interior and closure functions are related then specific function values are complementary. (Contributed by RP, 27-Jun-2021.)
theorem ntrclsfveq2 {i j k: setvar} (ph: wff) (B2: class) (C D: class i j k) (S: class i k) (I: class i) (K O: class i j k):
  $ wceq O (cmpt i cvv (cmpt k (co (cpw (cv i)) (cpw (cv i)) cmap) (cmpt j (cpw (cv i)) (cdif (cv i) (cfv (cdif (cv i) (cv j)) (cv k)))))) $ >
  $ wceq D (cfv B2 O) $ >
  $ wi ph (wbr I K D) $ >
  $ wi ph (wcel S (cpw B2)) $ >
  $ wi ph (wcel C (cpw B2)) $ >
  $ wi ph (wb (wceq (cfv (cdif B2 S) I) C) (wceq (cfv S K) (cdif B2 C))) $;

--| If interior and closure functions are related then equality of a pair of function values is equivalent to equality of a pair of the other function's values. (Contributed by RP, 27-Jun-2021.)
theorem ntrclsfveq {i j k: setvar} (ph: wff) (B2: class) (D: class i j k) (S T: class i k) (I: class i j k) (K: class i) (O: class i j k):
  $ wceq O (cmpt i cvv (cmpt k (co (cpw (cv i)) (cpw (cv i)) cmap) (cmpt j (cpw (cv i)) (cdif (cv i) (cfv (cdif (cv i) (cv j)) (cv k)))))) $ >
  $ wceq D (cfv B2 O) $ >
  $ wi ph (wbr I K D) $ >
  $ wi ph (wcel S (cpw B2)) $ >
  $ wi ph (wcel T (cpw B2)) $ >
  $ wi ph (wb (wceq (cfv S I) (cfv T I)) (wceq (cfv (cdif B2 S) K) (cfv (cdif B2 T) K))) $;

--| If interior and closure functions are related then a subset relation of a pair of function values is equivalent to subset relation of a pair of the other function's values. (Contributed by RP, 27-Jun-2021.)
theorem ntrclsss {i j k: setvar} (ph: wff) (B2: class) (D: class i j k) (S T: class i k) (I: class i j k) (K: class i) (O: class i j k):
  $ wceq O (cmpt i cvv (cmpt k (co (cpw (cv i)) (cpw (cv i)) cmap) (cmpt j (cpw (cv i)) (cdif (cv i) (cfv (cdif (cv i) (cv j)) (cv k)))))) $ >
  $ wceq D (cfv B2 O) $ >
  $ wi ph (wbr I K D) $ >
  $ wi ph (wcel S (cpw B2)) $ >
  $ wi ph (wcel T (cpw B2)) $ >
  $ wi ph (wb (wss (cfv S I) (cfv T I)) (wss (cfv (cdif B2 T) K) (cfv (cdif B2 S) K))) $;

--| If (pseudo-)interior and (pseudo-)closure functions are related by the duality operator then conditions equal to claiming that at least one (pseudo-)neighborbood of a particular point exists hold equally. (Contributed by RP, 21-May-2021.)
theorem ntrclsneine0lem {i j k s1: setvar} (ph: wff) (B2: class) (D: class i j k s1) (I: class i) (K O: class i j k s1) (X: class i j k):
  $ wceq O (cmpt i cvv (cmpt k (co (cpw (cv i)) (cpw (cv i)) cmap) (cmpt j (cpw (cv i)) (cdif (cv i) (cfv (cdif (cv i) (cv j)) (cv k)))))) $ >
  $ wceq D (cfv B2 O) $ >
  $ wi ph (wbr I K D) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wb (wrex s1 (wcel X (cfv (cv s1) I)) (cpw B2)) (wrex s1 (wn (wcel X (cfv (cv s1) K))) (cpw B2))) $;

--| If (pseudo-)interior and (pseudo-)closure functions are related by the duality operator then conditions equal to claiming that for every point, at least one (pseudo-)neighborbood exists hold equally. (Contributed by RP, 21-May-2021.)
theorem ntrclsneine0 {x3 i j k s1: setvar} (ph: wff) (B2: class x3) (D: class x3 i j k s1) (I: class x3 i) (K O: class x3 i j k s1):
  $ wceq O (cmpt i cvv (cmpt k (co (cpw (cv i)) (cpw (cv i)) cmap) (cmpt j (cpw (cv i)) (cdif (cv i) (cfv (cdif (cv i) (cv j)) (cv k)))))) $ >
  $ wceq D (cfv B2 O) $ >
  $ wi ph (wbr I K D) $ >
  $ wi ph (wb (wral x3 (wrex s1 (wcel (cv x3) (cfv (cv s1) I)) (cpw B2)) B2) (wral x3 (wrex s1 (wn (wcel (cv x3) (cfv (cv s1) K))) (cpw B2)) B2)) $;

--| If (pseudo-)interior and (pseudo-)closure functions are related by the duality operator then conditions equal to claiming that the closure of the empty set is the empty set hold equally. (Contributed by RP, 1-Jun-2021.)
theorem ntrclscls00 {i j k: setvar} (ph: wff) (B2: class) (D: class i j k) (I K: class i) (O: class i j k):
  $ wceq O (cmpt i cvv (cmpt k (co (cpw (cv i)) (cpw (cv i)) cmap) (cmpt j (cpw (cv i)) (cdif (cv i) (cfv (cdif (cv i) (cv j)) (cv k)))))) $ >
  $ wceq D (cfv B2 O) $ >
  $ wi ph (wbr I K D) $ >
  $ wi ph (wb (wceq (cfv B2 I) B2) (wceq (cfv c0 K) c0)) $;

--| If (pseudo-)interior and (pseudo-)closure functions are related by the duality operator then conditions equal to claiming that either is isotonic hold equally. (Contributed by RP, 3-Jun-2021.)
theorem ntrclsiso {t i j k s1: setvar} (ph: wff) (B2: class) (D: class t i j k s1) (I: class i) (K O: class t i j k s1):
  $ wceq O (cmpt i cvv (cmpt k (co (cpw (cv i)) (cpw (cv i)) cmap) (cmpt j (cpw (cv i)) (cdif (cv i) (cfv (cdif (cv i) (cv j)) (cv k)))))) $ >
  $ wceq D (cfv B2 O) $ >
  $ wi ph (wbr I K D) $ >
  $ wi ph (wb (wral s1 (wral t (wi (wss (cv s1) (cv t)) (wss (cfv (cv s1) I) (cfv (cv t) I))) (cpw B2)) (cpw B2)) (wral s1 (wral t (wi (wss (cv s1) (cv t)) (wss (cfv (cv s1) K) (cfv (cv t) K))) (cpw B2)) (cpw B2))) $;

--| An interior function is contracting if and only if the closure function is expansive. (Contributed by RP, 9-Jun-2021.)
theorem ntrclsk2 {i j k s1: setvar} (ph: wff) (B2: class) (D: class i j k s1) (I: class i) (K O: class i j k s1):
  $ wceq O (cmpt i cvv (cmpt k (co (cpw (cv i)) (cpw (cv i)) cmap) (cmpt j (cpw (cv i)) (cdif (cv i) (cfv (cdif (cv i) (cv j)) (cv k)))))) $ >
  $ wceq D (cfv B2 O) $ >
  $ wi ph (wbr I K D) $ >
  $ wi ph (wb (wral s1 (wss (cfv (cv s1) I) (cv s1)) (cpw B2)) (wral s1 (wss (cv s1) (cfv (cv s1) K)) (cpw B2))) $;

--| The interiors of disjoint sets are disjoint if and only if the closures of sets that span the base set also span the base set. (Contributed by RP, 10-Jun-2021.)
theorem ntrclskb {t i j k s1: setvar} (ph: wff) (B2: class) (D: class t i j k s1) (I: class i) (K O: class t i j k s1):
  $ wceq O (cmpt i cvv (cmpt k (co (cpw (cv i)) (cpw (cv i)) cmap) (cmpt j (cpw (cv i)) (cdif (cv i) (cfv (cdif (cv i) (cv j)) (cv k)))))) $ >
  $ wceq D (cfv B2 O) $ >
  $ wi ph (wbr I K D) $ >
  $ wi ph (wb (wral s1 (wral t (wi (wceq (cin (cv s1) (cv t)) c0) (wceq (cin (cfv (cv s1) I) (cfv (cv t) I)) c0)) (cpw B2)) (cpw B2)) (wral s1 (wral t (wi (wceq (cun (cv s1) (cv t)) B2) (wceq (cun (cfv (cv s1) K) (cfv (cv t) K)) B2)) (cpw B2)) (cpw B2))) $;

--| The intersection of interiors of a every pair is a subset of the interior of the intersection of the pair if an only if the closure of the union of every pair is a subset of the union of closures of the pair. (Contributed by RP, 19-Jun-2021.)
theorem ntrclsk3 {t i j k s1: setvar} (ph: wff) (B2: class) (D: class t i j k s1) (I: class) (K O: class t i j k s1):
  $ wceq O (cmpt i cvv (cmpt k (co (cpw (cv i)) (cpw (cv i)) cmap) (cmpt j (cpw (cv i)) (cdif (cv i) (cfv (cdif (cv i) (cv j)) (cv k)))))) $ >
  $ wceq D (cfv B2 O) $ >
  $ wi ph (wbr I K D) $ >
  $ wi ph (wb (wral s1 (wral t (wss (cin (cfv (cv s1) I) (cfv (cv t) I)) (cfv (cin (cv s1) (cv t)) I)) (cpw B2)) (cpw B2)) (wral s1 (wral t (wss (cfv (cun (cv s1) (cv t)) K) (cun (cfv (cv s1) K) (cfv (cv t) K))) (cpw B2)) (cpw B2))) $;

--| The interior of the intersection of any pair is equal to the intersection of the interiors if and only if the closure of the unions of any pair is equal to the union of closures. (Contributed by RP, 19-Jun-2021.)
theorem ntrclsk13 {t i j k s1: setvar} (ph: wff) (B2: class) (D: class t i j k s1) (I: class) (K O: class t i j k s1):
  $ wceq O (cmpt i cvv (cmpt k (co (cpw (cv i)) (cpw (cv i)) cmap) (cmpt j (cpw (cv i)) (cdif (cv i) (cfv (cdif (cv i) (cv j)) (cv k)))))) $ >
  $ wceq D (cfv B2 O) $ >
  $ wi ph (wbr I K D) $ >
  $ wi ph (wb (wral s1 (wral t (wceq (cfv (cin (cv s1) (cv t)) I) (cin (cfv (cv s1) I) (cfv (cv t) I))) (cpw B2)) (cpw B2)) (wral s1 (wral t (wceq (cfv (cun (cv s1) (cv t)) K) (cun (cfv (cv s1) K) (cfv (cv t) K))) (cpw B2)) (cpw B2))) $;

--| Idempotence of the interior function is equivalent to idempotence of the closure function. (Contributed by RP, 10-Jul-2021.)
theorem ntrclsk4 {i j k s1: setvar} (ph: wff) (B2: class) (D: class i j k s1) (I: class i) (K: class i k s1) (O: class i j k s1):
  $ wceq O (cmpt i cvv (cmpt k (co (cpw (cv i)) (cpw (cv i)) cmap) (cmpt j (cpw (cv i)) (cdif (cv i) (cfv (cdif (cv i) (cv j)) (cv k)))))) $ >
  $ wceq D (cfv B2 O) $ >
  $ wi ph (wbr I K D) $ >
  $ wi ph (wb (wral s1 (wceq (cfv (cfv (cv s1) I) I) (cfv (cv s1) I)) (cpw B2)) (wral s1 (wceq (cfv (cfv (cv s1) K) K) (cfv (cv s1) K)) (cpw B2))) $;

--| If (pseudo-)interior and (pseudo-)neighborhood functions are related by the operator, ` F ` , then the base set exists. (Contributed by RP, 29-May-2021.)
theorem ntrneibex {i j k m l: setvar} (ph: wff i j k m l) (B2 F I N O: class i j k m l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wi ph (wbr I N F) $ >
  $ wi ph (wcel B2 cvv) $;

--| The relative complement of the class ` S ` exists as a subset of the base set. (Contributed by RP, 26-Jun-2021.)
theorem ntrneircomplex {i j k m l: setvar} (ph: wff i j k m l) (B2 S F I N O: class i j k m l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wi ph (wbr I N F) $ >
  $ wi ph (wcel (cdif B2 S) (cpw B2)) $;

--| If (pseudo-)interior and (pseudo-)neighborhood functions are related by the operator, ` F ` , we may characterize the relation as part of a 1-to-1 onto function. (Contributed by RP, 29-May-2021.)
theorem ntrneif1o {i j k m l: setvar} (ph: wff m) (B2: class) (F I N O: class i j k m l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wi ph (wbr I N F) $ >
  $ wi ph (wf1o (co (cpw B2) (cpw B2) cmap) (co (cpw (cpw B2)) B2 cmap) F) $;

--| If (pseudo-)interior and (pseudo-)neighborhood functions are related by the operator, ` F ` , then the interior function exists. (Contributed by RP, 29-May-2021.)
theorem ntrneiiex {i j k m l: setvar} (ph: wff m) (B2: class) (F I N O: class i j k m l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wi ph (wbr I N F) $ >
  $ wi ph (wcel I (co (cpw B2) (cpw B2) cmap)) $;

--| If (pseudo-)interior and (pseudo-)neighborhood functions are related by the operator, ` F ` , then the neighborhood function exists. (Contributed by RP, 29-May-2021.)
theorem ntrneinex {i j k m l: setvar} (ph: wff m) (B2: class) (F I N O: class i j k m l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wi ph (wbr I N F) $ >
  $ wi ph (wcel N (co (cpw (cpw B2)) B2 cmap)) $;

--| If (pseudo-)interior and (pseudo-)neighborhood functions are related by the operator, ` F ` , then converse of ` F ` is known. (Contributed by RP, 29-May-2021.)
theorem ntrneicnv {i j k m l: setvar} (ph: wff m) (B2: class) (F I N O: class i j k m l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wi ph (wbr I N F) $ >
  $ wi ph (wceq (ccnv F) (co B2 (cpw B2) O)) $;

--| If (pseudo-)interior and (pseudo-)neighborhood functions are related by the operator, ` F ` , then the function value of ` F ` is the neighborhood function. (Contributed by RP, 29-May-2021.)
theorem ntrneifv1 {i j k m l: setvar} (ph: wff m) (B2: class) (F I N O: class i j k m l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wi ph (wbr I N F) $ >
  $ wi ph (wceq (cfv I F) N) $;

--| If (pseudo-)interior and (pseudo-)neighborhood functions are related by the operator, ` F ` , then the function value of converse of ` F ` is the interior function. (Contributed by RP, 29-May-2021.)
theorem ntrneifv2 {i j k m l: setvar} (ph: wff m) (B2: class) (F I N O: class i j k m l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wi ph (wbr I N F) $ >
  $ wi ph (wceq (cfv N (ccnv F)) I) $;

--| If (pseudo-)interior and (pseudo-)neighborhood functions are related by the operator, ` F ` , then there is an equivalence between membership in the interior of a set and non-membership in the closure of the complement of the set. (Contributed by RP, 29-May-2021.)
theorem ntrneiel {i j k m l: setvar} (ph: wff m) (B2: class) (S: class i j k l) (F: class i j k m l) (I: class i j) (N O: class i j k m l) (X: class i j k):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wi ph (wbr I N F) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel S (cpw B2)) $ >
  $ wi ph (wb (wcel X (cfv S I)) (wcel S (cfv X N))) $;

--| The value of the neighbors (convergents) expressed in terms of the interior (closure) function. (Contributed by RP, 26-Jun-2021.)
theorem ntrneifv3 {i j k m s1 l: setvar} (ph: wff m) (B2: class) (F: class i j k m s1 l) (I: class i j s1) (N: class i j k m l) (O: class i j k m s1 l) (X: class i j k):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wi ph (wbr I N F) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (cfv X N) (crab s1 (wcel X (cfv (cv s1) I)) (cpw B2))) $;

--| If (pseudo-)interior and (pseudo-)neighborhood functions are related by the operator, ` F ` , then conditions equal to claiming that for every point, at least one (pseudo-)neighborbood exists hold equally. (Contributed by RP, 29-May-2021.)
theorem ntrneineine0lem {i j k m s1 l: setvar} (ph: wff m) (B2: class s1) (F: class i j k m s1 l) (I: class i j s1) (N: class i j k m l) (O: class i j k m s1 l) (X: class i j k):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wi ph (wbr I N F) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wb (wrex s1 (wcel X (cfv (cv s1) I)) (cpw B2)) (wne (cfv X N) c0)) $;

--| If (pseudo-)interior and (pseudo-)neighborhood functions are related by the operator, ` F ` , then conditions equal to claiming that for every point, at not all subsets are (pseudo-)neighborboods hold equally. (Contributed by RP, 1-Jun-2021.)
theorem ntrneineine1lem {i j k m s1 l: setvar} (ph: wff m) (B2: class) (F: class i j k m s1 l) (I: class i j s1) (N: class i j k m l) (O: class i j k m s1 l) (X: class i j k):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wi ph (wbr I N F) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wb (wrex s1 (wn (wcel X (cfv (cv s1) I))) (cpw B2)) (wne (cfv X N) (cpw B2))) $;

--| The value of the interior (closure) expressed in terms of the neighbors (convergents) function. (Contributed by RP, 26-Jun-2021.)
theorem ntrneifv4 {x3 i j k m l: setvar} (ph: wff m) (B2: class) (S: class i j k l) (F: class x3 i j k m l) (I: class i j) (N O: class x3 i j k m l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wi ph (wbr I N F) $ >
  $ wi ph (wcel S (cpw B2)) $ >
  $ wi ph (wceq (cfv S I) (crab x3 (wcel S (cfv (cv x3) N)) B2)) $;

--| Membership in iterated interior of a set is equivalent to there existing a particular neighborhood of that member such that points are members of that neighborhood if and only if the set is a neighborhood of each of those points. (Contributed by RP, 11-Jul-2021.)
theorem ntrneiel2 {y1 u i j k m l: setvar} (ph: wff m) (B2: class) (S: class i j k l) (F: class y1 u i j k m l) (I: class u i j) (N: class i j k m l) (O: class y1 u i j k m l) (X: class i j k):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wi ph (wbr I N F) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel S (cpw B2)) $ >
  $ wi ph (wb (wcel X (cfv (cfv S I) I)) (wrex u (wral y1 (wb (wcel (cv y1) (cv u)) (wcel S (cfv (cv y1) N))) B2) (cfv X N))) $;

--| If (pseudo-)interior and (pseudo-)neighborhood functions are related by the operator, ` F ` , then conditions equal to claiming that for every point, at least one (pseudo-)neighborbood exists hold equally. (Contributed by RP, 29-May-2021.)
theorem ntrneineine0 {x3 i j k m s1 l: setvar} (ph: wff m) (B2: class x3) (F: class x3 i j k m s1 l) (I: class x3 i j s1) (N: class x3 i j k m l) (O: class x3 i j k m s1 l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wi ph (wbr I N F) $ >
  $ wi ph (wb (wral x3 (wrex s1 (wcel (cv x3) (cfv (cv s1) I)) (cpw B2)) B2) (wral x3 (wne (cfv (cv x3) N) c0) B2)) $;

--| If (pseudo-)interior and (pseudo-)neighborhood functions are related by the operator, ` F ` , then conditions equal to claiming that for every point, at not all subsets are (pseudo-)neighborboods hold equally. (Contributed by RP, 1-Jun-2021.)
theorem ntrneineine1 {x3 i j k m s1 l: setvar} (ph: wff m) (B2: class x3) (F: class x3 i j k m s1 l) (I: class x3 i j s1) (N: class x3 i j k m l) (O: class x3 i j k m s1 l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wi ph (wbr I N F) $ >
  $ wi ph (wb (wral x3 (wrex s1 (wn (wcel (cv x3) (cfv (cv s1) I))) (cpw B2)) B2) (wral x3 (wne (cfv (cv x3) N) (cpw B2)) B2)) $;

--| If (pseudo-)interior and (pseudo-)neighborhood functions are related by the operator, ` F ` , then conditions equal to claiming that the closure of the empty set is the empty set hold equally. (Contributed by RP, 2-Jun-2021.)
theorem ntrneicls00 {x3 i j k m l: setvar} (ph: wff m) (B2: class) (F: class x3 i j k m l) (I: class i j) (N O: class x3 i j k m l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wi ph (wbr I N F) $ >
  $ wi ph (wb (wceq (cfv B2 I) B2) (wral x3 (wcel B2 (cfv (cv x3) N)) B2)) $;

--| If (pseudo-)interior and (pseudo-)neighborhood functions are related by the operator, ` F ` , then conditions equal to claiming that the interior of the empty set is the empty set hold equally. (Contributed by RP, 2-Jun-2021.)
theorem ntrneicls11 {x3 i j k m l: setvar} (ph: wff m) (B2: class) (F: class x3 i j k m l) (I: class i j) (N O: class x3 i j k m l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wi ph (wbr I N F) $ >
  $ wi ph (wb (wceq (cfv c0 I) c0) (wral x3 (wn (wcel c0 (cfv (cv x3) N))) B2)) $;

--| If (pseudo-)interior and (pseudo-)neighborhood functions are related by the operator, ` F ` , then conditions equal to claiming that the interior function is isotonic hold equally. (Contributed by RP, 3-Jun-2021.)
theorem ntrneiiso {x3 t i j k m s1 l: setvar} (ph: wff m) (B2: class) (F: class x3 t i j k m s1 l) (I: class t i j s1) (N O: class x3 t i j k m s1 l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wi ph (wbr I N F) $ >
  $ wi ph (wb (wral s1 (wral t (wi (wss (cv s1) (cv t)) (wss (cfv (cv s1) I) (cfv (cv t) I))) (cpw B2)) (cpw B2)) (wral x3 (wral s1 (wral t (wi (wa (wcel (cv s1) (cfv (cv x3) N)) (wss (cv s1) (cv t))) (wcel (cv t) (cfv (cv x3) N))) (cpw B2)) (cpw B2)) B2)) $;

--| An interior function is contracting if and only if all the neighborhoods of a point contain that point. (Contributed by RP, 11-Jun-2021.)
theorem ntrneik2 {x3 i j k m s1 l: setvar} (ph: wff m) (B2: class) (F: class x3 i j k m s1 l) (I: class i j s1) (N O: class x3 i j k m s1 l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wi ph (wbr I N F) $ >
  $ wi ph (wb (wral s1 (wss (cfv (cv s1) I) (cv s1)) (cpw B2)) (wral x3 (wral s1 (wi (wcel (cv s1) (cfv (cv x3) N)) (wcel (cv x3) (cv s1))) (cpw B2)) B2)) $;

--| An interior (closure) function is expansive if and only if all subsets which contain a point are neighborhoods (convergents) of that point. (Contributed by RP, 11-Jun-2021.)
theorem ntrneix2 {x3 i j k m s1 l: setvar} (ph: wff m) (B2: class) (F: class x3 i j k m s1 l) (I: class i j s1) (N O: class x3 i j k m s1 l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wi ph (wbr I N F) $ >
  $ wi ph (wb (wral s1 (wss (cv s1) (cfv (cv s1) I)) (cpw B2)) (wral x3 (wral s1 (wi (wcel (cv x3) (cv s1)) (wcel (cv s1) (cfv (cv x3) N))) (cpw B2)) B2)) $;

--| The interiors of disjoint sets are disjoint if and only if the neighborhoods of every point contain no disjoint sets. (Contributed by RP, 11-Jun-2021.)
theorem ntrneikb {x3 t i j k m s1 l: setvar} (ph: wff m) (B2: class) (F: class x3 t i j k m s1 l) (I: class t i j s1) (N O: class x3 t i j k m s1 l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wi ph (wbr I N F) $ >
  $ wi ph (wb (wral s1 (wral t (wi (wceq (cin (cv s1) (cv t)) c0) (wceq (cin (cfv (cv s1) I) (cfv (cv t) I)) c0)) (cpw B2)) (cpw B2)) (wral x3 (wral s1 (wral t (wi (wa (wcel (cv s1) (cfv (cv x3) N)) (wcel (cv t) (cfv (cv x3) N))) (wne (cin (cv s1) (cv t)) c0)) (cpw B2)) (cpw B2)) B2)) $;

--| The interiors (closures) of sets that span the base set also span the base set if and only if the neighborhoods (convergents) of every point contain at least one of every pair of sets that span the base set. (Contributed by RP, 11-Jun-2021.)
theorem ntrneixb {x3 t i j k m s1 l: setvar} (ph: wff m) (B2: class) (F: class x3 t i j k m s1 l) (I: class t i j s1) (N O: class x3 t i j k m s1 l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wi ph (wbr I N F) $ >
  $ wi ph (wb (wral s1 (wral t (wi (wceq (cun (cv s1) (cv t)) B2) (wceq (cun (cfv (cv s1) I) (cfv (cv t) I)) B2)) (cpw B2)) (cpw B2)) (wral x3 (wral s1 (wral t (wi (wceq (cun (cv s1) (cv t)) B2) (wo (wcel (cv s1) (cfv (cv x3) N)) (wcel (cv t) (cfv (cv x3) N)))) (cpw B2)) (cpw B2)) B2)) $;

--| The intersection of interiors of any pair is a subset of the interior of the intersection if and only if the intersection of any two neighborhoods of a point is also a neighborhood. (Contributed by RP, 19-Jun-2021.)
theorem ntrneik3 {x3 t i j k m s1 l: setvar} (ph: wff m) (B2: class) (F: class x3 t i j k m s1 l) (I: class t i j s1) (N O: class x3 t i j k m s1 l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wi ph (wbr I N F) $ >
  $ wi ph (wb (wral s1 (wral t (wss (cin (cfv (cv s1) I) (cfv (cv t) I)) (cfv (cin (cv s1) (cv t)) I)) (cpw B2)) (cpw B2)) (wral x3 (wral s1 (wral t (wi (wa (wcel (cv s1) (cfv (cv x3) N)) (wcel (cv t) (cfv (cv x3) N))) (wcel (cin (cv s1) (cv t)) (cfv (cv x3) N))) (cpw B2)) (cpw B2)) B2)) $;

--| The closure of the union of any pair is a subset of the union of closures if and only if the union of any pair belonging to the convergents of a point implies at least one of the pair belongs to the the convergents of that point. (Contributed by RP, 19-Jun-2021.)
theorem ntrneix3 {x3 t i j k m s1 l: setvar} (ph: wff m) (B2: class) (F: class x3 t i j k m s1 l) (I: class t i j s1) (N O: class x3 t i j k m s1 l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wi ph (wbr I N F) $ >
  $ wi ph (wb (wral s1 (wral t (wss (cfv (cun (cv s1) (cv t)) I) (cun (cfv (cv s1) I) (cfv (cv t) I))) (cpw B2)) (cpw B2)) (wral x3 (wral s1 (wral t (wi (wcel (cun (cv s1) (cv t)) (cfv (cv x3) N)) (wo (wcel (cv s1) (cfv (cv x3) N)) (wcel (cv t) (cfv (cv x3) N)))) (cpw B2)) (cpw B2)) B2)) $;

--| The interior of the intersection of any pair equals intersection of interiors if and only if the intersection of any pair belonging to the neighborhood of a point is equivalent to both of the pair belonging to the neighborhood of that point. (Contributed by RP, 19-Jun-2021.)
theorem ntrneik13 {x3 t i j k m s1 l: setvar} (ph: wff m) (B2: class) (F: class x3 t i j k m s1 l) (I: class t i j s1) (N O: class x3 t i j k m s1 l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wi ph (wbr I N F) $ >
  $ wi ph (wb (wral s1 (wral t (wceq (cfv (cin (cv s1) (cv t)) I) (cin (cfv (cv s1) I) (cfv (cv t) I))) (cpw B2)) (cpw B2)) (wral x3 (wral s1 (wral t (wb (wcel (cin (cv s1) (cv t)) (cfv (cv x3) N)) (wa (wcel (cv s1) (cfv (cv x3) N)) (wcel (cv t) (cfv (cv x3) N)))) (cpw B2)) (cpw B2)) B2)) $;

--| The closure of the union of any pair is equal to the union of closures if and only if the union of any pair belonging to the convergents of a point if equivalent to at least one of the pain belonging to the convergents of that point. (Contributed by RP, 19-Jun-2021.)
theorem ntrneix13 {x3 t i j k m s1 l: setvar} (ph: wff m) (B2: class) (F: class x3 t i j k m s1 l) (I: class t i j s1) (N O: class x3 t i j k m s1 l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wi ph (wbr I N F) $ >
  $ wi ph (wb (wral s1 (wral t (wceq (cfv (cun (cv s1) (cv t)) I) (cun (cfv (cv s1) I) (cfv (cv t) I))) (cpw B2)) (cpw B2)) (wral x3 (wral s1 (wral t (wb (wcel (cun (cv s1) (cv t)) (cfv (cv x3) N)) (wo (wcel (cv s1) (cfv (cv x3) N)) (wcel (cv t) (cfv (cv x3) N)))) (cpw B2)) (cpw B2)) B2)) $;

--| Idempotence of the interior function is equivalent to saying a set is a neighborhood of a point if and only if the interior of the set is a neighborhood of a point. (Contributed by RP, 11-Jul-2021.)
theorem ntrneik4w {x3 i j k m s1 l: setvar} (ph: wff m) (B2: class) (F: class x3 i j k m s1 l) (I: class i j s1) (N O: class x3 i j k m s1 l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wi ph (wbr I N F) $ >
  $ wi ph (wb (wral s1 (wceq (cfv (cfv (cv s1) I) I) (cfv (cv s1) I)) (cpw B2)) (wral x3 (wral s1 (wb (wcel (cv s1) (cfv (cv x3) N)) (wcel (cfv (cv s1) I) (cfv (cv x3) N))) (cpw B2)) B2)) $;

--| Idempotence of the interior function is equivalent to stating a set, ` s ` , is a neighborhood of a point, ` x ` is equivalent to there existing a special neighborhood, ` u ` , of ` x ` such that a point is an element of the special neighborhood if and only if ` s ` is also a neighborhood of the point. (Contributed by RP, 11-Jul-2021.)
theorem ntrneik4 {x3 y1 u i j k m s1 l: setvar} (ph: wff m) (B2: class) (F: class x3 y1 u i j k m s1 l) (I: class u i j s1) (N: class x3 i j k m s1 l) (O: class x3 y1 u i j k m s1 l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wi ph (wbr I N F) $ >
  $ wi ph (wb (wral s1 (wceq (cfv (cfv (cv s1) I) I) (cfv (cv s1) I)) (cpw B2)) (wral x3 (wral s1 (wb (wcel (cv s1) (cfv (cv x3) N)) (wrex u (wral y1 (wb (wcel (cv y1) (cv u)) (wcel (cv s1) (cfv (cv y1) N))) B2) (cfv (cv x3) N))) (cpw B2)) B2)) $;

--| If (pseudo-)closure and (pseudo-)neighborhood functions are related by the composite operator, ` H ` , then the base set exists. (Contributed by RP, 4-Jun-2021.)
theorem clsneibex (ph: wff) (B2 D P F H K N: class):
  $ wceq D (cfv B2 P) $ >
  $ wceq H (ccom F D) $ >
  $ wi ph (wbr K N H) $ >
  $ wi ph (wcel B2 cvv) $;

--| The relative complement of the class ` S ` exists as a subset of the base set. (Contributed by RP, 26-Jun-2021.)
theorem clsneircomplex (ph: wff) (B2 D P S F H K N: class):
  $ wceq D (cfv B2 P) $ >
  $ wceq H (ccom F D) $ >
  $ wi ph (wbr K N H) $ >
  $ wi ph (wcel (cdif B2 S) (cpw B2)) $;

--| If a (pseudo-)closure function and a (pseudo-)neighborhood function are related by the ` H ` operator, then the operator is a one-to-one, onto mapping. (Contributed by RP, 5-Jun-2021.)
theorem clsneif1o {i j k m n o p l: setvar} (ph: wff m) (B2: class) (D P F H K N O: class i j k m n o p l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq P (cmpt n cvv (cmpt p (co (cpw (cv n)) (cpw (cv n)) cmap) (cmpt o (cpw (cv n)) (cdif (cv n) (cfv (cdif (cv n) (cv o)) (cv p)))))) $ >
  $ wceq D (cfv B2 P) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wceq H (ccom F D) $ >
  $ wi ph (wbr K N H) $ >
  $ wi ph (wf1o (co (cpw B2) (cpw B2) cmap) (co (cpw (cpw B2)) B2 cmap) H) $;

--| If a (pseudo-)closure function and a (pseudo-)neighborhood function are related by the ` H ` operator, then the converse of the operator is known. (Contributed by RP, 5-Jun-2021.)
theorem clsneicnv {i j k m n o p l: setvar} (ph: wff m) (B2: class) (D P F H K N O: class i j k m n o p l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq P (cmpt n cvv (cmpt p (co (cpw (cv n)) (cpw (cv n)) cmap) (cmpt o (cpw (cv n)) (cdif (cv n) (cfv (cdif (cv n) (cv o)) (cv p)))))) $ >
  $ wceq D (cfv B2 P) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wceq H (ccom F D) $ >
  $ wi ph (wbr K N H) $ >
  $ wi ph (wceq (ccnv H) (ccom D (co B2 (cpw B2) O))) $;

--| If closure and neighborhoods functions are related, the closure function exists. (Contributed by RP, 27-Jun-2021.)
theorem clsneikex {i j k m n o p l: setvar} (ph: wff m) (B2: class) (D P F H K N O: class i j k m n o p l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq P (cmpt n cvv (cmpt p (co (cpw (cv n)) (cpw (cv n)) cmap) (cmpt o (cpw (cv n)) (cdif (cv n) (cfv (cdif (cv n) (cv o)) (cv p)))))) $ >
  $ wceq D (cfv B2 P) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wceq H (ccom F D) $ >
  $ wi ph (wbr K N H) $ >
  $ wi ph (wcel K (co (cpw B2) (cpw B2) cmap)) $;

--| If closure and neighborhoods functions are related, the neighborhoods function exists. (Contributed by RP, 27-Jun-2021.)
theorem clsneinex {i j k m n o p l: setvar} (ph: wff m) (B2: class) (D P F H K N O: class i j k m n o p l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq P (cmpt n cvv (cmpt p (co (cpw (cv n)) (cpw (cv n)) cmap) (cmpt o (cpw (cv n)) (cdif (cv n) (cfv (cdif (cv n) (cv o)) (cv p)))))) $ >
  $ wceq D (cfv B2 P) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wceq H (ccom F D) $ >
  $ wi ph (wbr K N H) $ >
  $ wi ph (wcel N (co (cpw (cpw B2)) B2 cmap)) $;

--| If a (pseudo-)closure function and a (pseudo-)neighborhood function are related by the ` H ` operator, then membership in the closure of a subset is equivalent to the complement of the subset not being a neighborhood of the point. (Contributed by RP, 7-Jun-2021.)
theorem clsneiel1 {i j k m n o p l: setvar} (ph: wff m) (B2 D: class) (P: class i j k m n o p l) (S: class i j k n p l) (F: class m) (H: class i j k m n o p l) (K: class) (N: class m) (O: class i j k m n o p l) (X: class i j k n o p):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq P (cmpt n cvv (cmpt p (co (cpw (cv n)) (cpw (cv n)) cmap) (cmpt o (cpw (cv n)) (cdif (cv n) (cfv (cdif (cv n) (cv o)) (cv p)))))) $ >
  $ wceq D (cfv B2 P) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wceq H (ccom F D) $ >
  $ wi ph (wbr K N H) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel S (cpw B2)) $ >
  $ wi ph (wb (wcel X (cfv S K)) (wn (wcel (cdif B2 S) (cfv X N)))) $;

--| If a (pseudo-)closure function and a (pseudo-)neighborhood function are related by the ` H ` operator, then membership in the closure of the complement of a subset is equivalent to the subset not being a neighborhood of the point. (Contributed by RP, 7-Jun-2021.)
theorem clsneiel2 {i j k m n o p l: setvar} (ph: wff m) (B2 D: class) (P: class i j k m n o p l) (S: class i j k n p l) (F: class m) (H: class i j k m n o p l) (K: class) (N: class m) (O: class i j k m n o p l) (X: class i j k n o p):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq P (cmpt n cvv (cmpt p (co (cpw (cv n)) (cpw (cv n)) cmap) (cmpt o (cpw (cv n)) (cdif (cv n) (cfv (cdif (cv n) (cv o)) (cv p)))))) $ >
  $ wceq D (cfv B2 P) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wceq H (ccom F D) $ >
  $ wi ph (wbr K N H) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel S (cpw B2)) $ >
  $ wi ph (wb (wcel X (cfv (cdif B2 S) K)) (wn (wcel S (cfv X N)))) $;

--| Value of the neighborhoods (convergents) in terms of the closure (interior) function. (Contributed by RP, 27-Jun-2021.)
theorem clsneifv3 {i j k m n o s1 p l: setvar} (ph: wff m) (B2: class) (D: class s1) (P: class i j k m n o s1 p l) (F: class m s1) (H: class i j k m n o s1 p l) (K: class s1) (N: class m) (O: class i j k m n o s1 p l) (X: class i j k n o p):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq P (cmpt n cvv (cmpt p (co (cpw (cv n)) (cpw (cv n)) cmap) (cmpt o (cpw (cv n)) (cdif (cv n) (cfv (cdif (cv n) (cv o)) (cv p)))))) $ >
  $ wceq D (cfv B2 P) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wceq H (ccom F D) $ >
  $ wi ph (wbr K N H) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (cfv X N) (crab s1 (wn (wcel X (cfv (cdif B2 (cv s1)) K))) (cpw B2))) $;

--| Value of the closure (interior) function in terms of the neighborhoods (convergents) function. (Contributed by RP, 27-Jun-2021.)
theorem clsneifv4 {x3 i j k m n o p l: setvar} (ph: wff m) (B2: class) (D: class x3) (P: class x3 i j k m n o p l) (S: class i j k n p l) (F: class x3 m) (H: class x3 i j k m n o p l) (K: class) (N: class x3 m) (O: class x3 i j k m n o p l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq P (cmpt n cvv (cmpt p (co (cpw (cv n)) (cpw (cv n)) cmap) (cmpt o (cpw (cv n)) (cdif (cv n) (cfv (cdif (cv n) (cv o)) (cv p)))))) $ >
  $ wceq D (cfv B2 P) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wceq H (ccom F D) $ >
  $ wi ph (wbr K N H) $ >
  $ wi ph (wcel S (cpw B2)) $ >
  $ wi ph (wceq (cfv S K) (crab x3 (wn (wcel (cdif B2 S) (cfv (cv x3) N))) B2)) $;

--| If (pseudo-)neighborhood and (pseudo-)convergent functions are related by the composite operator, ` H ` , then the base set exists. (Contributed by RP, 4-Jun-2021.)
theorem neicvgbex (ph: wff) (B2 D P F G H M N: class):
  $ wceq D (cfv B2 P) $ >
  $ wceq H (ccom F (ccom D G)) $ >
  $ wi ph (wbr N M H) $ >
  $ wi ph (wcel B2 cvv) $;

--| The relative complement of the class ` S ` exists as a subset of the base set. (Contributed by RP, 26-Jun-2021.)
theorem neicvgrcomplex (ph: wff) (B2 D P S F G H M N: class):
  $ wceq D (cfv B2 P) $ >
  $ wceq H (ccom F (ccom D G)) $ >
  $ wi ph (wbr N M H) $ >
  $ wi ph (wcel (cdif B2 S) (cpw B2)) $;

--| If neighborhood and convergent functions are related by operator ` H ` , it is a one-to-one onto relation. (Contributed by RP, 11-Jun-2021.)
theorem neicvgf1o {i j k m n o p l: setvar} (ph: wff m) (B2: class) (D P F G H M N O: class i j k m n o p l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq P (cmpt n cvv (cmpt p (co (cpw (cv n)) (cpw (cv n)) cmap) (cmpt o (cpw (cv n)) (cdif (cv n) (cfv (cdif (cv n) (cv o)) (cv p)))))) $ >
  $ wceq D (cfv B2 P) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wceq G (co B2 (cpw B2) O) $ >
  $ wceq H (ccom F (ccom D G)) $ >
  $ wi ph (wbr N M H) $ >
  $ wi ph (wf1o (co (cpw (cpw B2)) B2 cmap) (co (cpw (cpw B2)) B2 cmap) H) $;

--| If neighborhood and convergent functions are related by operator ` H ` , it is its own converse function. (Contributed by RP, 11-Jun-2021.)
theorem neicvgnvo {i j k m n o p l: setvar} (ph: wff m) (B2: class) (D P F G H M N O: class i j k m n o p l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq P (cmpt n cvv (cmpt p (co (cpw (cv n)) (cpw (cv n)) cmap) (cmpt o (cpw (cv n)) (cdif (cv n) (cfv (cdif (cv n) (cv o)) (cv p)))))) $ >
  $ wceq D (cfv B2 P) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wceq G (co B2 (cpw B2) O) $ >
  $ wceq H (ccom F (ccom D G)) $ >
  $ wi ph (wbr N M H) $ >
  $ wi ph (wceq (ccnv H) H) $;

--| If neighborhood and convergent functions are related by operator ` H ` , the relationship holds with the functions swapped. (Contributed by RP, 11-Jun-2021.)
theorem neicvgnvor {i j k m n o p l: setvar} (ph: wff m) (B2: class) (D P F G H M N O: class i j k m n o p l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq P (cmpt n cvv (cmpt p (co (cpw (cv n)) (cpw (cv n)) cmap) (cmpt o (cpw (cv n)) (cdif (cv n) (cfv (cdif (cv n) (cv o)) (cv p)))))) $ >
  $ wceq D (cfv B2 P) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wceq G (co B2 (cpw B2) O) $ >
  $ wceq H (ccom F (ccom D G)) $ >
  $ wi ph (wbr N M H) $ >
  $ wi ph (wbr M N H) $;

--| If the neighborhoods and convergents functions are related, the convergents function exists. (Contributed by RP, 27-Jun-2021.)
theorem neicvgmex {i j k m n o p l: setvar} (ph: wff m) (B2: class) (D P F G H M N O: class i j k m n o p l):
  $ wceq O (cmpo i j cvv cvv (cmpt k (co (cpw (cv j)) (cv i) cmap) (cmpt l (cv j) (crab m (wcel (cv l) (cfv (cv m) (cv k))) (cv i))))) $ >
  $ wceq P (cmpt n cvv (cmpt p (co (cpw (cv n)) (cpw (cv n)) cmap) (cmpt o (cpw (cv n)) (cdif (cv n) (cfv (cdif (cv n) (cv o)) (cv p)))))) $ >
  $ wceq D (cfv B2 P) $ >
  $ wceq F (co (cpw B2) B2 O) $ >
  $ wceq G (co B2 (cpw B2) O) $ >
  $ wceq H (ccom F (ccom D G)) $ >
  $ wi ph (wbr N M H) $ >
  $ wi ph (wcel M (co (cpw (cpw B2)) B2 cmap)) $;

--| If the neighborhoods and convergents functions are related, the neighborhoods function exists. (Contributed by RP, 27-Jun-2021.)
theorem neicvgnex {i j k m n o p l: setvar} (ph: wff m) (B2: class) (D P F G H M N O: class i j k m n o p l):

theorem chpdmatlem1 (A2 B2 C P Q R S T c_x c_1 G M c_mi N X c_0 Z: class):
  $ wceq C (co N R cchpmat) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq S (cfv P cascl) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq G (cfv P cmgp) $ >
  $ wceq c_mi (cfv P csg) $ >
  $ wceq Q (co N P cmat) $ >
  $ wceq c_1 (cfv Q cur) $ >
  $ wceq c_x (cfv Q cvsca) $ >
  $ wceq Z (cfv Q csg) $ >
  $ wceq T (co N R cmat2pmat) $ >
  $ wi (w3a (wcel N cfn) (wcel R crg) (wcel M B2)) (wcel (co (co X c_1 c_x) (cfv M T) Z) (cfv Q cbs)) $;

--| Lemma 2 for ~ chpdmat . (Contributed by AV, 18-Aug-2019.)
theorem chpdmatlem2 (A2 B2 C P Q R S T c_x c_1: class) (i j: setvar) (G M c_mi N X c_0 Z: class):
  $ wceq C (co N R cchpmat) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq S (cfv P cascl) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq G (cfv P cmgp) $ >
  $ wceq c_mi (cfv P csg) $ >
  $ wceq Q (co N P cmat) $ >
  $ wceq c_1 (cfv Q cur) $ >
  $ wceq c_x (cfv Q cvsca) $ >
  $ wceq Z (cfv Q csg) $ >
  $ wceq T (co N R cmat2pmat) $ >
  $ wi (wa (wa (wa (wa (w3a (wcel N cfn) (wcel R crg) (wcel M B2)) (wcel (cv i) N)) (wcel (cv j) N)) (wne (cv i) (cv j))) (wceq (co (cv i) (cv j) M) c_0)) (wceq (co (cv i) (cv j) (co (co X c_1 c_x) (cfv M T) Z)) (cfv P c0g)) $;

--| Lemma 3 for ~ chpdmat . (Contributed by AV, 18-Aug-2019.)
theorem chpdmatlem3 (A2 B2 C P Q R S T c_x c_1 G K M c_mi N X c_0 Z: class):
  $ wceq C (co N R cchpmat) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq S (cfv P cascl) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq G (cfv P cmgp) $ >
  $ wceq c_mi (cfv P csg) $ >
  $ wceq Q (co N P cmat) $ >
  $ wceq c_1 (cfv Q cur) $ >
  $ wceq c_x (cfv Q cvsca) $ >
  $ wceq Z (cfv Q csg) $ >

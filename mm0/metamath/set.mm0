--| Lemma 2 for ~ pgnbgreunbgr . Impossible cases. (Contributed by AV, 18-Nov-2025.)
theorem pgnbgreunbgrlem2 {y1 b: setvar} (E G K L N V X: class y1 b):
  $ wceq G (co c5 c2 cgpg) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq N (co G X cnbgr) $ >
  $ wi (w3o (wceq L (cop c1 (co (co (cfv X c2nd) c2 caddc) c5 cmo))) (wceq L (cop cc0 (cfv X c2nd))) (wceq L (cop c1 (co (co (cfv X c2nd) c2 cmin) c5 cmo)))) (wi (w3o (wceq K (cop c1 (co (co (cfv X c2nd) c2 caddc) c5 cmo))) (wceq K (cop cc0 (cfv X c2nd))) (wceq K (cop c1 (co (co (cfv X c2nd) c2 cmin) c5 cmo)))) (wi (wa (wceq X (cop c1 (cv y1))) (wcel X V)) (wi (wa (wne K L) (wa (wcel (cv b) (co cc0 c5 cfzo)) (wcel (cv y1) (co cc0 c5 cfzo)))) (wi (wa (wcel (cpr K (cop cc0 (cv b))) E) (wcel (cpr (cop cc0 (cv b)) L) E)) (wceq X (cop cc0 (cv b))))))) $;


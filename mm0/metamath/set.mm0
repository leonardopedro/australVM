  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq S (cfv W (cfv K chdma)) $ >
  $ wceq G (cfv W (cfv K chg)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel C (cfv (csn E) O)) $ >
  $ wi ph (wcel D (cfv (csn E) O)) $ >
  $ wi ph (wcel I B2) $ >
  $ wi ph (wcel J B2) $ >
  $ wi ph (wceq (cfv (cfv C (cfv D S)) G) (cfv D (cfv C S))) $;

--| Involution property of scalar sigma map. Line 10 in [Baer] p. 111, t sigma squared = t. Our ` E ` , ` C ` , ` D ` , ` Y ` , ` X ` correspond to Baer's w, h, k, s, t. (Contributed by NM, 13-Jun-2015.)
theorem hgmapvvlem1 (ph: wff) (B2 C D R S c_x c_xp U c_1 E G H K N O V W X Y c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq E (cop (cres cid (cfv K cbs)) (cres cid (cfv W (cfv K cltrn)))) $ >
  $ wceq O (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq N (cfv R cinvr) $ >
  $ wceq S (cfv W (cfv K chdma)) $ >
  $ wceq G (cfv W (cfv K chg)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (cdif B2 (csn c_0))) $ >
  $ wi ph (wcel C (cfv (csn E) O)) $ >
  $ wi ph (wcel D (cfv (csn E) O)) $ >
  $ wi ph (wceq (cfv C (cfv D S)) c_1) $ >
  $ wi ph (wcel Y (cdif B2 (csn c_0))) $ >
  $ wi ph (wceq (co Y (cfv X G) c_xp) c_1) $ >
  $ wi ph (wceq (cfv (cfv X G) G) X) $;

--| Lemma for ~ hgmapvv . Eliminate ` Y ` (Baer's s). (Contributed by NM, 13-Jun-2015.)
theorem hgmapvvlem2 (ph: wff) (B2 C D R S c_x c_xp U c_1 E G H K N O V W X c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq E (cop (cres cid (cfv K cbs)) (cres cid (cfv W (cfv K cltrn)))) $ >

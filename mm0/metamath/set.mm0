  $ wceq D (co (co (co R c2 cexp) Q cmul) (co C c2 cexp) cmin) $ >
  $ wceq L (crab p (wceq (co (co A2 (cfv cc0 (cv p)) cmul) (co B2 (cfv c1 (cv p)) cmul) caddc) C) P) $ >
  $ wi (w3a (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wo (wne A2 cc0) (wne B2 cc0)) (wa (wcel R crp) (wbr cc0 D cle))) (wi (wa (wcel X (co c_0 R S)) (wcel X L)) (wo (wa (wceq (cfv cc0 X) (co (co (co A2 C cmul) (co B2 (cfv D csqrt) cmul) caddc) Q cdiv)) (wceq (cfv c1 X) (co (co (co B2 C cmul) (co A2 (cfv D csqrt) cmul) cmin) Q cdiv))) (wa (wceq (cfv cc0 X) (co (co (co A2 C cmul) (co B2 (cfv D csqrt) cmul) cmin) Q cdiv)) (wceq (cfv c1 X) (co (co (co B2 C cmul) (co A2 (cfv D csqrt) cmul) caddc) Q cdiv))))) $;


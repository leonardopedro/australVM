  $ wi ph (wreu y1 (wral z (wi (wn (wcel (cv z) (cun (cfv (csn X) N) (cfv (csn T) N)))) (wceq (cv y1) (cfv (cotp (cv z) (cfv (cotp X F (cv z)) I) T) I))) V) D) $;

--| Convert ~ mapdh9aOLDN to use the ` HDMap1 ` notation. (Contributed by NM, 15-May-2015.) (New usage is discouraged.)
theorem hdmap1euOLDN {y1 z: setvar} (ph: wff) (C D T U F: class) (H I K: class y1 z) (L M N V: class) (W: class y1 z) (X c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq D (cfv C cbs) $ >
  $ wceq L (cfv C clspn) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq I (cfv W (cfv K chdma1)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wceq (cfv (cfv (csn X) N) M) (cfv (csn F) L)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel F D) $ >
  $ wi ph (wcel T V) $ >
  $ wi ph (wreu y1 (wral z (wi (wn (wcel (cv z) (cfv (cpr X T) N))) (wceq (cv y1) (cfv (cotp (cv z) (cfv (cotp X F (cv z)) I) T) I))) V) D) $;

--| Map from vectors to functionals in the closed kernel dual space. (Contributed by NM, 15-May-2015.)
theorem hdmapffval {y1 z w v u t e i a: setvar} (H: class y1 z v u t e i a) (K: class) (X: class y1 z w v u t e i a):
  $ wceq H (cfv K clh) $ >
  $ wi (wcel K X) (wceq (cfv K chdma) (cmpt w H (cab a (wsbc e (wsbc u (wsbc v (wsbc i (wcel (cv a) (cmpt t (cv v) (crio y1 (wral z (wi (wn (wcel (cv z) (cun (cfv (csn (cv e)) (cfv (cv u) clspn)) (cfv (csn (cv t)) (cfv (cv u) clspn))))) (wceq (cv y1) (cfv (cotp (cv z) (cfv (cotp (cv e) (cfv (cv e) (cfv (cv w) (cfv K chvm))) (cv z)) (cv i)) (cv t)) (cv i)))) (cv v)) (cfv (cfv (cv w) (cfv K clcd)) cbs)))) (cfv (cv w) (cfv K chdma1))) (cfv (cv u) cbs)) (cfv (cv w) (cfv K cdvh))) (cop (cres cid (cfv K cbs)) (cres cid (cfv (cv w) (cfv K cltrn)))))))) $;

--| Map from vectors to functionals in the closed kernel dual space. (Contributed by NM, 15-May-2015.)
theorem hdmapfval {y1 z t: setvar} (ph: wff y1 z t) (A2 C: class y1 z t) (D: class z t) (S: class y1 z t) (U E: class) (H: class y1 z t) (I: class) (J: class y1 z t) (K: class) (N: class y1 z t) (V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq E (cop (cres cid (cfv K cbs)) (cres cid (cfv W (cfv K cltrn)))) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq D (cfv C cbs) $ >
  $ wceq J (cfv W (cfv K chvm)) $ >
  $ wceq I (cfv W (cfv K chdma1)) $ >
  $ wceq S (cfv W (cfv K chdma)) $ >
  $ wi ph (wa (wcel K A2) (wcel W H)) $ >
  $ wi ph (wceq S (cmpt t V (crio y1 (wral z (wi (wn (wcel (cv z) (cun (cfv (csn E) N) (cfv (csn (cv t)) N)))) (wceq (cv y1) (cfv (cotp (cv z) (cfv (cotp E (cfv E J) (cv z)) I) (cv t)) I))) V) D))) $;

--| Value of map from vectors to functionals in the closed kernel dual space. This is the function sigma on line 27 above part 9 in [Baer] p. 48. We select a convenient fixed reference vector ` E ` to be ` <. 0 , 1 >. ` (corresponding to vector u on p. 48 line 7) whose span is the lattice isomorphism map of the fiducial atom ` P = ( ( oc `` K ) `` W ) ` (see ~ dvheveccl ). ` ( J `` E ) ` is a fixed reference functional determined by this vector (corresponding to u' on line 8; ~ mapdhvmap shows in Baer's notation (Fu)* = Gu'). Baer's independent vectors v and w on line 7 correspond to our ` z ` that the ` A. z e. V ` ranges over. The middle term ` ( I `` <. E , ( J `` E ) , z >. ) ` provides isolation to allow ` E ` and ` T ` to assume the same value without conflict. Closure is shown by ~ hdmapcl . If a separate auxiliary vector is known, ~ hdmapval2 provides a version without quantification. (Contributed by NM, 15-May-2015.)
theorem hdmapval {y1 z: setvar} (ph: wff y1 z) (A2 C: class y1 z) (D: class z) (S: class y1 z) (T U E: class) (H: class y1 z) (I: class) (J: class y1 z) (K: class) (N: class y1 z) (V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq E (cop (cres cid (cfv K cbs)) (cres cid (cfv W (cfv K cltrn)))) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq D (cfv C cbs) $ >
  $ wceq J (cfv W (cfv K chvm)) $ >
  $ wceq I (cfv W (cfv K chdma1)) $ >
  $ wceq S (cfv W (cfv K chdma)) $ >
  $ wi ph (wa (wcel K A2) (wcel W H)) $ >
  $ wi ph (wcel T V) $ >
  $ wi ph (wceq (cfv T S) (crio y1 (wral z (wi (wn (wcel (cv z) (cun (cfv (csn E) N) (cfv (csn T) N)))) (wceq (cv y1) (cfv (cotp (cv z) (cfv (cotp E (cfv E J) (cv z)) I) T) I))) V) D)) $;

--| Functionality of map from vectors to functionals with closed kernels. (Contributed by NM, 30-May-2015.) (New usage is discouraged.)
theorem hdmapfnN (ph: wff) (S U H K V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq S (cfv W (cfv K chdma)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wfn S V) $;

--| Closure of map from vectors to functionals with closed kernels. (Contributed by NM, 15-May-2015.)
theorem hdmapcl (ph: wff) (C D S T U H K V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq D (cfv C cbs) $ >
  $ wceq S (cfv W (cfv K chdma)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel T V) $ >
  $ wi ph (wcel (cfv T S) D) $;


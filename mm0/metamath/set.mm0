--| Part of proof of part 16 in [Baer] p. 50 line 23, Fs=G, except that we use the original vector space scalars for the range. (Contributed by NM, 7-Jun-2015.) (New usage is discouraged.)
theorem hgmaprnN (ph: wff) (B2 R U G H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq G (cfv W (cfv K chg)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wceq (crn G) B2) $;

--| The scalar sigma map is one-to-one. (Contributed by NM, 7-Jun-2015.)
theorem hgmap11 (ph: wff) (B2 R U G H K W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq G (cfv W (cfv K chg)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wb (wceq (cfv X G) (cfv Y G)) (wceq X Y)) $;

--| The scalar sigma map is a one-to-one onto function. (Contributed by NM, 7-Jun-2015.) (New usage is discouraged.)
theorem hgmapf1oN (ph: wff) (B2 R U G H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq G (cfv W (cfv K chg)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wf1o B2 B2 G) $;

--| The scalar sigma map is zero iff its argument is zero. (Contributed by NM, 12-Jun-2015.)
theorem hgmapeq0 (ph: wff) (B2 R U G H K W X c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq G (cfv W (cfv K chg)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wb (wceq (cfv X G) c_0) (wceq X c_0)) $;

--| The inner product (Hermitian form) ` ( X , Y ) ` will be defined as ` ( ( S `` Y ) `` X ) ` . Show closure. (Contributed by NM, 7-Jun-2015.)
theorem hdmapipcl (ph: wff) (B2 R S U H K V W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq S (cfv W (cfv K chdma)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wcel (cfv X (cfv Y S)) B2) $;

--| Linearity property that will be used for inner product. TODO: try to combine hypotheses in hdmap*ln* series. (Contributed by NM, 7-Jun-2015.)
theorem hdmapln1 (ph: wff) (A2 B2 c_pl c_pd R S c_x c_xp U H K V W X Y Z: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pd (cfv R cplusg) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wceq S (cfv W (cfv K chdma)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wcel Z V) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wceq (cfv (co (co A2 X c_x) Y c_pl) (cfv Z S)) (co (co A2 (cfv X (cfv Z S)) c_xp) (cfv Y (cfv Z S)) c_pd)) $;

--| Additive property of first (inner product) argument. (Contributed by NM, 11-Jun-2015.)
theorem hdmaplna1 (ph: wff) (c_pl c_pd R S U H K V W X Y Z: class):
  $ wceq H (cfv K clh) $ >

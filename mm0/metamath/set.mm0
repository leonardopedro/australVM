  $ wceq c_x (cfv P cvsca) $ >
  $ wceq E (cfv (cfv P cmgp) cmg) $ >
  $ wceq Y (cfv R cv1) $ >
  $ wceq I (cmpt p L (cmpo i j N N (co P (cmpt k cn0 (co (co (cv i) (cv j) (cfv (cv k) (cfv (cv p) cco1))) (co (cv k) Y E) c_x)) cgsu))) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq c_as (cfv Q cvsca) $ >
  $ wceq c_ex (cfv (cfv Q cmgp) cmg) $ >
  $ wceq X (cfv A2 cv1) $ >
  $ wi (w3a (wcel N cfn) (wcel R crg) (wcel O L)) (wbr (cmpt k cn0 (co (co (cfv O I) (cv k) cdecpmat) (co (cv k) X c_ex) c_as)) (cfv Q c0g) cfsupp) $;

--| A polynomial over matrices transformed into a polynomial matrix transformed back into the polynomial over matrices. (Contributed by AV, 12-Oct-2019.)
theorem mp2pm2mp {i j k p: setvar} (A2: class p) (P: class) (Q: class i j k p) (R: class) (T: class i j k p) (c_x E: class) (I: class i j k p) (L N O Y: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq Q (cfv A2 cpl1) $ >
  $ wceq L (cfv Q cbs) $ >
  $ wceq c_x (cfv P cvsca) $ >
  $ wceq E (cfv (cfv P cmgp) cmg) $ >
  $ wceq Y (cfv R cv1) $ >
  $ wceq I (cmpt p L (cmpo i j N N (co P (cmpt k cn0 (co (co (cv i) (cv j) (cfv (cv k) (cfv (cv p) cco1))) (co (cv k) Y E) c_x)) cgsu))) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq T (co N R cpm2mp) $ >
  $ wi (w3a (wcel N cfn) (wcel R crg) (wcel O L)) (wceq (cfv (cfv O I) T) O) $;


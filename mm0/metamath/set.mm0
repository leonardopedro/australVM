theorem _7p1e8:
  $ wceq (co c7 c1 caddc) c8 $;

--| 8 + 1 = 9. (Contributed by Mario Carneiro, 18-Apr-2015.)
theorem _8p1e9:
  $ wceq (co c8 c1 caddc) c9 $;


--| Lemma for ~ dath . Swap the role of planes ` Y ` and ` Z ` to allow reuse of analogous proofs. (Contributed by NM, 14-Aug-2012.)
theorem dalemswapyz (ph: wff) (A2 C P Q R S T U c_or K c_le O Y Z: class):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel S A2) (wcel T A2) (wcel U A2)) (w3a (wcel P A2) (wcel Q A2) (wcel R A2))) (wa (wcel Z O) (wcel Y O)) (w3a (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wbr C (co S P c_or) c_le) (wbr C (co T Q c_or) c_le) (wbr C (co U R c_or) c_le)))) $;

--| Lemma for ~ dath . Rotate triangles ` Y = P Q R ` and ` Z = S T U ` to allow reuse of analogous proofs. (Contributed by NM, 14-Aug-2012.)
theorem dalemrot (ph: wff) (A2 C P Q R S T U c_or K c_le O Y Z: class):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wceq Z (co (co S T c_or) U c_or) $ >
  $ wi ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel Q A2) (wcel R A2) (wcel P A2)) (w3a (wcel T A2) (wcel U A2) (wcel S A2))) (wa (wcel (co (co Q R c_or) P c_or) O) (wcel (co (co T U c_or) S c_or) O)) (w3a (w3a (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le)) (wn (wbr C (co P Q c_or) c_le))) (w3a (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le)) (wn (wbr C (co S T c_or) c_le))) (w3a (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le) (wbr C (co P S c_or) c_le)))) $;

--| Lemma for ~ dath . Rotate triangles ` Y = P Q R ` and ` Z = S T U ` to allow reuse of analogous proofs. (Contributed by NM, 19-Aug-2012.)
theorem dalemrotyz (ph: wff) (A2 C P Q R S T U c_or K c_le O Y Z: class):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wceq Z (co (co S T c_or) U c_or) $ >
  $ wi (wa ph (wceq Y Z)) (wceq (co (co Q R c_or) P c_or) (co (co T U c_or) S c_or)) $;

--| Lemma for ~ dath . Show the lines ` P S ` and ` Q T ` are different. (Contributed by NM, 9-Aug-2012.)
theorem dalem1 (ph: wff) (A2 C P Q R S T U c_or K c_le O Y Z: class):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wi ph (wne (co P S c_or) (co Q T c_or)) $;

--| Lemma for ~ dath . Frequently-used utility lemma. Here we show that ` C ` must be an atom. This is an assumption in most presentations of Desargues's theorem; instead, we assume only the ` C ` is a lattice element, in order to make later substitutions for ` C ` easier. (Contributed by NM, 23-Sep-2012.)
theorem dalemcea (ph: wff) (A2 C P Q R S T U c_or K c_le O Y Z: class):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wi ph (wcel C A2) $;

--| Lemma for ~ dath . Show the lines ` P Q ` and ` S T ` form a plane. (Contributed by NM, 11-Aug-2012.)
theorem dalem2 (ph: wff) (A2 C P Q R S T U c_or K c_le O Y Z: class):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wi ph (wcel (co (co P Q c_or) (co S T c_or) c_or) O) $;

--| Lemma for ~ dath . Frequently-used utility lemma. (Contributed by NM, 11-Aug-2012.)
theorem dalemdea (ph: wff) (A2 C D P Q R S T U c_or K c_le c_an O Y Z: class):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wceq Z (co (co S T c_or) U c_or) $ >
  $ wceq D (co (co P Q c_or) (co S T c_or) c_an) $ >
  $ wi ph (wcel D A2) $;

--| Lemma for ~ dath . Frequently-used utility lemma. (Contributed by NM, 11-Aug-2012.)
theorem dalemeea (ph: wff) (A2 C P Q R S T U E c_or K c_le c_an O Y Z: class):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wceq Z (co (co S T c_or) U c_or) $ >
  $ wceq E (co (co Q R c_or) (co T U c_or) c_an) $ >

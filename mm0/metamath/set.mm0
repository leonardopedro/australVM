  $ wceq c_an (cfv K cmee) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wceq Z (co (co S T c_or) U c_or) $ >
  $ wceq G (co (co (cv c) P c_or) (co (cv d) S c_or) c_an) $ >
  $ wi (w3a ph (wceq Y Z) ps) (wn (wbr G Y c_le)) $;

--| Lemma for ~ dath . Show that the dummy center of perspectivity ` c ` is different from auxiliary atom ` G ` . (Contributed by NM, 3-Aug-2012.)
theorem dalem25 {c d: setvar} (ph ps: wff c d) (A2 C P Q R S T U G c_or K c_le c_an O Y Z: class c d):

  $ wi ph (w3a (wceq (cfv cc0 F) J) (wceq (cfv c1 F) K) (wceq (cfv c2 F) L)) $;

--| Lemma 9 for ~ 3wlkd . (Contributed by AV, 7-Feb-2021.)
theorem _3wlkdlem9 (ph: wff) (A2 B2 C D P F I J K L V: class):
  $ wceq P (cs4 A2 B2 C D) $ >
  $ wceq F (cs3 J K L) $ >
  $ wi ph (wa (wa (wcel A2 V) (wcel B2 V)) (wa (wcel C V) (wcel D V))) $ >

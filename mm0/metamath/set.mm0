  $ wi ph (wbr (co E (cs3 X Y X) c_pl) E c_sm) $;

--| Explicit the value of the angle addition magma for a given geometry ` G ` . (Contributed by Thierry Arnoux, 31-Aug-2026.)
theorem angmgmval {e f2 s1 d: setvar} (A2: class d) (P: class) (c_pl c_sm: class e f2 s1 d) (G: class d) (I J L c_le c_mi V: class e f2 s1 d):
  $ wceq P (cfv G cbs) $ >
  $ wceq A2 (crab d (wa (wne (cfv cc0 (cv d)) (cfv c1 (cv d))) (wne (cfv c1 (cv d)) (cfv c2 (cv d)))) (co P (co cc0 c3 cfzo) cmap)) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq c_sm (cfv G ccgra) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq c_pl (cmpo e f2 A2 A2 (cif (wcel (cfv cc0 (cv e)) (co (cfv c1 (cv e)) (cfv c2 (cv e)) L)) (cs3 (cfv cc0 (cv f2)) (cfv c1 (cv f2)) (crio s1 (wa (wbr (cs3 (cfv c2 (cv f2)) (cfv c1 (cv f2)) (cv s1)) (cv e) c_sm) (wceq (co (cfv c1 (cv f2)) (cv s1) c_mi) (co (cfv c1 (cv e)) (cfv cc0 (cv e)) c_mi))) P)) (cs3 (cfv cc0 (cv e)) (cfv c1 (cv e)) (crio s1 (w3a (wbr (cs3 (cfv c2 (cv e)) (cfv c1 (cv e)) (cv s1)) (cv f2) c_sm) (wceq (co (cfv c1 (cv e)) (cv s1) c_mi) (co (cfv c1 (cv f2)) (cfv cc0 (cv f2)) c_mi)) (wne (cin (co (cfv c1 (cv e)) (cfv c2 (cv e)) L) (co (cv s1) (cfv cc0 (cv e)) I)) c0)) P)))) $ >
  $ wceq J (cfv G cangmgm) $ >
  $ wceq c_le (cfv G cleag) $ >
  $ wi (wcel G V) (wceq J (co (ctp (cop (cfv cnx cbs) A2) (cop (cfv cnx cplusg) c_pl) (cop (cfv cnx cple) c_le)) c_sm cqus)) $;

--| Lemma for ~ angmgm . (Contributed by Thierry Arnoux, 31-Aug-2026.)
theorem angmgmlem {e f2 s1 d: setvar} (ph: wff) (A2 P c_pl c_sm G I: class) (J: class s1 d) (L c_mi X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq A2 (crab d (wa (wne (cfv cc0 (cv d)) (cfv c1 (cv d))) (wne (cfv c1 (cv d)) (cfv c2 (cv d)))) (co P (co cc0 c3 cfzo) cmap)) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq c_sm (cfv G ccgra) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq c_pl (cmpo e f2 A2 A2 (cif (wcel (cfv cc0 (cv e)) (co (cfv c1 (cv e)) (cfv c2 (cv e)) L)) (cs3 (cfv cc0 (cv f2)) (cfv c1 (cv f2)) (crio s1 (wa (wbr (cs3 (cfv c2 (cv f2)) (cfv c1 (cv f2)) (cv s1)) (cv e) c_sm) (wceq (co (cfv c1 (cv f2)) (cv s1) c_mi) (co (cfv c1 (cv e)) (cfv cc0 (cv e)) c_mi))) P)) (cs3 (cfv cc0 (cv e)) (cfv c1 (cv e)) (crio s1 (w3a (wbr (cs3 (cfv c2 (cv e)) (cfv c1 (cv e)) (cv s1)) (cv f2) c_sm) (wceq (co (cfv c1 (cv e)) (cv s1) c_mi) (co (cfv c1 (cv f2)) (cfv cc0 (cv f2)) c_mi)) (wne (cin (co (cfv c1 (cv e)) (cfv c2 (cv e)) L) (co (cv s1) (cfv cc0 (cv e)) I)) c0)) P)))) $ >
  $ wceq J (cfv G cangmgm) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y (cdif P (csn X))) $ >
  $ wi ph (wa (wcel J cmgm) (wceq (cec (cs3 X Y X) c_sm) (cfv J c0g))) $;

--| The identity element of the angle addition magma. (Contributed by Thierry Arnoux, 31-Aug-2026.)
theorem angmgm0g {e f2 s1 d: setvar} (ph: wff) (A2 P c_pl c_sm G I: class) (J: class s1 d) (L c_mi X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq A2 (crab d (wa (wne (cfv cc0 (cv d)) (cfv c1 (cv d))) (wne (cfv c1 (cv d)) (cfv c2 (cv d)))) (co P (co cc0 c3 cfzo) cmap)) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq c_sm (cfv G ccgra) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq c_pl (cmpo e f2 A2 A2 (cif (wcel (cfv cc0 (cv e)) (co (cfv c1 (cv e)) (cfv c2 (cv e)) L)) (cs3 (cfv cc0 (cv f2)) (cfv c1 (cv f2)) (crio s1 (wa (wbr (cs3 (cfv c2 (cv f2)) (cfv c1 (cv f2)) (cv s1)) (cv e) c_sm) (wceq (co (cfv c1 (cv f2)) (cv s1) c_mi) (co (cfv c1 (cv e)) (cfv cc0 (cv e)) c_mi))) P)) (cs3 (cfv cc0 (cv e)) (cfv c1 (cv e)) (crio s1 (w3a (wbr (cs3 (cfv c2 (cv e)) (cfv c1 (cv e)) (cv s1)) (cv f2) c_sm) (wceq (co (cfv c1 (cv e)) (cv s1) c_mi) (co (cfv c1 (cv f2)) (cfv cc0 (cv f2)) c_mi)) (wne (cin (co (cfv c1 (cv e)) (cfv c2 (cv e)) L) (co (cv s1) (cfv cc0 (cv e)) I)) c0)) P)))) $ >
  $ wceq J (cfv G cangmgm) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y (cdif P (csn X))) $ >
  $ wi ph (wceq (cec (cs3 X Y X) c_sm) (cfv J c0g)) $;

--| The angle addition magma is a magma. (Contributed by Thierry Arnoux, 31-Aug-2026.)
theorem angmgm {e f2 s1 d: setvar} (ph: wff) (A2 P c_pl c_sm G I: class) (J: class s1 d) (L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq A2 (crab d (wa (wne (cfv cc0 (cv d)) (cfv c1 (cv d))) (wne (cfv c1 (cv d)) (cfv c2 (cv d)))) (co P (co cc0 c3 cfzo) cmap)) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq c_sm (cfv G ccgra) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq c_pl (cmpo e f2 A2 A2 (cif (wcel (cfv cc0 (cv e)) (co (cfv c1 (cv e)) (cfv c2 (cv e)) L)) (cs3 (cfv cc0 (cv f2)) (cfv c1 (cv f2)) (crio s1 (wa (wbr (cs3 (cfv c2 (cv f2)) (cfv c1 (cv f2)) (cv s1)) (cv e) c_sm) (wceq (co (cfv c1 (cv f2)) (cv s1) c_mi) (co (cfv c1 (cv e)) (cfv cc0 (cv e)) c_mi))) P)) (cs3 (cfv cc0 (cv e)) (cfv c1 (cv e)) (crio s1 (w3a (wbr (cs3 (cfv c2 (cv e)) (cfv c1 (cv e)) (cv s1)) (cv f2) c_sm) (wceq (co (cfv c1 (cv e)) (cv s1) c_mi) (co (cfv c1 (cv f2)) (cfv cc0 (cv f2)) c_mi)) (wne (cin (co (cfv c1 (cv e)) (cfv c2 (cv e)) L) (co (cv s1) (cfv cc0 (cv e)) I)) c0)) P)))) $ >
  $ wceq J (cfv G cangmgm) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr c2 (cfv P chash) cle) $ >
  $ wi ph (wcel J cmgm) $;

--| The base set of the angle addition magma. (Contributed by Thierry Arnoux, 31-Aug-2026.)
theorem angmgmbas {d: setvar} (ph: wff d) (A2: class d) (P: class) (c_sm G J: class d):
  $ wceq P (cfv G cbs) $ >
  $ wceq A2 (crab d (wa (wne (cfv cc0 (cv d)) (cfv c1 (cv d))) (wne (cfv c1 (cv d)) (cfv c2 (cv d)))) (co P (co cc0 c3 cfzo) cmap)) $ >
  $ wceq c_sm (cfv G ccgra) $ >
  $ wceq J (cfv G cangmgm) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wceq (cqs A2 c_sm) (cfv J cbs)) $;

--| First congruence theorem: SAS (Side-Angle-Side): If two pairs of sides of two triangles are equal in length, and the included angles are equal in measurement, then third sides are equal in length. Theorem 11.49 of [Schwabhauser] p. 107. (Contributed by Thierry Arnoux, 1-Aug-2020.)
theorem tgsas1 (ph: wff) (A2 B2 C D P E F G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co D E c_mi)) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) $ >
  $ wi ph (wceq (co B2 C c_mi) (co E F c_mi)) $ >
  $ wi ph (wceq (co C A2 c_mi) (co F D c_mi)) $;

--| First congruence theorem: SAS (Side-Angle-Side): If two pairs of sides of two triangles are equal in length, and the included angles are equal in measurement, then the triangles are congruent. Theorem 11.49 of [Schwabhauser] p. 107. (Contributed by Thierry Arnoux, 1-Aug-2020.)
theorem tgsas (ph: wff) (A2 B2 C D P E F G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co D E c_mi)) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) $ >
  $ wi ph (wceq (co B2 C c_mi) (co E F c_mi)) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgrg)) $;

--| First congruence theorem: SAS. Theorem 11.49 of [Schwabhauser] p. 107. (Contributed by Thierry Arnoux, 1-Aug-2020.)
theorem tgsas2 (ph: wff) (A2 B2 C D P E F G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co D E c_mi)) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) $ >
  $ wi ph (wceq (co B2 C c_mi) (co E F c_mi)) $ >
  $ wi ph (wne A2 C) $ >
  $ wi ph (wbr (cs3 C A2 B2) (cs3 F D E) (cfv G ccgra)) $;

--| First congruence theorem: SAS. Theorem 11.49 of [Schwabhauser] p. 107. (Contributed by Thierry Arnoux, 1-Aug-2020.)
theorem tgsas3 (ph: wff) (A2 B2 C D P E F G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co D E c_mi)) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) $ >
  $ wi ph (wceq (co B2 C c_mi) (co E F c_mi)) $ >
  $ wi ph (wne A2 C) $ >
  $ wi ph (wbr (cs3 B2 C A2) (cs3 E F D) (cfv G ccgra)) $;

--| Second congruence theorem: ASA. (Angle-Side-Angle): If two pairs of angles of two triangles are equal in measurement, and the included sides are equal in length, then the triangles are congruent. Theorem 11.50 of [Schwabhauser] p. 108. (Contributed by Thierry Arnoux, 15-Aug-2020.)
theorem tgasa1 (ph: wff) (A2 B2 C D P E F G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wn (wo (wcel C (co A2 B2 L)) (wceq A2 B2))) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co D E c_mi)) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) $ >
  $ wi ph (wbr (cs3 C A2 B2) (cs3 F D E) (cfv G ccgra)) $ >
  $ wi ph (wceq (co B2 C c_mi) (co E F c_mi)) $;

--| Second congruence theorem: ASA. (Angle-Side-Angle): If two pairs of angles of two triangles are equal in measurement, and the included sides are equal in length, then the triangles are congruent. Theorem 11.50 of [Schwabhauser] p. 108. (Contributed by Thierry Arnoux, 15-Aug-2020.)
theorem tgasa (ph: wff) (A2 B2 C D P E F G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wn (wo (wcel C (co A2 B2 L)) (wceq A2 B2))) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co D E c_mi)) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) $ >
  $ wi ph (wbr (cs3 C A2 B2) (cs3 F D E) (cfv G ccgra)) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgrg)) $;

--| Third congruence theorem: SSS (Side-Side-Side): If the three pairs of sides of two triangles are equal in length, then the triangles are congruent. Theorem 11.51 of [Schwabhauser] p. 109. (Contributed by Thierry Arnoux, 1-Aug-2020.)
theorem tgsss1 (ph: wff) (A2 B2 C D P E F G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co D E c_mi)) $ >
  $ wi ph (wceq (co B2 C c_mi) (co E F c_mi)) $ >
  $ wi ph (wceq (co C A2 c_mi) (co F D c_mi)) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wne B2 C) $ >
  $ wi ph (wne C A2) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) $;

--| Third congruence theorem: SSS. Theorem 11.51 of [Schwabhauser] p. 109. (Contributed by Thierry Arnoux, 1-Aug-2020.)
theorem tgsss2 (ph: wff) (A2 B2 C D P E F G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co D E c_mi)) $ >
  $ wi ph (wceq (co B2 C c_mi) (co E F c_mi)) $ >
  $ wi ph (wceq (co C A2 c_mi) (co F D c_mi)) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wne B2 C) $ >
  $ wi ph (wne C A2) $ >
  $ wi ph (wbr (cs3 C A2 B2) (cs3 F D E) (cfv G ccgra)) $;

--| Third congruence theorem: SSS. Theorem 11.51 of [Schwabhauser] p. 109. (Contributed by Thierry Arnoux, 1-Aug-2020.)
theorem tgsss3 (ph: wff) (A2 B2 C D P E F G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co D E c_mi)) $ >
  $ wi ph (wceq (co B2 C c_mi) (co E F c_mi)) $ >
  $ wi ph (wceq (co C A2 c_mi) (co F D c_mi)) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wne B2 C) $ >
  $ wi ph (wne C A2) $ >
  $ wi ph (wbr (cs3 B2 C A2) (cs3 E F D) (cfv G ccgra)) $;

--| Congruence for two triangles can also be defined as congruence of sides and angles (6 parts). This is often the actual textbook definition of triangle congruence, see for example ~ https://en.wikipedia.org/wiki/Congruence_(geometry)#Congruence_of_triangles . With this definition, the "SSS" congruence theorem has an additional part, namely, that triangle congruence implies congruence of the sides (which means equality of the lengths). Because our development of elementary geometry strives to closely follow Schwabhaeuser's, our original definition of shape congruence, ~ df-cgrg , already covers that part: see ~ trgcgr . This theorem is also named "CPCTC", which stands for "Corresponding Parts of Congruent Triangles are Congruent", see ~ https://en.wikipedia.org/wiki/Congruence_(geometry)#CPCTC . (Contributed by Thierry Arnoux, 18-Jan-2023.)
theorem dfcgrg2 (ph: wff) (A2 B2 C D P E F G c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wne B2 C) $ >
  $ wi ph (wne C A2) $ >
  $ wi ph (wb (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgrg)) (wa (w3a (wceq (co A2 B2 c_mi) (co D E c_mi)) (wceq (co B2 C c_mi) (co E F c_mi)) (wceq (co C A2 c_mi) (co F D c_mi))) (w3a (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) (wbr (cs3 C A2 B2) (cs3 F D E) (cfv G ccgra)) (wbr (cs3 B2 C A2) (cs3 E F D) (cfv G ccgra))))) $;

--| Congruence theorem for isocele triangles: if two angles of a triangle are congruent, then the corresponding sides also are. (Contributed by Thierry Arnoux, 5-Oct-2020.)
theorem isoas (ph: wff) (A2 B2 C P G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wn (wo (wcel C (co A2 B2 L)) (wceq A2 B2))) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 A2 C B2) (cfv G ccgra)) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co A2 C c_mi)) $;

--| Declare the class of equilateral triangles.
term ceqlg: class;

--| Define the class of equilateral triangles. (Contributed by Thierry Arnoux, 27-Nov-2019.)
axiom df_eqlg {x3 g2: setvar}:
  $ wceq ceqlg (cmpt g2 cvv (crab x3 (wbr (cv x3) (cs3 (cfv c1 (cv x3)) (cfv c2 (cv x3)) (cfv cc0 (cv x3))) (cfv (cv g2) ccgrg)) (co (cfv (cv g2) cbs) (co cc0 c3 cfzo) cmap))) $;

--| Property of a triangle being equilateral. (Contributed by Thierry Arnoux, 5-Oct-2020.)
theorem iseqlg (ph: wff) (A2 B2 C P G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wb (wcel (cs3 A2 B2 C) (cfv G ceqlg)) (wbr (cs3 A2 B2 C) (cs3 B2 C A2) (cfv G ccgrg))) $;

--| Condition for a triangle to be equilateral. (Contributed by Thierry Arnoux, 5-Oct-2020.)
theorem iseqlgd (ph: wff) (A2 B2 C P G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co B2 C c_mi)) $ >
  $ wi ph (wceq (co B2 C c_mi) (co C A2 c_mi)) $ >
  $ wi ph (wceq (co C A2 c_mi) (co A2 B2 c_mi)) $ >
  $ wi ph (wcel (cs3 A2 B2 C) (cfv G ceqlg)) $;

--| Extend class notation for the parallel lines relation.
term cprlng: class;

--| Define the parallel relation for lines. Definition 12.2 of [Schwabhauser] p. 121. Note that the textbook first defines a "strict" parallelism where equal lines are not considered parallel in the strict sense: here we jump directly to the more common definition which allows equality. (Contributed by Thierry Arnoux, 17-Jun-2026.)
axiom df_prlng {g2 h a b: setvar}:
  $ wceq cprlng (cmpt g2 cvv (copab a b (wa (wa (wcel (cv a) (crn (cfv (cv g2) clng))) (wcel (cv b) (crn (cfv (cv g2) clng)))) (wo (wceq (cv a) (cv b)) (wa (wrex h (wa (wss (cv a) (cv h)) (wss (cv b) (cv h))) (crn (cfv (cv g2) cplng))) (wceq (cin (cv a) (cv b)) c0)))))) $;

--| Property of two lines ` A ` and ` B ` to be parallel. (Contributed by Thierry Arnoux, 18-Jun-2026.)
theorem brprlng {h: setvar} (ph: wff h) (A2 B2: class) (c_pa: class h) (E G: class) (L V: class h):
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wceq c_pa (cfv G cprlng) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wb (wbr A2 B2 c_pa) (wa (wa (wcel A2 (crn L)) (wcel B2 (crn L))) (wo (wceq A2 B2) (wa (wrex h (wa (wss A2 (cv h)) (wss B2 (cv h))) (crn E)) (wceq (cin A2 B2) c0))))) $;

--| Deduce parallelism between two lines ` A ` and ` B ` . (Contributed by Thierry Arnoux, 18-Jun-2026.)
theorem prlngd (ph: wff) (A2 B2 c_pa E G H L V: class):
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wceq c_pa (cfv G cprlng) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel B2 (crn L)) $ >
  $ wi ph (wcel H (crn E)) $ >
  $ wi ph (wss A2 H) $ >
  $ wi ph (wss B2 H) $ >
  $ wi ph (wceq (cin A2 B2) c0) $ >
  $ wi ph (wbr A2 B2 c_pa) $;

--| Parallelism is reflexive. Theorem 12.4 of [Schwabhauser] p. 122. (Contributed by Thierry Arnoux, 18-Jun-2026.)
theorem prlngref (ph: wff) (A2 c_pa E G L V: class):
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wceq c_pa (cfv G cprlng) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wbr A2 A2 c_pa) $;

--| Parallelism is symmetric. Theorem 12.5 of [Schwabhauser] p. 122. (Contributed by Thierry Arnoux, 18-Jun-2026.)
theorem prlngsym (ph: wff) (A2 B2 c_pa E G L V: class):
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wceq c_pa (cfv G cprlng) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wbr A2 B2 c_pa) $ >
  $ wi ph (wbr B2 A2 c_pa) $;

--| Reverse closure for parallelism. (Contributed by Thierry Arnoux, 5-Jul-2026.)
theorem prlngrcl1 (ph: wff) (A2 B2 c_pa G L V: class):
  $ wceq L (cfv G clng) $ >
  $ wceq c_pa (cfv G cprlng) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wbr A2 B2 c_pa) $ >
  $ wi ph (wcel A2 (crn L)) $;

--| Reverse closure for parallelism. (Contributed by Thierry Arnoux, 5-Jul-2026.)
theorem prlngrcl2 (ph: wff) (A2 B2 c_pa G L V: class):
  $ wceq L (cfv G clng) $ >
  $ wceq c_pa (cfv G cprlng) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wbr A2 B2 c_pa) $ >
  $ wi ph (wcel B2 (crn L)) $;

--| Two parallel lines do not intersect. (Contributed by Thierry Arnoux, 5-Jul-2026.)
theorem prlngin0 (ph: wff) (A2 B2 c_pa G L V: class):
  $ wceq L (cfv G clng) $ >
  $ wceq c_pa (cfv G cprlng) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wbr A2 B2 c_pa) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wceq (cin A2 B2) c0) $;

--| Two parallel lines are on a common plane. (Contributed by Thierry Arnoux, 5-Jul-2026.)
theorem prlngpln {h: setvar} (ph: wff h) (A2 B2: class) (c_pa: class h) (E G: class) (L V: class h):
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wceq c_pa (cfv G cprlng) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wbr A2 B2 c_pa) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wrex h (wa (wss A2 (cv h)) (wss B2 (cv h))) (crn E)) $;

--| If two lines ` A ` and ` B ` are parallel, then any two points ` X ` and ` Y ` of ` B ` lie on the same half-plane limited by ` A ` . Theorem 12.6 of [Schwabhauser] p. 122. . (Contributed by Thierry Arnoux, 5-Jul-2026.)
theorem prlnghpg (ph: wff) (A2 B2 c_pa E G L X Y: class):
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wceq c_pa (cfv G cprlng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr A2 B2 c_pa) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wbr X Y (cfv A2 (cfv G chpg))) $;

--| Alternate definition of (strict) parallelism. Theorem 12.7 of [Schwabhauser] p. 122. (Contributed by Thierry Arnoux, 13-Jul-2026.)
theorem dfprlng2 (ph: wff) (c_pa P G L W X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq c_pa (cfv G cprlng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y (cdif P (csn X))) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel W (cdif P (csn Z))) $ >
  $ wi ph (wne (co X Y L) (co Z W L)) $ >
  $ wi ph (wb (wbr (co X Y L) (co Z W L) c_pa) (wa (wbr Z W (cfv (co X Y L) (cfv G chpg))) (wceq (cin (co X Y L) (co Z W L)) c0))) $;

--| Alternate definition of (strict) parallelism. Theorem 12.7 of [Schwabhauser] p. 122. (Contributed by Thierry Arnoux, 13-Jul-2026.)
theorem dfprlng3 (ph: wff) (A2 c_pa P G L X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq c_pa (cfv G cprlng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y (cdif P (csn X))) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wne A2 (co X Y L)) $ >
  $ wi ph (wb (wbr A2 (co X Y L) c_pa) (wa (wbr X Y (cfv A2 (cfv G chpg))) (wceq (cin A2 (co X Y L)) c0))) $;

--| Two parallel lines are on a common plane. (Contributed by Thierry Arnoux, 5-Jul-2026.)
theorem prlngpln3 (ph: wff) (A2 B2 c_pa E G L X: class):
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wceq c_pa (cfv G cprlng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr A2 B2 c_pa) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wss B2 (co A2 X E)) $;

--| If two lines ` A ` and ` B ` have a common perpendicular ` C ` and lie in the same plane ` H ` , then they are parallel. Theorem 12.9 of [Schwabhauser] p. 122. (Contributed by Thierry Arnoux, 5-Jul-2026.)
theorem perpprlng (ph: wff) (A2 B2 C c_pa P E G H L: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wceq c_pa (cfv G cprlng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel H (crn E)) $ >
  $ wi ph (wss A2 H) $ >
  $ wi ph (wss B2 H) $ >
  $ wi ph (wss C H) $ >
  $ wi ph (wbr A2 C (cfv G cperpg)) $ >
  $ wi ph (wbr B2 C (cfv G cperpg)) $ >
  $ wi ph (wbr A2 B2 c_pa) $;

--| There exists at least one parallel line ` b ` to a given line ` A ` through a given point ` X ` . Theorem 12.10 of [Schwabhauser] p. 122. (Contributed by Thierry Arnoux, 5-Jul-2026.)
theorem prlngex {b: setvar} (ph: wff) (A2 c_pa: class) (P G: class b) (L X: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq c_pa (cfv G cprlng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wrex b (wa (wbr A2 (cv b) c_pa) (wcel X (cv b))) (crn L)) $;

--| Lemma for ~ prlngmo : Contradiction: Assuming two different parallels ` B ` and ` C ` having a common point ` X ` exist to a line ` A ` , the geometry cannot be Euclidean (Contributed by Thierry Arnoux, 5-Jul-2026.)
theorem prlngmolem1 {y1 w a b: setvar} (ph: wff a) (A2 B2: class y1) (C: class y1 w a b) (c_pa: class y1 w a) (P: class) (Q: class y1) (T: class a b) (G I: class) (L: class y1) (O: class y1 w a b) (W: class a b) (X: class y1 a):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq c_pa (cfv G cprlng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel X (cdif P A2)) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P B2)) (wcel (cv b) (cdif P B2))) (wrex y1 (wcel (cv y1) (co (cv a) (cv b) I)) B2))) $ >
  $ wceq Q (copab a b (wa (wa (wcel (cv a) (cdif P A2)) (wcel (cv b) (cdif P A2))) (wrex w (wcel (cv w) (co (cv a) (cv b) I)) A2))) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel B2 (crn L)) $ >
  $ wi ph (wcel C (crn L)) $ >
  $ wi ph (wbr A2 B2 c_pa) $ >
  $ wi ph (wbr A2 C c_pa) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel X C) $ >
  $ wi ph (wcel T A2) $ >
  $ wi ph (wcel W (cdif C B2)) $ >
  $ wi ph (wne B2 C) $ >
  $ wi ph (wbr W T O) $ >
  $ wi ph (wn (wcel G cstrkge)) $;

--| Lemma for ~ prlngmo . (Contributed by Thierry Arnoux, 5-Jul-2026.)
theorem prlngmolem2 {x3 y1 s1 r b: setvar} (ph: wff x3) (A2: class) (c_pa: class x3) (P: class b) (Q: class r b) (G: class b) (L: class) (O: class b) (X: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq c_pa (cfv G cprlng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel X (cdif P A2)) $ >
  $ wi ph (wcel G cstrkge) $ >
  $ wceq O (copab x3 y1 (wa (wa (wcel (cv x3) (cdif P (cv b))) (wcel (cv y1) (cdif P (cv b)))) (wrex r (wcel (cv r) (co (cv x3) (cv y1) (cfv G citv))) (cv b)))) $ >
  $ wceq Q (copab x3 y1 (wa (wa (wcel (cv x3) (cdif P A2)) (wcel (cv y1) (cdif P A2))) (wrex s1 (wcel (cv s1) (co (cv x3) (cv y1) (cfv G citv))) A2))) $ >
  $ wi ph (wrmo b (wa (wbr A2 (cv b) c_pa) (wcel X (cv b))) (crn L)) $;

--| Playfair's axiom. Given a line ` A ` and a point ` X ` not on ` A ` , at most one line parallel to ` A ` can be drawn through ` X ` . Theorem 12.11 of [Schwabhauser] p. 123. Note that this is the first instance of a theorem where the geometry is required to be Euclidean, as expressed by ` G e. TarskiGE ` . Theorem A10 of [Schwabhauser] p. 24 is used, in the form of ~ axtgeucl , in the proof of ~ prlngmolem1 . See ~ prlngex for the corresponding existence theorem. (Contributed by Thierry Arnoux, 5-Jul-2026.)
theorem prlngmo {b: setvar} (ph: wff) (A2 c_pa: class) (P G: class b) (L X: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq c_pa (cfv G cprlng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel X (cdif P A2)) $ >
  $ wi ph (wcel G cstrkge) $ >
  $ wi ph (wrmo b (wa (wbr A2 (cv b) c_pa) (wcel X (cv b))) (crn L)) $;

--| Given a line ` A ` and a point ` X ` not on ` A ` , a unique line parallel to ` A ` can be drawn through ` X ` . Theorem 12.13 of [Schwabhauser] p. 124. (Contributed by Thierry Arnoux, 5-Jul-2026.)
theorem prlngeu {b: setvar} (ph: wff) (A2 c_pa: class) (P G: class b) (L X: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq c_pa (cfv G cprlng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel X (cdif P A2)) $ >
  $ wi ph (wcel G cstrkge) $ >
  $ wi ph (wreu b (wa (wbr A2 (cv b) c_pa) (wcel X (cv b))) (crn L)) $;

--| Playfair's axiom, without the restriction that the point ` X ` is outside of the line ` A ` . Theorem 12.11 of [Schwabhauser] p. 123. (Contributed by Thierry Arnoux, 13-Jul-2026.)
theorem prlngmo2 {b: setvar} (ph: wff) (A2 c_pa: class) (P G: class b) (L X: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq c_pa (cfv G cprlng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel G cstrkge) $ >
  $ wi ph (wrmo b (wa (wbr A2 (cv b) c_pa) (wcel X (cv b))) (crn L)) $;

--| Playfair's axiom, written as an equality: if two different lines are parallel to a given line at a given point, they are equal. (Contributed by Thierry Arnoux, 20-Jul-2026.)
theorem prlngeq (ph: wff) (A2 B2 C c_pa P G X: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_pa (cfv G cprlng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel G cstrkge) $ >
  $ wi ph (wbr A2 B2 c_pa) $ >
  $ wi ph (wbr A2 C c_pa) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel X C) $ >
  $ wi ph (wceq B2 C) $;

--| Building a parallel line conserves planes, i.e. given a line ` A ` and a point ` X ` not on ` A ` , the (unique) parallel ` B ` to ` A ` through ` X ` lies completely within the plane defined by ` A ` and ` X ` . Theorem 12.14 of [Schwabhauser] p. 124. (Contributed by Thierry Arnoux, 13-Jul-2026.)
theorem prlngpln4 (ph: wff) (A2 B2 c_pa E G H X: class):
  $ wceq E (cfv G cplng) $ >
  $ wceq c_pa (cfv G cprlng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel H (crn E)) $ >
  $ wi ph (wss A2 H) $ >
  $ wi ph (wbr A2 B2 c_pa) $ >
  $ wi ph (wcel X H) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wss B2 H) $;

--| Transitivity of parallelism, for lines in the same plane ` H ` . This is case 1 of Theorem 12.15 of [Schwabhauser] p. 124. (Contributed by Thierry Arnoux, 13-Jul-2026.)
theorem prlngplngtr (ph: wff) (A2 B2 C c_pa E G H: class):
  $ wceq E (cfv G cplng) $ >
  $ wceq c_pa (cfv G cprlng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel H (crn E)) $ >
  $ wi ph (wss A2 H) $ >
  $ wi ph (wbr A2 B2 c_pa) $ >
  $ wi ph (wcel G cstrkge) $ >
  $ wi ph (wss C H) $ >
  $ wi ph (wbr B2 C c_pa) $ >
  $ wi ph (wbr A2 C c_pa) $;

--| A line ` C ` intersecting another line ` A ` also intersects any line ` B ` parallel to ` A ` . Theorem 12.16 of [Schwabhauser] p. 125. (Contributed by Thierry Arnoux, 13-Jul-2026.)
theorem prlnginn0 (ph: wff) (A2 B2 C c_pa E G H L: class):
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wceq c_pa (cfv G cprlng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel G cstrkge) $ >
  $ wi ph (wcel H (crn E)) $ >
  $ wi ph (wcel C (crn L)) $ >
  $ wi ph (wne (cin A2 C) c0) $ >
  $ wi ph (wne A2 C) $ >
  $ wi ph (wbr A2 B2 c_pa) $ >
  $ wi ph (wss A2 H) $ >
  $ wi ph (wss B2 H) $ >
  $ wi ph (wss C H) $ >
  $ wi ph (wne (cin B2 C) c0) $;

--| If the midpoints of two segments ` ( X I Z ) ` and ` ( Y I W ) ` coincide, the points ` X ` , ` Y ` , ` Z ` and ` W ` form a parallelogram, i.e. the lines ` ( X L Y ) ` and ` ( Z L W ) ` are parallel. Theorem 12.17 of [Schwabhauser] p. 125. (Contributed by Thierry Arnoux, 13-Jul-2026.)
theorem prlngmid2 (ph: wff) (c_pa P E G L M W X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wceq c_pa (cfv G cprlng) $ >
  $ wceq M (cfv G cmid) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel G cstrkge) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z (cdif P (co X Y L))) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wceq (co X Z M) (co Y W M)) $ >
  $ wi ph (wne X Y) $ >
  $ wi ph (wbr (co X Y L) (co Z W L) c_pa) $;

--| Symmetrical quadrilaterals are parallelograms. Theorem 12.18 of [Schwabhauser] p. 126. (Contributed by Thierry Arnoux, 20-Jul-2026.)
theorem symquadprlng (ph: wff) (c_pa P T G L c_mi W X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq c_pa (cfv G cprlng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel G cstrkge) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wceq (co X Y c_mi) (co Z W c_mi)) $ >
  $ wi ph (wceq (co Y Z c_mi) (co W X c_mi)) $ >
  $ wi ph (wn (wo (wcel X (co Y Z L)) (wceq Y Z))) $ >
  $ wi ph (wne Y W) $ >
  $ wi ph (wcel T (co X Z L)) $ >
  $ wi ph (wcel T (co Y W L)) $ >
  $ wi ph (wa (wbr (co X Y L) (co Z W L) c_pa) (wbr (co Y Z L) (co W X L) c_pa)) $;

--| Lemma for ~ prlngsymquad . (Contributed by Thierry Arnoux, 20-Jul-2026.)
theorem prlngsymquadlem (ph: wff) (c_pa P T G L c_mi W X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq c_pa (cfv G cprlng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel G cstrkge) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wn (wo (wcel X (co Y Z L)) (wceq Y Z))) $ >
  $ wi ph (wbr (co X Y L) (co Z W L) c_pa) $ >
  $ wi ph (wbr (co Y Z L) (co W X L) c_pa) $ >
  $ wceq T (cfv Y (cfv (co X Z (cfv G cmid)) (cfv G cmir))) $ >
  $ wi ph (wceq T W) $;

--| All parallelograms are symmetric quadrilaterals. First part of Theorem 12.19 of [Schwabhauser] p. 126. (Contributed by Thierry Arnoux, 20-Jul-2026.)
theorem prlngsymquad (ph: wff) (c_pa P G L c_mi W X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq c_pa (cfv G cprlng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel G cstrkge) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wn (wo (wcel X (co Y Z L)) (wceq Y Z))) $ >
  $ wi ph (wbr (co X Y L) (co Z W L) c_pa) $ >
  $ wi ph (wbr (co Y Z L) (co W X L) c_pa) $ >
  $ wi ph (wa (wceq (co X Y c_mi) (co Z W c_mi)) (wceq (co Y Z c_mi) (co W X c_mi))) $;

--| In parallelograms, opposing vertices are on opposite sides of the diagonal. Second part of Theorem 12.19 of [Schwabhauser] p. 126. (Contributed by Thierry Arnoux, 20-Jul-2026.)
theorem prlngsymquadopp {t a b: setvar} (ph: wff a b) (c_pa: class t a b) (P: class t) (G: class a b) (I L: class) (c_mi O: class t a b) (W: class a b) (X: class) (Y: class a b) (Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq c_pa (cfv G cprlng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel G cstrkge) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wn (wo (wcel X (co Y Z L)) (wceq Y Z))) $ >
  $ wi ph (wbr (co X Y L) (co Z W L) c_pa) $ >
  $ wi ph (wbr (co Y Z L) (co W X L) c_pa) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P (co X Z L))) (wcel (cv b) (cdif P (co X Z L)))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) (co X Z L)))) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wbr W Y O) $;

--| Nontrivial quadrilaterals with congruent and parallel opposite sides are parallelograms. Theorem 12.20 of [Schwabhauser] p. 126. (Contributed by Thierry Arnoux, 20-Jul-2026.)
theorem quadcgrprlng {t a b: setvar} (ph: wff b) (c_pa: class b) (P G I L: class) (c_mi: class b) (O: class) (W: class b) (X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq c_pa (cfv G cprlng) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P (co X Z L))) (wcel (cv b) (cdif P (co X Z L)))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) (co X Z L)))) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel G cstrkge) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wn (wo (wcel X (co Y Z L)) (wceq Y Z))) $ >
  $ wi ph (wbr (co X Y L) (co Z W L) c_pa) $ >
  $ wi ph (wceq (co X Y c_mi) (co Z W c_mi)) $ >
  $ wi ph (wbr Y W O) $ >
  $ wi ph (wa (wbr (co Y Z L) (co W X L) c_pa) (wceq (co Y Z c_mi) (co W X c_mi))) $;

--| Parallelism implies alternate angles congruence: if a line ` ( X L Z ) ` crosses two parallel lines ` ( X L Y ) ` and ` ( Z L W ) ` , then the alternate angles are congruent. First direction of Theorem 12.21 of [Schwabhauser] p. 126. This is also Proposition 1.29 of Euclid's _Elements_ . (Contributed by Thierry Arnoux, 20-Jul-2026.)
theorem tgaltai {t a b: setvar} (ph: wff b) (c_pa: class t b) (P G I L O: class) (W: class b) (X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq c_pa (cfv G cprlng) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P (co X Z L))) (wcel (cv b) (cdif P (co X Z L)))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) (co X Z L)))) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel G cstrkge) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wbr (co X Y L) (co Z W L) c_pa) $ >
  $ wi ph (wbr Y W O) $ >
  $ wi ph (wne X Z) $ >
  $ wi ph (wbr (cs3 Y X Z) (cs3 W Z X) (cfv G ccgra)) $;

--| Convenient lemma for ~ f1otrg . (Contributed by Thierry Arnoux, 19-Mar-2019.)
theorem f1otrgds {e f2 g2: setvar} (ph: wff) (B2: class) (D: class g2) (P: class e f2 g2) (E: class g2) (F: class) (G H: class e f2 g2) (I J X: class) (Y: class e):
  $ wceq P (cfv G cbs) $ >
  $ wceq D (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq B2 (cfv H cbs) $ >
  $ wceq E (cfv H cds) $ >
  $ wceq J (cfv H citv) $ >
  $ wi ph (wf1o B2 P F) $ >
  $ wi (wa ph (wa (wcel (cv e) B2) (wcel (cv f2) B2))) (wceq (co (cv e) (cv f2) E) (co (cfv (cv e) F) (cfv (cv f2) F) D)) $ >
  $ wi (wa ph (w3a (wcel (cv e) B2) (wcel (cv f2) B2) (wcel (cv g2) B2))) (wb (wcel (cv g2) (co (cv e) (cv f2) J)) (wcel (cfv (cv g2) F) (co (cfv (cv e) F) (cfv (cv f2) F) I))) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (co X Y E) (co (cfv X F) (cfv Y F) D)) $;

--| Convenient lemma for ~ f1otrg . (Contributed by Thierry Arnoux, 19-Mar-2019.)
theorem f1otrgitv {e f2 g2: setvar} (ph: wff) (B2: class) (D: class g2) (P: class e f2 g2) (E: class g2) (F: class) (G H: class e f2 g2) (I J X: class) (Y: class e) (Z: class e f2):
  $ wceq P (cfv G cbs) $ >
  $ wceq D (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq B2 (cfv H cbs) $ >
  $ wceq E (cfv H cds) $ >
  $ wceq J (cfv H citv) $ >
  $ wi ph (wf1o B2 P F) $ >
  $ wi (wa ph (wa (wcel (cv e) B2) (wcel (cv f2) B2))) (wceq (co (cv e) (cv f2) E) (co (cfv (cv e) F) (cfv (cv f2) F) D)) $ >
  $ wi (wa ph (w3a (wcel (cv e) B2) (wcel (cv f2) B2) (wcel (cv g2) B2))) (wb (wcel (cv g2) (co (cv e) (cv f2) J)) (wcel (cfv (cv g2) F) (co (cfv (cv e) F) (cfv (cv f2) F) I))) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wb (wcel Z (co X Y J)) (wcel (cfv Z F) (co (cfv X F) (cfv Y F) I))) $;

--| A bijection between bases which conserves distances and intervals conserves also geometries. (Contributed by Thierry Arnoux, 23-Mar-2019.)
theorem f1otrg {x3 y1 z e f2 g2: setvar} (ph: wff) (B2: class) (D: class x3 y1 z) (P E F: class) (G: class x3 y1 z e f2 g2) (H: class x3 y1 z e g2) (I: class z) (J: class) (V: class x3 y1 z e f2 g2):
  $ wceq P (cfv G cbs) $ >
  $ wceq D (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq B2 (cfv H cbs) $ >
  $ wceq E (cfv H cds) $ >
  $ wceq J (cfv H citv) $ >
  $ wi ph (wf1o B2 P F) $ >
  $ wi (wa ph (wa (wcel (cv e) B2) (wcel (cv f2) B2))) (wceq (co (cv e) (cv f2) E) (co (cfv (cv e) F) (cfv (cv f2) F) D)) $ >
  $ wi (wa ph (w3a (wcel (cv e) B2) (wcel (cv f2) B2) (wcel (cv g2) B2))) (wb (wcel (cv g2) (co (cv e) (cv f2) J)) (wcel (cfv (cv g2) F) (co (cfv (cv e) F) (cfv (cv f2) F) I))) $ >
  $ wi ph (wcel H V) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wceq (cfv H clng) (cmpo x3 y1 B2 (cdif B2 (csn (cv x3))) (crab z (w3o (wcel (cv z) (co (cv x3) (cv y1) J)) (wcel (cv x3) (co (cv z) (cv y1) J)) (wcel (cv y1) (co (cv x3) (cv z) J))) B2))) $ >
  $ wi ph (wcel H cstrkg) $;

--| A bijection between bases which conserves distances and intervals conserves also the property of being a Euclidean geometry. (Contributed by Thierry Arnoux, 23-Mar-2019.)
theorem f1otrge {e f2 g2: setvar} (ph: wff) (B2 D P E F: class) (G: class e f2 g2) (H: class e g2) (I J: class) (V: class e f2 g2):
  $ wceq P (cfv G cbs) $ >
  $ wceq D (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq B2 (cfv H cbs) $ >
  $ wceq E (cfv H cds) $ >
  $ wceq J (cfv H citv) $ >
  $ wi ph (wf1o B2 P F) $ >
  $ wi (wa ph (wa (wcel (cv e) B2) (wcel (cv f2) B2))) (wceq (co (cv e) (cv f2) E) (co (cfv (cv e) F) (cfv (cv f2) F) D)) $ >
  $ wi (wa ph (w3a (wcel (cv e) B2) (wcel (cv f2) B2) (wcel (cv g2) B2))) (wb (wcel (cv g2) (co (cv e) (cv f2) J)) (wcel (cfv (cv g2) F) (co (cfv (cv e) F) (cfv (cv f2) F) I))) $ >
  $ wi ph (wcel H V) $ >
  $ wi ph (wcel G cstrkge) $ >
  $ wi ph (wcel H cstrkge) $;

--| Function to convert an algebraic structure to a Tarski geometry.
term cttg: class;

--| Define a function converting a subcomplex Hilbert space to a Tarski Geometry. It does so by equipping the structure with a betweenness operation. Note that because the scalar product is applied over the interval ` ( 0 [,] 1 ) ` , only spaces whose scalar field is a superset of that interval can be considered. (Contributed by Thierry Arnoux, 24-Mar-2019.)
axiom df_ttg {x3 y1 z w i k: setvar}:
  $ wceq cttg (cmpt w cvv (csb i (cmpo x3 y1 (cfv (cv w) cbs) (cfv (cv w) cbs) (crab z (wrex k (wceq (co (cv z) (cv x3) (cfv (cv w) csg)) (co (cv k) (co (cv y1) (cv x3) (cfv (cv w) csg)) (cfv (cv w) cvsca))) (co cc0 c1 cicc)) (cfv (cv w) cbs))) (co (co (cv w) (cop (cfv cnx citv) (cv i)) csts) (cop (cfv cnx clng) (cmpo x3 y1 (cfv (cv w) cbs) (cfv (cv w) cbs) (crab z (w3o (wcel (cv z) (co (cv x3) (cv y1) (cv i))) (wcel (cv x3) (co (cv z) (cv y1) (cv i))) (wcel (cv y1) (co (cv x3) (cv z) (cv i)))) (cfv (cv w) cbs)))) csts))) $;

--| Define a function to augment a subcomplex Hilbert space with betweenness and a line definition. (Contributed by Thierry Arnoux, 25-Mar-2019.) (Proof shortened by AV, 9-Nov-2024.)
theorem ttgval {x3 y1 z k: setvar} (B2 c_x: class k) (G: class x3 y1 z k) (H: class) (I: class x3 y1 z k) (c_mi V: class k):
  $ wceq G (cfv H cttg) $ >
  $ wceq B2 (cfv H cbs) $ >
  $ wceq c_mi (cfv H csg) $ >
  $ wceq c_x (cfv H cvsca) $ >
  $ wceq I (cfv G citv) $ >
  $ wi (wcel H V) (wa (wceq G (co (co H (cop (cfv cnx citv) (cmpo x3 y1 B2 B2 (crab z (wrex k (wceq (co (cv z) (cv x3) c_mi) (co (cv k) (co (cv y1) (cv x3) c_mi) c_x)) (co cc0 c1 cicc)) B2))) csts) (cop (cfv cnx clng) (cmpo x3 y1 B2 B2 (crab z (w3o (wcel (cv z) (co (cv x3) (cv y1) I)) (wcel (cv x3) (co (cv z) (cv y1) I)) (wcel (cv y1) (co (cv x3) (cv z) I))) B2))) csts)) (wceq I (cmpo x3 y1 B2 B2 (crab z (wrex k (wceq (co (cv z) (cv x3) c_mi) (co (cv k) (co (cv y1) (cv x3) c_mi) c_x)) (co cc0 c1 cicc)) B2)))) $;

--| Lemma for ~ ttgbas , ~ ttgvsca etc. (Contributed by Thierry Arnoux, 15-Apr-2019.) (Revised by AV, 29-Oct-2024.)
theorem ttglem (E G H: class):
  $ wceq G (cfv H cttg) $ >
  $ wceq E (cslot (cfv cnx E)) $ >
  $ wne (cfv cnx E) (cfv cnx clng) $ >
  $ wne (cfv cnx E) (cfv cnx citv) $ >
  $ wceq (cfv H E) (cfv G E) $;

--| The base set of a subcomplex Hilbert space augmented with betweenness. (Contributed by Thierry Arnoux, 25-Mar-2019.) (Revised by AV, 29-Oct-2024.)
theorem ttgbas (B2 G H: class):
  $ wceq G (cfv H cttg) $ >
  $ wceq B2 (cfv H cbs) $ >
  $ wceq B2 (cfv G cbs) $;

--| The addition operation of a subcomplex Hilbert space augmented with betweenness. (Contributed by Thierry Arnoux, 25-Mar-2019.) (Revised by AV, 29-Oct-2024.)
theorem ttgplusg (c_pl G H: class):
  $ wceq G (cfv H cttg) $ >
  $ wceq c_pl (cfv H cplusg) $ >
  $ wceq c_pl (cfv G cplusg) $;

--| The subtraction operation of a subcomplex Hilbert space augmented with betweenness. (Contributed by Thierry Arnoux, 25-Mar-2019.)
theorem ttgsub (G H c_mi: class):
  $ wceq G (cfv H cttg) $ >
  $ wceq c_mi (cfv H csg) $ >
  $ wceq c_mi (cfv G csg) $;

--| The scalar product of a subcomplex Hilbert space augmented with betweenness. (Contributed by Thierry Arnoux, 25-Mar-2019.) (Revised by AV, 29-Oct-2024.)
theorem ttgvsca (c_x G H: class):
  $ wceq G (cfv H cttg) $ >
  $ wceq c_x (cfv H cvsca) $ >
  $ wceq c_x (cfv G cvsca) $;

--| The metric of a subcomplex Hilbert space augmented with betweenness. (Contributed by Thierry Arnoux, 25-Mar-2019.) (Revised by AV, 29-Oct-2024.)
theorem ttgds (D G H: class):
  $ wceq G (cfv H cttg) $ >
  $ wceq D (cfv H cds) $ >
  $ wceq D (cfv G cds) $;

--| Betweenness for a subcomplex Hilbert space augmented with betweenness. (Contributed by Thierry Arnoux, 25-Mar-2019.)
theorem ttgitvval {z k: setvar} (P: class) (c_x: class k) (G: class z k) (H: class) (I: class z k) (c_mi V X Y: class):
  $ wceq G (cfv H cttg) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq P (cfv H cbs) $ >
  $ wceq c_mi (cfv H csg) $ >
  $ wceq c_x (cfv H cvsca) $ >
  $ wi (w3a (wcel H V) (wcel X P) (wcel Y P)) (wceq (co X Y I) (crab z (wrex k (wceq (co (cv z) X c_mi) (co (cv k) (co Y X c_mi) c_x)) (co cc0 c1 cicc)) P)) $;

--| Betweenness for a subcomplex Hilbert space augmented with betweenness. (Contributed by Thierry Arnoux, 25-Mar-2019.)
theorem ttgelitv {k: setvar} (ph: wff k) (P: class) (c_x G: class k) (H: class) (I: class k) (c_mi V X Y Z: class):
  $ wceq G (cfv H cttg) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq P (cfv H cbs) $ >
  $ wceq c_mi (cfv H csg) $ >
  $ wceq c_x (cfv H cvsca) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel H V) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wb (wcel Z (co X Y I)) (wrex k (wceq (co Z X c_mi) (co (cv k) (co Y X c_mi) c_x)) (co cc0 c1 cicc))) $;

--| Any subcomplex module equipped with the betweenness operation fulfills the identity of betweenness (Axiom A6). (Contributed by Thierry Arnoux, 26-Mar-2019.)
theorem ttgbtwnid (ph: wff) (P R c_x G H I c_mi X Y: class):
  $ wceq G (cfv H cttg) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq P (cfv H cbs) $ >
  $ wceq c_mi (cfv H csg) $ >
  $ wceq c_x (cfv H cvsca) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wceq R (cfv (cfv H csca) cbs) $ >
  $ wi ph (wss (co cc0 c1 cicc) R) $ >
  $ wi ph (wcel H cclm) $ >
  $ wi ph (wcel Y (co X X I)) $ >
  $ wi ph (wceq X Y) $;

--| Lemma for % ttgcont . (Contributed by Thierry Arnoux, 24-May-2019.)
theorem ttgcontlem1 (ph: wff) (A2 B2 P c_pl R c_x G H I K L M c_mi N X Y: class):
  $ wceq G (cfv H cttg) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq P (cfv H cbs) $ >
  $ wceq c_mi (cfv H csg) $ >
  $ wceq c_x (cfv H cvsca) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wceq R (cfv (cfv H csca) cbs) $ >
  $ wi ph (wss (co cc0 c1 cicc) R) $ >
  $ wceq c_pl (cfv H cplusg) $ >
  $ wi ph (wcel H ccvs) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel N P) $ >
  $ wi ph (wne M cc0) $ >
  $ wi ph (wne K cc0) $ >
  $ wi ph (wne K c1) $ >
  $ wi ph (wne L M) $ >
  $ wi ph (wbr L (co M K cdiv) cle) $ >
  $ wi ph (wcel L (co cc0 c1 cicc)) $ >
  $ wi ph (wcel K (co cc0 c1 cicc)) $ >
  $ wi ph (wcel M (co cc0 L cicc)) $ >
  $ wi ph (wceq (co X A2 c_mi) (co K (co Y A2 c_mi) c_x)) $ >
  $ wi ph (wceq (co X A2 c_mi) (co M (co N A2 c_mi) c_x)) $ >
  $ wi ph (wceq B2 (co A2 (co L (co N A2 c_mi) c_x) c_pl)) $ >
  $ wi ph (wcel B2 (co X Y I)) $;

--| Any metric space fulfills Tarski's geometry axioms of congruence. (Contributed by Thierry Arnoux, 13-Mar-2019.)
theorem xmstrkgc (G: class):
  $ wi (wcel G cxms) (wcel G cstrkgc) $;

--| Lemma for chlbas and chlvsca . (Contributed by Thierry Arnoux, 15-Apr-2019.) (Revised by AV, 29-Oct-2024.)
theorem cchhllem {x3 y1: setvar} (C E: class x3 y1):
  $ wceq C (co (cfv cr (cfv ccnfld csra)) (cop (cfv cnx cip) (cmpo x3 y1 cc cc (co (cv x3) (cfv (cv y1) ccj) cmul))) csts) $ >
  $ wceq E (cslot (cfv cnx E)) $ >
  $ wne (cfv cnx csca) (cfv cnx E) $ >
  $ wne (cfv cnx cvsca) (cfv cnx E) $ >
  $ wne (cfv cnx cip) (cfv cnx E) $ >
  $ wceq (cfv ccnfld E) (cfv C E) $;

--| Declare the syntax for the Euclidean space generator.
term cee: class;

--| Declare the syntax for the Euclidean betweenness predicate.
term cbtwn: class;

--| Declare the syntax for the Euclidean congruence predicate.
term ccgr: class;

--| Define the Euclidean space generator. For details, see ~ elee . (Contributed by Scott Fenton, 3-Jun-2013.)
axiom df_ee {n: setvar}:
  $ wceq cee (cmpt n cn (co cr (co c1 (cv n) cfz) cmap)) $;

--| Define the Euclidean betweenness predicate. For details, see ~ brbtwn . (Contributed by Scott Fenton, 3-Jun-2013.)
axiom df_btwn {x3 y1 z t i n: setvar}:
  $ wceq cbtwn (ccnv (coprab x3 z y1 (wrex n (wa (w3a (wcel (cv x3) (cfv (cv n) cee)) (wcel (cv z) (cfv (cv n) cee)) (wcel (cv y1) (cfv (cv n) cee))) (wrex t (wral i (wceq (cfv (cv i) (cv y1)) (co (co (co c1 (cv t) cmin) (cfv (cv i) (cv x3)) cmul) (co (cv t) (cfv (cv i) (cv z)) cmul) caddc)) (co c1 (cv n) cfz)) (co cc0 c1 cicc))) cn))) $;

--| Define the Euclidean congruence predicate. For details, see ~ brcgr . (Contributed by Scott Fenton, 3-Jun-2013.)
axiom df_cgr {x3 y1 i n: setvar}:
  $ wceq ccgr (copab x3 y1 (wrex n (wa (wa (wcel (cv x3) (cxp (cfv (cv n) cee) (cfv (cv n) cee))) (wcel (cv y1) (cxp (cfv (cv n) cee) (cfv (cv n) cee)))) (wceq (csu i (co c1 (cv n) cfz) (co (co (cfv (cv i) (cfv (cv x3) c1st)) (cfv (cv i) (cfv (cv x3) c2nd)) cmin) c2 cexp)) (csu i (co c1 (cv n) cfz) (co (co (cfv (cv i) (cfv (cv y1) c1st)) (cfv (cv i) (cfv (cv y1) c2nd)) cmin) c2 cexp)))) cn)) $;

--| Membership in a Euclidean space. We define Euclidean space here using Cartesian coordinates over ` N ` space. We later abstract away from this using Tarski's geometry axioms, so this exact definition is unimportant. (Contributed by Scott Fenton, 3-Jun-2013.)
theorem elee (A2 N: class):
  $ wi (wcel N cn) (wb (wcel A2 (cfv N cee)) (wf (co c1 N cfz) cr A2)) $;

--| A condition for a mapping to be an element of a Euclidean space. (Contributed by Scott Fenton, 7-Jun-2013.) (Proof shortened by SN, 2-Feb-2026.)
theorem mptelee {k: setvar} (A2 B2 F: class k) (N: class):
  $ wi (wcel N cn) (wb (wcel (cmpt k (co c1 N cfz) (co A2 B2 F)) (cfv N cee)) (wral k (wcel (co A2 B2 F) cr) (co c1 N cfz))) $;

--| Obsolete version of ~ mptelee as of 2-Feb-2026. (Contributed by Scott Fenton, 7-Jun-2013.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem mpteleeOLD {k: setvar} (A2 B2 F: class k) (N: class):
  $ wi (wcel N cn) (wb (wcel (cmpt k (co c1 N cfz) (co A2 B2 F)) (cfv N cee)) (wral k (wcel (co A2 B2 F) cr) (co c1 N cfz))) $;

--| If ` A ` is in ` ( EE `` N ) ` , then ` N ` is a natural. (Contributed by Scott Fenton, 1-Jul-2013.)
theorem eleenn (A2 N: class):
  $ wi (wcel A2 (cfv N cee)) (wcel N cn) $;

--| The forward direction of ~ elee . (Contributed by Scott Fenton, 1-Jul-2013.)
theorem eleei (A2 N: class):
  $ wi (wcel A2 (cfv N cee)) (wf (co c1 N cfz) cr A2) $;

--| A point belongs to at most one Euclidean space. (Contributed by Scott Fenton, 1-Jul-2013.)
theorem eedimeq (A2 M N: class):
  $ wi (wa (wcel A2 (cfv N cee)) (wcel A2 (cfv M cee))) (wceq N M) $;

--| The binary relation form of the betweenness predicate. The statement ` A Btwn <. B , C >. ` should be informally read as " ` A ` lies on a line segment between ` B ` and ` C ` . This exact definition is abstracted away by Tarski's geometry axioms later on. (Contributed by Scott Fenton, 3-Jun-2013.)
theorem brbtwn {t i: setvar} (A2 B2 C N: class):
  $ wi (w3a (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee)) (wcel C (cfv N cee))) (wb (wbr A2 (cop B2 C) cbtwn) (wrex t (wral i (wceq (cfv (cv i) A2) (co (co (co c1 (cv t) cmin) (cfv (cv i) B2) cmul) (co (cv t) (cfv (cv i) C) cmul) caddc)) (co c1 N cfz)) (co cc0 c1 cicc))) $;

--| The binary relation form of the congruence predicate. The statement ` <. A , B >. Cgr <. C , D >. ` should be read informally as "the ` N ` dimensional point ` A ` is as far from ` B ` as ` C ` is from ` D ` , or "the line segment ` A B ` is congruent to the line segment ` C D ` . This particular definition is encapsulated by Tarski's axioms later on. (Contributed by Scott Fenton, 3-Jun-2013.)
theorem brcgr {i: setvar} (A2 B2 C D N: class):
  $ wi (wa (wa (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee))) (wa (wcel C (cfv N cee)) (wcel D (cfv N cee)))) (wb (wbr (cop A2 B2) (cop C D) ccgr) (wceq (csu i (co c1 N cfz) (co (co (cfv (cv i) A2) (cfv (cv i) B2) cmin) c2 cexp)) (csu i (co c1 N cfz) (co (co (cfv (cv i) C) (cfv (cv i) D) cmin) c2 cexp)))) $;

--| The function value of a point is a real. (Contributed by Scott Fenton, 10-Jun-2013.)
theorem fveere (A2 I N: class):
  $ wi (wa (wcel A2 (cfv N cee)) (wcel I (co c1 N cfz))) (wcel (cfv I A2) cr) $;

--| The function value of a point is a complex. (Contributed by Scott Fenton, 10-Jun-2013.)
theorem fveecn (A2 I N: class):
  $ wi (wa (wcel A2 (cfv N cee)) (wcel I (co c1 N cfz))) (wcel (cfv I A2) cc) $;

--| Two points are equal iff they agree in all dimensions. (Contributed by Scott Fenton, 10-Jun-2013.)
theorem eqeefv {i: setvar} (A2 B2 N: class):
  $ wi (wa (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee))) (wb (wceq A2 B2) (wral i (wceq (cfv (cv i) A2) (cfv (cv i) B2)) (co c1 N cfz))) $;

--| Two points are equal iff the square of the distance between them is zero. (Contributed by Scott Fenton, 10-Jun-2013.) (Revised by Mario Carneiro, 22-May-2014.)
theorem eqeelen {i: setvar} (A2 B2 N: class):
  $ wi (wa (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee))) (wb (wceq A2 B2) (wceq (csu i (co c1 N cfz) (co (co (cfv (cv i) A2) (cfv (cv i) B2) cmin) c2 cexp)) cc0)) $;

--| Alternate characterization of betweenness, with no existential quantifiers. (Contributed by Scott Fenton, 24-Jun-2013.)
theorem brbtwn2 {i j: setvar} (A2 B2 C N: class):
  $ wi (w3a (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee)) (wcel C (cfv N cee))) (wb (wbr A2 (cop B2 C) cbtwn) (wa (wral i (wbr (co (co (cfv (cv i) B2) (cfv (cv i) A2) cmin) (co (cfv (cv i) C) (cfv (cv i) A2) cmin) cmul) cc0 cle) (co c1 N cfz)) (wral i (wral j (wceq (co (co (cfv (cv i) B2) (cfv (cv i) A2) cmin) (co (cfv (cv j) C) (cfv (cv j) A2) cmin) cmul) (co (co (cfv (cv j) B2) (cfv (cv j) A2) cmin) (co (cfv (cv i) C) (cfv (cv i) A2) cmin) cmul)) (co c1 N cfz)) (co c1 N cfz)))) $;

--| Lemma for ~ colinearalg . Expand out a multiplication. (Contributed by Scott Fenton, 24-Jun-2013.)
theorem colinearalglem1 (A2 B2 C D E F: class):
  $ wi (wa (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (w3a (wcel D cc) (wcel E cc) (wcel F cc))) (wb (wceq (co (co B2 A2 cmin) (co F D cmin) cmul) (co (co E D cmin) (co C A2 cmin) cmul)) (wceq (co (co B2 F cmul) (co (co A2 F cmul) (co B2 D cmul) caddc) cmin) (co (co C E cmul) (co (co A2 E cmul) (co C D cmul) caddc) cmin))) $;

--| Lemma for ~ colinearalg . Translate between two forms of the colinearity condition. (Contributed by Scott Fenton, 24-Jun-2013.)
theorem colinearalglem2 {i j: setvar} (A2 B2 C N: class):
  $ wi (w3a (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee)) (wcel C (cfv N cee))) (wb (wral i (wral j (wceq (co (co (cfv (cv i) B2) (cfv (cv i) A2) cmin) (co (cfv (cv j) C) (cfv (cv j) A2) cmin) cmul) (co (co (cfv (cv j) B2) (cfv (cv j) A2) cmin) (co (cfv (cv i) C) (cfv (cv i) A2) cmin) cmul)) (co c1 N cfz)) (co c1 N cfz)) (wral i (wral j (wceq (co (co (cfv (cv i) C) (cfv (cv i) B2) cmin) (co (cfv (cv j) A2) (cfv (cv j) B2) cmin) cmul) (co (co (cfv (cv j) C) (cfv (cv j) B2) cmin) (co (cfv (cv i) A2) (cfv (cv i) B2) cmin) cmul)) (co c1 N cfz)) (co c1 N cfz))) $;

--| Lemma for ~ colinearalg . Translate between two forms of the colinearity condition. (Contributed by Scott Fenton, 24-Jun-2013.)
theorem colinearalglem3 {i j: setvar} (A2 B2 C N: class):
  $ wi (w3a (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee)) (wcel C (cfv N cee))) (wb (wral i (wral j (wceq (co (co (cfv (cv i) B2) (cfv (cv i) A2) cmin) (co (cfv (cv j) C) (cfv (cv j) A2) cmin) cmul) (co (co (cfv (cv j) B2) (cfv (cv j) A2) cmin) (co (cfv (cv i) C) (cfv (cv i) A2) cmin) cmul)) (co c1 N cfz)) (co c1 N cfz)) (wral i (wral j (wceq (co (co (cfv (cv i) A2) (cfv (cv i) C) cmin) (co (cfv (cv j) B2) (cfv (cv j) C) cmin) cmul) (co (co (cfv (cv j) A2) (cfv (cv j) C) cmin) (co (cfv (cv i) B2) (cfv (cv i) C) cmin) cmul)) (co c1 N cfz)) (co c1 N cfz))) $;

--| Lemma for ~ colinearalg . Prove a disjunction that will be needed in the final proof. (Contributed by Scott Fenton, 27-Jun-2013.)
theorem colinearalglem4 {i: setvar} (A2 C K N: class):
  $ wi (wa (wa (wcel A2 (cfv N cee)) (wcel C (cfv N cee))) (wcel K cr)) (w3o (wral i (wbr (co (co (co (co K (co (cfv (cv i) C) (cfv (cv i) A2) cmin) cmul) (cfv (cv i) A2) caddc) (cfv (cv i) A2) cmin) (co (cfv (cv i) C) (cfv (cv i) A2) cmin) cmul) cc0 cle) (co c1 N cfz)) (wral i (wbr (co (co (cfv (cv i) C) (co (co K (co (cfv (cv i) C) (cfv (cv i) A2) cmin) cmul) (cfv (cv i) A2) caddc) cmin) (co (cfv (cv i) A2) (co (co K (co (cfv (cv i) C) (cfv (cv i) A2) cmin) cmul) (cfv (cv i) A2) caddc) cmin) cmul) cc0 cle) (co c1 N cfz)) (wral i (wbr (co (co (cfv (cv i) A2) (cfv (cv i) C) cmin) (co (co (co K (co (cfv (cv i) C) (cfv (cv i) A2) cmin) cmul) (cfv (cv i) A2) caddc) (cfv (cv i) C) cmin) cmul) cc0 cle) (co c1 N cfz))) $;

--| An algebraic characterization of colinearity. Note the similarity to ~ brbtwn2 . (Contributed by Scott Fenton, 24-Jun-2013.)
theorem colinearalg {i j: setvar} (A2 B2 C N: class):
  $ wi (w3a (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee)) (wcel C (cfv N cee))) (wb (w3o (wbr A2 (cop B2 C) cbtwn) (wbr B2 (cop C A2) cbtwn) (wbr C (cop A2 B2) cbtwn)) (wral i (wral j (wceq (co (co (cfv (cv i) B2) (cfv (cv i) A2) cmin) (co (cfv (cv j) C) (cfv (cv j) A2) cmin) cmul) (co (co (cfv (cv j) B2) (cfv (cv j) A2) cmin) (co (cfv (cv i) C) (cfv (cv i) A2) cmin) cmul)) (co c1 N cfz)) (co c1 N cfz))) $;

--| Membership of a subtraction mapping in a Euclidean space. (Contributed by Scott Fenton, 17-Jul-2013.)
theorem eleesub {i: setvar} (A2 B2: class) (C: class i) (N: class):
  $ wceq C (cmpt i (co c1 N cfz) (co (cfv (cv i) A2) (cfv (cv i) B2) cmin)) $ >
  $ wi (wa (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee))) (wcel C (cfv N cee)) $;

--| Membership of a subtraction mapping in a Euclidean space. Deduction form of ~ eleesub . (Contributed by Scott Fenton, 17-Jul-2013.)
theorem eleesubd {i: setvar} (ph: wff i) (A2 B2: class) (C: class i) (N: class):
  $ wi ph (wceq C (cmpt i (co c1 N cfz) (co (cfv (cv i) A2) (cfv (cv i) B2) cmin))) $ >
  $ wi (w3a ph (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee))) (wcel C (cfv N cee)) $;

--| The unique dimension axiom. If a point is in ` N ` dimensional space and in ` M ` dimensional space, then ` N = M ` . This axiom is not traditionally presented with Tarski's axioms, but we require it here as we are considering spaces in arbitrary dimensions. (Contributed by Scott Fenton, 24-Sep-2013.)
theorem axdimuniq (A2 M N: class):
  $ wi (wa (wa (wcel N cn) (wcel A2 (cfv N cee))) (wa (wcel M cn) (wcel A2 (cfv M cee)))) (wceq N M) $;

--| ` A ` is as far from ` B ` as ` B ` is from ` A ` . Axiom A1 of [Schwabhauser] p. 10. (Contributed by Scott Fenton, 3-Jun-2013.)
theorem axcgrrflx (A2 B2 N: class):
  $ wi (w3a (wcel N cn) (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee))) (wbr (cop A2 B2) (cop B2 A2) ccgr) $;

--| Congruence is transitive. Axiom A2 of [Schwabhauser] p. 10. (Contributed by Scott Fenton, 3-Jun-2013.)
theorem axcgrtr (A2 B2 C D E F N: class):
  $ wi (w3a (wcel N cn) (w3a (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee)) (wcel C (cfv N cee))) (w3a (wcel D (cfv N cee)) (wcel E (cfv N cee)) (wcel F (cfv N cee)))) (wi (wa (wbr (cop A2 B2) (cop C D) ccgr) (wbr (cop A2 B2) (cop E F) ccgr)) (wbr (cop C D) (cop E F) ccgr)) $;

--| If there is no distance between ` A ` and ` B ` , then ` A = B ` . Axiom A3 of [Schwabhauser] p. 10. (Contributed by Scott Fenton, 3-Jun-2013.)
theorem axcgrid (A2 B2 C N: class):
  $ wi (wa (wcel N cn) (w3a (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee)) (wcel C (cfv N cee)))) (wi (wbr (cop A2 B2) (cop C C) ccgr) (wceq A2 B2)) $;

--| Lemma for ~ axsegcon . Handle the degenerate case. (Contributed by Scott Fenton, 7-Jun-2013.)
theorem axsegconlem1 {x3 t i: setvar} (A2 B2 C D N: class):
  $ wi (wa (wceq A2 B2) (wa (wa (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee))) (wa (wcel C (cfv N cee)) (wcel D (cfv N cee))))) (wrex x3 (wrex t (wa (wral i (wceq (cfv (cv i) B2) (co (co (co c1 (cv t) cmin) (cfv (cv i) A2) cmul) (co (cv t) (cfv (cv i) (cv x3)) cmul) caddc)) (co c1 N cfz)) (wceq (csu i (co c1 N cfz) (co (co (cfv (cv i) B2) (cfv (cv i) (cv x3)) cmin) c2 cexp)) (csu i (co c1 N cfz) (co (co (cfv (cv i) C) (cfv (cv i) D) cmin) c2 cexp)))) (co cc0 c1 cicc)) (cfv N cee)) $;

--| Lemma for ~ axsegcon . Show that the square of the distance between two points is a real number. (Contributed by Scott Fenton, 17-Sep-2013.)
theorem axsegconlem2 {p: setvar} (A2 B2: class) (S: class p) (N: class):
  $ wceq S (csu p (co c1 N cfz) (co (co (cfv (cv p) A2) (cfv (cv p) B2) cmin) c2 cexp)) $ >
  $ wi (wa (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee))) (wcel S cr) $;

--| Lemma for ~ axsegcon . Show that the square of the distance between two points is nonnegative. (Contributed by Scott Fenton, 17-Sep-2013.)
theorem axsegconlem3 {p: setvar} (A2 B2: class) (S: class p) (N: class):
  $ wceq S (csu p (co c1 N cfz) (co (co (cfv (cv p) A2) (cfv (cv p) B2) cmin) c2 cexp)) $ >
  $ wi (wa (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee))) (wbr cc0 S cle) $;

--| Lemma for ~ axsegcon . Show that the distance between two points is a real number. (Contributed by Scott Fenton, 17-Sep-2013.)
theorem axsegconlem4 {p: setvar} (A2 B2: class) (S: class p) (N: class):
  $ wceq S (csu p (co c1 N cfz) (co (co (cfv (cv p) A2) (cfv (cv p) B2) cmin) c2 cexp)) $ >
  $ wi (wa (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee))) (wcel (cfv S csqrt) cr) $;

--| Lemma for ~ axsegcon . Show that the distance between two points is nonnegative. (Contributed by Scott Fenton, 17-Sep-2013.)
theorem axsegconlem5 {p: setvar} (A2 B2: class) (S: class p) (N: class):
  $ wceq S (csu p (co c1 N cfz) (co (co (cfv (cv p) A2) (cfv (cv p) B2) cmin) c2 cexp)) $ >
  $ wi (wa (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee))) (wbr cc0 (cfv S csqrt) cle) $;

--| Lemma for ~ axsegcon . Show that the distance between two distinct points is positive. (Contributed by Scott Fenton, 17-Sep-2013.)
theorem axsegconlem6 {p: setvar} (A2 B2: class) (S: class p) (N: class):
  $ wceq S (csu p (co c1 N cfz) (co (co (cfv (cv p) A2) (cfv (cv p) B2) cmin) c2 cexp)) $ >
  $ wi (w3a (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee)) (wne A2 B2)) (wbr cc0 (cfv S csqrt) clt) $;

--| Lemma for ~ axsegcon . Show that a particular ratio of distances is in the closed unit interval. (Contributed by Scott Fenton, 18-Sep-2013.)
theorem axsegconlem7 {p: setvar} (A2 B2 C D: class) (S T: class p) (N: class):
  $ wceq S (csu p (co c1 N cfz) (co (co (cfv (cv p) A2) (cfv (cv p) B2) cmin) c2 cexp)) $ >
  $ wceq T (csu p (co c1 N cfz) (co (co (cfv (cv p) C) (cfv (cv p) D) cmin) c2 cexp)) $ >
  $ wi (wa (w3a (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee)) (wne A2 B2)) (wa (wcel C (cfv N cee)) (wcel D (cfv N cee)))) (wcel (co (cfv S csqrt) (co (cfv S csqrt) (cfv T csqrt) caddc) cdiv) (co cc0 c1 cicc)) $;

--| Lemma for ~ axsegcon . Show that a particular mapping generates a point. (Contributed by Scott Fenton, 18-Sep-2013.)
theorem axsegconlem8 {k p: setvar} (A2 B2 C D: class) (S T: class p) (F: class k p) (N: class):
  $ wceq S (csu p (co c1 N cfz) (co (co (cfv (cv p) A2) (cfv (cv p) B2) cmin) c2 cexp)) $ >
  $ wceq T (csu p (co c1 N cfz) (co (co (cfv (cv p) C) (cfv (cv p) D) cmin) c2 cexp)) $ >
  $ wceq F (cmpt k (co c1 N cfz) (co (co (co (co (cfv S csqrt) (cfv T csqrt) caddc) (cfv (cv k) B2) cmul) (co (cfv T csqrt) (cfv (cv k) A2) cmul) cmin) (cfv S csqrt) cdiv)) $ >
  $ wi (wa (w3a (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee)) (wne A2 B2)) (wa (wcel C (cfv N cee)) (wcel D (cfv N cee)))) (wcel F (cfv N cee)) $;

--| Lemma for ~ axsegcon . Show that ` B F ` is congruent to ` C D ` . (Contributed by Scott Fenton, 19-Sep-2013.)
theorem axsegconlem9 {i k p: setvar} (A2 B2 C D: class) (S T: class p) (F: class i k p) (N: class):
  $ wceq S (csu p (co c1 N cfz) (co (co (cfv (cv p) A2) (cfv (cv p) B2) cmin) c2 cexp)) $ >
  $ wceq T (csu p (co c1 N cfz) (co (co (cfv (cv p) C) (cfv (cv p) D) cmin) c2 cexp)) $ >
  $ wceq F (cmpt k (co c1 N cfz) (co (co (co (co (cfv S csqrt) (cfv T csqrt) caddc) (cfv (cv k) B2) cmul) (co (cfv T csqrt) (cfv (cv k) A2) cmul) cmin) (cfv S csqrt) cdiv)) $ >
  $ wi (wa (w3a (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee)) (wne A2 B2)) (wa (wcel C (cfv N cee)) (wcel D (cfv N cee)))) (wceq (csu i (co c1 N cfz) (co (co (cfv (cv i) B2) (cfv (cv i) F) cmin) c2 cexp)) (csu i (co c1 N cfz) (co (co (cfv (cv i) C) (cfv (cv i) D) cmin) c2 cexp))) $;

--| Lemma for ~ axsegcon . Show that the scaling constant from ~ axsegconlem7 produces the betweenness condition for ` A ` , ` B ` and ` F ` . (Contributed by Scott Fenton, 21-Sep-2013.)
theorem axsegconlem10 {i k p: setvar} (A2 B2 C D: class) (S T: class p) (F: class i k p) (N: class):
  $ wceq S (csu p (co c1 N cfz) (co (co (cfv (cv p) A2) (cfv (cv p) B2) cmin) c2 cexp)) $ >
  $ wceq T (csu p (co c1 N cfz) (co (co (cfv (cv p) C) (cfv (cv p) D) cmin) c2 cexp)) $ >
  $ wceq F (cmpt k (co c1 N cfz) (co (co (co (co (cfv S csqrt) (cfv T csqrt) caddc) (cfv (cv k) B2) cmul) (co (cfv T csqrt) (cfv (cv k) A2) cmul) cmin) (cfv S csqrt) cdiv)) $ >
  $ wi (wa (w3a (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee)) (wne A2 B2)) (wa (wcel C (cfv N cee)) (wcel D (cfv N cee)))) (wral i (wceq (cfv (cv i) B2) (co (co (co c1 (co (cfv S csqrt) (co (cfv S csqrt) (cfv T csqrt) caddc) cdiv) cmin) (cfv (cv i) A2) cmul) (co (co (cfv S csqrt) (co (cfv S csqrt) (cfv T csqrt) caddc) cdiv) (cfv (cv i) F) cmul) caddc)) (co c1 N cfz)) $;

--| Any segment ` A B ` can be extended to a point ` x ` such that ` B x ` is congruent to ` C D ` . Axiom A4 of [Schwabhauser] p. 11. (Contributed by Scott Fenton, 4-Jun-2013.)
theorem axsegcon {x3: setvar} (A2 B2 C D N: class):
  $ wi (w3a (wcel N cn) (wa (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee))) (wa (wcel C (cfv N cee)) (wcel D (cfv N cee)))) (wrex x3 (wa (wbr B2 (cop A2 (cv x3)) cbtwn) (wbr (cop B2 (cv x3)) (cop C D) ccgr)) (cfv N cee)) $;

--| Lemma for ~ ax5seg . Rexpress a one congruence sum given betweenness. (Contributed by Scott Fenton, 11-Jun-2013.)
theorem ax5seglem1 {i j: setvar} (A2 B2 C T N: class):
  $ wi (w3a (wcel N cn) (wa (wcel A2 (cfv N cee)) (wcel C (cfv N cee))) (wa (wcel T (co cc0 c1 cicc)) (wral i (wceq (cfv (cv i) B2) (co (co (co c1 T cmin) (cfv (cv i) A2) cmul) (co T (cfv (cv i) C) cmul) caddc)) (co c1 N cfz)))) (wceq (csu j (co c1 N cfz) (co (co (cfv (cv j) A2) (cfv (cv j) B2) cmin) c2 cexp)) (co (co T c2 cexp) (csu j (co c1 N cfz) (co (co (cfv (cv j) A2) (cfv (cv j) C) cmin) c2 cexp)) cmul)) $;

--| Lemma for ~ ax5seg . Rexpress another congruence sum given betweenness. (Contributed by Scott Fenton, 11-Jun-2013.)
theorem ax5seglem2 {i j: setvar} (A2 B2 C T N: class):
  $ wi (w3a (wcel N cn) (wa (wcel A2 (cfv N cee)) (wcel C (cfv N cee))) (wa (wcel T (co cc0 c1 cicc)) (wral i (wceq (cfv (cv i) B2) (co (co (co c1 T cmin) (cfv (cv i) A2) cmul) (co T (cfv (cv i) C) cmul) caddc)) (co c1 N cfz)))) (wceq (csu j (co c1 N cfz) (co (co (cfv (cv j) B2) (cfv (cv j) C) cmin) c2 cexp)) (co (co (co c1 T cmin) c2 cexp) (csu j (co c1 N cfz) (co (co (cfv (cv j) A2) (cfv (cv j) C) cmin) c2 cexp)) cmul)) $;

--| Lemma for ~ ax5seg . (Contributed by Scott Fenton, 7-May-2015.)
theorem ax5seglem3a (A2 B2 C D: class) (j: setvar) (E F N: class):
  $ wi (wa (w3a (wcel N cn) (w3a (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee)) (wcel C (cfv N cee))) (w3a (wcel D (cfv N cee)) (wcel E (cfv N cee)) (wcel F (cfv N cee)))) (wcel (cv j) (co c1 N cfz))) (wa (wcel (co (cfv (cv j) A2) (cfv (cv j) C) cmin) cr) (wcel (co (cfv (cv j) D) (cfv (cv j) F) cmin) cr)) $;

--| Lemma for ~ ax5seg . Combine congruences for points on a line. (Contributed by Scott Fenton, 11-Jun-2013.)
theorem ax5seglem3 {i j: setvar} (A2 B2 C D S T E F N: class):
  $ wi (w3a (w3a (wcel N cn) (w3a (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee)) (wcel C (cfv N cee))) (w3a (wcel D (cfv N cee)) (wcel E (cfv N cee)) (wcel F (cfv N cee)))) (wa (wa (wcel T (co cc0 c1 cicc)) (wcel S (co cc0 c1 cicc))) (wa (wral i (wceq (cfv (cv i) B2) (co (co (co c1 T cmin) (cfv (cv i) A2) cmul) (co T (cfv (cv i) C) cmul) caddc)) (co c1 N cfz)) (wral i (wceq (cfv (cv i) E) (co (co (co c1 S cmin) (cfv (cv i) D) cmul) (co S (cfv (cv i) F) cmul) caddc)) (co c1 N cfz)))) (wa (wbr (cop A2 B2) (cop D E) ccgr) (wbr (cop B2 C) (cop E F) ccgr))) (wceq (csu j (co c1 N cfz) (co (co (cfv (cv j) A2) (cfv (cv j) C) cmin) c2 cexp)) (csu j (co c1 N cfz) (co (co (cfv (cv j) D) (cfv (cv j) F) cmin) c2 cexp))) $;

--| Lemma for ~ ax5seg . Given two distinct points, the scaling constant in a betweenness statement is nonzero. (Contributed by Scott Fenton, 11-Jun-2013.)
theorem ax5seglem4 {i: setvar} (A2 B2 C T N: class):
  $ wi (w3a (wa (wcel N cn) (w3a (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee)) (wcel C (cfv N cee)))) (wral i (wceq (cfv (cv i) B2) (co (co (co c1 T cmin) (cfv (cv i) A2) cmul) (co T (cfv (cv i) C) cmul) caddc)) (co c1 N cfz)) (wne A2 B2)) (wne T cc0) $;

--| Lemma for ~ ax5seg . If ` B ` is between ` A ` and ` C ` , and ` A ` is distinct from ` B ` , then ` A ` is distinct from ` C ` . (Contributed by Scott Fenton, 11-Jun-2013.)
theorem ax5seglem5 {i j: setvar} (A2 B2 C: class) (T: class j) (N: class):
  $ wi (wa (wa (wcel N cn) (w3a (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee)) (wcel C (cfv N cee)))) (w3a (wne A2 B2) (wcel T (co cc0 c1 cicc)) (wral i (wceq (cfv (cv i) B2) (co (co (co c1 T cmin) (cfv (cv i) A2) cmul) (co T (cfv (cv i) C) cmul) caddc)) (co c1 N cfz)))) (wne (csu j (co c1 N cfz) (co (co (cfv (cv j) A2) (cfv (cv j) C) cmin) c2 cexp)) cc0) $;

--| Lemma for ~ ax5seg . Given two line segments that are divided into pieces, if the pieces are congruent, then the scaling constant is the same. (Contributed by Scott Fenton, 12-Jun-2013.)
theorem ax5seglem6 {i: setvar} (A2 B2 C D S T E F N: class):
  $ wi (w3a (wa (wcel N cn) (wa (w3a (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee)) (wcel C (cfv N cee))) (w3a (wcel D (cfv N cee)) (wcel E (cfv N cee)) (wcel F (cfv N cee))))) (w3a (wne A2 B2) (wa (wcel T (co cc0 c1 cicc)) (wcel S (co cc0 c1 cicc))) (wa (wral i (wceq (cfv (cv i) B2) (co (co (co c1 T cmin) (cfv (cv i) A2) cmul) (co T (cfv (cv i) C) cmul) caddc)) (co c1 N cfz)) (wral i (wceq (cfv (cv i) E) (co (co (co c1 S cmin) (cfv (cv i) D) cmul) (co S (cfv (cv i) F) cmul) caddc)) (co c1 N cfz)))) (wa (wbr (cop A2 B2) (cop D E) ccgr) (wbr (cop B2 C) (cop E F) ccgr))) (wceq T S) $;

--| Lemma for ~ ax5seg . An algebraic calculation needed further down the line. (Contributed by Scott Fenton, 12-Jun-2013.)
theorem ax5seglem7 (A2 C D T: class):
  $ wcel A2 cc $ >
  $ wcel T cc $ >
  $ wcel C cc $ >
  $ wcel D cc $ >
  $ wceq (co T (co (co C D cmin) c2 cexp) cmul) (co (co (co (co (co (co c1 T cmin) A2 cmul) (co T C cmul) caddc) D cmin) c2 cexp) (co (co c1 T cmin) (co (co T (co (co A2 C cmin) c2 cexp) cmul) (co (co A2 D cmin) c2 cexp) cmin) cmul) caddc) $;

--| Lemma for ~ ax5seg . Use the weak deduction theorem to eliminate the hypotheses from ~ ax5seglem7 . (Contributed by Scott Fenton, 11-Jun-2013.)
theorem ax5seglem8 (A2 C D T: class):
  $ wi (wa (wa (wcel A2 cc) (wcel T cc)) (wa (wcel C cc) (wcel D cc))) (wceq (co T (co (co C D cmin) c2 cexp) cmul) (co (co (co (co (co (co c1 T cmin) A2 cmul) (co T C cmul) caddc) D cmin) c2 cexp) (co (co c1 T cmin) (co (co T (co (co A2 C cmin) c2 cexp) cmul) (co (co A2 D cmin) c2 cexp) cmin) cmul) caddc)) $;

--| Lemma for ~ ax5seg . Take the calculation in ~ ax5seglem8 and turn it into a series of measurements. (Contributed by Scott Fenton, 12-Jun-2013.) (Revised by Mario Carneiro, 22-May-2014.)
theorem ax5seglem9 {i j: setvar} (A2 B2 C D T N: class):
  $ wi (wa (wa (wcel N cn) (wa (wa (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee))) (wa (wcel C (cfv N cee)) (wcel D (cfv N cee))))) (wa (wcel T (co cc0 c1 cicc)) (wral i (wceq (cfv (cv i) B2) (co (co (co c1 T cmin) (cfv (cv i) A2) cmul) (co T (cfv (cv i) C) cmul) caddc)) (co c1 N cfz)))) (wceq (co T (csu j (co c1 N cfz) (co (co (cfv (cv j) C) (cfv (cv j) D) cmin) c2 cexp)) cmul) (co (csu j (co c1 N cfz) (co (co (cfv (cv j) B2) (cfv (cv j) D) cmin) c2 cexp)) (co (co c1 T cmin) (co (co T (csu j (co c1 N cfz) (co (co (cfv (cv j) A2) (cfv (cv j) C) cmin) c2 cexp)) cmul) (csu j (co c1 N cfz) (co (co (cfv (cv j) A2) (cfv (cv j) D) cmin) c2 cexp)) cmin) cmul) caddc)) $;

--| The five segment axiom. Take two triangles ` A D C ` and ` E H G ` , a point ` B ` on ` A C ` , and a point ` F ` on ` E G ` . If all corresponding line segments except for ` C D ` and ` G H ` are congruent, then so are ` C D ` and ` G H ` . Axiom A5 of [Schwabhauser] p. 11. (Contributed by Scott Fenton, 12-Jun-2013.)
theorem ax5seg (A2 B2 C D E F G H N: class):
  $ wi (w3a (w3a (wcel N cn) (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee))) (w3a (wcel C (cfv N cee)) (wcel D (cfv N cee)) (wcel E (cfv N cee))) (w3a (wcel F (cfv N cee)) (wcel G (cfv N cee)) (wcel H (cfv N cee)))) (wi (w3a (w3a (wne A2 B2) (wbr B2 (cop A2 C) cbtwn) (wbr F (cop E G) cbtwn)) (wa (wbr (cop A2 B2) (cop E F) ccgr) (wbr (cop B2 C) (cop F G) ccgr)) (wa (wbr (cop A2 D) (cop E H) ccgr) (wbr (cop B2 D) (cop F H) ccgr))) (wbr (cop C D) (cop G H) ccgr)) $;

--| Points are indivisible. That is, if ` A ` lies between ` B ` and ` B ` , then ` A = B ` . Axiom A6 of [Schwabhauser] p. 11. (Contributed by Scott Fenton, 3-Jun-2013.)
theorem axbtwnid (A2 B2 N: class):
  $ wi (w3a (wcel N cn) (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee))) (wi (wbr A2 (cop B2 B2) cbtwn) (wceq A2 B2)) $;

--| Lemma for ~ axpasch . Set up coefficients used in the proof. (Contributed by Scott Fenton, 5-Jun-2013.)
theorem axpaschlem {r p: setvar} (S T: class):
  $ wi (wa (wcel T (co cc0 c1 cicc)) (wcel S (co cc0 c1 cicc))) (wrex r (wrex p (w3a (wceq (cv p) (co (co c1 (cv r) cmin) (co c1 T cmin) cmul)) (wceq (cv r) (co (co c1 (cv p) cmin) (co c1 S cmin) cmul)) (wceq (co (co c1 (cv r) cmin) T cmul) (co (co c1 (cv p) cmin) S cmul))) (co cc0 c1 cicc)) (co cc0 c1 cicc)) $;

--| The inner Pasch axiom. Take a triangle ` A C E ` , a point ` D ` on ` A C ` , and a point ` B ` extending ` C E ` . Then ` A E ` and ` D B ` intersect at some point ` x ` . Axiom A7 of [Schwabhauser] p. 12. (Contributed by Scott Fenton, 3-Jun-2013.)
theorem axpasch {x3: setvar} (A2 B2 C D E N: class):
  $ wi (w3a (wcel N cn) (w3a (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee)) (wcel C (cfv N cee))) (wa (wcel D (cfv N cee)) (wcel E (cfv N cee)))) (wi (wa (wbr D (cop A2 C) cbtwn) (wbr E (cop B2 C) cbtwn)) (wrex x3 (wa (wbr (cv x3) (cop D B2) cbtwn) (wbr (cv x3) (cop E A2) cbtwn)) (cfv N cee))) $;

--| Lemma for ~ axlowdim . Establish a particular constant function as a function. (Contributed by Scott Fenton, 29-Jun-2013.)
theorem axlowdimlem1 (N: class):
  $ wf (co c3 N cfz) cr (cxp (co c3 N cfz) (csn cc0)) $;

--| Lemma for ~ axlowdim . Show that two sets are disjoint. (Contributed by Scott Fenton, 29-Jun-2013.)
theorem axlowdimlem2 (N: class):
  $ wceq (cin (co c1 c2 cfz) (co c3 N cfz)) c0 $;

--| Lemma for ~ axlowdim . Set up a union property for an interval of integers. (Contributed by Scott Fenton, 29-Jun-2013.)
theorem axlowdimlem3 (N: class):
  $ wi (wcel N (cfv c2 cuz)) (wceq (co c1 N cfz) (cun (co c1 c2 cfz) (co c3 N cfz))) $;

--| Lemma for ~ axlowdim . Set up a particular constant function. (Contributed by Scott Fenton, 17-Apr-2013.)
theorem axlowdimlem4 (A2 B2: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wf (co c1 c2 cfz) cr (cpr (cop c1 A2) (cop c2 B2)) $;

--| Lemma for ~ axlowdim . Show that a particular union is a point in Euclidean space. (Contributed by Scott Fenton, 29-Jun-2013.)
theorem axlowdimlem5 (A2 B2 N: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wi (wcel N (cfv c2 cuz)) (wcel (cun (cpr (cop c1 A2) (cop c2 B2)) (cxp (co c3 N cfz) (csn cc0))) (cfv N cee)) $;

--| Lemma for ~ axlowdim . Show that three points are non-colinear. (Contributed by Scott Fenton, 29-Jun-2013.)
theorem axlowdimlem6 (A2 B2 C N: class):
  $ wceq A2 (cun (cpr (cop c1 cc0) (cop c2 cc0)) (cxp (co c3 N cfz) (csn cc0))) $ >
  $ wceq B2 (cun (cpr (cop c1 c1) (cop c2 cc0)) (cxp (co c3 N cfz) (csn cc0))) $ >
  $ wceq C (cun (cpr (cop c1 cc0) (cop c2 c1)) (cxp (co c3 N cfz) (csn cc0))) $ >
  $ wi (wcel N (cfv c2 cuz)) (wn (w3o (wbr A2 (cop B2 C) cbtwn) (wbr B2 (cop C A2) cbtwn) (wbr C (cop A2 B2) cbtwn))) $;

--| Lemma for ~ axlowdim . Set up a point in Euclidean space. (Contributed by Scott Fenton, 29-Jun-2013.)
theorem axlowdimlem7 (P N: class):
  $ wceq P (cun (csn (cop c3 (cneg c1))) (cxp (cdif (co c1 N cfz) (csn c3)) (csn cc0))) $ >
  $ wi (wcel N (cfv c3 cuz)) (wcel P (cfv N cee)) $;

--| Lemma for ~ axlowdim . Calculate the value of ` P ` at three. (Contributed by Scott Fenton, 21-Apr-2013.)
theorem axlowdimlem8 (P N: class):
  $ wceq P (cun (csn (cop c3 (cneg c1))) (cxp (cdif (co c1 N cfz) (csn c3)) (csn cc0))) $ >
  $ wceq (cfv c3 P) (cneg c1) $;

--| Lemma for ~ axlowdim . Calculate the value of ` P ` away from three. (Contributed by Scott Fenton, 21-Apr-2013.)
theorem axlowdimlem9 (P K N: class):
  $ wceq P (cun (csn (cop c3 (cneg c1))) (cxp (cdif (co c1 N cfz) (csn c3)) (csn cc0))) $ >
  $ wi (wa (wcel K (co c1 N cfz)) (wne K c3)) (wceq (cfv K P) cc0) $;

--| Lemma for ~ axlowdim . Set up a family of points in Euclidean space. (Contributed by Scott Fenton, 21-Apr-2013.)
theorem axlowdimlem10 (Q I N: class):
  $ wceq Q (cun (csn (cop (co I c1 caddc) c1)) (cxp (cdif (co c1 N cfz) (csn (co I c1 caddc))) (csn cc0))) $ >
  $ wi (wa (wcel N cn) (wcel I (co c1 (co N c1 cmin) cfz))) (wcel Q (cfv N cee)) $;

--| Lemma for ~ axlowdim . Calculate the value of ` Q ` at its distinguished point. (Contributed by Scott Fenton, 21-Apr-2013.)
theorem axlowdimlem11 (Q I N: class):
  $ wceq Q (cun (csn (cop (co I c1 caddc) c1)) (cxp (cdif (co c1 N cfz) (csn (co I c1 caddc))) (csn cc0))) $ >
  $ wceq (cfv (co I c1 caddc) Q) c1 $;

--| Lemma for ~ axlowdim . Calculate the value of ` Q ` away from its distinguished point. (Contributed by Scott Fenton, 21-Apr-2013.)
theorem axlowdimlem12 (Q I K N: class):
  $ wceq Q (cun (csn (cop (co I c1 caddc) c1)) (cxp (cdif (co c1 N cfz) (csn (co I c1 caddc))) (csn cc0))) $ >
  $ wi (wa (wcel K (co c1 N cfz)) (wne K (co I c1 caddc))) (wceq (cfv K Q) cc0) $;

--| Lemma for ~ axlowdim . Establish that ` P ` and ` Q ` are different points. (Contributed by Scott Fenton, 21-Apr-2013.)
theorem axlowdimlem13 (P Q I N: class):
  $ wceq P (cun (csn (cop c3 (cneg c1))) (cxp (cdif (co c1 N cfz) (csn c3)) (csn cc0))) $ >
  $ wceq Q (cun (csn (cop (co I c1 caddc) c1)) (cxp (cdif (co c1 N cfz) (csn (co I c1 caddc))) (csn cc0))) $ >
  $ wi (wa (wcel N cn) (wcel I (co c1 (co N c1 cmin) cfz))) (wne P Q) $;

--| Lemma for ~ axlowdim . Take two possible ` Q ` from ~ axlowdimlem10 . They are the same iff their distinguished values are the same. (Contributed by Scott Fenton, 21-Apr-2013.)
theorem axlowdimlem14 (Q R I J N: class):
  $ wceq Q (cun (csn (cop (co I c1 caddc) c1)) (cxp (cdif (co c1 N cfz) (csn (co I c1 caddc))) (csn cc0))) $ >
  $ wceq R (cun (csn (cop (co J c1 caddc) c1)) (cxp (cdif (co c1 N cfz) (csn (co J c1 caddc))) (csn cc0))) $ >
  $ wi (w3a (wcel N cn) (wcel I (co c1 (co N c1 cmin) cfz)) (wcel J (co c1 (co N c1 cmin) cfz))) (wi (wceq Q R) (wceq I J)) $;

--| Lemma for ~ axlowdim . Set up a one-to-one function of points. (Contributed by Scott Fenton, 21-Apr-2013.)
theorem axlowdimlem15 {i: setvar} (F: class i) (N: class):
  $ wceq F (cmpt i (co c1 (co N c1 cmin) cfz) (cif (wceq (cv i) c1) (cun (csn (cop c3 (cneg c1))) (cxp (cdif (co c1 N cfz) (csn c3)) (csn cc0))) (cun (csn (cop (co (cv i) c1 caddc) c1)) (cxp (cdif (co c1 N cfz) (csn (co (cv i) c1 caddc))) (csn cc0))))) $ >
  $ wi (wcel N (cfv c3 cuz)) (wf1 (co c1 (co N c1 cmin) cfz) (cfv N cee) F) $;

--| Lemma for ~ axlowdim . Set up a summation that will help establish distance. (Contributed by Scott Fenton, 21-Apr-2013.)
theorem axlowdimlem16 {i: setvar} (P Q I N: class):
  $ wceq P (cun (csn (cop c3 (cneg c1))) (cxp (cdif (co c1 N cfz) (csn c3)) (csn cc0))) $ >
  $ wceq Q (cun (csn (cop (co I c1 caddc) c1)) (cxp (cdif (co c1 N cfz) (csn (co I c1 caddc))) (csn cc0))) $ >
  $ wi (wa (wcel N (cfv c3 cuz)) (wcel I (co c2 (co N c1 cmin) cfz))) (wceq (csu i (co c3 N cfz) (co (cfv (cv i) P) c2 cexp)) (csu i (co c3 N cfz) (co (cfv (cv i) Q) c2 cexp))) $;

--| Lemma for ~ axlowdim . Establish a congruence result. (Contributed by Scott Fenton, 22-Apr-2013.) (Proof shortened by Mario Carneiro, 22-May-2014.)
theorem axlowdimlem17 (A2 P Q I N X Y: class):
  $ wceq P (cun (csn (cop c3 (cneg c1))) (cxp (cdif (co c1 N cfz) (csn c3)) (csn cc0))) $ >
  $ wceq Q (cun (csn (cop (co I c1 caddc) c1)) (cxp (cdif (co c1 N cfz) (csn (co I c1 caddc))) (csn cc0))) $ >
  $ wceq A2 (cun (cpr (cop c1 X) (cop c2 Y)) (cxp (co c3 N cfz) (csn cc0))) $ >
  $ wcel X cr $ >
  $ wcel Y cr $ >
  $ wi (wa (wcel N (cfv c3 cuz)) (wcel I (co c2 (co N c1 cmin) cfz))) (wbr (cop P A2) (cop Q A2) ccgr) $;

--| The lower dimension axiom for one dimension. In any dimension, there are at least two distinct points. Theorem 3.13 of [Schwabhauser] p. 32, where it is derived from ~ axlowdim2 . (Contributed by Scott Fenton, 22-Apr-2013.)
theorem axlowdim1 {x3 y1: setvar} (N: class):
  $ wi (wcel N cn) (wrex x3 (wrex y1 (wne (cv x3) (cv y1)) (cfv N cee)) (cfv N cee)) $;

--| The lower two-dimensional axiom. In any space where the dimension is greater than one, there are three non-colinear points. Axiom A8 of [Schwabhauser] p. 12. (Contributed by Scott Fenton, 15-Apr-2013.)
theorem axlowdim2 {x3 y1 z: setvar} (N: class):
  $ wi (wcel N (cfv c2 cuz)) (wrex x3 (wrex y1 (wrex z (wn (w3o (wbr (cv x3) (cop (cv y1) (cv z)) cbtwn) (wbr (cv y1) (cop (cv z) (cv x3)) cbtwn) (wbr (cv z) (cop (cv x3) (cv y1)) cbtwn))) (cfv N cee)) (cfv N cee)) (cfv N cee)) $;

--| The general lower dimension axiom. Take a dimension ` N ` greater than or equal to three. Then, there are three non-colinear points in ` N ` dimensional space that are equidistant from ` N - 1 ` distinct points. Derived from remarks in _Tarski's System of Geometry_, Alfred Tarski and Steven Givant, Bulletin of Symbolic Logic, Volume 5, Number 2 (1999), 175-214. (Contributed by Scott Fenton, 22-Apr-2013.)
theorem axlowdim {x3 y1 z i p: setvar} (N: class):
  $ wi (wcel N (cfv c3 cuz)) (wex p (wrex x3 (wrex y1 (wrex z (w3a (wf1 (co c1 (co N c1 cmin) cfz) (cfv N cee) (cv p)) (wral i (w3a (wbr (cop (cfv c1 (cv p)) (cv x3)) (cop (cfv (cv i) (cv p)) (cv x3)) ccgr) (wbr (cop (cfv c1 (cv p)) (cv y1)) (cop (cfv (cv i) (cv p)) (cv y1)) ccgr) (wbr (cop (cfv c1 (cv p)) (cv z)) (cop (cfv (cv i) (cv p)) (cv z)) ccgr)) (co c2 (co N c1 cmin) cfz)) (wn (w3o (wbr (cv x3) (cop (cv y1) (cv z)) cbtwn) (wbr (cv y1) (cop (cv z) (cv x3)) cbtwn) (wbr (cv z) (cop (cv x3) (cv y1)) cbtwn)))) (cfv N cee)) (cfv N cee)) (cfv N cee))) $;

--| Lemma for ~ axeuclid . Handle the algebraic aspects of the theorem. (Contributed by Scott Fenton, 9-Sep-2013.)
theorem axeuclidlem {x3 y1 u i s1 r: setvar} (A2 B2 C P Q T N: class):
  $ wi (w3a (wa (wa (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee))) (wa (wcel C (cfv N cee)) (wcel T (cfv N cee)))) (w3a (wcel P (co cc0 c1 cicc)) (wcel Q (co cc0 c1 cicc)) (wne P cc0)) (wral i (wceq (co (co (co c1 P cmin) (cfv (cv i) A2) cmul) (co P (cfv (cv i) T) cmul) caddc) (co (co (co c1 Q cmin) (cfv (cv i) B2) cmul) (co Q (cfv (cv i) C) cmul) caddc)) (co c1 N cfz))) (wrex x3 (wrex y1 (wrex r (wrex s1 (wrex u (wral i (w3a (wceq (cfv (cv i) B2) (co (co (co c1 (cv r) cmin) (cfv (cv i) A2) cmul) (co (cv r) (cfv (cv i) (cv x3)) cmul) caddc)) (wceq (cfv (cv i) C) (co (co (co c1 (cv s1) cmin) (cfv (cv i) A2) cmul) (co (cv s1) (cfv (cv i) (cv y1)) cmul) caddc)) (wceq (cfv (cv i) T) (co (co (co c1 (cv u) cmin) (cfv (cv i) (cv x3)) cmul) (co (cv u) (cfv (cv i) (cv y1)) cmul) caddc))) (co c1 N cfz)) (co cc0 c1 cicc)) (co cc0 c1 cicc)) (co cc0 c1 cicc)) (cfv N cee)) (cfv N cee)) $;

--| Euclid's axiom. Take an angle ` B A C ` and a point ` D ` between ` B ` and ` C ` . Now, if you extend the segment ` A D ` to a point ` T ` , then ` T ` lies between two points ` x ` and ` y ` that lie on the angle. Axiom A10 of [Schwabhauser] p. 13. (Contributed by Scott Fenton, 9-Sep-2013.)
theorem axeuclid {x3 y1: setvar} (A2 B2 C D T N: class):
  $ wi (w3a (wcel N cn) (w3a (wcel A2 (cfv N cee)) (wcel B2 (cfv N cee)) (wcel C (cfv N cee))) (wa (wcel D (cfv N cee)) (wcel T (cfv N cee)))) (wi (w3a (wbr D (cop A2 T) cbtwn) (wbr D (cop B2 C) cbtwn) (wne A2 D)) (wrex x3 (wrex y1 (w3a (wbr B2 (cop A2 (cv x3)) cbtwn) (wbr C (cop A2 (cv y1)) cbtwn) (wbr T (cop (cv x3) (cv y1)) cbtwn)) (cfv N cee)) (cfv N cee))) $;

--| Lemma for ~ axcont . Change bound variables for later use. (Contributed by Scott Fenton, 20-Jun-2013.)
theorem axcontlem1 {x3 y1 t i j s1: setvar} (D: class i j) (U: class) (F: class x3 y1 t i j s1) (N Z: class):
  $ wceq F (copab x3 t (wa (wcel (cv x3) D) (wa (wcel (cv t) (co cc0 cpnf cico)) (wral i (wceq (cfv (cv i) (cv x3)) (co (co (co c1 (cv t) cmin) (cfv (cv i) Z) cmul) (co (cv t) (cfv (cv i) U) cmul) caddc)) (co c1 N cfz))))) $ >
  $ wceq F (copab y1 s1 (wa (wcel (cv y1) D) (wa (wcel (cv s1) (co cc0 cpnf cico)) (wral j (wceq (cfv (cv j) (cv y1)) (co (co (co c1 (cv s1) cmin) (cfv (cv j) Z) cmul) (co (cv s1) (cfv (cv j) U) cmul) caddc)) (co c1 N cfz))))) $;

--| Lemma for ~ axcont . The idea here is to set up a mapping ` F ` that will allow to transfer ~ dedekind to two sets of points. Here, we set up ` F ` and show its domain and codomain. (Contributed by Scott Fenton, 17-Jun-2013.)
theorem axcontlem2 {x3 t i p: setvar} (D: class i p) (U: class) (F: class x3 t i p) (N Z: class):
  $ wceq D (crab p (wo (wbr U (cop Z (cv p)) cbtwn) (wbr (cv p) (cop Z U) cbtwn)) (cfv N cee)) $ >
  $ wceq F (copab x3 t (wa (wcel (cv x3) D) (wa (wcel (cv t) (co cc0 cpnf cico)) (wral i (wceq (cfv (cv i) (cv x3)) (co (co (co c1 (cv t) cmin) (cfv (cv i) Z) cmul) (co (cv t) (cfv (cv i) U) cmul) caddc)) (co c1 N cfz))))) $ >
  $ wi (wa (w3a (wcel N cn) (wcel Z (cfv N cee)) (wcel U (cfv N cee))) (wne Z U)) (wf1o D (co cc0 cpnf cico) F) $;

--| Lemma for ~ axcont . Given the separation assumption, ` B ` is a subset of ` D ` . (Contributed by Scott Fenton, 18-Jun-2013.)
theorem axcontlem3 {x3 y1 p: setvar} (A2: class y1) (B2: class) (D: class x3 y1 p) (U N Z: class):
  $ wceq D (crab p (wo (wbr U (cop Z (cv p)) cbtwn) (wbr (cv p) (cop Z U) cbtwn)) (cfv N cee)) $ >
  $ wi (wa (wa (wcel N cn) (w3a (wss A2 (cfv N cee)) (wss B2 (cfv N cee)) (wral x3 (wral y1 (wbr (cv x3) (cop Z (cv y1)) cbtwn) B2) A2))) (w3a (wcel Z (cfv N cee)) (wcel U A2) (wne Z U))) (wss B2 D) $;

--| Lemma for ~ axcont . Given the separation assumption, ` A ` is a subset of ` D ` . (Contributed by Scott Fenton, 18-Jun-2013.)
theorem axcontlem4 {x3 y1 p: setvar} (A2: class y1) (B2: class) (D: class x3 y1 p) (U N Z: class):
  $ wceq D (crab p (wo (wbr U (cop Z (cv p)) cbtwn) (wbr (cv p) (cop Z U) cbtwn)) (cfv N cee)) $ >
  $ wi (wa (wa (wcel N cn) (w3a (wss A2 (cfv N cee)) (wss B2 (cfv N cee)) (wral x3 (wral y1 (wbr (cv x3) (cop Z (cv y1)) cbtwn) B2) A2))) (wa (w3a (wcel Z (cfv N cee)) (wcel U A2) (wne B2 c0)) (wne Z U))) (wss A2 D) $;

--| Lemma for ~ axcont . Compute the value of ` F ` . (Contributed by Scott Fenton, 18-Jun-2013.)
theorem axcontlem5 {x3 t i p: setvar} (D: class i p) (P T: class p) (U: class) (F: class x3 t i p) (N Z: class):
  $ wceq D (crab p (wo (wbr U (cop Z (cv p)) cbtwn) (wbr (cv p) (cop Z U) cbtwn)) (cfv N cee)) $ >
  $ wceq F (copab x3 t (wa (wcel (cv x3) D) (wa (wcel (cv t) (co cc0 cpnf cico)) (wral i (wceq (cfv (cv i) (cv x3)) (co (co (co c1 (cv t) cmin) (cfv (cv i) Z) cmul) (co (cv t) (cfv (cv i) U) cmul) caddc)) (co c1 N cfz))))) $ >
  $ wi (wa (wa (w3a (wcel N cn) (wcel Z (cfv N cee)) (wcel U (cfv N cee))) (wne Z U)) (wcel P D)) (wb (wceq (cfv P F) T) (wa (wcel T (co cc0 cpnf cico)) (wral i (wceq (cfv (cv i) P) (co (co (co c1 T cmin) (cfv (cv i) Z) cmul) (co T (cfv (cv i) U) cmul) caddc)) (co c1 N cfz)))) $;

--| Lemma for ~ axcont . State the defining properties of the value of ` F ` . (Contributed by Scott Fenton, 19-Jun-2013.)
theorem axcontlem6 {x3 t i p: setvar} (D: class i p) (P: class p) (U: class) (F: class x3 t p) (N Z: class):
  $ wceq D (crab p (wo (wbr U (cop Z (cv p)) cbtwn) (wbr (cv p) (cop Z U) cbtwn)) (cfv N cee)) $ >
  $ wceq F (copab x3 t (wa (wcel (cv x3) D) (wa (wcel (cv t) (co cc0 cpnf cico)) (wral i (wceq (cfv (cv i) (cv x3)) (co (co (co c1 (cv t) cmin) (cfv (cv i) Z) cmul) (co (cv t) (cfv (cv i) U) cmul) caddc)) (co c1 N cfz))))) $ >
  $ wi (wa (wa (w3a (wcel N cn) (wcel Z (cfv N cee)) (wcel U (cfv N cee))) (wne Z U)) (wcel P D)) (wa (wcel (cfv P F) (co cc0 cpnf cico)) (wral i (wceq (cfv (cv i) P) (co (co (co c1 (cfv P F) cmin) (cfv (cv i) Z) cmul) (co (cfv P F) (cfv (cv i) U) cmul) caddc)) (co c1 N cfz))) $;

--| Lemma for ~ axcont . Given two points in ` D ` , one preceeds the other iff its scaling constant is less than the other point's. (Contributed by Scott Fenton, 18-Jun-2013.)
theorem axcontlem7 {x3 t i p: setvar} (D: class i p) (P Q: class p) (U: class) (F: class x3 p) (N Z: class):
  $ wceq D (crab p (wo (wbr U (cop Z (cv p)) cbtwn) (wbr (cv p) (cop Z U) cbtwn)) (cfv N cee)) $ >
  $ wceq F (copab x3 t (wa (wcel (cv x3) D) (wa (wcel (cv t) (co cc0 cpnf cico)) (wral i (wceq (cfv (cv i) (cv x3)) (co (co (co c1 (cv t) cmin) (cfv (cv i) Z) cmul) (co (cv t) (cfv (cv i) U) cmul) caddc)) (co c1 N cfz))))) $ >
  $ wi (wa (wa (w3a (wcel N cn) (wcel Z (cfv N cee)) (wcel U (cfv N cee))) (wne Z U)) (wa (wcel P D) (wcel Q D))) (wb (wbr P (cop Z Q) cbtwn) (wbr (cfv P F) (cfv Q F) cle)) $;

--| Lemma for ~ axcont . A point in ` D ` is between two others if its function value falls in the middle. (Contributed by Scott Fenton, 18-Jun-2013.)
theorem axcontlem8 {x3 t i p: setvar} (D: class i) (P Q R U: class) (F: class x3) (N Z: class):
  $ wceq D (crab p (wo (wbr U (cop Z (cv p)) cbtwn) (wbr (cv p) (cop Z U) cbtwn)) (cfv N cee)) $ >
  $ wceq F (copab x3 t (wa (wcel (cv x3) D) (wa (wcel (cv t) (co cc0 cpnf cico)) (wral i (wceq (cfv (cv i) (cv x3)) (co (co (co c1 (cv t) cmin) (cfv (cv i) Z) cmul) (co (cv t) (cfv (cv i) U) cmul) caddc)) (co c1 N cfz))))) $ >
  $ wi (wa (wa (w3a (wcel N cn) (wcel Z (cfv N cee)) (wcel U (cfv N cee))) (wne Z U)) (w3a (wcel P D) (wcel Q D) (wcel R D))) (wi (wa (wbr (cfv P F) (cfv Q F) cle) (wbr (cfv Q F) (cfv R F) cle)) (wbr Q (cop P R) cbtwn)) $;

--| Lemma for ~ axcont . Given the separation assumption, all values of ` F ` over ` A ` are less than or equal to all values of ` F ` over ` B ` . (Contributed by Scott Fenton, 20-Jun-2013.)
theorem axcontlem9 {x3 y1 t i m n p: setvar} (A2: class y1 t i) (B2: class t i) (D: class y1 i m n p) (U: class) (F: class x3 y1 n) (N Z: class):
  $ wceq D (crab p (wo (wbr U (cop Z (cv p)) cbtwn) (wbr (cv p) (cop Z U) cbtwn)) (cfv N cee)) $ >
  $ wceq F (copab x3 t (wa (wcel (cv x3) D) (wa (wcel (cv t) (co cc0 cpnf cico)) (wral i (wceq (cfv (cv i) (cv x3)) (co (co (co c1 (cv t) cmin) (cfv (cv i) Z) cmul) (co (cv t) (cfv (cv i) U) cmul) caddc)) (co c1 N cfz))))) $ >
  $ wi (wa (wa (wcel N cn) (w3a (wss A2 (cfv N cee)) (wss B2 (cfv N cee)) (wral x3 (wral y1 (wbr (cv x3) (cop Z (cv y1)) cbtwn) B2) A2))) (wa (w3a (wcel Z (cfv N cee)) (wcel U A2) (wne B2 c0)) (wne Z U))) (wral n (wral m (wbr (cv n) (cv m) cle) (cima F B2)) (cima F A2)) $;

--| Lemma for ~ axcont . Given a handful of assumptions, derive the conclusion of the final theorem. (Contributed by Scott Fenton, 20-Jun-2013.)
theorem axcontlem10 {x3 y1 t i p b: setvar} (A2: class y1 t i) (B2: class t i) (D: class y1 i b) (U F N Z: class):
  $ wceq D (crab p (wo (wbr U (cop Z (cv p)) cbtwn) (wbr (cv p) (cop Z U) cbtwn)) (cfv N cee)) $ >
  $ wceq F (copab x3 t (wa (wcel (cv x3) D) (wa (wcel (cv t) (co cc0 cpnf cico)) (wral i (wceq (cfv (cv i) (cv x3)) (co (co (co c1 (cv t) cmin) (cfv (cv i) Z) cmul) (co (cv t) (cfv (cv i) U) cmul) caddc)) (co c1 N cfz))))) $ >
  $ wi (wa (wa (wcel N cn) (w3a (wss A2 (cfv N cee)) (wss B2 (cfv N cee)) (wral x3 (wral y1 (wbr (cv x3) (cop Z (cv y1)) cbtwn) B2) A2))) (wa (w3a (wcel Z (cfv N cee)) (wcel U A2) (wne B2 c0)) (wne Z U))) (wrex b (wral x3 (wral y1 (wbr (cv b) (cop (cv x3) (cv y1)) cbtwn) B2) A2) (cfv N cee)) $;

--| Lemma for ~ axcont . Eliminate the hypotheses from ~ axcontlem10 . (Contributed by Scott Fenton, 20-Jun-2013.)
theorem axcontlem11 {x3 y1 b: setvar} (A2: class y1) (B2 U N Z: class):
  $ wi (wa (wa (wcel N cn) (w3a (wss A2 (cfv N cee)) (wss B2 (cfv N cee)) (wral x3 (wral y1 (wbr (cv x3) (cop Z (cv y1)) cbtwn) B2) A2))) (wa (w3a (wcel Z (cfv N cee)) (wcel U A2) (wne B2 c0)) (wne Z U))) (wrex b (wral x3 (wral y1 (wbr (cv b) (cop (cv x3) (cv y1)) cbtwn) B2) A2) (cfv N cee)) $;

--| Lemma for ~ axcont . Eliminate the trivial cases from the previous lemmas. (Contributed by Scott Fenton, 20-Jun-2013.)
theorem axcontlem12 {x3 y1 b: setvar} (A2: class y1) (B2 N Z: class):
  $ wi (wa (wa (wcel N cn) (w3a (wss A2 (cfv N cee)) (wss B2 (cfv N cee)) (wral x3 (wral y1 (wbr (cv x3) (cop Z (cv y1)) cbtwn) B2) A2))) (wcel Z (cfv N cee))) (wrex b (wral x3 (wral y1 (wbr (cv b) (cop (cv x3) (cv y1)) cbtwn) B2) A2) (cfv N cee)) $;

--| The axiom of continuity. Take two sets of points ` A ` and ` B ` . If all the points in ` A ` come before the points of ` B ` on a line, then there is a point separating the two. Axiom A11 of [Schwabhauser] p. 13. (Contributed by Scott Fenton, 20-Jun-2013.)
theorem axcont {x3 y1 a b: setvar} (A2 B2 N: class):
  $ wi (wa (wcel N cn) (w3a (wss A2 (cfv N cee)) (wss B2 (cfv N cee)) (wrex a (wral x3 (wral y1 (wbr (cv x3) (cop (cv a) (cv y1)) cbtwn) B2) A2) (cfv N cee)))) (wrex b (wral x3 (wral y1 (wbr (cv b) (cop (cv x3) (cv y1)) cbtwn) B2) A2) (cfv N cee)) $;

--| Extends class notation with the Tarski geometry structure for ` EE ^ N ` .
term ceeng: class;

--| Define the geometry structure for ` EE ^ N ` . (Contributed by Thierry Arnoux, 24-Aug-2017.)
axiom df_eeng {x3 y1 z i n: setvar}:
  $ wceq ceeng (cmpt n cn (cun (cpr (cop (cfv cnx cbs) (cfv (cv n) cee)) (cop (cfv cnx cds) (cmpo x3 y1 (cfv (cv n) cee) (cfv (cv n) cee) (csu i (co c1 (cv n) cfz) (co (co (cfv (cv i) (cv x3)) (cfv (cv i) (cv y1)) cmin) c2 cexp))))) (cpr (cop (cfv cnx citv) (cmpo x3 y1 (cfv (cv n) cee) (cfv (cv n) cee) (crab z (wbr (cv z) (cop (cv x3) (cv y1)) cbtwn) (cfv (cv n) cee)))) (cop (cfv cnx clng) (cmpo x3 y1 (cfv (cv n) cee) (cdif (cfv (cv n) cee) (csn (cv x3))) (crab z (w3o (wbr (cv z) (cop (cv x3) (cv y1)) cbtwn) (wbr (cv x3) (cop (cv z) (cv y1)) cbtwn) (wbr (cv y1) (cop (cv x3) (cv z)) cbtwn)) (cfv (cv n) cee))))))) $;

--| The value of the Euclidean geometry for dimension ` N ` . (Contributed by Thierry Arnoux, 15-Mar-2019.)
theorem eengv {x3 y1 z i: setvar} (N: class):
  $ wi (wcel N cn) (wceq (cfv N ceeng) (cun (cpr (cop (cfv cnx cbs) (cfv N cee)) (cop (cfv cnx cds) (cmpo x3 y1 (cfv N cee) (cfv N cee) (csu i (co c1 N cfz) (co (co (cfv (cv i) (cv x3)) (cfv (cv i) (cv y1)) cmin) c2 cexp))))) (cpr (cop (cfv cnx citv) (cmpo x3 y1 (cfv N cee) (cfv N cee) (crab z (wbr (cv z) (cop (cv x3) (cv y1)) cbtwn) (cfv N cee)))) (cop (cfv cnx clng) (cmpo x3 y1 (cfv N cee) (cdif (cfv N cee) (csn (cv x3))) (crab z (w3o (wbr (cv z) (cop (cv x3) (cv y1)) cbtwn) (wbr (cv x3) (cop (cv z) (cv y1)) cbtwn) (wbr (cv y1) (cop (cv x3) (cv z)) cbtwn)) (cfv N cee))))))) $;

--| The Euclidean geometry as a structure. (Contributed by Thierry Arnoux, 15-Mar-2019.)
theorem eengstr (N: class):
  $ wi (wcel N cn) (wbr (cfv N ceeng) (cop c1 (cdc c1 c7)) cstr) $;

--| The Base of the Euclidean geometry. (Contributed by Thierry Arnoux, 15-Mar-2019.)
theorem eengbas (N: class):
  $ wi (wcel N cn) (wceq (cfv N cee) (cfv (cfv N ceeng) cbs)) $;

--| The betweenness relation used in the Tarski structure for the Euclidean geometry is the same as ` Btwn ` . (Contributed by Thierry Arnoux, 15-Mar-2019.)
theorem ebtwntg (ph: wff) (P I N X Y Z: class):
  $ wi ph (wcel N cn) $ >
  $ wceq P (cfv (cfv N ceeng) cbs) $ >
  $ wceq I (cfv (cfv N ceeng) citv) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wb (wbr Z (cop X Y) cbtwn) (wcel Z (co X Y I))) $;

--| The congruence relation used in the Tarski structure for the Euclidean geometry is the same as ` Cgr ` . (Contributed by Thierry Arnoux, 15-Mar-2019.)
theorem ecgrtg (ph: wff) (A2 B2 C D P c_mi N: class):
  $ wi ph (wcel N cn) $ >
  $ wceq P (cfv (cfv N ceeng) cbs) $ >
  $ wceq c_mi (cfv (cfv N ceeng) cds) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wb (wbr (cop A2 B2) (cop C D) ccgr) (wceq (co A2 B2 c_mi) (co C D c_mi))) $;

--| The line definition in the Tarski structure for the Euclidean geometry. (Contributed by Thierry Arnoux, 7-Apr-2019.)
theorem elntg {x3 y1 z: setvar} (P: class x3 y1) (I: class x3 y1 z) (N: class):
  $ wceq P (cfv (cfv N ceeng) cbs) $ >
  $ wceq I (cfv (cfv N ceeng) citv) $ >
  $ wi (wcel N cn) (wceq (cfv (cfv N ceeng) clng) (cmpo x3 y1 P (cdif P (csn (cv x3))) (crab z (w3o (wcel (cv z) (co (cv x3) (cv y1) I)) (wcel (cv x3) (co (cv z) (cv y1) I)) (wcel (cv y1) (co (cv x3) (cv z) I))) P))) $;

--| The line definition in the Tarski structure for the Euclidean geometry. In contrast to ~ elntg , the betweenness can be strengthened by excluding ` 1 ` resp. ` 0 ` from the related intervals (because of ` x =/= y ` ). (Contributed by AV, 14-Feb-2023.)
theorem elntg2 {x3 y1 i k m p l: setvar} (P: class x3 y1 k m l) (I: class x3 y1 k m p l) (N: class):
  $ wceq P (cfv (cfv N ceeng) cbs) $ >
  $ wceq I (co c1 N cfz) $ >
  $ wi (wcel N cn) (wceq (cfv (cfv N ceeng) clng) (cmpo x3 y1 P (cdif P (csn (cv x3))) (crab p (w3o (wrex k (wral i (wceq (cfv (cv i) (cv p)) (co (co (co c1 (cv k) cmin) (cfv (cv i) (cv x3)) cmul) (co (cv k) (cfv (cv i) (cv y1)) cmul) caddc)) I) (co cc0 c1 cicc)) (wrex l (wral i (wceq (cfv (cv i) (cv x3)) (co (co (co c1 (cv l) cmin) (cfv (cv i) (cv p)) cmul) (co (cv l) (cfv (cv i) (cv y1)) cmul) caddc)) I) (co cc0 c1 cico)) (wrex m (wral i (wceq (cfv (cv i) (cv y1)) (co (co (co c1 (cv m) cmin) (cfv (cv i) (cv x3)) cmul) (co (cv m) (cfv (cv i) (cv p)) cmul) caddc)) I) (co cc0 c1 cioc))) P))) $;

--| The geometry structure for ` EE ^ N ` is a Tarski geometry. (Contributed by Thierry Arnoux, 15-Mar-2019.)
theorem eengtrkg (N: class):
  $ wi (wcel N cn) (wcel (cfv N ceeng) cstrkg) $;

--| The geometry structure for ` EE ^ N ` is a Euclidean geometry. (Contributed by Thierry Arnoux, 15-Mar-2019.)
theorem eengtrkge (N: class):
  $ wi (wcel N cn) (wcel (cfv N ceeng) cstrkge) $;

--| Extend class notation with an edge function.
term cedgf: class;

--| Define the edge function (indexed edges) of a graph. (Contributed by AV, 18-Jan-2020.) Use its index-independent form ~ edgfid instead. (New usage is discouraged.)
axiom df_edgf:
  $ wceq cedgf (cslot (cdc c1 c8)) $;

--| Utility theorem: index-independent form of ~ df-edgf . (Contributed by AV, 16-Nov-2021.)
theorem edgfid:
  $ wceq cedgf (cslot (cfv cnx cedgf)) $;

--| Index value of the ~ df-edgf slot. (Contributed by AV, 13-Oct-2024.) (New usage is discouraged.)
theorem edgfndx:
  $ wceq (cfv cnx cedgf) (cdc c1 c8) $;

--| The index value of the edge function extractor is a positive integer. This property should be ensured for every concrete coding because otherwise it could not be used in an extensible structure (slots must be positive integers). (Contributed by AV, 21-Sep-2020.) (Proof shortened by AV, 13-Oct-2024.)
theorem edgfndxnn:
  $ wcel (cfv cnx cedgf) cn $;

--| The value of the edge function extractor is the value of the corresponding slot of the structure. (Contributed by AV, 21-Sep-2020.) (Proof shortened by AV, 28-Oct-2024.)
theorem edgfndxid (G V: class):
  $ wi (wcel G V) (wceq (cfv G cedgf) (cfv (cfv cnx cedgf) G)) $;

--| The index value of the ` Base ` slot is less than the index value of the ` .ef ` slot. (Contributed by AV, 21-Sep-2020.) (Proof shortened by AV, 30-Oct-2024.)
theorem basendxltedgfndx:
  $ wbr (cfv cnx cbs) (cfv cnx cedgf) clt $;

--| The slots ` Base ` and ` .ef ` are different. (Contributed by AV, 21-Sep-2020.)
theorem basendxnedgfndx:
  $ wne (cfv cnx cbs) (cfv cnx cedgf) $;

--| Extend class notation with the vertices of "graphs".
term cvtx: class;

--| Extend class notation with the indexed edges of "graphs".
term ciedg: class;

--| Define the function mapping a graph to the set of its vertices. This definition is very general: It defines the set of vertices for any ordered pair as its first component, and for any other class as its "base set". It is meaningful, however, only if the ordered pair represents a graph resp. the class is an extensible structure representing a graph. (Contributed by AV, 9-Jan-2020.) (Revised by AV, 20-Sep-2020.)
axiom df_vtx {g2: setvar}:
  $ wceq cvtx (cmpt g2 cvv (cif (wcel (cv g2) (cxp cvv cvv)) (cfv (cv g2) c1st) (cfv (cv g2) cbs))) $;

--| Define the function mapping a graph to its indexed edges. This definition is very general: It defines the indexed edges for any ordered pair as its second component, and for any other class as its "edge function". It is meaningful, however, only if the ordered pair represents a graph resp. the class is an extensible structure (containing a slot for "edge functions") representing a graph. (Contributed by AV, 20-Sep-2020.)
axiom df_iedg {g2: setvar}:
  $ wceq ciedg (cmpt g2 cvv (cif (wcel (cv g2) (cxp cvv cvv)) (cfv (cv g2) c2nd) (cfv (cv g2) cedgf))) $;

--| The set of vertices of a graph. (Contributed by AV, 9-Jan-2020.) (Revised by AV, 21-Sep-2020.)
theorem vtxval (G: class):
  $ wceq (cfv G cvtx) (cif (wcel G (cxp cvv cvv)) (cfv G c1st) (cfv G cbs)) $;

--| The set of indexed edges of a graph. (Contributed by AV, 21-Sep-2020.)
theorem iedgval (G: class):
  $ wceq (cfv G ciedg) (cif (wcel G (cxp cvv cvv)) (cfv G c2nd) (cfv G cedgf)) $;

--| A graph with at least one vertex is a set. (Contributed by AV, 2-Mar-2021.)
theorem _1vgrex (G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel N V) (wcel G cvv) $;

--| The set of vertices of a graph represented as an ordered pair of vertices and indexed edges. (Contributed by AV, 9-Jan-2020.) (Revised by AV, 21-Sep-2020.)
theorem opvtxval (G: class):
  $ wi (wcel G (cxp cvv cvv)) (wceq (cfv G cvtx) (cfv G c1st)) $;

--| The set of vertices of a graph represented as an ordered pair of vertices and indexed edges as function value. (Contributed by AV, 21-Sep-2020.)
theorem opvtxfv (E V X Y: class):
  $ wi (wa (wcel V X) (wcel E Y)) (wceq (cfv (cop V E) cvtx) V) $;

--| The set of vertices of a graph represented as an ordered pair of vertices and indexed edges as operation value. (Contributed by AV, 21-Sep-2020.)
theorem opvtxov (E V X Y: class):
  $ wi (wa (wcel V X) (wcel E Y)) (wceq (co V E cvtx) V) $;

--| The set of indexed edges of a graph represented as an ordered pair of vertices and indexed edges. (Contributed by AV, 21-Sep-2020.)
theorem opiedgval (G: class):
  $ wi (wcel G (cxp cvv cvv)) (wceq (cfv G ciedg) (cfv G c2nd)) $;

--| The set of indexed edges of a graph represented as an ordered pair of vertices and indexed edges as function value. (Contributed by AV, 21-Sep-2020.)
theorem opiedgfv (E V X Y: class):
  $ wi (wa (wcel V X) (wcel E Y)) (wceq (cfv (cop V E) ciedg) E) $;

--| The set of indexed edges of a graph represented as an ordered pair of vertices and indexed edges as operation value. (Contributed by AV, 21-Sep-2020.)
theorem opiedgov (E V X Y: class):
  $ wi (wa (wcel V X) (wcel E Y)) (wceq (co V E ciedg) E) $;

--| The set of vertices of a graph represented as an ordered pair of vertices and indexed edges as function value. (Contributed by AV, 4-Mar-2021.)
theorem opvtxfvi (E V: class):
  $ wcel V cvv $ >
  $ wcel E cvv $ >
  $ wceq (cfv (cop V E) cvtx) V $;

--| The set of indexed edges of a graph represented as an ordered pair of vertices and indexed edges as function value. (Contributed by AV, 4-Mar-2021.)
theorem opiedgfvi (E V: class):
  $ wcel V cvv $ >
  $ wcel E cvv $ >
  $ wceq (cfv (cop V E) ciedg) E $;

--| The set of vertices of an extensible structure with (at least) two slots. (Contributed by AV, 12-Oct-2020.) (Revised by AV, 7-Jun-2021.) (Revised by AV, 12-Nov-2021.)
theorem funvtxdmge2val (G: class):
  $ wi (wa (wfun (cdif G (csn c0))) (wbr c2 (cfv (cdm G) chash) cle)) (wceq (cfv G cvtx) (cfv G cbs)) $;

--| The set of indexed edges of an extensible structure with (at least) two slots. (Contributed by AV, 12-Oct-2020.) (Revised by AV, 7-Jun-2021.) (Revised by AV, 12-Nov-2021.)
theorem funiedgdmge2val (G: class):
  $ wi (wa (wfun (cdif G (csn c0))) (wbr c2 (cfv (cdm G) chash) cle)) (wceq (cfv G ciedg) (cfv G cedgf)) $;

--| The set of vertices of an extensible structure with (at least) two slots. (Contributed by AV, 22-Sep-2020.) (Revised by AV, 7-Jun-2021.) (Revised by AV, 12-Nov-2021.)
theorem funvtxdm2val (A2 B2 G: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (w3a (wfun (cdif G (csn c0))) (wne A2 B2) (wss (cpr A2 B2) (cdm G))) (wceq (cfv G cvtx) (cfv G cbs)) $;

--| The set of indexed edges of an extensible structure with (at least) two slots. (Contributed by AV, 22-Sep-2020.) (Revised by AV, 7-Jun-2021.) (Revised by AV, 12-Nov-2021.)
theorem funiedgdm2val (A2 B2 G: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (w3a (wfun (cdif G (csn c0))) (wne A2 B2) (wss (cpr A2 B2) (cdm G))) (wceq (cfv G ciedg) (cfv G cedgf)) $;

--| The set of vertices of an extensible structure with a base set and (at least) another slot. (Contributed by AV, 22-Sep-2020.) (Revised by AV, 7-Jun-2021.) (Revised by AV, 12-Nov-2021.)
theorem funvtxval0 (S G: class):
  $ wcel S cvv $ >
  $ wi (w3a (wfun (cdif G (csn c0))) (wne S (cfv cnx cbs)) (wss (cpr (cfv cnx cbs) S) (cdm G))) (wceq (cfv G cvtx) (cfv G cbs)) $;

--| The set of vertices of a graph represented as an extensible structure with the set of vertices as base set. (Contributed by AV, 14-Oct-2020.) (Revised by AV, 12-Nov-2021.)
theorem basvtxval (ph: wff) (G V X Y: class):
  $ wi ph (wbr G X cstr) $ >
  $ wi ph (wbr c2 (cfv (cdm G) chash) cle) $ >
  $ wi ph (wcel V Y) $ >
  $ wi ph (wcel (cop (cfv cnx cbs) V) G) $ >
  $ wi ph (wceq (cfv G cvtx) V) $;

--| The set of indexed edges of a graph represented as an extensible structure with the indexed edges in the slot for edge functions. (Contributed by AV, 14-Oct-2020.) (Revised by AV, 12-Nov-2021.)
theorem edgfiedgval (ph: wff) (E G X Y: class):
  $ wi ph (wbr G X cstr) $ >
  $ wi ph (wbr c2 (cfv (cdm G) chash) cle) $ >
  $ wi ph (wcel E Y) $ >
  $ wi ph (wcel (cop (cfv cnx cedgf) E) G) $ >
  $ wi ph (wceq (cfv G ciedg) E) $;

--| The set of vertices of a graph represented as an extensible structure with vertices as base set and indexed edges. (Contributed by AV, 22-Sep-2020.) (Revised by AV, 7-Jun-2021.) (Revised by AV, 12-Nov-2021.)
theorem funvtxval (G: class):
  $ wi (wa (wfun (cdif G (csn c0))) (wss (cpr (cfv cnx cbs) (cfv cnx cedgf)) (cdm G))) (wceq (cfv G cvtx) (cfv G cbs)) $;

--| The set of indexed edges of a graph represented as an extensible structure with vertices as base set and indexed edges. (Contributed by AV, 21-Sep-2020.) (Revised by AV, 7-Jun-2021.) (Revised by AV, 12-Nov-2021.)
theorem funiedgval (G: class):
  $ wi (wa (wfun (cdif G (csn c0))) (wss (cpr (cfv cnx cbs) (cfv cnx cedgf)) (cdm G))) (wceq (cfv G ciedg) (cfv G cedgf)) $;

--| Lemma for ~ structvtxval and ~ structiedg0val . (Contributed by AV, 23-Sep-2020.) (Revised by AV, 12-Nov-2021.)
theorem structvtxvallem (S E G V X Y: class):
  $ wcel S cn $ >
  $ wbr (cfv cnx cbs) S clt $ >
  $ wceq G (cpr (cop (cfv cnx cbs) V) (cop S E)) $ >
  $ wi (wa (wcel V X) (wcel E Y)) (wbr c2 (cfv (cdm G) chash) cle) $;

--| The set of vertices of an extensible structure with a base set and another slot. (Contributed by AV, 23-Sep-2020.) (Proof shortened by AV, 12-Nov-2021.)
theorem structvtxval (S E G V X Y: class):
  $ wcel S cn $ >
  $ wbr (cfv cnx cbs) S clt $ >
  $ wceq G (cpr (cop (cfv cnx cbs) V) (cop S E)) $ >
  $ wi (wa (wcel V X) (wcel E Y)) (wceq (cfv G cvtx) V) $;

--| The set of indexed edges of an extensible structure with a base set and another slot not being the slot for edge functions is empty. (Contributed by AV, 23-Sep-2020.) (Proof shortened by AV, 12-Nov-2021.)
theorem structiedg0val (S E G V X Y: class):
  $ wcel S cn $ >
  $ wbr (cfv cnx cbs) S clt $ >
  $ wceq G (cpr (cop (cfv cnx cbs) V) (cop S E)) $ >
  $ wi (w3a (wcel V X) (wcel E Y) (wne S (cfv cnx cedgf))) (wceq (cfv G ciedg) c0) $;

--| Lemma for ~ structgrssvtx and ~ structgrssiedg . (Contributed by AV, 14-Oct-2020.) (Proof shortened by AV, 12-Nov-2021.)
theorem structgrssvtxlem (ph: wff) (E G V X Y Z: class):
  $ wi ph (wbr G X cstr) $ >
  $ wi ph (wcel V Y) $ >
  $ wi ph (wcel E Z) $ >
  $ wi ph (wss (cpr (cop (cfv cnx cbs) V) (cop (cfv cnx cedgf) E)) G) $ >
  $ wi ph (wbr c2 (cfv (cdm G) chash) cle) $;

--| The set of vertices of a graph represented as an extensible structure with vertices as base set and indexed edges. (Contributed by AV, 14-Oct-2020.) (Proof shortened by AV, 12-Nov-2021.)
theorem structgrssvtx (ph: wff) (E G V X Y Z: class):
  $ wi ph (wbr G X cstr) $ >
  $ wi ph (wcel V Y) $ >
  $ wi ph (wcel E Z) $ >
  $ wi ph (wss (cpr (cop (cfv cnx cbs) V) (cop (cfv cnx cedgf) E)) G) $ >
  $ wi ph (wceq (cfv G cvtx) V) $;

--| The set of indexed edges of a graph represented as an extensible structure with vertices as base set and indexed edges. (Contributed by AV, 14-Oct-2020.) (Proof shortened by AV, 12-Nov-2021.)
theorem structgrssiedg (ph: wff) (E G V X Y Z: class):
  $ wi ph (wbr G X cstr) $ >
  $ wi ph (wcel V Y) $ >
  $ wi ph (wcel E Z) $ >
  $ wi ph (wss (cpr (cop (cfv cnx cbs) V) (cop (cfv cnx cedgf) E)) G) $ >
  $ wi ph (wceq (cfv G ciedg) E) $;

--| A graph represented as an extensible structure with vertices as base set and indexed edges is actually an extensible structure. (Contributed by AV, 23-Nov-2020.)
theorem struct2grstr (E G V: class):
  $ wceq G (cpr (cop (cfv cnx cbs) V) (cop (cfv cnx cedgf) E)) $ >
  $ wbr G (cop (cfv cnx cbs) (cfv cnx cedgf)) cstr $;

--| The set of vertices of a graph represented as an extensible structure with vertices as base set and indexed edges. (Contributed by AV, 23-Sep-2020.)
theorem struct2grvtx (E G V X Y: class):
  $ wceq G (cpr (cop (cfv cnx cbs) V) (cop (cfv cnx cedgf) E)) $ >
  $ wi (wa (wcel V X) (wcel E Y)) (wceq (cfv G cvtx) V) $;

--| The set of indexed edges of a graph represented as an extensible structure with vertices as base set and indexed edges. (Contributed by AV, 23-Sep-2020.) (Proof shortened by AV, 12-Nov-2021.)
theorem struct2griedg (E G V X Y: class):
  $ wceq G (cpr (cop (cfv cnx cbs) V) (cop (cfv cnx cedgf) E)) $ >
  $ wi (wa (wcel V X) (wcel E Y)) (wceq (cfv G ciedg) E) $;

--| Any representation of a graph ` G ` (especially as extensible structure ` G = { <. ( Base `` ndx ) , V >. , <. ( .ef `` ndx ) , E >. } ` ) is convertible in a representation of the graph as ordered pair. (Contributed by AV, 7-Oct-2020.)
theorem graop (G H: class):
  $ wceq H (cop (cfv G cvtx) (cfv G ciedg)) $ >
  $ wa (wceq (cfv G cvtx) (cfv H cvtx)) (wceq (cfv G ciedg) (cfv H ciedg)) $;

--| Any representation of a graph ` G ` (especially as ordered pair ` G = <. V , E >. ` ) is convertible in a representation of the graph as extensible structure. (Contributed by AV, 8-Oct-2020.)
theorem grastruct (G H: class):
  $ wceq H (cpr (cop (cfv cnx cbs) (cfv G cvtx)) (cop (cfv cnx cedgf) (cfv G ciedg))) $ >
  $ wa (wceq (cfv G cvtx) (cfv H cvtx)) (wceq (cfv G ciedg) (cfv H ciedg)) $;

--| If any representation of a graph with vertices ` V ` and edges ` E ` has a certain property ` ps ` , then the ordered pair ` <. V , E >. ` of the set of vertices and the set of edges (which is such a representation of a graph with vertices ` V ` and edges ` E ` ) has this property. (Contributed by AV, 11-Oct-2020.)
theorem gropd {g2: setvar} (ph: wff) (ps: wff g2) (U: class g2) (E V: class) (W: class g2):
  $ wi ph (wal g2 (wi (wa (wceq (cfv (cv g2) cvtx) V) (wceq (cfv (cv g2) ciedg) E)) ps)) $ >
  $ wi ph (wcel V U) $ >
  $ wi ph (wcel E W) $ >
  $ wi ph (wsbc g2 ps (cop V E)) $;

--| If any representation of a graph with vertices ` V ` and edges ` E ` has a certain property ` ps ` , then any structure with base set ` V ` and value ` E ` in the slot for edge functions (which is such a representation of a graph with vertices ` V ` and edges ` E ` ) has this property. (Contributed by AV, 12-Oct-2020.) (Revised by AV, 9-Jun-2021.)
theorem grstructd {g2: setvar} (ph: wff) (ps: wff g2) (S: class) (U: class g2) (E V: class) (W X: class g2):
  $ wi ph (wal g2 (wi (wa (wceq (cfv (cv g2) cvtx) V) (wceq (cfv (cv g2) ciedg) E)) ps)) $ >
  $ wi ph (wcel V U) $ >
  $ wi ph (wcel E W) $ >
  $ wi ph (wcel S X) $ >
  $ wi ph (wfun (cdif S (csn c0))) $ >
  $ wi ph (wbr c2 (cfv (cdm S) chash) cle) $ >
  $ wi ph (wceq (cfv S cbs) V) $ >
  $ wi ph (wceq (cfv S cedgf) E) $ >
  $ wi ph (wsbc g2 ps S) $;

--| If any representation of a graph with vertices ` V ` and edges ` E ` is an element of an arbitrary class ` C ` , then the ordered pair ` <. V , E >. ` of the set of vertices and the set of edges (which is such a representation of a graph with vertices ` V ` and edges ` E ` ) is an element of this class ` C ` . (Contributed by AV, 11-Oct-2020.)
theorem gropeld {g2: setvar} (ph: wff) (C: class) (U: class g2) (E V: class) (W: class g2):
  $ wi ph (wal g2 (wi (wa (wceq (cfv (cv g2) cvtx) V) (wceq (cfv (cv g2) ciedg) E)) (wcel (cv g2) C))) $ >
  $ wi ph (wcel V U) $ >
  $ wi ph (wcel E W) $ >
  $ wi ph (wcel (cop V E) C) $;

--| If any representation of a graph with vertices ` V ` and edges ` E ` is an element of an arbitrary class ` C ` , then any structure with base set ` V ` and value ` E ` in the slot for edge functions (which is such a representation of a graph with vertices ` V ` and edges ` E ` ) is an element of this class ` C ` . (Contributed by AV, 12-Oct-2020.) (Revised by AV, 9-Jun-2021.)
theorem grstructeld {g2: setvar} (ph: wff) (C S: class) (U: class g2) (E V: class) (W X: class g2):
  $ wi ph (wal g2 (wi (wa (wceq (cfv (cv g2) cvtx) V) (wceq (cfv (cv g2) ciedg) E)) (wcel (cv g2) C))) $ >
  $ wi ph (wcel V U) $ >
  $ wi ph (wcel E W) $ >
  $ wi ph (wcel S X) $ >
  $ wi ph (wfun (cdif S (csn c0))) $ >
  $ wi ph (wbr c2 (cfv (cdm S) chash) cle) $ >
  $ wi ph (wceq (cfv S cbs) V) $ >
  $ wi ph (wceq (cfv S cedgf) E) $ >
  $ wi ph (wcel S C) $;

--| The vertices of a structure with a base set and an inserted resp. replaced slot for the edge function. (Contributed by AV, 18-Jan-2020.) (Revised by AV, 16-Nov-2021.)
theorem setsvtx (ph: wff) (E G I W X: class):
  $ wceq I (cfv cnx cedgf) $ >
  $ wi ph (wbr G X cstr) $ >
  $ wi ph (wcel (cfv cnx cbs) (cdm G)) $ >
  $ wi ph (wcel E W) $ >
  $ wi ph (wceq (cfv (co G (cop I E) csts) cvtx) (cfv G cbs)) $;

--| The (indexed) edges of a structure with a base set and an inserted resp. replaced slot for the edge function. (Contributed by AV, 7-Jun-2021.) (Revised by AV, 16-Nov-2021.)
theorem setsiedg (ph: wff) (E G I W X: class):
  $ wceq I (cfv cnx cedgf) $ >
  $ wi ph (wbr G X cstr) $ >
  $ wi ph (wcel (cfv cnx cbs) (cdm G)) $ >
  $ wi ph (wcel E W) $ >
  $ wi ph (wceq (cfv (co G (cop I E) csts) ciedg) E) $;

--| The set of vertices of a graph without edges represented as an extensible structure with vertices as base set and no indexed edges. See ~ vtxvalsnop for the (degenerate) case where ` V = ( Base `` ndx ) ` . (Contributed by AV, 23-Sep-2020.)
theorem snstrvtxval (G V: class):
  $ wcel V cvv $ >
  $ wceq G (csn (cop (cfv cnx cbs) V)) $ >
  $ wi (wne V (cfv cnx cbs)) (wceq (cfv G cvtx) V) $;

--| The set of indexed edges of a graph without edges represented as an extensible structure with vertices as base set and no indexed edges. See ~ iedgvalsnop for the (degenerate) case where ` V = ( Base `` ndx ) ` . (Contributed by AV, 24-Sep-2020.)
theorem snstriedgval (G V: class):
  $ wcel V cvv $ >
  $ wceq G (csn (cop (cfv cnx cbs) V)) $ >
  $ wi (wne V (cfv cnx cbs)) (wceq (cfv G ciedg) c0) $;

--| Degenerated case 1 for vertices: The set of vertices of the empty set is the empty set. (Contributed by AV, 24-Sep-2020.)
theorem vtxval0:
  $ wceq (cfv c0 cvtx) c0 $;

--| Degenerated case 1 for edges: The set of indexed edges of the empty set is the empty set. (Contributed by AV, 24-Sep-2020.)
theorem iedgval0:
  $ wceq (cfv c0 ciedg) c0 $;

--| Degenerated case 2 for vertices: The set of vertices of a singleton containing an ordered pair with equal components is the singleton containing the component. (Contributed by AV, 24-Sep-2020.) (Proof shortened by AV, 15-Jul-2022.) (Avoid depending on this detail.)
theorem vtxvalsnop (B2 G: class):
  $ wcel B2 cvv $ >
  $ wceq G (csn (cop B2 B2)) $ >
  $ wceq (cfv G cvtx) (csn B2) $;

--| Degenerated case 2 for edges: The set of indexed edges of a singleton containing an ordered pair with equal components is the singleton containing the component. (Contributed by AV, 24-Sep-2020.) (Proof shortened by AV, 15-Jul-2022.) (Avoid depending on this detail.)
theorem iedgvalsnop (B2 G: class):
  $ wcel B2 cvv $ >
  $ wceq G (csn (cop B2 B2)) $ >
  $ wceq (cfv G ciedg) (csn B2) $;

--| Degenerated case 3 for vertices: The set of vertices of a singleton containing a singleton containing a singleton is the innermost singleton. (Contributed by AV, 24-Sep-2020.) (Avoid depending on this detail.)
theorem vtxval3sn (A2: class):
  $ wcel A2 cvv $ >
  $ wceq (cfv (csn (csn (csn A2))) cvtx) (csn A2) $;

--| Degenerated case 3 for edges: The set of indexed edges of a singleton containing a singleton containing a singleton is the innermost singleton. (Contributed by AV, 24-Sep-2020.) (Avoid depending on this detail.)
theorem iedgval3sn (A2: class):
  $ wcel A2 cvv $ >
  $ wceq (cfv (csn (csn (csn A2))) ciedg) (csn A2) $;

--| Degenerated case 4 for vertices: The set of vertices of a proper class is the empty set. (Contributed by AV, 12-Oct-2020.)
theorem vtxvalprc (C: class):
  $ wi (wnel C cvv) (wceq (cfv C cvtx) c0) $;

--| Degenerated case 4 for edges: The set of indexed edges of a proper class is the empty set. (Contributed by AV, 12-Oct-2020.)
theorem iedgvalprc (C: class):
  $ wi (wnel C cvv) (wceq (cfv C ciedg) c0) $;

--| Extend class notation with the set of edges (of an undirected simple (hyper-/pseudo-)graph).
term cedg: class;

--| Define the class of edges of a graph, see also definition "E = E(G)" in section I.1 of [Bollobas] p. 1. This definition is very general: It defines edges of a class as the range of its edge function (which does not even need to be a function). Therefore, this definition could also be used for hypergraphs, pseudographs and multigraphs. In these cases, however, the (possibly more than one) edges connecting the same vertices could not be distinguished anymore. In some cases, this is no problem, so theorems with ` Edg ` are meaningful nevertheless (e.g., ~ edguhgr ). Usually, however, this definition is used only for undirected simple (hyper-/pseudo-)graphs (with or without loops). (Contributed by AV, 1-Jan-2020.) (Revised by AV, 13-Oct-2020.)
axiom df_edg {g2: setvar}:
  $ wceq cedg (cmpt g2 cvv (crn (cfv (cv g2) ciedg))) $;

--| The edges of a graph. (Contributed by AV, 1-Jan-2020.) (Revised by AV, 13-Oct-2020.) (Revised by AV, 8-Dec-2021.)
theorem edgval (G: class):
  $ wceq (cfv G cedg) (crn (cfv G ciedg)) $;

--| An indexed edge is an edge. (Contributed by AV, 19-Dec-2021.)
theorem iedgedg (E G I: class):
  $ wceq E (cfv G ciedg) $ >
  $ wi (wa (wfun E) (wcel I (cdm E))) (wcel (cfv I E) (cfv G cedg)) $;

--| The edges of a graph represented as ordered pair. (Contributed by AV, 1-Jan-2020.) (Revised by AV, 13-Oct-2020.)
theorem edgopval (E V W X: class):
  $ wi (wa (wcel V W) (wcel E X)) (wceq (cfv (cop V E) cedg) (crn E)) $;

--| The edges of a graph represented as ordered pair, shown as operation value. Although a little less intuitive, this representation is often used because it is shorter than the representation as function value of a graph given as ordered pair, see ~ edgopval . The representation ` ran E ` for the set of edges is even shorter, though. (Contributed by AV, 2-Jan-2020.) (Revised by AV, 13-Oct-2020.)
theorem edgov (E V W X: class):
  $ wi (wa (wcel V W) (wcel E X)) (wceq (co V E cedg) (crn E)) $;

--| The edges of a graph represented as an extensible structure with vertices as base set and indexed edges. (Contributed by AV, 13-Oct-2020.)
theorem edgstruct (E G V W X: class):
  $ wceq G (cpr (cop (cfv cnx cbs) V) (cop (cfv cnx cedgf) E)) $ >
  $ wi (wa (wcel V W) (wcel E X)) (wceq (cfv G cedg) (crn E)) $;

--| A set is an edge iff it is an indexed edge. (Contributed by AV, 17-Oct-2020.) (Revised by AV, 8-Dec-2021.)
theorem edgiedgb {x3: setvar} (E: class) (G: class x3) (I: class):
  $ wceq I (cfv G ciedg) $ >
  $ wi (wfun I) (wb (wcel E (cfv G cedg)) (wrex x3 (wceq E (cfv (cv x3) I)) (cdm I))) $;

--| There is no edge in a graph iff its edge function is empty. (Contributed by AV, 15-Dec-2020.) (Revised by AV, 8-Dec-2021.)
theorem edg0iedg0 (E G I: class):
  $ wceq I (cfv G ciedg) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wfun I) (wb (wceq E c0) (wceq I c0)) $;

--| Extend class notation with undirected hypergraphs.
term cuhgr: class;

--| Extend class notation with undirected simple hypergraphs.
term cushgr: class;

--| Define the class of all undirected hypergraphs. An undirected hypergraph consists of a set ` v ` (of "vertices") and a function ` e ` (representing indexed "edges") into the power set of this set (the empty set excluded). (Contributed by Alexander van der Vekens, 26-Dec-2017.) (Revised by AV, 8-Oct-2020.)
axiom df_uhgr {v e g2: setvar}:
  $ wceq cuhgr (cab g2 (wsbc v (wsbc e (wf (cdm (cv e)) (cdif (cpw (cv v)) (csn c0)) (cv e)) (cfv (cv g2) ciedg)) (cfv (cv g2) cvtx))) $;

--| Define the class of all undirected simple hypergraphs. An undirected simple hypergraph is a special (non-simple, multiple, multi-) hypergraph for which the edge function ` e ` is an injective (one-to-one) function into subsets of the set of vertices ` v ` , representing the (one or more) vertices incident to the edge. This definition corresponds to the definition of hypergraphs in section I.1 of [Bollobas] p. 7 (except that the empty set seems to be allowed to be an "edge") or section 1.10 of [Diestel] p. 27, where "E is a subset of [[...] the power set of V, that is the set of all subsets of V" resp. "the elements of E are nonempty subsets (of any cardinality) of V". (Contributed by AV, 19-Jan-2020.) (Revised by AV, 8-Oct-2020.)
axiom df_ushgr {v e g2: setvar}:
  $ wceq cushgr (cab g2 (wsbc v (wsbc e (wf1 (cdm (cv e)) (cdif (cpw (cv v)) (csn c0)) (cv e)) (cfv (cv g2) ciedg)) (cfv (cv g2) cvtx))) $;

--| The predicate "is an undirected hypergraph." (Contributed by Alexander van der Vekens, 26-Dec-2017.) (Revised by AV, 9-Oct-2020.)
theorem isuhgr (U E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (wcel G U) (wb (wcel G cuhgr) (wf (cdm E) (cdif (cpw V) (csn c0)) E)) $;

--| The predicate "is an undirected simple hypergraph." (Contributed by AV, 19-Jan-2020.) (Revised by AV, 9-Oct-2020.)
theorem isushgr (U E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (wcel G U) (wb (wcel G cushgr) (wf1 (cdm E) (cdif (cpw V) (csn c0)) E)) $;

--| The edge function of an undirected hypergraph is a function into the power set of the set of vertices. (Contributed by Alexander van der Vekens, 26-Dec-2017.) (Revised by AV, 9-Oct-2020.)
theorem uhgrf (E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (wcel G cuhgr) (wf (cdm E) (cdif (cpw V) (csn c0)) E) $;

--| The edge function of an undirected simple hypergraph is a one-to-one function into the power set of the set of vertices. (Contributed by AV, 9-Oct-2020.)
theorem ushgrf (E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (wcel G cushgr) (wf1 (cdm E) (cdif (cpw V) (csn c0)) E) $;

--| An edge is a subset of vertices. (Contributed by Alexander van der Vekens, 26-Dec-2017.) (Revised by AV, 18-Jan-2020.)
theorem uhgrss (E F G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (wa (wcel G cuhgr) (wcel F (cdm E))) (wss (cfv F E) V) $;

--| If two sets have the same vertices and the same edges, one set is a hypergraph iff the other set is a hypergraph. (Contributed by Alexander van der Vekens, 26-Dec-2017.) (Revised by AV, 18-Jan-2020.)
theorem uhgreq12g (E F G H V W X Y: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq W (cfv H cvtx) $ >
  $ wceq F (cfv H ciedg) $ >
  $ wi (wa (wa (wcel G X) (wcel H Y)) (wa (wceq V W) (wceq E F))) (wb (wcel G cuhgr) (wcel H cuhgr)) $;

--| The edge function of an undirected hypergraph is a function. (Contributed by Alexander van der Vekens, 26-Dec-2017.) (Revised by AV, 15-Dec-2020.)
theorem uhgrfun (E G: class):
  $ wceq E (cfv G ciedg) $ >
  $ wi (wcel G cuhgr) (wfun E) $;

--| An edge is a nonempty subset of vertices. (Contributed by Mario Carneiro, 11-Mar-2015.) (Revised by AV, 15-Dec-2020.)
theorem uhgrn0 (A2 E F G: class):
  $ wceq E (cfv G ciedg) $ >
  $ wi (w3a (wcel G cuhgr) (wfn E A2) (wcel F A2)) (wne (cfv F E) c0) $;

--| The endpoints of a loop (which is an edge at index ` J ` ) are two (identical) vertices ` A ` . (Contributed by AV, 1-Feb-2021.)
theorem lpvtx (A2 G I J: class):
  $ wceq I (cfv G ciedg) $ >
  $ wi (w3a (wcel G cuhgr) (wcel J (cdm I)) (wceq (cfv J I) (csn A2))) (wcel A2 (cfv G cvtx)) $;

--| An undirected simple hypergraph is an undirected hypergraph. (Contributed by AV, 19-Jan-2020.) (Revised by AV, 9-Oct-2020.)
theorem ushgruhgr (G: class):
  $ wi (wcel G cushgr) (wcel G cuhgr) $;

--| The property of being an undirected hypergraph represented as an ordered pair. The representation as an ordered pair is the usual representation of a graph, see section I.1 of [Bollobas] p. 1. (Contributed by AV, 1-Jan-2020.) (Revised by AV, 9-Oct-2020.)
theorem isuhgrop (E V W X: class):
  $ wi (wa (wcel V W) (wcel E X)) (wb (wcel (cop V E) cuhgr) (wf (cdm E) (cdif (cpw V) (csn c0)) E)) $;

--| The empty graph, with vertices but no edges, is a hypergraph. (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by AV, 25-Nov-2020.)
theorem uhgr0e (ph: wff) (G W: class):
  $ wi ph (wcel G W) $ >
  $ wi ph (wceq (cfv G ciedg) c0) $ >
  $ wi ph (wcel G cuhgr) $;

--| The null graph, with no vertices, is a hypergraph if and only if the edge function is empty. (Contributed by Alexander van der Vekens, 27-Dec-2017.) (Revised by AV, 9-Oct-2020.)
theorem uhgr0vb (G W: class):
  $ wi (wa (wcel G W) (wceq (cfv G cvtx) c0)) (wb (wcel G cuhgr) (wceq (cfv G ciedg) c0)) $;

--| The null graph represented by an empty set is a hypergraph. (Contributed by AV, 9-Oct-2020.)
theorem uhgr0:
  $ wcel c0 cuhgr $;

--| The union ` U ` of two (undirected) hypergraphs ` G ` and ` H ` with the same vertex set ` V ` is a hypergraph with the vertex set ` V ` and the union ` ( E u. F ) ` of the (indexed) edges. (Contributed by AV, 11-Oct-2020.) (Revised by AV, 24-Oct-2021.)
theorem uhgrun (ph: wff) (U E F G H V W: class):
  $ wi ph (wcel G cuhgr) $ >
  $ wi ph (wcel H cuhgr) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq F (cfv H ciedg) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wi ph (wceq (cfv H cvtx) V) $ >
  $ wi ph (wceq (cin (cdm E) (cdm F)) c0) $ >
  $ wi ph (wcel U W) $ >
  $ wi ph (wceq (cfv U cvtx) V) $ >
  $ wi ph (wceq (cfv U ciedg) (cun E F)) $ >
  $ wi ph (wcel U cuhgr) $;

--| The union of two (undirected) hypergraphs (with the same vertex set) represented as ordered pair: If ` <. V , E >. ` and ` <. V , F >. ` are hypergraphs, then ` <. V , E u. F >. ` is a hypergraph (the vertex set stays the same, but the edges from both graphs are kept, possibly resulting in two edges between two vertices). (Contributed by Alexander van der Vekens, 27-Dec-2017.) (Revised by AV, 11-Oct-2020.) (Revised by AV, 24-Oct-2021.)
theorem uhgrunop (ph: wff) (E F G H V: class):
  $ wi ph (wcel G cuhgr) $ >
  $ wi ph (wcel H cuhgr) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq F (cfv H ciedg) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wi ph (wceq (cfv H cvtx) V) $ >
  $ wi ph (wceq (cin (cdm E) (cdm F)) c0) $ >
  $ wi ph (wcel (cop V (cun E F)) cuhgr) $;

--| The union ` U ` of two (undirected) simple hypergraphs ` G ` and ` H ` with the same vertex set ` V ` is a (not necessarily simple) hypergraph with the vertex set ` V ` and the union ` ( E u. F ) ` of the (indexed) edges. (Contributed by AV, 29-Nov-2020.) (Revised by AV, 24-Oct-2021.)
theorem ushgrun (ph: wff) (U E F G H V W: class):
  $ wi ph (wcel G cushgr) $ >
  $ wi ph (wcel H cushgr) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq F (cfv H ciedg) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wi ph (wceq (cfv H cvtx) V) $ >
  $ wi ph (wceq (cin (cdm E) (cdm F)) c0) $ >
  $ wi ph (wcel U W) $ >
  $ wi ph (wceq (cfv U cvtx) V) $ >
  $ wi ph (wceq (cfv U ciedg) (cun E F)) $ >
  $ wi ph (wcel U cuhgr) $;

--| The union of two (undirected) simple hypergraphs (with the same vertex set) represented as ordered pair: If ` <. V , E >. ` and ` <. V , F >. ` are simple hypergraphs, then ` <. V , E u. F >. ` is a (not necessarily simple) hypergraph - the vertex set stays the same, but the edges from both graphs are kept, possibly resulting in two edges between two vertices. (Contributed by AV, 29-Nov-2020.) (Revised by AV, 24-Oct-2021.)
theorem ushgrunop (ph: wff) (E F G H V: class):
  $ wi ph (wcel G cushgr) $ >
  $ wi ph (wcel H cushgr) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq F (cfv H ciedg) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wi ph (wceq (cfv H cvtx) V) $ >
  $ wi ph (wceq (cin (cdm E) (cdm F)) c0) $ >
  $ wi ph (wcel (cop V (cun E F)) cuhgr) $;

--| Replacing (or adding) the edges (between elements of the base set) of an extensible structure results in a hypergraph. Instead of requiring ` ( ph -> G Struct X ) ` , it would be sufficient to require ` ( ph -> Fun ( G \ { (/) } ) ) ` and ` ( ph -> G e. _V ) ` . (Contributed by AV, 18-Jan-2020.) (Revised by AV, 7-Jun-2021.) (Revised by AV, 16-Nov-2021.)
theorem uhgrstrrepe (ph: wff) (E G I V W X: class):
  $ wceq V (cfv G cbs) $ >
  $ wceq I (cfv cnx cedgf) $ >
  $ wi ph (wbr G X cstr) $ >
  $ wi ph (wcel (cfv cnx cbs) (cdm G)) $ >
  $ wi ph (wcel E W) $ >
  $ wi ph (wf (cdm E) (cdif (cpw V) (csn c0)) E) $ >
  $ wi ph (wcel (co G (cop I E) csts) cuhgr) $;

--| An _incidence structure_ ` <. P , L , I >. ` "where ` P ` is a set whose elements are called _points_, ` L ` is a distinct set whose elements are called _lines_ and ` I C_ ( P X. L ) ` is the _incidence relation_" (see Wikipedia "Incidence structure" (24-Oct-2020), ~ https://en.wikipedia.org/wiki/Incidence_structure ) implies an undirected hypergraph, if the incidence relation is right-total (to exclude empty edges). The points become the vertices, and the edge function is derived from the incidence relation by mapping each line ("edge") to the set of vertices incident to the line/edge. With ` P = ( Base `` S ) ` and by defining two new slots for lines and incidence relations (analogous to ` LineG ` and ` Itv ` ) and enhancing the definition of ` iEdg ` accordingly, it would even be possible to express that a corresponding incidence structure _is_ an undirected hypergraph. By choosing the incident relation appropriately, other kinds of undirected graphs (pseudographs, multigraphs, simple graphs, etc.) could be defined. (Contributed by AV, 24-Oct-2020.)
theorem incistruhgr {v e: setvar} (P: class) (E G: class v) (I L V: class) (W: class v):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (w3a (wcel G W) (wss I (cxp P L)) (wceq (crn I) L)) (wi (wa (wceq V P) (wceq E (cmpt e L (crab v (wbr (cv v) (cv e) I) P)))) (wcel G cuhgr)) $;

--| Extend class notation with undirected pseudographs.
term cupgr: class;

--| Extend class notation with undirected multigraphs.
term cumgr: class;

--| Define the class of all undirected pseudographs. An (undirected) pseudograph consists of a set ` v ` (of "vertices") and a function ` e ` (representing indexed "edges") into subsets of ` v ` of cardinality one or two, representing the two vertices incident to the edge, or the one vertex if the edge is a loop. This is according to Chartrand, Gary and Zhang, Ping (2012): "A First Course in Graph Theory.", Dover, ISBN 978-0-486-48368-9, section 1.4, p. 26: "In a pseudograph, not only are parallel edges permitted but an edge is also permitted to join a vertex to itself. Such an edge is called a loop." (in contrast to a multigraph, see ~ df-umgr ). (Contributed by Mario Carneiro, 11-Mar-2015.) (Revised by AV, 24-Nov-2020.)
axiom df_upgr {x3 v e g2: setvar}:
  $ wceq cupgr (cab g2 (wsbc v (wsbc e (wf (cdm (cv e)) (crab x3 (wbr (cfv (cv x3) chash) c2 cle) (cdif (cpw (cv v)) (csn c0))) (cv e)) (cfv (cv g2) ciedg)) (cfv (cv g2) cvtx))) $;

--| Define the class of all undirected multigraphs. An (undirected) multigraph consists of a set ` v ` (of "vertices") and a function ` e ` (representing indexed "edges") into subsets of ` v ` of cardinality two, representing the two vertices incident to the edge. In contrast to a pseudograph, a multigraph has no loop. This is according to Chartrand, Gary and Zhang, Ping (2012): "A First Course in Graph Theory.", Dover, ISBN 978-0-486-48368-9, section 1.4, p. 26: "A multigraph M consists of a finite nonempty set V of vertices and a set E of edges, where every two vertices of M are joined by a finite number of edges (possibly zero). If two or more edges join the same pair of (distinct) vertices, then these edges are called parallel edges." To provide uniform definitions for all kinds of graphs, ` x e. ( ~P v \ { (/) } ) ` is used as restriction of the class abstraction, although ` x e. ~P v ` would be sufficient (see ~ prprrab and ~ isumgrs ). (Contributed by AV, 24-Nov-2020.)
axiom df_umgr {x3 v e g2: setvar}:
  $ wceq cumgr (cab g2 (wsbc v (wsbc e (wf (cdm (cv e)) (crab x3 (wceq (cfv (cv x3) chash) c2) (cdif (cpw (cv v)) (csn c0))) (cv e)) (cfv (cv g2) ciedg)) (cfv (cv g2) cvtx))) $;

--| The property of being an undirected pseudograph. (Contributed by Mario Carneiro, 11-Mar-2015.) (Revised by AV, 10-Oct-2020.)
theorem isupgr {x3: setvar} (U E: class x3) (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (wcel G U) (wb (wcel G cupgr) (wf (cdm E) (crab x3 (wbr (cfv (cv x3) chash) c2 cle) (cdif (cpw V) (csn c0))) E)) $;

--| The property of being an undirected pseudograph, expressing the edges as "words". (Contributed by Mario Carneiro, 11-Mar-2015.) (Revised by AV, 10-Oct-2020.)
theorem wrdupgr {x3: setvar} (U E: class x3) (G V: class) (X: class x3):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (wa (wcel G U) (wcel E (cword X))) (wb (wcel G cupgr) (wcel E (cword (crab x3 (wbr (cfv (cv x3) chash) c2 cle) (cdif (cpw V) (csn c0)))))) $;

--| The edge function of an undirected pseudograph is a function into unordered pairs of vertices. Version of ~ upgrfn without explicitly specified domain of the edge function. (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by AV, 10-Oct-2020.)
theorem upgrf {x3: setvar} (E: class x3) (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (wcel G cupgr) (wf (cdm E) (crab x3 (wbr (cfv (cv x3) chash) c2 cle) (cdif (cpw V) (csn c0))) E) $;

--| The edge function of an undirected pseudograph is a function into unordered pairs of vertices. (Contributed by Mario Carneiro, 11-Mar-2015.) (Revised by AV, 10-Oct-2020.)
theorem upgrfn {x3: setvar} (A2 E: class x3) (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (wa (wcel G cupgr) (wfn E A2)) (wf A2 (crab x3 (wbr (cfv (cv x3) chash) c2 cle) (cdif (cpw V) (csn c0))) E) $;

--| An edge is a subset of vertices. (Contributed by Mario Carneiro, 11-Mar-2015.) (Revised by AV, 29-Nov-2020.)
theorem upgrss (E F G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (wa (wcel G cupgr) (wcel F (cdm E))) (wss (cfv F E) V) $;

--| An edge is a nonempty subset of vertices. (Contributed by Mario Carneiro, 11-Mar-2015.) (Revised by AV, 10-Oct-2020.)
theorem upgrn0 (A2 E F G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (w3a (wcel G cupgr) (wfn E A2) (wcel F A2)) (wne (cfv F E) c0) $;

--| An edge of an undirected pseudograph has at most two ends. (Contributed by Mario Carneiro, 11-Mar-2015.) (Revised by AV, 10-Oct-2020.)
theorem upgrle (A2 E F G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (w3a (wcel G cupgr) (wfn E A2) (wcel F A2)) (wbr (cfv (cfv F E) chash) c2 cle) $;

--| An edge is a finite subset of vertices. (Contributed by Mario Carneiro, 11-Mar-2015.) (Revised by AV, 10-Oct-2020.)
theorem upgrfi (A2 E F G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (w3a (wcel G cupgr) (wfn E A2) (wcel F A2)) (wcel (cfv F E) cfn) $;

--| An edge is an unordered pair of vertices. (Contributed by Mario Carneiro, 11-Mar-2015.) (Revised by AV, 10-Oct-2020.)
theorem upgrex {x3 y1: setvar} (A2 E F G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (w3a (wcel G cupgr) (wfn E A2) (wcel F A2)) (wrex x3 (wrex y1 (wceq (cfv F E) (cpr (cv x3) (cv y1))) V) V) $;

--| Show that an unordered pair is a valid edge in a pseudograph. (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by Mario Carneiro, 28-Feb-2016.) (Revised by AV, 28-Feb-2021.)
theorem upgrbi {x3: setvar} (V X Y: class):
  $ wcel X V $ >
  $ wcel Y V $ >
  $ wcel (cpr X Y) (crab x3 (wbr (cfv (cv x3) chash) c2 cle) (cdif (cpw V) (csn c0))) $;

--| A pseudograph represented by an ordered pair. (Contributed by AV, 12-Dec-2021.)
theorem upgrop (G: class):
  $ wi (wcel G cupgr) (wcel (cop (cfv G cvtx) (cfv G ciedg)) cupgr) $;

--| The property of being an undirected multigraph. (Contributed by AV, 24-Nov-2020.)
theorem isumgr {x3: setvar} (U E: class x3) (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (wcel G U) (wb (wcel G cumgr) (wf (cdm E) (crab x3 (wceq (cfv (cv x3) chash) c2) (cdif (cpw V) (csn c0))) E)) $;

--| The simplified property of being an undirected multigraph. (Contributed by AV, 24-Nov-2020.)
theorem isumgrs {x3: setvar} (U E: class x3) (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (wcel G U) (wb (wcel G cumgr) (wf (cdm E) (crab x3 (wceq (cfv (cv x3) chash) c2) (cpw V)) E)) $;

--| The property of being an undirected multigraph, expressing the edges as "words". (Contributed by AV, 24-Nov-2020.)
theorem wrdumgr {x3: setvar} (U E: class x3) (G V: class) (X: class x3):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (wa (wcel G U) (wcel E (cword X))) (wb (wcel G cumgr) (wcel E (cword (crab x3 (wceq (cfv (cv x3) chash) c2) (cpw V))))) $;

--| The edge function of an undirected multigraph is a function into unordered pairs of vertices. Version of ~ umgrfn without explicitly specified domain of the edge function. (Contributed by AV, 24-Nov-2020.)
theorem umgrf {x3: setvar} (E: class x3) (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (wcel G cumgr) (wf (cdm E) (crab x3 (wceq (cfv (cv x3) chash) c2) (cpw V)) E) $;

--| The edge function of an undirected multigraph is a function into unordered pairs of vertices. (Contributed by AV, 24-Nov-2020.)
theorem umgrfn {x3: setvar} (A2 E: class x3) (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (wa (wcel G cumgr) (wfn E A2)) (wf A2 (crab x3 (wceq (cfv (cv x3) chash) c2) (cpw V)) E) $;

--| An edge of a multigraph has exactly two ends. (Contributed by AV, 24-Nov-2020.)
theorem umgredg2 (E G V X: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (wa (wcel G cumgr) (wcel X (cdm E))) (wceq (cfv (cfv X E) chash) c2) $;

--| Show that an unordered pair is a valid edge in a multigraph. (Contributed by AV, 9-Mar-2021.)
theorem umgrbi {x3: setvar} (V X Y: class):
  $ wcel X V $ >
  $ wcel Y V $ >
  $ wne X Y $ >
  $ wcel (cpr X Y) (crab x3 (wceq (cfv (cv x3) chash) c2) (cpw V)) $;

--| An undirected pseudograph is an undirected hypergraph. (Contributed by Alexander van der Vekens, 27-Dec-2017.) (Revised by AV, 10-Oct-2020.)
theorem upgruhgr (G: class):
  $ wi (wcel G cupgr) (wcel G cuhgr) $;

--| An undirected multigraph is an undirected pseudograph. (Contributed by AV, 25-Nov-2020.)
theorem umgrupgr (G: class):
  $ wi (wcel G cumgr) (wcel G cupgr) $;

--| An undirected multigraph is an undirected hypergraph. (Contributed by AV, 26-Nov-2020.)
theorem umgruhgr (G: class):
  $ wi (wcel G cumgr) (wcel G cuhgr) $;

--| An edge of an undirected pseudograph has at most two ends. (Contributed by AV, 6-Feb-2021.)
theorem upgrle2 (G I X: class):
  $ wceq I (cfv G ciedg) $ >
  $ wi (wa (wcel G cupgr) (wcel X (cdm I))) (wbr (cfv (cfv X I) chash) c2 cle) $;

--| In a multigraph, there is no loop, i.e. no edge connecting a vertex with itself. (Contributed by Alexander van der Vekens, 26-Jan-2018.) (Revised by AV, 11-Dec-2020.)
theorem umgrnloopv (E G M N W X: class):
  $ wceq E (cfv G ciedg) $ >
  $ wi (wa (wcel G cumgr) (wcel M W)) (wi (wceq (cfv X E) (cpr M N)) (wne M N)) $;

--| In a multigraph, an edge is an unordered pair of vertices. This theorem would not hold for arbitrary hyper-/pseudographs since either ` M ` or ` N ` could be proper classes ( ` ( E `` X ) ` would be a loop in this case), which are no vertices of course. (Contributed by Alexander van der Vekens, 19-Aug-2017.) (Revised by AV, 11-Dec-2020.)
theorem umgredgprv (E G M N V X: class):
  $ wceq E (cfv G ciedg) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel G cumgr) (wcel X (cdm E))) (wi (wceq (cfv X E) (cpr M N)) (wa (wcel M V) (wcel N V))) $;

--| In a multigraph, there is no loop, i.e. no edge connecting a vertex with itself. (Contributed by Alexander van der Vekens, 19-Aug-2017.) (Revised by AV, 11-Dec-2020.)
theorem umgrnloop {x3: setvar} (E: class x3) (G M N: class):
  $ wceq E (cfv G ciedg) $ >
  $ wi (wcel G cumgr) (wi (wrex x3 (wceq (cfv (cv x3) E) (cpr M N)) (cdm E)) (wne M N)) $;

--| A multigraph has no loops. (Contributed by Alexander van der Vekens, 6-Dec-2017.) (Revised by AV, 11-Dec-2020.)
theorem umgrnloop0 {x3: setvar} (U: class) (E: class x3) (G: class):
  $ wceq E (cfv G ciedg) $ >
  $ wi (wcel G cumgr) (wceq (crab x3 (wceq (cfv (cv x3) E) (csn U)) (cdm E)) c0) $;

--| The empty graph, with vertices but no edges, is a multigraph. (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by AV, 25-Nov-2020.)
theorem umgr0e (ph: wff) (G W: class):
  $ wi ph (wcel G W) $ >
  $ wi ph (wceq (cfv G ciedg) c0) $ >
  $ wi ph (wcel G cumgr) $;

--| The empty graph, with vertices but no edges, is a pseudograph. (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by AV, 11-Oct-2020.) (Proof shortened by AV, 25-Nov-2020.)
theorem upgr0e (ph: wff) (G W: class):
  $ wi ph (wcel G W) $ >
  $ wi ph (wceq (cfv G ciedg) c0) $ >
  $ wi ph (wcel G cupgr) $;

--| Lemma for ~ upgr1e and ~ uspgr1e . (Contributed by AV, 16-Oct-2020.)
theorem upgr1elem {x3: setvar} (ph: wff x3) (B2 C S: class) (W: class x3):
  $ wi ph (wcel (cpr B2 C) S) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wss (csn (cpr B2 C)) (crab x3 (wbr (cfv (cv x3) chash) c2 cle) (cdif S (csn c0)))) $;

--| A pseudograph with one edge. Such a graph is actually a simple pseudograph, see ~ uspgr1e . (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by AV, 16-Oct-2020.) (Revised by AV, 21-Mar-2021.) (Proof shortened by AV, 17-Apr-2021.)
theorem upgr1e (ph: wff) (A2 B2 C G V X: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wceq (cfv G ciedg) (csn (cop A2 (cpr B2 C)))) $ >
  $ wi ph (wcel G cupgr) $;

--| The empty graph, with vertices but no edges, is a pseudograph. The empty graph is actually a simple graph, see ~ usgr0eop , and therefore also a multigraph ( ` G e. UMGraph ` ). (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by AV, 11-Oct-2020.)
theorem upgr0eop (V W: class):
  $ wi (wcel V W) (wcel (cop V c0) cupgr) $;

--| A pseudograph with one edge. Such a graph is actually a simple pseudograph, see ~ uspgr1eop . (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by AV, 10-Oct-2020.)
theorem upgr1eop (A2 B2 C V W X: class):
  $ wi (wa (wa (wcel V W) (wcel A2 X)) (wa (wcel B2 V) (wcel C V))) (wcel (cop V (csn (cop A2 (cpr B2 C)))) cupgr) $;

--| Alternate proof of ~ upgr0eop , using the general theorem ~ gropeld to transform a theorem for an arbitrary representation of a graph into a theorem for a graph represented as ordered pair. This general approach causes some overhead, which makes the proof longer than necessary (see proof of ~ upgr0eop ). (Contributed by AV, 11-Oct-2020.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem upgr0eopALT (V W: class):
  $ wi (wcel V W) (wcel (cop V c0) cupgr) $;

--| Alternate proof of ~ upgr1eop , using the general theorem ~ gropeld to transform a theorem for an arbitrary representation of a graph into a theorem for a graph represented as ordered pair. This general approach causes some overhead, which makes the proof longer than necessary (see proof of ~ upgr1eop ). (Contributed by AV, 11-Oct-2020.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem upgr1eopALT (A2 B2 C V W X: class):
  $ wi (wa (wa (wcel V W) (wcel A2 X)) (wa (wcel B2 V) (wcel C V))) (wcel (cop V (csn (cop A2 (cpr B2 C)))) cupgr) $;

--| The union ` U ` of two pseudographs ` G ` and ` H ` with the same vertex set ` V ` is a pseudograph with the vertex ` V ` and the union ` ( E u. F ) ` of the (indexed) edges. (Contributed by AV, 12-Oct-2020.) (Revised by AV, 24-Oct-2021.)
theorem upgrun (ph: wff) (U E F G H V W: class):
  $ wi ph (wcel G cupgr) $ >
  $ wi ph (wcel H cupgr) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq F (cfv H ciedg) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wi ph (wceq (cfv H cvtx) V) $ >
  $ wi ph (wceq (cin (cdm E) (cdm F)) c0) $ >
  $ wi ph (wcel U W) $ >
  $ wi ph (wceq (cfv U cvtx) V) $ >
  $ wi ph (wceq (cfv U ciedg) (cun E F)) $ >
  $ wi ph (wcel U cupgr) $;

--| The union of two pseudographs (with the same vertex set): If ` <. V , E >. ` and ` <. V , F >. ` are pseudographs, then ` <. V , E u. F >. ` is a pseudograph (the vertex set stays the same, but the edges from both graphs are kept). (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by AV, 12-Oct-2020.) (Revised by AV, 24-Oct-2021.)
theorem upgrunop (ph: wff) (E F G H V: class):
  $ wi ph (wcel G cupgr) $ >
  $ wi ph (wcel H cupgr) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq F (cfv H ciedg) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wi ph (wceq (cfv H cvtx) V) $ >
  $ wi ph (wceq (cin (cdm E) (cdm F)) c0) $ >
  $ wi ph (wcel (cop V (cun E F)) cupgr) $;

--| The union ` U ` of two multigraphs ` G ` and ` H ` with the same vertex set ` V ` is a multigraph with the vertex ` V ` and the union ` ( E u. F ) ` of the (indexed) edges. (Contributed by AV, 25-Nov-2020.)
theorem umgrun (ph: wff) (U E F G H V W: class):
  $ wi ph (wcel G cumgr) $ >
  $ wi ph (wcel H cumgr) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq F (cfv H ciedg) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wi ph (wceq (cfv H cvtx) V) $ >
  $ wi ph (wceq (cin (cdm E) (cdm F)) c0) $ >
  $ wi ph (wcel U W) $ >
  $ wi ph (wceq (cfv U cvtx) V) $ >
  $ wi ph (wceq (cfv U ciedg) (cun E F)) $ >
  $ wi ph (wcel U cumgr) $;

--| The union of two multigraphs (with the same vertex set): If ` <. V , E >. ` and ` <. V , F >. ` are multigraphs, then ` <. V , E u. F >. ` is a multigraph (the vertex set stays the same, but the edges from both graphs are kept). (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by AV, 25-Nov-2020.)
theorem umgrunop (ph: wff) (E F G H V: class):
  $ wi ph (wcel G cumgr) $ >
  $ wi ph (wcel H cumgr) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq F (cfv H ciedg) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wi ph (wceq (cfv H cvtx) V) $ >
  $ wi ph (wceq (cin (cdm E) (cdm F)) c0) $ >
  $ wi ph (wcel (cop V (cun E F)) cumgr) $;

--| Lemma for ~ umgrislfupgr and ~ usgrislfuspgr . (Contributed by AV, 27-Jan-2021.)
theorem umgrislfupgrlem {x3: setvar} (V: class x3):
  $ wceq (cin (crab x3 (wbr (cfv (cv x3) chash) c2 cle) (cdif (cpw V) (csn c0))) (crab x3 (wbr c2 (cfv (cv x3) chash) cle) (cpw V))) (crab x3 (wceq (cfv (cv x3) chash) c2) (cdif (cpw V) (csn c0))) $;

--| A multigraph is a loop-free pseudograph. (Contributed by AV, 27-Jan-2021.)
theorem umgrislfupgr {x3: setvar} (G: class) (I: class x3) (V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wb (wcel G cumgr) (wa (wcel G cupgr) (wf (cdm I) (crab x3 (wbr c2 (cfv (cv x3) chash) cle) (cpw V)) I)) $;

--| An edge of a loop-free graph has at least two ends. (Contributed by AV, 23-Feb-2021.)
theorem lfgredgge2 {x3: setvar} (A2: class) (E G: class x3) (I V: class) (X: class x3):
  $ wceq I (cfv G ciedg) $ >
  $ wceq A2 (cdm I) $ >
  $ wceq E (crab x3 (wbr c2 (cfv (cv x3) chash) cle) (cpw V)) $ >
  $ wi (wa (wf A2 E I) (wcel X A2)) (wbr c2 (cfv (cfv X I) chash) cle) $;

--| A loop-free graph has no loops. (Contributed by AV, 23-Feb-2021.)
theorem lfgrnloop {x3: setvar} (A2 U: class) (E G: class x3) (I V: class):
  $ wceq I (cfv G ciedg) $ >
  $ wceq A2 (cdm I) $ >
  $ wceq E (crab x3 (wbr c2 (cfv (cv x3) chash) cle) (cpw V)) $ >
  $ wi (wf A2 E I) (wceq (crab x3 (wceq (cfv (cv x3) I) (csn U)) A2) c0) $;

--| In a hypergraph, a set is an edge iff it is an indexed edge. (Contributed by AV, 17-Oct-2020.)
theorem uhgredgiedgb {x3: setvar} (E: class) (G: class x3) (I: class):
  $ wceq I (cfv G ciedg) $ >
  $ wi (wcel G cuhgr) (wb (wcel E (cfv G cedg)) (wrex x3 (wceq E (cfv (cv x3) I)) (cdm I))) $;

--| A hypergraph has no edges iff its edge function is empty. (Contributed by AV, 21-Oct-2020.) (Proof shortened by AV, 8-Dec-2021.)
theorem uhgriedg0edg0 (G: class):
  $ wi (wcel G cuhgr) (wb (wceq (cfv G cedg) c0) (wceq (cfv G ciedg) c0)) $;

--| An edge of a hypergraph is a nonempty subset of vertices. (Contributed by AV, 28-Nov-2020.)
theorem uhgredgn0 (E G: class):
  $ wi (wa (wcel G cuhgr) (wcel E (cfv G cedg))) (wcel E (cdif (cpw (cfv G cvtx)) (csn c0))) $;

--| An edge of a hypergraph is a subset of vertices. (Contributed by AV, 26-Oct-2020.) (Proof shortened by AV, 28-Nov-2020.)
theorem edguhgr (E G: class):
  $ wi (wa (wcel G cuhgr) (wcel E (cfv G cedg))) (wcel E (cpw (cfv G cvtx))) $;

--| An edge of a hypergraph contains only vertices. (Contributed by Alexander van der Vekens, 18-Feb-2018.) (Revised by AV, 4-Jun-2021.)
theorem uhgredgrnv (E G N: class):
  $ wi (w3a (wcel G cuhgr) (wcel E (cfv G cedg)) (wcel N E)) (wcel N (cfv G cvtx)) $;

--| The set of edges of a hypergraph is a subset of the power set of vertices without the empty set. (Contributed by AV, 29-Nov-2020.)
theorem uhgredgss (G: class):
  $ wi (wcel G cuhgr) (wss (cfv G cedg) (cdif (cpw (cfv G cvtx)) (csn c0))) $;

--| The set of edges of a pseudograph is a subset of the set of unordered pairs of vertices. (Contributed by AV, 29-Nov-2020.)
theorem upgredgss {x3: setvar} (G: class):
  $ wi (wcel G cupgr) (wss (cfv G cedg) (crab x3 (wbr (cfv (cv x3) chash) c2 cle) (cdif (cpw (cfv G cvtx)) (csn c0)))) $;

--| The set of edges of a multigraph is a subset of the set of proper unordered pairs of vertices. (Contributed by AV, 25-Nov-2020.)
theorem umgredgss {x3: setvar} (G: class):
  $ wi (wcel G cumgr) (wss (cfv G cedg) (crab x3 (wceq (cfv (cv x3) chash) c2) (cpw (cfv G cvtx)))) $;

--| Properties of an edge of a pseudograph. (Contributed by AV, 8-Nov-2020.)
theorem edgupgr (E G: class):
  $ wi (wa (wcel G cupgr) (wcel E (cfv G cedg))) (w3a (wcel E (cpw (cfv G cvtx))) (wne E c0) (wbr (cfv E chash) c2 cle)) $;

--| Properties of an edge of a multigraph. (Contributed by AV, 25-Nov-2020.)
theorem edgumgr (E G: class):
  $ wi (wa (wcel G cumgr) (wcel E (cfv G cedg))) (wa (wcel E (cpw (cfv G cvtx))) (wceq (cfv E chash) c2)) $;

--| In a hypergraph, a vertex is incident with an edge iff it is contained in an element of the range of the edge function. (Contributed by AV, 24-Dec-2020.) (Revised by AV, 6-Jul-2022.)
theorem uhgrvtxedgiedgb {e i: setvar} (U: class) (E: class i) (G: class e i) (I: class) (V: class e i):
  $ wceq I (cfv G ciedg) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cuhgr) (wcel U V)) (wb (wrex i (wcel U (cfv (cv i) I)) (cdm I)) (wrex e (wcel U (cv e)) E)) $;

--| For each edge in a pseudograph, there are two vertices which are connected by this edge. (Contributed by AV, 4-Nov-2020.) (Proof shortened by AV, 26-Nov-2021.)
theorem upgredg {a b: setvar} (C: class) (E: class a b) (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cupgr) (wcel C E)) (wrex a (wrex b (wceq C (cpr (cv a) (cv b))) V) V) $;

--| For each edge in a multigraph, there are two distinct vertices which are connected by this edge. (Contributed by Alexander van der Vekens, 9-Dec-2017.) (Revised by AV, 25-Nov-2020.)
theorem umgredg {a b: setvar} (C: class) (E: class a b) (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cumgr) (wcel C E)) (wrex a (wrex b (wa (wne (cv a) (cv b)) (wceq C (cpr (cv a) (cv b)))) V) V) $;

--| An edge of a pseudograph always connects two vertices if the edge contains two sets. The two vertices/sets need not necessarily be different (loops are allowed). (Contributed by AV, 18-Nov-2021.)
theorem upgrpredgv (U E G M N V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (w3a (wcel G cupgr) (wa (wcel M U) (wcel N W)) (wcel (cpr M N) E)) (wa (wcel M V) (wcel N V)) $;

--| An edge of a multigraph always connects two vertices. Analogue of ~ umgredgprv . This theorem does not hold for arbitrary pseudographs: if either ` M ` or ` N ` is a proper class, then ` { M , N } e. E ` could still hold ( ` { M , N } ` would be either ` { M } ` or ` { N } ` , see ~ prprc1 or ~ prprc2 , i.e. a loop), but ` M e. V ` or ` N e. V ` would not be true. (Contributed by AV, 27-Nov-2020.)
theorem umgrpredgv (E G M N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cumgr) (wcel (cpr M N) E)) (wa (wcel M V) (wcel N V)) $;

--| For a vertex incident to an edge there is another vertex incident to the edge in a pseudograph. (Contributed by AV, 18-Oct-2020.) (Revised by AV, 5-Dec-2020.)
theorem upgredg2vtx {b: setvar} (A2 C: class) (E: class b) (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (w3a (wcel G cupgr) (wcel C E) (wcel A2 C)) (wrex b (wceq C (cpr A2 (cv b))) V) $;

--| If a proper pair (of vertices) is a subset of an edge in a pseudograph, the pair is the edge. (Contributed by AV, 30-Dec-2020.)
theorem upgredgpr (A2 B2 C U E G V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (w3a (wcel G cupgr) (wcel C E) (wss (cpr A2 B2) C)) (w3a (wcel A2 U) (wcel B2 W) (wne A2 B2))) (wceq (cpr A2 B2) C) $;

--| The edges incident with a vertex ` N ` are the edges joining ` N ` with other vertices and the loops on ` N ` in a pseudograph. (Contributed by AV, 18-Dec-2021.)
theorem edglnl {v i: setvar} (E: class i) (G: class v) (N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (wa (wcel G cupgr) (wcel N V)) (wceq (cun (ciun v (cdif V (csn N)) (crab i (wa (wcel N (cfv (cv i) E)) (wcel (cv v) (cfv (cv i) E))) (cdm E))) (crab i (wceq (cfv (cv i) E) (csn N)) (cdm E))) (crab i (wcel N (cfv (cv i) E)) (cdm E))) $;

--| The number of edges incident with a vertex ` N ` is the number of edges joining ` N ` with other vertices and the number of loops on ` N ` in a pseudograph of finite size. (Contributed by AV, 19-Dec-2021.)
theorem numedglnl {v i: setvar} (E G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (w3a (wcel G cupgr) (wa (wcel V cfn) (wcel E cfn)) (wcel N V)) (wceq (co (csu v (cdif V (csn N)) (cfv (crab i (wa (wcel N (cfv (cv i) E)) (wcel (cv v) (cfv (cv i) E))) (cdm E)) chash)) (cfv (crab i (wceq (cfv (cv i) E) (csn N)) (cdm E)) chash) caddc) (cfv (crab i (wcel N (cfv (cv i) E)) (cdm E)) chash)) $;

--| An edge of a multigraph always connects two different vertices. Analogue of ~ umgrnloopv resp. ~ umgrnloop . (Contributed by AV, 27-Nov-2020.)
theorem umgredgne (E G M N: class):
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cumgr) (wcel (cpr M N) E)) (wne M N) $;

--| A multigraph has no loops. (Contributed by AV, 27-Oct-2020.) (Revised by AV, 30-Nov-2020.)
theorem umgrnloop2 (G N: class):
  $ wi (wcel G cumgr) (wnel (cpr N N) (cfv G cedg)) $;

--| An edge of a multigraph is not a loop. (Contributed by AV, 9-Jan-2020.) (Revised by AV, 8-Jun-2021.)
theorem umgredgnlp {v: setvar} (C E G: class):
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cumgr) (wcel C E)) (wn (wex v (wceq C (csn (cv v))))) $;

--| A hypergraph is loop-free if and only if every edge connects at least two vertices. (Contributed by BTernaryTau, 15-Oct-2023.)
theorem lfuhgr {x3: setvar} (G: class) (I: class x3) (V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi (wcel G cuhgr) (wb (wf (cdm I) (crab x3 (wbr c2 (cfv (cv x3) chash) cle) (cpw V)) I) (wral x3 (wbr c2 (cfv (cv x3) chash) cle) (cfv G cedg))) $;

--| A hypergraph is loop-free if and only if every edge is not a loop. (Contributed by BTernaryTau, 15-Oct-2023.)
theorem lfuhgr2 {x3: setvar} (G: class) (I: class x3) (V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi (wcel G cuhgr) (wb (wf (cdm I) (crab x3 (wbr c2 (cfv (cv x3) chash) cle) (cpw V)) I) (wral x3 (wne (cfv (cv x3) chash) c1) (cfv G cedg))) $;

--| A hypergraph is loop-free if and only if none of its edges connect to only one vertex. (Contributed by BTernaryTau, 15-Oct-2023.)
theorem lfuhgr3 {x3 a: setvar} (G: class) (I: class x3 a) (V: class a):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi (wcel G cuhgr) (wb (wf (cdm I) (crab x3 (wbr c2 (cfv (cv x3) chash) cle) (cpw V)) I) (wn (wex a (wcel (csn (cv a)) (cfv G cedg))))) $;

--| Extend class notation with undirected simple pseudographs (which could have loops).
term cuspgr: class;

--| Extend class notation with undirected simple graphs (without loops).
term cusgr: class;

--| Define the class of all undirected simple pseudographs (which could have loops). An undirected simple pseudograph is a special undirected pseudograph (see ~ uspgrupgr ) or a special undirected simple hypergraph (see ~ uspgrushgr ), consisting of a set ` v ` (of "vertices") and an injective (one-to-one) function ` e ` (representing (indexed) "edges") into subsets of ` v ` of cardinality one or two, representing the two vertices incident to the edge, or the one vertex if the edge is a loop. In contrast to a pseudograph, there is at most one edge between two vertices resp. at most one loop for a vertex. (Contributed by Alexander van der Vekens, 10-Aug-2017.) (Revised by AV, 13-Oct-2020.)
axiom df_uspgr {x3 v e g2: setvar}:
  $ wceq cuspgr (cab g2 (wsbc v (wsbc e (wf1 (cdm (cv e)) (crab x3 (wbr (cfv (cv x3) chash) c2 cle) (cdif (cpw (cv v)) (csn c0))) (cv e)) (cfv (cv g2) ciedg)) (cfv (cv g2) cvtx))) $;

--| Define the class of all undirected simple graphs (without loops). An undirected simple graph is a special undirected simple pseudograph (see ~ usgruspgr ), consisting of a set ` v ` (of "vertices") and an injective (one-to-one) function ` e ` (representing (indexed) "edges") into subsets of ` v ` of cardinality two, representing the two vertices incident to the edge. In contrast to an undirected simple pseudograph, an undirected simple graph has no loops (edges connecting a vertex with itself). (Contributed by Alexander van der Vekens, 10-Aug-2017.) (Revised by AV, 13-Oct-2020.)
axiom df_usgr {x3 v e g2: setvar}:
  $ wceq cusgr (cab g2 (wsbc v (wsbc e (wf1 (cdm (cv e)) (crab x3 (wceq (cfv (cv x3) chash) c2) (cdif (cpw (cv v)) (csn c0))) (cv e)) (cfv (cv g2) ciedg)) (cfv (cv g2) cvtx))) $;

--| The property of being a simple pseudograph. (Contributed by Alexander van der Vekens, 10-Aug-2017.) (Revised by AV, 13-Oct-2020.)
theorem isuspgr {x3: setvar} (U E: class x3) (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (wcel G U) (wb (wcel G cuspgr) (wf1 (cdm E) (crab x3 (wbr (cfv (cv x3) chash) c2 cle) (cdif (cpw V) (csn c0))) E)) $;

--| The property of being a simple graph. (Contributed by Alexander van der Vekens, 10-Aug-2017.) (Revised by AV, 13-Oct-2020.)
theorem isusgr {x3: setvar} (U E: class x3) (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (wcel G U) (wb (wcel G cusgr) (wf1 (cdm E) (crab x3 (wceq (cfv (cv x3) chash) c2) (cdif (cpw V) (csn c0))) E)) $;

--| The edge function of a simple pseudograph is a one-to-one function into unordered pairs of vertices. (Contributed by Alexander van der Vekens, 10-Aug-2017.) (Revised by AV, 13-Oct-2020.)
theorem uspgrf {x3: setvar} (E: class x3) (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (wcel G cuspgr) (wf1 (cdm E) (crab x3 (wbr (cfv (cv x3) chash) c2 cle) (cdif (cpw V) (csn c0))) E) $;

--| The edge function of a simple graph is a one-to-one function into the set of proper unordered pairs of vertices. (Contributed by Alexander van der Vekens, 10-Aug-2017.) (Revised by AV, 13-Oct-2020.)
theorem usgrf {x3: setvar} (E: class x3) (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (wcel G cusgr) (wf1 (cdm E) (crab x3 (wceq (cfv (cv x3) chash) c2) (cdif (cpw V) (csn c0))) E) $;

--| The property of being a simple graph, simplified version of ~ isusgr . (Contributed by Alexander van der Vekens, 13-Aug-2017.) (Revised by AV, 13-Oct-2020.) (Proof shortened by AV, 24-Nov-2020.)
theorem isusgrs {x3: setvar} (U: class) (E: class x3) (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (wcel G U) (wb (wcel G cusgr) (wf1 (cdm E) (crab x3 (wceq (cfv (cv x3) chash) c2) (cpw V)) E)) $;

--| The edge function of a simple graph is a one-to-one function into unordered pairs of vertices. Simplified version of ~ usgrf . (Contributed by Alexander van der Vekens, 13-Aug-2017.) (Revised by AV, 13-Oct-2020.)
theorem usgrfs {x3: setvar} (E: class x3) (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (wcel G cusgr) (wf1 (cdm E) (crab x3 (wceq (cfv (cv x3) chash) c2) (cpw V)) E) $;

--| The edge function of a simple graph is a function. (Contributed by Alexander van der Vekens, 18-Aug-2017.) (Revised by AV, 13-Oct-2020.)
theorem usgrfun (G: class):
  $ wi (wcel G cusgr) (wfun (cfv G ciedg)) $;

--| The set of edges of a simple graph is a subset of the set of proper unordered pairs of vertices. (Contributed by AV, 1-Jan-2020.) (Revised by AV, 14-Oct-2020.)
theorem usgredgss {x3: setvar} (G: class):
  $ wi (wcel G cusgr) (wss (cfv G cedg) (crab x3 (wceq (cfv (cv x3) chash) c2) (cpw (cfv G cvtx)))) $;

--| An edge of a simple graph is a proper unordered pair of vertices. (Contributed by AV, 1-Jan-2020.) (Revised by AV, 14-Oct-2020.)
theorem edgusgr (E G: class):
  $ wi (wa (wcel G cusgr) (wcel E (cfv G cedg))) (wa (wcel E (cpw (cfv G cvtx))) (wceq (cfv E chash) c2)) $;

--| The property of being an undirected simple pseudograph represented as an ordered pair. The representation as an ordered pair is the usual representation of a graph, see section I.1 of [Bollobas] p. 1. (Contributed by AV, 25-Nov-2021.)
theorem isuspgrop {p: setvar} (E V W X: class):
  $ wi (wa (wcel V W) (wcel E X)) (wb (wcel (cop V E) cuspgr) (wf1 (cdm E) (crab p (wbr (cfv (cv p) chash) c2 cle) (cdif (cpw V) (csn c0))) E)) $;

--| The property of being an undirected simple graph represented as an ordered pair. The representation as an ordered pair is the usual representation of a graph, see section I.1 of [Bollobas] p. 1. (Contributed by AV, 30-Nov-2020.)
theorem isusgrop {p: setvar} (E V W X: class):
  $ wi (wa (wcel V W) (wcel E X)) (wb (wcel (cop V E) cusgr) (wf1 (cdm E) (crab p (wceq (cfv (cv p) chash) c2) (cpw V)) E)) $;

--| A simple graph represented by an ordered pair. (Contributed by AV, 23-Oct-2020.) (Proof shortened by AV, 30-Nov-2020.)
theorem usgrop (G: class):
  $ wi (wcel G cusgr) (wcel (cop (cfv G cvtx) (cfv G ciedg)) cusgr) $;

--| The property of an ordered pair to be an alternatively defined simple graph, defined as a pair (V,E) of a set V (vertex set) and a set of unordered pairs of elements of V (edge set). (Contributed by Alexander van der Vekens, 28-Aug-2017.)
theorem isausgr {x3 v e: setvar} (E: class) (G: class x3 v e) (V: class) (W: class x3 v e) (X: class v e):
  $ wceq G (copab v e (wss (cv e) (crab x3 (wceq (cfv (cv x3) chash) c2) (cpw (cv v))))) $ >
  $ wi (wa (wcel V W) (wcel E X)) (wb (wbr V E G) (wss E (crab x3 (wceq (cfv (cv x3) chash) c2) (cpw V)))) $;

--| The equivalence of the definitions of a simple graph. (Contributed by Alexander van der Vekens, 28-Aug-2017.) (Revised by AV, 14-Oct-2020.)
theorem ausgrusgrb {x3 v e: setvar} (E: class) (G: class x3 v e) (V: class) (X Y: class v e):
  $ wceq G (copab v e (wss (cv e) (crab x3 (wceq (cfv (cv x3) chash) c2) (cpw (cv v))))) $ >
  $ wi (wa (wcel V X) (wcel E Y)) (wb (wbr V E G) (wcel (cop V (cres cid E)) cusgr)) $;

--| A simple graph represented by an alternatively defined simple graph. (Contributed by AV, 15-Oct-2020.)
theorem usgrausgri {x3 v e: setvar} (G: class x3 v e) (H: class):
  $ wceq G (copab v e (wss (cv e) (crab x3 (wceq (cfv (cv x3) chash) c2) (cpw (cv v))))) $ >
  $ wi (wcel H cusgr) (wbr (cfv H cvtx) (cfv H cedg) G) $;

--| If an alternatively defined simple graph has the vertices and edges of an arbitrary graph, the arbitrary graph is an undirected multigraph. (Contributed by AV, 18-Oct-2020.) (Revised by AV, 25-Nov-2020.)
theorem ausgrumgri {x3 v e: setvar} (G: class x3 v e) (H: class) (W: class x3 v e):
  $ wceq G (copab v e (wss (cv e) (crab x3 (wceq (cfv (cv x3) chash) c2) (cpw (cv v))))) $ >
  $ wi (w3a (wcel H W) (wbr (cfv H cvtx) (cfv H cedg) G) (wfun (cfv H ciedg))) (wcel H cumgr) $;

--| The equivalence of the definitions of a simple graph, expressed with the set of vertices and the set of edges. (Contributed by AV, 15-Oct-2020.)
theorem ausgrusgri {x3 v e f2: setvar} (G: class x3 v e f2) (H: class) (O: class x3 v e f2) (W: class v e f2):
  $ wceq G (copab v e (wss (cv e) (crab x3 (wceq (cfv (cv x3) chash) c2) (cpw (cv v))))) $ >
  $ wceq O (cab f2 (wf1 (cdm (cv f2)) (crn (cv f2)) (cv f2))) $ >
  $ wi (w3a (wcel H W) (wbr (cfv H cvtx) (cfv H cedg) G) (wcel (cfv H ciedg) O)) (wcel H cusgr) $;

--| The equivalence of the definitions of a simple graph, expressed with the set of vertices and the set of edges. (Contributed by AV, 2-Jan-2020.) (Revised by AV, 15-Oct-2020.)
theorem usgrausgrb {x3 v e f2: setvar} (G: class x3 v e f2) (H: class) (O: class x3 v e f2) (W: class v e f2):
  $ wceq G (copab v e (wss (cv e) (crab x3 (wceq (cfv (cv x3) chash) c2) (cpw (cv v))))) $ >
  $ wceq O (cab f2 (wf1 (cdm (cv f2)) (crn (cv f2)) (cv f2))) $ >
  $ wi (wa (wcel H W) (wcel (cfv H ciedg) O)) (wb (wbr (cfv H cvtx) (cfv H cedg) G) (wcel H cusgr)) $;

--| An edge of a simple graph as second component of an ordered pair. (Contributed by Alexander van der Vekens, 17-Aug-2017.) (Proof shortened by Alexander van der Vekens, 16-Dec-2017.) (Revised by AV, 15-Oct-2020.)
theorem usgredgop (E G M N X: class):
  $ wi (w3a (wcel G cusgr) (wceq E (cfv G ciedg)) (wcel X (cdm E))) (wb (wceq (cfv X E) (cpr M N)) (wcel (cop X (cpr M N)) E)) $;

--| The edge function of a simple graph is a bijective function onto its range. (Contributed by Alexander van der Vekens, 18-Nov-2017.) (Revised by AV, 15-Oct-2020.)
theorem usgrf1o (E G: class):
  $ wceq E (cfv G ciedg) $ >
  $ wi (wcel G cusgr) (wf1o (cdm E) (crn E) E) $;

--| The edge function of a simple graph is a one to one function. (Contributed by Alexander van der Vekens, 18-Nov-2017.) (Revised by AV, 15-Oct-2020.)
theorem usgrf1 (E G: class):
  $ wceq E (cfv G ciedg) $ >
  $ wi (wcel G cusgr) (wf1 (cdm E) (crn E) E) $;

--| The edge function of a simple pseudograph is a bijective function onto the edges of the graph. (Contributed by AV, 2-Jan-2020.) (Revised by AV, 15-Oct-2020.)
theorem uspgrf1oedg (E G: class):
  $ wceq E (cfv G ciedg) $ >
  $ wi (wcel G cuspgr) (wf1o (cdm E) (cfv G cedg) E) $;

--| An edge is a subset of vertices. (Contributed by Alexander van der Vekens, 19-Aug-2017.) (Revised by AV, 15-Oct-2020.)
theorem usgrss (E G V X: class):
  $ wceq E (cfv G ciedg) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel G cusgr) (wcel X (cdm E))) (wss (cfv X E) V) $;

--| In a simple pseudograph, for each edge there is exactly one indexed edge. (Contributed by AV, 20-Apr-2025.)
theorem uspgredgiedg {x3: setvar} (E: class) (G: class x3) (I K: class):
  $ wceq E (cfv G cedg) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi (wa (wcel G cuspgr) (wcel K E)) (wreu x3 (wceq K (cfv (cv x3) I)) (cdm I)) $;

--| In a simple pseudograph, for each indexed edge there is exactly one edge. (Contributed by AV, 20-Apr-2025.)
theorem uspgriedgedg {k: setvar} (E: class) (G: class k) (I X: class):
  $ wceq E (cfv G cedg) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi (wa (wcel G cuspgr) (wcel X (cdm I))) (wreu k (wceq (cv k) (cfv X I)) E) $;

--| A simple pseudograph is an undirected simple hypergraph. (Contributed by AV, 19-Jan-2020.) (Revised by AV, 15-Oct-2020.)
theorem uspgrushgr (G: class):
  $ wi (wcel G cuspgr) (wcel G cushgr) $;

--| A simple pseudograph is an undirected pseudograph. (Contributed by Alexander van der Vekens, 10-Aug-2017.) (Revised by AV, 15-Oct-2020.)
theorem uspgrupgr (G: class):
  $ wi (wcel G cuspgr) (wcel G cupgr) $;

--| A graph is a simple pseudograph iff it is a pseudograph and a simple hypergraph. (Contributed by AV, 30-Nov-2020.)
theorem uspgrupgrushgr (G: class):
  $ wb (wcel G cuspgr) (wa (wcel G cupgr) (wcel G cushgr)) $;

--| A simple graph is a simple pseudograph. (Contributed by Alexander van der Vekens, 10-Aug-2017.) (Revised by AV, 15-Oct-2020.)
theorem usgruspgr (G: class):
  $ wi (wcel G cusgr) (wcel G cuspgr) $;

--| A simple graph is an undirected multigraph. (Contributed by AV, 25-Nov-2020.)
theorem usgrumgr (G: class):
  $ wi (wcel G cusgr) (wcel G cumgr) $;

--| A graph is a simple graph iff it is a multigraph and a simple pseudograph. (Contributed by AV, 30-Nov-2020.)
theorem usgrumgruspgr (G: class):
  $ wb (wcel G cusgr) (wa (wcel G cumgr) (wcel G cuspgr)) $;

--| A class is a simple graph iff it is a simple pseudograph without loops. (Contributed by AV, 18-Oct-2020.)
theorem usgruspgrb {e: setvar} (G: class):
  $ wb (wcel G cusgr) (wa (wcel G cuspgr) (wral e (wceq (cfv (cv e) chash) c2) (cfv G cedg))) $;

--| An undirected simple pseudograph is an undirected hypergraph. (Contributed by AV, 21-Apr-2025.)
theorem uspgruhgr (G: class):
  $ wi (wcel G cuspgr) (wcel G cuhgr) $;

--| A simple graph is an undirected pseudograph. (Contributed by Alexander van der Vekens, 20-Aug-2017.) (Revised by AV, 15-Oct-2020.)
theorem usgrupgr (G: class):
  $ wi (wcel G cusgr) (wcel G cupgr) $;

--| A simple graph is an undirected hypergraph. (Contributed by AV, 9-Feb-2018.) (Revised by AV, 15-Oct-2020.)
theorem usgruhgr (G: class):
  $ wi (wcel G cusgr) (wcel G cuhgr) $;

--| A simple graph is a loop-free simple pseudograph. (Contributed by AV, 27-Jan-2021.)
theorem usgrislfuspgr {x3: setvar} (G: class) (I: class x3) (V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wb (wcel G cusgr) (wa (wcel G cuspgr) (wf (cdm I) (crab x3 (wbr c2 (cfv (cv x3) chash) cle) (cpw V)) I)) $;

--| The union ` U ` of two simple pseudographs ` G ` and ` H ` with the same vertex set ` V ` is a pseudograph with the vertex ` V ` and the union ` ( E u. F ) ` of the (indexed) edges. (Contributed by AV, 16-Oct-2020.)
theorem uspgrun (ph: wff) (U E F G H V W: class):
  $ wi ph (wcel G cuspgr) $ >
  $ wi ph (wcel H cuspgr) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq F (cfv H ciedg) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wi ph (wceq (cfv H cvtx) V) $ >
  $ wi ph (wceq (cin (cdm E) (cdm F)) c0) $ >
  $ wi ph (wcel U W) $ >
  $ wi ph (wceq (cfv U cvtx) V) $ >
  $ wi ph (wceq (cfv U ciedg) (cun E F)) $ >
  $ wi ph (wcel U cupgr) $;

--| The union of two simple pseudographs (with the same vertex set): If ` <. V , E >. ` and ` <. V , F >. ` are simple pseudographs, then ` <. V , E u. F >. ` is a pseudograph (the vertex set stays the same, but the edges from both graphs are kept, maybe resulting in two edges between two vertices). (Contributed by Alexander van der Vekens, 10-Aug-2017.) (Revised by AV, 16-Oct-2020.) (Revised by AV, 24-Oct-2021.)
theorem uspgrunop (ph: wff) (E F G H V: class):
  $ wi ph (wcel G cuspgr) $ >
  $ wi ph (wcel H cuspgr) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq F (cfv H ciedg) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wi ph (wceq (cfv H cvtx) V) $ >
  $ wi ph (wceq (cin (cdm E) (cdm F)) c0) $ >
  $ wi ph (wcel (cop V (cun E F)) cupgr) $;

--| The union ` U ` of two simple graphs ` G ` and ` H ` with the same vertex set ` V ` is a multigraph (not necessarily a simple graph!) with the vertex ` V ` and the union ` ( E u. F ) ` of the (indexed) edges. (Contributed by AV, 29-Nov-2020.)
theorem usgrun (ph: wff) (U E F G H V W: class):
  $ wi ph (wcel G cusgr) $ >
  $ wi ph (wcel H cusgr) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq F (cfv H ciedg) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wi ph (wceq (cfv H cvtx) V) $ >
  $ wi ph (wceq (cin (cdm E) (cdm F)) c0) $ >
  $ wi ph (wcel U W) $ >
  $ wi ph (wceq (cfv U cvtx) V) $ >
  $ wi ph (wceq (cfv U ciedg) (cun E F)) $ >
  $ wi ph (wcel U cumgr) $;

--| The union of two simple graphs (with the same vertex set): If ` <. V , E >. ` and ` <. V , F >. ` are simple graphs, then ` <. V , E u. F >. ` is a multigraph (not necessarily a simple graph!) - the vertex set stays the same, but the edges from both graphs are kept, possibly resulting in two edges between two vertices. (Contributed by AV, 29-Nov-2020.)
theorem usgrunop (ph: wff) (E F G H V: class):
  $ wi ph (wcel G cusgr) $ >
  $ wi ph (wcel H cusgr) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq F (cfv H ciedg) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wi ph (wceq (cfv H cvtx) V) $ >
  $ wi ph (wceq (cin (cdm E) (cdm F)) c0) $ >
  $ wi ph (wcel (cop V (cun E F)) cumgr) $;

--| The value of the "edge function" of a simple graph is a set containing two elements (the vertices the corresponding edge is connecting). (Contributed by Alexander van der Vekens, 11-Aug-2017.) (Revised by AV, 16-Oct-2020.) (Proof shortened by AV, 11-Dec-2020.)
theorem usgredg2 (E G X: class):
  $ wceq E (cfv G ciedg) $ >
  $ wi (wa (wcel G cusgr) (wcel X (cdm E))) (wceq (cfv (cfv X E) chash) c2) $;

--| Alternate proof of ~ usgredg2 , not using ~ umgredg2 . (Contributed by Alexander van der Vekens, 11-Aug-2017.) (Revised by AV, 16-Oct-2020.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem usgredg2ALT (E G X: class):
  $ wceq E (cfv G ciedg) $ >
  $ wi (wa (wcel G cusgr) (wcel X (cdm E))) (wceq (cfv (cfv X E) chash) c2) $;

--| In a simple graph, an edge is an unordered pair of vertices. (Contributed by Alexander van der Vekens, 19-Aug-2017.) (Revised by AV, 16-Oct-2020.) (Proof shortened by AV, 11-Dec-2020.)
theorem usgredgprv (E G M N V X: class):
  $ wceq E (cfv G ciedg) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel G cusgr) (wcel X (cdm E))) (wi (wceq (cfv X E) (cpr M N)) (wa (wcel M V) (wcel N V))) $;

--| Alternate proof of ~ usgredgprv , using ~ usgredg2 instead of ~ umgredgprv . (Contributed by Alexander van der Vekens, 19-Aug-2017.) (Revised by AV, 16-Oct-2020.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem usgredgprvALT (E G M N V X: class):
  $ wceq E (cfv G ciedg) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel G cusgr) (wcel X (cdm E))) (wi (wceq (cfv X E) (cpr M N)) (wa (wcel M V) (wcel N V))) $;

--| An edge of a simple graph is a proper pair, i.e. a set containing two different elements (the endvertices of the edge). Analogue of ~ usgredg2 . (Contributed by Alexander van der Vekens, 11-Aug-2017.) (Revised by AV, 9-Jan-2020.) (Revised by AV, 23-Oct-2020.)
theorem usgredgppr (C E G: class):
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cusgr) (wcel C E)) (wceq (cfv C chash) c2) $;

--| An edge of a simple graph always connects two vertices. Analogue of ~ usgredgprv . (Contributed by Alexander van der Vekens, 7-Oct-2017.) (Revised by AV, 9-Jan-2020.) (Revised by AV, 23-Oct-2020.) (Proof shortened by AV, 27-Nov-2020.)
theorem usgrpredgv (E G M N V: class):
  $ wceq E (cfv G cedg) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel G cusgr) (wcel (cpr M N) E)) (wa (wcel M V) (wcel N V)) $;

--| An edge of a simple graph is a proper unordered pair of vertices, i.e. a subset of the set of vertices of size 2. (Contributed by AV, 10-Jan-2020.) (Revised by AV, 23-Oct-2020.)
theorem edgssv2 (C E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cusgr) (wcel C E)) (wa (wss C V) (wceq (cfv C chash) c2)) $;

--| For each edge in a simple graph, there are two distinct vertices which are connected by this edge. (Contributed by Alexander van der Vekens, 9-Dec-2017.) (Revised by AV, 17-Oct-2020.) (Shortened by AV, 25-Nov-2020.)
theorem usgredg {a b: setvar} (C: class) (E: class a b) (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cusgr) (wcel C E)) (wrex a (wrex b (wa (wne (cv a) (cv b)) (wceq C (cpr (cv a) (cv b)))) V) V) $;

--| In a simple graph, there is no loop, i.e. no edge connecting a vertex with itself. (Contributed by Alexander van der Vekens, 26-Jan-2018.) (Revised by AV, 17-Oct-2020.) (Proof shortened by AV, 11-Dec-2020.)
theorem usgrnloopv (E G M N W X: class):
  $ wceq E (cfv G ciedg) $ >
  $ wi (wa (wcel G cusgr) (wcel M W)) (wi (wceq (cfv X E) (cpr M N)) (wne M N)) $;

--| Alternate proof of ~ usgrnloopv , not using ~ umgrnloopv . (Contributed by Alexander van der Vekens, 26-Jan-2018.) (Revised by AV, 17-Oct-2020.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem usgrnloopvALT (E G M N W X: class):
  $ wceq E (cfv G ciedg) $ >
  $ wi (wa (wcel G cusgr) (wcel M W)) (wi (wceq (cfv X E) (cpr M N)) (wne M N)) $;

--| In a simple graph, there is no loop, i.e. no edge connecting a vertex with itself. (Contributed by Alexander van der Vekens, 19-Aug-2017.) (Proof shortened by Alexander van der Vekens, 20-Mar-2018.) (Revised by AV, 17-Oct-2020.) (Proof shortened by AV, 11-Dec-2020.)
theorem usgrnloop {x3: setvar} (E: class x3) (G M N: class):
  $ wceq E (cfv G ciedg) $ >
  $ wi (wcel G cusgr) (wi (wrex x3 (wceq (cfv (cv x3) E) (cpr M N)) (cdm E)) (wne M N)) $;

--| Alternate proof of ~ usgrnloop , not using ~ umgrnloop . (Contributed by Alexander van der Vekens, 19-Aug-2017.) (Proof shortened by Alexander van der Vekens, 20-Mar-2018.) (Revised by AV, 17-Oct-2020.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem usgrnloopALT {x3: setvar} (E: class x3) (G M N: class):
  $ wceq E (cfv G ciedg) $ >
  $ wi (wcel G cusgr) (wi (wrex x3 (wceq (cfv (cv x3) E) (cpr M N)) (cdm E)) (wne M N)) $;

--| A simple graph has no loops. (Contributed by Alexander van der Vekens, 6-Dec-2017.) (Revised by AV, 17-Oct-2020.) (Proof shortened by AV, 11-Dec-2020.)
theorem usgrnloop0 {x3: setvar} (U: class) (E: class x3) (G: class):
  $ wceq E (cfv G ciedg) $ >
  $ wi (wcel G cusgr) (wceq (crab x3 (wceq (cfv (cv x3) E) (csn U)) (cdm E)) c0) $;

--| Alternate proof of ~ usgrnloop0 , not using ~ umgrnloop0 . (Contributed by Alexander van der Vekens, 6-Dec-2017.) (Revised by AV, 17-Oct-2020.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem usgrnloop0ALT {x3: setvar} (U: class) (E: class x3) (G: class):
  $ wceq E (cfv G ciedg) $ >
  $ wi (wcel G cusgr) (wceq (crab x3 (wceq (cfv (cv x3) E) (csn U)) (cdm E)) c0) $;

--| An edge of a simple graph always connects two different vertices. Analogue of ~ usgrnloopv resp. ~ usgrnloop . (Contributed by Alexander van der Vekens, 2-Sep-2017.) (Revised by AV, 17-Oct-2020.) (Proof shortened by AV, 27-Nov-2020.)
theorem usgredgne (E G M N: class):
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cusgr) (wcel (cpr M N) E)) (wne M N) $;

--| The edge function of a simple graph is a 1-1 function onto the set of edges. (Contributed by AV, 18-Oct-2020.)
theorem usgrf1oedg (E G I: class):
  $ wceq I (cfv G ciedg) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wcel G cusgr) (wf1o (cdm I) E I) $;

--| If a vertex is adjacent to two different vertices in a hypergraph, there are more than one edges starting at this vertex. (Contributed by Alexander van der Vekens, 10-Dec-2017.) (Revised by AV, 11-Feb-2021.)
theorem uhgr2edg {x3 y1: setvar} (A2 B2: class) (E: class x3 y1) (G I N V: class):
  $ wceq I (cfv G ciedg) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wi (w3a (wa (wcel G cuhgr) (wne A2 B2)) (w3a (wcel A2 V) (wcel B2 V) (wcel N V)) (wa (wcel (cpr N A2) E) (wcel (cpr B2 N) E))) (wrex x3 (wrex y1 (w3a (wne (cv x3) (cv y1)) (wcel N (cfv (cv x3) I)) (wcel N (cfv (cv y1) I))) (cdm I)) (cdm I)) $;

--| If a vertex is adjacent to two different vertices in a multigraph, there are more than one edges starting at this vertex. (Contributed by Alexander van der Vekens, 10-Dec-2017.) (Revised by AV, 11-Feb-2021.)
theorem umgr2edg {x3 y1: setvar} (A2 B2: class) (E: class x3 y1) (G I N: class):
  $ wceq I (cfv G ciedg) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wa (wcel G cumgr) (wne A2 B2)) (wa (wcel (cpr N A2) E) (wcel (cpr B2 N) E))) (wrex x3 (wrex y1 (w3a (wne (cv x3) (cv y1)) (wcel N (cfv (cv x3) I)) (wcel N (cfv (cv y1) I))) (cdm I)) (cdm I)) $;

--| If a vertex is adjacent to two different vertices in a simple graph, there are more than one edges starting at this vertex. (Contributed by Alexander van der Vekens, 10-Dec-2017.) (Revised by AV, 17-Oct-2020.) (Proof shortened by AV, 11-Feb-2021.)
theorem usgr2edg {x3 y1: setvar} (A2 B2: class) (E: class x3 y1) (G I N: class):
  $ wceq I (cfv G ciedg) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wa (wcel G cusgr) (wne A2 B2)) (wa (wcel (cpr N A2) E) (wcel (cpr B2 N) E))) (wrex x3 (wrex y1 (w3a (wne (cv x3) (cv y1)) (wcel N (cfv (cv x3) I)) (wcel N (cfv (cv y1) I))) (cdm I)) (cdm I)) $;

--| If a vertex is adjacent to two different vertices in a multigraph, there is not only one edge starting at this vertex. (Contributed by Alexander van der Vekens, 10-Dec-2017.) (Revised by AV, 8-Jun-2021.)
theorem umgr2edg1 {x3: setvar} (A2 B2: class) (E: class x3) (G I N: class):
  $ wceq I (cfv G ciedg) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wa (wcel G cumgr) (wne A2 B2)) (wa (wcel (cpr N A2) E) (wcel (cpr B2 N) E))) (wn (wreu x3 (wcel N (cfv (cv x3) I)) (cdm I))) $;

--| If a vertex is adjacent to two different vertices in a simple graph, there is not only one edge starting at this vertex. (Contributed by Alexander van der Vekens, 10-Dec-2017.) (Revised by AV, 17-Oct-2020.) (Proof shortened by AV, 8-Jun-2021.)
theorem usgr2edg1 {x3: setvar} (A2 B2: class) (E: class x3) (G I N: class):
  $ wceq I (cfv G ciedg) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wa (wcel G cusgr) (wne A2 B2)) (wa (wcel (cpr N A2) E) (wcel (cpr B2 N) E))) (wn (wreu x3 (wcel N (cfv (cv x3) I)) (cdm I))) $;

--| If a vertex is adjacent to two different vertices in a multigraph, there are more than one edges starting at this vertex, analogous to ~ usgr2edg . (Contributed by Alexander van der Vekens, 10-Dec-2017.) (Revised by AV, 9-Jan-2020.) (Revised by AV, 8-Jun-2021.)
theorem umgrvad2edg {x3 y1: setvar} (A2 B2 E G N: class):
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wa (wcel G cumgr) (wne A2 B2)) (wa (wcel (cpr N A2) E) (wcel (cpr B2 N) E))) (wrex x3 (wrex y1 (w3a (wne (cv x3) (cv y1)) (wcel N (cv x3)) (wcel N (cv y1))) E) E) $;

--| If a vertex is adjacent to two different vertices in a multigraph, there is not only one edge starting at this vertex, analogous to ~ usgr2edg1 . Lemma for theorems about friendship graphs. (Contributed by Alexander van der Vekens, 10-Dec-2017.) (Revised by AV, 9-Jan-2020.)
theorem umgr2edgneu {x3: setvar} (A2 B2 E G N: class):
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wa (wcel G cumgr) (wne A2 B2)) (wa (wcel (cpr N A2) E) (wcel (cpr B2 N) E))) (wn (wreu x3 (wcel N (cv x3)) E)) $;

--| In a simple graph, the size of the edge function is the number of the edges of the graph. (Contributed by AV, 4-Jan-2020.) (Revised by AV, 7-Jun-2021.)
theorem usgrsizedg (G: class):
  $ wi (wcel G cusgr) (wceq (cfv (cfv G ciedg) chash) (cfv (cfv G cedg) chash)) $;

--| The value of the "edge function" of a simple graph is a set containing two elements (the endvertices of the corresponding edge). (Contributed by Alexander van der Vekens, 18-Dec-2017.) (Revised by AV, 17-Oct-2020.)
theorem usgredg3 {x3 y1: setvar} (E G V X: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (wa (wcel G cusgr) (wcel X (cdm E))) (wrex x3 (wrex y1 (wa (wne (cv x3) (cv y1)) (wceq (cfv X E) (cpr (cv x3) (cv y1)))) V) V) $;

--| For a vertex incident to an edge there is another vertex incident to the edge. (Contributed by Alexander van der Vekens, 18-Dec-2017.) (Revised by AV, 17-Oct-2020.)
theorem usgredg4 {y1: setvar} (E G V X Y: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (w3a (wcel G cusgr) (wcel X (cdm E)) (wcel Y (cfv X E))) (wrex y1 (wceq (cfv X E) (cpr Y (cv y1))) V) $;

--| For a vertex incident to an edge there is exactly one other vertex incident to the edge. (Contributed by Alexander van der Vekens, 4-Jan-2018.) (Revised by AV, 18-Oct-2020.)
theorem usgredgreu {y1: setvar} (E G V X Y: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (w3a (wcel G cusgr) (wcel X (cdm E)) (wcel Y (cfv X E))) (wreu y1 (wceq (cfv X E) (cpr Y (cv y1))) V) $;

--| For a vertex incident to an edge there is another vertex incident to the edge in a simple graph. (Contributed by AV, 18-Oct-2020.) (Proof shortened by AV, 5-Dec-2020.)
theorem usgredg2vtx {y1: setvar} (E G Y: class):
  $ wi (w3a (wcel G cusgr) (wcel E (cfv G cedg)) (wcel Y E)) (wrex y1 (wceq E (cpr Y (cv y1))) (cfv G cvtx)) $;

--| For a vertex incident to an edge there is exactly one other vertex incident to the edge in a simple pseudograph. (Contributed by AV, 18-Oct-2020.) (Revised by AV, 6-Dec-2020.)
theorem uspgredg2vtxeu {y1: setvar} (E G Y: class):
  $ wi (w3a (wcel G cuspgr) (wcel E (cfv G cedg)) (wcel Y E)) (wreu y1 (wceq E (cpr Y (cv y1))) (cfv G cvtx)) $;

--| For a vertex incident to an edge there is exactly one other vertex incident to the edge in a simple graph. (Contributed by AV, 18-Oct-2020.) (Proof shortened by AV, 6-Dec-2020.)
theorem usgredg2vtxeu {y1: setvar} (E G Y: class):
  $ wi (w3a (wcel G cusgr) (wcel E (cfv G cedg)) (wcel Y E)) (wreu y1 (wceq E (cpr Y (cv y1))) (cfv G cvtx)) $;

--| Alternate proof of ~ usgredg2vtxeu , using ~ edgiedgb , the general translation from ` ( iEdg `` G ) ` to ` ( Edg `` G ) ` . (Contributed by AV, 18-Oct-2020.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem usgredg2vtxeuALT {y1: setvar} (E G Y: class):
  $ wi (w3a (wcel G cusgr) (wcel E (cfv G cedg)) (wcel Y E)) (wreu y1 (wceq E (cpr Y (cv y1))) (cfv G cvtx)) $;

--| Lemma for ~ uspgredg2v . (Contributed by Alexander van der Vekens, 4-Jan-2018.) (Revised by AV, 6-Dec-2020.)
theorem uspgredg2vlem {z e: setvar} (A2: class z e) (E: class z) (G: class e) (N: class) (V: class e) (Y: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq A2 (crab e (wcel N (cv e)) E) $ >
  $ wi (wa (wcel G cuspgr) (wcel Y A2)) (wcel (crio z (wceq Y (cpr N (cv z))) V) V) $;

--| In a simple pseudograph, the mapping of edges having a fixed endpoint to the "other" vertex of the edge (which may be the fixed vertex itself in the case of a loop) is a one-to-one function into the set of vertices. (Contributed by Alexander van der Vekens, 4-Jan-2018.) (Revised by AV, 6-Dec-2020.)
theorem uspgredg2v {y1 z e: setvar} (A2: class z e) (E: class y1 z) (F: class y1 z e) (G: class e) (N: class) (V: class e):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq A2 (crab e (wcel N (cv e)) E) $ >
  $ wceq F (cmpt y1 A2 (crio z (wceq (cv y1) (cpr N (cv z))) V)) $ >
  $ wi (wa (wcel G cuspgr) (wcel N V)) (wf1 A2 V F) $;

--| Lemma 1 for ~ usgredg2v . (Contributed by Alexander van der Vekens, 4-Jan-2018.) (Revised by AV, 18-Oct-2020.)
theorem usgredg2vlem1 {x3 z: setvar} (A2: class x3 z) (E: class) (G: class x3) (N: class) (V: class x3) (Y: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq A2 (crab x3 (wcel N (cfv (cv x3) E)) (cdm E)) $ >
  $ wi (wa (wcel G cusgr) (wcel Y A2)) (wcel (crio z (wceq (cfv Y E) (cpr (cv z) N)) V) V) $;

--| Lemma 2 for ~ usgredg2v . (Contributed by Alexander van der Vekens, 4-Jan-2018.) (Revised by AV, 18-Oct-2020.)
theorem usgredg2vlem2 {x3 z: setvar} (A2: class x3 z) (E: class) (G I: class x3) (N: class) (V: class x3) (Y: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq A2 (crab x3 (wcel N (cfv (cv x3) E)) (cdm E)) $ >
  $ wi (wa (wcel G cusgr) (wcel Y A2)) (wi (wceq I (crio z (wceq (cfv Y E) (cpr (cv z) N)) V)) (wceq (cfv Y E) (cpr I N))) $;

--| In a simple graph, the mapping of edges having a fixed endpoint to the other vertex of the edge is a one-to-one function into the set of vertices. (Contributed by Alexander van der Vekens, 4-Jan-2018.) (Revised by AV, 18-Oct-2020.)
theorem usgredg2v {x3 y1 z: setvar} (A2: class x3 z) (E: class) (F: class x3 y1 z) (G: class x3) (N: class) (V: class x3):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq A2 (crab x3 (wcel N (cfv (cv x3) E)) (cdm E)) $ >
  $ wceq F (cmpt y1 A2 (crio z (wceq (cfv (cv y1) E) (cpr (cv z) N)) V)) $ >
  $ wi (wa (wcel G cusgr) (wcel N V)) (wf1 A2 V F) $;

--| Alternate version of ~ usgredgleord , not using the notation ` ( Edg `` G ) ` . In a simple graph the number of edges which contain a given vertex is not greater than the number of vertices. (Contributed by Alexander van der Vekens, 4-Jan-2018.) (Revised by AV, 18-Oct-2020.)
theorem usgriedgleord {x3: setvar} (E: class) (G: class x3) (N: class) (V: class x3):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (wa (wcel G cusgr) (wcel N V)) (wbr (cfv (crab x3 (wcel N (cfv (cv x3) E)) (cdm E)) chash) (cfv V chash) cle) $;

--| In a simple hypergraph there is a 1-1 onto mapping between the indexed edges containing a fixed vertex and the set of edges containing this vertex. (Contributed by AV, 11-Dec-2020.)
theorem ushgredgedg {x3 e i: setvar} (A2: class x3 e i) (B2: class x3 i) (E: class x3) (F: class x3 e i) (G I N V: class):
  $ wceq E (cfv G cedg) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wceq A2 (crab i (wcel N (cfv (cv i) I)) (cdm I)) $ >
  $ wceq B2 (crab e (wcel N (cv e)) E) $ >
  $ wceq F (cmpt x3 A2 (cfv (cv x3) I)) $ >
  $ wi (wa (wcel G cushgr) (wcel N V)) (wf1o A2 B2 F) $;

--| In a simple graph there is a 1-1 onto mapping between the indexed edges containing a fixed vertex and the set of edges containing this vertex. (Contributed by AV, 18-Oct-2020.) (Proof shortened by AV, 11-Dec-2020.)
theorem usgredgedg {x3 e i: setvar} (A2: class x3 e i) (B2: class x3 i) (E: class x3) (F: class x3 e i) (G I N V: class):
  $ wceq E (cfv G cedg) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wceq A2 (crab i (wcel N (cfv (cv i) I)) (cdm I)) $ >
  $ wceq B2 (crab e (wcel N (cv e)) E) $ >
  $ wceq F (cmpt x3 A2 (cfv (cv x3) I)) $ >
  $ wi (wa (wcel G cusgr) (wcel N V)) (wf1o A2 B2 F) $;

--| In a simple hypergraph there is a 1-1 onto mapping between the indexed edges being loops at a fixed vertex ` N ` and the set of loops at this vertex ` N ` . (Contributed by AV, 11-Dec-2020.) (Revised by AV, 6-Jul-2022.)
theorem ushgredgedgloop {x3 e i: setvar} (A2: class x3 e i) (B2: class x3 i) (E: class x3) (F: class x3 e i) (G I N V: class):
  $ wceq E (cfv G cedg) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq A2 (crab i (wceq (cfv (cv i) I) (csn N)) (cdm I)) $ >
  $ wceq B2 (crab e (wceq (cv e) (csn N)) E) $ >
  $ wceq F (cmpt x3 A2 (cfv (cv x3) I)) $ >
  $ wi (wa (wcel G cushgr) (wcel N V)) (wf1o A2 B2 F) $;

--| In a simple pseudograph the number of edges which contain a given vertex is not greater than the number of vertices. (Contributed by Alexander van der Vekens, 4-Jan-2018.) (Revised by AV, 6-Dec-2020.)
theorem uspgredgleord {e: setvar} (E: class) (G: class e) (N: class) (V: class e):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cuspgr) (wcel N V)) (wbr (cfv (crab e (wcel N (cv e)) E) chash) (cfv V chash) cle) $;

--| In a simple graph the number of edges which contain a given vertex is not greater than the number of vertices. (Contributed by Alexander van der Vekens, 4-Jan-2018.) (Revised by AV, 18-Oct-2020.) (Proof shortened by AV, 6-Dec-2020.)
theorem usgredgleord {e: setvar} (E: class) (G: class e) (N: class) (V: class e):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cusgr) (wcel N V)) (wbr (cfv (crab e (wcel N (cv e)) E) chash) (cfv V chash) cle) $;

--| Alternate proof for ~ usgredgleord based on ~ usgriedgleord . In a simple graph the number of edges which contain a given vertex is not greater than the number of vertices. (Contributed by Alexander van der Vekens, 4-Jan-2018.) (Revised by AV, 18-Oct-2020.) (Proof shortened by AV, 5-May-2021.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem usgredgleordALT {e: setvar} (E: class) (G: class e) (N: class) (V: class e):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cusgr) (wcel N V)) (wbr (cfv (crab e (wcel N (cv e)) E) chash) (cfv V chash) cle) $;

--| Replacing (or adding) the edges (between elements of the base set) of an extensible structure results in a simple graph. Instead of requiring ` ( ph -> G Struct X ) ` , it would be sufficient to require ` ( ph -> Fun ( G \ { (/) } ) ) ` and ` ( ph -> G e. _V ) ` . (Contributed by AV, 13-Nov-2021.) (Proof shortened by AV, 16-Nov-2021.)
theorem usgrstrrepe {x3: setvar} (ph: wff) (E G I V: class) (W X: class x3):
  $ wceq V (cfv G cbs) $ >
  $ wceq I (cfv cnx cedgf) $ >
  $ wi ph (wbr G X cstr) $ >
  $ wi ph (wcel (cfv cnx cbs) (cdm G)) $ >
  $ wi ph (wcel E W) $ >
  $ wi ph (wf1 (cdm E) (crab x3 (wceq (cfv (cv x3) chash) c2) (cpw V)) E) $ >
  $ wi ph (wcel (co G (cop I E) csts) cusgr) $;

--| The empty graph, with vertices but no edges, is a simple graph. (Contributed by Alexander van der Vekens, 10-Aug-2017.) (Revised by AV, 16-Oct-2020.) (Proof shortened by AV, 25-Nov-2020.)
theorem usgr0e (ph: wff) (G W: class):
  $ wi ph (wcel G W) $ >
  $ wi ph (wceq (cfv G ciedg) c0) $ >
  $ wi ph (wcel G cusgr) $;

--| The null graph, with no vertices, is a simple graph iff the edge function is empty. (Contributed by Alexander van der Vekens, 30-Sep-2017.) (Revised by AV, 16-Oct-2020.)
theorem usgr0vb (G W: class):
  $ wi (wa (wcel G W) (wceq (cfv G cvtx) c0)) (wb (wcel G cusgr) (wceq (cfv G ciedg) c0)) $;

--| The null graph, with no vertices, has no edges. (Contributed by AV, 21-Oct-2020.)
theorem uhgr0v0e (E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cuhgr) (wceq V c0)) (wceq E c0) $;

--| The size of a hypergraph with no vertices (the null graph) is 0. (Contributed by Alexander van der Vekens, 5-Jan-2018.) (Revised by AV, 7-Nov-2020.)
theorem uhgr0vsize0 (E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cuhgr) (wceq (cfv V chash) cc0)) (wceq (cfv E chash) cc0) $;

--| A graph of order 0 (i.e. with 0 vertices) has a finite set of edges. (Contributed by Alexander van der Vekens, 5-Jan-2018.) (Revised by AV, 10-Jan-2020.) (Revised by AV, 8-Jun-2021.)
theorem uhgr0edgfi (G: class):
  $ wi (wa (wcel G cuhgr) (wceq (cfv (cfv G cvtx) chash) cc0)) (wcel (cfv G cedg) cfn) $;

--| The null graph, with no vertices, is a simple graph. (Contributed by AV, 1-Nov-2020.)
theorem usgr0v (G W: class):
  $ wi (w3a (wcel G W) (wceq (cfv G cvtx) c0) (wceq (cfv G ciedg) c0)) (wcel G cusgr) $;

--| The null graph, with no vertices, represented by a hypergraph, is a simple graph. (Contributed by AV, 5-Dec-2020.)
theorem uhgr0vusgr (G: class):
  $ wi (wa (wcel G cuhgr) (wceq (cfv G cvtx) c0)) (wcel G cusgr) $;

--| The null graph represented by an empty set is a simple graph. (Contributed by AV, 16-Oct-2020.)
theorem usgr0:
  $ wcel c0 cusgr $;

--| A simple pseudograph with one edge. (Contributed by Alexander van der Vekens, 10-Aug-2017.) (Revised by AV, 16-Oct-2020.) (Revised by AV, 21-Mar-2021.) (Proof shortened by AV, 17-Apr-2021.)
theorem uspgr1e (ph: wff) (A2 B2 C G V X: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wceq (cfv G ciedg) (csn (cop A2 (cpr B2 C)))) $ >
  $ wi ph (wcel G cuspgr) $;

--| A simple graph with one edge (with additional assumption that ` B =/= C ` since otherwise the edge is a loop!). (Contributed by Alexander van der Vekens, 10-Aug-2017.) (Revised by AV, 18-Oct-2020.)
theorem usgr1e (ph: wff) (A2 B2 C G V X: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wceq (cfv G ciedg) (csn (cop A2 (cpr B2 C)))) $ >
  $ wi ph (wne B2 C) $ >
  $ wi ph (wcel G cusgr) $;

--| The empty graph, with vertices but no edges, is a simple graph. (Contributed by Alexander van der Vekens, 10-Aug-2017.) (Revised by AV, 16-Oct-2020.)
theorem usgr0eop (V W: class):
  $ wi (wcel V W) (wcel (cop V c0) cusgr) $;

--| A simple pseudograph with (at least) two vertices and one edge. (Contributed by Alexander van der Vekens, 10-Aug-2017.) (Revised by AV, 16-Oct-2020.)
theorem uspgr1eop (A2 B2 C V W X: class):
  $ wi (wa (wa (wcel V W) (wcel A2 X)) (wa (wcel B2 V) (wcel C V))) (wcel (cop V (csn (cop A2 (cpr B2 C)))) cuspgr) $;

--| A simple pseudograph with (at least) two vertices and one edge represented by a singleton word. (Contributed by AV, 9-Jan-2021.)
theorem uspgr1ewop (A2 B2 V W: class):
  $ wi (w3a (wcel V W) (wcel A2 V) (wcel B2 V)) (wcel (cop V (cs1 (cpr A2 B2))) cuspgr) $;

--| A simple pseudograph with (at least) one vertex and one edge (a loop). (Contributed by AV, 5-Dec-2020.)
theorem uspgr1v1eop (A2 B2 V W X: class):
  $ wi (w3a (wcel V W) (wcel A2 X) (wcel B2 V)) (wcel (cop V (csn (cop A2 (csn B2)))) cuspgr) $;

--| A simple graph with (at least) two different vertices and one edge. If the two vertices were not different, the edge would be a loop. (Contributed by Alexander van der Vekens, 10-Aug-2017.) (Revised by AV, 18-Oct-2020.)
theorem usgr1eop (A2 B2 C V W X: class):
  $ wi (wa (wa (wcel V W) (wcel A2 X)) (wa (wcel B2 V) (wcel C V))) (wi (wne B2 C) (wcel (cop V (csn (cop A2 (cpr B2 C)))) cusgr)) $;

--| A simple pseudograph with two vertices and one edge represented by a singleton word. (Contributed by AV, 9-Jan-2021.)
theorem uspgr2v1e2w (A2 B2 X Y: class):
  $ wi (wa (wcel A2 X) (wcel B2 Y)) (wcel (cop (cpr A2 B2) (cs1 (cpr A2 B2))) cuspgr) $;

--| A simple graph with two vertices and one edge represented by a singleton word. (Contributed by AV, 9-Jan-2021.)
theorem usgr2v1e2w (A2 B2 X Y: class):
  $ wi (w3a (wcel A2 X) (wcel B2 Y) (wne A2 B2)) (wcel (cop (cpr A2 B2) (cs1 (cpr A2 B2))) cusgr) $;

--| A class without edges is a simple graph. Since ` ran F = (/) ` does not generally imply ` Fun F ` , but ` Fun ( iEdg `` G ) ` is required for ` G ` to be a simple graph, however, this must be provided as assertion. (Contributed by AV, 18-Oct-2020.)
theorem edg0usgr (G W: class):
  $ wi (w3a (wcel G W) (wceq (cfv G cedg) c0) (wfun (cfv G ciedg))) (wcel G cusgr) $;

--| A loop-free hypergraph with one vertex has no edges. (Contributed by AV, 18-Oct-2020.) (Revised by AV, 2-Apr-2021.)
theorem lfuhgr1v0e {x3: setvar} (E: class x3) (G: class) (I: class x3) (V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq E (crab x3 (wbr c2 (cfv (cv x3) chash) cle) (cpw V)) $ >
  $ wi (w3a (wcel G cuhgr) (wceq (cfv V chash) c1) (wf (cdm I) E I)) (wceq (cfv G cedg) c0) $;

--| A simple graph with one vertex has no edges. (Contributed by AV, 18-Oct-2020.) (Revised by AV, 21-Mar-2021.) (Proof shortened by AV, 2-Apr-2021.)
theorem usgr1vr (A2 G X: class):
  $ wi (wa (wcel A2 X) (wceq (cfv G cvtx) (csn A2))) (wi (wcel G cusgr) (wceq (cfv G ciedg) c0)) $;

--| A class with one (or no) vertex is a simple graph if and only if it has no edges. (Contributed by Alexander van der Vekens, 13-Oct-2017.) (Revised by AV, 18-Oct-2020.)
theorem usgr1v (A2 G W: class):
  $ wi (wa (wcel G W) (wceq (cfv G cvtx) (csn A2))) (wb (wcel G cusgr) (wceq (cfv G ciedg) c0)) $;

--| A class with one (or no) vertex is a simple graph if and only if it has no edges. (Contributed by Alexander van der Vekens, 13-Oct-2017.) (Revised by AV, 18-Oct-2020.)
theorem usgr1v0edg (A2 G W: class):
  $ wi (w3a (wcel G W) (wceq (cfv G cvtx) (csn A2)) (wfun (cfv G ciedg))) (wb (wcel G cusgr) (wceq (cfv G cedg) c0)) $;

--| Lemma for ~ usgrexmpledg : all "edges" are different. (Contributed by Alexander van der Vekens, 15-Aug-2017.)
theorem usgrexmpldifpr:
  $ wa (w3a (wne (cpr cc0 c1) (cpr c1 c2)) (wne (cpr cc0 c1) (cpr c2 cc0)) (wne (cpr cc0 c1) (cpr cc0 c3))) (w3a (wne (cpr c1 c2) (cpr c2 cc0)) (wne (cpr c1 c2) (cpr cc0 c3)) (wne (cpr c2 cc0) (cpr cc0 c3))) $;

--| Lemma for ~ usgrexmpl . (Contributed by Alexander van der Vekens, 15-Aug-2017.)
theorem usgrexmplef {e: setvar} (E V: class):
  $ wceq V (co cc0 c4 cfz) $ >
  $ wceq E (cs4 (cpr cc0 c1) (cpr c1 c2) (cpr c2 cc0) (cpr cc0 c3)) $ >
  $ wf1 (cdm E) (crab e (wceq (cfv (cv e) chash) c2) (cpw V)) E $;

--| Lemma for ~ usgrexmpl . (Contributed by AV, 21-Oct-2020.)
theorem usgrexmpllem (E G V: class):
  $ wceq V (co cc0 c4 cfz) $ >
  $ wceq E (cs4 (cpr cc0 c1) (cpr c1 c2) (cpr c2 cc0) (cpr cc0 c3)) $ >
  $ wceq G (cop V E) $ >
  $ wa (wceq (cfv G cvtx) V) (wceq (cfv G ciedg) E) $;

--| The vertices ` 0 , 1 , 2 , 3 , 4 ` of the graph ` G = <. V , E >. ` . (Contributed by AV, 12-Jan-2020.) (Revised by AV, 21-Oct-2020.)
theorem usgrexmplvtx (E G V: class):
  $ wceq V (co cc0 c4 cfz) $ >
  $ wceq E (cs4 (cpr cc0 c1) (cpr c1 c2) (cpr c2 cc0) (cpr cc0 c3)) $ >
  $ wceq G (cop V E) $ >
  $ wceq (cfv G cvtx) (cun (ctp cc0 c1 c2) (cpr c3 c4)) $;

--| The edges ` { 0 , 1 } , { 1 , 2 } , { 2 , 0 } , { 0 , 3 } ` of the graph ` G = <. V , E >. ` . (Contributed by AV, 12-Jan-2020.) (Revised by AV, 21-Oct-2020.)
theorem usgrexmpledg (E G V: class):
  $ wceq V (co cc0 c4 cfz) $ >
  $ wceq E (cs4 (cpr cc0 c1) (cpr c1 c2) (cpr c2 cc0) (cpr cc0 c3)) $ >
  $ wceq G (cop V E) $ >
  $ wceq (cfv G cedg) (cun (cpr (cpr cc0 c1) (cpr c1 c2)) (cpr (cpr c2 cc0) (cpr cc0 c3))) $;

--| ` G ` is a simple graph of five vertices ` 0 , 1 , 2 , 3 , 4 ` , with edges ` { 0 , 1 } , { 1 , 2 } , { 2 , 0 } , { 0 , 3 } ` . (Contributed by Alexander van der Vekens, 15-Aug-2017.) (Revised by AV, 21-Oct-2020.) (Proof shortened by AV, 7-Aug-2025.)
theorem usgrexmpl (E G V: class):
  $ wceq V (co cc0 c4 cfz) $ >
  $ wceq E (cs4 (cpr cc0 c1) (cpr c1 c2) (cpr c2 cc0) (cpr cc0 c3)) $ >
  $ wceq G (cop V E) $ >
  $ wcel G cusgr $;

--| The class of empty graphs (represented as ordered pairs) is a proper class. (Contributed by AV, 27-Dec-2020.)
theorem griedg0prc {v e: setvar} (U: class v e):
  $ wceq U (copab v e (wf c0 c0 (cv e))) $ >
  $ wnel U cvv $;

--| The class of all simple graphs is a superclass of the class of empty graphs represented as ordered pairs. (Contributed by AV, 27-Dec-2020.)
theorem griedg0ssusgr {v e: setvar} (U: class v e):
  $ wceq U (copab v e (wf c0 c0 (cv e))) $ >
  $ wss U cusgr $;

--| The class of simple graphs is a proper class (and therefore, because of ~ prcssprc , the classes of multigraphs, pseudographs and hypergraphs are proper classes, too). (Contributed by AV, 27-Dec-2020.)
theorem usgrprc:
  $ wnel cusgr cvv $;

--| Extend class notation with subgraphs.
term csubgr: class;

--| Define the class of the subgraph relation. A class ` s ` is a _subgraph_ of a class ` g ` (the _supergraph_ of ` s ` ) if its vertices are also vertices of ` g ` , and its edges are also edges of ` g ` , connecting vertices of ` s ` only (see section I.1 in [Bollobas] p. 2 or section 1.1 in [Diestel] p. 4). The second condition is ensured by the requirement that the edge function of ` s ` is a restriction of the edge function of ` g ` having only vertices of ` s ` in its range. Note that the domains of the edge functions of the subgraph and the supergraph should be compatible. (Contributed by AV, 16-Nov-2020.)
axiom df_subgr {g2 s1: setvar}:
  $ wceq csubgr (copab s1 g2 (w3a (wss (cfv (cv s1) cvtx) (cfv (cv g2) cvtx)) (wceq (cfv (cv s1) ciedg) (cres (cfv (cv g2) ciedg) (cdm (cfv (cv s1) ciedg)))) (wss (cfv (cv s1) cedg) (cpw (cfv (cv s1) cvtx))))) $;

--| The class of the subgraph relation is a relation. (Contributed by AV, 16-Nov-2020.)
theorem relsubgr:
  $ wrel csubgr $;

--| If a class is a subgraph of another class, both classes are sets. (Contributed by AV, 16-Nov-2020.)
theorem subgrv (S G: class):
  $ wi (wbr S G csubgr) (wa (wcel S cvv) (wcel G cvv)) $;

--| The property of a set to be a subgraph of another set. (Contributed by AV, 16-Nov-2020.)
theorem issubgr (A2 B2 S U E G I V W: class):
  $ wceq V (cfv S cvtx) $ >
  $ wceq A2 (cfv G cvtx) $ >
  $ wceq I (cfv S ciedg) $ >
  $ wceq B2 (cfv G ciedg) $ >
  $ wceq E (cfv S cedg) $ >
  $ wi (wa (wcel G W) (wcel S U)) (wb (wbr S G csubgr) (w3a (wss V A2) (wceq I (cres B2 (cdm I))) (wss E (cpw V)))) $;

--| The property of a set to be a subgraph of a set whose edge function is actually a function. (Contributed by AV, 20-Nov-2020.)
theorem issubgr2 (A2 B2 S U E G I V W: class):
  $ wceq V (cfv S cvtx) $ >
  $ wceq A2 (cfv G cvtx) $ >
  $ wceq I (cfv S ciedg) $ >
  $ wceq B2 (cfv G ciedg) $ >
  $ wceq E (cfv S cedg) $ >
  $ wi (w3a (wcel G W) (wfun B2) (wcel S U)) (wb (wbr S G csubgr) (w3a (wss V A2) (wss I B2) (wss E (cpw V)))) $;

--| The properties of a subgraph. (Contributed by AV, 19-Nov-2020.)
theorem subgrprop (A2 B2 S E G I V: class):
  $ wceq V (cfv S cvtx) $ >
  $ wceq A2 (cfv G cvtx) $ >
  $ wceq I (cfv S ciedg) $ >
  $ wceq B2 (cfv G ciedg) $ >
  $ wceq E (cfv S cedg) $ >
  $ wi (wbr S G csubgr) (w3a (wss V A2) (wceq I (cres B2 (cdm I))) (wss E (cpw V))) $;

--| The properties of a subgraph: If ` S ` is a subgraph of ` G ` , its vertices are also vertices of ` G ` , and its edges are also edges of ` G ` , connecting vertices of the subgraph only. (Contributed by AV, 19-Nov-2020.)
theorem subgrprop2 (A2 B2 S E G I V: class):
  $ wceq V (cfv S cvtx) $ >
  $ wceq A2 (cfv G cvtx) $ >
  $ wceq I (cfv S ciedg) $ >
  $ wceq B2 (cfv G ciedg) $ >
  $ wceq E (cfv S cedg) $ >
  $ wi (wbr S G csubgr) (w3a (wss V A2) (wss I B2) (wss E (cpw V))) $;

--| The property of a hypergraph to be a subgraph. (Contributed by AV, 19-Nov-2020.)
theorem uhgrissubgr (A2 B2 S G I V W: class):
  $ wceq V (cfv S cvtx) $ >
  $ wceq A2 (cfv G cvtx) $ >
  $ wceq I (cfv S ciedg) $ >
  $ wceq B2 (cfv G ciedg) $ >
  $ wi (w3a (wcel G W) (wfun B2) (wcel S cuhgr)) (wb (wbr S G csubgr) (wa (wss V A2) (wss I B2))) $;

--| The properties of a subgraph: If ` S ` is a subgraph of ` G ` , its vertices are also vertices of ` G ` , and its edges are also edges of ` G ` . (Contributed by AV, 19-Nov-2020.)
theorem subgrprop3 (A2 B2 S E G V: class):
  $ wceq V (cfv S cvtx) $ >
  $ wceq A2 (cfv G cvtx) $ >
  $ wceq E (cfv S cedg) $ >
  $ wceq B2 (cfv G cedg) $ >
  $ wi (wbr S G csubgr) (wa (wss V A2) (wss E B2)) $;

--| An empty graph consisting of a subset of vertices of a graph (and having no edges) is a subgraph of the graph. (Contributed by AV, 17-Nov-2020.) (Proof shortened by AV, 17-Dec-2020.)
theorem egrsubgr (S U G W: class):
  $ wi (w3a (wa (wcel G W) (wcel S U)) (wss (cfv S cvtx) (cfv G cvtx)) (wa (wfun (cfv S ciedg)) (wceq (cfv S cedg) c0))) (wbr S G csubgr) $;

--| The null graph (represented by an empty set) is a subgraph of all graphs. (Contributed by AV, 17-Nov-2020.)
theorem _0grsubgr (G W: class):
  $ wi (wcel G W) (wbr c0 G csubgr) $;

--| The null graph (as hypergraph) is a subgraph of all graphs. (Contributed by AV, 17-Nov-2020.) (Proof shortened by AV, 28-Nov-2020.)
theorem _0uhgrsubgr (S G W: class):
  $ wi (w3a (wcel G W) (wcel S cuhgr) (wceq (cfv S cvtx) c0)) (wbr S G csubgr) $;

--| A hypergraph is a subgraph of itself. (Contributed by AV, 17-Nov-2020.) (Proof shortened by AV, 21-Nov-2020.)
theorem uhgrsubgrself (G: class):
  $ wi (wcel G cuhgr) (wbr G G csubgr) $;

--| The edge function of a subgraph of a graph whose edge function is actually a function is a function. (Contributed by AV, 20-Nov-2020.)
theorem subgrfun (S G: class):
  $ wi (wa (wfun (cfv G ciedg)) (wbr S G csubgr)) (wfun (cfv S ciedg)) $;

--| The edge function of a subgraph of a hypergraph is a function. (Contributed by AV, 16-Nov-2020.) (Proof shortened by AV, 20-Nov-2020.)
theorem subgruhgrfun (S G: class):
  $ wi (wa (wcel G cuhgr) (wbr S G csubgr)) (wfun (cfv S ciedg)) $;

--| An element of the domain of the edge function of a subgraph is an element of the domain of the edge function of the supergraph. (Contributed by AV, 20-Nov-2020.)
theorem subgreldmiedg (S G X: class):
  $ wi (wa (wbr S G csubgr) (wcel X (cdm (cfv S ciedg)))) (wcel X (cdm (cfv G ciedg))) $;

--| An edge of a subgraph of a hypergraph is a nonempty subset of its vertices. (Contributed by AV, 17-Nov-2020.) (Revised by AV, 21-Nov-2020.)
theorem subgruhgredgd (ph: wff) (S G I V X: class):
  $ wceq V (cfv S cvtx) $ >
  $ wceq I (cfv S ciedg) $ >
  $ wi ph (wcel G cuhgr) $ >
  $ wi ph (wbr S G csubgr) $ >
  $ wi ph (wcel X (cdm I)) $ >
  $ wi ph (wcel (cfv X I) (cdif (cpw V) (csn c0))) $;

--| An edge of a subgraph of a multigraph connects exactly two different vertices. (Contributed by AV, 26-Nov-2020.)
theorem subumgredg2 {e: setvar} (S G: class e) (I V X: class):
  $ wceq V (cfv S cvtx) $ >
  $ wceq I (cfv S ciedg) $ >
  $ wi (w3a (wbr S G csubgr) (wcel G cumgr) (wcel X (cdm I))) (wcel (cfv X I) (crab e (wceq (cfv (cv e) chash) c2) (cpw V))) $;

--| A subgraph of a hypergraph is a hypergraph. (Contributed by AV, 16-Nov-2020.) (Proof shortened by AV, 21-Nov-2020.)
theorem subuhgr (S G: class):
  $ wi (wa (wcel G cuhgr) (wbr S G csubgr)) (wcel S cuhgr) $;

--| A subgraph of a pseudograph is a pseudograph. (Contributed by AV, 16-Nov-2020.) (Proof shortened by AV, 21-Nov-2020.)
theorem subupgr (S G: class):
  $ wi (wa (wcel G cupgr) (wbr S G csubgr)) (wcel S cupgr) $;

--| A subgraph of a multigraph is a multigraph. (Contributed by AV, 26-Nov-2020.)
theorem subumgr (S G: class):
  $ wi (wa (wcel G cumgr) (wbr S G csubgr)) (wcel S cumgr) $;

--| A subgraph of a simple graph is a simple graph. (Contributed by AV, 16-Nov-2020.) (Proof shortened by AV, 27-Nov-2020.)
theorem subusgr (S G: class):
  $ wi (wa (wcel G cusgr) (wbr S G csubgr)) (wcel S cusgr) $;

--| Lemma for ~ uhgrspansubgr : The edges of the graph ` S ` obtained by removing some edges of a hypergraph ` G ` are subsets of its vertices (a spanning subgraph, see comment for ~ uhgrspansubgr . (Contributed by AV, 18-Nov-2020.)
theorem uhgrspansubgrlem (ph: wff) (A2 S E G V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi ph (wcel S W) $ >
  $ wi ph (wceq (cfv S cvtx) V) $ >
  $ wi ph (wceq (cfv S ciedg) (cres E A2)) $ >
  $ wi ph (wcel G cuhgr) $ >
  $ wi ph (wss (cfv S cedg) (cpw (cfv S cvtx))) $;

--| A spanning subgraph ` S ` of a hypergraph ` G ` is actually a subgraph of ` G ` . A subgraph ` S ` of a graph ` G ` which has the same vertices as ` G ` and is obtained by removing some edges of ` G ` is called a _spanning subgraph_ (see section I.1 in [Bollobas] p. 2 and section 1.1 in [Diestel] p. 4). Formally, the edges are "removed" by restricting the edge function of the original graph by an arbitrary class (which actually need not to be a subset of the domain of the edge function). (Contributed by AV, 18-Nov-2020.) (Proof shortened by AV, 21-Nov-2020.)
theorem uhgrspansubgr (ph: wff) (A2 S E G V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi ph (wcel S W) $ >
  $ wi ph (wceq (cfv S cvtx) V) $ >
  $ wi ph (wceq (cfv S ciedg) (cres E A2)) $ >
  $ wi ph (wcel G cuhgr) $ >
  $ wi ph (wbr S G csubgr) $;

--| A spanning subgraph ` S ` of a hypergraph ` G ` is a hypergraph. (Contributed by AV, 11-Oct-2020.) (Proof shortened by AV, 18-Nov-2020.)
theorem uhgrspan (ph: wff) (A2 S E G V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi ph (wcel S W) $ >
  $ wi ph (wceq (cfv S cvtx) V) $ >
  $ wi ph (wceq (cfv S ciedg) (cres E A2)) $ >
  $ wi ph (wcel G cuhgr) $ >
  $ wi ph (wcel S cuhgr) $;

--| A spanning subgraph ` S ` of a pseudograph ` G ` is a pseudograph. (Contributed by AV, 11-Oct-2020.) (Proof shortened by AV, 18-Nov-2020.)
theorem upgrspan (ph: wff) (A2 S E G V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi ph (wcel S W) $ >
  $ wi ph (wceq (cfv S cvtx) V) $ >
  $ wi ph (wceq (cfv S ciedg) (cres E A2)) $ >
  $ wi ph (wcel G cupgr) $ >
  $ wi ph (wcel S cupgr) $;

--| A spanning subgraph ` S ` of a multigraph ` G ` is a multigraph. (Contributed by AV, 27-Nov-2020.)
theorem umgrspan (ph: wff) (A2 S E G V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi ph (wcel S W) $ >
  $ wi ph (wceq (cfv S cvtx) V) $ >
  $ wi ph (wceq (cfv S ciedg) (cres E A2)) $ >
  $ wi ph (wcel G cumgr) $ >
  $ wi ph (wcel S cumgr) $;

--| A spanning subgraph ` S ` of a simple graph ` G ` is a simple graph. (Contributed by AV, 15-Oct-2020.) (Revised by AV, 16-Oct-2020.) (Proof shortened by AV, 18-Nov-2020.)
theorem usgrspan (ph: wff) (A2 S E G V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi ph (wcel S W) $ >
  $ wi ph (wceq (cfv S cvtx) V) $ >
  $ wi ph (wceq (cfv S ciedg) (cres E A2)) $ >
  $ wi ph (wcel G cusgr) $ >
  $ wi ph (wcel S cusgr) $;

--| A spanning subgraph of a hypergraph represented by an ordered pair is a hypergraph. (Contributed by Alexander van der Vekens, 27-Dec-2017.) (Revised by AV, 11-Oct-2020.)
theorem uhgrspanop (A2 E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (wcel G cuhgr) (wcel (cop V (cres E A2)) cuhgr) $;

--| A spanning subgraph of a pseudograph represented by an ordered pair is a pseudograph. (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by AV, 13-Oct-2020.)
theorem upgrspanop (A2 E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (wcel G cupgr) (wcel (cop V (cres E A2)) cupgr) $;

--| A spanning subgraph of a multigraph represented by an ordered pair is a multigraph. (Contributed by AV, 27-Nov-2020.)
theorem umgrspanop (A2 E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (wcel G cumgr) (wcel (cop V (cres E A2)) cumgr) $;

--| A spanning subgraph of a simple graph represented by an ordered pair is a simple graph. (Contributed by Alexander van der Vekens, 10-Aug-2017.) (Revised by AV, 16-Oct-2020.)
theorem usgrspanop (A2 E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (wcel G cusgr) (wcel (cop V (cres E A2)) cusgr) $;

--| Lemma 1 for ~ uhgrspan1 . (Contributed by AV, 19-Nov-2020.)
theorem uhgrspan1lem1 {i: setvar} (F G I N V: class i):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq F (crab i (wnel N (cfv (cv i) I)) (cdm I)) $ >
  $ wa (wcel (cdif V (csn N)) cvv) (wcel (cres I F) cvv) $;

--| Lemma 2 for ~ uhgrspan1 . (Contributed by AV, 19-Nov-2020.)
theorem uhgrspan1lem2 {i: setvar} (S F G I N V: class i):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq F (crab i (wnel N (cfv (cv i) I)) (cdm I)) $ >
  $ wceq S (cop (cdif V (csn N)) (cres I F)) $ >
  $ wceq (cfv S cvtx) (cdif V (csn N)) $;

--| Lemma 3 for ~ uhgrspan1 . (Contributed by AV, 19-Nov-2020.)
theorem uhgrspan1lem3 {i: setvar} (S F G I N V: class i):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq F (crab i (wnel N (cfv (cv i) I)) (cdm I)) $ >
  $ wceq S (cop (cdif V (csn N)) (cres I F)) $ >
  $ wceq (cfv S ciedg) (cres I F) $;

--| The induced subgraph ` S ` of a hypergraph ` G ` obtained by removing one vertex is actually a subgraph of ` G ` . A subgraph is called _induced_ or _spanned_ by a subset of vertices of a graph if it contains all edges of the original graph that join two vertices of the subgraph (see section I.1 in [Bollobas] p. 2 and section 1.1 in [Diestel] p. 4). (Contributed by AV, 19-Nov-2020.)
theorem uhgrspan1 {i: setvar} (S F G: class i) (I N: class) (V: class i):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq F (crab i (wnel N (cfv (cv i) I)) (cdm I)) $ >
  $ wceq S (cop (cdif V (csn N)) (cres I F)) $ >
  $ wi (wa (wcel G cuhgr) (wcel N V)) (wbr S G csubgr) $;

--| Lemma for ~ upgrres . (Contributed by AV, 27-Nov-2020.) (Revised by AV, 19-Dec-2021.)
theorem upgrreslem {i p: setvar} (E: class) (F: class i p) (G: class i) (N: class) (V: class i):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq F (crab i (wnel N (cfv (cv i) E)) (cdm E)) $ >
  $ wi (wa (wcel G cupgr) (wcel N V)) (wss (crn (cres E F)) (crab p (wbr (cfv (cv p) chash) c2 cle) (cdif (cpw (cdif V (csn N))) (csn c0)))) $;

--| Lemma for ~ umgrres and ~ usgrres . (Contributed by AV, 27-Nov-2020.) (Revised by AV, 19-Dec-2021.)
theorem umgrreslem {i p: setvar} (E: class) (F: class i p) (G: class i) (N: class) (V: class i):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq F (crab i (wnel N (cfv (cv i) E)) (cdm E)) $ >
  $ wi (wa (wcel G cumgr) (wcel N V)) (wss (crn (cres E F)) (crab p (wceq (cfv (cv p) chash) c2) (cpw (cdif V (csn N))))) $;

--| A subgraph obtained by removing one vertex and all edges incident with this vertex from a pseudograph (see ~ uhgrspan1 ) is a pseudograph. (Contributed by AV, 8-Nov-2020.) (Revised by AV, 19-Dec-2021.)
theorem upgrres {i: setvar} (S: class i) (E: class) (F G: class i) (N: class) (V: class i):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq F (crab i (wnel N (cfv (cv i) E)) (cdm E)) $ >
  $ wceq S (cop (cdif V (csn N)) (cres E F)) $ >
  $ wi (wa (wcel G cupgr) (wcel N V)) (wcel S cupgr) $;

--| A subgraph obtained by removing one vertex and all edges incident with this vertex from a multigraph (see ~ uhgrspan1 ) is a multigraph. (Contributed by AV, 27-Nov-2020.) (Revised by AV, 19-Dec-2021.)
theorem umgrres {i: setvar} (S: class i) (E: class) (F G: class i) (N: class) (V: class i):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq F (crab i (wnel N (cfv (cv i) E)) (cdm E)) $ >
  $ wceq S (cop (cdif V (csn N)) (cres E F)) $ >
  $ wi (wa (wcel G cumgr) (wcel N V)) (wcel S cumgr) $;

--| A subgraph obtained by removing one vertex and all edges incident with this vertex from a simple graph (see ~ uhgrspan1 ) is a simple graph. (Contributed by Alexander van der Vekens, 2-Jan-2018.) (Revised by AV, 19-Dec-2021.)
theorem usgrres {i: setvar} (S: class i) (E: class) (F G: class i) (N: class) (V: class i):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq F (crab i (wnel N (cfv (cv i) E)) (cdm E)) $ >
  $ wceq S (cop (cdif V (csn N)) (cres E F)) $ >
  $ wi (wa (wcel G cusgr) (wcel N V)) (wcel S cusgr) $;

--| Lemma 1 for ~ upgrres1 . (Contributed by AV, 7-Nov-2020.)
theorem upgrres1lem1 {e: setvar} (E: class) (F: class e) (G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq F (crab e (wnel N (cv e)) E) $ >
  $ wa (wcel (cdif V (csn N)) cvv) (wcel (cres cid F) cvv) $;

--| Lemma for ~ umgrres1 . (Contributed by AV, 27-Nov-2020.)
theorem umgrres1lem {e p: setvar} (E: class p) (F: class e) (G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq F (crab e (wnel N (cv e)) E) $ >
  $ wi (wa (wcel G cumgr) (wcel N V)) (wss (crn (cres cid F)) (crab p (wceq (cfv (cv p) chash) c2) (cpw (cdif V (csn N))))) $;

--| Lemma 2 for ~ upgrres1 . (Contributed by AV, 7-Nov-2020.)
theorem upgrres1lem2 {e: setvar} (S: class e) (E: class) (F: class e) (G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq F (crab e (wnel N (cv e)) E) $ >
  $ wceq S (cop (cdif V (csn N)) (cres cid F)) $ >
  $ wceq (cfv S cvtx) (cdif V (csn N)) $;

--| Lemma 3 for ~ upgrres1 . (Contributed by AV, 7-Nov-2020.)
theorem upgrres1lem3 {e: setvar} (S: class e) (E: class) (F: class e) (G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq F (crab e (wnel N (cv e)) E) $ >
  $ wceq S (cop (cdif V (csn N)) (cres cid F)) $ >
  $ wceq (cfv S ciedg) (cres cid F) $;

--| A pseudograph obtained by removing one vertex and all edges incident with this vertex is a pseudograph. Remark: This graph is not a subgraph of the original graph in the sense of ~ df-subgr since the domains of the edge functions may not be compatible. (Contributed by AV, 8-Nov-2020.)
theorem upgrres1 {e: setvar} (S: class e) (E: class) (F: class e) (G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq F (crab e (wnel N (cv e)) E) $ >
  $ wceq S (cop (cdif V (csn N)) (cres cid F)) $ >
  $ wi (wa (wcel G cupgr) (wcel N V)) (wcel S cupgr) $;

--| A multigraph obtained by removing one vertex and all edges incident with this vertex is a multigraph. Remark: This graph is not a subgraph of the original graph in the sense of ~ df-subgr since the domains of the edge functions may not be compatible. (Contributed by AV, 27-Nov-2020.)
theorem umgrres1 {e: setvar} (S: class e) (E: class) (F: class e) (G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq F (crab e (wnel N (cv e)) E) $ >
  $ wceq S (cop (cdif V (csn N)) (cres cid F)) $ >
  $ wi (wa (wcel G cumgr) (wcel N V)) (wcel S cumgr) $;

--| Restricting a simple graph by removing one vertex results in a simple graph. Remark: This restricted graph is not a subgraph of the original graph in the sense of ~ df-subgr since the domains of the edge functions may not be compatible. (Contributed by Alexander van der Vekens, 2-Jan-2018.) (Revised by AV, 10-Jan-2020.) (Revised by AV, 23-Oct-2020.) (Proof shortened by AV, 27-Nov-2020.)
theorem usgrres1 {e: setvar} (S: class e) (E: class) (F: class e) (G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq F (crab e (wnel N (cv e)) E) $ >
  $ wceq S (cop (cdif V (csn N)) (cres cid F)) $ >
  $ wi (wa (wcel G cusgr) (wcel N V)) (wcel S cusgr) $;

--| Extend class notation with finite simple graphs.
term cfusgr: class;

--| Define the class of all finite undirected simple graphs without loops (called "finite simple graphs" in the following). A finite simple graph is an undirected simple graph of finite order, i.e. with a finite set of vertices. (Contributed by AV, 3-Jan-2020.) (Revised by AV, 21-Oct-2020.)
axiom df_fusgr {g2: setvar}:
  $ wceq cfusgr (crab g2 (wcel (cfv (cv g2) cvtx) cfn) cusgr) $;

--| The property of being a finite simple graph. (Contributed by AV, 3-Jan-2020.) (Revised by AV, 21-Oct-2020.)
theorem isfusgr (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wb (wcel G cfusgr) (wa (wcel G cusgr) (wcel V cfn)) $;

--| A finite simple graph has a finite set of vertices. (Contributed by AV, 16-Dec-2020.)
theorem fusgrvtxfi (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel G cfusgr) (wcel V cfn) $;

--| The property of being a finite simple graph. (Contributed by AV, 3-Jan-2020.) (Revised by AV, 21-Oct-2020.)
theorem isfusgrf1 {x3: setvar} (G: class) (I: class x3) (V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi (wcel G W) (wb (wcel G cfusgr) (wa (wf1 (cdm I) (crab x3 (wceq (cfv (cv x3) chash) c2) (cpw V)) I) (wcel V cfn))) $;

--| The property of being a finite simple graph. (Contributed by AV, 3-Jan-2020.) (Revised by AV, 9-Jan-2020.)
theorem isfusgrcl (G: class):
  $ wb (wcel G cfusgr) (wa (wcel G cusgr) (wcel (cfv (cfv G cvtx) chash) cn0)) $;

--| A finite simple graph is a simple graph. (Contributed by AV, 16-Jan-2020.) (Revised by AV, 21-Oct-2020.)
theorem fusgrusgr (G: class):
  $ wi (wcel G cfusgr) (wcel G cusgr) $;

--| A finite simple graph represented as ordered pair. (Contributed by AV, 23-Oct-2020.)
theorem opfusgr (E V X Y: class):
  $ wi (wa (wcel V X) (wcel E Y)) (wb (wcel (cop V E) cfusgr) (wa (wcel (cop V E) cusgr) (wcel V cfn))) $;

--| The number of edges in a simple graph is finite iff its edge function is finite. (Contributed by AV, 10-Jan-2020.) (Revised by AV, 22-Oct-2020.)
theorem usgredgffibi (E G I: class):
  $ wceq I (cfv G ciedg) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wcel G cusgr) (wb (wcel E cfn) (wcel I cfn)) $;

--| In a finite simple graph the number of edges which contain a given vertex is also finite. (Contributed by Alexander van der Vekens, 4-Jan-2018.) (Revised by AV, 21-Oct-2020.)
theorem fusgredgfi {e: setvar} (E G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cfusgr) (wcel N V)) (wcel (crab e (wcel N (cv e)) E) cfn) $;

--| The size of a (finite) simple graph with 1 vertex is 0. (Contributed by Alexander van der Vekens, 5-Jan-2018.) (Revised by AV, 22-Oct-2020.)
theorem usgr1v0e (E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cusgr) (wceq (cfv V chash) c1)) (wceq (cfv E chash) cc0) $;

--| In a finite simple graph, the number of edges is finite iff the number of edges not containing one of the vertices is finite. (Contributed by Alexander van der Vekens, 4-Jan-2018.) (Revised by AV, 9-Nov-2020.)
theorem usgrfilem {e: setvar} (E: class) (F: class e) (G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq F (crab e (wnel N (cv e)) E) $ >
  $ wi (wa (wcel G cfusgr) (wcel N V)) (wb (wcel E cfn) (wcel F cfn)) $;

--| Induction base for ~ fusgrfis . Main work is done in ~ uhgr0v0e . (Contributed by Alexander van der Vekens, 5-Jan-2018.) (Revised by AV, 23-Oct-2020.)
theorem fusgrfisbase (E V X Y: class):
  $ wi (w3a (wa (wcel V X) (wcel E Y)) (wcel (cop V E) cusgr) (wceq (cfv V chash) cc0)) (wcel E cfn) $;

--| Induction step in ~ fusgrfis : In a finite simple graph, the number of edges is finite if the number of edges not containing one of the vertices is finite. (Contributed by Alexander van der Vekens, 5-Jan-2018.) (Revised by AV, 23-Oct-2020.)
theorem fusgrfisstep {p: setvar} (E N V: class) (X Y: class p):
  $ wi (w3a (wa (wcel V X) (wcel E Y)) (wcel (cop V E) cfusgr) (wcel N V)) (wi (wcel (cres cid (crab p (wnel N (cv p)) (cfv (cop V E) cedg))) cfn) (wcel E cfn)) $;

--| A finite simple graph is of finite size, i.e. has a finite number of edges. (Contributed by Alexander van der Vekens, 6-Jan-2018.) (Revised by AV, 8-Nov-2020.)
theorem fusgrfis (G: class):
  $ wi (wcel G cfusgr) (wcel (cfv G cedg) cfn) $;

--| A finite simple graph is a finite pseudograph of finite size. (Contributed by AV, 27-Dec-2021.)
theorem fusgrfupgrfs (G I V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi (wcel G cfusgr) (w3a (wcel G cupgr) (wcel V cfn) (wcel I cfn)) $;

--| Extend class notation with neighbors (of a vertex in a graph).
term cnbgr: class;

--| Define the (open) _neighborhood_ resp. the class of all neighbors of a vertex (in a graph), see definition in section I.1 of [Bollobas] p. 3 or definition in section 1.1 of [Diestel] p. 3. The neighborhood/neighbors of a vertex are all (other) vertices which are connected with this vertex by an edge. In contrast to a closed neighborhood (see ~ df-clnbgr ), a vertex is not a neighbor of itself (see ~ nbgrnself ). This definition is applicable even for arbitrary hypergraphs. Remark: To distinguish this definition from other definitions for neighborhoods resp. neighbors (e.g., ` nei ` in Topology, see ~ df-nei ), the suffix ` Vtx ` is added to the class constant ` NeighbVtx ` . (Contributed by Alexander van der Vekens and Mario Carneiro, 7-Oct-2017.) (Revised by AV, 24-Oct-2020.)
axiom df_nbgr {v e g2 n: setvar}:
  $ wceq cnbgr (cmpo g2 v cvv (cfv (cv g2) cvtx) (crab n (wrex e (wss (cpr (cv v) (cv n)) (cv e)) (cfv (cv g2) cedg)) (cdif (cfv (cv g2) cvtx) (csn (cv v))))) $;

--| The set of neighbors is empty if the graph ` G ` or the vertex ` N ` are proper classes. (Contributed by AV, 26-Oct-2020.)
theorem nbgrprc0 (G N: class):
  $ wi (wn (wa (wcel G cvv) (wcel N cvv))) (wceq (co G N cnbgr) c0) $;

--| If a class ` X ` has at least one neighbor, this class must be a vertex. (Contributed by AV, 6-Jun-2021.) (Revised by AV, 12-Feb-2022.)
theorem nbgrcl (G N V X: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel N (co G X cnbgr)) (wcel X V) $;

--| The set of neighbors of a vertex ` V ` in a graph ` G ` . (Contributed by Alexander van der Vekens, 7-Oct-2017.) (Revised by AV, 24-Oct-2020.) (Revised by AV, 21-Mar-2021.)
theorem nbgrval {e n: setvar} (E: class n) (G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wcel N V) (wceq (co G N cnbgr) (crab n (wrex e (wss (cpr N (cv n)) (cv e)) E) (cdif V (csn N)))) $;

--| Alternate definition of the neighbors of a vertex breaking up the subset relationship of an unordered pair. (Contributed by AV, 15-Nov-2020.) (Revised by AV, 21-Mar-2021.)
theorem dfnbgr2 {e n: setvar} (E: class n) (G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wcel N V) (wceq (co G N cnbgr) (crab n (wrex e (wa (wcel N (cv e)) (wcel (cv n) (cv e))) E) (cdif V (csn N)))) $;

--| Alternate definition of the neighbors of a vertex using the edge function instead of the edges themselves (see also ~ nbgrval ). (Contributed by Alexander van der Vekens, 17-Dec-2017.) (Revised by AV, 25-Oct-2020.) (Revised by AV, 21-Mar-2021.)
theorem dfnbgr3 {i n: setvar} (G: class i) (I N: class) (V: class i):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi (wa (wcel N V) (wfun I)) (wceq (co G N cnbgr) (crab n (wrex i (wss (cpr N (cv n)) (cfv (cv i) I)) (cdm I)) (cdif V (csn N)))) $;

--| If a class ` X ` is not a vertex of a graph ` G ` , then it has no neighbors in ` G ` . (Contributed by Alexander van der Vekens, 12-Oct-2017.) (Revised by AV, 26-Oct-2020.)
theorem nbgrnvtx0 (G V X: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wnel X V) (wceq (co G X cnbgr) c0) $;

--| Characterization of a neighbor ` N ` of a vertex ` X ` in a graph ` G ` . (Contributed by Alexander van der Vekens and Mario Carneiro, 9-Oct-2017.) (Revised by AV, 26-Oct-2020.) (Revised by AV, 12-Feb-2022.)
theorem nbgrel {e: setvar} (E G N V X: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wb (wcel N (co G X cnbgr)) (w3a (wa (wcel N V) (wcel X V)) (wne N X) (wrex e (wss (cpr X N) (cv e)) E)) $;

--| Every neighbor ` N ` of a vertex ` K ` is a vertex. (Contributed by Alexander van der Vekens, 12-Oct-2017.) (Revised by AV, 26-Oct-2020.) (Revised by AV, 12-Feb-2022.)
theorem nbgrisvtx (G K N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel N (co G K cnbgr)) (wcel N V) $;

--| The neighbors of a vertex ` K ` in a graph form a subset of all vertices of the graph. (Contributed by Alexander van der Vekens, 12-Oct-2017.) (Revised by AV, 26-Oct-2020.) (Revised by AV, 12-Feb-2022.)
theorem nbgrssvtx (G K V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wss (co G K cnbgr) V $;

--| The set of neighbors of a vertex in a hypergraph. This version of ~ nbgrval (with ` N ` being an arbitrary set instead of being a vertex) only holds for classes whose edges are subsets of the set of vertices (hypergraphs!). (Contributed by AV, 26-Oct-2020.) (Proof shortened by AV, 15-Nov-2020.)
theorem nbuhgr {e n: setvar} (E: class n) (G N V X: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cuhgr) (wcel N X)) (wceq (co G N cnbgr) (crab n (wrex e (wss (cpr N (cv n)) (cv e)) E) (cdif V (csn N)))) $;

--| The set of neighbors of a vertex in a pseudograph. (Contributed by AV, 5-Nov-2020.) (Proof shortened by AV, 30-Dec-2020.)
theorem nbupgr {n: setvar} (E G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cupgr) (wcel N V)) (wceq (co G N cnbgr) (crab n (wcel (cpr N (cv n)) E) (cdif V (csn N)))) $;

--| A neighbor of a vertex in a pseudograph. (Contributed by AV, 5-Nov-2020.)
theorem nbupgrel (E G K N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wa (wcel G cupgr) (wcel K V)) (wa (wcel N V) (wne N K))) (wb (wcel N (co G K cnbgr)) (wcel (cpr N K) E)) $;

--| The set of neighbors of a vertex in a multigraph. (Contributed by AV, 27-Nov-2020.) (Proof shortened by AV, 30-Dec-2020.)
theorem nbumgrvtx {n: setvar} (E G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cumgr) (wcel N V)) (wceq (co G N cnbgr) (crab n (wcel (cpr N (cv n)) E) V)) $;

--| The set of neighbors of an arbitrary class in a multigraph. (Contributed by AV, 27-Nov-2020.)
theorem nbumgr {n: setvar} (E G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wcel G cumgr) (wceq (co G N cnbgr) (crab n (wcel (cpr N (cv n)) E) V)) $;

--| The set of neighbors of a vertex in a simple graph. (Contributed by Alexander van der Vekens, 9-Oct-2017.) (Revised by AV, 26-Oct-2020.) (Proof shortened by AV, 27-Nov-2020.)
theorem nbusgrvtx {n: setvar} (E G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cusgr) (wcel N V)) (wceq (co G N cnbgr) (crab n (wcel (cpr N (cv n)) E) V)) $;

--| The set of neighbors of an arbitrary class in a simple graph. (Contributed by Alexander van der Vekens, 9-Oct-2017.) (Revised by AV, 26-Oct-2020.) (Proof shortened by AV, 27-Nov-2020.)
theorem nbusgr {n: setvar} (E G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wcel G cusgr) (wceq (co G N cnbgr) (crab n (wcel (cpr N (cv n)) E) V)) $;

--| If a graph has two vertices, and there is an edge between the vertices, then each vertex is the neighbor of the other vertex. (Contributed by AV, 2-Nov-2020.) (Revised by AV, 25-Mar-2021.) (Proof shortened by AV, 13-Feb-2022.)
theorem nbgr2vtx1edg {v n: setvar} (E: class v) (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wceq (cfv V chash) c2) (wcel V E)) (wral v (wral n (wcel (cv n) (co G (cv v) cnbgr)) (cdif V (csn (cv v)))) V) $;

--| Lemma for ~ nbuhgr2vtx1edgb . This reverse direction of ~ nbgr2vtx1edg only holds for classes whose edges are subsets of the set of vertices, which is the property of hypergraphs. (Contributed by AV, 2-Nov-2020.) (Proof shortened by AV, 13-Feb-2022.)
theorem nbuhgr2vtx1edgblem (E G V: class) (a b: setvar):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (w3a (wcel G cuhgr) (wceq V (cpr (cv a) (cv b))) (wcel (cv a) (co G (cv b) cnbgr))) (wcel (cpr (cv a) (cv b)) E) $;

--| If a hypergraph has two vertices, and there is an edge between the vertices, then each vertex is the neighbor of the other vertex. (Contributed by AV, 2-Nov-2020.) (Proof shortened by AV, 13-Feb-2022.)
theorem nbuhgr2vtx1edgb {v n: setvar} (E: class v) (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cuhgr) (wceq (cfv V chash) c2)) (wb (wcel V E) (wral v (wral n (wcel (cv n) (co G (cv v) cnbgr)) (cdif V (csn (cv v)))) V)) $;

--| A class/vertex is a neighbor of another class/vertex in a simple graph iff the vertices are endpoints of an edge. (Contributed by Alexander van der Vekens, 11-Oct-2017.) (Revised by AV, 26-Oct-2020.)
theorem nbusgreledg (E G K N: class):
  $ wceq E (cfv G cedg) $ >
  $ wi (wcel G cusgr) (wb (wcel N (co G K cnbgr)) (wcel (cpr N K) E)) $;

--| A vertex which is not endpoint of an edge has no neighbor in a hypergraph. (Contributed by Alexander van der Vekens, 12-Oct-2017.) (Revised by AV, 26-Oct-2020.)
theorem uhgrnbgr0nb {e: setvar} (G N: class):
  $ wi (wa (wcel G cuhgr) (wral e (wnel N (cv e)) (cfv G cedg))) (wceq (co G N cnbgr) c0) $;

--| In a null graph (with no vertices), all neighborhoods are empty. (Contributed by AV, 15-Nov-2020.) (Proof shortened by AV, 10-May-2025.)
theorem nbgr0vtx (G K: class):
  $ wi (wceq (cfv G cvtx) c0) (wceq (co G K cnbgr) c0) $;

--| Lemma for ~ nbgr0edg and ~ nbgr1vtx . (Contributed by AV, 15-Nov-2020.)
theorem nbgr0edglem {e n: setvar} (ph: wff e n) (G K: class):
  $ wi ph (wral n (wn (wrex e (wss (cpr K (cv n)) (cv e)) (cfv G cedg))) (cdif (cfv G cvtx) (csn K))) $ >
  $ wi ph (wceq (co G K cnbgr) c0) $;

--| In an empty graph (with no edges), every vertex has no neighbor. (Contributed by Alexander van der Vekens, 12-Oct-2017.) (Revised by AV, 26-Oct-2020.) (Proof shortened by AV, 15-Nov-2020.)
theorem nbgr0edg (G K: class):
  $ wi (wceq (cfv G cedg) c0) (wceq (co G K cnbgr) c0) $;

--| In a graph with one vertex, all neighborhoods are empty. (Contributed by AV, 15-Nov-2020.)
theorem nbgr1vtx (G K: class):
  $ wi (wceq (cfv (cfv G cvtx) chash) c1) (wceq (co G K cnbgr) c0) $;

--| A vertex in a graph is not a neighbor of itself. (Contributed by Alexander van der Vekens, 12-Oct-2017.) (Revised by AV, 3-Nov-2020.) (Revised by AV, 21-Mar-2021.)
theorem nbgrnself {v: setvar} (G: class v) (V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wral v (wnel (cv v) (co G (cv v) cnbgr)) V $;

--| A class ` X ` is not a neighbor of itself (whether it is a vertex or not). (Contributed by Alexander van der Vekens, 12-Oct-2017.) (Revised by AV, 3-Nov-2020.) (Revised by AV, 12-Feb-2022.)
theorem nbgrnself2 (G X: class):
  $ wnel X (co G X cnbgr) $;

--| The neighbors of a vertex ` X ` form a subset of all vertices except the vertex ` X ` itself. Stronger version of ~ nbgrssvtx . (Contributed by Alexander van der Vekens, 13-Jul-2018.) (Revised by AV, 3-Nov-2020.) (Revised by AV, 12-Feb-2022.)
theorem nbgrssovtx (G V X: class):
  $ wceq V (cfv G cvtx) $ >
  $ wss (co G X cnbgr) (cdif V (csn X)) $;

--| The neighbors of a vertex ` X ` form a subset of all vertices except the vertex ` X ` itself and a class ` M ` which is not a neighbor of ` X ` . (Contributed by Alexander van der Vekens, 13-Jul-2018.) (Revised by AV, 3-Nov-2020.) (Revised by AV, 12-Feb-2022.)
theorem nbgrssvwo2 (G M V X: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wnel M (co G X cnbgr)) (wss (co G X cnbgr) (cdif V (cpr M X))) $;

--| In a graph, the neighborhood relation is symmetric: a vertex ` N ` in a graph ` G ` is a neighbor of a second vertex ` K ` iff the second vertex ` K ` is a neighbor of the first vertex ` N ` . (Contributed by Alexander van der Vekens, 12-Oct-2017.) (Revised by AV, 27-Oct-2020.) (Revised by AV, 12-Feb-2022.)
theorem nbgrsym (G K N: class):
  $ wb (wcel N (co G K cnbgr)) (wcel K (co G N cnbgr)) $;

--| The neighborhood of a vertex in a restricted pseudograph (not necessarily valid for a hypergraph, because ` N ` , ` K ` and ` M ` could be connected by one edge, so ` M ` is a neighbor of ` K ` in the original graph, but not in the restricted graph, because the edge between ` M ` and ` K ` , also incident with ` N ` , was removed). (Contributed by Alexander van der Vekens, 2-Jan-2018.) (Revised by AV, 8-Nov-2020.)
theorem nbupgrres {e: setvar} (S: class e) (E: class) (F: class e) (G K M N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq F (crab e (wnel N (cv e)) E) $ >
  $ wceq S (cop (cdif V (csn N)) (cres cid F)) $ >
  $ wi (w3a (wa (wcel G cupgr) (wcel N V)) (wcel K (cdif V (csn N))) (wcel M (cdif V (cpr N K)))) (wi (wcel M (co G K cnbgr)) (wcel M (co S K cnbgr))) $;

--| Applying the edge function on the converse edge function applied on a pair of a vertex and one of its neighbors is this pair in a simple graph. (Contributed by Alexander van der Vekens, 18-Dec-2017.) (Revised by AV, 27-Oct-2020.)
theorem usgrnbcnvfv (G I K N: class):
  $ wceq I (cfv G ciedg) $ >
  $ wi (wa (wcel G cusgr) (wcel N (co G K cnbgr))) (wceq (cfv (cfv (cpr K N) (ccnv I)) I) (cpr K N)) $;

--| For each neighbor of a vertex there is exactly one edge between the vertex and its neighbor in a simple graph. (Contributed by Alexander van der Vekens, 17-Dec-2017.) (Revised by AV, 27-Oct-2020.)
theorem nbusgredgeu {e: setvar} (E G M N: class):
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cusgr) (wcel M (co G N cnbgr))) (wreu e (wceq (cv e) (cpr M N)) E) $;

--| For each edge incident to a vertex there is exactly one neighbor of the vertex also incident to this edge in a simple graph. (Contributed by AV, 28-Oct-2020.) (Revised by AV, 6-Jul-2022.)
theorem edgnbusgreu {n: setvar} (C E G M: class) (N: class n) (V: class):
  $ wceq E (cfv G cedg) $ >
  $ wceq N (co G M cnbgr) $ >
  $ wi (wa (wa (wcel G cusgr) (wcel M V)) (wa (wcel C E) (wcel M C))) (wreu n (wceq C (cpr M (cv n))) N) $;

--| For each neighbor of a vertex there is exactly one edge between the vertex and its neighbor in a simple graph. (Contributed by Alexander van der Vekens, 17-Dec-2017.) (Revised by AV, 27-Oct-2020.) (Proof shortened by AV, 13-Feb-2022.)
theorem nbusgredgeu0 {e i: setvar} (U E: class) (G: class e) (I: class e i) (M N V: class e):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq N (co G U cnbgr) $ >
  $ wceq I (crab e (wcel U (cv e)) E) $ >
  $ wi (wa (wa (wcel G cusgr) (wcel U V)) (wcel M N)) (wreu i (wceq (cv i) (cpr U M)) I) $;

--| The mapping of neighbors of a vertex to edges incident to the vertex is a bijection ( 1-1 onto function) in a simple graph. (Contributed by Alexander van der Vekens, 17-Dec-2017.) (Revised by AV, 28-Oct-2020.)
theorem nbusgrf1o0 {e n: setvar} (U E: class) (F: class n) (G I N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq N (co G U cnbgr) $ >
  $ wceq I (crab e (wcel U (cv e)) E) $ >
  $ wceq F (cmpt n N (cpr U (cv n))) $ >
  $ wi (wa (wcel G cusgr) (wcel U V)) (wf1o N I F) $;

--| The set of neighbors of a vertex is isomorphic to the set of edges containing the vertex in a simple graph. (Contributed by Alexander van der Vekens, 19-Dec-2017.) (Revised by AV, 28-Oct-2020.)
theorem nbusgrf1o1 {e f2: setvar} (U: class) (E G: class f2) (I N: class) (V: class f2):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq N (co G U cnbgr) $ >
  $ wceq I (crab e (wcel U (cv e)) E) $ >
  $ wi (wa (wcel G cusgr) (wcel U V)) (wex f2 (wf1o N I (cv f2))) $;

--| The set of neighbors of a vertex is isomorphic to the set of edges containing the vertex in a simple graph. (Contributed by Alexander van der Vekens, 19-Dec-2017.) (Revised by AV, 28-Oct-2020.)
theorem nbusgrf1o {e f2: setvar} (U E: class) (G: class e) (V: class e f2):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cusgr) (wcel U V)) (wex f2 (wf1o (co G U cnbgr) (crab e (wcel U (cv e)) E) (cv f2))) $;

--| The number of neighbors of a vertex is the number of edges at the vertex in a simple graph. (Contributed by AV, 27-Dec-2020.) (Proof shortened by AV, 5-May-2021.)
theorem nbedgusgr {e: setvar} (U E: class) (G V: class e):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cusgr) (wcel U V)) (wceq (cfv (co G U cnbgr) chash) (cfv (crab e (wcel U (cv e)) E) chash)) $;

--| The number of neighbors of a vertex in a simple graph is finite iff the number of edges having this vertex as endpoint is finite. (Contributed by Alexander van der Vekens, 20-Dec-2017.) (Revised by AV, 28-Oct-2020.)
theorem edgusgrnbfin {e: setvar} (U E: class) (G V: class e):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cusgr) (wcel U V)) (wb (wcel (co G U cnbgr) cfn) (wcel (crab e (wcel U (cv e)) E) cfn)) $;

--| The class of neighbors of a vertex in a simple graph with a finite number of edges is a finite set. (Contributed by Alexander van der Vekens, 19-Dec-2017.) (Revised by AV, 28-Oct-2020.)
theorem nbusgrfi (U E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (w3a (wcel G cusgr) (wcel E cfn) (wcel U V)) (wcel (co G U cnbgr) cfn) $;

--| The class of neighbors of a vertex in a finite simple graph is a finite set. (Contributed by Alexander van der Vekens, 7-Mar-2018.) (Revised by AV, 28-Oct-2020.)
theorem nbfiusgrfi (G N: class):
  $ wi (wa (wcel G cfusgr) (wcel N (cfv G cvtx))) (wcel (co G N cnbgr) cfn) $;

--| The number of neighbors of a vertex in a finite simple graph is a nonnegative integer. (Contributed by Alexander van der Vekens, 14-Jul-2018.) (Revised by AV, 15-Dec-2020.)
theorem hashnbusgrnn0 (U G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel G cfusgr) (wcel U V)) (wcel (cfv (co G U cnbgr) chash) cn0) $;

--| The number of neighbors of a vertex is at most the number of vertices of the graph minus 1 in a finite simple graph. (Contributed by AV, 16-Dec-2020.) (Proof shortened by AV, 13-Feb-2022.)
theorem nbfusgrlevtxm1 (U G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel G cfusgr) (wcel U V)) (wbr (cfv (co G U cnbgr) chash) (co (cfv V chash) c1 cmin) cle) $;

--| If there is a vertex which is not a neighbor of another vertex, the number of neighbors of the other vertex is at most the number of vertices of the graph minus 2 in a finite simple graph. (Contributed by AV, 16-Dec-2020.) (Proof shortened by AV, 13-Feb-2022.)
theorem nbfusgrlevtxm2 (U G M V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wa (wcel G cfusgr) (wcel U V)) (w3a (wcel M V) (wne M U) (wnel M (co G U cnbgr)))) (wbr (cfv (co G U cnbgr) chash) (co (cfv V chash) c2 cmin) cle) $;

--| If the number of neighbors of a vertex in a finite simple graph is the number of vertices of the graph minus 1, each vertex except the first mentioned vertex is a neighbor of this vertex. (Contributed by Alexander van der Vekens, 14-Jul-2018.) (Revised by AV, 16-Dec-2020.)
theorem nbusgrvtxm1 (U G M V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel G cfusgr) (wcel U V)) (wi (wceq (cfv (co G U cnbgr) chash) (co (cfv V chash) c1 cmin)) (wi (wa (wcel M V) (wne M U)) (wcel M (co G U cnbgr)))) $;

--| Lemma 1 for ~ nb3grpr . (Contributed by Alexander van der Vekens, 15-Oct-2017.) (Revised by AV, 28-Oct-2020.)
theorem nb3grprlem1 (ph: wff) (A2 B2 C E G V X Y Z: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi ph (wcel G cusgr) $ >
  $ wi ph (wceq V (ctp A2 B2 C)) $ >
  $ wi ph (w3a (wcel A2 X) (wcel B2 Y) (wcel C Z)) $ >
  $ wi ph (wb (wceq (co G A2 cnbgr) (cpr B2 C)) (wa (wcel (cpr A2 B2) E) (wcel (cpr A2 C) E))) $;

--| Lemma 2 for ~ nb3grpr . (Contributed by Alexander van der Vekens, 17-Oct-2017.) (Revised by AV, 28-Oct-2020.) (Proof shortened by AV, 13-Feb-2022.)
theorem nb3grprlem2 {w v: setvar} (ph: wff w) (A2 B2 C: class) (E: class w) (G V: class) (X Y Z: class w v):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi ph (wcel G cusgr) $ >
  $ wi ph (wceq V (ctp A2 B2 C)) $ >
  $ wi ph (w3a (wcel A2 X) (wcel B2 Y) (wcel C Z)) $ >
  $ wi ph (w3a (wne A2 B2) (wne A2 C) (wne B2 C)) $ >
  $ wi ph (wb (wceq (co G A2 cnbgr) (cpr B2 C)) (wrex v (wrex w (wceq (co G A2 cnbgr) (cpr (cv v) (cv w))) (cdif V (csn (cv v)))) V)) $;

--| The neighbors of a vertex in a simple graph with three elements are an unordered pair of the other vertices iff all vertices are connected with each other. (Contributed by Alexander van der Vekens, 18-Oct-2017.) (Revised by AV, 28-Oct-2020.)
theorem nb3grpr {x3 y1 z: setvar} (ph: wff x3 z) (A2 B2 C: class) (E: class x3 z) (G V: class) (X Y Z: class x3 y1 z):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi ph (wcel G cusgr) $ >
  $ wi ph (wceq V (ctp A2 B2 C)) $ >
  $ wi ph (w3a (wcel A2 X) (wcel B2 Y) (wcel C Z)) $ >
  $ wi ph (w3a (wne A2 B2) (wne A2 C) (wne B2 C)) $ >
  $ wi ph (wb (w3a (wcel (cpr A2 B2) E) (wcel (cpr B2 C) E) (wcel (cpr C A2) E)) (wral x3 (wrex y1 (wrex z (wceq (co G (cv x3) cnbgr) (cpr (cv y1) (cv z))) (cdif V (csn (cv y1)))) V) V)) $;

--| The neighbors of a vertex in a simple graph with three elements are an unordered pair of the other vertices iff all vertices are connected with each other. (Contributed by Alexander van der Vekens, 18-Oct-2017.) (Revised by AV, 28-Oct-2020.)
theorem nb3grpr2 (ph: wff) (A2 B2 C E G V X Y Z: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi ph (wcel G cusgr) $ >
  $ wi ph (wceq V (ctp A2 B2 C)) $ >
  $ wi ph (w3a (wcel A2 X) (wcel B2 Y) (wcel C Z)) $ >
  $ wi ph (w3a (wne A2 B2) (wne A2 C) (wne B2 C)) $ >
  $ wi ph (wb (w3a (wcel (cpr A2 B2) E) (wcel (cpr B2 C) E) (wcel (cpr C A2) E)) (w3a (wceq (co G A2 cnbgr) (cpr B2 C)) (wceq (co G B2 cnbgr) (cpr A2 C)) (wceq (co G C cnbgr) (cpr A2 B2)))) $;

--| If the neighbors of two vertices in a graph with three elements are an unordered pair of the other vertices, the neighbors of all three vertices are an unordered pair of the other vertices. (Contributed by Alexander van der Vekens, 18-Oct-2017.) (Revised by AV, 28-Oct-2020.)
theorem nb3gr2nb (A2 B2 C G X Y Z: class):
  $ wi (wa (w3a (wcel A2 X) (wcel B2 Y) (wcel C Z)) (wa (wceq (cfv G cvtx) (ctp A2 B2 C)) (wcel G cusgr))) (wb (wa (wceq (co G A2 cnbgr) (cpr B2 C)) (wceq (co G B2 cnbgr) (cpr A2 C))) (w3a (wceq (co G A2 cnbgr) (cpr B2 C)) (wceq (co G B2 cnbgr) (cpr A2 C)) (wceq (co G C cnbgr) (cpr A2 B2)))) $;

--| Extend class notation with the universal vertices (in a graph).
term cuvtx: class;

--| Define the class of all universal vertices (in graphs). A vertex is called _universal_ if it is adjacent, i.e. connected by an edge, to all other vertices (of the graph), or equivalently, if all other vertices are its neighbors. (Contributed by Alexander van der Vekens, 12-Oct-2017.) (Revised by AV, 24-Oct-2020.)
axiom df_uvtx {v g2 n: setvar}:
  $ wceq cuvtx (cmpt g2 cvv (crab v (wral n (wcel (cv n) (co (cv g2) (cv v) cnbgr)) (cdif (cfv (cv g2) cvtx) (csn (cv v)))) (cfv (cv g2) cvtx))) $;

--| The set of all universal vertices. (Contributed by Alexander van der Vekens, 12-Oct-2017.) (Revised by AV, 29-Oct-2020.) (Revised by AV, 14-Feb-2022.)
theorem uvtxval {v n: setvar} (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq (cfv G cuvtx) (crab v (wral n (wcel (cv n) (co G (cv v) cnbgr)) (cdif V (csn (cv v)))) V) $;

--| A universal vertex, i.e. an element of the set of all universal vertices. (Contributed by Alexander van der Vekens, 12-Oct-2017.) (Revised by AV, 29-Oct-2020.) (Revised by AV, 14-Feb-2022.)
theorem uvtxel {n: setvar} (G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wb (wcel N (cfv G cuvtx)) (wa (wcel N V) (wral n (wcel (cv n) (co G N cnbgr)) (cdif V (csn N)))) $;

--| A universal vertex is a vertex. (Contributed by Alexander van der Vekens, 12-Oct-2017.) (Revised by AV, 30-Oct-2020.) (Proof shortened by AV, 14-Feb-2022.)
theorem uvtxisvtx (G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel N (cfv G cuvtx)) (wcel N V) $;

--| The set of the universal vertices is a subset of the set of all vertices. (Contributed by AV, 23-Dec-2020.)
theorem uvtxssvtx (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wss (cfv G cuvtx) V $;

--| A universal vertex has all other vertices as neighbors. (Contributed by Alexander van der Vekens, 14-Oct-2017.) (Revised by AV, 30-Oct-2020.) (Proof shortened by AV, 14-Feb-2022.)
theorem vtxnbuvtx {n: setvar} (G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel N (cfv G cuvtx)) (wral n (wcel (cv n) (co G N cnbgr)) (cdif V (csn N))) $;

--| A universal vertex has all other vertices as neighbors. (Contributed by Alexander van der Vekens, 14-Oct-2017.) (Revised by AV, 30-Oct-2020.)
theorem uvtxnbgrss (G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel N (cfv G cuvtx)) (wss (cdif V (csn N)) (co G N cnbgr)) $;

--| A universal vertex is neighbor of all other vertices. (Contributed by Alexander van der Vekens, 14-Oct-2017.) (Revised by AV, 30-Oct-2020.)
theorem uvtxnbgrvtx {v: setvar} (G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel N (cfv G cuvtx)) (wral v (wcel N (co G (cv v) cnbgr)) (cdif V (csn N))) $;

--| There is no universal vertex if there is no vertex. (Contributed by Alexander van der Vekens, 12-Oct-2017.) (Revised by AV, 30-Oct-2020.) (Proof shortened by AV, 14-Feb-2022.)
theorem uvtx0 (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wceq V c0) (wceq (cfv G cuvtx) c0) $;

--| The set of all universal vertices. (Contributed by Alexander van der Vekens, 12-Oct-2017.) (Revised by AV, 30-Oct-2020.) (Revised by AV, 14-Feb-2022.)
theorem isuvtx {v e k: setvar} (E: class v k) (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq (cfv G cuvtx) (crab v (wral k (wrex e (wss (cpr (cv k) (cv v)) (cv e)) E) (cdif V (csn (cv v)))) V) $;

--| Characterization of a universal vertex. (Contributed by Alexander van der Vekens, 12-Oct-2017.) (Revised by AV, 14-Feb-2022.)
theorem uvtxel1 {e k: setvar} (E: class k) (G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wb (wcel N (cfv G cuvtx)) (wa (wcel N V) (wral k (wrex e (wss (cpr (cv k) N) (cv e)) E) (cdif V (csn N)))) $;

--| If a graph/class has no edges, it has universal vertices if and only if it has exactly one vertex. (Contributed by Alexander van der Vekens, 12-Oct-2017.) (Revised by AV, 30-Oct-2020.) (Revised by AV, 14-Feb-2022.)
theorem uvtx01vtx (E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wceq E c0) (wb (wne (cfv G cuvtx) c0) (wceq (cfv V chash) c1)) $;

--| If a graph has two vertices, and there is an edge between the vertices, then each vertex is universal. (Contributed by AV, 1-Nov-2020.) (Revised by AV, 25-Mar-2021.) (Proof shortened by AV, 14-Feb-2022.)
theorem uvtx2vtx1edg {v: setvar} (E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wceq (cfv V chash) c2) (wcel V E)) (wral v (wcel (cv v) (cfv G cuvtx)) V) $;

--| If a hypergraph has two vertices, there is an edge between the vertices iff each vertex is universal. (Contributed by AV, 3-Nov-2020.)
theorem uvtx2vtx1edgb {v: setvar} (E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cuhgr) (wceq (cfv V chash) c2)) (wb (wcel V E) (wral v (wcel (cv v) (cfv G cuvtx)) V)) $;

--| A universal vertex has all other vertices as neighbors. (Contributed by Alexander van der Vekens, 14-Oct-2017.) (Revised by AV, 3-Nov-2020.) (Revised by AV, 23-Mar-2021.)
theorem uvtxnbgr (G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel N (cfv G cuvtx)) (wceq (co G N cnbgr) (cdif V (csn N))) $;

--| A vertex is universal iff all the other vertices are its neighbors. (Contributed by Alexander van der Vekens, 13-Jul-2018.) (Revised by AV, 3-Nov-2020.) (Revised by AV, 23-Mar-2021.) (Proof shortened by AV, 14-Feb-2022.)
theorem uvtxnbgrb (G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel N V) (wb (wcel N (cfv G cuvtx)) (wceq (co G N cnbgr) (cdif V (csn N)))) $;

--| The set of all universal vertices of a simple graph. (Contributed by Alexander van der Vekens, 12-Oct-2017.) (Revised by AV, 31-Oct-2020.)
theorem uvtxusgr {k n: setvar} (E: class k n) (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wcel G cusgr) (wceq (cfv G cuvtx) (crab n (wral k (wcel (cpr (cv k) (cv n)) E) (cdif V (csn (cv n)))) V)) $;

--| A universal vertex, i.e. an element of the set of all universal vertices, of a simple graph. (Contributed by Alexander van der Vekens, 12-Oct-2017.) (Revised by AV, 31-Oct-2020.)
theorem uvtxusgrel {k: setvar} (E: class k) (G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wcel G cusgr) (wb (wcel N (cfv G cuvtx)) (wa (wcel N V) (wral k (wcel (cpr (cv k) N) E) (cdif V (csn N))))) $;

--| A universal vertex has ` n - 1 ` neighbors in a finite graph with ` n ` vertices. (Contributed by Alexander van der Vekens, 14-Oct-2017.) (Revised by AV, 3-Nov-2020.)
theorem uvtxnm1nbgr (G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel G cfusgr) (wcel N (cfv G cuvtx))) (wceq (cfv (co G N cnbgr) chash) (co (cfv V chash) c1 cmin)) $;

--| If the number of neighbors of a vertex in a finite simple graph is the number of vertices of the graph minus 1, the vertex is universal. (Contributed by Alexander van der Vekens, 14-Jul-2018.) (Revised by AV, 16-Dec-2020.) (Proof shortened by AV, 13-Feb-2022.)
theorem nbusgrvtxm1uvtx (U G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel G cfusgr) (wcel U V)) (wi (wceq (cfv (co G U cnbgr) chash) (co (cfv V chash) c1 cmin)) (wcel U (cfv G cuvtx))) $;

--| A universal vertex has ` n - 1 ` neighbors in a finite simple graph with ` n ` vertices. A biconditional version of ~ nbusgrvtxm1uvtx resp. ~ uvtxnm1nbgr . (Contributed by Alexander van der Vekens, 14-Jul-2018.) (Revised by AV, 16-Dec-2020.)
theorem uvtxnbvtxm1 (U G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel G cfusgr) (wcel U V)) (wb (wcel U (cfv G cuvtx)) (wceq (cfv (co G U cnbgr) chash) (co (cfv V chash) c1 cmin))) $;

--| The neighborhood of a universal vertex in a restricted pseudograph. (Contributed by Alexander van der Vekens, 2-Jan-2018.) (Revised by AV, 8-Nov-2020.) (Proof shortened by AV, 13-Feb-2022.)
theorem nbupgruvtxres {e: setvar} (S: class e) (E: class) (F: class e) (G K N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq F (crab e (wnel N (cv e)) E) $ >
  $ wceq S (cop (cdif V (csn N)) (cres cid F)) $ >
  $ wi (wa (wa (wcel G cupgr) (wcel N V)) (wcel K (cdif V (csn N)))) (wi (wceq (co G K cnbgr) (cdif V (csn K))) (wceq (co S K cnbgr) (cdif V (cpr N K)))) $;

--| A universal vertex is universal in a restricted pseudograph. (Contributed by Alexander van der Vekens, 2-Jan-2018.) (Revised by AV, 8-Nov-2020.)
theorem uvtxupgrres {e: setvar} (S: class e) (E: class) (F: class e) (G K N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq F (crab e (wnel N (cv e)) E) $ >
  $ wceq S (cop (cdif V (csn N)) (cres cid F)) $ >
  $ wi (wa (wa (wcel G cupgr) (wcel N V)) (wcel K (cdif V (csn N)))) (wi (wcel K (cfv G cuvtx)) (wcel K (cfv S cuvtx))) $;

--| Extend class notation with (arbitrary) complete graphs.
term ccplgr: class;

--| Extend class notation with complete simple graphs.
term ccusgr: class;

--| Define the class of all complete "graphs". A class/graph is called _complete_ if every pair of distinct vertices is connected by an edge, i.e., each vertex has all other vertices as neighbors or, in other words, each vertex is a universal vertex. (Contributed by AV, 24-Oct-2020.) (Revised by TA, 15-Feb-2022.)
axiom df_cplgr {g2: setvar}:
  $ wceq ccplgr (cab g2 (wceq (cfv (cv g2) cuvtx) (cfv (cv g2) cvtx))) $;

--| Define the class of all complete simple graphs. A simple graph is called _complete_ if every pair of distinct vertices is connected by a (unique) edge, see definition in section 1.1 of [Diestel] p. 3. In contrast, the definition in section I.1 of [Bollobas] p. 3 is based on the size of (finite) complete graphs, see ~ cusgrsize . (Contributed by Alexander van der Vekens, 12-Oct-2017.) (Revised by AV, 24-Oct-2020.) (Revised by BJ, 14-Feb-2022.)
axiom df_cusgr:
  $ wceq ccusgr (cin cusgr ccplgr) $;

--| A graph ` G ` is complete iff each vertex is a universal vertex. (Contributed by Alexander van der Vekens, 14-Oct-2017.) (Revised by AV, 15-Feb-2022.)
theorem cplgruvtxb (G V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel G W) (wb (wcel G ccplgr) (wceq (cfv G cuvtx) V)) $;

--| A proper class (representing a null graph, see ~ vtxvalprc ) has the property of a complete graph (see also ~ cplgr0v ), but cannot be an element of ` ComplGraph ` , of course. Because of this, a sethood antecedent like ` G e. W ` is necessary in the following theorems like ~ iscplgr . (Contributed by AV, 14-Feb-2022.)
theorem prcliscplgr {v: setvar} (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wn (wcel G cvv)) (wral v (wcel (cv v) (cfv G cuvtx)) V) $;

--| The property of being a complete graph. (Contributed by AV, 1-Nov-2020.)
theorem iscplgr {v: setvar} (G V: class) (W: class v):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel G W) (wb (wcel G ccplgr) (wral v (wcel (cv v) (cfv G cuvtx)) V)) $;

--| A graph is complete iff all vertices are neighbors of all vertices. (Contributed by AV, 1-Nov-2020.)
theorem iscplgrnb {v n: setvar} (G V: class) (W: class n):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel G W) (wb (wcel G ccplgr) (wral v (wral n (wcel (cv n) (co G (cv v) cnbgr)) (cdif V (csn (cv v)))) V)) $;

--| A graph ` G ` is complete iff all vertices are connected with each other by (at least) one edge. (Contributed by AV, 10-Nov-2020.)
theorem iscplgredg {v e n: setvar} (E: class v n) (G V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wcel G W) (wb (wcel G ccplgr) (wral v (wral n (wrex e (wss (cpr (cv v) (cv n)) (cv e)) E) (cdif V (csn (cv v)))) V)) $;

--| The property of being a complete simple graph. (Contributed by AV, 1-Nov-2020.)
theorem iscusgr (G: class):
  $ wb (wcel G ccusgr) (wa (wcel G cusgr) (wcel G ccplgr)) $;

--| A complete simple graph is a simple graph. (Contributed by Alexander van der Vekens, 13-Oct-2017.) (Revised by AV, 1-Nov-2020.)
theorem cusgrusgr (G: class):
  $ wi (wcel G ccusgr) (wcel G cusgr) $;

--| A complete simple graph is a complete graph. (Contributed by AV, 1-Nov-2020.)
theorem cusgrcplgr (G: class):
  $ wi (wcel G ccusgr) (wcel G ccplgr) $;

--| A simple graph is complete iff all vertices are uniuversal. (Contributed by AV, 1-Nov-2020.)
theorem iscusgrvtx {v: setvar} (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wb (wcel G ccusgr) (wa (wcel G cusgr) (wral v (wcel (cv v) (cfv G cuvtx)) V)) $;

--| A simple graph is complete iff the set of vertices is the set of universal vertices. (Contributed by Alexander van der Vekens, 14-Oct-2017.) (Revised by Alexander van der Vekens, 18-Jan-2018.) (Revised by AV, 1-Nov-2020.)
theorem cusgruvtxb (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel G cusgr) (wb (wcel G ccusgr) (wceq (cfv G cuvtx) V)) $;

--| A simple graph is complete iff all vertices are connected by an edge. (Contributed by Alexander van der Vekens, 12-Oct-2017.) (Revised by AV, 1-Nov-2020.)
theorem iscusgredg {k n: setvar} (E: class k n) (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wb (wcel G ccusgr) (wa (wcel G cusgr) (wral k (wral n (wcel (cpr (cv n) (cv k)) E) (cdif V (csn (cv k)))) V)) $;

--| In a complete simple graph, the edges are all the pairs of different vertices. (Contributed by Alexander van der Vekens, 12-Jan-2018.) (Revised by AV, 1-Nov-2020.)
theorem cusgredg {x3: setvar} (E: class x3) (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wcel G ccusgr) (wceq E (crab x3 (wceq (cfv (cv x3) chash) c2) (cpw V))) $;

--| The null graph (with no vertices and no edges) represented by the empty set is a complete graph. (Contributed by AV, 1-Nov-2020.)
theorem cplgr0:
  $ wcel c0 ccplgr $;

--| The null graph (with no vertices and no edges) represented by the empty set is a complete simple graph. (Contributed by AV, 1-Nov-2020.)
theorem cusgr0:
  $ wcel c0 ccusgr $;

--| A null graph (with no vertices) is a complete graph. (Contributed by Alexander van der Vekens, 13-Oct-2017.) (Revised by AV, 1-Nov-2020.)
theorem cplgr0v (G V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel G W) (wceq V c0)) (wcel G ccplgr) $;

--| A graph with no vertices and no edges is a complete simple graph. (Contributed by Alexander van der Vekens, 13-Oct-2017.) (Revised by AV, 1-Nov-2020.)
theorem cusgr0v (G V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (w3a (wcel G W) (wceq V c0) (wceq (cfv G ciedg) c0)) (wcel G ccusgr) $;

--| Lemma for ~ cplgr1v and ~ cusgr1v . (Contributed by AV, 23-Mar-2021.)
theorem cplgr1vlem (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wceq (cfv V chash) c1) (wcel G cvv) $;

--| A graph with one vertex is complete. (Contributed by Alexander van der Vekens, 13-Oct-2017.) (Revised by AV, 1-Nov-2020.) (Revised by AV, 23-Mar-2021.) (Proof shortened by AV, 14-Feb-2022.)
theorem cplgr1v (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wceq (cfv V chash) c1) (wcel G ccplgr) $;

--| A graph with one vertex and no edges is a complete simple graph. (Contributed by AV, 1-Nov-2020.) (Revised by AV, 23-Mar-2021.)
theorem cusgr1v (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wceq (cfv V chash) c1) (wceq (cfv G ciedg) c0)) (wcel G ccusgr) $;

--| An undirected hypergraph with two (different) vertices is complete iff there is an edge between these two vertices. (Contributed by AV, 3-Nov-2020.)
theorem cplgr2v (E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cuhgr) (wceq (cfv V chash) c2)) (wb (wcel G ccplgr) (wcel V E)) $;

--| An undirected hypergraph with two (different) vertices is complete iff there is an edge between these two vertices. (Contributed by Alexander van der Vekens, 12-Oct-2017.) (Proof shortened by Alexander van der Vekens, 16-Dec-2017.) (Revised by AV, 3-Nov-2020.)
theorem cplgr2vpr (A2 B2 E G V X Y: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (w3a (wcel A2 X) (wcel B2 Y) (wne A2 B2)) (wa (wcel G cuhgr) (wceq V (cpr A2 B2)))) (wb (wcel G ccplgr) (wcel (cpr A2 B2) E)) $;

--| In a complete graph, each vertex has all other vertices as neighbors. (Contributed by Alexander van der Vekens, 12-Oct-2017.) (Revised by AV, 3-Nov-2020.)
theorem nbcplgr (G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel G ccplgr) (wcel N V)) (wceq (co G N cnbgr) (cdif V (csn N))) $;

--| A pseudograph with three (different) vertices is complete iff there is an edge between each of these three vertices. (Contributed by Alexander van der Vekens, 12-Oct-2017.) (Revised by AV, 5-Nov-2020.) (Proof shortened by AV, 13-Feb-2022.)
theorem cplgr3v (A2 B2 C E G X Y Z: class):
  $ wceq E (cfv G cedg) $ >
  $ wceq (cfv G cvtx) (ctp A2 B2 C) $ >
  $ wi (w3a (w3a (wcel A2 X) (wcel B2 Y) (wcel C Z)) (wcel G cupgr) (w3a (wne A2 B2) (wne A2 C) (wne B2 C))) (wb (wcel G ccplgr) (w3a (wcel (cpr A2 B2) E) (wcel (cpr B2 C) E) (wcel (cpr C A2) E))) $;

--| The neighbors of a vertex in a simple graph with three elements are unordered pairs of the other vertices if and only if the graph is complete. (Contributed by Alexander van der Vekens, 18-Oct-2017.) (Revised by AV, 5-Nov-2020.)
theorem cusgr3vnbpr {x3 y1 z: setvar} (A2 B2 C E G V: class) (X Y Z: class x3 z):
  $ wceq E (cfv G cedg) $ >
  $ wceq (cfv G cvtx) (ctp A2 B2 C) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wi (w3a (w3a (wcel A2 X) (wcel B2 Y) (wcel C Z)) (wcel G cusgr) (w3a (wne A2 B2) (wne A2 C) (wne B2 C))) (wb (wcel G ccplgr) (wral x3 (wrex y1 (wrex z (wceq (co G (cv x3) cnbgr) (cpr (cv y1) (cv z))) (cdif V (csn (cv y1)))) V) V)) $;

--| A complete graph represented by an ordered pair. (Contributed by AV, 10-Nov-2020.)
theorem cplgrop (G: class):
  $ wi (wcel G ccplgr) (wcel (cop (cfv G cvtx) (cfv G ciedg)) ccplgr) $;

--| A complete simple graph represented by an ordered pair. (Contributed by AV, 10-Nov-2020.)
theorem cusgrop (G: class):
  $ wi (wcel G ccusgr) (wcel (cop (cfv G cvtx) (cfv G ciedg)) ccusgr) $;

--| Lemma 1 for ~ cusgrexi . (Contributed by Alexander van der Vekens, 12-Jan-2018.)
theorem cusgrexilem1 {x3: setvar} (P: class x3) (V: class) (W: class x3):
  $ wceq P (crab x3 (wceq (cfv (cv x3) chash) c2) (cpw V)) $ >
  $ wi (wcel V W) (wcel (cres cid P) cvv) $;

--| Lemma for ~ usgrexi . (Contributed by AV, 12-Jan-2018.) (Revised by AV, 10-Nov-2021.)
theorem usgrexilem {x3: setvar} (P: class x3) (V: class) (W: class x3):
  $ wceq P (crab x3 (wceq (cfv (cv x3) chash) c2) (cpw V)) $ >
  $ wi (wcel V W) (wf1 (cdm (cres cid P)) (crab x3 (wceq (cfv (cv x3) chash) c2) (cpw V)) (cres cid P)) $;

--| An arbitrary set regarded as vertices together with the set of pairs of elements of this set regarded as edges is a simple graph. (Contributed by Alexander van der Vekens, 12-Jan-2018.) (Revised by AV, 5-Nov-2020.) (Proof shortened by AV, 10-Nov-2021.)
theorem usgrexi {x3: setvar} (P V W: class):
  $ wceq P (crab x3 (wceq (cfv (cv x3) chash) c2) (cpw V)) $ >
  $ wi (wcel V W) (wcel (cop V (cres cid P)) cusgr) $;

--| Lemma 2 for ~ cusgrexi . (Contributed by AV, 12-Jan-2018.) (Revised by AV, 10-Nov-2021.)
theorem cusgrexilem2 {x3 e: setvar} (v: setvar) (P: class) (n: setvar) (V W: class):
  $ wceq P (crab x3 (wceq (cfv (cv x3) chash) c2) (cpw V)) $ >
  $ wi (wa (wa (wcel V W) (wcel (cv v) V)) (wcel (cv n) (cdif V (csn (cv v))))) (wrex e (wss (cpr (cv v) (cv n)) (cv e)) (crn (cres cid P))) $;

--| An arbitrary set ` V ` regarded as set of vertices together with the set of pairs of elements of this set regarded as edges is a complete simple graph. (Contributed by Alexander van der Vekens, 12-Jan-2018.) (Revised by AV, 5-Nov-2020.) (Proof shortened by AV, 14-Feb-2022.)
theorem cusgrexi {x3: setvar} (P V W: class):
  $ wceq P (crab x3 (wceq (cfv (cv x3) chash) c2) (cpw V)) $ >
  $ wi (wcel V W) (wcel (cop V (cres cid P)) ccusgr) $;

--| For each set there is a set of edges so that the set together with these edges is a complete simple graph. (Contributed by Alexander van der Vekens, 12-Jan-2018.) (Revised by AV, 5-Nov-2020.)
theorem cusgrexg {e: setvar} (V: class) (W: class e):
  $ wi (wcel V W) (wex e (wcel (cop V (cv e)) ccusgr)) $;

--| Any (extensible) structure with a base set can be made a simple graph with the set of pairs of elements of the base set regarded as edges. (Contributed by AV, 10-Nov-2021.) (Revised by AV, 17-Nov-2021.)
theorem structtousgr {x3: setvar} (ph: wff) (P S G: class) (X: class x3):
  $ wceq P (crab x3 (wceq (cfv (cv x3) chash) c2) (cpw (cfv S cbs))) $ >
  $ wi ph (wbr S X cstr) $ >
  $ wceq G (co S (cop (cfv cnx cedgf) (cres cid P)) csts) $ >
  $ wi ph (wcel (cfv cnx cbs) (cdm S)) $ >
  $ wi ph (wcel G cusgr) $;

--| Any (extensible) structure with a base set can be made a complete simple graph with the set of pairs of elements of the base set regarded as edges. (Contributed by AV, 10-Nov-2021.) (Revised by AV, 17-Nov-2021.) (Proof shortened by AV, 14-Feb-2022.)
theorem structtocusgr {x3: setvar} (ph: wff) (P S G: class) (X: class x3):
  $ wceq P (crab x3 (wceq (cfv (cv x3) chash) c2) (cpw (cfv S cbs))) $ >
  $ wi ph (wbr S X cstr) $ >
  $ wceq G (co S (cop (cfv cnx cedgf) (cres cid P)) csts) $ >
  $ wi ph (wcel (cfv cnx cbs) (cdm S)) $ >
  $ wi ph (wcel G ccusgr) $;

--| The field of complex numbers can be made a complete simple graph with the set of pairs of complex numbers regarded as edges. This theorem demonstrates the capabilities of the current definitions for graphs applied to extensible structures. (Contributed by AV, 14-Nov-2021.) (Proof shortened by AV, 17-Nov-2021.) Revise ~ df-cnfld . (Revised by GG, 31-Mar-2025.)
theorem cffldtocusgr {x3: setvar} (P G: class):
  $ wceq P (crab x3 (wceq (cfv (cv x3) chash) c2) (cpw cc)) $ >
  $ wceq G (co ccnfld (cop (cfv cnx cedgf) (cres cid P)) csts) $ >
  $ wcel G ccusgr $;

--| Restricting a complete simple graph. (Contributed by Alexander van der Vekens, 2-Jan-2018.)
theorem cusgrres {e: setvar} (S: class e) (E: class) (F: class e) (G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq F (crab e (wnel N (cv e)) E) $ >
  $ wceq S (cop (cdif V (csn N)) (cres cid F)) $ >
  $ wi (wa (wcel G ccusgr) (wcel N V)) (wcel S ccusgr) $;

--| Base case of the induction in ~ cusgrsize . The size of a complete simple graph with 0 vertices, actually of every null graph, is 0=((0-1)*0)/2. (Contributed by Alexander van der Vekens, 2-Jan-2018.) (Revised by AV, 7-Nov-2020.)
theorem cusgrsizeindb0 (E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cuhgr) (wceq (cfv V chash) cc0)) (wceq (cfv E chash) (co (cfv V chash) c2 cbc)) $;

--| Base case of the induction in ~ cusgrsize . The size of a (complete) simple graph with 1 vertex is 0=((1-1)*1)/2. (Contributed by Alexander van der Vekens, 2-Jan-2018.) (Revised by AV, 7-Nov-2020.)
theorem cusgrsizeindb1 (E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cusgr) (wceq (cfv V chash) c1)) (wceq (cfv E chash) (co (cfv V chash) c2 cbc)) $;

--| Lemma for ~ cusgrsizeinds . (Contributed by Alexander van der Vekens, 11-Jan-2018.) (Revised by AV, 9-Nov-2020.)
theorem cusgrsizeindslem {e: setvar} (E G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (w3a (wcel G ccusgr) (wcel V cfn) (wcel N V)) (wceq (cfv (crab e (wcel N (cv e)) E) chash) (co (cfv V chash) c1 cmin)) $;

--| Part 1 of induction step in ~ cusgrsize . The size of a complete simple graph with ` n ` vertices is ` ( n - 1 ) ` plus the size of the complete graph reduced by one vertex. (Contributed by Alexander van der Vekens, 11-Jan-2018.) (Revised by AV, 9-Nov-2020.)
theorem cusgrsizeinds {e: setvar} (E: class) (F: class e) (G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq F (crab e (wnel N (cv e)) E) $ >
  $ wi (w3a (wcel G ccusgr) (wcel V cfn) (wcel N V)) (wceq (cfv E chash) (co (co (cfv V chash) c1 cmin) (cfv F chash) caddc)) $;

--| Induction step in ~ cusgrsize . If the size of the complete graph with ` n ` vertices reduced by one vertex is " ` ( n - 1 ) ` choose 2", the size of the complete graph with ` n ` vertices is " ` n ` choose 2". (Contributed by Alexander van der Vekens, 11-Jan-2018.) (Revised by AV, 9-Nov-2020.)
theorem cusgrsize2inds {e: setvar} (E: class) (F: class e) (G N V: class) (Y: class e):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq F (crab e (wnel N (cv e)) E) $ >
  $ wi (wcel Y cn0) (wi (w3a (wcel G ccusgr) (wceq (cfv V chash) Y) (wcel N V)) (wi (wceq (cfv F chash) (co (cfv (cdif V (csn N)) chash) c2 cbc)) (wceq (cfv E chash) (co (cfv V chash) c2 cbc)))) $;

--| The size of a finite complete simple graph with ` n ` vertices ( ` n e. NN0 ` ) is ` ( n _C 2 ) ` (" ` n ` choose 2") resp. ` ( ( ( n - 1 ) * n ) / 2 ) ` , see definition in section I.1 of [Bollobas] p. 3 . (Contributed by Alexander van der Vekens, 11-Jan-2018.) (Revised by AV, 10-Nov-2020.)
theorem cusgrsize (E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G ccusgr) (wcel V cfn)) (wceq (cfv E chash) (co (cfv V chash) c2 cbc)) $;

--| Lemma 1 for ~ cusgrfi . (Contributed by Alexander van der Vekens, 13-Jan-2018.) (Revised by AV, 11-Nov-2020.)
theorem cusgrfilem1 {x3 a: setvar} (P: class x3 a) (G: class a) (N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq P (crab x3 (wrex a (wa (wne (cv a) N) (wceq (cv x3) (cpr (cv a) N))) V) (cpw V)) $ >
  $ wi (wa (wcel G ccusgr) (wcel N V)) (wss P (cfv G cedg)) $;

--| Lemma 2 for ~ cusgrfi . (Contributed by Alexander van der Vekens, 13-Jan-2018.) (Revised by AV, 11-Nov-2020.)
theorem cusgrfilem2 {x3 a: setvar} (P: class a) (F: class x3 a) (G: class a) (N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq P (crab x3 (wrex a (wa (wne (cv a) N) (wceq (cv x3) (cpr (cv a) N))) V) (cpw V)) $ >
  $ wceq F (cmpt x3 (cdif V (csn N)) (cpr (cv x3) N)) $ >
  $ wi (wcel N V) (wf1o (cdif V (csn N)) P F) $;

--| Lemma 3 for ~ cusgrfi . (Contributed by Alexander van der Vekens, 13-Jan-2018.) (Revised by AV, 11-Nov-2020.)
theorem cusgrfilem3 {x3 a: setvar} (P: class a) (F: class x3 a) (G: class a) (N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq P (crab x3 (wrex a (wa (wne (cv a) N) (wceq (cv x3) (cpr (cv a) N))) V) (cpw V)) $ >
  $ wceq F (cmpt x3 (cdif V (csn N)) (cpr (cv x3) N)) $ >
  $ wi (wcel N V) (wb (wcel V cfn) (wcel P cfn)) $;

--| If the size of a complete simple graph is finite, then its order is also finite. (Contributed by Alexander van der Vekens, 13-Jan-2018.) (Revised by AV, 11-Nov-2020.)
theorem cusgrfi (E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G ccusgr) (wcel E cfn)) (wcel V cfn) $;

--| A simple graph is a subgraph of a complete simple graph. (Contributed by Alexander van der Vekens, 11-Jan-2018.) (Revised by AV, 13-Nov-2020.)
theorem usgredgsscusgredg (E F G H V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq V (cfv H cvtx) $ >
  $ wceq F (cfv H cedg) $ >
  $ wi (wa (wcel G cusgr) (wcel H ccusgr)) (wss E F) $;

--| A simple graph is a subgraph of a complete simple graph. (Contributed by Alexander van der Vekens, 11-Jan-2018.) (Revised by AV, 13-Nov-2020.)
theorem usgrsscusgr {e f2: setvar} (E: class f2) (F: class) (G H: class f2) (V: class e f2):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq V (cfv H cvtx) $ >
  $ wceq F (cfv H cedg) $ >
  $ wi (wa (wcel G cusgr) (wcel H ccusgr)) (wral e (wrex f2 (wceq (cv e) (cv f2)) F) E) $;

--| Lemma 1 for ~ sizusglecusg . (Contributed by Alexander van der Vekens, 12-Jan-2018.) (Revised by AV, 13-Nov-2020.)
theorem sizusglecusglem1 (E F G H V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq V (cfv H cvtx) $ >
  $ wceq F (cfv H cedg) $ >
  $ wi (wa (wcel G cusgr) (wcel H ccusgr)) (wf1 E F (cres cid E)) $;

--| Lemma 2 for ~ sizusglecusg . (Contributed by Alexander van der Vekens, 13-Jan-2018.) (Revised by AV, 13-Nov-2020.)
theorem sizusglecusglem2 (E F G H V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq V (cfv H cvtx) $ >
  $ wceq F (cfv H cedg) $ >
  $ wi (w3a (wcel G cusgr) (wcel H ccusgr) (wcel F cfn)) (wcel E cfn) $;

--| The size of a simple graph with ` n ` vertices is at most the size of a complete simple graph with ` n ` vertices ( ` n ` may be infinite). (Contributed by Alexander van der Vekens, 13-Jan-2018.) (Revised by AV, 13-Nov-2020.)
theorem sizusglecusg (E F G H V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq V (cfv H cvtx) $ >
  $ wceq F (cfv H cedg) $ >
  $ wi (wa (wcel G cusgr) (wcel H ccusgr)) (wbr (cfv E chash) (cfv F chash) cle) $;

--| The maximum size of a finite simple graph with ` n ` vertices is ` ( ( ( n - 1 ) * n ) / 2 ) ` . See statement in section I.1 of [Bollobas] p. 3 . (Contributed by Alexander van der Vekens, 13-Jan-2018.) (Revised by AV, 14-Nov-2020.)
theorem fusgrmaxsize (E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wcel G cfusgr) (wbr (cfv E chash) (co (cfv V chash) c2 cbc) cle) $;

--| Extend class notation with the vertex degree function.
term cvtxdg: class;

--| Define the vertex degree function for a graph. To be appropriate for arbitrary hypergraphs, we have to double-count those edges that contain ` u ` "twice" (i.e. self-loops), this being represented as a singleton as the edge's value. Since the degree of a vertex can be (positive) infinity (if the graph containing the vertex is not of finite size), the extended addition ` +e ` is used for the summation of the number of "ordinary" edges" and the number of "loops". (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by Alexander van der Vekens, 20-Dec-2017.) (Revised by AV, 9-Dec-2020.)
axiom df_vtxdg {x3 v u e g2: setvar}:
  $ wceq cvtxdg (cmpt g2 cvv (csb v (cfv (cv g2) cvtx) (csb e (cfv (cv g2) ciedg) (cmpt u (cv v) (co (cfv (crab x3 (wcel (cv u) (cfv (cv x3) (cv e))) (cdm (cv e))) chash) (cfv (crab x3 (wceq (cfv (cv x3) (cv e)) (csn (cv u))) (cdm (cv e))) chash) cxad))))) $;

--| The value of the vertex degree function. (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by Alexander van der Vekens, 20-Dec-2017.) (Revised by AV, 9-Dec-2020.)
theorem vtxdgfval {x3 u: setvar} (A2: class u) (G: class) (I: class x3 u) (V: class x3) (W: class x3 u):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq A2 (cdm I) $ >
  $ wi (wcel G W) (wceq (cfv G cvtxdg) (cmpt u V (co (cfv (crab x3 (wcel (cv u) (cfv (cv x3) I)) A2) chash) (cfv (crab x3 (wceq (cfv (cv x3) I) (csn (cv u))) A2) chash) cxad))) $;

--| The degree of a vertex. (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by Alexander van der Vekens, 20-Dec-2017.) (Revised by AV, 10-Dec-2020.) (Revised by AV, 22-Mar-2021.)
theorem vtxdgval {x3: setvar} (A2 U G: class) (I V: class x3):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq A2 (cdm I) $ >
  $ wi (wcel U V) (wceq (cfv U (cfv G cvtxdg)) (co (cfv (crab x3 (wcel U (cfv (cv x3) I)) A2) chash) (cfv (crab x3 (wceq (cfv (cv x3) I) (csn U)) A2) chash) cxad)) $;

--| The degree of a vertex for graphs of finite size. (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by Alexander van der Vekens, 21-Jan-2018.) (Revised by AV, 8-Dec-2020.) (Revised by AV, 22-Mar-2021.)
theorem vtxdgfival {x3: setvar} (A2 U G: class) (I V: class x3):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq A2 (cdm I) $ >
  $ wi (wa (wcel A2 cfn) (wcel U V)) (wceq (cfv U (cfv G cvtxdg)) (co (cfv (crab x3 (wcel U (cfv (cv x3) I)) A2) chash) (cfv (crab x3 (wceq (cfv (cv x3) I) (csn U)) A2) chash) caddc)) $;

--| The vertex degree expressed as operation. (Contributed by AV, 12-Dec-2021.)
theorem vtxdgop (G W: class):
  $ wi (wcel G W) (wceq (cfv G cvtxdg) (co (cfv G cvtx) (cfv G ciedg) cvtxdg)) $;

--| The vertex degree function is a function from vertices to extended nonnegative integers. (Contributed by Alexander van der Vekens, 20-Dec-2017.) (Revised by AV, 10-Dec-2020.)
theorem vtxdgf (G V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel G W) (wf V cxnn0 (cfv G cvtxdg)) $;

--| The degree of a vertex is either a nonnegative integer or positive infinity. (Contributed by Alexander van der Vekens, 30-Dec-2017.) (Revised by AV, 10-Dec-2020.) (Revised by AV, 22-Mar-2021.)
theorem vtxdgelxnn0 (G V X: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel X V) (wcel (cfv X (cfv G cvtxdg)) cxnn0) $;

--| The degree of a vertex in the null graph is zero (or anything else), because there are no vertices. (Contributed by AV, 11-Dec-2020.)
theorem vtxdg0v (U G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wceq G c0) (wcel U V)) (wceq (cfv U (cfv G cvtxdg)) cc0) $;

--| The degree of a vertex in an empty graph is zero, because there are no edges. This is the base case for the induction for calculating the degree of a vertex, for example in a K&ouml;nigsberg graph (see also the induction steps ~ vdegp1ai , ~ vdegp1bi and ~ vdegp1ci ). (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by Alexander van der Vekens, 20-Dec-2017.) (Revised by AV, 11-Dec-2020.) (Revised by AV, 22-Mar-2021.)
theorem vtxdg0e (U G I V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi (wa (wcel U V) (wceq I c0)) (wceq (cfv U (cfv G cvtxdg)) cc0) $;

--| The degree of a vertex in a graph of finite size is a nonnegative integer. (Contributed by Alexander van der Vekens, 10-Mar-2018.) (Revised by AV, 11-Dec-2020.) (Revised by AV, 22-Mar-2021.)
theorem vtxdgfisnn0 (A2 U G I V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq A2 (cdm I) $ >
  $ wi (wa (wcel A2 cfn) (wcel U V)) (wcel (cfv U (cfv G cvtxdg)) cn0) $;

--| The vertex degree function on graphs of finite size is a function from vertices to nonnegative integers. (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by Alexander van der Vekens, 20-Dec-2017.) (Revised by AV, 11-Dec-2020.)
theorem vtxdgfisf (A2 G I V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq A2 (cdm I) $ >
  $ wi (wa (wcel G W) (wcel A2 cfn)) (wf V cn0 (cfv G cvtxdg)) $;

--| Equality theorem for the vertex degree: If two graphs are structurally equal, their vertex degree functions are equal. (Contributed by AV, 26-Feb-2021.)
theorem vtxdeqd (ph: wff) (G H X Y: class):
  $ wi ph (wcel G X) $ >
  $ wi ph (wcel H Y) $ >
  $ wi ph (wceq (cfv H cvtx) (cfv G cvtx)) $ >
  $ wi ph (wceq (cfv H ciedg) (cfv G ciedg)) $ >
  $ wi ph (wceq (cfv H cvtxdg) (cfv G cvtxdg)) $;

--| The degree of a vertex in an empty hypergraph is zero, because there are no edges. Analogue of ~ vtxdg0e . (Contributed by AV, 15-Dec-2020.)
theorem vtxduhgr0e (U E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (w3a (wcel G cuhgr) (wcel U V) (wceq E c0)) (wceq (cfv U (cfv G cvtxdg)) cc0) $;

--| The degree of the vertex in a loop-free hypergraph with one vertex is 0. (Contributed by AV, 2-Apr-2021.)
theorem vtxdlfuhgr1v {x3: setvar} (U E: class x3) (G: class) (I: class x3) (V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq E (crab x3 (wbr c2 (cfv (cv x3) chash) cle) (cpw V)) $ >
  $ wi (w3a (wcel G cuhgr) (wceq (cfv V chash) c1) (wf (cdm I) E I)) (wi (wcel U V) (wceq (cfv U (cfv G cvtxdg)) cc0)) $;

--| A vertex in a multigraph has degree 0 if the graph consists of only one vertex. (Contributed by Alexander van der Vekens, 6-Dec-2017.) (Revised by AV, 2-Apr-2021.)
theorem vdumgr0 (G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (w3a (wcel G cumgr) (wcel N V) (wceq (cfv V chash) c1)) (wceq (cfv N (cfv G cvtxdg)) cc0) $;

--| The degree of a vertex in the union of two graphs on the same vertex set is the sum of the degrees of the vertex in each graph. (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by Alexander van der Vekens, 21-Dec-2017.) (Revised by AV, 19-Feb-2021.)
theorem vtxdun (ph: wff) (U G H I J N V: class):
  $ wceq I (cfv G ciedg) $ >
  $ wceq J (cfv H ciedg) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wi ph (wceq (cfv H cvtx) V) $ >
  $ wi ph (wceq (cfv U cvtx) V) $ >
  $ wi ph (wceq (cin (cdm I) (cdm J)) c0) $ >
  $ wi ph (wfun I) $ >
  $ wi ph (wfun J) $ >
  $ wi ph (wcel N V) $ >
  $ wi ph (wceq (cfv U ciedg) (cun I J)) $ >
  $ wi ph (wceq (cfv N (cfv U cvtxdg)) (co (cfv N (cfv G cvtxdg)) (cfv N (cfv H cvtxdg)) cxad)) $;

--| The degree of a vertex in the union of two hypergraphs of finite size on the same vertex set is the sum of the degrees of the vertex in each hypergraph. (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by Alexander van der Vekens, 21-Jan-2018.) (Revised by AV, 19-Feb-2021.)
theorem vtxdfiun (ph: wff) (U G H I J N V: class):
  $ wceq I (cfv G ciedg) $ >
  $ wceq J (cfv H ciedg) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wi ph (wceq (cfv H cvtx) V) $ >
  $ wi ph (wceq (cfv U cvtx) V) $ >
  $ wi ph (wceq (cin (cdm I) (cdm J)) c0) $ >
  $ wi ph (wfun I) $ >
  $ wi ph (wfun J) $ >
  $ wi ph (wcel N V) $ >
  $ wi ph (wceq (cfv U ciedg) (cun I J)) $ >
  $ wi ph (wcel (cdm I) cfn) $ >
  $ wi ph (wcel (cdm J) cfn) $ >
  $ wi ph (wceq (cfv N (cfv U cvtxdg)) (co (cfv N (cfv G cvtxdg)) (cfv N (cfv H cvtxdg)) caddc)) $;

--| The degree of a vertex in the union of two hypergraphs on the same vertex set is the sum of the degrees of the vertex in each hypergraph. (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by Alexander van der Vekens, 21-Dec-2017.) (Revised by AV, 12-Dec-2020.) (Proof shortened by AV, 19-Feb-2021.)
theorem vtxduhgrun (ph: wff) (U G H I J N V: class):
  $ wceq I (cfv G ciedg) $ >
  $ wceq J (cfv H ciedg) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wi ph (wceq (cfv H cvtx) V) $ >
  $ wi ph (wceq (cfv U cvtx) V) $ >
  $ wi ph (wceq (cin (cdm I) (cdm J)) c0) $ >
  $ wi ph (wcel G cuhgr) $ >
  $ wi ph (wcel H cuhgr) $ >
  $ wi ph (wcel N V) $ >
  $ wi ph (wceq (cfv U ciedg) (cun I J)) $ >
  $ wi ph (wceq (cfv N (cfv U cvtxdg)) (co (cfv N (cfv G cvtxdg)) (cfv N (cfv H cvtxdg)) cxad)) $;

--| The degree of a vertex in the union of two hypergraphs of finite size on the same vertex set is the sum of the degrees of the vertex in each hypergraph. (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by Alexander van der Vekens, 21-Jan-2018.) (Revised by AV, 7-Dec-2020.) (Proof shortened by AV, 19-Feb-2021.)
theorem vtxduhgrfiun (ph: wff) (U G H I J N V: class):
  $ wceq I (cfv G ciedg) $ >
  $ wceq J (cfv H ciedg) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wi ph (wceq (cfv H cvtx) V) $ >
  $ wi ph (wceq (cfv U cvtx) V) $ >
  $ wi ph (wceq (cin (cdm I) (cdm J)) c0) $ >
  $ wi ph (wcel G cuhgr) $ >
  $ wi ph (wcel H cuhgr) $ >
  $ wi ph (wcel N V) $ >
  $ wi ph (wceq (cfv U ciedg) (cun I J)) $ >
  $ wi ph (wcel (cdm I) cfn) $ >
  $ wi ph (wcel (cdm J) cfn) $ >
  $ wi ph (wceq (cfv N (cfv U cvtxdg)) (co (cfv N (cfv G cvtxdg)) (cfv N (cfv H cvtxdg)) caddc)) $;

--| The value of the vertex degree function for a loop-free graph ` G ` . (Contributed by AV, 23-Feb-2021.)
theorem vtxdlfgrval {x3: setvar} (A2: class) (D: class x3) (U G I V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq A2 (cdm I) $ >
  $ wceq D (cfv G cvtxdg) $ >
  $ wi (wa (wf A2 (crab x3 (wbr c2 (cfv (cv x3) chash) cle) (cpw V)) I) (wcel U V)) (wceq (cfv U D) (cfv (crab x3 (wcel U (cfv (cv x3) I)) A2) chash)) $;

--| The value of the vertex degree function for a multigraph. (Contributed by Alexander van der Vekens, 20-Dec-2017.) (Revised by AV, 23-Feb-2021.)
theorem vtxdumgrval {x3: setvar} (A2: class) (D: class x3) (U G I V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq A2 (cdm I) $ >
  $ wceq D (cfv G cvtxdg) $ >
  $ wi (wa (wcel G cumgr) (wcel U V)) (wceq (cfv U D) (cfv (crab x3 (wcel U (cfv (cv x3) I)) A2) chash)) $;

--| The value of the vertex degree function for a simple graph. (Contributed by Alexander van der Vekens, 20-Dec-2017.) (Revised by AV, 11-Dec-2020.)
theorem vtxdusgrval {x3: setvar} (A2: class) (D: class x3) (U G I V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq A2 (cdm I) $ >
  $ wceq D (cfv G cvtxdg) $ >
  $ wi (wa (wcel G cusgr) (wcel U V)) (wceq (cfv U D) (cfv (crab x3 (wcel U (cfv (cv x3) I)) A2) chash)) $;

--| A vertex has degree 0 iff there is no edge incident with the vertex. (Contributed by AV, 24-Dec-2020.) (Revised by AV, 22-Mar-2021.)
theorem vtxd0nedgb {i: setvar} (D: class i) (U G I V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq D (cfv G cvtxdg) $ >
  $ wi (wcel U V) (wb (wceq (cfv U D) cc0) (wn (wrex i (wcel U (cfv (cv i) I)) (cdm I)))) $;

--| Lemma for ~ vtxdushgrfvedg and ~ vtxdusgrfvedg . (Contributed by AV, 12-Dec-2020.) (Proof shortened by AV, 5-May-2021.)
theorem vtxdushgrfvedglem {e i: setvar} (U E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cushgr) (wcel U V)) (wceq (cfv (crab i (wcel U (cfv (cv i) (cfv G ciedg))) (cdm (cfv G ciedg))) chash) (cfv (crab e (wcel U (cv e)) E) chash)) $;

--| The value of the vertex degree function for a simple hypergraph. (Contributed by AV, 12-Dec-2020.) (Proof shortened by AV, 5-May-2021.)
theorem vtxdushgrfvedg {e: setvar} (D: class e) (U E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq D (cfv G cvtxdg) $ >
  $ wi (wa (wcel G cushgr) (wcel U V)) (wceq (cfv U D) (co (cfv (crab e (wcel U (cv e)) E) chash) (cfv (crab e (wceq (cv e) (csn U)) E) chash) cxad)) $;

--| The value of the vertex degree function for a simple graph. (Contributed by AV, 12-Dec-2020.)
theorem vtxdusgrfvedg {e: setvar} (D: class e) (U E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq D (cfv G cvtxdg) $ >
  $ wi (wa (wcel G cusgr) (wcel U V)) (wceq (cfv U D) (cfv (crab e (wcel U (cv e)) E) chash)) $;

--| If a vertex in a hypergraph has degree 0, the vertex is not adjacent to another vertex via an edge. (Contributed by Alexander van der Vekens, 8-Dec-2017.) (Revised by AV, 15-Dec-2020.) (Proof shortened by AV, 24-Dec-2020.)
theorem vtxduhgr0nedg {v: setvar} (D: class v) (U: class) (E: class v) (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq D (cfv G cvtxdg) $ >
  $ wi (w3a (wcel G cuhgr) (wcel U V) (wceq (cfv U D) cc0)) (wn (wrex v (wcel (cpr U (cv v)) E) V)) $;

--| If a vertex in a multigraph has degree 0, the vertex is not adjacent to another vertex via an edge. (Contributed by Alexander van der Vekens, 8-Dec-2017.) (Revised by AV, 12-Dec-2020.) (Proof shortened by AV, 15-Dec-2020.)
theorem vtxdumgr0nedg {v: setvar} (D: class v) (U: class) (E: class v) (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq D (cfv G cvtxdg) $ >
  $ wi (w3a (wcel G cumgr) (wcel U V) (wceq (cfv U D) cc0)) (wn (wrex v (wcel (cpr U (cv v)) E) V)) $;

--| A vertex in a hypergraph has degree 0 iff there is no edge incident with this vertex. (Contributed by AV, 24-Dec-2020.)
theorem vtxduhgr0edgnel {e: setvar} (D: class e) (U E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq D (cfv G cvtxdg) $ >
  $ wi (wa (wcel G cuhgr) (wcel U V)) (wb (wceq (cfv U D) cc0) (wn (wrex e (wcel U (cv e)) E))) $;

--| A vertex in a simple graph has degree 0 iff there is no edge incident with this vertex. (Contributed by AV, 17-Dec-2020.) (Proof shortened by AV, 24-Dec-2020.)
theorem vtxdusgr0edgnel {e: setvar} (D: class e) (U E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq D (cfv G cvtxdg) $ >
  $ wi (wa (wcel G cusgr) (wcel U V)) (wb (wceq (cfv U D) cc0) (wn (wrex e (wcel U (cv e)) E))) $;

--| Alternate proof of ~ vtxdusgr0edgnel , not based on ~ vtxduhgr0edgnel . A vertex in a simple graph has degree 0 if there is no edge incident with this vertex. (Contributed by AV, 17-Dec-2020.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem vtxdusgr0edgnelALT {e: setvar} (D: class e) (U E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq D (cfv G cvtxdg) $ >
  $ wi (wa (wcel G cusgr) (wcel U V)) (wb (wceq (cfv U D) cc0) (wn (wrex e (wcel U (cv e)) E))) $;

--| The vertex degree function on finite simple graphs is a function from vertices to nonnegative integers. (Contributed by AV, 12-Dec-2020.)
theorem vtxdgfusgrf (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel G cfusgr) (wf V cn0 (cfv G cvtxdg)) $;

--| In a finite simple graph, the degree of each vertex is finite. (Contributed by Alexander van der Vekens, 10-Mar-2018.) (Revised by AV, 12-Dec-2020.)
theorem vtxdgfusgr {v: setvar} (G: class) (V: class v):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel G cfusgr) (wral v (wcel (cfv (cv v) (cfv G cvtxdg)) cn0) V) $;

--| In a nonempty, finite graph there is a vertex having a nonnegative integer as degree. (Contributed by Alexander van der Vekens, 6-Sep-2018.) (Revised by AV, 1-Apr-2021.)
theorem fusgrn0degnn0 {v n: setvar} (G: class) (V: class n):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel G cfusgr) (wne V c0)) (wrex v (wrex n (wceq (cfv (cv v) (cfv G cvtxdg)) (cv n)) cn0) V) $;

--| A graph with one edge which is a loop is a simple pseudograph (see also ~ uspgr1v1eop ). (Contributed by AV, 21-Feb-2021.)
theorem _1loopgruspgr (ph: wff) (A2 G N V X: class):
  $ wi ph (wceq (cfv G cvtx) V) $ >
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wcel N V) $ >
  $ wi ph (wceq (cfv G ciedg) (csn (cop A2 (csn N)))) $ >
  $ wi ph (wcel G cuspgr) $;

--| The set of edges in a graph (simple pseudograph) with one edge which is a loop is a singleton of a singleton. (Contributed by AV, 17-Dec-2020.) (Revised by AV, 21-Feb-2021.)
theorem _1loopgredg (ph: wff) (A2 G N V X: class):
  $ wi ph (wceq (cfv G cvtx) V) $ >
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wcel N V) $ >
  $ wi ph (wceq (cfv G ciedg) (csn (cop A2 (csn N)))) $ >
  $ wi ph (wceq (cfv G cedg) (csn (csn N))) $;

--| In a graph (simple pseudograph) with one edge which is a loop, the vertex connected with itself by the loop has no neighbors. (Contributed by AV, 17-Dec-2020.) (Revised by AV, 21-Feb-2021.)
theorem _1loopgrnb0 (ph: wff) (A2 G N V X: class):
  $ wi ph (wceq (cfv G cvtx) V) $ >
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wcel N V) $ >
  $ wi ph (wceq (cfv G ciedg) (csn (cop A2 (csn N)))) $ >
  $ wi ph (wceq (co G N cnbgr) c0) $;

--| The vertex degree of a one-edge graph, case 4: an edge from a vertex to itself contributes two to the vertex's degree. I. e. in a graph (simple pseudograph) with one edge which is a loop, the vertex connected with itself by the loop has degree 2. (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by Alexander van der Vekens, 22-Dec-2017.) (Revised by AV, 21-Feb-2021.)
theorem _1loopgrvd2 (ph: wff) (A2 G N V X: class):
  $ wi ph (wceq (cfv G cvtx) V) $ >
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wcel N V) $ >
  $ wi ph (wceq (cfv G ciedg) (csn (cop A2 (csn N)))) $ >
  $ wi ph (wceq (cfv N (cfv G cvtxdg)) c2) $;

--| The vertex degree of a one-edge graph, case 1 (for a loop): a loop at a vertex other than the given vertex contributes nothing to the vertex degree. (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by AV, 21-Feb-2021.)
theorem _1loopgrvd0 (ph: wff) (A2 G K N V X: class):
  $ wi ph (wceq (cfv G cvtx) V) $ >
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wcel N V) $ >
  $ wi ph (wceq (cfv G ciedg) (csn (cop A2 (csn N)))) $ >
  $ wi ph (wcel K (cdif V (csn N))) $ >
  $ wi ph (wceq (cfv K (cfv G cvtxdg)) cc0) $;

--| The vertex degree of vertex ` D ` in a graph ` G ` with only one hyperedge ` E ` is 0 if ` D ` is not incident with the edge ` E ` . (Contributed by AV, 2-Mar-2021.)
theorem _1hevtxdg0 (ph: wff) (A2 D E G V X Y: class):
  $ wi ph (wceq (cfv G ciedg) (csn (cop A2 E))) $ >
  $ wi ph (wceq (cfv G cvtx) V) $ >
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel E Y) $ >
  $ wi ph (wnel D E) $ >
  $ wi ph (wceq (cfv D (cfv G cvtxdg)) cc0) $;

--| The vertex degree of vertex ` D ` in a graph ` G ` with only one hyperedge ` E ` (not being a loop) is 1 if ` D ` is incident with the edge ` E ` . (Contributed by AV, 2-Mar-2021.) (Proof shortened by AV, 17-Apr-2021.)
theorem _1hevtxdg1 (ph: wff) (A2 D E G V X: class):
  $ wi ph (wceq (cfv G ciedg) (csn (cop A2 E))) $ >
  $ wi ph (wceq (cfv G cvtx) V) $ >
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel E (cpw V)) $ >
  $ wi ph (wcel D E) $ >
  $ wi ph (wbr c2 (cfv E chash) cle) $ >
  $ wi ph (wceq (cfv D (cfv G cvtxdg)) c1) $;

--| The vertex degree of a graph with one hyperedge, case 2: an edge from the given vertex to some other vertex contributes one to the vertex's degree. (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by Alexander van der Vekens, 22-Dec-2017.) (Revised by AV, 23-Feb-2021.)
theorem _1hegrvtxdg1 (ph: wff) (A2 B2 C E G V X: class):
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wne B2 C) $ >
  $ wi ph (wcel E (cpw V)) $ >
  $ wi ph (wceq (cfv G ciedg) (csn (cop A2 E))) $ >
  $ wi ph (wss (cpr B2 C) E) $ >
  $ wi ph (wceq (cfv G cvtx) V) $ >
  $ wi ph (wceq (cfv B2 (cfv G cvtxdg)) c1) $;

--| The vertex degree of a graph with one hyperedge, case 3: an edge from some other vertex to the given vertex contributes one to the vertex's degree. (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by Alexander van der Vekens, 22-Dec-2017.) (Revised by AV, 23-Feb-2021.)
theorem _1hegrvtxdg1r (ph: wff) (A2 B2 C E G V X: class):
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wne B2 C) $ >
  $ wi ph (wcel E (cpw V)) $ >
  $ wi ph (wceq (cfv G ciedg) (csn (cop A2 E))) $ >
  $ wi ph (wss (cpr B2 C) E) $ >
  $ wi ph (wceq (cfv G cvtx) V) $ >
  $ wi ph (wceq (cfv C (cfv G cvtxdg)) c1) $;

--| The vertex degree of a one-edge graph, case 2: an edge from the given vertex to some other vertex contributes one to the vertex's degree. (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by Alexander van der Vekens, 22-Dec-2017.) (Revised by AV, 21-Feb-2021.)
theorem _1egrvtxdg1 (ph: wff) (A2 B2 C G V X: class):
  $ wi ph (wceq (cfv G cvtx) V) $ >
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wne B2 C) $ >
  $ wi ph (wceq (cfv G ciedg) (csn (cop A2 (cpr B2 C)))) $ >
  $ wi ph (wceq (cfv B2 (cfv G cvtxdg)) c1) $;

--| The vertex degree of a one-edge graph, case 3: an edge from some other vertex to the given vertex contributes one to the vertex's degree. (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by Alexander van der Vekens, 22-Dec-2017.) (Revised by AV, 21-Feb-2021.)
theorem _1egrvtxdg1r (ph: wff) (A2 B2 C G V X: class):
  $ wi ph (wceq (cfv G cvtx) V) $ >
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wne B2 C) $ >
  $ wi ph (wceq (cfv G ciedg) (csn (cop A2 (cpr B2 C)))) $ >
  $ wi ph (wceq (cfv C (cfv G cvtxdg)) c1) $;

--| The vertex degree of a one-edge graph, case 1: an edge between two vertices other than the given vertex contributes nothing to the vertex degree. (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by Alexander van der Vekens, 22-Dec-2017.) (Revised by AV, 21-Feb-2021.)
theorem _1egrvtxdg0 (ph: wff) (A2 B2 C D G V X: class):
  $ wi ph (wceq (cfv G cvtx) V) $ >
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wne B2 C) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wne C D) $ >
  $ wi ph (wceq (cfv G ciedg) (csn (cop A2 (cpr B2 D)))) $ >
  $ wi ph (wceq (cfv C (cfv G cvtxdg)) cc0) $;

--| Lemma for ~ p1evtxdeq and ~ p1evtxdp1 . (Contributed by AV, 3-Mar-2021.)
theorem p1evtxdeqlem (ph: wff) (U E F G I K V X Y: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wfun I) $ >
  $ wi ph (wceq (cfv F cvtx) V) $ >
  $ wi ph (wceq (cfv F ciedg) (cun I (csn (cop K E)))) $ >
  $ wi ph (wcel K X) $ >
  $ wi ph (wnel K (cdm I)) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wcel E Y) $ >
  $ wi ph (wceq (cfv U (cfv F cvtxdg)) (co (cfv U (cfv G cvtxdg)) (cfv U (cfv (cop V (csn (cop K E))) cvtxdg)) cxad)) $;

--| If an edge ` E ` which does not contain vertex ` U ` is added to a graph ` G ` (yielding a graph ` F ` ), the degree of ` U ` is the same in both graphs. (Contributed by AV, 2-Mar-2021.)
theorem p1evtxdeq (ph: wff) (U E F G I K V X Y: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wfun I) $ >
  $ wi ph (wceq (cfv F cvtx) V) $ >
  $ wi ph (wceq (cfv F ciedg) (cun I (csn (cop K E)))) $ >
  $ wi ph (wcel K X) $ >
  $ wi ph (wnel K (cdm I)) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wcel E Y) $ >
  $ wi ph (wnel U E) $ >
  $ wi ph (wceq (cfv U (cfv F cvtxdg)) (cfv U (cfv G cvtxdg))) $;

--| If an edge ` E ` (not being a loop) which contains vertex ` U ` is added to a graph ` G ` (yielding a graph ` F ` ), the degree of ` U ` is increased by 1. (Contributed by AV, 3-Mar-2021.)
theorem p1evtxdp1 (ph: wff) (U E F G I K V X: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wfun I) $ >
  $ wi ph (wceq (cfv F cvtx) V) $ >
  $ wi ph (wceq (cfv F ciedg) (cun I (csn (cop K E)))) $ >
  $ wi ph (wcel K X) $ >
  $ wi ph (wnel K (cdm I)) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wcel E (cpw V)) $ >
  $ wi ph (wcel U E) $ >
  $ wi ph (wbr c2 (cfv E chash) cle) $ >
  $ wi ph (wceq (cfv U (cfv F cvtxdg)) (co (cfv U (cfv G cvtxdg)) c1 cxad)) $;

--| The set of vertices in a graph (simple pseudograph) with one edge which is a loop (see ~ uspgr1v1eop ). (Contributed by AV, 17-Dec-2020.)
theorem uspgrloopvtx (A2 G N V W: class):
  $ wceq G (cop V (csn (cop A2 (csn N)))) $ >
  $ wi (wcel V W) (wceq (cfv G cvtx) V) $;

--| A vertex in a graph (simple pseudograph) with one edge which is a loop (see ~ uspgr1v1eop ). (Contributed by AV, 17-Dec-2020.)
theorem uspgrloopvtxel (A2 G N V W: class):
  $ wceq G (cop V (csn (cop A2 (csn N)))) $ >
  $ wi (wa (wcel V W) (wcel N V)) (wcel N (cfv G cvtx)) $;

--| The set of edges in a graph (simple pseudograph) with one edge which is a loop (see ~ uspgr1v1eop ) is a singleton of a singleton. (Contributed by AV, 21-Feb-2021.)
theorem uspgrloopiedg (A2 G N V W X: class):
  $ wceq G (cop V (csn (cop A2 (csn N)))) $ >
  $ wi (wa (wcel V W) (wcel A2 X)) (wceq (cfv G ciedg) (csn (cop A2 (csn N)))) $;

--| The set of edges in a graph (simple pseudograph) with one edge which is a loop (see ~ uspgr1v1eop ) is a singleton of a singleton. (Contributed by AV, 17-Dec-2020.)
theorem uspgrloopedg (A2 G N V W X: class):
  $ wceq G (cop V (csn (cop A2 (csn N)))) $ >
  $ wi (wa (wcel V W) (wcel A2 X)) (wceq (cfv G cedg) (csn (csn N))) $;

--| In a graph (simple pseudograph) with one edge which is a loop (see ~ uspgr1v1eop ), the vertex connected with itself by the loop has no neighbors. (Contributed by AV, 17-Dec-2020.) (Proof shortened by AV, 21-Feb-2021.)
theorem uspgrloopnb0 (A2 G N V W X: class):
  $ wceq G (cop V (csn (cop A2 (csn N)))) $ >
  $ wi (w3a (wcel V W) (wcel A2 X) (wcel N V)) (wceq (co G N cnbgr) c0) $;

--| The vertex degree of a one-edge graph, case 4: an edge from a vertex to itself contributes two to the vertex's degree. I. e. in a graph (simple pseudograph) with one edge which is a loop (see ~ uspgr1v1eop ), the vertex connected with itself by the loop has degree 2. (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by Alexander van der Vekens, 22-Dec-2017.) (Revised by AV, 17-Dec-2020.) (Proof shortened by AV, 21-Feb-2021.)
theorem uspgrloopvd2 (A2 G N V W X: class):
  $ wceq G (cop V (csn (cop A2 (csn N)))) $ >
  $ wi (w3a (wcel V W) (wcel A2 X) (wcel N V)) (wceq (cfv N (cfv G cvtxdg)) c2) $;

--| The set of vertices in a multigraph with two edges connecting the same two vertices. (Contributed by AV, 17-Dec-2020.)
theorem umgr2v2evtx (A2 B2 G V W: class):
  $ wceq G (cop V (cpr (cop cc0 (cpr A2 B2)) (cop c1 (cpr A2 B2)))) $ >
  $ wi (wcel V W) (wceq (cfv G cvtx) V) $;

--| A vertex in a multigraph with two edges connecting the same two vertices. (Contributed by AV, 17-Dec-2020.)
theorem umgr2v2evtxel (A2 B2 G V W: class):
  $ wceq G (cop V (cpr (cop cc0 (cpr A2 B2)) (cop c1 (cpr A2 B2)))) $ >
  $ wi (wa (wcel V W) (wcel A2 V)) (wcel A2 (cfv G cvtx)) $;

--| The edge function in a multigraph with two edges connecting the same two vertices. (Contributed by AV, 17-Dec-2020.)
theorem umgr2v2eiedg (A2 B2 G V W: class):
  $ wceq G (cop V (cpr (cop cc0 (cpr A2 B2)) (cop c1 (cpr A2 B2)))) $ >
  $ wi (w3a (wcel V W) (wcel A2 V) (wcel B2 V)) (wceq (cfv G ciedg) (cpr (cop cc0 (cpr A2 B2)) (cop c1 (cpr A2 B2)))) $;

--| The set of edges in a multigraph with two edges connecting the same two vertices. (Contributed by AV, 17-Dec-2020.)
theorem umgr2v2eedg (A2 B2 G V W: class):
  $ wceq G (cop V (cpr (cop cc0 (cpr A2 B2)) (cop c1 (cpr A2 B2)))) $ >
  $ wi (w3a (wcel V W) (wcel A2 V) (wcel B2 V)) (wceq (cfv G cedg) (csn (cpr A2 B2))) $;

--| A multigraph with two edges connecting the same two vertices. (Contributed by AV, 17-Dec-2020.)
theorem umgr2v2e (A2 B2 G V W: class):
  $ wceq G (cop V (cpr (cop cc0 (cpr A2 B2)) (cop c1 (cpr A2 B2)))) $ >
  $ wi (wa (w3a (wcel V W) (wcel A2 V) (wcel B2 V)) (wne A2 B2)) (wcel G cumgr) $;

--| In a multigraph with two edges connecting the same two vertices, each of the vertices has one neighbor. (Contributed by AV, 18-Dec-2020.)
theorem umgr2v2enb1 (A2 B2 G V W: class):
  $ wceq G (cop V (cpr (cop cc0 (cpr A2 B2)) (cop c1 (cpr A2 B2)))) $ >
  $ wi (wa (w3a (wcel V W) (wcel A2 V) (wcel B2 V)) (wne A2 B2)) (wceq (co G A2 cnbgr) (csn B2)) $;

--| In a multigraph with two edges connecting the same two vertices, each of the vertices has degree 2. (Contributed by AV, 18-Dec-2020.)
theorem umgr2v2evd2 (A2 B2 G V W: class):
  $ wceq G (cop V (cpr (cop cc0 (cpr A2 B2)) (cop c1 (cpr A2 B2)))) $ >
  $ wi (wa (w3a (wcel V W) (wcel A2 V) (wcel B2 V)) (wne A2 B2)) (wceq (cfv A2 (cfv G cvtxdg)) c2) $;

--| In a simple graph, the number of neighbors of a vertex is the degree of this vertex. This theorem does not hold for (simple) pseudographs, because a vertex connected with itself only by a loop has no neighbors, see ~ uspgrloopnb0 , but degree 2, see ~ uspgrloopvd2 . And it does not hold for multigraphs, because a vertex connected with only one other vertex by two edges has one neighbor, see ~ umgr2v2enb1 , but also degree 2, see ~ umgr2v2evd2 . (Contributed by Alexander van der Vekens, 17-Dec-2017.) (Revised by AV, 15-Dec-2020.) (Proof shortened by AV, 5-May-2021.)
theorem hashnbusgrvd (U G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel G cusgr) (wcel U V)) (wceq (cfv (co G U cnbgr) chash) (cfv U (cfv G cvtxdg))) $;

--| In a finite simple graph with n vertices a vertex is universal iff the vertex has degree ` n - 1 ` . (Contributed by Alexander van der Vekens, 14-Jul-2018.) (Revised by AV, 17-Dec-2020.)
theorem usgruvtxvdb (U G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel G cfusgr) (wcel U V)) (wb (wcel U (cfv G cuvtx)) (wceq (cfv U (cfv G cvtxdg)) (co (cfv V chash) c1 cmin))) $;

--| A finite simple graph with n vertices is complete iff every vertex has degree ` n - 1 ` . (Contributed by Alexander van der Vekens, 14-Jul-2018.) (Revised by AV, 22-Dec-2020.)
theorem vdiscusgrb {v: setvar} (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel G cfusgr) (wb (wcel G ccusgr) (wral v (wceq (cfv (cv v) (cfv G cvtxdg)) (co (cfv V chash) c1 cmin)) V)) $;

--| In a finite complete simple graph with n vertices every vertex has degree ` n - 1 ` . (Contributed by Alexander van der Vekens, 14-Jul-2018.) (Revised by AV, 17-Dec-2020.)
theorem vdiscusgr {v: setvar} (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel G cfusgr) (wi (wral v (wceq (cfv (cv v) (cfv G cvtxdg)) (co (cfv V chash) c1 cmin)) V) (wcel G ccusgr)) $;

--| The degree of a vertex in a simple graph is the number of vertices adjacent to this vertex. (Contributed by Alexander van der Vekens, 9-Jul-2018.) (Revised by AV, 23-Dec-2020.)
theorem vtxdusgradjvtx {v: setvar} (U E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cusgr) (wcel U V)) (wceq (cfv U (cfv G cvtxdg)) (cfv (crab v (wcel (cpr U (cv v)) E) V) chash)) $;

--| If a vertex in a simple graph has degree 0, the vertex is not adjacent to another vertex via an edge. (Contributed by Alexander van der Vekens, 20-Dec-2017.) (Revised by AV, 16-Dec-2020.) (Proof shortened by AV, 23-Dec-2020.)
theorem usgrvd0nedg {v: setvar} (U E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cusgr) (wcel U V)) (wi (wceq (cfv U (cfv G cvtxdg)) cc0) (wn (wrex v (wcel (cpr U (cv v)) E) V))) $;

--| If every vertex in a hypergraph has degree 0, there is no edge in the graph. (Contributed by Alexander van der Vekens, 12-Jul-2018.) (Revised by AV, 24-Dec-2020.)
theorem uhgrvd00 {v: setvar} (E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wcel G cuhgr) (wi (wral v (wceq (cfv (cv v) (cfv G cvtxdg)) cc0) V) (wceq E c0)) $;

--| If every vertex in a simple graph has degree 0, there is no edge in the graph. (Contributed by Alexander van der Vekens, 12-Jul-2018.) (Revised by AV, 17-Dec-2020.) (Proof shortened by AV, 23-Dec-2020.)
theorem usgrvd00 {v: setvar} (E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wcel G cusgr) (wi (wral v (wceq (cfv (cv v) (cfv G cvtxdg)) cc0) V) (wceq E c0)) $;

--| The induction step for a vertex degree calculation. If the degree of ` U ` in the edge set ` E ` is ` P ` , then adding ` { X , Y } ` to the edge set, where ` X =/= U =/= Y ` , yields degree ` P ` as well. (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by Mario Carneiro, 28-Feb-2016.) (Revised by AV, 3-Mar-2021.)
theorem vdegp1ai {x3: setvar} (P: class x3) (U: class) (F G I: class x3) (V X Y: class):
  $ wceq V (cfv G cvtx) $ >
  $ wcel U V $ >
  $ wceq I (cfv G ciedg) $ >
  $ wcel I (cword (crab x3 (wbr (cfv (cv x3) chash) c2 cle) (cdif (cpw V) (csn c0)))) $ >
  $ wceq (cfv U (cfv G cvtxdg)) P $ >
  $ wceq (cfv F cvtx) V $ >
  $ wcel X V $ >
  $ wne X U $ >
  $ wcel Y V $ >
  $ wne Y U $ >
  $ wceq (cfv F ciedg) (co I (cs1 (cpr X Y)) cconcat) $ >
  $ wceq (cfv U (cfv F cvtxdg)) P $;

--| The induction step for a vertex degree calculation, for example in the K&ouml;nigsberg graph. If the degree of ` U ` in the edge set ` E ` is ` P ` , then adding ` { U , X } ` to the edge set, where ` X =/= U ` , yields degree ` P + 1 ` . (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by Mario Carneiro, 28-Feb-2016.) (Revised by AV, 3-Mar-2021.)
theorem vdegp1bi {x3: setvar} (P: class x3) (U: class) (F G I: class x3) (V X: class):
  $ wceq V (cfv G cvtx) $ >
  $ wcel U V $ >
  $ wceq I (cfv G ciedg) $ >
  $ wcel I (cword (crab x3 (wbr (cfv (cv x3) chash) c2 cle) (cdif (cpw V) (csn c0)))) $ >
  $ wceq (cfv U (cfv G cvtxdg)) P $ >
  $ wceq (cfv F cvtx) V $ >
  $ wcel X V $ >
  $ wne X U $ >
  $ wceq (cfv F ciedg) (co I (cs1 (cpr U X)) cconcat) $ >
  $ wceq (cfv U (cfv F cvtxdg)) (co P c1 caddc) $;

--| The induction step for a vertex degree calculation, for example in the K&ouml;nigsberg graph. If the degree of ` U ` in the edge set ` E ` is ` P ` , then adding ` { X , U } ` to the edge set, where ` X =/= U ` , yields degree ` P + 1 ` . (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by Mario Carneiro, 28-Feb-2016.) (Revised by AV, 3-Mar-2021.)
theorem vdegp1ci {x3: setvar} (P: class x3) (U: class) (F G I: class x3) (V X: class):
  $ wceq V (cfv G cvtx) $ >
  $ wcel U V $ >
  $ wceq I (cfv G ciedg) $ >
  $ wcel I (cword (crab x3 (wbr (cfv (cv x3) chash) c2 cle) (cdif (cpw V) (csn c0)))) $ >
  $ wceq (cfv U (cfv G cvtxdg)) P $ >
  $ wceq (cfv F cvtx) V $ >
  $ wcel X V $ >
  $ wne X U $ >
  $ wceq (cfv F ciedg) (co I (cs1 (cpr X U)) cconcat) $ >
  $ wceq (cfv U (cfv F cvtxdg)) (co P c1 caddc) $;

--| Lemma 1 for ~ vtxdginducedm1 : the edge function in the induced subgraph ` S ` of a pseudograph ` G ` obtained by removing one vertex ` N ` . (Contributed by AV, 16-Dec-2021.)
theorem vtxdginducedm1lem1 {i: setvar} (P S E G I K N V: class i):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq K (cdif V (csn N)) $ >
  $ wceq I (crab i (wnel N (cfv (cv i) E)) (cdm E)) $ >
  $ wceq P (cres E I) $ >
  $ wceq S (cop K P) $ >
  $ wceq (cfv S ciedg) P $;

--| Lemma 2 for ~ vtxdginducedm1 : the domain of the edge function in the induced subgraph ` S ` of a pseudograph ` G ` obtained by removing one vertex ` N ` . (Contributed by AV, 16-Dec-2021.)
theorem vtxdginducedm1lem2 {i: setvar} (P S: class i) (E: class) (G I K N V: class i):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq K (cdif V (csn N)) $ >
  $ wceq I (crab i (wnel N (cfv (cv i) E)) (cdm E)) $ >
  $ wceq P (cres E I) $ >
  $ wceq S (cop K P) $ >
  $ wceq (cdm (cfv S ciedg)) I $;

--| Lemma 3 for ~ vtxdginducedm1 : an edge in the induced subgraph ` S ` of a pseudograph ` G ` obtained by removing one vertex ` N ` . (Contributed by AV, 16-Dec-2021.)
theorem vtxdginducedm1lem3 {i: setvar} (P S: class i) (E: class) (G H I K N V: class i):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq K (cdif V (csn N)) $ >
  $ wceq I (crab i (wnel N (cfv (cv i) E)) (cdm E)) $ >
  $ wceq P (cres E I) $ >
  $ wceq S (cop K P) $ >
  $ wi (wcel H I) (wceq (cfv H (cfv S ciedg)) (cfv H E)) $;

--| Lemma 4 for ~ vtxdginducedm1 . (Contributed by AV, 17-Dec-2021.)
theorem vtxdginducedm1lem4 {i k: setvar} (P S: class i k) (E: class k) (G I: class i k) (J: class i) (K: class i k) (N: class) (V W: class i):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq K (cdif V (csn N)) $ >
  $ wceq I (crab i (wnel N (cfv (cv i) E)) (cdm E)) $ >
  $ wceq P (cres E I) $ >
  $ wceq S (cop K P) $ >
  $ wceq J (crab i (wcel N (cfv (cv i) E)) (cdm E)) $ >
  $ wi (wcel W (cdif V (csn N))) (wceq (cfv (crab k (wceq (cfv (cv k) E) (csn W)) J) chash) cc0) $;

--| The degree of a vertex ` v ` in the induced subgraph ` S ` of a pseudograph ` G ` obtained by removing one vertex ` N ` plus the number of edges joining the vertex ` v ` and the vertex ` N ` is the degree of the vertex ` v ` in the pseudograph ` G ` . (Contributed by AV, 17-Dec-2021.)
theorem vtxdginducedm1 {v i l: setvar} (P S: class v i l) (E: class v) (G I: class v i l) (J: class v i) (K: class v i l) (N: class v l) (V: class v i l):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq K (cdif V (csn N)) $ >
  $ wceq I (crab i (wnel N (cfv (cv i) E)) (cdm E)) $ >
  $ wceq P (cres E I) $ >
  $ wceq S (cop K P) $ >
  $ wceq J (crab i (wcel N (cfv (cv i) E)) (cdm E)) $ >
  $ wral v (wceq (cfv (cv v) (cfv G cvtxdg)) (co (cfv (cv v) (cfv S cvtxdg)) (cfv (crab l (wcel (cv v) (cfv (cv l) E)) J) chash) cxad)) (cdif V (csn N)) $;

--| The degree of a vertex ` v ` in the induced subgraph ` S ` of a pseudograph ` G ` obtained by removing one vertex ` N ` plus the number of edges joining the vertex ` v ` and the vertex ` N ` is the degree of the vertex ` v ` in the pseudograph ` G ` . (Contributed by AV, 17-Dec-2021.)
theorem vtxdginducedm1_b {v i: setvar} (P S: class v i) (E: class v) (G I: class v i) (J: class v) (K: class v i) (N: class v) (V: class v i):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq K (cdif V (csn N)) $ >
  $ wceq I (crab i (wnel N (cfv (cv i) E)) (cdm E)) $ >
  $ wceq P (cres E I) $ >
  $ wceq S (cop K P) $ >
  $ wceq J (crab i (wcel N (cfv (cv i) E)) (cdm E)) $ >
  $ wral v (wceq (cfv (cv v) (cfv G cvtxdg)) (co (cfv (cv v) (cfv S cvtxdg)) (cfv (crab i (wcel (cv v) (cfv (cv i) E)) J) chash) cxad)) (cdif V (csn N)) $;

--| The degree of a vertex ` v ` in the induced subgraph ` S ` of a pseudograph ` G ` of finite size obtained by removing one vertex ` N ` plus the number of edges joining the vertex ` v ` and the vertex ` N ` is the degree of the vertex ` v ` in the pseudograph ` G ` . (Contributed by AV, 18-Dec-2021.)
theorem vtxdginducedm1fi {v i l: setvar} (P S: class v i l) (E: class) (G I: class v i l) (J: class v i) (K: class v i l) (N: class v l) (V: class v i l):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq K (cdif V (csn N)) $ >
  $ wceq I (crab i (wnel N (cfv (cv i) E)) (cdm E)) $ >
  $ wceq P (cres E I) $ >
  $ wceq S (cop K P) $ >
  $ wceq J (crab i (wcel N (cfv (cv i) E)) (cdm E)) $ >
  $ wi (wcel E cfn) (wral v (wceq (cfv (cv v) (cfv G cvtxdg)) (co (cfv (cv v) (cfv S cvtxdg)) (cfv (crab l (wcel (cv v) (cfv (cv l) E)) J) chash) caddc)) (cdif V (csn N))) $;

--| The degree of a vertex ` v ` in the induced subgraph ` S ` of a pseudograph ` G ` of finite size obtained by removing one vertex ` N ` plus the number of edges joining the vertex ` v ` and the vertex ` N ` is the degree of the vertex ` v ` in the pseudograph ` G ` . (Contributed by AV, 18-Dec-2021.)
theorem vtxdginducedm1fi_b {v i: setvar} (P S: class v i) (E: class) (G I: class v i) (J: class v) (K: class v i) (N: class v) (V: class v i):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq K (cdif V (csn N)) $ >
  $ wceq I (crab i (wnel N (cfv (cv i) E)) (cdm E)) $ >
  $ wceq P (cres E I) $ >
  $ wceq S (cop K P) $ >
  $ wceq J (crab i (wcel N (cfv (cv i) E)) (cdm E)) $ >
  $ wi (wcel E cfn) (wral v (wceq (cfv (cv v) (cfv G cvtxdg)) (co (cfv (cv v) (cfv S cvtxdg)) (cfv (crab i (wcel (cv v) (cfv (cv i) E)) J) chash) caddc)) (cdif V (csn N))) $;

--| Lemma for ~ finsumvtxdg2sstep . (Contributed by AV, 15-Dec-2021.)
theorem finsumvtxdg2ssteplem1 {i: setvar} (P S: class i) (E G: class) (I J K: class i) (N: class) (V: class i):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq K (cdif V (csn N)) $ >
  $ wceq I (crab i (wnel N (cfv (cv i) E)) (cdm E)) $ >
  $ wceq P (cres E I) $ >
  $ wceq S (cop K P) $ >
  $ wceq J (crab i (wcel N (cfv (cv i) E)) (cdm E)) $ >
  $ wi (wa (wa (wcel G cupgr) (wcel N V)) (wa (wcel V cfn) (wcel E cfn))) (wceq (cfv E chash) (co (cfv P chash) (cfv J chash) caddc)) $;

--| Lemma for ~ finsumvtxdg2sstep . (Contributed by AV, 12-Dec-2021.)
theorem finsumvtxdg2ssteplem2 {i: setvar} (P S: class i) (E G: class) (I J K: class i) (N: class) (V: class i):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq K (cdif V (csn N)) $ >
  $ wceq I (crab i (wnel N (cfv (cv i) E)) (cdm E)) $ >
  $ wceq P (cres E I) $ >
  $ wceq S (cop K P) $ >
  $ wceq J (crab i (wcel N (cfv (cv i) E)) (cdm E)) $ >
  $ wi (wa (wa (wcel G cupgr) (wcel N V)) (wa (wcel V cfn) (wcel E cfn))) (wceq (cfv N (cfv G cvtxdg)) (co (cfv J chash) (cfv (crab i (wceq (cfv (cv i) E) (csn N)) (cdm E)) chash) caddc)) $;

--| Lemma for ~ finsumvtxdg2sstep . (Contributed by AV, 19-Dec-2021.)
theorem finsumvtxdg2ssteplem3 {v i: setvar} (P S: class v i) (E G: class) (I J K: class v i) (N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq K (cdif V (csn N)) $ >
  $ wceq I (crab i (wnel N (cfv (cv i) E)) (cdm E)) $ >
  $ wceq P (cres E I) $ >
  $ wceq S (cop K P) $ >
  $ wceq J (crab i (wcel N (cfv (cv i) E)) (cdm E)) $ >
  $ wi (wa (wa (wcel G cupgr) (wcel N V)) (wa (wcel V cfn) (wcel E cfn))) (wceq (co (csu v (cdif V (csn N)) (cfv (crab i (wcel (cv v) (cfv (cv i) E)) J) chash)) (cfv (crab i (wceq (cfv (cv i) E) (csn N)) (cdm E)) chash) caddc) (cfv J chash)) $;

--| Lemma for ~ finsumvtxdg2sstep . (Contributed by AV, 12-Dec-2021.)
theorem finsumvtxdg2ssteplem4 {v i: setvar} (P S: class v i) (E G: class) (I: class v i) (J: class v) (K: class i) (N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq K (cdif V (csn N)) $ >
  $ wceq I (crab i (wnel N (cfv (cv i) E)) (cdm E)) $ >
  $ wceq P (cres E I) $ >
  $ wceq S (cop K P) $ >
  $ wceq J (crab i (wcel N (cfv (cv i) E)) (cdm E)) $ >
  $ wi (wa (wa (wa (wcel G cupgr) (wcel N V)) (wa (wcel V cfn) (wcel E cfn))) (wceq (csu v K (cfv (cv v) (cfv S cvtxdg))) (co c2 (cfv P chash) cmul))) (wceq (co (csu v (cdif V (csn N)) (cfv (cv v) (cfv G cvtxdg))) (co (cfv J chash) (cfv (crab i (wceq (cfv (cv i) E) (csn N)) (cdm E)) chash) caddc) caddc) (co c2 (co (cfv P chash) (cfv J chash) caddc) cmul)) $;

--| Induction step of ~ finsumvtxdg2size : In a finite pseudograph of finite size, the sum of the degrees of all vertices of the pseudograph is twice the size of the pseudograph if the sum of the degrees of all vertices of the subgraph of the pseudograph not containing one of the vertices is twice the size of the subgraph. (Contributed by AV, 19-Dec-2021.)
theorem finsumvtxdg2sstep {v i: setvar} (P S: class v i) (E G: class) (I: class v i) (K: class i) (N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wceq K (cdif V (csn N)) $ >
  $ wceq I (crab i (wnel N (cfv (cv i) E)) (cdm E)) $ >
  $ wceq P (cres E I) $ >
  $ wceq S (cop K P) $ >
  $ wi (wa (wa (wcel G cupgr) (wcel N V)) (wa (wcel V cfn) (wcel E cfn))) (wi (wi (wcel P cfn) (wceq (csu v K (cfv (cv v) (cfv S cvtxdg))) (co c2 (cfv P chash) cmul))) (wceq (csu v V (cfv (cv v) (cfv G cvtxdg))) (co c2 (cfv E chash) cmul))) $;

--| The sum of the degrees of all vertices of a finite pseudograph of finite size is twice the size of the pseudograph. See equation (1) in section I.1 in [Bollobas] p. 4. Here, the "proof" is simply the statement "Since each edge has two endvertices, the sum of the degrees is exactly twice the number of edges". The formal proof of this theorem (for pseudographs) is much more complicated, taking also the used auxiliary theorems into account. The proof for a (finite) simple graph (see ~ fusgr1th ) would be shorter, but nevertheless still laborious. Although this theorem would hold also for infinite pseudographs and pseudographs of infinite size, the proof of this most general version (see theorem "sumvtxdg2size" below) would require many more auxiliary theorems (e.g., the extension of the sum ` sum_ ` over an arbitrary set). I dedicate this theorem and its proof to Norman Megill, who deceased too early on December 9, 2021. This proof is an example for the rigor which was the main motivation for Norman Megill to invent and develop Metamath, see section 1.1.6 "Rigor" on page 19 of the Metamath book: "... it is usually assumed in mathematical literature that the person reading the proof is a mathematician familiar with the specialty being described, and that the missing steps are obvious to such a reader or at least the reader is capable of filling them in." I filled in the missing steps of Bollobas' proof as Norm would have liked it... (Contributed by Alexander van der Vekens, 19-Dec-2021.)
theorem finsumvtxdg2size {v: setvar} (D: class v) (G: class) (I: class v) (V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq D (cfv G cvtxdg) $ >
  $ wi (w3a (wcel G cupgr) (wcel V cfn) (wcel I cfn)) (wceq (csu v V (cfv (cv v) D)) (co c2 (cfv I chash) cmul)) $;

--| The sum of the degrees of all vertices of a finite simple graph is twice the size of the graph. See equation (1) in section I.1 in [Bollobas] p. 4. Also known as the "First Theorem of Graph Theory" (see ~ https://charlesreid1.com/wiki/First_Theorem_of_Graph_Theory ). (Contributed by AV, 26-Dec-2021.)
theorem fusgr1th {v: setvar} (D: class v) (G: class) (I: class v) (V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq D (cfv G cvtxdg) $ >
  $ wi (wcel G cfusgr) (wceq (csu v V (cfv (cv v) D)) (co c2 (cfv I chash) cmul)) $;

--| The sum of the degrees of all vertices of a finite pseudograph of finite size is even. See equation (2) in section I.1 in [Bollobas] p. 4, where it is also called the _handshaking lemma_. (Contributed by AV, 22-Dec-2021.)
theorem finsumvtxdgeven {v: setvar} (D: class v) (G: class) (I: class v) (V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq D (cfv G cvtxdg) $ >
  $ wi (w3a (wcel G cupgr) (wcel V cfn) (wcel I cfn)) (wbr c2 (csu v V (cfv (cv v) D)) cdvds) $;

--| The number of vertices of odd degree is even in a finite pseudograph of finite size. Proposition 1.2.1 in [Diestel] p. 5. See also remark about equation (2) in section I.1 in [Bollobas] p. 4. (Contributed by AV, 22-Dec-2021.)
theorem vtxdgoddnumeven {v: setvar} (D G I V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq D (cfv G cvtxdg) $ >
  $ wi (w3a (wcel G cupgr) (wcel V cfn) (wcel I cfn)) (wbr c2 (cfv (crab v (wn (wbr c2 (cfv (cv v) D) cdvds)) V) chash) cdvds) $;

--| The number of vertices of odd degree is even in a finite simple graph. Proposition 1.2.1 in [Diestel] p. 5. See also remark about equation (2) in section I.1 in [Bollobas] p. 4. (Contributed by AV, 27-Dec-2021.)
theorem fusgrvtxdgonume {v: setvar} (D G I V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq D (cfv G cvtxdg) $ >
  $ wi (wcel G cfusgr) (wbr c2 (cfv (crab v (wn (wbr c2 (cfv (cv v) D) cdvds)) V) chash) cdvds) $;

--| Extend class notation to include the class of all regular graphs.
term crgr: class;

--| Extend class notation to include the class of all regular simple graphs.
term crusgr: class;

--| Define the "k-regular" predicate, which is true for a "graph" being k-regular: read ` G RegGraph K ` as " ` G ` is ` K `-regular" or " ` G ` is a ` K `-regular graph". Note that ` K ` is allowed to be positive infinity ( ` K e. NN0* ` ), as proposed by GL. (Contributed by Alexander van der Vekens, 6-Jul-2018.) (Revised by AV, 26-Dec-2020.)
axiom df_rgr {v g2 k: setvar}:
  $ wceq crgr (copab g2 k (wa (wcel (cv k) cxnn0) (wral v (wceq (cfv (cv v) (cfv (cv g2) cvtxdg)) (cv k)) (cfv (cv g2) cvtx)))) $;

--| Define the "k-regular simple graph" predicate, which is true for a simple graph being k-regular: read ` G RegUSGraph K ` as ` G ` is a ` K `-regular simple graph. (Contributed by Alexander van der Vekens, 6-Jul-2018.) (Revised by AV, 18-Dec-2020.)
axiom df_rusgr {g2 k: setvar}:
  $ wceq crusgr (copab g2 k (wa (wcel (cv g2) cusgr) (wbr (cv g2) (cv k) crgr))) $;

--| The property of a class being a k-regular graph. (Contributed by Alexander van der Vekens, 7-Jul-2018.) (Revised by AV, 26-Dec-2020.)
theorem isrgr {v: setvar} (D: class v) (G K: class) (V W Z: class v):
  $ wceq V (cfv G cvtx) $ >
  $ wceq D (cfv G cvtxdg) $ >
  $ wi (wa (wcel G W) (wcel K Z)) (wb (wbr G K crgr) (wa (wcel K cxnn0) (wral v (wceq (cfv (cv v) D) K) V))) $;

--| The properties of a k-regular graph. (Contributed by Alexander van der Vekens, 8-Jul-2018.) (Revised by AV, 26-Dec-2020.)
theorem rgrprop {v: setvar} (D: class v) (G K: class) (V: class v):
  $ wceq V (cfv G cvtx) $ >
  $ wceq D (cfv G cvtxdg) $ >
  $ wi (wbr G K crgr) (wa (wcel K cxnn0) (wral v (wceq (cfv (cv v) D) K) V)) $;

--| The property of being a k-regular simple graph. (Contributed by Alexander van der Vekens, 7-Jul-2018.) (Revised by AV, 18-Dec-2020.)
theorem isrusgr (G K W Z: class):
  $ wi (wa (wcel G W) (wcel K Z)) (wb (wbr G K crusgr) (wa (wcel G cusgr) (wbr G K crgr))) $;

--| The properties of a k-regular simple graph. (Contributed by Alexander van der Vekens, 8-Jul-2018.) (Revised by AV, 18-Dec-2020.)
theorem rusgrprop (G K: class):
  $ wi (wbr G K crusgr) (wa (wcel G cusgr) (wbr G K crgr)) $;

--| A k-regular simple graph is a k-regular graph. (Contributed by Alexander van der Vekens, 8-Jul-2018.) (Revised by AV, 18-Dec-2020.)
theorem rusgrrgr (G K: class):
  $ wi (wbr G K crusgr) (wbr G K crgr) $;

--| A k-regular simple graph is a simple graph. (Contributed by Alexander van der Vekens, 8-Jul-2018.) (Revised by AV, 18-Dec-2020.)
theorem rusgrusgr (G K: class):
  $ wi (wbr G K crusgr) (wcel G cusgr) $;

--| A finite regular simple graph is a finite simple graph. (Contributed by AV, 3-Jun-2021.)
theorem finrusgrfusgr (G K V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wbr G K crusgr) (wcel V cfn)) (wcel G cfusgr) $;

--| The property of being a k-regular simple graph. (Contributed by Alexander van der Vekens, 7-Jul-2018.) (Revised by AV, 26-Dec-2020.)
theorem isrusgr0 {v: setvar} (D: class v) (G K: class) (V W Z: class v):
  $ wceq V (cfv G cvtx) $ >
  $ wceq D (cfv G cvtxdg) $ >
  $ wi (wa (wcel G W) (wcel K Z)) (wb (wbr G K crusgr) (w3a (wcel G cusgr) (wcel K cxnn0) (wral v (wceq (cfv (cv v) D) K) V))) $;

--| The properties of a k-regular simple graph. (Contributed by Alexander van der Vekens, 8-Jul-2018.) (Revised by AV, 26-Dec-2020.)
theorem rusgrprop0 {v: setvar} (D: class v) (G K: class) (V: class v):
  $ wceq V (cfv G cvtx) $ >
  $ wceq D (cfv G cvtxdg) $ >
  $ wi (wbr G K crusgr) (w3a (wcel G cusgr) (wcel K cxnn0) (wral v (wceq (cfv (cv v) D) K) V)) $;

--| If all vertices in a simple graph have the same degree, the graph is k-regular. (Contributed by AV, 26-Dec-2020.)
theorem usgreqdrusgr {v: setvar} (D: class v) (G K: class) (V: class v):
  $ wceq V (cfv G cvtx) $ >
  $ wceq D (cfv G cvtxdg) $ >
  $ wi (w3a (wcel G cusgr) (wcel K cxnn0) (wral v (wceq (cfv (cv v) D) K) V)) (wbr G K crusgr) $;

--| In a nonempty finite simple graph, the degree of each vertex is finite. (Contributed by Alexander van der Vekens, 6-Mar-2018.) (Revised by AV, 19-Dec-2020.)
theorem fusgrregdegfi {v: setvar} (D: class v) (G K V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq D (cfv G cvtxdg) $ >
  $ wi (wa (wcel G cfusgr) (wne V c0)) (wi (wral v (wceq (cfv (cv v) D) K) V) (wcel K cn0)) $;

--| If all vertices in a nonempty finite simple graph have the same (finite) degree, the graph is k-regular. (Contributed by AV, 26-Dec-2020.)
theorem fusgrn0eqdrusgr {v: setvar} (D: class v) (G K V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq D (cfv G cvtxdg) $ >
  $ wi (wa (wcel G cfusgr) (wne V c0)) (wi (wral v (wceq (cfv (cv v) D) K) V) (wbr G K crusgr)) $;

--| In a nonempty finite k-regular simple graph, the degree of each vertex is finite. (Contributed by AV, 7-May-2021.)
theorem frusgrnn0 (G K V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (w3a (wcel G cfusgr) (wbr G K crusgr) (wne V c0)) (wcel K cn0) $;

--| A graph is 0-regular if it has no edges. (Contributed by Alexander van der Vekens, 8-Jul-2018.) (Revised by AV, 26-Dec-2020.)
theorem _0edg0rgr (G W: class):
  $ wi (wa (wcel G W) (wceq (cfv G ciedg) c0)) (wbr G cc0 crgr) $;

--| A hypergraph is 0-regular if it has no edges. (Contributed by AV, 19-Dec-2020.)
theorem uhgr0edg0rgr (G: class):
  $ wi (wa (wcel G cuhgr) (wceq (cfv G cedg) c0)) (wbr G cc0 crgr) $;

--| A hypergraph is 0-regular iff it has no edges. (Contributed by Alexander van der Vekens, 12-Jul-2018.) (Revised by AV, 24-Dec-2020.)
theorem uhgr0edg0rgrb (G: class):
  $ wi (wcel G cuhgr) (wb (wbr G cc0 crgr) (wceq (cfv G cedg) c0)) $;

--| A simple graph is 0-regular iff it has no edges. (Contributed by Alexander van der Vekens, 12-Jul-2018.) (Revised by AV, 19-Dec-2020.) (Proof shortened by AV, 24-Dec-2020.)
theorem usgr0edg0rusgr (G: class):
  $ wi (wcel G cusgr) (wb (wbr G cc0 crusgr) (wceq (cfv G cedg) c0)) $;

--| A null graph (with no vertices) is k-regular for every k. (Contributed by Alexander van der Vekens, 10-Jul-2018.) (Revised by AV, 26-Dec-2020.)
theorem _0vtxrgr {k: setvar} (G W: class):
  $ wi (wa (wcel G W) (wceq (cfv G cvtx) c0)) (wral k (wbr G (cv k) crgr) cxnn0) $;

--| A graph with no vertices and an empty edge function is a k-regular simple graph for every k. (Contributed by Alexander van der Vekens, 10-Jul-2018.) (Revised by AV, 26-Dec-2020.)
theorem _0vtxrusgr {k: setvar} (G W: class):
  $ wi (w3a (wcel G W) (wceq (cfv G cvtx) c0) (wceq (cfv G ciedg) c0)) (wral k (wbr G (cv k) crusgr) cxnn0) $;

--| The null graph as hypergraph is a k-regular simple graph for every k. (Contributed by Alexander van der Vekens, 10-Jul-2018.) (Revised by AV, 26-Dec-2020.)
theorem _0uhgrrusgr {k: setvar} (G: class):
  $ wi (wa (wcel G cuhgr) (wceq (cfv G cvtx) c0)) (wral k (wbr G (cv k) crusgr) cxnn0) $;

--| The null graph represented by an empty set is a k-regular simple graph for every k. (Contributed by AV, 26-Dec-2020.)
theorem _0grrusgr {k: setvar}:
  $ wral k (wbr c0 (cv k) crusgr) cxnn0 $;

--| The null graph represented by an empty set is k-regular for every k. (Contributed by AV, 26-Dec-2020.)
theorem _0grrgr {k: setvar}:
  $ wral k (wbr c0 (cv k) crgr) cxnn0 $;

--| A complete simple graph with n vertices (at least one) is (n-1)-regular. (Contributed by Alexander van der Vekens, 10-Jul-2018.) (Revised by AV, 26-Dec-2020.)
theorem cusgrrusgr (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (w3a (wcel G ccusgr) (wcel V cfn) (wne V c0)) (wbr G (co (cfv V chash) c1 cmin) crusgr) $;

--| A finite simple graph with n vertices is complete iff it is (n-1)-regular. Hint: If the definition of ` RegGraph ` was allowed for ` k e. ZZ ` , then the assumption ` V =/= (/) ` could be removed. (Contributed by Alexander van der Vekens, 14-Jul-2018.) (Revised by AV, 26-Dec-2020.)
theorem cusgrm1rusgr (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel G cfusgr) (wne V c0)) (wb (wcel G ccusgr) (wbr G (co (cfv V chash) c1 cmin) crusgr)) $;

--| The properties of a k-regular simple graph expressed with neighbors. (Contributed by Alexander van der Vekens, 26-Jul-2018.) (Revised by AV, 26-Dec-2020.)
theorem rusgrpropnb {v: setvar} (G K: class) (V: class v):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wbr G K crusgr) (w3a (wcel G cusgr) (wcel K cxnn0) (wral v (wceq (cfv (co G (cv v) cnbgr) chash) K) V)) $;

--| The properties of a k-regular simple graph expressed with edges. (Contributed by AV, 23-Dec-2020.) (Revised by AV, 27-Dec-2020.)
theorem rusgrpropedg {v e: setvar} (G: class) (K: class e) (V: class v e):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wbr G K crusgr) (w3a (wcel G cusgr) (wcel K cxnn0) (wral v (wceq (cfv (crab e (wcel (cv v) (cv e)) (cfv G cedg)) chash) K) V)) $;

--| The properties of a k-regular simple graph expressed with adjacent vertices. (Contributed by Alexander van der Vekens, 26-Jul-2018.) (Revised by AV, 27-Dec-2020.)
theorem rusgrpropadjvtx {v k: setvar} (G: class) (K: class k) (V: class v):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wbr G K crusgr) (w3a (wcel G cusgr) (wcel K cxnn0) (wral v (wceq (cfv (crab k (wcel (cpr (cv v) (cv k)) (cfv G cedg)) V) chash) K) V)) $;

--| In a k-regular simple graph, the number of edges resp. walks of length 1 (represented as words of length 2) starting at a fixed vertex is k. (Contributed by Alexander van der Vekens, 28-Jul-2018.) (Revised by AV, 6-May-2021.)
theorem rusgrnumwrdl2 {w: setvar} (P G: class) (K: class w) (V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wbr G K crusgr) (wcel P V)) (wceq (cfv (crab w (w3a (wceq (cfv (cv w) chash) c2) (wceq (cfv cc0 (cv w)) P) (wcel (cpr (cfv cc0 (cv w)) (cfv c1 (cv w))) (cfv G cedg))) (cword V)) chash) K) $;

--| Lemma for ~ rusgr1vtx . (Contributed by AV, 27-Dec-2020.)
theorem rusgr1vtxlem {v: setvar} (A2: class v) (K V: class) (W: class v):
  $ wi (wa (wa (wral v (wceq (cfv A2 chash) K) V) (wral v (wceq A2 c0) V)) (wa (wcel V W) (wceq (cfv V chash) c1))) (wceq K cc0) $;

--| If a k-regular simple graph has only one vertex, then k must be ` 0 ` . (Contributed by Alexander van der Vekens, 4-Sep-2018.) (Revised by AV, 27-Dec-2020.)
theorem rusgr1vtx (G K: class):
  $ wi (wa (wceq (cfv (cfv G cvtx) chash) c1) (wbr G K crusgr)) (wceq K cc0) $;

--| The class of 0-regular simple graphs is a proper class. (Contributed by AV, 27-Dec-2020.)
theorem rgrusgrprc {v g2: setvar}:
  $ wnel (crab g2 (wral v (wceq (cfv (cv v) (cfv (cv g2) cvtxdg)) cc0) (cfv (cv g2) cvtx)) cusgr) cvv $;

--| The class of 0-regular simple graphs is a proper class. (Contributed by AV, 27-Dec-2020.)
theorem rusgrprc {g2: setvar}:
  $ wnel (cab g2 (wbr (cv g2) cc0 crusgr)) cvv $;

--| The class of 0-regular graphs is a proper class. (Contributed by AV, 27-Dec-2020.)
theorem rgrprc {g2: setvar}:
  $ wnel (cab g2 (wbr (cv g2) cc0 crgr)) cvv $;

--| The class of 0-regular graphs is a proper class. (Contributed by AV, 27-Dec-2020.)
theorem rgrprcx {v g2: setvar}:
  $ wnel (cab g2 (wral v (wceq (cfv (cv v) (cfv (cv g2) cvtxdg)) cc0) (cfv (cv g2) cvtx))) cvv $;

--| 0 is not in the domain of the potentially alternative definition of the sets of k-regular graphs for each extended nonnegative integer k. (Contributed by AV, 28-Dec-2020.)
theorem rgrx0ndm {v g2 k: setvar} (R: class v g2 k):
  $ wceq R (cmpt k cxnn0 (cab g2 (wral v (wceq (cfv (cv v) (cfv (cv g2) cvtxdg)) (cv k)) (cfv (cv g2) cvtx)))) $ >
  $ wnel cc0 (cdm R) $;

--| The potentially alternatively defined k-regular graphs is not defined for k=0. (Contributed by AV, 28-Dec-2020.)
theorem rgrx0nd {v g2 k: setvar} (R: class v g2 k):
  $ wceq R (cmpt k cxnn0 (cab g2 (wral v (wceq (cfv (cv v) (cfv (cv g2) cvtxdg)) (cv k)) (cfv (cv g2) cvtx)))) $ >
  $ wceq (cfv cc0 R) c0 $;

--| Extend class notation with s-walks "on the edge level" (of a hypergraph).
term cewlks: class;

--| Extend class notation with walks (i.e. 1-walks) (of a hypergraph).
term cwlks: class;

--| Extend class notation with walks between two vertices (within a graph).
term cwlkson: class;

--| Define the set of all s-walks of edges (in a hypergraph) corresponding to s-walks "on the edge level" discussed in Aksoy et al. For an extended nonnegative integer s, an s-walk is a sequence of hyperedges, e(0), e(1), ... , e(k), where e(j-1) and e(j) have at least s vertices in common (for j=1, ... , k). In contrast to the definition in Aksoy et al., ` s = 0 ` (a 0-walk is an arbitrary sequence of hyperedges) and ` s = +oo ` (then the number of common vertices of two adjacent hyperedges must be infinite) are allowed. Furthermore, it is not forbidden that adjacent hyperedges are equal. (Contributed by AV, 4-Jan-2021.)
axiom df_ewlks {f2 g2 i k s1: setvar}:
  $ wceq cewlks (cmpo g2 s1 cvv cxnn0 (cab f2 (wsbc i (wa (wcel (cv f2) (cword (cdm (cv i)))) (wral k (wbr (cv s1) (cfv (cin (cfv (cfv (co (cv k) c1 cmin) (cv f2)) (cv i)) (cfv (cfv (cv k) (cv f2)) (cv i))) chash) cle) (co c1 (cfv (cv f2) chash) cfzo))) (cfv (cv g2) ciedg)))) $;

--| Define the set of all walks (in a hypergraph). Such walks correspond to the s-walks "on the vertex level" (with s = 1), and also to 1-walks "on the edge level" (see ~ wlk1walk ) discussed in Aksoy et al. The predicate ` F ( Walks `` G ) P ` can be read as "The pair ` <. F , P >. ` represents a walk in a graph ` G ` ", see also ~ iswlk . The condition ` { ( p `` k ) , ( p `` ( k + 1 ) ) } ` ` C_ ( ( iEdg `` g ) `` ( f `` k ) ) ` (hereinafter referred to as C) would not be sufficient, because the repetition of a vertex in a walk (i.e. ` ( p `` k ) = ( p `` ( k + 1 ) ) ` should be allowed only if there is a loop at ` ( p `` k ) ` . Otherwise, C would be fulfilled by each edge containing ` ( p `` k ) ` . According to the definition of [Bollobas] p. 4.: "A walk W in a graph is an alternating sequence of vertices and edges x0 , e1 , x1 , e2 , ... , e(l) , x(l) ...", a walk can be represented by two mappings f from { 1 , ... , n } and p from { 0 , ... , n }, where f enumerates the (indices of the) edges, and p enumerates the vertices. So the walk is represented by the following sequence: p(0) e(f(1)) p(1) e(f(2)) ... p(n-1) e(f(n)) p(n). (Contributed by AV, 30-Dec-2020.)
axiom df_wlks {f2 g2 k p: setvar}:
  $ wceq cwlks (cmpt g2 cvv (copab f2 p (w3a (wcel (cv f2) (cword (cdm (cfv (cv g2) ciedg)))) (wf (co cc0 (cfv (cv f2) chash) cfz) (cfv (cv g2) cvtx) (cv p)) (wral k (wif (wceq (cfv (cv k) (cv p)) (cfv (co (cv k) c1 caddc) (cv p))) (wceq (cfv (cfv (cv k) (cv f2)) (cfv (cv g2) ciedg)) (csn (cfv (cv k) (cv p)))) (wss (cpr (cfv (cv k) (cv p)) (cfv (co (cv k) c1 caddc) (cv p))) (cfv (cfv (cv k) (cv f2)) (cfv (cv g2) ciedg)))) (co cc0 (cfv (cv f2) chash) cfzo))))) $;

--| Define the collection of walks with particular endpoints (in a hypergraph). The predicate ` F ( A ( WalksOn `` G ) B ) P ` can be read as "The pair ` <. F , P >. ` represents a walk from vertex ` A ` to vertex ` B ` in a graph ` G ` ", see also ~ iswlkon . This corresponds to the "x0-x(l)-walks", see Definition in [Bollobas] p. 5. (Contributed by Alexander van der Vekens and Mario Carneiro, 4-Oct-2017.) (Revised by AV, 28-Dec-2020.)
axiom df_wlkson {f2 g2 p a b: setvar}:
  $ wceq cwlkson (cmpt g2 cvv (cmpo a b (cfv (cv g2) cvtx) (cfv (cv g2) cvtx) (copab f2 p (w3a (wbr (cv f2) (cv p) (cfv (cv g2) cwlks)) (wceq (cfv cc0 (cv p)) (cv a)) (wceq (cfv (cfv (cv f2) chash) (cv p)) (cv b)))))) $;

--| The set of s-walks of edges (in a hypergraph). (Contributed by AV, 4-Jan-2021.)
theorem ewlksfval {f2 k: setvar} (S G: class) (I: class f2 k) (W: class):
  $ wceq I (cfv G ciedg) $ >
  $ wi (wa (wcel G W) (wcel S cxnn0)) (wceq (co G S cewlks) (cab f2 (wa (wcel (cv f2) (cword (cdm I))) (wral k (wbr S (cfv (cin (cfv (cfv (co (cv k) c1 cmin) (cv f2)) I) (cfv (cfv (cv k) (cv f2)) I)) chash) cle) (co c1 (cfv (cv f2) chash) cfzo))))) $;

--| Conditions for a function (sequence of hyperedges) to be an s-walk of edges. (Contributed by AV, 4-Jan-2021.)
theorem isewlk {k: setvar} (S: class) (U: class k) (F G: class) (I: class k) (W: class):
  $ wceq I (cfv G ciedg) $ >
  $ wi (w3a (wcel G W) (wcel S cxnn0) (wcel F U)) (wb (wcel F (co G S cewlks)) (wa (wcel F (cword (cdm I))) (wral k (wbr S (cfv (cin (cfv (cfv (co (cv k) c1 cmin) F) I) (cfv (cfv (cv k) F) I)) chash) cle) (co c1 (cfv F chash) cfzo)))) $;

--| Properties of an s-walk of edges. (Contributed by AV, 4-Jan-2021.)
theorem ewlkprop {k: setvar} (S F G: class) (I: class k):
  $ wceq I (cfv G ciedg) $ >
  $ wi (wcel F (co G S cewlks)) (w3a (wa (wcel G cvv) (wcel S cxnn0)) (wcel F (cword (cdm I))) (wral k (wbr S (cfv (cin (cfv (cfv (co (cv k) c1 cmin) F) I) (cfv (cfv (cv k) F) I)) chash) cle) (co c1 (cfv F chash) cfzo))) $;

--| The intersection (common vertices) of two adjacent edges in an s-walk of edges. (Contributed by AV, 4-Jan-2021.)
theorem ewlkinedg (S F G I K: class):
  $ wceq I (cfv G ciedg) $ >
  $ wi (wa (wcel F (co G S cewlks)) (wcel K (co c1 (cfv F chash) cfzo))) (wbr S (cfv (cin (cfv (cfv (co K c1 cmin) F) I) (cfv (cfv K F) I)) chash) cle) $;

--| An s-walk of edges is also a t-walk of edges if ` t <_ s ` . (Contributed by AV, 4-Jan-2021.)
theorem ewlkle (S T F G: class):
  $ wi (w3a (wcel F (co G S cewlks)) (wcel T cxnn0) (wbr T S cle)) (wcel F (co G T cewlks)) $;

--| In a pseudograph, there is no s-walk of edges of length greater than 1 with s>2. (Contributed by AV, 4-Jan-2021.)
theorem upgrewlkle2 (S F G: class):
  $ wi (w3a (wcel G cupgr) (wcel F (co G S cewlks)) (wbr c1 (cfv F chash) clt)) (wbr S c2 cle) $;

--| Lemma 1 for walks to substitute the index of the condition for vertices and edges in a walk. (Contributed by AV, 23-Apr-2021.)
theorem wkslem1 (A2 B2 P F I: class):
  $ wi (wceq A2 B2) (wb (wif (wceq (cfv A2 P) (cfv (co A2 c1 caddc) P)) (wceq (cfv (cfv A2 F) I) (csn (cfv A2 P))) (wss (cpr (cfv A2 P) (cfv (co A2 c1 caddc) P)) (cfv (cfv A2 F) I))) (wif (wceq (cfv B2 P) (cfv (co B2 c1 caddc) P)) (wceq (cfv (cfv B2 F) I) (csn (cfv B2 P))) (wss (cpr (cfv B2 P) (cfv (co B2 c1 caddc) P)) (cfv (cfv B2 F) I)))) $;

--| Lemma 2 for walks to substitute the index of the condition for vertices and edges in a walk. (Contributed by AV, 23-Apr-2021.)
theorem wkslem2 (A2 B2 C P F I: class):
  $ wi (wa (wceq A2 B2) (wceq (co A2 c1 caddc) C)) (wb (wif (wceq (cfv A2 P) (cfv (co A2 c1 caddc) P)) (wceq (cfv (cfv A2 F) I) (csn (cfv A2 P))) (wss (cpr (cfv A2 P) (cfv (co A2 c1 caddc) P)) (cfv (cfv A2 F) I))) (wif (wceq (cfv B2 P) (cfv C P)) (wceq (cfv (cfv B2 F) I) (csn (cfv B2 P))) (wss (cpr (cfv B2 P) (cfv C P)) (cfv (cfv B2 F) I)))) $;

--| The set of walks (in an undirected graph). (Contributed by AV, 30-Dec-2020.)
theorem wksfval {f2 k p: setvar} (G: class) (I: class k) (V: class f2 k) (W: class k p):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi (wcel G W) (wceq (cfv G cwlks) (copab f2 p (w3a (wcel (cv f2) (cword (cdm I))) (wf (co cc0 (cfv (cv f2) chash) cfz) V (cv p)) (wral k (wif (wceq (cfv (cv k) (cv p)) (cfv (co (cv k) c1 caddc) (cv p))) (wceq (cfv (cfv (cv k) (cv f2)) I) (csn (cfv (cv k) (cv p)))) (wss (cpr (cfv (cv k) (cv p)) (cfv (co (cv k) c1 caddc) (cv p))) (cfv (cfv (cv k) (cv f2)) I))) (co cc0 (cfv (cv f2) chash) cfzo))))) $;

--| Properties of a pair of functions to be/represent a walk. (Contributed by AV, 30-Dec-2020.)
theorem iswlk {k: setvar} (P: class) (U: class k) (F G: class) (I V W Z: class k):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi (w3a (wcel G W) (wcel F U) (wcel P Z)) (wb (wbr F P (cfv G cwlks)) (w3a (wcel F (cword (cdm I))) (wf (co cc0 (cfv F chash) cfz) V P) (wral k (wif (wceq (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (wceq (cfv (cfv (cv k) F) I) (csn (cfv (cv k) P))) (wss (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (cfv (cfv (cv k) F) I))) (co cc0 (cfv F chash) cfzo)))) $;

--| Properties of a walk. (Contributed by AV, 5-Nov-2021.)
theorem wlkprop {k: setvar} (P F G: class) (I V: class k):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi (wbr F P (cfv G cwlks)) (w3a (wcel F (cword (cdm I))) (wf (co cc0 (cfv F chash) cfz) V P) (wral k (wif (wceq (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (wceq (cfv (cfv (cv k) F) I) (csn (cfv (cv k) P))) (wss (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (cfv (cfv (cv k) F) I))) (co cc0 (cfv F chash) cfzo))) $;

--| The classes involved in a walk are sets. (Contributed by Alexander van der Vekens, 31-Oct-2017.) (Revised by AV, 3-Feb-2021.)
theorem wlkv (P F G: class):
  $ wi (wbr F P (cfv G cwlks)) (w3a (wcel G cvv) (wcel F cvv) (wcel P cvv)) $;

--| Generalization of ~ iswlk : Conditions for two classes to represent a walk. (Contributed by Alexander van der Vekens, 23-Jun-2018.) (Revised by AV, 1-Jan-2021.)
theorem iswlkg {k: setvar} (P F G: class) (I V W: class k):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi (wcel G W) (wb (wbr F P (cfv G cwlks)) (w3a (wcel F (cword (cdm I))) (wf (co cc0 (cfv F chash) cfz) V P) (wral k (wif (wceq (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (wceq (cfv (cfv (cv k) F) I) (csn (cfv (cv k) P))) (wss (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (cfv (cfv (cv k) F) I))) (co cc0 (cfv F chash) cfzo)))) $;

--| The mapping enumerating the (indices of the) edges of a walk is a word over the indices of the edges of the graph. (Contributed by AV, 5-Apr-2021.)
theorem wlkf (P F G I: class):
  $ wceq I (cfv G ciedg) $ >
  $ wi (wbr F P (cfv G cwlks)) (wcel F (cword (cdm I))) $;

--| A walk has length ` # ( F ) ` , which is an integer. Formerly proven for an Eulerian path, see ~ eupthcl . (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by AV, 18-Feb-2021.)
theorem wlkcl (P F G: class):
  $ wi (wbr F P (cfv G cwlks)) (wcel (cfv F chash) cn0) $;

--| The mapping enumerating the vertices of a walk is a function. (Contributed by AV, 5-Apr-2021.)
theorem wlkp (P F G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wbr F P (cfv G cwlks)) (wf (co cc0 (cfv F chash) cfz) V P) $;

--| The sequence of vertices of a walk is a word over the set of vertices. (Contributed by AV, 27-Jan-2021.)
theorem wlkpwrd (P F G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wbr F P (cfv G cwlks)) (wcel P (cword V)) $;

--| The number of vertices of a walk (in an undirected graph) is the number of its edges plus 1. (Contributed by Alexander van der Vekens, 29-Jun-2018.) (Revised by AV, 1-May-2021.)
theorem wlklenvp1 (P F G: class):
  $ wi (wbr F P (cfv G cwlks)) (wceq (cfv P chash) (co (cfv F chash) c1 caddc)) $;

--| The class of walks is a set. (Contributed by AV, 15-Jan-2021.) (Proof shortened by SN, 11-Dec-2024.)
theorem wksv {f2 p: setvar} (G: class):
  $ wcel (copab f2 p (wbr (cv f2) (cv p) (cfv G cwlks))) cvv $;

--| The sequence of vertices of a walk cannot be empty, i.e. a walk always consists of at least one vertex. (Contributed by Alexander van der Vekens, 19-Jul-2018.) (Revised by AV, 2-Jan-2021.)
theorem wlkn0 (P F G: class):
  $ wi (wbr F P (cfv G cwlks)) (wne P c0) $;

--| The number of edges of a walk is the number of its vertices minus 1. (Contributed by Alexander van der Vekens, 1-Jul-2018.) (Revised by AV, 2-Jan-2021.)
theorem wlklenvm1 (P F G: class):
  $ wi (wbr F P (cfv G cwlks)) (wceq (cfv F chash) (co (cfv P chash) c1 cmin)) $;

--| Lemma for ~ wlkvtxeledg : Two adjacent (not necessarily different) vertices ` A ` and ` B ` in a walk are incident with an edge ` E ` . (Contributed by AV, 4-Apr-2021.) (Revised by AV, 5-Nov-2021.)
theorem ifpsnprss (A2 B2 E: class):
  $ wi (wif (wceq A2 B2) (wceq E (csn A2)) (wss (cpr A2 B2) E)) (wss (cpr A2 B2) E) $;

--| Each pair of adjacent vertices in a walk is a subset of an edge. (Contributed by AV, 28-Jan-2021.) (Proof shortened by AV, 4-Apr-2021.)
theorem wlkvtxeledg {k: setvar} (P F G: class) (I: class k):
  $ wceq I (cfv G ciedg) $ >
  $ wi (wbr F P (cfv G cwlks)) (wral k (wss (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (cfv (cfv (cv k) F) I)) (co cc0 (cfv F chash) cfzo)) $;

--| The vertices of a walk are connected by indexed edges. (Contributed by Alexander van der Vekens, 22-Jul-2018.) (Revised by AV, 2-Jan-2021.) (Proof shortened by AV, 4-Apr-2021.)
theorem wlkvtxiedg {e k: setvar} (P F G I: class):
  $ wceq I (cfv G ciedg) $ >
  $ wi (wbr F P (cfv G cwlks)) (wral k (wrex e (wss (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (cv e)) (crn I)) (co cc0 (cfv F chash) cfzo)) $;

--| The set ` ( Walks `` G ) ` of all walks on ` G ` is a set of pairs by our definition of a walk, and so is a relation. (Contributed by Alexander van der Vekens, 30-Jun-2018.) (Revised by AV, 19-Feb-2021.)
theorem relwlk (G: class):
  $ wrel (cfv G cwlks) $;

--| If there is at least one walk in the graph, all walks are in the universal class of ordered pairs. (Contributed by AV, 2-Jan-2021.)
theorem wlkvv (G W: class):
  $ wi (wbr (cfv W c1st) (cfv W c2nd) (cfv G cwlks)) (wcel W (cxp cvv cvv)) $;

--| A walk is an ordered pair. (Contributed by Alexander van der Vekens, 30-Jun-2018.) (Revised by AV, 1-Jan-2021.)
theorem wlkop (G W: class):
  $ wi (wcel W (cfv G cwlks)) (wceq W (cop (cfv W c1st) (cfv W c2nd))) $;

--| A walk as class with two components. (Contributed by Alexander van der Vekens, 22-Jul-2018.) (Revised by AV, 2-Jan-2021.)
theorem wlkcpr (G W: class):
  $ wb (wcel W (cfv G cwlks)) (wbr (cfv W c1st) (cfv W c2nd) (cfv G cwlks)) $;

--| If there is a walk ` W ` there is a pair of functions representing this walk. (Contributed by Alexander van der Vekens, 22-Jul-2018.)
theorem wlk2f {f2 p: setvar} (G W: class):
  $ wi (wcel W (cfv G cwlks)) (wex f2 (wex p (wbr (cv f2) (cv p) (cfv G cwlks)))) $;

--| A walk expressed by properties of its components. (Contributed by Alexander van der Vekens, 23-Jun-2018.) (Revised by AV, 1-Jan-2021.)
theorem wlkcomp {k: setvar} (P: class) (S T U: class k) (F G: class) (I V W: class k):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq F (cfv W c1st) $ >
  $ wceq P (cfv W c2nd) $ >
  $ wi (wa (wcel G U) (wcel W (cxp S T))) (wb (wcel W (cfv G cwlks)) (w3a (wcel F (cword (cdm I))) (wf (co cc0 (cfv F chash) cfz) V P) (wral k (wif (wceq (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (wceq (cfv (cfv (cv k) F) I) (csn (cfv (cv k) P))) (wss (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (cfv (cfv (cv k) F) I))) (co cc0 (cfv F chash) cfzo)))) $;

--| Implications for the properties of the components of a walk. (Contributed by Alexander van der Vekens, 23-Jun-2018.) (Revised by AV, 2-Jan-2021.)
theorem wlkcompim {k: setvar} (P F G: class) (I V W: class k):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq F (cfv W c1st) $ >
  $ wceq P (cfv W c2nd) $ >
  $ wi (wcel W (cfv G cwlks)) (w3a (wcel F (cword (cdm I))) (wf (co cc0 (cfv F chash) cfz) V P) (wral k (wif (wceq (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (wceq (cfv (cfv (cv k) F) I) (csn (cfv (cv k) P))) (wss (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (cfv (cfv (cv k) F) I))) (co cc0 (cfv F chash) cfzo))) $;

--| The components of a walk are words/functions over a zero based range of integers. (Contributed by Alexander van der Vekens, 23-Jun-2018.) (Revised by AV, 2-Jan-2021.)
theorem wlkelwrd (P F G I V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq F (cfv W c1st) $ >
  $ wceq P (cfv W c2nd) $ >
  $ wi (wcel W (cfv G cwlks)) (wa (wcel F (cword (cdm I))) (wf (co cc0 (cfv F chash) cfz) V P)) $;

--| Conditions for two walks (within the same graph) being the same. (Contributed by AV, 1-Jul-2018.) (Revised by AV, 16-May-2019.) (Revised by AV, 14-Apr-2021.)
theorem wlkeq {x3: setvar} (A2 B2: class) (G: class x3) (N: class):
  $ wi (w3a (wcel A2 (cfv G cwlks)) (wcel B2 (cfv G cwlks)) (wceq N (cfv (cfv A2 c1st) chash))) (wb (wceq A2 B2) (w3a (wceq N (cfv (cfv B2 c1st) chash)) (wral x3 (wceq (cfv (cv x3) (cfv A2 c1st)) (cfv (cv x3) (cfv B2 c1st))) (co cc0 N cfzo)) (wral x3 (wceq (cfv (cv x3) (cfv A2 c2nd)) (cfv (cv x3) (cfv B2 c2nd))) (co cc0 N cfz)))) $;

--| The value of the edge function for an index of an edge within a walk is an edge. (Contributed by AV, 2-Jan-2021.) (Revised by AV, 9-Dec-2021.)
theorem edginwlk (E F G I K: class):
  $ wceq I (cfv G ciedg) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (w3a (wfun I) (wcel F (cword (cdm I))) (wcel K (co cc0 (cfv F chash) cfzo))) (wcel (cfv (cfv K F) I) E) $;

--| The value of the edge function for an index of an edge within a walk is an edge. (Contributed by AV, 2-Jan-2021.)
theorem upgredginwlk (E F G I K: class):
  $ wceq I (cfv G ciedg) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cupgr) (wcel F (cword (cdm I)))) (wi (wcel K (co cc0 (cfv F chash) cfzo)) (wcel (cfv (cfv K F) I) E)) $;

--| The value of the edge function for an index of an edge within a walk is an edge. (Contributed by AV, 23-Apr-2021.)
theorem iedginwlk (P F G I X: class):
  $ wceq I (cfv G ciedg) $ >
  $ wi (w3a (wfun I) (wbr F P (cfv G cwlks)) (wcel X (co cc0 (cfv F chash) cfzo))) (wcel (cfv (cfv X F) I) (crn I)) $;

--| A walk of length 1 from a vertex to itself is a loop. (Contributed by AV, 23-Apr-2021.)
theorem wlkl1loop (P F G: class):
  $ wi (wa (wa (wfun (cfv G ciedg)) (wbr F P (cfv G cwlks))) (wa (wceq (cfv F chash) c1) (wceq (cfv cc0 P) (cfv c1 P)))) (wcel (csn (cfv cc0 P)) (cfv G cedg)) $;

--| A walk is a 1-walk "on the edge level" according to Aksoy et al. (Contributed by AV, 30-Dec-2020.)
theorem wlk1walk {k: setvar} (P F G: class) (I: class k):
  $ wceq I (cfv G ciedg) $ >
  $ wi (wbr F P (cfv G cwlks)) (wral k (wbr c1 (cfv (cin (cfv (cfv (co (cv k) c1 cmin) F) I) (cfv (cfv (cv k) F) I)) chash) cle) (co c1 (cfv F chash) cfzo)) $;

--| A walk is an s-walk "on the edge level" (with s=1) according to Aksoy et al. (Contributed by AV, 5-Jan-2021.)
theorem wlk1ewlk (P F G: class):
  $ wi (wbr F P (cfv G cwlks)) (wcel F (co G c1 cewlks)) $;

--| Properties of a pair of functions to be a walk in a pseudograph. (Contributed by AV, 2-Jan-2021.) (Revised by AV, 28-Oct-2021.)
theorem upgriswlk {k: setvar} (P F G I V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi (wcel G cupgr) (wb (wbr F P (cfv G cwlks)) (w3a (wcel F (cword (cdm I))) (wf (co cc0 (cfv F chash) cfz) V P) (wral k (wceq (cfv (cfv (cv k) F) I) (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P))) (co cc0 (cfv F chash) cfzo)))) $;

--| The edges of a walk in a pseudograph join exactly the two corresponding adjacent vertices in the walk. (Contributed by AV, 27-Feb-2021.)
theorem upgrwlkedg {k: setvar} (P F G I: class):
  $ wceq I (cfv G ciedg) $ >
  $ wi (wa (wcel G cupgr) (wbr F P (cfv G cwlks))) (wral k (wceq (cfv (cfv (cv k) F) I) (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P))) (co cc0 (cfv F chash) cfzo)) $;

--| Implications for the properties of the components of a walk in a pseudograph. (Contributed by Alexander van der Vekens, 23-Jun-2018.) (Revised by AV, 14-Apr-2021.)
theorem upgrwlkcompim {k: setvar} (P F G I V: class) (W: class k):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq F (cfv W c1st) $ >
  $ wceq P (cfv W c2nd) $ >
  $ wi (wa (wcel G cupgr) (wcel W (cfv G cwlks))) (w3a (wcel F (cword (cdm I))) (wf (co cc0 (cfv F chash) cfz) V P) (wral k (wceq (cfv (cfv (cv k) F) I) (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P))) (co cc0 (cfv F chash) cfzo))) $;

--| The vertices of a walk are connected by edges. (Contributed by Alexander van der Vekens, 22-Jul-2018.) (Revised by AV, 2-Jan-2021.)
theorem wlkvtxedg {e k: setvar} (P: class) (E: class k) (F G: class):
  $ wceq E (cfv G cedg) $ >
  $ wi (wbr F P (cfv G cwlks)) (wral k (wrex e (wss (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (cv e)) E) (co cc0 (cfv F chash) cfzo)) $;

--| The pairs of connected vertices of a walk are edges in a pseudograph. (Contributed by Alexander van der Vekens, 22-Jul-2018.) (Revised by AV, 2-Jan-2021.)
theorem upgrwlkvtxedg {k: setvar} (P: class) (E: class k) (F G: class):
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cupgr) (wbr F P (cfv G cwlks))) (wral k (wcel (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) E) (co cc0 (cfv F chash) cfzo)) $;

--| Conditions for two walks within the same simple pseudograph being the same. It is sufficient that the vertices (in the same order) are identical. (Contributed by AV, 3-Jul-2018.) (Revised by AV, 14-Apr-2021.)
theorem uspgr2wlkeq {y1: setvar} (A2 B2 G N: class):
  $ wi (w3a (wcel G cuspgr) (wa (wcel A2 (cfv G cwlks)) (wcel B2 (cfv G cwlks))) (wceq N (cfv (cfv A2 c1st) chash))) (wb (wceq A2 B2) (wa (wceq N (cfv (cfv B2 c1st) chash)) (wral y1 (wceq (cfv (cv y1) (cfv A2 c2nd)) (cfv (cv y1) (cfv B2 c2nd))) (co cc0 N cfz)))) $;

--| Conditions for two walks within the same simple pseudograph to be identical. It is sufficient that the vertices (in the same order) are identical. (Contributed by Alexander van der Vekens, 25-Aug-2018.) (Revised by AV, 14-Apr-2021.)
theorem uspgr2wlkeq2 (A2 B2 G N: class):
  $ wi (w3a (wa (wcel G cuspgr) (wcel N cn0)) (wa (wcel A2 (cfv G cwlks)) (wceq (cfv (cfv A2 c1st) chash) N)) (wa (wcel B2 (cfv G cwlks)) (wceq (cfv (cfv B2 c1st) chash) N))) (wi (wceq (cfv A2 c2nd) (cfv B2 c2nd)) (wceq A2 B2)) $;

--| Conditions for two walks within the same simple pseudograph to be identical. It is sufficient that the vertices (in the same order) are identical. (Contributed by AV, 6-May-2021.)
theorem uspgr2wlkeqi (A2 B2 G: class):
  $ wi (w3a (wcel G cuspgr) (wa (wcel A2 (cfv G cwlks)) (wcel B2 (cfv G cwlks))) (wceq (cfv A2 c2nd) (cfv B2 c2nd))) (wceq A2 B2) $;

--| In a multigraph, each walk has no loops! (Contributed by Alexander van der Vekens, 7-Nov-2017.) (Revised by AV, 3-Jan-2021.)
theorem umgrwlknloop {k: setvar} (P F G: class):
  $ wi (wa (wcel G cumgr) (wbr F P (cfv G cwlks))) (wral k (wne (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (co cc0 (cfv F chash) cfzo)) $;

--| If there is a walk in the null graph (a class without vertices), it would be the pair consisting of empty sets. (Contributed by Alexander van der Vekens, 2-Sep-2018.) (Revised by AV, 5-Mar-2021.)
theorem wlkv0 (G W: class):
  $ wi (wa (wceq (cfv G cvtx) c0) (wcel W (cfv G cwlks))) (wa (wceq (cfv W c1st) c0) (wceq (cfv W c2nd) c0)) $;

--| There is no walk in a null graph (a class without vertices). (Contributed by Alexander van der Vekens, 2-Sep-2018.) (Revised by AV, 5-Mar-2021.)
theorem g0wlk0 (G: class):
  $ wi (wceq (cfv G cvtx) c0) (wceq (cfv G cwlks) c0) $;

--| There is no walk for the empty set, i.e. in a null graph. (Contributed by Alexander van der Vekens, 2-Sep-2018.) (Revised by AV, 5-Mar-2021.)
theorem _0wlk0:
  $ wceq (cfv c0 cwlks) c0 $;

--| There is no walk in a null graph (a class without vertices). (Contributed by Alexander van der Vekens, 2-Sep-2018.) (Revised by AV, 5-Mar-2021.)
theorem wlk0prc (S G: class):
  $ wi (wa (wnel S cvv) (wceq (cfv S cvtx) (cfv G cvtx))) (wceq (cfv G cwlks) c0) $;

--| The number of vertices in a walk equals the length of the walk after it is "closed" (i.e. enhanced by an edge from its last vertex to its first vertex). (Contributed by Alexander van der Vekens, 29-Jun-2018.) (Revised by AV, 2-May-2021.) (Revised by JJ, 14-Jan-2024.)
theorem wlklenvclwlk (F G W: class):
  $ wi (wcel W (cword (cfv G cvtx))) (wi (wcel (cop F (co W (cs1 (cfv cc0 W)) cconcat)) (cfv G cwlks)) (wceq (cfv F chash) (cfv W chash))) $;

--| The set of walks between two vertices. (Contributed by Alexander van der Vekens, 12-Dec-2017.) (Revised by AV, 30-Dec-2020.) (Revised by AV, 22-Mar-2021.)
theorem wlkson {f2 p: setvar} (A2 B2 G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel A2 V) (wcel B2 V)) (wceq (co A2 B2 (cfv G cwlkson)) (copab f2 p (w3a (wbr (cv f2) (cv p) (cfv G cwlks)) (wceq (cfv cc0 (cv p)) A2) (wceq (cfv (cfv (cv f2) chash) (cv p)) B2)))) $;

--| Properties of a pair of functions to be a walk between two given vertices (in an undirected graph). (Contributed by Alexander van der Vekens, 2-Nov-2017.) (Revised by AV, 31-Dec-2020.) (Revised by AV, 22-Mar-2021.)
theorem iswlkon (A2 B2 P U F G V Z: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wa (wcel A2 V) (wcel B2 V)) (wa (wcel F U) (wcel P Z))) (wb (wbr F P (co A2 B2 (cfv G cwlkson))) (w3a (wbr F P (cfv G cwlks)) (wceq (cfv cc0 P) A2) (wceq (cfv (cfv F chash) P) B2))) $;

--| Properties of a walk between two vertices. (Contributed by Alexander van der Vekens, 12-Dec-2017.) (Revised by AV, 31-Dec-2020.) (Proof shortened by AV, 16-Jan-2021.)
theorem wlkonprop (A2 B2 P F G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wbr F P (co A2 B2 (cfv G cwlkson))) (w3a (w3a (wcel G cvv) (wcel A2 V) (wcel B2 V)) (wa (wcel F cvv) (wcel P cvv)) (w3a (wbr F P (cfv G cwlks)) (wceq (cfv cc0 P) A2) (wceq (cfv (cfv F chash) P) B2))) $;

--| A walk connects vertices. (Contributed by AV, 22-Feb-2021.)
theorem wlkpvtx (P F G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wbr F P (cfv G cwlks)) (wi (wcel N (co cc0 (cfv F chash) cfz)) (wcel (cfv N P) V)) $;

--| The endpoints of a walk are vertices. (Contributed by AV, 31-Jan-2021.)
theorem wlkepvtx (P F G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wbr F P (cfv G cwlks)) (wa (wcel (cfv cc0 P) V) (wcel (cfv (cfv F chash) P) V)) $;

--| A walk between two vertices is a walk. (Contributed by Alexander van der Vekens, 12-Dec-2017.) (Revised by AV, 2-Jan-2021.)
theorem wlkoniswlk (A2 B2 P F G: class):
  $ wi (wbr F P (co A2 B2 (cfv G cwlkson))) (wbr F P (cfv G cwlks)) $;

--| A walk is a walk between its endpoints. (Contributed by Alexander van der Vekens, 2-Nov-2017.) (Revised by AV, 2-Jan-2021.) (Proof shortened by AV, 31-Jan-2021.)
theorem wlkonwlk (P F G: class):
  $ wi (wbr F P (cfv G cwlks)) (wbr F P (co (cfv cc0 P) (cfv (cfv F chash) P) (cfv G cwlkson))) $;

--| A walk is a walk from its first vertex to its last vertex. (Contributed by AV, 7-Feb-2021.) (Revised by AV, 22-Mar-2021.)
theorem wlkonwlk1l (ph: wff) (P F G: class):
  $ wi ph (wbr F P (cfv G cwlks)) $ >
  $ wi ph (wbr F P (co (cfv cc0 P) (cfv P clsw) (cfv G cwlkson))) $;

--| Two walks with identical sequences of vertices start and end at the same vertices. (Contributed by AV, 14-May-2021.)
theorem wlksoneq1eq2 (A2 B2 C D P F G H: class):
  $ wi (wa (wbr F P (co A2 B2 (cfv G cwlkson))) (wbr H P (co C D (cfv G cwlkson)))) (wa (wceq A2 C) (wceq B2 D)) $;

--| If there is a walk between two vertices ` A ` and ` B ` at least of length 1, then the start vertex ` A ` is incident with an edge. (Contributed by AV, 4-Apr-2021.)
theorem wlkonl1iedg {e: setvar} (A2: class) (B2: class e) (P F G I: class):
  $ wceq I (cfv G ciedg) $ >
  $ wi (wa (wbr F P (co A2 B2 (cfv G cwlkson))) (wne (cfv F chash) cc0)) (wrex e (wcel A2 (cv e)) (crn I)) $;

--| The length of a walk between two different vertices is not 0 (i.e. is at least 1). (Contributed by AV, 3-Apr-2021.)
theorem wlkon2n0 (A2 B2 P F G: class):
  $ wi (wa (wbr F P (co A2 B2 (cfv G cwlkson))) (wne A2 B2)) (wne (cfv F chash) cc0) $;

--| Lemma for theorems for walks of length 2. (Contributed by Alexander van der Vekens, 1-Feb-2018.)
theorem _2wlklem {k: setvar} (P E F: class):
  $ wb (wral k (wceq (cfv (cfv (cv k) F) E) (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P))) (cpr cc0 c1)) (wa (wceq (cfv (cfv cc0 F) E) (cpr (cfv cc0 P) (cfv c1 P))) (wceq (cfv (cfv c1 F) E) (cpr (cfv c1 P) (cfv c2 P)))) $;

--| Properties of a pair of functions to be a walk of length 2 in a pseudograph. Note that the vertices need not to be distinct and the edges can be loops or multiedges. (Contributed by Alexander van der Vekens, 16-Feb-2018.) (Revised by AV, 3-Jan-2021.) (Revised by AV, 28-Oct-2021.)
theorem upgr2wlk (P F G I V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi (wcel G cupgr) (wb (wa (wbr F P (cfv G cwlks)) (wceq (cfv F chash) c2)) (w3a (wf (co cc0 c2 cfzo) (cdm I) F) (wf (co cc0 c2 cfz) V P) (wa (wceq (cfv (cfv cc0 F) I) (cpr (cfv cc0 P) (cfv c1 P))) (wceq (cfv (cfv c1 F) I) (cpr (cfv c1 P) (cfv c2 P)))))) $;

--| Lemma for ~ wlkres . (Contributed by AV, 5-Mar-2021.) (Revised by AV, 30-Nov-2022.)
theorem wlkreslem (ph: wff) (P S F G I N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wbr F P (cfv G cwlks)) $ >
  $ wi ph (wcel N (co cc0 (cfv F chash) cfzo)) $ >
  $ wi ph (wceq (cfv S cvtx) V) $ >
  $ wi ph (wcel S cvv) $;

--| The restriction ` <. H , Q >. ` of a walk ` <. F , P >. ` to an initial segment of the walk (of length ` N ` ) forms a walk on the subgraph ` S ` consisting of the edges in the initial segment. Formerly proven directly for Eulerian paths, see ~ eupthres . (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by Mario Carneiro, 3-May-2015.) (Revised by AV, 5-Mar-2021.) Hypothesis revised using the prefix operation. (Revised by AV, 30-Nov-2022.)
theorem wlkres (ph: wff) (P Q S F G H I N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wbr F P (cfv G cwlks)) $ >
  $ wi ph (wcel N (co cc0 (cfv F chash) cfzo)) $ >
  $ wi ph (wceq (cfv S cvtx) V) $ >
  $ wi ph (wceq (cfv S ciedg) (cres I (cima F (co cc0 N cfzo)))) $ >
  $ wceq H (co F N cpfx) $ >
  $ wceq Q (cres P (co cc0 N cfz)) $ >
  $ wi ph (wbr H Q (cfv S cwlks)) $;

--| Lemma for ~ redwlk . (Contributed by Alexander van der Vekens, 1-Nov-2017.) (Revised by AV, 29-Jan-2021.)
theorem redwlklem (P S F V: class):
  $ wi (w3a (wcel F (cword S)) (wbr c1 (cfv F chash) cle) (wf (co cc0 (cfv F chash) cfz) V P)) (wf (co cc0 (cfv (cres F (co cc0 (co (cfv F chash) c1 cmin) cfzo)) chash) cfz) V (cres P (co cc0 (cfv F chash) cfzo))) $;

--| A walk ending at the last but one vertex of the walk is a walk. (Contributed by Alexander van der Vekens, 1-Nov-2017.) (Revised by AV, 29-Jan-2021.)
theorem redwlk (P F G: class):
  $ wi (wa (wbr F P (cfv G cwlks)) (wbr c1 (cfv F chash) cle)) (wbr (cres F (co cc0 (co (cfv F chash) c1 cmin) cfzo)) (cres P (co cc0 (cfv F chash) cfzo)) (cfv G cwlks)) $;

--| Lemma for ~ wlkp1 . (Contributed by AV, 6-Mar-2021.)
theorem wlkp1lem1 (ph: wff) (B2 C P F G I N V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wfun I) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wn (wcel B2 (cdm I))) $ >
  $ wi ph (wbr F P (cfv G cwlks)) $ >
  $ wceq N (cfv F chash) $ >
  $ wi ph (wn (wcel (co N c1 caddc) (cdm P))) $;

--| Lemma for ~ wlkp1 . (Contributed by AV, 6-Mar-2021.)
theorem wlkp1lem2 (ph: wff) (B2 C P S E F G H I N V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wfun I) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wn (wcel B2 (cdm I))) $ >
  $ wi ph (wbr F P (cfv G cwlks)) $ >
  $ wceq N (cfv F chash) $ >
  $ wi ph (wcel E (cfv G cedg)) $ >
  $ wi ph (wss (cpr (cfv N P) C) E) $ >
  $ wi ph (wceq (cfv S ciedg) (cun I (csn (cop B2 E)))) $ >
  $ wceq H (cun F (csn (cop N B2))) $ >
  $ wi ph (wceq (cfv H chash) (co N c1 caddc)) $;

--| Lemma for ~ wlkp1 . (Contributed by AV, 6-Mar-2021.)
theorem wlkp1lem3 (ph: wff) (B2 C P S E F G H I N V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wfun I) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wn (wcel B2 (cdm I))) $ >
  $ wi ph (wbr F P (cfv G cwlks)) $ >
  $ wceq N (cfv F chash) $ >
  $ wi ph (wcel E (cfv G cedg)) $ >
  $ wi ph (wss (cpr (cfv N P) C) E) $ >
  $ wi ph (wceq (cfv S ciedg) (cun I (csn (cop B2 E)))) $ >
  $ wceq H (cun F (csn (cop N B2))) $ >
  $ wi ph (wceq (cfv (cfv N H) (cfv S ciedg)) (cfv B2 (cun I (csn (cop B2 E))))) $;

--| Lemma for ~ wlkp1 . (Contributed by AV, 6-Mar-2021.)
theorem wlkp1lem4 (ph: wff) (B2 C P Q S E F G H I N V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wfun I) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wn (wcel B2 (cdm I))) $ >
  $ wi ph (wbr F P (cfv G cwlks)) $ >
  $ wceq N (cfv F chash) $ >
  $ wi ph (wcel E (cfv G cedg)) $ >
  $ wi ph (wss (cpr (cfv N P) C) E) $ >
  $ wi ph (wceq (cfv S ciedg) (cun I (csn (cop B2 E)))) $ >
  $ wceq H (cun F (csn (cop N B2))) $ >
  $ wceq Q (cun P (csn (cop (co N c1 caddc) C))) $ >
  $ wi ph (wceq (cfv S cvtx) V) $ >
  $ wi ph (w3a (wcel S cvv) (wcel H cvv) (wcel Q cvv)) $;

--| Lemma for ~ wlkp1 . (Contributed by AV, 6-Mar-2021.)
theorem wlkp1lem5 {k: setvar} (ph: wff) (B2 C P Q S E F G H I N V W: class k):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wfun I) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wn (wcel B2 (cdm I))) $ >
  $ wi ph (wbr F P (cfv G cwlks)) $ >
  $ wceq N (cfv F chash) $ >
  $ wi ph (wcel E (cfv G cedg)) $ >
  $ wi ph (wss (cpr (cfv N P) C) E) $ >
  $ wi ph (wceq (cfv S ciedg) (cun I (csn (cop B2 E)))) $ >
  $ wceq H (cun F (csn (cop N B2))) $ >
  $ wceq Q (cun P (csn (cop (co N c1 caddc) C))) $ >
  $ wi ph (wceq (cfv S cvtx) V) $ >
  $ wi ph (wral k (wceq (cfv (cv k) Q) (cfv (cv k) P)) (co cc0 N cfz)) $;

--| Lemma for ~ wlkp1 . (Contributed by AV, 6-Mar-2021.)
theorem wlkp1lem6 {k: setvar} (ph: wff) (B2 C P Q S E F G H I N V W: class k):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wfun I) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wn (wcel B2 (cdm I))) $ >
  $ wi ph (wbr F P (cfv G cwlks)) $ >
  $ wceq N (cfv F chash) $ >
  $ wi ph (wcel E (cfv G cedg)) $ >
  $ wi ph (wss (cpr (cfv N P) C) E) $ >
  $ wi ph (wceq (cfv S ciedg) (cun I (csn (cop B2 E)))) $ >
  $ wceq H (cun F (csn (cop N B2))) $ >
  $ wceq Q (cun P (csn (cop (co N c1 caddc) C))) $ >
  $ wi ph (wceq (cfv S cvtx) V) $ >
  $ wi ph (wral k (w3a (wceq (cfv (cv k) Q) (cfv (cv k) P)) (wceq (cfv (co (cv k) c1 caddc) Q) (cfv (co (cv k) c1 caddc) P)) (wceq (cfv (cfv (cv k) H) (cfv S ciedg)) (cfv (cfv (cv k) F) I))) (co cc0 N cfzo)) $;

--| Lemma for ~ wlkp1 . (Contributed by AV, 6-Mar-2021.)
theorem wlkp1lem7 (ph: wff) (B2 C P Q S E F G H I N V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wfun I) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wn (wcel B2 (cdm I))) $ >
  $ wi ph (wbr F P (cfv G cwlks)) $ >
  $ wceq N (cfv F chash) $ >
  $ wi ph (wcel E (cfv G cedg)) $ >
  $ wi ph (wss (cpr (cfv N P) C) E) $ >
  $ wi ph (wceq (cfv S ciedg) (cun I (csn (cop B2 E)))) $ >
  $ wceq H (cun F (csn (cop N B2))) $ >
  $ wceq Q (cun P (csn (cop (co N c1 caddc) C))) $ >
  $ wi ph (wceq (cfv S cvtx) V) $ >
  $ wi ph (wss (cpr (cfv N Q) (cfv (co N c1 caddc) Q)) (cfv (cfv N H) (cfv S ciedg))) $;

--| Lemma for ~ wlkp1 . (Contributed by AV, 6-Mar-2021.)
theorem wlkp1lem8 {k: setvar} (ph: wff) (B2 C: class k) (P Q S: class) (E: class k) (F G H: class) (I: class k) (N: class) (V W: class k):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wfun I) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wn (wcel B2 (cdm I))) $ >
  $ wi ph (wbr F P (cfv G cwlks)) $ >
  $ wceq N (cfv F chash) $ >
  $ wi ph (wcel E (cfv G cedg)) $ >
  $ wi ph (wss (cpr (cfv N P) C) E) $ >
  $ wi ph (wceq (cfv S ciedg) (cun I (csn (cop B2 E)))) $ >
  $ wceq H (cun F (csn (cop N B2))) $ >
  $ wceq Q (cun P (csn (cop (co N c1 caddc) C))) $ >
  $ wi ph (wceq (cfv S cvtx) V) $ >
  $ wi (wa ph (wceq C (cfv N P))) (wceq E (csn C)) $ >
  $ wi ph (wral k (wif (wceq (cfv (cv k) Q) (cfv (co (cv k) c1 caddc) Q)) (wceq (cfv (cfv (cv k) H) (cfv S ciedg)) (csn (cfv (cv k) Q))) (wss (cpr (cfv (cv k) Q) (cfv (co (cv k) c1 caddc) Q)) (cfv (cfv (cv k) H) (cfv S ciedg)))) (co cc0 (cfv H chash) cfzo)) $;

--| Append one path segment (edge) ` E ` from vertex ` ( P `` N ) ` to a vertex ` C ` to a walk ` <. F , P >. ` to become a walk ` <. H , Q >. ` of the supergraph ` S ` obtained by adding the new edge to the graph ` G ` . Formerly proven directly for Eulerian paths (for pseudographs), see ~ eupthp1 . (Contributed by Mario Carneiro, 7-Apr-2015.) (Revised by AV, 6-Mar-2021.) (Proof shortened by AV, 18-Apr-2021.) (Revised by AV, 8-Apr-2024.)
theorem wlkp1 (ph: wff) (B2 C P Q S E F G H I N V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wfun I) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wn (wcel B2 (cdm I))) $ >
  $ wi ph (wbr F P (cfv G cwlks)) $ >
  $ wceq N (cfv F chash) $ >
  $ wi ph (wcel E (cfv G cedg)) $ >
  $ wi ph (wss (cpr (cfv N P) C) E) $ >
  $ wi ph (wceq (cfv S ciedg) (cun I (csn (cop B2 E)))) $ >
  $ wceq H (cun F (csn (cop N B2))) $ >
  $ wceq Q (cun P (csn (cop (co N c1 caddc) C))) $ >
  $ wi ph (wceq (cfv S cvtx) V) $ >
  $ wi (wa ph (wceq C (cfv N P))) (wceq E (csn C)) $ >
  $ wi ph (wbr H Q (cfv S cwlks)) $;

--| Lemma 1 for ~ wlkd . (Contributed by AV, 7-Feb-2021.)
theorem wlkdlem1 {k: setvar} (ph: wff k) (P F V: class):
  $ wi ph (wcel P (cword cvv)) $ >
  $ wi ph (wcel F (cword cvv)) $ >
  $ wi ph (wceq (cfv P chash) (co (cfv F chash) c1 caddc)) $ >
  $ wi ph (wral k (wcel (cfv (cv k) P) V) (co cc0 (cfv F chash) cfz)) $ >
  $ wi ph (wf (co cc0 (cfv F chash) cfz) V P) $;

--| Lemma 2 for ~ wlkd . (Contributed by AV, 7-Feb-2021.)
theorem wlkdlem2 {k: setvar} (ph: wff) (P F I: class):
  $ wi ph (wcel P (cword cvv)) $ >
  $ wi ph (wcel F (cword cvv)) $ >
  $ wi ph (wceq (cfv P chash) (co (cfv F chash) c1 caddc)) $ >
  $ wi ph (wral k (wss (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (cfv (cfv (cv k) F) I)) (co cc0 (cfv F chash) cfzo)) $ >
  $ wi ph (wa (wi (wcel (cfv F chash) cn) (wcel (cfv (cfv F chash) P) (cfv (cfv (co (cfv F chash) c1 cmin) F) I))) (wral k (wcel (cfv (cv k) P) (cfv (cfv (cv k) F) I)) (co cc0 (cfv F chash) cfzo))) $;

--| Lemma 3 for ~ wlkd . (Contributed by Alexander van der Vekens, 10-Nov-2017.) (Revised by AV, 7-Feb-2021.)
theorem wlkdlem3 {k: setvar} (ph: wff) (P F I: class):
  $ wi ph (wcel P (cword cvv)) $ >
  $ wi ph (wcel F (cword cvv)) $ >
  $ wi ph (wceq (cfv P chash) (co (cfv F chash) c1 caddc)) $ >
  $ wi ph (wral k (wss (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (cfv (cfv (cv k) F) I)) (co cc0 (cfv F chash) cfzo)) $ >
  $ wi ph (wcel F (cword (cdm I))) $;

--| Lemma 4 for ~ wlkd . (Contributed by Alexander van der Vekens, 1-Feb-2018.) (Revised by AV, 23-Jan-2021.)
theorem wlkdlem4 {k: setvar} (ph: wff) (P F I: class):
  $ wi ph (wcel P (cword cvv)) $ >
  $ wi ph (wcel F (cword cvv)) $ >
  $ wi ph (wceq (cfv P chash) (co (cfv F chash) c1 caddc)) $ >
  $ wi ph (wral k (wss (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (cfv (cfv (cv k) F) I)) (co cc0 (cfv F chash) cfzo)) $ >
  $ wi ph (wral k (wne (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (co cc0 (cfv F chash) cfzo)) $ >
  $ wi ph (wral k (wif (wceq (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (wceq (cfv (cfv (cv k) F) I) (csn (cfv (cv k) P))) (wss (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (cfv (cfv (cv k) F) I))) (co cc0 (cfv F chash) cfzo)) $;

--| Two words representing a walk in a graph. (Contributed by AV, 7-Feb-2021.)
theorem wlkd {k: setvar} (ph: wff) (P F G I V: class) (W: class k):
  $ wi ph (wcel P (cword cvv)) $ >
  $ wi ph (wcel F (cword cvv)) $ >
  $ wi ph (wceq (cfv P chash) (co (cfv F chash) c1 caddc)) $ >
  $ wi ph (wral k (wss (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (cfv (cfv (cv k) F) I)) (co cc0 (cfv F chash) cfzo)) $ >
  $ wi ph (wral k (wne (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (co cc0 (cfv F chash) cfzo)) $ >
  $ wi ph (wcel G W) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wral k (wcel (cfv (cv k) P) V) (co cc0 (cfv F chash) cfz)) $ >
  $ wi ph (wbr F P (cfv G cwlks)) $;

--| A prefix of a walk is a walk. (Contributed by BTernaryTau, 2-Dec-2023.)
theorem pfxwlk (P F G L: class):
  $ wi (wa (wbr F P (cfv G cwlks)) (wcel L (co cc0 (cfv F chash) cfz))) (wbr (co F L cpfx) (co P (co L c1 caddc) cpfx) (cfv G cwlks)) $;

--| The reverse of a walk is a walk. (Contributed by BTernaryTau, 30-Nov-2023.)
theorem revwlk (P F G: class):
  $ wi (wbr F P (cfv G cwlks)) (wbr (cfv F creverse) (cfv P creverse) (cfv G cwlks)) $;

--| Two matching subwords of a walk also represent a walk. (Contributed by BTernaryTau, 7-Dec-2023.)
theorem swrdwlk (B2 P F G L: class):
  $ wi (w3a (wbr F P (cfv G cwlks)) (wcel B2 (co cc0 L cfz)) (wcel L (co cc0 (cfv F chash) cfz))) (wbr (co F (cop B2 L) csubstr) (co P (cop B2 (co L c1 caddc)) csubstr) (cfv G cwlks)) $;

--| If a walk exists in a subgraph of a graph ` G ` , then that walk also exists in ` G ` . (Contributed by BTernaryTau, 22-Oct-2023.)
theorem subgrwlk (P S F G: class):
  $ wi (wbr S G csubgr) (wi (wbr F P (cfv S cwlks)) (wbr F P (cfv G cwlks))) $;

--| Two adjacent vertices in a walk are different in a loop-free graph. (Contributed by AV, 28-Jan-2021.)
theorem lfgrwlkprop {x3 k: setvar} (P: class x3) (F: class) (G: class x3) (I V: class):
  $ wceq I (cfv G ciedg) $ >
  $ wi (wa (wbr F P (cfv G cwlks)) (wf (cdm I) (crab x3 (wbr c2 (cfv (cv x3) chash) cle) (cpw V)) I)) (wral k (wne (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (co cc0 (cfv F chash) cfzo)) $;

--| Conditions for a pair of functions to be a walk in a loop-free graph. (Contributed by AV, 28-Jan-2021.)
theorem lfgriswlk {x3 k: setvar} (P: class x3) (F: class) (G: class x3) (I V: class) (W: class x3 k):
  $ wceq I (cfv G ciedg) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel G W) (wf (cdm I) (crab x3 (wbr c2 (cfv (cv x3) chash) cle) (cpw V)) I)) (wb (wbr F P (cfv G cwlks)) (w3a (wcel F (cword (cdm I))) (wf (co cc0 (cfv F chash) cfz) V P) (wral k (wa (wne (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (wss (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (cfv (cfv (cv k) F) I))) (co cc0 (cfv F chash) cfzo)))) $;

--| In a loop-free graph, each walk has no loops! (Contributed by AV, 2-Feb-2021.)
theorem lfgrwlknloop {x3 k: setvar} (P: class x3) (F: class) (G: class x3) (I V: class):
  $ wceq I (cfv G ciedg) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wf (cdm I) (crab x3 (wbr c2 (cfv (cv x3) chash) cle) (cpw V)) I) (wbr F P (cfv G cwlks))) (wral k (wne (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (co cc0 (cfv F chash) cfzo)) $;

--| Extend class notation with trails (within a graph).
term ctrls: class;

--| Extend class notation with trails between two vertices (within a graph).
term ctrlson: class;

--| Define the set of all Trails (in an undirected graph). According to Wikipedia ("Path (graph theory)", ~ https://en.wikipedia.org/wiki/Path_(graph_theory) , 3-Oct-2017): "A trail is a walk in which all edges are distinct. According to Bollobas: "... walk is called a trail if all its edges are distinct.", see Definition of [Bollobas] p. 5. Therefore, a trail can be represented by an injective mapping f from { 1 , ... , n } and a mapping p from { 0 , ... , n }, where f enumerates the (indices of the) different edges, and p enumerates the vertices. So the trail is also represented by the following sequence: p(0) e(f(1)) p(1) e(f(2)) ... p(n-1) e(f(n)) p(n). (Contributed by Alexander van der Vekens and Mario Carneiro, 4-Oct-2017.) (Revised by AV, 28-Dec-2020.)
axiom df_trls {f2 g2 p: setvar}:
  $ wceq ctrls (cmpt g2 cvv (copab f2 p (wa (wbr (cv f2) (cv p) (cfv (cv g2) cwlks)) (wfun (ccnv (cv f2)))))) $;

--| Define the collection of trails with particular endpoints (in an undirected graph). (Contributed by Alexander van der Vekens and Mario Carneiro, 4-Oct-2017.) (Revised by AV, 28-Dec-2020.)
axiom df_trlson {f2 g2 p a b: setvar}:
  $ wceq ctrlson (cmpt g2 cvv (cmpo a b (cfv (cv g2) cvtx) (cfv (cv g2) cvtx) (copab f2 p (wa (wbr (cv f2) (cv p) (co (cv a) (cv b) (cfv (cv g2) cwlkson))) (wbr (cv f2) (cv p) (cfv (cv g2) ctrls)))))) $;

--| The set ` ( Trails `` G ) ` of all trails on ` G ` is a set of pairs by our definition of a trail, and so is a relation. (Contributed by AV, 29-Oct-2021.)
theorem reltrls (G: class):
  $ wrel (cfv G ctrls) $;

--| The set of trails (in an undirected graph). (Contributed by Alexander van der Vekens, 20-Oct-2017.) (Revised by AV, 28-Dec-2020.) (Revised by AV, 29-Oct-2021.)
theorem trlsfval {f2 p: setvar} (G: class):
  $ wceq (cfv G ctrls) (copab f2 p (wa (wbr (cv f2) (cv p) (cfv G cwlks)) (wfun (ccnv (cv f2))))) $;

--| Conditions for a pair of classes/functions to be a trail (in an undirected graph). (Contributed by Alexander van der Vekens, 20-Oct-2017.) (Revised by AV, 28-Dec-2020.) (Revised by AV, 29-Oct-2021.)
theorem istrl (P F G: class):
  $ wb (wbr F P (cfv G ctrls)) (wa (wbr F P (cfv G cwlks)) (wfun (ccnv F))) $;

--| A trail is a walk. (Contributed by Alexander van der Vekens, 20-Oct-2017.) (Revised by AV, 7-Jan-2021.) (Proof shortened by AV, 29-Oct-2021.)
theorem trliswlk (P F G: class):
  $ wi (wbr F P (cfv G ctrls)) (wbr F P (cfv G cwlks)) $;

--| The enumeration ` F ` of a trail ` <. F , P >. ` is injective. (Contributed by AV, 20-Feb-2021.) (Proof shortened by AV, 29-Oct-2021.)
theorem trlf1 (P F G I: class):
  $ wceq I (cfv G ciedg) $ >
  $ wi (wbr F P (cfv G ctrls)) (wf1 (co cc0 (cfv F chash) cfzo) (cdm I) F) $;

--| Lemma for ~ trlres . Formerly part of proof of ~ eupthres . (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by Mario Carneiro, 3-May-2015.) (Revised by AV, 6-Mar-2021.) Hypothesis revised using the prefix operation. (Revised by AV, 30-Nov-2022.)
theorem trlreslem (ph: wff) (P F G H I N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wbr F P (cfv G ctrls)) $ >
  $ wi ph (wcel N (co cc0 (cfv F chash) cfzo)) $ >
  $ wceq H (co F N cpfx) $ >
  $ wi ph (wf1o (co cc0 (cfv H chash) cfzo) (cdm (cres I (cima F (co cc0 N cfzo)))) H) $;

--| The restriction ` <. H , Q >. ` of a trail ` <. F , P >. ` to an initial segment of the trail (of length ` N ` ) forms a trail on the subgraph ` S ` consisting of the edges in the initial segment. (Contributed by AV, 6-Mar-2021.) Hypothesis revised using the prefix operation. (Revised by AV, 30-Nov-2022.)
theorem trlres (ph: wff) (P Q S F G H I N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wbr F P (cfv G ctrls)) $ >
  $ wi ph (wcel N (co cc0 (cfv F chash) cfzo)) $ >
  $ wceq H (co F N cpfx) $ >
  $ wi ph (wceq (cfv S cvtx) V) $ >
  $ wi ph (wceq (cfv S ciedg) (cres I (cima F (co cc0 N cfzo)))) $ >
  $ wceq Q (cres P (co cc0 N cfz)) $ >
  $ wi ph (wbr H Q (cfv S ctrls)) $;

--| The set of trails in a pseudograph, definition of walks expanded. (Contributed by Alexander van der Vekens, 20-Oct-2017.) (Revised by AV, 7-Jan-2021.)
theorem upgrtrls {f2 k p: setvar} (G I: class) (V: class f2):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi (wcel G cupgr) (wceq (cfv G ctrls) (copab f2 p (w3a (wa (wcel (cv f2) (cword (cdm I))) (wfun (ccnv (cv f2)))) (wf (co cc0 (cfv (cv f2) chash) cfz) V (cv p)) (wral k (wceq (cfv (cfv (cv k) (cv f2)) I) (cpr (cfv (cv k) (cv p)) (cfv (co (cv k) c1 caddc) (cv p)))) (co cc0 (cfv (cv f2) chash) cfzo))))) $;

--| Properties of a pair of functions to be a trail in a pseudograph, definition of walks expanded. (Contributed by Alexander van der Vekens, 20-Oct-2017.) (Revised by AV, 7-Jan-2021.) (Revised by AV, 29-Oct-2021.)
theorem upgristrl {k: setvar} (P F G I V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi (wcel G cupgr) (wb (wbr F P (cfv G ctrls)) (w3a (wa (wcel F (cword (cdm I))) (wfun (ccnv F))) (wf (co cc0 (cfv F chash) cfz) V P) (wral k (wceq (cfv (cfv (cv k) F) I) (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P))) (co cc0 (cfv F chash) cfzo)))) $;

--| Properties of a pair of a one-to-one function into the set of indices of edges and a function into the set of vertices to be a trail in a pseudograph. (Contributed by Alexander van der Vekens, 20-Oct-2017.) (Revised by AV, 7-Jan-2021.) (Revised by AV, 29-Oct-2021.)
theorem upgrf1istrl {k: setvar} (P F G I V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi (wcel G cupgr) (wb (wbr F P (cfv G ctrls)) (w3a (wf1 (co cc0 (cfv F chash) cfzo) (cdm I) F) (wf (co cc0 (cfv F chash) cfz) V P) (wral k (wceq (cfv (cfv (cv k) F) I) (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P))) (co cc0 (cfv F chash) cfzo)))) $;

--| Lemma for theorems for properties of walks between two vertices, e.g., ~ trlsonprop . (Contributed by AV, 16-Jan-2021.) Remove is-walk hypothesis. (Revised by SN, 13-Dec-2024.)
theorem wksonproplem {f2 g2 p a b: setvar} (A2 B2: class) (P: class f2 g2 p a b) (Q: class) (F: class f2 g2 p a b) (G: class) (O: class f2 p) (V: class) (W: class f2 g2 p a b):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (w3a (wcel G cvv) (wcel A2 V) (wcel B2 V)) (wa (wcel F cvv) (wcel P cvv))) (wb (wbr F P (co A2 B2 (cfv G W))) (wa (wbr F P (co A2 B2 (cfv G O))) (wbr F P (cfv G Q)))) $ >
  $ wceq W (cmpt g2 cvv (cmpo a b (cfv (cv g2) cvtx) (cfv (cv g2) cvtx) (copab f2 p (wa (wbr (cv f2) (cv p) (co (cv a) (cv b) (cfv (cv g2) O))) (wbr (cv f2) (cv p) (cfv (cv g2) Q)))))) $ >
  $ wi (wbr F P (co A2 B2 (cfv G W))) (w3a (w3a (wcel G cvv) (wcel A2 V) (wcel B2 V)) (wa (wcel F cvv) (wcel P cvv)) (wa (wbr F P (co A2 B2 (cfv G O))) (wbr F P (cfv G Q)))) $;

--| The set of trails between two vertices. (Contributed by Alexander van der Vekens, 4-Nov-2017.) (Revised by AV, 7-Jan-2021.) (Proof shortened by AV, 15-Jan-2021.) (Revised by AV, 21-Mar-2021.)
theorem trlsonfval {f2 p: setvar} (A2 B2 G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel A2 V) (wcel B2 V)) (wceq (co A2 B2 (cfv G ctrlson)) (copab f2 p (wa (wbr (cv f2) (cv p) (co A2 B2 (cfv G cwlkson))) (wbr (cv f2) (cv p) (cfv G ctrls))))) $;

--| Properties of a pair of functions to be a trail between two given vertices. (Contributed by Alexander van der Vekens, 3-Nov-2017.) (Revised by AV, 7-Jan-2021.) (Revised by AV, 21-Mar-2021.)
theorem istrlson (A2 B2 P U F G V Z: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wa (wcel A2 V) (wcel B2 V)) (wa (wcel F U) (wcel P Z))) (wb (wbr F P (co A2 B2 (cfv G ctrlson))) (wa (wbr F P (co A2 B2 (cfv G cwlkson))) (wbr F P (cfv G ctrls)))) $;

--| Properties of a trail between two vertices. (Contributed by Alexander van der Vekens, 5-Nov-2017.) (Revised by AV, 7-Jan-2021.) (Proof shortened by AV, 16-Jan-2021.)
theorem trlsonprop (A2 B2 P F G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wbr F P (co A2 B2 (cfv G ctrlson))) (w3a (w3a (wcel G cvv) (wcel A2 V) (wcel B2 V)) (wa (wcel F cvv) (wcel P cvv)) (wa (wbr F P (co A2 B2 (cfv G cwlkson))) (wbr F P (cfv G ctrls)))) $;

--| A trail between two vertices is a trail. (Contributed by Alexander van der Vekens, 12-Dec-2017.) (Revised by AV, 7-Jan-2021.)
theorem trlsonistrl (A2 B2 P F G: class):
  $ wi (wbr F P (co A2 B2 (cfv G ctrlson))) (wbr F P (cfv G ctrls)) $;

--| A trail between two vertices is a walk between these vertices. (Contributed by Alexander van der Vekens, 5-Nov-2017.) (Revised by AV, 7-Jan-2021.)
theorem trlsonwlkon (A2 B2 P F G: class):
  $ wi (wbr F P (co A2 B2 (cfv G ctrlson))) (wbr F P (co A2 B2 (cfv G cwlkson))) $;

--| A trail is a trail between its endpoints. (Contributed by AV, 31-Jan-2021.)
theorem trlontrl (P F G: class):
  $ wi (wbr F P (cfv G ctrls)) (wbr F P (co (cfv cc0 P) (cfv (cfv F chash) P) (cfv G ctrlson))) $;

--| If a trail exists in a subgraph of a graph ` G ` , then that trail also exists in ` G ` . (Contributed by BTernaryTau, 22-Oct-2023.)
theorem subgrtrl (P S F G: class):
  $ wi (wbr S G csubgr) (wi (wbr F P (cfv S ctrls)) (wbr F P (cfv G ctrls))) $;

--| Extend class notation with paths (of a graph).
term cpths: class;

--| Extend class notation with simple paths (of a graph).
term cspths: class;

--| Extend class notation with paths between two vertices (within a graph).
term cpthson: class;

--| Extend class notation with simple paths between two vertices (within a graph).
term cspthson: class;

--| Define the set of all paths (in an undirected graph). According to Wikipedia ("Path (graph theory)", ~ https://en.wikipedia.org/wiki/Path_(graph_theory) , 3-Oct-2017): "A path is a trail in which all vertices (except possibly the first and last) are distinct. ... use the term simple path to refer to a path which contains no repeated vertices." According to Bollobas: "... a path is a walk with distinct vertices.", see Notation of [Bollobas] p. 5. (A walk with distinct vertices is actually a simple path, see ~ upgrwlkdvspth ). Therefore, a path can be represented by an injective mapping f from { 1 , ... , n } and a mapping p from { 0 , ... , n }, which is injective restricted to the set { 1 , ... , n }, where f enumerates the (indices of the) different edges, and p enumerates the vertices. So the path is also represented by the following sequence: p(0) e(f(1)) p(1) e(f(2)) ... p(n-1) e(f(n)) p(n). (Contributed by Alexander van der Vekens and Mario Carneiro, 4-Oct-2017.) (Revised by AV, 9-Jan-2021.)
axiom df_pths {f2 g2 p: setvar}:
  $ wceq cpths (cmpt g2 cvv (copab f2 p (w3a (wbr (cv f2) (cv p) (cfv (cv g2) ctrls)) (wfun (ccnv (cres (cv p) (co c1 (cfv (cv f2) chash) cfzo)))) (wceq (cin (cima (cv p) (cpr cc0 (cfv (cv f2) chash))) (cima (cv p) (co c1 (cfv (cv f2) chash) cfzo))) c0)))) $;

--| Define the set of all simple paths (in an undirected graph). According to Wikipedia ("Path (graph theory)", ~ https://en.wikipedia.org/wiki/Path_(graph_theory) , 3-Oct-2017): "A path is a trail in which all vertices (except possibly the first and last) are distinct. ... use the term simple path to refer to a path which contains no repeated vertices." Therefore, a simple path can be represented by an injective mapping f from { 1 , ... , n } and an injective mapping p from { 0 , ... , n }, where f enumerates the (indices of the) different edges, and p enumerates the vertices. So the simple path is also represented by the following sequence: p(0) e(f(1)) p(1) e(f(2)) ... p(n-1) e(f(n)) p(n). (Contributed by Alexander van der Vekens, 20-Oct-2017.) (Revised by AV, 9-Jan-2021.)
axiom df_spths {f2 g2 p: setvar}:
  $ wceq cspths (cmpt g2 cvv (copab f2 p (wa (wbr (cv f2) (cv p) (cfv (cv g2) ctrls)) (wfun (ccnv (cv p)))))) $;

--| Define the collection of paths with particular endpoints (in an undirected graph). (Contributed by Alexander van der Vekens and Mario Carneiro, 4-Oct-2017.) (Revised by AV, 9-Jan-2021.)
axiom df_pthson {f2 g2 p a b: setvar}:
  $ wceq cpthson (cmpt g2 cvv (cmpo a b (cfv (cv g2) cvtx) (cfv (cv g2) cvtx) (copab f2 p (wa (wbr (cv f2) (cv p) (co (cv a) (cv b) (cfv (cv g2) ctrlson))) (wbr (cv f2) (cv p) (cfv (cv g2) cpths)))))) $;

--| Define the collection of simple paths with particular endpoints (in an undirected graph). (Contributed by Alexander van der Vekens, 1-Mar-2018.) (Revised by AV, 9-Jan-2021.)
axiom df_spthson {f2 g2 p a b: setvar}:
  $ wceq cspthson (cmpt g2 cvv (cmpo a b (cfv (cv g2) cvtx) (cfv (cv g2) cvtx) (copab f2 p (wa (wbr (cv f2) (cv p) (co (cv a) (cv b) (cfv (cv g2) ctrlson))) (wbr (cv f2) (cv p) (cfv (cv g2) cspths)))))) $;

--| The set ` ( Paths `` G ) ` of all paths on ` G ` is a set of pairs by our definition of a path, and so is a relation. (Contributed by AV, 30-Oct-2021.)
theorem relpths (G: class):
  $ wrel (cfv G cpths) $;

--| The set of paths (in an undirected graph). (Contributed by Alexander van der Vekens, 20-Oct-2017.) (Revised by AV, 9-Jan-2021.) (Revised by AV, 29-Oct-2021.)
theorem pthsfval {f2 p: setvar} (G: class):
  $ wceq (cfv G cpths) (copab f2 p (w3a (wbr (cv f2) (cv p) (cfv G ctrls)) (wfun (ccnv (cres (cv p) (co c1 (cfv (cv f2) chash) cfzo)))) (wceq (cin (cima (cv p) (cpr cc0 (cfv (cv f2) chash))) (cima (cv p) (co c1 (cfv (cv f2) chash) cfzo))) c0))) $;

--| The set of simple paths (in an undirected graph). (Contributed by Alexander van der Vekens, 21-Oct-2017.) (Revised by AV, 9-Jan-2021.) (Revised by AV, 29-Oct-2021.)
theorem spthsfval {f2 p: setvar} (G: class):
  $ wceq (cfv G cspths) (copab f2 p (wa (wbr (cv f2) (cv p) (cfv G ctrls)) (wfun (ccnv (cv p))))) $;

--| Conditions for a pair of classes/functions to be a path (in an undirected graph). (Contributed by Alexander van der Vekens, 21-Oct-2017.) (Revised by AV, 9-Jan-2021.) (Revised by AV, 29-Oct-2021.)
theorem ispth (P F G: class):
  $ wb (wbr F P (cfv G cpths)) (w3a (wbr F P (cfv G ctrls)) (wfun (ccnv (cres P (co c1 (cfv F chash) cfzo)))) (wceq (cin (cima P (cpr cc0 (cfv F chash))) (cima P (co c1 (cfv F chash) cfzo))) c0)) $;

--| Conditions for a pair of classes/functions to be a simple path (in an undirected graph). (Contributed by Alexander van der Vekens, 21-Oct-2017.) (Revised by AV, 9-Jan-2021.) (Revised by AV, 29-Oct-2021.)
theorem isspth (P F G: class):
  $ wb (wbr F P (cfv G cspths)) (wa (wbr F P (cfv G ctrls)) (wfun (ccnv P))) $;

--| A path is a trail (in an undirected graph). (Contributed by Alexander van der Vekens, 21-Oct-2017.) (Revised by AV, 9-Jan-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem pthistrl (P F G: class):
  $ wi (wbr F P (cfv G cpths)) (wbr F P (cfv G ctrls)) $;

--| A simple path is a path (in an undirected graph). (Contributed by Alexander van der Vekens, 21-Oct-2017.) (Revised by AV, 9-Jan-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem spthispth (P F G: class):
  $ wi (wbr F P (cfv G cspths)) (wbr F P (cfv G cpths)) $;

--| A path is a walk (in an undirected graph). (Contributed by AV, 6-Feb-2021.)
theorem pthiswlk (P F G: class):
  $ wi (wbr F P (cfv G cpths)) (wbr F P (cfv G cwlks)) $;

--| A simple path is a walk (in an undirected graph). (Contributed by AV, 16-May-2021.)
theorem spthiswlk (P F G: class):
  $ wi (wbr F P (cfv G cspths)) (wbr F P (cfv G cwlks)) $;

--| The inner vertices of a path are distinct from all other vertices. (Contributed by AV, 5-Feb-2021.) (Proof shortened by AV, 31-Oct-2021.)
theorem pthdivtx (P F G I J: class):
  $ wi (wa (wbr F P (cfv G cpths)) (w3a (wcel I (co c1 (cfv F chash) cfzo)) (wcel J (co cc0 (cfv F chash) cfz)) (wne I J))) (wne (cfv I P) (cfv J P)) $;

--| The adjacent vertices of a path of length at least 2 are distinct. (Contributed by AV, 5-Feb-2021.)
theorem pthdadjvtx (P F G I: class):
  $ wi (w3a (wbr F P (cfv G cpths)) (wbr c1 (cfv F chash) clt) (wcel I (co cc0 (cfv F chash) cfzo))) (wne (cfv I P) (cfv (co I c1 caddc) P)) $;

--| Alternate definition for a pair of classes/functions to be a path (in an undirected graph). (Contributed by AV, 4-Oct-2025.)
theorem dfpth2 (P F G: class):
  $ wb (wbr F P (cfv G cpths)) (w3a (wbr F P (cfv G ctrls)) (wfun (ccnv (cres P (co c1 (cfv F chash) cfz)))) (wnel (cfv cc0 P) (cima P (co c1 (cfv F chash) cfzo)))) $;

--| A graph containing a path has at least as many vertices as there are edges in the path. (Contributed by BTernaryTau, 5-Oct-2023.)
theorem pthhashvtx (P F G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wbr F P (cfv G cpths)) (wbr (cfv F chash) (cfv V chash) cle) $;

--| The vertices of a path are distinct (except the first and last vertex), so the restricted vertex function is one-to-one. (Contributed by AV, 2-Oct-2025.)
theorem pthdifv (P F G: class):
  $ wi (wbr F P (cfv G cpths)) (wf1 (co c1 (cfv F chash) cfz) (cfv G cvtx) (cres P (co c1 (cfv F chash) cfz))) $;

--| A path of length at least 2 does not contain a loop. In contrast, a path of length 1 can contain/be a loop, see ~ lppthon . (Contributed by AV, 6-Feb-2021.)
theorem _2pthnloop {i: setvar} (P F G I: class):
  $ wceq I (cfv G ciedg) $ >
  $ wi (wa (wbr F P (cfv G cpths)) (wbr c1 (cfv F chash) clt)) (wral i (wbr c2 (cfv (cfv (cfv (cv i) F) I) chash) cle) (co cc0 (cfv F chash) cfzo)) $;

--| A path of length at least 2 in a pseudograph does not contain a loop. (Contributed by AV, 6-Feb-2021.)
theorem upgr2pthnlp {i: setvar} (P F G I: class):
  $ wceq I (cfv G ciedg) $ >
  $ wi (w3a (wcel G cupgr) (wbr F P (cfv G cpths)) (wbr c1 (cfv F chash) clt)) (wral i (wceq (cfv (cfv (cfv (cv i) F) I) chash) c2) (co cc0 (cfv F chash) cfzo)) $;

--| The vertices of a simple path are distinct, so the vertex function is one-to-one. (Contributed by Alexander van der Vekens, 26-Jan-2018.) (Revised by AV, 5-Jun-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem spthdifv (P F G: class):
  $ wi (wbr F P (cfv G cspths)) (wf1 (co cc0 (cfv F chash) cfz) (cfv G cvtx) P) $;

--| A simple path (at least of length 1) has different start and end points (in an undirected graph). (Contributed by AV, 31-Jan-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem spthdep (P F G: class):
  $ wi (wa (wbr F P (cfv G cspths)) (wne (cfv F chash) cc0)) (wne (cfv cc0 P) (cfv (cfv F chash) P)) $;

--| A path with different start and end points is a simple path (in an undirected graph). (Contributed by Alexander van der Vekens, 31-Oct-2017.) (Revised by AV, 12-Jan-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem pthdepisspth (P F G: class):
  $ wi (wa (wbr F P (cfv G cpths)) (wne (cfv cc0 P) (cfv (cfv F chash) P))) (wbr F P (cfv G cspths)) $;

--| Lemma for ~ upgrwlkdvde . (Contributed by Alexander van der Vekens, 27-Oct-2017.) (Proof shortened by AV, 17-Jan-2021.)
theorem upgrwlkdvdelem {k: setvar} (P F I: class) (V: class k):
  $ wi (wa (wf1 (co cc0 (cfv F chash) cfz) V P) (wcel F (cword (cdm I)))) (wi (wral k (wceq (cfv (cfv (cv k) F) I) (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P))) (co cc0 (cfv F chash) cfzo)) (wfun (ccnv F))) $;

--| In a pseudograph, all edges of a walk consisting of different vertices are different. Notice that this theorem would not hold for arbitrary hypergraphs, see the counterexample given in the comment of ~ upgrspthswlk . (Contributed by AV, 17-Jan-2021.)
theorem upgrwlkdvde (P F G: class):
  $ wi (w3a (wcel G cupgr) (wbr F P (cfv G cwlks)) (wfun (ccnv P))) (wfun (ccnv F)) $;

--| The set of simple paths in a pseudograph, expressed as walk. Notice that this theorem would not hold for arbitrary hypergraphs, since a walk with distinct vertices does not need to be a trail: let E = { p_0, p_1, p_2 } be a hyperedge, then ( p_0, e, p_1, e, p_2 ) is walk with distinct vertices, but not with distinct edges. Therefore, E is not a trail and, by definition, also no path. (Contributed by AV, 11-Jan-2021.) (Proof shortened by AV, 17-Jan-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem upgrspthswlk {f2 p: setvar} (G: class):
  $ wi (wcel G cupgr) (wceq (cfv G cspths) (copab f2 p (wa (wbr (cv f2) (cv p) (cfv G cwlks)) (wfun (ccnv (cv p)))))) $;

--| A walk consisting of different vertices is a simple path. Notice that this theorem would not hold for arbitrary hypergraphs, see the counterexample given in the comment of ~ upgrspthswlk . (Contributed by Alexander van der Vekens, 27-Oct-2017.) (Revised by AV, 17-Jan-2021.)
theorem upgrwlkdvspth (P F G: class):
  $ wi (w3a (wcel G cupgr) (wbr F P (cfv G cwlks)) (wfun (ccnv P))) (wbr F P (cfv G cspths)) $;

--| The set of paths between two vertices (in an undirected graph). (Contributed by Alexander van der Vekens, 8-Nov-2017.) (Revised by AV, 16-Jan-2021.) (Revised by AV, 21-Mar-2021.)
theorem pthsonfval {f2 p: setvar} (A2 B2 G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel A2 V) (wcel B2 V)) (wceq (co A2 B2 (cfv G cpthson)) (copab f2 p (wa (wbr (cv f2) (cv p) (co A2 B2 (cfv G ctrlson))) (wbr (cv f2) (cv p) (cfv G cpths))))) $;

--| The set of simple paths between two vertices (in an undirected graph). (Contributed by Alexander van der Vekens, 1-Mar-2018.) (Revised by AV, 16-Jan-2021.) (Revised by AV, 21-Mar-2021.)
theorem spthson {f2 p: setvar} (A2 B2 G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel A2 V) (wcel B2 V)) (wceq (co A2 B2 (cfv G cspthson)) (copab f2 p (wa (wbr (cv f2) (cv p) (co A2 B2 (cfv G ctrlson))) (wbr (cv f2) (cv p) (cfv G cspths))))) $;

--| Properties of a pair of functions to be a path between two given vertices. (Contributed by Alexander van der Vekens, 8-Nov-2017.) (Revised by AV, 16-Jan-2021.) (Revised by AV, 21-Mar-2021.)
theorem ispthson (A2 B2 P U F G V Z: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wa (wcel A2 V) (wcel B2 V)) (wa (wcel F U) (wcel P Z))) (wb (wbr F P (co A2 B2 (cfv G cpthson))) (wa (wbr F P (co A2 B2 (cfv G ctrlson))) (wbr F P (cfv G cpths)))) $;

--| Properties of a pair of functions to be a simple path between two given vertices. (Contributed by Alexander van der Vekens, 1-Mar-2018.) (Revised by AV, 16-Jan-2021.) (Revised by AV, 21-Mar-2021.)
theorem isspthson (A2 B2 P U F G V Z: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wa (wcel A2 V) (wcel B2 V)) (wa (wcel F U) (wcel P Z))) (wb (wbr F P (co A2 B2 (cfv G cspthson))) (wa (wbr F P (co A2 B2 (cfv G ctrlson))) (wbr F P (cfv G cspths)))) $;

--| Properties of a path between two vertices. (Contributed by Alexander van der Vekens, 12-Dec-2017.) (Revised by AV, 16-Jan-2021.)
theorem pthsonprop (A2 B2 P F G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wbr F P (co A2 B2 (cfv G cpthson))) (w3a (w3a (wcel G cvv) (wcel A2 V) (wcel B2 V)) (wa (wcel F cvv) (wcel P cvv)) (wa (wbr F P (co A2 B2 (cfv G ctrlson))) (wbr F P (cfv G cpths)))) $;

--| Properties of a simple path between two vertices. (Contributed by Alexander van der Vekens, 1-Mar-2018.) (Revised by AV, 16-Jan-2021.)
theorem spthonprop (A2 B2 P F G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wbr F P (co A2 B2 (cfv G cspthson))) (w3a (w3a (wcel G cvv) (wcel A2 V) (wcel B2 V)) (wa (wcel F cvv) (wcel P cvv)) (wa (wbr F P (co A2 B2 (cfv G ctrlson))) (wbr F P (cfv G cspths)))) $;

--| A path between two vertices is a path. (Contributed by Alexander van der Vekens, 12-Dec-2017.) (Revised by AV, 17-Jan-2021.)
theorem pthonispth (A2 B2 P F G: class):
  $ wi (wbr F P (co A2 B2 (cfv G cpthson))) (wbr F P (cfv G cpths)) $;

--| A path between two vertices is a trail between these vertices. (Contributed by AV, 24-Jan-2021.)
theorem pthontrlon (A2 B2 P F G: class):
  $ wi (wbr F P (co A2 B2 (cfv G cpthson))) (wbr F P (co A2 B2 (cfv G ctrlson))) $;

--| A path is a path between its endpoints. (Contributed by AV, 31-Jan-2021.)
theorem pthonpth (P F G: class):
  $ wi (wbr F P (cfv G cpths)) (wbr F P (co (cfv cc0 P) (cfv (cfv F chash) P) (cfv G cpthson))) $;

--| A pair of functions is a simple path between two given vertices iff it is a simple path starting and ending at the two vertices. (Contributed by Alexander van der Vekens, 9-Mar-2018.) (Revised by AV, 17-Jan-2021.)
theorem isspthonpth (A2 B2 P F G V W Z: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wa (wcel A2 V) (wcel B2 V)) (wa (wcel F W) (wcel P Z))) (wb (wbr F P (co A2 B2 (cfv G cspthson))) (w3a (wbr F P (cfv G cspths)) (wceq (cfv cc0 P) A2) (wceq (cfv (cfv F chash) P) B2))) $;

--| A simple path between to vertices is a simple path. (Contributed by Alexander van der Vekens, 2-Mar-2018.) (Revised by AV, 18-Jan-2021.)
theorem spthonisspth (A2 B2 P F G: class):
  $ wi (wbr F P (co A2 B2 (cfv G cspthson))) (wbr F P (cfv G cspths)) $;

--| A simple path between two vertices is a path between these vertices. (Contributed by AV, 24-Jan-2021.)
theorem spthonpthon (A2 B2 P F G: class):
  $ wi (wbr F P (co A2 B2 (cfv G cspthson))) (wbr F P (co A2 B2 (cfv G cpthson))) $;

--| The endpoints of a simple path between two vertices are equal iff the path is of length 0. (Contributed by Alexander van der Vekens, 1-Mar-2018.) (Revised by AV, 18-Jan-2021.) (Proof shortened by AV, 31-Oct-2021.)
theorem spthonepeq (A2 B2 P F G: class):
  $ wi (wbr F P (co A2 B2 (cfv G cspthson))) (wb (wceq A2 B2) (wceq (cfv F chash) cc0)) $;

--| Lemma 1 for ~ uhgrwkspth . (Contributed by AV, 25-Jan-2021.)
theorem uhgrwkspthlem1 (P F G: class):
  $ wi (wa (wbr F P (cfv G cwlks)) (wceq (cfv F chash) c1)) (wfun (ccnv F)) $;

--| Lemma 2 for ~ uhgrwkspth . (Contributed by AV, 25-Jan-2021.)
theorem uhgrwkspthlem2 (A2 B2 P F G: class):
  $ wi (w3a (wbr F P (cfv G cwlks)) (wa (wceq (cfv F chash) c1) (wne A2 B2)) (wa (wceq (cfv cc0 P) A2) (wceq (cfv (cfv F chash) P) B2))) (wfun (ccnv P)) $;

--| Any walk of length 1 between two different vertices is a simple path. (Contributed by AV, 25-Jan-2021.) (Proof shortened by AV, 31-Oct-2021.) (Revised by AV, 7-Jul-2022.)
theorem uhgrwkspth (A2 B2 P F G W: class):
  $ wi (w3a (wcel G W) (wceq (cfv F chash) c1) (wne A2 B2)) (wb (wbr F P (co A2 B2 (cfv G cwlkson))) (wbr F P (co A2 B2 (cfv G cspthson)))) $;

--| The vertices and edges are pairwise different in a walk of length 2 in a simple graph. (Contributed by Alexander van der Vekens, 2-Mar-2018.) (Revised by AV, 26-Jan-2021.)
theorem usgr2wlkneq (P F G: class):
  $ wi (wa (wa (wcel G cusgr) (wbr F P (cfv G cwlks))) (wa (wceq (cfv F chash) c2) (wne (cfv cc0 P) (cfv (cfv F chash) P)))) (wa (w3a (wne (cfv cc0 P) (cfv c1 P)) (wne (cfv cc0 P) (cfv c2 P)) (wne (cfv c1 P) (cfv c2 P))) (wne (cfv cc0 F) (cfv c1 F))) $;

--| Lemma 1 for ~ usgr2wlkspth . (Contributed by Alexander van der Vekens, 2-Mar-2018.) (Revised by AV, 26-Jan-2021.)
theorem usgr2wlkspthlem1 (P F G: class):
  $ wi (wa (wbr F P (cfv G cwlks)) (w3a (wcel G cusgr) (wceq (cfv F chash) c2) (wne (cfv cc0 P) (cfv (cfv F chash) P)))) (wfun (ccnv F)) $;

--| Lemma 2 for ~ usgr2wlkspth . (Contributed by Alexander van der Vekens, 2-Mar-2018.) (Revised by AV, 27-Jan-2021.)
theorem usgr2wlkspthlem2 (P F G: class):
  $ wi (wa (wbr F P (cfv G cwlks)) (w3a (wcel G cusgr) (wceq (cfv F chash) c2) (wne (cfv cc0 P) (cfv (cfv F chash) P)))) (wfun (ccnv P)) $;

--| In a simple graph, any walk of length 2 between two different vertices is a simple path. (Contributed by Alexander van der Vekens, 2-Mar-2018.) (Revised by AV, 27-Jan-2021.) (Proof shortened by AV, 31-Oct-2021.)
theorem usgr2wlkspth (A2 B2 P F G: class):
  $ wi (w3a (wcel G cusgr) (wceq (cfv F chash) c2) (wne A2 B2)) (wb (wbr F P (co A2 B2 (cfv G cwlkson))) (wbr F P (co A2 B2 (cfv G cspthson)))) $;

--| In a simple graph, any trail of length 2 does not start and end at the same vertex. (Contributed by AV, 5-Jun-2021.) (Proof shortened by AV, 31-Oct-2021.)
theorem usgr2trlncl (P F G: class):
  $ wi (wa (wcel G cusgr) (wceq (cfv F chash) c2)) (wi (wbr F P (cfv G ctrls)) (wne (cfv cc0 P) (cfv c2 P))) $;

--| In a simple graph, any trail of length 2 is a simple path. (Contributed by AV, 5-Jun-2021.)
theorem usgr2trlspth (P F G: class):
  $ wi (wa (wcel G cusgr) (wceq (cfv F chash) c2)) (wb (wbr F P (cfv G ctrls)) (wbr F P (cfv G cspths))) $;

--| In a simple graph, any path of length 2 is a simple path. (Contributed by Alexander van der Vekens, 25-Jan-2018.) (Revised by AV, 5-Jun-2021.)
theorem usgr2pthspth (P F G: class):
  $ wi (wa (wcel G cusgr) (wceq (cfv F chash) c2)) (wb (wbr F P (cfv G cpths)) (wbr F P (cfv G cspths))) $;

--| Lemma for ~ usgr2pth . (Contributed by Alexander van der Vekens, 27-Jan-2018.) (Revised by AV, 5-Jun-2021.)
theorem usgr2pthlem {x3 y1 z i: setvar} (P F: class) (G: class i) (I: class) (V: class i):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi (w3a (wf1 (co cc0 (cfv F chash) cfzo) (cdm I) F) (wf (co cc0 (cfv F chash) cfz) V P) (wral i (wceq (cfv (cfv (cv i) F) I) (cpr (cfv (cv i) P) (cfv (co (cv i) c1 caddc) P))) (co cc0 (cfv F chash) cfzo))) (wi (wa (wcel G cusgr) (wceq (cfv F chash) c2)) (wrex x3 (wrex y1 (wrex z (wa (w3a (wceq (cfv cc0 P) (cv x3)) (wceq (cfv c1 P) (cv y1)) (wceq (cfv c2 P) (cv z))) (wa (wceq (cfv (cfv cc0 F) I) (cpr (cv x3) (cv y1))) (wceq (cfv (cfv c1 F) I) (cpr (cv y1) (cv z))))) (cdif V (cpr (cv x3) (cv y1)))) (cdif V (csn (cv x3)))) V)) $;

--| In a simple graph, there is a path of length 2 iff there are three distinct vertices so that one of them is connected to each of the two others by an edge. (Contributed by Alexander van der Vekens, 27-Jan-2018.) (Revised by AV, 5-Jun-2021.) (Proof shortened by AV, 31-Oct-2021.)
theorem usgr2pth {x3 y1 z: setvar} (P F G I V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi (wcel G cusgr) (wb (wa (wbr F P (cfv G cpths)) (wceq (cfv F chash) c2)) (w3a (wf1 (co cc0 c2 cfzo) (cdm I) F) (wf1 (co cc0 c2 cfz) V P) (wrex x3 (wrex y1 (wrex z (wa (w3a (wceq (cfv cc0 P) (cv x3)) (wceq (cfv c1 P) (cv y1)) (wceq (cfv c2 P) (cv z))) (wa (wceq (cfv (cfv cc0 F) I) (cpr (cv x3) (cv y1))) (wceq (cfv (cfv c1 F) I) (cpr (cv y1) (cv z))))) (cdif V (cpr (cv x3) (cv y1)))) (cdif V (csn (cv x3)))) V))) $;

--| In a simply graph, there is a path of length 2 iff there are three distinct vertices so that one of them is connected to each of the two others by an edge. (Contributed by Alexander van der Vekens, 27-Jan-2018.) (Revised by AV, 5-Jun-2021.)
theorem usgr2pth0 {x3 y1 z: setvar} (P F G I V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi (wcel G cusgr) (wb (wa (wbr F P (cfv G cpths)) (wceq (cfv F chash) c2)) (w3a (wf1 (co cc0 c2 cfzo) (cdm I) F) (wf1 (co cc0 c2 cfz) V P) (wrex x3 (wrex y1 (wrex z (wa (w3a (wceq (cfv cc0 P) (cv x3)) (wceq (cfv c1 P) (cv z)) (wceq (cfv c2 P) (cv y1))) (wa (wceq (cfv (cfv cc0 F) I) (cpr (cv x3) (cv z))) (wceq (cfv (cfv c1 F) I) (cpr (cv z) (cv y1))))) (cdif V (cpr (cv x3) (cv y1)))) (cdif V (csn (cv x3)))) V))) $;

--| Lemma 1 for ~ pthd . (Contributed by Alexander van der Vekens, 13-Nov-2017.) (Revised by AV, 9-Feb-2021.)
theorem pthdlem1 {i j: setvar} (ph: wff) (P R: class):
  $ wi ph (wcel P (cword cvv)) $ >
  $ wceq R (co (cfv P chash) c1 cmin) $ >
  $ wi ph (wral i (wral j (wi (wne (cv i) (cv j)) (wne (cfv (cv i) P) (cfv (cv j) P))) (co c1 R cfzo)) (co cc0 (cfv P chash) cfzo)) $ >
  $ wi ph (wfun (ccnv (cres P (co c1 R cfzo)))) $;

--| Lemma for ~ pthdlem2 . (Contributed by AV, 10-Feb-2021.)
theorem pthdlem2lem {i j: setvar} (ph: wff) (P R I: class):
  $ wi ph (wcel P (cword cvv)) $ >
  $ wceq R (co (cfv P chash) c1 cmin) $ >
  $ wi ph (wral i (wral j (wi (wne (cv i) (cv j)) (wne (cfv (cv i) P) (cfv (cv j) P))) (co c1 R cfzo)) (co cc0 (cfv P chash) cfzo)) $ >
  $ wi (w3a ph (wcel (cfv P chash) cn) (wo (wceq I cc0) (wceq I R))) (wnel (cfv I P) (cima P (co c1 R cfzo))) $;

--| Lemma 2 for ~ pthd . (Contributed by Alexander van der Vekens, 11-Nov-2017.) (Revised by AV, 10-Feb-2021.)
theorem pthdlem2 {i j: setvar} (ph: wff) (P R: class):
  $ wi ph (wcel P (cword cvv)) $ >
  $ wceq R (co (cfv P chash) c1 cmin) $ >
  $ wi ph (wral i (wral j (wi (wne (cv i) (cv j)) (wne (cfv (cv i) P) (cfv (cv j) P))) (co c1 R cfzo)) (co cc0 (cfv P chash) cfzo)) $ >
  $ wi ph (wceq (cin (cima P (cpr cc0 R)) (cima P (co c1 R cfzo))) c0) $;

--| Two words representing a trail which also represent a path in a graph. (Contributed by AV, 10-Feb-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem pthd {i j: setvar} (ph: wff) (P R F: class) (G: class i j):
  $ wi ph (wcel P (cword cvv)) $ >
  $ wceq R (co (cfv P chash) c1 cmin) $ >
  $ wi ph (wral i (wral j (wi (wne (cv i) (cv j)) (wne (cfv (cv i) P) (cfv (cv j) P))) (co c1 R cfzo)) (co cc0 (cfv P chash) cfzo)) $ >
  $ wceq (cfv F chash) R $ >
  $ wi ph (wbr F P (cfv G ctrls)) $ >
  $ wi ph (wbr F P (cfv G cpths)) $;

--| If a path exists in a subgraph of a graph ` G ` , then that path also exists in ` G ` . (Contributed by BTernaryTau, 22-Oct-2023.)
theorem subgrpth (P S F G: class):
  $ wi (wbr S G csubgr) (wi (wbr F P (cfv S cpths)) (wbr F P (cfv G cpths))) $;

--| Extend class notation with closed walks (of a graph).
term cclwlks: class;

--| Define the set of all closed walks (in an undirected graph). According to definition 4 in [Huneke] p. 2: "A walk of length n on (a graph) G is an ordered sequence v0 , v1 , ... v(n) of vertices such that v(i) and v(i+1) are neighbors (i.e are connected by an edge). We say the walk is closed if v(n) = v0". According to the definition of a walk as two mappings f from { 0 , ... , ( n - 1 ) } and p from { 0 , ... , n }, where f enumerates the (indices of the) edges, and p enumerates the vertices, a closed walk is represented by the following sequence: p(0) e(f(0)) p(1) e(f(1)) ... p(n-1) e(f(n-1)) p(n)=p(0). Notice that by this definition, a single vertex can be considered as a closed walk of length 0, see also ~ 0clwlk . (Contributed by Alexander van der Vekens, 12-Mar-2018.) (Revised by AV, 16-Feb-2021.)
axiom df_clwlks {f2 g2 p: setvar}:
  $ wceq cclwlks (cmpt g2 cvv (copab f2 p (wa (wbr (cv f2) (cv p) (cfv (cv g2) cwlks)) (wceq (cfv cc0 (cv p)) (cfv (cfv (cv f2) chash) (cv p)))))) $;

--| The set of closed walks (in an undirected graph). (Contributed by Alexander van der Vekens, 15-Mar-2018.) (Revised by AV, 16-Feb-2021.) (Revised by AV, 29-Oct-2021.)
theorem clwlks {f2 p: setvar} (G: class):
  $ wceq (cfv G cclwlks) (copab f2 p (wa (wbr (cv f2) (cv p) (cfv G cwlks)) (wceq (cfv cc0 (cv p)) (cfv (cfv (cv f2) chash) (cv p))))) $;

--| A pair of functions represents a closed walk iff it represents a walk in which the first vertex is equal to the last vertex. (Contributed by Alexander van der Vekens, 24-Jun-2018.) (Revised by AV, 16-Feb-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem isclwlk (P F G: class):
  $ wb (wbr F P (cfv G cclwlks)) (wa (wbr F P (cfv G cwlks)) (wceq (cfv cc0 P) (cfv (cfv F chash) P))) $;

--| A closed walk is a walk (in an undirected graph). (Contributed by Alexander van der Vekens, 15-Mar-2018.) (Revised by AV, 16-Feb-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem clwlkiswlk (P F G: class):
  $ wi (wbr F P (cfv G cclwlks)) (wbr F P (cfv G cwlks)) $;

--| Closed walks are walks (in an undirected graph). (Contributed by Alexander van der Vekens, 23-Jun-2018.) (Revised by AV, 16-Feb-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem clwlkwlk (G W: class):
  $ wi (wcel W (cfv G cclwlks)) (wcel W (cfv G cwlks)) $;

--| Closed walks are walks (in an undirected graph). (Contributed by Alexander van der Vekens, 25-Aug-2018.) (Revised by AV, 16-Feb-2021.)
theorem clwlkswks (G: class):
  $ wss (cfv G cclwlks) (cfv G cwlks) $;

--| Properties of a pair of functions to be a closed walk (in an undirected graph). (Contributed by Alexander van der Vekens, 24-Jun-2018.) (Revised by AV, 16-Feb-2021.)
theorem isclwlke {k: setvar} (P F G: class) (I V X: class k):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi (wcel G X) (wb (wbr F P (cfv G cclwlks)) (wa (wa (wcel F (cword (cdm I))) (wf (co cc0 (cfv F chash) cfz) V P)) (wa (wral k (wif (wceq (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (wceq (cfv (cfv (cv k) F) I) (csn (cfv (cv k) P))) (wss (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (cfv (cfv (cv k) F) I))) (co cc0 (cfv F chash) cfzo)) (wceq (cfv cc0 P) (cfv (cfv F chash) P))))) $;

--| Properties of a pair of functions to be a closed walk (in a pseudograph). (Contributed by Alexander van der Vekens, 24-Jun-2018.) (Revised by AV, 11-Apr-2021.) (Revised by AV, 28-Oct-2021.)
theorem isclwlkupgr {k: setvar} (P F G I V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi (wcel G cupgr) (wb (wbr F P (cfv G cclwlks)) (wa (wa (wcel F (cword (cdm I))) (wf (co cc0 (cfv F chash) cfz) V P)) (wa (wral k (wceq (cfv (cfv (cv k) F) I) (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P))) (co cc0 (cfv F chash) cfzo)) (wceq (cfv cc0 P) (cfv (cfv F chash) P))))) $;

--| A closed walk expressed by properties of its components. (Contributed by Alexander van der Vekens, 24-Jun-2018.) (Revised by AV, 17-Feb-2021.)
theorem clwlkcomp {k: setvar} (P: class) (S T: class k) (F G I V: class) (W X: class k):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq F (cfv W c1st) $ >
  $ wceq P (cfv W c2nd) $ >
  $ wi (wa (wcel G X) (wcel W (cxp S T))) (wb (wcel W (cfv G cclwlks)) (wa (wa (wcel F (cword (cdm I))) (wf (co cc0 (cfv F chash) cfz) V P)) (wa (wral k (wif (wceq (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (wceq (cfv (cfv (cv k) F) I) (csn (cfv (cv k) P))) (wss (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (cfv (cfv (cv k) F) I))) (co cc0 (cfv F chash) cfzo)) (wceq (cfv cc0 P) (cfv (cfv F chash) P))))) $;

--| Implications for the properties of the components of a closed walk. (Contributed by Alexander van der Vekens, 24-Jun-2018.) (Revised by AV, 17-Feb-2021.)
theorem clwlkcompim {k: setvar} (P F G I V: class) (W: class k):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq F (cfv W c1st) $ >
  $ wceq P (cfv W c2nd) $ >
  $ wi (wcel W (cfv G cclwlks)) (wa (wa (wcel F (cword (cdm I))) (wf (co cc0 (cfv F chash) cfz) V P)) (wa (wral k (wif (wceq (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (wceq (cfv (cfv (cv k) F) I) (csn (cfv (cv k) P))) (wss (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (cfv (cfv (cv k) F) I))) (co cc0 (cfv F chash) cfzo)) (wceq (cfv cc0 P) (cfv (cfv F chash) P)))) $;

--| Implications for the properties of the components of a closed walk in a pseudograph. (Contributed by Alexander van der Vekens, 24-Jun-2018.) (Revised by AV, 2-May-2021.)
theorem upgrclwlkcompim {k: setvar} (P F G I V: class) (W: class k):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq F (cfv W c1st) $ >
  $ wceq P (cfv W c2nd) $ >
  $ wi (wa (wcel G cupgr) (wcel W (cfv G cclwlks))) (w3a (wa (wcel F (cword (cdm I))) (wf (co cc0 (cfv F chash) cfz) V P)) (wral k (wceq (cfv (cfv (cv k) F) I) (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P))) (co cc0 (cfv F chash) cfzo)) (wceq (cfv cc0 P) (cfv (cfv F chash) P))) $;

--| Basic properties of the components of a closed walk. (Contributed by AV, 23-May-2022.)
theorem clwlkcompbp (P F G W: class):
  $ wceq F (cfv W c1st) $ >
  $ wceq P (cfv W c2nd) $ >
  $ wi (wcel W (cfv G cclwlks)) (wa (wbr F P (cfv G cwlks)) (wceq (cfv cc0 P) (cfv (cfv F chash) P))) $;

--| A closed walk of length 1 is a loop. (Contributed by AV, 22-Apr-2021.)
theorem clwlkl1loop (P F G: class):
  $ wi (w3a (wfun (cfv G ciedg)) (wbr F P (cfv G cclwlks)) (wceq (cfv F chash) c1)) (wa (wceq (cfv cc0 P) (cfv c1 P)) (wcel (csn (cfv cc0 P)) (cfv G cedg))) $;

--| Extend class notation with circuits (in a graph).
term ccrcts: class;

--| Extend class notation with cycles (in a graph).
term ccycls: class;

--| Define the set of all circuits (in an undirected graph). According to Wikipedia ("Cycle (graph theory)", ~ https://en.wikipedia.org/wiki/Cycle_(graph_theory) , 3-Oct-2017): "A circuit can be a closed walk allowing repetitions of vertices but not edges"; according to Wikipedia ("Glossary of graph theory terms", ~ https://en.wikipedia.org/wiki/Glossary_of_graph_theory_terms, 3-Oct-2017): "A circuit may refer to ... a trail (a closed tour without repeated edges), ...". Following Bollobas ("A trail whose endvertices coincide (a closed trail) is called a circuit.", see Definition of [Bollobas] p. 5.), a circuit is a closed trail without repeated edges. So the circuit is also represented by the following sequence: p(0) e(f(1)) p(1) e(f(2)) ... p(n-1) e(f(n)) p(n)=p(0). (Contributed by Alexander van der Vekens, 3-Oct-2017.) (Revised by AV, 31-Jan-2021.)
axiom df_crcts {f2 g2 p: setvar}:
  $ wceq ccrcts (cmpt g2 cvv (copab f2 p (wa (wbr (cv f2) (cv p) (cfv (cv g2) ctrls)) (wceq (cfv cc0 (cv p)) (cfv (cfv (cv f2) chash) (cv p)))))) $;

--| Define the set of all (simple) cycles (in an undirected graph). According to Wikipedia ("Cycle (graph theory)", ~ https://en.wikipedia.org/wiki/Cycle_(graph_theory) , 3-Oct-2017): "A simple cycle may be defined either as a closed walk with no repetitions of vertices and edges allowed, other than the repetition of the starting and ending vertex." According to Bollobas: "If a walk W = x0 x1 ... x(l) is such that l >= 3, x0=x(l), and the vertices x(i), 0 < i < l, are distinct from each other and x0, then W is said to be a cycle." See Definition of [Bollobas] p. 5. However, since a walk consisting of distinct vertices (except the first and the last vertex) is a path, a cycle can be defined as path whose first and last vertices coincide. So a cycle is represented by the following sequence: p(0) e(f(1)) p(1) ... p(n-1) e(f(n)) p(n)=p(0). (Contributed by Alexander van der Vekens, 3-Oct-2017.) (Revised by AV, 31-Jan-2021.)
axiom df_cycls {f2 g2 p: setvar}:
  $ wceq ccycls (cmpt g2 cvv (copab f2 p (wa (wbr (cv f2) (cv p) (cfv (cv g2) cpths)) (wceq (cfv cc0 (cv p)) (cfv (cfv (cv f2) chash) (cv p)))))) $;

--| The set of circuits (in an undirected graph). (Contributed by Alexander van der Vekens, 30-Oct-2017.) (Revised by AV, 31-Jan-2021.)
theorem crcts {f2 p: setvar} (G: class):
  $ wceq (cfv G ccrcts) (copab f2 p (wa (wbr (cv f2) (cv p) (cfv G ctrls)) (wceq (cfv cc0 (cv p)) (cfv (cfv (cv f2) chash) (cv p))))) $;

--| The set of cycles (in an undirected graph). (Contributed by Alexander van der Vekens, 30-Oct-2017.) (Revised by AV, 31-Jan-2021.)
theorem cycls {f2 p: setvar} (G: class):
  $ wceq (cfv G ccycls) (copab f2 p (wa (wbr (cv f2) (cv p) (cfv G cpths)) (wceq (cfv cc0 (cv p)) (cfv (cfv (cv f2) chash) (cv p))))) $;

--| Sufficient and necessary conditions for a pair of functions to be a circuit (in an undirected graph): A pair of function "is" (represents) a circuit iff it is a closed trail. (Contributed by Alexander van der Vekens, 30-Oct-2017.) (Revised by AV, 31-Jan-2021.) (Revised by AV, 30-Oct-2021.)
theorem iscrct (P F G: class):
  $ wb (wbr F P (cfv G ccrcts)) (wa (wbr F P (cfv G ctrls)) (wceq (cfv cc0 P) (cfv (cfv F chash) P))) $;

--| Sufficient and necessary conditions for a pair of functions to be a cycle (in an undirected graph): A pair of function "is" (represents) a cycle iff it is a closed path. (Contributed by Alexander van der Vekens, 30-Oct-2017.) (Revised by AV, 31-Jan-2021.) (Revised by AV, 30-Oct-2021.)
theorem iscycl (P F G: class):
  $ wb (wbr F P (cfv G ccycls)) (wa (wbr F P (cfv G cpths)) (wceq (cfv cc0 P) (cfv (cfv F chash) P))) $;

--| The properties of a circuit: A circuit is a closed trail. (Contributed by AV, 31-Jan-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem crctprop (P F G: class):
  $ wi (wbr F P (cfv G ccrcts)) (wa (wbr F P (cfv G ctrls)) (wceq (cfv cc0 P) (cfv (cfv F chash) P))) $;

--| The properties of a cycle: A cycle is a closed path. (Contributed by AV, 31-Jan-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem cyclprop (P F G: class):
  $ wi (wbr F P (cfv G ccycls)) (wa (wbr F P (cfv G cpths)) (wceq (cfv cc0 P) (cfv (cfv F chash) P))) $;

--| A circuit is a closed walk. (Contributed by AV, 17-Feb-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem crctisclwlk (P F G: class):
  $ wi (wbr F P (cfv G ccrcts)) (wbr F P (cfv G cclwlks)) $;

--| A circuit is a trail. (Contributed by Alexander van der Vekens, 30-Oct-2017.) (Revised by AV, 31-Jan-2021.)
theorem crctistrl (P F G: class):
  $ wi (wbr F P (cfv G ccrcts)) (wbr F P (cfv G ctrls)) $;

--| A circuit is a walk. (Contributed by AV, 6-Apr-2021.)
theorem crctiswlk (P F G: class):
  $ wi (wbr F P (cfv G ccrcts)) (wbr F P (cfv G cwlks)) $;

--| A cycle is a path. (Contributed by Alexander van der Vekens, 30-Oct-2017.) (Revised by AV, 31-Jan-2021.)
theorem cyclispth (P F G: class):
  $ wi (wbr F P (cfv G ccycls)) (wbr F P (cfv G cpths)) $;

--| If a cycle exists in a subgraph of a graph ` G ` , then that cycle also exists in ` G ` . (Contributed by BTernaryTau, 23-Oct-2023.)
theorem subgrcycl (P S F G: class):
  $ wi (wbr S G csubgr) (wi (wbr F P (cfv S ccycls)) (wbr F P (cfv G ccycls))) $;

--| A cycle is a walk. (Contributed by Alexander van der Vekens, 7-Nov-2017.) (Revised by AV, 31-Jan-2021.)
theorem cycliswlk (P F G: class):
  $ wi (wbr F P (cfv G ccycls)) (wbr F P (cfv G cwlks)) $;

--| A cycle is a circuit. (Contributed by Alexander van der Vekens, 30-Oct-2017.) (Revised by AV, 31-Jan-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem cycliscrct (P F G: class):
  $ wi (wbr F P (cfv G ccycls)) (wbr F P (cfv G ccrcts)) $;

--| The number of vertices of a (non-trivial) cycle is the number of edges in the cycle. (Contributed by AV, 5-Oct-2025.)
theorem cyclnumvtx (P F G: class):
  $ wi (wa (wbr c1 (cfv F chash) cle) (wbr F P (cfv G ccycls))) (wceq (cfv (crn P) chash) (cfv F chash)) $;

--| A (non-trivial) cycle is not a simple path. (Contributed by Alexander van der Vekens, 30-Oct-2017.) (Revised by AV, 31-Jan-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem cyclnspth (P F G: class):
  $ wi (wne F c0) (wi (wbr F P (cfv G ccycls)) (wn (wbr F P (cfv G cspths)))) $;

--| A path is either a simple path or a cycle (or both). (Contributed by BTernaryTau, 20-Oct-2023.)
theorem pthisspthorcycl (P F G: class):
  $ wi (wbr F P (cfv G cpths)) (wo (wbr F P (cfv G cspths)) (wbr F P (cfv G ccycls))) $;

--| A pair ` <. F , P >. ` represents a path if it represents either a simple path or a cycle. The exclusivity only holds for non-trivial paths ( ` F =/= (/) ` ), see ~ cyclnspth . (Contributed by AV, 2-Oct-2025.)
theorem pthspthcyc (P F G: class):
  $ wb (wbr F P (cfv G cpths)) (wo (wbr F P (cfv G cspths)) (wbr F P (cfv G ccycls))) $;

--| A walk is a trivial path if and only if it is both a simple path and a cycle. (Contributed by BTernaryTau, 8-Oct-2023.)
theorem spthcycl (P F G: class):
  $ wb (wa (wbr F P (cfv G cpths)) (wceq F c0)) (wa (wbr F P (cfv G cspths)) (wbr F P (cfv G ccycls))) $;

--| A cycle is a path starting and ending at its first vertex. (Contributed by Alexander van der Vekens, 8-Nov-2017.) (Revised by AV, 31-Jan-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem cyclispthon (P F G: class):
  $ wi (wbr F P (cfv G ccycls)) (wbr F P (co (cfv cc0 P) (cfv cc0 P) (cfv G cpthson))) $;

--| In a loop-free graph there are no cycles with length 1 (consisting of one edge). (Contributed by Alexander van der Vekens, 7-Nov-2017.) (Revised by AV, 2-Feb-2021.)
theorem lfgrn1cycl {x3: setvar} (P: class x3) (F: class) (G: class x3) (I V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi (wf (cdm I) (crab x3 (wbr c2 (cfv (cv x3) chash) cle) (cpw V)) I) (wi (wbr F P (cfv G ccycls)) (wne (cfv F chash) c1)) $;

--| In a simple graph, any trail of length 2 is not a circuit. (Contributed by AV, 5-Jun-2021.)
theorem usgr2trlncrct (P F G: class):
  $ wi (wa (wcel G cusgr) (wceq (cfv F chash) c2)) (wi (wbr F P (cfv G ctrls)) (wn (wbr F P (cfv G ccrcts)))) $;

--| In a multigraph graph (with no loops!) there are no cycles with length 1 (consisting of one edge). (Contributed by Alexander van der Vekens, 7-Nov-2017.) (Revised by AV, 2-Feb-2021.)
theorem umgrn1cycl (P F G: class):
  $ wi (wa (wcel G cumgr) (wbr F P (cfv G ccycls))) (wne (cfv F chash) c1) $;

--| In a simple pseudograph there are no circuits with length 2 (consisting of two edges). (Contributed by Alexander van der Vekens, 9-Nov-2017.) (Revised by AV, 3-Feb-2021.) (Proof shortened by AV, 31-Oct-2021.)
theorem uspgrn2crct (P F G: class):
  $ wi (wa (wcel G cuspgr) (wbr F P (cfv G ccrcts))) (wne (cfv F chash) c2) $;

--| In a simple graph there are no cycles with length 2 (consisting of two edges). (Contributed by Alexander van der Vekens, 9-Nov-2017.) (Revised by AV, 4-Feb-2021.)
theorem usgrn2cycl (P F G: class):
  $ wi (wa (wcel G cusgr) (wbr F P (cfv G ccycls))) (wne (cfv F chash) c2) $;

--| Lemma for ~ crctcshwlkn0 . (Contributed by AV, 13-Mar-2021.)
theorem crctcshwlkn0lem1 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cn)) (wbr (co (co A2 B2 cmin) c1 caddc) A2 cle) $;

--| Lemma for ~ crctcshwlkn0 . (Contributed by AV, 12-Mar-2021.)
theorem crctcshwlkn0lem2 {x3: setvar} (ph: wff) (P: class) (Q: class x3) (S J N: class):
  $ wi ph (wcel S (co c1 N cfzo)) $ >
  $ wceq Q (cmpt x3 (co cc0 N cfz) (cif (wbr (cv x3) (co N S cmin) cle) (cfv (co (cv x3) S caddc) P) (cfv (co (co (cv x3) S caddc) N cmin) P))) $ >
  $ wi (wa ph (wcel J (co cc0 (co N S cmin) cfz))) (wceq (cfv J Q) (cfv (co J S caddc) P)) $;

--| Lemma for ~ crctcshwlkn0 . (Contributed by AV, 12-Mar-2021.)
theorem crctcshwlkn0lem3 {x3: setvar} (ph: wff) (P: class) (Q: class x3) (S J N: class):
  $ wi ph (wcel S (co c1 N cfzo)) $ >
  $ wceq Q (cmpt x3 (co cc0 N cfz) (cif (wbr (cv x3) (co N S cmin) cle) (cfv (co (cv x3) S caddc) P) (cfv (co (co (cv x3) S caddc) N cmin) P))) $ >
  $ wi (wa ph (wcel J (co (co (co N S cmin) c1 caddc) N cfz))) (wceq (cfv J Q) (cfv (co (co J S caddc) N cmin) P)) $;

--| Lemma for ~ crctcshwlkn0 . (Contributed by AV, 12-Mar-2021.)
theorem crctcshwlkn0lem4 {x3 i j: setvar} (ph: wff) (A2: class x3 i j) (P: class j) (Q: class x3 i j) (S: class j) (F: class x3 j) (H: class x3 i j) (I: class x3 j) (N: class j):
  $ wi ph (wcel S (co c1 N cfzo)) $ >
  $ wceq Q (cmpt x3 (co cc0 N cfz) (cif (wbr (cv x3) (co N S cmin) cle) (cfv (co (cv x3) S caddc) P) (cfv (co (co (cv x3) S caddc) N cmin) P))) $ >
  $ wceq H (co F S ccsh) $ >
  $ wceq N (cfv F chash) $ >
  $ wi ph (wcel F (cword A2)) $ >
  $ wi ph (wral i (wif (wceq (cfv (cv i) P) (cfv (co (cv i) c1 caddc) P)) (wceq (cfv (cfv (cv i) F) I) (csn (cfv (cv i) P))) (wss (cpr (cfv (cv i) P) (cfv (co (cv i) c1 caddc) P)) (cfv (cfv (cv i) F) I))) (co cc0 N cfzo)) $ >
  $ wi ph (wral j (wif (wceq (cfv (cv j) Q) (cfv (co (cv j) c1 caddc) Q)) (wceq (cfv (cfv (cv j) H) I) (csn (cfv (cv j) Q))) (wss (cpr (cfv (cv j) Q) (cfv (co (cv j) c1 caddc) Q)) (cfv (cfv (cv j) H) I))) (co cc0 (co N S cmin) cfzo)) $;

--| Lemma for ~ crctcshwlkn0 . (Contributed by AV, 12-Mar-2021.)
theorem crctcshwlkn0lem5 {x3 i j: setvar} (ph: wff) (A2: class x3 i j) (P: class j) (Q: class x3 i j) (S: class j) (F: class x3 j) (H: class x3 i j) (I: class x3 j) (N: class j):
  $ wi ph (wcel S (co c1 N cfzo)) $ >
  $ wceq Q (cmpt x3 (co cc0 N cfz) (cif (wbr (cv x3) (co N S cmin) cle) (cfv (co (cv x3) S caddc) P) (cfv (co (co (cv x3) S caddc) N cmin) P))) $ >
  $ wceq H (co F S ccsh) $ >
  $ wceq N (cfv F chash) $ >
  $ wi ph (wcel F (cword A2)) $ >
  $ wi ph (wral i (wif (wceq (cfv (cv i) P) (cfv (co (cv i) c1 caddc) P)) (wceq (cfv (cfv (cv i) F) I) (csn (cfv (cv i) P))) (wss (cpr (cfv (cv i) P) (cfv (co (cv i) c1 caddc) P)) (cfv (cfv (cv i) F) I))) (co cc0 N cfzo)) $ >
  $ wi ph (wral j (wif (wceq (cfv (cv j) Q) (cfv (co (cv j) c1 caddc) Q)) (wceq (cfv (cfv (cv j) H) I) (csn (cfv (cv j) Q))) (wss (cpr (cfv (cv j) Q) (cfv (co (cv j) c1 caddc) Q)) (cfv (cfv (cv j) H) I))) (co (co (co N S cmin) c1 caddc) N cfzo)) $;

--| Lemma for ~ crctcshwlkn0 . (Contributed by AV, 12-Mar-2021.)
theorem crctcshwlkn0lem6 {x3 i: setvar} (ph: wff) (A2: class x3 i) (P: class) (Q: class x3 i) (S: class) (F: class x3) (H: class x3 i) (I: class x3) (J: class i) (N: class):
  $ wi ph (wcel S (co c1 N cfzo)) $ >
  $ wceq Q (cmpt x3 (co cc0 N cfz) (cif (wbr (cv x3) (co N S cmin) cle) (cfv (co (cv x3) S caddc) P) (cfv (co (co (cv x3) S caddc) N cmin) P))) $ >
  $ wceq H (co F S ccsh) $ >
  $ wceq N (cfv F chash) $ >
  $ wi ph (wcel F (cword A2)) $ >
  $ wi ph (wral i (wif (wceq (cfv (cv i) P) (cfv (co (cv i) c1 caddc) P)) (wceq (cfv (cfv (cv i) F) I) (csn (cfv (cv i) P))) (wss (cpr (cfv (cv i) P) (cfv (co (cv i) c1 caddc) P)) (cfv (cfv (cv i) F) I))) (co cc0 N cfzo)) $ >
  $ wi ph (wceq (cfv N P) (cfv cc0 P)) $ >
  $ wi (wa ph (wceq J (co N S cmin))) (wif (wceq (cfv J Q) (cfv (co J c1 caddc) Q)) (wceq (cfv (cfv J H) I) (csn (cfv J Q))) (wss (cpr (cfv J Q) (cfv (co J c1 caddc) Q)) (cfv (cfv J H) I))) $;

--| Lemma for ~ crctcshwlkn0 . (Contributed by AV, 12-Mar-2021.)
theorem crctcshwlkn0lem7 {x3 i j: setvar} (ph: wff) (A2: class x3 i j) (P: class j) (Q: class x3 i) (S: class) (F: class x3 j) (H: class x3 i) (I: class x3) (N: class):
  $ wi ph (wcel S (co c1 N cfzo)) $ >
  $ wceq Q (cmpt x3 (co cc0 N cfz) (cif (wbr (cv x3) (co N S cmin) cle) (cfv (co (cv x3) S caddc) P) (cfv (co (co (cv x3) S caddc) N cmin) P))) $ >
  $ wceq H (co F S ccsh) $ >
  $ wceq N (cfv F chash) $ >
  $ wi ph (wcel F (cword A2)) $ >
  $ wi ph (wral i (wif (wceq (cfv (cv i) P) (cfv (co (cv i) c1 caddc) P)) (wceq (cfv (cfv (cv i) F) I) (csn (cfv (cv i) P))) (wss (cpr (cfv (cv i) P) (cfv (co (cv i) c1 caddc) P)) (cfv (cfv (cv i) F) I))) (co cc0 N cfzo)) $ >
  $ wi ph (wceq (cfv N P) (cfv cc0 P)) $ >
  $ wi ph (wral j (wif (wceq (cfv (cv j) Q) (cfv (co (cv j) c1 caddc) Q)) (wceq (cfv (cfv (cv j) H) I) (csn (cfv (cv j) Q))) (wss (cpr (cfv (cv j) Q) (cfv (co (cv j) c1 caddc) Q)) (cfv (cfv (cv j) H) I))) (co cc0 N cfzo)) $;

--| Lemma for ~ crctcsh . (Contributed by AV, 10-Mar-2021.)
theorem crctcshlem1 (ph: wff) (P F G I N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wbr F P (cfv G ccrcts)) $ >
  $ wceq N (cfv F chash) $ >
  $ wi ph (wcel N cn0) $;

--| Lemma for ~ crctcsh . (Contributed by AV, 10-Mar-2021.)
theorem crctcshlem2 (ph: wff) (P S F G H I N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wbr F P (cfv G ccrcts)) $ >
  $ wceq N (cfv F chash) $ >
  $ wi ph (wcel S (co cc0 N cfzo)) $ >
  $ wceq H (co F S ccsh) $ >
  $ wi ph (wceq (cfv H chash) N) $;

--| Lemma for ~ crctcsh . (Contributed by AV, 10-Mar-2021.)
theorem crctcshlem3 {x3: setvar} (ph: wff x3) (P Q S F G H I: class x3) (N: class) (V: class x3):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wbr F P (cfv G ccrcts)) $ >
  $ wceq N (cfv F chash) $ >
  $ wi ph (wcel S (co cc0 N cfzo)) $ >
  $ wceq H (co F S ccsh) $ >
  $ wceq Q (cmpt x3 (co cc0 N cfz) (cif (wbr (cv x3) (co N S cmin) cle) (cfv (co (cv x3) S caddc) P) (cfv (co (co (cv x3) S caddc) N cmin) P))) $ >
  $ wi ph (w3a (wcel G cvv) (wcel H cvv) (wcel Q cvv)) $;

--| Lemma for ~ crctcsh . (Contributed by AV, 10-Mar-2021.)
theorem crctcshlem4 {x3: setvar} (ph: wff) (P: class) (Q: class x3) (S: class) (F G H I: class x3) (N: class) (V: class x3):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wbr F P (cfv G ccrcts)) $ >
  $ wceq N (cfv F chash) $ >
  $ wi ph (wcel S (co cc0 N cfzo)) $ >
  $ wceq H (co F S ccsh) $ >
  $ wceq Q (cmpt x3 (co cc0 N cfz) (cif (wbr (cv x3) (co N S cmin) cle) (cfv (co (cv x3) S caddc) P) (cfv (co (co (cv x3) S caddc) N cmin) P))) $ >
  $ wi (wa ph (wceq S cc0)) (wa (wceq H F) (wceq Q P)) $;

--| Cyclically shifting the indices of a circuit ` <. F , P >. ` results in a walk ` <. H , Q >. ` . (Contributed by AV, 10-Mar-2021.)
theorem crctcshwlkn0 {x3: setvar} (ph: wff) (P: class) (Q: class x3) (S F: class) (G H: class x3) (I N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wbr F P (cfv G ccrcts)) $ >
  $ wceq N (cfv F chash) $ >
  $ wi ph (wcel S (co cc0 N cfzo)) $ >
  $ wceq H (co F S ccsh) $ >
  $ wceq Q (cmpt x3 (co cc0 N cfz) (cif (wbr (cv x3) (co N S cmin) cle) (cfv (co (cv x3) S caddc) P) (cfv (co (co (cv x3) S caddc) N cmin) P))) $ >
  $ wi (wa ph (wne S cc0)) (wbr H Q (cfv G cwlks)) $;

--| Cyclically shifting the indices of a circuit ` <. F , P >. ` results in a walk ` <. H , Q >. ` . (Contributed by AV, 10-Mar-2021.)
theorem crctcshwlk {x3: setvar} (ph: wff) (P: class) (Q: class x3) (S F: class) (G H: class x3) (I N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wbr F P (cfv G ccrcts)) $ >
  $ wceq N (cfv F chash) $ >
  $ wi ph (wcel S (co cc0 N cfzo)) $ >
  $ wceq H (co F S ccsh) $ >
  $ wceq Q (cmpt x3 (co cc0 N cfz) (cif (wbr (cv x3) (co N S cmin) cle) (cfv (co (cv x3) S caddc) P) (cfv (co (co (cv x3) S caddc) N cmin) P))) $ >
  $ wi ph (wbr H Q (cfv G cwlks)) $;

--| Cyclically shifting the indices of a circuit ` <. F , P >. ` results in a trail ` <. H , Q >. ` . (Contributed by AV, 14-Mar-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem crctcshtrl {x3: setvar} (ph: wff) (P: class) (Q: class x3) (S F: class) (G H: class x3) (I N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wbr F P (cfv G ccrcts)) $ >
  $ wceq N (cfv F chash) $ >
  $ wi ph (wcel S (co cc0 N cfzo)) $ >
  $ wceq H (co F S ccsh) $ >
  $ wceq Q (cmpt x3 (co cc0 N cfz) (cif (wbr (cv x3) (co N S cmin) cle) (cfv (co (cv x3) S caddc) P) (cfv (co (co (cv x3) S caddc) N cmin) P))) $ >
  $ wi ph (wbr H Q (cfv G ctrls)) $;

--| Cyclically shifting the indices of a circuit ` <. F , P >. ` results in a circuit ` <. H , Q >. ` . (Contributed by AV, 10-Mar-2021.) (Proof shortened by AV, 31-Oct-2021.)
theorem crctcsh {x3: setvar} (ph: wff) (P: class) (Q: class x3) (S F: class) (G: class x3) (H I N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wbr F P (cfv G ccrcts)) $ >
  $ wceq N (cfv F chash) $ >
  $ wi ph (wcel S (co cc0 N cfzo)) $ >
  $ wceq H (co F S ccsh) $ >
  $ wceq Q (cmpt x3 (co cc0 N cfz) (cif (wbr (cv x3) (co N S cmin) cle) (cfv (co (cv x3) S caddc) P) (cfv (co (co (cv x3) S caddc) N cmin) P))) $ >
  $ wi ph (wbr H Q (cfv G ccrcts)) $;

--| Extend class notation with walks (in a graph) as word over the set of vertices.
term cwwlks: class;

--| Extend class notation with walks (in a graph) of a fixed length as word over the set of vertices.
term cwwlksn: class;

--| Extend class notation with walks between two vertices (in a graph) of a fixed length as word over the set of vertices.
term cwwlksnon: class;

--| Extend class notation with simple paths (in a graph) of a fixed length as word over the set of vertices.
term cwwspthsn: class;

--| Extend class notation with simple paths between two vertices (in a graph) of a fixed length as word over the set of vertices.
term cwwspthsnon: class;

--| Define the set of all walks (in an undirected graph) as words over the set of vertices. Such a word corresponds to the sequence p(0) p(1) ... p(n-1) p(n) of the vertices in a walk p(0) e(f(1)) p(1) e(f(2)) ... p(n-1) e(f(n)) p(n) as defined in ~ df-wlks . ` w = (/) ` has to be excluded because a walk always consists of at least one vertex, see ~ wlkn0 . (Contributed by Alexander van der Vekens, 15-Jul-2018.) (Revised by AV, 8-Apr-2021.)
axiom df_wwlks {w g2 i: setvar}:
  $ wceq cwwlks (cmpt g2 cvv (crab w (wa (wne (cv w) c0) (wral i (wcel (cpr (cfv (cv i) (cv w)) (cfv (co (cv i) c1 caddc) (cv w))) (cfv (cv g2) cedg)) (co cc0 (co (cfv (cv w) chash) c1 cmin) cfzo))) (cword (cfv (cv g2) cvtx)))) $;

--| Define the set of all walks (in an undirected graph) of a fixed length n as words over the set of vertices. Such a word corresponds to the sequence p(0) p(1) ... p(n) of the vertices in a walk p(0) e(f(1)) p(1) e(f(2)) ... p(n-1) e(f(n)) p(n) as defined in ~ df-wlks . (Contributed by Alexander van der Vekens, 15-Jul-2018.) (Revised by AV, 8-Apr-2021.)
axiom df_wwlksn {w g2 n: setvar}:
  $ wceq cwwlksn (cmpo n g2 cn0 cvv (crab w (wceq (cfv (cv w) chash) (co (cv n) c1 caddc)) (cfv (cv g2) cwwlks))) $;

--| Define the collection of walks of a fixed length with particular endpoints as word over the set of vertices. (Contributed by Alexander van der Vekens, 15-Feb-2018.) (Revised by AV, 11-May-2021.)
axiom df_wwlksnon {w g2 n a b: setvar}:
  $ wceq cwwlksnon (cmpo n g2 cn0 cvv (cmpo a b (cfv (cv g2) cvtx) (cfv (cv g2) cvtx) (crab w (wa (wceq (cfv cc0 (cv w)) (cv a)) (wceq (cfv (cv n) (cv w)) (cv b))) (co (cv n) (cv g2) cwwlksn)))) $;

--| Define the collection of simple paths of a fixed length as word over the set of vertices. (Contributed by Alexander van der Vekens, 1-Mar-2018.) (Revised by AV, 11-May-2021.)
axiom df_wspthsn {w f2 g2 n: setvar}:
  $ wceq cwwspthsn (cmpo n g2 cn0 cvv (crab w (wex f2 (wbr (cv f2) (cv w) (cfv (cv g2) cspths))) (co (cv n) (cv g2) cwwlksn))) $;

--| Define the collection of simple paths of a fixed length with particular endpoints as word over the set of vertices. (Contributed by Alexander van der Vekens, 1-Mar-2018.) (Revised by AV, 11-May-2021.)
axiom df_wspthsnon {w f2 g2 n a b: setvar}:
  $ wceq cwwspthsnon (cmpo n g2 cn0 cvv (cmpo a b (cfv (cv g2) cvtx) (cfv (cv g2) cvtx) (crab w (wex f2 (wbr (cv f2) (cv w) (co (cv a) (cv b) (cfv (cv g2) cspthson)))) (co (cv a) (cv b) (co (cv n) (cv g2) cwwlksnon))))) $;

--| The set of walks (in an undirected graph) as words over the set of vertices. (Contributed by Alexander van der Vekens, 15-Jul-2018.) (Revised by AV, 8-Apr-2021.)
theorem wwlks {w i: setvar} (E: class w i) (G: class) (V: class i):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq (cfv G cwwlks) (crab w (wa (wne (cv w) c0) (wral i (wcel (cpr (cfv (cv i) (cv w)) (cfv (co (cv i) c1 caddc) (cv w))) E) (co cc0 (co (cfv (cv w) chash) c1 cmin) cfzo))) (cword V)) $;

--| A word over the set of vertices representing a walk (in an undirected graph). (Contributed by Alexander van der Vekens, 15-Jul-2018.) (Revised by AV, 8-Apr-2021.)
theorem iswwlks {i: setvar} (E: class i) (G: class) (V: class i) (W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wb (wcel W (cfv G cwwlks)) (w3a (wne W c0) (wcel W (cword V)) (wral i (wcel (cpr (cfv (cv i) W) (cfv (co (cv i) c1 caddc) W)) E) (co cc0 (co (cfv W chash) c1 cmin) cfzo))) $;

--| The set of walks (in an undirected graph) of a fixed length as words over the set of vertices. (Contributed by Alexander van der Vekens, 15-Jul-2018.) (Revised by AV, 8-Apr-2021.)
theorem wwlksn {w: setvar} (G N: class):
  $ wi (wcel N cn0) (wceq (co N G cwwlksn) (crab w (wceq (cfv (cv w) chash) (co N c1 caddc)) (cfv G cwwlks))) $;

--| A word over the set of vertices representing a walk of a fixed length (in an undirected graph). (Contributed by Alexander van der Vekens, 15-Jul-2018.) (Revised by AV, 8-Apr-2021.)
theorem iswwlksn (G N W: class):
  $ wi (wcel N cn0) (wb (wcel W (co N G cwwlksn)) (wa (wcel W (cfv G cwwlks)) (wceq (cfv W chash) (co N c1 caddc)))) $;

--| Derivation of the length of a word ` W ` whose concatenation with a singleton word represents a walk of a fixed length ` N ` (a partial reverse closure theorem). (Contributed by AV, 4-Mar-2022.)
theorem wwlksnprcl (G N V W X: class):
  $ wi (wa (wcel W (cword V)) (wcel N cn0)) (wi (wcel (co W (cs1 X) cconcat) (co N G cwwlksn)) (wceq (cfv W chash) N)) $;

--| Properties of a word to represent a walk of a fixed length, definition of ` WWalks ` expanded. (Contributed by AV, 28-Apr-2021.)
theorem iswwlksnx {i: setvar} (E: class i) (G: class) (N V: class i) (W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wcel N cn0) (wb (wcel W (co N G cwwlksn)) (w3a (wcel W (cword V)) (wral i (wcel (cpr (cfv (cv i) W) (cfv (co (cv i) c1 caddc) W)) E) (co cc0 (co (cfv W chash) c1 cmin) cfzo)) (wceq (cfv W chash) (co N c1 caddc)))) $;

--| Basic properties of a walk (in an undirected graph) as word. (Contributed by Alexander van der Vekens, 15-Jul-2018.) (Revised by AV, 9-Apr-2021.)
theorem wwlkbp (G V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel W (cfv G cwwlks)) (wa (wcel G cvv) (wcel W (cword V))) $;

--| Basic properties of a walk of a fixed length (in an undirected graph) as word. (Contributed by Alexander van der Vekens, 16-Jul-2018.) (Revised by AV, 9-Apr-2021.) (Proof shortened by AV, 20-May-2021.)
theorem wwlknbp (G N V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel W (co N G cwwlksn)) (w3a (wcel G cvv) (wcel N cn0) (wcel W (cword V))) $;

--| Properties of a set being a walk of length n (represented by a word). (Contributed by Alexander van der Vekens, 17-Jun-2018.) (Revised by AV, 9-Apr-2021.)
theorem wwlknp {i: setvar} (E: class i) (G N: class) (V: class i) (W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wcel W (co N G cwwlksn)) (w3a (wcel W (cword V)) (wceq (cfv W chash) (co N c1 caddc)) (wral i (wcel (cpr (cfv (cv i) W) (cfv (co (cv i) c1 caddc) W)) E) (co cc0 N cfzo))) $;

--| Other basic properties of a walk of a fixed length as word. (Contributed by AV, 8-Mar-2022.)
theorem wwlknbp1 (G N W: class):
  $ wi (wcel W (co N G cwwlksn)) (w3a (wcel N cn0) (wcel W (cword (cfv G cvtx))) (wceq (cfv W chash) (co N c1 caddc))) $;

--| The symbols of a word ` W ` representing a walk of a fixed length ` N ` are vertices. (Contributed by AV, 16-Mar-2022.)
theorem wwlknvtx {i: setvar} (G N W: class):
  $ wi (wcel W (co N G cwwlksn)) (wral i (wcel (cfv (cv i) W) (cfv G cvtx)) (co cc0 N cfz)) $;

--| If a word ` W ` represents a walk of a fixed length ` N ` , then the first and the last symbol of the word is a vertex. (Contributed by AV, 14-Mar-2022.)
theorem wwlknllvtx (G N V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel W (co N G cwwlksn)) (wa (wcel (cfv cc0 W) V) (wcel (cfv N W) V)) $;

--| If a word represents a walk of a fixed length, then the last symbol of the word is the endvertex of the walk. (Contributed by AV, 8-Mar-2022.)
theorem wwlknlsw (G N W: class):
  $ wi (wcel W (co N G cwwlksn)) (wceq (cfv N W) (cfv W clsw)) $;

--| The set of simple paths of a fixed length as word. (Contributed by Alexander van der Vekens, 1-Mar-2018.) (Revised by AV, 11-May-2021.)
theorem wspthsn {w f2: setvar} (G: class) (N: class f2):
  $ wceq (co N G cwwspthsn) (crab w (wex f2 (wbr (cv f2) (cv w) (cfv G cspths))) (co N G cwwlksn)) $;

--| An element of the set of simple paths of a fixed length as word. (Contributed by Alexander van der Vekens, 1-Mar-2018.) (Revised by AV, 11-May-2021.)
theorem iswspthn {f2: setvar} (G: class) (N: class f2) (W: class):
  $ wb (wcel W (co N G cwwspthsn)) (wa (wcel W (co N G cwwlksn)) (wex f2 (wbr (cv f2) W (cfv G cspths)))) $;

--| Properties of a set being a simple path of a fixed length as word. (Contributed by AV, 18-May-2021.)
theorem wspthnp {f2: setvar} (G: class) (N: class f2) (W: class):
  $ wi (wcel W (co N G cwwspthsn)) (w3a (wa (wcel N cn0) (wcel G cvv)) (wcel W (co N G cwwlksn)) (wex f2 (wbr (cv f2) W (cfv G cspths)))) $;

--| The set of walks of a fixed length between two vertices as word. (Contributed by Alexander van der Vekens, 15-Feb-2018.) (Revised by AV, 11-May-2021.)
theorem wwlksnon {w a b: setvar} (U: class w a b) (G N: class) (V: class w):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel N cn0) (wcel G U)) (wceq (co N G cwwlksnon) (cmpo a b V V (crab w (wa (wceq (cfv cc0 (cv w)) (cv a)) (wceq (cfv N (cv w)) (cv b))) (co N G cwwlksn)))) $;

--| The set of simple paths of a fixed length between two vertices as word. (Contributed by Alexander van der Vekens, 1-Mar-2018.) (Revised by AV, 11-May-2021.)
theorem wspthsnon {w f2 a b: setvar} (U: class w f2 a b) (G N: class) (V: class w f2):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel N cn0) (wcel G U)) (wceq (co N G cwwspthsnon) (cmpo a b V V (crab w (wex f2 (wbr (cv f2) (cv w) (co (cv a) (cv b) (cfv G cspthson)))) (co (cv a) (cv b) (co N G cwwlksnon))))) $;

--| The set of walks of a fixed length between two vertices as word. (Contributed by Alexander van der Vekens, 15-Feb-2018.) (Revised by AV, 12-May-2021.) (Revised by AV, 14-Mar-2022.)
theorem iswwlksnon {w: setvar} (A2 B2 G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq (co A2 B2 (co N G cwwlksnon)) (crab w (wa (wceq (cfv cc0 (cv w)) A2) (wceq (cfv N (cv w)) B2)) (co N G cwwlksn)) $;

--| Sufficient conditions for a set of walks of a fixed length between two vertices to be empty. (Contributed by AV, 15-May-2021.) (Proof shortened by AV, 21-May-2021.)
theorem wwlksnon0 (A2 B2 G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wn (wa (wa (wcel N cn0) (wcel G cvv)) (wa (wcel A2 V) (wcel B2 V)))) (wceq (co A2 B2 (co N G cwwlksnon)) c0) $;

--| If a word ` W ` represents a walk of length 2 on two classes ` A ` and ` C ` , these classes are vertices. (Contributed by AV, 14-Mar-2022.)
theorem wwlksonvtx (A2 C G N V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel W (co A2 C (co N G cwwlksnon))) (wa (wcel A2 V) (wcel C V)) $;

--| The set of simple paths of a fixed length between two vertices as word. (Contributed by Alexander van der Vekens, 1-Mar-2018.) (Revised by AV, 12-May-2021.) (Revised by AV, 14-Mar-2022.)
theorem iswspthsnon {w f2: setvar} (A2 B2 G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq (co A2 B2 (co N G cwwspthsnon)) (crab w (wex f2 (wbr (cv f2) (cv w) (co A2 B2 (cfv G cspthson)))) (co A2 B2 (co N G cwwlksnon))) $;

--| An element of the set of walks of a fixed length between two vertices as word. (Contributed by Alexander van der Vekens, 15-Feb-2018.) (Revised by AV, 12-May-2021.) (Revised by AV, 14-Mar-2022.)
theorem wwlknon (A2 B2 G N W: class):
  $ wb (wcel W (co A2 B2 (co N G cwwlksnon))) (w3a (wcel W (co N G cwwlksn)) (wceq (cfv cc0 W) A2) (wceq (cfv N W) B2)) $;

--| An element of the set of simple paths of a fixed length between two vertices as word. (Contributed by Alexander van der Vekens, 1-Mar-2018.) (Revised by AV, 12-May-2021.) (Revised by AV, 15-Mar-2022.)
theorem wspthnon {f2: setvar} (A2 B2 G N W: class):
  $ wb (wcel W (co A2 B2 (co N G cwwspthsnon))) (wa (wcel W (co A2 B2 (co N G cwwlksnon))) (wex f2 (wbr (cv f2) W (co A2 B2 (cfv G cspthson))))) $;

--| Properties of a set being a simple path of a fixed length between two vertices as word. (Contributed by AV, 14-May-2021.) (Proof shortened by AV, 15-Mar-2022.)
theorem wspthnonp {f2: setvar} (A2 B2 G N V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel W (co A2 B2 (co N G cwwspthsnon))) (w3a (wa (wcel N cn0) (wcel G cvv)) (wa (wcel A2 V) (wcel B2 V)) (wa (wcel W (co A2 B2 (co N G cwwlksnon))) (wex f2 (wbr (cv f2) W (co A2 B2 (cfv G cspthson)))))) $;

--| Two simple paths with identical sequences of vertices start and end at the same vertices. (Contributed by AV, 14-May-2021.)
theorem wspthneq1eq2 (A2 B2 C D P G N: class):
  $ wi (wa (wcel P (co A2 B2 (co N G cwwspthsnon))) (wcel P (co C D (co N G cwwspthsnon)))) (wa (wceq A2 C) (wceq B2 D)) $;

--| The set of all walks as words of length 0 is the set of all words of length 1 over the vertices. (Contributed by Alexander van der Vekens, 22-Jul-2018.) (Revised by AV, 12-Apr-2021.)
theorem wwlksn0s {w: setvar} (G: class):
  $ wceq (co cc0 G cwwlksn) (crab w (wceq (cfv (cv w) chash) c1) (cword (cfv G cvtx))) $;

--| Walks (represented by words) are words. (Contributed by Alexander van der Vekens, 17-Jul-2018.) (Revised by AV, 9-Apr-2021.)
theorem wwlkssswrd (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wss (cfv G cwwlks) (cword V) $;

--| A walk of length 0 is represented by a singleton word. (Contributed by Alexander van der Vekens, 20-Jul-2018.) (Revised by AV, 9-Apr-2021.) (Proof shortened by AV, 21-May-2021.)
theorem wwlksn0 {v: setvar} (G V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel W (co cc0 G cwwlksn)) (wrex v (wceq W (cs1 (cv v))) V) $;

--| In graphs without edges, there are no walks of length greater than 0. (Contributed by Alexander van der Vekens, 26-Jul-2018.) (Revised by AV, 7-May-2021.)
theorem _0enwwlksnge1 (G N: class):
  $ wi (wa (wceq (cfv G cedg) c0) (wcel N cn)) (wceq (co N G cwwlksn) c0) $;

--| A walk of a fixed length as word is a walk (in an undirected graph) as word. (Contributed by Alexander van der Vekens, 17-Jul-2018.) (Revised by AV, 12-Apr-2021.)
theorem wwlkswwlksn (G N W: class):
  $ wi (wcel W (co N G cwwlksn)) (wcel W (cfv G cwwlks)) $;

--| The walks of a fixed length as words are walks (in an undirected graph) as words. (Contributed by Alexander van der Vekens, 17-Jul-2018.) (Revised by AV, 12-Apr-2021.)
theorem wwlkssswwlksn (G N: class):
  $ wss (co N G cwwlksn) (cfv G cwwlks) $;

--| The sequence of vertices in a walk is a walk as word in a pseudograph. (Contributed by Alexander van der Vekens, 20-Jul-2018.) (Revised by AV, 9-Apr-2021.)
theorem wlkiswwlks1 (P F G: class):
  $ wi (wcel G cupgr) (wi (wbr F P (cfv G cwlks)) (wcel P (cfv G cwwlks))) $;

--| The sequence of vertices in a walk of length ` N ` is a walk as word of length ` N ` in a pseudograph. (Contributed by Alexander van der Vekens, 21-Jul-2018.) (Revised by AV, 12-Apr-2021.)
theorem wlklnwwlkln1 (P F G N: class):
  $ wi (wcel G cupgr) (wi (wa (wbr F P (cfv G cwlks)) (wceq (cfv F chash) N)) (wcel P (co N G cwwlksn))) $;

--| Lemma 1 for ~ wlkiswwlks2 . (Contributed by Alexander van der Vekens, 20-Jul-2018.)
theorem wlkiswwlks2lem1 {x3: setvar} (P: class) (E F V: class x3):
  $ wceq F (cmpt x3 (co cc0 (co (cfv P chash) c1 cmin) cfzo) (cfv (cpr (cfv (cv x3) P) (cfv (co (cv x3) c1 caddc) P)) (ccnv E))) $ >
  $ wi (wa (wcel P (cword V)) (wbr c1 (cfv P chash) cle)) (wceq (cfv F chash) (co (cfv P chash) c1 cmin)) $;

--| Lemma 2 for ~ wlkiswwlks2 . (Contributed by Alexander van der Vekens, 20-Jul-2018.)
theorem wlkiswwlks2lem2 {x3: setvar} (P E: class) (F: class x3) (I: class):
  $ wceq F (cmpt x3 (co cc0 (co (cfv P chash) c1 cmin) cfzo) (cfv (cpr (cfv (cv x3) P) (cfv (co (cv x3) c1 caddc) P)) (ccnv E))) $ >
  $ wi (wa (wcel (cfv P chash) cn0) (wcel I (co cc0 (co (cfv P chash) c1 cmin) cfzo))) (wceq (cfv I F) (cfv (cpr (cfv I P) (cfv (co I c1 caddc) P)) (ccnv E))) $;

--| Lemma 3 for ~ wlkiswwlks2 . (Contributed by Alexander van der Vekens, 20-Jul-2018.)
theorem wlkiswwlks2lem3 {x3: setvar} (P E: class) (F: class x3) (V: class):
  $ wceq F (cmpt x3 (co cc0 (co (cfv P chash) c1 cmin) cfzo) (cfv (cpr (cfv (cv x3) P) (cfv (co (cv x3) c1 caddc) P)) (ccnv E))) $ >
  $ wi (wa (wcel P (cword V)) (wbr c1 (cfv P chash) cle)) (wf (co cc0 (cfv F chash) cfz) V P) $;

--| Lemma 4 for ~ wlkiswwlks2 . (Contributed by Alexander van der Vekens, 20-Jul-2018.) (Revised by AV, 10-Apr-2021.)
theorem wlkiswwlks2lem4 {x3 i: setvar} (P: class) (E: class i) (F G: class x3) (V: class):
  $ wceq F (cmpt x3 (co cc0 (co (cfv P chash) c1 cmin) cfzo) (cfv (cpr (cfv (cv x3) P) (cfv (co (cv x3) c1 caddc) P)) (ccnv E))) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (w3a (wcel G cuspgr) (wcel P (cword V)) (wbr c1 (cfv P chash) cle)) (wi (wral i (wcel (cpr (cfv (cv i) P) (cfv (co (cv i) c1 caddc) P)) (crn E)) (co cc0 (co (cfv P chash) c1 cmin) cfzo)) (wral i (wceq (cfv (cfv (cv i) F) E) (cpr (cfv (cv i) P) (cfv (co (cv i) c1 caddc) P))) (co cc0 (cfv F chash) cfzo))) $;

--| Lemma 5 for ~ wlkiswwlks2 . (Contributed by Alexander van der Vekens, 21-Jul-2018.) (Revised by AV, 10-Apr-2021.)
theorem wlkiswwlks2lem5 {x3 i: setvar} (P E: class) (F: class x3) (G V: class):
  $ wceq F (cmpt x3 (co cc0 (co (cfv P chash) c1 cmin) cfzo) (cfv (cpr (cfv (cv x3) P) (cfv (co (cv x3) c1 caddc) P)) (ccnv E))) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (w3a (wcel G cuspgr) (wcel P (cword V)) (wbr c1 (cfv P chash) cle)) (wi (wral i (wcel (cpr (cfv (cv i) P) (cfv (co (cv i) c1 caddc) P)) (crn E)) (co cc0 (co (cfv P chash) c1 cmin) cfzo)) (wcel F (cword (cdm E)))) $;

--| Lemma 6 for ~ wlkiswwlks2 . (Contributed by Alexander van der Vekens, 21-Jul-2018.) (Revised by AV, 10-Apr-2021.)
theorem wlkiswwlks2lem6 {x3 i: setvar} (P E: class) (F: class x3) (G V: class):
  $ wceq F (cmpt x3 (co cc0 (co (cfv P chash) c1 cmin) cfzo) (cfv (cpr (cfv (cv x3) P) (cfv (co (cv x3) c1 caddc) P)) (ccnv E))) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (w3a (wcel G cuspgr) (wcel P (cword V)) (wbr c1 (cfv P chash) cle)) (wi (wral i (wcel (cpr (cfv (cv i) P) (cfv (co (cv i) c1 caddc) P)) (crn E)) (co cc0 (co (cfv P chash) c1 cmin) cfzo)) (w3a (wcel F (cword (cdm E))) (wf (co cc0 (cfv F chash) cfz) V P) (wral i (wceq (cfv (cfv (cv i) F) E) (cpr (cfv (cv i) P) (cfv (co (cv i) c1 caddc) P))) (co cc0 (cfv F chash) cfzo)))) $;

--| A walk as word corresponds to the sequence of vertices in a walk in a simple pseudograph. (Contributed by Alexander van der Vekens, 21-Jul-2018.) (Revised by AV, 10-Apr-2021.)
theorem wlkiswwlks2 {f2: setvar} (P G: class):
  $ wi (wcel G cuspgr) (wi (wcel P (cfv G cwwlks)) (wex f2 (wbr (cv f2) P (cfv G cwlks)))) $;

--| A walk as word corresponds to a walk in a simple pseudograph. (Contributed by Alexander van der Vekens, 21-Jul-2018.) (Revised by AV, 10-Apr-2021.)
theorem wlkiswwlks {f2: setvar} (P G: class):
  $ wi (wcel G cuspgr) (wb (wex f2 (wbr (cv f2) P (cfv G cwlks))) (wcel P (cfv G cwwlks))) $;

--| A walk as word corresponds to the sequence of vertices in a walk in a pseudograph. This variant of ~ wlkiswwlks2 does not require ` G ` to be a simple pseudograph, but it requires the Axiom of Choice ( ~ ac6 ) for its proof. Notice that only the existence of a function ` f ` can be proven, but, in general, it cannot be "constructed" (as in ~ wlkiswwlks2 ). (Contributed by Alexander van der Vekens, 21-Jul-2018.) (Revised by AV, 10-Apr-2021.)
theorem wlkiswwlksupgr2 {f2: setvar} (P G: class):
  $ wi (wcel G cupgr) (wi (wcel P (cfv G cwwlks)) (wex f2 (wbr (cv f2) P (cfv G cwlks)))) $;

--| A walk as word corresponds to a walk in a pseudograph. This variant of ~ wlkiswwlks does not require ` G ` to be a simple pseudograph, but it requires (indirectly) the Axiom of Choice for its proof. (Contributed by Alexander van der Vekens, 21-Jul-2018.) (Revised by AV, 10-Apr-2021.)
theorem wlkiswwlkupgr {f2: setvar} (P G: class):
  $ wi (wcel G cupgr) (wb (wex f2 (wbr (cv f2) P (cfv G cwlks))) (wcel P (cfv G cwwlks))) $;

--| The mapping of (ordinary) walks to their sequences of vertices is a bijection in a simple pseudograph. (Contributed by AV, 6-May-2021.)
theorem wlkswwlksf1o {w: setvar} (F: class w) (G: class):
  $ wceq F (cmpt w (cfv G cwlks) (cfv (cv w) c2nd)) $ >
  $ wi (wcel G cuspgr) (wf1o (cfv G cwlks) (cfv G cwwlks) F) $;

--| The set of walks as words and the set of (ordinary) walks are equinumerous in a simple pseudograph. (Contributed by AV, 6-May-2021.) (Revised by AV, 5-Aug-2022.)
theorem wlkswwlksen (G: class):
  $ wi (wcel G cuspgr) (wbr (cfv G cwlks) (cfv G cwwlks) cen) $;

--| Removing the trailing edge from a walk (as word) with at least one edge results in a walk. (Contributed by Alexander van der Vekens, 1-Aug-2018.) (Revised by AV, 19-Apr-2021.) (Revised by AV, 26-Oct-2022.)
theorem wwlksm1edg (G W: class):
  $ wi (wa (wcel W (cfv G cwwlks)) (wbr c2 (cfv W chash) cle)) (wcel (co W (co (cfv W chash) c1 cmin) cpfx) (cfv G cwwlks)) $;

--| Lemma for ~ wlklnwwlkln2 and ~ wlklnwwlklnupgr2 . Formerly part of proof for ~ wlklnwwlkln2 . (Contributed by Alexander van der Vekens, 21-Jul-2018.) (Revised by AV, 12-Apr-2021.)
theorem wlklnwwlkln2lem {f2: setvar} (ph: wff) (P G N: class):
  $ wi ph (wi (wcel P (cfv G cwwlks)) (wex f2 (wbr (cv f2) P (cfv G cwlks)))) $ >
  $ wi ph (wi (wcel P (co N G cwwlksn)) (wex f2 (wa (wbr (cv f2) P (cfv G cwlks)) (wceq (cfv (cv f2) chash) N)))) $;

--| A walk of length ` N ` as word corresponds to the sequence of vertices in a walk of length ` N ` in a simple pseudograph. (Contributed by Alexander van der Vekens, 21-Jul-2018.) (Revised by AV, 12-Apr-2021.)
theorem wlklnwwlkln2 {f2: setvar} (P G N: class):
  $ wi (wcel G cuspgr) (wi (wcel P (co N G cwwlksn)) (wex f2 (wa (wbr (cv f2) P (cfv G cwlks)) (wceq (cfv (cv f2) chash) N)))) $;

--| A walk of length ` N ` as word corresponds to a walk with length ` N ` in a simple pseudograph. (Contributed by Alexander van der Vekens, 21-Jul-2018.) (Revised by AV, 12-Apr-2021.)
theorem wlklnwwlkn {f2: setvar} (P G N: class):
  $ wi (wcel G cuspgr) (wb (wex f2 (wa (wbr (cv f2) P (cfv G cwlks)) (wceq (cfv (cv f2) chash) N))) (wcel P (co N G cwwlksn))) $;

--| A walk of length ` N ` as word corresponds to the sequence of vertices in a walk of length ` N ` in a pseudograph. This variant of ~ wlklnwwlkln2 does not require ` G ` to be a simple pseudograph, but it requires (indirectly) the Axiom of Choice. (Contributed by Alexander van der Vekens, 21-Jul-2018.) (Revised by AV, 12-Apr-2021.)
theorem wlklnwwlklnupgr2 {f2: setvar} (P G N: class):
  $ wi (wcel G cupgr) (wi (wcel P (co N G cwwlksn)) (wex f2 (wa (wbr (cv f2) P (cfv G cwlks)) (wceq (cfv (cv f2) chash) N)))) $;

--| A walk of length ` N ` as word corresponds to a walk with length ` N ` in a pseudograph. This variant of ~ wlklnwwlkn does not require ` G ` to be a simple pseudograph, but it requires (indirectly) the Axiom of Choice for its proof. (Contributed by Alexander van der Vekens, 21-Jul-2018.) (Revised by AV, 12-Apr-2021.)
theorem wlklnwwlknupgr {f2: setvar} (P G N: class):
  $ wi (wcel G cupgr) (wb (wex f2 (wa (wbr (cv f2) P (cfv G cwlks)) (wceq (cfv (cv f2) chash) N))) (wcel P (co N G cwwlksn))) $;

--| If a walk in a pseudograph has length ` N ` , then the sequence of the vertices of the walk is a word representing the walk as word of length ` N ` . (Contributed by Alexander van der Vekens, 25-Aug-2018.) (Revised by AV, 11-Apr-2021.)
theorem wlknewwlksn (G N W: class):
  $ wi (wa (wa (wcel G cupgr) (wcel W (cfv G cwlks))) (wa (wcel N cn0) (wceq (cfv (cfv W c1st) chash) N))) (wcel (cfv W c2nd) (co N G cwwlksn)) $;

--| The mapping ` ( t e. T |-> ( 2nd `` t ) ) ` is a bijection between the set of walks of a fixed length and the set of walks represented by words of the same length in a simple pseudograph. (Contributed by Alexander van der Vekens, 25-Aug-2018.) (Revised by AV, 5-Aug-2022.)
theorem wlknwwlksnbij {t p: setvar} (T: class p) (F: class t p) (G N: class) (W: class t p):
  $ wceq T (crab p (wceq (cfv (cfv (cv p) c1st) chash) N) (cfv G cwlks)) $ >
  $ wceq W (co N G cwwlksn) $ >
  $ wceq F (cmpt t T (cfv (cv t) c2nd)) $ >
  $ wi (wa (wcel G cuspgr) (wcel N cn0)) (wf1o T W F) $;

--| In a simple pseudograph, the set of walks of a fixed length and the set of walks represented by words are equinumerous. (Contributed by Alexander van der Vekens, 25-Aug-2018.) (Revised by AV, 5-Aug-2022.)
theorem wlknwwlksnen {p: setvar} (G N: class):
  $ wi (wa (wcel G cuspgr) (wcel N cn0)) (wbr (crab p (wceq (cfv (cfv (cv p) c1st) chash) N) (cfv G cwlks)) (co N G cwwlksn) cen) $;

--| The set of walks of a fixed length and the set of walks represented by words have the same size. (Contributed by Alexander van der Vekens, 25-Aug-2018.) (Revised by AV, 15-Apr-2021.)
theorem wlknwwlksneqs {p: setvar} (G N: class):
  $ wi (wa (wcel G cuspgr) (wcel N cn0)) (wceq (cfv (crab p (wceq (cfv (cfv (cv p) c1st) chash) N) (cfv G cwlks)) chash) (cfv (co N G cwwlksn) chash)) $;

--| Equality of two walks (as words). (Contributed by Alexander van der Vekens, 4-Aug-2018.) (Revised by AV, 16-Apr-2021.)
theorem wwlkseq {i: setvar} (T: class) (G: class i) (W: class):
  $ wi (wa (wcel W (cfv G cwwlks)) (wcel T (cfv G cwwlks))) (wb (wceq W T) (wa (wceq (cfv W chash) (cfv T chash)) (wral i (wceq (cfv (cv i) W) (cfv (cv i) T)) (co cc0 (cfv W chash) cfzo)))) $;

--| Reduction of a walk (as word) by removing the trailing edge/vertex. (Contributed by Alexander van der Vekens, 4-Aug-2018.) (Revised by AV, 16-Apr-2021.) (Revised by AV, 26-Oct-2022.)
theorem wwlksnred (G N W: class):
  $ wi (wcel N cn0) (wi (wcel W (co (co N c1 caddc) G cwwlksn)) (wcel (co W (co N c1 caddc) cpfx) (co N G cwwlksn))) $;

--| Extension of a walk (as word) by adding an edge/vertex. (Contributed by Alexander van der Vekens, 4-Aug-2018.) (Revised by AV, 16-Apr-2021.)
theorem wwlksnext (S T E G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (w3a (wcel T (co N G cwwlksn)) (wcel S V) (wcel (cpr (cfv T clsw) S) E)) (wcel (co T (cs1 S) cconcat) (co (co N c1 caddc) G cwwlksn)) $;

--| Extension of a walk (as word) by adding an edge/vertex. (Contributed by Alexander van der Vekens, 5-Aug-2018.) (Revised by AV, 16-Apr-2021.) (Proof shortened by AV, 27-Oct-2022.)
theorem wwlksnextbi (S T E G N V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wa (wcel N cn0) (wcel S V)) (w3a (wcel T (cword V)) (wceq W (co T (cs1 S) cconcat)) (wcel (cpr (cfv T clsw) S) E))) (wb (wcel W (co (co N c1 caddc) G cwwlksn)) (wcel T (co N G cwwlksn))) $;

--| For each walk (as word) of length at least 1 there is a shorter walk (as word). (Contributed by Alexander van der Vekens, 22-Aug-2018.) (Revised by AV, 18-Apr-2021.) (Revised by AV, 26-Oct-2022.)
theorem wwlksnredwwlkn {y1: setvar} (E G N W: class):
  $ wceq E (cfv G cedg) $ >
  $ wi (wcel N cn0) (wi (wcel W (co (co N c1 caddc) G cwwlksn)) (wrex y1 (wa (wceq (co W (co N c1 caddc) cpfx) (cv y1)) (wcel (cpr (cfv (cv y1) clsw) (cfv W clsw)) E)) (co N G cwwlksn))) $;

--| For each walk (as word) of length at least 1 there is a shorter walk (as word) starting at the same vertex. (Contributed by Alexander van der Vekens, 22-Aug-2018.) (Revised by AV, 18-Apr-2021.) (Revised by AV, 26-Oct-2022.)
theorem wwlksnredwwlkn0 {y1: setvar} (P E G N W: class):
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel N cn0) (wcel W (co (co N c1 caddc) G cwwlksn))) (wb (wceq (cfv cc0 W) P) (wrex y1 (w3a (wceq (co W (co N c1 caddc) cpfx) (cv y1)) (wceq (cfv cc0 (cv y1)) P) (wcel (cpr (cfv (cv y1) clsw) (cfv W clsw)) E)) (co N G cwwlksn))) $;

--| Lemma for ~ wwlksnextbij . (Contributed by Alexander van der Vekens, 5-Aug-2018.) (Revised by AV, 18-Apr-2021.) (Revised by AV, 27-Oct-2022.)
theorem wwlksnextwrd {w: setvar} (D E: class w) (G N: class) (V: class w) (W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq D (crab w (w3a (wceq (cfv (cv w) chash) (co N c2 caddc)) (wceq (co (cv w) (co N c1 caddc) cpfx) W) (wcel (cpr (cfv W clsw) (cfv (cv w) clsw)) E)) (cword V)) $ >
  $ wi (wcel W (co N G cwwlksn)) (wceq D (crab w (wa (wceq (co (cv w) (co N c1 caddc) cpfx) W) (wcel (cpr (cfv W clsw) (cfv (cv w) clsw)) E)) (co (co N c1 caddc) G cwwlksn))) $;

--| Lemma for ~ wwlksnextbij . (Contributed by Alexander van der Vekens, 7-Aug-2018.) (Revised by AV, 18-Apr-2021.) (Revised by AV, 27-Oct-2022.)
theorem wwlksnextfun {w t n: setvar} (D R: class w n) (E: class t) (F: class w t n) (G: class t n) (N: class n) (V W: class t):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq D (crab w (w3a (wceq (cfv (cv w) chash) (co N c2 caddc)) (wceq (co (cv w) (co N c1 caddc) cpfx) W) (wcel (cpr (cfv W clsw) (cfv (cv w) clsw)) E)) (cword V)) $ >
  $ wceq R (crab n (wcel (cpr (cfv W clsw) (cv n)) E) V) $ >
  $ wceq F (cmpt t D (cfv (cv t) clsw)) $ >
  $ wi (wcel N cn0) (wf D R F) $;

--| Lemma for ~ wwlksnextbij . (Contributed by Alexander van der Vekens, 7-Aug-2018.) (Revised by AV, 18-Apr-2021.) (Revised by AV, 27-Oct-2022.)
theorem wwlksnextinj {w t n: setvar} (D R: class w n) (E: class t) (F: class w t n) (G: class t n) (N: class n) (V W: class t):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq D (crab w (w3a (wceq (cfv (cv w) chash) (co N c2 caddc)) (wceq (co (cv w) (co N c1 caddc) cpfx) W) (wcel (cpr (cfv W clsw) (cfv (cv w) clsw)) E)) (cword V)) $ >
  $ wceq R (crab n (wcel (cpr (cfv W clsw) (cv n)) E) V) $ >
  $ wceq F (cmpt t D (cfv (cv t) clsw)) $ >
  $ wi (wcel N cn0) (wf1 D R F) $;

--| Lemma for ~ wwlksnextbij . (Contributed by Alexander van der Vekens, 7-Aug-2018.) (Revised by AV, 18-Apr-2021.) (Revised by AV, 27-Oct-2022.)
theorem wwlksnextsurj {w t n: setvar} (D R: class w n) (E: class t) (F: class w t n) (G: class t n) (N: class) (V W: class t):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq D (crab w (w3a (wceq (cfv (cv w) chash) (co N c2 caddc)) (wceq (co (cv w) (co N c1 caddc) cpfx) W) (wcel (cpr (cfv W clsw) (cfv (cv w) clsw)) E)) (cword V)) $ >
  $ wceq R (crab n (wcel (cpr (cfv W clsw) (cv n)) E) V) $ >
  $ wceq F (cmpt t D (cfv (cv t) clsw)) $ >
  $ wi (wcel W (co N G cwwlksn)) (wfo D R F) $;

--| Lemma for ~ wwlksnextbij . (Contributed by Alexander van der Vekens, 7-Aug-2018.) (Revised by AV, 18-Apr-2021.)
theorem wwlksnextbij0 {w t n: setvar} (D R: class w n) (E: class t) (F: class w t n) (G: class t n) (N: class) (V W: class t):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq D (crab w (w3a (wceq (cfv (cv w) chash) (co N c2 caddc)) (wceq (co (cv w) (co N c1 caddc) cpfx) W) (wcel (cpr (cfv W clsw) (cfv (cv w) clsw)) E)) (cword V)) $ >
  $ wceq R (crab n (wcel (cpr (cfv W clsw) (cv n)) E) V) $ >
  $ wceq F (cmpt t D (cfv (cv t) clsw)) $ >
  $ wi (wcel W (co N G cwwlksn)) (wf1o D R F) $;

--| There is a bijection between the extensions of a walk (as word) by an edge and the set of vertices being connected to the trailing vertex of the walk. (Contributed by Alexander van der Vekens, 21-Aug-2018.) (Revised by AV, 18-Apr-2021.) (Revised by AV, 27-Oct-2022.)
theorem wwlksnextbij {w f2 n: setvar} (E: class) (G N: class n) (V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wcel W (co N G cwwlksn)) (wex f2 (wf1o (crab w (wa (wceq (co (cv w) (co N c1 caddc) cpfx) W) (wcel (cpr (cfv W clsw) (cfv (cv w) clsw)) E)) (co (co N c1 caddc) G cwwlksn)) (crab n (wcel (cpr (cfv W clsw) (cv n)) E) V) (cv f2))) $;

--| The number of the extensions of a walk (as word) by an edge equals the number of vertices being connected to the trailing vertex of the walk. (Contributed by Alexander van der Vekens, 23-Aug-2018.) (Revised by AV, 19-Apr-2021.) (Revised by AV, 27-Oct-2022.)
theorem wwlksnexthasheq {w n: setvar} (E: class) (G N: class n) (V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wcel W (co N G cwwlksn)) (wceq (cfv (crab w (wa (wceq (co (cv w) (co N c1 caddc) cpfx) W) (wcel (cpr (cfv W clsw) (cfv (cv w) clsw)) E)) (co (co N c1 caddc) G cwwlksn)) chash) (cfv (crab n (wcel (cpr (cfv W clsw) (cv n)) E) V) chash)) $;

--| Sets of walks (as words) extended by an edge are disjunct if each set contains extensions of distinct walks. (Contributed by Alexander van der Vekens, 29-Jul-2018.) (Revised by AV, 19-Apr-2021.) (Revised by AV, 27-Oct-2022.)
theorem disjxwwlksn {x3 y1: setvar} (P E G: class x3 y1) (N: class x3) (V: class y1):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wdisj y1 (co N G cwwlksn) (crab x3 (w3a (wceq (co (cv x3) N cpfx) (cv y1)) (wceq (cfv cc0 (cv y1)) P) (wcel (cpr (cfv (cv y1) clsw) (cfv (cv x3) clsw)) E)) (cword V)) $;

--| Conditions for ` WWalksN ` not being defined. (Contributed by Alexander van der Vekens, 30-Jul-2018.) (Revised by AV, 19-Apr-2021.)
theorem wwlksnndef (G N: class):
  $ wi (wo (wnel G cvv) (wnel N cn0)) (wceq (co N G cwwlksn) c0) $;

--| The number of walks represented by words of fixed length is finite if the number of vertices is finite (in the graph). (Contributed by Alexander van der Vekens, 30-Jul-2018.) (Revised by AV, 19-Apr-2021.) (Proof shortened by JJ, 18-Nov-2022.)
theorem wwlksnfi (G N: class):
  $ wi (wcel (cfv G cvtx) cfn) (wcel (co N G cwwlksn) cfn) $;

--| The number of walks of fixed length is finite if the number of vertices is finite (in the graph). (Contributed by Alexander van der Vekens, 25-Aug-2018.) (Revised by AV, 20-Apr-2021.)
theorem wlksnfi {p: setvar} (G N: class):
  $ wi (wa (wcel G cfusgr) (wcel N cn0)) (wcel (crab p (wceq (cfv (cfv (cv p) c1st) chash) N) (cfv G cwlks)) cfn) $;

--| There is a bijection between the set of walks of a fixed length and the set of walks represented by words of the same length and starting at the same vertex. (Contributed by Alexander van der Vekens, 22-Jul-2018.) (Revised by AV, 5-Aug-2022.)
theorem wlksnwwlknvbij {w f2 p: setvar} (G N X: class):
  $ wi (wa (wcel G cuspgr) (wcel N cn0)) (wex f2 (wf1o (crab p (wa (wceq (cfv (cfv (cv p) c1st) chash) N) (wceq (cfv cc0 (cfv (cv p) c2nd)) X)) (cfv G cwlks)) (crab w (wceq (cfv cc0 (cv w)) X) (co N G cwwlksn)) (cv f2))) $;

--| Lemma 1 for ~ wwlksnextprop . (Contributed by Alexander van der Vekens, 31-Jul-2018.) (Revised by AV, 20-Apr-2021.) (Revised by AV, 29-Oct-2022.)
theorem wwlksnextproplem1 (G N W X: class):
  $ wceq X (co (co N c1 caddc) G cwwlksn) $ >
  $ wi (wa (wcel W X) (wcel N cn0)) (wceq (cfv cc0 (co W (co N c1 caddc) cpfx)) (cfv cc0 W)) $;

--| Lemma 2 for ~ wwlksnextprop . (Contributed by Alexander van der Vekens, 1-Aug-2018.) (Revised by AV, 20-Apr-2021.) (Revised by AV, 29-Oct-2022.)
theorem wwlksnextproplem2 (E G N W X: class):
  $ wceq X (co (co N c1 caddc) G cwwlksn) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel W X) (wcel N cn0)) (wcel (cpr (cfv (co W (co N c1 caddc) cpfx) clsw) (cfv W clsw)) E) $;

--| Lemma 3 for ~ wwlksnextprop . (Contributed by Alexander van der Vekens, 1-Aug-2018.) (Revised by AV, 20-Apr-2021.) (Revised by AV, 29-Oct-2022.)
theorem wwlksnextproplem3 {w: setvar} (P: class) (E: class w) (G N W: class) (X Y: class w):
  $ wceq X (co (co N c1 caddc) G cwwlksn) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq Y (crab w (wceq (cfv cc0 (cv w)) P) (co N G cwwlksn)) $ >
  $ wi (w3a (wcel W X) (wceq (cfv cc0 W) P) (wcel N cn0)) (wcel (co W (co N c1 caddc) cpfx) Y) $;

--| Adding additional properties to the set of walks (as words) of a fixed length starting at a fixed vertex. (Contributed by Alexander van der Vekens, 1-Aug-2018.) (Revised by AV, 20-Apr-2021.) (Revised by AV, 29-Oct-2022.)
theorem wwlksnextprop {x3 y1 w: setvar} (P: class x3) (E: class x3 w) (G: class x3 y1) (N: class) (X Y: class x3 w):
  $ wceq X (co (co N c1 caddc) G cwwlksn) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq Y (crab w (wceq (cfv cc0 (cv w)) P) (co N G cwwlksn)) $ >
  $ wi (wcel N cn0) (wceq (crab x3 (wceq (cfv cc0 (cv x3)) P) X) (crab x3 (wrex y1 (w3a (wceq (co (cv x3) (co N c1 caddc) cpfx) (cv y1)) (wceq (cfv cc0 (cv y1)) P) (wcel (cpr (cfv (cv y1) clsw) (cfv (cv x3) clsw)) E)) Y) X)) $;

--| Sets of walks (as words) extended by an edge are disjunct if each set contains extensions of distinct walks. (Contributed by Alexander van der Vekens, 21-Aug-2018.) (Revised by AV, 20-Apr-2021.) (Revised by AV, 26-Oct-2022.)
theorem disjxwwlkn {x3 y1 w: setvar} (P: class x3) (E: class x3 w) (G: class y1) (M: class x3 w) (N: class) (X: class w) (Y: class x3 w):
  $ wceq X (co (co N c1 caddc) G cwwlksn) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq Y (crab w (wceq (cfv cc0 (cv w)) P) (co N G cwwlksn)) $ >
  $ wdisj y1 Y (crab x3 (w3a (wceq (co (cv x3) M cpfx) (cv y1)) (wceq (cfv cc0 (cv y1)) P) (wcel (cpr (cfv (cv y1) clsw) (cfv (cv x3) clsw)) E)) X) $;

--| Number of walks (as words) extended by an edge as a sum over the prefixes. (Contributed by Alexander van der Vekens, 21-Aug-2018.) (Revised by AV, 20-Apr-2021.) (Revised by AV, 26-Oct-2022.)
theorem hashwwlksnext {x3 y1 w: setvar} (P: class x3) (E: class x3 w) (G: class) (M: class x3 w) (N: class) (X Y: class w):
  $ wceq X (co (co N c1 caddc) G cwwlksn) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq Y (crab w (wceq (cfv cc0 (cv w)) P) (co N G cwwlksn)) $ >
  $ wi (wcel (cfv G cvtx) cfn) (wceq (cfv (crab x3 (wrex y1 (w3a (wceq (co (cv x3) M cpfx) (cv y1)) (wceq (cfv cc0 (cv y1)) P) (wcel (cpr (cfv (cv y1) clsw) (cfv (cv x3) clsw)) E)) Y) X) chash) (csu y1 Y (cfv (crab x3 (w3a (wceq (co (cv x3) M cpfx) (cv y1)) (wceq (cfv cc0 (cv y1)) P) (wcel (cpr (cfv (cv y1) clsw) (cfv (cv x3) clsw)) E)) X) chash))) $;

--| A walk of fixed length is a walk of fixed length between two vertices. (Contributed by Alexander van der Vekens, 21-Feb-2018.) (Revised by AV, 12-May-2021.) (Revised by AV, 13-Mar-2022.)
theorem wwlksnwwlksnon {a b: setvar} (G N V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wb (wcel W (co N G cwwlksn)) (wrex a (wrex b (wcel W (co (cv a) (cv b) (co N G cwwlksnon))) V) V) $;

--| A simple path of fixed length is a simple path of fixed length between two vertices. (Contributed by Alexander van der Vekens, 1-Mar-2018.) (Revised by AV, 16-May-2021.) (Revised by AV, 13-Mar-2022.)
theorem wspthsnwspthsnon {a b: setvar} (G N V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wb (wcel W (co N G cwwspthsn)) (wrex a (wrex b (wcel W (co (cv a) (cv b) (co N G cwwspthsnon))) V) V) $;

--| If the set of simple paths of length at least 1 between two vertices is not empty, the two vertices must be different. (Contributed by Alexander van der Vekens, 3-Mar-2018.) (Revised by AV, 16-May-2021.)
theorem wspthsnonn0vne (G N X Y: class):
  $ wi (wa (wcel N cn) (wne (co X Y (co N G cwwspthsnon)) c0)) (wne X Y) $;

--| The set of simple paths of a fixed length between two vertices is a subset of the set of walks of the fixed length. (Contributed by AV, 18-May-2021.)
theorem wspthsswwlkn (G N: class):
  $ wss (co N G cwwspthsn) (co N G cwwlksn) $;

--| In a finite graph, the set of simple paths of a fixed length is finite. (Contributed by Alexander van der Vekens, 4-Mar-2018.) (Revised by AV, 18-May-2021.)
theorem wspthnfi (G N: class):
  $ wi (wcel (cfv G cvtx) cfn) (wcel (co N G cwwspthsn) cfn) $;

--| In a finite graph, the set of walks of a fixed length between two vertices is finite. (Contributed by Alexander van der Vekens, 4-Mar-2018.) (Revised by AV, 15-May-2021.) (Proof shortened by AV, 15-Mar-2022.)
theorem wwlksnonfi (A2 B2 G N: class):
  $ wi (wcel (cfv G cvtx) cfn) (wcel (co A2 B2 (co N G cwwlksnon)) cfn) $;

--| The set of simple paths of a fixed length between two vertices is a subset of the set of walks of the fixed length between the two vertices. (Contributed by AV, 15-May-2021.)
theorem wspthsswwlknon (A2 B2 G N: class):
  $ wss (co A2 B2 (co N G cwwspthsnon)) (co A2 B2 (co N G cwwlksnon)) $;

--| In a finite graph, the set of simple paths of a fixed length between two vertices is finite. (Contributed by Alexander van der Vekens, 4-Mar-2018.) (Revised by AV, 15-May-2021.)
theorem wspthnonfi (A2 B2 G N: class):
  $ wi (wcel (cfv G cvtx) cfn) (wcel (co A2 B2 (co N G cwwspthsnon)) cfn) $;

--| The set of nonempty simple paths of fixed length is the double union of the simple paths of the fixed length between different vertices. (Contributed by Alexander van der Vekens, 3-Mar-2018.) (Revised by AV, 16-May-2021.) (Proof shortened by AV, 15-Mar-2022.)
theorem wspniunwspnon {x3 y1: setvar} (U G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel N cn) (wcel G U)) (wceq (co N G cwwspthsn) (ciun x3 V (ciun y1 (cdif V (csn (cv x3))) (co (cv x3) (cv y1) (co N G cwwspthsnon))))) $;

--| If there are no vertices, then there are no simple paths (of any length), too. (Contributed by Alexander van der Vekens, 11-Mar-2018.) (Revised by AV, 16-May-2021.) (Proof shortened by AV, 13-Mar-2022.)
theorem wspn0 (G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wceq V c0) (wceq (co N G cwwspthsn) c0) $;

--| Lemma 1 for ~ 2wlkd . (Contributed by AV, 14-Feb-2021.)
theorem _2wlkdlem1 (A2 B2 C P F J K: class):
  $ wceq P (cs3 A2 B2 C) $ >
  $ wceq F (cs2 J K) $ >
  $ wceq (cfv P chash) (co (cfv F chash) c1 caddc) $;

--| Lemma 2 for ~ 2wlkd . (Contributed by AV, 14-Feb-2021.)
theorem _2wlkdlem2 (A2 B2 C P F J K: class):
  $ wceq P (cs3 A2 B2 C) $ >
  $ wceq F (cs2 J K) $ >
  $ wceq (co cc0 (cfv F chash) cfzo) (cpr cc0 c1) $;

--| Lemma 3 for ~ 2wlkd . (Contributed by AV, 14-Feb-2021.)
theorem _2wlkdlem3 (ph: wff) (A2 B2 C P F J K V: class):
  $ wceq P (cs3 A2 B2 C) $ >
  $ wceq F (cs2 J K) $ >
  $ wi ph (w3a (wcel A2 V) (wcel B2 V) (wcel C V)) $ >
  $ wi ph (w3a (wceq (cfv cc0 P) A2) (wceq (cfv c1 P) B2) (wceq (cfv c2 P) C)) $;

--| Lemma 4 for ~ 2wlkd . (Contributed by AV, 14-Feb-2021.)
theorem _2wlkdlem4 {k: setvar} (ph: wff k) (A2 B2 C: class k) (P F: class) (J K: class k) (V: class):
  $ wceq P (cs3 A2 B2 C) $ >
  $ wceq F (cs2 J K) $ >
  $ wi ph (w3a (wcel A2 V) (wcel B2 V) (wcel C V)) $ >
  $ wi ph (wral k (wcel (cfv (cv k) P) V) (co cc0 (cfv F chash) cfz)) $;

--| Lemma 5 for ~ 2wlkd . (Contributed by AV, 14-Feb-2021.)
theorem _2wlkdlem5 {k: setvar} (ph: wff k) (A2 B2 C: class k) (P F: class) (J K: class k) (V: class):
  $ wceq P (cs3 A2 B2 C) $ >
  $ wceq F (cs2 J K) $ >
  $ wi ph (w3a (wcel A2 V) (wcel B2 V) (wcel C V)) $ >
  $ wi ph (wa (wne A2 B2) (wne B2 C)) $ >
  $ wi ph (wral k (wne (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (co cc0 (cfv F chash) cfzo)) $;

--| Lemma 1 for ~ 2pthd . (Contributed by AV, 14-Feb-2021.)
theorem _2pthdlem1 {j k: setvar} (ph: wff j k) (A2 B2 C: class j k) (P F: class) (J K: class j k) (V: class j):
  $ wceq P (cs3 A2 B2 C) $ >
  $ wceq F (cs2 J K) $ >
  $ wi ph (w3a (wcel A2 V) (wcel B2 V) (wcel C V)) $ >
  $ wi ph (wa (wne A2 B2) (wne B2 C)) $ >
  $ wi ph (wral k (wral j (wi (wne (cv k) (cv j)) (wne (cfv (cv k) P) (cfv (cv j) P))) (co c1 (cfv F chash) cfzo)) (co cc0 (cfv P chash) cfzo)) $;

--| Lemma 6 for ~ 2wlkd . (Contributed by AV, 23-Jan-2021.)
theorem _2wlkdlem6 (ph: wff) (A2 B2 C P F I J K V: class):
  $ wceq P (cs3 A2 B2 C) $ >
  $ wceq F (cs2 J K) $ >
  $ wi ph (w3a (wcel A2 V) (wcel B2 V) (wcel C V)) $ >
  $ wi ph (wa (wne A2 B2) (wne B2 C)) $ >
  $ wi ph (wa (wss (cpr A2 B2) (cfv J I)) (wss (cpr B2 C) (cfv K I))) $ >
  $ wi ph (wa (wcel B2 (cfv J I)) (wcel B2 (cfv K I))) $;

--| Lemma 7 for ~ 2wlkd . (Contributed by AV, 14-Feb-2021.)
theorem _2wlkdlem7 (ph: wff) (A2 B2 C P F I J K V: class):
  $ wceq P (cs3 A2 B2 C) $ >
  $ wceq F (cs2 J K) $ >
  $ wi ph (w3a (wcel A2 V) (wcel B2 V) (wcel C V)) $ >
  $ wi ph (wa (wne A2 B2) (wne B2 C)) $ >
  $ wi ph (wa (wss (cpr A2 B2) (cfv J I)) (wss (cpr B2 C) (cfv K I))) $ >
  $ wi ph (wa (wcel J cvv) (wcel K cvv)) $;

--| Lemma 8 for ~ 2wlkd . (Contributed by AV, 14-Feb-2021.)
theorem _2wlkdlem8 (ph: wff) (A2 B2 C P F I J K V: class):
  $ wceq P (cs3 A2 B2 C) $ >
  $ wceq F (cs2 J K) $ >
  $ wi ph (w3a (wcel A2 V) (wcel B2 V) (wcel C V)) $ >
  $ wi ph (wa (wne A2 B2) (wne B2 C)) $ >
  $ wi ph (wa (wss (cpr A2 B2) (cfv J I)) (wss (cpr B2 C) (cfv K I))) $ >
  $ wi ph (wa (wceq (cfv cc0 F) J) (wceq (cfv c1 F) K)) $;

--| Lemma 9 for ~ 2wlkd . (Contributed by AV, 14-Feb-2021.)
theorem _2wlkdlem9 (ph: wff) (A2 B2 C P F I J K V: class):
  $ wceq P (cs3 A2 B2 C) $ >
  $ wceq F (cs2 J K) $ >
  $ wi ph (w3a (wcel A2 V) (wcel B2 V) (wcel C V)) $ >
  $ wi ph (wa (wne A2 B2) (wne B2 C)) $ >
  $ wi ph (wa (wss (cpr A2 B2) (cfv J I)) (wss (cpr B2 C) (cfv K I))) $ >
  $ wi ph (wa (wss (cpr A2 B2) (cfv (cfv cc0 F) I)) (wss (cpr B2 C) (cfv (cfv c1 F) I))) $;

--| Lemma 10 for ~ 3wlkd . (Contributed by AV, 14-Feb-2021.)
theorem _2wlkdlem10 {k: setvar} (ph: wff k) (A2 B2 C: class k) (P F I: class) (J K: class k) (V: class):
  $ wceq P (cs3 A2 B2 C) $ >
  $ wceq F (cs2 J K) $ >
  $ wi ph (w3a (wcel A2 V) (wcel B2 V) (wcel C V)) $ >
  $ wi ph (wa (wne A2 B2) (wne B2 C)) $ >
  $ wi ph (wa (wss (cpr A2 B2) (cfv J I)) (wss (cpr B2 C) (cfv K I))) $ >
  $ wi ph (wral k (wss (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (cfv (cfv (cv k) F) I)) (co cc0 (cfv F chash) cfzo)) $;

--| Construction of a walk from two given edges in a graph. (Contributed by Alexander van der Vekens, 5-Feb-2018.) (Revised by AV, 23-Jan-2021.) (Proof shortened by AV, 14-Feb-2021.) (Revised by AV, 24-Mar-2021.)
theorem _2wlkd (ph: wff) (A2 B2 C P F G I J K V: class):
  $ wceq P (cs3 A2 B2 C) $ >
  $ wceq F (cs2 J K) $ >
  $ wi ph (w3a (wcel A2 V) (wcel B2 V) (wcel C V)) $ >
  $ wi ph (wa (wne A2 B2) (wne B2 C)) $ >
  $ wi ph (wa (wss (cpr A2 B2) (cfv J I)) (wss (cpr B2 C) (cfv K I))) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wbr F P (cfv G cwlks)) $;

--| A walk of length 2 from one vertex to another, different vertex via a third vertex. (Contributed by Alexander van der Vekens, 6-Dec-2017.) (Revised by AV, 30-Jan-2021.) (Revised by AV, 24-Mar-2021.)
theorem _2wlkond (ph: wff) (A2 B2 C P F G I J K V: class):
  $ wceq P (cs3 A2 B2 C) $ >
  $ wceq F (cs2 J K) $ >
  $ wi ph (w3a (wcel A2 V) (wcel B2 V) (wcel C V)) $ >
  $ wi ph (wa (wne A2 B2) (wne B2 C)) $ >
  $ wi ph (wa (wss (cpr A2 B2) (cfv J I)) (wss (cpr B2 C) (cfv K I))) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wbr F P (co A2 C (cfv G cwlkson))) $;

--| Construction of a trail from two given edges in a graph. (Contributed by Alexander van der Vekens, 4-Dec-2017.) (Revised by AV, 24-Jan-2021.) (Revised by AV, 24-Mar-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem _2trld (ph: wff) (A2 B2 C P F G I J K V: class):
  $ wceq P (cs3 A2 B2 C) $ >
  $ wceq F (cs2 J K) $ >
  $ wi ph (w3a (wcel A2 V) (wcel B2 V) (wcel C V)) $ >
  $ wi ph (wa (wne A2 B2) (wne B2 C)) $ >
  $ wi ph (wa (wss (cpr A2 B2) (cfv J I)) (wss (cpr B2 C) (cfv K I))) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wne J K) $ >
  $ wi ph (wbr F P (cfv G ctrls)) $;

--| A trail of length 2 from one vertex to another, different vertex via a third vertex. (Contributed by Alexander van der Vekens, 6-Dec-2017.) (Revised by AV, 30-Jan-2021.) (Revised by AV, 24-Mar-2021.)
theorem _2trlond (ph: wff) (A2 B2 C P F G I J K V: class):
  $ wceq P (cs3 A2 B2 C) $ >
  $ wceq F (cs2 J K) $ >
  $ wi ph (w3a (wcel A2 V) (wcel B2 V) (wcel C V)) $ >
  $ wi ph (wa (wne A2 B2) (wne B2 C)) $ >
  $ wi ph (wa (wss (cpr A2 B2) (cfv J I)) (wss (cpr B2 C) (cfv K I))) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wne J K) $ >
  $ wi ph (wbr F P (co A2 C (cfv G ctrlson))) $;

--| A path of length 2 from one vertex to another vertex via a third vertex. (Contributed by Alexander van der Vekens, 6-Dec-2017.) (Revised by AV, 24-Jan-2021.) (Revised by AV, 24-Mar-2021.)
theorem _2pthd (ph: wff) (A2 B2 C P F G I J K V: class):
  $ wceq P (cs3 A2 B2 C) $ >
  $ wceq F (cs2 J K) $ >
  $ wi ph (w3a (wcel A2 V) (wcel B2 V) (wcel C V)) $ >
  $ wi ph (wa (wne A2 B2) (wne B2 C)) $ >
  $ wi ph (wa (wss (cpr A2 B2) (cfv J I)) (wss (cpr B2 C) (cfv K I))) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wne J K) $ >
  $ wi ph (wbr F P (cfv G cpths)) $;

--| A simple path of length 2 from one vertex to another, different vertex via a third vertex. (Contributed by Alexander van der Vekens, 1-Feb-2018.) (Revised by AV, 24-Jan-2021.) (Revised by AV, 24-Mar-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem _2spthd (ph: wff) (A2 B2 C P F G I J K V: class):
  $ wceq P (cs3 A2 B2 C) $ >
  $ wceq F (cs2 J K) $ >
  $ wi ph (w3a (wcel A2 V) (wcel B2 V) (wcel C V)) $ >
  $ wi ph (wa (wne A2 B2) (wne B2 C)) $ >
  $ wi ph (wa (wss (cpr A2 B2) (cfv J I)) (wss (cpr B2 C) (cfv K I))) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wne J K) $ >
  $ wi ph (wne A2 C) $ >
  $ wi ph (wbr F P (cfv G cspths)) $;

--| A simple path of length 2 from one vertex to another, different vertex via a third vertex. (Contributed by Alexander van der Vekens, 6-Dec-2017.) (Revised by AV, 24-Jan-2021.) (Proof shortened by AV, 30-Jan-2021.) (Revised by AV, 24-Mar-2021.)
theorem _2pthond (ph: wff) (A2 B2 C P F G I J K V: class):
  $ wceq P (cs3 A2 B2 C) $ >
  $ wceq F (cs2 J K) $ >
  $ wi ph (w3a (wcel A2 V) (wcel B2 V) (wcel C V)) $ >
  $ wi ph (wa (wne A2 B2) (wne B2 C)) $ >
  $ wi ph (wa (wss (cpr A2 B2) (cfv J I)) (wss (cpr B2 C) (cfv K I))) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wne J K) $ >
  $ wi ph (wne A2 C) $ >
  $ wi ph (wbr F P (co A2 C (cfv G cspthson))) $;

--| For a vertex adjacent to two other vertices there is a simple path of length 2 between these other vertices in a hypergraph. (Contributed by Alexander van der Vekens, 4-Dec-2017.) (Revised by AV, 24-Jan-2021.)
theorem _2pthon3v {f2 p: setvar} (A2 B2 C: class) (E: class f2 p) (G: class) (V: class f2 p):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (w3a (wa (wcel G cuhgr) (w3a (wcel A2 V) (wcel B2 V) (wcel C V))) (w3a (wne A2 B2) (wne A2 C) (wne B2 C)) (wa (wcel (cpr A2 B2) E) (wcel (cpr B2 C) E))) (wex f2 (wex p (wa (wbr (cv f2) (cv p) (co A2 C (cfv G cspthson))) (wceq (cfv (cv f2) chash) c2)))) $;

--| Lemma for ~ umgr2adedgwlk , ~ umgr2adedgspth , etc. (Contributed by Alexander van der Vekens, 1-Feb-2018.) (Revised by AV, 29-Jan-2021.)
theorem umgr2adedgwlklem (A2 B2 C E G: class):
  $ wceq E (cfv G cedg) $ >
  $ wi (w3a (wcel G cumgr) (wcel (cpr A2 B2) E) (wcel (cpr B2 C) E)) (wa (wa (wne A2 B2) (wne B2 C)) (w3a (wcel A2 (cfv G cvtx)) (wcel B2 (cfv G cvtx)) (wcel C (cfv G cvtx)))) $;

--| In a multigraph, two adjacent edges form a walk of length 2. (Contributed by Alexander van der Vekens, 18-Feb-2018.) (Revised by AV, 29-Jan-2021.)
theorem umgr2adedgwlk (ph: wff) (A2 B2 C P E F G I J K: class):
  $ wceq E (cfv G cedg) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq F (cs2 J K) $ >
  $ wceq P (cs3 A2 B2 C) $ >
  $ wi ph (wcel G cumgr) $ >
  $ wi ph (wa (wcel (cpr A2 B2) E) (wcel (cpr B2 C) E)) $ >
  $ wi ph (wceq (cfv J I) (cpr A2 B2)) $ >
  $ wi ph (wceq (cfv K I) (cpr B2 C)) $ >
  $ wi ph (w3a (wbr F P (cfv G cwlks)) (wceq (cfv F chash) c2) (w3a (wceq A2 (cfv cc0 P)) (wceq B2 (cfv c1 P)) (wceq C (cfv c2 P)))) $;

--| In a multigraph, two adjacent edges form a walk between two vertices. (Contributed by Alexander van der Vekens, 18-Feb-2018.) (Revised by AV, 30-Jan-2021.)
theorem umgr2adedgwlkon (ph: wff) (A2 B2 C P E F G I J K: class):
  $ wceq E (cfv G cedg) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq F (cs2 J K) $ >
  $ wceq P (cs3 A2 B2 C) $ >
  $ wi ph (wcel G cumgr) $ >
  $ wi ph (wa (wcel (cpr A2 B2) E) (wcel (cpr B2 C) E)) $ >
  $ wi ph (wceq (cfv J I) (cpr A2 B2)) $ >
  $ wi ph (wceq (cfv K I) (cpr B2 C)) $ >
  $ wi ph (wbr F P (co A2 C (cfv G cwlkson))) $;

--| Alternate proof for ~ umgr2adedgwlkon , using ~ umgr2adedgwlk , but with a much longer proof! In a multigraph, two adjacent edges form a walk between two (different) vertices. (Contributed by Alexander van der Vekens, 18-Feb-2018.) (Revised by AV, 30-Jan-2021.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem umgr2adedgwlkonALT (ph: wff) (A2 B2 C P E F G I J K: class):
  $ wceq E (cfv G cedg) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq F (cs2 J K) $ >
  $ wceq P (cs3 A2 B2 C) $ >
  $ wi ph (wcel G cumgr) $ >
  $ wi ph (wa (wcel (cpr A2 B2) E) (wcel (cpr B2 C) E)) $ >
  $ wi ph (wceq (cfv J I) (cpr A2 B2)) $ >
  $ wi ph (wceq (cfv K I) (cpr B2 C)) $ >
  $ wi ph (wbr F P (co A2 C (cfv G cwlkson))) $;

--| In a multigraph, two adjacent edges with different endvertices form a simple path of length 2. (Contributed by Alexander van der Vekens, 1-Feb-2018.) (Revised by AV, 29-Jan-2021.)
theorem umgr2adedgspth (ph: wff) (A2 B2 C P E F G I J K: class):
  $ wceq E (cfv G cedg) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wceq F (cs2 J K) $ >
  $ wceq P (cs3 A2 B2 C) $ >
  $ wi ph (wcel G cumgr) $ >
  $ wi ph (wa (wcel (cpr A2 B2) E) (wcel (cpr B2 C) E)) $ >
  $ wi ph (wceq (cfv J I) (cpr A2 B2)) $ >
  $ wi ph (wceq (cfv K I) (cpr B2 C)) $ >
  $ wi ph (wne A2 C) $ >
  $ wi ph (wbr F P (cfv G cspths)) $;

--| In a multigraph, there is a walk of length 2 for each pair of adjacent edges. (Contributed by Alexander van der Vekens, 18-Feb-2018.) (Revised by AV, 30-Jan-2021.)
theorem umgr2wlk {f2 p: setvar} (A2 B2 C: class) (E: class f2 p) (G: class):
  $ wceq E (cfv G cedg) $ >
  $ wi (w3a (wcel G cumgr) (wcel (cpr A2 B2) E) (wcel (cpr B2 C) E)) (wex f2 (wex p (w3a (wbr (cv f2) (cv p) (cfv G cwlks)) (wceq (cfv (cv f2) chash) c2) (w3a (wceq A2 (cfv cc0 (cv p))) (wceq B2 (cfv c1 (cv p))) (wceq C (cfv c2 (cv p))))))) $;

--| For each pair of adjacent edges in a multigraph, there is a walk of length 2 between the not common vertices of the edges. (Contributed by Alexander van der Vekens, 18-Feb-2018.) (Revised by AV, 30-Jan-2021.)
theorem umgr2wlkon {f2 p: setvar} (A2 B2 C E G: class):
  $ wceq E (cfv G cedg) $ >
  $ wi (w3a (wcel G cumgr) (wcel (cpr A2 B2) E) (wcel (cpr B2 C) E)) (wex f2 (wex p (wbr (cv f2) (cv p) (co A2 C (cfv G cwlkson))))) $;

--| A walk of length 2 as word is a length 3 string. (Contributed by AV, 18-May-2021.)
theorem elwwlks2s3 {a b c: setvar} (G: class a b c) (V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel W (co c2 G cwwlksn)) (wrex a (wrex b (wrex c (wceq W (cs3 (cv a) (cv b) (cv c))) V) V) V) $;

--| There is a vertex between the endpoints of a walk of length 2 between two vertices as length 3 string. (Contributed by AV, 10-Jan-2022.)
theorem midwwlks2s3 {b: setvar} (G: class b) (V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel W (co c2 G cwwlksn)) (wrex b (wceq (cfv c1 W) (cv b)) V) $;

--| If a length 3 string represents a walk of length 2, its components are vertices. (Contributed by Alexander van der Vekens, 19-Feb-2018.) (Proof shortened by AV, 14-Mar-2022.)
theorem wwlks2onv (A2 B2 C U G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel B2 U) (wcel (cs3 A2 B2 C) (co A2 C (co c2 G cwwlksnon)))) (w3a (wcel A2 V) (wcel B2 V) (wcel C V)) $;

--| A walk as word of length 2 between two vertices is a length 3 string and its second symbol is a vertex. (Contributed by AV, 14-Mar-2022.)
theorem elwwlks2ons3im (A2 C G V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel W (co A2 C (co c2 G cwwlksnon))) (wa (wceq W (cs3 A2 (cfv c1 W) C)) (wcel (cfv c1 W) V)) $;

--| For each walk of length 2 between two vertices, there is a third vertex in the middle of the walk. (Contributed by Alexander van der Vekens, 15-Feb-2018.) (Revised by AV, 12-May-2021.) (Revised by AV, 14-Mar-2022.)
theorem elwwlks2ons3 {b: setvar} (A2 C G V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wb (wcel W (co A2 C (co c2 G cwwlksnon))) (wrex b (wa (wceq W (cs3 A2 (cv b) C)) (wcel (cs3 A2 (cv b) C) (co A2 C (co c2 G cwwlksnon)))) V) $;

--| A length 3 string which represents a walk of length 2 between two vertices. (Contributed by Alexander van der Vekens, 15-Feb-2018.) (Revised by AV, 12-May-2021.)
theorem s3wwlks2on {f2: setvar} (A2 B2 C G: class) (V: class f2):
  $ wceq V (cfv G cvtx) $ >
  $ wi (w3a (wcel G cupgr) (wcel A2 V) (wcel C V)) (wb (wcel (cs3 A2 B2 C) (co A2 C (co c2 G cwwlksnon))) (wex f2 (wa (wbr (cv f2) (cs3 A2 B2 C) (cfv G cwlks)) (wceq (cfv (cv f2) chash) c2)))) $;

--| A length 3 string which represents a walk of length 2 between two vertices. Concerns simple pseudographs, in contrast to ~ s3wwlks2on and does not require the Axiom of Choice for its proof. (Contributed by Ender Ting, 28-Jan-2026.)
theorem sps3wwlks2on {f2: setvar} (A2 B2 C G: class) (V: class f2):
  $ wceq V (cfv G cvtx) $ >
  $ wi (w3a (wcel G cuspgr) (wcel A2 V) (wcel C V)) (wb (wcel (cs3 A2 B2 C) (co A2 C (co c2 G cwwlksnon))) (wex f2 (wa (wbr (cv f2) (cs3 A2 B2 C) (cfv G cwlks)) (wceq (cfv (cv f2) chash) c2)))) $;

--| A walk of length 2 between two vertices as word in a simple graph. This theorem is analogous to ~ umgrwwlks2on except it talks about simple graphs and therefore does not require the Axiom of Choice for its proof. (Contributed by Ender Ting, 29-Jan-2026.)
theorem usgrwwlks2on (A2 B2 C E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cusgr) (w3a (wcel A2 V) (wcel B2 V) (wcel C V))) (wb (wcel (cs3 A2 B2 C) (co A2 C (co c2 G cwwlksnon))) (wa (wcel (cpr A2 B2) E) (wcel (cpr B2 C) E))) $;

--| A walk of length 2 between two vertices as word in a multigraph. This theorem would also hold for pseudographs, but to prove this the cases ` A = B ` and/or ` B = C ` must be considered separately. (Contributed by Alexander van der Vekens, 18-Feb-2018.) (Revised by AV, 12-May-2021.)
theorem umgrwwlks2on (A2 B2 C E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cumgr) (w3a (wcel A2 V) (wcel B2 V) (wcel C V))) (wb (wcel (cs3 A2 B2 C) (co A2 C (co c2 G cwwlksnon))) (wa (wcel (cpr A2 B2) E) (wcel (cpr B2 C) E))) $;

--| There is a walk of length 2 from one vertex to another vertex iff there is a walk of length 2 from the other vertex to the first vertex. (Contributed by AV, 7-Jan-2022.)
theorem wwlks2onsym (A2 B2 C G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel G cumgr) (w3a (wcel A2 V) (wcel B2 V) (wcel C V))) (wb (wcel (cs3 A2 B2 C) (co A2 C (co c2 G cwwlksnon))) (wcel (cs3 C B2 A2) (co C A2 (co c2 G cwwlksnon)))) $;

--| A walk of length 2 between two vertices as length 3 string. (Contributed by Alexander van der Vekens, 15-Feb-2018.) (Revised by AV, 12-May-2021.)
theorem elwwlks2on {f2 b: setvar} (A2 C G: class) (V: class f2) (W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (w3a (wcel G cupgr) (wcel A2 V) (wcel C V)) (wb (wcel W (co A2 C (co c2 G cwwlksnon))) (wrex b (wa (wceq W (cs3 A2 (cv b) C)) (wex f2 (wa (wbr (cv f2) W (cfv G cwlks)) (wceq (cfv (cv f2) chash) c2)))) V)) $;

--| A simple path of length 2 between two vertices (in a graph) as length 3 string. (Contributed by Alexander van der Vekens, 9-Mar-2018.) (Revised by AV, 12-May-2021.) (Proof shortened by AV, 16-Mar-2022.)
theorem elwspths2on {b: setvar} (A2 C G V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (w3a (wcel G cupgr) (wcel A2 V) (wcel C V)) (wb (wcel W (co A2 C (co c2 G cwwspthsnon))) (wrex b (wa (wceq W (cs3 A2 (cv b) C)) (wcel (cs3 A2 (cv b) C) (co A2 C (co c2 G cwwspthsnon)))) V)) $;

--| A simple path of length 2 between two vertices (in a simple pseudograph) as length 3 string. This theorem avoids the Axiom of Choice for its proof, at the cost of requiring a simple graph; the more general version is ~ elwspths2on . (Contributed by Ender Ting, 29-Jan-2026.)
theorem elwspths2onw {b: setvar} (A2 C G V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (w3a (wcel G cuspgr) (wcel A2 V) (wcel C V)) (wb (wcel W (co A2 C (co c2 G cwwspthsnon))) (wrex b (wa (wceq W (cs3 A2 (cv b) C)) (wcel (cs3 A2 (cv b) C) (co A2 C (co c2 G cwwspthsnon)))) V)) $;

--| For two different vertices, a walk of length 2 between these vertices is a simple path of length 2 between these vertices in a simple graph. (Contributed by Alexander van der Vekens, 2-Mar-2018.) (Revised by AV, 16-Mar-2022.) (Revised by Ender Ting, 29-Jan-2026.)
theorem wpthswwlks2on (A2 B2 G: class):
  $ wi (wa (wcel G cusgr) (wne A2 B2)) (wceq (co A2 B2 (co c2 G cwwspthsnon)) (co A2 B2 (co c2 G cwwlksnon))) $;

--| All simple paths of length 2 from a fixed vertex to another vertex are disjunct. (Contributed by Alexander van der Vekens, 4-Mar-2018.) (Revised by AV, 9-Jan-2022.)
theorem _2wspdisj {b: setvar} (A2 G V: class):
  $ wdisj b (cdif V (csn A2)) (co A2 (cv b) (co c2 G cwwspthsnon)) $;

--| All simple paths of length 2 from a fixed vertex to another vertex are disjunct. (Contributed by Alexander van der Vekens, 5-Mar-2018.) (Revised by AV, 14-May-2021.) (Proof shortened by AV, 9-Jan-2022.)
theorem _2wspiundisj {a b: setvar} (G V: class):
  $ wdisj a V (ciun b (cdif V (csn (cv a))) (co (cv a) (cv b) (co c2 G cwwspthsnon))) $;

--| A simple path of length 2 between two vertices represented as length 3 string corresponds to two adjacent edges in a simple graph. (Contributed by Alexander van der Vekens, 8-Mar-2018.) (Revised by AV, 17-May-2021.) (Proof shortened by AV, 16-Mar-2022.) (Revised by Ender Ting, 29-Jan-2026.)
theorem usgr2wspthons3 (A2 B2 C E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cusgr) (w3a (wcel A2 V) (wcel B2 V) (wcel C V))) (wb (wcel (cs3 A2 B2 C) (co A2 C (co c2 G cwwspthsnon))) (w3a (wne A2 C) (wcel (cpr A2 B2) E) (wcel (cpr B2 C) E))) $;

--| A simple path of length 2 between two vertices corresponds to two adjacent edges in a simple graph. (Contributed by Alexander van der Vekens, 9-Mar-2018.) (Revised by AV, 17-May-2021.) (Revised by Ender Ting, 29-Jan-2026.)
theorem usgr2wspthon {b: setvar} (A2 C T: class) (E: class b) (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel G cusgr) (wa (wcel A2 V) (wcel C V))) (wb (wcel T (co A2 C (co c2 G cwwspthsnon))) (wrex b (wa (wa (wceq T (cs3 A2 (cv b) C)) (wne A2 C)) (wa (wcel (cpr A2 (cv b)) E) (wcel (cpr (cv b) C) E))) V)) $;

--| A walk of length 2 between two vertices as length 3 string in a pseudograph. (Contributed by Alexander van der Vekens, 21-Feb-2018.) (Revised by AV, 17-May-2021.) (Proof shortened by AV, 14-Mar-2022.)
theorem elwwlks2 {f2 p a b c: setvar} (G V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel G cupgr) (wb (wcel W (co c2 G cwwlksn)) (wrex a (wrex b (wrex c (wa (wceq W (cs3 (cv a) (cv b) (cv c))) (wex f2 (wex p (w3a (wbr (cv f2) (cv p) (cfv G cwlks)) (wceq (cfv (cv f2) chash) c2) (w3a (wceq (cv a) (cfv cc0 (cv p))) (wceq (cv b) (cfv c1 (cv p))) (wceq (cv c) (cfv c2 (cv p)))))))) V) V) V)) $;

--| A simple path of length 2 between two vertices as length 3 string in a pseudograph. (Contributed by Alexander van der Vekens, 28-Feb-2018.) (Revised by AV, 18-May-2021.) (Proof shortened by AV, 16-Mar-2022.)
theorem elwspths2spth {f2 p a b c: setvar} (G V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel G cupgr) (wb (wcel W (co c2 G cwwspthsn)) (wrex a (wrex b (wrex c (wa (wceq W (cs3 (cv a) (cv b) (cv c))) (wex f2 (wex p (w3a (wbr (cv f2) (cv p) (cfv G cspths)) (wceq (cfv (cv f2) chash) c2) (w3a (wceq (cv a) (cfv cc0 (cv p))) (wceq (cv b) (cfv c1 (cv p))) (wceq (cv c) (cfv c2 (cv p)))))))) V) V) V)) $;

--| In a k-regular graph, there are k walks (as word) of length 1 starting at each vertex. (Contributed by Alexander van der Vekens, 28-Jul-2018.) (Revised by AV, 7-May-2021.)
theorem rusgrnumwwlkl1 {w: setvar} (P G K V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wbr G K crusgr) (wcel P V)) (wceq (cfv (crab w (wceq (cfv cc0 (cv w)) P) (co c1 G cwwlksn)) chash) K) $;

--| Lemma for ~ rusgrnumwwlks . (Contributed by Alexander van der Vekens, 23-Aug-2018.)
theorem rusgrnumwwlkslem {w: setvar} (ph ps: wff w) (P: class) (X: class w) (Y Z: class):
  $ wi (wcel Y (crab w (wceq (cfv cc0 (cv w)) P) Z)) (wceq (crab w (wa ph ps) X) (crab w (w3a ph (wceq (cfv cc0 Y) P) ps) X)) $;

--| Lemma for ~ rusgrnumwwlk etc. (Contributed by Alexander van der Vekens, 21-Jul-2018.) (Revised by AV, 7-May-2021.)
theorem rusgrnumwwlklem {w v n: setvar} (P G: class) (L: class w v n) (N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq L (cmpo v n V cn0 (cfv (crab w (wceq (cfv cc0 (cv w)) (cv v)) (co (cv n) G cwwlksn)) chash)) $ >
  $ wi (wa (wcel P V) (wcel N cn0)) (wceq (co P N L) (cfv (crab w (wceq (cfv cc0 (cv w)) P) (co N G cwwlksn)) chash)) $;

--| Induction base 0 for ~ rusgrnumwwlk . Here, we do not need the regularity of the graph yet. (Contributed by Alexander van der Vekens, 24-Jul-2018.) (Revised by AV, 7-May-2021.)
theorem rusgrnumwwlkb0 {w v n: setvar} (P G: class) (L: class w v n) (V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq L (cmpo v n V cn0 (cfv (crab w (wceq (cfv cc0 (cv w)) (cv v)) (co (cv n) G cwwlksn)) chash)) $ >
  $ wi (wa (wcel G cuspgr) (wcel P V)) (wceq (co P cc0 L) c1) $;

--| Induction base 1 for ~ rusgrnumwwlk . (Contributed by Alexander van der Vekens, 28-Jul-2018.) (Revised by AV, 7-May-2021.)
theorem rusgrnumwwlkb1 {w v n: setvar} (P G: class) (K: class v n) (L: class w v n) (V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq L (cmpo v n V cn0 (cfv (crab w (wceq (cfv cc0 (cv w)) (cv v)) (co (cv n) G cwwlksn)) chash)) $ >
  $ wi (wa (wbr G K crusgr) (wcel P V)) (wceq (co P c1 L) K) $;

--| Special case for graphs without edges: There are no walks of length greater than 0. (Contributed by Alexander van der Vekens, 26-Jul-2018.) (Revised by AV, 7-May-2021.)
theorem rusgr0edg {w v n: setvar} (P G: class) (L: class w v n) (N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq L (cmpo v n V cn0 (cfv (crab w (wceq (cfv cc0 (cv w)) (cv v)) (co (cv n) G cwwlksn)) chash)) $ >
  $ wi (w3a (wbr G cc0 crusgr) (wcel P V) (wcel N cn)) (wceq (co P N L) cc0) $;

--| Induction step for ~ rusgrnumwwlk . (Contributed by Alexander van der Vekens, 24-Aug-2018.) (Revised by AV, 7-May-2021.) (Proof shortened by AV, 27-May-2022.)
theorem rusgrnumwwlks {w v n: setvar} (P G: class) (K: class v n) (L: class w v n) (N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq L (cmpo v n V cn0 (cfv (crab w (wceq (cfv cc0 (cv w)) (cv v)) (co (cv n) G cwwlksn)) chash)) $ >
  $ wi (wa (wbr G K crusgr) (w3a (wcel V cfn) (wcel P V) (wcel N cn0))) (wi (wceq (co P N L) (co K N cexp)) (wceq (co P (co N c1 caddc) L) (co K (co N c1 caddc) cexp))) $;

--| In a ` K `-regular graph, the number of walks of a fixed length ` N ` from a fixed vertex is ` K ` to the power of ` N ` . By definition, ` ( N WWalksN G ) ` is the set of walks (as words) with length ` N ` , and ` ( P L N ) ` is the number of walks with length ` N ` starting at the vertex ` P ` . Because of the ` K `-regularity, a walk can be continued in ` K ` different ways at the end vertex of the walk, and this repeated ` N ` times. This theorem even holds for ` N = 0 ` : in this case, the walk consists of only one vertex ` P ` , so the number of walks of length ` N = 0 ` starting with ` P ` is ` ( K ^ 0 ) = 1 ` . (Contributed by Alexander van der Vekens, 24-Aug-2018.) (Revised by AV, 7-May-2021.)
theorem rusgrnumwwlk {w v n: setvar} (P G: class) (K: class v n) (L: class w v n) (N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq L (cmpo v n V cn0 (cfv (crab w (wceq (cfv cc0 (cv w)) (cv v)) (co (cv n) G cwwlksn)) chash)) $ >
  $ wi (wa (wbr G K crusgr) (w3a (wcel V cfn) (wcel P V) (wcel N cn0))) (wceq (co P N L) (co K N cexp)) $;

--| In a ` K `-regular graph, the number of walks (as words) of a fixed length ` N ` from a fixed vertex is ` K ` to the power of ` N ` . Closed form of ~ rusgrnumwwlk . (Contributed by Alexander van der Vekens, 30-Sep-2018.) (Revised by AV, 7-May-2021.)
theorem rusgrnumwwlkg {w: setvar} (P G K N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wbr G K crusgr) (w3a (wcel V cfn) (wcel P V) (wcel N cn0))) (wceq (cfv (crab w (wceq (cfv cc0 (cv w)) P) (co N G cwwlksn)) chash) (co K N cexp)) $;

--| In a k-regular graph, the number of walks of a fixed length n from a fixed vertex is k to the power of n. This theorem corresponds to statement 11 in [Huneke] p. 2: "The total number of walks v(0) v(1) ... v(n-2) from a fixed vertex v = v(0) is k^(n-2) as G is k-regular." This theorem even holds for n=0: then the walk consists of only one vertex v(0), so the number of walks of length n=0 starting with v=v(0) is 1=k^0. (Contributed by Alexander van der Vekens, 24-Aug-2018.) (Revised by AV, 7-May-2021.) (Proof shortened by AV, 5-Aug-2022.)
theorem rusgrnumwlkg {w: setvar} (P G K N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wbr G K crusgr) (w3a (wcel V cfn) (wcel P V) (wcel N cn0))) (wceq (cfv (crab w (wa (wceq (cfv (cfv (cv w) c1st) chash) N) (wceq (cfv cc0 (cfv (cv w) c2nd)) P)) (cfv G cwlks)) chash) (co K N cexp)) $;

--| The set ` A ` of walks of length ` N ` starting with a fixed vertex ` V ` and ending not at this vertex is the difference between the set ` C ` of walks of length ` N ` starting with this vertex ` X ` and the set ` B ` of closed walks of length ` N ` anchored at this vertex ` X ` . (Contributed by Alexander van der Vekens, 30-Sep-2018.) (Revised by AV, 7-May-2021.) (Revised by AV, 16-Mar-2022.)
theorem clwwlknclwwlkdif {w: setvar} (A2 B2 C: class w) (G N X: class):
  $ wceq A2 (crab w (wa (wceq (cfv cc0 (cv w)) X) (wne (cfv (cv w) clsw) X)) (co N G cwwlksn)) $ >
  $ wceq B2 (co X X (co N G cwwlksnon)) $ >
  $ wceq C (crab w (wceq (cfv cc0 (cv w)) X) (co N G cwwlksn)) $ >
  $ wceq A2 (cdif C B2) $;

--| In a ` K `-regular graph, the size of the set ` A ` of walks of length ` N ` starting with a fixed vertex ` X ` and ending not at this vertex is the difference between ` K ` to the power of ` N ` and the size of the set ` B ` of closed walks of length ` N ` anchored at this vertex ` X ` . (Contributed by Alexander van der Vekens, 30-Sep-2018.) (Revised by AV, 7-May-2021.) (Revised by AV, 8-Mar-2022.) (Proof shortened by AV, 16-Mar-2022.)
theorem clwwlknclwwlkdifnum {w: setvar} (A2 B2: class w) (G K N V X: class):
  $ wceq A2 (crab w (wa (wceq (cfv cc0 (cv w)) X) (wne (cfv (cv w) clsw) X)) (co N G cwwlksn)) $ >
  $ wceq B2 (co X X (co N G cwwlksnon)) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wa (wbr G K crusgr) (wcel V cfn)) (wa (wcel X V) (wcel N cn0))) (wceq (cfv A2 chash) (co (co K N cexp) (cfv B2 chash) cmin)) $;

--| Extend class notation with closed walks (in an undirected graph) as word over the set of vertices.
term cclwwlk: class;

--| Define the set of all closed walks (in an undirected graph) as words over the set of vertices. Such a word corresponds to the sequence p(0) p(1) ... p(n-1) of the vertices in a closed walk p(0) e(f(1)) p(1) e(f(2)) ... p(n-1) e(f(n)) p(n)=p(0) as defined in ~ df-clwlks . Notice that the word does not contain the terminating vertex p(n) of the walk, because it is always equal to the first vertex of the closed walk. (Contributed by Alexander van der Vekens, 20-Mar-2018.) (Revised by AV, 24-Apr-2021.)
axiom df_clwwlk {w g2 i: setvar}:
  $ wceq cclwwlk (cmpt g2 cvv (crab w (w3a (wne (cv w) c0) (wral i (wcel (cpr (cfv (cv i) (cv w)) (cfv (co (cv i) c1 caddc) (cv w))) (cfv (cv g2) cedg)) (co cc0 (co (cfv (cv w) chash) c1 cmin) cfzo)) (wcel (cpr (cfv (cv w) clsw) (cfv cc0 (cv w))) (cfv (cv g2) cedg))) (cword (cfv (cv g2) cvtx)))) $;

--| The set of closed walks (in an undirected graph) as words over the set of vertices. (Contributed by Alexander van der Vekens, 20-Mar-2018.) (Revised by AV, 24-Apr-2021.)
theorem clwwlk {w i: setvar} (E: class w i) (G: class) (V: class i):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq (cfv G cclwwlk) (crab w (w3a (wne (cv w) c0) (wral i (wcel (cpr (cfv (cv i) (cv w)) (cfv (co (cv i) c1 caddc) (cv w))) E) (co cc0 (co (cfv (cv w) chash) c1 cmin) cfzo)) (wcel (cpr (cfv (cv w) clsw) (cfv cc0 (cv w))) E)) (cword V)) $;

--| Properties of a word to represent a closed walk (in an undirected graph). (Contributed by Alexander van der Vekens, 20-Mar-2018.) (Revised by AV, 24-Apr-2021.)
theorem isclwwlk {i: setvar} (E: class i) (G: class) (V: class i) (W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wb (wcel W (cfv G cclwwlk)) (w3a (wa (wcel W (cword V)) (wne W c0)) (wral i (wcel (cpr (cfv (cv i) W) (cfv (co (cv i) c1 caddc) W)) E) (co cc0 (co (cfv W chash) c1 cmin) cfzo)) (wcel (cpr (cfv W clsw) (cfv cc0 W)) E)) $;

--| Basic properties of a closed walk (in an undirected graph) as word. (Contributed by Alexander van der Vekens, 15-Mar-2018.) (Revised by AV, 24-Apr-2021.)
theorem clwwlkbp (G V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel W (cfv G cclwwlk)) (w3a (wcel G cvv) (wcel W (cword V)) (wne W c0)) $;

--| There is no empty closed walk (i.e. a closed walk without any edge) represented by a word of vertices. (Contributed by Alexander van der Vekens, 15-Sep-2018.) (Revised by AV, 24-Apr-2021.)
theorem clwwlkgt0 (G W: class):
  $ wi (wcel W (cfv G cclwwlk)) (wbr cc0 (cfv W chash) clt) $;

--| Closed walks (represented by words) are words. (Contributed by Alexander van der Vekens, 25-Mar-2018.) (Revised by AV, 25-Apr-2021.)
theorem clwwlksswrd (G: class):
  $ wss (cfv G cclwwlk) (cword (cfv G cvtx)) $;

--| A closed walk of length 1 is a loop. See also ~ clwlkl1loop . (Contributed by AV, 24-Apr-2021.)
theorem clwwlk1loop (G W: class):
  $ wi (wa (wcel W (cfv G cclwwlk)) (wceq (cfv W chash) c1)) (wcel (cpr (cfv cc0 W) (cfv cc0 W)) (cfv G cedg)) $;

--| Lemma for ~ clwwlkccat : index ` j ` is shifted up by ` ( # `` A ) ` , and the case ` i = ( ( # `` A ) - 1 ) ` is covered by the "bridge" ` { ( lastS `` A ) , ( B `` 0 ) } = { ( lastS `` A ) , ( A `` 0 ) } ` ` e. ( Edg `` G ) ` . (Contributed by AV, 23-Apr-2022.)
theorem clwwlkccatlem {i j: setvar} (A2 B2 G: class):
  $ wi (w3a (w3a (wa (wcel A2 (cword (cfv G cvtx))) (wne A2 c0)) (wral i (wcel (cpr (cfv (cv i) A2) (cfv (co (cv i) c1 caddc) A2)) (cfv G cedg)) (co cc0 (co (cfv A2 chash) c1 cmin) cfzo)) (wcel (cpr (cfv A2 clsw) (cfv cc0 A2)) (cfv G cedg))) (w3a (wa (wcel B2 (cword (cfv G cvtx))) (wne B2 c0)) (wral j (wcel (cpr (cfv (cv j) B2) (cfv (co (cv j) c1 caddc) B2)) (cfv G cedg)) (co cc0 (co (cfv B2 chash) c1 cmin) cfzo)) (wcel (cpr (cfv B2 clsw) (cfv cc0 B2)) (cfv G cedg))) (wceq (cfv cc0 A2) (cfv cc0 B2))) (wral i (wcel (cpr (cfv (cv i) (co A2 B2 cconcat)) (cfv (co (cv i) c1 caddc) (co A2 B2 cconcat))) (cfv G cedg)) (co cc0 (co (cfv (co A2 B2 cconcat) chash) c1 cmin) cfzo)) $;

--| The concatenation of two words representing closed walks anchored at the same vertex represents a closed walk. The resulting walk is a "double loop", starting at the common vertex, coming back to the common vertex by the first walk, following the second walk and finally coming back to the common vertex again. (Contributed by AV, 23-Apr-2022.)
theorem clwwlkccat (A2 B2 G: class):
  $ wi (w3a (wcel A2 (cfv G cclwwlk)) (wcel B2 (cfv G cclwwlk)) (wceq (cfv cc0 A2) (cfv cc0 B2))) (wcel (co A2 B2 cconcat) (cfv G cclwwlk)) $;

--| A closed walk in a multigraph has a length of at least 2 (because it cannot have a loop). (Contributed by Alexander van der Vekens, 16-Sep-2018.) (Revised by AV, 24-Apr-2021.)
theorem umgrclwwlkge2 (P G: class):
  $ wi (wcel G cumgr) (wi (wcel P (cfv G cclwwlk)) (wbr c2 (cfv P chash) cle)) $;

--| Lemma 1 for ~ clwlkclwwlklem2a . (Contributed by Alexander van der Vekens, 21-Jun-2018.) (Revised by AV, 11-Apr-2021.)
theorem clwlkclwwlklem2a1 {i: setvar} (P E: class) (V: class i):
  $ wi (wa (wcel P (cword V)) (wbr c2 (cfv P chash) cle)) (wi (wa (wceq (cfv P clsw) (cfv cc0 P)) (wa (wral i (wcel (cpr (cfv (cv i) P) (cfv (co (cv i) c1 caddc) P)) (crn E)) (co cc0 (co (co (co (cfv P chash) c1 cmin) cc0 cmin) c1 cmin) cfzo)) (wcel (cpr (cfv (co (cfv P chash) c2 cmin) P) (cfv cc0 P)) (crn E)))) (wral i (wcel (cpr (cfv (cv i) P) (cfv (co (cv i) c1 caddc) P)) (crn E)) (co cc0 (co (cfv P chash) c1 cmin) cfzo))) $;

--| Lemma 2 for ~ clwlkclwwlklem2a . (Contributed by Alexander van der Vekens, 21-Jun-2018.)
theorem clwlkclwwlklem2a2 {x3: setvar} (P: class) (E F V: class x3):
  $ wceq F (cmpt x3 (co cc0 (co (cfv P chash) c1 cmin) cfzo) (cif (wbr (cv x3) (co (cfv P chash) c2 cmin) clt) (cfv (cpr (cfv (cv x3) P) (cfv (co (cv x3) c1 caddc) P)) (ccnv E)) (cfv (cpr (cfv (cv x3) P) (cfv cc0 P)) (ccnv E)))) $ >
  $ wi (wa (wcel P (cword V)) (wbr c2 (cfv P chash) cle)) (wceq (cfv F chash) (co (cfv P chash) c1 cmin)) $;

--| Lemma 3 for ~ clwlkclwwlklem2a . (Contributed by Alexander van der Vekens, 21-Jun-2018.)
theorem clwlkclwwlklem2a3 {x3: setvar} (P E: class) (F: class x3) (V: class):
  $ wceq F (cmpt x3 (co cc0 (co (cfv P chash) c1 cmin) cfzo) (cif (wbr (cv x3) (co (cfv P chash) c2 cmin) clt) (cfv (cpr (cfv (cv x3) P) (cfv (co (cv x3) c1 caddc) P)) (ccnv E)) (cfv (cpr (cfv (cv x3) P) (cfv cc0 P)) (ccnv E)))) $ >
  $ wi (wa (wcel P (cword V)) (wbr c2 (cfv P chash) cle)) (wceq (cfv (cfv F chash) P) (cfv P clsw)) $;

--| Lemma 4a for ~ clwlkclwwlklem2a . (Contributed by Alexander van der Vekens, 22-Jun-2018.)
theorem clwlkclwwlklem2fv1 {x3: setvar} (P E: class) (F: class x3) (I: class):
  $ wceq F (cmpt x3 (co cc0 (co (cfv P chash) c1 cmin) cfzo) (cif (wbr (cv x3) (co (cfv P chash) c2 cmin) clt) (cfv (cpr (cfv (cv x3) P) (cfv (co (cv x3) c1 caddc) P)) (ccnv E)) (cfv (cpr (cfv (cv x3) P) (cfv cc0 P)) (ccnv E)))) $ >
  $ wi (wa (wcel (cfv P chash) cn0) (wcel I (co cc0 (co (cfv P chash) c2 cmin) cfzo))) (wceq (cfv I F) (cfv (cpr (cfv I P) (cfv (co I c1 caddc) P)) (ccnv E))) $;

--| Lemma 4b for ~ clwlkclwwlklem2a . (Contributed by Alexander van der Vekens, 22-Jun-2018.)
theorem clwlkclwwlklem2fv2 {x3: setvar} (P E: class) (F: class x3):
  $ wceq F (cmpt x3 (co cc0 (co (cfv P chash) c1 cmin) cfzo) (cif (wbr (cv x3) (co (cfv P chash) c2 cmin) clt) (cfv (cpr (cfv (cv x3) P) (cfv (co (cv x3) c1 caddc) P)) (ccnv E)) (cfv (cpr (cfv (cv x3) P) (cfv cc0 P)) (ccnv E)))) $ >
  $ wi (wa (wcel (cfv P chash) cn0) (wbr c2 (cfv P chash) cle)) (wceq (cfv (co (cfv P chash) c2 cmin) F) (cfv (cpr (cfv (co (cfv P chash) c2 cmin) P) (cfv cc0 P)) (ccnv E))) $;

--| Lemma 4 for ~ clwlkclwwlklem2a . (Contributed by Alexander van der Vekens, 21-Jun-2018.) (Revised by AV, 11-Apr-2021.)
theorem clwlkclwwlklem2a4 {x3: setvar} (P: class) (R: class x3) (E: class) (F: class x3) (I V: class):
  $ wceq F (cmpt x3 (co cc0 (co (cfv P chash) c1 cmin) cfzo) (cif (wbr (cv x3) (co (cfv P chash) c2 cmin) clt) (cfv (cpr (cfv (cv x3) P) (cfv (co (cv x3) c1 caddc) P)) (ccnv E)) (cfv (cpr (cfv (cv x3) P) (cfv cc0 P)) (ccnv E)))) $ >
  $ wi (w3a (wf1 (cdm E) R E) (wcel P (cword V)) (wbr c2 (cfv P chash) cle)) (wi (wa (wceq (cfv P clsw) (cfv cc0 P)) (wcel I (co cc0 (co (cfv P chash) c1 cmin) cfzo))) (wi (wcel (cpr (cfv I P) (cfv (co I c1 caddc) P)) (crn E)) (wceq (cfv (cfv I F) E) (cpr (cfv I P) (cfv (co I c1 caddc) P))))) $;

--| Lemma for ~ clwlkclwwlklem2 . (Contributed by Alexander van der Vekens, 22-Jun-2018.) (Revised by AV, 11-Apr-2021.)
theorem clwlkclwwlklem2a {x3 i: setvar} (P R E: class) (F: class x3) (V: class):
  $ wceq F (cmpt x3 (co cc0 (co (cfv P chash) c1 cmin) cfzo) (cif (wbr (cv x3) (co (cfv P chash) c2 cmin) clt) (cfv (cpr (cfv (cv x3) P) (cfv (co (cv x3) c1 caddc) P)) (ccnv E)) (cfv (cpr (cfv (cv x3) P) (cfv cc0 P)) (ccnv E)))) $ >
  $ wi (w3a (wf1 (cdm E) R E) (wcel P (cword V)) (wbr c2 (cfv P chash) cle)) (wi (wa (wceq (cfv P clsw) (cfv cc0 P)) (wa (wral i (wcel (cpr (cfv (cv i) P) (cfv (co (cv i) c1 caddc) P)) (crn E)) (co cc0 (co (co (co (cfv P chash) c1 cmin) cc0 cmin) c1 cmin) cfzo)) (wcel (cpr (cfv (co (cfv P chash) c2 cmin) P) (cfv cc0 P)) (crn E)))) (wa (w3a (wcel F (cword (cdm E))) (wf (co cc0 (cfv F chash) cfz) V P) (wral i (wceq (cfv (cfv (cv i) F) E) (cpr (cfv (cv i) P) (cfv (co (cv i) c1 caddc) P))) (co cc0 (cfv F chash) cfzo))) (wceq (cfv cc0 P) (cfv (cfv F chash) P)))) $;

--| Lemma 1 for ~ clwlkclwwlk . (Contributed by Alexander van der Vekens, 22-Jun-2018.) (Revised by AV, 11-Apr-2021.)
theorem clwlkclwwlklem1 {f2 i: setvar} (P R E V: class):
  $ wi (w3a (wf1 (cdm E) R E) (wcel P (cword V)) (wbr c2 (cfv P chash) cle)) (wi (wa (wceq (cfv P clsw) (cfv cc0 P)) (wa (wral i (wcel (cpr (cfv (cv i) P) (cfv (co (cv i) c1 caddc) P)) (crn E)) (co cc0 (co (co (co (cfv P chash) c1 cmin) cc0 cmin) c1 cmin) cfzo)) (wcel (cpr (cfv (co (cfv P chash) c2 cmin) P) (cfv cc0 P)) (crn E)))) (wex f2 (wa (w3a (wcel (cv f2) (cword (cdm E))) (wf (co cc0 (cfv (cv f2) chash) cfz) V P) (wral i (wceq (cfv (cfv (cv i) (cv f2)) E) (cpr (cfv (cv i) P) (cfv (co (cv i) c1 caddc) P))) (co cc0 (cfv (cv f2) chash) cfzo))) (wceq (cfv cc0 P) (cfv (cfv (cv f2) chash) P))))) $;

--| Lemma 2 for ~ clwlkclwwlk . (Contributed by Alexander van der Vekens, 22-Jun-2018.) (Revised by AV, 11-Apr-2021.)
theorem clwlkclwwlklem2 {i: setvar} (P R E F V: class):
  $ wi (w3a (wa (wf1 (cdm E) R E) (wcel F (cword (cdm E)))) (wa (wf (co cc0 (cfv F chash) cfz) V P) (wbr c2 (cfv P chash) cle)) (wa (wral i (wceq (cfv (cfv (cv i) F) E) (cpr (cfv (cv i) P) (cfv (co (cv i) c1 caddc) P))) (co cc0 (cfv F chash) cfzo)) (wceq (cfv cc0 P) (cfv (cfv F chash) P)))) (w3a (wceq (cfv P clsw) (cfv cc0 P)) (wral i (wcel (cpr (cfv (cv i) P) (cfv (co (cv i) c1 caddc) P)) (crn E)) (co cc0 (co (cfv F chash) c1 cmin) cfzo)) (wcel (cpr (cfv (co (cfv F chash) c1 cmin) P) (cfv cc0 P)) (crn E))) $;

--| Lemma 3 for ~ clwlkclwwlk . (Contributed by Alexander van der Vekens, 22-Jun-2018.) (Revised by AV, 11-Apr-2021.)
theorem clwlkclwwlklem3 {f2 i: setvar} (P R E V: class):
  $ wi (w3a (wf1 (cdm E) R E) (wcel P (cword V)) (wbr c2 (cfv P chash) cle)) (wb (wex f2 (wa (w3a (wcel (cv f2) (cword (cdm E))) (wf (co cc0 (cfv (cv f2) chash) cfz) V P) (wral i (wceq (cfv (cfv (cv i) (cv f2)) E) (cpr (cfv (cv i) P) (cfv (co (cv i) c1 caddc) P))) (co cc0 (cfv (cv f2) chash) cfzo))) (wceq (cfv cc0 P) (cfv (cfv (cv f2) chash) P)))) (wa (wceq (cfv P clsw) (cfv cc0 P)) (wa (wral i (wcel (cpr (cfv (cv i) P) (cfv (co (cv i) c1 caddc) P)) (crn E)) (co cc0 (co (co (co (cfv P chash) c1 cmin) cc0 cmin) c1 cmin) cfzo)) (wcel (cpr (cfv (co (cfv P chash) c2 cmin) P) (cfv cc0 P)) (crn E))))) $;

--| A closed walk as word of length at least 2 corresponds to a closed walk in a simple pseudograph. (Contributed by Alexander van der Vekens, 22-Jun-2018.) (Revised by AV, 24-Apr-2021.) (Revised by AV, 30-Oct-2022.)
theorem clwlkclwwlk {f2: setvar} (P E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (w3a (wcel G cuspgr) (wcel P (cword V)) (wbr c2 (cfv P chash) cle)) (wb (wex f2 (wbr (cv f2) P (cfv G cclwlks))) (wa (wceq (cfv P clsw) (cfv cc0 P)) (wcel (co P (co (cfv P chash) c1 cmin) cpfx) (cfv G cclwwlk)))) $;

--| A closed walk corresponds to a closed walk as word in a simple pseudograph. (Contributed by Alexander van der Vekens, 22-Jun-2018.) (Revised by AV, 24-Apr-2021.) (Proof shortened by AV, 2-Nov-2022.)
theorem clwlkclwwlk2 {f2: setvar} (P E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G ciedg) $ >
  $ wi (w3a (wcel G cuspgr) (wcel P (cword V)) (wbr c1 (cfv P chash) cle)) (wb (wex f2 (wbr (cv f2) (co P (cs1 (cfv cc0 P)) cconcat) (cfv G cclwlks))) (wcel P (cfv G cclwwlk))) $;

--| Lemma for ~ clwlkclwwlkf . (Contributed by AV, 24-May-2022.)
theorem clwlkclwwlkflem {w: setvar} (A2: class) (B2 C: class w) (U G: class):
  $ wceq C (crab w (wbr c1 (cfv (cfv (cv w) c1st) chash) cle) (cfv G cclwlks)) $ >
  $ wceq A2 (cfv U c1st) $ >
  $ wceq B2 (cfv U c2nd) $ >
  $ wi (wcel U C) (w3a (wbr A2 B2 (cfv G cwlks)) (wceq (cfv cc0 B2) (cfv (cfv A2 chash) B2)) (wcel (cfv A2 chash) cn)) $;

--| Lemma 2 for ~ clwlkclwwlkf1 . (Contributed by AV, 24-May-2022.) (Revised by AV, 30-Oct-2022.)
theorem clwlkclwwlkf1lem2 {w i: setvar} (A2: class) (B2: class w) (C: class w i) (D: class) (U: class i) (E: class w) (G: class) (W: class i):
  $ wceq C (crab w (wbr c1 (cfv (cfv (cv w) c1st) chash) cle) (cfv G cclwlks)) $ >
  $ wceq A2 (cfv U c1st) $ >
  $ wceq B2 (cfv U c2nd) $ >
  $ wceq D (cfv W c1st) $ >
  $ wceq E (cfv W c2nd) $ >
  $ wi (w3a (wcel U C) (wcel W C) (wceq (co B2 (cfv A2 chash) cpfx) (co E (cfv D chash) cpfx))) (wa (wceq (cfv A2 chash) (cfv D chash)) (wral i (wceq (cfv (cv i) B2) (cfv (cv i) E)) (co cc0 (cfv A2 chash) cfzo))) $;

--| Lemma 3 for ~ clwlkclwwlkf1 . (Contributed by Alexander van der Vekens, 5-Jul-2018.) (Revised by AV, 30-Oct-2022.)
theorem clwlkclwwlkf1lem3 {w i: setvar} (A2: class) (B2: class w) (C: class w i) (D: class) (U: class i) (E: class w) (G: class) (W: class i):
  $ wceq C (crab w (wbr c1 (cfv (cfv (cv w) c1st) chash) cle) (cfv G cclwlks)) $ >
  $ wceq A2 (cfv U c1st) $ >
  $ wceq B2 (cfv U c2nd) $ >
  $ wceq D (cfv W c1st) $ >
  $ wceq E (cfv W c2nd) $ >
  $ wi (w3a (wcel U C) (wcel W C) (wceq (co B2 (cfv A2 chash) cpfx) (co E (cfv D chash) cpfx))) (wral i (wceq (cfv (cv i) B2) (cfv (cv i) E)) (co cc0 (cfv A2 chash) cfz)) $;

--| Lemma for ~ clwlkclwwlkfo . (Contributed by AV, 25-May-2022.)
theorem clwlkclwwlkfolem {w f2: setvar} (C: class w f2) (G: class) (W: class w f2):
  $ wceq C (crab w (wbr c1 (cfv (cfv (cv w) c1st) chash) cle) (cfv G cclwlks)) $ >
  $ wi (w3a (wcel W (cword (cfv G cvtx))) (wbr c1 (cfv W chash) cle) (wcel (cop (cv f2) (co W (cs1 (cfv cc0 W)) cconcat)) (cfv G cclwlks))) (wcel (cop (cv f2) (co W (cs1 (cfv cc0 W)) cconcat)) C) $;

--| ` F ` is a function from the nonempty closed walks into the closed walks as word in a simple pseudograph. (Contributed by AV, 23-May-2022.) (Revised by AV, 29-Oct-2022.)
theorem clwlkclwwlkf {w c: setvar} (C: class w) (F: class w c) (G: class):
  $ wceq C (crab w (wbr c1 (cfv (cfv (cv w) c1st) chash) cle) (cfv G cclwlks)) $ >
  $ wceq F (cmpt c C (co (cfv (cv c) c2nd) (co (cfv (cfv (cv c) c2nd) chash) c1 cmin) cpfx)) $ >
  $ wi (wcel G cuspgr) (wf C (cfv G cclwwlk) F) $;

--| ` F ` is a function from the nonempty closed walks onto the closed walks as words in a simple pseudograph. (Contributed by Alexander van der Vekens, 30-Jun-2018.) (Revised by AV, 2-May-2021.) (Revised by AV, 29-Oct-2022.)
theorem clwlkclwwlkfo {w c: setvar} (C F G: class):
  $ wceq C (crab w (wbr c1 (cfv (cfv (cv w) c1st) chash) cle) (cfv G cclwlks)) $ >
  $ wceq F (cmpt c C (co (cfv (cv c) c2nd) (co (cfv (cfv (cv c) c2nd) chash) c1 cmin) cpfx)) $ >
  $ wi (wcel G cuspgr) (wfo C (cfv G cclwwlk) F) $;

--| ` F ` is a one-to-one function from the nonempty closed walks into the closed walks as words in a simple pseudograph. (Contributed by Alexander van der Vekens, 5-Jul-2018.) (Revised by AV, 3-May-2021.) (Revised by AV, 29-Oct-2022.)
theorem clwlkclwwlkf1 {w c: setvar} (C F G: class):
  $ wceq C (crab w (wbr c1 (cfv (cfv (cv w) c1st) chash) cle) (cfv G cclwlks)) $ >
  $ wceq F (cmpt c C (co (cfv (cv c) c2nd) (co (cfv (cfv (cv c) c2nd) chash) c1 cmin) cpfx)) $ >
  $ wi (wcel G cuspgr) (wf1 C (cfv G cclwwlk) F) $;

--| ` F ` is a bijection between the nonempty closed walks and the closed walks as words in a simple pseudograph. (Contributed by Alexander van der Vekens, 5-Jul-2018.) (Revised by AV, 3-May-2021.) (Revised by AV, 29-Oct-2022.)
theorem clwlkclwwlkf1o {w c: setvar} (C F G: class):
  $ wceq C (crab w (wbr c1 (cfv (cfv (cv w) c1st) chash) cle) (cfv G cclwlks)) $ >
  $ wceq F (cmpt c C (co (cfv (cv c) c2nd) (co (cfv (cfv (cv c) c2nd) chash) c1 cmin) cpfx)) $ >
  $ wi (wcel G cuspgr) (wf1o C (cfv G cclwwlk) F) $;

--| The set of the nonempty closed walks and the set of closed walks as word are equinumerous in a simple pseudograph. (Contributed by AV, 25-May-2022.) (Proof shortened by AV, 4-Nov-2022.)
theorem clwlkclwwlken {w: setvar} (G: class):
  $ wi (wcel G cuspgr) (wbr (crab w (wbr c1 (cfv (cfv (cv w) c1st) chash) cle) (cfv G cclwlks)) (cfv G cclwwlk) cen) $;

--| Lemma for ~ clwwisshclwwslem . (Contributed by Alexander van der Vekens, 23-Mar-2018.)
theorem clwwisshclwwslemlem {i: setvar} (A2 B2 R L W: class):
  $ wi (w3a (w3a (wcel L (cfv c2 cuz)) (wcel A2 cz) (wcel B2 cz)) (wral i (wcel (cpr (cfv (cv i) W) (cfv (co (cv i) c1 caddc) W)) R) (co cc0 (co L c1 cmin) cfzo)) (wcel (cpr (cfv (co L c1 cmin) W) (cfv cc0 W)) R)) (wcel (cpr (cfv (co (co A2 B2 caddc) L cmo) W) (cfv (co (co (co A2 c1 caddc) B2 caddc) L cmo) W)) R) $;

--| Lemma for ~ clwwisshclwws . (Contributed by AV, 24-Mar-2018.) (Revised by AV, 28-Apr-2021.)
theorem clwwisshclwwslem {i j: setvar} (E N V W: class):
  $ wi (wa (wcel W (cword V)) (wcel N (co c1 (cfv W chash) cfzo))) (wi (wa (wral i (wcel (cpr (cfv (cv i) W) (cfv (co (cv i) c1 caddc) W)) E) (co cc0 (co (cfv W chash) c1 cmin) cfzo)) (wcel (cpr (cfv W clsw) (cfv cc0 W)) E)) (wral j (wcel (cpr (cfv (cv j) (co W N ccsh)) (cfv (co (cv j) c1 caddc) (co W N ccsh))) E) (co cc0 (co (cfv (co W N ccsh) chash) c1 cmin) cfzo))) $;

--| Cyclically shifting a closed walk as word results in a closed walk as word (in an undirected graph). (Contributed by Alexander van der Vekens, 24-Mar-2018.) (Revised by AV, 28-Apr-2021.)
theorem clwwisshclwws (G N W: class):
  $ wi (wa (wcel W (cfv G cclwwlk)) (wcel N (co cc0 (cfv W chash) cfzo))) (wcel (co W N ccsh) (cfv G cclwwlk)) $;

--| Cyclically shifting a closed walk as word results in a closed walk as word (in an undirected graph). (Contributed by Alexander van der Vekens, 15-Jun-2018.) (Revised by AV, 29-Apr-2021.)
theorem clwwisshclwwsn (G N W: class):
  $ wi (wa (wcel W (cfv G cclwwlk)) (wcel N (co cc0 (cfv W chash) cfz))) (wcel (co W N ccsh) (cfv G cclwwlk)) $;

--| ` .~ ` is a relation. (Contributed by Alexander van der Vekens, 25-Mar-2018.) (Revised by AV, 29-Apr-2021.)
theorem erclwwlkrel {w u n: setvar} (c_sm G: class w u n):
  $ wceq c_sm (copab u w (w3a (wcel (cv u) (cfv G cclwwlk)) (wcel (cv w) (cfv G cclwwlk)) (wrex n (wceq (cv u) (co (cv w) (cv n) ccsh)) (co cc0 (cfv (cv w) chash) cfz)))) $ >
  $ wrel c_sm $;

--| Two classes are equivalent regarding ` .~ ` if both are words and one is the other cyclically shifted. (Contributed by Alexander van der Vekens, 25-Mar-2018.) (Revised by AV, 29-Apr-2021.)
theorem erclwwlkeq {w u n: setvar} (c_sm: class w u n) (U G W: class) (X Y: class w u n):
  $ wceq c_sm (copab u w (w3a (wcel (cv u) (cfv G cclwwlk)) (wcel (cv w) (cfv G cclwwlk)) (wrex n (wceq (cv u) (co (cv w) (cv n) ccsh)) (co cc0 (cfv (cv w) chash) cfz)))) $ >
  $ wi (wa (wcel U X) (wcel W Y)) (wb (wbr U W c_sm) (w3a (wcel U (cfv G cclwwlk)) (wcel W (cfv G cclwwlk)) (wrex n (wceq U (co W (cv n) ccsh)) (co cc0 (cfv W chash) cfz)))) $;

--| If two classes are equivalent regarding ` .~ ` , then they are words of the same length. (Contributed by Alexander van der Vekens, 8-Apr-2018.) (Revised by AV, 29-Apr-2021.)
theorem erclwwlkeqlen {w u n: setvar} (c_sm: class w u n) (U G W: class) (X Y: class w u):
  $ wceq c_sm (copab u w (w3a (wcel (cv u) (cfv G cclwwlk)) (wcel (cv w) (cfv G cclwwlk)) (wrex n (wceq (cv u) (co (cv w) (cv n) ccsh)) (co cc0 (cfv (cv w) chash) cfz)))) $ >
  $ wi (wa (wcel U X) (wcel W Y)) (wi (wbr U W c_sm) (wceq (cfv U chash) (cfv W chash))) $;

--| ` .~ ` is a reflexive relation over the set of closed walks (defined as words). (Contributed by Alexander van der Vekens, 25-Mar-2018.) (Revised by AV, 29-Apr-2021.)
theorem erclwwlkref {x3 w u n: setvar} (c_sm: class x3 w u n) (G: class x3):
  $ wceq c_sm (copab u w (w3a (wcel (cv u) (cfv G cclwwlk)) (wcel (cv w) (cfv G cclwwlk)) (wrex n (wceq (cv u) (co (cv w) (cv n) ccsh)) (co cc0 (cfv (cv w) chash) cfz)))) $ >
  $ wb (wcel (cv x3) (cfv G cclwwlk)) (wbr (cv x3) (cv x3) c_sm) $;

--| ` .~ ` is a symmetric relation over the set of closed walks (defined as words). (Contributed by Alexander van der Vekens, 8-Apr-2018.) (Revised by AV, 29-Apr-2021.)
theorem erclwwlksym {x3 y1 w u n: setvar} (c_sm: class x3 y1 w u n) (G: class x3 y1):
  $ wceq c_sm (copab u w (w3a (wcel (cv u) (cfv G cclwwlk)) (wcel (cv w) (cfv G cclwwlk)) (wrex n (wceq (cv u) (co (cv w) (cv n) ccsh)) (co cc0 (cfv (cv w) chash) cfz)))) $ >
  $ wi (wbr (cv x3) (cv y1) c_sm) (wbr (cv y1) (cv x3) c_sm) $;

--| ` .~ ` is a transitive relation over the set of closed walks (defined as words). (Contributed by Alexander van der Vekens, 10-Apr-2018.) (Revised by AV, 30-Apr-2021.)
theorem erclwwlktr {x3 y1 z w u n: setvar} (c_sm: class x3 y1 z w u n) (G: class x3 y1 z):
  $ wceq c_sm (copab u w (w3a (wcel (cv u) (cfv G cclwwlk)) (wcel (cv w) (cfv G cclwwlk)) (wrex n (wceq (cv u) (co (cv w) (cv n) ccsh)) (co cc0 (cfv (cv w) chash) cfz)))) $ >
  $ wi (wa (wbr (cv x3) (cv y1) c_sm) (wbr (cv y1) (cv z) c_sm)) (wbr (cv x3) (cv z) c_sm) $;

--| ` .~ ` is an equivalence relation over the set of closed walks (defined as words). (Contributed by Alexander van der Vekens, 10-Apr-2018.) (Revised by AV, 30-Apr-2021.)
theorem erclwwlk {w u n: setvar} (c_sm: class w u n) (G: class):
  $ wceq c_sm (copab u w (w3a (wcel (cv u) (cfv G cclwwlk)) (wcel (cv w) (cfv G cclwwlk)) (wrex n (wceq (cv u) (co (cv w) (cv n) ccsh)) (co cc0 (cfv (cv w) chash) cfz)))) $ >
  $ wer (cfv G cclwwlk) c_sm $;

--| Extend class notation with closed walks (in an undirected graph) of a fixed length as word over the set of vertices.
term cclwwlkn: class;

--| Define the set of all closed walks of a fixed length ` n ` as words over the set of vertices in a graph ` g ` . If ` 0 < n ` , such a word corresponds to the sequence p(0) p(1) ... p(n-1) of the vertices in a closed walk p(0) e(f(1)) p(1) e(f(2)) ... p(n-1) e(f(n)) p(n)=p(0) as defined in ~ df-clwlks . For ` n = 0 ` , the set is empty, see ~ clwwlkn0 . (Contributed by Alexander van der Vekens, 20-Mar-2018.) (Revised by AV, 24-Apr-2021.) (Revised by AV, 22-Mar-2022.)
axiom df_clwwlkn {w g2 n: setvar}:
  $ wceq cclwwlkn (cmpo n g2 cn0 cvv (crab w (wceq (cfv (cv w) chash) (cv n)) (cfv (cv g2) cclwwlk))) $;

--| The set of closed walks of a fixed length ` N ` as words over the set of vertices in a graph ` G ` . (Contributed by Alexander van der Vekens, 20-Mar-2018.) (Revised by AV, 24-Apr-2021.) (Revised by AV, 22-Mar-2022.)
theorem clwwlkn {w: setvar} (G N: class):
  $ wceq (co N G cclwwlkn) (crab w (wceq (cfv (cv w) chash) N) (cfv G cclwwlk)) $;

--| A word over the set of vertices representing a closed walk of a fixed length. (Contributed by Alexander van der Vekens, 15-Mar-2018.) (Revised by AV, 24-Apr-2021.) (Revised by AV, 22-Mar-2022.)
theorem isclwwlkn (G N W: class):
  $ wb (wcel W (co N G cclwwlkn)) (wa (wcel W (cfv G cclwwlk)) (wceq (cfv W chash) N)) $;

--| There is no closed walk of length 0 (i.e. a closed walk without any edge) represented by a word of vertices. (Contributed by Alexander van der Vekens, 15-Sep-2018.) (Revised by AV, 24-Apr-2021.)
theorem clwwlkn0 (G: class):
  $ wceq (co cc0 G cclwwlkn) c0 $;

--| Sufficient conditions for ` ClWWalksN ` to be empty. (Contributed by Alexander van der Vekens, 15-Sep-2018.) (Revised by AV, 24-Apr-2021.) (Proof shortened by AV, 24-Feb-2022.)
theorem clwwlkneq0 (G N: class):
  $ wi (wo (wnel G cvv) (wnel N cn)) (wceq (co N G cclwwlkn) c0) $;

--| A closed walk of a fixed length as word is a closed walk (in an undirected graph) as word. (Contributed by Alexander van der Vekens, 15-Mar-2018.) (Revised by AV, 24-Apr-2021.) (Proof shortened by AV, 22-Mar-2022.)
theorem clwwlkclwwlkn (G N W: class):
  $ wi (wcel W (co N G cclwwlkn)) (wcel W (cfv G cclwwlk)) $;

--| The closed walks of a fixed length as words are closed walks (in an undirected graph) as words. (Contributed by Alexander van der Vekens, 15-Mar-2018.) (Revised by AV, 12-Apr-2021.)
theorem clwwlksclwwlkn (G N: class):
  $ wss (co N G cclwwlkn) (cfv G cclwwlk) $;

--| The length of a word representing a closed walk of a fixed length is this fixed length. (Contributed by AV, 22-Mar-2022.)
theorem clwwlknlen (G N W: class):
  $ wi (wcel W (co N G cclwwlkn)) (wceq (cfv W chash) N) $;

--| The length of a closed walk of a fixed length as word is a positive integer. (Contributed by AV, 22-Mar-2022.)
theorem clwwlknnn (G N W: class):
  $ wi (wcel W (co N G cclwwlkn)) (wcel N cn) $;

--| A closed walk of a fixed length as word is a word over the vertices. (Contributed by AV, 30-Apr-2021.)
theorem clwwlknwrd (G N V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel W (co N G cclwwlkn)) (wcel W (cword V)) $;

--| Basic properties of a closed walk of a fixed length as word. (Contributed by AV, 30-Apr-2021.) (Proof shortened by AV, 22-Mar-2022.)
theorem clwwlknbp (G N V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel W (co N G cclwwlkn)) (wa (wcel W (cword V)) (wceq (cfv W chash) N)) $;

--| Characterization of a word representing a closed walk of a fixed length, definition of ` ClWWalks ` expanded. (Contributed by AV, 25-Apr-2021.) (Proof shortened by AV, 22-Mar-2022.)
theorem isclwwlknx {i: setvar} (E: class i) (G: class) (N V: class i) (W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wcel N cn) (wb (wcel W (co N G cclwwlkn)) (wa (w3a (wcel W (cword V)) (wral i (wcel (cpr (cfv (cv i) W) (cfv (co (cv i) c1 caddc) W)) E) (co cc0 (co (cfv W chash) c1 cmin) cfzo)) (wcel (cpr (cfv W clsw) (cfv cc0 W)) E)) (wceq (cfv W chash) N))) $;

--| Properties of a set being a closed walk (represented by a word). (Contributed by Alexander van der Vekens, 17-Jun-2018.) (Revised by AV, 24-Apr-2021.) (Proof shortened by AV, 23-Mar-2022.)
theorem clwwlknp {i: setvar} (E: class i) (G N: class) (V: class i) (W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wcel W (co N G cclwwlkn)) (w3a (wa (wcel W (cword V)) (wceq (cfv W chash) N)) (wral i (wcel (cpr (cfv (cv i) W) (cfv (co (cv i) c1 caddc) W)) E) (co cc0 (co N c1 cmin) cfzo)) (wcel (cpr (cfv W clsw) (cfv cc0 W)) E)) $;

--| A word representing a closed walk of length ` N ` also represents a walk of length ` N - 1 ` . The walk is one edge shorter than the closed walk, because the last edge connecting the last with the first vertex is missing. For example, if ` <" a b c "> e. ( 3 ClWWalksN G ) ` represents a closed walk "abca" of length 3, then ` <" a b c "> e. ( 2 WWalksN G ) ` represents a walk "abc" (not closed if ` a =/= c ` ) of length 2, and ` <" a b c a "> e. ( 3 WWalksN G ) ` represents also a closed walk "abca" of length 3. (Contributed by AV, 24-Jan-2022.) (Revised by AV, 22-Mar-2022.)
theorem clwwlknwwlksn (G N W: class):
  $ wi (wcel W (co N G cclwwlkn)) (wcel W (co (co N c1 cmin) G cwwlksn)) $;

--| The last but one vertex in a closed walk is a neighbor of the first vertex of the closed walk. (Contributed by AV, 17-Feb-2022.)
theorem clwwlknlbonbgr1 (G N W: class):
  $ wi (wa (wcel G cusgr) (wcel W (co N G cclwwlkn))) (wcel (cfv (co N c1 cmin) W) (co G (cfv cc0 W) cnbgr)) $;

--| If the initial vertex of a walk occurs another time in the walk, the walk starts with a closed walk. Since the walk is expressed as a word over vertices, the closed walk can be expressed as a subword of this word. (Contributed by Alexander van der Vekens, 15-Sep-2018.) (Revised by AV, 23-Jan-2022.) (Revised by AV, 30-Oct-2022.)
theorem clwwlkinwwlk (G M N W: class):
  $ wi (w3a (wa (wcel N cn) (wcel M (cfv N cuz))) (wcel W (co M G cwwlksn)) (wceq (cfv N W) (cfv cc0 W))) (wcel (co W N cpfx) (co N G cclwwlkn)) $;

--| A closed walk of length 1 represented as word is a word consisting of 1 symbol representing a vertex connected to itself by (at least) one edge, that is, a loop. (Contributed by AV, 24-Apr-2021.) (Revised by AV, 11-Feb-2022.)
theorem clwwlkn1 (G W: class):
  $ wb (wcel W (co c1 G cclwwlkn)) (w3a (wceq (cfv W chash) c1) (wcel W (cword (cfv G cvtx))) (wcel (csn (cfv cc0 W)) (cfv G cedg))) $;

--| The singleton word consisting of a vertex ` V ` represents a closed walk of length 1 iff there is a loop at vertex ` V ` . (Contributed by AV, 11-Feb-2022.)
theorem loopclwwlkn1b (G V: class):
  $ wi (wcel V (cfv G cvtx)) (wb (wcel (csn V) (cfv G cedg)) (wcel (cs1 V) (co c1 G cclwwlkn))) $;

--| A word represents a closed walk of length 1 iff this word is a singleton word consisting of a vertex with an attached loop. (Contributed by AV, 11-Feb-2022.)
theorem clwwlkn1loopb {v: setvar} (G W: class):
  $ wb (wcel W (co c1 G cclwwlkn)) (wrex v (wa (wceq W (cs1 (cv v))) (wcel (csn (cv v)) (cfv G cedg))) (cfv G cvtx)) $;

--| A closed walk of length 2 represented as word is a word consisting of 2 symbols representing (not necessarily different) vertices connected by (at least) one edge. (Contributed by Alexander van der Vekens, 19-Sep-2018.) (Revised by AV, 25-Apr-2021.)
theorem clwwlkn2 (G W: class):
  $ wb (wcel W (co c2 G cclwwlkn)) (w3a (wceq (cfv W chash) c2) (wcel W (cword (cfv G cvtx))) (wcel (cpr (cfv cc0 W) (cfv c1 W)) (cfv G cedg))) $;

--| If there is only a finite number of vertices, the number of closed walks of fixed length (as words) is also finite. (Contributed by Alexander van der Vekens, 25-Mar-2018.) (Revised by AV, 25-Apr-2021.) (Proof shortened by AV, 22-Mar-2022.) (Proof shortened by JJ, 18-Nov-2022.)
theorem clwwlknfi (G N: class):
  $ wi (wcel (cfv G cvtx) cfn) (wcel (co N G cclwwlkn) cfn) $;

--| Obtaining a closed walk (as word) by appending the first symbol to the word representing a walk. (Contributed by AV, 28-Sep-2018.) (Revised by AV, 25-Apr-2021.)
theorem clwwlkel {w i: setvar} (D: class w i) (P G N: class):
  $ wceq D (crab w (wceq (cfv (cv w) clsw) (cfv cc0 (cv w))) (co N G cwwlksn)) $ >
  $ wi (w3a (wcel N cn) (wa (wcel P (cword (cfv G cvtx))) (wceq (cfv P chash) N)) (wa (wral i (wcel (cpr (cfv (cv i) P) (cfv (co (cv i) c1 caddc) P)) (cfv G cedg)) (co cc0 (co N c1 cmin) cfzo)) (wcel (cpr (cfv P clsw) (cfv cc0 P)) (cfv G cedg)))) (wcel (co P (cs1 (cfv cc0 P)) cconcat) D) $;

--| Lemma 1 for ~ clwwlkf1o : F is a function. (Contributed by Alexander van der Vekens, 27-Sep-2018.) (Revised by AV, 26-Apr-2021.) (Revised by AV, 1-Nov-2022.)
theorem clwwlkf {w t: setvar} (D: class w) (F: class w t) (G N: class):
  $ wceq D (crab w (wceq (cfv (cv w) clsw) (cfv cc0 (cv w))) (co N G cwwlksn)) $ >
  $ wceq F (cmpt t D (co (cv t) N cpfx)) $ >
  $ wi (wcel N cn) (wf D (co N G cclwwlkn) F) $;

--| Lemma 2 for ~ clwwlkf1o : the value of function ` F ` . (Contributed by Alexander van der Vekens, 28-Sep-2018.) (Revised by AV, 26-Apr-2021.) (Revised by AV, 1-Nov-2022.)
theorem clwwlkfv {w t: setvar} (D: class w) (F: class w t) (G N: class) (W: class w):
  $ wceq D (crab w (wceq (cfv (cv w) clsw) (cfv cc0 (cv w))) (co N G cwwlksn)) $ >
  $ wceq F (cmpt t D (co (cv t) N cpfx)) $ >
  $ wi (wcel W D) (wceq (cfv W F) (co W N cpfx)) $;

--| Lemma 3 for ~ clwwlkf1o : ` F ` is a 1-1 function. (Contributed by AV, 28-Sep-2018.) (Revised by AV, 26-Apr-2021.) (Revised by AV, 1-Nov-2022.)
theorem clwwlkf1 {w t: setvar} (D: class w) (F: class w t) (G N: class):
  $ wceq D (crab w (wceq (cfv (cv w) clsw) (cfv cc0 (cv w))) (co N G cwwlksn)) $ >
  $ wceq F (cmpt t D (co (cv t) N cpfx)) $ >
  $ wi (wcel N cn) (wf1 D (co N G cclwwlkn) F) $;

--| Lemma 4 for ~ clwwlkf1o : F is an onto function. (Contributed by Alexander van der Vekens, 29-Sep-2018.) (Revised by AV, 26-Apr-2021.) (Revised by AV, 1-Nov-2022.)
theorem clwwlkfo {w t: setvar} (D: class w) (F: class w t) (G N: class):
  $ wceq D (crab w (wceq (cfv (cv w) clsw) (cfv cc0 (cv w))) (co N G cwwlksn)) $ >
  $ wceq F (cmpt t D (co (cv t) N cpfx)) $ >
  $ wi (wcel N cn) (wfo D (co N G cclwwlkn) F) $;

--| F is a 1-1 onto function, that means that there is a bijection between the set of closed walks of a fixed length represented by walks (as words) and the set of closed walks (as words) of the fixed length. The difference between these two representations is that in the first case the starting vertex is repeated at the end of the word, and in the second case it is not. (Contributed by Alexander van der Vekens, 29-Sep-2018.) (Revised by AV, 26-Apr-2021.) (Revised by AV, 1-Nov-2022.)
theorem clwwlkf1o {w t: setvar} (D: class w) (F: class w t) (G N: class):
  $ wceq D (crab w (wceq (cfv (cv w) clsw) (cfv cc0 (cv w))) (co N G cwwlksn)) $ >
  $ wceq F (cmpt t D (co (cv t) N cpfx)) $ >
  $ wi (wcel N cn) (wf1o D (co N G cclwwlkn) F) $;

--| The set of closed walks of a fixed length represented by walks (as words) and the set of closed walks (as words) of the fixed length are equinumerous. (Contributed by AV, 5-Jun-2022.) (Proof shortened by AV, 2-Nov-2022.)
theorem clwwlken {w: setvar} (G N: class):
  $ wi (wcel N cn) (wbr (crab w (wceq (cfv (cv w) clsw) (cfv cc0 (cv w))) (co N G cwwlksn)) (co N G cclwwlkn) cen) $;

--| Obtaining a closed walk (as word) by appending the first symbol to the word representing a walk. (Contributed by Alexander van der Vekens, 29-Sep-2018.) (Revised by AV, 26-Apr-2021.) (Revised by AV, 22-Mar-2022.)
theorem clwwlknwwlkncl {w: setvar} (G N W: class):
  $ wi (wcel W (co N G cclwwlkn)) (wcel (co W (cs1 (cfv cc0 W)) cconcat) (crab w (wceq (cfv (cv w) clsw) (cfv cc0 (cv w))) (co N G cwwlksn))) $;

--| A nonempty word over vertices represents a closed walk iff the word concatenated with its first symbol represents a walk. (Contributed by AV, 4-Mar-2022.)
theorem clwwlkwwlksb (G V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel W (cword V)) (wne W c0)) (wb (wcel W (cfv G cclwwlk)) (wcel (co W (cs1 (cfv cc0 W)) cconcat) (cfv G cwwlks))) $;

--| A word over vertices represents a closed walk of a fixed length ` N ` greater than zero iff the word concatenated with its first symbol represents a walk of length ` N ` . This theorem would not hold for ` N = 0 ` and ` W = (/) ` , because ` ( W ++ <" ( W `` 0 ) "> ) ` ` = <" (/) "> e. ( 0 WWalksN G ) ` could be true, but not ` W e. ( 0 ClWWalksN G ) <-> (/) e. (/) ` . (Contributed by AV, 4-Mar-2022.) (Proof shortened by AV, 22-Mar-2022.)
theorem clwwlknwwlksnb (G N V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel W (cword V)) (wcel N cn)) (wb (wcel W (co N G cclwwlkn)) (wcel (co W (cs1 (cfv cc0 W)) cconcat) (co N G cwwlksn))) $;

--| If a word concatenated with a vertex represents a closed walk in (in a graph), there is an edge between this vertex and the last vertex of the word, and between this vertex and the first vertex of the word. (Contributed by Alexander van der Vekens, 3-Oct-2018.) (Revised by AV, 27-Apr-2021.) (Proof shortened by AV, 22-Mar-2022.)
theorem clwwlkext2edg (E G N V W Z: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (w3a (wcel W (cword V)) (wcel Z V) (wcel N (cfv c2 cuz))) (wcel (co W (cs1 Z) cconcat) (co N G cclwwlkn))) (wa (wcel (cpr (cfv W clsw) Z) E) (wcel (cpr Z (cfv cc0 W)) E)) $;

--| If a word represents a walk in (in a graph) and there are edges between the last vertex of the word and another vertex and between this other vertex and the first vertex of the word, then the concatenation of the word representing the walk with this other vertex represents a closed walk. (Contributed by Alexander van der Vekens, 3-Oct-2018.) (Revised by AV, 27-Apr-2021.) (Revised by AV, 14-Mar-2022.)
theorem wwlksext2clwwlk (E G N V W Z: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel W (co N G cwwlksn)) (wcel Z V)) (wi (wa (wcel (cpr (cfv W clsw) Z) E) (wcel (cpr Z (cfv cc0 W)) E)) (wcel (co W (cs1 Z) cconcat) (co (co N c2 caddc) G cclwwlkn))) $;

--| Any prefix of a word representing a closed walk represents a walk. (Contributed by Alexander van der Vekens, 5-Oct-2018.) (Revised by AV, 28-Apr-2021.) (Revised by AV, 1-Nov-2022.)
theorem wwlksubclwwlk (G M N X: class):
  $ wi (wa (wcel M cn) (wcel N (cfv (co M c1 caddc) cuz))) (wi (wcel X (co N G cclwwlkn)) (wcel (co X M cpfx) (co (co M c1 cmin) G cwwlksn))) $;

--| Cyclically shifting a closed walk as word of fixed length results in a closed walk as word of the same length (in an undirected graph). (Contributed by Alexander van der Vekens, 10-Jun-2018.) (Revised by AV, 29-Apr-2021.) (Proof shortened by AV, 22-Mar-2022.)
theorem clwwnisshclwwsn (G M N W: class):
  $ wi (wa (wcel W (co N G cclwwlkn)) (wcel M (co cc0 N cfz))) (wcel (co W M ccsh) (co N G cclwwlkn)) $;

--| Lemma 1 for ~ eleclclwwlkn . (Contributed by Alexander van der Vekens, 11-May-2018.) (Revised by AV, 30-Apr-2021.)
theorem eleclclwwlknlem1 {m n: setvar} (G K N: class) (W: class m n) (X Y Z: class):
  $ wceq W (co N G cclwwlkn) $ >
  $ wi (wa (wcel K (co cc0 N cfz)) (wa (wcel X W) (wcel Y W))) (wi (wa (wceq X (co Y K ccsh)) (wrex m (wceq Z (co Y (cv m) ccsh)) (co cc0 N cfz))) (wrex n (wceq Z (co X (cv n) ccsh)) (co cc0 N cfz))) $;

--| Lemma 2 for ~ eleclclwwlkn . (Contributed by Alexander van der Vekens, 11-May-2018.) (Revised by AV, 30-Apr-2021.)
theorem eleclclwwlknlem2 {m n: setvar} (x3 k: setvar) (G N: class) (W: class m n) (X Y: class):
  $ wceq W (co N G cclwwlkn) $ >
  $ wi (wa (wa (wcel (cv k) (co cc0 N cfz)) (wceq X (co (cv x3) (cv k) ccsh))) (wa (wcel X W) (wcel (cv x3) W))) (wb (wrex m (wceq Y (co (cv x3) (cv m) ccsh)) (co cc0 N cfz)) (wrex n (wceq Y (co X (cv n) ccsh)) (co cc0 N cfz))) $;

--| The set of cyclical shifts of a word representing a closed walk is the set of closed walks represented by cyclical shifts of a word. (Contributed by Alexander van der Vekens, 15-Jun-2018.) (Revised by AV, 30-Apr-2021.)
theorem clwwlknscsh {y1 n: setvar} (G N W: class):
  $ wi (wa (wcel N cn0) (wcel W (co N G cclwwlkn))) (wceq (crab y1 (wrex n (wceq (cv y1) (co W (cv n) ccsh)) (co cc0 N cfz)) (co N G cclwwlkn)) (crab y1 (wrex n (wceq (cv y1) (co W (cv n) ccsh)) (co cc0 N cfz)) (cword (cfv G cvtx)))) $;

--| The concatenation of two words representing closed walks anchored at the same vertex represents a closed walk with a length which is the sum of the lengths of the two walks. The resulting walk is a "double loop", starting at the common vertex, coming back to the common vertex by the first walk, following the second walk and finally coming back to the common vertex again. (Contributed by AV, 24-Apr-2022.)
theorem clwwlknccat (A2 B2 G M N: class):
  $ wi (w3a (wcel A2 (co M G cclwwlkn)) (wcel B2 (co N G cclwwlkn)) (wceq (cfv cc0 A2) (cfv cc0 B2))) (wcel (co A2 B2 cconcat) (co (co M N caddc) G cclwwlkn)) $;

--| If a word represents a closed walk of length at least 2 in a multigraph, the first two symbols of the word must be different. (Contributed by Alexander van der Vekens, 17-Jun-2018.) (Revised by AV, 30-Apr-2021.)
theorem umgr2cwwk2dif (G N W: class):
  $ wi (w3a (wcel G cumgr) (wcel N (cfv c2 cuz)) (wcel W (co N G cclwwlkn))) (wne (cfv c1 W) (cfv cc0 W)) $;

--| If a word represents a closed walk of length at least 2 in a undirected simple graph, the first two symbols of the word must be different. (Contributed by Alexander van der Vekens, 17-Jun-2018.) (Revised by AV, 30-Apr-2021.)
theorem umgr2cwwkdifex {i: setvar} (G N W: class):
  $ wi (w3a (wcel G cumgr) (wcel N (cfv c2 cuz)) (wcel W (co N G cclwwlkn))) (wrex i (wne (cfv (cv i) W) (cfv cc0 W)) (co cc0 N cfzo)) $;

--| ` .~ ` is a relation. (Contributed by Alexander van der Vekens, 25-Mar-2018.) (Revised by AV, 30-Apr-2021.)
theorem erclwwlknrel {u t n: setvar} (c_sm G N W: class u t n):
  $ wceq W (co N G cclwwlkn) $ >
  $ wceq c_sm (copab t u (w3a (wcel (cv t) W) (wcel (cv u) W) (wrex n (wceq (cv t) (co (cv u) (cv n) ccsh)) (co cc0 N cfz)))) $ >
  $ wrel c_sm $;

--| Two classes are equivalent regarding ` .~ ` if both are words of the same fixed length and one is the other cyclically shifted. (Contributed by Alexander van der Vekens, 25-Mar-2018.) (Revised by AV, 30-Apr-2021.)
theorem erclwwlkneq {u t n: setvar} (c_sm: class u t n) (T U: class) (G: class u t n) (N W: class n) (X Y: class u t n):
  $ wceq W (co N G cclwwlkn) $ >
  $ wceq c_sm (copab t u (w3a (wcel (cv t) W) (wcel (cv u) W) (wrex n (wceq (cv t) (co (cv u) (cv n) ccsh)) (co cc0 N cfz)))) $ >
  $ wi (wa (wcel T X) (wcel U Y)) (wb (wbr T U c_sm) (w3a (wcel T W) (wcel U W) (wrex n (wceq T (co U (cv n) ccsh)) (co cc0 N cfz)))) $;

--| If two classes are equivalent regarding ` .~ ` , then they are words of the same length. (Contributed by Alexander van der Vekens, 8-Apr-2018.) (Revised by AV, 30-Apr-2021.)
theorem erclwwlkneqlen {u t n: setvar} (c_sm: class u t n) (T U: class) (G: class u t n) (N: class n) (W: class) (X Y: class u t):
  $ wceq W (co N G cclwwlkn) $ >
  $ wceq c_sm (copab t u (w3a (wcel (cv t) W) (wcel (cv u) W) (wrex n (wceq (cv t) (co (cv u) (cv n) ccsh)) (co cc0 N cfz)))) $ >
  $ wi (wa (wcel T X) (wcel U Y)) (wi (wbr T U c_sm) (wceq (cfv T chash) (cfv U chash))) $;

--| ` .~ ` is a reflexive relation over the set of closed walks (defined as words). (Contributed by Alexander van der Vekens, 26-Mar-2018.) (Revised by AV, 30-Apr-2021.) (Proof shortened by AV, 23-Mar-2022.)
theorem erclwwlknref {x3 u t n: setvar} (c_sm G: class x3 u t n) (N: class) (W: class x3 n):
  $ wceq W (co N G cclwwlkn) $ >
  $ wceq c_sm (copab t u (w3a (wcel (cv t) W) (wcel (cv u) W) (wrex n (wceq (cv t) (co (cv u) (cv n) ccsh)) (co cc0 N cfz)))) $ >
  $ wb (wcel (cv x3) W) (wbr (cv x3) (cv x3) c_sm) $;

--| ` .~ ` is a symmetric relation over the set of closed walks (defined as words). (Contributed by Alexander van der Vekens, 10-Apr-2018.) (Revised by AV, 30-Apr-2021.)
theorem erclwwlknsym {x3 y1 u t n: setvar} (c_sm G: class x3 y1 u t n) (N: class y1) (W: class x3 y1):
  $ wceq W (co N G cclwwlkn) $ >
  $ wceq c_sm (copab t u (w3a (wcel (cv t) W) (wcel (cv u) W) (wrex n (wceq (cv t) (co (cv u) (cv n) ccsh)) (co cc0 N cfz)))) $ >
  $ wi (wbr (cv x3) (cv y1) c_sm) (wbr (cv y1) (cv x3) c_sm) $;

--| ` .~ ` is a transitive relation over the set of closed walks (defined as words). (Contributed by Alexander van der Vekens, 10-Apr-2018.) (Revised by AV, 30-Apr-2021.)
theorem erclwwlkntr {x3 y1 z u t n: setvar} (c_sm G: class x3 y1 z u t n) (N: class y1 z) (W: class x3 y1 z):
  $ wceq W (co N G cclwwlkn) $ >
  $ wceq c_sm (copab t u (w3a (wcel (cv t) W) (wcel (cv u) W) (wrex n (wceq (cv t) (co (cv u) (cv n) ccsh)) (co cc0 N cfz)))) $ >
  $ wi (wa (wbr (cv x3) (cv y1) c_sm) (wbr (cv y1) (cv z) c_sm)) (wbr (cv x3) (cv z) c_sm) $;

--| ` .~ ` is an equivalence relation over the set of closed walks (defined as words) with a fixed length. (Contributed by Alexander van der Vekens, 10-Apr-2018.) (Revised by AV, 30-Apr-2021.)
theorem erclwwlkn {u t n: setvar} (c_sm G: class u t n) (N W: class):
  $ wceq W (co N G cclwwlkn) $ >
  $ wceq c_sm (copab t u (w3a (wcel (cv t) W) (wcel (cv u) W) (wrex n (wceq (cv t) (co (cv u) (cv n) ccsh)) (co cc0 N cfz)))) $ >
  $ wer W c_sm $;

--| The quotient set of the set of closed walks (defined as words) with a fixed length according to the equivalence relation ` .~ ` is finite. (Contributed by Alexander van der Vekens, 10-Apr-2018.) (Revised by AV, 30-Apr-2021.)
theorem qerclwwlknfi {u t n: setvar} (c_sm G: class u t n) (N W: class):
  $ wceq W (co N G cclwwlkn) $ >
  $ wceq c_sm (copab t u (w3a (wcel (cv t) W) (wcel (cv u) W) (wrex n (wceq (cv t) (co (cv u) (cv n) ccsh)) (co cc0 N cfz)))) $ >
  $ wi (wcel (cfv G cvtx) cfn) (wcel (cqs W c_sm) cfn) $;

--| The number of closed walks (defined as words) with a fixed length is the sum of the sizes of all equivalence classes according to ` .~ ` . (Contributed by Alexander van der Vekens, 10-Apr-2018.) (Revised by AV, 30-Apr-2021.)
theorem hashclwwlkn0 {x3 u t n: setvar} (c_sm G: class u t n) (N W: class):
  $ wceq W (co N G cclwwlkn) $ >
  $ wceq c_sm (copab t u (w3a (wcel (cv t) W) (wcel (cv u) W) (wrex n (wceq (cv t) (co (cv u) (cv n) ccsh)) (co cc0 N cfz)))) $ >
  $ wi (wcel (cfv G cvtx) cfn) (wceq (cfv W chash) (csu x3 (cqs W c_sm) (cfv (cv x3) chash))) $;

--| An equivalence class according to ` .~ ` . (Contributed by Alexander van der Vekens, 12-Apr-2018.) (Revised by AV, 30-Apr-2021.)
theorem eclclwwlkn1 {x3 y1 u t n: setvar} (B2 c_sm: class u t n) (G: class y1 u t n) (N W: class) (X: class u t n):
  $ wceq W (co N G cclwwlkn) $ >
  $ wceq c_sm (copab t u (w3a (wcel (cv t) W) (wcel (cv u) W) (wrex n (wceq (cv t) (co (cv u) (cv n) ccsh)) (co cc0 N cfz)))) $ >
  $ wi (wcel B2 X) (wb (wcel B2 (cqs W c_sm)) (wrex x3 (wceq B2 (crab y1 (wrex n (wceq (cv y1) (co (cv x3) (cv n) ccsh)) (co cc0 N cfz)) W)) W)) $;

--| A member of an equivalence class according to ` .~ ` . (Contributed by Alexander van der Vekens, 11-May-2018.) (Revised by AV, 1-May-2021.)
theorem eleclclwwlkn {u t n: setvar} (B2 c_sm: class u t n) (G: class u t) (N W: class) (X Y: class u t):
  $ wceq W (co N G cclwwlkn) $ >
  $ wceq c_sm (copab t u (w3a (wcel (cv t) W) (wcel (cv u) W) (wrex n (wceq (cv t) (co (cv u) (cv n) ccsh)) (co cc0 N cfz)))) $ >
  $ wi (wa (wcel B2 (cqs W c_sm)) (wcel X B2)) (wb (wcel Y B2) (wa (wcel Y W) (wrex n (wceq Y (co X (cv n) ccsh)) (co cc0 N cfz)))) $;

--| The size of every equivalence class of the equivalence relation over the set of closed walks (defined as words) with a fixed length which is a prime number is 1 or equals this length. (Contributed by Alexander van der Vekens, 17-Jun-2018.) (Revised by AV, 1-May-2021.)
theorem hashecclwwlkn1 {u t n: setvar} (c_sm: class u t n) (U G: class t) (N W: class):
  $ wceq W (co N G cclwwlkn) $ >
  $ wceq c_sm (copab t u (w3a (wcel (cv t) W) (wcel (cv u) W) (wrex n (wceq (cv t) (co (cv u) (cv n) ccsh)) (co cc0 N cfz)))) $ >
  $ wi (wa (wcel N cprime) (wcel U (cqs W c_sm))) (wo (wceq (cfv U chash) c1) (wceq (cfv U chash) N)) $;

--| The size of every equivalence class of the equivalence relation over the set of closed walks (defined as words) with a fixed length which is a prime number equals this length (in an undirected simple graph). (Contributed by Alexander van der Vekens, 17-Jun-2018.) (Revised by AV, 1-May-2021.)
theorem umgrhashecclwwlk {u t n: setvar} (c_sm: class u t n) (U G: class t) (N W: class):
  $ wceq W (co N G cclwwlkn) $ >
  $ wceq c_sm (copab t u (w3a (wcel (cv t) W) (wcel (cv u) W) (wrex n (wceq (cv t) (co (cv u) (cv n) ccsh)) (co cc0 N cfz)))) $ >
  $ wi (wa (wcel G cumgr) (wcel N cprime)) (wi (wcel U (cqs W c_sm)) (wceq (cfv U chash) N)) $;

--| The size of the set of closed walks (defined as words) with a fixed length which is a prime number is the product of the number of equivalence classes for ` .~ ` over the set of closed walks and the fixed length. (Contributed by Alexander van der Vekens, 17-Jun-2018.) (Revised by AV, 1-May-2021.)
theorem fusgrhashclwwlkn {u t n: setvar} (c_sm: class u t n) (G: class t) (N W: class):
  $ wceq W (co N G cclwwlkn) $ >
  $ wceq c_sm (copab t u (w3a (wcel (cv t) W) (wcel (cv u) W) (wrex n (wceq (cv t) (co (cv u) (cv n) ccsh)) (co cc0 N cfz)))) $ >
  $ wi (wa (wcel G cfusgr) (wcel N cprime)) (wceq (cfv W chash) (co (cfv (cqs W c_sm) chash) N cmul)) $;

--| The size of the set of closed walks (defined as words) of length ` N ` is divisible by ` N ` if ` N ` is a prime number. (Contributed by Alexander van der Vekens, 17-Jun-2018.) (Revised by AV, 2-May-2021.)
theorem clwwlkndivn (G N: class):
  $ wi (wa (wcel G cfusgr) (wcel N cprime)) (wbr N (cfv (co N G cclwwlkn) chash) cdvds) $;

--| Lemma 1 for ~ clwlknf1oclwwlkn . (Contributed by AV, 26-May-2022.) (Revised by AV, 1-Nov-2022.)
theorem clwlknf1oclwwlknlem1 (C G: class):
  $ wi (wa (wcel C (cfv G cclwlks)) (wbr c1 (cfv (cfv C c1st) chash) cle)) (wceq (cfv (co (cfv C c2nd) (co (cfv (cfv C c2nd) chash) c1 cmin) cpfx) chash) (cfv (cfv C c1st) chash)) $;

--| Lemma 2 for ~ clwlknf1oclwwlkn : The closed walks of a positive length are nonempty closed walks of this length. (Contributed by AV, 26-May-2022.)
theorem clwlknf1oclwwlknlem2 {w c: setvar} (G N: class):
  $ wi (wcel N cn) (wceq (crab w (wceq (cfv (cfv (cv w) c1st) chash) N) (cfv G cclwlks)) (crab c (wa (wbr c1 (cfv (cfv (cv c) c1st) chash) cle) (wceq (cfv (cfv (cv c) c1st) chash) N)) (cfv G cclwlks))) $;

--| Lemma 3 for ~ clwlknf1oclwwlkn : The bijective function of ~ clwlknf1oclwwlkn is the bijective function of ~ clwlkclwwlkf1o restricted to the closed walks with a fixed positive length. (Contributed by AV, 26-May-2022.) (Revised by AV, 1-Nov-2022.)
theorem clwlknf1oclwwlknlem3 {w c: setvar} (A2 B2: class w c) (C: class w) (F: class w c) (G: class) (N: class c):
  $ wceq A2 (cfv (cv c) c1st) $ >
  $ wceq B2 (cfv (cv c) c2nd) $ >
  $ wceq C (crab w (wceq (cfv (cfv (cv w) c1st) chash) N) (cfv G cclwlks)) $ >
  $ wceq F (cmpt c C (co B2 (cfv A2 chash) cpfx)) $ >
  $ wi (wa (wcel G cuspgr) (wcel N cn)) (wceq F (cres (cmpt c (crab w (wbr c1 (cfv (cfv (cv w) c1st) chash) cle) (cfv G cclwlks)) (co B2 (cfv A2 chash) cpfx)) C)) $;

--| There is a one-to-one onto function between the set of closed walks as words of length ` N ` and the set of closed walks of length ` N ` in a simple pseudograph. (Contributed by Alexander van der Vekens, 5-Jul-2018.) (Revised by AV, 3-May-2021.) (Revised by AV, 1-Nov-2022.)
theorem clwlknf1oclwwlkn {w c: setvar} (A2 B2: class w c) (C: class w) (F: class w c) (G N: class):
  $ wceq A2 (cfv (cv c) c1st) $ >
  $ wceq B2 (cfv (cv c) c2nd) $ >
  $ wceq C (crab w (wceq (cfv (cfv (cv w) c1st) chash) N) (cfv G cclwlks)) $ >
  $ wceq F (cmpt c C (co B2 (cfv A2 chash) cpfx)) $ >
  $ wi (wa (wcel G cuspgr) (wcel N cn)) (wf1o C (co N G cclwwlkn) F) $;

--| The size of the set of closed walks as words of length ` N ` corresponds to the size of the set of closed walks of length ` N ` in a simple pseudograph. (Contributed by Alexander van der Vekens, 6-Jul-2018.) (Revised by AV, 4-May-2021.) (Revised by AV, 26-May-2022.) (Proof shortened by AV, 3-Nov-2022.)
theorem clwlkssizeeq {w: setvar} (G N: class):
  $ wi (wa (wcel G cuspgr) (wcel N cn)) (wceq (cfv (co N G cclwwlkn) chash) (cfv (crab w (wceq (cfv (cfv (cv w) c1st) chash) N) (cfv G cclwlks)) chash)) $;

--| The size of the set of closed walks of prime length ` N ` is divisible by ` N ` . This corresponds to statement 9 in [Huneke] p. 2: "It follows that, if p is a prime number, then the number of closed walks of length p is divisible by p". (Contributed by Alexander van der Vekens, 6-Jul-2018.) (Revised by AV, 4-May-2021.)
theorem clwlksndivn {c: setvar} (G N: class):
  $ wi (wa (wcel G cfusgr) (wcel N cprime)) (wbr N (cfv (crab c (wceq (cfv (cfv (cv c) c1st) chash) N) (cfv G cclwlks)) chash) cdvds) $;

--| Extend class notation with closed walks (in an undirected graph) anchored at a fixed vertex and of a fixed length as word over the set of vertices.
term cclwwlknon: class;

--| Define the set of all closed walks a graph ` g ` , anchored at a fixed vertex ` v ` (i.e., a walk starting and ending at the fixed vertex ` v ` , also called "a closed walk on vertex ` v ` ") and having a fixed length ` n ` as words over the set of vertices. Such a word corresponds to the sequence v=p(0) p(1) ... p(n-1) of the vertices in a closed walk p(0) e(f(1)) p(1) e(f(2)) ... p(n-1) e(f(n)) p(n)=p(0)=v as defined in ~ df-clwlks . The set ` ( ( v ( ClWWalksNOn `` g ) n ) ` corresponds to the set of "walks from v to v of length n" in a statement of [Huneke] p. 2. (Contributed by AV, 24-Feb-2022.)
axiom df_clwwlknon {w v g2 n: setvar}:
  $ wceq cclwwlknon (cmpt g2 cvv (cmpo v n (cfv (cv g2) cvtx) cn0 (crab w (wceq (cfv cc0 (cv w)) (cv v)) (co (cv n) (cv g2) cclwwlkn)))) $;

--| ` ( ClWWalksNOn `` G ) ` is an operator mapping a vertex ` v ` and a nonnegative integer ` n ` to the set of closed walks on ` v ` of length ` n ` as words over the set of vertices in a graph ` G ` . (Contributed by AV, 25-Feb-2022.) (Proof shortened by AV, 2-Mar-2024.)
theorem clwwlknonmpo {w v n: setvar} (G: class):
  $ wceq (cfv G cclwwlknon) (cmpo v n (cfv G cvtx) cn0 (crab w (wceq (cfv cc0 (cv w)) (cv v)) (co (cv n) G cclwwlkn))) $;

--| The set of closed walks on vertex ` X ` of length ` N ` in a graph ` G ` as words over the set of vertices. (Contributed by Alexander van der Vekens, 14-Sep-2018.) (Revised by AV, 28-May-2021.) (Revised by AV, 24-Mar-2022.)
theorem clwwlknon {w: setvar} (G N X: class):
  $ wceq (co X N (cfv G cclwwlknon)) (crab w (wceq (cfv cc0 (cv w)) X) (co N G cclwwlkn)) $;

--| A word over the set of vertices representing a closed walk on vertex ` X ` of length ` N ` in a graph ` G ` . (Contributed by AV, 25-Feb-2022.) (Revised by AV, 24-Mar-2022.)
theorem isclwwlknon (G N W X: class):
  $ wb (wcel W (co X N (cfv G cclwwlknon))) (wa (wcel W (co N G cclwwlkn)) (wceq (cfv cc0 W) X)) $;

--| There is no word over the set of vertices representing a closed walk on vertex ` X ` of length ` 0 ` in a graph ` G ` . (Contributed by AV, 17-Feb-2022.) (Revised by AV, 25-Feb-2022.)
theorem clwwlk0on0 (G X: class):
  $ wceq (co X cc0 (cfv G cclwwlknon)) c0 $;

--| Sufficient conditions for ` ClWWalksNOn ` to be empty. (Contributed by AV, 25-Mar-2022.)
theorem clwwlknon0 (G N X: class):
  $ wi (wn (wa (wcel X (cfv G cvtx)) (wcel N cn))) (wceq (co X N (cfv G cclwwlknon)) c0) $;

--| In a finite graph ` G ` , the set of closed walks on vertex ` X ` of length ` N ` is also finite. (Contributed by Alexander van der Vekens, 26-Sep-2018.) (Revised by AV, 25-Feb-2022.) (Proof shortened by AV, 24-Mar-2022.)
theorem clwwlknonfin (G N V X: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel V cfn) (wcel (co X N (cfv G cclwwlknon)) cfn) $;

--| Characterization of a word over the set of vertices representing a closed walk on vertex ` X ` of (nonzero) length ` N ` in a graph ` G ` . This theorem would not hold for ` N = 0 ` if ` W = X = (/) ` . (Contributed by Alexander van der Vekens, 20-Sep-2018.) (Revised by AV, 28-May-2021.) (Revised by AV, 24-Mar-2022.)
theorem clwwlknonel {i: setvar} (E: class i) (G: class) (N V: class i) (W: class) (X: class i):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wne N cc0) (wb (wcel W (co X N (cfv G cclwwlknon))) (w3a (w3a (wcel W (cword V)) (wral i (wcel (cpr (cfv (cv i) W) (cfv (co (cv i) c1 caddc) W)) E) (co cc0 (co (cfv W chash) c1 cmin) cfzo)) (wcel (cpr (cfv W clsw) (cfv cc0 W)) E)) (wceq (cfv W chash) N) (wceq (cfv cc0 W) X))) $;

--| The concatenation of two words representing closed walks on a vertex ` X ` represents a closed walk on vertex ` X ` . The resulting walk is a "double loop", starting at vertex ` X ` , coming back to ` X ` by the first walk, following the second walk and finally coming back to ` X ` again. (Contributed by AV, 24-Apr-2022.)
theorem clwwlknonccat (A2 B2 G M N X: class):
  $ wi (wa (wcel A2 (co X M (cfv G cclwwlknon))) (wcel B2 (co X N (cfv G cclwwlknon)))) (wcel (co A2 B2 cconcat) (co X (co M N caddc) (cfv G cclwwlknon))) $;

--| The set of closed walks on vertex ` X ` of length ` 1 ` in a graph ` G ` as words over the set of vertices. (Contributed by AV, 11-Feb-2022.) (Revised by AV, 25-Feb-2022.) (Proof shortened by AV, 24-Mar-2022.)
theorem clwwlknon1 {w: setvar} (C E: class w) (G V X: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq C (cfv G cclwwlknon) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wcel X V) (wceq (co X c1 C) (crab w (wa (wceq (cv w) (cs1 X)) (wcel (csn X) E)) (cword V))) $;

--| If there is a loop at vertex ` X ` , the set of (closed) walks on ` X ` of length ` 1 ` as words over the set of vertices is a singleton containing the singleton word consisting of ` X ` . (Contributed by AV, 11-Feb-2022.) (Revised by AV, 25-Feb-2022.) (Proof shortened by AV, 25-Mar-2022.)
theorem clwwlknon1loop (C E G V X: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq C (cfv G cclwwlknon) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wcel X V) (wcel (csn X) E)) (wceq (co X c1 C) (csn (cs1 X))) $;

--| If there is no loop at vertex ` X ` , the set of (closed) walks on ` X ` of length ` 1 ` as words over the set of vertices is empty. (Contributed by AV, 11-Feb-2022.) (Revised by AV, 25-Mar-2022.)
theorem clwwlknon1nloop (C E G V X: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq C (cfv G cclwwlknon) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wnel (csn X) E) (wceq (co X c1 C) c0) $;

--| The set of (closed) walks on vertex ` X ` of length ` 1 ` as words over the set of vertices is a singleton containing the singleton word consisting of ` X ` iff there is a loop at ` X ` . (Contributed by AV, 11-Feb-2022.) (Revised by AV, 25-Feb-2022.)
theorem clwwlknon1sn (C E G V X: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq C (cfv G cclwwlknon) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wcel X V) (wb (wceq (co X c1 C) (csn (cs1 X))) (wcel (csn X) E)) $;

--| There is at most one (closed) walk on vertex ` X ` of length ` 1 ` as word over the set of vertices. (Contributed by AV, 11-Feb-2022.) (Revised by AV, 25-Mar-2022.)
theorem clwwlknon1le1 (G X: class):
  $ wbr (cfv (co X c1 (cfv G cclwwlknon)) chash) c1 cle $;

--| The set of closed walks on vertex ` X ` of length ` 2 ` in a graph ` G ` as words over the set of vertices. (Contributed by AV, 5-Mar-2022.) (Revised by AV, 25-Mar-2022.)
theorem clwwlknon2 {w: setvar} (C: class w) (G X: class):
  $ wceq C (cfv G cclwwlknon) $ >
  $ wceq (co X c2 C) (crab w (wceq (cfv cc0 (cv w)) X) (co c2 G cclwwlkn)) $;

--| The set of closed walks on vertex ` X ` of length ` 2 ` in a graph ` G ` as words over the set of vertices, definition of ` ClWWalksN ` expanded. (Contributed by Alexander van der Vekens, 19-Sep-2018.) (Revised by AV, 25-Mar-2022.)
theorem clwwlknon2x {w: setvar} (C E: class w) (G: class) (V: class w) (X: class):
  $ wceq C (cfv G cclwwlknon) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wceq (co X c2 C) (crab w (w3a (wceq (cfv (cv w) chash) c2) (wcel (cpr (cfv cc0 (cv w)) (cfv c1 (cv w))) E) (wceq (cfv cc0 (cv w)) X)) (cword V)) $;

--| Sufficient conditions of a doubleton word to represent a closed walk on vertex ` X ` of length ` 2 ` . (Contributed by AV, 11-May-2022.)
theorem s2elclwwlknon2 (C E G V X Y: class):
  $ wceq C (cfv G cclwwlknon) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (w3a (wcel X V) (wcel Y V) (wcel (cpr X Y) E)) (wcel (cs2 X Y) (co X c2 C)) $;

--| In a ` K `-regular graph ` G ` , there are ` K ` closed walks on vertex ` X ` of length ` 2 ` . (Contributed by Alexander van der Vekens, 19-Sep-2018.) (Revised by AV, 28-May-2021.) (Revised by AV, 25-Feb-2022.) (Proof shortened by AV, 25-Mar-2022.)
theorem clwwlknon2num (G K X: class):
  $ wi (wa (wbr G K crusgr) (wcel X (cfv G cvtx))) (wceq (cfv (co X c2 (cfv G cclwwlknon)) chash) K) $;

--| A word over vertices represents a closed walk of a fixed length ` N ` on vertex ` X ` iff the word concatenated with ` X ` represents a walk of length ` N ` on ` X ` and ` X ` . This theorem would not hold for ` N = 0 ` and ` W = (/) ` , see ~ clwwlknwwlksnb . (Contributed by AV, 4-Mar-2022.) (Revised by AV, 27-Mar-2022.)
theorem clwwlknonwwlknonb (G N V W X: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel W (cword V)) (wcel N cn)) (wb (wcel W (co X N (cfv G cclwwlknon))) (wcel (co W (cs1 X) cconcat) (co X X (co N G cwwlksnon)))) $;

--| Lemma 1 for ~ clwwlknonex2 : Transformation of a special half-open integer range into a union of a smaller half-open integer range and an unordered pair. This Lemma would not hold for ` N = 2 ` , i.e., ` ( # `` W ) = 0 ` , because ` ( 0 ..^ ( ( ( # `` W ) + 2 ) - 1 ) ) ` ` = ( 0 ..^ ( ( 0 + 2 ) - 1 ) ) = ( 0 ..^ 1 ) = { 0 } ` ` =/= { -u 1 , 0 } = ( (/) u. { -u 1 , 0 } ) ` ` = ( ( 0 ..^ ( 0 - 1 ) ) u. { ( 0 - 1 ) , 0 } ) ` ` = ( ( 0 ..^ ( ( # `` W ) - 1 ) ) ` ` u. { ( ( # `` W ) - 1 ) , ( # `` W ) } ) ` . (Contributed by AV, 22-Sep-2018.) (Revised by AV, 26-Jan-2022.)
theorem clwwlknonex2lem1 (N W: class):
  $ wi (wa (wcel N (cfv c3 cuz)) (wceq (cfv W chash) (co N c2 cmin))) (wceq (co cc0 (co (co (cfv W chash) c2 caddc) c1 cmin) cfzo) (cun (co cc0 (co (cfv W chash) c1 cmin) cfzo) (cpr (co (cfv W chash) c1 cmin) (cfv W chash)))) $;

--| Lemma 2 for ~ clwwlknonex2 : Transformation of a walk and two edges into a walk extended by two vertices/edges. (Contributed by AV, 22-Sep-2018.) (Revised by AV, 27-Jan-2022.)
theorem clwwlknonex2lem2 {i: setvar} (E: class) (G N: class i) (V W X Y: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wa (wa (w3a (wcel X V) (wcel Y V) (wcel N (cfv c3 cuz))) (w3a (w3a (wcel W (cword V)) (wral i (wcel (cpr (cfv (cv i) W) (cfv (co (cv i) c1 caddc) W)) E) (co cc0 (co (cfv W chash) c1 cmin) cfzo)) (wcel (cpr (cfv W clsw) (cfv cc0 W)) E)) (wceq (cfv W chash) (co N c2 cmin)) (wceq (cfv cc0 W) X))) (wcel (cpr X Y) E)) (wral i (wcel (cpr (cfv (cv i) (co (co W (cs1 X) cconcat) (cs1 Y) cconcat)) (cfv (co (cv i) c1 caddc) (co (co W (cs1 X) cconcat) (cs1 Y) cconcat))) E) (cun (co cc0 (co (cfv W chash) c1 cmin) cfzo) (cpr (co (cfv W chash) c1 cmin) (cfv W chash)))) $;

--| Extending a closed walk ` W ` on vertex ` X ` by an additional edge (forth and back) results in a closed walk. (Contributed by AV, 22-Sep-2018.) (Revised by AV, 25-Feb-2022.) (Proof shortened by AV, 28-Mar-2022.)
theorem clwwlknonex2 (E G N V W X Y: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (w3a (w3a (wcel X V) (wcel Y V) (wcel N (cfv c3 cuz))) (wcel (cpr X Y) E) (wcel W (co X (co N c2 cmin) (cfv G cclwwlknon)))) (wcel (co (co W (cs1 X) cconcat) (cs1 Y) cconcat) (co N G cclwwlkn)) $;

--| Extending a closed walk ` W ` on vertex ` X ` by an additional edge (forth and back) results in a closed walk on vertex ` X ` . (Contributed by AV, 17-Apr-2022.)
theorem clwwlknonex2e (E G N V W X Y: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (w3a (w3a (wcel X V) (wcel Y V) (wcel N (cfv c3 cuz))) (wcel (cpr X Y) E) (wcel W (co X (co N c2 cmin) (cfv G cclwwlknon)))) (wcel (co (co W (cs1 X) cconcat) (cs1 Y) cconcat) (co X N (cfv G cclwwlknon))) $;

--| The sets of closed walks on different vertices are disjunct. (Contributed by Alexander van der Vekens, 7-Oct-2018.) (Revised by AV, 28-May-2021.) (Revised by AV, 3-Mar-2022.) (Proof shortened by AV, 28-Mar-2022.)
theorem clwwlknondisj {x3: setvar} (G N V: class):
  $ wdisj x3 V (co (cv x3) N (cfv G cclwwlknon)) $;

--| The set of closed walks of fixed length ` N ` in a simple graph ` G ` is the union of the closed walks of the fixed length ` N ` on each of the vertices of graph ` G ` . (Contributed by Alexander van der Vekens, 7-Oct-2018.) (Revised by AV, 28-May-2021.) (Revised by AV, 3-Mar-2022.) (Proof shortened by AV, 28-Mar-2022.)
theorem clwwlknun {x3: setvar} (G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel G cusgr) (wceq (co N G cclwwlkn) (ciun x3 V (co (cv x3) N (cfv G cclwwlknon)))) $;

--| There is a bijection between the set of closed walks of a fixed length ` N ` on a fixed vertex ` X ` represented by walks (as word) and the set of closed walks (as words) of the fixed length ` N ` on the fixed vertex ` X ` . The difference between these two representations is that in the first case the fixed vertex is repeated at the end of the word, and in the second case it is not. (Contributed by Alexander van der Vekens, 29-Sep-2018.) (Revised by AV, 26-Apr-2021.) (Revised by AV, 7-Jul-2022.) (Proof shortened by AV, 2-Nov-2022.)
theorem clwwlkvbij {w f2: setvar} (G N: class) (V: class w) (X: class):
  $ wi (wa (wcel X V) (wcel N cn)) (wex f2 (wf1o (crab w (wa (wceq (cfv (cv w) clsw) (cfv cc0 (cv w))) (wceq (cfv cc0 (cv w)) X)) (co N G cwwlksn)) (co X N (cfv G cclwwlknon)) (cv f2))) $;

--| The empty set (empty sequence of edges) is an s-walk of edges for all s. (Contributed by AV, 4-Jan-2021.)
theorem _0ewlk (S G: class):
  $ wi (wa (wcel G cvv) (wcel S cxnn0)) (wcel c0 (co G S cewlks)) $;

--| A sequence of 1 edge is an s-walk of edges for all s. (Contributed by AV, 5-Jan-2021.)
theorem _1ewlk (S G I: class):
  $ wi (w3a (wcel G cvv) (wcel S cxnn0) (wcel I (cdm (cfv G ciedg)))) (wcel (cs1 I) (co G S cewlks)) $;

--| A pair of an empty set (of edges) and a second set (of vertices) is a walk iff the second set contains exactly one vertex. (Contributed by Alexander van der Vekens, 30-Oct-2017.) (Revised by AV, 3-Jan-2021.) (Revised by AV, 30-Oct-2021.)
theorem _0wlk (P U G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel G U) (wb (wbr c0 P (cfv G cwlks)) (wf (co cc0 cc0 cfz) V P)) $;

--| A pair of an empty set (of edges) and a sequence of one vertex is a walk (of length 0). (Contributed by AV, 3-Jan-2021.) (Revised by AV, 23-Mar-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem is0wlk (P G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wceq P (csn (cop cc0 N))) (wcel N V)) (wbr c0 P (cfv G cwlks)) $;

--| Lemma 1 for ~ 0wlkon and ~ 0trlon . (Contributed by AV, 3-Jan-2021.) (Revised by AV, 23-Mar-2021.)
theorem _0wlkonlem1 (P G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wf (co cc0 cc0 cfz) V P) (wceq (cfv cc0 P) N)) (wa (wcel N V) (wcel N V)) $;

--| Lemma 2 for ~ 0wlkon and ~ 0trlon . (Contributed by AV, 3-Jan-2021.) (Revised by AV, 23-Mar-2021.)
theorem _0wlkonlem2 (P G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wf (co cc0 cc0 cfz) V P) (wceq (cfv cc0 P) N)) (wcel P (co V (co cc0 cc0 cfz) cpm)) $;

--| A walk of length 0 from a vertex to itself. (Contributed by Alexander van der Vekens, 2-Dec-2017.) (Revised by AV, 3-Jan-2021.) (Revised by AV, 23-Mar-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem _0wlkon (P G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wf (co cc0 cc0 cfz) V P) (wceq (cfv cc0 P) N)) (wbr c0 P (co N N (cfv G cwlkson))) $;

--| A walk of length 0 from a vertex to itself. (Contributed by AV, 17-Apr-2021.)
theorem _0wlkons1 (G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel N V) (wbr c0 (cs1 N) (co N N (cfv G cwlkson))) $;

--| A pair of an empty set (of edges) and a second set (of vertices) is a trail iff the second set contains exactly one vertex. (Contributed by Alexander van der Vekens, 30-Oct-2017.) (Revised by AV, 7-Jan-2021.) (Revised by AV, 30-Oct-2021.)
theorem _0trl (P U G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel G U) (wb (wbr c0 P (cfv G ctrls)) (wf (co cc0 cc0 cfz) V P)) $;

--| A pair of an empty set (of edges) and a sequence of one vertex is a trail (of length 0). (Contributed by AV, 7-Jan-2021.) (Revised by AV, 23-Mar-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem is0trl (P G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wceq P (csn (cop cc0 N))) (wcel N V)) (wbr c0 P (cfv G ctrls)) $;

--| A trail of length 0 from a vertex to itself. (Contributed by Alexander van der Vekens, 2-Dec-2017.) (Revised by AV, 8-Jan-2021.) (Revised by AV, 23-Mar-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem _0trlon (P G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wf (co cc0 cc0 cfz) V P) (wceq (cfv cc0 P) N)) (wbr c0 P (co N N (cfv G ctrlson))) $;

--| A pair of an empty set (of edges) and a second set (of vertices) is a path iff the second set contains exactly one vertex. (Contributed by Alexander van der Vekens, 30-Oct-2017.) (Revised by AV, 19-Jan-2021.) (Revised by AV, 30-Oct-2021.)
theorem _0pth (P G V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel G W) (wb (wbr c0 P (cfv G cpths)) (wf (co cc0 cc0 cfz) V P)) $;

--| A pair of an empty set (of edges) and a second set (of vertices) is a simple path iff the second set contains exactly one vertex. (Contributed by Alexander van der Vekens, 30-Oct-2017.) (Revised by AV, 18-Jan-2021.) (Revised by AV, 30-Oct-2021.)
theorem _0spth (P G V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel G W) (wb (wbr c0 P (cfv G cspths)) (wf (co cc0 cc0 cfz) V P)) $;

--| A path of length 0 from a vertex to itself. (Contributed by Alexander van der Vekens, 3-Dec-2017.) (Revised by AV, 20-Jan-2021.) (Revised by AV, 30-Oct-2021.)
theorem _0pthon (P G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wf (co cc0 cc0 cfz) V P) (wceq (cfv cc0 P) N)) (wbr c0 P (co N N (cfv G cpthson))) $;

--| A path of length 0 from a vertex to itself. (Contributed by Alexander van der Vekens, 3-Dec-2017.) (Revised by AV, 20-Jan-2021.)
theorem _0pthon1 (G N V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel N V) (wbr c0 (csn (cop cc0 N)) (co N N (cfv G cpthson))) $;

--| For each vertex there is a path of length 0 from the vertex to itself. (Contributed by Alexander van der Vekens, 3-Dec-2017.) (Revised by AV, 21-Jan-2021.)
theorem _0pthonv {f2 p: setvar} (G N: class) (V: class f2 p):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel N V) (wex f2 (wex p (wbr (cv f2) (cv p) (co N N (cfv G cpthson))))) $;

--| A pair of an empty set (of edges) and a second set (of vertices) is a closed walk if and only if the second set contains exactly one vertex (in an undirected graph). (Contributed by Alexander van der Vekens, 15-Mar-2018.) (Revised by AV, 17-Feb-2021.) (Revised by AV, 30-Oct-2021.)
theorem _0clwlk (P G V X: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel G X) (wb (wbr c0 P (cfv G cclwlks)) (wf (co cc0 cc0 cfz) V P)) $;

--| Any vertex (more precisely, a pair of an empty set (of edges) and a singleton function to this vertex) determines a closed walk of length 0. (Contributed by AV, 11-Feb-2022.)
theorem _0clwlkv (P F G V X: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (w3a (wcel X V) (wceq F c0) (wf (csn cc0) (csn X) P)) (wbr F P (cfv G cclwlks)) $;

--| There is no closed walk in the empty set (i.e. the null graph). (Contributed by Alexander van der Vekens, 2-Sep-2018.) (Revised by AV, 5-Mar-2021.)
theorem _0clwlk0:
  $ wceq (cfv c0 cclwlks) c0 $;

--| A pair of an empty set (of edges) and a second set (of vertices) is a circuit if and only if the second set contains exactly one vertex (in an undirected graph). (Contributed by Alexander van der Vekens, 30-Oct-2017.) (Revised by AV, 31-Jan-2021.) (Revised by AV, 30-Oct-2021.)
theorem _0crct (P G W: class):
  $ wi (wcel G W) (wb (wbr c0 P (cfv G ccrcts)) (wf (co cc0 cc0 cfz) (cfv G cvtx) P)) $;

--| A pair of an empty set (of edges) and a second set (of vertices) is a cycle if and only if the second set contains exactly one vertex (in an undirected graph). (Contributed by Alexander van der Vekens, 30-Oct-2017.) (Revised by AV, 31-Jan-2021.) (Revised by AV, 30-Oct-2021.)
theorem _0cycl (P G W: class):
  $ wi (wcel G W) (wb (wbr c0 P (cfv G ccycls)) (wf (co cc0 cc0 cfz) (cfv G cvtx) P)) $;

--| Lemma 1 for ~ 1pthd . (Contributed by Alexander van der Vekens, 4-Dec-2017.) (Revised by AV, 22-Jan-2021.)
theorem _1pthdlem1 (P F J X Y: class):
  $ wceq P (cs2 X Y) $ >
  $ wceq F (cs1 J) $ >
  $ wfun (ccnv (cres P (co c1 (cfv F chash) cfzo))) $;

--| Lemma 2 for ~ 1pthd . (Contributed by Alexander van der Vekens, 4-Dec-2017.) (Revised by AV, 22-Jan-2021.)
theorem _1pthdlem2 (P F J X Y: class):
  $ wceq P (cs2 X Y) $ >
  $ wceq F (cs1 J) $ >
  $ wceq (cin (cima P (cpr cc0 (cfv F chash))) (cima P (co c1 (cfv F chash) cfzo))) c0 $;

--| Lemma 1 for ~ 1wlkd . (Contributed by AV, 22-Jan-2021.)
theorem _1wlkdlem1 (ph: wff) (P F J V X Y: class):
  $ wceq P (cs2 X Y) $ >
  $ wceq F (cs1 J) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wf (co cc0 (cfv F chash) cfz) V P) $;

--| Lemma 2 for ~ 1wlkd . (Contributed by AV, 22-Jan-2021.)
theorem _1wlkdlem2 (ph: wff) (P F I J V X Y: class):
  $ wceq P (cs2 X Y) $ >
  $ wceq F (cs1 J) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi (wa ph (wceq X Y)) (wceq (cfv J I) (csn X)) $ >
  $ wi (wa ph (wne X Y)) (wss (cpr X Y) (cfv J I)) $ >
  $ wi ph (wcel X (cfv J I)) $;

--| Lemma 3 for ~ 1wlkd . (Contributed by AV, 22-Jan-2021.)
theorem _1wlkdlem3 (ph: wff) (P F I J V X Y: class):
  $ wceq P (cs2 X Y) $ >
  $ wceq F (cs1 J) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi (wa ph (wceq X Y)) (wceq (cfv J I) (csn X)) $ >
  $ wi (wa ph (wne X Y)) (wss (cpr X Y) (cfv J I)) $ >
  $ wi ph (wcel F (cword (cdm I))) $;

--| Lemma 4 for ~ 1wlkd . (Contributed by AV, 22-Jan-2021.)
theorem _1wlkdlem4 {k: setvar} (ph: wff k) (P F I: class) (J V X Y: class k):
  $ wceq P (cs2 X Y) $ >
  $ wceq F (cs1 J) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi (wa ph (wceq X Y)) (wceq (cfv J I) (csn X)) $ >
  $ wi (wa ph (wne X Y)) (wss (cpr X Y) (cfv J I)) $ >
  $ wi ph (wral k (wif (wceq (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (wceq (cfv (cfv (cv k) F) I) (csn (cfv (cv k) P))) (wss (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (cfv (cfv (cv k) F) I))) (co cc0 (cfv F chash) cfzo)) $;

--| In a graph with two vertices and an edge connecting these two vertices, to go from one vertex to the other vertex via this edge is a walk. The two vertices need not be distinct (in the case of a loop). (Contributed by AV, 22-Jan-2021.) (Revised by AV, 23-Mar-2021.)
theorem _1wlkd (ph: wff) (P F G I J V X Y: class):
  $ wceq P (cs2 X Y) $ >
  $ wceq F (cs1 J) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi (wa ph (wceq X Y)) (wceq (cfv J I) (csn X)) $ >
  $ wi (wa ph (wne X Y)) (wss (cpr X Y) (cfv J I)) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wbr F P (cfv G cwlks)) $;

--| In a graph with two vertices and an edge connecting these two vertices, to go from one vertex to the other vertex via this edge is a trail. The two vertices need not be distinct (in the case of a loop). (Contributed by Alexander van der Vekens, 3-Dec-2017.) (Revised by AV, 22-Jan-2021.) (Revised by AV, 23-Mar-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem _1trld (ph: wff) (P F G I J V X Y: class):
  $ wceq P (cs2 X Y) $ >
  $ wceq F (cs1 J) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi (wa ph (wceq X Y)) (wceq (cfv J I) (csn X)) $ >
  $ wi (wa ph (wne X Y)) (wss (cpr X Y) (cfv J I)) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wbr F P (cfv G ctrls)) $;

--| In a graph with two vertices and an edge connecting these two vertices, to go from one vertex to the other vertex via this edge is a path. The two vertices need not be distinct (in the case of a loop) - in this case, however, the path is not a simple path. (Contributed by Alexander van der Vekens, 3-Dec-2017.) (Revised by AV, 22-Jan-2021.) (Revised by AV, 23-Mar-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem _1pthd (ph: wff) (P F G I J V X Y: class):
  $ wceq P (cs2 X Y) $ >
  $ wceq F (cs1 J) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi (wa ph (wceq X Y)) (wceq (cfv J I) (csn X)) $ >
  $ wi (wa ph (wne X Y)) (wss (cpr X Y) (cfv J I)) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wbr F P (cfv G cpths)) $;

--| In a graph with two vertices and an edge connecting these two vertices, to go from one vertex to the other vertex via this edge is a path from one of these vertices to the other vertex. The two vertices need not be distinct (in the case of a loop) - in this case, however, the path is not a simple path. (Contributed by Alexander van der Vekens, 4-Dec-2017.) (Revised by AV, 22-Jan-2021.) (Revised by AV, 23-Mar-2021.)
theorem _1pthond (ph: wff) (P F G I J V X Y: class):
  $ wceq P (cs2 X Y) $ >
  $ wceq F (cs1 J) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi (wa ph (wceq X Y)) (wceq (cfv J I) (csn X)) $ >
  $ wi (wa ph (wne X Y)) (wss (cpr X Y) (cfv J I)) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wbr F P (co X Y (cfv G cpthson))) $;

--| Lemma 1 for ~ upgr1wlkd . (Contributed by AV, 22-Jan-2021.)
theorem upgr1wlkdlem1 (ph: wff) (P F G J X Y: class):
  $ wceq P (cs2 X Y) $ >
  $ wceq F (cs1 J) $ >
  $ wi ph (wcel X (cfv G cvtx)) $ >
  $ wi ph (wcel Y (cfv G cvtx)) $ >
  $ wi ph (wceq (cfv J (cfv G ciedg)) (cpr X Y)) $ >
  $ wi (wa ph (wceq X Y)) (wceq (cfv J (cfv G ciedg)) (csn X)) $;

--| Lemma 2 for ~ upgr1wlkd . (Contributed by AV, 22-Jan-2021.)
theorem upgr1wlkdlem2 (ph: wff) (P F G J X Y: class):
  $ wceq P (cs2 X Y) $ >
  $ wceq F (cs1 J) $ >
  $ wi ph (wcel X (cfv G cvtx)) $ >
  $ wi ph (wcel Y (cfv G cvtx)) $ >
  $ wi ph (wceq (cfv J (cfv G ciedg)) (cpr X Y)) $ >
  $ wi (wa ph (wne X Y)) (wss (cpr X Y) (cfv J (cfv G ciedg))) $;

--| In a pseudograph with two vertices and an edge connecting these two vertices, to go from one vertex to the other vertex via this edge is a walk. The two vertices need not be distinct (in the case of a loop). (Contributed by AV, 22-Jan-2021.)
theorem upgr1wlkd (ph: wff) (P F G J X Y: class):
  $ wceq P (cs2 X Y) $ >
  $ wceq F (cs1 J) $ >
  $ wi ph (wcel X (cfv G cvtx)) $ >
  $ wi ph (wcel Y (cfv G cvtx)) $ >
  $ wi ph (wceq (cfv J (cfv G ciedg)) (cpr X Y)) $ >
  $ wi ph (wcel G cupgr) $ >
  $ wi ph (wbr F P (cfv G cwlks)) $;

--| In a pseudograph with two vertices and an edge connecting these two vertices, to go from one vertex to the other vertex via this edge is a trail. The two vertices need not be distinct (in the case of a loop). (Contributed by AV, 22-Jan-2021.)
theorem upgr1trld (ph: wff) (P F G J X Y: class):
  $ wceq P (cs2 X Y) $ >
  $ wceq F (cs1 J) $ >
  $ wi ph (wcel X (cfv G cvtx)) $ >
  $ wi ph (wcel Y (cfv G cvtx)) $ >
  $ wi ph (wceq (cfv J (cfv G ciedg)) (cpr X Y)) $ >
  $ wi ph (wcel G cupgr) $ >
  $ wi ph (wbr F P (cfv G ctrls)) $;

--| In a pseudograph with two vertices and an edge connecting these two vertices, to go from one vertex to the other vertex via this edge is a path. The two vertices need not be distinct (in the case of a loop) - in this case, however, the path is not a simple path. (Contributed by AV, 22-Jan-2021.)
theorem upgr1pthd (ph: wff) (P F G J X Y: class):
  $ wceq P (cs2 X Y) $ >
  $ wceq F (cs1 J) $ >
  $ wi ph (wcel X (cfv G cvtx)) $ >
  $ wi ph (wcel Y (cfv G cvtx)) $ >
  $ wi ph (wceq (cfv J (cfv G ciedg)) (cpr X Y)) $ >
  $ wi ph (wcel G cupgr) $ >
  $ wi ph (wbr F P (cfv G cpths)) $;

--| In a pseudograph with two vertices and an edge connecting these two vertices, to go from one vertex to the other vertex via this edge is a path from one of these vertices to the other vertex. The two vertices need not be distinct (in the case of a loop) - in this case, however, the path is not a simple path. (Contributed by AV, 22-Jan-2021.)
theorem upgr1pthond (ph: wff) (P F G J X Y: class):
  $ wceq P (cs2 X Y) $ >
  $ wceq F (cs1 J) $ >
  $ wi ph (wcel X (cfv G cvtx)) $ >
  $ wi ph (wcel Y (cfv G cvtx)) $ >
  $ wi ph (wceq (cfv J (cfv G ciedg)) (cpr X Y)) $ >
  $ wi ph (wcel G cupgr) $ >
  $ wi ph (wbr F P (co X Y (cfv G cpthson))) $;

--| A loop (which is an edge at index ` J ` ) induces a path of length 1 from a vertex to itself in a hypergraph. (Contributed by AV, 1-Feb-2021.)
theorem lppthon (A2 G I J: class):
  $ wceq I (cfv G ciedg) $ >
  $ wi (w3a (wcel G cuhgr) (wcel J (cdm I)) (wceq (cfv J I) (csn A2))) (wbr (cs1 J) (cs2 A2 A2) (co A2 A2 (cfv G cpthson))) $;

--| A loop (which is an edge at index ` J ` ) induces a cycle of length 1 in a hypergraph. (Contributed by AV, 2-Feb-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem lp1cycl (A2 G I J: class):
  $ wceq I (cfv G ciedg) $ >
  $ wi (w3a (wcel G cuhgr) (wcel J (cdm I)) (wceq (cfv J I) (csn A2))) (wbr (cs1 J) (cs2 A2 A2) (cfv G ccycls)) $;

--| A hypergraph has a cycle of length one if and only if it has a loop. (Contributed by BTernaryTau, 13-Oct-2023.)
theorem loop1cycl {f2 p: setvar} (A2 G: class):
  $ wi (wcel G cuhgr) (wb (wex f2 (wex p (w3a (wbr (cv f2) (cv p) (cfv G ccycls)) (wceq (cfv (cv f2) chash) c1) (wceq (cfv cc0 (cv p)) A2)))) (wcel (csn A2) (cfv G cedg))) $;

--| Construction of a 2-cycle from two given edges in a graph. (Contributed by BTernaryTau, 16-Oct-2023.)
theorem _2cycld (ph: wff) (A2 B2 C P F G I J K V: class):
  $ wceq P (cs3 A2 B2 C) $ >
  $ wceq F (cs2 J K) $ >
  $ wi ph (w3a (wcel A2 V) (wcel B2 V) (wcel C V)) $ >
  $ wi ph (wa (wne A2 B2) (wne B2 C)) $ >
  $ wi ph (wa (wss (cpr A2 B2) (cfv J I)) (wss (cpr B2 C) (cfv K I))) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wne J K) $ >
  $ wi ph (wceq A2 C) $ >
  $ wi ph (wbr F P (cfv G ccycls)) $;

--| Lemma for ~ umgr2cycl . (Contributed by BTernaryTau, 17-Oct-2023.)
theorem umgr2cycllem {p: setvar} (ph: wff p) (F G: class) (I J K: class p):
  $ wceq F (cs2 J K) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wcel G cumgr) $ >
  $ wi ph (wcel J (cdm I)) $ >
  $ wi ph (wne J K) $ >
  $ wi ph (wceq (cfv J I) (cfv K I)) $ >
  $ wi ph (wex p (wbr F (cv p) (cfv G ccycls))) $;

--| A multigraph with two distinct edges that connect the same vertices has a 2-cycle. (Contributed by BTernaryTau, 17-Oct-2023.)
theorem umgr2cycl {f2 j k p: setvar} (G: class) (I: class f2 j p):
  $ wceq I (cfv G ciedg) $ >
  $ wi (wa (wcel G cumgr) (wrex j (wrex k (wa (wceq (cfv (cv j) I) (cfv (cv k) I)) (wne (cv j) (cv k))) (cdm I)) (cdm I))) (wex f2 (wex p (wa (wbr (cv f2) (cv p) (cfv G ccycls)) (wceq (cfv (cv f2) chash) c2)))) $;

--| Extend class notation with acyclic graphs.
term cacycgr: class;

--| Define the class of all acyclic graphs. A graph is called _acyclic_ if it has no (non-trivial) cycles. (Contributed by BTernaryTau, 11-Oct-2023.)
axiom df_acycgr {f2 g2 p: setvar}:
  $ wceq cacycgr (cab g2 (wn (wex f2 (wex p (wa (wbr (cv f2) (cv p) (cfv (cv g2) ccycls)) (wne (cv f2) c0)))))) $;

--| An alternate definition of the class of all acyclic graphs that requires all cycles to be trivial. (Contributed by BTernaryTau, 11-Oct-2023.)
theorem dfacycgr1 {f2 g2 p: setvar}:
  $ wceq cacycgr (cab g2 (wal f2 (wal p (wi (wbr (cv f2) (cv p) (cfv (cv g2) ccycls)) (wceq (cv f2) c0))))) $;

--| The property of being an acyclic graph. (Contributed by BTernaryTau, 11-Oct-2023.)
theorem isacycgr {f2 p: setvar} (G: class) (W: class f2 p):
  $ wi (wcel G W) (wb (wcel G cacycgr) (wn (wex f2 (wex p (wa (wbr (cv f2) (cv p) (cfv G ccycls)) (wne (cv f2) c0)))))) $;

--| The property of being an acyclic graph. (Contributed by BTernaryTau, 11-Oct-2023.)
theorem isacycgr1 {f2 p: setvar} (G: class) (W: class f2 p):
  $ wi (wcel G W) (wb (wcel G cacycgr) (wal f2 (wal p (wi (wbr (cv f2) (cv p) (cfv G ccycls)) (wceq (cv f2) c0))))) $;

--| Any cycle in an acyclic graph is trivial (i.e. has one vertex and no edges). (Contributed by BTernaryTau, 12-Oct-2023.)
theorem acycgrcycl (P F G: class):
  $ wi (wa (wcel G cacycgr) (wbr F P (cfv G ccycls))) (wceq F c0) $;

--| For each pair of adjacent vertices there is a path of length 1 from one vertex to the other in a hypergraph. (Contributed by Alexander van der Vekens, 4-Dec-2017.) (Revised by AV, 22-Jan-2021.)
theorem _1pthon2v {e f2 p: setvar} (A2 B2: class) (E: class e f2 p) (G: class) (V: class f2 p):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (w3a (wcel G cuhgr) (wa (wcel A2 V) (wcel B2 V)) (wrex e (wss (cpr A2 B2) (cv e)) E)) (wex f2 (wex p (wbr (cv f2) (cv p) (co A2 B2 (cfv G cpthson))))) $;

--| For each pair of adjacent vertices there is a path of length 1 from one vertex to the other in a hypergraph. (Contributed by Alexander van der Vekens, 4-Dec-2017.) (Revised by AV, 22-Jan-2021.) (Proof shortened by AV, 15-Feb-2021.)
theorem _1pthon2ve {f2 p: setvar} (A2 B2: class) (E: class f2 p) (G: class) (V: class f2 p):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (w3a (wcel G cuhgr) (wa (wcel A2 V) (wcel B2 V)) (wcel (cpr A2 B2) E)) (wex f2 (wex p (wbr (cv f2) (cv p) (co A2 B2 (cfv G cpthson))))) $;

--| Lemma 1 for ~ wlk2v2e : ` F ` is a length 2 word of over ` { 0 } ` , the domain of the singleton word ` I ` . (Contributed by Alexander van der Vekens, 22-Oct-2017.) (Revised by AV, 9-Jan-2021.)
theorem wlk2v2elem1 (F I X Y: class):
  $ wceq I (cs1 (cpr X Y)) $ >
  $ wceq F (cs2 cc0 cc0) $ >
  $ wcel F (cword (cdm I)) $;

--| Lemma 2 for ~ wlk2v2e : The values of ` I ` after ` F ` are edges between two vertices enumerated by ` P ` . (Contributed by Alexander van der Vekens, 22-Oct-2017.) (Revised by AV, 9-Jan-2021.)
theorem wlk2v2elem2 {k: setvar} (P F I: class) (X Y: class k):
  $ wceq I (cs1 (cpr X Y)) $ >
  $ wceq F (cs2 cc0 cc0) $ >
  $ wcel X cvv $ >
  $ wcel Y cvv $ >
  $ wceq P (cs3 X Y X) $ >
  $ wral k (wceq (cfv (cfv (cv k) F) I) (cpr (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P))) (co cc0 (cfv F chash) cfzo) $;

--| In a graph with two vertices and one edge connecting these two vertices, to go from one vertex to the other and back to the first vertex via the same/only edge is a walk. Notice that ` G ` is a simple graph (without loops) only if ` X =/= Y ` . (Contributed by Alexander van der Vekens, 22-Oct-2017.) (Revised by AV, 8-Jan-2021.)
theorem wlk2v2e (P F G I X Y: class):
  $ wceq I (cs1 (cpr X Y)) $ >
  $ wceq F (cs2 cc0 cc0) $ >
  $ wcel X cvv $ >
  $ wcel Y cvv $ >
  $ wceq P (cs3 X Y X) $ >
  $ wceq G (cop (cpr X Y) I) $ >
  $ wbr F P (cfv G cwlks) $;

--| A walk which is not a trail: In a graph with two vertices and one edge connecting these two vertices, to go from one vertex to the other and back to the first vertex via the same/only edge is a walk, see ~ wlk2v2e , but not a trail. Notice that ` G ` is a simple graph (without loops) only if ` X =/= Y ` . (Contributed by Alexander van der Vekens, 22-Oct-2017.) (Revised by AV, 8-Jan-2021.) (Proof shortened by AV, 30-Oct-2021.)
theorem ntrl2v2e (P F G I X Y: class):
  $ wceq I (cs1 (cpr X Y)) $ >
  $ wceq F (cs2 cc0 cc0) $ >
  $ wcel X cvv $ >
  $ wcel Y cvv $ >
  $ wceq P (cs3 X Y X) $ >
  $ wceq G (cop (cpr X Y) I) $ >
  $ wn (wbr F P (cfv G ctrls)) $;

--| Lemma 1 for ~ 3wlkd . (Contributed by AV, 7-Feb-2021.)
theorem _3wlkdlem1 (A2 B2 C D P F J K L: class):
  $ wceq P (cs4 A2 B2 C D) $ >
  $ wceq F (cs3 J K L) $ >
  $ wceq (cfv P chash) (co (cfv F chash) c1 caddc) $;

--| Lemma 2 for ~ 3wlkd . (Contributed by AV, 7-Feb-2021.)
theorem _3wlkdlem2 (A2 B2 C D P F J K L: class):
  $ wceq P (cs4 A2 B2 C D) $ >
  $ wceq F (cs3 J K L) $ >
  $ wceq (co cc0 (cfv F chash) cfzo) (ctp cc0 c1 c2) $;

--| Lemma 3 for ~ 3wlkd . (Contributed by Alexander van der Vekens, 10-Nov-2017.) (Revised by AV, 7-Feb-2021.)
theorem _3wlkdlem3 (ph: wff) (A2 B2 C D P F J K L V: class):
  $ wceq P (cs4 A2 B2 C D) $ >
  $ wceq F (cs3 J K L) $ >
  $ wi ph (wa (wa (wcel A2 V) (wcel B2 V)) (wa (wcel C V) (wcel D V))) $ >
  $ wi ph (wa (wa (wceq (cfv cc0 P) A2) (wceq (cfv c1 P) B2)) (wa (wceq (cfv c2 P) C) (wceq (cfv c3 P) D))) $;

--| Lemma 4 for ~ 3wlkd . (Contributed by Alexander van der Vekens, 11-Nov-2017.) (Revised by AV, 7-Feb-2021.)
theorem _3wlkdlem4 {k: setvar} (ph: wff k) (A2 B2 C D P F J K L V: class):
  $ wceq P (cs4 A2 B2 C D) $ >
  $ wceq F (cs3 J K L) $ >
  $ wi ph (wa (wa (wcel A2 V) (wcel B2 V)) (wa (wcel C V) (wcel D V))) $ >
  $ wi ph (wral k (wcel (cfv (cv k) P) V) (co cc0 (cfv F chash) cfz)) $;

--| Lemma 5 for ~ 3wlkd . (Contributed by Alexander van der Vekens, 11-Nov-2017.) (Revised by AV, 7-Feb-2021.)
theorem _3wlkdlem5 {k: setvar} (ph: wff k) (A2 B2 C D P F J K L V: class):
  $ wceq P (cs4 A2 B2 C D) $ >
  $ wceq F (cs3 J K L) $ >
  $ wi ph (wa (wa (wcel A2 V) (wcel B2 V)) (wa (wcel C V) (wcel D V))) $ >
  $ wi ph (w3a (wa (wne A2 B2) (wne A2 C)) (wa (wne B2 C) (wne B2 D)) (wne C D)) $ >
  $ wi ph (wral k (wne (cfv (cv k) P) (cfv (co (cv k) c1 caddc) P)) (co cc0 (cfv F chash) cfzo)) $;

--| Lemma 1 for ~ 3pthd . (Contributed by AV, 9-Feb-2021.)
theorem _3pthdlem1 {j k: setvar} (ph: wff j k) (A2 B2 C D: class j) (P F: class) (J K L V: class j):
  $ wceq P (cs4 A2 B2 C D) $ >
  $ wceq F (cs3 J K L) $ >
  $ wi ph (wa (wa (wcel A2 V) (wcel B2 V)) (wa (wcel C V) (wcel D V))) $ >
  $ wi ph (w3a (wa (wne A2 B2) (wne A2 C)) (wa (wne B2 C) (wne B2 D)) (wne C D)) $ >
  $ wi ph (wral k (wral j (wi (wne (cv k) (cv j)) (wne (cfv (cv k) P) (cfv (cv j) P))) (co c1 (cfv F chash) cfzo)) (co cc0 (cfv P chash) cfzo)) $;

--| Lemma 6 for ~ 3wlkd . (Contributed by AV, 7-Feb-2021.)
theorem _3wlkdlem6 (ph: wff) (A2 B2 C D P F I J K L V: class):
  $ wceq P (cs4 A2 B2 C D) $ >
  $ wceq F (cs3 J K L) $ >
  $ wi ph (wa (wa (wcel A2 V) (wcel B2 V)) (wa (wcel C V) (wcel D V))) $ >
  $ wi ph (w3a (wa (wne A2 B2) (wne A2 C)) (wa (wne B2 C) (wne B2 D)) (wne C D)) $ >
  $ wi ph (w3a (wss (cpr A2 B2) (cfv J I)) (wss (cpr B2 C) (cfv K I)) (wss (cpr C D) (cfv L I))) $ >
  $ wi ph (w3a (wcel A2 (cfv J I)) (wcel B2 (cfv K I)) (wcel C (cfv L I))) $;

--| Lemma 7 for ~ 3wlkd . (Contributed by AV, 7-Feb-2021.)
theorem _3wlkdlem7 (ph: wff) (A2 B2 C D P F I J K L V: class):
  $ wceq P (cs4 A2 B2 C D) $ >

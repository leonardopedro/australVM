  $ wi ph (wceq (cfv T c2nd) N) $ >
  $ wi ph (wreu z (wne (cv z) T) S) $;

--| Lemma for ~ poimir , that a given face belongs to exactly two simplices, provided it's not on the boundary of the cube. (Contributed by Brendan Leahy, 21-Aug-2020.)
theorem poimirlem22 {y1 z t f2 j n p: setvar} (ph: wff f2) (S: class f2) (T F: class) (K: class y1) (N: class):
  $ wi ph (wcel N cn) $ >
  $ wceq S (crab t (wceq F (cmpt y1 (co cc0 (co N c1 cmin) cfz) (csb j (cif (wbr (cv y1) (cfv (cv t) c2nd) clt) (cv y1) (co (cv y1) c1 caddc)) (co (cfv (cfv (cv t) c1st) c1st) (cun (cxp (cima (cfv (cfv (cv t) c1st) c2nd) (co c1 (cv j) cfz)) (csn c1)) (cxp (cima (cfv (cfv (cv t) c1st) c2nd) (co (co (cv j) c1 caddc) N cfz)) (csn cc0))) (cof caddc))))) (cxp (cxp (co (co cc0 K cfzo) (co c1 N cfz) cmap) (cab f2 (wf1o (co c1 N cfz) (co c1 N cfz) (cv f2)))) (co cc0 N cfz))) $ >
  $ wi ph (wf (co cc0 (co N c1 cmin) cfz) (co (co cc0 K cfz) (co c1 N cfz) cmap) F) $ >
  $ wi ph (wcel T S) $ >
  $ wi (wa ph (wcel (cv n) (co c1 N cfz))) (wrex p (wne (cfv (cv n) (cv p)) cc0) (crn F)) $ >
  $ wi (wa ph (wcel (cv n) (co c1 N cfz))) (wrex p (wne (cfv (cv n) (cv p)) K) (crn F)) $ >
  $ wi ph (wreu z (wne (cv z) T) S) $;

--| Lemma for ~ poimir , two ways of expressing the property that a face is not on the back face of the cube. (Contributed by Brendan Leahy, 21-Aug-2020.)
theorem poimirlem23 {y1 j p: setvar} (ph: wff) (T U K N V: class):
  $ wi ph (wcel N cn) $ >
  $ wi ph (wf (co c1 N cfz) (co cc0 K cfzo) T) $ >
  $ wi ph (wf1o (co c1 N cfz) (co c1 N cfz) U) $ >
  $ wi ph (wcel V (co cc0 N cfz)) $ >
  $ wi ph (wb (wrex p (wne (cfv N (cv p)) cc0) (crn (cmpt y1 (co cc0 (co N c1 cmin) cfz) (csb j (cif (wbr (cv y1) V clt) (cv y1) (co (cv y1) c1 caddc)) (co T (cun (cxp (cima U (co c1 (cv j) cfz)) (csn c1)) (cxp (cima U (co (co (cv j) c1 caddc) N cfz)) (csn cc0))) (cof caddc)))))) (wn (wa (wceq V N) (wa (wceq (cfv N T) cc0) (wceq (cfv N U) N))))) $;

--| Lemma for ~ poimir , two ways of expressing that a simplex has an admissible face on the back face of the cube. (Contributed by Brendan Leahy, 21-Aug-2020.)
theorem poimirlem24 {x3 y1 i j s1 p: setvar} (ph: wff) (B2: class p) (C: class j s1) (T U K N V: class):
  $ wi ph (wcel N cn) $ >
  $ wi (wceq (cv p) (co (cfv (cv s1) c1st) (cun (cxp (cima (cfv (cv s1) c2nd) (co c1 (cv j) cfz)) (csn c1)) (cxp (cima (cfv (cv s1) c2nd) (co (co (cv j) c1 caddc) N cfz)) (csn cc0))) (cof caddc))) (wceq B2 C) $ >
  $ wi (wa ph (wf (co c1 N cfz) (co cc0 K cfz) (cv p))) (wcel B2 (co cc0 N cfz)) $ >
  $ wi ph (wf (co c1 N cfz) (co cc0 K cfzo) T) $ >
  $ wi ph (wf1o (co c1 N cfz) (co c1 N cfz) U) $ >
  $ wi ph (wcel V (co cc0 N cfz)) $ >
  $ wi ph (wb (wrex x3 (wa (wceq (cv x3) (cmpt y1 (co cc0 (co N c1 cmin) cfz) (csb j (cif (wbr (cv y1) V clt) (cv y1) (co (cv y1) c1 caddc)) (co T (cun (cxp (cima U (co c1 (cv j) cfz)) (csn c1)) (cxp (cima U (co (co (cv j) c1 caddc) N cfz)) (csn cc0))) (cof caddc))))) (wa (wss (co cc0 (co N c1 cmin) cfz) (crn (cmpt p (crn (cv x3)) B2))) (wrex p (wne (cfv N (cv p)) cc0) (crn (cv x3))))) (co (co (co cc0 K cfz) (co c1 N cfz) cmap) (co cc0 (co N c1 cmin) cfz) cmap)) (wa (wral i (wrex j (wceq (cv i) (csb s1 (cop T U) C)) (cdif (co cc0 N cfz) (csn V))) (co cc0 (co N c1 cmin) cfz)) (wn (wa (wceq V N) (wa (wceq (cfv N T) cc0) (wceq (cfv N U) N)))))) $;

--| Lemma for ~ poimir stating that for a given simplex such that no vertex maps to ` N ` , the number of admissible faces is even. (Contributed by Brendan Leahy, 21-Aug-2020.)
theorem poimirlem25 {y1 i j s1 p: setvar} (ph: wff) (B2: class p) (C: class j s1) (T U K N: class):
  $ wi ph (wcel N cn) $ >
  $ wi (wceq (cv p) (co (cfv (cv s1) c1st) (cun (cxp (cima (cfv (cv s1) c2nd) (co c1 (cv j) cfz)) (csn c1)) (cxp (cima (cfv (cv s1) c2nd) (co (co (cv j) c1 caddc) N cfz)) (csn cc0))) (cof caddc))) (wceq B2 C) $ >
  $ wi (wa ph (wf (co c1 N cfz) (co cc0 K cfz) (cv p))) (wcel B2 (co cc0 N cfz)) $ >
  $ wi ph (wf (co c1 N cfz) (co cc0 K cfzo) T) $ >
  $ wi ph (wf1o (co c1 N cfz) (co c1 N cfz) U) $ >
  $ wi (wa ph (wcel (cv j) (co cc0 N cfz))) (wne N (csb s1 (cop T U) C)) $ >
  $ wi ph (wbr c2 (cfv (crab y1 (wral i (wrex j (wceq (cv i) (csb s1 (cop T U) C)) (cdif (co cc0 N cfz) (csn (cv y1)))) (co cc0 (co N c1 cmin) cfz)) (co cc0 N cfz)) chash) cdvds) $;

--| Lemma for ~ poimir showing an even difference between the number of admissible faces and the number of admissible simplices. Equation (6) of [Kulpa] p. 548. (Contributed by Brendan Leahy, 21-Aug-2020.)
theorem poimirlem26 {t f2 i j s1 p: setvar} (ph: wff f2) (B2: class p) (C: class f2 j s1) (K N: class):
  $ wi ph (wcel N cn) $ >
  $ wi (wceq (cv p) (co (cfv (cv s1) c1st) (cun (cxp (cima (cfv (cv s1) c2nd) (co c1 (cv j) cfz)) (csn c1)) (cxp (cima (cfv (cv s1) c2nd) (co (co (cv j) c1 caddc) N cfz)) (csn cc0))) (cof caddc))) (wceq B2 C) $ >
  $ wi (wa ph (wf (co c1 N cfz) (co cc0 K cfz) (cv p))) (wcel B2 (co cc0 N cfz)) $ >
  $ wi ph (wbr c2 (co (cfv (crab t (wral i (wrex j (wceq (cv i) (csb s1 (cfv (cv t) c1st) C)) (cdif (co cc0 N cfz) (csn (cfv (cv t) c2nd)))) (co cc0 (co N c1 cmin) cfz)) (cxp (cxp (co (co cc0 K cfzo) (co c1 N cfz) cmap) (cab f2 (wf1o (co c1 N cfz) (co c1 N cfz) (cv f2)))) (co cc0 N cfz))) chash) (cfv (crab s1 (wral i (wrex j (wceq (cv i) C) (co cc0 N cfz)) (co cc0 N cfz)) (cxp (co (co cc0 K cfzo) (co c1 N cfz) cmap) (cab f2 (wf1o (co c1 N cfz) (co c1 N cfz) (cv f2))))) chash) cmin) cdvds) $;

--| Lemma for ~ poimir showing that the difference between admissible faces in the whole cube and admissible faces on the back face is even. Equation (7) of [Kulpa] p. 548. (Contributed by Brendan Leahy, 21-Aug-2020.)
theorem poimirlem27 {t f2 i j n s1 p: setvar} (ph: wff f2) (B2: class p) (C: class f2 j s1) (K N: class):
  $ wi ph (wcel N cn) $ >
  $ wi (wceq (cv p) (co (cfv (cv s1) c1st) (cun (cxp (cima (cfv (cv s1) c2nd) (co c1 (cv j) cfz)) (csn c1)) (cxp (cima (cfv (cv s1) c2nd) (co (co (cv j) c1 caddc) N cfz)) (csn cc0))) (cof caddc))) (wceq B2 C) $ >
  $ wi (wa ph (wf (co c1 N cfz) (co cc0 K cfz) (cv p))) (wcel B2 (co cc0 N cfz)) $ >
  $ wi (wa ph (w3a (wcel (cv n) (co c1 N cfz)) (wf (co c1 N cfz) (co cc0 K cfz) (cv p)) (wceq (cfv (cv n) (cv p)) cc0))) (wbr B2 (cv n) clt) $ >
  $ wi (wa ph (w3a (wcel (cv n) (co c1 N cfz)) (wf (co c1 N cfz) (co cc0 K cfz) (cv p)) (wceq (cfv (cv n) (cv p)) K))) (wne B2 (co (cv n) c1 cmin)) $ >
  $ wi ph (wbr c2 (co (cfv (crab t (wral i (wrex j (wceq (cv i) (csb s1 (cfv (cv t) c1st) C)) (cdif (co cc0 N cfz) (csn (cfv (cv t) c2nd)))) (co cc0 (co N c1 cmin) cfz)) (cxp (cxp (co (co cc0 K cfzo) (co c1 N cfz) cmap) (cab f2 (wf1o (co c1 N cfz) (co c1 N cfz) (cv f2)))) (co cc0 N cfz))) chash) (cfv (crab s1 (w3a (wral i (wrex j (wceq (cv i) C) (co cc0 (co N c1 cmin) cfz)) (co cc0 (co N c1 cmin) cfz)) (wceq (cfv N (cfv (cv s1) c1st)) cc0) (wceq (cfv N (cfv (cv s1) c2nd)) N)) (cxp (co (co cc0 K cfzo) (co c1 N cfz) cmap) (cab f2 (wf1o (co c1 N cfz) (co c1 N cfz) (cv f2))))) chash) cmin) cdvds) $;

--| Lemma for ~ poimir , a variant of Sperner's lemma. (Contributed by Brendan Leahy, 21-Aug-2020.)
theorem poimirlem28 {f2 i j n s1 p: setvar} (ph: wff f2) (B2: class p) (C: class f2 j s1) (K N: class):
  $ wi ph (wcel N cn) $ >
  $ wi (wceq (cv p) (co (cfv (cv s1) c1st) (cun (cxp (cima (cfv (cv s1) c2nd) (co c1 (cv j) cfz)) (csn c1)) (cxp (cima (cfv (cv s1) c2nd) (co (co (cv j) c1 caddc) N cfz)) (csn cc0))) (cof caddc))) (wceq B2 C) $ >
  $ wi (wa ph (wf (co c1 N cfz) (co cc0 K cfz) (cv p))) (wcel B2 (co cc0 N cfz)) $ >
  $ wi (wa ph (w3a (wcel (cv n) (co c1 N cfz)) (wf (co c1 N cfz) (co cc0 K cfz) (cv p)) (wceq (cfv (cv n) (cv p)) cc0))) (wbr B2 (cv n) clt) $ >
  $ wi (wa ph (w3a (wcel (cv n) (co c1 N cfz)) (wf (co c1 N cfz) (co cc0 K cfz) (cv p)) (wceq (cfv (cv n) (cv p)) K))) (wne B2 (co (cv n) c1 cmin)) $ >
  $ wi ph (wcel K cn) $ >
  $ wi ph (wrex s1 (wral i (wrex j (wceq (cv i) C) (co cc0 N cfz)) (co cc0 N cfz)) (cxp (co (co cc0 K cfzo) (co c1 N cfz) cmap) (cab f2 (wf1o (co c1 N cfz) (co c1 N cfz) (cv f2))))) $;

--| Lemma for ~ poimir connecting cubes of the tessellation to neighborhoods. (Contributed by Brendan Leahy, 21-Aug-2020.)
theorem poimirlem29 {z v f2 i j k m n r: setvar} (ph: wff f2) (C: class r) (R F G I N: class) (X: class j k n):
  $ wi ph (wcel N cn) $ >
  $ wceq I (co (co cc0 c1 cicc) (co c1 N cfz) cmap) $ >
  $ wceq R (cfv (cxp (co c1 N cfz) (csn (cfv (crn cioo) ctg))) cpt) $ >
  $ wi ph (wcel F (co (co R I crest) R ccn)) $ >
  $ wceq X (cfv (cv n) (cfv (co (co (cfv (cfv (cv k) G) c1st) (cun (cxp (cima (cfv (cfv (cv k) G) c2nd) (co c1 (cv j) cfz)) (csn c1)) (cxp (cima (cfv (cfv (cv k) G) c2nd) (co (co (cv j) c1 caddc) N cfz)) (csn cc0))) (cof caddc)) (cxp (co c1 N cfz) (csn (cv k))) (cof cdiv)) F)) $ >
  $ wi ph (wf cn (cxp (co cn0 (co c1 N cfz) cmap) (cab f2 (wf1o (co c1 N cfz) (co c1 N cfz) (cv f2)))) G) $ >
  $ wi (wa ph (wcel (cv k) cn)) (wss (crn (cfv (cfv (cv k) G) c1st)) (co cc0 (cv k) cfzo)) $ >
  $ wi (wa ph (w3a (wcel (cv k) cn) (wcel (cv n) (co c1 N cfz)) (wcel (cv r) (cpr cle (ccnv cle))))) (wrex j (wbr cc0 X (cv r)) (co cc0 N cfz)) $ >
  $ wi ph (wi (wral i (wrex k (wral m (wcel (cfv (cv m) (co (cfv (cfv (cv k) G) c1st) (cxp (co c1 N cfz) (csn (cv k))) (cof cdiv))) (co (cfv (cv m) C) (co c1 (cv i) cdiv) (cfv (cres (ccom cabs cmin) (cxp cr cr)) cbl))) (co c1 N cfz)) (cfv (cv i) cuz)) cn) (wral n (wral v (wi (wcel C (cv v)) (wral r (wrex z (wbr cc0 (cfv (cv n) (cfv (cv z) F)) (cv r)) (cv v)) (cpr cle (ccnv cle)))) (co R I crest)) (co c1 N cfz))) $;

--| Lemma for ~ poimir combining ~ poimirlem29 with ~ bwth . (Contributed by Brendan Leahy, 21-Aug-2020.)
theorem poimirlem30 {z v f2 j k n r c: setvar} (ph: wff f2) (R F G I N: class) (X: class j k n):
  $ wi ph (wcel N cn) $ >
  $ wceq I (co (co cc0 c1 cicc) (co c1 N cfz) cmap) $ >
  $ wceq R (cfv (cxp (co c1 N cfz) (csn (cfv (crn cioo) ctg))) cpt) $ >
  $ wi ph (wcel F (co (co R I crest) R ccn)) $ >
  $ wceq X (cfv (cv n) (cfv (co (co (cfv (cfv (cv k) G) c1st) (cun (cxp (cima (cfv (cfv (cv k) G) c2nd) (co c1 (cv j) cfz)) (csn c1)) (cxp (cima (cfv (cfv (cv k) G) c2nd) (co (co (cv j) c1 caddc) N cfz)) (csn cc0))) (cof caddc)) (cxp (co c1 N cfz) (csn (cv k))) (cof cdiv)) F)) $ >
  $ wi ph (wf cn (cxp (co cn0 (co c1 N cfz) cmap) (cab f2 (wf1o (co c1 N cfz) (co c1 N cfz) (cv f2)))) G) $ >
  $ wi (wa ph (wcel (cv k) cn)) (wss (crn (cfv (cfv (cv k) G) c1st)) (co cc0 (cv k) cfzo)) $ >
  $ wi (wa ph (w3a (wcel (cv k) cn) (wcel (cv n) (co c1 N cfz)) (wcel (cv r) (cpr cle (ccnv cle))))) (wrex j (wbr cc0 X (cv r)) (co cc0 N cfz)) $ >
  $ wi ph (wrex c (wral n (wral v (wi (wcel (cv c) (cv v)) (wral r (wrex z (wbr cc0 (cfv (cv n) (cfv (cv z) F)) (cv r)) (cv v)) (cpr cle (ccnv cle)))) (co R I crest)) (co c1 N cfz)) I) $;

--| Lemma for ~ poimir , assigning values to the vertices of the tessellation that meet the hypotheses of both ~ poimirlem30 and ~ poimirlem28 . Equation (2) of [Kulpa] p. 547. (Contributed by Brendan Leahy, 21-Aug-2020.)
theorem poimirlem31 {z f2 i j k n a b: setvar} (ph: wff f2 a b) (P: class j k) (R F G I N: class) (r: setvar):
  $ wi ph (wcel N cn) $ >
  $ wceq I (co (co cc0 c1 cicc) (co c1 N cfz) cmap) $ >
  $ wceq R (cfv (cxp (co c1 N cfz) (csn (cfv (crn cioo) ctg))) cpt) $ >
  $ wi ph (wcel F (co (co R I crest) R ccn)) $ >
  $ wi (wa ph (w3a (wcel (cv n) (co c1 N cfz)) (wcel (cv z) I) (wceq (cfv (cv n) (cv z)) cc0))) (wbr (cfv (cv n) (cfv (cv z) F)) cc0 cle) $ >
  $ wceq P (co (cfv (cfv (cv k) G) c1st) (cun (cxp (cima (cfv (cfv (cv k) G) c2nd) (co c1 (cv j) cfz)) (csn c1)) (cxp (cima (cfv (cfv (cv k) G) c2nd) (co (co (cv j) c1 caddc) N cfz)) (csn cc0))) (cof caddc)) $ >
  $ wi ph (wf cn (cxp (co cn0 (co c1 N cfz) cmap) (cab f2 (wf1o (co c1 N cfz) (co c1 N cfz) (cv f2)))) G) $ >
  $ wi (wa ph (wcel (cv k) cn)) (wss (crn (cfv (cfv (cv k) G) c1st)) (co cc0 (cv k) cfzo)) $ >
  $ wi (wa ph (wa (wcel (cv k) cn) (wcel (cv i) (co cc0 N cfz)))) (wrex j (wceq (cv i) (csup (cun (csn cc0) (crab a (wral b (wa (wbr cc0 (cfv (cv b) (cfv (co P (cxp (co c1 N cfz) (csn (cv k))) (cof cdiv)) F)) cle) (wne (cfv (cv b) P) cc0)) (co c1 (cv a) cfz)) (co c1 N cfz))) cr clt)) (co cc0 N cfz)) $ >
  $ wi (wa ph (w3a (wcel (cv k) cn) (wcel (cv n) (co c1 N cfz)) (wcel (cv r) (cpr cle (ccnv cle))))) (wrex j (wbr cc0 (cfv (cv n) (cfv (co P (cxp (co c1 N cfz) (csn (cv k))) (cof cdiv)) F)) (cv r)) (co cc0 N cfz)) $;

--| Lemma for ~ poimir , combining ~ poimirlem28 , ~ poimirlem30 , and ~ poimirlem31 to get Equation (1) of [Kulpa] p. 547. (Contributed by Brendan Leahy, 21-Aug-2020.)
theorem poimirlem32 {z v n r c: setvar} (ph: wff) (R F I N: class):
  $ wi ph (wcel N cn) $ >
  $ wceq I (co (co cc0 c1 cicc) (co c1 N cfz) cmap) $ >
  $ wceq R (cfv (cxp (co c1 N cfz) (csn (cfv (crn cioo) ctg))) cpt) $ >
  $ wi ph (wcel F (co (co R I crest) R ccn)) $ >
  $ wi (wa ph (w3a (wcel (cv n) (co c1 N cfz)) (wcel (cv z) I) (wceq (cfv (cv n) (cv z)) cc0))) (wbr (cfv (cv n) (cfv (cv z) F)) cc0 cle) $ >
  $ wi (wa ph (w3a (wcel (cv n) (co c1 N cfz)) (wcel (cv z) I) (wceq (cfv (cv n) (cv z)) c1))) (wbr cc0 (cfv (cv n) (cfv (cv z) F)) cle) $ >
  $ wi ph (wrex c (wral n (wral v (wi (wcel (cv c) (cv v)) (wral r (wrex z (wbr cc0 (cfv (cv n) (cfv (cv z) F)) (cv r)) (cv v)) (cpr cle (ccnv cle)))) (co R I crest)) (co c1 N cfz)) I) $;

--| Poincare-Miranda theorem. Theorem on [Kulpa] p. 547. (Contributed by Brendan Leahy, 21-Aug-2020.)
theorem poimir {z n c: setvar} (ph: wff) (R F I N: class):
  $ wi ph (wcel N cn) $ >
  $ wceq I (co (co cc0 c1 cicc) (co c1 N cfz) cmap) $ >
  $ wceq R (cfv (cxp (co c1 N cfz) (csn (cfv (crn cioo) ctg))) cpt) $ >
  $ wi ph (wcel F (co (co R I crest) R ccn)) $ >
  $ wi (wa ph (w3a (wcel (cv n) (co c1 N cfz)) (wcel (cv z) I) (wceq (cfv (cv n) (cv z)) cc0))) (wbr (cfv (cv n) (cfv (cv z) F)) cc0 cle) $ >
  $ wi (wa ph (w3a (wcel (cv n) (co c1 N cfz)) (wcel (cv z) I) (wceq (cfv (cv n) (cv z)) c1))) (wbr cc0 (cfv (cv n) (cfv (cv z) F)) cle) $ >
  $ wi ph (wrex c (wceq (cfv (cv c) F) (cxp (co c1 N cfz) (csn cc0))) I) $;

--| Brouwer - or as Kulpa calls it, "Bohl-Brouwer" - fixed point theorem for the unit cube. Theorem on [Kulpa] p. 548. (Contributed by Brendan Leahy, 21-Aug-2020.)
theorem broucube {c: setvar} (ph: wff) (R F I N: class):
  $ wi ph (wcel N cn) $ >
  $ wceq I (co (co cc0 c1 cicc) (co c1 N cfz) cmap) $ >
  $ wceq R (cfv (cxp (co c1 N cfz) (csn (cfv (crn cioo) ctg))) cpt) $ >
  $ wi ph (wcel F (co (co R I crest) (co R I crest) ccn)) $ >
  $ wi ph (wrex c (wceq (cv c) (cfv (cv c) F)) I) $;

--| Heine-Cantor theorem: a continuous mapping between metric spaces whose domain is compact is uniformly continuous. Theorem on [Rosenlicht] p. 80. (Contributed by Brendan Leahy, 13-Aug-2018.) (Proof shortened by AV, 27-Sep-2020.)
theorem heicant (ph: wff) (C D X Y: class):
  $ wi ph (wcel C (cfv X cxmet)) $ >
  $ wi ph (wcel D (cfv Y cxmet)) $ >
  $ wi ph (wcel (cfv C cmopn) ccmp) $ >
  $ wi ph (wne X c0) $ >
  $ wi ph (wne Y c0) $ >
  $ wi ph (wceq (co (cfv C cmetu) (cfv D cmetu) cucn) (co (cfv C cmopn) (cfv D cmopn) ccn)) $;

--| Lemma for ~ ismblfin ; could also be used to shorten proof of ~ opnmbllem . (Contributed by Brendan Leahy, 13-Jul-2018.)
theorem opnmbllem0 {x3 y1 z: setvar} (A2: class):
  $ wi (wcel A2 (cfv (crn cioo) ctg)) (wceq (cuni (cima cicc (crab z (wss (cfv (cv z) cicc) A2) (crn (cmpo x3 y1 cz cn0 (cop (co (cv x3) (co c2 (cv y1) cexp) cdiv) (co (co (cv x3) c1 caddc) (co c2 (cv y1) cexp) cdiv))))))) A2) $;

--| Lemma for ~ ismblfin , ordering the sets of dyadic intervals that are antichains under subset and whose unions are contained entirely in ` A ` . (Contributed by Brendan Leahy, 13-Jul-2018.)
theorem mblfinlem1 {x3 y1 f2 a b c: setvar} (A2: class):
  $ wi (wa (wcel A2 (cfv (crn cioo) ctg)) (wne A2 c0)) (wex f2 (wf1o cn (crab a (wral c (wi (wss (cfv (cv a) cicc) (cfv (cv c) cicc)) (wceq (cv a) (cv c))) (crab b (wss (cfv (cv b) cicc) A2) (crn (cmpo x3 y1 cz cn0 (cop (co (cv x3) (co c2 (cv y1) cexp) cdiv) (co (co (cv x3) c1 caddc) (co c2 (cv y1) cexp) cdiv)))))) (crab b (wss (cfv (cv b) cicc) A2) (crn (cmpo x3 y1 cz cn0 (cop (co (cv x3) (co c2 (cv y1) cexp) cdiv) (co (co (cv x3) c1 caddc) (co c2 (cv y1) cexp) cdiv)))))) (cv f2))) $;

--| Lemma for ~ ismblfin , effectively one direction of the same fact for open sets, made necessary by Viaclovsky's slightly different definition of outer measure. Note that unlike the main theorem, this holds for sets of infinite measure. (Contributed by Brendan Leahy, 21-Feb-2018.) (Revised by Brendan Leahy, 13-Jul-2018.)
theorem mblfinlem2 {s1: setvar} (A2 M: class):
  $ wi (w3a (wcel A2 (cfv (crn cioo) ctg)) (wcel M cr) (wbr M (cfv A2 covol) clt)) (wrex s1 (wa (wss (cv s1) A2) (wbr M (cfv (cv s1) covol) clt)) (cfv (cfv (crn cioo) ctg) ccld)) $;

--| The difference between two sets measurable by the criterion in ~ ismblfin is itself measurable by the same. Corollary 0.3 of [Viaclovsky7] p. 3. (Contributed by Brendan Leahy, 25-Mar-2018.) (Revised by Brendan Leahy, 13-Jul-2018.)
theorem mblfinlem3 {y1 b: setvar} (A2 B2: class):
  $ wi (w3a (wa (wss A2 cr) (wcel (cfv A2 covol) cr)) (wa (wss B2 cr) (wcel (cfv B2 covol) cr)) (wa (wceq (cfv A2 covol) (csup (cab y1 (wrex b (wa (wss (cv b) A2) (wceq (cv y1) (cfv (cv b) cvol))) (cfv (cfv (crn cioo) ctg) ccld))) cr clt)) (wceq (cfv B2 covol) (csup (cab y1 (wrex b (wa (wss (cv b) B2) (wceq (cv y1) (cfv (cv b) cvol))) (cfv (cfv (crn cioo) ctg) ccld))) cr clt)))) (wceq (csup (cab y1 (wrex b (wa (wss (cv b) (cdif A2 B2)) (wceq (cv y1) (cfv (cv b) cvol))) (cfv (cfv (crn cioo) ctg) ccld))) cr clt) (cfv (cdif A2 B2) covol)) $;

--| Backward direction of ~ ismblfin . (Contributed by Brendan Leahy, 28-Mar-2018.) (Revised by Brendan Leahy, 13-Jul-2018.)
theorem mblfinlem4 {y1 b: setvar} (A2: class):
  $ wi (wa (wa (wss A2 cr) (wcel (cfv A2 covol) cr)) (wcel A2 (cdm cvol))) (wceq (cfv A2 covol) (csup (cab y1 (wrex b (wa (wss (cv b) A2) (wceq (cv y1) (cfv (cv b) cvol))) (cfv (cfv (crn cioo) ctg) ccld))) cr clt)) $;

--| Measurability in terms of inner and outer measure. Proposition 7 of [Viaclovsky8] p. 3. (Contributed by Brendan Leahy, 4-Mar-2018.) (Revised by Brendan Leahy, 28-Mar-2018.)
theorem ismblfin {y1 b: setvar} (A2: class):
  $ wi (wa (wss A2 cr) (wcel (cfv A2 covol) cr)) (wb (wcel A2 (cdm cvol)) (wceq (cfv A2 covol) (csup (cab y1 (wrex b (wa (wss (cv b) A2) (wceq (cv y1) (cfv (cv b) cvol))) (cfv (cfv (crn cioo) ctg) ccld))) cr clt))) $;

--| ~ ovoliun is incompatible with the Feferman-Levy model. (Contributed by Brendan Leahy, 21-Nov-2017.)
theorem ovoliunnfl {x3 f2 m n: setvar} (A2: class):
  $ wi (wa (wfn (cv f2) cn) (wral n (wa (wss (cfv (cv n) (cv f2)) cr) (wcel (cfv (cfv (cv n) (cv f2)) covol) cr)) cn)) (wbr (cfv (ciun m cn (cfv (cv m) (cv f2))) covol) (csup (crn (cseq caddc (cmpt m cn (cfv (cfv (cv m) (cv f2)) covol)) c1)) cxr clt) cle) $ >
  $ wi (wa (wbr A2 cn cdom) (wral x3 (wbr (cv x3) cn cdom) A2)) (wne (cuni A2) cr) $;

--| Demonstration of ~ ovoliunnfl . (Contributed by Brendan Leahy, 21-Nov-2017.)
theorem ex_ovoliunnfl {x3: setvar} (A2: class):
  $ wi (wa (wbr A2 cn cdom) (wral x3 (wbr (cv x3) cn cdom) A2)) (wne (cuni A2) cr) $;

--| ~ voliun is incompatible with the Feferman-Levy model; in that model, therefore, the Lebesgue measure as we've defined it isn't actually a measure. (Contributed by Brendan Leahy, 16-Dec-2017.)
theorem voliunnfl {x3 f2 n: setvar} (A2: class) (S G: class x3 f2 n):
  $ wceq S (cseq caddc G c1) $ >
  $ wceq G (cmpt n cn (cfv (cfv (cv n) (cv f2)) cvol)) $ >
  $ wi (wa (wral n (wa (wcel (cfv (cv n) (cv f2)) (cdm cvol)) (wcel (cfv (cfv (cv n) (cv f2)) cvol) cr)) cn) (wdisj n cn (cfv (cv n) (cv f2)))) (wceq (cfv (ciun n cn (cfv (cv n) (cv f2))) cvol) (csup (crn S) cxr clt)) $ >
  $ wi (wa (wbr A2 cn cdom) (wral x3 (wbr (cv x3) cn cdom) A2)) (wne (cuni A2) cr) $;

--| ~ volsup is incompatible with the Feferman-Levy model. (Contributed by Brendan Leahy, 2-Jan-2018.)
theorem volsupnfl {x3 f2 n: setvar} (A2: class):
  $ wi (wa (wf cn (cdm cvol) (cv f2)) (wral n (wss (cfv (cv n) (cv f2)) (cfv (co (cv n) c1 caddc) (cv f2))) cn)) (wceq (cfv (cuni (crn (cv f2))) cvol) (csup (cima cvol (crn (cv f2))) cxr clt)) $ >
  $ wi (wa (wbr A2 cn cdom) (wral x3 (wbr (cv x3) cn cdom) A2)) (wne (cuni A2) cr) $;

--| Measurability of a piecewise function across arbitrarily many subsets. (Contributed by Brendan Leahy, 31-Mar-2018.)
theorem mbfresfi {s1: setvar} (ph: wff) (A2 S F: class):
  $ wi ph (wf A2 cc F) $ >
  $ wi ph (wcel S cfn) $ >
  $ wi ph (wral s1 (wcel (cres F (cv s1)) cmbf) S) $ >
  $ wi ph (wceq (cuni S) A2) $ >
  $ wi ph (wcel F cmbf) $;

--| If the sum of two measurable functions is measurable, the sum of their nonnegative parts is measurable. (Contributed by Brendan Leahy, 2-Apr-2018.)
theorem mbfposadd {x3: setvar} (ph: wff) (A2: class) (B2 C: class x3):
  $ wi ph (wcel (cmpt x3 A2 B2) cmbf) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi ph (wcel (cmpt x3 A2 C) cmbf) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C cr) $ >
  $ wi ph (wcel (cmpt x3 A2 (co B2 C caddc)) cmbf) $ >
  $ wi ph (wcel (cmpt x3 A2 (co (cif (wbr cc0 B2 cle) B2 cc0) (cif (wbr cc0 C cle) C cc0) caddc)) cmbf) $;

--| A real-valued, a.e. continuous function is measurable. (Contributed by Brendan Leahy, 4-Apr-2018.)
theorem cnambfre (A2 F: class):
  $ wi (w3a (wf A2 cr F) (wcel A2 (cdm cvol)) (wceq (cfv (cdif A2 (cima (ccom (ccnv (co (co (cfv (crn cioo) ctg) A2 crest) (cfv (crn cioo) ctg) ccnp)) cep) (csn F))) covol) cc0)) (wcel F cmbf) $;

--| Lemma for ~ dvtan - the domain of the tangent is open. (Contributed by Brendan Leahy, 8-Aug-2018.) (Proof shortened by OpenAI, 3-Jul-2020.)
theorem dvtanlem:
  $ wcel (cima (ccnv ccos) (cdif cc (csn cc0))) (cfv ccnfld ctopn) $;

--| Derivative of tangent. (Contributed by Brendan Leahy, 7-Aug-2018.)
theorem dvtan {x3: setvar}:
  $ wceq (co cc ctan cdv) (cmpt x3 (cdm ctan) (co (cfv (cv x3) ccos) (cneg c2) cexp)) $;

--| An alternate expression for the ` S.2 ` integral that includes an arbitrarily small but strictly positive "buffer zone" wherever the simple function is nonzero. (Contributed by Brendan Leahy, 10-Oct-2017.) (Revised by Brendan Leahy, 10-Mar-2018.)
theorem itg2addnclem {x3 y1 z g2: setvar} (F: class) (L: class x3 y1 z g2):
  $ wceq L (cab x3 (wrex g2 (wa (wrex y1 (wbr (cmpt z cr (cif (wceq (cfv (cv z) (cv g2)) cc0) cc0 (co (cfv (cv z) (cv g2)) (cv y1) caddc))) F (cofr cle)) crp) (wceq (cv x3) (cfv (cv g2) citg1))) (cdm citg1))) $ >
  $ wi (wf cr (co cc0 cpnf cicc) F) (wceq (cfv F citg2) (csup L cxr clt)) $;

--| Lemma for ~ itg2addnc . The function described is a simple function. (Contributed by Brendan Leahy, 29-Oct-2017.)
theorem itg2addnclem2 {x3: setvar} (ph: wff) (v h: setvar) (F: class):
  $ wi ph (wcel F cmbf) $ >
  $ wi ph (wf cr (co cc0 cpnf cico) F) $ >
  $ wi (wa (wa ph (wcel (cv h) (cdm citg1))) (wcel (cv v) crp)) (wcel (cmpt x3 cr (cif (wa (wbr (co (co (cfv (co (cfv (cv x3) F) (co (cv v) c3 cdiv) cdiv) cfl) c1 cmin) (co (cv v) c3 cdiv) cmul) (cfv (cv x3) (cv h)) cle) (wne (cfv (cv x3) (cv h)) cc0)) (co (co (cfv (co (cfv (cv x3) F) (co (cv v) c3 cdiv) cdiv) cfl) c1 cmin) (co (cv v) c3 cdiv) cmul) (cfv (cv x3) (cv h)))) (cdm citg1)) $;

--| Lemma incomprehensible in isolation split off to shorten proof of ~ itg2addnc . (Contributed by Brendan Leahy, 11-Mar-2018.)
theorem itg2addnclem3 {y1 z u t f2 g2 h c d: setvar} (ph: wff) (F G: class) (s1: setvar):
  $ wi ph (wcel F cmbf) $ >
  $ wi ph (wf cr (co cc0 cpnf cico) F) $ >
  $ wi ph (wcel (cfv F citg2) cr) $ >
  $ wi ph (wf cr (co cc0 cpnf cico) G) $ >
  $ wi ph (wcel (cfv G citg2) cr) $ >
  $ wi ph (wi (wrex h (wa (wrex y1 (wbr (cmpt z cr (cif (wceq (cfv (cv z) (cv h)) cc0) cc0 (co (cfv (cv z) (cv h)) (cv y1) caddc))) (co F G (cof caddc)) (cofr cle)) crp) (wceq (cv s1) (cfv (cv h) citg1))) (cdm citg1)) (wex t (wex u (wa (wrex f2 (wrex g2 (wa (wa (wrex c (wbr (cmpt z cr (cif (wceq (cfv (cv z) (cv f2)) cc0) cc0 (co (cfv (cv z) (cv f2)) (cv c) caddc))) F (cofr cle)) crp) (wceq (cv t) (cfv (cv f2) citg1))) (wa (wrex d (wbr (cmpt z cr (cif (wceq (cfv (cv z) (cv g2)) cc0) cc0 (co (cfv (cv z) (cv g2)) (cv d) caddc))) G (cofr cle)) crp) (wceq (cv u) (cfv (cv g2) citg1)))) (cdm citg1)) (cdm citg1)) (wceq (cv s1) (co (cv t) (cv u) caddc)))))) $;

--| Alternate proof of ~ itg2add using the "buffer zone" definition from the first lemma, in which every simple function in the set is divided into to by dividing its buffer by a third and finding the largest allowable function locked to a grid laid out in increments of the new, smaller buffer up to the original simple function. The measurability of this function follows from that of the augend, and subtracting it from the original simple function yields another simple function by ~ i1fsub , which is allowable by the fact that the grid must have a mark between one third and two thirds the original buffer. This has two advantages over the current approach: first, eliminating ~ ax-cc , and second, weakening the measurability hypothesis to only the augend. (Contributed by Brendan Leahy, 31-Oct-2017.) (Revised by Brendan Leahy, 13-Mar-2018.)
theorem itg2addnc (ph: wff) (F G: class):
  $ wi ph (wcel F cmbf) $ >
  $ wi ph (wf cr (co cc0 cpnf cico) F) $ >
  $ wi ph (wcel (cfv F citg2) cr) $ >
  $ wi ph (wf cr (co cc0 cpnf cico) G) $ >
  $ wi ph (wcel (cfv G citg2) cr) $ >
  $ wi ph (wceq (cfv (co F G (cof caddc)) citg2) (co (cfv F citg2) (cfv G citg2) caddc)) $;

--| ~ itg2gt0 holds on functions continuous on an open interval in the absence of ~ ax-cc . The fourth hypothesis is made unnecessary by the continuity hypothesis. (Contributed by Brendan Leahy, 16-Nov-2017.)
theorem itg2gt0cn {x3: setvar} (ph: wff) (F X Y: class):
  $ wi ph (wbr X Y clt) $ >
  $ wi ph (wf cr (co cc0 cpnf cico) F) $ >
  $ wi (wa ph (wcel (cv x3) (co X Y cioo))) (wbr cc0 (cfv (cv x3) F) clt) $ >
  $ wi ph (wcel (cres F (co X Y cioo)) (co (co X Y cioo) cc ccncf)) $ >
  $ wi ph (wbr cc0 (cfv F citg2) clt) $;

--| Lemma for ~ ibladdnc ; cf ~ ibladdlem , whose fifth hypothesis is rendered unnecessary by the weakened hypotheses of ~ itg2addnc . (Contributed by Brendan Leahy, 31-Oct-2017.)
theorem ibladdnclem {x3: setvar} (ph: wff) (A2: class) (B2 C D: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C cr) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wceq D (co B2 C caddc)) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) cmbf) $ >
  $ wi ph (wcel (cfv (cmpt x3 cr (cif (wa (wcel (cv x3) A2) (wbr cc0 B2 cle)) B2 cc0)) citg2) cr) $ >
  $ wi ph (wcel (cfv (cmpt x3 cr (cif (wa (wcel (cv x3) A2) (wbr cc0 C cle)) C cc0)) citg2) cr) $ >
  $ wi ph (wcel (cfv (cmpt x3 cr (cif (wa (wcel (cv x3) A2) (wbr cc0 D cle)) D cc0)) citg2) cr) $;

--| Choice-free analogue of ~ itgadd . A measurability hypothesis is necessitated by the loss of ~ mbfadd ; for large classes of functions, such as continuous functions, it should be relatively easy to show. (Contributed by Brendan Leahy, 1-Nov-2017.)
theorem ibladdnc {x3: setvar} (ph: wff) (A2: class) (B2 C: class x3) (V: class):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) cibl) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C V) $ >
  $ wi ph (wcel (cmpt x3 A2 C) cibl) $ >
  $ wi ph (wcel (cmpt x3 A2 (co B2 C caddc)) cmbf) $ >
  $ wi ph (wcel (cmpt x3 A2 (co B2 C caddc)) cibl) $;

--| Lemma for ~ itgaddnc ; cf. ~ itgaddlem1 . (Contributed by Brendan Leahy, 7-Nov-2017.)
theorem itgaddnclem1 {x3: setvar} (ph: wff) (A2: class) (B2 C: class x3) (V: class):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) cibl) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C V) $ >
  $ wi ph (wcel (cmpt x3 A2 C) cibl) $ >
  $ wi ph (wcel (cmpt x3 A2 (co B2 C caddc)) cmbf) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C cr) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wbr cc0 B2 cle) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wbr cc0 C cle) $ >
  $ wi ph (wceq (citg x3 A2 (co B2 C caddc)) (co (citg x3 A2 B2) (citg x3 A2 C) caddc)) $;

--| Lemma for ~ itgaddnc ; cf. ~ itgaddlem2 . (Contributed by Brendan Leahy, 10-Nov-2017.) (Revised by Brendan Leahy, 3-Apr-2018.)
theorem itgaddnclem2 {x3: setvar} (ph: wff) (A2: class) (B2 C: class x3) (V: class):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) cibl) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C V) $ >
  $ wi ph (wcel (cmpt x3 A2 C) cibl) $ >
  $ wi ph (wcel (cmpt x3 A2 (co B2 C caddc)) cmbf) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C cr) $ >
  $ wi ph (wceq (citg x3 A2 (co B2 C caddc)) (co (citg x3 A2 B2) (citg x3 A2 C) caddc)) $;

--| Choice-free analogue of ~ itgadd . (Contributed by Brendan Leahy, 11-Nov-2017.)
theorem itgaddnc {x3: setvar} (ph: wff) (A2: class) (B2 C: class x3) (V: class):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) cibl) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C V) $ >
  $ wi ph (wcel (cmpt x3 A2 C) cibl) $ >
  $ wi ph (wcel (cmpt x3 A2 (co B2 C caddc)) cmbf) $ >
  $ wi ph (wceq (citg x3 A2 (co B2 C caddc)) (co (citg x3 A2 B2) (citg x3 A2 C) caddc)) $;

--| Choice-free analogue of ~ iblsub . (Contributed by Brendan Leahy, 11-Nov-2017.)
theorem iblsubnc {x3: setvar} (ph: wff) (A2: class) (B2 C: class x3) (V: class):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) cibl) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C V) $ >
  $ wi ph (wcel (cmpt x3 A2 C) cibl) $ >
  $ wi ph (wcel (cmpt x3 A2 (co B2 C cmin)) cmbf) $ >
  $ wi ph (wcel (cmpt x3 A2 (co B2 C cmin)) cibl) $;

--| Choice-free analogue of ~ itgsub . (Contributed by Brendan Leahy, 11-Nov-2017.)
theorem itgsubnc {x3: setvar} (ph: wff) (A2: class) (B2 C: class x3) (V: class):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) cibl) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C V) $ >
  $ wi ph (wcel (cmpt x3 A2 C) cibl) $ >
  $ wi ph (wcel (cmpt x3 A2 (co B2 C cmin)) cmbf) $ >
  $ wi ph (wceq (citg x3 A2 (co B2 C cmin)) (co (citg x3 A2 B2) (citg x3 A2 C) cmin)) $;

--| Lemma for ~ iblabsnc ; cf. ~ iblabslem . (Contributed by Brendan Leahy, 7-Nov-2017.)
theorem iblabsnclem {x3: setvar} (ph: wff) (A2: class) (B2 F G V: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) cibl) $ >
  $ wceq G (cmpt x3 cr (cif (wcel (cv x3) A2) (cfv (cfv B2 F) cabs) cc0)) $ >
  $ wi ph (wcel (cmpt x3 A2 (cfv B2 F)) cibl) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel (cfv B2 F) cr) $ >
  $ wi ph (wa (wcel G cmbf) (wcel (cfv G citg2) cr)) $;

--| Choice-free analogue of ~ iblabs . As with ~ ibladdnc , a measurability hypothesis is needed. (Contributed by Brendan Leahy, 7-Nov-2017.)
theorem iblabsnc {x3: setvar} (ph: wff) (A2: class) (B2 V: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) cibl) $ >
  $ wi ph (wcel (cmpt x3 A2 (cfv B2 cabs)) cmbf) $ >
  $ wi ph (wcel (cmpt x3 A2 (cfv B2 cabs)) cibl) $;

--| Choice-free analogue of ~ iblmulc2 . (Contributed by Brendan Leahy, 17-Nov-2017.)
theorem iblmulc2nc {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (C V: class):
  $ wi ph (wcel C cc) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) cibl) $ >
  $ wi ph (wcel (cmpt x3 A2 (co C B2 cmul)) cmbf) $ >
  $ wi ph (wcel (cmpt x3 A2 (co C B2 cmul)) cibl) $;

--| Lemma for ~ itgmulc2nc ; cf. ~ itgmulc2lem1 . (Contributed by Brendan Leahy, 17-Nov-2017.)
theorem itgmulc2nclem1 {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (C V: class):
  $ wi ph (wcel C cc) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) cibl) $ >
  $ wi ph (wcel (cmpt x3 A2 (co C B2 cmul)) cmbf) $ >
  $ wi ph (wcel C cr) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi ph (wbr cc0 C cle) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wbr cc0 B2 cle) $ >
  $ wi ph (wceq (co C (citg x3 A2 B2) cmul) (citg x3 A2 (co C B2 cmul))) $;

--| Lemma for ~ itgmulc2nc ; cf. ~ itgmulc2lem2 . (Contributed by Brendan Leahy, 19-Nov-2017.)
theorem itgmulc2nclem2 {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (C V: class):
  $ wi ph (wcel C cc) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) cibl) $ >
  $ wi ph (wcel (cmpt x3 A2 (co C B2 cmul)) cmbf) $ >
  $ wi ph (wcel C cr) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi ph (wceq (co C (citg x3 A2 B2) cmul) (citg x3 A2 (co C B2 cmul))) $;

--| Choice-free analogue of ~ itgmulc2 . (Contributed by Brendan Leahy, 19-Nov-2017.)
theorem itgmulc2nc {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (C V: class):
  $ wi ph (wcel C cc) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) cibl) $ >
  $ wi ph (wcel (cmpt x3 A2 (co C B2 cmul)) cmbf) $ >
  $ wi ph (wceq (co C (citg x3 A2 B2) cmul) (citg x3 A2 (co C B2 cmul))) $;

--| Choice-free analogue of ~ itgabs . (Contributed by Brendan Leahy, 19-Nov-2017.) (Revised by Brendan Leahy, 19-Jun-2018.)
theorem itgabsnc {x3 y1: setvar} (ph: wff) (A2: class) (B2: class x3) (V: class):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) cibl) $ >
  $ wi ph (wcel (cmpt x3 A2 (cfv B2 cabs)) cmbf) $ >
  $ wi ph (wcel (cmpt y1 A2 (co (cfv (citg x3 A2 B2) ccj) (csb x3 (cv y1) B2) cmul)) cmbf) $ >
  $ wi ph (wbr (cfv (citg x3 A2 B2) cabs) (citg x3 A2 (cfv B2 cabs)) cle) $;

--| ~ itggt0 holds for continuous functions in the absence of ~ ax-cc . (Contributed by Brendan Leahy, 16-Nov-2017.)
theorem itggt0cn {x3: setvar} (ph: wff) (B2: class x3) (X Y: class):
  $ wi ph (wbr X Y clt) $ >
  $ wi ph (wcel (cmpt x3 (co X Y cioo) B2) cibl) $ >
  $ wi (wa ph (wcel (cv x3) (co X Y cioo))) (wcel B2 crp) $ >
  $ wi ph (wcel (cmpt x3 (co X Y cioo) B2) (co (co X Y cioo) cc ccncf)) $ >
  $ wi ph (wbr cc0 (citg x3 (co X Y cioo) B2) clt) $;

--| Lemma for ~ ftc1cnnc ; cf. ~ ftc1lem4 . The stronger assumptions of ~ ftc1cn are exploited to make use of weaker theorems. (Contributed by Brendan Leahy, 19-Nov-2017.)
theorem ftc1cnnclem {x3 y1 z t c: setvar} (ph: wff c) (A2 B2: class c) (R: class x3 z t c) (E: class x3 z c) (F: class c) (G: class x3 t c) (H: class x3 z t c) (X: class y1 c) (Y: class y1 z c):
  $ wceq G (cmpt x3 (co A2 B2 cicc) (citg t (co A2 (cv x3) cioo) (cfv (cv t) F))) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wi ph (wcel F (co (co A2 B2 cioo) cc ccncf)) $ >
  $ wi ph (wcel F cibl) $ >
  $ wi ph (wcel (cv c) (co A2 B2 cioo)) $ >
  $ wceq H (cmpt z (cdif (co A2 B2 cicc) (csn (cv c))) (co (co (cfv (cv z) G) (cfv (cv c) G) cmin) (co (cv z) (cv c) cmin) cdiv)) $ >
  $ wi ph (wcel E crp) $ >
  $ wi ph (wcel R crp) $ >
  $ wi (wa ph (wcel (cv y1) (co A2 B2 cioo))) (wi (wbr (cfv (co (cv y1) (cv c) cmin) cabs) R clt) (wbr (cfv (co (cfv (cv y1) F) (cfv (cv c) F) cmin) cabs) E clt)) $ >
  $ wi ph (wcel X (co A2 B2 cicc)) $ >
  $ wi ph (wbr (cfv (co X (cv c) cmin) cabs) R clt) $ >
  $ wi ph (wcel Y (co A2 B2 cicc)) $ >
  $ wi ph (wbr (cfv (co Y (cv c) cmin) cabs) R clt) $ >
  $ wi (wa ph (wbr X Y clt)) (wbr (cfv (co (co (co (cfv Y G) (cfv X G) cmin) (co Y X cmin) cdiv) (cfv (cv c) F) cmin) cabs) E clt) $;

--| Choice-free proof of ~ ftc1cn . (Contributed by Brendan Leahy, 20-Nov-2017.)
theorem ftc1cnnc {x3 t: setvar} (ph: wff) (A2 B2 F: class) (G: class x3 t):
  $ wceq G (cmpt x3 (co A2 B2 cicc) (citg t (co A2 (cv x3) cioo) (cfv (cv t) F))) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wi ph (wcel F (co (co A2 B2 cioo) cc ccncf)) $ >
  $ wi ph (wcel F cibl) $ >
  $ wi ph (wceq (co cr G cdv) F) $;

--| Lemma for ~ ftc1anc - the absolute value of a real-valued measurable function is measurable. Would be trivial with ~ cncombf , but this proof avoids ~ ax-cc . (Contributed by Brendan Leahy, 18-Jun-2018.)
theorem ftc1anclem1 (A2 F: class):
  $ wi (wa (wf A2 cr F) (wcel F cmbf)) (wcel (ccom cabs F) cmbf) $;

--| Lemma for ~ ftc1anc - restriction of an integrable function to the absolute value of its real or imaginary part. (Contributed by Brendan Leahy, 19-Jun-2018.) (Revised by Brendan Leahy, 8-Aug-2018.)
theorem ftc1anclem2 {t: setvar} (A2 F G: class):
  $ wi (w3a (wf A2 cc F) (wcel F cibl) (wcel G (cpr cre cim))) (wcel (cfv (cmpt t cr (cif (wcel (cv t) A2) (cfv (cfv (cfv (cv t) F) G) cabs) cc0)) citg2) cr) $;

--| Lemma for ~ ftc1anc - the absolute value of the sum of a simple function and ` _i ` times another simple function is itself a simple function. (Contributed by Brendan Leahy, 27-May-2018.)
theorem ftc1anclem3 (F G: class):
  $ wi (wa (wcel F (cdm citg1)) (wcel G (cdm citg1))) (wcel (ccom cabs (co F (co (cxp cr (csn ci)) G (cof cmul)) (cof caddc))) (cdm citg1)) $;

--| Lemma for ~ ftc1anc . (Contributed by Brendan Leahy, 17-Jun-2018.)
theorem ftc1anclem4 {t: setvar} (F G: class):
  $ wi (w3a (wcel F (cdm citg1)) (wcel G cibl) (wf cr cr G)) (wcel (cfv (cmpt t cr (cfv (co (cfv (cv t) G) (cfv (cv t) F) cmin) cabs)) citg2) cr) $;

--| Lemma for ~ ftc1anc , the existence of a simple function the integral of whose pointwise difference from the function is less than a given positive real. (Contributed by Brendan Leahy, 17-Jun-2018.)
theorem ftc1anclem5 {x3 t f2: setvar} (ph: wff) (A2 B2 D F: class) (G: class x3 t) (Y: class):
  $ wceq G (cmpt x3 (co A2 B2 cicc) (citg t (co A2 (cv x3) cioo) (cfv (cv t) F))) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wi ph (wss (co A2 B2 cioo) D) $ >
  $ wi ph (wss D cr) $ >
  $ wi ph (wcel F cibl) $ >
  $ wi ph (wf D cc F) $ >
  $ wi (wa ph (wcel Y crp)) (wrex f2 (wbr (cfv (cmpt t cr (cfv (co (cfv (cif (wcel (cv t) D) (cfv (cv t) F) cc0) cre) (cfv (cv t) (cv f2)) cmin) cabs)) citg2) Y clt) (cdm citg1)) $;

--| Lemma for ~ ftc1anc - construction of simple functions within an arbitrary absolute distance of the given function. Similar to Lemma 565Ib of [Fremlin5] p. 218, but without Fremlin's additional step of converting the simple function into a continuous one, which is unnecessary to this lemma's use; also, two simple functions are used to allow for complex-valued ` F ` . (Contributed by Brendan Leahy, 31-May-2018.)
theorem ftc1anclem6 {x3 t f2 g2: setvar} (ph: wff) (A2 B2 D F: class) (G: class x3 t) (Y: class):
  $ wceq G (cmpt x3 (co A2 B2 cicc) (citg t (co A2 (cv x3) cioo) (cfv (cv t) F))) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wi ph (wss (co A2 B2 cioo) D) $ >
  $ wi ph (wss D cr) $ >
  $ wi ph (wcel F cibl) $ >
  $ wi ph (wf D cc F) $ >
  $ wi (wa ph (wcel Y crp)) (wrex f2 (wrex g2 (wbr (cfv (cmpt t cr (cfv (co (cif (wcel (cv t) D) (cfv (cv t) F) cc0) (co (cfv (cv t) (cv f2)) (co ci (cfv (cv t) (cv g2)) cmul) caddc) cmin) cabs)) citg2) Y clt) (cdm citg1)) (cdm citg1)) $;

--| Lemma for ~ ftc1anc . (Contributed by Brendan Leahy, 13-May-2018.)
theorem ftc1anclem7 {x3 y1 t r: setvar} (ph: wff) (w u: setvar) (A2 B2 D: class) (f2 g2: setvar) (F: class) (G: class x3 t):
  $ wceq G (cmpt x3 (co A2 B2 cicc) (citg t (co A2 (cv x3) cioo) (cfv (cv t) F))) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wi ph (wss (co A2 B2 cioo) D) $ >
  $ wi ph (wss D cr) $ >
  $ wi ph (wcel F cibl) $ >
  $ wi ph (wf D cc F) $ >
  $ wi (wa (wa (wa (wa (wa (wa ph (wa (wcel (cv f2) (cdm citg1)) (wcel (cv g2) (cdm citg1)))) (wbr (cfv (cmpt t cr (cfv (co (cif (wcel (cv t) D) (cfv (cv t) F) cc0) (co (cfv (cv t) (cv f2)) (co ci (cfv (cv t) (cv g2)) cmul) caddc) cmin) cabs)) citg2) (co (cv y1) c2 cdiv) clt)) (wrex r (wne (cv r) cc0) (cun (crn (cv f2)) (crn (cv g2))))) (wcel (cv y1) crp)) (w3a (wcel (cv u) (co A2 B2 cicc)) (wcel (cv w) (co A2 B2 cicc)) (wbr (cv u) (cv w) cle))) (wbr (cfv (co (cv w) (cv u) cmin) cabs) (co (co (cv y1) c2 cdiv) (co c2 (csup (cima cabs (cun (crn (cv f2)) (crn (cv g2)))) cr clt) cmul) cdiv) clt)) (wbr (co (cfv (cmpt t cr (cif (wcel (cv t) (co (cv u) (cv w) cioo)) (cfv (co (cfv (cv t) (cv f2)) (co ci (cfv (cv t) (cv g2)) cmul) caddc) cabs) cc0)) citg2) (cfv (cmpt t cr (cif (wcel (cv t) (co (cv u) (cv w) cioo)) (cfv (co (cfv (cv t) F) (co (cfv (cv t) (cv f2)) (co ci (cfv (cv t) (cv g2)) cmul) caddc) cmin) cabs) cc0)) citg2) caddc) (co (co (cv y1) c2 cdiv) (co (cv y1) c2 cdiv) caddc) clt) $;

--| Lemma for ~ ftc1anc . (Contributed by Brendan Leahy, 29-May-2018.)
theorem ftc1anclem8 {x3 y1 t f2 r: setvar} (ph: wff) (w u: setvar) (A2 B2 D: class) (g2: setvar) (F: class) (G: class x3 t):
  $ wceq G (cmpt x3 (co A2 B2 cicc) (citg t (co A2 (cv x3) cioo) (cfv (cv t) F))) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wi ph (wss (co A2 B2 cioo) D) $ >
  $ wi ph (wss D cr) $ >
  $ wi ph (wcel F cibl) $ >
  $ wi ph (wf D cc F) $ >
  $ wi (wa (wa (wa (wa (wa (wa ph (wa (wcel (cv f2) (cdm citg1)) (wcel (cv g2) (cdm citg1)))) (wbr (cfv (cmpt t cr (cfv (co (cif (wcel (cv t) D) (cfv (cv t) F) cc0) (co (cfv (cv t) (cv f2)) (co ci (cfv (cv t) (cv g2)) cmul) caddc) cmin) cabs)) citg2) (co (cv y1) c2 cdiv) clt)) (wrex r (wne (cv r) cc0) (cun (crn (cv f2)) (crn (cv g2))))) (wcel (cv y1) crp)) (w3a (wcel (cv u) (co A2 B2 cicc)) (wcel (cv w) (co A2 B2 cicc)) (wbr (cv u) (cv w) cle))) (wbr (cfv (co (cv w) (cv u) cmin) cabs) (co (co (cv y1) c2 cdiv) (co c2 (csup (cima cabs (cun (crn (cv f2)) (crn (cv g2)))) cr clt) cmul) cdiv) clt)) (wbr (cfv (cmpt t cr (cif (wcel (cv t) (co (cv u) (cv w) cioo)) (co (cfv (co (cfv (cv t) F) (co (cfv (cv t) (cv f2)) (co ci (cfv (cv t) (cv g2)) cmul) caddc) cmin) cabs) (cfv (co (cfv (cv t) (cv f2)) (co ci (cfv (cv t) (cv g2)) cmul) caddc) cabs) caddc) cc0)) citg2) (cv y1) clt) $;

--| ~ ftc1a holds for functions that obey the triangle inequality in the absence of ~ ax-cc . Theorem 565Ma of [Fremlin5] p. 220. (Contributed by Brendan Leahy, 11-May-2018.)
theorem ftc1anc {x3 t s1: setvar} (ph: wff) (A2 B2 D F: class) (G: class x3 t):
  $ wceq G (cmpt x3 (co A2 B2 cicc) (citg t (co A2 (cv x3) cioo) (cfv (cv t) F))) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wi ph (wss (co A2 B2 cioo) D) $ >
  $ wi ph (wss D cr) $ >
  $ wi ph (wcel F cibl) $ >
  $ wi ph (wf D cc F) $ >
  $ wi ph (wral s1 (wbr (cfv (citg t (cv s1) (cfv (cv t) F)) cabs) (cfv (cmpt t cr (cif (wcel (cv t) (cv s1)) (cfv (cfv (cv t) F) cabs) cc0)) citg2) cle) (cima cioo (cxp (co A2 B2 cicc) (co A2 B2 cicc)))) $ >
  $ wi ph (wcel G (co (co A2 B2 cicc) cc ccncf)) $;

--| Choice-free proof of ~ ftc2 . (Contributed by Brendan Leahy, 19-Jun-2018.)
theorem ftc2nc {t: setvar} (ph: wff) (A2 B2 F: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wi ph (wcel (co cr F cdv) (co (co A2 B2 cioo) cc ccncf)) $ >
  $ wi ph (wcel (co cr F cdv) cibl) $ >
  $ wi ph (wcel F (co (co A2 B2 cicc) cc ccncf)) $ >
  $ wi ph (wceq (citg t (co A2 B2 cioo) (cfv (cv t) (co cr F cdv))) (co (cfv B2 F) (cfv A2 F) cmin)) $;

--| Real part of domain of differentiability of arcsine. (Contributed by Brendan Leahy, 19-Dec-2018.)
theorem asindmre (D: class):
  $ wceq D (cdif cc (cun (co cmnf (cneg c1) cioc) (co c1 cpnf cico))) $ >
  $ wceq (cin D cr) (co (cneg c1) c1 cioo) $;

--| Derivative of arcsine. (Contributed by Brendan Leahy, 18-Dec-2018.)
theorem dvasin {x3: setvar} (D: class):
  $ wceq D (cdif cc (cun (co cmnf (cneg c1) cioc) (co c1 cpnf cico))) $ >
  $ wceq (co cc (cres casin D) cdv) (cmpt x3 D (co c1 (cfv (co c1 (co (cv x3) c2 cexp) cmin) csqrt) cdiv)) $;

--| Derivative of arccosine. (Contributed by Brendan Leahy, 18-Dec-2018.)
theorem dvacos {x3: setvar} (D: class):
  $ wceq D (cdif cc (cun (co cmnf (cneg c1) cioc) (co c1 cpnf cico))) $ >
  $ wceq (co cc (cres cacos D) cdv) (cmpt x3 D (co (cneg c1) (cfv (co c1 (co (cv x3) c2 cexp) cmin) csqrt) cdiv)) $;

--| Real derivative of arcsine. (Contributed by Brendan Leahy, 3-Aug-2017.) (Proof shortened by Brendan Leahy, 18-Dec-2018.)
theorem dvreasin {x3: setvar}:
  $ wceq (co cr (cres casin (co (cneg c1) c1 cioo)) cdv) (cmpt x3 (co (cneg c1) c1 cioo) (co c1 (cfv (co c1 (co (cv x3) c2 cexp) cmin) csqrt) cdiv)) $;

--| Real derivative of arccosine. (Contributed by Brendan Leahy, 3-Aug-2017.) (Proof shortened by Brendan Leahy, 18-Dec-2018.)
theorem dvreacos {x3: setvar}:
  $ wceq (co cr (cres cacos (co (cneg c1) c1 cioo)) cdv) (cmpt x3 (co (cneg c1) c1 cioo) (co (cneg c1) (cfv (co c1 (co (cv x3) c2 cexp) cmin) csqrt) cdiv)) $;

--| Antiderivative of cross-section of circle. (Contributed by Brendan Leahy, 28-Aug-2017.) (Revised by Brendan Leahy, 11-Jul-2018.)
theorem areacirclem1 {t: setvar} (R: class):
  $ wi (wcel R crp) (wceq (co cr (cmpt t (co (cneg R) R cioo) (co (co R c2 cexp) (co (cfv (co (cv t) R cdiv) casin) (co (co (cv t) R cdiv) (cfv (co c1 (co (co (cv t) R cdiv) c2 cexp) cmin) csqrt) cmul) caddc) cmul)) cdv) (cmpt t (co (cneg R) R cioo) (co c2 (cfv (co (co R c2 cexp) (co (cv t) c2 cexp) cmin) csqrt) cmul))) $;

--| Endpoint-inclusive continuity of Cartesian ordinate of circle. (Contributed by Brendan Leahy, 29-Aug-2017.) (Revised by Brendan Leahy, 11-Jul-2018.)
theorem areacirclem2 {t: setvar} (R: class):
  $ wi (wa (wcel R cr) (wbr cc0 R cle)) (wcel (cmpt t (co (cneg R) R cicc) (cfv (co (co R c2 cexp) (co (cv t) c2 cexp) cmin) csqrt)) (co (co (cneg R) R cicc) cc ccncf)) $;

--| Integrability of cross-section of circle. (Contributed by Brendan Leahy, 26-Aug-2017.) (Revised by Brendan Leahy, 11-Jul-2018.)
theorem areacirclem3 {t: setvar} (R: class):
  $ wi (wa (wcel R cr) (wbr cc0 R cle)) (wcel (cmpt t (co (cneg R) R cicc) (co c2 (cfv (co (co R c2 cexp) (co (cv t) c2 cexp) cmin) csqrt) cmul)) cibl) $;

--| Endpoint-inclusive continuity of antiderivative of cross-section of circle. (Contributed by Brendan Leahy, 31-Aug-2017.) (Revised by Brendan Leahy, 11-Jul-2018.)
theorem areacirclem4 {t: setvar} (R: class):
  $ wi (wcel R crp) (wcel (cmpt t (co (cneg R) R cicc) (co (co R c2 cexp) (co (cfv (co (cv t) R cdiv) casin) (co (co (cv t) R cdiv) (cfv (co c1 (co (co (cv t) R cdiv) c2 cexp) cmin) csqrt) cmul) caddc) cmul)) (co (co (cneg R) R cicc) cc ccncf)) $;

--| Finding the cross-section of a circle. (Contributed by Brendan Leahy, 31-Aug-2017.) (Revised by Brendan Leahy, 22-Sep-2017.) (Revised by Brendan Leahy, 11-Jul-2018.)
theorem areacirclem5 {x3 y1 t: setvar} (R: class) (S: class x3 y1):
  $ wceq S (copab x3 y1 (wa (wa (wcel (cv x3) cr) (wcel (cv y1) cr)) (wbr (co (co (cv x3) c2 cexp) (co (cv y1) c2 cexp) caddc) (co R c2 cexp) cle))) $ >
  $ wi (w3a (wcel R cr) (wbr cc0 R cle) (wcel (cv t) cr)) (wceq (cima S (csn (cv t))) (cif (wbr (cfv (cv t) cabs) R cle) (co (cneg (cfv (co (co R c2 cexp) (co (cv t) c2 cexp) cmin) csqrt)) (cfv (co (co R c2 cexp) (co (cv t) c2 cexp) cmin) csqrt) cicc) c0)) $;

--| The area of a circle of radius ` R ` is ` _pi x. R ^ 2 ` . This is Metamath 100 proof #9. (Contributed by Brendan Leahy, 31-Aug-2017.) (Revised by Brendan Leahy, 22-Sep-2017.) (Revised by Brendan Leahy, 11-Jul-2018.)
theorem areacirc {x3 y1: setvar} (R: class) (S: class x3 y1):
  $ wceq S (copab x3 y1 (wa (wa (wcel (cv x3) cr) (wcel (cv y1) cr)) (wbr (co (co (cv x3) c2 cexp) (co (cv y1) c2 cexp) caddc) (co R c2 cexp) cle))) $ >
  $ wi (wa (wcel R cr) (wbr cc0 R cle)) (wceq (cfv S carea) (co cpi (co R c2 cexp) cmul)) $;

--| Schema for strong induction on the cardinality of a finite set. The inductive hypothesis is that the result is true on any set with less elements. The result is then proven to be true for all finite sets. (Contributed by Thomas van Maaren, 14-Aug-2026.)
theorem findcard4 {x3 y1: setvar} (ph: wff x3) (ch ta: wff y1) (A2: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ch) $ >
  $ wi (wceq (cv x3) A2) (wb ph ta) $ >
  $ wi (wcel (cv y1) cfn) (wi (wal x3 (wi (wbr (cfv (cv x3) chash) (cfv (cv y1) chash) clt) ph)) ch) $ >
  $ wi (wcel A2 cfn) ta $;

--| A variable in a sentence of propositional calculus.
term cpropvar: class;

--| The negation of a sentence of propositional calculus.
term cpropneg: class;

--| The implication between two sentences of propositional calculus.
term cpropimp: class;

--| Variables in sentences of propositional calculus are encoded by appending a zero after the number of the variable. (Contributed by Thomas van Maaren, 21-Aug-2026.)
axiom df_propvar {n: setvar}:
  $ wceq cpropvar (cmpt n cn (co (cs1 (cv n)) (cs1 cc0) cconcat)) $;

--| The negation of a sentence of propositional calculus is encoded by appending a one after the sentence. (Contributed by Thomas van Maaren, 21-Aug-2026.)
axiom df_propneg {x3: setvar}:
  $ wceq cpropneg (cmpt x3 cvv (co (cv x3) (cs1 c1) cconcat)) $;

--| The implication between two sentences of propositional calculus is encoded by concatenating the two sentences and appending a two at the end. (Contributed by Thomas van Maaren, 21-Aug-2026.)
axiom df_propimp {x3 y1: setvar}:
  $ wceq cpropimp (cmpo x3 y1 cvv cvv (co (co (cv x3) (cv y1) cconcat) (cs1 c2) cconcat)) $;

--| The language of Propositional Calculus.
term cprop: class;

--| Define the language of propositional calculus. This definition is noncircular. For a more usable and intuitive, but circular, definition see ~ dfprop . (Contributed by Thomas van Maaren, 21-Aug-2026.)
axiom df_prop {x3 y1 z w n: setvar}:
  $ wceq cprop (csetrecs (cmpt y1 cvv (cab x3 (wo (wrex z (wo (wceq (cv x3) (cfv (cv z) cpropneg)) (wrex w (wceq (cv x3) (co (cv w) (cv z) cpropimp)) (cv y1))) (cv y1)) (wrex n (wceq (cv x3) (cfv (cv n) cpropvar)) cn))))) $;

--| Given a set A, the set of all variables encoded as natural numbers, negations of elements in A, and implications between elements of A forms a set. This lemma is used when using ~ fvmptd on the defining function of ` PROP ` . (Contributed by Thomas van Maaren, 21-Aug-2026.)
theorem dfproplem {x3 z w n: setvar} (A2: class n):
  $ wcel A2 cvv $ >
  $ wcel (cab x3 (wo (wrex z (wo (wceq (cv x3) (cfv (cv z) cpropneg)) (wrex w (wceq (cv x3) (co (cv w) (cv z) cpropimp)) A2)) A2) (wrex n (wceq (cv x3) (cfv (cv n) cpropvar)) cn))) cvv $;

--| Variables encoded as natural numbers are sentences of propositional calculus. (Contributed by Thomas van Maaren, 21-Aug-2026.)
theorem varprop {n: setvar}:
  $ wi (wcel (cv n) cn) (wcel (cfv (cv n) cpropvar) cprop) $;

--| The negation of a sentence of propositional calculus is a sentence of propositional calculus. (Contributed by Thomas van Maaren, 21-Aug-2026.)
theorem negprop {x3: setvar}:
  $ wi (wcel (cv x3) cprop) (wcel (cfv (cv x3) cpropneg) cprop) $;

--| The implication between two sentences of propositional calculus is a sentence of propositional calculus. (Contributed by Thomas van Maaren, 21-Aug-2026.)
theorem impprop {x3 y1: setvar}:
  $ wi (wa (wcel (cv x3) cprop) (wcel (cv y1) cprop)) (wcel (co (cv x3) (cv y1) cpropimp) cprop) $;

--| The set of variables encoded as a natural number, negations of sentences of propositional calculus, and implications between sentences of propositional calculus is a subset of ` PROP ` . (Contributed by Thomas van Maaren, 21-Aug-2026.)
theorem dfprop1 {x3 z w n: setvar}:
  $ wss (cab x3 (wo (wrex z (wo (wceq (cv x3) (cfv (cv z) cpropneg)) (wrex w (wceq (cv x3) (co (cv w) (cv z) cpropimp)) cprop)) cprop) (wrex n (wceq (cv x3) (cfv (cv n) cpropvar)) cn))) cprop $;

--| Every sentence of propositional calculus is either a variable encoded as a natural number, a negation of a sentence of propositional calculus, or an implication between two sentences of propositional calculus. (Contributed by Thomas van Maaren, 21-Aug-2026.)
theorem dfprop2 {x3 z w n: setvar}:
  $ wss cprop (cab x3 (wo (wrex z (wo (wceq (cv x3) (cfv (cv z) cpropneg)) (wrex w (wceq (cv x3) (co (cv w) (cv z) cpropimp)) cprop)) cprop) (wrex n (wceq (cv x3) (cfv (cv n) cpropvar)) cn))) $;

--| The set of sentences of propositional calculus is equal to the set of sentences that are either a variable encoded as a natural number, a negation of a sentence propositional calculus, or an implication between two sentences of propositional calculus. (Contributed by Thomas van Maaren, 21-Aug-2026.)
theorem dfprop {x3 z w n: setvar}:
  $ wceq cprop (cab x3 (wo (wrex z (wo (wceq (cv x3) (cfv (cv z) cpropneg)) (wrex w (wceq (cv x3) (co (cv w) (cv z) cpropimp)) cprop)) cprop) (wrex n (wceq (cv x3) (cfv (cv n) cpropvar)) cn))) $;

--| Define a quantity whose definition involves a choice of representative, but which is uniquely determined regardless of the choice. (Contributed by Jeff Madsen, 1-Jun-2011.)
theorem unirep {x3 y1 z: setvar} (ph: wff y1) (ps ch: wff z) (A2: class) (B2: class y1) (C D F: class z):
  $ wi (wceq (cv y1) D) (wb ph ps) $ >
  $ wi (wceq (cv y1) D) (wceq B2 C) $ >
  $ wi (wceq (cv y1) (cv z)) (wb ph ch) $ >
  $ wi (wceq (cv y1) (cv z)) (wceq B2 F) $ >
  $ wcel B2 cvv $ >
  $ wi (wa (wral y1 (wral z (wi (wa ph ch) (wceq B2 F)) A2) A2) (wa (wcel D A2) ps)) (wceq (cio x3 (wrex y1 (wa ph (wceq (cv x3) B2)) A2)) C) $;

--| Two ways of expressing the statement "there is a cover of ` A ` by elements of ` B ` such that for each set in the cover, ` ph ` ". Note that ` ph ` and ` x ` must be distinct. (Contributed by Jeff Madsen, 20-Jun-2010.)
theorem cover2 {x3 y1 z: setvar} (ph: wff y1) (A2: class y1) (B2: class):
  $ wcel B2 cvv $ >
  $ wceq A2 (cuni B2) $ >
  $ wb (wral x3 (wrex y1 (wa (wcel (cv x3) (cv y1)) ph) B2) A2) (wrex z (wa (wceq (cuni (cv z)) A2) (wral y1 ph (cv z))) (cpw B2)) $;

--| Two ways of expressing the statement "there is a cover of ` A ` by elements of ` B ` such that for each set in the cover, ` ph ` ". Note that ` ph ` and ` x ` must be distinct. (Contributed by Jeff Madsen, 21-Jun-2010.)
theorem cover2g {x3 y1 z: setvar} (ph: wff y1) (A2: class y1) (B2: class) (C: class x3 y1 z):
  $ wceq A2 (cuni B2) $ >
  $ wi (wcel B2 C) (wb (wral x3 (wrex y1 (wa (wcel (cv x3) (cv y1)) ph) B2) A2) (wrex z (wa (wceq (cuni (cv z)) A2) (wral y1 ph (cv z))) (cpw B2))) $;

--| Relation by a binary relation abstraction. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem brabg2 {x3 y1: setvar} (ph ps: wff x3 y1) (ch: wff) (A2 B2: class) (C D R: class x3 y1):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wceq R (copab x3 y1 ph) $ >
  $ wi ch (wcel A2 C) $ >
  $ wi (wcel B2 D) (wb (wbr A2 B2 R) ch) $;

--| Ordered pair membership in an ordered pair class abstraction, with a reduced hypothesis. (Contributed by Jeff Madsen, 29-May-2011.)
theorem opelopab3 {x3 y1: setvar} (ph ps: wff x3 y1) (ch: wff) (A2 B2: class) (C D: class x3 y1):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi ch (wcel A2 C) $ >
  $ wi (wcel B2 D) (wb (wcel (cop A2 B2) (copab x3 y1 ph)) ch) $;

--| Cancellation of a surjective function from the right side of a composition. (Contributed by Jeff Madsen, 1-Jun-2011.) (Proof shortened by Mario Carneiro, 27-Dec-2014.)
theorem cocanfo (A2 B2 F G H: class):
  $ wi (wa (w3a (wfo A2 B2 F) (wfn G B2) (wfn H B2)) (wceq (ccom G F) (ccom H F))) (wceq G H) $;

--| Restriction of a binary relation. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem brresi2 (A2 B2 C R: class):
  $ wcel B2 cvv $ >
  $ wi (wbr A2 B2 (cres R C)) (wbr A2 B2 R) $;

--| Equality deduction for function abstractions. (Contributed by Jeff Madsen, 19-Jun-2011.)
theorem fnopabeqd {x3 y1: setvar} (ph: wff) (A2 B2 C: class x3 y1):
  $ wi ph (wceq B2 C) $ >
  $ wi ph (wceq (copab x3 y1 (wa (wcel (cv x3) A2) (wceq (cv y1) B2))) (copab x3 y1 (wa (wcel (cv x3) A2) (wceq (cv y1) C)))) $;

--| Function value of an operator abstraction whose domain is a set of functions with given domain and range. (Contributed by Jeff Madsen, 1-Dec-2009.) (Revised by Mario Carneiro, 12-Sep-2015.)
theorem fvopabf4g {x3: setvar} (A2: class) (B2: class x3) (C D R: class) (F X Y: class x3):
  $ wcel C cvv $ >
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wceq F (cmpt x3 (co R D cmap) B2) $ >
  $ wi (w3a (wcel D X) (wcel R Y) (wf D R A2)) (wceq (cfv A2 F) C) $;

--| Composition of a function with a function abstraction. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 27-Dec-2014.)
theorem fnopabco {x3 y1: setvar} (A2: class) (B2: class x3) (C: class) (F G: class x3 y1) (H: class):
  $ wi (wcel (cv x3) A2) (wcel B2 C) $ >
  $ wceq F (copab x3 y1 (wa (wcel (cv x3) A2) (wceq (cv y1) B2))) $ >
  $ wceq G (copab x3 y1 (wa (wcel (cv x3) A2) (wceq (cv y1) (cfv B2 H)))) $ >
  $ wi (wfn H C) (wceq G (ccom H F)) $;

--| Composition of an operator with a function abstraction. (Contributed by Jeff Madsen, 11-Jun-2010.)
theorem opropabco {x3 y1: setvar} (A2: class) (B2 C: class x3) (R S: class) (F G: class x3 y1) (M: class):
  $ wi (wcel (cv x3) A2) (wcel B2 R) $ >
  $ wi (wcel (cv x3) A2) (wcel C S) $ >
  $ wceq F (copab x3 y1 (wa (wcel (cv x3) A2) (wceq (cv y1) (cop B2 C)))) $ >
  $ wceq G (copab x3 y1 (wa (wcel (cv x3) A2) (wceq (cv y1) (co B2 C M)))) $ >
  $ wi (wfn M (cxp R S)) (wceq G (ccom M F)) $;

--| Composition with a function and then with the converse. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem cocnv (F G: class):
  $ wi (wa (wfun F) (wfun G)) (wceq (ccom (ccom F G) (ccnv G)) (cres F (crn G))) $;

--| Cancel a composition by a bijection by preapplying the converse. (Contributed by Jeff Madsen, 2-Sep-2009.) (Proof shortened by Mario Carneiro, 27-Dec-2014.)
theorem f1ocan1fv (A2 B2 F G X: class):
  $ wi (w3a (wfun F) (wf1o A2 B2 G) (wcel X B2)) (wceq (cfv (cfv X (ccnv G)) (ccom F G)) (cfv X F)) $;

--| Cancel a composition by the converse of a bijection by preapplying the bijection. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem f1ocan2fv (A2 B2 F G X: class):
  $ wi (w3a (wfun F) (wf1o A2 B2 G) (wcel X A2)) (wceq (cfv (cfv X G) (ccom F (ccnv G))) (cfv X F)) $;

--| Intersection of Cartesian products over the same base set. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem inixp {x3: setvar} (A2: class) (B2 C: class x3):
  $ wceq (cin (cixp x3 A2 B2) (cixp x3 A2 C)) (cixp x3 A2 (cin B2 C)) $;

--| Universal property of the indexed Cartesian product. (Contributed by Jeff Madsen, 2-Sep-2009.) (Proof shortened by Mario Carneiro, 12-Sep-2015.)
theorem upixp {x3 w h a b: setvar} (A2 B2 C: class) (P: class x3 w b) (R S F: class) (X: class b):
  $ wceq X (cixp b A2 (cfv (cv b) C)) $ >
  $ wceq P (cmpt w A2 (cmpt x3 X (cfv (cv w) (cv x3)))) $ >
  $ wi (w3a (wcel A2 R) (wcel B2 S) (wral a (wf B2 (cfv (cv a) C) (cfv (cv a) F)) A2)) (weu h (wa (wf B2 X (cv h)) (wral a (wceq (cfv (cv a) F) (ccom (cfv (cv a) P) (cv h))) A2))) $;

--| An indexed set is dominated by the indexing set. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem abrexdom {x3 y1: setvar} (ph: wff x3 y1) (A2: class) (V: class x3 y1):
  $ wi (wcel (cv y1) A2) (wmo x3 ph) $ >
  $ wi (wcel A2 V) (wbr (cab x3 (wrex y1 ph A2)) A2 cdom) $;

--| An indexed set is dominated by the indexing set. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem abrexdom2 {x3 y1: setvar} (A2: class) (B2: class y1) (V: class x3 y1):
  $ wi (wcel A2 V) (wbr (cab x3 (wrex y1 (wceq (cv x3) B2) A2)) A2 cdom) $;

--| Axiom of Choice. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem ac6gf {x3 y1 f2: setvar} (ph: wff x3 y1) (ps: wff x3 y1 f2) (A2 B2: class) (C: class x3 y1 f2):
  $ wnf y1 ps $ >
  $ wi (wceq (cv y1) (cfv (cv x3) (cv f2))) (wb ph ps) $ >
  $ wi (wa (wcel A2 C) (wral x3 (wrex y1 ph B2) A2)) (wex f2 (wa (wf A2 B2 (cv f2)) (wral x3 ps A2))) $;

--| If for every element of an indexing set ` A ` there exists a corresponding element of another set ` B ` , then there exists a subset of ` B ` consisting only of those elements which are indexed by ` A ` . Used to avoid the Axiom of Choice in situations where only the range of the choice function is needed. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem indexa {x3 y1 c: setvar} (ph: wff x3 y1) (A2 B2: class) (M: class x3 y1 c):
  $ wi (wa (wcel B2 M) (wral x3 (wrex y1 ph B2) A2)) (wex c (w3a (wss (cv c) B2) (wral x3 (wrex y1 ph (cv c)) A2) (wral y1 (wrex x3 ph A2) (cv c)))) $;

--| If for every element of an indexing set ` A ` there exists a corresponding element of another set ` B ` , then there exists a subset of ` B ` consisting only of those elements which are indexed by ` A ` , and which is dominated by the set ` A ` . (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem indexdom {x3 y1 c: setvar} (ph: wff x3 y1) (A2 B2: class) (M: class x3 y1 c):
  $ wi (wa (wcel A2 M) (wral x3 (wrex y1 ph B2) A2)) (wex c (wa (wa (wbr (cv c) A2 cdom) (wss (cv c) B2)) (wa (wral x3 (wrex y1 ph (cv c)) A2) (wral y1 (wrex x3 ph A2) (cv c))))) $;

--| A subset of a well-founded set has an infimum. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem frinfm {x3 y1 z: setvar} (A2 B2: class) (C: class z) (R: class):
  $ wi (wa (wfr A2 R) (w3a (wcel B2 C) (wss B2 A2) (wne B2 c0))) (wrex x3 (wa (wral y1 (wn (wbr (cv x3) (cv y1) (ccnv R))) B2) (wral y1 (wi (wbr (cv y1) (cv x3) (ccnv R)) (wrex z (wbr (cv y1) (cv z) (ccnv R)) B2)) A2)) A2) $;

--| A nonempty subset of a well-ordered set has a lower bound. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem welb {x3 y1 z: setvar} (A2 B2 C R: class):
  $ wi (wa (wwe A2 R) (w3a (wcel B2 C) (wss B2 A2) (wne B2 c0))) (wa (wor B2 (ccnv R)) (wrex x3 (wa (wral y1 (wn (wbr (cv x3) (cv y1) (ccnv R))) B2) (wral y1 (wi (wbr (cv y1) (cv x3) (ccnv R)) (wrex z (wbr (cv y1) (cv z) (ccnv R)) B2)) B2)) B2)) $;

--| Existence of supremum. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem supex2g (A2 B2 C R: class):
  $ wi (wcel A2 C) (wcel (csup B2 A2 R) cvv) $;

--| Closure of supremum. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem supclt {x3 y1 z: setvar} (A2 B2 R: class):
  $ wi (wa (wor A2 R) (wrex x3 (wa (wral y1 (wn (wbr (cv x3) (cv y1) R)) B2) (wral y1 (wi (wbr (cv y1) (cv x3) R) (wrex z (wbr (cv y1) (cv z) R) B2)) A2)) A2)) (wcel (csup B2 A2 R) A2) $;

--| Upper bound property of supremum. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem supubt {x3 y1 z: setvar} (A2 B2 C R: class):
  $ wi (wa (wor A2 R) (wrex x3 (wa (wral y1 (wn (wbr (cv x3) (cv y1) R)) B2) (wral y1 (wi (wbr (cv y1) (cv x3) R) (wrex z (wbr (cv y1) (cv z) R) B2)) A2)) A2)) (wi (wcel C B2) (wn (wbr (csup B2 A2 R) C R))) $;

--| Combine a finite set of lower bounds. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem filbcmb {x3 y1 z: setvar} (ph: wff x3 z) (A2 B2: class):
  $ wi (w3a (wcel A2 cfn) (wne A2 c0) (wss B2 cr)) (wi (wral x3 (wrex y1 (wral z (wi (wbr (cv y1) (cv z) cle) ph) B2) B2) A2) (wrex y1 (wral z (wi (wbr (cv y1) (cv z) cle) (wral x3 ph A2)) B2) B2)) $;

--| Membership of a product in a finite interval of integers. (Contributed by Jeff Madsen, 17-Jun-2010.)
theorem fzmul (J K M N: class):
  $ wi (w3a (wcel M cz) (wcel N cz) (wcel K cn)) (wi (wcel J (co M N cfz)) (wcel (co K J cmul) (co (co K M cmul) (co K N cmul) cfz))) $;

--| Lemma for ~ sdc . (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem sdclem2 {x3 w f2 g2 h k n: setvar} (ph: wff f2 g2 h k) (ps: wff w g2 n) (ch: wff x3 w f2 h k n) (th: wff f2 g2 h k) (ta: wff f2 g2) (si: wff w h k) (A2: class) (F: class f2 g2 h k) (G: class) (J: class f2 g2 n) (M: class) (V: class x3 w f2 g2 k n) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi (wceq (cv g2) (cres (cv f2) (co M (cv n) cfz))) (wb ps ch) $ >
  $ wi (wceq (cv n) M) (wb ps ta) $ >
  $ wi (wceq (cv n) (cv k)) (wb ps th) $ >
  $ wi (wa (wceq (cv g2) (cv h)) (wceq (cv n) (co (cv k) c1 caddc))) (wb ps si) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wex g2 (wa (wf (csn M) A2 (cv g2)) ta)) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wi (wa (wf (co M (cv k) cfz) A2 (cv g2)) th) (wex h (w3a (wf (co M (co (cv k) c1 caddc) cfz) A2 (cv h)) (wceq (cv g2) (cres (cv h) (co M (cv k) cfz))) si))) $ >
  $ wceq J (cab g2 (wrex n (wa (wf (co M (cv n) cfz) A2 (cv g2)) ps) Z)) $ >
  $ wceq F (cmpo w x3 Z J (cab h (wrex k (w3a (wf (co M (co (cv k) c1 caddc) cfz) A2 (cv h)) (wceq (cv x3) (cres (cv h) (co M (cv k) cfz))) si) Z))) $ >
  $ wnf k ph $ >
  $ wi ph (wf Z J G) $ >
  $ wi ph (wf (co M M cfz) A2 (cfv M G)) $ >
  $ wi (wa ph (wcel (cv w) Z)) (wcel (cfv (co (cv w) c1 caddc) G) (co (cv w) (cfv (cv w) G) F)) $ >
  $ wi ph (wex f2 (wa (wf Z A2 (cv f2)) (wral n ch Z))) $;

--| Lemma for ~ sdc . (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem sdclem1 {x3 w f2 g2 h k n: setvar} (ph: wff f2) (ps: wff w g2 n) (ch: wff x3 w f2 h k n) (th: wff f2 g2 h k) (ta: wff f2 g2) (si: wff w h k) (A2: class) (F: class f2 g2 h k) (J: class f2 g2 n) (M: class) (V: class x3 w f2 g2 k n) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi (wceq (cv g2) (cres (cv f2) (co M (cv n) cfz))) (wb ps ch) $ >
  $ wi (wceq (cv n) M) (wb ps ta) $ >
  $ wi (wceq (cv n) (cv k)) (wb ps th) $ >
  $ wi (wa (wceq (cv g2) (cv h)) (wceq (cv n) (co (cv k) c1 caddc))) (wb ps si) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wex g2 (wa (wf (csn M) A2 (cv g2)) ta)) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wi (wa (wf (co M (cv k) cfz) A2 (cv g2)) th) (wex h (w3a (wf (co M (co (cv k) c1 caddc) cfz) A2 (cv h)) (wceq (cv g2) (cres (cv h) (co M (cv k) cfz))) si))) $ >
  $ wceq J (cab g2 (wrex n (wa (wf (co M (cv n) cfz) A2 (cv g2)) ps) Z)) $ >
  $ wceq F (cmpo w x3 Z J (cab h (wrex k (w3a (wf (co M (co (cv k) c1 caddc) cfz) A2 (cv h)) (wceq (cv x3) (cres (cv h) (co M (cv k) cfz))) si) Z))) $ >
  $ wi ph (wex f2 (wa (wf Z A2 (cv f2)) (wral n ch Z))) $;

--| Strong dependent choice. Suppose we may choose an element of ` A ` such that property ` ps ` holds, and suppose that if we have already chosen the first ` k ` elements (represented here by a function from ` 1 ... k ` to ` A ` ), we may choose another element so that all ` k + 1 ` elements taken together have property ` ps ` . Then there exists an infinite sequence of elements of ` A ` such that the first ` n ` terms of this sequence satisfy ` ps ` for all ` n ` . This theorem allows to construct infinite sequences where each term depends on all the previous terms in the sequence. (Contributed by Jeff Madsen, 2-Sep-2009.) (Proof shortened by Mario Carneiro, 3-Jun-2014.)
theorem sdc {f2 g2 h k n: setvar} (ph: wff f2) (ps: wff g2 n) (ch: wff f2 h k n) (th: wff f2 g2 h k) (ta: wff f2 g2) (si: wff h k) (A2 M: class) (V: class f2 g2 k n) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi (wceq (cv g2) (cres (cv f2) (co M (cv n) cfz))) (wb ps ch) $ >
  $ wi (wceq (cv n) M) (wb ps ta) $ >
  $ wi (wceq (cv n) (cv k)) (wb ps th) $ >
  $ wi (wa (wceq (cv g2) (cv h)) (wceq (cv n) (co (cv k) c1 caddc))) (wb ps si) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wex g2 (wa (wf (csn M) A2 (cv g2)) ta)) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wi (wa (wf (co M (cv k) cfz) A2 (cv g2)) th) (wex h (w3a (wf (co M (co (cv k) c1 caddc) cfz) A2 (cv h)) (wceq (cv g2) (cres (cv h) (co M (cv k) cfz))) si))) $ >
  $ wi ph (wex f2 (wa (wf Z A2 (cv f2)) (wral n ch Z))) $;

--| Finite version of dependent choice. Construct a function whose value depends on the previous function value, except at a final point at which no new value can be chosen. The final hypothesis ensures that the process will terminate. The proof does not use the Axiom of Choice. (Contributed by Jeff Madsen, 18-Jun-2010.)
theorem fdc {f2 k n a b: setvar} (ph: wff n a b) (ps: wff f2 k n b) (ch: wff f2 k) (th: wff k a b) (ta et: wff f2 k n) (A2: class k) (C: class k a b) (R: class f2 k n) (M N: class) (Z: class f2 k):
  $ wcel A2 cvv $ >
  $ wcel M cz $ >
  $ wceq Z (cfv M cuz) $ >
  $ wceq N (co M c1 caddc) $ >
  $ wi (wceq (cv a) (cfv (co (cv k) c1 cmin) (cv f2))) (wb ph ps) $ >
  $ wi (wceq (cv b) (cfv (cv k) (cv f2))) (wb ps ch) $ >
  $ wi (wceq (cv a) (cfv (cv n) (cv f2))) (wb th ta) $ >
  $ wi et (wcel C A2) $ >
  $ wi et (wfr A2 R) $ >
  $ wi (wa et (wcel (cv a) A2)) (wo th (wrex b ph A2)) $ >
  $ wi (wa (wa et ph) (wa (wcel (cv a) A2) (wcel (cv b) A2))) (wbr (cv b) (cv a) R) $ >
  $ wi et (wrex n (wex f2 (w3a (wf (co M (cv n) cfz) A2 (cv f2)) (wa (wceq (cfv M (cv f2)) C) ta) (wral k ch (co N (cv n) cfz)))) Z) $;

--| Variant of ~ fdc with no specified base value. (Contributed by Jeff Madsen, 18-Jun-2010.)
theorem fdc1 {f2 k n a b: setvar} (ph: wff n a b) (ps: wff f2 k n b) (ch: wff f2 k) (th: wff k a b) (ta: wff f2 k n) (et: wff k) (ze: wff k a) (si: wff f2 k n b) (A2: class k) (R: class f2 k n) (M N: class) (Z: class f2 k):
  $ wcel A2 cvv $ >
  $ wcel M cz $ >
  $ wceq Z (cfv M cuz) $ >
  $ wceq N (co M c1 caddc) $ >
  $ wi (wceq (cv a) (cfv M (cv f2))) (wb ze si) $ >
  $ wi (wceq (cv a) (cfv (co (cv k) c1 cmin) (cv f2))) (wb ph ps) $ >
  $ wi (wceq (cv b) (cfv (cv k) (cv f2))) (wb ps ch) $ >
  $ wi (wceq (cv a) (cfv (cv n) (cv f2))) (wb th ta) $ >
  $ wi et (wrex a ze A2) $ >
  $ wi et (wfr A2 R) $ >
  $ wi (wa et (wcel (cv a) A2)) (wo th (wrex b ph A2)) $ >
  $ wi (wa (wa et ph) (wa (wcel (cv a) A2) (wcel (cv b) A2))) (wbr (cv b) (cv a) R) $ >
  $ wi et (wrex n (wex f2 (w3a (wf (co M (cv n) cfz) A2 (cv f2)) (wa si ta) (wral k ch (co N (cv n) cfz)))) Z) $;

--| Two ways to say that a sequence respects a partial order. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem seqpo {m n s1: setvar} (A2 R F: class):
  $ wi (wa (wpo A2 R) (wf cn A2 F)) (wb (wral s1 (wbr (cfv (cv s1) F) (cfv (co (cv s1) c1 caddc) F) R) cn) (wral m (wral n (wbr (cfv (cv m) F) (cfv (cv n) F) R) (cfv (co (cv m) c1 caddc) cuz)) cn)) $;

--| An increasing sequence of positive integers takes on indefinitely large values. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem incsequz {m n: setvar} (A2 F: class):
  $ wi (w3a (wf cn cn F) (wral m (wbr (cfv (cv m) F) (cfv (co (cv m) c1 caddc) F) clt) cn) (wcel A2 cn)) (wrex n (wcel (cfv (cv n) F) (cfv A2 cuz)) cn) $;

--| An increasing sequence of positive integers takes on indefinitely large values. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem incsequz2 {k m n: setvar} (A2 F: class):
  $ wi (w3a (wf cn cn F) (wral m (wbr (cfv (cv m) F) (cfv (co (cv m) c1 caddc) F) clt) cn) (wcel A2 cn)) (wrex n (wral k (wcel (cfv (cv k) F) (cfv A2 cuz)) (cfv (cv n) cuz)) cn) $;

--| A bounded above set of positive integers is finite. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 28-Feb-2014.)
theorem nnubfi {x3: setvar} (A2 B2: class):
  $ wi (wa (wss A2 cn) (wcel B2 cn)) (wcel (crab x3 (wbr (cv x3) B2 clt) A2) cfn) $;

--| An infinite set of positive integers is unbounded above. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 28-Feb-2014.)
theorem nninfnub {x3: setvar} (A2 B2: class):
  $ wi (w3a (wss A2 cn) (wn (wcel A2 cfn)) (wcel B2 cn)) (wne (crab x3 (wbr B2 (cv x3) clt) A2) c0) $;

--| An open set is open in the subspace topology. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 15-Dec-2013.)
theorem subspopn (A2 B2 J V: class):
  $ wi (wa (wa (wcel J ctop) (wcel A2 V)) (wa (wcel B2 J) (wss B2 A2))) (wcel B2 (co J A2 crest)) $;

--| Neighborhoods are closed under finite intersection. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 25-Nov-2013.)
theorem neificl (S J N: class):
  $ wi (wa (wa (wcel J ctop) (wss N (cfv S (cfv J cnei)))) (wa (wcel N cfn) (wne N c0))) (wcel (cint N) (cfv S (cfv J cnei))) $;

--| Limit points of a subset are limit points of the larger set. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem lpss2 (A2 B2 J X: class):
  $ wceq X (cuni J) $ >
  $ wi (w3a (wcel J ctop) (wss A2 X) (wss B2 A2)) (wss (cfv B2 (cfv J clp)) (cfv A2 (cfv J clp))) $;

--| Use a bijection with a metric space to construct a metric on a set. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem metf1o {x3 y1: setvar} (A2 F M: class) (N: class x3 y1) (X Y: class):
  $ wceq N (cmpo x3 y1 Y Y (co (cfv (cv x3) F) (cfv (cv y1) F) M)) $ >
  $ wi (w3a (wcel Y A2) (wcel M (cfv X cmet)) (wf1o Y X F)) (wcel N (cfv Y cmet)) $;

--| A ball in the subspace metric. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 5-Jan-2014.)
theorem blssp (R S M N X Y: class):
  $ wceq N (cres M (cxp S S)) $ >
  $ wi (wa (wa (wcel M (cfv X cmet)) (wss S X)) (wa (wcel Y S) (wcel R crp))) (wceq (co Y R (cfv N cbl)) (cin (co Y R (cfv M cbl)) S)) $;

--| Generalized triangle inequality for arbitrary finite sums. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 4-Jun-2014.)
theorem mettrifi {k: setvar} (ph: wff) (D F M N X: class):
  $ wi ph (wcel D (cfv X cmet)) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel (cfv (cv k) F) X) $ >
  $ wi ph (wbr (co (cfv M F) (cfv N F) D) (csu k (co M (co N c1 cmin) cfz) (co (cfv (cv k) F) (cfv (co (cv k) c1 caddc) F) D)) cle) $;

--| A sequence in a metric space converges to a point iff the distance between the point and the elements of the sequence converges to 0. (Contributed by Jeff Madsen, 2-Sep-2009.) (Proof shortened by Mario Carneiro, 5-Jun-2014.)
theorem lmclim2 {x3: setvar} (ph: wff) (D F G J X Y: class):
  $ wi ph (wcel D (cfv X cmet)) $ >
  $ wi ph (wf cn X F) $ >
  $ wceq J (cfv D cmopn) $ >
  $ wceq G (cmpt x3 cn (co (cfv (cv x3) F) Y D)) $ >
  $ wi ph (wcel Y X) $ >
  $ wi ph (wb (wbr F Y (cfv J clm)) (wbr G cc0 cli)) $;

--| If the distance between consecutive points in a sequence is bounded by a geometric sequence, then the sequence is Cauchy. (Contributed by Jeff Madsen, 2-Sep-2009.) (Proof shortened by Mario Carneiro, 5-Jun-2014.)
theorem geomcau {k: setvar} (ph: wff) (A2 B2 D F X: class):
  $ wi ph (wcel D (cfv X cmet)) $ >
  $ wi ph (wf cn X F) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wbr B2 c1 clt) $ >
  $ wi (wa ph (wcel (cv k) cn)) (wbr (co (cfv (cv k) F) (cfv (co (cv k) c1 caddc) F) D) (co A2 (co B2 (cv k) cexp) cmul) cle) $ >
  $ wi ph (wcel F (cfv D ccau)) $;

--| The restriction of a Cauchy sequence to an upper set of integers is Cauchy. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 5-Jun-2014.)
theorem caures (ph: wff) (D F M X Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel D (cfv X cmet)) $ >
  $ wi ph (wcel F (co X cc cpm)) $ >
  $ wi ph (wb (wcel F (cfv D ccau)) (wcel (cres F Z) (cfv D ccau))) $;

--| A shifted Cauchy sequence is Cauchy. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 5-Jun-2014.)
theorem caushft {k: setvar} (ph: wff) (D F G: class) (M: class k) (N: class) (W: class k) (X Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel D (cfv X cmet)) $ >
  $ wceq W (cfv (co M N caddc) cuz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) (cfv (co (cv k) N caddc) G)) $ >
  $ wi ph (wcel F (cfv D ccau)) $ >
  $ wi ph (wf W X G) $ >
  $ wi ph (wcel G (cfv D ccau)) $;

--| A constant function is a continuous function on ` CC ` . (Contributed by Jeff Madsen, 2-Sep-2009.) (Moved into main set.mm as ~ cncfmptc and may be deleted by mathbox owner, JM. --MC 12-Sep-2015.) (Revised by Mario Carneiro, 12-Sep-2015.)
theorem constcncf {x3: setvar} (A2: class) (F: class x3):
  $ wceq F (cmpt x3 cc A2) $ >
  $ wi (wcel A2 cc) (wcel F (co cc cc ccncf)) $;

--| The restriction of a continuous function to a subset is continuous. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 15-Dec-2013.)
theorem cnres2 {x3: setvar} (A2 B2 F J K X Y: class):
  $ wceq X (cuni J) $ >
  $ wceq Y (cuni K) $ >
  $ wi (w3a (wa (wcel J ctop) (wcel K ctop)) (wa (wss A2 X) (wss B2 Y)) (wa (wcel F (co J K ccn)) (wral x3 (wcel (cfv (cv x3) F) B2) A2))) (wcel (cres F A2) (co (co J A2 crest) (co K B2 crest) ccn)) $;

--| A continuous function is continuous onto its image. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 15-Dec-2013.)
theorem cnresima (F J K: class):
  $ wi (w3a (wcel J ctop) (wcel K ctop) (wcel F (co J K ccn))) (wcel F (co J (co K (crn F) crest) ccn)) $;

--| A continuous function on complex numbers restricted to a subset. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 12-Sep-2015.)
theorem cncfres {x3: setvar} (A2 B2: class) (C F G: class x3) (J K: class):
  $ wss A2 cc $ >
  $ wss B2 cc $ >
  $ wceq F (cmpt x3 cc C) $ >
  $ wceq G (cmpt x3 A2 C) $ >
  $ wi (wcel (cv x3) A2) (wcel C B2) $ >
  $ wcel F (co cc cc ccncf) $ >
  $ wceq J (cfv (cres (ccom cabs cmin) (cxp A2 A2)) cmopn) $ >
  $ wceq K (cfv (cres (ccom cabs cmin) (cxp B2 B2)) cmopn) $ >
  $ wcel G (co J K ccn) $;

--| Extend class notation with the class of totally bounded metric spaces.
term ctotbnd: class;

--| Extend class notation with the class of bounded metric spaces.
term cbnd: class;

--| Define the class of totally bounded metrics. A metric space is totally bounded iff it can be covered by a finite number of balls of any given radius. (Contributed by Jeff Madsen, 2-Sep-2009.)
axiom df_totbnd {x3 y1 v m b d: setvar}:
  $ wceq ctotbnd (cmpt x3 cvv (crab m (wral d (wrex v (wa (wceq (cuni (cv v)) (cv x3)) (wral b (wrex y1 (wceq (cv b) (co (cv y1) (cv d) (cfv (cv m) cbl))) (cv x3)) (cv v))) cfn) crp) (cfv (cv x3) cmet))) $;

--| The predicate "is a totally bounded metric space". (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem istotbnd {x3 v b d: setvar} (M X: class):
  $ wb (wcel M (cfv X ctotbnd)) (wa (wcel M (cfv X cmet)) (wral d (wrex v (wa (wceq (cuni (cv v)) X) (wral b (wrex x3 (wceq (cv b) (co (cv x3) (cv d) (cfv M cbl))) X) (cv v))) cfn) crp)) $;

--| The predicate "is a totally bounded metric space." (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem istotbnd2 {x3 v b d: setvar} (M X: class):
  $ wi (wcel M (cfv X cmet)) (wb (wcel M (cfv X ctotbnd)) (wral d (wrex v (wa (wceq (cuni (cv v)) X) (wral b (wrex x3 (wceq (cv b) (co (cv x3) (cv d) (cfv M cbl))) X) (cv v))) cfn) crp)) $;

--| A metric space is totally bounded iff there is a finite &epsilon;-net for every positive &epsilon;. This differs from the definition in providing a finite set of ball centers rather than a finite set of balls. (Contributed by Mario Carneiro, 12-Sep-2015.)
theorem istotbnd3 {x3 v d: setvar} (M X: class):
  $ wb (wcel M (cfv X ctotbnd)) (wa (wcel M (cfv X cmet)) (wral d (wrex v (wceq (ciun x3 (cv v) (co (cv x3) (cv d) (cfv M cbl))) X) (cin (cpw X) cfn)) crp)) $;

--| The predicate "totally bounded" implies ` M ` is a metric space. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem totbndmet (M X: class):
  $ wi (wcel M (cfv X ctotbnd)) (wcel M (cfv X cmet)) $;

--| The metric (there is only one) on the empty set is totally bounded. (Contributed by Mario Carneiro, 16-Sep-2015.)
theorem _0totbnd (M X: class):
  $ wi (wceq X c0) (wb (wcel M (cfv X ctotbnd)) (wcel M (cfv X cmet))) $;

--| Condition for a subset of a metric space to be totally bounded. (Contributed by Mario Carneiro, 12-Sep-2015.)
theorem sstotbnd2 {x3 v d: setvar} (M N X Y: class):
  $ wceq N (cres M (cxp Y Y)) $ >
  $ wi (wa (wcel M (cfv X cmet)) (wss Y X)) (wb (wcel N (cfv Y ctotbnd)) (wral d (wrex v (wss Y (ciun x3 (cv v) (co (cv x3) (cv d) (cfv M cbl)))) (cin (cpw X) cfn)) crp)) $;

--| Condition for a subset of a metric space to be totally bounded. (Contributed by Jeff Madsen, 2-Sep-2009.) (Proof shortened by Mario Carneiro, 12-Sep-2015.)
theorem sstotbnd {x3 v b d: setvar} (M: class) (N: class b) (X Y: class):
  $ wceq N (cres M (cxp Y Y)) $ >
  $ wi (wa (wcel M (cfv X cmet)) (wss Y X)) (wb (wcel N (cfv Y ctotbnd)) (wral d (wrex v (wa (wss Y (cuni (cv v))) (wral b (wrex x3 (wceq (cv b) (co (cv x3) (cv d) (cfv M cbl))) X) (cv v))) cfn) crp)) $;

--| Use a net that is not necessarily finite, but for which only finitely many balls meet the subset. (Contributed by Mario Carneiro, 14-Sep-2015.)
theorem sstotbnd3 {x3 v d: setvar} (M N X Y: class):
  $ wceq N (cres M (cxp Y Y)) $ >
  $ wi (wa (wcel M (cfv X cmet)) (wss Y X)) (wb (wcel N (cfv Y ctotbnd)) (wral d (wrex v (wa (wss Y (ciun x3 (cv v) (co (cv x3) (cv d) (cfv M cbl)))) (wcel (crab x3 (wne (cin (co (cv x3) (cv d) (cfv M cbl)) Y) c0) (cv v)) cfn)) (cpw X)) crp)) $;

--| A subset of a totally bounded metric space is totally bounded. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 12-Sep-2015.)
theorem totbndss (S M X: class):
  $ wi (wa (wcel M (cfv X ctotbnd)) (wss S X)) (wcel (cres M (cxp S S)) (cfv S ctotbnd)) $;

--| If the metric ` M ` is "strongly finer" than ` N ` (meaning that there is a positive real constant ` R ` such that ` N ( x , y ) <_ R x. M ( x , y ) ` ), then total boundedness of ` M ` implies total boundedness of ` N ` . (Using this theorem twice in each direction states that if two metrics are strongly equivalent, then one is totally bounded iff the other is.) (Contributed by Mario Carneiro, 14-Sep-2015.)
theorem equivtotbnd {x3 y1: setvar} (ph: wff) (R M N X: class):
  $ wi ph (wcel M (cfv X ctotbnd)) $ >
  $ wi ph (wcel N (cfv X cmet)) $ >
  $ wi ph (wcel R crp) $ >
  $ wi (wa ph (wa (wcel (cv x3) X) (wcel (cv y1) X))) (wbr (co (cv x3) (cv y1) N) (co R (co (cv x3) (cv y1) M) cmul) cle) $ >
  $ wi ph (wcel N (cfv X ctotbnd)) $;

--| Define the class of bounded metrics. A metric space is bounded iff it can be covered by a single ball. (Contributed by Jeff Madsen, 2-Sep-2009.)
axiom df_bnd {x3 y1 m r: setvar}:
  $ wceq cbnd (cmpt x3 cvv (crab m (wral y1 (wrex r (wceq (cv x3) (co (cv y1) (cv r) (cfv (cv m) cbl))) crp) (cv x3)) (cfv (cv x3) cmet))) $;

--| The predicate "is a bounded metric space". (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 12-Sep-2015.)
theorem isbnd {x3 r: setvar} (M X: class):
  $ wb (wcel M (cfv X cbnd)) (wa (wcel M (cfv X cmet)) (wral x3 (wrex r (wceq X (co (cv x3) (cv r) (cfv M cbl))) crp) X)) $;

--| A bounded metric space is a metric space. (Contributed by Mario Carneiro, 16-Sep-2015.)
theorem bndmet (M X: class):
  $ wi (wcel M (cfv X cbnd)) (wcel M (cfv X cmet)) $;

--| A "bounded extended metric" (meaning that it satisfies the same condition as a bounded metric, but with "metric" replaced with "extended metric") is a metric and thus is bounded in the conventional sense. (Contributed by Mario Carneiro, 12-Sep-2015.)
theorem isbndx {x3 r: setvar} (M X: class):
  $ wb (wcel M (cfv X cbnd)) (wa (wcel M (cfv X cxmet)) (wral x3 (wrex r (wceq X (co (cv x3) (cv r) (cfv M cbl))) crp) X)) $;

--| The predicate "is a bounded metric space". Uses a single point instead of an arbitrary point in the space. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem isbnd2 {x3 r: setvar} (M X: class):
  $ wb (wa (wcel M (cfv X cbnd)) (wne X c0)) (wa (wcel M (cfv X cxmet)) (wrex x3 (wrex r (wceq X (co (cv x3) (cv r) (cfv M cbl))) crp) X)) $;

--| A metric space is bounded iff the metric function maps to some bounded real interval. (Contributed by Mario Carneiro, 13-Sep-2015.)
theorem isbnd3 {x3: setvar} (M X: class):
  $ wb (wcel M (cfv X cbnd)) (wa (wcel M (cfv X cmet)) (wrex x3 (wf (cxp X X) (co cc0 (cv x3) cicc) M) cr)) $;

--| A metric space is bounded iff the metric function maps to some bounded real interval. (Contributed by Mario Carneiro, 22-Sep-2015.)
theorem isbnd3b {x3 y1 z: setvar} (M X: class):
  $ wb (wcel M (cfv X cbnd)) (wa (wcel M (cfv X cmet)) (wrex x3 (wral y1 (wral z (wbr (co (cv y1) (cv z) M) (cv x3) cle) X) X) cr)) $;

--| A subset of a bounded metric space is bounded. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem bndss (S M X: class):
  $ wi (wa (wcel M (cfv X cbnd)) (wss S X)) (wcel (cres M (cxp S S)) (cfv S cbnd)) $;

--| A ball is bounded. (Contributed by Jeff Madsen, 2-Sep-2009.) (Proof shortened by Mario Carneiro, 15-Jan-2014.)
theorem blbnd (R M X Y: class):
  $ wi (w3a (wcel M (cfv X cxmet)) (wcel Y X) (wcel R cr)) (wcel (cres M (cxp (co Y R (cfv M cbl)) (co Y R (cfv M cbl)))) (cfv (co Y R (cfv M cbl)) cbnd)) $;

--| A subset of a metric space is bounded iff it is contained in a ball around ` P ` , for any ` P ` in the larger space. (Contributed by Mario Carneiro, 14-Sep-2015.)
theorem ssbnd {d: setvar} (P M N X Y: class):
  $ wceq N (cres M (cxp Y Y)) $ >
  $ wi (wa (wcel M (cfv X cmet)) (wcel P X)) (wb (wcel N (cfv Y cbnd)) (wrex d (wss Y (co P (cv d) (cfv M cbl))) cr)) $;

--| A totally bounded metric space is bounded. This theorem fails for extended metrics - a bounded extended metric is a metric, but there are totally bounded extended metrics that are not metrics (if we were to weaken ~ istotbnd to only require that ` M ` be an extended metric). A counterexample is the discrete extended metric (assigning distinct points distance ` +oo ` ) on a finite set. (Contributed by Jeff Madsen, 2-Sep-2009.) (Proof shortened by Mario Carneiro, 12-Sep-2015.)
theorem totbndbnd (M X: class):
  $ wi (wcel M (cfv X ctotbnd)) (wcel M (cfv X cbnd)) $;

--| If the metric ` M ` is "strongly finer" than ` N ` (meaning that there is a positive real constant ` R ` such that ` N ( x , y ) <_ R x. M ( x , y ) ` ), then boundedness of ` M ` implies boundedness of ` N ` . (Using this theorem twice in each direction states that if two metrics are strongly equivalent, then one is bounded iff the other is.) (Contributed by Mario Carneiro, 14-Sep-2015.)
theorem equivbnd {x3 y1: setvar} (ph: wff) (R M N X: class):
  $ wi ph (wcel M (cfv X cbnd)) $ >
  $ wi ph (wcel N (cfv X cmet)) $ >
  $ wi ph (wcel R crp) $ >
  $ wi (wa ph (wa (wcel (cv x3) X) (wcel (cv y1) X))) (wbr (co (cv x3) (cv y1) N) (co R (co (cv x3) (cv y1) M) cmul) cle) $ >
  $ wi ph (wcel N (cfv X cbnd)) $;

--| Lemma for ~ equivbnd2 and similar theorems. (Contributed by Jeff Madsen, 16-Sep-2015.)
theorem bnd2lem (D M X Y: class):
  $ wceq D (cres M (cxp Y Y)) $ >
  $ wi (wa (wcel M (cfv X cmet)) (wcel D (cfv Y cbnd))) (wss Y X) $;

--| If balls are totally bounded in the metric ` M ` , then balls are totally bounded in the equivalent metric ` N ` . (Contributed by Mario Carneiro, 15-Sep-2015.)
theorem equivbnd2 {x3 y1: setvar} (ph: wff) (C D R S: class) (M N X: class x3 y1) (Y: class):
  $ wi ph (wcel M (cfv X cmet)) $ >
  $ wi ph (wcel N (cfv X cmet)) $ >
  $ wi ph (wcel R crp) $ >
  $ wi ph (wcel S crp) $ >
  $ wi (wa ph (wa (wcel (cv x3) X) (wcel (cv y1) X))) (wbr (co (cv x3) (cv y1) N) (co R (co (cv x3) (cv y1) M) cmul) cle) $ >
  $ wi (wa ph (wa (wcel (cv x3) X) (wcel (cv y1) X))) (wbr (co (cv x3) (cv y1) M) (co S (co (cv x3) (cv y1) N) cmul) cle) $ >
  $ wceq C (cres M (cxp Y Y)) $ >
  $ wceq D (cres N (cxp Y Y)) $ >
  $ wi ph (wb (wcel C (cfv Y ctotbnd)) (wcel C (cfv Y cbnd))) $ >
  $ wi ph (wb (wcel D (cfv Y ctotbnd)) (wcel D (cfv Y cbnd))) $;

--| The product metric over finite index set is bounded if all the factors are bounded. (Contributed by Mario Carneiro, 13-Sep-2015.)
theorem prdsbnd {x3: setvar} (ph: wff) (B2: class) (D: class x3) (R S: class) (E: class x3) (I: class) (V W: class x3) (Y: class):
  $ wceq Y (co S R cprds) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wceq V (cfv (cfv (cv x3) R) cbs) $ >
  $ wceq E (cres (cfv (cfv (cv x3) R) cds) (cxp V V)) $ >
  $ wceq D (cfv Y cds) $ >
  $ wi ph (wcel S W) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wfn R I) $ >
  $ wi (wa ph (wcel (cv x3) I)) (wcel E (cfv V cbnd)) $ >
  $ wi ph (wcel D (cfv B2 cbnd)) $;

--| The product metric over finite index set is totally bounded if all the factors are totally bounded. (Contributed by Mario Carneiro, 20-Sep-2015.)
theorem prdstotbnd {x3: setvar} (ph: wff) (B2: class) (D: class x3) (R S: class) (E: class x3) (I: class) (V W: class x3) (Y: class):
  $ wceq Y (co S R cprds) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wceq V (cfv (cfv (cv x3) R) cbs) $ >
  $ wceq E (cres (cfv (cfv (cv x3) R) cds) (cxp V V)) $ >
  $ wceq D (cfv Y cds) $ >
  $ wi ph (wcel S W) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wfn R I) $ >
  $ wi (wa ph (wcel (cv x3) I)) (wcel E (cfv V ctotbnd)) $ >
  $ wi ph (wcel D (cfv B2 ctotbnd)) $;

--| If balls are totally bounded in each factor, then balls are bounded in a metric product. (Contributed by Mario Carneiro, 16-Sep-2015.)
theorem prdsbnd2 {x3 y1: setvar} (ph: wff) (A2: class x3 y1) (B2: class) (C: class x3 y1) (D: class x3) (R: class) (S: class y1) (E: class x3) (I: class) (V: class x3) (W: class x3 y1) (Y: class y1):
  $ wceq Y (co S R cprds) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wceq V (cfv (cfv (cv x3) R) cbs) $ >
  $ wceq E (cres (cfv (cfv (cv x3) R) cds) (cxp V V)) $ >
  $ wceq D (cfv Y cds) $ >
  $ wi ph (wcel S W) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wfn R I) $ >
  $ wceq C (cres D (cxp A2 A2)) $ >
  $ wi (wa ph (wcel (cv x3) I)) (wcel E (cfv V cmet)) $ >
  $ wi (wa ph (wcel (cv x3) I)) (wb (wcel (cres E (cxp (cv y1) (cv y1))) (cfv (cv y1) ctotbnd)) (wcel (cres E (cxp (cv y1) (cv y1))) (cfv (cv y1) cbnd))) $ >
  $ wi ph (wb (wcel C (cfv A2 ctotbnd)) (wcel C (cfv A2 cbnd))) $;

--| A subset of the complex numbers is totally bounded iff it is bounded. (Contributed by Mario Carneiro, 14-Sep-2015.)
theorem cntotbnd (D X: class):
  $ wceq D (cres (ccom cabs cmin) (cxp X X)) $ >
  $ wb (wcel D (cfv X ctotbnd)) (wcel D (cfv X cbnd)) $;

--| A subset of ` A ^ I ` , where ` A C_ CC ` , is totally bounded iff it is bounded. (Contributed by Mario Carneiro, 14-Sep-2015.)
theorem cnpwstotbnd (A2 D I X Y: class):
  $ wceq Y (co (co ccnfld A2 cress) I cpws) $ >
  $ wceq D (cres (cfv Y cds) (cxp X X)) $ >
  $ wi (wa (wss A2 cc) (wcel I cfn)) (wb (wcel D (cfv X ctotbnd)) (wcel D (cfv X cbnd))) $;

--| Extend class notation with the class of metric space isometries.
term cismty: class;

--| Define a function which takes two metric spaces and returns the set of isometries between the spaces. An isometry is a bijection which preserves distance. (Contributed by Jeff Madsen, 2-Sep-2009.)
axiom df_ismty {x3 y1 f2 m n: setvar}:
  $ wceq cismty (cmpo m n (cuni (crn cxmet)) (cuni (crn cxmet)) (cab f2 (wa (wf1o (cdm (cdm (cv m))) (cdm (cdm (cv n))) (cv f2)) (wral x3 (wral y1 (wceq (co (cv x3) (cv y1) (cv m)) (co (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) (cv n))) (cdm (cdm (cv m)))) (cdm (cdm (cv m))))))) $;

--| The set of isometries between two metric spaces. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem ismtyval {x3 y1 f2: setvar} (M N X Y: class):
  $ wi (wa (wcel M (cfv X cxmet)) (wcel N (cfv Y cxmet))) (wceq (co M N cismty) (cab f2 (wa (wf1o X Y (cv f2)) (wral x3 (wral y1 (wceq (co (cv x3) (cv y1) M) (co (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) N)) X) X)))) $;

--| The condition "is an isometry". (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem isismty {x3 y1: setvar} (F M N X Y: class):
  $ wi (wa (wcel M (cfv X cxmet)) (wcel N (cfv Y cxmet))) (wb (wcel F (co M N cismty)) (wa (wf1o X Y F) (wral x3 (wral y1 (wceq (co (cv x3) (cv y1) M) (co (cfv (cv x3) F) (cfv (cv y1) F) N)) X) X))) $;

--| The inverse of an isometry is an isometry. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem ismtycnv (F M N X Y: class):
  $ wi (wa (wcel M (cfv X cxmet)) (wcel N (cfv Y cxmet))) (wi (wcel F (co M N cismty)) (wcel (ccnv F) (co N M cismty))) $;

--| The image of a ball under an isometry is another ball. (Contributed by Jeff Madsen, 31-Jan-2014.)
theorem ismtyima (P R F M N X Y: class):
  $ wi (wa (w3a (wcel M (cfv X cxmet)) (wcel N (cfv Y cxmet)) (wcel F (co M N cismty))) (wa (wcel P X) (wcel R cxr))) (wceq (cima F (co P R (cfv M cbl))) (co (cfv P F) R (cfv N cbl))) $;

--| Lemma for ~ ismtyhmeo . (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 12-Sep-2015.)
theorem ismtyhmeolem (ph: wff) (F J K M N X Y: class):
  $ wceq J (cfv M cmopn) $ >
  $ wceq K (cfv N cmopn) $ >
  $ wi ph (wcel M (cfv X cxmet)) $ >
  $ wi ph (wcel N (cfv Y cxmet)) $ >
  $ wi ph (wcel F (co M N cismty)) $ >
  $ wi ph (wcel F (co J K ccn)) $;

--| An isometry is a homeomorphism on the induced topology. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 12-Sep-2015.)
theorem ismtyhmeo (J K M N X Y: class):
  $ wceq J (cfv M cmopn) $ >
  $ wceq K (cfv N cmopn) $ >
  $ wi (wa (wcel M (cfv X cxmet)) (wcel N (cfv Y cxmet))) (wss (co M N cismty) (co J K chmeo)) $;

--| Lemma for ~ ismtybnd . (Contributed by Jeff Madsen, 2-Sep-2009.) (Proof shortened by Mario Carneiro, 19-Jan-2014.)
theorem ismtybndlem (F M N X Y: class):
  $ wi (wa (wcel N (cfv Y cxmet)) (wcel F (co M N cismty))) (wi (wcel M (cfv X cbnd)) (wcel N (cfv Y cbnd))) $;

--| Isometries preserve boundedness. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 19-Jan-2014.)
theorem ismtybnd (F M N X Y: class):
  $ wi (w3a (wcel M (cfv X cxmet)) (wcel N (cfv Y cxmet)) (wcel F (co M N cismty))) (wb (wcel M (cfv X cbnd)) (wcel N (cfv Y cbnd))) $;

--| A restriction of an isometry is an isometry. The condition ` A C_ X ` is not necessary but makes the proof easier. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 12-Sep-2015.)
theorem ismtyres (A2 B2 S T F M N X Y: class):
  $ wceq B2 (cima F A2) $ >
  $ wceq S (cres M (cxp A2 A2)) $ >
  $ wceq T (cres N (cxp B2 B2)) $ >
  $ wi (wa (wa (wcel M (cfv X cxmet)) (wcel N (cfv Y cxmet))) (wa (wcel F (co M N cismty)) (wss A2 X))) (wcel (cres F A2) (co S T cismty)) $;

--| Lemma for ~ heibor1 . A compact metric space is complete. This proof works by considering the collection ` cls ( F " ( ZZ>= `` n ) ) ` for each ` n e. NN ` , which has the finite intersection property because any finite intersection of upper integer sets is another upper integer set, so any finite intersection of the image closures will contain ` ( F " ( ZZ>= `` m ) ) ` for some ` m ` . Thus, by compactness, the intersection contains a point ` y ` , which must then be the convergent point of ` F ` . (Contributed by Jeff Madsen, 17-Jan-2014.) (Revised by Mario Carneiro, 5-Jun-2014.)
theorem heibor1lem (ph: wff) (D F J X: class):
  $ wceq J (cfv D cmopn) $ >
  $ wi ph (wcel D (cfv X cmet)) $ >
  $ wi ph (wcel J ccmp) $ >
  $ wi ph (wcel F (cfv D ccau)) $ >
  $ wi ph (wf cn X F) $ >
  $ wi ph (wcel F (cdm (cfv J clm))) $;

--| One half of ~ heibor , that does not require any Choice. A compact metric space is complete and totally bounded. We prove completeness in ~ cmpcmet and total boundedness here, which follows trivially from the fact that the set of all ` r ` -balls is an open cover of ` X ` , so finitely many cover ` X ` . (Contributed by Jeff Madsen, 16-Jan-2014.)
theorem heibor1 (D J X: class):
  $ wceq J (cfv D cmopn) $ >
  $ wi (wa (wcel D (cfv X cmet)) (wcel J ccmp)) (wa (wcel D (cfv X ccmet)) (wcel D (cfv X ctotbnd))) $;

--| Lemma for ~ heibor . We work with a fixed open cover ` U ` throughout. The set ` K ` is the set of all subsets of ` X ` that admit no finite subcover of ` U ` . (We wish to prove that ` K ` is empty.) If a set ` C ` has no finite subcover, then any finite cover of ` C ` must contain a set that also has no finite subcover. (Contributed by Jeff Madsen, 23-Jan-2014.)
theorem heiborlem1 {x3 v u: setvar} (A2: class v u) (B2 C: class x3) (D U J: class) (K: class v u):
  $ wceq J (cfv D cmopn) $ >
  $ wceq K (cab u (wn (wrex v (wss (cv u) (cuni (cv v))) (cin (cpw U) cfn)))) $ >
  $ wcel B2 cvv $ >
  $ wi (w3a (wcel A2 cfn) (wss C (ciun x3 A2 B2)) (wcel C K)) (wrex x3 (wcel B2 K) A2) $;

--| Lemma for ~ heibor . Substitutions for the set ` G ` . (Contributed by Jeff Madsen, 23-Jan-2014.)
theorem heiborlem2 {y1 v u n: setvar} (A2: class v u) (B2 C D U: class) (F: class v) (G: class y1 v u n) (J: class) (K: class v u):
  $ wceq J (cfv D cmopn) $ >
  $ wceq K (cab u (wn (wrex v (wss (cv u) (cuni (cv v))) (cin (cpw U) cfn)))) $ >
  $ wceq G (copab y1 n (w3a (wcel (cv n) cn0) (wcel (cv y1) (cfv (cv n) F)) (wcel (co (cv y1) (cv n) B2) K))) $ >
  $ wcel A2 cvv $ >
  $ wcel C cvv $ >
  $ wb (wbr A2 C G) (w3a (wcel C cn0) (wcel A2 (cfv C F)) (wcel (co A2 C B2) K)) $;

--| Lemma for ~ heibor . Using countable choice ~ ax-cc , we have fixed in advance a collection of finite ` 2 ^ -u n ` nets ` ( F `` n ) ` for ` X ` (note that an ` r ` -net is a set of points in ` X ` whose ` r ` -balls cover ` X ` ). The set ` G ` is the subset of these points whose corresponding balls have no finite subcover (i.e. in the set ` K ` ). If the theorem was false, then ` X ` would be in ` K ` , and so some ball at each level would also be in ` K ` . But we can say more than this; given a ball ` ( y B n ) ` on level ` n ` , since level ` n + 1 ` covers the space and thus also ` ( y B n ) ` , using ~ heiborlem1 there is a ball on the next level whose intersection with ` ( y B n ) ` also has no finite subcover. Now since the set ` G ` is a countable union of finite sets, it is countable (which needs ~ ax-cc via ~ iunctb ), and so we can apply ~ ax-cc to ` G ` directly to get a function from ` G ` to itself, which points from each ball in ` K ` to a ball on the next level in ` K ` , and such that the intersection between these balls is also in ` K ` . (Contributed by Jeff Madsen, 18-Jan-2014.)
theorem heiborlem3 {x3 y1 z v u g2 m n: setvar} (ph: wff y1 z v u m n) (B2: class z m) (D: class) (U: class m) (F: class z v g2 m) (G: class y1 z v u m n) (J: class) (K: class v u m) (X: class):
  $ wceq J (cfv D cmopn) $ >
  $ wceq K (cab u (wn (wrex v (wss (cv u) (cuni (cv v))) (cin (cpw U) cfn)))) $ >
  $ wceq G (copab y1 n (w3a (wcel (cv n) cn0) (wcel (cv y1) (cfv (cv n) F)) (wcel (co (cv y1) (cv n) B2) K))) $ >
  $ wceq B2 (cmpo z m X cn0 (co (cv z) (co c1 (co c2 (cv m) cexp) cdiv) (cfv D cbl))) $ >
  $ wi ph (wcel D (cfv X ccmet)) $ >
  $ wi ph (wf cn0 (cin (cpw X) cfn) F) $ >
  $ wi ph (wral n (wceq X (ciun y1 (cfv (cv n) F) (co (cv y1) (cv n) B2))) cn0) $ >
  $ wi ph (wex g2 (wral x3 (wa (wbr (cfv (cv x3) (cv g2)) (co (cfv (cv x3) c2nd) c1 caddc) G) (wcel (cin (cfv (cv x3) B2) (co (cfv (cv x3) (cv g2)) (co (cfv (cv x3) c2nd) c1 caddc) B2)) K)) G)) $;

--| Lemma for ~ heibor . Using the function ` T ` constructed in ~ heiborlem3 , construct an infinite path in ` G ` . (Contributed by Jeff Madsen, 23-Jan-2014.)
theorem heiborlem4 {x3 y1 z v u m n: setvar} (ph: wff y1 z v u m n) (A2: class z v u m) (B2: class z m) (C: class x3 z) (D S: class) (T: class v u) (U: class m) (F: class z v m) (G: class y1 z v u m n) (J: class) (K: class v u m) (X: class):
  $ wceq J (cfv D cmopn) $ >
  $ wceq K (cab u (wn (wrex v (wss (cv u) (cuni (cv v))) (cin (cpw U) cfn)))) $ >
  $ wceq G (copab y1 n (w3a (wcel (cv n) cn0) (wcel (cv y1) (cfv (cv n) F)) (wcel (co (cv y1) (cv n) B2) K))) $ >
  $ wceq B2 (cmpo z m X cn0 (co (cv z) (co c1 (co c2 (cv m) cexp) cdiv) (cfv D cbl))) $ >
  $ wi ph (wcel D (cfv X ccmet)) $ >
  $ wi ph (wf cn0 (cin (cpw X) cfn) F) $ >
  $ wi ph (wral n (wceq X (ciun y1 (cfv (cv n) F) (co (cv y1) (cv n) B2))) cn0) $ >
  $ wi ph (wral x3 (wa (wbr (cfv (cv x3) T) (co (cfv (cv x3) c2nd) c1 caddc) G) (wcel (cin (cfv (cv x3) B2) (co (cfv (cv x3) T) (co (cfv (cv x3) c2nd) c1 caddc) B2)) K)) G) $ >
  $ wi ph (wbr C cc0 G) $ >
  $ wceq S (cseq T (cmpt m cn0 (cif (wceq (cv m) cc0) C (co (cv m) c1 cmin))) cc0) $ >
  $ wi (wa ph (wcel A2 cn0)) (wbr (cfv A2 S) A2 G) $;

--| Lemma for ~ heibor . The function ` M ` is a set of point-and-radius pairs suitable for application to ~ caubl . (Contributed by Jeff Madsen, 23-Jan-2014.)
theorem heiborlem5 {x3 y1 z v u m n: setvar} (ph: wff y1 z v u m n) (B2: class z m) (C: class x3 z) (D S: class) (T: class v u) (U: class m) (F: class z v m) (G: class y1 z v u m n) (J: class) (K: class v u m) (M: class v n) (X: class):
  $ wceq J (cfv D cmopn) $ >
  $ wceq K (cab u (wn (wrex v (wss (cv u) (cuni (cv v))) (cin (cpw U) cfn)))) $ >
  $ wceq G (copab y1 n (w3a (wcel (cv n) cn0) (wcel (cv y1) (cfv (cv n) F)) (wcel (co (cv y1) (cv n) B2) K))) $ >
  $ wceq B2 (cmpo z m X cn0 (co (cv z) (co c1 (co c2 (cv m) cexp) cdiv) (cfv D cbl))) $ >
  $ wi ph (wcel D (cfv X ccmet)) $ >
  $ wi ph (wf cn0 (cin (cpw X) cfn) F) $ >
  $ wi ph (wral n (wceq X (ciun y1 (cfv (cv n) F) (co (cv y1) (cv n) B2))) cn0) $ >
  $ wi ph (wral x3 (wa (wbr (cfv (cv x3) T) (co (cfv (cv x3) c2nd) c1 caddc) G) (wcel (cin (cfv (cv x3) B2) (co (cfv (cv x3) T) (co (cfv (cv x3) c2nd) c1 caddc) B2)) K)) G) $ >
  $ wi ph (wbr C cc0 G) $ >
  $ wceq S (cseq T (cmpt m cn0 (cif (wceq (cv m) cc0) C (co (cv m) c1 cmin))) cc0) $ >
  $ wceq M (cmpt n cn (cop (cfv (cv n) S) (co c3 (co c2 (cv n) cexp) cdiv))) $ >
  $ wi ph (wf cn (cxp X crp) M) $;

--| Lemma for ~ heibor . Since the sequence of balls connected by the function ` T ` ensures that each ball nontrivially intersects with the next (since the empty set has a finite subcover, the intersection of any two successive balls in the sequence is nonempty), and each ball is half the size of the previous one, the distance between the centers is at most ` 3 / 2 ` times the size of the larger, and so if we expand each ball by a factor of ` 3 ` we get a nested sequence of balls. (Contributed by Jeff Madsen, 23-Jan-2014.)
theorem heiborlem6 {x3 y1 z v u k m n: setvar} (ph: wff y1 z v u m n) (B2: class z k m) (C: class x3 z k) (D S: class) (T: class v u k) (U: class k m) (F: class z v m) (G: class y1 z v u m n) (J: class) (K: class v u k m) (M: class v n) (X: class):
  $ wceq J (cfv D cmopn) $ >
  $ wceq K (cab u (wn (wrex v (wss (cv u) (cuni (cv v))) (cin (cpw U) cfn)))) $ >
  $ wceq G (copab y1 n (w3a (wcel (cv n) cn0) (wcel (cv y1) (cfv (cv n) F)) (wcel (co (cv y1) (cv n) B2) K))) $ >
  $ wceq B2 (cmpo z m X cn0 (co (cv z) (co c1 (co c2 (cv m) cexp) cdiv) (cfv D cbl))) $ >
  $ wi ph (wcel D (cfv X ccmet)) $ >
  $ wi ph (wf cn0 (cin (cpw X) cfn) F) $ >
  $ wi ph (wral n (wceq X (ciun y1 (cfv (cv n) F) (co (cv y1) (cv n) B2))) cn0) $ >
  $ wi ph (wral x3 (wa (wbr (cfv (cv x3) T) (co (cfv (cv x3) c2nd) c1 caddc) G) (wcel (cin (cfv (cv x3) B2) (co (cfv (cv x3) T) (co (cfv (cv x3) c2nd) c1 caddc) B2)) K)) G) $ >
  $ wi ph (wbr C cc0 G) $ >
  $ wceq S (cseq T (cmpt m cn0 (cif (wceq (cv m) cc0) C (co (cv m) c1 cmin))) cc0) $ >
  $ wceq M (cmpt n cn (cop (cfv (cv n) S) (co c3 (co c2 (cv n) cexp) cdiv))) $ >
  $ wi ph (wral k (wss (cfv (cfv (co (cv k) c1 caddc) M) (cfv D cbl)) (cfv (cfv (cv k) M) (cfv D cbl))) cn) $;

--| Lemma for ~ heibor . Since the sizes of the balls decrease exponentially, the sequence converges to zero. (Contributed by Jeff Madsen, 23-Jan-2014.)
theorem heiborlem7 {x3 y1 z v u k m n r: setvar} (ph: wff y1 z v u m n) (B2: class z k m r) (C: class x3 z k r) (D: class) (S: class r) (T: class v u k r) (U: class k m r) (F: class z v m) (G: class y1 z v u m n r) (J: class) (K: class v u k m r) (M: class v n) (X: class):
  $ wceq J (cfv D cmopn) $ >
  $ wceq K (cab u (wn (wrex v (wss (cv u) (cuni (cv v))) (cin (cpw U) cfn)))) $ >
  $ wceq G (copab y1 n (w3a (wcel (cv n) cn0) (wcel (cv y1) (cfv (cv n) F)) (wcel (co (cv y1) (cv n) B2) K))) $ >
  $ wceq B2 (cmpo z m X cn0 (co (cv z) (co c1 (co c2 (cv m) cexp) cdiv) (cfv D cbl))) $ >
  $ wi ph (wcel D (cfv X ccmet)) $ >
  $ wi ph (wf cn0 (cin (cpw X) cfn) F) $ >
  $ wi ph (wral n (wceq X (ciun y1 (cfv (cv n) F) (co (cv y1) (cv n) B2))) cn0) $ >
  $ wi ph (wral x3 (wa (wbr (cfv (cv x3) T) (co (cfv (cv x3) c2nd) c1 caddc) G) (wcel (cin (cfv (cv x3) B2) (co (cfv (cv x3) T) (co (cfv (cv x3) c2nd) c1 caddc) B2)) K)) G) $ >
  $ wi ph (wbr C cc0 G) $ >
  $ wceq S (cseq T (cmpt m cn0 (cif (wceq (cv m) cc0) C (co (cv m) c1 cmin))) cc0) $ >
  $ wceq M (cmpt n cn (cop (cfv (cv n) S) (co c3 (co c2 (cv n) cexp) cdiv))) $ >
  $ wral r (wrex k (wbr (cfv (cfv (cv k) M) c2nd) (cv r) clt) cn) crp $;

--| Lemma for ~ heibor . The previous lemmas establish that the sequence ` M ` is Cauchy, so using completeness we now consider the convergent point ` Y ` . By assumption, ` U ` is an open cover, so ` Y ` is an element of some ` Z e. U ` , and some ball centered at ` Y ` is contained in ` Z ` . But the sequence contains arbitrarily small balls close to ` Y ` , so some element ` ball ( M `` n ) ` of the sequence is contained in ` Z ` . And finally we arrive at a contradiction, because ` { Z } ` is a finite subcover of ` U ` that covers ` ball ( M `` n ) ` , yet ` ball ( M `` n ) e. K ` . For convenience, we write this contradiction as ` ph -> ps ` where ` ph ` is all the accumulated hypotheses and ` ps ` is anything at all. (Contributed by Jeff Madsen, 22-Jan-2014.)
theorem heiborlem8 {x3 y1 z v u m n: setvar} (ph: wff y1 z v u m n) (ps: wff x3 v u m n) (B2: class z m) (C: class x3 z) (D S: class) (T: class v u) (U: class m) (F: class z v m) (G: class y1 z v u m n) (J: class) (K: class v u m) (M: class v n) (X: class) (Y: class y1 z v u m n) (Z: class y1 z u m n):
  $ wceq J (cfv D cmopn) $ >
  $ wceq K (cab u (wn (wrex v (wss (cv u) (cuni (cv v))) (cin (cpw U) cfn)))) $ >
  $ wceq G (copab y1 n (w3a (wcel (cv n) cn0) (wcel (cv y1) (cfv (cv n) F)) (wcel (co (cv y1) (cv n) B2) K))) $ >
  $ wceq B2 (cmpo z m X cn0 (co (cv z) (co c1 (co c2 (cv m) cexp) cdiv) (cfv D cbl))) $ >
  $ wi ph (wcel D (cfv X ccmet)) $ >
  $ wi ph (wf cn0 (cin (cpw X) cfn) F) $ >
  $ wi ph (wral n (wceq X (ciun y1 (cfv (cv n) F) (co (cv y1) (cv n) B2))) cn0) $ >
  $ wi ph (wral x3 (wa (wbr (cfv (cv x3) T) (co (cfv (cv x3) c2nd) c1 caddc) G) (wcel (cin (cfv (cv x3) B2) (co (cfv (cv x3) T) (co (cfv (cv x3) c2nd) c1 caddc) B2)) K)) G) $ >
  $ wi ph (wbr C cc0 G) $ >
  $ wceq S (cseq T (cmpt m cn0 (cif (wceq (cv m) cc0) C (co (cv m) c1 cmin))) cc0) $ >
  $ wceq M (cmpt n cn (cop (cfv (cv n) S) (co c3 (co c2 (cv n) cexp) cdiv))) $ >
  $ wi ph (wss U J) $ >
  $ wcel Y cvv $ >
  $ wi ph (wcel Y Z) $ >
  $ wi ph (wcel Z U) $ >
  $ wi ph (wbr (ccom c1st M) Y (cfv J clm)) $ >
  $ wi ph ps $;

--| Lemma for ~ heibor . Discharge the hypotheses of ~ heiborlem8 by applying ~ caubl to get a convergent point and adding the open cover assumption. (Contributed by Jeff Madsen, 20-Jan-2014.)
theorem heiborlem9 {x3 y1 z v u m n: setvar} (ph: wff y1 z v u m n) (ps: wff x3 v u m n) (B2: class z m) (C: class x3 z) (D S: class) (T: class v u) (U: class m) (F: class z v m) (G: class y1 z v u m n) (J: class) (K: class v u m) (M: class v n) (X: class):
  $ wceq J (cfv D cmopn) $ >
  $ wceq K (cab u (wn (wrex v (wss (cv u) (cuni (cv v))) (cin (cpw U) cfn)))) $ >
  $ wceq G (copab y1 n (w3a (wcel (cv n) cn0) (wcel (cv y1) (cfv (cv n) F)) (wcel (co (cv y1) (cv n) B2) K))) $ >
  $ wceq B2 (cmpo z m X cn0 (co (cv z) (co c1 (co c2 (cv m) cexp) cdiv) (cfv D cbl))) $ >
  $ wi ph (wcel D (cfv X ccmet)) $ >
  $ wi ph (wf cn0 (cin (cpw X) cfn) F) $ >
  $ wi ph (wral n (wceq X (ciun y1 (cfv (cv n) F) (co (cv y1) (cv n) B2))) cn0) $ >
  $ wi ph (wral x3 (wa (wbr (cfv (cv x3) T) (co (cfv (cv x3) c2nd) c1 caddc) G) (wcel (cin (cfv (cv x3) B2) (co (cfv (cv x3) T) (co (cfv (cv x3) c2nd) c1 caddc) B2)) K)) G) $ >
  $ wi ph (wbr C cc0 G) $ >
  $ wceq S (cseq T (cmpt m cn0 (cif (wceq (cv m) cc0) C (co (cv m) c1 cmin))) cc0) $ >
  $ wceq M (cmpt n cn (cop (cfv (cv n) S) (co c3 (co c2 (cv n) cexp) cdiv))) $ >
  $ wi ph (wss U J) $ >
  $ wi ph (wceq (cuni U) X) $ >
  $ wi ph ps $;

--| Lemma for ~ heibor . The last remaining piece of the proof is to find an element ` C ` such that ` C G 0 ` , i.e. ` C ` is an element of ` ( F `` 0 ) ` that has no finite subcover, which is true by ~ heiborlem1 , since ` ( F `` 0 ) ` is a finite cover of ` X ` , which has no finite subcover. Thus, the rest of the proof follows to a contradiction, and thus there must be a finite subcover of ` U ` that covers ` X ` , i.e. ` X ` is compact. (Contributed by Jeff Madsen, 22-Jan-2014.)
theorem heiborlem10 {y1 z v u m n: setvar} (ph: wff y1 z u m n) (B2: class z m) (D: class) (U: class m) (F: class z v m) (G: class y1 z v u m n) (J: class) (K: class v u m) (X: class):
  $ wceq J (cfv D cmopn) $ >
  $ wceq K (cab u (wn (wrex v (wss (cv u) (cuni (cv v))) (cin (cpw U) cfn)))) $ >
  $ wceq G (copab y1 n (w3a (wcel (cv n) cn0) (wcel (cv y1) (cfv (cv n) F)) (wcel (co (cv y1) (cv n) B2) K))) $ >
  $ wceq B2 (cmpo z m X cn0 (co (cv z) (co c1 (co c2 (cv m) cexp) cdiv) (cfv D cbl))) $ >
  $ wi ph (wcel D (cfv X ccmet)) $ >
  $ wi ph (wf cn0 (cin (cpw X) cfn) F) $ >
  $ wi ph (wral n (wceq X (ciun y1 (cfv (cv n) F) (co (cv y1) (cv n) B2))) cn0) $ >
  $ wi (wa ph (wa (wss U J) (wceq (cuni J) (cuni U)))) (wrex v (wceq (cuni J) (cuni (cv v))) (cin (cpw U) cfn)) $;

--| Generalized Heine-Borel Theorem. A metric space is compact iff it is complete and totally bounded. See ~ heibor1 and ~ heiborlem1 for a description of the proof. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 28-Jan-2014.)
theorem heibor (D J X: class):
  $ wceq J (cfv D cmopn) $ >
  $ wb (wa (wcel D (cfv X cmet)) (wcel J ccmp)) (wa (wcel D (cfv X ccmet)) (wcel D (cfv X ctotbnd))) $;

--| Lemma for ~ bfp . The sequence ` G ` , which simply starts from any point in the space and iterates ` F ` , satisfies the property that the distance from ` G ( n ) ` to ` G ( n + 1 ) ` decreases by at least ` K ` after each step. Thus, the total distance from any ` G ( i ) ` to ` G ( j ) ` is bounded by a geometric series, and the sequence is Cauchy. Therefore, it converges to a point ` ( ( ~~>t `` J ) `` G ) ` since the space is complete. (Contributed by Jeff Madsen, 17-Jun-2014.)
theorem bfplem1 {x3 y1: setvar} (ph: wff) (A2: class x3 y1) (D F G J K X: class):
  $ wi ph (wcel D (cfv X ccmet)) $ >
  $ wi ph (wne X c0) $ >
  $ wi ph (wcel K crp) $ >
  $ wi ph (wbr K c1 clt) $ >
  $ wi ph (wf X X F) $ >
  $ wi (wa ph (wa (wcel (cv x3) X) (wcel (cv y1) X))) (wbr (co (cfv (cv x3) F) (cfv (cv y1) F) D) (co K (co (cv x3) (cv y1) D) cmul) cle) $ >
  $ wceq J (cfv D cmopn) $ >
  $ wi ph (wcel A2 X) $ >
  $ wceq G (cseq (ccom F c1st) (cxp cn (csn A2)) c1) $ >
  $ wi ph (wbr G (cfv G (cfv J clm)) (cfv J clm)) $;

--| Lemma for ~ bfp . Using the point found in ~ bfplem1 , we show that this convergent point is a fixed point of ` F ` . Since for any positive ` x ` , the sequence ` G ` is in ` B ( x / 2 , P ) ` for all ` k e. ( ZZ>= `` j ) ` (where ` P = ( ( ~~>t `` J ) `` G ) ` ), we have ` D ( G ( j + 1 ) , F ( P ) ) <_ D ( G ( j ) , P ) < x / 2 ` and ` D ( G ( j + 1 ) , P ) < x / 2 ` , so ` F ( P ) ` is in every neighborhood of ` P ` and ` P ` is a fixed point of ` F ` . (Contributed by Jeff Madsen, 5-Jun-2014.)
theorem bfplem2 {x3 y1 z: setvar} (ph: wff z) (A2: class x3 y1 z) (D F G J: class) (K: class z) (X: class):
  $ wi ph (wcel D (cfv X ccmet)) $ >
  $ wi ph (wne X c0) $ >
  $ wi ph (wcel K crp) $ >
  $ wi ph (wbr K c1 clt) $ >
  $ wi ph (wf X X F) $ >
  $ wi (wa ph (wa (wcel (cv x3) X) (wcel (cv y1) X))) (wbr (co (cfv (cv x3) F) (cfv (cv y1) F) D) (co K (co (cv x3) (cv y1) D) cmul) cle) $ >
  $ wceq J (cfv D cmopn) $ >
  $ wi ph (wcel A2 X) $ >
  $ wceq G (cseq (ccom F c1st) (cxp cn (csn A2)) c1) $ >
  $ wi ph (wrex z (wceq (cfv (cv z) F) (cv z)) X) $;

--| Banach fixed point theorem, also known as contraction mapping theorem. A contraction on a complete metric space has a unique fixed point. We show existence in the lemmas, and uniqueness here - if ` F ` has two fixed points, then the distance between them is less than ` K ` times itself, a contradiction. (Contributed by Jeff Madsen, 2-Sep-2009.) (Proof shortened by Mario Carneiro, 5-Jun-2014.)
theorem bfp {x3 y1 z: setvar} (ph: wff z) (D F: class) (K: class z) (X: class):
  $ wi ph (wcel D (cfv X ccmet)) $ >
  $ wi ph (wne X c0) $ >
  $ wi ph (wcel K crp) $ >
  $ wi ph (wbr K c1 clt) $ >
  $ wi ph (wf X X F) $ >
  $ wi (wa ph (wa (wcel (cv x3) X) (wcel (cv y1) X))) (wbr (co (cfv (cv x3) F) (cfv (cv y1) F) D) (co K (co (cv x3) (cv y1) D) cmul) cle) $ >
  $ wi ph (wreu z (wceq (cfv (cv z) F) (cv z)) X) $;

--| Extend class notation with the n-dimensional Euclidean space.
term crrn: class;

--| Define n-dimensional Euclidean space as a metric space with the standard Euclidean norm given by the quadratic mean. (Contributed by Jeff Madsen, 2-Sep-2009.)
axiom df_rrn {x3 y1 i k: setvar}:
  $ wceq crrn (cmpt i cfn (cmpo x3 y1 (co cr (cv i) cmap) (co cr (cv i) cmap) (cfv (csu k (cv i) (co (co (cfv (cv k) (cv x3)) (cfv (cv k) (cv y1)) cmin) c2 cexp)) csqrt))) $;

--| The n-dimensional Euclidean space. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 13-Sep-2015.)
theorem rrnval {x3 y1 k: setvar} (I X: class):
  $ wceq X (co cr I cmap) $ >
  $ wi (wcel I cfn) (wceq (cfv I crrn) (cmpo x3 y1 X X (cfv (csu k I (co (co (cfv (cv k) (cv x3)) (cfv (cv k) (cv y1)) cmin) c2 cexp)) csqrt))) $;

--| The value of the Euclidean metric. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 13-Sep-2015.)
theorem rrnmval {k: setvar} (F G I X: class):
  $ wceq X (co cr I cmap) $ >
  $ wi (w3a (wcel I cfn) (wcel F X) (wcel G X)) (wceq (co F G (cfv I crrn)) (cfv (csu k I (co (co (cfv (cv k) F) (cfv (cv k) G) cmin) c2 cexp)) csqrt)) $;

--| Euclidean space is a metric space. (Contributed by Jeff Madsen, 2-Sep-2009.) (Proof shortened by Mario Carneiro, 5-Jun-2014.)
theorem rrnmet (I X: class):
  $ wceq X (co cr I cmap) $ >
  $ wi (wcel I cfn) (wcel (cfv I crrn) (cfv X cmet)) $;

--| The distance between two points in Euclidean space is greater than the distance between the projections onto one coordinate. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 13-Sep-2015.)
theorem rrndstprj1 (A2 F G I M X: class):
  $ wceq X (co cr I cmap) $ >
  $ wceq M (cres (ccom cabs cmin) (cxp cr cr)) $ >
  $ wi (wa (wa (wcel I cfn) (wcel A2 I)) (wa (wcel F X) (wcel G X))) (wbr (co (cfv A2 F) (cfv A2 G) M) (co F G (cfv I crrn)) cle) $;

--| Bound on the distance between two points in Euclidean space given bounds on the distances in each coordinate. This theorem and ~ rrndstprj1 can be used to show that the supremum norm and Euclidean norm are equivalent. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 13-Sep-2015.)
theorem rrndstprj2 {n: setvar} (R F G I M: class) (X: class n):
  $ wceq X (co cr I cmap) $ >
  $ wceq M (cres (ccom cabs cmin) (cxp cr cr)) $ >
  $ wi (wa (w3a (wcel I (cdif cfn (csn c0))) (wcel F X) (wcel G X)) (wa (wcel R crp) (wral n (wbr (co (cfv (cv n) F) (cfv (cv n) G) M) R clt) I))) (wbr (co F G (cfv I crrn)) (co R (cfv (cfv I chash) csqrt) cmul) clt) $;

--| Lemma for ~ rrncms . (Contributed by Jeff Madsen, 6-Jun-2014.) (Revised by Mario Carneiro, 13-Sep-2015.)
theorem rrncmslem {t m: setvar} (ph: wff t m) (P: class t m) (F: class) (I: class t) (J M X: class t m):
  $ wceq X (co cr I cmap) $ >
  $ wceq M (cres (ccom cabs cmin) (cxp cr cr)) $ >
  $ wceq J (cfv (cfv I crrn) cmopn) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wcel F (cfv (cfv I crrn) ccau)) $ >
  $ wi ph (wf cn X F) $ >
  $ wceq P (cmpt m I (cfv (cmpt t cn (cfv (cv m) (cfv (cv t) F))) cli)) $ >
  $ wi ph (wcel F (cdm (cfv J clm))) $;

--| Euclidean space is complete. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 13-Sep-2015.)
theorem rrncms (I X: class):
  $ wceq X (co cr I cmap) $ >
  $ wi (wcel I cfn) (wcel (cfv I crrn) (cfv X ccmet)) $;

--| The supremum metric on ` RR ^ I ` is a metric. (Contributed by Jeff Madsen, 15-Sep-2015.)
theorem repwsmet (D I X Y: class):
  $ wceq Y (co (co ccnfld cr cress) I cpws) $ >
  $ wceq D (cfv Y cds) $ >
  $ wceq X (co cr I cmap) $ >
  $ wi (wcel I cfn) (wcel D (cfv X cmet)) $;

--| The supremum metric on ` RR ^ I ` is equivalent to the ` Rn ` metric. (Contributed by Jeff Madsen, 15-Sep-2015.)
theorem rrnequiv (ph: wff) (D F G I X Y: class):
  $ wceq Y (co (co ccnfld cr cress) I cpws) $ >
  $ wceq D (cfv Y cds) $ >
  $ wceq X (co cr I cmap) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi (wa ph (wa (wcel F X) (wcel G X))) (wa (wbr (co F G D) (co F G (cfv I crrn)) cle) (wbr (co F G (cfv I crrn)) (co (cfv (cfv I chash) csqrt) (co F G D) cmul) cle)) $;

--| A set in Euclidean space is totally bounded iff its is bounded. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 16-Sep-2015.)
theorem rrntotbnd (I M X Y: class):
  $ wceq X (co cr I cmap) $ >
  $ wceq M (cres (cfv I crrn) (cxp Y Y)) $ >
  $ wi (wcel I cfn) (wb (wcel M (cfv Y ctotbnd)) (wcel M (cfv Y cbnd))) $;

--| Heine-Borel theorem for Euclidean space. A subset of Euclidean space is compact iff it is closed and bounded. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 22-Sep-2015.)
theorem rrnheibor (T U I M X Y: class):
  $ wceq X (co cr I cmap) $ >
  $ wceq M (cres (cfv I crrn) (cxp Y Y)) $ >
  $ wceq T (cfv M cmopn) $ >
  $ wceq U (cfv (cfv I crrn) cmopn) $ >
  $ wi (wa (wcel I cfn) (wss Y X)) (wb (wcel T ccmp) (wa (wcel Y (cfv U ccld)) (wcel M (cfv Y cbnd)))) $;

--| An isometry between ` RR ` and ` RR ^ 1 ` . (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 22-Sep-2015.)
theorem ismrer1 {x3: setvar} (A2: class) (R F V: class x3):
  $ wceq R (cres (ccom cabs cmin) (cxp cr cr)) $ >
  $ wceq F (cmpt x3 cr (cxp (csn A2) (csn (cv x3)))) $ >
  $ wi (wcel A2 V) (wcel F (co R (cfv (csn A2) crrn) cismty)) $;

--| Heine-Borel theorem for real numbers. A subset of ` RR ` is compact iff it is closed and bounded. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 22-Sep-2015.)
theorem reheibor (T U M Y: class):
  $ wceq M (cres (ccom cabs cmin) (cxp Y Y)) $ >
  $ wceq T (cfv M cmopn) $ >
  $ wceq U (cfv (crn cioo) ctg) $ >
  $ wi (wss Y cr) (wb (wcel T ccmp) (wa (wcel Y (cfv U ccld)) (wcel M (cfv Y cbnd)))) $;

--| A closed interval in ` RR ` is bounded. (Contributed by Jeff Madsen, 2-Sep-2009.) (Proof shortened by Mario Carneiro, 22-Sep-2015.)
theorem iccbnd (A2 B2 J M: class):
  $ wceq J (co A2 B2 cicc) $ >
  $ wceq M (cres (ccom cabs cmin) (cxp J J)) $ >
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wcel M (cfv J cbnd)) $;

--| A closed interval in ` RR ` is compact. Alternate proof of ~ icccmp using the Heine-Borel theorem ~ heibor . (Contributed by Jeff Madsen, 2-Sep-2009.) (Proof shortened by Mario Carneiro, 14-Aug-2014.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem icccmpALT (A2 B2 T J M: class):
  $ wceq J (co A2 B2 cicc) $ >
  $ wceq M (cres (ccom cabs cmin) (cxp J J)) $ >
  $ wceq T (cfv M cmopn) $ >
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wcel T ccmp) $;

--| Extend class notation with a device to add associativity to internal operations.
term cass: class;

--| A device to add associativity to various sorts of internal operations. The definition is meaningful when ` g ` is a magma at least. (Contributed by FL, 1-Nov-2009.) (New usage is discouraged.)
axiom df_ass {x3 y1 z g2: setvar}:
  $ wceq cass (cab g2 (wral x3 (wral y1 (wral z (wceq (co (co (cv x3) (cv y1) (cv g2)) (cv z) (cv g2)) (co (cv x3) (co (cv y1) (cv z) (cv g2)) (cv g2))) (cdm (cdm (cv g2)))) (cdm (cdm (cv g2)))) (cdm (cdm (cv g2))))) $;

--| Extend class notation with the class of all the internal operations with an identity element.
term cexid: class;

--| A device to add an identity element to various sorts of internal operations. (Contributed by FL, 2-Nov-2009.) (New usage is discouraged.)
axiom df_exid {x3 y1 g2: setvar}:
  $ wceq cexid (cab g2 (wrex x3 (wral y1 (wa (wceq (co (cv x3) (cv y1) (cv g2)) (cv y1)) (wceq (co (cv y1) (cv x3) (cv g2)) (cv y1))) (cdm (cdm (cv g2)))) (cdm (cdm (cv g2))))) $;

--| The predicate "is an associative operation". (Contributed by FL, 1-Nov-2009.) (New usage is discouraged.)
theorem isass {x3 y1 z: setvar} (A2: class x3 y1 z) (G X: class):
  $ wceq X (cdm (cdm G)) $ >
  $ wi (wcel G A2) (wb (wcel G cass) (wral x3 (wral y1 (wral z (wceq (co (co (cv x3) (cv y1) G) (cv z) G) (co (cv x3) (co (cv y1) (cv z) G) G)) X) X) X)) $;

--| The predicate ` G ` has a left and right identity element. (Contributed by FL, 2-Nov-2009.) (Revised by Mario Carneiro, 22-Dec-2013.) (New usage is discouraged.)
theorem isexid {x3 y1: setvar} (A2: class x3 y1) (G X: class):
  $ wceq X (cdm (cdm G)) $ >
  $ wi (wcel G A2) (wb (wcel G cexid) (wrex x3 (wral y1 (wa (wceq (co (cv x3) (cv y1) G) (cv y1)) (wceq (co (cv y1) (cv x3) G) (cv y1))) X) X)) $;

--| Extend class notation with the class of all magmas.
term cmagm: class;

--| Obsolete version of ~ df-mgm as of 3-Feb-2020. A magma is a binary internal operation. (Contributed by FL, 2-Nov-2009.) (New usage is discouraged.)
axiom df_mgmOLD {t g2: setvar}:
  $ wceq cmagm (cab g2 (wex t (wf (cxp (cv t) (cv t)) (cv t) (cv g2)))) $;

--| Obsolete version of ~ ismgm as of 3-Feb-2020. The predicate "is a magma". (Contributed by FL, 2-Nov-2009.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem ismgmOLD (A2 G X: class):
  $ wceq X (cdm (cdm G)) $ >
  $ wi (wcel G A2) (wb (wcel G cmagm) (wf (cxp X X) X G)) $;

--| Obsolete version of ~ mgmcl as of 3-Feb-2020. Closure of a magma. (Contributed by FL, 14-Sep-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem clmgmOLD (A2 B2 G X: class):
  $ wceq X (cdm (cdm G)) $ >
  $ wi (w3a (wcel G cmagm) (wcel A2 X) (wcel B2 X)) (wcel (co A2 B2 G) X) $;

--| Obsolete version of ~ mgmidpfod as of 23-Jan-2020. An operation with a left and right identity element is onto. (Contributed by FL, 2-Nov-2009.) (Revised by Mario Carneiro, 22-Dec-2013.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem opidonOLD (G X: class):
  $ wceq X (cdm (cdm G)) $ >
  $ wi (wcel G (cin cmagm cexid)) (wfo (cxp X X) X G) $;

--| Obsolete version of ~ mgmidprnd as of 23-Jan-2020. Range of an operation with a left and right identity element. (Contributed by FL, 2-Nov-2009.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngopidOLD (G: class):
  $ wi (wcel G (cin cmagm cexid)) (wceq (crn G) (cdm (cdm G))) $;

--| Obsolete version of ~ mgmfod as of 23-Jan-2020. An operation with a left and right identity element is onto. (Contributed by FL, 2-Nov-2009.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem opidon2OLD (G X: class):
  $ wceq X (crn G) $ >
  $ wi (wcel G (cin cmagm cexid)) (wfo (cxp X X) X G) $;

--| Obsolete theorem. If ` G e. ( Magma i^i ExId ) ` , then it has a left and right identity element that belongs to the range of the operation. (Contributed by FL, 12-Dec-2009.) (Revised by Mario Carneiro, 22-Dec-2013.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem isexid2 {x3 u: setvar} (G X: class):
  $ wceq X (crn G) $ >
  $ wi (wcel G (cin cmagm cexid)) (wrex u (wral x3 (wa (wceq (co (cv u) (cv x3) G) (cv x3)) (wceq (co (cv x3) (cv u) G) (cv x3))) X) X) $;

--| Obsolete theorem, use ~ mgmidmo or ~ mndideu instead. Uniqueness of the left and right identity element of a magma when it exists. (Contributed by FL, 12-Dec-2009.) (Revised by Mario Carneiro, 22-Dec-2013.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem exidu1 {x3 u: setvar} (G X: class):
  $ wceq X (crn G) $ >
  $ wi (wcel G (cin cmagm cexid)) (wreu u (wral x3 (wa (wceq (co (cv u) (cv x3) G) (cv x3)) (wceq (co (cv x3) (cv u) G) (cv x3))) X) X) $;

--| Obsolete theorem, use ~ idvalriota instead. The value of the identity element. (Contributed by FL, 12-Dec-2009.) (Revised by Mario Carneiro, 22-Dec-2013.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem idrval {x3 u: setvar} (A2 U: class x3 u) (G X: class):
  $ wceq X (crn G) $ >
  $ wceq U (cfv G cgi) $ >
  $ wi (wcel G A2) (wceq U (crio u (wral x3 (wa (wceq (co (cv u) (cv x3) G) (cv x3)) (wceq (co (cv x3) (cv u) G) (cv x3))) X) X)) $;

--| Obsolete theorem, use ~ mgmidcl instead. A magma right and left identity belongs to the underlying set of the operation. (Contributed by FL, 12-Dec-2009.) (Revised by Mario Carneiro, 22-Dec-2013.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem iorlid (U G X: class):
  $ wceq X (crn G) $ >
  $ wceq U (cfv G cgi) $ >
  $ wi (wcel G (cin cmagm cexid)) (wcel U X) $;

--| Obsolete theorem, use ~ mgmlrid instead. A magma right and left identity element keeps the other elements unchanged. (Contributed by FL, 12-Dec-2009.) (Revised by Mario Carneiro, 22-Dec-2013.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem cmpidelt (A2 U G X: class):
  $ wceq X (crn G) $ >
  $ wceq U (cfv G cgi) $ >
  $ wi (wa (wcel G (cin cmagm cexid)) (wcel A2 X)) (wa (wceq (co U A2 G) A2) (wceq (co A2 U G) A2)) $;

--| Extend class notation with the class of all semigroups.
term csem: class;

--| Obsolete version of ~ df-sgrp as of 3-Feb-2020. A semigroup is an associative magma. (Contributed by FL, 2-Nov-2009.) (New usage is discouraged.)
axiom df_sgrOLD:
  $ wceq csem (cin cmagm cass) $;

--| Obsolete version of ~ sgrpmgm as of 3-Feb-2020. A semigroup is a magma. (Contributed by FL, 2-Nov-2009.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem smgrpismgmOLD (G: class):
  $ wi (wcel G csem) (wcel G cmagm) $;

--| Obsolete version of ~ issgrp as of 3-Feb-2020. The predicate "is a semigroup". (Contributed by FL, 2-Nov-2009.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem issmgrpOLD {x3 y1 z: setvar} (A2: class x3 y1 z) (G X: class):
  $ wceq X (cdm (cdm G)) $ >
  $ wi (wcel G A2) (wb (wcel G csem) (wa (wf (cxp X X) X G) (wral x3 (wral y1 (wral z (wceq (co (co (cv x3) (cv y1) G) (cv z) G) (co (cv x3) (co (cv y1) (cv z) G) G)) X) X) X))) $;

--| Obsolete theorem, use ~ sgrpmgm instead. A semigroup is a magma. (Contributed by FL, 2-Nov-2009.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem smgrpmgm (G X: class):
  $ wceq X (cdm (cdm G)) $ >
  $ wi (wcel G csem) (wf (cxp X X) X G) $;

--| Obsolete version of ~ sgrpass as of 3-Feb-2020. A semigroup is associative. (Contributed by FL, 2-Nov-2009.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem smgrpassOLD {x3 y1 z: setvar} (G X: class):
  $ wceq X (cdm (cdm G)) $ >
  $ wi (wcel G csem) (wral x3 (wral y1 (wral z (wceq (co (co (cv x3) (cv y1) G) (cv z) G) (co (cv x3) (co (cv y1) (cv z) G) G)) X) X) X) $;

--| Extend class notation with the class of all monoids.
term cmndo: class;

--| Obsolete definition, use ~ df-mnd instead. A monoid is a semigroup with an identity element. (Contributed by FL, 2-Nov-2009.) (New usage is discouraged.)
axiom df_mndo:
  $ wceq cmndo (cin csem cexid) $;

--| Obsolete version of ~ mndsgrp as of 3-Feb-2020. A monoid is a semigroup. (Contributed by FL, 2-Nov-2009.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem mndoissmgrpOLD (G: class):
  $ wi (wcel G cmndo) (wcel G csem) $;

--| Obsolete theorem, use ~ mndid instead. A monoid has an identity element. (Contributed by FL, 2-Nov-2009.) (New usage is discouraged.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem mndoisexid (G: class):
  $ wi (wcel G cmndo) (wcel G cexid) $;

--| Obsolete version of ~ mndmgm as of 3-Feb-2020. A monoid is a magma. (Contributed by FL, 2-Nov-2009.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem mndoismgmOLD (G: class):
  $ wi (wcel G cmndo) (wcel G cmagm) $;

--| Obsolete theorem, use ~ mndmgm and/or ~ mndid instead. A monoid is a magma with an identity element. (Contributed by FL, 18-Feb-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem mndomgmid (G: class):
  $ wi (wcel G cmndo) (wcel G (cin cmagm cexid)) $;

--| Obsolete theorem, use ~ ismnddef instead. The predicate "is a monoid". (Contributed by FL, 2-Nov-2009.) (Revised by Mario Carneiro, 22-Dec-2013.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem ismndo {x3 y1: setvar} (A2: class x3 y1) (G X: class):
  $ wceq X (cdm (cdm G)) $ >
  $ wi (wcel G A2) (wb (wcel G cmndo) (wa (wcel G csem) (wrex x3 (wral y1 (wa (wceq (co (cv x3) (cv y1) G) (cv y1)) (wceq (co (cv y1) (cv x3) G) (cv y1))) X) X))) $;

--| Obsolete theorem, use ~ ismnd instead. The predicate "is a monoid". (Contributed by FL, 2-Nov-2009.) (Revised by Mario Carneiro, 22-Dec-2013.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem ismndo1 {x3 y1 z: setvar} (A2: class x3 y1 z) (G X: class):
  $ wceq X (cdm (cdm G)) $ >
  $ wi (wcel G A2) (wb (wcel G cmndo) (w3a (wf (cxp X X) X G) (wral x3 (wral y1 (wral z (wceq (co (co (cv x3) (cv y1) G) (cv z) G) (co (cv x3) (co (cv y1) (cv z) G) G)) X) X) X) (wrex x3 (wral y1 (wa (wceq (co (cv x3) (cv y1) G) (cv y1)) (wceq (co (cv y1) (cv x3) G) (cv y1))) X) X))) $;

--| Obsolete theorem, use ~ ismnd instead. The predicate "is a monoid". (Contributed by FL, 2-Nov-2009.) (Revised by Mario Carneiro, 22-Dec-2013.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem ismndo2 {x3 y1 z: setvar} (A2: class x3 y1 z) (G X: class):
  $ wceq X (crn G) $ >
  $ wi (wcel G A2) (wb (wcel G cmndo) (w3a (wf (cxp X X) X G) (wral x3 (wral y1 (wral z (wceq (co (co (cv x3) (cv y1) G) (cv z) G) (co (cv x3) (co (cv y1) (cv z) G) G)) X) X) X) (wrex x3 (wral y1 (wa (wceq (co (cv x3) (cv y1) G) (cv y1)) (wceq (co (cv y1) (cv x3) G) (cv y1))) X) X))) $;

--| Obsolete theorem, use ~ grpmnd instead. A group is a monoid. (Contributed by FL, 2-Nov-2009.) (Revised by Mario Carneiro, 22-Dec-2013.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem grpomndo (G: class):
  $ wi (wcel G cgr) (wcel G cmndo) $;

--| Obsolete theorem, use ~ mgmcl instead. Closure of the binary operation of a magma with identity. (Contributed by Jeff Madsen, 16-Jun-2011.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem exidcl (A2 B2 G X: class):
  $ wceq X (crn G) $ >
  $ wi (w3a (wcel G (cin cmagm cexid)) (wcel A2 X) (wcel B2 X)) (wcel (co A2 B2 G) X) $;

--| Obsolete theorem, use ~ 0gisid instead. Lemma for ~ exidres and ~ exidresid . (Contributed by Jeff Madsen, 8-Jun-2010.) (Revised by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem exidreslem {x3: setvar} (U G H X Y: class):
  $ wceq X (crn G) $ >
  $ wceq U (cfv G cgi) $ >
  $ wceq H (cres G (cxp Y Y)) $ >
  $ wi (w3a (wcel G (cin cmagm cexid)) (wss Y X) (wcel U Y)) (wa (wcel U (cdm (cdm H))) (wral x3 (wa (wceq (co U (cv x3) H) (cv x3)) (wceq (co (cv x3) U H) (cv x3))) (cdm (cdm H)))) $;

--| Obsolete theorem, use ~ idressidex instead. The restriction of a binary operation with identity to a subset containing the identity has an identity element. (Contributed by Jeff Madsen, 8-Jun-2010.) (Revised by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem exidres (U G H X Y: class):
  $ wceq X (crn G) $ >
  $ wceq U (cfv G cgi) $ >
  $ wceq H (cres G (cxp Y Y)) $ >
  $ wi (w3a (wcel G (cin cmagm cexid)) (wss Y X) (wcel U Y)) (wcel H cexid) $;

--| Obsolete theorem, use ~ idressid instead. The restriction of a binary operation with identity to a subset containing the identity has the same identity element. (Contributed by Jeff Madsen, 8-Jun-2010.) (Revised by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem exidresid (U G H X Y: class):
  $ wceq X (crn G) $ >
  $ wceq U (cfv G cgi) $ >
  $ wceq H (cres G (cxp Y Y)) $ >
  $ wi (wa (w3a (wcel G (cin cmagm cexid)) (wss Y X) (wcel U Y)) (wcel H cmagm)) (wceq (cfv H cgi) U) $;

--| Obsolete theorem, use ~ ablsub4 instead. A commutative/associative law for Abelian groups. (Contributed by Jeff Madsen, 11-Jun-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem ablo4pnp (A2 B2 C D F G X: class):
  $ wceq X (crn G) $ >
  $ wceq D (cfv G cgs) $ >
  $ wi (wa (wcel G cablo) (wa (wa (wcel A2 X) (wcel B2 X)) (wa (wcel C X) (wcel F X)))) (wceq (co (co A2 B2 G) (co C F G) D) (co (co A2 C D) (co B2 F D) G)) $;

--| Obsolete theorem, use ~ grpsubeq0 instead. Two group elements are equal iff their quotient is the identity. (Contributed by Jeff Madsen, 6-Jan-2011.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem grpoeqdivid (A2 B2 D U G X: class):
  $ wceq X (crn G) $ >
  $ wceq U (cfv G cgi) $ >
  $ wceq D (cfv G cgs) $ >
  $ wi (w3a (wcel G cgr) (wcel A2 X) (wcel B2 X)) (wb (wceq A2 B2) (wceq (co A2 B2 D) U)) $;

--| The group operation for the singleton group. Obsolete, use ~ grp1 . instead. (Contributed by NM, 4-Nov-2006.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem grposnOLD (A2: class):
  $ wcel A2 cvv $ >
  $ wcel (csn (cop (cop A2 A2) A2)) cgr $;

--| Obsolete version of ~ cghm as of 15-Mar-2020. Extend class notation to include the class of group homomorphisms. (New usage is discouraged.)
term cghomOLD: class;

--| Obsolete version of ~ df-ghm as of 15-Mar-2020. Define the set of group homomorphisms from ` g ` to ` h ` . (Contributed by Paul Chapman, 25-Feb-2008.) (New usage is discouraged.)
axiom df_ghomOLD {x3 y1 f2 g2 h: setvar}:
  $ wceq cghomOLD (cmpo g2 h cgr cgr (cab f2 (wa (wf (crn (cv g2)) (crn (cv h)) (cv f2)) (wral x3 (wral y1 (wceq (co (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) (cv h)) (cfv (co (cv x3) (cv y1) (cv g2)) (cv f2))) (crn (cv g2))) (crn (cv g2)))))) $;

--| Obsolete as of 15-Mar-2020. Lemma for ~ elghomOLD . (Contributed by Paul Chapman, 25-Feb-2008.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem elghomlem1OLD {x3 y1 f2: setvar} (S: class x3 y1 f2) (G H: class):
  $ wceq S (cab f2 (wa (wf (crn G) (crn H) (cv f2)) (wral x3 (wral y1 (wceq (co (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) H) (cfv (co (cv x3) (cv y1) G) (cv f2))) (crn G)) (crn G)))) $ >
  $ wi (wa (wcel G cgr) (wcel H cgr)) (wceq (co G H cghomOLD) S) $;

--| Obsolete as of 15-Mar-2020. Lemma for ~ elghomOLD . (Contributed by Paul Chapman, 25-Feb-2008.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem elghomlem2OLD {x3 y1 f2: setvar} (S: class x3 y1 f2) (F G H: class):
  $ wceq S (cab f2 (wa (wf (crn G) (crn H) (cv f2)) (wral x3 (wral y1 (wceq (co (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) H) (cfv (co (cv x3) (cv y1) G) (cv f2))) (crn G)) (crn G)))) $ >
  $ wi (wa (wcel G cgr) (wcel H cgr)) (wb (wcel F (co G H cghomOLD)) (wa (wf (crn G) (crn H) F) (wral x3 (wral y1 (wceq (co (cfv (cv x3) F) (cfv (cv y1) F) H) (cfv (co (cv x3) (cv y1) G) F)) (crn G)) (crn G)))) $;

--| Obsolete version of ~ isghm as of 15-Mar-2020. Membership in the set of group homomorphisms from ` G ` to ` H ` . (Contributed by Paul Chapman, 3-Mar-2008.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem elghomOLD {x3 y1: setvar} (F G H: class) (W: class x3 y1) (X: class):
  $ wceq X (crn G) $ >
  $ wceq W (crn H) $ >
  $ wi (wa (wcel G cgr) (wcel H cgr)) (wb (wcel F (co G H cghomOLD)) (wa (wf X W F) (wral x3 (wral y1 (wceq (co (cfv (cv x3) F) (cfv (cv y1) F) H) (cfv (co (cv x3) (cv y1) G) F)) X) X))) $;

--| Obsolete version of ~ ghmlin as of 15-Mar-2020. Linearity of a group homomorphism. (Contributed by Paul Chapman, 3-Mar-2008.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem ghomlinOLD (A2 B2 F G H X: class):
  $ wceq X (crn G) $ >
  $ wi (wa (w3a (wcel G cgr) (wcel H cgr) (wcel F (co G H cghomOLD))) (wa (wcel A2 X) (wcel B2 X))) (wceq (co (cfv A2 F) (cfv B2 F) H) (cfv (co A2 B2 G) F)) $;

--| Obsolete version of ~ ghmid as of 15-Mar-2020. A group homomorphism maps identity element to identity element. (Contributed by Paul Chapman, 3-Mar-2008.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem ghomidOLD (T U F G H: class):
  $ wceq U (cfv G cgi) $ >
  $ wceq T (cfv H cgi) $ >
  $ wi (w3a (wcel G cgr) (wcel H cgr) (wcel F (co G H cghomOLD))) (wceq (cfv U F) T) $;

--| Obsolete theorem, use ~ ghmf instead. Mapping property of a group homomorphism. (Contributed by Jeff Madsen, 1-Dec-2009.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem ghomf (F G H W X: class):
  $ wceq X (crn G) $ >
  $ wceq W (crn H) $ >
  $ wi (w3a (wcel G cgr) (wcel H cgr) (wcel F (co G H cghomOLD))) (wf X W F) $;

--| Obsolete theorem, use ~ ghmco instead. The composition of two group homomorphisms is a group homomorphism. (Contributed by Jeff Madsen, 1-Dec-2009.) (Revised by Mario Carneiro, 27-Dec-2014.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem ghomco (S T G H K: class):
  $ wi (wa (w3a (wcel G cgr) (wcel H cgr) (wcel K cgr)) (wa (wcel S (co G H cghomOLD)) (wcel T (co H K cghomOLD)))) (wcel (ccom T S) (co G K cghomOLD)) $;

--| Obsolete theorem, use ~ ghmsub instead. Group homomorphisms preserve division. (Contributed by Jeff Madsen, 16-Jun-2011.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem ghomdiv (A2 B2 C D F G H X: class):
  $ wceq X (crn G) $ >
  $ wceq D (cfv G cgs) $ >
  $ wceq C (cfv H cgs) $ >
  $ wi (wa (w3a (wcel G cgr) (wcel H cgr) (wcel F (co G H cghomOLD))) (wa (wcel A2 X) (wcel B2 X))) (wceq (cfv (co A2 B2 D) F) (co (cfv A2 F) (cfv B2 F) C)) $;

--| Obsolete theorem, use ~ kerf1ghm instead. A group homomorphism is injective if and only if its kernel is zero. (Contributed by Jeff Madsen, 16-Jun-2011.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem grpokerinj (U F G H W X Y: class):
  $ wceq X (crn G) $ >
  $ wceq W (cfv G cgi) $ >
  $ wceq Y (crn H) $ >
  $ wceq U (cfv H cgi) $ >
  $ wi (w3a (wcel G cgr) (wcel H cgr) (wcel F (co G H cghomOLD))) (wb (wf1 X Y F) (wceq (cima (ccnv F) (csn U)) (csn W))) $;

--| Extend class notation with the class of all unital rings.
term crngo: class;

--| Obsolete defintion, use ~ dfring3 instead. Define the class of all unital rings. (Contributed by Jeff Hankins, 21-Nov-2006.) (New usage is discouraged.)
axiom df_rngo {x3 y1 z g2 h: setvar}:
  $ wceq crngo (copab g2 h (wa (wa (wcel (cv g2) cablo) (wf (cxp (crn (cv g2)) (crn (cv g2))) (crn (cv g2)) (cv h))) (wa (wral x3 (wral y1 (wral z (w3a (wceq (co (co (cv x3) (cv y1) (cv h)) (cv z) (cv h)) (co (cv x3) (co (cv y1) (cv z) (cv h)) (cv h))) (wceq (co (cv x3) (co (cv y1) (cv z) (cv g2)) (cv h)) (co (co (cv x3) (cv y1) (cv h)) (co (cv x3) (cv z) (cv h)) (cv g2))) (wceq (co (co (cv x3) (cv y1) (cv g2)) (cv z) (cv h)) (co (co (cv x3) (cv z) (cv h)) (co (cv y1) (cv z) (cv h)) (cv g2)))) (crn (cv g2))) (crn (cv g2))) (crn (cv g2))) (wrex x3 (wral y1 (wa (wceq (co (cv x3) (cv y1) (cv h)) (cv y1)) (wceq (co (cv y1) (cv x3) (cv h)) (cv y1))) (crn (cv g2))) (crn (cv g2)))))) $;

--| Obsolete theorem. The class of all unital rings is a relation. (Contributed by FL, 31-Aug-2009.) (Revised by Mario Carneiro, 21-Dec-2013.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem relrngo:
  $ wrel crngo $;

--| Obsolete theorem, use ~ dfring2 instead. The predicate "is a (unital) ring." Definition of "ring with unit" in [Schechter] p. 187. (Contributed by Jeff Hankins, 21-Nov-2006.) (Revised by Mario Carneiro, 21-Dec-2013.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem isrngo {x3 y1 z: setvar} (A2: class x3 y1 z) (G H X: class):
  $ wceq X (crn G) $ >
  $ wi (wcel H A2) (wb (wcel (cop G H) crngo) (wa (wa (wcel G cablo) (wf (cxp X X) X H)) (wa (wral x3 (wral y1 (wral z (w3a (wceq (co (co (cv x3) (cv y1) H) (cv z) H) (co (cv x3) (co (cv y1) (cv z) H) H)) (wceq (co (cv x3) (co (cv y1) (cv z) G) H) (co (co (cv x3) (cv y1) H) (co (cv x3) (cv z) H) G)) (wceq (co (co (cv x3) (cv y1) G) (cv z) H) (co (co (cv x3) (cv z) H) (co (cv y1) (cv z) H) G))) X) X) X) (wrex x3 (wral y1 (wa (wceq (co (cv x3) (cv y1) H) (cv y1)) (wceq (co (cv y1) (cv x3) H) (cv y1))) X) X)))) $;

--| Obsolete theorem, use ~ isringd instead. Conditions that determine a ring. (Changed label from ~ isringd to ~ isrngod -NM 2-Aug-2013.) (Contributed by Jeff Madsen, 19-Jun-2010.) (Revised by Mario Carneiro, 21-Dec-2013.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem isrngod {x3 y1 z: setvar} (ph: wff) (U: class z) (G H X: class):
  $ wi ph (wcel G cablo) $ >
  $ wi ph (wceq X (crn G)) $ >
  $ wi ph (wf (cxp X X) X H) $ >
  $ wi (wa ph (w3a (wcel (cv x3) X) (wcel (cv y1) X) (wcel (cv z) X))) (wceq (co (co (cv x3) (cv y1) H) (cv z) H) (co (cv x3) (co (cv y1) (cv z) H) H)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) X) (wcel (cv y1) X) (wcel (cv z) X))) (wceq (co (cv x3) (co (cv y1) (cv z) G) H) (co (co (cv x3) (cv y1) H) (co (cv x3) (cv z) H) G)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) X) (wcel (cv y1) X) (wcel (cv z) X))) (wceq (co (co (cv x3) (cv y1) G) (cv z) H) (co (co (cv x3) (cv z) H) (co (cv y1) (cv z) H) G)) $ >
  $ wi ph (wcel U X) $ >
  $ wi (wa ph (wcel (cv y1) X)) (wceq (co U (cv y1) H) (cv y1)) $ >
  $ wi (wa ph (wcel (cv y1) X)) (wceq (co (cv y1) U H) (cv y1)) $ >
  $ wi ph (wcel (cop G H) crngo) $;

--| Obsolete theorem, use ~ dfring3 instead. The properties of a unital ring. (Contributed by Steve Rodriguez, 8-Sep-2007.) (Proof shortened by Mario Carneiro, 21-Dec-2013.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngoi {x3 y1 z: setvar} (R: class y1 z) (G H X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wi (wcel R crngo) (wa (wa (wcel G cablo) (wf (cxp X X) X H)) (wa (wral x3 (wral y1 (wral z (w3a (wceq (co (co (cv x3) (cv y1) H) (cv z) H) (co (cv x3) (co (cv y1) (cv z) H) H)) (wceq (co (cv x3) (co (cv y1) (cv z) G) H) (co (co (cv x3) (cv y1) H) (co (cv x3) (cv z) H) G)) (wceq (co (co (cv x3) (cv y1) G) (cv z) H) (co (co (cv x3) (cv z) H) (co (cv y1) (cv z) H) G))) X) X) X) (wrex x3 (wral y1 (wa (wceq (co (cv x3) (cv y1) H) (cv y1)) (wceq (co (cv y1) (cv x3) H) (cv y1))) X) X))) $;

--| Obsolete theorem. Functionality of the multiplication operation of a ring. (Contributed by Steve Rodriguez, 9-Sep-2007.) (Revised by Mario Carneiro, 21-Dec-2013.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngosm (R G H X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wi (wcel R crngo) (wf (cxp X X) X H) $;

--| Obsolete theorem, use ~ ringcl instead. Closure of the multiplication operation of a ring. (Contributed by Steve Rodriguez, 9-Sep-2007.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngocl (A2 B2 R G H X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wi (w3a (wcel R crngo) (wcel A2 X) (wcel B2 X)) (wcel (co A2 B2 H) X) $;

--| Obsolete theorem, use ~ ringid instead. The multiplication operation of a unital ring has (one or more) identity elements. (Contributed by Steve Rodriguez, 9-Sep-2007.) (Revised by Mario Carneiro, 22-Dec-2013.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngoid {u: setvar} (A2 R G H X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wcel R crngo) (wcel A2 X)) (wrex u (wa (wceq (co (cv u) A2 H) A2) (wceq (co A2 (cv u) H) A2)) X) $;

--| Obsolete theorem, use ~ ringideu instead. The unity element of a ring is unique. (Contributed by NM, 4-Apr-2009.) (Revised by Mario Carneiro, 21-Dec-2013.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngoideu {x3 u: setvar} (R G H X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wi (wcel R crngo) (wreu u (wral x3 (wa (wceq (co (cv u) (cv x3) H) (cv x3)) (wceq (co (cv x3) (cv u) H) (cv x3))) X) X) $;

--| Obsolete theorem, use ~ ringdi instead. Distributive law for the multiplication operation of a ring (left-distributivity). (Contributed by Steve Rodriguez, 9-Sep-2007.) (Revised by Mario Carneiro, 21-Dec-2013.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngodi (A2 B2 C R G H X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wcel R crngo) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wceq (co A2 (co B2 C G) H) (co (co A2 B2 H) (co A2 C H) G)) $;

--| Obsolete theorem, use ~ ringdir instead. Distributive law for the multiplication operation of a ring (right-distributivity). (Contributed by Steve Rodriguez, 9-Sep-2007.) (Revised by Mario Carneiro, 21-Dec-2013.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngodir (A2 B2 C R G H X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wcel R crngo) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wceq (co (co A2 B2 G) C H) (co (co A2 C H) (co B2 C H) G)) $;

--| Obsolete theorem, use ~ ringass instead. Associative law for the multiplication operation of a ring. (Contributed by Steve Rodriguez, 9-Sep-2007.) (Revised by Mario Carneiro, 21-Dec-2013.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngoass (A2 B2 C R G H X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wcel R crngo) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wceq (co (co A2 B2 H) C H) (co A2 (co B2 C H) H)) $;

--| Obsolete theorem, use ~ ringadd2 instead. A ring element plus itself is two times the element. (Contributed by Steve Rodriguez, 9-Sep-2007.) (Revised by Mario Carneiro, 22-Dec-2013.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngo2 {x3: setvar} (A2 R G H X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wcel R crngo) (wcel A2 X)) (wrex x3 (wceq (co A2 A2 G) (co (co (cv x3) (cv x3) G) A2 H)) X) $;

--| Obsolete theorem, use ~ ringabl instead. A ring's addition operation is an Abelian group operation. (Contributed by Steve Rodriguez, 9-Sep-2007.) (Revised by Mario Carneiro, 21-Dec-2013.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngoablo (R G: class):
  $ wceq G (cfv R c1st) $ >
  $ wi (wcel R crngo) (wcel G cablo) $;

--| Obsolete theorem, use ~ ringabl instead. In a unital ring the addition is an abelian group. (Contributed by FL, 31-Aug-2009.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngoablo2 (G H: class):
  $ wi (wcel (cop G H) crngo) (wcel G cablo) $;

--| Obsolete theorem, use ~ ringgrp instead. A ring's addition operation is a group operation. (Contributed by Steve Rodriguez, 9-Sep-2007.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngogrpo (R G: class):
  $ wceq G (cfv R c1st) $ >
  $ wi (wcel R crngo) (wcel G cgr) $;

--| Obsolete theorem, use ~ ringbn0 instead. The base set of a ring is not empty. (Contributed by FL, 24-Jan-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngone0 (R G X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wi (wcel R crngo) (wne X c0) $;

--| Obsolete theorem, use ~ ringacl instead. Closure law for the addition (group) operation of a ring. (Contributed by Steve Rodriguez, 9-Sep-2007.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngogcl (A2 B2 R G X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wi (w3a (wcel R crngo) (wcel A2 X) (wcel B2 X)) (wcel (co A2 B2 G) X) $;

--| Obsolete theorem, use ~ ringcom instead. The addition operation of a ring is commutative. (Contributed by Steve Rodriguez, 9-Sep-2007.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngocom (A2 B2 R G X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wi (w3a (wcel R crngo) (wcel A2 X) (wcel B2 X)) (wceq (co A2 B2 G) (co B2 A2 G)) $;

--| Obsolete theorem, use ~ ringgrp and ~ grpass instead. The addition operation of a ring is associative. (Contributed by Steve Rodriguez, 9-Sep-2007.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngoaass (A2 B2 C R G X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wcel R crngo) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wceq (co (co A2 B2 G) C G) (co A2 (co B2 C G) G)) $;

--| Obsolete theorem, use ~ ringabl and ~ abl32 instead. The addition operation of a ring is commutative. (Contributed by Steve Rodriguez, 9-Sep-2007.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngoa32 (A2 B2 C R G X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wcel R crngo) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wceq (co (co A2 B2 G) C G) (co (co A2 C G) B2 G)) $;

--| Obsolete theorem, use ~ ringabl and ~ ablcmn and ~ cmn4 instead. Rearrangement of 4 terms in a sum of ring elements. (Contributed by Steve Rodriguez, 9-Sep-2007.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngoa4 (A2 B2 C D R G X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wi (w3a (wcel R crngo) (wa (wcel A2 X) (wcel B2 X)) (wa (wcel C X) (wcel D X))) (wceq (co (co A2 B2 G) (co C D G) G) (co (co A2 C G) (co B2 D G) G)) $;

--| Obsolete theorem, use ~ ringgrp and ~ grprcan instead. Right cancellation law for the addition operation of a ring. (Contributed by Steve Rodriguez, 9-Sep-2007.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngorcan (A2 B2 C R G X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wcel R crngo) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wb (wceq (co A2 C G) (co B2 C G)) (wceq A2 B2)) $;

--| Obsolete theorem, use ~ ringgrp and ~ grplcan instead. Left cancellation law for the addition operation of a ring. (Contributed by Steve Rodriguez, 9-Sep-2007.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngolcan (A2 B2 C R G X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wcel R crngo) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wb (wceq (co C A2 G) (co C B2 G)) (wceq A2 B2)) $;

--| Obsolete theorem, use ~ ring0cl instead. A ring has an additive identity element. (Contributed by Steve Rodriguez, 9-Sep-2007.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngo0cl (R G X Z: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wi (wcel R crngo) (wcel Z X) $;

--| Obsolete theorem, use ~ ringgrp and ~ grprid instead. The additive identity of a ring is a right identity element. (Contributed by Steve Rodriguez, 9-Sep-2007.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngo0rid (A2 R G X Z: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wi (wa (wcel R crngo) (wcel A2 X)) (wceq (co A2 Z G) A2) $;

--| Obsolete theorem, use ~ ringgrp and ~ grplid instead. The additive identity of a ring is a left identity element. (Contributed by Steve Rodriguez, 9-Sep-2007.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngo0lid (A2 R G X Z: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wi (wa (wcel R crngo) (wcel A2 X)) (wceq (co Z A2 G) A2) $;

--| Obsolete theorem, use ~ ringlz instead. The zero of a unital ring is a left-absorbing element. (Contributed by FL, 31-Aug-2009.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngolz (A2 R G H X Z: class):
  $ wceq Z (cfv G cgi) $ >
  $ wceq X (crn G) $ >
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wi (wa (wcel R crngo) (wcel A2 X)) (wceq (co Z A2 H) Z) $;

--| Obsolete theorem, use ~ ringrz instead. The zero of a unital ring is a right-absorbing element. (Contributed by FL, 31-Aug-2009.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngorz (A2 R G H X Z: class):
  $ wceq Z (cfv G cgi) $ >
  $ wceq X (crn G) $ >
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wi (wa (wcel R crngo) (wcel A2 X)) (wceq (co A2 Z H) Z) $;

--| Obsolete as of 25-Jan-2020. Use ~ ring1zr or ~ srg1zr instead. The only unital ring with a base set consisting in one element is the zero ring. (Contributed by FL, 13-Feb-2010.) (Proof shortened by Mario Carneiro, 30-Apr-2015.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngosn3 (A2 B2 R G X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wcel R crngo) (wcel A2 B2)) (wb (wceq X (csn A2)) (wceq R (cop (csn (cop (cop A2 A2) A2)) (csn (cop (cop A2 A2) A2))))) $;

--| Obsolete as of 25-Jan-2020. Use ~ rngen1zr instead. The only unital ring with one element is the zero ring. (Contributed by FL, 14-Feb-2010.) (Revised by Mario Carneiro, 30-Apr-2015.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngosn4 (A2 R G X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wcel R crngo) (wcel A2 X)) (wb (wbr X c1o cen) (wceq R (cop (csn (cop (cop A2 A2) A2)) (csn (cop (cop A2 A2) A2))))) $;

--| Obsolete as of 25-Jan-2020. Use ~ ringen1zr0 or ~ srgen1zr0 instead. The only unital ring with one element is the zero ring. (Contributed by FL, 15-Feb-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngosn6 (R G X Z: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wi (wcel R crngo) (wb (wbr X c1o cen) (wceq R (cop (csn (cop (cop Z Z) Z)) (csn (cop (cop Z Z) Z))))) $;

--| Obsolete theorem, use ~ ringgrp and ~ grpinvcl instead. A ring is closed under negation. (Contributed by Jeff Madsen, 10-Jun-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngonegcl (A2 R G N X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wceq N (cfv G cgn) $ >
  $ wi (wa (wcel R crngo) (wcel A2 X)) (wcel (cfv A2 N) X) $;

--| Obsolete theorem, use ~ ringgrp and ~ grplinv instead. Adding the negative in a ring gives zero. (Contributed by Jeff Madsen, 10-Jun-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngoaddneg1 (A2 R G N X Z: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wceq N (cfv G cgn) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wi (wa (wcel R crngo) (wcel A2 X)) (wceq (co A2 (cfv A2 N) G) Z) $;

--| Obsolete theorem, use ~ ringgrp and ~ grprinv instead. Adding the negative in a ring gives zero. (Contributed by Jeff Madsen, 10-Jun-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngoaddneg2 (A2 R G N X Z: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wceq N (cfv G cgn) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wi (wa (wcel R crngo) (wcel A2 X)) (wceq (co (cfv A2 N) A2 G) Z) $;

--| Obsolete theorem, use ~ ringgrp and ~ grpsubval instead. Subtraction in a ring, in terms of addition and negation. (Contributed by Jeff Madsen, 19-Jun-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngosub (A2 B2 D R G N X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wceq N (cfv G cgn) $ >
  $ wceq D (cfv G cgs) $ >
  $ wi (w3a (wcel R crngo) (wcel A2 X) (wcel B2 X)) (wceq (co A2 B2 D) (co A2 (cfv B2 N) G)) $;

--| Obsolete theorem. The range of an internal operation with a left and right identity element equals its base set. (Contributed by FL, 24-Jan-2010.) (Revised by Mario Carneiro, 22-Dec-2013.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngmgmbs4 {x3 u: setvar} (G X: class):
  $ wi (wa (wf (cxp X X) X G) (wrex u (wral x3 (wa (wceq (co (cv u) (cv x3) G) (cv x3)) (wceq (co (cv x3) (cv u) G) (cv x3))) X) X)) (wceq (crn G) X) $;

--| Obsolete theorem. In a unital ring the domain of the first variable of the addition equals the domain of the first variable of the multiplication. (Contributed by FL, 24-Jan-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngodm1dm2 (R G H: class):
  $ wceq H (cfv R c2nd) $ >
  $ wceq G (cfv R c1st) $ >
  $ wi (wcel R crngo) (wceq (cdm (cdm G)) (cdm (cdm H))) $;

--| Obsolete theorem. In a unital ring the range of the addition equals the domain of the first variable of the multiplication. (Contributed by FL, 24-Jan-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngorn1 (R G H: class):
  $ wceq H (cfv R c2nd) $ >
  $ wceq G (cfv R c1st) $ >
  $ wi (wcel R crngo) (wceq (crn G) (cdm (cdm H))) $;

--| Obsolete theorem. In a unital ring the range of the addition equals the range of the multiplication. (Contributed by FL, 24-Jan-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngorn1eq (R G H: class):
  $ wceq H (cfv R c2nd) $ >
  $ wceq G (cfv R c1st) $ >
  $ wi (wcel R crngo) (wceq (crn G) (crn H)) $;

--| Obsolete theorem, use ~ ringgrp instead. In a unital ring the multiplication is a monoid. (Contributed by FL, 24-Jan-2010.) (Revised by Mario Carneiro, 22-Dec-2013.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngomndo (R H: class):
  $ wceq H (cfv R c2nd) $ >
  $ wi (wcel R crngo) (wcel H cmndo) $;

--| Obsolete theorem, use ~ ringidmlem instead. The unity element of a ring is an identity element for the multiplication. (Contributed by FL, 18-Feb-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngoidmlem (A2 R U H X: class):
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn (cfv R c1st)) $ >
  $ wceq U (cfv H cgi) $ >
  $ wi (wa (wcel R crngo) (wcel A2 X)) (wa (wceq (co U A2 H) A2) (wceq (co A2 U H) A2)) $;

--| Obsolete theorem, use ~ ringlidm instead. The unity element of a ring is an identity element for the multiplication. (Contributed by FL, 18-Apr-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngolidm (A2 R U H X: class):
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn (cfv R c1st)) $ >
  $ wceq U (cfv H cgi) $ >
  $ wi (wa (wcel R crngo) (wcel A2 X)) (wceq (co U A2 H) A2) $;

--| Obsolete theorem, use ~ ringridm instead. The unity element of a ring is an identity element for the multiplication. (Contributed by FL, 18-Apr-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngoridm (A2 R U H X: class):
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn (cfv R c1st)) $ >
  $ wceq U (cfv H cgi) $ >
  $ wi (wa (wcel R crngo) (wcel A2 X)) (wceq (co A2 U H) A2) $;

--| Obsolete theorem, use ~ ringidcl instead. The unity element of a ring belongs to the base set. (Contributed by FL, 12-Feb-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngo1cl (R U H X: class):
  $ wceq X (crn (cfv R c1st)) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq U (cfv H cgi) $ >
  $ wi (wcel R crngo) (wcel U X) $;

--| Obsolete as of 23-Jan-2020. Use ~ 0ring01eqbi instead. In a unital ring the zero equals the ring unity iff the ring is the zero ring. (Contributed by FL, 14-Feb-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngoueqz (R U G H X Z: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wceq U (cfv H cgi) $ >
  $ wceq X (crn G) $ >
  $ wi (wcel R crngo) (wb (wbr X c1o cen) (wceq U Z)) $;

--| Obsolete theorem, use ~ ringnegl instead. Negation in a ring is the same as left multiplication by ` -u 1 ` . (Contributed by Jeff Madsen, 10-Jun-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngonegmn1l (A2 R U G H N X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wceq N (cfv G cgn) $ >
  $ wceq U (cfv H cgi) $ >
  $ wi (wa (wcel R crngo) (wcel A2 X)) (wceq (cfv A2 N) (co (cfv U N) A2 H)) $;

--| Obsolete theorem, use ~ ringnegr instead. Negation in a ring is the same as right multiplication by ` -u 1 ` . (Contributed by Jeff Madsen, 19-Jun-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngonegmn1r (A2 R U G H N X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wceq N (cfv G cgn) $ >
  $ wceq U (cfv H cgi) $ >
  $ wi (wa (wcel R crngo) (wcel A2 X)) (wceq (cfv A2 N) (co A2 (cfv U N) H)) $;

--| Obsolete theorem, use ~ ringmneg1 instead. Negation of a product in a ring. (Contributed by Jeff Madsen, 19-Jun-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngoneglmul (A2 B2 R G H N X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wceq N (cfv G cgn) $ >
  $ wi (w3a (wcel R crngo) (wcel A2 X) (wcel B2 X)) (wceq (cfv (co A2 B2 H) N) (co (cfv A2 N) B2 H)) $;

--| Obsolete theorem, use ~ ringmneg2 instead. Negation of a product in a ring. (Contributed by Jeff Madsen, 19-Jun-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngonegrmul (A2 B2 R G H N X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wceq N (cfv G cgn) $ >
  $ wi (w3a (wcel R crngo) (wcel A2 X) (wcel B2 X)) (wceq (cfv (co A2 B2 H) N) (co A2 (cfv B2 N) H)) $;

--| Obsolete theorem, use ~ ringsubdi instead. Ring multiplication distributes over subtraction. (Contributed by Jeff Madsen, 19-Jun-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngosubdi (A2 B2 C D R G H X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wceq D (cfv G cgs) $ >
  $ wi (wa (wcel R crngo) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wceq (co A2 (co B2 C D) H) (co (co A2 B2 H) (co A2 C H) D)) $;

--| Obsolete theorem, use ~ ringsubdir instead. Ring multiplication distributes over subtraction. (Contributed by Jeff Madsen, 19-Jun-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rngosubdir (A2 B2 C D R G H X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wceq D (cfv G cgs) $ >
  $ wi (wa (wcel R crngo) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wceq (co (co A2 B2 D) C H) (co (co A2 C H) (co B2 C H) D)) $;

--| Obsolete theorem, use ~ ringinvnzdiv instead. In a unital ring a left invertible element is not a zero divisor. See also ~ ringinvnzdiv . (Contributed by Jeff Madsen, 18-Apr-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem zerdivemp1x {a: setvar} (A2 B2 R: class) (U G: class a) (H X Z: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wceq X (crn G) $ >
  $ wceq U (cfv H cgi) $ >
  $ wi (w3a (wcel R crngo) (wcel A2 X) (wrex a (wceq (co (cv a) A2 H) U) X)) (wi (wcel B2 X) (wi (wceq (co A2 B2 H) Z) (wceq B2 Z))) $;

--| Extend class notation with the class of all division rings.
term cdrng: class;

--| Obsolete defintion, use ~ df-drng instead. Define the class of all division rings (sometimes called skew fields). A division ring is a unital ring where every element except the additive identity has a multiplicative inverse. (Contributed by NM, 4-Apr-2009.) (New usage is discouraged.)
axiom df_drngo {g2 h: setvar}:
  $ wceq cdrng (copab g2 h (wa (wcel (cop (cv g2) (cv h)) crngo) (wcel (cres (cv h) (cxp (cdif (crn (cv g2)) (csn (cfv (cv g2) cgi))) (cdif (crn (cv g2)) (csn (cfv (cv g2) cgi))))) cgr))) $;

--| Obsolete theorem, use ~ isdrng2 instead. The predicate "is a division ring". (Contributed by FL, 6-Sep-2009.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem isdivrngo (A2 G H: class):
  $ wi (wcel H A2) (wb (wcel (cop G H) cdrng) (wa (wcel (cop G H) crngo) (wcel (cres H (cxp (cdif (crn G) (csn (cfv G cgi))) (cdif (crn G) (csn (cfv G cgi))))) cgr))) $;

--| Obsolete theorem, use ~ drngprops instead. The properties of a division ring. (Contributed by NM, 4-Apr-2009.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem drngoi (R G H X Z: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wi (wcel R cdrng) (wa (wcel R crngo) (wcel (cres H (cxp (cdif X (csn Z)) (cdif X (csn Z)))) cgr)) $;

--| Obsolete as of 23-Jan-2020. Use ~ mnd1id instead. The identity element of the trivial group. (Contributed by FL, 21-Jun-2010.) (Proof shortened by Mario Carneiro, 15-Dec-2013.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem gidsn (A2: class):
  $ wcel A2 cvv $ >
  $ wceq (cfv (csn (cop (cop A2 A2) A2)) cgi) A2 $;

--| Obsolete theorem, use ~ zrdrng instead. The zero ring is not a division ring. (Contributed by FL, 24-Jan-2010.) (Proof shortened by Mario Carneiro, 15-Dec-2013.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem zrdivrng (A2: class):
  $ wcel A2 cvv $ >
  $ wn (wcel (cop (csn (cop (cop A2 A2) A2)) (csn (cop (cop A2 A2) A2))) cdrng) $;

--| Obsolete theorem, use ~ drngunz instead. In a division ring the ring unit is different from the zero. (Contributed by FL, 14-Feb-2010.) (Revised by Mario Carneiro, 15-Dec-2013.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem dvrunz (R U G H X Z: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wceq U (cfv H cgi) $ >
  $ wi (wcel R cdrng) (wne U Z) $;

--| Obsolete theorem, use ~ isgrpde instead. Properties that determine a group operation. (Contributed by Jeff Madsen, 1-Dec-2009.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem isgrpda {x3 y1 z n: setvar} (ph: wff n) (U G X: class):
  $ wi ph (wcel X cvv) $ >
  $ wi ph (wf (cxp X X) X G) $ >
  $ wi (wa ph (w3a (wcel (cv x3) X) (wcel (cv y1) X) (wcel (cv z) X))) (wceq (co (co (cv x3) (cv y1) G) (cv z) G) (co (cv x3) (co (cv y1) (cv z) G) G)) $ >
  $ wi ph (wcel U X) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wceq (co U (cv x3) G) (cv x3)) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wrex n (wceq (co (cv n) (cv x3) G) U) X) $ >
  $ wi ph (wcel G cgr) $;

--| Obsolete theorem, use ~ isdrng2 instead. The predicate "is a division ring". (Contributed by Jeff Madsen, 8-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem isdrngo1 (R G H X Z: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wceq X (crn G) $ >
  $ wb (wcel R cdrng) (wa (wcel R crngo) (wcel (cres H (cxp (cdif X (csn Z)) (cdif X (csn Z)))) cgr)) $;

--| Obsolete theorem, use ~ drngmcl instead. The product of two nonzero elements of a division ring is nonzero. (Contributed by Jeff Madsen, 9-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem divrngcl (A2 B2 R G H X Z: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wceq X (crn G) $ >
  $ wi (w3a (wcel R cdrng) (wcel A2 (cdif X (csn Z))) (wcel B2 (cdif X (csn Z)))) (wcel (co A2 B2 H) (cdif X (csn Z))) $;

--| Obsolete theorem, use ~ isdrng3 instead. A division ring is a ring in which ` 1 =/= 0 ` and every nonzero element is invertible. (Contributed by Jeff Madsen, 8-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem isdrngo2 {x3 y1: setvar} (R U: class) (G: class x3 y1) (H X Z: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wceq X (crn G) $ >
  $ wceq U (cfv H cgi) $ >
  $ wb (wcel R cdrng) (wa (wcel R crngo) (wa (wne U Z) (wral x3 (wrex y1 (wceq (co (cv y1) (cv x3) H) U) (cdif X (csn Z))) (cdif X (csn Z))))) $;

--| Obsolete theorem, use ~ isdrng5 instead. A division ring is a ring in which ` 1 =/= 0 ` and every nonzero element is invertible. (Contributed by Jeff Madsen, 10-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem isdrngo3 {x3 y1: setvar} (R U: class) (G: class x3 y1) (H X Z: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wceq X (crn G) $ >
  $ wceq U (cfv H cgi) $ >
  $ wb (wcel R cdrng) (wa (wcel R crngo) (wa (wne U Z) (wral x3 (wrex y1 (wceq (co (cv y1) (cv x3) H) U) X) (cdif X (csn Z))))) $;

--| Extend class notation with the class of ring homomorphisms.
term crngohom: class;

--| Extend class notation with the class of ring isomorphisms.
term crngoiso: class;

--| Extend class notation with the ring isomorphism relation.
term crisc: class;

--| Obsolete defintion, use ~ df-rhm instead. Define the function which gives the set of ring homomorphisms between two given rings. (New usage is discouraged.) (Contributed by Jeff Madsen, 19-Jun-2010.)
axiom df_rngohom {x3 y1 f2 s1 r: setvar}:
  $ wceq crngohom (cmpo r s1 crngo crngo (crab f2 (wa (wceq (cfv (cfv (cfv (cv r) c2nd) cgi) (cv f2)) (cfv (cfv (cv s1) c2nd) cgi)) (wral x3 (wral y1 (wa (wceq (cfv (co (cv x3) (cv y1) (cfv (cv r) c1st)) (cv f2)) (co (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) (cfv (cv s1) c1st))) (wceq (cfv (co (cv x3) (cv y1) (cfv (cv r) c2nd)) (cv f2)) (co (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) (cfv (cv s1) c2nd)))) (crn (cfv (cv r) c1st))) (crn (cfv (cv r) c1st)))) (co (crn (cfv (cv s1) c1st)) (crn (cfv (cv r) c1st)) cmap))) $;

--| Obsolete theorem, use ~ rhmval0 instead. The set of ring homomorphisms. (Contributed by Jeff Madsen, 19-Jun-2010.) (Revised by Mario Carneiro, 22-Sep-2015.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem rngohomval {x3 y1 f2: setvar} (R S: class) (U G H J K V: class x3 y1) (X: class) (Y: class x3):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wceq U (cfv H cgi) $ >
  $ wceq J (cfv S c1st) $ >
  $ wceq K (cfv S c2nd) $ >
  $ wceq Y (crn J) $ >
  $ wceq V (cfv K cgi) $ >
  $ wi (wa (wcel R crngo) (wcel S crngo)) (wceq (co R S crngohom) (crab f2 (wa (wceq (cfv U (cv f2)) V) (wral x3 (wral y1 (wa (wceq (cfv (co (cv x3) (cv y1) G) (cv f2)) (co (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) J)) (wceq (cfv (co (cv x3) (cv y1) H) (cv f2)) (co (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) K))) X) X)) (co Y X cmap))) $;

--| Obsolete theorem, use ~ isrhm0 instead. The predicate "is a ring homomorphism from ` R ` to ` S ` ". (Contributed by Jeff Madsen, 19-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem isrngohom {x3 y1: setvar} (R S: class) (U: class x3 y1) (F: class) (G H J K V: class x3 y1) (X: class) (Y: class x3):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wceq U (cfv H cgi) $ >
  $ wceq J (cfv S c1st) $ >
  $ wceq K (cfv S c2nd) $ >
  $ wceq Y (crn J) $ >
  $ wceq V (cfv K cgi) $ >
  $ wi (wa (wcel R crngo) (wcel S crngo)) (wb (wcel F (co R S crngohom)) (w3a (wf X Y F) (wceq (cfv U F) V) (wral x3 (wral y1 (wa (wceq (cfv (co (cv x3) (cv y1) G) F) (co (cfv (cv x3) F) (cfv (cv y1) F) J)) (wceq (cfv (co (cv x3) (cv y1) H) F) (co (cfv (cv x3) F) (cfv (cv y1) F) K))) X) X))) $;

--| Obsolete theorem, use ~ rhmf instead. A ring homomorphism is a function. (Contributed by Jeff Madsen, 19-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem rngohomf (R S F G J X Y: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wceq J (cfv S c1st) $ >
  $ wceq Y (crn J) $ >
  $ wi (w3a (wcel R crngo) (wcel S crngo) (wcel F (co R S crngohom))) (wf X Y F) $;

--| Obsolete theorem, use ~ rhmcl instead. Closure law for a ring homomorphism. (Contributed by Jeff Madsen, 3-Jan-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem rngohomcl (A2 R S F G J X Y: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wceq J (cfv S c1st) $ >
  $ wceq Y (crn J) $ >
  $ wi (wa (w3a (wcel R crngo) (wcel S crngo) (wcel F (co R S crngohom))) (wcel A2 X)) (wcel (cfv A2 F) Y) $;

--| Obsolete theorem, use ~ rhm1 instead. A ring homomorphism preserves ` 1 ` . (Contributed by Jeff Madsen, 24-Jun-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem rngohom1 (R S U F H K V: class):
  $ wceq H (cfv R c2nd) $ >
  $ wceq U (cfv H cgi) $ >
  $ wceq K (cfv S c2nd) $ >
  $ wceq V (cfv K cgi) $ >
  $ wi (w3a (wcel R crngo) (wcel S crngo) (wcel F (co R S crngohom))) (wceq (cfv U F) V) $;

--| Obsolete theorem, use ~ rhmadd instead. Ring homomorphisms preserve addition. (Contributed by Jeff Madsen, 3-Jan-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem rngohomadd (A2 B2 R S F G J X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wceq J (cfv S c1st) $ >
  $ wi (wa (w3a (wcel R crngo) (wcel S crngo) (wcel F (co R S crngohom))) (wa (wcel A2 X) (wcel B2 X))) (wceq (cfv (co A2 B2 G) F) (co (cfv A2 F) (cfv B2 F) J)) $;

--| Obsolete theorem, use ~ rhmmul instead. Ring homomorphisms preserve multiplication. (Contributed by Jeff Madsen, 3-Jan-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem rngohommul (A2 B2 R S F G H K X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq K (cfv S c2nd) $ >
  $ wi (wa (w3a (wcel R crngo) (wcel S crngo) (wcel F (co R S crngohom))) (wa (wcel A2 X) (wcel B2 X))) (wceq (cfv (co A2 B2 H) F) (co (cfv A2 F) (cfv B2 F) K)) $;

--| Obsolete theorem, use ~ rhmghm instead. A ring homomorphism is a group homomorphism. (Contributed by Jeff Madsen, 2-Jan-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem rngogrphom (R S F G J: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq J (cfv S c1st) $ >
  $ wi (w3a (wcel R crngo) (wcel S crngo) (wcel F (co R S crngohom))) (wcel F (co G J cghomOLD)) $;

--| Obsolete theorem, use ~ rhm0 instead. A ring homomorphism preserves ` 0 ` . (Contributed by Jeff Madsen, 2-Jan-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem rngohom0 (R S F G J W Z: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wceq J (cfv S c1st) $ >
  $ wceq W (cfv J cgi) $ >
  $ wi (w3a (wcel R crngo) (wcel S crngo) (wcel F (co R S crngohom))) (wceq (cfv Z F) W) $;

--| Obsolete theorem, use ~ rhmsub instead. Ring homomorphisms preserve subtraction. (Contributed by Jeff Madsen, 15-Jun-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem rngohomsub (A2 B2 R S F G H J K X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wceq H (cfv G cgs) $ >
  $ wceq J (cfv S c1st) $ >
  $ wceq K (cfv J cgs) $ >
  $ wi (wa (w3a (wcel R crngo) (wcel S crngo) (wcel F (co R S crngohom))) (wa (wcel A2 X) (wcel B2 X))) (wceq (cfv (co A2 B2 H) F) (co (cfv A2 F) (cfv B2 F) K)) $;

--| Obsolete theorem, use ~ rhmco instead. The composition of two ring homomorphisms is a ring homomorphism. (Contributed by Jeff Madsen, 16-Jun-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem rngohomco (R S T F G: class):
  $ wi (wa (w3a (wcel R crngo) (wcel S crngo) (wcel T crngo)) (wa (wcel F (co R S crngohom)) (wcel G (co S T crngohom)))) (wcel (ccom G F) (co R T crngohom)) $;

--| Obsolete theorem, use ~ rhmkerinj instead. A ring homomorphism is injective if and only if its kernel is zero. (Contributed by Jeff Madsen, 16-Jun-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem rngokerinj (R S F G J W X Y Z: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wceq W (cfv G cgi) $ >
  $ wceq J (cfv S c1st) $ >
  $ wceq Y (crn J) $ >
  $ wceq Z (cfv J cgi) $ >
  $ wi (w3a (wcel R crngo) (wcel S crngo) (wcel F (co R S crngohom))) (wb (wf1 X Y F) (wceq (cima (ccnv F) (csn Z)) (csn W))) $;

--| Obsolete defintion, use ~ df-rim instead. Define the function which gives the set of ring isomorphisms between two given rings. (Contributed by Jeff Madsen, 16-Jun-2011.) (New usage is discouraged.)
axiom df_rngoiso {f2 s1 r: setvar}:
  $ wceq crngoiso (cmpo r s1 crngo crngo (crab f2 (wf1o (crn (cfv (cv r) c1st)) (crn (cfv (cv s1) c1st)) (cv f2)) (co (cv r) (cv s1) crngohom))) $;

--| Obsolete theorem, use ~ rimval instead. The set of ring isomorphisms. (Contributed by Jeff Madsen, 16-Jun-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem rngoisoval {f2: setvar} (R S: class) (G J: class f2) (X Y: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wceq J (cfv S c1st) $ >
  $ wceq Y (crn J) $ >
  $ wi (wa (wcel R crngo) (wcel S crngo)) (wceq (co R S crngoiso) (crab f2 (wf1o X Y (cv f2)) (co R S crngohom))) $;

--| Obsolete theorem, use ~ isrim instead. The predicate "is a ring isomorphism between ` R ` and ` S ` ". (Contributed by Jeff Madsen, 16-Jun-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem isrngoiso (R S F G J X Y: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wceq J (cfv S c1st) $ >
  $ wceq Y (crn J) $ >
  $ wi (wa (wcel R crngo) (wcel S crngo)) (wb (wcel F (co R S crngoiso)) (wa (wcel F (co R S crngohom)) (wf1o X Y F))) $;

--| Obsolete theorem, use ~ rimf1o instead. A ring isomorphism is a bijection. (Contributed by Jeff Madsen, 16-Jun-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem rngoiso1o (R S F G J X Y: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wceq J (cfv S c1st) $ >
  $ wceq Y (crn J) $ >
  $ wi (w3a (wcel R crngo) (wcel S crngo) (wcel F (co R S crngoiso))) (wf1o X Y F) $;

--| Obsolete theorem, use ~ rimrhm instead. A ring isomorphism is a ring homomorphism. (Contributed by Jeff Madsen, 16-Jun-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem rngoisohom (R S F: class):
  $ wi (w3a (wcel R crngo) (wcel S crngo) (wcel F (co R S crngoiso))) (wcel F (co R S crngohom)) $;

--| Obsolete theorem, use ~ rimcnv instead. The inverse of a ring isomorphism is a ring isomorphism. (Contributed by Jeff Madsen, 16-Jun-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem rngoisocnv (R S F: class):
  $ wi (w3a (wcel R crngo) (wcel S crngo) (wcel F (co R S crngoiso))) (wcel (ccnv F) (co S R crngoiso)) $;

--| Obsolete theorem, use ~ rimco instead. The composition of two ring isomorphisms is a ring isomorphism. (Contributed by Jeff Madsen, 16-Jun-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem rngoisoco (R S T F G: class):
  $ wi (wa (w3a (wcel R crngo) (wcel S crngo) (wcel T crngo)) (wa (wcel F (co R S crngoiso)) (wcel G (co S T crngoiso)))) (wcel (ccom G F) (co R T crngoiso)) $;

--| Obsolete defintion, use ~ dfric2 instead. Define the ring isomorphism relation. (Contributed by Jeff Madsen, 16-Jun-2011.) (New usage is discouraged.)
axiom df_risc {f2 s1 r: setvar}:
  $ wceq crisc (copab r s1 (wa (wa (wcel (cv r) crngo) (wcel (cv s1) crngo)) (wex f2 (wcel (cv f2) (co (cv r) (cv s1) crngoiso))))) $;

--| Obsolete theorem, use ~ isbrric2 instead. The ring isomorphism relation. (Contributed by Jeff Madsen, 16-Jun-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem isriscg {f2: setvar} (A2 B2: class f2) (R S: class):
  $ wi (wa (wcel R A2) (wcel S B2)) (wb (wbr R S crisc) (wa (wa (wcel R crngo) (wcel S crngo)) (wex f2 (wcel (cv f2) (co R S crngoiso))))) $;

--| Obsolete theorem, use ~ isbrric2 instead. The ring isomorphism relation. (Contributed by Jeff Madsen, 16-Jun-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem isrisc {f2: setvar} (R S: class):
  $ wcel R cvv $ >
  $ wcel S cvv $ >
  $ wb (wbr R S crisc) (wa (wa (wcel R crngo) (wcel S crngo)) (wex f2 (wcel (cv f2) (co R S crngoiso)))) $;

--| Obsolete theorem, use ~ brric2 instead. The ring isomorphism relation. (Contributed by Jeff Madsen, 16-Jun-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem risc {f2: setvar} (R S: class):
  $ wi (wa (wcel R crngo) (wcel S crngo)) (wb (wbr R S crisc) (wex f2 (wcel (cv f2) (co R S crngoiso)))) $;

--| Obsolete theorem, use ~ brrici instead. Determine that two rings are isomorphic. (Contributed by Jeff Madsen, 16-Jun-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem risci (R S F: class):
  $ wi (w3a (wcel R crngo) (wcel S crngo) (wcel F (co R S crngoiso))) (wbr R S crisc) $;

--| Obsolete theorem, use ~ ricer instead. Ring isomorphism is an equivalence relation. (Contributed by Jeff Madsen, 16-Jun-2011.) (Revised by Mario Carneiro, 12-Aug-2015.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem riscer:
  $ wer (cdm crisc) crisc $;

--| Extend class notation with a class that adds commutativity to various flavors of rings.
term ccm2: class;

--| Obsolete definition, used in other obsolete definitions only. A device to add commutativity to various sorts of rings. I use ` ran g ` because I suppose ` g ` has a neutral element and therefore is onto. (Contributed by FL, 6-Sep-2009.) (New usage is discouraged.)
axiom df_com2 {g2 h a b: setvar}:
  $ wceq ccm2 (copab g2 h (wral a (wral b (wceq (co (cv a) (cv b) (cv h)) (co (cv b) (cv a) (cv h))) (crn (cv g2))) (crn (cv g2)))) $;

--| Extend class notation with the class of all fields.
term cfld: class;

--| Obsolete defintion, use ~ df-field instead. Definition of a field. A field is a commutative division ring. (Contributed by FL, 6-Sep-2009.) (Revised by Jeff Madsen, 10-Jun-2010.) (New usage is discouraged.)
axiom df_fld:
  $ wceq cfld (cin cdrng ccm2) $;

--| Extend class notation with the class of commutative rings.
term ccring: class;

--| Obsolete defintion, use ~ df-cring instead. Define the class of commutative rings. (Contributed by Jeff Madsen, 8-Jun-2010.) (New usage is discouraged.)
axiom df_crngo:
  $ wceq ccring (cin crngo ccm2) $;

--| Obsolete theorem, used (as lemma) in other obsolete theorems only. A device to add commutativity to various sorts of rings. (Contributed by FL, 6-Sep-2009.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem iscom2 {a b: setvar} (A2 B2: class a b) (G H: class):
  $ wi (wa (wcel G A2) (wcel H B2)) (wb (wcel (cop G H) ccm2) (wral a (wral b (wceq (co (cv a) (cv b) H) (co (cv b) (cv a) H)) (crn G)) (crn G))) $;

--| Obsolete theorem, use ~ iscrng instead. The predicate "is a commutative ring". (Contributed by Jeff Madsen, 8-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem iscrngo (R: class):
  $ wb (wcel R ccring) (wa (wcel R crngo) (wcel R ccm2)) $;

--| Obsolete theorem, use ~ iscrng2 instead. The predicate "is a commutative ring". (Contributed by Jeff Madsen, 8-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem iscrngo2 {x3 y1: setvar} (R: class) (G H: class x3 y1) (X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wb (wcel R ccring) (wa (wcel R crngo) (wral x3 (wral y1 (wceq (co (cv x3) (cv y1) H) (co (cv y1) (cv x3) H)) X) X)) $;

--| Obsolete theorem, use ~ iscrngd instead. Conditions that determine a commutative ring. (Contributed by Jeff Madsen, 20-Jun-2011.) (Revised by Mario Carneiro, 23-Dec-2013.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem iscringd {x3 y1 z: setvar} (ph: wff) (U: class z) (G H X: class):
  $ wi ph (wcel G cablo) $ >
  $ wi ph (wceq X (crn G)) $ >
  $ wi ph (wf (cxp X X) X H) $ >
  $ wi (wa ph (w3a (wcel (cv x3) X) (wcel (cv y1) X) (wcel (cv z) X))) (wceq (co (co (cv x3) (cv y1) H) (cv z) H) (co (cv x3) (co (cv y1) (cv z) H) H)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) X) (wcel (cv y1) X) (wcel (cv z) X))) (wceq (co (cv x3) (co (cv y1) (cv z) G) H) (co (co (cv x3) (cv y1) H) (co (cv x3) (cv z) H) G)) $ >
  $ wi ph (wcel U X) $ >
  $ wi (wa ph (wcel (cv y1) X)) (wceq (co (cv y1) U H) (cv y1)) $ >
  $ wi (wa ph (wa (wcel (cv x3) X) (wcel (cv y1) X))) (wceq (co (cv x3) (cv y1) H) (co (cv y1) (cv x3) H)) $ >
  $ wi ph (wcel (cop G H) ccring) $;

--| Obsolete theorem, use ~ flddrngd instead. A field is a division ring. (Contributed by Jeff Madsen, 10-Jun-2010.) (Revised by Mario Carneiro, 15-Dec-2013.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem flddivrng (K: class):
  $ wi (wcel K cfld) (wcel K cdrng) $;

--| Obsolete theorem, use ~ crngringd instead. A commutative ring is a ring. (Contributed by Jeff Madsen, 10-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem crngorngo (R: class):
  $ wi (wcel R ccring) (wcel R crngo) $;

--| Obsolete theorem, use ~ crngcom instead. The multiplication operation of a commutative ring is commutative. (Contributed by Jeff Madsen, 8-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem crngocom (A2 B2 R G H X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wi (w3a (wcel R ccring) (wcel A2 X) (wcel B2 X)) (wceq (co A2 B2 H) (co B2 A2 H)) $;

--| Obsolete theorem, use ~ crng32d instead. Commutative/associative law for commutative rings. (Contributed by Jeff Madsen, 19-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem crngm23 (A2 B2 C R G H X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wcel R ccring) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wceq (co (co A2 B2 H) C H) (co (co A2 C H) B2 H)) $;

--| Obsolete theorem, use ~ crng4 instead. Commutative/associative law for commutative rings. (Contributed by Jeff Madsen, 19-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem crngm4 (A2 B2 C D R G H X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wi (w3a (wcel R ccring) (wa (wcel A2 X) (wcel B2 X)) (wa (wcel C X) (wcel D X))) (wceq (co (co A2 B2 H) (co C D H) H) (co (co A2 C H) (co B2 D H) H)) $;

--| Obsolete theorem, use ~ fldcrngd instead. A field is a commutative ring. (Contributed by Jeff Madsen, 8-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem fldcrngo (K: class):
  $ wi (wcel K cfld) (wcel K ccring) $;

--| Obsolete theorem, use ~ isfld instead. The predicate "is a field". (Contributed by Jeff Madsen, 10-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem isfld2 (K: class):
  $ wb (wcel K cfld) (wa (wcel K cdrng) (wcel K ccring)) $;

--| Obsolete theorem, use ~ crngrhmfo instead. The image of a homomorphism from a commutative ring is commutative. (Contributed by Jeff Madsen, 4-Jan-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem crngohomfo (R S F G J X Y: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wceq J (cfv S c1st) $ >
  $ wceq Y (crn J) $ >
  $ wi (wa (wa (wcel R ccring) (wcel S crngo)) (wa (wcel F (co R S crngohom)) (wfo X Y F))) (wcel S ccring) $;

--| Extend class notation with the class of ideals.
term cidl: class;

--| Extend class notation with the class of prime ideals.
term cpridl: class;

--| Extend class notation with the class of maximal ideals.
term cmaxidl: class;

--| Obsolete defintion, use ~ df-2idl (or ~ df-lidl ) instead. Define the class of (two-sided) ideals of a ring ` R ` . A subset of ` R ` is an ideal if it contains ` 0 ` , is closed under addition, and is closed under multiplication on either side by any element of ` R ` . (Contributed by Jeff Madsen, 10-Jun-2010.) (New usage is discouraged.)
axiom df_idl {x3 y1 z i r: setvar}:
  $ wceq cidl (cmpt r crngo (crab i (wa (wcel (cfv (cfv (cv r) c1st) cgi) (cv i)) (wral x3 (wa (wral y1 (wcel (co (cv x3) (cv y1) (cfv (cv r) c1st)) (cv i)) (cv i)) (wral z (wa (wcel (co (cv z) (cv x3) (cfv (cv r) c2nd)) (cv i)) (wcel (co (cv x3) (cv z) (cfv (cv r) c2nd)) (cv i))) (crn (cfv (cv r) c1st)))) (cv i))) (cpw (crn (cfv (cv r) c1st))))) $;

--| Obsolete defintion, use ~ df-prmidl instead. Define the class of prime ideals of a ring ` R ` . A proper ideal ` I ` of ` R ` is prime if whenever ` A B C_ I ` for ideals ` A ` and ` B ` , either ` A C_ I ` or ` B C_ I ` . The more familiar definition using elements rather than ideals is equivalent provided ` R ` is commutative; see ~ ispridl2 and ~ ispridlc . (Contributed by Jeff Madsen, 10-Jun-2010.) (New usage is discouraged.)
axiom df_pridl {x3 y1 i r a b: setvar}:
  $ wceq cpridl (cmpt r crngo (crab i (wa (wne (cv i) (crn (cfv (cv r) c1st))) (wral a (wral b (wi (wral x3 (wral y1 (wcel (co (cv x3) (cv y1) (cfv (cv r) c2nd)) (cv i)) (cv b)) (cv a)) (wo (wss (cv a) (cv i)) (wss (cv b) (cv i)))) (cfv (cv r) cidl)) (cfv (cv r) cidl))) (cfv (cv r) cidl))) $;

--| Obsolete defintion, use ~ df-mxidl instead. Define the class of maximal ideals of a ring ` R ` . A proper ideal is called maximal if it is maximal with respect to inclusion among proper ideals. (Contributed by Jeff Madsen, 5-Jan-2011.) (New usage is discouraged.)
axiom df_maxidl {i j r: setvar}:
  $ wceq cmaxidl (cmpt r crngo (crab i (wa (wne (cv i) (crn (cfv (cv r) c1st))) (wral j (wi (wss (cv i) (cv j)) (wo (wceq (cv j) (cv i)) (wceq (cv j) (crn (cfv (cv r) c1st))))) (cfv (cv r) cidl))) (cfv (cv r) cidl))) $;

--| Obsolete theorem, use ~ 2idlval instead. The class of ideals of a ring. (Contributed by Jeff Madsen, 10-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem idlval {x3 y1 z i: setvar} (R: class) (G H: class x3 y1 z) (X: class x3 y1) (Z: class x3 y1 z):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wi (wcel R crngo) (wceq (cfv R cidl) (crab i (wa (wcel Z (cv i)) (wral x3 (wa (wral y1 (wcel (co (cv x3) (cv y1) G) (cv i)) (cv i)) (wral z (wa (wcel (co (cv z) (cv x3) H) (cv i)) (wcel (co (cv x3) (cv z) H) (cv i))) X)) (cv i))) (cpw X))) $;

--| Obsolete theorem, use ~ df2idl2 instead. The predicate "is an ideal of the ring ` R ` ". (Contributed by Jeff Madsen, 10-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem isidl {x3 y1 z: setvar} (R: class) (G H: class x3 y1 z) (I: class) (X: class x3 y1) (Z: class x3 y1 z):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wi (wcel R crngo) (wb (wcel I (cfv R cidl)) (w3a (wss I X) (wcel Z I) (wral x3 (wa (wral y1 (wcel (co (cv x3) (cv y1) G) I) I) (wral z (wa (wcel (co (cv z) (cv x3) H) I) (wcel (co (cv x3) (cv z) H) I)) X)) I))) $;

--| Obsolete theorem, use ~ df2idl2crng instead. The predicate "is an ideal of the commutative ring ` R ` ". (Contributed by Jeff Madsen, 10-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem isidlc {x3 y1 z: setvar} (R: class) (G H: class x3 y1 z) (I: class) (X: class y1) (Z: class x3 y1 z):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wi (wcel R ccring) (wb (wcel I (cfv R cidl)) (w3a (wss I X) (wcel Z I) (wral x3 (wa (wral y1 (wcel (co (cv x3) (cv y1) G) I) I) (wral z (wcel (co (cv z) (cv x3) H) I) X)) I))) $;

--| Obsolete theorem, use ~ 2idlss instead. An ideal of ` R ` is a subset of ` R ` . (Contributed by Jeff Madsen, 10-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem idlss (R G I X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wcel R crngo) (wcel I (cfv R cidl))) (wss I X) $;

--| Obsolete theorem, use ~ 2idllidld and ~ lidlbasel instead. An element of an ideal is an element of the ring. (Contributed by Jeff Madsen, 19-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem idlcl (A2 R G I X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wa (wcel R crngo) (wcel I (cfv R cidl))) (wcel A2 I)) (wcel A2 X) $;

--| Obsolete theorem, use ~ ringrng and ~ rng2idl0 instead. An ideal contains ` 0 ` . (Contributed by Jeff Madsen, 10-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem idl0cl (R G I Z: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wi (wa (wcel R crngo) (wcel I (cfv R cidl))) (wcel Z I) $;

--| Obsolete theorem, use ~ 2idllidld and ~ lidlacl instead. An ideal is closed under addition. (Contributed by Jeff Madsen, 10-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem idladdcl (A2 B2 R G I: class):
  $ wceq G (cfv R c1st) $ >
  $ wi (wa (wa (wcel R crngo) (wcel I (cfv R cidl))) (wa (wcel A2 I) (wcel B2 I))) (wcel (co A2 B2 G) I) $;

--| Obsolete theorem, use ~ 2idllidld and ~ lidlmcl instead. An ideal is closed under multiplication on the left. (Contributed by Jeff Madsen, 10-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem idllmulcl (A2 B2 R G H I X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wa (wcel R crngo) (wcel I (cfv R cidl))) (wa (wcel A2 I) (wcel B2 X))) (wcel (co B2 A2 H) I) $;

--| Obsolete theorem, use ~ 2idlridld and ~ lidlmcl instead. An ideal is closed under multiplication on the right. (Contributed by Jeff Madsen, 10-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem idlrmulcl (A2 B2 R G H I X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wa (wcel R crngo) (wcel I (cfv R cidl))) (wa (wcel A2 I) (wcel B2 X))) (wcel (co A2 B2 H) I) $;

--| Obsolete theorem, use ~ 2idllidld and ~ lidlnegcl instead. An ideal is closed under negation. (Contributed by Jeff Madsen, 10-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem idlnegcl (A2 R G I N: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq N (cfv G cgn) $ >
  $ wi (wa (wa (wcel R crngo) (wcel I (cfv R cidl))) (wcel A2 I)) (wcel (cfv A2 N) I) $;

--| Obsolete theorem, use ~ 2idllidld and ~ lidlsubcl instead. An ideal is closed under subtraction. (Contributed by Jeff Madsen, 19-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem idlsubcl (A2 B2 D R G I: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq D (cfv G cgs) $ >
  $ wi (wa (wa (wcel R crngo) (wcel I (cfv R cidl))) (wa (wcel A2 I) (wcel B2 I))) (wcel (co A2 B2 D) I) $;

--| Obsolete theorem, use ~ 2idl1 instead. A ring ` R ` is an ` R ` ideal. (Contributed by Jeff Madsen, 10-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem rngoidl (R G X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wi (wcel R crngo) (wcel X (cfv R cidl)) $;

--| Obsolete theorem, use ~ 2idl0 instead. The set containing only ` 0 ` is an ideal. (Contributed by Jeff Madsen, 10-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem _0idl (R G Z: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wi (wcel R crngo) (wcel (csn Z) (cfv R cidl)) $;

--| Obsolete theorem, use ~ 2idl1el instead. Two ways of expressing the unit ideal. (Contributed by Jeff Madsen, 10-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem _1idl (R U G H I X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wceq U (cfv H cgi) $ >
  $ wi (wa (wcel R crngo) (wcel I (cfv R cidl))) (wb (wcel U I) (wceq I X)) $;

--| Obsolete theorem, use ~ 0ring01eqbi2 instead. In a ring, ` 0 = 1 ` iff the ring contains only ` 0 ` . (Contributed by Jeff Madsen, 6-Jan-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem _0rngo (R U G H X Z: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wceq U (cfv H cgi) $ >
  $ wi (wcel R crngo) (wb (wceq Z U) (wceq X (csn Z))) $;

--| Obsolete theorem, use ~ drngnidl instead. The only ideals in a division ring are the zero ideal and the unit ideal. (Contributed by Jeff Madsen, 10-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem divrngidl (R G H X Z: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wi (wcel R cdrng) (wceq (cfv R cidl) (cpr (csn Z) X)) $;

--| Obsolete theorem, use ~ intlidl instead. The intersection of a nonempty collection of ideals is an ideal. (Contributed by Jeff Madsen, 10-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem intidl (C R: class):
  $ wi (w3a (wcel R crngo) (wne C c0) (wss C (cfv R cidl))) (wcel (cint C) (cfv R cidl)) $;

--| Obsolete theorem, use ~ inlidl instead. The intersection of two ideals is an ideal. (Contributed by Jeff Madsen, 16-Jun-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem inidl (R I J: class):
  $ wi (w3a (wcel R crngo) (wcel I (cfv R cidl)) (wcel J (cfv R cidl))) (wcel (cin I J) (cfv R cidl)) $;

--| Obsolete theorem, use ~ unichnlidl instead. The union of a nonempty chain of ideals is an ideal. (Contributed by Jeff Madsen, 5-Jan-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem unichnidl {i j: setvar} (C: class) (R: class j):
  $ wi (wa (wcel R crngo) (w3a (wne C c0) (wss C (cfv R cidl)) (wral i (wral j (wo (wss (cv i) (cv j)) (wss (cv j) (cv i))) C) C))) (wcel (cuni C) (cfv R cidl)) $;

--| Obsolete theorem, use ~ ker2idl instead. The kernel of a ring homomorphism is an ideal. (Contributed by Jeff Madsen, 3-Jan-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem keridl (R S F G Z: class):
  $ wceq G (cfv S c1st) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wi (w3a (wcel R crngo) (wcel S crngo) (wcel F (co R S crngohom))) (wcel (cima (ccnv F) (csn Z)) (cfv R cidl)) $;

--| Obsolete theorem, use ~ prmidlval instead. The class of prime ideals of a ring ` R ` . (Contributed by Jeff Madsen, 10-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem pridlval {x3 y1 i a b: setvar} (R: class) (G: class x3 y1 i a b) (H X: class x3 y1 a b):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wi (wcel R crngo) (wceq (cfv R cpridl) (crab i (wa (wne (cv i) X) (wral a (wral b (wi (wral x3 (wral y1 (wcel (co (cv x3) (cv y1) H) (cv i)) (cv b)) (cv a)) (wo (wss (cv a) (cv i)) (wss (cv b) (cv i)))) (cfv R cidl)) (cfv R cidl))) (cfv R cidl))) $;

--| Obsolete theorem, use ~ isprmidl instead. The predicate "is a prime ideal". (Contributed by Jeff Madsen, 10-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ispridl {x3 y1 a b: setvar} (P R: class) (G H X: class x3 y1 a b):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wi (wcel R crngo) (wb (wcel P (cfv R cpridl)) (w3a (wcel P (cfv R cidl)) (wne P X) (wral a (wral b (wi (wral x3 (wral y1 (wcel (co (cv x3) (cv y1) H) P) (cv b)) (cv a)) (wo (wss (cv a) P) (wss (cv b) P))) (cfv R cidl)) (cfv R cidl)))) $;

--| Obsolete theorem, use ~ prmidlidl instead. A prime ideal is an ideal. (Contributed by Jeff Madsen, 19-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem pridlidl (P R: class):
  $ wi (wa (wcel R crngo) (wcel P (cfv R cpridl))) (wcel P (cfv R cidl)) $;

--| Obsolete theorem, use ~ prmidlnr instead. A prime ideal is a proper ideal. (Contributed by Jeff Madsen, 19-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem pridlnr (P R G X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wcel R crngo) (wcel P (cfv R cpridl))) (wne P X) $;

--| Obsolete theorem, use ~ isprmidlc instead. The main property of a prime ideal. (Contributed by Jeff Madsen, 19-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem pridl {x3 y1: setvar} (A2: class y1) (B2 P R: class) (H: class x3 y1):
  $ wceq H (cfv R c2nd) $ >
  $ wi (wa (wa (wcel R crngo) (wcel P (cfv R cpridl))) (w3a (wcel A2 (cfv R cidl)) (wcel B2 (cfv R cidl)) (wral x3 (wral y1 (wcel (co (cv x3) (cv y1) H) P) B2) A2))) (wo (wss A2 P) (wss B2 P)) $;

--| Obsolete theorem, use ~ prmidl2 instead. A condition that shows an ideal is prime. For commutative rings, this is often taken to be the definition. See ~ ispridlc for the equivalence in the commutative case. (Contributed by Jeff Madsen, 19-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ispridl2 {a b: setvar} (P R: class) (G H: class a b) (X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wcel R crngo) (w3a (wcel P (cfv R cidl)) (wne P X) (wral a (wral b (wi (wcel (co (cv a) (cv b) H) P) (wo (wcel (cv a) P) (wcel (cv b) P))) X) X))) (wcel P (cfv R cpridl)) $;

--| Obsolete theorem, use ~ mxidlval instead. The set of maximal ideals of a ring. (Contributed by Jeff Madsen, 5-Jan-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem maxidlval {i j: setvar} (R: class) (G X: class i j):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wi (wcel R crngo) (wceq (cfv R cmaxidl) (crab i (wa (wne (cv i) X) (wral j (wi (wss (cv i) (cv j)) (wo (wceq (cv j) (cv i)) (wceq (cv j) X))) (cfv R cidl))) (cfv R cidl))) $;

--| Obsolete theorem, use ~ ismxidl instead. The predicate "is a maximal ideal". (Contributed by Jeff Madsen, 5-Jan-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ismaxidl {j: setvar} (R: class) (G: class j) (M: class) (X: class j):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wi (wcel R crngo) (wb (wcel M (cfv R cmaxidl)) (w3a (wcel M (cfv R cidl)) (wne M X) (wral j (wi (wss M (cv j)) (wo (wceq (cv j) M) (wceq (cv j) X))) (cfv R cidl)))) $;

--| Obsolete theorem, use ~ mxidlidl instead. A maximal ideal is an ideal. (Contributed by Jeff Madsen, 5-Jan-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem maxidlidl (R M: class):
  $ wi (wa (wcel R crngo) (wcel M (cfv R cmaxidl))) (wcel M (cfv R cidl)) $;

--| Obsolete theorem, use ~ mxidlnr instead. A maximal ideal is proper. (Contributed by Jeff Madsen, 16-Jun-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem maxidlnr (R G M X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wcel R crngo) (wcel M (cfv R cmaxidl))) (wne M X) $;

--| Obsolete theorem, use ~ mxidlmax instead. A maximal ideal is a maximal proper ideal. (Contributed by Jeff Madsen, 16-Jun-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem maxidlmax (R G I M X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wa (wcel R crngo) (wcel M (cfv R cmaxidl))) (wa (wcel I (cfv R cidl)) (wss M I))) (wo (wceq I M) (wceq I X)) $;

--| Obsolete theorem, use ~ mxidln1 instead. One is not contained in any maximal ideal. (Contributed by Jeff Madsen, 17-Jun-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem maxidln1 (R U H M: class):
  $ wceq H (cfv R c2nd) $ >
  $ wceq U (cfv H cgi) $ >
  $ wi (wa (wcel R crngo) (wcel M (cfv R cmaxidl))) (wn (wcel U M)) $;

--| Obsolete theorem, use ~ mxidlnzr instead. A ring with a maximal ideal is not the zero ring. (Contributed by Jeff Madsen, 17-Jun-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem maxidln0 (R U G H M Z: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wceq U (cfv H cgi) $ >
  $ wi (wa (wcel R crngo) (wcel M (cfv R cmaxidl))) (wne U Z) $;

--| Extend class notation with the class of prime rings.
term cprrng: class;

--| Extend class notation with the class of domains.
term cdmn: class;

--| Obsolete definition, use ~ df-prmring instead. Define the class of prime rings. A ring is prime if the zero ideal is a prime ideal. (Contributed by Jeff Madsen, 10-Jun-2010.) (New usage is discouraged.)
axiom df_prrngo {r: setvar}:
  $ wceq cprrng (crab r (wcel (csn (cfv (cfv (cv r) c1st) cgi)) (cfv (cv r) cpridl)) crngo) $;

--| Obsolete definition, use ~ df-idom resp. ~ dfidom2 instead. Define the class of (integral) domains. A domain is a commutative prime ring. (Contributed by Jeff Madsen, 10-Jun-2010.) (New usage is discouraged.)
axiom df_dmn:
  $ wceq cdmn (cin cprrng ccm2) $;

--| Obsolete theorem, use ~ isprmrng instead. The predicate "is a prime ring". (Contributed by Jeff Madsen, 10-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem isprrngo (R G Z: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wb (wcel R cprrng) (wa (wcel R crngo) (wcel (csn Z) (cfv R cpridl))) $;

--| Obsolete theorem, use ~ prmrngring instead. A prime ring is a ring. (Contributed by Jeff Madsen, 10-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem prrngorngo (R: class):
  $ wi (wcel R cprrng) (wcel R crngo) $;

--| Obsolete theorem, use ~ smprngprmrng instead. A simple ring (one whose only ideals are ` 0 ` and ` R ` ) is a prime ring. (Contributed by Jeff Madsen, 6-Jan-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem smprngopr (R U G H X Z: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wceq U (cfv H cgi) $ >
  $ wi (w3a (wcel R crngo) (wne U Z) (wceq (cfv R cidl) (cpr (csn Z) X))) (wcel R cprrng) $;

--| Obsolete theorem, use ~ drngprmrng instead. A division ring is a prime ring. (Contributed by Jeff Madsen, 6-Jan-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem divrngpr (R: class):
  $ wi (wcel R cdrng) (wcel R cprrng) $;

--| Obsolete theorem, use ~ isidom2 instead. The predicate "is a domain". (Contributed by Jeff Madsen, 10-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem isdmn (R: class):
  $ wb (wcel R cdmn) (wa (wcel R cprrng) (wcel R ccm2)) $;

--| Obsolete theorem, use ~ isidom2 instead. The predicate "is a domain". (Contributed by Jeff Madsen, 10-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem isdmn2 (R: class):
  $ wb (wcel R cdmn) (wa (wcel R cprrng) (wcel R ccring)) $;

--| Obsolete theorem, use ~ idomcringd instead. A domain is a commutative ring. (Contributed by Jeff Madsen, 6-Jan-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem dmncrng (R: class):
  $ wi (wcel R cdmn) (wcel R ccring) $;

--| Obsolete theorem, use ~ idomringd instead. A domain is a ring. (Contributed by Jeff Madsen, 6-Jan-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem dmnrngo (R: class):
  $ wi (wcel R cdmn) (wcel R crngo) $;

--| Obsolete theorem, use ~ fldidom instead. A field is a domain. (Contributed by Jeff Madsen, 10-Jun-2010.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem flddmn (K: class):
  $ wi (wcel K cfld) (wcel K cdmn) $;

--| Extend class notation with the ideal generation function.
term cigen: class;

--| Obsolete definition, use ~ df-rsp instead. Define the ideal generated by a subset of a ring. (Contributed by Jeff Madsen, 10-Jun-2010.) (New usage is discouraged.)
axiom df_igen {j s1 r: setvar}:
  $ wceq cigen (cmpo r s1 crngo (cpw (crn (cfv (cv r) c1st))) (cint (crab j (wss (cv s1) (cv j)) (cfv (cv r) cidl)))) $;

--| Obsolete theorem, use ~ rspvalint instead. The ideal generated by a subset of a ring. (Contributed by Jeff Madsen, 10-Jun-2010.) (Proof shortened by Mario Carneiro, 20-Dec-2013.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem igenval {j: setvar} (R S: class) (G: class j) (X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wcel R crngo) (wss S X)) (wceq (co R S cigen) (cint (crab j (wss S (cv j)) (cfv R cidl)))) $;

--| Obsolete theorem, use ~ rspssid instead. A set is a subset of the ideal it generates. (Contributed by Jeff Madsen, 10-Jun-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem igenss (R S G X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wcel R crngo) (wss S X)) (wss S (co R S cigen)) $;

--| Obsolete theorem, use ~ rspcl instead. The ideal generated by a set is an ideal. (Contributed by Jeff Madsen, 10-Jun-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem igenidl (R S G X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wcel R crngo) (wss S X)) (wcel (co R S cigen) (cfv R cidl)) $;

--| Obsolete theorem, use ~ rspssp instead. The ideal generated by a set is the minimal ideal containing that set. (Contributed by Jeff Madsen, 10-Jun-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem igenmin (R S I: class):
  $ wi (w3a (wcel R crngo) (wcel I (cfv R cidl)) (wss S I)) (wss (co R S cigen) I) $;

--| Obsolete theorem, use ~ rsp2idlid instead. The ideal generated by an ideal is that ideal. (Contributed by Jeff Madsen, 10-Jun-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem igenidl2 (R I: class):
  $ wi (wa (wcel R crngo) (wcel I (cfv R cidl))) (wceq (co R I cigen) I) $;

--| Obsolete theorem, use ~ rspprop instead. The ideal generated by a subset of a ring. (Contributed by Jeff Madsen, 10-Jun-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem igenval2 {j: setvar} (R S: class) (G: class j) (I: class) (X: class j):
  $ wceq G (cfv R c1st) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wcel R crngo) (wss S X)) (wb (wceq (co R S cigen) I) (w3a (wcel I (cfv R cidl)) (wss S I) (wral j (wi (wss S (cv j)) (wss I (cv j))) (cfv R cidl)))) $;

--| Obsolete theorem, use ~ rspsn0 instead (holds for arbitrary rings). A principal ideal (an ideal generated by one element) in a commutative ring. (Contributed by Jeff Madsen, 10-Jun-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem prnc {x3 y1: setvar} (A2 R G H X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wcel R ccring) (wcel A2 X)) (wceq (co R (csn A2) cigen) (crab x3 (wrex y1 (wceq (cv x3) (co (cv y1) A2 H)) X) X)) $;

--| Obsolete theorem, use ~ isfieldidl instead. Determine if a ring is a field based on its ideals. (Contributed by Jeff Madsen, 10-Jun-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem isfldidl (U G H K X Z: class):
  $ wceq G (cfv K c1st) $ >
  $ wceq H (cfv K c2nd) $ >
  $ wceq X (crn G) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wceq U (cfv H cgi) $ >
  $ wb (wcel K cfld) (w3a (wcel K ccring) (wne U Z) (wceq (cfv K cidl) (cpr (csn Z) X))) $;

--| Obsolete theorem, use ~ isfieldidl2 instead. Determine if a ring is a field based on its ideals. (Contributed by Jeff Madsen, 6-Jan-2011.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem isfldidl2 (G H K X Z: class):
  $ wceq G (cfv K c1st) $ >
  $ wceq H (cfv K c2nd) $ >
  $ wceq X (crn G) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wb (wcel K cfld) (w3a (wcel K ccring) (wne X (csn Z)) (wceq (cfv K cidl) (cpr (csn Z) X))) $;

--| Obsolete theorem, use ~ isprmidlc instead. The predicate "is a prime ideal". Alternate definition for commutative rings. (Contributed by Jeff Madsen, 19-Jun-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem ispridlc {a b: setvar} (P R: class) (G: class a b) (H X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wi (wcel R ccring) (wb (wcel P (cfv R cpridl)) (w3a (wcel P (cfv R cidl)) (wne P X) (wral a (wral b (wi (wcel (co (cv a) (cv b) H) P) (wo (wcel (cv a) P) (wcel (cv b) P))) X) X))) $;

--| Obsolete theorem, use ~ prmidlc instead. Property of a prime ideal in a commutative ring. (Contributed by Jeff Madsen, 17-Jun-2011.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem pridlc (A2 B2 P R G H X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wa (wcel R ccring) (wcel P (cfv R cpridl))) (w3a (wcel A2 X) (wcel B2 X) (wcel (co A2 B2 H) P))) (wo (wcel A2 P) (wcel B2 P)) $;

--| Obsolete theorem, use ~ prmidlc2 instead. Property of a prime ideal in a commutative ring. (Contributed by Jeff Madsen, 17-Jun-2011.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem pridlc2 (A2 B2 P R G H X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wa (wcel R ccring) (wcel P (cfv R cpridl))) (w3a (wcel A2 (cdif X P)) (wcel B2 X) (wcel (co A2 B2 H) P))) (wcel B2 P) $;

--| Obsolete theorem, use ~ cmprmidlmcl instead. Property of a prime ideal in a commutative ring. (Contributed by Jeff Madsen, 17-Jun-2011.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem pridlc3 (A2 B2 P R G H X: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wa (wcel R ccring) (wcel P (cfv R cpridl))) (wa (wcel A2 (cdif X P)) (wcel B2 (cdif X P)))) (wcel (co A2 B2 H) (cdif X P)) $;

--| Obsolete theorem, use ~ isidom3 instead. The predicate "is a domain", alternate expression. (Contributed by Jeff Madsen, 19-Jun-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem isdmn3 {a b: setvar} (R: class) (U G: class a b) (H X Z: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wceq U (cfv H cgi) $ >
  $ wb (wcel R cdmn) (w3a (wcel R ccring) (wne U Z) (wral a (wral b (wi (wceq (co (cv a) (cv b) H) Z) (wo (wceq (cv a) Z) (wceq (cv b) Z))) X) X)) $;

--| Obsolete theorem, use ~ idomnzd instead. A domain has no zero-divisors (besides zero). (Contributed by Jeff Madsen, 19-Jun-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem dmnnzd (A2 B2 R G H X Z: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wi (wa (wcel R cdmn) (w3a (wcel A2 X) (wcel B2 X) (wceq (co A2 B2 H) Z))) (wo (wceq A2 Z) (wceq B2 Z)) $;

--| Obsolete theorem, use ~ idomcanl instead. Cancellation law for domains. (Contributed by Jeff Madsen, 6-Jan-2011.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem dmncan1 (A2 B2 C R G H X Z: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wi (wa (wa (wcel R cdmn) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wne A2 Z)) (wi (wceq (co A2 B2 H) (co A2 C H)) (wceq B2 C)) $;

--| Obsolete theorem, use ~ idomcanr instead. Cancellation law for domains. (Contributed by Jeff Madsen, 6-Jan-2011.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem dmncan2 (A2 B2 C R G H X Z: class):
  $ wceq G (cfv R c1st) $ >
  $ wceq H (cfv R c2nd) $ >
  $ wceq X (crn G) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wi (wa (wa (wcel R cdmn) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wne C Z)) (wi (wceq (co A2 C H) (co B2 C H)) (wceq A2 B2)) $;

--| A proof by contradiction. (Contributed by Giovanni Mascellani, 15-Sep-2017.)
theorem efald2 (ph: wff):
  $ wi (wn ph) wfal $ >
  $ ph $;

--| Simplification rule of negation across a biconditional. (Contributed by Giovanni Mascellani, 15-Sep-2017.)
theorem notbinot1 (ph ps: wff):
  $ wb (wn (wb (wn ph) ps)) (wb ph ps) $;

--| Biconditional of its own negation is a contradiction. (Contributed by Giovanni Mascellani, 15-Sep-2017.)
theorem bicontr (ph: wff):
  $ wb (wb (wn ph) ph) wfal $;

--| An equivalent formula for implying a disjunction. (Contributed by Giovanni Mascellani, 15-Sep-2017.)
theorem impor (ph ps ch: wff):
  $ wb (wi ph (wo ps ch)) (wo (wo (wn ph) ps) ch) $;

--| The falsum ` F. ` can be removed from a disjunction. (Contributed by Giovanni Mascellani, 15-Sep-2017.)
theorem orfa (ph: wff):
  $ wb (wo ph wfal) ph $;

--| Commutation rule between negation and biconditional. (Contributed by Giovanni Mascellani, 15-Sep-2017.)
theorem notbinot2 (ph ps: wff):
  $ wb (wn (wb ph ps)) (wb (wn ph) ps) $;

--| A rewriting rule for biconditional. (Contributed by Giovanni Mascellani, 15-Sep-2017.)
theorem biimpor (ph ps ch: wff):
  $ wb (wi (wb ph ps) ch) (wo (wb (wn ph) ps) ch) $;

--| Add a contradicting disjunct to an antecedent. (Contributed by Giovanni Mascellani, 15-Sep-2017.)
theorem orfa1 (ph ps: wff):
  $ wi ph ps $ >
  $ wi (wo ph wfal) ps $;

--| Remove a contradicting disjunct from an antecedent. (Contributed by Giovanni Mascellani, 15-Sep-2017.)
theorem orfa2 (ph ps: wff):
  $ wi ph wfal $ >
  $ wi (wo ph ps) ps $;

--| Infer the equivalence to a contradiction from a negation, in deduction form. (Contributed by Giovanni Mascellani, 15-Sep-2017.)
theorem bifald (ph ps: wff):
  $ wi ph (wn ps) $ >
  $ wi ph (wb ps wfal) $;

--| A lemma for Conjunctive Normal Form unit propagation, in double deduction form. (Contributed by Giovanni Mascellani, 19-Mar-2018.)
theorem cnf1dd (ph ps ch th: wff):
  $ wi ph (wi ps (wn ch)) $ >
  $ wi ph (wi ps (wo ch th)) $ >
  $ wi ph (wi ps th) $;

--| A lemma for Conjunctive Normal Form unit propagation, in double deduction form. (Contributed by Giovanni Mascellani, 19-Mar-2018.)
theorem cnf2dd (ph ps ch th: wff):
  $ wi ph (wi ps (wn th)) $ >
  $ wi ph (wi ps (wo ch th)) $ >
  $ wi ph (wi ps ch) $;

--| A lemma for Conjunctive Normal Form unit propagation, in double deduction form. (Contributed by Giovanni Mascellani, 19-Mar-2018.)
theorem cnfn1dd (ph ps ch th: wff):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi ps (wo (wn ch) th)) $ >
  $ wi ph (wi ps th) $;

--| A lemma for Conjunctive Normal Form unit propagation, in double deduction form. (Contributed by Giovanni Mascellani, 19-Mar-2018.)
theorem cnfn2dd (ph ps ch th: wff):
  $ wi ph (wi ps th) $ >
  $ wi ph (wi ps (wo ch (wn th))) $ >
  $ wi ph (wi ps ch) $;

--| A rearrangement of disjuncts, in double deduction form. (Contributed by Giovanni Mascellani, 19-Mar-2018.)
theorem or32dd (ph ps ch th ta: wff):
  $ wi ph (wi ps (wo (wo ch th) ta)) $ >
  $ wi ph (wi ps (wo (wo ch ta) th)) $;

--| A lemma for not-or-not elimination, in deduction form. (Contributed by Giovanni Mascellani, 19-Mar-2018.)
theorem notornotel1 (ph ps ch: wff):
  $ wi ph (wn (wo (wn ps) ch)) $ >
  $ wi ph ps $;

--| A lemma for not-or-not elimination, in deduction form. (Contributed by Giovanni Mascellani, 19-Mar-2018.)
theorem notornotel2 (ph ps ch: wff):
  $ wi ph (wn (wo ps (wn ch))) $ >
  $ wi ph ch $;

--| A proof by contradiction, in deduction form. (Contributed by Giovanni Mascellani, 19-Mar-2018.)
theorem contrd (ph ps ch: wff):
  $ wi ph (wi (wn ps) ch) $ >
  $ wi ph (wi (wn ps) (wn ch)) $ >
  $ wi ph ps $;

--| An inference from commuting operands in a chain of conjunctions. (Contributed by Giovanni Mascellani, 22-May-2019.)
theorem an12i (ph ps ch: wff):
  $ wa ph (wa ps ch) $ >
  $ wa ps (wa ph ch) $;

--| An excluded middle law. (Contributed by Giovanni Mascellani, 23-May-2019.)
theorem exmid2 (ph ps ch et: wff):
  $ wi (wa ps ph) ch $ >
  $ wi (wa (wn ps) et) ch $ >
  $ wi (wa ph et) ch $;

--| An inference for selecting one of a list of conjuncts. (Contributed by Giovanni Mascellani, 23-May-2019.)
theorem selconj (ph ps ch et: wff):
  $ wb ph (wa ps ch) $ >
  $ wb (wa et ph) (wa ps (wa et ch)) $;

--| Add true as a conjunct. (Contributed by Giovanni Mascellani, 23-May-2019.)
theorem truconj (ph: wff):
  $ wb ph (wa wtru ph) $;

--| An inference for disjunction elimination. (Contributed by Giovanni Mascellani, 24-May-2019.)
theorem orel (ph ps ch th et rh: wff):
  $ wi (wa ps et) th $ >
  $ wi (wa ch rh) th $ >
  $ wi ph (wo ps ch) $ >
  $ wi (wa ph (wa et rh)) th $;

--| An inference for negation elimination. (Contributed by Giovanni Mascellani, 24-May-2019.)
theorem negel (ph ps ch: wff):
  $ wi ps ch $ >
  $ wi ph (wn ch) $ >
  $ wi (wa ph ps) wfal $;

--| An inference for bottom elimination. (Contributed by Giovanni Mascellani, 24-May-2019.)
theorem botel (ph ps: wff):
  $ wi ph wfal $ >
  $ wi ph ps $;

--| Add top ad a conjunct. (Contributed by Giovanni Mascellani, 24-May-2019.)
theorem tradd (ph ps: wff):
  $ wb ph ps $ >
  $ wb ph (wa wtru ps) $;

--| Substitution does not change truth. (Contributed by Giovanni Mascellani, 24-May-2019.)
theorem gm_sbtru {x3: setvar} (A2: class x3):
  $ wcel A2 cvv $ >
  $ wb (wsbc x3 wtru A2) wtru $;

--| Substitution does not change falsity. (Contributed by Giovanni Mascellani, 24-May-2019.)
theorem sbfal {x3: setvar} (A2: class x3):
  $ wcel A2 cvv $ >
  $ wb (wsbc x3 wfal A2) wfal $;

--| Distribution of class substitution over conjunction, in inference form. (Contributed by Giovanni Mascellani, 27-May-2019.)
theorem sbcani {x3: setvar} (ph ps ch et: wff x3) (A2: class x3):
  $ wb (wsbc x3 ph A2) ch $ >
  $ wb (wsbc x3 ps A2) et $ >
  $ wb (wsbc x3 (wa ph ps) A2) (wa ch et) $;

--| Distribution of class substitution over disjunction, in inference form. (Contributed by Giovanni Mascellani, 27-May-2019.)
theorem sbcori {x3: setvar} (ph ps ch et: wff x3) (A2: class x3):
  $ wb (wsbc x3 ph A2) ch $ >
  $ wb (wsbc x3 ps A2) et $ >
  $ wb (wsbc x3 (wo ph ps) A2) (wo ch et) $;

--| Distribution of class substitution over implication, in inference form. (Contributed by Giovanni Mascellani, 27-May-2019.)
theorem sbcimi {x3: setvar} (ph ps ch et: wff x3) (A2: class x3):
  $ wcel A2 cvv $ >
  $ wb (wsbc x3 ph A2) ch $ >
  $ wb (wsbc x3 ps A2) et $ >
  $ wb (wsbc x3 (wi ph ps) A2) (wi ch et) $;

--| Move class substitution inside a negation, in inference form. (Contributed by Giovanni Mascellani, 27-May-2019.)
theorem sbcni {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wcel A2 cvv $ >
  $ wb (wsbc x3 ph A2) ps $ >
  $ wb (wsbc x3 (wn ph) A2) (wn ps) $;

--| Discard class substitution in a universal quantification when substituting the quantified variable, in inference form. (Contributed by Giovanni Mascellani, 27-May-2019.)
theorem sbali {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wcel A2 cvv $ >
  $ wb (wsbc x3 (wal x3 ph) A2) (wal x3 ph) $;

--| Discard class substitution in an existential quantification when substituting the quantified variable, in inference form. (Contributed by Giovanni Mascellani, 27-May-2019.)
theorem sbexi {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wcel A2 cvv $ >
  $ wb (wsbc x3 (wex x3 ph) A2) (wex x3 ph) $;

--| Move universal quantifier in and out of class substitution, with an explicit nonfree variable condition. (Contributed by Giovanni Mascellani, 29-May-2019.)
theorem sbcalf {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wb (wsbc x3 (wal y1 ph) A2) (wal y1 (wsbc x3 ph A2)) $;

--| Move existential quantifier in and out of class substitution, with an explicit nonfree variable condition. (Contributed by Giovanni Mascellani, 29-May-2019.)
theorem sbcexf {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wb (wsbc x3 (wex y1 ph) A2) (wex y1 (wsbc x3 ph A2)) $;

--| Move universal quantifier in and out of class substitution, with an explicit nonfree variable condition and in inference form. (Contributed by Giovanni Mascellani, 30-May-2019.)
theorem sbcalfi {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wb (wsbc x3 ph A2) ps $ >
  $ wb (wsbc x3 (wal y1 ph) A2) (wal y1 ps) $;

--| Move existential quantifier in and out of class substitution, with an explicit nonfree variable condition and in inference form. (Contributed by Giovanni Mascellani, 30-May-2019.)
theorem sbcexfi {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wb (wsbc x3 ph A2) ps $ >
  $ wb (wsbc x3 (wex y1 ph) A2) (wex y1 ps) $;

--| A lemma for eliminating a universal quantifier, in inference form. (Contributed by Giovanni Mascellani, 30-May-2019.)
theorem spsbcdi {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wcel A2 cvv $ >
  $ wi ph (wal x3 ch) $ >
  $ wb (wsbc x3 ch A2) ps $ >
  $ wi ph ps $;

--| A lemma for introducing a universal quantifier, in inference form. (Contributed by Giovanni Mascellani, 30-May-2019.)
theorem alrimii {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wnf y1 ph $ >
  $ wi ph ps $ >
  $ wb (wsbc x3 ch (cv y1)) ps $ >
  $ wnf y1 ch $ >
  $ wi ph (wal x3 ch) $;

--| A lemma for introducing an existential quantifier, in inference form. (Contributed by Giovanni Mascellani, 30-May-2019.)
theorem spesbcdi {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wi ph ps $ >
  $ wb (wsbc x3 ch A2) ps $ >
  $ wi ph (wex x3 ch) $;

--| A lemma for eliminating an existential quantifier. (Contributed by Giovanni Mascellani, 30-May-2019.)
theorem exlimddvf {x3: setvar} (ph ps ch th: wff x3):
  $ wi ph (wex x3 th) $ >
  $ wnf x3 ps $ >
  $ wi (wa th ps) ch $ >
  $ wnf x3 ch $ >
  $ wi (wa ph ps) ch $;

--| A lemma for eliminating an existential quantifier, in inference form. (Contributed by Giovanni Mascellani, 31-May-2019.)
theorem exlimddvfi {x3 y1: setvar} (ph ps ch th et: wff x3 y1):
  $ wi ph (wex x3 th) $ >
  $ wnf y1 th $ >
  $ wnf y1 ps $ >
  $ wb (wsbc x3 th (cv y1)) et $ >
  $ wi (wa et ps) ch $ >
  $ wnf y1 ch $ >
  $ wi (wa ph ps) ch $;

--| A lemma for eliminating inequality, in inference form. (Contributed by Giovanni Mascellani, 31-May-2019.)
theorem sbceq1ddi {x3: setvar} (ph ps ch th et: wff x3) (A2 B2: class x3):
  $ wi ph (wceq A2 B2) $ >
  $ wi ps th $ >
  $ wb (wsbc x3 ch A2) th $ >
  $ wb (wsbc x3 ch B2) et $ >
  $ wi (wa ph ps) et $;

--| Lemma for ~ sbccom2 . (Contributed by Giovanni Mascellani, 31-May-2019.)
theorem sbccom2lem {x3 y1: setvar} (ph: wff x3 y1) (A2: class) (B2: class x3):
  $ wcel A2 cvv $ >
  $ wb (wsbc x3 (wsbc y1 ph B2) A2) (wsbc y1 (wsbc x3 ph A2) (csb x3 A2 B2)) $;

--| Commutative law for double class substitution. (Contributed by Giovanni Mascellani, 31-May-2019.)
theorem sbccom2 {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wcel A2 cvv $ >
  $ wb (wsbc x3 (wsbc y1 ph B2) A2) (wsbc y1 (wsbc x3 ph A2) (csb x3 A2 B2)) $;

--| Commutative law for double class substitution, with nonfree variable condition. (Contributed by Giovanni Mascellani, 31-May-2019.)
theorem sbccom2f {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ wcel A2 cvv $ >
  $ wnfc y1 A2 $ >
  $ wb (wsbc x3 (wsbc y1 ph B2) A2) (wsbc y1 (wsbc x3 ph A2) (csb x3 A2 B2)) $;

--| Commutative law for double class substitution, with nonfree variable condition and in inference form. (Contributed by Giovanni Mascellani, 1-Jun-2019.)
theorem sbccom2fi {x3 y1: setvar} (ph ps: wff x3 y1) (A2 B2 C: class x3 y1):
  $ wcel A2 cvv $ >
  $ wnfc y1 A2 $ >
  $ wceq (csb x3 A2 B2) C $ >
  $ wb (wsbc x3 ph A2) ps $ >
  $ wb (wsbc x3 (wsbc y1 ph B2) A2) (wsbc y1 ps C) $;

--| Commutative law for double class substitution in a class, with nonfree variable condition and in inference form. (Contributed by Giovanni Mascellani, 4-Jun-2019.)
theorem csbcom2fi {x3 y1: setvar} (A2 B2 C D E: class x3 y1):
  $ wcel A2 cvv $ >
  $ wnfc y1 A2 $ >
  $ wceq (csb x3 A2 B2) C $ >
  $ wceq (csb x3 A2 D) E $ >
  $ wceq (csb x3 A2 (csb y1 B2 D)) (csb y1 C E) $;

--| Refutation of falsity, in deduction form. (Contributed by Giovanni Mascellani, 24-Mar-2018.)
theorem fald (th: wff):
  $ wi th (wn wfal) $;

--| A Tseitin axiom for logical implication, in deduction form. (Contributed by Giovanni Mascellani, 24-Mar-2018.)
theorem tsim1 (ph ps th: wff):
  $ wi th (wo (wo (wn ph) ps) (wn (wi ph ps))) $;

--| A Tseitin axiom for logical implication, in deduction form. (Contributed by Giovanni Mascellani, 24-Mar-2018.)
theorem tsim2 (ph ps th: wff):
  $ wi th (wo ph (wi ph ps)) $;

--| A Tseitin axiom for logical implication, in deduction form. (Contributed by Giovanni Mascellani, 24-Mar-2018.)
theorem tsim3 (ph ps th: wff):
  $ wi th (wo (wn ps) (wi ph ps)) $;

--| A Tseitin axiom for logical biconditional, in deduction form. (Contributed by Giovanni Mascellani, 24-Mar-2018.)
theorem tsbi1 (ph ps th: wff):
  $ wi th (wo (wo (wn ph) (wn ps)) (wb ph ps)) $;

--| A Tseitin axiom for logical biconditional, in deduction form. (Contributed by Giovanni Mascellani, 24-Mar-2018.)
theorem tsbi2 (ph ps th: wff):
  $ wi th (wo (wo ph ps) (wb ph ps)) $;

--| A Tseitin axiom for logical biconditional, in deduction form. (Contributed by Giovanni Mascellani, 24-Mar-2018.)
theorem tsbi3 (ph ps th: wff):
  $ wi th (wo (wo ph (wn ps)) (wn (wb ph ps))) $;

--| A Tseitin axiom for logical biconditional, in deduction form. (Contributed by Giovanni Mascellani, 24-Mar-2018.)
theorem tsbi4 (ph ps th: wff):
  $ wi th (wo (wo (wn ph) ps) (wn (wb ph ps))) $;

--| A Tseitin axiom for logical exclusive disjunction, in deduction form. (Contributed by Giovanni Mascellani, 24-Mar-2018.)
theorem tsxo1 (ph ps th: wff):
  $ wi th (wo (wo (wn ph) (wn ps)) (wn (wxo ph ps))) $;

--| A Tseitin axiom for logical exclusive disjunction, in deduction form. (Contributed by Giovanni Mascellani, 24-Mar-2018.)
theorem tsxo2 (ph ps th: wff):
  $ wi th (wo (wo ph ps) (wn (wxo ph ps))) $;

--| A Tseitin axiom for logical exclusive disjunction, in deduction form. (Contributed by Giovanni Mascellani, 24-Mar-2018.)
theorem tsxo3 (ph ps th: wff):
  $ wi th (wo (wo ph (wn ps)) (wxo ph ps)) $;

--| A Tseitin axiom for logical exclusive disjunction, in deduction form. (Contributed by Giovanni Mascellani, 24-Mar-2018.)
theorem tsxo4 (ph ps th: wff):
  $ wi th (wo (wo (wn ph) ps) (wxo ph ps)) $;

--| A Tseitin axiom for logical conjunction, in deduction form. (Contributed by Giovanni Mascellani, 24-Mar-2018.)
theorem tsan1 (ph ps th: wff):
  $ wi th (wo (wo (wn ph) (wn ps)) (wa ph ps)) $;

--| A Tseitin axiom for logical conjunction, in deduction form. (Contributed by Giovanni Mascellani, 24-Mar-2018.)
theorem tsan2 (ph ps th: wff):
  $ wi th (wo ph (wn (wa ph ps))) $;

--| A Tseitin axiom for logical conjunction, in deduction form. (Contributed by Giovanni Mascellani, 24-Mar-2018.)
theorem tsan3 (ph ps th: wff):
  $ wi th (wo ps (wn (wa ph ps))) $;

--| A Tseitin axiom for logical incompatibility, in deduction form. (Contributed by Giovanni Mascellani, 24-Mar-2018.)
theorem tsna1 (ph ps th: wff):
  $ wi th (wo (wo (wn ph) (wn ps)) (wn (wnan ph ps))) $;

--| A Tseitin axiom for logical incompatibility, in deduction form. (Contributed by Giovanni Mascellani, 24-Mar-2018.)
theorem tsna2 (ph ps th: wff):
  $ wi th (wo ph (wnan ph ps)) $;

--| A Tseitin axiom for logical incompatibility, in deduction form. (Contributed by Giovanni Mascellani, 24-Mar-2018.)
theorem tsna3 (ph ps th: wff):
  $ wi th (wo ps (wnan ph ps)) $;

--| A Tseitin axiom for logical disjunction, in deduction form. (Contributed by Giovanni Mascellani, 25-Mar-2018.)
theorem tsor1 (ph ps th: wff):
  $ wi th (wo (wo ph ps) (wn (wo ph ps))) $;

--| A Tseitin axiom for logical disjunction, in deduction form. (Contributed by Giovanni Mascellani, 25-Mar-2018.)
theorem tsor2 (ph ps th: wff):
  $ wi th (wo (wn ph) (wo ph ps)) $;

--| A Tseitin axiom for logical disjunction, in deduction form. (Contributed by Giovanni Mascellani, 25-Mar-2018.)
theorem tsor3 (ph ps th: wff):
  $ wi th (wo (wn ps) (wo ph ps)) $;

--| A Tseitin axiom for triple logical conjunction, in deduction form. (Contributed by Giovanni Mascellani, 25-Mar-2018.)
theorem ts3an1 (ph ps ch th: wff):
  $ wi th (wo (wo (wn (wa ph ps)) (wn ch)) (w3a ph ps ch)) $;

--| A Tseitin axiom for triple logical conjunction, in deduction form. (Contributed by Giovanni Mascellani, 25-Mar-2018.)
theorem ts3an2 (ph ps ch th: wff):
  $ wi th (wo (wa ph ps) (wn (w3a ph ps ch))) $;

--| A Tseitin axiom for triple logical conjunction, in deduction form. (Contributed by Giovanni Mascellani, 25-Mar-2018.)
theorem ts3an3 (ph ps ch th: wff):
  $ wi th (wo ch (wn (w3a ph ps ch))) $;

--| A Tseitin axiom for triple logical disjunction, in deduction form. (Contributed by Giovanni Mascellani, 25-Mar-2018.)
theorem ts3or1 (ph ps ch th: wff):
  $ wi th (wo (wo (wo ph ps) ch) (wn (w3o ph ps ch))) $;

--| A Tseitin axiom for triple logical disjunction, in deduction form. (Contributed by Giovanni Mascellani, 25-Mar-2018.)
theorem ts3or2 (ph ps ch th: wff):
  $ wi th (wo (wn (wo ph ps)) (w3o ph ps ch)) $;

--| A Tseitin axiom for triple logical disjunction, in deduction form. (Contributed by Giovanni Mascellani, 25-Mar-2018.)
theorem ts3or3 (ph ps ch th: wff):
  $ wi th (wo (wn ch) (w3o ph ps ch)) $;

--| Equality deduction for indexed union. (Contributed by Giovanni Mascellani, 9-Apr-2018.)
theorem iuneq2f {x3: setvar} (A2 B2 C: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wi (wceq A2 B2) (wceq (ciun x3 A2 C) (ciun x3 B2 C)) $;

--| Equality deduction for restricted class abstraction. (Contributed by Giovanni Mascellani, 10-Apr-2018.)
theorem rabeq12f {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wi (wa (wceq A2 B2) (wral x3 (wb ph ps) A2)) (wceq (crab x3 ph A2) (crab x3 ps B2)) $;

--| Equality deduction for substitution in class. (Contributed by Giovanni Mascellani, 10-Apr-2018.)
theorem csbeq12 {x3: setvar} (A2 B2 C D: class x3):
  $ wi (wa (wceq A2 B2) (wal x3 (wceq C D))) (wceq (csb x3 A2 C) (csb x3 B2 D)) $;

--| Equality deduction for substitution. (Contributed by Giovanni Mascellani, 10-Apr-2018.)
theorem sbeqi {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wi (wa (wceq (cv x3) (cv y1)) (wal z (wb ph ps))) (wb (wsb z ph x3) (wsb z ps y1)) $;

--| Equality deduction for restricted universal quantification. (Contributed by Giovanni Mascellani, 10-Apr-2018.)
theorem ralbi12f {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wi (wa (wceq A2 B2) (wral x3 (wb ph ps) A2)) (wb (wral x3 ph A2) (wral x3 ps B2)) $;

--| Equality deduction for class abstraction of nested ordered pairs. (Contributed by Giovanni Mascellani, 10-Apr-2018.)
theorem oprabbi {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wi (wal x3 (wal y1 (wal z (wb ph ps)))) (wceq (coprab x3 y1 z ph) (coprab x3 y1 z ps)) $;

--| Equality deduction for maps-to notations with two arguments. (Contributed by Giovanni Mascellani, 10-Apr-2018.)
theorem mpobi123f {x3 y1: setvar} (A2 B2 C D E F: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc y1 A2 $ >
  $ wnfc y1 B2 $ >
  $ wnfc y1 C $ >
  $ wnfc y1 D $ >
  $ wnfc x3 C $ >
  $ wnfc x3 D $ >
  $ wi (wa (wa (wceq A2 B2) (wceq C D)) (wral x3 (wral y1 (wceq E F) C) A2)) (wceq (cmpo x3 y1 A2 C E) (cmpo x3 y1 B2 D F)) $;

--| Equality deduction for indexed unions. (Contributed by Giovanni Mascellani, 10-Apr-2018.)
theorem iuneq12f {x3: setvar} (A2 B2 C D: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wi (wa (wceq A2 B2) (wral x3 (wceq C D) A2)) (wceq (ciun x3 A2 C) (ciun x3 B2 D)) $;

--| Equality deduction for indexed intersections. (Contributed by Giovanni Mascellani, 10-Apr-2018.)
theorem iineq12f {x3: setvar} (A2 B2 C D: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wi (wa (wceq A2 B2) (wral x3 (wceq C D) A2)) (wceq (ciin x3 A2 C) (ciin x3 B2 D)) $;

--| Equality deduction for class abstraction of ordered pairs. (Contributed by Giovanni Mascellani, 10-Apr-2018.)
theorem opabbi {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wal x3 (wal y1 (wb ph ps))) (wceq (copab x3 y1 ph) (copab x3 y1 ps)) $;

--| Equality deduction for maps-to notations. (Contributed by Giovanni Mascellani, 10-Apr-2018.)
theorem mptbi12f {x3: setvar} (A2 B2 D E: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wi (wa (wceq A2 B2) (wral x3 (wceq D E) A2)) (wceq (cmpt x3 A2 D) (cmpt x3 B2 E)) $;

--| Commutativity of logic disjunction, in double deduction form. Should not be moved to main, see PR #3034 in Github. Use ~ orcomd instead. (Contributed by Giovanni Mascellani, 19-Mar-2018.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem orcomdd (ph ps ch th: wff):
  $ wi ph (wi ps (wo ch th)) $ >
  $ wi ph (wi ps (wo th ch)) $;

--| A version of ~ scottex with nonfree variables instead of distinct variables. (Contributed by Giovanni Mascellani, 19-Aug-2018.)
theorem scottexf {x3 y1: setvar} (A2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wnfc x3 A2 $ >
  $ wcel (crab x3 (wral y1 (wss (cfv (cv x3) crnk) (cfv (cv y1) crnk)) A2) A2) cvv $;

--| A version of ~ scott0b with nonfree variables instead of distinct variables. (Contributed by Giovanni Mascellani, 19-Aug-2018.)
theorem scott0f {x3 y1: setvar} (A2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wnfc x3 A2 $ >
  $ wb (wceq A2 c0) (wceq (crab x3 (wral y1 (wss (cfv (cv x3) crnk) (cfv (cv y1) crnk)) A2) A2) c0) $;

--| A version of ~ scott0f with inequalities instead of equalities. (Contributed by Giovanni Mascellani, 19-Aug-2018.)
theorem scottn0f {x3 y1: setvar} (A2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wnfc x3 A2 $ >
  $ wb (wne A2 c0) (wne (crab x3 (wral y1 (wss (cfv (cv x3) crnk) (cfv (cv y1) crnk)) A2) A2) c0) $;

--| Generalization of the Axiom of Choice to classes, with bound-variable hypothesis. (Contributed by Giovanni Mascellani, 19-Aug-2018.)
theorem ac6s3f {x3 y1 f2: setvar} (ph: wff x3 y1) (ps: wff x3 y1 f2) (A2: class y1):
  $ wnf y1 ps $ >
  $ wcel A2 cvv $ >
  $ wi (wceq (cv y1) (cfv (cv x3) (cv f2))) (wb ph ps) $ >
  $ wi (wral x3 (wex y1 ph) A2) (wex f2 (wral x3 ps A2)) $;

--| Generalization of the Axiom of Choice to classes, moving the existence condition in the consequent. (Contributed by Giovanni Mascellani, 19-Aug-2018.)
theorem ac6s6 {x3 y1 f2: setvar} (ph: wff x3 y1) (ps: wff x3 y1 f2) (A2: class y1):
  $ wnf y1 ps $ >
  $ wcel A2 cvv $ >
  $ wi (wceq (cv y1) (cfv (cv x3) (cv f2))) (wb ph ps) $ >
  $ wex f2 (wral x3 (wi (wex y1 ph) ps) A2) $;

--| Generalization of the Axiom of Choice to classes, moving the existence condition in the consequent. (Contributed by Giovanni Mascellani, 20-Aug-2018.)
theorem ac6s6f {x3 y1 f2: setvar} (ph: wff x3 y1) (ps: wff x3 y1 f2) (A2: class x3 y1):
  $ wcel A2 cvv $ >
  $ wnf y1 ps $ >
  $ wi (wceq (cv y1) (cfv (cv x3) (cv f2))) (wb ph ps) $ >
  $ wnfc x3 A2 $ >
  $ wex f2 (wral x3 (wi (wex y1 ph) ps) A2) $;

--| Extend the definition of a class to include the range Cartesian product class.
term cxrn (A2 B2: class): class;

--| Extend the definition of a class to include the quotient map of a class.
term cqmap (R: class): class;

--| Extend the definition of a class to include the class of adjoined lift maps.
term cadjliftmap (A2 R: class): class;

--| Extend the definition of a class to include the class of block lift maps.
term cblockliftmap (A2 R: class): class;

--| Extend the definition of a class to include the class of successor maps.
term csucmap: class;

--| Extend the definition of a class to include the class of successors.
term csuccl: class;

--| Extend the definition of a class to include the predecessor of a class.
term cpre (N: class): class;

--| Extend the definition of a class to include the class of equilibrium block lifts.
term cblockliftfix: class;

--| Extend the definition of a class to include the shift stability class.
term cshiftstable (S F: class): class;

--| Extend the definition of a class to include the class of cosets by a class. (Read: the class of cosets by ` R ` .)
term ccoss (R: class): class;

--| Extend the definition of a class to include the class of coelements on a class. (Read: the class of coelements on ` A ` .)
term ccoels (A2: class): class;

--| Extend the definition of a class to include the relation class.
term crels: class;

--| Extend the definition of a class to include the subset class.
term cssr: class;

--| Extend the definition of a class to include the reflexivity class.
term crefs: class;

--| Extend the definition of a class to include the reflexive relations class.
term crefrels: class;

--| Extend the definition of a wff to include the reflexive relation predicate. (Read: ` R ` is a reflexive relation.)
term wrefrel (R: class): wff;

--| Extend the definition of a class to include the converse reflexivity class.
term ccnvrefs: class;

--| Extend the definition of a class to include the converse reflexive relations class.
term ccnvrefrels: class;

--| Extend the definition of a wff to include the converse reflexive relation predicate. (Read: ` R ` is a converse reflexive relation.)
term wcnvrefrel (R: class): wff;

--| Extend the definition of a class to include the symmetry class.
term csyms: class;

--| Extend the definition of a class to include the symmetry relations class.
term csymrels: class;

--| Extend the definition of a wff to include the symmetry relation predicate. (Read: ` R ` is a symmetric relation.)
term wsymrel (R: class): wff;

--| Extend the definition of a class to include the transitivity class (but cf. the transitive class defined in ~ df-tr ).
term ctrs: class;

--| Extend the definition of a class to include the transitive relations class.
term ctrrels: class;

--| Extend the definition of a wff to include the transitive relation predicate. (Read: ` R ` is a transitive relation.)
term wtrrel (R: class): wff;

--| Extend the definition of a class to include the equivalence relations class.
term ceqvrels: class;

--| Extend the definition of a wff to include the equivalence relation predicate. (Read: ` R ` is an equivalence relation.)
term weqvrel (R: class): wff;

--| Extend the definition of a class to include the coelement equivalence relations class.
term ccoeleqvrels: class;

--| Extend the definition of a wff to include the coelement equivalence relation predicate. (Read: the coelement equivalence relation on ` A ` .)
term wcoeleqvrel (A2: class): wff;

--| Extend the definition of a class to include the redundancy class.
term credunds: class;

--| Extend the definition of a wff to include the redundancy predicate. (Read: ` A ` is redundant with respect to ` B ` in ` C ` .)
term wredund (A2 B2 C: class): wff;

--| Extend wff definition to include the redundancy operator for propositions.
term wredundp (ph ps ch: wff): wff;

--| Extend the definition of a class to include the domain quotients class.
term cdmqss: class;

--| Extend the definition of a wff to include the domain quotient predicate. (Read: the domain quotient of ` R ` is ` A ` .)
term wdmqs (A2 R: class): wff;

--| Extend the definition of a class to include the equivalence relations on their domain quotients class.
term cers: class;

--| Extend the definition of a wff to include the equivalence relation on its domain quotient predicate. (Read: ` R ` is an equivalence relation on its domain quotient ` A ` .)
term werALTV (A2 R: class): wff;

--| Extend the definition of a class to include the blocklift-stable equivalence relations class.
term cpeters: class;

--| Extend the definition of a class to include the grade- and blocklift-stable equivalence relations class.
term cpet2ers: class;

--| Extend the definition of a class to include the comember equivalence relations class.
term ccomembers: class;

--| Extend the definition of a wff to include the comember equivalence relation predicate. (Read: the comember equivalence relation on ` A ` , or, the restricted coelement equivalence relation on its domain quotient ` A ` .)
term wcomember (A2: class): wff;

--| Extend the definition of a class to include the function set class.
term cfunss: class;

--| Extend the definition of a class to include the functions class, i.e., the function relations class.
term cfunsALTV: class;

--| Extend the definition of a wff to include the function predicate, i.e., the function relation predicate. (Read: ` F ` is a function.)
term wfunALTV (F: class): wff;

--| Extend the definition of a class to include the disjoint set class.
term cdisjss: class;

--| Extend the definition of a class to include the disjoints class, i.e., the disjoint relations class.
term cdisjs: class;

--| Extend the definition of a wff to include the disjoint predicate, i.e., the disjoint relation predicate. (Read: ` R ` is a disjoint.)
term wdisjALTV (R: class): wff;

--| Extend the definition of a class to include the disjoint elements class, i.e., the disjoint element relations class.
term celdisjs: class;

--| Extend the definition of a wff to include the disjoint element predicate, i.e., the disjoint element relation predicate. (Read: the elements of ` A ` are disjoint.)
term weldisj (A2: class): wff;

--| Extend the definition of a wff to include the antisymmetry relation predicate. (Read: ` R ` is an antisymmetric relation.)
term wantisymrel (R: class): wff;

--| Extend the definition of a class to include the partitions class, i.e., the partition relations class.
term cparts: class;

--| Extend the definition of a wff to include the partition predicate, i.e., the partition relation predicate. (Read: ` A ` is a partition by ` R ` .)
term wpart (A2 R: class): wff;

--| Extend the definition of a class to include the member partitions class, i.e., the member partition relations class.
term cmembparts: class;

--| Extend the definition of a wff to include the member partition predicate, i.e., the member partition relation predicate. (Read: ` A ` is a member partition.)
term wmembpart (A2: class): wff;

--| Extend the definition of a class to include the blocklift-stable partitions class.
term cpetparts: class;

--| Extend the definition of a class to include the grade- and blocklift-stable partitions class.
term cpet2parts: class;

--| New way ( ~ elv , and the theorems beginning with "el2v" or "el3v") to shorten some proofs. (Contributed by Peter Mazsa, 23-Oct-2018.)
theorem el2v1 {x3: setvar} (ph ps: wff x3):
  $ wi (wa (wcel (cv x3) cvv) ph) ps $ >
  $ wi ph ps $;

--| New way ( ~ elv , and the theorems beginning with "el2v" or "el3v") to shorten some proofs. (Contributed by Peter Mazsa, 16-Oct-2020.)
theorem el3v1 {x3: setvar} (ps ch th: wff x3):
  $ wi (w3a (wcel (cv x3) cvv) ps ch) th $ >
  $ wi (wa ps ch) th $;

--| New way ( ~ elv , and the theorems beginning with "el2v" or "el3v") to shorten some proofs. (Contributed by Peter Mazsa, 16-Oct-2020.)
theorem el3v2 {y1: setvar} (ph ch th: wff y1):
  $ wi (w3a ph (wcel (cv y1) cvv) ch) th $ >
  $ wi (wa ph ch) th $;

--| New way ( ~ elv , and the theorems beginning with "el2v" or "el3v") to shorten some proofs. (Contributed by Peter Mazsa, 11-Jul-2021.)
theorem el3v12 {x3 y1: setvar} (ch th: wff x3 y1):
  $ wi (w3a (wcel (cv x3) cvv) (wcel (cv y1) cvv) ch) th $ >
  $ wi ch th $;

--| New way ( ~ elv , and the theorems beginning with "el2v" or "el3v") to shorten some proofs. (Contributed by Peter Mazsa, 11-Jul-2021.)
theorem el3v13 {x3 z: setvar} (ps th: wff x3 z):
  $ wi (w3a (wcel (cv x3) cvv) ps (wcel (cv z) cvv)) th $ >
  $ wi ps th $;

--| New way ( ~ elv , and the theorems beginning with "el2v" or "el3v") to shorten some proofs. (Contributed by Peter Mazsa, 11-Jul-2021.)
theorem el3v23 {y1 z: setvar} (ph th: wff y1 z):
  $ wi (w3a ph (wcel (cv y1) cvv) (wcel (cv z) cvv)) th $ >
  $ wi ph th $;

--| Multiple commutations in conjunction. (Contributed by Peter Mazsa, 7-Mar-2020.)
theorem anan (ph ps ch th ta: wff):
  $ wb (wa (wa (wa ph ps) ch) (wa (wa ph th) ta)) (wa (wa ps th) (wa ph (wa ch ta))) $;

--| A wff is equivalent to its conjunctions with truths. (Contributed by Peter Mazsa, 30-Nov-2018.)
theorem triantru3 (ph ps ch: wff):
  $ ph $ >
  $ ps $ >
  $ wb ch (w3a ph ps ch) $;

--| A wff is equivalent to its disjunction with falsehood, deduction form. (Contributed by Peter Mazsa, 22-Aug-2023.)
theorem biorfd (ph ps ch: wff):
  $ wi ph (wn ps) $ >
  $ wi ph (wb ch (wo ps ch)) $;

--| Substitution of equal classes in binary relation. (Contributed by Peter Mazsa, 14-Jun-2024.)
theorem eqbrtr (A2 B2 C R: class):
  $ wi (wa (wceq A2 B2) (wbr B2 C R)) (wbr A2 C R) $;

--| Substitution of equal classes in a binary relation. (Contributed by Peter Mazsa, 14-Jun-2024.)
theorem eqbrb (A2 B2 C R: class):
  $ wb (wa (wceq A2 B2) (wbr A2 C R)) (wa (wceq A2 B2) (wbr B2 C R)) $;

--| Substitution of equal classes into element relation. (Contributed by Peter Mazsa, 22-Jul-2017.)
theorem eqeltr (A2 B2 C: class):
  $ wi (wa (wceq A2 B2) (wcel B2 C)) (wcel A2 C) $;

--| Substitution of equal classes into element relation. (Contributed by Peter Mazsa, 17-Jul-2019.)
theorem eqelb (A2 B2 C: class):
  $ wb (wa (wceq A2 B2) (wcel A2 C)) (wa (wceq A2 B2) (wcel B2 C)) $;

--| Implication of introducing a new equality. (Contributed by Peter Mazsa, 17-Apr-2019.)
theorem eqeqan2d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq C D) $ >
  $ wi (wa (wceq A2 B2) ph) (wb (wceq A2 C) (wceq B2 D)) $;

--| The restriction to a disjoint is the empty class. (Contributed by Peter Mazsa, 24-Jul-2024.)
theorem disjresin (A2 B2 R: class):
  $ wi (wceq (cin A2 B2) c0) (wceq (cres R (cin A2 B2)) c0) $;

--| The intersection of restrictions to disjoint is the empty class. (Contributed by Peter Mazsa, 24-Jul-2024.)
theorem disjresdisj (A2 B2 R: class):
  $ wi (wceq (cin A2 B2) c0) (wceq (cin (cres R A2) (cres R B2)) c0) $;

--| The difference between restrictions to disjoint is the first restriction. (Contributed by Peter Mazsa, 24-Jul-2024.)
theorem disjresdif (A2 B2 R: class):
  $ wi (wceq (cin A2 B2) c0) (wceq (cdif (cres R A2) (cres R B2)) (cres R A2)) $;

--| Lemma for ~ ressucdifsn2 . (Contributed by Peter Mazsa, 24-Jul-2024.)
theorem disjresundif (A2 B2 R: class):
  $ wi (wceq (cin A2 B2) c0) (wceq (cdif (cres R (cun A2 B2)) (cres R B2)) (cres R A2)) $;

--| Two ways of expressing the restriction of an intersection. (Contributed by Peter Mazsa, 5-Jun-2021.)
theorem inres2 (A2 R S: class):
  $ wceq (cin (cres R A2) S) (cres (cin R S) A2) $;

--| Equality theorem for composition of two classes. (Contributed by Peter Mazsa, 23-Sep-2021.)
theorem coideq (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (ccom A2 A2) (ccom B2 B2)) $;

--| If there is no case where wff is true, it is true for at most one case. (Contributed by Peter Mazsa, 27-Sep-2021.)
theorem nexmo1 {x3: setvar} (ph: wff x3):
  $ wi (wn (wex x3 ph)) (wmo x3 ph) $;

--| Implication of a class abstraction. (Contributed by Peter Mazsa, 16-Apr-2019.)
theorem eqab2 {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wal x3 (wb (wcel (cv x3) A2) ph)) (wral x3 ph A2) $;

--| Double restricted universal quantification, special case. (Contributed by Peter Mazsa, 17-Jun-2020.)
theorem r2alan {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wb (wal x3 (wal y1 (wi (wa (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ph) ps))) (wral x3 (wral y1 (wi ph ps) B2) A2) $;

--| Inference of restricted abstraction subclass from implication. (Contributed by Peter Mazsa, 26-Oct-2022.)
theorem ssrabi {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi ph ps $ >
  $ wss (crab x3 ph A2) (crab x3 ps A2) $;

--| Restricted equivalent wff's correspond to restricted class abstractions which are equal with the same class. (Contributed by Peter Mazsa, 22-Jul-2021.)
theorem rabimbieq {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wceq B2 (crab x3 ph A2) $ >
  $ wi (wcel (cv x3) A2) (wb ph ps) $ >
  $ wceq B2 (crab x3 ps A2) $;

--| Intersection with class abstraction. (Contributed by Peter Mazsa, 21-Jul-2021.)
theorem abeqin {x3: setvar} (ph: wff x3) (A2 B2: class x3) (C: class):
  $ wceq A2 (cin B2 C) $ >
  $ wceq B2 (cab x3 ph) $ >
  $ wceq A2 (crab x3 ph C) $;

--| Intersection with class abstraction and equivalent wff's. (Contributed by Peter Mazsa, 21-Jul-2021.)
theorem abeqinbi {x3: setvar} (ph ps: wff x3) (A2 B2: class x3) (C: class):
  $ wceq A2 (cin B2 C) $ >
  $ wceq B2 (cab x3 ph) $ >
  $ wi (wcel (cv x3) C) (wb ph ps) $ >
  $ wceq A2 (crab x3 ps C) $;

--| Class element of a restricted class abstraction. (Contributed by Peter Mazsa, 24-Jul-2021.)
theorem eqrabi {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3):
  $ wb (wcel (cv x3) A2) (wa (wcel (cv x3) B2) ph) $ >
  $ wceq A2 (crab x3 ph B2) $;

--| Class element of a restricted class abstraction. (Contributed by Peter Mazsa, 24-Jul-2021.)
theorem rabeqel {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (B2: class x3) (C: class):
  $ wceq B2 (crab x3 ph A2) $ >
  $ wi (wceq (cv x3) C) (wb ph ps) $ >
  $ wb (wcel C B2) (wa ps (wcel C A2)) $;

--| The equality connective between relations. (Contributed by Peter Mazsa, 25-Jun-2019.)
theorem eqrelf {x3 y1: setvar} (A2 B2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc y1 A2 $ >
  $ wnfc y1 B2 $ >
  $ wi (wa (wrel A2) (wrel B2)) (wb (wceq A2 B2) (wal x3 (wal y1 (wb (wcel (cop (cv x3) (cv y1)) A2) (wcel (cop (cv x3) (cv y1)) B2))))) $;

--| Binary relation on the converse of an intersection with a Cartesian product. (Contributed by Peter Mazsa, 27-Jul-2019.)
theorem br1cnvinxp (A2 B2 C D R: class):
  $ wb (wbr C D (ccnv (cin R (cxp A2 B2)))) (wa (wa (wcel C B2) (wcel D A2)) (wbr D C R)) $;

--| Elementhood in a converse ` R ` -coset when ` R ` is a relation. (Contributed by Peter Mazsa, 9-Dec-2018.)
theorem releleccnv (A2 B2 R: class):
  $ wi (wrel R) (wb (wcel A2 (cec B2 (ccnv R))) (wbr A2 B2 R)) $;

--| Equality of converse ` R ` -coset and converse ` S ` -coset when ` R ` and ` S ` are relations. (Contributed by Peter Mazsa, 27-Jul-2019.)
theorem releccnveq {x3: setvar} (A2 B2 R S: class):
  $ wi (wa (wrel R) (wrel S)) (wb (wceq (cec A2 (ccnv R)) (cec B2 (ccnv S))) (wal x3 (wb (wbr (cv x3) A2 R) (wbr (cv x3) B2 S)))) $;

--| Cartesian product of a class and the universe. (Contributed by Peter Mazsa, 6-Oct-2020.)
theorem xpv {x3 y1: setvar} (A2: class):
  $ wceq (cxp A2 cvv) (copab x3 y1 (wcel (cv x3) A2)) $;

--| Cartesian product of the universe and a class. (Contributed by Peter Mazsa, 3-Dec-2020.)
theorem vxp {x3 y1: setvar} (A2: class):
  $ wceq (cxp cvv A2) (copab x3 y1 (wcel (cv y1) A2)) $;

--| Negated elementhood of ordered pair. (Contributed by Peter Mazsa, 14-Jan-2019.)
theorem opelvvdif (A2 B2 R V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wcel (cop A2 B2) (cdif (cxp cvv cvv) R)) (wn (wcel (cop A2 B2) R))) $;

--| Ordered-pair class abstraction defined by a negation. (Contributed by Peter Mazsa, 25-Jun-2019.)
theorem vvdifopab {x3 y1: setvar} (ph: wff x3 y1):
  $ wceq (cdif (cxp cvv cvv) (copab x3 y1 ph)) (copab x3 y1 (wn ph)) $;

--| Binary relation with universal complement is the negation of the relation. (Contributed by Peter Mazsa, 1-Jul-2018.)
theorem brvdif (A2 B2 R: class):
  $ wb (wbr A2 B2 (cdif cvv R)) (wn (wbr A2 B2 R)) $;

--| Binary relation with universal complement. (Contributed by Peter Mazsa, 14-Jul-2018.)
theorem brvdif2 (A2 B2 R: class):
  $ wb (wbr A2 B2 (cdif cvv R)) (wn (wcel (cop A2 B2) R)) $;

--| Binary relation with the complement under the universal class of ordered pairs. (Contributed by Peter Mazsa, 9-Nov-2018.)
theorem brvvdif (A2 B2 R V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wbr A2 B2 (cdif (cxp cvv cvv) R)) (wn (wbr A2 B2 R))) $;

--| Binary relation with the complement under the universal class of ordered pairs is the same as with universal complement. (Contributed by Peter Mazsa, 28-Nov-2018.)
theorem brvbrvvdif (A2 B2 R V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wbr A2 B2 (cdif (cxp cvv cvv) R)) (wbr A2 B2 (cdif cvv R))) $;

--| The converse of the binary epsilon relation. (Contributed by Peter Mazsa, 30-Jan-2018.)
theorem brcnvep (A2 B2 V: class):
  $ wi (wcel A2 V) (wb (wbr A2 B2 (ccnv cep)) (wcel B2 A2)) $;

--| Elementhood in the ` R ` -coset of ` A ` . Theorem 72 of [Suppes] p. 82. (I think we should replace ~ elecg with this original form of Suppes. Peter Mazsa). (Contributed by Mario Carneiro, 9-Jul-2014.)
theorem elecALTV (A2 B2 R V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wcel B2 (cec A2 R)) (wbr A2 B2 R)) $;

--| Restricted converse epsilon binary relation. (Contributed by Peter Mazsa, 10-Feb-2018.)
theorem brcnvepres (A2 B2 C V W: class):
  $ wi (wa (wcel B2 V) (wcel C W)) (wb (wbr B2 C (cres (ccnv cep) A2)) (wa (wcel B2 A2) (wcel C B2))) $;

--| Binary relation on a restriction. (Contributed by Peter Mazsa, 2-Jan-2019.) (Revised by Peter Mazsa, 16-Dec-2021.)
theorem brres2 (A2 B2 C R: class):
  $ wb (wbr B2 C (cres R A2)) (wbr B2 C (cin R (cxp A2 (crn (cres R A2))))) $;

--| Binary relation on the converse of a restriction. (Contributed by Peter Mazsa, 27-Jul-2019.)
theorem br1cnvres (A2 B2 C R V: class):
  $ wi (wcel B2 V) (wb (wbr B2 C (ccnv (cres R A2))) (wa (wcel C A2) (wbr C B2 R))) $;

--| Elementhood in the converse restricted coset of ` B ` . (Contributed by Peter Mazsa, 21-Sep-2018.)
theorem elec1cnvres (A2 B2 C R V: class):
  $ wi (wcel B2 V) (wb (wcel C (cec B2 (ccnv (cres R A2)))) (wa (wcel C A2) (wbr C B2 R))) $;

--| Converse restricted coset of ` B ` . (Contributed by Peter Mazsa, 22-Mar-2019.) (Revised by Peter Mazsa, 21-Oct-2021.)
theorem ec1cnvres {x3: setvar} (A2 B2 R V: class):
  $ wi (wcel B2 V) (wceq (cec B2 (ccnv (cres R A2))) (crab x3 (wbr (cv x3) B2 R) A2)) $;

--| Elementhood in the domain of a restriction. (Contributed by Peter Mazsa, 9-Jan-2019.)
theorem eldmres {y1: setvar} (A2 B2 R: class) (V: class y1):
  $ wi (wcel B2 V) (wb (wcel B2 (cdm (cres R A2))) (wa (wcel B2 A2) (wex y1 (wbr B2 (cv y1) R)))) $;

--| Element of the range of a restriction. (Contributed by Peter Mazsa, 26-Dec-2018.)
theorem elrnres {x3: setvar} (A2 B2 R V: class):
  $ wi (wcel B2 V) (wb (wcel B2 (crn (cres R A2))) (wrex x3 (wbr (cv x3) B2 R) A2)) $;

--| Element of the domain of a restriction to a singleton. (Contributed by Peter Mazsa, 12-Jun-2024.)
theorem eldmressnALTV (A2 B2 R V: class):
  $ wi (wcel B2 V) (wb (wcel B2 (cdm (cres R (csn A2)))) (wa (wceq B2 A2) (wcel A2 (cdm R)))) $;

--| Element of the range of a restriction to a singleton. (Contributed by Peter Mazsa, 12-Jun-2024.)
theorem elrnressn (A2 B2 R V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wcel B2 (crn (cres R (csn A2)))) (wbr A2 B2 R)) $;

--| Elementhood in a domain. (Contributed by Peter Mazsa, 24-Oct-2018.)
theorem eldm4 {y1: setvar} (A2 R V: class):
  $ wi (wcel A2 V) (wb (wcel A2 (cdm R)) (wex y1 (wcel (cv y1) (cec A2 R)))) $;

--| Elementhood in the domain of a restriction. (Contributed by Peter Mazsa, 21-Aug-2020.)
theorem eldmres2 {y1: setvar} (A2 B2 R V: class):
  $ wi (wcel B2 V) (wb (wcel B2 (cdm (cres R A2))) (wa (wcel B2 A2) (wex y1 (wcel (cv y1) (cec B2 R))))) $;

--| Elementhood in the domain of a restriction. (Contributed by Peter Mazsa, 23-Nov-2025.)
theorem eldmres3 (A2 B2 R V: class):
  $ wi (wcel B2 V) (wb (wcel B2 (cdm (cres R A2))) (wa (wcel B2 A2) (wne (cec B2 R) c0))) $;

--| Equality theorem for ` C ` -coset of ` A ` and ` C ` -coset of ` B ` , inference version. (Contributed by Peter Mazsa, 11-May-2021.)
theorem eceq1i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cec A2 C) (cec B2 C) $;

--| Restricted coset of ` B ` . (Contributed by Peter Mazsa, 9-Dec-2018.)
theorem ecres {x3: setvar} (A2 B2 R: class):
  $ wceq (cec B2 (cres R A2)) (cab x3 (wa (wcel B2 A2) (wbr B2 (cv x3) R))) $;

--| Restricted converse epsilon coset of ` B ` . (Contributed by Peter Mazsa, 11-Feb-2018.) (Revised by Peter Mazsa, 21-Oct-2021.)
theorem eccnvepres {x3: setvar} (A2 B2 V: class):
  $ wi (wcel B2 V) (wceq (cec B2 (cres (ccnv cep) A2)) (crab x3 (wcel B2 A2) B2)) $;

--| Elementhood in the converse epsilon coset of ` A ` is elementhood in ` A ` . (Contributed by Peter Mazsa, 27-Jan-2019.)
theorem eleccnvep (A2 B2 V: class):
  $ wi (wcel A2 V) (wb (wcel B2 (cec A2 (ccnv cep))) (wcel B2 A2)) $;

--| The converse epsilon coset of a set is the set. (Contributed by Peter Mazsa, 27-Jan-2019.)
theorem eccnvep (A2 V: class):
  $ wi (wcel A2 V) (wceq (cec A2 (ccnv cep)) A2) $;

--| Property of epsilon relation, see also ~ extid , ~ extssr and the comment of ~ df-ssr . (Contributed by Peter Mazsa, 10-Jul-2019.)
theorem extep (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wceq (cec A2 (ccnv cep)) (cec B2 (ccnv cep))) (wceq A2 B2)) $;

--| Property of the epsilon relation. (Contributed by Peter Mazsa, 27-Apr-2020.)
theorem disjeccnvep (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wceq (cin (cec A2 (ccnv cep)) (cec B2 (ccnv cep))) c0) (wceq (cin A2 B2) c0)) $;

--| The restricted converse epsilon coset of an element of the restriction is the element itself. (Contributed by Peter Mazsa, 16-Jul-2019.)
theorem eccnvepres2 (A2 B2: class):
  $ wi (wcel B2 A2) (wceq (cec B2 (cres (ccnv cep) A2)) B2) $;

--| Condition for a restricted converse epsilon coset of a set to be the set itself. (Contributed by Peter Mazsa, 11-May-2021.)
theorem eccnvepres3 (A2 B2: class):
  $ wi (wcel B2 (cdm (cres (ccnv cep) A2))) (wceq (cec B2 (cres (ccnv cep) A2)) B2) $;

--| Elementhood in a restricted domain quotient set. (Contributed by Peter Mazsa, 21-Aug-2020.)
theorem eldmqsres {x3 u: setvar} (A2: class) (B2: class x3) (R: class) (V: class x3 u):
  $ wi (wcel B2 V) (wb (wcel B2 (cqs (cdm (cres R A2)) (cres R A2))) (wrex u (wa (wex x3 (wcel (cv x3) (cec (cv u) R))) (wceq B2 (cec (cv u) R))) A2)) $;

--| Elementhood in a restricted domain quotient set. (Contributed by Peter Mazsa, 22-Aug-2020.)
theorem eldmqsres2 {x3 u: setvar} (A2 B2 R: class) (V: class x3 u):
  $ wi (wcel B2 V) (wb (wcel B2 (cqs (cdm (cres R A2)) (cres R A2))) (wrex u (wrex x3 (wceq B2 (cec (cv u) R)) (cec (cv u) R)) A2)) $;

--| Subclass theorem for quotient sets. (Contributed by Peter Mazsa, 12-Sep-2020.)
theorem qsss1 (A2 B2 C: class):
  $ wi (wss A2 B2) (wss (cqs A2 C) (cqs B2 C)) $;

--| Equality theorem for quotient set, inference form. (Contributed by Peter Mazsa, 3-Jun-2021.)
theorem qseq1i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cqs A2 C) (cqs B2 C) $;

--| Binary relation on a restriction. (Contributed by Peter Mazsa, 2-Jan-2019.)
theorem brinxprnres (A2 B2 C R V: class):
  $ wi (wcel C V) (wb (wbr B2 C (cin R (cxp A2 (crn (cres R A2))))) (wa (wcel B2 A2) (wbr B2 C R))) $;

--| Restriction of a class as a class of ordered pairs. (Contributed by Peter Mazsa, 2-Jan-2019.)
theorem inxprnres {x3 y1: setvar} (A2 R: class):
  $ wceq (cin R (cxp A2 (crn (cres R A2)))) (copab x3 y1 (wa (wcel (cv x3) A2) (wbr (cv x3) (cv y1) R))) $;

--| Alternate definition of the restriction of a class. (Contributed by Peter Mazsa, 2-Jan-2019.)
theorem dfres4 (A2 R: class):
  $ wceq (cres R A2) (cin R (cxp A2 (crn (cres R A2)))) $;

--| Equivalent expressions with existential quantification. (Contributed by Peter Mazsa, 10-Sep-2021.)
theorem exan3 {u: setvar} (A2 B2: class) (R: class u) (V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wex u (wa (wcel A2 (cec (cv u) R)) (wcel B2 (cec (cv u) R)))) (wex u (wa (wbr (cv u) A2 R) (wbr (cv u) B2 R)))) $;

--| Equivalent expressions with existential quantification. (Contributed by Peter Mazsa, 2-May-2021.)
theorem exanres {u: setvar} (A2: class u) (B2 C: class) (R S: class u) (V W: class):
  $ wi (wa (wcel B2 V) (wcel C W)) (wb (wex u (wa (wbr (cv u) B2 (cres R A2)) (wbr (cv u) C (cres S A2)))) (wrex u (wa (wbr (cv u) B2 R) (wbr (cv u) C S)) A2)) $;

--| Equivalent expressions with restricted existential quantification. (Contributed by Peter Mazsa, 10-Sep-2021.)
theorem exanres3 {u: setvar} (A2: class u) (B2 C: class) (R S: class u) (V W: class):
  $ wi (wa (wcel B2 V) (wcel C W)) (wb (wrex u (wa (wcel B2 (cec (cv u) R)) (wcel C (cec (cv u) S))) A2) (wrex u (wa (wbr (cv u) B2 R) (wbr (cv u) C S)) A2)) $;

--| Equivalent expressions with existential quantification. (Contributed by Peter Mazsa, 10-Sep-2021.)
theorem exanres2 {u: setvar} (A2: class u) (B2 C: class) (R S: class u) (V W: class):
  $ wi (wa (wcel B2 V) (wcel C W)) (wb (wex u (wa (wbr (cv u) B2 (cres R A2)) (wbr (cv u) C (cres S A2)))) (wrex u (wa (wcel B2 (cec (cv u) R)) (wcel C (cec (cv u) S))) A2)) $;

--| Restricted converse epsilon relation as a class of ordered pairs. (Contributed by Peter Mazsa, 10-Feb-2018.)
theorem cnvepres {x3 y1: setvar} (A2: class):
  $ wceq (cres (ccnv cep) A2) (copab x3 y1 (wa (wcel (cv x3) A2) (wcel (cv y1) (cv x3)))) $;

--| Equality of relations. (Contributed by Peter Mazsa, 8-Mar-2019.)
theorem eqrel2 {x3 y1: setvar} (A2 B2: class):
  $ wi (wa (wrel A2) (wrel B2)) (wb (wceq A2 B2) (wal x3 (wal y1 (wb (wbr (cv x3) (cv y1) A2) (wbr (cv x3) (cv y1) B2))))) $;

--| Range of converse is the domain. (Contributed by Peter Mazsa, 12-Feb-2018.)
theorem rncnv (A2: class):
  $ wceq (crn (ccnv A2)) (cdm A2) $;

--| Alternate definition of domain. (Contributed by Peter Mazsa, 2-Mar-2018.)
theorem dfdm6 {x3: setvar} (R: class):
  $ wceq (cdm R) (cab x3 (wne (cec (cv x3) R) c0)) $;

--| Alternate definition of range. (Contributed by Peter Mazsa, 1-Aug-2018.)
theorem dfrn6 {x3: setvar} (R: class):
  $ wceq (crn R) (cab x3 (wne (cec (cv x3) (ccnv R)) c0)) $;

--| The range of the restricted converse epsilon is the union of the restriction. (Contributed by Peter Mazsa, 11-Feb-2018.) (Revised by Peter Mazsa, 26-Sep-2021.)
theorem rncnvepres (A2: class):
  $ wceq (crn (cres (ccnv cep) A2)) (cuni A2) $;

--| Equality of the coset of ` B ` and the coset of ` C ` implies equivalence of domain elementhood (equivalence is not necessary as opposed to ~ ereldm ). (Contributed by Peter Mazsa, 9-Oct-2018.)
theorem dmecd (ph: wff) (A2 B2 C R: class):
  $ wi ph (wceq (cdm R) A2) $ >
  $ wi ph (wceq (cec B2 R) (cec C R)) $ >
  $ wi ph (wb (wcel B2 A2) (wcel C A2)) $;

--| Equality of the coset of ` B ` and the coset of ` C ` implies equivalence of domain elementhood (equivalence is not necessary as opposed to ~ ereldm ). (Contributed by Peter Mazsa, 12-Oct-2018.)
theorem dmec2d (ph: wff) (B2 C R: class):
  $ wi ph (wceq (cec B2 R) (cec C R)) $ >
  $ wi ph (wb (wcel B2 (cdm R)) (wcel C (cdm R))) $;

--| Property of the identity binary relation. (Contributed by Peter Mazsa, 18-Dec-2021.)
theorem brid (A2 B2: class):
  $ wb (wbr A2 B2 cid) (wbr B2 A2 cid) $;

--| For sets, the identity binary relation is the same as equality. (Contributed by Peter Mazsa, 24-Jun-2020.) (Revised by Peter Mazsa, 18-Dec-2021.)
theorem ideq2 (A2 B2 V: class):
  $ wi (wcel A2 V) (wb (wbr A2 B2 cid) (wceq A2 B2)) $;

--| Condition for the identity restriction to be a subclass of identity intersection with a Cartesian product. (Contributed by Peter Mazsa, 19-Jul-2018.)
theorem idresssidinxp (A2 B2: class):
  $ wi (wss A2 B2) (wss (cres cid A2) (cin cid (cxp A2 B2))) $;

--| Condition for the identity restriction to be equal to the identity intersection with a Cartesian product. (Contributed by Peter Mazsa, 19-Jul-2018.)
theorem idreseqidinxp (A2 B2: class):
  $ wi (wss A2 B2) (wceq (cin cid (cxp A2 B2)) (cres cid A2)) $;

--| Property of identity relation, see also ~ extep , ~ extssr and the comment of ~ df-ssr . (Contributed by Peter Mazsa, 5-Jul-2019.)
theorem extid (A2 B2 V: class):
  $ wi (wcel A2 V) (wb (wceq (cec A2 (ccnv cid)) (cec B2 (ccnv cid))) (wceq A2 B2)) $;

--| Two ways to say that an intersection with a Cartesian product is a subclass. (Contributed by Peter Mazsa, 16-Jul-2019.)
theorem inxpss {x3 y1: setvar} (A2 B2 R S: class):
  $ wb (wss (cin R (cxp A2 B2)) S) (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) R) (wbr (cv x3) (cv y1) S)) B2) A2) $;

--| Two ways to say that an intersection of the identity relation with a Cartesian product is a subclass. (Contributed by Peter Mazsa, 16-Jul-2019.)
theorem idinxpss {x3 y1: setvar} (A2 B2 R: class):
  $ wb (wss (cin cid (cxp A2 B2)) R) (wral x3 (wral y1 (wi (wceq (cv x3) (cv y1)) (wbr (cv x3) (cv y1) R)) B2) A2) $;

--| Two ways to say that an intersection of the identity relation with a Cartesian product is a subclass. (Contributed by Peter Mazsa, 12-Dec-2023.)
theorem ref5 {x3: setvar} (A2 B2 R: class):
  $ wb (wss (cin cid (cxp A2 B2)) R) (wral x3 (wbr (cv x3) (cv x3) R) (cin A2 B2)) $;

--| Two ways to say that an intersection with a Cartesian product is a subclass (see also ~ inxpss ). (Contributed by Peter Mazsa, 8-Mar-2019.)
theorem inxpss3 {x3 y1: setvar} (A2: class x3) (B2 R S: class x3 y1):
  $ wb (wal x3 (wal y1 (wi (wbr (cv x3) (cv y1) (cin R (cxp A2 B2))) (wbr (cv x3) (cv y1) (cin S (cxp A2 B2)))))) (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) R) (wbr (cv x3) (cv y1) S)) B2) A2) $;

--| Two ways to say that intersections with Cartesian products are in a subclass relation. (Contributed by Peter Mazsa, 8-Mar-2019.)
theorem inxpss2 {x3 y1: setvar} (A2 B2 R S: class):
  $ wb (wss (cin R (cxp A2 B2)) (cin S (cxp A2 B2))) (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) R) (wbr (cv x3) (cv y1) S)) B2) A2) $;

--| Two ways to say that intersections with Cartesian products are in a subclass relation, special case of ~ inxpss2 . (Contributed by Peter Mazsa, 4-Jul-2019.)
theorem inxpssidinxp {x3 y1: setvar} (A2 B2 R: class):
  $ wb (wss (cin R (cxp A2 B2)) (cin cid (cxp A2 B2))) (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) R) (wceq (cv x3) (cv y1))) B2) A2) $;

--| Two ways to say that intersections with Cartesian products are in a subclass relation, special case of ~ inxpss2 . (Contributed by Peter Mazsa, 6-Mar-2019.)
theorem idinxpssinxp {x3 y1: setvar} (A2 B2 R: class):
  $ wb (wss (cin cid (cxp A2 B2)) (cin R (cxp A2 B2))) (wral x3 (wral y1 (wi (wceq (cv x3) (cv y1)) (wbr (cv x3) (cv y1) R)) B2) A2) $;

--| Identity intersection with a square Cartesian product in subclass relation with an intersection with the same Cartesian product. (Contributed by Peter Mazsa, 4-Mar-2019.) (Proof modification is discouraged.)
theorem idinxpssinxp2 {x3: setvar} (A2 R: class):
  $ wb (wss (cin cid (cxp A2 A2)) (cin R (cxp A2 A2))) (wral x3 (wbr (cv x3) (cv x3) R) A2) $;

--| Identity intersection with a square Cartesian product in subclass relation with an intersection with the same Cartesian product. (Contributed by Peter Mazsa, 16-Mar-2019.) (Proof modification is discouraged.)
theorem idinxpssinxp3 (A2 R: class):
  $ wb (wss (cin cid (cxp A2 A2)) (cin R (cxp A2 A2))) (wss (cres cid A2) R) $;

--| Identity intersection with a square Cartesian product in subclass relation with an intersection with the same Cartesian product (see also ~ idinxpssinxp2 ). (Contributed by Peter Mazsa, 8-Mar-2019.)
theorem idinxpssinxp4 {x3 y1: setvar} (A2 R: class):
  $ wb (wral x3 (wral y1 (wi (wceq (cv x3) (cv y1)) (wbr (cv x3) (cv y1) R)) A2) A2) (wral x3 (wbr (cv x3) (cv x3) R) A2) $;

--| Two ways of saying a relation is symmetric. (Contributed by FL, 31-Aug-2009.)
theorem relcnveq3 {x3 y1: setvar} (R: class):
  $ wi (wrel R) (wb (wceq R (ccnv R)) (wal x3 (wal y1 (wi (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv x3) R))))) $;

--| Two ways of saying a relation is symmetric. (Contributed by Peter Mazsa, 23-Aug-2018.)
theorem relcnveq (R: class):
  $ wi (wrel R) (wb (wss (ccnv R) R) (wceq (ccnv R) R)) $;

--| Two ways of saying a relation is symmetric. (Contributed by Peter Mazsa, 28-Apr-2019.)
theorem relcnveq2 {x3 y1: setvar} (R: class):
  $ wi (wrel R) (wb (wceq (ccnv R) R) (wal x3 (wal y1 (wb (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv x3) R))))) $;

--| Two ways of saying a relation is symmetric. (Contributed by Peter Mazsa, 28-Apr-2019.)
theorem relcnveq4 {x3 y1: setvar} (R: class):
  $ wi (wrel R) (wb (wss (ccnv R) R) (wal x3 (wal y1 (wb (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv x3) R))))) $;

--| Simplification of a special quotient set. (Contributed by Peter Mazsa, 2-Sep-2020.)
theorem qsresid (A2 R: class):
  $ wceq (cqs A2 (cres R A2)) (cqs A2 R) $;

--| Two ways of expressing that the empty set is not an element of a quotient set. (Contributed by Peter Mazsa, 5-Dec-2019.)
theorem n0elqs (A2 R: class):
  $ wb (wn (wcel c0 (cqs A2 R))) (wss A2 (cdm R)) $;

--| Two ways of expressing that the empty set is not an element of a quotient set. (Contributed by Peter Mazsa, 25-Jul-2021.)
theorem n0elqs2 (A2 R: class):
  $ wb (wn (wcel c0 (cqs A2 R))) (wceq (cdm (cres R A2)) A2) $;

--| The range of a restriction is equal to the union of the quotient set. (Contributed by Peter Mazsa, 19-May-2018.)
theorem rnresequniqs (A2 R V: class):
  $ wi (wcel (cres R A2) V) (wceq (crn (cres R A2)) (cuni (cqs A2 R))) $;

--| Two ways of expressing that the empty set is not an element of a class. (Contributed by Peter Mazsa, 31-Jan-2018.)
theorem n0el2 (A2: class):
  $ wb (wn (wcel c0 A2)) (wceq (cdm (cres (ccnv cep) A2)) A2) $;

--| Sethood condition for the restricted converse epsilon relation. (Contributed by Peter Mazsa, 24-Sep-2018.)
theorem cnvepresex (A2 V: class):
  $ wi (wcel A2 V) (wcel (cres (ccnv cep) A2) cvv) $;

--| The image of converse epsilon. (Contributed by Peter Mazsa, 22-Mar-2023.)
theorem cnvepima (A2 V: class):
  $ wi (wcel A2 V) (wceq (cima (ccnv cep) A2) (cuni A2)) $;

--| Sufficient condition for the intersection relation to be a set. (Contributed by Peter Mazsa, 24-Nov-2019.)
theorem inex3 (A2 B2 V W: class):
  $ wi (wo (wcel A2 V) (wcel B2 W)) (wcel (cin A2 B2) cvv) $;

--| Sufficient condition for an intersection with a Cartesian product to be a set. (Contributed by Peter Mazsa, 10-May-2019.)
theorem inxpex (A2 B2 R U V W: class):
  $ wi (wo (wcel R W) (wa (wcel A2 U) (wcel B2 V))) (wcel (cin R (cxp A2 B2)) cvv) $;

--| Converting a class constant definition by restriction (like ~ df-ers or ~ df-parts ) into a binary relation. (Contributed by Peter Mazsa, 1-Oct-2018.)
theorem eqres (A2 B2 C R S V: class):
  $ wceq R (cres S C) $ >
  $ wi (wcel B2 V) (wb (wbr A2 B2 R) (wa (wcel A2 C) (wbr A2 B2 S))) $;

--| The law of concretion for operation class abstraction. (Contributed by Peter Mazsa, 24-Oct-2022.)
theorem brrabga {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff) (A2 B2 C: class) (R V W X: class x3 y1 z):
  $ wi (w3a (wceq (cv x3) A2) (wceq (cv y1) B2) (wceq (cv z) C)) (wb ph ps) $ >
  $ wceq R (coprab x3 y1 z ph) $ >
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel C X)) (wb (wbr (cop A2 B2) C R) ps) $;

--| The law of concretion for the converse of operation class abstraction. (Contributed by Peter Mazsa, 25-Oct-2022.)
theorem brcnvrabga {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff) (A2 B2 C: class) (R V W X: class x3 y1 z):
  $ wi (w3a (wceq (cv x3) A2) (wceq (cv y1) B2) (wceq (cv z) C)) (wb ph ps) $ >
  $ wceq R (ccnv (coprab y1 z x3 ph)) $ >
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel C X)) (wb (wbr A2 (cop B2 C) R) ps) $;

--| Equality conditions for ordered pairs ` <. A , A >. ` and ` <. B , B >. ` . (Contributed by Peter Mazsa, 22-Jul-2019.) (Revised by Thierry Arnoux, 16-Feb-2022.)
theorem opideq (A2 B2 V: class):
  $ wi (wcel A2 V) (wb (wceq (cop A2 A2) (cop B2 B2)) (wceq A2 B2)) $;

--| A subclass of the identity relation is the intersection of identity relation with Cartesian product of the domain and range of the class. (Contributed by Peter Mazsa, 22-Jul-2019.)
theorem iss2 (A2: class):
  $ wb (wss A2 cid) (wceq A2 (cin cid (cxp (cdm A2) (crn A2)))) $;

--| Elementhood in a domain of a converse. (Contributed by Peter Mazsa, 25-May-2018.)
theorem eldmcnv {u: setvar} (A2 R V: class):
  $ wi (wcel A2 V) (wb (wcel A2 (cdm (ccnv R))) (wex u (wbr (cv u) A2 R))) $;

--| Alternate definition of the relation predicate. (Contributed by Peter Mazsa, 6-Nov-2018.)
theorem dfrel5 (R: class):
  $ wb (wrel R) (wceq (cres R (cdm R)) R) $;

--| Alternate definition of the relation predicate. (Contributed by Peter Mazsa, 14-Mar-2019.)
theorem dfrel6 (R: class):
  $ wb (wrel R) (wceq (cin R (cxp (cdm R) (crn R))) R) $;

--| Converse restricted to range is converse. (Contributed by Peter Mazsa, 3-Sep-2021.)
theorem cnvresrn (R: class):
  $ wceq (cres (ccnv R) (crn R)) (ccnv R) $;

--| Subset of restriction, special case. (Contributed by Peter Mazsa, 10-Apr-2023.)
theorem relssinxpdmrn (R S: class):
  $ wi (wrel R) (wb (wss R (cin S (cxp (cdm R) (crn R)))) (wss R S)) $;

--| Two ways to say that a relation is a subclass. (Contributed by Peter Mazsa, 11-Apr-2023.)
theorem cnvref4 (R S: class):
  $ wi (wrel R) (wb (wss (cin R (cxp (cdm R) (crn R))) (cin S (cxp (cdm R) (crn R)))) (wss R S)) $;

--| Two ways to say that a relation is a subclass of the identity relation. (Contributed by Peter Mazsa, 26-Jun-2019.)
theorem cnvref5 {x3 y1: setvar} (R: class):
  $ wi (wrel R) (wb (wss R cid) (wal x3 (wal y1 (wi (wbr (cv x3) (cv y1) R) (wceq (cv x3) (cv y1)))))) $;

--| Two ways of saying that the coset of ` A ` and the coset of ` B ` have no elements in common. (Contributed by Peter Mazsa, 1-Dec-2018.)
theorem ecin0 {x3: setvar} (A2 B2 R V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wceq (cin (cec A2 R) (cec B2 R)) c0) (wal x3 (wi (wbr A2 (cv x3) R) (wn (wbr B2 (cv x3) R))))) $;

--| Two ways of saying that the coset of ` A ` and the coset of ` B ` have some elements in common. (Contributed by Peter Mazsa, 23-Jan-2019.)
theorem ecinn0 {x3: setvar} (A2 B2 R V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wne (cin (cec A2 R) (cec B2 R)) c0) (wex x3 (wa (wbr A2 (cv x3) R) (wbr B2 (cv x3) R)))) $;

--| Equivalence of restricted universal quantifications. (Contributed by Peter Mazsa, 29-May-2018.)
theorem ineleq {x3 y1 z: setvar} (A2: class x3 y1 z) (B2 C D: class x3 y1):
  $ wb (wral x3 (wral y1 (wo (wceq (cv x3) (cv y1)) (wceq (cin C D) c0)) B2) A2) (wral x3 (wal z (wral y1 (wi (wa (wcel (cv z) C) (wcel (cv z) D)) (wceq (cv x3) (cv y1))) B2)) A2) $;

--| Equivalence of a double restricted universal quantification and a restricted "at most one" inside a universal quantification. (Contributed by Peter Mazsa, 29-May-2018.)
theorem inecmo {x3 y1 z: setvar} (A2: class) (B2: class x3) (C: class y1) (R: class):
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 C) $ >
  $ wi (wrel R) (wb (wral x3 (wral y1 (wo (wceq (cv x3) (cv y1)) (wceq (cin (cec B2 R) (cec C R)) c0)) A2) A2) (wal z (wrmo x3 (wbr B2 (cv z) R) A2))) $;

--| Equivalence of a double restricted universal quantification and a restricted "at most one" inside a universal quantification. (Contributed by Peter Mazsa, 29-May-2018.) (Revised by Peter Mazsa, 2-Sep-2021.)
theorem inecmo2 {x3 v u: setvar} (A2 R: class):
  $ wb (wa (wral u (wral v (wo (wceq (cv u) (cv v)) (wceq (cin (cec (cv u) R) (cec (cv v) R)) c0)) A2) A2) (wrel R)) (wa (wal x3 (wrmo u (wbr (cv u) (cv x3) R) A2)) (wrel R)) $;

--| Equivalence of a double restricted universal quantification and a restricted "at most one" inside a universal quantification. (Contributed by Peter Mazsa, 2-Sep-2021.)
theorem ineccnvmo {x3 y1 z: setvar} (B2 F: class):
  $ wb (wral y1 (wral z (wo (wceq (cv y1) (cv z)) (wceq (cin (cec (cv y1) (ccnv F)) (cec (cv z) (ccnv F))) c0)) B2) B2) (wal x3 (wrmo y1 (wbr (cv x3) (cv y1) F) B2)) $;

--| Equivalence of an "at most one" and an "at most one" restricted to the range inside a universal quantification. (Contributed by Peter Mazsa, 3-Sep-2021.)
theorem alrmomorn {x3 y1: setvar} (R: class x3 y1):
  $ wb (wal x3 (wrmo y1 (wbr (cv x3) (cv y1) R) (crn R))) (wal x3 (wmo y1 (wbr (cv x3) (cv y1) R))) $;

--| Equivalence of an "at most one" and an "at most one" restricted to the domain inside a universal quantification. (Contributed by Peter Mazsa, 5-Sep-2021.)
theorem alrmomodm {x3 u: setvar} (R: class):
  $ wi (wrel R) (wb (wal x3 (wrmo u (wbr (cv u) (cv x3) R) (cdm R))) (wal x3 (wmo u (wbr (cv u) (cv x3) R)))) $;

--| "At most one" can be restricted to the range. (Contributed by Peter Mazsa, 2-Feb-2026.)
theorem ralmo {x3 u: setvar} (R: class x3):
  $ wb (wal x3 (wmo u (wbr (cv u) (cv x3) R))) (wral x3 (wmo u (wbr (cv u) (cv x3) R)) (crn R)) $;

--| On the range, "at most one" becomes "exactly one". (Contributed by Peter Mazsa, 27-Sep-2018.) (Revised by Peter Mazsa, 2-Feb-2026.)
theorem ralrnmo {x3 u: setvar} (R: class):
  $ wb (wral x3 (wmo u (wbr (cv u) (cv x3) R)) (crn R)) (wral x3 (weu u (wbr (cv u) (cv x3) R)) (crn R)) $;

--| Sethood of the domain quotient under sethood of ` R ` . (Contributed by Peter Mazsa, 2-Nov-2018.)
theorem dmqsex (R V: class):
  $ wi (wcel R V) (wcel (cqs (cdm R) R) cvv) $;

--| On the quotient carrier, "at most one" and "exactly one" coincide for coset witnesses. (Contributed by Peter Mazsa, 6-Feb-2026.)
theorem raldmqsmo {u t: setvar} (R: class):
  $ wb (wral u (wrmo t (wceq (cv u) (cec (cv t) R)) (cdm R)) (cqs (cdm R) R)) (wral u (wreu t (wceq (cv u) (cec (cv t) R)) (cdm R)) (cqs (cdm R) R)) $;

--| Pull a restricted universal quantifier into the body (for ` E* ` ). (Contributed by Peter Mazsa, 9-May-2019.)
theorem ralrmo3 {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class y1):
  $ wb (wral y1 (wrmo x3 ph A2) B2) (wal y1 (wrmo x3 (wa (wcel (cv y1) B2) ph) A2)) $;

--| Equivalence between "exactly one" on the quotient carrier and "at most one" globally. Provides a type-safe way to talk about unique representatives either as ` E! ` on the intended carrier or as a global ` E* ` statement. (Contributed by Peter Mazsa, 6-Feb-2026.)
theorem raldmqseu {u t: setvar} (R V: class):
  $ wi (wcel R V) (wb (wral u (wreu t (wceq (cv u) (cec (cv t) R)) (cdm R)) (cqs (cdm R) R)) (wal u (wrmo t (wceq (cv u) (cec (cv t) R)) (cdm R)))) $;

--| From a restricted universal statement over ` A ` , specialize to an arbitrary element ` y e. A ` , cf. ~ rsp . (Contributed by Peter Mazsa, 9-Feb-2026.)
theorem rsp3 {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wral x3 ph A2) (wi (wcel (cv y1) A2) ps) $;

--| From a restricted universal statement over ` A ` , specialize to an arbitrary element class, cf. ~ rsp3 . (Contributed by Peter Mazsa, 9-Feb-2026.)
theorem rsp3eq {x3 y1: setvar} (ph ps: wff x3 y1) (A2 B2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wral x3 ph A2) (wi (wa (wceq (cv y1) B2) (wcel B2 A2)) ps) $;

--| Equivalence of a double universal quantification restricted to the range and an "at most one" inside a universal quantification. (Contributed by Peter Mazsa, 4-Sep-2021.)
theorem ineccnvmo2 {x3 y1 u: setvar} (F: class):
  $ wb (wral x3 (wral y1 (wo (wceq (cv x3) (cv y1)) (wceq (cin (cec (cv x3) (ccnv F)) (cec (cv y1) (ccnv F))) c0)) (crn F)) (crn F)) (wal u (wmo x3 (wbr (cv u) (cv x3) F))) $;

--| Equivalence of a double universal quantification restricted to the domain and an "at most one" inside a universal quantification. (Contributed by Peter Mazsa, 5-Sep-2021.)
theorem inecmo3 {x3 v u: setvar} (R: class):
  $ wb (wa (wral u (wral v (wo (wceq (cv u) (cv v)) (wceq (cin (cec (cv u) R) (cec (cv v) R)) c0)) (cdm R)) (cdm R)) (wrel R)) (wa (wal x3 (wmo u (wbr (cv u) (cv x3) R))) (wrel R)) $;

--| Uniqueness is equivalent to non-existence or unique existence. Alternate definition of the at-most-one quantifier, in terms of the existential quantifier and the unique existential quantifier. (Contributed by Peter Mazsa, 19-Nov-2024.)
theorem moeu2 {x3: setvar} (ph: wff x3):
  $ wb (wmo x3 ph) (wo (wn (wex x3 ph)) (weu x3 ph)) $;

--| "At most one" picks a variable value, eliminating an existential quantifier. The proof begins with references *2.21 ( ~ pm2.21 ) and *14.26 ( ~ eupickbi ) from [WhiteheadRussell] p. 104 and p. 183. (Contributed by Peter Mazsa, 18-Nov-2024.) (Proof modification is discouraged.)
theorem mopickr {x3: setvar} (ph ps: wff x3):
  $ wi (wa (wmo x3 ps) (wex x3 (wa ph ps))) (wi ps ph) $;

--| Sufficient condition for transitivity of conjunctions inside existential quantifiers. (Contributed by Peter Mazsa, 2-Oct-2018.)
theorem moantr {x3: setvar} (ph ps ch: wff x3):
  $ wi (wmo x3 ps) (wi (wa (wex x3 (wa ph ps)) (wex x3 (wa ps ch))) (wex x3 (wa ph ch))) $;

--| The law of concretion for a binary relation. Special case of ~ brabga . Version of ~ brabidga with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by Peter Mazsa, 24-Nov-2018.) (Revised by GG, 2-Apr-2024.)
theorem brabidgaw {x3 y1: setvar} (ph: wff x3 y1) (R: class x3 y1):
  $ wceq R (copab x3 y1 ph) $ >
  $ wb (wbr (cv x3) (cv y1) R) ph $;

--| The law of concretion for a binary relation. Special case of ~ brabga . Usage of this theorem is discouraged because it depends on ~ ax-13 , see ~ brabidgaw for a weaker version that does not require it. (Contributed by Peter Mazsa, 24-Nov-2018.) (New usage is discouraged.)
theorem brabidga {x3 y1: setvar} (ph: wff x3 y1) (R: class x3 y1):
  $ wceq R (copab x3 y1 ph) $ >
  $ wb (wbr (cv x3) (cv y1) R) ph $;

--| Intersection with a Cartesian product. (Contributed by Peter Mazsa, 18-Jul-2019.)
theorem inxp2 {x3 y1: setvar} (A2 B2 R: class):
  $ wceq (cin R (cxp A2 B2)) (copab x3 y1 (wa (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) (wbr (cv x3) (cv y1) R))) $;

--| A class abstraction of a collection of ordered pairs with a negated wff is the empty set. (Contributed by Peter Mazsa, 21-Oct-2019.) (Proof shortened by Thierry Arnoux, 18-Feb-2022.)
theorem opabf {x3 y1: setvar} (ph: wff x3 y1):
  $ wn ph $ >
  $ wceq (copab x3 y1 ph) c0 $;

--| The empty-coset of a class is the empty set. (Contributed by Peter Mazsa, 19-May-2019.)
theorem ec0 (A2: class):
  $ wceq (cec A2 c0) c0 $;

--| Intersection with a converse, binary relation. (Contributed by Peter Mazsa, 24-Mar-2024.)
theorem brcnvin (A2 B2 R S V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wbr A2 B2 (cin R (ccnv S))) (wa (wbr A2 B2 R) (wbr B2 A2 S))) $;

--| Subclass of a domain. (Contributed by Peter Mazsa, 15-Sep-2018.)
theorem ssdmral {x3 y1: setvar} (A2: class y1) (R: class):
  $ wb (wss A2 (cdm R)) (wral x3 (wex y1 (wbr (cv x3) (cv y1) R)) A2) $;

--| Define the range Cartesian product of two classes. Definition from [Holmes] p. 40. Membership in this class is characterized by ~ xrnss3v and ~ brxrn . This is Scott Fenton's ~ df-txp with a different symbol, see ~ https://github.com/metamath/set.mm/issues/2469 . (Contributed by Scott Fenton, 31-Mar-2012.)
axiom df_xrn (A2 B2: class):
  $ wceq (cxrn A2 B2) (cin (ccom (ccnv (cres c1st (cxp cvv cvv))) A2) (ccom (ccnv (cres c2nd (cxp cvv cvv))) B2)) $;

--| A range Cartesian product is a subset of the class of ordered triples. This is Scott Fenton's ~ txpss3v with a different symbol, see ~ https://github.com/metamath/set.mm/issues/2469 . (Contributed by Scott Fenton, 31-Mar-2012.)
theorem xrnss3v (A2 B2: class):
  $ wss (cxrn A2 B2) (cxp cvv (cxp cvv cvv)) $;

--| A range Cartesian product is a relation. This is Scott Fenton's ~ txprel with a different symbol, see ~ https://github.com/metamath/set.mm/issues/2469 . (Contributed by Scott Fenton, 31-Mar-2012.)
theorem xrnrel (A2 B2: class):
  $ wrel (cxrn A2 B2) $;

--| Characterize a ternary relation over a range Cartesian product. Together with ~ xrnss3v , this characterizes elementhood in a range cross. (Contributed by Peter Mazsa, 27-Jun-2021.)
theorem brxrn (A2 B2 C R S V W X: class):
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel C X)) (wb (wbr A2 (cop B2 C) (cxrn R S)) (wa (wbr A2 B2 R) (wbr A2 C S))) $;

--| A characterization of the range Cartesian product. (Contributed by Peter Mazsa, 14-Oct-2020.)
theorem brxrn2 {x3 y1: setvar} (A2 B2 R S V: class):
  $ wi (wcel A2 V) (wb (wbr A2 B2 (cxrn R S)) (wex x3 (wex y1 (w3a (wceq B2 (cop (cv x3) (cv y1))) (wbr A2 (cv x3) R) (wbr A2 (cv y1) S))))) $;

--| Alternate definition of the range Cartesian product. (Contributed by Peter Mazsa, 20-Feb-2022.)
theorem dfxrn2 {x3 y1 u: setvar} (R S: class):
  $ wceq (cxrn R S) (ccnv (coprab x3 y1 u (wa (wbr (cv u) (cv x3) R) (wbr (cv u) (cv y1) S)))) $;

--| The range product with converse epsilon relation. (Contributed by Peter Mazsa, 22-Jun-2020.) (Revised by Peter Mazsa, 22-Nov-2025.)
theorem brxrncnvep (A2 B2 C R V W X: class):
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel C X)) (wb (wbr A2 (cop B2 C) (cxrn R (ccnv cep))) (wa (wcel C A2) (wbr A2 B2 R))) $;

--| Domain of the range product. (Contributed by Peter Mazsa, 19-Apr-2020.) (Revised by Peter Mazsa, 22-Nov-2025.)
theorem dmxrn (R S: class):
  $ wceq (cdm (cxrn R S)) (cin (cdm R) (cdm S)) $;

--| Domain of converse epsilon relation. (Contributed by Peter Mazsa, 30-Jan-2018.) (Revised by Peter Mazsa, 23-Nov-2025.)
theorem dmcnvep:
  $ wceq (cdm (ccnv cep)) (cdif cvv (csn c0)) $;

--| Domain of the range product with converse epsilon relation. (Contributed by Peter Mazsa, 23-Nov-2025.)
theorem dmxrncnvep (R: class):
  $ wceq (cdm (cxrn R (ccnv cep))) (cdif (cdm R) (csn c0)) $;

--| Domain of the restricted converse epsilon relation. (Contributed by Peter Mazsa, 28-Jan-2026.)
theorem dmcnvepres (A2: class):
  $ wceq (cdm (cres (ccnv cep) A2)) (cdif A2 (csn c0)) $;

--| Domain of the union with the converse epsilon, restricted. (Contributed by Peter Mazsa, 28-Jan-2026.)
theorem dmuncnvepres (A2 R: class):
  $ wceq (cdm (cres (cun R (ccnv cep)) A2)) (cin A2 (cun (cdm R) (cdif cvv (csn c0)))) $;

--| Domain of the combined relation of two special relations, see ~ blockadjliftmap . (Contributed by Peter Mazsa, 28-Jan-2026.)
theorem dmxrnuncnvepres (A2 R: class):
  $ wceq (cdm (cres (cun (cxrn R (ccnv cep)) (ccnv cep)) A2)) (cdif A2 (csn c0)) $;

--| The union coset of ` A ` . (Contributed by Peter Mazsa, 28-Jan-2026.)
theorem ecun (A2 R S V: class):
  $ wi (wcel A2 V) (wceq (cec A2 (cun R S)) (cun (cec A2 R) (cec A2 S))) $;

--| The restricted union coset of ` B ` . (Contributed by Peter Mazsa, 28-Jan-2026.)
theorem ecunres (A2 B2 R S V: class):
  $ wi (wcel B2 V) (wceq (cec B2 (cres (cun R S) A2)) (cun (cec B2 (cres R A2)) (cec B2 (cres S A2)))) $;

--| The restricted union with converse epsilon relation coset of ` B ` . (Contributed by Peter Mazsa, 28-Jan-2026.)
theorem ecuncnvepres (A2 B2 R: class):
  $ wi (wcel B2 A2) (wceq (cec B2 (cres (cun R (ccnv cep)) A2)) (cun B2 (cec B2 R))) $;

--| Equality theorem for the range Cartesian product. (Contributed by Peter Mazsa, 16-Dec-2020.)
theorem xrneq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cxrn A2 C) (cxrn B2 C)) $;

--| Equality theorem for the range Cartesian product, inference form. (Contributed by Peter Mazsa, 16-Dec-2020.)
theorem xrneq1i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cxrn A2 C) (cxrn B2 C) $;

--| Equality theorem for the range Cartesian product, deduction form. (Contributed by Peter Mazsa, 7-Sep-2021.)
theorem xrneq1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cxrn A2 C) (cxrn B2 C)) $;

--| Equality theorem for the range Cartesian product. (Contributed by Peter Mazsa, 16-Dec-2020.)
theorem xrneq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cxrn C A2) (cxrn C B2)) $;

--| Equality theorem for the range Cartesian product, inference form. (Contributed by Peter Mazsa, 16-Dec-2020.)
theorem xrneq2i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cxrn C A2) (cxrn C B2) $;

--| Equality theorem for the range Cartesian product, deduction form. (Contributed by Peter Mazsa, 7-Sep-2021.)
theorem xrneq2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cxrn C A2) (cxrn C B2)) $;

--| Equality theorem for the range Cartesian product. (Contributed by Peter Mazsa, 16-Dec-2020.)
theorem xrneq12 (A2 B2 C D: class):
  $ wi (wa (wceq A2 B2) (wceq C D)) (wceq (cxrn A2 C) (cxrn B2 D)) $;

--| Equality theorem for the range Cartesian product, inference form. (Contributed by Peter Mazsa, 16-Dec-2020.)
theorem xrneq12i (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq C D $ >
  $ wceq (cxrn A2 C) (cxrn B2 D) $;

--| Equality theorem for the range Cartesian product, deduction form. (Contributed by Peter Mazsa, 18-Dec-2021.)
theorem xrneq12d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq (cxrn A2 C) (cxrn B2 D)) $;

--| Elementhood in the ` ( R |X. S ) ` -coset of ` A ` . (Contributed by Peter Mazsa, 18-Apr-2020.) (Revised by Peter Mazsa, 21-Sep-2021.)
theorem elecxrn {x3 y1: setvar} (A2 B2 R S V: class):
  $ wi (wcel A2 V) (wb (wcel B2 (cec A2 (cxrn R S))) (wex x3 (wex y1 (w3a (wceq B2 (cop (cv x3) (cv y1))) (wbr A2 (cv x3) R) (wbr A2 (cv y1) S))))) $;

--| The ` ( R |X. S ) ` -coset of ` A ` . (Contributed by Peter Mazsa, 18-Apr-2020.) (Revised by Peter Mazsa, 21-Sep-2021.)
theorem ecxrn {y1 z: setvar} (A2 R S V: class):
  $ wi (wcel A2 V) (wceq (cec A2 (cxrn R S)) (copab y1 z (wa (wbr A2 (cv y1) R) (wbr A2 (cv z) S)))) $;

--| The ` ( R |X. S ) ` -coset of a set is a relation. (Contributed by Peter Mazsa, 15-Oct-2020.)
theorem relecxrn (A2 R S V: class):
  $ wi (wcel A2 V) (wrel (cec A2 (cxrn R S))) $;

--| The ` ( R |X. S ) ` -coset of a set is the Cartesian product of its ` R ` -coset and ` S ` -coset. (Contributed by Peter Mazsa, 16-Oct-2020.)
theorem ecxrn2 (A2 R S V: class):
  $ wi (wcel A2 V) (wceq (cec A2 (cxrn R S)) (cxp (cec A2 R) (cec A2 S))) $;

--| The ` ( R |X. ``' _E ) ` -coset of a set. (Contributed by Peter Mazsa, 22-May-2021.)
theorem ecxrncnvep {y1 z: setvar} (A2 R V: class):
  $ wi (wcel A2 V) (wceq (cec A2 (cxrn R (ccnv cep))) (copab y1 z (wa (wcel (cv z) A2) (wbr A2 (cv y1) R)))) $;

--| The ` ( R |X. ``' _E ) ` -coset of a set is the Cartesian product of its ` R ` -coset and the set. (Contributed by Peter Mazsa, 25-Jan-2026.)
theorem ecxrncnvep2 (A2 R V: class):
  $ wi (wcel A2 V) (wceq (cec A2 (cxrn R (ccnv cep))) (cxp (cec A2 R) A2)) $;

--| Double restricted quantification over the union of a set and its singleton. (Contributed by Peter Mazsa, 22-Aug-2023.)
theorem disjressuc2 {v u: setvar} (A2 R: class) (V: class v):
  $ wi (wcel A2 V) (wb (wral u (wral v (wo (wceq (cv u) (cv v)) (wceq (cin (cec (cv u) R) (cec (cv v) R)) c0)) (cun A2 (csn A2))) (cun A2 (csn A2))) (wa (wral u (wral v (wo (wceq (cv u) (cv v)) (wceq (cin (cec (cv u) R) (cec (cv v) R)) c0)) A2) A2) (wral u (wceq (cin (cec (cv u) R) (cec A2 R)) c0) A2))) $;

--| Two ways of saying that ` ( R |X. S ) ` -cosets are disjoint. (Contributed by Peter Mazsa, 19-Jun-2020.) (Revised by Peter Mazsa, 21-Aug-2023.)
theorem disjecxrn (A2 B2 R S V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wceq (cin (cec A2 (cxrn R S)) (cec B2 (cxrn R S))) c0) (wo (wceq (cin (cec A2 R) (cec B2 R)) c0) (wceq (cin (cec A2 S) (cec B2 S)) c0))) $;

--| Two ways of saying that cosets are disjoint, special case of ~ disjecxrn . (Contributed by Peter Mazsa, 12-Jul-2020.) (Revised by Peter Mazsa, 25-Aug-2023.)
theorem disjecxrncnvep (A2 B2 R V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wceq (cin (cec A2 (cxrn R (ccnv cep))) (cec B2 (cxrn R (ccnv cep)))) c0) (wo (wceq (cin A2 B2) c0) (wceq (cin (cec A2 R) (cec B2 R)) c0))) $;

--| Double restricted quantification over the union of a set and its singleton. (Contributed by Peter Mazsa, 22-Aug-2023.)
theorem disjsuc2 {v u: setvar} (A2 R: class) (V: class v):
  $ wi (wcel A2 V) (wb (wral u (wral v (wo (wceq (cv u) (cv v)) (wceq (cin (cec (cv u) (cxrn R (ccnv cep))) (cec (cv v) (cxrn R (ccnv cep)))) c0)) (cun A2 (csn A2))) (cun A2 (csn A2))) (wa (wral u (wral v (wo (wceq (cv u) (cv v)) (wceq (cin (cec (cv u) (cxrn R (ccnv cep))) (cec (cv v) (cxrn R (ccnv cep)))) c0)) A2) A2) (wral u (wo (wceq (cin (cv u) A2) c0) (wceq (cin (cec (cv u) R) (cec A2 R)) c0)) A2))) $;

--| Intersection of a range Cartesian product with a Cartesian product. (Contributed by Peter Mazsa, 7-Apr-2020.)
theorem xrninxp {y1 z u: setvar} (A2 B2 C R S: class):
  $ wceq (cin (cxrn R S) (cxp A2 (cxp B2 C))) (ccnv (coprab y1 z u (wa (wa (wcel (cv y1) B2) (wcel (cv z) C)) (wa (wcel (cv u) A2) (wbr (cv u) (cop (cv y1) (cv z)) (cxrn R S)))))) $;

--| Intersection of a range Cartesian product with a Cartesian product. (Contributed by Peter Mazsa, 8-Apr-2020.)
theorem xrninxp2 {x3 u: setvar} (A2 B2 C R S: class):
  $ wceq (cin (cxrn R S) (cxp A2 (cxp B2 C))) (copab u x3 (wa (wcel (cv x3) (cxp B2 C)) (wa (wcel (cv u) A2) (wbr (cv u) (cv x3) (cxrn R S))))) $;

--| Sufficient condition for the intersection of a range Cartesian product with a Cartesian product to be a set. (Contributed by Peter Mazsa, 12-Apr-2020.)
theorem xrninxpex (A2 B2 C R S V W X: class):
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel C X)) (wcel (cin (cxrn R S) (cxp A2 (cxp B2 C))) cvv) $;

--| Two ways to express the intersection of a range Cartesian product with a Cartesian product. (Contributed by Peter Mazsa, 10-Apr-2020.)
theorem inxpxrn (A2 B2 C R S: class):
  $ wceq (cxrn (cin R (cxp A2 B2)) (cin S (cxp A2 C))) (cin (cxrn R S) (cxp A2 (cxp B2 C))) $;

--| The converse of a binary relation over a range Cartesian product. (Contributed by Peter Mazsa, 11-Jul-2021.)
theorem br1cnvxrn2 {y1 z: setvar} (A2 B2 R S V: class):
  $ wi (wcel B2 V) (wb (wbr A2 B2 (ccnv (cxrn R S))) (wex y1 (wex z (w3a (wceq A2 (cop (cv y1) (cv z))) (wbr B2 (cv y1) R) (wbr B2 (cv z) S))))) $;

--| Elementhood in the converse range Cartesian product coset of ` A ` . (Contributed by Peter Mazsa, 11-Jul-2021.)
theorem elec1cnvxrn2 {y1 z: setvar} (A2 B2 R S V: class):
  $ wi (wcel B2 V) (wb (wcel B2 (cec A2 (ccnv (cxrn R S)))) (wex y1 (wex z (w3a (wceq A2 (cop (cv y1) (cv z))) (wbr B2 (cv y1) R) (wbr B2 (cv z) S))))) $;

--| Range of the range Cartesian product of classes. (Contributed by Peter Mazsa, 1-Jun-2020.)
theorem rnxrn {x3 y1 u: setvar} (R S: class):
  $ wceq (crn (cxrn R S)) (copab x3 y1 (wex u (wa (wbr (cv u) (cv x3) R) (wbr (cv u) (cv y1) S)))) $;

--| Range of a range Cartesian product with a restricted relation. (Contributed by Peter Mazsa, 5-Dec-2021.)
theorem rnxrnres {x3 y1 u: setvar} (A2 R S: class):
  $ wceq (crn (cxrn R (cres S A2))) (copab x3 y1 (wrex u (wa (wbr (cv u) (cv x3) R) (wbr (cv u) (cv y1) S)) A2)) $;

--| Range of a range Cartesian product with a restriction of the converse epsilon relation. (Contributed by Peter Mazsa, 6-Dec-2021.)
theorem rnxrncnvepres {x3 y1 u: setvar} (A2 R: class):
  $ wceq (crn (cxrn R (cres (ccnv cep) A2))) (copab x3 y1 (wrex u (wa (wcel (cv y1) (cv u)) (wbr (cv u) (cv x3) R)) A2)) $;

--| Range of a range Cartesian product with a restriction of the identity relation. (Contributed by Peter Mazsa, 6-Dec-2021.)
theorem rnxrnidres {x3 y1 u: setvar} (A2 R: class):
  $ wceq (crn (cxrn R (cres cid A2))) (copab x3 y1 (wrex u (wa (wceq (cv u) (cv y1)) (wbr (cv u) (cv x3) R)) A2)) $;

--| Two ways to express restriction of range Cartesian product, see also ~ xrnres2 , ~ xrnres3 . (Contributed by Peter Mazsa, 5-Jun-2021.)
theorem xrnres (A2 R S: class):
  $ wceq (cres (cxrn R S) A2) (cxrn (cres R A2) S) $;

--| Two ways to express restriction of range Cartesian product, see also ~ xrnres , ~ xrnres3 . (Contributed by Peter Mazsa, 6-Sep-2021.)
theorem xrnres2 (A2 R S: class):
  $ wceq (cres (cxrn R S) A2) (cxrn R (cres S A2)) $;

--| Two ways to express restriction of range Cartesian product, see also ~ xrnres , ~ xrnres2 . (Contributed by Peter Mazsa, 28-Mar-2020.)
theorem xrnres3 (A2 R S: class):
  $ wceq (cres (cxrn R S) A2) (cxrn (cres R A2) (cres S A2)) $;

--| Two ways to express restriction of range Cartesian product. (Contributed by Peter Mazsa, 29-Dec-2020.)
theorem xrnres4 (A2 R S: class):
  $ wceq (cres (cxrn R S) A2) (cin (cxrn R S) (cxp A2 (cxp (crn (cres R A2)) (crn (cres S A2))))) $;

--| Sufficient condition for a restricted range Cartesian product to be a set. (Contributed by Peter Mazsa, 16-Dec-2020.) (Revised by Peter Mazsa, 7-Sep-2021.)
theorem xrnresex (A2 R S V W X: class):
  $ wi (w3a (wcel A2 V) (wcel R W) (wcel (cres S A2) X)) (wcel (cxrn R (cres S A2)) cvv) $;

--| Sufficient condition for a range Cartesian product with restricted identity to be a set. (Contributed by Peter Mazsa, 31-Dec-2021.)
theorem xrnidresex (A2 R V W: class):
  $ wi (wa (wcel A2 V) (wcel R W)) (wcel (cxrn R (cres cid A2)) cvv) $;

--| Sufficient condition for a range Cartesian product with restricted converse epsilon to be a set. (Contributed by Peter Mazsa, 16-Dec-2020.) (Revised by Peter Mazsa, 23-Sep-2021.)
theorem xrncnvepresex (A2 R V W: class):
  $ wi (wa (wcel A2 V) (wcel R W)) (wcel (cxrn R (cres (ccnv cep) A2)) cvv) $;

--| Domain of the range product with restricted converse epsilon relation. (Contributed by Peter Mazsa, 23-Nov-2025.)
theorem dmxrncnvepres (A2 R: class):
  $ wceq (cdm (cxrn R (cres (ccnv cep) A2))) (cdif (cdm (cres R A2)) (csn c0)) $;

--| Domain of the range product with restricted converse epsilon relation. (Contributed by Peter Mazsa, 29-Jan-2026.)
theorem dmxrncnvepres2 (A2 R: class):
  $ wceq (cdm (cxrn R (cres (ccnv cep) A2))) (cin A2 (cdif (cdm R) (csn c0))) $;

--| Element of the domain of the range product with restricted converse epsilon relation. (Contributed by Peter Mazsa, 23-Nov-2025.)
theorem eldmxrncnvepres (A2 B2 R V: class):
  $ wi (wcel B2 V) (wb (wcel B2 (cdm (cxrn R (cres (ccnv cep) A2)))) (w3a (wcel B2 A2) (wne B2 c0) (wne (cec B2 R) c0))) $;

--| Element of the domain of the range product with restricted converse epsilon relation. This identifies the domain of the ~ pet span ` ( R |X. ( ``' _E |`` A ) ) ` : a ` B ` belongs to the domain of the span exactly when ` B ` is in ` A ` and has at least one ` x e. B ` and ` y ` with ` B R y ` . (Contributed by Peter Mazsa, 23-Nov-2025.)
theorem eldmxrncnvepres2 {x3 y1: setvar} (A2: class x3) (B2: class) (R: class x3) (V: class x3 y1):
  $ wi (wcel B2 V) (wb (wcel B2 (cdm (cxrn R (cres (ccnv cep) A2)))) (w3a (wcel B2 A2) (wex x3 (wcel (cv x3) B2)) (wex y1 (wbr B2 (cv y1) R)))) $;

--| An ` ( R |X. ( ``' _E |`` A ) ) ` -coset in its domain quotient. (Contributed by Peter Mazsa, 23-Nov-2025.)
theorem eceldmqsxrncnvepres (A2 B2 R V W X: class):
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel R X)) (wb (wcel (cec B2 (cxrn R (cres (ccnv cep) A2))) (cqs (cdm (cxrn R (cres (ccnv cep) A2))) (cxrn R (cres (ccnv cep) A2)))) (w3a (wcel B2 A2) (wne B2 c0) (wne (cec B2 R) c0))) $;

--| An ` ( R |X. ( ``' _E |`` A ) ) ` -coset in its domain quotient. In the ~ pet span ` ( R |X. ( ``' _E |`` A ) ) ` , a block [ B ] lies in the domain quotient exactly when its representative ` B ` belongs to ` A ` and actually fires at least one arrow (has some ` x e. B ` and some ` y ` with ` B R y ` ). (Contributed by Peter Mazsa, 23-Nov-2025.)
theorem eceldmqsxrncnvepres2 {x3 y1: setvar} (A2: class x3) (B2: class) (R: class x3) (V W X: class x3 y1):
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel R X)) (wb (wcel (cec B2 (cxrn R (cres (ccnv cep) A2))) (cqs (cdm (cxrn R (cres (ccnv cep) A2))) (cxrn R (cres (ccnv cep) A2)))) (w3a (wcel B2 A2) (wex x3 (wcel (cv x3) B2)) (wex y1 (wbr B2 (cv y1) R)))) $;

--| Binary relation on an intersection is a special case of binary relation on range Cartesian product. (Contributed by Peter Mazsa, 21-Aug-2021.)
theorem brin2 (A2 B2 R S V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wbr A2 B2 (cin R S)) (wbr A2 (cop B2 B2) (cxrn R S))) $;

--| Binary relation on an intersection is a special case of binary relation on range Cartesian product. (Contributed by Peter Mazsa, 21-Aug-2021.) (Avoid depending on this detail.)
theorem brin3 (A2 B2 R S V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wbr A2 B2 (cin R S)) (wbr A2 (csn (csn B2)) (cxrn R S))) $;

--| Define the relations class. Proper class relations (like ` _I ` , see ~ reli ) are not elements of it. The element of this class and the relation predicate are the same when ` R ` is a set (see ~ elrelsrel ). The class of relations is a great tool we can use when we define classes of different relations as nullary class constants as required by the 2. point in our Guidelines ~ https://us.metamath.org/mpeuni/mathbox.html . When we want to define a specific class of relations as a nullary class constant, the appropriate method is the following: 1. We define the specific nullary class constant for general sets (see e.g. ~ df-refs ), then 2. we get the required class of relations by the intersection of the class of general sets above with the class of relations ~ df-rels (see ~ df-refrels and the resulting ~ dfrefrels2 and ~ dfrefrels3 ). 3. Finally, in order to be able to work with proper classes (like ~ iprc ) as well, we define the predicate of the relation (see ~ df-refrel ) so that it is true for the relevant proper classes (see ~ refrelid ), and that the element of the class of the required relations (e.g. ~ elrefrels3 ) and this predicate are the same in case of sets (see ~ elrefrelsrel ). (Contributed by Peter Mazsa, 13-Jun-2018.)
axiom df_rels:
  $ wceq crels (cpw (cxp cvv cvv)) $;

--| The element of the relations class ( ~ df-rels ) and the relation predicate ( ~ df-rel ) are the same when ` R ` is a set. (Contributed by Peter Mazsa, 14-Jun-2018.)
theorem elrels2 (R V: class):
  $ wi (wcel R V) (wb (wcel R crels) (wss R (cxp cvv cvv))) $;

--| The element of the relations class ( ~ df-rels ) and the relation predicate are the same when ` R ` is a set. (Contributed by Peter Mazsa, 24-Nov-2018.)
theorem elrelsrel (R V: class):
  $ wi (wcel R V) (wb (wcel R crels) (wrel R)) $;

--| The element of the relations class is a relation. (Contributed by Peter Mazsa, 20-Jul-2019.)
theorem elrelsrelim (R: class):
  $ wi (wcel R crels) (wrel R) $;

--| Equivalent expressions for an element of the relations class. (Contributed by Peter Mazsa, 21-Jul-2021.)
theorem elrels5 (R V: class):
  $ wi (wcel R V) (wb (wcel R crels) (wceq (cres R (cdm R)) R)) $;

--| Equivalent expressions for an element of the relations class. (Contributed by Peter Mazsa, 21-Jul-2021.)
theorem elrels6 (R V: class):
  $ wi (wcel R V) (wb (wcel R crels) (wceq (cin R (cxp (cdm R) (crn R))) R)) $;

--| Define the quotient map (coset map), see also ~ dfqmap2 and ~ dfqmap3 . ` QMap R ` is the "send a generator / domain element to its ` R ` -coset" map: it maps each ` x e. dom R ` to the block ` [ x ] R ` . Makes the quotient operation ` /. ` structurally explicit as the range of a canonical map (see ~ dfqs2 , ~ rnqmap ). This is crucial for (i) modular "two-layer" characterizations (map layer + carrier layer) such as ~ dfdisjs6 / ~ dfdisjs7 , (ii) transport of properties between a relation and its induced quotient-carrier (e.g. "elements are blocks" via ~ rnqmap ), and (iii) expressing stability/invariance constraints as ordinary conditions on a graph (e.g. ` ran QMap r e. ElDisjs ` , ` QMap r e. Disjs ` ). (Contributed by Peter Mazsa, 12-Feb-2026.)
axiom df_qmap {x3: setvar} (R: class):
  $ wceq (cqmap R) (cmpt x3 (cdm R) (cec (cv x3) R)) $;

--| Alternate definition of the quotient map: ` QMap ` in image-of-singleton form. (Contributed by Peter Mazsa, 14-Feb-2026.)
theorem dfqmap2 {x3: setvar} (R: class):
  $ wceq (cqmap R) (cmpt x3 (cdm R) (cima R (csn (cv x3)))) $;

--| Alternate definition of the quotient map: ` QMap ` as ordered-pair class abstraction. Gives the raw set-builder characterization for extensional proofs, ` Rel ` proofs ( ~ relqmap ), and composition/intersection manipulations. (Contributed by Peter Mazsa, 14-Feb-2026.)
theorem dfqmap3 {x3 y1: setvar} (R: class):
  $ wceq (cqmap R) (copab x3 y1 (wa (wcel (cv x3) (cdm R)) (wceq (cv y1) (cec (cv x3) R)))) $;

--| ` QMap ` fibers are singletons of blocks. Makes ` QMap ` behave like a "block constructor function" on ` dom R ` . (Contributed by Peter Mazsa, 14-Feb-2026.)
theorem ecqmap (A2 R: class):
  $ wi (wcel A2 (cdm R)) (wceq (cec A2 (cqmap R)) (csn (cec A2 R))) $;

--| Fiber of ` QMap ` equals singleton quotient: a conceptual bridge between "map fibers" and quotients. (Contributed by Peter Mazsa, 19-Feb-2026.)
theorem ecqmap2 (A2 R: class):
  $ wi (wcel A2 (cdm R)) (wceq (cec A2 (cqmap R)) (cqs (csn A2) R)) $;

--| Quotient map exists if ` R ` exists. Type-safety: ensures ` QMap ` is a set under the standard "relation sethood" hypothesis. (Contributed by Peter Mazsa, 12-Feb-2026.)
theorem qmapex (R V: class):
  $ wi (wcel R V) (wcel (cqmap R) cvv) $;

--| Quotient map is a relation. Guarantees that ` QMap ` can be composed, restricted, and used in other relation infrastructure (e.g., membership in ` Disjs ` , ` Rels ` -based typing). (Contributed by Peter Mazsa, 12-Feb-2026.)
theorem relqmap (R: class):
  $ wrel (cqmap R) $;

--| ` QMap ` preserves the domain. Confirms that ` QMap ` is defined exactly on the points where cosets ` [ x ] R ` make sense (those in ` dom R ` ). (Contributed by Peter Mazsa, 14-Feb-2026.)
theorem dmqmap (R V: class):
  $ wi (wcel R V) (wceq (cdm (cqmap R)) (cdm R)) $;

--| The range of the quotient map is the quotient carrier. It lets us replace quotient-carrier reasoning by map/range reasoning (and conversely) via ~ df-qmap and ~ dfqs2 . (Contributed by Peter Mazsa, 12-Feb-2026.)
theorem rnqmap (R: class):
  $ wceq (crn (cqmap R)) (cqs (cdm R) R) $;

--| Define the adjoined lift map. Given a relation ` R ` and a carrier/set ` A ` , we form the adjoined relation ` ( R u. ``' _E ) ` (i.e., "follow ` R ` or follow elements"), restricted to ` A ` , and map each domain element ` m ` to its coset ` [ m ] ` under that restricted adjoined relation, see its expanded version ~ dfadjliftmap . Thus, for ` m ` in its domain, we have ` ( m u. [ m ] R ) ` , see ~ dfadjliftmap2 . Its key special case is successor: for ` R = _I ` and ` A = dom _I ` , or ` A = _V ` , the adjoined relation is ` ( _I u. ``' _E ) ` , and the coset becomes ` [ m ] ( _I u. ``' _E ) = ( m u. { m } ) ` . So ` ( _I AdjLiftMap dom _I ) ` or ` ( _I AdjLiftMap _V ) ` (see ~ dfsucmap2 and ~ dfsucmap3 ) are exactly the successor map ` m |-> suc m ` (cf. ~ dfsucmap4 ), which is a prerequisite for accepting the adjoining lift as the right generalization of successor. A maximally generic form would be "( R F LiftMap A )" defined as ` ( m e. dom ( ( R F ``' _E ) |`` A ) |-> ` ` [ m ] ( ( R F ``' _E ) |`` A ) ) ` where ` F ` is an object-level binary operator on relations (used via ~ df-ov ). However, ` u. ` and ` |X. ` are introduced in set.mm as class constructors (e.g. ~ df-un ), not as an object-level binary function symbol ` F ` that can be passed as a parameter. To make the generic ` F ` -pattern literally usable, we would need to reify union and ` |X. ` as function-objects, which is additional infrastructure. To avoid introducing operator-as-function objects solely to support ` F ` , we define: ` AdjLiftMap ` directly using ~ df-un , and ` BlockLiftMap ` directly using the existing ` |X. ` constructor ~ dfxrn2 , so we treat any "generic ` F ` -LiftMap" as optional future generalization, not a dependency. We prefer to avoid defining too many concepts. For this reason, we will not introduce a named "adjoining relation", a named carrier "adjoining lift" "( R AdjLift A )", in place of ` ran ( R AdjLiftMap A ) ` , which is ` ( dom ( ( R u. ``' _E ) |`` A ) /. ( ( R u. ``' _E ) |`` A ) ) ` , cf. ~ dfqs2 , or the equilibrium condition "AdjLiftFix" , in place of ` { <. r , a >. | ` ` ( dom ( ( R u. ``' _E ) |`` A ) /. ( ( R u. ``' _E ) |`` A ) ) = a } ` (cf. its analog ~ df-blockliftfix ). These are definable by simple expansions and/or domain-quotient theorems when needed. A "two-stage" construction is obtained by first forming the block relation ` ( R |X. ``' _E ) ` and then adjoining elements as "BlockAdj" . Combined, it uses the relation ` ( ( R |X. ``' _E ) u. ``' _E ) ` , which for ` m ` in its domain ` ( A \ { (/) } ) ` gives ` ( m u. [ m ] ( R |X. ``' _E ) ) ` , yielding "BlockAdjLiftMap" (cf. ~ blockadjliftmap ) and "BlockAdjLiftFix". We only introduce these if a downstream theorem actually requires them. (Contributed by Peter Mazsa, 24-Jan-2026.) (Revised by Peter Mazsa, 22-Feb-2026.)
axiom df_adjliftmap (A2 R: class):
  $ wceq (cadjliftmap A2 R) (cqmap (cres (cun R (ccnv cep)) A2)) $;

--| Alternate (expanded) definition of the adjoined lift map. (Contributed by Peter Mazsa, 28-Jan-2026.) (Revised by Peter Mazsa, 22-Feb-2026.)
theorem dfadjliftmap {m: setvar} (A2 R: class):
  $ wceq (cadjliftmap A2 R) (cmpt m (cdm (cres (cun R (ccnv cep)) A2)) (cec (cv m) (cres (cun R (ccnv cep)) A2))) $;

--| Alternate definition of the adjoined lift map. (Contributed by Peter Mazsa, 28-Jan-2026.)
theorem dfadjliftmap2 {m: setvar} (A2 R: class):
  $ wceq (cadjliftmap A2 R) (cmpt m (cin A2 (cun (cdm R) (cdif cvv (csn c0)))) (cun (cv m) (cec (cv m) R))) $;

--| A "two-stage" construction is obtained by first forming the block relation ` ( R |X. ``' _E ) ` and then adjoining elements as "BlockAdj". Combined, it uses the relation ` ( ( R |X. ``' _E ) u. ``' _E ) ` . (Contributed by Peter Mazsa, 28-Jan-2026.)
theorem blockadjliftmap {m n: setvar} (A2 R: class):
  $ wceq (cadjliftmap A2 (cxrn R (ccnv cep))) (copab m n (wa (wcel (cv m) (cdif A2 (csn c0))) (wceq (cv n) (cun (cv m) (cxp (cec (cv m) R) (cv m)))))) $;

--| Define the block lift map. Given a relation ` R ` and a carrier/set ` A ` , we form the block relation ` ( R |X. ``' _E ) ` (i.e., "follow both ` R ` and element"), restricted to ` A ` (or, equivalently, "follow both ` R ` and elements-of-A", cf. ~ xrnres2 ). Then map each domain element ` m ` to its coset ` [ m ] ` under that restricted block relation. For ` m ` in the domain, which requires ` ( m e. A /\ m =/= (/) /\ [ m ] R =/= (/) ) ` (cf. ~ eldmxrncnvepres ), the fiber has the product form ` [ m ] ( R |X. ``' _E ) = ( [ m ] R X. m ) ` , so the block relation lifts a block ` m ` to the rectangular grid "external labels ` X. ` internal members", see ~ dfblockliftmap2 . Contrast: while the adjoined lift, via ` ( R u. ``' _E ) ` , attaches neighbors and members in a single relation (see ~ dfadjliftmap2 ), the block lift labels each internal member by each external neighbor. For the general case and a two-stage construction (first block lift, then adjoin membership), see the comments to ~ df-adjliftmap . For the equilibrium condition, see ~ df-blockliftfix . (Contributed by Peter Mazsa, 24-Jan-2026.) (Revised by Peter Mazsa, 22-Feb-2026.)
axiom df_blockliftmap (A2 R: class):
  $ wceq (cblockliftmap A2 R) (cqmap (cxrn R (cres (ccnv cep) A2))) $;

--| Alternate definition of the block lift map. (Contributed by Peter Mazsa, 29-Jan-2026.) (Revised by Peter Mazsa, 22-Feb-2026.)
theorem dfblockliftmap {m: setvar} (A2 R: class):
  $ wceq (cblockliftmap A2 R) (cmpt m (cdm (cxrn R (cres (ccnv cep) A2))) (cec (cv m) (cxrn R (cres (ccnv cep) A2)))) $;

--| Alternate definition of the block lift map. (Contributed by Peter Mazsa, 29-Jan-2026.)
theorem dfblockliftmap2 {m: setvar} (A2 R: class):
  $ wceq (cblockliftmap A2 R) (cmpt m (cin A2 (cdif (cdm R) (csn c0))) (cxp (cec (cv m) R) (cv m))) $;

--| Define the successor map, directly as the graph of the successor operation, using only elementary set theory (ordered-pair class abstraction). This avoids committing to any particular construction of the successor function/class from other operators (e.g. a union/composition presentation), while remaining provably equivalent to those presentations (cf. ~ dfsucmap2 and ~ dfsucmap3 vs. ~ df-succf and ~ dfsuccf2 ). For maximum mappy shape, see ~ dfsucmap4 . We also treat the successor relation as the default shift relation for grading/tower arguments (cf. ~ df-shiftstable ). Because it is used pervasively in shift-lift infrastructure, we adopt the short name SucMap rather than the fully systematic "SucAdjLiftMap". You may also define the predecessor relation as the converse graph "PreMap" as ` ``' SucMap ` , which reverses successor edges ( cf. ~ cnvopab ) and sends each successor to its (unique) predecessor when it exists. (Contributed by Peter Mazsa, 25-Jan-2026.)
axiom df_sucmap {m n: setvar}:
  $ wceq csucmap (copab m n (wceq (csuc (cv m)) (cv n))) $;

--| Alternate definition of the successor map. (Contributed by Peter Mazsa, 28-Jan-2026.)
theorem dfsucmap3:
  $ wceq csucmap (cadjliftmap cvv cid) $;

--| Alternate definition of the successor map. (Contributed by Peter Mazsa, 28-Jan-2026.)
theorem dfsucmap2:
  $ wceq csucmap (cadjliftmap (cdm cid) cid) $;

--| Alternate definition of the successor map. (Contributed by Peter Mazsa, 28-Jan-2026.)
theorem dfsucmap4 {m: setvar}:
  $ wceq csucmap (cmpt m cvv (csuc (cv m))) $;

--| Binary relation form of the successor map, general version. (Contributed by Peter Mazsa, 6-Jan-2026.)
theorem brsucmap (M N V W: class):
  $ wi (wa (wcel M V) (wcel N W)) (wb (wbr M N csucmap) (wceq (csuc M) N)) $;

--| The successor map is a relation. (Contributed by Peter Mazsa, 7-Jan-2026.)
theorem relsucmap:
  $ wrel csucmap $;

--| The domain of the successor map is the universe. (Contributed by Peter Mazsa, 7-Jan-2026.)
theorem dmsucmap:
  $ wceq (cdm csucmap) cvv $;

--| Define ` Suc ` as the class of all successors, i.e. the range of the successor map: ` n e. Suc ` iff ` E. m suc m = n ` (see ~ dfsuccl2 ). By injectivity of ` suc ` ( ~ suc11reg ), every ` n e. Suc ` has at most one predecessor, which is exactly what ` pre n ` ( ~ df-pre ) names. Cf. ~ dfsuccl3 and ~ dfsuccl4 . (Contributed by Peter Mazsa, 25-Jan-2026.)
axiom df_succl:
  $ wceq csuccl (crn csucmap) $;

--| Alternate definition of the class of all successors. (Contributed by Peter Mazsa, 29-Jan-2026.)
theorem dfsuccl2 {m n: setvar}:
  $ wceq csuccl (cab n (wex m (wceq (csuc (cv m)) (cv n)))) $;

--| There is at most one predecessor of ` N ` . (Contributed by Peter Mazsa, 12-Jan-2026.)
theorem mopre {m: setvar} (N: class):
  $ wmo m (wceq (csuc (cv m)) N) $;

--| Whenever a predecessor exists, it exists alone. (Contributed by Peter Mazsa, 12-Jan-2026.)
theorem exeupre2 {m: setvar} (N: class):
  $ wb (wex m (wceq (csuc (cv m)) N)) (weu m (wceq (csuc (cv m)) N)) $;

--| Alternate definition of the class of all successors. (Contributed by Peter Mazsa, 30-Jan-2026.)
theorem dfsuccl3 {m n: setvar}:
  $ wceq csuccl (cab n (weu m (wceq (csuc (cv m)) (cv n)))) $;

--| Alternate definition that incorporates the most desirable properties of the successor class. (Contributed by Peter Mazsa, 30-Jan-2026.)
theorem dfsuccl4 {m n: setvar}:
  $ wceq csuccl (cab n (wreu m (wa (wss (cv m) (cv n)) (wceq (csuc (cv m)) (cv n))) (cv n))) $;

--| Define the term-level successor-predecessor. It is the unique ` m ` with ` suc m = N ` when such an ` m ` exists; otherwise ` pre N ` is the arbitrary default chosen by ` iota ` . See its alternate definitions ~ dfpre , ~ dfpre2 , ~ dfpre3 and ~ dfpre4 . Our definition is a special case of the widely recognised general ` R ` -predecessor class ~ df-pred (the class of all elements ` m ` of ` A ` such that ` m R N ` , ~ dfpred3g , cf. also ~ df-bnj14 ) in several respects. Its most abstract property as a specialisation is that it has a unique existing value by default. This is in contrast to the general version. The uniqueness (conditional on existence) is implied by the property of this specific instance of the general case involving the successor map ~ df-sucmap in place of ` R ` , so that ` m SucMap N ` , cf. ~ sucmapleftuniq , which originates from ~ suc11reg . Existence ` E. m m SucMap N ` holds exactly on ` N e. ran SucMap ` , cf. ~ elrng . Note that ` dom SucMap = _V ` (see ~ dmsucmap ), so the equivalent definition ~ dfpre uses ` ( iota m m e. Pred ( SucMap , _V , N ) ) ` . (Contributed by Peter Mazsa, 27-Jan-2026.)
axiom df_pre {m: setvar} (N: class):
  $ wceq (cpre N) (cio m (wcel (cv m) (cpred (cdm csucmap) csucmap N))) $;

--| Alternate definition of the successor-predecessor. (Contributed by Peter Mazsa, 27-Jan-2026.)
theorem dfpre {m: setvar} (N: class):
  $ wceq (cpre N) (cio m (wcel (cv m) (cpred cvv csucmap N))) $;

--| Alternate definition of the successor-predecessor. (Contributed by Peter Mazsa, 12-Jan-2026.)
theorem dfpre2 {m: setvar} (N V: class):
  $ wi (wcel N V) (wceq (cpre N) (cio m (wbr (cv m) N csucmap))) $;

--| Alternate definition of the successor-predecessor. (Contributed by Peter Mazsa, 12-Jan-2026.)
theorem dfpre3 {m: setvar} (N V: class):
  $ wi (wcel N V) (wceq (cpre N) (cio m (wceq (csuc (cv m)) N))) $;

--| Alternate definition of the predecessor class when ` N ` is a set. (Contributed by Peter Mazsa, 26-Jan-2026.)
theorem dfpred4 (A2 R N V: class):
  $ wi (wcel N V) (wceq (cpred A2 R N) (cec N (ccnv (cres R A2)))) $;

--| Alternate definition of the predecessor of the ` N ` set. The ` ``' SucMap ` is just the "PreMap"; we did not define it because we do not expect to use it extensively in future (cf. the comments of ~ df-sucmap ). (Contributed by Peter Mazsa, 26-Jan-2026.)
theorem dfpre4 {m: setvar} (N V: class):
  $ wi (wcel N V) (wceq (cpre N) (cio m (wcel (cv m) (cec N (ccnv csucmap))))) $;

--| Define the equilibrium / fixed-point condition for "block carriers". Start with a candidate block-family ` a ` (a set whose elements you intend to treat as blocks). Combine it with a relation ` r ` by forming the block-lift span ` T = ( r |X. ( ``' _E |`` a ) ) ` . For a block ` u e. a ` , the fiber ` [ u ] T ` is the set of all outputs produced from "external targets" of ` r ` together with "internal members" of ` u ` ; in other words, ` T ` is the mechanism that generates new blocks from old ones. Now apply the standard quotient construction ` ( dom T /. T ) ` . This produces the family of all T-blocks (the cosets ` [ x ] T ` of witnesses ` x ` in the domain of ` T ` ). In general, this operation can change your carrier: starting from ` a ` , it may generate a different block-family ` ( dom T /. T ) ` . The equation ` ( dom ( r |X. ( ``' _E |`` a ) ) /. ( r |X. ( ``' _E |`` a ) ) ) = a ` says exactly: if you generate blocks from ` a ` using the lift determined by ` r ` (cf. ~ df-blockliftmap ), you get back the same ` a ` . So ` a ` is stable under the block-generation operator induced by ` r ` . This is why it is a genuine fixpoint/equilibrium condition: one application of the "make-the-blocks" operator causes no carrier drift, i.e. no hidden refinement/coarsening of what counts as a block. Here, the quotient ` ( dom T /. T ) ` is the standard carrier of ` T ` -blocks; see ~ dfqs2 for the quotient-as-range viewpoint. This is an untyped equilibrium predicate on pairs ` <. r , a >. ` . No hypothesis ` r e. Rels ` is built into the definition, because the fixpoint equation depends only on those ordered pairs ` <. x , y >. ` that belong to ` r ` and hence can witness an atomic instance ` x r y ` ; extra non-ordered-pair "junk" elements in ` r ` are ignored automatically by the relational membership predicate. When later work needs ` r ` to be relation-typed (e.g. to intersect with ` ( Rels X. _V ) ` -style typedness modules, or to apply ` Rels ` -based infrastructure uniformly), the additional typing constraint ` r e. Rels ` should be imposed locally as a separate conjunct (rather than being baked into this equilibrium module). (Contributed by Peter Mazsa, 25-Jan-2026.) (Revised by Peter Mazsa, 20-Feb-2026.)
axiom df_blockliftfix {r a: setvar}:
  $ wceq cblockliftfix (copab r a (wceq (cqs (cdm (cxrn (cv r) (cres (ccnv cep) (cv a)))) (cxrn (cv r) (cres (ccnv cep) (cv a)))) (cv a))) $;

--| Define shift-stability, a general "procedure" pattern for "the one-step backward shift/transport of ` F ` along ` S ` ", and then ` i^i F ` enforces "and it already holds here". Let ` F ` be a relation encoding a property that depends on a "level" coordinate (for example, a feasibility condition indexed by a carrier, a grade, or a stage in a construction). Let ` S ` be a shift relation between levels (for example, the successor map ` SucMap ` , or any other grading step). The composed relation ` ( S o. F ) ` transports ` F ` one step along the shift: ` r ( S o. F ) n ` means there exists a predecessor level ` m ` such that ` r F m ` and ` m S n ` (e.g., ` m SucMap n ` ). We do not introduce a separate notation for "Shift" because it is simply the standard relational composition ~ df-co . The intersection ` ( ( S o. F ) i^i F ) ` is the locally shift-stable fragment of ` F ` : it consists exactly of those points where the property holds at some immediate predecessor that shifts to ` n ` and also holds at level ` n ` . In other words, it isolates the part of ` F ` that is already compatible with one-step tower coherence. This definition packages a common construction pattern used throughout the development: "constrain by one-step stability under a chosen shift, then additionally constrain by ` F ` ". Iterating the operator ` ( X |-> ( ( S o. X ) i^i X ) ` corresponds to multi-step/tower coherence; the one-step definition here is the economical kernel from which such "tower" readings can be developed when needed. (Contributed by Peter Mazsa, 25-Jan-2026.)
axiom df_shiftstable (S F: class):
  $ wceq (cshiftstable S F) (cin (ccom S F) F) $;

--| Equality theorem for shift-stability of two classes. (Contributed by Peter Mazsa, 19-Feb-2026.)
theorem shiftstableeq2 (S F G: class):
  $ wi (wceq F G) (wceq (cshiftstable S F) (cshiftstable S G)) $;

--| One-to-one relationship between the successor operation and the singleton. (Contributed by Peter Mazsa, 31-Dec-2024.)
theorem suceqsneq (A2 B2 V: class):
  $ wi (wcel A2 V) (wb (wceq (csuc A2) (csuc B2)) (wceq (csn A2) (csn B2))) $;

--| Absorption of union with a singleton by difference. (Contributed by Peter Mazsa, 24-Jul-2024.)
theorem sucdifsn2 (A2: class):
  $ wceq (cdif (cun A2 (csn A2)) (csn A2)) A2 $;

--| The difference between the successor and the singleton of a class is the class. (Contributed by Peter Mazsa, 20-Sep-2024.)
theorem sucdifsn (A2: class):
  $ wceq (cdif (csuc A2) (csn A2)) A2 $;

--| The difference between restrictions to the successor and the singleton of a class is the restriction to the class, see ~ ressucdifsn . (Contributed by Peter Mazsa, 24-Jul-2024.)
theorem ressucdifsn2 (A2 R: class):
  $ wceq (cdif (cres R (cun A2 (csn A2))) (cres R (csn A2))) (cres R A2) $;

--| The difference between restrictions to the successor and the singleton of a class is the restriction to the class. (Contributed by Peter Mazsa, 20-Sep-2024.)
theorem ressucdifsn (A2 R: class):
  $ wceq (cdif (cres R (csuc A2)) (cres R (csn A2))) (cres R A2) $;

--| A set is succeeded by its successor. (Contributed by Peter Mazsa, 7-Jan-2026.)
theorem sucmapsuc (M V: class):
  $ wi (wcel M V) (wbr M (csuc M) csucmap) $;

--| Left uniqueness of the successor mapping. (Contributed by Peter Mazsa, 8-Jan-2026.)
theorem sucmapleftuniq (L M N V W X: class):
  $ wi (w3a (wcel L V) (wcel M W) (wcel N X)) (wi (wa (wbr L N csucmap) (wbr M N csucmap)) (wceq L M)) $;

--| Whenever a predecessor exists, it exists alone. (Contributed by Peter Mazsa, 12-Jan-2026.)
theorem exeupre {m: setvar} (N V: class):
  $ wi (wcel N V) (wb (wex m (wbr (cv m) N csucmap)) (weu m (wbr (cv m) N csucmap))) $;

--| The successor-predecessor exists. (Contributed by Peter Mazsa, 12-Jan-2026.)
theorem preex (N: class):
  $ wcel (cpre N) cvv $;

--| Unique predecessor exists on the range of the successor map. (Contributed by Peter Mazsa, 12-Jan-2026.)
theorem eupre2 {m: setvar} (N V: class):
  $ wi (wcel N V) (wb (wcel N (crn csucmap)) (weu m (wbr (cv m) N csucmap))) $;

--| Unique predecessor exists on the successor class. (Contributed by Peter Mazsa, 27-Jan-2026.)
theorem eupre {m: setvar} (N V: class):
  $ wi (wcel N V) (wb (wcel N csuccl) (weu m (wbr (cv m) N csucmap))) $;

--| ` pre ` is really a predecessor (when it should be). This correctness theorem for ` pre ` makes it usable in proofs without unfolding ` iota ` . This theorem gives one witness; ~ preuniqval gives it is the only one. (Contributed by Peter Mazsa, 12-Jan-2026.)
theorem presucmap (N: class):
  $ wi (wcel N (crn csucmap)) (wbr (cpre N) N csucmap) $;

--| Uniqueness/canonicity of ` pre ` . ~ presucmap gives one witness; this theorem gives it is the only one. It turns any predecessor proof into an equality with ` pre N ` . (Contributed by Peter Mazsa, 12-Jan-2026.)
theorem preuniqval {m: setvar} (N: class):
  $ wi (wcel N (crn csucmap)) (wal m (wi (wbr (cv m) N csucmap) (wceq (cv m) (cpre N)))) $;

--| ` suc ` is a right-inverse of ` pre ` on ` Suc ` . This theorem states the partial inverse relation in the direction we most often need. (Contributed by Peter Mazsa, 27-Jan-2026.)
theorem sucpre (N: class):
  $ wi (wcel N csuccl) (wceq (csuc (cpre N)) N) $;

--| ` pre ` is a left-inverse of ` suc ` . This theorem gives a clean rewrite rule that eliminates ` pre ` on explicit successors. (Contributed by Peter Mazsa, 12-Jan-2026.)
theorem presuc (M V: class):
  $ wi (wcel M V) (wceq (cpre (csuc M)) M) $;

--| Predecessor is a subset of its successor. (Contributed by Peter Mazsa, 12-Jan-2026.)
theorem press (N: class):
  $ wi (wcel N csuccl) (wss (cpre N) N) $;

--| Predecessor is a subset of its successor. (Contributed by Peter Mazsa, 12-Jan-2026.)
theorem preel (N: class):
  $ wi (wcel N csuccl) (wcel (cpre N) N) $;

--| Define the class of cosets by ` R ` : ` x ` and ` y ` are cosets by ` R ` iff there exists a set ` u ` such that both ` u R x ` and ` u R y ` hold, i.e., both ` x ` and ` y ` are are elements of the ` R ` -coset of ` u ` (see ~ dfcoss2 and the comment of ~ dfec2 ). ` R ` is usually a relation. This concept simplifies theorems relating partition and equivalence: the left side of these theorems relate to ` R ` , the right side relate to ` ,~ R ` (see e.g. ~ pet ). Without the definition of ` ,~ R ` we should have to relate the right side of these theorems to a composition of a converse (cf. ~ dfcoss3 ) or to the range of a range Cartesian product of classes (cf. ~ dfcoss4 ), which would make the theorems complicated and confusing. Alternate definition is ~ dfcoss2 . Technically, we can define it via composition ( ~ dfcoss3 ) or as the range of a range Cartesian product ( ~ dfcoss4 ), but neither of these definitions reveal directly how the cosets by ` R ` relate to each other. We define functions ( ~ df-funsALTV , ~ df-funALTV ) and disjoints ( ~ dfdisjs , ~ dfdisjs2 , ~ df-disjALTV , ~ dfdisjALTV2 ) with the help of it as well. (Contributed by Peter Mazsa, 9-Jan-2018.)
axiom df_coss {x3 y1 u: setvar} (R: class):
  $ wceq (ccoss R) (copab x3 y1 (wex u (wa (wbr (cv u) (cv x3) R) (wbr (cv u) (cv y1) R)))) $;

--| Define the class of coelements on the class ` A ` , see also the alternate definition ~ dfcoels . Possible definitions are the special cases of ~ dfcoss3 and ~ dfcoss4 . (Contributed by Peter Mazsa, 20-Nov-2019.)
axiom df_coels (A2: class):
  $ wceq (ccoels A2) (ccoss (cres (ccnv cep) A2)) $;

--| Alternate definition of the class of cosets by ` R ` : ` x ` and ` y ` are cosets by ` R ` iff there exists a set ` u ` such that both ` x ` and ` y ` are are elements of the ` R ` -coset of ` u ` (see also the comment of ~ dfec2 ). ` R ` is usually a relation. (Contributed by Peter Mazsa, 16-Jan-2018.)
theorem dfcoss2 {x3 y1 u: setvar} (R: class):
  $ wceq (ccoss R) (copab x3 y1 (wex u (wa (wcel (cv x3) (cec (cv u) R)) (wcel (cv y1) (cec (cv u) R))))) $;

--| Alternate definition of the class of cosets by ` R ` (see the comment of ~ df-coss ). (Contributed by Peter Mazsa, 27-Dec-2018.)
theorem dfcoss3 (R: class):
  $ wceq (ccoss R) (ccom R (ccnv R)) $;

--| Alternate definition of the class of cosets by ` R ` (see the comment of ~ df-coss ). (Contributed by Peter Mazsa, 12-Jul-2021.)
theorem dfcoss4 (R: class):
  $ wceq (ccoss R) (crn (cxrn R R)) $;

--| Class of cosets by the converse of ` R ` . (Contributed by Peter Mazsa, 17-Jun-2020.)
theorem cosscnv {x3 y1 u: setvar} (R: class):
  $ wceq (ccoss (ccnv R)) (copab x3 y1 (wex u (wa (wbr (cv x3) (cv u) R) (wbr (cv y1) (cv u) R)))) $;

--| Class of cosets by the converse of a restriction. (Contributed by Peter Mazsa, 8-Jun-2020.)
theorem coss1cnvres {x3 v u: setvar} (A2 R: class):
  $ wceq (ccoss (ccnv (cres R A2))) (copab u v (wa (wa (wcel (cv u) A2) (wcel (cv v) A2)) (wex x3 (wa (wbr (cv u) (cv x3) R) (wbr (cv v) (cv x3) R))))) $;

--| Special case of ~ coss1cnvres . (Contributed by Peter Mazsa, 8-Jun-2020.)
theorem coss2cnvepres {x3 v u: setvar} (A2: class):
  $ wceq (ccoss (ccnv (cres (ccnv cep) A2))) (copab u v (wa (wa (wcel (cv u) A2) (wcel (cv v) A2)) (wex x3 (wa (wcel (cv x3) (cv u)) (wcel (cv x3) (cv v)))))) $;

--| If ` A ` is a set then the class of cosets by ` A ` is a set. (Contributed by Peter Mazsa, 4-Jan-2019.)
theorem cossex (A2 V: class):
  $ wi (wcel A2 V) (wcel (ccoss A2) cvv) $;

--| If ` A ` is a set then the class of cosets by the converse of ` A ` is a set. (Contributed by Peter Mazsa, 18-Oct-2019.)
theorem cosscnvex (A2 V: class):
  $ wi (wcel A2 V) (wcel (ccoss (ccnv A2)) cvv) $;

--| Sufficient condition for a restricted converse epsilon coset to be a set. (Contributed by Peter Mazsa, 24-Sep-2021.)
theorem _1cosscnvepresex (A2 V: class):
  $ wi (wcel A2 V) (wcel (ccoss (cres (ccnv cep) A2)) cvv) $;

--| Sufficient condition for a restricted converse epsilon range Cartesian product to be a set. (Contributed by Peter Mazsa, 23-Sep-2021.)
theorem _1cossxrncnvepresex (A2 R V W: class):
  $ wi (wa (wcel A2 V) (wcel R W)) (wcel (ccoss (cxrn R (cres (ccnv cep) A2))) cvv) $;

--| Cosets by ` R ` is a relation. (Contributed by Peter Mazsa, 27-Dec-2018.)
theorem relcoss (R: class):
  $ wrel (ccoss R) $;

--| Coelements on ` A ` is a relation. (Contributed by Peter Mazsa, 5-Oct-2021.)
theorem relcoels (A2: class):
  $ wrel (ccoels A2) $;

--| Subclass theorem for the classes of cosets by ` A ` and ` B ` . (Contributed by Peter Mazsa, 11-Nov-2019.)
theorem cossss (A2 B2: class):
  $ wi (wss A2 B2) (wss (ccoss A2) (ccoss B2)) $;

--| Equality theorem for the classes of cosets by ` A ` and ` B ` . (Contributed by Peter Mazsa, 9-Jan-2018.)
theorem cosseq (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (ccoss A2) (ccoss B2)) $;

--| Equality theorem for the classes of cosets by ` A ` and ` B ` , inference form. (Contributed by Peter Mazsa, 9-Jan-2018.)
theorem cosseqi (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wceq (ccoss A2) (ccoss B2) $;

--| Equality theorem for the classes of cosets by ` A ` and ` B ` , deduction form. (Contributed by Peter Mazsa, 4-Nov-2019.)
theorem cosseqd (ph: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (ccoss A2) (ccoss B2)) $;

--| The class of cosets by a restriction. (Contributed by Peter Mazsa, 20-Apr-2019.)
theorem _1cossres {x3 y1 u: setvar} (A2 R: class):
  $ wceq (ccoss (cres R A2)) (copab x3 y1 (wrex u (wa (wbr (cv u) (cv x3) R) (wbr (cv u) (cv y1) R)) A2)) $;

--| Alternate definition of the class of coelements on the class ` A ` . (Contributed by Peter Mazsa, 20-Apr-2019.)
theorem dfcoels {x3 y1 u: setvar} (A2: class):
  $ wceq (ccoels A2) (copab x3 y1 (wrex u (wa (wcel (cv x3) (cv u)) (wcel (cv y1) (cv u))) A2)) $;

--| ` A ` and ` B ` are cosets by ` R ` : a binary relation. (Contributed by Peter Mazsa, 27-Dec-2018.)
theorem brcoss {u: setvar} (A2 B2 R V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wbr A2 B2 (ccoss R)) (wex u (wa (wbr (cv u) A2 R) (wbr (cv u) B2 R)))) $;

--| Alternate form of the ` A ` and ` B ` are cosets by ` R ` binary relation. (Contributed by Peter Mazsa, 26-Mar-2019.)
theorem brcoss2 {u: setvar} (A2 B2 R V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wbr A2 B2 (ccoss R)) (wex u (wa (wcel A2 (cec (cv u) R)) (wcel B2 (cec (cv u) R))))) $;

--| Alternate form of the ` A ` and ` B ` are cosets by ` R ` binary relation. (Contributed by Peter Mazsa, 26-Mar-2019.)
theorem brcoss3 (A2 B2 R V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wbr A2 B2 (ccoss R)) (wne (cin (cec A2 (ccnv R)) (cec B2 (ccnv R))) c0)) $;

--| For sets, the ` A ` and ` B ` cosets by ` R ` binary relation and the ` B ` and ` A ` cosets by ` R ` binary relation are the same. (Contributed by Peter Mazsa, 27-Dec-2018.)
theorem brcosscnvcoss (A2 B2 R V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wbr A2 B2 (ccoss R)) (wbr B2 A2 (ccoss R))) $;

--| ` B ` and ` C ` are coelements : a binary relation. (Contributed by Peter Mazsa, 14-Jan-2020.) (Revised by Peter Mazsa, 5-Oct-2021.)
theorem brcoels {u: setvar} (A2 B2 C: class) (V W: class u):
  $ wi (wa (wcel B2 V) (wcel C W)) (wb (wbr B2 C (ccoels A2)) (wrex u (wa (wcel B2 (cv u)) (wcel C (cv u))) A2)) $;

--| Two ways of saying that cosets by cosets by ` R ` is a subclass. (Contributed by Peter Mazsa, 17-Sep-2021.)
theorem cocossss {x3 y1 z: setvar} (R S: class):
  $ wb (wss (ccoss (ccoss R)) S) (wal x3 (wal y1 (wal z (wi (wa (wbr (cv x3) (cv y1) (ccoss R)) (wbr (cv y1) (cv z) (ccoss R))) (wbr (cv x3) (cv z) S))))) $;

--| The converse of cosets by ` R ` are cosets by ` R ` . (Contributed by Peter Mazsa, 3-May-2019.)
theorem cnvcosseq (R: class):
  $ wceq (ccnv (ccoss R)) (ccoss R) $;

--| Cosets by ` ,~ R ` binary relation. (Contributed by Peter Mazsa, 25-Aug-2019.)
theorem br2coss (A2 B2 R V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wbr A2 B2 (ccoss (ccoss R))) (wne (cin (cec A2 (ccoss R)) (cec B2 (ccoss R))) c0)) $;

--| ` B ` and ` C ` are cosets by a restriction: a binary relation. (Contributed by Peter Mazsa, 30-Dec-2018.)
theorem br1cossres {u: setvar} (A2 B2 C R V W: class):
  $ wi (wa (wcel B2 V) (wcel C W)) (wb (wbr B2 C (ccoss (cres R A2))) (wrex u (wa (wbr (cv u) B2 R) (wbr (cv u) C R)) A2)) $;

--| ` B ` and ` C ` are cosets by a restriction: a binary relation. (Contributed by Peter Mazsa, 3-Jan-2018.)
theorem br1cossres2 {x3: setvar} (A2 B2 C R V W: class):
  $ wi (wa (wcel B2 V) (wcel C W)) (wb (wbr B2 C (ccoss (cres R A2))) (wrex x3 (wa (wcel B2 (cec (cv x3) R)) (wcel C (cec (cv x3) R))) A2)) $;

--| Binary relation on a restriction to a singleton. (Contributed by Peter Mazsa, 11-Jun-2024.)
theorem brressn (A2 B2 C R V W: class):
  $ wi (wa (wcel B2 V) (wcel C W)) (wb (wbr B2 C (cres R (csn A2))) (wa (wceq B2 A2) (wbr B2 C R))) $;

--| A class ' R ' restricted to the singleton of the class ' A ' is the ordered pair class abstraction of the class ' A ' and the sets in relation ' R ' to ' A ' (and not in relation to the singleton ' { A } ' ). (Contributed by Peter Mazsa, 16-Jun-2024.)
theorem ressn2 {u a: setvar} (A2 R: class):
  $ wceq (cres R (csn A2)) (copab a u (wa (wceq (cv a) A2) (wbr A2 (cv u) R))) $;

--| Any class ' R ' restricted to the singleton of the set ' A ' (see ~ ressn2 ) is reflexive, see also ~ refrelressn . (Contributed by Peter Mazsa, 12-Jun-2024.)
theorem refressn {x3: setvar} (A2: class) (R: class x3) (V: class):
  $ wi (wcel A2 V) (wral x3 (wbr (cv x3) (cv x3) (cres R (csn A2))) (cin (cdm (cres R (csn A2))) (crn (cres R (csn A2))))) $;

--| Every class ' R ' restricted to the singleton of the class ' A ' (see ~ ressn2 ) is antisymmetric. (Contributed by Peter Mazsa, 11-Jun-2024.)
theorem antisymressn {x3 y1: setvar} (A2 R: class x3 y1):
  $ wal x3 (wal y1 (wi (wa (wbr (cv x3) (cv y1) (cres R (csn A2))) (wbr (cv y1) (cv x3) (cres R (csn A2)))) (wceq (cv x3) (cv y1)))) $;

--| Any class ' R ' restricted to the singleton of the class ' A ' (see ~ ressn2 ) is transitive, see also ~ trrelressn . (Contributed by Peter Mazsa, 16-Jun-2024.)
theorem trressn {x3 y1 z: setvar} (A2 R: class x3 y1 z):
  $ wal x3 (wal y1 (wal z (wi (wa (wbr (cv x3) (cv y1) (cres R (csn A2))) (wbr (cv y1) (cv z) (cres R (csn A2)))) (wbr (cv x3) (cv z) (cres R (csn A2)))))) $;

--| ` A ` and ` B ` are cosets by relation ` R ` : a binary relation. (Contributed by Peter Mazsa, 22-Apr-2021.)
theorem relbrcoss {x3: setvar} (A2 B2 R V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wi (wrel R) (wb (wbr A2 B2 (ccoss R)) (wrex x3 (wa (wcel A2 (cec (cv x3) R)) (wcel B2 (cec (cv x3) R))) (cdm R)))) $;

--| ` B ` and ` C ` are cosets by an intersection with a restriction: a binary relation. (Contributed by Peter Mazsa, 31-Dec-2021.)
theorem br1cossinres {u: setvar} (A2 B2 C R S V W: class):
  $ wi (wa (wcel B2 V) (wcel C W)) (wb (wbr B2 C (ccoss (cin R (cres S A2)))) (wrex u (wa (wa (wbr (cv u) B2 S) (wbr (cv u) B2 R)) (wa (wbr (cv u) C S) (wbr (cv u) C R))) A2)) $;

--| ` <. B , C >. ` and ` <. D , E >. ` are cosets by an range Cartesian product with a restriction: a binary relation. (Contributed by Peter Mazsa, 8-Jun-2021.)
theorem br1cossxrnres {u: setvar} (A2 B2 C D R S E V W X Y: class):
  $ wi (wa (wa (wcel B2 V) (wcel C W)) (wa (wcel D X) (wcel E Y))) (wb (wbr (cop B2 C) (cop D E) (ccoss (cxrn R (cres S A2)))) (wrex u (wa (wa (wbr (cv u) C S) (wbr (cv u) B2 R)) (wa (wbr (cv u) E S) (wbr (cv u) D R))) A2)) $;

--| ` B ` and ` C ` are cosets by an intersection with the restricted identity class: a binary relation. (Contributed by Peter Mazsa, 31-Dec-2021.)
theorem br1cossinidres {u: setvar} (A2 B2 C R V W: class):
  $ wi (wa (wcel B2 V) (wcel C W)) (wb (wbr B2 C (ccoss (cin R (cres cid A2)))) (wrex u (wa (wa (wceq (cv u) B2) (wbr (cv u) B2 R)) (wa (wceq (cv u) C) (wbr (cv u) C R))) A2)) $;

--| ` B ` and ` C ` are cosets by an intersection with the restricted converse epsilon class: a binary relation. (Contributed by Peter Mazsa, 31-Dec-2021.)
theorem br1cossincnvepres {u: setvar} (A2 B2 C R V W: class):
  $ wi (wa (wcel B2 V) (wcel C W)) (wb (wbr B2 C (ccoss (cin R (cres (ccnv cep) A2)))) (wrex u (wa (wa (wcel B2 (cv u)) (wbr (cv u) B2 R)) (wa (wcel C (cv u)) (wbr (cv u) C R))) A2)) $;

--| ` <. B , C >. ` and ` <. D , E >. ` are cosets by a range Cartesian product with the restricted identity class: a binary relation. (Contributed by Peter Mazsa, 8-Jun-2021.)
theorem br1cossxrnidres {u: setvar} (A2 B2 C D R E V W X Y: class):
  $ wi (wa (wa (wcel B2 V) (wcel C W)) (wa (wcel D X) (wcel E Y))) (wb (wbr (cop B2 C) (cop D E) (ccoss (cxrn R (cres cid A2)))) (wrex u (wa (wa (wceq (cv u) C) (wbr (cv u) B2 R)) (wa (wceq (cv u) E) (wbr (cv u) D R))) A2)) $;

--| ` <. B , C >. ` and ` <. D , E >. ` are cosets by a range Cartesian product with the restricted converse epsilon class: a binary relation. (Contributed by Peter Mazsa, 12-May-2021.)
theorem br1cossxrncnvepres {u: setvar} (A2 B2 C D R E V W X Y: class):
  $ wi (wa (wa (wcel B2 V) (wcel C W)) (wa (wcel D X) (wcel E Y))) (wb (wbr (cop B2 C) (cop D E) (ccoss (cxrn R (cres (ccnv cep) A2)))) (wrex u (wa (wa (wcel C (cv u)) (wbr (cv u) B2 R)) (wa (wcel E (cv u)) (wbr (cv u) D R))) A2)) $;

--| The domain of cosets is the domain of converse. (Contributed by Peter Mazsa, 4-Jan-2019.)
theorem dmcoss3 (R: class):
  $ wceq (cdm (ccoss R)) (cdm (ccnv R)) $;

--| The domain of cosets is the range. (Contributed by Peter Mazsa, 27-Dec-2018.)
theorem dmcoss2 (R: class):
  $ wceq (cdm (ccoss R)) (crn R) $;

--| The range of cosets is the domain of them (this should be ~ rncoss but there exists a theorem with this name already). (Contributed by Peter Mazsa, 12-Dec-2019.)
theorem rncossdmcoss (R: class):
  $ wceq (crn (ccoss R)) (cdm (ccoss R)) $;

--| The domain of cosets of the restricted converse epsilon relation is the union of the restriction. (Contributed by Peter Mazsa, 18-May-2019.) (Revised by Peter Mazsa, 26-Sep-2021.)
theorem dm1cosscnvepres (A2: class):
  $ wceq (cdm (ccoss (cres (ccnv cep) A2))) (cuni A2) $;

--| The domain of coelements in ` A ` is the union of ` A ` . (Contributed by Rodolfo Medina, 14-Oct-2010.) (Revised by Peter Mazsa, 5-Apr-2018.) (Revised by Peter Mazsa, 26-Sep-2021.)
theorem dmcoels (A2: class):
  $ wceq (cdm (ccoels A2)) (cuni A2) $;

--| Elementhood in the domain of cosets. (Contributed by Peter Mazsa, 29-Mar-2019.)
theorem eldmcoss {u: setvar} (A2 R V: class):
  $ wi (wcel A2 V) (wb (wcel A2 (cdm (ccoss R))) (wex u (wbr (cv u) A2 R))) $;

--| Elementhood in the domain of cosets. (Contributed by Peter Mazsa, 28-Dec-2018.)
theorem eldmcoss2 (A2 R V: class):
  $ wi (wcel A2 V) (wb (wcel A2 (cdm (ccoss R))) (wbr A2 A2 (ccoss R))) $;

--| Elementhood in the domain of restricted cosets. (Contributed by Peter Mazsa, 30-Dec-2018.)
theorem eldm1cossres {u: setvar} (A2 B2 R V: class):
  $ wi (wcel B2 V) (wb (wcel B2 (cdm (ccoss (cres R A2)))) (wrex u (wbr (cv u) B2 R) A2)) $;

--| Elementhood in the domain of restricted cosets. (Contributed by Peter Mazsa, 30-Dec-2018.)
theorem eldm1cossres2 {x3: setvar} (A2 B2 R V: class):
  $ wi (wcel B2 V) (wb (wcel B2 (cdm (ccoss (cres R A2)))) (wrex x3 (wcel B2 (cec (cv x3) R)) A2)) $;

--| Lemma for the left side of the ~ refrelcoss3 reflexivity theorem. (Contributed by Peter Mazsa, 1-Apr-2019.)
theorem refrelcosslem {x3: setvar} (R: class x3):
  $ wral x3 (wbr (cv x3) (cv x3) (ccoss R)) (cdm (ccoss R)) $;

--| The class of cosets by ` R ` is reflexive, see ~ dfrefrel3 . (Contributed by Peter Mazsa, 30-Jul-2019.)
theorem refrelcoss3 {x3 y1: setvar} (R: class):
  $ wa (wral x3 (wral y1 (wi (wceq (cv x3) (cv y1)) (wbr (cv x3) (cv y1) (ccoss R))) (crn (ccoss R))) (cdm (ccoss R))) (wrel (ccoss R)) $;

--| The class of cosets by ` R ` is reflexive, see ~ dfrefrel2 . (Contributed by Peter Mazsa, 30-Jul-2019.)
theorem refrelcoss2 (R: class):
  $ wa (wss (cin cid (cxp (cdm (ccoss R)) (crn (ccoss R)))) (ccoss R)) (wrel (ccoss R)) $;

--| The class of cosets by ` R ` is symmetric, see ~ dfsymrel3 . (Contributed by Peter Mazsa, 28-Mar-2019.) (Revised by Peter Mazsa, 17-Sep-2021.)
theorem symrelcoss3 {x3 y1: setvar} (R: class x3 y1):
  $ wa (wal x3 (wal y1 (wi (wbr (cv x3) (cv y1) (ccoss R)) (wbr (cv y1) (cv x3) (ccoss R))))) (wrel (ccoss R)) $;

--| The class of cosets by ` R ` is symmetric, see ~ dfsymrel2 . (Contributed by Peter Mazsa, 27-Dec-2018.)
theorem symrelcoss2 (R: class):
  $ wa (wss (ccnv (ccoss R)) (ccoss R)) (wrel (ccoss R)) $;

--| Equivalent expressions for the class of cosets by ` R ` to be a subset of the identity class. (Contributed by Peter Mazsa, 27-Jul-2021.)
theorem cossssid (R: class):
  $ wb (wss (ccoss R) cid) (wss (ccoss R) (cin cid (cxp (cdm (ccoss R)) (crn (ccoss R))))) $;

--| Equivalent expressions for the class of cosets by ` R ` to be a subset of the identity class. (Contributed by Peter Mazsa, 10-Mar-2019.)
theorem cossssid2 {x3 y1 u: setvar} (R: class):
  $ wb (wss (ccoss R) cid) (wal x3 (wal y1 (wi (wex u (wa (wbr (cv u) (cv x3) R) (wbr (cv u) (cv y1) R))) (wceq (cv x3) (cv y1))))) $;

--| Equivalent expressions for the class of cosets by ` R ` to be a subset of the identity class. (Contributed by Peter Mazsa, 10-Mar-2019.)
theorem cossssid3 {x3 y1 u: setvar} (R: class):
  $ wb (wss (ccoss R) cid) (wal u (wal x3 (wal y1 (wi (wa (wbr (cv u) (cv x3) R) (wbr (cv u) (cv y1) R)) (wceq (cv x3) (cv y1)))))) $;

--| Equivalent expressions for the class of cosets by ` R ` to be a subset of the identity class. (Contributed by Peter Mazsa, 31-Aug-2021.)
theorem cossssid4 {x3 u: setvar} (R: class):
  $ wb (wss (ccoss R) cid) (wal u (wmo x3 (wbr (cv u) (cv x3) R))) $;

--| Equivalent expressions for the class of cosets by ` R ` to be a subset of the identity class. (Contributed by Peter Mazsa, 5-Sep-2021.)
theorem cossssid5 {x3 y1: setvar} (R: class):
  $ wb (wss (ccoss R) cid) (wral x3 (wral y1 (wo (wceq (cv x3) (cv y1)) (wceq (cin (cec (cv x3) (ccnv R)) (cec (cv y1) (ccnv R))) c0)) (crn R)) (crn R)) $;

--| ` A ` and ` B ` are cosets by converse ` R ` : a binary relation. (Contributed by Peter Mazsa, 23-Jan-2019.)
theorem brcosscnv {x3: setvar} (A2 B2 R V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wbr A2 B2 (ccoss (ccnv R))) (wex x3 (wa (wbr A2 (cv x3) R) (wbr B2 (cv x3) R)))) $;

--| ` A ` and ` B ` are cosets by converse ` R ` : a binary relation. (Contributed by Peter Mazsa, 12-Mar-2019.)
theorem brcosscnv2 (A2 B2 R V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wbr A2 B2 (ccoss (ccnv R))) (wne (cin (cec A2 R) (cec B2 R)) c0)) $;

--| ` A ` and ` B ` are cosets by the converse range Cartesian product: a binary relation. (Contributed by Peter Mazsa, 19-Apr-2020.) (Revised by Peter Mazsa, 21-Sep-2021.)
theorem br1cosscnvxrn (A2 B2 R S V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wbr A2 B2 (ccoss (ccnv (cxrn R S)))) (wa (wbr A2 B2 (ccoss (ccnv R))) (wbr A2 B2 (ccoss (ccnv S))))) $;

--| Cosets by the converse range Cartesian product. (Contributed by Peter Mazsa, 19-Apr-2020.) (Revised by Peter Mazsa, 21-Sep-2021.)
theorem _1cosscnvxrn (A2 B2: class):
  $ wceq (ccoss (ccnv (cxrn A2 B2))) (cin (ccoss (ccnv A2)) (ccoss (ccnv B2))) $;

--| Equivalent expressions for the class of cosets by the converse of ` R ` to be a subset of the identity class. (Contributed by Peter Mazsa, 28-Jul-2021.)
theorem cosscnvssid3 {x3 v u: setvar} (R: class):
  $ wb (wss (ccoss (ccnv R)) cid) (wal u (wal v (wal x3 (wi (wa (wbr (cv u) (cv x3) R) (wbr (cv v) (cv x3) R)) (wceq (cv u) (cv v)))))) $;

--| Equivalent expressions for the class of cosets by the converse of ` R ` to be a subset of the identity class. (Contributed by Peter Mazsa, 31-Aug-2021.)
theorem cosscnvssid4 {x3 u: setvar} (R: class):
  $ wb (wss (ccoss (ccnv R)) cid) (wal x3 (wmo u (wbr (cv u) (cv x3) R))) $;

--| Equivalent expressions for the class of cosets by the converse of the relation ` R ` to be a subset of the identity class. (Contributed by Peter Mazsa, 5-Sep-2021.)
theorem cosscnvssid5 {v u: setvar} (R: class):
  $ wb (wa (wss (ccoss (ccnv R)) cid) (wrel R)) (wa (wral u (wral v (wo (wceq (cv u) (cv v)) (wceq (cin (cec (cv u) R) (cec (cv v) R)) c0)) (cdm R)) (cdm R)) (wrel R)) $;

--| Cosets by the empty set are the empty set. (Contributed by Peter Mazsa, 22-Oct-2019.)
theorem coss0:
  $ wceq (ccoss c0) c0 $;

--| Cosets by the identity relation are the identity relation. (Contributed by Peter Mazsa, 16-Jan-2019.)
theorem cossid:
  $ wceq (ccoss cid) cid $;

--| Cosets by the converse identity relation are the identity relation. (Contributed by Peter Mazsa, 27-Sep-2021.)
theorem cosscnvid:
  $ wceq (ccoss (ccnv cid)) cid $;

--| Sufficient condition for the transitivity of cosets by ` R ` . (Contributed by Peter Mazsa, 26-Dec-2018.)
theorem trcoss {x3 y1 z u: setvar} (R: class y1):
  $ wi (wal y1 (wmo u (wbr (cv u) (cv y1) R))) (wal x3 (wal y1 (wal z (wi (wa (wbr (cv x3) (cv y1) (ccoss R)) (wbr (cv y1) (cv z) (ccoss R))) (wbr (cv x3) (cv z) (ccoss R)))))) $;

--| Two ways of saying that the coset of ` A ` and the coset of ` C ` have the common element ` B ` . (Contributed by Peter Mazsa, 15-Oct-2021.)
theorem eleccossin (A2 B2 C R V W: class):
  $ wi (wa (wcel B2 V) (wcel C W)) (wb (wcel B2 (cin (cec A2 (ccoss R)) (cec C (ccoss R)))) (wa (wbr A2 B2 (ccoss R)) (wbr B2 C (ccoss R)))) $;

--| Equivalent expressions for the transitivity of cosets by ` R ` . (Contributed by Peter Mazsa, 4-Jul-2020.) (Revised by Peter Mazsa, 16-Oct-2021.)
theorem trcoss2 {x3 y1 z: setvar} (R: class x3 z):
  $ wb (wal x3 (wal y1 (wal z (wi (wa (wbr (cv x3) (cv y1) (ccoss R)) (wbr (cv y1) (cv z) (ccoss R))) (wbr (cv x3) (cv z) (ccoss R)))))) (wal x3 (wal z (wi (wne (cin (cec (cv x3) (ccoss R)) (cec (cv z) (ccoss R))) c0) (wne (cin (cec (cv x3) (ccnv R)) (cec (cv z) (ccnv R))) c0)))) $;

--| Cosets of sets are elements of the relations class. Implies ` |- ( R e. Rels -> ,~ R e. Rels ) ` . (Contributed by Peter Mazsa, 25-Aug-2021.)
theorem cosselrels (A2 V: class):
  $ wi (wcel A2 V) (wcel (ccoss A2) crels) $;

--| The converse of a set is an element of the class of relations. (Contributed by Peter Mazsa, 18-Aug-2019.)
theorem cnvelrels (A2 V: class):
  $ wi (wcel A2 V) (wcel (ccnv A2) crels) $;

--| Cosets of converse sets are elements of the relations class. (Contributed by Peter Mazsa, 31-Aug-2021.)
theorem cosscnvelrels (A2 V: class):
  $ wi (wcel A2 V) (wcel (ccoss (ccnv A2)) crels) $;

--| Define the subsets class or the class of subset relations. Similar to definitions of epsilon relation ( ~ df-eprel ) and identity relation ( ~ df-id ) classes. Subset relation class and Scott Fenton's subset class ~ df-sset are the same: ` _S = SSet ` (compare ~ dfssr2 with ~ df-sset ), the only reason we do not use ~ dfssr2 as the base definition of the subsets class is the way we defined the epsilon relation and the identity relation classes. The binary relation on the class of subsets and the subclass relationship ( ~ df-ss ) are the same, that is, ` ( A _S B <-> A C_ B ) ` when ` B ` is a set, see ~ brssr . Yet in general we use the subclass relation ` A C_ B ` both for classes and for sets, see the comment of ~ df-ss . The only exception (aside from directly investigating the class ` _S ` e.g. in ~ relssr or in ~ extssr ) is when we have a specific purpose with its usage, like in case of ~ df-refs versus ~ df-cnvrefs , where we need ` _S ` to define the class of reflexive sets in order to be able to define the class of converse reflexive sets with the help of the converse of ` _S ` . The subsets class ` _S ` has another place in set.mm as well: if we define extensional relation based on the common property in ~ extid , ~ extep and ~ extssr , then "extrelssr" " |- ExtRel ` _S ` " is a theorem along with "extrelep" " |- ExtRel ` _E ` " and "extrelid" " |- ExtRel ` _I ` " . (Contributed by Peter Mazsa, 25-Jul-2019.)
axiom df_ssr {x3 y1: setvar}:
  $ wceq cssr (copab x3 y1 (wss (cv x3) (cv y1))) $;

--| Alternate definition of the subset relation. (Contributed by Peter Mazsa, 9-Aug-2021.)
theorem dfssr2:
  $ wceq cssr (cdif (cxp cvv cvv) (crn (cxrn cep (cdif cvv cep)))) $;

--| The subset relation is a relation. (Contributed by Peter Mazsa, 1-Aug-2019.)
theorem relssr:
  $ wrel cssr $;

--| The subset relation and subclass relationship ( ~ df-ss ) are the same, that is, ` ( A _S B <-> A C_ B ) ` when ` B ` is a set. (Contributed by Peter Mazsa, 31-Jul-2019.)
theorem brssr (A2 B2 V: class):
  $ wi (wcel B2 V) (wb (wbr A2 B2 cssr) (wss A2 B2)) $;

--| Any set is a subset of itself. (Contributed by Peter Mazsa, 1-Aug-2019.)
theorem brssrid (A2 V: class):
  $ wi (wcel A2 V) (wbr A2 A2 cssr) $;

--| Two ways of expressing set existence. (Contributed by Peter Mazsa, 1-Aug-2019.)
theorem issetssr (A2: class):
  $ wb (wcel A2 cvv) (wbr A2 A2 cssr) $;

--| Restricted subset binary relation. (Contributed by Peter Mazsa, 25-Nov-2019.)
theorem brssrres (A2 B2 C V: class):
  $ wi (wcel C V) (wb (wbr B2 C (cres cssr A2)) (wa (wcel B2 A2) (wss B2 C))) $;

--| Restricted converse subset binary relation. (Contributed by Peter Mazsa, 25-Nov-2019.)
theorem br1cnvssrres (A2 B2 C V: class):
  $ wi (wcel B2 V) (wb (wbr B2 C (ccnv (cres cssr A2))) (wa (wcel C A2) (wss C B2))) $;

--| The converse of a subset relation swaps arguments. (Contributed by Peter Mazsa, 1-Aug-2019.)
theorem brcnvssr (A2 B2 V: class):
  $ wi (wcel A2 V) (wb (wbr A2 B2 (ccnv cssr)) (wss B2 A2)) $;

--| Any set is a converse subset of itself. (Contributed by Peter Mazsa, 9-Jun-2021.)
theorem brcnvssrid (A2 V: class):
  $ wi (wcel A2 V) (wbr A2 A2 (ccnv cssr)) $;

--| ` <. B , C >. ` and ` <. D , E >. ` are cosets by range Cartesian product with restricted converse subsets class: a binary relation. (Contributed by Peter Mazsa, 9-Jun-2021.)
theorem br1cossxrncnvssrres {u: setvar} (A2 B2 C D R E V W X Y: class):
  $ wi (wa (wa (wcel B2 V) (wcel C W)) (wa (wcel D X) (wcel E Y))) (wb (wbr (cop B2 C) (cop D E) (ccoss (cxrn R (cres (ccnv cssr) A2)))) (wrex u (wa (wa (wss C (cv u)) (wbr (cv u) B2 R)) (wa (wss E (cv u)) (wbr (cv u) D R))) A2)) $;

--| Property of subset relation, see also ~ extid , ~ extep and the comment of ~ df-ssr . (Contributed by Peter Mazsa, 10-Jul-2019.)
theorem extssr (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wceq (cec A2 (ccnv cssr)) (cec B2 (ccnv cssr))) (wceq A2 B2)) $;

--| Define the class of all reflexive sets. It is used only by ~ df-refrels . We use subset relation ` _S ` ( ~ df-ssr ) here to be able to define converse reflexivity ( ~ df-cnvrefs ), see also the comment of ~ df-ssr . The elements of this class are not necessarily relations (versus ~ df-refrels ). Note the similarity of Definitions ~ df-refs , ~ df-syms and ~ df-trs , cf. comments of ~ dfrefrels2 . (Contributed by Peter Mazsa, 19-Jul-2019.)
axiom df_refs {x3: setvar}:
  $ wceq crefs (cab x3 (wbr (cin cid (cxp (cdm (cv x3)) (crn (cv x3)))) (cin (cv x3) (cxp (cdm (cv x3)) (crn (cv x3)))) cssr)) $;

--| Define the class of reflexive relations. This is practically ~ dfrefrels2 (which reveals that ` RefRels ` can not include proper classes like ` _I ` as is elements, see comments of ~ dfrefrels2 ). Another alternative definition is ~ dfrefrels3 . The element of this class and the reflexive relation predicate ( ~ df-refrel ) are the same, that is, ` ( R e. RefRels <-> RefRel R ) ` when ` A ` is a set, see ~ elrefrelsrel . This definition is similar to the definitions of the classes of symmetric ( ~ df-symrels ) and transitive ( ~ df-trrels ) relations. (Contributed by Peter Mazsa, 7-Jul-2019.)
axiom df_refrels:
  $ wceq crefrels (cin crefs crels) $;

--| Define the reflexive relation predicate. (Read: ` R ` is a reflexive relation.) This is a surprising definition, see the comment of ~ dfrefrel3 . Alternate definitions are ~ dfrefrel2 and ~ dfrefrel3 . For sets, being an element of the class of reflexive relations ( ~ df-refrels ) is equivalent to satisfying the reflexive relation predicate, that is ` ( R e. RefRels <-> RefRel R ) ` when ` R ` is a set, see ~ elrefrelsrel . (Contributed by Peter Mazsa, 16-Jul-2021.)
axiom df_refrel (R: class):
  $ wb (wrefrel R) (wa (wss (cin cid (cxp (cdm R) (crn R))) (cin R (cxp (cdm R) (crn R)))) (wrel R)) $;

--| Alternate definition of the class of reflexive relations. This is a 0-ary class constant, which is recommended for definitions (see the 1. Guideline at ~ https://us.metamath.org/ileuni/mathbox.html ). Proper classes (like ` _I ` , see ~ iprc ) are not elements of this (or any) class: if a class is an element of another class, it is not a proper class but a set, see ~ elex . So if we use 0-ary constant classes as our main definitions, they are valid only for sets, not for proper classes. For proper classes we use predicate-type definitions like ~ df-refrel . See also the comment of ~ df-rels . Note that while elementhood in the class of relations cancels restriction of ` r ` in ~ dfrefrels2 , it keeps restriction of ` _I ` : this is why the very similar definitions ~ df-refs , ~ df-syms and ~ df-trs diverge when we switch from (general) sets to relations in ~ dfrefrels2 , ~ dfsymrels2 and ~ dftrrels2 . (Contributed by Peter Mazsa, 20-Jul-2019.)
theorem dfrefrels2 {r: setvar}:
  $ wceq crefrels (crab r (wss (cin cid (cxp (cdm (cv r)) (crn (cv r)))) (cv r)) crels) $;

--| Alternate definition of the class of reflexive relations. (Contributed by Peter Mazsa, 8-Jul-2019.)
theorem dfrefrels3 {x3 y1 r: setvar}:
  $ wceq crefrels (crab r (wral x3 (wral y1 (wi (wceq (cv x3) (cv y1)) (wbr (cv x3) (cv y1) (cv r))) (crn (cv r))) (cdm (cv r))) crels) $;

--| Alternate definition of the reflexive relation predicate. (Contributed by Peter Mazsa, 25-Jul-2021.)
theorem dfrefrel2 (R: class):
  $ wb (wrefrel R) (wa (wss (cin cid (cxp (cdm R) (crn R))) R) (wrel R)) $;

--| Alternate definition of the reflexive relation predicate. A relation is reflexive iff: for all elements on its domain and range, if an element of its domain is the same as an element of its range, then there is the relation between them. Note that this is definitely not the definition we are accustomed to, like e.g. ~ idref / ~ idrefALT or ~ df-reflexive ` |- ( R Reflexive A <-> ( R C_ ( A X. A ) /\ A. x e. A x R x ) ) ` . It turns out that the not-surprising definition which contains ` A. x e. dom r x r x ` needs symmetry as well, see ~ refsymrels3 . Only when this symmetry condition holds, like in case of equivalence relations, see ~ dfeqvrels3 , can we write the traditional form ` A. x e. dom r x r x ` for reflexive relations. For the special case with square Cartesian product when the two forms are equivalent see ~ idinxpssinxp4 where ` |- ( A. x e. A A. y e. A ( x = y -> x R y ) <-> A. x e. A x R x ) ` . See also similar definition of the converse reflexive relations class ~ dfcnvrefrel3 . (Contributed by Peter Mazsa, 8-Jul-2019.)
theorem dfrefrel3 {x3 y1: setvar} (R: class):
  $ wb (wrefrel R) (wa (wral x3 (wral y1 (wi (wceq (cv x3) (cv y1)) (wbr (cv x3) (cv y1) R)) (crn R)) (cdm R)) (wrel R)) $;

--| Alternate definition of the reflexive relation predicate. (Contributed by Peter Mazsa, 12-Dec-2023.)
theorem dfrefrel5 {x3: setvar} (R: class):
  $ wb (wrefrel R) (wa (wral x3 (wbr (cv x3) (cv x3) R) (cin (cdm R) (crn R))) (wrel R)) $;

--| Element of the class of reflexive relations. (Contributed by Peter Mazsa, 23-Jul-2019.)
theorem elrefrels2 (R: class):
  $ wb (wcel R crefrels) (wa (wss (cin cid (cxp (cdm R) (crn R))) R) (wcel R crels)) $;

--| Element of the class of reflexive relations. (Contributed by Peter Mazsa, 23-Jul-2019.)
theorem elrefrels3 {x3 y1: setvar} (R: class):
  $ wb (wcel R crefrels) (wa (wral x3 (wral y1 (wi (wceq (cv x3) (cv y1)) (wbr (cv x3) (cv y1) R)) (crn R)) (cdm R)) (wcel R crels)) $;

--| For sets, being an element of the class of reflexive relations ( ~ df-refrels ) is equivalent to satisfying the reflexive relation predicate. (Contributed by Peter Mazsa, 25-Jul-2021.)
theorem elrefrelsrel (R V: class):
  $ wi (wcel R V) (wb (wcel R crefrels) (wrefrel R)) $;

--| Equality theorem for reflexive relation. (Contributed by Peter Mazsa, 15-Apr-2019.) (Revised by Peter Mazsa, 23-Sep-2021.)
theorem refreleq (R S: class):
  $ wi (wceq R S) (wb (wrefrel R) (wrefrel S)) $;

--| Identity relation is reflexive. (Contributed by Peter Mazsa, 25-Jul-2021.)
theorem refrelid:
  $ wrefrel cid $;

--| The class of cosets by ` R ` is reflexive. (Contributed by Peter Mazsa, 4-Jul-2020.)
theorem refrelcoss (R: class):
  $ wrefrel (ccoss R) $;

--| Any class ' R ' restricted to the singleton of the set ' A ' (see ~ ressn2 ) is reflexive. (Contributed by Peter Mazsa, 12-Jun-2024.)
theorem refrelressn (A2 R V: class):
  $ wi (wcel A2 V) (wrefrel (cres R (csn A2))) $;

--| Define the class of all converse reflexive sets, see the comment of ~ df-ssr . It is used only by ~ df-cnvrefrels . (Contributed by Peter Mazsa, 22-Jul-2019.)
axiom df_cnvrefs {x3: setvar}:
  $ wceq ccnvrefs (cab x3 (wbr (cin cid (cxp (cdm (cv x3)) (crn (cv x3)))) (cin (cv x3) (cxp (cdm (cv x3)) (crn (cv x3)))) (ccnv cssr))) $;

--| Define the class of converse reflexive relations. This is practically ~ dfcnvrefrels2 (which uses the traditional subclass relation ` C_ ` ) : we use converse subset relation ( ~ brcnvssr ) here to ensure the comparability to the definitions of the classes of all reflexive ( ~ df-ref ), symmetric ( ~ df-syms ) and transitive ( ~ df-trs ) sets. We use this concept to define functions ( ~ df-funsALTV , ~ df-funALTV ) and disjoints ( ~ df-disjs , ~ df-disjALTV ). For sets, being an element of the class of converse reflexive relations is equivalent to satisfying the converse reflexive relation predicate, see ~ elcnvrefrelsrel . Alternate definitions are ~ dfcnvrefrels2 and ~ dfcnvrefrels3 . (Contributed by Peter Mazsa, 7-Jul-2019.)
axiom df_cnvrefrels:
  $ wceq ccnvrefrels (cin ccnvrefs crels) $;

--| Define the converse reflexive relation predicate (read: ` R ` is a converse reflexive relation), see also the comment of ~ dfcnvrefrel3 . Alternate definitions are ~ dfcnvrefrel2 and ~ dfcnvrefrel3 . (Contributed by Peter Mazsa, 16-Jul-2021.)
axiom df_cnvrefrel (R: class):
  $ wb (wcnvrefrel R) (wa (wss (cin R (cxp (cdm R) (crn R))) (cin cid (cxp (cdm R) (crn R)))) (wrel R)) $;

--| Alternate definition of the class of converse reflexive relations. See the comment of ~ dfrefrels2 . (Contributed by Peter Mazsa, 21-Jul-2021.)
theorem dfcnvrefrels2 {r: setvar}:
  $ wceq ccnvrefrels (crab r (wss (cv r) (cin cid (cxp (cdm (cv r)) (crn (cv r))))) crels) $;

--| Alternate definition of the class of converse reflexive relations. (Contributed by Peter Mazsa, 22-Jul-2019.)
theorem dfcnvrefrels3 {x3 y1 r: setvar}:
  $ wceq ccnvrefrels (crab r (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) (cv r)) (wceq (cv x3) (cv y1))) (crn (cv r))) (cdm (cv r))) crels) $;

--| Alternate definition of the converse reflexive relation predicate. (Contributed by Peter Mazsa, 24-Jul-2019.)
theorem dfcnvrefrel2 (R: class):
  $ wb (wcnvrefrel R) (wa (wss R (cin cid (cxp (cdm R) (crn R)))) (wrel R)) $;

--| Alternate definition of the converse reflexive relation predicate. A relation is converse reflexive iff: for all elements on its domain and range, if for an element of its domain and for an element of its range there is the relation between them, then the two elements are the same, cf. the comment of ~ dfrefrel3 . (Contributed by Peter Mazsa, 25-Jul-2021.)
theorem dfcnvrefrel3 {x3 y1: setvar} (R: class):
  $ wb (wcnvrefrel R) (wa (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) R) (wceq (cv x3) (cv y1))) (crn R)) (cdm R)) (wrel R)) $;

--| Alternate definition of the converse reflexive relation predicate. (Contributed by Peter Mazsa, 25-May-2024.)
theorem dfcnvrefrel4 (R: class):
  $ wb (wcnvrefrel R) (wa (wss R cid) (wrel R)) $;

--| Alternate definition of the converse reflexive relation predicate. (Contributed by Peter Mazsa, 25-May-2024.)
theorem dfcnvrefrel5 {x3 y1: setvar} (R: class):
  $ wb (wcnvrefrel R) (wa (wal x3 (wal y1 (wi (wbr (cv x3) (cv y1) R) (wceq (cv x3) (cv y1))))) (wrel R)) $;

--| Element of the class of converse reflexive relations. (Contributed by Peter Mazsa, 25-Jul-2019.)
theorem elcnvrefrels2 (R: class):
  $ wb (wcel R ccnvrefrels) (wa (wss R (cin cid (cxp (cdm R) (crn R)))) (wcel R crels)) $;

--| Element of the class of converse reflexive relations. (Contributed by Peter Mazsa, 30-Aug-2021.)
theorem elcnvrefrels3 {x3 y1: setvar} (R: class):
  $ wb (wcel R ccnvrefrels) (wa (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) R) (wceq (cv x3) (cv y1))) (crn R)) (cdm R)) (wcel R crels)) $;

--| For sets, being an element of the class of converse reflexive relations ( ~ df-cnvrefrels ) is equivalent to satisfying the converse reflexive relation predicate. (Contributed by Peter Mazsa, 25-Jul-2021.)
theorem elcnvrefrelsrel (R V: class):
  $ wi (wcel R V) (wb (wcel R ccnvrefrels) (wcnvrefrel R)) $;

--| Necessary and sufficient condition for a coset relation to be a converse reflexive relation. (Contributed by Peter Mazsa, 27-Jul-2021.)
theorem cnvrefrelcoss2 (R: class):
  $ wb (wcnvrefrel (ccoss R)) (wss (ccoss R) cid) $;

--| Necessary and sufficient condition for a coset relation to be an element of the converse reflexive relation class. (Contributed by Peter Mazsa, 25-Aug-2021.)
theorem cosselcnvrefrels2 (R: class):
  $ wb (wcel (ccoss R) ccnvrefrels) (wa (wss (ccoss R) cid) (wcel (ccoss R) crels)) $;

--| Necessary and sufficient condition for a coset relation to be an element of the converse reflexive relation class. (Contributed by Peter Mazsa, 30-Aug-2021.)
theorem cosselcnvrefrels3 {x3 y1 u: setvar} (R: class):
  $ wb (wcel (ccoss R) ccnvrefrels) (wa (wal u (wal x3 (wal y1 (wi (wa (wbr (cv u) (cv x3) R) (wbr (cv u) (cv y1) R)) (wceq (cv x3) (cv y1)))))) (wcel (ccoss R) crels)) $;

--| Necessary and sufficient condition for a coset relation to be an element of the converse reflexive relation class. (Contributed by Peter Mazsa, 31-Aug-2021.)
theorem cosselcnvrefrels4 {x3 u: setvar} (R: class):
  $ wb (wcel (ccoss R) ccnvrefrels) (wa (wal u (wmo x3 (wbr (cv u) (cv x3) R))) (wcel (ccoss R) crels)) $;

--| Necessary and sufficient condition for a coset relation to be an element of the converse reflexive relation class. (Contributed by Peter Mazsa, 5-Sep-2021.)
theorem cosselcnvrefrels5 {x3 y1: setvar} (R: class):
  $ wb (wcel (ccoss R) ccnvrefrels) (wa (wral x3 (wral y1 (wo (wceq (cv x3) (cv y1)) (wceq (cin (cec (cv x3) (ccnv R)) (cec (cv y1) (ccnv R))) c0)) (crn R)) (crn R)) (wcel (ccoss R) crels)) $;

--| Define the class of all symmetric sets. It is used only by ~ df-symrels . Note the similarity of Definitions ~ df-refs , ~ df-syms and ~ df-trs , cf. the comment of ~ dfrefrels2 . (Contributed by Peter Mazsa, 19-Jul-2019.)
axiom df_syms {x3: setvar}:
  $ wceq csyms (cab x3 (wbr (ccnv (cin (cv x3) (cxp (cdm (cv x3)) (crn (cv x3))))) (cin (cv x3) (cxp (cdm (cv x3)) (crn (cv x3)))) cssr)) $;

--| Define the class of symmetric relations. For sets, being an element of the class of symmetric relations is equivalent to satisfying the symmetric relation predicate, see ~ elsymrelsrel . Alternate definitions are ~ dfsymrels2 , ~ dfsymrels3 , ~ dfsymrels4 and ~ dfsymrels5 . This definition is similar to the definitions of the classes of reflexive ( ~ df-refrels ) and transitive ( ~ df-trrels ) relations. (Contributed by Peter Mazsa, 7-Jul-2019.)
axiom df_symrels:
  $ wceq csymrels (cin csyms crels) $;

--| Define the symmetric relation predicate. (Read: ` R ` is a symmetric relation.) For sets, being an element of the class of symmetric relations ( ~ df-symrels ) is equivalent to satisfying the symmetric relation predicate, see ~ elsymrelsrel . Alternate definitions are ~ dfsymrel2 and ~ dfsymrel3 . (Contributed by Peter Mazsa, 16-Jul-2021.)
axiom df_symrel (R: class):
  $ wb (wsymrel R) (wa (wss (ccnv (cin R (cxp (cdm R) (crn R)))) (cin R (cxp (cdm R) (crn R)))) (wrel R)) $;

--| Alternate definition of the class of symmetric relations. Cf. the comment of ~ dfrefrels2 . (Contributed by Peter Mazsa, 20-Jul-2019.)
theorem dfsymrels2 {r: setvar}:
  $ wceq csymrels (crab r (wss (ccnv (cv r)) (cv r)) crels) $;

--| Alternate definition of the class of symmetric relations. (Contributed by Peter Mazsa, 22-Jul-2021.)
theorem dfsymrels3 {x3 y1 r: setvar}:
  $ wceq csymrels (crab r (wal x3 (wal y1 (wi (wbr (cv x3) (cv y1) (cv r)) (wbr (cv y1) (cv x3) (cv r))))) crels) $;

--| Two ways of saying a relation is symmetric. (Contributed by Peter Mazsa, 22-Aug-2021.)
theorem elrelscnveq3 {x3 y1: setvar} (R: class):
  $ wi (wcel R crels) (wb (wceq R (ccnv R)) (wal x3 (wal y1 (wi (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv x3) R))))) $;

--| Two ways of saying a relation is symmetric. (Contributed by Peter Mazsa, 22-Aug-2021.)
theorem elrelscnveq (R: class):
  $ wi (wcel R crels) (wb (wss (ccnv R) R) (wceq (ccnv R) R)) $;

--| Two ways of saying a relation is symmetric. (Contributed by Peter Mazsa, 22-Aug-2021.)
theorem elrelscnveq2 {x3 y1: setvar} (R: class):
  $ wi (wcel R crels) (wb (wceq (ccnv R) R) (wal x3 (wal y1 (wb (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv x3) R))))) $;

--| Two ways of saying a relation is symmetric. (Contributed by Peter Mazsa, 22-Aug-2021.)
theorem elrelscnveq4 {x3 y1: setvar} (R: class):
  $ wi (wcel R crels) (wb (wss (ccnv R) R) (wal x3 (wal y1 (wb (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv x3) R))))) $;

--| Alternate definition of the class of symmetric relations. (Contributed by Peter Mazsa, 20-Jul-2019.)
theorem dfsymrels4 {r: setvar}:
  $ wceq csymrels (crab r (wceq (ccnv (cv r)) (cv r)) crels) $;

--| Alternate definition of the class of symmetric relations. (Contributed by Peter Mazsa, 22-Jul-2021.)
theorem dfsymrels5 {x3 y1 r: setvar}:
  $ wceq csymrels (crab r (wal x3 (wal y1 (wb (wbr (cv x3) (cv y1) (cv r)) (wbr (cv y1) (cv x3) (cv r))))) crels) $;

--| Alternate definition of the symmetric relation predicate. (Contributed by Peter Mazsa, 19-Apr-2019.) (Revised by Peter Mazsa, 17-Aug-2021.)
theorem dfsymrel2 (R: class):
  $ wb (wsymrel R) (wa (wss (ccnv R) R) (wrel R)) $;

--| Alternate definition of the symmetric relation predicate. (Contributed by Peter Mazsa, 21-Apr-2019.) (Revised by Peter Mazsa, 17-Aug-2021.)
theorem dfsymrel3 {x3 y1: setvar} (R: class):
  $ wb (wsymrel R) (wa (wal x3 (wal y1 (wi (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv x3) R)))) (wrel R)) $;

--| Alternate definition of the symmetric relation predicate. (Contributed by Peter Mazsa, 17-Aug-2021.)
theorem dfsymrel4 (R: class):
  $ wb (wsymrel R) (wa (wceq (ccnv R) R) (wrel R)) $;

--| Alternate definition of the symmetric relation predicate. (Contributed by Peter Mazsa, 17-Aug-2021.)
theorem dfsymrel5 {x3 y1: setvar} (R: class):
  $ wb (wsymrel R) (wa (wal x3 (wal y1 (wb (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv x3) R)))) (wrel R)) $;

--| Element of the class of symmetric relations. (Contributed by Peter Mazsa, 17-Aug-2021.)
theorem elsymrels2 (R: class):
  $ wb (wcel R csymrels) (wa (wss (ccnv R) R) (wcel R crels)) $;

--| Element of the class of symmetric relations. (Contributed by Peter Mazsa, 17-Aug-2021.)
theorem elsymrels3 {x3 y1: setvar} (R: class):
  $ wb (wcel R csymrels) (wa (wal x3 (wal y1 (wi (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv x3) R)))) (wcel R crels)) $;

--| Element of the class of symmetric relations. (Contributed by Peter Mazsa, 17-Aug-2021.)
theorem elsymrels4 (R: class):
  $ wb (wcel R csymrels) (wa (wceq (ccnv R) R) (wcel R crels)) $;

--| Element of the class of symmetric relations. (Contributed by Peter Mazsa, 17-Aug-2021.)
theorem elsymrels5 {x3 y1: setvar} (R: class):
  $ wb (wcel R csymrels) (wa (wal x3 (wal y1 (wb (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv x3) R)))) (wcel R crels)) $;

--| For sets, being an element of the class of symmetric relations ( ~ df-symrels ) is equivalent to satisfying the symmetric relation predicate. (Contributed by Peter Mazsa, 17-Aug-2021.)
theorem elsymrelsrel (R V: class):
  $ wi (wcel R V) (wb (wcel R csymrels) (wsymrel R)) $;

--| Equality theorem for symmetric relation. (Contributed by Peter Mazsa, 15-Apr-2019.) (Revised by Peter Mazsa, 23-Sep-2021.)
theorem symreleq (R S: class):
  $ wi (wceq R S) (wb (wsymrel R) (wsymrel S)) $;

--| Symmetric relation implies that the domain and the range are equal. (Contributed by Peter Mazsa, 29-Dec-2021.)
theorem symrelim (R: class):
  $ wi (wsymrel R) (wceq (cdm R) (crn R)) $;

--| The class of cosets by ` R ` is symmetric. (Contributed by Peter Mazsa, 20-Dec-2021.)
theorem symrelcoss (R: class):
  $ wsymrel (ccoss R) $;

--| The identity relation is symmetric. (Contributed by AV, 19-Jun-2022.)
theorem idsymrel:
  $ wsymrel cid $;

--| The membership (epsilon) relation is not symmetric. (Contributed by AV, 18-Jun-2022.)
theorem epnsymrel:
  $ wn (wsymrel cep) $;

--| Symmetry is a sufficient condition for the equivalence of two versions of the reflexive relation, see also ~ symrefref3 . (Contributed by Peter Mazsa, 19-Jul-2018.)
theorem symrefref2 (R: class):
  $ wi (wss (ccnv R) R) (wb (wss (cin cid (cxp (cdm R) (crn R))) R) (wss (cres cid (cdm R)) R)) $;

--| Symmetry is a sufficient condition for the equivalence of two versions of the reflexive relation, see also ~ symrefref2 . (Contributed by Peter Mazsa, 23-Aug-2021.) (Proof modification is discouraged.)
theorem symrefref3 {x3 y1: setvar} (R: class):
  $ wi (wal x3 (wal y1 (wi (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv x3) R)))) (wb (wral x3 (wral y1 (wi (wceq (cv x3) (cv y1)) (wbr (cv x3) (cv y1) R)) (crn R)) (cdm R)) (wral x3 (wbr (cv x3) (cv x3) R) (cdm R))) $;

--| Elements of the class of reflexive relations which are elements of the class of symmetric relations as well (like the elements of the class of equivalence relations ~ dfeqvrels2 ) can use the restricted version for their reflexive part (see below), not just the ` ( _I i^i ( dom r X. ran r ) ) C_ r ` version of ~ dfrefrels2 , cf. the comment of ~ dfrefrels2 . (Contributed by Peter Mazsa, 20-Jul-2019.)
theorem refsymrels2 {r: setvar}:
  $ wceq (cin crefrels csymrels) (crab r (wa (wss (cres cid (cdm (cv r))) (cv r)) (wss (ccnv (cv r)) (cv r))) crels) $;

--| Elements of the class of reflexive relations which are elements of the class of symmetric relations as well (like the elements of the class of equivalence relations ~ dfeqvrels3 ) can use the ` A. x e. dom r x r x ` version for their reflexive part, not just the ` A. x e. dom r A. y e. ran r ( x = y -> x r y ) ` version of ~ dfrefrels3 , cf. the comment of ~ dfrefrel3 . (Contributed by Peter Mazsa, 22-Jul-2019.) (Proof modification is discouraged.)
theorem refsymrels3 {x3 y1 r: setvar}:
  $ wceq (cin crefrels csymrels) (crab r (wa (wral x3 (wbr (cv x3) (cv x3) (cv r)) (cdm (cv r))) (wal x3 (wal y1 (wi (wbr (cv x3) (cv y1) (cv r)) (wbr (cv y1) (cv x3) (cv r)))))) crels) $;

--| A relation which is reflexive and symmetric (like an equivalence relation) can use the restricted version for their reflexive part (see below), not just the ` ( _I i^i ( dom R X. ran R ) ) C_ R ` version of ~ dfrefrel2 , cf. the comment of ~ dfrefrels2 . (Contributed by Peter Mazsa, 23-Aug-2021.)
theorem refsymrel2 (R: class):
  $ wb (wa (wrefrel R) (wsymrel R)) (wa (wa (wss (cres cid (cdm R)) R) (wss (ccnv R) R)) (wrel R)) $;

--| A relation which is reflexive and symmetric (like an equivalence relation) can use the ` A. x e. dom R x R x ` version for its reflexive part, not just the ` A. x e. dom R A. y e. ran R ( x = y -> x R y ) ` version of ~ dfrefrel3 , cf. the comment of ~ dfrefrel3 . (Contributed by Peter Mazsa, 23-Aug-2021.)
theorem refsymrel3 {x3 y1: setvar} (R: class):
  $ wb (wa (wrefrel R) (wsymrel R)) (wa (wa (wral x3 (wbr (cv x3) (cv x3) R) (cdm R)) (wal x3 (wal y1 (wi (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv x3) R))))) (wrel R)) $;

--| Elements of the class of reflexive relations which are elements of the class of symmetric relations as well (like the elements of the class of equivalence relations ~ dfeqvrels2 ) can use the restricted version for their reflexive part (see below), not just the ` ( _I i^i ( dom R X. ran R ) ) C_ R ` version of ~ dfrefrels2 , cf. the comment of ~ dfrefrels2 . (Contributed by Peter Mazsa, 22-Jul-2019.)
theorem elrefsymrels2 (R: class):
  $ wb (wcel R (cin crefrels csymrels)) (wa (wa (wss (cres cid (cdm R)) R) (wss (ccnv R) R)) (wcel R crels)) $;

--| Elements of the class of reflexive relations which are elements of the class of symmetric relations as well (like the elements of the class of equivalence relations ~ dfeqvrels3 ) can use the ` A. x e. dom R x R x ` version for their reflexive part, not just the ` A. x e. dom R A. y e. ran R ( x = y -> x R y ) ` version of ~ dfrefrels3 , cf. the comment of ~ dfrefrel3 . (Contributed by Peter Mazsa, 22-Jul-2019.) (Proof modification is discouraged.)
theorem elrefsymrels3 {x3 y1: setvar} (R: class):
  $ wb (wcel R (cin crefrels csymrels)) (wa (wa (wral x3 (wbr (cv x3) (cv x3) R) (cdm R)) (wal x3 (wal y1 (wi (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv x3) R))))) (wcel R crels)) $;

--| For sets, being an element of the class of reflexive and symmetric relations is equivalent to satisfying the reflexive and symmetric relation predicates. (Contributed by Peter Mazsa, 23-Aug-2021.)
theorem elrefsymrelsrel (R V: class):
  $ wi (wcel R V) (wb (wcel R (cin crefrels csymrels)) (wa (wrefrel R) (wsymrel R))) $;

--| Define the class of all transitive sets (versus the transitive class defined in ~ df-tr ). It is used only by ~ df-trrels . Note the similarity of the definitions of ~ df-refs , ~ df-syms and ~ df-trs . (Contributed by Peter Mazsa, 17-Jul-2021.)
axiom df_trs {x3: setvar}:
  $ wceq ctrs (cab x3 (wbr (ccom (cin (cv x3) (cxp (cdm (cv x3)) (crn (cv x3)))) (cin (cv x3) (cxp (cdm (cv x3)) (crn (cv x3))))) (cin (cv x3) (cxp (cdm (cv x3)) (crn (cv x3)))) cssr)) $;

--| Define the class of transitive relations. For sets, being an element of the class of transitive relations is equivalent to satisfying the transitive relation predicate, see ~ eltrrelsrel . Alternate definitions are ~ dftrrels2 and ~ dftrrels3 . This definition is similar to the definitions of the classes of reflexive ( ~ df-refrels ) and symmetric ( ~ df-symrels ) relations. (Contributed by Peter Mazsa, 7-Jul-2019.)
axiom df_trrels:
  $ wceq ctrrels (cin ctrs crels) $;

--| Define the transitive relation predicate. (Read: ` R ` is a transitive relation.) For sets, being an element of the class of transitive relations ( ~ df-trrels ) is equivalent to satisfying the transitive relation predicate, see ~ eltrrelsrel . Alternate definitions are ~ dftrrel2 and ~ dftrrel3 . (Contributed by Peter Mazsa, 17-Jul-2021.)
axiom df_trrel (R: class):
  $ wb (wtrrel R) (wa (wss (ccom (cin R (cxp (cdm R) (crn R))) (cin R (cxp (cdm R) (crn R)))) (cin R (cxp (cdm R) (crn R)))) (wrel R)) $;

--| Alternate definition of the class of transitive relations. I'd prefer to define the class of transitive relations by using the definition of composition by [Suppes] p. 63. df-coSUP ` ( A o. B ) = { <. x , y >. | E. u ( x A u /\ u B y ) } ` as opposed to the present definition of composition ~ df-co ` ( A o. B ) = { <. x , y >. | E. u ( x B u /\ u A y ) } ` because the Suppes definition keeps the order of ` A ` , ` B ` , ` C ` , ` R ` , ` S ` , ` T ` by default in trsinxpSUP ` ( ( ( R i^i ( A X. B ) ) o. ( S ` ` i^i ( B X. C ) ) ) C_ ( T i^i ( A X. C ) ) <-> A. x e. A A. y e. B A. ` ` z e. C ( ( x R y /\ y S z ) -> x T z ) ) ` while the present definition of composition disarranges them: trsinxp ` ( ( ( S i^i ( B X. C ) ) o. ( R i^i ( A X. B ) ) ) C_ ( T i^i ( A X. C ` ` ) ) <-> A. x e. A A. y e. B A. z e. C ( ( x R y /\ y S z ) -> x T z ) ` ` ) ` . This is not mission critical to me, the implication of the Suppes definition is just more aesthetic, at least in the above case. If we swap to the Suppes definition of class composition, I would define the present class of all transitive sets as df-trsSUP and I would consider to switch the definition of the class of cosets by ` R ` from the present ~ df-coss to a df-cossSUP. But perhaps there is a mathematical reason to keep the present definition of composition. (Contributed by Peter Mazsa, 21-Jul-2021.)
theorem dftrrels2 {r: setvar}:
  $ wceq ctrrels (crab r (wss (ccom (cv r) (cv r)) (cv r)) crels) $;

--| Alternate definition of the class of transitive relations. (Contributed by Peter Mazsa, 22-Jul-2021.)
theorem dftrrels3 {x3 y1 z r: setvar}:
  $ wceq ctrrels (crab r (wal x3 (wal y1 (wal z (wi (wa (wbr (cv x3) (cv y1) (cv r)) (wbr (cv y1) (cv z) (cv r))) (wbr (cv x3) (cv z) (cv r)))))) crels) $;

--| Alternate definition of the transitive relation predicate. (Contributed by Peter Mazsa, 22-Aug-2021.)
theorem dftrrel2 (R: class):
  $ wb (wtrrel R) (wa (wss (ccom R R) R) (wrel R)) $;

--| Alternate definition of the transitive relation predicate. (Contributed by Peter Mazsa, 22-Aug-2021.)
theorem dftrrel3 {x3 y1 z: setvar} (R: class):
  $ wb (wtrrel R) (wa (wal x3 (wal y1 (wal z (wi (wa (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv z) R)) (wbr (cv x3) (cv z) R))))) (wrel R)) $;

--| Element of the class of transitive relations. (Contributed by Peter Mazsa, 22-Aug-2021.)
theorem eltrrels2 (R: class):
  $ wb (wcel R ctrrels) (wa (wss (ccom R R) R) (wcel R crels)) $;

--| Element of the class of transitive relations. (Contributed by Peter Mazsa, 22-Aug-2021.)
theorem eltrrels3 {x3 y1 z: setvar} (R: class):
  $ wb (wcel R ctrrels) (wa (wal x3 (wal y1 (wal z (wi (wa (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv z) R)) (wbr (cv x3) (cv z) R))))) (wcel R crels)) $;

--| For sets, being an element of the class of transitive relations is equivalent to satisfying the transitive relation predicate. (Contributed by Peter Mazsa, 22-Aug-2021.)
theorem eltrrelsrel (R V: class):
  $ wi (wcel R V) (wb (wcel R ctrrels) (wtrrel R)) $;

--| Equality theorem for the transitive relation predicate. (Contributed by Peter Mazsa, 15-Apr-2019.) (Revised by Peter Mazsa, 23-Sep-2021.)
theorem trreleq (R S: class):
  $ wi (wceq R S) (wb (wtrrel R) (wtrrel S)) $;

--| Any class ' R ' restricted to the singleton of the class ' A ' (see ~ ressn2 ) is transitive. (Contributed by Peter Mazsa, 17-Jun-2024.)
theorem trrelressn (A2 R: class):
  $ wtrrel (cres R (csn A2)) $;

--| Define the class of equivalence relations. For sets, being an element of the class of equivalence relations is equivalent to satisfying the equivalence relation predicate, see ~ eleqvrelsrel . Alternate definitions are ~ dfeqvrels2 and ~ dfeqvrels3 . (Contributed by Peter Mazsa, 7-Nov-2018.)
axiom df_eqvrels:
  $ wceq ceqvrels (cin (cin crefrels csymrels) ctrrels) $;

--| Define the equivalence relation predicate. (Read: ` R ` is an equivalence relation.) For sets, being an element of the class of equivalence relations ( ~ df-eqvrels ) is equivalent to satisfying the equivalence relation predicate, see ~ eleqvrelsrel . Alternate definitions are ~ dfeqvrel2 and ~ dfeqvrel3 . (Contributed by Peter Mazsa, 17-Apr-2019.)
axiom df_eqvrel (R: class):
  $ wb (weqvrel R) (w3a (wrefrel R) (wsymrel R) (wtrrel R)) $;

--| Define the coelement equivalence relations class, the class of sets with coelement equivalence relations. For sets, being an element of the class of coelement equivalence relations is equivalent to satisfying the coelement equivalence relation predicate, see ~ elcoeleqvrelsrel . Alternate definition is ~ dfcoeleqvrels . (Contributed by Peter Mazsa, 28-Nov-2022.)
axiom df_coeleqvrels {a: setvar}:
  $ wceq ccoeleqvrels (cab a (wcel (ccoss (cres (ccnv cep) (cv a))) ceqvrels)) $;

--| Define the coelement equivalence relation predicate. (Read: the coelement equivalence relation on ` A ` .) Alternate definition is ~ dfcoeleqvrel . For sets, being an element of the class of coelement equivalence relations is equivalent to satisfying the coelement equivalence relation predicate, see ~ elcoeleqvrelsrel . (Contributed by Peter Mazsa, 11-Dec-2021.)
axiom df_coeleqvrel (A2: class):
  $ wb (wcoeleqvrel A2) (weqvrel (ccoss (cres (ccnv cep) A2))) $;

--| Alternate definition of the class of equivalence relations. (Contributed by Peter Mazsa, 2-Dec-2019.)
theorem dfeqvrels2 {r: setvar}:
  $ wceq ceqvrels (crab r (w3a (wss (cres cid (cdm (cv r))) (cv r)) (wss (ccnv (cv r)) (cv r)) (wss (ccom (cv r) (cv r)) (cv r))) crels) $;

--| Alternate definition of the class of equivalence relations. (Contributed by Peter Mazsa, 2-Dec-2019.)
theorem dfeqvrels3 {x3 y1 z r: setvar}:
  $ wceq ceqvrels (crab r (w3a (wral x3 (wbr (cv x3) (cv x3) (cv r)) (cdm (cv r))) (wal x3 (wal y1 (wi (wbr (cv x3) (cv y1) (cv r)) (wbr (cv y1) (cv x3) (cv r))))) (wal x3 (wal y1 (wal z (wi (wa (wbr (cv x3) (cv y1) (cv r)) (wbr (cv y1) (cv z) (cv r))) (wbr (cv x3) (cv z) (cv r))))))) crels) $;

--| Alternate definition of the equivalence relation predicate. (Contributed by Peter Mazsa, 22-Apr-2019.)
theorem dfeqvrel2 (R: class):
  $ wb (weqvrel R) (wa (w3a (wss (cres cid (cdm R)) R) (wss (ccnv R) R) (wss (ccom R R) R)) (wrel R)) $;

--| Alternate definition of the equivalence relation predicate. (Contributed by Peter Mazsa, 22-Apr-2019.)
theorem dfeqvrel3 {x3 y1 z: setvar} (R: class):
  $ wb (weqvrel R) (wa (w3a (wral x3 (wbr (cv x3) (cv x3) R) (cdm R)) (wal x3 (wal y1 (wi (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv x3) R)))) (wal x3 (wal y1 (wal z (wi (wa (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv z) R)) (wbr (cv x3) (cv z) R)))))) (wrel R)) $;

--| Element of the class of equivalence relations. (Contributed by Peter Mazsa, 24-Aug-2021.)
theorem eleqvrels2 (R: class):
  $ wb (wcel R ceqvrels) (wa (w3a (wss (cres cid (cdm R)) R) (wss (ccnv R) R) (wss (ccom R R) R)) (wcel R crels)) $;

--| Element of the class of equivalence relations. (Contributed by Peter Mazsa, 24-Aug-2021.)
theorem eleqvrels3 {x3 y1 z: setvar} (R: class):
  $ wb (wcel R ceqvrels) (wa (w3a (wral x3 (wbr (cv x3) (cv x3) R) (cdm R)) (wal x3 (wal y1 (wi (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv x3) R)))) (wal x3 (wal y1 (wal z (wi (wa (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv z) R)) (wbr (cv x3) (cv z) R)))))) (wcel R crels)) $;

--| For sets, being an element of the class of equivalence relations is equivalent to satisfying the equivalence relation predicate. (Contributed by Peter Mazsa, 24-Aug-2021.)
theorem eleqvrelsrel (R V: class):
  $ wi (wcel R V) (wb (wcel R ceqvrels) (weqvrel R)) $;

--| Elementhood in the coelement equivalence relations class. (Contributed by Peter Mazsa, 24-Jul-2023.)
theorem elcoeleqvrels (A2 V: class):
  $ wi (wcel A2 V) (wb (wcel A2 ccoeleqvrels) (wcel (ccoss (cres (ccnv cep) A2)) ceqvrels)) $;

--| For sets, being an element of the class of coelement equivalence relations is equivalent to satisfying the coelement equivalence relation predicate. (Contributed by Peter Mazsa, 24-Jul-2023.)
theorem elcoeleqvrelsrel (A2 V: class):
  $ wi (wcel A2 V) (wb (wcel A2 ccoeleqvrels) (wcoeleqvrel A2)) $;

--| An equivalence relation is a relation. (Contributed by Peter Mazsa, 2-Jun-2019.)
theorem eqvrelrel (R: class):
  $ wi (weqvrel R) (wrel R) $;

--| An equivalence relation is reflexive. (Contributed by Peter Mazsa, 29-Dec-2021.)
theorem eqvrelrefrel (R: class):
  $ wi (weqvrel R) (wrefrel R) $;

--| An equivalence relation is symmetric. (Contributed by Peter Mazsa, 29-Dec-2021.)
theorem eqvrelsymrel (R: class):
  $ wi (weqvrel R) (wsymrel R) $;

--| An equivalence relation is transitive. (Contributed by Peter Mazsa, 29-Dec-2021.)
theorem eqvreltrrel (R: class):
  $ wi (weqvrel R) (wtrrel R) $;

--| Equivalence relation implies that the domain and the range are equal. (Contributed by Peter Mazsa, 29-Dec-2021.)
theorem eqvrelim (R: class):
  $ wi (weqvrel R) (wceq (cdm R) (crn R)) $;

--| Equality theorem for equivalence relation. (Contributed by Peter Mazsa, 19-Apr-2020.) (Revised by Peter Mazsa, 23-Sep-2021.)
theorem eqvreleq (R S: class):
  $ wi (wceq R S) (wb (weqvrel R) (weqvrel S)) $;

--| Equality theorem for equivalence relation, inference version. (Contributed by Peter Mazsa, 23-Sep-2021.)
theorem eqvreleqi (R S: class):
  $ wceq R S $ >
  $ wb (weqvrel R) (weqvrel S) $;

--| Equality theorem for equivalence relation, deduction version. (Contributed by Peter Mazsa, 23-Sep-2021.)
theorem eqvreleqd (ph: wff) (R S: class):
  $ wi ph (wceq R S) $ >
  $ wi ph (wb (weqvrel R) (weqvrel S)) $;

--| An equivalence relation is symmetric. (Contributed by NM, 4-Jun-1995.) (Revised by Mario Carneiro, 12-Aug-2015.) (Revised by Peter Mazsa, 2-Jun-2019.)
theorem eqvrelsym (ph: wff) (A2 B2 R: class):
  $ wi ph (weqvrel R) $ >
  $ wi ph (wbr A2 B2 R) $ >
  $ wi ph (wbr B2 A2 R) $;

--| An equivalence relation is symmetric. (Contributed by NM, 30-Jul-1995.) (Revised by Mario Carneiro, 12-Aug-2015.) (Revised and distinct variable conditions removed by Peter Mazsa, 2-Jun-2019.)
theorem eqvrelsymb (ph: wff) (A2 B2 R: class):
  $ wi ph (weqvrel R) $ >
  $ wi ph (wb (wbr A2 B2 R) (wbr B2 A2 R)) $;

--| An equivalence relation is transitive. (Contributed by NM, 4-Jun-1995.) (Revised by Mario Carneiro, 12-Aug-2015.) (Revised by Peter Mazsa, 2-Jun-2019.)
theorem eqvreltr (ph: wff) (A2 B2 C R: class):
  $ wi ph (weqvrel R) $ >
  $ wi ph (wi (wa (wbr A2 B2 R) (wbr B2 C R)) (wbr A2 C R)) $;

--| A transitivity relation for equivalences. (Contributed by Mario Carneiro, 9-Jul-2014.) (Revised by Peter Mazsa, 2-Jun-2019.)
theorem eqvreltrd (ph: wff) (A2 B2 C R: class):
  $ wi ph (weqvrel R) $ >
  $ wi ph (wbr A2 B2 R) $ >
  $ wi ph (wbr B2 C R) $ >
  $ wi ph (wbr A2 C R) $;

--| A transitivity relation for equivalences. (Contributed by Mario Carneiro, 9-Jul-2014.) (Revised by Peter Mazsa, 2-Jun-2019.)
theorem eqvreltr4d (ph: wff) (A2 B2 C R: class):
  $ wi ph (weqvrel R) $ >
  $ wi ph (wbr A2 B2 R) $ >
  $ wi ph (wbr C B2 R) $ >
  $ wi ph (wbr A2 C R) $;

--| An equivalence relation is reflexive on its field. Compare Theorem 3M of [Enderton] p. 56. (Contributed by Mario Carneiro, 6-May-2013.) (Revised by Mario Carneiro, 12-Aug-2015.) (Revised by Peter Mazsa, 2-Jun-2019.)
theorem eqvrelref (ph: wff) (A2 R: class):
  $ wi ph (weqvrel R) $ >
  $ wi ph (wcel A2 (cdm R)) $ >
  $ wi ph (wbr A2 A2 R) $;

--| Basic property of equivalence relations. Theorem 73 of [Suppes] p. 82. (Contributed by NM, 23-Jul-1995.) (Revised by Mario Carneiro, 6-Jul-2015.) (Revised by Peter Mazsa, 2-Jun-2019.)
theorem eqvrelth (ph: wff) (A2 B2 R: class):
  $ wi ph (weqvrel R) $ >
  $ wi ph (wcel A2 (cdm R)) $ >
  $ wi ph (wb (wbr A2 B2 R) (wceq (cec A2 R) (cec B2 R))) $;

--| Elementhood in the field of an equivalence relation. (Contributed by Mario Carneiro, 12-Aug-2015.) (Revised by Peter Mazsa, 2-Jun-2019.)
theorem eqvrelcl (ph: wff) (A2 B2 R: class):
  $ wi ph (weqvrel R) $ >
  $ wi ph (wbr A2 B2 R) $ >
  $ wi ph (wcel A2 (cdm R)) $;

--| Basic property of equivalence relations. Part of Lemma 3N of [Enderton] p. 57. (Contributed by NM, 30-Jul-1995.) (Revised by Mario Carneiro, 9-Jul-2014.) (Revised by Peter Mazsa, 2-Jun-2019.)
theorem eqvrelthi (ph: wff) (A2 B2 R: class):
  $ wi ph (weqvrel R) $ >
  $ wi ph (wbr A2 B2 R) $ >
  $ wi ph (wceq (cec A2 R) (cec B2 R)) $;

--| Equivalence classes do not overlap. In other words, two equivalence classes are either equal or disjoint. Theorem 74 of [Suppes] p. 83. (Contributed by NM, 15-Jun-2004.) (Revised by Mario Carneiro, 9-Jul-2014.) (Revised by Peter Mazsa, 2-Jun-2019.)
theorem eqvreldisj (A2 B2 R: class):
  $ wi (weqvrel R) (wo (wceq (cec A2 R) (cec B2 R)) (wceq (cin (cec A2 R) (cec B2 R)) c0)) $;

--| Elements of a quotient set do not overlap. (Contributed by Rodolfo Medina, 12-Oct-2010.) (Revised by Mario Carneiro, 11-Jul-2014.) (Revised by Peter Mazsa, 3-Jun-2019.)
theorem qsdisjALTV (ph: wff) (A2 B2 C R: class):
  $ wi ph (weqvrel R) $ >
  $ wi ph (wcel B2 (cqs A2 R)) $ >
  $ wi ph (wcel C (cqs A2 R)) $ >
  $ wi ph (wo (wceq B2 C) (wceq (cin B2 C) c0)) $;

--| If an element of a quotient set contains a given element, it is equal to the equivalence class of the element. (Contributed by Mario Carneiro, 12-Aug-2015.) (Revised by Peter Mazsa, 28-Dec-2019.)
theorem eqvrelqsel (A2 B2 C R: class):
  $ wi (w3a (weqvrel R) (wcel B2 (cqs A2 R)) (wcel C B2)) (wceq B2 (cec C R)) $;

--| Two ways to express equivalent cosets. (Contributed by Peter Mazsa, 4-Jul-2020.) (Revised by Peter Mazsa, 20-Dec-2021.)
theorem eqvrelcoss (R: class):
  $ wb (weqvrel (ccoss R)) (wtrrel (ccoss R)) $;

--| Two ways to express equivalent cosets. (Contributed by Peter Mazsa, 28-Apr-2019.)
theorem eqvrelcoss3 {x3 y1 z: setvar} (R: class):
  $ wb (weqvrel (ccoss R)) (wal x3 (wal y1 (wal z (wi (wa (wbr (cv x3) (cv y1) (ccoss R)) (wbr (cv y1) (cv z) (ccoss R))) (wbr (cv x3) (cv z) (ccoss R)))))) $;

--| Two ways to express equivalent cosets. (Contributed by Peter Mazsa, 3-May-2019.)
theorem eqvrelcoss2 (R: class):
  $ wb (weqvrel (ccoss R)) (wss (ccoss (ccoss R)) (ccoss R)) $;

--| Two ways to express equivalent cosets. (Contributed by Peter Mazsa, 3-May-2019.) (Revised by Peter Mazsa, 30-Sep-2021.)
theorem eqvrelcoss4 {x3 z: setvar} (R: class):
  $ wb (weqvrel (ccoss R)) (wal x3 (wal z (wi (wne (cin (cec (cv x3) (ccoss R)) (cec (cv z) (ccoss R))) c0) (wne (cin (cec (cv x3) (ccnv R)) (cec (cv z) (ccnv R))) c0)))) $;

--| Alternate definition of the coelement equivalence relations class. Other alternate definitions should be based on ~ eqvrelcoss2 , ~ eqvrelcoss3 and ~ eqvrelcoss4 when needed. (Contributed by Peter Mazsa, 28-Nov-2022.)
theorem dfcoeleqvrels {a: setvar}:
  $ wceq ccoeleqvrels (cab a (wcel (ccoels (cv a)) ceqvrels)) $;

--| Alternate definition of the coelement equivalence relation predicate: a coelement equivalence relation is an equivalence relation on coelements. Other alternate definitions should be based on ~ eqvrelcoss2 , ~ eqvrelcoss3 and ~ eqvrelcoss4 when needed. (Contributed by Peter Mazsa, 28-Nov-2022.)
theorem dfcoeleqvrel (A2: class):
  $ wb (wcoeleqvrel A2) (weqvrel (ccoels A2)) $;

--| Define the class of all redundant sets ` x ` with respect to ` y ` in ` z ` . For sets, binary relation on the class of all redundant sets ( ~ brredunds ) is equivalent to satisfying the redundancy predicate ( ~ df-redund ). (Contributed by Peter Mazsa, 23-Oct-2022.)
axiom df_redunds {x3 y1 z: setvar}:
  $ wceq credunds (ccnv (coprab y1 z x3 (wa (wss (cv x3) (cv y1)) (wceq (cin (cv x3) (cv z)) (cin (cv y1) (cv z)))))) $;

--| Define the redundancy predicate. Read: ` A ` is redundant with respect to ` B ` in ` C ` . For sets, binary relation on the class of all redundant sets ( ~ brredunds ) is equivalent to satisfying the redundancy predicate. (Contributed by Peter Mazsa, 23-Oct-2022.)
axiom df_redund (A2 B2 C: class):
  $ wb (wredund A2 B2 C) (wa (wss A2 B2) (wceq (cin A2 C) (cin B2 C))) $;

--| Define the redundancy operator for propositions, cf. ~ df-redund . (Contributed by Peter Mazsa, 23-Oct-2022.)
axiom df_redundp (ph ps ch: wff):
  $ wb (wredundp ph ps ch) (wa (wi ph ps) (wb (wa ph ch) (wa ps ch))) $;

--| Binary relation on the class of all redundant sets. (Contributed by Peter Mazsa, 25-Oct-2022.)
theorem brredunds (A2 B2 C V W X: class):
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel C X)) (wb (wbr A2 (cop B2 C) credunds) (wa (wss A2 B2) (wceq (cin A2 C) (cin B2 C)))) $;

--| For sets, binary relation on the class of all redundant sets ( ~ brredunds ) is equivalent to satisfying the redundancy predicate ( ~ df-redund ). (Contributed by Peter Mazsa, 25-Oct-2022.)
theorem brredundsredund (A2 B2 C V W X: class):
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel C X)) (wb (wbr A2 (cop B2 C) credunds) (wredund A2 B2 C)) $;

--| Implication of redundancy predicate. (Contributed by Peter Mazsa, 26-Oct-2022.)
theorem redundss3 (A2 B2 C D: class):
  $ wss D C $ >
  $ wi (wredund A2 B2 C) (wredund A2 B2 D) $;

--| Equivalence of redundancy predicates. (Contributed by Peter Mazsa, 26-Oct-2022.)
theorem redundeq1 (A2 B2 C D: class):
  $ wceq A2 D $ >
  $ wb (wredund A2 B2 C) (wredund D B2 C) $;

--| Implication of redundancy of proposition. (Contributed by Peter Mazsa, 26-Oct-2022.)
theorem redundpim3 (ph ps ch th: wff):
  $ wi th ch $ >
  $ wi (wredundp ph ps ch) (wredundp ph ps th) $;

--| Equivalence of redundancy of propositions. (Contributed by Peter Mazsa, 25-Oct-2022.)
theorem redundpbi1 (ph ps ch th: wff):
  $ wb ph th $ >
  $ wb (wredundp ph ps ch) (wredundp th ps ch) $;

--| The naive version of the class of reflexive relations is redundant with respect to the class of reflexive relations (see ~ dfrefrels2 ) if the relations are symmetric as well. (Contributed by Peter Mazsa, 26-Oct-2022.)
theorem refrelsredund4 {r: setvar}:
  $ wredund (crab r (wss (cres cid (cdm (cv r))) (cv r)) crels) crefrels (cin crefrels csymrels) $;

--| The naive version of the class of reflexive relations is redundant with respect to the class of reflexive relations (see ~ dfrefrels2 ) in the class of equivalence relations. (Contributed by Peter Mazsa, 26-Oct-2022.)
theorem refrelsredund2 {r: setvar}:
  $ wredund (crab r (wss (cres cid (cdm (cv r))) (cv r)) crels) crefrels ceqvrels $;

--| The naive version of the class of reflexive relations ` { r e. Rels | A. x e. dom r x r x } ` is redundant with respect to the class of reflexive relations (see ~ dfrefrels3 ) in the class of equivalence relations. (Contributed by Peter Mazsa, 26-Oct-2022.)
theorem refrelsredund3 {x3 r: setvar}:
  $ wredund (crab r (wral x3 (wbr (cv x3) (cv x3) (cv r)) (cdm (cv r))) crels) crefrels ceqvrels $;

--| The naive version of the definition of reflexive relation is redundant with respect to reflexive relation (see ~ dfrefrel2 ) if the relation is symmetric as well. (Contributed by Peter Mazsa, 26-Oct-2022.)
theorem refrelredund4 (R: class):
  $ wredundp (wa (wss (cres cid (cdm R)) R) (wrel R)) (wrefrel R) (wa (wrefrel R) (wsymrel R)) $;

--| The naive version of the definition of reflexive relation is redundant with respect to reflexive relation (see ~ dfrefrel2 ) in equivalence relation. (Contributed by Peter Mazsa, 25-Oct-2022.)
theorem refrelredund2 (R: class):
  $ wredundp (wa (wss (cres cid (cdm R)) R) (wrel R)) (wrefrel R) (weqvrel R) $;

--| The naive version of the definition of reflexive relation ` ( A. x e. dom R x R x /\ Rel R ) ` is redundant with respect to reflexive relation (see ~ dfrefrel3 ) in equivalence relation. (Contributed by Peter Mazsa, 25-Oct-2022.)
theorem refrelredund3 {x3: setvar} (R: class):
  $ wredundp (wa (wral x3 (wbr (cv x3) (cv x3) R) (cdm R)) (wrel R)) (wrefrel R) (weqvrel R) $;

--| Define the class of domain quotients. Domain quotients are pairs of sets, typically a relation and a set, where the quotient (see ~ df-qs ) of the relation on its domain is equal to the set. See comments of ~ df-ers for the motivation for this definition. (Contributed by Peter Mazsa, 16-Apr-2019.)
axiom df_dmqss {x3 y1: setvar}:
  $ wceq cdmqss (copab x3 y1 (wceq (cqs (cdm (cv x3)) (cv x3)) (cv y1))) $;

--| Define the domain quotient predicate. (Read: the domain quotient of ` R ` is ` A ` .) If ` A ` and ` R ` are sets, the domain quotient binary relation and the domain quotient predicate are the same, see ~ brdmqssqs . (Contributed by Peter Mazsa, 9-Aug-2021.)
axiom df_dmqs (A2 R: class):
  $ wb (wdmqs A2 R) (wceq (cqs (cdm R) R) A2) $;

--| Equality theorem for domain quotient. (Contributed by Peter Mazsa, 17-Apr-2019.)
theorem dmqseq (R S: class):
  $ wi (wceq R S) (wceq (cqs (cdm R) R) (cqs (cdm S) S)) $;

--| Equality theorem for domain quotient, inference version. (Contributed by Peter Mazsa, 26-Sep-2021.)
theorem dmqseqi (R S: class):
  $ wceq R S $ >
  $ wceq (cqs (cdm R) R) (cqs (cdm S) S) $;

--| Equality theorem for domain quotient set, deduction version. (Contributed by Peter Mazsa, 23-Apr-2021.)
theorem dmqseqd (ph: wff) (R S: class):
  $ wi ph (wceq R S) $ >
  $ wi ph (wceq (cqs (cdm R) R) (cqs (cdm S) S)) $;

--| Equality theorem for domain quotient. (Contributed by Peter Mazsa, 17-Apr-2019.)
theorem dmqseqeq1 (A2 R S: class):
  $ wi (wceq R S) (wb (wceq (cqs (cdm R) R) A2) (wceq (cqs (cdm S) S) A2)) $;

--| Equality theorem for domain quotient, inference version. (Contributed by Peter Mazsa, 26-Sep-2021.)
theorem dmqseqeq1i (A2 R S: class):
  $ wceq R S $ >
  $ wb (wceq (cqs (cdm R) R) A2) (wceq (cqs (cdm S) S) A2) $;

--| Equality theorem for domain quotient set, deduction version. (Contributed by Peter Mazsa, 26-Sep-2021.)
theorem dmqseqeq1d (ph: wff) (A2 R S: class):
  $ wi ph (wceq R S) $ >
  $ wi ph (wb (wceq (cqs (cdm R) R) A2) (wceq (cqs (cdm S) S) A2)) $;

--| The domain quotient binary relation. (Contributed by Peter Mazsa, 17-Apr-2019.)
theorem brdmqss (A2 R V W: class):
  $ wi (wa (wcel A2 V) (wcel R W)) (wb (wbr R A2 cdmqss) (wceq (cqs (cdm R) R) A2)) $;

--| If ` A ` and ` R ` are sets, the domain quotient binary relation and the domain quotient predicate are the same. (Contributed by Peter Mazsa, 14-Aug-2021.)
theorem brdmqssqs (A2 R V W: class):
  $ wi (wa (wcel A2 V) (wcel R W)) (wb (wbr R A2 cdmqss) (wdmqs A2 R)) $;

--| The empty set is not an element of a domain quotient. (Contributed by Peter Mazsa, 2-Mar-2018.)
theorem n0eldmqs (R: class):
  $ wn (wcel c0 (cqs (cdm R) R)) $;

--| The quotient set equal to a class. This theorem is used when a class ` A ` is identified with a quotient ` ( dom R /. R ) ` . In such a situation, every element ` u e. A ` is an ` R `-coset ` [ v ] R ` for some ` v e. dom R ` , but there is no requirement that the "witness" ` v ` be equal to its own block ` [ v ] R ` . ` A ` is a set of blocks (equivalence classes), not a set of raw witnesses. In particular, when ` ( dom R /. R ) = A ` is read together with a partition hypothesis ` R Part A ` (defined as ~ dfpart2 ), ` A ` is being treated as the set of blocks ` [ v ] R ` ; it does not assert any fixed-point condition ` v = [ v ] R ` such as would arise from the mistaken reading ` u e. A <-> u = [ u ] R ` . Cf. ~ dmqsblocks . (Contributed by Peter Mazsa, 19-Oct-2018.)
theorem qseq {v u: setvar} (A2: class v) (B2 R: class):
  $ wb (wceq (cqs B2 R) A2) (wal u (wb (wcel (cv u) A2) (wrex v (wceq (cv u) (cec (cv v) R)) B2))) $;

--| The empty set is not an element of a domain quotient. (Contributed by Peter Mazsa, 3-Nov-2018.)
theorem n0eldmqseq (A2 R: class):
  $ wi (wceq (cqs (cdm R) R) A2) (wn (wcel c0 A2)) $;

--| Implication of that the empty set is not an element of a class. (Contributed by Peter Mazsa, 30-Dec-2024.)
theorem n0elim (A2: class):
  $ wi (wn (wcel c0 A2)) (wceq (cqs (cdm (cres (ccnv cep) A2)) (cres (ccnv cep) A2)) A2) $;

--| Two ways of expressing that the empty set is not an element of a class. (Contributed by Peter Mazsa, 27-May-2021.)
theorem n0el3 (A2: class):
  $ wb (wn (wcel c0 A2)) (wceq (cqs (cdm (cres (ccnv cep) A2)) (cres (ccnv cep) A2)) A2) $;

--| The domain quotient binary relation of the restricted converse epsilon relation is equivalent to the negated elementhood of the empty set in the restriction. (Contributed by Peter Mazsa, 14-Aug-2021.)
theorem cnvepresdmqss (A2 V: class):
  $ wi (wcel A2 V) (wb (wbr (cres (ccnv cep) A2) A2 cdmqss) (wn (wcel c0 A2))) $;

--| The domain quotient predicate for the restricted converse epsilon relation is equivalent to the negated elementhood of the empty set in the restriction. (Contributed by Peter Mazsa, 14-Aug-2021.)
theorem cnvepresdmqs (A2: class):
  $ wb (wdmqs A2 (cres (ccnv cep) A2)) (wn (wcel c0 A2)) $;

--| The range of a relation is equal to the union of the domain quotient. (Contributed by Peter Mazsa, 13-Oct-2018.)
theorem unidmqs (R V: class):
  $ wi (wcel R V) (wi (wrel R) (wceq (cuni (cqs (cdm R) R)) (crn R))) $;

--| The union of the domain quotient of a relation is equal to the class ` A ` if and only if the range is equal to it as well. (Contributed by Peter Mazsa, 21-Apr-2019.) (Revised by Peter Mazsa, 28-Dec-2021.)
theorem unidmqseq (A2 R V: class):
  $ wi (wcel R V) (wi (wrel R) (wb (wceq (cuni (cqs (cdm R) R)) A2) (wceq (crn R) A2))) $;

--| If the domain quotient of a relation is equal to the class ` A ` , then the range of the relation is the union of the class. (Contributed by Peter Mazsa, 29-Dec-2021.)
theorem dmqseqim (A2 R V: class):
  $ wi (wcel R V) (wi (wrel R) (wi (wceq (cqs (cdm R) R) A2) (wceq (crn R) (cuni A2)))) $;

--| Lemma for ~ erimeq2 . (Contributed by Peter Mazsa, 29-Dec-2021.)
theorem dmqseqim2 (A2 B2 R V: class):
  $ wi (wcel R V) (wi (wrel R) (wi (wceq (cqs (cdm R) R) A2) (wb (wcel B2 (crn R)) (wcel B2 (cuni A2))))) $;

--| Elementhood in the domain quotient of a relation. (Contributed by Peter Mazsa, 24-Apr-2021.)
theorem releldmqs {x3 u: setvar} (A2 R: class) (V: class x3 u):
  $ wi (wcel A2 V) (wi (wrel R) (wb (wcel A2 (cqs (cdm R) R)) (wrex u (wrex x3 (wceq A2 (cec (cv u) R)) (cec (cv u) R)) (cdm R)))) $;

--| Elementhood in the domain quotient of the class of cosets by a restriction. (Contributed by Peter Mazsa, 4-May-2019.)
theorem eldmqs1cossres {x3 u: setvar} (A2 B2 R: class) (V: class x3 u):
  $ wi (wcel B2 V) (wb (wcel B2 (cqs (cdm (ccoss (cres R A2))) (ccoss (cres R A2)))) (wrex u (wrex x3 (wceq B2 (cec (cv x3) (ccoss (cres R A2)))) (cec (cv u) R)) A2)) $;

--| Elementhood in the domain quotient of the class of cosets by a relation. (Contributed by Peter Mazsa, 23-Apr-2021.)
theorem releldmqscoss {x3 u: setvar} (A2 R: class) (V: class x3 u):
  $ wi (wcel A2 V) (wi (wrel R) (wb (wcel A2 (cqs (cdm (ccoss R)) (ccoss R))) (wrex u (wrex x3 (wceq A2 (cec (cv x3) (ccoss R))) (cec (cv u) R)) (cdm R)))) $;

--| Two ways to express the equality of the domain quotient of the coelements on the class ` A ` with the class ` A ` . (Contributed by Peter Mazsa, 26-Sep-2021.)
theorem dmqscoelseq (A2: class):
  $ wb (wceq (cqs (cdm (ccoels A2)) (ccoels A2)) A2) (wceq (cqs (cuni A2) (ccoels A2)) A2) $;

--| Two ways to express the equality of the domain quotient of the coelements on the class ` A ` with the class ` A ` . (Contributed by Peter Mazsa, 26-Sep-2021.)
theorem dmqs1cosscnvepreseq (A2: class):
  $ wb (wceq (cqs (cdm (ccoss (cres (ccnv cep) A2))) (ccoss (cres (ccnv cep) A2))) A2) (wceq (cqs (cuni A2) (ccoels A2)) A2) $;

--| Define the class of equivalence relations on domain quotients (or: domain quotients restricted to equivalence relations). The present definition of equivalence relation in set.mm ~ df-er "is not standard", "somewhat cryptic", has no constant 0-ary class and does not follow the traditional transparent reflexive-symmetric-transitive relation way of definition of equivalence. Definitions ~ df-eqvrels , ~ dfeqvrels2 , ~ dfeqvrels3 and ~ df-eqvrel , ~ dfeqvrel2 , ~ dfeqvrel3 are fully transparent in this regard. However, they lack the domain component ( ` dom R = A ` ) of the present ~ df-er . While we acknowledge the need of a domain component, the present ~ df-er definition does not utilize the results revealed by the new theorems in the Partition-Equivalence Theorem part below (like ~ pets and ~ pet ). From those theorems follows that the natural domain of equivalence relations is not ` R Domain A ` (i.e. ` dom R = A ` see ~ brdomaing ), but ` R DomainQss A ` (i.e. ` ( dom R /. R ) = A ` , see ~ brdmqss ), see ~ erimeq vs. ~ prter3 . While I'm sure we need both equivalence relation ~ df-eqvrels and equivalence relation on domain quotient ~ df-ers , I'm not sure whether we need a third equivalence relation concept with the present ` dom R = A ` component as well: this needs further investigation. As a default I suppose that these two concepts ~ df-eqvrels and ~ df-ers are enough and named the predicate version of the one on domain quotient as the alternate version ~ df-erALTV of the present ~ df-er . (Contributed by Peter Mazsa, 26-Jun-2021.)
axiom df_ers:
  $ wceq cers (cres cdmqss ceqvrels) $;

--| Equivalence relation with natural domain predicate, see also the comment of ~ df-ers . Alternate definition is ~ dferALTV2 . Binary equivalence relation with natural domain and the equivalence relation with natural domain predicate are the same when ` A ` and ` R ` are sets, see ~ brerser . (Contributed by Peter Mazsa, 12-Aug-2021.)
axiom df_erALTV (A2 R: class):
  $ wb (werALTV A2 R) (wa (weqvrel R) (wdmqs A2 R)) $;

--| Define the class of comember equivalence relations on their domain quotients. (Contributed by Peter Mazsa, 28-Nov-2022.) (Revised by Peter Mazsa, 24-Jul-2023.)
axiom df_comembers {a: setvar}:
  $ wceq ccomembers (cab a (wbr (ccoss (cres (ccnv cep) (cv a))) (cv a) cers)) $;

--| Define the comember equivalence relation on the class ` A ` (or, the restricted coelement equivalence relation on its domain quotient ` A ` .) Alternate definitions are ~ dfcomember2 and ~ dfcomember3 . Later on, in an application of set theory I make a distinction between the default elementhood concept and a special membership concept: membership equivalence relation will be an integral part of that membership concept. (Contributed by Peter Mazsa, 26-Jun-2021.) (Revised by Peter Mazsa, 28-Nov-2022.)
axiom df_comember (A2: class):
  $ wb (wcomember A2) (werALTV A2 (ccoss (cres (ccnv cep) A2))) $;

--| Binary equivalence relation with natural domain, see the comment of ~ df-ers . (Contributed by Peter Mazsa, 23-Jul-2021.)
theorem brers (A2 R V: class):
  $ wi (wcel A2 V) (wb (wbr R A2 cers) (wa (wcel R ceqvrels) (wbr R A2 cdmqss))) $;

--| Equivalence relation with natural domain predicate, see the comment of ~ df-ers . (Contributed by Peter Mazsa, 26-Jun-2021.) (Revised by Peter Mazsa, 30-Aug-2021.)
theorem dferALTV2 (A2 R: class):
  $ wb (werALTV A2 R) (wa (weqvrel R) (wceq (cqs (cdm R) R) A2)) $;

--| Equality theorem for equivalence relation on domain quotient. (Contributed by Peter Mazsa, 25-Sep-2021.)
theorem erALTVeq1 (A2 R S: class):
  $ wi (wceq R S) (wb (werALTV A2 R) (werALTV A2 S)) $;

--| Equality theorem for equivalence relation on domain quotient, inference version. (Contributed by Peter Mazsa, 25-Sep-2021.)
theorem erALTVeq1i (A2 R S: class):
  $ wceq R S $ >
  $ wb (werALTV A2 R) (werALTV A2 S) $;

--| Equality theorem for equivalence relation on domain quotient, deduction version. (Contributed by Peter Mazsa, 25-Sep-2021.)
theorem erALTVeq1d (ph: wff) (A2 R S: class):
  $ wi ph (wceq R S) $ >
  $ wi ph (wb (werALTV A2 R) (werALTV A2 S)) $;

--| Alternate definition of the comember equivalence relation. (Contributed by Peter Mazsa, 28-Nov-2022.)
theorem dfcomember (A2: class):
  $ wb (wcomember A2) (werALTV A2 (ccoels A2)) $;

--| Alternate definition of the comember equivalence relation. (Contributed by Peter Mazsa, 25-Sep-2021.)
theorem dfcomember2 (A2: class):
  $ wb (wcomember A2) (wa (weqvrel (ccoels A2)) (wceq (cqs (cdm (ccoels A2)) (ccoels A2)) A2)) $;

--| Alternate definition of the comember equivalence relation. (Contributed by Peter Mazsa, 26-Sep-2021.) (Revised by Peter Mazsa, 17-Jul-2023.)
theorem dfcomember3 (A2: class):
  $ wb (wcomember A2) (wa (wcoeleqvrel A2) (wceq (cqs (cuni A2) (ccoels A2)) A2)) $;

--| Two ways to express comember equivalence relation on its domain quotient. (Contributed by Peter Mazsa, 26-Sep-2021.) (Revised by Peter Mazsa, 17-Jul-2023.)
theorem eqvreldmqs (A2: class):
  $ wb (wa (weqvrel (ccoss (cres (ccnv cep) A2))) (wceq (cqs (cdm (ccoss (cres (ccnv cep) A2))) (ccoss (cres (ccnv cep) A2))) A2)) (wa (wcoeleqvrel A2) (wceq (cqs (cuni A2) (ccoels A2)) A2)) $;

--| Two ways to express comember equivalence relation on its domain quotient. (Contributed by Peter Mazsa, 30-Dec-2024.)
theorem eqvreldmqs2 (A2: class):
  $ wb (wa (weqvrel (ccoss (cres (ccnv cep) A2))) (wceq (cqs (cdm (ccoss (cres (ccnv cep) A2))) (ccoss (cres (ccnv cep) A2))) A2)) (wa (weqvrel (ccoels A2)) (wceq (cqs (cuni A2) (ccoels A2)) A2)) $;

--| Binary equivalence relation with natural domain and the equivalence relation with natural domain predicate are the same when ` A ` and ` R ` are sets. (Contributed by Peter Mazsa, 25-Aug-2021.)
theorem brerser (A2 R V W: class):
  $ wi (wa (wcel A2 V) (wcel R W)) (wb (wbr R A2 cers) (werALTV A2 R)) $;

--| Equivalence relation on its natural domain implies that the class of coelements on the domain is equal to the relation (this is ~ prter3 in a more convenient form , see also ~ erimeq ). (Contributed by Rodolfo Medina, 19-Oct-2010.) (Proof shortened by Mario Carneiro, 12-Aug-2015.) (Revised by Peter Mazsa, 29-Dec-2021.)
theorem erimeq2 (A2 R V: class):
  $ wi (wcel R V) (wi (wa (weqvrel R) (wceq (cqs (cdm R) R) A2)) (wceq (ccoels A2) R)) $;

--| Equivalence relation on its natural domain implies that the class of coelements on the domain is equal to the relation (this is the most convenient form of ~ prter3 and ~ erimeq2 ). (Contributed by Peter Mazsa, 7-Oct-2021.) (Revised by Peter Mazsa, 29-Dec-2021.)
theorem erimeq (A2 R V: class):
  $ wi (wcel R V) (wi (werALTV A2 R) (wceq (ccoels A2) R)) $;

--| Define the class of all function sets (but not necessarily function relations, cf. ~ df-funsALTV ). It is used only by ~ df-funsALTV . (Contributed by Peter Mazsa, 17-Jul-2021.)
axiom df_funss {x3: setvar}:
  $ wceq cfunss (cab x3 (wcel (ccoss (cv x3)) ccnvrefrels)) $;

--| Define the function relations class, i.e., the class of functions. Alternate definitions are ~ dffunsALTV , ... , ~ dffunsALTV5 . (Contributed by Peter Mazsa, 17-Jul-2021.)
axiom df_funsALTV:
  $ wceq cfunsALTV (cin cfunss crels) $;

--| Define the function relation predicate, i.e., the function predicate. This definition of the function predicate (based on a more general, converse reflexive, relation) and the original definition of function in set.mm ~ df-fun , are always the same, that is ` ( FunALTV F <-> Fun F ) ` , see ~ funALTVfun . The element of the class of functions and the function predicate are the same, that is ` ( F e. FunsALTV <-> FunALTV F ) ` when ` F ` is a set, see ~ elfunsALTVfunALTV . Alternate definitions are ~ dffunALTV2 , ... , ~ dffunALTV5 . (Contributed by Peter Mazsa, 17-Jul-2021.)
axiom df_funALTV (F: class):
  $ wb (wfunALTV F) (wa (wcnvrefrel (ccoss F)) (wrel F)) $;

--| Alternate definition of the class of functions. (Contributed by Peter Mazsa, 18-Jul-2021.)
theorem dffunsALTV {f2: setvar}:
  $ wceq cfunsALTV (crab f2 (wcel (ccoss (cv f2)) ccnvrefrels) crels) $;

--| Alternate definition of the class of functions. (Contributed by Peter Mazsa, 30-Aug-2021.)
theorem dffunsALTV2 {f2: setvar}:
  $ wceq cfunsALTV (crab f2 (wss (ccoss (cv f2)) cid) crels) $;

--| Alternate definition of the class of functions. For the ` X ` axis and the ` Y ` axis you can convert the right side to ` { f e. Rels | A. ` x1 ` A. ` y1 ` A. ` y2 ` ( ( ` x1 ` f ` y1 ` /\ ` x1 ` f ` y2 ` ) -> ` y1 ` = ` y2 ` ) } ` . (Contributed by Peter Mazsa, 30-Aug-2021.)
theorem dffunsALTV3 {x3 y1 u f2: setvar}:
  $ wceq cfunsALTV (crab f2 (wal u (wal x3 (wal y1 (wi (wa (wbr (cv u) (cv x3) (cv f2)) (wbr (cv u) (cv y1) (cv f2))) (wceq (cv x3) (cv y1)))))) crels) $;

--| Alternate definition of the class of functions. For the ` X ` axis and the ` Y ` axis you can convert the right side to ` { f e. Rels | A. x1 E* y1 x1 f y1 } ` . (Contributed by Peter Mazsa, 31-Aug-2021.)
theorem dffunsALTV4 {x3 u f2: setvar}:
  $ wceq cfunsALTV (crab f2 (wal u (wmo x3 (wbr (cv u) (cv x3) (cv f2)))) crels) $;

--| Alternate definition of the class of functions. (Contributed by Peter Mazsa, 31-Aug-2021.)
theorem dffunsALTV5 {x3 y1 f2: setvar}:
  $ wceq cfunsALTV (crab f2 (wral x3 (wral y1 (wo (wceq (cv x3) (cv y1)) (wceq (cin (cec (cv x3) (ccnv (cv f2))) (cec (cv y1) (ccnv (cv f2)))) c0)) (crn (cv f2))) (crn (cv f2))) crels) $;

--| Alternate definition of the function relation predicate, cf. ~ dfdisjALTV2 . (Contributed by Peter Mazsa, 8-Feb-2018.)
theorem dffunALTV2 (F: class):
  $ wb (wfunALTV F) (wa (wss (ccoss F) cid) (wrel F)) $;

--| Alternate definition of the function relation predicate, cf. ~ dfdisjALTV3 . Reproduction of ~ dffun2 . For the ` X ` axis and the ` Y ` axis you can convert the right side to ` ( A. ` x1 ` A. ` y1 ` A. ` y2 ` ( ( ` x1 ` f ` y1 ` /\ ` x1 ` f ` y2 ` ) -> ` y1 ` = ` y2 ` ) /\ Rel F ) ` . (Contributed by NM, 29-Dec-1996.)
theorem dffunALTV3 {x3 y1 u: setvar} (F: class):
  $ wb (wfunALTV F) (wa (wal u (wal x3 (wal y1 (wi (wa (wbr (cv u) (cv x3) F) (wbr (cv u) (cv y1) F)) (wceq (cv x3) (cv y1)))))) (wrel F)) $;

--| Alternate definition of the function relation predicate, cf. ~ dfdisjALTV4 . This is ~ dffun6 . For the ` X ` axis and the ` Y ` axis you can convert the right side to ` ( A. x1 E* y1 x1 F y1 /\ Rel F ) ` . (Contributed by NM, 9-Mar-1995.)
theorem dffunALTV4 {x3 u: setvar} (F: class):
  $ wb (wfunALTV F) (wa (wal u (wmo x3 (wbr (cv u) (cv x3) F))) (wrel F)) $;

--| Alternate definition of the function relation predicate, cf. ~ dfdisjALTV5 . (Contributed by Peter Mazsa, 5-Sep-2021.)
theorem dffunALTV5 {x3 y1: setvar} (F: class):
  $ wb (wfunALTV F) (wa (wral x3 (wral y1 (wo (wceq (cv x3) (cv y1)) (wceq (cin (cec (cv x3) (ccnv F)) (cec (cv y1) (ccnv F))) c0)) (crn F)) (crn F)) (wrel F)) $;

--| Elementhood in the class of functions. (Contributed by Peter Mazsa, 24-Jul-2021.)
theorem elfunsALTV (F: class):
  $ wb (wcel F cfunsALTV) (wa (wcel (ccoss F) ccnvrefrels) (wcel F crels)) $;

--| Elementhood in the class of functions. (Contributed by Peter Mazsa, 31-Aug-2021.)
theorem elfunsALTV2 (F: class):
  $ wb (wcel F cfunsALTV) (wa (wss (ccoss F) cid) (wcel F crels)) $;

--| Elementhood in the class of functions. (Contributed by Peter Mazsa, 31-Aug-2021.)
theorem elfunsALTV3 {x3 y1 u: setvar} (F: class):
  $ wb (wcel F cfunsALTV) (wa (wal u (wal x3 (wal y1 (wi (wa (wbr (cv u) (cv x3) F) (wbr (cv u) (cv y1) F)) (wceq (cv x3) (cv y1)))))) (wcel F crels)) $;

--| Elementhood in the class of functions. (Contributed by Peter Mazsa, 31-Aug-2021.)
theorem elfunsALTV4 {x3 u: setvar} (F: class):
  $ wb (wcel F cfunsALTV) (wa (wal u (wmo x3 (wbr (cv u) (cv x3) F))) (wcel F crels)) $;

--| Elementhood in the class of functions. (Contributed by Peter Mazsa, 5-Sep-2021.)
theorem elfunsALTV5 {x3 y1: setvar} (F: class):
  $ wb (wcel F cfunsALTV) (wa (wral x3 (wral y1 (wo (wceq (cv x3) (cv y1)) (wceq (cin (cec (cv x3) (ccnv F)) (cec (cv y1) (ccnv F))) c0)) (crn F)) (crn F)) (wcel F crels)) $;

--| The element of the class of functions and the function predicate are the same when ` F ` is a set. (Contributed by Peter Mazsa, 26-Jul-2021.)
theorem elfunsALTVfunALTV (F V: class):
  $ wi (wcel F V) (wb (wcel F cfunsALTV) (wfunALTV F)) $;

--| Our definition of the function predicate ~ df-funALTV (based on a more general, converse reflexive, relation) and the original definition of function in set.mm ~ df-fun , are always the same and interchangeable. (Contributed by Peter Mazsa, 27-Jul-2021.)
theorem funALTVfun (F: class):
  $ wb (wfunALTV F) (wfun F) $;

--| Subclass theorem for function. (Contributed by NM, 16-Aug-1994.) (Proof shortened by Mario Carneiro, 24-Jun-2014.) (Revised by Peter Mazsa, 22-Sep-2021.)
theorem funALTVss (A2 B2: class):
  $ wi (wss A2 B2) (wi (wfunALTV B2) (wfunALTV A2)) $;

--| Equality theorem for function predicate. (Contributed by NM, 16-Aug-1994.)
theorem funALTVeq (A2 B2: class):
  $ wi (wceq A2 B2) (wb (wfunALTV A2) (wfunALTV B2)) $;

--| Equality inference for the function predicate. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.)
theorem funALTVeqi (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wb (wfunALTV A2) (wfunALTV B2) $;

--| Equality deduction for the function predicate. (Contributed by NM, 23-Feb-2013.)
theorem funALTVeqd (ph: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wfunALTV A2) (wfunALTV B2)) $;

--| Define the class of all disjoint sets (but not necessarily disjoint relations, cf. ~ df-disjs ). It is used only by ~ df-disjs . (Contributed by Peter Mazsa, 17-Jul-2021.)
axiom df_disjss {x3: setvar}:
  $ wceq cdisjss (cab x3 (wcel (ccoss (ccnv (cv x3))) ccnvrefrels)) $;

--| Define the disjoint relations class, i.e., the class of disjoints. We need ` Disjs ` for the definition of Parts and Part for the Partition-Equivalence Theorems: this need for Parts as disjoint relations on their domain quotients is the reason why we must define ` Disjs ` instead of simply using converse functions (cf. ~ dfdisjALTV ). The element of the class of disjoints and the disjoint predicate are the same, that is ` ( R e. Disjs <-> Disj R ) ` when ` R ` is a set, see ~ eldisjsdisj . Alternate definitions are ~ dfdisjs , ... , ~ dfdisjs5 . (Contributed by Peter Mazsa, 17-Jul-2021.)
axiom df_disjs:
  $ wceq cdisjs (cin cdisjss crels) $;

--| Define the disjoint relation predicate, i.e., the disjoint predicate. A disjoint relation is a converse function of the relation by ~ dfdisjALTV , see the comment of ~ df-disjs why we need disjoint relations instead of converse functions anyway. The element of the class of disjoints and the disjoint predicate are the same, that is ` ( R e. Disjs <-> Disj R ) ` when ` R ` is a set, see ~ eldisjsdisj . Alternate definitions are ~ dfdisjALTV , ... , ~ dfdisjALTV5 . (Contributed by Peter Mazsa, 17-Jul-2021.)
axiom df_disjALTV (R: class):
  $ wb (wdisjALTV R) (wa (wcnvrefrel (ccoss (ccnv R))) (wrel R)) $;

--| Define the disjoint element relations class, i.e., the disjoint elements class. The element of the disjoint elements class and the disjoint elementhood predicate are the same, that is ` ( A e. ElDisjs <-> ElDisj A ) ` when ` A ` is a set, see ~ eleldisjseldisj . (Contributed by Peter Mazsa, 28-Nov-2022.)
axiom df_eldisjs {a: setvar}:
  $ wceq celdisjs (cab a (wcel (cres (ccnv cep) (cv a)) cdisjs)) $;

--| Define the disjoint element relation predicate, i.e., the disjoint elementhood predicate. Read: the elements of ` A ` are disjoint. The element of the disjoint elements class and the disjoint elementhood predicate are the same, that is ` ( A e. ElDisjs <-> ElDisj A ) ` when ` A ` is a set, see ~ eleldisjseldisj . As of now, disjoint elementhood is defined as "partition" in set.mm : compare ~ df-prt with ~ dfeldisj5 . See also the comments of ~ dfmembpart2 and of ~ df-parts . (Contributed by Peter Mazsa, 17-Jul-2021.)
axiom df_eldisj (A2: class):
  $ wb (weldisj A2) (wdisjALTV (cres (ccnv cep) A2)) $;

--| Alternate definition of the class of disjoints. (Contributed by Peter Mazsa, 18-Jul-2021.)
theorem dfdisjs {r: setvar}:
  $ wceq cdisjs (crab r (wcel (ccoss (ccnv (cv r))) ccnvrefrels) crels) $;

--| Alternate definition of the class of disjoints. (Contributed by Peter Mazsa, 5-Sep-2021.)
theorem dfdisjs2 {r: setvar}:
  $ wceq cdisjs (crab r (wss (ccoss (ccnv (cv r))) cid) crels) $;

--| Alternate definition of the class of disjoints. (Contributed by Peter Mazsa, 5-Sep-2021.)
theorem dfdisjs3 {x3 v u r: setvar}:
  $ wceq cdisjs (crab r (wal u (wal v (wal x3 (wi (wa (wbr (cv u) (cv x3) (cv r)) (wbr (cv v) (cv x3) (cv r))) (wceq (cv u) (cv v)))))) crels) $;

--| Alternate definition of the class of disjoints. (Contributed by Peter Mazsa, 5-Sep-2021.)
theorem dfdisjs4 {x3 u r: setvar}:
  $ wceq cdisjs (crab r (wal x3 (wmo u (wbr (cv u) (cv x3) (cv r)))) crels) $;

--| Alternate definition of the class of disjoints. (Contributed by Peter Mazsa, 5-Sep-2021.)
theorem dfdisjs5 {v u r: setvar}:
  $ wceq cdisjs (crab r (wral u (wral v (wo (wceq (cv u) (cv v)) (wceq (cin (cec (cv u) (cv r)) (cec (cv v) (cv r))) c0)) (cdm (cv r))) (cdm (cv r))) crels) $;

--| Alternate definition of the disjoint relation predicate. A disjoint relation is a converse function of the relation, see the comment of ~ df-disjs why we need disjoint relations instead of converse functions anyway. (Contributed by Peter Mazsa, 27-Jul-2021.)
theorem dfdisjALTV (R: class):
  $ wb (wdisjALTV R) (wa (wfunALTV (ccnv R)) (wrel R)) $;

--| Alternate definition of the disjoint relation predicate, cf. ~ dffunALTV2 . (Contributed by Peter Mazsa, 27-Jul-2021.)
theorem dfdisjALTV2 (R: class):
  $ wb (wdisjALTV R) (wa (wss (ccoss (ccnv R)) cid) (wrel R)) $;

--| Alternate definition of the disjoint relation predicate, cf. ~ dffunALTV3 . (Contributed by Peter Mazsa, 28-Jul-2021.)
theorem dfdisjALTV3 {x3 v u: setvar} (R: class):
  $ wb (wdisjALTV R) (wa (wal u (wal v (wal x3 (wi (wa (wbr (cv u) (cv x3) R) (wbr (cv v) (cv x3) R)) (wceq (cv u) (cv v)))))) (wrel R)) $;

--| Alternate definition of the disjoint relation predicate, cf. ~ dffunALTV4 . (Contributed by Peter Mazsa, 5-Sep-2021.)
theorem dfdisjALTV4 {x3 u: setvar} (R: class):
  $ wb (wdisjALTV R) (wa (wal x3 (wmo u (wbr (cv u) (cv x3) R))) (wrel R)) $;

--| Alternate definition of the disjoint relation predicate, cf. ~ dffunALTV5 . (Contributed by Peter Mazsa, 5-Sep-2021.)
theorem dfdisjALTV5 {v u: setvar} (R: class):
  $ wb (wdisjALTV R) (wa (wral u (wral v (wo (wceq (cv u) (cv v)) (wceq (cin (cec (cv u) R) (cec (cv v) R)) c0)) (cdm R)) (cdm R)) (wrel R)) $;

--| Alternate definition of the disjoint relation predicate. ` Disj R ` means: different domain generators have disjoint cosets (unless the generators are equal), plus ` Rel R ` for relation-typedness. This is the characterization that makes canonicity/uniqueness arguments modular. It is the starting point for the entire " ` Disj ` ` <-> ` unique representative per block" pipeline that feeds into ` Disjs ` , see ~ dfdisjs7 . (Contributed by Peter Mazsa, 3-Feb-2026.)
theorem dfdisjALTV5a {v u: setvar} (R: class):
  $ wb (wdisjALTV R) (wa (wral u (wral v (wi (wne (cin (cec (cv u) R) (cec (cv v) R)) c0) (wceq (cv u) (cv v))) (cdm R)) (cdm R)) (wrel R)) $;

--| ` Disj ` implies coset-equality injectivity (domain-wise). Extracts the practical consequence of ` Disj ` : the map ` u |-> [ u ] R ` is injective on ` dom R ` . This is exactly the "canonicity" property used repeatedly when turning ` E* ` into ` E! ` and when reasoning about uniqueness of representatives. (Contributed by Peter Mazsa, 3-Feb-2026.)
theorem disjimeceqim {v u: setvar} (R: class):
  $ wi (wdisjALTV R) (wral u (wral v (wi (wceq (cec (cv u) R) (cec (cv v) R)) (wceq (cv u) (cv v))) (cdm R)) (cdm R)) $;

--| ` Disj ` implies injectivity (pairwise form). The same content as ~ disjimeceqim but packaged for direct use with explicit hypotheses ` ( A e. dom R /\ B e. dom R ) ` . (Contributed by Peter Mazsa, 16-Feb-2026.)
theorem disjimeceqim2 (A2 B2 R: class):
  $ wi (wdisjALTV R) (wi (wa (wcel A2 (cdm R)) (wcel B2 (cdm R))) (wi (wceq (cec A2 R) (cec B2 R)) (wceq A2 B2))) $;

--| ` Disj ` gives biconditional injectivity (domain-wise). Strengthens injectivity to an iff. (Contributed by Peter Mazsa, 3-Feb-2026.)
theorem disjimeceqbi {v u: setvar} (R: class):
  $ wi (wdisjALTV R) (wral u (wral v (wb (wceq (cec (cv u) R) (cec (cv v) R)) (wceq (cv u) (cv v))) (cdm R)) (cdm R)) $;

--| Injectivity of the block constructor under disjointness. ~ suc11reg analogue: under disjointness, equal blocks force equal generators (on ` dom R ` ). (Contributed by Peter Mazsa, 16-Feb-2026.)
theorem disjimeceqbi2 (A2 B2 R: class):
  $ wi (wdisjALTV R) (wi (wa (wcel A2 (cdm R)) (wcel B2 (cdm R))) (wb (wceq (cec A2 R) (cec B2 R)) (wceq A2 B2))) $;

--| Under ` Disj ` , every block has a unique generator ( ` E* ` form). If ` t ` is a block in the quotient sense, then there is a uniquely determined ` u ` in ` dom R ` such that ` t = [ u ] R ` . This is the existence+uniqueness engine behind ` Disjs ` and ` QMap ` characterizations: it is the "representative theorem" from which the ` E! ` forms are obtained. (Contributed by Peter Mazsa, 5-Feb-2026.)
theorem disjimrmoeqec {u: setvar} (t: setvar) (R: class):
  $ wi (wdisjALTV R) (wrmo u (wceq (cv t) (cec (cv u) R)) (cdm R)) $;

--| Disjointness implies unique-generation of quotient blocks. Converts existence-quotient comprehension (see ~ df-qs ) into a uniqueness-comprehension under disjointness; rewrites ` ( dom R /. R ) ` carriers as exactly the class of blocks with a unique representative. This is the "unique generator per block" content in a carrier-normal form. (Contributed by Peter Mazsa, 5-Feb-2026.)
theorem disjimdmqseq {u t: setvar} (R: class):
  $ wi (wdisjALTV R) (wceq (cqs (cdm R) R) (cab t (wreu u (wceq (cv t) (cec (cv u) R)) (cdm R)))) $;

--| Alternate definition of the disjoint elementhood predicate. (Contributed by Peter Mazsa, 19-Sep-2021.)
theorem dfeldisj2 (A2: class):
  $ wb (weldisj A2) (wss (ccoss (ccnv (cres (ccnv cep) A2))) cid) $;

--| Alternate definition of the disjoint elementhood predicate. (Contributed by Peter Mazsa, 19-Sep-2021.)
theorem dfeldisj3 {x3 v u: setvar} (A2: class):
  $ wb (weldisj A2) (wral u (wral v (wral x3 (wceq (cv u) (cv v)) (cin (cv u) (cv v))) A2) A2) $;

--| Alternate definition of the disjoint elementhood predicate. (Contributed by Peter Mazsa, 19-Sep-2021.)
theorem dfeldisj4 {x3 u: setvar} (A2: class):
  $ wb (weldisj A2) (wal x3 (wrmo u (wcel (cv x3) (cv u)) A2)) $;

--| Alternate definition of the disjoint elementhood predicate. (Contributed by Peter Mazsa, 19-Sep-2021.)
theorem dfeldisj5 {v u: setvar} (A2: class):
  $ wb (weldisj A2) (wral u (wral v (wo (wceq (cv u) (cv v)) (wceq (cin (cv u) (cv v)) c0)) A2) A2) $;

--| Alternate definition of the disjoint elementhood predicate. Members of ` A ` are pairwise disjoint: if two members overlap, they are equal. (Contributed by Peter Mazsa, 19-Sep-2021.)
theorem dfeldisj5a {v u: setvar} (A2: class):
  $ wb (weldisj A2) (wral u (wral v (wi (wne (cin (cv u) (cv v)) c0) (wceq (cv u) (cv v))) A2) A2) $;

--| ` ElDisj ` elimination (two chosen elements). Standard specialization lemma: from ` ElDisj A ` infer the disjointness condition for two specific elements. (Contributed by Peter Mazsa, 6-Feb-2026.)
theorem eldisjim3 (A2 B2 C: class):
  $ wi (weldisj A2) (wi (wa (wcel B2 A2) (wcel C A2)) (wi (wne (cin B2 C) c0) (wceq B2 C))) $;

--| ElDisj of quotient implies coset-disjointness (domain form). Converts element-disjointness of the quotient carrier into a usable "cosets don't overlap unless equal" rule. (Contributed by Peter Mazsa, 10-Feb-2026.)
theorem eldisjdmqsim2 (v u: setvar) (R: class):
  $ wi (wa (weldisj (cqs (cdm R) R)) (wcel R crels)) (wi (wa (wcel (cv u) (cdm R)) (wcel (cv v) (cdm R))) (wi (wne (cin (cec (cv u) R) (cec (cv v) R)) c0) (wceq (cec (cv u) R) (cec (cv v) R)))) $;

--| Shared output implies equal cosets (under ` ElDisj ` of quotient): if ` u ` and ` v ` both relate to the same ` x ` , then their cosets intersect, hence must coincide under quotient ` ElDisj ` . (Contributed by Peter Mazsa, 10-Feb-2026.)
theorem eldisjdmqsim {x3 v u: setvar} (R: class v u):
  $ wi (wa (weldisj (cqs (cdm R) R)) (wcel R crels)) (wi (wa (wbr (cv u) (cv x3) R) (wbr (cv v) (cv x3) R)) (wceq (cec (cv u) R) (cec (cv v) R))) $;

--| Disjointness of successor enforces element-carrier separation: If ` B ` is the successor of ` A ` and ` B ` is element-disjoint as a family, then no element of ` A ` can itself be a member of ` A ` (equivalently, every ` x e. A ` has empty intersection with the carrier ` A ` ). Provides a clean bridge between "disjoint family at the next grade" and "no block contains a block of the same family" at the previous grade: ` MembPart ` alone does not enforce this, see ~ dfmembpart2 (it gives disjoint blocks and excludes the empty block, but does not prevent ` u e. m ` from also being a member of the carrier ` m ` ). This lemma is used to justify when grade-stability (via successor-shift) supplies the extra separation axioms needed in roof/root-style carrier reasoning. (Contributed by Peter Mazsa, 18-Feb-2026.)
theorem suceldisj {x3: setvar} (A2 B2 V: class):
  $ wi (w3a (wcel A2 V) (weldisj B2) (wceq (csuc A2) B2)) (wral x3 (wceq (cin (cv x3) A2) c0) A2) $;

--| Elementhood in the class of disjoints. (Contributed by Peter Mazsa, 24-Jul-2021.)
theorem eldisjs (R: class):
  $ wb (wcel R cdisjs) (wa (wcel (ccoss (ccnv R)) ccnvrefrels) (wcel R crels)) $;

--| Elementhood in the class of disjoints. (Contributed by Peter Mazsa, 5-Sep-2021.)
theorem eldisjs2 (R: class):
  $ wb (wcel R cdisjs) (wa (wss (ccoss (ccnv R)) cid) (wcel R crels)) $;

--| Elementhood in the class of disjoints. (Contributed by Peter Mazsa, 5-Sep-2021.)
theorem eldisjs3 {x3 v u: setvar} (R: class):
  $ wb (wcel R cdisjs) (wa (wal u (wal v (wal x3 (wi (wa (wbr (cv u) (cv x3) R) (wbr (cv v) (cv x3) R)) (wceq (cv u) (cv v)))))) (wcel R crels)) $;

--| Elementhood in the class of disjoints. (Contributed by Peter Mazsa, 5-Sep-2021.)
theorem eldisjs4 {x3 u: setvar} (R: class):
  $ wb (wcel R cdisjs) (wa (wal x3 (wmo u (wbr (cv u) (cv x3) R))) (wcel R crels)) $;

--| Elementhood in the class of disjoints. (Contributed by Peter Mazsa, 5-Sep-2021.)
theorem eldisjs5 {v u: setvar} (R: class) (V: class v u):
  $ wi (wcel R V) (wb (wcel R cdisjs) (wa (wral u (wral v (wo (wceq (cv u) (cv v)) (wceq (cin (cec (cv u) R) (cec (cv v) R)) c0)) (cdm R)) (cdm R)) (wcel R crels))) $;

--| The element of the class of disjoint relations and the disjoint relation predicate are the same, that is ` ( R e. Disjs <-> Disj R ) ` when ` R ` is a set. (Contributed by Peter Mazsa, 25-Jul-2021.)
theorem eldisjsdisj (R V: class):
  $ wi (wcel R V) (wb (wcel R cdisjs) (wdisjALTV R)) $;

--| When ` R ` is a set (e.g., when it is an element of the class of relations ~ df-rels ), the quotient map element of the class of disjoint relations and the disjoint relation predicate for quotient maps are the same. (Contributed by Peter Mazsa, 12-Feb-2026.)
theorem qmapeldisjs (R V: class):
  $ wi (wcel R V) (wb (wcel (cqmap R) cdisjs) (wdisjALTV (cqmap R))) $;

--| Disjointness of ` QMap ` equals ` E* ` -generation. Pairs with ~ disjqmap and ~ raldmqseu to move between ` E* ` and ` E! ` depending on context. (Contributed by Peter Mazsa, 12-Feb-2026.)
theorem disjqmap2 {u t: setvar} (R V: class):
  $ wi (wcel R V) (wb (wdisjALTV (cqmap R)) (wal u (wrmo t (wceq (cv u) (cec (cv t) R)) (cdm R)))) $;

--| Disjointness of ` QMap ` equals unique generation of the quotient carrier. The cleaned, carrier-respecting version of ~ disjqmap2 . This is the statement "each equivalence class has a unique representative" for the general coset carrier ` ( dom R /. R ) ` . (Contributed by Peter Mazsa, 12-Feb-2026.)
theorem disjqmap {u t: setvar} (R V: class):
  $ wi (wcel R V) (wb (wdisjALTV (cqmap R)) (wral u (wreu t (wceq (cv u) (cec (cv t) R)) (cdm R)) (cqs (cdm R) R))) $;

--| Elementhood in the disjoint elements class. (Contributed by Peter Mazsa, 23-Jul-2023.)
theorem eleldisjs (A2 V: class):
  $ wi (wcel A2 V) (wb (wcel A2 celdisjs) (wcel (cres (ccnv cep) A2) cdisjs)) $;

--| The element of the disjoint elements class and the disjoint elementhood predicate are the same, that is ` ( A e. ElDisjs <-> ElDisj A ) ` when ` A ` is a set. (Contributed by Peter Mazsa, 23-Jul-2023.)
theorem eleldisjseldisj (A2 V: class):
  $ wi (wcel A2 V) (wb (wcel A2 celdisjs) (weldisj A2)) $;

--| Disjoint relation is a relation. (Contributed by Peter Mazsa, 15-Sep-2021.)
theorem disjrel (R: class):
  $ wi (wdisjALTV R) (wrel R) $;

--| Subclass theorem for disjoints. (Contributed by Peter Mazsa, 28-Oct-2020.) (Revised by Peter Mazsa, 22-Sep-2021.)
theorem disjss (A2 B2: class):
  $ wi (wss A2 B2) (wi (wdisjALTV B2) (wdisjALTV A2)) $;

--| Subclass theorem for disjoints, inference version. (Contributed by Peter Mazsa, 28-Sep-2021.)
theorem disjssi (A2 B2: class):
  $ wss A2 B2 $ >
  $ wi (wdisjALTV B2) (wdisjALTV A2) $;

--| Subclass theorem for disjoints, deduction version. (Contributed by Peter Mazsa, 28-Sep-2021.)
theorem disjssd (ph: wff) (A2 B2: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wi (wdisjALTV B2) (wdisjALTV A2)) $;

--| Equality theorem for disjoints. (Contributed by Peter Mazsa, 22-Sep-2021.)
theorem disjeq (A2 B2: class):
  $ wi (wceq A2 B2) (wb (wdisjALTV A2) (wdisjALTV B2)) $;

--| Equality theorem for disjoints, inference version. (Contributed by Peter Mazsa, 22-Sep-2021.)
theorem disjeqi (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wb (wdisjALTV A2) (wdisjALTV B2) $;

--| Equality theorem for disjoints, deduction version. (Contributed by Peter Mazsa, 22-Sep-2021.)
theorem disjeqd (ph: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wdisjALTV A2) (wdisjALTV B2)) $;

--| Lemma for the equality theorem for partition ~ parteq1 . (Contributed by Peter Mazsa, 5-Oct-2021.)
theorem disjdmqseqeq1 (A2 R S: class):
  $ wi (wceq R S) (wb (wa (wdisjALTV R) (wceq (cqs (cdm R) R) A2)) (wa (wdisjALTV S) (wceq (cqs (cdm S) S) A2))) $;

--| Subclass theorem for disjoint elementhood. (Contributed by Peter Mazsa, 23-Sep-2021.)
theorem eldisjss (A2 B2: class):
  $ wi (wss A2 B2) (wi (weldisj B2) (weldisj A2)) $;

--| Subclass theorem for disjoint elementhood, inference version. (Contributed by Peter Mazsa, 28-Sep-2021.)
theorem eldisjssi (A2 B2: class):
  $ wss A2 B2 $ >
  $ wi (weldisj B2) (weldisj A2) $;

--| Subclass theorem for disjoint elementhood, deduction version. (Contributed by Peter Mazsa, 28-Sep-2021.)
theorem eldisjssd (ph: wff) (A2 B2: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wi (weldisj B2) (weldisj A2)) $;

--| Equality theorem for disjoint elementhood. (Contributed by Peter Mazsa, 23-Sep-2021.)
theorem eldisjeq (A2 B2: class):
  $ wi (wceq A2 B2) (wb (weldisj A2) (weldisj B2)) $;

--| Equality theorem for disjoint elementhood, inference version. (Contributed by Peter Mazsa, 23-Sep-2021.)
theorem eldisjeqi (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wb (weldisj A2) (weldisj B2) $;

--| Equality theorem for disjoint elementhood, deduction version. (Contributed by Peter Mazsa, 23-Sep-2021.)
theorem eldisjeqd (ph: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (weldisj A2) (weldisj B2)) $;

--| Disjoint restriction. (Contributed by Peter Mazsa, 25-Aug-2023.)
theorem disjres {v u: setvar} (A2 R: class):
  $ wi (wrel R) (wb (wdisjALTV (cres R A2)) (wral u (wral v (wo (wceq (cv u) (cv v)) (wceq (cin (cec (cv u) R) (cec (cv v) R)) c0)) A2) A2)) $;

--| Two forms of disjoint elements when the empty set is not an element of the class. (Contributed by Peter Mazsa, 31-Dec-2024.)
theorem eldisjn0elb (A2: class):
  $ wb (wa (weldisj A2) (wn (wcel c0 A2))) (wa (wdisjALTV (cres (ccnv cep) A2)) (wceq (cqs (cdm (cres (ccnv cep) A2)) (cres (ccnv cep) A2)) A2)) $;

--| Two ways of saying that a range Cartesian product is disjoint. (Contributed by Peter Mazsa, 17-Jun-2020.) (Revised by Peter Mazsa, 21-Sep-2021.)
theorem disjxrn (R S: class):
  $ wb (wdisjALTV (cxrn R S)) (wss (cin (ccoss (ccnv R)) (ccoss (ccnv S))) cid) $;

--| Disjoint range Cartesian product. (Contributed by Peter Mazsa, 25-Aug-2023.)
theorem disjxrnres5 {v u: setvar} (A2 R S: class):
  $ wb (wdisjALTV (cxrn R (cres S A2))) (wral u (wral v (wo (wceq (cv u) (cv v)) (wceq (cin (cec (cv u) (cxrn R S)) (cec (cv v) (cxrn R S))) c0)) A2) A2) $;

--| Disjointness condition for range Cartesian product. (Contributed by Peter Mazsa, 12-Jul-2020.) (Revised by Peter Mazsa, 22-Sep-2021.)
theorem disjorimxrn (R S: class):
  $ wi (wo (wdisjALTV R) (wdisjALTV S)) (wdisjALTV (cxrn R S)) $;

--| Disjointness condition for range Cartesian product. (Contributed by Peter Mazsa, 15-Dec-2020.) (Revised by Peter Mazsa, 22-Sep-2021.)
theorem disjimxrn (R S: class):
  $ wi (wdisjALTV S) (wdisjALTV (cxrn R S)) $;

--| Disjointness condition for restriction. (Contributed by Peter Mazsa, 27-Sep-2021.)
theorem disjimres (A2 R: class):
  $ wi (wdisjALTV R) (wdisjALTV (cres R A2)) $;

--| Disjointness condition for intersection. (Contributed by Peter Mazsa, 11-Jun-2021.) (Revised by Peter Mazsa, 28-Sep-2021.)
theorem disjimin (R S: class):
  $ wi (wdisjALTV S) (wdisjALTV (cin R S)) $;

--| Disjointness condition for intersection with restriction. (Contributed by Peter Mazsa, 27-Sep-2021.)
theorem disjiminres (A2 R S: class):
  $ wi (wdisjALTV S) (wdisjALTV (cin R (cres S A2))) $;

--| Disjointness condition for range Cartesian product with restriction. (Contributed by Peter Mazsa, 27-Sep-2021.)
theorem disjimxrnres (A2 R S: class):
  $ wi (wdisjALTV S) (wdisjALTV (cxrn R (cres S A2))) $;

--| The null class is disjoint. (Contributed by Peter Mazsa, 27-Sep-2021.)
theorem disjALTV0:
  $ wdisjALTV c0 $;

--| The class of identity relations is disjoint. (Contributed by Peter Mazsa, 20-Jun-2021.)
theorem disjALTVid:
  $ wdisjALTV cid $;

--| The class of identity relations restricted is disjoint. (Contributed by Peter Mazsa, 28-Jun-2020.) (Revised by Peter Mazsa, 27-Sep-2021.)
theorem disjALTVidres (A2: class):
  $ wdisjALTV (cres cid A2) $;

--| The intersection with restricted identity relation is disjoint. (Contributed by Peter Mazsa, 31-Dec-2021.)
theorem disjALTVinidres (A2 R: class):
  $ wdisjALTV (cin R (cres cid A2)) $;

--| The class of range Cartesian product with restricted identity relation is disjoint. (Contributed by Peter Mazsa, 25-Jun-2020.) (Revised by Peter Mazsa, 27-Sep-2021.)
theorem disjALTVxrnidres (A2 R: class):
  $ wdisjALTV (cxrn R (cres cid A2)) $;

--| Disjoint range Cartesian product, special case. (Contributed by Peter Mazsa, 25-Aug-2023.)
theorem disjsuc {u: setvar} (A2 R V: class):
  $ wi (wcel A2 V) (wb (wdisjALTV (cxrn R (cres (ccnv cep) (csuc A2)))) (wa (wdisjALTV (cxrn R (cres (ccnv cep) A2))) (wral u (wo (wceq (cin (cv u) A2) c0) (wceq (cin (cec (cv u) R) (cec A2 R)) c0)) A2))) $;

--| Injectivity of coset map from ` QMap ` being disjoint (implication form): under the ` Disjs ` condition on ` QMap R ` , the coset assignment is injective on ` dom R ` . (Contributed by Peter Mazsa, 16-Feb-2026.)
theorem qmapeldisjsim (A2 B2 R V: class):
  $ wi (w3a (wcel R V) (wcel (cqmap R) cdisjs) (wa (wcel A2 (cdm R)) (wcel B2 (cdm R)))) (wi (wceq (cec A2 R) (cec B2 R)) (wceq A2 B2)) $;

--| Injectivity of coset map from QMap being disjoint (biconditional form). Convenience version of ~ qmapeldisjsim . (Contributed by Peter Mazsa, 16-Feb-2026.)
theorem qmapeldisjsbi (A2 B2 R V: class):
  $ wi (w3a (wcel R V) (wcel (cqmap R) cdisjs) (wa (wcel A2 (cdm R)) (wcel B2 (cdm R)))) (wb (wceq (cec A2 R) (cec B2 R)) (wceq A2 B2)) $;

--| Element-disjointness of the quotient carrier forces coset disjointness. Supplies the "cosets don't overlap unless equal" direction, but expressed via ` ran QMap R ` (the quotient carrier) and ` ElDisjs ` . This is the structural reason ` Disjs ` needs a "carrier disjointness" level distinct from the "unique representatives" level. (Contributed by Peter Mazsa, 16-Feb-2026.)
theorem rnqmapeleldisjsim (A2 B2 R V: class):
  $ wi (w3a (wcel R V) (wcel (crn (cqmap R)) celdisjs) (wa (wcel A2 (cdm R)) (wcel B2 (cdm R)))) (wi (wne (cin (cec A2 R) (cec B2 R)) c0) (wceq (cec A2 R) (cec B2 R))) $;

--| Define the antisymmetric relation predicate. (Read: ` R ` is an antisymmetric relation.) (Contributed by Peter Mazsa, 24-Jun-2024.)
axiom df_antisymrel (R: class):
  $ wb (wantisymrel R) (wa (wcnvrefrel (cin R (ccnv R))) (wrel R)) $;

--| Alternate definition of the antisymmetric relation predicate. (Contributed by Peter Mazsa, 24-Jun-2024.)
theorem dfantisymrel4 (R: class):
  $ wb (wantisymrel R) (wa (wss (cin R (ccnv R)) cid) (wrel R)) $;

--| Alternate definition of the antisymmetric relation predicate. (Contributed by Peter Mazsa, 24-Jun-2024.)
theorem dfantisymrel5 {x3 y1: setvar} (R: class):
  $ wb (wantisymrel R) (wa (wal x3 (wal y1 (wi (wa (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv x3) R)) (wceq (cv x3) (cv y1))))) (wrel R)) $;

--| (Contributed by Peter Mazsa, 25-Jun-2024.)
theorem antisymrelres {x3 y1: setvar} (A2 R: class):
  $ wb (wantisymrel (cres R A2)) (wral x3 (wral y1 (wi (wa (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv x3) R)) (wceq (cv x3) (cv y1))) A2) A2) $;

--| (Contributed by Peter Mazsa, 29-Jun-2024.)
theorem antisymrelressn (A2 R: class):
  $ wantisymrel (cres R (csn A2)) $;

--| Define the class of all partitions, cf. the comment of ~ df-disjs . Partitions are disjoints on domain quotients (or: domain quotients restricted to disjoints). This is a more general meaning of partition than we we are familiar with: the conventional meaning of partition (e.g. partition ` A ` of ` X ` , [Halmos] p. 28: "A partition of ` X ` is a disjoint collection ` A ` of non-empty subsets of ` X ` whose union is ` X ` ", or Definition 35, [Suppes] p. 83., cf. ~ https://oeis.org/A000110 ) is what we call membership partition here, cf. ~ dfmembpart2 . The binary partitions relation and the partition predicate are the same, that is, ` ( R Parts A <-> R Part A ) ` if ` A ` and ` R ` are sets, cf. ~ brpartspart . (Contributed by Peter Mazsa, 26-Jun-2021.)
axiom df_parts:
  $ wceq cparts (cres cdmqss cdisjs) $;

--| Define the partition predicate (read: ` A ` is a partition by ` R ` ). Alternative definition is ~ dfpart2 . The binary partition and the partition predicate are the same if ` A ` and ` R ` are sets, cf. ~ brpartspart . (Contributed by Peter Mazsa, 12-Aug-2021.)
axiom df_part (A2 R: class):
  $ wb (wpart A2 R) (wa (wdisjALTV R) (wdmqs A2 R)) $;

--| Define the class of member partition relations on their domain quotients. (Contributed by Peter Mazsa, 26-Jun-2021.)
axiom df_membparts {a: setvar}:
  $ wceq cmembparts (cab a (wbr (cres (ccnv cep) (cv a)) (cv a) cparts)) $;

--| Define the member partition predicate, or the disjoint restricted element relation on its domain quotient predicate. (Read: ` A ` is a member partition.) A alternative definition is ~ dfmembpart2 . Member partition is the conventional meaning of partition (see the notes of ~ df-parts and ~ dfmembpart2 ), we generalize the concept in ~ df-parts and ~ df-part . Member partition and comember equivalence are the same by ~ mpet . (Contributed by Peter Mazsa, 26-Jun-2021.)
axiom df_membpart (A2: class):
  $ wb (wmembpart A2) (wpart A2 (cres (ccnv cep) A2)) $;

--| Alternate definition of the partition predicate. (Contributed by Peter Mazsa, 5-Sep-2021.)
theorem dfpart2 (A2 R: class):
  $ wb (wpart A2 R) (wa (wdisjALTV R) (wceq (cqs (cdm R) R) A2)) $;

--| Alternate definition of the conventional membership case of partition. Partition ` A ` of ` X ` , [Halmos] p. 28: "A partition of ` X ` is a disjoint collection ` A ` of non-empty subsets of ` X ` whose union is ` X ` ", or Definition 35, [Suppes] p. 83., cf. https://oeis.org/A000110 . (Contributed by Peter Mazsa, 14-Aug-2021.)
theorem dfmembpart2 (A2: class):
  $ wb (wmembpart A2) (wa (weldisj A2) (wn (wcel c0 A2))) $;

--| Binary partitions relation. (Contributed by Peter Mazsa, 23-Jul-2021.)
theorem brparts (A2 R V: class):
  $ wi (wcel A2 V) (wb (wbr R A2 cparts) (wa (wcel R cdisjs) (wbr R A2 cdmqss))) $;

--| Binary partitions relation. (Contributed by Peter Mazsa, 30-Dec-2021.)
theorem brparts2 (A2 R V W: class):
  $ wi (wa (wcel A2 V) (wcel R W)) (wb (wbr R A2 cparts) (wa (wcel R cdisjs) (wceq (cqs (cdm R) R) A2))) $;

--| Binary partition and the partition predicate are the same if ` A ` and ` R ` are sets. (Contributed by Peter Mazsa, 5-Sep-2021.)
theorem brpartspart (A2 R V W: class):
  $ wi (wa (wcel A2 V) (wcel R W)) (wb (wbr R A2 cparts) (wpart A2 R)) $;

--| Equality theorem for partition. (Contributed by Peter Mazsa, 5-Oct-2021.)
theorem parteq1 (A2 R S: class):
  $ wi (wceq R S) (wb (wpart A2 R) (wpart A2 S)) $;

--| Equality theorem for partition. (Contributed by Peter Mazsa, 25-Jul-2024.)
theorem parteq2 (A2 B2 R: class):
  $ wi (wceq A2 B2) (wb (wpart A2 R) (wpart B2 R)) $;

--| Equality theorem for partition. (Contributed by Peter Mazsa, 25-Jul-2024.)
theorem parteq12 (A2 B2 R S: class):
  $ wi (wa (wceq R S) (wceq A2 B2)) (wb (wpart A2 R) (wpart B2 S)) $;

--| Equality theorem for partition, inference version. (Contributed by Peter Mazsa, 5-Oct-2021.)
theorem parteq1i (A2 R S: class):
  $ wceq R S $ >
  $ wb (wpart A2 R) (wpart A2 S) $;

--| Equality theorem for partition, deduction version. (Contributed by Peter Mazsa, 5-Oct-2021.)
theorem parteq1d (ph: wff) (A2 R S: class):
  $ wi ph (wceq R S) $ >
  $ wi ph (wb (wpart A2 R) (wpart A2 S)) $;

--| Property of the partition. (Contributed by Peter Mazsa, 24-Jul-2024.)
theorem partsuc2 (A2 R: class):
  $ wb (wpart (cdif (cun A2 (csn A2)) (csn A2)) (cdif (cres R (cun A2 (csn A2))) (cres R (csn A2)))) (wpart A2 (cres R A2)) $;

--| Property of the partition. (Contributed by Peter Mazsa, 20-Sep-2024.)
theorem partsuc (A2 R: class):
  $ wb (wpart (cdif (csuc A2) (csn A2)) (cdif (cres R (csuc A2)) (cres R (csn A2)))) (wpart A2 (cres R A2)) $;

--| The "Divide et Aequivalere" Theorem: every disjoint relation generates equivalent cosets by the relation: generalization of the former ~ prter1 , cf. ~ eldisjim . (Contributed by Peter Mazsa, 3-May-2019.) (Revised by Peter Mazsa, 17-Sep-2021.)
theorem disjim (R: class):
  $ wi (wdisjALTV R) (weqvrel (ccoss R)) $;

--| Every disjoint relation generates equivalent cosets by the relation, inference version. (Contributed by Peter Mazsa, 30-Sep-2021.)
theorem disjimi (R: class):
  $ wdisjALTV R $ >
  $ weqvrel (ccoss R) $;

--| If a relation is disjoint, then it is equivalent to the equivalent cosets of the relation, inference version. (Contributed by Peter Mazsa, 30-Sep-2021.)
theorem detlem (R: class):
  $ wdisjALTV R $ >
  $ wb (wdisjALTV R) (weqvrel (ccoss R)) $;

--| If the elements of ` A ` are disjoint, then it has equivalent coelements (former ~ prter1 ). Special case of ~ disjim . (Contributed by Rodolfo Medina, 13-Oct-2010.) (Revised by Mario Carneiro, 12-Aug-2015) (Revised by Peter Mazsa, 8-Feb-2018.) ( Revised by Peter Mazsa, 23-Sep-2021.)
theorem eldisjim (A2: class):
  $ wi (weldisj A2) (wcoeleqvrel A2) $;

--| Alternate form of ~ eldisjim . (Contributed by Peter Mazsa, 30-Dec-2024.)
theorem eldisjim2 (A2: class):
  $ wi (weldisj A2) (weqvrel (ccoels A2)) $;

--| The null class is an equivalence relation. (Contributed by Peter Mazsa, 31-Dec-2021.)
theorem eqvrel0:
  $ weqvrel c0 $;

--| The cosets by the null class are in equivalence relation if and only if the null class is disjoint (which it is, see ~ disjALTV0 ). (Contributed by Peter Mazsa, 31-Dec-2021.)
theorem det0:
  $ wb (wdisjALTV c0) (weqvrel (ccoss c0)) $;

--| The cosets by the null class are in equivalence relation. (Contributed by Peter Mazsa, 31-Dec-2024.)
theorem eqvrelcoss0:
  $ weqvrel (ccoss c0) $;

--| The identity relation is an equivalence relation. (Contributed by Peter Mazsa, 15-Apr-2019.) (Revised by Peter Mazsa, 31-Dec-2021.)
theorem eqvrelid:
  $ weqvrel cid $;

--| The cosets by a restricted identity relation is an equivalence relation. (Contributed by Peter Mazsa, 31-Dec-2021.)
theorem eqvrel1cossidres (A2: class):
  $ weqvrel (ccoss (cres cid A2)) $;

--| The cosets by an intersection with a restricted identity relation are in equivalence relation. (Contributed by Peter Mazsa, 31-Dec-2021.)
theorem eqvrel1cossinidres (A2 R: class):
  $ weqvrel (ccoss (cin R (cres cid A2))) $;

--| The cosets by a range Cartesian product with a restricted identity relation are in equivalence relation. (Contributed by Peter Mazsa, 31-Dec-2021.)
theorem eqvrel1cossxrnidres (A2 R: class):
  $ weqvrel (ccoss (cxrn R (cres cid A2))) $;

--| The cosets by the identity relation are in equivalence relation if and only if the identity relation is disjoint. (Contributed by Peter Mazsa, 31-Dec-2021.)
theorem detid:
  $ wb (wdisjALTV cid) (weqvrel (ccoss cid)) $;

--| The cosets by the identity class are in equivalence relation. (Contributed by Peter Mazsa, 31-Dec-2024.)
theorem eqvrelcossid:
  $ weqvrel (ccoss cid) $;

--| The cosets by the restricted identity relation are in equivalence relation if and only if the restricted identity relation is disjoint. (Contributed by Peter Mazsa, 31-Dec-2021.)
theorem detidres (A2: class):
  $ wb (wdisjALTV (cres cid A2)) (weqvrel (ccoss (cres cid A2))) $;

--| The cosets by the intersection with the restricted identity relation are in equivalence relation if and only if the intersection with the restricted identity relation is disjoint. (Contributed by Peter Mazsa, 31-Dec-2021.)
theorem detinidres (A2 R: class):
  $ wb (wdisjALTV (cin R (cres cid A2))) (weqvrel (ccoss (cin R (cres cid A2)))) $;

--| The cosets by the range Cartesian product with the restricted identity relation are in equivalence relation if and only if the range Cartesian product with the restricted identity relation is disjoint. (Contributed by Peter Mazsa, 31-Dec-2021.)
theorem detxrnidres (A2 R: class):
  $ wb (wdisjALTV (cxrn R (cres cid A2))) (weqvrel (ccoss (cxrn R (cres cid A2)))) $;

--| Lemma for ~ disjdmqseq , ~ partim2 and ~ petlem via ~ disjlem17 , (general version of the former ~ prtlem14 ). (Contributed by Peter Mazsa, 10-Sep-2021.)
theorem disjlem14 {x3 y1: setvar} (A2: class x3 y1) (R: class):
  $ wi (wdisjALTV R) (wi (wa (wcel (cv x3) (cdm R)) (wcel (cv y1) (cdm R))) (wi (wa (wcel A2 (cec (cv x3) R)) (wcel A2 (cec (cv y1) R))) (wceq (cec (cv x3) R) (cec (cv y1) R)))) $;

--| Lemma for ~ disjdmqseq , ~ partim2 and ~ petlem via ~ disjlem18 , (general version of the former ~ prtlem17 ). (Contributed by Peter Mazsa, 10-Sep-2021.)
theorem disjlem17 {x3 y1: setvar} (A2 B2: class x3) (R: class):
  $ wi (wdisjALTV R) (wi (wa (wcel (cv x3) (cdm R)) (wcel A2 (cec (cv x3) R))) (wi (wrex y1 (wa (wcel A2 (cec (cv y1) R)) (wcel B2 (cec (cv y1) R))) (cdm R)) (wcel B2 (cec (cv x3) R)))) $;

--| Lemma for ~ disjdmqseq , ~ partim2 and ~ petlem via ~ disjlem19 , (general version of the former ~ prtlem18 ). (Contributed by Peter Mazsa, 16-Sep-2021.)
theorem disjlem18 {x3: setvar} (A2 B2 R V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wi (wdisjALTV R) (wi (wa (wcel (cv x3) (cdm R)) (wcel A2 (cec (cv x3) R))) (wb (wcel B2 (cec (cv x3) R)) (wbr A2 B2 (ccoss R))))) $;

--| Lemma for ~ disjdmqseq , ~ partim2 and ~ petlem via ~ disjdmqs , (general version of the former ~ prtlem19 ). (Contributed by Peter Mazsa, 16-Sep-2021.)
theorem disjlem19 {x3: setvar} (A2 R V: class):
  $ wi (wcel A2 V) (wi (wdisjALTV R) (wi (wa (wcel (cv x3) (cdm R)) (wcel A2 (cec (cv x3) R))) (wceq (cec (cv x3) R) (cec A2 (ccoss R))))) $;

--| Lemma for ~ disjdmqseq via ~ disjdmqs . (Contributed by Peter Mazsa, 16-Sep-2021.)
theorem disjdmqsss (R: class):
  $ wi (wdisjALTV R) (wss (cqs (cdm R) R) (cqs (cdm (ccoss R)) (ccoss R))) $;

--| Lemma for ~ disjdmqseq via ~ disjdmqs . (Contributed by Peter Mazsa, 16-Sep-2021.)
theorem disjdmqscossss (R: class):
  $ wi (wdisjALTV R) (wss (cqs (cdm (ccoss R)) (ccoss R)) (cqs (cdm R) R)) $;

--| If a relation is disjoint, its domain quotient is equal to the domain quotient of the cosets by it. Lemma for ~ partim2 and ~ petlem via ~ disjdmqseq . (Contributed by Peter Mazsa, 16-Sep-2021.)
theorem disjdmqs (R: class):
  $ wi (wdisjALTV R) (wceq (cqs (cdm R) R) (cqs (cdm (ccoss R)) (ccoss R))) $;

--| If a relation is disjoint, its domain quotient is equal to a class if and only if the domain quotient of the cosets by it is equal to the class. General version of ~ eldisjn0el (which is the closest theorem to the former ~ prter2 ). Lemma for ~ partim2 and ~ petlem . (Contributed by Peter Mazsa, 16-Sep-2021.)
theorem disjdmqseq (A2 R: class):
  $ wi (wdisjALTV R) (wb (wceq (cqs (cdm R) R) A2) (wceq (cqs (cdm (ccoss R)) (ccoss R)) A2)) $;

--| Special case of ~ disjdmqseq (perhaps this is the closest theorem to the former ~ prter2 ). (Contributed by Peter Mazsa, 26-Sep-2021.)
theorem eldisjn0el (A2: class):
  $ wi (weldisj A2) (wb (wn (wcel c0 A2)) (wceq (cqs (cuni A2) (ccoels A2)) A2)) $;

--| Disjoint relation on its natural domain implies an equivalence relation on the cosets of the relation, on its natural domain, cf. ~ partim . Lemma for ~ petlem . (Contributed by Peter Mazsa, 17-Sep-2021.)
theorem partim2 (A2 R: class):
  $ wi (wa (wdisjALTV R) (wceq (cqs (cdm R) R) A2)) (wa (weqvrel (ccoss R)) (wceq (cqs (cdm (ccoss R)) (ccoss R)) A2)) $;

--| Partition implies equivalence relation by the cosets of the relation on its natural domain, cf. ~ partim2 . (Contributed by Peter Mazsa, 17-Sep-2021.)
theorem partim (A2 R: class):
  $ wi (wpart A2 R) (werALTV A2 (ccoss R)) $;

--| Partition implies that the class of coelements on the natural domain is equal to the class of cosets of the relation, cf. ~ erimeq . (Contributed by Peter Mazsa, 25-Dec-2024.)
theorem partimeq (A2 R V: class):
  $ wi (wcel R V) (wi (wpart A2 R) (wceq (ccoels A2) (ccoss R))) $;

--| Special case of ~ disjlem19 (together with ~ membpartlem19 , this is former ~ prtlem19 ). (Contributed by Peter Mazsa, 21-Oct-2021.)
theorem eldisjlem19 {u: setvar} (A2 B2 V: class):
  $ wi (wcel B2 V) (wi (weldisj A2) (wi (wa (wcel (cv u) (cdm (cres (ccnv cep) A2))) (wcel B2 (cv u))) (wceq (cv u) (cec B2 (ccoels A2))))) $;

--| Together with ~ disjlem19 , this is former ~ prtlem19 . (Contributed by Rodolfo Medina, 15-Oct-2010.) (Revised by Mario Carneiro, 12-Aug-2015.) (Revised by Peter Mazsa, 21-Oct-2021.)
theorem membpartlem19 {u: setvar} (A2 B2 V: class):
  $ wi (wcel B2 V) (wi (wmembpart A2) (wi (wa (wcel (cv u) A2) (wcel B2 (cv u))) (wceq (cv u) (cec B2 (ccoels A2))))) $;

--| If you can prove that the equivalence of cosets on their natural domain implies disjointness (e.g. ~ eqvrelqseqdisj5 ), or converse function (cf. ~ dfdisjALTV ), then disjointness, and equivalence of cosets, both on their natural domain, are equivalent. Lemma for the Partition Equivalence Theorem ~ pet2 . (Contributed by Peter Mazsa, 18-Sep-2021.)
theorem petlem (A2 R: class):
  $ wi (wa (weqvrel (ccoss R)) (wceq (cqs (cdm (ccoss R)) (ccoss R)) A2)) (wdisjALTV R) $ >
  $ wb (wa (wdisjALTV R) (wceq (cqs (cdm R) R) A2)) (wa (weqvrel (ccoss R)) (wceq (cqs (cdm (ccoss R)) (ccoss R)) A2)) $;

--| If you can prove disjointness (e.g. ~ disjALTV0 , ~ disjALTVid , ~ disjALTVidres , ~ disjALTVxrnidres , search for theorems containing the ' |- Disj ' string), or the same with converse function (cf. ~ dfdisjALTV ), then disjointness, and equivalence of cosets, both on their natural domain, are equivalent. (Contributed by Peter Mazsa, 18-Sep-2021.)
theorem petlemi (A2 R: class):
  $ wdisjALTV R $ >
  $ wb (wa (wdisjALTV R) (wceq (cqs (cdm R) R) A2)) (wa (weqvrel (ccoss R)) (wceq (cqs (cdm (ccoss R)) (ccoss R)) A2)) $;

--| Class ` A ` is a partition by the null class if and only if the cosets by the null class are in equivalence relation on it. (Contributed by Peter Mazsa, 31-Dec-2021.)
theorem pet02 (A2: class):
  $ wb (wa (wdisjALTV c0) (wceq (cqs (cdm c0) c0) A2)) (wa (weqvrel (ccoss c0)) (wceq (cqs (cdm (ccoss c0)) (ccoss c0)) A2)) $;

--| Class ` A ` is a partition by the null class if and only if the cosets by the null class are in equivalence relation on it. (Contributed by Peter Mazsa, 31-Dec-2021.)
theorem pet0 (A2: class):
  $ wb (wpart A2 c0) (werALTV A2 (ccoss c0)) $;

--| Class ` A ` is a partition by the identity class if and only if the cosets by the identity class are in equivalence relation on it. (Contributed by Peter Mazsa, 31-Dec-2021.)
theorem petid2 (A2: class):
  $ wb (wa (wdisjALTV cid) (wceq (cqs (cdm cid) cid) A2)) (wa (weqvrel (ccoss cid)) (wceq (cqs (cdm (ccoss cid)) (ccoss cid)) A2)) $;

--| A class is a partition by the identity class if and only if the cosets by the identity class are in equivalence relation on it. (Contributed by Peter Mazsa, 31-Dec-2021.)
theorem petid (A2: class):
  $ wb (wpart A2 cid) (werALTV A2 (ccoss cid)) $;

--| Class ` A ` is a partition by the identity class restricted to it if and only if the cosets by the restricted identity class are in equivalence relation on it. (Contributed by Peter Mazsa, 31-Dec-2021.)
theorem petidres2 (A2: class):
  $ wb (wa (wdisjALTV (cres cid A2)) (wceq (cqs (cdm (cres cid A2)) (cres cid A2)) A2)) (wa (weqvrel (ccoss (cres cid A2))) (wceq (cqs (cdm (ccoss (cres cid A2))) (ccoss (cres cid A2))) A2)) $;

--| A class is a partition by identity class restricted to it if and only if the cosets by the restricted identity class are in equivalence relation on it, cf. ~ eqvrel1cossidres . (Contributed by Peter Mazsa, 31-Dec-2021.)
theorem petidres (A2: class):
  $ wb (wpart A2 (cres cid A2)) (werALTV A2 (ccoss (cres cid A2))) $;

--| Class ` A ` is a partition by an intersection with the identity class restricted to it if and only if the cosets by the intersection are in equivalence relation on it. (Contributed by Peter Mazsa, 31-Dec-2021.)
theorem petinidres2 (A2 R: class):
  $ wb (wa (wdisjALTV (cin R (cres cid A2))) (wceq (cqs (cdm (cin R (cres cid A2))) (cin R (cres cid A2))) A2)) (wa (weqvrel (ccoss (cin R (cres cid A2)))) (wceq (cqs (cdm (ccoss (cin R (cres cid A2)))) (ccoss (cin R (cres cid A2)))) A2)) $;

--| A class is a partition by an intersection with the identity class restricted to it if and only if the cosets by the intersection are in equivalence relation on it. Cf. ~ br1cossinidres , ~ disjALTVinidres and ~ eqvrel1cossinidres . (Contributed by Peter Mazsa, 31-Dec-2021.)
theorem petinidres (A2 R: class):
  $ wb (wpart A2 (cin R (cres cid A2))) (werALTV A2 (ccoss (cin R (cres cid A2)))) $;

--| Class ` A ` is a partition by a range Cartesian product with the identity class restricted to it if and only if the cosets by the range Cartesian product are in equivalence relation on it. (Contributed by Peter Mazsa, 31-Dec-2021.)
theorem petxrnidres2 (A2 R: class):
  $ wb (wa (wdisjALTV (cxrn R (cres cid A2))) (wceq (cqs (cdm (cxrn R (cres cid A2))) (cxrn R (cres cid A2))) A2)) (wa (weqvrel (ccoss (cxrn R (cres cid A2)))) (wceq (cqs (cdm (ccoss (cxrn R (cres cid A2)))) (ccoss (cxrn R (cres cid A2)))) A2)) $;

--| A class is a partition by a range Cartesian product with the identity class restricted to it if and only if the cosets by the range Cartesian product are in equivalence relation on it. Cf. ~ br1cossxrnidres , ~ disjALTVxrnidres and ~ eqvrel1cossxrnidres . (Contributed by Peter Mazsa, 31-Dec-2021.)
theorem petxrnidres (A2 R: class):
  $ wb (wpart A2 (cxrn R (cres cid A2))) (werALTV A2 (ccoss (cxrn R (cres cid A2)))) $;

--| The elements of the quotient set of an equivalence relation are disjoint (cf. ~ eqvreldisj2 , ~ eqvreldisj3 ). (Contributed by Mario Carneiro, 10-Dec-2016.) (Revised by Peter Mazsa, 3-Dec-2024.)
theorem eqvreldisj1 {x3 y1: setvar} (A2: class x3) (R: class):
  $ wi (weqvrel R) (wral x3 (wral y1 (wo (wceq (cv x3) (cv y1)) (wceq (cin (cv x3) (cv y1)) c0)) (cqs A2 R)) (cqs A2 R)) $;

--| The elements of the quotient set of an equivalence relation are disjoint (cf. ~ eqvreldisj3 ). (Contributed by Mario Carneiro, 10-Dec-2016.) (Revised by Peter Mazsa, 19-Sep-2021.)
theorem eqvreldisj2 (A2 R: class):
  $ wi (weqvrel R) (weldisj (cqs A2 R)) $;

--| The elements of the quotient set of an equivalence relation are disjoint (cf. ~ qsdisj2 ). (Contributed by Mario Carneiro, 10-Dec-2016.) (Revised by Peter Mazsa, 20-Jun-2019.) (Revised by Peter Mazsa, 19-Sep-2021.)
theorem eqvreldisj3 (A2 R: class):
  $ wi (weqvrel R) (wdisjALTV (cres (ccnv cep) (cqs A2 R))) $;

--| Intersection with the converse epsilon relation restricted to the quotient set of an equivalence relation is disjoint. (Contributed by Peter Mazsa, 30-May-2020.) (Revised by Peter Mazsa, 31-Dec-2021.)
theorem eqvreldisj4 (B2 R S: class):
  $ wi (weqvrel R) (wdisjALTV (cin S (cres (ccnv cep) (cqs B2 R)))) $;

--| Range Cartesian product with converse epsilon relation restricted to the quotient set of an equivalence relation is disjoint. (Contributed by Peter Mazsa, 30-May-2020.) (Revised by Peter Mazsa, 22-Sep-2021.)
theorem eqvreldisj5 (B2 R S: class):
  $ wi (weqvrel R) (wdisjALTV (cxrn S (cres (ccnv cep) (cqs B2 R)))) $;

--| Implication of ~ eqvreldisj2 , lemma for The Main Theorem of Equivalences ~ mainer . (Contributed by Peter Mazsa, 23-Sep-2021.)
theorem eqvrelqseqdisj2 (A2 B2 R: class):
  $ wi (wa (weqvrel R) (wceq (cqs B2 R) A2)) (weldisj A2) $;

--| ` Disj ` implies element-disjoint quotient carrier. Supplies the carrier-disjointness half of the ` Disjs ` pattern: under ` Disj R ` , the coset family is element-disjoint. (Contributed by Peter Mazsa, 5-Feb-2026.)
theorem disjimeldisjdmqs (R: class):
  $ wi (wdisjALTV R) (weldisj (cqs (cdm R) R)) $;

--| An element of the class of disjoint relations is disjoint. (Contributed by Peter Mazsa, 11-Feb-2026.)
theorem eldisjsim1 (R: class):
  $ wi (wcel R cdisjs) (wdisjALTV R) $;

--| An element of the class of disjoint relations is an element of the class of relations. (Contributed by Peter Mazsa, 11-Feb-2026.)
theorem eldisjsim2 (R: class):
  $ wi (wcel R cdisjs) (wcel R crels) $;

--| The class of disjoint relations is a subclass of the class of relations. (Contributed by Peter Mazsa, 11-Feb-2026.)
theorem disjsssrels:
  $ wss cdisjs crels $;

--| ` Disjs ` implies element-disjoint quotient carrier. Exports the carrier-disjointness property in the ` ElDisjs ` packaging. (Contributed by Peter Mazsa, 11-Feb-2026.)
theorem eldisjsim3 (R: class):
  $ wi (wcel R cdisjs) (wcel (cqs (cdm R) R) celdisjs) $;

--| ` Disjs ` implies element-disjoint range of ` QMap ` . Same as ~ eldisjsim3 but expressed using the block-map range ` ran QMap R ` (often the more modular expression). (Contributed by Peter Mazsa, 15-Feb-2026.)
theorem eldisjsim4 (R: class):
  $ wi (wcel R cdisjs) (wcel (crn (cqmap R)) celdisjs) $;

--| ` Disjs ` is closed under ` QMap ` . If a relation is "disjoint-structured" ( ` Disjs ` ), then its canonical block map is also "disjoint-structured". This is the second "structure level" in ` Disjs ` : it expresses that the property is stable under passing to the canonical block map, a theme that mirrors Pet-grade stability at a different axis. (Contributed by Peter Mazsa, 15-Feb-2026.)
theorem eldisjsim5 (R: class):
  $ wi (wcel R cdisjs) (wcel (cqmap R) cdisjs) $;

--| Elementhood in the class of disjoints. A relation ` R ` is in ` Disjs ` iff: it is relation-typed, and its quotient-map ` QMap R ` is itself disjoint, and its quotient-carrier ` ran QMap R = ( dom R /. R ) ` lies in ` ElDisjs ` (element-disjoint carriers). This is the central "stability-by-decomposition" theorem for ` Disjs ` : it explains why ` Disjs ` is internally well-behaved without adding an external stability clause. It is the exact template that ` PetParts ` imitates: for ~ pet , the analogue of "map layer" is the disjointness of the lifted span, the analogue of "carrier layer" is the block-lift fixpoint ( ` BlockLiftFix ` ), and then adds external grade stability ( ` SucMap ShiftStable ` ) which ` Disjs ` does not need. (Contributed by Peter Mazsa, 16-Feb-2026.)
theorem eldisjs6 (R: class):
  $ wb (wcel R cdisjs) (wa (wcel R crels) (wa (wcel (crn (cqmap R)) celdisjs) (wcel (cqmap R) cdisjs))) $;

--| Elementhood in the class of disjoints. ` R e. Disjs ` iff: ` R e. Rels ` , and every ` x ` belongs to at most one block ` u ` in the quotient-carrier ` ( dom R /. R ) ` (element-disjointness at the carrier), and every block ` u ` in the quotient-carrier has a unique representative ` t e. dom R ` such that ` u = [ t ] R ` . Provides the "fully expanded" quantifier characterization of the same decomposition as ~ eldisjs6 , but without explicitly mentioning ` QMap ` . This is the "E*/E!"" view that is closest in spirit to ~ suc11reg -style injectivity and to the "unique generator per block" narrative. It is also the right contrast-point to older one-line criteria like ~ dfdisjs4 (the "u R x" style), because it makes the carrier and representation discipline explicit and type-safe. (Contributed by Peter Mazsa, 16-Feb-2026.)
theorem eldisjs7 {x3 u t: setvar} (R: class):
  $ wb (wcel R cdisjs) (wa (wcel R crels) (wa (wal x3 (wrmo u (wcel (cv x3) (cv u)) (cqs (cdm R) R))) (wral u (wreu t (wceq (cv u) (cec (cv t) R)) (cdm R)) (cqs (cdm R) R)))) $;

--| Alternate definition of the class of disjoints (via quotient-map stability). ` Disjs ` is the class of relations ` r ` whose quotient-map ` QMap r ` is again disjoint and whose induced quotient-carrier is element-disjoint. This is the definitional "stability-by-decomposition" packaging of disjointness: it builds ` Disjs ` from two internal layers (i) a carrier-layer constraint and (ii) a map-layer closure constraint. This is deliberately different from "u R x" style definitions: it makes the carrier of blocks and the uniqueness-of-representatives discipline first-class and reusable (via ` QMap ` ) rather than implicit. (Contributed by Peter Mazsa, 16-Feb-2026.)
theorem dfdisjs6 {r: setvar}:
  $ wceq cdisjs (crab r (wa (wcel (crn (cqmap (cv r))) celdisjs) (wcel (cqmap (cv r)) cdisjs)) crels) $;

--| Alternate definition of the class of disjoints (via carrier disjointness + unique representatives). Ideology-free normal form of ~ dfdisjs6 : "blocks cover their elements" ( ` E* ` ) and "each block has a unique generator" ( ` E! ` ), expressed entirely at the quotient-carrier level. Same class as ~ dfdisjs6 , but presented in fully expanded ` E* ` / ` E! ` form over the quotient-carrier ` ( dom r /. r ) ` . Makes explicit (a) element-disjointness of the quotient-carrier and (b) unique representative existence for each block. These are exactly the two conditions that rule out type-confusions (blocks vs witnesses) and ensure canonical decomposition. This is the form that best supports analogy arguments with ~ df-petparts and with successor-style uniqueness patterns. (Contributed by Peter Mazsa, 16-Feb-2026.)
theorem dfdisjs7 {x3 u t r: setvar}:
  $ wceq cdisjs (crab r (wa (wal x3 (wrmo u (wcel (cv x3) (cv u)) (cqs (cdm (cv r)) (cv r)))) (wral u (wreu t (wceq (cv u) (cec (cv t) (cv r))) (cdm (cv r))) (cqs (cdm (cv r)) (cv r)))) crels) $;

--| Implication of ~ eqvrelqseqdisj2 and ~ n0eldmqseq , see comment of ~ fences . (Contributed by Peter Mazsa, 30-Dec-2024.)
theorem fences3 (A2 R: class):
  $ wi (wa (weqvrel R) (wceq (cqs (cdm R) R) A2)) (wa (weldisj A2) (wn (wcel c0 A2))) $;

--| Implication of ~ eqvreldisj3 , lemma for the Member Partition Equivalence Theorem ~ mpet3 . (Contributed by Peter Mazsa, 27-Oct-2020.) (Revised by Peter Mazsa, 24-Sep-2021.)
theorem eqvrelqseqdisj3 (A2 B2 R: class):
  $ wi (wa (weqvrel R) (wceq (cqs B2 R) A2)) (wdisjALTV (cres (ccnv cep) A2)) $;

--| Lemma for ~ petincnvepres2 . (Contributed by Peter Mazsa, 31-Dec-2021.)
theorem eqvrelqseqdisj4 (A2 B2 R S: class):
  $ wi (wa (weqvrel R) (wceq (cqs B2 R) A2)) (wdisjALTV (cin S (cres (ccnv cep) A2))) $;

--| Lemma for the Partition-Equivalence Theorem ~ pet2 . (Contributed by Peter Mazsa, 15-Jul-2020.) (Revised by Peter Mazsa, 22-Sep-2021.)
theorem eqvrelqseqdisj5 (A2 B2 R S: class):
  $ wi (wa (weqvrel R) (wceq (cqs B2 R) A2)) (wdisjALTV (cxrn S (cres (ccnv cep) A2))) $;

--| The Main Theorem of Equivalences: every equivalence relation implies equivalent comembers. (Contributed by Peter Mazsa, 26-Sep-2021.)
theorem mainer (A2 R: class):
  $ wi (werALTV A2 R) (wcomember A2) $;

--| Partition with general ` R ` (in addition to the member partition cf. ~ mpet and ~ mpet2 ) implies equivalent comembers. (Contributed by Peter Mazsa, 23-Sep-2021.) (Revised by Peter Mazsa, 22-Dec-2024.)
theorem partimcomember (A2 R: class):
  $ wi (wpart A2 R) (wcomember A2) $;

--| Member Partition-Equivalence Theorem. Together with ~ mpet ~ mpet2 , mostly in its conventional ~ cpet and ~ cpet2 form, this is what we used to think of as the partition equivalence theorem (but cf. ~ pet2 with general ` R ` ). (Contributed by Peter Mazsa, 4-May-2018.) (Revised by Peter Mazsa, 26-Sep-2021.)
theorem mpet3 (A2: class):
  $ wb (wa (weldisj A2) (wn (wcel c0 A2))) (wa (wcoeleqvrel A2) (wceq (cqs (cuni A2) (ccoels A2)) A2)) $;

--| The conventional form of the Member Partition-Equivalence Theorem. In the conventional case there is no (general) disjoint and no (general) partition concept: mathematicians have called disjoint or partition what we call element disjoint or member partition, see also ~ cpet . Together with ~ cpet , ~ mpet ~ mpet2 , this is what we used to think of as the partition equivalence theorem (but cf. ~ pet2 with general ` R ` ). (Contributed by Peter Mazsa, 30-Dec-2024.)
theorem cpet2 (A2: class):
  $ wb (wa (weldisj A2) (wn (wcel c0 A2))) (wa (weqvrel (ccoels A2)) (wceq (cqs (cuni A2) (ccoels A2)) A2)) $;

--| The conventional form of Member Partition-Equivalence Theorem. In the conventional case there is no (general) disjoint and no (general) partition concept: mathematicians have been calling disjoint or partition what we call element disjoint or member partition, see also ~ cpet2 . Cf. ~ mpet , ~ mpet2 and ~ mpet3 for unconventional forms of Member Partition-Equivalence Theorem. Cf. ~ pet and ~ pet2 for Partition-Equivalence Theorem with general ` R ` . (Contributed by Peter Mazsa, 31-Dec-2024.)
theorem cpet (A2: class):
  $ wb (wmembpart A2) (wa (weqvrel (ccoels A2)) (wceq (cqs (cuni A2) (ccoels A2)) A2)) $;

--| Member Partition-Equivalence Theorem in almost its shortest possible form, cf. the 0-ary version ~ mpets . Member partition and comember equivalence relation are the same (or: each element of ` A ` have equivalent comembers if and only if ` A ` is a member partition). Together with ~ mpet2 , ~ mpet3 , and with the conventional ~ cpet and ~ cpet2 , this is what we used to think of as the partition equivalence theorem (but cf. ~ pet2 with general ` R ` ). (Contributed by Peter Mazsa, 24-Sep-2021.)
theorem mpet (A2: class):
  $ wb (wmembpart A2) (wcomember A2) $;

--| Member Partition-Equivalence Theorem in a shorter form. Together with ~ mpet ~ mpet3 , mostly in its conventional ~ cpet and ~ cpet2 form, this is what we used to think of as the partition equivalence theorem (but cf. ~ pet2 with general ` R ` ). (Contributed by Peter Mazsa, 24-Sep-2021.)
theorem mpet2 (A2: class):
  $ wb (wpart A2 (cres (ccnv cep) A2)) (werALTV A2 (ccoss (cres (ccnv cep) A2))) $;

--| Member Partition-Equivalence Theorem with binary relations, cf. ~ mpet2 . (Contributed by Peter Mazsa, 24-Sep-2021.)
theorem mpets2 (A2 V: class):
  $ wi (wcel A2 V) (wb (wbr (cres (ccnv cep) A2) A2 cparts) (wbr (ccoss (cres (ccnv cep) A2)) A2 cers)) $;

--| Member Partition-Equivalence Theorem in its shortest possible form: it shows that member partitions and comember equivalence relations are literally the same. Cf. ~ pet , the Partition-Equivalence Theorem, with general ` R ` . (Contributed by Peter Mazsa, 31-Dec-2024.)
theorem mpets:
  $ wceq cmembparts ccomembers $;

--| Partition with general ` R ` also imply member partition. (Contributed by Peter Mazsa, 23-Sep-2021.) (Revised by Peter Mazsa, 22-Dec-2024.)
theorem mainpart (A2 R: class):
  $ wi (wpart A2 R) (wmembpart A2) $;

--| The Theorem of Fences by Equivalences: all conceivable equivalence relations (besides the comember equivalence relation cf. ~ mpet ) generate a partition of the members. (Contributed by Peter Mazsa, 26-Sep-2021.)
theorem fences (A2 R: class):
  $ wi (werALTV A2 R) (wmembpart A2) $;

--| The Theorem of Fences by Equivalences: all conceivable equivalence relations (besides the comember equivalence relation cf. ~ mpet3 ) generate a partition of the members, it alo means that ` ( R ErALTV A -> ElDisj A ) ` and that ` ( R ErALTV A -> -. (/) e. A ) ` . (Contributed by Peter Mazsa, 15-Oct-2021.)
theorem fences2 (A2 R: class):
  $ wi (werALTV A2 R) (wa (weldisj A2) (wn (wcel c0 A2))) $;

--| The Main Theorem of Equivalences: every equivalence relation implies equivalent comembers. (Contributed by Peter Mazsa, 15-Oct-2021.)
theorem mainer2 (A2 R: class):
  $ wi (werALTV A2 R) (wa (wcoeleqvrel A2) (wn (wcel c0 A2))) $;

--| Every equivalence relation implies equivalent coelements. (Contributed by Peter Mazsa, 20-Oct-2021.)
theorem mainerim (A2 R: class):
  $ wi (werALTV A2 R) (wcoeleqvrel A2) $;

--| A partition-equivalence theorem with intersection and general ` R ` . (Contributed by Peter Mazsa, 31-Dec-2021.)
theorem petincnvepres2 (A2 R: class):
  $ wb (wa (wdisjALTV (cin R (cres (ccnv cep) A2))) (wceq (cqs (cdm (cin R (cres (ccnv cep) A2))) (cin R (cres (ccnv cep) A2))) A2)) (wa (weqvrel (ccoss (cin R (cres (ccnv cep) A2)))) (wceq (cqs (cdm (ccoss (cin R (cres (ccnv cep) A2)))) (ccoss (cin R (cres (ccnv cep) A2)))) A2)) $;

--| The shortest form of a partition-equivalence theorem with intersection and general ` R ` . Cf. ~ br1cossincnvepres . Cf. ~ pet . (Contributed by Peter Mazsa, 23-Sep-2021.)
theorem petincnvepres (A2 R: class):
  $ wb (wpart A2 (cin R (cres (ccnv cep) A2))) (werALTV A2 (ccoss (cin R (cres (ccnv cep) A2)))) $;

--| Partition-Equivalence Theorem, with general ` R ` . This theorem (together with ~ pet and ~ pets ) is the main result of my investigation into set theory, see the comment of ~ pet . (Contributed by Peter Mazsa, 24-May-2021.) (Revised by Peter Mazsa, 23-Sep-2021.)
theorem pet2 (A2 R: class):
  $ wb (wa (wdisjALTV (cxrn R (cres (ccnv cep) A2))) (wceq (cqs (cdm (cxrn R (cres (ccnv cep) A2))) (cxrn R (cres (ccnv cep) A2))) A2)) (wa (weqvrel (ccoss (cxrn R (cres (ccnv cep) A2)))) (wceq (cqs (cdm (ccoss (cxrn R (cres (ccnv cep) A2)))) (ccoss (cxrn R (cres (ccnv cep) A2)))) A2)) $;

--| Partition-Equivalence Theorem with general ` R ` while preserving the restricted converse epsilon relation of ~ mpet2 (as opposed to ~ petincnvepres ). A class is a partition by a range Cartesian product with general ` R ` and the restricted converse element class if and only if the cosets by the range Cartesian product are in an equivalence relation on it. Cf. ~ br1cossxrncnvepres . This theorem (together with ~ pets and ~ pet2 ) is the main result of my investigation into set theory. It is no more general than the conventional Member Partition-Equivalence Theorem ~ mpet , ~ mpet2 and ~ mpet3 (because you cannot set ` R ` in this theorem in such a way that you get ~ mpet2 ), i.e., it is not the hypothetical General Partition-Equivalence Theorem gpet ` |- ( R Part A <-> ,~ R ErALTV A ) ` , but this one has a general part that ~ mpet2 lacks: ` R ` , which is sufficient for my future application of set theory, for my purpose outside of set theory. (Contributed by Peter Mazsa, 23-Sep-2021.)
theorem pet (A2 R: class):
  $ wb (wpart A2 (cxrn R (cres (ccnv cep) A2))) (werALTV A2 (ccoss (cxrn R (cres (ccnv cep) A2)))) $;

--| Partition-Equivalence Theorem with general ` R ` , with binary relations. This theorem (together with ~ pet and ~ pet2 ) is the main result of my investigation into set theory, cf. the comment of ~ pet . (Contributed by Peter Mazsa, 23-Sep-2021.)
theorem pets (A2 R V W: class):
  $ wi (wa (wcel A2 V) (wcel R W)) (wb (wbr (cxrn R (cres (ccnv cep) A2)) A2 cparts) (wbr (ccoss (cxrn R (cres (ccnv cep) A2))) A2 cers)) $;

--| If the ~ pet span ` ( R |X. ( ``' _E |`` A ) ) ` partitions ` A ` , then every block ` u e. A ` is of the form ` [ v ] ` for some ` v ` that not only lies in the domain but also has at least one internal element ` c ` and at least one ` R ` -target ` b ` (cf. also the comments of ~ qseq ). It makes explicit that ~ pet gives active representatives for each block, without ever forcing ` v = u ` . (Contributed by Peter Mazsa, 23-Nov-2025.)
theorem dmqsblocks {v u b c: setvar} (A2 R: class):
  $ wi (wceq (cqs (cdm (cxrn R (cres (ccnv cep) A2))) (cxrn R (cres (ccnv cep) A2))) A2) (wral u (wrex v (wex b (wex c (w3a (wceq (cv u) (cec (cv v) (cxrn R (cres (ccnv cep) A2)))) (wcel (cv c) (cv v)) (wbr (cv v) (cv b) R)))) (cdm (cxrn R (cres (ccnv cep) A2)))) A2) $;

--| Define the class of partition-side general partition-equivalence spans. ` <. r , n >. e. PetParts ` means: (1) ` r ` is a set-relation ( ` r e. Rels ` ), and (2) ` n ` is a membership block-carrier ( ` n e. MembParts ` ), and (3) the block-lift span ` ( r |X. ( ``' _E |`` n ) ) ` is a generalized partition on its natural quotient-carrier ` n ` (i.e. ` ( r |X. ( ``' _E |`` n ) ) Parts n ` ). This is the horizontal feasibility base object on the partition side, expressed in the type-safe ` Parts ` language. The explicit typing ` ( r e. Rels /\ n e. MembParts ) ` is included at the definition level so later modular refinements can treat typedness as a first-class component (e.g. intersecting a typedness module with disjointness and equilibrium modules) without repeatedly restating it. In particular, it lets decompositions such as ~ dfpetparts2 be written as clean intersections whose first conjunct is exactly the typedness module ` ( Rels X. MembParts ) ` . (Contributed by Peter Mazsa, 19-Feb-2026.) (Revised by Peter Mazsa, 25-Feb-2026.)
axiom df_petparts {n r: setvar}:
  $ wceq cpetparts (copab r n (wa (wa (wcel (cv r) crels) (wcel (cv n) cmembparts)) (wbr (cxrn (cv r) (cres (ccnv cep) (cv n))) (cv n) cparts))) $;

--| Define the class of equivalence-side general partition-equivalence spans. ` <. r , n >. e. PetErs ` means: (1) ` r ` is a set-relation ( ` r e. Rels ` ), and (2) ` n ` is a carrier recognized on the equivalence side of membership ( ` n e. CoMembErs ` ), and (3) the coset relation of the lifted span, ` ,~ ( r |X. ( ``' _E |`` n ) ) ` , is an equivalence relation on its natural quotient with carrier ` n ` (i.e. ` ,~ ( r |X. ( ``' _E |`` n ) ) Ers n ` ). This packages the equivalence-view of the same lifted construction that underlies ` PetParts ` . It is designed to be parallel to ` PetParts ` so later proofs can freely choose the partition side ( ` Parts ` ) or the equivalence side ( ` Ers ` ) without rebuilding the bridge each time; the identification is provided by ~ petseq (using ~ typesafepets and ~ mpets ). The explicit typing ` ( r e. Rels /\ n e. CoMembErs ) ` is included for the same reason as in ~ df-petparts : to make typedness a reusable module. (Contributed by Peter Mazsa, 19-Feb-2026.) (Revised by Peter Mazsa, 25-Feb-2026.)
axiom df_peters {n r: setvar}:
  $ wceq cpeters (copab r n (wa (wa (wcel (cv r) crels) (wcel (cv n) ccomembers)) (wbr (ccoss (cxrn (cv r) (cres (ccnv cep) (cv n)))) (cv n) cers))) $;

--| Define the class of grade- and blocklift-stable partition-side general partition-equivalence spans. It consists of those ` <. r , n >. e. PetParts ` such that ` <. r , n >. ` remains in ` PetParts ` after shifting one grade along ` SucMap ` (via ` ShiftStable ` ). Concretely: ` <. r , n >. e. PetParts ` and there exists a predecessor ` m ` with ` suc m = n ` such that ` <. r , m >. e. PetParts ` (encoded by ` SucMap o. PetParts ` inside ` ShiftStable ` ). I.e., it introduces the external (tower/grade) stability axis. This is the "4th level" for ~ pet (see ~ dfpet2parts2 ): beyond (i) carrier membership partition, (ii) disjointness, and (iii) semantic equilibrium, we require (iv) stability under a canonical grade shift. ` PetParts ` already enforces disjointness and the quotient-carrier equation for the lifted span (hence semantic equilibrium via ~ dfpetparts2 ). ` Pet2Parts ` adds the external grade (tower) stability axis via ~ df-shiftstable with ` SucMap ` . This (iv) is why we need explicit second-level ` Pet2Parts ` , while ` Disjs ` typically does not: ` Disjs ` already packages its own internal two-step consistency (carrier + map) by ~ dfdisjs6 / ~ dfdisjs7 , whereas ~ pet has an additional grade axis that must be imposed separately. (Contributed by Peter Mazsa, 19-Feb-2026.)
axiom df_pet2parts:
  $ wceq cpet2parts (cshiftstable csucmap cpetparts) $;

--| Define the class of grade- and blocklift-stable equivalence-side general partition-equivalence spans. The equivalence-side analogue of ` Pet2Parts ` : stability of ` PetErs ` under one-step grade shift along ` SucMap ` . Ensures that the equivalence-side formulation supports the same tower/grade infrastructure as the partition-side formulation. ` SucMap ShiftStable ` is the grade axis and does not change the equivalence-vs-partition viewpoint (reinforced by ~ pets2eq ). (Contributed by Peter Mazsa, 19-Feb-2026.)
axiom df_pet2ers:
  $ wceq cpet2ers (cshiftstable csucmap cpeters) $;

--| Alternate definition of ` PetParts ` as typedness + disjoint-span + block-lift equilibrium. This theorem is the key modularization step. It decomposes ` PetParts ` into the intersection of three orthogonal modules: (T) typedness: ` <. r , n >. e. ( Rels X. MembParts ) ` , (D) disjoint-span: ` ( r |X. ( ``' _E |`` n ) ) e. Disjs ` , (E) semantic equilibrium: ` <. r , n >. e. BlockLiftFix ` , i.e. the carrier ` n ` is a fixpoint of the induced block-generation operator. Conceptually, (D) provides the disjointness/quotient discipline for the lifted span, while (E) prevents hidden carrier drift (refinement or coarsening of what counts as a block) by enforcing the fixpoint equation. The point of this theorem is that these constraints can be imposed and reused independently by later constructions, while their intersection recovers the intended ` Parts `-based notion. This mirrors the internal packaging of ` Disjs ` (see ~ dfdisjs6 / ~ dfdisjs7 ): for disjoint relations, the "map layer + carrier layer" decomposition is internal via ` QMap ` and ` ElDisjs ` ; for ` PetParts ` , the carrier ` n ` is an external parameter, so the additional carrier stability must be factored explicitly as ` BlockLiftFix ` . (Contributed by Peter Mazsa, 20-Feb-2026.) (Revised by Peter Mazsa, 25-Feb-2026.)
theorem dfpetparts2 {n r: setvar}:
  $ wceq cpetparts (cin (cin (cxp crels cmembparts) (copab r n (wcel (cxrn (cv r) (cres (ccnv cep) (cv n))) cdisjs))) cblockliftfix) $;

--| Grade stability applied to the decomposed ` PetParts ` modules. ` Pet2Parts ` is obtained by applying the grade-stability operator ` SucMap ShiftStable ` (see ~ df-shiftstable ) to the modular intersection from ~ dfpetparts2 . This makes the two orthogonal stability axes explicit: (E) semantic stability / equilibrium: ` BlockLiftFix ` , (G) grade stability: ` SucMap ShiftStable ` , assembled on top of typedness and disjoint-span base modules. This is the principled "extra level" that does not arise for ` Disjs ` : disjoint relations already bundle their internal map/carrier consistency via ` QMap ` and ` ElDisjs ` (see ~ dfdisjs6 / ~ dfdisjs7 ), while the present construction has an additional external grading axis imposed by the canonical successor map ` SucMap ` . (Contributed by Peter Mazsa, 20-Feb-2026.) (Revised by Peter Mazsa, 25-Feb-2026.)
theorem dfpet2parts2 {n r: setvar}:
  $ wceq cpet2parts (cshiftstable csucmap (cin (cin (cxp crels cmembparts) (copab r n (wcel (cxrn (cv r) (cres (ccnv cep) (cv n))) cdisjs))) cblockliftfix)) $;

--| Alternate definition of ` PetErs ` in fully modular form. This expands the ` Ers n ` predicate into: (i) a typedness module ` ( Rels X. CoMembErs ) ` , (ii) an equivalence module for the coset relation ` ,~ ( r |X. ( ``' _E |`` n ) ) e. EqvRels ` , (iii) the corresponding quotient-carrier (domain quotient) equation ` dom ,~ ( ... ) /. ,~ ( ... ) = n ` . This is the equivalence-side counterpart of the modular decomposition ~ dfpetparts2 on the partition side. (Contributed by Peter Mazsa, 25-Feb-2026.)
theorem dfpeters2 {n r: setvar}:
  $ wceq cpeters (cin (cin (cxp crels ccomembers) (copab r n (wcel (ccoss (cxrn (cv r) (cres (ccnv cep) (cv n)))) ceqvrels))) (copab r n (wceq (cqs (cdm (ccoss (cxrn (cv r) (cres (ccnv cep) (cv n))))) (ccoss (cxrn (cv r) (cres (ccnv cep) (cv n))))) (cv n)))) $;

--| Type-safe ~ pets scheme. On a membership block-carrier ` A e. MembParts ` , the lifted span ` ( R |X. ( ``' _E |`` A ) ) ` yields a generalized partition of ` A ` iff its coset relation yields an equivalence relation on the same carrier ` A ` . This is the type-safe replacement for the earlier broad ~ pets : it explicitly restricts to carriers where ` A ` is already known to be a block-family (by ` MembParts ` ). That removes the standard type-safety objection ("are you equating a quotient-carrier of blocks with raw witnesses?") by construction. It is the key bridge used to identify the partition-side and equivalence-side pet classes ( ~ petseq ), in complete parallel with the membership bridge ~ mpets . This theorem is intentionally not the definition of ` PetParts ` ; it is the bridge used by ~ petseq after typedness is enforced by the "Pet*" definitions. (Contributed by Peter Mazsa, 19-Feb-2026.)
theorem typesafepets (A2 R V: class):
  $ wi (wa (wcel A2 cmembparts) (wcel R V)) (wb (wbr (cxrn R (cres (ccnv cep) A2)) A2 cparts) (wbr (ccoss (cxrn R (cres (ccnv cep) A2))) A2 cers)) $;

--| Generalized partition-equivalence identification. The partition-side scheme ` PetParts ` and the equivalence-side scheme ` PetErs ` define the same class of spans (pairs ` <. r , n >. ` ). This plays the same organizational role for lifted spans that ~ mpets plays for carriers: ~ mpets identifies ` MembParts ` with ` CoMembErs ` at the membership-carrier level, while ~ petseq identifies the corresponding span-level predicates built from ` Parts ` and ` Ers ` . Unlike the earlier broad ~ pets , the bridge used here is the type-safe span theorem ~ typesafepets , which restricts to membership block-carriers. Since typedness ( ` r e. Rels ` and the appropriate carrier condition) is now built directly into ` PetParts ` and ` PetErs ` , this theorem can be used downstream without repeatedly re-establishing basic typing premises. (Contributed by Peter Mazsa, 19-Feb-2026.)
theorem petseq:
  $ wceq cpetparts cpeters $;

--| Grade-stable generalized partition-equivalence identification. After applying the same grade-stability operator ( ` SucMap ShiftStable ` ) to both sides, the grade-stable pet classes still coincide. Confirms that the grade/tower infrastructure is orthogonal to the partition-vs-equivalence viewpoint: stability is preserved under the ` PetParts = PetErs ` identification. This is the level at which we can freely work on whichever side is more convenient ( ` Parts ` for block discipline, ` Ers ` for equivalence reasoning), without changing the stable notion of "pet". (Contributed by Peter Mazsa, 19-Feb-2026.)
theorem pets2eq:
  $ wceq cpet2parts cpet2ers $;

--| Lemma for ~ prter3 . (Contributed by Rodolfo Medina, 9-Oct-2010.)
theorem prtlem60 (ph ps ch th ta: wff):
  $ wi ph (wi ps (wi ch th)) $ >
  $ wi ps (wi th ta) $ >
  $ wi ph (wi ps (wi ch ta)) $;

--| Commute two sides of a biconditional in a deduction. (Contributed by Rodolfo Medina, 19-Oct-2010.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem bicomdd (ph ps ch th: wff):
  $ wi ph (wi ps (wb ch th)) $ >
  $ wi ph (wi ps (wb th ch)) $;

--| Inference conjoining the consequents of two implications. (Contributed by Rodolfo Medina, 17-Oct-2010.)
theorem jca2r (ph ps ch th: wff):
  $ wi ph (wi ps ch) $ >
  $ wi ps th $ >
  $ wi ph (wi ps (wa th ch)) $;

--| Inference conjoining the consequents of two implications. (Contributed by Rodolfo Medina, 14-Oct-2010.)
theorem jca3 (ph ps ch th ta: wff):
  $ wi ph (wi ps ch) $ >
  $ wi th ta $ >
  $ wi ph (wi ps (wi th (wa ch ta))) $;

--| Lemma for ~ prter3 : a rearrangement of conjuncts. (Contributed by Rodolfo Medina, 20-Oct-2010.)
theorem prtlem70 (ph ps ch th ta et: wff):
  $ wb (wa (wa (wa ps et) (wa (wa ph th) (wa ch ta))) ph) (wa (wa ph (wa ps (wa ch (wa th ta)))) et) $;

--| Reverse of ~ ibd . (Contributed by Rodolfo Medina, 30-Sep-2010.)
theorem ibdr (ph ps ch: wff):
  $ wi ph (wi ch (wb ps ch)) $ >
  $ wi ph (wi ch ps) $;

--| Lemma for ~ prter3 . (Contributed by Rodolfo Medina, 19-Oct-2010.)
theorem prtlem100 {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wb (wrex x3 (wa (wcel B2 (cv x3)) ph) A2) (wrex x3 (wa (wcel B2 (cv x3)) ph) (cdif A2 (csn c0))) $;

--| Lemma for ~ prter1 , ~ prter2 , ~ prter3 and ~ prtex . (Contributed by Rodolfo Medina, 25-Sep-2010.) (Proof shortened by Mario Carneiro, 11-Dec-2016.)
theorem prtlem5 {x3 v u s1 r: setvar} (A2: class s1 r):
  $ wb (wsb v (wsb u (wrex x3 (wa (wcel (cv u) (cv x3)) (wcel (cv v) (cv x3))) A2) r) s1) (wrex x3 (wa (wcel (cv r) (cv x3)) (wcel (cv s1) (cv x3))) A2) $;

--| Lemma for ~ prter2 . (Contributed by Rodolfo Medina, 17-Oct-2010.)
theorem prtlem80 (A2 B2 C: class):
  $ wi (wcel A2 B2) (wn (wcel A2 (cdif C (csn A2)))) $;

--| A closed form of ~ brabsb . (Contributed by Rodolfo Medina, 13-Oct-2010.)
theorem brabsb2 {x3 y1 z w: setvar} (ph: wff x3 y1 z w) (R: class x3 y1 z w):
  $ wi (wceq R (copab x3 y1 ph)) (wb (wbr (cv z) (cv w) R) (wsb x3 (wsb y1 ph w) z)) $;

--| Other version of ~ eqbrrdiv . (Contributed by Rodolfo Medina, 30-Sep-2010.)
theorem eqbrrdv2 {x3 y1: setvar} (ph: wff) (A2 B2: class):
  $ wi (wa (wa (wrel A2) (wrel B2)) ph) (wb (wbr (cv x3) (cv y1) A2) (wbr (cv x3) (cv y1) B2)) $ >
  $ wi (wa (wa (wrel A2) (wrel B2)) ph) (wceq A2 B2) $;

--| Lemma for ~ prter3 . (Contributed by Rodolfo Medina, 25-Sep-2010.)
theorem prtlem9 {x3: setvar} (A2 B2: class) (c_sm: class x3):
  $ wi (wcel A2 B2) (wrex x3 (wceq (cec (cv x3) c_sm) (cec A2 c_sm)) B2) $;

--| Lemma for ~ prter3 . (Contributed by Rodolfo Medina, 14-Oct-2010.) (Revised by Mario Carneiro, 12-Aug-2015.)
theorem prtlem10 {z w v: setvar} (A2 c_sm: class z w):
  $ wi (wer A2 c_sm) (wi (wcel (cv z) A2) (wb (wbr (cv z) (cv w) c_sm) (wrex v (wa (wcel (cv z) (cec (cv v) c_sm)) (wcel (cv w) (cec (cv v) c_sm))) A2))) $;

--| Lemma for ~ prter2 . (Contributed by Rodolfo Medina, 12-Oct-2010.)
theorem prtlem11 (A2 B2 C D c_sm: class):
  $ wi (wcel B2 D) (wi (wcel C A2) (wi (wceq B2 (cec C c_sm)) (wcel B2 (cqs A2 c_sm)))) $;

--| Lemma for ~ prtex and ~ prter3 . (Contributed by Rodolfo Medina, 13-Oct-2010.)
theorem prtlem12 {x3 y1 u: setvar} (A2 c_sm: class x3 y1 u):
  $ wi (wceq c_sm (copab x3 y1 (wrex u (wa (wcel (cv x3) (cv u)) (wcel (cv y1) (cv u))) A2))) (wrel c_sm) $;

--| Lemma for ~ prter1 , ~ prter2 , ~ prter3 and ~ prtex . (Contributed by Rodolfo Medina, 13-Oct-2010.) (Revised by Mario Carneiro, 12-Aug-2015.)
theorem prtlem13 {x3 y1 z w v u: setvar} (A2: class z w) (c_sm: class x3 y1 z w v u):
  $ wceq c_sm (copab x3 y1 (wrex u (wa (wcel (cv x3) (cv u)) (wcel (cv y1) (cv u))) A2)) $ >
  $ wb (wbr (cv z) (cv w) c_sm) (wrex v (wa (wcel (cv z) (cv v)) (wcel (cv w) (cv v))) A2) $;

--| Lemma for ~ prtex , ~ prter2 and ~ prter3 . (Contributed by Rodolfo Medina, 14-Oct-2010.) (Revised by Mario Carneiro, 12-Aug-2015.)
theorem prtlem16 {x3 y1 u: setvar} (A2: class) (c_sm: class x3 y1 u):
  $ wceq c_sm (copab x3 y1 (wrex u (wa (wcel (cv x3) (cv u)) (wcel (cv y1) (cv u))) A2)) $ >
  $ wceq (cdm c_sm) (cuni A2) $;

--| Lemma for ~ prter2 and also a property of partitions . (Contributed by Rodolfo Medina, 15-Oct-2010.) (Revised by Mario Carneiro, 12-Aug-2015.)
theorem prtlem400 {x3 y1 u: setvar} (A2: class) (c_sm: class x3 y1 u):
  $ wceq c_sm (copab x3 y1 (wrex u (wa (wcel (cv x3) (cv u)) (wcel (cv y1) (cv u))) A2)) $ >
  $ wn (wcel c0 (cqs (cuni A2) c_sm)) $;

--| Extend the definition of a wff to include the partition predicate.
term wprt (A2: class): wff;

--| Define the partition predicate. (Contributed by Rodolfo Medina, 13-Oct-2010.)
axiom df_prt {x3 y1: setvar} (A2: class):
  $ wb (wprt A2) (wral x3 (wral y1 (wo (wceq (cv x3) (cv y1)) (wceq (cin (cv x3) (cv y1)) c0)) A2) A2) $;

--| The quotient set of an equivalence relation is a partition. (Contributed by Rodolfo Medina, 13-Oct-2010.)
theorem erprt (A2 c_sm X: class):
  $ wi (wer X c_sm) (wprt (cqs A2 c_sm)) $;

--| Lemma for ~ prter1 , ~ prter2 and ~ prtex . (Contributed by Rodolfo Medina, 13-Oct-2010.)
theorem prtlem14 {x3 y1 w: setvar} (A2: class w):
  $ wi (wprt A2) (wi (wa (wcel (cv x3) A2) (wcel (cv y1) A2)) (wi (wa (wcel (cv w) (cv x3)) (wcel (cv w) (cv y1))) (wceq (cv x3) (cv y1)))) $;

--| Lemma for ~ prter1 and ~ prtex . (Contributed by Rodolfo Medina, 13-Oct-2010.)
theorem prtlem15 {x3 y1 z w: setvar} (v u: setvar) (A2: class w):
  $ wi (wprt A2) (wi (wrex x3 (wrex y1 (wa (wa (wcel (cv u) (cv x3)) (wcel (cv w) (cv x3))) (wa (wcel (cv w) (cv y1)) (wcel (cv v) (cv y1)))) A2) A2) (wrex z (wa (wcel (cv u) (cv z)) (wcel (cv v) (cv z))) A2)) $;

--| Lemma for ~ prter2 . (Contributed by Rodolfo Medina, 15-Oct-2010.)
theorem prtlem17 {x3 y1 z: setvar} (w: setvar) (A2: class z):
  $ wi (wprt A2) (wi (wa (wcel (cv x3) A2) (wcel (cv z) (cv x3))) (wi (wrex y1 (wa (wcel (cv z) (cv y1)) (wcel (cv w) (cv y1))) A2) (wcel (cv w) (cv x3)))) $;

--| Lemma for ~ prter2 . (Contributed by Rodolfo Medina, 15-Oct-2010.) (Revised by Mario Carneiro, 12-Aug-2015.)
theorem prtlem18 {x3 y1 z w v u: setvar} (A2: class) (c_sm: class x3 y1 u):
  $ wceq c_sm (copab x3 y1 (wrex u (wa (wcel (cv x3) (cv u)) (wcel (cv y1) (cv u))) A2)) $ >
  $ wi (wprt A2) (wi (wa (wcel (cv v) A2) (wcel (cv z) (cv v))) (wb (wcel (cv w) (cv v)) (wbr (cv z) (cv w) c_sm))) $;

--| Lemma for ~ prter2 . (Contributed by Rodolfo Medina, 15-Oct-2010.) (Revised by Mario Carneiro, 12-Aug-2015.)
theorem prtlem19 {x3 y1 z v u: setvar} (A2: class) (c_sm: class x3 y1 u):
  $ wceq c_sm (copab x3 y1 (wrex u (wa (wcel (cv x3) (cv u)) (wcel (cv y1) (cv u))) A2)) $ >
  $ wi (wprt A2) (wi (wa (wcel (cv v) A2) (wcel (cv z) (cv v))) (wceq (cv v) (cec (cv z) c_sm))) $;

--| Every partition generates an equivalence relation. (Contributed by Rodolfo Medina, 13-Oct-2010.) (Revised by Mario Carneiro, 12-Aug-2015.)
theorem prter1 {x3 y1 u: setvar} (A2: class) (c_sm: class x3 y1 u):
  $ wceq c_sm (copab x3 y1 (wrex u (wa (wcel (cv x3) (cv u)) (wcel (cv y1) (cv u))) A2)) $ >
  $ wi (wprt A2) (wer (cuni A2) c_sm) $;

--| The equivalence relation generated by a partition is a set if and only if the partition itself is a set. (Contributed by Rodolfo Medina, 15-Oct-2010.) (Revised by Mario Carneiro, 12-Aug-2015.)
theorem prtex {x3 y1 u: setvar} (A2: class) (c_sm: class x3 y1 u):
  $ wceq c_sm (copab x3 y1 (wrex u (wa (wcel (cv x3) (cv u)) (wcel (cv y1) (cv u))) A2)) $ >
  $ wi (wprt A2) (wb (wcel c_sm cvv) (wcel A2 cvv)) $;

--| The quotient set of the equivalence relation generated by a partition equals the partition itself. (Contributed by Rodolfo Medina, 17-Oct-2010.)
theorem prter2 {x3 y1 u: setvar} (A2: class) (c_sm: class x3 y1 u):
  $ wceq c_sm (copab x3 y1 (wrex u (wa (wcel (cv x3) (cv u)) (wcel (cv y1) (cv u))) A2)) $ >
  $ wi (wprt A2) (wceq (cqs (cuni A2) c_sm) (cdif A2 (csn c0))) $;

--| For every partition there exists a unique equivalence relation whose quotient set equals the partition. (Contributed by Rodolfo Medina, 19-Oct-2010.) (Proof shortened by Mario Carneiro, 12-Aug-2015.)
theorem prter3 {x3 y1 u: setvar} (A2: class) (c_sm S: class x3 y1 u):
  $ wceq c_sm (copab x3 y1 (wrex u (wa (wcel (cv x3) (cv u)) (wcel (cv y1) (cv u))) A2)) $ >
  $ wi (wa (wer (cuni A2) S) (wceq (cqs (cuni A2) S) (cdif A2 (csn c0)))) (wceq c_sm S) $;

--| Axiom of Specialization. A universally quantified wff implies the wff without the universal quantifier (i.e., an instance, or special case, of the generalized wff). In other words, if something is true for all ` x ` , then it is true for any specific ` x ` (that would typically occur as a free variable in the wff substituted for ` ph ` ). (A free variable is one that does not occur in the scope of a quantifier: ` x ` and ` y ` are both free in ` x = y ` , but only ` x ` is free in ` A. y x = y ` .) Axiom scheme C5' in [Megill] p. 448 (p. 16 of the preprint). Also appears as Axiom B5 of [Tarski] p. 67 (under his system S2, defined in the last paragraph on p. 77). Note that the converse of this axiom does not hold in general, but a weaker inference form of the converse holds and is expressed as rule ~ ax-gen . Conditional forms of the converse are given by ~ ax-13 , ~ ax-c14 , ~ ax-c16 , and ~ ax-5 . Unlike the more general textbook Axiom of Specialization, we cannot choose a variable different from ` x ` for the special case. In our axiomatization, that requires the assistance of equality axioms, and we deal with it later after we introduce the definition of proper substitution (see ~ stdpc4 ). An interesting alternate axiomatization uses ~ axc5c711 and ~ ax-c4 in place of ~ ax-c5 , ~ ax-4 , ~ ax-10 , and ~ ax-11 . This axiom is obsolete and should no longer be used. It is proved above as Theorem ~ sp . (Contributed by NM, 3-Jan-1993.) Use ~ sp instead. (New usage is discouraged.)
axiom ax_c5 {x3: setvar} (ph: wff x3):
  $ wi (wal x3 ph) ph $;

--| Axiom of Quantified Implication. This axiom moves a universal quantifier from outside to inside an implication, quantifying ` ps ` . Notice that ` x ` must not be a free variable in the antecedent of the quantified implication, and we express this by binding ` ph ` to "protect" the axiom from a ` ph ` containing a free ` x ` . Axiom scheme C4' in [Megill] p. 448 (p. 16 of the preprint). It is a special case of Lemma 5 of [Monk2] p. 108 and Axiom 5 of [Mendelson] p. 69. This axiom is obsolete and should no longer be used. It is proved above as Theorem ~ axc4 . (Contributed by NM, 3-Jan-1993.) (New usage is discouraged.)
axiom ax_c4 {x3: setvar} (ph ps: wff x3):
  $ wi (wal x3 (wi (wal x3 ph) ps)) (wi (wal x3 ph) (wal x3 ps)) $;

--| Axiom of Quantified Negation. This axiom is used to manipulate negated quantifiers. Equivalent to axiom scheme C7' in [Megill] p. 448 (p. 16 of the preprint). An alternate axiomatization could use ~ axc5c711 in place of ~ ax-c5 , ~ ax-c7 , and ~ ax-11 . This axiom is obsolete and should no longer be used. It is proved above as Theorem ~ axc7 . (Contributed by NM, 10-Jan-1993.) (New usage is discouraged.)
axiom ax_c7 {x3: setvar} (ph: wff x3):
  $ wi (wn (wal x3 (wn (wal x3 ph)))) ph $;

--| A variant of ~ ax6 . Axiom scheme C10' in [Megill] p. 448 (p. 16 of the preprint). This axiom is obsolete and should no longer be used. It is proved above as Theorem ~ axc10 . (Contributed by NM, 10-Jan-1993.) (New usage is discouraged.)
axiom ax_c10 {x3: setvar} (ph: wff x3) (y1: setvar):
  $ wi (wal x3 (wi (wceq (cv x3) (cv y1)) (wal x3 ph))) ph $;

--| A variant of ~ ax6 . Axiom scheme C10' in [Megill] p. 448 (p. 16 of the preprint). This axiom is obsolete and should no longer be used. It is proved above as Theorem ~ axc10 . (Contributed by NM, 10-Jan-1993.) (New usage is discouraged.)
axiom ax_c10_b {x3: setvar} (ph: wff x3):
  $ wi (wal x3 (wi (wceq (cv x3) (cv x3)) (wal x3 ph))) ph $;

--| Axiom ~ ax-c11 was the original version of ~ ax-c11n ("n" for "new"), before it was discovered (in May 2008) that the shorter ~ ax-c11n could replace it. It appears as Axiom scheme C11' in [Megill] p. 448 (p. 16 of the preprint). This axiom is obsolete and should no longer be used. It is proved above as Theorem ~ axc11 . (Contributed by NM, 10-May-1993.) (New usage is discouraged.)
axiom ax_c11 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wi (wal x3 ph) (wal y1 ph)) $;

--| Axiom ~ ax-c11 was the original version of ~ ax-c11n ("n" for "new"), before it was discovered (in May 2008) that the shorter ~ ax-c11n could replace it. It appears as Axiom scheme C11' in [Megill] p. 448 (p. 16 of the preprint). This axiom is obsolete and should no longer be used. It is proved above as Theorem ~ axc11 . (Contributed by NM, 10-May-1993.) (New usage is discouraged.)
axiom ax_c11_b {x3: setvar} (ph: wff x3):
  $ wi (wal x3 (wceq (cv x3) (cv x3))) (wi (wal x3 ph) (wal x3 ph)) $;

--| Axiom of Quantifier Substitution. One of the equality and substitution axioms of predicate calculus with equality. Appears as Lemma L12 in [Megill] p. 445 (p. 12 of the preprint). The original version of this axiom was ~ ax-c11 and was replaced with this shorter ~ ax-c11n ("n" for "new") in May 2008. The old axiom is proved from this one as Theorem ~ axc11 . Conversely, this axiom is proved from ~ ax-c11 as Theorem ~ axc11nfromc11 . This axiom was proved redundant in July 2015. See Theorem ~ axc11n . This axiom is obsolete and should no longer be used. It is proved above as Theorem ~ axc11n . (Contributed by NM, 16-May-2008.) (New usage is discouraged.)
axiom ax_c11n {x3 y1: setvar}:
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wal y1 (wceq (cv y1) (cv x3))) $;

--| Axiom ~ ax-c15 was the original version of ~ ax-12 , before it was discovered (in Jan. 2007) that the shorter ~ ax-12 could replace it. It appears as Axiom scheme C15' in [Megill] p. 448 (p. 16 of the preprint). It is based on Lemma 16 of [Tarski] p. 70 and Axiom C8 of [Monk2] p. 105, from which it can be proved by cases. To understand this theorem more easily, think of " ` -. A. x x = y -> ` ..." as informally meaning "if ` x ` and ` y ` are distinct variables then..." The antecedent becomes false if the same variable is substituted for ` x ` and ` y ` , ensuring the theorem is sound whenever this is the case. In some later theorems, we call an antecedent of the form ` -. A. x x = y ` a "distinctor". Interestingly, if the wff expression substituted for ` ph ` contains no wff variables, the resulting statement _can_ be proved without invoking this axiom. This means that even though this axiom is _metalogically_ independent from the others, it is not _logically_ independent. Specifically, we can prove any wff-variable-free instance of Axiom ~ ax-c15 (from which the ~ ax-12 instance follows by Theorem ~ ax12 .) The proof is by induction on formula length, using ~ ax12eq and ~ ax12el for the basis steps and ~ ax12indn , ~ ax12indi , and ~ ax12inda for the induction steps. (This paragraph is true provided we use ~ ax-c11 in place of ~ ax-c11n .) This axiom is obsolete and should no longer be used. It is proved above as Theorem ~ axc15 , which should be used instead. (Contributed by NM, 14-May-1993.) (New usage is discouraged.)
axiom ax_c15 {x3: setvar} (ph: wff x3) (y1: setvar):
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv x3) (cv y1)) (wi ph (wal x3 (wi (wceq (cv x3) (cv y1)) ph)))) $;

--| Axiom of Quantifier Introduction. One of the equality and substitution axioms of predicate calculus with equality. Informally, it says that whenever ` z ` is distinct from ` x ` and ` y ` , and ` x = y ` is true, then ` x = y ` quantified with ` z ` is also true. In other words, ` z ` is irrelevant to the truth of ` x = y ` . Axiom scheme C9' in [Megill] p. 448 (p. 16 of the preprint). It apparently does not otherwise appear in the literature but is easily proved from textbook predicate calculus by cases. This axiom is obsolete and should no longer be used. It is proved above as Theorem ~ axc9 . (Contributed by NM, 10-Jan-1993.) (New usage is discouraged.)
axiom ax_c9 {z: setvar} (x3 y1: setvar):
  $ wi (wn (wal z (wceq (cv z) (cv x3)))) (wi (wn (wal z (wceq (cv z) (cv y1)))) (wi (wceq (cv x3) (cv y1)) (wal z (wceq (cv x3) (cv y1))))) $;

--| Axiom of Quantifier Introduction. One of the equality and substitution axioms of predicate calculus with equality. Informally, it says that whenever ` z ` is distinct from ` x ` and ` y ` , and ` x = y ` is true, then ` x = y ` quantified with ` z ` is also true. In other words, ` z ` is irrelevant to the truth of ` x = y ` . Axiom scheme C9' in [Megill] p. 448 (p. 16 of the preprint). It apparently does not otherwise appear in the literature but is easily proved from textbook predicate calculus by cases. This axiom is obsolete and should no longer be used. It is proved above as Theorem ~ axc9 . (Contributed by NM, 10-Jan-1993.) (New usage is discouraged.)
axiom ax_c9_b {z: setvar}:
  $ wi (wn (wal z (wceq (cv z) (cv z)))) (wi (wn (wal z (wceq (cv z) (cv z)))) (wi (wceq (cv z) (cv z)) (wal z (wceq (cv z) (cv z))))) $;

--| Axiom of Quantifier Introduction. One of the equality and substitution axioms of predicate calculus with equality. Informally, it says that whenever ` z ` is distinct from ` x ` and ` y ` , and ` x = y ` is true, then ` x = y ` quantified with ` z ` is also true. In other words, ` z ` is irrelevant to the truth of ` x = y ` . Axiom scheme C9' in [Megill] p. 448 (p. 16 of the preprint). It apparently does not otherwise appear in the literature but is easily proved from textbook predicate calculus by cases. This axiom is obsolete and should no longer be used. It is proved above as Theorem ~ axc9 . (Contributed by NM, 10-Jan-1993.) (New usage is discouraged.)
axiom ax_c9_b1 {z: setvar} (x3: setvar):
  $ wi (wn (wal z (wceq (cv z) (cv x3)))) (wi (wn (wal z (wceq (cv z) (cv x3)))) (wi (wceq (cv x3) (cv x3)) (wal z (wceq (cv x3) (cv x3))))) $;

--| Axiom of Quantifier Introduction. One of the equality and substitution axioms of predicate calculus with equality. Informally, it says that whenever ` z ` is distinct from ` x ` and ` y ` , and ` x = y ` is true, then ` x = y ` quantified with ` z ` is also true. In other words, ` z ` is irrelevant to the truth of ` x = y ` . Axiom scheme C9' in [Megill] p. 448 (p. 16 of the preprint). It apparently does not otherwise appear in the literature but is easily proved from textbook predicate calculus by cases. This axiom is obsolete and should no longer be used. It is proved above as Theorem ~ axc9 . (Contributed by NM, 10-Jan-1993.) (New usage is discouraged.)
axiom ax_c9_b2 {z: setvar} (y1: setvar):
  $ wi (wn (wal z (wceq (cv z) (cv z)))) (wi (wn (wal z (wceq (cv z) (cv y1)))) (wi (wceq (cv z) (cv y1)) (wal z (wceq (cv z) (cv y1))))) $;

--| Axiom of Quantifier Introduction. One of the equality and substitution axioms of predicate calculus with equality. Informally, it says that whenever ` z ` is distinct from ` x ` and ` y ` , and ` x = y ` is true, then ` x = y ` quantified with ` z ` is also true. In other words, ` z ` is irrelevant to the truth of ` x = y ` . Axiom scheme C9' in [Megill] p. 448 (p. 16 of the preprint). It apparently does not otherwise appear in the literature but is easily proved from textbook predicate calculus by cases. This axiom is obsolete and should no longer be used. It is proved above as Theorem ~ axc9 . (Contributed by NM, 10-Jan-1993.) (New usage is discouraged.)
axiom ax_c9_b3 {z: setvar} (x3: setvar):
  $ wi (wn (wal z (wceq (cv z) (cv x3)))) (wi (wn (wal z (wceq (cv z) (cv z)))) (wi (wceq (cv x3) (cv z)) (wal z (wceq (cv x3) (cv z))))) $;

--| Axiom of Quantifier Introduction. One of the equality and substitution axioms for a non-logical predicate in our predicate calculus with equality. Axiom scheme C14' in [Megill] p. 448 (p. 16 of the preprint). It is redundant if we include ~ ax-5 ; see Theorem ~ axc14 . Alternately, ~ ax-5 becomes unnecessary in principle with this axiom, but we lose the more powerful metalogic afforded by ~ ax-5 . We retain ~ ax-c14 here to provide completeness for systems with the simpler metalogic that results from omitting ~ ax-5 , which might be easier to study for some theoretical purposes. This axiom is obsolete and should no longer be used. It is proved above as Theorem ~ axc14 . (Contributed by NM, 24-Jun-1993.) (New usage is discouraged.)
axiom ax_c14 {z: setvar} (x3 y1: setvar):
  $ wi (wn (wal z (wceq (cv z) (cv x3)))) (wi (wn (wal z (wceq (cv z) (cv y1)))) (wi (wcel (cv x3) (cv y1)) (wal z (wcel (cv x3) (cv y1))))) $;

--| Axiom of Distinct Variables. The only axiom of predicate calculus requiring that variables be distinct (if we consider ~ ax-5 to be a metatheorem and not an axiom). Axiom scheme C16' in [Megill] p. 448 (p. 16 of the preprint). It apparently does not otherwise appear in the literature but is easily proved from textbook predicate calculus by cases. It is a somewhat bizarre axiom since the antecedent is always false in set theory (see ~ dtru ), but nonetheless it is technically necessary as you can see from its uses. This axiom is redundant if we include ~ ax-5 ; see Theorem ~ axc16 . Alternately, ~ ax-5 becomes logically redundant in the presence of this axiom, but without ~ ax-5 we lose the more powerful metalogic that results from being able to express the concept of a setvar variable not occurring in a wff (as opposed to just two setvar variables being distinct). We retain ~ ax-c16 here to provide logical completeness for systems with the simpler metalogic that results from omitting ~ ax-5 , which might be easier to study for some theoretical purposes. This axiom is obsolete and should no longer be used. It is proved above as Theorem ~ axc16 . (Contributed by NM, 10-Jan-1993.) (New usage is discouraged.)
axiom ax_c16 {x3: setvar} (ph: wff x3) (y1: setvar):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wi ph (wal x3 ph)) $;

--| This theorem repeats ~ sp under the name ~ axc5 , so that the Metamath program "MM> VERIFY MARKUP" command will check that it matches axiom scheme ~ ax-c5 . (Contributed by NM, 18-Aug-2017.) (Proof modification is discouraged.) Use ~ sp instead. (New usage is discouraged.)
theorem axc5 {x3: setvar} (ph: wff x3):
  $ wi (wal x3 ph) ph $;

--| Rederivation of Axiom ~ ax-4 from ~ ax-c4 , ~ ax-c5 , ~ ax-gen and minimal implicational calculus { ~ ax-mp , ~ ax-1 , ~ ax-2 }. See ~ axc4 for the derivation of ~ ax-c4 from ~ ax-4 . (Contributed by NM, 23-May-2008.) (Proof modification is discouraged.) Use ~ ax-4 instead. (New usage is discouraged.)
theorem ax4fromc4 {x3: setvar} (ph ps: wff x3):
  $ wi (wal x3 (wi ph ps)) (wi (wal x3 ph) (wal x3 ps)) $;

--| Rederivation of Axiom ~ ax-10 from ~ ax-c7 , ~ ax-c4 , ~ ax-c5 , ~ ax-gen and propositional calculus. See ~ axc7 for the derivation of ~ ax-c7 from ~ ax-10 . (Contributed by NM, 23-May-2008.) (Proof modification is discouraged.) Use ~ ax-10 instead. (New usage is discouraged.)
theorem ax10fromc7 {x3: setvar} (ph: wff x3):
  $ wi (wn (wal x3 ph)) (wal x3 (wn (wal x3 ph))) $;

--| Rederivation of Axiom ~ ax-6 from ~ ax-c7 , ~ ax-c10 , ~ ax-gen and propositional calculus. See ~ axc10 for the derivation of ~ ax-c10 from ~ ax-6 . Lemma L18 in [Megill] p. 446 (p. 14 of the preprint). (Contributed by NM, 14-May-1993.) (Proof modification is discouraged.) Use ~ ax-6 instead. (New usage is discouraged.)
theorem ax6fromc10 {x3: setvar} (y1: setvar):
  $ wn (wal x3 (wn (wceq (cv x3) (cv y1)))) $;

--| The setvar ` x ` is not free in ` A. x ph ` . Example in Appendix in [Megill] p. 450 (p. 19 of the preprint). Also Lemma 22 of [Monk2] p. 114. (Contributed by NM, 24-Jan-1993.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem hba1_o {x3: setvar} (ph: wff x3):
  $ wi (wal x3 ph) (wal x3 (wal x3 ph)) $;

--| Inference version of ~ ax-c4 . (Contributed by NM, 3-Jan-1993.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem axc4i_o {x3: setvar} (ph ps: wff x3):
  $ wi (wal x3 ph) ps $ >
  $ wi (wal x3 ph) (wal x3 ps) $;

--| Proof of ~ equid from our older axioms. This is often an axiom of equality in textbook systems, but we don't need it as an axiom since it can be proved from our other axioms (although the proof, as you can see below, is not as obvious as you might think). This proof uses only axioms without distinct variable conditions and requires no dummy variables. A simpler proof, similar to Tarski's, is possible if we make use of ~ ax-5 ; see the proof of ~ equid . See ~ equid1ALT for an alternate proof. (Contributed by NM, 10-Jan-1993.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem equid1 {x3: setvar}:
  $ wceq (cv x3) (cv x3) $;

--| Proof of ~ equcomi from ~ equid1 , avoiding use of ~ ax-5 (the only use of ~ ax-5 is via ~ ax7 , so using ~ ax-7 instead would remove dependency on ~ ax-5 ). (Contributed by BJ, 8-Jul-2021.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem equcomi1 {x3: setvar} (y1: setvar):
  $ wi (wceq (cv x3) (cv y1)) (wceq (cv y1) (cv x3)) $;

--| Proof of ~ equcomi from ~ equid1 , avoiding use of ~ ax-5 (the only use of ~ ax-5 is via ~ ax7 , so using ~ ax-7 instead would remove dependency on ~ ax-5 ). (Contributed by BJ, 8-Jul-2021.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem equcomi1_b {x3: setvar}:
  $ wi (wceq (cv x3) (cv x3)) (wceq (cv x3) (cv x3)) $;

--| Commutation law for identical variable specifiers. The antecedent and consequent are true when ` x ` and ` y ` are substituted with the same variable. Lemma L12 in [Megill] p. 445 (p. 12 of the preprint). Version of ~ aecom using ~ ax-c11 . Unlike ~ axc11nfromc11 , this version does not require ~ ax-5 (see comment of ~ equcomi1 ). (Contributed by NM, 10-May-1993.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem aecom_o {x3 y1: setvar}:
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wal y1 (wceq (cv y1) (cv x3))) $;

--| Commutation law for identical variable specifiers. The antecedent and consequent are true when ` x ` and ` y ` are substituted with the same variable. Lemma L12 in [Megill] p. 445 (p. 12 of the preprint). Version of ~ aecom using ~ ax-c11 . Unlike ~ axc11nfromc11 , this version does not require ~ ax-5 (see comment of ~ equcomi1 ). (Contributed by NM, 10-May-1993.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem aecom_o_b {x3: setvar}:
  $ wi (wal x3 (wceq (cv x3) (cv x3))) (wal x3 (wceq (cv x3) (cv x3))) $;

--| A commutation rule for identical variable specifiers. Version of ~ aecoms using ~ ax-c11 . (Contributed by NM, 10-May-1993.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem aecoms_o {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) ph $ >
  $ wi (wal y1 (wceq (cv y1) (cv x3))) ph $;

--| A commutation rule for identical variable specifiers. Version of ~ aecoms using ~ ax-c11 . (Contributed by NM, 10-May-1993.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem aecoms_o_b {x3: setvar} (ph: wff x3):
  $ wi (wal x3 (wceq (cv x3) (cv x3))) ph $ >
  $ wi (wal x3 (wceq (cv x3) (cv x3))) ph $;

--| All variables are effectively bound in an identical variable specifier. Version of ~ hbae using ~ ax-c11 . (Contributed by NM, 13-May-1993.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem hbae_o {x3 y1 z: setvar}:
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wal z (wal x3 (wceq (cv x3) (cv y1)))) $;

--| All variables are effectively bound in an identical variable specifier. Version of ~ hbae using ~ ax-c11 . (Contributed by NM, 13-May-1993.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem hbae_o_b {x3 y1: setvar}:
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wal x3 (wal x3 (wceq (cv x3) (cv y1)))) $;

--| All variables are effectively bound in an identical variable specifier. Version of ~ hbae using ~ ax-c11 . (Contributed by NM, 13-May-1993.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem hbae_o_b1 {x3 y1: setvar}:
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wal y1 (wal x3 (wceq (cv x3) (cv y1)))) $;

--| Formula-building lemma for use with the Distinctor Reduction Theorem. Part of Theorem 9.4 of [Megill] p. 448 (p. 16 of preprint). Version of ~ dral1 using ~ ax-c11 . (Contributed by NM, 24-Nov-1994.) (New usage is discouraged.)
theorem dral1_o {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb ph ps) $ >
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb (wal x3 ph) (wal y1 ps)) $;

--| Rederivation of Axiom ~ ax-12 from ~ ax-c15 , ~ ax-c11 (used through ~ dral1-o ), and other older axioms. See Theorem ~ axc15 for the derivation of ~ ax-c15 from ~ ax-12 . An open problem is whether we can prove this using ~ ax-c11n instead of ~ ax-c11 . This proof uses newer axioms ~ ax-4 and ~ ax-6 , but since these are proved from the older axioms above, this is acceptable and lets us avoid having to reprove several earlier theorems to use ~ ax-c4 and ~ ax-c10 . (Contributed by NM, 22-Jan-2007.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ax12fromc15 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wi (wal y1 ph) (wal x3 (wi (wceq (cv x3) (cv y1)) ph))) $;

--| Derive ~ ax-13 from ~ ax-c9 and other older axioms. This proof uses newer axioms ~ ax-4 and ~ ax-6 , but since these are proved from the older axioms above, this is acceptable and lets us avoid having to reprove several earlier theorems to use ~ ax-c4 and ~ ax-c10 . (Contributed by NM, 21-Dec-2015.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ax13fromc9 {x3 y1 z: setvar}:
  $ wi (wn (wceq (cv x3) (cv y1))) (wi (wceq (cv y1) (cv z)) (wal x3 (wceq (cv y1) (cv z)))) $;

--| Axiom to quantify a variable over a formula in which it does not occur. Axiom C5 in [Megill] p. 444 (p. 11 of the preprint). Also appears as Axiom B6 (p. 75) of system S2 of [Tarski] p. 77 and Axiom C5-1 of [Monk2] p. 113. (This theorem simply repeats ~ ax-5 so that we can include the following note, which applies only to the obsolete axiomatization.) This axiom is _logically_ redundant in the (logically complete) predicate calculus axiom system consisting of ~ ax-gen , ~ ax-c4 , ~ ax-c5 , ~ ax-11 , ~ ax-c7 , ~ ax-7 , ~ ax-c9 , ~ ax-c10 , ~ ax-c11 , ~ ax-8 , ~ ax-9 , ~ ax-c14 , ~ ax-c15 , and ~ ax-c16 : in that system, we can derive any instance of ~ ax-5 not containing wff variables by induction on formula length, using ~ ax5eq and ~ ax5el for the basis together with ~ hbn , ~ hbal , and ~ hbim . However, if we omit this axiom, our development would be quite inconvenient since we could work only with specific instances of wffs containing no wff variables - this axiom introduces the concept of a setvar variable not occurring in a wff (as opposed to just two setvar variables being distinct). (Contributed by NM, 19-Aug-2017.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem ax5ALT {x3: setvar} (ph: wff):
  $ wi ph (wal x3 ph) $;

--| Generalization of antecedent. (Contributed by NM, 5-Jan-1993.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem sps_o {x3: setvar} (ph ps: wff x3):
  $ wi ph ps $ >
  $ wi (wal x3 ph) ps $;

--| Bound-variable hypothesis builder for ` x = x ` . This theorem tells us that any variable, including ` x ` , is effectively not free in ` x = x ` , even though ` x ` is technically free according to the traditional definition of free variable. (The proof does not use ~ ax-c10 .) (Contributed by NM, 13-Jan-2011.) (Proof shortened by Wolf Lammen, 23-Mar-2014.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem hbequid {y1: setvar} (x3: setvar):
  $ wi (wceq (cv x3) (cv x3)) (wal y1 (wceq (cv x3) (cv x3))) $;

--| Bound-variable hypothesis builder for ` x = x ` . This theorem tells us that any variable, including ` x ` , is effectively not free in ` x = x ` , even though ` x ` is technically free according to the traditional definition of free variable. (The proof uses only ~ ax-4 , ~ ax-7 , ~ ax-c9 , and ~ ax-gen . This shows that this can be proved without ~ ax6 , even though Theorem ~ equid cannot. A shorter proof using ~ ax6 is obtainable from ~ equid and ~ hbth .) Remark added 2-Dec-2015 NM: This proof does implicitly use ~ ax6v , which is used for the derivation of ~ axc9 , unless we consider ~ ax-c9 the starting axiom rather than ~ ax-13 . (Contributed by NM, 13-Jan-2011.) (Revised by Mario Carneiro, 12-Oct-2016.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem nfequid_o {y1: setvar} (x3: setvar):
  $ wnf y1 (wceq (cv x3) (cv x3)) $;

--| Proof of a single axiom that can replace ~ ax-c5 and ~ ax-c7 . See ~ axc5c7toc5 and ~ axc5c7toc7 for the rederivation of those axioms. (Contributed by Scott Fenton, 12-Sep-2005.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem axc5c7 {x3: setvar} (ph: wff x3):
  $ wi (wi (wal x3 (wn (wal x3 ph))) (wal x3 ph)) ph $;

--| Rederivation of ~ ax-c5 from ~ axc5c7 . Only propositional calculus is used for the rederivation. (Contributed by Scott Fenton, 12-Sep-2005.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem axc5c7toc5 {x3: setvar} (ph: wff x3):
  $ wi (wal x3 ph) ph $;

--| Rederivation of ~ ax-c7 from ~ axc5c7 . Only propositional calculus is used for the rederivation. (Contributed by Scott Fenton, 12-Sep-2005.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem axc5c7toc7 {x3: setvar} (ph: wff x3):
  $ wi (wn (wal x3 (wn (wal x3 ph)))) ph $;

--| Proof of a single axiom that can replace both ~ ax-c7 and ~ ax-11 . See ~ axc711toc7 and ~ axc711to11 for the rederivation of those axioms. (Contributed by NM, 18-Nov-2006.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem axc711 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wn (wal x3 (wn (wal y1 (wal x3 ph))))) (wal y1 ph) $;

--| Proof of a single axiom that can replace both ~ ax-c7 and ~ ax-11 . See ~ axc711toc7 and ~ axc711to11 for the rederivation of those axioms. (Contributed by NM, 18-Nov-2006.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem axc711_b {x3: setvar} (ph: wff x3):
  $ wi (wn (wal x3 (wn (wal x3 (wal x3 ph))))) (wal x3 ph) $;

--| ` x ` is not free in ` A. x ph ` . (Contributed by Mario Carneiro, 11-Aug-2016.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem nfa1_o {x3: setvar} (ph: wff x3):
  $ wnf x3 (wal x3 ph) $;

--| Rederivation of ~ ax-c7 from ~ axc711 . Note that ~ ax-c7 and ~ ax-11 are not used by the rederivation. (Contributed by NM, 18-Nov-2006.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem axc711toc7 {x3: setvar} (ph: wff x3):
  $ wi (wn (wal x3 (wn (wal x3 ph)))) ph $;

--| Rederivation of ~ ax-11 from ~ axc711 . Note that ~ ax-c7 and ~ ax-11 are not used by the rederivation. (Contributed by NM, 18-Nov-2006.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem axc711to11 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wal y1 ph)) (wal y1 (wal x3 ph)) $;

--| Proof of a single axiom that can replace ~ ax-c5 , ~ ax-c7 , and ~ ax-11 in a subsystem that includes these axioms plus ~ ax-c4 and ~ ax-gen (and propositional calculus). See ~ axc5c711toc5 , ~ axc5c711toc7 , and ~ axc5c711to11 for the rederivation of those axioms. This theorem extends the idea in Scott Fenton's ~ axc5c7 . (Contributed by NM, 18-Nov-2006.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem axc5c711 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wi (wal x3 (wal y1 (wn (wal x3 (wal y1 ph))))) (wal x3 ph)) ph $;

--| Proof of a single axiom that can replace ~ ax-c5 , ~ ax-c7 , and ~ ax-11 in a subsystem that includes these axioms plus ~ ax-c4 and ~ ax-gen (and propositional calculus). See ~ axc5c711toc5 , ~ axc5c711toc7 , and ~ axc5c711to11 for the rederivation of those axioms. This theorem extends the idea in Scott Fenton's ~ axc5c7 . (Contributed by NM, 18-Nov-2006.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem axc5c711_b {x3: setvar} (ph: wff x3):
  $ wi (wi (wal x3 (wal x3 (wn (wal x3 (wal x3 ph))))) (wal x3 ph)) ph $;

--| Rederivation of ~ ax-c5 from ~ axc5c711 . Only propositional calculus is used by the rederivation. (Contributed by NM, 19-Nov-2006.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem axc5c711toc5 {x3: setvar} (ph: wff x3):
  $ wi (wal x3 ph) ph $;

--| Rederivation of ~ ax-c7 from ~ axc5c711 . Note that ~ ax-c7 and ~ ax-11 are not used by the rederivation. The use of ~ alimi (which uses ~ ax-c5 ) is allowed since we have already proved ~ axc5c711toc5 . (Contributed by NM, 19-Nov-2006.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem axc5c711toc7 {x3: setvar} (ph: wff x3):
  $ wi (wn (wal x3 (wn (wal x3 ph)))) ph $;

--| Rederivation of ~ ax-11 from ~ axc5c711 . Note that ~ ax-c7 and ~ ax-11 are not used by the rederivation. The use of ~ alimi (which uses ~ ax-c5 ) is allowed since we have already proved ~ axc5c711toc5 . (Contributed by NM, 19-Nov-2006.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem axc5c711to11 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wal y1 ph)) (wal y1 (wal x3 ph)) $;

--| ~ equid with existential quantifier without using ~ ax-c5 or ~ ax-5 . (Contributed by NM, 13-Jan-2011.) (Proof shortened by Wolf Lammen, 27-Feb-2014.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem equidqe {y1: setvar} (x3: setvar):
  $ wn (wal y1 (wn (wceq (cv x3) (cv x3)))) $;

--| A special case of ~ ax-c5 without using ~ ax-c5 or ~ ax-5 . (Contributed by NM, 13-Jan-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem axc5sp1 {y1: setvar} (x3: setvar):
  $ wi (wal y1 (wn (wceq (cv x3) (cv x3)))) (wn (wceq (cv x3) (cv x3))) $;

--| ~ equid with universal quantifier without using ~ ax-c5 or ~ ax-5 . (Contributed by NM, 13-Jan-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem equidq {y1: setvar} (x3: setvar):
  $ wal y1 (wceq (cv x3) (cv x3)) $;

--| Alternate proof of ~ equid and ~ equid1 from older axioms ~ ax-c7 , ~ ax-c10 and ~ ax-c9 . (Contributed by NM, 10-Jan-1993.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem equid1ALT {x3: setvar}:
  $ wceq (cv x3) (cv x3) $;

--| Rederivation of ~ ax-c11n from original version ~ ax-c11 . See Theorem ~ axc11 for the derivation of ~ ax-c11 from ~ ax-c11n . This theorem should not be referenced in any proof. Instead, use ~ ax-c11n above so that uses of ~ ax-c11n can be more easily identified, or use ~ aecom-o when this form is needed for studies involving ~ ax-c11 and omitting ~ ax-5 . (Contributed by NM, 16-May-2008.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem axc11nfromc11 {x3 y1: setvar}:
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wal y1 (wceq (cv y1) (cv x3))) $;

--| A commutation rule for distinct variable specifiers. Version of ~ naecoms using ~ ax-c11 . (Contributed by NM, 2-Jan-2002.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem naecoms_o {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) ph $ >
  $ wi (wn (wal y1 (wceq (cv y1) (cv x3)))) ph $;

--| All variables are effectively bound in a distinct variable specifier. Lemma L19 in [Megill] p. 446 (p. 14 of the preprint). Version of ~ hbnae using ~ ax-c11 . (Contributed by NM, 13-May-1993.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem hbnae_o {x3 y1 z: setvar}:
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wal z (wn (wal x3 (wceq (cv x3) (cv y1))))) $;

--| All variables are effectively bound in a distinct variable specifier. Lemma L19 in [Megill] p. 446 (p. 14 of the preprint). Version of ~ hbnae using ~ ax-c11 . (Contributed by NM, 13-May-1993.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem hbnae_o_b {x3 y1: setvar}:
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wal x3 (wn (wal x3 (wceq (cv x3) (cv y1))))) $;

--| All variables are effectively bound in a distinct variable specifier. Lemma L19 in [Megill] p. 446 (p. 14 of the preprint). Version of ~ hbnae using ~ ax-c11 . (Contributed by NM, 13-May-1993.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem hbnae_o_b1 {x3 y1: setvar}:
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wal y1 (wn (wal x3 (wceq (cv x3) (cv y1))))) $;

--| Proof of ~ dvelimh that uses ~ ax-c11 but not ~ ax-c15 , ~ ax-c11n , or ~ ax-12 . Version of ~ dvelimh using ~ ax-c11 instead of ~ axc11 . (Contributed by NM, 12-Nov-2002.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem dvelimf_o {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wi ph (wal x3 ph) $ >
  $ wi ps (wal z ps) $ >
  $ wi (wceq (cv z) (cv y1)) (wb ph ps) $ >
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi ps (wal x3 ps)) $;

--| Formula-building lemma for use with the Distinctor Reduction Theorem. Part of Theorem 9.4 of [Megill] p. 448 (p. 16 of preprint). Version of ~ dral2 using ~ ax-c11 . (Contributed by NM, 27-Feb-2005.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem dral2_o {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb ph ps) $ >
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb (wal z ph) (wal z ps)) $;

--| Formula-building lemma for use with the Distinctor Reduction Theorem. Part of Theorem 9.4 of [Megill] p. 448 (p. 16 of preprint). Version of ~ dral2 using ~ ax-c11 . (Contributed by NM, 27-Feb-2005.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem dral2_o_b {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb ph ps) $ >
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb (wal x3 ph) (wal x3 ps)) $;

--| Formula-building lemma for use with the Distinctor Reduction Theorem. Part of Theorem 9.4 of [Megill] p. 448 (p. 16 of preprint). Version of ~ dral2 using ~ ax-c11 . (Contributed by NM, 27-Feb-2005.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem dral2_o_b1 {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb ph ps) $ >
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb (wal y1 ph) (wal y1 ps)) $;

--| A "distinctor elimination" lemma with no disjoint variable conditions on variables in the consequent, proved without using ~ ax-c16 . Version of ~ aev using ~ ax-c11 . (Contributed by NM, 8-Nov-2006.) (Proof shortened by Andrew Salmon, 21-Jun-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem aev_o {x3 y1 z w v: setvar}:
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wal z (wceq (cv w) (cv v))) $;

--| A "distinctor elimination" lemma with no disjoint variable conditions on variables in the consequent, proved without using ~ ax-c16 . Version of ~ aev using ~ ax-c11 . (Contributed by NM, 8-Nov-2006.) (Proof shortened by Andrew Salmon, 21-Jun-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem aev_o_b {x3 y1 z: setvar}:
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wal z (wceq (cv z) (cv x3))) $;

--| Theorem to add distinct quantifier to atomic formula. (This theorem demonstrates the induction basis for ~ ax-5 considered as a metatheorem. Do not use it for later proofs - use ~ ax-5 instead, to avoid reference to the redundant axiom ~ ax-c16 .) (Contributed by NM, 10-Jan-1993.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ax5eq {z: setvar} (x3 y1: setvar):
  $ wi (wceq (cv x3) (cv y1)) (wal z (wceq (cv x3) (cv y1))) $;

--| Quantifier introduction when one pair of variables is distinct. Version of ~ dveeq2 using ~ ax-c15 . (Contributed by NM, 2-Jan-2002.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem dveeq2_o {x3 y1 z: setvar}:
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv z) (cv y1)) (wal x3 (wceq (cv z) (cv y1)))) $;

--| A generalization of Axiom ~ ax-c16 . Version of ~ axc16g using ~ ax-c11 . (Contributed by NM, 15-May-1993.) (Proof shortened by Andrew Salmon, 25-May-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem axc16g_o {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wi ph (wal z ph)) $;

--| Quantifier introduction when one pair of variables is distinct. Version of ~ dveeq1 using ax-c11 . (Contributed by NM, 2-Jan-2002.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem dveeq1_o {x3 y1: setvar} (z: setvar):
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv y1) (cv z)) (wal x3 (wceq (cv y1) (cv z)))) $;

--| Version of ~ dveeq1 using ~ ax-c16 instead of ~ ax-5 . (Contributed by NM, 29-Apr-2008.) TODO: Recover proof from older set.mm to remove use of ~ ax-5 . (Proof modification is discouraged.) (New usage is discouraged.)
theorem dveeq1_o16 {x3 y1: setvar} (z: setvar):
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv y1) (cv z)) (wal x3 (wceq (cv y1) (cv z)))) $;

--| Theorem to add distinct quantifier to atomic formula. This theorem demonstrates the induction basis for ~ ax-5 considered as a metatheorem.) (Contributed by NM, 22-Jun-1993.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ax5el {z: setvar} (x3 y1: setvar):
  $ wi (wcel (cv x3) (cv y1)) (wal z (wcel (cv x3) (cv y1))) $;

--| This theorem shows that, given ~ ax-c16 , we can derive a version of ~ ax-c11n . However, it is weaker than ~ ax-c11n because it has a distinct variable requirement. (Contributed by Andrew Salmon, 27-Jul-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem axc11n_16 {x3 z: setvar}:
  $ wi (wal x3 (wceq (cv x3) (cv z))) (wal z (wceq (cv z) (cv x3))) $;

--| Alternate proof of ~ dveel2 using ~ ax-c16 instead of ~ ax-5 . (Contributed by NM, 10-May-2008.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem dveel2ALT {x3 y1: setvar} (z: setvar):
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wcel (cv z) (cv y1)) (wal x3 (wcel (cv z) (cv y1)))) $;

--| Basis step for constructing a substitution instance of ~ ax-c15 without using ~ ax-c15 . We can start with any formula ` ph ` in which ` x ` is not free. (Contributed by NM, 21-Jan-2007.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ax12f {x3: setvar} (ph: wff x3) (y1: setvar):
  $ wi ph (wal x3 ph) $ >
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv x3) (cv y1)) (wi ph (wal x3 (wi (wceq (cv x3) (cv y1)) ph)))) $;

--| Basis step for constructing a substitution instance of ~ ax-c15 without using ~ ax-c15 . Atomic formula for equality predicate. (Contributed by NM, 22-Jan-2007.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ax12eq {x3 y1 z w: setvar}:
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv x3) (cv y1)) (wi (wceq (cv z) (cv w)) (wal x3 (wi (wceq (cv x3) (cv y1)) (wceq (cv z) (cv w)))))) $;

--| Basis step for constructing a substitution instance of ~ ax-c15 without using ~ ax-c15 . Atomic formula for membership predicate. (Contributed by NM, 22-Jan-2007.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ax12el {x3 y1 z w: setvar}:
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv x3) (cv y1)) (wi (wcel (cv z) (cv w)) (wal x3 (wi (wceq (cv x3) (cv y1)) (wcel (cv z) (cv w)))))) $;

--| Induction step for constructing a substitution instance of ~ ax-c15 without using ~ ax-c15 . Negation case. (Contributed by NM, 21-Jan-2007.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ax12indn {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv x3) (cv y1)) (wi ph (wal x3 (wi (wceq (cv x3) (cv y1)) ph)))) $ >
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv x3) (cv y1)) (wi (wn ph) (wal x3 (wi (wceq (cv x3) (cv y1)) (wn ph))))) $;

--| Induction step for constructing a substitution instance of ~ ax-c15 without using ~ ax-c15 . Implication case. (Contributed by NM, 21-Jan-2007.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ax12indi {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv x3) (cv y1)) (wi ph (wal x3 (wi (wceq (cv x3) (cv y1)) ph)))) $ >
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv x3) (cv y1)) (wi ps (wal x3 (wi (wceq (cv x3) (cv y1)) ps)))) $ >
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv x3) (cv y1)) (wi (wi ph ps) (wal x3 (wi (wceq (cv x3) (cv y1)) (wi ph ps))))) $;

--| Lemma for ~ ax12inda2 and ~ ax12inda . (Contributed by NM, 24-Jan-2007.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ax12indalem {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv x3) (cv y1)) (wi ph (wal x3 (wi (wceq (cv x3) (cv y1)) ph)))) $ >
  $ wi (wn (wal y1 (wceq (cv y1) (cv z)))) (wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv x3) (cv y1)) (wi (wal z ph) (wal x3 (wi (wceq (cv x3) (cv y1)) (wal z ph)))))) $;

--| Alternate proof of ~ ax12inda2 , slightly more direct and not requiring ~ ax-c16 . (Contributed by NM, 4-May-2007.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ax12inda2ALT {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv x3) (cv y1)) (wi ph (wal x3 (wi (wceq (cv x3) (cv y1)) ph)))) $ >
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv x3) (cv y1)) (wi (wal z ph) (wal x3 (wi (wceq (cv x3) (cv y1)) (wal z ph))))) $;

--| Induction step for constructing a substitution instance of ~ ax-c15 without using ~ ax-c15 . Quantification case. When ` z ` and ` y ` are distinct, this theorem avoids the dummy variables needed by the more general ~ ax12inda . (Contributed by NM, 24-Jan-2007.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ax12inda2 {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv x3) (cv y1)) (wi ph (wal x3 (wi (wceq (cv x3) (cv y1)) ph)))) $ >
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv x3) (cv y1)) (wi (wal z ph) (wal x3 (wi (wceq (cv x3) (cv y1)) (wal z ph))))) $;

--| Induction step for constructing a substitution instance of ~ ax-c15 without using ~ ax-c15 . Quantification case. (When ` z ` and ` y ` are distinct, ~ ax12inda2 may be used instead to avoid the dummy variable ` w ` in the proof.) (Contributed by NM, 24-Jan-2007.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ax12inda {x3 y1 z w: setvar} (ph: wff x3 y1 z):
  $ wi (wn (wal x3 (wceq (cv x3) (cv w)))) (wi (wceq (cv x3) (cv w)) (wi ph (wal x3 (wi (wceq (cv x3) (cv w)) ph)))) $ >
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv x3) (cv y1)) (wi (wal z ph) (wal x3 (wi (wceq (cv x3) (cv y1)) (wal z ph))))) $;

--| Rederivation of ~ ax-c15 from ~ ax12v (without using ~ ax-c15 or the full ~ ax-12 ). Thus, the hypothesis ( ~ ax12v ) provides an alternate axiom that can be used in place of ~ ax-c15 . See also ~ axc15 . (Contributed by NM, 2-Feb-2007.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ax12v2_o {x3 y1 z: setvar} (ph: wff x3 y1):
  $ wi (wceq (cv x3) (cv z)) (wi ph (wal x3 (wi (wceq (cv x3) (cv z)) ph))) $ >
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv x3) (cv y1)) (wi ph (wal x3 (wi (wceq (cv x3) (cv y1)) ph)))) $;

--| Derive ~ ax-c15 from a hypothesis in the form of ~ ax-12 , without using ~ ax-12 or ~ ax-c15 . The hypothesis is weaker than ~ ax-12 , with ` z ` both distinct from ` x ` and not occurring in ` ph ` . Thus, the hypothesis provides an alternate axiom that can be used in place of ~ ax-12 , if we also have ~ ax-c11 , which this proof uses. As Theorem ~ ax12 shows, the distinct variable conditions are optional. An open problem is whether we can derive this with ~ ax-c11n instead of ~ ax-c11 . (Contributed by NM, 2-Feb-2007.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ax12a2_o {x3 y1 z: setvar} (ph: wff x3 y1):
  $ wi (wceq (cv x3) (cv z)) (wi (wal z ph) (wal x3 (wi (wceq (cv x3) (cv z)) ph))) $ >
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv x3) (cv y1)) (wi ph (wal x3 (wi (wceq (cv x3) (cv y1)) ph)))) $;

--| Show that ~ ax-c11 can be derived from ~ ax-c11n and ~ ax-12 . An open problem is whether this theorem can be derived from ~ ax-c11n and the others when ~ ax-12 is replaced with ~ ax-c15 or ~ ax12v . See Theorems ~ axc11nfromc11 for the rederivation of ~ ax-c11n from ~ axc11 . Normally, ~ axc11 should be used rather than ~ ax-c11 or ~ axc11-o , except by theorems specifically studying the latter's properties. (Contributed by NM, 16-May-2008.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem axc11_o {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wi (wal x3 ph) (wal y1 ph)) $;

--| Index shift of a finite sum with a weaker "implicit substitution" hypothesis than ~ fsumshft . The proof demonstrates how this can be derived starting from from ~ fsumshft . (Contributed by NM, 1-Nov-2019.)
theorem fsumshftd {j k: setvar} (ph: wff) (A2: class j) (B2: class k) (K M N: class):
  $ wi ph (wcel K cz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi (wa ph (wcel (cv j) (co M N cfz))) (wcel A2 cc) $ >
  $ wi (wa ph (wceq (cv j) (co (cv k) K cmin))) (wceq A2 B2) $ >
  $ wi ph (wceq (csu j (co M N cfz) A2) (csu k (co (co M K caddc) (co N K caddc) cfz) B2)) $;

--| Define restricted description binder. In case it doesn't exist, we return a set which is not a member of the domain of discourse ` A ` . See also comments for ~ df-iota . (Contributed by NM, 15-Sep-2011.) (Revised by Mario Carneiro, 15-Oct-2016.) WARNING: THIS "AXIOM", WHICH IS THE OLD ~ df-riota , CONFLICTS WITH (THE NEW) ~ df-riota AND MAKES THE SYSTEM IN set.mm INCONSISTENT. IT IS TEMPORARY AND WILL BE DELETED AFTER ALL USES ARE ELIMINATED.
axiom ax_riotaBAD {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wceq (crio x3 ph A2) (cif (wreu x3 ph A2) (cio x3 (wa (wcel (cv x3) A2) ph)) (cfv (cab x3 (wcel (cv x3) A2)) cund)) $;

--| Closure of restricted iota. (Contributed by NM, 28-Feb-2013.) (Revised by Mario Carneiro, 24-Dec-2016.)
theorem riotaclbgBAD {x3: setvar} (ph: wff x3) (A2: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wreu x3 ph A2) (wcel (crio x3 ph A2) A2)) $;

--| Closure of restricted iota. (Contributed by NM, 15-Sep-2011.)
theorem riotaclbBAD {x3: setvar} (ph: wff x3) (A2: class):
  $ wcel A2 cvv $ >
  $ wb (wreu x3 ph A2) (wcel (crio x3 ph A2) A2) $;

--| Deduction version of ~ riotasv . (Contributed by NM, 4-Mar-2013.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem riotasvd {x3 y1: setvar} (ph: wff x3 y1) (ps: wff y1) (A2: class) (B2 C: class y1) (D V: class x3 y1):
  $ wi ph (wceq D (crio x3 (wral y1 (wi ps (wceq (cv x3) C)) B2) A2)) $ >
  $ wi ph (wcel D A2) $ >
  $ wi (wa ph (wcel A2 V)) (wi (wa (wcel (cv y1) B2) ps) (wceq D C)) $;

--| Value of description binder ` D ` for a single-valued class expression ` C ( y ) ` (as in e.g. ~ reusv2 ). Special case of ~ riota2f . (Contributed by NM, 2-Mar-2013.)
theorem riotasv2d {x3 y1: setvar} (ph: wff x3 y1) (ps: wff y1) (ch: wff x3 y1) (A2 B2: class) (C: class y1) (D: class x3 y1) (E: class x3) (F V: class x3 y1):
  $ wnf y1 ph $ >
  $ wi ph (wnfc y1 F) $ >
  $ wi ph (wnf y1 ch) $ >
  $ wi ph (wceq D (crio x3 (wral y1 (wi ps (wceq (cv x3) C)) B2) A2)) $ >
  $ wi (wa ph (wceq (cv y1) E)) (wb ps ch) $ >
  $ wi (wa ph (wceq (cv y1) E)) (wceq C F) $ >
  $ wi ph (wcel D A2) $ >
  $ wi ph (wcel E B2) $ >
  $ wi ph ch $ >
  $ wi (wa ph (wcel A2 V)) (wceq D F) $;

--| The value of description binder ` D ` for a single-valued class expression ` C ( y ) ` (as in e.g. ~ reusv2 ) in the form of a substitution instance. Special case of ~ riota2f . (Contributed by NM, 3-Mar-2013.) (Proof shortened by Mario Carneiro, 6-Dec-2016.)
theorem riotasv2s {x3 y1: setvar} (ph: wff y1) (A2 B2: class) (C: class y1) (D: class x3 y1) (E: class) (V: class x3 y1):
  $ wceq D (crio x3 (wral y1 (wi ph (wceq (cv x3) C)) B2) A2) $ >
  $ wi (w3a (wcel A2 V) (wcel D A2) (wa (wcel E B2) (wsbc y1 ph E))) (wceq D (csb y1 E C)) $;

--| Value of description binder ` D ` for a single-valued class expression ` C ( y ) ` (as in e.g. ~ reusv2 ). Special case of ~ riota2f . (Contributed by NM, 26-Jan-2013.) (Proof shortened by Mario Carneiro, 6-Dec-2016.)
theorem riotasv {x3 y1: setvar} (ph: wff y1) (A2: class) (B2 C: class y1) (D: class x3 y1):
  $ wcel A2 cvv $ >
  $ wceq D (crio x3 (wral y1 (wi ph (wceq (cv x3) C)) B2) A2) $ >
  $ wi (w3a (wcel D A2) (wcel (cv y1) B2) ph) (wceq D C) $;

--| A property ` ch ` holding for a representative of a single-valued class expression ` C ( y ) ` (see e.g. ~ reusv2 ) also holds for its description binder ` D ` (in the form of property ` th ` ). (Contributed by NM, 5-Mar-2013.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem riotasv3d {x3 y1: setvar} (ph: wff x3 y1) (ps: wff y1) (ch th: wff x3 y1) (A2: class) (B2 C: class y1) (D V: class x3 y1):
  $ wnf y1 ph $ >
  $ wi ph (wnf y1 th) $ >
  $ wi ph (wceq D (crio x3 (wral y1 (wi ps (wceq (cv x3) C)) B2) A2)) $ >
  $ wi (wa ph (wceq C D)) (wb ch th) $ >
  $ wi ph (wi (wa (wcel (cv y1) B2) ps) ch) $ >
  $ wi ph (wcel D A2) $ >
  $ wi ph (wrex y1 ps B2) $ >
  $ wi (wa ph (wcel A2 V)) th $;

--| A version of ~ elimhyp using explicit substitution. (Contributed by NM, 15-Jun-2019.)
theorem elimhyps {x3: setvar} (ph: wff x3) (B2: class x3):
  $ wsbc x3 ph B2 $ >
  $ wsbc x3 ph (cif ph (cv x3) B2) $;

--| A version of weak deduction theorem ~ dedth using explicit substitution. (Contributed by NM, 15-Jun-2019.)
theorem dedths {x3: setvar} (ph ps: wff x3) (B2: class x3):
  $ wsbc x3 ps (cif ph (cv x3) B2) $ >
  $ wi ph ps $;

--| Closure law for negative of reals. Demonstrates use of weak deduction theorem with explicit substitution. The proof is much longer than that of ~ renegcl . (Contributed by NM, 15-Jun-2019.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem renegclALT (A2: class):
  $ wi (wcel A2 cr) (wcel (cneg A2) cr) $;

--| Generalization of ~ elimhyps that is not useful unless we can separately prove ` |- A e. _V ` . (Contributed by NM, 13-Jun-2019.)
theorem elimhyps2 {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wsbc x3 ph B2 $ >
  $ wsbc x3 ph (cif (wsbc x3 ph A2) A2 B2) $;

--| Generalization of ~ dedths that is not useful unless we can separately prove ` |- A e. _V ` . (Contributed by NM, 13-Jun-2019.)
theorem dedths2 {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wsbc x3 ps (cif (wsbc x3 ph A2) A2 B2) $ >
  $ wi (wsbc x3 ph A2) (wsbc x3 ps A2) $;

--| A utility lemma to transfer a bound-variable hypothesis builder into a definition. (Contributed by NM, 19-Nov-2020.)
theorem nfcxfrdf {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wnfc x3 B2) $ >
  $ wi ph (wnfc x3 A2) $;

--| A deduction theorem that converts a not-free inference directly to deduction form. The first hypothesis is the hypothesis of the deduction form. The second is an equality deduction (e.g., ` ( F/_ x A -> U. { y | A. x y e. A } = U. A ) ` ) that starts from ~ abidnf . The last is assigned to the inference form (e.g., ` F/_ x U. { y | A. x y e. A } ` ) whose hypothesis is satisfied using ~ nfaba1 . (Contributed by NM, 19-Nov-2020.)
theorem nfded {x3: setvar} (ph: wff x3) (A2 B2 C: class x3):
  $ wi ph (wnfc x3 A2) $ >
  $ wi (wnfc x3 A2) (wceq B2 C) $ >
  $ wnfc x3 B2 $ >
  $ wi ph (wnfc x3 C) $;

--| A deduction theorem that converts a not-free inference directly to deduction form. The first 2 hypotheses are the hypotheses of the deduction form. The third is an equality deduction (e.g., ` ( ( F/_ x A /\ F/_ x B ) ` ` -> <. { y | A. x y e. A } , { y | A. x y e. B } >. = <. A , B >. ) ` for ~ nfopd ) that starts from ~ abidnf . The last is assigned to the inference form (e.g., ` F/_ x <. { y | A. x y e. A } , { y | A. x y e. B } >. ` for ~ nfop ) whose hypotheses are satisfied using ~ nfaba1 . (Contributed by NM, 19-Nov-2020.)
theorem nfded2 {x3: setvar} (ph: wff x3) (A2 B2 C D: class x3):
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 B2) $ >
  $ wi (wa (wnfc x3 A2) (wnfc x3 B2)) (wceq C D) $ >
  $ wnfc x3 C $ >
  $ wi ph (wnfc x3 D) $;

--| Deduction version of ~ nfuni . (Contributed by NM, 19-Nov-2020.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem nfunidALT2 {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 (cuni A2)) $;

--| Deduction version of ~ nfuni . (Contributed by NM, 19-Nov-2020.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem nfunidALT {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 (cuni A2)) $;

--| Deduction version of bound-variable hypothesis builder ~ nfop . This shows how the deduction version of a not-free theorem such as ~ nfop can be created from the corresponding not-free inference theorem. (Contributed by NM, 19-Nov-2020.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem nfopdALT {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 B2) $ >
  $ wi ph (wnfc x3 (cop A2 B2)) $;

--| Recover the commutative law of addition for complex numbers from the Abelian group structure. (Contributed by NM, 17-Mar-2013.) (Proof modification is discouraged.)
theorem cnaddcom (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co A2 B2 caddc) (co B2 A2 caddc)) $;

--| Show the commutative law for an operation ` O ` on a toy structure class ` C ` of commutative operations on ` CC ` . This illustrates how a structure class can be partially specialized. In practice, we would ordinarily define a new constant such as "CAbel" in place of ` C ` . (Contributed by NM, 17-Mar-2013.) (Proof modification is discouraged.)
theorem toycom {g2: setvar} (A2 B2 C c_pl: class g2) (K: class):
  $ wceq C (crab g2 (wceq (cfv (cv g2) cbs) cc) cabl) $ >
  $ wceq c_pl (cfv K cplusg) $ >
  $ wi (w3a (wcel K C) (wcel A2 cc) (wcel B2 cc)) (wceq (co A2 B2 c_pl) (co B2 A2 c_pl)) $;

--| Extend class notation with all 1-dim subspaces (atoms) of a left module or left vector space.
term clsa: class;

--| Extend class notation with all subspaces of a left module or left vector space that are hyperplanes.
term clsh: class;

--| Define the set of all 1-dim subspaces (atoms) of a left module or left vector space. (Contributed by NM, 9-Apr-2014.)
axiom df_lsatoms {w v: setvar}:
  $ wceq clsa (cmpt w cvv (crn (cmpt v (cdif (cfv (cv w) cbs) (csn (cfv (cv w) c0g))) (cfv (csn (cv v)) (cfv (cv w) clspn))))) $;

--| Define the set of all hyperplanes of a left module or left vector space. Also called co-atoms, these are subspaces that are one dimension less than the full space. (Contributed by NM, 29-Jun-2014.)
axiom df_lshyp {w v s1: setvar}:
  $ wceq clsh (cmpt w cvv (crab s1 (wa (wne (cv s1) (cfv (cv w) cbs)) (wrex v (wceq (cfv (cun (cv s1) (csn (cv v))) (cfv (cv w) clspn)) (cfv (cv w) cbs)) (cfv (cv w) cbs))) (cfv (cv w) clss))) $;

--| The set of all hyperplanes of a left module or left vector space. The vector ` v ` is called a generating vector for the hyperplane. (Contributed by NM, 29-Jun-2014.)
theorem lshpset {v s1: setvar} (S: class v) (H N: class v s1) (V: class s1) (W: class) (X: class v s1):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq H (cfv W clsh) $ >
  $ wi (wcel W X) (wceq H (crab s1 (wa (wne (cv s1) V) (wrex v (wceq (cfv (cun (cv s1) (csn (cv v))) N) V) V)) S)) $;

--| The predicate "is a hyperplane" (of a left module or left vector space). (Contributed by NM, 29-Jun-2014.)
theorem islshp {v: setvar} (S: class v) (U: class) (H N: class v) (V W: class) (X: class v):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq H (cfv W clsh) $ >
  $ wi (wcel W X) (wb (wcel U H) (w3a (wcel U S) (wne U V) (wrex v (wceq (cfv (cun U (csn (cv v))) N) V) V))) $;

--| Hyperplane properties expressed with subspace sum. (Contributed by NM, 3-Jul-2014.)
theorem islshpsm {v: setvar} (ph: wff) (c_po: class v) (S U: class) (H N: class v) (V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq H (cfv W clsh) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wb (wcel U H) (w3a (wcel U S) (wne U V) (wrex v (wceq (co U (cfv (csn (cv v)) N) c_po) V) V))) $;

--| A hyperplane is a subspace. (Contributed by NM, 3-Jul-2014.)
theorem lshplss (ph: wff) (S U H W: class):
  $ wceq S (cfv W clss) $ >
  $ wceq H (cfv W clsh) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel U H) $ >
  $ wi ph (wcel U S) $;

--| A hyperplane is not equal to the vector space. (Contributed by NM, 4-Jul-2014.)
theorem lshpne (ph: wff) (U H V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq H (cfv W clsh) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel U H) $ >
  $ wi ph (wne U V) $;

--| A hyperplane's generating vector does not belong to the hyperplane. (Contributed by NM, 3-Jul-2014.)
theorem lshpnel (ph: wff) (c_po U H N V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq H (cfv W clsh) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel U H) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wceq (co U (cfv (csn X) N) c_po) V) $ >
  $ wi ph (wn (wcel X U)) $;

--| The subspace sum of a hyperplane and the span of an element equals the vector space iff the element is not in the hyperplane. (Contributed by NM, 2-Oct-2014.)
theorem lshpnelb (ph: wff) (c_po U H N V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq H (cfv W clsh) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U H) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wb (wn (wcel X U)) (wceq (co U (cfv (csn X) N) c_po) V)) $;

--| Condition that determines a hyperplane. (Contributed by NM, 3-Oct-2014.) (New usage is discouraged.)
theorem lshpnel2N (ph: wff) (c_po S U H N V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq H (cfv W clsh) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wne U V) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wn (wcel X U)) $ >
  $ wi ph (wb (wcel U H) (wceq (co U (cfv (csn X) N) c_po) V)) $;

--| The member of the span in the hyperplane definition does not belong to the hyperplane. (Contributed by NM, 14-Jul-2014.) (Proof shortened by AV, 19-Jul-2022.)
theorem lshpne0 (ph: wff) (c_po U H N V W X c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq H (cfv W clsh) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel U H) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wceq (co U (cfv (csn X) N) c_po) V) $ >
  $ wi ph (wne X c_0) $;

--| A hyperplane and the span in the hyperplane definition are disjoint. (Contributed by NM, 3-Jul-2014.)
theorem lshpdisj (ph: wff) (c_po U H N V W X c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq H (cfv W clsh) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U H) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wceq (co U (cfv (csn X) N) c_po) V) $ >
  $ wi ph (wceq (cin U (cfv (csn X) N)) (csn c_0)) $;

--| If two hyperplanes are comparable, they are equal. (Contributed by NM, 9-Oct-2014.)
theorem lshpcmp (ph: wff) (T U H W: class):
  $ wceq H (cfv W clsh) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel T H) $ >
  $ wi ph (wcel U H) $ >
  $ wi ph (wb (wss T U) (wceq T U)) $;

--| The intersection of two different hyperplanes is not a hyperplane. (Contributed by NM, 29-Oct-2014.) (New usage is discouraged.)
theorem lshpinN (ph: wff) (T U H W: class):
  $ wceq H (cfv W clsh) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel T H) $ >
  $ wi ph (wcel U H) $ >
  $ wi ph (wb (wcel (cin T U) H) (wceq T U)) $;

--| The set of all 1-dim subspaces (atoms) of a left module or left vector space. (Contributed by NM, 9-Apr-2014.) (Revised by Mario Carneiro, 22-Sep-2015.)
theorem lsatset {v: setvar} (A2: class v) (N V W X c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi (wcel W X) (wceq A2 (crn (cmpt v (cdif V (csn c_0)) (cfv (csn (cv v)) N)))) $;

--| The predicate "is a 1-dim subspace (atom)" (of a left module or left vector space). (Contributed by NM, 9-Apr-2014.) (Revised by Mario Carneiro, 24-Jun-2014.)
theorem islsat {x3: setvar} (A2: class x3) (U N V W X c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi (wcel W X) (wb (wcel U A2) (wrex x3 (wceq U (cfv (csn (cv x3)) N)) (cdif V (csn c_0)))) $;

--| The span of a nonzero singleton is an atom. TODO: make this obsolete and use ~ lsatlspsn instead? (Contributed by NM, 9-Apr-2014.) (Revised by Mario Carneiro, 24-Jun-2014.)
theorem lsatlspsn2 (A2 N V W X c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi (w3a (wcel W clmod) (wcel X V) (wne X c_0)) (wcel (cfv (csn X) N) A2) $;

--| The span of a nonzero singleton is an atom. (Contributed by NM, 16-Jan-2015.)
theorem lsatlspsn (ph: wff) (A2 N V W X c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel (cfv (csn X) N) A2) $;

--| A 1-dim subspace (atom) (of a left module or left vector space) equals the span of some vector. (Contributed by NM, 1-Oct-2014.)
theorem islsati {v: setvar} (A2: class v) (U N V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi (wa (wcel W X) (wcel U A2)) (wrex v (wceq U (cfv (csn (cv v)) N)) V) $;

--| A 1-dim subspace (atom) (of a left module or left vector space) contains a nonzero vector. (Contributed by NM, 2-Jan-2015.)
theorem lsateln0 {v: setvar} (ph: wff) (A2: class v) (U W c_0: class):
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel U A2) $ >
  $ wi ph (wrex v (wne (cv v) c_0) U) $;

--| The set of 1-dim subspaces is a set of subspaces. (Contributed by NM, 9-Apr-2014.) (Revised by Mario Carneiro, 24-Jun-2014.)
theorem lsatlss (A2 S W: class):
  $ wceq S (cfv W clss) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi (wcel W clmod) (wss A2 S) $;

--| An atom is a subspace. (Contributed by NM, 25-Aug-2014.)
theorem lsatlssel (ph: wff) (A2 S U W: class):
  $ wceq S (cfv W clss) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel U A2) $ >
  $ wi ph (wcel U S) $;

--| An atom is a set of vectors. (Contributed by NM, 27-Feb-2015.)
theorem lsatssv (ph: wff) (A2 Q V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wss Q V) $;

--| A 1-dim subspace (atom) of a left module or left vector space is nonzero. ( ~ atne0 analog.) (Contributed by NM, 25-Aug-2014.)
theorem lsatn0 (ph: wff) (A2 U W c_0: class):
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel U A2) $ >
  $ wi ph (wne U (csn c_0)) $;

--| The span of a vector is an atom iff the vector is nonzero. (Contributed by NM, 4-Feb-2015.)
theorem lsatspn0 (ph: wff) (A2 N V W X c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wb (wcel (cfv (csn X) N) A2) (wne X c_0)) $;

--| The span of a vector is either an atom or the zero subspace. (Contributed by NM, 15-Mar-2015.)
theorem lsator0sp (ph: wff) (A2 N V W X c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wo (wcel (cfv (csn X) N) A2) (wceq (cfv (csn X) N) (csn c_0))) $;

--| A subspace (or any class) including an atom is nonzero. (Contributed by NM, 3-Feb-2015.)
theorem lsatssn0 (ph: wff) (A2 Q U W c_0: class):
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wss Q U) $ >
  $ wi ph (wne U (csn c_0)) $;

--| If two atoms are comparable, they are equal. ( ~ atsseq analog.) TODO: can ~ lspsncmp shorten this? (Contributed by NM, 25-Aug-2014.)
theorem lsatcmp (ph: wff) (A2 T U W: class):
  $ wceq A2 (cfv W clsa) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel T A2) $ >
  $ wi ph (wcel U A2) $ >
  $ wi ph (wb (wss T U) (wceq T U)) $;

--| If an atom is included in at-most an atom, they are equal. More general version of ~ lsatcmp . TODO: can ~ lspsncmp shorten this? (Contributed by NM, 3-Feb-2015.)
theorem lsatcmp2 (ph: wff) (A2 T U W c_0: class):
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel T A2) $ >
  $ wi ph (wo (wcel U A2) (wceq U (csn c_0))) $ >
  $ wi ph (wb (wss T U) (wceq T U)) $;

--| A nonzero vector in an atom determines the atom. (Contributed by NM, 25-Aug-2014.)
theorem lsatel (ph: wff) (A2 U N W X c_0: class):
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U A2) $ >
  $ wi ph (wcel X U) $ >
  $ wi ph (wne X c_0) $ >
  $ wi ph (wceq U (cfv (csn X) N)) $;

--| A nonzero vector in an atom determines the atom. (Contributed by NM, 3-Feb-2015.) (New usage is discouraged.)
theorem lsatelbN (ph: wff) (A2 U N V W X c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel U A2) $ >
  $ wi ph (wb (wcel X U) (wceq U (cfv (csn X) N))) $;

--| Two atoms sharing a nonzero vector are equal. (Contributed by NM, 8-Mar-2015.)
theorem lsat2el (ph: wff) (A2 P Q W X c_0: class):
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel P A2) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wne X c_0) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel X Q) $ >
  $ wi ph (wceq P Q) $;

--| Convert comparison of atom with sum of subspaces to a comparison to sum with atom. ( ~ elpaddatiN analog.) TODO: any way to shorten this? (Contributed by NM, 15-Jan-2015.)
theorem lsmsat {p: setvar} (ph: wff p) (A2 c_po Q: class) (S: class p) (T U W: class) (c_0: class p):
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wne T (csn c_0)) $ >
  $ wi ph (wss Q (co T U c_po)) $ >
  $ wi ph (wrex p (wa (wss (cv p) T) (wss Q (co (cv p) U c_po))) A2) $;

--| Show equality with the span of the sum of two vectors, one of which ( ` X ` ) is fixed in advance. Compare ~ lspfixed . (Contributed by NM, 29-May-2015.) (New usage is discouraged.)
theorem lsatfixedN {z: setvar} (ph: wff) (A2: class z) (c_pl Q N V W X Y c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wne Q (cfv (csn X) N)) $ >
  $ wi ph (wne Q (cfv (csn Y) N)) $ >
  $ wi ph (wss Q (cfv (cpr X Y) N)) $ >
  $ wi ph (wrex z (wceq Q (cfv (csn (co X (cv z) c_pl)) N)) (cdif (cfv (csn Y) N) (csn c_0))) $;

--| Subspace sum has the covering property (using spans of singletons to represent atoms). Similar to Exercise 5 of [Kalmbach] p. 153. ( ~ spansncvi analog.) Explicit atom version of ~ lsmcv . (Contributed by NM, 29-Oct-2014.)
theorem lsmsatcv (ph: wff) (A2 c_po Q S T U W: class):
  $ wceq S (cfv W clss) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi (w3a ph (wpss T U) (wss U (co T Q c_po))) (wceq U (co T Q c_po)) $;

--| The lattice of subspaces is atomic, i.e. any nonzero element is greater than or equal to some atom. ( ~ shatomici analog.) (Contributed by NM, 10-Jan-2015.)
theorem lssatomic {q: setvar} (ph: wff q) (A2: class) (S: class q) (U W: class) (c_0: class q):
  $ wceq S (cfv W clss) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wne U (csn c_0)) $ >
  $ wi ph (wrex q (wss (cv q) U) A2) $;

--| The lattice of subspaces is atomistic, i.e. any element is the supremum of its atoms. Part of proof of Theorem 16.9 of [MaedaMaeda] p. 70. Hypothesis ( ~ shatomistici analog.) (Contributed by NM, 9-Apr-2014.)
theorem lssats {x3: setvar} (A2 S U N: class) (W: class x3):
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi (wa (wcel W clmod) (wcel U S)) (wceq U (cfv (cuni (crab x3 (wss (cv x3) U) A2)) N)) $;

--| Two subspaces in a proper subset relationship imply the existence of an atom less than or equal to one but not the other. ( ~ chpssati analog.) (Contributed by NM, 11-Jan-2015.)
theorem lpssat {q: setvar} (ph: wff q) (A2 S T U W: class):
  $ wceq S (cfv W clss) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wpss T U) $ >
  $ wi ph (wrex q (wa (wss (cv q) U) (wn (wss (cv q) T))) A2) $;

--| Subspaces are relatively atomic. Remark 2 of [Kalmbach] p. 149. ( ~ chrelati analog.) (Contributed by NM, 11-Jan-2015.)
theorem lrelat {q: setvar} (ph: wff) (A2: class) (c_po: class q) (S T U W: class):
  $ wceq S (cfv W clss) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wpss T U) $ >
  $ wi ph (wrex q (wa (wpss T (co T (cv q) c_po)) (wss (co T (cv q) c_po) U)) A2) $;

--| The ordering of two subspaces is determined by the atoms under them. ( ~ chrelat3 analog.) (Contributed by NM, 29-Oct-2014.)
theorem lssatle {p: setvar} (ph: wff p) (A2 S T U W: class):
  $ wceq S (cfv W clss) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wb (wss T U) (wral p (wi (wss (cv p) T) (wss (cv p) U)) A2)) $;

--| Two subspaces in a proper subset relationship imply the existence of a 1-dim subspace less than or equal to one but not the other. ( ~ chpssati analog.) (Contributed by NM, 9-Apr-2014.)
theorem lssat {p: setvar} (A2 S U V W: class):
  $ wceq S (cfv W clss) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi (wa (w3a (wcel W clmod) (wcel U S) (wcel V S)) (wpss U V)) (wrex p (wa (wss (cv p) V) (wn (wss (cv p) U))) A2) $;

--| Hyperplane properties expressed with subspace sum and an atom. TODO: can proof be shortened? Seems long for a simple variation of ~ islshpsm . (Contributed by NM, 11-Jan-2015.)
theorem islshpat {q: setvar} (ph: wff) (A2: class q) (c_po S U: class) (H: class q) (V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq H (cfv W clsh) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wb (wcel U H) (w3a (wcel U S) (wne U V) (wrex q (wceq (co U (cv q) c_po) V) A2))) $;

--| Extend class notation with the covering relation for a left module or left vector space.
term clcv: class;

--| Define the covering relation for subspaces of a left vector space. Similar to Definition 3.2.18 of [PtakPulmannova] p. 68. Ptak/Pulmannova's notation ` A ( <oL `` W ) B ` is read " ` B ` covers ` A ` " or " ` A ` is covered by ` B ` " , and it means that ` B ` is larger than ` A ` and there is nothing in between. See ~ lcvbr for binary relation. ( ~ df-cv analog.) (Contributed by NM, 7-Jan-2015.)
axiom df_lcv {w u t s1: setvar}:
  $ wceq clcv (cmpt w cvv (copab t u (wa (wa (wcel (cv t) (cfv (cv w) clss)) (wcel (cv u) (cfv (cv w) clss))) (wa (wpss (cv t) (cv u)) (wn (wrex s1 (wa (wpss (cv t) (cv s1)) (wpss (cv s1) (cv u))) (cfv (cv w) clss))))))) $;

--| The covers relation for a left vector space (or a left module). (Contributed by NM, 7-Jan-2015.)
theorem lcvfbr {u t s1: setvar} (ph: wff u t s1) (C: class u t s1) (S W: class) (X: class u t s1):
  $ wceq S (cfv W clss) $ >
  $ wceq C (cfv W clcv) $ >
  $ wi ph (wcel W X) $ >
  $ wi ph (wceq C (copab t u (wa (wa (wcel (cv t) S) (wcel (cv u) S)) (wa (wpss (cv t) (cv u)) (wn (wrex s1 (wa (wpss (cv t) (cv s1)) (wpss (cv s1) (cv u))) S)))))) $;

--| The covers relation for a left vector space (or a left module). ( ~ cvbr analog.) (Contributed by NM, 9-Jan-2015.)
theorem lcvbr {s1: setvar} (ph: wff s1) (C: class s1) (S T U W: class) (X: class s1):
  $ wceq S (cfv W clss) $ >
  $ wceq C (cfv W clcv) $ >
  $ wi ph (wcel W X) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wb (wbr T U C) (wa (wpss T U) (wn (wrex s1 (wa (wpss T (cv s1)) (wpss (cv s1) U)) S)))) $;

--| The covers relation for a left vector space (or a left module). ( ~ cvbr2 analog.) (Contributed by NM, 9-Jan-2015.)
theorem lcvbr2 {s1: setvar} (ph: wff s1) (C: class s1) (S T U W: class) (X: class s1):
  $ wceq S (cfv W clss) $ >
  $ wceq C (cfv W clcv) $ >
  $ wi ph (wcel W X) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wb (wbr T U C) (wa (wpss T U) (wral s1 (wi (wa (wpss T (cv s1)) (wss (cv s1) U)) (wceq (cv s1) U)) S))) $;

--| The covers relation for a left vector space (or a left module). (Contributed by NM, 9-Jan-2015.)
theorem lcvbr3 {s1: setvar} (ph: wff s1) (C: class s1) (S T U W: class) (X: class s1):
  $ wceq S (cfv W clss) $ >
  $ wceq C (cfv W clcv) $ >
  $ wi ph (wcel W X) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wb (wbr T U C) (wa (wpss T U) (wral s1 (wi (wa (wss T (cv s1)) (wss (cv s1) U)) (wo (wceq (cv s1) T) (wceq (cv s1) U))) S))) $;

--| The covers relation implies proper subset. ( ~ cvpss analog.) (Contributed by NM, 7-Jan-2015.)
theorem lcvpss (ph: wff) (C S T U W X: class):
  $ wceq S (cfv W clss) $ >
  $ wceq C (cfv W clcv) $ >
  $ wi ph (wcel W X) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wbr T U C) $ >
  $ wi ph (wpss T U) $;

--| The covers relation implies no in-betweenness. ( ~ cvnbtwn analog.) (Contributed by NM, 7-Jan-2015.)
theorem lcvnbtwn (ph: wff) (C R S T U W X: class):
  $ wceq S (cfv W clss) $ >
  $ wceq C (cfv W clcv) $ >
  $ wi ph (wcel W X) $ >
  $ wi ph (wcel R S) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wbr R T C) $ >
  $ wi ph (wn (wa (wpss R U) (wpss U T))) $;

--| The covers relation is not transitive. ( ~ cvntr analog.) (Contributed by NM, 10-Jan-2015.)
theorem lcvntr (ph: wff) (C R S T U W X: class):
  $ wceq S (cfv W clss) $ >
  $ wceq C (cfv W clcv) $ >
  $ wi ph (wcel W X) $ >
  $ wi ph (wcel R S) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wbr R T C) $ >
  $ wi ph (wbr T U C) $ >
  $ wi ph (wn (wbr R U C)) $;

--| The covers relation implies no in-betweenness. ( ~ cvnbtwn2 analog.) (Contributed by NM, 7-Jan-2015.)
theorem lcvnbtwn2 (ph: wff) (C R S T U W X: class):
  $ wceq S (cfv W clss) $ >
  $ wceq C (cfv W clcv) $ >
  $ wi ph (wcel W X) $ >
  $ wi ph (wcel R S) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wbr R T C) $ >
  $ wi ph (wpss R U) $ >
  $ wi ph (wss U T) $ >
  $ wi ph (wceq U T) $;

--| The covers relation implies no in-betweenness. ( ~ cvnbtwn3 analog.) (Contributed by NM, 7-Jan-2015.)
theorem lcvnbtwn3 (ph: wff) (C R S T U W X: class):
  $ wceq S (cfv W clss) $ >
  $ wceq C (cfv W clcv) $ >
  $ wi ph (wcel W X) $ >
  $ wi ph (wcel R S) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wbr R T C) $ >
  $ wi ph (wss R U) $ >
  $ wi ph (wpss U T) $ >
  $ wi ph (wceq U R) $;

--| Subspace sum has the covering property (using spans of singletons to represent atoms). Proposition 1(ii) of [Kalmbach] p. 153. ( ~ spansncv2 analog.) (Contributed by NM, 10-Jan-2015.)
theorem lsmcv2 (ph: wff) (C c_po S U N V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq C (cfv W clcv) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wn (wss (cfv (csn X) N) U)) $ >
  $ wi ph (wbr U (co U (cfv (csn X) N) c_po) C) $;

--| If a subspace covers another, it equals the other joined with some atom. This is a consequence of relative atomicity. ( ~ cvati analog.) (Contributed by NM, 11-Jan-2015.)
theorem lcvat {q: setvar} (ph: wff) (A2: class) (C c_po: class q) (S T U W: class):
  $ wceq S (cfv W clss) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wceq C (cfv W clcv) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wbr T U C) $ >
  $ wi ph (wrex q (wceq (co T (cv q) c_po) U) A2) $;

--| An atom covers the zero subspace. ( ~ atcv0 analog.) (Contributed by NM, 7-Jan-2015.)
theorem lsatcv0 (ph: wff) (A2 C Q W c_0: class):
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wceq C (cfv W clcv) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wbr (csn c_0) Q C) $;

--| A subspace covered by an atom must be the zero subspace. ( ~ atcveq0 analog.) (Contributed by NM, 7-Jan-2015.)
theorem lsatcveq0 (ph: wff) (A2 C Q S U W c_0: class):
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wceq C (cfv W clcv) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wb (wbr U Q C) (wceq U (csn c_0))) $;

--| A subspace is an atom iff it covers the zero subspace. This could serve as an alternate definition of an atom. TODO: this is a quick-and-dirty proof that could probably be more efficient. (Contributed by NM, 14-Mar-2015.)
theorem lsat0cv (ph: wff) (A2 C S U W c_0: class):
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wceq C (cfv W clcv) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wb (wcel U A2) (wbr (csn c_0) U C)) $;

--| Lemma for ~ lcvexch . (Contributed by NM, 10-Jan-2015.)
theorem lcvexchlem1 (ph: wff) (C c_po S T U W: class):
  $ wceq S (cfv W clss) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq C (cfv W clcv) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wb (wpss T (co T U c_po)) (wpss (cin T U) U)) $;

--| Lemma for ~ lcvexch . (Contributed by NM, 10-Jan-2015.)
theorem lcvexchlem2 (ph: wff) (C c_po R S T U W: class):
  $ wceq S (cfv W clss) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq C (cfv W clcv) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel R S) $ >
  $ wi ph (wss (cin T U) R) $ >
  $ wi ph (wss R U) $ >
  $ wi ph (wceq (cin (co R T c_po) U) R) $;

--| Lemma for ~ lcvexch . (Contributed by NM, 10-Jan-2015.)
theorem lcvexchlem3 (ph: wff) (C c_po R S T U W: class):
  $ wceq S (cfv W clss) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq C (cfv W clcv) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel R S) $ >
  $ wi ph (wss T R) $ >
  $ wi ph (wss R (co T U c_po)) $ >
  $ wi ph (wceq (co (cin R U) T c_po) R) $;

--| Lemma for ~ lcvexch . (Contributed by NM, 10-Jan-2015.)
theorem lcvexchlem4 (ph: wff) (C c_po S T U W: class):
  $ wceq S (cfv W clss) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq C (cfv W clcv) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wbr T (co T U c_po) C) $ >
  $ wi ph (wbr (cin T U) U C) $;

--| Lemma for ~ lcvexch . (Contributed by NM, 10-Jan-2015.)
theorem lcvexchlem5 (ph: wff) (C c_po S T U W: class):
  $ wceq S (cfv W clss) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq C (cfv W clcv) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wbr (cin T U) U C) $ >
  $ wi ph (wbr T (co T U c_po) C) $;

--| Subspaces satisfy the exchange axiom. Lemma 7.5 of [MaedaMaeda] p. 31. ( ~ cvexchi analog.) TODO: combine some lemmas. (Contributed by NM, 10-Jan-2015.)
theorem lcvexch (ph: wff) (C c_po S T U W: class):
  $ wceq S (cfv W clss) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq C (cfv W clcv) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wb (wbr (cin T U) U C) (wbr T (co T U c_po) C)) $;

--| Covering property of Definition 7.4 of [MaedaMaeda] p. 31 and its converse. ( ~ cvp analog.) (Contributed by NM, 10-Jan-2015.)
theorem lcvp (ph: wff) (A2 C c_po Q S U W c_0: class):
  $ wceq S (cfv W clss) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wceq C (cfv W clcv) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wb (wceq (cin U Q) (csn c_0)) (wbr U (co U Q c_po) C)) $;

--| Covering property of a subspace plus an atom. ( ~ chcv1 analog.) (Contributed by NM, 10-Jan-2015.)
theorem lcv1 (ph: wff) (A2 C c_po Q S U W: class):
  $ wceq S (cfv W clss) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wceq C (cfv W clcv) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wb (wn (wss Q U)) (wbr U (co U Q c_po) C)) $;

--| Covering property of a subspace plus an atom. ( ~ chcv2 analog.) (Contributed by NM, 10-Jan-2015.)
theorem lcv2 (ph: wff) (A2 C c_po Q S U W: class):
  $ wceq S (cfv W clss) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wceq C (cfv W clcv) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wb (wpss U (co U Q c_po)) (wbr U (co U Q c_po) C)) $;

--| The atom exchange property. Proposition 1(i) of [Kalmbach] p. 140. A version of this theorem was originally proved by Hermann Grassmann in 1862. ( ~ atexch analog.) (Contributed by NM, 10-Jan-2015.)
theorem lsatexch (ph: wff) (A2 c_po Q R S U W c_0: class):
  $ wceq S (cfv W clss) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wcel R A2) $ >
  $ wi ph (wss Q (co U R c_po)) $ >
  $ wi ph (wceq (cin U Q) (csn c_0)) $ >
  $ wi ph (wss R (co U Q c_po)) $;

--| The meet of a subspace and an incomparable atom is the zero subspace. ( ~ atnssm0 analog.) (Contributed by NM, 10-Jan-2015.)
theorem lsatnle (ph: wff) (A2 Q S U W c_0: class):
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wb (wn (wss Q U)) (wceq (cin U Q) (csn c_0))) $;

--| The meet of distinct atoms is the zero subspace. ( ~ atnemeq0 analog.) (Contributed by NM, 10-Jan-2015.)
theorem lsatnem0 (ph: wff) (A2 Q R W c_0: class):
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wcel R A2) $ >
  $ wi ph (wb (wne Q R) (wceq (cin Q R) (csn c_0))) $;

--| The atom exch1ange property. ( ~ hlatexch1 analog.) (Contributed by NM, 14-Jan-2015.)
theorem lsatexch1 (ph: wff) (A2 c_po Q R S W: class):
  $ wceq c_po (cfv W clsm) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wcel R A2) $ >
  $ wi ph (wcel S A2) $ >
  $ wi ph (wss Q (co S R c_po)) $ >
  $ wi ph (wne Q S) $ >
  $ wi ph (wss R (co S Q c_po)) $;

--| If the sum of two atoms cover the zero subspace, they are equal. ( ~ atcv0eq analog.) (Contributed by NM, 10-Jan-2015.)
theorem lsatcv0eq (ph: wff) (A2 C c_po Q R W c_0: class):
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wceq C (cfv W clcv) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wcel R A2) $ >
  $ wi ph (wb (wbr (csn c_0) (co Q R c_po) C) (wceq Q R)) $;

--| Two atoms covering the zero subspace are equal. ( ~ atcv1 analog.) (Contributed by NM, 10-Jan-2015.)
theorem lsatcv1 (ph: wff) (A2 C c_po Q R S U W c_0: class):
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wceq C (cfv W clcv) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wcel R A2) $ >
  $ wi ph (wbr U (co Q R c_po) C) $ >
  $ wi ph (wb (wceq U (csn c_0)) (wceq Q R)) $;

--| Lemma for ~ lsatcvat . (Contributed by NM, 10-Jan-2015.)
theorem lsatcvatlem (ph: wff) (A2 c_po Q R S U W c_0: class):
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wcel R A2) $ >
  $ wi ph (wne U (csn c_0)) $ >
  $ wi ph (wpss U (co Q R c_po)) $ >
  $ wi ph (wn (wss Q U)) $ >
  $ wi ph (wcel U A2) $;

--| A nonzero subspace less than the sum of two atoms is an atom. ( ~ atcvati analog.) (Contributed by NM, 10-Jan-2015.)
theorem lsatcvat (ph: wff) (A2 c_po Q R S U W c_0: class):
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wcel R A2) $ >
  $ wi ph (wne U (csn c_0)) $ >
  $ wi ph (wpss U (co Q R c_po)) $ >
  $ wi ph (wcel U A2) $;

--| A subspace covered by the sum of two distinct atoms is an atom. ( ~ atcvat2i analog.) (Contributed by NM, 10-Jan-2015.)
theorem lsatcvat2 (ph: wff) (A2 C c_po Q R S U W: class):
  $ wceq S (cfv W clss) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wceq C (cfv W clcv) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wcel R A2) $ >
  $ wi ph (wne Q R) $ >
  $ wi ph (wbr U (co Q R c_po) C) $ >
  $ wi ph (wcel U A2) $;

--| A condition implying that a certain subspace is an atom. Part of Lemma 3.2.20 of [PtakPulmannova] p. 68. ( ~ atcvat3i analog.) (Contributed by NM, 11-Jan-2015.)
theorem lsatcvat3 (ph: wff) (A2 c_po Q R S U W: class):
  $ wceq S (cfv W clss) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wcel R A2) $ >
  $ wi ph (wne Q R) $ >
  $ wi ph (wn (wss R U)) $ >
  $ wi ph (wss Q (co U R c_po)) $ >
  $ wi ph (wcel (cin U (co Q R c_po)) A2) $;

--| Hyperplane properties expressed with covers relation. (Contributed by NM, 11-Jan-2015.)
theorem islshpcv (ph: wff) (C S U H V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq H (cfv W clsh) $ >
  $ wceq C (cfv W clcv) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wb (wcel U H) (wa (wcel U S) (wbr U V C))) $;

--| A subspace covered by the set of all vectors, when summed with an atom not under it, equals the set of all vectors. ( ~ 1cvrjat analog.) (Contributed by NM, 11-Jan-2015.)
theorem l1cvpat (ph: wff) (A2 C c_po Q S U V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wceq C (cfv W clcv) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wbr U V C) $ >
  $ wi ph (wn (wss Q U)) $ >
  $ wi ph (wceq (co U Q c_po) V) $;

--| Create an atom under an element covered by the lattice unity. Part of proof of Lemma B in [Crawley] p. 112. ( ~ 1cvrat analog.) (Contributed by NM, 11-Jan-2015.)
theorem l1cvat (ph: wff) (A2 C c_po Q R S U V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wceq C (cfv W clcv) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wcel R A2) $ >
  $ wi ph (wne Q R) $ >
  $ wi ph (wbr U V C) $ >
  $ wi ph (wn (wss Q U)) $ >
  $ wi ph (wcel (cin (co Q R c_po) U) A2) $;

--| Create an atom under a hyperplane. Part of proof of Lemma B in [Crawley] p. 112. ( ~ lhpat analog.) TODO: This changes ` U C V ` in ~ l1cvpat and ~ l1cvat to ` U e. H ` , which in turn change ` U e. H ` in ~ islshpcv to ` U C V ` , with a couple of conversions of span to atom. Seems convoluted. Would a direct proof be better? (Contributed by NM, 11-Jan-2015.)
theorem lshpat (ph: wff) (A2 c_po Q R S U H W: class):
  $ wceq S (cfv W clss) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq H (cfv W clsh) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U H) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wcel R A2) $ >
  $ wi ph (wne Q R) $ >
  $ wi ph (wn (wss Q U)) $ >
  $ wi ph (wcel (cin (co Q R c_po) U) A2) $;

--| Extend class notation with all linear functionals of a left module or left vector space.
term clfn: class;

--| Define the set of all linear functionals (maps from vectors to the ring) of a left module or left vector space. (Contributed by NM, 15-Apr-2014.)
axiom df_lfl {x3 y1 w f2 r: setvar}:
  $ wceq clfn (cmpt w cvv (crab f2 (wral r (wral x3 (wral y1 (wceq (cfv (co (co (cv r) (cv x3) (cfv (cv w) cvsca)) (cv y1) (cfv (cv w) cplusg)) (cv f2)) (co (co (cv r) (cfv (cv x3) (cv f2)) (cfv (cfv (cv w) csca) cmulr)) (cfv (cv y1) (cv f2)) (cfv (cfv (cv w) csca) cplusg))) (cfv (cv w) cbs)) (cfv (cv w) cbs)) (cfv (cfv (cv w) csca) cbs)) (co (cfv (cfv (cv w) csca) cbs) (cfv (cv w) cbs) cmap))) $;

--| The set of linear functionals in a left module or left vector space. (Contributed by NM, 15-Apr-2014.) (Revised by Mario Carneiro, 24-Jun-2014.)
theorem lflset {x3 y1 f2 r: setvar} (D c_pl c_pd c_x c_xp F: class x3 y1 f2 r) (K: class x3 y1) (V: class r) (W: class) (X: class x3 y1 f2 r):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq D (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq K (cfv D cbs) $ >
  $ wceq c_pd (cfv D cplusg) $ >
  $ wceq c_xp (cfv D cmulr) $ >
  $ wceq F (cfv W clfn) $ >
  $ wi (wcel W X) (wceq F (crab f2 (wral r (wral x3 (wral y1 (wceq (cfv (co (co (cv r) (cv x3) c_x) (cv y1) c_pl) (cv f2)) (co (co (cv r) (cfv (cv x3) (cv f2)) c_xp) (cfv (cv y1) (cv f2)) c_pd)) V) V) K) (co K V cmap))) $;

--| The predicate "is a linear functional". (Contributed by NM, 15-Apr-2014.)
theorem islfl {x3 y1 r: setvar} (D c_pl c_pd c_x c_xp F: class x3 y1 r) (G: class) (K: class x3 y1) (V: class r) (W: class) (X: class x3 y1 r):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq D (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq K (cfv D cbs) $ >
  $ wceq c_pd (cfv D cplusg) $ >
  $ wceq c_xp (cfv D cmulr) $ >
  $ wceq F (cfv W clfn) $ >
  $ wi (wcel W X) (wb (wcel G F) (wa (wf V K G) (wral r (wral x3 (wral y1 (wceq (cfv (co (co (cv r) (cv x3) c_x) (cv y1) c_pl) G) (co (co (cv r) (cfv (cv x3) G) c_xp) (cfv (cv y1) G) c_pd)) V) V) K))) $;

--| Property of a linear functional. ( ~ lnfnli analog.) (Contributed by NM, 16-Apr-2014.)
theorem lfli (D c_pl c_pd R c_x c_xp F G K V W X Y Z: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq D (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq K (cfv D cbs) $ >
  $ wceq c_pd (cfv D cplusg) $ >
  $ wceq c_xp (cfv D cmulr) $ >
  $ wceq F (cfv W clfn) $ >
  $ wi (w3a (wcel W Z) (wcel G F) (w3a (wcel R K) (wcel X V) (wcel Y V))) (wceq (cfv (co (co R X c_x) Y c_pl) G) (co (co R (cfv X G) c_xp) (cfv Y G) c_pd)) $;

--| Properties that determine a linear functional. TODO: use this in place of ~ islfl when it shortens the proof. (Contributed by NM, 19-Oct-2014.)
theorem islfld {x3 y1 r: setvar} (ph: wff) (D c_pl c_pd c_x c_xp F: class x3 y1 r) (G K: class) (V: class r) (W: class) (X: class x3 y1 r):
  $ wi ph (wceq V (cfv W cbs)) $ >
  $ wi ph (wceq c_pl (cfv W cplusg)) $ >
  $ wi ph (wceq D (cfv W csca)) $ >
  $ wi ph (wceq c_x (cfv W cvsca)) $ >
  $ wi ph (wceq K (cfv D cbs)) $ >
  $ wi ph (wceq c_pd (cfv D cplusg)) $ >
  $ wi ph (wceq c_xp (cfv D cmulr)) $ >
  $ wi ph (wceq F (cfv W clfn)) $ >
  $ wi ph (wf V K G) $ >
  $ wi (wa ph (w3a (wcel (cv r) K) (wcel (cv x3) V) (wcel (cv y1) V))) (wceq (cfv (co (co (cv r) (cv x3) c_x) (cv y1) c_pl) G) (co (co (cv r) (cfv (cv x3) G) c_xp) (cfv (cv y1) G) c_pd)) $ >
  $ wi ph (wcel W X) $ >
  $ wi ph (wcel G F) $;

--| A linear functional is a function from vectors to scalars. ( ~ lnfnfi analog.) (Contributed by NM, 15-Apr-2014.)
theorem lflf (D F G K V W X: class):
  $ wceq D (cfv W csca) $ >
  $ wceq K (cfv D cbs) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W clfn) $ >
  $ wi (wa (wcel W X) (wcel G F)) (wf V K G) $;

--| A linear functional value is a scalar. (Contributed by NM, 15-Apr-2014.)
theorem lflcl (D F G K V W X Y: class):
  $ wceq D (cfv W csca) $ >
  $ wceq K (cfv D cbs) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W clfn) $ >
  $ wi (w3a (wcel W Y) (wcel G F) (wcel X V)) (wcel (cfv X G) K) $;

--| A linear functional is zero at the zero vector. ( ~ lnfn0i analog.) (Contributed by NM, 16-Apr-2014.) (Revised by Mario Carneiro, 24-Jun-2014.)
theorem lfl0 (D F G W c_0 Z: class):
  $ wceq D (cfv W csca) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wceq Z (cfv W c0g) $ >
  $ wceq F (cfv W clfn) $ >
  $ wi (wa (wcel W clmod) (wcel G F)) (wceq (cfv Z G) c_0) $;

--| Property of a linear functional. ( ~ lnfnaddi analog.) (Contributed by NM, 18-Apr-2014.)
theorem lfladd (D c_pl c_pd F G V W X Y: class):
  $ wceq D (cfv W csca) $ >
  $ wceq c_pd (cfv D cplusg) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq F (cfv W clfn) $ >
  $ wi (w3a (wcel W clmod) (wcel G F) (wa (wcel X V) (wcel Y V))) (wceq (cfv (co X Y c_pl) G) (co (cfv X G) (cfv Y G) c_pd)) $;

--| Property of a linear functional. ( ~ lnfnaddi analog.) (Contributed by NM, 18-Apr-2014.)
theorem lflsub (D F G M c_mi V W X Y: class):
  $ wceq D (cfv W csca) $ >
  $ wceq M (cfv D csg) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq c_mi (cfv W csg) $ >
  $ wceq F (cfv W clfn) $ >
  $ wi (w3a (wcel W clmod) (wcel G F) (wa (wcel X V) (wcel Y V))) (wceq (cfv (co X Y c_mi) G) (co (cfv X G) (cfv Y G) M)) $;

--| Property of a linear functional. ( ~ lnfnmuli analog.) (Contributed by NM, 16-Apr-2014.)
theorem lflmul (D R c_x c_xp F G K V W X: class):
  $ wceq D (cfv W csca) $ >
  $ wceq K (cfv D cbs) $ >
  $ wceq c_xp (cfv D cmulr) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq F (cfv W clfn) $ >
  $ wi (w3a (wcel W clmod) (wcel G F) (wa (wcel R K) (wcel X V))) (wceq (cfv (co R X c_x) G) (co R (cfv X G) c_xp)) $;

--| The zero function is a functional. (Contributed by NM, 16-Apr-2014.)
theorem lfl0f (D F V W c_0: class):
  $ wceq D (cfv W csca) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W clfn) $ >
  $ wi (wcel W clmod) (wcel (cxp V (csn c_0)) F) $;

--| A nonzero functional has a value of 1 at some argument. (Contributed by NM, 16-Apr-2014.)
theorem lfl1 {x3: setvar} (D c_1: class) (F: class x3) (G V W: class) (c_0: class x3):
  $ wceq D (cfv W csca) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wceq c_1 (cfv D cur) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W clfn) $ >
  $ wi (w3a (wcel W clvec) (wcel G F) (wne G (cxp V (csn c_0)))) (wrex x3 (wceq (cfv (cv x3) G) c_1) V) $;

--| Closure of addition of two functionals. (Contributed by NM, 19-Oct-2014.)
theorem lfladdcl (ph: wff) (c_pl R F G H W: class):
  $ wceq R (cfv W csca) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq F (cfv W clfn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel H F) $ >
  $ wi ph (wcel (co G H (cof c_pl)) F) $;

--| Commutativity of functional addition. (Contributed by NM, 19-Oct-2014.)
theorem lfladdcom (ph: wff) (c_pl R F G H W: class):
  $ wceq R (cfv W csca) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq F (cfv W clfn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel H F) $ >
  $ wi ph (wceq (co G H (cof c_pl)) (co H G (cof c_pl))) $;

--| Associativity of functional addition. (Contributed by NM, 19-Oct-2014.)
theorem lfladdass (ph: wff) (c_pl R F G H I W: class):
  $ wceq R (cfv W csca) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq F (cfv W clfn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel H F) $ >
  $ wi ph (wcel I F) $ >
  $ wi ph (wceq (co (co G H (cof c_pl)) I (cof c_pl)) (co G (co H I (cof c_pl)) (cof c_pl))) $;

--| Functional addition with the zero functional. (Contributed by NM, 21-Oct-2014.)
theorem lfladd0l (ph: wff) (c_pl R F G V W c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq R (cfv W csca) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq F (cfv W clfn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wceq (co (cxp V (csn c_0)) G (cof c_pl)) G) $;

--| Closure of the negative of a functional. (This is specialized for the purpose of proving ~ ldualgrp , and we do not define a general operation here.) (Contributed by NM, 22-Oct-2014.)
theorem lflnegcl {x3: setvar} (ph: wff) (R: class) (F: class x3) (G I: class) (N: class x3) (V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq R (cfv W csca) $ >
  $ wceq I (cfv R cminusg) $ >
  $ wceq N (cmpt x3 V (cfv (cfv (cv x3) G) I)) $ >
  $ wceq F (cfv W clfn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel N F) $;

--| A functional plus its negative is the zero functional. (This is specialized for the purpose of proving ~ ldualgrp , and we do not define a general operation here.) (Contributed by NM, 22-Oct-2014.)
theorem lflnegl {x3: setvar} (ph: wff) (c_pl: class x3) (R: class) (F: class x3) (G I: class) (N: class x3) (V W: class) (c_0: class x3):
  $ wceq V (cfv W cbs) $ >
  $ wceq R (cfv W csca) $ >
  $ wceq I (cfv R cminusg) $ >
  $ wceq N (cmpt x3 V (cfv (cfv (cv x3) G) I)) $ >
  $ wceq F (cfv W clfn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel G F) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wceq (co N G (cof c_pl)) (cxp V (csn c_0))) $;

--| Closure of a scalar product with a functional. Note that this is the scalar product for a right vector space with the scalar after the vector; reversing these fails closure. (Contributed by NM, 9-Oct-2014.) (Revised by Mario Carneiro, 22-Apr-2015.)
theorem lflvscl (ph: wff) (D R c_x F G K V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq D (cfv W csca) $ >
  $ wceq K (cfv D cbs) $ >
  $ wceq c_x (cfv D cmulr) $ >
  $ wceq F (cfv W clfn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel R K) $ >
  $ wi ph (wcel (co G (cxp V (csn R)) (cof c_x)) F) $;

--| Distributive law for (right vector space) scalar product of functionals. (Contributed by NM, 19-Oct-2014.)
theorem lflvsdi1 (ph: wff) (c_pl R c_x F G H K V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq R (cfv W csca) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq F (cfv W clfn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X K) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel H F) $ >
  $ wi ph (wceq (co (co G H (cof c_pl)) (cxp V (csn X)) (cof c_x)) (co (co G (cxp V (csn X)) (cof c_x)) (co H (cxp V (csn X)) (cof c_x)) (cof c_pl))) $;

--| Reverse distributive law for (right vector space) scalar product of functionals. (Contributed by NM, 19-Oct-2014.)
theorem lflvsdi2 (ph: wff) (c_pl R c_x F G K V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq R (cfv W csca) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq F (cfv W clfn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X K) $ >
  $ wi ph (wcel Y K) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wceq (co G (co (cxp V (csn X)) (cxp V (csn Y)) (cof c_pl)) (cof c_x)) (co (co G (cxp V (csn X)) (cof c_x)) (co G (cxp V (csn Y)) (cof c_x)) (cof c_pl))) $;

--| Reverse distributive law for (right vector space) scalar product of functionals. (Contributed by NM, 21-Oct-2014.)
theorem lflvsdi2a (ph: wff) (c_pl R c_x F G K V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq R (cfv W csca) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq F (cfv W clfn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X K) $ >
  $ wi ph (wcel Y K) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wceq (co G (cxp V (csn (co X Y c_pl))) (cof c_x)) (co (co G (cxp V (csn X)) (cof c_x)) (co G (cxp V (csn Y)) (cof c_x)) (cof c_pl))) $;

--| Associative law for (right vector space) scalar product of functionals. (Contributed by NM, 19-Oct-2014.)
theorem lflvsass (ph: wff) (R c_x F G K V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq R (cfv W csca) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq F (cfv W clfn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X K) $ >
  $ wi ph (wcel Y K) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wceq (co G (cxp V (csn (co X Y c_x))) (cof c_x)) (co (co G (cxp V (csn X)) (cof c_x)) (cxp V (csn Y)) (cof c_x))) $;

--| The (right vector space) scalar product of a functional with zero is the zero functional. Note that the first occurrence of ` ( V X. { .0. } ) ` represents the zero scalar, and the second is the zero functional. (Contributed by NM, 7-Oct-2014.)
theorem lfl0sc (ph: wff) (D c_x F G K V W c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq D (cfv W csca) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq K (cfv D cbs) $ >
  $ wceq c_x (cfv D cmulr) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wceq (co G (cxp V (csn c_0)) (cof c_x)) (cxp V (csn c_0))) $;

--| The scalar product with the zero functional is the zero functional. (Contributed by NM, 7-Oct-2014.) (New usage is discouraged.)
theorem lflsc0N (ph: wff) (D c_x K V W X c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq D (cfv W csca) $ >
  $ wceq K (cfv D cbs) $ >
  $ wceq c_x (cfv D cmulr) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X K) $ >
  $ wi ph (wceq (co (cxp V (csn c_0)) (cxp V (csn X)) (cof c_x)) (cxp V (csn c_0))) $;

--| The (right vector space) scalar product of a functional with one is the functional. (Contributed by NM, 21-Oct-2014.)
theorem lfl1sc (ph: wff) (D c_x c_1 F G K V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq D (cfv W csca) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq K (cfv D cbs) $ >
  $ wceq c_x (cfv D cmulr) $ >
  $ wceq c_1 (cfv D cur) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wceq (co G (cxp V (csn c_1)) (cof c_x)) G) $;

--| Extend class notation with the kernel of a functional (set of vectors whose functional value is zero) on a left module or left vector space.
term clk: class;

--| Define the kernel of a functional (set of vectors whose functional value is zero) on a left module or left vector space. (Contributed by NM, 15-Apr-2014.)
axiom df_lkr {w f2: setvar}:
  $ wceq clk (cmpt w cvv (cmpt f2 (cfv (cv w) clfn) (cima (ccnv (cv f2)) (csn (cfv (cfv (cv w) csca) c0g))))) $;

--| The kernel of a functional. (Contributed by NM, 15-Apr-2014.) (Revised by Mario Carneiro, 24-Jun-2014.)
theorem lkrfval {f2: setvar} (D: class f2) (F: class) (K: class f2) (W: class) (X c_0: class f2):
  $ wceq D (cfv W csca) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq K (cfv W clk) $ >
  $ wi (wcel W X) (wceq K (cmpt f2 F (cima (ccnv (cv f2)) (csn c_0)))) $;

--| Value of the kernel of a functional. (Contributed by NM, 15-Apr-2014.)
theorem lkrval (D F G K W X c_0: class):
  $ wceq D (cfv W csca) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq K (cfv W clk) $ >
  $ wi (wa (wcel W X) (wcel G F)) (wceq (cfv G K) (cima (ccnv G) (csn c_0))) $;

--| Membership in the kernel of a functional. ( ~ elnlfn analog.) (Contributed by NM, 16-Apr-2014.)
theorem ellkr (D F G K V W X Y c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq D (cfv W csca) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq K (cfv W clk) $ >
  $ wi (wa (wcel W Y) (wcel G F)) (wb (wcel X (cfv G K)) (wa (wcel X V) (wceq (cfv X G) c_0))) $;

--| Value of the kernel of a functional. (Contributed by NM, 15-Apr-2014.)
theorem lkrval2 {x3: setvar} (D: class x3) (F G K: class) (V: class x3) (W: class) (X c_0: class x3):
  $ wceq V (cfv W cbs) $ >
  $ wceq D (cfv W csca) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq K (cfv W clk) $ >
  $ wi (wa (wcel W X) (wcel G F)) (wceq (cfv G K) (crab x3 (wceq (cfv (cv x3) G) c_0) V)) $;

--| Membership in the kernel of a functional. (Contributed by NM, 12-Jan-2015.)
theorem ellkr2 (ph: wff) (D F G K V W X Y c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq D (cfv W csca) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq K (cfv W clk) $ >
  $ wi ph (wcel W Y) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wb (wcel X (cfv G K)) (wceq (cfv X G) c_0)) $;

--| A member of the kernel of a functional is a vector. (Contributed by NM, 16-Apr-2014.)
theorem lkrcl (F G K V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq K (cfv W clk) $ >
  $ wi (w3a (wcel W Y) (wcel G F) (wcel X (cfv G K))) (wcel X V) $;

--| The value of a functional at a member of its kernel is zero. (Contributed by NM, 16-Apr-2014.)
theorem lkrf0 (D F G K W X Y c_0: class):
  $ wceq D (cfv W csca) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq K (cfv W clk) $ >
  $ wi (w3a (wcel W Y) (wcel G F) (wcel X (cfv G K))) (wceq (cfv X G) c_0) $;

--| The kernel of the zero functional is the set of all vectors. (Contributed by NM, 17-Apr-2014.)
theorem lkr0f (D F G K V W c_0: class):
  $ wceq D (cfv W csca) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq K (cfv W clk) $ >
  $ wi (wa (wcel W clmod) (wcel G F)) (wb (wceq (cfv G K) V) (wceq G (cxp V (csn c_0)))) $;

--| The kernel of a linear functional is a subspace. ( ~ nlelshi analog.) (Contributed by NM, 16-Apr-2014.)
theorem lkrlss (S F G K W: class):
  $ wceq F (cfv W clfn) $ >
  $ wceq K (cfv W clk) $ >
  $ wceq S (cfv W clss) $ >
  $ wi (wa (wcel W clmod) (wcel G F)) (wcel (cfv G K) S) $;

--| The kernel of a linear functional is a set of vectors. (Contributed by NM, 1-Jan-2015.)
theorem lkrssv (ph: wff) (F G K V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq K (cfv W clk) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wss (cfv G K) V) $;

--| The kernel of a nonzero scalar product of a functional equals the kernel of the functional. (Contributed by NM, 9-Oct-2014.)
theorem lkrsc (ph: wff) (D R c_x F G K L V W c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq D (cfv W csca) $ >
  $ wceq K (cfv D cbs) $ >
  $ wceq c_x (cfv D cmulr) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq L (cfv W clk) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel R K) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wi ph (wne R c_0) $ >
  $ wi ph (wceq (cfv (co G (cxp V (csn R)) (cof c_x)) L) (cfv G L)) $;

--| The kernel of a scalar product of a functional includes the kernel of the functional. (The inclusion is proper for the zero product and equality otherwise.) (Contributed by NM, 9-Oct-2014.)
theorem lkrscss (ph: wff) (D R c_x F G K L V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq D (cfv W csca) $ >
  $ wceq K (cfv D cbs) $ >
  $ wceq c_x (cfv D cmulr) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq L (cfv W clk) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel R K) $ >
  $ wi ph (wss (cfv G L) (cfv (co G (cxp V (csn R)) (cof c_x)) L)) $;

--| Two functionals with the same kernel are the same up to a constant. (Contributed by NM, 18-Apr-2014.)
theorem eqlkr {x3 r: setvar} (D: class) (c_x: class x3) (F: class r) (G H: class) (K: class x3) (L: class r) (V: class) (W: class r):
  $ wceq D (cfv W csca) $ >
  $ wceq K (cfv D cbs) $ >
  $ wceq c_x (cfv D cmulr) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq L (cfv W clk) $ >
  $ wi (w3a (wcel W clvec) (wa (wcel G F) (wcel H F)) (wceq (cfv G L) (cfv H L))) (wrex r (wral x3 (wceq (cfv (cv x3) H) (co (cfv (cv x3) G) (cv r) c_x)) V) K) $;

--| Two functionals with the same kernel are the same up to a constant. (Contributed by NM, 10-Oct-2014.)
theorem eqlkr2 {r: setvar} (D c_x F G H K L V W: class):
  $ wceq D (cfv W csca) $ >
  $ wceq K (cfv D cbs) $ >
  $ wceq c_x (cfv D cmulr) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq L (cfv W clk) $ >
  $ wi (w3a (wcel W clvec) (wa (wcel G F) (wcel H F)) (wceq (cfv G L) (cfv H L))) (wrex r (wceq H (co G (cxp V (csn (cv r))) (cof c_x))) K) $;

--| Two functionals with the same kernel are equal if they are equal at any nonzero value. (Contributed by NM, 2-Jan-2015.)
theorem eqlkr3 (ph: wff) (R S F G H K V W X c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W csca) $ >
  $ wceq R (cfv S cbs) $ >
  $ wceq c_0 (cfv S c0g) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq K (cfv W clk) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel H F) $ >
  $ wi ph (wceq (cfv G K) (cfv H K)) $ >
  $ wi ph (wceq (cfv X G) (cfv X H)) $ >
  $ wi ph (wne (cfv X G) c_0) $ >
  $ wi ph (wceq G H) $;

--| The subspace sum of a kernel and the span of a vector not in the kernel (by ~ ellkr ) is the whole vector space. (Contributed by NM, 19-Apr-2014.)
theorem lkrlsp (D c_po F G K N V W X c_0: class):
  $ wceq D (cfv W csca) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq K (cfv W clk) $ >
  $ wi (w3a (wcel W clvec) (wa (wcel X V) (wcel G F)) (wne (cfv X G) c_0)) (wceq (co (cfv G K) (cfv (csn X) N) c_po) V) $;

--| The subspace sum of a kernel and the span of a vector not in the kernel is the whole vector space. (Contributed by NM, 12-May-2014.)
theorem lkrlsp2 (c_po F G K N V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq K (cfv W clk) $ >
  $ wi (w3a (wcel W clvec) (wa (wcel X V) (wcel G F)) (wn (wcel X (cfv G K)))) (wceq (co (cfv G K) (cfv (csn X) N) c_po) V) $;

--| The subspace sum of a kernel and the span of a vector not in the kernel is the whole vector space. (Contributed by NM, 29-Jun-2014.)
theorem lkrlsp3 (F G K N V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq K (cfv W clk) $ >
  $ wi (w3a (wcel W clvec) (wa (wcel X V) (wcel G F)) (wn (wcel X (cfv G K)))) (wceq (cfv (cun (cfv G K) (csn X)) N) V) $;

--| The kernel of a nonzero functional is a hyperplane. (Contributed by NM, 29-Jun-2014.)
theorem lkrshp (D F G H K V W c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq D (cfv W csca) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wceq H (cfv W clsh) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq K (cfv W clk) $ >
  $ wi (w3a (wcel W clvec) (wcel G F) (wne G (cxp V (csn c_0)))) (wcel (cfv G K) H) $;

--| The kernels of nonzero functionals are hyperplanes. (Contributed by NM, 17-Jul-2014.)
theorem lkrshp3 (ph: wff) (D F G H K V W c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq D (cfv W csca) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wceq H (cfv W clsh) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq K (cfv W clk) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wb (wcel (cfv G K) H) (wne G (cxp V (csn c_0)))) $;

--| The kernel of a functional is either a hyperplane or the full vector space. (Contributed by NM, 7-Oct-2014.)
theorem lkrshpor (ph: wff) (F G H K V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq H (cfv W clsh) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq K (cfv W clk) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wo (wcel (cfv G K) H) (wceq (cfv G K) V)) $;

--| A kernel is a hyperplane iff it doesn't contain all vectors. (Contributed by NM, 1-Nov-2014.)
theorem lkrshp4 (ph: wff) (F G H K V W: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq H (cfv W clsh) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq K (cfv W clk) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wb (wne (cfv G K) V) (wcel (cfv G K) H)) $;

--| Lemma for ~ lshpkrex . Show uniqueness of ring multiplier ` k ` when a vector ` X ` is broken down into components, one in a hyperplane and the other outside of it . TODO: do we need the ~ cbvrexv for ` a ` to ` c ` ? (Contributed by NM, 4-Jan-2015.)
theorem lshpsmreu {y1 k: setvar} (ph: wff y1 k) (D: class y1 k) (c_pl: class) (c_po: class y1 k) (c_x U: class) (H: class y1 k) (K: class y1) (N V W: class y1 k) (X Z: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq H (cfv W clsh) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U H) $ >
  $ wi ph (wcel Z V) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wceq (co U (cfv (csn Z) N) c_po) V) $ >
  $ wceq D (cfv W csca) $ >
  $ wceq K (cfv D cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wi ph (wreu k (wrex y1 (wceq X (co (cv y1) (co (cv k) Z c_x) c_pl)) U) K) $;

--| Lemma for ~ lshpkrex . The value of tentative functional ` G ` is zero iff its argument belongs to hyperplane ` U ` . (Contributed by NM, 14-Jul-2014.)
theorem lshpkrlem1 {x3 y1 k: setvar} (ph: wff x3 y1 k) (D: class x3 y1 k) (c_pl: class) (c_po: class x3 y1 k) (c_x U: class) (G H: class x3 y1 k) (K: class y1) (N: class x3 y1 k) (V: class y1 k) (W: class x3 y1 k) (X: class) (c_0: class x3 y1) (Z: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq H (cfv W clsh) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U H) $ >
  $ wi ph (wcel Z V) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wceq (co U (cfv (csn Z) N) c_po) V) $ >
  $ wceq D (cfv W csca) $ >
  $ wceq K (cfv D cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wceq G (cmpt x3 V (crio k (wrex y1 (wceq (cv x3) (co (cv y1) (co (cv k) Z c_x) c_pl)) U) K)) $ >
  $ wi ph (wb (wcel X U) (wceq (cfv X G) c_0)) $;

--| Lemma for ~ lshpkrex . The value of tentative functional ` G ` is a scalar. (Contributed by NM, 16-Jul-2014.)
theorem lshpkrlem2 {x3 y1 k: setvar} (ph: wff x3 y1 k) (D: class x3 y1 k) (c_pl: class) (c_po: class x3 y1 k) (c_x U: class) (G H: class x3 y1 k) (K: class y1) (N: class x3 y1 k) (V: class y1 k) (W: class x3 y1 k) (X: class) (c_0: class x3 y1) (Z: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq H (cfv W clsh) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U H) $ >
  $ wi ph (wcel Z V) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wceq (co U (cfv (csn Z) N) c_po) V) $ >
  $ wceq D (cfv W csca) $ >
  $ wceq K (cfv D cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wceq G (cmpt x3 V (crio k (wrex y1 (wceq (cv x3) (co (cv y1) (co (cv k) Z c_x) c_pl)) U) K)) $ >
  $ wi ph (wcel (cfv X G) K) $;

--| Lemma for ~ lshpkrex . Defining property of ` G `` X ` . (Contributed by NM, 15-Jul-2014.)
theorem lshpkrlem3 {x3 y1 z k: setvar} (ph: wff x3 y1 z k) (D: class x3 y1 z k) (c_pl: class) (c_po: class x3 y1 z k) (c_x U: class) (G: class x3 y1 k) (H: class x3 y1 z k) (K: class y1 z) (N: class x3 y1 z k) (V: class y1 z k) (W: class x3 y1 z k) (X: class) (c_0: class x3 y1 z) (Z: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq H (cfv W clsh) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U H) $ >
  $ wi ph (wcel Z V) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wceq (co U (cfv (csn Z) N) c_po) V) $ >
  $ wceq D (cfv W csca) $ >
  $ wceq K (cfv D cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wceq G (cmpt x3 V (crio k (wrex y1 (wceq (cv x3) (co (cv y1) (co (cv k) Z c_x) c_pl)) U) K)) $ >
  $ wi ph (wrex z (wceq X (co (cv z) (co (cfv X G) Z c_x) c_pl)) U) $;

--| Lemma for ~ lshpkrex . Part of showing linearity of ` G ` . (Contributed by NM, 16-Jul-2014.)
theorem lshpkrlem4 {x3 y1 k: setvar} (ph: wff x3 y1 k) (v u: setvar) (D: class x3 y1 k) (c_pl: class) (c_po: class x3 y1 k) (c_x U: class) (G H: class x3 y1 k) (K: class y1) (N: class x3 y1 k) (V: class y1 k) (W: class x3 y1 k) (X: class) (c_0: class x3 y1) (Z: class) (s1 r l: setvar):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq H (cfv W clsh) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U H) $ >
  $ wi ph (wcel Z V) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wceq (co U (cfv (csn Z) N) c_po) V) $ >
  $ wceq D (cfv W csca) $ >
  $ wceq K (cfv D cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wceq G (cmpt x3 V (crio k (wrex y1 (wceq (cv x3) (co (cv y1) (co (cv k) Z c_x) c_pl)) U) K)) $ >
  $ wi (w3a (w3a ph (wcel (cv l) K) (wcel (cv u) V)) (w3a (wcel (cv v) V) (wcel (cv r) V) (wcel (cv s1) V)) (wa (wceq (cv u) (co (cv r) (co (cfv (cv u) G) Z c_x) c_pl)) (wceq (cv v) (co (cv s1) (co (cfv (cv v) G) Z c_x) c_pl)))) (wceq (co (co (cv l) (cv u) c_x) (cv v) c_pl) (co (co (co (cv l) (cv r) c_x) (cv s1) c_pl) (co (co (co (cv l) (cfv (cv u) G) (cfv D cmulr)) (cfv (cv v) G) (cfv D cplusg)) Z c_x) c_pl)) $;

--| Lemma for ~ lshpkrex . Part of showing linearity of ` G ` . (Contributed by NM, 16-Jul-2014.)
theorem lshpkrlem5 {x3 y1 k: setvar} (ph: wff x3 y1 k) (z v u: setvar) (D: class x3 y1 k) (c_pl: class) (c_po: class x3 y1 k) (c_x U: class) (G H: class x3 y1 k) (K: class y1) (N: class x3 y1 k) (V: class y1 k) (W: class x3 y1 k) (X: class) (c_0: class x3 y1) (Z: class) (s1 r l: setvar):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq H (cfv W clsh) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U H) $ >
  $ wi ph (wcel Z V) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wceq (co U (cfv (csn Z) N) c_po) V) $ >
  $ wceq D (cfv W csca) $ >
  $ wceq K (cfv D cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wceq G (cmpt x3 V (crio k (wrex y1 (wceq (cv x3) (co (cv y1) (co (cv k) Z c_x) c_pl)) U) K)) $ >
  $ wi (w3a (w3a ph (wcel (cv l) K) (wcel (cv u) V)) (w3a (wcel (cv v) V) (wcel (cv r) U) (wa (wcel (cv s1) U) (wcel (cv z) U))) (w3a (wceq (cv u) (co (cv r) (co (cfv (cv u) G) Z c_x) c_pl)) (wceq (cv v) (co (cv s1) (co (cfv (cv v) G) Z c_x) c_pl)) (wceq (co (co (cv l) (cv u) c_x) (cv v) c_pl) (co (cv z) (co (cfv (co (co (cv l) (cv u) c_x) (cv v) c_pl) G) Z c_x) c_pl)))) (wceq (cfv (co (co (cv l) (cv u) c_x) (cv v) c_pl) G) (co (co (cv l) (cfv (cv u) G) (cfv D cmulr)) (cfv (cv v) G) (cfv D cplusg))) $;

--| Lemma for ~ lshpkrex . Show linearlity of ` G ` . (Contributed by NM, 17-Jul-2014.)
theorem lshpkrlem6 {x3 y1 k: setvar} (ph: wff x3 y1 k) (v u: setvar) (D: class x3 y1 k) (c_pl: class) (c_po: class x3 y1 k) (c_x U: class) (G H: class x3 y1 k) (K: class y1) (N: class x3 y1 k) (V: class y1 k) (W: class x3 y1 k) (X: class) (c_0: class x3 y1) (Z: class) (l: setvar):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq H (cfv W clsh) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U H) $ >
  $ wi ph (wcel Z V) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wceq (co U (cfv (csn Z) N) c_po) V) $ >
  $ wceq D (cfv W csca) $ >
  $ wceq K (cfv D cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wceq G (cmpt x3 V (crio k (wrex y1 (wceq (cv x3) (co (cv y1) (co (cv k) Z c_x) c_pl)) U) K)) $ >
  $ wi (wa ph (w3a (wcel (cv l) K) (wcel (cv u) V) (wcel (cv v) V))) (wceq (cfv (co (co (cv l) (cv u) c_x) (cv v) c_pl) G) (co (co (cv l) (cfv (cv u) G) (cfv D cmulr)) (cfv (cv v) G) (cfv D cplusg))) $;

--| The set ` G ` defined by hyperplane ` U ` is a linear functional. (Contributed by NM, 17-Jul-2014.)
theorem lshpkrcl {x3 y1 k: setvar} (ph: wff x3 y1 k) (D: class x3 y1) (c_pl: class) (c_po: class x3 y1 k) (c_x U: class) (F G H: class x3 y1 k) (K: class y1) (N: class x3 y1 k) (V: class y1 k) (W: class x3 y1 k) (Z: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq H (cfv W clsh) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U H) $ >
  $ wi ph (wcel Z V) $ >
  $ wi ph (wceq (co U (cfv (csn Z) N) c_po) V) $ >
  $ wceq D (cfv W csca) $ >
  $ wceq K (cfv D cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq G (cmpt x3 V (crio k (wrex y1 (wceq (cv x3) (co (cv y1) (co (cv k) Z c_x) c_pl)) U) K)) $ >
  $ wceq F (cfv W clfn) $ >
  $ wi ph (wcel G F) $;

--| The kernel of functional ` G ` is the hyperplane defining it. (Contributed by NM, 17-Jul-2014.)
theorem lshpkr {x3 y1 k: setvar} (ph: wff x3 y1 k) (D: class x3 y1) (c_pl: class) (c_po: class x3 y1 k) (c_x U: class) (G H: class x3 y1 k) (K: class y1) (L N: class x3 y1 k) (V: class y1 k) (W: class x3 y1 k) (Z: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_po (cfv W clsm) $ >
  $ wceq H (cfv W clsh) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U H) $ >
  $ wi ph (wcel Z V) $ >
  $ wi ph (wceq (co U (cfv (csn Z) N) c_po) V) $ >
  $ wceq D (cfv W csca) $ >
  $ wceq K (cfv D cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq G (cmpt x3 V (crio k (wrex y1 (wceq (cv x3) (co (cv y1) (co (cv k) Z c_x) c_pl)) U) K)) $ >
  $ wceq L (cfv W clk) $ >
  $ wi ph (wceq (cfv G L) U) $;

--| There exists a functional whose kernel equals a given hyperplane. Part of Th. 1.27 of Barbu and Precupanu, _Convexity and Optimization in Banach Spaces_. (Contributed by NM, 17-Jul-2014.)
theorem lshpkrex {g2: setvar} (U F: class) (H: class g2) (K W: class):
  $ wceq H (cfv W clsh) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq K (cfv W clk) $ >
  $ wi (wa (wcel W clvec) (wcel U H)) (wrex g2 (wceq (cfv (cv g2) K) U) F) $;

--| The set of all hyperplanes of a left module or left vector space equals the set of all kernels of nonzero functionals. (Contributed by NM, 17-Jul-2014.) (New usage is discouraged.)
theorem lshpset2N {g2 s1: setvar} (D: class g2 s1) (F: class s1) (H: class) (K V: class s1) (W: class) (c_0: class g2 s1):
  $ wceq V (cfv W cbs) $ >
  $ wceq D (cfv W csca) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wceq H (cfv W clsh) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq K (cfv W clk) $ >
  $ wi (wcel W clvec) (wceq H (cab s1 (wrex g2 (wa (wne (cv g2) (cxp V (csn c_0))) (wceq (cv s1) (cfv (cv g2) K))) F))) $;

--| The predicate "is a hyperplane" (of a left module or left vector space). TODO: should it be ` U = ( K `` g ) ` or ` ( K `` g ) = U ` as in ~ lshpkrex ? Both standards seem to be used randomly throughout set.mm; we should decide on a preferred one. (Contributed by NM, 7-Oct-2014.) (New usage is discouraged.)
theorem islshpkrN {g2: setvar} (D: class g2) (U F H K V W: class) (c_0: class g2):
  $ wceq V (cfv W cbs) $ >
  $ wceq D (cfv W csca) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wceq H (cfv W clsh) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq K (cfv W clk) $ >
  $ wi (wcel W clvec) (wb (wcel U H) (wrex g2 (wa (wne (cv g2) (cxp V (csn c_0))) (wceq U (cfv (cv g2) K))) F)) $;

--| Equivalent expressions for a 1-dim subspace (ray) of functionals. (Contributed by NM, 24-Oct-2014.)
theorem lfl1dim {g2 k: setvar} (ph: wff) (D c_x F G K L V W: class g2):
  $ wceq V (cfv W cbs) $ >
  $ wceq D (cfv W csca) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq L (cfv W clk) $ >
  $ wceq K (cfv D cbs) $ >
  $ wceq c_x (cfv D cmulr) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wceq (crab g2 (wss (cfv G L) (cfv (cv g2) L)) F) (cab g2 (wrex k (wceq (cv g2) (co G (cxp V (csn (cv k))) (cof c_x))) K))) $;

--| Equivalent expressions for a 1-dim subspace (ray) of functionals. TODO: delete this if not useful; ~ lfl1dim may be more compatible with ~ lspsn . (Contributed by NM, 24-Oct-2014.) (New usage is discouraged.)
theorem lfl1dim2N {g2 k: setvar} (ph: wff) (D c_x F G K L V W: class g2):
  $ wceq V (cfv W cbs) $ >
  $ wceq D (cfv W csca) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq L (cfv W clk) $ >
  $ wceq K (cfv D cbs) $ >
  $ wceq c_x (cfv D cmulr) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wceq (crab g2 (wss (cfv G L) (cfv (cv g2) L)) F) (crab g2 (wrex k (wceq (cv g2) (co G (cxp V (csn (cv k))) (cof c_x))) K) F)) $;

--| Extend class notation with left dualvector space.
term cld: class;

--| Define the (left) dual of a left vector space (or module) in which the vectors are functionals. In many texts, this is defined as a right vector space, but by reversing the multiplication we achieve a left vector space, as is done in definition of dual vector space in [Holland95] p. 218. This allows to reuse our existing collection of left vector space theorems. The restriction on ` oF ( +g `` v ) ` allows it to be a set; see ~ ofmres . Note the operation reversal in the scalar product to allow to use the original scalar ring instead of the ` oppR ` ring, for convenience. (Contributed by NM, 18-Oct-2014.)
axiom df_ldual {v f2 k: setvar}:
  $ wceq cld (cmpt v cvv (cun (ctp (cop (cfv cnx cbs) (cfv (cv v) clfn)) (cop (cfv cnx cplusg) (cres (cof (cfv (cfv (cv v) csca) cplusg)) (cxp (cfv (cv v) clfn) (cfv (cv v) clfn)))) (cop (cfv cnx csca) (cfv (cfv (cv v) csca) coppr))) (csn (cop (cfv cnx cvsca) (cmpo k f2 (cfv (cfv (cv v) csca) cbs) (cfv (cv v) clfn) (co (cv f2) (cxp (cfv (cv v) cbs) (csn (cv k))) (cof (cfv (cfv (cv v) csca) cmulr)))))))) $;

--| Define the (left) dual of a left vector space (or module) in which the vectors are functionals. In many texts, this is defined as a right vector space, but by reversing the multiplication we achieve a left vector space, as is done in definition of dual vector space in [Holland95] p. 218. This allows to reuse our existing collection of left vector space theorems. Note the operation reversal in the scalar product to allow to use the original scalar ring instead of the ` oppR ` ring, for convenience. (Contributed by NM, 18-Oct-2014.)
theorem ldualset {f2 k: setvar} (ph: wff f2 k) (D c_pl c_pb R c_xb c_x F K O V: class f2 k) (W: class) (X: class f2 k):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_pb (cres (cof c_pl) (cxp F F)) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq R (cfv W csca) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq O (cfv R coppr) $ >
  $ wceq c_xb (cmpo k f2 K F (co (cv f2) (cxp V (csn (cv k))) (cof c_x))) $ >
  $ wi ph (wcel W X) $ >
  $ wi ph (wceq D (cun (ctp (cop (cfv cnx cbs) F) (cop (cfv cnx cplusg) c_pb) (cop (cfv cnx csca) O)) (csn (cop (cfv cnx cvsca) c_xb)))) $;

--| The vectors of a dual space are functionals of the original space. (Contributed by NM, 18-Oct-2014.)
theorem ldualvbase (ph: wff) (D F V W X: class):
  $ wceq F (cfv W clfn) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq V (cfv D cbs) $ >
  $ wi ph (wcel W X) $ >
  $ wi ph (wceq V F) $;

--| Utility theorem for converting a functional to a vector of the dual space in order to use standard vector theorems. (Contributed by NM, 6-Jan-2015.)
theorem ldualelvbase (ph: wff) (D F G V W X: class):
  $ wceq F (cfv W clfn) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq V (cfv D cbs) $ >
  $ wi ph (wcel W X) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel G V) $;

--| Vector addition in the dual of a vector space. (Contributed by NM, 21-Oct-2014.)
theorem ldualfvadd (ph: wff) (D c_pl c_pd c_pb R F W X: class):
  $ wceq F (cfv W clfn) $ >
  $ wceq R (cfv W csca) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq c_pb (cfv D cplusg) $ >
  $ wi ph (wcel W X) $ >
  $ wceq c_pd (cres (cof c_pl) (cxp F F)) $ >
  $ wi ph (wceq c_pb c_pd) $;

--| Vector addition in the dual of a vector space. (Contributed by NM, 21-Oct-2014.)
theorem ldualvadd (ph: wff) (D c_pl c_pb R F G H W X: class):
  $ wceq F (cfv W clfn) $ >
  $ wceq R (cfv W csca) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq c_pb (cfv D cplusg) $ >
  $ wi ph (wcel W X) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel H F) $ >
  $ wi ph (wceq (co G H c_pb) (co G H (cof c_pl))) $;

--| The value of vector addition in the dual of a vector space is a functional. (Contributed by NM, 21-Oct-2014.)
theorem ldualvaddcl (ph: wff) (D c_pl F G H W: class):
  $ wceq F (cfv W clfn) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq c_pl (cfv D cplusg) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel H F) $ >
  $ wi ph (wcel (co G H c_pl) F) $;

--| The value of the value of vector addition in the dual of a vector space. (Contributed by NM, 7-Jan-2015.)
theorem ldualvaddval (ph: wff) (D c_pl c_pb R F G H V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq R (cfv W csca) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq c_pb (cfv D cplusg) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel H F) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wceq (cfv X (co G H c_pb)) (co (cfv X G) (cfv X H) c_pl)) $;

--| The ring of scalars of the dual of a vector space. (Contributed by NM, 18-Oct-2014.)
theorem ldualsca (ph: wff) (D R F O W X: class):
  $ wceq F (cfv W csca) $ >
  $ wceq O (cfv F coppr) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq R (cfv D csca) $ >
  $ wi ph (wcel W X) $ >
  $ wi ph (wceq R O) $;

--| Base set of scalar ring for the dual of a vector space. (Contributed by NM, 24-Oct-2014.)
theorem ldualsbase (ph: wff) (D R F K L V W: class):
  $ wceq F (cfv W csca) $ >
  $ wceq L (cfv F cbs) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq R (cfv D csca) $ >
  $ wceq K (cfv R cbs) $ >
  $ wi ph (wcel W V) $ >
  $ wi ph (wceq K L) $;

--| Scalar addition for the dual of a vector space. (Contributed by NM, 24-Oct-2014.) (New usage is discouraged.)
theorem ldualsaddN (ph: wff) (D c_pl c_pb R F V W: class):
  $ wceq F (cfv W csca) $ >
  $ wceq c_pl (cfv F cplusg) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq R (cfv D csca) $ >
  $ wceq c_pb (cfv R cplusg) $ >
  $ wi ph (wcel W V) $ >
  $ wi ph (wceq c_pb c_pl) $;

--| Scalar multiplication for the dual of a vector space. (Contributed by NM, 19-Oct-2014.) (Revised by Mario Carneiro, 22-Sep-2015.)
theorem ldualsmul (ph: wff) (D R c_xb c_x F K V W X Y: class):
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_x (cfv F cmulr) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq R (cfv D csca) $ >
  $ wceq c_xb (cfv R cmulr) $ >
  $ wi ph (wcel W V) $ >
  $ wi ph (wcel X K) $ >
  $ wi ph (wcel Y K) $ >
  $ wi ph (wceq (co X Y c_xb) (co Y X c_x)) $;

--| Scalar product operation for the dual of a vector space. (Contributed by NM, 18-Oct-2014.)
theorem ldualfvs {f2 k: setvar} (ph: wff f2 k) (D R c_xb c_x: class f2 k) (c_xp F K V W: class) (Y: class f2 k):
  $ wceq F (cfv W clfn) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq R (cfv W csca) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq c_xb (cfv D cvsca) $ >
  $ wi ph (wcel W Y) $ >
  $ wceq c_x (cmpo k f2 K F (co (cv f2) (cxp V (csn (cv k))) (cof c_xp))) $ >
  $ wi ph (wceq c_xb c_x) $;

--| Scalar product operation value (which is a functional) for the dual of a vector space. (Contributed by NM, 18-Oct-2014.)
theorem ldualvs (ph: wff) (D R c_xb c_xp F G K V W X Y: class):
  $ wceq F (cfv W clfn) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq R (cfv W csca) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq c_xb (cfv D cvsca) $ >
  $ wi ph (wcel W Y) $ >
  $ wi ph (wcel X K) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wceq (co X G c_xb) (co G (cxp V (csn X)) (cof c_xp))) $;

--| Value of scalar product operation value for the dual of a vector space. (Contributed by NM, 18-Oct-2014.)
theorem ldualvsval (ph: wff) (A2 D R c_xb c_xp F G K V W X Y: class):
  $ wceq F (cfv W clfn) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq R (cfv W csca) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq c_xb (cfv D cvsca) $ >
  $ wi ph (wcel W Y) $ >
  $ wi ph (wcel X K) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wceq (cfv A2 (co X G c_xb)) (co (cfv A2 G) X c_xp)) $;

--| The scalar product operation value is a functional. (Contributed by NM, 18-Oct-2014.)
theorem ldualvscl (ph: wff) (D R c_x F G K W X: class):
  $ wceq F (cfv W clfn) $ >
  $ wceq R (cfv W csca) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq c_x (cfv D cvsca) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X K) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel (co X G c_x) F) $;

--| Commutative law for vector (functional) addition. (Contributed by NM, 17-Jan-2015.)
theorem ldualvaddcom (ph: wff) (D c_pl F W X Y: class):
  $ wceq F (cfv W clfn) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq c_pl (cfv D cplusg) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X F) $ >
  $ wi ph (wcel Y F) $ >
  $ wi ph (wceq (co X Y c_pl) (co Y X c_pl)) $;

--| Associative law for scalar product operation. (Contributed by NM, 20-Oct-2014.)
theorem ldualvsass (ph: wff) (D R c_x c_xp F G K W X Y: class):
  $ wceq F (cfv W clfn) $ >
  $ wceq R (cfv W csca) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq c_x (cfv D cvsca) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X K) $ >
  $ wi ph (wcel Y K) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wceq (co (co Y X c_xp) G c_x) (co X (co Y G c_x) c_x)) $;

--| Associative law for scalar product operation, using operations from the dual space. (Contributed by NM, 20-Oct-2014.)
theorem ldualvsass2 (ph: wff) (D Q R c_x c_xp F G K W X Y: class):
  $ wceq F (cfv W clfn) $ >
  $ wceq R (cfv W csca) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq Q (cfv D csca) $ >
  $ wceq c_xp (cfv Q cmulr) $ >
  $ wceq c_x (cfv D cvsca) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X K) $ >
  $ wi ph (wcel Y K) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wceq (co (co X Y c_xp) G c_x) (co X (co Y G c_x) c_x)) $;

--| Distributive law for scalar product operation, using operations from the dual space. (Contributed by NM, 21-Oct-2014.)
theorem ldualvsdi1 (ph: wff) (D c_pl R c_x F G H K W X: class):
  $ wceq F (cfv W clfn) $ >
  $ wceq R (cfv W csca) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq c_pl (cfv D cplusg) $ >
  $ wceq c_x (cfv D cvsca) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X K) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel H F) $ >
  $ wi ph (wceq (co X (co G H c_pl) c_x) (co (co X G c_x) (co X H c_x) c_pl)) $;

--| Reverse distributive law for scalar product operation, using operations from the dual space. (Contributed by NM, 21-Oct-2014.)
theorem ldualvsdi2 (ph: wff) (D c_pl c_pb R c_x F G K W X Y: class):
  $ wceq F (cfv W clfn) $ >
  $ wceq R (cfv W csca) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq c_pb (cfv D cplusg) $ >
  $ wceq c_x (cfv D cvsca) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel X K) $ >
  $ wi ph (wcel Y K) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wceq (co (co X Y c_pl) G c_x) (co (co X G c_x) (co Y G c_x) c_pb)) $;

--| Lemma for ~ ldualgrp . (Contributed by NM, 22-Oct-2014.)
theorem ldualgrplem (ph: wff) (D c_pl R c_x c_xp F K O V W: class):
  $ wceq D (cfv W cld) $ >
  $ wi ph (wcel W clmod) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cof (cfv W cplusg)) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq R (cfv W csca) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wceq O (cfv R coppr) $ >
  $ wceq c_x (cfv D cvsca) $ >
  $ wi ph (wcel D cgrp) $;

--| The dual of a vector space is a group. (Contributed by NM, 21-Oct-2014.)
theorem ldualgrp (ph: wff) (D W: class):
  $ wceq D (cfv W cld) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel D cgrp) $;

--| The zero scalar of the dual of a vector space. (Contributed by NM, 28-Dec-2014.)
theorem ldual0 (ph: wff) (D R S O W c_0: class):
  $ wceq R (cfv W csca) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq S (cfv D csca) $ >
  $ wceq O (cfv S c0g) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wceq O c_0) $;

--| The unit scalar of the dual of a vector space. (Contributed by NM, 26-Feb-2015.)
theorem ldual1 (ph: wff) (D R S c_1 I W: class):
  $ wceq R (cfv W csca) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq S (cfv D csca) $ >
  $ wceq I (cfv S cur) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wceq I c_1) $;

--| The negative of a scalar of the dual of a vector space. (Contributed by NM, 26-Feb-2015.)
theorem ldualneg (ph: wff) (D R S M N W: class):
  $ wceq R (cfv W csca) $ >
  $ wceq M (cfv R cminusg) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq S (cfv D csca) $ >
  $ wceq N (cfv S cminusg) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wceq N M) $;

--| The zero vector of the dual of a vector space. (Contributed by NM, 24-Oct-2014.)
theorem ldual0v (ph: wff) (D R O V W c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq R (cfv W csca) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq O (cfv D c0g) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wceq O (cxp V (csn c_0))) $;

--| The dual zero vector is a functional. (Contributed by NM, 5-Mar-2015.)
theorem ldual0vcl (ph: wff) (D F W c_0: class):
  $ wceq F (cfv W clfn) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel c_0 F) $;

--| Lemma for ~ lduallmod . (Contributed by NM, 22-Oct-2014.)
theorem lduallmodlem (ph: wff) (D c_pl R c_x c_xp F K O V W: class):
  $ wceq D (cfv W cld) $ >
  $ wi ph (wcel W clmod) $ >
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cof (cfv W cplusg)) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq R (cfv W csca) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wceq O (cfv R coppr) $ >
  $ wceq c_x (cfv D cvsca) $ >
  $ wi ph (wcel D clmod) $;

--| The dual of a left module is also a left module. (Contributed by NM, 22-Oct-2014.)
theorem lduallmod (ph: wff) (D W: class):
  $ wceq D (cfv W cld) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel D clmod) $;

--| The dual of a left vector space is also a left vector space. Note that scalar multiplication is reversed by ~ df-oppr ; otherwise, the dual would be a right vector space as is sometimes the case in the literature. (Contributed by NM, 22-Oct-2014.)
theorem lduallvec (ph: wff) (D W: class):
  $ wceq D (cfv W cld) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel D clvec) $;

--| The value of vector subtraction in the dual of a vector space. (Contributed by NM, 27-Feb-2015.)
theorem ldualvsub (ph: wff) (D c_pl R c_x c_1 F G H c_mi N W: class):
  $ wceq R (cfv W csca) $ >
  $ wceq N (cfv R cminusg) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq c_pl (cfv D cplusg) $ >
  $ wceq c_x (cfv D cvsca) $ >
  $ wceq c_mi (cfv D csg) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel H F) $ >
  $ wi ph (wceq (co G H c_mi) (co G (co (cfv c_1 N) H c_x) c_pl)) $;

--| Closure of vector subtraction in the dual of a vector space. (Contributed by NM, 27-Feb-2015.)
theorem ldualvsubcl (ph: wff) (D F G H c_mi W: class):
  $ wceq F (cfv W clfn) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq c_mi (cfv D csg) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel H F) $ >
  $ wi ph (wcel (co G H c_mi) F) $;

--| The value of the value of vector subtraction in the dual of a vector space. TODO: shorten with ~ ldualvsub ? (Requires ` D ` to ` oppR ` conversion.) (Contributed by NM, 26-Feb-2015.)
theorem ldualvsubval (ph: wff) (D R S F G H c_mi V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq R (cfv W csca) $ >
  $ wceq S (cfv R csg) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq c_mi (cfv D csg) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel H F) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wceq (cfv X (co G H c_mi)) (co (cfv X G) (cfv X H) S)) $;

--| Closure of scalar product in a dual subspace.) (Contributed by NM, 5-Feb-2015.)
theorem ldualssvscl (ph: wff) (D R S c_x U K W X Y: class):
  $ wceq R (cfv W csca) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq c_x (cfv D cvsca) $ >
  $ wceq S (cfv D clss) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel X K) $ >
  $ wi ph (wcel Y U) $ >
  $ wi ph (wcel (co X Y c_x) U) $;

--| Closure of vector subtraction in a dual subspace.) (Contributed by NM, 9-Mar-2015.)
theorem ldualssvsubcl (ph: wff) (D S U c_mi W X Y: class):
  $ wceq D (cfv W cld) $ >
  $ wceq c_mi (cfv D csg) $ >
  $ wceq S (cfv D clss) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel X U) $ >
  $ wi ph (wcel Y U) $ >
  $ wi ph (wcel (co X Y c_mi) U) $;

--| Scalar zero times a functional is the zero functional. (Contributed by NM, 17-Feb-2015.)
theorem ldual0vs (ph: wff) (D R c_x F G O W c_0: class):
  $ wceq F (cfv W clfn) $ >
  $ wceq R (cfv W csca) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq c_x (cfv D cvsca) $ >
  $ wceq O (cfv D c0g) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wceq (co c_0 G c_x) O) $;

--| The kernel of the zero functional is the set of all vectors. (Contributed by NM, 4-Feb-2015.)
theorem lkr0f2 (ph: wff) (D F G K V W c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq K (cfv W clk) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wb (wceq (cfv G K) V) (wceq G c_0)) $;

--| The kernels of nonzero functionals are hyperplanes. (Contributed by NM, 22-Feb-2015.)
theorem lduallkr3 (ph: wff) (D F G H K W c_0: class):
  $ wceq H (cfv W clsh) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq K (cfv W clk) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wb (wcel (cfv G K) H) (wne G c_0)) $;

--| Proper subset relation between kernels. (Contributed by NM, 16-Feb-2015.) (New usage is discouraged.)
theorem lkrpssN (ph: wff) (D F G H K W c_0: class):
  $ wceq F (cfv W clfn) $ >
  $ wceq K (cfv W clk) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel H F) $ >
  $ wi ph (wb (wpss (cfv G K) (cfv H K)) (wa (wne G c_0) (wceq H c_0))) $;

--| Intersection of the kernels of 2 functionals is included in the kernel of their sum. (Contributed by NM, 7-Jan-2015.)
theorem lkrin (ph: wff) (D c_pl F G H K W: class):
  $ wceq F (cfv W clfn) $ >
  $ wceq K (cfv W clk) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq c_pl (cfv D cplusg) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel H F) $ >
  $ wi ph (wss (cin (cfv G K) (cfv H K)) (cfv (co G H c_pl) K)) $;

--| Two functionals with the same kernel are the same up to a constant. (Contributed by NM, 4-Feb-2015.)
theorem eqlkr4 {r: setvar} (ph: wff) (D: class r) (R S: class) (c_x: class r) (F G H K W: class):
  $ wceq S (cfv W csca) $ >
  $ wceq R (cfv S cbs) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq K (cfv W clk) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq c_x (cfv D cvsca) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel H F) $ >
  $ wi ph (wceq (cfv G K) (cfv H K)) $ >
  $ wi ph (wrex r (wceq H (co (cv r) G c_x)) R) $;

--| Equivalent expressions for a 1-dim subspace (ray) of functionals. (Contributed by NM, 24-Oct-2014.)
theorem ldual1dim {g2: setvar} (ph: wff) (D: class) (F: class g2) (G: class) (L: class g2) (N: class) (W: class g2):
  $ wceq F (cfv W clfn) $ >
  $ wceq L (cfv W clk) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq N (cfv D clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wceq (cfv (csn G) N) (crab g2 (wss (cfv G L) (cfv (cv g2) L)) F)) $;

--| The kernel of a nonzero scalar product of a functional equals the kernel of the functional. (Contributed by NM, 28-Dec-2014.)
theorem ldualkrsc (ph: wff) (D R c_x F G K L W X c_0: class):
  $ wceq R (cfv W csca) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq L (cfv W clk) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq c_x (cfv D cvsca) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel X K) $ >
  $ wi ph (wne X c_0) $ >
  $ wi ph (wceq (cfv (co X G c_x) L) (cfv G L)) $;

--| The kernel of a scalar product of a functional includes the kernel of the functional. (Contributed by NM, 27-Jan-2015.)
theorem lkrss (ph: wff) (D R c_x F G K L W X: class):
  $ wceq R (cfv W csca) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq L (cfv W clk) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq c_x (cfv D cvsca) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel X K) $ >
  $ wi ph (wss (cfv G L) (cfv (co X G c_x) L)) $;

--| Two functionals with kernels in a subset relationship. (Contributed by NM, 17-Feb-2015.) (New usage is discouraged.)
theorem lkrss2N {r: setvar} (ph: wff) (D: class r) (R S c_x F G H K W: class):
  $ wceq S (cfv W csca) $ >
  $ wceq R (cfv S cbs) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq K (cfv W clk) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq c_x (cfv D cvsca) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel H F) $ >
  $ wi ph (wb (wss (cfv G K) (cfv H K)) (wrex r (wceq H (co (cv r) G c_x)) R)) $;

--| Proportional functionals have equal kernels. (Contributed by NM, 28-Mar-2015.) (New usage is discouraged.)
theorem lkreqN (ph: wff) (A2 D R S c_x F G H K W c_0: class):
  $ wceq S (cfv W csca) $ >
  $ wceq R (cfv S cbs) $ >
  $ wceq c_0 (cfv S c0g) $ >
  $ wceq F (cfv W clfn) $ >
  $ wceq K (cfv W clk) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq c_x (cfv D cvsca) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel A2 (cdif R (csn c_0))) $ >
  $ wi ph (wcel H F) $ >
  $ wi ph (wceq G (co A2 H c_x)) $ >
  $ wi ph (wceq (cfv G K) (cfv H K)) $;

--| Condition for colinear functionals to have equal kernels. (Contributed by NM, 20-Mar-2015.) (New usage is discouraged.)
theorem lkrlspeqN (ph: wff) (D F G H L N W c_0: class):
  $ wceq F (cfv W clfn) $ >
  $ wceq L (cfv W clk) $ >
  $ wceq D (cfv W cld) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wceq N (cfv D clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel H F) $ >
  $ wi ph (wcel G (cdif (cfv (csn H) N) (csn c_0))) $ >
  $ wi ph (wceq (cfv G L) (cfv H L)) $;

--| Extend class notation with orthoposets.
term cops: class;

--| Extend class notation with the commutes relation.
term ccmtN: class;

--| Extend class notation with orthlattices.
term col: class;

--| Extend class notation with orthomodular lattices.
term coml: class;

--| Define the class of orthoposets, which are bounded posets with an orthocomplementation operation. Note that ` ( Base ` p ) e. dom ( lub ` p ) ` means there is an upper bound ` 1. ` , and similarly for the ` 0. ` element. (Contributed by NM, 20-Oct-2011.) (Revised by NM, 13-Sep-2018.)
axiom df_oposet {o p a b: setvar}:
  $ wceq cops (crab p (wa (wa (wcel (cfv (cv p) cbs) (cdm (cfv (cv p) club))) (wcel (cfv (cv p) cbs) (cdm (cfv (cv p) cglb)))) (wex o (wa (wceq (cv o) (cfv (cv p) coc)) (wral a (wral b (w3a (w3a (wcel (cfv (cv a) (cv o)) (cfv (cv p) cbs)) (wceq (cfv (cfv (cv a) (cv o)) (cv o)) (cv a)) (wi (wbr (cv a) (cv b) (cfv (cv p) cple)) (wbr (cfv (cv b) (cv o)) (cfv (cv a) (cv o)) (cfv (cv p) cple)))) (wceq (co (cv a) (cfv (cv a) (cv o)) (cfv (cv p) cjn)) (cfv (cv p) cp1)) (wceq (co (cv a) (cfv (cv a) (cv o)) (cfv (cv p) cmee)) (cfv (cv p) cp0))) (cfv (cv p) cbs)) (cfv (cv p) cbs))))) cpo) $;

--| Define the commutes relation for orthoposets. Definition of commutes in [Kalmbach] p. 20. (Contributed by NM, 6-Nov-2011.)
axiom df_cmtN {x3 y1 p: setvar}:
  $ wceq ccmtN (cmpt p cvv (copab x3 y1 (w3a (wcel (cv x3) (cfv (cv p) cbs)) (wcel (cv y1) (cfv (cv p) cbs)) (wceq (cv x3) (co (co (cv x3) (cv y1) (cfv (cv p) cmee)) (co (cv x3) (cfv (cv y1) (cfv (cv p) coc)) (cfv (cv p) cmee)) (cfv (cv p) cjn)))))) $;

--| Define the class of ortholattices. Definition from [Kalmbach] p. 16. (Contributed by NM, 18-Sep-2011.)
axiom df_ol:
  $ wceq col (cin clat cops) $;

--| Define the class of orthomodular lattices. Definition from [Kalmbach] p. 16. (Contributed by NM, 18-Sep-2011.)
axiom df_oml {a b l: setvar}:
  $ wceq coml (crab l (wral a (wral b (wi (wbr (cv a) (cv b) (cfv (cv l) cple)) (wceq (cv b) (co (cv a) (co (cv b) (cfv (cv a) (cfv (cv l) coc)) (cfv (cv l) cmee)) (cfv (cv l) cjn)))) (cfv (cv l) cbs)) (cfv (cv l) cbs)) col) $;

--| The predicate "is an orthoposet." (Contributed by NM, 20-Oct-2011.) (Revised by NM, 14-Sep-2018.)
theorem isopos {x3 y1: setvar} (B2: class) (U c_1 G c_or: class x3 y1) (K: class) (c_le c_an: class x3 y1) (c_pe: class) (c_0: class x3 y1):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq U (cfv K club) $ >
  $ wceq G (cfv K cglb) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq c_1 (cfv K cp1) $ >
  $ wb (wcel K cops) (wa (w3a (wcel K cpo) (wcel B2 (cdm U)) (wcel B2 (cdm G))) (wral x3 (wral y1 (w3a (w3a (wcel (cfv (cv x3) c_pe) B2) (wceq (cfv (cfv (cv x3) c_pe) c_pe) (cv x3)) (wi (wbr (cv x3) (cv y1) c_le) (wbr (cfv (cv y1) c_pe) (cfv (cv x3) c_pe) c_le))) (wceq (co (cv x3) (cfv (cv x3) c_pe) c_or) c_1) (wceq (co (cv x3) (cfv (cv x3) c_pe) c_an) c_0)) B2) B2)) $;

--| Every orthoposet is a poset. (Contributed by NM, 12-Oct-2011.)
theorem opposet (K: class):
  $ wi (wcel K cops) (wcel K cpo) $;

--| Lemma for orthoposet properties. (Contributed by NM, 20-Oct-2011.)
theorem oposlem (B2 c_1 c_or K c_le c_an c_pe X Y c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq c_1 (cfv K cp1) $ >
  $ wi (w3a (wcel K cops) (wcel X B2) (wcel Y B2)) (w3a (w3a (wcel (cfv X c_pe) B2) (wceq (cfv (cfv X c_pe) c_pe) X) (wi (wbr X Y c_le) (wbr (cfv Y c_pe) (cfv X c_pe) c_le))) (wceq (co X (cfv X c_pe) c_or) c_1) (wceq (co X (cfv X c_pe) c_an) c_0)) $;

--| Conditions necessary for zero and unity elements to exist. (Contributed by NM, 14-Sep-2018.)
theorem op01dm (B2 U G K: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq U (cfv K club) $ >
  $ wceq G (cfv K cglb) $ >
  $ wi (wcel K cops) (wa (wcel B2 (cdm U)) (wcel B2 (cdm G))) $;

--| An orthoposet has a zero element. ( ~ h0elch analog.) (Contributed by NM, 12-Oct-2011.)
theorem op0cl (B2 K c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wi (wcel K cops) (wcel c_0 B2) $;

--| An orthoposet has a unity element. ( ~ helch analog.) (Contributed by NM, 22-Oct-2011.)
theorem op1cl (B2 c_1 K: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_1 (cfv K cp1) $ >
  $ wi (wcel K cops) (wcel c_1 B2) $;

--| Orthoposet zero is less than or equal to any element. ( ~ ch0le analog.) (Contributed by NM, 12-Oct-2011.)
theorem op0le (B2 K c_le X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wi (wa (wcel K cops) (wcel X B2)) (wbr c_0 X c_le) $;

--| An element less than or equal to zero equals zero. ( ~ chle0 analog.) (Contributed by NM, 21-Oct-2011.)
theorem ople0 (B2 K c_le X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wi (wa (wcel K cops) (wcel X B2)) (wb (wbr X c_0 c_le) (wceq X c_0)) $;

--| An element not less than another is nonzero. TODO: Look for uses of ~ necon3bd and ~ op0le to see if this is useful elsewhere. (Contributed by NM, 5-May-2013.)
theorem opnlen0 (B2 K c_le X Y c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wi (wa (w3a (wcel K cops) (wcel X B2) (wcel Y B2)) (wn (wbr X Y c_le))) (wne X c_0) $;

--| The least upper bound of the empty set is the zero element. (Contributed by NM, 15-Sep-2013.) (New usage is discouraged.)
theorem lub0N (c_1 K c_0: class):
  $ wceq c_1 (cfv K club) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wi (wcel K cops) (wceq (cfv c0 c_1) c_0) $;

--| A lattice element greater than zero is nonzero. TODO: is this needed? (Contributed by NM, 1-Jun-2012.)
theorem opltn0 (B2 c_lt K X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wi (wa (wcel K cops) (wcel X B2)) (wb (wbr c_0 X c_lt) (wne X c_0)) $;

--| Any element is less than the orthoposet unity. ( ~ chss analog.) (Contributed by NM, 23-Oct-2011.)
theorem ople1 (B2 c_1 K c_le X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_1 (cfv K cp1) $ >
  $ wi (wa (wcel K cops) (wcel X B2)) (wbr X c_1 c_le) $;

--| If the orthoposet unity is less than or equal to an element, the element equals the unit. ( ~ chle0 analog.) (Contributed by NM, 5-Dec-2011.)
theorem op1le (B2 c_1 K c_le X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_1 (cfv K cp1) $ >
  $ wi (wa (wcel K cops) (wcel X B2)) (wb (wbr c_1 X c_le) (wceq X c_1)) $;

--| The greatest lower bound of the empty set is the unity element. (Contributed by NM, 5-Dec-2011.) (New usage is discouraged.)
theorem glb0N (c_1 G K: class):
  $ wceq G (cfv K cglb) $ >
  $ wceq c_1 (cfv K cp1) $ >
  $ wi (wcel K cops) (wceq (cfv c0 G) c_1) $;

--| Closure of orthocomplement operation. ( ~ choccl analog.) (Contributed by NM, 20-Oct-2011.)
theorem opoccl (B2 K c_pe X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wi (wa (wcel K cops) (wcel X B2)) (wcel (cfv X c_pe) B2) $;

--| Double negative law for orthoposets. ( ~ ococ analog.) (Contributed by NM, 13-Sep-2011.)
theorem opococ (B2 K c_pe X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wi (wa (wcel K cops) (wcel X B2)) (wceq (cfv (cfv X c_pe) c_pe) X) $;

--| Contraposition law for orthoposets. ( ~ chcon3i analog.) (Contributed by NM, 8-Nov-2011.)
theorem opcon3b (B2 K c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wi (w3a (wcel K cops) (wcel X B2) (wcel Y B2)) (wb (wceq X Y) (wceq (cfv Y c_pe) (cfv X c_pe))) $;

--| Orthocomplement contraposition law. ( ~ negcon2 analog.) (Contributed by NM, 16-Jan-2012.)
theorem opcon2b (B2 K c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wi (w3a (wcel K cops) (wcel X B2) (wcel Y B2)) (wb (wceq X (cfv Y c_pe)) (wceq Y (cfv X c_pe))) $;

--| Orthocomplement contraposition law. ( ~ negcon1 analog.) (Contributed by NM, 24-Jan-2012.)
theorem opcon1b (B2 K c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wi (w3a (wcel K cops) (wcel X B2) (wcel Y B2)) (wb (wceq (cfv X c_pe) Y) (wceq (cfv Y c_pe) X)) $;

--| Contraposition law for orthoposets. (Contributed by NM, 13-Sep-2011.)
theorem oplecon3 (B2 K c_le c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wi (w3a (wcel K cops) (wcel X B2) (wcel Y B2)) (wi (wbr X Y c_le) (wbr (cfv Y c_pe) (cfv X c_pe) c_le)) $;

--| Contraposition law for orthoposets. ( ~ chsscon3 analog.) (Contributed by NM, 4-Nov-2011.)
theorem oplecon3b (B2 K c_le c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wi (w3a (wcel K cops) (wcel X B2) (wcel Y B2)) (wb (wbr X Y c_le) (wbr (cfv Y c_pe) (cfv X c_pe) c_le)) $;

--| Contraposition law for strict ordering in orthoposets. ( ~ chsscon1 analog.) (Contributed by NM, 6-Nov-2011.)
theorem oplecon1b (B2 K c_le c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wi (w3a (wcel K cops) (wcel X B2) (wcel Y B2)) (wb (wbr (cfv X c_pe) Y c_le) (wbr (cfv Y c_pe) X c_le)) $;

--| Orthocomplement of orthoposet unity. (Contributed by NM, 24-Jan-2012.)
theorem opoc1 (c_1 K c_pe c_0: class):
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq c_1 (cfv K cp1) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wi (wcel K cops) (wceq (cfv c_1 c_pe) c_0) $;

--| Orthocomplement of orthoposet zero. (Contributed by NM, 24-Jan-2012.)
theorem opoc0 (c_1 K c_pe c_0: class):
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq c_1 (cfv K cp1) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wi (wcel K cops) (wceq (cfv c_0 c_pe) c_1) $;

--| Contraposition law for strict ordering in orthoposets. ( ~ chpsscon3 analog.) (Contributed by NM, 4-Nov-2011.)
theorem opltcon3b (B2 c_lt K c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wi (w3a (wcel K cops) (wcel X B2) (wcel Y B2)) (wb (wbr X Y c_lt) (wbr (cfv Y c_pe) (cfv X c_pe) c_lt)) $;

--| Contraposition law for strict ordering in orthoposets. ( ~ chpsscon1 analog.) (Contributed by NM, 5-Nov-2011.)
theorem opltcon1b (B2 c_lt K c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wi (w3a (wcel K cops) (wcel X B2) (wcel Y B2)) (wb (wbr (cfv X c_pe) Y c_lt) (wbr (cfv Y c_pe) X c_lt)) $;

--| Contraposition law for strict ordering in orthoposets. ( ~ chsscon2 analog.) (Contributed by NM, 5-Nov-2011.)
theorem opltcon2b (B2 c_lt K c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wi (w3a (wcel K cops) (wcel X B2) (wcel Y B2)) (wb (wbr X (cfv Y c_pe) c_lt) (wbr Y (cfv X c_pe) c_lt)) $;

--| Law of excluded middle for orthoposets. ( ~ chjo analog.) (Contributed by NM, 13-Sep-2011.)
theorem opexmid (B2 c_1 c_or K c_pe X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_1 (cfv K cp1) $ >
  $ wi (wa (wcel K cops) (wcel X B2)) (wceq (co X (cfv X c_pe) c_or) c_1) $;

--| Law of contradiction for orthoposets. ( ~ chocin analog.) (Contributed by NM, 13-Sep-2011.)
theorem opnoncon (B2 K c_an c_pe X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wi (wa (wcel K cops) (wcel X B2)) (wceq (co X (cfv X c_pe) c_an) c_0) $;

--| The orthocomplement of the unique poset element such that ` ps ` . ( ~ riotaneg analog.) (Contributed by NM, 16-Jan-2012.) (New usage is discouraged.)
theorem riotaocN {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (B2 K c_pe: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wi (wceq (cv x3) (cfv (cv y1) c_pe)) (wb ph ps) $ >
  $ wi (wa (wcel K cops) (wreu x3 ph B2)) (wceq (crio x3 ph B2) (cfv (crio y1 ps B2) c_pe)) $;

--| Value of commutes relation. (Contributed by NM, 6-Nov-2011.) (New usage is discouraged.)
theorem cmtfvalN {x3 y1: setvar} (A2: class x3 y1) (B2: class) (C c_or: class x3 y1) (K: class) (c_an c_pe: class x3 y1):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq C (cfv K ccmtN) $ >
  $ wi (wcel K A2) (wceq C (copab x3 y1 (w3a (wcel (cv x3) B2) (wcel (cv y1) B2) (wceq (cv x3) (co (co (cv x3) (cv y1) c_an) (co (cv x3) (cfv (cv y1) c_pe) c_an) c_or))))) $;

--| Equivalence for commutes relation. Definition of commutes in [Kalmbach] p. 20. ( ~ cmbr analog.) (Contributed by NM, 6-Nov-2011.) (New usage is discouraged.)
theorem cmtvalN (A2 B2 C c_or K c_an c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq C (cfv K ccmtN) $ >
  $ wi (w3a (wcel K A2) (wcel X B2) (wcel Y B2)) (wb (wbr X Y C) (wceq X (co (co X Y c_an) (co X (cfv Y c_pe) c_an) c_or))) $;

--| The predicate "is an ortholattice." (Contributed by NM, 18-Sep-2011.)
theorem isolat (K: class):
  $ wb (wcel K col) (wa (wcel K clat) (wcel K cops)) $;

--| An ortholattice is a lattice. (Contributed by NM, 18-Sep-2011.)
theorem ollat (K: class):
  $ wi (wcel K col) (wcel K clat) $;

--| An ortholattice is an orthoposet. (Contributed by NM, 18-Sep-2011.)
theorem olop (K: class):
  $ wi (wcel K col) (wcel K cops) $;

--| An ortholattice is a poset. (Contributed by NM, 16-Oct-2011.) (New usage is discouraged.)
theorem olposN (K: class):
  $ wi (wcel K col) (wcel K cpo) $;

--| Properties that determine an ortholattice. (Contributed by NM, 18-Sep-2011.) (New usage is discouraged.)
theorem isolatiN (K: class):
  $ wcel K clat $ >
  $ wcel K cops $ >
  $ wcel K col $;

--| De Morgan's law for meet in an ortholattice. ( ~ chdmm1 analog.) (Contributed by NM, 6-Nov-2011.)
theorem oldmm1 (B2 c_or K c_an c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wi (w3a (wcel K col) (wcel X B2) (wcel Y B2)) (wceq (cfv (co X Y c_an) c_pe) (co (cfv X c_pe) (cfv Y c_pe) c_or)) $;

--| De Morgan's law for meet in an ortholattice. ( ~ chdmm2 analog.) (Contributed by NM, 6-Nov-2011.)
theorem oldmm2 (B2 c_or K c_an c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wi (w3a (wcel K col) (wcel X B2) (wcel Y B2)) (wceq (cfv (co (cfv X c_pe) Y c_an) c_pe) (co X (cfv Y c_pe) c_or)) $;

--| De Morgan's law for meet in an ortholattice. ( ~ chdmm3 analog.) (Contributed by NM, 8-Nov-2011.) (New usage is discouraged.)
theorem oldmm3N (B2 c_or K c_an c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wi (w3a (wcel K col) (wcel X B2) (wcel Y B2)) (wceq (cfv (co X (cfv Y c_pe) c_an) c_pe) (co (cfv X c_pe) Y c_or)) $;

--| De Morgan's law for meet in an ortholattice. ( ~ chdmm4 analog.) (Contributed by NM, 6-Nov-2011.)
theorem oldmm4 (B2 c_or K c_an c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wi (w3a (wcel K col) (wcel X B2) (wcel Y B2)) (wceq (cfv (co (cfv X c_pe) (cfv Y c_pe) c_an) c_pe) (co X Y c_or)) $;

--| De Morgan's law for join in an ortholattice. ( ~ chdmj1 analog.) (Contributed by NM, 6-Nov-2011.)
theorem oldmj1 (B2 c_or K c_an c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wi (w3a (wcel K col) (wcel X B2) (wcel Y B2)) (wceq (cfv (co X Y c_or) c_pe) (co (cfv X c_pe) (cfv Y c_pe) c_an)) $;

--| De Morgan's law for join in an ortholattice. ( ~ chdmj2 analog.) (Contributed by NM, 7-Nov-2011.)
theorem oldmj2 (B2 c_or K c_an c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wi (w3a (wcel K col) (wcel X B2) (wcel Y B2)) (wceq (cfv (co (cfv X c_pe) Y c_or) c_pe) (co X (cfv Y c_pe) c_an)) $;

--| De Morgan's law for join in an ortholattice. ( ~ chdmj3 analog.) (Contributed by NM, 7-Nov-2011.)
theorem oldmj3 (B2 c_or K c_an c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wi (w3a (wcel K col) (wcel X B2) (wcel Y B2)) (wceq (cfv (co X (cfv Y c_pe) c_or) c_pe) (co (cfv X c_pe) Y c_an)) $;

--| De Morgan's law for join in an ortholattice. ( ~ chdmj4 analog.) (Contributed by NM, 7-Nov-2011.)
theorem oldmj4 (B2 c_or K c_an c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wi (w3a (wcel K col) (wcel X B2) (wcel Y B2)) (wceq (cfv (co (cfv X c_pe) (cfv Y c_pe) c_or) c_pe) (co X Y c_an)) $;

--| An ortholattice element joined with zero equals itself. ( ~ chj0 analog.) (Contributed by NM, 19-Oct-2011.)
theorem olj01 (B2 c_or K X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wi (wa (wcel K col) (wcel X B2)) (wceq (co X c_0 c_or) X) $;

--| An ortholattice element joined with zero equals itself. (Contributed by NM, 28-Jan-2012.)
theorem olj02 (B2 c_or K X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wi (wa (wcel K col) (wcel X B2)) (wceq (co c_0 X c_or) X) $;

--| The meet of an ortholattice element with one equals itself. ( ~ chm1i analog.) (Contributed by NM, 22-May-2012.)
theorem olm11 (B2 c_1 K c_an X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_1 (cfv K cp1) $ >
  $ wi (wa (wcel K col) (wcel X B2)) (wceq (co X c_1 c_an) X) $;

--| The meet of an ortholattice element with one equals itself. (Contributed by NM, 22-May-2012.)
theorem olm12 (B2 c_1 K c_an X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_1 (cfv K cp1) $ >
  $ wi (wa (wcel K col) (wcel X B2)) (wceq (co c_1 X c_an) X) $;

--| Ortholattice meet is associative. (This can also be proved for lattices with a longer proof.) ( ~ inass analog.) (Contributed by NM, 7-Nov-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem latmassOLD (B2 K c_an X Y Z: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wi (wa (wcel K col) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2))) (wceq (co (co X Y c_an) Z c_an) (co X (co Y Z c_an) c_an)) $;

--| A rearrangement of lattice meet. ( ~ in12 analog.) (Contributed by NM, 8-Nov-2011.)
theorem latm12 (B2 K c_an X Y Z: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wi (wa (wcel K col) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2))) (wceq (co X (co Y Z c_an) c_an) (co Y (co X Z c_an) c_an)) $;

--| A rearrangement of lattice meet. ( ~ in12 analog.) (Contributed by NM, 13-Nov-2012.)
theorem latm32 (B2 K c_an X Y Z: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wi (wa (wcel K col) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2))) (wceq (co (co X Y c_an) Z c_an) (co (co X Z c_an) Y c_an)) $;

--| Rotate lattice meet of 3 classes. (Contributed by NM, 9-Oct-2012.)
theorem latmrot (B2 K c_an X Y Z: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wi (wa (wcel K col) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2))) (wceq (co (co X Y c_an) Z c_an) (co (co Z X c_an) Y c_an)) $;

--| Rearrangement of lattice meet of 4 classes. ( ~ in4 analog.) (Contributed by NM, 8-Nov-2011.)
theorem latm4 (B2 K c_an W X Y Z: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wi (w3a (wcel K col) (wa (wcel X B2) (wcel Y B2)) (wa (wcel Z B2) (wcel W B2))) (wceq (co (co X Y c_an) (co Z W c_an) c_an) (co (co X Z c_an) (co Y W c_an) c_an)) $;

--| Lattice meet distributes over itself. ( ~ inindi analog.) (Contributed by NM, 8-Nov-2011.) (New usage is discouraged.)
theorem latmmdiN (B2 K c_an X Y Z: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wi (wa (wcel K col) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2))) (wceq (co X (co Y Z c_an) c_an) (co (co X Y c_an) (co X Z c_an) c_an)) $;

--| Lattice meet distributes over itself. ( ~ inindir analog.) (Contributed by NM, 6-Jun-2012.)
theorem latmmdir (B2 K c_an X Y Z: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wi (wa (wcel K col) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2))) (wceq (co (co X Y c_an) Z c_an) (co (co X Z c_an) (co Y Z c_an) c_an)) $;

--| Meet with lattice zero is zero. ( ~ chm0 analog.) (Contributed by NM, 8-Nov-2011.)
theorem olm01 (B2 K c_an X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wi (wa (wcel K col) (wcel X B2)) (wceq (co X c_0 c_an) c_0) $;

--| Meet with lattice zero is zero. (Contributed by NM, 9-Oct-2012.)
theorem olm02 (B2 K c_an X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wi (wa (wcel K col) (wcel X B2)) (wceq (co c_0 X c_an) c_0) $;

--| The predicate "is an orthomodular lattice." (Contributed by NM, 18-Sep-2011.)
theorem isoml {x3 y1: setvar} (B2: class) (c_or: class x3 y1) (K: class) (c_le c_an c_pe: class x3 y1):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wb (wcel K coml) (wa (wcel K col) (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) c_le) (wceq (cv y1) (co (cv x3) (co (cv y1) (cfv (cv x3) c_pe) c_an) c_or))) B2) B2)) $;

--| Properties that determine an orthomodular lattice. (Contributed by NM, 18-Sep-2011.) (New usage is discouraged.)
theorem isomliN {x3 y1: setvar} (B2: class) (c_or: class x3 y1) (K: class) (c_le c_an c_pe: class x3 y1):
  $ wcel K col $ >
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wi (wa (wcel (cv x3) B2) (wcel (cv y1) B2)) (wi (wbr (cv x3) (cv y1) c_le) (wceq (cv y1) (co (cv x3) (co (cv y1) (cfv (cv x3) c_pe) c_an) c_or))) $ >
  $ wcel K coml $;

--| An orthomodular lattice is an ortholattice. (Contributed by NM, 18-Sep-2011.)
theorem omlol (K: class):
  $ wi (wcel K coml) (wcel K col) $;

--| An orthomodular lattice is an orthoposet. (Contributed by NM, 6-Nov-2011.)
theorem omlop (K: class):
  $ wi (wcel K coml) (wcel K cops) $;

--| An orthomodular lattice is a lattice. (Contributed by NM, 6-Nov-2011.)
theorem omllat (K: class):
  $ wi (wcel K coml) (wcel K clat) $;

--| The orthomodular law. (Contributed by NM, 18-Sep-2011.)
theorem omllaw (B2 c_or K c_le c_an c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wi (w3a (wcel K coml) (wcel X B2) (wcel Y B2)) (wi (wbr X Y c_le) (wceq Y (co X (co Y (cfv X c_pe) c_an) c_or))) $;

--| Variation of orthomodular law. Definition of OML law in [Kalmbach] p. 22. ( ~ pjoml2i analog.) (Contributed by NM, 6-Nov-2011.) (New usage is discouraged.)
theorem omllaw2N (B2 c_or K c_le c_an c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wi (w3a (wcel K coml) (wcel X B2) (wcel Y B2)) (wi (wbr X Y c_le) (wceq (co X (co (cfv X c_pe) Y c_an) c_or) Y)) $;

--| Orthomodular law equivalent. Theorem 2(ii) of [Kalmbach] p. 22. ( ~ pjoml analog.) (Contributed by NM, 19-Oct-2011.)
theorem omllaw3 (B2 K c_le c_an c_pe X Y c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wi (w3a (wcel K coml) (wcel X B2) (wcel Y B2)) (wi (wa (wbr X Y c_le) (wceq (co Y (cfv X c_pe) c_an) c_0)) (wceq X Y)) $;

--| Orthomodular law equivalent. Remark in [Holland95] p. 223. (Contributed by NM, 19-Oct-2011.)
theorem omllaw4 (B2 K c_le c_an c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wi (w3a (wcel K coml) (wcel X B2) (wcel Y B2)) (wi (wbr X Y c_le) (wceq (co (cfv (co (cfv X c_pe) Y c_an) c_pe) Y c_an) X)) $;

--| The orthomodular law. Remark in [Kalmbach] p. 22. ( ~ pjoml5 analog.) (Contributed by NM, 14-Nov-2011.) (New usage is discouraged.)
theorem omllaw5N (B2 c_or K c_an c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wi (w3a (wcel K coml) (wcel X B2) (wcel Y B2)) (wceq (co X (co (cfv X c_pe) (co X Y c_or) c_an) c_or) (co X Y c_or)) $;

--| Lemma for ~ cmtcomN . ( ~ cmcmlem analog.) (Contributed by NM, 7-Nov-2011.) (New usage is discouraged.)
theorem cmtcomlemN (B2 C K X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq C (cfv K ccmtN) $ >
  $ wi (w3a (wcel K coml) (wcel X B2) (wcel Y B2)) (wi (wbr X Y C) (wbr Y X C)) $;

--| Commutation is symmetric. Theorem 2(v) in [Kalmbach] p. 22. ( ~ cmcmi analog.) (Contributed by NM, 7-Nov-2011.) (New usage is discouraged.)
theorem cmtcomN (B2 C K X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq C (cfv K ccmtN) $ >
  $ wi (w3a (wcel K coml) (wcel X B2) (wcel Y B2)) (wb (wbr X Y C) (wbr Y X C)) $;

--| Commutation with orthocomplement. Theorem 2.3(i) of [Beran] p. 39. ( ~ cmcm2i analog.) (Contributed by NM, 8-Nov-2011.) (New usage is discouraged.)
theorem cmt2N (B2 C K c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq C (cfv K ccmtN) $ >
  $ wi (w3a (wcel K coml) (wcel X B2) (wcel Y B2)) (wb (wbr X Y C) (wbr X (cfv Y c_pe) C)) $;

--| Commutation with orthocomplement. Remark in [Kalmbach] p. 23. ( ~ cmcm4i analog.) (Contributed by NM, 8-Nov-2011.) (New usage is discouraged.)
theorem cmt3N (B2 C K c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq C (cfv K ccmtN) $ >
  $ wi (w3a (wcel K coml) (wcel X B2) (wcel Y B2)) (wb (wbr X Y C) (wbr (cfv X c_pe) Y C)) $;

--| Commutation with orthocomplement. Remark in [Kalmbach] p. 23. ( ~ cmcm4i analog.) (Contributed by NM, 8-Nov-2011.) (New usage is discouraged.)
theorem cmt4N (B2 C K c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq C (cfv K ccmtN) $ >
  $ wi (w3a (wcel K coml) (wcel X B2) (wcel Y B2)) (wb (wbr X Y C) (wbr (cfv X c_pe) (cfv Y c_pe) C)) $;

--| Alternate definition of the commutes relation. Remark in [Kalmbach] p. 23. ( ~ cmbr2i analog.) (Contributed by NM, 8-Nov-2011.) (New usage is discouraged.)
theorem cmtbr2N (B2 C c_or K c_an c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq C (cfv K ccmtN) $ >
  $ wi (w3a (wcel K coml) (wcel X B2) (wcel Y B2)) (wb (wbr X Y C) (wceq X (co (co X Y c_or) (co X (cfv Y c_pe) c_or) c_an))) $;

--| Alternate definition for the commutes relation. Lemma 3 of [Kalmbach] p. 23. ( ~ cmbr3 analog.) (Contributed by NM, 8-Nov-2011.) (New usage is discouraged.)
theorem cmtbr3N (B2 C c_or K c_an c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq C (cfv K ccmtN) $ >
  $ wi (w3a (wcel K coml) (wcel X B2) (wcel Y B2)) (wb (wbr X Y C) (wceq (co X (co (cfv X c_pe) Y c_or) c_an) (co X Y c_an))) $;

--| Alternate definition for the commutes relation. ( ~ cmbr4i analog.) (Contributed by NM, 10-Nov-2011.) (New usage is discouraged.)
theorem cmtbr4N (B2 C c_or K c_le c_an c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq C (cfv K ccmtN) $ >
  $ wi (w3a (wcel K coml) (wcel X B2) (wcel Y B2)) (wb (wbr X Y C) (wbr (co X (co (cfv X c_pe) Y c_or) c_an) Y c_le)) $;

--| Ordered elements commute. ( ~ lecmi analog.) (Contributed by NM, 10-Nov-2011.) (New usage is discouraged.)
theorem lecmtN (B2 C K c_le X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq C (cfv K ccmtN) $ >
  $ wi (w3a (wcel K coml) (wcel X B2) (wcel Y B2)) (wi (wbr X Y c_le) (wbr X Y C)) $;

--| Any element commutes with itself. ( ~ cmidi analog.) (Contributed by NM, 6-Dec-2013.) (New usage is discouraged.)
theorem cmtidN (B2 C K X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq C (cfv K ccmtN) $ >
  $ wi (wa (wcel K coml) (wcel X B2)) (wbr X X C) $;

--| Foulis-Holland Theorem, part 1. If any 2 pairs in a triple of orthomodular lattice elements commute, the triple is distributive. Part of Theorem 5 in [Kalmbach] p. 25. ( ~ fh1 analog.) (Contributed by NM, 8-Nov-2011.) (New usage is discouraged.)
theorem omlfh1N (B2 C c_or K c_an X Y Z: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq C (cfv K ccmtN) $ >
  $ wi (w3a (wcel K coml) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2)) (wa (wbr X Y C) (wbr X Z C))) (wceq (co X (co Y Z c_or) c_an) (co (co X Y c_an) (co X Z c_an) c_or)) $;

--| Foulis-Holland Theorem, part 3. Dual of ~ omlfh1N . (Contributed by NM, 8-Nov-2011.) (New usage is discouraged.)
theorem omlfh3N (B2 C c_or K c_an X Y Z: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq C (cfv K ccmtN) $ >
  $ wi (w3a (wcel K coml) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2)) (wa (wbr X Y C) (wbr X Z C))) (wceq (co X (co Y Z c_an) c_or) (co (co X Y c_or) (co X Z c_or) c_an)) $;

--| Analogue of modular law ~ atmod1i2 that holds in any OML. (Contributed by NM, 6-Dec-2013.) (New usage is discouraged.)
theorem omlmod1i2N (B2 C c_or K c_le c_an X Y Z: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq C (cfv K ccmtN) $ >
  $ wi (w3a (wcel K coml) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2)) (wa (wbr X Z c_le) (wbr Y Z C))) (wceq (co X (co Y Z c_an) c_or) (co (co X Y c_or) Z c_an)) $;

--| Contraction of a Sasaki projection. (Contributed by NM, 6-Dec-2013.) (New usage is discouraged.)
theorem omlspjN (B2 c_or K c_le c_an c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wi (w3a (wcel K coml) (wa (wcel X B2) (wcel Y B2)) (wbr X Y c_le)) (wceq (co (co X (cfv Y c_pe) c_or) Y c_an) X) $;

--| Extend class notation with covers relation.
term ccvr: class;

--| Extend class notation with atoms.
term catm: class;

--| Extend class notation with atomic lattices.
term cal: class;

--| Extend class notation with lattices with the covering property.
term clc: class;

--| Define the covers relation ("is covered by") for posets. " ` a ` is covered by ` b ` " means that ` a ` is strictly less than ` b ` and there is nothing in between. See ~ cvrval for the relation form. (Contributed by NM, 18-Sep-2011.)
axiom df_covers {z p a b: setvar}:
  $ wceq ccvr (cmpt p cvv (copab a b (w3a (wa (wcel (cv a) (cfv (cv p) cbs)) (wcel (cv b) (cfv (cv p) cbs))) (wbr (cv a) (cv b) (cfv (cv p) cplt)) (wn (wrex z (wa (wbr (cv a) (cv z) (cfv (cv p) cplt)) (wbr (cv z) (cv b) (cfv (cv p) cplt))) (cfv (cv p) cbs)))))) $;

--| Define the class of poset atoms. (Contributed by NM, 18-Sep-2011.)
axiom df_ats {p a: setvar}:
  $ wceq catm (cmpt p cvv (crab a (wbr (cfv (cv p) cp0) (cv a) (cfv (cv p) ccvr)) (cfv (cv p) cbs))) $;

--| Value of covers relation "is covered by". (Contributed by NM, 18-Sep-2011.)
theorem cvrfval {x3 y1 z: setvar} (A2: class x3 y1 z) (B2: class) (C c_lt: class x3 y1 z) (K: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wi (wcel K A2) (wceq C (copab x3 y1 (w3a (wa (wcel (cv x3) B2) (wcel (cv y1) B2)) (wbr (cv x3) (cv y1) c_lt) (wn (wrex z (wa (wbr (cv x3) (cv z) c_lt) (wbr (cv z) (cv y1) c_lt)) B2))))) $;

--| Binary relation expressing ` B ` covers ` A ` , which means that ` B ` is larger than ` A ` and there is nothing in between. Definition 3.2.18 of [PtakPulmannova] p. 68. ( ~ cvbr analog.) (Contributed by NM, 18-Sep-2011.)
theorem cvrval {z: setvar} (A2: class z) (B2: class) (C c_lt: class z) (K X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wi (w3a (wcel K A2) (wcel X B2) (wcel Y B2)) (wb (wbr X Y C) (wa (wbr X Y c_lt) (wn (wrex z (wa (wbr X (cv z) c_lt) (wbr (cv z) Y c_lt)) B2)))) $;

--| The covers relation implies the less-than relation. ( ~ cvpss analog.) (Contributed by NM, 8-Oct-2011.)
theorem cvrlt (A2 B2 C c_lt K X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wi (wa (w3a (wcel K A2) (wcel X B2) (wcel Y B2)) (wbr X Y C)) (wbr X Y c_lt) $;

--| There is no element between the two arguments of the covers relation. ( ~ cvnbtwn analog.) (Contributed by NM, 18-Oct-2011.)
theorem cvrnbtwn (A2 B2 C c_lt K X Y Z: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wi (w3a (wcel K A2) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2)) (wbr X Y C)) (wn (wa (wbr X Z c_lt) (wbr Z Y c_lt))) $;

--| No element covers the lattice unity. (Contributed by NM, 8-Jul-2013.)
theorem ncvr1 (B2 C c_1 K X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_1 (cfv K cp1) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wi (wa (wcel K cops) (wcel X B2)) (wn (wbr c_1 X C)) $;

--| Property of an element above a covering. (Contributed by NM, 7-Dec-2012.) (New usage is discouraged.)
theorem cvrletrN (B2 C c_lt K c_le X Y Z: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wi (wa (wcel K cpo) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2))) (wi (wa (wbr X Y C) (wbr Y Z c_le)) (wbr X Z c_lt)) $;

--| Binary relation expressing ` Y ` covers ` X ` . Definition of covers in [Kalmbach] p. 15. ( ~ cvbr2 analog.) (Contributed by NM, 16-Nov-2011.)
theorem cvrval2 {z: setvar} (A2 B2: class) (C c_lt: class z) (K: class) (c_le: class z) (X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wi (w3a (wcel K A2) (wcel X B2) (wcel Y B2)) (wb (wbr X Y C) (wa (wbr X Y c_lt) (wral z (wi (wa (wbr X (cv z) c_lt) (wbr (cv z) Y c_le)) (wceq (cv z) Y)) B2))) $;

--| The covers relation implies no in-betweenness. ( ~ cvnbtwn2 analog.) (Contributed by NM, 17-Nov-2011.)
theorem cvrnbtwn2 (B2 C c_lt K c_le X Y Z: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wi (w3a (wcel K cpo) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2)) (wbr X Y C)) (wb (wa (wbr X Z c_lt) (wbr Z Y c_le)) (wceq Z Y)) $;

--| The covers relation implies no in-betweenness. ( ~ cvnbtwn3 analog.) (Contributed by NM, 4-Nov-2011.)
theorem cvrnbtwn3 (B2 C c_lt K c_le X Y Z: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wi (w3a (wcel K cpo) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2)) (wbr X Y C)) (wb (wa (wbr X Z c_le) (wbr Z Y c_lt)) (wceq X Z)) $;

--| Contraposition law for the covers relation. ( ~ cvcon3 analog.) (Contributed by NM, 4-Nov-2011.)
theorem cvrcon3b (B2 C K c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wi (w3a (wcel K cops) (wcel X B2) (wcel Y B2)) (wb (wbr X Y C) (wbr (cfv Y c_pe) (cfv X c_pe) C)) $;

--| The covers relation implies the "less than or equal to" relation. (Contributed by NM, 12-Oct-2011.)
theorem cvrle (A2 B2 C K c_le X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wi (wa (w3a (wcel K A2) (wcel X B2) (wcel Y B2)) (wbr X Y C)) (wbr X Y c_le) $;

--| The covers relation implies no in-betweenness. Part of proof of Lemma 7.5.1 of [MaedaMaeda] p. 31. ( ~ cvnbtwn4 analog.) (Contributed by NM, 18-Oct-2011.)
theorem cvrnbtwn4 (B2 C K c_le X Y Z: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wi (w3a (wcel K cpo) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2)) (wbr X Y C)) (wb (wa (wbr X Z c_le) (wbr Z Y c_le)) (wo (wceq X Z) (wceq Z Y))) $;

--| The covers relation implies the negation of the converse "less than or equal to" relation. (Contributed by NM, 18-Oct-2011.)
theorem cvrnle (B2 C K c_le X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wi (wa (w3a (wcel K cpo) (wcel X B2) (wcel Y B2)) (wbr X Y C)) (wn (wbr Y X c_le)) $;

--| The covers relation implies inequality. (Contributed by NM, 13-Oct-2011.)
theorem cvrne (A2 B2 C K X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wi (wa (w3a (wcel K A2) (wcel X B2) (wcel Y B2)) (wbr X Y C)) (wne X Y) $;

--| The covers relation is not reflexive. ( ~ cvnref analog.) (Contributed by NM, 1-Nov-2012.) (New usage is discouraged.)
theorem cvrnrefN (A2 B2 C K X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wi (wa (wcel K A2) (wcel X B2)) (wn (wbr X X C)) $;

--| If two lattice elements that cover a third are comparable, then they are equal. (Contributed by NM, 6-Feb-2012.)
theorem cvrcmp (B2 C K c_le X Y Z: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wi (w3a (wcel K cpo) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2)) (wa (wbr Z X C) (wbr Z Y C))) (wb (wbr X Y c_le) (wceq X Y)) $;

--| If two lattice elements covered by a third are comparable, then they are equal. (Contributed by NM, 20-Jun-2012.)
theorem cvrcmp2 (B2 C K c_le X Y Z: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wi (w3a (wcel K cops) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2)) (wa (wbr X Z C) (wbr Y Z C))) (wb (wbr X Y c_le) (wceq X Y)) $;

--| The set of atoms in a poset. (Contributed by NM, 18-Sep-2011.)
theorem pats {x3: setvar} (A2: class x3) (B2: class) (C D: class x3) (K: class) (c_0: class x3):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wcel K D) (wceq A2 (crab x3 (wbr c_0 (cv x3) C) B2)) $;

--| The predicate "is an atom". ( ~ ela analog.) (Contributed by NM, 18-Sep-2011.)
theorem isat (A2 B2 C D P K c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wcel K D) (wb (wcel P A2) (wa (wcel P B2) (wbr c_0 P C))) $;

--| The predicate "is an atom". ( ~ elatcv0 analog.) (Contributed by NM, 18-Jun-2012.)
theorem isat2 (A2 B2 C D P K c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (wcel K D) (wcel P B2)) (wb (wcel P A2) (wbr c_0 P C)) $;

--| An atom covers zero. ( ~ atcv0 analog.) (Contributed by NM, 4-Nov-2011.)
theorem atcvr0 (A2 C D P K c_0: class):
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (wcel K D) (wcel P A2)) (wbr c_0 P C) $;

--| An atom is a member of the lattice base set (i.e. a lattice element). ( ~ atelch analog.) (Contributed by NM, 10-Oct-2011.)
theorem atbase (A2 B2 P K: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wcel P A2) (wcel P B2) $;

--| The set of atoms is a subset of the base set. ( ~ atssch analog.) (Contributed by NM, 21-Oct-2011.)
theorem atssbase (A2 B2 K: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wss A2 B2 $;

--| An atom is greater than zero. (Contributed by NM, 4-Jul-2012.)
theorem _0ltat (A2 P c_lt K c_0: class):
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (wcel K cops) (wcel P A2)) (wbr c_0 P c_lt) $;

--| A poset element less than or equal to an atom equals either zero or the atom. ( ~ atss analog.) (Contributed by NM, 17-Nov-2011.)
theorem leatb (A2 B2 P K c_le X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K cops) (wcel X B2) (wcel P A2)) (wb (wbr X P c_le) (wo (wceq X P) (wceq X c_0))) $;

--| A poset element less than or equal to an atom equals either zero or the atom. (Contributed by NM, 15-Oct-2013.)
theorem leat (A2 B2 P K c_le X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (w3a (wcel K cops) (wcel X B2) (wcel P A2)) (wbr X P c_le)) (wo (wceq X P) (wceq X c_0)) $;

--| A nonzero poset element less than or equal to an atom equals the atom. (Contributed by NM, 6-Mar-2013.)
theorem leat2 (A2 B2 P K c_le X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (w3a (wcel K cops) (wcel X B2) (wcel P A2)) (wa (wne X c_0) (wbr X P c_le))) (wceq X P) $;

--| A poset element less than or equal to an atom is either an atom or zero. (Contributed by NM, 2-Dec-2012.)
theorem leat3 (A2 B2 P K c_le X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (w3a (wcel K cops) (wcel X B2) (wcel P A2)) (wbr X P c_le)) (wo (wcel X A2) (wceq X c_0)) $;

--| The meet of any element with an atom is either the atom or zero. (Contributed by NM, 28-Aug-2012.)
theorem meetat (A2 B2 P K c_an X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K col) (wcel X B2) (wcel P A2)) (wo (wceq (co X P c_an) P) (wceq (co X P c_an) c_0)) $;

--| The meet of any element with an atom is either the atom or zero. (Contributed by NM, 30-Aug-2012.)
theorem meetat2 (A2 B2 P K c_an X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K col) (wcel X B2) (wcel P A2)) (wo (wcel (co X P c_an) A2) (wceq (co X P c_an) c_0)) $;

--| Define the class of atomic lattices, in which every nonzero element is greater than or equal to an atom. We also ensure the existence of a lattice zero, since a lattice by itself may not have a zero. (Contributed by NM, 18-Sep-2011.) (Revised by NM, 14-Sep-2018.)
axiom df_atl {x3 k p: setvar}:
  $ wceq cal (crab k (wa (wcel (cfv (cv k) cbs) (cdm (cfv (cv k) cglb))) (wral x3 (wi (wne (cv x3) (cfv (cv k) cp0)) (wrex p (wbr (cv p) (cv x3) (cfv (cv k) cple)) (cfv (cv k) catm))) (cfv (cv k) cbs))) clat) $;

--| The predicate "is an atomic lattice." Every nonzero element is less than or equal to an atom. (Contributed by NM, 18-Sep-2011.) (Revised by NM, 14-Sep-2018.)
theorem isatl {x3 y1: setvar} (A2: class x3) (B2: class y1) (G: class x3 y1) (K: class) (c_le c_0: class x3 y1):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq G (cfv K cglb) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wb (wcel K cal) (w3a (wcel K clat) (wcel B2 (cdm G)) (wral x3 (wi (wne (cv x3) c_0) (wrex y1 (wbr (cv y1) (cv x3) c_le) A2)) B2)) $;

--| An atomic lattice is a lattice. (Contributed by NM, 21-Oct-2011.)
theorem atllat (K: class):
  $ wi (wcel K cal) (wcel K clat) $;

--| An atomic lattice is a poset. (Contributed by NM, 5-Nov-2012.)
theorem atlpos (K: class):
  $ wi (wcel K cal) (wcel K cpo) $;

--| Condition necessary for zero element to exist. (Contributed by NM, 14-Sep-2018.)
theorem atl0dm (B2 U G K: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq U (cfv K club) $ >
  $ wceq G (cfv K cglb) $ >
  $ wi (wcel K cal) (wcel B2 (cdm G)) $;

--| An atomic lattice has a zero element. We can use this in place of ~ op0cl for lattices without orthocomplements. (Contributed by NM, 5-Nov-2012.)
theorem atl0cl (B2 K c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wi (wcel K cal) (wcel c_0 B2) $;

--| Orthoposet zero is less than or equal to any element. ( ~ ch0le analog.) (Contributed by NM, 12-Oct-2011.)
theorem atl0le (B2 K c_le X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wi (wa (wcel K cal) (wcel X B2)) (wbr c_0 X c_le) $;

--| An element less than or equal to zero equals zero. ( ~ chle0 analog.) (Contributed by NM, 21-Oct-2011.)
theorem atlle0 (B2 K c_le X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wi (wa (wcel K cal) (wcel X B2)) (wb (wbr X c_0 c_le) (wceq X c_0)) $;

--| A lattice element greater than zero is nonzero. (Contributed by NM, 1-Jun-2012.)
theorem atlltn0 (B2 c_lt K X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wi (wa (wcel K cal) (wcel X B2)) (wb (wbr c_0 X c_lt) (wne X c_0)) $;

--| The predicate "is an atom". ( ~ elat2 analog.) (Contributed by NM, 27-Apr-2014.)
theorem isat3 {x3: setvar} (A2: class x3) (B2 P K: class) (c_le: class x3) (c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wcel K cal) (wb (wcel P A2) (w3a (wcel P B2) (wne P c_0) (wral x3 (wi (wbr (cv x3) P c_le) (wo (wceq (cv x3) P) (wceq (cv x3) c_0))) B2))) $;

--| An atom is not zero. ( ~ atne0 analog.) (Contributed by NM, 5-Nov-2012.)
theorem atn0 (A2 P K c_0: class):
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (wcel K cal) (wcel P A2)) (wne P c_0) $;

--| An atom is not less than or equal to zero. (Contributed by NM, 17-Oct-2011.)
theorem atnle0 (A2 P K c_le c_0: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (wcel K cal) (wcel P A2)) (wn (wbr P c_0 c_le)) $;

--| A lattice element is nonzero if an atom is under it. (Contributed by NM, 26-May-2012.)
theorem atlen0 (A2 B2 P K c_le X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (w3a (wcel K cal) (wcel X B2) (wcel P A2)) (wbr P X c_le)) (wne X c_0) $;

--| If two atoms are comparable, they are equal. ( ~ atsseq analog.) (Contributed by NM, 13-Oct-2011.)
theorem atcmp (A2 P Q K c_le: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K cal) (wcel P A2) (wcel Q A2)) (wb (wbr P Q c_le) (wceq P Q)) $;

--| Frequently-used variation of ~ atcmp . (Contributed by NM, 29-Jun-2012.)
theorem atncmp (A2 P Q K c_le: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K cal) (wcel P A2) (wcel Q A2)) (wb (wn (wbr P Q c_le)) (wne P Q)) $;

--| Two atoms cannot satisfy the less than relation. (Contributed by NM, 7-Feb-2012.)
theorem atnlt (A2 P Q c_lt K: class):
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K cal) (wcel P A2) (wcel Q A2)) (wn (wbr P Q c_lt)) $;

--| An element covered by an atom must be zero. ( ~ atcveq0 analog.) (Contributed by NM, 4-Nov-2011.)
theorem atcvreq0 (A2 B2 C P K c_le X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K cal) (wcel X B2) (wcel P A2)) (wb (wbr X P C) (wceq X c_0)) $;

--| Two atoms cannot satisfy the covering relation. (Contributed by NM, 7-Feb-2012.) (New usage is discouraged.)
theorem atncvrN (A2 C P Q K: class):
  $ wceq C (cfv K ccvr) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K cal) (wcel P A2) (wcel Q A2)) (wn (wbr P Q C)) $;

--| Every nonzero element of an atomic lattice is greater than or equal to an atom. ( ~ hatomic analog.) (Contributed by NM, 21-Oct-2011.)
theorem atlex {y1: setvar} (A2: class) (B2: class y1) (K: class) (c_le: class y1) (X: class) (c_0: class y1):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K cal) (wcel X B2) (wne X c_0)) (wrex y1 (wbr (cv y1) X c_le) A2) $;

--| Two ways of expressing "an atom is not less than or equal to a lattice element." ( ~ atnssm0 analog.) (Contributed by NM, 5-Nov-2012.)
theorem atnle (A2 B2 P K c_le c_an X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K cal) (wcel P A2) (wcel X B2)) (wb (wn (wbr P X c_le)) (wceq (co P X c_an) c_0)) $;

--| The meet of distinct atoms is zero. ( ~ atnemeq0 analog.) (Contributed by NM, 5-Nov-2012.)
theorem atnem0 (A2 P Q K c_an c_0: class):
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K cal) (wcel P A2) (wcel Q A2)) (wb (wne P Q) (wceq (co P Q c_an) c_0)) $;

--| An atomic, complete, orthomodular lattice is atomistic i.e. every element is the join of the atoms under it. See remark before Proposition 1 in [Kalmbach] p. 140; also remark in [BeltramettiCassinelli] p. 98. ( ~ hatomistici analog.) (Contributed by NM, 5-Nov-2012.)
theorem atlatmstc {y1: setvar} (A2 B2: class) (c_1 K: class y1) (c_le X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_1 (cfv K club) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (w3a (wcel K coml) (wcel K ccla) (wcel K cal)) (wcel X B2)) (wceq (cfv (crab y1 (wbr (cv y1) X c_le) A2) c_1) X) $;

--| The ordering of two Hilbert lattice elements is determined by the atoms under them. ( ~ chrelat3 analog.) (Contributed by NM, 5-Nov-2012.)
theorem atlatle {p: setvar} (A2 B2 K c_le X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (w3a (wcel K coml) (wcel K ccla) (wcel K cal)) (wcel X B2) (wcel Y B2)) (wb (wbr X Y c_le) (wral p (wi (wbr (cv p) X c_le) (wbr (cv p) Y c_le)) A2)) $;

--| An atomistic lattice with 0 is relatively atomic. Part of Lemma 7.2 of [MaedaMaeda] p. 30. ( ~ chpssati , with ` /\ ` swapped, analog.) (Contributed by NM, 4-Dec-2011.)
theorem atlrelat1 {p: setvar} (A2 B2: class) (c_lt: class p) (K c_le X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (w3a (wcel K coml) (wcel K ccla) (wcel K cal)) (wcel X B2) (wcel Y B2)) (wi (wbr X Y c_lt) (wrex p (wa (wn (wbr (cv p) X c_le)) (wbr (cv p) Y c_le)) A2)) $;

--| Define the class of atomic lattices with the covering property. (This is actually the exchange property, but they are equivalent. The literature usually uses the covering property terminology.) (Contributed by NM, 5-Nov-2012.)
axiom df_cvlat {k a b c: setvar}:
  $ wceq clc (crab k (wral a (wral b (wral c (wi (wa (wn (wbr (cv a) (cv c) (cfv (cv k) cple))) (wbr (cv a) (co (cv c) (cv b) (cfv (cv k) cjn)) (cfv (cv k) cple))) (wbr (cv b) (co (cv c) (cv a) (cfv (cv k) cjn)) (cfv (cv k) cple))) (cfv (cv k) cbs)) (cfv (cv k) catm)) (cfv (cv k) catm)) cal) $;

--| The predicate "is an atomic lattice with the covering (or exchange) property". (Contributed by NM, 5-Nov-2012.)
theorem iscvlat {x3 q p: setvar} (A2: class x3) (B2: class q p) (c_or: class x3 q p) (K: class) (c_le: class x3 q p):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wb (wcel K clc) (wa (wcel K cal) (wral p (wral q (wral x3 (wi (wa (wn (wbr (cv p) (cv x3) c_le)) (wbr (cv p) (co (cv x3) (cv q) c_or) c_le)) (wbr (cv q) (co (cv x3) (cv p) c_or) c_le)) B2) A2) A2)) $;

--| The predicate "is an atomic lattice with the covering (or exchange) property". (Contributed by NM, 5-Nov-2012.) (New usage is discouraged.)
theorem iscvlat2N {x3 q p: setvar} (A2: class) (B2: class q p) (c_or: class x3 q p) (K: class) (c_le c_an c_0: class x3 q p):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wb (wcel K clc) (wa (wcel K cal) (wral p (wral q (wral x3 (wi (wa (wceq (co (cv p) (cv x3) c_an) c_0) (wbr (cv p) (co (cv x3) (cv q) c_or) c_le)) (wbr (cv q) (co (cv x3) (cv p) c_or) c_le)) B2) A2) A2)) $;

--| An atomic lattice with the covering property is an atomic lattice. (Contributed by NM, 5-Nov-2012.)
theorem cvlatl (K: class):
  $ wi (wcel K clc) (wcel K cal) $;

--| An atomic lattice with the covering property is a lattice. (Contributed by NM, 5-Nov-2012.)
theorem cvllat (K: class):
  $ wi (wcel K clc) (wcel K clat) $;

--| An atomic lattice with the covering property is a poset. (Contributed by NM, 5-Nov-2012.) (New usage is discouraged.)
theorem cvlposN (K: class):
  $ wi (wcel K clc) (wcel K cpo) $;

--| An atomic covering lattice has the exchange property. (Contributed by NM, 6-Nov-2011.)
theorem cvlexch1 (A2 B2 P Q c_or K c_le X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K clc) (w3a (wcel P A2) (wcel Q A2) (wcel X B2)) (wn (wbr P X c_le))) (wi (wbr P (co X Q c_or) c_le) (wbr Q (co X P c_or) c_le)) $;

--| An atomic covering lattice has the exchange property. (Contributed by NM, 6-May-2012.)
theorem cvlexch2 (A2 B2 P Q c_or K c_le X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K clc) (w3a (wcel P A2) (wcel Q A2) (wcel X B2)) (wn (wbr P X c_le))) (wi (wbr P (co Q X c_or) c_le) (wbr Q (co P X c_or) c_le)) $;

--| An atomic covering lattice has the exchange property. (Contributed by NM, 16-Nov-2011.)
theorem cvlexchb1 (A2 B2 P Q c_or K c_le X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K clc) (w3a (wcel P A2) (wcel Q A2) (wcel X B2)) (wn (wbr P X c_le))) (wb (wbr P (co X Q c_or) c_le) (wceq (co X P c_or) (co X Q c_or))) $;

--| An atomic covering lattice has the exchange property. (Contributed by NM, 22-Jun-2012.)
theorem cvlexchb2 (A2 B2 P Q c_or K c_le X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K clc) (w3a (wcel P A2) (wcel Q A2) (wcel X B2)) (wn (wbr P X c_le))) (wb (wbr P (co Q X c_or) c_le) (wceq (co P X c_or) (co Q X c_or))) $;

--| An atomic covering lattice has the exchange property. ( ~ atexch analog.) (Contributed by NM, 5-Nov-2012.)
theorem cvlexch3 (A2 B2 P Q c_or K c_le c_an X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K clc) (w3a (wcel P A2) (wcel Q A2) (wcel X B2)) (wceq (co P X c_an) c_0)) (wi (wbr P (co X Q c_or) c_le) (wbr Q (co X P c_or) c_le)) $;

--| An atomic covering lattice has the exchange property. Part of Definition 7.8 of [MaedaMaeda] p. 32. (Contributed by NM, 5-Nov-2012.) (New usage is discouraged.)
theorem cvlexch4N (A2 B2 P Q c_or K c_le c_an X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K clc) (w3a (wcel P A2) (wcel Q A2) (wcel X B2)) (wceq (co P X c_an) c_0)) (wb (wbr P (co X Q c_or) c_le) (wceq (co X P c_or) (co X Q c_or))) $;

--| A version of ~ cvlexchb1 for atoms. (Contributed by NM, 5-Nov-2012.)
theorem cvlatexchb1 (A2 P Q R c_or K c_le: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K clc) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wne P R)) (wb (wbr P (co R Q c_or) c_le) (wceq (co R P c_or) (co R Q c_or))) $;

--| A version of ~ cvlexchb2 for atoms. (Contributed by NM, 5-Nov-2012.)
theorem cvlatexchb2 (A2 P Q R c_or K c_le: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K clc) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wne P R)) (wb (wbr P (co Q R c_or) c_le) (wceq (co P R c_or) (co Q R c_or))) $;

--| Atom exchange property. (Contributed by NM, 5-Nov-2012.)
theorem cvlatexch1 (A2 P Q R c_or K c_le: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K clc) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wne P R)) (wi (wbr P (co R Q c_or) c_le) (wbr Q (co R P c_or) c_le)) $;

--| Atom exchange property. (Contributed by NM, 5-Nov-2012.)
theorem cvlatexch2 (A2 P Q R c_or K c_le: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K clc) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wne P R)) (wi (wbr P (co Q R c_or) c_le) (wbr Q (co P R c_or) c_le)) $;

--| Atom exchange property. (Contributed by NM, 29-Nov-2012.)
theorem cvlatexch3 (A2 P Q R c_or K c_le: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K clc) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wa (wne P Q) (wne P R))) (wi (wbr P (co Q R c_or) c_le) (wceq (co P Q c_or) (co P R c_or))) $;

--| The covering property. Proposition 1(ii) in [Kalmbach] p. 140 (and its converse). ( ~ chcv1 analog.) (Contributed by NM, 5-Nov-2012.)
theorem cvlcvr1 (A2 B2 C P c_or K c_le X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (w3a (wcel K coml) (wcel K ccla) (wcel K clc)) (wcel X B2) (wcel P A2)) (wb (wn (wbr P X c_le)) (wbr X (co X P c_or) C)) $;

--| A Hilbert lattice satisfies the covering property of Definition 7.4 of [MaedaMaeda] p. 31 and its converse. ( ~ cvp analog.) (Contributed by NM, 5-Nov-2012.)
theorem cvlcvrp (A2 B2 C P c_or K c_an X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (w3a (wcel K coml) (wcel K ccla) (wcel K clc)) (wcel X B2) (wcel P A2)) (wb (wceq (co X P c_an) c_0) (wbr X (co X P c_or) C)) $;

--| An atom is covered by its join with a different atom. (Contributed by NM, 5-Nov-2012.)
theorem cvlatcvr1 (A2 C P Q c_or K: class):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (w3a (wcel K coml) (wcel K ccla) (wcel K clc)) (wcel P A2) (wcel Q A2)) (wb (wne P Q) (wbr P (co P Q c_or) C)) $;

--| An atom is covered by its join with a different atom. (Contributed by NM, 5-Nov-2012.)
theorem cvlatcvr2 (A2 C P Q c_or K: class):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (w3a (wcel K coml) (wcel K ccla) (wcel K clc)) (wcel P A2) (wcel Q A2)) (wb (wne P Q) (wbr P (co Q P c_or) C)) $;

--| Two equivalent ways of expressing that ` R ` is a superposition of ` P ` and ` Q ` . (Contributed by NM, 5-Nov-2012.)
theorem cvlsupr2 (A2 P Q R c_or K c_le: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wi (w3a (wcel K clc) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wne P Q)) (wb (wceq (co P R c_or) (co Q R c_or)) (w3a (wne R P) (wne R Q) (wbr R (co P Q c_or) c_le))) $;

--| Two equivalent ways of expressing that ` R ` is a superposition of ` P ` and ` Q ` , which can replace the superposition part of ~ ishlat1 , ` ( x =/= y -> E. z e. A ( z =/= x /\ z =/= y /\ z .<_ ( x .\/ y ) ) ` ` ) ` , with the simpler ` E. z e. A ( x .\/ z ) = ( y .\/ z ) ` as shown in ~ ishlat3N . (Contributed by NM, 5-Nov-2012.)
theorem cvlsupr3 (A2 P Q R c_or K c_le: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wi (wa (wcel K clc) (w3a (wcel P A2) (wcel Q A2) (wcel R A2))) (wb (wceq (co P R c_or) (co Q R c_or)) (wi (wne P Q) (w3a (wne R P) (wne R Q) (wbr R (co P Q c_or) c_le)))) $;

--| Consequence of superposition condition ` ( P .\/ R ) = ( Q .\/ R ) ` . (Contributed by NM, 9-Nov-2012.)
theorem cvlsupr4 (A2 P Q R c_or K c_le: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wi (w3a (wcel K clc) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wa (wne P Q) (wceq (co P R c_or) (co Q R c_or)))) (wbr R (co P Q c_or) c_le) $;

--| Consequence of superposition condition ` ( P .\/ R ) = ( Q .\/ R ) ` . (Contributed by NM, 9-Nov-2012.)
theorem cvlsupr5 (A2 P Q R c_or K: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wi (w3a (wcel K clc) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wa (wne P Q) (wceq (co P R c_or) (co Q R c_or)))) (wne R P) $;

--| Consequence of superposition condition ` ( P .\/ R ) = ( Q .\/ R ) ` . (Contributed by NM, 9-Nov-2012.)
theorem cvlsupr6 (A2 P Q R c_or K: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wi (w3a (wcel K clc) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wa (wne P Q) (wceq (co P R c_or) (co Q R c_or)))) (wne R Q) $;

--| Consequence of superposition condition ` ( P .\/ R ) = ( Q .\/ R ) ` . (Contributed by NM, 24-Nov-2012.)
theorem cvlsupr7 (A2 P Q R c_or K: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wi (w3a (wcel K clc) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wa (wne P Q) (wceq (co P R c_or) (co Q R c_or)))) (wceq (co P Q c_or) (co R Q c_or)) $;

--| Consequence of superposition condition ` ( P .\/ R ) = ( Q .\/ R ) ` . (Contributed by NM, 24-Nov-2012.)
theorem cvlsupr8 (A2 P Q R c_or K: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wi (w3a (wcel K clc) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wa (wne P Q) (wceq (co P R c_or) (co Q R c_or)))) (wceq (co P Q c_or) (co P R c_or)) $;

--| Extend class notation with Hilbert lattices.
term chlt: class;

--| Define the class of Hilbert lattices, which are complete, atomic lattices satisfying the superposition principle and minimum height. (Contributed by NM, 5-Nov-2012.)
axiom df_hlat {a b c l: setvar}:
  $ wceq chlt (crab l (wa (wral a (wral b (wi (wne (cv a) (cv b)) (wrex c (w3a (wne (cv c) (cv a)) (wne (cv c) (cv b)) (wbr (cv c) (co (cv a) (cv b) (cfv (cv l) cjn)) (cfv (cv l) cple))) (cfv (cv l) catm))) (cfv (cv l) catm)) (cfv (cv l) catm)) (wrex a (wrex b (wrex c (wa (wa (wbr (cfv (cv l) cp0) (cv a) (cfv (cv l) cplt)) (wbr (cv a) (cv b) (cfv (cv l) cplt))) (wa (wbr (cv b) (cv c) (cfv (cv l) cplt)) (wbr (cv c) (cfv (cv l) cp1) (cfv (cv l) cplt)))) (cfv (cv l) cbs)) (cfv (cv l) cbs)) (cfv (cv l) cbs))) (cin (cin coml ccla) clc)) $;

--| The predicate "is a Hilbert lattice", which is: is orthomodular ( ` K e. OML ` ), complete ( ` K e. CLat ` ), atomic and satisfies the exchange (or covering) property ( ` K e. CvLat ` ), satisfies the superposition principle, and has a minimum height of 4 (witnessed here by 0, x, y, z, 1). (Contributed by NM, 5-Nov-2012.)
theorem ishlat1 {x3 y1 z: setvar} (A2 B2: class) (c_lt c_1 c_or: class x3 y1 z) (K: class) (c_le c_0: class x3 y1 z):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq c_1 (cfv K cp1) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wb (wcel K chlt) (wa (w3a (wcel K coml) (wcel K ccla) (wcel K clc)) (wa (wral x3 (wral y1 (wi (wne (cv x3) (cv y1)) (wrex z (w3a (wne (cv z) (cv x3)) (wne (cv z) (cv y1)) (wbr (cv z) (co (cv x3) (cv y1) c_or) c_le)) A2)) A2) A2) (wrex x3 (wrex y1 (wrex z (wa (wa (wbr c_0 (cv x3) c_lt) (wbr (cv x3) (cv y1) c_lt)) (wa (wbr (cv y1) (cv z) c_lt) (wbr (cv z) c_1 c_lt))) B2) B2) B2))) $;

--| The predicate "is a Hilbert lattice". Here we replace ` K e. CvLat ` with the weaker ` K e. AtLat ` and show the exchange property explicitly. (Contributed by NM, 5-Nov-2012.)
theorem ishlat2 {x3 y1 z: setvar} (A2 B2: class) (c_lt c_1 c_or: class x3 y1 z) (K: class) (c_le c_0: class x3 y1 z):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq c_1 (cfv K cp1) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wb (wcel K chlt) (wa (w3a (wcel K coml) (wcel K ccla) (wcel K cal)) (wa (wral x3 (wral y1 (wa (wi (wne (cv x3) (cv y1)) (wrex z (w3a (wne (cv z) (cv x3)) (wne (cv z) (cv y1)) (wbr (cv z) (co (cv x3) (cv y1) c_or) c_le)) A2)) (wral z (wi (wa (wn (wbr (cv x3) (cv z) c_le)) (wbr (cv x3) (co (cv z) (cv y1) c_or) c_le)) (wbr (cv y1) (co (cv z) (cv x3) c_or) c_le)) B2)) A2) A2) (wrex x3 (wrex y1 (wrex z (wa (wa (wbr c_0 (cv x3) c_lt) (wbr (cv x3) (cv y1) c_lt)) (wa (wbr (cv y1) (cv z) c_lt) (wbr (cv z) c_1 c_lt))) B2) B2) B2))) $;

--| The predicate "is a Hilbert lattice". Note that the superposition principle is expressed in the compact form ` E. z e. A ( x .\/ z ) = ( y .\/ z ) ` . The exchange property and atomicity are provided by ` K e. CvLat ` , and "minimum height 4" is shown explicitly. (Contributed by NM, 8-Nov-2012.) (New usage is discouraged.)
theorem ishlat3N {x3 y1 z: setvar} (A2 B2: class) (c_lt c_1 c_or: class x3 y1 z) (K: class) (c_le c_0: class x3 y1 z):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq c_1 (cfv K cp1) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wb (wcel K chlt) (wa (w3a (wcel K coml) (wcel K ccla) (wcel K clc)) (wa (wral x3 (wral y1 (wrex z (wceq (co (cv x3) (cv z) c_or) (co (cv y1) (cv z) c_or)) A2) A2) A2) (wrex x3 (wrex y1 (wrex z (wa (wa (wbr c_0 (cv x3) c_lt) (wbr (cv x3) (cv y1) c_lt)) (wa (wbr (cv y1) (cv z) c_lt) (wbr (cv z) c_1 c_lt))) B2) B2) B2))) $;

--| Properties that determine a Hilbert lattice. (Contributed by NM, 13-Nov-2011.) (New usage is discouraged.)
theorem ishlatiN {x3 y1 z: setvar} (A2 B2: class) (c_lt c_1 c_or: class x3 y1 z) (K: class) (c_le c_0: class x3 y1 z):
  $ wcel K coml $ >
  $ wcel K ccla $ >
  $ wcel K cal $ >
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq c_1 (cfv K cp1) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wral x3 (wral y1 (wa (wi (wne (cv x3) (cv y1)) (wrex z (w3a (wne (cv z) (cv x3)) (wne (cv z) (cv y1)) (wbr (cv z) (co (cv x3) (cv y1) c_or) c_le)) A2)) (wral z (wi (wa (wn (wbr (cv x3) (cv z) c_le)) (wbr (cv x3) (co (cv z) (cv y1) c_or) c_le)) (wbr (cv y1) (co (cv z) (cv x3) c_or) c_le)) B2)) A2) A2 $ >
  $ wrex x3 (wrex y1 (wrex z (wa (wa (wbr c_0 (cv x3) c_lt) (wbr (cv x3) (cv y1) c_lt)) (wa (wbr (cv y1) (cv z) c_lt) (wbr (cv z) c_1 c_lt))) B2) B2) B2 $ >
  $ wcel K chlt $;

--| A Hilbert lattice is orthomodular, complete, and has the covering (exchange) property. (Contributed by NM, 5-Nov-2012.)
theorem hlomcmcv (K: class):
  $ wi (wcel K chlt) (w3a (wcel K coml) (wcel K ccla) (wcel K clc)) $;

--| A Hilbert lattice is orthomodular. (Contributed by NM, 20-Oct-2011.)
theorem hloml (K: class):
  $ wi (wcel K chlt) (wcel K coml) $;

--| A Hilbert lattice is complete. (Contributed by NM, 20-Oct-2011.)
theorem hlclat (K: class):
  $ wi (wcel K chlt) (wcel K ccla) $;

--| A Hilbert lattice is an atomic lattice with the covering property. (Contributed by NM, 5-Nov-2012.)
theorem hlcvl (K: class):
  $ wi (wcel K chlt) (wcel K clc) $;

--| A Hilbert lattice is atomic. (Contributed by NM, 20-Oct-2011.)
theorem hlatl (K: class):
  $ wi (wcel K chlt) (wcel K cal) $;

--| A Hilbert lattice is an ortholattice. (Contributed by NM, 20-Oct-2011.)
theorem hlol (K: class):
  $ wi (wcel K chlt) (wcel K col) $;

--| A Hilbert lattice is an orthoposet. (Contributed by NM, 20-Oct-2011.)
theorem hlop (K: class):
  $ wi (wcel K chlt) (wcel K cops) $;

--| A Hilbert lattice is a lattice. (Contributed by NM, 20-Oct-2011.)
theorem hllat (K: class):
  $ wi (wcel K chlt) (wcel K clat) $;

--| Deduction form of ~ hllat . A Hilbert lattice is a lattice. (Contributed by BJ, 14-Aug-2022.)
theorem hllatd (ph: wff) (K: class):
  $ wi ph (wcel K chlt) $ >
  $ wi ph (wcel K clat) $;

--| A Hilbert lattice is orthomodular, complete, and atomic. (Contributed by NM, 5-Nov-2012.)
theorem hlomcmat (K: class):
  $ wi (wcel K chlt) (w3a (wcel K coml) (wcel K ccla) (wcel K cal)) $;

--| A Hilbert lattice is a poset. (Contributed by NM, 20-Oct-2011.)
theorem hlpos (K: class):
  $ wi (wcel K chlt) (wcel K cpo) $;

--| Closure of join operation. Frequently-used special case of ~ latjcl for atoms. (Contributed by NM, 15-Jun-2012.)
theorem hlatjcl (A2 B2 c_or K X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (wcel X A2) (wcel Y A2)) (wcel (co X Y c_or) B2) $;

--| Commutatitivity of join operation. Frequently-used special case of ~ latjcom for atoms. (Contributed by NM, 15-Jun-2012.)
theorem hlatjcom (A2 c_or K X Y: class):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (wcel X A2) (wcel Y A2)) (wceq (co X Y c_or) (co Y X c_or)) $;

--| Idempotence of join operation. Frequently-used special case of ~ latjcom for atoms. (Contributed by NM, 15-Jul-2012.)
theorem hlatjidm (A2 c_or K X: class):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (wcel K chlt) (wcel X A2)) (wceq (co X X c_or) X) $;

--| Lattice join is associative. Frequently-used special case of ~ latjass for atoms. (Contributed by NM, 27-Jul-2012.)
theorem hlatjass (A2 P Q R c_or K: class):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel R A2))) (wceq (co (co P Q c_or) R c_or) (co P (co Q R c_or) c_or)) $;

--| Swap 1st and 2nd members of lattice join. Frequently-used special case of ~ latj32 for atoms. (Contributed by NM, 4-Jun-2012.)
theorem hlatj12 (A2 P Q R c_or K: class):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel R A2))) (wceq (co P (co Q R c_or) c_or) (co Q (co P R c_or) c_or)) $;

--| Swap 2nd and 3rd members of lattice join. Frequently-used special case of ~ latj32 for atoms. (Contributed by NM, 21-Jul-2012.)
theorem hlatj32 (A2 P Q R c_or K: class):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel R A2))) (wceq (co (co P Q c_or) R c_or) (co (co P R c_or) Q c_or)) $;

--| Rotate lattice join of 3 classes. Frequently-used special case of ~ latjrot for atoms. (Contributed by NM, 2-Aug-2012.)
theorem hlatjrot (A2 P Q R c_or K: class):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel R A2))) (wceq (co (co P Q c_or) R c_or) (co (co R P c_or) Q c_or)) $;

--| Rearrangement of lattice join of 4 classes. Frequently-used special case of ~ latj4 for atoms. (Contributed by NM, 9-Aug-2012.)
theorem hlatj4 (A2 P Q R S c_or K: class):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (wa (wcel P A2) (wcel Q A2)) (wa (wcel R A2) (wcel S A2))) (wceq (co (co P Q c_or) (co R S c_or) c_or) (co (co P R c_or) (co Q S c_or) c_or)) $;

--| A join's first argument is less than or equal to the join. Special case of ~ latlej1 to show an atom is on a line. (Contributed by NM, 15-May-2013.)
theorem hlatlej1 (A2 P Q c_or K c_le: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (wcel P A2) (wcel Q A2)) (wbr P (co P Q c_or) c_le) $;

--| A join's second argument is less than or equal to the join. Special case of ~ latlej2 to show an atom is on a line. (Contributed by NM, 15-May-2013.)
theorem hlatlej2 (A2 P Q c_or K c_le: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (wcel P A2) (wcel Q A2)) (wbr Q (co P Q c_or) c_le) $;

--| De Morgan's law for GLB and LUB. This holds in any complete ortholattice, although we assume ` HL ` for convenience. (Contributed by NM, 17-Jan-2012.) New ~ df-riota . (Revised by SN, 3-Jan-2025.) (New usage is discouraged.)
theorem glbconN {x3: setvar} (B2 S: class) (U G K: class x3) (c_pe: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq U (cfv K club) $ >
  $ wceq G (cfv K cglb) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wi (wa (wcel K chlt) (wss S B2)) (wceq (cfv S G) (cfv (cfv (crab x3 (wcel (cfv (cv x3) c_pe) S) B2) U) c_pe)) $;

--| De Morgan's law for GLB and LUB. Index-set version of ~ glbconN , where we read ` S ` as ` S ( i ) ` . (Contributed by NM, 17-Jan-2012.) (New usage is discouraged.)
theorem glbconxN {x3 i: setvar} (B2: class) (S: class i) (U G: class x3 i) (I: class i) (K: class x3) (c_pe: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq U (cfv K club) $ >
  $ wceq G (cfv K cglb) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wi (wa (wcel K chlt) (wral i (wcel S B2) I)) (wceq (cfv (cab x3 (wrex i (wceq (cv x3) S) I)) G) (cfv (cfv (cab x3 (wrex i (wceq (cv x3) (cfv S c_pe)) I)) U) c_pe)) $;

--| If an atom is not less than or equal to the join of two others, it is not equal to either. (This also holds for non-atoms, but in this form it is convenient.) (Contributed by NM, 8-Jan-2012.)
theorem atnlej1 (A2 P Q R c_or K c_le: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wn (wbr P (co Q R c_or) c_le))) (wne P Q) $;

--| If an atom is not less than or equal to the join of two others, it is not equal to either. (This also holds for non-atoms, but in this form it is convenient.) (Contributed by NM, 8-Jan-2012.)
theorem atnlej2 (A2 P Q R c_or K c_le: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wn (wbr P (co Q R c_or) c_le))) (wne P R) $;

--| A Hilbert lattice has the superposition and exchange properties. (Contributed by NM, 13-Nov-2011.)
theorem hlsuprexch {z: setvar} (A2 B2 P Q: class) (c_or: class z) (K: class) (c_le: class z):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (wcel P A2) (wcel Q A2)) (wa (wi (wne P Q) (wrex z (w3a (wne (cv z) P) (wne (cv z) Q) (wbr (cv z) (co P Q c_or) c_le)) A2)) (wral z (wi (wa (wn (wbr P (cv z) c_le)) (wbr P (co (cv z) Q c_or) c_le)) (wbr Q (co (cv z) P c_or) c_le)) B2)) $;

--| A Hilbert lattice has the exchange property. (Contributed by NM, 13-Nov-2011.)
theorem hlexch1 (A2 B2 P Q c_or K c_le X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel X B2)) (wn (wbr P X c_le))) (wi (wbr P (co X Q c_or) c_le) (wbr Q (co X P c_or) c_le)) $;

--| A Hilbert lattice has the exchange property. (Contributed by NM, 6-May-2012.)
theorem hlexch2 (A2 B2 P Q c_or K c_le X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel X B2)) (wn (wbr P X c_le))) (wi (wbr P (co Q X c_or) c_le) (wbr Q (co P X c_or) c_le)) $;

--| A Hilbert lattice has the exchange property. (Contributed by NM, 16-Nov-2011.)
theorem hlexchb1 (A2 B2 P Q c_or K c_le X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel X B2)) (wn (wbr P X c_le))) (wb (wbr P (co X Q c_or) c_le) (wceq (co X P c_or) (co X Q c_or))) $;

--| A Hilbert lattice has the exchange property. (Contributed by NM, 22-Jun-2012.)
theorem hlexchb2 (A2 B2 P Q c_or K c_le X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel X B2)) (wn (wbr P X c_le))) (wb (wbr P (co Q X c_or) c_le) (wceq (co P X c_or) (co Q X c_or))) $;

--| A Hilbert lattice has the superposition property. Theorem 13.2 in [Crawley] p. 107. (Contributed by NM, 30-Jan-2012.)
theorem hlsupr {r: setvar} (A2 P Q: class) (c_or: class r) (K: class) (c_le: class r):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (w3a (wcel K chlt) (wcel P A2) (wcel Q A2)) (wne P Q)) (wrex r (w3a (wne (cv r) P) (wne (cv r) Q) (wbr (cv r) (co P Q c_or) c_le)) A2) $;

--| A Hilbert lattice has the superposition property. (Contributed by NM, 25-Nov-2012.)
theorem hlsupr2 {r: setvar} (A2 P Q: class) (c_or: class r) (K: class):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (wcel P A2) (wcel Q A2)) (wrex r (wceq (co P (cv r) c_or) (co Q (cv r) c_or)) A2) $;

--| A Hilbert lattice has a height of at least 4. (Contributed by NM, 4-Dec-2011.)
theorem hlhgt4 {x3 y1 z: setvar} (B2: class) (c_lt c_1: class x3 y1 z) (K: class) (c_0: class x3 y1 z):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq c_1 (cfv K cp1) $ >
  $ wi (wcel K chlt) (wrex x3 (wrex y1 (wrex z (wa (wa (wbr c_0 (cv x3) c_lt) (wbr (cv x3) (cv y1) c_lt)) (wa (wbr (cv y1) (cv z) c_lt) (wbr (cv z) c_1 c_lt))) B2) B2) B2) $;

--| A Hilbert lattice has a height of at least 2. (Contributed by NM, 4-Dec-2011.)
theorem hlhgt2 {x3: setvar} (B2: class) (c_lt c_1: class x3) (K: class) (c_0: class x3):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq c_1 (cfv K cp1) $ >
  $ wi (wcel K chlt) (wrex x3 (wa (wbr c_0 (cv x3) c_lt) (wbr (cv x3) c_1 c_lt)) B2) $;

--| Lattice 0 is less than lattice 1 in a Hilbert lattice. (Contributed by NM, 4-Dec-2011.) (New usage is discouraged.)
theorem hl0lt1N (c_lt c_1 K c_0: class):
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq c_1 (cfv K cp1) $ >
  $ wi (wcel K chlt) (wbr c_0 c_1 c_lt) $;

--| A Hilbert lattice has the exchange property. ( ~ atexch analog.) (Contributed by NM, 15-Nov-2011.)
theorem hlexch3 (A2 B2 P Q c_or K c_le c_an X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel X B2)) (wceq (co P X c_an) c_0)) (wi (wbr P (co X Q c_or) c_le) (wbr Q (co X P c_or) c_le)) $;

--| A Hilbert lattice has the exchange property. Part of Definition 7.8 of [MaedaMaeda] p. 32. (Contributed by NM, 15-Nov-2011.) (New usage is discouraged.)
theorem hlexch4N (A2 B2 P Q c_or K c_le c_an X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel X B2)) (wceq (co P X c_an) c_0)) (wb (wbr P (co X Q c_or) c_le) (wceq (co X P c_or) (co X Q c_or))) $;

--| A version of ~ hlexchb1 for atoms. (Contributed by NM, 15-Nov-2011.)
theorem hlatexchb1 (A2 P Q R c_or K c_le: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wne P R)) (wb (wbr P (co R Q c_or) c_le) (wceq (co R P c_or) (co R Q c_or))) $;

--| A version of ~ hlexchb2 for atoms. (Contributed by NM, 7-Feb-2012.)
theorem hlatexchb2 (A2 P Q R c_or K c_le: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wne P R)) (wb (wbr P (co Q R c_or) c_le) (wceq (co P R c_or) (co Q R c_or))) $;

--| Atom exchange property. (Contributed by NM, 7-Jan-2012.)
theorem hlatexch1 (A2 P Q R c_or K c_le: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wne P R)) (wi (wbr P (co R Q c_or) c_le) (wbr Q (co R P c_or) c_le)) $;

--| Atom exchange property. (Contributed by NM, 8-Jan-2012.)
theorem hlatexch2 (A2 P Q R c_or K c_le: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wne P R)) (wi (wbr P (co Q R c_or) c_le) (wbr Q (co P R c_or) c_le)) $;

--| An atomic, complete, orthomodular lattice is atomistic i.e. every element is the join of the atoms under it. See remark before Proposition 1 in [Kalmbach] p. 140; also remark in [BeltramettiCassinelli] p. 98. ( ~ hatomistici analog.) (Contributed by NM, 21-Oct-2011.) (New usage is discouraged.)
theorem hlatmstcOLDN {y1: setvar} (A2 B2: class) (U K: class y1) (c_le X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq U (cfv K club) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (wcel K chlt) (wcel X B2)) (wceq (cfv (crab y1 (wbr (cv y1) X c_le) A2) U) X) $;

--| The ordering of two Hilbert lattice elements is determined by the atoms under them. ( ~ chrelat3 analog.) (Contributed by NM, 4-Nov-2011.)
theorem hlatle {p: setvar} (A2 B2 K c_le X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (wcel X B2) (wcel Y B2)) (wb (wbr X Y c_le) (wral p (wi (wbr (cv p) X c_le) (wbr (cv p) Y c_le)) A2)) $;

--| The equality of two Hilbert lattice elements is determined by the atoms under them. ( ~ chrelat4i analog.) (Contributed by NM, 24-May-2012.)
theorem hlateq {p: setvar} (A2 B2 K c_le X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (wcel X B2) (wcel Y B2)) (wb (wral p (wb (wbr (cv p) X c_le) (wbr (cv p) Y c_le)) A2) (wceq X Y)) $;

--| An atomistic lattice with 0 is relatively atomic. Part of Lemma 7.2 of [MaedaMaeda] p. 30. ( ~ chpssati , with ` /\ ` swapped, analog.) (Contributed by NM, 4-Dec-2011.)
theorem hlrelat1 {p: setvar} (A2 B2: class) (c_lt: class p) (K c_le X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (wcel X B2) (wcel Y B2)) (wi (wbr X Y c_lt) (wrex p (wa (wn (wbr (cv p) X c_le)) (wbr (cv p) Y c_le)) A2)) $;

--| An atomistic lattice with 0 is relatively atomic, using the definition in Remark 2 of [Kalmbach] p. 149. (Contributed by NM, 21-Oct-2011.) (New usage is discouraged.)
theorem hlrelat5N {p: setvar} (A2 B2: class) (c_lt c_or: class p) (K c_le X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (w3a (wcel K chlt) (wcel X B2) (wcel Y B2)) (wbr X Y c_lt)) (wrex p (wa (wbr X (co X (cv p) c_or) c_lt) (wbr (cv p) Y c_le)) A2) $;

--| A Hilbert lattice is relatively atomic. Remark 2 of [Kalmbach] p. 149. ( ~ chrelati analog.) (Contributed by NM, 4-Feb-2012.)
theorem hlrelat {p: setvar} (A2 B2 c_lt: class) (c_or: class p) (K c_le X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (w3a (wcel K chlt) (wcel X B2) (wcel Y B2)) (wbr X Y c_lt)) (wrex p (wa (wbr X (co X (cv p) c_or) c_lt) (wbr (co X (cv p) c_or) Y c_le)) A2) $;

--| A consequence of relative atomicity. ( ~ chrelat2i analog.) (Contributed by NM, 5-Feb-2012.)
theorem hlrelat2 {p: setvar} (A2 B2 K c_le X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (wcel X B2) (wcel Y B2)) (wb (wn (wbr X Y c_le)) (wrex p (wa (wbr (cv p) X c_le) (wn (wbr (cv p) Y c_le))) A2)) $;

--| A condition for an atom to be less than or equal to a lattice element. Part of proof of Lemma A in [Crawley] p. 112. (Contributed by NM, 28-Apr-2012.) (New usage is discouraged.)
theorem exatleN (A2 B2 P Q R c_or K c_le X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel X B2)) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wbr P X c_le) (wn (wbr Q X c_le)) (wbr R (co P Q c_or) c_le))) (wb (wbr R X c_le) (wceq R P)) $;

--| A Hilbert lattice has at least 2 atoms. (Contributed by NM, 5-Dec-2011.)
theorem hl2at {q p: setvar} (A2 K: class):
  $ wceq A2 (cfv K catm) $ >
  $ wi (wcel K chlt) (wrex p (wrex q (wne (cv p) (cv q)) A2) A2) $;

--| At least one atom exists. (Contributed by NM, 15-Jul-2012.)
theorem atex (A2 K: class):
  $ wceq A2 (cfv K catm) $ >
  $ wi (wcel K chlt) (wne A2 c0) $;

--| If the intersection with a non-majorizing element is an atom, the intersecting element is not an atom. (Contributed by NM, 26-Jun-2012.) (New usage is discouraged.)
theorem intnatN (A2 B2 K c_le c_an X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (w3a (wcel K chlt) (wcel X B2) (wcel Y B2)) (wa (wn (wbr Y X c_le)) (wcel (co X Y c_an) A2))) (wn (wcel Y A2)) $;

--| Condition implying that two intersecting lines are different. (Contributed by NM, 13-Jun-2012.) (New usage is discouraged.)
theorem _2llnne2N (A2 P Q R c_or K c_le: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (wa (wcel P A2) (wcel R A2)) (wn (wbr P (co R Q c_or) c_le))) (wne (co R P c_or) (co R Q c_or)) $;

--| Condition implying that two intersecting lines are different. (Contributed by NM, 29-May-2012.) (New usage is discouraged.)
theorem _2llnneN (A2 P Q R c_or K c_le: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wa (wne P Q) (wn (wbr R (co P Q c_or) c_le)))) (wne (co R P c_or) (co R Q c_or)) $;

--| A Hilbert lattice has the covering property. Proposition 1(ii) in [Kalmbach] p. 140 (and its converse). ( ~ chcv1 analog.) (Contributed by NM, 17-Nov-2011.)
theorem cvr1 (A2 B2 C P c_or K c_le X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (wcel X B2) (wcel P A2)) (wb (wn (wbr P X c_le)) (wbr X (co X P c_or) C)) $;

--| Less-than and covers equivalence in a Hilbert lattice. ( ~ chcv2 analog.) (Contributed by NM, 7-Feb-2012.) (New usage is discouraged.)
theorem cvr2N (A2 B2 C P c_lt c_or K X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (wcel X B2) (wcel P A2)) (wb (wbr X (co X P c_or) c_lt) (wbr X (co X P c_or) C)) $;

--| The Hilbert lattice is relatively atomic. Stronger version of ~ hlrelat . (Contributed by NM, 2-May-2012.)
theorem hlrelat3 {p: setvar} (A2 B2: class) (C: class p) (c_lt: class) (c_or: class p) (K c_le X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (w3a (wcel K chlt) (wcel X B2) (wcel Y B2)) (wbr X Y c_lt)) (wrex p (wa (wbr X (co X (cv p) c_or) C) (wbr (co X (cv p) c_or) Y c_le)) A2) $;

--| Binary relation expressing ` Y ` covers ` X ` . (Contributed by NM, 16-Jun-2012.)
theorem cvrval3 {p: setvar} (A2 B2 C: class) (c_or: class p) (K c_le X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (wcel X B2) (wcel Y B2)) (wb (wbr X Y C) (wrex p (wa (wn (wbr (cv p) X c_le)) (wceq (co X (cv p) c_or) Y)) A2)) $;

--| Binary relation expressing ` Y ` covers ` X ` . (Contributed by NM, 16-Jun-2012.) (New usage is discouraged.)
theorem cvrval4N {p: setvar} (A2 B2 C c_lt: class) (c_or: class p) (K X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (wcel X B2) (wcel Y B2)) (wb (wbr X Y C) (wa (wbr X Y c_lt) (wrex p (wceq (co X (cv p) c_or) Y) A2))) $;

--| Binary relation expressing ` X ` covers ` X ./\ Y ` . (Contributed by NM, 7-Dec-2012.)
theorem cvrval5 {p: setvar} (A2 B2 C: class) (c_or: class p) (K c_le c_an X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (wcel X B2) (wcel Y B2)) (wb (wbr (co X Y c_an) X C) (wrex p (wa (wn (wbr (cv p) Y c_le)) (wceq (co (cv p) (co X Y c_an) c_or) X)) A2)) $;

--| A Hilbert lattice satisfies the covering property of Definition 7.4 of [MaedaMaeda] p. 31 and its converse. ( ~ cvp analog.) (Contributed by NM, 18-Nov-2011.)
theorem cvrp (A2 B2 C P c_or K c_an X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (wcel X B2) (wcel P A2)) (wb (wceq (co X P c_an) c_0) (wbr X (co X P c_or) C)) $;

--| An atom is covered by its join with a different atom. (Contributed by NM, 7-Feb-2012.)
theorem atcvr1 (A2 C P Q c_or K: class):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (wcel P A2) (wcel Q A2)) (wb (wne P Q) (wbr P (co P Q c_or) C)) $;

--| An atom is covered by its join with a different atom. (Contributed by NM, 7-Feb-2012.)
theorem atcvr2 (A2 C P Q c_or K: class):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (wcel P A2) (wcel Q A2)) (wb (wne P Q) (wbr P (co Q P c_or) C)) $;

--| Lemma for ~ cvrexch . ( ~ cvexchlem analog.) (Contributed by NM, 18-Nov-2011.)
theorem cvrexchlem (B2 C c_or K c_an X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wi (w3a (wcel K chlt) (wcel X B2) (wcel Y B2)) (wi (wbr (co X Y c_an) Y C) (wbr X (co X Y c_or) C)) $;

--| A Hilbert lattice satisfies the exchange axiom. Proposition 1(iii) of [Kalmbach] p. 140 and its converse. Originally proved by Garrett Birkhoff in 1933. ( ~ cvexchi analog.) (Contributed by NM, 18-Nov-2011.)
theorem cvrexch (B2 C c_or K c_an X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wi (w3a (wcel K chlt) (wcel X B2) (wcel Y B2)) (wb (wbr (co X Y c_an) Y C) (wbr X (co X Y c_or) C)) $;

--| Lemma for ~ cvrat . ( ~ atcvatlem analog.) (Contributed by NM, 22-Nov-2011.)
theorem cvratlem (A2 B2 P Q c_lt c_or K X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (wa (wcel K chlt) (w3a (wcel X B2) (wcel P A2) (wcel Q A2))) (wa (wne X c_0) (wbr X (co P Q c_or) c_lt))) (wi (wn (wbr P X (cfv K cple))) (wcel X A2)) $;

--| A nonzero Hilbert lattice element less than the join of two atoms is an atom. ( ~ atcvati analog.) (Contributed by NM, 22-Nov-2011.)
theorem cvrat (A2 B2 P Q c_lt c_or K X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (wcel K chlt) (w3a (wcel X B2) (wcel P A2) (wcel Q A2))) (wi (wa (wne X c_0) (wbr X (co P Q c_or) c_lt)) (wcel X A2)) $;

--| A chained strong ordering is not a covers relation. (Contributed by NM, 18-Jun-2012.)
theorem ltltncvr (A2 B2 C c_lt K X Y Z: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wi (wa (wcel K A2) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2))) (wi (wa (wbr X Y c_lt) (wbr Y Z c_lt)) (wn (wbr X Z C))) $;

--| Non-transitive condition for the covers relation. (Contributed by NM, 18-Jun-2012.)
theorem ltcvrntr (A2 B2 C c_lt K X Y Z: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wi (wa (wcel K A2) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2))) (wi (wa (wbr X Y c_lt) (wbr Y Z C)) (wn (wbr X Z C))) $;

--| The covers relation is not transitive. ( ~ cvntr analog.) (Contributed by NM, 18-Jun-2012.)
theorem cvrntr (A2 B2 C K X Y Z: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wi (wa (wcel K A2) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2))) (wi (wa (wbr X Y C) (wbr Y Z C)) (wn (wbr X Z C))) $;

--| The covers relation is not transitive. ( ~ atcv0eq analog.) (Contributed by NM, 29-Nov-2011.)
theorem atcvr0eq (A2 C P Q c_or K c_0: class):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (wcel P A2) (wcel Q A2)) (wb (wbr c_0 (co P Q c_or) C) (wceq P Q)) $;

--| A line (the join of two distinct atoms) is not an atom. (Contributed by NM, 14-Jun-2012.)
theorem lnnat (A2 P Q c_or K: class):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (wcel P A2) (wcel Q A2)) (wb (wne P Q) (wn (wcel (co P Q c_or) A2))) $;

--| Two atoms covering the zero subspace are equal. ( ~ atcv1 analog.) (Contributed by NM, 29-Nov-2011.)
theorem atcvrj0 (A2 B2 C P Q c_or K X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel X B2) (wcel P A2) (wcel Q A2)) (wbr X (co P Q c_or) C)) (wb (wceq X c_0) (wceq P Q)) $;

--| A Hilbert lattice element covered by the join of two distinct atoms is an atom. ( ~ atcvat2i analog.) (Contributed by NM, 30-Nov-2011.)
theorem cvrat2 (A2 B2 C P Q c_or K X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel X B2) (wcel P A2) (wcel Q A2)) (wa (wne P Q) (wbr X (co P Q c_or) C))) (wcel X A2) $;

--| Inequality derived from atom condition. (Contributed by NM, 7-Feb-2012.) (New usage is discouraged.)
theorem atcvrneN (A2 C P Q R c_or K: class):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wbr P (co Q R c_or) C)) (wne Q R) $;

--| Condition for an atom to be covered by the join of two others. (Contributed by NM, 7-Feb-2012.)
theorem atcvrj1 (A2 C P Q R c_or K c_le: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wa (wne P R) (wbr P (co Q R c_or) c_le))) (wbr P (co Q R c_or) C) $;

--| Condition for an atom to be covered by the join of two others. (Contributed by NM, 7-Feb-2012.)
theorem atcvrj2b (A2 C P Q R c_or K c_le: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel R A2))) (wb (wa (wne Q R) (wbr P (co Q R c_or) c_le)) (wbr P (co Q R c_or) C)) $;

--| Condition for an atom to be covered by the join of two others. (Contributed by NM, 7-Feb-2012.)
theorem atcvrj2 (A2 C P Q R c_or K c_le: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wa (wne Q R) (wbr P (co Q R c_or) c_le))) (wbr P (co Q R c_or) C) $;

--| Inequality derived from atom condition. (Contributed by NM, 7-Feb-2012.) (New usage is discouraged.)
theorem atleneN (A2 P Q R c_or K c_le: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wa (wne P R) (wbr P (co Q R c_or) c_le))) (wne Q R) $;

--| An equivalence of less-than ordering and covers relation. (Contributed by NM, 7-Feb-2012.)
theorem atltcvr (A2 C P Q R c_lt c_or K: class):
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wi (wa (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel R A2))) (wb (wbr P (co Q R c_or) c_lt) (wbr P (co Q R c_or) C)) $;

--| Any nonzero element has an atom under it. (Contributed by NM, 28-Jun-2012.)
theorem atle {p: setvar} (A2 B2 K c_le X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (wcel X B2) (wne X c_0)) (wrex p (wbr (cv p) X c_le) A2) $;

--| Two atoms are unequal iff their join is greater than one of them. (Contributed by NM, 6-May-2012.)
theorem atlt (A2 P Q c_lt c_or K: class):
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (wcel P A2) (wcel Q A2)) (wb (wbr P (co P Q c_or) c_lt) (wne P Q)) $;

--| Transfer less-than relation from one atom to another. (Contributed by NM, 7-May-2012.)
theorem atlelt (A2 B2 P Q c_lt K c_le X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel X B2)) (wa (wbr P X c_le) (wbr Q X c_lt))) (wbr P X c_lt) $;

--| Given an atom less than an element, there is another atom less than the element. (Contributed by NM, 6-May-2012.)
theorem _2atlt {q: setvar} (A2 B2 P c_lt K X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (w3a (wcel K chlt) (wcel P A2) (wcel X B2)) (wbr P X c_lt)) (wrex q (wa (wne (cv q) P) (wbr (cv q) X c_lt)) A2) $;

--| Atom exchange property. Version of ~ hlatexch2 with covers relation. (Contributed by NM, 7-Feb-2012.) (New usage is discouraged.)
theorem atexchcvrN (A2 C P Q R c_or K: class):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wne P R)) (wi (wbr P (co Q R c_or) C) (wbr Q (co P R c_or) C)) $;

--| Atom exchange property. Version of ~ hlatexch2 with less-than ordering. (Contributed by NM, 7-Feb-2012.) (New usage is discouraged.)
theorem atexchltN (A2 P Q R c_lt c_or K: class):
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wne P R)) (wi (wbr P (co Q R c_or) c_lt) (wbr Q (co P R c_or) c_lt)) $;

--| A condition implying that a certain lattice element is an atom. Part of Lemma 3.2.20 of [PtakPulmannova] p. 68. ( ~ atcvat3i analog.) (Contributed by NM, 30-Nov-2011.)
theorem cvrat3 (A2 B2 P Q c_or K c_le c_an X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (wcel K chlt) (w3a (wcel X B2) (wcel P A2) (wcel Q A2))) (wi (w3a (wne P Q) (wn (wbr Q X c_le)) (wbr P (co X Q c_or) c_le)) (wcel (co X (co P Q c_or) c_an) A2)) $;

--| A condition implying existence of an atom with the properties shown. Lemma 3.2.20 in [PtakPulmannova] p. 68. Also Lemma 9.2(delta) in [MaedaMaeda] p. 41. ( ~ atcvat4i analog.) (Contributed by NM, 30-Nov-2011.)
theorem cvrat4 {r: setvar} (A2 B2 P Q c_or K c_le X: class) (c_0: class r):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (wcel K chlt) (w3a (wcel X B2) (wcel P A2) (wcel Q A2))) (wi (wa (wne X c_0) (wbr P (co X Q c_or) c_le)) (wrex r (wa (wbr (cv r) X c_le) (wbr P (co Q (cv r) c_or) c_le)) A2)) $;

--| Commuted version of ~ cvrat4 . (Contributed by NM, 28-Jan-2012.)
theorem cvrat42 {r: setvar} (A2 B2 P Q c_or K c_le X: class) (c_0: class r):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (wcel K chlt) (w3a (wcel X B2) (wcel P A2) (wcel Q A2))) (wi (wa (wne X c_0) (wbr P (co X Q c_or) c_le)) (wrex r (wa (wbr (cv r) X c_le) (wbr P (co (cv r) Q c_or) c_le)) A2)) $;

--| The meet of a line (expressed with 2 atoms) and a lattice element. (Contributed by NM, 30-Jul-2012.)
theorem _2atjm (A2 B2 P Q c_or K c_le c_an X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel X B2)) (wa (wbr P X c_le) (wn (wbr Q X c_le)))) (wceq (co (co P Q c_or) X c_an) P) $;

--| Property of a 3rd atom ` R ` on a line ` P .\/ Q ` intersecting element ` X ` at ` P ` . (Contributed by NM, 30-Jul-2012.)
theorem atbtwn (A2 B2 P Q R c_or K c_le X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (w3a (wcel K chlt) (wcel P A2) (wcel Q A2)) (wa (wcel R A2) (wcel X B2)) (w3a (wbr P X c_le) (wn (wbr Q X c_le)) (wbr R (co P Q c_or) c_le))) (wb (wne R P) (wn (wbr R X c_le))) $;

--| There exists a 3rd atom ` r ` on a line ` P .\/ Q ` intersecting element ` X ` at ` P ` , such that ` r ` is different from ` Q ` and not in ` X ` . (Contributed by NM, 30-Jul-2012.) (New usage is discouraged.)
theorem atbtwnexOLDN {r: setvar} (A2 B2 P Q: class) (c_or: class r) (K c_le X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (w3a (wcel K chlt) (wcel P A2) (wcel Q A2)) (w3a (wcel X B2) (wbr P X c_le) (wn (wbr Q X c_le)))) (wrex r (w3a (wne (cv r) Q) (wn (wbr (cv r) X c_le)) (wbr (cv r) (co P Q c_or) c_le)) A2) $;

--| Given atoms ` P ` in ` X ` and ` Q ` not in ` X ` , there exists an atom ` r ` not in ` X ` such that the line ` Q .\/ r ` intersects ` X ` at ` P ` . (Contributed by NM, 1-Aug-2012.)
theorem atbtwnex {r: setvar} (A2 B2 P Q: class) (c_or: class r) (K c_le X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (w3a (wcel K chlt) (wcel P A2) (wcel Q A2)) (w3a (wcel X B2) (wbr P X c_le) (wn (wbr Q X c_le)))) (wrex r (w3a (wne (cv r) Q) (wn (wbr (cv r) X c_le)) (wbr P (co Q (cv r) c_or) c_le)) A2) $;

--| Two ways to express 3 non-colinear atoms (rotated right 2 places). (Contributed by NM, 12-Jul-2012.)
theorem _3noncolr2 (A2 P Q R c_or K c_le: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wa (wne P Q) (wn (wbr R (co P Q c_or) c_le)))) (wa (wne Q R) (wn (wbr P (co Q R c_or) c_le))) $;

--| Two ways to express 3 non-colinear atoms (rotated right 1 place). (Contributed by NM, 12-Jul-2012.) (New usage is discouraged.)
theorem _3noncolr1N (A2 P Q R c_or K c_le: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wa (wne P Q) (wn (wbr R (co P Q c_or) c_le)))) (wa (wne R P) (wn (wbr Q (co R P c_or) c_le))) $;

--| Atom exchange combined with contraposition. (Contributed by NM, 13-Jun-2012.)
theorem hlatcon3 (A2 P Q R c_or K c_le: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wa (wne P Q) (wn (wbr R (co P Q c_or) c_le)))) (wn (wbr P (co Q R c_or) c_le)) $;

--| Atom exchange combined with contraposition. (Contributed by NM, 13-Jun-2012.)
theorem hlatcon2 (A2 P Q R c_or K c_le: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wa (wne P Q) (wn (wbr R (co P Q c_or) c_le)))) (wn (wbr P (co R Q c_or) c_le)) $;

--| A way to express 4 non-colinear atoms (rotated right 3 places). (Contributed by NM, 11-Jul-2012.)
theorem _4noncolr3 (A2 P Q R S c_or K c_le: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (w3a (wcel K chlt) (wcel P A2) (wcel Q A2)) (wa (wcel R A2) (wcel S A2)) (w3a (wne P Q) (wn (wbr R (co P Q c_or) c_le)) (wn (wbr S (co (co P Q c_or) R c_or) c_le)))) (w3a (wne Q R) (wn (wbr S (co Q R c_or) c_le)) (wn (wbr P (co (co Q R c_or) S c_or) c_le))) $;

--| A way to express 4 non-colinear atoms (rotated right 2 places). (Contributed by NM, 11-Jul-2012.)
theorem _4noncolr2 (A2 P Q R S c_or K c_le: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (w3a (wcel K chlt) (wcel P A2) (wcel Q A2)) (wa (wcel R A2) (wcel S A2)) (w3a (wne P Q) (wn (wbr R (co P Q c_or) c_le)) (wn (wbr S (co (co P Q c_or) R c_or) c_le)))) (w3a (wne R S) (wn (wbr P (co R S c_or) c_le)) (wn (wbr Q (co (co R S c_or) P c_or) c_le))) $;

--| A way to express 4 non-colinear atoms (rotated right 1 places). (Contributed by NM, 11-Jul-2012.)
theorem _4noncolr1 (A2 P Q R S c_or K c_le: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (w3a (wcel K chlt) (wcel P A2) (wcel Q A2)) (wa (wcel R A2) (wcel S A2)) (w3a (wne P Q) (wn (wbr R (co P Q c_or) c_le)) (wn (wbr S (co (co P Q c_or) R c_or) c_le)))) (w3a (wne S P) (wn (wbr Q (co S P c_or) c_le)) (wn (wbr R (co (co S P c_or) Q c_or) c_le))) $;

--| A Hilbert lattice, whose height is at least 4, has a chain of 4 successively covering atom joins. (Contributed by NM, 3-May-2012.)
theorem athgt {s1 r q p: setvar} (A2: class) (C: class s1 r q p) (c_or: class q p) (K: class):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wcel K chlt) (wrex p (wrex q (wa (wbr (cv p) (co (cv p) (cv q) c_or) C) (wrex r (wa (wbr (co (cv p) (cv q) c_or) (co (co (cv p) (cv q) c_or) (cv r) c_or) C) (wrex s1 (wbr (co (co (cv p) (cv q) c_or) (cv r) c_or) (co (co (co (cv p) (cv q) c_or) (cv r) c_or) (cv s1) c_or) C) A2)) A2)) A2) A2) $;

--| There exists a 3-dimensional (height-4) element i.e. a volume. (Contributed by NM, 25-Jul-2012.)
theorem _3dim0 {s1 r q p: setvar} (A2: class) (c_or: class q p) (K: class) (c_le: class s1 r q p):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wcel K chlt) (wrex p (wrex q (wrex r (wrex s1 (w3a (wne (cv p) (cv q)) (wn (wbr (cv r) (co (cv p) (cv q) c_or) c_le)) (wn (wbr (cv s1) (co (co (cv p) (cv q) c_or) (cv r) c_or) c_le))) A2) A2) A2) A2) $;

--| Lemma for ~ 3dim1 . (Contributed by NM, 25-Jul-2012.)
theorem _3dimlem1 (A2 P Q R S T c_or K c_le: class):

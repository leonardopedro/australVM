  $ wi (wa ph (wceq (cv x3) (cv z))) (wceq A2 B2) $ >
  $ wi ph (wceq (cmpo x3 y1 A2 C E) (cmpo z y1 B2 D F)) $;

--| Change second bound variable and domains in a maps-to function. Deduction form. (Contributed by GG, 14-Aug-2025.)
theorem cbvmpo2davw2 {x3 y1 z: setvar} (ph: wff) (A2: class x3 y1) (B2: class x3 z) (C: class x3 y1) (D: class x3 z) (E: class x3 y1) (F: class x3 z):
  $ wi (wa ph (wceq (cv y1) (cv z))) (wceq E F) $ >
  $ wi (wa ph (wceq (cv y1) (cv z))) (wceq C D) $ >
  $ wi (wa ph (wceq (cv y1) (cv z))) (wceq A2 B2) $ >
  $ wi ph (wceq (cmpo x3 y1 A2 C E) (cmpo x3 z B2 D F)) $;

--| Change bound variable and domain in an indexed Cartesian product. Deduction form. (Contributed by GG, 14-Aug-2025.)
theorem cbvixpdavw2 {x3 y1: setvar} (ph: wff) (A2: class x3) (B2: class y1) (C: class x3) (D: class y1):
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wceq C D) $ >
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wceq A2 B2) $ >
  $ wi ph (wceq (cixp x3 A2 C) (cixp y1 B2 D)) $;

--| Change bound variable and the set of integers in a sum. Deduction form. (Contributed by GG, 14-Aug-2025.)
theorem cbvsumdavw2 {j k: setvar} (ph: wff) (A2 B2: class j k) (C: class j) (D: class k):
  $ wi ph (wceq A2 B2) $ >
  $ wi (wa ph (wceq (cv j) (cv k))) (wceq C D) $ >
  $ wi ph (wceq (csu j A2 C) (csu k B2 D)) $;

--| Change bound variable and the set of integers in a product. Deduction form. (Contributed by GG, 14-Aug-2025.)
theorem cbvproddavw2 {j k: setvar} (ph: wff) (A2: class j) (B2: class k) (C: class j) (D: class k):
  $ wi ph (wceq A2 B2) $ >
  $ wi (wa ph (wceq (cv j) (cv k))) (wceq C D) $ >
  $ wi ph (wceq (cprod j A2 C) (cprod k B2 D)) $;

--| Change bound variable and domain in an integral. Deduction form. (Contributed by GG, 14-Aug-2025.)
theorem cbvitgdavw2 {x3 y1: setvar} (ph: wff) (A2: class x3) (B2: class y1) (C: class x3) (D: class y1):
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wceq C D) $ >
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wceq A2 B2) $ >
  $ wi ph (wceq (citg x3 A2 C) (citg y1 B2 D)) $;

--| Change bound variable and limits in a directed integral. Deduction form. (Contributed by GG, 14-Aug-2025.)
theorem cbvditgdavw2 {x3 y1: setvar} (ph: wff) (A2: class x3) (B2: class y1) (C: class x3) (D: class y1) (E: class x3) (F: class y1):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wceq E F) $ >
  $ wi ph (wceq (cdit x3 A2 C E) (cdit y1 B2 D F)) $;

--| Multiplication maps nonzero complex numbers to nonzero complex numbers. Version of ~ mulnzcnf using maps-to notation, which does not require ~ ax-mulf . (Contributed by GG, 18-Apr-2025.)
theorem mpomulnzcnf {x3 y1: setvar}:
  $ wf (cxp (cdif cc (csn cc0)) (cdif cc (csn cc0))) (cdif cc (csn cc0)) (cmpo x3 y1 (cdif cc (csn cc0)) (cdif cc (csn cc0)) (co (cv x3) (cv y1) cmul)) $;

--| Add two antecedents to a wff. (Contributed by Jeff Hankins, 4-Aug-2009.)
theorem a1i14 (ph ps ch th ta: wff):
  $ wi ps (wi ch ta) $ >
  $ wi ph (wi ps (wi ch (wi th ta))) $;

--| Add two antecedents to a wff. Deduction associated with ~ a1i13 . (Contributed by Jeff Hankins, 5-Aug-2009.)
theorem a1i24 (ph ps ch th ta: wff):
  $ wi ph (wi ch ta) $ >
  $ wi ph (wi ps (wi ch (wi th ta))) $;

--| An exportation inference. (Contributed by Jeff Hankins, 7-Jul-2009.)
theorem exp5d (ph ps ch th ta et: wff):
  $ wi (wa (wa ph ps) ch) (wi (wa th ta) et) $ >
  $ wi ph (wi ps (wi ch (wi th (wi ta et)))) $;

--| An exportation inference. (Contributed by Jeff Hankins, 7-Jul-2009.)
theorem exp5g (ph ps ch th ta et: wff):
  $ wi (wa ph ps) (wi (wa (wa ch th) ta) et) $ >
  $ wi ph (wi ps (wi ch (wi th (wi ta et)))) $;

--| An exportation inference. (Contributed by Jeff Hankins, 7-Jul-2009.)
theorem exp5k (ph ps ch th ta et: wff):
  $ wi ph (wi (wa (wa ps (wa ch th)) ta) et) $ >
  $ wi ph (wi ps (wi ch (wi th (wi ta et)))) $;

--| An exportation inference. (Contributed by Jeff Hankins, 7-Jul-2009.)
theorem exp56 (ph ps ch th ta et: wff):
  $ wi (wa (wa (wa ph ps) ch) (wa th ta)) et $ >
  $ wi ph (wi ps (wi ch (wi th (wi ta et)))) $;

--| An exportation inference. (Contributed by Jeff Hankins, 7-Jul-2009.)
theorem exp58 (ph ps ch th ta et: wff):
  $ wi (wa (wa ph ps) (wa (wa ch th) ta)) et $ >
  $ wi ph (wi ps (wi ch (wi th (wi ta et)))) $;

--| An exportation inference. (Contributed by Jeff Hankins, 7-Jul-2009.)
theorem exp510 (ph ps ch th ta et: wff):
  $ wi (wa ph (wa (wa (wa ps ch) th) ta)) et $ >
  $ wi ph (wi ps (wi ch (wi th (wi ta et)))) $;

--| An exportation inference. (Contributed by Jeff Hankins, 7-Jul-2009.)
theorem exp511 (ph ps ch th ta et: wff):
  $ wi (wa ph (wa (wa ps (wa ch th)) ta)) et $ >
  $ wi ph (wi ps (wi ch (wi th (wi ta et)))) $;

--| An exportation inference. (Contributed by Jeff Hankins, 7-Jul-2009.)
theorem exp512 (ph ps ch th ta et: wff):
  $ wi (wa ph (wa (wa ps ch) (wa th ta))) et $ >
  $ wi ph (wi ps (wi ch (wi th (wi ta et)))) $;

--| Commutation in consequent. Swap 1st and 2nd. (Contributed by Jeff Hankins, 17-Nov-2009.)
theorem _3com12d (ph ps ch th: wff):
  $ wi ph (w3a ps ch th) $ >
  $ wi ph (w3a ch ps th) $;

--| A triple importation inference. (Contributed by Jeff Hankins, 8-Jul-2009.)
theorem imp5p (ph ps ch th ta et: wff):
  $ wi ph (wi ps (wi ch (wi th (wi ta et)))) $ >
  $ wi ph (wi ps (wi (w3a ch th ta) et)) $;

--| A triple importation inference. (Contributed by Jeff Hankins, 8-Jul-2009.)
theorem imp5q (ph ps ch th ta et: wff):
  $ wi ph (wi ps (wi ch (wi th (wi ta et)))) $ >
  $ wi (wa ph ps) (wi (w3a ch th ta) et) $;

--| Transitivity of implicit substitution. (Contributed by Jeff Hankins, 13-Sep-2009.) (Proof shortened by Mario Carneiro, 11-Dec-2016.)
theorem subtr {x3: setvar} (A2 B2 C D X Y Z: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 Y $ >
  $ wnfc x3 Z $ >
  $ wi (wceq (cv x3) A2) (wceq X Y) $ >
  $ wi (wceq (cv x3) B2) (wceq X Z) $ >
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wi (wceq A2 B2) (wceq Y Z)) $;

--| Transitivity of implicit substitution into a wff. (Contributed by Jeff Hankins, 19-Sep-2009.) (Proof shortened by Mario Carneiro, 11-Dec-2016.)
theorem subtr2 {x3: setvar} (ph ps ch: wff x3) (A2 B2 C D: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnf x3 ps $ >
  $ wnf x3 ch $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv x3) B2) (wb ph ch) $ >
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wi (wceq A2 B2) (wb ps ch)) $;

--| A relation intersected with its converse is an equivalence relation if the relation is transitive. (Contributed by Jeff Hankins, 6-Oct-2009.) (Revised by Mario Carneiro, 12-Aug-2015.)
theorem trer {a b c: setvar} (c_le: class):
  $ wi (wal a (wal b (wal c (wi (wa (wbr (cv a) (cv b) c_le) (wbr (cv b) (cv c) c_le)) (wbr (cv a) (cv c) c_le))))) (wer (cdm (cin c_le (ccnv c_le))) (cin c_le (ccnv c_le))) $;

--| An equivalent membership condition for closed intervals. (Contributed by Jeff Hankins, 14-Jul-2009.)
theorem elicc3 (A2 B2 C: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wb (wcel C (co A2 B2 cicc)) (w3a (wcel C cxr) (wbr A2 B2 cle) (w3o (wceq C A2) (wa (wbr A2 C clt) (wbr C B2 clt)) (wceq C B2)))) $;

--| A useful lemma about finite sets. If a property holds for a finite set, it holds for a minimal set. (Contributed by Jeff Hankins, 4-Dec-2009.)
theorem finminlem {x3 y1: setvar} (ph: wff x3) (ps: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wrex x3 ph cfn) (wex x3 (wa ph (wal y1 (wi (wa (wss (cv y1) (cv x3)) ps) (wceq (cv x3) (cv y1)))))) $;

--| Any number greater than an infimum is greater than some element of the set. (Contributed by Jeff Hankins, 29-Sep-2013.) (Revised by AV, 10-Oct-2021.)
theorem gtinf {x3 y1 z: setvar} (A2: class x3 y1) (S: class):
  $ wi (wa (w3a (wss S cr) (wne S c0) (wrex x3 (wral y1 (wbr (cv x3) (cv y1) cle) S) cr)) (wa (wcel A2 cr) (wbr (cinf S cr clt) A2 clt))) (wrex z (wbr (cv z) A2 clt) S) $;

--| A set is open in the standard topology of the reals precisely when every point can be enclosed in an open ball. (Contributed by Jeff Hankins, 23-Sep-2013.) (Proof shortened by Mario Carneiro, 30-Jan-2014.)
theorem opnrebl {x3 y1: setvar} (A2: class):
  $ wb (wcel A2 (cfv (crn cioo) ctg)) (wa (wss A2 cr) (wral x3 (wrex y1 (wss (co (co (cv x3) (cv y1) cmin) (co (cv x3) (cv y1) caddc) cioo) A2) crp) A2)) $;

--| A set is open in the standard topology of the reals precisely when every point can be enclosed in an arbitrarily small ball. (Contributed by Jeff Hankins, 22-Sep-2013.) (Proof shortened by Mario Carneiro, 30-Jan-2014.)
theorem opnrebl2 {x3 y1 z: setvar} (A2: class):
  $ wb (wcel A2 (cfv (crn cioo) ctg)) (wa (wss A2 cr) (wral x3 (wral y1 (wrex z (wa (wbr (cv z) (cv y1) cle) (wss (co (co (cv x3) (cv z) cmin) (co (cv x3) (cv z) caddc) cioo) A2)) crp) crp) A2)) $;

--| Lemma for ~ nn0prpw . Use strong induction to show that every positive integer has unique prime power divisors. (Contributed by Jeff Hankins, 28-Sep-2013.)
theorem nn0prpwlem {k n p: setvar} (A2: class):
  $ wi (wcel A2 cn) (wral k (wi (wbr (cv k) A2 clt) (wrex p (wrex n (wn (wb (wbr (co (cv p) (cv n) cexp) (cv k) cdvds) (wbr (co (cv p) (cv n) cexp) A2 cdvds))) cn) cprime)) cn) $;

--| Two nonnegative integers are the same if and only if they are divisible by the same prime powers. (Contributed by Jeff Hankins, 29-Sep-2013.)
theorem nn0prpw {n p: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cn0) (wcel B2 cn0)) (wb (wceq A2 B2) (wral p (wral n (wb (wbr (co (cv p) (cv n) cexp) A2 cdvds) (wbr (co (cv p) (cv n) cexp) B2 cdvds)) cn) cprime)) $;

--| Two equivalent expressions for the boundary of a topology. (Contributed by Jeff Hankins, 23-Sep-2009.)
theorem topbnd (A2 J X: class):
  $ wceq X (cuni J) $ >
  $ wi (wa (wcel J ctop) (wss A2 X)) (wceq (cin (cfv A2 (cfv J ccl)) (cfv (cdif X A2) (cfv J ccl))) (cdif (cfv A2 (cfv J ccl)) (cfv A2 (cfv J cnt)))) $;

--| A set is open iff it is disjoint from its boundary. (Contributed by Jeff Hankins, 23-Sep-2009.)
theorem opnbnd (A2 J X: class):
  $ wceq X (cuni J) $ >
  $ wi (wa (wcel J ctop) (wss A2 X)) (wb (wcel A2 J) (wceq (cin A2 (cin (cfv A2 (cfv J ccl)) (cfv (cdif X A2) (cfv J ccl)))) c0)) $;

--| A set is closed iff it contains its boundary. (Contributed by Jeff Hankins, 1-Oct-2009.)
theorem cldbnd (A2 J X: class):
  $ wceq X (cuni J) $ >
  $ wi (wa (wcel J ctop) (wss A2 X)) (wb (wcel A2 (cfv J ccld)) (wss (cin (cfv A2 (cfv J ccl)) (cfv (cdif X A2) (cfv J ccl))) A2)) $;

--| A union of interiors is a subset of the interior of the union. The reverse inclusion may not hold. (Contributed by Jeff Hankins, 31-Aug-2009.)
theorem ntruni {o: setvar} (J O X: class):
  $ wceq X (cuni J) $ >
  $ wi (wa (wcel J ctop) (wss O (cpw X))) (wss (ciun o O (cfv (cv o) (cfv J cnt))) (cfv (cuni O) (cfv J cnt))) $;

--| A pairwise union of closures is the closure of the union. (Contributed by Jeff Hankins, 31-Aug-2009.)
theorem clsun (A2 B2 J X: class):
  $ wceq X (cuni J) $ >
  $ wi (w3a (wcel J ctop) (wss A2 X) (wss B2 X)) (wceq (cfv (cun A2 B2) (cfv J ccl)) (cun (cfv A2 (cfv J ccl)) (cfv B2 (cfv J ccl)))) $;

--| The closure of an intersection is a subset of the intersection of the closures. (Contributed by Jeff Hankins, 31-Aug-2009.)
theorem clsint2 {c: setvar} (C J X: class):
  $ wceq X (cuni J) $ >
  $ wi (wa (wcel J ctop) (wss C (cpw X))) (wss (cfv (cint C) (cfv J ccl)) (ciin c C (cfv (cv c) (cfv J ccl)))) $;

--| A set is regularly closed iff it is the closure of some open set. (Contributed by Jeff Hankins, 27-Sep-2009.)
theorem opnregcld {o: setvar} (A2 J X: class):
  $ wceq X (cuni J) $ >
  $ wi (wa (wcel J ctop) (wss A2 X)) (wb (wceq (cfv (cfv A2 (cfv J cnt)) (cfv J ccl)) A2) (wrex o (wceq A2 (cfv (cv o) (cfv J ccl))) J)) $;

--| A set if regularly open iff it is the interior of some closed set. (Contributed by Jeff Hankins, 27-Sep-2009.)
theorem cldregopn {c: setvar} (A2 J X: class):
  $ wceq X (cuni J) $ >
  $ wi (wa (wcel J ctop) (wss A2 X)) (wb (wceq (cfv (cfv A2 (cfv J ccl)) (cfv J cnt)) A2) (wrex c (wceq A2 (cfv (cv c) (cfv J cnt))) (cfv J ccld))) $;

--| Two neighborhoods intersect to form a neighborhood of the intersection. (Contributed by Jeff Hankins, 31-Aug-2009.)
theorem neiin (A2 B2 J M N: class):
  $ wi (w3a (wcel J ctop) (wcel M (cfv A2 (cfv J cnei))) (wcel N (cfv B2 (cfv J cnei)))) (wcel (cin M N) (cfv (cin A2 B2) (cfv J cnei))) $;

--| Homeomorphisms preserve closedness. (Contributed by Jeff Hankins, 3-Jul-2009.) (Revised by Mario Carneiro, 3-Jun-2014.)
theorem hmeoclda (S F J K: class):
  $ wi (wa (w3a (wcel J ctop) (wcel K ctop) (wcel F (co J K chmeo))) (wcel S (cfv J ccld))) (wcel (cima F S) (cfv K ccld)) $;

--| Homeomorphisms preserve closedness. (Contributed by Jeff Hankins, 3-Jul-2009.)
theorem hmeocldb (S F J K: class):
  $ wi (wa (w3a (wcel J ctop) (wcel K ctop) (wcel F (co J K chmeo))) (wcel S (cfv K ccld))) (wcel (cima (ccnv F) S) (cfv J ccld)) $;

--| An alternate proof of the Intermediate Value Theorem ~ ivth using topology. (Contributed by Jeff Hankins, 17-Aug-2009.) (Revised by Mario Carneiro, 15-Dec-2013.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem ivthALT {x3: setvar} (A2 B2 D U F: class):
  $ wi (w3a (w3a (wcel A2 cr) (wcel B2 cr) (wcel U cr)) (wbr A2 B2 clt) (w3a (wss (co A2 B2 cicc) D) (wss D cc) (w3a (wcel F (co D cc ccncf)) (wss (cima F (co A2 B2 cicc)) cr) (wcel U (co (cfv A2 F) (cfv B2 F) cioo))))) (wrex x3 (wceq (cfv (cv x3) F) U) (co A2 B2 cioo)) $;

--| Extend class definition to include the "finer than" relation.
term cfne: class;

--| Define the fineness relation for covers. (Contributed by Jeff Hankins, 28-Sep-2009.)
axiom df_fne {x3 y1 z: setvar}:
  $ wceq cfne (copab x3 y1 (wa (wceq (cuni (cv x3)) (cuni (cv y1))) (wral z (wss (cv z) (cuni (cin (cv y1) (cpw (cv z))))) (cv x3)))) $;

--| Fineness is a relation. (Contributed by Jeff Hankins, 28-Sep-2009.)
theorem fnerel:
  $ wrel cfne $;

--| The predicate " ` B ` is finer than ` A ` ". This property is, in a sense, the opposite of refinement, as refinement requires every element to be a subset of an element of the original and fineness requires that every element of the original have a subset in the finer cover containing every point. I do not know of a literature reference for this. (Contributed by Jeff Hankins, 28-Sep-2009.)
theorem isfne {x3: setvar} (A2 B2 C: class) (X Y: class x3):
  $ wceq X (cuni A2) $ >
  $ wceq Y (cuni B2) $ >
  $ wi (wcel B2 C) (wb (wbr A2 B2 cfne) (wa (wceq X Y) (wral x3 (wss (cv x3) (cuni (cin B2 (cpw (cv x3))))) A2))) $;

--| The predicate " ` B ` is finer than ` A ` " in terms of the topology generation function. (Contributed by Mario Carneiro, 11-Sep-2015.)
theorem isfne4 (A2 B2 X Y: class):
  $ wceq X (cuni A2) $ >
  $ wceq Y (cuni B2) $ >
  $ wb (wbr A2 B2 cfne) (wa (wceq X Y) (wss A2 (cfv B2 ctg))) $;

--| A condition for a topology to be finer than another. (Contributed by Jeff Hankins, 28-Sep-2009.) (Revised by Mario Carneiro, 11-Sep-2015.)
theorem isfne4b (A2 B2 V X Y: class):
  $ wceq X (cuni A2) $ >
  $ wceq Y (cuni B2) $ >
  $ wi (wcel B2 V) (wb (wbr A2 B2 cfne) (wa (wceq X Y) (wss (cfv A2 ctg) (cfv B2 ctg)))) $;

--| The predicate " ` B ` is finer than ` A ` ". (Contributed by Jeff Hankins, 28-Sep-2009.) (Proof shortened by Mario Carneiro, 11-Sep-2015.)
theorem isfne2 {x3 y1 z: setvar} (A2 B2 C: class) (X Y: class x3 y1 z):
  $ wceq X (cuni A2) $ >
  $ wceq Y (cuni B2) $ >
  $ wi (wcel B2 C) (wb (wbr A2 B2 cfne) (wa (wceq X Y) (wral x3 (wral y1 (wrex z (wa (wcel (cv y1) (cv z)) (wss (cv z) (cv x3))) B2) (cv x3)) A2))) $;

--| The predicate " ` B ` is finer than ` A ` ". (Contributed by Jeff Hankins, 11-Oct-2009.) (Proof shortened by Mario Carneiro, 11-Sep-2015.)
theorem isfne3 {x3 y1: setvar} (A2 B2 C: class) (X Y: class x3 y1):
  $ wceq X (cuni A2) $ >
  $ wceq Y (cuni B2) $ >
  $ wi (wcel B2 C) (wb (wbr A2 B2 cfne) (wa (wceq X Y) (wral x3 (wex y1 (wa (wss (cv y1) B2) (wceq (cv x3) (cuni (cv y1))))) A2))) $;

--| A finer cover covers the same set as the original. (Contributed by Jeff Hankins, 28-Sep-2009.)
theorem fnebas (A2 B2 X Y: class):
  $ wceq X (cuni A2) $ >
  $ wceq Y (cuni B2) $ >
  $ wi (wbr A2 B2 cfne) (wceq X Y) $;

--| A finer cover generates a topology finer than the original set. (Contributed by Mario Carneiro, 11-Sep-2015.)
theorem fnetg (A2 B2: class):
  $ wi (wbr A2 B2 cfne) (wss A2 (cfv B2 ctg)) $;

--| If ` B ` is finer than ` A ` and ` S ` is an element of ` A ` , every point in ` S ` is an element of a subset of ` S ` which is in ` B ` . (Contributed by Jeff Hankins, 28-Sep-2009.)
theorem fnessex {x3: setvar} (A2 B2 P S: class):
  $ wi (w3a (wbr A2 B2 cfne) (wcel S A2) (wcel P S)) (wrex x3 (wa (wcel P (cv x3)) (wss (cv x3) S)) B2) $;

--| If ` B ` is finer than ` A ` , every element of ` A ` is a union of elements of ` B ` . (Contributed by Jeff Hankins, 11-Oct-2009.)
theorem fneuni {x3: setvar} (A2 B2 S: class):
  $ wi (wa (wbr A2 B2 cfne) (wcel S A2)) (wex x3 (wa (wss (cv x3) B2) (wceq S (cuni (cv x3))))) $;

--| If a cover is finer than another, every point can be approached more closely by intersections. (Contributed by Jeff Hankins, 11-Oct-2009.)
theorem fneint {x3: setvar} (A2 B2 P: class):
  $ wi (wbr A2 B2 cfne) (wss (cint (crab x3 (wcel P (cv x3)) B2)) (cint (crab x3 (wcel P (cv x3)) A2))) $;

--| A cover is finer than its subcovers. (Contributed by Jeff Hankins, 11-Oct-2009.)
theorem fness (A2 B2 C X Y: class):
  $ wceq X (cuni A2) $ >
  $ wceq Y (cuni B2) $ >
  $ wi (w3a (wcel B2 C) (wss A2 B2) (wceq X Y)) (wbr A2 B2 cfne) $;

--| Reflexivity of the fineness relation. (Contributed by Jeff Hankins, 12-Oct-2009.)
theorem fneref (A2 V: class):
  $ wi (wcel A2 V) (wbr A2 A2 cfne) $;

--| Transitivity of the fineness relation. (Contributed by Jeff Hankins, 5-Oct-2009.) (Proof shortened by Mario Carneiro, 11-Sep-2015.)
theorem fnetr (A2 B2 C: class):
  $ wi (wa (wbr A2 B2 cfne) (wbr B2 C cfne)) (wbr A2 C cfne) $;

--| Two covers are finer than each other iff they are both bases for the same topology. (Contributed by Mario Carneiro, 11-Sep-2015.)
theorem fneval (A2 B2 c_sm V W: class):
  $ wceq c_sm (cin cfne (ccnv cfne)) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wbr A2 B2 c_sm) (wceq (cfv A2 ctg) (cfv B2 ctg))) $;

--| Fineness intersected with its converse is an equivalence relation. (Contributed by Jeff Hankins, 6-Oct-2009.) (Revised by Mario Carneiro, 11-Sep-2015.)
theorem fneer (c_sm: class):
  $ wceq c_sm (cin cfne (ccnv cfne)) $ >
  $ wer cvv c_sm $;

--| Fineness for covers corresponds precisely with fineness for topologies. (Contributed by Jeff Hankins, 29-Sep-2009.)
theorem topfne (J K X Y: class):
  $ wceq X (cuni J) $ >
  $ wceq Y (cuni K) $ >
  $ wi (wa (wcel K ctop) (wceq X Y)) (wb (wss J K) (wbr J K cfne)) $;

--| A cover is equivalent to a topology iff it is a base for that topology. (Contributed by Jeff Hankins, 8-Oct-2009.) (Proof shortened by Mario Carneiro, 11-Sep-2015.)
theorem topfneec (A2 c_sm J: class):
  $ wceq c_sm (cin cfne (ccnv cfne)) $ >
  $ wi (wcel J ctop) (wb (wcel A2 (cec J c_sm)) (wceq (cfv A2 ctg) J)) $;

--| A topology is precisely identified with its equivalence class. (Contributed by Jeff Hankins, 12-Oct-2009.)
theorem topfneec2 (c_sm J K: class):
  $ wceq c_sm (cin cfne (ccnv cfne)) $ >
  $ wi (wa (wcel J ctop) (wcel K ctop)) (wb (wceq (cec J c_sm) (cec K c_sm)) (wceq J K)) $;

--| A cover is finer iff it has a subcover which is both finer and a refinement. (Contributed by Jeff Hankins, 18-Jan-2010.) (Revised by Thierry Arnoux, 3-Feb-2020.)
theorem fnessref {c: setvar} (A2 B2 X Y: class):
  $ wceq X (cuni A2) $ >
  $ wceq Y (cuni B2) $ >
  $ wi (wceq X Y) (wb (wbr A2 B2 cfne) (wex c (wa (wss (cv c) B2) (wa (wbr A2 (cv c) cfne) (wbr (cv c) A2 cref))))) $;

--| A cover is a refinement iff it is a subcover of something which is both finer and a refinement. (Contributed by Jeff Hankins, 18-Jan-2010.) (Revised by Thierry Arnoux, 3-Feb-2020.)
theorem refssfne {c: setvar} (A2 B2 X Y: class):
  $ wceq X (cuni A2) $ >
  $ wceq Y (cuni B2) $ >
  $ wi (wceq X Y) (wb (wbr B2 A2 cref) (wex c (wa (wss B2 (cv c)) (wa (wbr A2 (cv c) cfne) (wbr (cv c) A2 cref))))) $;

--| A collection of neighborhood bases determines a topology. Part of Theorem 4.5 of Stephen Willard's _General Topology_. (Contributed by Jeff Hankins, 8-Sep-2009.) (Proof shortened by Mario Carneiro, 11-Sep-2015.)
theorem neibastop1 {x3 w v o: setvar} (ph: wff) (F: class) (J: class w o) (V: class x3 w v o) (X: class):
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X (cdif (cpw (cpw X)) (csn c0)) F) $ >
  $ wi (wa ph (w3a (wcel (cv x3) X) (wcel (cv v) (cfv (cv x3) F)) (wcel (cv w) (cfv (cv x3) F)))) (wne (cin (cfv (cv x3) F) (cpw (cin (cv v) (cv w)))) c0) $ >
  $ wceq J (crab o (wral x3 (wne (cin (cfv (cv x3) F) (cpw (cv o))) c0) (cv o)) (cpw X)) $ >
  $ wi ph (wcel J (cfv X ctopon)) $;

--| Lemma for ~ neibastop2 . (Contributed by Jeff Hankins, 12-Sep-2009.)
theorem neibastop2lem {x3 y1 z w v u t f2 o a: setvar} (ph: wff u a) (P: class a) (S: class z w a) (U: class w v u t o a) (F: class) (G: class x3 w u o a) (J: class w t f2 o a) (N: class a) (V: class x3 y1 z w v u t f2 o a) (X: class):
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X (cdif (cpw (cpw X)) (csn c0)) F) $ >
  $ wi (wa ph (w3a (wcel (cv x3) X) (wcel (cv v) (cfv (cv x3) F)) (wcel (cv w) (cfv (cv x3) F)))) (wne (cin (cfv (cv x3) F) (cpw (cin (cv v) (cv w)))) c0) $ >
  $ wceq J (crab o (wral x3 (wne (cin (cfv (cv x3) F) (cpw (cv o))) c0) (cv o)) (cpw X)) $ >
  $ wi (wa ph (wa (wcel (cv x3) X) (wcel (cv v) (cfv (cv x3) F)))) (wcel (cv x3) (cv v)) $ >
  $ wi (wa ph (wa (wcel (cv x3) X) (wcel (cv v) (cfv (cv x3) F)))) (wrex t (wral y1 (wne (cin (cfv (cv y1) F) (cpw (cv v))) c0) (cv t)) (cfv (cv x3) F)) $ >
  $ wi ph (wcel P X) $ >
  $ wi ph (wss N X) $ >
  $ wi ph (wcel U (cfv P F)) $ >
  $ wi ph (wss U N) $ >
  $ wceq G (cres (crdg (cmpt a cvv (ciun z (cv a) (ciun x3 X (cin (cfv (cv x3) F) (cpw (cv z)))))) (csn U)) com) $ >
  $ wceq S (crab y1 (wrex f2 (wne (cin (cfv (cv y1) F) (cpw (cv f2))) c0) (cuni (crn G))) X) $ >
  $ wi ph (wrex u (wa (wcel P (cv u)) (wss (cv u) N)) J) $;

--| In the topology generated by a neighborhood base, a set is a neighborhood of a point iff it contains a subset in the base. (Contributed by Jeff Hankins, 9-Sep-2009.) (Proof shortened by Mario Carneiro, 11-Sep-2015.)
theorem neibastop2 {x3 y1 w v t o: setvar} (ph: wff) (P F: class) (J: class w t o) (N: class) (V: class x3 y1 w v t o) (X: class):
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X (cdif (cpw (cpw X)) (csn c0)) F) $ >
  $ wi (wa ph (w3a (wcel (cv x3) X) (wcel (cv v) (cfv (cv x3) F)) (wcel (cv w) (cfv (cv x3) F)))) (wne (cin (cfv (cv x3) F) (cpw (cin (cv v) (cv w)))) c0) $ >
  $ wceq J (crab o (wral x3 (wne (cin (cfv (cv x3) F) (cpw (cv o))) c0) (cv o)) (cpw X)) $ >
  $ wi (wa ph (wa (wcel (cv x3) X) (wcel (cv v) (cfv (cv x3) F)))) (wcel (cv x3) (cv v)) $ >
  $ wi (wa ph (wa (wcel (cv x3) X) (wcel (cv v) (cfv (cv x3) F)))) (wrex t (wral y1 (wne (cin (cfv (cv y1) F) (cpw (cv v))) c0) (cv t)) (cfv (cv x3) F)) $ >
  $ wi (wa ph (wcel P X)) (wb (wcel N (cfv (csn P) (cfv J cnei))) (wa (wss N X) (wne (cin (cfv P F) (cpw N)) c0))) $;

--| The topology generated by a neighborhood base is unique. (Contributed by Jeff Hankins, 16-Sep-2009.) (Proof shortened by Mario Carneiro, 11-Sep-2015.)
theorem neibastop3 {x3 y1 w v t j n o: setvar} (ph: wff) (F: class) (J: class w t o) (V: class x3 y1 w v t j n o) (X: class):
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X (cdif (cpw (cpw X)) (csn c0)) F) $ >
  $ wi (wa ph (w3a (wcel (cv x3) X) (wcel (cv v) (cfv (cv x3) F)) (wcel (cv w) (cfv (cv x3) F)))) (wne (cin (cfv (cv x3) F) (cpw (cin (cv v) (cv w)))) c0) $ >
  $ wceq J (crab o (wral x3 (wne (cin (cfv (cv x3) F) (cpw (cv o))) c0) (cv o)) (cpw X)) $ >
  $ wi (wa ph (wa (wcel (cv x3) X) (wcel (cv v) (cfv (cv x3) F)))) (wcel (cv x3) (cv v)) $ >
  $ wi (wa ph (wa (wcel (cv x3) X) (wcel (cv v) (cfv (cv x3) F)))) (wrex t (wral y1 (wne (cin (cfv (cv y1) F) (cpw (cv v))) c0) (cv t)) (cfv (cv x3) F)) $ >
  $ wi ph (wreu j (wral x3 (wceq (cfv (csn (cv x3)) (cfv (cv j) cnei)) (crab n (wne (cin (cfv (cv x3) F) (cpw (cv n))) c0) (cpw X))) X) (cfv X ctopon)) $;

--| The meet of a collection of topologies on ` X ` is again a topology on ` X ` . (Contributed by Jeff Hankins, 5-Oct-2009.) (Proof shortened by Mario Carneiro, 12-Sep-2015.)
theorem topmtcl (S V X: class):
  $ wi (wa (wcel X V) (wss S (cfv X ctopon))) (wcel (cin (cpw X) (cint S)) (cfv X ctopon)) $;

--| Two equivalent formulations of the meet of a collection of topologies. (Contributed by Jeff Hankins, 4-Oct-2009.) (Proof shortened by Mario Carneiro, 12-Sep-2015.)
theorem topmeet {j k: setvar} (S V X: class):
  $ wi (wa (wcel X V) (wss S (cfv X ctopon))) (wceq (cin (cpw X) (cint S)) (cuni (crab k (wral j (wss (cv k) (cv j)) S) (cfv X ctopon)))) $;

--| Two equivalent formulations of the join of a collection of topologies. (Contributed by Jeff Hankins, 6-Oct-2009.) (Proof shortened by Mario Carneiro, 12-Sep-2015.)
theorem topjoin {j k: setvar} (S V X: class):
  $ wi (wa (wcel X V) (wss S (cfv X ctopon))) (wceq (cfv (cfv (cun (csn X) (cuni S)) cfi) ctg) (cint (crab k (wral j (wss (cv j) (cv k)) S) (cfv X ctopon)))) $;

--| The meet of a collection of equivalence classes of covers with respect to fineness. (Contributed by Jeff Hankins, 5-Oct-2009.) (Proof shortened by Mario Carneiro, 12-Sep-2015.)
theorem fnemeet1 {y1 t: setvar} (A2 S: class) (V: class y1) (X: class):
  $ wi (w3a (wcel X V) (wral y1 (wceq X (cuni (cv y1))) S) (wcel A2 S)) (wbr (cin (cpw X) (ciin t S (cfv (cv t) ctg))) A2 cfne) $;

--| The meet of equivalence classes under the fineness relation-part two. (Contributed by Jeff Hankins, 6-Oct-2009.) (Proof shortened by Mario Carneiro, 12-Sep-2015.)
theorem fnemeet2 {x3 y1 t: setvar} (S: class) (T V: class y1) (X: class):
  $ wi (wa (wcel X V) (wral y1 (wceq X (cuni (cv y1))) S)) (wb (wbr T (cin (cpw X) (ciin t S (cfv (cv t) ctg))) cfne) (wa (wceq X (cuni T)) (wral x3 (wbr T (cv x3) cfne) S))) $;

--| Join of equivalence classes under the fineness relation-part one. (Contributed by Jeff Hankins, 8-Oct-2009.) (Proof shortened by Mario Carneiro, 12-Sep-2015.)
theorem fnejoin1 {y1: setvar} (A2 S: class) (V: class y1) (X: class):
  $ wi (w3a (wcel X V) (wral y1 (wceq X (cuni (cv y1))) S) (wcel A2 S)) (wbr A2 (cif (wceq S c0) (csn X) (cuni S)) cfne) $;

--| Join of equivalence classes under the fineness relation-part two. (Contributed by Jeff Hankins, 8-Oct-2009.) (Proof shortened by Mario Carneiro, 12-Sep-2015.)
theorem fnejoin2 {x3 y1: setvar} (S: class) (T V: class y1) (X: class):
  $ wi (wa (wcel X V) (wral y1 (wceq X (cuni (cv y1))) S)) (wb (wbr (cif (wceq S c0) (csn X) (cuni S)) T cfne) (wa (wceq X (cuni T)) (wral x3 (wbr (cv x3) T cfne) S))) $;

--| Minimality property of a generated filter: every filter that contains ` B ` contains its generated filter. (Contributed by Jeff Hankins, 5-Sep-2009.) (Revised by Mario Carneiro, 7-Aug-2015.)
theorem fgmin (B2 F X: class):
  $ wi (wa (wcel B2 (cfv X cfbas)) (wcel F (cfv X cfil))) (wb (wss B2 F) (wss (co X B2 cfg) F)) $;

--| The neighborhood filter of a nonempty set is generated by its open supersets. See comments for ~ opnfbas . (Contributed by Jeff Hankins, 3-Sep-2009.)
theorem neifg {x3: setvar} (S J X: class):
  $ wceq X (cuni J) $ >
  $ wi (w3a (wcel J ctop) (wss S X) (wne S c0)) (wceq (co X (crab x3 (wss S (cv x3)) J) cfg) (cfv S (cfv J cnei))) $;

--| The tail function for a directed set. (Contributed by Jeff Hankins, 25-Nov-2009.) (Revised by Mario Carneiro, 24-Nov-2013.)
theorem tailfval {x3: setvar} (D X: class):
  $ wceq X (cdm D) $ >
  $ wi (wcel D cdir) (wceq (cfv D ctail) (cmpt x3 X (cima D (csn (cv x3))))) $;

--| The tail of an element in a directed set. (Contributed by Jeff Hankins, 25-Nov-2009.) (Revised by Mario Carneiro, 24-Nov-2013.)
theorem tailval (A2 D X: class):
  $ wceq X (cdm D) $ >
  $ wi (wa (wcel D cdir) (wcel A2 X)) (wceq (cfv A2 (cfv D ctail)) (cima D (csn A2))) $;

--| An element of a tail. (Contributed by Jeff Hankins, 25-Nov-2009.) (Revised by Mario Carneiro, 24-Nov-2013.)
theorem eltail (A2 B2 C D X: class):
  $ wceq X (cdm D) $ >
  $ wi (w3a (wcel D cdir) (wcel A2 X) (wcel B2 C)) (wb (wcel B2 (cfv A2 (cfv D ctail))) (wbr A2 B2 D)) $;

--| The tail function of a directed set sends its elements to its subsets. (Contributed by Jeff Hankins, 25-Nov-2009.) (Revised by Mario Carneiro, 24-Nov-2013.)
theorem tailf (D X: class):
  $ wceq X (cdm D) $ >
  $ wi (wcel D cdir) (wf X (cpw X) (cfv D ctail)) $;

--| A tail contains its initial element. (Contributed by Jeff Hankins, 25-Nov-2009.)
theorem tailini (A2 D X: class):
  $ wceq X (cdm D) $ >
  $ wi (wa (wcel D cdir) (wcel A2 X)) (wcel A2 (cfv A2 (cfv D ctail))) $;

--| The collection of tails of a directed set is a filter base. (Contributed by Jeff Hankins, 25-Nov-2009.) (Revised by Mario Carneiro, 8-Aug-2015.)
theorem tailfb (D X: class):
  $ wceq X (cdm D) $ >
  $ wi (wa (wcel D cdir) (wne X c0)) (wcel (crn (cfv D ctail)) (cfv X cfbas)) $;

--| Lemma for ~ filnet . Change variables. (Contributed by Jeff Hankins, 13-Dec-2009.) (Revised by Mario Carneiro, 8-Aug-2015.)
theorem filnetlem1 {x3 y1 n: setvar} (A2 B2: class n) (D: class x3 y1 n) (F: class) (H: class n):
  $ wceq H (ciun n F (cxp (csn (cv n)) (cv n))) $ >
  $ wceq D (copab x3 y1 (wa (wa (wcel (cv x3) H) (wcel (cv y1) H)) (wss (cfv (cv y1) c1st) (cfv (cv x3) c1st)))) $ >
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wb (wbr A2 B2 D) (wa (wa (wcel A2 H) (wcel B2 H)) (wss (cfv B2 c1st) (cfv A2 c1st))) $;

--| Lemma for ~ filnet . The field of the direction. (Contributed by Jeff Hankins, 13-Dec-2009.) (Revised by Mario Carneiro, 8-Aug-2015.)
theorem filnetlem2 {x3 y1 n: setvar} (D: class x3 y1 n) (F: class) (H: class n):
  $ wceq H (ciun n F (cxp (csn (cv n)) (cv n))) $ >
  $ wceq D (copab x3 y1 (wa (wa (wcel (cv x3) H) (wcel (cv y1) H)) (wss (cfv (cv y1) c1st) (cfv (cv x3) c1st)))) $ >
  $ wa (wss (cres cid H) D) (wss D (cxp H H)) $;

--| Lemma for ~ filnet . (Contributed by Jeff Hankins, 13-Dec-2009.) (Revised by Mario Carneiro, 8-Aug-2015.)
theorem filnetlem3 {x3 y1 n: setvar} (D: class x3 y1 n) (F: class) (H: class n) (X: class x3 y1):
  $ wceq H (ciun n F (cxp (csn (cv n)) (cv n))) $ >
  $ wceq D (copab x3 y1 (wa (wa (wcel (cv x3) H) (wcel (cv y1) H)) (wss (cfv (cv y1) c1st) (cfv (cv x3) c1st)))) $ >
  $ wa (wceq H (cuni (cuni D))) (wi (wcel F (cfv X cfil)) (wa (wss H (cxp F X)) (wcel D cdir))) $;

--| Lemma for ~ filnet . (Contributed by Jeff Hankins, 15-Dec-2009.) (Revised by Mario Carneiro, 8-Aug-2015.)
theorem filnetlem4 {x3 y1 f2 n d: setvar} (D: class x3 y1 n) (F: class) (H: class n) (X: class x3 y1):
  $ wceq H (ciun n F (cxp (csn (cv n)) (cv n))) $ >
  $ wceq D (copab x3 y1 (wa (wa (wcel (cv x3) H) (wcel (cv y1) H)) (wss (cfv (cv y1) c1st) (cfv (cv x3) c1st)))) $ >
  $ wi (wcel F (cfv X cfil)) (wrex d (wex f2 (wa (wf (cdm (cv d)) X (cv f2)) (wceq F (cfv (crn (cfv (cv d) ctail)) (co X (cv f2) cfm))))) cdir) $;

--| A filter has the same convergence and clustering properties as some net. (Contributed by Jeff Hankins, 12-Dec-2009.) (Revised by Mario Carneiro, 8-Aug-2015.)
theorem filnet {f2 d: setvar} (F X: class):
  $ wi (wcel F (cfv X cfil)) (wrex d (wex f2 (wa (wf (cdm (cv d)) X (cv f2)) (wceq F (cfv (crn (cfv (cv d) ctail)) (co X (cv f2) cfm))))) cdir) $;

--| The first of three axioms in the Tarski-Bernays axiom system. (Contributed by Anthony Hart, 16-Aug-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem tb_ax1 (ph ps ch: wff):
  $ wi (wi ph ps) (wi (wi ps ch) (wi ph ch)) $;

--| The second of three axioms in the Tarski-Bernays axiom system. (Contributed by Anthony Hart, 16-Aug-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem tb_ax2 (ph ps: wff):
  $ wi ph (wi ps ph) $;

--| The third of three axioms in the Tarski-Bernays axiom system. This axiom, along with ~ ax-mp , ~ tb-ax1 , and ~ tb-ax2 , can be used to derive any theorem or rule that uses only ` -> ` . (Contributed by Anthony Hart, 16-Aug-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem tb_ax3 (ph ps: wff):
  $ wi (wi (wi ph ps) ph) ph $;

--| The weak syllogism from Tarski-Bernays'. (Contributed by Anthony Hart, 16-Aug-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem tbsyl (ph ps ch: wff):
  $ wi ph ps $ >
  $ wi ps ch $ >
  $ wi ph ch $;

--| Lemma for ~ re1ax2 . (Contributed by Anthony Hart, 16-Aug-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem re1ax2lem (ph ps ch: wff):
  $ wi (wi ph (wi ps ch)) (wi ps (wi ph ch)) $;

--| ~ ax-2 rederived from the Tarski-Bernays axiom system. Often ~ tb-ax1 is replaced with this theorem to make a "standard" system. This is because this theorem is easier to work with, despite it being longer. (Contributed by Anthony Hart, 16-Aug-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem re1ax2 (ph ps ch: wff):
  $ wi (wi ph (wi ps ch)) (wi (wi ph ps) (wi ph ch)) $;

--| Constructor theorem for ` -/\ ` . (Contributed by Anthony Hart, 1-Sep-2011.)
theorem naim1 (ph ps ch: wff):
  $ wi (wi ph ps) (wi (wnan ps ch) (wnan ph ch)) $;

--| Constructor theorem for ` -/\ ` . (Contributed by Anthony Hart, 1-Sep-2011.)
theorem naim2 (ph ps ch: wff):
  $ wi (wi ph ps) (wi (wnan ch ps) (wnan ch ph)) $;

--| Constructor rule for ` -/\ ` . (Contributed by Anthony Hart, 2-Sep-2011.)
theorem naim1i (ph ps ch: wff):
  $ wi ph ps $ >
  $ wnan ps ch $ >
  $ wnan ph ch $;

--| Constructor rule for ` -/\ ` . (Contributed by Anthony Hart, 2-Sep-2011.)
theorem naim2i (ph ps ch: wff):
  $ wi ph ps $ >
  $ wnan ch ps $ >
  $ wnan ch ph $;

--| Constructor rule for ` -/\ ` . (Contributed by Anthony Hart, 2-Sep-2011.)
theorem naim12i (ph ps ch th: wff):
  $ wi ph ps $ >
  $ wi ch th $ >
  $ wnan ps th $ >
  $ wnan ph ch $;

--| Constructor rule for ` -/\ ` . (Contributed by Anthony Hart, 2-Sep-2011.)
theorem nabi1i (ph ps ch: wff):
  $ wb ph ps $ >
  $ wnan ps ch $ >
  $ wnan ph ch $;

--| Constructor rule for ` -/\ ` . (Contributed by Anthony Hart, 2-Sep-2011.)
theorem nabi2i (ph ps ch: wff):
  $ wb ph ps $ >
  $ wnan ch ps $ >
  $ wnan ch ph $;

--| Constructor rule for ` -/\ ` . (Contributed by Anthony Hart, 2-Sep-2011.)
theorem nabi12i (ph ps ch th: wff):
  $ wb ph ps $ >
  $ wb ch th $ >
  $ wnan ps th $ >
  $ wnan ph ch $;

--| The double nand.
term w3nand (ph ps ch: wff): wff;

--| The double nand. This definition allows to express the input of three variables only being false if all three are true. (Contributed by Anthony Hart, 2-Sep-2011.)
axiom df_3nand (ph ps ch: wff):
  $ wb (w3nand ph ps ch) (wi ph (wi ps (wn ch))) $;

--| The double nand expressed in terms of pure nand. (Contributed by Anthony Hart, 2-Sep-2011.)
theorem df3nandALT1 (ph ps ch: wff):
  $ wb (w3nand ph ps ch) (wnan ph (wnan (wnan ps ch) (wnan ps ch))) $;

--| The double nand expressed in terms of negation and and not. (Contributed by Anthony Hart, 13-Sep-2011.)
theorem df3nandALT2 (ph ps ch: wff):
  $ wb (w3nand ph ps ch) (wn (w3a ph ps ch)) $;

--| Double and in terms of double nand. (Contributed by Anthony Hart, 2-Sep-2011.)
theorem andnand1 (ph ps ch: wff):
  $ wb (w3a ph ps ch) (wnan (w3nand ph ps ch) (w3nand ph ps ch)) $;

--| An ` -> ` nand relation. (Contributed by Anthony Hart, 2-Sep-2011.)
theorem imnand2 (ph ps: wff):
  $ wb (wi (wn ph) ps) (wnan (wnan ph ph) (wnan ps ps)) $;

--| Not all sets hold ` F. ` as true. (Contributed by Anthony Hart, 13-Sep-2011.)
theorem nalfal {x3: setvar}:
  $ wn (wal x3 wfal) $;

--| There does not exist a set such that ` T. ` is not true. (Contributed by Anthony Hart, 13-Sep-2011.)
theorem nexntru {x3: setvar}:
  $ wn (wex x3 (wn wtru)) $;

--| There does not exist a set such that ` F. ` is true. (Contributed by Anthony Hart, 13-Sep-2011.)
theorem nexfal {x3: setvar}:
  $ wn (wex x3 wfal) $;

--| There does not exist exactly one set such that ` F. ` is true. (Contributed by Anthony Hart, 13-Sep-2011.)
theorem neufal {x3: setvar}:
  $ wn (weu x3 wfal) $;

--| There does not exist exactly one set such that ` T. ` is true. (Contributed by Anthony Hart, 13-Sep-2011.)
theorem neutru {x3: setvar}:
  $ wn (weu x3 wtru) $;

--| There does not exist at most one set such that ` T. ` is true. (Contributed by Anthony Hart, 13-Sep-2011.)
theorem nmotru {x3: setvar}:
  $ wn (wmo x3 wtru) $;

--| There exist at most one set such that ` F. ` is true. (Contributed by Anthony Hart, 13-Sep-2011.)
theorem mofal {x3: setvar}:
  $ wmo x3 wfal $;

--| "At most one" restricted existential quantifier for a statement which is never true. (Contributed by Thierry Arnoux, 27-Nov-2023.)
theorem nrmo {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wcel (cv x3) A2) (wn ph) $ >
  $ wrmo x3 ph A2 $;

--| A single axiom for propositional calculus discovered by C. A. Meredith. (Contributed by Anthony Hart, 13-Aug-2011.)
theorem meran1 (ph ps ch th ta: wff):
  $ wo (wn (wo (wn (wo (wn ph) ps)) (wo ch (wo th ta)))) (wo (wn (wo (wn th) ph)) (wo ch (wo ta ph))) $;

--| A single axiom for propositional calculus discovered by C. A. Meredith. (Contributed by Anthony Hart, 13-Aug-2011.)
theorem meran2 (ph ps ch th ta: wff):
  $ wo (wn (wo (wn (wo (wn ph) ps)) (wo ch (wo th ta)))) (wo (wn (wo (wn ta) th)) (wo ch (wo ph th))) $;

--| A single axiom for propositional calculus discovered by C. A. Meredith. (Contributed by Anthony Hart, 13-Aug-2011.)
theorem meran3 (ph ps ch th ta: wff):
  $ wo (wn (wo (wn (wo (wn ph) ps)) (wo ch (wo th ta)))) (wo (wn (wo (wn ch) ph)) (wo ta (wo th ph))) $;

--| A single axiom for propositional calculus discovered by Mordchaj Wajsberg (Logical Works, Polish Academy of Sciences, 1977). See: Fitelson, _Some recent results in algebra and logical calculi obtained using automated reasoning_, 2003 (axiom W on slide 8). (Contributed by Anthony Hart, 13-Aug-2011.)
theorem waj_ax (ph ps ch th: wff):
  $ wnan (wnan ph (wnan ps ch)) (wnan (wnan (wnan th ch) (wnan (wnan ph th) (wnan ph th))) (wnan ph (wnan ph ps))) $;

--| A single axiom for propositional calculus discovered by Jan Lukasiewicz. See: Fitelson, _Some recent results in algebra and logical calculi obtained using automated reasoning_, 2003 (axiom L2 on slide 8). (Contributed by Anthony Hart, 14-Aug-2011.)
theorem lukshef_ax2 (ph ps ch th: wff):
  $ wnan (wnan ph (wnan ps ch)) (wnan (wnan ph (wnan ch ph)) (wnan (wnan th ps) (wnan (wnan ph th) (wnan ph th)))) $;

--| A single axiom for propositional calculus discovered by Ken Harris and Branden Fitelson. See: Fitelson, _Some recent results in algebra and logical calculi obtained using automated reasoning_, 2003 (axiom HF1 on slide 8). (Contributed by Anthony Hart, 14-Aug-2011.)
theorem arg_ax (ph ps ch th: wff):
  $ wnan (wnan ph (wnan ps ch)) (wnan (wnan ph (wnan ps ch)) (wnan (wnan th ch) (wnan (wnan ch th) (wnan ph th)))) $;

--| In the paper "On Variable Functors of Propositional Arguments", Lukasiewicz introduced a system that can handle variable connectives. This was done by introducing a variable, marked with a lowercase delta, which takes a wff as input. In the system, "delta ` ph ` " means that "something is true of ` ph ` ". The expression "delta ` ph ` " can be substituted with ` -. ph ` , ` ps /\ ph ` , ` A. x ph ` , etc. Later on, Meredith discovered a single axiom, in the form of ` ( ` delta delta ` F. -> ` delta ` ph ` ` ) ` . This represents the shortest theorem in the extended propositional calculus that cannot be derived as an instance of a theorem in propositional calculus. A symmetry with ` -. ` . (Contributed by Anthony Hart, 4-Sep-2011.)
theorem negsym1 (ph: wff):
  $ wi (wn (wn wfal)) (wn ph) $;

--| A symmetry with ` -> ` . See ~ negsym1 for more information. (Contributed by Anthony Hart, 4-Sep-2011.)
theorem imsym1 (ph ps: wff):
  $ wi (wi ps (wi ps wfal)) (wi ps ph) $;

--| A symmetry with ` <-> ` . See ~ negsym1 for more information. (Contributed by Anthony Hart, 4-Sep-2011.)
theorem bisym1 (ph ps: wff):
  $ wi (wb ps (wb ps wfal)) (wb ps ph) $;

--| A symmetry with ` /\ ` . See ~ negsym1 for more information. (Contributed by Anthony Hart, 4-Sep-2011.)
theorem consym1 (ph ps: wff):
  $ wi (wa ps (wa ps wfal)) (wa ps ph) $;

--| A symmetry with ` \/ ` . See ~ negsym1 for more information. (Contributed by Anthony Hart, 4-Sep-2011.)
theorem dissym1 (ph ps: wff):
  $ wi (wo ps (wo ps wfal)) (wo ps ph) $;

--| A symmetry with ` -/\ ` . See ~ negsym1 for more information. (Contributed by Anthony Hart, 4-Sep-2011.)
theorem nandsym1 (ph ps: wff):
  $ wi (wnan ps (wnan ps wfal)) (wnan ps ph) $;

--| A symmetry with ` A. ` . See ~ negsym1 for more information. (Contributed by Anthony Hart, 4-Sep-2011.) (Proof shortened by Mario Carneiro, 11-Dec-2016.)
theorem unisym1 {x3: setvar} (ph: wff x3):
  $ wi (wal x3 (wal x3 wfal)) (wal x3 ph) $;

--| A symmetry with ` E. ` . See ~ negsym1 for more information. (Contributed by Anthony Hart, 4-Sep-2011.)
theorem exisym1 {x3: setvar} (ph: wff x3):
  $ wi (wex x3 (wex x3 wfal)) (wex x3 ph) $;

--| A symmetry with ` E! ` . See ~ negsym1 for more information. (Contributed by Anthony Hart, 6-Sep-2011.)
theorem unqsym1 {x3: setvar} (ph: wff x3):
  $ wi (weu x3 (weu x3 wfal)) (weu x3 ph) $;

--| A symmetry with ` E* ` . See ~ negsym1 for more information. (Contributed by Anthony Hart, 13-Sep-2011.)
theorem amosym1 {x3: setvar} (ph: wff x3):
  $ wi (wmo x3 (wmo x3 wfal)) (wmo x3 ph) $;

--| A symmetry with ` [ x / y ] ` . See ~ negsym1 for more information. (Contributed by Anthony Hart, 11-Sep-2011.)
theorem subsym1 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wsb x3 (wsb x3 wfal y1) y1) (wsb x3 ph y1) $;

--| An ordinal number is a topological basis. (Contributed by Chen-Pang He, 8-Oct-2015.)
theorem ontopbas (B2: class):
  $ wi (wcel B2 con0) (wcel B2 ctb) $;

--| The class of ordinal numbers is a subclass of the class of topological bases. (Contributed by Chen-Pang He, 8-Oct-2015.)
theorem onsstopbas:
  $ wss con0 ctb $;

--| The class of ordinal numbers is a proper subclass of the class of topological bases. (Contributed by Chen-Pang He, 9-Oct-2015.)
theorem onpsstopbas:
  $ wpss con0 ctb $;

--| The topology generated from an ordinal number ` B ` is ` suc U. B ` . (Contributed by Chen-Pang He, 10-Oct-2015.)
theorem ontgval (B2: class):
  $ wi (wcel B2 con0) (wceq (cfv B2 ctg) (csuc (cuni B2))) $;

--| The topology generated from a successor ordinal number is itself. (Contributed by Chen-Pang He, 11-Oct-2015.)
theorem ontgsucval (A2: class):
  $ wi (wcel A2 con0) (wceq (cfv (csuc A2) ctg) (csuc A2)) $;

--| A successor ordinal number is a topology. (Contributed by Chen-Pang He, 11-Oct-2015.)
theorem onsuctop (A2: class):
  $ wi (wcel A2 con0) (wcel (csuc A2) ctop) $;

--| One of the topologies on an ordinal number is its successor. (Contributed by Chen-Pang He, 7-Nov-2015.)
theorem onsuctopon (A2: class):
  $ wi (wcel A2 con0) (wcel (csuc A2) (cfv A2 ctopon)) $;

--| Membership of the class of successor ordinals. (Contributed by Chen-Pang He, 1-Nov-2015.)
theorem ordtoplem (A2 S: class):
  $ wi (wcel (cuni A2) con0) (wcel (csuc (cuni A2)) S) $ >
  $ wi (word A2) (wi (wne A2 (cuni A2)) (wcel A2 S)) $;

--| An ordinal is a topology iff it is not its supremum (union), proven without the Axiom of Regularity. (Contributed by Chen-Pang He, 1-Nov-2015.)
theorem ordtop (J: class):
  $ wi (word J) (wb (wcel J ctop) (wne J (cuni J))) $;

--| A successor ordinal number is a connected topology. (Contributed by Chen-Pang He, 16-Oct-2015.)
theorem onsucconni (A2: class):
  $ wcel A2 con0 $ >
  $ wcel (csuc A2) cconn $;

--| A successor ordinal number is a connected topology. (Contributed by Chen-Pang He, 16-Oct-2015.)
theorem onsucconn (A2: class):
  $ wi (wcel A2 con0) (wcel (csuc A2) cconn) $;

--| An ordinal topology is connected. (Contributed by Chen-Pang He, 1-Nov-2015.)
theorem ordtopconn (J: class):
  $ wi (word J) (wb (wcel J ctop) (wcel J cconn)) $;

--| An ordinal topology is connected, expressed in constants. (Contributed by Chen-Pang He, 16-Oct-2015.)
theorem onintopssconn:
  $ wss (cin con0 ctop) cconn $;

--| A successor ordinal number is a T_0 space. (Contributed by Chen-Pang He, 8-Nov-2015.)
theorem onsuct0 (A2: class):
  $ wi (wcel A2 con0) (wcel (csuc A2) ct0) $;

--| An ordinal topology is T_0. (Contributed by Chen-Pang He, 8-Nov-2015.)
theorem ordtopt0 (J: class):
  $ wi (word J) (wb (wcel J ctop) (wcel J ct0)) $;

--| The successor of a successor ordinal number is a compact topology, proven without the Axiom of Regularity. (Contributed by Chen-Pang He, 18-Oct-2015.)
theorem onsucsuccmpi (A2: class):
  $ wcel A2 con0 $ >
  $ wcel (csuc (csuc A2)) ccmp $;

--| The successor of a successor ordinal number is a compact topology. (Contributed by Chen-Pang He, 18-Oct-2015.)
theorem onsucsuccmp (A2: class):
  $ wi (wcel A2 con0) (wcel (csuc (csuc A2)) ccmp) $;

--| The successor of a limit ordinal is not compact. (Contributed by Chen-Pang He, 20-Oct-2015.)
theorem limsucncmpi (A2: class):
  $ wlim A2 $ >
  $ wn (wcel (csuc A2) ccmp) $;

--| The successor of a limit ordinal is not compact. (Contributed by Chen-Pang He, 20-Oct-2015.)
theorem limsucncmp (A2: class):
  $ wi (wlim A2) (wn (wcel (csuc A2) ccmp)) $;

--| An ordinal topology is compact iff the underlying set is its supremum (union) only when the ordinal is ` 1o ` . (Contributed by Chen-Pang He, 1-Nov-2015.)
theorem ordcmp (A2: class):
  $ wi (word A2) (wb (wcel A2 ccmp) (wi (wceq (cuni A2) (cuni (cuni A2))) (wceq A2 c1o))) $;

--| The ordinal topologies ` 1o ` and ` 2o ` are Hausdorff. (Contributed by Chen-Pang He, 10-Nov-2015.)
theorem ssoninhaus:
  $ wss (cpr c1o c2o) (cin con0 cha) $;

--| The ordinal T_1 spaces are ` 1o ` and ` 2o ` , proven without the Axiom of Regularity. (Contributed by Chen-Pang He, 9-Nov-2015.)
theorem onint1:
  $ wceq (cin con0 ct1) (cpr c1o c2o) $;

--| The ordinal Hausdorff spaces are ` 1o ` and ` 2o ` . (Contributed by Chen-Pang He, 10-Nov-2015.)
theorem oninhaus:
  $ wceq (cin con0 cha) (cpr c1o c2o) $;

--| Please add description here. (Contributed by Jeff Hoffman, 12-Feb-2008.)
theorem fveleq (ph: wff) (A2 B2 P F: class):
  $ wi (wceq A2 B2) (wb (wi ph (wcel (cfv A2 F) P)) (wi ph (wcel (cfv B2 F) P))) $;

--| Please add description here. (Contributed by Jeff Hoffman, 12-Feb-2008.)
theorem findfvcl {y1: setvar} (ph: wff) (A2: class y1) (P F: class):
  $ wi ph (wcel (cfv c0 F) P) $ >
  $ wi (wcel (cv y1) com) (wi ph (wi (wcel (cfv (cv y1) F) P) (wcel (cfv (csuc (cv y1)) F) P))) $ >
  $ wi (wcel A2 com) (wi ph (wcel (cfv A2 F) P)) $;

--| Please add description here. (Contributed by Jeff Hoffman, 19-Feb-2008.)
theorem findreccl {z: setvar} (A2: class) (C: class z) (P G: class):
  $ wi (wcel (cv z) P) (wcel (cfv (cv z) G) P) $ >
  $ wi (wcel C com) (wi (wcel A2 P) (wcel (cfv C (crdg G A2)) P)) $;

--| Please add description here. (Contributed by Jeff Hoffman, 16-Feb-2008.) (Revised by Mario Carneiro, 11-Sep-2015.)
theorem findabrcl {x3 z: setvar} (A2: class) (C: class z) (P: class x3) (G: class):
  $ wi (wcel (cv z) P) (wcel (cfv (cv z) G) P) $ >
  $ wi (wa (wcel C com) (wcel A2 P)) (wcel (cfv C (cmpt x3 cvv (cfv (cv x3) (crdg G A2)))) P) $;

--| Convert a theorem for real/complex numbers into one for positive integers. (Contributed by Jeff Hoffman, 17-Jun-2008.)
theorem nnssi2 (ph ps: wff) (A2 B2 D: class):
  $ wss cn D $ >
  $ wi (wcel B2 cn) ph $ >
  $ wi (w3a (wcel A2 D) (wcel B2 D) ph) ps $ >
  $ wi (wa (wcel A2 cn) (wcel B2 cn)) ps $;

--| Convert a theorem for real/complex numbers into one for positive integers. (Contributed by Jeff Hoffman, 17-Jun-2008.)
theorem nnssi3 (ph ps: wff) (A2 B2 C D: class):
  $ wss cn D $ >
  $ wi (wcel C cn) ph $ >
  $ wi (wa (w3a (wcel A2 D) (wcel B2 D) (wcel C D)) ph) ps $ >
  $ wi (w3a (wcel A2 cn) (wcel B2 cn) (wcel C cn)) ps $;

--| Please add description here. (Contributed by Jeff Hoffman, 17-Jun-2008.)
theorem nndivsub (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cn) (wcel B2 cn) (wcel C cn)) (wa (wcel (co A2 C cdiv) cn) (wbr A2 B2 clt))) (wb (wcel (co B2 C cdiv) cn) (wcel (co (co B2 A2 cmin) C cdiv) cn)) $;

--| A factor of a positive integer cannot exceed it. (Contributed by Jeff Hoffman, 17-Jun-2008.)
theorem nndivlub (A2 B2: class):
  $ wi (wa (wcel A2 cn) (wcel B2 cn)) (wi (wcel (co A2 B2 cdiv) cn) (wbr B2 A2 cle)) $;

--| Extend class notation to include the gdc function. (New usage is discouraged.)
term cgcdOLD (A2 B2: class): class;

--| ` gcdOLD ( A , B ) ` is the largest positive integer that evenly divides both ` A ` and ` B ` . (Contributed by Jeff Hoffman, 17-Jun-2008.) (New usage is discouraged.)
axiom df_gcdOLD {x3: setvar} (A2 B2: class):
  $ wceq (cgcdOLD A2 B2) (csup (crab x3 (wa (wcel (co A2 (cv x3) cdiv) cn) (wcel (co B2 (cv x3) cdiv) cn)) cn) cn clt) $;

--| Lemma for Euclid's Elements, Book 7, proposition 2. The original mentions the smaller measure being 'continually subtracted' from the larger. Many authors interpret this phrase as ` A ` mod ` B ` . Here, just one subtraction step is proved to preserve the ` gcdOLD ` . The ` rec ` function will be used in other proofs for iterated subtraction. (Contributed by Jeff Hoffman, 17-Jun-2008.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ee7_2aOLD (A2 B2: class):
  $ wi (wa (wcel A2 cn) (wcel B2 cn)) (wi (wbr A2 B2 clt) (wceq (cgcdOLD A2 B2) (cgcdOLD A2 (co B2 A2 cmin)))) $;

--| Value of the relation constructed in ~ weiunpo , ~ weiunso , ~ weiunfr , and ~ weiunse . (Contributed by Matthew House, 8-Sep-2025.)
theorem weiunval {x3 y1 z w v u: setvar} (A2: class) (B2: class x3) (C D: class x3 w v u) (R: class x3) (S: class x3 w v u) (T: class x3 y1 z w v u) (F: class x3 w v u):
  $ wceq F (cmpt w (ciun x3 A2 B2) (crio u (wral v (wn (wbr (cv v) (cv u) R)) (crab x3 (wcel (cv w) B2) A2)) (crab x3 (wcel (cv w) B2) A2))) $ >
  $ wceq T (copab y1 z (wa (wa (wcel (cv y1) (ciun x3 A2 B2)) (wcel (cv z) (ciun x3 A2 B2))) (wo (wbr (cfv (cv y1) F) (cfv (cv z) F) R) (wa (wceq (cfv (cv y1) F) (cfv (cv z) F)) (wbr (cv y1) (cv z) (csb x3 (cfv (cv y1) F) S)))))) $ >
  $ wb (wbr C D T) (wa (wa (wcel C (ciun x3 A2 B2)) (wcel D (ciun x3 A2 B2))) (wo (wbr (cfv C F) (cfv D F) R) (wa (wceq (cfv C F) (cfv D F)) (wbr C D (csb x3 (cfv C F) S))))) $;

--| Lemma for ~ weiunpo , ~ weiunso , ~ weiunfr , and ~ weiunse . (Contributed by Matthew House, 23-Aug-2025.)
theorem weiunlem {x3 y1 z w v u t s1: setvar} (ph: wff x3 y1 z w v u s1) (A2: class) (B2 R: class x3) (S: class x3 w v u) (T: class x3 y1 z w v u t s1) (F: class x3 w v u):
  $ wceq F (cmpt w (ciun x3 A2 B2) (crio u (wral v (wn (wbr (cv v) (cv u) R)) (crab x3 (wcel (cv w) B2) A2)) (crab x3 (wcel (cv w) B2) A2))) $ >
  $ wceq T (copab y1 z (wa (wa (wcel (cv y1) (ciun x3 A2 B2)) (wcel (cv z) (ciun x3 A2 B2))) (wo (wbr (cfv (cv y1) F) (cfv (cv z) F) R) (wa (wceq (cfv (cv y1) F) (cfv (cv z) F)) (wbr (cv y1) (cv z) (csb x3 (cfv (cv y1) F) S)))))) $ >
  $ wi ph (wwe A2 R) $ >
  $ wi ph (wse A2 R) $ >
  $ wi ph (w3a (wf (ciun x3 A2 B2) A2 F) (wral t (wcel (cv t) (csb x3 (cfv (cv t) F) B2)) (ciun x3 A2 B2)) (wral s1 (wral t (wn (wbr (cv s1) (cfv (cv t) F) R)) (csb x3 (cv s1) B2)) A2)) $;

--| Lemma for ~ weiunfr . (Contributed by Matthew House, 23-Aug-2025.)
theorem weiunfrlem {x3 y1 z w v u t r q p: setvar} (ph: wff x3 y1 z w v u r q p) (A2: class) (B2 R: class x3) (S: class x3 w v u) (T: class x3 y1 z w v u t) (E: class x3 y1 z w v u r q p) (F: class x3 w v u):
  $ wceq F (cmpt w (ciun x3 A2 B2) (crio u (wral v (wn (wbr (cv v) (cv u) R)) (crab x3 (wcel (cv w) B2) A2)) (crab x3 (wcel (cv w) B2) A2))) $ >
  $ wceq T (copab y1 z (wa (wa (wcel (cv y1) (ciun x3 A2 B2)) (wcel (cv z) (ciun x3 A2 B2))) (wo (wbr (cfv (cv y1) F) (cfv (cv z) F) R) (wa (wceq (cfv (cv y1) F) (cfv (cv z) F)) (wbr (cv y1) (cv z) (csb x3 (cfv (cv y1) F) S)))))) $ >
  $ wi ph (wwe A2 R) $ >
  $ wi ph (wse A2 R) $ >
  $ wceq E (crio p (wral q (wn (wbr (cv q) (cv p) R)) (cima F (cv r))) (cima F (cv r))) $ >
  $ wi ph (wss (cv r) (ciun x3 A2 B2)) $ >
  $ wi ph (wne (cv r) c0) $ >
  $ wi ph (w3a (wcel E (cima F (cv r))) (wral t (wn (wbr (cfv (cv t) F) E R)) (cv r)) (wral t (wceq (cfv (cv t) F) E) (cin (cv r) (csb x3 E B2)))) $;

--| A partial ordering on an indexed union can be constructed from a well-ordering on its index class and a collection of partial orderings on its members. (Contributed by Matthew House, 23-Aug-2025.)
theorem weiunpo {x3 y1 z w v u: setvar} (A2: class) (B2 R: class x3) (S: class x3 w v u) (T: class x3 y1 z w v u) (F: class x3 w v u):
  $ wceq F (cmpt w (ciun x3 A2 B2) (crio u (wral v (wn (wbr (cv v) (cv u) R)) (crab x3 (wcel (cv w) B2) A2)) (crab x3 (wcel (cv w) B2) A2))) $ >
  $ wceq T (copab y1 z (wa (wa (wcel (cv y1) (ciun x3 A2 B2)) (wcel (cv z) (ciun x3 A2 B2))) (wo (wbr (cfv (cv y1) F) (cfv (cv z) F) R) (wa (wceq (cfv (cv y1) F) (cfv (cv z) F)) (wbr (cv y1) (cv z) (csb x3 (cfv (cv y1) F) S)))))) $ >
  $ wi (w3a (wwe A2 R) (wse A2 R) (wral x3 (wpo B2 S) A2)) (wpo (ciun x3 A2 B2) T) $;

--| A strict ordering on an indexed union can be constructed from a well-ordering on its index class and a collection of strict orderings on its members. (Contributed by Matthew House, 23-Aug-2025.)
theorem weiunso {x3 y1 z w v u: setvar} (A2: class) (B2 R: class x3) (S: class x3 w v u) (T: class x3 y1 z w v u) (F: class x3 w v u):
  $ wceq F (cmpt w (ciun x3 A2 B2) (crio u (wral v (wn (wbr (cv v) (cv u) R)) (crab x3 (wcel (cv w) B2) A2)) (crab x3 (wcel (cv w) B2) A2))) $ >
  $ wceq T (copab y1 z (wa (wa (wcel (cv y1) (ciun x3 A2 B2)) (wcel (cv z) (ciun x3 A2 B2))) (wo (wbr (cfv (cv y1) F) (cfv (cv z) F) R) (wa (wceq (cfv (cv y1) F) (cfv (cv z) F)) (wbr (cv y1) (cv z) (csb x3 (cfv (cv y1) F) S)))))) $ >
  $ wi (w3a (wwe A2 R) (wse A2 R) (wral x3 (wor B2 S) A2)) (wor (ciun x3 A2 B2) T) $;

--| A well-founded relation on an indexed union can be constructed from a well-ordering on its index class and a collection of well-founded relations on its members. (Contributed by Matthew House, 23-Aug-2025.)
theorem weiunfr {x3 y1 z w v u: setvar} (A2: class) (B2 R: class x3) (S: class x3 w v u) (T: class x3 y1 z w v u) (F: class x3 w v u):
  $ wceq F (cmpt w (ciun x3 A2 B2) (crio u (wral v (wn (wbr (cv v) (cv u) R)) (crab x3 (wcel (cv w) B2) A2)) (crab x3 (wcel (cv w) B2) A2))) $ >
  $ wceq T (copab y1 z (wa (wa (wcel (cv y1) (ciun x3 A2 B2)) (wcel (cv z) (ciun x3 A2 B2))) (wo (wbr (cfv (cv y1) F) (cfv (cv z) F) R) (wa (wceq (cfv (cv y1) F) (cfv (cv z) F)) (wbr (cv y1) (cv z) (csb x3 (cfv (cv y1) F) S)))))) $ >
  $ wi (w3a (wwe A2 R) (wse A2 R) (wral x3 (wfr B2 S) A2)) (wfr (ciun x3 A2 B2) T) $;

--| The relation constructed in ~ weiunpo , ~ weiunso , ~ weiunfr , and ~ weiunwe is set-like if all members of the indexed union are sets. (Contributed by Matthew House, 23-Aug-2025.)
theorem weiunse {x3 y1 z w v u: setvar} (A2: class) (B2 R: class x3) (S: class x3 w v u) (T: class x3 y1 z w v u) (F: class x3 w v u) (V: class x3 y1 z w v u):
  $ wceq F (cmpt w (ciun x3 A2 B2) (crio u (wral v (wn (wbr (cv v) (cv u) R)) (crab x3 (wcel (cv w) B2) A2)) (crab x3 (wcel (cv w) B2) A2))) $ >
  $ wceq T (copab y1 z (wa (wa (wcel (cv y1) (ciun x3 A2 B2)) (wcel (cv z) (ciun x3 A2 B2))) (wo (wbr (cfv (cv y1) F) (cfv (cv z) F) R) (wa (wceq (cfv (cv y1) F) (cfv (cv z) F)) (wbr (cv y1) (cv z) (csb x3 (cfv (cv y1) F) S)))))) $ >
  $ wi (w3a (wwe A2 R) (wse A2 R) (wral x3 (wcel B2 V) A2)) (wse (ciun x3 A2 B2) T) $;

--| A well-ordering on an indexed union can be constructed from a well-ordering on its index class and a collection of well-orderings on its members. (Contributed by Matthew House, 23-Aug-2025.)
theorem weiunwe {x3 y1 z w v u: setvar} (A2: class) (B2 R: class x3) (S: class x3 w v u) (T: class x3 y1 z w v u) (F: class x3 w v u):
  $ wceq F (cmpt w (ciun x3 A2 B2) (crio u (wral v (wn (wbr (cv v) (cv u) R)) (crab x3 (wcel (cv w) B2) A2)) (crab x3 (wcel (cv w) B2) A2))) $ >
  $ wceq T (copab y1 z (wa (wa (wcel (cv y1) (ciun x3 A2 B2)) (wcel (cv z) (ciun x3 A2 B2))) (wo (wbr (cfv (cv y1) F) (cfv (cv z) F) R) (wa (wceq (cfv (cv y1) F) (cfv (cv z) F)) (wbr (cv y1) (cv z) (csb x3 (cfv (cv y1) F) S)))))) $ >
  $ wi (w3a (wwe A2 R) (wse A2 R) (wral x3 (wwe B2 S) A2)) (wwe (ciun x3 A2 B2) T) $;

--| An indexed union of sets is numerable if its index set is numerable and there exists a collection of well-orderings on its members. (Contributed by Matthew House, 23-Aug-2025.)
theorem numiunnum {x3: setvar} (A2: class) (B2 S V: class x3):
  $ wi (wa (wcel A2 (cdm ccrd)) (wral x3 (wa (wcel B2 V) (wwe B2 S)) A2)) (wcel (ciun x3 A2 B2) (cdm ccrd)) $;

--| Axiom of Transitive Containment, derived as a theorem from ~ ax-ext , ~ ax-rep , and ~ ax-inf2 . Use ~ ax-tco instead. (Contributed by Matthew House, 6-Apr-2026.) (New usage is discouraged.)
theorem axtco {x3 y1 z w: setvar}:
  $ wex y1 (wa (wcel (cv x3) (cv y1)) (wal z (wi (wcel (cv z) (cv y1)) (wal w (wi (wcel (cv w) (cv z)) (wcel (cv w) (cv y1))))))) $;

--| Axiom of Transitive Containment, derived as a theorem from ~ ax-ext , ~ ax-rep , and ~ ax-inf2 . Use ~ ax-tco instead. (Contributed by Matthew House, 6-Apr-2026.) (New usage is discouraged.)
theorem ax_tco {x3 y1 z w: setvar}:
  $ wex y1 (wa (wcel (cv x3) (cv y1)) (wal z (wi (wcel (cv z) (cv y1)) (wal w (wi (wcel (cv w) (cv z)) (wcel (cv w) (cv y1))))))) $;

--| Strong form of the Axiom of Transitive Containment. See ~ ax-tco for more information. In particular, this theorem generalizes the statement of ~ ax-tco , allowing it to be written with only three variables, since ` x ` need not be distinct from both ` z ` and ` w ` . (Contributed by Matthew House, 7-Apr-2026.)
theorem axtco1 {x3 y1 z w: setvar}:
  $ wex y1 (wa (wcel (cv x3) (cv y1)) (wal z (wi (wcel (cv z) (cv y1)) (wal w (wi (wcel (cv w) (cv z)) (wcel (cv w) (cv y1))))))) $;

--| Strong form of the Axiom of Transitive Containment. See ~ ax-tco for more information. In particular, this theorem generalizes the statement of ~ ax-tco , allowing it to be written with only three variables, since ` x ` need not be distinct from both ` z ` and ` w ` . (Contributed by Matthew House, 7-Apr-2026.)
theorem axtco1_b {x3 y1 z: setvar}:
  $ wex y1 (wa (wcel (cv x3) (cv y1)) (wal z (wi (wcel (cv z) (cv y1)) (wal x3 (wi (wcel (cv x3) (cv z)) (wcel (cv x3) (cv y1))))))) $;

--| Weak form of the Axiom of Transitive Containment. See ~ ax-tco for more information. In particular, this theorem shows the derivation of the weak form from the strong form. (Contributed by Matthew House, 6-Apr-2026.)
theorem axtco2 {x3 y1 z w: setvar}:
  $ wex y1 (wal z (wi (wo (wceq (cv z) (cv x3)) (wcel (cv z) (cv y1))) (wal w (wi (wcel (cv w) (cv z)) (wcel (cv w) (cv y1)))))) $;

--| Weak form of the Axiom of Transitive Containment. See ~ ax-tco for more information. In particular, this theorem shows the derivation of the weak form from the strong form. (Contributed by Matthew House, 6-Apr-2026.)
theorem axtco2_b {x3 y1 z: setvar}:
  $ wex y1 (wal z (wi (wo (wceq (cv z) (cv x3)) (wcel (cv z) (cv y1))) (wal x3 (wi (wcel (cv x3) (cv z)) (wcel (cv x3) (cv y1)))))) $;

--| Strong form ~ axtco1 of the Axiom of Transitive Containment, derived from the weak form ~ axtco2 . See ~ ax-tco for more information. As written, the proof uses ~ ax-pr via ~ el , but we could alternatively use ~ ax-pow via ~ elALT2 . Use ~ axtco1 instead. (Contributed by Matthew House, 6-Apr-2026.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem axtco1from2 {x3 y1 z w: setvar}:
  $ wex y1 (wa (wcel (cv x3) (cv y1)) (wal z (wi (wcel (cv z) (cv y1)) (wal w (wi (wcel (cv w) (cv z)) (wcel (cv w) (cv y1))))))) $;

--| Strong form of the Axiom of Transitive Containment using class variables and abbreviations. See ~ ax-tco for more information. (Contributed by Matthew House, 6-Apr-2026.)
theorem axtco1g {x3: setvar} (A2: class) (V: class x3):
  $ wi (wcel A2 V) (wex x3 (wa (wcel A2 (cv x3)) (wtr (cv x3)))) $;

--| Weak form of the Axiom of Transitive Containment using class variables and abbreviations. See ~ ax-tco for more information. (Contributed by Matthew House, 6-Apr-2026.)
theorem axtco2g {x3: setvar} (A2: class) (V: class x3):
  $ wi (wcel A2 V) (wex x3 (wa (wss A2 (cv x3)) (wtr (cv x3)))) $;

--| A version of the Axiom of Transitive Containment with no distinct variable conditions. Usage of this theorem is discouraged because it depends on ~ ax-13 . (Contributed by Matthew House, 6-Apr-2026.) (New usage is discouraged.)
theorem axtcond {x3 y1 z: setvar}:
  $ wex y1 (wal z (wi (wo (wceq (cv z) (cv x3)) (wcel (cv z) (cv y1))) (wal x3 (wi (wcel (cv x3) (cv z)) (wcel (cv x3) (cv y1)))))) $;

--| Derivation of ~ ax-un from ~ ax-tco . Use ~ ax-un instead. (Contributed by Matthew House, 6-Apr-2026.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem axuntco {x3 y1 z w: setvar}:
  $ wex y1 (wal z (wi (wex w (wa (wcel (cv z) (cv w)) (wcel (cv w) (cv x3)))) (wcel (cv z) (cv y1)))) $;

--| Derivation of ~ ax-nul from ~ ax-reg and ~ ax-tco . Use ~ ax-nul instead. (Contributed by Matthew House, 7-Apr-2026.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem axnulregtco {x3 y1: setvar}:
  $ wex x3 (wal y1 (wn (wcel (cv y1) (cv x3)))) $;

--| Derivation of ~ el from ~ ax-tco . Use ~ el instead. (Contributed by Matthew House, 7-Apr-2026.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem elALTtco {x3 y1: setvar}:
  $ wex y1 (wcel (cv x3) (cv y1)) $;

--| Version of ~ tz9.1c derived from ~ ax-tco . (Contributed by Matthew House, 6-Apr-2026.)
theorem tz9_1ctco {x3: setvar} (A2: class):
  $ wcel A2 cvv $ >
  $ wcel (cint (cab x3 (wa (wss A2 (cv x3)) (wtr (cv x3))))) cvv $;

--| Version of ~ tz9.1 derived from ~ ax-tco . (Contributed by Matthew House, 6-Apr-2026.)
theorem tz9_1tco {x3 y1: setvar} (A2: class):
  $ wcel A2 cvv $ >
  $ wex x3 (w3a (wss A2 (cv x3)) (wtr (cv x3)) (wal y1 (wi (wa (wss A2 (cv y1)) (wtr (cv y1))) (wss (cv x3) (cv y1))))) $;

--| Every nonempty transitive set contains the empty set ` (/) ` as an element, a consequence of Regularity. If we assume Transitive Containment, then we can omit the ` A e. V ` hypothesis, see ~ tr0el . (Contributed by Matthew House, 6-Apr-2026.)
theorem tr0elw (A2 V: class):
  $ wi (w3a (wcel A2 V) (wne A2 c0) (wtr A2)) (wcel c0 A2) $;

--| Every nonempty transitive class contains the empty set ` (/) ` as an element, a consequence of Regularity and Transitive Containment. (Contributed by Matthew House, 6-Apr-2026.)
theorem tr0el (A2: class):
  $ wi (wa (wne A2 c0) (wtr A2)) (wcel c0 A2) $;

--| Extend class notation with the transitive closure of a class. (Contributed by Matthew House, 6-Apr-2026.)
term cttc (A2: class): class;

--| Transitive closure of a class. Unlike ` ( TC `` A ) ` (see ~ df-tc ), this definition works even if ` A ` or its transitive closure is a proper class. Note that unless we assume Transitive Containment, the transitive closure of a set may be a proper class. If we only assume Regularity, then the class of sets whose transitive closure is a set is precisely the class of well-founded sets, see ~ ttcwf3 . (Contributed by Matthew House, 6-Apr-2026.)
axiom df_ttc {x3 y1: setvar} (A2: class):
  $ wceq (cttc A2) (ciun x3 A2 (cuni (cima (crdg (cmpt y1 cvv (cuni (cv y1))) (csn (cv x3))) com))) $;

--| Equality theorem for transitive closure. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttceq (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (cttc A2) (cttc B2)) $;

--| Equality inference for transitive closure. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttceqi (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wceq (cttc A2) (cttc B2) $;

--| Equality deduction for transitive closure. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttceqd (ph: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cttc A2) (cttc B2)) $;

--| Bound-variable hypothesis builder for transitive closure. (Contributed by Matthew House, 6-Apr-2026.)
theorem nfttc {x3: setvar} (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 (cttc A2) $;

--| The transitive closure contains its argument as a subclass. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttcid (A2: class):
  $ wss A2 (cttc A2) $;

--| The transitive closure of a class is transitive. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttctr (A2: class):
  $ wtr (cttc A2) $;

--| The transitive closure of a class is transitive. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttctr2 (A2 B2: class):
  $ wi (wcel A2 (cttc B2)) (wss A2 (cttc B2)) $;

--| The transitive closure of a class is transitive. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttctr3 (A2: class):
  $ wss (cuni (cttc A2)) (cttc A2) $;

--| The transitive closure of ` A ` is a subclass of every transitive class containing ` A ` . (Contributed by Matthew House, 6-Apr-2026.)
theorem ttcmin (A2 B2: class):
  $ wi (wa (wss A2 B2) (wtr B2)) (wss (cttc A2) B2) $;

--| If the transitive closure of a class is a set, then the class is a set. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttcexrg (A2 V: class):
  $ wi (wcel (cttc A2) V) (wcel A2 cvv) $;

--| A transitive closure contains the transitive closures of all its subclasses. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttcss (A2 B2: class):
  $ wi (wss A2 (cttc B2)) (wss (cttc A2) (cttc B2)) $;

--| The subclass relationship is inherited by transitive closures. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttcss2 (A2 B2: class):
  $ wi (wss A2 B2) (wss (cttc A2) (cttc B2)) $;

--| A transitive closure contains the transitive closures of all its elements. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttcel (A2 B2: class):
  $ wi (wcel A2 (cttc B2)) (wss (cttc A2) (cttc B2)) $;

--| Elements turn into subclasses upon taking transitive closures. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttcel2 (A2 B2: class):
  $ wi (wcel A2 B2) (wss (cttc A2) (cttc B2)) $;

--| The transitive closure of a transitive class is the class itself. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttctrid (A2: class):
  $ wi (wtr A2) (wceq (cttc A2) A2) $;

--| The transitive closure operation is idempotent. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttcidm (A2: class):
  $ wceq (cttc (cttc A2)) (cttc A2) $;

--| Transitivity of ` A C_ TC+ B ` relationship. (Contributed by Matthew House, 6-Apr-2026.)
theorem ssttctr (A2 B2 C: class):
  $ wi (wa (wss A2 (cttc B2)) (wss B2 (cttc C))) (wss A2 (cttc C)) $;

--| Transitivity of ` A e. TC+ B ` relationship. (Contributed by Matthew House, 6-Apr-2026.)
theorem elttctr (A2 B2 C: class):
  $ wi (wa (wcel A2 (cttc B2)) (wcel B2 (cttc C))) (wcel A2 (cttc C)) $;

--| A shorter expression for the transitive closure of a set. (Contributed by Matthew House, 6-Apr-2026.)
theorem dfttc2g {x3: setvar} (A2 V: class x3):
  $ wi (wcel A2 V) (wceq (cttc A2) (cuni (cima (crdg (cmpt x3 cvv (cuni (cv x3))) A2) com))) $;

--| The transitive closure of the empty set is the empty set. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttc0:
  $ wceq (cttc c0) c0 $;

--| A class has an empty transitive closure iff it is the empty set. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttc00 (A2: class):
  $ wb (wceq A2 c0) (wceq (cttc A2) c0) $;

--| Distribute proper substitution through a transitive closure. (Contributed by Matthew House, 6-Apr-2026.)
theorem csbttc {x3: setvar} (A2 B2: class x3):
  $ wceq (csb x3 A2 (cttc B2)) (cttc (csb x3 A2 B2)) $;

--| Relationship between ` TC+ A ` and ` TC+ U. A ` : we can decompose ` TC+ A ` into the elements of ` TC+ U. A ` plus the elements of ` A ` itself. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttcuniun (A2: class):
  $ wceq (cttc A2) (cun (cttc (cuni A2)) A2) $;

--| Relationship between ` TC+ A ` and ` U_ x e. A TC+ x ` : we can decompose ` TC+ A ` into the elements of ` U_ x e. A TC+ x ` plus the elements of ` A ` itself. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttciunun {x3: setvar} (A2: class):
  $ wceq (cttc A2) (cun (ciun x3 A2 (cttc (cv x3))) A2) $;

--| Distribute union of two classes through a transitive closure. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttcun (A2 B2: class):
  $ wceq (cttc (cun A2 B2)) (cun (cttc A2) (cttc B2)) $;

--| Distribute union of a class through a transitive closure. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttcuni (A2: class):
  $ wceq (cttc (cuni A2)) (cuni (cttc A2)) $;

--| Distribute indexed union through a transitive closure. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttciun {x3: setvar} (A2 B2: class x3):
  $ wceq (cttc (ciun x3 A2 B2)) (ciun x3 A2 (cttc B2)) $;

--| The transitive closure of a power class is contained in the power class of the transitive closure. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttcpwss (A2: class):
  $ wss (cttc (cpw A2)) (cpw (cttc A2)) $;

--| The transitive closure is contained in the singleton transitive closure. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttcsnssg (A2 V: class):
  $ wi (wcel A2 V) (wss (cttc A2) (cttc (csn A2))) $;

--| The singleton transitive closure contains its argument ` A ` as an element. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttcsnidg (A2 V: class):
  $ wi (wcel A2 V) (wcel A2 (cttc (csn A2))) $;

--| The singleton transitive closure is the minimal transitive class containing ` A ` as an element. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttcsnmin (A2 B2: class):
  $ wi (wa (wcel A2 B2) (wtr B2)) (wss (cttc (csn A2)) B2) $;

--| Relationship between ` TC+ { A } ` and ` TC+ A ` : the former contains the additional element ` A ` . (Contributed by Matthew House, 6-Apr-2026.)
theorem ttcsng (A2 V: class):
  $ wi (wcel A2 V) (wceq (cttc (csn A2)) (cun (cttc A2) (csn A2))) $;

--| If the transitive closure of a class is a set, then its singleton transitive closure is a set. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttcsnexg (A2 V: class):
  $ wi (wcel (cttc A2) V) (wcel (cttc (csn A2)) cvv) $;

--| The transitive closure of a set is a set iff its singleton transitive closure is a set. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttcsnexbig (A2 V: class):
  $ wi (wcel A2 V) (wb (wcel (cttc A2) cvv) (wcel (cttc (csn A2)) cvv)) $;

--| The singleton transitive closure of a transitive set is its successor. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttcsntrsucg (A2 V: class):
  $ wi (wa (wcel A2 V) (wtr A2)) (wceq (cttc (csn A2)) (csuc A2)) $;

--| If the transitive closure of ` A ` is a set, then its value is ` ( TC `` A ) ` . If we assume Transitive Containment, then we can weaken the hypothesis to ` A e. V ` , see ~ dfttc3g . (Contributed by Matthew House, 6-Apr-2026.)
theorem dfttc3gw (A2 V: class):
  $ wi (wcel (cttc A2) V) (wceq (cttc A2) (cfv A2 ctc)) $;

--| A set is well-founded iff its transitive closure is well-founded. As a corollary, the transitive closure of any well-founded set is a set. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttcwf (A2: class):
  $ wb (wcel A2 (cuni (cima cr1 con0))) (wcel (cttc A2) (cuni (cima cr1 con0))) $;

--| If a transitive closure class is a set, then it is well-founded, assuming Regularity. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttcwf2 (A2: class):
  $ wb (wcel (cttc A2) cvv) (wcel (cttc A2) (cuni (cima cr1 con0))) $;

--| The sets whose transitive closures are sets are precisely the well-founded sets, assuming Regularity. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttcwf3 (A2: class):
  $ wb (wcel (cttc A2) cvv) (wcel A2 (cuni (cima cr1 con0))) $;

--| If a transitive closure is a set, then it contains ` (/) ` as an element iff it is nonempty, assuming Regularity. If we also assume Transitive Containment, then we can remove the ` TC+ A e. V ` hypothesis, see ~ ttc0el . (Contributed by Matthew House, 6-Apr-2026.)
theorem ttc0elw (A2 V: class):
  $ wi (wcel (cttc A2) V) (wb (wne A2 c0) (wcel c0 (cttc A2))) $;

--| Lemma for ~ dfttc4 . (Contributed by Matthew House, 6-Apr-2026.)
theorem dfttc4lem1 {x3 y1 z: setvar} (A2: class z) (B2: class x3 y1 z) (C: class x3) (D: class):
  $ wceq B2 (cab x3 (wex y1 (wa (wne (cin A2 (cv y1)) c0) (wral z (wi (wceq (cin (cv z) (cv y1)) c0) (wceq (cv z) (cv x3))) (cv y1))))) $ >
  $ wcel C cvv $ >
  $ wcel D cvv $ >
  $ wi (wa (wne (cin A2 C) c0) (wral z (wi (wceq (cin (cv z) C) c0) (wceq (cv z) D)) C)) (wcel D B2) $;

--| Lemma for ~ dfttc4 . (Contributed by Matthew House, 6-Apr-2026.)
theorem dfttc4lem2 {x3 y1 z: setvar} (A2: class z) (B2: class x3 y1 z):
  $ wceq B2 (cab x3 (wex y1 (wa (wne (cin A2 (cv y1)) c0) (wral z (wi (wceq (cin (cv z) (cv y1)) c0) (wceq (cv z) (cv x3))) (cv y1))))) $ >
  $ wa (wss A2 B2) (wtr B2) $;

--| An alternative expression for the transitive closure of a class, assuming Regularity. A set ` x ` is contained in the transitive closure of ` A ` iff we can construct an ` e. ` -chain from ` x ` to an element of ` A ` . This weak definition is primarily useful for proving ~ elttcirr . (Contributed by Matthew House, 6-Apr-2026.)
theorem dfttc4 {x3 y1 z: setvar} (A2: class z):
  $ wceq (cttc A2) (cab x3 (wex y1 (wa (wne (cin A2 (cv y1)) c0) (wral z (wi (wceq (cin (cv z) (cv y1)) c0) (wceq (cv z) (cv x3))) (cv y1))))) $;

--| Irreflexivity of ` A e. TC+ B ` relationship. This is a consequence of Regularity, but it does not require Transitive Containment. We use the alternative expression ~ dfttc4 to construct a set in which ` A ` is both ` e. ` -minimal and not ` e. ` -minimal. (Contributed by Matthew House, 6-Apr-2026.)
theorem elttcirr (A2: class):
  $ wn (wcel A2 (cttc A2)) $;

--| The transitive closure of a set is a set, assuming Transitive Containment. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttcexg (A2 V: class):
  $ wi (wcel A2 V) (wcel (cttc A2) cvv) $;

--| A class is a set iff its transitive closure is a set, assuming Transitive Containment. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttcexbi (A2: class):
  $ wb (wcel A2 cvv) (wcel (cttc A2) cvv) $;

--| The transitive closure of a set ` A ` is ` ( TC `` A ) ` , assuming Transitive Containment. (Contributed by Matthew House, 6-Apr-2026.)
theorem dfttc3g (A2 V: class):
  $ wi (wcel A2 V) (wceq (cttc A2) (cfv A2 ctc)) $;

--| A transitive closure contains ` (/) ` as an element iff it is nonempty, assuming Regularity and Transitive Containment. (Contributed by Matthew House, 6-Apr-2026.)
theorem ttc0el (A2: class):
  $ wb (wne A2 c0) (wcel c0 (cttc A2)) $;

--| Principle of set induction ~ setind , written with primitive symbols. (Contributed by Matthew House, 4-Mar-2026.)
theorem mh_setind {x3 y1: setvar} (ph: wff x3):
  $ wi (wal y1 (wi (wal x3 (wi (wcel (cv x3) (cv y1)) ph)) (wal x3 (wi (wceq (cv x3) (cv y1)) ph)))) ph $;

--| A version of ~ mh-setind with no distinct variable conditions. (Contributed by Matthew House, 5-Mar-2026.) (New usage is discouraged.)
theorem mh_setindnd {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal y1 (wi (wal x3 (wi (wcel (cv x3) (cv y1)) ph)) (wal x3 (wi (wceq (cv x3) (cv y1)) (wal y1 ph))))) ph $;

--| Derivation of ~ ax-regs from ~ ax-reg + ~ ax-tco . (Contributed by Matthew House, 4-Mar-2026.)
theorem regsfromregtco {x3 y1 z w v u t s1: setvar} (ph: wff x3 t s1):
  $ wi (wex y1 (wcel (cv y1) (cv w))) (wex y1 (wa (wcel (cv y1) (cv w)) (wal z (wi (wcel (cv z) (cv y1)) (wn (wcel (cv z) (cv w))))))) $ >
  $ wex u (wa (wcel (cv v) (cv u)) (wal t (wi (wcel (cv t) (cv u)) (wal s1 (wi (wcel (cv s1) (cv t)) (wcel (cv s1) (cv u))))))) $ >
  $ wi (wex x3 ph) (wex y1 (wa (wal x3 (wi (wceq (cv x3) (cv y1)) ph)) (wal z (wi (wcel (cv z) (cv y1)) (wn (wal x3 (wi (wceq (cv x3) (cv z)) ph))))))) $;

--| Derivation of ~ ax-regs from ~ mh-setind . (Contributed by Matthew House, 4-Mar-2026.)
theorem regsfromsetind {x3 y1 z: setvar} (ph: wff x3 y1):
  $ wi (wal y1 (wi (wal x3 (wi (wcel (cv x3) (cv y1)) (wn ph))) (wal x3 (wi (wceq (cv x3) (cv y1)) (wn ph))))) (wn ph) $ >
  $ wi (wex x3 ph) (wex y1 (wa (wal x3 (wi (wceq (cv x3) (cv y1)) ph)) (wal z (wi (wcel (cv z) (cv y1)) (wn (wal x3 (wi (wceq (cv x3) (cv z)) ph))))))) $;

--| Derivation of ~ ax-regs from ~ unir1 . (Contributed by Matthew House, 4-Mar-2026.)
theorem regsfromunir1 {x3 y1 z: setvar} (ph: wff x3):
  $ wceq (cuni (cima cr1 con0)) cvv $ >
  $ wi (wex x3 ph) (wex y1 (wa (wal x3 (wi (wceq (cv x3) (cv y1)) ph)) (wal z (wi (wcel (cv z) (cv y1)) (wn (wal x3 (wi (wceq (cv x3) (cv z)) ph))))))) $;

--| A variant of ~ inf3 . If ` F ` is a one-to-one function from ` A ` into itself, and ` B ` is an element outside its range, then ` ( rec ( F , B ) |`` _om ) ` is a one-to-one function yielding an infinite sequence of distinct elements from ` A ` . If ` A ` is a set, we can use this theorem to prove ` _om e. _V ` via ~ f1dmex . (Contributed by Matthew House, 13-Apr-2026.)
theorem mh_inf3f1 (ph: wff) (A2 B2 F: class):
  $ wi ph (wf1 A2 A2 F) $ >
  $ wi ph (wcel B2 (cdif A2 (crn F))) $ >
  $ wi ph (wf1 com A2 (cres (crdg F B2) com)) $;

--| Version of ~ inf3 for the set of Zermelo ordinals ` (/) ` , ` { (/) } ` , ` { { (/) } } ` , ` { { { (/) } } } ` , etc., where the successor of ` y ` is ` { y } ` . Unlike ~ inf3 , the proof does not require ~ ax-reg , since the singleton properties ~ snnz and ~ sneqr are sufficient to guarantee that all elements of the sequence are distinct. (Contributed by Matthew House, 13-Apr-2026.)
theorem mh_inf3sn {x3 y1: setvar}:
  $ wex x3 (wa (wcel c0 (cv x3)) (wral y1 (wcel (csn (cv y1)) (cv x3)) (cv x3))) $ >
  $ wcel com cvv $;

--| Shortest possible version of ~ ax-pr in primitive symbols. (Contributed by Matthew House, 13-Apr-2026.)
theorem mh_prprimbi {x3 y1 z w: setvar}:
  $ wb (wex z (wal w (wi (wo (wceq (cv w) (cv x3)) (wceq (cv w) (cv y1))) (wcel (cv w) (cv z))))) (wn (wal z (wi (wcel (cv x3) (cv z)) (wn (wcel (cv y1) (cv z)))))) $;

--| Shortest possible version of ~ ax-un in primitive symbols. (Contributed by Matthew House, 13-Apr-2026.)
theorem mh_unprimbi {y1 z w: setvar} (x3: setvar):
  $ wb (wex y1 (wal z (wi (wex w (wa (wcel (cv z) (cv w)) (wcel (cv w) (cv x3)))) (wcel (cv z) (cv y1))))) (wn (wal y1 (wn (wal z (wi (wcel (cv z) (cv x3)) (wal w (wi (wcel (cv w) (cv z)) (wcel (cv w) (cv y1))))))))) $;

--| Shortest possible version of ~ ax-reg in primitive symbols. The equivalence is nontrivial, but it still follows solely from the axioms of predicate calculus. (Contributed by Matthew House, 13-Apr-2026.)
theorem mh_regprimbi {y1 z: setvar} (x3: setvar):
  $ wb (wi (wex y1 (wcel (cv y1) (cv x3))) (wex y1 (wa (wcel (cv y1) (cv x3)) (wal z (wi (wcel (cv z) (cv y1)) (wn (wcel (cv z) (cv x3)))))))) (wn (wal y1 (wn (wal z (wi (wi (wcel (cv y1) (cv x3)) (wcel (cv z) (cv y1))) (wn (wcel (cv z) (cv x3)))))))) $;

--| Shortest possible axiom of infinity in primitive symbols. Deriving ~ ax-inf or ~ ax-inf2 from this axiom requires ~ ax-ext , ~ ax-rep , and ~ ax-reg , see ~ inf3 and ~ inf0 . (Contributed by Matthew House, 13-Apr-2026.)
theorem mh_infprim1bi {x3 y1 z: setvar}:
  $ wb (wex x3 (wa (wne (cv x3) c0) (wss (cv x3) (cuni (cv x3))))) (wn (wal x3 (wn (wal y1 (wn (wal z (wi (wi (wcel (cv y1) (cv x3)) (wcel (cv y1) (cv z))) (wn (wcel (cv z) (cv x3)))))))))) $;

--| Shortest possible axiom of infinity in primitive symbols not requiring ~ ax-reg . Deriving ~ ax-inf or ~ ax-inf2 from this axiom requires ~ ax-ext and ~ ax-rep , see ~ mh-inf3sn and ~ inf0 . (Contributed by Matthew House, 13-Apr-2026.)
theorem mh_infprim2bi {x3 y1 z w: setvar}:
  $ wb (wex x3 (wa (wcel c0 (cv x3)) (wral y1 (wcel (csn (cv y1)) (cv x3)) (cv x3)))) (wn (wal x3 (wn (wal y1 (wal z (wi (wal w (wi (wcel (cv w) (cv y1)) (wn (wi (wcel (cv w) (cv x3)) (wn (wceq (cv w) (cv z))))))) (wcel (cv y1) (cv x3)))))))) $;

--| An axiom of infinity in primitive symbols not requiring ~ ax-reg . This version of the axiom was designed by Stefan O'Rear for his zf2.nql program, see ~ https://github.com/sorear/metamath-turing-machines . It directly implies ~ ax-inf , but deriving ~ ax-inf2 requires ~ ax-ext and ~ ax-rep , see ~ mh-inf3sn . (Contributed by Matthew House, 13-Apr-2026.)
theorem mh_infprim3bi {x3 y1 z: setvar}:
  $ wb (wex y1 (wa (wcel (cv x3) (cv y1)) (wral z (wcel (csn (cv z)) (cv y1)) (cv y1)))) (wn (wal y1 (wn (wn (wi (wcel (cv x3) (cv y1)) (wn (wal x3 (wi (wcel (cv x3) (cv y1)) (wn (wal z (wn (wn (wi (wcel (cv z) (cv y1)) (wn (wal y1 (wn (wi (wi (wcel (cv y1) (cv z)) (wceq (cv y1) (cv x3))) (wn (wi (wceq (cv y1) (cv x3)) (wcel (cv y1) (cv z))))))))))))))))))))) $;

--| Value of the "distance to nearest integer" function. (Contributed by Asger C. Ipsen, 4-Apr-2021.)
theorem dnival {x3: setvar} (A2: class) (T: class x3):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wi (wcel A2 cr) (wceq (cfv A2 T) (cfv (co (cfv (co A2 (co c1 c2 cdiv) caddc) cfl) A2 cmin) cabs)) $;

--| Closure theorem for the "distance to nearest integer" function. (Contributed by Asger C. Ipsen, 4-Apr-2021.)
theorem dnicld1 (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel (cfv (co (cfv (co A2 (co c1 c2 cdiv) caddc) cfl) A2 cmin) cabs) cr) $;

--| Closure theorem for the "distance to nearest integer" function. (Contributed by Asger C. Ipsen, 4-Apr-2021.)
theorem dnicld2 {x3: setvar} (ph: wff x3) (A2: class) (T: class x3):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel (cfv A2 T) cr) $;

--| The "distance to nearest integer" function is a function. (Contributed by Asger C. Ipsen, 4-Apr-2021.)
theorem dnif {x3: setvar} (T: class x3):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wf cr cr T $;

--| The distance to nearest integer is zero for integers. (Contributed by Asger C. Ipsen, 15-Jun-2021.)
theorem dnizeq0 {x3: setvar} (ph: wff x3) (A2: class) (T: class x3):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wceq (cfv A2 T) cc0) $;

--| The distance to nearest integer is a half for half-integers. (Contributed by Asger C. Ipsen, 15-Jun-2021.)
theorem dnizphlfeqhlf {x3: setvar} (ph: wff x3) (A2: class) (T: class x3):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wceq (cfv (co A2 (co c1 c2 cdiv) caddc) T) (co c1 c2 cdiv)) $;

--| Variant of ~ rddif . (Contributed by Asger C. Ipsen, 4-Apr-2021.)
theorem rddif2 (A2: class):
  $ wi (wcel A2 cr) (wbr cc0 (co (co c1 c2 cdiv) (cfv (co (cfv (co A2 (co c1 c2 cdiv) caddc) cfl) A2 cmin) cabs) cmin) cle) $;

--| Lemma for ~ dnibnd . (Contributed by Asger C. Ipsen, 4-Apr-2021.)
theorem dnibndlem1 {x3: setvar} (ph: wff x3) (A2 B2: class) (S T: class x3):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wb (wbr (cfv (co (cfv B2 T) (cfv A2 T) cmin) cabs) S cle) (wbr (cfv (co (cfv (co (cfv (co B2 (co c1 c2 cdiv) caddc) cfl) B2 cmin) cabs) (cfv (co (cfv (co A2 (co c1 c2 cdiv) caddc) cfl) A2 cmin) cabs) cmin) cabs) S cle)) $;

--| Lemma for ~ dnibnd . (Contributed by Asger C. Ipsen, 4-Apr-2021.)
theorem dnibndlem2 {x3: setvar} (ph: wff x3) (A2 B2: class) (T: class x3):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wceq (cfv (co B2 (co c1 c2 cdiv) caddc) cfl) (cfv (co A2 (co c1 c2 cdiv) caddc) cfl)) $ >
  $ wi ph (wbr (cfv (co (cfv B2 T) (cfv A2 T) cmin) cabs) (cfv (co B2 A2 cmin) cabs) cle) $;

--| Lemma for ~ dnibnd . (Contributed by Asger C. Ipsen, 4-Apr-2021.)
theorem dnibndlem3 {x3: setvar} (ph: wff x3) (A2 B2 T: class x3):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wceq (cfv (co B2 (co c1 c2 cdiv) caddc) cfl) (co (cfv (co A2 (co c1 c2 cdiv) caddc) cfl) c1 caddc)) $ >
  $ wi ph (wceq (cfv (co B2 A2 cmin) cabs) (cfv (co (co B2 (co (cfv (co B2 (co c1 c2 cdiv) caddc) cfl) (co c1 c2 cdiv) cmin) cmin) (co (co (cfv (co A2 (co c1 c2 cdiv) caddc) cfl) (co c1 c2 cdiv) caddc) A2 cmin) caddc) cabs)) $;

--| Lemma for ~ dnibnd . (Contributed by Asger C. Ipsen, 4-Apr-2021.)
theorem dnibndlem4 (B2: class):
  $ wi (wcel B2 cr) (wbr cc0 (co B2 (co (cfv (co B2 (co c1 c2 cdiv) caddc) cfl) (co c1 c2 cdiv) cmin) cmin) cle) $;

--| Lemma for ~ dnibnd . (Contributed by Asger C. Ipsen, 4-Apr-2021.)
theorem dnibndlem5 (A2: class):
  $ wi (wcel A2 cr) (wbr cc0 (co (co (cfv (co A2 (co c1 c2 cdiv) caddc) cfl) (co c1 c2 cdiv) caddc) A2 cmin) clt) $;

--| Lemma for ~ dnibnd . (Contributed by Asger C. Ipsen, 4-Apr-2021.)
theorem dnibndlem6 (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr (cfv (co (cfv (co (cfv (co B2 (co c1 c2 cdiv) caddc) cfl) B2 cmin) cabs) (cfv (co (cfv (co A2 (co c1 c2 cdiv) caddc) cfl) A2 cmin) cabs) cmin) cabs) (co (co (co c1 c2 cdiv) (cfv (co (cfv (co B2 (co c1 c2 cdiv) caddc) cfl) B2 cmin) cabs) cmin) (co (co c1 c2 cdiv) (cfv (co (cfv (co A2 (co c1 c2 cdiv) caddc) cfl) A2 cmin) cabs) cmin) caddc) cle) $;

--| Lemma for ~ dnibnd . (Contributed by Asger C. Ipsen, 4-Apr-2021.)
theorem dnibndlem7 (ph: wff) (B2: class):
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr (co (co c1 c2 cdiv) (cfv (co (cfv (co B2 (co c1 c2 cdiv) caddc) cfl) B2 cmin) cabs) cmin) (co B2 (co (cfv (co B2 (co c1 c2 cdiv) caddc) cfl) (co c1 c2 cdiv) cmin) cmin) cle) $;

--| Lemma for ~ dnibnd . (Contributed by Asger C. Ipsen, 4-Apr-2021.)
theorem dnibndlem8 (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wbr (co (co c1 c2 cdiv) (cfv (co (cfv (co A2 (co c1 c2 cdiv) caddc) cfl) A2 cmin) cabs) cmin) (co (co (cfv (co A2 (co c1 c2 cdiv) caddc) cfl) (co c1 c2 cdiv) caddc) A2 cmin) cle) $;

--| Lemma for ~ dnibnd . (Contributed by Asger C. Ipsen, 4-Apr-2021.)
theorem dnibndlem9 {x3: setvar} (ph: wff x3) (A2 B2: class) (T: class x3):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wceq (cfv (co B2 (co c1 c2 cdiv) caddc) cfl) (co (cfv (co A2 (co c1 c2 cdiv) caddc) cfl) c1 caddc)) $ >
  $ wi ph (wbr (cfv (co (cfv B2 T) (cfv A2 T) cmin) cabs) (cfv (co B2 A2 cmin) cabs) cle) $;

--| Lemma for ~ dnibnd . (Contributed by Asger C. Ipsen, 4-Apr-2021.)
theorem dnibndlem10 (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr (co (cfv (co A2 (co c1 c2 cdiv) caddc) cfl) c2 caddc) (cfv (co B2 (co c1 c2 cdiv) caddc) cfl) cle) $ >
  $ wi ph (wbr c1 (co B2 A2 cmin) cle) $;

--| Lemma for ~ dnibnd . (Contributed by Asger C. Ipsen, 4-Apr-2021.)
theorem dnibndlem11 (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr (cfv (co (cfv (co (cfv (co B2 (co c1 c2 cdiv) caddc) cfl) B2 cmin) cabs) (cfv (co (cfv (co A2 (co c1 c2 cdiv) caddc) cfl) A2 cmin) cabs) cmin) cabs) (co c1 c2 cdiv) cle) $;

--| Lemma for ~ dnibnd . (Contributed by Asger C. Ipsen, 4-Apr-2021.)
theorem dnibndlem12 {x3: setvar} (ph: wff x3) (A2 B2: class) (T: class x3):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr (co (cfv (co A2 (co c1 c2 cdiv) caddc) cfl) c2 caddc) (cfv (co B2 (co c1 c2 cdiv) caddc) cfl) cle) $ >
  $ wi ph (wbr (cfv (co (cfv B2 T) (cfv A2 T) cmin) cabs) (cfv (co B2 A2 cmin) cabs) cle) $;

--| Lemma for ~ dnibnd . (Contributed by Asger C. Ipsen, 4-Apr-2021.)
theorem dnibndlem13 {x3: setvar} (ph: wff x3) (A2 B2: class) (T: class x3):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr (cfv (co A2 (co c1 c2 cdiv) caddc) cfl) (cfv (co B2 (co c1 c2 cdiv) caddc) cfl) cle) $ >
  $ wi ph (wbr (cfv (co (cfv B2 T) (cfv A2 T) cmin) cabs) (cfv (co B2 A2 cmin) cabs) cle) $;

--| The "distance to nearest integer" function is 1-Lipschitz continuous, i.e., is a short map. (Contributed by Asger C. Ipsen, 4-Apr-2021.)
theorem dnibnd {x3: setvar} (ph: wff x3) (A2 B2: class) (T: class x3):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr (cfv (co (cfv B2 T) (cfv A2 T) cmin) cabs) (cfv (co B2 A2 cmin) cabs) cle) $;

--| The "distance to nearest integer" function is continuous. (Contributed by Asger C. Ipsen, 4-Apr-2021.)
theorem dnicn {x3: setvar} (T: class x3):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wcel T (co cr cr ccncf) $;

--| Lemma for ~ knoppcn . (Contributed by Asger C. Ipsen, 4-Apr-2021.)
theorem knoppcnlem1 {y1 n: setvar} (ph: wff) (A2 C T: class) (F: class y1 n) (M: class y1) (N: class):
  $ wceq F (cmpt y1 cr (cmpt n cn0 (co (co C (cv n) cexp) (cfv (co (co (co c2 N cmul) (cv n) cexp) (cv y1) cmul) T) cmul))) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wceq (cfv M (cfv A2 F)) (co (co C M cexp) (cfv (co (co (co c2 N cmul) M cexp) A2 cmul) T) cmul)) $;

--| Lemma for ~ knoppcn . (Contributed by Asger C. Ipsen, 4-Apr-2021.) (Revised by Asger C. Ipsen, 5-Jul-2021.)
theorem knoppcnlem2 {x3: setvar} (ph: wff x3) (A2: class) (C T: class x3) (M N: class):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wcel (co (co C M cexp) (cfv (co (co (co c2 N cmul) M cexp) A2 cmul) T) cmul) cr) $;

--| Lemma for ~ knoppcn . (Contributed by Asger C. Ipsen, 4-Apr-2021.) (Revised by Asger C. Ipsen, 5-Jul-2021.)
theorem knoppcnlem3 {x3 y1 n: setvar} (ph: wff x3) (A2: class) (C T: class x3) (F: class x3 y1 n) (M: class y1) (N: class):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wceq F (cmpt y1 cr (cmpt n cn0 (co (co C (cv n) cexp) (cfv (co (co (co c2 N cmul) (cv n) cexp) (cv y1) cmul) T) cmul))) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wcel (cfv M (cfv A2 F)) cr) $;

--| Lemma for ~ knoppcn . (Contributed by Asger C. Ipsen, 4-Apr-2021.) (Revised by Asger C. Ipsen, 5-Jul-2021.)
theorem knoppcnlem4 {x3 y1 m n: setvar} (ph: wff x3) (A2: class m) (C: class x3) (T: class x3 m) (F: class x3 y1 m n) (M: class y1) (N: class m):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wceq F (cmpt y1 cr (cmpt n cn0 (co (co C (cv n) cexp) (cfv (co (co (co c2 N cmul) (cv n) cexp) (cv y1) cmul) T) cmul))) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wbr (cfv (cfv M (cfv A2 F)) cabs) (cfv M (cmpt m cn0 (co (cfv C cabs) (cv m) cexp))) cle) $;

--| Lemma for ~ knoppcn . (Contributed by Asger C. Ipsen, 4-Apr-2021.) (Revised by Asger C. Ipsen, 5-Jul-2021.)
theorem knoppcnlem5 {x3 y1 z m n: setvar} (ph: wff x3) (C T: class x3 z m) (F: class x3 y1 z m n) (N: class z m):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wceq F (cmpt y1 cr (cmpt n cn0 (co (co C (cv n) cexp) (cfv (co (co (co c2 N cmul) (cv n) cexp) (cv y1) cmul) T) cmul))) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wf cn0 (co cc cr cmap) (cmpt m cn0 (cmpt z cr (cfv (cv m) (cfv (cv z) F))))) $;

--| Lemma for ~ knoppcn . (Contributed by Asger C. Ipsen, 4-Apr-2021.) (Revised by Asger C. Ipsen, 5-Jul-2021.)
theorem knoppcnlem6 {x3 y1 z m n: setvar} (ph: wff x3) (C: class x3 z) (T: class x3 z m) (F: class x3 y1 n) (N: class z m):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wceq F (cmpt y1 cr (cmpt n cn0 (co (co C (cv n) cexp) (cfv (co (co (co c2 N cmul) (cv n) cexp) (cv y1) cmul) T) cmul))) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wbr (cfv C cabs) c1 clt) $ >
  $ wi ph (wcel (cseq (cof caddc) (cmpt m cn0 (cmpt z cr (cfv (cv m) (cfv (cv z) F)))) cc0) (cdm (cfv cr culm))) $;

--| Lemma for ~ knoppcn . (Contributed by Asger C. Ipsen, 4-Apr-2021.) (Revised by Asger C. Ipsen, 5-Jul-2021.)
theorem knoppcnlem7 {x3 y1 z w m n: setvar} (ph: wff x3 y1 z n) (C T: class x3 y1 z w m n) (F: class x3 y1 n) (M: class x3 y1 z n) (N: class x3 y1 z w m n):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wceq F (cmpt y1 cr (cmpt n cn0 (co (co C (cv n) cexp) (cfv (co (co (co c2 N cmul) (cv n) cexp) (cv y1) cmul) T) cmul))) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wceq (cfv M (cseq (cof caddc) (cmpt m cn0 (cmpt z cr (cfv (cv m) (cfv (cv z) F)))) cc0)) (cmpt w cr (cfv M (cseq caddc (cfv (cv w) F) cc0)))) $;

--| Lemma for ~ knoppcn . (Contributed by Asger C. Ipsen, 4-Apr-2021.) (Revised by Asger C. Ipsen, 5-Jul-2021.)
theorem knoppcnlem8 {x3 y1 z m n: setvar} (ph: wff x3 z) (C T: class x3 z m) (F: class x3 y1 n) (N: class z m):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wceq F (cmpt y1 cr (cmpt n cn0 (co (co C (cv n) cexp) (cfv (co (co (co c2 N cmul) (cv n) cexp) (cv y1) cmul) T) cmul))) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wf cn0 (co cc cr cmap) (cseq (cof caddc) (cmpt m cn0 (cmpt z cr (cfv (cv m) (cfv (cv z) F)))) cc0)) $;

--| Lemma for ~ knoppcn . (Contributed by Asger C. Ipsen, 4-Apr-2021.) (Revised by Asger C. Ipsen, 5-Jul-2021.)
theorem knoppcnlem9 {x3 y1 z w i m n: setvar} (ph: wff x3) (C: class x3 z w i) (T: class x3 z w i m) (F: class x3 y1 n) (N: class z w i m) (W: class x3 y1 z w i m n):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wceq F (cmpt y1 cr (cmpt n cn0 (co (co C (cv n) cexp) (cfv (co (co (co c2 N cmul) (cv n) cexp) (cv y1) cmul) T) cmul))) $ >
  $ wceq W (cmpt w cr (csu i cn0 (cfv (cv i) (cfv (cv w) F)))) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wbr (cfv C cabs) c1 clt) $ >
  $ wi ph (wbr (cseq (cof caddc) (cmpt m cn0 (cmpt z cr (cfv (cv m) (cfv (cv z) F)))) cc0) W (cfv cr culm)) $;

--| Lemma for ~ knoppcn . (Contributed by Asger C. Ipsen, 4-Apr-2021.) (Revised by Asger C. Ipsen, 5-Jul-2021.) Avoid ~ ax-mulf . (Revised by GG, 19-Apr-2025.)
theorem knoppcnlem10 {x3 y1 z n: setvar} (ph: wff x3) (C T: class x3) (F: class x3 y1 z n) (M: class x3 y1) (N: class x3):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wceq F (cmpt y1 cr (cmpt n cn0 (co (co C (cv n) cexp) (cfv (co (co (co c2 N cmul) (cv n) cexp) (cv y1) cmul) T) cmul))) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wcel (cmpt z cr (cfv M (cfv (cv z) F))) (co (cfv (crn cioo) ctg) (cfv ccnfld ctopn) ccn)) $;

--| Lemma for ~ knoppcn . (Contributed by Asger C. Ipsen, 4-Apr-2021.) (Revised by Asger C. Ipsen, 5-Jul-2021.)
theorem knoppcnlem11 {x3 y1 z m n: setvar} (ph: wff x3 z) (C T: class x3 z m) (F: class x3 y1 n) (N: class z m):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wceq F (cmpt y1 cr (cmpt n cn0 (co (co C (cv n) cexp) (cfv (co (co (co c2 N cmul) (cv n) cexp) (cv y1) cmul) T) cmul))) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wf cn0 (co cr cc ccncf) (cseq (cof caddc) (cmpt m cn0 (cmpt z cr (cfv (cv m) (cfv (cv z) F)))) cc0)) $;

--| The continuous nowhere differentiable function ` W ` ( Knopp, K. (1918). Math. Z. 2, 1-26 ) is, in fact, continuous. (Contributed by Asger C. Ipsen, 4-Apr-2021.) (Revised by Asger C. Ipsen, 5-Jul-2021.)
theorem knoppcn {x3 y1 w i n: setvar} (ph: wff x3) (C T: class x3 w i) (F: class x3 y1 n) (N: class w i) (W: class x3 y1 w i n):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wceq F (cmpt y1 cr (cmpt n cn0 (co (co C (cv n) cexp) (cfv (co (co (co c2 N cmul) (cv n) cexp) (cv y1) cmul) T) cmul))) $ >
  $ wceq W (cmpt w cr (csu i cn0 (cfv (cv i) (cfv (cv w) F)))) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wbr (cfv C cabs) c1 clt) $ >
  $ wi ph (wcel W (co cr cc ccncf)) $;

--| Closure theorem for Knopp's function. (Contributed by Asger C. Ipsen, 26-Jul-2021.)
theorem knoppcld {x3 y1 w i n: setvar} (ph: wff x3) (A2: class x3 y1 w i n) (C T: class x3 w i) (F: class x3 y1 n) (N: class w i) (W: class x3 y1 w i n):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wceq F (cmpt y1 cr (cmpt n cn0 (co (co C (cv n) cexp) (cfv (co (co (co c2 N cmul) (cv n) cexp) (cv y1) cmul) T) cmul))) $ >
  $ wceq W (cmpt w cr (csu i cn0 (cfv (cv i) (cfv (cv w) F)))) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wbr (cfv C cabs) c1 clt) $ >
  $ wi ph (wcel (cfv A2 W) cc) $;

--| Lemma for ~ unblimceq0 . (Contributed by Asger C. Ipsen, 12-May-2021.)
theorem unblimceq0lem {x3 y1 b c d: setvar} (ph: wff) (A2 S F: class c):
  $ wi ph (wss S cc) $ >
  $ wi ph (wf S cc F) $ >
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wral b (wral d (wrex x3 (wa (wbr (cfv (co (cv x3) A2 cmin) cabs) (cv d) clt) (wbr (cv b) (cfv (cfv (cv x3) F) cabs) cle)) S) crp) crp) $ >
  $ wi ph (wral c (wral d (wrex y1 (w3a (wne (cv y1) A2) (wbr (cfv (co (cv y1) A2 cmin) cabs) (cv d) clt) (wbr (cv c) (cfv (cfv (cv y1) F) cabs) cle)) S) crp) crp) $;

--| If ` F ` is unbounded near ` A ` it has no limit at ` A ` . (Contributed by Asger C. Ipsen, 12-May-2021.)
theorem unblimceq0 {x3 b d: setvar} (ph: wff) (A2 S F: class):
  $ wi ph (wss S cc) $ >
  $ wi ph (wf S cc F) $ >
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wral b (wral d (wrex x3 (wa (wbr (cfv (co (cv x3) A2 cmin) cabs) (cv d) clt) (wbr (cv b) (cfv (cfv (cv x3) F) cabs) cle)) S) crp) crp) $ >
  $ wi ph (wceq (co F A2 climc) c0) $;

--| If the difference quotient ` ( ( ( F `` z ) - ( F `` A ) ) / ( z - A ) ) ` is unbounded near ` A ` then ` F ` is not differentiable at ` A ` . (Contributed by Asger C. Ipsen, 12-May-2021.)
theorem unbdqndv1 {x3 z b d: setvar} (ph: wff) (A2 S F: class) (G: class z) (X: class):
  $ wceq G (cmpt z (cdif X (csn A2)) (co (co (cfv (cv z) F) (cfv A2 F) cmin) (co (cv z) A2 cmin) cdiv)) $ >
  $ wi ph (wss S cc) $ >
  $ wi ph (wss X S) $ >
  $ wi ph (wf X cc F) $ >
  $ wi ph (wral b (wral d (wrex x3 (wa (wbr (cfv (co (cv x3) A2 cmin) cabs) (cv d) clt) (wbr (cv b) (cfv (cfv (cv x3) G) cabs) cle)) (cdif X (csn A2))) crp) crp) $ >
  $ wi ph (wn (wcel A2 (cdm (co S F cdv)))) $;

--| Lemma for ~ unbdqndv2 . (Contributed by Asger C. Ipsen, 12-May-2021.)
theorem unbdqndv2lem1 (ph: wff) (A2 B2 C D E: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wcel D cc) $ >
  $ wi ph (wcel E crp) $ >
  $ wi ph (wne D cc0) $ >
  $ wi ph (wbr (co c2 E cmul) (cfv (co (co A2 B2 cmin) D cdiv) cabs) cle) $ >
  $ wi ph (wo (wbr (co E (cfv D cabs) cmul) (cfv (co A2 C cmin) cabs) cle) (wbr (co E (cfv D cabs) cmul) (cfv (co B2 C cmin) cabs) cle)) $;

--| Lemma for ~ unbdqndv2 . (Contributed by Asger C. Ipsen, 12-May-2021.)
theorem unbdqndv2lem2 {z: setvar} (ph: wff) (A2 B2: class) (D: class z) (U F: class) (G: class z) (V: class) (W: class z) (X: class):
  $ wceq G (cmpt z (cdif X (csn A2)) (co (co (cfv (cv z) F) (cfv A2 F) cmin) (co (cv z) A2 cmin) cdiv)) $ >
  $ wceq W (cif (wbr (co B2 (co V U cmin) cmul) (cfv (co (cfv U F) (cfv A2 F) cmin) cabs) cle) U V) $ >
  $ wi ph (wss X cr) $ >
  $ wi ph (wf X cc F) $ >
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wcel D crp) $ >
  $ wi ph (wcel U X) $ >
  $ wi ph (wcel V X) $ >
  $ wi ph (wne U V) $ >
  $ wi ph (wbr U A2 cle) $ >
  $ wi ph (wbr A2 V cle) $ >
  $ wi ph (wbr (co V U cmin) D clt) $ >
  $ wi ph (wbr (co c2 B2 cmul) (co (cfv (co (cfv V F) (cfv U F) cmin) cabs) (co V U cmin) cdiv) cle) $ >
  $ wi ph (wa (wcel W (cdif X (csn A2))) (wa (wbr (cfv (co W A2 cmin) cabs) D clt) (wbr B2 (cfv (cfv W G) cabs) cle))) $;

--| Variant of ~ unbdqndv1 with the hypothesis that ` ( ( ( F `` y ) - ( F `` x ) ) / ( y - x ) ) ` is unbounded where ` x <_ A ` and ` A <_ y ` . (Contributed by Asger C. Ipsen, 12-May-2021.)
theorem unbdqndv2 {x3 y1 b d: setvar} (ph: wff) (A2 F X: class):
  $ wi ph (wss X cr) $ >
  $ wi ph (wf X cc F) $ >
  $ wi ph (wral b (wral d (wrex x3 (wrex y1 (w3a (wa (wbr (cv x3) A2 cle) (wbr A2 (cv y1) cle)) (wa (wbr (co (cv y1) (cv x3) cmin) (cv d) clt) (wne (cv x3) (cv y1))) (wbr (cv b) (co (cfv (co (cfv (cv y1) F) (cfv (cv x3) F) cmin) cabs) (co (cv y1) (cv x3) cmin) cdiv) cle)) X) X) crp) crp) $ >
  $ wi ph (wn (wcel A2 (cdm (co cr F cdv)))) $;

--| Lemma for ~ knoppndv . (Contributed by Asger C. Ipsen, 15-Jun-2021.) (Revised by Asger C. Ipsen, 5-Jul-2021.)
theorem knoppndvlem1 (ph: wff) (J M N: class):
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel J cz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel (co (co (co (co c2 N cmul) (cneg J) cexp) c2 cdiv) M cmul) cr) $;

--| Lemma for ~ knoppndv . (Contributed by Asger C. Ipsen, 15-Jun-2021.) (Revised by Asger C. Ipsen, 5-Jul-2021.)
theorem knoppndvlem2 (ph: wff) (I J M N: class):
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel I cz) $ >
  $ wi ph (wcel J cz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wbr J I clt) $ >
  $ wi ph (wcel (co (co (co c2 N cmul) I cexp) (co (co (co (co c2 N cmul) (cneg J) cexp) c2 cdiv) M cmul) cmul) cz) $;

--| Lemma for ~ knoppndv . (Contributed by Asger C. Ipsen, 15-Jun-2021.)
theorem knoppndvlem3 (ph: wff) (C: class):
  $ wi ph (wcel C (co (cneg c1) c1 cioo)) $ >
  $ wi ph (wa (wcel C cr) (wbr (cfv C cabs) c1 clt)) $;

--| Lemma for ~ knoppndv . (Contributed by Asger C. Ipsen, 15-Jun-2021.) (Revised by Asger C. Ipsen, 5-Jul-2021.)
theorem knoppndvlem4 {x3 y1 w i n: setvar} (ph: wff x3) (A2: class x3 y1 w i n) (C T: class x3 w i) (F: class x3 y1 n) (N: class w i) (W: class x3 y1 w i n):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wceq F (cmpt y1 cr (cmpt n cn0 (co (co C (cv n) cexp) (cfv (co (co (co c2 N cmul) (cv n) cexp) (cv y1) cmul) T) cmul))) $ >
  $ wceq W (cmpt w cr (csu i cn0 (cfv (cv i) (cfv (cv w) F)))) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel C (co (cneg c1) c1 cioo)) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr (cseq caddc (cfv A2 F) cc0) (cfv A2 W) cli) $;

--| Lemma for ~ knoppndv . (Contributed by Asger C. Ipsen, 15-Jun-2021.) (Revised by Asger C. Ipsen, 5-Jul-2021.)
theorem knoppndvlem5 {x3 y1 i n: setvar} (ph: wff x3) (A2: class i) (C T: class x3 i) (F: class x3 y1 i n) (J: class x3) (N: class i):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wceq F (cmpt y1 cr (cmpt n cn0 (co (co C (cv n) cexp) (cfv (co (co (co c2 N cmul) (cv n) cexp) (cv y1) cmul) T) cmul))) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel (csu i (co cc0 J cfz) (cfv (cv i) (cfv A2 F))) cr) $;

--| Lemma for ~ knoppndv . (Contributed by Asger C. Ipsen, 15-Jun-2021.) (Revised by Asger C. Ipsen, 5-Jul-2021.)
theorem knoppndvlem6 {x3 y1 w i n: setvar} (ph: wff x3) (A2: class) (C T: class x3 w i) (F: class x3 y1 n) (J: class x3 w) (M: class x3 y1 w i n) (N: class w i) (W: class x3 y1 w i n):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wceq F (cmpt y1 cr (cmpt n cn0 (co (co C (cv n) cexp) (cfv (co (co (co c2 N cmul) (cv n) cexp) (cv y1) cmul) T) cmul))) $ >
  $ wceq W (cmpt w cr (csu i cn0 (cfv (cv i) (cfv (cv w) F)))) $ >
  $ wceq A2 (co (co (co (co c2 N cmul) (cneg J) cexp) c2 cdiv) M cmul) $ >
  $ wi ph (wcel C (co (cneg c1) c1 cioo)) $ >
  $ wi ph (wcel J cn0) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wceq (cfv A2 W) (csu i (co cc0 J cfz) (cfv (cv i) (cfv A2 F)))) $;

--| Lemma for ~ knoppndv . (Contributed by Asger C. Ipsen, 15-Jun-2021.) (Revised by Asger C. Ipsen, 5-Jul-2021.)
theorem knoppndvlem7 {x3 y1 n: setvar} (ph: wff x3) (A2 C T: class x3) (F: class x3 y1 n) (J: class x3 y1) (M: class x3 y1 n) (N: class x3):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wceq F (cmpt y1 cr (cmpt n cn0 (co (co C (cv n) cexp) (cfv (co (co (co c2 N cmul) (cv n) cexp) (cv y1) cmul) T) cmul))) $ >
  $ wceq A2 (co (co (co (co c2 N cmul) (cneg J) cexp) c2 cdiv) M cmul) $ >
  $ wi ph (wcel J cn0) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wceq (cfv J (cfv A2 F)) (co (co C J cexp) (cfv (co M c2 cdiv) T) cmul)) $;

--| Lemma for ~ knoppndv . (Contributed by Asger C. Ipsen, 15-Jun-2021.) (Revised by Asger C. Ipsen, 5-Jul-2021.)
theorem knoppndvlem8 {x3 y1 n: setvar} (ph: wff x3) (A2 C T: class x3) (F: class x3 y1 n) (J: class x3 y1) (M: class y1 n) (N: class x3):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wceq F (cmpt y1 cr (cmpt n cn0 (co (co C (cv n) cexp) (cfv (co (co (co c2 N cmul) (cv n) cexp) (cv y1) cmul) T) cmul))) $ >
  $ wceq A2 (co (co (co (co c2 N cmul) (cneg J) cexp) c2 cdiv) M cmul) $ >
  $ wi ph (wcel C (co (cneg c1) c1 cioo)) $ >
  $ wi ph (wcel J cn0) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr c2 M cdvds) $ >
  $ wi ph (wceq (cfv J (cfv A2 F)) cc0) $;

--| Lemma for ~ knoppndv . (Contributed by Asger C. Ipsen, 15-Jun-2021.) (Revised by Asger C. Ipsen, 5-Jul-2021.)
theorem knoppndvlem9 {x3 y1 n: setvar} (ph: wff x3) (A2 C T: class x3) (F: class x3 y1 n) (J: class x3 y1) (M: class x3 y1 n) (N: class x3):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wceq F (cmpt y1 cr (cmpt n cn0 (co (co C (cv n) cexp) (cfv (co (co (co c2 N cmul) (cv n) cexp) (cv y1) cmul) T) cmul))) $ >
  $ wceq A2 (co (co (co (co c2 N cmul) (cneg J) cexp) c2 cdiv) M cmul) $ >
  $ wi ph (wcel C (co (cneg c1) c1 cioo)) $ >
  $ wi ph (wcel J cn0) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wn (wbr c2 M cdvds)) $ >
  $ wi ph (wceq (cfv J (cfv A2 F)) (co (co C J cexp) c2 cdiv)) $;

--| Lemma for ~ knoppndv . (Contributed by Asger C. Ipsen, 15-Jun-2021.) (Revised by Asger C. Ipsen, 5-Jul-2021.)
theorem knoppndvlem10 {x3 y1 n: setvar} (ph: wff x3) (A2 B2: class) (C T: class x3) (F: class x3 y1 n) (J: class y1) (M N: class):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wceq F (cmpt y1 cr (cmpt n cn0 (co (co C (cv n) cexp) (cfv (co (co (co c2 N cmul) (cv n) cexp) (cv y1) cmul) T) cmul))) $ >
  $ wceq A2 (co (co (co (co c2 N cmul) (cneg J) cexp) c2 cdiv) M cmul) $ >
  $ wceq B2 (co (co (co (co c2 N cmul) (cneg J) cexp) c2 cdiv) (co M c1 caddc) cmul) $ >
  $ wi ph (wcel C (co (cneg c1) c1 cioo)) $ >
  $ wi ph (wcel J cn0) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wceq (cfv (co (cfv J (cfv B2 F)) (cfv J (cfv A2 F)) cmin) cabs) (co (co (cfv C cabs) J cexp) c2 cdiv)) $;

--| Lemma for ~ knoppndv . (Contributed by Asger C. Ipsen, 28-Jun-2021.) (Revised by Asger C. Ipsen, 5-Jul-2021.)
theorem knoppndvlem11 {x3 y1 i n: setvar} (ph: wff x3) (A2 B2: class) (C T: class x3 i) (F: class x3 y1 i n) (J: class x3) (N: class i):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wceq F (cmpt y1 cr (cmpt n cn0 (co (co C (cv n) cexp) (cfv (co (co (co c2 N cmul) (cv n) cexp) (cv y1) cmul) T) cmul))) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C (co (cneg c1) c1 cioo)) $ >
  $ wi ph (wcel J cn0) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr (cfv (co (csu i (co cc0 (co J c1 cmin) cfz) (cfv (cv i) (cfv B2 F))) (csu i (co cc0 (co J c1 cmin) cfz) (cfv (cv i) (cfv A2 F))) cmin) cabs) (co (cfv (co B2 A2 cmin) cabs) (csu i (co cc0 (co J c1 cmin) cfz) (co (co (co c2 N cmul) (cfv C cabs) cmul) (cv i) cexp)) cmul) cle) $;

--| Lemma for ~ knoppndv . (Contributed by Asger C. Ipsen, 29-Jun-2021.) (Revised by Asger C. Ipsen, 5-Jul-2021.)
theorem knoppndvlem12 (ph: wff) (C N: class):
  $ wi ph (wcel C (co (cneg c1) c1 cioo)) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr c1 (co N (cfv C cabs) cmul) clt) $ >
  $ wi ph (wa (wne (co (co c2 N cmul) (cfv C cabs) cmul) c1) (wbr c1 (co (co (co c2 N cmul) (cfv C cabs) cmul) c1 cmin) clt)) $;

--| Lemma for ~ knoppndv . (Contributed by Asger C. Ipsen, 1-Jul-2021.) (Revised by Asger C. Ipsen, 5-Jul-2021.)
theorem knoppndvlem13 (ph: wff) (C N: class):
  $ wi ph (wcel C (co (cneg c1) c1 cioo)) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr c1 (co N (cfv C cabs) cmul) clt) $ >
  $ wi ph (wne C cc0) $;

--| Lemma for ~ knoppndv . (Contributed by Asger C. Ipsen, 1-Jul-2021.) (Revised by Asger C. Ipsen, 7-Jul-2021.)
theorem knoppndvlem14 {x3 y1 i n: setvar} (ph: wff x3) (A2 B2: class) (C: class x3) (T: class x3 i) (F: class x3 y1 i n) (J: class x3) (M: class x3 y1 i n) (N: class):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wceq F (cmpt y1 cr (cmpt n cn0 (co (co C (cv n) cexp) (cfv (co (co (co c2 N cmul) (cv n) cexp) (cv y1) cmul) T) cmul))) $ >
  $ wceq A2 (co (co (co (co c2 N cmul) (cneg J) cexp) c2 cdiv) M cmul) $ >
  $ wceq B2 (co (co (co (co c2 N cmul) (cneg J) cexp) c2 cdiv) (co M c1 caddc) cmul) $ >
  $ wi ph (wcel C (co (cneg c1) c1 cioo)) $ >
  $ wi ph (wcel J cn0) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr c1 (co N (cfv C cabs) cmul) clt) $ >
  $ wi ph (wbr (cfv (co (csu i (co cc0 (co J c1 cmin) cfz) (cfv (cv i) (cfv B2 F))) (csu i (co cc0 (co J c1 cmin) cfz) (cfv (cv i) (cfv A2 F))) cmin) cabs) (co (co (co (cfv C cabs) J cexp) c2 cdiv) (co c1 (co (co (co c2 N cmul) (cfv C cabs) cmul) c1 cmin) cdiv) cmul) cle) $;

--| Lemma for ~ knoppndv . (Contributed by Asger C. Ipsen, 6-Jul-2021.)
theorem knoppndvlem15 {x3 y1 w i n: setvar} (ph: wff x3) (A2 B2: class) (C: class x3 w) (T: class x3 w i) (F: class x3 y1 n) (J: class w) (M: class w i) (N: class w) (W: class x3 y1 w i n):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wceq F (cmpt y1 cr (cmpt n cn0 (co (co C (cv n) cexp) (cfv (co (co (co c2 N cmul) (cv n) cexp) (cv y1) cmul) T) cmul))) $ >
  $ wceq W (cmpt w cr (csu i cn0 (cfv (cv i) (cfv (cv w) F)))) $ >
  $ wceq A2 (co (co (co (co c2 N cmul) (cneg J) cexp) c2 cdiv) M cmul) $ >
  $ wceq B2 (co (co (co (co c2 N cmul) (cneg J) cexp) c2 cdiv) (co M c1 caddc) cmul) $ >
  $ wi ph (wcel C (co (cneg c1) c1 cioo)) $ >
  $ wi ph (wcel J cn0) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr c1 (co N (cfv C cabs) cmul) clt) $ >
  $ wi ph (wbr (co (co (co (cfv C cabs) J cexp) c2 cdiv) (co c1 (co c1 (co (co (co c2 N cmul) (cfv C cabs) cmul) c1 cmin) cdiv) cmin) cmul) (cfv (co (cfv B2 W) (cfv A2 W) cmin) cabs) cle) $;

--| Lemma for ~ knoppndv . (Contributed by Asger C. Ipsen, 19-Jul-2021.)
theorem knoppndvlem16 (ph: wff) (A2 B2 J M N: class):
  $ wceq A2 (co (co (co (co c2 N cmul) (cneg J) cexp) c2 cdiv) M cmul) $ >
  $ wceq B2 (co (co (co (co c2 N cmul) (cneg J) cexp) c2 cdiv) (co M c1 caddc) cmul) $ >
  $ wi ph (wcel J cn0) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wceq (co B2 A2 cmin) (co (co (co c2 N cmul) (cneg J) cexp) c2 cdiv)) $;

--| Lemma for ~ knoppndv . (Contributed by Asger C. Ipsen, 12-Aug-2021.)
theorem knoppndvlem17 {x3 y1 w i n: setvar} (ph: wff x3) (A2 B2: class) (C: class x3 w) (T: class x3 w i) (F: class x3 y1 n) (J: class w) (M: class w i) (N: class w) (W: class x3 y1 w i n):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wceq F (cmpt y1 cr (cmpt n cn0 (co (co C (cv n) cexp) (cfv (co (co (co c2 N cmul) (cv n) cexp) (cv y1) cmul) T) cmul))) $ >
  $ wceq W (cmpt w cr (csu i cn0 (cfv (cv i) (cfv (cv w) F)))) $ >
  $ wceq A2 (co (co (co (co c2 N cmul) (cneg J) cexp) c2 cdiv) M cmul) $ >
  $ wceq B2 (co (co (co (co c2 N cmul) (cneg J) cexp) c2 cdiv) (co M c1 caddc) cmul) $ >
  $ wi ph (wcel C (co (cneg c1) c1 cioo)) $ >
  $ wi ph (wcel J cn0) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr c1 (co N (cfv C cabs) cmul) clt) $ >
  $ wi ph (wbr (co (co (co (co c2 N cmul) (cfv C cabs) cmul) J cexp) (co c1 (co c1 (co (co (co c2 N cmul) (cfv C cabs) cmul) c1 cmin) cdiv) cmin) cmul) (co (cfv (co (cfv B2 W) (cfv A2 W) cmin) cabs) (co B2 A2 cmin) cdiv) cle) $;

--| Lemma for ~ knoppndv . (Contributed by Asger C. Ipsen, 14-Aug-2021.)
theorem knoppndvlem18 {j: setvar} (ph: wff) (C D E G N: class):
  $ wi ph (wcel C (co (cneg c1) c1 cioo)) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel D crp) $ >
  $ wi ph (wcel E crp) $ >
  $ wi ph (wcel G crp) $ >
  $ wi ph (wbr c1 (co N (cfv C cabs) cmul) clt) $ >
  $ wi ph (wrex j (wa (wbr (co (co (co c2 N cmul) (cneg (cv j)) cexp) c2 cdiv) D clt) (wbr E (co (co (co (co c2 N cmul) (cfv C cabs) cmul) (cv j) cexp) G cmul) cle)) cn0) $;

--| Lemma for ~ knoppndv . (Contributed by Asger C. Ipsen, 17-Aug-2021.)
theorem knoppndvlem19 {m: setvar} (ph: wff) (A2 B2: class m) (H J N: class):
  $ wceq A2 (co (co (co (co c2 N cmul) (cneg J) cexp) c2 cdiv) (cv m) cmul) $ >
  $ wceq B2 (co (co (co (co c2 N cmul) (cneg J) cexp) c2 cdiv) (co (cv m) c1 caddc) cmul) $ >
  $ wi ph (wcel J cn0) $ >
  $ wi ph (wcel H cr) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wrex m (wa (wbr A2 H cle) (wbr H B2 cle)) cz) $;

--| Lemma for ~ knoppndv . (Contributed by Asger C. Ipsen, 18-Aug-2021.)
theorem knoppndvlem20 (ph: wff) (C N: class):
  $ wi ph (wcel C (co (cneg c1) c1 cioo)) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr c1 (co N (cfv C cabs) cmul) clt) $ >
  $ wi ph (wcel (co c1 (co c1 (co (co (co c2 N cmul) (cfv C cabs) cmul) c1 cmin) cdiv) cmin) crp) $;

--| Lemma for ~ knoppndv . (Contributed by Asger C. Ipsen, 18-Aug-2021.)
theorem knoppndvlem21 {x3 y1 w i n a b: setvar} (ph: wff x3 a b) (C: class x3 w a b) (D: class x3 y1 w i n) (T: class x3 w i a b) (E: class x3 y1 w i n) (F: class x3 y1 n a b) (G: class x3 y1 w i n a b) (H: class x3 y1 w i n) (J N: class) (W: class x3 y1 w i n):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wceq F (cmpt y1 cr (cmpt n cn0 (co (co C (cv n) cexp) (cfv (co (co (co c2 N cmul) (cv n) cexp) (cv y1) cmul) T) cmul))) $ >
  $ wceq W (cmpt w cr (csu i cn0 (cfv (cv i) (cfv (cv w) F)))) $ >
  $ wceq G (co c1 (co c1 (co (co (co c2 N cmul) (cfv C cabs) cmul) c1 cmin) cdiv) cmin) $ >
  $ wi ph (wcel C (co (cneg c1) c1 cioo)) $ >
  $ wi ph (wcel D crp) $ >
  $ wi ph (wcel E crp) $ >
  $ wi ph (wcel H cr) $ >
  $ wi ph (wcel J cn0) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr c1 (co N (cfv C cabs) cmul) clt) $ >
  $ wi ph (wbr (co (co (co c2 N cmul) (cneg J) cexp) c2 cdiv) D clt) $ >
  $ wi ph (wbr E (co (co (co (co c2 N cmul) (cfv C cabs) cmul) J cexp) G cmul) cle) $ >
  $ wi ph (wrex a (wrex b (w3a (wa (wbr (cv a) H cle) (wbr H (cv b) cle)) (wa (wbr (co (cv b) (cv a) cmin) D clt) (wne (cv a) (cv b))) (wbr E (co (cfv (co (cfv (cv b) W) (cfv (cv a) W) cmin) cabs) (co (cv b) (cv a) cmin) cdiv) cle)) cr) cr) $;

--| Lemma for ~ knoppndv . (Contributed by Asger C. Ipsen, 19-Aug-2021.)
theorem knoppndvlem22 {x3 y1 w i n a b: setvar} (ph: wff x3 a b) (C: class x3 a b) (D: class x3) (T: class x3 w i a b) (E: class x3) (F: class x3 y1 n a b) (H: class x3 y1 w i n) (N: class) (W: class x3 y1 w i n):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wceq F (cmpt y1 cr (cmpt n cn0 (co (co C (cv n) cexp) (cfv (co (co (co c2 N cmul) (cv n) cexp) (cv y1) cmul) T) cmul))) $ >
  $ wceq W (cmpt w cr (csu i cn0 (cfv (cv i) (cfv (cv w) F)))) $ >
  $ wi ph (wcel C (co (cneg c1) c1 cioo)) $ >
  $ wi ph (wcel D crp) $ >
  $ wi ph (wcel E crp) $ >
  $ wi ph (wcel H cr) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr c1 (co N (cfv C cabs) cmul) clt) $ >
  $ wi ph (wrex a (wrex b (w3a (wa (wbr (cv a) H cle) (wbr H (cv b) cle)) (wa (wbr (co (cv b) (cv a) cmin) D clt) (wne (cv a) (cv b))) (wbr E (co (cfv (co (cfv (cv b) W) (cfv (cv a) W) cmin) cabs) (co (cv b) (cv a) cmin) cdiv) cle)) cr) cr) $;

--| The continuous nowhere differentiable function ` W ` ( Knopp, K. (1918). Math. Z. 2, 1-26 ) is, in fact, nowhere differentiable. (Contributed by Asger C. Ipsen, 19-Aug-2021.)
theorem knoppndv {x3 y1 w i n: setvar} (ph: wff x3) (C: class x3) (T: class x3 w i) (F: class x3 y1 n) (N: class) (W: class x3 y1 w i n):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wceq F (cmpt y1 cr (cmpt n cn0 (co (co C (cv n) cexp) (cfv (co (co (co c2 N cmul) (cv n) cexp) (cv y1) cmul) T) cmul))) $ >
  $ wceq W (cmpt w cr (csu i cn0 (cfv (cv i) (cfv (cv w) F)))) $ >
  $ wi ph (wcel C (co (cneg c1) c1 cioo)) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr c1 (co N (cfv C cabs) cmul) clt) $ >
  $ wi ph (wceq (cdm (co cr W cdv)) c0) $;

--| Knopp's function is a function. (Contributed by Asger C. Ipsen, 25-Aug-2021.)
theorem knoppf {x3 y1 w i n: setvar} (ph: wff x3) (C T: class x3 w i) (F: class x3 y1 n) (N: class w i) (W: class x3 y1 w i n):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wceq F (cmpt y1 cr (cmpt n cn0 (co (co C (cv n) cexp) (cfv (co (co (co c2 N cmul) (cv n) cexp) (cv y1) cmul) T) cmul))) $ >
  $ wceq W (cmpt w cr (csu i cn0 (cfv (cv i) (cfv (cv w) F)))) $ >
  $ wi ph (wcel C (co (cneg c1) c1 cioo)) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wf cr cr W) $;

--| Variant of ~ knoppcn with different codomain. (Contributed by Asger C. Ipsen, 25-Aug-2021.)
theorem knoppcn2 {x3 y1 w i n: setvar} (ph: wff x3) (C T: class x3 w i) (F: class x3 y1 n) (N: class w i) (W: class x3 y1 w i n):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wceq F (cmpt y1 cr (cmpt n cn0 (co (co C (cv n) cexp) (cfv (co (co (co c2 N cmul) (cv n) cexp) (cv y1) cmul) T) cmul))) $ >
  $ wceq W (cmpt w cr (csu i cn0 (cfv (cv i) (cfv (cv w) F)))) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel C (co (cneg c1) c1 cioo)) $ >
  $ wi ph (wcel W (co cr cr ccncf)) $;

--| Lemma for ~ cnndv . (Contributed by Asger C. Ipsen, 25-Aug-2021.)
theorem cnndvlem1 {x3 y1 w i n: setvar} (T: class x3 w i) (F: class x3 y1 n) (W: class x3 y1 w i n):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wceq F (cmpt y1 cr (cmpt n cn0 (co (co (co c1 c2 cdiv) (cv n) cexp) (cfv (co (co (co c2 c3 cmul) (cv n) cexp) (cv y1) cmul) T) cmul))) $ >
  $ wceq W (cmpt w cr (csu i cn0 (cfv (cv i) (cfv (cv w) F)))) $ >
  $ wa (wcel W (co cr cr ccncf)) (wceq (cdm (co cr W cdv)) c0) $;

--| Lemma for ~ cnndv . (Contributed by Asger C. Ipsen, 26-Aug-2021.)
theorem cnndvlem2 {x3 y1 w f2 i n: setvar} (T: class x3 w f2 i) (F: class x3 y1 f2 n) (W: class x3 y1 w i n):
  $ wceq T (cmpt x3 cr (cfv (co (cfv (co (cv x3) (co c1 c2 cdiv) caddc) cfl) (cv x3) cmin) cabs)) $ >
  $ wceq F (cmpt y1 cr (cmpt n cn0 (co (co (co c1 c2 cdiv) (cv n) cexp) (cfv (co (co (co c2 c3 cmul) (cv n) cexp) (cv y1) cmul) T) cmul))) $ >
  $ wceq W (cmpt w cr (csu i cn0 (cfv (cv i) (cfv (cv w) F)))) $ >
  $ wex f2 (wa (wcel (cv f2) (co cr cr ccncf)) (wceq (cdm (co cr (cv f2) cdv)) c0)) $;

--| There exists a continuous nowhere differentiable function. The result follows directly from ~ knoppcn and ~ knoppndv . (Contributed by Asger C. Ipsen, 26-Aug-2021.)
theorem cnndv {f2: setvar}:
  $ wex f2 (wa (wcel (cv f2) (co cr cr ccncf)) (wceq (cdm (co cr (cv f2) cdv)) c0)) $;

--| A double _modus ponens_ inference. Inference associated with ~ mpd . (Contributed by BJ, 24-Sep-2019.)
theorem bj_mp2c (ph ps ch: wff):
  $ wi ph (wi ps ch) $ >
  $ wi ph ps $ >
  $ ph $ >
  $ ch $;

--| A double _modus ponens_ inference. Inference associated with ~ mpcom . (Contributed by BJ, 24-Sep-2019.)
theorem bj_mp2d (ph ps ch: wff):
  $ wi ps (wi ph ch) $ >
  $ wi ph ps $ >
  $ ph $ >
  $ ch $;

--| In this proof, the use of the syntactic theorem ~ bj-0 allows to reduce the total length by one (non-essential) step. See also the section comment and the comment of ~ bj-0 . Since ~ bj-0 is used in a non-essential step, this use does not appear on this webpage (but the present theorem appears on the webpage for ~ bj-0 as a theorem referencing it). The full proof reads $= wph wps wch bj-0 id $. (while, without using ~ bj-0 , it would read $= wph wps wi wch wi id $.). Now we explain why syntactic theorems are not useful in set.mm. Suppose that the syntactic theorem thm-0 proves that PHI is a well-formed formula, and that thm-0 is used to shorten the proof of thm-1. Assume that PHI does have proper non-atomic subformulas (which is not the case of the formula proved by ~ weq or ~ wel ). Then, the proof of thm-1 does not construct all the proper non-atomic subformulas of PHI (if it did, then using thm-0 would not shorten it). Therefore, thm-1 is a special instance of a more general theorem with essentially the same proof. In the present case, ~ bj-1 is a special instance of ~ id . (Contributed by BJ, 24-Sep-2019.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_1 (ph ps ch: wff):
  $ wi (wi (wi ph ps) ch) (wi (wi ph ps) ch) $;

--| Inference associated with "pon", ~ pm2.27 . Its associated inference is ~ ax-mp . (Contributed by BJ, 30-Jul-2024.)
theorem bj_poni (ph ps: wff):
  $ ph $ >
  $ wi (wi ph ps) ps $;

--| When ` F. ` is substituted for ` ps ` , this formula is the Clavius law with a doubly negated consequent, which is therefore a minimalistic tautology. Notice the non-intuitionistic proof from ~ peirce and ~ pm2.27 chained using ~ syl . (Contributed by BJ, 4-Dec-2023.)
theorem bj_nnclav (ph ps: wff):
  $ wi (wi (wi ph ps) ph) (wi (wi ph ps) ps) $;

--| Inference associated with ~ bj-nnclav . Its associated inference is an instance of ~ syl . Notice the non-intuitionistic proof from ~ bj-peircei and ~ bj-poni . (Contributed by BJ, 30-Jul-2024.)
theorem bj_nnclavi (ph ps: wff):
  $ wi (wi ph ps) ph $ >
  $ wi (wi ph ps) ps $;

--| Commuted form of ~ bj-nnclav . Notice the non-intuitionistic proof from ~ bj-peircei and ~ imim1i . (Contributed by BJ, 30-Jul-2024.) A proof which is shorter when compressed uses ~ embantd . (Proof modification is discouraged.)
theorem bj_nnclavc (ph ps: wff):
  $ wi (wi ph ps) (wi (wi (wi ph ps) ph) ps) $;

--| Inference associated with ~ bj-nnclavc . Its associated inference is an instance of ~ syl . Notice the non-intuitionistic proof from ~ peirce and ~ syl . (Contributed by BJ, 30-Jul-2024.)
theorem bj_nnclavci (ph ps: wff):
  $ wi ph ps $ >
  $ wi (wi (wi ph ps) ph) ps $;

--| Inference associated with ~ jarri . Contrary to it, it does not require ~ ax-2 , but only ~ ax-mp and ~ ax-1 . (Contributed by BJ, 29-Mar-2020.) (Proof modification is discouraged.)
theorem bj_jarrii (ph ps ch: wff):
  $ wi (wi ph ps) ch $ >
  $ ps $ >
  $ ch $;

--| The propositional function ` ( ph -> ( . -> ps ) ) ` is decreasing. (Contributed by BJ, 19-Jul-2019.)
theorem bj_imim21 (ph ps ch th: wff):
  $ wi (wi ph ps) (wi (wi ch (wi ps th)) (wi ch (wi ph th))) $;

--| The propositional function ` ( ph -> ( . -> ps ) ) ` is decreasing. Its associated inference is ~ syl5 . (Contributed by BJ, 19-Jul-2019.)
theorem bj_imim21i (ph ps ch th: wff):
  $ wi ph ps $ >
  $ wi (wi ch (wi ps th)) (wi ch (wi ph th)) $;

--| The propositional function ` ( ( . -> ph ) -> ps ) ` is increasing. (Contributed by BJ, 3-Apr-2026.)
theorem bj_imim11 (ph ps ch th: wff):
  $ wi (wi ph ps) (wi (wi (wi ph ch) th) (wi (wi ps ch) th)) $;

--| The propositional function ` ( ( . -> ph ) -> ps ) ` is increasing. Its associated inference is ~ wl-syls2 . (Contributed by BJ, 3-Apr-2026.)
theorem bj_imim11i (ph ps ch th: wff):
  $ wi ph ps $ >
  $ wi (wi (wi ph ch) th) (wi (wi ps ch) th) $;

--| Over minimal implicational calculus, Peirce's law implies the double negation of the stability of any formula (that is the interpretation when ` F. ` is substituted for ` ps ` and for ` ch ` ). Therefore, the double negation of the stability of any formula is provable in classical refutability calculus. It is also provable in intuitionistic calculus (see iset.mm/bj-nnst) but it is not provable in minimal calculus (see ~ bj-stabpeirce ). (Contributed by BJ, 30-Nov-2023.) Axiom ~ ax-3 is only used through Peirce's law ~ peirce . (Proof modification is discouraged.)
theorem bj_peircestab (ph ps ch: wff):
  $ wi (wi (wi (wi (wi ph ps) ch) ph) ch) ch $;

--| This minimal implicational calculus tautology is used in the following argument: When ` ph , ps , ch , th , ta ` are replaced respectively by ` ( ph -> F. ) , F. , ph , F. , F. ` , the antecedent becomes ` -. -. ( -. -. ph -> ph ) ` , that is, the double negation of the stability of ` ph ` . If that statement were provable in minimal calculus, then, since ` F. ` plays no particular role in minimal calculus, also the statement with ` ps ` in place of ` F. ` would be provable. The corresponding consequent is ` ( ( ( ps -> ph ) -> ps ) -> ps ) ` , that is, the non-intuitionistic Peirce law. Therefore, the double negation of the stability of any formula is not provable in minimal calculus. However, it is provable both in intuitionistic calculus (see iset.mm/bj-nnst) and in classical refutability calculus (see ~ bj-peircestab ). (Contributed by BJ, 30-Nov-2023.) (Revised by BJ, 30-Jul-2024.) (Proof modification is discouraged.)
theorem bj_stabpeirce (ph ps ch th ta: wff):
  $ wi (wi (wi (wi (wi ph ps) ch) th) ta) (wi (wi (wi ps ch) th) ta) $;

--| Implication from equivalence with a conjunct. Its associated inference is ~ simplbi . (Contributed by BJ, 20-Mar-2026.)
theorem bj_bisimpl (ph ps ch: wff):
  $ wi (wb ph (wa ps ch)) (wi ph ps) $;

--| Implication from equivalence with a conjunct. Its associated inference is ~ simprbi . (Contributed by BJ, 20-Mar-2026.)
theorem bj_bisimpr (ph ps ch: wff):
  $ wi (wb ph (wa ps ch)) (wi ph ch) $;

--| A mixed syllogism inference derived from ~ imbitrdi . Shortens ~ bj-dvelimdv1 , ~ alexsubALTlem4 (4821>4812), ~ supsrlem (2868>2863). (Contributed by BJ, 20-Oct-2021.)
theorem bj_syl66ib (ph ps ch th ta: wff):
  $ wi ph (wi ps th) $ >
  $ wi th ta $ >
  $ wb ta ch $ >
  $ wi ph (wi ps ch) $;

--| Proof of ~ orim2 from the axiomatic definition of disjunction ( ~ olc , ~ orc , ~ jao ) and minimal implicational calculus. (Contributed by BJ, 4-Apr-2021.) (Proof modification is discouraged.)
theorem bj_orim2 (ph ps ch: wff):
  $ wi (wi ph ps) (wi (wo ch ph) (wo ch ps)) $;

--| Curry's axiom ~ curryax (a non-intuitionistic positive statement sometimes called a paradox of material implication) implies Peirce's axiom ~ peirce over minimal implicational calculus and the axiomatic definition of disjunction (actually, only the elimination axiom ~ jao via its inference form ~ jaoi ; the introduction axioms ~ olc and ~ orc are not needed). This theorem shows that actually, the standard instance of ~ curryax implies the standard instance of ~ peirce , which is not the case for the converse ~ bj-peircecurry . (Contributed by BJ, 15-Jun-2021.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_currypeirce (ph ps: wff):
  $ wi (wo ph (wi ph ps)) (wi (wi (wi ph ps) ph) ph) $;

--| Peirce's axiom ~ peirce implies Curry's axiom ~ curryax over minimal implicational calculus and the axiomatic definition of disjunction (actually, only the introduction axioms ~ olc and ~ orc ; the elimination axiom ~ jao is not needed). See ~ bj-currypeirce for the converse. (Contributed by BJ, 15-Jun-2021.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_peircecurry (ph ps: wff):
  $ wo ph (wi ph ps) $;

--| Conjunction in terms of implication and biconditional. The proof is intuitionistic (use of ~ ax-3 comes from the unusual definition of the biconditional in set.mm). (Contributed by BJ, 23-Sep-2023.)
theorem bj_animbi (ph ps: wff):
  $ wb (wa ph ps) (wb ph (wi ph ps)) $;

--| Curry's paradox. The proof is intuitionistic (use of ~ ax-3 comes from the unusual definition of the biconditional in set.mm). The paradox comes from the case where ` ph ` is the self-referential sentence "If this sentence is true, then ` ps ` ", so that one can prove everything. Therefore, a consistent system cannot allow the formation of such self-referential sentences. This has lead to the study of logics rejecting contraction ~ pm2.43 , such as affine logic and linear logic. (Contributed by BJ, 23-Sep-2023.) (Proof modification is discouraged.)
theorem bj_currypara (ph ps: wff):
  $ wi (wb ph (wi ph ps)) ps $;

--| A commuted form of the contrapositive, true in minimal calculus. (Contributed by BJ, 19-Mar-2020.)
theorem bj_con2com (ph ps: wff):
  $ wi ph (wi (wi ps (wn ph)) (wn ps)) $;

--| Inference associated with ~ bj-con2com . Its associated inference is ~ mt2 . TODO: when in the main part, add to ~ mt2 that it is the inference associated with ~ bj-con2comi . (Contributed by BJ, 19-Mar-2020.)
theorem bj_con2comi (ph ps: wff):
  $ ph $ >
  $ wi (wi ps (wn ph)) (wn ps) $;

--| If a formula is true, then it does not imply its negation. (Contributed by BJ, 19-Mar-2020.) A shorter proof is possible using ~ id and ~ jc , however, the present proof uses theorems that are more basic than ~ jc . (Proof modification is discouraged.)
theorem bj_nimn (ph: wff):
  $ wi ph (wn (wi ph (wn ph))) $;

--| Inference associated with ~ bj-nimn . (Contributed by BJ, 19-Mar-2020.)
theorem bj_nimni (ph: wff):
  $ ph $ >
  $ wn (wi ph (wn ph)) $;

--| Inference associated with ~ peirce . (Contributed by BJ, 30-Mar-2020.)
theorem bj_peircei (ph ps: wff):
  $ wi (wi ph ps) ph $ >
  $ ph $;

--| Inference associated with ~ looinv . Its associated inference is ~ bj-looinvii . (Contributed by BJ, 30-Mar-2020.)
theorem bj_looinvi (ph ps: wff):
  $ wi (wi ph ps) ps $ >
  $ wi (wi ps ph) ph $;

--| Inference associated with ~ bj-looinvi . (Contributed by BJ, 30-Mar-2020.)
theorem bj_looinvii (ph ps: wff):
  $ wi (wi ph ps) ps $ >
  $ wi ps ph $ >
  $ ph $;

--| Version of ~ mt2 where the major premise is a biconditional. Shortens ~ fal (see ~ bj-fal ) . Another proof is also possible via ~ con2bii and ~ mpbi . The current ~ mt2bi should be relabeled, maybe to imfal. (Contributed by BJ, 5-Oct-2024.)
theorem bj_mt2bi (ph ps: wff):
  $ wb ps (wn ph) $ >
  $ ph $ >
  $ wn ps $;

--| Shortening of ~ fal using ~ bj-mt2bi . (Contributed by Anthony Hart, 22-Oct-2010.) (Proof shortened by Mel L. O'Cat, 11-Mar-2012.) (Proof modification is discouraged.)
theorem bj_fal:
  $ wn wfal $;

--| The negation of a theorem is equivalent to false. Shortens ~ dfnul2 (see ~ bj-dfnul2 ). (Contributed by BJ, 5-Oct-2024.)
theorem bj_ntrufal (ph: wff):
  $ ph $ >
  $ wb (wn ph) wfal $;

--| Alternate definition of the empty set. Definition 5.14 of [TakeutiZaring] p. 20. (Contributed by NM, 26-Dec-1996.) Remove dependency on ~ ax-10 , ~ ax-11 , and ~ ax-12 . (Revised by Steven Nguyen, 3-May-2023.) (Proof shortened by BJ, 23-Sep-2024.) (Proof modification is discouraged.)
theorem bj_dfnul2 {x3: setvar}:
  $ wceq c0 (cab x3 (wn (wceq (cv x3) (cv x3)))) $;

--| Shortens ~ orfa2 (58>53), ~ pm1.2 (20>18), ~ pm1.2 (20>18), ~ pm2.4 (31>25), ~ pm2.41 (31>25), ~ pm2.42 (38>32), ~ pm3.2ni (43>39), ~ pm4.44 (55>51). (Contributed by BJ, 30-Sep-2019.)
theorem bj_jaoi1 (ph ps: wff):
  $ wi ph ps $ >
  $ wi (wo ph ps) ps $;

--| Shortens ~ consensus (110>106), ~ elnn0z (336>329), ~ pm1.2 (20>19), ~ pm3.2ni (43>39), ~ pm4.44 (55>51). (Contributed by BJ, 30-Sep-2019.)
theorem bj_jaoi2 (ph ps: wff):
  $ wi ph ps $ >
  $ wi (wo ps ph) ps $;

--| Alternate definition of the biconditional. (Contributed by BJ, 4-Oct-2019.)
theorem bj_dfbi4 (ph ps: wff):
  $ wb (wb ph ps) (wo (wa ph ps) (wn (wo ph ps))) $;

--| Alternate definition of the biconditional. (Contributed by BJ, 4-Oct-2019.)
theorem bj_dfbi5 (ph ps: wff):
  $ wb (wb ph ps) (wi (wo ph ps) (wa ph ps)) $;

--| Alternate definition of the biconditional. (Contributed by BJ, 4-Oct-2019.)
theorem bj_dfbi6 (ph ps: wff):
  $ wb (wb ph ps) (wb (wo ph ps) (wa ph ps)) $;

--| Alternate proof of ~ bijust0 ; shorter but using additional intermediate results. (Contributed by NM, 11-May-1999.) (Proof shortened by Josh Purinton, 29-Dec-2000.) (Revised by BJ, 19-Mar-2020.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_bijust0ALT (ph: wff):
  $ wn (wi (wi ph ph) (wn (wi ph ph))) $;

--| A self-implication does not imply the negation of a self-implication. Most general theorem of which ~ bijust is an instance ( ~ bijust0 and ~ bj-bijust0ALT are therefore also instances of it). (Contributed by BJ, 7-Sep-2022.)
theorem bj_bijust00 (ph ps: wff):
  $ wn (wi (wi ph ph) (wn (wi ps ps))) $;

--| Version of ~ consensus expressed using the conditional operator. (Remark: it may be better to express it as ~ consensus , using only binary connectives, and hinting at the fact that it is a Boolean algebra identity, like the absorption identities.) (Contributed by BJ, 30-Sep-2019.)
theorem bj_consensus (ph ps ch: wff):
  $ wb (wo (wif ph ps ch) (wa ps ch)) (wif ph ps ch) $;

--| Alternate proof of ~ bj-consensus . (Contributed by BJ, 30-Sep-2019.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_consensusALT (ph ps ch: wff):
  $ wb (wo (wif ph ps ch) (wa ps ch)) (wif ph ps ch) $;

--| Candidate definition for the conditional operator for classes. This is in line with the definition of a class as the extension of a predicate in ~ df-clab . We reprove the current ~ df-if from it in ~ bj-dfif . (Contributed by BJ, 20-Sep-2019.) (Proof modification is discouraged.)
theorem bj_df_ifc {x3: setvar} (ph: wff) (A2 B2: class):
  $ wceq (cif ph A2 B2) (cab x3 (wif ph (wcel (cv x3) A2) (wcel (cv x3) B2))) $;

--| Alternate definition of the conditional operator for classes, which used to be the main definition. (Contributed by BJ, 26-Dec-2023.) (Proof modification is discouraged.)
theorem bj_dfif {x3: setvar} (ph: wff) (A2 B2: class):
  $ wceq (cif ph A2 B2) (cab x3 (wo (wa ph (wcel (cv x3) A2)) (wa (wn ph) (wcel (cv x3) B2)))) $;

--| A biconditional connecting the conditional operator for propositions and the conditional operator for classes. There is no sethood hypothesis on ` X ` : it is implied by either side. (Contributed by BJ, 24-Sep-2019.) Generalize statement from setvar ` x ` to class ` X ` . (Revised by BJ, 26-Dec-2023.)
theorem bj_ififc (ph: wff) (A2 B2 X: class):
  $ wb (wcel X (cif ph A2 B2)) (wif ph (wcel X A2) (wcel X B2)) $;

--| Uncurried (imported) form of ~ imbi12 . (Contributed by BJ, 6-May-2019.)
theorem bj_imbi12 (ph ps ch th: wff):
  $ wi (wa (wb ph ps) (wb ch th)) (wb (wi ph ch) (wi ps th)) $;

--| Dual of ~ truan (which has biconditional reversed). (Contributed by BJ, 26-Oct-2019.) (Proof modification is discouraged.)
theorem bj_falor (ph: wff):
  $ wb ph (wo wfal ph) $;

--| Dual of ~ truan . (Contributed by BJ, 26-Oct-2019.) (Proof modification is discouraged.)
theorem bj_falor2 (ph: wff):
  $ wb (wo wfal ph) ph $;

--| A property of the biconditional. (Contributed by BJ, 26-Oct-2019.) (Proof modification is discouraged.)
theorem bj_bibibi (ph ps: wff):
  $ wb ph (wb ps (wb ph ps)) $;

--| Duplication of ~ bnj1224 . Three-fold version of ~ imnani . (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (Revised by BJ, 22-Oct-2019.) (Proof modification is discouraged.)
theorem bj_imn3ani (ph ps ch: wff):
  $ wn (w3a ph ps ch) $ >
  $ wi (wa ph ps) (wn ch) $;

--| Two ways of expressing a certain ternary connective. Note the respective positions of the three formulas on each side of the biconditional. (Contributed by BJ, 6-Oct-2018.)
theorem bj_andnotim (ph ps ch: wff):
  $ wb (wi (wa ph (wn ps)) ch) (wo (wi ph ps) ch) $;

--| This used to be in the main part. (Contributed by Wolf Lammen, 14-May-2013.) (Revised by BJ, 14-Jun-2019.)
theorem bj_bi3ant (ph ps ch th ta: wff):
  $ wi ph (wi ps ch) $ >
  $ wi (wi (wi th ta) ph) (wi (wi (wi ta th) ps) (wi (wb th ta) ch)) $;

--| This used to be in the main part. (Contributed by Wolf Lammen, 14-May-2013.) (Revised by BJ, 14-Jun-2019.)
theorem bj_bisym (ph ps ch th: wff):
  $ wi (wi (wi ph ps) (wi ch th)) (wi (wi (wi ps ph) (wi th ch)) (wi (wb ph ps) (wb ch th))) $;

--| Equivalence of two ternary operations. Note the identical order and parenthesizing of the three arguments in both expressions. (Contributed by BJ, 31-Dec-2023.)
theorem bj_bixor (ph ps ch: wff):
  $ wb (wb ph (wxo ps ch)) (wxo ph (wb ps ch)) $;

--| This implication, proved using only ~ ax-gen and ~ ax-4 on top of propositional calculus (hence holding, up to the standard interpretation, in any normal modal logic), shows that the axiom scheme ` |- E. x T. ` implies the axiom scheme ` |- ( A. x ph -> E. x ph ) ` . These correspond to the modal axiom (D), and in predicate calculus, they assert that the universe of discourse is nonempty. For the converse, see ~ bj-axd2d . (Contributed by BJ, 16-May-2019.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_axdd2 {x3: setvar} (ph ps: wff x3):
  $ wi (wex x3 ph) (wi (wal x3 ps) (wex x3 ps)) $;

--| This implication, proved using only ~ ax-gen on top of propositional calculus (hence holding, up to the standard interpretation, in any modal logic), shows that the axiom scheme ` |- ( A. x ph -> E. x ph ) ` implies the axiom scheme ` |- E. x T. ` (substitute ` T. ` for ` ph ` ). These correspond to the modal axiom (D), and in predicate calculus, they assert that the universe of discourse is nonempty. For the converse, see ~ bj-axdd2 . (Contributed by BJ, 16-May-2019.) Generalize from its instance with ` T. ` substituted for ` ph ` . (Revised by BJ, 20-Mar-2022.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_axd2d {x3: setvar} (ph: wff x3):
  $ wi (wi (wal x3 wtru) (wex x3 ph)) (wex x3 ph) $;

--| This implication, proved from propositional calculus only (hence holding, up to the standard interpretation, in any modal logic), shows that the axiom scheme ` |- ( A. x ph -> ph ) ` (modal T) implies the axiom scheme ` |- ( A. x ph -> E. x ph ) ` (modal D). See also ~ bj-axdd2 and ~ bj-axd2d . (Contributed by BJ, 16-May-2019.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_axtd {x3: setvar} (ph: wff x3):
  $ wi (wi (wal x3 (wn ph)) (wn ph)) (wi (wi (wal x3 ph) ph) (wi (wal x3 ph) (wex x3 ph))) $;

--| In a normal modal logic, the modal axiom GL implies the modal axiom (4). Translated to first-order logic, Axiom GL reads ` |- ( A. x ( A. x ph -> ph ) -> A. x ph ) ` . The antecedent of ~ bj-gl4 is an instance of the axiom GL, with ` ph ` replaced by ` ( A. x ph /\ ph ) ` , which is a modality sometimes called the "strong necessity" of ` ph ` . (Contributed by BJ, 12-Dec-2019.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_gl4 {x3: setvar} (ph: wff x3):
  $ wi (wi (wal x3 (wi (wal x3 (wa (wal x3 ph) ph)) (wa (wal x3 ph) ph))) (wal x3 (wa (wal x3 ph) ph))) (wi (wal x3 ph) (wal x3 (wal x3 ph))) $;

--| Over minimal calculus, the modal axiom (4) ( ~ hba1 ) and the modal axiom (K) ( ~ ax-4 ) together imply ~ axc4 . (Contributed by BJ, 29-Nov-2020.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_axc4 {x3: setvar} (ph ps: wff x3):
  $ wi (wi (wal x3 ph) (wal x3 (wal x3 ph))) (wi (wi (wal x3 (wi (wal x3 ph) ps)) (wi (wal x3 (wal x3 ph)) (wal x3 ps))) (wi (wal x3 (wi (wal x3 ph) ps)) (wi (wal x3 ph) (wal x3 ps)))) $;

--| Syntax for the provability predicate.
term cprvb (ph: wff): wff;

--| First property of three of the provability predicate. (Contributed by BJ, 3-Apr-2019.)
axiom ax_prv1 (ph: wff):
  $ ph $ >
  $ cprvb ph $;

--| Second property of three of the provability predicate. (Contributed by BJ, 3-Apr-2019.)
axiom ax_prv2 (ph ps: wff):
  $ wi (cprvb (wi ph ps)) (wi (cprvb ph) (cprvb ps)) $;

--| Third property of three of the provability predicate. (Contributed by BJ, 3-Apr-2019.)
axiom ax_prv3 (ph: wff):
  $ wi (cprvb ph) (cprvb (cprvb ph)) $;

--| An elementary property of the provability predicate. (Contributed by BJ, 3-Apr-2019.)
theorem prvlem1 (ph ps: wff):
  $ wi ph ps $ >
  $ wi (cprvb ph) (cprvb ps) $;

--| An elementary property of the provability predicate. (Contributed by BJ, 3-Apr-2019.)
theorem prvlem2 (ph ps ch: wff):
  $ wi ph (wi ps ch) $ >
  $ wi (cprvb ph) (wi (cprvb ps) (cprvb ch)) $;

--| See the section header comments for the context. The first hypothesis reads " ` ph ` is true if and only if it is not provable in T" (and having this first hypothesis means that we can prove this fact in T). The wff ` ph ` is a formal version of the sentence "This sentence is not provable". The hard part of the proof of G&ouml;del's theorem is to construct such a ` ph ` , called a "G&ouml;del&ndash;Rosser sentence", for a first-order theory T which is effectively axiomatizable and contains Robinson arithmetic, through G&ouml;del diagonalization (this can be done in primitive recursive arithmetic). The second hypothesis means that ` F. ` is not provable in T, that is, that the theory T is consistent (and having this second hypothesis means that we can prove in T that the theory T is consistent). The conclusion is the falsity, so having the conclusion means that T can prove the falsity, that is, T is inconsistent. Therefore, taking the contrapositive, this theorem expresses that if a first-order theory is consistent (and one can prove in it that some formula is true if and only if it is not provable in it), then this theory does not prove its own consistency. This proof is due to George Boolos, _G&ouml;del's Second Incompleteness Theorem Explained in Words of One Syllable_, Mind, New Series, Vol. 103, No. 409 (January 1994), pp. 1--3. (Contributed by BJ, 3-Apr-2019.)
theorem bj_babygodel (ph: wff):
  $ wb ph (wn (cprvb ph)) $ >
  $ wn (cprvb wfal) $ >
  $ wfal $;

--| See the section header comments for the context, as well as the comments for ~ bj-babygodel . L&ouml;b's theorem when the L&ouml;b sentence is given as a hypothesis (the hard part of the proof of L&ouml;b's theorem is to construct this L&ouml;b sentence; this can be done, using G&ouml;del diagonalization, for any first-order effectively axiomatizable theory containing Robinson arithmetic). More precisely, the present theorem states that if a first-order theory proves that the provability of a given sentence entails its truth (and if one can construct in this theory a provability predicate and a L&ouml;b sentence, given here as the first hypothesis), then the theory actually proves that sentence. See for instance, Eliezer Yudkowsky, _The Cartoon Guide to L&ouml;b's Theorem_ (available at ~ http://yudkowsky.net/rational/lobs-theorem/ ). (Contributed by BJ, 20-Apr-2019.)
theorem bj_babylob (ph ps: wff):
  $ wb ps (wi (cprvb ps) ph) $ >
  $ wi (cprvb ph) ph $ >
  $ ph $;

--| Proof of G&ouml;del's theorem from L&ouml;b's theorem (see comments at ~ bj-babygodel and ~ bj-babylob for details). (Contributed by BJ, 20-Apr-2019.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_godellob (ph: wff):
  $ wb ph (wn (cprvb ph)) $ >
  $ wn (cprvb wfal) $ >
  $ wfal $;

--| A lemma for changing bound variables. Only the forward implication is intuitionistic. (Contributed by BJ, 14-Mar-2026.)
theorem bj_exexalal {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wb (wi (wex x3 ph) (wex y1 ps)) (wi (wal y1 (wn ps)) (wal x3 (wn ph))) $;

--| Generalization rule on the right conjunct. See ~ 19.28 . (Contributed by BJ, 7-Jul-2021.)
theorem bj_genr {x3: setvar} (ph ps: wff x3):
  $ wa ph ps $ >
  $ wa ph (wal x3 ps) $;

--| Generalization rule on the left conjunct. See ~ 19.27 . (Contributed by BJ, 7-Jul-2021.)
theorem bj_genl {x3: setvar} (ph ps: wff x3):
  $ wa ph ps $ >
  $ wa (wal x3 ph) ps $;

--| Generalization rule on a conjunction. Forward inference associated with ~ 19.26 . (Contributed by BJ, 7-Jul-2021.)
theorem bj_genan {x3: setvar} (ph ps: wff x3):
  $ wa ph ps $ >
  $ wa (wal x3 ph) (wal x3 ps) $;

--| From a closed form theorem (the major premise) with an antecedent in the "strong necessity" modality (in the language of modal logic), deduce the associated inference. Strong necessity is stronger than necessity, and equivalent to it when ~ sp (modal T) is available. Therefore, this theorem is stronger than ~ mpg , and strictly stronger when ~ sp is not available. (Contributed by BJ, 1-Nov-2023.)
theorem bj_mpgs {x3: setvar} (ph ps: wff x3):
  $ wi (wa ph (wal x3 ph)) ps $ >
  $ ph $ >
  $ ps $;

--| A quantified form of ~ ax-mp . See also ~ barbara , ~ bj-ala1i , ~ bj-almpi . (Contributed by BJ, 19-Mar-2026.)
theorem bj_almp {x3: setvar} (ph ps: wff x3):
  $ wal x3 (wi ps ph) $ >
  $ wal x3 ps $ >
  $ wal x3 ph $;

--| Stronger form of ~ sylgt , closer to ~ ax-2 . (Contributed by BJ, 30-Jul-2025.)
theorem bj_sylggt {x3: setvar} (ph ps ch: wff x3):
  $ wi (wi ph (wal x3 (wi ps ch))) (wi (wi ph (wal x3 ps)) (wi ph (wal x3 ch))) $;

--| The general form of the *alrim* family of theorems: if ` ph ` is substituted for ` ps ` , then the antecedent expresses a form of nonfreeness of ` x ` in ` ph ` , so the theorem means that under a nonfreeness condition in an antecedent, one can deduce from the universally quantified implication an implication where the consequent is universally quantified. Dual of ~ bj-exlimg . (Contributed by BJ, 9-Dec-2023.)
theorem bj_alrimg {x3: setvar} (ph ps ch: wff x3):
  $ wi (wi ph (wal x3 ps)) (wi (wal x3 (wi ps ch)) (wi ph (wal x3 ch))) $;

--| Uncurried (imported) form of ~ sylgt . (Contributed by BJ, 2-May-2019.)
theorem bj_sylgt2 {x3: setvar} (ph ps ch: wff x3):
  $ wi (wa (wal x3 (wi ps ch)) (wi ph (wal x3 ps))) (wi ph (wal x3 ch)) $;

--| Closed form of ~ nexdh (actually, its general instance). (Contributed by BJ, 6-May-2019.)
theorem bj_nexdh {x3: setvar} (ph ps ch: wff x3):
  $ wi (wal x3 (wi ph (wn ps))) (wi (wi ch (wal x3 ph)) (wi ch (wn (wex x3 ps)))) $;

--| Uncurried (imported) form of ~ bj-nexdh . (Contributed by BJ, 6-May-2019.)
theorem bj_nexdh2 {x3: setvar} (ph ps ch: wff x3):
  $ wi (wa (wal x3 (wi ph (wn ps))) (wi ch (wal x3 ph))) (wi ch (wn (wex x3 ps))) $;

--| Inference associated with ~ alimi . Double inference associated with ~ alim . The usual proof of an associated inference (here from ~ alimi and ~ ax-mp ) has the same size and same number of steps. (Contributed by BJ, 19-Mar-2026.)
theorem bj_alimii {x3: setvar} (ph ps: wff x3):
  $ wi ps ph $ >
  $ wal x3 ps $ >
  $ wal x3 ph $;

--| Add an antecedent in a universally quantified formula. Inference associated with ~ ala1 . (Contributed by BJ, 6-Oct-2018.)
theorem bj_ala1i {x3: setvar} (ph ps: wff x3):
  $ wal x3 ph $ >
  $ wal x3 (wi ps ph) $;

--| A quantified form of ~ mpi . See also ~ barbara , ~ bj-ala1i , ~ bj-almp . (Contributed by BJ, 19-Mar-2026.)
theorem bj_almpi {x3: setvar} (ph ps ch: wff x3):
  $ wal x3 (wi ph (wi ch ps)) $ >
  $ wal x3 ch $ >
  $ wal x3 (wi ph ps) $;

--| A partially quantified form of ~ mpi similar to ~ bj-almpi . (Contributed by BJ, 19-Mar-2026.)
theorem bj_almpig {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wi ch ps) $ >
  $ wal x3 ch $ >
  $ wal x3 (wi ph ps) $;

--| Syllogism under the universal quantifier, in the curried form appearing as Theorem *10.3 of [WhiteheadRussell] p. 145. See ~ alsyl for the uncurried form. (Contributed by BJ, 28-Mar-2026.)
theorem bj_alsyl {x3: setvar} (ph ps ch: wff x3):
  $ wi (wal x3 (wi ph ps)) (wi (wal x3 (wi ps ch)) (wal x3 (wi ph ch))) $;

--| Closed form of ~ 2alimi . (Contributed by BJ, 6-May-2019.)
theorem bj_2alim {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wal x3 (wal y1 (wi ph ps))) (wi (wal x3 (wal y1 ph)) (wal x3 (wal y1 ps))) $;

--| General instance of ~ alimdh . (Contributed by NM, 4-Jan-2002.) State the most general derivable instance. (Revised by BJ, 5-Apr-2026.)
theorem bj_alimdh {x3: setvar} (ph ps ch th: wff x3):
  $ wi ph (wal x3 ps) $ >
  $ wi ps (wi ch th) $ >
  $ wi ph (wi (wal x3 ch) (wal x3 th)) $;

--| Deduction form of Theorem 19.21 of [Margaris] p. 90, see ~ 19.21 and ~ 19.21h . (Contributed by NM, 10-Feb-1997.) (Proof shortened by Andrew Salmon, 13-May-2011.) State the most general derivable instance. (Revised by BJ, 5-Apr-2026.)
theorem bj_alrimdh {x3: setvar} (ph ps ch th ta: wff x3):
  $ wi ph (wal x3 ps) $ >
  $ wi ch (wal x3 th) $ >
  $ wi ps (wi th ta) $ >
  $ wi ph (wi ch (wal x3 ta)) $;

--| A slightly more general ~ alrimd . A common usage will have ` ph ` substituted for ` ps ` and ` ch ` substituted for ` th ` , giving a form closer to ~ alrimd . (Contributed by BJ, 25-Dec-2023.)
theorem bj_alrimd {x3: setvar} (ph ps ch th ta: wff x3):
  $ wi ph (wal x3 ps) $ >
  $ wi ph (wi ch (wal x3 th)) $ >
  $ wi ps (wi th ta) $ >
  $ wi ph (wi ch (wal x3 ta)) $;

--| Add an antecedent in an existentially quantified formula. Inference associated with ~ exa1 . (Contributed by BJ, 6-Oct-2018.)
theorem bj_exa1i {x3: setvar} (ph ps: wff x3):
  $ wex x3 ph $ >
  $ wex x3 (wi ps ph) $;

--| Closed form of ~ alanimi . (Contributed by BJ, 6-May-2019.)
theorem bj_alanim {x3: setvar} (ph ps ch: wff x3):
  $ wi (wal x3 (wi (wa ph ps) ch)) (wi (wa (wal x3 ph) (wal x3 ps)) (wal x3 ch)) $;

--| Closed form of ~ 2albii . (Contributed by BJ, 6-May-2019.)
theorem bj_2albi {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wal x3 (wal y1 (wb ph ps))) (wb (wal x3 (wal y1 ph)) (wal x3 (wal y1 ps))) $;

--| Equivalence of universal quantification of negation of equivalent formulas. Shortens ~ ab0 (103>94), ~ ballotlem2 (2655>2648), ~ bnj1143 (522>519), ~ hausdiag (2119>2104). (Contributed by BJ, 17-Jul-2021.)
theorem bj_notalbii {x3: setvar} (ph ps: wff x3):
  $ wb ph ps $ >
  $ wb (wal x3 (wn ph)) (wal x3 (wn ps)) $;

--| Closed form of ~ 2eximi . (Contributed by BJ, 6-May-2019.)
theorem bj_2exim {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wal x3 (wal y1 (wi ph ps))) (wi (wex x3 (wex y1 ph)) (wex x3 (wex y1 ps))) $;

--| Closed form of ~ 2exbii . (Contributed by BJ, 6-May-2019.)
theorem bj_2exbi {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wal x3 (wal y1 (wb ph ps))) (wb (wex x3 (wex y1 ph)) (wex x3 (wex y1 ps))) $;

--| Closed form of ~ 3exbii . (Contributed by BJ, 6-May-2019.)
theorem bj_3exbi {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wi (wal x3 (wal y1 (wal z (wb ph ps)))) (wb (wex x3 (wex y1 (wex z ph))) (wex x3 (wex y1 (wex z ps)))) $;

--| Dual statement of ~ sylgt . Closed form of ~ bj-sylge . (Contributed by BJ, 2-May-2019.)
theorem bj_sylget {x3: setvar} (ph ps ch: wff x3):
  $ wi (wal x3 (wi ch ph)) (wi (wi (wex x3 ph) ps) (wi (wex x3 ch) ps)) $;

--| Uncurried (imported) form of ~ bj-sylget . (Contributed by BJ, 2-May-2019.)
theorem bj_sylget2 {x3: setvar} (ph ps ch: wff x3):
  $ wi (wa (wal x3 (wi ph ps)) (wi (wex x3 ps) ch)) (wi (wex x3 ph) ch) $;

--| The general form of the *exlim* family of theorems: if ` ph ` is substituted for ` ps ` , then the antecedent expresses a form of nonfreeness of ` x ` in ` ph ` , so the theorem means that under a nonfreeness condition in a consequent, one can deduce from the universally quantified implication an implication where the antecedent is existentially quantified. Dual of ~ bj-alrimg . (Contributed by BJ, 9-Dec-2023.)
theorem bj_exlimg {x3: setvar} (ph ps ch: wff x3):
  $ wi (wi (wex x3 ph) ps) (wi (wal x3 (wi ch ph)) (wi (wex x3 ch) ps)) $;

--| Dual statement of ~ sylg (the final "e" in the label stands for "existential (version of ~ sylg )". Variant of ~ exlimih . (Contributed by BJ, 25-Dec-2023.)
theorem bj_sylge {x3: setvar} (ph ps ch: wff x3):
  $ wi (wex x3 ph) ps $ >
  $ wi ch ph $ >
  $ wi (wex x3 ch) ps $;

--| A slightly more general ~ exlimd . A common usage will have ` ph ` substituted for ` ps ` and ` th ` substituted for ` ta ` , giving a form closer to ~ exlimd . (Contributed by BJ, 25-Dec-2023.)
theorem bj_exlimd {x3: setvar} (ph ps ch th ta: wff x3):
  $ wi ph (wal x3 ps) $ >
  $ wi ph (wi (wex x3 th) ta) $ >
  $ wi ps (wi ch th) $ >
  $ wi ph (wi (wex x3 ch) ta) $;

--| A weak from of nonfreeness in either an antecedent or a consequent implies that a universally quantified implication is equivalent to the associated implication where the antecedent is existentially quantified and the consequent is universally quantified. The forward implication always holds (this is ~ 19.38 ) and the converse implication is the join of instances of ~ bj-alrimg and ~ bj-exlimg (see ~ 19.38a and ~ 19.38b ). TODO: prove a version where the antecedents use the nonfreeness quantifier. (Contributed by BJ, 9-Dec-2023.)
theorem bj_nfimexal {x3: setvar} (ph ps: wff x3):
  $ wi (wo (wi (wex x3 ph) (wal x3 ph)) (wi (wex x3 ps) (wal x3 ps))) (wb (wi (wex x3 ph) (wal x3 ps)) (wal x3 (wi ph ps))) $;

--| Theorem 19.22 of [Margaris] p. 90. (Contributed by NM, 10-Jan-1993.) (Proof shortened by Wolf Lammen, 4-Jul-2014.) Prove it directly from ~ alim to allow use in ~ bj-alexim . (Revised by BJ, 9-Dec-2023.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_exim {x3: setvar} (ph ps: wff x3):
  $ wi (wal x3 (wi ph ps)) (wi (wex x3 ph) (wex x3 ps)) $;

--| Closed form of ~ aleximi . Note: this proof is shorter, so ~ aleximi could be deduced from it ( ~ exim would have to be proved first, see ~ bj-exim ). (Contributed by BJ, 8-Nov-2021.)
theorem bj_alexim {x3: setvar} (ph ps ch: wff x3):
  $ wi (wal x3 (wi ph (wi ps ch))) (wi (wal x3 ph) (wi (wex x3 ps) (wex x3 ch))) $;

--| Alternate proof of ~ aleximi from ~ exim , which is sometimes used as an axiom in instuitionistic modal logic. (Contributed by BJ, 9-Dec-2023.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_aleximiALT {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wi ps ch) $ >
  $ wi (wal x3 ph) (wi (wex x3 ps) (wex x3 ch)) $;

--| Closed form of ~ hbxfrbi . Note: it is less important than ~ nfbiit . The antecedent is in the "strong necessity" modality of modal logic (see also ~ bj-nnftht ) in order not to require ~ sp (modal T). See ~ bj-hbyfrbi for its version with existential quantifiers. (Contributed by BJ, 6-May-2019.)
theorem bj_hbxfrbi {x3: setvar} (ph ps: wff x3):
  $ wi (wa (wb ph ps) (wal x3 (wb ph ps))) (wb (wi ph (wal x3 ph)) (wi ps (wal x3 ps))) $;

--| Version of ~ bj-hbxfrbi with existential quantifiers. (Contributed by BJ, 23-Aug-2023.)
theorem bj_hbyfrbi {x3: setvar} (ph ps: wff x3):
  $ wi (wa (wb ph ps) (wal x3 (wb ph ps))) (wb (wi (wex x3 ph) ph) (wi (wex x3 ps) ps)) $;

--| Distribute quantifiers over a nested implication. This and the following theorems are the general instances of already proved theorems. They could be moved to the main part, before ~ ax-5 . I propose to move to the main part: ~ bj-exalim , ~ bj-exalimi , ~ bj-eximcom ~ bj-exalims , ~ bj-exalimsi , ~ bj-ax12i , ~ bj-ax12wlem , ~ bj-ax12w . A new label is needed for ~ bj-ax12i and label suggestions are welcome for the others. I also propose to change ` -. A. x -. ` to ` E. x ` in ~ speimfw and ~ spimfw (other spim* theorems use ` E. x ` and very few theorems in set.mm use ` -. A. x -. ` ). (Contributed by BJ, 8-Nov-2021.)
theorem bj_exalim {x3: setvar} (ph ps ch: wff x3):
  $ wi (wal x3 (wi ph (wi ps ch))) (wi (wex x3 ph) (wi (wal x3 ps) (wex x3 ch))) $;

--| An inference for distributing quantifiers over a nested implication. The canonical derivation from its closed form ~ bj-exalim (using ~ mpg ) has fewer essential steps, but more steps in total (yielding a longer compressed proof). (Almost) the general statement that ~ speimfw proves. (Contributed by BJ, 29-Sep-2019.)
theorem bj_exalimi {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wi ps ch) $ >
  $ wi (wex x3 ph) (wi (wal x3 ps) (wex x3 ch)) $;

--| A commuted form of ~ exim which is sometimes posited as an axiom in instuitionistic modal logic. Forward implication of ~ 19.35 . Its converse is not intuitionistic. (Contributed by BJ, 9-Dec-2023.)
theorem bj_eximcom {x3: setvar} (ph ps: wff x3):
  $ wi (wex x3 (wi ph ps)) (wi (wal x3 ph) (wex x3 ps)) $;

--| Distributing quantifiers over a nested implication. (Almost) the general statement that ~ spimfw proves. (Contributed by BJ, 29-Sep-2019.)
theorem bj_exalims {x3: setvar} (ph ps ch: wff x3):
  $ wi (wex x3 ph) (wi (wn ch) (wal x3 (wn ch))) $ >
  $ wi (wal x3 (wi ph (wi ps ch))) (wi (wex x3 ph) (wi (wal x3 ps) ch)) $;

--| An inference for distributing quantifiers over a nested implication. (Almost) the general statement that ~ spimfw proves. (Contributed by BJ, 29-Sep-2019.)
theorem bj_exalimsi {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wi ps ch) $ >
  $ wi (wex x3 ph) (wi (wn ch) (wal x3 (wn ch))) $ >
  $ wi (wex x3 ph) (wi (wal x3 ps) ch) $;

--| Alternate proof of ~ bj-axdd2 (this should replace ~ bj-axdd2 when ~ bj-exalimi is moved to the main section). (Contributed by BJ, 8-Mar-2026.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_axdd2ALT {x3: setvar} (ph ps: wff x3):
  $ wi (wex x3 ph) (wi (wal x3 ps) (wex x3 ps)) $;

--| A lemma used to prove a weak form of the axiom of substitution. A generalization of ~ bj-ax12i . (Contributed by BJ, 19-Dec-2020.)
theorem bj_ax12ig {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wi ch (wal x3 ch)) $ >
  $ wi ph (wi ps (wal x3 (wi ph ps))) $;

--| A weakening of ~ bj-ax12ig that is sufficient to prove a weak form of the axiom of substitution ~ ax-12 . The general statement of which ~ ax12i is an instance. (Contributed by BJ, 29-Sep-2019.)
theorem bj_ax12i {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wb ps ch) $ >
  $ wi ch (wal x3 ch) $ >
  $ wi ph (wi ps (wal x3 (wi ph ps))) $;

--| Closed form of ~ nfim and curried (exported) form of ~ nfimt . (Contributed by BJ, 20-Oct-2021.) Proof should not use ~ 19.35 . (Proof modification is discouraged.)
theorem bj_nfimt {x3: setvar} (ph ps: wff x3):
  $ wi (wnf x3 ph) (wi (wnf x3 ps) (wnf x3 (wi ph ps))) $;

--| A universal specification result: if ` ph ` is true for all values of ` x ` and implies ` ps ` for at least one value, and if furthermore ` x ` is ` E. ` -weakly nonfree in ` ps ` , then ` ps ` follows. An intermediate result on the way to prove ~ 19.36i , ~ bj-19.36im , ~ 19.36imv , ~ spimfw ... (Contributed by BJ, 3-Apr-2026.) Proof should not use ~ 19.35 . (Proof modification is discouraged.)
theorem bj_spimnfe {x3: setvar} (ph ps: wff x3):
  $ wi (wi (wex x3 ps) ps) (wi (wex x3 (wi ph ps)) (wi (wal x3 ph) ps)) $;

--| An existential generalization result: if ` ph ` holds and implies ` ps ` for at least one value of ` x ` , and if furthermore ` x ` is ` A. ` -weakly nonfree in ` ph ` , then ` ps ` holds for at least one value of ` x ` . (Contributed by BJ, 3-Apr-2026.) Proof should not use ~ 19.35 . (Proof modification is discouraged.)
theorem bj_spimenfa {x3: setvar} (ph ps: wff x3):
  $ wi (wi ph (wal x3 ph)) (wi (wex x3 (wi ph ps)) (wi ph (wex x3 ps))) $;

--| A lemma for universal specification. In applications, ` x = y ` will be substituted for ` ps ` and ~ ax6ev will prove Hypothesis bj-spim.denote. (Contributed by BJ, 4-Apr-2026.)
theorem bj_spim {x3: setvar} (ph ps ch th: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wi (wex x3 th) th) $ >
  $ wi ph (wex x3 ps) $ >
  $ wi (wa ph ps) (wi ch th) $ >
  $ wi ph (wi (wal x3 ch) th) $;

--| A lemma for existential generalization. In applications, ` x = y ` will be substituted for ` ps ` and ~ ax6ev will prove Hypothesis bj-spime.denote. (Contributed by BJ, 4-Apr-2026.)
theorem bj_spime {x3: setvar} (ph ps ch th: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wi ch (wal x3 ch)) $ >
  $ wi ph (wex x3 ps) $ >
  $ wi (wa ph ps) (wi ch th) $ >
  $ wi ph (wi ch (wex x3 th)) $;

--| A lemma for alpha-renaming of variables bound by a universal quantifier. In applications, ` x = y ` will be substituted for ` ps ` and ~ ax6ev will prove Hypothesis bj-cbvalimd0.denote. When ~ ax6ev is not available but only its universal closure is, then ~ bj-cbvalimd or ~ bj-cbvalimdv should be used (see ~ bj-cbvalimdlem , ~ bj-cbval ). (Contributed by BJ, 4-Apr-2026.)
theorem bj_cbvalimd0 {x3 y1: setvar} (ph ps ch th: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wal y1 ph) $ >
  $ wi ph (wi ch (wal y1 ch)) $ >
  $ wi ph (wi (wex x3 th) th) $ >
  $ wi ph (wex x3 ps) $ >
  $ wi (wa ph ps) (wi ch th) $ >
  $ wi ph (wi (wal x3 ch) (wal y1 th)) $;

--| A lemma for alpha-renaming of variables bound by a universal quantifier. Hypothesis bj-cbvalimdlem.nfch can be proved either from DV conditions as in ~ bj-cbvalimdv or from a nonfreeness condition and ~ alcom as in ~ bj-cbvalimd . Hypothesis bj-cbvalimdlem.denote is weaker than the corresponding hypothesis of ~ bj-cbvalimd0 , and this proof is therefore a bit longer, not using ~ bj-spim but ~ bj-eximcom . (Contributed by BJ, 12-Mar-2023.) Proof should not use ~ 19.35 . (Proof modification is discouraged.)
theorem bj_cbvalimdlem {x3 y1: setvar} (ph ps ch th: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wal y1 ph) $ >
  $ wi ph (wi (wal x3 ch) (wal y1 (wal x3 ch))) $ >
  $ wi ph (wi (wex x3 th) th) $ >
  $ wi ph (wal y1 (wex x3 ps)) $ >
  $ wi (wa ph ps) (wi ch th) $ >
  $ wi ph (wi (wal x3 ch) (wal y1 th)) $;

--| A lemma for alpha-renaming of variables bound by an existential quantifier. Hypothesis bj-cbveximdlem.nfth can be proved either from DV conditions as in ~ bj-cbveximdv or from a nonfreeness condition and ~ excom as in ~ bj-cbveximd . Hypothesis bj-cbveximdlem.denote is weaker than the corresponding hypothesis of ~~ bj-cbveximd0 , and this proof is therefore a bit longer, not using ~ bj-spime but ~ bj-eximcom . (Contributed by BJ, 12-Mar-2023.) Proof should not use ~ 19.35 . (Proof modification is discouraged.)
theorem bj_cbveximdlem {x3 y1: setvar} (ph ps ch th: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wal y1 ph) $ >
  $ wi ph (wi ch (wal y1 ch)) $ >
  $ wi ph (wi (wex x3 (wex y1 th)) (wex y1 th)) $ >
  $ wi ph (wal x3 (wex y1 ps)) $ >
  $ wi (wa ph ps) (wi ch th) $ >
  $ wi ph (wi (wex x3 ch) (wex y1 th)) $;

--| A lemma for alpha-renaming of variables bound by a universal quantifier. (Contributed by BJ, 4-Apr-2026.) (Proof modification is discouraged.)
theorem bj_cbvalimd {x3 y1: setvar} (ph ps ch th: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wal y1 ph) $ >
  $ wi ph (wi ch (wal y1 ch)) $ >
  $ wi ph (wi (wex x3 th) th) $ >
  $ wi ph (wal y1 (wex x3 ps)) $ >
  $ wi (wa ph ps) (wi ch th) $ >
  $ wi ph (wi (wal x3 ch) (wal y1 th)) $;

--| A lemma for alpha-renaming of variables bound by an existential quantifier. (Contributed by BJ, 4-Apr-2026.) (Proof modification is discouraged.)
theorem bj_cbveximd {x3 y1: setvar} (ph ps ch th: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wal y1 ph) $ >
  $ wi ph (wi ch (wal y1 ch)) $ >
  $ wi ph (wi (wex x3 th) th) $ >
  $ wi ph (wal x3 (wex y1 ps)) $ >
  $ wi (wa ph ps) (wi ch th) $ >
  $ wi ph (wi (wex x3 ch) (wex y1 th)) $;

--| A lemma for alpha-renaming of variables bound by a universal quantifier. (Contributed by BJ, 4-Apr-2026.) (Proof modification is discouraged.)
theorem bj_cbvalimdv {x3 y1: setvar} (ph ps: wff x3 y1) (ch: wff x3) (th: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wal y1 ph) $ >
  $ wi ph (wi (wex x3 th) th) $ >
  $ wi ph (wal y1 (wex x3 ps)) $ >
  $ wi (wa ph ps) (wi ch th) $ >
  $ wi ph (wi (wal x3 ch) (wal y1 th)) $;

--| A lemma for alpha-renaming of variables bound by an existential quantifier. (Contributed by BJ, 4-Apr-2026.) (Proof modification is discouraged.)
theorem bj_cbveximdv {x3 y1: setvar} (ph ps ch: wff x3 y1) (th: wff y1):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wal y1 ph) $ >
  $ wi ph (wi ch (wal y1 ch)) $ >
  $ wi ph (wal x3 (wex y1 ps)) $ >
  $ wi (wa ph ps) (wi ch th) $ >
  $ wi ph (wi (wex x3 ch) (wex y1 th)) $;

--| Version of ~ spvw and ~ 19.3v proved from ~ ax-1 -- ~ ax-5 . The antecedent can for instance be proved with the existence axiom ~ extru . (Contributed by BJ, 8-Mar-2026.) (Proof modification is discouraged.)
theorem bj_spvw {x3: setvar} (ph: wff x3) (ps: wff):
  $ wi (wex x3 ph) (wb ps (wal x3 ps)) $;

--| Version of ~ 19.8v and ~ 19.9v proved from ~ ax-1 -- ~ ax-5 . The antecedent can for instance be proved with the existence axiom ~ extru . (Contributed by BJ, 8-Mar-2026.) This could also be proved from ~ bj-spvw using duality, but that proof would not be intuitionistic, contrary to the present one. (Proof modification is discouraged.)
theorem bj_spvew {x3: setvar} (ph: wff x3) (ps: wff):
  $ wi (wex x3 ph) (wb ps (wex x3 ps)) $;

--| An equivalent expression for universal quantification over a non-occurring variable proved over ~ ax-1 -- ~ ax-5 . The forward implication can be strengthened when ~ ax-6 is posited (which implies that models are non-empty), see ~ spvw . The reverse implication can be seen as a strengthening of ~ ax-5 (since the antecedent of the implication is weakened). See ~ bj-exextruan for a dual statement. An approximate meaning is: the universal quantification of a proposition over a non-occurring variable holds if and only if the proposition holds in nonempty universes. (Contributed by BJ, 14-Mar-2026.) (Proof modification is discouraged.)
theorem bj_alextruim {x3: setvar} (ph: wff):
  $ wb (wal x3 ph) (wi (wex x3 wtru) ph) $;

--| An equivalent expression for existential quantification over a non-occurring variable proved over ~ ax-1 -- ~ ax-5 . The forward implication can be seen as a strengthening of ~ ax-5 (a conjunct is added to the consequent of the implication). The reverse implication can be strengthened when ~ ax-6 is posited (which implies that models are non-empty), see ~ 19.8v . See ~ bj-alextruim for a dual statement. An approximate meaning is: the existential quantification of a proposition over a non-occurring variable holds if and only if the proposition holds and the universe is nonempty. (Contributed by BJ, 14-Mar-2026.) (Proof modification is discouraged.)
theorem bj_exextruan {x3: setvar} (ph: wff):
  $ wb (wex x3 ph) (wa (wex x3 wtru) ph) $;

--| Universally quantifying over a non-occurring variable is independent of that variable, over ~ ax-1 -- ~ ax-5 and the existence axiom ~ extru . See ~ bj-cbvaw for a strengthening. (Contributed by BJ, 8-Mar-2026.) (Proof modification is discouraged.)
theorem bj_cbvalvv {x3 y1: setvar} (ph: wff x3 y1) (ps: wff):
  $ wi (wex x3 ph) (wi (wal x3 ps) (wal y1 ps)) $;

--| Existentially quantifying over a non-occurring variable is independent of that variable, over ~ ax-1 -- ~ ax-5 and the existence axiom ~ extru . See ~ bj-cbvew for a strengthening. (Contributed by BJ, 8-Mar-2026.) (Proof modification is discouraged.)
theorem bj_cbvexvv {x3 y1: setvar} (ph: wff x3 y1) (ps: wff):
  $ wi (wex x3 ph) (wi (wex y1 ps) (wex x3 ps)) $;

--| Universally quantifying over a non-occurring variable is independent from the variable, under a weaker condition than in ~ bj-cbvalvv . If ` F. ` is substituted for ` ph ` , then the statement reads: "universally quantifying over a non-occurring variable is independent from the variable as soon as that result is true for the False truth constant". The label "cbvaw" means "'change bound variable' theorem, 'all' quantifier, weak version". (Contributed by BJ, 14-Mar-2026.) This proof is not intuitionistic (it uses ~ ja ); an intuitionistically valid statement is obtained by expressing the antecedent as a disjunction (classically equivalent through ~ imor ). (Proof modification is discouraged.)
theorem bj_cbvaw {x3 y1: setvar} (ph: wff x3 y1) (ps: wff):
  $ wi (wi (wal x3 ph) (wal y1 wfal)) (wi (wal x3 ps) (wal y1 ps)) $;

--| Existentially quantifying over a non-occurring variable is independent from the variable, under a weaker condition than in ~ bj-cbvexvv . If ` T. ` is substituted for ` ph ` , then the statement reads: "existentially quantifying over a non-occurring variable is independent from the variable as soon as that result is true for the True truth constant. The label "cbvew" means "'change bound variable' theorem, 'exists' quantifier, weak version". (Contributed by BJ, 14-Mar-2026.) This proof is intuitionistic. (Proof modification is discouraged.)
theorem bj_cbvew {x3 y1: setvar} (ph: wff x3 y1) (ps: wff):
  $ wi (wi (wex x3 wtru) (wex y1 ph)) (wi (wex x3 ps) (wex y1 ps)) $;

--| Universally quantifying over a non-occurring variable is independent from the variable, under a weaker condition than in ~ bj-cbvalvv . (Contributed by BJ, 14-Mar-2026.) (Proof modification is discouraged.)
theorem bj_cbveaw {x3 y1: setvar} (ph: wff x3 y1) (ps: wff):
  $ wi (wi (wex x3 wtru) (wex y1 ph)) (wi (wal y1 ps) (wal x3 ps)) $;

--| Exixtentially quantifying over a non-occurring variable is independent from the variable, under a weaker condition than in ~ bj-cbvexvv . (Contributed by BJ, 14-Mar-2026.) (Proof modification is discouraged.)
theorem bj_cbvaew {x3 y1: setvar} (ph: wff x3 y1) (ps: wff):
  $ wi (wi (wal x3 ph) (wal y1 wfal)) (wi (wex y1 ps) (wex x3 ps)) $;

--| A lemma used to prove a weak version of the axiom of substitution ~ ax-12 . (Temporary comment: The general statement that ~ ax12wlem proves.) (Contributed by BJ, 20-Mar-2020.)
theorem bj_ax12wlem {x3: setvar} (ph ps: wff x3) (ch: wff):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wi ps (wal x3 (wi ph ps))) $;

--| Changing a bound variable (universal quantification case) in a weak axiomatization that assumes that all variables denote (which is valid in inclusive free logic) and that equality is symmetric. (Contributed by BJ, 12-Mar-2023.) Proved from ~ ax-1 -- ~ ax-5 . (Proof modification is discouraged.)
theorem bj_cbval {x3 y1: setvar} (ph: wff x3 y1) (ps: wff x3) (ch: wff y1):
  $ wal y1 (wex x3 (wceq (cv x3) (cv y1))) $ >
  $ wal x3 (wex y1 (wceq (cv y1) (cv x3))) $ >
  $ wi (wceq (cv y1) (cv x3)) (wceq (cv x3) (cv y1)) $ >
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wal y1 ph) $ >
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wb ps ch) $ >
  $ wi ph (wb (wal x3 ps) (wal y1 ch)) $;

--| Changing a bound variable (existential quantification case) in a weak axiomatization that assumes that all variables denote (which is valid in inclusive free logic) and that equality is symmetric. (Contributed by BJ, 12-Mar-2023.) Proved from ~ ax-1 -- ~ ax-5 . (Proof modification is discouraged.)
theorem bj_cbvex {x3 y1: setvar} (ph: wff x3 y1) (ps: wff x3) (ch: wff y1):
  $ wal y1 (wex x3 (wceq (cv x3) (cv y1))) $ >
  $ wal x3 (wex y1 (wceq (cv y1) (cv x3))) $ >
  $ wi (wceq (cv y1) (cv x3)) (wceq (cv x3) (cv y1)) $ >
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wal y1 ph) $ >
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wb ps ch) $ >
  $ wi ph (wb (wex x3 ps) (wex y1 ch)) $;

--| Syntax for BJ's version of the uniqueness quantifier.
term wmoo {x3: setvar} (ph: wff x3): wff;

--| Definition of the uniqueness quantifier which is correct on the empty domain. Instead of the fresh variable ` z ` , one could save a dummy variable by using ` x ` or ` y ` at the cost of having nested quantifiers on the same variable. (Contributed by BJ, 12-Mar-2023.)
axiom df_bj_mo {x3 y1 z: setvar} (ph: wff x3):
  $ wb (wmoo x3 ph) (wal z (wex y1 (wal x3 (wi ph (wceq (cv x3) (cv y1)))))) $;

--| Proposed definition to replace ~ df-sb and ~ df-sbc . Proof is therefore unimportant. Contrary to ~ df-sb , this definition makes a substituted formula false when one substitutes a non-existent object for a variable. This is better suited to the "Levy-style" treatment of classes as virtual objects adopted by set.mm. Indeed, in most set theories, and in particular in this database, one wants to be able to _collect the extension of a formula_, so it is natural that the extension of a formula contain only sets, and not proper classes. This is illustrated by the fact that ~ bj-dfsbc holds unconditionally. That statement could therefore replace ~ df-clab . This definition is equivalent to ~ df-sb when a setvar is substituted for the class, since, as soon as, ~ ax6ev is posited, all variables "exist". (Contributed by BJ, 19-Feb-2026.)
theorem bj_df_sb {x3 y1: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wsbc x3 ph A2) (wex y1 (wa (wceq (cv y1) A2) (wal x3 (wi (wceq (cv x3) (cv y1)) ph)))) $;

--| Proof of ~ sbcex when taking ~ bj-df-sb as definition. (Contributed by BJ, 19-Feb-2026.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_sbcex {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wsbc x3 ph A2) (wcel A2 cvv) $;

--| Proof of ~ df-sbc when taking ~ bj-df-sb as definition. (Contributed by BJ, 19-Feb-2026.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_dfsbc {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wcel A2 (cab x3 ph)) (wsbc x3 ph A2) $;

--| Substitution in an equality, disjoint variables case. Uses only ~ ax-1 through ~ ax-6 . It might be shorter to prove the result about composition of two substitutions and prove ~ bj-ssbeq first with a DV condition on ` x , t ` , and then in the general case. (Contributed by BJ, 22-Dec-2020.) (Proof modification is discouraged.)
theorem bj_ssbeq {x3 t: setvar} (y1 z: setvar):
  $ wb (wsb x3 (wceq (cv y1) (cv z)) t) (wceq (cv y1) (cv z)) $;

--| A lemma for the definiens of ~ df-sb . An instance of ~ sp proved without it. Note: it has a common subproof with ~ sbjust . (Contributed by BJ, 22-Dec-2020.) (Proof modification is discouraged.)
theorem bj_ssblem1 {x3 y1: setvar} (ph: wff x3) (t: setvar):
  $ wi (wal y1 (wi (wceq (cv y1) (cv t)) (wal x3 (wi (wceq (cv x3) (cv y1)) ph)))) (wi (wceq (cv y1) (cv t)) (wal x3 (wi (wceq (cv x3) (cv y1)) ph))) $;

--| An instance of ~ ax-11 proved without it. The converse may not be provable without ~ ax-11 (since using ~ alcomimw would require a DV on ` ph , x ` , which defeats the purpose). (Contributed by BJ, 22-Dec-2020.) (Proof modification is discouraged.)
theorem bj_ssblem2 {x3 y1: setvar} (ph: wff x3) (t: setvar):
  $ wi (wal x3 (wal y1 (wi (wceq (cv y1) (cv t)) (wi (wceq (cv x3) (cv y1)) ph)))) (wal y1 (wal x3 (wi (wceq (cv y1) (cv t)) (wi (wceq (cv x3) (cv y1)) ph)))) $;

--| A weaker form of ~ ax-12 and ~ ax12v , namely the generalization over ` x ` of the latter. In this statement, all occurrences of ` x ` are bound. (Contributed by BJ, 26-Dec-2020.) (Proof modification is discouraged.)
theorem bj_ax12v {x3 t: setvar} (ph: wff x3):
  $ wal x3 (wi (wceq (cv x3) (cv t)) (wi ph (wal x3 (wi (wceq (cv x3) (cv t)) ph)))) $;

--| Remove a DV condition from ~ bj-ax12v (using core axioms only). (Contributed by BJ, 26-Dec-2020.) (Proof modification is discouraged.)
theorem bj_ax12 {x3 t: setvar} (ph: wff x3 t):
  $ wal x3 (wi (wceq (cv x3) (cv t)) (wi ph (wal x3 (wi (wceq (cv x3) (cv t)) ph)))) $;

--| Axiom ~ bj-ax12 expressed using substitution. (Contributed by BJ, 26-Dec-2020.) (Proof modification is discouraged.)
theorem bj_ax12ssb {x3 t: setvar} (ph: wff x3 t):
  $ wsb x3 (wi ph (wsb x3 ph t)) t $;

--| Special case of ~ 19.41 proved from core axioms, ~ ax-10 (modal5), and ~ hba1 (modal4). (Contributed by BJ, 29-Dec-2020.) (Proof modification is discouraged.)
theorem bj_19_41al {x3: setvar} (ph ps: wff x3):
  $ wb (wex x3 (wa ph (wal x3 ps))) (wa (wex x3 ph) (wal x3 ps)) $;

--| Special case of ~ equsexv proved from core axioms, ~ ax-10 (modal5), and ~ hba1 (modal4). (Contributed by BJ, 29-Dec-2020.) (Proof modification is discouraged.)
theorem bj_equsexval {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph (wal x3 ps)) $ >
  $ wb (wex x3 (wa (wceq (cv x3) (cv y1)) ph)) (wal x3 ps) $;

--| Proof of ~ sbalex from core axioms, ~ ax-10 (modal5), and ~ bj-ax12 . (Contributed by BJ, 29-Dec-2020.) (Proof modification is discouraged.)
theorem bj_subst {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wex x3 (wa (wceq (cv x3) (cv y1)) ph)) (wal x3 (wi (wceq (cv x3) (cv y1)) ph)) $;

--| A special case of ~ sbequ2 . (Contributed by BJ, 22-Dec-2020.)
theorem bj_ssbid2 {x3: setvar} (ph: wff x3):
  $ wi (wsb x3 ph x3) ph $;

--| Alternate proof of ~ bj-ssbid2 , not using ~ sbequ2 . (Contributed by BJ, 22-Dec-2020.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_ssbid2ALT {x3: setvar} (ph: wff x3):
  $ wi (wsb x3 ph x3) ph $;

--| A special case of ~ sbequ1 . (Contributed by BJ, 22-Dec-2020.)
theorem bj_ssbid1 {x3: setvar} (ph: wff x3):
  $ wi ph (wsb x3 ph x3) $;

--| Alternate proof of ~ bj-ssbid1 , not using ~ sbequ1 . (Contributed by BJ, 22-Dec-2020.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_ssbid1ALT {x3: setvar} (ph: wff x3):
  $ wi ph (wsb x3 ph x3) $;

--| Lemma for ~ bj-ax6e . (Contributed by BJ, 22-Dec-2020.) (Proof modification is discouraged.)
theorem bj_ax6elem1 {x3 y1 z: setvar}:
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv y1) (cv z)) (wal x3 (wceq (cv y1) (cv z)))) $;

--| Lemma for ~ bj-ax6e . (Contributed by BJ, 22-Dec-2020.) (Proof modification is discouraged.)
theorem bj_ax6elem2 {x3 y1 z: setvar}:
  $ wi (wal x3 (wceq (cv y1) (cv z))) (wex x3 (wceq (cv x3) (cv y1))) $;

--| Proof of ~ ax6e (hence ~ ax6 ) from Tarski's system, ~ ax-c9 , ~ ax-c16 . Remark: ~ ax-6 is used only via its principal (unbundled) instance ~ ax6v . (Contributed by BJ, 22-Dec-2020.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_ax6e {x3 y1: setvar}:
  $ wex x3 (wceq (cv x3) (cv y1)) $;

--| A universal specialization result in deduction form, proved from ~ ax-1 -- ~ ax-6 , where the only DV condition is on ` x , y ` and where ` x ` should be nonfree in the new proposition ` ch ` (and in the context ` ph ` ). (Contributed by BJ, 4-Apr-2026.)
theorem bj_spim0 {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wi (wex x3 ch) ch) $ >
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wi ps ch) $ >
  $ wi ph (wi (wal x3 ps) ch) $;

--| Closed form of ~ spimvw . See also ~ spimt . (Contributed by BJ, 8-Nov-2021.)
theorem bj_spimvwt {x3: setvar} (ph: wff x3) (ps: wff) (y1: setvar):
  $ wi (wal x3 (wi (wceq (cv x3) (cv y1)) (wi ph ps))) (wi (wal x3 ph) ps) $;

--| Theorem close to a closed form of ~ spnfw . (Contributed by BJ, 12-May-2019.)
theorem bj_spnfw {x3: setvar} (ph ps: wff x3):
  $ wi (wi (wex x3 ph) ps) (wi (wal x3 ph) ps) $;

--| Change bound variable. This is to ~ cbvexvw what ~ cbvaliw is to ~ cbvalvw . TODO: move after ~ cbvalivw . (Contributed by BJ, 17-Mar-2020.)
theorem bj_cbvexiw {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wex x3 (wex y1 ps)) (wex y1 ps) $ >
  $ wi ph (wal y1 ph) $ >
  $ wi (wceq (cv y1) (cv x3)) (wi ph ps) $ >
  $ wi (wex x3 ph) (wex y1 ps) $;

--| Change bound variable. This is to ~ cbvexvw what ~ cbvalivw is to ~ cbvalvw . TODO: move after ~ cbvalivw . (Contributed by BJ, 17-Mar-2020.)
theorem bj_cbvexivw {x3 y1: setvar} (ph: wff x3) (ps: wff y1):
  $ wi (wceq (cv y1) (cv x3)) (wi ph ps) $ >
  $ wi (wex x3 ph) (wex y1 ps) $;

--| A short form of the axiom D of modal logic. (Contributed by BJ, 4-Apr-2021.)
theorem bj_modald {x3: setvar} (ph: wff x3):
  $ wi (wal x3 (wn ph)) (wn (wal x3 ph)) $;

--| A weakening of ~ ax-6 and ~ ax6v . (Contributed by BJ, 4-Apr-2021.) (New usage is discouraged.)
theorem bj_denot {y1: setvar} (x3: setvar):
  $ wi (wceq (cv x3) (cv x3)) (wn (wal y1 (wn (wceq (cv y1) (cv x3))))) $;

--| A lemma for substitutions, proved from Tarski's FOL. The version without DV ` ( x , y ) ` is true but requires ~ ax-13 . The disjoint variable condition DV ` ( x , ph ) ` is necessary for both directions: consider substituting ` x = z ` for ` ph ` . (Contributed by BJ, 25-May-2021.)
theorem bj_eqs {x3: setvar} (ph: wff) (y1: setvar):
  $ wb ph (wal x3 (wi (wceq (cv x3) (cv y1)) ph)) $;

--| Change bound variable. This is to ~ cbvexvw what ~ cbvalw is to ~ cbvalvw . (Contributed by BJ, 17-Mar-2020.)
theorem bj_cbvexw {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wex x3 (wex y1 ps)) (wex y1 ps) $ >
  $ wi ph (wal y1 ph) $ >
  $ wi (wex y1 (wex x3 ph)) (wex x3 ph) $ >
  $ wi ps (wal x3 ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wex x3 ph) (wex y1 ps) $;

--| The general statement that ~ ax12w proves. (Contributed by BJ, 20-Mar-2020.)
theorem bj_ax12w {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff x3 y1) (ch: wff y1 z) (th: wff x3 z):
  $ wi ph (wb ps ch) $ >
  $ wi (wceq (cv y1) (cv z)) (wb ps th) $ >
  $ wi ph (wi (wal y1 ps) (wal x3 (wi ph ps))) $;

--| A theorem which could be used as sole axiom for the non-logical predicate instead of ~ ax-8 and ~ ax-9 . Indeed, it is implied over propositional calculus by the conjunction of ~ ax-8 and ~ ax-9 , as proved here. In the other direction, one can prove ~ ax-8 (respectively ~ ax-9 ) from ~ bj-ax89 by using ~ mpan2 (respectively ~ mpan ) and ~ equid . TODO: move to main part. (Contributed by BJ, 3-Oct-2019.)
theorem bj_ax89 {x3 z: setvar} (y1 t: setvar):
  $ wi (wa (wceq (cv x3) (cv y1)) (wceq (cv z) (cv t))) (wi (wcel (cv x3) (cv z)) (wcel (cv y1) (cv t))) $;

--| One direction of ~ cleljust , requiring only ~ ax-1 -- ~ ax-5 and ~ ax8v1 . (Contributed by BJ, 31-Dec-2020.) (Proof modification is discouraged.)
theorem bj_cleljusti {z: setvar} (x3 y1: setvar):
  $ wi (wex z (wa (wceq (cv z) (cv x3)) (wcel (cv z) (cv y1)))) (wcel (cv x3) (cv y1)) $;

--| Commutation of two existential quantifiers on a formula is equivalent to commutation of two universal quantifiers over the same variables on the negation of that formula. Can be placed in the ~ ax-4 section, soon after ~ 2nexaln , and used to prove ~ excom . (Contributed by BJ, 29-Nov-2020.) (Proof modification is discouraged.)
theorem bj_alcomexcom {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wi (wal x3 (wal y1 (wn ph))) (wal y1 (wal x3 (wn ph)))) (wi (wex y1 (wex x3 ph)) (wex x3 (wex y1 ph))) $;

--| General statement that ~ hbald proves . (Contributed by BJ, 4-Apr-2026.)
theorem bj_hbald {x3 y1: setvar} (ph ps ch th: wff x3 y1):
  $ wi ph (wal y1 ps) $ >
  $ wi ps (wi ch (wal x3 th)) $ >
  $ wi ph (wi (wal y1 ch) (wal x3 (wal y1 th))) $;

--| Closed form of (general instance of) ~ hbal . (Contributed by BJ, 2-May-2019.)
theorem bj_hbalt {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wal y1 (wi ph (wal x3 ps))) (wi (wal y1 ph) (wal x3 (wal y1 ps))) $;

--| More general instance of ~ hbal . (Contributed by BJ, 4-Apr-2026.)
theorem bj_hbal {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi ph (wal x3 ps) $ >
  $ wi (wal y1 ph) (wal x3 (wal y1 ps)) $;

--| Proof of ~ axc11n from { ~ ax-1 -- ~ ax-7 , ~ axc11 } . Almost identical to ~ axc11nfromc11 . (Contributed by NM, 6-Jul-2021.) (Proof modification is discouraged.)
theorem axc11n11 {x3 y1: setvar}:
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wal y1 (wceq (cv y1) (cv x3))) $;

--| Proof of ~ axc11n from { ~ ax-1 -- ~ ax-7 , ~ axc9 , ~ axc11r } (note that ~ axc16 is provable from { ~ ax-1 -- ~ ax-7 , ~ axc11r }). Theorem ~ axc11n proves (over minimal calculus) that ~ axc11 and ~ axc11r are equivalent. Therefore, ~ axc11n11 and ~ axc11n11r prove that one can use one or the other as an axiom, provided one assumes the axioms listed above ( ~ axc11 appears slightly stronger since ~ axc11n11r requires ~ axc9 while ~ axc11n11 does not). (Contributed by BJ, 6-Jul-2021.) (Proof modification is discouraged.)
theorem axc11n11r {x3 y1: setvar}:
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wal y1 (wceq (cv y1) (cv x3))) $;

--| Proof of ~ axc16g from { ~ ax-1 -- ~ ax-7 , ~ axc16 }. (Contributed by BJ, 6-Jul-2021.) (Proof modification is discouraged.)
theorem bj_axc16g16 {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wi ph (wal z ph)) $;

--| A weak version of ~ ax-12 which is stronger than ~ ax12v . If one assumes reflexivity of equality ` |- x = x ` ( ~ equid ), then ~ bj-ax12v3 implies ~ ax-5 over modal logic K (substitute ` x ` for ` y ` ). See also ~ bj-ax12v3ALT . (Contributed by BJ, 6-Jul-2021.) (Proof modification is discouraged.)
theorem bj_ax12v3 {x3 y1: setvar} (ph: wff x3):
  $ wi (wceq (cv x3) (cv y1)) (wi ph (wal x3 (wi (wceq (cv x3) (cv y1)) ph))) $;

--| Alternate proof of ~ bj-ax12v3 . Uses ~ axc11r and ~ axc15 instead of ~ ax-12 . (Contributed by BJ, 6-Jul-2021.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_ax12v3ALT {x3 y1: setvar} (ph: wff x3):
  $ wi (wceq (cv x3) (cv y1)) (wi ph (wal x3 (wi (wceq (cv x3) (cv y1)) ph))) $;

--| A weak variant of ~ sbid2 not requiring ~ ax-13 nor ~ ax-10 . On top of Tarski's FOL, one implication requires only ~ ax12v , and the other requires only ~ sp . (Contributed by BJ, 25-May-2021.)
theorem bj_sb {x3 y1: setvar} (ph: wff x3):
  $ wb ph (wal y1 (wi (wceq (cv y1) (cv x3)) (wal x3 (wi (wceq (cv x3) (cv y1)) ph)))) $;

--| The predicate-calculus version of the axiom (B) of modal logic. See also ~ modal-b . (Contributed by BJ, 20-Oct-2019.)
theorem bj_modalbe {x3: setvar} (ph: wff x3):
  $ wi ph (wal x3 (wex x3 ph)) $;

--| Closed form of ~ sps . Once in main part, prove ~ sps and ~ spsd from it. (Contributed by BJ, 20-Oct-2019.)
theorem bj_spst {x3: setvar} (ph ps: wff x3):
  $ wi (wi ph ps) (wi (wal x3 ph) ps) $;

--| Closed form of ~ 19.21bi . (Contributed by BJ, 20-Oct-2019.)
theorem bj_19_21bit {x3: setvar} (ph ps: wff x3):
  $ wi (wi ph (wal x3 ps)) (wi ph ps) $;

--| Closed form of ~ 19.23bi . (Contributed by BJ, 20-Oct-2019.)
theorem bj_19_23bit {x3: setvar} (ph ps: wff x3):
  $ wi (wi (wex x3 ph) ps) (wi ph ps) $;

--| Closed form of ~ nexr . Contrapositive of ~ 19.8a . (Contributed by BJ, 20-Oct-2019.)
theorem bj_nexrt {x3: setvar} (ph: wff x3):
  $ wi (wn (wex x3 ph)) (wn ph) $;

--| Closed form of ~ alrimi . (Contributed by BJ, 2-May-2019.)
theorem bj_alrim {x3: setvar} (ph ps: wff x3):
  $ wi (wnf x3 ph) (wi (wal x3 (wi ph ps)) (wi ph (wal x3 ps))) $;

--| Uncurried (imported) form of ~ bj-alrim . (Contributed by BJ, 2-May-2019.)
theorem bj_alrim2 {x3: setvar} (ph ps: wff x3):
  $ wi (wa (wnf x3 ph) (wal x3 (wi ph ps))) (wi ph (wal x3 ps)) $;

--| A theorem close to a closed form of ~ nf5d and ~ nf5dh . (Contributed by BJ, 2-May-2019.)
theorem bj_nfdt0 {x3: setvar} (ph ps: wff x3):
  $ wi (wal x3 (wi ph (wi ps (wal x3 ps)))) (wi (wal x3 ph) (wnf x3 ps)) $;

--| Closed form of ~ nf5d and ~ nf5dh . (Contributed by BJ, 2-May-2019.)
theorem bj_nfdt {x3: setvar} (ph ps: wff x3):
  $ wi (wal x3 (wi ph (wi ps (wal x3 ps)))) (wi (wi ph (wal x3 ph)) (wi ph (wnf x3 ps))) $;

--| Closed form of ~ nexd . (Contributed by BJ, 20-Oct-2019.)
theorem bj_nexdt {x3: setvar} (ph ps: wff x3):
  $ wi (wnf x3 ph) (wi (wal x3 (wi ph (wn ps))) (wi ph (wn (wex x3 ps)))) $;

--| Closed form of ~ nexdv . (Contributed by BJ, 20-Oct-2019.)
theorem bj_nexdvt {x3: setvar} (ph: wff) (ps: wff x3):
  $ wi (wal x3 (wi ph (wn ps))) (wi ph (wn (wex x3 ps))) $;

--| Adding a second quantifier over the same variable is a transparent operation, ( ` A. E. ` case). (Contributed by BJ, 20-Oct-2019.)
theorem bj_alexbiex {x3: setvar} (ph: wff x3):
  $ wb (wal x3 (wex x3 ph)) (wex x3 ph) $;

--| Adding a second quantifier over the same variable is a transparent operation, ( ` E. E. ` case). (Contributed by BJ, 20-Oct-2019.)
theorem bj_exexbiex {x3: setvar} (ph: wff x3):
  $ wb (wex x3 (wex x3 ph)) (wex x3 ph) $;

--| Adding a second quantifier over the same variable is a transparent operation, ( ` A. A. ` case). (Contributed by BJ, 20-Oct-2019.)
theorem bj_alalbial {x3: setvar} (ph: wff x3):
  $ wb (wal x3 (wal x3 ph)) (wal x3 ph) $;

--| Adding a second quantifier over the same variable is a transparent operation, ( ` E. A. ` case). (Contributed by BJ, 20-Oct-2019.)
theorem bj_exalbial {x3: setvar} (ph: wff x3):
  $ wb (wex x3 (wal x3 ph)) (wal x3 ph) $;

--| Strengthening ~ 19.9ht by replacing its consequent with a biconditional ( ~ 19.9t does have a biconditional consequent). This propagates. (Contributed by BJ, 20-Oct-2019.)
theorem bj_19_9htbi {x3: setvar} (ph: wff x3):
  $ wi (wal x3 (wi ph (wal x3 ph))) (wb (wex x3 ph) ph) $;

--| Strengthening ~ hbnt by replacing its consequent with a biconditional. See also ~ hbntg and ~ hbntal . (Contributed by BJ, 20-Oct-2019.) Proved from ~ bj-19.9htbi . (Proof modification is discouraged.)
theorem bj_hbntbi {x3: setvar} (ph: wff x3):
  $ wi (wal x3 (wi ph (wal x3 ph))) (wb (wn ph) (wal x3 (wn ph))) $;

--| A general FOL biconditional that generalizes ~ 19.9ht among others. For this and the following theorems, see also ~ 19.35 , ~ 19.21 , ~ 19.23 . When ` ph ` is substituted for ` ps ` , both sides express a form of nonfreeness. (Contributed by BJ, 20-Oct-2019.)
theorem bj_biexal1 {x3: setvar} (ph ps: wff x3):
  $ wb (wal x3 (wi ph (wal x3 ps))) (wi (wex x3 ph) (wal x3 ps)) $;

--| When ` ph ` is substituted for ` ps ` , both sides express a form of nonfreeness. (Contributed by BJ, 20-Oct-2019.)
theorem bj_biexal2 {x3: setvar} (ph ps: wff x3):
  $ wb (wal x3 (wi (wex x3 ph) ps)) (wi (wex x3 ph) (wal x3 ps)) $;

--| When ` ph ` is substituted for ` ps ` , both sides express a form of nonfreeness. (Contributed by BJ, 20-Oct-2019.)
theorem bj_biexal3 {x3: setvar} (ph ps: wff x3):
  $ wb (wal x3 (wi ph (wal x3 ps))) (wal x3 (wi (wex x3 ph) ps)) $;

--| When ` ph ` is substituted for ` ps ` , both sides express a form of nonfreeness. (Contributed by BJ, 20-Oct-2019.)
theorem bj_bialal {x3: setvar} (ph ps: wff x3):
  $ wb (wal x3 (wi (wal x3 ph) ps)) (wi (wal x3 ph) (wal x3 ps)) $;

--| When ` ph ` is substituted for ` ps ` , both sides express a form of nonfreeness. (Contributed by BJ, 20-Oct-2019.)
theorem bj_biexex {x3: setvar} (ph ps: wff x3):
  $ wb (wal x3 (wi ph (wex x3 ps))) (wi (wex x3 ph) (wex x3 ps)) $;

--| A more general instance of the deduction form of ~ hbex . (Contributed by BJ, 4-Apr-2026.)
theorem bj_hbexd {x3 y1: setvar} (ph ps ch th: wff x3 y1):
  $ wi ph (wal y1 ps) $ >
  $ wi ps (wi ch (wal x3 th)) $ >
  $ wi ph (wi (wex y1 ch) (wal x3 (wex y1 th))) $;

--| Closed form of ~ bj-hbex and ~ hbex . (Contributed by BJ, 10-Oct-2019.)
theorem bj_hbext {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wal y1 (wal x3 (wi ph (wal x3 ps)))) (wi (wex y1 ph) (wal x3 (wex y1 ps))) $;

--| A more general instance of ~ hbex . (Contributed by BJ, 4-Apr-2026.)
theorem bj_hbex {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi ph (wal x3 ps) $ >
  $ wi (wex y1 ph) (wal x3 (wex y1 ps)) $;

--| Closed form of ~ nfal . (Contributed by BJ, 2-May-2019.)
theorem bj_nfalt {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wnf y1 ph)) (wnf y1 (wal x3 ph)) $;

--| Closed form of ~ nfex . (Contributed by BJ, 10-Oct-2019.)
theorem bj_nfext {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wnf y1 ph)) (wnf y1 (wex x3 ph)) $;

--| Version of ~ exdistrv with a disjoint variable condition on ` x , y ` not requiring ~ ax-11 . (The same can be done with ~ eeeanv and ~ ee4anv .) (Contributed by BJ, 29-Sep-2019.) (Proof modification is discouraged.)
theorem bj_eeanvw {x3 y1: setvar} (ph: wff x3) (ps: wff y1):
  $ wb (wex x3 (wex y1 (wa ph ps))) (wa (wex x3 ph) (wex y1 ps)) $;

--| First-order logic form of the modal axiom (4). See ~ hba1 . This is the standard proof of the implication in modal logic (B5 ` => ` 4). Its dual statement is ~ bj-modal4e . (Contributed by BJ, 12-Aug-2023.) (Proof modification is discouraged.)
theorem bj_modal4 {x3: setvar} (ph: wff x3):
  $ wi (wal x3 ph) (wal x3 (wal x3 ph)) $;

--| First-order logic form of the modal axiom (4) using existential quantifiers. Dual statement of ~ bj-modal4 ( ~ hba1 ). (Contributed by BJ, 21-Dec-2020.) (Proof modification is discouraged.)
theorem bj_modal4e {x3: setvar} (ph: wff x3):
  $ wi (wex x3 (wex x3 ph)) (wex x3 ph) $;

--| A short form of the axiom B of modal logic using only primitive symbols ( ` -> , -. , A. ` ). (Contributed by BJ, 4-Apr-2021.) (Proof modification is discouraged.)
theorem bj_modalb {x3: setvar} (ph: wff x3):
  $ wi (wn ph) (wal x3 (wn (wal x3 ph))) $;

--| When ` ph ` is substituted for ` ps ` , this is the first half of nonfreness ` ( . -> A. ) ` of the weak form of nonfreeness ` ( E. -> A. ) ` . (Contributed by BJ, 9-Dec-2023.)
theorem bj_wnf1 {x3: setvar} (ph ps: wff x3):
  $ wi (wi (wex x3 ph) (wal x3 ps)) (wal x3 (wi (wex x3 ph) (wal x3 ps))) $;

--| When ` ph ` is substituted for ` ps ` , this is the first half of nonfreness ` ( . -> A. ) ` of the weak form of nonfreeness ` ( E. -> A. ) ` . (Contributed by BJ, 9-Dec-2023.)
theorem bj_wnf2 {x3: setvar} (ph ps: wff x3):
  $ wi (wex x3 (wi (wex x3 ph) (wal x3 ps))) (wi (wex x3 ph) (wal x3 ps)) $;

--| When ` ph ` is substituted for ` ps ` , this statement expresses that weak nonfreeness implies the universal form of nonfreeness. (Contributed by BJ, 9-Dec-2023.)
theorem bj_wnfanf {x3: setvar} (ph ps: wff x3):
  $ wi (wi (wex x3 ph) (wal x3 ps)) (wal x3 (wi ph (wal x3 ps))) $;

--| When ` ph ` is substituted for ` ps ` , this statement expresses that weak nonfreeness implies the existential form of nonfreeness. (Contributed by BJ, 9-Dec-2023.)
theorem bj_wnfenf {x3: setvar} (ph ps: wff x3):
  $ wi (wi (wex x3 ph) (wal x3 ps)) (wal x3 (wi (wex x3 ph) ps)) $;

--| See ~ 19.12 . Could be labeled "exalimalex" for "'there exists for all' implies 'for all there exists'". This proof is from ~ excom and modal (B) on top of modalK logic. (Contributed by BJ, 12-Aug-2023.) The proof should not rely on ~ df-nf or ~ df-bj-nnf , directly or indirectly. (Proof modification is discouraged.)
theorem bj_19_12 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wex x3 (wal y1 ph)) (wal y1 (wex x3 ph)) $;

--| Equivalent form of the axiom of substitution ~ bj-ax12 . Although both sides need a DV condition on ` x , t ` (or as in ~ bj-ax12v3 on ` t , ph ` ) to hold, their equivalence holds without DV conditions. The forward implication is proved in modal (K4) while the reverse implication is proved in modal (T5). The LHS has the advantage of not involving nested quantifiers on the same variable. Its metaweakening is proved from the core axiom schemes in ~ bj-substw . In the LHS, the reverse implication holds by ~ equs4 (or ~ equs4v if a DV condition is added on ` x , t ` as in ~ bj-ax12 ), and the forward implication is ~ sbalex . The LHS can be read as saying that if there exists a variable equal to a given term witnessing a given formula, then all variables equal to that term also witness that formula. The equivalent form of the LHS using only primitive symbols is ` ( A. x ( x = t -> ph ) \/ A. x ( x = t -> -. ph ) ) ` , which expresses that a given formula is true at all variables equal to a given term, or false at all these variables. An equivalent form of the LHS using only the existential quantifier is ` -. ( E. x ( x = t /\ ph ) /\ E. x ( x = t /\ -. ph ) ) ` , which expresses that there can be no two variables both equal to a given term, one witnessing a formula and the other witnessing its negation. These equivalences do not hold in intuitionistic logic. The LHS should be the preferred form, and has the advantage of having no negation nor nested quantifiers. (Contributed by BJ, 21-May-2024.) (Proof modification is discouraged.)
theorem bj_substax12 {x3: setvar} (ph: wff x3) (t: setvar):
  $ wb (wi (wex x3 (wa (wceq (cv x3) (cv t)) ph)) (wal x3 (wi (wceq (cv x3) (cv t)) ph))) (wal x3 (wi (wceq (cv x3) (cv t)) (wi ph (wal x3 (wi (wceq (cv x3) (cv t)) ph))))) $;

--| Weak form of the LHS of ~ bj-substax12 proved from the core axiom schemes. Compare ~ ax12w . (Contributed by BJ, 26-May-2024.) (Proof modification is discouraged.)
theorem bj_substw {x3 t: setvar} (ph: wff x3 t) (ps: wff t):
  $ wi (wceq (cv x3) (cv t)) (wb ph ps) $ >
  $ wi (wex x3 (wa (wceq (cv x3) (cv t)) ph)) (wal x3 (wi (wceq (cv x3) (cv t)) ph)) $;

--| Syntax for the nonfreeness quantifier.
term wnnf {x3: setvar} (ph: wff x3): wff;

--| Definition of the nonfreeness quantifier. The formula ` F// x ph ` has the intended meaning that the variable ` x ` is semantically nonfree in the formula ` ph ` . The motivation for this quantifier is to have a condition expressible in the logic which is as close as possible to the non-occurrence condition DV ` ( x , ph ) ` (in Metamath files, "$d x ph $."), which belongs to the metalogic. The standard syntactic nonfreeness condition, also expressed in the metalogic, is intermediate between these two notions: semantic nonfreeness implies syntactic nonfreeness, which implies non-occurrence. Both implications are strict; for the first, note that ` |- F// x x = x ` , that is, ` x ` is semantically (but not syntactically) nonfree in the formula ` x = x ` ; for the second, note that ` x ` is syntactically nonfree in the formula ` A. x x = x ` although it occurs in it. We now prove two metatheorems which make precise the above fact that, as far as proving power is concerned, the nonfreeness condition ` F// x ph ` is very close to the non-occurrence condition DV ` ( x , ph ) ` . Let S be a Metamath system with the FOL-syntax of (i)set.mm, containing intuitionistic positive propositional calculus and ~ ax-5 and ~ ax5e . Theorem 1. If the scheme ` ( F// x ph & ` PHI_1 ` & ... & ` PHI_n ` => ` PHI_0, DV) is provable in S, then so is the scheme (PHI_1 ` & ... & ` PHI_n ` => ` PHI_0, DV ` u. { { x , ph } } ) ` . Proof: By ~ bj-nnfv , we can prove ` ( F// x ph , { { x , ph } } ) ` , from which the theorem follows. QED Theorem 2. Suppose that S also contains (the FOL version of) modal logic KB and commutation of quantifiers ~ alcom and ~ excom (possibly weakened by a DV condition on the quantifying variables), and that S can be axiomatized such that the only axioms with a DV condition involving a formula variable are among ~ ax-5 , ~ ax5e , ~ ax5ea . If the scheme (PHI_1 ` & ... & ` PHI_n ` => ` PHI_0, DV) is provable in S, then so is the scheme ` ( F// x ph & ` PHI_1 ` & ... & ` PHI_n ` => ` PHI_0, DV ` \ { { x , ph } } ) ` . More precisely, if S contains modal 45 and if the variables quantified over in PHI_0, ..., PHI_n are among ` x `_1, ..., ` x `_m, then the scheme (PHI_1 ` & ... & ` PHI_n ` => ` (antecedent ` -> ` PHI_0), DV ` \ { { x , ph } } ) ` is provable in S, where the antecedent is a finite conjunction of formulas of the form ` A. x `_i1 ` ... A. x `_ip ` F// x ph ` where the ` x `_ij's are among the ` x `_i's. Lemma: If ` x e/ ` OC(PHI), then S proves the scheme ` ( F// x ph => F// x ` PHI, ` { { x , a } | a e. ` OC(PHI) ` \ { ph } } ) ` . More precisely, if the variables quantified over in PHI are among ` x `_1, ..., ` x `_m, then ((antecedent ` -> F// x ` PHI), ` { { x , a } | a e. ` OC(PHI) ` \ { ph } } ) ` is provable in S, with the same form of antecedent as above. Proof: By induction on the height of PHI. We first note that by ~ bj-nnfbi we can assume that PHI contains only primitive (as opposed to defined) symbols. For the base case, atomic formulas are either ` ph ` , in which case the scheme to prove is an instance of ~ id , or have variables all in OC(PHI) ` \ { ph } ` , so ` ( F// x ` PHI, ` { { x , a } | a e. ` OC(PHI) ` \ { ph } } ) ` by ~ bj-nnfv , hence ` ( ( F// x ph -> F// x ` PHI), ` { { x , a } | a e. ` OC(PHI) ` \ { ph } } ) ` by ~ a1i . For the induction step, PHI is either an implication, a negation, a conjunction, a disjunction, a biconditional, a universal or an existential quantification of formulas where ` x ` does not occur. We use respectively ~ bj-nnfim , ~ bj-nnfnt , ~ bj-nnfan , ~ bj-nnfor , ~ bj-nnfbit , ~ bj-nnfalt , ~ bj-nnfext . For instance, in the implication case, if we have by induction hypothesis ` ( ( A. x `_1 ` ... A. x `_m ` F// x ph -> F// x ` PHI), ` { { x , a } | a e. ` OC(PHI) ` \ { ph } } ) ` and ` ( ( A. y `_1 ` ... A. y `_n ` F// x ph -> F// x ` PSI), ` { { x , a } | a e. ` OC(PSI) ` \ { ph } } ) ` , then ~ bj-nnfim yields ` ( ( ( A. x `_1 ` ... A. x `_m ` F// x ph /\ A. y `_1 ` ... A. y `_n ` F// x ph ) -> F// x ` (PHI ` -> ` PSI)), ` { { x , a } | a e. ` OC(PHI ` -> ` PSI) ` \ { ph } } ) ` and similarly for antecedents which are conjunctions as in the statement of the lemma. In the universal quantification case, say quantification over ` y ` , if we have by induction hypothesis ` ( ( A. x `_1 ` ... A. x `_m ` F// x ph -> F// x ` PHI), ` { { x , a } | a e. ` OC(PHI) ` \ { ph } } ) ` , then ~ bj-nnfalt yields ` ( ( A. y A. x `_1 ` ... A. x `_m ` F// x ph -> F// x A. y ` PHI), ` { { x , a } | a e. ` OC( ` A. y ` PHI) ` \ { ph } } ) ` and similarly for antecedents which are conjunctions as in the statement of the lemma. Note ~ bj-nnfalt and ~ bj-nnfext are proved from positive propositional calculus with ~ alcom and ~ excom (possibly weakened by a DV condition on the quantifying variables), and modalB (via ~ bj-19.12 ). QED Proof of the theorem: Consider a proof of that scheme directly from the axioms. Consider a step where a DV condition involving ` ph ` is used. By hypothesis, that step is an instance of ~ ax-5 or ~ ax5e or ~ ax5ea . It has the form (PSI ` -> A. x ` PSI) where PSI has the form of the lemma and the DV conditions of the proof contain ` { { x , a } | a e. ` OC(PSI) ` } ` . Therefore, one has ` ( ( A. x `_1 ` ... A. x `_m ` F// x ph -> F// x ` PSI), ` { { x , a } | a e. ` OC(PSI) ` \ { ph } } ) ` for appropriate ` x `_i's, and by ~ bj-nnfa we obtain ` ( ( A. x `_1 ` ... A. x `_m ` F// x ph -> ` (PSI ` -> A. x ` PSI)), ` { { x , a } | a e. ` OC(PSI) ` \ { ph } } ) ` and similarly for antecedents which are conjunctions as in the statement of the theorem. Similarly if the step is using ~ ax5e or ~ ax5ea , we would use ~ bj-nnfe or ~ bj-nnfea respectively. Therefore, taking as antecedent of the theorem to prove the conjunction of all the antecedents at each of these steps, we obtain a proof by "carrying the context over", which is possible, as in the deduction theorem when the step uses ~ ax-mp , and when the step uses ~ ax-gen , by ~ bj-nnf-alrim and ~ bj-nnfa1 (which requires modal 45). The condition DV ` ( x , ph ) ` is not required by the resulting proof. Finally, there may be in the global antecedent thus constructed some dummy variables, which can be removed by ~ spvw . QED Compared with ~ df-nf , the present definition is stricter on positive propositional calculus ( ~ bj-nnfnfTEMP ) and equivalent on core FOL plus ~ sp ( ~ bj-nfnnfTEMP ). While being stricter, it still holds for non-occurring variables ( ~ bj-nnfv ), which is the basic requirement for this quantifier. In particular, it translates more closely the associated variable disjointness condition. Since the nonfreeness quantifier is a means to translate a variable disjointness condition from the metalogic to the logic, it seems preferable. Also, since nonfreeness is mainly used as a hypothesis, this definition would allow more theorems, notably the 19.xx theorems, to be proved from the core axioms, without needing a 19.xxv variant. One can devise infinitely many definitions increasingly close to the non-occurring condition, like ` ( ( E. x ph -> ph ) /\ ( ph -> A. x ph ) ) /\ ` ` A. x ( ( E. x ph -> ph ) /\ ( ph -> A. x ph ) ) /\ A. x A. x ` ... and each stronger definition would permit more theorems to be proved from the core axioms. A reasonable rule seems to be to stop before nested quantifiers appear (since they typically require ~ ax-10 to work with), and also not to have redundant conjuncts when full metacomplete FOL= is developed. (Contributed by BJ, 28-Jul-2023.)
axiom df_bj_nnf {x3: setvar} (ph: wff x3):
  $ wb (wnnf x3 ph) (wa (wi (wex x3 ph) ph) (wi ph (wal x3 ph))) $;

--| Nonfreeness implies the equivalent of ~ ax-5 . See ~ nf5r . (Contributed by BJ, 28-Jul-2023.)
theorem bj_nnfa {x3: setvar} (ph: wff x3):
  $ wi (wnnf x3 ph) (wi ph (wal x3 ph)) $;

--| Nonfreeness implies the equivalent of ~ ax-5 , deduction form. See ~ nf5rd . (Contributed by BJ, 2-Dec-2023.)
theorem bj_nnfad {x3: setvar} (ph ps: wff x3):
  $ wi ph (wnnf x3 ps) $ >
  $ wi ph (wi ps (wal x3 ps)) $;

--| Nonfreeness implies the equivalent of ~ ax-5 , inference form. See ~ nf5ri . (Contributed by BJ, 22-Sep-2024.)
theorem bj_nnfai {x3: setvar} (ph: wff x3):
  $ wnnf x3 ph $ >
  $ wi ph (wal x3 ph) $;

--| Nonfreeness implies the equivalent of ~ ax5e . (Contributed by BJ, 28-Jul-2023.)
theorem bj_nnfe {x3: setvar} (ph: wff x3):
  $ wi (wnnf x3 ph) (wi (wex x3 ph) ph) $;

--| Nonfreeness implies the equivalent of ~ ax5e , deduction form. (Contributed by BJ, 2-Dec-2023.)
theorem bj_nnfed {x3: setvar} (ph ps: wff x3):
  $ wi ph (wnnf x3 ps) $ >
  $ wi ph (wi (wex x3 ps) ps) $;

--| Nonfreeness implies the equivalent of ~ ax5e , inference form. (Contributed by BJ, 22-Sep-2024.)
theorem bj_nnfei {x3: setvar} (ph: wff x3):
  $ wnnf x3 ph $ >
  $ wi (wex x3 ph) ph $;

--| Nonfreeness implies the equivalent of ~ ax5ea . (Contributed by BJ, 28-Jul-2023.)
theorem bj_nnfea {x3: setvar} (ph: wff x3):
  $ wi (wnnf x3 ph) (wi (wex x3 ph) (wal x3 ph)) $;

--| Nonfreeness implies the equivalent of ~ ax5ea , deduction form. (Contributed by BJ, 2-Dec-2023.)
theorem bj_nnfead {x3: setvar} (ph ps: wff x3):
  $ wi ph (wnnf x3 ps) $ >
  $ wi ph (wi (wex x3 ps) (wal x3 ps)) $;

--| Nonfreeness implies the equivalent of ~ ax5ea , inference form. (Contributed by BJ, 22-Sep-2024.)
theorem bj_nnfeai {x3: setvar} (ph: wff x3):
  $ wnnf x3 ph $ >
  $ wi (wex x3 ph) (wal x3 ph) $;

--| In deduction-style proofs, it is equivalent to assert that the context holds for all values of a variable, or that is does not depend on that variable. (Contributed by BJ, 28-Mar-2026.)
theorem bj_alnnf {x3: setvar} (ph: wff x3):
  $ wb (wi ph (wal x3 ph)) (wi ph (wnnf x3 ph)) $;

--| If a proposition holds, then it holds for all values of a given variable if and only if it does not depend on that variable. (Contributed by BJ, 28-Mar-2026.)
theorem bj_alnnf2 {x3: setvar} (ph: wff x3):
  $ wi ph (wb (wal x3 ph) (wnnf x3 ph)) $;

--| Alternate definition of ~ df-bj-nnf using only primitive symbols ( ` -> ` , ` -. ` , ` A. ` ) in each conjunct. (Contributed by BJ, 20-Aug-2023.)
theorem bj_dfnnf2 {x3: setvar} (ph: wff x3):
  $ wb (wnnf x3 ph) (wa (wi ph (wal x3 ph)) (wi (wn ph) (wal x3 (wn ph)))) $;

--| New nonfreeness implies old nonfreeness on minimal implicational calculus (the proof indicates it uses ~ ax-3 because of set.mm's definition of the biconditional, but the proof actually holds in minimal implicational calculus). (Contributed by BJ, 28-Jul-2023.) The proof should not rely on ~ df-nf except via ~ df-nf directly. (Proof modification is discouraged.)
theorem bj_nnfnfTEMP {x3: setvar} (ph: wff x3):
  $ wi (wnnf x3 ph) (wnf x3 ph) $;

--| A consequence of nonfreeness in the antecedent and the consequent of an implication. (Contributed by BJ, 27-Aug-2023.)
theorem bj_nnfim1 {x3: setvar} (ph ps: wff x3):
  $ wi (wa (wnnf x3 ph) (wnnf x3 ps)) (wi (wi ph ps) (wi (wex x3 ph) (wal x3 ps))) $;

--| A consequence of nonfreeness in the antecedent and the consequent of an implication. (Contributed by BJ, 27-Aug-2023.)
theorem bj_nnfim2 {x3: setvar} (ph ps: wff x3):
  $ wi (wa (wnnf x3 ph) (wnnf x3 ps)) (wi (wi (wal x3 ph) (wex x3 ps)) (wi ph ps)) $;

--| A variable is nonfree in a theorem. The antecedent is in the "strong necessity" modality of modal logic in order not to require ~ sp (modal T), as in ~ bj-nnfbi . (Contributed by BJ, 28-Jul-2023.)
theorem bj_nnftht {x3: setvar} (ph: wff x3):
  $ wi (wa ph (wal x3 ph)) (wnnf x3 ph) $;

--| A variable is nonfree in a theorem, inference form. (Contributed by BJ, 28-Jul-2023.)
theorem bj_nnfth {x3: setvar} (ph: wff x3):
  $ ph $ >
  $ wnnf x3 ph $;

--| Proof of the closed form of ~ alrimi from modalK (compare ~ alrimiv ). See also ~ bj-alrim . Actually, most proofs between ~ 19.3t and ~ 2sbbid could be proved without ~ ax-12 . (Contributed by BJ, 20-Aug-2023.)
theorem bj_nnf_alrim {x3: setvar} (ph ps: wff x3):
  $ wi (wnnf x3 ph) (wi (wal x3 (wi ph ps)) (wi ph (wal x3 ps))) $;

--| Alias of ~ bj-nnf-alrim for labeling consistency (a standard predicate calculus axiom). Closed form of ~ stdpc5 proved from modalK (obsoleting ~ stdpc5v ). (Contributed by BJ, 2-Dec-2023.) Use ~ bj-nnf-alrim instead. (New usaged is discouraged.)
theorem bj_stdpc5t {x3: setvar} (ph ps: wff x3):
  $ wi (wnnf x3 ph) (wi (wal x3 (wi ph ps)) (wi ph (wal x3 ps))) $;

--| If two formulas are equivalent, then nonfreeness of a variable in one of them is equivalent to nonfreeness in the other. Compare ~ nfbiit . From this and ~ bj-nnfim and ~ bj-nnfnt , one can prove analogous nonfreeness conservation results for other propositional operators. The antecedent is in the "strong necessity" modality of modal logic (see also ~ bj-nnftht ) in order not to require ~ sp (modal T). (Contributed by BJ, 27-Aug-2023.)
theorem bj_nnfbi {x3: setvar} (ph ps: wff x3):
  $ wi (wa (wb ph ps) (wal x3 (wb ph ps))) (wb (wnnf x3 ph) (wnnf x3 ps)) $;

--| If two formulas are equivalent, then nonfreeness of a variable in one of them is equivalent to nonfreeness in the other, deduction form. The antecedent of the conclusion is in the "strong necessity" modality of modal logic (see also ~ bj-nnftht ) in order not to require ~ sp (modal T). See ~ bj-nnfbi . (Contributed by BJ, 21-Mar-2026.)
theorem bj_nnfbd0 {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wb ps ch) $ >
  $ wi (wa ph (wal x3 ph)) (wb (wnnf x3 ps) (wnnf x3 ch)) $;

--| If two formulas are equivalent, then nonfreeness of a variable in one of them is equivalent to nonfreeness in the other, inference form. See ~ bj-nnfbi . (Contributed by BJ, 18-Nov-2023.)
theorem bj_nnfbii {x3: setvar} (ph ps: wff x3):
  $ wb ph ps $ >
  $ wb (wnnf x3 ph) (wnnf x3 ps) $;

--| A variable is nonfree in a formula if and only if it is nonfree in its negation. The foward implication is intuitionistically valid (and that direction is sufficient for the purpose of recursively proving that some formulas have a given variable not free in them, like ~ bj-nnfim ). Intuitionistically, ` |- ( F// x -. ph <-> F// x -. -. ph ) ` . See ~ nfnt . (Contributed by BJ, 28-Jul-2023.)
theorem bj_nnfnt {x3: setvar} (ph: wff x3):
  $ wb (wnnf x3 ph) (wnnf x3 (wn ph)) $;

--| A variable is nonfree in the negation of a theorem, inference form. (Contributed by BJ, 27-Aug-2023.)
theorem bj_nnfnth {x3: setvar} (ph: wff x3):
  $ wn ph $ >
  $ wnnf x3 ph $;

--| Nonfreeness in the antecedent and the consequent of an implication implies nonfreeness in the implication. (Contributed by BJ, 27-Aug-2023.)
theorem bj_nnfim {x3: setvar} (ph ps: wff x3):
  $ wi (wa (wnnf x3 ph) (wnnf x3 ps)) (wnnf x3 (wi ph ps)) $;

--| Nonfreeness in the antecedent and the consequent of an implication implies nonfreeness in the implication, deduction form. (Contributed by BJ, 2-Dec-2023.)
theorem bj_nnfimd {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wnnf x3 ps) $ >
  $ wi ph (wnnf x3 ch) $ >
  $ wi ph (wnnf x3 (wi ps ch)) $;

--| Nonfreeness in both conjuncts implies nonfreeness in the conjunction. (Contributed by BJ, 19-Nov-2023.) In classical logic, there is a proof using the definition of conjunction in terms of implication and negation, so using ~ bj-nnfim , ~ bj-nnfnt and ~ bj-nnfbi , but we want a proof valid in intuitionistic logic. (Proof modification is discouraged.)
theorem bj_nnfan {x3: setvar} (ph ps: wff x3):
  $ wi (wa (wnnf x3 ph) (wnnf x3 ps)) (wnnf x3 (wa ph ps)) $;

--| Nonfreeness in both conjuncts implies nonfreeness in the conjunction, deduction form. Note: compared with the proof of ~ bj-nnfan , it has two more essential steps but fewer total steps (since there are fewer intermediate formulas to build) and is easier to follow and understand. This statement is of intermediate complexity: for simpler statements, closed-style proofs like that of ~ bj-nnfan will generally be shorter than deduction-style proofs while still easy to follow, while for more complex statements, the opposite will be true (and deduction-style proofs like that of ~ bj-nnfand will generally be easier to understand). (Contributed by BJ, 19-Nov-2023.) (Proof modification is discouraged.)
theorem bj_nnfand {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wnnf x3 ps) $ >
  $ wi ph (wnnf x3 ch) $ >
  $ wi ph (wnnf x3 (wa ps ch)) $;

--| Nonfreeness in both disjuncts implies nonfreeness in the disjunction. (Contributed by BJ, 19-Nov-2023.) In classical logic, there is a proof using the definition of disjunction in terms of implication and negation, so using ~ bj-nnfim , ~ bj-nnfnt and ~ bj-nnfbi , but we want a proof valid in intuitionistic logic. (Proof modification is discouraged.)
theorem bj_nnfor {x3: setvar} (ph ps: wff x3):
  $ wi (wa (wnnf x3 ph) (wnnf x3 ps)) (wnnf x3 (wo ph ps)) $;

--| Nonfreeness in both disjuncts implies nonfreeness in the disjunction, deduction form. See comments for ~ bj-nnfor and ~ bj-nnfand . (Contributed by BJ, 2-Dec-2023.) (Proof modification is discouraged.)
theorem bj_nnford {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wnnf x3 ps) $ >
  $ wi ph (wnnf x3 ch) $ >
  $ wi ph (wnnf x3 (wo ps ch)) $;

--| Nonfreeness in both sides implies nonfreeness in the biconditional. (Contributed by BJ, 2-Dec-2023.) (Proof modification is discouraged.)
theorem bj_nnfbit {x3: setvar} (ph ps: wff x3):
  $ wi (wa (wnnf x3 ph) (wnnf x3 ps)) (wnnf x3 (wb ph ps)) $;

--| Nonfreeness in both sides implies nonfreeness in the biconditional, deduction form. (Contributed by BJ, 2-Dec-2023.) (Proof modification is discouraged.)
theorem bj_nnfbid {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wnnf x3 ps) $ >
  $ wi ph (wnnf x3 ch) $ >
  $ wi ph (wnnf x3 (wb ps ch)) $;

--| Proof of the closed form of ~ exlimi from modalK (compare ~ exlimiv ). See also ~ bj-sylget2 . (Contributed by BJ, 2-Dec-2023.)
theorem bj_nnf_exlim {x3: setvar} (ph ps: wff x3):
  $ wi (wnnf x3 ps) (wi (wal x3 (wi ph ps)) (wi (wex x3 ph) ps)) $;

--| Statement ~ 19.21t proved from modalK (obsoleting ~ 19.21v ). (Contributed by BJ, 2-Dec-2023.)
theorem bj_19_21t {x3: setvar} (ph ps: wff x3):
  $ wi (wnnf x3 ph) (wb (wal x3 (wi ph ps)) (wi ph (wal x3 ps))) $;

--| Statement ~ 19.23t proved from modalK (obsoleting ~ 19.23v ). (Contributed by BJ, 2-Dec-2023.)
theorem bj_19_23t {x3: setvar} (ph ps: wff x3):
  $ wi (wnnf x3 ps) (wb (wal x3 (wi ph ps)) (wi (wex x3 ph) ps)) $;

--| One direction of ~ 19.36 from the same axioms as ~ 19.36imv . (Contributed by BJ, 2-Dec-2023.)
theorem bj_19_36im {x3: setvar} (ph ps: wff x3):
  $ wi (wnnf x3 ps) (wi (wex x3 (wi ph ps)) (wi (wal x3 ph) ps)) $;

--| One direction of ~ 19.37 from the same axioms as ~ 19.37imv . (Contributed by BJ, 2-Dec-2023.)
theorem bj_19_37im {x3: setvar} (ph ps: wff x3):
  $ wi (wnnf x3 ph) (wi (wex x3 (wi ph ps)) (wi ph (wex x3 ps))) $;

--| Closed form of ~ 19.42 from the same axioms as ~ 19.42v . (Contributed by BJ, 2-Dec-2023.)
theorem bj_19_42t {x3: setvar} (ph ps: wff x3):
  $ wi (wnnf x3 ph) (wb (wex x3 (wa ph ps)) (wa ph (wex x3 ps))) $;

--| Closed form of ~ 19.41 from the same axioms as ~ 19.41v . The same is doable with ~ 19.27 , ~ 19.28 , ~ 19.31 , ~ 19.32 , ~ 19.44 , ~ 19.45 . (Contributed by BJ, 2-Dec-2023.)
theorem bj_19_41t {x3: setvar} (ph ps: wff x3):
  $ wi (wnnf x3 ps) (wb (wex x3 (wa ph ps)) (wa (wex x3 ph) ps)) $;

--| Version of ~ pm11.53v with nonfreeness antecedents. One can also prove the theorem with antecedent ` ( F// y A. x ph /\ A. y F// x ps ) ` . (Contributed by BJ, 7-Oct-2024.)
theorem bj_pm11_53vw {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wa (wal x3 (wnnf y1 ph)) (wnnf x3 (wal y1 ps))) (wb (wal x3 (wal y1 (wi ph ps))) (wi (wex x3 ph) (wal y1 ps))) $;

--| A non-occurring variable is nonfree in a formula. (Contributed by BJ, 28-Jul-2023.)
theorem bj_nnfv {x3: setvar} (ph: wff):
  $ wnnf x3 ph $;

--| If two formulas are equivalent, then nonfreeness of a variable in one of them is equivalent to nonfreeness in the other, deduction form. See ~ bj-nnfbi . (Contributed by BJ, 27-Aug-2023.)
theorem bj_nnfbd {x3: setvar} (ph: wff) (ps ch: wff x3):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wnnf x3 ps) (wnnf x3 ch)) $;

--| A variant of ~ pm11.53v . One can similarly prove a variant with DV ` ( y , ph ) ` and ` A. y F// x ps ` instead of DV ` ( x , ps ) ` and ` A. x F// y ph ` . (Contributed by BJ, 7-Oct-2024.)
theorem bj_pm11_53a {x3 y1: setvar} (ph: wff x3 y1) (ps: wff y1):
  $ wi (wal x3 (wnnf y1 ph)) (wb (wal x3 (wal y1 (wi ph ps))) (wi (wex x3 ph) (wal y1 ps))) $;

--| A variant of ~ equsv . (Contributed by BJ, 7-Oct-2024.)
theorem bj_equsvt {x3: setvar} (ph: wff x3) (y1: setvar):
  $ wi (wnnf x3 ph) (wb (wal x3 (wi (wceq (cv x3) (cv y1)) ph)) ph) $;

--| Variant of ~ equsalvw . (Contributed by BJ, 7-Oct-2024.)
theorem bj_equsalvwd {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wnnf x3 ch) $ >
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wb ps ch) $ >
  $ wi ph (wb (wal x3 (wi (wceq (cv x3) (cv y1)) ps)) ch) $;

--| Variant of ~ equsexvw . (Contributed by BJ, 7-Oct-2024.)
theorem bj_equsexvwd {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wnnf x3 ch) $ >
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wb ps ch) $ >
  $ wi ph (wb (wex x3 (wa (wceq (cv x3) (cv y1)) ps)) ch) $;

--| A universal specialization result in deduction form, proved from ~ ax-1 -- ~ ax-6 , where the only DV condition is on ` x , y ` and where ` x ` should be nonfree in the new proposition ` ch ` (and in the context ` ph ` ). (Contributed by BJ, 4-Apr-2026.)
theorem bj_nnf_spim {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wnnf x3 ch) $ >
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wi ps ch) $ >
  $ wi ph (wi (wal x3 ps) ch) $;

--| An existential generalization result in deduction form, from ~ ax-1 -- ~ ax-6 , where the only DV condition is on ` x , y ` , and where ` x ` should be nonfree in the new proposition ` ch ` (and in the context ` ph ` ). (Contributed by BJ, 4-Apr-2026.)
theorem bj_nnf_spime {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wnnf x3 ps) $ >
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wi ps ch) $ >
  $ wi ph (wi ps (wex x3 ch)) $;

--| The only DV conditions are those saying that ` y ` is a fresh variable used to construct ` ch ` . (Contributed by BJ, 4-Apr-2026.)
theorem bj_nnf_cbvaliv {x3 y1: setvar} (ph ps: wff x3) (ch: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wnnf x3 ch) $ >
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wi ps ch) $ >
  $ wi ph (wi (wal x3 ps) (wal y1 ch)) $;

--| Variant of ~ sbievw . (Contributed by BJ, 7-Oct-2024.)
theorem bj_sbievwd {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wnnf x3 ch) $ >
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wb ps ch) $ >
  $ wi ph (wb (wsb x3 ps y1) ch) $;

--| Version of ~ sbft using ` F// ` , proved from core axioms. (Contributed by BJ, 19-Nov-2023.)
theorem bj_sbft {x3 t: setvar} (ph: wff x3 t):
  $ wi (wnnf x3 ph) (wb (wsb x3 ph t) ph) $;

--| Compared with ~ bj-nnf-cbvaliv , replacing the DV condition on ` y , ps ` with the nonfreeness condition requires ~ ax-11 . (Contributed by BJ, 4-Apr-2026.)
theorem bj_nnf_cbvali {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wal y1 ph) $ >
  $ wi ph (wnnf y1 ps) $ >
  $ wi ph (wnnf x3 ch) $ >
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wi ps ch) $ >
  $ wi ph (wi (wal x3 ps) (wal y1 ch)) $;

--| Compared with ~ cbvalv1 , this saves ~ ax-12 . (Contributed by BJ, 4-Apr-2026.)
theorem bj_nnf_cbval {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wal y1 ph) $ >
  $ wi ph (wnnf y1 ps) $ >
  $ wi ph (wnnf x3 ch) $ >
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wb ps ch) $ >
  $ wi ph (wb (wal x3 ps) (wal y1 ch)) $;

--| Alternate definition of nonfreeness when ~ sp is available. (Contributed by BJ, 28-Jul-2023.) The proof should not rely on ~ df-nf . (Proof modification is discouraged.)
theorem bj_dfnnf3 {x3: setvar} (ph: wff x3):
  $ wb (wnnf x3 ph) (wi (wex x3 ph) (wal x3 ph)) $;

--| New nonfreeness is equivalent to old nonfreeness on core FOL axioms plus ~ sp . (Contributed by BJ, 28-Jul-2023.) The proof should not rely on ~ df-nf except via ~ df-nf directly. (Proof modification is discouraged.)
theorem bj_nfnnfTEMP {x3: setvar} (ph: wff x3):
  $ wb (wnnf x3 ph) (wnf x3 ph) $;

--| When ` ph ` is substituted for ` ps ` , this statement expresses nonfreeness in the weak form of nonfreeness ` ( E. -> A. ) ` . This could also be proved from ~ bj-nnfim , ~ bj-nnfe1 and ~ bj-nnfa1 . (Contributed by BJ, 9-Dec-2023.)
theorem bj_wnfnf {x3: setvar} (ph ps: wff x3):
  $ wnnf x3 (wi (wex x3 ph) (wal x3 ps)) $;

--| See ~ nfa1 . (Contributed by BJ, 12-Aug-2023.) (Proof modification is discouraged.)
theorem bj_nnfa1 {x3: setvar} (ph: wff x3):
  $ wnnf x3 (wal x3 ph) $;

--| See ~ nfe1 . (Contributed by BJ, 12-Aug-2023.) (Proof modification is discouraged.)
theorem bj_nnfe1 {x3: setvar} (ph: wff x3):
  $ wnnf x3 (wex x3 ph) $;

--| One of four lemmas for nonfreeness: antecedent and consequent both expressed using universal quantifier. Note: this is ~ bj-hbalt . (Contributed by BJ, 12-Aug-2023.) (Proof modification is discouraged.)
theorem bj_nnflemaa {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wal x3 (wi ph (wal y1 ps))) (wi (wal x3 ph) (wal y1 (wal x3 ps))) $;

--| One of four lemmas for nonfreeness: antecedent and consequent both expressed using existential quantifier. (Contributed by BJ, 12-Aug-2023.) (Proof modification is discouraged.)
theorem bj_nnflemee {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wal x3 (wi (wex y1 ph) ps)) (wi (wex y1 (wex x3 ph)) (wex x3 ps)) $;

--| One of four lemmas for nonfreeness: antecedent expressed with universal quantifier and consequent expressed with existential quantifier. (Contributed by BJ, 12-Aug-2023.) (Proof modification is discouraged.)
theorem bj_nnflemae {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wal x3 (wi ph (wal y1 ps))) (wi (wex x3 ph) (wal y1 (wex x3 ps))) $;

--| One of four lemmas for nonfreeness: antecedent expressed with existential quantifier and consequent expressed with universal quantifier. (Contributed by BJ, 12-Aug-2023.) (Proof modification is discouraged.)
theorem bj_nnflemea {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wal x3 (wi (wex y1 ph) ps)) (wi (wex y1 (wal x3 ph)) (wal x3 ps)) $;

--| See ~ nfal and ~ bj-nfalt . (Contributed by BJ, 12-Aug-2023.) (Proof modification is discouraged.)
theorem bj_nnfalt {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wnnf y1 ph)) (wnnf y1 (wal x3 ph)) $;

--| See ~ nfex and ~ bj-nfext . (Contributed by BJ, 12-Aug-2023.) (Proof modification is discouraged.)
theorem bj_nnfext {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wnnf y1 ph)) (wnnf y1 (wex x3 ph)) $;

--| Version of ~ pm11.53v with nonfreeness antecedents. (Contributed by BJ, 7-Oct-2024.)
theorem bj_pm11_53v {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wa (wal x3 (wnnf y1 ph)) (wal y1 (wnnf x3 ps))) (wb (wal x3 (wal y1 (wi ph ps))) (wi (wex x3 ph) (wal y1 ps))) $;

--| Alternate proof of ~ axc10 . Shorter. One can prove a version with DV ` ( x , y ) ` without ~ ax-13 , by using ~ ax6ev instead of ~ ax6e . (Contributed by BJ, 31-Mar-2021.) (Proof modification is discouraged.)
theorem bj_axc10 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wi (wceq (cv x3) (cv y1)) (wal x3 ph))) ph $;

--| A fol lemma. See ~ alequexv for a version with a disjoint variable condition requiring fewer axioms. Can be used to reduce the proof of ~ spimt from 133 to 112 bytes. (Contributed by BJ, 6-Oct-2018.)
theorem bj_alequex {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wi (wceq (cv x3) (cv y1)) ph)) (wex x3 ph) $;

--| A step in the proof of ~ spimt . (Contributed by BJ, 2-May-2019.)
theorem bj_spimt2 {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wal x3 (wi (wceq (cv x3) (cv y1)) (wi ph ps))) (wi (wi (wex x3 ps) ps) (wi (wal x3 ph) ps)) $;

--| Closed form of ~ cbv3 . (Contributed by BJ, 2-May-2019.)
theorem bj_cbv3ta {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wal x3 (wal y1 (wi (wceq (cv x3) (cv y1)) (wi ph ps)))) (wi (wa (wal y1 (wi (wex x3 ps) ps)) (wal x3 (wi ph (wal y1 ph)))) (wi (wal x3 ph) (wal y1 ps))) $;

--| Closed form of ~ cbv3 . (Contributed by BJ, 2-May-2019.)
theorem bj_cbv3tb {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wal x3 (wal y1 (wi (wceq (cv x3) (cv y1)) (wi ph ps)))) (wi (wa (wal y1 (wnf x3 ps)) (wal x3 (wnf y1 ph))) (wi (wal x3 ph) (wal y1 ps))) $;

--| A theorem close to a closed form of ~ hbsb3 . (Contributed by BJ, 2-May-2019.)
theorem bj_hbsb3t {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wi ph (wal y1 ph))) (wi (wsb x3 ph y1) (wal x3 (wsb x3 ph y1))) $;

--| Shorter proof of ~ hbsb3 . (Contributed by BJ, 2-May-2019.) (Proof modification is discouraged.)
theorem bj_hbsb3 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi ph (wal y1 ph) $ >
  $ wi (wsb x3 ph y1) (wal x3 (wsb x3 ph y1)) $;

--| A theorem close to a closed form of ~ nfs1 . (Contributed by BJ, 2-May-2019.)
theorem bj_nfs1t {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wi ph (wal y1 ph))) (wnf x3 (wsb x3 ph y1)) $;

--| A theorem close to a closed form of ~ nfs1 . (Contributed by BJ, 2-May-2019.)
theorem bj_nfs1t2 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wnf y1 ph)) (wnf x3 (wsb x3 ph y1)) $;

--| Shorter proof of ~ nfs1 (three essential steps instead of four). (Contributed by BJ, 2-May-2019.) (Proof modification is discouraged.)
theorem bj_nfs1 {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf y1 ph $ >
  $ wnf x3 (wsb x3 ph y1) $;

--| Version of ~ axc10 with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by BJ, 14-Jun-2019.) (Proof modification is discouraged.)
theorem bj_axc10v {x3: setvar} (ph: wff x3) (y1: setvar):
  $ wi (wal x3 (wi (wceq (cv x3) (cv y1)) (wal x3 ph))) ph $;

--| Version of ~ spimt with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by BJ, 14-Jun-2019.) (Proof modification is discouraged.)
theorem bj_spimtv {x3: setvar} (ph ps: wff x3) (y1: setvar):
  $ wi (wa (wnf x3 ps) (wal x3 (wi (wceq (cv x3) (cv y1)) (wi ph ps)))) (wi (wal x3 ph) ps) $;

--| Version of ~ cbv3h with two disjoint variable conditions, which does not require ~ ax-11 nor ~ ax-13 . (Contributed by BJ, 24-Jun-2019.) (Proof modification is discouraged.)
theorem bj_cbv3hv2 {x3 y1: setvar} (ph: wff x3) (ps: wff x3 y1):
  $ wi ps (wal x3 ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wi ph ps) $ >
  $ wi (wal x3 ph) (wal y1 ps) $;

--| Version of ~ cbv1h with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by BJ, 16-Jun-2019.) (Proof modification is discouraged.)
theorem bj_cbv1hv {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wi ph (wi ps (wal y1 ps)) $ >
  $ wi ph (wi ch (wal x3 ch)) $ >
  $ wi ph (wi (wceq (cv x3) (cv y1)) (wi ps ch)) $ >
  $ wi (wal x3 (wal y1 ph)) (wi (wal x3 ps) (wal y1 ch)) $;

--| Version of ~ cbv2h with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by BJ, 16-Jun-2019.) (Proof modification is discouraged.)
theorem bj_cbv2hv {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wi ph (wi ps (wal y1 ps)) $ >
  $ wi ph (wi ch (wal x3 ch)) $ >
  $ wi ph (wi (wceq (cv x3) (cv y1)) (wb ps ch)) $ >
  $ wi (wal x3 (wal y1 ph)) (wb (wal x3 ps) (wal y1 ch)) $;

--| Version of ~ cbv2 with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by BJ, 16-Jun-2019.) (Proof modification is discouraged.)
theorem bj_cbv2v {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wi ph (wnf y1 ps) $ >
  $ wi ph (wnf x3 ch) $ >
  $ wi ph (wi (wceq (cv x3) (cv y1)) (wb ps ch)) $ >
  $ wi ph (wb (wal x3 ps) (wal y1 ch)) $;

--| Version of ~ cbvald with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by BJ, 16-Jun-2019.) (Proof modification is discouraged.)
theorem bj_cbvaldv {x3 y1: setvar} (ph: wff y1) (ps: wff x3 y1) (ch: wff y1):
  $ wnf y1 ph $ >
  $ wi ph (wnf y1 ps) $ >
  $ wi ph (wi (wceq (cv x3) (cv y1)) (wb ps ch)) $ >
  $ wi ph (wb (wal x3 ps) (wal y1 ch)) $;

--| Version of ~ cbvexd with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by BJ, 16-Jun-2019.) (Proof modification is discouraged.)
theorem bj_cbvexdv {x3 y1: setvar} (ph: wff y1) (ps: wff x3 y1) (ch: wff y1):
  $ wnf y1 ph $ >
  $ wi ph (wnf y1 ps) $ >
  $ wi ph (wi (wceq (cv x3) (cv y1)) (wb ps ch)) $ >
  $ wi ph (wb (wex x3 ps) (wex y1 ch)) $;

--| Version of ~ cbval2vv with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by BJ, 16-Jun-2019.) (Proof modification is discouraged.)
theorem bj_cbval2vv {x3 y1 z w: setvar} (ph: wff x3 y1) (ps: wff z w):
  $ wi (wa (wceq (cv x3) (cv z)) (wceq (cv y1) (cv w))) (wb ph ps) $ >
  $ wb (wal x3 (wal y1 ph)) (wal z (wal w ps)) $;

--| Version of ~ cbvex2vv with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by BJ, 16-Jun-2019.) (Proof modification is discouraged.)
theorem bj_cbvex2vv {x3 y1 z w: setvar} (ph: wff x3 y1) (ps: wff z w):
  $ wi (wa (wceq (cv x3) (cv z)) (wceq (cv y1) (cv w))) (wb ph ps) $ >
  $ wb (wex x3 (wex y1 ph)) (wex z (wex w ps)) $;

--| Version of ~ cbvaldva with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by BJ, 16-Jun-2019.) (Proof modification is discouraged.)
theorem bj_cbvaldvav {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1):
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wb ps ch) $ >
  $ wi ph (wb (wal x3 ps) (wal y1 ch)) $;

--| Version of ~ cbvexdva with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by BJ, 16-Jun-2019.) (Proof modification is discouraged.)
theorem bj_cbvexdvav {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1):
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wb ps ch) $ >
  $ wi ph (wb (wex x3 ps) (wex y1 ch)) $;

--| Version of ~ cbvex4v with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by BJ, 16-Jun-2019.) (Proof modification is discouraged.)
theorem bj_cbvex4vv {x3 y1 z w v u f2 g2: setvar} (ph: wff x3 y1 z w f2 g2) (ps: wff z w v u) (ch: wff x3 y1 v u f2 g2):
  $ wi (wa (wceq (cv x3) (cv v)) (wceq (cv y1) (cv u))) (wb ph ps) $ >
  $ wi (wa (wceq (cv z) (cv f2)) (wceq (cv w) (cv g2))) (wb ps ch) $ >
  $ wb (wex x3 (wex y1 (wex z (wex w ph)))) (wex v (wex u (wex f2 (wex g2 ch)))) $;

--| Version of ~ equsalh with a disjoint variable condition, which does not require ~ ax-13 . Remark: this is the same as ~ equsalhw . TODO: delete after moving the following paragraph somewhere. Remarks: ~ equsexvw has been moved to Main; Theorem ~ ax13lem2 has a DV version which is a simple consequence of ~ ax5e ; Theorems ~ nfeqf2 , ~ dveeq2 , ~ nfeqf1 , ~ dveeq1 , ~ nfeqf , ~ axc9 , ~ ax13 , have dv versions which are simple consequences of ~ ax-5 . (Contributed by BJ, 14-Jun-2019.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_equsalhv {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi ps (wal x3 ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wal x3 (wi (wceq (cv x3) (cv y1)) ph)) ps $;

--| Version of ~ axc11n with a disjoint variable condition; instance of ~ aevlem . TODO: delete after checking surrounding theorems. (Contributed by BJ, 31-May-2019.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_axc11nv {x3 y1: setvar}:
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wal y1 (wceq (cv y1) (cv x3))) $;

--| Version of ~ aecoms with a disjoint variable condition, provable from Tarski's FOL. The corresponding version of ~ naecoms should not be very useful since ` -. A. x x = y ` , DV ` ( x , y ) ` is true when the universe has at least two objects (see ~ dtru ). (Contributed by BJ, 31-May-2019.) (Proof modification is discouraged.)
theorem bj_aecomsv {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) ph $ >
  $ wi (wal y1 (wceq (cv y1) (cv x3))) ph $;

--| Version of ~ axc11 with a disjoint variable condition, which does not require ~ ax-13 nor ~ ax-10 . Remark: the following theorems ( ~ hbae , ~ nfae , ~ hbnae , ~ nfnae , ~ hbnaes ) would need to be totally unbundled to be proved without ~ ax-13 , hence would be simple consequences of ~ ax-5 or ~ nfv . (Contributed by BJ, 31-May-2019.) (Proof modification is discouraged.)
theorem bj_axc11v {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wi (wal x3 ph) (wal y1 ph)) $;

--| Version of ~ drnf2 with a disjoint variable condition, which does not require ~ ax-10 , ~ ax-11 , ~ ax-12 , ~ ax-13 . Instance of ~ nfbidv . The version of ~ axc15 with a disjoint variable condition is actually ~ ax12v2 (up to adding a superfluous antecedent). (Contributed by BJ, 17-Jun-2019.) (Proof modification is discouraged.)
theorem bj_drnf2v {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb ph ps) $ >
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wb (wnf z ph) (wnf z ps)) $;

--| Version of ~ equs45f with a disjoint variable condition, which does not require ~ ax-13 . The version of ~ equs5 with a disjoint variable condition is actually ~ sbalex (up to adding a superfluous antecedent). (Contributed by BJ, 11-Sep-2019.) (Proof modification is discouraged.)
theorem bj_equs45fv {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf y1 ph $ >
  $ wb (wex x3 (wa (wceq (cv x3) (cv y1)) ph)) (wal x3 (wi (wceq (cv x3) (cv y1)) ph)) $;

--| Version of ~ hbsb2 with a disjoint variable condition, which does not require ~ ax-13 , and removal of ~ ax-13 from ~ hbs1 . (Contributed by BJ, 23-Jun-2019.) (Proof modification is discouraged.)
theorem bj_hbs1 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wsb x3 ph y1) (wal x3 (wsb x3 ph y1)) $;

--| Version of ~ nfsb2 with a disjoint variable condition, which does not require ~ ax-13 , and removal of ~ ax-13 from ~ nfs1v . (Contributed by BJ, 24-Jun-2019.) (Proof modification is discouraged.)
theorem bj_nfs1v {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf x3 (wsb x3 ph y1) $;

--| Version of ~ hbsb2a with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by BJ, 11-Sep-2019.) (Proof modification is discouraged.)
theorem bj_hbsb2av {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wsb x3 (wal y1 ph) y1) (wal x3 (wsb x3 ph y1)) $;

--| Version of ~ hbsb3 with a disjoint variable condition, which does not require ~ ax-13 . (Remark: the unbundled version of ~ nfs1 is given by ~ bj-nfs1v .) (Contributed by BJ, 11-Sep-2019.) (Proof modification is discouraged.)
theorem bj_hbsb3v {x3 y1: setvar} (ph: wff x3 y1):
  $ wi ph (wal y1 ph) $ >
  $ wi (wsb x3 ph y1) (wal x3 (wsb x3 ph y1)) $;

--| Remove dependency on ~ ax-13 from ~ nfsab1 . UPDATE / TODO: ~ nfsab1 does not use ~ ax-13 either anymore; ~ bj-nfsab1 is shorter than ~ nfsab1 but uses ~ ax-12 . (Contributed by BJ, 23-Jun-2019.) (Proof modification is discouraged.)
theorem bj_nfsab1 {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf x3 (wcel (cv y1) (cab x3 ph)) $;

--| Version of ~ dtrucor2 with a disjoint variable condition, which does not require ~ ax-13 (nor ~ ax-4 , ~ ax-5 , ~ ax-7 , ~ ax-12 ). (Contributed by BJ, 16-Jul-2019.) (Proof modification is discouraged.)
theorem bj_dtrucor2v {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wne (cv x3) (cv y1)) $ >
  $ wa ph (wn ph) $;

--| Biconditional version of a form of ~ hbae with commuted quantifiers, not requiring ~ ax-11 . (Contributed by BJ, 12-Dec-2019.) (Proof modification is discouraged.)
theorem bj_hbaeb2 {x3 y1 z: setvar}:
  $ wb (wal x3 (wceq (cv x3) (cv y1))) (wal x3 (wal z (wceq (cv x3) (cv y1)))) $;

--| Biconditional version of a form of ~ hbae with commuted quantifiers, not requiring ~ ax-11 . (Contributed by BJ, 12-Dec-2019.) (Proof modification is discouraged.)
theorem bj_hbaeb2_b {x3 y1: setvar}:
  $ wb (wal x3 (wceq (cv x3) (cv y1))) (wal x3 (wal y1 (wceq (cv x3) (cv y1)))) $;

--| Biconditional version of ~ hbae . (Contributed by BJ, 6-Oct-2018.) (Proof modification is discouraged.)
theorem bj_hbaeb {x3 y1 z: setvar}:
  $ wb (wal x3 (wceq (cv x3) (cv y1))) (wal z (wal x3 (wceq (cv x3) (cv y1)))) $;

--| Biconditional version of ~ hbnae (to replace it?). (Contributed by BJ, 6-Oct-2018.)
theorem bj_hbnaeb {x3 y1 z: setvar}:
  $ wb (wn (wal x3 (wceq (cv x3) (cv y1)))) (wal z (wn (wal x3 (wceq (cv x3) (cv y1))))) $;

--| A special instance of ~ bj-hbaeb2 . A lemma for distinct var metavariables. The right-hand side is a closed formula (a sentence). (Contributed by BJ, 6-Oct-2018.)
theorem bj_dvv {x3 y1: setvar}:
  $ wb (wal x3 (wceq (cv x3) (cv y1))) (wal x3 (wal y1 (wceq (cv x3) (cv y1)))) $;

--| Duplication of ~ wl-equsal1t , with shorter proof. If one imposes a disjoint variable condition on ` x , y ` , then one can use ~ alequexv and reduce axiom dependencies, and similarly for the following theorems. Note: ~ wl-equsalcom is also interesting. (Contributed by BJ, 6-Oct-2018.)
theorem bj_equsal1t {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wnf x3 ph) (wb (wal x3 (wi (wceq (cv x3) (cv y1)) ph)) ph) $;

--| Inference associated with ~ bj-equsal1t . (Contributed by BJ, 30-Sep-2018.)
theorem bj_equsal1ti {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf x3 ph $ >
  $ wb (wal x3 (wi (wceq (cv x3) (cv y1)) ph)) ph $;

--| One direction of ~ equsal . (Contributed by BJ, 30-Sep-2018.)
theorem bj_equsal1 {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wi ph ps) $ >
  $ wi (wal x3 (wi (wceq (cv x3) (cv y1)) ph)) ps $;

--| One direction of ~ equsal . (Contributed by BJ, 30-Sep-2018.)
theorem bj_equsal2 {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf x3 ph $ >
  $ wi (wceq (cv x3) (cv y1)) (wi ph ps) $ >
  $ wi ph (wal x3 (wi (wceq (cv x3) (cv y1)) ps)) $;

--| Shorter proof of ~ equsal . (Contributed by BJ, 30-Sep-2018.) Proof modification is discouraged to avoid using ~ equsal , but "min */exc equsal" is ok. (Proof modification is discouraged.)
theorem bj_equsal {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wal x3 (wi (wceq (cv x3) (cv y1)) ph)) ps $;

--| Closed form of ~ stdpc5 . (Possible to place it before ~ 19.21t and use it to prove ~ 19.21t ). (Contributed by BJ, 15-Sep-2018.) (Proof modification is discouraged.)
theorem stdpc5t {x3: setvar} (ph ps: wff x3):
  $ wi (wnf x3 ph) (wi (wal x3 (wi ph ps)) (wi ph (wal x3 ps))) $;

--| More direct proof of ~ stdpc5 . (Contributed by BJ, 15-Sep-2018.) (Proof modification is discouraged.)
theorem bj_stdpc5 {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ph $ >
  $ wi (wal x3 (wi ph ps)) (wi ph (wal x3 ps)) $;

--| A double ~ stdpc5 (one direction of PM*11.3). See also ~ 2stdpc4 and ~ 19.21vv . (Contributed by BJ, 15-Sep-2018.) (Proof modification is discouraged.)
theorem _2stdpc5 {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wi (wal x3 (wal y1 (wi ph ps))) (wi ph (wal x3 (wal y1 ps))) $;

--| Proof of ~ 19.21t from ~ stdpc5t . (Contributed by BJ, 15-Sep-2018.) (Proof modification is discouraged.)
theorem bj_19_21t0 {x3: setvar} (ph ps: wff x3):
  $ wi (wnf x3 ph) (wb (wal x3 (wi ph ps)) (wi ph (wal x3 ps))) $;

--| Inference associated with ~ exlimi . Inferring a theorem when it is implied by an antecedent which may be true. (Contributed by BJ, 15-Sep-2018.)
theorem exlimii {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ps $ >
  $ wi ph ps $ >
  $ wex x3 ph $ >
  $ ps $;

--| Proof of ~ ax-11 similar to PM's proof of ~ alcom (PM*11.2). For a proof closer to PM's proof, see ~ ax11-pm2 . Axiom ~ ax-11 is used in the proof only through ~ nfa2 . (Contributed by BJ, 15-Sep-2018.) (Proof modification is discouraged.)
theorem ax11_pm {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wal y1 ph)) (wal y1 (wal x3 ph)) $;

--| Commuted form of ~ ax6e . (Could be placed right after ~ ax6e ). (Contributed by BJ, 15-Sep-2018.)
theorem ax6er {x3 y1: setvar}:
  $ wex x3 (wceq (cv y1) (cv x3)) $;

--| Inferring a theorem when it is implied by an equality which may be true. (Contributed by BJ, 30-Sep-2018.)
theorem exlimiieq1 {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf x3 ph $ >
  $ wi (wceq (cv x3) (cv y1)) ph $ >
  $ ph $;

--| Inferring a theorem when it is implied by an equality which may be true. (Contributed by BJ, 15-Sep-2018.) (Revised by BJ, 30-Sep-2018.)
theorem exlimiieq2 {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf y1 ph $ >
  $ wi (wceq (cv x3) (cv y1)) ph $ >
  $ ph $;

--| Proof of ~ ax-11 from the standard axioms of predicate calculus, similar to PM's proof of ~ alcom (PM*11.2). This proof requires that ` x ` and ` y ` be distinct. Axiom ~ ax-11 is used in the proof only through ~ nfal , ~ nfsb , ~ sbal , ~ sb8 . See also ~ ax11-pm . (Contributed by BJ, 15-Sep-2018.) (Proof modification is discouraged.)
theorem ax11_pm2 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wal y1 ph)) (wal y1 (wal x3 ph)) $;

--| Biconditional showing two possible (dual) definitions of substitution ~ df-sb not using dummy variables. (Contributed by BJ, 19-Mar-2021.)
theorem bj_sbsb {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wa (wi (wceq (cv x3) (cv y1)) ph) (wex x3 (wa (wceq (cv x3) (cv y1)) ph))) (wo (wal x3 (wi (wceq (cv x3) (cv y1)) ph)) (wa (wceq (cv x3) (cv y1)) ph)) $;

--| Alternate (dual) definition of substitution ~ df-sb not using dummy variables. (Contributed by BJ, 19-Mar-2021.)
theorem bj_dfsb2 {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wsb x3 ph y1) (wo (wal x3 (wi (wceq (cv x3) (cv y1)) ph)) (wa (wceq (cv x3) (cv y1)) ph)) $;

--| Substitution has no effect on a bound variable (existential quantifier case); see ~ sbf2 . (Contributed by BJ, 2-May-2019.)
theorem bj_sbf3 {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wsb x3 (wex x3 ph) y1) (wex x3 ph) $;

--| Substitution has no effect on a bound variable (nonfreeness case); see ~ sbf2 . (Contributed by BJ, 2-May-2019.)
theorem bj_sbf4 {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wsb x3 (wnf x3 ph) y1) (wnf x3 ph) $;

--| Version of ~ eu3v where the disjoint variable condition is replaced with a nonfreeness hypothesis. This is a "backup" of a theorem that used to be in the main part with label "eu3" and was deprecated in favor of ~ eu3v . (Contributed by NM, 8-Jul-1994.) (Proof shortened by BJ, 31-May-2019.)
theorem bj_eu3f {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf y1 ph $ >
  $ wb (weu x3 ph) (wa (wex x3 ph) (wex y1 (wal x3 (wi ph (wceq (cv x3) (cv y1)))))) $;

--| Lemma for substitution. (Contributed by BJ, 23-Jul-2023.)
theorem bj_sblem1 {x3: setvar} (ph ps: wff x3) (ch: wff):
  $ wi (wal x3 (wi ph (wi ps ch))) (wi (wal x3 (wi ph ps)) (wi (wex x3 ph) ch)) $;

--| Lemma for substitution. (Contributed by BJ, 23-Jul-2023.)
theorem bj_sblem2 {x3: setvar} (ph ps: wff x3) (ch: wff):
  $ wi (wal x3 (wi ph (wi ch ps))) (wi (wi (wex x3 ph) ch) (wal x3 (wi ph ps))) $;

--| Lemma for substitution. (Contributed by BJ, 23-Jul-2023.)
theorem bj_sblem {x3: setvar} (ph ps: wff x3) (ch: wff):
  $ wi (wal x3 (wi ph (wb ps ch))) (wb (wal x3 (wi ph ps)) (wi (wex x3 ph) ch)) $;

--| Lemma for substitution. (Contributed by BJ, 23-Jul-2023.)
theorem bj_sbievw1 {x3 y1: setvar} (ph: wff x3 y1) (ps: wff y1):
  $ wi (wsb x3 (wi ph ps) y1) (wi (wsb x3 ph y1) ps) $;

--| Lemma for substitution. (Contributed by BJ, 23-Jul-2023.)
theorem bj_sbievw2 {x3 y1: setvar} (ph: wff x3 y1) (ps: wff y1):
  $ wi (wsb x3 (wi ps ph) y1) (wi ps (wsb x3 ph y1)) $;

--| Lemma for substitution. Closed form of ~ equsalvw and ~ sbievw . (Contributed by BJ, 23-Jul-2023.)
theorem bj_sbievw {x3 y1: setvar} (ph: wff x3 y1) (ps: wff y1):
  $ wi (wsb x3 (wb ph ps) y1) (wb (wsb x3 ph y1) ps) $;

--| Version of ~ sbie with a second nonfreeness hypothesis and shorter proof. (Contributed by BJ, 18-Jul-2023.) (Proof modification is discouraged.)
theorem bj_sbievv {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf x3 ps $ >
  $ wnf y1 ph $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wsb x3 ph y1) ps $;

--| Uniqueness is equivalent to existence being equivalent to unique existence. (Contributed by BJ, 14-Oct-2022.)
theorem bj_moeub {x3: setvar} (ph: wff x3):
  $ wb (wmo x3 ph) (wb (wex x3 ph) (weu x3 ph)) $;

--| Obsolete proof of ~ sbidm temporarily kept here to check it gives no additional insight. (Contributed by NM, 8-Mar-1995.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_sbidmOLD {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wsb x3 (wsb x3 ph y1) y1) (wsb x3 ph y1) $;

--| Deduction form of ~ dvelim with disjoint variable conditions. Uncurried (imported) form of ~ bj-dvelimdv1 . Typically, ` z ` is a fresh variable used for the implicit substitution hypothesis that results in ` ch ` (namely, ` ps ` can be thought as ` ps ( x , y ) ` and ` ch ` as ` ps ( x , z ) ` ). So the theorem says that if x is effectively free in ` ps ( x , z ) ` , then if x and y are not the same variable, then ` x ` is also effectively free in ` ps ( x , y ) ` , in a context ` ph ` . One can weaken the implicit substitution hypothesis by adding the antecedent ` ph ` but this typically does not make the theorem much more useful. Similarly, one could use nonfreeness hypotheses instead of disjoint variable conditions but since this result is typically used when ` z ` is a dummy variable, this would not be of much benefit. One could also remove DV ` ( x , z ) ` since in the proof ~ nfv can be replaced with ~ nfal followed by ~ nfn . Remark: ~ nfald uses ~ ax-11 ; it might be possible to inline and use ~ ax11w instead, but there is still a use via ~ 19.12 anyway. (Contributed by BJ, 20-Oct-2021.) (Proof modification is discouraged.)
theorem bj_dvelimdv {x3 y1 z: setvar} (ph ps: wff x3 y1) (ch: wff x3 y1 z):
  $ wi ph (wnf x3 ch) $ >
  $ wi (wceq (cv z) (cv y1)) (wb ch ps) $ >
  $ wi (wa ph (wn (wal x3 (wceq (cv x3) (cv y1))))) (wnf x3 ps) $;

--| Curried (exported) form of ~ bj-dvelimdv (of course, one is directly provable from the other, but we keep this proof for illustration purposes). (Contributed by BJ, 20-Oct-2021.) (Proof modification is discouraged.)
theorem bj_dvelimdv1 {x3 y1 z: setvar} (ph ps: wff x3 y1) (ch: wff x3 y1 z):
  $ wi ph (wnf x3 ch) $ >
  $ wi (wceq (cv z) (cv y1)) (wb ch ps) $ >
  $ wi ph (wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wnf x3 ps)) $;

--| A version of ~ dvelim using the "nonfree" idiom. (Contributed by BJ, 20-Oct-2021.) (Proof modification is discouraged.)
theorem bj_dvelimv {x3 y1 z: setvar} (ph: wff x3 y1) (ps: wff x3 y1 z):
  $ wnf x3 ps $ >
  $ wi (wceq (cv z) (cv y1)) (wb ps ph) $ >
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wnf x3 ph) $;

--| Nonfreeness in a membership statement. (Contributed by BJ, 20-Oct-2021.) (Proof modification is discouraged.)
theorem bj_nfeel2 {x3 y1: setvar} (z: setvar):
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wnf x3 (wcel (cv y1) (cv z))) $;

--| Proof of a version of ~ axc14 using the "nonfree" idiom. (Contributed by BJ, 20-Oct-2021.) (Proof modification is discouraged.)
theorem bj_axc14nf {x3 y1 z: setvar}:
  $ wi (wn (wal z (wceq (cv z) (cv x3)))) (wi (wn (wal z (wceq (cv z) (cv y1)))) (wnf z (wcel (cv x3) (cv y1)))) $;

--| Alternate proof of ~ axc14 (even when inlining the above results, this gives a shorter proof). (Contributed by BJ, 20-Oct-2021.) (Proof modification is discouraged.)
theorem bj_axc14 {x3 y1 z: setvar}:
  $ wi (wn (wal z (wceq (cv z) (cv x3)))) (wi (wn (wal z (wceq (cv z) (cv y1)))) (wi (wcel (cv x3) (cv y1)) (wal z (wcel (cv x3) (cv y1))))) $;

--| Alternate proof of ~ mobidv directly from its analogues ~ albidv and ~ exbidv , using deduction style. Note the proof structure, similar to ~ mobi . (Contributed by Mario Carneiro, 7-Oct-2016.) Reduce axiom dependencies and shorten proof. Remove dependency on ~ ax-12 by adapting proof of ~ mobid . (Revised by BJ, 26-Sep-2022.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem mobidvALT {x3: setvar} (ph: wff) (ps ch: wff x3):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wmo x3 ps) (wmo x3 ch)) $;

--| Alternate proof of ~ sbn1 , not using the false constant. (Contributed by BJ, 18-Sep-2024.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem sbn1ALT {x3 t: setvar} (ph: wff x3 t):
  $ wi (wsb x3 (wn ph) t) (wn (wsb x3 ph t)) $;

--| A theorem used to prove the base case of the Eliminability Theorem (see section comment). (Contributed by BJ, 19-Oct-2019.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem eliminable1 {x3: setvar} (ph: wff x3) (y1: setvar):
  $ wb (wcel (cv y1) (cab x3 ph)) (wsb x3 ph y1) $;

--| A theorem used to prove the base case of the Eliminability Theorem (see section comment). (Contributed by BJ, 19-Oct-2019.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem eliminable2a {y1 z: setvar} (ph: wff y1) (x3: setvar):
  $ wb (wceq (cv x3) (cab y1 ph)) (wal z (wb (wcel (cv z) (cv x3)) (wcel (cv z) (cab y1 ph)))) $;

--| A theorem used to prove the base case of the Eliminability Theorem (see section comment). (Contributed by BJ, 19-Oct-2019.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem eliminable2b {x3 z: setvar} (ph: wff x3) (y1: setvar):
  $ wb (wceq (cab x3 ph) (cv y1)) (wal z (wb (wcel (cv z) (cab x3 ph)) (wcel (cv z) (cv y1)))) $;

--| A theorem used to prove the base case of the Eliminability Theorem (see section comment). (Contributed by BJ, 19-Oct-2019.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem eliminable2c {x3 y1 z: setvar} (ph ps: wff x3 y1):
  $ wb (wceq (cab x3 ph) (cab y1 ps)) (wal z (wb (wcel (cv z) (cab x3 ph)) (wcel (cv z) (cab y1 ps)))) $;

--| A theorem used to prove the base case of the Eliminability Theorem (see section comment). (Contributed by BJ, 19-Oct-2019.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem eliminable3a {x3 z: setvar} (ph: wff x3) (y1: setvar):
  $ wb (wcel (cab x3 ph) (cv y1)) (wex z (wa (wceq (cv z) (cab x3 ph)) (wcel (cv z) (cv y1)))) $;

--| A theorem used to prove the base case of the Eliminability Theorem (see section comment). (Contributed by BJ, 19-Oct-2019.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem eliminable3b {x3 y1 z: setvar} (ph ps: wff x3 y1):
  $ wb (wcel (cab x3 ph) (cab y1 ps)) (wex z (wa (wceq (cv z) (cab x3 ph)) (wcel (cv z) (cab y1 ps)))) $;

--| A theorem used to prove the base case of the Eliminability Theorem (see section comment): variable belongs to abstraction. (Contributed by BJ, 30-Apr-2024.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem eliminable_velab {x3: setvar} (ph: wff x3) (y1: setvar):
  $ wb (wcel (cv y1) (cab x3 ph)) (wsb x3 ph y1) $;

--| A theorem used to prove the base case of the Eliminability Theorem (see section comment): variable equals abstraction. (Contributed by BJ, 30-Apr-2024.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem eliminable_veqab {y1 z: setvar} (ph: wff y1) (x3: setvar):
  $ wb (wceq (cv x3) (cab y1 ph)) (wal z (wb (wcel (cv z) (cv x3)) (wsb y1 ph z))) $;

--| A theorem used to prove the base case of the Eliminability Theorem (see section comment): abstraction equals variable. (Contributed by BJ, 30-Apr-2024.) Beware not to use symmetry of class equality. (Proof modification is discouraged.) (New usage is discouraged.)
theorem eliminable_abeqv {x3 z: setvar} (ph: wff x3) (y1: setvar):
  $ wb (wceq (cab x3 ph) (cv y1)) (wal z (wb (wsb x3 ph z) (wcel (cv z) (cv y1)))) $;

--| A theorem used to prove the base case of the Eliminability Theorem (see section comment): abstraction equals abstraction. (Contributed by BJ, 30-Apr-2024.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem eliminable_abeqab {x3 y1 z: setvar} (ph ps: wff x3 y1):
  $ wb (wceq (cab x3 ph) (cab y1 ps)) (wal z (wb (wsb x3 ph z) (wsb y1 ps z))) $;

--| A theorem used to prove the base case of the Eliminability Theorem (see section comment): abstraction belongs to variable. (Contributed by BJ, 30-Apr-2024.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem eliminable_abelv {x3 z t: setvar} (ph: wff x3) (y1: setvar):
  $ wb (wcel (cab x3 ph) (cv y1)) (wex z (wa (wal t (wb (wcel (cv t) (cv z)) (wsb x3 ph t))) (wcel (cv z) (cv y1)))) $;

--| A theorem used to prove the base case of the Eliminability Theorem (see section comment): abstraction belongs to abstraction. (Contributed by BJ, 30-Apr-2024.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem eliminable_abelab {x3 y1 z t: setvar} (ph: wff x3 y1) (ps: wff x3 y1 t):
  $ wb (wcel (cab x3 ph) (cab y1 ps)) (wex z (wa (wal t (wb (wcel (cv t) (cv z)) (wsb x3 ph t))) (wsb y1 ps z))) $;

--| Duplicate of ~ issettru and ~ bj-issettruALTV . Lemma for ~ bj-denotesALTV . (Contributed by BJ, 24-Apr-2024.) (Proof modification is discouraged.)
theorem bj_denoteslem {x3 y1: setvar} (A2: class y1):
  $ wb (wex x3 (wceq (cv x3) A2)) (wcel A2 (cab y1 wtru)) $;

--| Moved to main as ~ iseqsetv-clel and kept for the comments. This would be the justification theorem for the definition of the unary predicate "E!" by ` |- ( ` E! ` A <-> E. x x = A ) ` which could be interpreted as " ` A ` exists" (as a set) or " ` A ` denotes" (in the sense of free logic). A shorter proof using ~ bitri (to add an intermediate proposition ` E. z z = A ` with a fresh ` z ` ), ~ cbvexvw , and ~ eqeq1 , requires the core axioms and { ~ ax-9 , ~ ax-ext , ~ df-cleq } whereas this proof requires the core axioms and { ~ ax-8 , ~ df-clab , ~ df-clel }. Theorem ~ bj-issetwt proves that "existing" is equivalent to being a member of a class abstraction. It also requires, with the present proof, { ~ ax-8 , ~ df-clab , ~ df-clel } (whereas with the shorter proof from ~ cbvexvw and ~ eqeq1 it would require { ~ ax-8 , ~ ax-9 , ~ ax-ext , ~ df-clab , ~ df-cleq , ~ df-clel }). That every class is equal to a class abstraction is proved by ~ abid1 , which requires { ~ ax-8 , ~ ax-9 , ~ ax-ext , ~ df-clab , ~ df-cleq , ~ df-clel }. There is no disjoint variable condition on ` x , y ` but the theorem does not depend on ~ ax-13 . Actually, the proof depends only on the logical axioms ~ ax-1 through ~ ax-7 and ~ sp . The symbol "E!" was chosen to be reminiscent of the analogous predicate in (inclusive or non-inclusive) free logic, which deals with the possibility of nonexistent objects. This analogy should not be taken too far, since here there are no equality axioms for classes: these are derived from ~ ax-ext and ~ df-cleq (e.g., ~ eqid and ~ eqeq1 ). In particular, one cannot even prove ` |- E. x x = A => |- A = A ` without ~ ax-ext and ~ df-cleq . (Contributed by BJ, 29-Apr-2019.) (Proof modification is discouraged.)
theorem bj_denotesALTV {x3 y1: setvar} (A2: class):
  $ wb (wex x3 (wceq (cv x3) A2)) (wex y1 (wceq (cv y1) A2)) $;

--| Moved to main as ~ issettru and kept for the comments. Weak version of ~ isset without ~ ax-ext . (Contributed by BJ, 24-Apr-2024.) (Proof modification is discouraged.)
theorem bj_issettruALTV {x3 y1: setvar} (A2: class y1):
  $ wb (wex x3 (wceq (cv x3) A2)) (wcel A2 (cab y1 wtru)) $;

--| This is as close as we can get to proving extensionality for "the" "universal" class without ~ ax-ext . (Contributed by BJ, 24-Apr-2024.) (Proof modification is discouraged.)
theorem bj_elabtru {x3 y1: setvar} (A2: class x3 y1):
  $ wb (wcel A2 (cab x3 wtru)) (wcel A2 (cab y1 wtru)) $;

--| Closed form of ~ bj-issetw . (Contributed by BJ, 29-Apr-2019.) (Proof modification is discouraged.)
theorem bj_issetwt {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3):
  $ wi (wal x3 ph) (wb (wcel A2 (cab x3 ph)) (wex y1 (wceq (cv y1) A2))) $;

--| The closest one can get to ~ isset without using ~ ax-ext . See also ~ vexw . The only disjoint variable condition is between ` y ` and ` A ` . From there, one can prove ~ isset using ~ eleq2i (which requires ~ ax-ext and ~ df-cleq ). (Contributed by BJ, 29-Apr-2019.) (Proof modification is discouraged.)
theorem bj_issetw {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3):
  $ ph $ >
  $ wb (wcel A2 (cab x3 ph)) (wex y1 (wceq (cv y1) A2)) $;

--| Version of ~ bj-isseti with a disjoint variable condition on ` x , V ` . The hypothesis uses ` V ` instead of ` _V ` for extra generality. This is indeed more general than ~ isseti as long as ~ elex is not available (and the non-dependence of ~ bj-issetiv on special properties of the universal class ` _V ` is obvious). Prefer its use over ~ bj-isseti when sufficient (in particular when ` V ` is substituted for ` _V ` ). (Contributed by BJ, 14-Sep-2019.) (Proof modification is discouraged.)
theorem bj_issetiv {x3: setvar} (A2 V: class):
  $ wcel A2 V $ >
  $ wex x3 (wceq (cv x3) A2) $;

--| Version of ~ isseti with a class variable ` V ` in the hypothesis instead of ` _V ` for extra generality. This is indeed more general than ~ isseti as long as ~ elex is not available (and the non-dependence of ~ bj-isseti on special properties of the universal class ` _V ` is obvious). Use ~ bj-issetiv instead when sufficient (in particular when ` V ` is substituted for ` _V ` ). (Contributed by BJ, 13-Jun-2019.) (Proof modification is discouraged.)
theorem bj_isseti {x3: setvar} (A2: class) (V: class x3):
  $ wcel A2 V $ >
  $ wex x3 (wceq (cv x3) A2) $;

--| A weak version of ~ ralv not using ~ ax-ext (nor ~ df-cleq , ~ df-clel , ~ df-v ), and only core FOL axioms. See also ~ bj-rexvw . The analogues for ~ reuv and ~ rmov are not proved. (Contributed by BJ, 16-Jun-2019.) (Proof modification is discouraged.)
theorem bj_ralvw {x3 y1: setvar} (ph ps: wff x3 y1):
  $ ps $ >
  $ wb (wral x3 ph (cab y1 ps)) (wal x3 ph) $;

--| A weak version of ~ rexv not using ~ ax-ext (nor ~ df-cleq , ~ df-clel , ~ df-v ), and only core FOL axioms. See also ~ bj-ralvw . (Contributed by BJ, 16-Jun-2019.) (Proof modification is discouraged.)
theorem bj_rexvw {x3 y1: setvar} (ph ps: wff x3 y1):
  $ ps $ >
  $ wb (wrex x3 ph (cab y1 ps)) (wex x3 ph) $;

--| A weak version of ~ rabab not using ~ df-clel nor ~ df-v (but requiring ~ ax-ext ) nor ~ ax-12 . (Contributed by BJ, 16-Jun-2019.) (Proof modification is discouraged.)
theorem bj_rababw {x3 y1: setvar} (ph ps: wff x3 y1):
  $ ps $ >
  $ wceq (crab x3 ph (cab y1 ps)) (cab x3 ph) $;

--| Version of ~ rexcom4b and ~ bj-rexcom4b with a disjoint variable condition on ` x , V ` , hence removing dependency on ~ df-sb and ~ df-clab (so that it depends on ~ df-clel and ~ df-rex only on top of first-order logic). Prefer its use over ~ bj-rexcom4b when sufficient (in particular when ` V ` is substituted for ` _V ` ). Note the ` V ` in the hypothesis instead of ` _V ` . (Contributed by BJ, 14-Sep-2019.) (Proof modification is discouraged.)
theorem bj_rexcom4bv {x3 y1: setvar} (ph: wff y1) (A2 B2 V: class y1):
  $ wcel B2 V $ >
  $ wb (wex x3 (wrex y1 (wa ph (wceq (cv x3) B2)) A2)) (wrex y1 ph A2) $;

--| Remove from ~ rexcom4b dependency on ~ ax-ext and ~ ax-13 (and on ~ df-or , ~ df-cleq , ~ df-nfc , ~ df-v ). The hypothesis uses ` V ` instead of ` _V ` (see ~ bj-isseti for the motivation). Use ~ bj-rexcom4bv instead when sufficient (in particular when ` V ` is substituted for ` _V ` ). (Contributed by BJ, 16-Jun-2019.) (Proof modification is discouraged.)
theorem bj_rexcom4b {x3 y1: setvar} (ph: wff y1) (A2 B2: class y1) (V: class x3 y1):
  $ wcel B2 V $ >
  $ wb (wex x3 (wrex y1 (wa ph (wceq (cv x3) B2)) A2)) (wrex y1 ph A2) $;

--| The FOL content of ~ ceqsalt . Lemma for ~ bj-ceqsalt and ~ bj-ceqsaltv . (Contributed by BJ, 26-Sep-2019.) (Proof modification is discouraged.)
theorem bj_ceqsalt0 {x3: setvar} (ph ps th: wff x3):
  $ wi (w3a (wnf x3 ps) (wal x3 (wi th (wb ph ps))) (wex x3 th)) (wb (wal x3 (wi th ph)) ps) $;

--| The FOL content of ~ ceqsalt . Lemma for ~ bj-ceqsalt and ~ bj-ceqsaltv . TODO: consider removing if it does not add anything to ~ bj-ceqsalt0 . (Contributed by BJ, 26-Sep-2019.) (Proof modification is discouraged.)
theorem bj_ceqsalt1 {x3: setvar} (ph ps ch th: wff x3):
  $ wi th (wex x3 ch) $ >
  $ wi (w3a (wnf x3 ps) (wal x3 (wi ch (wb ph ps))) th) (wb (wal x3 (wi ch ph)) ps) $;

--| Remove from ~ ceqsalt dependency on ~ ax-ext (and on ~ df-cleq and ~ df-v ). Note: this is not doable with ~ ceqsralt (or ~ ceqsralv ), which uses ~ eleq1 , but the same dependence removal is possible for ~ ceqsalg , ~ ceqsal , ~ ceqsalv , ~ cgsexg , ~ cgsex2g , ~ cgsex4g , ~ ceqsex , ~ ceqsexv , ~ ceqsex2 , ~ ceqsex2v , ~ ceqsex3v , ~ ceqsex4v , ~ ceqsex6v , ~ ceqsex8v , ~ gencbvex (after changing ` A = y ` to ` y = A ` ), ~ gencbvex2 , ~ gencbval , ~ vtoclgft (it uses ` F/_ ` , whose justification ~ nfcjust does not use ~ ax-ext ) and several other vtocl* theorems (see for instance ~ bj-vtoclg1f ). See also ~ bj-ceqsaltv . (Contributed by BJ, 16-Jun-2019.) (Proof modification is discouraged.)
theorem bj_ceqsalt {x3: setvar} (ph ps: wff x3) (A2: class) (V: class x3):
  $ wi (w3a (wnf x3 ps) (wal x3 (wi (wceq (cv x3) A2) (wb ph ps))) (wcel A2 V)) (wb (wal x3 (wi (wceq (cv x3) A2) ph)) ps) $;

--| Version of ~ bj-ceqsalt with a disjoint variable condition on ` x , V ` , removing dependency on ~ df-sb and ~ df-clab . Prefer its use over ~ bj-ceqsalt when sufficient (in particular when ` V ` is substituted for ` _V ` ). (Contributed by BJ, 16-Jun-2019.) (Proof modification is discouraged.)
theorem bj_ceqsaltv {x3: setvar} (ph ps: wff x3) (A2 V: class):
  $ wi (w3a (wnf x3 ps) (wal x3 (wi (wceq (cv x3) A2) (wb ph ps))) (wcel A2 V)) (wb (wal x3 (wi (wceq (cv x3) A2) ph)) ps) $;

--| The FOL content of ~ ceqsalg . (Contributed by BJ, 12-Oct-2019.) (Proof modification is discouraged.)
theorem bj_ceqsalg0 {x3: setvar} (ph ps ch: wff x3):
  $ wnf x3 ps $ >
  $ wi ch (wb ph ps) $ >
  $ wi (wex x3 ch) (wb (wal x3 (wi ch ph)) ps) $;

--| Remove from ~ ceqsalg dependency on ~ ax-ext (and on ~ df-cleq and ~ df-v ). See also ~ bj-ceqsalgv . (Contributed by BJ, 12-Oct-2019.) (Proof modification is discouraged.)
theorem bj_ceqsalg {x3: setvar} (ph ps: wff x3) (A2: class) (V: class x3):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wb (wal x3 (wi (wceq (cv x3) A2) ph)) ps) $;

--| Alternate proof of ~ bj-ceqsalg . (Contributed by BJ, 12-Oct-2019.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_ceqsalgALT {x3: setvar} (ph ps: wff x3) (A2: class) (V: class x3):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wb (wal x3 (wi (wceq (cv x3) A2) ph)) ps) $;

--| Version of ~ bj-ceqsalg with a disjoint variable condition on ` x , V ` , removing dependency on ~ df-sb and ~ df-clab . Prefer its use over ~ bj-ceqsalg when sufficient (in particular when ` V ` is substituted for ` _V ` ). (Contributed by BJ, 12-Oct-2019.) (Proof modification is discouraged.)
theorem bj_ceqsalgv {x3: setvar} (ph ps: wff x3) (A2 V: class):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wb (wal x3 (wi (wceq (cv x3) A2) ph)) ps) $;

--| Alternate proof of ~ bj-ceqsalgv . (Contributed by BJ, 12-Oct-2019.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_ceqsalgvALT {x3: setvar} (ph ps: wff x3) (A2 V: class):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wb (wal x3 (wi (wceq (cv x3) A2) ph)) ps) $;

--| Remove from ~ ceqsal dependency on ~ ax-ext (and on ~ df-cleq , ~ df-v , ~ df-clab , ~ df-sb ). (Contributed by BJ, 12-Oct-2019.) (Proof modification is discouraged.)
theorem bj_ceqsal {x3: setvar} (ph ps: wff x3) (A2: class):
  $ wnf x3 ps $ >
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wal x3 (wi (wceq (cv x3) A2) ph)) ps $;

--| Remove from ~ ceqsalv dependency on ~ ax-ext (and on ~ df-cleq , ~ df-v , ~ df-clab , ~ df-sb ). (Contributed by BJ, 12-Oct-2019.) (Proof modification is discouraged.)
theorem bj_ceqsalv {x3: setvar} (ph: wff x3) (ps: wff) (A2: class):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wal x3 (wi (wceq (cv x3) A2) ph)) ps $;

--| Remove from ~ spcimdv dependency on ~ ax-9 , ~ ax-10 , ~ ax-11 , ~ ax-13 , ~ ax-ext , ~ df-cleq (and ~ df-nfc , ~ df-v , ~ df-or , ~ df-tru , ~ df-nf ). For an even more economical version, see ~ bj-spcimdvv . (Contributed by BJ, 30-Nov-2020.) (Proof modification is discouraged.)
theorem bj_spcimdv {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2: class) (B2: class x3):
  $ wi ph (wcel A2 B2) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wi ps ch) $ >
  $ wi ph (wi (wal x3 ps) ch) $;

--| Remove from ~ spcimdv dependency on ~ ax-7 , ~ ax-8 , ~ ax-10 , ~ ax-11 , ~ ax-12 ~ ax-13 , ~ ax-ext , ~ df-cleq , ~ df-clab (and ~ df-nfc , ~ df-v , ~ df-or , ~ df-tru , ~ df-nf ) at the price of adding a disjoint variable condition on ` x , B ` (but in usages, ` x ` is typically a dummy, hence fresh, variable). For the version without this disjoint variable condition, see ~ bj-spcimdv . (Contributed by BJ, 3-Nov-2021.) (Proof modification is discouraged.)
theorem bj_spcimdvv {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2 B2: class):
  $ wi ph (wcel A2 B2) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wi ps ch) $ >
  $ wi ph (wi (wal x3 ps) ch) $;

--| Equivalence between two common ways to characterize elements of a class ` B ` : the LHS says that sets are elements of ` B ` if and only if they satisfy ` ph ` while the RHS says that classes are elements of ` B ` if and only if they are sets and satisfy ` ph ` . Therefore, the LHS is a characterization among sets while the RHS is a characterization among classes. The LHS is often formulated using a class variable instead of the universe ` _V ` while this is not possible for the RHS (apart from using ` B ` itself, which would not be very useful). (Contributed by BJ, 26-Feb-2023.)
theorem elelb (ph: wff) (A2 B2: class):
  $ wb (wi (wcel A2 cvv) (wb (wcel A2 B2) ph)) (wb (wcel A2 B2) (wa (wcel A2 cvv) ph)) $;

--| Characterization of the elements of the powerclass of the cartesian square of the universal class: they are exactly the sets which are binary relations. (Contributed by BJ, 16-Dec-2023.)
theorem bj_pwvrelb (A2: class):
  $ wb (wcel A2 (cpw (cxp cvv cvv))) (wa (wcel A2 cvv) (wrel A2)) $;

--| The nonfreeness quantifier for classes defines a symmetric binary relation on var metavariables (irreflexivity is proved by ~ nfnid with additional axioms; see also ~ nfcv ). This could be proved from ~ aecom and ~ nfcvb but the latter requires a domain with at least two objects (hence uses extra axioms). (Contributed by BJ, 30-Sep-2018.) Proof modification is discouraged to avoid use of ~ eqcomd instead of ~ equcomd ; removing dependency on ~ ax-ext is possible: prove weak versions (i.e. replace classes with setvars) of ~ drnfc1 , ~ eleq2d (using ~ elequ2 ), ~ nfcvf , ~ dvelimc , ~ dvelimdc , ~ nfcvf2 . (Proof modification is discouraged.)
theorem bj_nfcsym {x3 y1: setvar}:
  $ wb (wnfc x3 (cv y1)) (wnfc y1 (cv x3)) $;

--| Substitution in an equality (use the more general version ~ bj-sbeq instead, without disjoint variable condition). (Contributed by BJ, 6-Oct-2018.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem bj_sbeqALT {x3 y1: setvar} (A2 B2: class x3 y1):
  $ wb (wsb x3 (wceq A2 B2) y1) (wceq (csb x3 (cv y1) A2) (csb x3 (cv y1) B2)) $;

--| Distribute proper substitution through an equality relation. (See ~ sbceqg ). (Contributed by BJ, 6-Oct-2018.)
theorem bj_sbeq {x3 y1: setvar} (A2 B2: class x3 y1):
  $ wb (wsb x3 (wceq A2 B2) y1) (wceq (csb x3 (cv y1) A2) (csb x3 (cv y1) B2)) $;

--| Distribute proper substitution through an equality relation. Alternate proof of ~ sbceqg . (Contributed by BJ, 6-Oct-2018.) Proof modification is discouraged to avoid using ~ sbceqg , but the Metamath program "MM-PA> MINIMIZE__WITH * / EXCEPT sbceqg" command is ok. (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_sbceqgALT {x3: setvar} (A2 B2 C V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wceq B2 C) A2) (wceq (csb x3 A2 B2) (csb x3 A2 C))) $;

--| Lemma for ~ bj-csbsn (in this lemma, ` x ` cannot occur in ` A ` ). (Contributed by BJ, 6-Oct-2018.) (New usage is discouraged.)
theorem bj_csbsnlem {x3: setvar} (A2: class):
  $ wceq (csb x3 A2 (csn (cv x3))) (csn A2) $;

--| Substitution in a singleton. (Contributed by BJ, 6-Oct-2018.)
theorem bj_csbsn {x3: setvar} (A2: class x3):
  $ wceq (csb x3 A2 (csn (cv x3))) (csn A2) $;

--| Version of ~ sbcel1g when substituting a set. (Note: one could have a corresponding version of ~ sbcel12 when substituting a set, but the point here is that the antecedent of ~ sbcel1g is not needed when substituting a set.) (Contributed by BJ, 6-Oct-2018.)
theorem bj_sbel1 {x3 y1: setvar} (A2: class x3 y1) (B2: class y1):
  $ wb (wsb x3 (wcel A2 B2) y1) (wcel (csb x3 (cv y1) A2) B2) $;

--| The class of sets verifying a tautology is the universal class. (Contributed by BJ, 24-Jul-2019.) (Proof modification is discouraged.)
theorem bj_abv {x3: setvar} (ph: wff x3):
  $ wi (wal x3 ph) (wceq (cab x3 ph) cvv) $;

--| Alternate version of ~ bj-abv ; shorter but uses ~ ax-8 . (Contributed by BJ, 24-Jul-2019.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_abvALT {x3: setvar} (ph: wff x3):
  $ wi (wal x3 ph) (wceq (cab x3 ph) cvv) $;

--| The class of sets verifying a falsity is the empty set (closed form of ~ abf ). (Contributed by BJ, 24-Jul-2019.) (Proof modification is discouraged.)
theorem bj_ab0 {x3: setvar} (ph: wff x3):
  $ wi (wal x3 (wn ph)) (wceq (cab x3 ph) c0) $;

--| Shorter proof of ~ abf (which should be kept as abfALT). (Contributed by BJ, 24-Jul-2019.) (Proof modification is discouraged.)
theorem bj_abf {x3: setvar} (ph: wff x3):
  $ wn ph $ >
  $ wceq (cab x3 ph) c0 $;

--| More direct proof of ~ csbprc (fewer essential steps). (Contributed by BJ, 24-Jul-2019.) (Proof modification is discouraged.)
theorem bj_csbprc {x3: setvar} (A2 B2: class x3):
  $ wi (wn (wcel A2 cvv)) (wceq (csb x3 A2 B2) c0) $;

--| A Fol lemma ( ~ exlimiv followed by ~ mpi ). (Contributed by BJ, 2-Jul-2022.) (Proof modification is discouraged.)
theorem bj_exlimvmpi {x3: setvar} (ph: wff x3) (ps: wff) (ch: wff x3):
  $ wi ch (wi ph ps) $ >
  $ ph $ >
  $ wi (wex x3 ch) ps $;

--| Lemma for ~ bj-vtoclg1f1 (an instance of this lemma is a version of ~ bj-vtoclg1f1 where ` x ` and ` y ` are identified). (Contributed by BJ, 30-Apr-2019.) (Proof modification is discouraged.)
theorem bj_exlimmpi {x3: setvar} (ph ps ch: wff x3):
  $ wnf x3 ps $ >
  $ wi ch (wi ph ps) $ >
  $ ph $ >
  $ wi (wex x3 ch) ps $;

--| Lemma for theorems of the ~ vtoclg family. (Contributed by BJ, 3-Oct-2019.) (Proof modification is discouraged.)
theorem bj_exlimmpbi {x3: setvar} (ph ps ch: wff x3):
  $ wnf x3 ps $ >
  $ wi ch (wb ph ps) $ >
  $ ph $ >
  $ wi (wex x3 ch) ps $;

--| Lemma for theorems of the ~ vtoclg family. (Contributed by BJ, 3-Oct-2019.) (Proof modification is discouraged.)
theorem bj_exlimmpbir {x3: setvar} (ph ps ch: wff x3):
  $ wnf x3 ph $ >
  $ wi ch (wb ph ps) $ >
  $ ps $ >
  $ wi (wex x3 ch) ph $;

--| Remove dependency on ~ ax-ext , ~ df-clab and ~ df-cleq (and ~ df-sb and ~ df-v ) from ~ vtoclf . (Contributed by BJ, 6-Oct-2019.) (Proof modification is discouraged.)
theorem bj_vtoclf {x3: setvar} (ph ps: wff x3) (A2 V: class):
  $ wnf x3 ps $ >
  $ wcel A2 V $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ ph $ >
  $ ps $;

--| Remove dependency on ~ ax-ext , ~ df-clab and ~ df-cleq (and ~ df-sb and ~ df-v ) from ~ vtocl . (Contributed by BJ, 6-Oct-2019.) (Proof modification is discouraged.)
theorem bj_vtocl {x3: setvar} (ph: wff x3) (ps: wff) (A2 V: class):
  $ wcel A2 V $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ ph $ >
  $ ps $;

--| The FOL content of ~ vtoclg1f (hence not using ~ ax-ext , ~ df-cleq , ~ df-nfc , ~ df-v ). Note the weakened "major" hypothesis and the disjoint variable condition between ` x ` and ` A ` (needed since the nonfreeness quantifier for classes is not available without ~ ax-ext ; as a byproduct, this dispenses with ~ ax-11 and ~ ax-13 ). (Contributed by BJ, 30-Apr-2019.) (Proof modification is discouraged.)
theorem bj_vtoclg1f1 {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wi ph ps) $ >
  $ ph $ >
  $ wi (wex y1 (wceq (cv y1) A2)) ps $;

--| Reprove ~ vtoclg1f from ~ bj-vtoclg1f1 . This removes dependency on ~ ax-ext , ~ df-cleq and ~ df-v . Use ~ bj-vtoclg1fv instead when sufficient (in particular when ` V ` is substituted for ` _V ` ). (Contributed by BJ, 14-Sep-2019.) (Proof modification is discouraged.)
theorem bj_vtoclg1f {x3: setvar} (ph ps: wff x3) (A2: class) (V: class x3):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wi ph ps) $ >
  $ ph $ >
  $ wi (wcel A2 V) ps $;

--| Version of ~ bj-vtoclg1f with a disjoint variable condition on ` x , V ` . This removes dependency on ~ df-sb and ~ df-clab . Prefer its use over ~ bj-vtoclg1f when sufficient (in particular when ` V ` is substituted for ` _V ` ). (Contributed by BJ, 14-Sep-2019.) (Proof modification is discouraged.)
theorem bj_vtoclg1fv {x3: setvar} (ph ps: wff x3) (A2 V: class):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wi ph ps) $ >
  $ ph $ >
  $ wi (wcel A2 V) ps $;

--| A version of ~ vtoclg with an additional disjoint variable condition (which is removable if we allow use of ~ df-clab , see ~ bj-vtoclg1f ), which requires fewer axioms (i.e., removes dependency on ~ ax-6 , ~ ax-7 , ~ ax-9 , ~ ax-12 , ~ ax-ext , ~ df-clab , ~ df-cleq , ~ df-v ). (Contributed by BJ, 2-Jul-2022.) (Proof modification is discouraged.)
theorem bj_vtoclg {x3: setvar} (ph: wff x3) (ps: wff) (A2 V: class):
  $ wi (wceq (cv x3) A2) (wi ph ps) $ >
  $ ph $ >
  $ wi (wcel A2 V) ps $;

--| Version of ~ rabeqbidv with two disjoint variable conditions removed and the third replaced by a nonfreeness hypothesis. (Contributed by BJ, 27-Apr-2019.)
theorem bj_rabeqbid {x3: setvar} (ph ps ch: wff x3) (A2 B2: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wceq (crab x3 ps A2) (crab x3 ch B2)) $;

--| Version of ~ seex with a disjoint variable condition replaced by a nonfreeness hypothesis (for the sake of illustration). (Contributed by BJ, 27-Apr-2019.)
theorem bj_seex {x3: setvar} (A2: class) (B2: class x3) (R: class):
  $ wnfc x3 B2 $ >
  $ wi (wa (wse A2 R) (wcel B2 A2)) (wcel (crab x3 (wbr (cv x3) B2 R) A2) cvv) $;

--| Version of ~ df-nfc with a disjoint variable condition replaced with a nonfreeness hypothesis. (Contributed by BJ, 2-May-2019.)
theorem bj_nfcf {x3 y1: setvar} (A2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wb (wnfc x3 A2) (wal y1 (wnf x3 (wcel (cv y1) A2))) $;

--| Version of ~ sepg which does not require ~ df-clab , thanks to the use of ~ bj-vtoclg (and ultimately, to the use of ~ elissetv instead of ~ elisset ). This axiom save is not very important, since this theorem uses ~ df-cleq and ~ df-clel . This theorem is a remnant of a previous state of set.mm where the axiom saving was larger. (Contributed by BJ, 2-Jul-2022.) (Proof modification is discouraged.)
theorem bj_sepg {x3 y1: setvar} (ph: wff x3) (A2: class) (V: class x3 y1):
  $ wi (wcel A2 V) (wex y1 (wal x3 (wb (wcel (cv x3) (cv y1)) (wa (wcel (cv x3) A2) ph)))) $;

--| Proof of ~ inex1g from ~ sepg to then allow proving ~ inex1 from it. That does not reduce the combined proof size of ~ inex1 and ~ inex1g . (Contributed by BJ, 14-Jul-2026.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_inex1gALT (A2 B2 V: class):
  $ wi (wcel A2 V) (wcel (cin A2 B2) cvv) $;

--| Alternate proof of ~ elabd2 bypassing ~ elab6g (and using ~ sbiedvw instead of the ` A. x ( x = y -> ps ) ` idiom). (Contributed by BJ, 16-Oct-2024.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_elabd2ALT {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2: class) (B2 V: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wceq B2 (cab x3 ps)) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wcel A2 B2) ch) $;

--| Generalization of ~ unrab . Equality need not hold. (Contributed by BJ, 21-Apr-2019.)
theorem bj_unrab {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wss (cun (crab x3 ph A2) (crab x3 ps B2)) (crab x3 (wo ph ps) (cun A2 B2)) $;

--| Generalization of ~ inrab . (Contributed by BJ, 21-Apr-2019.)
theorem bj_inrab {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wceq (cin (crab x3 ph A2) (crab x3 ps B2)) (crab x3 (wa ph ps) (cin A2 B2)) $;

--| Shorter proof of ~ inrab . (Contributed by BJ, 21-Apr-2019.) (Proof modification is discouraged.)
theorem bj_inrab2 {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wceq (cin (crab x3 ph A2) (crab x3 ps A2)) (crab x3 (wa ph ps) A2) $;

--| Generalization of ~ dfrab3ss . Shortens ~ dfrab3ss . (Contributed by BJ, 21-Apr-2019.) (Revised by OpenAI, 7-Jul-2020.)
theorem bj_inrab3 {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wceq (cin A2 (crab x3 ph B2)) (cin (crab x3 ph A2) B2) $;

--| Restricted class abstraction with true formula. (Contributed by BJ, 22-Apr-2019.)
theorem bj_rabtr {x3: setvar} (A2: class):
  $ wceq (crab x3 wtru A2) A2 $;

--| Alternate proof of ~ bj-rabtr . (Contributed by BJ, 22-Apr-2019.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_rabtrALT {x3: setvar} (A2: class):
  $ wceq (crab x3 wtru A2) A2 $;

--| Proof of ~ bj-rabtr found automatically by the Metamath program "MM-PA> IMPROVE ALL / DEPTH 3 / 3" command followed by "MM-PA> MINIMIZE__WITH *". (Contributed by BJ, 22-Apr-2019.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_rabtrAUTO {x3: setvar} (A2: class):
  $ wceq (crab x3 wtru A2) A2 $;

--| Syntax for generalized class abstractions.
term bj_cgab {x3: setvar} (ph: wff x3) (A2: class x3): class;

--| Definition of generalized class abstractions: typically, ` x ` is a bound variable in ` A ` and ` ph ` and ` { A | x | ph } ` denotes "the class of ` A ( x ) ` 's such that ` ph ( x ) ` ". (Contributed by BJ, 4-Oct-2024.)
axiom df_bj_gab {x3 y1: setvar} (ph: wff x3) (A2: class x3):
  $ wceq (bj_cgab x3 ph A2) (cab y1 (wex x3 (wa (wceq A2 (cv y1)) ph))) $;

--| Inclusion of generalized class abstractions. (Contributed by BJ, 4-Oct-2024.)
theorem bj_gabss {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wi (wal x3 (wa (wceq A2 B2) (wi ph ps))) (wss (bj_cgab x3 ph A2) (bj_cgab x3 ps B2)) $;

--| Inclusion of generalized class abstractions. Deduction form. (Contributed by BJ, 4-Oct-2024.)
theorem bj_gabssd {x3: setvar} (ph ps ch: wff x3) (A2 B2: class x3):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wi ps ch) $ >
  $ wi ph (wss (bj_cgab x3 ps A2) (bj_cgab x3 ch B2)) $;

--| Equality of generalized class abstractions. Deduction form. (Contributed by BJ, 4-Oct-2024.)
theorem bj_gabeqd {x3: setvar} (ph ps ch: wff x3) (A2 B2: class x3):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wceq (bj_cgab x3 ps A2) (bj_cgab x3 ch B2)) $;

--| Equality of generalized class abstractions, with implicit substitution. (Contributed by BJ, 4-Oct-2024.)
theorem bj_gabeqis {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class x3) (B2: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wceq A2 B2) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wceq (bj_cgab x3 ph A2) (bj_cgab y1 ps B2) $;

--| Elements of a generalized class abstraction. (Contributed by BJ, 4-Oct-2024.)
theorem bj_elgab {x3: setvar} (ph ps ch: wff x3) (A2 B2 V: class x3):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wb (wex x3 (wa (wceq A2 B2) ps)) ch) $ >
  $ wi ph (wb (wcel A2 (bj_cgab x3 ps B2)) ch) $;

--| Generalized class abstraction as a direct image. TODO: improve the support lemmas ~ elimag and ~ fvelima to nonfreeness hypothesis (and for the latter, biconditional). (Contributed by BJ, 4-Oct-2024.)
theorem bj_gabima {x3: setvar} (ph ps: wff x3) (F: class x3):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wnfc x3 F) $ >
  $ wi ph (wfun F) $ >
  $ wi ph (wss (cab x3 ps) (cdm F)) $ >
  $ wi ph (wceq (bj_cgab x3 ps (cfv (cv x3) F)) (cima F (cab x3 ps))) $;

--| Syntax for restricted nonfreeness.
term wrnf {x3: setvar} (ph: wff x3) (A2: class x3): wff;

--| Definition of restricted nonfreeness. Informally, the proposition ` F/ x e. A ph ` means that ` ph ( x ) ` does not vary on ` A ` . (Contributed by BJ, 19-Mar-2021.)
axiom df_bj_rnf {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wrnf x3 ph A2) (wi (wrex x3 ph A2) (wral x3 ph A2)) $;

--| A version of Russell's paradox ~ ru not mentioning the universal class. (see also ~ bj-ru ). (Contributed by BJ, 12-Oct-2019.) Remove usage of ~ ax-10 , ~ ax-11 , ~ ax-12 by using ~ eqabbw following BTernaryTau's similar revision of ~ ru . (Revised by BJ, 28-Jun-2025.) (Proof modification is discouraged.)
theorem bj_ru1 {x3 y1: setvar}:
  $ wn (wex y1 (wceq (cv y1) (cab x3 (wn (wcel (cv x3) (cv x3)))))) $;

--| Remove dependency on ~ ax-13 (and ~ df-v ) from Russell's paradox ~ ru expressed with primitive symbols and with a class variable ` V ` . Note the more economical use of ~ elissetv instead of ~ isset to avoid use of ~ df-v . (Contributed by BJ, 12-Oct-2019.) (Proof modification is discouraged.)
theorem bj_ru {x3: setvar} (V: class x3):
  $ wn (wcel (cab x3 (wn (wcel (cv x3) (cv x3)))) V) $;

--| Lemma for ~ currysetlem , where it is used with ` ( x e. x -> ph ) ` substituted for ` ps ` . (Contributed by BJ, 23-Sep-2023.) This proof is intuitionistically valid. (Proof modification is discouraged.)
theorem currysetlem {x3: setvar} (ph: wff) (ps: wff x3) (V: class x3):
  $ wi (wcel (cab x3 ps) V) (wb (wcel (cab x3 ps) (cab x3 (wi (wcel (cv x3) (cv x3)) ph))) (wi (wcel (cab x3 ps) (cab x3 ps)) ph)) $;

--| Curry's paradox in set theory. This can be seen as a generalization of Russell's paradox, which corresponds to the case where ` ph ` is ` F. ` . See alternate exposal of basically the same proof ~ currysetALT . (Contributed by BJ, 23-Sep-2023.) This proof is intuitionistically valid. (Proof modification is discouraged.)
theorem curryset {x3: setvar} (ph: wff) (V: class x3):
  $ wn (wcel (cab x3 (wi (wcel (cv x3) (cv x3)) ph)) V) $;

--| Lemma for ~ currysetALT . (Contributed by BJ, 23-Sep-2023.) This proof is intuitionistically valid. (Proof modification is discouraged.)
theorem currysetlem1 {x3: setvar} (ph: wff) (V X: class x3):
  $ wceq X (cab x3 (wi (wcel (cv x3) (cv x3)) ph)) $ >
  $ wi (wcel X V) (wb (wcel X X) (wi (wcel X X) ph)) $;

--| Lemma for ~ currysetALT . (Contributed by BJ, 23-Sep-2023.) This proof is intuitionistically valid. (Proof modification is discouraged.)
theorem currysetlem2 {x3: setvar} (ph: wff) (V X: class x3):
  $ wceq X (cab x3 (wi (wcel (cv x3) (cv x3)) ph)) $ >
  $ wi (wcel X V) (wi (wcel X X) ph) $;

--| Lemma for ~ currysetALT . (Contributed by BJ, 23-Sep-2023.) This proof is intuitionistically valid. (Proof modification is discouraged.)
theorem currysetlem3 {x3: setvar} (ph: wff) (V X: class x3):
  $ wceq X (cab x3 (wi (wcel (cv x3) (cv x3)) ph)) $ >
  $ wn (wcel X V) $;

--| Alternate proof of ~ curryset , or more precisely alternate exposal of the same proof. (Contributed by BJ, 23-Sep-2023.) This proof is intuitionistically valid. (Proof modification is discouraged.) (New usage is discouraged.)
theorem currysetALT {x3: setvar} (ph: wff) (V: class x3):
  $ wn (wcel (cab x3 (wi (wcel (cv x3) (cv x3)) ph)) V) $;

--| Inference associated with ~ n0 . Shortens ~ 2ndcdisj (2888>2878), ~ notsep (264>253). (Contributed by BJ, 22-Apr-2019.)
theorem bj_n0i {x3: setvar} (A2: class):
  $ wne A2 c0 $ >
  $ wex x3 (wcel (cv x3) A2) $;

--| Disjointness of the singletons containing 0 and 1. This is a consequence of ~ disjcsn but the present proof does not use regularity. (Contributed by BJ, 4-Apr-2019.) (Proof modification is discouraged.)
theorem bj_disjsn01:
  $ wceq (cin (csn c0) (csn c1o)) c0 $;

--| The empty set does not belong to ` { 1o } ` . (Contributed by BJ, 6-Apr-2019.)
theorem bj_0nel1:
  $ wnel c0 (csn c1o) $;

--| ` 1o ` does not belong to ` { (/) } ` . (Contributed by BJ, 6-Apr-2019.)
theorem bj_1nel0:
  $ wnel c1o (csn c0) $;

--| The image of a singleton, general case. [Change and relabel ~ xpimasn accordingly, maybe to xpima2sn.] (Contributed by BJ, 6-Apr-2019.)
theorem bj_xpimasn (A2 B2 X: class):
  $ wceq (cima (cxp A2 B2) (csn X)) (cif (wcel X A2) B2 c0) $;

--| The image of a singleton by a direct product, empty case. [Change and relabel ~ xpimasn accordingly, maybe to xpima2sn.] (Contributed by BJ, 6-Apr-2019.)
theorem bj_xpima1sn (A2 B2 X: class):
  $ wi (wn (wcel X A2)) (wceq (cima (cxp A2 B2) (csn X)) c0) $;

--| Alternate proof of ~ bj-xpima1sn . (Contributed by BJ, 6-Apr-2019.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_xpima1snALT (A2 B2 X: class):
  $ wi (wn (wcel X A2)) (wceq (cima (cxp A2 B2) (csn X)) c0) $;

--| The image of a singleton by a direct product, nonempty case. [To replace ~ xpimasn .] (Contributed by BJ, 6-Apr-2019.) (Proof modification is discouraged.)
theorem bj_xpima2sn (A2 B2 X: class):
  $ wi (wcel X A2) (wceq (cima (cxp A2 B2) (csn X)) B2) $;

--| If the first factor of a product is nonempty, and the product is a set, then the second factor is a set. UPDATE: this is actually the curried (exported) form of ~ xpexcnv (up to commutation in the product). (Contributed by BJ, 6-Oct-2018.) (Proof modification is discouraged.)
theorem bj_xpnzex (A2 B2 V: class):
  $ wi (wne A2 c0) (wi (wcel (cxp A2 B2) V) (wcel B2 cvv)) $;

--| Curried (exported) form of ~ xpexg . (Contributed by BJ, 2-Apr-2019.)
theorem bj_xpexg2 (A2 B2 V W: class):
  $ wi (wcel A2 V) (wi (wcel B2 W) (wcel (cxp A2 B2) cvv)) $;

--| If the first factor of a product is a nonempty set, then the product is a set if and only if the second factor is a set. (Contributed by BJ, 2-Apr-2019.)
theorem bj_xpnzexb (A2 B2 V: class):
  $ wi (wcel A2 (cdif V (csn c0))) (wb (wcel B2 cvv) (wcel (cxp A2 B2) cvv)) $;

--| Substitution property for certain classes. (Contributed by BJ, 2-Apr-2019.)
theorem bj_cleq {x3: setvar} (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cab x3 (wcel (csn (cv x3)) (cima A2 C))) (cab x3 (wcel (csn (cv x3)) (cima B2 C)))) $;

--| The class of sets "whose singletons" belong to a set is a set. Nice application of ~ ax-rep . (Contributed by BJ, 6-Oct-2018.)
theorem bj_snsetex {x3: setvar} (A2: class) (V: class x3):
  $ wi (wcel A2 V) (wcel (cab x3 (wcel (csn (cv x3)) A2)) cvv) $;

--| Sethood of certain classes. (Contributed by BJ, 2-Apr-2019.)
theorem bj_clexab {x3: setvar} (A2 B2: class) (V: class x3):
  $ wi (wcel A2 V) (wcel (cab x3 (wcel (csn (cv x3)) (cima A2 B2))) cvv) $;

--| Syntax for singletonization. (Contributed by BJ, 6-Oct-2018.)
term bj_csngl (A2: class): class;

--| Definition of "singletonization". The class ` sngl A ` is isomorphic to ` A ` and since it contains only singletons, it can be easily be adjoined disjoint elements, which can be useful in various constructions. (Contributed by BJ, 6-Oct-2018.)
axiom df_bj_sngl {x3 y1: setvar} (A2: class):
  $ wceq (bj_csngl A2) (cab x3 (wrex y1 (wceq (cv x3) (csn (cv y1))) A2)) $;

--| Substitution property for ` sngl ` . (Contributed by BJ, 6-Oct-2018.)
theorem bj_sngleq (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (bj_csngl A2) (bj_csngl B2)) $;

--| Characterization of the elements of the singletonization of a class. (Contributed by BJ, 6-Oct-2018.)
theorem bj_elsngl {x3: setvar} (A2 B2: class):
  $ wb (wcel A2 (bj_csngl B2)) (wrex x3 (wceq A2 (csn (cv x3))) B2) $;

--| Characterization of the elements of ` A ` in terms of elements of its singletonization. (Contributed by BJ, 6-Oct-2018.)
theorem bj_snglc (A2 B2: class):
  $ wb (wcel A2 B2) (wcel (csn A2) (bj_csngl B2)) $;

--| The singletonization of a class is included in its powerclass. (Contributed by BJ, 6-Oct-2018.)
theorem bj_snglss (A2: class):
  $ wss (bj_csngl A2) (cpw A2) $;

--| The empty set is not a member of a singletonization (neither is any nonsingleton, in particular any von Neuman ordinal except possibly ~ df-1o ). (Contributed by BJ, 6-Oct-2018.)
theorem bj_0nelsngl (A2: class):
  $ wnel c0 (bj_csngl A2) $;

--| Inverse of singletonization. (Contributed by BJ, 6-Oct-2018.)
theorem bj_snglinv {x3: setvar} (A2: class):
  $ wceq A2 (cab x3 (wcel (csn (cv x3)) (bj_csngl A2))) $;

--| A class is a set if and only if its singletonization is a set. (Contributed by BJ, 6-Oct-2018.)
theorem bj_snglex (A2: class):
  $ wb (wcel A2 cvv) (wcel (bj_csngl A2) cvv) $;

--| Syntax for the tagged copy of a class. (Contributed by BJ, 6-Oct-2018.)
term bj_ctag (A2: class): class;

--| Definition of the tagged copy of a class, that is, the adjunction to (an isomorph of) ` A ` of a disjoint element (here, the empty set). Remark: this could be used for the one-point compactification of a topological space. (Contributed by BJ, 6-Oct-2018.)
axiom df_bj_tag (A2: class):
  $ wceq (bj_ctag A2) (cun (bj_csngl A2) (csn c0)) $;

--| Substitution property for ` tag ` . (Contributed by BJ, 6-Oct-2018.)
theorem bj_tageq (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (bj_ctag A2) (bj_ctag B2)) $;

--| Characterization of the elements of the tagging of a class. (Contributed by BJ, 6-Oct-2018.)
theorem bj_eltag {x3: setvar} (A2 B2: class):
  $ wb (wcel A2 (bj_ctag B2)) (wo (wrex x3 (wceq A2 (csn (cv x3))) B2) (wceq A2 c0)) $;

--| The empty set belongs to the tagging of a class. (Contributed by BJ, 6-Apr-2019.)
theorem bj_0eltag (A2: class):
  $ wcel c0 (bj_ctag A2) $;

--| The tagging of a class is nonempty. (Contributed by BJ, 6-Apr-2019.)
theorem bj_tagn0 (A2: class):
  $ wne (bj_ctag A2) c0 $;

--| The tagging of a class is included in its powerclass. (Contributed by BJ, 6-Oct-2018.)
theorem bj_tagss (A2: class):
  $ wss (bj_ctag A2) (cpw A2) $;

--| The singletonization is included in the tagging. (Contributed by BJ, 6-Oct-2018.)
theorem bj_snglsstag (A2: class):
  $ wss (bj_csngl A2) (bj_ctag A2) $;

--| The singletonization is included in the tagging. (Contributed by BJ, 6-Oct-2018.)
theorem bj_sngltagi (A2 B2: class):
  $ wi (wcel A2 (bj_csngl B2)) (wcel A2 (bj_ctag B2)) $;

--| The singletonization and the tagging of a set contain the same singletons. (Contributed by BJ, 6-Oct-2018.)
theorem bj_sngltag (A2 B2 V: class):
  $ wi (wcel A2 V) (wb (wcel (csn A2) (bj_csngl B2)) (wcel (csn A2) (bj_ctag B2))) $;

--| Characterization of the elements of ` B ` in terms of elements of its tagged version. (Contributed by BJ, 6-Oct-2018.)
theorem bj_tagci (A2 B2: class):
  $ wi (wcel A2 B2) (wcel (csn A2) (bj_ctag B2)) $;

--| Characterization of the elements of ` B ` in terms of elements of its tagged version. (Contributed by BJ, 6-Oct-2018.)
theorem bj_tagcg (A2 B2 V: class):
  $ wi (wcel A2 V) (wb (wcel A2 B2) (wcel (csn A2) (bj_ctag B2))) $;

--| Inverse of tagging. (Contributed by BJ, 6-Oct-2018.)
theorem bj_taginv {x3: setvar} (A2: class):
  $ wceq A2 (cab x3 (wcel (csn (cv x3)) (bj_ctag A2))) $;

--| A class is a set if and only if its tagging is a set. (Contributed by BJ, 6-Oct-2018.)
theorem bj_tagex (A2: class):
  $ wb (wcel A2 cvv) (wcel (bj_ctag A2) cvv) $;

--| The products of a given class and the tagging of either of two equal classes are equal. (Contributed by BJ, 6-Apr-2019.)
theorem bj_xtageq (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cxp C (bj_ctag A2)) (cxp C (bj_ctag B2))) $;

--| The product of a set and the tagging of a set is a set. (Contributed by BJ, 2-Apr-2019.)
theorem bj_xtagex (A2 B2 V W: class):
  $ wi (wcel A2 V) (wi (wcel B2 W) (wcel (cxp A2 (bj_ctag B2)) cvv)) $;

--| Syntax for the class projection. (Contributed by BJ, 6-Apr-2019.)
term bj_cproj (A2 B2: class): class;

--| Definition of the class projection corresponding to tagged tuples. The expression ` ( A Proj B ) ` denotes the projection on the A^th component. (Contributed by BJ, 6-Apr-2019.) (New usage is discouraged.)
axiom df_bj_proj {x3: setvar} (A2 B2: class):
  $ wceq (bj_cproj A2 B2) (cab x3 (wcel (csn (cv x3)) (cima B2 (csn A2)))) $;

--| Substitution property for ` Proj ` . (Contributed by BJ, 6-Apr-2019.)
theorem bj_projeq (A2 B2 C D: class):
  $ wi (wceq A2 C) (wi (wceq B2 D) (wceq (bj_cproj A2 B2) (bj_cproj C D))) $;

--| Substitution property for ` Proj ` . (Contributed by BJ, 6-Apr-2019.)
theorem bj_projeq2 (A2 B2 C: class):
  $ wi (wceq B2 C) (wceq (bj_cproj A2 B2) (bj_cproj A2 C)) $;

--| The class projection on a given component preserves unions. (Contributed by BJ, 6-Apr-2019.)
theorem bj_projun (A2 B2 C: class):
  $ wceq (bj_cproj A2 (cun B2 C)) (cun (bj_cproj A2 B2) (bj_cproj A2 C)) $;

--| Sethood of the class projection. (Contributed by BJ, 6-Apr-2019.)
theorem bj_projex (A2 B2 V: class):
  $ wi (wcel B2 V) (wcel (bj_cproj A2 B2) cvv) $;

--| Value of the class projection. (Contributed by BJ, 6-Apr-2019.)
theorem bj_projval (A2 B2 C V: class):
  $ wi (wcel A2 V) (wceq (bj_cproj A2 (cxp (csn B2) (bj_ctag C))) (cif (wceq B2 A2) C c0)) $;

--| Syntax for Morse monuple. (Contributed by BJ, 6-Apr-2019.)
term bj_c1upl (A2: class): class;

--| Definition of the Morse monuple (1-tuple). This is not useful per se, but is used as a step towards the definition of couples (2-tuples, or ordered pairs). The reason for "tagging" the set is so that an m-tuple and an n-tuple be equal only when m = n. With this definition, the 0-tuple is the empty set. New usage is discouraged because the precise definition is generally unimportant compared to the characteristic properties ~ bj-2upleq , ~ bj-2uplth , ~ bj-2uplex , and the properties of the projections (see ~ df-bj-pr1 and ~ df-bj-pr2 ). (Contributed by BJ, 6-Apr-2019.) (New usage is discouraged.)
axiom df_bj_1upl (A2: class):
  $ wceq (bj_c1upl A2) (cxp (csn c0) (bj_ctag A2)) $;

--| Substitution property for ` (| - |) ` . (Contributed by BJ, 6-Apr-2019.)
theorem bj_1upleq (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (bj_c1upl A2) (bj_c1upl B2)) $;

--| Syntax for the first class tuple projection. (Contributed by BJ, 6-Apr-2019.)
term bj_cpr1 (A2: class): class;

--| Definition of the first projection of a class tuple. New usage is discouraged because the precise definition is generally unimportant compared to the characteristic properties ~ bj-pr1eq , ~ bj-pr11val , ~ bj-pr21val , ~ bj-pr1ex . (Contributed by BJ, 6-Apr-2019.) (New usage is discouraged.)
axiom df_bj_pr1 (A2: class):
  $ wceq (bj_cpr1 A2) (bj_cproj c0 A2) $;

--| Substitution property for ` pr1 ` . (Contributed by BJ, 6-Apr-2019.)
theorem bj_pr1eq (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (bj_cpr1 A2) (bj_cpr1 B2)) $;

--| The first projection preserves unions. (Contributed by BJ, 6-Apr-2019.)
theorem bj_pr1un (A2 B2: class):
  $ wceq (bj_cpr1 (cun A2 B2)) (cun (bj_cpr1 A2) (bj_cpr1 B2)) $;

--| Value of the first projection. (Contributed by BJ, 6-Apr-2019.)
theorem bj_pr1val (A2 B2: class):
  $ wceq (bj_cpr1 (cxp (csn A2) (bj_ctag B2))) (cif (wceq A2 c0) B2 c0) $;

--| Value of the first projection of a monuple. (Contributed by BJ, 6-Apr-2019.)
theorem bj_pr11val (A2: class):
  $ wceq (bj_cpr1 (bj_c1upl A2)) A2 $;

--| Sethood of the first projection. (Contributed by BJ, 6-Oct-2018.)
theorem bj_pr1ex (A2 V: class):
  $ wi (wcel A2 V) (wcel (bj_cpr1 A2) cvv) $;

--| The characteristic property of monuples. This holds without sethood hypotheses. (Contributed by BJ, 6-Apr-2019.)
theorem bj_1uplth (A2 B2: class):
  $ wb (wceq (bj_c1upl A2) (bj_c1upl B2)) (wceq A2 B2) $;

--| A monuple is a set if and only if its coordinates are sets. (Contributed by BJ, 6-Apr-2019.)
theorem bj_1uplex (A2: class):
  $ wb (wcel (bj_c1upl A2) cvv) (wcel A2 cvv) $;

--| A monuple is nonempty. (Contributed by BJ, 6-Apr-2019.)
theorem bj_1upln0 (A2: class):
  $ wne (bj_c1upl A2) c0 $;

--| Syntax for Morse couple. (Contributed by BJ, 6-Oct-2018.)
term bj_c2uple (A2 B2: class): class;

--| Definition of the Morse couple. See ~ df-bj-1upl . New usage is discouraged because the precise definition is generally unimportant compared to the characteristic properties ~ bj-2upleq , ~ bj-2uplth , ~ bj-2uplex , and the properties of the projections (see ~ df-bj-pr1 and ~ df-bj-pr2 ). (Contributed by BJ, 6-Oct-2018.) (New usage is discouraged.)
axiom df_bj_2upl (A2 B2: class):
  $ wceq (bj_c2uple A2 B2) (cun (bj_c1upl A2) (cxp (csn c1o) (bj_ctag B2))) $;

--| Substitution property for ` (| - ,, - |) ` . (Contributed by BJ, 6-Oct-2018.)
theorem bj_2upleq (A2 B2 C D: class):
  $ wi (wceq A2 B2) (wi (wceq C D) (wceq (bj_c2uple A2 C) (bj_c2uple B2 D))) $;

--| Value of the first projection of a couple. (Contributed by BJ, 6-Oct-2018.)
theorem bj_pr21val (A2 B2: class):
  $ wceq (bj_cpr1 (bj_c2uple A2 B2)) A2 $;

--| Syntax for the second class tuple projection. (Contributed by BJ, 6-Oct-2018.)
term bj_cpr2 (A2: class): class;

--| Definition of the second projection of a class tuple. New usage is discouraged because the precise definition is generally unimportant compared to the characteristic properties ~ bj-pr2eq , ~ bj-pr22val , ~ bj-pr2ex . (Contributed by BJ, 6-Oct-2018.) (New usage is discouraged.)
axiom df_bj_pr2 (A2: class):
  $ wceq (bj_cpr2 A2) (bj_cproj c1o A2) $;

--| Substitution property for ` pr2 ` . (Contributed by BJ, 6-Oct-2018.)
theorem bj_pr2eq (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (bj_cpr2 A2) (bj_cpr2 B2)) $;

--| The second projection preserves unions. (Contributed by BJ, 6-Apr-2019.)
theorem bj_pr2un (A2 B2: class):
  $ wceq (bj_cpr2 (cun A2 B2)) (cun (bj_cpr2 A2) (bj_cpr2 B2)) $;

--| Value of the second projection. (Contributed by BJ, 6-Apr-2019.)
theorem bj_pr2val (A2 B2: class):
  $ wceq (bj_cpr2 (cxp (csn A2) (bj_ctag B2))) (cif (wceq A2 c1o) B2 c0) $;

--| Value of the second projection of a couple. (Contributed by BJ, 6-Oct-2018.)
theorem bj_pr22val (A2 B2: class):
  $ wceq (bj_cpr2 (bj_c2uple A2 B2)) B2 $;

--| Sethood of the second projection. (Contributed by BJ, 6-Oct-2018.)
theorem bj_pr2ex (A2 V: class):
  $ wi (wcel A2 V) (wcel (bj_cpr2 A2) cvv) $;

--| The characteristic property of couples. This holds without sethood hypotheses (compare ~ opth ). (Contributed by BJ, 6-Oct-2018.)
theorem bj_2uplth (A2 B2 C D: class):
  $ wb (wceq (bj_c2uple A2 B2) (bj_c2uple C D)) (wa (wceq A2 C) (wceq B2 D)) $;

--| A couple is a set if and only if its coordinates are sets. For the advantages offered by the reverse closure property, see the section head comment. (Contributed by BJ, 6-Oct-2018.)
theorem bj_2uplex (A2 B2: class):
  $ wb (wcel (bj_c2uple A2 B2) cvv) (wa (wcel A2 cvv) (wcel B2 cvv)) $;

--| A couple is nonempty. (Contributed by BJ, 21-Apr-2019.)
theorem bj_2upln0 (A2 B2: class):
  $ wne (bj_c2uple A2 B2) c0 $;

--| A couple is never equal to a monuple. It is in order to have this "non-clashing" result that tagging was used. Without tagging, we would have ` (| A , (/) |) = (| A |) ` . In the context of Morse tuples, it is natural to define the 0-tuple as the empty set. Therefore, the present theorem together with ~ bj-1upln0 and ~ bj-2upln0 tell us that an m-tuple may equal an n-tuple only when m = n, at least for m, n <= 2, but this result would extend as soon as we define n-tuples for higher values of n. (Contributed by BJ, 21-Apr-2019.)
theorem bj_2upln1upl (A2 B2 C: class):
  $ wne (bj_c2uple A2 B2) (bj_c1upl C) $;

--| Relative version of ~ cleqf . (Contributed by BJ, 27-Dec-2023.)
theorem bj_rcleqf {x3: setvar} (A2 B2 V: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 V $ >
  $ wb (wceq (cin V A2) (cin V B2)) (wral x3 (wb (wcel (cv x3) A2) (wcel (cv x3) B2)) V) $;

--| Relative version of ~ dfcleq . (Contributed by BJ, 27-Dec-2023.)
theorem bj_rcleq {x3: setvar} (A2 B2 V: class):
  $ wb (wceq (cin V A2) (cin V B2)) (wral x3 (wb (wcel (cv x3) A2) (wcel (cv x3) B2)) V) $;

--| Relative form of ~ eqabb . (Contributed by BJ, 27-Dec-2023.)
theorem bj_reabeq {x3: setvar} (ph: wff x3) (A2 V: class):
  $ wb (wceq (cin V A2) (crab x3 ph V)) (wral x3 (wb (wcel (cv x3) A2) ph) V) $;

--| Relative version of ~ ssdifin0 , allowing a biconditional, and of ~ disj2 . (Contributed by BJ, 11-Nov-2021.) This proof does not rely, even indirectly, on ~ ssdifin0 nor ~ disj2 . (Proof modification is discouraged.)
theorem bj_disj2r (A2 B2 V: class):
  $ wb (wss (cin A2 V) (cdif V B2)) (wceq (cin (cin A2 B2) V) c0) $;

--| Contraposition law for relative subclasses. Relative and generalized version of ~ ssconb . Shortens ~ ssconb , ~ conss2 . (Contributed by BJ, 11-Nov-2021.) This proof does not rely, even indirectly, on ~ ssconb nor ~ conss2 . (Proof modification is discouraged.)
theorem bj_sscon (A2 B2 V: class):
  $ wb (wss (cin A2 V) (cdif V B2)) (wss (cin B2 V) (cdif V A2)) $;

--| Two ways of stating that the extension of a formula is a set. (Contributed by BJ, 18-Jan-2025.) (Proof modification is discouraged.)
theorem bj_abex {x3 y1: setvar} (ph: wff x3):
  $ wb (wcel (cab x3 ph) cvv) (wex y1 (wal x3 (wb (wcel (cv x3) (cv y1)) ph))) $;

--| Two ways of stating that a class is a set. (Contributed by BJ, 18-Jan-2025.) (Proof modification is discouraged.)
theorem bj_clex {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wb (wcel (cv x3) A2) ph $ >
  $ wb (wcel A2 cvv) (wex y1 (wal x3 (wb (wcel (cv x3) (cv y1)) ph))) $;

--| Two ways of stating the axiom of singleton (which is the universal closure of either side, see ~ ax-bj-sn ). (Contributed by BJ, 12-Jan-2025.) (Proof modification is discouraged.)
theorem bj_axsn {y1 z: setvar} (x3: setvar):
  $ wb (wcel (csn (cv x3)) cvv) (wex y1 (wal z (wb (wcel (cv z) (cv y1)) (wceq (cv z) (cv x3))))) $;

--| Axiom of singleton. (Contributed by BJ, 12-Jan-2025.)
axiom ax_bj_sn {x3 y1 z: setvar}:
  $ wal x3 (wex y1 (wal z (wb (wcel (cv z) (cv y1)) (wceq (cv z) (cv x3))))) $;

--| A singleton built on a set is a set. Contrary to ~ bj-snex , this proof is intuitionistically valid and does not require ~ ax-nul . (Contributed by NM, 7-Aug-1994.) Extract it from ~ snex and prove it from ~ ax-bj-sn . (Revised by BJ, 12-Jan-2025.) (Proof modification is discouraged.)
theorem bj_snexg (A2 V: class):
  $ wi (wcel A2 V) (wcel (csn A2) cvv) $;

--| A singleton is a set. See also ~ snex , ~ snexALT . (Contributed by NM, 7-Aug-1994.) Prove it from ~ ax-bj-sn . (Revised by BJ, 12-Jan-2025.) (Proof modification is discouraged.)
theorem bj_snex (A2: class):
  $ wcel (csn A2) cvv $;

--| Two ways of stating the axiom of binary union (which is the universal closure of either side, see ~ ax-bj-bun ). (Contributed by BJ, 12-Jan-2025.) (Proof modification is discouraged.)
theorem bj_axbun {z t: setvar} (x3 y1: setvar):
  $ wb (wcel (cun (cv x3) (cv y1)) cvv) (wex z (wal t (wb (wcel (cv t) (cv z)) (wo (wcel (cv t) (cv x3)) (wcel (cv t) (cv y1)))))) $;

--| Axiom of binary union. (Contributed by BJ, 12-Jan-2025.)
axiom ax_bj_bun {x3 y1 z t: setvar}:
  $ wal x3 (wal y1 (wex z (wal t (wb (wcel (cv t) (cv z)) (wo (wcel (cv t) (cv x3)) (wcel (cv t) (cv y1))))))) $;

--| Existence of binary unions of sets, proved from ~ ax-bj-bun . (Contributed by BJ, 12-Jan-2025.) (Proof modification is discouraged.)
theorem bj_unexg (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wcel (cun A2 B2) cvv) $;

--| Existence of unordered pairs formed on sets, proved from ~ ax-bj-sn and ~ ax-bj-bun . Contrary to ~ bj-prex , this proof is intuitionistically valid and does not require ~ ax-nul . (Contributed by BJ, 12-Jan-2025.) (Proof modification is discouraged.)
theorem bj_prexg (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wcel (cpr A2 B2) cvv) $;

--| Existence of unordered pairs proved from ~ ax-bj-sn and ~ ax-bj-bun . (Contributed by BJ, 12-Jan-2025.) (Proof modification is discouraged.)
theorem bj_prex (A2 B2: class):
  $ wcel (cpr A2 B2) cvv $;

--| Two ways of stating the axiom of adjunction (which is the universal closure of either side, see ~ ax-bj-adj ). (Contributed by BJ, 12-Jan-2025.) (Proof modification is discouraged.)
theorem bj_axadj {z t: setvar} (x3 y1: setvar):
  $ wb (wcel (cun (cv x3) (csn (cv y1))) cvv) (wex z (wal t (wb (wcel (cv t) (cv z)) (wo (wcel (cv t) (cv x3)) (wceq (cv t) (cv y1)))))) $;

--| Axiom of adjunction. (Contributed by BJ, 19-Jan-2025.)
axiom ax_bj_adj {x3 y1 z t: setvar}:
  $ wal x3 (wal y1 (wex z (wal t (wb (wcel (cv t) (cv z)) (wo (wcel (cv t) (cv x3)) (wceq (cv t) (cv y1))))))) $;

--| Existence of the result of the adjunction (generalized only in the first term since this suffices for current applications). (Contributed by BJ, 19-Jan-2025.) (Proof modification is discouraged.)
theorem bj_adjg1 {x3: setvar} (A2 V: class x3):
  $ wi (wcel A2 V) (wcel (cun A2 (csn (cv x3))) cvv) $;

--| Singleton from adjunction and empty set. (Contributed by BJ, 19-Jan-2025.) (Proof modification is discouraged.)
theorem bj_snfromadj {x3: setvar}:
  $ wcel (csn (cv x3)) cvv $;

--| Unordered pair from adjunction. (Contributed by BJ, 19-Jan-2025.) (Proof modification is discouraged.)
theorem bj_prfromadj {x3 y1: setvar}:
  $ wcel (cpr (cv x3) (cv y1)) cvv $;

--| Adjunction from singleton and binary union. (Contributed by BJ, 19-Jan-2025.) (Proof modification is discouraged.)
theorem bj_adjfrombun {x3 y1: setvar}:
  $ wcel (cun (cv x3) (csn (cv y1))) cvv $;

--| Membership in an intersection with a Cartesian product. (Contributed by Peter Mazsa, 9-Sep-2022.) Use the ` x R y ` idiom and give a shorter proof not depending on ~ df-rel . (Revised by BJ, 16-Oct-2026.) Note to remove when moving to main section: a shortening of the exact statement ~ elinxp is possible along the same line.
theorem bj_elinxp {x3 y1: setvar} (A2 B2 C R: class):
  $ wb (wcel C (cin R (cxp A2 B2))) (wrex x3 (wrex y1 (wa (wceq C (cop (cv x3) (cv y1))) (wbr (cv x3) (cv y1) R)) B2) A2) $;

--| Membership in a restriction. (Contributed by Scott Fenton, 17-Mar-2011.) (Proof shortened by Peter Mazsa, 9-Sep-2022.) Use the ` x B y ` idiom. (Revised by BJ, 16-Oct-2026.)
theorem bj_elres {x3 y1: setvar} (A2 B2 C: class):
  $ wb (wcel A2 (cres B2 C)) (wrex x3 (wex y1 (wa (wceq A2 (cop (cv x3) (cv y1))) (wbr (cv x3) (cv y1) B2))) C) $;

--| Alternate definition of the restriction of a class to another, as an ordered pair class abstraction: the restriction of a class to another is the class of ordered pairs whose first component is in the restricting class and whose components are related by the restricted class. (Contributed by Mario Carneiro, 5-Nov-2013.) Do not depend on ~ df-rel . (Revised by BJ, 16-Oct-2026.)
theorem bj_dfres2 {x3 y1: setvar} (A2 R: class):
  $ wceq (cres R A2) (copab x3 y1 (wa (wcel (cv x3) A2) (wbr (cv x3) (cv y1) R))) $;

--| The restriction of a class to a class is included in the Cartesian product of the restricting class with the universal class. (Contributed by BJ, 16-Oct-2026.)
theorem bj_resss2 (A2 R: class):
  $ wss (cres R A2) (cxp A2 cvv) $;

--| Two ways of expressing the "relation part" of a class: its restriction to the universal class (that is, its intersection with the Cartesian square of the universal class) equals the class of ordered pairs it contains (the class of ordered pairs whose components are related by it). The "relation part" of a class is a relation (see ~ df-rel and ~ relres ) and is the largest relation included in that class (that follows from ~ relssresv ). Taking the relation part of a class is a projection onto the collection of relations, that is, it is an idempotent operation ( ~ residm ) with image the collection of relations (by ~ relres for one inclusion and the forward implication of ~ dfrel3 for the other). As with any projection, a class is in its image if and only if its is a fixpoint of that projection (which is precisely ~ dfrel3 ). Other expressions giving the relation part of a class are ~ cnvcnv , ~ coi1res . (Contributed by BJ, 16-Oct-2026.)
theorem relpart {x3 y1: setvar} (A2: class):
  $ wceq (cres A2 cvv) (copab x3 y1 (wbr (cv x3) (cv y1) A2)) $;

--| Alternate definition of relation: a class is a relation if and only if it is equal to its "relation part" (see ~ relpart ). (Contributed by NM, 14-May-2008.) Do not depend on ~ df-cnv to move it earlier. (Revised by BJ, 16-Oct-2026.)
theorem bj_dfrel3 (R: class):
  $ wb (wrel R) (wceq (cres R cvv) R) $;

--| A relation is included in a class if and only if it is included in its "relation part" (see ~ relpart ). (Contributed by BJ, 16-Oct-2026.)
theorem relssresv (A2 B2: class):
  $ wi (wrel B2) (wb (wss B2 A2) (wss B2 (cres A2 cvv))) $;

--| A relation can be expressed as the set of ordered pairs in it. An analogue of ~ dffn5 for relations. (Contributed by Mario Carneiro, 16-Aug-2015.) Do not depend on ~ df-cnv , reverse equality. (Revised by BJ, 16-Oct-2026.) Note: this theorem could be used in place of ~ opabid2 , which could be deleted.
theorem bj_dfrel4v {x3 y1: setvar} (R: class):
  $ wb (wrel R) (wceq (copab x3 y1 (wbr (cv x3) (cv y1) R)) R) $;

--| Alternate definition of relation. Exercise 2 of [TakeutiZaring] p. 25. (Contributed by NM, 29-Dec-1996.) (Proof shortened by BJ, 16-Oct-2026.) Do not use ~ opabid2 . (Proof modification is discouraged.)
theorem bj_dfrel2 (R: class):
  $ wb (wrel R) (wceq (ccnv (ccnv R)) R) $;

--| The double converse of a class equals its restriction to the universe. (Contributed by NM, 8-Oct-2007.) Do not depend on ~ cnvcnv in order to prove it from ~ cnvcnv2 . (Revised by BJ, 16-Oct-2026.) Do not depend on ~ cnvcnv . (Proof modification is discouraged.)
theorem bj_cnvcnv2 (A2: class):
  $ wceq (ccnv (ccnv A2)) (cres A2 cvv) $;

--| The double converse of a class strips out all elements that are not ordered pairs. (Contributed by NM, 8-Dec-2003.) (Proof shortened by BJ, 26-Nov-2021.) (Proof shortened by BJ, 16-Oct-2026.) Prefer use of ~ bj-cnvcnv2 . (Proof modification is discouraged.)
theorem bj_cnvcnv (A2: class):
  $ wceq (ccnv (ccnv A2)) (cin A2 (cxp cvv cvv)) $;

--| Membership in a composition. (Contributed by BJ, 16-Aug-2026.)
theorem elco {x3 y1 z: setvar} (A2: class z) (B2 C: class):
  $ wb (wcel A2 (ccom C B2)) (wex x3 (wex y1 (wa (wceq A2 (cop (cv x3) (cv y1))) (wex z (wa (wbr (cv x3) (cv z) B2) (wbr (cv z) (cv y1) C)))))) $;

--| Precomposing with the identity is the same as taking the relation part of a class. (Contributed by BJ, 16-Aug-2026.)
theorem coi1res (A2: class):
  $ wceq (ccom A2 cid) (cres A2 cvv) $;

--| The identity relation is a right-unit for composition. Part of Theorem 3.7(i) of [Monk1] p. 36. (Contributed by NM, 22-Apr-2004.) Strengthen to biconditional form and shorten (Revised by BJ, 16-Oct-2026.)
theorem bj_coi1 (A2: class):
  $ wb (wrel A2) (wceq (ccom A2 cid) A2) $;

--| Alternate proof of ~ eleq2w2 and special instance of ~ eleq2 . (Contributed by BJ, 22-Sep-2024.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem eleq2w2ALT {x3: setvar} (A2 B2: class x3):
  $ wi (wceq A2 B2) (wb (wcel (cv x3) A2) (wcel (cv x3) B2)) $;

--| Alternate proof of ~ clel3g . (Contributed by BJ, 1-Sep-2024.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_clel3gALT {x3: setvar} (A2 B2: class) (V: class x3):
  $ wi (wcel B2 V) (wb (wcel A2 B2) (wex x3 (wa (wceq (cv x3) B2) (wcel A2 (cv x3))))) $;

--| Alternate proof of ~ pw0 . The proofs have a similar structure: ~ pw0 uses the definitions of powerclass and singleton as class abstractions, whereas ~ bj-pw0ALT uses characterizations of their elements. Both proofs then use transitivity of a congruence relation (equality for ~ pw0 and biconditional for ~ bj-pw0ALT ) to translate the property ~ ss0b into the wanted result. To translate a biconditional into a class equality, ~ pw0 uses ~ abbii (which yields an equality of class abstractions), while ~ bj-pw0ALT uses ~ eqriv (which requires a biconditional of membership of a given setvar variable). Theorem ~ abbii , through its closed form ~ abbi , is proved from ~ eqrdv , which is the deduction form of ~ eqriv . In the other direction, ~ velpw and ~ velsn are proved from the definitions of powerclass and singleton using ~ elabg , which is a version of ~ abbii suited for membership characterizations. (Contributed by BJ, 14-Apr-2024.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_pw0ALT:
  $ wceq (cpw c0) (csn c0) $;

--| Quantitative version of ~ ssexg : a subset of an element of a class is an element of the powerclass of the union of that class. (Contributed by BJ, 6-Apr-2024.)
theorem bj_sselpwuni (A2 B2 V: class):
  $ wi (wa (wss A2 B2) (wcel B2 V)) (wcel A2 (cpw (cuni V))) $;

--| Quantitative version of ~ uniexr : if the union of a class is an element of a class, then that class is an element of the double powerclass of the union of this class. (Contributed by BJ, 6-Apr-2024.)
theorem bj_unirel (A2 V: class):
  $ wi (wcel (cuni A2) V) (wcel A2 (cpw (cpw (cuni V)))) $;

--| If the intersection of two classes is a set, then inclusion among these classes is equivalent to membership in the powerclass. Common generalization of ~ elpwg and ~ elpw2g (the latter of which could be proved from it). (Contributed by BJ, 31-Dec-2023.)
theorem bj_elpwg (A2 B2 V: class):
  $ wi (wcel (cin A2 B2) V) (wb (wcel A2 (cpw B2)) (wss A2 B2)) $;

--| This theorem ~ bj-velpwALT and the next theorem ~ bj-elpwgALT are alternate proofs of ~ velpw and ~ elpwg respectively, where one proves first the setvar case and then generalizes using ~ vtoclbg instead of proving first the general case using ~ elab2g and then specifying. Here, this results in needing an extra DV condition, a longer combined proof and use of ~ ax-12 . In other cases, that order is better (e.g., ~ vsnex proved before ~ snexg ). (Contributed by BJ, 17-Jan-2025.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_velpwALT {x3: setvar} (A2: class):
  $ wb (wcel (cv x3) (cpw A2)) (wss (cv x3) A2) $;

--| Alternate proof of ~ elpwg . See comment for ~ bj-velpwALT . (Contributed by BJ, 17-Jan-2025.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_elpwgALT (A2 B2 V: class):
  $ wi (wcel A2 V) (wb (wcel A2 (cpw B2)) (wss A2 B2)) $;

--| Justification theorem for ~ dfv2 if it were the definition. See also ~ vjust . (Contributed by BJ, 30-Nov-2019.) (Proof modification is discouraged.)
theorem bj_vjust {x3 y1: setvar}:
  $ wceq (cab x3 wtru) (cab y1 wtru) $;

--| Two formulations of the axiom of the empty set ~ ax-nul . Proposal: place it right before ~ ax-nul . (Contributed by BJ, 30-Nov-2019.) (Proof modification is discouraged.)
theorem bj_nul {x3 y1: setvar}:
  $ wb (wcel c0 cvv) (wex x3 (wal y1 (wn (wcel (cv y1) (cv x3))))) $;

--| Definition of the empty set using the definite description binder. See also ~ bj-nuliotaALT . (Contributed by BJ, 30-Nov-2019.) (Proof modification is discouraged.)
theorem bj_nuliota {x3 y1: setvar}:
  $ wceq c0 (cio x3 (wal y1 (wn (wcel (cv y1) (cv x3))))) $;

--| Alternate proof of ~ bj-nuliota . This alternate proof uses the fact that ` iota x ph ` evaluates to ` (/) ` when there is no ` x ` satisfying ` ph ` ( ~ iotanul ). This is an implementation detail of the encoding currently used in set.mm and should be avoided. (Contributed by BJ, 30-Nov-2019.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_nuliotaALT {x3 y1: setvar}:
  $ wceq c0 (cio x3 (wal y1 (wn (wcel (cv y1) (cv x3))))) $;

--| Alternate proof of ~ vtoclgf . Proof from ~ vtoclgft . (This may have been the original proof before shortening.) (Contributed by BJ, 30-Sep-2019.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_vtoclgfALT {x3: setvar} (ph ps: wff x3) (A2 V: class x3):
  $ wnfc x3 A2 $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ ph $ >
  $ wi (wcel A2 V) ps $;

--| Join of ~ elsng and ~ elsn2g . (Contributed by BJ, 18-Nov-2023.)
theorem bj_elsn12g (A2 B2 V W: class):
  $ wi (wo (wcel A2 V) (wcel B2 W)) (wb (wcel A2 (csn B2)) (wceq A2 B2)) $;

--| Biconditional version of ~ elsng . (Contributed by BJ, 18-Nov-2023.)
theorem bj_elsnb (A2 B2: class):
  $ wb (wcel A2 (csn B2)) (wa (wcel A2 cvv) (wceq A2 B2)) $;

--| Remove hypothesis from ~ pwcfsdom . Illustration of how to remove a "proof-facilitating hypothesis". Shortens theorems using ~ pwcfsdom . (Contributed by BJ, 14-Sep-2019.)
theorem bj_pwcfsdom (A2: class):
  $ wbr (cfv A2 cale) (co (cfv A2 cale) (cfv (cfv A2 cale) ccf) cmap) csdm $;

--| Remove hypothesis from ~ grur1 . Illustration of how to remove a "definitional hypothesis". This makes its uses longer, but the theorem feels more self-contained. It looks preferable when the defined term appears only once in the conclusion. (Contributed by BJ, 14-Sep-2019.)
theorem bj_grur1 (U: class):
  $ wi (wa (wcel U cgru) (wcel U (cuni (cima cr1 con0)))) (wceq U (cfv (cin U con0) cr1)) $;

--| The extension of a predicate ( ` ph ( z ) ` ) is included in a set ( ` x ` ) if and only if it is a set ( ` y ` ). Sufficiency is obvious, and necessity is the content of the axiom of separation ~ ax-sep . Similar to Theorem 1.3(ii) of [BellMachover] p. 463. (Contributed by NM, 21-Jun-1993.) Generalized to a closed form biconditional with existential quantifications using two different setvars ` x , y ` (which need not be disjoint). (Revised by BJ, 8-Aug-2022.) TODO: move after ~ sepexi . Relabel ("sepbi"?).
theorem bj_bm1_3ii {x3 y1 z: setvar} (ph: wff z):
  $ wb (wex x3 (wal z (wi ph (wcel (cv z) (cv x3))))) (wex y1 (wal z (wb (wcel (cv z) (cv y1)) ph))) $;

--| Alternate version of ~ dfid2 . (Contributed by BJ, 9-Nov-2024.) (Proof modification is discouraged.) Use ~ df-id instead to make the semantics of the construction ~ df-opab clearer. (New usage is discouraged.)
theorem bj_dfid2ALT {x3: setvar}:
  $ wceq cid (copab x3 x3 wtru) $;

--| The empty set is not an element of an ordered-pair class abstraction. (Contributed by Alexander van der Vekens, 5-Nov-2017.) (Proof shortened by BJ, 22-Jul-2023.) TODO: move to the main section when one can reorder sections so that we can use ~ relopab (this is a very limited reordering).
theorem bj_0nelopab {x3 y1: setvar} (ph: wff x3 y1):
  $ wn (wcel c0 (copab x3 y1 ph)) $;

--| Two classes related by a binary relation are both sets. Alternate proof of ~ brrelex12 . (Contributed by BJ, 14-Jul-2023.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_brrelex12ALT (A2 B2 R: class):
  $ wi (wa (wrel R) (wbr A2 B2 R)) (wa (wcel A2 cvv) (wcel B2 cvv)) $;

--| The membership relation and the membership predicate agree when the "containing" class is a set. General version of ~ epel and closed form of ~ epeli . (Contributed by Scott Fenton, 27-Mar-2011.) (Revised by Mario Carneiro, 28-Apr-2015.) TODO: move it to the main section after reordering to have ~ brrelex1i available. (Proof shortened by BJ, 14-Jul-2023.) (Proof modification is discouraged.)
theorem bj_epelg (A2 B2 V: class):
  $ wi (wcel B2 V) (wb (wbr A2 B2 cep) (wcel A2 B2)) $;

--| Two classes are related by the membership relation if and only if they are related by the membership relation (i.e., the first is an element of the second) and the second is a set (hence so is the first). TODO: move to Main after reordering to have ~ brrelex2i available. Check if it is shorter to prove ~ bj-epelg first or ~ bj-epelb first. (Contributed by BJ, 14-Jul-2023.)
theorem bj_epelb (A2 B2: class):
  $ wb (wbr A2 B2 cep) (wa (wcel A2 B2) (wcel B2 cvv)) $;

--| A set does not contain the singleton formed on it. More precisely, one can prove that a class contains the singleton formed on it if and only if it is proper and contains the empty set (since it is "the singleton formed on" any proper class, see ~ snprc ): ` |- -. ( { A } e. A <-> ( (/) e. A -> A e. _V ) ) ` . (Contributed by BJ, 4-Feb-2023.)
theorem bj_nsnid (A2 V: class):
  $ wi (wcel A2 V) (wn (wcel (csn A2) A2)) $;

--| Alternate proof of ~ rdg0g . More direct since it bypasses ~ tz7.44-1 and ~ rdg0 (and ~ vtoclg , ~ vtoclga ). (Contributed by NM, 25-Apr-1995.) More direct proof. (Revised by BJ, 17-Nov-2024.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_rdg0gALT (A2 F V: class):
  $ wi (wcel A2 V) (wceq (cfv c0 (crdg F A2)) A2) $;

--| Alternate proof of ~ vn0 which does not use ~ eqabbw (and is shorter than ~ vn0 when ~ eqabbw is inlined). (Contributed by BJ, 12-Jul-2026.) Using the same dummy variable for ` y ` and ` z ` slightly reduces the proof size. (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_vn0ALT:
  $ wne cvv c0 $;

--| Over the base theory ~ ax-1 -- ~ ax-5 , the axiom of separation implies the weak emptyset axiom. By "weak emptyset axiom", we mean the axiom asserting existence of an empty set (which can be called "the" empty set when the axiom of extensionality ~ ax-ext is posited) provided existence of a set (the True truth constant existentially quantified over a fresh variable, ~ extru ). This is the conclusion of ~ bj-axnul . The weak emptyset axiom implies ` |- ( E. x T. -> E. y T. ) ` without DV conditions hence also the same statement as the weak emptyset axiom without DV conditions on ` x ` , but only on ` y , z ` . By "axiom of separation", we mean the universal closure of ~ ax-sep , simulated here by its instance with ` F. ` substituted for ` ph ` (and with the variable used to assert existence in the weak emptyset axiom substituted for the containing set) as the hypothesis of ~ bj-axnul . In particular, the axiom of existence ~ extru and the axiom of separation together imply the emptyset axiom (and conversely, the emptyset axiom implies the axiom of existence). Note: this theorem does not require a disjointness condition on ` y , z ` , although both axioms should be stated with all variables disjoint. This proof only uses an instance of the axiom of separation with a bounded formula, so is valid in a constructive setting (see the CZF section in the "Intuitionistic Logic Explorer" iset.mm). (Contributed by BJ, 8-Mar-2026.) (Proof modification is discouraged.)
theorem bj_axnul {x3 y1 z: setvar}:
  $ wal x3 (wex y1 (wal z (wb (wcel (cv z) (cv y1)) (wa (wcel (cv z) (cv x3)) wfal)))) $ >
  $ wi (wex x3 wtru) (wex y1 (wral z wfal (cv y1))) $;

--| Version of the axiom of replacement requiring the functional relation in the axiom to be a (total) function from ~ ax-rep (in the form of ~ axrep6 ). (Contributed by BJ, 14-Mar-2026.) The proof proves the statement without the DV condition on ` x , ph ` , but the DV condition is added to this statement to show that this weaker version is sufficient. (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_rep {x3 y1 z t: setvar} (ph: wff y1 z):
  $ wal x3 (wi (wral y1 (weu z ph) (cv x3)) (wex t (wal z (wb (wcel (cv z) (cv t)) (wrex y1 ph (cv x3)))))) $;

--| Axiom of separation (universal closure of ~ ax-sep ) from a weak form of the axiom of replacement requiring that the functional relation in it be a (total) function and the weak emptyset axiom (existence of an empty set provided existence of a set), as written in the theorem's hypotheses. This result shows that the weak emptyset axiom is not only the result of a cheap way to avoid an axiom redundancy (in this case, the existence axiom ~ extru ) by adding it as an antecedent, but also permits to prove nontrivial results that hold in nonnecessarily nonempty universes. This proof is by cases so is not intuitionistic. The statement does not require a nonempty universe; most of the proof does not either, and the parts that do (e.g., near ~ sb8ef and ~ sbequ12r and ~ eueq2 ) could be reworked to avoid it. Proof modifications should not introduce steps relying on a nonempty universe, like ~ alrimiv . (Contributed by BJ, 14-Mar-2026.) (Proof modification is discouraged.)
theorem bj_axseprep {x3 y1 z t a: setvar} (ph: wff z) (ps: wff x3 y1 z t a):
  $ wi (wex x3 wtru) (wex y1 (wral z wfal (cv y1))) $ >
  $ wal x3 (wi (wral z (weu t ps) (cv x3)) (wex y1 (wal t (wb (wcel (cv t) (cv y1)) (wrex z ps (cv x3)))))) $ >
  $ wb ps (wo (wa ph (wceq (cv t) (cv z))) (wa (wn ph) (wceq (cv t) (cv a)))) $ >
  $ wal x3 (wex y1 (wal z (wb (wcel (cv z) (cv y1)) (wa (wcel (cv z) (cv x3)) ph)))) $;

--| Strong axiom of replacement (universal closure of ~ ax-rep ) from the axioms of separation and replacement as written in the theorem's hypotheses. The statement does not require a nonempty universe; most of the proof does not either, except for the use of ~ 19.8a , which could be removed by reworking the proof, since it is applied in a subexpression bound by the variable it introduces. Proof modifications should not introduce steps relying on a nonempty universe, like ~ alrimiv . (Contributed by BJ, 14-Mar-2026.) (Proof modification is discouraged.)
theorem bj_axreprepsep {x3 y1 z t s1: setvar} (ph: wff z):
  $ wal x3 (wex s1 (wal y1 (wb (wcel (cv y1) (cv s1)) (wa (wcel (cv y1) (cv x3)) (wex z ph))))) $ >
  $ wal s1 (wi (wral y1 (weu z ph) (cv s1)) (wex t (wal z (wb (wcel (cv z) (cv t)) (wrex y1 ph (cv s1)))))) $ >
  $ wal x3 (wi (wral y1 (wmo z ph) (cv x3)) (wex t (wal z (wb (wcel (cv z) (cv t)) (wrex y1 ph (cv x3)))))) $;

--| Equality theorem for the ` Slot ` construction. This is currently a duplicate of ~ sloteq but may diverge from it if/when a token Eval is introduced for evaluation in order to separate it from Slot and any of its possible modifications. (Contributed by BJ, 27-Dec-2021.) (Proof modification is discouraged.)
theorem bj_evaleq (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (cslot A2) (cslot B2)) $;

--| The evaluation at a class is a function. (Contributed by BJ, 27-Dec-2021.)
theorem bj_evalfun (A2: class):
  $ wfun (cslot A2) $;

--| The evaluation at a class is a function on the universal class. (General form of ~ slotfn ). (Contributed by Mario Carneiro, 22-Sep-2015.) (Revised by BJ, 27-Dec-2021.)
theorem bj_evalfn (A2: class):
  $ wfn (cslot A2) cvv $;

--| The evaluation at a class is a function from the universal class into the universal class. (Contributed by BJ, 17-Mar-2026.)
theorem bj_evalf (A2: class):
  $ wf cvv cvv (cslot A2) $;

--| Value of the evaluation at a class. Closed form of ~ strfvnd and ~ strfvn . (Contributed by NM, 9-Sep-2011.) (Revised by Mario Carneiro, 15-Nov-2014.) (Revised by BJ, 27-Dec-2021.)
theorem bj_evalval (A2 F V: class):
  $ wi (wcel F V) (wceq (cfv F (cslot A2)) (cfv A2 F)) $;

--| The evaluation at a set of the identity function is that set. General form of ~ ndxarg . The restriction to a set ` V ` is necessary since the argument of the function ` Slot A ` (like that of any function) has to be a set for the evaluation to be meaningful. (Contributed by BJ, 27-Dec-2021.)
theorem bj_evalid (A2 V W: class):
  $ wi (wa (wcel V W) (wcel A2 V)) (wceq (cfv (cres cid V) (cslot A2)) A2) $;

--| Proof of ~ ndxarg from ~ bj-evalid . (Contributed by BJ, 27-Dec-2021.) (Proof modification is discouraged.)
theorem bj_ndxarg (E N: class):
  $ wceq E (cslot N) $ >
  $ wcel N cn $ >
  $ wceq (cfv cnx E) N $;

--| Closed general form of ~ strndxid . Both sides are equal to ` ( F `` A ) ` by ~ bj-evalid and ~ bj-evalval respectively, but ~ bj-evalidval adds something to ~ bj-evalid and ~ bj-evalval in that ` Slot A ` appears on both sides. (Contributed by BJ, 27-Dec-2021.)
theorem bj_evalidval (A2 U F V W: class):
  $ wi (w3a (wcel V W) (wcel A2 V) (wcel F U)) (wceq (cfv (cfv (cres cid V) (cslot A2)) F) (cfv F (cslot A2))) $;

--| Syntax for elementwise operations.
term celwise: class;

--| Define the elementwise operation associated with a given operation. For instance, ` + ` is the addition of complex numbers ( ~ axaddf ), so if ` A ` and ` B ` are sets of complex numbers, then ` ( A ( elwise `` + ) B ) ` is the set of numbers of the form ` ( x + y ) ` with ` x e. A ` and ` y e. B ` . The set of odd natural numbers is ` ( ( { 2 } ( elwise `` x. ) NN0 ) ( elwise `` + ) { 1 } ) ` , or less formally ` 2 NN0 + 1 ` . (Contributed by BJ, 22-Dec-2021.)
axiom df_elwise {x3 y1 z v u o: setvar}:
  $ wceq celwise (cmpt o cvv (cmpo x3 y1 cvv cvv (cab z (wrex u (wrex v (wceq (cv z) (co (cv u) (cv v) (cv o))) (cv y1)) (cv x3))))) $;

--| An elementwise intersection on the empty family is the empty set. TODO: this is ~ 0rest . (Contributed by BJ, 27-Apr-2021.)
theorem bj_rest00 (A2: class):
  $ wceq (co c0 A2 crest) c0 $;

--| An elementwise intersection on the singleton on a set is the singleton on the intersection by that set. Generalization of ~ bj-restsn0 and ~ bj-restsnid . (Contributed by BJ, 27-Apr-2021.)
theorem bj_restsn (A2 V W Y: class):
  $ wi (wa (wcel Y V) (wcel A2 W)) (wceq (co (csn Y) A2 crest) (csn (cin Y A2))) $;

--| Special case of ~ bj-restsn . (Contributed by BJ, 27-Apr-2021.)
theorem bj_restsnss (A2 V Y: class):
  $ wi (wa (wcel Y V) (wss A2 Y)) (wceq (co (csn Y) A2 crest) (csn A2)) $;

--| Special case of ~ bj-restsn . (Contributed by BJ, 27-Apr-2021.)
theorem bj_restsnss2 (A2 V Y: class):
  $ wi (wa (wcel A2 V) (wss Y A2)) (wceq (co (csn Y) A2 crest) (csn Y)) $;

--| An elementwise intersection on the singleton on the empty set is the singleton on the empty set. Special case of ~ bj-restsn and ~ bj-restsnss2 . TODO: this is ~ restsn . (Contributed by BJ, 27-Apr-2021.)
theorem bj_restsn0 (A2 V: class):
  $ wi (wcel A2 V) (wceq (co (csn c0) A2 crest) (csn c0)) $;

--| Special case of ~ bj-restsn , ~ bj-restsnss , and ~ bj-rest10 . (Contributed by BJ, 27-Apr-2021.)
theorem bj_restsn10 (V X: class):
  $ wi (wcel X V) (wceq (co (csn X) c0 crest) (csn c0)) $;

--| The elementwise intersection on the singleton on a class by that class is the singleton on that class. Special case of ~ bj-restsn and ~ bj-restsnss . (Contributed by BJ, 27-Apr-2021.)
theorem bj_restsnid (A2: class):
  $ wceq (co (csn A2) A2 crest) (csn A2) $;

--| An elementwise intersection on a nonempty family by the empty set is the singleton on the empty set. TODO: this generalizes ~ rest0 and could replace it. (Contributed by BJ, 27-Apr-2021.)
theorem bj_rest10 (V X: class):
  $ wi (wcel X V) (wi (wne X c0) (wceq (co X c0 crest) (csn c0))) $;

--| Alternate version of ~ bj-rest10 . (Contributed by BJ, 27-Apr-2021.)
theorem bj_rest10b (V X: class):
  $ wi (wcel X (cdif V (csn c0))) (wceq (co X c0 crest) (csn c0)) $;

--| An elementwise intersection on a nonempty family is nonempty. (Contributed by BJ, 27-Apr-2021.)
theorem bj_restn0 (A2 V W X: class):
  $ wi (wa (wcel X V) (wcel A2 W)) (wi (wne X c0) (wne (co X A2 crest) c0)) $;

--| Alternate version of ~ bj-restn0 . (Contributed by BJ, 27-Apr-2021.)
theorem bj_restn0b (A2 V W X: class):
  $ wi (wa (wcel X (cdif V (csn c0))) (wcel A2 W)) (wne (co X A2 crest) c0) $;

--| The elementwise intersection on a powerset is the powerset of the intersection. This allows to prove for instance that the topology induced on a subset by the discrete topology is the discrete topology on that subset. See also ~ restdis (which uses ~ distop and ~ restopn2 ). (Contributed by BJ, 27-Apr-2021.)
theorem bj_restpw (A2 V W Y: class):
  $ wi (wa (wcel Y V) (wcel A2 W)) (wceq (co (cpw Y) A2 crest) (cpw (cin Y A2))) $;

--| An elementwise intersection on a family containing the empty set contains the empty set. (Contributed by BJ, 27-Apr-2021.)
theorem bj_rest0 (A2 V W X: class):
  $ wi (wa (wcel X V) (wcel A2 W)) (wi (wcel c0 X) (wcel c0 (co X A2 crest))) $;

--| An elementwise intersection by a set on a family containing a superset of that set contains that set. (Contributed by BJ, 27-Apr-2021.)
theorem bj_restb (A2 B2 V X: class):
  $ wi (wcel X V) (wi (wa (wss A2 B2) (wcel B2 X)) (wcel A2 (co X A2 crest))) $;

--| An elementwise intersection by a subset on a family containing the whole set contains the whole subset. (Contributed by BJ, 27-Apr-2021.)
theorem bj_restv (A2 X: class):
  $ wi (wa (wss A2 (cuni X)) (wcel (cuni X) X)) (wcel A2 (co X A2 crest)) $;

--| An elementwise intersection by a set on a family containing that set contains that set. (Contributed by BJ, 27-Apr-2021.)
theorem bj_resta (A2 V X: class):
  $ wi (wcel X V) (wi (wcel A2 X) (wcel A2 (co X A2 crest))) $;

--| The union of an elementwise intersection by a set is equal to the intersection with that set of the union of the family. See also ~ restuni and ~ restuni2 . (Contributed by BJ, 27-Apr-2021.)
theorem bj_restuni (A2 V W X: class):
  $ wi (wa (wcel X V) (wcel A2 W)) (wceq (cuni (co X A2 crest)) (cin (cuni X) A2)) $;

--| The union of an elementwise intersection on a family of sets by a subset is equal to that subset. See also ~ restuni and ~ restuni2 . (Contributed by BJ, 27-Apr-2021.)
theorem bj_restuni2 (A2 V X: class):
  $ wi (wa (wcel X V) (wss A2 (cuni X))) (wceq (cuni (co X A2 crest)) A2) $;

--| A reformulation of the axiom of regularity using elementwise intersection. (RK: might have to be placed later since theorems in this section are to be moved early (in the section related to the algebra of sets).) (Contributed by BJ, 27-Apr-2021.)
theorem bj_restreg (A2 V: class):
  $ wi (wa (wcel A2 V) (wne A2 c0)) (wcel c0 (co A2 A2 crest)) $;

--| All elements of a set satisfy a given property if and only if all but one satisfy that property and that one also does. Typically, this can be used for characterizations that are proved using different methods for a given element and for all others, for instance zero and nonzero numbers, or the empty set and nonempty sets. (Contributed by BJ, 7-Dec-2021.)
theorem bj_raldifsn {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wceq (cv x3) B2) (wb ph ps) $ >
  $ wi (wcel B2 A2) (wb (wral x3 ph A2) (wa (wral x3 ph (cdif A2 (csn B2))) ps)) $;

--| If ` A ` is a collection of subsets of ` X ` , like a Moore collection or a topology, two equivalent ways to say that arbitrary intersections of elements of ` A ` relative to ` X ` belong to some class ` B ` : the LHS singles out the empty intersection (the empty intersection relative to ` X ` is ` X ` and the intersection of a nonempty family of subsets of ` X ` is included in ` X ` , so there is no need to intersect it with ` X ` ). In typical applications, ` B ` is ` A ` itself. (Contributed by BJ, 7-Dec-2021.)
theorem bj_0int {x3: setvar} (A2 B2 X: class):
  $ wi (wss A2 (cpw X)) (wb (wa (wcel X B2) (wral x3 (wcel (cint (cv x3)) B2) (cdif (cpw A2) (csn c0)))) (wral x3 (wcel (cin X (cint (cv x3))) B2) (cpw A2))) $;

--| A Moore collection is a set. Therefore, the class ` Moore_ ` of all Moore sets defined in ~ df-bj-moore is actually the class of all Moore collections. This is also illustrated by the lack of sethood condition in ~ bj-ismoore . The closed sets of a topology form a Moore collection, so a topology is a set, and this remark also applies to many other families of sets (namely, as soon as the whole set is required to be a set of the family, then the associated kind of family has no proper classes: that this condition suffices to impose sethood can be seen in this proof, which relies crucially on ~ uniexr ). Note: if, in the above predicate, we substitute ` ~P X ` for ` A ` , then the last ` e. ~P X ` could be weakened to ` C_ X ` , and then the predicate would be obviously satisfied since ` |- U. ~P X = X ` ( ~ unipw ), making ` ~P X ` a Moore collection in this weaker sense, for any class ` X ` , even proper, but the addition of this single case does not add anything interesting. Instead, we have the biconditional ~ bj-discrmoore . (Contributed by BJ, 8-Dec-2021.)
theorem bj_mooreset {x3: setvar} (A2: class):
  $ wi (wral x3 (wcel (cin (cuni A2) (cint (cv x3))) A2) (cpw A2)) (wcel A2 cvv) $;

--| Syntax for the class of Moore collections.
term cmoore: class;

--| Define the class of Moore collections. This is indeed the class of all Moore collections since these all are sets, as proved in ~ bj-mooreset , and as illustrated by the lack of sethood condition in ~ bj-ismoore . This is to ~ df-mre (defining ` Moore ` ) what ~ df-top (defining ` Top ` ) is to ~ df-topon (defining ` TopOn ` ). For the sake of consistency, the function defined at ~ df-mre should be denoted by "MooreOn". Note: ~ df-mre singles out the empty intersection. This is not necessary. It could be written instead ` |- Moore = ` ` ( x e. _V |-> { y e. ~P ~P x | A. z e. ~P y ( x i^i |^| z ) e. y } ) ` and the equivalence of both definitions is proved by ~ bj-0int . There is no added generality in defining a "Moore predicate" for arbitrary classes, since a Moore class satisfying such a predicate is automatically a set (see ~ bj-mooreset ). TODO: move to the main section. For many families of sets, one can define both the function associating to each set the set of families of that kind on it (like ~ df-mre and ~ df-topon ) or the class of all families of that kind, independent of a base set (like ~ df-bj-moore or ~ df-top ). In general, the former will be more useful and the extra generality of the latter is not necessary. Moore collections, however, are particular in that they are more ubiquitous and are used in a wide variety of applications (for many families of sets, the family of families of a given kind is often a Moore collection, for instance). Therefore, in the case of Moore families, having both definitions is useful. (Contributed by BJ, 27-Apr-2021.)
axiom df_bj_moore {x3 y1: setvar}:
  $ wceq cmoore (cab x3 (wral y1 (wcel (cin (cuni (cv x3)) (cint (cv y1))) (cv x3)) (cpw (cv x3)))) $;

--| Characterization of Moore collections. There is no sethood hypothesis on ` A ` : it is implied by either side (this is obvious for the LHS, and is the content of ~ bj-mooreset for the RHS). (Contributed by BJ, 9-Dec-2021.)
theorem bj_ismoore {x3: setvar} (A2: class):
  $ wb (wcel A2 cmoore) (wral x3 (wcel (cin (cuni A2) (cint (cv x3))) A2) (cpw A2)) $;

--| Necessary condition to be a Moore collection. (Contributed by BJ, 9-Dec-2021.)
theorem bj_ismoored0 (A2: class):
  $ wi (wcel A2 cmoore) (wcel (cuni A2) A2) $;

--| Necessary condition to be a Moore collection. (Contributed by BJ, 9-Dec-2021.)
theorem bj_ismoored (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cmoore) $ >
  $ wi ph (wss B2 A2) $ >
  $ wi ph (wcel (cin (cuni A2) (cint B2)) A2) $;

--| Necessary condition to be a Moore collection. (Contributed by BJ, 9-Dec-2021.)
theorem bj_ismoored2 (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cmoore) $ >
  $ wi ph (wss B2 A2) $ >
  $ wi ph (wne B2 c0) $ >
  $ wi ph (wcel (cint B2) A2) $;

--| Sufficient condition to be a Moore collection. There is no sethood hypothesis on ` A ` : it is a consequence of the only hypothesis. (Contributed by BJ, 9-Dec-2021.)
theorem bj_ismooredr {x3: setvar} (ph: wff) (A2: class):
  $ wi (wa ph (wss (cv x3) A2)) (wcel (cin (cuni A2) (cint (cv x3))) A2) $ >
  $ wi ph (wcel A2 cmoore) $;

--| Sufficient condition to be a Moore collection (variant of ~ bj-ismooredr singling out the empty intersection). There is no sethood hypothesis on ` A ` : it is a consequence of the first hypothesis. (Contributed by BJ, 9-Dec-2021.)
theorem bj_ismooredr2 {x3: setvar} (ph: wff) (A2: class):
  $ wi ph (wcel (cuni A2) A2) $ >
  $ wi (wa ph (wa (wss (cv x3) A2) (wne (cv x3) c0))) (wcel (cint (cv x3)) A2) $ >
  $ wi ph (wcel A2 cmoore) $;

--| The powerclass ` ~P A ` is a Moore collection if and only if ` A ` is a set. It is then called the discrete Moore collection. (Contributed by BJ, 9-Dec-2021.)
theorem bj_discrmoore (A2: class):
  $ wb (wcel A2 cvv) (wcel (cpw A2) cmoore) $;

--| The empty set is not a Moore collection. (Contributed by BJ, 9-Dec-2021.)
theorem bj_0nmoore:
  $ wn (wcel c0 cmoore) $;

--| A singleton is a Moore collection. See ~ bj-snmooreb for a biconditional version. (Contributed by BJ, 10-Apr-2024.)
theorem bj_snmoore (A2 V: class):
  $ wi (wcel A2 V) (wcel (csn A2) cmoore) $;

--| A singleton is a Moore collection, biconditional version of ~ bj-snmoore . (Contributed by BJ, 9-Dec-2021.) (Proof shortened by BJ, 10-Apr-2024.)
theorem bj_snmooreb (A2: class):
  $ wb (wcel A2 cvv) (wcel (csn A2) cmoore) $;

--| A pair formed of two nested sets is a Moore collection. (If in the statement ` B ` is a proper class, then the result follows from ~ bj-snmoore ). A direct consequence is ~ bj-pr0moore . More generally, any nonempty well-ordered chain of sets that is a set is a Moore collection. We also have the biconditional ` |- ( ( A i^i B ) e. V -> ` ` ( { A , B } e. Moore_ <-> ( A C_ B \/ B C_ A ) ) ) ` . (Contributed by BJ, 11-Apr-2024.)
theorem bj_prmoore (A2 B2 V: class):
  $ wi (wa (wcel A2 V) (wss A2 B2)) (wcel (cpr A2 B2) cmoore) $;

--| A pair containing the empty set is a Moore collection. (Contributed by BJ, 4-Oct-2026.)
theorem bj_pr0moore (A2: class):
  $ wcel (cpr c0 A2) cmoore $;

--| The empty set is not an element of a function (given in maps-to notation). (Contributed by BJ, 30-Dec-2020.)
theorem bj_0nelmpt {x3: setvar} (A2 B2: class x3):
  $ wn (wcel c0 (cmpt x3 A2 B2)) $;

--| Value of a function given in maps-to notation. (Contributed by BJ, 30-Dec-2020.)
theorem bj_mptval {x3: setvar} (A2 B2 V X Y: class x3):
  $ wnfc x3 A2 $ >
  $ wi (wral x3 (wcel B2 V) A2) (wi (wcel X A2) (wb (wceq (cfv X (cmpt x3 A2 B2)) Y) (wbr X Y (cmpt x3 A2 B2)))) $;

--| An equivalent definition of ~ df-mpo . (Contributed by BJ, 30-Dec-2020.)
theorem bj_dfmpoa {x3 y1 t s1: setvar} (A2: class x3) (B2 C: class x3 y1):
  $ wceq (cmpo x3 y1 A2 B2 C) (copab s1 t (wrex x3 (wrex y1 (wa (wceq (cv s1) (cop (cv x3) (cv y1))) (wceq (cv t) C)) B2) A2)) $;

--| Alternate proof of ~ mpompt . (Contributed by BJ, 30-Dec-2020.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_mpomptALT {x3 y1 z: setvar} (A2 B2: class) (C: class z) (D: class x3 y1):
  $ wi (wceq (cv z) (cop (cv x3) (cv y1))) (wceq C D) $ >
  $ wceq (cmpt z (cxp A2 B2) C) (cmpo x3 y1 A2 B2 D) $;

--| Syntax for the set of set morphisms.
term csethom: class;

--| Define the set of functions (morphisms of sets) between two sets. Same as ~ df-map with arguments swapped. TODO: prove the same staple lemmas as for ` ^m ` . Remark: one may define ` -Set-> = ( x e. dom Struct , y e. dom Struct |-> ` ` { f | f : ( Base `` x ) --> ( Base `` y ) } ) ` so that for morphisms between other structures, one could write ` ... = { f e. ( x -Set-> y ) | ... } ` . (Contributed by BJ, 11-Apr-2020.)
axiom df_bj_sethom {x3 y1 f2: setvar}:
  $ wceq csethom (cmpo x3 y1 cvv cvv (cab f2 (wf (cv x3) (cv y1) (cv f2)))) $;

--| Syntax for the set of topological morphisms.
term ctophom: class;

--| Define the set of continuous functions (morphisms of topological spaces) between two topological spaces. Similar to ~ df-cn (which is in terms of topologies instead of topological spaces). (Contributed by BJ, 10-Feb-2022.)
axiom df_bj_tophom {x3 y1 u f2: setvar}:
  $ wceq ctophom (cmpo x3 y1 ctps ctps (crab f2 (wral u (wcel (cima (ccnv (cv f2)) (cv u)) (cfv (cv x3) ctopn)) (cfv (cv y1) ctopn)) (co (cfv (cv x3) cbs) (cfv (cv y1) cbs) csethom))) $;

--| Syntax for the set of magma morphisms.
term cmgmhom: class;

--| Define the set of magma morphisms between two magmas. If domain and codomain are semigroups, monoids, or groups, then one obtains the set of morphisms of these structures. (Contributed by BJ, 10-Feb-2022.)
axiom df_bj_mgmhom {x3 y1 v u f2: setvar}:
  $ wceq cmgmhom (cmpo x3 y1 cmgm cmgm (crab f2 (wral u (wral v (wceq (cfv (co (cv u) (cv v) (cfv (cv x3) cplusg)) (cv f2)) (co (cfv (cv u) (cv f2)) (cfv (cv v) (cv f2)) (cfv (cv y1) cplusg))) (cfv (cv x3) cbs)) (cfv (cv x3) cbs)) (co (cfv (cv x3) cbs) (cfv (cv y1) cbs) csethom))) $;

--| Syntax for the set of topological magma morphisms.
term ctopmgmhom: class;

--| Define the set of topological magma morphisms (continuous magma morphisms) between two topological magmas. If domain and codomain are topological semigroups, monoids, or groups, then one obtains the set of morphisms of these structures. This definition is currently stated with topological monoid domain and codomain, since topological magmas are currently not defined in set.mm. (Contributed by BJ, 10-Feb-2022.)
axiom df_bj_topmgmhom {x3 y1: setvar}:
  $ wceq ctopmgmhom (cmpo x3 y1 ctmd ctmd (cin (co (cv x3) (cv y1) ctophom) (co (cv x3) (cv y1) cmgmhom))) $;

--| Syntax for the parameterized currying function.
term ccur_: class;

--| Define currying. See also ~ df-cur . (Contributed by BJ, 11-Apr-2020.)
axiom df_bj_cur {x3 y1 z f2 a b: setvar}:
  $ wceq ccur_ (cmpt3 x3 y1 z cvv cvv cvv (cmpt f2 (co (cxp (cv x3) (cv y1)) (cv z) csethom) (cmpt a (cv x3) (cmpt b (cv y1) (cfv (cop (cv a) (cv b)) (cv f2)))))) $;

--| Notation for the parameterized uncurrying function.
term cunc_: class;

--| Define uncurrying. See also ~ df-unc . (Contributed by BJ, 11-Apr-2020.)
axiom df_bj_unc {x3 y1 z f2 a b: setvar}:
  $ wceq cunc_ (cmpt3 x3 y1 z cvv cvv cvv (cmpt f2 (co (cv x3) (co (cv y1) (cv z) csethom) csethom) (cmpo a b (cv x3) (cv y1) (cfv (cv b) (cfv (cv a) (cv f2)))))) $;

--| Syntax for component-setting in extensible structures.
term cstrset (A2 B2 S: class): class;

--| Component-setting in extensible structures. Define the extensible structure ` [s B / A ]s S ` , which is like the extensible structure ` S ` except that the value ` B ` has been put in the slot ` A ` (replacing the current value if there was already one). In such expressions, ` A ` is generally substituted for slot mnemonics like ` Base ` or ` +g ` or ` dist ` . The ` _V ` in this definition was chosen to be closer to ~ df-sets , but since extensible structures are functions on ` NN ` , it will be more natural to replace it with ` NN ` when ~ df-strset becomes the main definition. (Contributed by BJ, 13-Feb-2022.)
axiom df_strset (A2 B2 S: class):
  $ wceq (cstrset A2 B2 S) (cun (cres S (cdif cvv (csn (cfv cnx A2)))) (csn (cop (cfv cnx A2) B2))) $;

--| Relation between ~ df-sets and ~ df-strset . Temporary theorem kept during the transition from the former to the latter. (Contributed by BJ, 13-Feb-2022.)
theorem setsstrset (A2 B2 S V W: class):
  $ wi (wa (wcel S V) (wcel B2 W)) (wceq (cstrset A2 B2 S) (co S (cop (cfv cnx A2) B2) csts)) $;

--| Variant of ~ nfald . (Contributed by BJ, 25-Dec-2023.)
theorem bj_nfald {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi ph (wal y1 ph) $ >
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnf x3 (wal y1 ps)) $;

--| Variant of ~ nfexd . (Contributed by BJ, 25-Dec-2023.)
theorem bj_nfexd {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi ph (wal y1 ph) $ >
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnf x3 (wex y1 ps)) $;

--| Implicit substitution inference for general classes. (Contributed by NM, 26-Jul-1995.) Adapt ~ cgsex2g to deduction form. (Revised by BJ, 28-Mar-2026.) Do not use ~ cgsex2g . (Proof modification is discouraged.)
theorem cgsex2gd {x3 y1: setvar} (ph: wff) (ps ch: wff x3 y1) (th: wff) (A2 B2: class) (V W: class x3 y1):
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) ps $ >
  $ wi (wa ph ps) (wb ch th) $ >
  $ wi (wa ph (wa (wcel A2 V) (wcel B2 W))) (wb (wex x3 (wex y1 (wa ps ch))) th) $;

--| Implicit substitution inference for ordered pairs. (Contributed by NM, 28-May-1995.) Use a similar proof to ~ copsex4g to reduce axiom usage. (Revised by SN, 1-Sep-2024.) Adapt ~ copsex2g to deduction form. (Revised by BJ, 28-Mar-2026.) Do not use ~ copsex2g . (Proof modification is discouraged.)
theorem copsex2gd {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (ch: wff) (A2 B2: class) (V W: class x3 y1):
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wb ps ch) $ >
  $ wi (wa ph (wa (wcel A2 V) (wcel B2 W))) (wb (wex x3 (wex y1 (wa (wceq (cop A2 B2) (cop (cv x3) (cv y1))) ps))) ch) $;

--| Implicit substitution deduction for ordered pairs. (Contributed by BJ, 25-Dec-2023.)
theorem copsex2d {x3 y1: setvar} (ph ps ch: wff x3 y1) (A2 B2: class) (U V: class x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wal y1 ph) $ >
  $ wi ph (wnf x3 ch) $ >
  $ wi ph (wnf y1 ch) $ >
  $ wi ph (wcel A2 U) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wb ps ch) $ >
  $ wi ph (wb (wex x3 (wex y1 (wa (wceq (cop A2 B2) (cop (cv x3) (cv y1))) ps))) ch) $;

--| Biconditional form of ~ copsex2d . TODO: prove a relative version, that is, with ` E. x e. V E. y e. W ... ( A e. V /\ B e. W ) ` . (Contributed by BJ, 27-Dec-2023.)
theorem copsex2b {x3 y1: setvar} (ph ps ch: wff x3 y1) (A2 B2: class):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wal y1 ph) $ >
  $ wi ph (wnf x3 ch) $ >
  $ wi ph (wnf y1 ch) $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wb ps ch) $ >
  $ wi ph (wb (wex x3 (wex y1 (wa (wceq (cop A2 B2) (cop (cv x3) (cv y1))) ps))) (wa (wa (wcel A2 cvv) (wcel B2 cvv)) ch)) $;

--| Membership of an ordered pair in a class abstraction of ordered pairs. (Contributed by BJ, 17-Dec-2023.)
theorem opelopabd {x3 y1: setvar} (ph ps ch: wff x3 y1) (A2 B2: class) (U V: class x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wal y1 ph) $ >
  $ wi ph (wnf x3 ch) $ >
  $ wi ph (wnf y1 ch) $ >
  $ wi ph (wcel A2 U) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wb ps ch) $ >
  $ wi ph (wb (wcel (cop A2 B2) (copab x3 y1 ps)) ch) $;

--| Membership of an ordered pair in a class abstraction of ordered pairs, biconditional form. (Contributed by BJ, 17-Dec-2023.)
theorem opelopabb {x3 y1: setvar} (ph ps ch: wff x3 y1) (A2 B2: class):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wal y1 ph) $ >
  $ wi ph (wnf x3 ch) $ >
  $ wi ph (wnf y1 ch) $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wb ps ch) $ >
  $ wi ph (wb (wcel (cop A2 B2) (copab x3 y1 ps)) (wa (wa (wcel A2 cvv) (wcel B2 cvv)) ch)) $;

--| Membership of an ordered pair in a class abstraction of ordered pairs, biconditional form. (Contributed by BJ, 17-Dec-2023.)
theorem opelopabbv {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (ch: wff) (A2 B2: class) (R: class x3 y1):
  $ wi ph (wceq R (copab x3 y1 ps)) $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wb ps ch) $ >
  $ wi ph (wb (wcel (cop A2 B2) R) (wa (wa (wcel A2 cvv) (wcel B2 cvv)) ch)) $;

--| The coordinates of an ordered pair that belongs to a relation are sets. TODO: Slightly shorter than ~ brrelex12 , which could be proved from it. The first antecedent would not be needed if using ~ df-bj-2upl , by ~ bj-2uplex . (Contributed by BJ, 27-Dec-2023.)
theorem bj_opelrelex (A2 B2 R: class):
  $ wi (wa (wrel R) (wcel (cop A2 B2) R)) (wa (wcel A2 cvv) (wcel B2 cvv)) $;

--| If an ordered pair is in a restricted binary relation, then its first component is an element of the restricting class. See also ~ opelres . (Contributed by BJ, 25-Dec-2023.)
theorem bj_opelresdm (A2 B2 R X: class):
  $ wi (wcel (cop A2 B2) (cres R X)) (wcel A2 X) $;

--| If two classes are related by a restricted binary relation, then the first class is an element of the restricting class. See also ~ brres and ~ brrelex1 . Remark: there are many pairs like ~ bj-opelresdm / ~ bj-brresdm , where one uses membership of ordered pairs and the other, related classes (for instance, ~ bj-opelresdm / ~ brrelex12 or the ~ opelopabg / ~ brabg family). They are straightforwardly equivalent by ~ df-br . The latter is indeed a very direct definition, introducing a "shorthand", and barely necessary, were it not for the frequency of the expression ` A R B ` . Therefore, in the spirit of "definitions are here to be used", most theorems, apart from the most elementary ones, should only have the "br" version, not the "opel" one. (Contributed by BJ, 25-Dec-2023.)
theorem bj_brresdm (A2 B2 R X: class):
  $ wi (wbr A2 B2 (cres R X)) (wcel A2 X) $;

--| Expressing that two sets are related by a binary relation which is expressed as a class abstraction of ordered pairs. (Contributed by BJ, 17-Dec-2023.)
theorem brabd0 {x3 y1: setvar} (ph ps ch: wff x3 y1) (A2 B2: class) (R U V: class x3 y1):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wal y1 ph) $ >
  $ wi ph (wnf x3 ch) $ >
  $ wi ph (wnf y1 ch) $ >
  $ wi ph (wcel A2 U) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wceq R (copab x3 y1 ps)) $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wb ps ch) $ >
  $ wi ph (wb (wbr A2 B2 R) ch) $;

--| Expressing that two sets are related by a binary relation which is expressed as a class abstraction of ordered pairs. (Contributed by BJ, 17-Dec-2023.)
theorem brabd {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (ch: wff) (A2 B2: class) (R U V: class x3 y1):
  $ wi ph (wcel A2 U) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wceq R (copab x3 y1 ps)) $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wb ps ch) $ >
  $ wi ph (wb (wbr A2 B2 R) ch) $;

--| "Unbounded" version of ~ brab2a . (Contributed by BJ, 25-Dec-2023.)
theorem bj_brab2a1 {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2 B2: class) (R: class x3 y1):
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ wceq R (copab x3 y1 ph) $ >
  $ wb (wbr A2 B2 R) (wa (wa (wcel A2 cvv) (wcel B2 cvv)) ps) $;

--| A variant of ~ relopabiv (which could be proved from it, similarly to ~ relxp from ~ xpss ). (Contributed by BJ, 28-Dec-2023.)
theorem bj_opabssvv {x3 y1: setvar} (ph: wff x3 y1):
  $ wss (copab x3 y1 ph) (cxp cvv cvv) $;

--| The restricted identity relation is a function. (Contributed by BJ, 27-Dec-2023.) TODO: relabel ~ funi to funid.
theorem bj_funidres (V: class):
  $ wfun (cres cid V) $;

--| Characterization of the ordered pair elements of the identity relation. Remark: in deduction-style proofs, one could save a few syntactic steps by using another antecedent than ` T. ` which already appears in the proof. Here for instance this could be the definition ` _I = { <. x , y >. | x = y } ` but this would make the proof less easy to read. (Contributed by BJ, 27-Dec-2023.)
theorem bj_opelidb (A2 B2: class):
  $ wb (wcel (cop A2 B2) cid) (wa (wa (wcel A2 cvv) (wcel B2 cvv)) (wceq A2 B2)) $;

--| Characterization of the ordered pair elements of the identity relation. Variant of ~ bj-opelidb where only the sethood of the first component is expressed. (Contributed by BJ, 27-Dec-2023.)
theorem bj_opelidb1 (A2 B2: class):
  $ wb (wcel (cop A2 B2) cid) (wa (wcel A2 cvv) (wceq A2 B2)) $;

--| Lemma for ~ bj-opelid (but not specific to the identity relation): if the intersection of two classes is a set and the two classes are equal, then both are sets (all three classes are equal, so they all belong to ` V ` , but it is more convenient to have ` _V ` in the consequent for theorems using it). (Contributed by BJ, 27-Dec-2023.)
theorem bj_inexeqex (A2 B2 V: class):
  $ wi (wa (wcel (cin A2 B2) V) (wceq A2 B2)) (wa (wcel A2 cvv) (wcel B2 cvv)) $;

--| If the intersection of two classes is a set, then these classes are equal if and only if one is an element of the singleton formed on the other. Stronger form of ~ elsng and ~ elsn2g (which could be proved from it). (Contributed by BJ, 20-Jan-2024.)
theorem bj_elsn0 (A2 B2 V: class):
  $ wi (wcel (cin A2 B2) V) (wb (wcel A2 (csn B2)) (wceq A2 B2)) $;

--| Characterization of the ordered pair elements of the identity relation when the intersection of their components are sets. The antecedent is more general than either component being a set. (Contributed by BJ, 29-Mar-2020.)
theorem bj_opelid (A2 B2 V: class):
  $ wi (wcel (cin A2 B2) V) (wb (wcel (cop A2 B2) cid) (wceq A2 B2)) $;

--| Characterization of the classes related by the identity relation when their intersection is a set. The antecedent is more general than either class being a set. (Contributed by NM, 30-Apr-2004.) Weaken the antecedent to sethood of the intersection. (Revised by BJ, 24-Dec-2023.) TODO: replace ~ ideqg , or at least prove ~ ideqg from it.
theorem bj_ideqg (A2 B2 V: class):
  $ wi (wcel (cin A2 B2) V) (wb (wbr A2 B2 cid) (wceq A2 B2)) $;

--| Alternate proof of ~ bj-ideqg from ~ brabga instead of ~ bj-opelid itself proved from ~ bj-opelidb . (Contributed by BJ, 27-Dec-2023.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_ideqgALT (A2 B2 V: class):
  $ wi (wcel (cin A2 B2) V) (wb (wbr A2 B2 cid) (wceq A2 B2)) $;

--| Characterization of classes related by the identity relation. (Contributed by BJ, 24-Dec-2023.)
theorem bj_ideqb (A2 B2: class):
  $ wb (wbr A2 B2 cid) (wa (wcel A2 cvv) (wceq A2 B2)) $;

--| Alternate expression for the restricted identity relation. The advantage of that expression is to expose it as a "bounded" class, being included in the Cartesian square of the restricting class. (Contributed by BJ, 27-Dec-2023.) This is an alternate of ~ idinxpresid (see ~ idinxpres ). See also ~ elrid and ~ elidinxp . (Proof modification is discouraged.)
theorem bj_idres (A2: class):
  $ wceq (cres cid A2) (cin cid (cxp A2 A2)) $;

--| Characterization of the ordered pairs in the restricted identity relation when the intersection of their component belongs to the restricting class. TODO: prove ~ bj-idreseq from it. (Contributed by BJ, 29-Mar-2020.)
theorem bj_opelidres (A2 B2 V: class):
  $ wi (wcel A2 V) (wb (wcel (cop A2 B2) (cres cid V)) (wceq A2 B2)) $;

--| Sufficient condition for the restricted identity relation to agree with equality. The instance of ~ bj-ideqg with ` _V ` substituted for ` V ` is a direct consequence of ~ bj-idreseq . This is a strengthening of ~ resieq which should be proved from it (currently, ~ resieq relies on ~ ideq ). The intersection in the antecedent is not very meaningful, but is a device to prove versions with either class assumed to be a set. It could be enough to prove the version with a disjunctive antecedent: ` |- ( ( A e. C \/ B e. C ) -> ... ) ` . (Contributed by BJ, 25-Dec-2023.)
theorem bj_idreseq (A2 B2 C: class):
  $ wi (wcel (cin A2 B2) C) (wb (wbr A2 B2 (cres cid C)) (wceq A2 B2)) $;

--| Characterization for two classes to be related under the restricted identity relation. (Contributed by BJ, 24-Dec-2023.)
theorem bj_idreseqb (A2 B2 C: class):
  $ wb (wbr A2 B2 (cres cid C)) (wa (wcel A2 C) (wceq A2 B2)) $;

--| For sets, the identity relation is the same thing as equality. (Contributed by NM, 30-Apr-2004.) (Proof shortened by Andrew Salmon, 27-Aug-2011.) Generalize to a disjunctive antecedent. (Revised by BJ, 24-Dec-2023.) TODO: delete once ~ bj-ideqg is in the main section.
theorem bj_ideqg1 (A2 B2 V W: class):
  $ wi (wo (wcel A2 V) (wcel B2 W)) (wb (wbr A2 B2 cid) (wceq A2 B2)) $;

--| Alternate proof of bj-ideqg1 using ~ brabga instead of the "unbounded" version ~ bj-brab2a1 or ~ brab2a . (Contributed by BJ, 25-Dec-2023.) (Proof modification is discouraged.) (New usage is discouraged.) TODO: delete once ~ bj-ideqg is in the main section.
theorem bj_ideqg1ALT (A2 B2 V W: class):
  $ wi (wo (wcel A2 V) (wcel B2 W)) (wb (wbr A2 B2 cid) (wceq A2 B2)) $;

--| Characterization of the couples in ` _I ` . (Contributed by BJ, 29-Mar-2020.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bj_opelidb1ALT (A2 B2: class):
  $ wb (wcel (cop A2 B2) cid) (wa (wcel A2 cvv) (wceq A2 B2)) $;

--| Characterization of the couples in ` _I ` whose first component is a setvar. (Contributed by BJ, 29-Mar-2020.)
theorem bj_elid3 {x3: setvar} (A2: class x3):
  $ wb (wcel (cop (cv x3) A2) cid) (wceq (cv x3) A2) $;

--| Characterization of the elements of ` _I ` . (Contributed by BJ, 22-Jun-2019.)
theorem bj_elid4 (A2 V W: class):
  $ wi (wcel A2 (cxp V W)) (wb (wcel A2 cid) (wceq (cfv A2 c1st) (cfv A2 c2nd))) $;

--| Characterization of the elements of ` _I ` . (Contributed by BJ, 22-Jun-2019.)
theorem bj_elid5 (A2: class):
  $ wb (wcel A2 cid) (wa (wcel A2 (cxp cvv cvv)) (wceq (cfv A2 c1st) (cfv A2 c2nd))) $;

--| Characterization of the elements of the diagonal of a Cartesian square. (Contributed by BJ, 22-Jun-2019.)
theorem bj_elid6 (A2 B2: class):
  $ wb (wcel B2 (cres cid A2)) (wa (wcel B2 (cxp A2 A2)) (wceq (cfv B2 c1st) (cfv B2 c2nd))) $;

--| Characterization of the elements of the diagonal of a Cartesian square. (Contributed by BJ, 22-Jun-2019.)
theorem bj_elid7 (A2 B2 C: class):
  $ wb (wcel (cop B2 C) (cres cid A2)) (wa (wcel B2 A2) (wceq B2 C)) $;

--| Syntax for the diagonal of the Cartesian square of a set.
term cdiag2: class;

--| Define the functionalized identity, which can also be seen as the diagonal function. Its value is given in ~ bj-diagval when it is viewed as the functionalized identity, and in ~ bj-diagval2 when it is viewed as the diagonal function. Indeed, Definition ~ df-br identifies a binary relation with the class of couples that are related by that binary relation (see ~ eqrel2 for the extensionality property of binary relations). As a consequence, the identity relation, or identity function (see ~ funi ), on any class, can alternatively be seen as the diagonal of the cartesian square of that class. The identity relation on the universal class, ` _I ` , is an "identity relation generator", since its restriction to any class is the identity relation on that class. It may be useful to consider a functionalized version of that fact, and that is the purpose of ~ df-bj-diag . Note: most proofs will only use its values ` ( _Id `` A ) ` , in which case it may be enough to use ` ( _I |`` A ) ` everywhere and dispense with this definition. (Contributed by BJ, 22-Jun-2019.)
axiom df_bj_diag {x3: setvar}:
  $ wceq cdiag2 (cmpt x3 cvv (cres cid (cv x3))) $;

--| Value of the functionalized identity, or equivalently of the diagonal function. This expression views it as the functionalized identity, whereas ~ bj-diagval2 views it as the diagonal function. See ~ df-bj-diag for the terminology. (Contributed by BJ, 22-Jun-2019.)
theorem bj_diagval (A2 V: class):
  $ wi (wcel A2 V) (wceq (cfv A2 cdiag2) (cres cid A2)) $;

--| Value of the functionalized identity, or equivalently of the diagonal function. This expression views it as the diagonal function, whereas ~ bj-diagval views it as the functionalized identity. See ~ df-bj-diag for the terminology. (Contributed by BJ, 22-Jun-2019.)
theorem bj_diagval2 (A2 V: class):
  $ wi (wcel A2 V) (wceq (cfv A2 cdiag2) (cin cid (cxp A2 A2))) $;

--| Characterization of the elements of the diagonal of a Cartesian square. Subsumed by ~ bj-elid6 . (Contributed by BJ, 22-Jun-2019.)
theorem bj_eldiag (A2 B2 V: class):
  $ wi (wcel A2 V) (wb (wcel B2 (cfv A2 cdiag2)) (wa (wcel B2 (cxp A2 A2)) (wceq (cfv B2 c1st) (cfv B2 c2nd)))) $;

--| Characterization of the elements of the diagonal of a Cartesian square. Subsumed by ~ bj-elid7 . (Contributed by BJ, 22-Jun-2019.)
theorem bj_eldiag2 (A2 B2 C V: class):
  $ wi (wcel A2 V) (wb (wcel (cop B2 C) (cfv A2 cdiag2)) (wa (wcel B2 A2) (wceq B2 C))) $;

--| Syntax for the functionalized direct image.
term cimdir: class;

--| Definition of the functionalized direct image, which maps a binary relation between two given sets to its associated direct image relation. (Contributed by BJ, 16-Dec-2023.)
axiom df_imdir {x3 y1 r a b: setvar}:
  $ wceq cimdir (cmpo a b cvv cvv (cmpt r (cpw (cxp (cv a) (cv b))) (copab x3 y1 (wa (wa (wss (cv x3) (cv a)) (wss (cv y1) (cv b))) (wceq (cima (cv r) (cv x3)) (cv y1)))))) $;

--| Lemma for ~ bj-imdirval and ~ bj-iminvval . (Contributed by BJ, 23-May-2024.)
theorem bj_imdirvallem {x3 y1 r a b: setvar} (ph: wff x3 y1) (ps: wff x3 y1 r) (A2 B2: class) (C U V: class x3 y1 r a b):
  $ wi ph (wcel A2 U) $ >
  $ wi ph (wcel B2 V) $ >
  $ wceq C (cmpo a b cvv cvv (cmpt r (cpw (cxp (cv a) (cv b))) (copab x3 y1 (wa (wa (wss (cv x3) (cv a)) (wss (cv y1) (cv b))) ps)))) $ >
  $ wi ph (wceq (co A2 B2 C) (cmpt r (cpw (cxp A2 B2)) (copab x3 y1 (wa (wa (wss (cv x3) A2) (wss (cv y1) B2)) ps)))) $;

--| Value of the functionalized direct image. (Contributed by BJ, 16-Dec-2023.)
theorem bj_imdirval {x3 y1 r: setvar} (ph: wff x3 y1) (A2 B2: class) (U V: class x3 y1 r):
  $ wi ph (wcel A2 U) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wceq (co A2 B2 cimdir) (cmpt r (cpw (cxp A2 B2)) (copab x3 y1 (wa (wa (wss (cv x3) A2) (wss (cv y1) B2)) (wceq (cima (cv r) (cv x3)) (cv y1)))))) $;

--| Lemma for ~ bj-imdirval2 and ~ bj-iminvval2 . (Contributed by BJ, 23-May-2024.)
theorem bj_imdirval2lem {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (A2 B2: class) (U V: class x3 y1):
  $ wi ph (wcel A2 U) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wcel (copab x3 y1 (wa (wa (wss (cv x3) A2) (wss (cv y1) B2)) ps)) cvv) $;

--| Value of the functionalized direct image. (Contributed by BJ, 16-Dec-2023.)
theorem bj_imdirval2 {x3 y1: setvar} (ph: wff) (A2 B2 R: class) (U V: class x3 y1):
  $ wi ph (wcel A2 U) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wss R (cxp A2 B2)) $ >
  $ wi ph (wceq (cfv R (co A2 B2 cimdir)) (copab x3 y1 (wa (wa (wss (cv x3) A2) (wss (cv y1) B2)) (wceq (cima R (cv x3)) (cv y1))))) $;

--| Value of the functionalized direct image. (Contributed by BJ, 16-Dec-2023.)
theorem bj_imdirval3 (ph: wff) (A2 B2 R U V X Y: class):
  $ wi ph (wcel A2 U) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wss R (cxp A2 B2)) $ >
  $ wi ph (wb (wbr X Y (cfv R (co A2 B2 cimdir))) (wa (wa (wss X A2) (wss Y B2)) (wceq (cima R X) Y))) $;

--| Lemma for ~ bj-imdirid and ~ bj-iminvid . (Contributed by BJ, 26-May-2024.)
theorem bj_imdiridlem {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wi (wa (wss (cv x3) A2) (wss (cv y1) A2)) (wb ph (wceq (cv x3) (cv y1))) $ >
  $ wceq (copab x3 y1 (wa (wa (wss (cv x3) A2) (wss (cv y1) A2)) ph)) (cres cid (cpw A2)) $;

--| Functorial property of the direct image: the direct image by the identity on a set is the identity on the powerset. (Contributed by BJ, 24-Dec-2023.)
theorem bj_imdirid (ph: wff) (A2 U: class):
  $ wi ph (wcel A2 U) $ >
  $ wi ph (wceq (cfv (cres cid A2) (co A2 A2 cimdir)) (cres cid (cpw A2))) $;

--| Membership in an ordered-pair class abstraction. One can remove the DV condition on ` x , y ` by using ~ opabid in place of ~ opabidw . (Contributed by BJ, 22-May-2024.)
theorem bj_opelopabid {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wbr (cv x3) (cv y1) (copab x3 y1 ph)) ph $;

--| Composition of ordered-pair class abstractions. (Contributed by BJ, 22-May-2024.)
theorem bj_opabco {x3 y1 z: setvar} (ph: wff x3 y1) (ps: wff y1 z):
  $ wceq (ccom (copab y1 z ps) (copab x3 y1 ph)) (copab x3 z (wex y1 (wa ph ps))) $;

--| The composition of two Cartesian products is included in the expected Cartesian product. There is equality if ` ( B i^i C ) =/= (/) ` , see ~ xpcogend . (Contributed by BJ, 22-May-2024.)
theorem bj_xpcossxp (A2 B2 C D: class):
  $ wss (ccom (cxp C D) (cxp A2 B2)) (cxp A2 D) $;

--| Functorial property of the direct image: the direct image by a composition is the composition of the direct images. (Contributed by BJ, 23-May-2024.)
theorem bj_imdirco (ph: wff) (A2 B2 C R S U V W: class):
  $ wi ph (wcel A2 U) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wcel C W) $ >
  $ wi ph (wss R (cxp A2 B2)) $ >
  $ wi ph (wss S (cxp B2 C)) $ >
  $ wi ph (wceq (cfv (ccom S R) (co A2 C cimdir)) (ccom (cfv S (co B2 C cimdir)) (cfv R (co A2 B2 cimdir)))) $;

--| Syntax for the functionalized inverse image.
term ciminv: class;

--| Definition of the functionalized inverse image, which maps a binary relation between two given sets to its associated inverse image relation. (Contributed by BJ, 23-Dec-2023.)
axiom df_iminv {x3 y1 r a b: setvar}:
  $ wceq ciminv (cmpo a b cvv cvv (cmpt r (cpw (cxp (cv a) (cv b))) (copab x3 y1 (wa (wa (wss (cv x3) (cv a)) (wss (cv y1) (cv b))) (wceq (cv x3) (cima (ccnv (cv r)) (cv y1))))))) $;

--| Value of the functionalized inverse image. (Contributed by BJ, 23-May-2024.)
theorem bj_iminvval {x3 y1 r: setvar} (ph: wff x3 y1) (A2 B2: class) (U V: class x3 y1 r):
  $ wi ph (wcel A2 U) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wceq (co A2 B2 ciminv) (cmpt r (cpw (cxp A2 B2)) (copab x3 y1 (wa (wa (wss (cv x3) A2) (wss (cv y1) B2)) (wceq (cv x3) (cima (ccnv (cv r)) (cv y1))))))) $;

--| Value of the functionalized inverse image. (Contributed by BJ, 23-May-2024.)
theorem bj_iminvval2 {x3 y1: setvar} (ph: wff) (A2 B2 R: class) (U V: class x3 y1):
  $ wi ph (wcel A2 U) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wss R (cxp A2 B2)) $ >
  $ wi ph (wceq (cfv R (co A2 B2 ciminv)) (copab x3 y1 (wa (wa (wss (cv x3) A2) (wss (cv y1) B2)) (wceq (cv x3) (cima (ccnv R) (cv y1)))))) $;

--| Functorial property of the inverse image: the inverse image by the identity on a set is the identity on the powerset. (Contributed by BJ, 26-May-2024.)
theorem bj_iminvid (ph: wff) (A2 U: class):
  $ wi ph (wcel A2 U) $ >
  $ wi ph (wceq (cfv (cres cid A2) (co A2 A2 ciminv)) (cres cid (cpw A2))) $;

--| Syntax for the fractional part of a temporary real.
term cfractemp: class;

--| Temporary definition: fractional part of a temporary real. To understand this definition, recall the canonical injection ` _om --> R. ` , ` n |-> [ { x e. Q. | x <Q <. suc n , 1o >. } , 1P ] ~R ` where we successively take the successor of ` n ` to land in positive integers, then take the couple with ` 1o ` as second component to land in positive rationals, then take the Dedekind cut that positive rational forms, and finally take the equivalence class of the couple with ` 1P ` as second component. Adding one at the beginning and subtracting it at the end is necessary since the constructions used in set.mm use the positive integers, positive rationals, and positive reals as intermediate number systems. (Contributed by BJ, 22-Jan-2023.) The precise definition is irrelevant and should generally not be used. One could even inline it. The definitive fractional part of an extended or projective complex number will be defined later. (New usage is discouraged.)
axiom df_bj_fractemp {x3 y1 z n: setvar}:
  $ wceq cfractemp (cmpt x3 cnr (crio y1 (wa (wo (wceq (cv y1) c0r) (wa (wbr c0r (cv y1) cltr) (wbr (cv y1) c1r cltr))) (wrex n (wceq (co (cec (cop (crab z (wbr (cv z) (cop (csuc (cv n)) c1o) cltq) cnq) c1p) cer) (cv y1) cplr) (cv x3)) com)) cnr)) $;

--| Syntax for the function ` inftyexpitau ` parameterizing ` CCinfty ` .
term cinftyexpitau: class;

--| Definition of the auxiliary function ` inftyexpitau ` parameterizing the circle at infinity ` CCinfty ` in ` CCbar ` . We use coupling with ` { R. } ` to simplify the proof of ~ bj-inftyexpitaudisj . (Contributed by BJ, 22-Jan-2023.) The precise definition is irrelevant and should generally not be used. TODO: prove only the necessary lemmas to prove ` |- ( A e. RR /\ B e. RR ) -> ( ( inftyexpitau `` A ) = ` ` ( inftyexpitau `` B ) <-> ( A - B ) e. ZZ ) ) ` . (New usage is discouraged.)
axiom df_bj_inftyexpitau {x3: setvar}:
  $ wceq cinftyexpitau (cmpt x3 cr (cop (cfv (cfv (cv x3) c1st) cfractemp) (csn cnr))) $;

--| Syntax for the circle at infinity ` CCinftyN ` .
term cccinftyN: class;

--| Definition of the circle at infinity ` CCinftyN ` . (Contributed by BJ, 22-Jun-2019.) The precise definition is irrelevant and should generally not be used. (New usage is discouraged.)
axiom df_bj_ccinftyN:
  $ wceq cccinftyN (crn cinftyexpitau) $;

--| The function ` inftyexpitau ` written as a surjection with domain and range. (Contributed by BJ, 4-Feb-2023.)
theorem bj_inftyexpitaufo:
  $ wfo cr cccinftyN cinftyexpitau $;

--| Syntax for the temporary one-half.
term chalf: class;

--| Define the temporary real "one-half". Once the machinery is developed, the real number "one-half" is commonly denoted by ` ( 1 / 2 ) ` . (Contributed by BJ, 4-Feb-2023.) (New usage is discouraged.) TODO: $p |- 1/2 e. R. $= ? $. ( ~ riotacl ) $p |- -. 0R = 1/2 $= ? $. (since -. ( 0R +R 0R ) = 1R ) $p |- 0R <R 1/2 $= ? $. $p |- 1/2 <R 1R $= ? $. $p |- ( {R `` 0R ) = 0R $= ? $. $p |- ( {R `` 1/2 ) = 1/2 $= ? $. df-minfty $a |- minfty = ( inftyexpitau `` <. 1/2 , 0R >. ) $.
axiom df_bj_onehalf {x3: setvar}:
  $ wceq chalf (crio x3 (wceq (co (cv x3) (cv x3) cplr) c1r) cnr) $;

--| An element of the circle at infinity is not a complex number. (Contributed by BJ, 4-Feb-2023.)
theorem bj_inftyexpitaudisj (A2: class):
  $ wn (wcel (cfv A2 cinftyexpitau) cc) $;

--| Syntax for the function ` inftyexpi ` parameterizing ` CCinfty ` .
term cinftyexpi: class;

--| Definition of the auxiliary function ` inftyexpi ` parameterizing the circle at infinity ` CCinfty ` in ` CCbar ` . We use coupling with ` CC ` to simplify the proof of ~ bj-ccinftydisj . It could seem more natural to define ` inftyexpi ` on all of ` RR ` , but we want to use only basic functions in the definition of ` CCbar ` . TODO: transition to ~ df-bj-inftyexpitau instead. (Contributed by BJ, 22-Jun-2019.) The precise definition is irrelevant and should generally not be used. (New usage is discouraged.)
axiom df_bj_inftyexpi {x3: setvar}:
  $ wceq cinftyexpi (cmpt x3 (co (cneg cpi) cpi cioc) (cop (cv x3) cc)) $;

--| Utility theorem for the inverse of ` inftyexpi ` . (Contributed by BJ, 22-Jun-2019.) This utility theorem is irrelevant and should generally not be used. (New usage is discouraged.)
theorem bj_inftyexpiinv (A2: class):
  $ wi (wcel A2 (co (cneg cpi) cpi cioc)) (wceq (cfv (cfv A2 cinftyexpi) c1st) A2) $;

--| Injectivity of the parameterization ` inftyexpi ` . Remark: a more conceptual proof would use ~ bj-inftyexpiinv and the fact that a function with a retraction is injective. (Contributed by BJ, 22-Jun-2019.)
theorem bj_inftyexpiinj (A2 B2: class):
  $ wi (wa (wcel A2 (co (cneg cpi) cpi cioc)) (wcel B2 (co (cneg cpi) cpi cioc))) (wb (wceq A2 B2) (wceq (cfv A2 cinftyexpi) (cfv B2 cinftyexpi))) $;

--| An element of the circle at infinity is not a complex number. (Contributed by BJ, 22-Jun-2019.) This utility theorem is irrelevant and should generally not be used. (New usage is discouraged.)
theorem bj_inftyexpidisj (A2: class):
  $ wn (wcel (cfv A2 cinftyexpi) cc) $;

--| Syntax for the circle at infinity ` CCinfty ` .
term cccinfty: class;

--| Definition of the circle at infinity ` CCinfty ` . (Contributed by BJ, 22-Jun-2019.) The precise definition is irrelevant and should generally not be used. (New usage is discouraged.)
axiom df_bj_ccinfty:
  $ wceq cccinfty (crn cinftyexpi) $;

--| The circle at infinity is disjoint from the set of complex numbers. (Contributed by BJ, 22-Jun-2019.)
theorem bj_ccinftydisj:
  $ wceq (cin cc cccinfty) c0 $;

--| A lemma for infinite extended complex numbers. (Contributed by BJ, 27-Jun-2019.)
theorem bj_elccinfty (A2: class):
  $ wi (wcel A2 (co (cneg cpi) cpi cioc)) (wcel (cfv A2 cinftyexpi) cccinfty) $;

--| Syntax for the set of extended complex numbers ` CCbar ` .
term cccbar: class;

--| Definition of the set of extended complex numbers ` CCbar ` . (Contributed by BJ, 22-Jun-2019.)
axiom df_bj_ccbar:
  $ wceq cccbar (cun cc cccinfty) $;

--| Complex numbers are extended complex numbers. (Contributed by BJ, 27-Jun-2019.)
theorem bj_ccssccbar:
  $ wss cc cccbar $;

--| Infinite extended complex numbers are extended complex numbers. (Contributed by BJ, 27-Jun-2019.)
theorem bj_ccinftyssccbar:
  $ wss cccinfty cccbar $;

--| Syntax for "plus infinity".
term cpinfty: class;

--| Definition of "plus infinity". (Contributed by BJ, 27-Jun-2019.)
axiom df_bj_pinfty:
  $ wceq cpinfty (cfv cc0 cinftyexpi) $;

--| The class ` pinfty ` is an extended complex number. (Contributed by BJ, 27-Jun-2019.)
theorem bj_pinftyccb:
  $ wcel cpinfty cccbar $;

--| The extended complex number ` pinfty ` is not a complex number. (Contributed by BJ, 27-Jun-2019.)
theorem bj_pinftynrr:
  $ wn (wcel cpinfty cc) $;

--| Syntax for "minus infinity".
term cminfty: class;

--| Definition of "minus infinity". (Contributed by BJ, 27-Jun-2019.)
axiom df_bj_minfty:
  $ wceq cminfty (cfv cpi cinftyexpi) $;

--| The class ` minfty ` is an extended complex number. (Contributed by BJ, 27-Jun-2019.)
theorem bj_minftyccb:
  $ wcel cminfty cccbar $;

--| The extended complex number ` minfty ` is not a complex number. (Contributed by BJ, 27-Jun-2019.)
theorem bj_minftynrr:
  $ wn (wcel cminfty cc) $;

--| The extended complex numbers ` pinfty ` and ` minfty ` are different. (Contributed by BJ, 27-Jun-2019.)
theorem bj_pinftynminfty:
  $ wne cpinfty cminfty $;

--| Syntax for the set of extended real numbers.
term crrbar: class;

--| Definition of the set of extended real numbers. This aims to replace ~ df-xr . (Contributed by BJ, 29-Jun-2019.)
axiom df_bj_rrbar:
  $ wceq crrbar (cun cr (cpr cminfty cpinfty)) $;

--| Syntax for ` infty ` .
term cinfty: class;

--| Definition of ` infty ` , the point at infinity of the real or complex projective line. (Contributed by BJ, 27-Jun-2019.) The precise definition is irrelevant and should generally not be used. (New usage is discouraged.)
axiom df_bj_infty:
  $ wceq cinfty (cpw (cuni cc)) $;

--| Syntax for ` CChat ` .
term ccchat: class;

--| Define the complex projective line, or Riemann sphere. (Contributed by BJ, 27-Jun-2019.)
axiom df_bj_cchat:
  $ wceq ccchat (cun cc (csn cinfty)) $;

--| Syntax for ` RRhat ` .
term crrhat: class;

--| Define the real projective line. (Contributed by BJ, 27-Jun-2019.)
axiom df_bj_rrhat:
  $ wceq crrhat (cun cr (csn cinfty)) $;

--| The real projective line is included in the complex projective line. (Contributed by BJ, 27-Jun-2019.)
theorem bj_rrhatsscchat:
  $ wss crrhat ccchat $;

--| Syntax for the addition on extended complex numbers.
term caddcc: class;

--| Define the additions on the extended complex numbers (on the subset of ` ( CCbar X. CCbar ) ` where it makes sense) and on the complex projective line (Riemann sphere). We use the plural in "additions" since these are two different operations, even though ` +cc ` is overloaded. (Contributed by BJ, 22-Jun-2019.)
axiom df_bj_addc {x3: setvar}:
  $ wceq caddcc (cmpt x3 (cun (cun (cxp cc cccbar) (cxp cccbar cc)) (cun (cxp ccchat ccchat) (cres cid cccinfty))) (cif (wo (wceq (cfv (cv x3) c1st) cinfty) (wceq (cfv (cv x3) c2nd) cinfty)) cinfty (cif (wcel (cfv (cv x3) c1st) cc) (cif (wcel (cfv (cv x3) c2nd) cc) (cop (co (cfv (cfv (cv x3) c1st) c1st) (cfv (cfv (cv x3) c2nd) c1st) cplr) (co (cfv (cfv (cv x3) c1st) c2nd) (cfv (cfv (cv x3) c2nd) c2nd) cplr)) (cfv (cv x3) c2nd)) (cfv (cv x3) c1st)))) $;

--| Syntax for negation on the set of extended complex numbers and the complex projective line (Riemann sphere).
term coppcc: class;

--| Define the negation (operation giving the opposite) on the set of extended complex numbers and the complex projective line (Riemann sphere). (Contributed by BJ, 22-Jun-2019.)
axiom df_bj_oppc {x3 y1: setvar}:
  $ wceq coppcc (cmpt x3 (cun cccbar ccchat) (cif (wceq (cv x3) cinfty) cinfty (cif (wcel (cv x3) cc) (crio y1 (wceq (co (cv x3) (cv y1) caddcc) cc0) cc) (cfv (co (cv x3) (cop chalf c0r) caddcc) cinftyexpitau)))) $;

--| Syntax for the standard (strict) order on the extended reals.
term cltxr: class;

--| Define the standard (strict) order on the extended reals. (Contributed by BJ, 4-Feb-2023.)
axiom df_bj_lt {x3 y1 z: setvar}:
  $ wceq cltxr (cun (crab x3 (wex y1 (wex z (wa (wa (wceq (cfv (cv x3) c1st) (cop (cv y1) c0r)) (wceq (cfv (cv x3) c2nd) (cop (cv z) c0r))) (wbr (cv y1) (cv z) cltr)))) (cxp crrbar crrbar)) (cun (cun (cxp (csn cminfty) cr) (cxp cr (csn cpinfty))) (cxp (csn cminfty) (csn cpinfty)))) $;

--| Syntax for the argument of a nonzero extended complex number.
term carg: class;

--| Define the argument of a nonzero extended complex number. By convention, it has values in ` ( -u _pi , _pi ] ` . Another convention chooses values in ` [ 0 , 2 _pi ) ` but the present convention simplifies formulas giving the argument as an arctangent. (Contributed by BJ, 22-Jun-2019.) The "else" case of the second conditional operator, corresponding to infinite extended complex numbers other than ` minfty ` , gives a definition depending on the specific definition chosen for these numbers ( ~ df-bj-inftyexpitau ), and therefore should not be relied upon. (New usage is discouraged.)
axiom df_bj_arg {x3: setvar}:
  $ wceq carg (cmpt x3 (cdif cccbar (csn cc0)) (cif (wcel (cv x3) cc) (cfv (cfv (cv x3) clog) cim) (cif (wbr (cv x3) cc0 cltxr) cpi (co (co (cfv (cv x3) c1st) (co c2 cpi cmul) cdiv) cpi cmin)))) $;

--| Syntax for the multiplication of extended complex numbers.
term cmulc: class;

--| Define the multiplication of extended complex numbers and of the complex projective line (Riemann sphere). In our convention, a product with 0 is 0, even when the other factor is infinite. An alternate convention leaves products of 0 with an infinite number undefined since the multiplication is not continuous at these points. This convention entails ` ( 0 / 0 ) = 0 ` (given ~ df-bj-invc ). This definition uses ` x. ` and ` Arg ` and ` / ` . Indeed, it would be contrived to bypass ordinary complex multiplication, and the present two-step definition looks like a good compromise. (Contributed by BJ, 22-Jun-2019.)
axiom df_bj_mulc {x3: setvar}:
  $ wceq cmulc (cmpt x3 (cun (cxp cccbar cccbar) (cxp ccchat ccchat)) (cif (wo (wceq (cfv (cv x3) c1st) cc0) (wceq (cfv (cv x3) c2nd) cc0)) cc0 (cif (wo (wceq (cfv (cv x3) c1st) cinfty) (wceq (cfv (cv x3) c2nd) cinfty)) cinfty (cif (wcel (cv x3) (cxp cc cc)) (co (cfv (cv x3) c1st) (cfv (cv x3) c2nd) cmul) (cfv (co (co (cfv (cfv (cv x3) c1st) carg) (cfv (cfv (cv x3) c2nd) carg) caddcc) ctau cdiv) cinftyexpitau))))) $;

--| Syntax for the inverse of nonzero extended complex numbers.
term cinvc: class;

--| Define inversion, which maps a nonzero extended complex number or element of the complex projective line (Riemann sphere) to its inverse. Beware of the overloading: the equality ` ( invc `` 0 ) = infty ` is to be understood in the complex projective line, but 0 as an extended complex number does not have an inverse, which we can state as ` ( invc `` 0 ) e/ CCbar ` . This definition relies on ~ df-bj-mulc , which does not bypass ordinary complex multiplication, but defines extended complex multiplication on top of it. Therefore, we could have used directly ` / ` instead of ` ( iota_ ... .cc ... ) ` . (Contributed by BJ, 22-Jun-2019.)
axiom df_bj_invc {x3 y1: setvar}:
  $ wceq cinvc (cmpt x3 (cun cccbar ccchat) (cif (wceq (cv x3) cc0) cinfty (cif (wcel (cv x3) cc) (crio y1 (wceq (co (cv x3) (cv y1) cmulc) c1) cc) cc0))) $;

--| Syntax for the canonical bijection from ` ( _om u. { _om } ) ` onto ` ( NN0 u. { pinfty } ) ` .
term ciomnn: class;

--| Definition of the canonical bijection from ` ( _om u. { _om } ) ` onto ` ( NN0 u. { pinfty } ) ` . To understand this definition, recall that set.mm constructs reals as couples whose first component is a prereal and second component is the zero prereal (in order that one have ` RR C_ CC ` ), that prereals are equivalence classes of couples of positive reals, the latter are Dedekind cuts of positive rationals, which are equivalence classes of positive ordinals. In partiular, we take the successor ordinal at the beginning and subtract 1 at the end since the intermediate systems contain only (strictly) positive numbers. Note the similarity with ~ df-bj-fractemp but we did not use the present definition there since we wanted to have defined ` pinfty ` first. See ~ bj-iomnnom for its value at ` pinfty ` . TODO: Prove ` |- ( iomnn `` (/) ) = 0 ` . Define ` |- NN0 = ( iomnn " _om ) ` and ` |- NN = ( NN0 \ { 0 } ) ` . Prove ` |- iomnn : ( _om u. { _om } ) -1-1-onto-> ( NN0 u. { pinfty } ) ` and ` |- ( iomnn |`` _om ) : _om -1-1-onto-> NN0 ` . Prove that these bijections are respectively an isomorphism of ordered "extended rigs" and of ordered rigs. Prove ` |- ( iomnn |`` _om ) = rec ( ( x e. RR |-> ( x + 1 ) ) , 0 ) ` . (Contributed by BJ, 18-Feb-2023.) The precise definition is irrelevant and should generally not be used. (New usage is discouraged.)
axiom df_bj_iomnn {n r: setvar}:
  $ wceq ciomnn (cun (cmpt n com (cop (cec (cop (crab r (wbr (cv r) (cop (csuc (cv n)) c1o) cltq) cnq) c1p) cer) c0r)) (csn (cop com cpinfty))) $;

--| If the direct image of a singleton under any of two functions is the same, then the values of these functions at the corresponding point agree. (Contributed by BJ, 18-Mar-2023.)
theorem bj_imafv (A2 F G: class):
  $ wi (wceq (cima F (csn A2)) (cima G (csn A2))) (wceq (cfv A2 F) (cfv A2 G)) $;

--| Value of a function expressed as a union of two functions at a point not in the domain of one of them. (Contributed by BJ, 18-Mar-2023.)
theorem bj_funun (ph: wff) (A2 F G H: class):
  $ wi ph (wceq F (cun G H)) $ >
  $ wi ph (wn (wcel A2 (cdm H))) $ >
  $ wi ph (wceq (cfv A2 F) (cfv A2 G)) $;

--| Value of a function expressed as a union of a function and a singleton on a couple (with disjoint domain) at a point not equal to the first component of that couple. (Contributed by BJ, 18-Mar-2023.) (Proof modification is discouraged.)
theorem bj_fununsn1 (ph: wff) (A2 B2 C F G: class):
  $ wi ph (wceq F (cun G (csn (cop B2 C)))) $ >
  $ wi ph (wn (wceq A2 B2)) $ >
  $ wi ph (wceq (cfv A2 F) (cfv A2 G)) $;

--| Value of a function expressed as a union of a function and a singleton on a couple (with disjoint domain) at the first component of that couple. (Contributed by BJ, 18-Mar-2023.) (Proof modification is discouraged.)
theorem bj_fununsn2 (ph: wff) (B2 C F G V W: class):
  $ wi ph (wceq F (cun G (csn (cop B2 C)))) $ >
  $ wi ph (wn (wcel B2 (cdm G))) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wcel C W) $ >
  $ wi ph (wceq (cfv B2 F) C) $;

--| The value of a function with one of its ordered pairs replaced, at arguments other than the replaced one. (Contributed by NM, 23-Sep-2007.) Put in deduction form and remove two sethood hypotheses. (Revised by BJ, 18-Mar-2023.)
theorem bj_fvsnun1 (ph: wff) (A2 B2 C D F G: class):
  $ wi ph (wceq G (cun (cres F (cdif C (csn A2))) (csn (cop A2 B2)))) $ >
  $ wi ph (wcel D (cdif C (csn A2))) $ >
  $ wi ph (wceq (cfv D G) (cfv D F)) $;

--| The value of a function with one of its ordered pairs replaced, at the replaced ordered pair. See also ~ fvsnun2 . (Contributed by NM, 23-Sep-2007.) Put in deduction form. (Revised by BJ, 18-Mar-2023.) (Proof modification is discouraged.)
theorem bj_fvsnun2 (ph: wff) (A2 B2 C F G V W: class):
  $ wi ph (wceq G (cun (cres F (cdif C (csn A2))) (csn (cop A2 B2)))) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wceq (cfv A2 G) B2) $;

--| Value of a function expressed as a union of a mapsto expression and a singleton on a couple (with disjoint domain) at the first component of that couple. (Contributed by BJ, 18-Mar-2023.) (Proof modification is discouraged.)
theorem bj_fvmptunsn1 {x3: setvar} (ph: wff x3) (A2: class) (B2 C D F V W: class x3):
  $ wi ph (wceq F (cun (cmpt x3 A2 B2) (csn (cop C D)))) $ >
  $ wi ph (wn (wcel C A2)) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wcel D W) $ >
  $ wi ph (wceq (cfv C F) D) $;

--| Value of a function expressed as a union of a mapsto expression and a singleton on a couple (with disjoint domain) at a point in the domain of the mapsto construction. (Contributed by BJ, 18-Mar-2023.) (Proof modification is discouraged.)
theorem bj_fvmptunsn2 {x3: setvar} (ph: wff) (A2: class) (B2 C D: class x3) (E: class) (F: class x3) (G: class) (V: class x3):
  $ wi ph (wceq F (cun (cmpt x3 A2 B2) (csn (cop C D)))) $ >
  $ wi ph (wn (wcel C A2)) $ >
  $ wi ph (wcel E A2) $ >
  $ wi ph (wcel G V) $ >
  $ wi (wa ph (wceq (cv x3) E)) (wceq B2 G) $ >
  $ wi ph (wceq (cfv E F) G) $;

--| The canonical bijection from ` ( _om u. { _om } ) ` onto ` ( NN0 u. { pinfty } ) ` maps ` _om ` to ` pinfty ` . (Contributed by BJ, 18-Feb-2023.)
theorem bj_iomnnom:
  $ wceq (cfv com ciomnn) cpinfty $;

--| Syntax for the extended natural numbers.
term cnnbar: class;

--| Definition of the extended natural numbers. (Contributed by BJ, 28-Jul-2023.)
axiom df_bj_nnbar:
  $ wceq cnnbar (cun cn0 (csn cpinfty)) $;

--| Syntax for the extended integers.
term czzbar: class;

--| Definition of the extended integers. (Contributed by BJ, 28-Jul-2023.)
axiom df_bj_zzbar:
  $ wceq czzbar (cun cz (cpr cminfty cpinfty)) $;

--| Syntax for the one-point-compactified integers.
term czzhat: class;

--| Definition of the one-point-compactified. (Contributed by BJ, 28-Jul-2023.)
axiom df_bj_zzhat:
  $ wceq czzhat (cun cz (csn cinfty)) $;

--| Syntax for the divisibility relation.
term cdivc: class;

--| Definition of the divisibility relation (compare ~ df-dvds ). Since 0 is absorbing, ` |- ( A e. ( CCbar u. CChat ) -> ( A ||C 0 ) ) ` and ` |- ( ( 0 ||C A ) <-> A = 0 ) ` . (Contributed by BJ, 28-Jul-2023.)
axiom df_bj_divc {x3 y1 n: setvar}:
  $ wceq cdivc (copab x3 y1 (wa (wcel (cop (cv x3) (cv y1)) (cun (cxp cccbar cccbar) (cxp ccchat ccchat))) (wrex n (wceq (co (cv n) (cv x3) cmulc) (cv y1)) (cun czzbar czzhat)))) $;

--| Semigroups are magmas. (Contributed by BJ, 12-Apr-2024.) (Proof modification is discouraged.)
theorem bj_smgrpssmgm:
  $ wss csgrp cmgm $;

--| Semigroups are magmas (elemental version). (Contributed by BJ, 12-Apr-2024.) (Proof modification is discouraged.)
theorem bj_smgrpssmgmel (G: class):
  $ wi (wcel G csgrp) (wcel G cmgm) $;

--| Monoids are semigroups. (Contributed by BJ, 11-Apr-2024.) (Proof modification is discouraged.)
theorem bj_mndsssmgrp:
  $ wss cmnd csgrp $;

--| Monoids are semigroups (elemental version). (Contributed by BJ, 11-Apr-2024.) (Proof modification is discouraged.)
theorem bj_mndsssmgrpel (G: class):
  $ wi (wcel G cmnd) (wcel G csgrp) $;

--| Commutative monoids are monoids. (Contributed by BJ, 9-Jun-2019.) (Proof modification is discouraged.)
theorem bj_cmnssmnd:
  $ wss ccmn cmnd $;

--| Commutative monoids are monoids (elemental version). This is a more direct proof of ~ cmnmnd , which relies on ~ iscmn . (Contributed by BJ, 9-Jun-2019.) (Proof modification is discouraged.)
theorem bj_cmnssmndel (A2: class):
  $ wi (wcel A2 ccmn) (wcel A2 cmnd) $;

--| Groups are monoids. (Contributed by BJ, 5-Jan-2024.) (Proof modification is discouraged.)
theorem bj_grpssmnd:
  $ wss cgrp cmnd $;

--| Groups are monoids (elemental version). Shorter proof of ~ grpmnd . (Contributed by BJ, 5-Jan-2024.) (Proof modification is discouraged.)
theorem bj_grpssmndel (A2: class):
  $ wi (wcel A2 cgrp) (wcel A2 cmnd) $;

--| Abelian groups are groups. (Contributed by BJ, 9-Jun-2019.) (Proof modification is discouraged.)
theorem bj_ablssgrp:
  $ wss cabl cgrp $;

--| Abelian groups are groups (elemental version). This is a shorter proof of ~ ablgrp . (Contributed by BJ, 9-Jun-2019.) (Proof modification is discouraged.)
theorem bj_ablssgrpel (A2: class):
  $ wi (wcel A2 cabl) (wcel A2 cgrp) $;

--| Abelian groups are commutative monoids. (Contributed by BJ, 9-Jun-2019.) (Proof modification is discouraged.)
theorem bj_ablsscmn:
  $ wss cabl ccmn $;

--| Abelian groups are commutative monoids (elemental version). This is a shorter proof of ~ ablcmn . (Contributed by BJ, 9-Jun-2019.) (Proof modification is discouraged.)
theorem bj_ablsscmnel (A2: class):
  $ wi (wcel A2 cabl) (wcel A2 ccmn) $;

--| (The additive groups of) modules are abelian groups. (The elemental version is ~ lmodabl ; see also ~ lmodgrp and ~ lmodcmn .) (Contributed by BJ, 9-Jun-2019.)
theorem bj_modssabl:
  $ wss clmod cabl $;

--| Vector spaces are modules. (Contributed by BJ, 9-Jun-2019.) (Proof modification is discouraged.)
theorem bj_vecssmod:
  $ wss clvec clmod $;

--| Vector spaces are modules (elemental version). This is a shorter proof of ~ lveclmod . (Contributed by BJ, 9-Jun-2019.) (Proof modification is discouraged.)
theorem bj_vecssmodel (A2: class):
  $ wi (wcel A2 clvec) (wcel A2 clmod) $;

--| Syntax for the class "finite summation in monoids".
term cfinsum: class;

--| Finite summation in commutative monoids. This finite summation function can be extended to pairs ` <. y , z >. ` where ` y ` is a left-unital magma and ` z ` is defined on a totally ordered set (choosing left-associative composition), or dropping unitality and requiring nonempty families, or on any monoids for families of permutable elements, etc. We use the term "summation", even though the definition stands for any unital, commutative and associative composition law. (Contributed by BJ, 9-Jun-2019.)
axiom df_bj_finsum {x3 y1 z t f2 m n s1: setvar}:
  $ wceq cfinsum (cmpt x3 (copab y1 z (wa (wcel (cv y1) ccmn) (wrex t (wf (cv t) (cfv (cv y1) cbs) (cv z)) cfn))) (cio s1 (wrex m (wex f2 (wa (wf1o (co c1 (cv m) cfz) (cdm (cfv (cv x3) c2nd)) (cv f2)) (wceq (cv s1) (cfv (cv m) (cseq (cfv (cfv (cv x3) c1st) cplusg) (cmpt n cn (cfv (cfv (cv n) (cv f2)) (cfv (cv x3) c2nd))) c1))))) cn0))) $;

--| Value of a finite sum. (Contributed by BJ, 9-Jun-2019.) (Proof shortened by AV, 5-May-2021.)
theorem bj_finsumval0 {f2 m n s1: setvar} (ph: wff n) (A2 B2: class) (I: class m s1):
  $ wi ph (wcel A2 ccmn) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wf I (cfv A2 cbs) B2) $ >
  $ wi ph (wceq (co A2 B2 cfinsum) (cio s1 (wrex m (wex f2 (wa (wf1o (co c1 (cv m) cfz) I (cv f2)) (wceq (cv s1) (cfv (cfv I chash) (cseq (cfv A2 cplusg) (cmpt n cn (cfv (cfv (cv n) (cv f2)) B2)) c1))))) cn0))) $;

--| Variant of ~ fvimacnv where membership of ` A ` in the domain is not needed provided the containing class ` B ` does not contain the empty set. This antecedent would not be needed with Definition ~ df-afv . (Contributed by BJ, 7-Jan-2024.)
theorem bj_fvimacnv0 (A2 B2 F: class):
  $ wi (wa (wfun F) (wn (wcel c0 B2))) (wb (wcel (cfv A2 F) B2) (wcel A2 (cima (ccnv F) B2))) $;

--| The predicate "is a vector space". (Contributed by BJ, 6-Jan-2024.)
theorem bj_isvec (ph: wff) (K V: class):
  $ wi ph (wceq K (cfv V csca)) $ >
  $ wi ph (wb (wcel V clvec) (wa (wcel V clmod) (wcel K cdr))) $;

--| Fields are division rings. (Contributed by BJ, 6-Jan-2024.)
theorem bj_fldssdrng:
  $ wss cfield cdr $;

--| Fields are division rings (elemental version). (Contributed by BJ, 9-Nov-2024.)
theorem bj_flddrng (F: class):
  $ wi (wcel F cfield) (wcel F cdr) $;

--| The field of real numbers is a division ring. (Contributed by BJ, 6-Jan-2024.)
theorem bj_rrdrg:
  $ wcel crefld cdr $;

--| The predicate "is a subcomplex module". (Contributed by BJ, 6-Jan-2024.)
theorem bj_isclm (ph: wff) (F K W: class):
  $ wi ph (wceq F (cfv W csca)) $ >
  $ wi ph (wceq K (cfv F cbs)) $ >
  $ wi ph (wb (wcel W cclm) (w3a (wcel W clmod) (wceq F (co ccnfld K cress)) (wcel K (cfv ccnfld csubrg)))) $;

--| Syntax for the class of real vector spaces.
term crrvec: class;

--| Definition of the class of real vector spaces. The previous definition, ` |- RRVec = { x e. LMod | ( Scalar `` x ) = RRfld } ` , can be recovered using ~ bj-isrvec . The present one is preferred since it does not use any dummy variable. That ` RRVec ` could be defined with ` LVec ` in place of ` LMod ` is a consequence of ~ bj-isrvec2 . (Contributed by BJ, 9-Jun-2019.)
axiom df_bj_rvec:
  $ wceq crrvec (cin clmod (cima (ccnv csca) (csn crefld))) $;

--| The predicate "is a real vector space". Using ~ df-sca instead of ~ scaid shortens the proof by two syntactic steps, but it is preferable not to rely on the precise definition ~ df-sca . (Contributed by BJ, 6-Jan-2024.)
theorem bj_isrvec (V: class):
  $ wb (wcel V crrvec) (wa (wcel V clmod) (wceq (cfv V csca) crefld)) $;

--| Real vector spaces are modules (elemental version). (Contributed by BJ, 6-Jan-2024.)
theorem bj_rvecmod (V: class):
  $ wi (wcel V crrvec) (wcel V clmod) $;

--| Real vector spaces are modules. (Contributed by BJ, 6-Jan-2024.)
theorem bj_rvecssmod:
  $ wss crrvec clmod $;

--| The field of scalars of a real vector space is the field of real numbers. (Contributed by BJ, 6-Jan-2024.)
theorem bj_rvecrr (V: class):
  $ wi (wcel V crrvec) (wceq (cfv V csca) crefld) $;

--| The predicate "is a real vector space". (Contributed by BJ, 6-Jan-2024.)
theorem bj_isrvecd (ph: wff) (K V: class):
  $ wi ph (wceq (cfv V csca) K) $ >
  $ wi ph (wb (wcel V crrvec) (wa (wcel V clmod) (wceq K crefld))) $;

--| Real vector spaces are vector spaces (elemental version). (Contributed by BJ, 6-Jan-2024.)
theorem bj_rvecvec (V: class):
  $ wi (wcel V crrvec) (wcel V clvec) $;

--| The predicate "is a real vector space". (Contributed by BJ, 6-Jan-2024.)
theorem bj_isrvec2 (ph: wff) (K V: class):
  $ wi ph (wceq (cfv V csca) K) $ >
  $ wi ph (wb (wcel V crrvec) (wa (wcel V clvec) (wceq K crefld))) $;

--| Real vector spaces are vector spaces. (Contributed by BJ, 6-Jan-2024.)
theorem bj_rvecssvec:
  $ wss crrvec clvec $;

--| Real vector spaces are subcomplex modules (elemental version). (Contributed by BJ, 6-Jan-2024.)
theorem bj_rveccmod (V: class):
  $ wi (wcel V crrvec) (wcel V cclm) $;

--| Real vector spaces are subcomplex modules. (Contributed by BJ, 6-Jan-2024.)
theorem bj_rvecsscmod:
  $ wss crrvec cclm $;

--| Real vector spaces are subcomplex vector spaces. (Contributed by BJ, 6-Jan-2024.)
theorem bj_rvecsscvec:
  $ wss crrvec ccvs $;

--| Real vector spaces are subcomplex vector spaces (elemental version). (Contributed by BJ, 6-Jan-2024.)
theorem bj_rveccvec (V: class):
  $ wi (wcel V crrvec) (wcel V ccvs) $;

--| (The additive groups of) real vector spaces are commutative groups. (Contributed by BJ, 9-Jun-2019.)
theorem bj_rvecssabl:
  $ wss crrvec cabl $;

--| (The additive groups of) real vector spaces are commutative groups (elemental version). (Contributed by BJ, 9-Jun-2019.)
theorem bj_rvecabl (A2: class):
  $ wi (wcel A2 crrvec) (wcel A2 cabl) $;

--| A consequence of commutativity of multiplication. (Contributed by BJ, 6-Jun-2019.)
theorem bj_subcom (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wceq (co (co A2 B2 cmul) (co B2 A2 cmul) cmin) cc0) $;

--| Solution of a (scalar) linear equation. (Contributed by BJ, 6-Jun-2019.)
theorem bj_lineqi (ph: wff) (A2 B2 X Y: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel X cc) $ >
  $ wi ph (wcel Y cc) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wceq (co (co A2 X cmul) B2 caddc) Y) $ >
  $ wi ph (wceq X (co (co Y B2 cmin) A2 cdiv)) $;

--| Lemma for ~ bj-bary1 : expression for a barycenter of two points in one dimension (complex line). (Contributed by BJ, 6-Jun-2019.)
theorem bj_bary1lem (ph: wff) (A2 B2 X: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel X cc) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wceq X (co (co (co (co B2 X cmin) (co B2 A2 cmin) cdiv) A2 cmul) (co (co (co X A2 cmin) (co B2 A2 cmin) cdiv) B2 cmul) caddc)) $;

--| Lemma for ~ bj-bary1 : computation of one of the two barycentric coordinates of a barycenter of two points in one dimension (complex line). (Contributed by BJ, 6-Jun-2019.)
theorem bj_bary1lem1 (ph: wff) (A2 B2 S T X: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel X cc) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wcel S cc) $ >
  $ wi ph (wcel T cc) $ >
  $ wi ph (wi (wa (wceq X (co (co S A2 cmul) (co T B2 cmul) caddc)) (wceq (co S T caddc) c1)) (wceq T (co (co X A2 cmin) (co B2 A2 cmin) cdiv))) $;

--| Barycentric coordinates in one dimension (complex line). In the statement, ` X ` is the barycenter of the two points ` A , B ` with respective normalized coefficients ` S , T ` . (Contributed by BJ, 6-Jun-2019.)
theorem bj_bary1 (ph: wff) (A2 B2 S T X: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel X cc) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wcel S cc) $ >
  $ wi ph (wcel T cc) $ >
  $ wi ph (wb (wa (wceq X (co (co S A2 cmul) (co T B2 cmul) caddc)) (wceq (co S T caddc) c1)) (wa (wceq S (co (co B2 X cmin) (co B2 A2 cmin) cdiv)) (wceq T (co (co X A2 cmin) (co B2 A2 cmin) cdiv)))) $;

--| Token for the monoid of endomorphisms.
term cend: class;

--| The monoid of endomorphisms on an object of a category. (Contributed by BJ, 4-Apr-2024.)
axiom df_bj_end {x3 c: setvar}:
  $ wceq cend (cmpt c ccat (cmpt x3 (cfv (cv c) cbs) (cpr (cop (cfv cnx cbs) (co (cv x3) (cv x3) (cfv (cv c) chom))) (cop (cfv cnx cplusg) (co (cop (cv x3) (cv x3)) (cv x3) (cfv (cv c) cco)))))) $;

--| Value of the monoid of endomorphisms on an object of a category. (Contributed by BJ, 5-Apr-2024.) (Proof modification is discouraged.)
theorem bj_endval (ph: wff) (C X: class):
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel X (cfv C cbs)) $ >
  $ wi ph (wceq (cfv X (cfv C cend)) (cpr (cop (cfv cnx cbs) (co X X (cfv C chom))) (cop (cfv cnx cplusg) (co (cop X X) X (cfv C cco))))) $;

--| Base set of the monoid of endomorphisms on an object of a category. (Contributed by BJ, 5-Apr-2024.) (Proof modification is discouraged.)
theorem bj_endbase (ph: wff) (C X: class):
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel X (cfv C cbs)) $ >
  $ wi ph (wceq (cfv (cfv X (cfv C cend)) cbs) (co X X (cfv C chom))) $;

--| Composition law of the monoid of endomorphisms on an object of a category. (Contributed by BJ, 5-Apr-2024.) (Proof modification is discouraged.)
theorem bj_endcomp (ph: wff) (C X: class):
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel X (cfv C cbs)) $ >
  $ wi ph (wceq (cfv (cfv X (cfv C cend)) cplusg) (co (cop X X) X (cfv C cco))) $;

--| The monoid of endomorphisms on an object of a category is a monoid. (Contributed by BJ, 5-Apr-2024.) (Proof modification is discouraged.)
theorem bj_endmnd (ph: wff) (C X: class):
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel X (cfv C cbs)) $ >
  $ wi ph (wcel (cfv X (cfv C cend)) cmnd) $;

--| Lemma for tau-related theorems. (Contributed by Jim Kingdon, 16-Feb-2019.)
theorem taupilem3 (A2: class):
  $ wb (wcel A2 (cin crp (cima (ccnv ccos) (csn c1)))) (wa (wcel A2 crp) (wceq (cfv A2 ccos) c1)) $;

--| A set of positive reals has (in the reals) a lower bound. (Contributed by Jim Kingdon, 19-Feb-2019.)
theorem taupilemrplb {x3 y1: setvar} (A2: class y1):
  $ wrex x3 (wral y1 (wbr (cv x3) (cv y1) cle) (cin crp A2)) cr $;

--| Lemma for ~ taupi . A positive real whose cosine is one is at least ` 2 x. _pi ` . (Contributed by Jim Kingdon, 19-Feb-2019.)
theorem taupilem1 (A2: class):
  $ wi (wa (wcel A2 crp) (wceq (cfv A2 ccos) c1)) (wbr (co c2 cpi cmul) A2 cle) $;

--| Lemma for ~ taupi . The smallest positive real whose cosine is one is at most ` 2 x. _pi ` . (Contributed by Jim Kingdon, 19-Feb-2019.) (Revised by AV, 1-Oct-2020.)
theorem taupilem2:
  $ wbr ctau (co c2 cpi cmul) cle $;

--| Relationship between ` _tau ` and ` _pi ` . This can be seen as connecting the ratio of a circle's circumference to its radius and the ratio of a circle's circumference to its diameter. (Contributed by Jim Kingdon, 19-Feb-2019.) (Revised by AV, 1-Oct-2020.)
theorem taupi:
  $ wceq ctau (co c2 cpi cmul) $;

--| Alternate definition of the ` gcd ` operator. (Contributed by Jim Kingdon, 31-Dec-2021.)
theorem dfgcd3 {z d: setvar} (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wceq (co M N cgcd) (crio d (wral z (wb (wbr (cv z) (cv d) cdvds) (wa (wbr (cv z) M cdvds) (wbr (cv z) N cdvds))) cz) cn0)) $;

--| Lemma for ~ irrdiff . The forward direction. (Contributed by Jim Kingdon, 20-May-2024.)
theorem irrdifflemf (ph: wff) (A2 Q R: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wn (wcel A2 cq)) $ >
  $ wi ph (wcel Q cq) $ >
  $ wi ph (wcel R cq) $ >
  $ wi ph (wne Q R) $ >
  $ wi ph (wne (cfv (co A2 Q cmin) cabs) (cfv (co A2 R cmin) cabs)) $;

--| The irrationals are exactly those reals that are a different distance from every rational. (Contributed by Jim Kingdon, 19-May-2024.)
theorem irrdiff {r q: setvar} (A2: class):
  $ wi (wcel A2 cr) (wb (wn (wcel A2 cq)) (wral q (wral r (wi (wne (cv q) (cv r)) (wne (cfv (co A2 (cv q) cmin) cabs) (cfv (co A2 (cv r) cmin) cabs))) cq) cq)) $;

--| The rationals are exactly those reals for which there exist two distinct rationals that are the same distance from the original number. Similar to ~ irrdiff but here proved with a proof which would also work in constructive mathematics. From an online post by Ingo Blechschmidt. For a proof using ~ irrdiff , see ~ qdiffALT . (Contributed by Jim Kingdon, 24-Apr-2026.)
theorem qdiff {r q: setvar} (A2: class):
  $ wi (wcel A2 cr) (wb (wcel A2 cq) (wrex q (wrex r (wa (wne (cv q) (cv r)) (wceq (cfv (co A2 (cv q) cmin) cabs) (cfv (co A2 (cv r) cmin) cabs))) cq) cq)) $;

--| Alternate proof of ~ qdiff . This is a proof from ~ irrdiff using excluded middle in a variety of places. (Contributed by Jim Kingdon, 27-Apr-2026.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem qdiffALT {r q: setvar} (A2: class):
  $ wi (wcel A2 cr) (wb (wcel A2 cq) (wrex q (wrex r (wa (wne (cv q) (cv r)) (wceq (cfv (co A2 (cv q) cmin) cabs) (cfv (co A2 (cv r) cmin) cabs))) cq) cq)) $;

--| The closed unit interval is equinumerous to the open unit interval. Based on a Mastodon post by Michael Kinyon. (Contributed by Jim Kingdon, 4-Jun-2024.)
theorem iccioo01:
  $ wbr (co cc0 c1 cicc) (co cc0 c1 cioo) cen $;

--| Move class substitution in and out of ` recs ` . (Contributed by ML, 25-Oct-2020.)
theorem csbrecsg {x3: setvar} (A2 F V: class x3):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (crecs F)) (crecs (csb x3 A2 F))) $;

--| Move class substitution in and out of the recursive function generator. (Contributed by ML, 25-Oct-2020.)
theorem csbrdgg {x3: setvar} (A2 F I V: class x3):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (crdg F I)) (crdg (csb x3 A2 F) (csb x3 A2 I))) $;

--| Move class substitution in and out of class abstractions of nested ordered pairs. (Contributed by ML, 25-Oct-2020.)
theorem csboprabg {x3 y1 z d: setvar} (ph: wff x3 y1 z d) (A2 V: class x3):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (coprab y1 z d ph)) (coprab y1 z d (wsbc x3 ph A2))) $;

--| Move class substitution in and out of maps-to notation for operations. (Contributed by ML, 25-Oct-2020.)
theorem csbmpo123 {x3 y1 z: setvar} (A2: class x3) (D: class x3 y1 z) (V: class x3) (Y Z: class x3 y1 z):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (cmpo y1 z Y Z D)) (cmpo y1 z (csb x3 A2 Y) (csb x3 A2 Z) (csb x3 A2 D))) $;

--| A contraposition inference. (Contributed by ML, 18-Oct-2020.)
theorem con1bii2 (ph ps: wff):
  $ wb (wn ph) ps $ >
  $ wb ph (wn ps) $;

--| A contraposition inference. (Contributed by ML, 18-Oct-2020.)
theorem con2bii2 (ph ps: wff):
  $ wb ph (wn ps) $ >
  $ wb (wn ph) ps $;

--| Implicit substitution of a class for a setvar variable. (Contributed by ML, 17-Oct-2020.)
theorem vtoclefex {x3: setvar} (ph: wff x3) (A2: class) (V: class x3):
  $ wnf x3 ph $ >
  $ wi (wceq (cv x3) A2) ph $ >
  $ wi (wcel A2 V) ph $;

--| The range of a function mapping to singletons. (Contributed by ML, 15-Jul-2020.)
theorem rnmptsn {x3 u: setvar} (A2: class x3):
  $ wceq (crn (cmpt x3 A2 (csn (cv x3)))) (cab u (wrex x3 (wceq (cv u) (csn (cv x3))) A2)) $;

--| This is the core of the proof of ~ f1omptsn , but to avoid the distinct variables on the definitions, we split this proof into two. (Contributed by ML, 15-Jul-2020.)
theorem f1omptsnlem {x3 u: setvar} (A2 R: class) (F: class u):
  $ wceq F (cmpt x3 A2 (csn (cv x3))) $ >
  $ wceq R (cab u (wrex x3 (wceq (cv u) (csn (cv x3))) A2)) $ >
  $ wf1o A2 R F $;

--| A function mapping to singletons is bijective onto a set of singletons. (Contributed by ML, 16-Jul-2020.)
theorem f1omptsn {x3 u: setvar} (A2: class) (R F: class x3 u):
  $ wceq F (cmpt x3 A2 (csn (cv x3))) $ >
  $ wceq R (cab u (wrex x3 (wceq (cv u) (csn (cv x3))) A2)) $ >
  $ wf1o A2 R F $;

--| This is the core of the proof of ~ mptsnun , but to avoid the distinct variables on the definitions, we split this proof into two. (Contributed by ML, 16-Jul-2020.)
theorem mptsnunlem {x3 u: setvar} (A2 B2: class) (R: class x3 u) (F: class u):
  $ wceq F (cmpt x3 A2 (csn (cv x3))) $ >
  $ wceq R (cab u (wrex x3 (wceq (cv u) (csn (cv x3))) A2)) $ >
  $ wi (wss B2 A2) (wceq B2 (cuni (cima F B2))) $;

--| A class ` B ` is equal to the union of the class of all singletons of elements of ` B ` . (Contributed by ML, 16-Jul-2020.)
theorem mptsnun {x3 u: setvar} (A2 B2: class) (R F: class x3 u):
  $ wceq F (cmpt x3 A2 (csn (cv x3))) $ >
  $ wceq R (cab u (wrex x3 (wceq (cv u) (csn (cv x3))) A2)) $ >
  $ wi (wss B2 A2) (wceq B2 (cuni (cima F B2))) $;

--| This is the core of the proof of ~ dissneq , but to avoid the distinct variables on the definitions, we split this proof into two. (Contributed by ML, 16-Jul-2020.)
theorem dissneqlem {x3 u: setvar} (A2: class) (B2 C: class u):
  $ wceq C (cab u (wrex x3 (wceq (cv u) (csn (cv x3))) A2)) $ >
  $ wi (wa (wss C B2) (wcel B2 (cfv A2 ctopon))) (wceq B2 (cpw A2)) $;

--| Any topology that contains every single-point set is the discrete topology. (Contributed by ML, 16-Jul-2020.)
theorem dissneq {x3 u: setvar} (A2: class) (B2 C: class x3 u):
  $ wceq C (cab u (wrex x3 (wceq (cv u) (csn (cv x3))) A2)) $ >
  $ wi (wa (wss C B2) (wcel B2 (cfv A2 ctopon))) (wceq B2 (cpw A2)) $;

--| Closed form of ~ exlimimd . (Contributed by ML, 17-Jul-2020.)
theorem exlimim {x3: setvar} (ph: wff x3) (ps: wff):
  $ wi (wa (wex x3 ph) (wal x3 (wi ph ps))) ps $;

--| Existential elimination rule of natural deduction. (Contributed by ML, 17-Jul-2020.)
theorem exlimimd {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff):
  $ wi ph (wex x3 ps) $ >
  $ wi ph (wi ps ch) $ >
  $ wi ph ch $;

--| Closed form of ~ exellimddv . See also ~ exlimim for a more general theorem. (Contributed by ML, 17-Jul-2020.)
theorem exellim {x3: setvar} (ph: wff) (A2: class x3):
  $ wi (wa (wex x3 (wcel (cv x3) A2)) (wal x3 (wi (wcel (cv x3) A2) ph))) ph $;

--| Eliminate an antecedent when the antecedent is elementhood, deduction version. See ~ exellim for the closed form, which requires the use of a universal quantifier. (Contributed by ML, 17-Jul-2020.)
theorem exellimddv {x3: setvar} (ph ps: wff) (A2: class x3):
  $ wi ph (wex x3 (wcel (cv x3) A2)) $ >
  $ wi ph (wi (wcel (cv x3) A2) ps) $ >
  $ wi ph ps $;

--| Part of Exercise 3 of [Munkres] p. 83. The topology of all subsets ` x ` of ` A ` such that the complement of ` x ` in ` A ` is infinite, or ` x ` is the empty set, or ` x ` is all of ` A ` , is the trivial topology when ` A ` is finite. (Contributed by ML, 14-Jul-2020.)
theorem topdifinfindis {x3: setvar} (A2: class) (T: class x3):
  $ wceq T (crab x3 (wo (wn (wcel (cdif A2 (cv x3)) cfn)) (wo (wceq (cv x3) c0) (wceq (cv x3) A2))) (cpw A2)) $ >
  $ wi (wcel A2 cfn) (wceq T (cpr c0 A2)) $;

--| This is the core of the proof of ~ topdifinffin , but to avoid the distinct variables on the definition, we need to split this proof into two. (Contributed by ML, 17-Jul-2020.)
theorem topdifinffinlem {x3: setvar} (A2 T: class):
  $ wceq T (crab x3 (wo (wn (wcel (cdif A2 (cv x3)) cfn)) (wo (wceq (cv x3) c0) (wceq (cv x3) A2))) (cpw A2)) $ >
  $ wi (wcel T (cfv A2 ctopon)) (wcel A2 cfn) $;

--| Part of Exercise 3 of [Munkres] p. 83. The topology of all subsets ` x ` of ` A ` such that the complement of ` x ` in ` A ` is infinite, or ` x ` is the empty set, or ` x ` is all of ` A ` , is a topology only if ` A ` is finite. (Contributed by ML, 17-Jul-2020.)
theorem topdifinffin {x3: setvar} (A2: class) (T: class x3):
  $ wceq T (crab x3 (wo (wn (wcel (cdif A2 (cv x3)) cfn)) (wo (wceq (cv x3) c0) (wceq (cv x3) A2))) (cpw A2)) $ >
  $ wi (wcel T (cfv A2 ctopon)) (wcel A2 cfn) $;

--| Part of Exercise 3 of [Munkres] p. 83. The topology of all subsets ` x ` of ` A ` such that the complement of ` x ` in ` A ` is infinite, or ` x ` is the empty set, or ` x ` is all of ` A ` , is a topology if and only if ` A ` is finite, in which case it is the trivial topology. (Contributed by ML, 17-Jul-2020.)
theorem topdifinf {x3: setvar} (A2: class) (T: class x3):
  $ wceq T (crab x3 (wo (wn (wcel (cdif A2 (cv x3)) cfn)) (wo (wceq (cv x3) c0) (wceq (cv x3) A2))) (cpw A2)) $ >
  $ wa (wb (wcel T (cfv A2 ctopon)) (wcel A2 cfn)) (wi (wcel T (cfv A2 ctopon)) (wceq T (cpr c0 A2))) $;

--| Two different ways of defining the collection from Exercise 3 of [Munkres] p. 83. (Contributed by ML, 18-Jul-2020.)
theorem topdifinfeq {x3: setvar} (A2: class):
  $ wceq (crab x3 (wo (wn (wcel (cdif A2 (cv x3)) cfn)) (wo (wceq (cdif A2 (cv x3)) c0) (wceq (cdif A2 (cv x3)) A2))) (cpw A2)) (crab x3 (wo (wn (wcel (cdif A2 (cv x3)) cfn)) (wo (wceq (cv x3) c0) (wceq (cv x3) A2))) (cpw A2)) $;

--| Closed-below, open-above intervals of reals. (Contributed by ML, 26-Jul-2020.)
theorem icorempo {x3 y1 z: setvar} (F: class x3 y1 z):
  $ wceq F (cres cico (cxp cr cr)) $ >
  $ wceq F (cmpo x3 y1 cr cr (crab z (wa (wbr (cv x3) (cv z) cle) (wbr (cv z) (cv y1) clt)) cr)) $;

--| Closed-below, open-above intervals of reals map to subsets of reals. (Contributed by ML, 25-Jul-2020.)
theorem icoreresf:
  $ wf (cxp cr cr) (cpw cr) (cres cico (cxp cr cr)) $;

--| Value of the closed-below, open-above interval function on reals. (Contributed by ML, 26-Jul-2020.)
theorem icoreval {z: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wceq (co A2 B2 cico) (crab z (wa (wbr A2 (cv z) cle) (wbr (cv z) B2 clt)) cr)) $;

--| Elementhood in the set of closed-below, open-above intervals of reals. (Contributed by ML, 27-Jul-2020.)
theorem icoreelrnab {z a b: setvar} (I: class z a b) (X: class z):
  $ wceq I (cima cico (cxp cr cr)) $ >
  $ wb (wcel X I) (wrex a (wrex b (wceq X (crab z (wa (wbr (cv a) (cv z) cle) (wbr (cv z) (cv b) clt)) cr)) cr) cr) $;

--| Lemma for ~ isbasisrelowl . (Contributed by ML, 27-Jul-2020.)
theorem isbasisrelowllem1 {z b c: setvar} (x3 y1: setvar) (I: class b c) (a d: setvar):
  $ wceq I (cima cico (cxp cr cr)) $ >
  $ wi (wa (wa (w3a (wcel (cv a) cr) (wcel (cv b) cr) (wceq (cv x3) (crab z (wa (wbr (cv a) (cv z) cle) (wbr (cv z) (cv b) clt)) cr))) (w3a (wcel (cv c) cr) (wcel (cv d) cr) (wceq (cv y1) (crab z (wa (wbr (cv c) (cv z) cle) (wbr (cv z) (cv d) clt)) cr)))) (wa (wbr (cv a) (cv c) cle) (wbr (cv b) (cv d) cle))) (wcel (cin (cv x3) (cv y1)) I) $;

--| Lemma for ~ isbasisrelowl . (Contributed by ML, 27-Jul-2020.)
theorem isbasisrelowllem2 {z c d: setvar} (x3 y1: setvar) (I: class z c d) (a b: setvar):
  $ wceq I (cima cico (cxp cr cr)) $ >
  $ wi (wa (wa (w3a (wcel (cv a) cr) (wcel (cv b) cr) (wceq (cv x3) (crab z (wa (wbr (cv a) (cv z) cle) (wbr (cv z) (cv b) clt)) cr))) (w3a (wcel (cv c) cr) (wcel (cv d) cr) (wceq (cv y1) (crab z (wa (wbr (cv c) (cv z) cle) (wbr (cv z) (cv d) clt)) cr)))) (wa (wbr (cv a) (cv c) cle) (wbr (cv d) (cv b) cle))) (wcel (cin (cv x3) (cv y1)) I) $;

--| The set of closed-below, open-above intervals of reals is closed under finite intersection. (Contributed by ML, 27-Jul-2020.)
theorem icoreclin (x3 y1: setvar) (I: class):
  $ wceq I (cima cico (cxp cr cr)) $ >
  $ wi (wa (wcel (cv x3) I) (wcel (cv y1) I)) (wcel (cin (cv x3) (cv y1)) I) $;

--| The set of all closed-below, open-above intervals of reals form a basis. (Contributed by ML, 27-Jul-2020.)
theorem isbasisrelowl (I: class):
  $ wceq I (cima cico (cxp cr cr)) $ >
  $ wcel I ctb $;

--| The union of all closed-below, open-above intervals of reals is the set of reals. (Contributed by ML, 27-Jul-2020.)
theorem icoreunrn (I: class):
  $ wceq I (cima cico (cxp cr cr)) $ >
  $ wceq cr (cuni I) $;

--| The set of all closed-below, open-above intervals of reals generate a topology on the reals. (Contributed by ML, 27-Jul-2020.)
theorem istoprelowl (I: class):
  $ wceq I (cima cico (cxp cr cr)) $ >
  $ wcel (cfv I ctg) (cfv cr ctopon) $;

--| A class abstraction which is an element of the set of closed-below, open-above intervals of reals. (Contributed by ML, 1-Aug-2020.)
theorem icoreelrn {z: setvar} (A2 B2: class) (I: class z):
  $ wceq I (cima cico (cxp cr cr)) $ >
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wcel (crab z (wa (wbr A2 (cv z) cle) (wbr (cv z) B2 clt)) cr) I) $;

--| An element of an open interval is not its smallest element. (Contributed by ML, 2-Aug-2020.)
theorem iooelexlt {y1: setvar} (A2 B2 X: class):
  $ wi (wcel X (co A2 B2 cioo)) (wrex y1 (wbr (cv y1) X clt) (co A2 B2 cioo)) $;

--| The lower limit topology on the reals is finer than the standard topology. (Contributed by ML, 1-Aug-2020.)
theorem relowlssretop (I: class):
  $ wceq I (cima cico (cxp cr cr)) $ >
  $ wss (cfv (crn cioo) ctg) (cfv I ctg) $;

--| The lower limit topology on the reals is strictly finer than the standard topology. (Contributed by ML, 2-Aug-2020.)
theorem relowlpssretop (I: class):
  $ wceq I (cima cico (cxp cr cr)) $ >
  $ wpss (cfv (crn cioo) ctg) (cfv I ctg) $;

--| Inequality of an ordinal set with its successor. Does not use the axiom of regularity. (Contributed by ML, 18-Oct-2020.)
theorem sucneqond (ph: wff) (X Y: class):
  $ wi ph (wceq X (csuc Y)) $ >
  $ wi ph (wcel Y con0) $ >
  $ wi ph (wne X Y) $;

--| Inequality of an ordinal set with its successor. Does not use the axiom of regularity. (Contributed by ML, 18-Oct-2020.)
theorem sucneqoni (X Y: class):
  $ wceq X (csuc Y) $ >
  $ wcel Y con0 $ >
  $ wne X Y $;

--| If an ordinal number has a predecessor, then it is successor of that predecessor. (Contributed by ML, 17-Oct-2020.)
theorem onsucuni3 (B2: class):
  $ wi (w3a (wcel B2 con0) (wne B2 c0) (wn (wlim B2))) (wceq B2 (csuc (cuni B2))) $;

--| The ordinal number ` 1o ` is the predecessor of the ordinal number ` 2o ` . (Contributed by ML, 19-Oct-2020.)
theorem _1oequni2o:
  $ wceq c1o (cuni c2o) $;

--| If an ordinal number has a predecessor, the value of the recursive definition generator at that number in terms of its predecessor. (Contributed by ML, 17-Oct-2020.)
theorem rdgsucuni (B2 F I: class):
  $ wi (w3a (wcel B2 con0) (wne B2 c0) (wn (wlim B2))) (wceq (cfv B2 (crdg F I)) (cfv (cfv (cuni B2) (crdg F I)) F)) $;

--| If a recursive function with an initial value ` A ` at step ` N ` is equal to itself with an initial value ` B ` at step ` M ` , then every finite number of successor steps will also be equal. (Contributed by ML, 21-Oct-2020.)
theorem rdgeqoa (A2 B2 F M N X: class):
  $ wi (w3a (wcel N con0) (wcel M con0) (wcel X com)) (wi (wceq (cfv N (crdg F A2)) (cfv M (crdg F B2))) (wceq (cfv (co N X coa) (crdg F A2)) (cfv (co M X coa) (crdg F B2)))) $;

--| Membership in a Cartesian product. This version requires no quantifiers or dummy variables. See also ~ elxp7 . (Contributed by ML, 19-Oct-2020.)
theorem elxp8 (A2 B2 C: class):
  $ wb (wcel A2 (cxp B2 C)) (wa (wcel (cfv A2 c1st) B2) (wcel A2 (cxp cvv C))) $;

--| Deduction used to change bound variables in an existential uniqueness quantifier, using implicit substitution. (Contributed by ML, 27-Mar-2021.)
theorem cbveud {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wi ph (wnf y1 ps) $ >
  $ wi ph (wnf x3 ch) $ >
  $ wi ph (wi (wceq (cv x3) (cv y1)) (wb ps ch)) $ >
  $ wi ph (wb (weu x3 ps) (weu y1 ch)) $;

--| Deduction used to change bound variables in a restricted existential uniqueness quantifier. (Contributed by ML, 27-Mar-2021.)
theorem cbvreud {x3 y1: setvar} (ph ps ch: wff x3 y1) (A2: class):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wi ph (wnf y1 ps) $ >
  $ wi ph (wnf x3 ch) $ >
  $ wi ph (wi (wceq (cv x3) (cv y1)) (wb ps ch)) $ >
  $ wi ph (wb (wreu x3 ps A2) (wreu y1 ch A2)) $;

--| The difference of unions is a subset of the union of the difference. (Contributed by ML, 29-Mar-2021.)
theorem difunieq (A2 B2: class):
  $ wss (cdif (cuni A2) (cuni B2)) (cuni (cdif A2 B2)) $;

--| Theorem about subsets of the difference of unions. (Contributed by ML, 29-Mar-2021.)
theorem inunissunidif (A2 B2 C: class):
  $ wi (wceq (cin A2 (cuni C)) c0) (wb (wss A2 (cuni B2)) (wss A2 (cuni (cdif B2 C)))) $;

--| Elementhood in a recursive definition at a limit ordinal. (Contributed by ML, 30-Mar-2022.)
theorem rdgellim (A2 B2 C F X: class):
  $ wi (wa (wa (wcel B2 con0) (wlim B2)) (wcel C B2)) (wi (wcel X (cfv C (crdg F A2))) (wcel X (cfv B2 (crdg F A2)))) $;

--| A recursive definition at a limit ordinal is a superset of itself at any smaller ordinal. (Contributed by ML, 30-Mar-2022.)
theorem rdglimss (A2 B2 C F: class):
  $ wi (wa (wa (wcel B2 con0) (wlim B2)) (wcel C B2)) (wss (cfv C (crdg F A2)) (cfv B2 (crdg F A2))) $;

--| In a recursive definition where each step expands on the previous one using a union, every previous step is a subset of every later step. (Contributed by ML, 1-Apr-2022.)
theorem rdgssun {w: setvar} (A2: class) (B2 F X: class w) (Y: class):
  $ wceq F (cmpt w cvv (cun (cv w) B2)) $ >
  $ wcel B2 cvv $ >
  $ wi (wa (wcel X con0) (wcel Y X)) (wss (cfv Y (crdg F A2)) (cfv X (crdg F A2))) $;

--| Lemma for ~ exrecfn . (Contributed by ML, 30-Mar-2022.)
theorem exrecfnlem {x3 y1 z: setvar} (A2: class) (B2: class y1) (F: class y1 z) (V: class x3 y1 z) (W: class x3 z):
  $ wceq F (cmpt z cvv (cun (cv z) (crn (cmpt y1 (cv z) B2)))) $ >
  $ wi (wa (wcel A2 V) (wal y1 (wcel B2 W))) (wex x3 (wa (wss A2 (cv x3)) (wral y1 (wcel B2 (cv x3)) (cv x3)))) $;

--| Theorem about the existence of infinite recursive sets. ` y ` should usually be free in ` B ` . (Contributed by ML, 30-Mar-2022.)
theorem exrecfn {x3 y1: setvar} (A2: class) (B2: class y1) (V: class x3 y1) (W: class x3):
  $ wi (wa (wcel A2 V) (wal y1 (wcel B2 W))) (wex x3 (wa (wss A2 (cv x3)) (wral y1 (wcel B2 (cv x3)) (cv x3)))) $;

--| For any base set, a set which contains the powerset of all of its own elements exists. (Contributed by ML, 30-Mar-2022.)
theorem exrecfnpw {x3 y1: setvar} (A2: class) (V: class x3 y1):
  $ wi (wcel A2 V) (wex x3 (wa (wss A2 (cv x3)) (wral y1 (wcel (cpw (cv y1)) (cv x3)) (cv x3)))) $;

--| If the Axiom of Infinity is denied, every total order is a well-order. The notion of a well-order cannot be usefully expressed without the Axiom of Infinity due to the inability to quantify over proper classes. (Contributed by ML, 5-Oct-2023.)
theorem finorwe (A2 c_lt: class):
  $ wi (wn (wcel com cvv)) (wi (wor A2 c_lt) (wwe A2 c_lt)) $;

--| Extend the definition of a class to include Cartesian exponentiation.
term cfinxp (U N: class): class;

--| Define Cartesian exponentiation on a class. Note that this definition is limited to finite exponents, since it is defined using nested ordered pairs. If tuples of infinite length are needed, or if they might be needed in the future, use ~ df-ixp or ~ df-map instead. The main advantage of this definition is that it integrates better with functions and relations. For example if ` R ` is a subset of ` ( A ^^ 2o ) ` , then ~ df-br can be used on it, and ~ df-fv can also be used, and so on. It's also worth keeping in mind that ` ( ( U ^^ M ) X. ( U ^^ N ) ) ` is generally not equal to ` ( U ^^ ( M +o N ) ) ` . This definition is technical. Use ~ finxp1o and ~ finxpsuc for a more standard recursive experience. (Contributed by ML, 16-Oct-2020.)
axiom df_finxp {x3 y1 n: setvar} (U N: class):
  $ wceq (cfinxp U N) (cab y1 (wa (wcel N com) (wceq c0 (cfv N (crdg (cmpo n x3 com cvv (cif (wa (wceq (cv n) c1o) (wcel (cv x3) U)) c0 (cif (wcel (cv x3) (cxp cvv U)) (cop (cuni (cv n)) (cfv (cv x3) c1st)) (cop (cv n) (cv x3))))) (cop N (cv y1))))))) $;

--| This theorem is the same as Definition ~ df-finxp , except that the large function is replaced by a class variable for brevity. (Contributed by ML, 24-Oct-2020.)
theorem dffinxpf {x3 y1 n: setvar} (U: class) (F: class x3 y1 n) (N: class):
  $ wceq F (cmpo n x3 com cvv (cif (wa (wceq (cv n) c1o) (wcel (cv x3) U)) c0 (cif (wcel (cv x3) (cxp cvv U)) (cop (cuni (cv n)) (cfv (cv x3) c1st)) (cop (cv n) (cv x3))))) $ >
  $ wceq (cfinxp U N) (cab y1 (wa (wcel N com) (wceq c0 (cfv N (crdg F (cop N (cv y1))))))) $;

--| Equality theorem for Cartesian exponentiation. (Contributed by ML, 19-Oct-2020.)
theorem finxpeq1 (U N V: class):
  $ wi (wceq U V) (wceq (cfinxp U N) (cfinxp V N)) $;

--| Equality theorem for Cartesian exponentiation. (Contributed by ML, 19-Oct-2020.)
theorem finxpeq2 (U M N: class):
  $ wi (wceq M N) (wceq (cfinxp U M) (cfinxp U N)) $;

--| Distribute proper substitution through Cartesian exponentiation. (Contributed by ML, 25-Oct-2020.)
theorem csbfinxpg {x3: setvar} (A2 U: class x3) (N: class) (V: class x3):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (cfinxp U N)) (cfinxp (csb x3 A2 U) (csb x3 A2 N))) $;

--| Lemma for ` ^^ ` recursion theorems. (Contributed by ML, 17-Oct-2020.)
theorem finxpreclem1 {x3 n: setvar} (U X: class):
  $ wi (wcel X U) (wceq c0 (cfv (cop c1o X) (cmpo n x3 com cvv (cif (wa (wceq (cv n) c1o) (wcel (cv x3) U)) c0 (cif (wcel (cv x3) (cxp cvv U)) (cop (cuni (cv n)) (cfv (cv x3) c1st)) (cop (cv n) (cv x3))))))) $;

--| Lemma for ` ^^ ` recursion theorems. (Contributed by ML, 17-Oct-2020.)
theorem finxpreclem2 {x3 n: setvar} (U X: class):
  $ wi (wa (wcel X cvv) (wn (wcel X U))) (wn (wceq c0 (cfv (cop c1o X) (cmpo n x3 com cvv (cif (wa (wceq (cv n) c1o) (wcel (cv x3) U)) c0 (cif (wcel (cv x3) (cxp cvv U)) (cop (cuni (cv n)) (cfv (cv x3) c1st)) (cop (cv n) (cv x3)))))))) $;

--| The value of Cartesian exponentiation at zero. (Contributed by ML, 24-Oct-2020.)
theorem finxp0 (U: class):
  $ wceq (cfinxp U c0) c0 $;

--| The value of Cartesian exponentiation at one. (Contributed by ML, 17-Oct-2020.)
theorem finxp1o (U: class):
  $ wceq (cfinxp U c1o) U $;

--| Lemma for ` ^^ ` recursion theorems. (Contributed by ML, 20-Oct-2020.)
theorem finxpreclem3 {x3 n: setvar} (U: class) (F: class x3 n) (N X: class):
  $ wceq F (cmpo n x3 com cvv (cif (wa (wceq (cv n) c1o) (wcel (cv x3) U)) c0 (cif (wcel (cv x3) (cxp cvv U)) (cop (cuni (cv n)) (cfv (cv x3) c1st)) (cop (cv n) (cv x3))))) $ >
  $ wi (wa (wa (wcel N com) (wss c2o N)) (wcel X (cxp cvv U))) (wceq (cop (cuni N) (cfv X c1st)) (cfv (cop N X) F)) $;

--| Lemma for ` ^^ ` recursion theorems. (Contributed by ML, 23-Oct-2020.)
theorem finxpreclem4 {x3 n: setvar} (y1: setvar) (U: class) (F: class x3 n) (N: class):
  $ wceq F (cmpo n x3 com cvv (cif (wa (wceq (cv n) c1o) (wcel (cv x3) U)) c0 (cif (wcel (cv x3) (cxp cvv U)) (cop (cuni (cv n)) (cfv (cv x3) c1st)) (cop (cv n) (cv x3))))) $ >
  $ wi (wa (wa (wcel N com) (wss c2o N)) (wcel (cv y1) (cxp cvv U))) (wceq (cfv N (crdg F (cop N (cv y1)))) (cfv (cuni N) (crdg F (cop (cuni N) (cfv (cv y1) c1st))))) $;

--| Lemma for ` ^^ ` recursion theorems. (Contributed by ML, 24-Oct-2020.)
theorem finxpreclem5 {x3 n: setvar} (U F: class x3 n):
  $ wceq F (cmpo n x3 com cvv (cif (wa (wceq (cv n) c1o) (wcel (cv x3) U)) c0 (cif (wcel (cv x3) (cxp cvv U)) (cop (cuni (cv n)) (cfv (cv x3) c1st)) (cop (cv n) (cv x3))))) $ >
  $ wi (wa (wcel (cv n) com) (wcel c1o (cv n))) (wi (wn (wcel (cv x3) (cxp cvv U))) (wceq (cfv (cop (cv n) (cv x3)) F) (cop (cv n) (cv x3)))) $;

--| Lemma for ` ^^ ` recursion theorems. (Contributed by ML, 24-Oct-2020.)
theorem finxpreclem6 {x3 n: setvar} (U: class) (F: class x3 n) (N: class):
  $ wceq F (cmpo n x3 com cvv (cif (wa (wceq (cv n) c1o) (wcel (cv x3) U)) c0 (cif (wcel (cv x3) (cxp cvv U)) (cop (cuni (cv n)) (cfv (cv x3) c1st)) (cop (cv n) (cv x3))))) $ >
  $ wi (wa (wcel N com) (wcel c1o N)) (wss (cfinxp U N) (cxp cvv U)) $;

--| Lemma for ~ finxpsuc . (Contributed by ML, 24-Oct-2020.)
theorem finxpsuclem {x3 n: setvar} (U: class) (F: class x3 n) (N: class):
  $ wceq F (cmpo n x3 com cvv (cif (wa (wceq (cv n) c1o) (wcel (cv x3) U)) c0 (cif (wcel (cv x3) (cxp cvv U)) (cop (cuni (cv n)) (cfv (cv x3) c1st)) (cop (cv n) (cv x3))))) $ >
  $ wi (wa (wcel N com) (wss c1o N)) (wceq (cfinxp U (csuc N)) (cxp (cfinxp U N) U)) $;

--| The value of Cartesian exponentiation at a successor. (Contributed by ML, 24-Oct-2020.)
theorem finxpsuc (U N: class):
  $ wi (wa (wcel N com) (wne N c0)) (wceq (cfinxp U (csuc N)) (cxp (cfinxp U N) U)) $;

--| The value of Cartesian exponentiation at two. (Contributed by ML, 19-Oct-2020.)
theorem finxp2o (U: class):
  $ wceq (cfinxp U c2o) (cxp U U) $;

--| The value of Cartesian exponentiation at three. (Contributed by ML, 24-Oct-2020.)
theorem finxp3o (U: class):
  $ wceq (cfinxp U c3o) (cxp (cxp U U) U) $;

--| Cartesian exponentiation when the exponent is not a natural number defaults to the empty set. (Contributed by ML, 24-Oct-2020.)
theorem finxpnom (U N: class):
  $ wi (wn (wcel N com)) (wceq (cfinxp U N) c0) $;

--| Cartesian exponentiation of the empty set to any power is the empty set. (Contributed by ML, 24-Oct-2020.)
theorem finxp00 (N: class):
  $ wceq (cfinxp c0 N) c0 $;

--| Using the axiom of countable choice ~ ax-cc , the countable union of countable sets is countable. See ~ iunctb for a somewhat more general theorem. (Contributed by ML, 10-Dec-2020.)
theorem iunctb2 {x3: setvar} (B2: class x3):
  $ wi (wral x3 (wbr B2 com cdom) com) (wbr (ciun x3 com B2) com cdom) $;

--| A class which dominates every natural number is not finite. (Contributed by ML, 14-Dec-2020.)
theorem domalom {n: setvar} (A2: class):
  $ wi (wral n (wbr (cv n) A2 cdom) com) (wn (wcel A2 cfn)) $;

--| The converse of ~ isinf . Any set that is not finite is literally infinite, in the sense that it contains subsets of arbitrarily large finite cardinality. (It cannot be proven that the set has _countably infinite_ subsets unless AC is invoked.) The proof does not require the Axiom of Infinity. (Contributed by ML, 14-Dec-2020.)
theorem isinf2 {x3 n: setvar} (A2: class):
  $ wi (wral n (wex x3 (wa (wss (cv x3) A2) (wbr (cv x3) (cv n) cen))) com) (wn (wcel A2 cfn)) $;

--| Using the axiom of choice, any infinite class has a countable subset. (Contributed by ML, 14-Dec-2020.)
theorem ctbssinf {x3: setvar} (A2: class):
  $ wi (wn (wcel A2 cfn)) (wex x3 (wa (wss (cv x3) A2) (wbr (cv x3) com cen))) $;

--| The index set of an indexed union is a subset of the union when each ` B ` contains its index. (Contributed by ML, 16-Dec-2020.)
theorem ralssiun {x3: setvar} (A2: class) (B2: class x3):
  $ wi (wral x3 (wcel (cv x3) B2) A2) (wss A2 (ciun x3 A2 B2)) $;

--| For every point ` p ` of a subset ` A ` of ` X ` with no limit points, there exists an open set ` n ` that intersects ` A ` only at ` p ` . (Contributed by ML, 23-Mar-2021.)
theorem nlpineqsn {n p: setvar} (A2 J X: class):
  $ wceq X (cuni J) $ >
  $ wi (w3a (wcel J ctop) (wss A2 X) (wceq (cfv A2 (cfv J clp)) c0)) (wral p (wrex n (wa (wcel (cv p) (cv n)) (wceq (cin (cv n) A2) (csn (cv p)))) J) A2) $;

--| Given a subset ` A ` of ` X ` with no limit points, there exists a function from each point ` p ` of ` A ` to an open set intersecting ` A ` only at ` p ` . This proof uses the axiom of choice. (Contributed by ML, 23-Mar-2021.) Remove dependency on ~ ax-reg and ~ ax-inf2 . (Revised by Timothy J. O'Malley, 15-Oct-2026.)
theorem nlpfvineqsn {f2 p: setvar} (A2 J: class) (V: class f2 p) (X: class f2):
  $ wceq X (cuni J) $ >
  $ wi (wcel A2 V) (wi (w3a (wcel J ctop) (wss A2 X) (wceq (cfv A2 (cfv J clp)) c0)) (wex f2 (wa (wf A2 J (cv f2)) (wral p (wceq (cin (cfv (cv p) (cv f2)) A2) (csn (cv p))) A2)))) $;

--| A theorem about functions where the image of every point intersects the domain only at that point. If ` J ` is a topology and ` A ` is a set with no limit points, then there exists an ` F ` such that this antecedent is true. See ~ nlpfvineqsn for a proof of this fact. (Contributed by ML, 23-Mar-2021.)
theorem fvineqsnf1 {p: setvar} (A2 F: class) (J: class p):
  $ wi (wa (wf A2 J F) (wral p (wceq (cin (cfv (cv p) F) A2) (csn (cv p))) A2)) (wf1 A2 J F) $;

--| A theorem about functions where the image of every point intersects the domain only at that point. (Contributed by ML, 27-Mar-2021.)
theorem fvineqsneu {x3 q p: setvar} (A2 F: class):
  $ wi (wa (wfn F A2) (wral p (wceq (cin (cfv (cv p) F) A2) (csn (cv p))) A2)) (wral q (wreu x3 (wcel (cv q) (cv x3)) (crn F)) A2) $;

--| A theorem about functions where the image of every point intersects the domain only at that point. (Contributed by ML, 27-Mar-2021.)
theorem fvineqsneu_b {x3 q: setvar} (A2 F: class):
  $ wi (wa (wfn F A2) (wral q (wceq (cin (cfv (cv q) F) A2) (csn (cv q))) A2)) (wral q (wreu x3 (wcel (cv q) (cv x3)) (crn F)) A2) $;

--| A theorem about functions where the image of every point intersects the domain only at that point. (Contributed by ML, 28-Mar-2021.)
theorem fvineqsneq {p: setvar} (A2 F Z: class):
  $ wi (wa (wa (wfn F A2) (wral p (wceq (cin (cfv (cv p) F) A2) (csn (cv p))) A2)) (wa (wss Z (crn F)) (wss A2 (cuni Z)))) (wceq Z (crn F)) $;

--| Property P000016 of pi-base. The class of compact topologies. A space ` X ` is compact if every open cover of ` X ` has a finite subcover. This theorem is just a relabeled copy of ~ iscmp . (Contributed by ML, 8-Dec-2020.)
theorem pibp16 {y1 z: setvar} (J: class) (X: class y1 z):
  $ wceq X (cuni J) $ >
  $ wb (wcel J ccmp) (wa (wcel J ctop) (wral y1 (wi (wceq X (cuni (cv y1))) (wrex z (wceq X (cuni (cv z))) (cin (cpw (cv y1)) cfn))) (cpw J))) $;

--| Property P000019 of pi-base. The class of countably compact topologies. A space ` X ` is countably compact if every countable open cover of ` X ` has a finite subcover. (Contributed by ML, 8-Dec-2020.)
theorem pibp19 {x3 y1 z: setvar} (C: class x3 y1 z) (J: class) (X: class y1 z):
  $ wceq X (cuni J) $ >
  $ wceq C (crab x3 (wral y1 (wi (wa (wceq (cuni (cv x3)) (cuni (cv y1))) (wbr (cv y1) com cdom)) (wrex z (wceq (cuni (cv x3)) (cuni (cv z))) (cin (cpw (cv y1)) cfn))) (cpw (cv x3))) ctop) $ >
  $ wb (wcel J C) (wa (wcel J ctop) (wral y1 (wi (wa (wceq X (cuni (cv y1))) (wbr (cv y1) com cdom)) (wrex z (wceq X (cuni (cv z))) (cin (cpw (cv y1)) cfn))) (cpw J))) $;

--| Property P000021 of pi-base. The class of weakly countably compact topologies, or limit point compact topologies. A space ` X ` is weakly countably compact if every infinite subset of ` X ` has a limit point. (Contributed by ML, 9-Dec-2020.)
theorem pibp21 {x3 y1 z: setvar} (J: class) (W: class x3 y1 z) (X: class):
  $ wceq X (cuni J) $ >
  $ wceq W (crab x3 (wral y1 (wrex z (wcel (cv z) (cfv (cv y1) (cfv (cv x3) clp))) (cuni (cv x3))) (cdif (cpw (cuni (cv x3))) cfn)) ctop) $ >
  $ wb (wcel J W) (wa (wcel J ctop) (wral y1 (wrex z (wcel (cv z) (cfv (cv y1) (cfv J clp))) X) (cdif (cpw X) cfn))) $;

--| Theorem T000001 of pi-base. A compact topology is also countably compact. See ~ pibp16 and ~ pibp19 for the definitions of the relevant properties. (Contributed by ML, 8-Dec-2020.)
theorem pibt1 {x3 y1 z: setvar} (C: class x3 y1 z) (J: class):
  $ wceq C (crab x3 (wral y1 (wi (wa (wceq (cuni (cv x3)) (cuni (cv y1))) (wbr (cv y1) com cdom)) (wrex z (wceq (cuni (cv x3)) (cuni (cv z))) (cin (cpw (cv y1)) cfn))) (cpw (cv x3))) ctop) $ >
  $ wi (wcel J ccmp) (wcel J C) $;

--| Theorem T000002 of pi-base, a countably compact topology is also weakly countably compact. See ~ pibp19 and ~ pibp21 for the definitions of the relevant properties. This proof uses the axiom of choice. (Contributed by ML, 30-Mar-2021.) Remove dependency on ~ ax-reg . (Revised by Timothy J. O'Malley, 15-Oct-2026.)
theorem pibt2 {x3 y1 z: setvar} (C: class x3 y1 z) (J: class) (W: class x3 y1 z) (X: class):
  $ wceq X (cuni J) $ >
  $ wceq C (crab x3 (wral y1 (wi (wa (wceq (cuni (cv x3)) (cuni (cv y1))) (wbr (cv y1) com cdom)) (wrex z (wceq (cuni (cv x3)) (cuni (cv z))) (cin (cpw (cv y1)) cfn))) (cpw (cv x3))) ctop) $ >
  $ wceq W (crab x3 (wral y1 (wrex z (wcel (cv z) (cfv (cv y1) (cfv (cv x3) clp))) (cuni (cv x3))) (cdif (cpw (cuni (cv x3))) cfn)) ctop) $ >
  $ wi (wcel J C) (wcel J W) $;

--| Intuitionistic logic is now developed separately, so we need not first focus on intuitionally valid axioms ~ ax-1 and ~ ax-2 any longer. Alternatively, I start from Jan Lukasiewicz's axiom system here, i.e., ~ ax-mp , ~ ax-luk1 , ~ ax-luk2 and ~ ax-luk3 . I rather copy this system than use ~ luk-1 to ~ luk-3 , since the latter are theorems, while we need axioms here. (Contributed by Wolf Lammen, 23-Feb-2018.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_section_prop (ph: wff):
  $ ph $ >
  $ ph $;

--| 1 of 3 axioms for propositional calculus due to Lukasiewicz. Copy of ~ luk-1 and ~ imim1 , but introduced as an axiom. It focuses on a basic property of a valid implication, namely that the consequent has to be true whenever the antecedent is. So if ` ph ` and ` ps ` are somehow parametrized expressions, then ` ph -> ps ` states that ` ph ` strengthen ` ps ` , in that ` ph ` holds only for a (often proper) subset of those parameters making ` ps ` true. We easily accept, that when ` ps ` is stronger than ` ch ` and, at the same time ` ph ` is stronger than ` ps ` , then ` ph ` must be stronger than ` ch ` . This transitivity is expressed in this axiom. A particular result of this strengthening property comes into play if the antecedent holds unconditionally. Then the consequent must hold unconditionally as well. This specialization is the foundational idea behind logical conclusion. Such conclusion is best expressed in so-called immediate versions of this axiom like ~ imim1i or ~ syl . Note that these forms are weaker replacements (i.e. just frequent specialization) of the closed form presented here, hence a mere convenience. We can identify in this axiom up to three antecedents, followed by a consequent. The number of antecedents is not really fixed; the fewer we are willing to "see", the more complex the consequent grows. On the other side, since ` ch ` is a variable capable of assuming an implication itself, we might find even more antecedents after some substitution of ` ch ` . This shows that the ideas of antecedent and consequent in expressions like this depends on, and can adapt to, our current interpretation of the whole expression. In this axiom, up to two antecedents happen to be of complex nature themselves, i.e. are an embedded implication. Logically, this axiom is a compact notion of simpler expressions, which I will later coin implication chains. Herein all antecedents and the consequent appear as simple variables, or their negation. Any propositional expression is equivalent to a set of such chains. This axiom, for example, is dissected into following chains, from which it can be recovered losslessly: ` ( ps -> ( ch -> ( ph -> ch ) ) ) ` ; ` ( -. ph -> ( ch -> ( ph -> ch ) ) ) ` ; ` ( ps -> ( -. ps -> ( ph -> ch ) ) ) ` ; ` ( -. ph -> ( -. ps -> ( ph -> ch ) ) ) ` . (Contributed by Wolf Lammen, 17-Dec-2018.) (New usage is discouraged.)
axiom ax_luk1 (ph ps ch: wff):
  $ wi (wi ph ps) (wi (wi ps ch) (wi ph ch)) $;

--| 2 of 3 axioms for propositional calculus due to Lukasiewicz. Copy of ~ luk-2 or ~ pm2.18 , but introduced as an axiom. The core idea behind this axiom is, that if something can be implied from both an antecedent, and separately from its negation, then the antecedent is irrelevant to the consequent, and can safely be dropped. This is perhaps better seen from the following slightly extended version (related to ~ pm2.65 ): ` ( ( ph -> ph ) -> ( ( -. ph -> ph ) -> ph ) ) ` . (Contributed by Wolf Lammen, 17-Dec-2018.) (New usage is discouraged.)
axiom ax_luk2 (ph: wff):
  $ wi (wi (wn ph) ph) ph $;

--| 3 of 3 axioms for propositional calculus due to Lukasiewicz. Copy of ~ luk-3 and ~ pm2.24 , but introduced as an axiom. One might think that the similar ~ pm2.21 ` ( -. ph -> ( ph -> ps ) ) ` is a valid replacement for this axiom. But this is not true, ~ ax-3 is not derivable from this modification. This can be shown by designing carefully operators ` -. ` and ` -> ` on a finite set of primitive statements. In propositional logic such statements are ` T. ` and ` F. ` , but we can assume more and other primitives in our universe of statements. So we denote our primitive statements as phi0 , phi1 and phi2. The actual meaning of the statements are not important in this context, it rather counts how they behave under our operations ` -. ` and ` -> ` , and which of them we assume to hold unconditionally (phi1, phi2). For our disproving model, I give that information in tabular form below. The interested reader may check by hand, that all possible interpretations of ~ ax-mp , ~ ax-luk1 , ~ ax-luk2 and ~ pm2.21 result in phi1 or phi2, meaning they always hold. But for ~ wl-luk-ax3 we can find a counter example resulting in phi0, not a statement always true. The verification of a particular set of axioms in a given model is tedious and error prone, so I wrote a computer program, first checking this for me, and second, hunting for a counter example. Here is the result, after 9165 fruitlessly computer generated models: <HTML> <br><br> ax-3 fails for phi2, phi2<br> number of statements: 3<br> always true phi1 phi2 <br><br> Negation is defined as<br> ---------------------------------------------------------------------- <table border="1"> <tr><td>-. phi0</td><td>-. phi1</td><td>-. phi2</td></tr> <tr><td>phi1</td><td>phi0</td><td>phi1</td></tr></table> <br> Implication is defined as<br> ---------------------------------------------------------------------- <table border=1> <tr><td>p->q</td><td>q: phi0</td><td>q: phi1</td><td>q: phi2</td></tr> <tr><td>p: phi0</td><td>phi1</td><td>phi1</td><td>phi1</td></tr> <tr><td>p: phi1</td><td>phi0</td><td>phi1</td><td>phi1</td></tr> <tr><td>p: phi2</td><td>phi0</td><td>phi0</td><td>phi0</td></tr> </table><br></HTML> (Contributed by Wolf Lammen, 17-Dec-2018.) (New usage is discouraged.)
axiom ax_luk3 (ph ps: wff):
  $ wi ph (wi (wn ph) ps) $;

--| In this section, I provide the first steps needed for convenient proving. The presented theorems follow no common concept other than being useful in themselves, and apt to rederive ~ ax-1 , ~ ax-2 and ~ ax-3 . (Contributed by Wolf Lammen, 17-Dec-2018.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_section_boot (ph: wff):
  $ ph $ >
  $ ph $;

--| Inference adding common consequents in an implication, thereby interchanging the original antecedent and consequent. Copy of ~ imim1i with a different proof. (Contributed by Wolf Lammen, 17-Dec-2018.)
theorem wl_luk_imim1i (ph ps ch: wff):
  $ wi ph ps $ >
  $ wi (wi ps ch) (wi ph ch) $;

--| An inference version of the transitive laws for implication ~ luk-1 . Copy of ~ syl with a different proof. (Contributed by Wolf Lammen, 17-Dec-2018.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_luk_syl (ph ps ch: wff):
  $ wi ph ps $ >
  $ wi ps ch $ >
  $ wi ph ch $;

--| A syllogism rule of inference. The first premise is used to replace the second antecedent of the second premise. Copy of ~ syl5 with a different proof. (Contributed by Wolf Lammen, 17-Dec-2018.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_luk_imtrid (ph ps ch th: wff):
  $ wi ph ps $ >
  $ wi ch (wi ps th) $ >
  $ wi ch (wi ph th) $;

--| Deduction based on reductio ad absurdum. Copy of ~ pm2.18d with a different proof. (Contributed by Wolf Lammen, 17-Dec-2018.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_luk_pm2_18d (ph ps: wff):
  $ wi ph (wi (wn ps) ps) $ >
  $ wi ph ps $;

--| Inference rule. Copy of ~ con4i with a different proof. (Contributed by Wolf Lammen, 17-Dec-2018.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_luk_con4i (ph ps: wff):
  $ wi (wn ph) (wn ps) $ >
  $ wi ps ph $;

--| Inference rule. Copy of ~ pm2.24i with a different proof. (Contributed by Wolf Lammen, 17-Dec-2018.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_luk_pm2_24i (ph ps: wff):
  $ ph $ >
  $ wi (wn ph) ps $;

--| Inference rule. Copy of ~ a1i with a different proof. (Contributed by Wolf Lammen, 17-Dec-2018.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_luk_a1i (ph ps: wff):
  $ ph $ >
  $ wi ps ph $;

--| A nested _modus ponens_ inference. Copy of ~ mpi with a different proof. (Contributed by Wolf Lammen, 17-Dec-2018.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_luk_mpi (ph ps ch: wff):
  $ ps $ >
  $ wi ph (wi ps ch) $ >
  $ wi ph ch $;

--| Inference adding common antecedents in an implication. Copy of ~ imim2i with a different proof. (Contributed by Wolf Lammen, 17-Dec-2018.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_luk_imim2i (ph ps ch: wff):
  $ wi ph ps $ >
  $ wi (wi ch ph) (wi ch ps) $;

--| A syllogism rule of inference. The second premise is used to replace the consequent of the first premise. Copy of ~ syl6 with a different proof. (Contributed by Wolf Lammen, 17-Dec-2018.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_luk_imtrdi (ph ps ch th: wff):
  $ wi ph (wi ps ch) $ >
  $ wi ch th $ >
  $ wi ph (wi ps th) $;

--| ~ ax-3 proved from Lukasiewicz's axioms. (Contributed by Wolf Lammen, 17-Dec-2018.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_luk_ax3 (ph ps: wff):
  $ wi (wi (wn ph) (wn ps)) (wi ps ph) $;

--| ~ ax-1 proved from Lukasiewicz's axioms. (Contributed by Wolf Lammen, 17-Dec-2018.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_luk_ax1 (ph ps: wff):
  $ wi ph (wi ps ph) $;

--| This theorem, called "Assertion", can be thought of as closed form of _modus ponens_ ~ ax-mp . Theorem *2.27 of [WhiteheadRussell] p. 104. Copy of ~ pm2.27 with a different proof. (Contributed by Wolf Lammen, 17-Dec-2018.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_luk_pm2_27 (ph ps: wff):
  $ wi ph (wi (wi ph ps) ps) $;

--| Inference that swaps (commutes) antecedents in an implication. Copy of ~ com12 with a different proof. (Contributed by Wolf Lammen, 17-Dec-2018.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_luk_com12 (ph ps ch: wff):
  $ wi ph (wi ps ch) $ >
  $ wi ps (wi ph ch) $;

--| From a wff and its negation, anything follows. Theorem *2.21 of [WhiteheadRussell] p. 104. Also called the Duns Scotus law. Copy of ~ pm2.21 with a different proof. (Contributed by Wolf Lammen, 17-Dec-2018.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_luk_pm2_21 (ph ps: wff):
  $ wi (wn ph) (wi ph ps) $;

--| A contraposition inference. Copy of ~ con1i with a different proof. (Contributed by Wolf Lammen, 17-Dec-2018.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_luk_con1i (ph ps: wff):
  $ wi (wn ph) ps $ >
  $ wi (wn ps) ph $;

--| Inference joining the antecedents of two premises. Copy of ~ ja with a different proof. (Contributed by Wolf Lammen, 17-Dec-2018.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_luk_ja (ph ps ch: wff):
  $ wi (wn ph) ch $ >
  $ wi ps ch $ >
  $ wi (wi ph ps) ch $;

--| A closed form of syllogism (see ~ syl ). Theorem *2.05 of [WhiteheadRussell] p. 100. Copy of ~ imim2 with a different proof. (Contributed by Wolf Lammen, 17-Dec-2018.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_luk_imim2 (ph ps ch: wff):
  $ wi (wi ph ps) (wi (wi ch ph) (wi ch ps)) $;

--| Deduction introducing an embedded antecedent. Copy of ~ imim2 with a different proof. (Contributed by Wolf Lammen, 17-Dec-2018.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_luk_a1d (ph ps ch: wff):
  $ wi ph ps $ >
  $ wi ph (wi ch ps) $;

--| ~ ax-2 proved from Lukasiewicz's axioms. (Contributed by Wolf Lammen, 17-Dec-2018.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_luk_ax2 (ph ps ch: wff):
  $ wi (wi ph (wi ps ch)) (wi (wi ph ps) (wi ph ch)) $;

--| Principle of identity. Theorem *2.08 of [WhiteheadRussell] p. 101. Copy of ~ id with a different proof. (Contributed by Wolf Lammen, 17-Dec-2018.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_luk_id (ph: wff):
  $ wi ph ph $;

--| Converse of double negation. Theorem *2.14 of [WhiteheadRussell] p. 102. In classical logic (our logic) this is always true. In intuitionistic logic this is not always true; in intuitionistic logic, when this is true for some ` ph ` , then ` ph ` is stable. Copy of ~ notnotr with a different proof. (Contributed by Wolf Lammen, 17-Dec-2018.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_luk_notnotr (ph: wff):
  $ wi (wn (wn ph)) ph $;

--| Swap antecedents. Theorem *2.04 of [WhiteheadRussell] p. 100. This was the third axiom in Frege's logic system, specifically Proposition 8 of [Frege1879] p. 35. Copy of ~ pm2.04 with a different proof. (Contributed by Wolf Lammen, 7-Jul-2019.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_luk_pm2_04 (ph ps ch: wff):
  $ wi (wi ph (wi ps ch)) (wi ps (wi ph ch)) $;

--| An implication like ` ( ps -> ph ) ` with one antecedent can easily be extended by prepending more and more antecedents, as in ` ( ch -> ( ps -> ph ) ) ` or ` ( th -> ( ch -> ( ps -> ph ) ) ) ` . I call these expressions implication chains, and the number of antecedents (number of nodes minus one) denotes their length. A given length often marks just a required minimum value, since the consequent ` ph ` itself may represent an implication, or even an implication chain, such hiding part of the whole chain. As an extension, it is useful to consider a single variable ` ph ` as a degenerate implication chain of length zero. Implication chains play a particular role in logic, as all propositional expressions turn out to be convertible to one or more implication chains, their nodes as simple as a variable, or its negation. So there is good reason to focus on implication chains as a sort of normalized expressions, and build some general theorems around them, with proofs using recursive patterns. This allows for theorems referring to longer and longer implication chains in an automated way. The theorem names in this section contain the text fragment 'impchain' to point out their relevance to implication chains, followed by a number indicating the (minimal) length of the longest chain involved. (Contributed by Wolf Lammen, 6-Jul-2019.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_section_impchain (ph: wff):
  $ ph $ >
  $ ph $;

--| This series of theorems provide a means of exchanging the consequent of an implication chain via a simple implication. In the main part, Theorems ~ ax-mp , ~ syl , ~ syl6 , ~ syl8 form the beginning of this series. These theorems are replicated here, but with proofs that aim at a recursive scheme, allowing to base a proof on that of the previous one in the series. (Contributed by Wolf Lammen, 17-Nov-2019.)
theorem wl_impchain_mp_x:
  $ wtru $;

--| This theorem is the start of a proof recursion scheme where we replace the consequent of an implication chain. The number '0' in the theorem name indicates that the modified chain has no antecedents. This theorem is in fact a copy of ~ ax-mp , and is repeated here to emphasize the recursion using similar theorem names. (Contributed by Wolf Lammen, 6-Jul-2019.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_impchain_mp_0 (ph ps: wff):
  $ ps $ >
  $ wi ps ph $ >
  $ ph $;

--| This theorem is in fact a copy of ~ wl-luk-syl , and repeated here to demonstrate a recursive proof scheme. The number '1' in the theorem name indicates that a chain of length 1 is modified. (Contributed by Wolf Lammen, 6-Jul-2019.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_impchain_mp_1 (ph ps ch: wff):
  $ wi ch ps $ >
  $ wi ps ph $ >
  $ wi ch ph $;

--| This theorem is in fact a copy of ~ wl-luk-imtrdi , and repeated here to demonstrate a recursive proof scheme. The number '2' in the theorem name indicates that a chain of length 2 is modified. (Contributed by Wolf Lammen, 6-Jul-2019.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_impchain_mp_2 (ph ps ch th: wff):
  $ wi th (wi ch ps) $ >
  $ wi ps ph $ >
  $ wi th (wi ch ph) $;

--| It is often convenient to have the antecedent under focus in first position, so we can apply immediate theorem forms (as opposed to deduction, tautology form). This series of theorems swaps the first with the last antecedent in an implication chain. This kind of swapping is self-inverse, whence we prefer it over, say, rotating theorems. A consequent can hide a tail of a longer chain, so theorems of this series appear as swapping a pair of antecedents with fixed offsets. This form of swapping antecedents is flexible enough to allow for any permutation of antecedents in an implication chain. The first elements of this series correspond to ~ com12 , ~ com13 , ~ com14 and ~ com15 in the main part. The proofs of this series aim at automated proving using a simple recursive scheme. It employs the previous theorem in the series along with a sample from the ~ wl-impchain-mp-x series developed before. (Contributed by Wolf Lammen, 17-Nov-2019.)
theorem wl_impchain_com_1_x:
  $ wtru $;

--| A degenerate form of antecedent swapping. The number '1' in the theorem name indicates that it handles a chain of length 1. Since there is just one antecedent in the chain, there is nothing to swap. Nondegenerated forms begin with ~ wl-impchain-com-1.2 , for more see there. (Contributed by Wolf Lammen, 7-Jul-2019.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_impchain_com_1_1 (ph ps: wff):
  $ wi ps ph $ >
  $ wi ps ph $;

--| This theorem is in fact a copy of ~ wl-luk-com12 , and repeated here to demonstrate a simple proof scheme. The number '2' in the theorem name indicates that a chain of length 2 is modified. See ~ wl-impchain-com-1.x for more information how this proof is generated. (Contributed by Wolf Lammen, 7-Jul-2019.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_impchain_com_1_2 (ph ps ch: wff):
  $ wi ch (wi ps ph) $ >
  $ wi ps (wi ch ph) $;

--| This theorem is in fact a copy of ~ com13 , and repeated here to demonstrate a simple proof scheme. The number '3' in the theorem name indicates that a chain of length 3 is modified. See ~ wl-impchain-com-1.x for more information how this proof is generated. (Contributed by Wolf Lammen, 7-Jul-2019.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_impchain_com_1_3 (ph ps ch th: wff):
  $ wi th (wi ch (wi ps ph)) $ >
  $ wi ps (wi ch (wi th ph)) $;

--| This theorem is in fact a copy of ~ com14 , and repeated here to demonstrate a simple proof scheme. The number '4' in the theorem name indicates that a chain of length 4 is modified. See ~ wl-impchain-com-1.x for more information how this proof is generated. (Contributed by Wolf Lammen, 7-Jul-2019.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_impchain_com_1_4 (ph ps ch th et: wff):
  $ wi et (wi th (wi ch (wi ps ph))) $ >
  $ wi ps (wi th (wi ch (wi et ph))) $;

--| This series of theorems allow swapping any two antecedents in an implication chain. The theorem names follow a pattern wl-impchain-com-n.m with integral numbers n < m, that swaps the m-th antecedent with n-th one in an implication chain. It is sufficient to restrict the length of the chain to m, too, since the consequent can be assumed to be the tail right of the m-th antecedent of any arbitrary sized implication chain. We further assume n > 1, since the ~ wl-impchain-com-1.x series already covers the special case n = 1. Being able to swap any two antecedents in an implication chain lays the foundation of permuting its antecedents arbitrarily. The proofs of this series aim at automated proofing using a simple scheme. Any instance of this series is a triple step of swapping the first and n-th antecedent, then the first and the m-th, then the first and the n-th antecedent again. Each of these steps is an instance of the ~ wl-impchain-com-1.x series. (Contributed by Wolf Lammen, 17-Nov-2019.)
theorem wl_impchain_com_n_m:
  $ wtru $;

--| This theorem is in fact a copy of ~ com23 . It starts a series of theorems named after ~ wl-impchain-com-n.m . For more information see there. (Contributed by Wolf Lammen, 12-Nov-2019.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_impchain_com_2_3 (ph ps ch th: wff):
  $ wi th (wi ch (wi ps ph)) $ >
  $ wi th (wi ps (wi ch ph)) $;

--| This theorem is in fact a copy of ~ com24 . It is another instantiation of theorems named after ~ wl-impchain-com-n.m . For more information see there. (Contributed by Wolf Lammen, 17-Nov-2019.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem wl_impchain_com_2_4 (ph ps ch th et: wff):
  $ wi et (wi th (wi ch (wi ps ph))) $ >
  $ wi et (wi ps (wi ch (wi th ph))) $;

--| This theorem is in fact a copy of ~ com3r . The proof is an example of how to arrive at arbitrary permutations of antecedents, using only swapping theorems. The recursion principle is to first swap the correct antecedent to the position just before the consequent, and then employ a theorem handling an implication chain of length one less to reorder the others. (Contributed by Wolf Lammen, 17-Nov-2019.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem wl_impchain_com_3_2_1 (ph ps ch th: wff):
  $ wi th (wi ch (wi ps ph)) $ >
  $ wi ps (wi th (wi ch ph)) $;

--| If an implication chain is assumed (hypothesis) or proven (theorem) to hold, then we may add any extra antecedent to it, without changing its truth. This is expressed in its simplest form in ~ wl-luk-a1i , that allows prepending an arbitrary antecedent to an implication chain. Using our antecedent swapping theorems described in ~ wl-impchain-com-n.m , we may then move such a prepended antecedent to any desired location within all antecedents. The first series of theorems of this kind adds a single antecedent somewhere to an implication chain. The appended number in the theorem name indicates its position within all antecedents, 1 denoting the head position. A second theorem series extends this idea to multiple additions (TODO). Adding antecedents to an implication chain usually weakens their universality. The consequent afterwards depends on more conditions than before, which renders the implication chain less versatile. So you find this proof technique mostly when you adjust a chain to a hypothesis of a rule. A common case are syllogisms merging two implication chains into one. The first elements of the first series correspond to ~ a1i , ~ a1d and ~ a1dd in the main part. The proofs of this series aim at automated proving using a simple recursive scheme. It employs the previous theorem in the series along with a sample from the ~ wl-impchain-com-1.x series developed before. (Contributed by Wolf Lammen, 20-Jun-2020.)
theorem wl_impchain_a1_x:
  $ wtru $;

--| Inference rule, a copy of ~ a1i . Head start of a recursive proof pattern. (Contributed by Wolf Lammen, 20-Jun-2020.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_impchain_a1_1 (ph ps: wff):
  $ ph $ >
  $ wi ps ph $;

--| Inference rule, a copy of ~ a1d . First recursive proof based on the previous instance. (Contributed by Wolf Lammen, 20-Jun-2020.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_impchain_a1_2 (ph ps ch: wff):
  $ wi ph ps $ >
  $ wi ph (wi ch ps) $;

--| Inference rule, a copy of ~ a1dd . A recursive proof depending on previous instances, and demonstrating the proof pattern. (Contributed by Wolf Lammen, 20-Jun-2020.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem wl_impchain_a1_3 (ph ps ch th: wff):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi ps (wi th ch)) $;

--| If one case of an ` if- ` condition is false, the other automatically follows. (Contributed by Wolf Lammen, 21-Jul-2024.)
theorem wl_ifp_ncond1 (ph ps ch: wff):
  $ wi (wn ps) (wb (wif ph ps ch) (wa (wn ph) ch)) $;

--| If one case of an ` if- ` condition is false, the other automatically follows. (Contributed by Wolf Lammen, 21-Jul-2024.)
theorem wl_ifp_ncond2 (ph ps ch: wff):
  $ wi (wn ch) (wb (wif ph ps ch) (wa ph ps)) $;

--| If one case of an ` if- ` condition is a consequence of the other, the expression in ~ df-ifp can be shortened. (Contributed by Wolf Lammen, 12-Jun-2024.)
theorem wl_ifpimpr (ph ps ch: wff):
  $ wi (wi ch ps) (wb (wif ph ps ch) (wo (wa ph ps) ch)) $;

--| If one case of an ` if- ` condition is a consequence of the other, the expression in ~ dfifp4 can be shortened. (Contributed by Wolf Lammen, 18-Jun-2024.)
theorem wl_ifp4impr (ph ps ch: wff):
  $ wi (wi ch ps) (wb (wif ph ps ch) (wa (wo ph ch) ps)) $;

--| Alternative definition of ~ whad based on ~ hadifp . See ~ df-had to learn how it is currently introduced. The only use case so far is being a binary addition primitive for ~ df-sad . If inputs are viewed as binary digits (true is 1, false is 0), the result is what a binary single-bit addition with carry-in yields in the low bit of their sum. The core meaning is to check whether an odd number of three inputs are true. The ` \/_ ` operation tests this for two inputs. So, if the first input is true, the two remaining inputs need to amount to an even (or: not an odd) number, else to an odd number. The idea of an odd number of inputs being true carries over to other than 3 inputs by recursion: In an informal notation we depend the case with n+1 inputs, ` ph ` being the additional one, recursively on that of n inputs: "(n+1)-xor" ` <-> if- ( ph , -. ` "n-xor" ` , ` "n-xor" ` ) ` . The base case is "0-xor" being ` F. ` , because zero inputs never contain an odd number among them. Then we find, after simplifying, in our informal notation: "2-xor" ` ( ph , ps ) <-> ( ph \/_ ps ) ` (see ~ wl-2xor ). Our definition here follows exactly the above pattern. In microprocessor technology an addition limited to a range (a one-bit range in our case) is called a "wrap-around operation". The name "had", as in ~ df-had , by contrast, is somehow suggestive of a "half adder" instead. Such a circuit, for one, takes two inputs only, no carry-in, and then yields two outputs - both sum and carry. That's why we use "3xor" instead of "had" here. (Contributed by Wolf Lammen, 24-Apr-2024.)
theorem wl_df_3xor (ph ps ch: wff):
  $ wb (whad ph ps ch) (wif ph (wn (wxo ps ch)) (wxo ps ch)) $;

--| Alternative definition of ~ wl-df-3xor , using triple exclusive disjunction, or XOR3. You can add more input by appending each one with a ` \/_ ` . Copy of ~ hadass . (Contributed by Mario Carneiro, 4-Sep-2016.) df-had redefined. (Revised by Wolf Lammen, 1-May-2024.)
theorem wl_df3xor2 (ph ps ch: wff):
  $ wb (whad ph ps ch) (wxo ph (wxo ps ch)) $;

--| Alternative form of ~ wl-df3xor2 . Copy of ~ df-had . (Contributed by Mario Carneiro, 4-Sep-2016.) df-had redefined. (Revised by Wolf Lammen, 1-May-2024.)
theorem wl_df3xor3 (ph ps ch: wff):
  $ wb (whad ph ps ch) (wxo (wxo ph ps) ch) $;

--| If the first input is true, then triple xor is equivalent to the biconditionality of the other two inputs. (Contributed by Mario Carneiro, 4-Sep-2016.) df-had redefined. (Revised by Wolf Lammen, 24-Apr-2024.)
theorem wl_3xortru (ph ps ch: wff):
  $ wi ph (wb (whad ph ps ch) (wn (wxo ps ch))) $;

--| If the first input is false, then triple xor is equivalent to the exclusive disjunction of the other two inputs. (Contributed by Mario Carneiro, 4-Sep-2016.) df-had redefined. (Revised by Wolf Lammen, 29-Apr-2024.)
theorem wl_3xorfal (ph ps ch: wff):
  $ wi (wn ph) (wb (whad ph ps ch) (wxo ps ch)) $;

--| Triple xor can be replaced with a triple biconditional. Unlike ` \/_ ` , you cannot add more inputs by simply stacking up more biconditionals, and still express an "odd number of inputs". (Contributed by Wolf Lammen, 24-Apr-2024.)
theorem wl_3xorbi (ph ps ch: wff):
  $ wb (whad ph ps ch) (wb ph (wb ps ch)) $;

--| Alternative form of ~ wl-3xorbi . (Contributed by Mario Carneiro, 4-Sep-2016.) df-had redefined. (Revised by Wolf Lammen, 24-Apr-2024.)
theorem wl_3xorbi2 (ph ps ch: wff):
  $ wb (whad ph ps ch) (wb (wb ph ps) ch) $;

--| Equivalence theorem for triple xor. (Contributed by Mario Carneiro, 4-Sep-2016.) df-had redefined. (Revised by Wolf Lammen, 24-Apr-2024.)
theorem wl_3xorbi123d (ph ps ch th ta et ze: wff):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb th ta) $ >
  $ wi ph (wb et ze) $ >
  $ wi ph (wb (whad ps th et) (whad ch ta ze)) $;

--| Equivalence theorem for triple xor. Copy of ~ hadbi123i . (Contributed by Mario Carneiro, 4-Sep-2016.)
theorem wl_3xorbi123i (ps ch th ta et ze: wff):
  $ wb ps ch $ >
  $ wb th ta $ >
  $ wb et ze $ >
  $ wb (whad ps th et) (whad ch ta ze) $;

--| Rotation law for triple xor. (Contributed by Mario Carneiro, 4-Sep-2016.) df-had redefined. (Revised by Wolf Lammen, 24-Apr-2024.)
theorem wl_3xorrot (ph ps ch: wff):
  $ wb (whad ph ps ch) (whad ps ch ph) $;

--| Commutative law for triple xor. Copy of ~ hadcoma . (Contributed by Mario Carneiro, 4-Sep-2016.) (Proof shortened by Wolf Lammen, 17-Dec-2023.)
theorem wl_3xorcoma (ph ps ch: wff):
  $ wb (whad ph ps ch) (whad ps ph ch) $;

--| Commutative law for triple xor. (Contributed by Mario Carneiro, 4-Sep-2016.) df-had redefined. (Revised by Wolf Lammen, 24-Apr-2024.)
theorem wl_3xorcomb (ph ps ch: wff):
  $ wb (whad ph ps ch) (whad ph ch ps) $;

--| Flipping the first input flips the triple xor. ~ wl-3xorrot can rotate any input to the front, so flipping any one of them does the same. (Contributed by Wolf Lammen, 1-May-2024.)
theorem wl_3xornot1 (ph ps ch: wff):
  $ wb (wn (whad ph ps ch)) (whad (wn ph) ps ch) $;

--| Triple xor distributes over negation. Copy of ~ hadnot . (Contributed by Mario Carneiro, 4-Sep-2016.) (Proof shortened by Wolf Lammen, 11-Jul-2020.)
theorem wl_3xornot (ph ps ch: wff):
  $ wb (wn (whad ph ps ch)) (whad (wn ph) (wn ps) (wn ch)) $;

--| In the recursive scheme "(n+1)-xor" ` <-> if- ( ph , -. ` "n-xor" ` , ` "n-xor" ` ) ` we set n = 0 to formally arrive at an expression for "1-xor". The base case "0-xor" is replaced with ` F. ` , as a sequence of 0 inputs never has an odd number being part of it. (Contributed by Wolf Lammen, 11-May-2024.)
theorem wl_1xor (ps: wff):
  $ wb (wif ps (wn wfal) wfal) ps $;

--| In the recursive scheme "(n+1)-xor" ` <-> if- ( ph , -. ` "n-xor" ` , ` "n-xor" ` ) ` we set n = 1 to formally arrive at an expression for "2-xor". It is based on "1-xor", that is known to be equivalent to its only input (see ~ wl-1xor ). (Contributed by Wolf Lammen, 11-May-2024.)
theorem wl_2xor (ph ps: wff):
  $ wb (wif ph (wn ps) ps) (wxo ph ps) $;

--| Alternative definition of ~ wcad . See ~ df-cad to learn how it is currently introduced. The only use case so far is being a binary addition primitive for ~ df-sad . If inputs are viewed as binary digits (true is 1, false is 0), the result is whether ordinary binary full addition yields a carry bit. That is what the name ~ df-cad is derived from: "carry of an addition". Here we stick with this abbreviated form of our notation above, but still use "adder carry" as a shorthand for "at least 2 out of 3" in text. The core meaning is to check whether at least two of three inputs are true. So, if the first input is true, at least one of the two remaining must be true, else even both. This theorem is the in-between of "at least 1 out of 3", given by triple disjunction ~ df-3or , and "(at least) 3 out of 3", expressed by triple conjunction ~ df-3an . The notion above can be generalized to other input numbers with other minimum values as follows. Let us introduce informally a logical operation "n-mintru-m" taking n inputs, and requiring at least m of them be true to let the operation itself be true. There now exists a recursive scheme to define it for increasing n, m. We start with the base case n = 0. Here "n-mintru-0" is equivalent to ` T. ` (any sequence of inputs contains at least zero true inputs), the other "0-mintru-m" is for any m > 0 equivalent to ` F. ` , because a sequence of zero inputs never has a positive number of them true. The general case adds a new input ` ph ` to a given sequence of n inputs, and reduces that case for all integers m to that of the smaller sequence by recursion, informally written as: "(n+1)-mintru-(m+1)" ` <-> if- ( ph , ` "n-mintru-m" ` , ` "n-mintru-(m+1)" ` ) ` Our definition here matches "3-mintru-2" with inputs ` ph ` , ` ps ` and ` ch ` . Starting from the base cases we find after simplifications: "2-mintru-2" ` ( ps , ch ) <-> ( ps /\ ch ) ` ( ~ wl-2mintru2 ), and "2-mintru-1" ` ( ps , ch ) <-> ( ps \/ ch ) ` ( ~ wl-2mintru1 ). Plugging these expressions into the formula above for n = 3, m = 2 yields exactly our definition here. (Contributed by Wolf Lammen, 2-May-2024.)
theorem wl_df_3mintru2 (ph ps ch: wff):
  $ wb (wcad ph ps ch) (wif ph (wo ps ch) (wa ps ch)) $;

--| The adder carry in disjunctive normal form. An alternative highly symmetric definition emphasizing the independence of order of the inputs ` ph ` , ` ps ` and ` ch ` . Copy of ~ cador . (Contributed by Mario Carneiro, 4-Sep-2016.) df-cad redefined. (Revised by Wolf Lammen, 12-Jun-2024.)
theorem wl_df2_3mintru2 (ph ps ch: wff):
  $ wb (wcad ph ps ch) (w3o (wa ph ps) (wa ph ch) (wa ps ch)) $;

--| The adder carry in conjunctive normal form. An alternative highly symmetric definition emphasizing the independence of order of the inputs ` ph ` , ` ps ` and ` ch ` . Copy of ~ cadan . (Contributed by Mario Carneiro, 4-Sep-2016.) df-cad redefined. (Revised by Wolf Lammen, 18-Jun-2024.)
theorem wl_df3_3mintru2 (ph ps ch: wff):
  $ wb (wcad ph ps ch) (w3a (wo ph ps) (wo ph ch) (wo ps ch)) $;

--| An alternative definition of the adder carry. Copy of ~ df-cad . (Contributed by Mario Carneiro, 4-Sep-2016.) df-cad redefined. (Revised by Wolf Lammen, 19-Jun-2024.)
theorem wl_df4_3mintru2 (ph ps ch: wff):
  $ wb (wcad ph ps ch) (wo (wa ph ps) (wa ch (wxo ph ps))) $;

--| Using the recursion formula: "(n+1)-mintru-(m+1)" ` <-> if- ( ph , ` "n-mintru-m" ` , ` "n-mintru-(m+1)" ` ) ` for "1-mintru-1" (meaning "at least 1 out of 1 input is true") by plugging in n = 0, m = 0, and simplifying. The expressions "0-mintru-0" and "0-mintru-1" are base cases of the recursion, meaning "in a sequence of zero inputs, at least 0 / 1 input is true", respectively equivalent to ` T. ` / ` F. ` . Negating an "n-mintru1" operation means: All n inputs ` ph ` .. ` th ` are false. This is also conveniently expressed as ` -. ( ph \/ ` .. ` \/ th ) ` . Applying this idea here (n = 1) yields the obvious result that in an input sequence of size 1 only then all will be false, if its single input is. (Contributed by Wolf Lammen, 10-May-2024.)
theorem wl_1mintru1 (ch: wff):
  $ wb (wif ch wtru wfal) ch $;

--| Using the recursion formula: "(n+1)-mintru-(m+1)" ` <-> if- ( ph , ` "n-mintru-m" ` , ` "n-mintru-(m+1)" ` ) ` for "1-mintru-2" (meaning "at least 2 out of a single input are true") by plugging in n = 0, m = 1, and simplifying. The expressions "0-mintru-1" and "0-mintru-2" are base cases of the recursion, meaning "in a sequence of zero inputs at least 1 / 2 input is true", evaluate both to ` F. ` . Since no sequence of inputs has a longer subsequence of whatever property, the resulting ` F. ` is to be expected. Negating a "n-mintru2" operation has an interesting interpretation: at most one input is true, so all inputs exclude each other mutually. Such an exclusion is expressed by a NAND operation ` ( ph -/\ ps ) ` , not by a XOR. Applying this idea here (n = 1) leads to the obvious "In a single input sequence 'at most one is true' always holds". (Contributed by Wolf Lammen, 10-May-2024.)
theorem wl_1mintru2 (ch: wff):
  $ wb (wif ch wfal wfal) wfal $;

--| Using the recursion formula "(n+1)-mintru-(m+1)" ` <-> if- ( ph , ` "n-mintru-m" ` , ` "n-mintru-(m+1)" ` ) ` for "2-mintru-1" (meaning "at least 1 out of 2 inputs is true") by plugging in n = 1, m = 0, and simplifying. The expression "1-mintru-0" is a base case (meaning at least zero inputs out of 1 are true), evaluating to ` T. ` , and ~ wl-1mintru1 shows "1-mintru-1" is equivalent to the only input. Negating an "n-mintru1" operation means: All n inputs ` ph ` .. ` th ` are false. This is also conveniently expressed as ` -. ( ph \/ ` .. ` \/ th ) ` , in accordance with the result here. (Contributed by Wolf Lammen, 10-May-2024.)
theorem wl_2mintru1 (ps ch: wff):
  $ wb (wif ps wtru ch) (wo ps ch) $;

--| Using the recursion formula "(n+1)-mintru-(m+1)" ` <-> if- ( ph , ` "n-mintru-m" ` , ` "n-mintru-(m+1)" ` ) ` for "2-mintru-2" (meaning "2 out of 2 inputs are true") by plugging in n = 1, m = 1, and simplifying. See ~ wl-1mintru1 and ~ wl-1mintru2 to see that "1-mintru-1" / "1-mintru-2" evaluate to ` ch ` / ` F. ` respectively. Negating a "n-mintru2" operation means 'at most one input is true', so all inputs exclude each other mutually. Such an exclusion is expressed by a NAND operation ` ( ph -/\ ps ) ` , not by a XOR. Applying this idea here (n = 2) yields the expected NAND in case of a pair of inputs. (Contributed by Wolf Lammen, 10-May-2024.)
theorem wl_2mintru2 (ps ch: wff):
  $ wb (wif ps ch wfal) (wa ps ch) $;

--| Assuming "(n+1)-maxtru1" ` <-> -. ` "(n+1)-mintru-2", we can deduce from the recursion formula given in ~ wl-df-3mintru2 , that a similiar one "(n+1)-maxtru1" ` <-> if- ( ph , ` -. "n-mintru-1" ` , ` "n-maxtru1" ` ) ` is valid for expressing 'at most one input is true'. This can also be rephrased as a mutual exclusivity of propositional expressions (no two of a sequence of inputs can simultaneously be true). Of course, this suggests that all inputs depend on variables ` et ` , ` ze ` ... Whatever wellformed expression we plugin for these variables, it will render at most one of the inputs true. The here introduced mutual exclusivity is possibly useful for case studies, where we want the cases be sort of 'disjoint'. One can further imagine that a complete case scenario demands that the 'at most' is sharpened to 'exactly one'. This does not impose any difficulty here, as one of the inputs will then be the negation of all others be or'ed. As one input is determined, 'at most one' is sufficient to describe the general form here. Since ` cadd ` is an alias for 'at least 2 out of three are true', its negation is under focus here. (Contributed by Wolf Lammen, 23-Jun-2024.)
theorem wl_df3maxtru1 (ph ps ch: wff):
  $ wb (wn (wcad ph ps ch)) (wif ph (wnor ps ch) (wnan ps ch)) $;

--| A version of ~ ax13v with a distinctor instead of a distinct variable condition. Had we additionally required ` x ` and ` y ` be distinct, too, this theorem would have been a direct consequence of ~ ax-5 . So essentially this theorem states, that a distinct variable condition between set variables can be replaced with a distinctor expression. (Contributed by Wolf Lammen, 23-Jul-2021.)
axiom ax_wl_13v {x3: setvar} (y1 z: setvar):
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv y1) (cv z)) (wal x3 (wceq (cv y1) (cv z)))) $;

--| A version of ~ ax-wl-13v with one distinct variable restriction dropped. For convenience, ` y ` is kept on the right side of equations. This proof bases on ideas from NM, 24-Dec-2015. (Contributed by Wolf Lammen, 23-Jul-2021.)
theorem wl_ax13lem1 {x3 y1 z: setvar}:
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv z) (cv y1)) (wal x3 (wceq (cv z) (cv y1)))) $;

--| <HTML><br><b>Disclaimer:</b></HTML> The material presented here is just my (WL's) personal perception. I am not an expert in this field, so some or all of the text here can be misleading, or outright wrong. This and the following texts should be read as explorations rather than as definite statements, open to doubt, alternatives, and reinterpretation. <HTML><h3>Preface</h3></HTML> Three specific theorems are under focus in the following pages: ~ df-cleq , ~ df-clel , and ~ df-clab . Only technical concepts necessary to explain these will be introduced, along with a selection of supporting theorems. The three theorems are central to a bootstrapping process that introduces objects into set.mm. We will first examine how Metamath in general creates basic new ideas from scratch, and then look at how these methods are applied specifically to classes, capable of representing objects in set theory. In Zermelo-Fraenkel set theory with the axiom of choice (ZFC), these three theorems are (more or less) independent of each other, which means they can be introduced in different orders. From my own experience, another order has pedagogical advantages: it helps grasping not only the overall concept better, but also the intricate details that I first found difficult to comprehend. Reordering theorems, though syntactically possible, sometimes may cause doubts when intermediate results are not strictly tied to ZFC only. The purpose of set.mm is to provide a formal framework capable of proving the results of ZFC, provided that formulas are properly interpreted. In fact, there is freedom of interpretation. The database set.mm develops from the very beginning, where nothing is assumed or fixed, and gradually builts up to the full abstraction of ZFC. Along the way, results are only preliminary, and one may at any point branch off and pursue a different path toward another variant of set theory. This openess is already visible in axiom ~ ax-mp , where the symbol ` -> ` can be understood as as implication, bi-conditional, or conjunction. The notation and symbol shapes are suggestive, but their interpretation is not mandatory. The point here is that Metamath, as a purely syntactic system, can sometimes allow freedoms, unavailable to semantically fixed systems, which presuppose only a single ultimate goal. (Contributed by Wolf Lammen, 28-Sep-2025.)
theorem wl_cleq_0 {x3: setvar} (A2 B2: class):
  $ wb (wceq A2 B2) (wal x3 (wb (wcel (cv x3) A2) (wcel (cv x3) B2))) $;

--| <HTML><br><b>Disclaimer:</b></HTML> The material presented here is just my (WL's) personal perception. I am not an expert in this field, so some or all of the text here can be misleading, or outright wrong. This text should be read as an exploration rather than as definite statements, open to doubt, alternatives, and reinterpretation. <HTML><h3>Grammars and Parsable contents</h3></HTML> A Metamath program is a text-based tool. Its input consists of primarily human-readable and editable text stored in *.mm files. For automated processing, these files follow a strict structure. This enables automated analysis of their contents, verification of proofs, proof assistance, and the generation of output files - for example, the HTML page of this dummy theorem. A set.mm file contains numerous such structured instructions serving these purposes. This page provides a brief explanation of the general concepts behind structured text, as exemplified by set.mm. The study of structured text originated in linguistics, and later computer science formalized it further for text like data and program code. The rules describing such structures are collectively known as _grammar_. Metamath also introduces a grammar to support automation and establish a high degree of confidence in its correctness. It could have been described using the terminology of earlier scientific disciplines, but instead it uses its own language. When a text exhibits a sufficiently regular structure, its form can be described by a set of syntax rules, or grammar. Such rules consist of terminal symbols (fixed, literal elements) and non-terminal symbols, which can recursively be expanded using the grammar's _rewrite_ rules. A program component that applies a grammar to text is called a _parser_. The parser decomposes the text into smaller parts, called _syntactic units_, while often maintaining contextual information. These units may then be handed over to subsequent components for further processing, such as populating a database or generating output. In these pages, we restrict our attention to strictly formatted material consisting of formulas with logical and mathematical content. These syntactic units are embedded in higher-level structures such as chapters, together with commands that, for example, control the HTML output. Conceptually, the parsing process can be viewed as consisting of two stages. The top-level stage applies a simple built-in grammar to identify its structural units. Each unit is a text region marked on both sides with predefined tokens (in Metamath: keywords), beginning with the escape character "$". Text regions containing logical or mathematical formulas are then passed to a second-stage parser, which applies a different grammar. Unlike the first, this grammar is not built-in but is dynamically constructed. In what follows, we will ignore the first stage of parsing, since its role is only to extract the relevant material embedded within text primarily intended for human readers. (Contributed by Wolf Lammen, 18-Aug-2025.)
theorem wl_cleq_1 {x3: setvar} (A2 B2: class):
  $ wb (wceq A2 B2) (wal x3 (wb (wcel (cv x3) A2) (wcel (cv x3) B2))) $;

--| <HTML><br><b>Disclaimer:</b></HTML> The material presented here is just my (WL's) personal perception. I am not an expert in this field, so some or all of the text here can be misleading, or outright wrong. This text should be read as an exploration rather than as definite statements, open to doubt, alternatives, and reinterpretation. <HTML><h3>Vocabulary</h3></HTML> <HTML><b>Sentence:<br></b></HTML> A _sentence_ or _closed form theorem_ is a theorem without any hypothesis, as opposed to the inference form. Although distinct variable conditions can be viewed as a particular kind of hypothesis, in Metamath they are treated as side conditions, and do not affect formal structure of the theorem. Expressions such as ` F/ x ph ` or the distinctor ` A. x ( x = y ) ` play a similar role, but appear as separate hypotheses, or they can simply serve as the first antecedent in a sentence. <HTML><b>Bound / Free / Dependent:<br></b></HTML> In formal theories, variables are used to represent objects, allowing for general statements about relations rather than individual cases. In Metamath, for example, mathematical objects are represented by variables of type "setvar". An occurrence of such a variable in any formula ` ph ` is said to be bound. if ` ph ` quantifies that variable, as in ` A. x ph ` . Variables not bound by a quantifier are called free. Variables of type "class" are always free, since quantifiers do not apply to them. A free variable often indicates a parameter dependency; however, the formula ` x = x ` shows that this is not necessarily the case. In Metamath, a variable expressing a real dependency is also called "effectively free" (see ~ nfequid , with thanks to SN for pointing out this theorem). <HTML><b>Instance:<br></b></HTML> A formula of type "class" that is not a mere variable is called an _instance_ of any "class" type variable. An instance may represent a single object, or it may still describe a family of objects, when variables expressing dependencies occur within that formula. <HTML><b>Attribute:<br></b></HTML> Objects possess properties, some of which may uniquely identify them. In logic, properties are also known as attributes. They are described by formulas depending on a variable, which can then be substituted with a specific object. If the resulting statement is true, that particular attribute is said to apply to the object. Multiple objects forming an instance may share common attributes. A variable inherits the attributes of the instance it represents. (Contributed by Wolf Lammen, 12-Oct-2025.)
theorem wl_cleq_2 {x3: setvar} (A2 B2: class):
  $ wb (wceq A2 B2) (wal x3 (wb (wcel (cv x3) A2) (wcel (cv x3) B2))) $;

--| <HTML><br><b>Disclaimer:</b></HTML> The material presented here is just my (WL's) personal perception. I am not an expert in this field, so some or all of the text here can be misleading, or outright wrong. This text should be read as an exploration rather than as definite statements, open to doubt, alternatives, and reinterpretation. <HTML><h3>Introducing a New Concept: Well-formed formulas</h3></HTML> The parser that processes strictly formatted Metamath text with logical or mathematical content constructs its grammar dynamically. New syntax rules are added on the fly whenever they are needed to parse upcoming formulas. Only a minimal set of built-in rules - those required to introduce new grammar rules - is predefined; everything else must be supplied by set.mm itself as syntactic units identified by the first-stage parser. Text regions beginning with the tokens "$c" or "$v", for example, are part of such grammar extensions. We will outline the extension process used when introducing an entirely new concept that cannot build on any prior material. As a simple example, we will trace here the steps involved in defining formulas, the expressions used for hypotheses and statements - a concept first-order logic needs from the very beginning to articulate its ideas. 1. <HTML><b>Introduce a type code</b></HTML> To mark new formulas and variables later used in theorems, the constant "wff" is reserved. It abbreviates "well-formed formula", a term that already suggests that such formulas must be syntactically valid and therefore parseable to enable automatic processing. 2. <HTML><b>Introduce variables</b></HTML> Variables with unique names such as ` ph ` , ` ps ` , ..., intended to later represent formulas of type "wff". In grammar terms, they correspond to non-terminal symbols. These variables are marked with the type "wff". Variables are fundamental in Metamath, since they enable substitution during proofs: variables of a particular type can be consistently replaced by any formula of the same type. In grammar terms, this corresponds to applying a rewrite rule. At this step, however, no rewrite rule exists; we can only substitute one "wff" variable for another. This suffices only for very elementary theorems such as ~ idi . In the formal language of Metamath these variables are not interpreted with concrete statements, but serve purely as placeholders for substitution. 3. <HTML><b>Add primitive formulas</b></HTML> Rewrite rules describing primitive formulas of type "wff" are then added to the grammar. Typically, they describe an operator (a constant in the grammar) applied to one or more variables, possibly of different types (e.g. ` A. x ph ` , although at this stage only "wff" is available). Since variables are non-terminal symbols, more complex formulas can be constructed from primitive ones, by consistently replacing variables with any wff formula - whether involving the same operator or different ones introduced by other rewrite rules. Whenever such a replacement introduces variables again, they may in turn recursively be replaced. If an operator takes two variables of type wff, it is called a binary connective in logic. The first such operator encountered is ` ( ph -> ps ) ` . Based on its token, its intended meaning is material implication, though this interpretation is not fixed from the outset. 4. <HTML><b>Specify the properties of primitive formulas</b></HTML> Once the biconditional connective is available for formulas, new connectives can be defined by specifying replacement formulas that rely solely on previously introduced material. Such definitions makes it possible to eliminate the definiens. At the very beginning, however, this is not possible for well-formed formulas, since little or no prior material exists. Instead, the semantics of an expression such as ` ( ph -> ps ) ` are progressively constrained by axioms - that is, theorems without proof. The first such axiom for material implication is ~ ax-mp , with additional axioms following later. (Contributed by Wolf Lammen, 21-Aug-2025.)
theorem wl_cleq_3 {x3: setvar} (A2 B2: class):
  $ wb (wceq A2 B2) (wal x3 (wb (wcel (cv x3) A2) (wcel (cv x3) B2))) $;

--| <HTML><br><b>Disclaimer:</b></HTML> The material presented here is just my (WL's) personal perception. I am not an expert in this field, so some or all of the text here can be misleading, or outright wrong. This text should be read as an exploration rather than as definite statements, open to doubt, alternatives, and reinterpretation. <HTML><h3>Introducing a New Concept: Classes</h3></HTML> In ~ wl-cleq-3 we examined how the basic notion of a well-formed formula is introduced in set.mm. A similar process is used to add the notion of a class to Metamath. This process is somewhat more involved, since two parallel variants are established: sets and the broader notion of classes, which include sets (see 3a. below). In Zermelo-Fraenkel set theory (ZF) classes will serve as a convenient shorthand that simplifies formulas and proofs. Ultimately, only sets - a part of all classes - are intended to exist as actual objects. In the First Order Logic (FOL) portion of set.mm objects themselves are not used - only variables representing them. It is not even assumed that objects must be sets at all. In principle, the universe of discourse could consist of anything - vegetables, text strings, and so on. For this reason, the type code "setvar", used for object variables, is somewhat of a misnomer. Its final meaning - and the name that goes with it - becomes justified only in later developments. We will now revisit the four basic steps presented in ~ wl-cleq-3 , this time focusing on object variables and paying special attention to the additional complexities that arise from extending sets to classes. 1. <HTML><b>Introduce type codes</b></HTML> 1a. Reserve a type code for classes, specifically the grammar constant "class". Initially, this type code applies to class variables and will later, beyond these four steps, also be assigned to formulas that define specific classes, i.e. instances. 1b. Reserve a type code for set variables, represented by the grammar constant "setvar". The name itself indicates that this type code will never be assigned to a formula describing a specific set, but only to variables containing such objects. 2. <HTML><b>Introduce variables</b></HTML> 2a. Use variables with unique names such as ` A ` , ` B ` , ..., to represent classes. These class variables are assigned the type code "class", ensuring that only formulas of type "class" can be substituted for them during proofs. 2b. Use variables with unique names such as ` a ` , ` b ` , ..., to represent sets. These variables are assigned the type code "setvar". During a substitution in a proof, a variable of type "setvar" may only be replaced with another variable of this type. No specific formula, or object, of this type exists. 3. <HTML><b>Add primitive formulas</b></HTML> 3a. Add the rewrite rule ~ cv to set.mm, allowing variables of type "setvar" to also aquire type "class". In this way, a variable of "setvar" type can serve as a substitute for a class variable. 3b. Add the rewrite rules ~ wcel and ~ wceq to set.mm, making the formulas ` A e. B ` and ` A = B ` valid well-formed formulas (wff). Since variables of type "setvar" can be substituted for class variables, ` x e. y ` and ` x = y ` are also provably valid wff. In the FOL part of set.mm, only these specific formulas play a role and are therefore treated as primitive there. The underlying universe may not contain sets, and the notion of a class is not even be required. Additional mixed-type formulas, such as ` x e. A ` , ` A e. x ` , ` x = A ` , and ` A = x ` exist. When the theory is later refined to distinguish between sets and classes, the results from FOL remain valid and naturally extend to these mixed cases. These cases will occasionally be examined individually in subsequent discussions. 4. <HTML><b>Specify the properties of primitive formulas</b></HTML> In FOL in set.mm, the formulas ` x = y ` and ` x e. y ` cannot be derived from earlier material, and therefore cannot be defined. Instead, their fundamental properties are established through axioms, namely ~ ax-6 through ~ ax-9 , ~ ax-13 , and ~ ax-ext . Similarly, axioms establish the properties of the primitive formulas ` A = B ` and ` A e. B ` , ensuring that they extend the FOL counterparts ` x = y ` and ` x e. y ` in a consistent and meaningful way. At the same time, a criterion must be developed to distinguish sets from classes. Since set variables can only be substituted by other set variables, equality must permit the assignment of class terms known to represent sets to those variables. (Contributed by Wolf Lammen, 25-Aug-2025.)
theorem wl_cleq_4 {x3: setvar} (A2 B2: class):
  $ wb (wceq A2 B2) (wal x3 (wb (wcel (cv x3) A2) (wcel (cv x3) B2))) $;

--| <HTML><br><b>Disclaimer:</b></HTML> The material presented here is just my (WL's) personal perception. I am not an expert in this field, so some or all of the text here can be misleading, or outright wrong. This text should be read as an exploration rather than as definite statements, open to doubt, alternatives, and reinterpretation. <HTML><h3>Semantics of Equality</h3></HTML> There is a broadly shared understanding of what equality between objects expresses, extending beyond mathematics or set theory. Equality constitutes an equivalence relation among objects ` x ` , ` y ` , and ` z ` within the universe under consideration: 1. Reflexivity ` x = x ` 2. Symmetry ` ( x = y -> y = x ) ` 3. Transitivity ` (( x = y /\ x = z ) -> y = z ) ` 4. Identity of Indiscernables (Leibniz's Law): distinct (i.e., unequal), objects cannot share all the same properties (or attributes). In formal theories using variables, the attributes of a variable are assumed to mirror those of the instance it denotes. For both variables and objects, items (1) - (4) must either be derived or postulated as axioms. If the theory allows substituting instances for variables, then the equality rules for objects follow directly from those governing variables. However, if variables and instances are formally distinguished, this distinction introduces an additional metatheoretical attribute, relevant for (4). A similar issue arises when equality is considered between different types of variables sharing properties. Such mixed-type equalities are subject to restrictions: reflexivity does not apply, since the two sides represent different kinds of entities. Nevertheless, symmetry and various forms of transitivity typically remain valid, and must be proven or established within the theory. In set.mm formulas express attributes. Therefore, equal instances must behave identically, yielding the same results when substituted into any formula. To verify equality, it suffices to consider only primitive operations involving free variables, since all formulas - once definitions are eliminated - reduce to these. Equality itself introduces no new attribute (an object is always different from all others), and can thus be excluded from this examination. <HTML><h3>Equality in First Order Logic (FOL)</h3></HTML> In the FOL component of set.mm, the notion of an "object" is absent. Only set variables are used to formulate theorems, and their attributes - expressed through an unspecified membership operator - are addressed at a later stage. Instead, several axioms address equality directly: ~ ax-6 , ~ ax-7 , ~ ax-8 , ~ ax-9 and ~ ax-12 , and ~ ax-13 . In practice, restricted versions with distinct variable conditions are used ( ~ ax6v , ~ ax12v ). The unrestricted forms together with axiom ~ ax-13 , allow for the elimination of distinct variable conditions, this benefit is considered too minor for routine use. Equality in FOL is formalized as follows: 2a. Equivalence Relation. Essentially covered by ~ ax-7 , with some support of ~ ax-6 . 2b. Leibniz's Law for the primitive ` e. ` operator. Captured by ~ ax-8 and ~ ax-9 . 2c. General formulation. Given in ~ sbequ12 . 2d. Implicit substitution. Assuming Leibniz's Law holds for a particular expression, various theorems extend its validity to other, derived expressions, often introducing quantification (see for example ~ cbvalvw ). The auxiliary axioms ~ ax-10 , ~ ax-11 , ax-12 are provable (see ~ ax10w , for example) if you can substitute ` y ` for ` x ` in a formula ` ph ` that contains no occurrence of ` y ` and leaves no remaining trace of ` x ` after substitution. An implicit substitution is then established by setting the resulting formula equivalent to ` ph ` under the assumption ` x = y ` . Ordinary FOL substitution ` [ y / x ] ph ` is insufficient in this context, since ` x ` still occurs in the substituted formula. A simple textual replacement of the token ` x ` by ` y ` in ` ph ` might seem an intuitive solution, but such operations are out of the formal scope of Metamath. 2e. Axiom of Extensionality. In its elaborated form ( ~ axextb ), it states that the determining attributes of a set ` x ` are the elements ` z ` it contains, as expressed by ` z e. x ` . This is the only primitive operation relevant for equality between set variables. <HTML><h3>Equality between classes</h3></HTML> In set.mm class variables of type "class" are introduced analoguously to set variables. Besides the primitive operations equality and membership, class builders allow other syntactical constructs to substitute for class variables, enabling them to represent class instances. One such builder ( ~ cv ) allows set variables to replace class variables. Another ( ~ df-clab ) introduces a class instance, known as class abstraction. Since a class abstraction can freely substitute for a class variable, formulas hold for both alike. Hence, there is no need to distinguish between class variables and abstractions; the term _class_ will denote "class variable or class abstraction". Set variables, however, are treated separately, as they are not of type "class". 3a. Equivalence Relation. Axiom ~ df-cleq , from which class versions of (1a) - (1c) can be derived, guarantees that equality between class variables form an equivalence relation. Since both class abstractions and set variables can substitute for class variables, this equivalence extends to all mixed equalities, including those with set variables, since they automatically convert to classes upon substitution. 3b. Attributes. The primitive operation of membership constitutes the fundamental attributes of a class. Axiom ~ df-clel reduces possible membership relations between class variables to those between a set variable and a class variable. Axiom ~ df-cleq extends ~ axextb to classes, stating that classes are fully determined by their set members. A class builder may introduce a new attribute for classes. An equation involving such a class instance may express this attribute. In the case of the class builder ~ cv , an attribute called sethood is in fact introduced: A class is a set if it can be equated with some set variable. Class abstractions supported by class builder ~ df-clab also formally introduce attributes. Whether a class can be expressed as an abstraction with a specific predicate may be relevant in analysis. However, since theorem ~ df-clab is a definition (and hence eliminable), these attributes can also be expressed in other ways. 3c. Conservativity. Because set variables can substitute for class variables, all axioms and definitions must be consistent with theorems in FOL. To ensure this, hypotheses are added to axioms and definitions that mirror the structure of their statement, but with class variables replaced by set variables. Since theorems cannot be applied without first proving their hypotheses, conservativity thus is enforced. 3d. Leibniz's Law. Besides equality membership is (and remains) the only primitive operator between classes. Axioms ~ df-cleq and ~ df-clel provide class versions of ~ ax-8 and ~ ax-9 , ensuring that membership is consistent with Leibniz's Law. Sethood, being based on mixed-type equality, preserves its value among equal classes. As long as additional class builders beyond those mentioned are only defined, the reasoning given for class abstraction above applies generally, and Leibniz's Law continues to hold. 3e. Backward Compatability. A class ` A ` equal to a set should be substitutable for a free set variable ` x ` in any theorem, yielding a valid result, provided ` x ` and ` A ` are distinct. Sethood is conveniently expressed by ` E. z z = A ` ; this assumption is added as an antecedent to the corresponding FOL theorem. However, since direct substitution is disallowed, a deduction version of an FOL theorem cannot be simply converted. Instead, the proof must be replayed, consistently replacing ` x ` with ` A ` . Ultimately, this process reduces to the FOL axioms, or their deduction form. If these axioms hold when ` A ` replaces ` x ` - under the above assumptions - then the replacement can be considered generally valid. The affected FOL axioms are ~ ax-6 (in the form ~ ax6ev ), ~ ax-7 , ~ ax-8 , ~ ax-9 , ~ ax-12 ( ~ ax12v2 ), and to some extent ~ ax-13 ( ~ ax13v ). Since ZF (Zermelo-Fraenkel) set theory does not allow quantifification over class variables, no similar class-based versions of the quantified FOL axioms exist. (Contributed by Wolf Lammen, 18-Sep-2025.)
theorem wl_cleq_5 {x3: setvar} (A2 B2: class):
  $ wb (wceq A2 B2) (wal x3 (wb (wcel (cv x3) A2) (wcel (cv x3) B2))) $;

--| <HTML><br><b>Disclaimer:</b></HTML> The material presented here is just my (WL's) personal perception. I am not an expert in this field, so some or all of the text here can be misleading, or outright wrong. This text should be read as an exploration rather than as definite statements, open to doubt, alternatives, and reinterpretation. <HTML><h3>Eliminability of Classes</h3></HTML> One requirement of Zermelo-Fraenkel set theory (ZF) is that it can be formulated entirely without referring to classes. Since set.mm implements ZF, it must therefore be possible to eliminate all classes from its formalization. <HTML><b>Eliminating Variables of Propositional Logic</b></HTML> Classical propositional logic concerns statements that are either true or false. For example, "A minute has 60 seconds" is such a statement, as is "English is not a language". Our development of propositional logic applies to all such statements, regardless of their subject matter. Any particular topic, or universe of discourse is encompassed by the general theorems of propositional logic. In ZF, however, the objects of study are sets - mathematical entities. The flexibility of propsitional variables is not required here. Instead, ZF introduces two primitive connectives between sets: ` x = y ` and ` x e. y ` . ZF is concerned only with logical schemata constructed solely from these primitives. Thus, before we can eliminate classes, we must first eliminate propositional variables like ` ph ` and ` ps ` . We will describe this process constructively. We begin by restricting ourselves to propositional schemata that consist only of the primitives of ZF, without any propositional variables. Extending this step to first-order Logic (FOL) - by introducing quantifiers - yields the fundamental predicates of ZF, that is, the basic formulas expressible within it. For convenience, we may again allow propositional variables, but under the strict assumption that they always represent fundamental predicates of ZF. Predicates of level 0 are exactly of this kind: no classes occurs in them, and they can be reduced directly to fundamental predicates in ZF. <HTML><b>Introducing eliminable classes</b></HTML> The following construction is inspired by a paragraph in Azriel Levy's "Basic set theory" concerning eliminable classes. A class can only occur in combination with one of the operators ` = ` or ` e. ` . This applies in particular to class abstractions, which are the only kind of classes permtted in this step of extending level-0 predicates in ZF. The definitions ~ df-cleq and ~ df-clel show that equality and membership ultimately reduce to expressions of the form ` x e. A ` . For a class abstraction ` { y | ph } ` , the resulting term amounts to ` [ x / y ] ph ` . If ` ph ` is a level-0 predicate, then this too is a level-0 expression - fully compatible with ZF. A level-1 class abstraction is a class ` { y | ph } ` where ` ph ` is a level-0 predicate. A level-1 class abstraction can occur in an equality or membership relation with another level-1 class abstractions or a set variable, and such terms reduce to fundamental predicates. Predicates of either level-0, or containing level-1 class abstractions are called level-1 predicates. After eliminating all level-1 abstractions from such a predicate a level-0 expression is the result. Analoguously, we can define level-2 class abstractions, where the predicate ` ph ` in ` { y | ph } ` is a level-1 predicate. Again, ` x e. { y | ph } ` reduces to a level-1 expression, which in turn can be reduced to a level-0 one. By similar reasoning, equality and membership between at most level-2 class abstractions also reduce to level-0 expressions. A predicate containing at most level-2 class abstractions is called a level-2 predicate. This iterative construction process can be continued to define a predicate of any level. They can be reduced to fundamental predicates in ZF. <HTML><b>Introducing eliminable class variables</b></HTML> We have seen that propositional variables must be restricted to representing only primitive connectives to maintain compatibility with ZF. Similarly, class variables can be restricted to representing class abstractions of finite level. Such class variables are eliminable, and even definitions like ~ df-un ` ( A u. B ) ` introduce no difficulty, since the resulting union remains of finite level. <HTML><b>Limitations of eliminable class variables</b></HTML> Where does this construction reach its limits? 1. Infinite constructions. Suppose we wish to add up an infinite series of real numbers, where each term defines its successor using a class abstraction one level higher than that of the previous term. Such a summation introduces terms of arbitrary high level. While each individual term remains reducable in ZF, the infinite sum expression may not be reducable without special care. 2. Class builders. Every class builder other than ~ cv must be a definition, making its elimination straightforward. The class abstraction ~ df-clab described above is a special case. Since set variables themselves can be expressed as class abstractions - namely ` x = { y | y e. x } ` (see ~ cvjust ) - this formulation does not conflict with the use of class builder ~ cv . The above conditions apply only to substitution. The expression ` A = { x | x e. A } ` ( ~ abid1 ) is a valid and provable equation, and it should not be interpreted as an assignment that binds a particular instance to ` A ` . (Contributed by Wolf Lammen, 13-Oct-2025.)
theorem wl_cleq_6 {x3: setvar} (A2 B2: class):
  $ wb (wceq A2 B2) (wal x3 (wb (wcel (cv x3) A2) (wcel (cv x3) B2))) $;

--| Disclaimer: The material presented here is just my (WL's) personal perception. I am not an expert in this field, so some or all of the text here can be misleading, or outright wrong. This text should be read as an exploration rather than as a definite statement, open to doubt, alternatives, and reinterpretation. At the point where ~ df-cleq is introduced, the foundations of set theory are being established through the notion of a class. A central property of classes is what elements, expressed by the membership operator ` e. ` , belong to them . Quantification ( ` A. x ` ) applies only to objects that a variable of kind setvar can represent. These objects will henceforth be called sets. Some classes may not be sets; these are called proper classes. It remains open at this stage whether membership can involve them. The formula given in ~ df-cleq (restated below) asserts that two classes are equal if and only if they have exactly the same sets as elements. If proper classes are also admitted as elements, then two equal classes could still differ by such elements, potentially violating Leibniz's Law. A future axiom ~ df-clel addresses this issue; ~ df-cleq alone does not. **Primitive connectives and class builders** Specially crafted primitive operators on classes or class builders could introduce properties of classes beyond membership, not reflected in the formula here. This again risks violating Leibniz's Law. Therefore, the introduction of any future primitive operator or class builder must include a conservativity check to ensure consistency with Leibniz's Law. **This axiom covers only some principles of equality** The notion of equality expressed in this axiom does not automatically coincide with the general notion of equality. Some principles are, however, already captured: Equality is shown to be an equivalence relation, covering transivity ( ~ eqtr ), reflexivity ( ~ eqid ) and symmetry ( ~ eqcom ). It also yields the class-level version of ~ ax-ext (the backward direction of ~ df-cleq ) holds. If we assume ` x = A ` holds, then substituting the free set variable ` y ` with ` A ` in ~ ax6ev and ~ ax12v2 yields provable theorems (see ~ wl-isseteq , and ~ wl-ax12v2cl ). However, a bound variable cannot be replaced with a class variable, since quantification over classes is not permitted. Taken together with the results from the previous paragraph, this shows that a class variable equal to a set behaves the same as a set variable, provided it is not quantified. **Conservativity** Moreover, this axiom is already partly derivable if all class variables are replaced by variables of type "setvar". In that case, the statement reduces to an instance of ~ axextb . This shows that the class builder ~ cv is consistent with this axiom. **Eliminable operator** Finally, this axiom supports the idea that proper classes, and operators between them, should be eliminable, as required by ZF: It reduces equality to their membership properties. However, since the term ` x e. A ` is still undefined, elimination reduces equality to just something not yet clarified. **Axiom vs Definition** Up to this point, the only content involving class variables comes from the syntax definitions ~ wceq and ~ wcel . Axioms are therefore required to progressively refine the semantics of classes until provable results coincide with our intended conception of set theory. This refinement process is explained in Step 4 of ~ wl-cleq-2 . From this perspective, ~ df-cleq is in fact an axiom in disguise and would more appropriately be named ax-cleq. At first glance, one might think that ` A = B ` is defined by the right-hand side of the biconditional. This would make ` x e. A ` , i.e. membership of a set in a class, the more primitive concept, from which equality of classes could be derived. Such a viewpoint would be coherent if the properties of membership could be fully determined by other axioms. In my (WL's') opinion, however, the more direct and fruitful approach is not to construct class equality from membership, but to treat equality itself as axiomatic. (Contributed by Wolf Lammen, 25-Aug-2025.)
axiom ax_wl_cleq {x3: setvar} (A2 B2: class):
  $ wb (wceq A2 B2) (wal x3 (wb (wcel (cv x3) A2) (wcel (cv x3) B2))) $;

--| Disclaimer: The material presented here is just my (WL's) personal perception. I am not an expert in this field, so some or all of the text here can be misleading, or outright wrong. This text should be read as an exploration rather than as a definite statement, open to doubt, alternatives, and reinterpretation. The formula in ~ df-clel (restated below) states that only those classes for which ` E. x x = A ` holds can be members of classes. Thus, a member of a class is always equal to a set, which excludes proper classes from class membership. As explained in ~ wl-cleq-4 , item 3, ` E. x x = A ` is a sufficient criterion for a class to be a set, provided that Leibniz's Law holds for equality. Therefore this axiom is often rephrased as: classes contain only sets as members. **Principles of equality** Using this axiom we can derive the class-level counterparts of ~ ax-8 (see ~ eleq2 ) and ~ ax-9 (see ~ eleq1 ). Since ~ ax-wl-cleq already asserts that equality between classes is an equivalence relation, the operators ` = ` and ` e. ` alone cannot distinguish equal classes. Hence, if membership is the only property that matters for classes, Leibniz's Law will hold. Later, however, additional class builders may introduce further properties of classes. A conservativity check for such builders can ensure this does not occur. **Eliminability** If we replace the class variable ` A ` with a set variable ` z ` in this axiom, the auxiliary variable ` x ` can be eliminated, leaving only the trivial result ` ( z e. B <-> z e. B ) ` . Thus, ~ df-clel by itself does not determine when a set is a member of a class. From this perspective, ~ df-clel is in fact an axiom in disguise and would more appropriately be called ax-clel. Overall, our axiomization leaves the meaning of fundamental expressions ` x e. A ` or ` x e. B ` open. All other fundamental formulas of set theory ( ` A ` not a set variable, ` A e. B ` , ` x = B ` ` A = B ` ) can be reduced solely to the basic formulas ` x e. A ` or ` x e. B ` . If an axiomatization leaves a fundamental formula like ` x e. A ` unspecified, we could in principle define it bi-conditionally by any formula whatsoever - for example, the trivial ` T. ` . This, however, is not the approach we take. Instead, an appropriate class builder such as ~ df-clab fills this gap. (Contributed by Wolf Lammen, 26-Aug-2025.)
axiom ax_wl_clel {x3: setvar} (A2 B2: class):
  $ wb (wcel A2 B2) (wex x3 (wa (wceq (cv x3) A2) (wcel (cv x3) B2))) $;

--| Disclaimer: The material presented here is just my (WL's) personal perception. I am not an expert in this field, so some or all of the text here can be misleading, or outright wrong. This text should be seen as an exploration, rather than viewing it as set in stone, no doubt or alternatives possible. We now introduce the notion of class abstraction, which allows us to describe a specific class, in contrast to class variables that can stand for any class indiscriminately. A new syntactic form is introduced for class abstractions, ` { y | ph } ` , read as "the class of sets ` y ` such that ` ph ( y ) ` ". This form is assigned the type "class" in ~ cab , so it can consistently substitute for a class variable during the syntactic construction process. **Eliminability** The axioms ~ ax-wl-cleq and ~ ax-wl-clel leave only ` x e. A ` unspecified. The definition of this class builder directly corresponds to that expression. When a class abstraction replaces the variable ` A ` and ` B ` , then ` A = B ` and ` A e. B ` can be expressed in terms of these abstractions. For general eliminability two conditions are needed: 1. Any class builder must replace ` x e. A ` with an expression containing no class variables. If necessary, class variables must be eliminated via a finite recursive process. 2. There must only be finitely many class builders. If a class variable could range over infinitely many builders, eliminability would fail, since unknown future builders would always need to be considered. Condition (2) is met in set.mm by defining no class builder beyond ~ cv and ~ df-clab . Thus we may assume that a class variable represents either a set variable, or a class abstraction: a. If it represents a set variable, substitution eliminates it immediately. b. If it equals a set variable ` x ` , then by ~ cvjust it can be replaced with ` { y | y e. x } ` . c. If it represents a proper class, then it equals some abstraction ` { x | ph } ` . If ` ph ` contains no class variables, elimination using ` ph ` is possible. The same holds if finite sequence of elimination steps renders ` ph ` free of class variables. d. It represents a proper class, but ` ph ` in ` { x | ph } ` still contains non-eliminable class variables, then eliminability fails. A simple example is ` { x | x e. A } ` . Class variables can only appear in fundamental expressions ` A = B ` or ` A e. B ` , Both can be reduced to forms involving ` z e. A ` . Thus, in the expression ` z e. { x | x e. A } ` , we still must eliminate ` A ` . Applying ~ df-clab reduces it back to ` z e. A ` , returning us to the starting point. Case (d) shows that in full generality, a class variable cannot always be eliminated, something Zermelo-Fraenkel set theory (ZF) requires. If the universe contained only finitely many sets, a free class variable ` A ` could be expressed as a finite disjunction of possiblities, hence eliminable. But in ZF's richer universe, in a definition of an unrestricted class variable ` A = { x | ph } ` the variable ` ph ` will contain ` A ` in some way, violating condition (1) above. Thus constraints are needed. In ZF, any formula containing class variables assumes that non-set class variables can be be replaced by ` { x | ph } ` where ` ph ` itself contains no class variables. There is, however, no way to state this condition in a formal way in set.mm. Class abstractions themselves, however, can be eliminated, so df-clab is a definition. **Definition checker** How can case (d) be avoided? A solution is to restrict generality: require that in the definition of any concrete class abstraction ` { x | ph } ` , the formula ` ph ` is either free of class variables or built only from previously defined constructions. Such a restriction could be part of the definition checker. In practice, the Metamath definition checker requires definitions to follow the specific pattern " ` |- { x | ph } = ... ` ". Although ~ df-clab does not conform to this pattern, it nevertheless permits elimination of class abstractions. Eliminability is the essential property of a valid definition, so ~ df-clab can legitimately be regarded as one. For further material on the elimination of class abstractions, see BJ's work beginning with ~ eliminable1 and one comment in https://github.com/metamath/set.mm/pull/4971. (Contributed by Wolf Lammen, 28-Aug-2025.)
theorem wl_df_clab {y1: setvar} (ph: wff y1) (x3: setvar):
  $ wb (wcel (cv x3) (cab y1 ph)) (wsb y1 ph x3) $;

--| A class equal to a set variable implies it is a set. Note that ` A ` may be dependent on ` x ` . The consequent, resembling ~ ax6ev , is the accepted expression for the idea of a class being a set. Sometimes a simpler expression like the antecedent here, or in ~ elisset , is already sufficient to mark a class variable as a set. (Contributed by Wolf Lammen, 7-Sep-2025.)
theorem wl_isseteq {y1: setvar} (x3: setvar) (A2: class):
  $ wi (wceq (cv x3) A2) (wex y1 (wceq (cv y1) A2)) $;

--| The class version of ~ ax12v2 , where the set variable ` y ` is replaced with the class variable ` A ` . This is possible if ` A ` is known to be a set, expressed by the antecedent. Theorem ~ ax12v is a specialization of ~ ax12v2 . So any proof using ~ ax12v will still hold if ~ ax12v2 is used instead. Theorem ~ ax12v2 expresses that two equal set variables cannot be distinguished by whatever complicated formula ` ph ` if one is replaced with the other in it. This theorem states a similar result for a class variable known to be a set: All sets equal to the class variable behave the same if they replace the class variable in ` ph ` . Most axioms in FOL containing an equation correspond to a theorem where a class variable known to be a set replaces a set variable in the formula. Some exceptions cannot be avoided: The set variable must nowhere be bound. And it is not possible to state a distinct variable condition where a class ` A ` is different from another, or distinct from a variable with type wff. So ~ ax-12 proper is out of reach: you cannot replace ` y ` in ` A. y ph ` with a class variable. But where such limitations are not violated, the proof of the FOL theorem should carry over to a version where a class variable, known to be set, appears instead of a set variable. (Contributed by Wolf Lammen, 8-Aug-2020.)
theorem wl_ax12v2cl {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wi (wex y1 (wceq (cv y1) A2)) (wi (wceq (cv x3) A2) (wi ph (wal x3 (wi (wceq (cv x3) A2) ph)))) $;

--| Define class abstractions, that is, classes of the form ` { y | ph } ` , which is read "the class of sets ` y ` such that ` ph ( y ) ` ". A few remarks are in order: 1. The axiomatic statement ~ df-clab does not define the class abstraction ` { y | ph } ` itself, that is, it does not have the form ` |- { y | ph } = ... ` that a standard definition should have (for a good reason: equality itself has not yet been defined or axiomatized for class abstractions; it is defined later in ~ df-cleq ). Instead, ~ df-clab has the form ` |- ( x e. { y | ph } <-> ... ) ` , meaning that it only defines what it means for a setvar to be a member of a class abstraction. As a consequence, one can say that ~ df-clab defines class abstractions if and only if a class abstraction is completely determined by which elements belong to it, which is the content of the axiom of extensionality ~ ax-ext . Therefore, ~ df-clab can be considered a definition only in systems that can prove ~ ax-ext (and the necessary first-order logic). 2. As in all definitions, the definiendum (the left-hand side of the biconditional) has no disjoint variable conditions. In particular, the setvar variables ` x ` and ` y ` need not be distinct, and the formula ` ph ` may depend on both ` x ` and ` y ` . This is necessary, as with all definitions, since if there was for instance a disjoint variable condition on ` x , y ` , then one could not do anything with expressions like ` x e. { x | ph } ` which are sometimes useful to shorten proofs (because of ~ abid ). Most often, however, ` x ` does not occur in ` { y | ph } ` and ` y ` is free in ` ph ` . 3. Remark 1 stresses that ~ df-clab does not have the standard form of a definition for a class, but one could be led to think it has the standard form of a definition for a formula. However, it also fails that test since the membership predicate ` e. ` has already appeared earlier (outside of syntax e.g. in ~ ax-8 ). Indeed, the definiendum extends, or "overloads", the membership predicate ` e. ` from formulas of the form "setvar ` e. ` setvar" to formulas of the form "setvar ` e. ` class abstraction". This is possible because of ~ wcel and ~ cab , and it can be called an "extension" of the membership predicate because of ~ wel , whose proof uses ~ cv . An _a posteriori_ justification for ~ cv is given by ~ cvjust , stating that every setvar can be written as a class abstraction (though conversely not every class abstraction is a set, as illustrated by Russell's paradox ~ ru ). 4. Proof techniques. Because class variables can be substituted with compound expressions and setvar variables cannot, it is often useful to convert a theorem containing a free setvar variable to a more general version with a class variable. This is done with theorems such as ~ vtoclg which is used, for example, to convert ~ elirrv to ~ elirr . 5. Definition or axiom? The question arises with the three axiomatic statements introducing classes, ~ df-clab , ~ df-cleq , and ~ df-clel , to decide if they qualify as definitions or if they should be called axioms. Under the strict definition of "definition" (see ~ conventions ), they are not definitions (see Remarks 1 and 3 above, and similarly for ~ df-cleq and ~ df-clel ). One could be less strict and decide to call "definition" every axiomatic statement which provides an eliminable and conservative extension of the considered axiom system. But the notion of conservativity may be given two different meanings in set.mm, due to the difference between the "scheme level" of set.mm and the "object level" of classical treatments. For a proof that these three axiomatic statements yield an eliminable and weakly (that is, object-level) conservative extension of FOL= plus ~ ax-ext , see Appendix of [Levy] p. 357. 6. This definition (or axiom) is a _class builder_ introducing the class ` { x | ph } ` , also called a _class abstraction_ or _class comprehension_, i.e., it specifies a class by a condition determining its members. Another class-building operator (but no class abstraction) is ~ cv , which asserts that every set is a class. The converse need not hold: not every class is a set. A class that is not a set is called a _proper class_. From ~ ru , it follows that this abstraction yields proper classes, e.g. ` { x | x = x } ` . 7. References and history. The concept of class abstraction dates back to at least Frege, and is used by Whitehead and Russell. This definition is Definition 2.1 of [Quine] p. 16 and Axiom 4.3.1 of [Levy] p. 12. It is called the "axiom of class comprehension" by [Levy] p. 358, who treats the theory of classes as an extralogical extension to predicate logic and set theory axioms. He calls the construction ` { y | ph } ` a "class term". For a full description of how classes are introduced and how to recover the primitive language, see the books of Quine and Levy (and the comment of ~ eqabb for a quick overview). For a general discussion of the theory of classes, see ~ mmset.html#class . (Contributed by NM, 26-May-1993.) (Revised by BJ, 19-Aug-2023.)
theorem wl_df_clab1 {y1: setvar} (ph: wff y1) (x3: setvar):
  $ wb (wcel (cv x3) (cab y1 ph)) (wsb y1 ph x3) $;

--| Define the equality connective between classes. Definition 2.7 of [Quine] p. 18. Also Definition 4.5 of [TakeutiZaring] p. 13; Chapter 4 provides its justification and methods for eliminating it. Note that its elimination will not necessarily result in a single wff in the original language but possibly a "scheme" of wffs. The hypotheses express that all instances of the conclusion where class variables are replaced with setvar variables hold. Therefore, this definition merely extends to class variables something that is true for setvar variables, hence is conservative. This is only a proof sketch of conservativity; for details see Appendix of [Levy] p. 357. This is the reason why we call this axiomatic statement a "definition", even though it does not have the usual form of a definition. If we required a definition to have the usual form, we would call ~ df-cleq an axiom. See also comments under ~ df-clab , ~ df-clel , and ~ eqabb . In the form of ~ dfcleq , this is called the "axiom of extensionality" by [Levy] p. 338, who treats the theory of classes as an extralogical extension to our logic and set theory axioms. It characterizes classes as collections of sets. While the three class definitions ~ df-clab , ~ df-cleq , and ~ df-clel are eliminable and conservative and thus meet the requirements for sound definitions, they are technically axioms in that they do not satisfy the requirements for the current definition checker. The proofs of conservativity require external justification that is beyond the scope of the definition checker. For a general discussion of the theory of classes, see ~ mmset.html#class . (Contributed by NM, 15-Sep-1993.) (Revised by BJ, 24-Jun-2019.)
theorem wl_df_cleq {x3 y1 z v u t: setvar} (A2 B2: class):
  $ wb (wceq (cv y1) (cv z)) (wal u (wb (wcel (cv u) (cv y1)) (wcel (cv u) (cv z)))) $ >
  $ wb (wceq (cv t) (cv t)) (wal v (wb (wcel (cv v) (cv t)) (wcel (cv v) (cv t)))) $ >
  $ wb (wceq A2 B2) (wal x3 (wb (wcel (cv x3) A2) (wcel (cv x3) B2))) $;

--| This theorem is a conservative extension of ~ ax-ext to classes, with no hypotheses. It is not complete, since ~ ax-8 can be derived (see ~ in-ax8 ) via alpha-renaming. Although unsuitable for general use, it is adequate for the development of theorems unaffected by alpha-renaming, including: 1. Theorems with no bound variables in the hypotheses or conclusion (see ~ eqriv ). 2. Theorems using the same bound variable throughout (see ~ abbib ). 3. Theorems with distinct bound variables arising only through implicit substitution (see ~ eqabbw ). Remark: the proof uses ~ axextb to prove the hypothesis of ~ df-cleq that is a degenerate instance, but it could be proved also from minimal propositional calculus and { ~ ax-gen , ~ equid }. (Contributed by NM, 15-Sep-1993.) (Revised by BJ, 24-Jun-2019.)
theorem wl_dfcleq_basic {x3: setvar} (A2 B2: class):
  $ wb (wceq A2 B2) (wal x3 (wb (wcel (cv x3) A2) (wcel (cv x3) B2))) $;

--| The hypotheses added to this version of ~ df-cleq address the following: 1. Equality of classes is an equivalence relation, as expected of equality. 2. Equality of classes obeys the Law of Indiscernibles (Leibniz's Law), and is compatible with class membership. 3. Alpha-renaming is explicitly permitted. (Contributed by Wolf Lammen, 7-Apr-2026.)
theorem wl_dfcleq_just {x3 y1: setvar} (A2 B2: class) (C: class x3 y1):
  $ wb (wal x3 (wb (wcel (cv x3) A2) (wcel (cv x3) B2))) (wal y1 (wb (wcel (cv y1) A2) (wcel (cv y1) B2))) $ >
  $ wceq A2 A2 $ >
  $ wi (wceq A2 B2) (wi (wceq B2 C) (wceq C A2)) $ >
  $ wi (wceq A2 B2) (wi (wcel A2 C) (wcel B2 C)) $ >
  $ wi (wceq A2 B2) (wi (wcel C A2) (wcel C B2)) $ >
  $ wb (wceq A2 B2) (wal x3 (wb (wcel (cv x3) A2) (wcel (cv x3) B2))) $;

--| Define the membership connective between classes. Theorem 6.3 of [Quine] p. 41, or Proposition 4.6 of [TakeutiZaring] p. 13, which we adopt as a definition. See these references for its metalogical justification. The hypotheses assert that every instance of the conclusion obtained by substituting the class variables with set variables already holds. Thus, this definition extends to class variables a relation already valid for set variables, and is therefore conservative. This only sketches the conservativity arguement; for details see Appendix of [Levy] p. 357. For this reason we regard this statement as a "definition", even though it does not have the usual form of a definition. Under a stricter syntactic criterion, ~ df-clel would instead be an axiom. See also comments under ~ df-clab , ~ df-cleq , and ~ eqabb . Alternate characterizations of ` A e. B ` when either ` A ` or ` B ` is a set are given by ~ clel2g , ~ clel3g , and ~ clel4g . [Levy] p. 338 refers to this as the "axiom of membership", treating the theory of classes as an extralogical extension to our logic and set theory axioms. Under this definition, class members can only be sets; classes are therefore collections of sets. Although the extensionality expressed in ~ df-cleq already points in this direction, an unusual interpretation of equality could still permit proper classes as members. Although the class definitions ~ df-clab , ~ df-cleq , and ~ df-clel are eliminable and conservative, and hence meet the requirements for sound definitions, they are technically axioms in that they do not satisfy the syntactic requirements enforced by the current definition checker. The conservativity proofs require external justification beyond the scope of the checker. For a general discussion of the theory of classes, see ~ mmset.html#class . (Contributed by NM, 26-May-1993.) (Revised by BJ, 27-Jun-2019.)
theorem wl_df_clel {x3 y1 z v u t: setvar} (A2 B2: class):
  $ wb (wcel (cv y1) (cv z)) (wex u (wa (wceq (cv u) (cv y1)) (wcel (cv u) (cv z)))) $ >
  $ wb (wcel (cv t) (cv t)) (wex v (wa (wceq (cv v) (cv t)) (wcel (cv v) (cv t)))) $ >
  $ wb (wcel A2 B2) (wex x3 (wa (wceq (cv x3) A2) (wcel (cv x3) B2))) $;

--| This theorem gives a conservative extension of membership of classes, without hypotheses. Conservativity alone, however, is insufficient, since issues involving alpha-renaming can still arise, see ~ in-ax8 . Although unsuitable for general use, it is adequate for the development of theorems unaffected by alpha-renaming, including: 1. Theorems whose hypotheses and conclusion contain no bound variables (see ~ eleq1w ). 2. Theorems using the same bound variable throughout (see ~ elex2 ). 3. Theorems in which distinct bound variables arise only through implicit substitution (see ~ eqabbw ). (Contributed by BJ, 27-Jun-2019.)
theorem wl_dfclel_basic {x3: setvar} (A2 B2: class):
  $ wb (wcel A2 B2) (wex x3 (wa (wceq (cv x3) A2) (wcel (cv x3) B2))) $;

--| Add a hypothesis to ~ wl-dfclel.basic , that permits alpha-renaming. (Contributed by Wolf Lammen, 7-Apr-2026.)
theorem wl_dfclel_just {x3 y1: setvar} (A2 B2: class):
  $ wb (wex x3 (wa (wceq (cv x3) A2) (wcel (cv x3) B2))) (wex y1 (wa (wceq (cv y1) A2) (wcel (cv y1) B2))) $ >
  $ wb (wcel A2 B2) (wex x3 (wa (wceq (cv x3) A2) (wcel (cv x3) B2))) $;

--| The defining characterization of class equality. This version of ~ df-cleq has no restrictions, unlike the forms on which it is based. It is proved in Tarski's FOL from the axiom of extensionality ( ~ ax-ext ), the definition of class equality ( ~ df-cleq ), and the definition of class membership ( ~ df-clel ). Its forward implication is known as "class extensionality". (Contributed by NM, 15-Sep-1993.) (Revised by BJ, 24-Jun-2019.) Base on ~ wl-dfcleq.just . (Revised by Wolf Lammen, 7-Apr-2026.)
theorem wl_dfcleq {x3: setvar} (A2 B2: class):
  $ wb (wceq A2 B2) (wal x3 (wb (wcel (cv x3) A2) (wcel (cv x3) B2))) $;

--| The defining characterization of class membership. Unlike the forms on which it is based, it is unrestricted. Proven in Tarski's FOL, from the axiom of (set) extensionality ( ~ ax-ext ), the definitions ~ df-clel and df-cleq . (Contributed by BJ, 27-Jun-2019.) Base on ~ wl-dfclel.just . (Revised by Wolf Lammen, 13-Apr-2026.)
theorem wl_dfclel {x3: setvar} (A2 B2: class):
  $ wb (wcel A2 B2) (wex x3 (wa (wceq (cv x3) A2) (wcel (cv x3) B2))) $;

--| Replacing a nested consequent. A sort of _modus ponens_ in antecedent position. (Contributed by Wolf Lammen, 20-Sep-2013.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem wl_mps (ph ps ch th: wff):
  $ wi ph (wi ps ch) $ >
  $ wi (wi ph ch) th $ >
  $ wi (wi ph ps) th $;

--| Replacing a nested consequent. A sort of syllogism in antecedent position. (Contributed by Wolf Lammen, 20-Sep-2013.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem wl_syls1 (ph ps ch th: wff):
  $ wi ps ch $ >
  $ wi (wi ph ch) th $ >
  $ wi (wi ph ps) th $;

--| Replacing a nested antecedent. A sort of syllogism in antecedent position. (Contributed by Wolf Lammen, 20-Sep-2013.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem wl_syls2 (ph ps ch th: wff):
  $ wi ph ps $ >
  $ wi (wi ph ch) th $ >
  $ wi (wi ps ch) th $;

--| A true wff can always be added as a nested antecedent to an antecedent. Note: this theorem is intuitionistically valid. (Contributed by Wolf Lammen, 4-Oct-2013.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem wl_embant (ph ps ch: wff):
  $ ph $ >
  $ wi ps ch $ >
  $ wi (wi ph ps) ch $;

--| In a conjunctive normal form a pair of nodes like ` ( ph \/ ps ) /\ ( -. ph \/ ch ) ` eliminates the need of a node ` ( ps \/ ch ) ` . This theorem allows simplifications in that respect. (Contributed by Wolf Lammen, 20-Jun-2020.)
theorem wl_orel12 (ph ps ch: wff):
  $ wi (wa (wo ph ps) (wo (wn ph) ch)) (wo ps ch) $;

--| A particular instance of ~ orddi and ~ anddi converting between disjunctive and conjunctive normal forms, when both ` ph ` and ` -. ph ` appear. This theorem in fact rephrases ~ cases2 , and is related to ~ consensus . I restate it here in DNF and CNF. The proof deliberately does not use ~ df-ifp and ~ dfifp4 , by which it can be shortened. (Contributed by Wolf Lammen, 21-Jun-2020.) (Proof modification is discouraged.)
theorem wl_cases2_dnf (ph ps ch: wff):
  $ wb (wo (wa ph ps) (wa (wn ph) ch)) (wa (wo (wn ph) ps) (wo ph ch)) $;

--| Change bound variable. Uses only Tarski's FOL axiom schemes. Part of Lemma 7 of [KalishMontague] p. 86. (Contributed by Wolf Lammen, 5-Mar-2023.)
theorem wl_cbvmotv {x3 y1: setvar}:
  $ wi (wmo x3 wtru) (wmo y1 wtru) $;

--| Change bound variable. Uses only Tarski's FOL axiom schemes. Part of Lemma 7 of [KalishMontague] p. 86. (Contributed by Wolf Lammen, 5-Mar-2023.)
theorem wl_moteq {x3 y1: setvar} (z: setvar):
  $ wi (wmo x3 wtru) (wceq (cv y1) (cv z)) $;

--| Change bound variable. Uses only Tarski's FOL axiom schemes. Part of Lemma 7 of [KalishMontague] p. 86. (Contributed by Wolf Lammen, 5-Mar-2023.)
theorem wl_motae {x3 y1 u: setvar} (z: setvar):
  $ wi (wmo u wtru) (wal x3 (wceq (cv y1) (cv z))) $;

--| Change bound variable. Uses only Tarski's FOL axiom schemes. Part of Lemma 7 of [KalishMontague] p. 86. (Contributed by Wolf Lammen, 5-Mar-2023.)
theorem wl_motae_b {x3: setvar} (z: setvar):
  $ wi (wmo x3 wtru) (wal x3 (wceq (cv x3) (cv z))) $;

--| Two ways to express "at most one thing exists" or, in this context equivalently, "exactly one thing exists" . The equivalence results from the presence of ~ ax-6 in the proof, that ensures "at least one thing exists". For other equivalences see ~ wl-euae and ~ exists1 . Gerard Lang pointed out, that ` E. y A. x x = y ` with disjoint ` x ` and ` y ` ( ~ dfmo , ~ trut ) also means "exactly one thing exists" . (Contributed by NM, 5-Apr-2004.) State the theorem using truth constant ` T. ` . (Revised by BJ, 7-Oct-2022.) Reduce axiom dependencies, and use ` E* ` . (Revised by Wolf Lammen, 7-Mar-2023.)
theorem wl_moae {x3 y1: setvar}:
  $ wb (wmo x3 wtru) (wal x3 (wceq (cv x3) (cv y1))) $;

--| Two ways to express "exactly one thing exists" . (Contributed by Wolf Lammen, 5-Mar-2023.)
theorem wl_euae {x3 y1: setvar}:
  $ wb (weu x3 wtru) (wal x3 (wceq (cv x3) (cv y1))) $;

--| The following series of theorems are centered around the empty domain, where no set exists. As a consequence, a set variable like ` x ` has no instance to assign to. An expression like ` x = y ` is not really meaningful then. What does it evaluate to, true or false? In fact, the grammar extension ~ weq requires us to formally assign a boolean value to an equation, say always false, unless you want to give up on ~ exmid , for example. Whatever it is, we start out with the contraposition of ~ ax-6 , that guarantees the existence of at least one set. Our hypothesis here expresses tentatively it might not hold. We can simplify the antecedent then, to the point where we do not need equation any more. This suggests what a decent characterization of the empty domain of discourse could be. (Contributed by Wolf Lammen, 12-Mar-2023.)
theorem wl_nax6im {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wn (wex x3 (wceq (cv x3) (cv y1)))) ph $ >
  $ wi (wn (wex x3 wtru)) ph $;

--| This specialization of ~ hbae does not depend on ~ ax-11 . (Contributed by Wolf Lammen, 8-Aug-2021.)
theorem wl_hbae1 {x3 y1: setvar}:
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wal y1 (wal x3 (wceq (cv x3) (cv y1)))) $;

--| An instance of ~ hbn1w applied to equality. (Contributed by Wolf Lammen, 7-Apr-2021.)
theorem wl_naevhba1v {x3: setvar} (y1: setvar):
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wal x3 (wn (wal x3 (wceq (cv x3) (cv y1))))) $;

--| Prove an instance of ~ sp from ~ ax-13 and Tarski's FOL only, without distinct variable conditions. The antecedent ` A. x x = y ` holds in a multi-object universe only if ` y ` is substituted for ` x ` , or vice versa, i.e. both variables are effectively the same. The converse ` -. A. x x = y ` indicates that both variables are distinct, and it so provides a simple translation of a distinct variable condition to a logical term. In case studies ` A. x x = y ` and ` -. A. x x = y ` can help eliminating distinct variable conditions. The antecedent ` A. x x = y ` is expressed in the theorem's name by the abbreviation ae standing for 'all equal'. Note that we cannot provide a logical predicate telling us directly whether a logical expression contains a particular variable, as such a construct would usually contradict ~ ax-12 . Note that this theorem is also provable from ~ ax-12 alone, so you can pick the axiom it is based on. Compare this result to ~ 19.3v and ~ spaev having distinct variable conditions, but a smaller footprint on axiom usage. (Contributed by Wolf Lammen, 5-Apr-2021.)
theorem wl_spae {x3 y1: setvar}:
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wceq (cv x3) (cv y1)) $;

--| Under the assumption ` -. x = y ` a specialized version of ~ sp is provable from Tarski's FOL and ~ ax13v only. Note that this reverts the implication in ~ ax13lem1 , so in fact ` ( -. x = y -> ( A. x z = y <-> z = y ) ) ` holds. (Contributed by Wolf Lammen, 17-Apr-2021.)
theorem wl_speqv {x3 y1 z: setvar}:
  $ wi (wn (wceq (cv x3) (cv y1))) (wi (wal x3 (wceq (cv z) (cv y1))) (wceq (cv z) (cv y1))) $;

--| Under the assumption ` -. x = y ` a specialized version of ~ 19.8a is provable from Tarski's FOL and ~ ax13v only. Note that this reverts the implication in ~ ax13lem2 , so in fact ` ( -. x = y -> ( E. x z = y <-> z = y ) ) ` holds. (Contributed by Wolf Lammen, 17-Apr-2021.)
theorem wl_19_8eqv {x3 y1 z: setvar}:
  $ wi (wn (wceq (cv x3) (cv y1))) (wi (wceq (cv z) (cv y1)) (wex x3 (wceq (cv z) (cv y1)))) $;

--| Under the assumption ` -. x = y ` the reverse direction of ~ 19.2 is provable from Tarski's FOL and ~ ax13v only. Note that in conjunction with ~ 19.2 in fact ` ( -. x = y -> ( A. x z = y <-> E. x z = y ) ) ` holds. (Contributed by Wolf Lammen, 17-Apr-2021.)
theorem wl_19_2reqv {x3 y1 z: setvar}:
  $ wi (wn (wceq (cv x3) (cv y1))) (wi (wex x3 (wceq (cv z) (cv y1))) (wal x3 (wceq (cv z) (cv y1)))) $;

--| If ` x ` is not present in ` ph ` , it is not free in ` A. y ph ` . (Contributed by Wolf Lammen, 11-Jan-2020.)
theorem wl_nfalv {x3 y1: setvar} (ph: wff y1):
  $ wnf x3 (wal y1 ph) $;

--| An antecedent is irrelevant to a not-free property, if it always holds. I used this variant of ~ nfim in ~ dvelimdf to simplify the proof. (Contributed by Wolf Lammen, 14-Oct-2018.)
theorem wl_nfimf1 {x3: setvar} (ph ps: wff x3):
  $ wi (wal x3 ph) (wb (wnf x3 (wi ph ps)) (wnf x3 ps)) $;

--| Unlike ~ nfae , this specialized theorem avoids ~ ax-11 . (Contributed by Wolf Lammen, 26-Jun-2019.)
theorem wl_nfae1 {x3 y1: setvar}:
  $ wnf x3 (wal y1 (wceq (cv y1) (cv x3))) $;

--| Unlike ~ nfnae , this specialized theorem avoids ~ ax-11 . (Contributed by Wolf Lammen, 27-Jun-2019.)
theorem wl_nfnae1 {x3 y1: setvar}:
  $ wnf x3 (wn (wal y1 (wceq (cv y1) (cv x3)))) $;

--| A transitive law for variable identifying expressions. (Contributed by Wolf Lammen, 30-Jun-2019.)
theorem wl_aetr {x3 y1: setvar} (z: setvar):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wi (wal x3 (wceq (cv x3) (cv z))) (wal y1 (wceq (cv y1) (cv z)))) $;

--| Same as ~ axc11r , but using ~ ax12 instead of ~ ax-12 directly. This better reflects axiom usage in theorems dependent on it. (Contributed by NM, 25-Jul-2015.) Avoid direct use of ~ ax-12 . (Revised by Wolf Lammen, 30-Mar-2024.)
theorem wl_axc11r {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal y1 (wceq (cv y1) (cv x3))) (wi (wal x3 ph) (wal y1 ph)) $;

--| A version of ~ dral1 with a context. Note: At first glance one might be tempted to generalize this (or a similar) theorem by weakening the first two hypotheses adding a ` x = y ` , ` A. x x = y ` or ` ph ` antecedent. ~ wl-equsal1i and ~ nf5di show that this is in fact pointless. (Contributed by Wolf Lammen, 28-Jul-2019.)
theorem wl_dral1d {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wi ph (wi (wceq (cv x3) (cv y1)) (wb ps ch)) $ >
  $ wi ph (wi (wal x3 (wceq (cv x3) (cv y1))) (wb (wal x3 ps) (wal y1 ch))) $;

--| ~ wl-cbvalnae with a context. (Contributed by Wolf Lammen, 28-Jul-2019.)
theorem wl_cbvalnaed {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wi ph (wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wnf y1 ps)) $ >
  $ wi ph (wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wnf x3 ch)) $ >
  $ wi ph (wi (wceq (cv x3) (cv y1)) (wb ps ch)) $ >
  $ wi ph (wb (wal x3 ps) (wal y1 ch)) $;

--| A more general version of ~ cbval when nonfree properties depend on a distinctor. Such expressions arise in proofs aiming at the elimination of distinct variable constraints, specifically in application of ~ dvelimf , ~ nfsb2 or ~ dveeq1 . (Contributed by Wolf Lammen, 4-Jun-2019.)
theorem wl_cbvalnae {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wnf y1 ph) $ >
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wnf x3 ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wal x3 ph) (wal y1 ps) $;

--| The semantics of ` E. x y = z ` . (Contributed by Wolf Lammen, 27-Apr-2018.)
theorem wl_exeq {x3 y1 z: setvar}:
  $ wb (wex x3 (wceq (cv y1) (cv z))) (w3o (wceq (cv y1) (cv z)) (wal x3 (wceq (cv x3) (cv y1))) (wal x3 (wceq (cv x3) (cv z)))) $;

--| The semantics of ` A. x y = z ` . (Contributed by Wolf Lammen, 27-Apr-2018.)
theorem wl_aleq {x3 y1 z: setvar}:
  $ wb (wal x3 (wceq (cv y1) (cv z))) (wa (wceq (cv y1) (cv z)) (wb (wal x3 (wceq (cv x3) (cv y1))) (wal x3 (wceq (cv x3) (cv z))))) $;

--| Extend ~ nfeqf to an equivalence. (Contributed by Wolf Lammen, 31-Jul-2019.)
theorem wl_nfeqfb {x3 y1 z: setvar}:
  $ wb (wnf x3 (wceq (cv y1) (cv z))) (wb (wal x3 (wceq (cv x3) (cv y1))) (wal x3 (wceq (cv x3) (cv z)))) $;

--| If ` y ` is not free in ` ph ` , ` x ` is not free in ` [ y / x ] ph ` . Closed form of ~ nfs1 . (Contributed by Wolf Lammen, 27-Jul-2019.)
theorem wl_nfs1t {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wnf y1 ph) (wnf x3 (wsb x3 ph y1)) $;

--| Version of ~ equsalv with a disjoint variable condition, and of ~ equsal with two disjoint variable conditions, which requires fewer axioms. See also the dual form ~ equsexvw . This theorem lays the foundation to a transformation of expressions called substitution of set variables in a wff. Only in this particular context we additionally assume ` ph ` and ` y ` disjoint, stated here as ` ph ( x ) ` . Similarly the disjointness of ` ps ` and ` x ` is expressed by ` ps ( y ) ` . Both ` ph ` and ` ps ` may still depend on other set variables, but that is irrelevant here. We want to transform ` ph ( x ) ` into ` ps ( y ) ` such that ` ps ` depends on ` y ` the same way as ` ph ` depends on ` x ` . This dependency is expressed in our hypothesis (called implicit substitution): ` ( x = y -> ( ph <-> ps ) ) ` . For primitive enough ` ph ` a sort of textual substitution of ` x ` by ` y ` is sufficient for such transformation. But note: ` ph ` must not contain wff variables, and the substitution is no proper textual substitution either. We still need grammar information to not accidently replace the x in a token 'x.' denoting multiplication, but only catch set variables ` x ` . Our current stage of development allows only equations and quantifiers make up such primitives. Thanks to ~ equequ1 and ~ cbvalvw we can then prove in a mechanical way that in fact the implicit substitution holds for each instance. If ` ph ` contains wff variables we cannot use textual transformation any longer, since we don't know how to replace ` y ` for ` x ` in placeholders of unknown structure. Our theorem now states, that the generic expression ` A. x ( x = y -> ph ) ` formally behaves as if such a substitution was possible and made. (Contributed by BJ, 31-May-2019.)
theorem wl_equsalvw {x3 y1: setvar} (ph: wff x3 y1) (ps: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wal x3 (wi (wceq (cv x3) (cv y1)) ph)) ps $;

--| Deduction version of ~ equsal . (Contributed by Wolf Lammen, 27-Jul-2019.)
theorem wl_equsald {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wnf x3 ph $ >
  $ wi ph (wnf x3 ch) $ >
  $ wi ph (wi (wceq (cv x3) (cv y1)) (wb ps ch)) $ >
  $ wi ph (wb (wal x3 (wi (wceq (cv x3) (cv y1)) ps)) ch) $;

--| Deduction version of ~ equsal . (Contributed by Wolf Lammen, 27-Jul-2019.)
theorem wl_equsaldv {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wnf x3 ph $ >
  $ wi ph (wnf x3 ch) $ >
  $ wi ph (wi (wceq (cv x3) (cv y1)) (wb ps ch)) $ >
  $ wi ph (wb (wal x3 (wi (wceq (cv x3) (cv y1)) ps)) ch) $;

--| A useful equivalence related to substitution. (Contributed by NM, 2-Jun-1993.) (Proof shortened by Andrew Salmon, 12-Aug-2011.) (Revised by Mario Carneiro, 3-Oct-2016.) It seems proving ~ wl-equsald first, and then deriving more specialized versions ~ wl-equsal and ~ wl-equsal1t then is more efficient than the other way round, which is possible, too. See also ~ equsal . (Revised by Wolf Lammen, 27-Jul-2019.) (Proof modification is discouraged.)
theorem wl_equsal {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wal x3 (wi (wceq (cv x3) (cv y1)) ph)) ps $;

--| The expression ` x = y ` in antecedent position plays an important role in predicate logic, namely in implicit substitution. However, occasionally it is irrelevant, and can safely be dropped. A sufficient condition for this is when ` x ` (or ` y ` or both) is not free in ` ph ` . This theorem is more fundamental than ~ equsal , ~ spimt or ~ sbft , to which it is related. (Contributed by Wolf Lammen, 19-Aug-2018.)
theorem wl_equsal1t {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wnf x3 ph) (wb (wal x3 (wi (wceq (cv x3) (cv y1)) ph)) ph) $;

--| This simple equivalence eases substitution of one expression for the other. (Contributed by Wolf Lammen, 1-Sep-2018.)
theorem wl_equsalcom {x3: setvar} (ph: wff x3) (y1: setvar):
  $ wb (wal x3 (wi (wceq (cv x3) (cv y1)) ph)) (wal x3 (wi (wceq (cv y1) (cv x3)) ph)) $;

--| The antecedent ` x = y ` is irrelevant, if one or both setvar variables are not free in ` ph ` . (Contributed by Wolf Lammen, 1-Sep-2018.)
theorem wl_equsal1i {x3 y1: setvar} (ph: wff x3 y1):
  $ wo (wnf x3 ph) (wnf y1 ph) $ >
  $ wi (wceq (cv x3) (cv y1)) ph $ >
  $ ph $;

--| A more general version of ~ sbid2vw . (Contributed by Wolf Lammen, 14-May-2019.)
theorem wl_sbid2ft {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wnf x3 ph) (wb (wsb x3 (wsb y1 ph x3) y1) ph) $;

--| Change bounded variables in a special case. The reverse direction seems to involve ~ ax-11 . My hope is that I will in some future be able to prove ~ mo3 with reversed quantifiers not using ~ ax-11 . See also the remark in ~ mo4 , which lead me to this effort. (Contributed by Wolf Lammen, 5-Mar-2024.)
theorem wl_cbvalsbi {x3 y1: setvar} (ph: wff x3):
  $ wi (wal x3 ph) (wal y1 (wsb x3 ph y1)) $;

--| Substitution with a variable not free in antecedent affects only the consequent. Closed form of ~ sbrim . (Contributed by Wolf Lammen, 26-Jul-2019.)
theorem wl_sbrimt {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wnf x3 ph) (wb (wsb x3 (wi ph ps) y1) (wi ph (wsb x3 ps y1))) $;

--| Substitution with a variable not free in antecedent affects only the consequent. Closed form of ~ sbrim . (Contributed by Wolf Lammen, 26-Jul-2019.)
theorem wl_sblimt {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wnf x3 ps) (wb (wsb x3 (wi ph ps) y1) (wi (wsb x3 ph y1) ps)) $;

--| Commutation of quantification and substitution variables based on fewer axioms than ~ sb9 . (Contributed by Wolf Lammen, 27-Apr-2025.)
theorem wl_sb9v {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wal x3 (wsb y1 ph x3)) (wal y1 (wsb x3 ph y1)) $;

--| Substitution of variable in universal quantifier. Closed form of ~ sb8f . (Contributed by Wolf Lammen, 27-Apr-2025.)
theorem wl_sb8ft {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wnf y1 ph)) (wb (wal x3 ph) (wal y1 (wsb x3 ph y1))) $;

--| Substitution of variable in existentialal quantifier. Closed form of ~ sb8ef . (Contributed by Wolf Lammen, 27-Apr-2025.)
theorem wl_sb8eft {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wnf y1 ph)) (wb (wex x3 ph) (wex y1 (wsb x3 ph y1))) $;

--| Substitution of variable in universal quantifier. Closed form of ~ sb8 . (Contributed by Wolf Lammen, 27-Jul-2019.)
theorem wl_sb8t {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wnf y1 ph)) (wb (wal x3 ph) (wal y1 (wsb x3 ph y1))) $;

--| Substitution of variable in universal quantifier. Closed form of ~ sb8e . (Contributed by Wolf Lammen, 27-Jul-2019.)
theorem wl_sb8et {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wnf y1 ph)) (wb (wex x3 ph) (wex y1 (wsb x3 ph y1))) $;

--| Closed form of ~ sbhb . Characterizing the expression ` ph -> A. x ph ` using a substitution expression. (Contributed by Wolf Lammen, 28-Jul-2019.)
theorem wl_sbhbt {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wnf y1 ph)) (wb (wi ph (wal x3 ph)) (wal y1 (wi ph (wsb x3 ph y1)))) $;

--| Two ways expressing that ` x ` is effectively not free in ` ph ` . Simplified version of ~ sbnf2 . Note: This theorem shows that ~ sbnf2 has unnecessary distinct variable constraints. (Contributed by Wolf Lammen, 28-Jul-2019.)
theorem wl_sbnf1 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wnf y1 ph)) (wb (wnf x3 ph) (wal x3 (wal y1 (wi ph (wsb x3 ph y1))))) $;

--| ~ equsb3 with a distinctor. (Contributed by Wolf Lammen, 27-Jun-2019.)
theorem wl_equsb3 {x3 y1 z: setvar}:
  $ wi (wn (wal y1 (wceq (cv y1) (cv z)))) (wb (wsb y1 (wceq (cv y1) (cv z)) x3) (wceq (cv x3) (cv z))) $;

--| Substitution applied to an atomic wff. The distinctor antecedent is more general than a distinct variable condition. (Contributed by Wolf Lammen, 26-Jun-2019.)
theorem wl_equsb4 {x3 y1 z: setvar}:
  $ wi (wn (wal x3 (wceq (cv x3) (cv z)))) (wb (wsb x3 (wceq (cv y1) (cv z)) y1) (wceq (cv y1) (cv z))) $;

--| Version of ~ 2sb6 with a context, and distinct variable conditions replaced with distinctors. (Contributed by Wolf Lammen, 4-Aug-2019.)
theorem wl_2sb6d {x3 y1 z w: setvar} (ph ps: wff x3 y1 z w):
  $ wi ph (wn (wal y1 (wceq (cv y1) (cv x3)))) $ >
  $ wi ph (wn (wal y1 (wceq (cv y1) (cv w)))) $ >
  $ wi ph (wn (wal y1 (wceq (cv y1) (cv z)))) $ >
  $ wi ph (wn (wal x3 (wceq (cv x3) (cv z)))) $ >
  $ wi ph (wb (wsb x3 (wsb y1 ps w) z) (wal x3 (wal y1 (wi (wa (wceq (cv x3) (cv z)) (wceq (cv y1) (cv w))) ps)))) $;

--| Lemma used to prove ~ wl-sbcom2d . (Contributed by Wolf Lammen, 10-Aug-2019.) (New usage is discouraged.)
theorem wl_sbcom2d_lem1 {x3 y1 z w v u: setvar} (ph: wff x3 y1 z w):
  $ wi (wa (wceq (cv u) (cv y1)) (wceq (cv v) (cv w))) (wi (wn (wal x3 (wceq (cv x3) (cv w)))) (wb (wsb x3 (wsb z ph v) u) (wsb x3 (wsb z ph w) y1))) $;

--| Lemma used to prove ~ wl-sbcom2d . (Contributed by Wolf Lammen, 10-Aug-2019.) (New usage is discouraged.)
theorem wl_sbcom2d_lem2 {x3 y1 v u: setvar} (ph: wff x3 y1):
  $ wi (wn (wal y1 (wceq (cv y1) (cv x3)))) (wb (wsb x3 (wsb y1 ph v) u) (wal x3 (wal y1 (wi (wa (wceq (cv x3) (cv u)) (wceq (cv y1) (cv v))) ph)))) $;

--| Version of ~ sbcom2 with a context, and distinct variable conditions replaced with distinctors. (Contributed by Wolf Lammen, 4-Aug-2019.)
theorem wl_sbcom2d {x3 y1 z w: setvar} (ph ps: wff x3 y1 z w):
  $ wi ph (wn (wal x3 (wceq (cv x3) (cv w)))) $ >
  $ wi ph (wn (wal x3 (wceq (cv x3) (cv z)))) $ >
  $ wi ph (wn (wal z (wceq (cv z) (cv y1)))) $ >
  $ wi ph (wb (wsb z (wsb x3 ps y1) w) (wsb x3 (wsb z ps w) y1)) $;

--| A theorem used in elimination of disjoint variable restrictions by replacing them with distinctors. (Contributed by Wolf Lammen, 25-Jul-2019.)
theorem wl_sbalnae {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi (wa (wn (wal x3 (wceq (cv x3) (cv y1)))) (wn (wal x3 (wceq (cv x3) (cv z))))) (wb (wsb y1 (wal x3 ph) z) (wal x3 (wsb y1 ph z))) $;

--| A theorem used in elimination of disjoint variable restriction on ` x ` and ` y ` by replacing it with a distinctor ` -. A. x x = z ` . (Contributed by NM, 15-May-1993.) Proof is based on ~ wl-sbalnae now. See also ~ sbal1 . (Revised by Wolf Lammen, 25-Jul-2019.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem wl_sbal1 {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi (wn (wal x3 (wceq (cv x3) (cv z)))) (wb (wsb y1 (wal x3 ph) z) (wal x3 (wsb y1 ph z))) $;

--| Move quantifier in and out of substitution. Revised to remove a distinct variable constraint. (Contributed by NM, 2-Jan-2002.) Proof is based on ~ wl-sbalnae now. See also ~ sbal2 . (Revised by Wolf Lammen, 25-Jul-2019.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem wl_sbal2 {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wb (wsb y1 (wal x3 ph) z) (wal x3 (wsb y1 ph z))) $;

--| ~ spsbbi applied twice. (Contributed by Wolf Lammen, 5-Aug-2023.)
theorem wl_2spsbbi {x3 y1 a b: setvar} (ph ps: wff x3 y1 a b):
  $ wi (wal a (wal b (wb ph ps))) (wb (wsb b (wsb a ph x3) y1) (wsb b (wsb a ps x3) y1)) $;

--| This theorem provides a basic working step in proving theorems about ` E* ` or ` E! ` . (Contributed by Wolf Lammen, 3-Oct-2019.)
theorem wl_lem_exsb {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph (wal x3 (wi (wceq (cv x3) (cv y1)) ph))) $;

--| This theorem provides a basic working step in proving theorems about ` E* ` or ` E! ` . (Contributed by Wolf Lammen, 3-Oct-2019.)
theorem wl_lem_nexmo {x3: setvar} (ph: wff x3) (z: setvar):
  $ wi (wn (wex x3 ph)) (wal x3 (wi ph (wceq (cv x3) (cv z)))) $;

--| The antecedent ` A. x ( ph -> x = z ) ` relates to ` E* x ph ` , but is better suited for usage in proofs. Note that no distinct variable restriction is placed on ` ph ` . This theorem provides a basic working step in proving theorems about ` E* ` or ` E! ` . (Contributed by Wolf Lammen, 3-Oct-2019.)
theorem wl_lem_moexsb {x3 z: setvar} (ph: wff x3 z):
  $ wi (wal x3 (wi ph (wceq (cv x3) (cv z)))) (wb (wex x3 ph) (wsb x3 ph z)) $;

--| This theorem extends ~ alanimi to a biconditional. Recurrent usage stacks up more quantifiers. (Contributed by Wolf Lammen, 4-Oct-2019.)
theorem wl_alanbii {x3: setvar} (ph ps ch: wff x3):
  $ wb ph (wa ps ch) $ >
  $ wb (wal x3 ph) (wa (wal x3 ps) (wal x3 ch)) $;

--| Version of ~ mof with a context and a distinctor replacing a distinct variable condition. This version should be used only to eliminate disjoint variable conditions. (Contributed by Wolf Lammen, 11-Aug-2019.)
theorem wl_mo2df {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wi ph (wn (wal x3 (wceq (cv x3) (cv y1)))) $ >
  $ wi ph (wnf y1 ps) $ >
  $ wi ph (wb (wmo x3 ps) (wex y1 (wal x3 (wi ps (wceq (cv x3) (cv y1)))))) $;

--| Closed form of ~ mof with a distinctor avoiding distinct variable conditions. (Contributed by Wolf Lammen, 20-Sep-2020.)
theorem wl_mo2tf {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wa (wn (wal x3 (wceq (cv x3) (cv y1)))) (wal x3 (wnf y1 ph))) (wb (wmo x3 ph) (wex y1 (wal x3 (wi ph (wceq (cv x3) (cv y1)))))) $;

--| Version of ~ eu6 with a context and a distinctor replacing a distinct variable condition. This version should be used only to eliminate disjoint variable conditions. (Contributed by Wolf Lammen, 23-Sep-2020.)
theorem wl_eudf {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wi ph (wn (wal x3 (wceq (cv x3) (cv y1)))) $ >
  $ wi ph (wnf y1 ps) $ >
  $ wi ph (wb (weu x3 ps) (wex y1 (wal x3 (wb ps (wceq (cv x3) (cv y1)))))) $;

--| Closed form of ~ eu6 with a distinctor avoiding distinct variable conditions. (Contributed by Wolf Lammen, 23-Sep-2020.)
theorem wl_eutf {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wa (wn (wal x3 (wceq (cv x3) (cv y1)))) (wal x3 (wnf y1 ph))) (wb (weu x3 ph) (wex y1 (wal x3 (wb ph (wceq (cv x3) (cv y1)))))) $;

--| ~ euequ proved with a distinctor. (Contributed by Wolf Lammen, 23-Sep-2020.)
theorem wl_euequf {x3 y1: setvar}:
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (weu x3 (wceq (cv x3) (cv y1))) $;

--| Closed form of ~ mof . (Contributed by Wolf Lammen, 18-Aug-2019.)
theorem wl_mo2t {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wnf y1 ph)) (wb (wmo x3 ph) (wex y1 (wal x3 (wi ph (wceq (cv x3) (cv y1)))))) $;

--| Closed form of ~ mo3 . (Contributed by Wolf Lammen, 18-Aug-2019.)
theorem wl_mo3t {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wnf y1 ph)) (wb (wmo x3 ph) (wal x3 (wal y1 (wi (wa ph (wsb x3 ph y1)) (wceq (cv x3) (cv y1)))))) $;

--| Closed form of ~ nfsbv . (Contributed by Wolf Lammen, 2-May-2025.)
theorem wl_nfsbtv {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi (wal x3 (wnf z ph)) (wnf z (wsb x3 ph y1)) $;

--| Substitution of variable in universal quantifier. Closed form of ~ sb8eu . (Contributed by Wolf Lammen, 11-Aug-2019.)
theorem wl_sb8eut {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wnf y1 ph)) (wb (weu x3 ph) (weu y1 (wsb x3 ph y1))) $;

--| Substitution of variable in universal quantifier. Closed form of ~ sb8euv . (Contributed by Wolf Lammen, 3-May-2025.)
theorem wl_sb8eutv {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wnf y1 ph)) (wb (weu x3 ph) (weu y1 (wsb x3 ph y1))) $;

--| Substitution of variable in universal quantifier. Closed form of ~ sb8mo . (Contributed by Wolf Lammen, 11-Aug-2019.)
theorem wl_sb8mot {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wnf y1 ph)) (wb (wmo x3 ph) (wmo y1 (wsb x3 ph y1))) $;

--| Substitution of variable in universal quantifier. Closed form of ~ sb8mo without ~ ax-13 , but requiring ` x ` and ` y ` being disjoint. This theorem relates to ~ wl-mo3t , since replacing ` ph ` with ` [ y / x ] ph ` in the latter yields subexpressions like ` [ x / y ] [ y / x ] ph ` , which can be reduced to ` ph ` via ~ sbft and ~ sbco . So ` E* x ph <-> E* y [ y / x ] ph ` is provable from ~ wl-mo3t in a simple fashion. From an educational standpoint, one would assume ~ wl-mo3t to be more fundamental, as it hints how the "at most one" objects on both sides of the biconditional correlate (they are the same), if they exist at all, and then prove this theorem from it. (Contributed by Wolf Lammen, 3-May-2025.)
theorem wl_sb8motv {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wnf y1 ph)) (wb (wmo x3 ph) (wmo y1 (wsb x3 ph y1))) $;

--| A closed form of ~ issetf . The proof here is a modification of a subproof in ~ vtoclgft , where it could be used to shorten the proof. (Contributed by Wolf Lammen, 25-Jan-2025.)
theorem wl_issetft {x3: setvar} (A2: class x3):
  $ wi (wnfc x3 A2) (wb (wcel A2 cvv) (wex x3 (wceq (cv x3) A2))) $;

--| Proving ~ axc11r from ~ axc11 . The hypotheses are two instances of ~ axc11 used in the proof here. Some systems introduce ~ axc11 as an axiom, see for example System S2 in ~ https://us.metamath.org/downloads/finiteaxiom.pdf . By contrast, this database sees the variant ~ axc11r , directly derived from ~ ax-12 , as foundational. Later ~ axc11 is proven somewhat trickily, requiring ~ ax-10 and ~ ax-13 , see its proof. (Contributed by Wolf Lammen, 18-Jul-2023.)
theorem wl_axc11rc11 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal y1 (wceq (cv y1) (cv x3))) (wi (wal y1 (wceq (cv y1) (cv x3))) (wal x3 (wceq (cv y1) (cv x3)))) $ >
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wi (wal x3 ph) (wal y1 ph)) $ >
  $ wi (wal y1 (wceq (cv y1) (cv x3))) (wi (wal x3 ph) (wal y1 ph)) $;

--| Variant of ~ df-clab , where the element ` x ` is required to be disjoint from the class it is taken from. This restriction meets similar ones found in other definitions and axioms like ~ ax-ext , ~ df-clel and ~ df-cleq . ` x e. A ` with ` A ` depending on ` x ` can be the source of side effects, that you rather want to be aware of. So here we eliminate one possible way of letting this slip in instead. An expression ` x e. A ` with ` x ` , ` A ` not disjoint, is now only introduced either via ~ ax-8 , ~ ax-9 , or ~ df-clel . Theorem ~ cleljust shows that a possible choice does not matter. The original ~ df-clab can be rederived, see ~ wl-dfclab . In an implementation this theorem is the only user of df-clab. (Contributed by NM, 26-May-1993.) Element and class are disjoint. (Revised by Wolf Lammen, 31-May-2023.)
theorem wl_clabv {y1: setvar} (ph: wff y1) (x3: setvar):
  $ wb (wcel (cv x3) (cab y1 ph)) (wsb y1 ph x3) $;

--| Rederive ~ df-clab from ~ wl-clabv . (Contributed by Wolf Lammen, 31-May-2023.) (Proof modification is discouraged.)
theorem wl_dfclab {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wcel (cv x3) (cab y1 ph)) (wsb y1 ph x3) $;

--| Using class abstraction in a context, requiring ` x ` and ` ph ` disjoint, but based on fewer axioms than ~ wl-clabt . (Contributed by Wolf Lammen, 29-May-2023.)
theorem wl_clabtv {x3: setvar} (ph: wff) (ps: wff x3):
  $ wi ph (wceq (cab x3 ps) (cab x3 (wi ph ps))) $;

--| Using class abstraction in a context. For a version based on fewer axioms see ~ wl-clabtv . (Contributed by Wolf Lammen, 29-May-2023.)
theorem wl_clabt {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ph $ >
  $ wi ph (wceq (cab x3 ps) (cab x3 (wi ph ps))) $;

--| Version of ~ cbvexvw with references to ~ ax-6 listed as antecedents. (Contributed by Wolf Lammen, 18-Feb-2026.)
theorem wl_eujustlem1 {x3 y1: setvar} (ph: wff x3) (ps: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wa (wal y1 (wex x3 (wceq (cv x3) (cv y1)))) (wal x3 (wex y1 (wceq (cv x3) (cv y1))))) (wb (wex x3 ph) (wex y1 ps)) $;

--| Abstraction restricted to an indexed union. (Contributed by Brendan Leahy, 26-Oct-2017.)
theorem rabiun {x3 y1: setvar} (ph: wff x3) (A2: class y1) (B2: class x3 y1):
  $ wceq (crab x3 ph (ciun y1 A2 B2)) (ciun y1 A2 (crab x3 ph B2)) $;

--| Indexed union of class difference with the subtrahend held constant. (Contributed by Brendan Leahy, 6-Aug-2018.)
theorem iundif1 {x3: setvar} (A2 B2: class x3) (C: class):
  $ wceq (ciun x3 A2 (cdif B2 C)) (cdif (ciun x3 A2 B2) C) $;

--| The difference of images is a subset of the image of the difference. (Contributed by Brendan Leahy, 21-Aug-2020.)
theorem imadifss (A2 B2 F: class):
  $ wss (cdif (cima F A2) (cima F B2)) (cima F (cdif A2 B2)) $;

--| Equality theorem for uncurrying. (Contributed by Brendan Leahy, 2-Jun-2021.)
theorem unceq (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (cunc A2) (cunc B2)) $;

--| Currying of uncurrying. (Contributed by Brendan Leahy, 2-Jun-2021.)
theorem curunc (A2 B2 C F: class):
  $ wi (wa (wf A2 (co C B2 cmap) F) (wne B2 c0)) (wceq (ccur (cunc F)) F) $;

--| Uncurrying of currying. (Contributed by Brendan Leahy, 5-Jun-2021.)
theorem unccur (A2 B2 C F V W: class):
  $ wi (w3a (wf (cxp A2 B2) C F) (wcel B2 (cdif V (csn c0))) (wcel C W)) (wceq (cunc (ccur F)) F) $;

--| Theorem related to pigeonhole principle. (Contributed by Brendan Leahy, 21-Aug-2020.)
theorem phpreu {x3 y1: setvar} (A2 B2: class) (C: class y1):
  $ wi (wa (wcel A2 cfn) (wbr A2 B2 cen)) (wb (wral x3 (wrex y1 (wceq (cv x3) C) B2) A2) (wral x3 (wreu y1 (wceq (cv x3) C) B2) A2)) $;

--| A finite Cartesian product of numerable sets is numerable. (Contributed by Brendan Leahy, 24-Feb-2019.)
theorem finixpnum {x3: setvar} (A2: class) (B2: class x3):
  $ wi (wa (wcel A2 cfn) (wral x3 (wcel B2 (cdm ccrd)) A2)) (wcel (cixp x3 A2 B2) (cdm ccrd)) $;

--| Lemma for ~ fin2so . (Contributed by Brendan Leahy, 29-Jun-2019.)
theorem fin2solem {x3 w: setvar} (y1 z: setvar) (R: class):
  $ wi (wa (wor (cv x3) R) (wa (wcel (cv y1) (cv x3)) (wcel (cv z) (cv x3)))) (wi (wbr (cv y1) (cv z) R) (wbr (crab w (wbr (cv w) (cv y1) R) (cv x3)) (crab w (wbr (cv w) (cv z) R) (cv x3)) crpss)) $;

--| Any totally ordered Tarski-finite set is finite; in particular, no amorphous set can be ordered. Theorem 2 of [[Levy58]] p. 4. (Contributed by Brendan Leahy, 28-Jun-2019.)
theorem fin2so (A2 R: class):
  $ wi (wa (wcel A2 cfin2) (wor A2 R)) (wcel A2 cfn) $;

--| Theorem to move the floor function across a strict inequality. (Contributed by Brendan Leahy, 25-Oct-2017.)
theorem ltflcei (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wb (wbr (cfv A2 cfl) B2 clt) (wbr A2 (cneg (cfv (cneg B2) cfl)) clt)) $;

--| Theorem to move the floor function across a non-strict inequality. (Contributed by Brendan Leahy, 25-Oct-2017.)
theorem leceifl (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wb (wbr (cneg (cfv (cneg A2) cfl)) B2 cle) (wbr A2 (cfv B2 cfl) cle)) $;

--| Half-angle rule for sine. (Contributed by Brendan Leahy, 3-Aug-2018.)
theorem sin2h (A2: class):
  $ wi (wcel A2 (co cc0 (co c2 cpi cmul) cicc)) (wceq (cfv (co A2 c2 cdiv) csin) (cfv (co (co c1 (cfv A2 ccos) cmin) c2 cdiv) csqrt)) $;

--| Half-angle rule for cosine. (Contributed by Brendan Leahy, 4-Aug-2018.)
theorem cos2h (A2: class):
  $ wi (wcel A2 (co (cneg cpi) cpi cicc)) (wceq (cfv (co A2 c2 cdiv) ccos) (cfv (co (co c1 (cfv A2 ccos) caddc) c2 cdiv) csqrt)) $;

--| Half-angle rule for tangent. (Contributed by Brendan Leahy, 4-Aug-2018.)
theorem tan2h (A2: class):
  $ wi (wcel A2 (co cc0 cpi cico)) (wceq (cfv (co A2 c2 cdiv) ctan) (cfv (co (co c1 (cfv A2 ccos) cmin) (co c1 (cfv A2 ccos) caddc) cdiv) csqrt)) $;

--| In a vector space, the union of an independent set and a vector not in its span is an independent set. (Contributed by Brendan Leahy, 4-Mar-2023.)
theorem lindsadd (F W X: class):
  $ wi (w3a (wcel W clvec) (wcel F (cfv W clinds)) (wcel X (cdif (cfv W cbs) (cfv F (cfv W clspn))))) (wcel (cun F (csn X)) (cfv W clinds)) $;

--| Expressing a restriction of a product topology as a product topology. (Contributed by Brendan Leahy, 24-Mar-2019.)
theorem ptrest {k: setvar} (ph: wff) (A2: class) (S: class k) (F V: class) (W: class k):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wf A2 ctop F) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel S W) $ >
  $ wi ph (wceq (co (cfv F cpt) (cixp k A2 S) crest) (cfv (cmpt k A2 (co (cfv (cv k) F) S crest)) cpt)) $;

--| Any point in an open set of N-space is surrounded by an open cube within that set. (Contributed by Brendan Leahy, 21-Aug-2020.) (Proof shortened by AV, 28-Sep-2020.)
theorem ptrecube {n d: setvar} (D: class n d) (P: class) (R: class n d) (S N: class):
  $ wceq R (cfv (cxp (co c1 N cfz) (csn (cfv (crn cioo) ctg))) cpt) $ >
  $ wceq D (cres (ccom cabs cmin) (cxp cr cr)) $ >
  $ wi (wa (wcel S R) (wcel P S)) (wrex d (wss (cixp n (co c1 N cfz) (co (cfv (cv n) P) (cv d) (cfv D cbl))) S) crp) $;

--| Lemma for ~ poimir - the vertices on either side of a skipped vertex differ in at least two dimensions. (Contributed by Brendan Leahy, 21-Aug-2020.)
theorem poimirlem1 {y1 j n: setvar} (ph: wff) (T U F M N: class):
  $ wi ph (wcel N cn) $ >
  $ wi ph (wceq F (cmpt y1 (co cc0 (co N c1 cmin) cfz) (csb j (cif (wbr (cv y1) M clt) (cv y1) (co (cv y1) c1 caddc)) (co T (cun (cxp (cima U (co c1 (cv j) cfz)) (csn c1)) (cxp (cima U (co (co (cv j) c1 caddc) N cfz)) (csn cc0))) (cof caddc))))) $ >
  $ wi ph (wf (co c1 N cfz) cz T) $ >
  $ wi ph (wf1o (co c1 N cfz) (co c1 N cfz) U) $ >
  $ wi ph (wcel M (co c1 (co N c1 cmin) cfz)) $ >
  $ wi ph (wn (wrmo n (wne (cfv (cv n) (cfv (co M c1 cmin) F)) (cfv (cv n) (cfv M F))) (co c1 N cfz))) $;

--| Lemma for ~ poimir - consecutive vertices differ in at most one dimension. (Contributed by Brendan Leahy, 21-Aug-2020.)
theorem poimirlem2 {y1 j n: setvar} (ph: wff) (T U F M N V: class):
  $ wi ph (wcel N cn) $ >
  $ wi ph (wceq F (cmpt y1 (co cc0 (co N c1 cmin) cfz) (csb j (cif (wbr (cv y1) M clt) (cv y1) (co (cv y1) c1 caddc)) (co T (cun (cxp (cima U (co c1 (cv j) cfz)) (csn c1)) (cxp (cima U (co (co (cv j) c1 caddc) N cfz)) (csn cc0))) (cof caddc))))) $ >
  $ wi ph (wf (co c1 N cfz) cz T) $ >
  $ wi ph (wf1o (co c1 N cfz) (co c1 N cfz) U) $ >
  $ wi ph (wcel V (co c1 (co N c1 cmin) cfz)) $ >
  $ wi ph (wcel M (cdif (co cc0 N cfz) (csn V))) $ >
  $ wi ph (wrmo n (wne (cfv (cv n) (cfv (co V c1 cmin) F)) (cfv (cv n) (cfv V F))) (co c1 N cfz)) $;

--| Lemma for ~ poimir to add an interior point to an admissible face on the back face of the cube. (Contributed by Brendan Leahy, 21-Aug-2020.)
theorem poimirlem3 {f2 i j p: setvar} (ph: wff f2) (B2: class p) (T U K M N: class):
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel K cn) $ >
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wbr M N clt) $ >
  $ wi ph (wf (co c1 M cfz) (co cc0 K cfzo) T) $ >
  $ wi ph (wf1o (co c1 M cfz) (co c1 M cfz) U) $ >
  $ wi ph (wi (wral i (wrex j (wceq (cv i) (csb p (cun (co T (cun (cxp (cima U (co c1 (cv j) cfz)) (csn c1)) (cxp (cima U (co (co (cv j) c1 caddc) M cfz)) (csn cc0))) (cof caddc)) (cxp (co (co M c1 caddc) N cfz) (csn cc0))) B2)) (co cc0 M cfz)) (co cc0 M cfz)) (wa (wcel (cop (cun T (csn (cop (co M c1 caddc) cc0))) (cun U (csn (cop (co M c1 caddc) (co M c1 caddc))))) (cxp (co (co cc0 K cfzo) (co c1 (co M c1 caddc) cfz) cmap) (cab f2 (wf1o (co c1 (co M c1 caddc) cfz) (co c1 (co M c1 caddc) cfz) (cv f2))))) (w3a (wral i (wrex j (wceq (cv i) (csb p (cun (co (cun T (csn (cop (co M c1 caddc) cc0))) (cun (cxp (cima (cun U (csn (cop (co M c1 caddc) (co M c1 caddc)))) (co c1 (cv j) cfz)) (csn c1)) (cxp (cima (cun U (csn (cop (co M c1 caddc) (co M c1 caddc)))) (co (co (cv j) c1 caddc) (co M c1 caddc) cfz)) (csn cc0))) (cof caddc)) (cxp (co (co (co M c1 caddc) c1 caddc) N cfz) (csn cc0))) B2)) (co cc0 M cfz)) (co cc0 M cfz)) (wceq (cfv (co M c1 caddc) (cun T (csn (cop (co M c1 caddc) cc0)))) cc0) (wceq (cfv (co M c1 caddc) (cun U (csn (cop (co M c1 caddc) (co M c1 caddc))))) (co M c1 caddc))))) $;

--| Lemma for ~ poimir connecting the admissible faces on the back face of the ` ( M + 1 ) ` -cube to admissible simplices in the ` M ` -cube. (Contributed by Brendan Leahy, 21-Aug-2020.)
theorem poimirlem4 {f2 i j s1 p: setvar} (ph: wff f2) (B2: class p) (K M N: class):
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel K cn) $ >
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wbr M N clt) $ >
  $ wi ph (wbr (crab s1 (wral i (wrex j (wceq (cv i) (csb p (cun (co (cfv (cv s1) c1st) (cun (cxp (cima (cfv (cv s1) c2nd) (co c1 (cv j) cfz)) (csn c1)) (cxp (cima (cfv (cv s1) c2nd) (co (co (cv j) c1 caddc) M cfz)) (csn cc0))) (cof caddc)) (cxp (co (co M c1 caddc) N cfz) (csn cc0))) B2)) (co cc0 M cfz)) (co cc0 M cfz)) (cxp (co (co cc0 K cfzo) (co c1 M cfz) cmap) (cab f2 (wf1o (co c1 M cfz) (co c1 M cfz) (cv f2))))) (crab s1 (w3a (wral i (wrex j (wceq (cv i) (csb p (cun (co (cfv (cv s1) c1st) (cun (cxp (cima (cfv (cv s1) c2nd) (co c1 (cv j) cfz)) (csn c1)) (cxp (cima (cfv (cv s1) c2nd) (co (co (cv j) c1 caddc) (co M c1 caddc) cfz)) (csn cc0))) (cof caddc)) (cxp (co (co (co M c1 caddc) c1 caddc) N cfz) (csn cc0))) B2)) (co cc0 M cfz)) (co cc0 M cfz)) (wceq (cfv (co M c1 caddc) (cfv (cv s1) c1st)) cc0) (wceq (cfv (co M c1 caddc) (cfv (cv s1) c2nd)) (co M c1 caddc))) (cxp (co (co cc0 K cfzo) (co c1 (co M c1 caddc) cfz) cmap) (cab f2 (wf1o (co c1 (co M c1 caddc) cfz) (co c1 (co M c1 caddc) cfz) (cv f2))))) cen) $;

--| Lemma for ~ poimir to establish that, for the simplices defined by a walk along the edges of an ` N ` -cube, if the starting vertex is not opposite a given face, it is the earliest vertex of the face on the walk. (Contributed by Brendan Leahy, 21-Aug-2020.)
theorem poimirlem5 {y1 t f2 j: setvar} (ph: wff f2) (S: class f2) (T F: class) (K: class y1) (N: class):
  $ wi ph (wcel N cn) $ >
  $ wceq S (crab t (wceq F (cmpt y1 (co cc0 (co N c1 cmin) cfz) (csb j (cif (wbr (cv y1) (cfv (cv t) c2nd) clt) (cv y1) (co (cv y1) c1 caddc)) (co (cfv (cfv (cv t) c1st) c1st) (cun (cxp (cima (cfv (cfv (cv t) c1st) c2nd) (co c1 (cv j) cfz)) (csn c1)) (cxp (cima (cfv (cfv (cv t) c1st) c2nd) (co (co (cv j) c1 caddc) N cfz)) (csn cc0))) (cof caddc))))) (cxp (cxp (co (co cc0 K cfzo) (co c1 N cfz) cmap) (cab f2 (wf1o (co c1 N cfz) (co c1 N cfz) (cv f2)))) (co cc0 N cfz))) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wbr cc0 (cfv T c2nd) clt) $ >
  $ wi ph (wceq (cfv cc0 F) (cfv (cfv T c1st) c1st)) $;

--| Lemma for ~ poimir establishing, for a face of a simplex defined by a walk along the edges of an ` N ` -cube, the single dimension in which successive vertices before the opposite vertex differ. (Contributed by Brendan Leahy, 21-Aug-2020.)
theorem poimirlem6 {y1 t f2 j n: setvar} (ph: wff f2) (S: class f2) (T F: class) (K: class y1) (M N: class):
  $ wi ph (wcel N cn) $ >
  $ wceq S (crab t (wceq F (cmpt y1 (co cc0 (co N c1 cmin) cfz) (csb j (cif (wbr (cv y1) (cfv (cv t) c2nd) clt) (cv y1) (co (cv y1) c1 caddc)) (co (cfv (cfv (cv t) c1st) c1st) (cun (cxp (cima (cfv (cfv (cv t) c1st) c2nd) (co c1 (cv j) cfz)) (csn c1)) (cxp (cima (cfv (cfv (cv t) c1st) c2nd) (co (co (cv j) c1 caddc) N cfz)) (csn cc0))) (cof caddc))))) (cxp (cxp (co (co cc0 K cfzo) (co c1 N cfz) cmap) (cab f2 (wf1o (co c1 N cfz) (co c1 N cfz) (cv f2)))) (co cc0 N cfz))) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wcel (cfv T c2nd) (co c1 (co N c1 cmin) cfz)) $ >
  $ wi ph (wcel M (co c1 (co (cfv T c2nd) c1 cmin) cfz)) $ >
  $ wi ph (wceq (crio n (wne (cfv (cv n) (cfv (co M c1 cmin) F)) (cfv (cv n) (cfv M F))) (co c1 N cfz)) (cfv M (cfv (cfv T c1st) c2nd))) $;

--| Lemma for ~ poimir , similar to ~ poimirlem6 , but for vertices after the opposite vertex. (Contributed by Brendan Leahy, 21-Aug-2020.)
theorem poimirlem7 {y1 t f2 j n: setvar} (ph: wff f2) (S: class f2) (T F: class) (K: class y1) (M N: class):
  $ wi ph (wcel N cn) $ >
  $ wceq S (crab t (wceq F (cmpt y1 (co cc0 (co N c1 cmin) cfz) (csb j (cif (wbr (cv y1) (cfv (cv t) c2nd) clt) (cv y1) (co (cv y1) c1 caddc)) (co (cfv (cfv (cv t) c1st) c1st) (cun (cxp (cima (cfv (cfv (cv t) c1st) c2nd) (co c1 (cv j) cfz)) (csn c1)) (cxp (cima (cfv (cfv (cv t) c1st) c2nd) (co (co (cv j) c1 caddc) N cfz)) (csn cc0))) (cof caddc))))) (cxp (cxp (co (co cc0 K cfzo) (co c1 N cfz) cmap) (cab f2 (wf1o (co c1 N cfz) (co c1 N cfz) (cv f2)))) (co cc0 N cfz))) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wcel (cfv T c2nd) (co c1 (co N c1 cmin) cfz)) $ >
  $ wi ph (wcel M (co (co (co (cfv T c2nd) c1 caddc) c1 caddc) N cfz)) $ >
  $ wi ph (wceq (crio n (wne (cfv (cv n) (cfv (co M c2 cmin) F)) (cfv (cv n) (cfv (co M c1 cmin) F))) (co c1 N cfz)) (cfv M (cfv (cfv T c1st) c2nd))) $;

--| Lemma for ~ poimir , establishing that away from the opposite vertex the walks in ~ poimirlem9 yield the same vertices. (Contributed by Brendan Leahy, 21-Aug-2020.)
theorem poimirlem8 {y1 t f2 j: setvar} (ph: wff f2) (S: class f2) (T U F: class) (K: class y1) (N: class):
  $ wi ph (wcel N cn) $ >
  $ wceq S (crab t (wceq F (cmpt y1 (co cc0 (co N c1 cmin) cfz) (csb j (cif (wbr (cv y1) (cfv (cv t) c2nd) clt) (cv y1) (co (cv y1) c1 caddc)) (co (cfv (cfv (cv t) c1st) c1st) (cun (cxp (cima (cfv (cfv (cv t) c1st) c2nd) (co c1 (cv j) cfz)) (csn c1)) (cxp (cima (cfv (cfv (cv t) c1st) c2nd) (co (co (cv j) c1 caddc) N cfz)) (csn cc0))) (cof caddc))))) (cxp (cxp (co (co cc0 K cfzo) (co c1 N cfz) cmap) (cab f2 (wf1o (co c1 N cfz) (co c1 N cfz) (cv f2)))) (co cc0 N cfz))) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wcel (cfv T c2nd) (co c1 (co N c1 cmin) cfz)) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wceq (cres (cfv (cfv U c1st) c2nd) (cdif (co c1 N cfz) (cpr (cfv T c2nd) (co (cfv T c2nd) c1 caddc)))) (cres (cfv (cfv T c1st) c2nd) (cdif (co c1 N cfz) (cpr (cfv T c2nd) (co (cfv T c2nd) c1 caddc))))) $;

--| Lemma for ~ poimir , establishing the two walks that yield a given face when the opposite vertex is neither first nor last. (Contributed by Brendan Leahy, 21-Aug-2020.)
theorem poimirlem9 {y1 t f2 j: setvar} (ph: wff f2) (S: class f2) (T U F: class) (K: class y1) (N: class):
  $ wi ph (wcel N cn) $ >
  $ wceq S (crab t (wceq F (cmpt y1 (co cc0 (co N c1 cmin) cfz) (csb j (cif (wbr (cv y1) (cfv (cv t) c2nd) clt) (cv y1) (co (cv y1) c1 caddc)) (co (cfv (cfv (cv t) c1st) c1st) (cun (cxp (cima (cfv (cfv (cv t) c1st) c2nd) (co c1 (cv j) cfz)) (csn c1)) (cxp (cima (cfv (cfv (cv t) c1st) c2nd) (co (co (cv j) c1 caddc) N cfz)) (csn cc0))) (cof caddc))))) (cxp (cxp (co (co cc0 K cfzo) (co c1 N cfz) cmap) (cab f2 (wf1o (co c1 N cfz) (co c1 N cfz) (cv f2)))) (co cc0 N cfz))) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wcel (cfv T c2nd) (co c1 (co N c1 cmin) cfz)) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wne (cfv (cfv U c1st) c2nd) (cfv (cfv T c1st) c2nd)) $ >
  $ wi ph (wceq (cfv (cfv U c1st) c2nd) (ccom (cfv (cfv T c1st) c2nd) (cun (cpr (cop (cfv T c2nd) (co (cfv T c2nd) c1 caddc)) (cop (co (cfv T c2nd) c1 caddc) (cfv T c2nd))) (cres cid (cdif (co c1 N cfz) (cpr (cfv T c2nd) (co (cfv T c2nd) c1 caddc))))))) $;

--| Lemma for ~ poimir establishing the cube that yields the simplex that yields a face if the opposite vertex was first on the walk. (Contributed by Brendan Leahy, 21-Aug-2020.)
theorem poimirlem10 {y1 t f2 j: setvar} (ph: wff f2) (S: class f2) (T F: class) (K: class y1) (N: class):
  $ wi ph (wcel N cn) $ >
  $ wceq S (crab t (wceq F (cmpt y1 (co cc0 (co N c1 cmin) cfz) (csb j (cif (wbr (cv y1) (cfv (cv t) c2nd) clt) (cv y1) (co (cv y1) c1 caddc)) (co (cfv (cfv (cv t) c1st) c1st) (cun (cxp (cima (cfv (cfv (cv t) c1st) c2nd) (co c1 (cv j) cfz)) (csn c1)) (cxp (cima (cfv (cfv (cv t) c1st) c2nd) (co (co (cv j) c1 caddc) N cfz)) (csn cc0))) (cof caddc))))) (cxp (cxp (co (co cc0 K cfzo) (co c1 N cfz) cmap) (cab f2 (wf1o (co c1 N cfz) (co c1 N cfz) (cv f2)))) (co cc0 N cfz))) $ >
  $ wi ph (wf (co cc0 (co N c1 cmin) cfz) (co (co cc0 K cfz) (co c1 N cfz) cmap) F) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wceq (cfv T c2nd) cc0) $ >
  $ wi ph (wceq (co (cfv (co N c1 cmin) F) (cxp (co c1 N cfz) (csn c1)) (cof cmin)) (cfv (cfv T c1st) c1st)) $;

--| Lemma for ~ poimir connecting walks that could yield from a given cube a given face opposite the first vertex of the walk. (Contributed by Brendan Leahy, 21-Aug-2020.)
theorem poimirlem11 {y1 t f2 j: setvar} (ph: wff f2) (S: class f2) (T U F: class) (K: class y1) (M N: class):
  $ wi ph (wcel N cn) $ >
  $ wceq S (crab t (wceq F (cmpt y1 (co cc0 (co N c1 cmin) cfz) (csb j (cif (wbr (cv y1) (cfv (cv t) c2nd) clt) (cv y1) (co (cv y1) c1 caddc)) (co (cfv (cfv (cv t) c1st) c1st) (cun (cxp (cima (cfv (cfv (cv t) c1st) c2nd) (co c1 (cv j) cfz)) (csn c1)) (cxp (cima (cfv (cfv (cv t) c1st) c2nd) (co (co (cv j) c1 caddc) N cfz)) (csn cc0))) (cof caddc))))) (cxp (cxp (co (co cc0 K cfzo) (co c1 N cfz) cmap) (cab f2 (wf1o (co c1 N cfz) (co c1 N cfz) (cv f2)))) (co cc0 N cfz))) $ >
  $ wi ph (wf (co cc0 (co N c1 cmin) cfz) (co (co cc0 K cfz) (co c1 N cfz) cmap) F) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wceq (cfv T c2nd) cc0) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wceq (cfv U c2nd) cc0) $ >
  $ wi ph (wcel M (co c1 N cfz)) $ >
  $ wi ph (wss (cima (cfv (cfv T c1st) c2nd) (co c1 M cfz)) (cima (cfv (cfv U c1st) c2nd) (co c1 M cfz))) $;

--| Lemma for ~ poimir connecting walks that could yield from a given cube a given face opposite the final vertex of the walk. (Contributed by Brendan Leahy, 21-Aug-2020.)
theorem poimirlem12 {y1 t f2 j: setvar} (ph: wff f2) (S: class f2) (T U F: class) (K: class y1) (M N: class):
  $ wi ph (wcel N cn) $ >
  $ wceq S (crab t (wceq F (cmpt y1 (co cc0 (co N c1 cmin) cfz) (csb j (cif (wbr (cv y1) (cfv (cv t) c2nd) clt) (cv y1) (co (cv y1) c1 caddc)) (co (cfv (cfv (cv t) c1st) c1st) (cun (cxp (cima (cfv (cfv (cv t) c1st) c2nd) (co c1 (cv j) cfz)) (csn c1)) (cxp (cima (cfv (cfv (cv t) c1st) c2nd) (co (co (cv j) c1 caddc) N cfz)) (csn cc0))) (cof caddc))))) (cxp (cxp (co (co cc0 K cfzo) (co c1 N cfz) cmap) (cab f2 (wf1o (co c1 N cfz) (co c1 N cfz) (cv f2)))) (co cc0 N cfz))) $ >
  $ wi ph (wf (co cc0 (co N c1 cmin) cfz) (co (co cc0 K cfz) (co c1 N cfz) cmap) F) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wceq (cfv T c2nd) N) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wceq (cfv U c2nd) N) $ >
  $ wi ph (wcel M (co cc0 (co N c1 cmin) cfz)) $ >
  $ wi ph (wss (cima (cfv (cfv T c1st) c2nd) (co c1 M cfz)) (cima (cfv (cfv U c1st) c2nd) (co c1 M cfz))) $;

--| Lemma for ~ poimir - for at most one simplex associated with a shared face is the opposite vertex first on the walk. (Contributed by Brendan Leahy, 21-Aug-2020.)
theorem poimirlem13 {y1 z t f2 j: setvar} (ph: wff f2) (S: class f2) (F: class) (K: class y1) (N: class):
  $ wi ph (wcel N cn) $ >
  $ wceq S (crab t (wceq F (cmpt y1 (co cc0 (co N c1 cmin) cfz) (csb j (cif (wbr (cv y1) (cfv (cv t) c2nd) clt) (cv y1) (co (cv y1) c1 caddc)) (co (cfv (cfv (cv t) c1st) c1st) (cun (cxp (cima (cfv (cfv (cv t) c1st) c2nd) (co c1 (cv j) cfz)) (csn c1)) (cxp (cima (cfv (cfv (cv t) c1st) c2nd) (co (co (cv j) c1 caddc) N cfz)) (csn cc0))) (cof caddc))))) (cxp (cxp (co (co cc0 K cfzo) (co c1 N cfz) cmap) (cab f2 (wf1o (co c1 N cfz) (co c1 N cfz) (cv f2)))) (co cc0 N cfz))) $ >
  $ wi ph (wf (co cc0 (co N c1 cmin) cfz) (co (co cc0 K cfz) (co c1 N cfz) cmap) F) $ >
  $ wi ph (wrmo z (wceq (cfv (cv z) c2nd) cc0) S) $;

--| Lemma for ~ poimir - for at most one simplex associated with a shared face is the opposite vertex last on the walk. (Contributed by Brendan Leahy, 21-Aug-2020.)
theorem poimirlem14 {y1 z t f2 j: setvar} (ph: wff f2) (S: class f2) (F: class) (K: class y1) (N: class):
  $ wi ph (wcel N cn) $ >

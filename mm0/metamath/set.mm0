  $ wi ph (w3a (wss (cpr A2 B2) (cfv J I)) (wss (cpr B2 C) (cfv K I)) (wss (cpr C D) (cfv L I))) $ >
  $ wi ph (w3a (wss (cpr A2 B2) (cfv (cfv cc0 F) I)) (wss (cpr B2 C) (cfv (cfv c1 F) I)) (wss (cpr C D) (cfv (cfv c2 F) I))) $;

--| Lemma 10 for ~ 3wlkd . (Contributed by Alexander van der Vekens, 12-Nov-2017.) (Revised by AV, 7-Feb-2021.)
theorem _3wlkdlem10 {k: setvar} (ph: wff k) (A2 B2 C D P F I J K L V: class):
  $ wceq P (cs4 A2 B2 C D) $ >
  $ wceq F (cs3 J K L) $ >
  $ wi ph (wa (wa (wcel A2 V) (wcel B2 V)) (wa (wcel C V) (wcel D V))) $ >

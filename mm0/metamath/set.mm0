--| An endomorphism ring is a ring. TODO: fix comment. (Contributed by NM, 4-Aug-2013.) (New usage is discouraged.)
theorem erngring_rN (D H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq D (cfv W (cfv K cedring_rN)) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wcel D crg) $;

--| An endomorphism ring is a division ring. TODO: fix comment. (Contributed by NM, 11-Aug-2013.) (New usage is discouraged.)
theorem erngdv_rN (D H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq D (cfv W (cfv K cedring_rN)) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wcel D cdr) $;

--| Extend class notation with constructed vector space A.
term cdveca: class;

--| Define constructed partial vector space A. (Contributed by NM, 8-Oct-2013.)
axiom df_dveca {w f2 g2 k s1: setvar}:
  $ wceq cdveca (cmpt k cvv (cmpt w (cfv (cv k) clh) (cun (ctp (cop (cfv cnx cbs) (cfv (cv w) (cfv (cv k) cltrn))) (cop (cfv cnx cplusg) (cmpo f2 g2 (cfv (cv w) (cfv (cv k) cltrn)) (cfv (cv w) (cfv (cv k) cltrn)) (ccom (cv f2) (cv g2)))) (cop (cfv cnx csca) (cfv (cv w) (cfv (cv k) cedring)))) (csn (cop (cfv cnx cvsca) (cmpo s1 f2 (cfv (cv w) (cfv (cv k) ctendo)) (cfv (cv w) (cfv (cv k) cltrn)) (cfv (cv f2) (cv s1)))))))) $;

--| The constructed partial vector space A for a lattice ` K ` . (Contributed by NM, 8-Oct-2013.) (Revised by Mario Carneiro, 22-Jun-2014.)
theorem dvafset {w f2 g2 s1: setvar} (H: class f2 g2 s1) (K: class) (V: class w f2 g2 s1):
  $ wceq H (cfv K clh) $ >
  $ wi (wcel K V) (wceq (cfv K cdveca) (cmpt w H (cun (ctp (cop (cfv cnx cbs) (cfv (cv w) (cfv K cltrn))) (cop (cfv cnx cplusg) (cmpo f2 g2 (cfv (cv w) (cfv K cltrn)) (cfv (cv w) (cfv K cltrn)) (ccom (cv f2) (cv g2)))) (cop (cfv cnx csca) (cfv (cv w) (cfv K cedring)))) (csn (cop (cfv cnx cvsca) (cmpo s1 f2 (cfv (cv w) (cfv K ctendo)) (cfv (cv w) (cfv K cltrn)) (cfv (cv f2) (cv s1)))))))) $;

--| The constructed partial vector space A for a lattice ` K ` . (Contributed by NM, 8-Oct-2013.) (Revised by Mario Carneiro, 22-Jun-2014.)
theorem dvaset {f2 g2 s1: setvar} (D T U E H: class f2 g2 s1) (K W: class) (X: class f2 g2 s1):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq D (cfv W (cfv K cedring)) $ >
  $ wceq U (cfv W (cfv K cdveca)) $ >
  $ wi (wa (wcel K X) (wcel W H)) (wceq U (cun (ctp (cop (cfv cnx cbs) T) (cop (cfv cnx cplusg) (cmpo f2 g2 T T (ccom (cv f2) (cv g2)))) (cop (cfv cnx csca) D)) (csn (cop (cfv cnx cvsca) (cmpo s1 f2 E T (cfv (cv f2) (cv s1))))))) $;

--| The ring base set of the constructed partial vector space A are all translation group endomorphisms (for a fiducial co-atom ` W ` ). (Contributed by NM, 22-Jun-2014.)
theorem dvasca (D U F H K W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq D (cfv W (cfv K cedring)) $ >
  $ wceq U (cfv W (cfv K cdveca)) $ >
  $ wceq F (cfv U csca) $ >
  $ wi (wa (wcel K X) (wcel W H)) (wceq F D) $;

--| The ring base set of the constructed partial vector space A are all translation group endomorphisms (for a fiducial co-atom ` W ` ). (Contributed by NM, 9-Oct-2013.) (Revised by Mario Carneiro, 22-Jun-2014.)
theorem dvabase (C U E F H K W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq U (cfv W (cfv K cdveca)) $ >
  $ wceq F (cfv U csca) $ >
  $ wceq C (cfv F cbs) $ >
  $ wi (wa (wcel K X) (wcel W H)) (wceq C E) $;

--| Ring addition operation for the constructed partial vector space A. (Contributed by NM, 9-Oct-2013.) (Revised by Mario Carneiro, 22-Jun-2014.)
theorem dvafplusg {t f2 s1: setvar} (c_pl: class t f2 s1) (T: class) (U: class t f2 s1) (E: class f2) (F H: class t f2 s1) (K: class) (V: class t f2 s1) (W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq U (cfv W (cfv K cdveca)) $ >
  $ wceq F (cfv U csca) $ >
  $ wceq c_pl (cfv F cplusg) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wceq c_pl (cmpo s1 t E E (cmpt f2 T (ccom (cfv (cv f2) (cv s1)) (cfv (cv f2) (cv t)))))) $;

--| Ring addition operation for the constructed partial vector space A. (Contributed by NM, 11-Oct-2013.)
theorem dvaplusg {f2: setvar} (c_pl: class f2) (R S T: class) (U E F H: class f2) (K: class) (V: class f2) (W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq U (cfv W (cfv K cdveca)) $ >
  $ wceq F (cfv U csca) $ >
  $ wceq c_pl (cfv F cplusg) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wa (wcel R E) (wcel S E))) (wceq (co R S c_pl) (cmpt f2 T (ccom (cfv (cv f2) R) (cfv (cv f2) S)))) $;

--| Ring addition operation for the constructed partial vector space A. (Contributed by NM, 11-Oct-2013.)
theorem dvaplusgv (c_pl R S T U E F G H K V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq U (cfv W (cfv K cdveca)) $ >
  $ wceq F (cfv U csca) $ >
  $ wceq c_pl (cfv F cplusg) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (w3a (wcel R E) (wcel S E) (wcel G T))) (wceq (cfv G (co R S c_pl)) (ccom (cfv G R) (cfv G S))) $;

--| Ring multiplication operation for the constructed partial vector space A. (Contributed by NM, 9-Oct-2013.) (Revised by Mario Carneiro, 22-Jun-2014.)
theorem dvafmulr {t s1: setvar} (T c_x U: class t s1) (E: class) (F H: class t s1) (K: class) (V: class t s1) (W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq U (cfv W (cfv K cdveca)) $ >
  $ wceq F (cfv U csca) $ >
  $ wceq c_x (cfv F cmulr) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wceq c_x (cmpo s1 t E E (ccom (cv s1) (cv t)))) $;

--| Ring multiplication operation for the constructed partial vector space A. (Contributed by NM, 11-Oct-2013.)
theorem dvamulr (R S T c_x U E F H K V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq U (cfv W (cfv K cdveca)) $ >
  $ wceq F (cfv U csca) $ >
  $ wceq c_x (cfv F cmulr) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wa (wcel R E) (wcel S E))) (wceq (co R S c_x) (ccom R S)) $;

--| The vectors (vector base set) of the constructed partial vector space A are all translations (for a fiducial co-atom ` W ` ). (Contributed by NM, 9-Oct-2013.) (Revised by Mario Carneiro, 22-Jun-2014.)
theorem dvavbase (T U H K V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq U (cfv W (cfv K cdveca)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wi (wa (wcel K X) (wcel W H)) (wceq V T) $;

--| The vector sum operation for the constructed partial vector space A. (Contributed by NM, 9-Oct-2013.) (Revised by Mario Carneiro, 22-Jun-2014.)
theorem dvafvadd {f2 g2: setvar} (c_pl: class f2 g2) (T: class) (U H: class f2 g2) (K W: class) (X: class f2 g2):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq U (cfv W (cfv K cdveca)) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wi (wa (wcel K X) (wcel W H)) (wceq c_pl (cmpo f2 g2 T T (ccom (cv f2) (cv g2)))) $;

--| Ring addition operation for the constructed partial vector space A. (Contributed by NM, 11-Oct-2013.)
theorem dvavadd (c_pl T U F G H K V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq U (cfv W (cfv K cdveca)) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wa (wcel F T) (wcel G T))) (wceq (co F G c_pl) (ccom F G)) $;

--| Ring addition operation for the constructed partial vector space A. (Contributed by NM, 9-Oct-2013.) (Revised by Mario Carneiro, 22-Jun-2014.)
theorem dvafvsca {f2 s1: setvar} (T: class) (c_x U: class f2 s1) (E: class) (H: class f2 s1) (K: class) (V: class f2 s1) (W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq U (cfv W (cfv K cdveca)) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wceq c_x (cmpo s1 f2 E T (cfv (cv f2) (cv s1)))) $;

--| Ring addition operation for the constructed partial vector space A. (Contributed by NM, 11-Oct-2013.)
theorem dvavsca (R T c_x U E F H K V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq U (cfv W (cfv K cdveca)) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wa (wcel R E) (wcel F T))) (wceq (co R F c_x) (cfv F R)) $;

--| Closure of endomorphism scalar product operation. (Contributed by NM, 10-Oct-2013.)
theorem tendospcl (T U E F H K V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wi (w3a (wa (wcel K V) (wcel W H)) (wcel U E) (wcel F T)) (wcel (cfv F U) T) $;

--| Associative law for endomorphism scalar product operation. (Contributed by NM, 10-Oct-2013.)
theorem tendospass (T U E F H K V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wi (wa (wa (wcel K X) (wcel W H)) (w3a (wcel U E) (wcel V E) (wcel F T))) (wceq (cfv F (ccom U V)) (cfv (cfv F V) U)) $;

--| Forward distributive law for endomorphism scalar product operation. (Contributed by NM, 10-Oct-2013.)
theorem tendospdi1 (T U E F G H K V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (w3a (wcel U E) (wcel F T) (wcel G T))) (wceq (cfv (ccom F G) U) (ccom (cfv F U) (cfv G U))) $;

--| Converse of a trace-preserving endomorphism value. (Contributed by NM, 7-Apr-2014.)
theorem tendocnv (S T E F H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel S E) (wcel F T)) (wceq (ccnv (cfv F S)) (cfv (ccnv F) S)) $;

--| Reverse distributive law for endomorphism scalar product operation. (Contributed by NM, 10-Oct-2013.)
theorem tendospdi2 {t f2 s1: setvar} (P: class t f2 s1) (T: class) (U: class t f2 s1) (E: class f2) (F K V: class t f2 s1) (W: class):
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq P (cmpo s1 t E E (cmpt f2 T (ccom (cfv (cv f2) (cv s1)) (cfv (cv f2) (cv t))))) $ >
  $ wi (w3a (wcel U E) (wcel V E) (wcel F T)) (wceq (cfv F (co U V P)) (ccom (cfv F U) (cfv F V))) $;

--| Cancellation law for trace-preserving endomorphism values (used as scalar product). (Contributed by NM, 7-Apr-2014.) (New usage is discouraged.)
theorem tendospcanN {f2: setvar} (B2: class) (S: class f2) (T: class) (E F G H K O W: class f2):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq O (cmpt f2 T (cres cid B2)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel S E) (wne S O)) (wa (wcel F T) (wcel G T))) (wb (wceq (cfv F S) (cfv G S)) (wceq F G)) $;

--| The constructed partial vector space A for a lattice ` K ` is an abelian group. (Contributed by NM, 11-Oct-2013.) (Revised by Mario Carneiro, 22-Jun-2014.)
theorem dvaabl (U H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdveca)) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wcel U cabl) $;

--| Lemma for ~ dvalvec . (Contributed by NM, 11-Oct-2013.) (Proof shortened by Mario Carneiro, 22-Jun-2014.)
theorem dvalveclem (B2 D c_pl c_pd T c_x c_xp U E H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdveca)) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq D (cfv U csca) $ >
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_pd (cfv D cplusg) $ >
  $ wceq c_xp (cfv D cmulr) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wcel U clvec) $;

--| The constructed partial vector space A for a lattice ` K ` is a left vector space. (Contributed by NM, 11-Oct-2013.) (Revised by Mario Carneiro, 22-Jun-2014.)
theorem dvalvec (U H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdveca)) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wcel U clvec) $;

--| The zero vector of partial vector space A. (Contributed by NM, 9-Sep-2014.)
theorem dva0g (B2 T U H K W c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq U (cfv W (cfv K cdveca)) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wceq c_0 (cres cid B2)) $;

--| Extend class notation with partial isomorphism A.
term cdia: class;

--| Define partial isomorphism A. (Contributed by NM, 15-Oct-2013.)
axiom df_disoa {x3 y1 w f2 k: setvar}:
  $ wceq cdia (cmpt k cvv (cmpt w (cfv (cv k) clh) (cmpt x3 (crab y1 (wbr (cv y1) (cv w) (cfv (cv k) cple)) (cfv (cv k) cbs)) (crab f2 (wbr (cfv (cv f2) (cfv (cv w) (cfv (cv k) ctrl))) (cv x3) (cfv (cv k) cple)) (cfv (cv w) (cfv (cv k) cltrn)))))) $;

--| The partial isomorphism A for a lattice ` K ` . (Contributed by NM, 15-Oct-2013.)
theorem diaffval {x3 y1 w f2: setvar} (B2: class f2) (H: class x3 y1 f2) (K: class) (c_le: class f2) (V: class x3 y1 w f2):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wcel K V) (wceq (cfv K cdia) (cmpt w H (cmpt x3 (crab y1 (wbr (cv y1) (cv w) c_le) B2) (crab f2 (wbr (cfv (cv f2) (cfv (cv w) (cfv K ctrl))) (cv x3) c_le) (cfv (cv w) (cfv K cltrn)))))) $;

--| The partial isomorphism A for a lattice ` K ` . (Contributed by NM, 15-Oct-2013.)
theorem diafval {x3 y1 f2: setvar} (B2: class f2) (R: class y1 f2) (T: class y1) (H I: class x3 y1 f2) (K: class) (c_le: class f2) (V: class x3 y1 f2) (W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wceq I (cmpt x3 (crab y1 (wbr (cv y1) W c_le) B2) (crab f2 (wbr (cfv (cv f2) R) (cv x3) c_le) T))) $;

--| The partial isomorphism A for a lattice ` K ` . Definition of isomorphism map in [Crawley] p. 120 line 24. (Contributed by NM, 15-Oct-2013.)
theorem diaval {f2: setvar} (B2 R: class f2) (T: class) (H I: class f2) (K: class) (c_le V: class f2) (W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wa (wcel X B2) (wbr X W c_le))) (wceq (cfv X I) (crab f2 (wbr (cfv (cv f2) R) X c_le) T)) $;

--| Member of the partial isomorphism A for a lattice ` K ` . (Contributed by NM, 3-Dec-2013.)
theorem diaelval (B2 R T F H I K c_le V W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wa (wcel X B2) (wbr X W c_le))) (wb (wcel F (cfv X I)) (wa (wcel F T) (wbr (cfv F R) X c_le))) $;

--| Functionality and domain of the partial isomorphism A. (Contributed by NM, 26-Nov-2013.)
theorem diafn {x3: setvar} (B2: class) (H I: class x3) (K c_le: class) (V: class x3) (W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wfn I (crab x3 (wbr (cv x3) W c_le) B2)) $;

--| Domain of the partial isomorphism A. (Contributed by NM, 3-Dec-2013.)
theorem diadm {x3: setvar} (B2: class) (H I: class x3) (K c_le: class) (V: class x3) (W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wceq (cdm I) (crab x3 (wbr (cv x3) W c_le) B2)) $;

--| Member of domain of the partial isomorphism A. (Contributed by NM, 4-Dec-2013.)
theorem diaeldm (B2 H I K c_le V W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wb (wcel X (cdm I)) (wa (wcel X B2) (wbr X W c_le))) $;

--| A member of domain of the partial isomorphism A is a lattice element. (Contributed by NM, 5-Dec-2013.) (New usage is discouraged.)
theorem diadmclN (B2 H I K V W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wcel X (cdm I))) (wcel X B2) $;

--| A member of domain of the partial isomorphism A is under the fiducial hyperplane. (Contributed by NM, 5-Dec-2013.) (New usage is discouraged.)
theorem diadmleN (H I K c_le V W X: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wcel X (cdm I))) (wbr X W c_le) $;

--| The value of the partial isomorphism A is not empty. (Contributed by NM, 17-Jan-2014.)
theorem dian0 (B2 H I K c_le W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wbr X W c_le))) (wne (cfv X I) c0) $;

--| The lattice zero belongs to the domain of partial isomorphism A. (Contributed by NM, 5-Dec-2013.) (New usage is discouraged.)
theorem dia0eldmN (H I K W c_0: class):
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wcel c_0 (cdm I)) $;

--| The fiducial hyperplane (the largest allowed lattice element) belongs to the domain of partial isomorphism A. (Contributed by NM, 5-Dec-2013.) (New usage is discouraged.)
theorem dia1eldmN (H I K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wcel W (cdm I)) $;

--| The value of the partial isomorphism A is a set of translations, i.e., a set of vectors. (Contributed by NM, 26-Nov-2013.)
theorem diass (B2 T H I K c_le V W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wa (wcel X B2) (wbr X W c_le))) (wss (cfv X I) T) $;

--| A member of the value of the partial isomorphism A is a translation, i.e., a vector. (Contributed by NM, 17-Jan-2014.)
theorem diael (B2 T F H I K c_le V W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi (w3a (wa (wcel K V) (wcel W H)) (wa (wcel X B2) (wbr X W c_le)) (wcel F (cfv X I))) (wcel F T) $;

--| Trace of a member of the partial isomorphism A. (Contributed by NM, 17-Jan-2014.)
theorem diatrl (B2 R T F H I K c_le V W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi (w3a (wa (wcel K V) (wcel W H)) (wa (wcel X B2) (wbr X W c_le)) (wcel F (cfv X I))) (wbr (cfv F R) X c_le) $;

--| Any value of the partial isomorphism A is a set of translations i.e. a set of vectors. (Contributed by NM, 26-Nov-2013.) (New usage is discouraged.)
theorem diaelrnN (S T H I K V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wcel S (crn I))) (wss S T) $;

--| The value of partial isomorphism A is a subspace of partial vector space A. Part of Lemma M of [Crawley] p. 120 line 26. (Contributed by NM, 17-Jan-2014.) (Revised by Mario Carneiro, 23-Jun-2014.)
theorem dialss (B2 S U H I K c_le W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdveca)) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wceq S (cfv U clss) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wbr X W c_le))) (wcel (cfv X I) S) $;

--| The partial isomorphism A for a lattice ` K ` is order-preserving in the region under co-atom ` W ` . Part of Lemma M of [Crawley] p. 120 line 28. (Contributed by NM, 26-Nov-2013.)
theorem diaord (B2 H I K c_le W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wbr X W c_le)) (wa (wcel Y B2) (wbr Y W c_le))) (wb (wss (cfv X I) (cfv Y I)) (wbr X Y c_le)) $;

--| The partial isomorphism A for a lattice ` K ` is one-to-one in the region under co-atom ` W ` . Part of Lemma M of [Crawley] p. 120 line 28. (Contributed by NM, 25-Nov-2013.) (New usage is discouraged.)
theorem dia11N (B2 H I K c_le W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wbr X W c_le)) (wa (wcel Y B2) (wbr Y W c_le))) (wb (wceq (cfv X I) (cfv Y I)) (wceq X Y)) $;

--| The partial isomorphism A for a lattice ` K ` is a one-to-one function. Part of Lemma M of [Crawley] p. 120 line 27. (Contributed by NM, 4-Dec-2013.) (New usage is discouraged.)
theorem diaf11N (H I K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wf1o (cdm I) (crn I) I) $;

--| Closure of partial isomorphism A for a lattice ` K ` . (Contributed by NM, 4-Dec-2013.) (New usage is discouraged.)
theorem diaclN (H I K W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel X (cdm I))) (wcel (cfv X I) (crn I)) $;

--| Closure of partial isomorphism A converse. (Contributed by NM, 6-Dec-2013.) (New usage is discouraged.)
theorem diacnvclN (H I K W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel X (crn I))) (wcel (cfv X (ccnv I)) (cdm I)) $;

--| The value of the partial isomorphism A at the lattice zero is the singleton of the identity translation i.e. the zero subspace. (Contributed by NM, 26-Nov-2013.)
theorem dia0 (B2 H I K W c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wceq (cfv c_0 I) (csn (cres cid B2))) $;

--| The value of the partial isomorphism A at the fiducial co-atom is the set of all translations i.e. the entire vector space. (Contributed by NM, 26-Nov-2013.) (New usage is discouraged.)
theorem dia1N (T H I K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wceq (cfv W I) T) $;

--| The largest subspace in the range of partial isomorphism A. (Contributed by NM, 5-Dec-2013.) (New usage is discouraged.)
theorem dia1elN (T H I K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wcel T (crn I)) $;

--| Partial isomorphism A of a lattice glb. (Contributed by NM, 3-Dec-2013.) (New usage is discouraged.)
theorem diaglbN {x3: setvar} (S G H I K W: class):
  $ wceq G (cfv K cglb) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wss S (cdm I)) (wne S c0))) (wceq (cfv (cfv S G) I) (ciin x3 S (cfv (cv x3) I))) $;

--| Partial isomorphism A of a lattice meet. (Contributed by NM, 5-Dec-2013.) (New usage is discouraged.)
theorem diameetN (H I K c_an W X Y: class):
  $ wceq c_an (cfv K cmee) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel X (cdm I)) (wcel Y (cdm I)))) (wceq (cfv (co X Y c_an) I) (cin (cfv X I) (cfv Y I))) $;

--| Inverse partial isomorphism A of an intersection. (Contributed by NM, 6-Dec-2013.) (New usage is discouraged.)
theorem diainN (H I K c_an W X Y: class):
  $ wceq c_an (cfv K cmee) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel X (crn I)) (wcel Y (crn I)))) (wceq (cin X Y) (cfv (co (cfv X (ccnv I)) (cfv Y (ccnv I)) c_an) I)) $;

--| The intersection of partial isomorphism A closed subspaces is a closed subspace. (Contributed by NM, 3-Dec-2013.) (New usage is discouraged.)
theorem diaintclN (S H I K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wss S (crn I)) (wne S c0))) (wcel (cint S) (crn I)) $;

--| The partial isomorphism A maps to subspaces of partial vector space A. (Contributed by NM, 17-Jan-2014.) (New usage is discouraged.)
theorem diasslssN (S U H I K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdveca)) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wceq S (cfv U clss) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wss (crn I) S) $;

--| The partial isomorphism A maps to a set of vectors in partial vector space A. (Contributed by NM, 1-Jan-2014.) (New usage is discouraged.)
theorem diassdvaN (B2 U H I K c_le V W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wceq U (cfv W (cfv K cdveca)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wi (wa (wa (wcel K Y) (wcel W H)) (wa (wcel X B2) (wbr X W c_le))) (wss (cfv X I) V) $;

--| Two expressions for the 1-dimensional subspaces of partial vector space A (when ` F ` is a nonzero vector i.e. non-identity translation). Remark after Lemma L in [Crawley] p. 120 line 21. (Contributed by NM, 15-Oct-2013.) (Revised by Mario Carneiro, 22-Jun-2014.)
theorem dia1dim {g2 s1: setvar} (R T: class) (E: class g2) (F H: class) (I: class g2 s1) (K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel F T)) (wceq (cfv (cfv F R) I) (cab g2 (wrex s1 (wceq (cv g2) (cfv F (cv s1))) E))) $;

--| Two expressions for a 1-dimensional subspace of partial vector space A (when ` F ` is a nonzero vector i.e. non-identity translation). (Contributed by NM, 15-Jan-2014.) (Revised by Mario Carneiro, 22-Jun-2014.)
theorem dia1dim2 (R T U F H I K N W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq U (cfv W (cfv K cdveca)) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wceq N (cfv U clspn) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel F T)) (wceq (cfv (cfv F R) I) (cfv (csn F) N)) $;

--| A vector (translation) belongs to the 1-dim subspace it generates. (Contributed by NM, 8-Sep-2014.)
theorem dia1dimid (R T F H I K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel F T)) (wcel F (cfv (cfv F R) I)) $;

--| Lemma for ~ dia2dim . Show properties of the auxiliary atom ` Q ` . Part of proof of Lemma M in [Crawley] p. 121 line 3. (Contributed by NM, 8-Sep-2014.)
theorem dia2dimlem1 (ph: wff) (A2 P Q R T U F H c_or K c_le c_an V W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq Q (co (co P U c_or) (co (cfv P F) V c_or) c_an) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wa (wcel U A2) (wbr U W c_le)) $ >
  $ wi ph (wa (wcel V A2) (wbr V W c_le)) $ >
  $ wi ph (wa (wcel P A2) (wn (wbr P W c_le))) $ >
  $ wi ph (wa (wcel F T) (wne (cfv P F) P)) $ >
  $ wi ph (wbr (cfv F R) (co U V c_or) c_le) $ >
  $ wi ph (wne U V) $ >
  $ wi ph (wne (cfv F R) U) $ >
  $ wi ph (wa (wcel Q A2) (wn (wbr Q W c_le))) $;

--| Lemma for ~ dia2dim . Define a translation ` G ` whose trace is atom ` U ` . Part of proof of Lemma M in [Crawley] p. 121 line 4. (Contributed by NM, 8-Sep-2014.)
theorem dia2dimlem2 (ph: wff) (A2 P Q R T U F G H c_or K c_le c_an V W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq Q (co (co P U c_or) (co (cfv P F) V c_or) c_an) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wa (wcel U A2) (wbr U W c_le)) $ >
  $ wi ph (wa (wcel V A2) (wbr V W c_le)) $ >
  $ wi ph (wa (wcel P A2) (wn (wbr P W c_le))) $ >
  $ wi ph (wa (wcel F T) (wne (cfv P F) P)) $ >
  $ wi ph (wbr (cfv F R) (co U V c_or) c_le) $ >
  $ wi ph (wne (cfv F R) V) $ >
  $ wi ph (wcel G T) $ >
  $ wi ph (wceq (cfv P G) Q) $ >
  $ wi ph (wceq (cfv G R) U) $;

--| Lemma for ~ dia2dim . Define a translation ` D ` whose trace is atom ` V ` . Part of proof of Lemma M in [Crawley] p. 121 line 5. (Contributed by NM, 8-Sep-2014.)
theorem dia2dimlem3 (ph: wff) (A2 D P Q R T U F H c_or K c_le c_an V W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq Q (co (co P U c_or) (co (cfv P F) V c_or) c_an) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wa (wcel U A2) (wbr U W c_le)) $ >
  $ wi ph (wa (wcel V A2) (wbr V W c_le)) $ >
  $ wi ph (wa (wcel P A2) (wn (wbr P W c_le))) $ >
  $ wi ph (wa (wcel F T) (wne (cfv P F) P)) $ >
  $ wi ph (wbr (cfv F R) (co U V c_or) c_le) $ >
  $ wi ph (wne U V) $ >
  $ wi ph (wne (cfv F R) U) $ >
  $ wi ph (wne (cfv F R) V) $ >
  $ wi ph (wcel D T) $ >
  $ wi ph (wceq (cfv Q D) (cfv P F)) $ >
  $ wi ph (wceq (cfv D R) V) $;

--| Lemma for ~ dia2dim . Show that the composition (sum) of translations (vectors) ` G ` and ` D ` equals ` F ` . Part of proof of Lemma M in [Crawley] p. 121 line 5. (Contributed by NM, 8-Sep-2014.)
theorem dia2dimlem4 (ph: wff) (A2 D P Q T F G H K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wa (wcel P A2) (wn (wbr P W c_le))) $ >
  $ wi ph (wcel F T) $ >
  $ wi ph (wcel G T) $ >
  $ wi ph (wceq (cfv P G) Q) $ >
  $ wi ph (wcel D T) $ >
  $ wi ph (wceq (cfv Q D) (cfv P F)) $ >
  $ wi ph (wceq (ccom D G) F) $;

--| Lemma for ~ dia2dim . The sum of vectors ` G ` and ` D ` belongs to the sum of the subspaces generated by them. Thus, ` F = ( G o. D ) ` belongs to the subspace sum. Part of proof of Lemma M in [Crawley] p. 121 line 5. (Contributed by NM, 8-Sep-2014.)
theorem dia2dimlem5 (ph: wff) (A2 D P c_po Q R S T U F G H I c_or K c_le c_an N V W Y: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq Y (cfv W (cfv K cdveca)) $ >
  $ wceq S (cfv Y clss) $ >
  $ wceq c_po (cfv Y clsm) $ >
  $ wceq N (cfv Y clspn) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wceq Q (co (co P U c_or) (co (cfv P F) V c_or) c_an) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wa (wcel U A2) (wbr U W c_le)) $ >
  $ wi ph (wa (wcel V A2) (wbr V W c_le)) $ >
  $ wi ph (wa (wcel P A2) (wn (wbr P W c_le))) $ >
  $ wi ph (wa (wcel F T) (wne (cfv P F) P)) $ >
  $ wi ph (wbr (cfv F R) (co U V c_or) c_le) $ >
  $ wi ph (wne U V) $ >
  $ wi ph (wne (cfv F R) U) $ >
  $ wi ph (wne (cfv F R) V) $ >
  $ wi ph (wcel G T) $ >
  $ wi ph (wceq (cfv P G) Q) $ >
  $ wi ph (wcel D T) $ >
  $ wi ph (wceq (cfv Q D) (cfv P F)) $ >
  $ wi ph (wcel F (co (cfv U I) (cfv V I) c_po)) $;

--| Lemma for ~ dia2dim . Eliminate auxiliary translations ` G ` and ` D ` . (Contributed by NM, 8-Sep-2014.)
theorem dia2dimlem6 (ph: wff) (A2 P c_po Q R S T U F H I c_or K c_le c_an N V W Y: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq Y (cfv W (cfv K cdveca)) $ >
  $ wceq S (cfv Y clss) $ >
  $ wceq c_po (cfv Y clsm) $ >
  $ wceq N (cfv Y clspn) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wceq Q (co (co P U c_or) (co (cfv P F) V c_or) c_an) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wa (wcel U A2) (wbr U W c_le)) $ >
  $ wi ph (wa (wcel V A2) (wbr V W c_le)) $ >
  $ wi ph (wa (wcel P A2) (wn (wbr P W c_le))) $ >
  $ wi ph (wa (wcel F T) (wne (cfv P F) P)) $ >
  $ wi ph (wbr (cfv F R) (co U V c_or) c_le) $ >
  $ wi ph (wne U V) $ >
  $ wi ph (wne (cfv F R) U) $ >
  $ wi ph (wne (cfv F R) V) $ >
  $ wi ph (wcel F (co (cfv U I) (cfv V I) c_po)) $;

--| Lemma for ~ dia2dim . Eliminate ` ( F `` P ) =/= P ` condition. (Contributed by NM, 8-Sep-2014.)
theorem dia2dimlem7 (ph: wff) (A2 P c_po Q R S T U F H I c_or K c_le c_an N V W Y: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq Y (cfv W (cfv K cdveca)) $ >
  $ wceq S (cfv Y clss) $ >
  $ wceq c_po (cfv Y clsm) $ >
  $ wceq N (cfv Y clspn) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wceq Q (co (co P U c_or) (co (cfv P F) V c_or) c_an) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wa (wcel U A2) (wbr U W c_le)) $ >
  $ wi ph (wa (wcel V A2) (wbr V W c_le)) $ >
  $ wi ph (wa (wcel P A2) (wn (wbr P W c_le))) $ >
  $ wi ph (wcel F T) $ >
  $ wi ph (wbr (cfv F R) (co U V c_or) c_le) $ >
  $ wi ph (wne U V) $ >
  $ wi ph (wne (cfv F R) U) $ >
  $ wi ph (wne (cfv F R) V) $ >
  $ wi ph (wcel F (co (cfv U I) (cfv V I) c_po)) $;

--| Lemma for ~ dia2dim . Eliminate no-longer used auxiliary atoms ` P ` and ` Q ` . (Contributed by NM, 8-Sep-2014.)
theorem dia2dimlem8 (ph: wff) (A2 c_po R S T U F H I c_or K c_le c_an N V W Y: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq Y (cfv W (cfv K cdveca)) $ >
  $ wceq S (cfv Y clss) $ >
  $ wceq c_po (cfv Y clsm) $ >
  $ wceq N (cfv Y clspn) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wa (wcel U A2) (wbr U W c_le)) $ >
  $ wi ph (wa (wcel V A2) (wbr V W c_le)) $ >
  $ wi ph (wcel F T) $ >
  $ wi ph (wbr (cfv F R) (co U V c_or) c_le) $ >
  $ wi ph (wne U V) $ >
  $ wi ph (wne (cfv F R) U) $ >
  $ wi ph (wne (cfv F R) V) $ >
  $ wi ph (wcel F (co (cfv U I) (cfv V I) c_po)) $;

--| Lemma for ~ dia2dim . Eliminate ` ( R `` F ) =/= U ` , ` V ` conditions. (Contributed by NM, 8-Sep-2014.)
theorem dia2dimlem9 (ph: wff) (A2 c_po R S T U F H I c_or K c_le c_an N V W Y: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq Y (cfv W (cfv K cdveca)) $ >
  $ wceq S (cfv Y clss) $ >
  $ wceq c_po (cfv Y clsm) $ >
  $ wceq N (cfv Y clspn) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wa (wcel U A2) (wbr U W c_le)) $ >
  $ wi ph (wa (wcel V A2) (wbr V W c_le)) $ >
  $ wi ph (wcel F T) $ >
  $ wi ph (wbr (cfv F R) (co U V c_or) c_le) $ >
  $ wi ph (wne U V) $ >
  $ wi ph (wcel F (co (cfv U I) (cfv V I) c_po)) $;

--| Lemma for ~ dia2dim . Convert membership in closed subspace ` ( I `` ( U .\/ V ) ) ` to a lattice ordering. (Contributed by NM, 8-Sep-2014.)
theorem dia2dimlem10 (ph: wff) (A2 R S T U F H I c_or K c_le N V W Y: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq Y (cfv W (cfv K cdveca)) $ >
  $ wceq S (cfv Y clss) $ >
  $ wceq N (cfv Y clspn) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wa (wcel U A2) (wbr U W c_le)) $ >
  $ wi ph (wa (wcel V A2) (wbr V W c_le)) $ >
  $ wi ph (wcel F T) $ >
  $ wi ph (wcel F (cfv (co U V c_or) I)) $ >
  $ wi ph (wbr (cfv F R) (co U V c_or) c_le) $;

--| Lemma for ~ dia2dim . Convert ordering hypothesis on ` R `` F ` to subspace membership ` F e. ( I `` ( U .\/ V ) ) ` . (Contributed by NM, 8-Sep-2014.)
theorem dia2dimlem11 (ph: wff) (A2 c_po R S T U F H I c_or K c_le c_an N V W Y: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq Y (cfv W (cfv K cdveca)) $ >
  $ wceq S (cfv Y clss) $ >
  $ wceq c_po (cfv Y clsm) $ >
  $ wceq N (cfv Y clspn) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wa (wcel U A2) (wbr U W c_le)) $ >
  $ wi ph (wa (wcel V A2) (wbr V W c_le)) $ >
  $ wi ph (wcel F T) $ >
  $ wi ph (wne U V) $ >
  $ wi ph (wcel F (cfv (co U V c_or) I)) $ >
  $ wi ph (wcel F (co (cfv U I) (cfv V I) c_po)) $;

--| Lemma for ~ dia2dim . Obtain subset relation. (Contributed by NM, 8-Sep-2014.)
theorem dia2dimlem12 (ph: wff) (A2 c_po R S T U H I c_or K c_le c_an N V W Y: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq Y (cfv W (cfv K cdveca)) $ >
  $ wceq S (cfv Y clss) $ >
  $ wceq c_po (cfv Y clsm) $ >
  $ wceq N (cfv Y clspn) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wa (wcel U A2) (wbr U W c_le)) $ >
  $ wi ph (wa (wcel V A2) (wbr V W c_le)) $ >
  $ wi ph (wne U V) $ >
  $ wi ph (wss (cfv (co U V c_or) I) (co (cfv U I) (cfv V I) c_po)) $;

--| Lemma for ~ dia2dim . Eliminate ` U =/= V ` condition. (Contributed by NM, 8-Sep-2014.)
theorem dia2dimlem13 (ph: wff) (A2 c_po R S T U H I c_or K c_le c_an N V W Y: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq Y (cfv W (cfv K cdveca)) $ >
  $ wceq S (cfv Y clss) $ >
  $ wceq c_po (cfv Y clsm) $ >
  $ wceq N (cfv Y clspn) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wa (wcel U A2) (wbr U W c_le)) $ >
  $ wi ph (wa (wcel V A2) (wbr V W c_le)) $ >
  $ wi ph (wss (cfv (co U V c_or) I) (co (cfv U I) (cfv V I) c_po)) $;

--| A two-dimensional subspace of partial vector space A is closed, or equivalently, the isomorphism of a join of two atoms is a subset of the subspace sum of the isomorphisms of each atom (and thus they are equal, as shown later for the full vector space H). (Contributed by NM, 9-Sep-2014.)
theorem dia2dim (ph: wff) (A2 c_po U H I c_or K c_le V W Y: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq Y (cfv W (cfv K cdveca)) $ >
  $ wceq c_po (cfv Y clsm) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wa (wcel U A2) (wbr U W c_le)) $ >
  $ wi ph (wa (wcel V A2) (wbr V W c_le)) $ >
  $ wi ph (wss (cfv (co U V c_or) I) (co (cfv U I) (cfv V I) c_po)) $;

--| Extend class notation with constructed full vector space H.
term cdvh: class;

--| Define constructed full vector space H. (Contributed by NM, 17-Oct-2013.)
axiom df_dvech {w f2 g2 h k s1: setvar}:
  $ wceq cdvh (cmpt k cvv (cmpt w (cfv (cv k) clh) (cun (ctp (cop (cfv cnx cbs) (cxp (cfv (cv w) (cfv (cv k) cltrn)) (cfv (cv w) (cfv (cv k) ctendo)))) (cop (cfv cnx cplusg) (cmpo f2 g2 (cxp (cfv (cv w) (cfv (cv k) cltrn)) (cfv (cv w) (cfv (cv k) ctendo))) (cxp (cfv (cv w) (cfv (cv k) cltrn)) (cfv (cv w) (cfv (cv k) ctendo))) (cop (ccom (cfv (cv f2) c1st) (cfv (cv g2) c1st)) (cmpt h (cfv (cv w) (cfv (cv k) cltrn)) (ccom (cfv (cv h) (cfv (cv f2) c2nd)) (cfv (cv h) (cfv (cv g2) c2nd))))))) (cop (cfv cnx csca) (cfv (cv w) (cfv (cv k) cedring)))) (csn (cop (cfv cnx cvsca) (cmpo s1 f2 (cfv (cv w) (cfv (cv k) ctendo)) (cxp (cfv (cv w) (cfv (cv k) cltrn)) (cfv (cv w) (cfv (cv k) ctendo))) (cop (cfv (cfv (cv f2) c1st) (cv s1)) (ccom (cv s1) (cfv (cv f2) c2nd))))))))) $;

--| The constructed full vector space H for a lattice ` K ` . (Contributed by NM, 17-Oct-2013.) (Revised by Mario Carneiro, 22-Jun-2014.)
theorem dvhfset {w f2 g2 h s1: setvar} (H: class h s1) (K: class) (V: class w f2 g2 h s1):
  $ wceq H (cfv K clh) $ >
  $ wi (wcel K V) (wceq (cfv K cdvh) (cmpt w H (cun (ctp (cop (cfv cnx cbs) (cxp (cfv (cv w) (cfv K cltrn)) (cfv (cv w) (cfv K ctendo)))) (cop (cfv cnx cplusg) (cmpo f2 g2 (cxp (cfv (cv w) (cfv K cltrn)) (cfv (cv w) (cfv K ctendo))) (cxp (cfv (cv w) (cfv K cltrn)) (cfv (cv w) (cfv K ctendo))) (cop (ccom (cfv (cv f2) c1st) (cfv (cv g2) c1st)) (cmpt h (cfv (cv w) (cfv K cltrn)) (ccom (cfv (cv h) (cfv (cv f2) c2nd)) (cfv (cv h) (cfv (cv g2) c2nd))))))) (cop (cfv cnx csca) (cfv (cv w) (cfv K cedring)))) (csn (cop (cfv cnx cvsca) (cmpo s1 f2 (cfv (cv w) (cfv K ctendo)) (cxp (cfv (cv w) (cfv K cltrn)) (cfv (cv w) (cfv K ctendo))) (cop (cfv (cfv (cv f2) c1st) (cv s1)) (ccom (cv s1) (cfv (cv f2) c2nd))))))))) $;

--| The constructed full vector space H for a lattice ` K ` . (Contributed by NM, 17-Oct-2013.) (Revised by Mario Carneiro, 22-Jun-2014.)
theorem dvhset {f2 g2 h s1: setvar} (D: class f2 g2 h s1) (T: class f2 g2 s1) (U E: class f2 g2 h s1) (H: class h s1) (K W: class) (X: class h s1):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq D (cfv W (cfv K cedring)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wi (wa (wcel K X) (wcel W H)) (wceq U (cun (ctp (cop (cfv cnx cbs) (cxp T E)) (cop (cfv cnx cplusg) (cmpo f2 g2 (cxp T E) (cxp T E) (cop (ccom (cfv (cv f2) c1st) (cfv (cv g2) c1st)) (cmpt h T (ccom (cfv (cv h) (cfv (cv f2) c2nd)) (cfv (cv h) (cfv (cv g2) c2nd))))))) (cop (cfv cnx csca) D)) (csn (cop (cfv cnx cvsca) (cmpo s1 f2 E (cxp T E) (cop (cfv (cfv (cv f2) c1st) (cv s1)) (ccom (cv s1) (cfv (cv f2) c2nd)))))))) $;

--| The ring of scalars of the constructed full vector space H. (Contributed by NM, 22-Jun-2014.)
theorem dvhsca (D U F H K W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq D (cfv W (cfv K cedring)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq F (cfv U csca) $ >
  $ wi (wa (wcel K X) (wcel W H)) (wceq F D) $;

--| The ring base set of the constructed full vector space H. (Contributed by NM, 29-Oct-2013.) (Revised by Mario Carneiro, 22-Jun-2014.)
theorem dvhbase (C U E F H K W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq F (cfv U csca) $ >
  $ wceq C (cfv F cbs) $ >
  $ wi (wa (wcel K X) (wcel W H)) (wceq C E) $;

--| Ring addition operation for the constructed full vector space H. (Contributed by NM, 29-Oct-2013.) (Revised by Mario Carneiro, 22-Jun-2014.)
theorem dvhfplusr {t f2 s1: setvar} (c_pl c_pb T U: class t f2 s1) (E: class f2) (F: class t f2 s1) (H: class t s1) (K: class) (V: class t s1) (W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq F (cfv U csca) $ >
  $ wceq c_pl (cmpo s1 t E E (cmpt f2 T (ccom (cfv (cv f2) (cv s1)) (cfv (cv f2) (cv t))))) $ >
  $ wceq c_pb (cfv F cplusg) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wceq c_pb c_pl) $;

--| Ring multiplication operation for the constructed full vector space H. (Contributed by NM, 29-Oct-2013.) (Revised by Mario Carneiro, 22-Jun-2014.)
theorem dvhfmulr {t s1: setvar} (T c_x U: class t s1) (E: class) (F H: class t s1) (K: class) (V: class t s1) (W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq F (cfv U csca) $ >
  $ wceq c_x (cfv F cmulr) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wceq c_x (cmpo s1 t E E (ccom (cv s1) (cv t)))) $;

--| Ring multiplication operation for the constructed full vector space H. (Contributed by NM, 29-Oct-2013.) (Revised by Mario Carneiro, 22-Jun-2014.)
theorem dvhmulr (R S T c_x U E F H K V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq F (cfv U csca) $ >
  $ wceq c_x (cfv F cmulr) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wa (wcel R E) (wcel S E))) (wceq (co R S c_x) (ccom R S)) $;

--| The vectors (vector base set) of the constructed full vector space H are all translations (for a fiducial co-atom ` W ` ). (Contributed by NM, 2-Nov-2013.) (Revised by Mario Carneiro, 22-Jun-2014.)
theorem dvhvbase (T U E H K V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wi (wa (wcel K X) (wcel W H)) (wceq V (cxp T E)) $;

--| Vector membership in the constructed full vector space H. (Contributed by NM, 20-Feb-2014.)
theorem dvhelvbasei (S T U E F H K V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wi (wa (wa (wcel K X) (wcel W H)) (wa (wcel F T) (wcel S E))) (wcel (cop F S) V) $;

--| Change bound variables to isolate them later. (Contributed by NM, 3-Nov-2013.)
theorem dvhvaddcbv {f2 g2 h i: setvar} (c_pl: class f2 g2 h i) (c_pd T E: class):
  $ wceq c_pl (cmpo f2 g2 (cxp T E) (cxp T E) (cop (ccom (cfv (cv f2) c1st) (cfv (cv g2) c1st)) (co (cfv (cv f2) c2nd) (cfv (cv g2) c2nd) c_pd))) $ >
  $ wceq c_pl (cmpo h i (cxp T E) (cxp T E) (cop (ccom (cfv (cv h) c1st) (cfv (cv i) c1st)) (co (cfv (cv h) c2nd) (cfv (cv i) c2nd) c_pd))) $;

--| The vector sum operation for the constructed full vector space H. (Contributed by NM, 26-Oct-2013.)
theorem dvhvaddval {f2 g2: setvar} (c_pl: class f2 g2) (c_pd T E: class) (F G: class f2 g2):
  $ wceq c_pl (cmpo f2 g2 (cxp T E) (cxp T E) (cop (ccom (cfv (cv f2) c1st) (cfv (cv g2) c1st)) (co (cfv (cv f2) c2nd) (cfv (cv g2) c2nd) c_pd))) $ >
  $ wi (wa (wcel F (cxp T E)) (wcel G (cxp T E))) (wceq (co F G c_pl) (cop (ccom (cfv F c1st) (cfv G c1st)) (co (cfv F c2nd) (cfv G c2nd) c_pd))) $;

--| The vector sum operation for the constructed full vector space H. (Contributed by NM, 26-Oct-2013.) (Revised by Mario Carneiro, 23-Jun-2014.)
theorem dvhfvadd {f2 g2: setvar} (D c_pl c_pd c_pb: class f2 g2) (T: class) (U: class f2 g2) (E H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq D (cfv U csca) $ >
  $ wceq c_pd (cfv D cplusg) $ >
  $ wceq c_pb (cmpo f2 g2 (cxp T E) (cxp T E) (cop (ccom (cfv (cv f2) c1st) (cfv (cv g2) c1st)) (co (cfv (cv f2) c2nd) (cfv (cv g2) c2nd) c_pd))) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wceq c_pl c_pb) $;

--| The vector sum operation for the constructed full vector space H. (Contributed by NM, 11-Feb-2014.) (Revised by Mario Carneiro, 23-Jun-2014.)
theorem dvhvadd (D c_pl c_pd T U E F G H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq D (cfv U csca) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq c_pd (cfv D cplusg) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel F (cxp T E)) (wcel G (cxp T E)))) (wceq (co F G c_pl) (cop (ccom (cfv F c1st) (cfv G c1st)) (co (cfv F c2nd) (cfv G c2nd) c_pd))) $;

--| The vector sum operation for the constructed full vector space H. (Contributed by NM, 21-Feb-2014.) (Revised by Mario Carneiro, 6-May-2015.)
theorem dvhopvadd (D c_pl c_pd Q R T U E F G H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq D (cfv U csca) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq c_pd (cfv D cplusg) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel F T) (wcel Q E)) (wa (wcel G T) (wcel R E))) (wceq (co (cop F Q) (cop G R) c_pl) (cop (ccom F G) (co Q R c_pd))) $;

--| The vector sum operation for the constructed full vector space H. TODO: check if this will shorten proofs that use ~ dvhopvadd and/or ~ dvhfplusr . (Contributed by NM, 26-Sep-2014.)
theorem dvhopvadd2 {t f2 s1: setvar} (c_pl c_pb Q R T U: class t f2 s1) (E: class f2) (F G: class t f2 s1) (H: class t s1) (K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq c_pl (cmpo s1 t E E (cmpt f2 T (ccom (cfv (cv f2) (cv s1)) (cfv (cv f2) (cv t))))) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_pb (cfv U cplusg) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel F T) (wcel Q E)) (wa (wcel G T) (wcel R E))) (wceq (co (cop F Q) (cop G R) c_pb) (cop (ccom F G) (co Q R c_pl))) $;

--| Closure of the vector sum operation for the constructed full vector space H. (Contributed by NM, 26-Oct-2013.) (Revised by Mario Carneiro, 23-Jun-2014.)
theorem dvhvaddcl (D c_pl c_pd T U E F G H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq D (cfv U csca) $ >
  $ wceq c_pd (cfv D cplusg) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel F (cxp T E)) (wcel G (cxp T E)))) (wcel (co F G c_pl) (cxp T E)) $;

--| Commutativity of vector sum. (Contributed by NM, 26-Oct-2013.) (Revised by Mario Carneiro, 23-Jun-2014.) (New usage is discouraged.)
theorem dvhvaddcomN (D c_pl c_pd T U E F G H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq D (cfv U csca) $ >
  $ wceq c_pd (cfv D cplusg) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel F (cxp T E)) (wcel G (cxp T E)))) (wceq (co F G c_pl) (co G F c_pl)) $;

--| Associativity of vector sum. (Contributed by NM, 31-Oct-2013.)
theorem dvhvaddass (D c_pl c_pd T U E F G H I K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq D (cfv U csca) $ >
  $ wceq c_pd (cfv D cplusg) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (w3a (wcel F (cxp T E)) (wcel G (cxp T E)) (wcel I (cxp T E)))) (wceq (co (co F G c_pl) I c_pl) (co F (co G I c_pl) c_pl)) $;

--| Change bound variables to isolate them later. (Contributed by NM, 20-Nov-2013.)
theorem dvhvscacbv {t f2 g2 s1: setvar} (T: class) (c_x: class t f2 g2 s1) (E: class):
  $ wceq c_x (cmpo s1 f2 E (cxp T E) (cop (cfv (cfv (cv f2) c1st) (cv s1)) (ccom (cv s1) (cfv (cv f2) c2nd)))) $ >
  $ wceq c_x (cmpo t g2 E (cxp T E) (cop (cfv (cfv (cv g2) c1st) (cv t)) (ccom (cv t) (cfv (cv g2) c2nd)))) $;

--| The scalar product operation for the constructed full vector space H. (Contributed by NM, 20-Nov-2013.)
theorem dvhvscaval {f2 s1: setvar} (T: class) (c_x U: class f2 s1) (E: class) (F: class f2 s1):
  $ wceq c_x (cmpo s1 f2 E (cxp T E) (cop (cfv (cfv (cv f2) c1st) (cv s1)) (ccom (cv s1) (cfv (cv f2) c2nd)))) $ >
  $ wi (wa (wcel U E) (wcel F (cxp T E))) (wceq (co U F c_x) (cop (cfv (cfv F c1st) U) (ccom U (cfv F c2nd)))) $;

--| Scalar product operation for the constructed full vector space H. (Contributed by NM, 2-Nov-2013.) (Revised by Mario Carneiro, 23-Jun-2014.)
theorem dvhfvsca {f2 s1: setvar} (T: class) (c_x U: class f2 s1) (E: class) (H: class s1) (K: class) (V: class s1) (W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wceq c_x (cmpo s1 f2 E (cxp T E) (cop (cfv (cfv (cv f2) c1st) (cv s1)) (ccom (cv s1) (cfv (cv f2) c2nd))))) $;

--| Scalar product operation for the constructed full vector space H. (Contributed by NM, 2-Nov-2013.)
theorem dvhvsca (R T c_x U E F H K V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wa (wcel R E) (wcel F (cxp T E)))) (wceq (co R F c_x) (cop (cfv (cfv F c1st) R) (ccom R (cfv F c2nd)))) $;

--| Scalar product operation for the constructed full vector space H. (Contributed by NM, 20-Feb-2014.)
theorem dvhopvsca (R T c_x U E F H K V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (w3a (wcel R E) (wcel F T) (wcel X E))) (wceq (co R (cop F X) c_x) (cop (cfv F R) (ccom R X))) $;

--| Closure of the scalar product operation for the constructed full vector space H. (Contributed by NM, 12-Feb-2014.)
theorem dvhvscacl (R T c_x U E F H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel R E) (wcel F (cxp T E)))) (wcel (co R F c_x) (cxp T E)) $;

--| Closure of multiplicative inverse for endomorphism. We use the scalar inverse of the vector space since it is much simpler than the direct inverse of ~ cdleml8 . (Contributed by NM, 10-Apr-2014.) (Revised by Mario Carneiro, 23-Jun-2014.)
theorem tendoinvcl {h: setvar} (B2: class) (S: class h) (T: class) (U E F: class h) (H K: class) (N O: class h) (W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq O (cmpt h T (cres cid B2)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq F (cfv U csca) $ >
  $ wceq N (cfv F cinvr) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel S E) (wne S O)) (wa (wcel (cfv S N) E) (wne (cfv S N) O)) $;

--| Left multiplicative inverse for endomorphism. (Contributed by NM, 10-Apr-2014.) (Revised by Mario Carneiro, 23-Jun-2014.)
theorem tendolinv {h: setvar} (B2: class) (S: class h) (T: class) (U E F: class h) (H K: class) (N O: class h) (W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq O (cmpt h T (cres cid B2)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq F (cfv U csca) $ >
  $ wceq N (cfv F cinvr) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel S E) (wne S O)) (wceq (ccom (cfv S N) S) (cres cid T)) $;

--| Right multiplicative inverse for endomorphism. (Contributed by NM, 10-Apr-2014.) (Revised by Mario Carneiro, 23-Jun-2014.)
theorem tendorinv {h: setvar} (B2: class) (S: class h) (T: class) (U E F: class h) (H K: class) (N O: class h) (W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq O (cmpt h T (cres cid B2)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq F (cfv U csca) $ >
  $ wceq N (cfv F cinvr) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel S E) (wne S O)) (wceq (ccom S (cfv S N)) (cres cid T)) $;

--| The full vector space ` U ` constructed from a Hilbert lattice ` K ` (given a fiducial hyperplane ` W ` ) is a group. (Contributed by NM, 19-Oct-2013.) (Revised by Mario Carneiro, 24-Jun-2014.)
theorem dvhgrp (B2 D c_pl c_pd T U E H I K W c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq D (cfv U csca) $ >
  $ wceq c_pd (cfv D cplusg) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wceq I (cfv D cminusg) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wcel U cgrp) $;

--| Lemma for ~ dvhlvec . TODO: proof substituting inner part first shorter/longer than substituting outer part first? TODO: break up into smaller lemmas? TODO: does ` ph -> ` method shorten proof? (Contributed by NM, 22-Oct-2013.) (Proof shortened by Mario Carneiro, 24-Jun-2014.)
theorem dvhlveclem (B2 D c_pl c_pd T c_x c_xp U E H I K W c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq D (cfv U csca) $ >
  $ wceq c_pd (cfv D cplusg) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wceq I (cfv D cminusg) $ >
  $ wceq c_xp (cfv D cmulr) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wcel U clvec) $;

--| The full vector space ` U ` constructed from a Hilbert lattice ` K ` (given a fiducial hyperplane ` W ` ) is a left module. (Contributed by NM, 23-May-2015.)
theorem dvhlvec (ph: wff) (U H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel U clvec) $;

--| The full vector space ` U ` constructed from a Hilbert lattice ` K ` (given a fiducial hyperplane ` W ` ) is a left module. (Contributed by NM, 23-May-2015.)
theorem dvhlmod (ph: wff) (U H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel U clmod) $;

--| The zero vector of vector space H has the zero translation as its first member and the zero trace-preserving endomorphism as the second. (Contributed by NM, 9-Mar-2014.) (Revised by Mario Carneiro, 24-Jun-2014.)
theorem dvh0g {f2: setvar} (B2 T: class) (U: class f2) (H K: class) (O: class f2) (W: class) (c_0: class f2):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq O (cmpt f2 T (cres cid B2)) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wceq c_0 (cop (cres cid B2) O)) $;

--| Properties of a unit vector that we will use later as a convenient reference vector. This vector is called "e" in the remark after Lemma M of [Crawley] p. 121. line 17. See also ~ dvhopN and ~ dihpN . (Contributed by NM, 27-Mar-2015.)
theorem dvheveccl (ph: wff) (B2 T U E H K V W c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq B2 (cfv K cbs) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq E (cop (cres cid B2) (cres cid T)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel E (cdif V (csn c_0))) $;

--| Closure of a ` DVecH ` vector expressed as ordered pair. (Contributed by NM, 20-Nov-2013.) (New usage is discouraged.)
theorem dvhopclN (T U E F: class):
  $ wi (wa (wcel F T) (wcel U E)) (wcel (cop F U) (cxp T E)) $;

--| Sum of ` DVecH ` vectors expressed as ordered pair. (Contributed by NM, 20-Nov-2013.) (New usage is discouraged.)
theorem dvhopaddN {f2 g2: setvar} (A2: class f2 g2) (P T: class) (U: class f2 g2) (E: class) (F G V: class f2 g2):
  $ wceq A2 (cmpo f2 g2 (cxp T E) (cxp T E) (cop (ccom (cfv (cv f2) c1st) (cfv (cv g2) c1st)) (co (cfv (cv f2) c2nd) (cfv (cv g2) c2nd) P))) $ >
  $ wi (wa (wa (wcel F T) (wcel U E)) (wa (wcel G T) (wcel V E))) (wceq (co (cop F U) (cop G V) A2) (cop (ccom F G) (co U V P))) $;

--| Scalar product of ` DVecH ` vector expressed as ordered pair. (Contributed by NM, 20-Nov-2013.) (New usage is discouraged.)
theorem dvhopspN {f2 s1: setvar} (R S: class f2 s1) (T: class) (U: class f2 s1) (E: class) (F: class f2 s1):
  $ wceq S (cmpo s1 f2 E (cxp T E) (cop (cfv (cfv (cv f2) c1st) (cv s1)) (ccom (cv s1) (cfv (cv f2) c2nd)))) $ >
  $ wi (wa (wcel R E) (wa (wcel F T) (wcel U E))) (wceq (co R (cop F U) S) (cop (cfv F R) (ccom R U))) $;

--| Decompose a ` DVecH ` vector expressed as an ordered pair into the sum of two components, the first from the translation group vector base of ` DVecA ` and the other from the one-dimensional vector subspace ` E ` . Part of Lemma M of [Crawley] p. 121, line 18. We represent their e, sigma, f by ` <. ( _I |`` B ) , ( _I |`` T ) >. ` , ` U ` , ` <. F , O >. ` . We swapped the order of vector sum (their juxtaposition i.e. composition) to show ` <. F , O >. ` first. Note that ` O ` and ` ( _I |`` T ) ` are the zero and one of the division ring ` E ` , and ` ( _I |`` B ) ` is the zero of the translation group. ` S ` is the scalar product. (Contributed by NM, 21-Nov-2013.) (New usage is discouraged.)
theorem dvhopN {f2 g2 s1 a b c: setvar} (A2: class f2 g2 s1 a b c) (B2: class f2 g2 s1 a b) (P: class s1 a b c) (S: class f2 g2 s1 a b c) (T: class) (U: class f2 g2 s1 a b c) (E: class c) (F: class f2 g2 s1 a b c) (H K: class f2 g2 s1 a b) (O: class f2 g2 s1 a b c) (W: class f2 g2 s1):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq P (cmpo a b E E (cmpt c T (ccom (cfv (cv c) (cv a)) (cfv (cv c) (cv b))))) $ >
  $ wceq A2 (cmpo f2 g2 (cxp T E) (cxp T E) (cop (ccom (cfv (cv f2) c1st) (cfv (cv g2) c1st)) (co (cfv (cv f2) c2nd) (cfv (cv g2) c2nd) P))) $ >
  $ wceq S (cmpo s1 f2 E (cxp T E) (cop (cfv (cfv (cv f2) c1st) (cv s1)) (ccom (cv s1) (cfv (cv f2) c2nd)))) $ >
  $ wceq O (cmpt c T (cres cid B2)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel F T) (wcel U E))) (wceq (cop F U) (co (cop F O) (co U (cop (cres cid B2) (cres cid T)) S) A2)) $;

--| Ordered pair membership in a subspace sum. (Contributed by NM, 12-Mar-2014.)
theorem dvhopellsm {x3 y1 z w: setvar} (c_pl: class) (c_po: class x3 y1 z w) (S: class z w) (T: class) (U: class x3 y1 z w) (F: class) (H K W: class z w) (X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel X S) (wcel Y S)) (wb (wcel (cop F T) (co X Y c_po)) (wex x3 (wex y1 (wex z (wex w (wa (wa (wcel (cop (cv x3) (cv y1)) X) (wcel (cop (cv z) (cv w)) Y)) (wceq (cop F T) (co (cop (cv x3) (cv y1)) (cop (cv z) (cv w)) c_pl)))))))) $;

--| The image of the map ` G ` is the entire one-dimensional subspace ` ( I `` V ) ` . Remark after Lemma M of [Crawley] p. 121 line 23. (Contributed by NM, 24-Nov-2013.) (New usage is discouraged.)
theorem cdlemm10N {f2 s1 r q: setvar} (A2: class q) (C: class f2 r) (P: class) (R: class r q) (T: class r) (F: class f2 s1 r q) (G: class f2 r q) (H: class r q) (I: class f2 s1 r q) (c_or: class f2 s1 q) (K: class r q) (c_le V W: class q):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wceq C (crab r (wa (wbr (cv r) (co P V c_or) c_le) (wn (wbr (cv r) W c_le))) A2) $ >
  $ wceq F (crio f2 (wceq (cfv P (cv f2)) (cv s1)) T) $ >
  $ wceq G (cmpt q C (crio f2 (wceq (cfv P (cv f2)) (cv q)) T)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel V A2) (wbr V W c_le))) (wceq (crn G) (cfv V I)) $;

--| Extend class notation with subspace orthocomplement for ` DVecA ` partial vector space.
term cocaN: class;

--| Define subspace orthocomplement for ` DVecA ` partial vector space. Temporarily, we are using the range of the isomorphism instead of the set of closed subspaces. Later, when inner product is introduced, we will show that these are the same. (Contributed by NM, 6-Dec-2013.)
axiom df_docaN {x3 z w k: setvar}:
  $ wceq cocaN (cmpt k cvv (cmpt w (cfv (cv k) clh) (cmpt x3 (cpw (cfv (cv w) (cfv (cv k) cltrn))) (cfv (co (co (cfv (cfv (cint (crab z (wss (cv x3) (cv z)) (crn (cfv (cv w) (cfv (cv k) cdia))))) (ccnv (cfv (cv w) (cfv (cv k) cdia)))) (cfv (cv k) coc)) (cfv (cv w) (cfv (cv k) coc)) (cfv (cv k) cjn)) (cv w) (cfv (cv k) cmee)) (cfv (cv w) (cfv (cv k) cdia)))))) $;

--| Subspace orthocomplement for ` DVecA ` partial vector space. (Contributed by NM, 6-Dec-2013.) (New usage is discouraged.)
theorem docaffvalN {x3 z w: setvar} (H: class x3 z) (c_or: class x3 z w) (K: class) (c_an c_pe V: class x3 z w):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wcel K V) (wceq (cfv K cocaN) (cmpt w H (cmpt x3 (cpw (cfv (cv w) (cfv K cltrn))) (cfv (co (co (cfv (cfv (cint (crab z (wss (cv x3) (cv z)) (crn (cfv (cv w) (cfv K cdia))))) (ccnv (cfv (cv w) (cfv K cdia)))) c_pe) (cfv (cv w) c_pe) c_or) (cv w) c_an) (cfv (cv w) (cfv K cdia)))))) $;

--| Subspace orthocomplement for ` DVecA ` partial vector space. (Contributed by NM, 6-Dec-2013.) (New usage is discouraged.)
theorem docafvalN {x3 z: setvar} (T: class z) (H: class x3 z) (I: class) (c_or: class x3 z) (K: class) (c_an N c_pe V: class x3 z) (W: class):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wceq N (cfv W (cfv K cocaN)) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wceq N (cmpt x3 (cpw T) (cfv (co (co (cfv (cfv (cint (crab z (wss (cv x3) (cv z)) (crn I))) (ccnv I)) c_pe) (cfv W c_pe) c_or) W c_an) I))) $;

--| Subspace orthocomplement for ` DVecA ` partial vector space. (Contributed by NM, 6-Dec-2013.) (New usage is discouraged.)
theorem docavalN {z: setvar} (T: class) (H: class z) (I: class) (c_or: class z) (K: class) (c_an N c_pe: class z) (W X: class):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wceq N (cfv W (cfv K cocaN)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wss X T)) (wceq (cfv X N) (cfv (co (co (cfv (cfv (cint (crab z (wss X (cv z)) (crn I))) (ccnv I)) c_pe) (cfv W c_pe) c_or) W c_an) I)) $;

--| Closure of subspace orthocomplement for ` DVecA ` partial vector space. (Contributed by NM, 6-Dec-2013.) (New usage is discouraged.)
theorem docaclN (T H I K c_pe W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wceq c_pe (cfv W (cfv K cocaN)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wss X T)) (wcel (cfv X c_pe) (crn I)) $;

--| Value of partial isomorphism A at lattice orthocomplement (using a Sasaki projection to get orthocomplement relative to the fiducial co-atom ` W ` ). (Contributed by NM, 6-Dec-2013.) (New usage is discouraged.)
theorem diaocN (T H I c_or K c_an N c_pe W X: class):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wceq N (cfv W (cfv K cocaN)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel X (cdm I))) (wceq (cfv (co (co (cfv X c_pe) (cfv W c_pe) c_or) W c_an) I) (cfv (cfv X I) N)) $;

--| Double orthocomplement of partial isomorphism A. (Contributed by NM, 6-Dec-2013.) (New usage is discouraged.)
theorem doca2N (H I K c_pe W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wceq c_pe (cfv W (cfv K cocaN)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel X (cdm I))) (wceq (cfv (cfv (cfv X I) c_pe) c_pe) (cfv X I)) $;

--| Double orthocomplement of partial isomorphism A. (Contributed by NM, 17-Jan-2014.) (New usage is discouraged.)
theorem doca3N (H I K c_pe W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wceq c_pe (cfv W (cfv K cocaN)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel X (crn I))) (wceq (cfv (cfv X c_pe) c_pe) X) $;

--| Any closed subspace is a member of the range of partial isomorphism A, showing the isomorphism maps onto the set of closed subspaces of partial vector space A. (Contributed by NM, 17-Jan-2014.) (New usage is discouraged.)
theorem dvadiaN (S U H I K c_pe W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdveca)) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wceq c_pe (cfv W (cfv K cocaN)) $ >
  $ wceq S (cfv U clss) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel X S) (wceq (cfv (cfv X c_pe) c_pe) X))) (wcel X (crn I)) $;

--| Partial isomorphism A maps onto the set of all closed subspaces of partial vector space A. Part of Lemma M of [Crawley] p. 121 line 12, with closed subspaces rather than subspaces. (Contributed by NM, 17-Jan-2014.) (New usage is discouraged.)
theorem diarnN {x3: setvar} (S: class) (U: class x3) (H I K: class) (c_pe: class x3) (W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdveca)) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wceq c_pe (cfv W (cfv K cocaN)) $ >
  $ wceq S (cfv U clss) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wceq (crn I) (crab x3 (wceq (cfv (cfv (cv x3) c_pe) c_pe) (cv x3)) S)) $;

--| The partial isomorphism A for a lattice ` K ` is a one-to-one, onto function. Part of Lemma M of [Crawley] p. 121 line 12, with closed subspaces rather than subspaces. See ~ diadm for the domain. (Contributed by NM, 17-Jan-2014.) (New usage is discouraged.)
theorem diaf1oN {x3: setvar} (S: class) (U: class x3) (H I K: class) (c_pe: class x3) (W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdveca)) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wceq c_pe (cfv W (cfv K cocaN)) $ >
  $ wceq S (cfv U clss) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wf1o (cdm I) (crab x3 (wceq (cfv (cfv (cv x3) c_pe) c_pe) (cv x3)) S) I) $;

--| Extend class notation with subspace join for ` DVecA ` partial vector space.
term cdjaN: class;

--| Define (closed) subspace join for ` DVecA ` partial vector space. (Contributed by NM, 6-Dec-2013.)
axiom df_djaN {x3 y1 w k: setvar}:
  $ wceq cdjaN (cmpt k cvv (cmpt w (cfv (cv k) clh) (cmpo x3 y1 (cpw (cfv (cv w) (cfv (cv k) cltrn))) (cpw (cfv (cv w) (cfv (cv k) cltrn))) (cfv (cin (cfv (cv x3) (cfv (cv w) (cfv (cv k) cocaN))) (cfv (cv y1) (cfv (cv w) (cfv (cv k) cocaN)))) (cfv (cv w) (cfv (cv k) cocaN)))))) $;

--| Subspace join for ` DVecA ` partial vector space. (Contributed by NM, 6-Dec-2013.) (New usage is discouraged.)
theorem djaffvalN {x3 y1 w: setvar} (H: class x3 y1) (K: class) (V: class x3 y1 w):
  $ wceq H (cfv K clh) $ >
  $ wi (wcel K V) (wceq (cfv K cdjaN) (cmpt w H (cmpo x3 y1 (cpw (cfv (cv w) (cfv K cltrn))) (cpw (cfv (cv w) (cfv K cltrn))) (cfv (cin (cfv (cv x3) (cfv (cv w) (cfv K cocaN))) (cfv (cv y1) (cfv (cv w) (cfv K cocaN)))) (cfv (cv w) (cfv K cocaN)))))) $;

--| Subspace join for ` DVecA ` partial vector space. TODO: take out hypothesis .i, no longer used. (Contributed by NM, 6-Dec-2013.) (New usage is discouraged.)
theorem djafvalN {x3 y1: setvar} (T: class) (H I J: class x3 y1) (K: class) (c_pe V: class x3 y1) (W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wceq c_pe (cfv W (cfv K cocaN)) $ >
  $ wceq J (cfv W (cfv K cdjaN)) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wceq J (cmpo x3 y1 (cpw T) (cpw T) (cfv (cin (cfv (cv x3) c_pe) (cfv (cv y1) c_pe)) c_pe))) $;

--| Subspace join for ` DVecA ` partial vector space. (Contributed by NM, 6-Dec-2013.) (New usage is discouraged.)
theorem djavalN (T H I J K c_pe W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wceq c_pe (cfv W (cfv K cocaN)) $ >
  $ wceq J (cfv W (cfv K cdjaN)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wss X T) (wss Y T))) (wceq (co X Y J) (cfv (cin (cfv X c_pe) (cfv Y c_pe)) c_pe)) $;

--| Closure of subspace join for ` DVecA ` partial vector space. (Contributed by NM, 5-Dec-2013.) (New usage is discouraged.)
theorem djaclN (T H I J K W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wceq J (cfv W (cfv K cdjaN)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wss X T) (wss Y T))) (wcel (co X Y J) (crn I)) $;

--| Transfer lattice join to ` DVecA ` partial vector space closed subspace join. Part of Lemma M of [Crawley] p. 120 line 29, with closed subspace join rather than subspace sum. (Contributed by NM, 5-Dec-2013.) (New usage is discouraged.)
theorem djajN (H I J c_or K W X Y: class):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdia)) $ >
  $ wceq J (cfv W (cfv K cdjaN)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel X (cdm I)) (wcel Y (cdm I)))) (wceq (cfv (co X Y c_or) I) (co (cfv X I) (cfv Y I) J)) $;

--| Extend class notation with isomorphism B.
term cdib: class;

--| Isomorphism B is isomorphism A extended with an extra dimension set to the zero vector component i.e. the zero endormorphism. Its domain is lattice elements less than or equal to the fiducial co-atom ` w ` . (Contributed by NM, 8-Dec-2013.)
axiom df_dib {x3 w f2 k: setvar}:
  $ wceq cdib (cmpt k cvv (cmpt w (cfv (cv k) clh) (cmpt x3 (cdm (cfv (cv w) (cfv (cv k) cdia))) (cxp (cfv (cv x3) (cfv (cv w) (cfv (cv k) cdia))) (csn (cmpt f2 (cfv (cv w) (cfv (cv k) cltrn)) (cres cid (cfv (cv k) cbs)))))))) $;

--| The partial isomorphism B for a lattice ` K ` . (Contributed by NM, 8-Dec-2013.)
theorem dibffval {x3 w f2: setvar} (B2: class x3 w f2) (H: class x3 f2) (K: class) (V: class x3 w f2):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wcel K V) (wceq (cfv K cdib) (cmpt w H (cmpt x3 (cdm (cfv (cv w) (cfv K cdia))) (cxp (cfv (cv x3) (cfv (cv w) (cfv K cdia))) (csn (cmpt f2 (cfv (cv w) (cfv K cltrn)) (cres cid B2))))))) $;

--| The partial isomorphism B for a lattice ` K ` . (Contributed by NM, 8-Dec-2013.)
theorem dibfval {x3 f2: setvar} (B2 T H I: class x3 f2) (J: class f2) (K: class) (V: class x3 f2) (W: class) (c_0: class x3 f2):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq c_0 (cmpt f2 T (cres cid B2)) $ >
  $ wceq J (cfv W (cfv K cdia)) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wceq I (cmpt x3 (cdm J) (cxp (cfv (cv x3) J) (csn c_0)))) $;

--| The partial isomorphism B for a lattice ` K ` . (Contributed by NM, 8-Dec-2013.)
theorem dibval {f2: setvar} (B2 T H I J: class f2) (K: class) (V: class f2) (W: class) (X c_0: class f2):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq c_0 (cmpt f2 T (cres cid B2)) $ >
  $ wceq J (cfv W (cfv K cdia)) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wcel X (cdm J))) (wceq (cfv X I) (cxp (cfv X J) (csn c_0))) $;

--| Member of the partial isomorphism B. (Contributed by NM, 18-Jan-2014.) (Revised by Mario Carneiro, 6-May-2015.) (New usage is discouraged.)
theorem dibopelvalN {f2: setvar} (B2 S: class f2) (T: class) (F H I J: class f2) (K: class) (V: class f2) (W: class) (X c_0: class f2):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq c_0 (cmpt f2 T (cres cid B2)) $ >
  $ wceq J (cfv W (cfv K cdia)) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wcel X (cdm J))) (wb (wcel (cop F S) (cfv X I)) (wa (wcel F (cfv X J)) (wceq S c_0))) $;

--| Value of the partial isomorphism B. (Contributed by NM, 18-Jan-2014.)
theorem dibval2 {f2: setvar} (B2 T H I J: class f2) (K: class) (c_le V: class f2) (W: class) (X c_0: class f2):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq c_0 (cmpt f2 T (cres cid B2)) $ >
  $ wceq J (cfv W (cfv K cdia)) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wa (wcel X B2) (wbr X W c_le))) (wceq (cfv X I) (cxp (cfv X J) (csn c_0))) $;

--| Member of the partial isomorphism B. (Contributed by NM, 3-Mar-2014.) (Revised by Mario Carneiro, 6-May-2015.)
theorem dibopelval2 {f2: setvar} (B2 S: class f2) (T: class) (F H I J: class f2) (K: class) (c_le V: class f2) (W: class) (X c_0: class f2):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq c_0 (cmpt f2 T (cres cid B2)) $ >
  $ wceq J (cfv W (cfv K cdia)) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wa (wcel X B2) (wbr X W c_le))) (wb (wcel (cop F S) (cfv X I)) (wa (wcel F (cfv X J)) (wceq S c_0))) $;

--| Value of the partial isomorphism B for a lattice ` K ` . (Contributed by NM, 24-Feb-2014.) (New usage is discouraged.)
theorem dibval3N {f2 g2: setvar} (B2 R: class f2 g2) (T: class g2) (H I: class f2 g2) (K: class) (c_le V: class f2 g2) (W: class) (X: class g2) (c_0: class f2 g2):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq c_0 (cmpt g2 T (cres cid B2)) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wa (wcel X B2) (wbr X W c_le))) (wceq (cfv X I) (cxp (crab f2 (wbr (cfv (cv f2) R) X c_le) T) (csn c_0))) $;

--| Member of the partial isomorphism B. (Contributed by NM, 26-Feb-2014.)
theorem dibelval3 {f2 g2: setvar} (B2: class g2) (R: class f2 g2) (T: class) (H: class g2) (I: class f2 g2) (K: class) (c_le V: class g2) (W: class) (X Y c_0: class g2):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq c_0 (cmpt g2 T (cres cid B2)) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wa (wcel X B2) (wbr X W c_le))) (wb (wcel Y (cfv X I)) (wrex f2 (wa (wceq Y (cop (cv f2) c_0)) (wbr (cfv (cv f2) R) X c_le)) T)) $;

--| Member of the partial isomorphism B. (Contributed by NM, 3-Mar-2014.)
theorem dibopelval3 {g2: setvar} (B2 R S: class g2) (T: class) (F H I: class g2) (K: class) (c_le V: class g2) (W: class) (X c_0: class g2):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq c_0 (cmpt g2 T (cres cid B2)) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wa (wcel X B2) (wbr X W c_le))) (wb (wcel (cop F S) (cfv X I)) (wa (wa (wcel F T) (wbr (cfv F R) X c_le)) (wceq S c_0))) $;

--| Membership in value of the partial isomorphism B for a lattice ` K ` . (Contributed by NM, 13-Feb-2014.)
theorem dibelval1st (B2 H I J K c_le V W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq J (cfv W (cfv K cdia)) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wi (w3a (wa (wcel K V) (wcel W H)) (wa (wcel X B2) (wbr X W c_le)) (wcel Y (cfv X I))) (wcel (cfv Y c1st) (cfv X J)) $;

--| Membership in value of the partial isomorphism B for a lattice ` K ` . (Contributed by NM, 13-Feb-2014.)
theorem dibelval1st1 (B2 T H I K c_le V W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wi (w3a (wa (wcel K V) (wcel W H)) (wa (wcel X B2) (wbr X W c_le)) (wcel Y (cfv X I))) (wcel (cfv Y c1st) T) $;

--| Membership in value of the partial isomorphism B for a lattice ` K ` . (Contributed by NM, 13-Feb-2014.) (New usage is discouraged.)
theorem dibelval1st2N (B2 R T H I K c_le V W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wi (w3a (wa (wcel K V) (wcel W H)) (wa (wcel X B2) (wbr X W c_le)) (wcel Y (cfv X I))) (wbr (cfv (cfv Y c1st) R) X c_le) $;

--| Membership in value of the partial isomorphism B for a lattice ` K ` . (Contributed by NM, 13-Feb-2014.)
theorem dibelval2nd {f2: setvar} (B2 T H I: class f2) (K: class) (c_le V: class f2) (W: class) (X Y c_0: class f2):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq c_0 (cmpt f2 T (cres cid B2)) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wi (w3a (wa (wcel K V) (wcel W H)) (wa (wcel X B2) (wbr X W c_le)) (wcel Y (cfv X I))) (wceq (cfv Y c2nd) c_0) $;

--| The value of the partial isomorphism B is not empty. (Contributed by NM, 18-Jan-2014.)
theorem dibn0 (B2 H I K c_le W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wbr X W c_le))) (wne (cfv X I) c0) $;

--| Functionality and domain of the partial isomorphism B. (Contributed by NM, 17-Jan-2014.)
theorem dibfna (H I J K V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq J (cfv W (cfv K cdia)) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wfn I (cdm J)) $;

--| Domain of the partial isomorphism B. (Contributed by NM, 17-Jan-2014.)
theorem dibdiadm (H I J K V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq J (cfv W (cfv K cdia)) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wceq (cdm I) (cdm J)) $;

--| Functionality and domain of the partial isomorphism B. (Contributed by NM, 17-Jan-2014.) (New usage is discouraged.)
theorem dibfnN {x3: setvar} (B2: class) (H I: class x3) (K c_le: class) (V: class x3) (W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wfn I (crab x3 (wbr (cv x3) W c_le) B2)) $;

--| Domain of the partial isomorphism A. (Contributed by NM, 8-Mar-2014.) (New usage is discouraged.)
theorem dibdmN {x3: setvar} (B2: class) (H I: class x3) (K c_le: class) (V: class x3) (W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wceq (cdm I) (crab x3 (wbr (cv x3) W c_le) B2)) $;

--| Member of domain of the partial isomorphism B. (Contributed by NM, 17-Jan-2014.) (New usage is discouraged.)
theorem dibeldmN (B2 H I K c_le V W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wb (wcel X (cdm I)) (wa (wcel X B2) (wbr X W c_le))) $;

--| The isomorphism B for a lattice ` K ` is order-preserving in the region under co-atom ` W ` . (Contributed by NM, 24-Feb-2014.)
theorem dibord (B2 H I K c_le W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wbr X W c_le)) (wa (wcel Y B2) (wbr Y W c_le))) (wb (wss (cfv X I) (cfv Y I)) (wbr X Y c_le)) $;

--| The isomorphism B for a lattice ` K ` is one-to-one in the region under co-atom ` W ` . (Contributed by NM, 24-Feb-2014.) (New usage is discouraged.)
theorem dib11N (B2 H I K c_le W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wbr X W c_le)) (wa (wcel Y B2) (wbr Y W c_le))) (wb (wceq (cfv X I) (cfv Y I)) (wceq X Y)) $;

--| The partial isomorphism A for a lattice ` K ` is a one-to-one function. Part of Lemma M of [Crawley] p. 120 line 27. (Contributed by NM, 4-Dec-2013.) (New usage is discouraged.)
theorem dibf11N (H I K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wf1o (cdm I) (crn I) I) $;

--| Closure of partial isomorphism B for a lattice ` K ` . (Contributed by NM, 8-Mar-2014.) (New usage is discouraged.)
theorem dibclN (H I K W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel X (cdm I))) (wcel (cfv X I) (crn I)) $;

--| The value of partial isomorphism B is a relation. (Contributed by NM, 8-Mar-2014.)
theorem dibvalrel (H I K V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wrel (cfv X I)) $;

--| The value of partial isomorphism B at the lattice zero is the singleton of the zero vector i.e. the zero subspace. (Contributed by NM, 27-Mar-2014.)
theorem dib0 (U H I K O W c_0: class):
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq O (cfv U c0g) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wceq (cfv c_0 I) (csn O)) $;

--| Two expressions for the 1-dimensional subspaces of vector space H. (Contributed by NM, 24-Feb-2014.) (Revised by Mario Carneiro, 24-Jun-2014.)
theorem dib1dim {g2 h s1: setvar} (B2: class g2 s1) (R: class g2 h) (T: class) (E F: class h) (H: class g2 h) (I: class g2 h s1) (K: class g2) (O: class h) (W: class g2):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq O (cmpt h T (cres cid B2)) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel F T)) (wceq (cfv (cfv F R) I) (crab g2 (wrex s1 (wceq (cv g2) (cop (cfv F (cv s1)) O)) E) (cxp T E))) $;

--| Partial isomorphism B of a lattice glb. (Contributed by NM, 9-Mar-2014.) (New usage is discouraged.)
theorem dibglbN {x3: setvar} (S G H: class) (I: class x3) (K W: class):
  $ wceq G (cfv K cglb) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wss S (cdm I)) (wne S c0))) (wceq (cfv (cfv S G) I) (ciin x3 S (cfv (cv x3) I))) $;

--| The intersection of partial isomorphism B closed subspaces is a closed subspace. (Contributed by NM, 8-Mar-2014.) (New usage is discouraged.)
theorem dibintclN (S H I K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wss S (crn I)) (wne S c0))) (wcel (cint S) (crn I)) $;

--| Two expressions for a 1-dimensional subspace of vector space H (when ` F ` is a nonzero vector i.e. non-identity translation). (Contributed by NM, 24-Feb-2014.)
theorem dib1dim2 {h: setvar} (B2: class) (R: class h) (T: class) (U F H I: class h) (K: class) (N O: class h) (W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq O (cmpt h T (cres cid B2)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wceq N (cfv U clspn) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel F T)) (wceq (cfv (cfv F R) I) (cfv (csn (cop F O)) N)) $;

--| The partial isomorphism B maps to a set of vectors in full vector space H. (Contributed by NM, 1-Jan-2014.)
theorem dibss (B2 U H I K c_le V W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wbr X W c_le))) (wss (cfv X I) V) $;

--| The value of partial isomorphism B is a subspace of partial vector space H. TODO: use dib* specific theorems instead of dia* ones to shorten proof? (Contributed by NM, 11-Feb-2014.)
theorem diblss (B2 S U H I K c_le W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wceq S (cfv U clss) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wbr X W c_le))) (wcel (cfv X I) S) $;

--| Membership in subspace sum for partial isomorphism B. (Contributed by NM, 21-Sep-2014.) (Revised by Mario Carneiro, 6-May-2015.)
theorem diblsmopel {f2: setvar} (ph: wff f2) (B2: class) (c_pb c_po S: class f2) (T: class) (U F: class f2) (H: class) (I J: class f2) (K: class) (c_le O V: class f2) (W: class) (X Y: class f2):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq O (cmpt f2 T (cres cid B2)) $ >
  $ wceq V (cfv W (cfv K cdveca)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_po (cfv V clsm) $ >
  $ wceq c_pb (cfv U clsm) $ >
  $ wceq J (cfv W (cfv K cdia)) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wa (wcel X B2) (wbr X W c_le)) $ >
  $ wi ph (wa (wcel Y B2) (wbr Y W c_le)) $ >
  $ wi ph (wb (wcel (cop F S) (co (cfv X I) (cfv Y I) c_pb)) (wa (wcel F (co (cfv X J) (cfv Y J) c_po)) (wceq S O))) $;

--| Extend class notation with isomorphism C.
term cdic: class;

--| Isomorphism C has domain of lattice atoms that are not less than or equal to the fiducial co-atom ` w ` . The value is a one-dimensional subspace generated by the pair consisting of the ` iota_ ` vector below and the endomorphism ring unity. Definition of phi(q) in [Crawley] p. 121. Note that we use the fixed atom ` ( ( oc ` k ) ` w ) ` to represent the p in their "Choose an atom p..." on line 21. (Contributed by NM, 15-Dec-2013.)
axiom df_dic {w f2 g2 k s1 r q: setvar}:
  $ wceq cdic (cmpt k cvv (cmpt w (cfv (cv k) clh) (cmpt q (crab r (wn (wbr (cv r) (cv w) (cfv (cv k) cple))) (cfv (cv k) catm)) (copab f2 s1 (wa (wceq (cv f2) (cfv (crio g2 (wceq (cfv (cfv (cv w) (cfv (cv k) coc)) (cv g2)) (cv q)) (cfv (cv w) (cfv (cv k) cltrn))) (cv s1))) (wcel (cv s1) (cfv (cv w) (cfv (cv k) ctendo)))))))) $;

--| The partial isomorphism C for a lattice ` K ` . (Contributed by NM, 15-Dec-2013.)
theorem dicffval {w f2 g2 s1 r q: setvar} (A2: class w f2 g2 s1 q) (H: class f2 g2 s1 r q) (K: class) (c_le V: class w f2 g2 s1 r q):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wcel K V) (wceq (cfv K cdic) (cmpt w H (cmpt q (crab r (wn (wbr (cv r) (cv w) c_le)) A2) (copab f2 s1 (wa (wceq (cv f2) (cfv (crio g2 (wceq (cfv (cfv (cv w) (cfv K coc)) (cv g2)) (cv q)) (cfv (cv w) (cfv K cltrn))) (cv s1))) (wcel (cv s1) (cfv (cv w) (cfv K ctendo)))))))) $;

--| The partial isomorphism C for a lattice ` K ` . (Contributed by NM, 15-Dec-2013.)
theorem dicfval {f2 g2 s1 r q: setvar} (A2: class f2 g2 s1) (P: class f2 g2 s1 r q) (T: class f2 s1 r q) (E H I: class f2 g2 s1 r q) (K: class) (c_le: class f2 g2 s1 r) (V: class f2 g2 s1 r q) (W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq P (cfv W (cfv K coc)) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq I (cfv W (cfv K cdic)) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wceq I (cmpt q (crab r (wn (wbr (cv r) W c_le)) A2) (copab f2 s1 (wa (wceq (cv f2) (cfv (crio g2 (wceq (cfv P (cv g2)) (cv q)) T) (cv s1))) (wcel (cv s1) E))))) $;

--| The partial isomorphism C for a lattice ` K ` . (Contributed by NM, 15-Dec-2013.) (Revised by Mario Carneiro, 22-Sep-2015.)
theorem dicval {f2 g2 s1: setvar} (A2: class f2 g2 s1) (P: class g2 s1) (Q: class) (T: class s1) (E: class g2) (H I: class f2 g2 s1) (K: class) (c_le V: class f2 g2 s1) (W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq P (cfv W (cfv K coc)) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq I (cfv W (cfv K cdic)) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wceq (cfv Q I) (copab f2 s1 (wa (wceq (cv f2) (cfv (crio g2 (wceq (cfv P (cv g2)) Q) T) (cv s1))) (wcel (cv s1) E)))) $;

--| Membership in value of the partial isomorphism C for a lattice ` K ` . (Contributed by NM, 15-Feb-2014.)
theorem dicopelval {g2: setvar} (A2 P: class g2) (Q: class) (S: class g2) (T: class) (E F H I: class g2) (K: class) (c_le V: class g2) (W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq P (cfv W (cfv K coc)) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq I (cfv W (cfv K cdic)) $ >
  $ wcel F cvv $ >
  $ wcel S cvv $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wb (wcel (cop F S) (cfv Q I)) (wa (wceq F (cfv (crio g2 (wceq (cfv P (cv g2)) Q) T) S)) (wcel S E))) $;

--| Membership in value of the partial isomorphism C for a lattice ` K ` . (Contributed by NM, 25-Feb-2014.) (New usage is discouraged.)
theorem dicelvalN {g2: setvar} (A2 P: class g2) (Q T: class) (E H I: class g2) (K: class) (c_le V: class g2) (W: class) (Y: class g2):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq P (cfv W (cfv K coc)) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq I (cfv W (cfv K cdic)) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wb (wcel Y (cfv Q I)) (wa (wcel Y (cxp cvv cvv)) (wa (wceq (cfv Y c1st) (cfv (crio g2 (wceq (cfv P (cv g2)) Q) T) (cfv Y c2nd))) (wcel (cfv Y c2nd) E)))) $;

--| The partial isomorphism C for a lattice ` K ` . (Contributed by NM, 20-Feb-2014.)
theorem dicval2 {f2 g2 s1: setvar} (A2: class f2 g2 s1) (P: class g2 s1) (Q: class) (T: class s1) (E: class g2) (G H I: class f2 g2 s1) (K: class) (c_le V: class f2 g2 s1) (W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq P (cfv W (cfv K coc)) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq I (cfv W (cfv K cdic)) $ >
  $ wceq G (crio g2 (wceq (cfv P (cv g2)) Q) T) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wceq (cfv Q I) (copab f2 s1 (wa (wceq (cv f2) (cfv G (cv s1))) (wcel (cv s1) E)))) $;

--| Member of the partial isomorphism C. (Contributed by NM, 26-Feb-2014.)
theorem dicelval3 {g2 s1: setvar} (A2 P: class g2 s1) (Q: class) (T: class s1) (E: class g2) (G H I: class g2 s1) (K: class) (c_le V: class g2 s1) (W: class) (Y: class g2):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq P (cfv W (cfv K coc)) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq I (cfv W (cfv K cdic)) $ >
  $ wceq G (crio g2 (wceq (cfv P (cv g2)) Q) T) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wb (wcel Y (cfv Q I)) (wrex s1 (wceq Y (cop (cfv G (cv s1)) (cv s1))) E)) $;

--| Membership in value of the partial isomorphism C for a lattice ` K ` . (Contributed by NM, 20-Feb-2014.)
theorem dicopelval2 {g2: setvar} (A2 P: class g2) (Q: class) (S: class g2) (T: class) (E F G H I: class g2) (K: class) (c_le V: class g2) (W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq P (cfv W (cfv K coc)) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq I (cfv W (cfv K cdic)) $ >
  $ wceq G (crio g2 (wceq (cfv P (cv g2)) Q) T) $ >
  $ wcel F cvv $ >
  $ wcel S cvv $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wb (wcel (cop F S) (cfv Q I)) (wa (wceq F (cfv G S)) (wcel S E))) $;

--| Membership in value of the partial isomorphism C for a lattice ` K ` . (Contributed by NM, 25-Feb-2014.) (New usage is discouraged.)
theorem dicelval2N {g2: setvar} (A2 P: class g2) (Q T: class) (E G H I: class g2) (K: class) (c_le V: class g2) (W: class) (Y: class g2):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq P (cfv W (cfv K coc)) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq I (cfv W (cfv K cdic)) $ >
  $ wceq G (crio g2 (wceq (cfv P (cv g2)) Q) T) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wb (wcel Y (cfv Q I)) (wa (wcel Y (cxp cvv cvv)) (wa (wceq (cfv Y c1st) (cfv G (cfv Y c2nd))) (wcel (cfv Y c2nd) E)))) $;

--| Functionality and domain of the partial isomorphism C. (Contributed by NM, 8-Mar-2014.) (New usage is discouraged.)
theorem dicfnN {p: setvar} (A2: class) (H I: class p) (K c_le: class) (V: class p) (W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdic)) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wfn I (crab p (wn (wbr (cv p) W c_le)) A2)) $;

--| Domain of the partial isomorphism C. (Contributed by NM, 8-Mar-2014.) (New usage is discouraged.)
theorem dicdmN {p: setvar} (A2: class) (H I: class p) (K c_le: class) (V: class p) (W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdic)) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wceq (cdm I) (crab p (wn (wbr (cv p) W c_le)) A2)) $;

--| The value of partial isomorphism C is a relation. (Contributed by NM, 8-Mar-2014.) (New usage is discouraged.)
theorem dicvalrelN (H I K V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdic)) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wrel (cfv X I)) $;

--| The partial isomorphism C maps to a set of vectors in full vector space H. (Contributed by NM, 19-Jan-2014.)
theorem dicssdvh (A2 Q U H I K c_le V W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdic)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wss (cfv Q I) V) $;

--| Membership in value of the partial isomorphism C for a lattice ` K ` . (Contributed by NM, 16-Feb-2014.)
theorem dicelval1sta {g2: setvar} (A2 P: class g2) (Q T: class) (H I: class g2) (K: class) (c_le V: class g2) (W: class) (Y: class g2):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq P (cfv W (cfv K coc)) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq I (cfv W (cfv K cdic)) $ >
  $ wi (w3a (wa (wcel K V) (wcel W H)) (wa (wcel Q A2) (wn (wbr Q W c_le))) (wcel Y (cfv Q I))) (wceq (cfv Y c1st) (cfv (crio g2 (wceq (cfv P (cv g2)) Q) T) (cfv Y c2nd))) $;

--| Membership in value of the partial isomorphism C for a lattice ` K ` . (Contributed by NM, 16-Feb-2014.) (New usage is discouraged.)
theorem dicelval1stN (A2 Q T H I K c_le W Y: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq I (cfv W (cfv K cdic)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel Q A2) (wn (wbr Q W c_le))) (wcel Y (cfv Q I))) (wcel (cfv Y c1st) T) $;

--| Membership in value of the partial isomorphism C for a lattice ` K ` . (Contributed by NM, 16-Feb-2014.)
theorem dicelval2nd (A2 Q E H I K c_le W Y: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq I (cfv W (cfv K cdic)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel Q A2) (wn (wbr Q W c_le))) (wcel Y (cfv Q I))) (wcel (cfv Y c2nd) E) $;

--| Membership in value of the partial isomorphism C is closed under vector sum. (Contributed by NM, 16-Feb-2014.)
theorem dicvaddcl (A2 c_pl Q U H I K c_le W X Y: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq I (cfv W (cfv K cdic)) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel Q A2) (wn (wbr Q W c_le))) (wa (wcel X (cfv Q I)) (wcel Y (cfv Q I)))) (wcel (co X Y c_pl) (cfv Q I)) $;

--| Membership in value of the partial isomorphism C is closed under scalar product. (Contributed by NM, 16-Feb-2014.) (Revised by Mario Carneiro, 24-Jun-2014.)
theorem dicvscacl (A2 Q c_x U E H I K c_le W X Y: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq I (cfv W (cfv K cdic)) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel Q A2) (wn (wbr Q W c_le))) (wa (wcel X E) (wcel Y (cfv Q I)))) (wcel (co X Y c_x) (cfv Q I)) $;

--| The value of the partial isomorphism C is not empty. (Contributed by NM, 15-Feb-2014.)
theorem dicn0 (A2 Q H I K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdic)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wne (cfv Q I) c0) $;

--| The value of partial isomorphism C is a subspace of partial vector space H. (Contributed by NM, 16-Feb-2014.)
theorem diclss (A2 Q S U H I K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq I (cfv W (cfv K cdic)) $ >
  $ wceq S (cfv U clss) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wcel (cfv Q I) S) $;

--| The value of isomorphism C is spanned by vector ` F ` . Part of proof of Lemma N of [Crawley] p. 121 line 29. (Contributed by NM, 21-Feb-2014.) (Revised by Mario Carneiro, 24-Jun-2014.)
theorem diclspsn {f2: setvar} (A2 P Q T: class) (U F: class f2) (H: class) (I: class f2) (K c_le: class) (N: class f2) (W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq P (cfv W (cfv K coc)) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq I (cfv W (cfv K cdic)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq F (crio f2 (wceq (cfv P (cv f2)) Q) T) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wceq (cfv Q I) (cfv (csn (cop F (cres cid T))) N)) $;


--| Lemma for ~ mapdord . (Contributed by NM, 27-Jan-2015.)
theorem mapdordlem1a {g2: setvar} (ph: wff g2) (C T U: class g2) (F: class) (H: class g2) (J: class) (K: class g2) (L O: class) (V W: class g2) (Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq O (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq Y (cfv U clsh) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq T (crab g2 (wcel (cfv (cfv (cfv (cv g2) L) O) O) Y) F) $ >
  $ wceq C (crab g2 (wceq (cfv (cfv (cfv (cv g2) L) O) O) (cfv (cv g2) L)) F) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wb (wcel J T) (wa (wcel J C) (wcel (cfv (cfv (cfv J L) O) O) Y))) $;

--| Lemma for ~ mapdord . (Contributed by NM, 27-Jan-2015.) (New usage is discouraged.)
theorem mapdordlem1bN {g2: setvar} (C: class g2) (F J L O: class):
  $ wceq C (crab g2 (wceq (cfv (cfv (cfv (cv g2) L) O) O) (cfv (cv g2) L)) F) $ >
  $ wb (wcel J C) (wa (wcel J F) (wceq (cfv (cfv (cfv J L) O) O) (cfv J L))) $;

--| Lemma for ~ mapdord . (Contributed by NM, 27-Jan-2015.)
theorem mapdordlem1 {g2: setvar} (T: class g2) (F J L O Y: class):
  $ wceq T (crab g2 (wcel (cfv (cfv (cfv (cv g2) L) O) O) Y) F) $ >
  $ wb (wcel J T) (wa (wcel J F) (wcel (cfv (cfv (cfv J L) O) O) Y)) $;

--| Lemma for ~ mapdord . Ordering property of projectivity ` M ` . TODO: This was proved using some hacked-up older proofs. Maybe simplify; get rid of the ` T ` hypothesis. (Contributed by NM, 27-Jan-2015.)
theorem mapdordlem2 {g2: setvar} (ph: wff g2) (A2 C S T: class g2) (U F: class) (H: class g2) (J K L: class) (M: class g2) (O W: class) (X Y: class g2):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wcel Y S) $ >
  $ wceq O (cfv W (cfv K coch)) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq J (cfv U clsh) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq T (crab g2 (wcel (cfv (cfv (cfv (cv g2) L) O) O) J) F) $ >
  $ wceq C (crab g2 (wceq (cfv (cfv (cfv (cv g2) L) O) O) (cfv (cv g2) L)) F) $ >
  $ wi ph (wb (wss (cfv X M) (cfv Y M)) (wss X Y)) $;

--| Ordering property of the map defined by ~ df-mapd . Property (b) of [Baer] p. 40. (Contributed by NM, 27-Jan-2015.)
theorem mapdord (ph: wff) (S U H K M W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wcel Y S) $ >
  $ wi ph (wb (wss (cfv X M) (cfv Y M)) (wss X Y)) $;

--| The map defined by ~ df-mapd is one-to-one. Property (c) of [Baer] p. 40. (Contributed by NM, 12-Mar-2015.)
theorem mapd11 (ph: wff) (S U H K M W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wcel Y S) $ >
  $ wi ph (wb (wceq (cfv X M) (cfv Y M)) (wceq X Y)) $;

--| The mapping of a subspace of vector space H to the dual space is a subspace of the dual space. TODO: Make this obsolete, use ~ mapdcl2 instead. (Contributed by NM, 31-Jan-2015.) (New usage is discouraged.)
theorem mapddlssN (ph: wff) (D R S T U H K M W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq D (cfv U cld) $ >
  $ wceq T (cfv D clss) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel R S) $ >
  $ wi ph (wcel (cfv R M) T) $;

--| Value of the map defined by ~ df-mapd at the span of a singleton. (Contributed by NM, 16-Feb-2015.)
theorem mapdsn {f2: setvar} (ph: wff) (U: class f2) (F: class) (H: class f2) (K: class) (L M: class f2) (N: class) (O V: class f2) (W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq O (cfv W (cfv K coch)) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wceq (cfv (cfv (csn X) N) M) (crab f2 (wss (cfv (csn X) O) (cfv (cv f2) L)) F)) $;

--| Value of the map defined by ~ df-mapd at the span of a singleton. (Contributed by NM, 16-Feb-2015.)
theorem mapdsn2 {f2: setvar} (ph: wff) (U: class f2) (F: class) (G H: class f2) (K: class) (L M: class f2) (N: class) (O V: class f2) (W X: class):

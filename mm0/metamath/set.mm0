theorem _2t0e0:
  $ wceq (co c2 cc0 cmul) cc0 $;

--| One half of four is two. (Contributed by NM, 3-Sep-1999.)
theorem _4div2e2:
  $ wceq (co c4 c2 cdiv) c2 $;


--| Lemma for ~ cvmlift3 . (Contributed by Mario Carneiro, 9-Jul-2015.)
theorem cvmlift3lem6 {x3 z f2 g2 k s1 b c d: setvar} (ph: wff z g2 k s1 b c d) (A2: class x3 g2) (B2: class k s1 c) (C: class) (P: class k s1) (Q: class x3 z k s1 b c d) (R: class x3 z f2 k s1 b c d) (S: class z g2 k s1 c d) (T: class x3 z f2 g2 k) (F: class) (G: class s1) (H: class k s1) (I: class x3 k s1 b c d) (J: class z) (K: class k s1 d) (M: class z k s1 b c d) (N: class x3 z k s1 b c d) (O: class k s1 d) (W: class z g2 k s1 b) (X: class k s1) (Y Z: class k s1 b c d):
  $ wceq B2 (cuni C) $ >
  $ wceq Y (cuni K) $ >
  $ wi ph (wcel F (co C J ccvm)) $ >
  $ wi ph (wcel K csconn) $ >
  $ wi ph (wcel K (cnlly cpconn)) $ >
  $ wi ph (wcel O Y) $ >
  $ wi ph (wcel G (co K J ccn)) $ >
  $ wi ph (wcel P B2) $ >
  $ wi ph (wceq (cfv P F) (cfv O G)) $ >
  $ wceq H (cmpt x3 Y (crio z (wrex f2 (w3a (wceq (cfv cc0 (cv f2)) O) (wceq (cfv c1 (cv f2)) (cv x3)) (wceq (cfv c1 (crio g2 (wa (wceq (ccom F (cv g2)) (ccom G (cv f2))) (wceq (cfv cc0 (cv g2)) P)) (co cii C ccn))) (cv z))) (co cii K ccn)) B2)) $ >
  $ wceq S (cmpt k J (crab s1 (wa (wceq (cuni (cv s1)) (cima (ccnv F) (cv k))) (wral c (wa (wral d (wceq (cin (cv c) (cv d)) c0) (cdif (cv s1) (csn (cv c)))) (wcel (cres F (cv c)) (co (co C (cv c) crest) (co J (cv k) crest) chmeo))) (cv s1))) (cdif (cpw C) (csn c0)))) $ >
  $ wi ph (wcel (cfv X G) A2) $ >
  $ wi ph (wcel T (cfv A2 S)) $ >
  $ wi ph (wss M (cima (ccnv G) A2)) $ >
  $ wceq W (crio b (wcel (cfv X H) (cv b)) T) $ >
  $ wi ph (wcel X M) $ >
  $ wi ph (wcel Z M) $ >
  $ wi ph (wcel Q (co cii K ccn)) $ >
  $ wceq R (crio g2 (wa (wceq (ccom F (cv g2)) (ccom G Q)) (wceq (cfv cc0 (cv g2)) P)) (co cii C ccn)) $ >
  $ wi ph (w3a (wceq (cfv cc0 Q) O) (wceq (cfv c1 Q) X) (wceq (cfv c1 R) (cfv X H))) $ >
  $ wi ph (wcel N (co cii (co K M crest) ccn)) $ >
  $ wi ph (wa (wceq (cfv cc0 N) X) (wceq (cfv c1 N) Z)) $ >
  $ wceq I (crio g2 (wa (wceq (ccom F (cv g2)) (ccom G N)) (wceq (cfv cc0 (cv g2)) (cfv X H))) (co cii C ccn)) $ >
  $ wi ph (wcel (cfv Z H) W) $;


  $ wceq c_po (cfv U clsm) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wceq (cfv E L) (cfv (csn X) c_pe)) $ >
  $ wi ph (wceq (cfv G L) (cfv (csn Y) c_pe)) $ >
  $ wceq B2 (co X (co (co (cfv X (co E G c_pl)) (cfv (cfv Y (co E G c_pl)) I) c_xp) Y c_x) c_mi) $ >
  $ wi ph (wne (cfv Y (co E G c_pl)) c_0) $ >
  $ wi ph (wceq B2 (cfv U c0g)) $ >
  $ wi ph (wceq (cfv (cfv (cfv (co E G c_pl) L) c_pe) c_pe) (cfv (co E G c_pl) L)) $;


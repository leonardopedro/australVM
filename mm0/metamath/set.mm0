  $ wi (w3a (wcel K chlt) (w3a (wcel (cv x3) A2) (wcel (cv r) A2) (wcel (cv y1) A2)) (wa (wcel (cv p) A2) (wcel (cv z) A2))) (wi (wa (wa (wn (wbr (cv x3) (co (cv r) (cv y1) c_or) c_le)) (wne (cv p) (cv z))) (wa (wbr (cv p) (co (cv x3) (cv r) c_or) c_le) (wbr (cv z) (co (cv r) (cv y1) c_or) c_le))) (wrex s1 (wa (wbr (cv s1) (co (cv x3) (cv y1) c_or) c_le) (wbr (cv s1) (co (cv p) (cv z) c_or) c_le)) A2)) $;

--| Lemma for ~ paddass . Combine ~ paddasslem1 , ~ paddasslem2 , and ~ paddasslem3 . (Contributed by NM, 8-Jan-2012.)

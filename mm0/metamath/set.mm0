  $ wceq B2 (cfv (cfv (cfv (cima L (cima E (cxp cn0 cn0))) chash) csqrt) cfl) $ >
  $ wceq C (cima E (cxp (co cc0 B2 cfz) (co cc0 B2 cfz))) $ >
  $ wi ph (wa (wcel Q cprime) (wbr Q N cdvds)) $ >
  $ wi ph (wral b (wceq (co (cv b) N cgcd) c1) (co c1 A2 cfz)) $ >
  $ wceq G (cmpt g2 (co cn0 (co cc0 A2 cfz) cmap) (co (cfv (cfv K cpl1) cmgp) (cmpt i (co cc0 A2 cfz) (co (cfv (cv i) (cv g2)) (co (cfv K cv1) (cfv (cfv (cv i) (cfv K czrh)) (cfv (cfv K cpl1) cascl)) (cfv (cfv K cpl1) cplusg)) (cfv (cfv (cfv K cpl1) cmgp) cmg))) cgsu)) $ >
  $ wi ph (wral a (wbr N (co (cfv K cv1) (cfv (cfv (cv a) (cfv K czrh)) (cfv (cfv K cpl1) cascl)) (cfv (cfv K cpl1) cplusg)) c_sm) (co c1 A2 cfz)) $ >
  $ wceq S (crab s1 (wbr (csu t (co cc0 A2 cfz) (cfv (cv t) (cv s1))) (co D c1 cmin) cle) (co cn0 (co cc0 A2 cfz) cmap)) $ >
  $ wi ph (wceq P Q) $;


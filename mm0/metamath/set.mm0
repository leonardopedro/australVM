--| Value of ` S ` . (Contributed by Thierry Arnoux, 12-Apr-2017.)
theorem ballotlemsval {x3 i k c: setvar} (C: class x3 c) (P S: class x3 i k c) (E F I M N O: class x3):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wceq O (crab c (wceq (cfv (cv c) chash) M) (cpw (co c1 (co M N caddc) cfz))) $ >
  $ wceq P (cmpt x3 (cpw O) (co (cfv (cv x3) chash) (cfv O chash) cdiv)) $ >
  $ wceq F (cmpt c O (cmpt i cz (co (cfv (cin (co c1 (cv i) cfz) (cv c)) chash) (cfv (cdif (co c1 (cv i) cfz) (cv c)) chash) cmin))) $ >
  $ wceq E (crab c (wral i (wbr cc0 (cfv (cv i) (cfv (cv c) F)) clt) (co c1 (co M N caddc) cfz)) O) $ >
  $ wbr N M clt $ >
  $ wceq I (cmpt c (cdif O E) (cinf (crab k (wceq (cfv (cv k) (cfv (cv c) F)) cc0) (co c1 (co M N caddc) cfz)) cr clt)) $ >
  $ wceq S (cmpt c (cdif O E) (cmpt i (co c1 (co M N caddc) cfz) (cif (wbr (cv i) (cfv (cv c) I) cle) (co (co (cfv (cv c) I) c1 caddc) (cv i) cmin) (cv i)))) $ >
  $ wi (wcel C (cdif O E)) (wceq (cfv C S) (cmpt i (co c1 (co M N caddc) cfz) (cif (wbr (cv i) (cfv C I) cle) (co (co (cfv C I) c1 caddc) (cv i) cmin) (cv i)))) $;

--| Value of ` S ` evaluated at ` J ` for a given counting ` C ` . (Contributed by Thierry Arnoux, 12-Apr-2017.)
theorem ballotlemsv {x3 i k c: setvar} (C: class x3 c) (P S: class x3 i k c) (E F I: class x3) (J: class x3 i k c) (M N O: class x3):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wceq O (crab c (wceq (cfv (cv c) chash) M) (cpw (co c1 (co M N caddc) cfz))) $ >
  $ wceq P (cmpt x3 (cpw O) (co (cfv (cv x3) chash) (cfv O chash) cdiv)) $ >
  $ wceq F (cmpt c O (cmpt i cz (co (cfv (cin (co c1 (cv i) cfz) (cv c)) chash) (cfv (cdif (co c1 (cv i) cfz) (cv c)) chash) cmin))) $ >
  $ wceq E (crab c (wral i (wbr cc0 (cfv (cv i) (cfv (cv c) F)) clt) (co c1 (co M N caddc) cfz)) O) $ >
  $ wbr N M clt $ >
  $ wceq I (cmpt c (cdif O E) (cinf (crab k (wceq (cfv (cv k) (cfv (cv c) F)) cc0) (co c1 (co M N caddc) cfz)) cr clt)) $ >
  $ wceq S (cmpt c (cdif O E) (cmpt i (co c1 (co M N caddc) cfz) (cif (wbr (cv i) (cfv (cv c) I) cle) (co (co (cfv (cv c) I) c1 caddc) (cv i) cmin) (cv i)))) $ >
  $ wi (wa (wcel C (cdif O E)) (wcel J (co c1 (co M N caddc) cfz))) (wceq (cfv J (cfv C S)) (cif (wbr J (cfv C I) cle) (co (co (cfv C I) c1 caddc) J cmin) J)) $;

--| ` S ` maps values less than ` ( I `` C ) ` to values greater than 1. (Contributed by Thierry Arnoux, 28-Apr-2017.)
theorem ballotlemsgt1 {x3 i k c: setvar} (C: class x3 c) (P S: class x3 i k c) (E F I: class x3) (J: class x3 i k c) (M N O: class x3):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wceq O (crab c (wceq (cfv (cv c) chash) M) (cpw (co c1 (co M N caddc) cfz))) $ >
  $ wceq P (cmpt x3 (cpw O) (co (cfv (cv x3) chash) (cfv O chash) cdiv)) $ >
  $ wceq F (cmpt c O (cmpt i cz (co (cfv (cin (co c1 (cv i) cfz) (cv c)) chash) (cfv (cdif (co c1 (cv i) cfz) (cv c)) chash) cmin))) $ >
  $ wceq E (crab c (wral i (wbr cc0 (cfv (cv i) (cfv (cv c) F)) clt) (co c1 (co M N caddc) cfz)) O) $ >
  $ wbr N M clt $ >
  $ wceq I (cmpt c (cdif O E) (cinf (crab k (wceq (cfv (cv k) (cfv (cv c) F)) cc0) (co c1 (co M N caddc) cfz)) cr clt)) $ >
  $ wceq S (cmpt c (cdif O E) (cmpt i (co c1 (co M N caddc) cfz) (cif (wbr (cv i) (cfv (cv c) I) cle) (co (co (cfv (cv c) I) c1 caddc) (cv i) cmin) (cv i)))) $ >
  $ wi (w3a (wcel C (cdif O E)) (wcel J (co c1 (co M N caddc) cfz)) (wbr J (cfv C I) clt)) (wbr c1 (cfv J (cfv C S)) clt) $;

--| Domain of ` S ` for a given counting ` C ` . (Contributed by Thierry Arnoux, 12-Apr-2017.)
theorem ballotlemsdom {x3 i k c: setvar} (C: class x3 c) (P S: class x3 i k c) (E F I: class x3) (J: class x3 i k c) (M N O: class x3):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wceq O (crab c (wceq (cfv (cv c) chash) M) (cpw (co c1 (co M N caddc) cfz))) $ >
  $ wceq P (cmpt x3 (cpw O) (co (cfv (cv x3) chash) (cfv O chash) cdiv)) $ >
  $ wceq F (cmpt c O (cmpt i cz (co (cfv (cin (co c1 (cv i) cfz) (cv c)) chash) (cfv (cdif (co c1 (cv i) cfz) (cv c)) chash) cmin))) $ >
  $ wceq E (crab c (wral i (wbr cc0 (cfv (cv i) (cfv (cv c) F)) clt) (co c1 (co M N caddc) cfz)) O) $ >
  $ wbr N M clt $ >

  $ wceq P (cfv R cpl1) $ >
  $ wi (wa (w3a (wcel N cfn) (wcel R crg) (wcel O L)) (wcel K cn0)) (wceq (co (cfv O I) K cdecpmat) (cmpo i j N N (cfv K (cfv (co P (cmpt k cn0 (co (co (cv i) (cv j) (cfv (cv k) (cfv O cco1))) (co (cv k) Y E) c_x)) cgsu) cco1)))) $;

--| Lemma 4 for ~ mp2pm2mp . (Contributed by AV, 12-Oct-2019.) (Revised by AV, 5-Dec-2019.)
theorem mp2pm2mplem4 {i j k p: setvar} (A2: class p) (P: class) (Q: class i j k p) (R c_x E: class) (I: class i j k p) (K: class p) (L N O Y: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq Q (cfv A2 cpl1) $ >
  $ wceq L (cfv Q cbs) $ >
  $ wceq c_x (cfv P cvsca) $ >
  $ wceq E (cfv (cfv P cmgp) cmg) $ >
  $ wceq Y (cfv R cv1) $ >
  $ wceq I (cmpt p L (cmpo i j N N (co P (cmpt k cn0 (co (co (cv i) (cv j) (cfv (cv k) (cfv (cv p) cco1))) (co (cv k) Y E) c_x)) cgsu))) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wi (wa (w3a (wcel N cfn) (wcel R crg) (wcel O L)) (wcel K cn0)) (wceq (co (cfv O I) K cdecpmat) (cfv K (cfv O cco1))) $;

--| Lemma 5 for ~ mp2pm2mp . (Contributed by AV, 12-Oct-2019.) (Revised by AV, 5-Dec-2019.)
theorem mp2pm2mplem5 {i j k p: setvar} (A2: class p) (P: class) (Q: class i j k p) (R c_x E: class) (c_ex I: class i j k p) (c_as: class i j p) (L N O: class) (X: class i j k p) (Y: class):
  $ wceq A2 (co N R cmat) $ >

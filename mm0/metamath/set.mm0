  $ wceq J (cmpt j cz (co (cv j) M (cfv (co (cfv K cmgp) U cress) cmg))) $ >
  $ wceq U (crab m (wrex n (wceq (co (cv n) (cv m) (cfv (cfv K cmgp) cplusg)) (cfv (cfv K cmgp) c0g)) (cfv (cfv K cmgp) cbs)) (cfv (cfv K cmgp) cbs)) $ >
  $ wceq X (cmpt a (cfv (co czring (co czring (cima (ccnv J) (csn (cfv (co (co (cfv K cmgp) U cress) (crn J) cress) c0g))) cqg) cqus) cbs) (cuni (cima J (cv a)))) $ >
  $ wi ph (wbr (co (co D A2 caddc) (co D c1 cmin) cbc) (cfv (cima H (co cn0 (co cc0 A2 cfz) cmap)) chash) cle) $;

--| Inequality for binomial coefficients. (Contributed by metakunt, 12-May-2025.)
theorem bcled (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cn0) $ >
  $ wi ph (wcel B2 cn0) $ >
  $ wi ph (wcel C cz) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wi ph (wbr (co A2 C cbc) (co B2 C cbc) cle) $;

--| Inequality for binomial coefficients. (Contributed by metakunt, 12-May-2025.)
theorem bcle2d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 cn0) $ >
  $ wi ph (wcel B2 cn0) $ >
  $ wi ph (wcel C cn0) $ >
  $ wi ph (wcel D cz) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wi ph (wbr D C cle) $ >
  $ wi ph (wbr (co (co A2 C caddc) (co A2 D caddc) cbc) (co (co B2 C caddc) (co B2 D caddc) cbc) cle) $;

--| The last set of inequalities of Claim 7 of Theorem 6.1 ~ https://www3.nd.edu/%7eandyp/notes/AKS.pdf . (Contributed by metakunt, 12-May-2025.)
theorem aks6d1c7lem1 {k l: setvar} (ph: wff) (A2 D: class k l) (P: class) (R E L: class k l) (N: class):
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel R cn) $ >
  $ wi ph (wcel N (cfv c3 cuz)) $ >
  $ wi ph (wbr P N cdvds) $ >
  $ wi ph (wceq (co N R cgcd) c1) $ >
  $ wceq E (cmpo k l cn0 cn0 (co (co P (cv k) cexp) (co (co N P cdiv) (cv l) cexp) cmul)) $ >
  $ wceq L (cfv (cfv R czn) czrh) $ >
  $ wceq D (cfv (cima L (cima E (cxp cn0 cn0))) chash) $ >
  $ wceq A2 (cfv (co (cfv (cfv R cphi) csqrt) (co c2 N clogb) cmul) cfl) $ >
  $ wi ph (wbr (co (co c2 N clogb) c2 cexp) (cfv N (cfv R codz)) clt) $ >
  $ wi ph (wbr (co N (cfv (cfv D csqrt) cfl) cexp) (co (co D A2 caddc) (co D c1 cmin) cbc) clt) $;


  $ wceq S (cmpt c (cdif O E) (cmpt i (co c1 (co M N caddc) cfz) (cif (wbr (cv i) (cfv (cv c) I) cle) (co (co (cfv (cv c) I) c1 caddc) (cv i) cmin) (cv i)))) $ >
  $ wi (wa (wcel C (cdif O E)) (wcel J (co c1 (co M N caddc) cfz))) (wcel (cfv J (cfv C S)) (co c1 (co M N caddc) cfz)) $;

--| The range ` ( 1 ... ( I `` C ) ) ` is invariant under ` ( S `` C ) ` . (Contributed by Thierry Arnoux, 28-Apr-2017.)
theorem ballotlemsel1i {x3 i k c: setvar} (C: class x3 c) (P S: class x3 i k c) (E F I: class x3) (J: class x3 i k c) (M N O: class x3):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wceq O (crab c (wceq (cfv (cv c) chash) M) (cpw (co c1 (co M N caddc) cfz))) $ >
  $ wceq P (cmpt x3 (cpw O) (co (cfv (cv x3) chash) (cfv O chash) cdiv)) $ >
  $ wceq F (cmpt c O (cmpt i cz (co (cfv (cin (co c1 (cv i) cfz) (cv c)) chash) (cfv (cdif (co c1 (cv i) cfz) (cv c)) chash) cmin))) $ >
  $ wceq E (crab c (wral i (wbr cc0 (cfv (cv i) (cfv (cv c) F)) clt) (co c1 (co M N caddc) cfz)) O) $ >
  $ wbr N M clt $ >
  $ wceq I (cmpt c (cdif O E) (cinf (crab k (wceq (cfv (cv k) (cfv (cv c) F)) cc0) (co c1 (co M N caddc) cfz)) cr clt)) $ >
  $ wceq S (cmpt c (cdif O E) (cmpt i (co c1 (co M N caddc) cfz) (cif (wbr (cv i) (cfv (cv c) I) cle) (co (co (cfv (cv c) I) c1 caddc) (cv i) cmin) (cv i)))) $ >
  $ wi (wa (wcel C (cdif O E)) (wcel J (co c1 (cfv C I) cfz))) (wcel (cfv J (cfv C S)) (co c1 (cfv C I) cfz)) $;

--| The defined ` S ` is a bijection, and an involution. (Contributed by Thierry Arnoux, 14-Apr-2017.)
theorem ballotlemsf1o {x3 i k c: setvar} (C: class x3 c) (P S: class x3 i k c) (E F I M N O: class x3):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wceq O (crab c (wceq (cfv (cv c) chash) M) (cpw (co c1 (co M N caddc) cfz))) $ >
  $ wceq P (cmpt x3 (cpw O) (co (cfv (cv x3) chash) (cfv O chash) cdiv)) $ >
  $ wceq F (cmpt c O (cmpt i cz (co (cfv (cin (co c1 (cv i) cfz) (cv c)) chash) (cfv (cdif (co c1 (cv i) cfz) (cv c)) chash) cmin))) $ >
  $ wceq E (crab c (wral i (wbr cc0 (cfv (cv i) (cfv (cv c) F)) clt) (co c1 (co M N caddc) cfz)) O) $ >
  $ wbr N M clt $ >
  $ wceq I (cmpt c (cdif O E) (cinf (crab k (wceq (cfv (cv k) (cfv (cv c) F)) cc0) (co c1 (co M N caddc) cfz)) cr clt)) $ >
  $ wceq S (cmpt c (cdif O E) (cmpt i (co c1 (co M N caddc) cfz) (cif (wbr (cv i) (cfv (cv c) I) cle) (co (co (cfv (cv c) I) c1 caddc) (cv i) cmin) (cv i)))) $ >
  $ wi (wcel C (cdif O E)) (wa (wf1o (co c1 (co M N caddc) cfz) (co c1 (co M N caddc) cfz) (cfv C S)) (wceq (ccnv (cfv C S)) (cfv C S))) $;

--| The image by ` S ` of the first tie pick is the first pick. (Contributed by Thierry Arnoux, 14-Apr-2017.)
theorem ballotlemsi {x3 i k c: setvar} (C: class x3 c) (P S: class x3 i k c) (E F I M N O: class x3):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wceq O (crab c (wceq (cfv (cv c) chash) M) (cpw (co c1 (co M N caddc) cfz))) $ >
  $ wceq P (cmpt x3 (cpw O) (co (cfv (cv x3) chash) (cfv O chash) cdiv)) $ >
  $ wceq F (cmpt c O (cmpt i cz (co (cfv (cin (co c1 (cv i) cfz) (cv c)) chash) (cfv (cdif (co c1 (cv i) cfz) (cv c)) chash) cmin))) $ >
  $ wceq E (crab c (wral i (wbr cc0 (cfv (cv i) (cfv (cv c) F)) clt) (co c1 (co M N caddc) cfz)) O) $ >
  $ wbr N M clt $ >
  $ wceq I (cmpt c (cdif O E) (cinf (crab k (wceq (cfv (cv k) (cfv (cv c) F)) cc0) (co c1 (co M N caddc) cfz)) cr clt)) $ >
  $ wceq S (cmpt c (cdif O E) (cmpt i (co c1 (co M N caddc) cfz) (cif (wbr (cv i) (cfv (cv c) I) cle) (co (co (cfv (cv c) I) c1 caddc) (cv i) cmin) (cv i)))) $ >
  $ wi (wcel C (cdif O E)) (wceq (cfv (cfv C I) (cfv C S)) c1) $;

--| The image by ` S ` of an interval before the first pick. (Contributed by Thierry Arnoux, 5-May-2017.)
theorem ballotlemsima {x3 i k c: setvar} (C: class x3 c) (P: class x3 i k c) (S: class x3 i c) (E F I: class x3) (J: class x3 i c) (M N O: class x3):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wceq O (crab c (wceq (cfv (cv c) chash) M) (cpw (co c1 (co M N caddc) cfz))) $ >
  $ wceq P (cmpt x3 (cpw O) (co (cfv (cv x3) chash) (cfv O chash) cdiv)) $ >
  $ wceq F (cmpt c O (cmpt i cz (co (cfv (cin (co c1 (cv i) cfz) (cv c)) chash) (cfv (cdif (co c1 (cv i) cfz) (cv c)) chash) cmin))) $ >
  $ wceq E (crab c (wral i (wbr cc0 (cfv (cv i) (cfv (cv c) F)) clt) (co c1 (co M N caddc) cfz)) O) $ >
  $ wbr N M clt $ >
  $ wceq I (cmpt c (cdif O E) (cinf (crab k (wceq (cfv (cv k) (cfv (cv c) F)) cc0) (co c1 (co M N caddc) cfz)) cr clt)) $ >
  $ wceq S (cmpt c (cdif O E) (cmpt i (co c1 (co M N caddc) cfz) (cif (wbr (cv i) (cfv (cv c) I) cle) (co (co (cfv (cv c) I) c1 caddc) (cv i) cmin) (cv i)))) $ >
  $ wi (wa (wcel C (cdif O E)) (wcel J (co c1 (cfv C I) cfz))) (wceq (cima (cfv C S) (co c1 J cfz)) (co (cfv J (cfv C S)) (cfv C I) cfz)) $;

--| If two countings share the same first tie, they also have the same swap function. (Contributed by Thierry Arnoux, 18-Apr-2017.)
theorem ballotlemieq {x3 i k c: setvar} (C D: class x3 c) (P: class x3 i k c) (S: class x3 i c) (E F I M N O: class x3):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wceq O (crab c (wceq (cfv (cv c) chash) M) (cpw (co c1 (co M N caddc) cfz))) $ >
  $ wceq P (cmpt x3 (cpw O) (co (cfv (cv x3) chash) (cfv O chash) cdiv)) $ >
  $ wceq F (cmpt c O (cmpt i cz (co (cfv (cin (co c1 (cv i) cfz) (cv c)) chash) (cfv (cdif (co c1 (cv i) cfz) (cv c)) chash) cmin))) $ >
  $ wceq E (crab c (wral i (wbr cc0 (cfv (cv i) (cfv (cv c) F)) clt) (co c1 (co M N caddc) cfz)) O) $ >
  $ wbr N M clt $ >
  $ wceq I (cmpt c (cdif O E) (cinf (crab k (wceq (cfv (cv k) (cfv (cv c) F)) cc0) (co c1 (co M N caddc) cfz)) cr clt)) $ >
  $ wceq S (cmpt c (cdif O E) (cmpt i (co c1 (co M N caddc) cfz) (cif (wbr (cv i) (cfv (cv c) I) cle) (co (co (cfv (cv c) I) c1 caddc) (cv i) cmin) (cv i)))) $ >
  $ wi (w3a (wcel C (cdif O E)) (wcel D (cdif O E)) (wceq (cfv C I) (cfv D I))) (wceq (cfv C S) (cfv D S)) $;

--| Value of ` R ` . (Contributed by Thierry Arnoux, 14-Apr-2017.)
theorem ballotlemrval {x3 i k c: setvar} (C: class x3 c) (P R: class x3 i k c) (S E F I M N O: class x3):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wceq O (crab c (wceq (cfv (cv c) chash) M) (cpw (co c1 (co M N caddc) cfz))) $ >
  $ wceq P (cmpt x3 (cpw O) (co (cfv (cv x3) chash) (cfv O chash) cdiv)) $ >
  $ wceq F (cmpt c O (cmpt i cz (co (cfv (cin (co c1 (cv i) cfz) (cv c)) chash) (cfv (cdif (co c1 (cv i) cfz) (cv c)) chash) cmin))) $ >
  $ wceq E (crab c (wral i (wbr cc0 (cfv (cv i) (cfv (cv c) F)) clt) (co c1 (co M N caddc) cfz)) O) $ >
  $ wbr N M clt $ >
  $ wceq I (cmpt c (cdif O E) (cinf (crab k (wceq (cfv (cv k) (cfv (cv c) F)) cc0) (co c1 (co M N caddc) cfz)) cr clt)) $ >
  $ wceq S (cmpt c (cdif O E) (cmpt i (co c1 (co M N caddc) cfz) (cif (wbr (cv i) (cfv (cv c) I) cle) (co (co (cfv (cv c) I) c1 caddc) (cv i) cmin) (cv i)))) $ >
  $ wceq R (cmpt c (cdif O E) (cima (cfv (cv c) S) (cv c))) $ >
  $ wi (wcel C (cdif O E)) (wceq (cfv C R) (cima (cfv C S) C)) $;


  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wa (wcel G T) (wne P Q)) (w3a (wne (cfv P G) P) (wbr (cfv G R) (co P Q c_or) c_le) (wn (wrex r (wa (wn (wbr (cv r) W c_le)) (wceq (co P (cv r) c_or) (co Q (cv r) c_or))) A2)))) (wceq (cfv P G) Q) $;


--| Lemma 1 for ~ pmatcollpwscmat . (Contributed by AV, 2-Nov-2019.) (Revised by AV, 4-Dec-2019.)
theorem pmatcollpwscmatlem1 (A2 B2 C D P Q R S T U c_1 E c_ex c_as K L M N X: class) (a b: setvar):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq c_as (cfv C cvsca) $ >
  $ wceq c_ex (cfv (cfv P cmgp) cmg) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq D (cfv A2 cbs) $ >
  $ wceq U (cfv P cascl) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq E (cfv P cbs) $ >
  $ wceq S (cfv P cascl) $ >
  $ wceq c_1 (cfv C cur) $ >
  $ wceq M (co Q c_1 c_as) $ >
  $ wi (wa (wa (wa (wcel N cfn) (wcel R crg)) (wa (wcel L cn0) (wcel Q E))) (wa (wcel (cv a) N) (wcel (cv b) N))) (wceq (co (cfv L (cfv (co (cv a) (cv b) M) cco1)) (co cc0 (cfv R cv1) (cfv (cfv P cmgp) cmg)) (cfv P cvsca)) (cif (wceq (cv a) (cv b)) (cfv (cfv L (cfv Q cco1)) U) (cfv P c0g))) $;

--| Lemma 2 for ~ pmatcollpwscmat . (Contributed by AV, 2-Nov-2019.) (Revised by AV, 4-Dec-2019.)
theorem pmatcollpwscmatlem2 (A2 B2 C D P Q R S T U c_1 E c_ex c_as K L M N X: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >

theorem _4atex2_0bOLDN {z r: setvar} (A2 P Q S T: class) (H: class z) (c_or K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (w3a (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le))) (wa (wcel S A2) (wn (wbr S W c_le)))) (w3a (wne P Q) (wceq T (cfv K cp0)) (wrex r (wa (wn (wbr (cv r) W c_le)) (wceq (co P (cv r) c_or) (co Q (cv r) c_or))) A2))) (wrex z (wa (wn (wbr (cv z) W c_le)) (wceq (co S (cv z) c_or) (co T (cv z) c_or))) A2) $;

--| Same as ~ 4atex2 except that ` S ` and ` T ` are zero. TODO: do we need this one or ~ 4atex2-0aOLDN or ~ 4atex2-0bOLDN ? (Contributed by NM, 27-May-2013.) (New usage is discouraged.)
theorem _4atex2_0cOLDN {z r: setvar} (A2 P Q S T H c_or K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (w3a (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le))) (wceq S (cfv K cp0))) (w3a (wne P Q) (wceq T (cfv K cp0)) (wrex r (wa (wn (wbr (cv r) W c_le)) (wceq (co P (cv r) c_or) (co Q (cv r) c_or))) A2))) (wrex z (wa (wn (wbr (cv z) W c_le)) (wceq (co S (cv z) c_or) (co T (cv z) c_or))) A2) $;

--| More general version of ~ 4atex for a line ` S .\/ T ` not necessarily connected to ` P .\/ Q ` . (Contributed by NM, 29-May-2013.)
theorem _4atex3 {z r: setvar} (A2 P Q S T H c_or K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (w3a (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le))) (wa (wcel S A2) (wn (wbr S W c_le)))) (w3a (wne P Q) (wa (wcel T A2) (wne S T)) (wrex r (wa (wn (wbr (cv r) W c_le)) (wceq (co P (cv r) c_or) (co Q (cv r) c_or))) A2))) (wrex z (wa (wn (wbr (cv z) W c_le)) (w3a (wne (cv z) S) (wne (cv z) T) (wbr (cv z) (co S T c_or) c_le))) A2) $;

--| The set of lattice automorphisms. (Contributed by NM, 11-May-2012.)
theorem lautset {x3 y1 f2: setvar} (A2: class x3 y1 f2) (B2: class) (I: class x3 y1 f2) (K: class) (c_le: class x3 y1):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq I (cfv K claut) $ >
  $ wi (wcel K A2) (wceq I (cab f2 (wa (wf1o B2 B2 (cv f2)) (wral x3 (wral y1 (wb (wbr (cv x3) (cv y1) c_le) (wbr (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) c_le)) B2) B2)))) $;

--| The predicate "is a lattice automorphism". (Contributed by NM, 11-May-2012.)
theorem islaut {x3 y1: setvar} (A2: class x3 y1) (B2 F: class) (I: class x3 y1) (K: class) (c_le: class x3 y1):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq I (cfv K claut) $ >
  $ wi (wcel K A2) (wb (wcel F I) (wa (wf1o B2 B2 F) (wral x3 (wral y1 (wb (wbr (cv x3) (cv y1) c_le) (wbr (cfv (cv x3) F) (cfv (cv y1) F) c_le)) B2) B2))) $;

--| Less-than or equal property of a lattice automorphism. (Contributed by NM, 19-May-2012.)
theorem lautle (B2 F I K c_le V X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq I (cfv K claut) $ >
  $ wi (wa (wa (wcel K V) (wcel F I)) (wa (wcel X B2) (wcel Y B2))) (wb (wbr X Y c_le) (wbr (cfv X F) (cfv Y F) c_le)) $;

--| A lattice automorphism is one-to-one and onto. (Contributed by NM, 19-May-2012.)
theorem laut1o (A2 B2 F I K: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq I (cfv K claut) $ >
  $ wi (wa (wcel K A2) (wcel F I)) (wf1o B2 B2 F) $;

--| One-to-one property of a lattice automorphism. (Contributed by NM, 20-May-2012.)
theorem laut11 (B2 F I K V X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq I (cfv K claut) $ >
  $ wi (wa (wa (wcel K V) (wcel F I)) (wa (wcel X B2) (wcel Y B2))) (wb (wceq (cfv X F) (cfv Y F)) (wceq X Y)) $;

--| A lattice automorphism value belongs to the base set. (Contributed by NM, 20-May-2012.)
theorem lautcl (B2 F I K V X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq I (cfv K claut) $ >
  $ wi (wa (wa (wcel K V) (wcel F I)) (wcel X B2)) (wcel (cfv X F) B2) $;

--| Reverse closure of a lattice automorphism. (Contributed by NM, 25-May-2012.) (New usage is discouraged.)
theorem lautcnvclN (B2 F I K V X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq I (cfv K claut) $ >
  $ wi (wa (wa (wcel K V) (wcel F I)) (wcel X B2)) (wcel (cfv X (ccnv F)) B2) $;

--| Less-than or equal property of lattice automorphism converse. (Contributed by NM, 19-May-2012.)
theorem lautcnvle (B2 F I K c_le V X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq I (cfv K claut) $ >
  $ wi (wa (wa (wcel K V) (wcel F I)) (wa (wcel X B2) (wcel Y B2))) (wb (wbr X Y c_le) (wbr (cfv X (ccnv F)) (cfv Y (ccnv F)) c_le)) $;

--| The converse of a lattice automorphism is a lattice automorphism. (Contributed by NM, 10-May-2013.)
theorem lautcnv (F I K V: class):
  $ wceq I (cfv K claut) $ >
  $ wi (wa (wcel K V) (wcel F I)) (wcel (ccnv F) I) $;

--| Less-than property of a lattice automorphism. (Contributed by NM, 20-May-2012.)
theorem lautlt (A2 B2 c_lt F I K X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq I (cfv K claut) $ >
  $ wi (wa (wcel K A2) (w3a (wcel F I) (wcel X B2) (wcel Y B2))) (wb (wbr X Y c_lt) (wbr (cfv X F) (cfv Y F) c_lt)) $;

--| Covering property of a lattice automorphism. (Contributed by NM, 20-May-2012.)
theorem lautcvr (A2 B2 C F I K X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq I (cfv K claut) $ >
  $ wi (wa (wcel K A2) (w3a (wcel F I) (wcel X B2) (wcel Y B2))) (wb (wbr X Y C) (wbr (cfv X F) (cfv Y F) C)) $;

--| Meet property of a lattice automorphism. (Contributed by NM, 25-May-2012.)
theorem lautj (B2 F I c_or K X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq I (cfv K claut) $ >
  $ wi (wa (wcel K clat) (w3a (wcel F I) (wcel X B2) (wcel Y B2))) (wceq (cfv (co X Y c_or) F) (co (cfv X F) (cfv Y F) c_or)) $;

--| Meet property of a lattice automorphism. (Contributed by NM, 19-May-2012.)
theorem lautm (B2 F I K c_an X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq I (cfv K claut) $ >
  $ wi (wa (wcel K clat) (w3a (wcel F I) (wcel X B2) (wcel Y B2))) (wceq (cfv (co X Y c_an) F) (co (cfv X F) (cfv Y F) c_an)) $;

--| A lattice automorphism argument is equal to its value if all atoms are equal to their values. (Contributed by NM, 24-May-2012.)
theorem lauteq {p: setvar} (A2 B2 F I K X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq I (cfv K claut) $ >
  $ wi (wa (w3a (wcel K chlt) (wcel F I) (wcel X B2)) (wral p (wceq (cfv (cv p) F) (cv p)) A2)) (wceq (cfv X F) X) $;

--| The identity function is a lattice automorphism. (Contributed by NM, 18-May-2012.)
theorem idlaut (A2 B2 I K: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq I (cfv K claut) $ >
  $ wi (wcel K A2) (wcel (cres cid B2) I) $;

--| The composition of two lattice automorphisms is a lattice automorphism. (Contributed by NM, 19-Apr-2013.)
theorem lautco (F G I K V: class):
  $ wceq I (cfv K claut) $ >
  $ wi (w3a (wcel K V) (wcel F I) (wcel G I)) (wcel (ccom F G) I) $;

--| The set of projective automorphisms. (Contributed by NM, 26-Jan-2012.) (New usage is discouraged.)
theorem pautsetN {x3 y1 f2: setvar} (B2: class x3 y1 f2) (S: class) (K: class y1) (M: class x3 y1 f2):
  $ wceq S (cfv K cpsubsp) $ >
  $ wceq M (cfv K cpautN) $ >
  $ wi (wcel K B2) (wceq M (cab f2 (wa (wf1o S S (cv f2)) (wral x3 (wral y1 (wb (wss (cv x3) (cv y1)) (wss (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)))) S) S)))) $;

--| The predicate "is a projective automorphism". (Contributed by NM, 26-Jan-2012.) (New usage is discouraged.)
theorem ispautN {x3 y1: setvar} (B2: class x3 y1) (S F: class) (K: class y1) (M: class x3 y1):
  $ wceq S (cfv K cpsubsp) $ >
  $ wceq M (cfv K cpautN) $ >
  $ wi (wcel K B2) (wb (wcel F M) (wa (wf1o S S F) (wral x3 (wral y1 (wb (wss (cv x3) (cv y1)) (wss (cfv (cv x3) F) (cfv (cv y1) F))) S) S))) $;

--| Extend class notation with set of all lattice dilations.
term cldil: class;

--| Extend class notation with set of all lattice translations.
term cltrn: class;

--| Extend class notation with set of all dilations.
term cdilN: class;

--| Extend class notation with set of all translations.
term ctrnN: class;

--| Define set of all lattice dilations. Similar to definition of dilation in [Crawley] p. 111. (Contributed by NM, 11-May-2012.)
axiom df_ldil {x3 w f2 k: setvar}:
  $ wceq cldil (cmpt k cvv (cmpt w (cfv (cv k) clh) (crab f2 (wral x3 (wi (wbr (cv x3) (cv w) (cfv (cv k) cple)) (wceq (cfv (cv x3) (cv f2)) (cv x3))) (cfv (cv k) cbs)) (cfv (cv k) claut)))) $;

--| Define set of all lattice translations. Similar to definition of translation in [Crawley] p. 111. (Contributed by NM, 11-May-2012.)
axiom df_ltrn {w f2 k q p: setvar}:
  $ wceq cltrn (cmpt k cvv (cmpt w (cfv (cv k) clh) (crab f2 (wral p (wral q (wi (wa (wn (wbr (cv p) (cv w) (cfv (cv k) cple))) (wn (wbr (cv q) (cv w) (cfv (cv k) cple)))) (wceq (co (co (cv p) (cfv (cv p) (cv f2)) (cfv (cv k) cjn)) (cv w) (cfv (cv k) cmee)) (co (co (cv q) (cfv (cv q) (cv f2)) (cfv (cv k) cjn)) (cv w) (cfv (cv k) cmee)))) (cfv (cv k) catm)) (cfv (cv k) catm)) (cfv (cv w) (cfv (cv k) cldil))))) $;

--| Define set of all dilations. Definition of dilation in [Crawley] p. 111. (Contributed by NM, 30-Jan-2012.)
axiom df_dilN {x3 f2 k d: setvar}:
  $ wceq cdilN (cmpt k cvv (cmpt d (cfv (cv k) catm) (crab f2 (wral x3 (wi (wss (cv x3) (cfv (cv d) (cfv (cv k) cwpointsN))) (wceq (cfv (cv x3) (cv f2)) (cv x3))) (cfv (cv k) cpsubsp)) (cfv (cv k) cpautN)))) $;

--| Define set of all translations. Definition of translation in [Crawley] p. 111. (Contributed by NM, 4-Feb-2012.)
axiom df_trnN {f2 k r q d: setvar}:
  $ wceq ctrnN (cmpt k cvv (cmpt d (cfv (cv k) catm) (crab f2 (wral q (wral r (wceq (cin (co (cv q) (cfv (cv q) (cv f2)) (cfv (cv k) cpadd)) (cfv (csn (cv d)) (cfv (cv k) cpolN))) (cin (co (cv r) (cfv (cv r) (cv f2)) (cfv (cv k) cpadd)) (cfv (csn (cv d)) (cfv (cv k) cpolN)))) (cfv (cv d) (cfv (cv k) cwpointsN))) (cfv (cv d) (cfv (cv k) cwpointsN))) (cfv (cv d) (cfv (cv k) cdilN))))) $;

--| The mapping from fiducial co-atom ` w ` to its set of lattice dilations. (Contributed by NM, 11-May-2012.)
theorem ldilfset {x3 w f2: setvar} (B2: class w f2) (C: class x3 w f2) (H: class x3 f2) (I: class x3 w) (K: class) (c_le: class x3 w f2):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv K claut) $ >
  $ wi (wcel K C) (wceq (cfv K cldil) (cmpt w H (crab f2 (wral x3 (wi (wbr (cv x3) (cv w) c_le) (wceq (cfv (cv x3) (cv f2)) (cv x3))) B2) I))) $;

--| The set of lattice dilations for a fiducial co-atom ` W ` . (Contributed by NM, 11-May-2012.)
theorem ldilset {x3 f2: setvar} (B2: class f2) (C D H: class x3 f2) (I: class x3) (K: class) (c_le: class x3 f2) (W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv K claut) $ >
  $ wceq D (cfv W (cfv K cldil)) $ >
  $ wi (wa (wcel K C) (wcel W H)) (wceq D (crab f2 (wral x3 (wi (wbr (cv x3) W c_le) (wceq (cfv (cv x3) (cv f2)) (cv x3))) B2) I)) $;

--| The predicate "is a lattice dilation". Similar to definition of dilation in [Crawley] p. 111. (Contributed by NM, 11-May-2012.)
theorem isldil {x3: setvar} (B2: class) (C D: class x3) (F: class) (H I: class x3) (K: class) (c_le: class x3) (W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv K claut) $ >
  $ wceq D (cfv W (cfv K cldil)) $ >
  $ wi (wa (wcel K C) (wcel W H)) (wb (wcel F D) (wa (wcel F I) (wral x3 (wi (wbr (cv x3) W c_le) (wceq (cfv (cv x3) F) (cv x3))) B2))) $;

--| A lattice dilation is an automorphism. (Contributed by NM, 20-May-2012.)
theorem ldillaut (D F H I K V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv K claut) $ >
  $ wceq D (cfv W (cfv K cldil)) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wcel F D)) (wcel F I) $;

--| A lattice dilation is a one-to-one onto function. (Contributed by NM, 19-Apr-2013.)
theorem ldil1o (B2 D F H K V W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq D (cfv W (cfv K cldil)) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wcel F D)) (wf1o B2 B2 F) $;

--| Value of a lattice dilation under its co-atom. (Contributed by NM, 20-May-2012.)
theorem ldilval (B2 D F H K c_le V W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq D (cfv W (cfv K cldil)) $ >
  $ wi (w3a (wa (wcel K V) (wcel W H)) (wcel F D) (wa (wcel X B2) (wbr X W c_le))) (wceq (cfv X F) X) $;

--| The identity function is a lattice dilation. (Contributed by NM, 18-May-2012.)
theorem idldil (A2 B2 D H K W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq D (cfv W (cfv K cldil)) $ >
  $ wi (wa (wcel K A2) (wcel W H)) (wcel (cres cid B2) D) $;

--| The converse of a lattice dilation is a lattice dilation. (Contributed by NM, 10-May-2013.)
theorem ldilcnv (D F H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq D (cfv W (cfv K cldil)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel F D)) (wcel (ccnv F) D) $;

--| The composition of two lattice automorphisms is a lattice automorphism. (Contributed by NM, 19-Apr-2013.)
theorem ldilco (D F G H K V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq D (cfv W (cfv K cldil)) $ >
  $ wi (w3a (wa (wcel K V) (wcel W H)) (wcel F D) (wcel G D)) (wcel (ccom F G) D) $;

--| The set of all lattice translations for a lattice ` K ` . (Contributed by NM, 11-May-2012.)
theorem ltrnfset {w f2 q p: setvar} (A2: class w f2) (C: class w f2 q p) (H: class f2 q p) (c_or: class w f2 q p) (K: class) (c_le c_an: class w f2 q p):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wcel K C) (wceq (cfv K cltrn) (cmpt w H (crab f2 (wral p (wral q (wi (wa (wn (wbr (cv p) (cv w) c_le)) (wn (wbr (cv q) (cv w) c_le))) (wceq (co (co (cv p) (cfv (cv p) (cv f2)) c_or) (cv w) c_an) (co (co (cv q) (cfv (cv q) (cv f2)) c_or) (cv w) c_an))) A2) A2) (cfv (cv w) (cfv K cldil))))) $;

--| The set of lattice translations for a fiducial co-atom ` W ` . (Contributed by NM, 11-May-2012.)
theorem ltrnset {f2 q p: setvar} (A2: class f2) (B2: class f2 q p) (D: class q p) (T H c_or: class f2 q p) (K: class) (c_le c_an: class f2 q p) (W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq D (cfv W (cfv K cldil)) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (wa (wcel K B2) (wcel W H)) (wceq T (crab f2 (wral p (wral q (wi (wa (wn (wbr (cv p) W c_le)) (wn (wbr (cv q) W c_le))) (wceq (co (co (cv p) (cfv (cv p) (cv f2)) c_or) W c_an) (co (co (cv q) (cfv (cv q) (cv f2)) c_or) W c_an))) A2) A2) D)) $;

--| The predicate "is a lattice translation". Similar to definition of translation in [Crawley] p. 111. (Contributed by NM, 11-May-2012.)
theorem isltrn {q p: setvar} (A2: class) (B2 D T: class q p) (F: class) (H c_or: class q p) (K: class) (c_le c_an: class q p) (W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq D (cfv W (cfv K cldil)) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (wa (wcel K B2) (wcel W H)) (wb (wcel F T) (wa (wcel F D) (wral p (wral q (wi (wa (wn (wbr (cv p) W c_le)) (wn (wbr (cv q) W c_le))) (wceq (co (co (cv p) (cfv (cv p) F) c_or) W c_an) (co (co (cv q) (cfv (cv q) F) c_or) W c_an))) A2) A2))) $;

--| The predicate "is a lattice translation". Version of ~ isltrn that considers only different ` p ` and ` q ` . TODO: Can this eliminate some separate proofs for the ` p = q ` case? (Contributed by NM, 22-Apr-2013.) (New usage is discouraged.)
theorem isltrn2N {q p: setvar} (A2: class) (B2 D T: class q p) (F: class) (H c_or: class q p) (K: class) (c_le c_an: class q p) (W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq D (cfv W (cfv K cldil)) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (wa (wcel K B2) (wcel W H)) (wb (wcel F T) (wa (wcel F D) (wral p (wral q (wi (w3a (wn (wbr (cv p) W c_le)) (wn (wbr (cv q) W c_le)) (wne (cv p) (cv q))) (wceq (co (co (cv p) (cfv (cv p) F) c_or) W c_an) (co (co (cv q) (cfv (cv q) F) c_or) W c_an))) A2) A2))) $;

--| Uniqueness property of a lattice translation value for atoms not under the fiducial co-atom ` W ` . Similar to definition of translation in [Crawley] p. 111. (Contributed by NM, 20-May-2012.)
theorem ltrnu (A2 P Q T F H c_or K c_le c_an V W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wa (wcel K V) (wcel W H)) (wcel F T)) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wceq (co (co P (cfv P F) c_or) W c_an) (co (co Q (cfv Q F) c_or) W c_an)) $;

--| A lattice translation is a lattice dilation. (Contributed by NM, 20-May-2012.)
theorem ltrnldil (D T F H K V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq D (cfv W (cfv K cldil)) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wcel F T)) (wcel F D) $;

--| A lattice translation is a lattice automorphism. (Contributed by NM, 20-May-2012.)
theorem ltrnlaut (T F H I K V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv K claut) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wcel F T)) (wcel F I) $;

--| A lattice translation is a one-to-one onto function. (Contributed by NM, 20-May-2012.)
theorem ltrn1o (B2 T F H K V W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wcel F T)) (wf1o B2 B2 F) $;

--| Closure of a lattice translation. (Contributed by NM, 20-May-2012.)
theorem ltrncl (B2 T F H K V W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K V) (wcel W H)) (wcel F T) (wcel X B2)) (wcel (cfv X F) B2) $;

--| One-to-one property of a lattice translation. (Contributed by NM, 20-May-2012.)
theorem ltrn11 (B2 T F H K V W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K V) (wcel W H)) (wcel F T) (wa (wcel X B2) (wcel Y B2))) (wb (wceq (cfv X F) (cfv Y F)) (wceq X Y)) $;

--| If a translation is different from the identity, so is its converse. (Contributed by NM, 17-Jun-2013.)
theorem ltrncnvnid (B2 T F H K W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wne F (cres cid B2))) (wne (ccnv F) (cres cid B2)) $;

--| Two translations are equal if the composition of one with the converse of the other is the zero translation. This is an analogue of vector subtraction. (Contributed by NM, 7-Apr-2014.) (New usage is discouraged.)
theorem ltrncoidN (B2 T F G H K W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wcel G T)) (wb (wceq (ccom F (ccnv G)) (cres cid B2)) (wceq F G)) $;

--| Less-than or equal property of a lattice translation. (Contributed by NM, 20-May-2012.)
theorem ltrnle (B2 T F H K c_le V W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K V) (wcel W H)) (wcel F T) (wa (wcel X B2) (wcel Y B2))) (wb (wbr X Y c_le) (wbr (cfv X F) (cfv Y F) c_le)) $;

--| Less-than or equal property of lattice translation converse. (Contributed by NM, 10-May-2013.) (New usage is discouraged.)
theorem ltrncnvleN (B2 T F H K c_le V W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K V) (wcel W H)) (wcel F T) (wa (wcel X B2) (wcel Y B2))) (wb (wbr X Y c_le) (wbr (cfv X (ccnv F)) (cfv Y (ccnv F)) c_le)) $;

--| Lattice translation of a meet. (Contributed by NM, 20-May-2012.)
theorem ltrnm (B2 T F H K c_an W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wa (wcel X B2) (wcel Y B2))) (wceq (cfv (co X Y c_an) F) (co (cfv X F) (cfv Y F) c_an)) $;

--| Lattice translation of a meet. TODO: change antecedent to ` K e. HL ` (Contributed by NM, 25-May-2012.)
theorem ltrnj (B2 T F H c_or K W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wa (wcel X B2) (wcel Y B2))) (wceq (cfv (co X Y c_or) F) (co (cfv X F) (cfv Y F) c_or)) $;

--| Covering property of a lattice translation. (Contributed by NM, 20-May-2012.)
theorem ltrncvr (B2 C T F H K V W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K V) (wcel W H)) (wcel F T) (wa (wcel X B2) (wcel Y B2))) (wb (wbr X Y C) (wbr (cfv X F) (cfv Y F) C)) $;

--| Value of a lattice translation under its co-atom. (Contributed by NM, 20-May-2012.)
theorem ltrnval1 (B2 T F H K c_le V W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K V) (wcel W H)) (wcel F T) (wa (wcel X B2) (wbr X W c_le))) (wceq (cfv X F) X) $;

--| A lattice translation is the identity function iff all atoms not under the fiducial co-atom ` W ` are equal to their values. (Contributed by NM, 24-May-2012.)
theorem ltrnid {p: setvar} (A2 B2 T F H K: class) (c_le: class p) (W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel F T)) (wb (wral p (wi (wn (wbr (cv p) W c_le)) (wceq (cfv (cv p) F) (cv p))) A2) (wceq F (cres cid B2))) $;

--| If a lattice translation is not the identity, then there is an atom not under the fiducial co-atom ` W ` and not equal to its translation. (Contributed by NM, 24-May-2012.)
theorem ltrnnid {p: setvar} (A2 B2 T F H K: class) (c_le: class p) (W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wne F (cres cid B2))) (wrex p (wa (wn (wbr (cv p) W c_le)) (wne (cfv (cv p) F) (cv p))) A2) $;

--| The lattice translation of an atom is an atom. (Contributed by NM, 20-May-2012.)
theorem ltrnatb (A2 B2 P T F H K W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wcel P B2)) (wb (wcel P A2) (wcel (cfv P F) A2)) $;

--| The converse of the lattice translation of an atom is an atom. (Contributed by NM, 2-Jun-2012.)
theorem ltrncnvatb (A2 B2 P T F H K W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wcel P B2)) (wb (wcel P A2) (wcel (cfv P (ccnv F)) A2)) $;

--| The lattice translation of an atom not under the fiducial co-atom is also an atom not under the fiducial co-atom. Remark below Lemma B in [Crawley] p. 112. (Contributed by NM, 22-May-2012.)
theorem ltrnel (A2 P T F H K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wa (wcel P A2) (wn (wbr P W c_le)))) (wa (wcel (cfv P F) A2) (wn (wbr (cfv P F) W c_le))) $;

--| The lattice translation of an atom is also an atom. TODO: See if this can shorten some ~ ltrnel uses. (Contributed by NM, 25-May-2012.)
theorem ltrnat (A2 P T F H K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wcel P A2)) (wcel (cfv P F) A2) $;

--| The converse of the lattice translation of an atom is an atom. (Contributed by NM, 9-May-2013.)
theorem ltrncnvat (A2 P T F H K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wcel P A2)) (wcel (cfv P (ccnv F)) A2) $;

--| The converse of the lattice translation of an atom not under the fiducial co-atom. (Contributed by NM, 10-May-2013.)
theorem ltrncnvel (A2 P T F H K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wa (wcel P A2) (wn (wbr P W c_le)))) (wa (wcel (cfv P (ccnv F)) A2) (wn (wbr (cfv P (ccnv F)) W c_le))) $;

--| Composition of lattice translations of an atom. TODO: See if this can shorten some ~ ltrnel uses. (Contributed by NM, 1-May-2013.) (New usage is discouraged.)
theorem ltrncoelN (A2 P T F G H K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel F T) (wcel G T)) (wa (wcel P A2) (wn (wbr P W c_le)))) (wa (wcel (cfv (cfv P G) F) A2) (wn (wbr (cfv (cfv P G) F) W c_le))) $;

--| Composition of lattice translations of an atom. TODO: See if this can shorten some ~ ltrnel , ~ ltrnat uses. (Contributed by NM, 1-May-2013.)
theorem ltrncoat (A2 P T F G H K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel F T) (wcel G T)) (wcel P A2)) (wcel (cfv (cfv P G) F) A2) $;

--| Two ways to express value of translation composition. (Contributed by NM, 31-May-2013.)
theorem ltrncoval (A2 P T F G H K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel F T) (wcel G T)) (wcel P A2)) (wceq (cfv P (ccom F G)) (cfv (cfv P G) F)) $;

--| The converse of a lattice translation is a lattice translation. (Contributed by NM, 10-May-2013.)
theorem ltrncnv (T F H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel F T)) (wcel (ccnv F) T) $;

--| Frequently used one-to-one property of lattice translation atoms. (Contributed by NM, 5-May-2013.)
theorem ltrn11at (A2 P Q T F H K W: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (w3a (wcel P A2) (wcel Q A2) (wne P Q))) (wne (cfv P F) (cfv Q F)) $;

--| The equality of two translations is determined by their equality at atoms. (Contributed by NM, 2-Mar-2014.)
theorem ltrneq2 {p: setvar} (A2: class) (T: class p) (F G: class) (H K W: class p):
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wcel G T)) (wb (wral p (wceq (cfv (cv p) F) (cfv (cv p) G)) A2) (wceq F G)) $;

--| The equality of two translations is determined by their equality at atoms not under co-atom ` W ` . (Contributed by NM, 20-Jun-2013.)
theorem ltrneq {p: setvar} (A2 T F G H K: class) (c_le: class p) (W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wcel G T)) (wb (wral p (wi (wn (wbr (cv p) W c_le)) (wceq (cfv (cv p) F) (cfv (cv p) G))) A2) (wceq F G)) $;

--| The identity function is a lattice translation. Remark below Lemma B in [Crawley] p. 112. (Contributed by NM, 18-May-2012.)
theorem idltrn (B2 T H K W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wcel (cres cid B2) T) $;

--| Property of lattice translation value. Remark below Lemma B in [Crawley] p. 112. TODO: Can this be used in more places? (Contributed by NM, 20-May-2012.) (Proof shortened by OpenAI, 25-Mar-2020.)
theorem ltrnmw (A2 P T F H K c_le c_an W c_0: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wa (wcel P A2) (wn (wbr P W c_le)))) (wceq (co (cfv P F) W c_an) c_0) $;

--| The mapping from fiducial atom to set of dilations. (Contributed by NM, 30-Jan-2012.) (New usage is discouraged.)
theorem dilfsetN {x3 f2 d: setvar} (A2: class x3 f2) (B2: class x3 f2 d) (S: class f2 d) (K: class) (L: class x3 f2 d) (M: class x3 d) (W: class x3 f2 d):
  $ wceq A2 (cfv K catm) $ >
  $ wceq S (cfv K cpsubsp) $ >
  $ wceq W (cfv K cwpointsN) $ >
  $ wceq M (cfv K cpautN) $ >
  $ wceq L (cfv K cdilN) $ >
  $ wi (wcel K B2) (wceq L (cmpt d A2 (crab f2 (wral x3 (wi (wss (cv x3) (cfv (cv d) W)) (wceq (cfv (cv x3) (cv f2)) (cv x3))) S) M))) $;

--| The set of dilations for a fiducial atom ` D ` . (Contributed by NM, 4-Feb-2012.) (New usage is discouraged.)
theorem dilsetN {x3 f2: setvar} (A2 B2: class x3 f2) (D: class) (S: class f2) (K: class) (L: class x3 f2) (M: class x3) (W: class x3 f2):
  $ wceq A2 (cfv K catm) $ >
  $ wceq S (cfv K cpsubsp) $ >
  $ wceq W (cfv K cwpointsN) $ >
  $ wceq M (cfv K cpautN) $ >
  $ wceq L (cfv K cdilN) $ >
  $ wi (wa (wcel K B2) (wcel D A2)) (wceq (cfv D L) (crab f2 (wral x3 (wi (wss (cv x3) (cfv D W)) (wceq (cfv (cv x3) (cv f2)) (cv x3))) S) M)) $;

--| The predicate "is a dilation". (Contributed by NM, 4-Feb-2012.) (New usage is discouraged.)
theorem isdilN {x3: setvar} (A2 B2: class x3) (D S F K: class) (L M W: class x3):
  $ wceq A2 (cfv K catm) $ >
  $ wceq S (cfv K cpsubsp) $ >
  $ wceq W (cfv K cwpointsN) $ >
  $ wceq M (cfv K cpautN) $ >
  $ wceq L (cfv K cdilN) $ >
  $ wi (wa (wcel K B2) (wcel D A2)) (wb (wcel F (cfv D L)) (wa (wcel F M) (wral x3 (wi (wss (cv x3) (cfv D W)) (wceq (cfv (cv x3) F) (cv x3))) S))) $;

--| The mapping from fiducial atom to set of translations. (Contributed by NM, 4-Feb-2012.) (New usage is discouraged.)
theorem trnfsetN {f2 r q d: setvar} (A2: class f2 r q) (C c_pl S T: class f2 r q d) (K: class) (L: class r q d) (M c_pe: class f2 r q d) (W: class f2 d):
  $ wceq A2 (cfv K catm) $ >
  $ wceq S (cfv K cpsubsp) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wceq W (cfv K cwpointsN) $ >
  $ wceq M (cfv K cpautN) $ >
  $ wceq L (cfv K cdilN) $ >
  $ wceq T (cfv K ctrnN) $ >
  $ wi (wcel K C) (wceq T (cmpt d A2 (crab f2 (wral q (wral r (wceq (cin (co (cv q) (cfv (cv q) (cv f2)) c_pl) (cfv (csn (cv d)) c_pe)) (cin (co (cv r) (cfv (cv r) (cv f2)) c_pl) (cfv (csn (cv d)) c_pe))) (cfv (cv d) W)) (cfv (cv d) W)) (cfv (cv d) L)))) $;

--| The set of translations for a fiducial atom ` D ` . (Contributed by NM, 4-Feb-2012.) (New usage is discouraged.)
theorem trnsetN {f2 r q: setvar} (A2 B2: class f2 r q) (D: class) (c_pl S T: class f2 r q) (K: class) (L: class r q) (M c_pe: class f2 r q) (W: class f2):
  $ wceq A2 (cfv K catm) $ >
  $ wceq S (cfv K cpsubsp) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wceq W (cfv K cwpointsN) $ >
  $ wceq M (cfv K cpautN) $ >
  $ wceq L (cfv K cdilN) $ >
  $ wceq T (cfv K ctrnN) $ >
  $ wi (wa (wcel K B2) (wcel D A2)) (wceq (cfv D T) (crab f2 (wral q (wral r (wceq (cin (co (cv q) (cfv (cv q) (cv f2)) c_pl) (cfv (csn D) c_pe)) (cin (co (cv r) (cfv (cv r) (cv f2)) c_pl) (cfv (csn D) c_pe))) (cfv D W)) (cfv D W)) (cfv D L))) $;

--| The predicate "is a translation". (Contributed by NM, 4-Feb-2012.) (New usage is discouraged.)
theorem istrnN {r q: setvar} (A2 B2: class r q) (D: class) (c_pl S T: class r q) (F K: class) (L M c_pe: class r q) (W: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq S (cfv K cpsubsp) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wceq W (cfv K cwpointsN) $ >
  $ wceq M (cfv K cpautN) $ >
  $ wceq L (cfv K cdilN) $ >
  $ wceq T (cfv K ctrnN) $ >
  $ wi (wa (wcel K B2) (wcel D A2)) (wb (wcel F (cfv D T)) (wa (wcel F (cfv D L)) (wral q (wral r (wceq (cin (co (cv q) (cfv (cv q) F) c_pl) (cfv (csn D) c_pe)) (cin (co (cv r) (cfv (cv r) F) c_pl) (cfv (csn D) c_pe))) (cfv D W)) (cfv D W)))) $;

--| Extend class notation with set of all traces of lattice translations.
term ctrl: class;

--| Define trace of a lattice translation. (Contributed by NM, 20-May-2012.)
axiom df_trl {x3 w f2 k p: setvar}:
  $ wceq ctrl (cmpt k cvv (cmpt w (cfv (cv k) clh) (cmpt f2 (cfv (cv w) (cfv (cv k) cltrn)) (crio x3 (wral p (wi (wn (wbr (cv p) (cv w) (cfv (cv k) cple))) (wceq (cv x3) (co (co (cv p) (cfv (cv p) (cv f2)) (cfv (cv k) cjn)) (cv w) (cfv (cv k) cmee)))) (cfv (cv k) catm)) (cfv (cv k) cbs))))) $;

--| The set of all traces of lattice translations for a lattice ` K ` . (Contributed by NM, 20-May-2012.)
theorem trlfset {x3 w f2 p: setvar} (A2: class x3 w f2) (B2: class w f2 p) (C: class x3 w f2 p) (H: class x3 f2 p) (c_or: class x3 w f2 p) (K: class) (c_le c_an: class x3 w f2 p):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wcel K C) (wceq (cfv K ctrl) (cmpt w H (cmpt f2 (cfv (cv w) (cfv K cltrn)) (crio x3 (wral p (wi (wn (wbr (cv p) (cv w) c_le)) (wceq (cv x3) (co (co (cv p) (cfv (cv p) (cv f2)) c_or) (cv w) c_an))) A2) B2)))) $;

--| The set of traces of lattice translations for a fiducial co-atom ` W ` . (Contributed by NM, 20-May-2012.)
theorem trlset {x3 f2 p: setvar} (A2: class x3 f2) (B2: class f2 p) (C R: class x3 f2 p) (T: class x3 p) (H c_or: class x3 f2 p) (K: class) (c_le c_an: class x3 f2 p) (W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (wa (wcel K C) (wcel W H)) (wceq R (cmpt f2 T (crio x3 (wral p (wi (wn (wbr (cv p) W c_le)) (wceq (cv x3) (co (co (cv p) (cfv (cv p) (cv f2)) c_or) W c_an))) A2) B2))) $;

--| The value of the trace of a lattice translation. (Contributed by NM, 20-May-2012.)
theorem trlval {x3 p: setvar} (A2: class x3) (B2: class p) (R T: class x3 p) (F: class) (H c_or: class x3 p) (K: class) (c_le c_an V: class x3 p) (W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wcel F T)) (wceq (cfv F R) (crio x3 (wral p (wi (wn (wbr (cv p) W c_le)) (wceq (cv x3) (co (co (cv p) (cfv (cv p) F) c_or) W c_an))) A2) B2)) $;

--| The value of the trace of a lattice translation, given any atom ` P ` not under the fiducial co-atom ` W ` . Note: this requires only the weaker assumption ` K e. Lat ` ; we use ` K e. HL ` for convenience. (Contributed by NM, 20-May-2012.)
theorem trlval2 (A2 P R T F H c_or K c_le c_an W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wa (wcel P A2) (wn (wbr P W c_le)))) (wceq (cfv F R) (co (co P (cfv P F) c_or) W c_an)) $;

--| Closure of the trace of a lattice translation. (Contributed by NM, 22-May-2012.)
theorem trlcl (B2 R T F H K W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel F T)) (wcel (cfv F R) B2) $;

--| The trace of the converse of a lattice translation. (Contributed by NM, 10-May-2013.)
theorem trlcnv (R T F H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel F T)) (wceq (cfv (ccnv F) R) (cfv F R)) $;

--| The value of a translation of an atom ` P ` not under the fiducial co-atom ` W ` , joined with trace. Equation above Lemma C in [Crawley] p. 112. TODO: shorten with ~ atmod3i1 ? (Contributed by NM, 22-May-2012.)
theorem trljat1 (A2 P R T F H c_or K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wa (wcel P A2) (wn (wbr P W c_le)))) (wceq (co P (cfv F R) c_or) (co P (cfv P F) c_or)) $;

--| The value of a translation of an atom ` P ` not under the fiducial co-atom ` W ` , joined with trace. Equation above Lemma C in [Crawley] p. 112. (Contributed by NM, 25-May-2012.)
theorem trljat2 (A2 P R T F H c_or K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wa (wcel P A2) (wn (wbr P W c_le)))) (wceq (co (cfv P F) (cfv F R) c_or) (co P (cfv P F) c_or)) $;

--| The value of a translation of an atom ` P ` not under the fiducial co-atom ` W ` , joined with trace. Equation above Lemma C in [Crawley] p. 112. (Contributed by NM, 22-May-2012.)
theorem trljat3 (A2 P R T F H c_or K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wa (wcel P A2) (wn (wbr P W c_le)))) (wceq (co P (cfv F R) c_or) (co (cfv P F) (cfv F R) c_or)) $;

--| If an atom differs from its translation, the trace is an atom. Equation above Lemma C in [Crawley] p. 112. (Contributed by NM, 23-May-2012.)
theorem trlat (A2 P R T F H K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel F T) (wne (cfv P F) P))) (wcel (cfv F R) A2) $;

--| If an atom not under the fiducial co-atom ` W ` equals its lattice translation, the trace of the translation is zero. (Contributed by NM, 24-May-2012.)
theorem trl0 (A2 P R T F H K c_le W c_0: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel F T) (wceq (cfv P F) P))) (wceq (cfv F R) c_0) $;

--| The trace of a lattice translation is an atom or zero. (Contributed by NM, 5-May-2013.)
theorem trlator0 (A2 R T F H K W c_0: class):
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel F T)) (wo (wcel (cfv F R) A2) (wceq (cfv F R) c_0)) $;

--| The trace of a lattice translation is an atom iff it is nonzero. (Contributed by NM, 14-Jun-2013.)
theorem trlatn0 (A2 R T F H K W c_0: class):
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel F T)) (wb (wcel (cfv F R) A2) (wne (cfv F R) c_0)) $;

--| The trace of a lattice translation other than the identity is an atom. Remark above Lemma C in [Crawley] p. 112. (Contributed by NM, 23-May-2012.)
theorem trlnidat (A2 B2 R T F H K W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wne F (cres cid B2))) (wcel (cfv F R) A2) $;

--| If a lattice translation is not the identity, then the translation of any atom not under the fiducial co-atom ` W ` is different from the atom. Remark above Lemma C in [Crawley] p. 112. (Contributed by NM, 24-May-2012.)
theorem ltrnnidn (A2 B2 P T F H K c_le W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel F T) (wne F (cres cid B2))) (wa (wcel P A2) (wn (wbr P W c_le)))) (wne (cfv P F) P) $;

--| Property of the identity lattice translation. (Contributed by NM, 27-May-2012.)
theorem ltrnideq (A2 B2 P T F H K c_le W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wa (wcel P A2) (wn (wbr P W c_le)))) (wb (wceq F (cres cid B2)) (wceq (cfv P F) P)) $;

--| The trace of the identity translation is zero. (Contributed by NM, 11-Jun-2013.)
theorem trlid0 (B2 R H K W c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wceq (cfv (cres cid B2) R) c_0) $;

--| A lattice translation is not the identity iff its trace is an atom. TODO: Can proofs be reorganized so this goes with ~ trlnidat ? Why do both this and ~ ltrnideq need ~ trlnidat ? (Contributed by NM, 4-Jun-2013.)
theorem trlnidatb (A2 B2 R T F H K W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel F T)) (wb (wne F (cres cid B2)) (wcel (cfv F R) A2)) $;

--| A lattice translation is the identity iff its trace is zero. (Contributed by NM, 14-Jun-2013.)
theorem trlid0b (B2 R T F H K W c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel F T)) (wb (wceq F (cres cid B2)) (wceq (cfv F R) c_0)) $;

--| Different translations with the same trace cannot be the identity. (Contributed by NM, 26-Jul-2013.)
theorem trlnid (B2 R T F G H K W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel F T) (wcel G T)) (wa (wne F G) (wceq (cfv F R) (cfv G R)))) (wne F (cres cid B2)) $;

--| Property of the equality of a lattice translation with its value. (Contributed by NM, 27-May-2012.)
theorem ltrn2ateq (A2 P Q T F H K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (w3a (wcel F T) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le))))) (wb (wceq (cfv P F) P) (wceq (cfv Q F) Q)) $;

--| If any atom (under ` W ` ) is not equal to its translation, so is any other atom. (Contributed by NM, 6-May-2013.)
theorem ltrnateq (A2 P Q T F H K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (w3a (wcel F T) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wceq (cfv P F) P)) (wceq (cfv Q F) Q) $;

--| If any atom (under ` W ` ) is not equal to its translation, so is any other atom. TODO: ` -. P .<_ W ` isn't needed to prove this. Will removing it shorten (and not lengthen) proofs using it? (Contributed by NM, 6-May-2013.)
theorem ltrnatneq (A2 P Q T F H K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (w3a (wcel F T) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wne (cfv P F) P)) (wne (cfv Q F) Q) $;

--| If the value of an atom equals the atom in a non-identity translation, the atom is under the fiducial hyperplane. (Contributed by NM, 15-May-2013.)
theorem ltrnatlw (A2 P Q T F H K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (w3a (wcel F T) (wa (wcel P A2) (wn (wbr P W c_le))) (wcel Q A2)) (wa (wne (cfv P F) P) (wceq (cfv Q F) Q))) (wbr Q W c_le) $;

--| The trace of a lattice translation is less than the fiducial co-atom ` W ` . (Contributed by NM, 25-May-2012.)
theorem trlle (R T F H K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel F T)) (wbr (cfv F R) W c_le) $;

--| The trace of a lattice translation is not equal to any atom not under the fiducial co-atom ` W ` . Part of proof of Lemma C in [Crawley] p. 112. (Contributed by NM, 25-May-2012.)
theorem trlne (A2 P R T F H K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wa (wcel P A2) (wn (wbr P W c_le)))) (wne P (cfv F R)) $;

--| The atom not under the fiducial co-atom ` W ` is not less than the trace of a lattice translation. Part of proof of Lemma C in [Crawley] p. 112. (Contributed by NM, 26-May-2012.)
theorem trlnle (A2 P R T F H K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wa (wcel P A2) (wn (wbr P W c_le)))) (wn (wbr P (cfv F R) c_le)) $;

--| The value of the trace of a lattice translation in terms of 2 atoms. TODO: Try to shorten proof. (Contributed by NM, 3-May-2013.)
theorem trlval3 (A2 P Q R T F H c_or K c_le c_an W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (w3a (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le))) (wne (co P (cfv P F) c_or) (co Q (cfv Q F) c_or)))) (wceq (cfv F R) (co (co P (cfv P F) c_or) (co Q (cfv Q F) c_or) c_an)) $;

--| The value of the trace of a lattice translation in terms of 2 atoms. (Contributed by NM, 3-May-2013.)
theorem trlval4 (A2 P Q R T F H c_or K c_le c_an W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (w3a (wcel F T) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wa (wne P Q) (wn (wbr (cfv F R) (co P Q c_or) c_le)))) (wceq (cfv F R) (co (co P (cfv P F) c_or) (co Q (cfv Q F) c_or) c_an)) $;

--| The value of the trace of a lattice translation in terms of itself. (Contributed by NM, 19-Jul-2013.)
theorem trlval5 (A2 P R T F H c_or K c_le c_an W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wa (wcel P A2) (wn (wbr P W c_le)))) (wceq (cfv F R) (co (co P (cfv F R) c_or) W c_an)) $;

--| Lemma for Desargues's law. Theorem 13.3 of [Crawley] p. 110, third and fourth lines from bottom. In these lemmas, ` P ` , ` Q ` , ` R ` , ` S ` , ` T ` , ` U ` , ` C ` , ` D ` , ` E ` , ` F ` , and ` G ` represent Crawley's a_0, a_1, a_2, b_0, b_1, b_2, c, z_0, z_1, z_2, and p respectively. (Contributed by NM, 28-Jun-2012.) (New usage is discouraged.)
theorem arglem1N (A2 P Q S T F G c_or K c_an: class):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq F (co (co P Q c_or) (co S T c_or) c_an) $ >
  $ wceq G (co (co P S c_or) (co Q T c_or) c_an) $ >
  $ wi (wa (w3a (w3a (wcel K chlt) (wcel P A2) (wcel Q A2)) (w3a (wcel S A2) (wcel T A2) (wne P Q)) (w3a (wne P S) (wne Q T) (wne S T))) (wcel G A2)) (wcel F A2) $;

--| Part of proof of Lemma C in [Crawley] p. 112. TODO: shorten with ~ atmod3i1 ? (Contributed by NM, 29-May-2012.)
theorem cdlemc1 (A2 B2 P H c_or K c_le c_an W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel X B2) (wa (wcel P A2) (wn (wbr P W c_le)))) (wceq (co P (co (co P X c_or) W c_an) c_or) (co P X c_or)) $;

--| Part of proof of Lemma C in [Crawley] p. 112. (Contributed by NM, 25-May-2012.)
theorem cdlemc2 (A2 P Q T F H c_or K c_le c_an W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wa (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le))))) (wbr (cfv Q F) (co (cfv P F) (co (co P Q c_or) W c_an) c_or) c_le) $;

--| Part of proof of Lemma C in [Crawley] p. 113. (Contributed by NM, 26-May-2012.)
theorem cdlemc3 (A2 P Q R T F H c_or K c_le c_an W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (w3a (wcel F T) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le))))) (wi (wbr (cfv P F) (co Q (cfv F R) c_or) c_le) (wbr Q (co P (cfv P F) c_or) c_le)) $;

--| Part of proof of Lemma C in [Crawley] p. 113. (Contributed by NM, 26-May-2012.)
theorem cdlemc4 (A2 P Q R T F H c_or K c_le c_an W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (w3a (wcel F T) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wn (wbr Q (co P (cfv P F) c_or) c_le))) (wne (co Q (cfv F R) c_or) (co (cfv P F) (co (co P Q c_or) W c_an) c_or)) $;

--| Lemma for ~ cdlemc . (Contributed by NM, 26-May-2012.)
theorem cdlemc5 (A2 P Q R T F H c_or K c_le c_an W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (w3a (wcel F T) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wa (wn (wbr Q (co P (cfv P F) c_or) c_le)) (wne (cfv P F) P))) (wceq (cfv Q F) (co (co Q (cfv F R) c_or) (co (cfv P F) (co (co P Q c_or) W c_an) c_or) c_an)) $;

--| Lemma for ~ cdlemc . (Contributed by NM, 26-May-2012.)
theorem cdlemc6 (A2 P Q R T F H c_or K c_le c_an W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >

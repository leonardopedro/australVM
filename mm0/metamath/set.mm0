  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (w3a (wcel U E) (wcel V E) (wcel (cv f2) T)) (w3a (wne (cv f2) (cres cid B2)) (wne (cfv (cv f2) U) (cres cid B2)) (wne (cfv (cv f2) V) (cres cid B2)))) (wrex s1 (wceq (cfv (cfv (cv f2) U) (cv s1)) (cfv (cv f2) V)) E) $;


  $ wceq R (cfv U csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq S (cfv W (cfv K chdma)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel C (cfv (csn E) O)) $ >
  $ wi ph (wceq (cfv E (cfv C S)) c_0) $;

--| Line 30 in [Baer] p. 110, f(sw + u, tw - v) = 0. (Contributed by NM, 12-Jun-2015.)
theorem hdmapinvlem3 (ph: wff) (B2 C D c_pl R S c_x c_xp U E G H I J K c_mi O V W c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq E (cop (cres cid (cfv K cbs)) (cres cid (cfv W (cfv K cltrn)))) $ >
  $ wceq O (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq S (cfv W (cfv K chdma)) $ >
  $ wceq G (cfv W (cfv K chg)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel C (cfv (csn E) O)) $ >
  $ wi ph (wcel D (cfv (csn E) O)) $ >
  $ wi ph (wcel I B2) $ >
  $ wi ph (wcel J B2) $ >
  $ wi ph (wceq (co I (cfv J G) c_xp) (cfv C (cfv D S))) $ >
  $ wi ph (wceq (cfv (co (co I E c_x) C c_pl) (cfv (co (co J E c_x) D c_mi) S)) c_0) $;

--| Part 1.1 of Proposition 1 of [Baer] p. 110. We use ` C ` , ` D ` , ` I ` , and ` J ` for Baer's u, v, s, and t. Our unit vector ` E ` has the required properties for his w by ~ hdmapevec2 . Our ` ( ( S `` D ) `` C ) ` means his f(u,v) (note argument reversal). (Contributed by NM, 12-Jun-2015.)
theorem hdmapinvlem4 (ph: wff) (B2 C D c_pl R S c_x c_xp U E G H I J K c_mi O V W c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq E (cop (cres cid (cfv K cbs)) (cres cid (cfv W (cfv K cltrn)))) $ >
  $ wceq O (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq S (cfv W (cfv K chdma)) $ >
  $ wceq G (cfv W (cfv K chg)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel C (cfv (csn E) O)) $ >
  $ wi ph (wcel D (cfv (csn E) O)) $ >
  $ wi ph (wcel I B2) $ >
  $ wi ph (wcel J B2) $ >
  $ wi ph (wceq (co I (cfv J G) c_xp) (cfv C (cfv D S))) $ >
  $ wi ph (wceq (co J (cfv I G) c_xp) (cfv D (cfv C S))) $;

--| Part 1.2 in [Baer] p. 110 line 34, f(u,v) alpha = f(v,u). (Contributed by NM, 12-Jun-2015.)
theorem hdmapglem5 (ph: wff) (B2 C D c_pl R S c_x c_xp U E G H I J K c_mi O V W c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq E (cop (cres cid (cfv K cbs)) (cres cid (cfv W (cfv K cltrn)))) $ >
  $ wceq O (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >

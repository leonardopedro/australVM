  $ wi ph (wceq (cfv T c2nd) N) $ >
  $ wi ph (wceq F (cmpt y1 (co cc0 (co N c1 cmin) cfz) (co (cmpt n (co c1 N cfz) (co (cfv (cv n) (cfv (cfv T c1st) c1st)) (cif (wceq (cv n) (cfv N (cfv (cfv T c1st) c2nd))) c1 cc0) cmin)) (cun (cxp (cima (ccom (cfv (cfv T c1st) c2nd) (cmpt n (co c1 N cfz) (cif (wceq (cv n) c1) N (co (cv n) c1 cmin)))) (co c1 (co (cv y1) c1 caddc) cfz)) (csn c1)) (cxp (cima (ccom (cfv (cfv T c1st) c2nd) (cmpt n (co c1 N cfz) (cif (wceq (cv n) c1) N (co (cv n) c1 cmin)))) (co (co (co (cv y1) c1 caddc) c1 caddc) N cfz)) (csn cc0))) (cof caddc)))) $;

--| Lemma for ~ poimir establishing existence for ~ poimirlem21 . (Contributed by Brendan Leahy, 21-Aug-2020.)

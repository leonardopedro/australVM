--| Lemma for ~ 4at . Combine all four possible cases. (Contributed by NM, 11-Jul-2012.)
theorem _4atlem12 (A2 P Q R S T U c_or K c_le V W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (w3a (w3a (wcel K chlt) (wcel P A2) (wcel Q A2)) (w3a (wcel R A2) (wcel S A2) (wcel T A2)) (w3a (wcel U A2) (wcel V A2) (wcel W A2))) (w3a (wne P Q) (wn (wbr R (co P Q c_or) c_le)) (wn (wbr S (co (co P Q c_or) R c_or) c_le)))) (wi (wbr (co (co P Q c_or) (co R S c_or) c_or) (co (co T U c_or) (co V W c_or) c_or) c_le) (wceq (co (co P Q c_or) (co R S c_or) c_or) (co (co T U c_or) (co V W c_or) c_or))) $;

--| Four atoms determine a lattice volume uniquely. Three-dimensional analogue of ~ ps-1 and ~ 3at . (Contributed by NM, 11-Jul-2012.)
theorem _4at (A2 P Q R S T U c_or K c_le V W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (w3a (w3a (wcel K chlt) (wcel P A2) (wcel Q A2)) (w3a (wcel R A2) (wcel S A2) (wcel T A2)) (w3a (wcel U A2) (wcel V A2) (wcel W A2))) (w3a (wne P Q) (wn (wbr R (co P Q c_or) c_le)) (wn (wbr S (co (co P Q c_or) R c_or) c_le)))) (wb (wbr (co (co P Q c_or) (co R S c_or) c_or) (co (co T U c_or) (co V W c_or) c_or) c_le) (wceq (co (co P Q c_or) (co R S c_or) c_or) (co (co T U c_or) (co V W c_or) c_or))) $;

--| Four atoms determine a lattice volume uniquely. (Contributed by NM, 11-Jul-2012.)
theorem _4at2 (A2 P Q R S T U c_or K c_le V W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (w3a (w3a (wcel K chlt) (wcel P A2) (wcel Q A2)) (w3a (wcel R A2) (wcel S A2) (wcel T A2)) (w3a (wcel U A2) (wcel V A2) (wcel W A2))) (w3a (wne P Q) (wn (wbr R (co P Q c_or) c_le)) (wn (wbr S (co (co P Q c_or) R c_or) c_le)))) (wb (wbr (co (co (co P Q c_or) R c_or) S c_or) (co (co (co T U c_or) V c_or) W c_or) c_le) (wceq (co (co (co P Q c_or) R c_or) S c_or) (co (co (co T U c_or) V c_or) W c_or))) $;

--| A lattice line under a lattice plane is covered by it. (Contributed by NM, 12-Jul-2012.)
theorem lplncvrlvol2 (C P K c_le V X Y: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq P (cfv K clpl) $ >
  $ wceq V (cfv K clvol) $ >
  $ wi (wa (w3a (wcel K chlt) (wcel X P) (wcel Y V)) (wbr X Y c_le)) (wbr X Y C) $;

--| An element covering a lattice plane is a lattice volume and vice-versa. (Contributed by NM, 15-Jul-2012.)
theorem lplncvrlvol (B2 C P K V X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq P (cfv K clpl) $ >
  $ wceq V (cfv K clvol) $ >
  $ wi (wa (w3a (wcel K chlt) (wcel X B2) (wcel Y B2)) (wbr X Y C)) (wb (wcel X P) (wcel Y V)) $;

--| If two lattice planes are comparable, they are equal. (Contributed by NM, 12-Jul-2012.)
theorem lvolcmp (K c_le V X Y: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq V (cfv K clvol) $ >
  $ wi (w3a (wcel K chlt) (wcel X V) (wcel Y V)) (wb (wbr X Y c_le) (wceq X Y)) $;

--| Two lattice volumes cannot satisfy the less than relation. (Contributed by NM, 12-Jul-2012.) (New usage is discouraged.)
theorem lvolnltN (c_lt K V X Y: class):
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq V (cfv K clvol) $ >
  $ wi (w3a (wcel K chlt) (wcel X V) (wcel Y V)) (wn (wbr X Y c_lt)) $;

--| The join of two different lattice planes in a lattice volume equals the volume (version of ~ 2lplnj in terms of atoms). (Contributed by NM, 12-Jul-2012.)
theorem _2lplnja (A2 P Q R S T U c_or K c_le V W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq V (cfv K clvol) $ >
  $ wi (w3a (w3a (wa (wcel K chlt) (wcel W V)) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wa (wne P Q) (wn (wbr R (co P Q c_or) c_le)))) (wa (w3a (wcel S A2) (wcel T A2) (wcel U A2)) (wa (wne S T) (wn (wbr U (co S T c_or) c_le)))) (w3a (wbr (co (co P Q c_or) R c_or) W c_le) (wbr (co (co S T c_or) U c_or) W c_le) (wne (co (co P Q c_or) R c_or) (co (co S T c_or) U c_or)))) (wceq (co (co (co P Q c_or) R c_or) (co (co S T c_or) U c_or) c_or) W) $;

--| The join of two different lattice planes in a (3-dimensional) lattice volume equals the volume. (Contributed by NM, 12-Jul-2012.)
theorem _2lplnj (P c_or K c_le V W X Y: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq P (cfv K clpl) $ >
  $ wceq V (cfv K clvol) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel X P) (wcel Y P) (wcel W V)) (w3a (wbr X W c_le) (wbr Y W c_le) (wne X Y))) (wceq (co X Y c_or) W) $;

--| The meet of two different lattice planes in a lattice volume is a lattice line. (Contributed by NM, 12-Jul-2012.) (New usage is discouraged.)
theorem _2lplnm2N (P K c_le c_an N V W X Y: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq N (cfv K clln) $ >
  $ wceq P (cfv K clpl) $ >
  $ wceq V (cfv K clvol) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel X P) (wcel Y P) (wcel W V)) (w3a (wbr X W c_le) (wbr Y W c_le) (wne X Y))) (wcel (co X Y c_an) N) $;

--| The meet of two lattice planes is a lattice line iff their join is a lattice volume. (Contributed by NM, 13-Jul-2012.)
theorem _2lplnmj (P c_or K c_an N V X Y: class):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq N (cfv K clln) $ >
  $ wceq P (cfv K clpl) $ >
  $ wceq V (cfv K clvol) $ >
  $ wi (w3a (wcel K chlt) (wcel X P) (wcel Y P)) (wb (wcel (co X Y c_an) N) (wcel (co X Y c_or) V)) $;


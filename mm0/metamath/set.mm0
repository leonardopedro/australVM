  $ wi ph (wceq (cfv (co P Q c_or) I) (co (cfv P I) (cfv Q I) c_po)) $;

--| Lemma for ~ dihprrn , showing one of 4 cases. (Contributed by NM, 30-Aug-2014.) (New usage is discouraged.)
theorem dihprrnlem1N (ph: wff) (U H I K c_le N V W X Y c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wi ph (wne Y c_0) $ >
  $ wi ph (wbr (cfv (cfv (csn X) N) (ccnv I)) W c_le) $ >
  $ wi ph (wn (wbr (cfv (cfv (csn Y) N) (ccnv I)) W c_le)) $ >
  $ wi ph (wcel (cfv (cpr X Y) N) (crn I)) $;

--| Lemma for ~ dihprrn . (Contributed by NM, 29-Sep-2014.)
theorem dihprrnlem2 (ph: wff) (U H I K N V W X Y c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wi ph (wne X c_0) $ >
  $ wi ph (wne Y c_0) $ >
  $ wi ph (wcel (cfv (cpr X Y) N) (crn I)) $;

--| The span of a vector pair belongs to the range of isomorphism H i.e. is a closed subspace. (Contributed by NM, 29-Sep-2014.)
theorem dihprrn (ph: wff) (U H I K N V W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wcel (cfv (cpr X Y) N) (crn I)) $;

--| The sum of two subspace atoms equals their join. TODO: seems convoluted to go via ~ dihprrn ; should we directly use ~ dihjat ? (Contributed by NM, 13-Aug-2014.)
theorem djhlsmat (ph: wff) (c_po U H I c_or K N V W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq c_or (cfv W (cfv K cdjh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wceq (co (cfv (csn X) N) (cfv (csn Y) N) c_po) (co (cfv (csn X) N) (cfv (csn Y) N) c_or)) $;

--| Subspace sum of a closed subspace and an atom. ( ~ pmapjat1 analog.) TODO: merge into ~ dihjat1 ? (Contributed by NM, 18-Aug-2014.)
theorem dihjat1lem (ph: wff) (c_po T U H I c_or K N V W X c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq c_or (cfv W (cfv K cdjh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (crn I)) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wi ph (wcel T (cdif V (csn c_0))) $ >
  $ wi ph (wceq (co X (cfv (csn T) N) c_or) (co X (cfv (csn T) N) c_po)) $;

--| Subspace sum of a closed subspace and an atom. ( ~ pmapjat1 analog.) (Contributed by NM, 1-Oct-2014.)
theorem dihjat1 (ph: wff) (c_po T U H I c_or K N V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq c_or (cfv W (cfv K cdjh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (crn I)) $ >
  $ wi ph (wcel T V) $ >
  $ wi ph (wceq (co X (cfv (csn T) N) c_or) (co X (cfv (csn T) N) c_po)) $;

--| Subspace sum of a closed subspace and the span of a singleton. (Contributed by NM, 17-Jan-2015.)
theorem dihsmsprn (ph: wff) (c_po T U H I K N V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (crn I)) $ >
  $ wi ph (wcel T V) $ >
  $ wi ph (wcel (co X (cfv (csn T) N) c_po) (crn I)) $;

--| The subspace sum of a closed subspace and an atom is the same as their subspace join. (Contributed by NM, 1-Oct-2014.)
theorem dihjat2 (ph: wff) (A2 c_po Q U H I c_or K W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq c_or (cfv W (cfv K cdjh)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (crn I)) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wceq (co X Q c_or) (co X Q c_po)) $;

--| Isomorphism H of lattice join with an atom. (Contributed by NM, 25-Apr-2015.)
theorem dihjat3 (ph: wff) (A2 B2 P c_po U H I c_or K W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel P A2) $ >
  $ wi ph (wceq (cfv (co X P c_or) I) (co (cfv X I) (cfv P I) c_po)) $;

--| Transfer the subspace sum of a closed subspace and an atom back to lattice join. (Contributed by NM, 25-Apr-2015.)
theorem dihjat4 (ph: wff) (A2 c_po Q U H I c_or K W X: class):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (crn I)) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wceq (co X Q c_po) (cfv (co (cfv X (ccnv I)) (cfv Q (ccnv I)) c_or) I)) $;

--| Transfer the subspace sum of a closed subspace and an atom back to lattice join. (Contributed by NM, 25-Apr-2015.)
theorem dihjat6 (ph: wff) (A2 c_po Q U H I c_or K W X: class):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (crn I)) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wceq (cfv (co X Q c_po) (ccnv I)) (co (cfv X (ccnv I)) (cfv Q (ccnv I)) c_or)) $;

--| The subspace sum of two singleton spans is closed. (Contributed by NM, 27-Feb-2015.)
theorem dihsmsnrn (ph: wff) (c_po U H I K N V W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wcel (co (cfv (csn X) N) (cfv (csn Y) N) c_po) (crn I)) $;

--| The subspace sum of a closed subspace and an atom is closed. TODO: see if proof at ~ https://math.stackexchange.com/a/1233211/50776 and Mon, 13 Apr 2015 20:44:07 -0400 email could be used instead of this and ~ dihjat2 . (Contributed by NM, 15-Jan-2015.)
theorem dihsmatrn (ph: wff) (A2 c_po Q U H I K W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (crn I)) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wcel (co X Q c_po) (crn I)) $;

--| Transfer lattice join with atom to subspace sum. (Contributed by NM, 25-Apr-2015.) (New usage is discouraged.)
theorem dihjat5N (ph: wff) (A2 B2 P c_po U H I c_or K W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel P A2) $ >
  $ wi ph (wceq (co X P c_or) (cfv (co (cfv X I) (cfv P I) c_po) (ccnv I))) $;

--| There is an atom that is outside the subspace sum of 3 others. (Contributed by NM, 25-Apr-2015.)
theorem dvh4dimat {s1: setvar} (ph: wff) (A2 P c_po Q R: class) (U H: class s1) (K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel P A2) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wcel R A2) $ >
  $ wi ph (wrex s1 (wn (wss (cv s1) (co (co P Q c_po) R c_po))) A2) $;

--| There is an atom that is outside the subspace sum of 2 others. (Contributed by NM, 25-Apr-2015.) (New usage is discouraged.)
theorem dvh3dimatN {s1: setvar} (ph: wff) (A2 P c_po Q: class) (U H: class s1) (K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel P A2) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wrex s1 (wn (wss (cv s1) (co P Q c_po))) A2) $;

--| Given an atom, there exists another. (Contributed by NM, 25-Apr-2015.) (New usage is discouraged.)
theorem dvh2dimatN {s1: setvar} (ph: wff) (A2 P U: class) (H: class s1) (K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel P A2) $ >
  $ wi ph (wrex s1 (wne (cv s1) P) A2) $;

--| There exists an atom. (Contributed by NM, 25-Apr-2015.)
theorem dvh1dimat {s1: setvar} (ph: wff) (A2: class) (U H: class s1) (K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wex s1 (wcel (cv s1) A2)) $;

--| There exists a nonzero vector. (Contributed by NM, 26-Apr-2015.)
theorem dvh1dim {z: setvar} (ph: wff) (U: class) (H K: class z) (V: class) (W: class z) (c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wrex z (wne (cv z) c_0) V) $;

--| Lemma for ~ dvh4dimN . (Contributed by NM, 22-May-2015.)
theorem dvh4dimlem {z: setvar} (ph: wff) (U: class) (H K: class z) (N V: class) (W: class z) (X Y c_0 Z: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq N (cfv U clspn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wcel Z V) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wi ph (wne X c_0) $ >
  $ wi ph (wne Y c_0) $ >
  $ wi ph (wne Z c_0) $ >
  $ wi ph (wrex z (wn (wcel (cv z) (cfv (ctp X Y Z) N))) V) $;

--| Lemma for ~ dvh2dim and ~ dvh3dim . TODO: make this obsolete and use ~ dvh4dimlem directly? (Contributed by NM, 24-Apr-2015.)
theorem dvhdimlem {z: setvar} (ph: wff) (U: class) (H K: class z) (N V: class) (W: class z) (X Y c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq N (cfv U clspn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wi ph (wne X c_0) $ >
  $ wi ph (wne Y c_0) $ >
  $ wi ph (wrex z (wn (wcel (cv z) (cfv (cpr X Y) N))) V) $;

--| There is a vector that is outside the span of another. (Contributed by NM, 25-Apr-2015.)
theorem dvh2dim {z: setvar} (ph: wff) (U: class) (H K: class z) (N V: class) (W: class z) (X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq N (cfv U clspn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wrex z (wn (wcel (cv z) (cfv (csn X) N))) V) $;

--| There is a vector that is outside the span of 2 others. (Contributed by NM, 24-Apr-2015.)
theorem dvh3dim {z: setvar} (ph: wff) (U: class) (H K: class z) (N V: class) (W: class z) (X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq N (cfv U clspn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wrex z (wn (wcel (cv z) (cfv (cpr X Y) N))) V) $;

--| There is a vector that is outside the span of 3 others. (Contributed by NM, 22-May-2015.) (New usage is discouraged.)
theorem dvh4dimN {z: setvar} (ph: wff) (U: class) (H K: class z) (N V: class) (W: class z) (X Y Z: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq N (cfv U clspn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wcel Z V) $ >
  $ wi ph (wrex z (wn (wcel (cv z) (cfv (ctp X Y Z) N))) V) $;

--| There is a vector that is outside of 2 spans with a common vector. (Contributed by NM, 13-May-2015.)
theorem dvh3dim2 {z: setvar} (ph: wff) (U: class) (H K: class z) (N V: class) (W: class z) (X Y Z: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq N (cfv U clspn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wcel Z V) $ >
  $ wi ph (wrex z (wa (wn (wcel (cv z) (cfv (cpr X Y) N))) (wn (wcel (cv z) (cfv (cpr X Z) N)))) V) $;

--| There is a vector that is outside of 2 spans. TODO: decide to use either this or ~ dvh3dim2 everywhere. If this one is needed, make ~ dvh3dim2 into a lemma. (Contributed by NM, 21-May-2015.) (New usage is discouraged.)
theorem dvh3dim3N {z: setvar} (ph: wff) (T U: class) (H K: class z) (N V: class) (W: class z) (X Y Z: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq N (cfv U clspn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wcel Z V) $ >
  $ wi ph (wcel T V) $ >
  $ wi ph (wrex z (wa (wn (wcel (cv z) (cfv (cpr X Y) N))) (wn (wcel (cv z) (cfv (cpr Z T) N)))) V) $;

--| The orthocomplement of a singleton is nonzero. (Contributed by NM, 13-Jun-2015.)
theorem dochsnnz (ph: wff) (U H K c_pe V W X c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wne (cfv (csn X) c_pe) (csn c_0)) $;

--| The orthocomplement of a subspace atom is a hyperplane. (Contributed by NM, 27-Jul-2014.) (Revised by Mario Carneiro, 1-Oct-2014.)
theorem dochsatshp (ph: wff) (A2 Q U H K c_pe W Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wceq Y (cfv U clsh) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wcel (cfv Q c_pe) Y) $;

--| The orthocomplement of a subspace atom is a hyperplane. (Contributed by NM, 29-Oct-2014.)
theorem dochsatshpb (ph: wff) (A2 Q S U H K c_pe W Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wceq Y (cfv U clsh) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel Q S) $ >
  $ wi ph (wb (wcel Q A2) (wcel (cfv Q c_pe) Y)) $;

--| The orthocomplement of a nonzero singleton is a hyperplane. (Contributed by NM, 3-Jan-2015.)
theorem dochsnshp (ph: wff) (U H K c_pe V W X Y c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq Y (cfv U clsh) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel (cfv (csn X) c_pe) Y) $;

--| A hyperplane is closed iff its orthocomplement is an atom. (Contributed by NM, 29-Oct-2014.)
theorem dochshpsat (ph: wff) (A2 U H K c_pe W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wceq Y (cfv U clsh) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X Y) $ >
  $ wi ph (wb (wceq (cfv (cfv X c_pe) c_pe) X) (wcel (cfv X c_pe) A2)) $;

--| The orthocomplement of a kernel is an atom iff it is nonzero. (Contributed by NM, 1-Nov-2014.)
theorem dochkrsat (ph: wff) (A2 U F G H K L c_pe W c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wb (wne (cfv (cfv G L) c_pe) (csn c_0)) (wcel (cfv (cfv G L) c_pe) A2)) $;

--| The orthocomplement of a kernel is an atom iff the double orthocomplement is not the vector space. (Contributed by NM, 1-Jan-2015.)
theorem dochkrsat2 (ph: wff) (A2 U F G H K L c_pe V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wb (wne (cfv (cfv (cfv G L) c_pe) c_pe) V) (wcel (cfv (cfv G L) c_pe) A2)) $;

--| The orthocomplement of a kernel is either an atom or zero. (Contributed by NM, 29-Jan-2015.)
theorem dochsat0 (ph: wff) (A2 U F G H K L c_pe W c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wo (wcel (cfv (cfv G L) c_pe) A2) (wceq (cfv (cfv G L) c_pe) (csn c_0))) $;

--| The subspace sum of a closed subspace and a kernel orthocomplement is closed. ( ~ djhlsmcl can be used to convert sum to join.) (Contributed by NM, 29-Jan-2015.)
theorem dochkrsm (ph: wff) (c_po U F G H I K L c_pe W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (crn I)) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel (co X (cfv (cfv G L) c_pe) c_po) (crn I)) $;

--| Special case of excluded middle for the singleton of a vector. (Contributed by NM, 27-Oct-2014.)
theorem dochexmidat (ph: wff) (c_po U H K N c_pe V W X c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wceq (co (cfv (csn X) c_pe) (cfv (csn X) N) c_po) V) $;

--| Lemma for ~ dochexmid . Holland's proof implicitly requires ` q =/= r ` , which we prove here. (Contributed by NM, 14-Jan-2015.)
theorem dochexmidlem1 {r q p: setvar} (ph: wff r q p) (A2 c_po S U H K N c_pe V W X: class r q p):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wcel (cv p) A2) $ >
  $ wi ph (wcel (cv q) A2) $ >
  $ wi ph (wcel (cv r) A2) $ >
  $ wi ph (wss (cv q) (cfv X c_pe)) $ >
  $ wi ph (wss (cv r) X) $ >
  $ wi ph (wne (cv q) (cv r)) $;

--| Lemma for ~ dochexmid . (Contributed by NM, 14-Jan-2015.)
theorem dochexmidlem2 {r q p: setvar} (ph: wff r q p) (A2 c_po S U H K N c_pe V W X: class r q p):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wcel (cv p) A2) $ >
  $ wi ph (wcel (cv q) A2) $ >
  $ wi ph (wcel (cv r) A2) $ >
  $ wi ph (wss (cv q) (cfv X c_pe)) $ >
  $ wi ph (wss (cv r) X) $ >
  $ wi ph (wss (cv p) (co (cv r) (cv q) c_po)) $ >
  $ wi ph (wss (cv p) (co X (cfv X c_pe) c_po)) $;

--| Lemma for ~ dochexmid . Use atom exchange ~ lsatexch1 to swap ` p ` and ` q ` . (Contributed by NM, 14-Jan-2015.)
theorem dochexmidlem3 {r q p: setvar} (ph: wff r q p) (A2 c_po S U H K N c_pe V W X: class r q p):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wcel (cv p) A2) $ >
  $ wi ph (wcel (cv q) A2) $ >
  $ wi ph (wcel (cv r) A2) $ >
  $ wi ph (wss (cv q) (cfv X c_pe)) $ >
  $ wi ph (wss (cv r) X) $ >
  $ wi ph (wss (cv q) (co (cv r) (cv p) c_po)) $ >
  $ wi ph (wss (cv p) (co X (cfv X c_pe) c_po)) $;

--| Lemma for ~ dochexmid . (Contributed by NM, 15-Jan-2015.)
theorem dochexmidlem4 {q p: setvar} (ph: wff q p) (A2 c_po S U H K M N c_pe V W X c_0: class q p):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wcel (cv p) A2) $ >
  $ wi ph (wcel (cv q) A2) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq M (co X (cv p) c_po) $ >
  $ wi ph (wne X (csn c_0)) $ >
  $ wi ph (wss (cv q) (cin (cfv X c_pe) M)) $ >
  $ wi ph (wss (cv p) (co X (cfv X c_pe) c_po)) $;

--| Lemma for ~ dochexmid . (Contributed by NM, 15-Jan-2015.)
theorem dochexmidlem5 {p: setvar} (ph: wff p) (A2 c_po S U H K M N c_pe V W X c_0: class p):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wcel (cv p) A2) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq M (co X (cv p) c_po) $ >
  $ wi ph (wne X (csn c_0)) $ >
  $ wi ph (wn (wss (cv p) (co X (cfv X c_pe) c_po))) $ >
  $ wi ph (wceq (cin (cfv X c_pe) M) (csn c_0)) $;

--| Lemma for ~ dochexmid . (Contributed by NM, 15-Jan-2015.)
theorem dochexmidlem6 {p: setvar} (ph: wff p) (A2 c_po S U H K M N c_pe V W X c_0: class p):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wcel (cv p) A2) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq M (co X (cv p) c_po) $ >
  $ wi ph (wne X (csn c_0)) $ >
  $ wi ph (wceq (cfv (cfv X c_pe) c_pe) X) $ >
  $ wi ph (wn (wss (cv p) (co X (cfv X c_pe) c_po))) $ >
  $ wi ph (wceq M X) $;

--| Lemma for ~ dochexmid . Contradict ~ dochexmidlem6 . (Contributed by NM, 15-Jan-2015.)
theorem dochexmidlem7 {p: setvar} (ph: wff p) (A2 c_po S U H K M N c_pe V W X c_0: class p):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wcel (cv p) A2) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq M (co X (cv p) c_po) $ >
  $ wi ph (wne X (csn c_0)) $ >
  $ wi ph (wceq (cfv (cfv X c_pe) c_pe) X) $ >
  $ wi ph (wn (wss (cv p) (co X (cfv X c_pe) c_po))) $ >
  $ wi ph (wne M X) $;

--| Lemma for ~ dochexmid . The contradiction of ~ dochexmidlem6 and ~ dochexmidlem7 shows that there can be no atom ` p ` that is not in ` X + ( ._|_ `` X ) ` , which is therefore the whole atom space. (Contributed by NM, 15-Jan-2015.)
theorem dochexmidlem8 (ph: wff) (A2 c_po S U H K N c_pe V W X c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X S) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wi ph (wne X (csn c_0)) $ >
  $ wi ph (wceq (cfv (cfv X c_pe) c_pe) X) $ >
  $ wi ph (wceq (co X (cfv X c_pe) c_po) V) $;

--| Excluded middle law for closed subspaces, which is equivalent to (and derived from) the orthomodular law ~ dihoml4 . Lemma 3.3(2) in [Holland95] p. 215. In our proof, we use the variables ` X ` , ` M ` , ` p ` , ` q ` , ` r ` in place of Hollands' l, m, P, Q, L respectively. ( ~ pexmidALTN analog.) (Contributed by NM, 15-Jan-2015.)
theorem dochexmid (ph: wff) (c_po S U H K c_pe V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wceq (cfv (cfv X c_pe) c_pe) X) $ >
  $ wi ph (wceq (co X (cfv X c_pe) c_po) V) $;

--| Lemma for ~ dochsnkr . (Contributed by NM, 1-Jan-2015.)
theorem dochsnkrlem1 (ph: wff) (U F G H K L c_pe V W X c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel X (cdif (cfv (cfv G L) c_pe) (csn c_0))) $ >
  $ wi ph (wne (cfv (cfv (cfv G L) c_pe) c_pe) V) $;

--| Lemma for ~ dochsnkr . (Contributed by NM, 1-Jan-2015.)
theorem dochsnkrlem2 (ph: wff) (A2 U F G H K L c_pe V W X c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel X (cdif (cfv (cfv G L) c_pe) (csn c_0))) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wi ph (wcel (cfv (cfv G L) c_pe) A2) $;

--| Lemma for ~ dochsnkr . (Contributed by NM, 2-Jan-2015.)
theorem dochsnkrlem3 (ph: wff) (U F G H K L c_pe V W X c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel X (cdif (cfv (cfv G L) c_pe) (csn c_0))) $ >
  $ wi ph (wceq (cfv (cfv (cfv G L) c_pe) c_pe) (cfv G L)) $;

--| A (closed) kernel expressed in terms of a nonzero vector in its orthocomplement. TODO: consolidate lemmas unless they're needed for something else (in which case break out as theorems). (Contributed by NM, 2-Jan-2015.)
theorem dochsnkr (ph: wff) (U F G H K L c_pe V W X c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel X (cdif (cfv (cfv G L) c_pe) (csn c_0))) $ >
  $ wi ph (wceq (cfv G L) (cfv (csn X) c_pe)) $;

--| Kernel of the explicit functional ` G ` determined by a nonzero vector ` X ` . Compare the more general ~ lshpkr . (Contributed by NM, 27-Oct-2014.)
theorem dochsnkr2 {w v k: setvar} (ph: wff w v k) (D: class w v) (c_pl: class) (R: class w) (c_x: class) (U G H K L: class w v k) (c_pe: class) (V: class w k) (W: class w v k) (X: class) (c_0: class w v k):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq D (cfv U csca) $ >
  $ wceq R (cfv D cbs) $ >
  $ wceq G (cmpt v V (crio k (wrex w (wceq (cv v) (co (cv w) (co (cv k) X c_x) c_pl)) (cfv (csn X) c_pe)) R)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wceq (cfv G L) (cfv (csn X) c_pe)) $;

--| The ` X ` determining functional ` G ` belongs to the atom formed by the orthocomplement of the kernel. (Contributed by NM, 4-Jan-2015.)
theorem dochsnkr2cl {w v k: setvar} (ph: wff w v k) (D: class w v) (c_pl: class) (R: class w) (c_x: class) (U G H K L: class w v k) (c_pe: class) (V: class w k) (W: class w v k) (X: class) (c_0: class w v k):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq D (cfv U csca) $ >
  $ wceq R (cfv D cbs) $ >
  $ wceq G (cmpt v V (crio k (wrex w (wceq (cv v) (co (cv w) (co (cv k) X c_x) c_pl)) (cfv (csn X) c_pe)) R)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel X (cdif (cfv (cfv G L) c_pe) (csn c_0))) $;

--| Closure of the explicit functional ` G ` determined by a nonzero vector ` X ` . Compare the more general ~ lshpkrcl . (Contributed by NM, 27-Oct-2014.)
theorem dochflcl {w v k: setvar} (ph: wff w v k) (D: class w v) (c_pl: class) (R: class w) (c_x: class) (U F G H K: class w v k) (c_pe: class) (V: class w k) (W: class w v k) (X: class) (c_0: class w v k):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq D (cfv U csca) $ >
  $ wceq R (cfv D cbs) $ >
  $ wceq G (cmpt v V (crio k (wrex w (wceq (cv v) (co (cv w) (co (cv k) X c_x) c_pl)) (cfv (csn X) c_pe)) R)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel G F) $;

--| The value of the explicit functional ` G ` is 1 at the ` X ` that determines it. (Contributed by NM, 27-Oct-2014.)
theorem dochfl1 {w v k: setvar} (ph: wff w v k) (D: class w v k) (c_pl: class) (R: class w) (c_x: class) (U: class w v k) (c_1: class v) (G H K: class w v k) (c_pe: class) (V: class w k) (W: class w v k) (X: class) (c_0: class v k):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq D (cfv U csca) $ >
  $ wceq R (cfv D cbs) $ >
  $ wceq c_1 (cfv D cur) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wceq G (cmpt v V (crio k (wrex w (wceq (cv v) (co (cv w) (co (cv k) X c_x) c_pl)) (cfv (csn X) c_pe)) R)) $ >
  $ wi ph (wceq (cfv X G) c_1) $;

--| The value of a functional is nonzero at a nonzero vector in the orthocomplement of its kernel. (Contributed by NM, 2-Jan-2015.)
theorem dochfln0 (ph: wff) (R U F G H K L N c_pe V W X c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq N (cfv R c0g) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel X (cdif (cfv (cfv G L) c_pe) (csn c_0))) $ >
  $ wi ph (wne (cfv X G) N) $;

--| A nonzero functional has a value of 1 at some argument belonging to the orthocomplement of its kernel (when its kernel is a closed hyperplane). Tighter version of ~ lfl1 . (Contributed by NM, 2-Jan-2015.)
theorem dochkr1 {x3: setvar} (ph: wff x3) (R U c_1: class) (F: class x3) (G: class) (H K: class x3) (L c_pe: class) (V W: class x3) (c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wne (cfv (cfv (cfv G L) c_pe) c_pe) V) $ >
  $ wi ph (wrex x3 (wceq (cfv (cv x3) G) c_1) (cdif (cfv (cfv G L) c_pe) (csn c_0))) $;

--| A nonzero functional has a value of 1 at some argument belonging to the orthocomplement of its kernel (when its kernel is a closed hyperplane). Tighter version of ~ lfl1 . (Contributed by NM, 2-Jan-2015.) (New usage is discouraged.)
theorem dochkr1OLDN {x3: setvar} (ph: wff x3) (R U c_1: class) (F: class x3) (G: class) (H K: class x3) (L c_pe: class) (V W c_0: class x3):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wne (cfv (cfv (cfv G L) c_pe) c_pe) V) $ >
  $ wi ph (wrex x3 (wceq (cfv (cv x3) G) c_1) (cfv (cfv G L) c_pe)) $;

--| Extend class notation with all polarities of a left module or left vector space.
term clpoN: class;

--| Define the set of all polarities of a left module or left vector space. A polarity is a kind of complementation operation on a subspace. The double polarity of a subspace is a closure operation. Based on Definition 3.2 of [Holland95] p. 214 for projective geometry polarities. For convenience, we open up the domain to include all vector subsets and not just subspaces, but any more restricted polarity can be converted to this one by taking the span of its argument. (Contributed by NM, 24-Nov-2014.)
axiom df_lpolN {x3 y1 w o: setvar}:
  $ wceq clpoN (cmpt w cvv (crab o (w3a (wceq (cfv (cfv (cv w) cbs) (cv o)) (csn (cfv (cv w) c0g))) (wal x3 (wal y1 (wi (w3a (wss (cv x3) (cfv (cv w) cbs)) (wss (cv y1) (cfv (cv w) cbs)) (wss (cv x3) (cv y1))) (wss (cfv (cv y1) (cv o)) (cfv (cv x3) (cv o)))))) (wral x3 (wa (wcel (cfv (cv x3) (cv o)) (cfv (cv w) clsh)) (wceq (cfv (cfv (cv x3) (cv o)) (cv o)) (cv x3))) (cfv (cv w) clsa))) (co (cfv (cv w) clss) (cpw (cfv (cv w) cbs)) cmap))) $;

--| The set of polarities of a left module or left vector space. (Contributed by NM, 24-Nov-2014.) (New usage is discouraged.)
theorem lpolsetN {x3 y1 o: setvar} (A2: class y1 o) (P: class x3 y1 o) (S: class x3 y1) (H: class x3 y1 o) (V: class x3 y1) (W: class) (X c_0: class x3 y1 o):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wceq H (cfv W clsh) $ >
  $ wceq P (cfv W clpoN) $ >
  $ wi (wcel W X) (wceq P (crab o (w3a (wceq (cfv V (cv o)) (csn c_0)) (wal x3 (wal y1 (wi (w3a (wss (cv x3) V) (wss (cv y1) V) (wss (cv x3) (cv y1))) (wss (cfv (cv y1) (cv o)) (cfv (cv x3) (cv o)))))) (wral x3 (wa (wcel (cfv (cv x3) (cv o)) H) (wceq (cfv (cfv (cv x3) (cv o)) (cv o)) (cv x3))) A2)) (co S (cpw V) cmap))) $;

--| The predicate "is a polarity". (Contributed by NM, 24-Nov-2014.) (New usage is discouraged.)
theorem islpolN {x3 y1: setvar} (A2: class y1) (P S H: class x3 y1) (c_pe: class) (V: class x3 y1) (W: class) (X c_0: class x3 y1):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wceq H (cfv W clsh) $ >
  $ wceq P (cfv W clpoN) $ >
  $ wi (wcel W X) (wb (wcel c_pe P) (wa (wf (cpw V) S c_pe) (w3a (wceq (cfv V c_pe) (csn c_0)) (wal x3 (wal y1 (wi (w3a (wss (cv x3) V) (wss (cv y1) V) (wss (cv x3) (cv y1))) (wss (cfv (cv y1) c_pe) (cfv (cv x3) c_pe))))) (wral x3 (wa (wcel (cfv (cv x3) c_pe) H) (wceq (cfv (cfv (cv x3) c_pe) c_pe) (cv x3))) A2)))) $;

--| Properties that determine a polarity. (Contributed by NM, 26-Nov-2014.) (New usage is discouraged.)
theorem islpoldN {x3 y1: setvar} (ph: wff) (A2: class y1) (P S H: class x3 y1) (c_pe: class) (V: class x3 y1) (W: class) (X c_0: class x3 y1):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq A2 (cfv W clsa) $ >
  $ wceq H (cfv W clsh) $ >
  $ wceq P (cfv W clpoN) $ >
  $ wi ph (wcel W X) $ >
  $ wi ph (wf (cpw V) S c_pe) $ >
  $ wi ph (wceq (cfv V c_pe) (csn c_0)) $ >
  $ wi (wa ph (w3a (wss (cv x3) V) (wss (cv y1) V) (wss (cv x3) (cv y1)))) (wss (cfv (cv y1) c_pe) (cfv (cv x3) c_pe)) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel (cfv (cv x3) c_pe) H) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wceq (cfv (cfv (cv x3) c_pe) c_pe) (cv x3)) $ >
  $ wi ph (wcel c_pe P) $;

--| Functionality of a polarity. (Contributed by NM, 26-Nov-2014.) (New usage is discouraged.)
theorem lpolfN (ph: wff) (P S c_pe V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq S (cfv W clss) $ >
  $ wceq P (cfv W clpoN) $ >
  $ wi ph (wcel W X) $ >
  $ wi ph (wcel c_pe P) $ >
  $ wi ph (wf (cpw V) S c_pe) $;

--| The polarity of the whole space is the zero subspace. (Contributed by NM, 26-Nov-2014.) (New usage is discouraged.)
theorem lpolvN (ph: wff) (P c_pe V W X c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq P (cfv W clpoN) $ >
  $ wi ph (wcel W X) $ >
  $ wi ph (wcel c_pe P) $ >
  $ wi ph (wceq (cfv V c_pe) (csn c_0)) $;

--| Contraposition property of a polarity. (Contributed by NM, 26-Nov-2014.) (New usage is discouraged.)
theorem lpolconN (ph: wff) (P c_pe V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq P (cfv W clpoN) $ >
  $ wi ph (wcel W X) $ >
  $ wi ph (wcel c_pe P) $ >
  $ wi ph (wss X V) $ >
  $ wi ph (wss Y V) $ >
  $ wi ph (wss X Y) $ >
  $ wi ph (wss (cfv Y c_pe) (cfv X c_pe)) $;

--| The polarity of an atomic subspace is a hyperplane. (Contributed by NM, 26-Nov-2014.) (New usage is discouraged.)
theorem lpolsatN (ph: wff) (A2 P Q H c_pe W X: class):
  $ wceq A2 (cfv W clsa) $ >
  $ wceq H (cfv W clsh) $ >
  $ wceq P (cfv W clpoN) $ >
  $ wi ph (wcel W X) $ >
  $ wi ph (wcel c_pe P) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wcel (cfv Q c_pe) H) $;

--| Property of a polarity. (Contributed by NM, 26-Nov-2014.) (New usage is discouraged.)
theorem lpolpolsatN (ph: wff) (A2 P Q c_pe W X: class):
  $ wceq A2 (cfv W clsa) $ >
  $ wceq P (cfv W clpoN) $ >
  $ wi ph (wcel W X) $ >
  $ wi ph (wcel c_pe P) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wceq (cfv (cfv Q c_pe) c_pe) Q) $;

--| The subspace orthocomplement for the ` DVecH ` vector space is a polarity. (Contributed by NM, 27-Dec-2014.) (New usage is discouraged.)
theorem dochpolN (ph: wff) (P U H K c_pe W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq P (cfv U clpoN) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel c_pe P) $;

--| Property of a functional with a closed kernel. (Contributed by NM, 28-Dec-2014.)
theorem lcfl1lem {f2: setvar} (C: class f2) (F G L c_pe: class):
  $ wceq C (crab f2 (wceq (cfv (cfv (cfv (cv f2) L) c_pe) c_pe) (cfv (cv f2) L)) F) $ >
  $ wb (wcel G C) (wa (wcel G F) (wceq (cfv (cfv (cfv G L) c_pe) c_pe) (cfv G L))) $;

--| Property of a functional with a closed kernel. (Contributed by NM, 31-Dec-2014.)
theorem lcfl1 {f2: setvar} (ph: wff f2) (C: class f2) (F G L c_pe: class):
  $ wceq C (crab f2 (wceq (cfv (cfv (cfv (cv f2) L) c_pe) c_pe) (cfv (cv f2) L)) F) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wb (wcel G C) (wceq (cfv (cfv (cfv G L) c_pe) c_pe) (cfv G L))) $;

--| Property of a functional with a closed kernel. (Contributed by NM, 1-Jan-2015.)
theorem lcfl2 {f2: setvar} (ph: wff f2) (C U: class f2) (F G: class) (H K: class f2) (L c_pe: class) (V W: class f2):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq C (crab f2 (wceq (cfv (cfv (cfv (cv f2) L) c_pe) c_pe) (cfv (cv f2) L)) F) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wb (wcel G C) (wo (wne (cfv (cfv (cfv G L) c_pe) c_pe) V) (wceq (cfv G L) V))) $;

--| Property of a functional with a closed kernel. (Contributed by NM, 1-Jan-2015.)
theorem lcfl3 {f2: setvar} (ph: wff f2) (A2 C U: class f2) (F G: class) (H K: class f2) (L c_pe: class) (V W: class f2):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq C (crab f2 (wceq (cfv (cfv (cfv (cv f2) L) c_pe) c_pe) (cfv (cv f2) L)) F) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wb (wcel G C) (wo (wcel (cfv (cfv G L) c_pe) A2) (wceq (cfv G L) V))) $;

--| Property of a functional with a closed kernel. (Contributed by NM, 1-Jan-2015.) (New usage is discouraged.)
theorem lcfl4N {f2: setvar} (ph: wff f2) (C U: class f2) (F G: class) (H K: class f2) (L c_pe: class) (V W Y: class f2):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq Y (cfv U clsh) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq C (crab f2 (wceq (cfv (cfv (cfv (cv f2) L) c_pe) c_pe) (cfv (cv f2) L)) F) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wb (wcel G C) (wo (wcel (cfv (cfv (cfv G L) c_pe) c_pe) Y) (wceq (cfv G L) V))) $;

--| Property of a functional with a closed kernel. (Contributed by NM, 1-Jan-2015.)
theorem lcfl5 {f2: setvar} (ph: wff f2) (C U: class f2) (F G: class) (H I K: class f2) (L c_pe: class) (W: class f2):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq C (crab f2 (wceq (cfv (cfv (cfv (cv f2) L) c_pe) c_pe) (cfv (cv f2) L)) F) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wb (wcel G C) (wcel (cfv G L) (crn I))) $;

--| Property of a functional with a closed kernel. TODO: Make ~ lcfl5 etc. obsolete and rewrite without ` C ` hypothesis? (Contributed by NM, 29-Jan-2015.)
theorem lcfl5a (ph: wff) (U F G H I K L c_pe W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wb (wceq (cfv (cfv (cfv G L) c_pe) c_pe) (cfv G L)) (wcel (cfv G L) (crn I))) $;

--| Lemma for ~ lcfl6 . A functional ` G ` (whose kernel is closed by ~ dochsnkr ) is completely determined by a vector ` X ` in the orthocomplement in its kernel at which the functional value is 1. Note that the ` \ { .0. } ` in the ` X ` hypothesis is redundant by the last hypothesis but allows easier use of other theorems. (Contributed by NM, 3-Jan-2015.)
theorem lcfl6lem {w v k: setvar} (ph: wff w v k) (c_pl: class) (R: class w) (S: class w v) (c_x: class) (U: class w v k) (c_1: class v) (F G H K L: class w v k) (c_pe: class) (V: class w k) (W: class w v k) (X: class) (c_0: class v k):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq S (cfv U csca) $ >
  $ wceq c_1 (cfv S cur) $ >
  $ wceq R (cfv S cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel X (cdif (cfv (cfv G L) c_pe) (csn c_0))) $ >
  $ wi ph (wceq (cfv X G) c_1) $ >
  $ wi ph (wceq G (cmpt v V (crio k (wrex w (wceq (cv v) (co (cv w) (co (cv k) X c_x) c_pl)) (cfv (csn X) c_pe)) R))) $;

--| Lemma for ~ lcfl7N . If two functionals ` G ` and ` J ` are equal, they are determined by the same vector. (Contributed by NM, 4-Jan-2015.)
theorem lcfl7lem {w v k: setvar} (ph: wff w v k) (c_pl: class) (R: class w) (S: class v) (c_x: class) (U F G H J K L: class w v k) (c_pe: class) (V: class w k) (W: class w v k) (X Y: class) (c_0: class v k):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq S (cfv U csca) $ >
  $ wceq R (cfv S cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wceq G (cmpt v V (crio k (wrex w (wceq (cv v) (co (cv w) (co (cv k) X c_x) c_pl)) (cfv (csn X) c_pe)) R)) $ >
  $ wceq J (cmpt v V (crio k (wrex w (wceq (cv v) (co (cv w) (co (cv k) Y c_x) c_pl)) (cfv (csn Y) c_pe)) R)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel Y (cdif V (csn c_0))) $ >
  $ wi ph (wceq G J) $ >
  $ wi ph (wceq X Y) $;

--| Property of a functional with a closed kernel. Note that ` ( L `` G ) = V ` means the functional is zero by ~ lkr0f . (Contributed by NM, 3-Jan-2015.)
theorem lcfl6 {x3 w v f2 k: setvar} (ph: wff w v f2 k) (C: class w v f2 k) (c_pl: class x3 f2) (R: class x3 w f2) (S: class v f2) (c_x: class x3 f2) (U: class w v f2 k) (F: class x3 w v k) (G: class w v k) (H K: class x3 w v f2 k) (L: class w v k) (c_pe: class) (V: class w f2 k) (W: class x3 w v f2 k) (c_0: class v f2 k):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq S (cfv U csca) $ >
  $ wceq R (cfv S cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq C (crab f2 (wceq (cfv (cfv (cfv (cv f2) L) c_pe) c_pe) (cfv (cv f2) L)) F) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wb (wcel G C) (wo (wceq (cfv G L) V) (wrex x3 (wceq G (cmpt v V (crio k (wrex w (wceq (cv v) (co (cv w) (co (cv k) (cv x3) c_x) c_pl)) (cfv (csn (cv x3)) c_pe)) R))) (cdif V (csn c_0))))) $;

--| Property of a functional with a closed kernel. Every nonzero functional is determined by a unique nonzero vector. Note that ` ( L `` G ) = V ` means the functional is zero by ~ lkr0f . (Contributed by NM, 4-Jan-2015.) (New usage is discouraged.)
theorem lcfl7N {x3 w v f2 k: setvar} (ph: wff w v f2 k) (C: class w v f2 k) (c_pl: class f2) (R: class w f2) (S: class v f2) (c_x: class f2) (U: class w v f2 k) (F: class x3 w v k) (G: class w v k) (H K: class x3 w v f2 k) (L: class w v k) (c_pe: class) (V: class w f2 k) (W: class x3 w v f2 k) (c_0: class v f2 k):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq S (cfv U csca) $ >
  $ wceq R (cfv S cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq C (crab f2 (wceq (cfv (cfv (cfv (cv f2) L) c_pe) c_pe) (cfv (cv f2) L)) F) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wb (wcel G C) (wo (wceq (cfv G L) V) (wreu x3 (wceq G (cmpt v V (crio k (wrex w (wceq (cv v) (co (cv w) (co (cv k) (cv x3) c_x) c_pl)) (cfv (csn (cv x3)) c_pe)) R))) (cdif V (csn c_0))))) $;

--| Property of a functional with a closed kernel. (Contributed by NM, 17-Jan-2015.)
theorem lcfl8 {x3 f2: setvar} (ph: wff f2) (C U: class f2) (F: class x3) (G: class) (H K: class x3 f2) (L c_pe: class) (V: class f2) (W: class x3 f2):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq C (crab f2 (wceq (cfv (cfv (cfv (cv f2) L) c_pe) c_pe) (cfv (cv f2) L)) F) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wb (wcel G C) (wrex x3 (wceq (cfv G L) (cfv (csn (cv x3)) c_pe)) V)) $;

--| Property of a functional with a closed kernel. (Contributed by NM, 17-Jan-2015.)
theorem lcfl8a {x3: setvar} (ph: wff) (U F G: class) (H K: class x3) (L c_pe V: class) (W: class x3):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wb (wceq (cfv (cfv (cfv G L) c_pe) c_pe) (cfv G L)) (wrex x3 (wceq (cfv G L) (cfv (csn (cv x3)) c_pe)) V)) $;

--| Property of a nonzero functional with a closed kernel. (Contributed by NM, 4-Feb-2015.)
theorem lcfl8b {x3 f2: setvar} (ph: wff f2) (C: class f2) (D: class x3 f2) (U: class f2) (F: class x3) (G: class) (H K: class x3 f2) (L: class) (N: class x3 f2) (c_pe: class) (V: class f2) (W Y c_0: class x3 f2):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq D (cfv U cld) $ >
  $ wceq Y (cfv D c0g) $ >
  $ wceq C (crab f2 (wceq (cfv (cfv (cfv (cv f2) L) c_pe) c_pe) (cfv (cv f2) L)) F) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G (cdif C (csn Y))) $ >
  $ wi ph (wrex x3 (wceq (cfv (cfv G L) c_pe) (cfv (csn (cv x3)) N)) (cdif V (csn c_0))) $;

--| Property implying that a functional has a closed kernel. (Contributed by NM, 16-Feb-2015.)
theorem lcfl9a (ph: wff) (U F G H K L c_pe V W X: class):

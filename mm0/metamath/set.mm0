--| Part of proof of Lemma D in [Crawley] p. 113. (Contributed by NM, 3-Apr-2013.)
theorem cdleme31se2 {t: setvar} (A2: class) (D: class t) (P Q R S: class) (E: class t) (c_or c_an W: class) (Y: class t):
  $ wceq E (co (co P Q c_or) (co D (co (co R (cv t) c_or) W c_an) c_or) c_an) $ >
  $ wceq Y (co (co P Q c_or) (co (csb t S D) (co (co R S c_or) W c_an) c_or) c_an) $ >
  $ wi (wcel S A2) (wceq (csb t S E) Y) $;

--| Part of proof of Lemma E in [Crawley] p. 113. (Contributed by NM, 31-Mar-2013.)
theorem cdleme31sc {s1: setvar} (A2: class) (C: class s1) (P Q R U c_or c_an W: class) (X: class s1):
  $ wceq C (co (co (cv s1) U c_or) (co Q (co (co P (cv s1) c_or) W c_an) c_or) c_an) $ >
  $ wceq X (co (co R U c_or) (co Q (co (co P R c_or) W c_an) c_or) c_an) $ >
  $ wi (wcel R A2) (wceq (csb s1 R C) X) $;

--| Part of proof of Lemma D in [Crawley] p. 113. (Contributed by NM, 31-Mar-2013.)
theorem cdleme31sde {t s1: setvar} (A2: class) (D: class t s1) (P Q: class) (R: class t) (S: class) (U E: class t s1) (c_or c_an W Y: class) (Z: class t s1):
  $ wceq D (co (co (cv t) U c_or) (co Q (co (co P (cv t) c_or) W c_an) c_or) c_an) $ >
  $ wceq E (co (co P Q c_or) (co D (co (co (cv s1) (cv t) c_or) W c_an) c_or) c_an) $ >
  $ wceq Y (co (co S U c_or) (co Q (co (co P S c_or) W c_an) c_or) c_an) $ >
  $ wceq Z (co (co P Q c_or) (co Y (co (co R S c_or) W c_an) c_or) c_an) $ >
  $ wi (wa (wcel R A2) (wcel S A2)) (wceq (csb s1 R (csb t S E)) Z) $;

--| Part of proof of Lemma D in [Crawley] p. 113. (Contributed by NM, 1-Apr-2013.)
theorem cdleme31snd {v t: setvar} (A2 D: class t) (P Q: class) (S: class t) (U: class) (E: class v t) (c_or c_an: class) (N: class v t) (O: class v) (V: class t) (W: class):
  $ wceq D (co (co (cv t) U c_or) (co Q (co (co P (cv t) c_or) W c_an) c_or) c_an) $ >
  $ wceq N (co (co (cv v) V c_or) (co P (co (co Q (cv v) c_or) W c_an) c_or) c_an) $ >
  $ wceq E (co (co O U c_or) (co Q (co (co P O c_or) W c_an) c_or) c_an) $ >
  $ wceq O (co (co S V c_or) (co P (co (co Q S c_or) W c_an) c_or) c_an) $ >
  $ wi (wcel S A2) (wceq (csb v S (csb t N D)) E) $;

--| Part of proof of Lemma E in [Crawley] p. 113. (Contributed by NM, 31-Mar-2013.) (New usage is discouraged.)
theorem cdleme31sdnN {t s1: setvar} (C D: class t s1) (P Q U: class s1) (I: class t s1) (c_or: class s1) (c_le: class t s1) (c_an: class s1) (N: class t s1) (W: class s1):
  $ wceq C (co (co (cv s1) U c_or) (co Q (co (co P (cv s1) c_or) W c_an) c_or) c_an) $ >
  $ wceq D (co (co (cv t) U c_or) (co Q (co (co P (cv t) c_or) W c_an) c_or) c_an) $ >
  $ wceq N (cif (wbr (cv s1) (co P Q c_or) c_le) I C) $ >
  $ wceq N (cif (wbr (cv s1) (co P Q c_or) c_le) I (csb t (cv s1) D)) $;

--| Part of proof of Lemma E in [Crawley] p. 113. (Contributed by NM, 1-Mar-2013.)
theorem cdleme31sn1c {y1 t s1: setvar} (A2: class) (B2: class y1 t) (C D: class y1 t s1) (P Q R: class) (E: class y1 t) (G I: class y1 t s1) (c_or c_le: class) (c_an: class y1 t) (N: class y1 t s1) (W: class y1 t) (Y: class y1 t s1):
  $ wceq G (co (co P Q c_or) (co E (co (co (cv s1) (cv t) c_or) W c_an) c_or) c_an) $ >
  $ wceq I (crio y1 (wral t (wi (wa (wn (wbr (cv t) W c_le)) (wn (wbr (cv t) (co P Q c_or) c_le))) (wceq (cv y1) G)) A2) B2) $ >
  $ wceq N (cif (wbr (cv s1) (co P Q c_or) c_le) I D) $ >
  $ wceq Y (co (co P Q c_or) (co E (co (co R (cv t) c_or) W c_an) c_or) c_an) $ >
  $ wceq C (crio y1 (wral t (wi (wa (wn (wbr (cv t) W c_le)) (wn (wbr (cv t) (co P Q c_or) c_le))) (wceq (cv y1) Y)) A2) B2) $ >
  $ wi (wa (wcel R A2) (wbr R (co P Q c_or) c_le)) (wceq (csb s1 R N) C) $;

--| Part of proof of Lemma E in [Crawley] p. 113. (Contributed by NM, 26-Feb-2013.)
theorem cdleme31sn2 {s1: setvar} (A2: class) (C D: class s1) (P Q R U: class) (I: class s1) (c_or c_le c_an: class) (N: class s1) (W: class):
  $ wceq D (co (co (cv s1) U c_or) (co Q (co (co P (cv s1) c_or) W c_an) c_or) c_an) $ >
  $ wceq N (cif (wbr (cv s1) (co P Q c_or) c_le) I D) $ >
  $ wceq C (co (co R U c_or) (co Q (co (co P R c_or) W c_an) c_or) c_an) $ >
  $ wi (wa (wcel R A2) (wn (wbr R (co P Q c_or) c_le))) (wceq (csb s1 R N) C) $;

--| Part of proof of Lemma E in [Crawley] p. 113. (Contributed by NM, 10-Feb-2013.)
theorem cdleme31fv {x3 z s1: setvar} (A2: class x3 z s1) (B2 C P Q: class z s1) (F c_or: class x3 z s1) (c_le: class z s1) (c_an N O: class x3 z s1) (W: class z s1) (X: class):
  $ wceq O (crio z (wral s1 (wi (wa (wn (wbr (cv s1) W c_le)) (wceq (co (cv s1) (co (cv x3) W c_an) c_or) (cv x3))) (wceq (cv z) (co N (co (cv x3) W c_an) c_or))) A2) B2) $ >
  $ wceq F (cmpt x3 B2 (cif (wa (wne P Q) (wn (wbr (cv x3) W c_le))) O (cv x3))) $ >
  $ wceq C (crio z (wral s1 (wi (wa (wn (wbr (cv s1) W c_le)) (wceq (co (cv s1) (co X W c_an) c_or) X)) (wceq (cv z) (co N (co X W c_an) c_or))) A2) B2) $ >
  $ wi (wcel X B2) (wceq (cfv X F) (cif (wa (wne P Q) (wn (wbr X W c_le))) C X)) $;

--| Part of proof of Lemma E in [Crawley] p. 113. (Contributed by NM, 10-Feb-2013.)
theorem cdleme31fv1 {x3 z s1: setvar} (A2: class x3 z s1) (B2 C P Q: class z s1) (F c_or: class x3 z s1) (c_le: class z s1) (c_an N O: class x3 z s1) (W: class z s1) (X: class):
  $ wceq O (crio z (wral s1 (wi (wa (wn (wbr (cv s1) W c_le)) (wceq (co (cv s1) (co (cv x3) W c_an) c_or) (cv x3))) (wceq (cv z) (co N (co (cv x3) W c_an) c_or))) A2) B2) $ >
  $ wceq F (cmpt x3 B2 (cif (wa (wne P Q) (wn (wbr (cv x3) W c_le))) O (cv x3))) $ >
  $ wceq C (crio z (wral s1 (wi (wa (wn (wbr (cv s1) W c_le)) (wceq (co (cv s1) (co X W c_an) c_or) X)) (wceq (cv z) (co N (co X W c_an) c_or))) A2) B2) $ >
  $ wi (wa (wcel X B2) (wa (wne P Q) (wn (wbr X W c_le)))) (wceq (cfv X F) C) $;

--| Part of proof of Lemma E in [Crawley] p. 113. (Contributed by NM, 25-Feb-2013.)
theorem cdleme31fv1s {x3 z s1: setvar} (A2: class z s1) (B2: class) (P Q: class z s1) (F: class x3 z s1) (c_or c_le c_an N: class z s1) (O: class x3 z s1) (W: class z s1) (X: class):
  $ wceq O (crio z (wral s1 (wi (wa (wn (wbr (cv s1) W c_le)) (wceq (co (cv s1) (co (cv x3) W c_an) c_or) (cv x3))) (wceq (cv z) (co N (co (cv x3) W c_an) c_or))) A2) B2) $ >
  $ wceq F (cmpt x3 B2 (cif (wa (wne P Q) (wn (wbr (cv x3) W c_le))) O (cv x3))) $ >
  $ wi (wa (wcel X B2) (wa (wne P Q) (wn (wbr X W c_le)))) (wceq (cfv X F) (csb x3 X O)) $;

--| Part of proof of Lemma E in [Crawley] p. 113. (Contributed by NM, 23-Feb-2013.)
theorem cdleme31fv2 {x3: setvar} (B2 P Q: class) (F: class x3) (c_le: class) (O: class x3) (W X: class):
  $ wceq F (cmpt x3 B2 (cif (wa (wne P Q) (wn (wbr (cv x3) W c_le))) O (cv x3))) $ >
  $ wi (wa (wcel X B2) (wn (wa (wne P Q) (wn (wbr X W c_le))))) (wceq (cfv X F) X) $;

--| Part of proof of Lemma E in [Crawley] p. 113. (Contributed by NM, 18-Apr-2013.)
theorem cdleme31id {x3: setvar} (B2 P Q: class) (F: class x3) (c_le: class) (O: class x3) (W X: class):
  $ wceq F (cmpt x3 B2 (cif (wa (wne P Q) (wn (wbr (cv x3) W c_le))) O (cv x3))) $ >
  $ wi (wa (wcel X B2) (wceq P Q)) (wceq (cfv X F) X) $;

--| ***START OF VALUE AT ATOM STUFF TO REPLACE ONES BELOW*** FIX COMMENT. TODO: see if this is the optimal utility theorem using ~ lhpmat . (Contributed by NM, 29-Mar-2013.)
theorem cdlemefrs29pre00 {s1: setvar} (ph ps: wff s1) (A2 B2 R H c_or K c_le c_an W: class s1):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wceq (cv s1) R) (wb ph ps) $ >
  $ wi (wa (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel R A2) (wn (wbr R W c_le))) ps) (wcel (cv s1) A2)) (wb (wa (wa (wn (wbr (cv s1) W c_le)) ph) (wceq (co (cv s1) (co R W c_an) c_or) R)) (wa (wn (wbr (cv s1) W c_le)) (wceq (co (cv s1) (co R W c_an) c_or) R))) $;


  $ wceq R (cmpt c (cdif O E) (cima (cfv (cv c) S) (cv c))) $ >
  $ wi (wcel C (cdif O E)) (wcel (cfv C R) O) $;

--| Expand the value of ` .^ ` . (Contributed by Thierry Arnoux, 21-Apr-2017.)
theorem ballotlemgval {x3 v u i k c: setvar} (P: class x3 v u i k c) (R: class x3 k c) (S: class x3) (U: class x3 i k c) (E: class x3 v u) (c_ex: class x3 v u i k c) (F: class x3 v u) (I: class x3) (M N O: class x3 v u) (V: class x3 i k c):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wceq O (crab c (wceq (cfv (cv c) chash) M) (cpw (co c1 (co M N caddc) cfz))) $ >
  $ wceq P (cmpt x3 (cpw O) (co (cfv (cv x3) chash) (cfv O chash) cdiv)) $ >
  $ wceq F (cmpt c O (cmpt i cz (co (cfv (cin (co c1 (cv i) cfz) (cv c)) chash) (cfv (cdif (co c1 (cv i) cfz) (cv c)) chash) cmin))) $ >
  $ wceq E (crab c (wral i (wbr cc0 (cfv (cv i) (cfv (cv c) F)) clt) (co c1 (co M N caddc) cfz)) O) $ >
  $ wbr N M clt $ >
  $ wceq I (cmpt c (cdif O E) (cinf (crab k (wceq (cfv (cv k) (cfv (cv c) F)) cc0) (co c1 (co M N caddc) cfz)) cr clt)) $ >
  $ wceq S (cmpt c (cdif O E) (cmpt i (co c1 (co M N caddc) cfz) (cif (wbr (cv i) (cfv (cv c) I) cle) (co (co (cfv (cv c) I) c1 caddc) (cv i) cmin) (cv i)))) $ >
  $ wceq R (cmpt c (cdif O E) (cima (cfv (cv c) S) (cv c))) $ >
  $ wceq c_ex (cmpo u v cfn cfn (co (cfv (cin (cv v) (cv u)) chash) (cfv (cdif (cv v) (cv u)) chash) cmin)) $ >
  $ wi (wa (wcel U cfn) (wcel V cfn)) (wceq (co U V c_ex) (co (cfv (cin V U) chash) (cfv (cdif V U) chash) cmin)) $;

--| A property of the defined ` .^ ` operator. (Contributed by Thierry Arnoux, 26-Apr-2017.)
theorem ballotlemgun {x3 v u i k c: setvar} (ph: wff x3 v u i k c) (P: class x3 v u i k c) (R: class x3 k c) (S: class x3) (U: class x3 i k c) (E: class x3 v u) (c_ex: class x3 v u i k c) (F: class x3 v u) (I: class x3) (M N O: class x3 v u) (V W: class x3 i k c):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wceq O (crab c (wceq (cfv (cv c) chash) M) (cpw (co c1 (co M N caddc) cfz))) $ >
  $ wceq P (cmpt x3 (cpw O) (co (cfv (cv x3) chash) (cfv O chash) cdiv)) $ >
  $ wceq F (cmpt c O (cmpt i cz (co (cfv (cin (co c1 (cv i) cfz) (cv c)) chash) (cfv (cdif (co c1 (cv i) cfz) (cv c)) chash) cmin))) $ >
  $ wceq E (crab c (wral i (wbr cc0 (cfv (cv i) (cfv (cv c) F)) clt) (co c1 (co M N caddc) cfz)) O) $ >
  $ wbr N M clt $ >
  $ wceq I (cmpt c (cdif O E) (cinf (crab k (wceq (cfv (cv k) (cfv (cv c) F)) cc0) (co c1 (co M N caddc) cfz)) cr clt)) $ >
  $ wceq S (cmpt c (cdif O E) (cmpt i (co c1 (co M N caddc) cfz) (cif (wbr (cv i) (cfv (cv c) I) cle) (co (co (cfv (cv c) I) c1 caddc) (cv i) cmin) (cv i)))) $ >
  $ wceq R (cmpt c (cdif O E) (cima (cfv (cv c) S) (cv c))) $ >
  $ wceq c_ex (cmpo u v cfn cfn (co (cfv (cin (cv v) (cv u)) chash) (cfv (cdif (cv v) (cv u)) chash) cmin)) $ >
  $ wi ph (wcel U cfn) $ >
  $ wi ph (wcel V cfn) $ >
  $ wi ph (wcel W cfn) $ >
  $ wi ph (wceq (cin V W) c0) $ >
  $ wi ph (wceq (co U (cun V W) c_ex) (co (co U V c_ex) (co U W c_ex) caddc)) $;

--| Express the value of ` ( F `` C ) ` in terms of ` .^ ` . (Contributed by Thierry Arnoux, 21-Apr-2017.)
theorem ballotlemfg {x3 v u i k c: setvar} (C: class x3 c) (P: class x3 v u i k c) (R: class x3 k c) (S: class x3) (E: class x3 v u) (c_ex: class x3 v u i k c) (F: class x3 v u) (I: class x3) (J: class x3 c) (M N O: class x3 v u):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wceq O (crab c (wceq (cfv (cv c) chash) M) (cpw (co c1 (co M N caddc) cfz))) $ >
  $ wceq P (cmpt x3 (cpw O) (co (cfv (cv x3) chash) (cfv O chash) cdiv)) $ >
  $ wceq F (cmpt c O (cmpt i cz (co (cfv (cin (co c1 (cv i) cfz) (cv c)) chash) (cfv (cdif (co c1 (cv i) cfz) (cv c)) chash) cmin))) $ >
  $ wceq E (crab c (wral i (wbr cc0 (cfv (cv i) (cfv (cv c) F)) clt) (co c1 (co M N caddc) cfz)) O) $ >
  $ wbr N M clt $ >
  $ wceq I (cmpt c (cdif O E) (cinf (crab k (wceq (cfv (cv k) (cfv (cv c) F)) cc0) (co c1 (co M N caddc) cfz)) cr clt)) $ >
  $ wceq S (cmpt c (cdif O E) (cmpt i (co c1 (co M N caddc) cfz) (cif (wbr (cv i) (cfv (cv c) I) cle) (co (co (cfv (cv c) I) c1 caddc) (cv i) cmin) (cv i)))) $ >
  $ wceq R (cmpt c (cdif O E) (cima (cfv (cv c) S) (cv c))) $ >
  $ wceq c_ex (cmpo u v cfn cfn (co (cfv (cin (cv v) (cv u)) chash) (cfv (cdif (cv v) (cv u)) chash) cmin)) $ >
  $ wi (wa (wcel C (cdif O E)) (wcel J (co cc0 (co M N caddc) cfz))) (wceq (cfv J (cfv C F)) (co C (co c1 J cfz) c_ex)) $;

--| Express the value of ` ( F `` ( R `` C ) ) ` in terms of the newly defined ` .^ ` . (Contributed by Thierry Arnoux, 21-Apr-2017.)
theorem ballotlemfrc {x3 v u i k c: setvar} (C: class x3 c) (P: class x3 v u i k c) (R: class x3 k c) (S: class x3) (E: class x3 v u) (c_ex: class x3 v u i k c) (F: class x3 v u) (I: class x3) (J: class x3 c) (M N O: class x3 v u):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wceq O (crab c (wceq (cfv (cv c) chash) M) (cpw (co c1 (co M N caddc) cfz))) $ >
  $ wceq P (cmpt x3 (cpw O) (co (cfv (cv x3) chash) (cfv O chash) cdiv)) $ >
  $ wceq F (cmpt c O (cmpt i cz (co (cfv (cin (co c1 (cv i) cfz) (cv c)) chash) (cfv (cdif (co c1 (cv i) cfz) (cv c)) chash) cmin))) $ >
  $ wceq E (crab c (wral i (wbr cc0 (cfv (cv i) (cfv (cv c) F)) clt) (co c1 (co M N caddc) cfz)) O) $ >
  $ wbr N M clt $ >
  $ wceq I (cmpt c (cdif O E) (cinf (crab k (wceq (cfv (cv k) (cfv (cv c) F)) cc0) (co c1 (co M N caddc) cfz)) cr clt)) $ >
  $ wceq S (cmpt c (cdif O E) (cmpt i (co c1 (co M N caddc) cfz) (cif (wbr (cv i) (cfv (cv c) I) cle) (co (co (cfv (cv c) I) c1 caddc) (cv i) cmin) (cv i)))) $ >
  $ wceq R (cmpt c (cdif O E) (cima (cfv (cv c) S) (cv c))) $ >
  $ wceq c_ex (cmpo u v cfn cfn (co (cfv (cin (cv v) (cv u)) chash) (cfv (cdif (cv v) (cv u)) chash) cmin)) $ >
  $ wi (wa (wcel C (cdif O E)) (wcel J (co c1 (cfv C I) cfz))) (wceq (cfv J (cfv (cfv C R) F)) (co C (co (cfv J (cfv C S)) (cfv C I) cfz) c_ex)) $;

--| Reverse counting preserves a tie at the first tie. (Contributed by Thierry Arnoux, 21-Apr-2017.)
theorem ballotlemfrci {x3 v u i k c: setvar} (C: class x3 c) (P: class x3 v u i k c) (R: class x3 k c) (S: class x3) (E: class x3 v u) (c_ex: class x3 v u i k c) (F: class x3 v u) (I: class x3) (M N O: class x3 v u):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wceq O (crab c (wceq (cfv (cv c) chash) M) (cpw (co c1 (co M N caddc) cfz))) $ >
  $ wceq P (cmpt x3 (cpw O) (co (cfv (cv x3) chash) (cfv O chash) cdiv)) $ >
  $ wceq F (cmpt c O (cmpt i cz (co (cfv (cin (co c1 (cv i) cfz) (cv c)) chash) (cfv (cdif (co c1 (cv i) cfz) (cv c)) chash) cmin))) $ >
  $ wceq E (crab c (wral i (wbr cc0 (cfv (cv i) (cfv (cv c) F)) clt) (co c1 (co M N caddc) cfz)) O) $ >
  $ wbr N M clt $ >
  $ wceq I (cmpt c (cdif O E) (cinf (crab k (wceq (cfv (cv k) (cfv (cv c) F)) cc0) (co c1 (co M N caddc) cfz)) cr clt)) $ >
  $ wceq S (cmpt c (cdif O E) (cmpt i (co c1 (co M N caddc) cfz) (cif (wbr (cv i) (cfv (cv c) I) cle) (co (co (cfv (cv c) I) c1 caddc) (cv i) cmin) (cv i)))) $ >
  $ wceq R (cmpt c (cdif O E) (cima (cfv (cv c) S) (cv c))) $ >
  $ wceq c_ex (cmpo u v cfn cfn (co (cfv (cin (cv v) (cv u)) chash) (cfv (cdif (cv v) (cv u)) chash) cmin)) $ >
  $ wi (wcel C (cdif O E)) (wceq (cfv (cfv C I) (cfv (cfv C R) F)) cc0) $;

--| Value of ` F ` for a reverse counting ` ( R `` C ) ` . (Contributed by Thierry Arnoux, 27-Apr-2017.)
theorem ballotlemfrceq {x3 v u i k c: setvar} (C: class x3 c) (P: class x3 v u i k c) (R: class x3 k c) (S: class x3) (E: class x3 v u) (c_ex: class x3 v u i k c) (F: class x3 v u) (I: class x3) (J: class x3 c) (M N O: class x3 v u):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wceq O (crab c (wceq (cfv (cv c) chash) M) (cpw (co c1 (co M N caddc) cfz))) $ >
  $ wceq P (cmpt x3 (cpw O) (co (cfv (cv x3) chash) (cfv O chash) cdiv)) $ >
  $ wceq F (cmpt c O (cmpt i cz (co (cfv (cin (co c1 (cv i) cfz) (cv c)) chash) (cfv (cdif (co c1 (cv i) cfz) (cv c)) chash) cmin))) $ >
  $ wceq E (crab c (wral i (wbr cc0 (cfv (cv i) (cfv (cv c) F)) clt) (co c1 (co M N caddc) cfz)) O) $ >
  $ wbr N M clt $ >
  $ wceq I (cmpt c (cdif O E) (cinf (crab k (wceq (cfv (cv k) (cfv (cv c) F)) cc0) (co c1 (co M N caddc) cfz)) cr clt)) $ >
  $ wceq S (cmpt c (cdif O E) (cmpt i (co c1 (co M N caddc) cfz) (cif (wbr (cv i) (cfv (cv c) I) cle) (co (co (cfv (cv c) I) c1 caddc) (cv i) cmin) (cv i)))) $ >
  $ wceq R (cmpt c (cdif O E) (cima (cfv (cv c) S) (cv c))) $ >
  $ wceq c_ex (cmpo u v cfn cfn (co (cfv (cin (cv v) (cv u)) chash) (cfv (cdif (cv v) (cv u)) chash) cmin)) $ >
  $ wi (wa (wcel C (cdif O E)) (wcel J (co c1 (cfv C I) cfz))) (wceq (cfv (co (cfv J (cfv C S)) c1 cmin) (cfv C F)) (cneg (cfv J (cfv (cfv C R) F)))) $;

--| Value of ` F ` for a reversed counting ` ( R `` C ) ` , before the first tie, cannot be zero. (Contributed by Thierry Arnoux, 25-Apr-2017.) (Revised by AV, 6-Oct-2020.)
theorem ballotlemfrcn0 {x3 i k c: setvar} (C: class x3 c) (P: class x3 i k c) (R: class x3 k c) (S E F I: class x3) (J: class x3 c) (M N O: class x3):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wceq O (crab c (wceq (cfv (cv c) chash) M) (cpw (co c1 (co M N caddc) cfz))) $ >
  $ wceq P (cmpt x3 (cpw O) (co (cfv (cv x3) chash) (cfv O chash) cdiv)) $ >
  $ wceq F (cmpt c O (cmpt i cz (co (cfv (cin (co c1 (cv i) cfz) (cv c)) chash) (cfv (cdif (co c1 (cv i) cfz) (cv c)) chash) cmin))) $ >
  $ wceq E (crab c (wral i (wbr cc0 (cfv (cv i) (cfv (cv c) F)) clt) (co c1 (co M N caddc) cfz)) O) $ >
  $ wbr N M clt $ >
  $ wceq I (cmpt c (cdif O E) (cinf (crab k (wceq (cfv (cv k) (cfv (cv c) F)) cc0) (co c1 (co M N caddc) cfz)) cr clt)) $ >
  $ wceq S (cmpt c (cdif O E) (cmpt i (co c1 (co M N caddc) cfz) (cif (wbr (cv i) (cfv (cv c) I) cle) (co (co (cfv (cv c) I) c1 caddc) (cv i) cmin) (cv i)))) $ >
  $ wceq R (cmpt c (cdif O E) (cima (cfv (cv c) S) (cv c))) $ >
  $ wi (w3a (wcel C (cdif O E)) (wcel J (co c1 (co M N caddc) cfz)) (wbr J (cfv C I) clt)) (wne (cfv J (cfv (cfv C R) F)) cc0) $;

--| Range of ` R ` . (Contributed by Thierry Arnoux, 19-Apr-2017.)
theorem ballotlemrc {x3 i k c: setvar} (C: class x3 c) (P: class x3 i k c) (R: class x3 k c) (S E F I M N O: class x3):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wceq O (crab c (wceq (cfv (cv c) chash) M) (cpw (co c1 (co M N caddc) cfz))) $ >
  $ wceq P (cmpt x3 (cpw O) (co (cfv (cv x3) chash) (cfv O chash) cdiv)) $ >
  $ wceq F (cmpt c O (cmpt i cz (co (cfv (cin (co c1 (cv i) cfz) (cv c)) chash) (cfv (cdif (co c1 (cv i) cfz) (cv c)) chash) cmin))) $ >
  $ wceq E (crab c (wral i (wbr cc0 (cfv (cv i) (cfv (cv c) F)) clt) (co c1 (co M N caddc) cfz)) O) $ >
  $ wbr N M clt $ >
  $ wceq I (cmpt c (cdif O E) (cinf (crab k (wceq (cfv (cv k) (cfv (cv c) F)) cc0) (co c1 (co M N caddc) cfz)) cr clt)) $ >
  $ wceq S (cmpt c (cdif O E) (cmpt i (co c1 (co M N caddc) cfz) (cif (wbr (cv i) (cfv (cv c) I) cle) (co (co (cfv (cv c) I) c1 caddc) (cv i) cmin) (cv i)))) $ >
  $ wceq R (cmpt c (cdif O E) (cima (cfv (cv c) S) (cv c))) $ >
  $ wi (wcel C (cdif O E)) (wcel (cfv C R) (cdif O E)) $;

--| Applying ` R ` does not change first ties. (Contributed by Thierry Arnoux, 19-Apr-2017.) (Revised by AV, 6-Oct-2020.)
theorem ballotlemirc {x3 i k c: setvar} (C: class c) (P: class x3 i k c) (R: class x3 c) (S E: class x3) (F: class) (I: class x3) (M N: class) (O: class x3):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wceq O (crab c (wceq (cfv (cv c) chash) M) (cpw (co c1 (co M N caddc) cfz))) $ >
  $ wceq P (cmpt x3 (cpw O) (co (cfv (cv x3) chash) (cfv O chash) cdiv)) $ >
  $ wceq F (cmpt c O (cmpt i cz (co (cfv (cin (co c1 (cv i) cfz) (cv c)) chash) (cfv (cdif (co c1 (cv i) cfz) (cv c)) chash) cmin))) $ >
  $ wceq E (crab c (wral i (wbr cc0 (cfv (cv i) (cfv (cv c) F)) clt) (co c1 (co M N caddc) cfz)) O) $ >
  $ wbr N M clt $ >
  $ wceq I (cmpt c (cdif O E) (cinf (crab k (wceq (cfv (cv k) (cfv (cv c) F)) cc0) (co c1 (co M N caddc) cfz)) cr clt)) $ >
  $ wceq S (cmpt c (cdif O E) (cmpt i (co c1 (co M N caddc) cfz) (cif (wbr (cv i) (cfv (cv c) I) cle) (co (co (cfv (cv c) I) c1 caddc) (cv i) cmin) (cv i)))) $ >
  $ wceq R (cmpt c (cdif O E) (cima (cfv (cv c) S) (cv c))) $ >
  $ wi (wcel C (cdif O E)) (wceq (cfv (cfv C R) I) (cfv C I)) $;

--| Lemma for ~ ballotlemrinv . (Contributed by Thierry Arnoux, 18-Apr-2017.)
theorem ballotlemrinv0 {x3 i k c: setvar} (C: class c) (D: class x3 c) (P: class x3 i k c) (R: class x3 c) (S E: class x3) (F: class) (I: class x3) (M N: class) (O: class x3):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wceq O (crab c (wceq (cfv (cv c) chash) M) (cpw (co c1 (co M N caddc) cfz))) $ >
  $ wceq P (cmpt x3 (cpw O) (co (cfv (cv x3) chash) (cfv O chash) cdiv)) $ >
  $ wceq F (cmpt c O (cmpt i cz (co (cfv (cin (co c1 (cv i) cfz) (cv c)) chash) (cfv (cdif (co c1 (cv i) cfz) (cv c)) chash) cmin))) $ >
  $ wceq E (crab c (wral i (wbr cc0 (cfv (cv i) (cfv (cv c) F)) clt) (co c1 (co M N caddc) cfz)) O) $ >
  $ wbr N M clt $ >
  $ wceq I (cmpt c (cdif O E) (cinf (crab k (wceq (cfv (cv k) (cfv (cv c) F)) cc0) (co c1 (co M N caddc) cfz)) cr clt)) $ >
  $ wceq S (cmpt c (cdif O E) (cmpt i (co c1 (co M N caddc) cfz) (cif (wbr (cv i) (cfv (cv c) I) cle) (co (co (cfv (cv c) I) c1 caddc) (cv i) cmin) (cv i)))) $ >
  $ wceq R (cmpt c (cdif O E) (cima (cfv (cv c) S) (cv c))) $ >
  $ wi (wa (wcel C (cdif O E)) (wceq D (cima (cfv C S) C))) (wa (wcel D (cdif O E)) (wceq C (cima (cfv D S) D))) $;

--| ` R ` is its own inverse : it is an involution. (Contributed by Thierry Arnoux, 10-Apr-2017.)
theorem ballotlemrinv {x3 i k c: setvar} (P: class x3 i k c) (R: class x3 c) (S E: class x3) (F: class) (I: class x3) (M N: class) (O: class x3):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wceq O (crab c (wceq (cfv (cv c) chash) M) (cpw (co c1 (co M N caddc) cfz))) $ >
  $ wceq P (cmpt x3 (cpw O) (co (cfv (cv x3) chash) (cfv O chash) cdiv)) $ >
  $ wceq F (cmpt c O (cmpt i cz (co (cfv (cin (co c1 (cv i) cfz) (cv c)) chash) (cfv (cdif (co c1 (cv i) cfz) (cv c)) chash) cmin))) $ >
  $ wceq E (crab c (wral i (wbr cc0 (cfv (cv i) (cfv (cv c) F)) clt) (co c1 (co M N caddc) cfz)) O) $ >
  $ wbr N M clt $ >
  $ wceq I (cmpt c (cdif O E) (cinf (crab k (wceq (cfv (cv k) (cfv (cv c) F)) cc0) (co c1 (co M N caddc) cfz)) cr clt)) $ >
  $ wceq S (cmpt c (cdif O E) (cmpt i (co c1 (co M N caddc) cfz) (cif (wbr (cv i) (cfv (cv c) I) cle) (co (co (cfv (cv c) I) c1 caddc) (cv i) cmin) (cv i)))) $ >
  $ wceq R (cmpt c (cdif O E) (cima (cfv (cv c) S) (cv c))) $ >
  $ wceq (ccnv R) R $;

--| When the vote on the first tie is for A, the first vote is also for A on the reverse counting. (Contributed by Thierry Arnoux, 18-Apr-2017.)
theorem ballotlem1ri {x3 i k c: setvar} (C: class c) (P: class x3 i k c) (R: class x3 c) (S E: class x3) (F: class) (I: class x3) (M N: class) (O: class x3):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wceq O (crab c (wceq (cfv (cv c) chash) M) (cpw (co c1 (co M N caddc) cfz))) $ >
  $ wceq P (cmpt x3 (cpw O) (co (cfv (cv x3) chash) (cfv O chash) cdiv)) $ >
  $ wceq F (cmpt c O (cmpt i cz (co (cfv (cin (co c1 (cv i) cfz) (cv c)) chash) (cfv (cdif (co c1 (cv i) cfz) (cv c)) chash) cmin))) $ >
  $ wceq E (crab c (wral i (wbr cc0 (cfv (cv i) (cfv (cv c) F)) clt) (co c1 (co M N caddc) cfz)) O) $ >
  $ wbr N M clt $ >
  $ wceq I (cmpt c (cdif O E) (cinf (crab k (wceq (cfv (cv k) (cfv (cv c) F)) cc0) (co c1 (co M N caddc) cfz)) cr clt)) $ >
  $ wceq S (cmpt c (cdif O E) (cmpt i (co c1 (co M N caddc) cfz) (cif (wbr (cv i) (cfv (cv c) I) cle) (co (co (cfv (cv c) I) c1 caddc) (cv i) cmin) (cv i)))) $ >
  $ wceq R (cmpt c (cdif O E) (cima (cfv (cv c) S) (cv c))) $ >
  $ wi (wcel C (cdif O E)) (wb (wcel c1 (cfv C R)) (wcel (cfv C I) C)) $;

--| ` R ` is a bijection between two subsets of ` ( O \ E ) ` : one where a vote for A is picked first, and one where a vote for B is picked first. (Contributed by Thierry Arnoux, 12-Dec-2016.)
theorem ballotlem7 {x3 i k c: setvar} (P: class x3 i k c) (R: class x3 c) (S E: class x3) (F: class) (I: class x3) (M N: class) (O: class x3):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wceq O (crab c (wceq (cfv (cv c) chash) M) (cpw (co c1 (co M N caddc) cfz))) $ >
  $ wceq P (cmpt x3 (cpw O) (co (cfv (cv x3) chash) (cfv O chash) cdiv)) $ >
  $ wceq F (cmpt c O (cmpt i cz (co (cfv (cin (co c1 (cv i) cfz) (cv c)) chash) (cfv (cdif (co c1 (cv i) cfz) (cv c)) chash) cmin))) $ >
  $ wceq E (crab c (wral i (wbr cc0 (cfv (cv i) (cfv (cv c) F)) clt) (co c1 (co M N caddc) cfz)) O) $ >
  $ wbr N M clt $ >
  $ wceq I (cmpt c (cdif O E) (cinf (crab k (wceq (cfv (cv k) (cfv (cv c) F)) cc0) (co c1 (co M N caddc) cfz)) cr clt)) $ >
  $ wceq S (cmpt c (cdif O E) (cmpt i (co c1 (co M N caddc) cfz) (cif (wbr (cv i) (cfv (cv c) I) cle) (co (co (cfv (cv c) I) c1 caddc) (cv i) cmin) (cv i)))) $ >
  $ wceq R (cmpt c (cdif O E) (cima (cfv (cv c) S) (cv c))) $ >
  $ wf1o (crab c (wcel c1 (cv c)) (cdif O E)) (crab c (wn (wcel c1 (cv c))) (cdif O E)) (cres R (crab c (wcel c1 (cv c)) (cdif O E))) $;

--| There are as many countings with ties starting with a ballot for ` A ` as there are starting with a ballot for ` B ` . (Contributed by Thierry Arnoux, 7-Dec-2016.)
theorem ballotlem8 {x3 i k c: setvar} (P: class x3 i k c) (R: class x3 c) (S E: class x3) (F: class) (I: class x3) (M N: class) (O: class x3):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wceq O (crab c (wceq (cfv (cv c) chash) M) (cpw (co c1 (co M N caddc) cfz))) $ >
  $ wceq P (cmpt x3 (cpw O) (co (cfv (cv x3) chash) (cfv O chash) cdiv)) $ >
  $ wceq F (cmpt c O (cmpt i cz (co (cfv (cin (co c1 (cv i) cfz) (cv c)) chash) (cfv (cdif (co c1 (cv i) cfz) (cv c)) chash) cmin))) $ >
  $ wceq E (crab c (wral i (wbr cc0 (cfv (cv i) (cfv (cv c) F)) clt) (co c1 (co M N caddc) cfz)) O) $ >
  $ wbr N M clt $ >
  $ wceq I (cmpt c (cdif O E) (cinf (crab k (wceq (cfv (cv k) (cfv (cv c) F)) cc0) (co c1 (co M N caddc) cfz)) cr clt)) $ >
  $ wceq S (cmpt c (cdif O E) (cmpt i (co c1 (co M N caddc) cfz) (cif (wbr (cv i) (cfv (cv c) I) cle) (co (co (cfv (cv c) I) c1 caddc) (cv i) cmin) (cv i)))) $ >
  $ wceq R (cmpt c (cdif O E) (cima (cfv (cv c) S) (cv c))) $ >
  $ wceq (cfv (crab c (wcel c1 (cv c)) (cdif O E)) chash) (cfv (crab c (wn (wcel c1 (cv c))) (cdif O E)) chash) $;

--| Bertrand's ballot problem : the probability that A is ahead throughout the counting. The proof formalized here is a proof "by reflection", as opposed to other known proofs "by induction" or "by permutation". This is Metamath 100 proof #30. (Contributed by Thierry Arnoux, 7-Dec-2016.)
theorem ballotth {x3 i k c: setvar} (P: class x3 i k c) (R: class x3 c) (S: class x3) (E F: class) (I: class x3) (M N O: class):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wceq O (crab c (wceq (cfv (cv c) chash) M) (cpw (co c1 (co M N caddc) cfz))) $ >
  $ wceq P (cmpt x3 (cpw O) (co (cfv (cv x3) chash) (cfv O chash) cdiv)) $ >
  $ wceq F (cmpt c O (cmpt i cz (co (cfv (cin (co c1 (cv i) cfz) (cv c)) chash) (cfv (cdif (co c1 (cv i) cfz) (cv c)) chash) cmin))) $ >
  $ wceq E (crab c (wral i (wbr cc0 (cfv (cv i) (cfv (cv c) F)) clt) (co c1 (co M N caddc) cfz)) O) $ >
  $ wbr N M clt $ >
  $ wceq I (cmpt c (cdif O E) (cinf (crab k (wceq (cfv (cv k) (cfv (cv c) F)) cc0) (co c1 (co M N caddc) cfz)) cr clt)) $ >
  $ wceq S (cmpt c (cdif O E) (cmpt i (co c1 (co M N caddc) cfz) (cif (wbr (cv i) (cfv (cv c) I) cle) (co (co (cfv (cv c) I) c1 caddc) (cv i) cmin) (cv i)))) $ >
  $ wceq R (cmpt c (cdif O E) (cima (cfv (cv c) S) (cv c))) $ >
  $ wceq (cfv E P) (co (co M N cmin) (co M N caddc) cdiv) $;

--| Condition for an integer interval to be a subset of a half-open integer interval. (Contributed by Thierry Arnoux, 8-Oct-2018.)
theorem fzssfzo (K M N: class):
  $ wi (wcel K (co M N cfzo)) (wss (co M K cfz) (co M N cfzo)) $;

--| Closure of a group sum in a non-commutative monoid. (Contributed by Thierry Arnoux, 8-Oct-2018.)
theorem gsumncl {k: setvar} (ph: wff) (B2: class k) (P K: class) (M: class k) (N: class):
  $ wceq K (cfv M cbs) $ >
  $ wi ph (wcel M cmnd) $ >
  $ wi ph (wcel P (cfv N cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co N P cfz))) (wcel B2 K) $ >
  $ wi ph (wcel (co M (cmpt k (co N P cfz) B2) cgsu) K) $;

--| Closure of a group sum in a non-commutative monoid. (Contributed by Thierry Arnoux, 8-Oct-2018.)
theorem gsumnunsn {k: setvar} (ph: wff) (B2: class k) (C P: class) (c_pl: class k) (K: class) (M: class k) (N: class):
  $ wceq K (cfv M cbs) $ >
  $ wi ph (wcel M cmnd) $ >
  $ wi ph (wcel P (cfv N cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co N P cfz))) (wcel B2 K) $ >
  $ wceq c_pl (cfv M cplusg) $ >
  $ wi ph (wcel C K) $ >
  $ wi (wa ph (wceq (cv k) (co P c1 caddc))) (wceq B2 C) $ >
  $ wi ph (wceq (co M (cmpt k (co N (co P c1 caddc) cfz) B2) cgsu) (co (co M (cmpt k (co N P cfz) B2) cgsu) C c_pl)) $;

--| Concatenation of words follow the rule ~ mulgnn0dir (although applying ~ mulgnn0dir would require ` S ` to be a set). In this case ` A ` is ` <" K "> ` to the power ` M ` in the free monoid. (Contributed by Thierry Arnoux, 5-Oct-2018.)
theorem ccatmulgnn0dir (ph: wff) (A2 B2 C S K M N: class):
  $ wceq A2 (cxp (co cc0 M cfzo) (csn K)) $ >
  $ wceq B2 (cxp (co cc0 N cfzo) (csn K)) $ >
  $ wceq C (cxp (co cc0 (co M N caddc) cfzo) (csn K)) $ >
  $ wi ph (wcel K S) $ >
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (co A2 B2 cconcat) C) $;

--| Letterwise operations on word concatenations. (Contributed by Thierry Arnoux, 5-Oct-2018.)
theorem ofcccat (ph: wff) (R S T F G K: class):
  $ wi ph (wcel F (cword S)) $ >
  $ wi ph (wcel G (cword S)) $ >
  $ wi ph (wcel K T) $ >
  $ wi ph (wceq (co (co F G cconcat) K (cofc R)) (co (co F K (cofc R)) (co G K (cofc R)) cconcat)) $;

--| Letterwise operations on a single letter word. (Contributed by Thierry Arnoux, 7-Oct-2018.)
theorem ofcs1 (A2 B2 R S T: class):
  $ wi (wa (wcel A2 S) (wcel B2 T)) (wceq (co (cs1 A2) B2 (cofc R)) (cs1 (co A2 B2 R))) $;

--| Letterwise operations on a double letter word. (Contributed by Thierry Arnoux, 9-Oct-2018.)
theorem ofcs2 (A2 B2 C R S T: class):
  $ wi (w3a (wcel A2 S) (wcel B2 S) (wcel C T)) (wceq (co (cs2 A2 B2) C (cofc R)) (cs2 (co A2 C R) (co B2 C R))) $;

--| Closure of a polynomial with real coefficients. (Contributed by Thierry Arnoux, 18-Sep-2018.)
theorem plyrecld (ph: wff) (F X: class):
  $ wi ph (wcel F (cfv cr cply)) $ >
  $ wi ph (wcel X cr) $ >
  $ wi ph (wcel (cfv X F) cr) $;

--| The quotient of a polynomial ` F ` by a monic monomial of same degree ` G ` converges to the highest coefficient of ` F ` . (Contributed by Thierry Arnoux, 18-Sep-2018.)
theorem signsplypnf {x3: setvar} (B2: class x3) (C D F G: class):
  $ wceq D (cfv F cdgr) $ >
  $ wceq C (cfv F ccoe) $ >
  $ wceq B2 (cfv D C) $ >
  $ wceq G (cmpt x3 crp (co (cv x3) D cexp)) $ >
  $ wi (wcel F (cfv cr cply)) (wbr (co F G (cof cdiv)) B2 crli) $;

--| Lemma for the rule of signs, based on Bolzano's intermediate value theorem for polynomials : If the lowest and highest coefficient ` A ` and ` B ` are of opposite signs, the polynomial admits a positive root. (Contributed by Thierry Arnoux, 19-Sep-2018.)
theorem signsply0 {z: setvar} (ph: wff) (A2: class z) (B2: class) (C D: class z) (F: class):
  $ wceq D (cfv F cdgr) $ >
  $ wceq C (cfv F ccoe) $ >
  $ wceq B2 (cfv D C) $ >
  $ wceq A2 (cfv cc0 C) $ >
  $ wi ph (wcel F (cfv cr cply)) $ >
  $ wi ph (wne F c0p) $ >
  $ wi ph (wbr (co A2 B2 cmul) cc0 clt) $ >
  $ wi ph (wrex z (wceq (cfv (cv z) F) cc0) crp) $;

--| The value of the skipping 0 sign operation. (Contributed by Thierry Arnoux, 9-Sep-2018.)
theorem signspval {a b: setvar} (c_pd: class a b) (X Y: class):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wi (wa (wcel X (ctp (cneg c1) cc0 c1)) (wcel Y (ctp (cneg c1) cc0 c1))) (wceq (co X Y c_pd) (cif (wceq Y cc0) X Y)) $;

--| Neutral element property of ` .+^ ` . (Contributed by Thierry Arnoux, 9-Sep-2018.)
theorem signsw0glem {u a b: setvar} (c_pd: class u a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wral u (wa (wceq (co cc0 (cv u) c_pd) (cv u)) (wceq (co (cv u) cc0 c_pd) (cv u))) (ctp (cneg c1) cc0 c1) $;

--| The base of ` W ` is the unordered triple reprensenting the possible signs. (Contributed by Thierry Arnoux, 9-Sep-2018.)
theorem signswbase {a b: setvar} (c_pd W: class a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wceq (ctp (cneg c1) cc0 c1) (cfv W cbs) $;

--| The operation of ` W ` . (Contributed by Thierry Arnoux, 9-Sep-2018.)
theorem signswplusg {a b: setvar} (c_pd W: class a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wceq c_pd (cfv W cplusg) $;

--| The neutral element of ` W ` . (Contributed by Thierry Arnoux, 9-Sep-2018.)
theorem signsw0g {a b: setvar} (c_pd W: class a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wceq cc0 (cfv W c0g) $;

--| ` W ` is a monoid structure on ` { -u 1 , 0 , 1 } ` which operation retains the right side, but skips zeroes. This will be used for skipping zeroes when counting sign changes. (Contributed by Thierry Arnoux, 9-Sep-2018.)
theorem signswmnd {a b: setvar} (c_pd: class) (W: class a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wcel W cmnd $;

--| The zero-skipping operation propagates nonzeros. (Contributed by Thierry Arnoux, 11-Oct-2018.)
theorem signswrid {a b: setvar} (c_pd W: class a b) (X: class):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wi (wcel X (ctp (cneg c1) cc0 c1)) (wceq (co X cc0 c_pd) X) $;

--| The zero-skipping operation keeps nonzeros. (Contributed by Thierry Arnoux, 12-Oct-2018.)
theorem signswlid {a b: setvar} (c_pd W: class a b) (X Y: class):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wi (wa (wa (wcel X (ctp (cneg c1) cc0 c1)) (wcel Y (ctp (cneg c1) cc0 c1))) (wne Y cc0)) (wceq (co X Y c_pd) Y) $;

--| The zero-skipping operation propagates nonzeros. (Contributed by Thierry Arnoux, 11-Oct-2018.)
theorem signswn0 {a b: setvar} (c_pd W: class a b) (X Y: class):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wi (wa (wa (wcel X (ctp (cneg c1) cc0 c1)) (wcel Y (ctp (cneg c1) cc0 c1))) (wne X cc0)) (wne (co X Y c_pd) cc0) $;

--| The zero-skipping operation changes value when the operands change signs. (Contributed by Thierry Arnoux, 9-Oct-2018.)
theorem signswch {a b: setvar} (c_pd W: class a b) (X Y: class):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wi (wa (wcel X (cpr (cneg c1) c1)) (wcel Y (ctp (cneg c1) cc0 c1))) (wb (wne (co X Y c_pd) X) (wbr (co X Y cmul) cc0 clt)) $;

--| Computational part of ~~? signwlemn . (Contributed by Thierry Arnoux, 29-Sep-2018.)
theorem signslema (ph: wff) (E F G H: class):
  $ wi ph (wcel E cn0) $ >
  $ wi ph (wcel F cn0) $ >
  $ wi ph (wcel G cn0) $ >
  $ wi ph (wcel H cn0) $ >
  $ wi ph (wa (wbr E G clt) (wn (wbr c2 (co G E cmin) cdvds))) $ >
  $ wi ph (wcel (co (co H G cmin) (co F E cmin) cmin) (cpr cc0 c2)) $ >
  $ wi ph (wa (wbr F H clt) (wn (wbr c2 (co H F cmin) cdvds))) $;

--| Value of the zero-skipping sign word. (Contributed by Thierry Arnoux, 8-Oct-2018.)
theorem signstfv {f2 i j n a b: setvar} (c_pd T: class f2 i j n a b) (F: class j a b) (V: class f2 i j n a b) (W: class i j n a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wceq T (cmpt f2 (cword cr) (cmpt n (co cc0 (cfv (cv f2) chash) cfzo) (co W (cmpt i (co cc0 (cv n) cfz) (cfv (cfv (cv i) (cv f2)) csgn)) cgsu))) $ >
  $ wceq V (cmpt f2 (cword cr) (csu j (co c1 (cfv (cv f2) chash) cfzo) (cif (wne (cfv (cv j) (cfv (cv f2) T)) (cfv (co (cv j) c1 cmin) (cfv (cv f2) T))) c1 cc0))) $ >
  $ wi (wcel F (cword cr)) (wceq (cfv F T) (cmpt n (co cc0 (cfv F chash) cfzo) (co W (cmpt i (co cc0 (cv n) cfz) (cfv (cfv (cv i) F) csgn)) cgsu))) $;

--| Value of the zero-skipping sign word. (Contributed by Thierry Arnoux, 8-Oct-2018.)
theorem signstfval {f2 i j n a b: setvar} (c_pd T: class f2 i j n a b) (F: class j a b) (N: class f2 j a b) (V: class f2 i j n a b) (W: class i j a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wceq T (cmpt f2 (cword cr) (cmpt n (co cc0 (cfv (cv f2) chash) cfzo) (co W (cmpt i (co cc0 (cv n) cfz) (cfv (cfv (cv i) (cv f2)) csgn)) cgsu))) $ >
  $ wceq V (cmpt f2 (cword cr) (csu j (co c1 (cfv (cv f2) chash) cfzo) (cif (wne (cfv (cv j) (cfv (cv f2) T)) (cfv (co (cv j) c1 cmin) (cfv (cv f2) T))) c1 cc0))) $ >
  $ wi (wa (wcel F (cword cr)) (wcel N (co cc0 (cfv F chash) cfzo))) (wceq (cfv N (cfv F T)) (co W (cmpt i (co cc0 N cfz) (cfv (cfv (cv i) F) csgn)) cgsu)) $;

--| Closure of the zero skipping sign word. (Contributed by Thierry Arnoux, 9-Oct-2018.)
theorem signstcl {f2 i j n a b: setvar} (c_pd: class f2 i j n) (T: class f2 i j n a b) (F: class j a b) (N: class f2 j a b) (V: class f2 i j n a b) (W: class j a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wceq T (cmpt f2 (cword cr) (cmpt n (co cc0 (cfv (cv f2) chash) cfzo) (co W (cmpt i (co cc0 (cv n) cfz) (cfv (cfv (cv i) (cv f2)) csgn)) cgsu))) $ >
  $ wceq V (cmpt f2 (cword cr) (csu j (co c1 (cfv (cv f2) chash) cfzo) (cif (wne (cfv (cv j) (cfv (cv f2) T)) (cfv (co (cv j) c1 cmin) (cfv (cv f2) T))) c1 cc0))) $ >
  $ wi (wa (wcel F (cword cr)) (wcel N (co cc0 (cfv F chash) cfzo))) (wcel (cfv N (cfv F T)) (ctp (cneg c1) cc0 c1)) $;

--| The zero skipping sign word is a word. (Contributed by Thierry Arnoux, 8-Oct-2018.)
theorem signstf {f2 i j n a b: setvar} (c_pd: class f2 i j n) (T: class f2 i j n a b) (F: class j a b) (V: class f2 i j n a b) (W: class j a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wceq T (cmpt f2 (cword cr) (cmpt n (co cc0 (cfv (cv f2) chash) cfzo) (co W (cmpt i (co cc0 (cv n) cfz) (cfv (cfv (cv i) (cv f2)) csgn)) cgsu))) $ >
  $ wceq V (cmpt f2 (cword cr) (csu j (co c1 (cfv (cv f2) chash) cfzo) (cif (wne (cfv (cv j) (cfv (cv f2) T)) (cfv (co (cv j) c1 cmin) (cfv (cv f2) T))) c1 cc0))) $ >
  $ wi (wcel F (cword cr)) (wcel (cfv F T) (cword cr)) $;

--| Length of the zero skipping sign word. (Contributed by Thierry Arnoux, 8-Oct-2018.)
theorem signstlen {f2 i j n a b: setvar} (c_pd: class f2 i j n) (T: class f2 i j n a b) (F: class j a b) (V: class f2 i j n a b) (W: class j a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wceq T (cmpt f2 (cword cr) (cmpt n (co cc0 (cfv (cv f2) chash) cfzo) (co W (cmpt i (co cc0 (cv n) cfz) (cfv (cfv (cv i) (cv f2)) csgn)) cgsu))) $ >
  $ wceq V (cmpt f2 (cword cr) (csu j (co c1 (cfv (cv f2) chash) cfzo) (cif (wne (cfv (cv j) (cfv (cv f2) T)) (cfv (co (cv j) c1 cmin) (cfv (cv f2) T))) c1 cc0))) $ >
  $ wi (wcel F (cword cr)) (wceq (cfv (cfv F T) chash) (cfv F chash)) $;

--| Sign of a single letter word. (Contributed by Thierry Arnoux, 8-Oct-2018.)
theorem signstf0 {f2 i j n a b: setvar} (c_pd: class f2 i j n) (T: class f2 i j n a b) (K: class j a b) (V: class f2 i j n a b) (W: class j a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wceq T (cmpt f2 (cword cr) (cmpt n (co cc0 (cfv (cv f2) chash) cfzo) (co W (cmpt i (co cc0 (cv n) cfz) (cfv (cfv (cv i) (cv f2)) csgn)) cgsu))) $ >
  $ wceq V (cmpt f2 (cword cr) (csu j (co c1 (cfv (cv f2) chash) cfzo) (cif (wne (cfv (cv j) (cfv (cv f2) T)) (cfv (co (cv j) c1 cmin) (cfv (cv f2) T))) c1 cc0))) $ >
  $ wi (wcel K cr) (wceq (cfv (cs1 K) T) (cs1 (cfv K csgn))) $;

--| Zero-skipping sign in a word compared to a shorter word. (Contributed by Thierry Arnoux, 8-Oct-2018.)
theorem signstfvn {f2 i j n a b: setvar} (c_pd: class f2 i j n) (T: class f2 i j n a b) (F K: class j a b) (V: class f2 i j n a b) (W: class j a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wceq T (cmpt f2 (cword cr) (cmpt n (co cc0 (cfv (cv f2) chash) cfzo) (co W (cmpt i (co cc0 (cv n) cfz) (cfv (cfv (cv i) (cv f2)) csgn)) cgsu))) $ >
  $ wceq V (cmpt f2 (cword cr) (csu j (co c1 (cfv (cv f2) chash) cfzo) (cif (wne (cfv (cv j) (cfv (cv f2) T)) (cfv (co (cv j) c1 cmin) (cfv (cv f2) T))) c1 cc0))) $ >
  $ wi (wa (wcel F (cdif (cword cr) (csn c0))) (wcel K cr)) (wceq (cfv (cfv F chash) (cfv (co F (cs1 K) cconcat) T)) (co (cfv (co (cfv F chash) c1 cmin) (cfv F T)) (cfv K csgn) c_pd)) $;

--| If the last letter is nonzero, then this is the zero-skipping sign. (Contributed by Thierry Arnoux, 8-Oct-2018.) (Proof shortened by AV, 3-Nov-2022.)
theorem signsvtn0 {f2 i j n a b: setvar} (c_pd T: class f2 i j n) (F N: class j) (V: class f2 i j n a b) (W: class j a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wceq T (cmpt f2 (cword cr) (cmpt n (co cc0 (cfv (cv f2) chash) cfzo) (co W (cmpt i (co cc0 (cv n) cfz) (cfv (cfv (cv i) (cv f2)) csgn)) cgsu))) $ >
  $ wceq V (cmpt f2 (cword cr) (csu j (co c1 (cfv (cv f2) chash) cfzo) (cif (wne (cfv (cv j) (cfv (cv f2) T)) (cfv (co (cv j) c1 cmin) (cfv (cv f2) T))) c1 cc0))) $ >
  $ wceq N (cfv F chash) $ >
  $ wi (wa (wcel F (cdif (cword cr) (csn c0))) (wne (cfv (co N c1 cmin) F) cc0)) (wceq (cfv (co N c1 cmin) (cfv F T)) (cfv (cfv (co N c1 cmin) F) csgn)) $;

--| Zero-skipping sign in a word compared to a shorter word. (Contributed by Thierry Arnoux, 8-Oct-2018.)
theorem signstfvp {f2 i j n a b: setvar} (c_pd: class f2 i j n) (T: class f2 i j n a b) (F K: class j a b) (N: class f2 j a b) (V: class f2 i j n a b) (W: class j a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wceq T (cmpt f2 (cword cr) (cmpt n (co cc0 (cfv (cv f2) chash) cfzo) (co W (cmpt i (co cc0 (cv n) cfz) (cfv (cfv (cv i) (cv f2)) csgn)) cgsu))) $ >
  $ wceq V (cmpt f2 (cword cr) (csu j (co c1 (cfv (cv f2) chash) cfzo) (cif (wne (cfv (cv j) (cfv (cv f2) T)) (cfv (co (cv j) c1 cmin) (cfv (cv f2) T))) c1 cc0))) $ >
  $ wi (w3a (wcel F (cword cr)) (wcel K cr) (wcel N (co cc0 (cfv F chash) cfzo))) (wceq (cfv N (cfv (co F (cs1 K) cconcat) T)) (cfv N (cfv F T))) $;

--| In case the first letter is not zero, the zero skipping sign is never zero. (Contributed by Thierry Arnoux, 10-Oct-2018.)
theorem signstfvneq0 {f2 i j n a b: setvar} (c_pd: class f2 i j n) (T: class f2 i j) (F: class j a b) (N: class f2 j a b) (V: class f2 i j n a b) (W: class j a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wceq T (cmpt f2 (cword cr) (cmpt n (co cc0 (cfv (cv f2) chash) cfzo) (co W (cmpt i (co cc0 (cv n) cfz) (cfv (cfv (cv i) (cv f2)) csgn)) cgsu))) $ >
  $ wceq V (cmpt f2 (cword cr) (csu j (co c1 (cfv (cv f2) chash) cfzo) (cif (wne (cfv (cv j) (cfv (cv f2) T)) (cfv (co (cv j) c1 cmin) (cfv (cv f2) T))) c1 cc0))) $ >
  $ wi (wa (wa (wcel F (cdif (cword cr) (csn c0))) (wne (cfv cc0 F) cc0)) (wcel N (co cc0 (cfv F chash) cfzo))) (wne (cfv N (cfv F T)) cc0) $;

--| Closure of the zero skipping sign in case the first letter is not zero. (Contributed by Thierry Arnoux, 10-Oct-2018.)
theorem signstfvcl {f2 i j n a b: setvar} (c_pd: class f2 i j n) (T: class f2 i j) (F: class j a b) (N: class f2 j a b) (V: class f2 i j n a b) (W: class j a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wceq T (cmpt f2 (cword cr) (cmpt n (co cc0 (cfv (cv f2) chash) cfzo) (co W (cmpt i (co cc0 (cv n) cfz) (cfv (cfv (cv i) (cv f2)) csgn)) cgsu))) $ >
  $ wceq V (cmpt f2 (cword cr) (csu j (co c1 (cfv (cv f2) chash) cfzo) (cif (wne (cfv (cv j) (cfv (cv f2) T)) (cfv (co (cv j) c1 cmin) (cfv (cv f2) T))) c1 cc0))) $ >
  $ wi (wa (wa (wcel F (cdif (cword cr) (csn c0))) (wne (cfv cc0 F) cc0)) (wcel N (co cc0 (cfv F chash) cfzo))) (wcel (cfv N (cfv F T)) (cpr (cneg c1) c1)) $;

--| Zero-skipping sign in a word compared to a shorter word. (Contributed by Thierry Arnoux, 11-Oct-2018.)
theorem signstfvc {f2 i j n a b: setvar} (c_pd: class f2 i j n) (T: class f2 i j n a b) (F: class j a b) (G: class f2 i j n a b) (N: class f2 j a b) (V: class f2 i j n a b) (W: class j a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wceq T (cmpt f2 (cword cr) (cmpt n (co cc0 (cfv (cv f2) chash) cfzo) (co W (cmpt i (co cc0 (cv n) cfz) (cfv (cfv (cv i) (cv f2)) csgn)) cgsu))) $ >
  $ wceq V (cmpt f2 (cword cr) (csu j (co c1 (cfv (cv f2) chash) cfzo) (cif (wne (cfv (cv j) (cfv (cv f2) T)) (cfv (co (cv j) c1 cmin) (cfv (cv f2) T))) c1 cc0))) $ >
  $ wi (w3a (wcel F (cword cr)) (wcel G (cword cr)) (wcel N (co cc0 (cfv F chash) cfzo))) (wceq (cfv N (cfv (co F G cconcat) T)) (cfv N (cfv F T))) $;

--| Restriction of a zero skipping sign to a subword. (Contributed by Thierry Arnoux, 11-Oct-2018.)
theorem signstres {f2 i j n a b: setvar} (c_pd: class f2 i j n) (T: class f2 i j n a b) (F N: class j a b) (V: class f2 i j n a b) (W: class j a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wceq T (cmpt f2 (cword cr) (cmpt n (co cc0 (cfv (cv f2) chash) cfzo) (co W (cmpt i (co cc0 (cv n) cfz) (cfv (cfv (cv i) (cv f2)) csgn)) cgsu))) $ >
  $ wceq V (cmpt f2 (cword cr) (csu j (co c1 (cfv (cv f2) chash) cfzo) (cif (wne (cfv (cv j) (cfv (cv f2) T)) (cfv (co (cv j) c1 cmin) (cfv (cv f2) T))) c1 cc0))) $ >
  $ wi (wa (wcel F (cword cr)) (wcel N (co cc0 (cfv F chash) cfz))) (wceq (cres (cfv F T) (co cc0 N cfzo)) (cfv (cres F (co cc0 N cfzo)) T)) $;

--| Lemma for ~ signstfveq0 . (Contributed by Thierry Arnoux, 11-Oct-2018.)
theorem signstfveq0a {f2 i j n a b: setvar} (c_pd T: class f2 i j n) (F N: class j) (V: class f2 i j n a b) (W: class j a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wceq T (cmpt f2 (cword cr) (cmpt n (co cc0 (cfv (cv f2) chash) cfzo) (co W (cmpt i (co cc0 (cv n) cfz) (cfv (cfv (cv i) (cv f2)) csgn)) cgsu))) $ >
  $ wceq V (cmpt f2 (cword cr) (csu j (co c1 (cfv (cv f2) chash) cfzo) (cif (wne (cfv (cv j) (cfv (cv f2) T)) (cfv (co (cv j) c1 cmin) (cfv (cv f2) T))) c1 cc0))) $ >
  $ wceq N (cfv F chash) $ >
  $ wi (wa (wa (wcel F (cdif (cword cr) (csn c0))) (wne (cfv cc0 F) cc0)) (wceq (cfv (co N c1 cmin) F) cc0)) (wcel N (cfv c2 cuz)) $;

--| In case the last letter is zero, the zero skipping sign is the same as the previous letter. (Contributed by Thierry Arnoux, 11-Oct-2018.) (Proof shortened by AV, 4-Nov-2022.)
theorem signstfveq0 {f2 i j n a b: setvar} (c_pd T: class f2 i j n) (F N: class j) (V: class f2 i j n a b) (W: class j a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wceq T (cmpt f2 (cword cr) (cmpt n (co cc0 (cfv (cv f2) chash) cfzo) (co W (cmpt i (co cc0 (cv n) cfz) (cfv (cfv (cv i) (cv f2)) csgn)) cgsu))) $ >
  $ wceq V (cmpt f2 (cword cr) (csu j (co c1 (cfv (cv f2) chash) cfzo) (cif (wne (cfv (cv j) (cfv (cv f2) T)) (cfv (co (cv j) c1 cmin) (cfv (cv f2) T))) c1 cc0))) $ >
  $ wceq N (cfv F chash) $ >
  $ wi (wa (wa (wcel F (cdif (cword cr) (csn c0))) (wne (cfv cc0 F) cc0)) (wceq (cfv (co N c1 cmin) F) cc0)) (wceq (cfv (co N c1 cmin) (cfv F T)) (cfv (co N c2 cmin) (cfv F T))) $;

--| The value of ` V ` , which represents the number of times the sign changes in a word. (Contributed by Thierry Arnoux, 7-Oct-2018.)
theorem signsvvfval {f2 i j n a b: setvar} (c_pd: class f2 i j n) (T: class i j n a b) (F: class a b) (V: class f2 i j n a b) (W: class j a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wceq T (cmpt f2 (cword cr) (cmpt n (co cc0 (cfv (cv f2) chash) cfzo) (co W (cmpt i (co cc0 (cv n) cfz) (cfv (cfv (cv i) (cv f2)) csgn)) cgsu))) $ >
  $ wceq V (cmpt f2 (cword cr) (csu j (co c1 (cfv (cv f2) chash) cfzo) (cif (wne (cfv (cv j) (cfv (cv f2) T)) (cfv (co (cv j) c1 cmin) (cfv (cv f2) T))) c1 cc0))) $ >
  $ wi (wcel F (cword cr)) (wceq (cfv F V) (csu j (co c1 (cfv F chash) cfzo) (cif (wne (cfv (cv j) (cfv F T)) (cfv (co (cv j) c1 cmin) (cfv F T))) c1 cc0))) $;

--| ` V ` is a function. (Contributed by Thierry Arnoux, 8-Oct-2018.)
theorem signsvvf {f2 i j n a b: setvar} (c_pd: class f2 i j n) (T: class i j n a b) (V: class f2 i j n a b) (W: class j a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wceq T (cmpt f2 (cword cr) (cmpt n (co cc0 (cfv (cv f2) chash) cfzo) (co W (cmpt i (co cc0 (cv n) cfz) (cfv (cfv (cv i) (cv f2)) csgn)) cgsu))) $ >
  $ wceq V (cmpt f2 (cword cr) (csu j (co c1 (cfv (cv f2) chash) cfzo) (cif (wne (cfv (cv j) (cfv (cv f2) T)) (cfv (co (cv j) c1 cmin) (cfv (cv f2) T))) c1 cc0))) $ >
  $ wf (cword cr) cn0 V $;

--| There is no change of sign in the empty word. (Contributed by Thierry Arnoux, 8-Oct-2018.)
theorem signsvf0 {f2 i j n a b: setvar} (c_pd: class f2 i j n) (T: class i j n a b) (V: class f2 i j n a b) (W: class j a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wceq T (cmpt f2 (cword cr) (cmpt n (co cc0 (cfv (cv f2) chash) cfzo) (co W (cmpt i (co cc0 (cv n) cfz) (cfv (cfv (cv i) (cv f2)) csgn)) cgsu))) $ >
  $ wceq V (cmpt f2 (cword cr) (csu j (co c1 (cfv (cv f2) chash) cfzo) (cif (wne (cfv (cv j) (cfv (cv f2) T)) (cfv (co (cv j) c1 cmin) (cfv (cv f2) T))) c1 cc0))) $ >
  $ wceq (cfv c0 V) cc0 $;

--| In a single-letter word, which represents a constant polynomial, there is no change of sign. (Contributed by Thierry Arnoux, 8-Oct-2018.)
theorem signsvf1 {f2 i j n a b: setvar} (c_pd: class f2 i j n) (T: class i j n a b) (K: class a b) (V: class f2 i j n a b) (W: class j a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wceq T (cmpt f2 (cword cr) (cmpt n (co cc0 (cfv (cv f2) chash) cfzo) (co W (cmpt i (co cc0 (cv n) cfz) (cfv (cfv (cv i) (cv f2)) csgn)) cgsu))) $ >
  $ wceq V (cmpt f2 (cword cr) (csu j (co c1 (cfv (cv f2) chash) cfzo) (cif (wne (cfv (cv j) (cfv (cv f2) T)) (cfv (co (cv j) c1 cmin) (cfv (cv f2) T))) c1 cc0))) $ >
  $ wi (wcel K cr) (wceq (cfv (cs1 K) V) cc0) $;

--| Number of changes in a word compared to a shorter word. (Contributed by Thierry Arnoux, 12-Oct-2018.)
theorem signsvfn {f2 i j n a b: setvar} (c_pd: class f2 i j n) (T: class i) (F K: class) (V: class f2 i j n a b) (W: class j a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wceq T (cmpt f2 (cword cr) (cmpt n (co cc0 (cfv (cv f2) chash) cfzo) (co W (cmpt i (co cc0 (cv n) cfz) (cfv (cfv (cv i) (cv f2)) csgn)) cgsu))) $ >
  $ wceq V (cmpt f2 (cword cr) (csu j (co c1 (cfv (cv f2) chash) cfzo) (cif (wne (cfv (cv j) (cfv (cv f2) T)) (cfv (co (cv j) c1 cmin) (cfv (cv f2) T))) c1 cc0))) $ >
  $ wi (wa (wa (wcel F (cdif (cword cr) (csn c0))) (wne (cfv cc0 F) cc0)) (wcel K cr)) (wceq (cfv (co F (cs1 K) cconcat) V) (co (cfv F V) (cif (wbr (co (cfv (co (cfv F chash) c1 cmin) (cfv F T)) K cmul) cc0 clt) c1 cc0) caddc)) $;

--| Adding a letter of the same sign as the highest coefficient does not change the sign. (Contributed by Thierry Arnoux, 12-Oct-2018.)
theorem signsvtp {f2 i j n a b: setvar} (ph: wff f2 i j n a b) (A2: class) (B2: class f2 i j n a b) (c_pd: class f2 i j n) (T: class i) (E: class) (F: class j a b) (N V: class f2 i j n a b) (W: class j a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wceq T (cmpt f2 (cword cr) (cmpt n (co cc0 (cfv (cv f2) chash) cfzo) (co W (cmpt i (co cc0 (cv n) cfz) (cfv (cfv (cv i) (cv f2)) csgn)) cgsu))) $ >
  $ wceq V (cmpt f2 (cword cr) (csu j (co c1 (cfv (cv f2) chash) cfzo) (cif (wne (cfv (cv j) (cfv (cv f2) T)) (cfv (co (cv j) c1 cmin) (cfv (cv f2) T))) c1 cc0))) $ >
  $ wi ph (wcel E (cdif (cword cr) (csn c0))) $ >
  $ wi ph (wne (cfv cc0 E) cc0) $ >
  $ wi ph (wceq F (co E (cs1 A2) cconcat)) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wceq N (cfv E chash) $ >
  $ wceq B2 (cfv (co N c1 cmin) (cfv E T)) $ >
  $ wi (wa ph (wbr cc0 (co A2 B2 cmul) clt)) (wceq (cfv F V) (cfv E V)) $;

--| Adding a letter of a different sign as the highest coefficient changes the sign. (Contributed by Thierry Arnoux, 12-Oct-2018.)
theorem signsvtn {f2 i j n a b: setvar} (ph: wff f2 i j n a b) (A2: class) (B2: class f2 i j n a b) (c_pd: class f2 i j n) (T: class i) (E: class) (F: class j a b) (N V: class f2 i j n a b) (W: class j a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wceq T (cmpt f2 (cword cr) (cmpt n (co cc0 (cfv (cv f2) chash) cfzo) (co W (cmpt i (co cc0 (cv n) cfz) (cfv (cfv (cv i) (cv f2)) csgn)) cgsu))) $ >
  $ wceq V (cmpt f2 (cword cr) (csu j (co c1 (cfv (cv f2) chash) cfzo) (cif (wne (cfv (cv j) (cfv (cv f2) T)) (cfv (co (cv j) c1 cmin) (cfv (cv f2) T))) c1 cc0))) $ >
  $ wi ph (wcel E (cdif (cword cr) (csn c0))) $ >
  $ wi ph (wne (cfv cc0 E) cc0) $ >
  $ wi ph (wceq F (co E (cs1 A2) cconcat)) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wceq N (cfv E chash) $ >
  $ wceq B2 (cfv (co N c1 cmin) (cfv E T)) $ >
  $ wi (wa ph (wbr (co A2 B2 cmul) cc0 clt)) (wceq (co (cfv F V) (cfv E V) cmin) c1) $;

--| Adding a letter of the same sign as the highest coefficient does not change the sign. (Contributed by Thierry Arnoux, 12-Oct-2018.)
theorem signsvfpn {f2 i j n a b: setvar} (ph: wff f2 i j n a b) (A2: class) (B2: class f2 i j n a b) (c_pd: class f2 i j n) (T: class i) (E: class) (F: class j a b) (N: class j) (V: class f2 i j n a b) (W: class j a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wceq T (cmpt f2 (cword cr) (cmpt n (co cc0 (cfv (cv f2) chash) cfzo) (co W (cmpt i (co cc0 (cv n) cfz) (cfv (cfv (cv i) (cv f2)) csgn)) cgsu))) $ >
  $ wceq V (cmpt f2 (cword cr) (csu j (co c1 (cfv (cv f2) chash) cfzo) (cif (wne (cfv (cv j) (cfv (cv f2) T)) (cfv (co (cv j) c1 cmin) (cfv (cv f2) T))) c1 cc0))) $ >
  $ wi ph (wcel E (cdif (cword cr) (csn c0))) $ >
  $ wi ph (wne (cfv cc0 E) cc0) $ >
  $ wi ph (wceq F (co E (cs1 A2) cconcat)) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wceq N (cfv E chash) $ >
  $ wceq B2 (cfv (co N c1 cmin) E) $ >
  $ wi (wa ph (wbr cc0 (co B2 A2 cmul) clt)) (wceq (cfv F V) (cfv E V)) $;

--| Adding a letter of a different sign as the highest coefficient changes the sign. (Contributed by Thierry Arnoux, 12-Oct-2018.)
theorem signsvfnn {f2 i j n a b: setvar} (ph: wff f2 i j n a b) (A2: class) (B2: class f2 i j n a b) (c_pd: class f2 i j n) (T: class i) (E: class) (F: class j a b) (N: class j) (V: class f2 i j n a b) (W: class j a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wceq T (cmpt f2 (cword cr) (cmpt n (co cc0 (cfv (cv f2) chash) cfzo) (co W (cmpt i (co cc0 (cv n) cfz) (cfv (cfv (cv i) (cv f2)) csgn)) cgsu))) $ >
  $ wceq V (cmpt f2 (cword cr) (csu j (co c1 (cfv (cv f2) chash) cfzo) (cif (wne (cfv (cv j) (cfv (cv f2) T)) (cfv (co (cv j) c1 cmin) (cfv (cv f2) T))) c1 cc0))) $ >
  $ wi ph (wcel E (cdif (cword cr) (csn c0))) $ >
  $ wi ph (wne (cfv cc0 E) cc0) $ >
  $ wi ph (wceq F (co E (cs1 A2) cconcat)) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wceq N (cfv E chash) $ >
  $ wceq B2 (cfv (co N c1 cmin) E) $ >
  $ wi (wa ph (wbr (co B2 A2 cmul) cc0 clt)) (wceq (co (cfv F V) (cfv E V) cmin) c1) $;

--| Adding a zero as the highest coefficient does not change the parity of the sign changes. (Contributed by Thierry Arnoux, 12-Oct-2018.)
theorem signlem0 {f2 i j n a b: setvar} (c_pd: class f2 i j n) (T: class i) (F: class) (V: class f2 i j n a b) (W: class j a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wceq T (cmpt f2 (cword cr) (cmpt n (co cc0 (cfv (cv f2) chash) cfzo) (co W (cmpt i (co cc0 (cv n) cfz) (cfv (cfv (cv i) (cv f2)) csgn)) cgsu))) $ >
  $ wceq V (cmpt f2 (cword cr) (csu j (co c1 (cfv (cv f2) chash) cfzo) (cif (wne (cfv (cv j) (cfv (cv f2) T)) (cfv (co (cv j) c1 cmin) (cfv (cv f2) T))) c1 cc0))) $ >
  $ wi (wa (wcel F (cdif (cword cr) (csn c0))) (wne (cfv cc0 F) cc0)) (wceq (cfv (co F (cs1 cc0) cconcat) V) (cfv F V)) $;

--| ` H ` , corresponding to the word ` F ` multiplied by ` ( x - C ) ` , as a function. (Contributed by Thierry Arnoux, 29-Sep-2018.)
theorem signshf {f2 i j n a b: setvar} (C: class f2 i j n a b) (c_pd: class f2 i j n) (T: class f2 i j n a b) (F: class j a b) (H V: class f2 i j n a b) (W: class j a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wceq T (cmpt f2 (cword cr) (cmpt n (co cc0 (cfv (cv f2) chash) cfzo) (co W (cmpt i (co cc0 (cv n) cfz) (cfv (cfv (cv i) (cv f2)) csgn)) cgsu))) $ >
  $ wceq V (cmpt f2 (cword cr) (csu j (co c1 (cfv (cv f2) chash) cfzo) (cif (wne (cfv (cv j) (cfv (cv f2) T)) (cfv (co (cv j) c1 cmin) (cfv (cv f2) T))) c1 cc0))) $ >
  $ wceq H (co (co (cs1 cc0) F cconcat) (co (co F (cs1 cc0) cconcat) C (cofc cmul)) (cof cmin)) $ >
  $ wi (wa (wcel F (cword cr)) (wcel C crp)) (wf (co cc0 (co (cfv F chash) c1 caddc) cfzo) cr H) $;

--| ` H ` , corresponding to the word ` F ` multiplied by ` ( x - C ) ` , is a word. (Contributed by Thierry Arnoux, 29-Sep-2018.)
theorem signshwrd {f2 i j n a b: setvar} (C: class f2 i j n a b) (c_pd: class f2 i j n) (T: class f2 i j n a b) (F: class j a b) (H V: class f2 i j n a b) (W: class j a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wceq T (cmpt f2 (cword cr) (cmpt n (co cc0 (cfv (cv f2) chash) cfzo) (co W (cmpt i (co cc0 (cv n) cfz) (cfv (cfv (cv i) (cv f2)) csgn)) cgsu))) $ >
  $ wceq V (cmpt f2 (cword cr) (csu j (co c1 (cfv (cv f2) chash) cfzo) (cif (wne (cfv (cv j) (cfv (cv f2) T)) (cfv (co (cv j) c1 cmin) (cfv (cv f2) T))) c1 cc0))) $ >
  $ wceq H (co (co (cs1 cc0) F cconcat) (co (co F (cs1 cc0) cconcat) C (cofc cmul)) (cof cmin)) $ >
  $ wi (wa (wcel F (cword cr)) (wcel C crp)) (wcel H (cword cr)) $;

--| Length of ` H ` , corresponding to the word ` F ` multiplied by ` ( x - C ) ` . (Contributed by Thierry Arnoux, 14-Oct-2018.)
theorem signshlen {f2 i j n a b: setvar} (C: class f2 i j n a b) (c_pd: class f2 i j n) (T: class f2 i j n a b) (F: class j a b) (H V: class f2 i j n a b) (W: class j a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wceq T (cmpt f2 (cword cr) (cmpt n (co cc0 (cfv (cv f2) chash) cfzo) (co W (cmpt i (co cc0 (cv n) cfz) (cfv (cfv (cv i) (cv f2)) csgn)) cgsu))) $ >
  $ wceq V (cmpt f2 (cword cr) (csu j (co c1 (cfv (cv f2) chash) cfzo) (cif (wne (cfv (cv j) (cfv (cv f2) T)) (cfv (co (cv j) c1 cmin) (cfv (cv f2) T))) c1 cc0))) $ >
  $ wceq H (co (co (cs1 cc0) F cconcat) (co (co F (cs1 cc0) cconcat) C (cofc cmul)) (cof cmin)) $ >
  $ wi (wa (wcel F (cword cr)) (wcel C crp)) (wceq (cfv H chash) (co (cfv F chash) c1 caddc)) $;

--| ` H ` is not the empty word. (Contributed by Thierry Arnoux, 14-Oct-2018.)
theorem signshnz {f2 i j n a b: setvar} (C: class f2 i j n a b) (c_pd: class f2 i j n) (T: class f2 i j n a b) (F: class j a b) (H V: class f2 i j n a b) (W: class j a b):
  $ wceq c_pd (cmpo a b (ctp (cneg c1) cc0 c1) (ctp (cneg c1) cc0 c1) (cif (wceq (cv b) cc0) (cv a) (cv b))) $ >
  $ wceq W (cpr (cop (cfv cnx cbs) (ctp (cneg c1) cc0 c1)) (cop (cfv cnx cplusg) c_pd)) $ >
  $ wceq T (cmpt f2 (cword cr) (cmpt n (co cc0 (cfv (cv f2) chash) cfzo) (co W (cmpt i (co cc0 (cv n) cfz) (cfv (cfv (cv i) (cv f2)) csgn)) cgsu))) $ >
  $ wceq V (cmpt f2 (cword cr) (csu j (co c1 (cfv (cv f2) chash) cfzo) (cif (wne (cfv (cv j) (cfv (cv f2) T)) (cfv (co (cv j) c1 cmin) (cfv (cv f2) T))) c1 cc0))) $ >
  $ wceq H (co (co (cs1 cc0) F cconcat) (co (co F (cs1 cc0) cconcat) C (cofc cmul)) (cof cmin)) $ >
  $ wi (wa (wcel F (cword cr)) (wcel C crp)) (wne H c0) $;

--| The identity function is integrable on any closed interval. (Contributed by Thierry Arnoux, 13-Dec-2021.)
theorem iblidicc {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel (cmpt x3 (co A2 B2 cicc) (cv x3)) cibl) $;

--| Continuity of the real positive square root function. (Contributed by Thierry Arnoux, 20-Dec-2021.)
theorem rpsqrtcn:
  $ wcel (cres csqrt crp) (co crp crp ccncf) $;

--| A real number divided by its square root. (Contributed by Thierry Arnoux, 1-Jan-2022.)
theorem divsqrtid (A2: class):
  $ wi (wcel A2 crp) (wceq (co A2 (cfv A2 csqrt) cdiv) (cfv A2 csqrt)) $;

--| The power function on complex numbers, for fixed exponent A, is continuous. Similar to ~ cxpcn . (Contributed by Thierry Arnoux, 20-Dec-2021.)
theorem cxpcncf1 {x3: setvar} (ph: wff) (A2 D: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wss D (cdif cc (co cmnf cc0 cioc))) $ >
  $ wi ph (wcel (cmpt x3 D (co (cv x3) A2 ccxp)) (co D cc ccncf)) $;

--| Multiplying by ` ( _i x. ( 2 x. _pi ) ) ` and taking the exponential preserves continuity. (Contributed by Thierry Arnoux, 13-Dec-2021.)
theorem efmul2picn {x3: setvar} (ph: wff) (A2: class) (B2: class x3):
  $ wi ph (wcel (cmpt x3 A2 B2) (co A2 cc ccncf)) $ >
  $ wi ph (wcel (cmpt x3 A2 (cfv (co (co ci (co c2 cpi cmul) cmul) B2 cmul) ce)) (co A2 cc ccncf)) $;

--| Lemma for ~ ftc2re . (Contributed by Thierry Arnoux, 20-Dec-2021.)
theorem fct2relem (ph: wff) (A2 B2 C D E: class):
  $ wceq E (co C D cioo) $ >
  $ wi ph (wcel A2 E) $ >
  $ wi ph (wcel B2 E) $ >
  $ wi ph (wss (co A2 B2 cicc) E) $;

--| The Fundamental Theorem of Calculus, part two, for functions continuous on ` D ` . (Contributed by Thierry Arnoux, 1-Dec-2021.)
theorem ftc2re {t: setvar} (ph: wff) (A2 B2: class) (C D E: class t) (F: class):
  $ wceq E (co C D cioo) $ >
  $ wi ph (wcel A2 E) $ >
  $ wi ph (wcel B2 E) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wi ph (wf E cc F) $ >
  $ wi ph (wcel (co cr F cdv) (co E cc ccncf)) $ >
  $ wi ph (wceq (citg t (co A2 B2 cioo) (cfv (cv t) (co cr F cdv))) (co (cfv B2 F) (cfv A2 F) cmin)) $;

--| Functions with a positive derivative, i.e. monotonously growing functions, preserve strict ordering. (Contributed by Thierry Arnoux, 20-Dec-2021.)
theorem fdvposlt {x3: setvar} (ph: wff) (A2 B2: class) (C D: class x3) (E F: class):
  $ wceq E (co C D cioo) $ >
  $ wi ph (wcel A2 E) $ >
  $ wi ph (wcel B2 E) $ >
  $ wi ph (wf E cr F) $ >
  $ wi ph (wcel (co cr F cdv) (co E cr ccncf)) $ >
  $ wi ph (wbr A2 B2 clt) $ >
  $ wi (wa ph (wcel (cv x3) (co A2 B2 cioo))) (wbr cc0 (cfv (cv x3) (co cr F cdv)) clt) $ >
  $ wi ph (wbr (cfv A2 F) (cfv B2 F) clt) $;

--| Functions with a negative derivative, i.e. monotonously decreasing functions, inverse strict ordering. (Contributed by Thierry Arnoux, 20-Dec-2021.)
theorem fdvneggt {x3: setvar} (ph: wff) (A2 B2: class) (C D: class x3) (E F: class):
  $ wceq E (co C D cioo) $ >
  $ wi ph (wcel A2 E) $ >
  $ wi ph (wcel B2 E) $ >
  $ wi ph (wf E cr F) $ >
  $ wi ph (wcel (co cr F cdv) (co E cr ccncf)) $ >
  $ wi ph (wbr A2 B2 clt) $ >
  $ wi (wa ph (wcel (cv x3) (co A2 B2 cioo))) (wbr (cfv (cv x3) (co cr F cdv)) cc0 clt) $ >
  $ wi ph (wbr (cfv B2 F) (cfv A2 F) clt) $;

--| Functions with a nonnegative derivative, i.e. monotonously growing functions, preserve ordering. (Contributed by Thierry Arnoux, 20-Dec-2021.)
theorem fdvposle {x3: setvar} (ph: wff) (A2 B2: class) (C D: class x3) (E F: class):
  $ wceq E (co C D cioo) $ >
  $ wi ph (wcel A2 E) $ >
  $ wi ph (wcel B2 E) $ >
  $ wi ph (wf E cr F) $ >
  $ wi ph (wcel (co cr F cdv) (co E cr ccncf)) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wi (wa ph (wcel (cv x3) (co A2 B2 cioo))) (wbr cc0 (cfv (cv x3) (co cr F cdv)) cle) $ >
  $ wi ph (wbr (cfv A2 F) (cfv B2 F) cle) $;

--| Functions with a nonpositive derivative, i.e., decreasing functions, preserve ordering. (Contributed by Thierry Arnoux, 20-Dec-2021.)
theorem fdvnegge {x3: setvar} (ph: wff) (A2 B2: class) (C D: class x3) (E F: class):
  $ wceq E (co C D cioo) $ >
  $ wi ph (wcel A2 E) $ >
  $ wi ph (wcel B2 E) $ >
  $ wi ph (wf E cr F) $ >
  $ wi ph (wcel (co cr F cdv) (co E cr ccncf)) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wi (wa ph (wcel (cv x3) (co A2 B2 cioo))) (wbr (cfv (cv x3) (co cr F cdv)) cc0 cle) $ >
  $ wi ph (wbr (cfv B2 F) (cfv A2 F) cle) $;

--| A product of three factors, indexed starting with zero. (Contributed by Thierry Arnoux, 14-Dec-2021.)
theorem prodfzo03 {k: setvar} (ph: wff) (A2 B2 C: class) (D: class k):
  $ wi (wceq (cv k) cc0) (wceq D A2) $ >
  $ wi (wceq (cv k) c1) (wceq D B2) $ >
  $ wi (wceq (cv k) c2) (wceq D C) $ >
  $ wi (wa ph (wcel (cv k) (co cc0 c3 cfzo))) (wcel D cc) $ >
  $ wi ph (wceq (cprod k (co cc0 c3 cfzo) D) (co A2 (co B2 C cmul) cmul)) $;

--| The action ` F ` of extending function from ` B ` to ` C ` with new values at point ` I ` is a bijection. (Contributed by Thierry Arnoux, 9-Dec-2021.)
theorem actfunsnf1o {x3 k: setvar} (ph: wff x3) (A2: class k) (B2 C F: class x3 k) (I: class) (V: class x3 k):
  $ wi (wa ph (wcel (cv k) C)) (wss A2 (co C B2 cmap)) $ >
  $ wi ph (wcel C cvv) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wn (wcel I B2)) $ >
  $ wceq F (cmpt x3 A2 (cun (cv x3) (csn (cop I (cv k))))) $ >
  $ wi (wa ph (wcel (cv k) C)) (wf1o A2 (crn F) F) $;

--| The action ` F ` of extending function from ` B ` to ` C ` with new values at point ` I ` yields different functions. (Contributed by Thierry Arnoux, 9-Dec-2021.)
theorem actfunsnrndisj {x3 k: setvar} (ph: wff x3) (A2: class k) (B2 C F: class x3 k) (I: class) (V: class x3 k):
  $ wi (wa ph (wcel (cv k) C)) (wss A2 (co C B2 cmap)) $ >
  $ wi ph (wcel C cvv) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wn (wcel I B2)) $ >
  $ wceq F (cmpt x3 A2 (cun (cv x3) (csn (cop I (cv k))))) $ >
  $ wi ph (wdisj k C (crn F)) $;

--| The basis for the circle method in the form of trigonometric sums. Proposition of [Nathanson] p. 123. (Contributed by Thierry Arnoux, 2-Dec-2021.)
theorem itgexpif {x3: setvar} (N: class):
  $ wi (wcel N cz) (wceq (citg x3 (co cc0 c1 cioo) (cfv (co (co ci (co c2 cpi cmul) cmul) (co N (cv x3) cmul) cmul) ce)) (cif (wceq N cc0) c1 cc0)) $;

--| Lemma for ~ breprexp - Re-index a double sum, using difference of the initial indices. (Contributed by Thierry Arnoux, 7-Dec-2021.)
theorem fsum2dsub {i j k: setvar} (ph: wff) (A2: class i j) (B2: class j k) (M N: class):
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi (wceq (cv i) (co (cv k) (cv j) cmin)) (wceq A2 B2) $ >
  $ wi (w3a ph (wcel (cv i) (cfv (cneg (cv j)) cuz)) (wcel (cv j) (co c1 N cfz))) (wcel A2 cc) $ >
  $ wi (wa (wa ph (wcel (cv j) (co c1 N cfz))) (wcel (cv k) (co (co (co M (cv j) caddc) c1 caddc) (co M N caddc) cfz))) (wceq B2 cc0) $ >
  $ wi (wa (wa ph (wcel (cv j) (co c1 N cfz))) (wcel (cv k) (co cc0 (cv j) cfzo))) (wceq B2 cc0) $ >
  $ wi ph (wceq (csu i (co cc0 M cfz) (csu j (co c1 N cfz) A2)) (csu k (co cc0 (co M N caddc) cfz) (csu j (co c1 N cfz) B2))) $;

--| Representations of a number as a sum of nonnegative integers.
term crepr: class;

--| The representations of a nonnegative ` m ` as the sum of ` s ` nonnegative integers from a set ` b ` . Cf. Definition of [Nathanson] p. 123. (Contributed by Thierry Arnoux, 1-Dec-2021.)
axiom df_repr {m s1 a b c: setvar}:
  $ wceq crepr (cmpt s1 cn0 (cmpo b m (cpw cn) cz (crab c (wceq (csu a (co cc0 (cv s1) cfzo) (cfv (cv a) (cv c))) (cv m)) (co (cv b) (co cc0 (cv s1) cfzo) cmap)))) $;

--| Value of the representations of ` M ` as the sum of ` S ` nonnegative integers in a given set ` A ` . (Contributed by Thierry Arnoux, 1-Dec-2021.)
theorem reprval {a c: setvar} (ph: wff a) (A2: class a) (S: class) (M: class a):
  $ wi ph (wss A2 cn) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel S cn0) $ >
  $ wi ph (wceq (co A2 M (cfv S crepr)) (crab c (wceq (csu a (co cc0 S cfzo) (cfv (cv a) (cv c))) M) (co A2 (co cc0 S cfzo) cmap))) $;

--| There is exactly one representation with no elements (an empty sum), only for ` M = 0 ` . (Contributed by Thierry Arnoux, 2-Dec-2021.)
theorem repr0 (ph: wff) (A2 S M: class):
  $ wi ph (wss A2 cn) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel S cn0) $ >
  $ wi ph (wceq (co A2 M (cfv cc0 crepr)) (cif (wceq M cc0) (csn c0) c0)) $;

--| Members of the representation of ` M ` as the sum of ` S ` nonnegative integers from set ` A ` as functions. (Contributed by Thierry Arnoux, 5-Dec-2021.)
theorem reprf (ph: wff) (A2 C S M: class):
  $ wi ph (wss A2 cn) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel S cn0) $ >
  $ wi ph (wcel C (co A2 M (cfv S crepr))) $ >
  $ wi ph (wf (co cc0 S cfzo) A2 C) $;

--| Sums of values of the members of the representation of ` M ` equal ` M ` . (Contributed by Thierry Arnoux, 5-Dec-2021.)
theorem reprsum {a: setvar} (ph: wff a) (A2: class a) (C S: class) (M: class a):
  $ wi ph (wss A2 cn) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel S cn0) $ >
  $ wi ph (wcel C (co A2 M (cfv S crepr))) $ >
  $ wi ph (wceq (csu a (co cc0 S cfzo) (cfv (cv a) C)) M) $;

--| Upper bound to the terms in the representations of ` M ` as the sum of ` S ` nonnegative integers from set ` A ` . (Contributed by Thierry Arnoux, 27-Dec-2021.)
theorem reprle (ph: wff) (A2 C S M X: class):
  $ wi ph (wss A2 cn) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel S cn0) $ >
  $ wi ph (wcel C (co A2 M (cfv S crepr))) $ >
  $ wi ph (wcel X (co cc0 S cfzo)) $ >
  $ wi ph (wbr (cfv X C) M cle) $;

--| Express the representations recursively. (Contributed by Thierry Arnoux, 5-Dec-2021.)
theorem reprsuc {b c: setvar} (ph: wff) (A2 S: class) (F: class b c) (M: class):
  $ wi ph (wss A2 cn) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel S cn0) $ >
  $ wceq F (cmpt c (co A2 (co M (cv b) cmin) (cfv S crepr)) (cun (cv c) (csn (cop S (cv b))))) $ >
  $ wi ph (wceq (co A2 M (cfv (co S c1 caddc) crepr)) (ciun b A2 (crn F))) $;

--| Bounded representations are finite sets. (Contributed by Thierry Arnoux, 7-Dec-2021.)
theorem reprfi (ph: wff) (A2 S M: class):
  $ wi ph (wss A2 cn) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel S cn0) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wcel (co A2 M (cfv S crepr)) cfn) $;

--| Representations with terms in a subset. (Contributed by Thierry Arnoux, 11-Dec-2021.)
theorem reprss (ph: wff) (A2 B2 S M: class):
  $ wi ph (wss A2 cn) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel S cn0) $ >
  $ wi ph (wss B2 A2) $ >
  $ wi ph (wss (co B2 M (cfv S crepr)) (co A2 M (cfv S crepr))) $;

--| Representations with term in an intersection. (Contributed by Thierry Arnoux, 11-Dec-2021.)
theorem reprinrn {c: setvar} (ph: wff) (A2 B2 S M: class):
  $ wi ph (wss A2 cn) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel S cn0) $ >
  $ wi ph (wb (wcel (cv c) (co (cin A2 B2) M (cfv S crepr))) (wa (wcel (cv c) (co A2 M (cfv S crepr))) (wss (crn (cv c)) B2))) $;

--| There are no representations of ` M ` with more than ` M ` terms. Remark of [Nathanson] p. 123. (Contributed by Thierry Arnoux, 7-Dec-2021.)
theorem reprlt (ph: wff) (A2 S M: class):
  $ wi ph (wss A2 cn) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel S cn0) $ >
  $ wi ph (wbr M S clt) $ >
  $ wi ph (wceq (co A2 M (cfv S crepr)) c0) $;

--| Express a sum of representations over an intersection using a product of the indicator function. (Contributed by Thierry Arnoux, 11-Dec-2021.)
theorem hashreprin {a c: setvar} (ph: wff) (A2 B2 S M: class):
  $ wi ph (wss A2 cn) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel S cn0) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wss B2 cn) $ >
  $ wi ph (wceq (cfv (co (cin A2 B2) M (cfv S crepr)) chash) (csu c (co B2 M (cfv S crepr)) (cprod a (co cc0 S cfzo) (cfv (cfv (cv a) (cv c)) (cfv A2 (cfv cn cind)))))) $;

--| There are no representations of more than ` ( S x. N ) ` with only ` S ` terms bounded by ` N ` . Remark of [Nathanson] p. 123. (Contributed by Thierry Arnoux, 7-Dec-2021.)
theorem reprgt (ph: wff) (A2 S M N: class):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wss A2 (co c1 N cfz)) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel S cn0) $ >
  $ wi ph (wbr (co S N cmul) M clt) $ >
  $ wi ph (wceq (co A2 M (cfv S crepr)) c0) $;

--| For the representation of ` N ` , it is sufficient to consider nonnegative integers up to ` N ` . Remark of [Nathanson] p. 123 (Contributed by Thierry Arnoux, 13-Dec-2021.)
theorem reprinfz1 (ph: wff) (A2 S N: class):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel S cn0) $ >
  $ wi ph (wss A2 cn) $ >
  $ wi ph (wceq (co A2 N (cfv S crepr)) (co (cin A2 (co c1 N cfz)) N (cfv S crepr))) $;

--| Corollary of ~ reprinfz1 . (Contributed by Thierry Arnoux, 15-Dec-2021.)
theorem reprfi2 (ph: wff) (A2 S N: class):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel S cn0) $ >
  $ wi ph (wss A2 cn) $ >
  $ wi ph (wcel (co A2 N (cfv S crepr)) cfn) $;

--| Corollary of ~ reprinfz1 . (Contributed by Thierry Arnoux, 14-Dec-2021.)
theorem reprfz1 (ph: wff) (S N: class):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel S cn0) $ >
  $ wi ph (wceq (co cn N (cfv S crepr)) (co (co c1 N cfz) N (cfv S crepr))) $;

--| Develop the number of representations of an integer ` M ` as a sum of nonnegative integers in set ` A ` . (Contributed by Thierry Arnoux, 14-Dec-2021.)
theorem hashrepr {a c: setvar} (ph: wff) (A2 S M: class):
  $ wi ph (wss A2 cn) $ >
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wcel S cn0) $ >
  $ wi ph (wceq (cfv (co A2 M (cfv S crepr)) chash) (csu c (co cn M (cfv S crepr)) (cprod a (co cc0 S cfzo) (cfv (cfv (cv a) (cv c)) (cfv A2 (cfv cn cind)))))) $;

--| Transposing ` 0 ` and ` X ` maps representations with a condition on the first index to transpositions with the same condition on the index ` X ` . (Contributed by Thierry Arnoux, 27-Dec-2021.)
theorem reprpmtf1o {c: setvar} (ph: wff) (A2 B2 P S T: class) (F: class c) (M: class) (O: class c) (X: class):
  $ wi ph (wcel S cn) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wss A2 cn) $ >
  $ wi ph (wcel X (co cc0 S cfzo)) $ >
  $ wceq O (crab c (wn (wcel (cfv cc0 (cv c)) B2)) (co A2 M (cfv S crepr))) $ >
  $ wceq P (crab c (wn (wcel (cfv X (cv c)) B2)) (co A2 M (cfv S crepr))) $ >
  $ wceq T (cif (wceq X cc0) (cres cid (co cc0 S cfzo)) (cfv (cpr X cc0) (cfv (co cc0 S cfzo) cpmtr))) $ >
  $ wceq F (cmpt c P (ccom (cv c) T)) $ >
  $ wi ph (wf1o P O F) $;

--| Express the representations as a sum of integers in a difference of sets using conditions on each of the indices. (Contributed by Thierry Arnoux, 27-Dec-2021.)
theorem reprdifc {x3 c: setvar} (ph: wff c) (A2 B2: class) (C: class x3 c) (S M: class):
  $ wceq C (crab c (wn (wcel (cfv (cv x3) (cv c)) B2)) (co A2 M (cfv S crepr))) $ >
  $ wi ph (wss A2 cn) $ >
  $ wi ph (wss B2 cn) $ >
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wcel S cn0) $ >
  $ wi ph (wceq (cdif (co A2 M (cfv S crepr)) (co B2 M (cfv S crepr))) (ciun x3 (co cc0 S cfzo) C)) $;

--| Value of the second Chebyshev function, or summatory of the von Mangoldt function. (Contributed by Thierry Arnoux, 28-Dec-2021.)
theorem chpvalz {n: setvar} (N: class):
  $ wi (wcel N cz) (wceq (cfv N cchp) (csu n (co c1 N cfz) (cfv (cv n) cvma))) $;

--| Value of the Chebyshev function for integers. (Contributed by Thierry Arnoux, 28-Dec-2021.)
theorem chtvalz {n: setvar} (N: class):
  $ wi (wcel N cz) (wceq (cfv N ccht) (csu n (cin (co c1 N cfz) cprime) (cfv (cv n) clog))) $;

--| Lemma for ~ breprexp (induction step for weighted sums over representations). (Contributed by Thierry Arnoux, 7-Dec-2021.)
theorem breprexplema {x3 y1 a b d: setvar} (ph: wff) (S L: class) (M N: class x3 y1):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel S cn0) $ >
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wbr M (co (co S c1 caddc) N cmul) cle) $ >
  $ wi (wa (wa ph (wcel (cv x3) (co cc0 (co S c1 caddc) cfzo))) (wcel (cv y1) cn)) (wcel (cfv (cv y1) (cfv (cv x3) L)) cc) $ >
  $ wi ph (wceq (csu d (co (co c1 N cfz) M (cfv (co S c1 caddc) crepr)) (cprod a (co cc0 (co S c1 caddc) cfzo) (cfv (cfv (cv a) (cv d)) (cfv (cv a) L)))) (csu b (co c1 N cfz) (csu d (co (co c1 N cfz) (co M (cv b) cmin) (cfv S crepr)) (co (cprod a (co cc0 S cfzo) (cfv (cfv (cv a) (cv d)) (cfv (cv a) L))) (cfv (cv b) (cfv S L)) cmul)))) $;

--| Lemma for ~ breprexp (closure). (Contributed by Thierry Arnoux, 7-Dec-2021.)
theorem breprexplemb (ph: wff) (S L N X Y Z: class):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel S cn0) $ >
  $ wi ph (wcel Z cc) $ >
  $ wi ph (wf (co cc0 S cfzo) (co cc cn cmap) L) $ >
  $ wi ph (wcel X (co cc0 S cfzo)) $ >
  $ wi ph (wcel Y cn) $ >
  $ wi ph (wcel (cfv Y (cfv X L)) cc) $;

--| Lemma for ~ breprexp (induction step). (Contributed by Thierry Arnoux, 6-Dec-2021.)
theorem breprexplemc {m a b d: setvar} (ph: wff) (S: class b d) (T L N Z: class):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel S cn0) $ >
  $ wi ph (wcel Z cc) $ >
  $ wi ph (wf (co cc0 S cfzo) (co cc cn cmap) L) $ >
  $ wi ph (wcel T cn0) $ >
  $ wi ph (wbr (co T c1 caddc) S cle) $ >
  $ wi ph (wceq (cprod a (co cc0 T cfzo) (csu b (co c1 N cfz) (co (cfv (cv b) (cfv (cv a) L)) (co Z (cv b) cexp) cmul))) (csu m (co cc0 (co T N cmul) cfz) (csu d (co (co c1 N cfz) (cv m) (cfv T crepr)) (co (cprod a (co cc0 T cfzo) (cfv (cfv (cv a) (cv d)) (cfv (cv a) L))) (co Z (cv m) cexp) cmul)))) $ >
  $ wi ph (wceq (cprod a (co cc0 (co T c1 caddc) cfzo) (csu b (co c1 N cfz) (co (cfv (cv b) (cfv (cv a) L)) (co Z (cv b) cexp) cmul))) (csu m (co cc0 (co (co T c1 caddc) N cmul) cfz) (csu d (co (co c1 N cfz) (cv m) (cfv (co T c1 caddc) crepr)) (co (cprod a (co cc0 (co T c1 caddc) cfzo) (cfv (cfv (cv a) (cv d)) (cfv (cv a) L))) (co Z (cv m) cexp) cmul)))) $;

--| Express the ` S ` th power of the finite series in terms of the number of representations of integers ` m ` as sums of ` S ` terms. This is a general formulation which allows logarithmic weighting of the sums (see ~ https://mathoverflow.net/questions/253246) and a mix of different smoothing functions taken into account in ` L ` . See ~ breprexpnat for the simple case presented in the proposition of [Nathanson] p. 123. (Contributed by Thierry Arnoux, 6-Dec-2021.)
theorem breprexp {m a b c: setvar} (ph: wff) (S L N Z: class):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel S cn0) $ >
  $ wi ph (wcel Z cc) $ >
  $ wi ph (wf (co cc0 S cfzo) (co cc cn cmap) L) $ >
  $ wi ph (wceq (cprod a (co cc0 S cfzo) (csu b (co c1 N cfz) (co (cfv (cv b) (cfv (cv a) L)) (co Z (cv b) cexp) cmul))) (csu m (co cc0 (co S N cmul) cfz) (csu c (co (co c1 N cfz) (cv m) (cfv S crepr)) (co (cprod a (co cc0 S cfzo) (cfv (cfv (cv a) (cv c)) (cfv (cv a) L))) (co Z (cv m) cexp) cmul)))) $;

--| Express the ` S ` th power of the finite series in terms of the number of representations of integers ` m ` as sums of ` S ` terms of elements of ` A ` , bounded by ` N ` . Proposition of [Nathanson] p. 123. (Contributed by Thierry Arnoux, 11-Dec-2021.)
theorem breprexpnat {m b: setvar} (ph: wff) (A2: class) (P R: class m b) (S N Z: class):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel S cn0) $ >
  $ wi ph (wcel Z cc) $ >
  $ wi ph (wss A2 cn) $ >
  $ wceq P (csu b (cin A2 (co c1 N cfz)) (co Z (cv b) cexp)) $ >
  $ wceq R (cfv (co (cin A2 (co c1 N cfz)) (cv m) (cfv S crepr)) chash) $ >
  $ wi ph (wceq (co P S cexp) (csu m (co cc0 (co S N cmul) cfz) (co R (co Z (cv m) cexp) cmul))) $;

--| The Vinogradov trigonometric sums.
term cvts: class;

--| Define the Vinogradov trigonometric sums. (Contributed by Thierry Arnoux, 1-Dec-2021.)
axiom df_vts {x3 n a l: setvar}:
  $ wceq cvts (cmpo l n (co cc cn cmap) cn0 (cmpt x3 cc (csu a (co c1 (cv n) cfz) (co (cfv (cv a) (cv l)) (cfv (co (co ci (co c2 cpi cmul) cmul) (co (cv a) (cv x3) cmul) cmul) ce) cmul)))) $;

--| Value of the Vinogradov trigonometric sums. (Contributed by Thierry Arnoux, 1-Dec-2021.)
theorem vtsval {a: setvar} (ph: wff a) (L N X: class):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel X cc) $ >
  $ wi ph (wf cn cc L) $ >
  $ wi ph (wceq (cfv X (co L N cvts)) (csu a (co c1 N cfz) (co (cfv (cv a) L) (cfv (co (co ci (co c2 cpi cmul) cmul) (co (cv a) X cmul) cmul) ce) cmul))) $;

--| Closure of the Vinogradov trigonometric sums. (Contributed by Thierry Arnoux, 14-Dec-2021.)
theorem vtscl (ph: wff) (L N X: class):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel X cc) $ >
  $ wi ph (wf cn cc L) $ >
  $ wi ph (wcel (cfv X (co L N cvts)) cc) $;

--| Express the Vinogradov trigonometric sums to the power of ` S ` (Contributed by Thierry Arnoux, 12-Dec-2021.)
theorem vtsprod {m a c: setvar} (ph: wff) (S L N X: class):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel X cc) $ >
  $ wi ph (wcel S cn0) $ >
  $ wi ph (wf (co cc0 S cfzo) (co cc cn cmap) L) $ >
  $ wi ph (wceq (cprod a (co cc0 S cfzo) (cfv X (co (cfv (cv a) L) N cvts))) (csu m (co cc0 (co S N cmul) cfz) (csu c (co (co c1 N cfz) (cv m) (cfv S crepr)) (co (cprod a (co cc0 S cfzo) (cfv (cfv (cv a) (cv c)) (cfv (cv a) L))) (cfv (co (co ci (co c2 cpi cmul) cmul) (co (cv m) X cmul) cmul) ce) cmul)))) $;

--| The Hardy, Littlewood and Ramanujan Circle Method, in a generic form, with different weighting / smoothing functions. (Contributed by Thierry Arnoux, 13-Dec-2021.)
theorem circlemeth {x3 a c: setvar} (ph: wff) (S L N: class):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel S cn) $ >
  $ wi ph (wf (co cc0 S cfzo) (co cc cn cmap) L) $ >
  $ wi ph (wceq (csu c (co cn N (cfv S crepr)) (cprod a (co cc0 S cfzo) (cfv (cfv (cv a) (cv c)) (cfv (cv a) L)))) (citg x3 (co cc0 c1 cioo) (co (cprod a (co cc0 S cfzo) (cfv (cv x3) (co (cfv (cv a) L) N cvts))) (cfv (co (co ci (co c2 cpi cmul) cmul) (co (cneg N) (cv x3) cmul) cmul) ce) cmul))) $;

--| The Hardy, Littlewood and Ramanujan Circle Method, Chapter 5.1 of [Nathanson] p. 123. This expresses ` R ` , the number of different ways a nonnegative integer ` N ` can be represented as the sum of at most ` S ` integers in the set ` A ` as an integral of Vinogradov trigonometric sums. (Contributed by Thierry Arnoux, 13-Dec-2021.)
theorem circlemethnat {x3: setvar} (A2: class) (R: class x3) (S: class) (F: class x3) (N: class):
  $ wceq R (cfv (co A2 N (cfv S crepr)) chash) $ >
  $ wceq F (cfv (cv x3) (co (cfv A2 (cfv cn cind)) N cvts)) $ >
  $ wcel N cn0 $ >
  $ wss A2 cn $ >
  $ wcel S cn $ >
  $ wceq R (citg x3 (co cc0 c1 cioo) (co (co F S cexp) (cfv (co (co ci (co c2 cpi cmul) cmul) (co (cneg N) (cv x3) cmul) cmul) ce) cmul)) $;

--| The Circle Method, where the Vinogradov sums are weighted using the von Mangoldt function, as it appears as proposition 1.1 of [Helfgott] p. 5. (Contributed by Thierry Arnoux, 13-Dec-2021.)
theorem circlevma {x3 n: setvar} (ph: wff) (N: class):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (csu n (co cn N (cfv c3 crepr)) (co (cfv (cfv cc0 (cv n)) cvma) (co (cfv (cfv c1 (cv n)) cvma) (cfv (cfv c2 (cv n)) cvma) cmul) cmul)) (citg x3 (co cc0 c1 cioo) (co (co (cfv (cv x3) (co cvma N cvts)) c3 cexp) (cfv (co (co ci (co c2 cpi cmul) cmul) (co (cneg N) (cv x3) cmul) cmul) ce) cmul))) $;

--| The circle method, where the Vinogradov sums are weighted using the Von Mangoldt function and smoothed using functions ` H ` and ` K ` . Statement 7.49 of [Helfgott] p. 69. At this point there is no further constraint on the smoothing functions. (Contributed by Thierry Arnoux, 22-Dec-2021.)
theorem circlemethhgt {x3 n: setvar} (ph: wff) (H K N: class):
  $ wi ph (wf cn cr H) $ >
  $ wi ph (wf cn cr K) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (csu n (co cn N (cfv c3 crepr)) (co (co (cfv (cfv cc0 (cv n)) cvma) (cfv (cfv cc0 (cv n)) H) cmul) (co (co (cfv (cfv c1 (cv n)) cvma) (cfv (cfv c1 (cv n)) K) cmul) (co (cfv (cfv c2 (cv n)) cvma) (cfv (cfv c2 (cv n)) K) cmul) cmul) cmul)) (citg x3 (co cc0 c1 cioo) (co (co (cfv (cv x3) (co (co cvma H (cof cmul)) N cvts)) (co (cfv (cv x3) (co (co cvma K (cof cmul)) N cvts)) c2 cexp) cmul) (cfv (co (co ci (co c2 cpi cmul) cmul) (co (cneg N) (cv x3) cmul) cmul) ce) cmul))) $;

--| Statement 7.49 of [Helfgott] p. 70. For a sufficiently big odd ` N ` , this postulates the existence of smoothing functions ` h ` (eta star) and ` k ` (eta plus) such that the lower bound for the circle integral is big enough. (Contributed by Thierry Arnoux, 15-Dec-2021.)
axiom ax_hgt749 {x3 z h k m n: setvar}:
  $ wral n (wi (wbr (co (cdc c1 cc0) (cdc c2 c7) cexp) (cv n) cle) (wrex h (wrex k (w3a (wral m (wbr (cfv (cv m) (cv k)) (co c1 (cdp2 cc0 (cdp2 c7 (cdp2 c9 (cdp2 c9 (cdp2 c5 c5))))) cdp) cle) cn) (wral m (wbr (cfv (cv m) (cv h)) (co c1 (cdp2 c4 (cdp2 c1 c4)) cdp) cle) cn) (wbr (co (co cc0 (cdp2 cc0 (cdp2 cc0 (cdp2 cc0 (cdp2 c4 (cdp2 c2 (cdp2 c2 (cdp2 c4 c8))))))) cdp) (co (cv n) c2 cexp) cmul) (citg x3 (co cc0 c1 cioo) (co (co (cfv (cv x3) (co (co cvma (cv h) (cof cmul)) (cv n) cvts)) (co (cfv (cv x3) (co (co cvma (cv k) (cof cmul)) (cv n) cvts)) c2 cexp) cmul) (cfv (co (co ci (co c2 cpi cmul) cmul) (co (cneg (cv n)) (cv x3) cmul) cmul) ce) cmul)) cle)) (co (co cc0 cpnf cico) cn cmap)) (co (co cc0 cpnf cico) cn cmap))) (crab z (wn (wbr c2 (cv z) cdvds)) cz) $;

--| Theorem 12. of [RosserSchoenfeld] p. 71. Theorem ~ chpo1ubb states that the ` psi ` function is bounded by a linear term; this axiom postulates an upper bound for that linear term. This is stated as an axiom until a formal proof can be provided. (Contributed by Thierry Arnoux, 28-Dec-2021.)
axiom ax_ros335 {x3: setvar}:
  $ wral x3 (wbr (cfv (cv x3) cchp) (co (co c1 (cdp2 cc0 (cdp2 c3 (cdp2 c8 (cdp2 c8 c3)))) cdp) (cv x3) cmul) clt) crp $;

--| Theorem 13. of [RosserSchoenfeld] p. 71. Theorem ~ chpchtlim states that the ` psi ` and ` theta ` function are asymtotic to each other; this axiom postulates an upper bound for their difference. This is stated as an axiom until a formal proof can be provided. (Contributed by Thierry Arnoux, 28-Dec-2021.)
axiom ax_ros336 {x3: setvar}:
  $ wral x3 (wbr (co (cfv (cv x3) cchp) (cfv (cv x3) ccht) cmin) (co (co c1 (cdp2 c4 (cdp2 c2 (cdp2 c6 c2))) cdp) (cfv (cv x3) csqrt) cmul) clt) crp $;

--| An upper bound to the summatory function of the von Mangoldt function. (Contributed by Thierry Arnoux, 29-Dec-2021.)
theorem hgt750lemc {j: setvar} (ph: wff j) (N: class):
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr (csu j (co c1 N cfz) (cfv (cv j) cvma)) (co (co c1 (cdp2 cc0 (cdp2 c3 (cdp2 c8 (cdp2 c8 c3)))) cdp) N cmul) clt) $;

--| An upper bound to the summatory function of the von Mangoldt function on non-primes. (Contributed by Thierry Arnoux, 29-Dec-2021.)
theorem hgt750lemd {i: setvar} (ph: wff) (N: class):
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr (co (cdc c1 cc0) (cdc c2 c7) cexp) N cle) $ >
  $ wi ph (wbr (csu i (cun (cdif (co c1 N cfz) cprime) (csn c2)) (cfv (cv i) cvma)) (co (co c1 (cdp2 c4 (cdp2 c2 (cdp2 c6 c3))) cdp) (cfv N csqrt) cmul) clt) $;

--| A deduction version of ~ ax-hgt749 . (Contributed by Thierry Arnoux, 15-Dec-2021.)
theorem hgt749d {x3 z h k m: setvar} (ph: wff x3 z h k m) (N: class z m) (O: class x3 z h k m):
  $ wceq O (crab z (wn (wbr c2 (cv z) cdvds)) cz) $ >
  $ wi ph (wcel N O) $ >
  $ wi ph (wbr (co (cdc c1 cc0) (cdc c2 c7) cexp) N cle) $ >
  $ wi ph (wrex h (wrex k (w3a (wral m (wbr (cfv (cv m) (cv k)) (co c1 (cdp2 cc0 (cdp2 c7 (cdp2 c9 (cdp2 c9 (cdp2 c5 c5))))) cdp) cle) cn) (wral m (wbr (cfv (cv m) (cv h)) (co c1 (cdp2 c4 (cdp2 c1 c4)) cdp) cle) cn) (wbr (co (co cc0 (cdp2 cc0 (cdp2 cc0 (cdp2 cc0 (cdp2 c4 (cdp2 c2 (cdp2 c2 (cdp2 c4 c8))))))) cdp) (co N c2 cexp) cmul) (citg x3 (co cc0 c1 cioo) (co (co (cfv (cv x3) (co (co cvma (cv h) (cof cmul)) N cvts)) (co (cfv (cv x3) (co (co cvma (cv k) (cof cmul)) N cvts)) c2 cexp) cmul) (cfv (co (co ci (co c2 cpi cmul) cmul) (co (cneg N) (cv x3) cmul) cmul) ce) cmul)) cle)) (co (co cc0 cpnf cico) cn cmap)) (co (co cc0 cpnf cico) cn cmap)) $;

--| Conditions for ` ( ( log ` x ) / ( sqrt ` x ) ) ` to be decreasing. (Contributed by Thierry Arnoux, 20-Dec-2021.)
theorem logdivsqrle (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wbr (cfv c2 ce) A2 cle) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wi ph (wbr (co (cfv B2 clog) (cfv B2 csqrt) cdiv) (co (cfv A2 clog) (cfv A2 csqrt) cdiv) cle) $;

--| Lemma for ~ tgoldbachgtd . (Contributed by Thierry Arnoux, 17-Dec-2021.)
theorem hgt750lem (N: class):
  $ wi (wa (wcel N cn0) (wbr (co (cdc c1 cc0) (cdc c2 c7) cexp) N cle)) (wbr (co (co c7 (cdp2 c3 (cdp2 c4 c8)) cdp) (co (cfv N clog) (cfv N csqrt) cdiv) cmul) (co cc0 (cdp2 cc0 (cdp2 cc0 (cdp2 cc0 (cdp2 c4 (cdp2 c2 (cdp2 c2 (cdp2 c4 c8))))))) cdp) clt) $;

--| Decimal multiplication galore! (Contributed by Thierry Arnoux, 26-Dec-2021.)
theorem hgt750lem2:
  $ wbr (co c3 (co (co (co (co c1 (cdp2 cc0 (cdp2 c7 (cdp2 c9 (cdp2 c9 (cdp2 c5 c5))))) cdp) c2 cexp) (co c1 (cdp2 c4 (cdp2 c1 c4)) cdp) cmul) (co (co c1 (cdp2 c4 (cdp2 c2 (cdp2 c6 c3))) cdp) (co c1 (cdp2 cc0 (cdp2 c3 (cdp2 c8 (cdp2 c8 c3)))) cdp) cmul) cmul) cmul) (co c7 (cdp2 c3 (cdp2 c4 c8)) cdp) clt $;

--| Lemma for the statement 7.50 of [Helfgott] p. 69. (Contributed by Thierry Arnoux, 1-Jan-2022.)
theorem hgt750lemf {m n: setvar} (ph: wff) (A2 P Q: class) (H K: class n):
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wcel P cr) $ >
  $ wi ph (wcel Q cr) $ >
  $ wi ph (wf cn (co cc0 cpnf cico) H) $ >
  $ wi ph (wf cn (co cc0 cpnf cico) K) $ >
  $ wi (wa ph (wcel (cv n) A2)) (wcel (cfv cc0 (cv n)) cn) $ >
  $ wi (wa ph (wcel (cv n) A2)) (wcel (cfv c1 (cv n)) cn) $ >
  $ wi (wa ph (wcel (cv n) A2)) (wcel (cfv c2 (cv n)) cn) $ >
  $ wi (wa ph (wcel (cv m) cn)) (wbr (cfv (cv m) K) P cle) $ >
  $ wi (wa ph (wcel (cv m) cn)) (wbr (cfv (cv m) H) Q cle) $ >
  $ wi ph (wbr (csu n A2 (co (co (cfv (cfv cc0 (cv n)) cvma) (cfv (cfv cc0 (cv n)) H) cmul) (co (co (cfv (cfv c1 (cv n)) cvma) (cfv (cfv c1 (cv n)) K) cmul) (co (cfv (cfv c2 (cv n)) cvma) (cfv (cfv c2 (cv n)) K) cmul) cmul) cmul)) (co (co (co P c2 cexp) Q cmul) (csu n A2 (co (cfv (cfv cc0 (cv n)) cvma) (co (cfv (cfv c1 (cv n)) cvma) (cfv (cfv c2 (cv n)) cvma) cmul) cmul)) cmul) cle) $;

--| Lemma for the statement 7.50 of [Helfgott] p. 69. Applying a permutation ` T ` to the three factors of a product does not change the result. (Contributed by Thierry Arnoux, 1-Jan-2022.)
theorem hgt750lemg {c: setvar} (ph: wff) (R T: class) (F L: class c) (N: class):
  $ wceq F (cmpt c R (ccom (cv c) T)) $ >
  $ wi ph (wf1o (co cc0 c3 cfzo) (co cc0 c3 cfzo) T) $ >
  $ wi ph (wf (co cc0 c3 cfzo) cn N) $ >
  $ wi ph (wf cn cr L) $ >
  $ wi ph (wcel N R) $ >
  $ wi ph (wceq (co (cfv (cfv cc0 (cfv N F)) L) (co (cfv (cfv c1 (cfv N F)) L) (cfv (cfv c2 (cfv N F)) L) cmul) cmul) (co (cfv (cfv cc0 N) L) (co (cfv (cfv c1 N) L) (cfv (cfv c2 N) L) cmul) cmul)) $;

--| Two ways to write the set of odd primes. (Contributed by Thierry Arnoux, 27-Dec-2021.)
theorem oddprm2 {z: setvar} (O: class):
  $ wceq O (crab z (wn (wbr c2 (cv z) cdvds)) cz) $ >
  $ wceq (cdif cprime (csn c2)) (cin O cprime) $;

--| An upper bound on the contribution of the non-prime terms in the Statement 7.50 of [Helfgott] p. 69. (Contributed by Thierry Arnoux, 28-Dec-2021.)
theorem hgt750lemb {z i j n c: setvar} (ph: wff z) (A2 N: class z) (O: class i j n c):
  $ wceq O (crab z (wn (wbr c2 (cv z) cdvds)) cz) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr c2 N cle) $ >
  $ wceq A2 (crab c (wn (wcel (cfv cc0 (cv c)) (cin O cprime))) (co cn N (cfv c3 crepr))) $ >
  $ wi ph (wbr (csu n A2 (co (cfv (cfv cc0 (cv n)) cvma) (co (cfv (cfv c1 (cv n)) cvma) (cfv (cfv c2 (cv n)) cvma) cmul) cmul)) (co (cfv N clog) (co (csu i (cun (cdif (co c1 N cfz) cprime) (csn c2)) (cfv (cv i) cvma)) (csu j (co c1 N cfz) (cfv (cv j) cvma)) cmul) cmul) cle) $;

--| An upper bound on the contribution of the non-prime terms in the Statement 7.50 of [Helfgott] p. 69. (Contributed by Thierry Arnoux, 1-Jan-2022.)
theorem hgt750lema {z n a c d: setvar} (ph: wff z) (A2: class z a) (F: class z a c d) (N: class z) (O: class):
  $ wceq O (crab z (wn (wbr c2 (cv z) cdvds)) cz) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr c2 N cle) $ >
  $ wceq A2 (crab c (wn (wcel (cfv cc0 (cv c)) (cin O cprime))) (co cn N (cfv c3 crepr))) $ >
  $ wceq F (cmpt d (crab c (wn (wcel (cfv (cv a) (cv c)) (cin O cprime))) (co cn N (cfv c3 crepr))) (ccom (cv d) (cif (wceq (cv a) cc0) (cres cid (co cc0 c3 cfzo)) (cfv (cpr (cv a) cc0) (cfv (co cc0 c3 cfzo) cpmtr))))) $ >
  $ wi ph (wbr (csu n (cdif (co cn N (cfv c3 crepr)) (co (cin O cprime) N (cfv c3 crepr))) (co (cfv (cfv cc0 (cv n)) cvma) (co (cfv (cfv c1 (cv n)) cvma) (cfv (cfv c2 (cv n)) cvma) cmul) cmul)) (co c3 (csu n A2 (co (cfv (cfv cc0 (cv n)) cvma) (co (cfv (cfv c1 (cv n)) cvma) (cfv (cfv c2 (cv n)) cvma) cmul) cmul)) cmul) cle) $;

--| An upper bound on the contribution of the non-prime terms in the Statement 7.50 of [Helfgott] p. 69. (Contributed by Thierry Arnoux, 29-Dec-2021.)
theorem hgt750leme {z m n: setvar} (ph: wff z) (H K: class z n) (N: class z) (O: class):
  $ wceq O (crab z (wn (wbr c2 (cv z) cdvds)) cz) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr (co (cdc c1 cc0) (cdc c2 c7) cexp) N cle) $ >
  $ wi ph (wf cn (co cc0 cpnf cico) H) $ >
  $ wi ph (wf cn (co cc0 cpnf cico) K) $ >
  $ wi (wa ph (wcel (cv m) cn)) (wbr (cfv (cv m) K) (co c1 (cdp2 cc0 (cdp2 c7 (cdp2 c9 (cdp2 c9 (cdp2 c5 c5))))) cdp) cle) $ >
  $ wi (wa ph (wcel (cv m) cn)) (wbr (cfv (cv m) H) (co c1 (cdp2 c4 (cdp2 c1 c4)) cdp) cle) $ >
  $ wi ph (wbr (csu n (cdif (co cn N (cfv c3 crepr)) (co (cin O cprime) N (cfv c3 crepr))) (co (co (cfv (cfv cc0 (cv n)) cvma) (cfv (cfv cc0 (cv n)) H) cmul) (co (co (cfv (cfv c1 (cv n)) cvma) (cfv (cfv c1 (cv n)) K) cmul) (co (cfv (cfv c2 (cv n)) cvma) (cfv (cfv c2 (cv n)) K) cmul) cmul) cmul)) (co (co (co c7 (cdp2 c3 (cdp2 c4 c8)) cdp) (co (cfv N clog) (cfv N csqrt) cdiv) cmul) (co N c2 cexp) cmul) cle) $;

--| Lemma for ~ tgoldbachgtd . (Contributed by Thierry Arnoux, 15-Dec-2021.)
theorem tgoldbachgnn {z: setvar} (ph: wff z) (N O: class):
  $ wceq O (crab z (wn (wbr c2 (cv z) cdvds)) cz) $ >
  $ wi ph (wcel N O) $ >
  $ wi ph (wbr (co (cdc c1 cc0) (cdc c2 c7) cexp) N cle) $ >
  $ wi ph (wcel N cn) $;

--| Lemma for ~ tgoldbachgtd . (Contributed by Thierry Arnoux, 15-Dec-2021.)
theorem tgoldbachgtde {x3 z m n: setvar} (ph: wff z) (H K: class z) (N: class) (O: class x3):
  $ wceq O (crab z (wn (wbr c2 (cv z) cdvds)) cz) $ >
  $ wi ph (wcel N O) $ >
  $ wi ph (wbr (co (cdc c1 cc0) (cdc c2 c7) cexp) N cle) $ >
  $ wi ph (wf cn (co cc0 cpnf cico) H) $ >
  $ wi ph (wf cn (co cc0 cpnf cico) K) $ >
  $ wi (wa ph (wcel (cv m) cn)) (wbr (cfv (cv m) K) (co c1 (cdp2 cc0 (cdp2 c7 (cdp2 c9 (cdp2 c9 (cdp2 c5 c5))))) cdp) cle) $ >
  $ wi (wa ph (wcel (cv m) cn)) (wbr (cfv (cv m) H) (co c1 (cdp2 c4 (cdp2 c1 c4)) cdp) cle) $ >
  $ wi ph (wbr (co (co cc0 (cdp2 cc0 (cdp2 cc0 (cdp2 cc0 (cdp2 c4 (cdp2 c2 (cdp2 c2 (cdp2 c4 c8))))))) cdp) (co N c2 cexp) cmul) (citg x3 (co cc0 c1 cioo) (co (co (cfv (cv x3) (co (co cvma H (cof cmul)) N cvts)) (co (cfv (cv x3) (co (co cvma K (cof cmul)) N cvts)) c2 cexp) cmul) (cfv (co (co ci (co c2 cpi cmul) cmul) (co (cneg N) (cv x3) cmul) cmul) ce) cmul)) cle) $ >
  $ wi ph (wbr cc0 (csu n (co (cin O cprime) N (cfv c3 crepr)) (co (co (cfv (cfv cc0 (cv n)) cvma) (cfv (cfv cc0 (cv n)) H) cmul) (co (co (cfv (cfv c1 (cv n)) cvma) (cfv (cfv c1 (cv n)) K) cmul) (co (cfv (cfv c2 (cv n)) cvma) (cfv (cfv c2 (cv n)) K) cmul) cmul) cmul)) clt) $;

--| Lemma for ~ tgoldbachgtd . (Contributed by Thierry Arnoux, 15-Dec-2021.)
theorem tgoldbachgtda {x3 z m: setvar} (ph: wff z) (H K: class z) (N: class) (O: class x3):
  $ wceq O (crab z (wn (wbr c2 (cv z) cdvds)) cz) $ >
  $ wi ph (wcel N O) $ >
  $ wi ph (wbr (co (cdc c1 cc0) (cdc c2 c7) cexp) N cle) $ >
  $ wi ph (wf cn (co cc0 cpnf cico) H) $ >
  $ wi ph (wf cn (co cc0 cpnf cico) K) $ >
  $ wi (wa ph (wcel (cv m) cn)) (wbr (cfv (cv m) K) (co c1 (cdp2 cc0 (cdp2 c7 (cdp2 c9 (cdp2 c9 (cdp2 c5 c5))))) cdp) cle) $ >
  $ wi (wa ph (wcel (cv m) cn)) (wbr (cfv (cv m) H) (co c1 (cdp2 c4 (cdp2 c1 c4)) cdp) cle) $ >
  $ wi ph (wbr (co (co cc0 (cdp2 cc0 (cdp2 cc0 (cdp2 cc0 (cdp2 c4 (cdp2 c2 (cdp2 c2 (cdp2 c4 c8))))))) cdp) (co N c2 cexp) cmul) (citg x3 (co cc0 c1 cioo) (co (co (cfv (cv x3) (co (co cvma H (cof cmul)) N cvts)) (co (cfv (cv x3) (co (co cvma K (cof cmul)) N cvts)) c2 cexp) cmul) (cfv (co (co ci (co c2 cpi cmul) cmul) (co (cneg N) (cv x3) cmul) cmul) ce) cmul)) cle) $ >
  $ wi ph (wbr cc0 (cfv (co (cin O cprime) N (cfv c3 crepr)) chash) clt) $;

--| Odd integers greater than ` ( ; 1 0 ^ ; 2 7 ) ` have at least a representation as a sum of three odd primes. Final statement in section 7.4 of [Helfgott] p. 70. (Contributed by Thierry Arnoux, 15-Dec-2021.)
theorem tgoldbachgtd {z: setvar} (ph: wff z) (N O: class):
  $ wceq O (crab z (wn (wbr c2 (cv z) cdvds)) cz) $ >
  $ wi ph (wcel N O) $ >
  $ wi ph (wbr (co (cdc c1 cc0) (cdc c2 c7) cexp) N cle) $ >
  $ wi ph (wbr cc0 (cfv (co (cin O cprime) N (cfv c3 crepr)) chash) clt) $;

--| Odd integers greater than ` ( ; 1 0 ^ ; 2 7 ) ` have at least a representation as a sum of three odd primes. Final statement in section 7.4 of [Helfgott] p. 70 , expressed using the set ` G ` of odd numbers which can be written as a sum of three odd primes. (Contributed by Thierry Arnoux, 22-Dec-2021.)
theorem tgoldbachgt {z m n r q p: setvar} (G: class z n r q p) (O: class n):
  $ wceq O (crab z (wn (wbr c2 (cv z) cdvds)) cz) $ >
  $ wceq G (crab z (wrex p (wrex q (wrex r (wa (w3a (wcel (cv p) O) (wcel (cv q) O) (wcel (cv r) O)) (wceq (cv z) (co (co (cv p) (cv q) caddc) (cv r) caddc))) cprime) cprime) cprime) O) $ >
  $ wrex m (wa (wbr (cv m) (co (cdc c1 cc0) (cdc c2 c7) cexp) cle) (wral n (wi (wbr (cv m) (cv n) clt) (wcel (cv n) G)) O)) cn $;

--| Extends class notation with the class of geometries fulfilling the planarity axioms.
term cstrkg2d: class;

--| Define the class of geometries fulfilling the lower dimension axiom, Axiom A8 of [Schwabhauser] p. 12, and the upper dimension axiom, Axiom A9 of [Schwabhauser] p. 13, for dimension 2. (Contributed by Thierry Arnoux, 14-Mar-2019.) (New usage is discouraged.)
axiom df_trkg2d {x3 y1 z v u f2 i p d: setvar}:
  $ wceq cstrkg2d (cab f2 (wsbc p (wsbc d (wsbc i (wa (wrex x3 (wrex y1 (wrex z (wn (w3o (wcel (cv z) (co (cv x3) (cv y1) (cv i))) (wcel (cv x3) (co (cv z) (cv y1) (cv i))) (wcel (cv y1) (co (cv x3) (cv z) (cv i))))) (cv p)) (cv p)) (cv p)) (wral x3 (wral y1 (wral z (wral u (wral v (wi (wa (w3a (wceq (co (cv x3) (cv u) (cv d)) (co (cv x3) (cv v) (cv d))) (wceq (co (cv y1) (cv u) (cv d)) (co (cv y1) (cv v) (cv d))) (wceq (co (cv z) (cv u) (cv d)) (co (cv z) (cv v) (cv d)))) (wne (cv u) (cv v))) (w3o (wcel (cv z) (co (cv x3) (cv y1) (cv i))) (wcel (cv x3) (co (cv z) (cv y1) (cv i))) (wcel (cv y1) (co (cv x3) (cv z) (cv i))))) (cv p)) (cv p)) (cv p)) (cv p)) (cv p))) (cfv (cv f2) citv)) (cfv (cv f2) cds)) (cfv (cv f2) cbs))) $;

--| Property of fulfilling dimension 2 axiom. (Contributed by Thierry Arnoux, 29-May-2019.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem istrkg2d {x3 y1 z v u: setvar} (P: class) (G: class x3 y1 z v u) (I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wb (wcel G cstrkg2d) (wa (wcel G cvv) (wa (wrex x3 (wrex y1 (wrex z (wn (w3o (wcel (cv z) (co (cv x3) (cv y1) I)) (wcel (cv x3) (co (cv z) (cv y1) I)) (wcel (cv y1) (co (cv x3) (cv z) I)))) P) P) P) (wral x3 (wral y1 (wral z (wral u (wral v (wi (wa (w3a (wceq (co (cv x3) (cv u) c_mi) (co (cv x3) (cv v) c_mi)) (wceq (co (cv y1) (cv u) c_mi) (co (cv y1) (cv v) c_mi)) (wceq (co (cv z) (cv u) c_mi) (co (cv z) (cv v) c_mi))) (wne (cv u) (cv v))) (w3o (wcel (cv z) (co (cv x3) (cv y1) I)) (wcel (cv x3) (co (cv z) (cv y1) I)) (wcel (cv y1) (co (cv x3) (cv z) I)))) P) P) P) P) P))) $;

--| Alternate version of ~ axtglowdim2 . (Contributed by Thierry Arnoux, 29-May-2019.) (New usage is discouraged.)
theorem axtglowdim2ALTV {x3 y1 z: setvar} (ph: wff x3 y1 z) (P: class) (G: class x3 y1 z) (I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg2d) $ >
  $ wi ph (wrex x3 (wrex y1 (wrex z (wn (w3o (wcel (cv z) (co (cv x3) (cv y1) I)) (wcel (cv x3) (co (cv z) (cv y1) I)) (wcel (cv y1) (co (cv x3) (cv z) I)))) P) P) P) $;

--| Alternate version of ~ axtgupdim2 . (Contributed by Thierry Arnoux, 29-May-2019.) (New usage is discouraged.)
theorem axtgupdim2ALTV (ph: wff) (P U G I c_mi V X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel U P) $ >
  $ wi ph (wcel V P) $ >
  $ wi ph (wne U V) $ >
  $ wi ph (wceq (co X U c_mi) (co X V c_mi)) $ >
  $ wi ph (wceq (co Y U c_mi) (co Y V c_mi)) $ >
  $ wi ph (wceq (co Z U c_mi) (co Z V c_mi)) $ >
  $ wi ph (wcel G cstrkg2d) $ >
  $ wi ph (w3o (wcel Z (co X Y I)) (wcel X (co Z Y I)) (wcel Y (co X Z I))) $;

--| Null angle implies betweenness. (Contributed by SS, 4-Jun-2026.)
theorem cgranbtwn (ph: wff) (A2 B2 C D P E F G I: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) $ >
  $ wi ph (wcel A2 (co B2 C I)) $ >
  $ wi ph (wo (wcel D (co E F I)) (wcel F (co E D I))) $;

--| If ` Z ` is between ` X ` and ` Y ` , or ` Y ` is between ` X ` and ` Z ` , then ` Z ` lies on the line ` X Y ` . (Contributed by SS, 4-Jun-2026.)
theorem btwnlng13 (ph: wff) (P G I L X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wne X Y) $ >
  $ wi ph (wo (wcel Z (co X Y I)) (wcel Y (co X Z I))) $ >
  $ wi ph (wcel Z (co X Y L)) $;

--| Lemma for morley . (Contributed by TA and SS, 4-Jun-2026.)
theorem morleylemrneab (ph: wff) (A2 B2 C P Q c_sm R S G L: class):
  $ wceq S (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq c_sm (cfv G ccgra) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C S) $ >
  $ wi ph (wcel P S) $ >
  $ wi ph (wcel Q S) $ >
  $ wi ph (wcel R S) $ >
  $ wi ph (wn (wo (wcel C (co A2 B2 L)) (wceq A2 B2))) $ >
  $ wi ph (wbr (cs3 C A2 Q) (cs3 Q A2 R) c_sm) $ >
  $ wi ph (wbr (cs3 R A2 B2) (cs3 Q A2 R) c_sm) $ >
  $ wi ph (wbr (cs3 A2 B2 R) (cs3 R B2 P) c_sm) $ >
  $ wi ph (wbr (cs3 P B2 C) (cs3 R B2 P) c_sm) $ >
  $ wi ph (wbr (cs3 B2 C P) (cs3 P C Q) c_sm) $ >
  $ wi ph (wbr (cs3 Q C A2) (cs3 P C Q) c_sm) $ >
  $ wi ph (wn (wcel R (co A2 B2 L))) $;

--| Declare the syntax for the outer five segment configuration.
term cafs: class;

--| The outer five segment configuration is an abbreviation for the conditions of the Five Segment Axiom ( ~ axtg5seg ). See ~ df-ofs . Definition 2.10 of [Schwabhauser] p. 28. (Contributed by Scott Fenton, 21-Sep-2013.) (Revised by Thierry Arnoux, 15-Mar-2019.)
axiom df_afs {x3 y1 z w e f2 g2 h i p a b c d: setvar}:
  $ wceq cafs (cmpt g2 cstrkg (copab e f2 (wsbc p (wsbc h (wsbc i (wrex a (wrex b (wrex c (wrex d (wrex x3 (wrex y1 (wrex z (wrex w (w3a (wceq (cv e) (cop (cop (cv a) (cv b)) (cop (cv c) (cv d)))) (wceq (cv f2) (cop (cop (cv x3) (cv y1)) (cop (cv z) (cv w)))) (w3a (wa (wcel (cv b) (co (cv a) (cv c) (cv i))) (wcel (cv y1) (co (cv x3) (cv z) (cv i)))) (wa (wceq (co (cv a) (cv b) (cv h)) (co (cv x3) (cv y1) (cv h))) (wceq (co (cv b) (cv c) (cv h)) (co (cv y1) (cv z) (cv h)))) (wa (wceq (co (cv a) (cv d) (cv h)) (co (cv x3) (cv w) (cv h))) (wceq (co (cv b) (cv d) (cv h)) (co (cv y1) (cv w) (cv h)))))) (cv p)) (cv p)) (cv p)) (cv p)) (cv p)) (cv p)) (cv p)) (cv p)) (cfv (cv g2) citv)) (cfv (cv g2) cds)) (cfv (cv g2) cbs)))) $;

--| Value of the AFS relation for a given geometry structure. (Contributed by Thierry Arnoux, 20-Mar-2019.)
theorem afsval {x3 y1 z w e f2 a b c d: setvar} (ph: wff x3 y1 z w a b c d) (P: class) (G: class x3 y1 z w a b c d) (I c_mi: class e f2):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wceq (cfv G cafs) (copab e f2 (wrex a (wrex b (wrex c (wrex d (wrex x3 (wrex y1 (wrex z (wrex w (w3a (wceq (cv e) (cop (cop (cv a) (cv b)) (cop (cv c) (cv d)))) (wceq (cv f2) (cop (cop (cv x3) (cv y1)) (cop (cv z) (cv w)))) (w3a (wa (wcel (cv b) (co (cv a) (cv c) I)) (wcel (cv y1) (co (cv x3) (cv z) I))) (wa (wceq (co (cv a) (cv b) c_mi) (co (cv x3) (cv y1) c_mi)) (wceq (co (cv b) (cv c) c_mi) (co (cv y1) (cv z) c_mi))) (wa (wceq (co (cv a) (cv d) c_mi) (co (cv x3) (cv w) c_mi)) (wceq (co (cv b) (cv d) c_mi) (co (cv y1) (cv w) c_mi))))) P) P) P) P) P) P) P) P))) $;

--| Binary relation form of the outer five segment predicate. (Contributed by Scott Fenton, 21-Sep-2013.)
theorem brafs (ph: wff) (A2 B2 C D P G I c_mi O W X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq O (cfv G cafs) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wb (wbr (cop (cop A2 B2) (cop C D)) (cop (cop X Y) (cop Z W)) O) (w3a (wa (wcel B2 (co A2 C I)) (wcel Y (co X Z I))) (wa (wceq (co A2 B2 c_mi) (co X Y c_mi)) (wceq (co B2 C c_mi) (co Y Z c_mi))) (wa (wceq (co A2 D c_mi) (co X W c_mi)) (wceq (co B2 D c_mi) (co Y W c_mi))))) $;

--| Rephrase ~ axtg5seg using the outer five segment predicate. Theorem 2.10 of [Schwabhauser] p. 28. (Contributed by Thierry Arnoux, 23-Mar-2019.)
theorem tg5segofs (ph: wff) (A2 B2 C D P E F G H I c_mi O: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wceq O (cfv G cafs) $ >
  $ wi ph (wcel H P) $ >
  $ wi ph (wcel I P) $ >
  $ wi ph (wbr (cop (cop A2 B2) (cop C D)) (cop (cop E F) (cop H I)) O) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wceq (co C D c_mi) (co H I c_mi)) $;

--| Extend class notation with the ` leftpad ` function.
term clpad: class;

--| Define the ` leftpad ` function. (Contributed by Thierry Arnoux, 7-Aug-2023.)
axiom df_lpad {w c l: setvar}:
  $ wceq clpad (cmpo c w cvv cvv (cmpt l cn0 (co (cxp (co cc0 (co (cv l) (cfv (cv w) chash) cmin) cfzo) (csn (cv c))) (cv w) cconcat))) $;

--| Value of the ` leftpad ` function. (Contributed by Thierry Arnoux, 7-Aug-2023.)
theorem lpadval (ph: wff) (C S L W: class):
  $ wi ph (wcel L cn0) $ >
  $ wi ph (wcel W (cword S)) $ >
  $ wi ph (wcel C S) $ >
  $ wi ph (wceq (cfv L (co C W clpad)) (co (cxp (co cc0 (co L (cfv W chash) cmin) cfzo) (csn C)) W cconcat)) $;

--| Lemma for the ` leftpad ` theorems. (Contributed by Thierry Arnoux, 7-Aug-2023.)
theorem lpadlem1 (ph: wff) (C S L W: class):
  $ wi ph (wcel C S) $ >
  $ wi ph (wcel (cxp (co cc0 (co L (cfv W chash) cmin) cfzo) (csn C)) (cword S)) $;

--| Lemma for ~ lpadlen1 . (Contributed by Thierry Arnoux, 7-Aug-2023.)
theorem lpadlem3 (ph: wff) (C S L W: class):
  $ wi ph (wcel L cn0) $ >
  $ wi ph (wcel W (cword S)) $ >
  $ wi ph (wcel C S) $ >
  $ wi ph (wbr L (cfv W chash) cle) $ >
  $ wi ph (wceq (cxp (co cc0 (co L (cfv W chash) cmin) cfzo) (csn C)) c0) $;

--| Length of a left-padded word, in the case the length of the given word ` W ` is at least the desired length. (Contributed by Thierry Arnoux, 7-Aug-2023.)
theorem lpadlen1 (ph: wff) (C S L W: class):
  $ wi ph (wcel L cn0) $ >
  $ wi ph (wcel W (cword S)) $ >
  $ wi ph (wcel C S) $ >
  $ wi ph (wbr L (cfv W chash) cle) $ >
  $ wi ph (wceq (cfv (cfv L (co C W clpad)) chash) (cfv W chash)) $;

--| Lemma for the ` leftpad ` theorems. (Contributed by Thierry Arnoux, 7-Aug-2023.)
theorem lpadlem2 (ph: wff) (C S L W: class):
  $ wi ph (wcel L cn0) $ >
  $ wi ph (wcel W (cword S)) $ >
  $ wi ph (wcel C S) $ >
  $ wi ph (wbr (cfv W chash) L cle) $ >
  $ wi ph (wceq (cfv (cxp (co cc0 (co L (cfv W chash) cmin) cfzo) (csn C)) chash) (co L (cfv W chash) cmin)) $;

--| Length of a left-padded word, in the case the given word ` W ` is shorter than the desired length. (Contributed by Thierry Arnoux, 7-Aug-2023.)
theorem lpadlen2 (ph: wff) (C S L W: class):
  $ wi ph (wcel L cn0) $ >
  $ wi ph (wcel W (cword S)) $ >
  $ wi ph (wcel C S) $ >
  $ wi ph (wbr (cfv W chash) L cle) $ >
  $ wi ph (wceq (cfv (cfv L (co C W clpad)) chash) L) $;

--| Length of a left-padded word, in the general case, expressed with an ` if ` statement. (Contributed by Thierry Arnoux, 7-Aug-2023.)
theorem lpadmax (ph: wff) (C S L W: class):
  $ wi ph (wcel L cn0) $ >
  $ wi ph (wcel W (cword S)) $ >
  $ wi ph (wcel C S) $ >
  $ wi ph (wceq (cfv (cfv L (co C W clpad)) chash) (cif (wbr L (cfv W chash) cle) (cfv W chash) L)) $;

--| The contents of prefix of a left-padded word is always the letter ` C ` . (Contributed by Thierry Arnoux, 7-Aug-2023.)
theorem lpadleft (ph: wff) (C S L N W: class):
  $ wi ph (wcel L cn0) $ >
  $ wi ph (wcel W (cword S)) $ >
  $ wi ph (wcel C S) $ >
  $ wi ph (wcel N (co cc0 (co L (cfv W chash) cmin) cfzo)) $ >
  $ wi ph (wceq (cfv N (cfv L (co C W clpad))) C) $;

--| The suffix of a left-padded word the original word ` W ` . (Contributed by Thierry Arnoux, 7-Aug-2023.)
theorem lpadright (ph: wff) (C S L M N W: class):
  $ wi ph (wcel L cn0) $ >
  $ wi ph (wcel W (cword S)) $ >
  $ wi ph (wcel C S) $ >
  $ wi ph (wceq M (cif (wbr L (cfv W chash) cle) cc0 (co L (cfv W chash) cmin))) $ >
  $ wi ph (wcel N (co cc0 (cfv W chash) cfzo)) $ >
  $ wi ph (wceq (cfv (co N M caddc) (cfv L (co C W clpad))) (cfv N W)) $;

--| Extend wff notation with the 4-way conjunction. (New usage is discouraged.)
term w_bnj17 (ph ps ch th: wff): wff;

--| Define the 4-way conjunction. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
axiom df_bnj17 (ph ps ch th: wff):
  $ wb (w_bnj17 ph ps ch th) (wa (w3a ph ps ch) th) $;

--| Extend class notation with the function giving: the class of all elements of ` A ` that are "smaller" than ` X ` according to ` R ` . (New usage is discouraged.)
term c_bnj14 (A2 R X: class): class;

--| Define the function giving: the class of all elements of ` A ` that are "smaller" than ` X ` according to ` R ` . (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
axiom df_bnj14 {y1: setvar} (A2 R X: class):
  $ wceq (c_bnj14 A2 R X) (crab y1 (wbr (cv y1) X R) A2) $;

--| Extend wff notation with the following predicate: ` R ` is set-like on ` A ` . (New usage is discouraged.)
term w_bnj13 (A2 R: class): wff;

--| Define the following predicate: ` R ` is set-like on ` A ` . (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
axiom df_bnj13 {x3: setvar} (A2 R: class):
  $ wb (w_bnj13 A2 R) (wral x3 (wcel (c_bnj14 A2 R (cv x3)) cvv) A2) $;

--| Extend wff notation with the following predicate: ` R ` is both well-founded and set-like on ` A ` . (New usage is discouraged.)
term w_bnj15 (A2 R: class): wff;

--| Define the following predicate: ` R ` is both well-founded and set-like on ` A ` . (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
axiom df_bnj15 (A2 R: class):
  $ wb (w_bnj15 A2 R) (wa (wfr A2 R) (w_bnj13 A2 R)) $;

--| Extend class notation with the function giving: the transitive closure of ` X ` in ` A ` by ` R ` . (New usage is discouraged.)
term c_bnj18 (A2 R X: class): class;

--| Define the function giving: the transitive closure of ` X ` in ` A ` by ` R ` . This definition has been designed for facilitating verification that it is eliminable and that the $d restrictions are sound and complete. For a more readable definition see ~ bnj882 . (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
axiom df_bnj18 {y1 f2 i n: setvar} (A2 R X: class):
  $ wceq (c_bnj18 A2 R X) (ciun f2 (cab f2 (wrex n (w3a (wfn (cv f2) (cv n)) (wceq (cfv c0 (cv f2)) (c_bnj14 A2 R X)) (wral i (wi (wcel (csuc (cv i)) (cv n)) (wceq (cfv (csuc (cv i)) (cv f2)) (ciun y1 (cfv (cv i) (cv f2)) (c_bnj14 A2 R (cv y1))))) com)) (cdif com (csn c0)))) (ciun i (cdm (cv f2)) (cfv (cv i) (cv f2)))) $;

--| Extend wff notation with the following predicate: ` B ` is transitive for ` A ` and ` R ` . (New usage is discouraged.)
term w_bnj19 (A2 B2 R: class): wff;

--| Define the following predicate: ` B ` is transitive for ` A ` and ` R ` . (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
axiom df_bnj19 {x3: setvar} (A2 B2 R: class):
  $ wb (w_bnj19 A2 B2 R) (wral x3 (wss (c_bnj14 A2 R (cv x3)) B2) B2) $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (Proof shortened by Andrew Salmon, 14-Jun-2011.) (New usage is discouraged.)
theorem bnj170 (ph ps ch: wff):
  $ wb (w3a ph ps ch) (wa (wa ps ch) ph) $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj240 (ph ps ch bnjwpsm bnjwchm: wff):
  $ wi ps bnjwpsm $ >
  $ wi ch bnjwchm $ >
  $ wi (w3a ph ps ch) (wa bnjwpsm bnjwchm) $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj248 (ph ps ch th: wff):
  $ wb (w_bnj17 ph ps ch th) (wa (wa (wa ph ps) ch) th) $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj250 (ph ps ch th: wff):
  $ wb (w_bnj17 ph ps ch th) (wa ph (wa (wa ps ch) th)) $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj251 (ph ps ch th: wff):
  $ wb (w_bnj17 ph ps ch th) (wa ph (wa ps (wa ch th))) $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj252 (ph ps ch th: wff):
  $ wb (w_bnj17 ph ps ch th) (wa ph (w3a ps ch th)) $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj253 (ph ps ch th: wff):
  $ wb (w_bnj17 ph ps ch th) (w3a (wa ph ps) ch th) $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj255 (ph ps ch th: wff):
  $ wb (w_bnj17 ph ps ch th) (w3a ph ps (wa ch th)) $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj256 (ph ps ch th: wff):
  $ wb (w_bnj17 ph ps ch th) (wa (wa ph ps) (wa ch th)) $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj257 (ph ps ch th: wff):
  $ wb (w_bnj17 ph ps ch th) (w_bnj17 ph ps th ch) $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj258 (ph ps ch th: wff):
  $ wb (w_bnj17 ph ps ch th) (wa (w3a ph ps th) ch) $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj268 (ph ps ch th: wff):
  $ wb (w_bnj17 ph ps ch th) (w_bnj17 ph ch ps th) $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj290 (ph ps ch th: wff):
  $ wb (w_bnj17 ph ps ch th) (w_bnj17 ph ch th ps) $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj291 (ph ps ch th: wff):
  $ wb (w_bnj17 ph ps ch th) (wa (w3a ph ch th) ps) $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj312 (ph ps ch th: wff):
  $ wb (w_bnj17 ph ps ch th) (w_bnj17 ps ph ch th) $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (Proof shortened by Andrew Salmon, 14-Jun-2011.) (New usage is discouraged.)
theorem bnj334 (ph ps ch th: wff):
  $ wb (w_bnj17 ph ps ch th) (w_bnj17 ch ph ps th) $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (Proof shortened by Andrew Salmon, 14-Jun-2011.) (New usage is discouraged.)
theorem bnj345 (ph ps ch th: wff):
  $ wb (w_bnj17 ph ps ch th) (w_bnj17 th ph ps ch) $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (Proof shortened by Andrew Salmon, 14-Jun-2011.) (New usage is discouraged.)
theorem bnj422 (ph ps ch th: wff):
  $ wb (w_bnj17 ph ps ch th) (w_bnj17 ch th ph ps) $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj432 (ph ps ch th: wff):
  $ wb (w_bnj17 ph ps ch th) (wa (wa ch th) (wa ph ps)) $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj446 (ph ps ch th: wff):
  $ wb (w_bnj17 ph ps ch th) (wa (w3a ps ch th) ph) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (Proof shortened by Mario Carneiro, 22-Dec-2016.) (New usage is discouraged.)
theorem bnj23 {x3 z w: setvar} (ph: wff x3 z w) (y1: setvar) (A2: class w) (B2 R: class x3):
  $ wceq B2 (crab x3 (wn ph) A2) $ >
  $ wi (wral z (wn (wbr (cv z) (cv y1) R)) B2) (wral w (wi (wbr (cv w) (cv y1) R) (wsbc x3 ph (cv w))) A2) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj31 {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wi ph (wrex x3 ps A2) $ >
  $ wi ps ch $ >
  $ wi ph (wrex x3 ch A2) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj62 {x3 z: setvar} (A2: class z):
  $ wb (wsbc x3 (wfn (cv x3) A2) (cv z)) (wfn (cv z) A2) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj89 {x3 y1: setvar} (ph: wff x3 y1) (Z: class y1):
  $ wcel Z cvv $ >
  $ wb (wsbc y1 (weu x3 ph) Z) (weu x3 (wsbc y1 ph Z)) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (Proof shortened by Mario Carneiro, 22-Dec-2016.) (New usage is discouraged.)
theorem bnj90 {x3: setvar} (z: setvar) (Y: class x3):
  $ wcel Y cvv $ >
  $ wb (wsbc x3 (wfn (cv z) (cv x3)) Y) (wfn (cv z) Y) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj101 {x3: setvar} (ph ps: wff x3):
  $ wex x3 ph $ >
  $ wi ph ps $ >
  $ wex x3 ps $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj105:
  $ wcel c1o cvv $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj115 {n: setvar} (th ta et: wff n) (D: class n):
  $ wb et (wral n (wi ta th) D) $ >
  $ wb et (wal n (wi (wa (wcel (cv n) D) ta) th)) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (Proof shortened by Andrew Salmon, 26-Jun-2011.) (New usage is discouraged.)
theorem bnj132 {x3: setvar} (ph: wff x3) (ps: wff) (ch: wff x3):
  $ wb ph (wex x3 (wi ps ch)) $ >
  $ wb ph (wi ps (wex x3 ch)) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj133 {x3: setvar} (ph ps ch: wff x3):
  $ wb ph (wex x3 ps) $ >
  $ wb ch ps $ >
  $ wb ph (wex x3 ch) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj156 {f2 g2: setvar} (bnjwphm bnjwpsm ze0 ph1 ps1 ze1: wff f2 g2):
  $ wb ze0 (w3a (wfn (cv f2) c1o) bnjwphm bnjwpsm) $ >
  $ wb ze1 (wsbc f2 ze0 (cv g2)) $ >
  $ wb ph1 (wsbc f2 bnjwphm (cv g2)) $ >
  $ wb ps1 (wsbc f2 bnjwpsm (cv g2)) $ >
  $ wb ze1 (w3a (wfn (cv g2) c1o) ph1 ps1) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj158 {p: setvar} (D: class p) (m: setvar):
  $ wceq D (cdif com (csn c0)) $ >
  $ wi (wcel (cv m) D) (wrex p (wceq (cv m) (csuc (cv p))) com) $;

--| First-order logic and set theory. Revised to remove dependence on ~ ax-reg . (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (Revised by NM, 21-Dec-2016.) (New usage is discouraged.)
theorem bnj168 {m: setvar} (D: class m) (n: setvar):
  $ wceq D (cdif com (csn c0)) $ >
  $ wi (wa (wne (cv n) c1o) (wcel (cv n) D)) (wrex m (wceq (cv n) (csuc (cv m))) D) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj206 {n: setvar} (ph ps ch: wff n) (M: class n) (bnjwphm bnjwpsm bnjwchm: wff n):
  $ wb bnjwphm (wsbc n ph M) $ >
  $ wb bnjwpsm (wsbc n ps M) $ >
  $ wb bnjwchm (wsbc n ch M) $ >
  $ wcel M cvv $ >
  $ wb (wsbc n (w3a ph ps ch) M) (w3a bnjwphm bnjwpsm bnjwchm) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj216 (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wi (wceq A2 (csuc B2)) (wcel B2 A2) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj219 {m n: setvar}:
  $ wi (wceq (cv n) (csuc (cv m))) (wbr (cv m) (cv n) cep) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj226 {x3: setvar} (A2 B2: class x3) (C: class):
  $ wss B2 C $ >
  $ wss (ciun x3 A2 B2) C $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (Proof shortened by Andrew Salmon, 9-Jul-2011.) (New usage is discouraged.)
theorem bnj228 {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb ph (wral x3 ps A2) $ >
  $ wi (wa (wcel (cv x3) A2) ph) ps $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (Revised by Mario Carneiro, 6-May-2015.) (New usage is discouraged.)
theorem bnj519 (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wi (wcel B2 cvv) (wfun (csn (cop A2 B2))) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj524 {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb ph ps $ >
  $ wcel A2 cvv $ >
  $ wb (wsbc x3 ph A2) (wsbc x3 ps A2) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj525 {x3: setvar} (ph: wff) (A2: class x3):
  $ wcel A2 cvv $ >
  $ wb (wsbc x3 ph A2) ph $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj534 {x3: setvar} (ph: wff x3) (ps: wff) (ch: wff x3):
  $ wi ch (wa (wex x3 ph) ps) $ >
  $ wi ch (wex x3 (wa ph ps)) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.) (Proof shortened by OpenAI, 30-Mar-2020.)
theorem bnj538 {x3 y1: setvar} (ph: wff x3 y1) (A2: class y1) (B2: class x3):
  $ wcel A2 cvv $ >
  $ wb (wsbc y1 (wral x3 ph B2) A2) (wral x3 (wsbc y1 ph A2) B2) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj529 (D M: class):
  $ wceq D (cdif com (csn c0)) $ >
  $ wi (wcel M D) (wcel c0 M) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj551 (i m p: setvar):
  $ wi (wa (wceq (cv m) (csuc (cv p))) (wceq (cv m) (csuc (cv i)))) (wceq (cv p) (cv i)) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj563 {i m n p: setvar} (et rh: wff i m n p) (D: class i m n p):
  $ wb et (w_bnj17 (wcel (cv m) D) (wceq (cv n) (csuc (cv m))) (wcel (cv p) com) (wceq (cv m) (csuc (cv p)))) $ >
  $ wb rh (w3a (wcel (cv i) com) (wcel (csuc (cv i)) (cv n)) (wne (cv m) (csuc (cv i)))) $ >
  $ wi (wa et rh) (wcel (csuc (cv i)) (cv m)) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj564 {f2 m: setvar} (ta bnjwphm bnjwpsm: wff f2 m):
  $ wb ta (w3a (wfn (cv f2) (cv m)) bnjwphm bnjwpsm) $ >
  $ wi ta (wceq (cdm (cv f2)) (cv m)) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj593 {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wex x3 ps) $ >
  $ wi ps ch $ >
  $ wi ph (wex x3 ch) $;

--| First-order logic and set theory. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj596 {x3: setvar} (ph ps: wff x3):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wex x3 ps) $ >
  $ wi ph (wex x3 (wa ph ps)) $;

--| Pass from equality ( ` x = A ` ) to substitution ( ` [. A / x ]. ` ) without the distinct variable condition on ` A , x ` . (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj610 {x3 y1: setvar} (ph ps: wff x3) (A2: class x3) (bnjwpsm: wff y1):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph bnjwpsm) $ >
  $ wi (wceq (cv y1) A2) (wb bnjwpsm ps) $ >
  $ wb (wsbc x3 ph A2) ps $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj642 (ph ps ch th: wff):
  $ wi (w_bnj17 ph ps ch th) ph $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj643 (ph ps ch th: wff):
  $ wi (w_bnj17 ph ps ch th) ps $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj645 (ph ps ch th: wff):
  $ wi (w_bnj17 ph ps ch th) th $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj658 (ph ps ch th: wff):
  $ wi (w_bnj17 ph ps ch th) (w3a ph ps ch) $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj667 (ph ps ch th: wff):
  $ wi (w_bnj17 ph ps ch th) (w3a ps ch th) $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj705 (ph ps ch th ta: wff):
  $ wi ph ta $ >
  $ wi (w_bnj17 ph ps ch th) ta $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj706 (ph ps ch th ta: wff):
  $ wi ps ta $ >
  $ wi (w_bnj17 ph ps ch th) ta $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj707 (ph ps ch th ta: wff):
  $ wi ch ta $ >
  $ wi (w_bnj17 ph ps ch th) ta $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj708 (ph ps ch th ta: wff):
  $ wi th ta $ >
  $ wi (w_bnj17 ph ps ch th) ta $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj721 (ph ps ch th ta: wff):
  $ wi (w3a ph ps ch) ta $ >
  $ wi (w_bnj17 ph ps ch th) ta $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj832 (ph ps ta et: wff):
  $ wb et (wa ph ps) $ >
  $ wi ph ta $ >
  $ wi et ta $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj835 (ph ps ch ta et: wff):
  $ wb et (w3a ph ps ch) $ >
  $ wi ph ta $ >
  $ wi et ta $;

--| ` /\ ` -manipulation. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj836 (ph ps ch ta et: wff):
  $ wb et (w3a ph ps ch) $ >

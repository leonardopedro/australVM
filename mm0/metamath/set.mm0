  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq F (cfv C cbs) $ >
  $ wceq R (cfv C csg) $ >
  $ wceq J (cfv C clspn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel Y (cdif V (csn c_0))) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wceq (cfv (cfv (csn X) N) M) (cfv (csn G) J)) $ >
  $ wi ph (wa (wcel (cv h) F) (wa (wceq (cfv (cfv (csn Y) N) M) (cfv (csn (cv h)) J)) (wceq (cfv (cfv (csn (co X Y c_mi)) N) M) (cfv (csn (co G (cv h) R)) J)))) $ >
  $ wi ph (wa (wcel (cv i) F) (wa (wceq (cfv (cfv (csn Y) N) M) (cfv (csn (cv i)) J)) (wceq (cfv (cfv (csn (co X Y c_mi)) N) M) (cfv (csn (co G (cv i) R)) J)))) $ >
  $ wceq A2 (cfv U csca) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_x (cfv C cvsca) $ >
  $ wceq O (cfv A2 c0g) $ >
  $ wi ph (wcel (cv v) B2) $ >
  $ wi ph (wceq (cv h) (co (cv u) (cv i) c_x)) $ >
  $ wi ph (wceq (co G (cv h) R) (co (cv v) (co G (cv i) R) c_x)) $ >
  $ wi ph (wceq (co (co (cv v) G c_x) (co (cv v) (cv i) c_x) R) (co G (co (cv u) (cv i) c_x) R)) $;

--| Lemma for ~ mapdpg . Baer p. 45 line 18: "Hence we deduce (from ~ mapdpglem28 , using ~ lvecindp2 ) that v = 1 and v = u...". TODO: would it be shorter to have only the ` v = ( 1r `` A ) ` part and use mapdpglem28.u2 in ~ mapdpglem31 ? (Contributed by NM, 22-Mar-2015.)
theorem mapdpglem30 {v u h i: setvar} (ph: wff v u h i) (A2: class v u h i) (B2 C: class h i) (R: class u h i) (c_x: class h i) (U F: class v u h i) (G: class u h i) (H J K M c_mi N: class v u h i) (O: class h i) (V W X Y c_0: class v u h i):
  $ wceq H (cfv K clh) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq F (cfv C cbs) $ >
  $ wceq R (cfv C csg) $ >
  $ wceq J (cfv C clspn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel Y (cdif V (csn c_0))) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wceq (cfv (cfv (csn X) N) M) (cfv (csn G) J)) $ >
  $ wi ph (wa (wcel (cv h) F) (wa (wceq (cfv (cfv (csn Y) N) M) (cfv (csn (cv h)) J)) (wceq (cfv (cfv (csn (co X Y c_mi)) N) M) (cfv (csn (co G (cv h) R)) J)))) $ >
  $ wi ph (wa (wcel (cv i) F) (wa (wceq (cfv (cfv (csn Y) N) M) (cfv (csn (cv i)) J)) (wceq (cfv (cfv (csn (co X Y c_mi)) N) M) (cfv (csn (co G (cv i) R)) J)))) $ >
  $ wceq A2 (cfv U csca) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_x (cfv C cvsca) $ >
  $ wceq O (cfv A2 c0g) $ >
  $ wi ph (wcel (cv v) B2) $ >
  $ wi ph (wceq (cv h) (co (cv u) (cv i) c_x)) $ >
  $ wi ph (wceq (co G (cv h) R) (co (cv v) (co G (cv i) R) c_x)) $ >
  $ wi ph (wcel (cv u) B2) $ >
  $ wi ph (wa (wceq (cv v) (cfv A2 cur)) (wceq (cv v) (cv u))) $;

--| Lemma for ~ mapdpg . Baer p. 45 line 19: "...and we have consequently that y' = y'', as we claimed." (Contributed by NM, 23-Mar-2015.)
theorem mapdpglem31 {v u h i: setvar} (ph: wff v u h i) (A2: class v u h i) (B2 C: class h i) (R: class u h i) (c_x: class h i) (U F: class v u h i) (G: class u h i) (H J K M c_mi N: class v u h i) (O: class h i) (V W X Y c_0: class v u h i):
  $ wceq H (cfv K clh) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq F (cfv C cbs) $ >
  $ wceq R (cfv C csg) $ >
  $ wceq J (cfv C clspn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel Y (cdif V (csn c_0))) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wceq (cfv (cfv (csn X) N) M) (cfv (csn G) J)) $ >
  $ wi ph (wa (wcel (cv h) F) (wa (wceq (cfv (cfv (csn Y) N) M) (cfv (csn (cv h)) J)) (wceq (cfv (cfv (csn (co X Y c_mi)) N) M) (cfv (csn (co G (cv h) R)) J)))) $ >
  $ wi ph (wa (wcel (cv i) F) (wa (wceq (cfv (cfv (csn Y) N) M) (cfv (csn (cv i)) J)) (wceq (cfv (cfv (csn (co X Y c_mi)) N) M) (cfv (csn (co G (cv i) R)) J)))) $ >
  $ wceq A2 (cfv U csca) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_x (cfv C cvsca) $ >
  $ wceq O (cfv A2 c0g) $ >
  $ wi ph (wcel (cv v) B2) $ >
  $ wi ph (wceq (cv h) (co (cv u) (cv i) c_x)) $ >
  $ wi ph (wceq (co G (cv h) R) (co (cv v) (co G (cv i) R) c_x)) $ >
  $ wi ph (wcel (cv u) B2) $ >
  $ wi ph (wceq (cv h) (cv i)) $;

--| Lemma for ~ mapdpg . Existence part - consolidate hypotheses in ~ mapdpglem23 . (Contributed by NM, 21-Mar-2015.)
theorem mapdpglem24 {h: setvar} (ph: wff h) (C R U F G: class) (H: class h) (J: class) (K: class h) (M c_mi N: class) (V W: class h) (X Y: class) (c_0: class h):
  $ wceq H (cfv K clh) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq F (cfv C cbs) $ >
  $ wceq R (cfv C csg) $ >
  $ wceq J (cfv C clspn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel Y (cdif V (csn c_0))) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wceq (cfv (cfv (csn X) N) M) (cfv (csn G) J)) $ >
  $ wi ph (wrex h (wa (wceq (cfv (cfv (csn Y) N) M) (cfv (csn (cv h)) J)) (wceq (cfv (cfv (csn (co X Y c_mi)) N) M) (cfv (csn (co G (cv h) R)) J))) F) $;

--| Lemma for ~ mapdpg . Uniqueness part - consolidate hypotheses in ~ mapdpglem31 . (Contributed by NM, 23-Mar-2015.)
theorem mapdpglem32 {h i: setvar} (ph: wff h i) (C R U F G: class i) (H: class h i) (J: class i) (K: class h i) (M c_mi N: class i) (V W: class h i) (X Y: class i) (c_0: class h i):
  $ wceq H (cfv K clh) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq F (cfv C cbs) $ >
  $ wceq R (cfv C csg) $ >
  $ wceq J (cfv C clspn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel Y (cdif V (csn c_0))) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wceq (cfv (cfv (csn X) N) M) (cfv (csn G) J)) $ >
  $ wi (w3a ph (wa (wcel (cv h) F) (wcel (cv i) F)) (wa (wa (wceq (cfv (cfv (csn Y) N) M) (cfv (csn (cv h)) J)) (wceq (cfv (cfv (csn (co X Y c_mi)) N) M) (cfv (csn (co G (cv h) R)) J))) (wa (wceq (cfv (cfv (csn Y) N) M) (cfv (csn (cv i)) J)) (wceq (cfv (cfv (csn (co X Y c_mi)) N) M) (cfv (csn (co G (cv i) R)) J))))) (wceq (cv h) (cv i)) $;

--| Part 1 of proof of the first fundamental theorem of projective geometry. Part (1) in [Baer] p. 44. Our notation corresponds to Baer's as follows: ` M ` for *, ` N `` { } ` for F(), ` J `` { } ` for G(), ` X ` for x, ` G ` for x', ` Y ` for y, ` h ` for y'. TODO: Rename variables per ~ mapdhval . (Contributed by NM, 22-Mar-2015.)
theorem mapdpg {h: setvar} (ph: wff) (C R U F G: class) (H: class h) (J: class) (K: class h) (M c_mi N: class) (V W: class h) (X Y: class) (c_0: class h):
  $ wceq H (cfv K clh) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq F (cfv C cbs) $ >
  $ wceq R (cfv C csg) $ >
  $ wceq J (cfv C clspn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel Y (cdif V (csn c_0))) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wceq (cfv (cfv (csn X) N) M) (cfv (csn G) J)) $ >
  $ wi ph (wreu h (wa (wceq (cfv (cfv (csn Y) N) M) (cfv (csn (cv h)) J)) (wceq (cfv (cfv (csn (co X Y c_mi)) N) M) (cfv (csn (co G (cv h) R)) J))) F) $;


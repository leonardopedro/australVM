  $ wi ph (wceq (cfv T c2nd) cc0) $ >
  $ wi ph (wceq F (cmpt y1 (co cc0 (co N c1 cmin) cfz) (co (cmpt n (co c1 N cfz) (co (cfv (cv n) (cfv (cfv T c1st) c1st)) (cif (wceq (cv n) (cfv c1 (cfv (cfv T c1st) c2nd))) c1 cc0) caddc)) (cun (cxp (cima (ccom (cfv (cfv T c1st) c2nd) (cmpt n (co c1 N cfz) (cif (wceq (cv n) N) c1 (co (cv n) c1 caddc)))) (co c1 (cv y1) cfz)) (csn c1)) (cxp (cima (ccom (cfv (cfv T c1st) c2nd) (cmpt n (co c1 N cfz) (cif (wceq (cv n) N) c1 (co (cv n) c1 caddc)))) (co (co (cv y1) c1 caddc) N cfz)) (csn cc0))) (cof caddc)))) $;

--| Lemma for ~ poimir establishing existence for ~ poimirlem18 . (Contributed by Brendan Leahy, 21-Aug-2020.)

  $ wceq S (cfv W (cfv K chdma)) $ >
  $ wceq G (cfv W (cfv K chg)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (cdif B2 (csn c_0))) $ >
  $ wi ph (wcel C (cfv (csn E) O)) $ >
  $ wi ph (wcel D (cfv (csn E) O)) $ >
  $ wi ph (wceq (cfv C (cfv D S)) c_1) $ >
  $ wi ph (wceq (cfv (cfv X G) G) X) $;

--| Lemma for ~ hgmapvv . Eliminate ` ( ( S `` D ) `` C ) = .1. ` (Baer's f(h,k)=1). (Contributed by NM, 13-Jun-2015.)
theorem hgmapvvlem3 (ph: wff) (B2 R S c_x c_xp U c_1 E G H K N O V W X c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq E (cop (cres cid (cfv K cbs)) (cres cid (cfv W (cfv K cltrn)))) $ >
  $ wceq O (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq N (cfv R cinvr) $ >
  $ wceq S (cfv W (cfv K chdma)) $ >
  $ wceq G (cfv W (cfv K chg)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (cdif B2 (csn c_0))) $ >
  $ wi ph (wceq (cfv (cfv X G) G) X) $;

--| Value of a double involution. Part 1.2 of [Baer] p. 110 line 37. (Contributed by NM, 13-Jun-2015.)
theorem hgmapvv (ph: wff) (B2 R U G H K W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq G (cfv W (cfv K chg)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (cfv (cfv X G) G) X) $;

--| Lemma for ~ hdmapg . (Contributed by NM, 14-Jun-2015.)
theorem hdmapglem7a {u k: setvar} (ph: wff) (B2 c_pl: class) (c_po: class u k) (R: class u) (c_x U E: class) (H K: class u k) (N O: class) (V: class u) (W: class u k) (X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq E (cop (cres cid (cfv K cbs)) (cres cid (cfv W (cfv K cltrn)))) $ >
  $ wceq O (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq N (cfv U clspn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wrex u (wrex k (wceq X (co (co (cv k) E c_x) (cv u) c_pl)) B2) (cfv (csn E) O)) $;

--| Lemma for ~ hdmapg . (Contributed by NM, 14-Jun-2015.)
theorem hdmapglem7b {x3 y1 m n: setvar} (ph: wff x3 y1 m n) (B2 c_pl c_pb c_po R S c_x c_xp U E G H K N O V W X c_0: class x3 y1 m n):
  $ wceq H (cfv K clh) $ >
  $ wceq E (cop (cres cid (cfv K cbs)) (cres cid (cfv W (cfv K cltrn)))) $ >
  $ wceq O (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq N (cfv U clspn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_pb (cfv R cplusg) $ >
  $ wceq S (cfv W (cfv K chdma)) $ >
  $ wceq G (cfv W (cfv K chg)) $ >
  $ wi ph (wcel (cv x3) (cfv (csn E) O)) $ >
  $ wi ph (wcel (cv y1) (cfv (csn E) O)) $ >
  $ wi ph (wcel (cv m) B2) $ >
  $ wi ph (wcel (cv n) B2) $ >
  $ wi ph (wceq (cfv (co (co (cv n) E c_x) (cv y1) c_pl) (cfv (co (co (cv m) E c_x) (cv x3) c_pl) S)) (co (co (cv n) (cfv (cv m) G) c_xp) (cfv (cv y1) (cfv (cv x3) S)) c_pb)) $;

--| Lemma for ~ hdmapg . Line 15 in [Baer] p. 111, f(x,y) alpha = f(y,x). In the proof, our ` E ` , ` ( O `` { E } ) ` , ` X ` , ` Y ` , ` k ` , ` u ` , ` l ` , and ` v ` correspond respectively to Baer's w, H, x, y, x', x'', y', and y'', and our ` ( ( S `` Y ) `` X ) ` corresponds to Baer's f(x,y). (Contributed by NM, 14-Jun-2015.)
theorem hdmapglem7 (ph: wff) (B2 c_pl c_pb c_po R S c_x c_xp U E G H K N O V W X Y c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq E (cop (cres cid (cfv K cbs)) (cres cid (cfv W (cfv K cltrn)))) $ >
  $ wceq O (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq N (cfv U clspn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_pb (cfv R cplusg) $ >
  $ wceq S (cfv W (cfv K chdma)) $ >
  $ wceq G (cfv W (cfv K chg)) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wceq (cfv (cfv X (cfv Y S)) G) (cfv Y (cfv X S))) $;

--| Apply the scalar sigma function (involution) ` G ` to an inner product reverses the arguments. The inner product of ` X ` and ` Y ` is represented by ` ( ( S `` Y ) `` X ) ` . Line 15 in [Baer] p. 111, f(x,y) alpha = f(y,x). (Contributed by NM, 14-Jun-2015.)
theorem hdmapg (ph: wff) (S U G H K V W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq S (cfv W (cfv K chdma)) $ >
  $ wceq G (cfv W (cfv K chg)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wceq (cfv (cfv X (cfv Y S)) G) (cfv Y (cfv X S))) $;

--| Express our constructed orthocomplement (polarity) in terms of the Hilbert space definition of orthocomplement. Lines 24 and 25 in [Holland95] p. 14. (Contributed by NM, 17-Jun-2015.)
theorem hdmapoc {y1 z: setvar} (ph: wff) (R S U H K: class y1 z) (O: class) (V: class y1) (W: class y1 z) (X: class) (c_0: class y1 z):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq O (cfv W (cfv K coch)) $ >
  $ wceq S (cfv W (cfv K chdma)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wss X V) $ >
  $ wi ph (wceq (cfv X O) (crab y1 (wral z (wceq (cfv (cv y1) (cfv (cv z) S)) c_0) X) V)) $;

--| Extend class notation with the final constructed Hilbert space.
term chlh: class;

--| Define our final Hilbert space constructed from a Hilbert lattice. (Contributed by NM, 21-Jun-2015.) (Revised by Mario Carneiro, 28-Jun-2015.)
axiom df_hlhil {x3 y1 w v u k: setvar}:
  $ wceq chlh (cmpt k cvv (cmpt w (cfv (cv k) clh) (csb u (cfv (cv w) (cfv (cv k) cdvh)) (csb v (cfv (cv u) cbs) (cun (ctp (cop (cfv cnx cbs) (cv v)) (cop (cfv cnx cplusg) (cfv (cv u) cplusg)) (cop (cfv cnx csca) (co (cfv (cv w) (cfv (cv k) cedring)) (cop (cfv cnx cstv) (cfv (cv w) (cfv (cv k) chg))) csts))) (cpr (cop (cfv cnx cvsca) (cfv (cv u) cvsca)) (cop (cfv cnx cip) (cmpo x3 y1 (cv v) (cv v) (cfv (cv x3) (cfv (cv y1) (cfv (cv w) (cfv (cv k) chdma)))))))))))) $;

--| The final Hilbert space constructed from a Hilbert lattice ` K ` and an arbitrary hyperplane ` W ` in ` K ` . (Contributed by NM, 21-Jun-2015.) (Revised by Mario Carneiro, 28-Jun-2015.)
theorem hlhilset {x3 y1: setvar} (ph: wff) (c_pl R S c_x U E G H c_xi: class x3 y1) (K: class) (L V: class x3 y1) (W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq L (cfv W (cfv K chlh)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq E (cfv W (cfv K cedring)) $ >
  $ wceq G (cfv W (cfv K chg)) $ >
  $ wceq R (co E (cop (cfv cnx cstv) G) csts) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq S (cfv W (cfv K chdma)) $ >
  $ wceq c_xi (cmpo x3 y1 V V (cfv (cv x3) (cfv (cv y1) S))) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wceq L (cun (ctp (cop (cfv cnx cbs) V) (cop (cfv cnx cplusg) c_pl) (cop (cfv cnx csca) R)) (cpr (cop (cfv cnx cvsca) c_x) (cop (cfv cnx cip) c_xi)))) $;

--| The scalar of the final constructed Hilbert space. (Contributed by NM, 22-Jun-2015.) (Revised by Mario Carneiro, 28-Jun-2015.)
theorem hlhilsca (ph: wff) (R U E G H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K chlh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wceq E (cfv W (cfv K cedring)) $ >
  $ wceq G (cfv W (cfv K chg)) $ >
  $ wceq R (co E (cop (cfv cnx cstv) G) csts) $ >
  $ wi ph (wceq R (cfv U csca)) $;

--| The base set of the final constructed Hilbert space. (Contributed by NM, 21-Jun-2015.) (Revised by Mario Carneiro, 28-Jun-2015.)
theorem hlhilbase (ph: wff) (U H K L M W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K chlh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wceq L (cfv W (cfv K cdvh)) $ >
  $ wceq M (cfv L cbs) $ >
  $ wi ph (wceq M (cfv U cbs)) $;

--| The vector addition for the final constructed Hilbert space. (Contributed by NM, 21-Jun-2015.)
theorem hlhilplus (ph: wff) (c_pl U H K L W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K chlh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wceq L (cfv W (cfv K cdvh)) $ >
  $ wceq c_pl (cfv L cplusg) $ >
  $ wi ph (wceq c_pl (cfv U cplusg)) $;

--| Lemma for ~ hlhilsbase etc. (Contributed by Mario Carneiro, 28-Jun-2015.) (Revised by AV, 6-Nov-2024.)
theorem hlhilslem (ph: wff) (C R U E F H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq E (cfv W (cfv K cedring)) $ >
  $ wceq U (cfv W (cfv K chlh)) $ >
  $ wceq R (cfv U csca) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wceq F (cslot (cfv cnx F)) $ >
  $ wne (cfv cnx F) (cfv cnx cstv) $ >
  $ wceq C (cfv E F) $ >
  $ wi ph (wceq C (cfv R F)) $;

--| The scalar base set of the final constructed Hilbert space. (Contributed by NM, 22-Jun-2015.) (Revised by Mario Carneiro, 28-Jun-2015.) (Revised by AV, 6-Nov-2024.)
theorem hlhilsbase (ph: wff) (C R U E H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq E (cfv W (cfv K cedring)) $ >
  $ wceq U (cfv W (cfv K chlh)) $ >
  $ wceq R (cfv U csca) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wceq C (cfv E cbs) $ >
  $ wi ph (wceq C (cfv R cbs)) $;

--| Scalar addition for the final constructed Hilbert space. (Contributed by NM, 22-Jun-2015.) (Revised by Mario Carneiro, 28-Jun-2015.) (Revised by AV, 6-Nov-2024.)
theorem hlhilsplus (ph: wff) (c_pl R U E H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq E (cfv W (cfv K cedring)) $ >
  $ wceq U (cfv W (cfv K chlh)) $ >
  $ wceq R (cfv U csca) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wceq c_pl (cfv E cplusg) $ >
  $ wi ph (wceq c_pl (cfv R cplusg)) $;

--| Scalar multiplication for the final constructed Hilbert space. (Contributed by NM, 22-Jun-2015.) (Revised by Mario Carneiro, 28-Jun-2015.) (Revised by AV, 6-Nov-2024.)
theorem hlhilsmul (ph: wff) (R c_x U E H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq E (cfv W (cfv K cedring)) $ >
  $ wceq U (cfv W (cfv K chlh)) $ >
  $ wceq R (cfv U csca) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wceq c_x (cfv E cmulr) $ >
  $ wi ph (wceq c_x (cfv R cmulr)) $;

--| The scalar base set of the final constructed Hilbert space. (Contributed by NM, 22-Jun-2015.) (Revised by Mario Carneiro, 28-Jun-2015.)
theorem hlhilsbase2 (ph: wff) (C R S U H K L W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq L (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv L csca) $ >
  $ wceq U (cfv W (cfv K chlh)) $ >
  $ wceq R (cfv U csca) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wceq C (cfv S cbs) $ >
  $ wi ph (wceq C (cfv R cbs)) $;

--| Scalar addition for the final constructed Hilbert space. (Contributed by NM, 22-Jun-2015.) (Revised by Mario Carneiro, 28-Jun-2015.)
theorem hlhilsplus2 (ph: wff) (c_pl R S U H K L W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq L (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv L csca) $ >
  $ wceq U (cfv W (cfv K chlh)) $ >
  $ wceq R (cfv U csca) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wceq c_pl (cfv S cplusg) $ >
  $ wi ph (wceq c_pl (cfv R cplusg)) $;

--| Scalar multiplication for the final constructed Hilbert space. (Contributed by NM, 22-Jun-2015.) (Revised by Mario Carneiro, 28-Jun-2015.)
theorem hlhilsmul2 (ph: wff) (R S c_x U H K L W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq L (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv L csca) $ >
  $ wceq U (cfv W (cfv K chlh)) $ >
  $ wceq R (cfv U csca) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wceq c_x (cfv S cmulr) $ >
  $ wi ph (wceq c_x (cfv R cmulr)) $;

--| The scalar ring zero for the final constructed Hilbert space. (Contributed by NM, 22-Jun-2015.) (Revised by Mario Carneiro, 29-Jun-2015.)
theorem hlhils0 (ph: wff) (R S U H K L W c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq L (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv L csca) $ >
  $ wceq U (cfv W (cfv K chlh)) $ >
  $ wceq R (cfv U csca) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wceq c_0 (cfv S c0g) $ >
  $ wi ph (wceq c_0 (cfv R c0g)) $;

--| The scalar ring unity for the final constructed Hilbert space. (Contributed by NM, 22-Jun-2015.) (Revised by Mario Carneiro, 29-Jun-2015.) (New usage is discouraged.)
theorem hlhils1N (ph: wff) (R S U c_1 H K L W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq L (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv L csca) $ >
  $ wceq U (cfv W (cfv K chlh)) $ >
  $ wceq R (cfv U csca) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wceq c_1 (cfv S cur) $ >
  $ wi ph (wceq c_1 (cfv R cur)) $;

--| The scalar product for the final constructed Hilbert space. (Contributed by NM, 21-Jun-2015.) (Revised by Mario Carneiro, 28-Jun-2015.)
theorem hlhilvsca (ph: wff) (c_x U H K L W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq L (cfv W (cfv K cdvh)) $ >
  $ wceq c_x (cfv L cvsca) $ >
  $ wceq U (cfv W (cfv K chlh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wceq c_x (cfv U cvsca)) $;

--| Inner product operation for the final constructed Hilbert space. (Contributed by NM, 22-Jun-2015.) (Revised by Mario Carneiro, 28-Jun-2015.)
theorem hlhilip {x3 y1: setvar} (ph: wff) (S: class) (U H c_xi: class x3 y1) (K: class) (L: class x3 y1) (V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq L (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv L cbs) $ >
  $ wceq S (cfv W (cfv K chdma)) $ >
  $ wceq U (cfv W (cfv K chlh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wceq c_xi (cmpo x3 y1 V V (cfv (cv x3) (cfv (cv y1) S))) $ >
  $ wi ph (wceq c_xi (cfv U cip)) $;

--| Value of inner product operation for the final constructed Hilbert space. (Contributed by NM, 22-Jun-2015.) (Revised by Mario Carneiro, 28-Jun-2015.)
theorem hlhilipval (ph: wff) (S U H c_xi K L V W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq L (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv L cbs) $ >
  $ wceq S (cfv W (cfv K chdma)) $ >
  $ wceq U (cfv W (cfv K chlh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wceq c_xi (cfv U cip) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wceq (co X Y c_xi) (cfv X (cfv Y S))) $;

--| The involution operation of the star division ring for the final constructed Hilbert space. (Contributed by NM, 20-Jun-2015.) (Revised by Mario Carneiro, 28-Jun-2015.)
theorem hlhilnvl (ph: wff) (R U H c_as K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K chlh)) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq c_as (cfv W (cfv K chg)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wceq c_as (cfv R cstv)) $;

--| The final constructed Hilbert space is a vector space. (Contributed by NM, 22-Jun-2015.) (Revised by Mario Carneiro, 29-Jun-2015.)
theorem hlhillvec (ph: wff) (U H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K chlh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel U clvec) $;

--| The star division ring for the final constructed Hilbert space is a division ring. (Contributed by NM, 20-Jun-2015.) (Revised by Mario Carneiro, 28-Jun-2015.)
theorem hlhildrng (ph: wff) (R U H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K chlh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wceq R (cfv U csca) $ >
  $ wi ph (wcel R cdr) $;

--| Lemma for ~ hlhilsrng . (Contributed by NM, 21-Jun-2015.) (Revised by Mario Carneiro, 28-Jun-2015.)
theorem hlhilsrnglem (ph: wff) (B2 c_pl R S c_x U G H K L W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K chlh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq L (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv L csca) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_pl (cfv S cplusg) $ >
  $ wceq c_x (cfv S cmulr) $ >
  $ wceq G (cfv W (cfv K chg)) $ >
  $ wi ph (wcel R csr) $;

--| The star division ring for the final constructed Hilbert space is a division ring. (Contributed by NM, 21-Jun-2015.)
theorem hlhilsrng (ph: wff) (R U H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K chlh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wceq R (cfv U csca) $ >
  $ wi ph (wcel R csr) $;

--| The zero vector for the final constructed Hilbert space. (Contributed by NM, 22-Jun-2015.) (Revised by Mario Carneiro, 29-Jun-2015.)
theorem hlhil0 (ph: wff) (U H K L W c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq L (cfv W (cfv K cdvh)) $ >
  $ wceq U (cfv W (cfv K chlh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wceq c_0 (cfv L c0g) $ >
  $ wi ph (wceq c_0 (cfv U c0g)) $;

--| The vector sum operation for the final constructed Hilbert space. (Contributed by NM, 23-Jun-2015.) (Revised by Mario Carneiro, 29-Jun-2015.)
theorem hlhillsm (ph: wff) (c_po U H K L W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq L (cfv W (cfv K cdvh)) $ >
  $ wceq U (cfv W (cfv K chlh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wceq c_po (cfv L clsm) $ >
  $ wi ph (wceq c_po (cfv U clsm)) $;

--| The orthocomplement for the final constructed Hilbert space. (Contributed by NM, 23-Jun-2015.) (Revised by Mario Carneiro, 29-Jun-2015.)
theorem hlhilocv (ph: wff) (U H K L N O V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq L (cfv W (cfv K cdvh)) $ >
  $ wceq U (cfv W (cfv K chlh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wceq V (cfv L cbs) $ >
  $ wceq N (cfv W (cfv K coch)) $ >
  $ wceq O (cfv U cocv) $ >
  $ wi ph (wss X V) $ >
  $ wi ph (wceq (cfv X O) (cfv X N)) $;

--| The closed subspaces of the final constructed Hilbert space. TODO: ~ hlhilbase is applied over and over to conclusion rather than applied once to antecedent - would compressed proof be shorter if applied once to antecedent? (Contributed by NM, 23-Jun-2015.)
theorem hlhillcs (ph: wff) (C U H I K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq U (cfv W (cfv K chlh)) $ >
  $ wceq C (cfv U ccss) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wceq C (crn I)) $;

--| Lemma for ~ hlhil . (Contributed by NM, 23-Jun-2015.)
theorem hlhilphllem {x3 y1: setvar} (ph: wff y1) (B2 c_pl c_pd Q R c_x c_xp: class x3 y1) (U: class y1) (E F G H c_xi: class x3 y1) (J K: class) (L: class x3 y1) (V W: class) (c_0: class x3 y1):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K chlh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wceq F (cfv U csca) $ >
  $ wceq L (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv L cbs) $ >
  $ wceq c_pl (cfv L cplusg) $ >
  $ wceq c_x (cfv L cvsca) $ >
  $ wceq R (cfv L csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pd (cfv R cplusg) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wceq Q (cfv R c0g) $ >
  $ wceq c_0 (cfv L c0g) $ >
  $ wceq c_xi (cfv U cip) $ >
  $ wceq J (cfv W (cfv K chdma)) $ >
  $ wceq G (cfv W (cfv K chg)) $ >
  $ wceq E (cmpo x3 y1 V V (cfv (cv x3) (cfv (cv y1) J))) $ >
  $ wi ph (wcel U cphl) $;

--| Lemma for ~ hlhil . (Contributed by NM, 23-Jun-2015.)
theorem hlhilhillem {x3 y1: setvar} (ph: wff y1) (B2: class x3 y1) (C: class y1) (c_pl c_pd Q R c_x c_xp: class x3 y1) (U: class y1) (E F G H c_xi: class x3 y1) (J K: class) (L O: class x3 y1) (V W: class) (c_0: class x3 y1):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K chlh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wceq F (cfv U csca) $ >
  $ wceq L (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv L cbs) $ >
  $ wceq c_pl (cfv L cplusg) $ >
  $ wceq c_x (cfv L cvsca) $ >
  $ wceq R (cfv L csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pd (cfv R cplusg) $ >
  $ wceq c_xp (cfv R cmulr) $ >
  $ wceq Q (cfv R c0g) $ >
  $ wceq c_0 (cfv L c0g) $ >
  $ wceq c_xi (cfv U cip) $ >
  $ wceq J (cfv W (cfv K chdma)) $ >
  $ wceq G (cfv W (cfv K chg)) $ >
  $ wceq E (cmpo x3 y1 V V (cfv (cv x3) (cfv (cv y1) J))) $ >
  $ wceq O (cfv U cocv) $ >
  $ wceq C (cfv U ccss) $ >
  $ wi ph (wcel U chil) $;

--| Construction of a Hilbert space ( ~ df-hil ) ` U ` from a Hilbert lattice ( ~ df-hlat ) ` K ` , where ` W ` is a fixed but arbitrary hyperplane (co-atom) in ` K ` . The Hilbert space ` U ` is identical to the vector space ` ( ( DVecH `` K ) `` W ) ` (see ~ dvhlvec ) except that it is extended with involution and inner product components. The construction of these two components is provided by Theorem 3.6 in [Holland95] p. 13, whose proof we follow loosely. An example of involution is the complex conjugate when the division ring is the field of complex numbers. The nature of the division ring we constructed is indeterminate, however, until we specialize the initial Hilbert lattice with additional conditions found by Maria Sol&egrave;r in 1995 and refined by Ren&eacute; Mayet in 1998 that result in a division ring isomorphic to ` CC ` . See additional discussion at ~ https://us.metamath.org/qlegif/mmql.html#what . ` W ` corresponds to the w in the proof of Theorem 13.4 of [Crawley] p. 111. Such a ` W ` always exists since ` HL ` has lattice rank of at least 4 by ~ df-hil . It can be eliminated if we just want to show the existence of a Hilbert space, as is done in the literature. (Contributed by NM, 23-Jun-2015.)
theorem hlathil (ph: wff) (U H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K chlh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel U chil) $;

--| Extend class notation with the class of all commutative semirings.
term ccsrg: class;

--| Define the class of all commutative semirings. (Contributed by metakunt, 4-Apr-2025.)
axiom df_csring {f2: setvar}:
  $ wceq ccsrg (crab f2 (wcel (cfv (cv f2) cmgp) ccmn) csrg) $;

--| A commutative semiring is a semiring whose multiplication is a commutative monoid. (Contributed by metakunt, 4-Apr-2025.)
theorem iscsrg (R G: class):
  $ wceq G (cfv R cmgp) $ >
  $ wb (wcel R ccsrg) (wa (wcel R csrg) (wcel G ccmn)) $;

--| Evaluation of integers across a ring homomorphism. (Contributed by metakunt, 4-Jun-2025.)
theorem rhmzrhval (ph: wff) (R S F M N X: class):
  $ wi ph (wcel F (co R S crh)) $ >
  $ wi ph (wcel X cz) $ >
  $ wceq M (cfv R czrh) $ >
  $ wceq N (cfv S czrh) $ >
  $ wi ph (wceq (cfv (cfv X M) F) (cfv X N)) $;

--| Construction of a ring homomorphism from ` Z/nZ ` to ` R ` when the characteristic of ` R ` divides ` N ` . (Contributed by metakunt, 4-Jun-2025.)
theorem zndvdchrrhm {x3: setvar} (ph: wff x3) (R: class) (F: class x3) (N Z: class):
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel (cfv R cchr) cz) $ >
  $ wi ph (wbr (cfv R cchr) N cdvds) $ >
  $ wceq Z (cfv N czn) $ >
  $ wceq F (cmpt x3 (cfv Z cbs) (cuni (cima (cfv R czrh) (cv x3)))) $ >
  $ wi ph (wcel F (co Z R crh)) $;

--| Closure of the general logarithm with a positive real base on positive reals, a deduction version. (Contributed by metakunt, 22-May-2024.)
theorem relogbcld (ph: wff) (B2 X: class):
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr cc0 B2 clt) $ >
  $ wi ph (wcel X cr) $ >
  $ wi ph (wbr cc0 X clt) $ >
  $ wi ph (wne B2 c1) $ >
  $ wi ph (wcel (co B2 X clogb) cr) $;

--| Identity law for general logarithm: the logarithm of a power to the base is the exponent, a deduction version. (Contributed by metakunt, 22-May-2024.)
theorem relogbexpd (ph: wff) (B2 M: class):
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wne B2 c1) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wceq (co B2 (co B2 M cexp) clogb) M) $;

--| Power law for the general logarithm for integer powers: The logarithm of a positive real number to the power of an integer is equal to the product of the exponent and the logarithm of the base of the power, a deduction version. (Contributed by metakunt, 22-May-2024.)
theorem relogbzexpd (ph: wff) (B2 C N: class):
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wne B2 c1) $ >
  $ wi ph (wcel C crp) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wceq (co B2 (co C N cexp) clogb) (co N (co B2 C clogb) cmul)) $;

--| The general logarithm is monotone/increasing, a deduction version. (Contributed by metakunt, 22-May-2024.)
theorem logblebd (ph: wff) (B2 X Y: class):
  $ wi ph (wcel B2 cz) $ >
  $ wi ph (wbr c2 B2 cle) $ >
  $ wi ph (wcel X cr) $ >
  $ wi ph (wbr cc0 X clt) $ >
  $ wi ph (wcel Y cr) $ >
  $ wi ph (wbr cc0 Y clt) $ >
  $ wi ph (wbr X Y cle) $ >
  $ wi ph (wbr (co B2 X clogb) (co B2 Y clogb) cle) $;

--| Induction on the upper integers that start at ` M ` . The first four hypotheses give us the substitution instances we need; the following two are the basis and the induction step, a deduction version. (Contributed by metakunt, 8-Jun-2024.)
theorem uzindd {j k: setvar} (ph: wff) (ps: wff j) (ch th ta et: wff k) (M: class) (N: class k):
  $ wi (wceq (cv j) M) (wb ps ch) $ >
  $ wi (wceq (cv j) (cv k)) (wb ps th) $ >
  $ wi (wceq (cv j) (co (cv k) c1 caddc)) (wb ps ta) $ >
  $ wi (wceq (cv j) N) (wb ps et) $ >
  $ wi ph ch $ >
  $ wi (w3a ph th (wa (wcel (cv k) cz) (wbr M (cv k) cle))) ta $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wbr M N cle) $ >
  $ wi ph et $;

--| Membership of a sum in a finite interval of integers, a deduction version. (Contributed by metakunt, 10-May-2024.)
theorem fzadd2d (ph: wff) (P Q R J K M N O: class):
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wcel O cz) $ >
  $ wi ph (wcel P cz) $ >
  $ wi ph (wcel J (co M N cfz)) $ >
  $ wi ph (wcel K (co O P cfz)) $ >
  $ wi ph (wceq Q (co M O caddc)) $ >
  $ wi ph (wceq R (co N P caddc)) $ >
  $ wi ph (wcel (co J K caddc) (co Q R cfz)) $;

--| Elementhood in a finite set of sequential integers, except its upper bound. (Contributed by metakunt, 23-May-2024.)
theorem fzne2d (ph: wff) (K M N: class):
  $ wi ph (wcel K (co M N cfz)) $ >
  $ wi ph (wne K N) $ >
  $ wi ph (wbr K N clt) $;

--| Equality of functions is determined by their values, a deduction version. (Contributed by metakunt, 28-May-2024.)
theorem eqfnfv2d2 {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (F G: class):
  $ wi ph (wfn F A2) $ >
  $ wi ph (wfn G B2) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wceq (cfv (cv x3) F) (cfv (cv x3) G)) $ >
  $ wi ph (wceq F G) $;

--| Split a finite interval of integers into two parts. (Contributed by metakunt, 28-May-2024.)
theorem fzsplitnd (ph: wff) (K M N: class):
  $ wi ph (wcel K (co M N cfz)) $ >
  $ wi ph (wceq (co M N cfz) (cun (co M (co K c1 cmin) cfz) (co K N cfz))) $;

--| Split a finite interval of integers into two parts. (Contributed by metakunt, 28-May-2024.)
theorem fzsplitnr (ph: wff) (K M N: class):
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wcel K cz) $ >
  $ wi ph (wbr M K cle) $ >
  $ wi ph (wbr K N cle) $ >
  $ wi ph (wceq (co M N cfz) (cun (co M (co K c1 cmin) cfz) (co K N cfz))) $;

--| Associative law for addition. (Contributed by metakunt, 25-Apr-2024.)
theorem addassnni (A2 B2 C: class):
  $ wcel A2 cn $ >
  $ wcel B2 cn $ >
  $ wcel C cn $ >
  $ wceq (co (co A2 B2 caddc) C caddc) (co A2 (co B2 C caddc) caddc) $;

--| Commutative law for addition. (Contributed by metakunt, 25-Apr-2024.)
theorem addcomnni (A2 B2: class):
  $ wcel A2 cn $ >
  $ wcel B2 cn $ >
  $ wceq (co A2 B2 caddc) (co B2 A2 caddc) $;

--| Associative law for multiplication. (Contributed by metakunt, 25-Apr-2024.)
theorem mulassnni (A2 B2 C: class):
  $ wcel A2 cn $ >
  $ wcel B2 cn $ >
  $ wcel C cn $ >
  $ wceq (co (co A2 B2 cmul) C cmul) (co A2 (co B2 C cmul) cmul) $;

--| Commutative law for multiplication. (Contributed by metakunt, 25-Apr-2024.)
theorem mulcomnni (A2 B2: class):
  $ wcel A2 cn $ >
  $ wcel B2 cn $ >
  $ wceq (co A2 B2 cmul) (co B2 A2 cmul) $;

--| Commutative law for gcd. (Contributed by metakunt, 25-Apr-2024.)
theorem gcdcomnni (M N: class):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wceq (co M N cgcd) (co N M cgcd) $;

--| Negation invariance for gcd. (Contributed by metakunt, 25-Apr-2024.)
theorem gcdnegnni (M N: class):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wceq (co M (cneg N) cgcd) (co M N cgcd) $;

--| Negation invariance for gcd. (Contributed by metakunt, 25-Apr-2024.)
theorem neggcdnni (M N: class):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wceq (co (cneg M) N cgcd) (co M N cgcd) $;

--| Closure of the binomial coefficient, a deduction version. (Contributed by metakunt, 12-May-2024.)
theorem bccl2d (ph: wff) (K N: class):
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel K cn0) $ >
  $ wi ph (wbr K N cle) $ >
  $ wi ph (wcel (co N K cbc) cn) $;

--| Take reciprocal on both sides. (Contributed by metakunt, 12-May-2024.)
theorem recbothd (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wne B2 cc0) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wne C cc0) $ >
  $ wi ph (wcel D cc) $ >
  $ wi ph (wne D cc0) $ >
  $ wi ph (wb (wceq (co A2 B2 cdiv) (co C D cdiv)) (wceq (co B2 A2 cdiv) (co D C cdiv))) $;

--| The GCD of a multiple of a positive integer is the positive integer itself. (Contributed by metakunt, 25-Apr-2024.)
theorem gcdmultiplei (M N: class):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wceq (co M (co M N cmul) cgcd) M $;

--| Adding a multiple of one operand of the gcd operator to the other does not alter the result. (Contributed by metakunt, 25-Apr-2024.)
theorem gcdaddmzz2nni (K M N: class):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wcel K cz $ >
  $ wceq (co M N cgcd) (co M (co N (co K M cmul) caddc) cgcd) $;

--| Adding a multiple of one operand of the gcd operator to the other does not alter the result. (Contributed by metakunt, 25-Apr-2024.)
theorem gcdaddmzz2nncomi (K M N: class):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wcel K cz $ >
  $ wceq (co M N cgcd) (co M (co (co K M cmul) N caddc) cgcd) $;

--| Closure of the gcd operator. (Contributed by metakunt, 25-Apr-2024.)
theorem gcdnncli (M N: class):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wcel (co M N cgcd) cn $;

--| If a product divides an integer, so does one of its factors, a deduction version. (Contributed by metakunt, 12-May-2024.)
theorem muldvds1d (ph: wff) (K M N: class):
  $ wi ph (wcel K cz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wbr (co K M cmul) N cdvds) $ >
  $ wi ph (wbr K N cdvds) $;

--| If a product divides an integer, so does one of its factors, a deduction version. (Contributed by metakunt, 12-May-2024.)
theorem muldvds2d (ph: wff) (K M N: class):
  $ wi ph (wcel K cz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wbr (co K M cmul) N cdvds) $ >
  $ wi ph (wbr M N cdvds) $;

--| A positive integer divides a natural number if and only if the quotient is a positive integer, a deduction version of ~ nndivdvds . (Contributed by metakunt, 12-May-2024.)
theorem nndivdvdsd (ph: wff) (M N: class):
  $ wi ph (wcel M cn) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wb (wbr M N cdvds) (wcel (co N M cdiv) cn)) $;

--| A product of natural numbers divides a natural number if and only if a factor divides the quotient, a deduction version. (Contributed by metakunt, 12-May-2024.)
theorem nnproddivdvdsd (ph: wff) (K M N: class):
  $ wi ph (wcel K cn) $ >
  $ wi ph (wcel M cn) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wb (wbr (co K M cmul) N cdvds) (wbr K (co N M cdiv) cdvds)) $;

--| If an integer is divisible by two coprime integers, then it is divisible by their product, a deduction version. (Contributed by metakunt, 12-May-2024.)
theorem coprmdvds2d (ph: wff) (K M N: class):
  $ wi ph (wcel K cz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wceq (co K M cgcd) c1) $ >
  $ wi ph (wbr K N cdvds) $ >
  $ wi ph (wbr M N cdvds) $ >
  $ wi ph (wbr (co K M cmul) N cdvds) $;

--| An image of a function under a finite set is dominated by the set. (Contributed by SN, 10-May-2025.)
theorem imadomfi (A2 F: class):
  $ wi (wa (wcel A2 cfn) (wfun F)) (wbr (cima F A2) A2 cdom) $;

--| The gcd of 12 and 5 is 1. (Contributed by metakunt, 25-Apr-2024.)
theorem _12gcd5e1:
  $ wceq (co (cdc c1 c2) c5 cgcd) c1 $;

--| The gcd of 60 and 6 is 6. (Contributed by metakunt, 25-Apr-2024.)
theorem _60gcd6e6:
  $ wceq (co (cdc c6 cc0) c6 cgcd) c6 $;

--| The gcd of 60 and 7 is 1. (Contributed by metakunt, 25-Apr-2024.)
theorem _60gcd7e1:
  $ wceq (co (cdc c6 cc0) c7 cgcd) c1 $;

--| The gcd of 420 and 8 is 4. (Contributed by metakunt, 25-Apr-2024.)
theorem _420gcd8e4:
  $ wceq (co (cdc (cdc c4 c2) cc0) c8 cgcd) c4 $;

--| Calculate the least common multiple of two natural numbers. (Contributed by metakunt, 25-Apr-2024.)
theorem lcmeprodgcdi (A2 G H M N: class):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wcel G cn $ >
  $ wcel H cn $ >
  $ wceq (co M N cgcd) G $ >
  $ wceq (co G H cmul) A2 $ >
  $ wceq (co M N cmul) A2 $ >
  $ wceq (co M N clcm) H $;

--| The lcm of 12 and 5 is 60. (Contributed by metakunt, 25-Apr-2024.)
theorem _12lcm5e60:
  $ wceq (co (cdc c1 c2) c5 clcm) (cdc c6 cc0) $;

--| The lcm of 60 and 6 is 60. (Contributed by metakunt, 25-Apr-2024.)
theorem _60lcm6e60:
  $ wceq (co (cdc c6 cc0) c6 clcm) (cdc c6 cc0) $;

--| The lcm of 60 and 7 is 420. (Contributed by metakunt, 25-Apr-2024.)
theorem _60lcm7e420:
  $ wceq (co (cdc c6 cc0) c7 clcm) (cdc (cdc c4 c2) cc0) $;

--| The lcm of 420 and 8 is 840. (Contributed by metakunt, 25-Apr-2024.)
theorem _420lcm8e840:
  $ wceq (co (cdc (cdc c4 c2) cc0) c8 clcm) (cdc (cdc c8 c4) cc0) $;

--| Useful equation to calculate the least common multiple of 1 to n. (Contributed by metakunt, 29-Apr-2024.)
theorem lcmfunnnd (ph: wff) (N: class):
  $ wi ph (wcel N cn) $ >
  $ wi ph (wceq (cfv (co c1 N cfz) clcmf) (co (cfv (co c1 (co N c1 cmin) cfz) clcmf) N clcm)) $;

--| Least common multiple of natural numbers up to 1 equals 1. (Contributed by metakunt, 25-Apr-2024.)
theorem lcm1un:
  $ wceq (cfv (co c1 c1 cfz) clcmf) c1 $;

--| Least common multiple of natural numbers up to 2 equals 2. (Contributed by metakunt, 25-Apr-2024.)
theorem lcm2un:
  $ wceq (cfv (co c1 c2 cfz) clcmf) c2 $;

--| Least common multiple of natural numbers up to 3 equals 6. (Contributed by metakunt, 25-Apr-2024.)
theorem lcm3un:
  $ wceq (cfv (co c1 c3 cfz) clcmf) c6 $;

--| Least common multiple of natural numbers up to 4 equals 12. (Contributed by metakunt, 25-Apr-2024.)
theorem lcm4un:
  $ wceq (cfv (co c1 c4 cfz) clcmf) (cdc c1 c2) $;

--| Least common multiple of natural numbers up to 5 equals 60. (Contributed by metakunt, 25-Apr-2024.)
theorem lcm5un:
  $ wceq (cfv (co c1 c5 cfz) clcmf) (cdc c6 cc0) $;

--| Least common multiple of natural numbers up to 6 equals 60. (Contributed by metakunt, 25-Apr-2024.)
theorem lcm6un:
  $ wceq (cfv (co c1 c6 cfz) clcmf) (cdc c6 cc0) $;

--| Least common multiple of natural numbers up to 7 equals 420. (Contributed by metakunt, 25-Apr-2024.)
theorem lcm7un:
  $ wceq (cfv (co c1 c7 cfz) clcmf) (cdc (cdc c4 c2) cc0) $;

--| Least common multiple of natural numbers up to 8 equals 840. (Contributed by metakunt, 25-Apr-2024.)
theorem lcm8un:
  $ wceq (cfv (co c1 c8 cfz) clcmf) (cdc (cdc c8 c4) cc0) $;

--| Move constants out of integrals or sums and/or commute sum and integral. (Contributed by metakunt, 26-Apr-2024.)
theorem _3factsumint1 {x3 k: setvar} (ph: wff) (A2 B2: class) (U F: class x3 k) (G: class k) (H L: class x3 k):
  $ wceq A2 (co L U cicc) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wcel L cr) $ >
  $ wi ph (wcel U cr) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel F cc) $ >
  $ wi ph (wcel (cmpt x3 A2 F) (co A2 cc ccncf)) $ >
  $ wi (wa ph (wcel (cv k) B2)) (wcel G cc) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv k) B2))) (wcel H cc) $ >
  $ wi (wa ph (wcel (cv k) B2)) (wcel (cmpt x3 A2 H) (co A2 cc ccncf)) $ >
  $ wi ph (wceq (citg x3 A2 (csu k B2 (co F (co G H cmul) cmul))) (csu k B2 (citg x3 A2 (co F (co G H cmul) cmul)))) $;

--| Move constants out of integrals or sums and/or commute sum and integral. (Contributed by metakunt, 26-Apr-2024.)
theorem _3factsumint2 {x3 k: setvar} (ph: wff) (A2: class x3 k) (B2: class) (F G H: class x3 k):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel F cc) $ >
  $ wi (wa ph (wcel (cv k) B2)) (wcel G cc) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv k) B2))) (wcel H cc) $ >
  $ wi ph (wceq (csu k B2 (citg x3 A2 (co F (co G H cmul) cmul))) (csu k B2 (citg x3 A2 (co G (co F H cmul) cmul)))) $;

--| Move constants out of integrals or sums and/or commute sum and integral. (Contributed by metakunt, 26-Apr-2024.)
theorem _3factsumint3 {x3 k: setvar} (ph: wff) (A2: class k) (B2: class) (U F: class x3 k) (G: class k) (H L: class x3 k):
  $ wceq A2 (co L U cicc) $ >
  $ wi ph (wcel L cr) $ >
  $ wi ph (wcel U cr) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel F cc) $ >
  $ wi ph (wcel (cmpt x3 A2 F) (co A2 cc ccncf)) $ >
  $ wi (wa ph (wcel (cv k) B2)) (wcel G cc) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv k) B2))) (wcel H cc) $ >
  $ wi (wa ph (wcel (cv k) B2)) (wcel (cmpt x3 A2 H) (co A2 cc ccncf)) $ >
  $ wi ph (wceq (csu k B2 (citg x3 A2 (co G (co F H cmul) cmul))) (csu k B2 (co G (citg x3 A2 (co F H cmul)) cmul))) $;

--| Move constants out of integrals or sums and/or commute sum and integral. (Contributed by metakunt, 26-Apr-2024.)
theorem _3factsumint4 {x3 k: setvar} (ph: wff) (A2 B2 F: class x3) (G H: class x3 k):
  $ wi ph (wcel B2 cfn) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel F cc) $ >
  $ wi (wa ph (wcel (cv k) B2)) (wcel G cc) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv k) B2))) (wcel H cc) $ >
  $ wi ph (wceq (citg x3 A2 (csu k B2 (co F (co G H cmul) cmul))) (citg x3 A2 (co F (csu k B2 (co G H cmul)) cmul))) $;

--| Helpful equation for lcm inequality proof. (Contributed by metakunt, 26-Apr-2024.)
theorem _3factsumint {x3 k: setvar} (ph: wff) (A2 B2: class) (U: class x3 k) (F: class x3) (G: class k) (H L: class x3 k):
  $ wceq A2 (co L U cicc) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wcel L cr) $ >
  $ wi ph (wcel U cr) $ >
  $ wi ph (wcel (cmpt x3 A2 F) (co A2 cc ccncf)) $ >
  $ wi (wa ph (wcel (cv k) B2)) (wcel G cc) $ >
  $ wi (wa ph (wcel (cv k) B2)) (wcel (cmpt x3 A2 H) (co A2 cc ccncf)) $ >
  $ wi ph (wceq (citg x3 A2 (co F (csu k B2 (co G H cmul)) cmul)) (csu k B2 (co G (citg x3 A2 (co F H cmul)) cmul))) $;

--| Restrict continuous function on open unit interval. (Contributed by metakunt, 12-May-2024.)
theorem resopunitintvd {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi ph (wcel (cmpt x3 cc A2) (co cc cc ccncf)) $ >
  $ wi ph (wcel (cmpt x3 (co cc0 c1 cioo) A2) (co (co cc0 c1 cioo) cc ccncf)) $;

--| Restrict continuous function on closed unit interval. (Contributed by metakunt, 12-May-2024.)
theorem resclunitintvd {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi ph (wcel (cmpt x3 cc A2) (co cc cc ccncf)) $ >
  $ wi ph (wcel (cmpt x3 (co cc0 c1 cicc) A2) (co (co cc0 c1 cicc) cc ccncf)) $;

--| Restrict derivative on unit interval. (Contributed by metakunt, 12-May-2024.)
theorem resdvopclptsd {x3: setvar} (ph: wff) (A2 B2: class x3):
  $ wi ph (wceq (co cc (cmpt x3 cc A2) cdv) (cmpt x3 cc B2)) $ >
  $ wi (wa ph (wcel (cv x3) cc)) (wcel A2 cc) $ >
  $ wi (wa ph (wcel (cv x3) cc)) (wcel B2 cc) $ >
  $ wi ph (wceq (co cr (cmpt x3 (co cc0 c1 cicc) A2) cdv) (cmpt x3 (co cc0 c1 cioo) B2)) $;

--| Part of lcm inequality lemma, this part eventually shows that F times the least common multiple of 1 to n is an integer. (Contributed by metakunt, 29-Apr-2024.)
theorem lcmineqlem1 {x3 k: setvar} (ph: wff) (F: class x3 k) (M N: class x3):
  $ wceq F (citg x3 (co cc0 c1 cicc) (co (co (cv x3) (co M c1 cmin) cexp) (co (co c1 (cv x3) cmin) (co N M cmin) cexp) cmul)) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel M cn) $ >
  $ wi ph (wbr M N cle) $ >
  $ wi ph (wceq F (citg x3 (co cc0 c1 cicc) (co (co (cv x3) (co M c1 cmin) cexp) (csu k (co cc0 (co N M cmin) cfz) (co (co (co (cneg c1) (cv k) cexp) (co (co N M cmin) (cv k) cbc) cmul) (co (cv x3) (cv k) cexp) cmul)) cmul))) $;

--| Part of lcm inequality lemma, this part eventually shows that F times the least common multiple of 1 to n is an integer. (Contributed by metakunt, 29-Apr-2024.)
theorem lcmineqlem2 {x3 k: setvar} (ph: wff) (F: class x3 k) (M N: class):
  $ wceq F (citg x3 (co cc0 c1 cicc) (co (co (cv x3) (co M c1 cmin) cexp) (co (co c1 (cv x3) cmin) (co N M cmin) cexp) cmul)) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel M cn) $ >
  $ wi ph (wbr M N cle) $ >
  $ wi ph (wceq F (csu k (co cc0 (co N M cmin) cfz) (co (co (co (cneg c1) (cv k) cexp) (co (co N M cmin) (cv k) cbc) cmul) (citg x3 (co cc0 c1 cicc) (co (co (cv x3) (co M c1 cmin) cexp) (co (cv x3) (cv k) cexp) cmul)) cmul))) $;

--| Part of lcm inequality lemma, this part eventually shows that F times the least common multiple of 1 to n is an integer. (Contributed by metakunt, 30-Apr-2024.)
theorem lcmineqlem3 {x3 k: setvar} (ph: wff) (F: class x3 k) (M N: class):
  $ wceq F (citg x3 (co cc0 c1 cicc) (co (co (cv x3) (co M c1 cmin) cexp) (co (co c1 (cv x3) cmin) (co N M cmin) cexp) cmul)) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel M cn) $ >
  $ wi ph (wbr M N cle) $ >
  $ wi ph (wceq F (csu k (co cc0 (co N M cmin) cfz) (co (co (co (cneg c1) (cv k) cexp) (co (co N M cmin) (cv k) cbc) cmul) (co c1 (co M (cv k) caddc) cdiv) cmul))) $;

--| Part of lcm inequality lemma, this part eventually shows that F times the least common multiple of 1 to n is an integer. F is found in ~ lcmineqlem6 . (Contributed by metakunt, 10-May-2024.)
theorem lcmineqlem4 (ph: wff) (K M N: class):
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel M cn) $ >
  $ wi ph (wbr M N cle) $ >
  $ wi ph (wcel K (co cc0 (co N M cmin) cfz)) $ >
  $ wi ph (wcel (co (cfv (co c1 N cfz) clcmf) (co M K caddc) cdiv) cz) $;

--| Technical lemma for reciprocal multiplication in deduction form. (Contributed by metakunt, 10-May-2024.)
theorem lcmineqlem5 (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wne C cc0) $ >
  $ wi ph (wceq (co A2 (co B2 (co c1 C cdiv) cmul) cmul) (co B2 (co A2 C cdiv) cmul)) $;

--| Part of lcm inequality lemma, this part eventually shows that F times the least common multiple of 1 to n is an integer. (Contributed by metakunt, 10-May-2024.)
theorem lcmineqlem6 {x3: setvar} (ph: wff) (F: class x3) (M N: class):
  $ wceq F (citg x3 (co cc0 c1 cicc) (co (co (cv x3) (co M c1 cmin) cexp) (co (co c1 (cv x3) cmin) (co N M cmin) cexp) cmul)) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel M cn) $ >
  $ wi ph (wbr M N cle) $ >
  $ wi ph (wcel (co (cfv (co c1 N cfz) clcmf) F cmul) cz) $;

--| Derivative of 1-x for chain rule application. (Contributed by metakunt, 12-May-2024.)
theorem lcmineqlem7 {x3: setvar}:
  $ wceq (co cc (cmpt x3 cc (co c1 (cv x3) cmin)) cdv) (cmpt x3 cc (cneg c1)) $;

--| Derivative of (1-x)^(N-M). (Contributed by metakunt, 12-May-2024.)
theorem lcmineqlem8 {x3: setvar} (ph: wff) (M N: class):
  $ wi ph (wcel M cn) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr M N clt) $ >
  $ wi ph (wceq (co cc (cmpt x3 cc (co (co c1 (cv x3) cmin) (co N M cmin) cexp)) cdv) (cmpt x3 cc (co (cneg (co N M cmin)) (co (co c1 (cv x3) cmin) (co (co N M cmin) c1 cmin) cexp) cmul))) $;

--| (1-x)^(N-M) is continuous. (Contributed by metakunt, 12-May-2024.)
theorem lcmineqlem9 {x3: setvar} (ph: wff) (M N: class):
  $ wi ph (wcel M cn) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr M N cle) $ >
  $ wi ph (wcel (cmpt x3 cc (co (co c1 (cv x3) cmin) (co N M cmin) cexp)) (co cc cc ccncf)) $;

--| Induction step of ~ lcmineqlem13 (deduction form). (Contributed by metakunt, 12-May-2024.)
theorem lcmineqlem10 {x3: setvar} (ph: wff) (M N: class):
  $ wi ph (wcel M cn) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr M N clt) $ >
  $ wi ph (wceq (citg x3 (co cc0 c1 cicc) (co (co (cv x3) (co (co M c1 caddc) c1 cmin) cexp) (co (co c1 (cv x3) cmin) (co N (co M c1 caddc) cmin) cexp) cmul)) (co (co M (co N M cmin) cdiv) (citg x3 (co cc0 c1 cicc) (co (co (cv x3) (co M c1 cmin) cexp) (co (co c1 (cv x3) cmin) (co N M cmin) cexp) cmul)) cmul)) $;

--| Induction step, continuation for binomial coefficients. (Contributed by metakunt, 12-May-2024.)
theorem lcmineqlem11 (ph: wff) (M N: class):
  $ wi ph (wcel M cn) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr M N clt) $ >
  $ wi ph (wceq (co c1 (co (co M c1 caddc) (co N (co M c1 caddc) cbc) cmul) cdiv) (co (co M (co N M cmin) cdiv) (co c1 (co M (co N M cbc) cmul) cdiv) cmul)) $;

--| Base case for induction. (Contributed by metakunt, 12-May-2024.)
theorem lcmineqlem12 {t: setvar} (ph: wff) (N: class):
  $ wi ph (wcel N cn) $ >
  $ wi ph (wceq (citg t (co cc0 c1 cicc) (co (co (cv t) (co c1 c1 cmin) cexp) (co (co c1 (cv t) cmin) (co N c1 cmin) cexp) cmul)) (co c1 (co c1 (co N c1 cbc) cmul) cdiv)) $;

--| Induction proof for lcm integral. (Contributed by metakunt, 12-May-2024.)
theorem lcmineqlem13 {x3: setvar} (ph: wff) (F: class x3) (M N: class):
  $ wceq F (citg x3 (co cc0 c1 cicc) (co (co (cv x3) (co M c1 cmin) cexp) (co (co c1 (cv x3) cmin) (co N M cmin) cexp) cmul)) $ >
  $ wi ph (wcel M cn) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr M N cle) $ >
  $ wi ph (wceq F (co c1 (co M (co N M cbc) cmul) cdiv)) $;

--| Technical lemma for inequality estimate. (Contributed by metakunt, 12-May-2024.)
theorem lcmineqlem14 (ph: wff) (A2 B2 C D E: class):
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wcel C cn) $ >
  $ wi ph (wcel D cn) $ >
  $ wi ph (wcel E cn) $ >
  $ wi ph (wbr (co A2 C cmul) D cdvds) $ >
  $ wi ph (wbr (co B2 C cmul) E cdvds) $ >
  $ wi ph (wbr D E cdvds) $ >
  $ wi ph (wceq (co A2 B2 cgcd) c1) $ >
  $ wi ph (wbr (co (co A2 B2 cmul) C cmul) E cdvds) $;

--| F times the least common multiple of 1 to n is a natural number. (Contributed by metakunt, 10-May-2024.)
theorem lcmineqlem15 {x3: setvar} (ph: wff) (F: class x3) (M N: class):
  $ wceq F (citg x3 (co cc0 c1 cicc) (co (co (cv x3) (co M c1 cmin) cexp) (co (co c1 (cv x3) cmin) (co N M cmin) cexp) cmul)) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel M cn) $ >
  $ wi ph (wbr M N cle) $ >
  $ wi ph (wcel (co (cfv (co c1 N cfz) clcmf) F cmul) cn) $;

--| Technical divisibility lemma. (Contributed by metakunt, 12-May-2024.)
theorem lcmineqlem16 (ph: wff) (M N: class):
  $ wi ph (wcel M cn) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr M N cle) $ >
  $ wi ph (wbr (co M (co N M cbc) cmul) (cfv (co c1 N cfz) clcmf) cdvds) $;

--| Inequality of 2^{2n}. (Contributed by metakunt, 29-Apr-2024.)
theorem lcmineqlem17 (ph: wff) (N: class):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wbr (co c2 (co c2 N cmul) cexp) (co (co (co c2 N cmul) c1 caddc) (co (co c2 N cmul) N cbc) cmul) cle) $;

--| Technical lemma to shift factors in binomial coefficient. (Contributed by metakunt, 12-May-2024.)
theorem lcmineqlem18 (ph: wff) (N: class):
  $ wi ph (wcel N cn) $ >
  $ wi ph (wceq (co (co N c1 caddc) (co (co (co c2 N cmul) c1 caddc) (co N c1 caddc) cbc) cmul) (co (co (co c2 N cmul) c1 caddc) (co (co c2 N cmul) N cbc) cmul)) $;

--| Dividing implies inequality for lcm inequality lemma. (Contributed by metakunt, 12-May-2024.)
theorem lcmineqlem19 (ph: wff) (N: class):
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr (co (co N (co (co c2 N cmul) c1 caddc) cmul) (co (co c2 N cmul) N cbc) cmul) (cfv (co c1 (co (co c2 N cmul) c1 caddc) cfz) clcmf) cdvds) $;

--| Inequality for lcm lemma. (Contributed by metakunt, 12-May-2024.)
theorem lcmineqlem20 (ph: wff) (N: class):
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr (co N (co c2 (co c2 N cmul) cexp) cmul) (cfv (co c1 (co (co c2 N cmul) c1 caddc) cfz) clcmf) cle) $;

--| The lcm inequality lemma without base cases 7 and 8. (Contributed by metakunt, 12-May-2024.)
theorem lcmineqlem21 (ph: wff) (N: class):
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr c4 N cle) $ >
  $ wi ph (wbr (co c2 (co (co c2 N cmul) c2 caddc) cexp) (cfv (co c1 (co (co c2 N cmul) c1 caddc) cfz) clcmf) cle) $;

--| The lcm inequality lemma without base cases 7 and 8. (Contributed by metakunt, 12-May-2024.)
theorem lcmineqlem22 (ph: wff) (N: class):
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr c4 N cle) $ >
  $ wi ph (wa (wbr (co c2 (co (co c2 N cmul) c1 caddc) cexp) (cfv (co c1 (co (co c2 N cmul) c1 caddc) cfz) clcmf) cle) (wbr (co c2 (co (co c2 N cmul) c2 caddc) cexp) (cfv (co c1 (co (co c2 N cmul) c2 caddc) cfz) clcmf) cle)) $;

--| Penultimate step to the lcm inequality lemma. (Contributed by metakunt, 12-May-2024.)
theorem lcmineqlem23 (ph: wff) (N: class):
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr c9 N cle) $ >
  $ wi ph (wbr (co c2 N cexp) (cfv (co c1 N cfz) clcmf) cle) $;

--| The least common multiple inequality lemma, a central result for future use. Theorem 3.1 from ~ https://www3.nd.edu/%7eandyp/notes/AKS.pdf (Contributed by metakunt, 16-May-2024.)
theorem lcmineqlem (ph: wff) (N: class):
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr c7 N cle) $ >
  $ wi ph (wbr (co c2 N cexp) (cfv (co c1 N cfz) clcmf) cle) $;

--| 3 to the power of 7 equals 2187. (Contributed by metakunt, 21-Aug-2024.)
theorem _3exp7:
  $ wceq (co c3 c7 cexp) (cdc (cdc (cdc c2 c1) c8) c7) $;

--| First inequality in inequality chain, proposed by Mario Carneiro (Contributed by metakunt, 22-May-2024.)
theorem _3lexlogpow5ineq1:
  $ wbr c9 (co (co (cdc c1 c1) c7 cdiv) c5 cexp) clt $;

--| Second inequality in inequality chain, proposed by Mario Carneiro. (Contributed by metakunt, 22-May-2024.)
theorem _3lexlogpow5ineq2 (ph: wff) (X: class):
  $ wi ph (wcel X cr) $ >
  $ wi ph (wbr c3 X cle) $ >
  $ wi ph (wbr (co (co (cdc c1 c1) c7 cdiv) c5 cexp) (co (co c2 X clogb) c5 cexp) cle) $;

--| Sharper logarithm inequality chain. (Contributed by metakunt, 21-Aug-2024.)
theorem _3lexlogpow5ineq4 (ph: wff) (X: class):
  $ wi ph (wcel X cr) $ >
  $ wi ph (wbr c3 X cle) $ >
  $ wi ph (wbr c9 (co (co c2 X clogb) c5 cexp) clt) $;

--| Combined inequality chain for a specific power of the binary logarithm, proposed by Mario Carneiro. (Contributed by metakunt, 22-May-2024.)
theorem _3lexlogpow5ineq3 (ph: wff) (X: class):
  $ wi ph (wcel X cr) $ >
  $ wi ph (wbr c3 X cle) $ >
  $ wi ph (wbr c7 (co (co c2 X clogb) c5 cexp) clt) $;

--| Result for bound in AKS inequality lemma. (Contributed by metakunt, 21-Aug-2024.)
theorem _3lexlogpow2ineq1:
  $ wa (wbr (co c3 c2 cdiv) (co c2 c3 clogb) clt) (wbr (co c2 c3 clogb) (co c5 c3 cdiv) clt) $;

--| Result for bound in AKS inequality lemma. (Contributed by metakunt, 21-Aug-2024.)
theorem _3lexlogpow2ineq2:
  $ wa (wbr c2 (co (co c2 c3 clogb) c2 cexp) clt) (wbr (co (co c2 c3 clogb) c2 cexp) c3 clt) $;

--| Result for bound in AKS inequality lemma. (Contributed by metakunt, 21-Aug-2024.)
theorem _3lexlogpow5ineq5:
  $ wbr (co (co c2 c3 clogb) c5 cexp) (cdc c1 c5) cle $;

--| Inequality inference by invoking fundamental theorem of calculus. (Contributed by metakunt, 22-Jul-2024.)
theorem intlewftc {x3: setvar} (ph: wff) (A2 B2: class) (D P Q E F G: class x3):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wi ph (wcel F (co (co A2 B2 cicc) cr ccncf)) $ >
  $ wi ph (wcel G (co (co A2 B2 cicc) cr ccncf)) $ >
  $ wi ph (wceq D (co cr F cdv)) $ >
  $ wi ph (wceq E (co cr G cdv)) $ >
  $ wi ph (wcel D (co (co A2 B2 cioo) cr ccncf)) $ >
  $ wi ph (wcel E (co (co A2 B2 cioo) cr ccncf)) $ >
  $ wi ph (wcel D cibl) $ >
  $ wi ph (wcel E cibl) $ >
  $ wi ph (wceq D (cmpt x3 (co A2 B2 cioo) P)) $ >
  $ wi ph (wceq E (cmpt x3 (co A2 B2 cioo) Q)) $ >
  $ wi (wa ph (wcel (cv x3) (co A2 B2 cioo))) (wbr P Q cle) $ >
  $ wi ph (wbr (cfv A2 F) (cfv A2 G) cle) $ >
  $ wi ph (wbr (cfv B2 F) (cfv B2 G) cle) $;

--| Technical lemma to reduce proof size. (Contributed by metakunt, 14-Nov-2024.)
theorem aks4d1lem1 (ph: wff) (B2 N: class):
  $ wi ph (wcel N (cfv c3 cuz)) $ >
  $ wceq B2 (cfv (co (co c2 N clogb) c5 cexp) cceil) $ >
  $ wi ph (wa (wcel B2 cn) (wbr c9 B2 clt)) $;

--| Exponential law for finite products, special case. (Contributed by metakunt, 22-Jul-2024.)
theorem aks4d1p1p1 {k: setvar} (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wceq (cprod k (co c1 N cfz) (co A2 (cv k) ccxp)) (co A2 (csu k (co c1 N cfz) (cv k)) ccxp)) $;

--| The derivative of the logarithm, ~ ftc2 version. (Contributed by metakunt, 11-Aug-2024.)
theorem dvrelog2 {x3: setvar} (ph: wff) (A2 B2: class) (F G: class x3):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr cc0 A2 clt) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wceq F (cmpt x3 (co A2 B2 cicc) (cfv (cv x3) clog)) $ >
  $ wceq G (cmpt x3 (co A2 B2 cioo) (co c1 (cv x3) cdiv)) $ >
  $ wi ph (wceq (co cr F cdv) G) $;

--| The derivative of the logarithm on an open interval. (Contributed by metakunt, 11-Aug-2024.)
theorem dvrelog3 {x3: setvar} (ph: wff) (A2 B2: class) (F G: class x3):
  $ wi ph (wcel A2 cxr) $ >
  $ wi ph (wcel B2 cxr) $ >
  $ wi ph (wbr cc0 A2 cle) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wceq F (cmpt x3 (co A2 B2 cioo) (cfv (cv x3) clog)) $ >
  $ wceq G (cmpt x3 (co A2 B2 cioo) (co c1 (cv x3) cdiv)) $ >
  $ wi ph (wceq (co cr F cdv) G) $;

--| Derivative of the binary logarithm. (Contributed by metakunt, 11-Aug-2024.)
theorem dvrelog2b {x3: setvar} (ph: wff) (A2 B2: class) (F G: class x3):
  $ wi ph (wcel A2 cxr) $ >
  $ wi ph (wcel B2 cxr) $ >
  $ wi ph (wbr cc0 A2 cle) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wceq F (cmpt x3 (co A2 B2 cioo) (co c2 (cv x3) clogb)) $ >
  $ wceq G (cmpt x3 (co A2 B2 cioo) (co c1 (co (cv x3) (cfv c2 clog) cmul) cdiv)) $ >
  $ wi ph (wceq (co cr F cdv) G) $;

--| Technical lemma for open interval. (Contributed by metakunt, 12-Aug-2024.)
theorem _0nonelalab (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr cc0 A2 clt) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wi ph (wcel C (co A2 B2 cioo)) $ >
  $ wi ph (wne cc0 C) $;

--| Derivative of the power of the binary logarithm. (Contributed by metakunt, 12-Aug-2024.)
theorem dvrelogpow2b {x3: setvar} (ph: wff) (A2 B2: class) (C F G: class x3) (N: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr cc0 A2 clt) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wceq F (cmpt x3 (co A2 B2 cioo) (co (co c2 (cv x3) clogb) N cexp)) $ >
  $ wceq G (cmpt x3 (co A2 B2 cioo) (co C (co (co (cfv (cv x3) clog) (co N c1 cmin) cexp) (cv x3) cdiv) cmul)) $ >
  $ wceq C (co N (co (cfv c2 clog) N cexp) cdiv) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wceq (co cr F cdv) G) $;

--| Bound of a ceiling of the binary logarithm to the fifth power. (Contributed by metakunt, 19-Aug-2024.)
theorem aks4d1p1p3 (ph: wff) (B2 N: class):
  $ wi ph (wcel N cn) $ >
  $ wceq B2 (cfv (co (co c2 N clogb) c5 cexp) cceil) $ >
  $ wi ph (wbr c3 N cle) $ >
  $ wi ph (wbr (co N (cfv (co c2 B2 clogb) cfl) ccxp) (co N (co c2 (co (co (co c2 N clogb) c5 cexp) c1 caddc) clogb) ccxp) clt) $;

--| Rewrite ` A ` in more suitable form. (Contributed by metakunt, 19-Aug-2024.)
theorem aks4d1p1p2 {k: setvar} (ph: wff) (A2 B2: class k) (N: class):
  $ wi ph (wcel N cn) $ >
  $ wceq A2 (co (co N (cfv (co c2 B2 clogb) cfl) cexp) (cprod k (co c1 (cfv (co (co c2 N clogb) c2 cexp) cfl) cfz) (co (co N (cv k) cexp) c1 cmin)) cmul) $ >
  $ wceq B2 (cfv (co (co c2 N clogb) c5 cexp) cceil) $ >
  $ wi ph (wbr c3 N cle) $ >
  $ wi ph (wbr A2 (co N (co (co (co c2 (co (co (co c2 N clogb) c5 cexp) c1 caddc) clogb) (co (co (co c2 N clogb) c2 cexp) c2 cdiv) caddc) (co (co (co c2 N clogb) c4 cexp) c2 cdiv) caddc) ccxp) clt) $;

--| Technical step for inequality. The hard work is in to prove the final hypothesis. (Contributed by metakunt, 19-Aug-2024.)
theorem aks4d1p1p4 {k: setvar} (ph: wff) (A2 B2 C D E: class k) (N: class):
  $ wi ph (wcel N cn) $ >
  $ wceq A2 (co (co N (cfv (co c2 B2 clogb) cfl) cexp) (cprod k (co c1 (cfv (co (co c2 N clogb) c2 cexp) cfl) cfz) (co (co N (cv k) cexp) c1 cmin)) cmul) $ >
  $ wceq B2 (cfv (co (co c2 N clogb) c5 cexp) cceil) $ >
  $ wi ph (wbr c3 N cle) $ >
  $ wceq C (co c2 (co (co (co c2 N clogb) c5 cexp) c1 caddc) clogb) $ >
  $ wceq D (co (co c2 N clogb) c2 cexp) $ >
  $ wceq E (co (co c2 N clogb) c4 cexp) $ >
  $ wi ph (wbr (co (co c2 C cmul) D caddc) E cle) $ >
  $ wi ph (wbr A2 (co c2 B2 cexp) clt) $;

--| Collapsed ~ dvle . (Contributed by metakunt, 19-Aug-2024.)
theorem dvle2 {x3: setvar} (ph: wff) (A2 B2 P Q R S: class) (E F G H: class x3):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel (cmpt x3 (co A2 B2 cicc) E) (co (co A2 B2 cicc) cr ccncf)) $ >
  $ wi ph (wcel (cmpt x3 (co A2 B2 cicc) G) (co (co A2 B2 cicc) cr ccncf)) $ >
  $ wi ph (wceq (co cr (cmpt x3 (co A2 B2 cioo) E) cdv) (cmpt x3 (co A2 B2 cioo) F)) $ >
  $ wi ph (wceq (co cr (cmpt x3 (co A2 B2 cioo) G) cdv) (cmpt x3 (co A2 B2 cioo) H)) $ >
  $ wi (wa ph (wcel (cv x3) (co A2 B2 cioo))) (wbr F H cle) $ >
  $ wi (wceq (cv x3) A2) (wceq E P) $ >
  $ wi (wceq (cv x3) A2) (wceq G Q) $ >
  $ wi (wceq (cv x3) B2) (wceq E R) $ >
  $ wi (wceq (cv x3) B2) (wceq G S) $ >
  $ wi ph (wbr P Q cle) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wi ph (wbr R S cle) $;

--| Inequality lift to differentiable functions for a term in AKS inequality lemma. (Contributed by metakunt, 19-Aug-2024.)
theorem aks4d1p1p6 {x3: setvar} (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr c3 A2 cle) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wi ph (wceq (co cr (cmpt x3 (co A2 B2 cioo) (co (co c2 (co c2 (co (co (co c2 (cv x3) clogb) c5 cexp) c1 caddc) clogb) cmul) (co (co c2 (cv x3) clogb) c2 cexp) caddc)) cdv) (cmpt x3 (co A2 B2 cioo) (co (co c2 (co (co c1 (co (co (co (co c2 (cv x3) clogb) c5 cexp) c1 caddc) (cfv c2 clog) cmul) cdiv) (co (co (co c5 (co (co c2 (cv x3) clogb) c4 cexp) cmul) (co c1 (co (cv x3) (cfv c2 clog) cmul) cdiv) cmul) cc0 caddc) cmul) cmul) (co (co c2 (co (cfv c2 clog) c2 cexp) cdiv) (co (co (cfv (cv x3) clog) (co c2 c1 cmin) cexp) (cv x3) cdiv) cmul) caddc))) $;

--| Bound of intermediary of inequality step. (Contributed by metakunt, 19-Aug-2024.)
theorem aks4d1p1p7 (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wbr c4 A2 cle) $ >
  $ wi ph (wbr (co (co c2 (co (co c1 (co (co (co (co c2 A2 clogb) c5 cexp) c1 caddc) (cfv c2 clog) cmul) cdiv) (co (co (co c5 (co (co c2 A2 clogb) c4 cexp) cmul) (co c1 (co A2 (cfv c2 clog) cmul) cdiv) cmul) cc0 caddc) cmul) cmul) (co (co c2 (co (cfv c2 clog) c2 cexp) cdiv) (co (co (cfv A2 clog) (co c2 c1 cmin) cexp) A2 cdiv) cmul) caddc) (co (co c4 (co (cfv c2 clog) c4 cexp) cdiv) (co (co (cfv A2 clog) c3 cexp) A2 cdiv) cmul) cle) $;

--| Show inequality for existence of a non-divisor. (Contributed by metakunt, 19-Aug-2024.)
theorem aks4d1p1p5 {k: setvar} (ph: wff) (A2 B2 C D E: class k) (N: class):
  $ wi ph (wcel N cn) $ >
  $ wceq A2 (co (co N (cfv (co c2 B2 clogb) cfl) cexp) (cprod k (co c1 (cfv (co (co c2 N clogb) c2 cexp) cfl) cfz) (co (co N (cv k) cexp) c1 cmin)) cmul) $ >
  $ wceq B2 (cfv (co (co c2 N clogb) c5 cexp) cceil) $ >
  $ wi ph (wbr c4 N cle) $ >
  $ wceq C (co c2 (co (co (co c2 N clogb) c5 cexp) c1 caddc) clogb) $ >
  $ wceq D (co (co c2 N clogb) c2 cexp) $ >
  $ wceq E (co (co c2 N clogb) c4 cexp) $ >
  $ wi ph (wbr A2 (co c2 B2 cexp) clt) $;

--| Show inequality for existence of a non-divisor. (Contributed by metakunt, 21-Aug-2024.)
theorem aks4d1p1 {k: setvar} (ph: wff) (A2 B2: class k) (N: class):
  $ wi ph (wcel N (cfv c3 cuz)) $ >
  $ wceq A2 (co (co N (cfv (co c2 B2 clogb) cfl) cexp) (cprod k (co c1 (cfv (co (co c2 N clogb) c2 cexp) cfl) cfz) (co (co N (cv k) cexp) c1 cmin)) cmul) $ >
  $ wceq B2 (cfv (co (co c2 N clogb) c5 cexp) cceil) $ >
  $ wi ph (wbr A2 (co c2 B2 cexp) clt) $;

--| Technical lemma for existence of non-divisor. (Contributed by metakunt, 27-Oct-2024.)
theorem aks4d1p2 {k: setvar} (ph: wff k) (A2 B2 N: class k):
  $ wi ph (wcel N (cfv c3 cuz)) $ >
  $ wceq A2 (co (co N (cfv (co c2 B2 clogb) cfl) cexp) (cprod k (co c1 (cfv (co (co c2 N clogb) c2 cexp) cfl) cfz) (co (co N (cv k) cexp) c1 cmin)) cmul) $ >
  $ wceq B2 (cfv (co (co c2 N clogb) c5 cexp) cceil) $ >
  $ wi ph (wbr (co c2 B2 cexp) (cfv (co c1 B2 cfz) clcmf) cle) $;

--| There exists a small enough number such that it does not divide ` A ` . (Contributed by metakunt, 27-Oct-2024.)
theorem aks4d1p3 {k r: setvar} (ph: wff r) (A2 B2: class k) (N: class r):
  $ wi ph (wcel N (cfv c3 cuz)) $ >
  $ wceq A2 (co (co N (cfv (co c2 B2 clogb) cfl) cexp) (cprod k (co c1 (cfv (co (co c2 N clogb) c2 cexp) cfl) cfz) (co (co N (cv k) cexp) c1 cmin)) cmul) $ >
  $ wceq B2 (cfv (co (co c2 N clogb) c5 cexp) cceil) $ >
  $ wi ph (wrex r (wn (wbr (cv r) A2 cdvds)) (co c1 B2 cfz)) $;

--| There exists a small enough number such that it does not divide ` A ` . (Contributed by metakunt, 28-Oct-2024.)
theorem aks4d1p4 {k r: setvar} (ph: wff r) (A2 B2 R: class k) (N: class r):
  $ wi ph (wcel N (cfv c3 cuz)) $ >
  $ wceq A2 (co (co N (cfv (co c2 B2 clogb) cfl) cexp) (cprod k (co c1 (cfv (co (co c2 N clogb) c2 cexp) cfl) cfz) (co (co N (cv k) cexp) c1 cmin)) cmul) $ >
  $ wceq B2 (cfv (co (co c2 N clogb) c5 cexp) cceil) $ >
  $ wceq R (cinf (crab r (wn (wbr (cv r) A2 cdvds)) (co c1 B2 cfz)) cr clt) $ >
  $ wi ph (wa (wcel R (co c1 B2 cfz)) (wn (wbr R A2 cdvds))) $;

--| Show that ` N ` and ` R ` are coprime for AKS existence theorem. Precondition will be eliminated in further theorem. (Contributed by metakunt, 30-Oct-2024.)
theorem aks4d1p5 {k r: setvar} (ph: wff r) (A2 B2 R: class k) (N: class):
  $ wi ph (wcel N (cfv c3 cuz)) $ >
  $ wceq A2 (co (co N (cfv (co c2 B2 clogb) cfl) cexp) (cprod k (co c1 (cfv (co (co c2 N clogb) c2 cexp) cfl) cfz) (co (co N (cv k) cexp) c1 cmin)) cmul) $ >
  $ wceq B2 (cfv (co (co c2 N clogb) c5 cexp) cceil) $ >
  $ wceq R (cinf (crab r (wn (wbr (cv r) A2 cdvds)) (co c1 B2 cfz)) cr clt) $ >
  $ wi (wa (wa ph (wbr c1 (co N R cgcd) clt)) (wbr (co R (co N R cgcd) cdiv) A2 cdvds)) (wn (wbr (co R (co N R cgcd) cdiv) A2 cdvds)) $ >
  $ wi ph (wceq (co N R cgcd) c1) $;

--| The maximal prime power exponent is smaller than the binary logarithm floor of ` B ` . (Contributed by metakunt, 30-Oct-2024.)
theorem aks4d1p6 {k r: setvar} (ph: wff r) (A2 B2: class k) (P: class k r) (R: class k) (K: class k r) (N: class r):
  $ wi ph (wcel N (cfv c3 cuz)) $ >
  $ wceq A2 (co (co N (cfv (co c2 B2 clogb) cfl) cexp) (cprod k (co c1 (cfv (co (co c2 N clogb) c2 cexp) cfl) cfz) (co (co N (cv k) cexp) c1 cmin)) cmul) $ >
  $ wceq B2 (cfv (co (co c2 N clogb) c5 cexp) cceil) $ >
  $ wceq R (cinf (crab r (wn (wbr (cv r) A2 cdvds)) (co c1 B2 cfz)) cr clt) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wbr P R cdvds) $ >
  $ wceq K (co P R cpc) $ >
  $ wi ph (wbr K (cfv (co c2 B2 clogb) cfl) cle) $;

--| Technical step in AKS lemma 4.1. (Contributed by metakunt, 31-Oct-2024.)
theorem aks4d1p7d1 {k r p: setvar} (ph: wff r) (A2: class k p) (B2: class k) (R: class) (N: class r):
  $ wi ph (wcel N (cfv c3 cuz)) $ >
  $ wceq A2 (co (co N (cfv (co c2 B2 clogb) cfl) cexp) (cprod k (co c1 (cfv (co (co c2 N clogb) c2 cexp) cfl) cfz) (co (co N (cv k) cexp) c1 cmin)) cmul) $ >
  $ wceq B2 (cfv (co (co c2 N clogb) c5 cexp) cceil) $ >
  $ wceq R (cinf (crab r (wn (wbr (cv r) A2 cdvds)) (co c1 B2 cfz)) cr clt) $ >
  $ wi ph (wral p (wi (wbr (cv p) R cdvds) (wbr (cv p) N cdvds)) cprime) $ >
  $ wi ph (wbr R (co N (cfv (co c2 B2 clogb) cfl) cexp) cdvds) $;

--| Technical step in AKS lemma 4.1. (Contributed by metakunt, 31-Oct-2024.)
theorem aks4d1p7 {k r p: setvar} (ph: wff r p) (A2 B2: class k p) (R: class) (N: class r):
  $ wi ph (wcel N (cfv c3 cuz)) $ >
  $ wceq A2 (co (co N (cfv (co c2 B2 clogb) cfl) cexp) (cprod k (co c1 (cfv (co (co c2 N clogb) c2 cexp) cfl) cfz) (co (co N (cv k) cexp) c1 cmin)) cmul) $ >
  $ wceq B2 (cfv (co (co c2 N clogb) c5 cexp) cceil) $ >
  $ wceq R (cinf (crab r (wn (wbr (cv r) A2 cdvds)) (co c1 B2 cfz)) cr clt) $ >
  $ wi ph (wrex p (wa (wbr (cv p) R cdvds) (wn (wbr (cv p) N cdvds))) cprime) $;

--| If a prime divides one number ` M ` , but not another number ` N ` , then it divides the quotient of ` M ` and the gcd of ` M ` and ` N ` . (Contributed by Thierry Arnoux, 10-Nov-2024.)
theorem aks4d1p8d1 (ph: wff) (P M N: class):
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel M cn) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr P M cdvds) $ >
  $ wi ph (wn (wbr P N cdvds)) $ >
  $ wi ph (wbr P (co M (co M N cgcd) cdiv) cdvds) $;

--| Any prime power dividing a positive integer is less than that integer if that integer has another prime factor. (Contributed by metakunt, 13-Nov-2024.)
theorem aks4d1p8d2 (ph: wff) (P Q R N: class):
  $ wi ph (wcel R cn) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel Q cprime) $ >
  $ wi ph (wbr P R cdvds) $ >
  $ wi ph (wbr Q R cdvds) $ >
  $ wi ph (wn (wbr P N cdvds)) $ >
  $ wi ph (wbr Q N cdvds) $ >
  $ wi ph (wbr (co P (co P R cpc) cexp) R clt) $;

--| The remainder of a division with its maximal prime power is coprime with that prime power. (Contributed by metakunt, 13-Nov-2024.)
theorem aks4d1p8d3 (ph: wff) (P N: class):
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wbr P N cdvds) $ >
  $ wi ph (wceq (co (co N (co P (co P N cpc) cexp) cdiv) (co P (co P N cpc) cexp) cgcd) c1) $;

--| Show that ` N ` and ` R ` are coprime for AKS existence theorem, with eliminated hypothesis. (Contributed by metakunt, 10-Nov-2024.) (Proof sketch by Thierry Arnoux.)
theorem aks4d1p8 {k r: setvar} (ph: wff r) (A2 B2: class k) (R N: class):
  $ wi ph (wcel N (cfv c3 cuz)) $ >
  $ wceq A2 (co (co N (cfv (co c2 B2 clogb) cfl) cexp) (cprod k (co c1 (cfv (co (co c2 N clogb) c2 cexp) cfl) cfz) (co (co N (cv k) cexp) c1 cmin)) cmul) $ >
  $ wceq B2 (cfv (co (co c2 N clogb) c5 cexp) cceil) $ >
  $ wceq R (cinf (crab r (wn (wbr (cv r) A2 cdvds)) (co c1 B2 cfz)) cr clt) $ >
  $ wi ph (wceq (co N R cgcd) c1) $;

--| Show that the order is bound by the squared binary logarithm. (Contributed by metakunt, 14-Nov-2024.)
theorem aks4d1p9 {k r: setvar} (ph: wff r) (A2 B2: class k) (R N: class):
  $ wi ph (wcel N (cfv c3 cuz)) $ >
  $ wceq A2 (co (co N (cfv (co c2 B2 clogb) cfl) cexp) (cprod k (co c1 (cfv (co (co c2 N clogb) c2 cexp) cfl) cfz) (co (co N (cv k) cexp) c1 cmin)) cmul) $ >
  $ wceq B2 (cfv (co (co c2 N clogb) c5 cexp) cceil) $ >
  $ wceq R (cinf (crab r (wn (wbr (cv r) A2 cdvds)) (co c1 B2 cfz)) cr clt) $ >
  $ wi ph (wbr (co (co c2 N clogb) c2 cexp) (cfv N (cfv R codz)) clt) $;

--| Lemma 4.1 from ~ https://www3.nd.edu/%7eandyp/notes/AKS.pdf , existence of a polynomially bounded number by the digit size of ` N ` that asserts the polynomial subspace that we need to search to guarantee that ` N ` is prime. Eventually we want to show that the polynomial searching space is bounded by degree ` B ` . (Contributed by metakunt, 14-Nov-2024.)
theorem aks4d1 {r: setvar} (ph: wff) (B2 N: class):
  $ wi ph (wcel N (cfv c3 cuz)) $ >
  $ wceq B2 (cfv (co (co c2 N clogb) c5 cexp) cceil) $ >
  $ wi ph (wrex r (wa (wceq (co N (cv r) cgcd) c1) (wbr (co (co c2 N clogb) c2 cexp) (cfv N (cfv (cv r) codz)) clt)) (co c1 B2 cfz)) $;

--| A field homomorphism is injective. This follows immediately from the definition of the ring homomorphism that sends the multiplicative identity to the multiplicative identity. (Contributed by metakunt, 7-Jan-2025.)
theorem fldhmf1 (ph: wff) (A2 B2 F K L: class):
  $ wi ph (wcel K cfield) $ >
  $ wi ph (wcel L cfield) $ >
  $ wi ph (wcel F (co K L crh)) $ >
  $ wceq A2 (cfv K cbs) $ >
  $ wceq B2 (cfv L cbs) $ >
  $ wi ph (wf1 A2 B2 F) $;

--| Define the class of primitive roots. (Contributed by metakunt, 25-Apr-2025.)
term cprimroots: class;

--| A ` r ` -th primitive root is a root of unity such that the exponent divides ` r ` . (Contributed by metakunt, 25-Apr-2025.)
axiom df_primroots {k r a b l: setvar}:
  $ wceq cprimroots (cmpo r k ccmn cn0 (csb b (cfv (cv r) cbs) (crab a (wa (wceq (co (cv k) (cv a) (cfv (cv r) cmg)) (cfv (cv r) c0g)) (wral l (wi (wceq (co (cv l) (cv a) (cfv (cv r) cmg)) (cfv (cv r) c0g)) (wbr (cv k) (cv l) cdvds)) cn0)) (cv b)))) $;

--| The value of a primitive root. (Contributed by metakunt, 25-Apr-2025.)
theorem isprimroot {l: setvar} (ph: wff) (R: class) (c_ex: class l) (K M: class):
  $ wi ph (wcel R ccmn) $ >
  $ wi ph (wcel K cn0) $ >
  $ wceq c_ex (cfv R cmg) $ >
  $ wi ph (wb (wcel M (co R K cprimroots)) (w3a (wcel M (cfv R cbs)) (wceq (co K M c_ex) (cfv R c0g)) (wral l (wi (wceq (co (cv l) M c_ex) (cfv R c0g)) (wbr K (cv l) cdvds)) cn0))) $;

--| Alternative way of creating primitive roots. (Contributed by metakunt, 14-Jul-2025.)
theorem isprimroot2 (ph: wff) (R K M: class):
  $ wi ph (wcel R ccmn) $ >
  $ wi ph (wcel K cn) $ >
  $ wi ph (wcel M (cfv R cbs)) $ >
  $ wi ph (wceq (cfv M (cfv R cod)) K) $ >
  $ wi ph (wcel M (co R K cprimroots)) $;

--| An element of a monoid that has a right inverse has at most one left inverse. (Contributed by metakunt, 25-Apr-2025.)
theorem mndmolinv {x3: setvar} (ph: wff) (A2 B2 M: class):
  $ wceq B2 (cfv M cbs) $ >
  $ wi ph (wcel M cmnd) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wrex x3 (wceq (co A2 (cv x3) (cfv M cplusg)) (cfv M c0g)) B2) $ >
  $ wi ph (wrmo x3 (wceq (co (cv x3) A2 (cfv M cplusg)) (cfv M c0g)) B2) $;

--| If an element has a unique left inverse, then the value satisfies the left inverse value equation. (Contributed by metakunt, 25-Apr-2025.)
theorem linvh {i: setvar} (ph: wff i) (R X: class):
  $ wi ph (wcel X (cfv R cbs)) $ >
  $ wi ph (wreu i (wceq (co (cv i) X (cfv R cplusg)) (cfv R c0g)) (cfv R cbs)) $ >
  $ wi ph (wceq (co (cfv X (cfv R cminusg)) X (cfv R cplusg)) (cfv R c0g)) $;

--| Primitive roots have left inverses. (Contributed by metakunt, 25-Apr-2025.)
theorem primrootsunit1 {i a: setvar} (ph: wff a) (R: class) (U K: class a):
  $ wi ph (wcel R ccmn) $ >
  $ wi ph (wcel K cn) $ >
  $ wceq U (crab a (wrex i (wceq (co (cv i) (cv a) (cfv R cplusg)) (cfv R c0g)) (cfv R cbs)) (cfv R cbs)) $ >
  $ wi ph (wa (wceq (co R K cprimroots) (co (co R U cress) K cprimroots)) (wcel (co R U cress) cabl)) $;

--| Primitive roots have left inverses. (Contributed by metakunt, 25-Apr-2025.)
theorem primrootsunit {i a: setvar} (ph: wff i a) (R: class) (U K: class i a):
  $ wi ph (wcel R ccmn) $ >
  $ wi ph (wcel K cn) $ >
  $ wceq U (crab a (wrex i (wceq (co (cv i) (cv a) (cfv R cplusg)) (cfv R c0g)) (cfv R cbs)) (cfv R cbs)) $ >
  $ wi ph (wa (wceq (co R K cprimroots) (co (co R U cress) K cprimroots)) (wcel (co R U cress) cabl)) $;

--| Coprime powers of primitive roots are primitive roots. (Contributed by metakunt, 25-Apr-2025.)
theorem primrootscoprmpow {i a: setvar} (ph: wff a) (R: class) (U E K M: class i a):
  $ wi ph (wcel R ccmn) $ >
  $ wi ph (wcel K cn) $ >
  $ wi ph (wcel E cn) $ >
  $ wi ph (wceq (co E K cgcd) c1) $ >
  $ wi ph (wcel M (co R K cprimroots)) $ >
  $ wceq U (crab a (wrex i (wceq (co (cv i) (cv a) (cfv R cplusg)) (cfv R c0g)) (cfv R cbs)) (cfv R cbs)) $ >
  $ wi ph (wcel (co E M (cfv R cmg)) (co R K cprimroots)) $;

--| Bezout's identity restricted on positive integers in all but one variable. (Contributed by metakunt, 26-Apr-2025.)
theorem posbezout {x3 y1: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cn) (wcel B2 cn)) (wrex x3 (wrex y1 (wceq (co A2 B2 cgcd) (co (co A2 (cv x3) cmul) (co B2 (cv y1) cmul) caddc)) cz) cn) $;

--| Coprime powers of primitive roots are primitive roots, as a function. (Contributed by metakunt, 26-Apr-2025.)
theorem primrootscoprf {m: setvar} (ph: wff) (R: class) (E F: class m) (K: class):
  $ wceq F (cmpt m (co R K cprimroots) (co E (cv m) (cfv R cmg))) $ >
  $ wi ph (wcel R ccmn) $ >
  $ wi ph (wcel K cn) $ >
  $ wi ph (wcel E cn) $ >
  $ wi ph (wceq (co E K cgcd) c1) $ >
  $ wi ph (wf (co R K cprimroots) (co R K cprimroots) F) $;

--| A bijection between coprime powers of primitive roots and primitive roots. (Contributed by metakunt, 26-Apr-2025.)
theorem primrootscoprbij {i m a: setvar} (ph: wff a) (R: class) (U F: class i m a) (I J K: class i a) (Z: class i m a):
  $ wceq F (cmpt m (co R K cprimroots) (co I (cv m) (cfv R cmg))) $ >
  $ wi ph (wcel R ccmn) $ >
  $ wi ph (wcel K cn) $ >
  $ wi ph (wcel I cn) $ >
  $ wi ph (wcel J cn) $ >
  $ wi ph (wcel Z cz) $ >
  $ wi ph (wceq c1 (co (co I J cmul) (co K Z cmul) caddc)) $ >
  $ wceq U (crab a (wrex i (wceq (co (cv i) (cv a) (cfv R cplusg)) (cfv R c0g)) (cfv R cbs)) (cfv R cbs)) $ >
  $ wi ph (wf1o (co R K cprimroots) (co R K cprimroots) F) $;

--| A bijection between coprime powers of primitive roots and primitive roots. (Contributed by metakunt, 26-Apr-2025.)
theorem primrootscoprbij2 {m: setvar} (ph: wff) (R: class) (F: class m) (I K: class):
  $ wceq F (cmpt m (co R K cprimroots) (co I (cv m) (cfv R cmg))) $ >
  $ wi ph (wcel R ccmn) $ >
  $ wi ph (wcel K cn) $ >
  $ wi ph (wcel I cn) $ >
  $ wi ph (wceq (co I K cgcd) c1) $ >
  $ wi ph (wf1o (co R K cprimroots) (co R K cprimroots) F) $;

--| Division with rest. (Contributed by metakunt, 15-May-2025.)
theorem remexz {x3 y1: setvar} (ph: wff) (A2 N: class):
  $ wi ph (wcel N cz) $ >
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wrex x3 (wrex y1 (wceq N (co (co (cv x3) A2 cmul) (cv y1) caddc)) (co cc0 (co A2 c1 cmin) cfz)) cz) $;

--| There is no smaller power of a primitive root that sends it to the neutral element. (Contributed by metakunt, 15-May-2025.)
theorem primrootlekpowne0 (ph: wff) (R K M N: class):
  $ wi ph (wcel R ccmn) $ >
  $ wi ph (wcel K cn) $ >
  $ wi ph (wcel M (co R K cprimroots)) $ >
  $ wi ph (wcel N (co c1 (co K c1 cmin) cfz)) $ >
  $ wi ph (wne (co N M (cfv R cmg)) (cfv R c0g)) $;

--| The power of a ` R ` -th primitive root is zero if and only if it divides ` R ` . (Contributed by metakunt, 15-May-2025.)
theorem primrootspoweq0 {i a: setvar} (ph: wff i a) (R: class) (U K M N: class i a):
  $ wi ph (wcel R ccmn) $ >
  $ wi ph (wcel K cn) $ >
  $ wi ph (wcel M (co R K cprimroots)) $ >
  $ wceq U (crab a (wrex i (wceq (co (cv i) (cv a) (cfv R cplusg)) (cfv R c0g)) (cfv R cbs)) (cfv R cbs)) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wb (wceq (co N M (cfv (co R U cress) cmg)) (cfv (co R U cress) c0g)) (wbr K N cdvds)) $;

--| Definition of the introspective relation. (Contributed by metakunt, 25-Apr-2025.)
theorem aks6d1c1p1 {y1 e f2: setvar} (ph: wff y1 e f2) (B2 D: class y1) (c_sm: class y1 e f2) (R: class y1) (E: class) (c_ex: class y1) (F: class) (K O: class y1):
  $ wceq c_sm (copab e f2 (w3a (wcel (cv e) cn) (wcel (cv f2) B2) (wral y1 (wceq (co (cv e) (cfv (cv y1) (cfv (cv f2) O)) c_ex) (cfv (co (cv e) (cv y1) D) (cfv (cv f2) O))) (co K R cprimroots)))) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel E cn) $ >
  $ wi ph (wb (wbr E F c_sm) (wral y1 (wceq (co E (cfv (cv y1) (cfv F O)) c_ex) (cfv (co E (cv y1) D) (cfv F O))) (co K R cprimroots))) $;

--| Reverse closure of the introspective relation. (Contributed by metakunt, 25-Apr-2025.)
theorem aks6d1c1p1rcl {y1 e f2: setvar} (ph: wff y1 e f2) (B2: class y1) (D c_sm R E c_ex F K O: class y1 e f2):
  $ wceq c_sm (copab e f2 (w3a (wcel (cv e) cn) (wcel (cv f2) B2) (wral y1 (wceq (co (cv e) (cfv (cv y1) (cfv (cv f2) O)) c_ex) (cfv (co (cv e) (cv y1) D) (cfv (cv f2) O))) (co K R cprimroots)))) $ >
  $ wi ph (wbr E F c_sm) $ >
  $ wi ph (wa (wcel E cn) (wcel F B2)) $;

--| ` P ` and linear factors are introspective. (Contributed by metakunt, 25-Apr-2025.)
theorem aks6d1c1p2 {y1 e f2: setvar} (ph: wff e f2) (A2: class y1 e f2) (B2: class y1) (C D: class y1 e f2) (P: class) (c_pl c_sm: class y1 e f2) (R: class y1) (S: class y1 e f2) (c_ex: class y1) (F: class) (K N: class y1 e f2) (O V: class y1) (W X: class y1 e f2):
  $ wceq c_sm (copab e f2 (w3a (wcel (cv e) cn) (wcel (cv f2) B2) (wral y1 (wceq (co (cv e) (cfv (cv y1) (cfv (cv f2) O)) c_ex) (cfv (co (cv e) (cv y1) c_ex) (cfv (cv f2) O))) (co V R cprimroots)))) $ >
  $ wceq S (cfv K cpl1) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq X (cfv K cv1) $ >
  $ wceq W (cfv S cmgp) $ >
  $ wceq V (cfv K cmgp) $ >
  $ wceq c_ex (cfv V cmg) $ >
  $ wceq C (cfv S cascl) $ >
  $ wceq D (cfv W cmg) $ >
  $ wceq P (cfv K cchr) $ >
  $ wceq O (cfv K ce1) $ >
  $ wceq c_pl (cfv S cplusg) $ >
  $ wi ph (wcel K cfield) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel R cn) $ >
  $ wi ph (wceq (co N R cgcd) c1) $ >
  $ wi ph (wbr P N cdvds) $ >
  $ wceq F (co X (cfv (cfv A2 (cfv K czrh)) C) c_pl) $ >
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wbr P F c_sm) $;

--| In a field with a Frobenius isomorphism (read: algebraic closure or finite field), ` N ` and linear factors are introspective. (Contributed by metakunt, 25-Apr-2025.)
theorem aks6d1c1p3 {x3 y1 e f2: setvar} (ph: wff e f2) (A2: class y1 e f2) (B2: class x3 y1) (C D: class x3 y1 e f2) (P: class) (c_pl c_sm: class x3 y1 e f2) (R: class) (S: class x3 y1 e f2) (c_ex: class) (F: class x3) (K: class y1 e f2) (N: class) (O: class x3) (V: class) (W X: class x3 y1 e f2):
  $ wceq c_sm (copab e f2 (w3a (wcel (cv e) cn) (wcel (cv f2) B2) (wral y1 (wceq (co (cv e) (cfv (cv y1) (cfv (cv f2) O)) c_ex) (cfv (co (cv e) (cv y1) c_ex) (cfv (cv f2) O))) (co V R cprimroots)))) $ >
  $ wceq S (cfv K cpl1) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq X (cfv K cv1) $ >
  $ wceq W (cfv S cmgp) $ >
  $ wceq V (cfv K cmgp) $ >
  $ wceq c_ex (cfv V cmg) $ >
  $ wceq C (cfv S cascl) $ >
  $ wceq D (cfv W cmg) $ >
  $ wceq P (cfv K cchr) $ >
  $ wceq O (cfv K ce1) $ >
  $ wceq c_pl (cfv S cplusg) $ >
  $ wi ph (wcel K cfield) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel R cn) $ >
  $ wi ph (wceq (co N R cgcd) c1) $ >
  $ wi ph (wbr P N cdvds) $ >
  $ wceq F (co X (cfv (cfv A2 (cfv K czrh)) C) c_pl) $ >
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wbr N F c_sm) $ >
  $ wi ph (wcel (cmpt x3 (cfv K cbs) (co P (cv x3) c_ex)) (co K K crs)) $ >
  $ wi ph (wbr (co N P cdiv) F c_sm) $;

--| The product of polynomials is introspective. (Contributed by metakunt, 25-Apr-2025.)
theorem aks6d1c1p4 {y1 e f2: setvar} (ph: wff e f2) (B2: class y1) (C D P c_pl c_sm: class y1 e f2) (R: class) (S: class y1 e f2) (E c_ex F G: class) (K N: class y1 e f2) (O V W: class) (X: class y1 e f2):
  $ wceq c_sm (copab e f2 (w3a (wcel (cv e) cn) (wcel (cv f2) B2) (wral y1 (wceq (co (cv e) (cfv (cv y1) (cfv (cv f2) O)) c_ex) (cfv (co (cv e) (cv y1) c_ex) (cfv (cv f2) O))) (co V R cprimroots)))) $ >
  $ wceq S (cfv K cpl1) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq X (cfv K cv1) $ >
  $ wceq W (cfv S cmgp) $ >
  $ wceq V (cfv K cmgp) $ >
  $ wceq c_ex (cfv V cmg) $ >
  $ wceq C (cfv S cascl) $ >
  $ wceq D (cfv W cmg) $ >
  $ wceq P (cfv K cchr) $ >
  $ wceq O (cfv K ce1) $ >
  $ wceq c_pl (cfv S cplusg) $ >
  $ wi ph (wcel K cfield) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel R cn) $ >
  $ wi ph (wceq (co N R cgcd) c1) $ >
  $ wi ph (wbr P N cdvds) $ >
  $ wi ph (wbr E F c_sm) $ >
  $ wi ph (wbr E G c_sm) $ >
  $ wi ph (wbr E (co F G (cfv W cplusg)) c_sm) $;

--| The product of exponents is introspective. (Contributed by metakunt, 26-Apr-2025.)
theorem aks6d1c1p5 {y1 e f2: setvar} (ph: wff e f2) (B2: class y1) (C: class y1 e f2) (D: class) (P c_pl c_sm: class y1 e f2) (R: class) (S: class y1 e f2) (E c_ex F: class) (K N: class y1 e f2) (O V: class) (W X: class y1 e f2):
  $ wceq c_sm (copab e f2 (w3a (wcel (cv e) cn) (wcel (cv f2) B2) (wral y1 (wceq (co (cv e) (cfv (cv y1) (cfv (cv f2) O)) c_ex) (cfv (co (cv e) (cv y1) c_ex) (cfv (cv f2) O))) (co V R cprimroots)))) $ >
  $ wceq S (cfv K cpl1) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq X (cfv K cv1) $ >
  $ wceq W (cfv S cmgp) $ >
  $ wceq V (cfv K cmgp) $ >
  $ wceq c_ex (cfv V cmg) $ >
  $ wceq C (cfv S cascl) $ >
  $ wceq P (cfv K cchr) $ >
  $ wceq O (cfv K ce1) $ >
  $ wceq c_pl (cfv S cplusg) $ >
  $ wi ph (wcel K cfield) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel R cn) $ >
  $ wi ph (wceq (co E R cgcd) c1) $ >
  $ wi ph (wbr P N cdvds) $ >
  $ wi ph (wbr D F c_sm) $ >
  $ wi ph (wbr E F c_sm) $ >
  $ wi ph (wbr (co D E cmul) F c_sm) $;

--| ` X ` is introspective to all positive integers. (Contributed by metakunt, 30-Apr-2025.)
theorem aks6d1c1p7 {y1 e f2: setvar} (ph: wff e f2) (B2: class y1) (P c_sm: class y1 e f2) (R: class y1) (S: class y1 e f2) (c_ex: class y1) (K: class y1 e f2) (L: class) (N: class y1 e f2) (O V: class y1) (X: class):
  $ wceq c_sm (copab e f2 (w3a (wcel (cv e) cn) (wcel (cv f2) B2) (wral y1 (wceq (co (cv e) (cfv (cv y1) (cfv (cv f2) O)) c_ex) (cfv (co (cv e) (cv y1) c_ex) (cfv (cv f2) O))) (co V R cprimroots)))) $ >
  $ wceq S (cfv K cpl1) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq X (cfv K cv1) $ >
  $ wceq V (cfv K cmgp) $ >
  $ wceq c_ex (cfv V cmg) $ >
  $ wceq P (cfv K cchr) $ >
  $ wceq O (cfv K ce1) $ >
  $ wi ph (wcel K cfield) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel R cn) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr P N cdvds) $ >
  $ wi ph (wceq (co N R cgcd) c1) $ >
  $ wi ph (wcel L cn) $ >
  $ wi ph (wbr L X c_sm) $;

--| If a polynomials ` F ` is introspective to ` E ` , then so are its powers. (Contributed by metakunt, 30-Apr-2025.)
theorem aks6d1c1p6 {y1 e f2: setvar} (ph: wff e f2) (B2: class y1) (C: class y1 e f2) (D: class) (P c_pl: class y1 e f2) (c_sm: class e f2) (R: class) (S: class y1 e f2) (E c_ex F: class) (K L N: class y1 e f2) (O V W: class) (X: class y1 e f2):
  $ wceq c_sm (copab e f2 (w3a (wcel (cv e) cn) (wcel (cv f2) B2) (wral y1 (wceq (co (cv e) (cfv (cv y1) (cfv (cv f2) O)) c_ex) (cfv (co (cv e) (cv y1) c_ex) (cfv (cv f2) O))) (co V R cprimroots)))) $ >
  $ wceq S (cfv K cpl1) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq X (cfv K cv1) $ >
  $ wceq W (cfv S cmgp) $ >
  $ wceq V (cfv K cmgp) $ >
  $ wceq c_ex (cfv V cmg) $ >
  $ wceq C (cfv S cascl) $ >
  $ wceq D (cfv W cmg) $ >
  $ wceq P (cfv K cchr) $ >
  $ wceq O (cfv K ce1) $ >
  $ wceq c_pl (cfv S cplusg) $ >
  $ wi ph (wcel K cfield) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel R cn) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr P N cdvds) $ >
  $ wi ph (wceq (co N R cgcd) c1) $ >
  $ wi ph (wbr E F c_sm) $ >
  $ wi ph (wcel L cn0) $ >
  $ wi ph (wbr E (co L F D) c_sm) $;

--| If a number ` E ` is introspective to ` F ` , then so are its powers. (Contributed by metakunt, 30-Apr-2025.)
theorem aks6d1c1p8 {y1 e f2: setvar} (ph: wff e f2) (B2: class y1) (C D P c_pl: class y1 e f2) (c_sm: class e f2) (R: class) (S: class y1 e f2) (E c_ex F: class) (K L N: class y1 e f2) (O V: class) (W X: class y1 e f2):
  $ wceq c_sm (copab e f2 (w3a (wcel (cv e) cn) (wcel (cv f2) B2) (wral y1 (wceq (co (cv e) (cfv (cv y1) (cfv (cv f2) O)) c_ex) (cfv (co (cv e) (cv y1) c_ex) (cfv (cv f2) O))) (co V R cprimroots)))) $ >
  $ wceq S (cfv K cpl1) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq X (cfv K cv1) $ >
  $ wceq W (cfv S cmgp) $ >
  $ wceq V (cfv K cmgp) $ >
  $ wceq c_ex (cfv V cmg) $ >
  $ wceq C (cfv S cascl) $ >
  $ wceq D (cfv W cmg) $ >
  $ wceq P (cfv K cchr) $ >
  $ wceq O (cfv K ce1) $ >
  $ wceq c_pl (cfv S cplusg) $ >
  $ wi ph (wcel K cfield) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel R cn) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr P N cdvds) $ >
  $ wi ph (wceq (co N R cgcd) c1) $ >
  $ wi ph (wbr E F c_sm) $ >
  $ wi ph (wcel L cn0) $ >
  $ wi ph (wceq (co E R cgcd) c1) $ >
  $ wi ph (wbr (co E L cexp) F c_sm) $;

--| Claim 1 of Theorem 6.1 ~ https://www3.nd.edu/%7eandyp/notes/AKS.pdf . (Contributed by metakunt, 30-Apr-2025.)
theorem aks6d1c1 {x3 y1 e f2 g2 i a: setvar} (ph: wff e f2) (A2: class e f2) (B2: class x3 y1 g2 i a) (C: class x3) (D: class x3 a) (P: class g2 i a) (c_pl: class x3) (c_sm: class x3 e f2 g2 i) (R: class g2 i a) (S: class x3 y1 e f2 g2 i a) (U E: class x3 g2 i a) (c_ex: class g2 i a) (F: class x3 a) (G: class x3 y1 e f2 g2 i a) (K: class) (L: class x3 g2 i a) (N: class g2 i) (O: class x3 g2 i a) (V: class g2 i a) (W: class x3 a) (X: class x3):
  $ wceq c_sm (copab e f2 (w3a (wcel (cv e) cn) (wcel (cv f2) B2) (wral y1 (wceq (co (cv e) (cfv (cv y1) (cfv (cv f2) O)) c_ex) (cfv (co (cv e) (cv y1) c_ex) (cfv (cv f2) O))) (co V R cprimroots)))) $ >
  $ wceq S (cfv K cpl1) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq X (cfv K cv1) $ >
  $ wceq W (cfv S cmgp) $ >
  $ wceq V (cfv K cmgp) $ >
  $ wceq c_ex (cfv V cmg) $ >
  $ wceq C (cfv S cascl) $ >
  $ wceq D (cfv W cmg) $ >
  $ wceq P (cfv K cchr) $ >
  $ wceq O (cfv K ce1) $ >
  $ wceq c_pl (cfv S cplusg) $ >
  $ wi ph (wcel K cfield) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel R cn) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr P N cdvds) $ >
  $ wi ph (wceq (co N R cgcd) c1) $ >
  $ wi ph (wf (co cc0 A2 cfz) cn0 F) $ >
  $ wceq G (cmpt g2 (co cn0 (co cc0 A2 cfz) cmap) (co W (cmpt i (co cc0 A2 cfz) (co (cfv (cv i) (cv g2)) (co X (cfv (cfv (cv i) (cfv K czrh)) C) c_pl) D)) cgsu)) $ >
  $ wi ph (wcel A2 cn0) $ >
  $ wi ph (wcel U cn0) $ >
  $ wi ph (wcel L cn0) $ >
  $ wceq E (co (co P U cexp) (co (co N P cdiv) L cexp) cmul) $ >
  $ wi ph (wral a (wbr N (co X (cfv (cfv (cv a) (cfv K czrh)) C) c_pl) c_sm) (co c1 A2 cfz)) $ >
  $ wi ph (wcel (cmpt x3 (cfv K cbs) (co P (cv x3) c_ex)) (co K K crs)) $ >
  $ wi ph (wbr E (cfv F G) c_sm) $;

--| Polynomial evaluation builder for a finite group product of polynomials. (Contributed by metakunt, 29-Apr-2025.)
theorem evl1gprodd {x3: setvar} (ph: wff x3) (B2 P Q R S: class x3) (U: class) (M: class x3) (N O Y: class):
  $ wceq O (cfv R ce1) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq Q (cfv P cmgp) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv P cbs) $ >
  $ wceq S (cfv R cmgp) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wral x3 (wcel M U) N) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wceq (cfv Y (cfv (co Q (cmpt x3 N M) cgsu) O)) (co S (cmpt x3 N (cfv Y (cfv M O))) cgsu)) $;

--| In the AKS-theorem the subset defined by ` E ` takes values in the positive integers. (Contributed by metakunt, 7-Jan-2025.)
theorem aks6d1c2p1 {k l: setvar} (ph: wff k l) (P: class) (E: class k l) (N: class):
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wbr P N cdvds) $ >
  $ wceq E (cmpo k l cn0 cn0 (co (co P (cv k) cexp) (co (co N P cdiv) (cv l) cexp) cmul)) $ >
  $ wi ph (wf (cxp cn0 cn0) cn E) $;

--| Injective condition for countability argument assuming that ` N ` is not a prime power. (Contributed by metakunt, 7-Jan-2025.)
theorem aks6d1c2p2 {k l: setvar} (ph: wff) (P: class) (Q E: class k l) (N: class):
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wbr P N cdvds) $ >
  $ wceq E (cmpo k l cn0 cn0 (co (co P (cv k) cexp) (co (co N P cdiv) (cv l) cexp) cmul)) $ >
  $ wi ph (wcel Q cprime) $ >
  $ wi ph (wbr Q N cdvds) $ >
  $ wi ph (wne P Q) $ >
  $ wi ph (wf1 (cxp cn0 cn0) cn E) $;

--| Closure of E for ~ https://www3.nd.edu/%7eandyp/notes/AKS.pdf Theorem 6.1. (Contributed by metakunt, 28-Apr-2025.)
theorem hashscontpowcl {k l: setvar} (ph: wff k l) (P R E L N Y: class k l):
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wbr P N cdvds) $ >
  $ wi ph (wcel R cn) $ >
  $ wi ph (wceq (co N R cgcd) c1) $ >
  $ wceq E (cmpo k l cn0 cn0 (co (co P (cv k) cexp) (co (co N P cdiv) (cv l) cexp) cmul)) $ >
  $ wceq L (cfv Y czrh) $ >
  $ wceq Y (cfv R czn) $ >
  $ wi ph (wcel (cfv (cima L (cima E (cxp cn0 cn0))) chash) cn0) $;

--| Helper lemma for to prove inequality in Zr. (Contributed by metakunt, 28-Apr-2025.)
theorem hashscontpow1 (ph: wff) (A2 B2 R L N Y: class):
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel A2 (co c1 (cfv N (cfv R codz)) cfz)) $ >
  $ wi ph (wcel B2 (co c1 (cfv N (cfv R codz)) cfz)) $ >
  $ wi ph (wcel R cn) $ >
  $ wi ph (wceq (co N R cgcd) c1) $ >
  $ wceq L (cfv Y czrh) $ >
  $ wceq Y (cfv R czn) $ >
  $ wi ph (wbr A2 B2 clt) $ >
  $ wi ph (wne (cfv (co N A2 cexp) L) (cfv (co N B2 cexp) L)) $;

--| If a set contains all ` N ` -th powers, then the size of the image under the ZR homomorphism is greater than the ` R ` -th order of ` N ` . (Contributed by metakunt, 28-Apr-2025.)
theorem hashscontpow {k: setvar} (ph: wff k) (R: class k) (E: class) (L: class k) (N: class) (Y: class k):
  $ wi ph (wss E cz) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wral k (wcel (co N (cv k) cexp) E) cn0) $ >
  $ wi ph (wcel R cn) $ >
  $ wi ph (wceq (co N R cgcd) c1) $ >
  $ wceq L (cfv Y czrh) $ >
  $ wceq Y (cfv R czn) $ >
  $ wi ph (wbr (cfv N (cfv R codz)) (cfv (cima L E) chash) cle) $;

--| Claim 3 of Theorem 6.1 of the AKS inequality lemma. ~ https://www3.nd.edu/%7eandyp/notes/AKS.pdf (Contributed by metakunt, 28-Apr-2025.)
theorem aks6d1c3 {k l: setvar} (ph: wff) (P: class) (R E L: class k l) (N: class) (Y: class k l):
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wbr P N cdvds) $ >
  $ wi ph (wcel R cn) $ >
  $ wi ph (wceq (co N R cgcd) c1) $ >
  $ wceq E (cmpo k l cn0 cn0 (co (co P (cv k) cexp) (co (co N P cdiv) (cv l) cexp) cmul)) $ >
  $ wceq L (cfv Y czrh) $ >
  $ wceq Y (cfv R czn) $ >
  $ wi ph (wbr (co (co c2 N clogb) c2 cexp) (cfv N (cfv R codz)) clt) $ >
  $ wi ph (wbr (co (co c2 N clogb) c2 cexp) (cfv (cima L (cima E (cxp cn0 cn0))) chash) clt) $;

--| Claim 4 of Theorem 6.1 of the AKS inequality lemma. ~ https://www3.nd.edu/%7eandyp/notes/AKS.pdf (Contributed by metakunt, 12-May-2025.)
theorem aks6d1c4 {k l: setvar} (ph: wff k l) (P: class) (R E L: class k l) (N: class):
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wbr P N cdvds) $ >
  $ wi ph (wcel R cn) $ >
  $ wi ph (wceq (co N R cgcd) c1) $ >
  $ wceq E (cmpo k l cn0 cn0 (co (co P (cv k) cexp) (co (co N P cdiv) (cv l) cexp) cmul)) $ >
  $ wceq L (cfv (cfv R czn) czrh) $ >
  $ wi ph (wbr (cfv (cima L (cima E (cxp cn0 cn0))) chash) (cfv R cphi) cle) $;

--| Claim 1 of AKS primality proof with collapsed definitions since their ease of use is no longer needed. (Contributed by metakunt, 1-May-2025.)
theorem aks6d1c1rh {x3 y1 e f2 g2 i a: setvar} (ph: wff y1 e f2) (A2: class y1 e f2) (P: class y1 g2 i a) (c_sm: class x3 y1 e f2 g2 i) (R: class g2 i a) (U E: class x3 y1 g2 i a) (F: class x3 y1 a) (G: class x3 y1 e f2 g2 i a) (K: class) (L: class x3 y1 g2 i a) (N: class y1 g2 i):
  $ wceq c_sm (copab e f2 (w3a (wcel (cv e) cn) (wcel (cv f2) (cfv (cfv K cpl1) cbs)) (wral y1 (wceq (co (cv e) (cfv (cv y1) (cfv (cv f2) (cfv K ce1))) (cfv (cfv K cmgp) cmg)) (cfv (co (cv e) (cv y1) (cfv (cfv K cmgp) cmg)) (cfv (cv f2) (cfv K ce1)))) (co (cfv K cmgp) R cprimroots)))) $ >
  $ wceq P (cfv K cchr) $ >
  $ wi ph (wcel K cfield) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel R cn) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr P N cdvds) $ >
  $ wi ph (wceq (co N R cgcd) c1) $ >
  $ wi ph (wf (co cc0 A2 cfz) cn0 F) $ >
  $ wceq G (cmpt g2 (co cn0 (co cc0 A2 cfz) cmap) (co (cfv (cfv K cpl1) cmgp) (cmpt i (co cc0 A2 cfz) (co (cfv (cv i) (cv g2)) (co (cfv K cv1) (cfv (cfv (cv i) (cfv K czrh)) (cfv (cfv K cpl1) cascl)) (cfv (cfv K cpl1) cplusg)) (cfv (cfv (cfv K cpl1) cmgp) cmg))) cgsu)) $ >
  $ wi ph (wcel A2 cn0) $ >
  $ wi ph (wcel U cn0) $ >
  $ wi ph (wcel L cn0) $ >
  $ wceq E (co (co P U cexp) (co (co N P cdiv) L cexp) cmul) $ >
  $ wi ph (wral a (wbr N (co (cfv K cv1) (cfv (cfv (cv a) (cfv K czrh)) (cfv (cfv K cpl1) cascl)) (cfv (cfv K cpl1) cplusg)) c_sm) (co c1 A2 cfz)) $ >
  $ wi ph (wcel (cmpt x3 (cfv K cbs) (co P (cv x3) (cfv (cfv K cmgp) cmg))) (co K K crs)) $ >
  $ wi ph (wbr E (cfv F G) c_sm) $;

--| Lemma for ~ aks6d1c2 to simplify context. (Contributed by metakunt, 1-May-2025.)
theorem aks6d1c2lem3 {x3 y1 e f2 g2 h i k o s1 r q p a l: setvar} (ph: wff y1 e f2 h o s1 r q p) (A2: class y1 e f2 h k o s1 r q p l) (B2 C: class x3 y1 e f2 g2 h i k o s1 r q p a l) (P: class g2 h i o s1 r q p a) (c_sm: class x3 y1 e f2 g2 h i k o s1 r q p l) (R: class g2 h i k o s1 r q p a l) (S U E c_ex F: class x3 y1 e f2 g2 h i k o s1 r q p a l) (G: class x3 g2 h i k o s1 r q p a l) (H I J: class x3 y1 e f2 g2 h i k o s1 r q p a l) (K: class h k o s1 r q p l) (L: class x3 y1 e f2 g2 h i k o s1 r q p a l) (M: class x3 e f2 g2 h i k o s1 r q p a l) (N: class g2 h i o s1 r q p) (X: class x3 y1 e f2 g2 h i k o s1 r q p a l):
  $ wceq c_sm (copab e f2 (w3a (wcel (cv e) cn) (wcel (cv f2) (cfv (cfv K cpl1) cbs)) (wral y1 (wceq (co (cv e) (cfv (cv y1) (cfv (cv f2) (cfv K ce1))) (cfv (cfv K cmgp) cmg)) (cfv (co (cv e) (cv y1) (cfv (cfv K cmgp) cmg)) (cfv (cv f2) (cfv K ce1)))) (co (cfv K cmgp) R cprimroots)))) $ >
  $ wceq P (cfv K cchr) $ >
  $ wi ph (wcel K cfield) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel R cn) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr P N cdvds) $ >
  $ wi ph (wceq (co N R cgcd) c1) $ >
  $ wi ph (wf (co cc0 A2 cfz) cn0 F) $ >
  $ wceq G (cmpt g2 (co cn0 (co cc0 A2 cfz) cmap) (co (cfv (cfv K cpl1) cmgp) (cmpt i (co cc0 A2 cfz) (co (cfv (cv i) (cv g2)) (co (cfv K cv1) (cfv (cfv (cv i) (cfv K czrh)) (cfv (cfv K cpl1) cascl)) (cfv (cfv K cpl1) cplusg)) (cfv (cfv (cfv K cpl1) cmgp) cmg))) cgsu)) $ >
  $ wi ph (wcel A2 cn0) $ >
  $ wceq E (cmpo k l cn0 cn0 (co (co P (cv k) cexp) (co (co N P cdiv) (cv l) cexp) cmul)) $ >
  $ wceq L (cfv (cfv R czn) czrh) $ >
  $ wi ph (wral a (wbr N (co (cfv K cv1) (cfv (cfv (cv a) (cfv K czrh)) (cfv (cfv K cpl1) cascl)) (cfv (cfv K cpl1) cplusg)) c_sm) (co c1 A2 cfz)) $ >
  $ wi ph (wcel (cmpt x3 (cfv K cbs) (co P (cv x3) (cfv (cfv K cmgp) cmg))) (co K K crs)) $ >
  $ wi ph (wcel M (co (cfv K cmgp) R cprimroots)) $ >
  $ wceq H (cmpt h (co cn0 (co cc0 A2 cfz) cmap) (cfv M (cfv (cfv (cv h) G) (cfv K ce1)))) $ >
  $ wceq B2 (cfv (cfv (cfv (cima L (cima E (cxp cn0 cn0))) chash) csqrt) cfl) $ >
  $ wceq C (cima E (cxp (co cc0 B2 cfz) (co cc0 B2 cfz))) $ >
  $ wi ph (wcel I C) $ >
  $ wi ph (wcel J C) $ >
  $ wi ph (wbr I J clt) $ >
  $ wceq c_ex (cfv (cfv (cfv K cpl1) cmgp) cmg) $ >
  $ wceq X (cfv K cv1) $ >
  $ wceq S (co (co J X c_ex) (co I X c_ex) (cfv (cfv K cpl1) csg)) $ >
  $ wi ph (wcel U cn) $ >
  $ wi ph (wceq J (co I (co U R cmul) caddc)) $ >
  $ wi ph (wcel (cv s1) (co cn0 (co cc0 A2 cfz) cmap)) $ >
  $ wi ph (wcel (cv r) (co cc0 B2 cfz)) $ >
  $ wi ph (wcel (cv o) (co cc0 B2 cfz)) $ >
  $ wi ph (wceq J (co (cv r) (cv o) E)) $ >
  $ wi ph (wcel (cv p) (co cc0 B2 cfz)) $ >
  $ wi ph (wcel (cv q) (co cc0 B2 cfz)) $ >
  $ wi ph (wceq I (co (cv p) (cv q) E)) $ >
  $ wi ph (wcel I cn0) $ >
  $ wi ph (wceq (co J (cfv M (cfv (cfv (cv s1) G) (cfv K ce1))) (cfv (cfv K cmgp) cmg)) (co I (cfv M (cfv (cfv (cv s1) G) (cfv K ce1))) (cfv (cfv K cmgp) cmg))) $;

--| Claim 2 of Theorem 6.1 AKS, Preparation for injectivity proof. (Contributed by metakunt, 1-May-2025.)
theorem aks6d1c2lem4 {x3 y1 e f2 g2 h i k a l: setvar} (ph: wff y1 e f2) (A2: class y1 e f2) (B2: class y1 e f2 h) (C: class x3 y1 e f2 g2 h i k a l) (P: class g2 h i a) (c_sm: class x3 y1 e f2 g2 h i k l) (R: class g2 h i k a l) (S U: class x3 y1 e f2 g2 h i k a l) (E: class y1 e f2 h) (c_ex F: class x3 y1 e f2 g2 h i k a l) (G: class x3 g2 i k a l) (H: class x3 y1 e f2 g2 h i k a l) (I J: class y1 e f2 h) (K: class k l) (L: class x3 y1 e f2 g2 h i k a l) (M: class x3 e f2 g2 i k a l) (N: class g2 h i) (X: class x3 y1 e f2 g2 h i k a l):
  $ wceq c_sm (copab e f2 (w3a (wcel (cv e) cn) (wcel (cv f2) (cfv (cfv K cpl1) cbs)) (wral y1 (wceq (co (cv e) (cfv (cv y1) (cfv (cv f2) (cfv K ce1))) (cfv (cfv K cmgp) cmg)) (cfv (co (cv e) (cv y1) (cfv (cfv K cmgp) cmg)) (cfv (cv f2) (cfv K ce1)))) (co (cfv K cmgp) R cprimroots)))) $ >
  $ wceq P (cfv K cchr) $ >
  $ wi ph (wcel K cfield) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel R cn) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr P N cdvds) $ >
  $ wi ph (wceq (co N R cgcd) c1) $ >
  $ wi ph (wf (co cc0 A2 cfz) cn0 F) $ >
  $ wceq G (cmpt g2 (co cn0 (co cc0 A2 cfz) cmap) (co (cfv (cfv K cpl1) cmgp) (cmpt i (co cc0 A2 cfz) (co (cfv (cv i) (cv g2)) (co (cfv K cv1) (cfv (cfv (cv i) (cfv K czrh)) (cfv (cfv K cpl1) cascl)) (cfv (cfv K cpl1) cplusg)) (cfv (cfv (cfv K cpl1) cmgp) cmg))) cgsu)) $ >
  $ wi ph (wcel A2 cn0) $ >
  $ wceq E (cmpo k l cn0 cn0 (co (co P (cv k) cexp) (co (co N P cdiv) (cv l) cexp) cmul)) $ >
  $ wceq L (cfv (cfv R czn) czrh) $ >
  $ wi ph (wral a (wbr N (co (cfv K cv1) (cfv (cfv (cv a) (cfv K czrh)) (cfv (cfv K cpl1) cascl)) (cfv (cfv K cpl1) cplusg)) c_sm) (co c1 A2 cfz)) $ >
  $ wi ph (wcel (cmpt x3 (cfv K cbs) (co P (cv x3) (cfv (cfv K cmgp) cmg))) (co K K crs)) $ >
  $ wi ph (wcel M (co (cfv K cmgp) R cprimroots)) $ >
  $ wceq H (cmpt h (co cn0 (co cc0 A2 cfz) cmap) (cfv M (cfv (cfv (cv h) G) (cfv K ce1)))) $ >
  $ wceq B2 (cfv (cfv (cfv (cima L (cima E (cxp cn0 cn0))) chash) csqrt) cfl) $ >
  $ wceq C (cima E (cxp (co cc0 B2 cfz) (co cc0 B2 cfz))) $ >
  $ wi ph (wcel I C) $ >
  $ wi ph (wcel J C) $ >
  $ wi ph (wbr I J clt) $ >
  $ wceq c_ex (cfv (cfv (cfv K cpl1) cmgp) cmg) $ >
  $ wceq X (cfv K cv1) $ >
  $ wceq S (co (co J X c_ex) (co I X c_ex) (cfv (cfv K cpl1) csg)) $ >
  $ wi ph (wcel U cn) $ >
  $ wi ph (wceq J (co I (co U R cmul) caddc)) $ >
  $ wi ph (wbr (cfv (cima H (co cn0 (co cc0 A2 cfz) cmap)) chash) (co N B2 cexp) cle) $;

--| If the number of elements of the domain are greater than the number of elements in a codomain, then there are two different values that map to the same. (Contributed by metakunt, 2-May-2025.)
theorem hashnexinj {x3 y1: setvar} (ph: wff x3 y1) (A2: class) (B2: class x3 y1) (F: class):
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wbr (cfv B2 chash) (cfv A2 chash) clt) $ >
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wrex x3 (wrex y1 (wa (wceq (cfv (cv x3) F) (cfv (cv y1) F)) (wne (cv x3) (cv y1))) A2) A2) $;

--| If the number of elements of the domain are greater than the number of elements in a codomain, then there are two different values that map to the same. Also we introduce a one sided inequality to simplify a duplicateable proof. (Contributed by metakunt, 2-May-2025.)
theorem hashnexinjle {x3 y1: setvar} (ph: wff) (A2: class) (B2: class x3 y1) (F: class):
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wbr (cfv B2 chash) (cfv A2 chash) clt) $ >
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wrex x3 (wrex y1 (wa (wceq (cfv (cv x3) F) (cfv (cv y1) F)) (wbr (cv x3) (cv y1) clt)) A2) A2) $;

--| Claim 2 of Theorem 6.1 of ~ https://www3.nd.edu/%7eandyp/notes/AKS.pdf (Contributed by metakunt, 2-May-2025.)
theorem aks6d1c2 {x3 y1 e f2 g2 h i k a l: setvar} (ph: wff y1 e f2) (A2: class y1 e f2) (B2: class y1 e f2 h) (C: class y1 e f2) (P: class g2 h i a) (Q: class x3 y1 e f2 g2 h i k a l) (c_sm: class x3 y1 e f2 g2 h i k l) (R: class) (E: class y1 e f2 h) (G: class x3 g2 i k a l) (H: class x3 y1 e f2 g2 h i k a l) (K: class k l) (L: class x3 y1 e f2 g2 h i k a l) (M: class x3 e f2 g2 i k a l) (N: class g2 h i):
  $ wceq c_sm (copab e f2 (w3a (wcel (cv e) cn) (wcel (cv f2) (cfv (cfv K cpl1) cbs)) (wral y1 (wceq (co (cv e) (cfv (cv y1) (cfv (cv f2) (cfv K ce1))) (cfv (cfv K cmgp) cmg)) (cfv (co (cv e) (cv y1) (cfv (cfv K cmgp) cmg)) (cfv (cv f2) (cfv K ce1)))) (co (cfv K cmgp) R cprimroots)))) $ >
  $ wceq P (cfv K cchr) $ >
  $ wi ph (wcel K cfield) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel R cn) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr P N cdvds) $ >
  $ wi ph (wceq (co N R cgcd) c1) $ >
  $ wceq G (cmpt g2 (co cn0 (co cc0 A2 cfz) cmap) (co (cfv (cfv K cpl1) cmgp) (cmpt i (co cc0 A2 cfz) (co (cfv (cv i) (cv g2)) (co (cfv K cv1) (cfv (cfv (cv i) (cfv K czrh)) (cfv (cfv K cpl1) cascl)) (cfv (cfv K cpl1) cplusg)) (cfv (cfv (cfv K cpl1) cmgp) cmg))) cgsu)) $ >
  $ wi ph (wcel A2 cn0) $ >
  $ wceq E (cmpo k l cn0 cn0 (co (co P (cv k) cexp) (co (co N P cdiv) (cv l) cexp) cmul)) $ >
  $ wceq L (cfv (cfv R czn) czrh) $ >
  $ wi ph (wral a (wbr N (co (cfv K cv1) (cfv (cfv (cv a) (cfv K czrh)) (cfv (cfv K cpl1) cascl)) (cfv (cfv K cpl1) cplusg)) c_sm) (co c1 A2 cfz)) $ >
  $ wi ph (wcel (cmpt x3 (cfv K cbs) (co P (cv x3) (cfv (cfv K cmgp) cmg))) (co K K crs)) $ >
  $ wi ph (wcel M (co (cfv K cmgp) R cprimroots)) $ >
  $ wceq H (cmpt h (co cn0 (co cc0 A2 cfz) cmap) (cfv M (cfv (cfv (cv h) G) (cfv K ce1)))) $ >
  $ wceq B2 (cfv (cfv (cfv (cima L (cima E (cxp cn0 cn0))) chash) csqrt) cfl) $ >
  $ wceq C (cima E (cxp (co cc0 B2 cfz) (co cc0 B2 cfz))) $ >
  $ wi ph (w3a (wcel Q cprime) (wbr Q N cdvds) (wne P Q)) $ >
  $ wi ph (wbr (cfv (cima H (co cn0 (co cc0 A2 cfz) cmap)) chash) (co N B2 cexp) cle) $;

--| Special case related to ~ rspsbc . (Contributed by metakunt, 5-May-2025.)
theorem rspcsbnea {x3: setvar} (A2: class x3) (B2: class) (C: class x3) (D: class):
  $ wi (wa (wcel A2 B2) (wral x3 (wne C D) B2)) (wne (csb x3 A2 C) D) $;

--| A nonzero power in an integral domain is nonzero. (Contributed by metakunt, 5-May-2025.)
theorem idomnnzpownz (ph: wff) (A2 R c_ex N: class):
  $ wi ph (wcel R cidom) $ >
  $ wi ph (wcel A2 (cfv R cbs)) $ >
  $ wi ph (wne A2 (cfv R c0g)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wceq c_ex (cfv (cfv R cmgp) cmg) $ >
  $ wi ph (wne (co N A2 c_ex) (cfv R c0g)) $;

--| A finite product of nonzero elements in an integral domain is nonzero. (Contributed by metakunt, 5-May-2025.)
theorem idomnnzgmulnz {n: setvar} (ph: wff) (A2: class n) (R: class) (G: class n) (N: class):
  $ wceq G (cfv R cmgp) $ >
  $ wi ph (wcel R cidom) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi (wa ph (wcel (cv n) N)) (wcel A2 (cfv R cbs)) $ >
  $ wi (wa ph (wcel (cv n) N)) (wne A2 (cfv R c0g)) $ >
  $ wi ph (wne (co G (cmpt n N A2) cgsu) (cfv R c0g)) $;

--| Zero to the power of a positive integer is zero. (Contributed by metakunt, 5-May-2025.)
theorem ringexp0nn (ph: wff) (R c_ex N: class):
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel N cn) $ >
  $ wceq c_ex (cfv (cfv R cmgp) cmg) $ >
  $ wi ph (wceq (co N (cfv R c0g) c_ex) (cfv R c0g)) $;

--| Lemma for Claim 5 of Theorem 6.1, G defines a map into the polynomials. (Contributed by metakunt, 5-May-2025.)
theorem aks6d1c5lem0 {g2 i: setvar} (ph: wff) (A2: class) (P c_ex G: class g2 i) (K: class) (X: class g2 i):
  $ wi ph (wcel K cfield) $ >
  $ wi ph (wcel P cprime) $ >
  $ wceq P (cfv K cchr) $ >
  $ wi ph (wcel A2 cn0) $ >
  $ wi ph (wbr A2 P clt) $ >
  $ wceq X (cfv K cv1) $ >
  $ wceq c_ex (cfv (cfv (cfv K cpl1) cmgp) cmg) $ >
  $ wceq G (cmpt g2 (co cn0 (co cc0 A2 cfz) cmap) (co (cfv (cfv K cpl1) cmgp) (cmpt i (co cc0 A2 cfz) (co (cfv (cv i) (cv g2)) (co X (cfv (cfv (cv i) (cfv K czrh)) (cfv (cfv K cpl1) cascl)) (cfv (cfv K cpl1) cplusg)) c_ex)) cgsu)) $ >
  $ wi ph (wf (co cn0 (co cc0 A2 cfz) cmap) (cfv (cfv K cpl1) cbs) G) $;

--| Lemma for claim 5, evaluate the linear factor at -c to get a root. (Contributed by metakunt, 5-May-2025.)
theorem aks6d1c5lem1 {g2 i: setvar} (ph: wff g2 i) (A2 B2 C P c_ex G K X: class g2 i):
  $ wi ph (wcel K cfield) $ >
  $ wi ph (wcel P cprime) $ >
  $ wceq P (cfv K cchr) $ >
  $ wi ph (wcel A2 cn0) $ >
  $ wi ph (wbr A2 P clt) $ >
  $ wceq X (cfv K cv1) $ >
  $ wceq c_ex (cfv (cfv (cfv K cpl1) cmgp) cmg) $ >
  $ wceq G (cmpt g2 (co cn0 (co cc0 A2 cfz) cmap) (co (cfv (cfv K cpl1) cmgp) (cmpt i (co cc0 A2 cfz) (co (cfv (cv i) (cv g2)) (co X (cfv (cfv (cv i) (cfv K czrh)) (cfv (cfv K cpl1) cascl)) (cfv (cfv K cpl1) cplusg)) c_ex)) cgsu)) $ >
  $ wi ph (wcel B2 (co cc0 A2 cfz)) $ >
  $ wi ph (wcel C (co cc0 A2 cfz)) $ >
  $ wi ph (wb (wceq B2 C) (wceq (cfv (cfv (co cc0 C cmin) (cfv K czrh)) (cfv (co X (cfv (cfv B2 (cfv K czrh)) (cfv (cfv K cpl1) cascl)) (cfv (cfv K cpl1) cplusg)) (cfv K ce1))) (cfv K c0g))) $;

--| Lemma for Claim 5, polynomial division with a linear power. (Contributed by metakunt, 5-May-2025.)
theorem aks6d1c5lem3 {g2 i: setvar} (ph: wff) (A2: class) (C P Q: class g2 i) (S c_ex: class) (G: class g2 i) (K M: class) (W: class g2) (X Y: class):
  $ wi ph (wcel K cfield) $ >
  $ wi ph (wcel P cprime) $ >
  $ wceq P (cfv K cchr) $ >
  $ wi ph (wcel A2 cn0) $ >
  $ wi ph (wbr A2 P clt) $ >
  $ wceq X (cfv K cv1) $ >
  $ wceq c_ex (cfv (cfv (cfv K cpl1) cmgp) cmg) $ >
  $ wceq G (cmpt g2 (co cn0 (co cc0 A2 cfz) cmap) (co (cfv (cfv K cpl1) cmgp) (cmpt i (co cc0 A2 cfz) (co (cfv (cv i) (cv g2)) (co X (cfv (cfv (cv i) (cfv K czrh)) (cfv (cfv K cpl1) cascl)) (cfv (cfv K cpl1) cplusg)) c_ex)) cgsu)) $ >
  $ wi ph (wcel Y (co cn0 (co cc0 A2 cfz) cmap)) $ >
  $ wi ph (wcel W (co cc0 A2 cfz)) $ >
  $ wi ph (wcel C cn0) $ >
  $ wi ph (wbr C (cfv W Y) cle) $ >
  $ wceq Q (cfv K cq1p) $ >
  $ wceq S (cfv (cfv K cpl1) cascl) $ >
  $ wceq M (cfv (cfv K cpl1) cmgp) $ >
  $ wi ph (wceq (co (cfv Y G) (co C (co X (cfv (cfv W (cfv K czrh)) S) (cfv (cfv K cpl1) cplusg)) c_ex) Q) (co (co (co (cfv W Y) C cmin) (co X (cfv (cfv W (cfv K czrh)) S) (cfv (cfv K cpl1) cplusg)) c_ex) (co M (cmpt i (cdif (co cc0 A2 cfz) (csn W)) (co (cfv (cv i) Y) (co X (cfv (cfv (cv i) (cfv K czrh)) S) (cfv (cfv K cpl1) cplusg)) c_ex)) cgsu) (cfv M cplusg))) $;

--| Lemma for Claim 5, contradiction of different evaluations that map to the same. (Contributed by metakunt, 5-May-2025.)
theorem aks6d1c5lem2 {g2 i: setvar} (ph: wff) (A2: class) (P: class g2 i) (c_ex: class) (G: class g2 i) (K: class) (W: class g2) (X Y Z: class):
  $ wi ph (wcel K cfield) $ >
  $ wi ph (wcel P cprime) $ >
  $ wceq P (cfv K cchr) $ >
  $ wi ph (wcel A2 cn0) $ >
  $ wi ph (wbr A2 P clt) $ >
  $ wceq X (cfv K cv1) $ >
  $ wceq c_ex (cfv (cfv (cfv K cpl1) cmgp) cmg) $ >
  $ wceq G (cmpt g2 (co cn0 (co cc0 A2 cfz) cmap) (co (cfv (cfv K cpl1) cmgp) (cmpt i (co cc0 A2 cfz) (co (cfv (cv i) (cv g2)) (co X (cfv (cfv (cv i) (cfv K czrh)) (cfv (cfv K cpl1) cascl)) (cfv (cfv K cpl1) cplusg)) c_ex)) cgsu)) $ >
  $ wi ph (wcel Y (co cn0 (co cc0 A2 cfz) cmap)) $ >
  $ wi ph (wcel Z (co cn0 (co cc0 A2 cfz) cmap)) $ >
  $ wi ph (wceq (cfv Y G) (cfv Z G)) $ >
  $ wi ph (wcel W (co cc0 A2 cfz)) $ >
  $ wi ph (wbr (cfv W Y) (cfv W Z) clt) $ >
  $ wi ph (wne (cfv K c0g) (cfv K c0g)) $;

--| Claim 5 of Theorem 6.1 ~ https://www3.nd.edu/%7eandyp/notes/AKS.pdf . The mapping defined by ` G ` is injective. (Contributed by metakunt, 5-May-2025.)
theorem aks6d1c5 {g2 i: setvar} (ph: wff) (A2: class) (P: class g2 i) (c_ex G K X: class):
  $ wi ph (wcel K cfield) $ >
  $ wi ph (wcel P cprime) $ >
  $ wceq P (cfv K cchr) $ >
  $ wi ph (wcel A2 cn0) $ >
  $ wi ph (wbr A2 P clt) $ >
  $ wceq X (cfv K cv1) $ >
  $ wceq c_ex (cfv (cfv (cfv K cpl1) cmgp) cmg) $ >
  $ wceq G (cmpt g2 (co cn0 (co cc0 A2 cfz) cmap) (co (cfv (cfv K cpl1) cmgp) (cmpt i (co cc0 A2 cfz) (co (cfv (cv i) (cv g2)) (co X (cfv (cfv (cv i) (cfv K czrh)) (cfv (cfv K cpl1) cascl)) (cfv (cfv K cpl1) cplusg)) c_ex)) cgsu)) $ >
  $ wi ph (wf1 (co cn0 (co cc0 A2 cfz) cmap) (cfv (cfv K cpl1) cbs) G) $;

--| Degree multiplication is a homomorphism. (Contributed by metakunt, 6-May-2025.)
theorem deg1gprod {x3 n: setvar} (ph: wff x3) (C: class x3) (R N: class):
  $ wi ph (wcel R cidom) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wral x3 (wa (wcel C (cfv (cfv R cpl1) cbs)) (wne C (cfv (cfv R cpl1) c0g))) N) $ >
  $ wi ph (wa (wceq (cfv (co (cfv (cfv R cpl1) cmgp) (cmpt x3 N C) cgsu) (cfv R cdg1)) (csu n N (cfv (cfv (cv n) (cmpt x3 N C)) (cfv R cdg1)))) (wbr cc0 (cfv (co (cfv (cfv R cpl1) cmgp) (cmpt x3 N C) cgsu) (cfv R cdg1)) cle)) $;

--| Exact degree of a power of a polynomial in an integral domain. (Contributed by metakunt, 6-May-2025.)
theorem deg1pow (ph: wff) (A2 D R c_ex F: class):
  $ wi ph (wcel R cidom) $ >
  $ wi ph (wcel F (cfv (cfv R cpl1) cbs)) $ >
  $ wi ph (wne F (cfv (cfv R cpl1) c0g)) $ >
  $ wi ph (wcel A2 cn0) $ >
  $ wceq c_ex (cfv (cfv (cfv R cpl1) cmgp) cmg) $ >
  $ wceq D (cfv R cdg1) $ >
  $ wi ph (wceq (cfv (co A2 F c_ex) D) (co A2 (cfv F D) cmul)) $;

--| The value of 5 choose 2. (Contributed by metakunt, 8-Jun-2024.)
theorem _5bc2eq10:
  $ wceq (co c5 c2 cbc) (cdc c1 cc0) $;

--| The factorial of a successor's successor. (Contributed by metakunt, 19-Apr-2024.)
theorem facp2 (N: class):
  $ wi (wcel N cn0) (wceq (cfv (co N c2 caddc) cfa) (co (cfv N cfa) (co (co N c1 caddc) (co N c2 caddc) cmul) cmul)) $;

--| Part of induction step for ~ 2ap1caineq . (Contributed by metakunt, 8-Jun-2024.)
theorem _2np3bcnp1 (ph: wff) (N: class):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (co (co (co c2 (co N c1 caddc) cmul) c1 caddc) (co N c1 caddc) cbc) (co (co (co (co c2 N cmul) c1 caddc) N cbc) (co c2 (co (co (co c2 N cmul) c3 caddc) (co N c2 caddc) cdiv) cmul) cmul)) $;

--| Inequality for Theorem 6.6 for AKS. (Contributed by metakunt, 8-Jun-2024.)
theorem _2ap1caineq (ph: wff) (N: class):
  $ wi ph (wcel N cz) $ >
  $ wi ph (wbr c2 N cle) $ >
  $ wi ph (wbr (co c2 (co N c1 caddc) cexp) (co (co (co c2 N cmul) c1 caddc) N cbc) clt) $;

--| Different strictly monotone functions have different ranges. (Contributed by metakunt, 27-Sep-2024.)
theorem sticksstones1 {x3 y1 z f2: setvar} (ph: wff x3 y1 z) (A2: class x3 y1 z) (I: class f2) (K: class) (N: class x3 y1 z) (X Y: class):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel K cn0) $ >
  $ wceq A2 (cab f2 (wa (wf (co c1 K cfz) (co c1 N cfz) (cv f2)) (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) clt) (wbr (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) clt)) (co c1 K cfz)) (co c1 K cfz)))) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y A2) $ >
  $ wi ph (wne X Y) $ >
  $ wceq I (cinf (crab z (wne (cfv (cv z) X) (cfv (cv z) Y)) (co c1 K cfz)) cr clt) $ >
  $ wi ph (wne (crn X) (crn Y)) $;

--| The range function on strictly monotone functions with finite domain and codomain is an injective mapping onto ` K ` -elemental sets. (Contributed by metakunt, 27-Sep-2024.)
theorem sticksstones2 {x3 y1 z f2 a: setvar} (ph: wff x3 y1) (A2: class x3 y1) (B2: class x3 y1 f2 a) (F: class x3 y1 z f2 a) (K: class z) (N: class x3 y1 z):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel K cn0) $ >
  $ wceq B2 (crab a (wceq (cfv (cv a) chash) K) (cpw (co c1 N cfz))) $ >
  $ wceq A2 (cab f2 (wa (wf (co c1 K cfz) (co c1 N cfz) (cv f2)) (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) clt) (wbr (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) clt)) (co c1 K cfz)) (co c1 K cfz)))) $ >
  $ wceq F (cmpt z A2 (crn (cv z))) $ >
  $ wi ph (wf1 A2 B2 F) $;

--| The range function on strictly monotone functions with finite domain and codomain is an surjective mapping onto ` K ` -elemental sets. (Contributed by metakunt, 28-Sep-2024.)
theorem sticksstones3 {x3 y1 z f2 a: setvar} (ph: wff) (A2: class x3 y1) (B2: class f2 a) (F: class x3 y1 z f2 a) (K: class z) (N: class x3 y1 z):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel K cn0) $ >
  $ wceq B2 (crab a (wceq (cfv (cv a) chash) K) (cpw (co c1 N cfz))) $ >
  $ wceq A2 (cab f2 (wa (wf (co c1 K cfz) (co c1 N cfz) (cv f2)) (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) clt) (wbr (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) clt)) (co c1 K cfz)) (co c1 K cfz)))) $ >
  $ wceq F (cmpt z A2 (crn (cv z))) $ >
  $ wi ph (wfo A2 B2 F) $;

--| Equinumerosity lemma for sticks and stones. (Contributed by metakunt, 28-Sep-2024.)
theorem sticksstones4 {x3 y1 f2 a: setvar} (ph: wff) (A2: class x3 y1) (B2: class f2 a) (K: class) (N: class x3 y1):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel K cn0) $ >
  $ wceq B2 (crab a (wceq (cfv (cv a) chash) K) (cpw (co c1 N cfz))) $ >
  $ wceq A2 (cab f2 (wa (wf (co c1 K cfz) (co c1 N cfz) (cv f2)) (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) clt) (wbr (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) clt)) (co c1 K cfz)) (co c1 K cfz)))) $ >
  $ wi ph (wbr A2 B2 cen) $;

--| Count the number of strictly monotonely increasing functions on finite domains and codomains. (Contributed by metakunt, 28-Sep-2024.)
theorem sticksstones5 {x3 y1 f2: setvar} (ph: wff) (A2: class x3 y1) (K N: class):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel K cn0) $ >
  $ wceq A2 (cab f2 (wa (wf (co c1 K cfz) (co c1 N cfz) (cv f2)) (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) clt) (wbr (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) clt)) (co c1 K cfz)) (co c1 K cfz)))) $ >
  $ wi ph (wceq (cfv A2 chash) (co N K cbc)) $;

--| Function induces an order isomorphism for sticks and stones theorem. (Contributed by metakunt, 1-Oct-2024.)
theorem sticksstones6 {x3 i: setvar} (ph: wff) (F: class x3 i) (G K: class i) (N: class x3 i) (X Y: class):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel K cn0) $ >
  $ wi ph (wf (co c1 (co K c1 caddc) cfz) cn0 G) $ >
  $ wi ph (wcel X (co c1 K cfz)) $ >
  $ wi ph (wcel Y (co c1 K cfz)) $ >
  $ wi ph (wbr X Y clt) $ >
  $ wceq F (cmpt x3 (co c1 K cfz) (co (cv x3) (csu i (co c1 (cv x3) cfz) (cfv (cv i) G)) caddc)) $ >
  $ wi ph (wbr (cfv X F) (cfv Y F) clt) $;

--| Closure property of sticks and stones function. (Contributed by metakunt, 1-Oct-2024.)
theorem sticksstones7 {x3 i: setvar} (ph: wff) (F: class x3 i) (G: class i) (K: class) (N: class x3 i) (X: class):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel K cn0) $ >
  $ wi ph (wf (co c1 (co K c1 caddc) cfz) cn0 G) $ >
  $ wi ph (wcel X (co c1 K cfz)) $ >
  $ wceq F (cmpt x3 (co c1 K cfz) (co (cv x3) (csu i (co c1 (cv x3) cfz) (cfv (cv i) G)) caddc)) $ >
  $ wi ph (wceq (csu i (co c1 (co K c1 caddc) cfz) (cfv (cv i) G)) N) $ >
  $ wi ph (wcel (cfv X F) (co c1 (co N K caddc) cfz)) $;

--| Establish mapping between strictly monotone functions and functions that sum to a fixed non-negative integer. (Contributed by metakunt, 1-Oct-2024.)
theorem sticksstones8 {x3 y1 f2 g2 i j a l: setvar} (ph: wff f2 g2 i) (A2: class f2 g2 i) (B2: class x3 y1 f2 g2 i j l) (F: class x3 y1 f2 g2 i j a l) (K: class a) (N: class x3 y1 i a l):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel K cn0) $ >
  $ wceq F (cmpt a A2 (cmpt j (co c1 K cfz) (co (cv j) (csu l (co c1 (cv j) cfz) (cfv (cv l) (cv a))) caddc))) $ >
  $ wceq A2 (cab g2 (wa (wf (co c1 (co K c1 caddc) cfz) cn0 (cv g2)) (wceq (csu i (co c1 (co K c1 caddc) cfz) (cfv (cv i) (cv g2))) N))) $ >
  $ wceq B2 (cab f2 (wa (wf (co c1 K cfz) (co c1 (co N K caddc) cfz) (cv f2)) (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) clt) (wbr (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) clt)) (co c1 K cfz)) (co c1 K cfz)))) $ >
  $ wi ph (wf A2 B2 F) $;

--| Establish mapping between strictly monotone functions and functions that sum to a fixed non-negative integer. (Contributed by metakunt, 6-Oct-2024.)
theorem sticksstones9 {x3 y1 f2 g2 i k b: setvar} (ph: wff x3 y1 f2 g2 i k) (A2 B2: class x3 y1 f2 g2 i k) (G: class x3 y1 f2 g2 i k b) (K N: class x3 y1 f2 k b):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq K cc0) $ >
  $ wceq G (cmpt b B2 (cif (wceq K cc0) (csn (cop c1 N)) (cmpt k (co c1 (co K c1 caddc) cfz) (cif (wceq (cv k) (co K c1 caddc)) (co (co N K caddc) (cfv K (cv b)) cmin) (cif (wceq (cv k) c1) (co (cfv c1 (cv b)) c1 cmin) (co (co (cfv (cv k) (cv b)) (cfv (co (cv k) c1 cmin) (cv b)) cmin) c1 cmin)))))) $ >
  $ wceq A2 (cab g2 (wa (wf (co c1 (co K c1 caddc) cfz) cn0 (cv g2)) (wceq (csu i (co c1 (co K c1 caddc) cfz) (cfv (cv i) (cv g2))) N))) $ >
  $ wceq B2 (cab f2 (wa (wf (co c1 K cfz) (co c1 (co N K caddc) cfz) (cv f2)) (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) clt) (wbr (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) clt)) (co c1 K cfz)) (co c1 K cfz)))) $ >
  $ wi ph (wf B2 A2 G) $;

--| Establish mapping between strictly monotone functions and functions that sum to a fixed non-negative integer. (Contributed by metakunt, 6-Oct-2024.)
theorem sticksstones10 {x3 y1 f2 g2 i k b: setvar} (ph: wff x3 y1 f2 g2) (A2: class x3 y1 f2 g2 i k) (B2: class x3 y1 f2 g2) (G: class x3 y1 f2 g2 i k b) (K: class b) (N: class x3 y1 b):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel K cn) $ >
  $ wceq G (cmpt b B2 (cif (wceq K cc0) (csn (cop c1 N)) (cmpt k (co c1 (co K c1 caddc) cfz) (cif (wceq (cv k) (co K c1 caddc)) (co (co N K caddc) (cfv K (cv b)) cmin) (cif (wceq (cv k) c1) (co (cfv c1 (cv b)) c1 cmin) (co (co (cfv (cv k) (cv b)) (cfv (co (cv k) c1 cmin) (cv b)) cmin) c1 cmin)))))) $ >
  $ wceq A2 (cab g2 (wa (wf (co c1 (co K c1 caddc) cfz) cn0 (cv g2)) (wceq (csu i (co c1 (co K c1 caddc) cfz) (cfv (cv i) (cv g2))) N))) $ >
  $ wceq B2 (cab f2 (wa (wf (co c1 K cfz) (co c1 (co N K caddc) cfz) (cv f2)) (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) clt) (wbr (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) clt)) (co c1 K cfz)) (co c1 K cfz)))) $ >
  $ wi ph (wf B2 A2 G) $;

--| Establish bijective mapping between strictly monotone functions and functions that sum to a fixed non-negative integer. (Contributed by metakunt, 6-Oct-2024.)
theorem sticksstones11 {x3 y1 f2 g2 i j k a b l: setvar} (ph: wff f2 g2 i k) (A2: class f2 g2 i k) (B2: class x3 y1 f2 g2 i j k l) (F G: class x3 y1 f2 g2 i j k a b l) (K: class k) (N: class x3 y1 k a l):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq K cc0) $ >
  $ wceq F (cmpt a A2 (cmpt j (co c1 K cfz) (co (cv j) (csu l (co c1 (cv j) cfz) (cfv (cv l) (cv a))) caddc))) $ >
  $ wceq G (cmpt b B2 (cif (wceq K cc0) (csn (cop c1 N)) (cmpt k (co c1 (co K c1 caddc) cfz) (cif (wceq (cv k) (co K c1 caddc)) (co (co N K caddc) (cfv K (cv b)) cmin) (cif (wceq (cv k) c1) (co (cfv c1 (cv b)) c1 cmin) (co (co (cfv (cv k) (cv b)) (cfv (co (cv k) c1 cmin) (cv b)) cmin) c1 cmin)))))) $ >
  $ wceq A2 (cab g2 (wa (wf (co c1 (co K c1 caddc) cfz) cn0 (cv g2)) (wceq (csu i (co c1 (co K c1 caddc) cfz) (cfv (cv i) (cv g2))) N))) $ >
  $ wceq B2 (cab f2 (wa (wf (co c1 K cfz) (co c1 (co N K caddc) cfz) (cv f2)) (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) clt) (wbr (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) clt)) (co c1 K cfz)) (co c1 K cfz)))) $ >
  $ wi ph (wf1o A2 B2 F) $;

--| Establish bijective mapping between strictly monotone functions and functions that sum to a fixed non-negative integer. (Contributed by metakunt, 11-Oct-2024.)
theorem sticksstones12a {x3 y1 f2 g2 i j k a b d l: setvar} (ph: wff f2 g2) (A2: class f2 g2 i d) (B2: class x3 y1 f2 g2 d) (F: class x3 y1 f2 g2 i j a d l) (G: class x3 y1 f2 g2 i j k a b d l) (K: class d) (N: class x3 y1 d):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel K cn) $ >
  $ wceq F (cmpt a A2 (cmpt j (co c1 K cfz) (co (cv j) (csu l (co c1 (cv j) cfz) (cfv (cv l) (cv a))) caddc))) $ >
  $ wceq G (cmpt b B2 (cif (wceq K cc0) (csn (cop c1 N)) (cmpt k (co c1 (co K c1 caddc) cfz) (cif (wceq (cv k) (co K c1 caddc)) (co (co N K caddc) (cfv K (cv b)) cmin) (cif (wceq (cv k) c1) (co (cfv c1 (cv b)) c1 cmin) (co (co (cfv (cv k) (cv b)) (cfv (co (cv k) c1 cmin) (cv b)) cmin) c1 cmin)))))) $ >
  $ wceq A2 (cab g2 (wa (wf (co c1 (co K c1 caddc) cfz) cn0 (cv g2)) (wceq (csu i (co c1 (co K c1 caddc) cfz) (cfv (cv i) (cv g2))) N))) $ >
  $ wceq B2 (cab f2 (wa (wf (co c1 K cfz) (co c1 (co N K caddc) cfz) (cv f2)) (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) clt) (wbr (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) clt)) (co c1 K cfz)) (co c1 K cfz)))) $ >
  $ wi ph (wral d (wceq (cfv (cfv (cv d) G) F) (cv d)) B2) $;

--| Establish bijective mapping between strictly monotone functions and functions that sum to a fixed non-negative integer. (Contributed by metakunt, 6-Oct-2024.)
theorem sticksstones12 {x3 y1 f2 g2 i j k a b l: setvar} (ph: wff f2 g2) (A2: class f2 g2 i) (B2: class x3 y1 f2 g2) (F: class x3 y1 f2 g2 i j a l) (G: class x3 y1 f2 g2 i j k a b l) (K: class) (N: class x3 y1):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel K cn) $ >
  $ wceq F (cmpt a A2 (cmpt j (co c1 K cfz) (co (cv j) (csu l (co c1 (cv j) cfz) (cfv (cv l) (cv a))) caddc))) $ >
  $ wceq G (cmpt b B2 (cif (wceq K cc0) (csn (cop c1 N)) (cmpt k (co c1 (co K c1 caddc) cfz) (cif (wceq (cv k) (co K c1 caddc)) (co (co N K caddc) (cfv K (cv b)) cmin) (cif (wceq (cv k) c1) (co (cfv c1 (cv b)) c1 cmin) (co (co (cfv (cv k) (cv b)) (cfv (co (cv k) c1 cmin) (cv b)) cmin) c1 cmin)))))) $ >
  $ wceq A2 (cab g2 (wa (wf (co c1 (co K c1 caddc) cfz) cn0 (cv g2)) (wceq (csu i (co c1 (co K c1 caddc) cfz) (cfv (cv i) (cv g2))) N))) $ >
  $ wceq B2 (cab f2 (wa (wf (co c1 K cfz) (co c1 (co N K caddc) cfz) (cv f2)) (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) clt) (wbr (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) clt)) (co c1 K cfz)) (co c1 K cfz)))) $ >
  $ wi ph (wf1o A2 B2 F) $;

--| Establish bijective mapping between strictly monotone functions and functions that sum to a fixed non-negative integer. (Contributed by metakunt, 6-Oct-2024.)
theorem sticksstones13 {x3 y1 f2 g2 i j k a b l: setvar} (ph: wff f2 g2) (A2: class f2 g2 i) (B2: class x3 y1 f2 g2) (F: class x3 y1 f2 g2 i j a l) (G: class x3 y1 f2 g2 i j k a b l) (K: class) (N: class x3 y1):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel K cn0) $ >
  $ wceq F (cmpt a A2 (cmpt j (co c1 K cfz) (co (cv j) (csu l (co c1 (cv j) cfz) (cfv (cv l) (cv a))) caddc))) $ >
  $ wceq G (cmpt b B2 (cif (wceq K cc0) (csn (cop c1 N)) (cmpt k (co c1 (co K c1 caddc) cfz) (cif (wceq (cv k) (co K c1 caddc)) (co (co N K caddc) (cfv K (cv b)) cmin) (cif (wceq (cv k) c1) (co (cfv c1 (cv b)) c1 cmin) (co (co (cfv (cv k) (cv b)) (cfv (co (cv k) c1 cmin) (cv b)) cmin) c1 cmin)))))) $ >
  $ wceq A2 (cab g2 (wa (wf (co c1 (co K c1 caddc) cfz) cn0 (cv g2)) (wceq (csu i (co c1 (co K c1 caddc) cfz) (cfv (cv i) (cv g2))) N))) $ >
  $ wceq B2 (cab f2 (wa (wf (co c1 K cfz) (co c1 (co N K caddc) cfz) (cv f2)) (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) clt) (wbr (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) clt)) (co c1 K cfz)) (co c1 K cfz)))) $ >
  $ wi ph (wf1o A2 B2 F) $;

--| Sticks and stones with definitions as hypotheses. (Contributed by metakunt, 7-Oct-2024.)
theorem sticksstones14 {x3 y1 f2 g2 i j k a b l: setvar} (ph: wff) (A2: class f2 g2) (B2: class x3 y1 g2) (F: class x3 y1 f2 g2 j a l) (G: class x3 y1 f2 g2 i j k a b l) (K N: class):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel K cn0) $ >
  $ wceq F (cmpt a A2 (cmpt j (co c1 K cfz) (co (cv j) (csu l (co c1 (cv j) cfz) (cfv (cv l) (cv a))) caddc))) $ >
  $ wceq G (cmpt b B2 (cif (wceq K cc0) (csn (cop c1 N)) (cmpt k (co c1 (co K c1 caddc) cfz) (cif (wceq (cv k) (co K c1 caddc)) (co (co N K caddc) (cfv K (cv b)) cmin) (cif (wceq (cv k) c1) (co (cfv c1 (cv b)) c1 cmin) (co (co (cfv (cv k) (cv b)) (cfv (co (cv k) c1 cmin) (cv b)) cmin) c1 cmin)))))) $ >
  $ wceq A2 (cab g2 (wa (wf (co c1 (co K c1 caddc) cfz) cn0 (cv g2)) (wceq (csu i (co c1 (co K c1 caddc) cfz) (cfv (cv i) (cv g2))) N))) $ >
  $ wceq B2 (cab f2 (wa (wf (co c1 K cfz) (co c1 (co N K caddc) cfz) (cv f2)) (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) clt) (wbr (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) clt)) (co c1 K cfz)) (co c1 K cfz)))) $ >
  $ wi ph (wceq (cfv A2 chash) (co (co N K caddc) K cbc)) $;

--| Sticks and stones with almost collapsed definitions for positive integers. (Contributed by metakunt, 7-Oct-2024.)
theorem sticksstones15 {g2 i: setvar} (ph: wff) (A2: class g2) (K N: class):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel K cn0) $ >
  $ wceq A2 (cab g2 (wa (wf (co c1 (co K c1 caddc) cfz) cn0 (cv g2)) (wceq (csu i (co c1 (co K c1 caddc) cfz) (cfv (cv i) (cv g2))) N))) $ >
  $ wi ph (wceq (cfv A2 chash) (co (co N K caddc) K cbc)) $;

--| Sticks and stones with collapsed definitions for positive integers. (Contributed by metakunt, 20-Oct-2024.)
theorem sticksstones16 {g2 i: setvar} (ph: wff) (A2: class g2 i) (K N: class):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel K cn) $ >
  $ wceq A2 (cab g2 (wa (wf (co c1 K cfz) cn0 (cv g2)) (wceq (csu i (co c1 K cfz) (cfv (cv i) (cv g2))) N))) $ >
  $ wi ph (wceq (cfv A2 chash) (co (co N (co K c1 cmin) caddc) (co K c1 cmin) cbc)) $;

--| Extend sticks and stones to finite sets, bijective builder. (Contributed by metakunt, 23-Oct-2024.)
theorem sticksstones17 {y1 g2 h i b: setvar} (ph: wff g2 h) (A2: class y1 g2 h i) (B2: class g2 h) (S: class y1 g2 b) (G: class y1 g2 h i b) (K: class h b) (N: class y1 i b) (Z: class h b):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel K cn0) $ >
  $ wceq A2 (cab g2 (wa (wf (co c1 K cfz) cn0 (cv g2)) (wceq (csu i (co c1 K cfz) (cfv (cv i) (cv g2))) N))) $ >
  $ wceq B2 (cab h (wa (wf S cn0 (cv h)) (wceq (csu i S (cfv (cv i) (cv h))) N))) $ >
  $ wi ph (wf1o (co c1 K cfz) S Z) $ >
  $ wceq G (cmpt b B2 (cmpt y1 (co c1 K cfz) (cfv (cfv (cv y1) Z) (cv b)))) $ >
  $ wi ph (wf B2 A2 G) $;

--| Extend sticks and stones to finite sets, bijective builder. (Contributed by metakunt, 23-Oct-2024.)
theorem sticksstones18 {x3 g2 h i a: setvar} (ph: wff g2 h) (A2: class g2 h) (B2: class x3 g2 h i) (S: class g2 a) (F: class x3 g2 h i a) (K: class x3 h a) (N: class x3 i a) (Z: class g2 a):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel K cn0) $ >
  $ wceq A2 (cab g2 (wa (wf (co c1 K cfz) cn0 (cv g2)) (wceq (csu i (co c1 K cfz) (cfv (cv i) (cv g2))) N))) $ >
  $ wceq B2 (cab h (wa (wf S cn0 (cv h)) (wceq (csu i S (cfv (cv i) (cv h))) N))) $ >
  $ wi ph (wf1o (co c1 K cfz) S Z) $ >
  $ wceq F (cmpt a A2 (cmpt x3 S (cfv (cfv (cv x3) (ccnv Z)) (cv a)))) $ >
  $ wi ph (wf A2 B2 F) $;

--| Extend sticks and stones to finite sets, bijective builder. (Contributed by metakunt, 23-Oct-2024.)
theorem sticksstones19 {x3 y1 g2 h i a b: setvar} (ph: wff g2 h) (A2 B2: class g2 h) (S: class g2) (F: class x3 g2 h i a) (G: class y1 g2 h i b) (K: class h) (N: class x3 y1 i a b) (Z: class):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel K cn0) $ >
  $ wceq A2 (cab g2 (wa (wf (co c1 K cfz) cn0 (cv g2)) (wceq (csu i (co c1 K cfz) (cfv (cv i) (cv g2))) N))) $ >
  $ wceq B2 (cab h (wa (wf S cn0 (cv h)) (wceq (csu i S (cfv (cv i) (cv h))) N))) $ >
  $ wi ph (wf1o (co c1 K cfz) S Z) $ >
  $ wceq F (cmpt a A2 (cmpt x3 S (cfv (cfv (cv x3) (ccnv Z)) (cv a)))) $ >
  $ wceq G (cmpt b B2 (cmpt y1 (co c1 K cfz) (cfv (cfv (cv y1) Z) (cv b)))) $ >
  $ wi ph (wf1o A2 B2 F) $;

--| Lift sticks and stones to arbitrary finite non-empty sets. (Contributed by metakunt, 24-Oct-2024.)
theorem sticksstones20 {g2 h i: setvar} (ph: wff h) (A2 B2: class g2 h) (S: class g2) (K: class h) (N: class):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel S cfn) $ >
  $ wi ph (wcel K cn) $ >
  $ wceq A2 (cab g2 (wa (wf (co c1 K cfz) cn0 (cv g2)) (wceq (csu i (co c1 K cfz) (cfv (cv i) (cv g2))) N))) $ >
  $ wceq B2 (cab h (wa (wf S cn0 (cv h)) (wceq (csu i S (cfv (cv i) (cv h))) N))) $ >
  $ wi ph (wceq (cfv S chash) K) $ >
  $ wi ph (wceq (cfv B2 chash) (co (co N (co K c1 cmin) caddc) (co K c1 cmin) cbc)) $;

--| Lift sticks and stones to arbitrary finite non-empty sets. (Contributed by metakunt, 24-Oct-2024.)
theorem sticksstones21 {f2 i: setvar} (ph: wff f2 i) (A2: class f2 i) (S: class) (N: class i):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel S cfn) $ >
  $ wi ph (wne S c0) $ >
  $ wceq A2 (cab f2 (wa (wf S cn0 (cv f2)) (wceq (csu i S (cfv (cv i) (cv f2))) N))) $ >
  $ wi ph (wceq (cfv A2 chash) (co (co N (co (cfv S chash) c1 cmin) caddc) (co (cfv S chash) c1 cmin) cbc)) $;

--| Non-exhaustive sticks and stones. (Contributed by metakunt, 26-Oct-2024.)
theorem sticksstones22 {f2 i: setvar} (ph: wff) (A2: class f2 i) (S: class) (N: class i):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel S cfn) $ >
  $ wi ph (wne S c0) $ >
  $ wceq A2 (cab f2 (wa (wf S cn0 (cv f2)) (wbr (csu i S (cfv (cv i) (cv f2))) N cle))) $ >
  $ wi ph (wceq (cfv A2 chash) (co (co N (cfv S chash) caddc) (cfv S chash) cbc)) $;

--| Non-exhaustive sticks and stones. (Contributed by metakunt, 7-May-2025.)
theorem sticksstones23 {f2 i: setvar} (ph: wff) (A2: class f2 i) (S: class) (N: class i):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel S cfn) $ >
  $ wi ph (wne S c0) $ >
  $ wceq A2 (crab f2 (wbr (csu i S (cfv (cv i) (cv f2))) N cle) (co cn0 S cmap)) $ >
  $ wi ph (wceq (cfv A2 chash) (co (co N (cfv S chash) caddc) (cfv S chash) cbc)) $;

--| Lemma for claim 6, deduce exact degree of the polynomial. (Contributed by metakunt, 7-May-2025.)
theorem aks6d1c6lem1 {x3 y1 t e f2 g2 h i k s1 a l: setvar} (ph: wff x3 y1 e f2 h k s1 a l) (A2: class x3 y1 e f2 h k s1 a l) (D P c_sm R S: class x3 y1 t e f2 g2 h i k s1 a l) (U: class x3 y1 e f2 h k s1 a l) (E G H: class x3 y1 t e f2 g2 h i k s1 a l) (K: class x3 y1 e f2 h k s1 a l) (L M N: class x3 y1 t e f2 g2 h i k s1 a l):
  $ wceq c_sm (copab e f2 (w3a (wcel (cv e) cn) (wcel (cv f2) (cfv (cfv K cpl1) cbs)) (wral y1 (wceq (co (cv e) (cfv (cv y1) (cfv (cv f2) (cfv K ce1))) (cfv (cfv K cmgp) cmg)) (cfv (co (cv e) (cv y1) (cfv (cfv K cmgp) cmg)) (cfv (cv f2) (cfv K ce1)))) (co (cfv K cmgp) R cprimroots)))) $ >
  $ wceq P (cfv K cchr) $ >
  $ wi ph (wcel K cfield) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel R cn) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr P N cdvds) $ >
  $ wi ph (wceq (co N R cgcd) c1) $ >
  $ wi ph (wbr A2 P clt) $ >
  $ wceq G (cmpt g2 (co cn0 (co cc0 A2 cfz) cmap) (co (cfv (cfv K cpl1) cmgp) (cmpt i (co cc0 A2 cfz) (co (cfv (cv i) (cv g2)) (co (cfv K cv1) (cfv (cfv (cv i) (cfv K czrh)) (cfv (cfv K cpl1) cascl)) (cfv (cfv K cpl1) cplusg)) (cfv (cfv (cfv K cpl1) cmgp) cmg))) cgsu)) $ >
  $ wi ph (wcel A2 cn0) $ >
  $ wceq E (cmpo k l cn0 cn0 (co (co P (cv k) cexp) (co (co N P cdiv) (cv l) cexp) cmul)) $ >
  $ wceq L (cfv (cfv R czn) czrh) $ >
  $ wi ph (wral a (wbr N (co (cfv K cv1) (cfv (cfv (cv a) (cfv K czrh)) (cfv (cfv K cpl1) cascl)) (cfv (cfv K cpl1) cplusg)) c_sm) (co c1 A2 cfz)) $ >
  $ wi ph (wcel (cmpt x3 (cfv K cbs) (co P (cv x3) (cfv (cfv K cmgp) cmg))) (co K K crs)) $ >
  $ wi ph (wcel M (co (cfv K cmgp) R cprimroots)) $ >
  $ wceq H (cmpt h (co cn0 (co cc0 A2 cfz) cmap) (cfv M (cfv (cfv (cv h) G) (cfv K ce1)))) $ >
  $ wceq D (cfv (cima L (cima E (cxp cn0 cn0))) chash) $ >
  $ wceq S (crab s1 (wbr (csu t (co cc0 A2 cfz) (cfv (cv t) (cv s1))) (co D c1 cmin) cle) (co cn0 (co cc0 A2 cfz) cmap)) $ >
  $ wi ph (wcel U (co cn0 (co cc0 A2 cfz) cmap)) $ >
  $ wi ph (wceq (cfv (cfv U G) (cfv K cdg1)) (csu t (co cc0 A2 cfz) (cfv (cv t) U))) $;

--| Every primitive root is root of G(u)-G(v). (Contributed by metakunt, 8-May-2025.)
theorem aks6d1c6lem2 {x3 y1 t e f2 g2 h i j k s1 a l: setvar} (ph: wff y1 t e f2 k l) (A2: class y1 t e f2 j k l) (D: class x3 y1 t e f2 g2 h i j k s1 a l) (P: class y1 t g2 h i j a) (c_sm: class x3 y1 t e f2 g2 h i j k s1 l) (R: class t g2 h i j k s1 a l) (S: class x3 y1 t e f2 g2 i j k s1 a l) (U: class x3 t j k s1 a l) (E: class x3 t g2 h i k s1 a l) (G: class x3 t g2 i j k s1 a l) (H J: class x3 y1 t e f2 g2 h i j k s1 a l) (K: class t k s1 l) (L: class x3 y1 t e f2 g2 h i j k s1 a l) (M: class x3 t e f2 g2 i k s1 a l) (N: class y1 t g2 h i j) (V: class x3 t j k s1 a l):
  $ wceq c_sm (copab e f2 (w3a (wcel (cv e) cn) (wcel (cv f2) (cfv (cfv K cpl1) cbs)) (wral y1 (wceq (co (cv e) (cfv (cv y1) (cfv (cv f2) (cfv K ce1))) (cfv (cfv K cmgp) cmg)) (cfv (co (cv e) (cv y1) (cfv (cfv K cmgp) cmg)) (cfv (cv f2) (cfv K ce1)))) (co (cfv K cmgp) R cprimroots)))) $ >
  $ wceq P (cfv K cchr) $ >
  $ wi ph (wcel K cfield) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel R cn) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr P N cdvds) $ >
  $ wi ph (wceq (co N R cgcd) c1) $ >
  $ wi ph (wbr A2 P clt) $ >
  $ wceq G (cmpt g2 (co cn0 (co cc0 A2 cfz) cmap) (co (cfv (cfv K cpl1) cmgp) (cmpt i (co cc0 A2 cfz) (co (cfv (cv i) (cv g2)) (co (cfv K cv1) (cfv (cfv (cv i) (cfv K czrh)) (cfv (cfv K cpl1) cascl)) (cfv (cfv K cpl1) cplusg)) (cfv (cfv (cfv K cpl1) cmgp) cmg))) cgsu)) $ >
  $ wi ph (wcel A2 cn0) $ >
  $ wceq E (cmpo k l cn0 cn0 (co (co P (cv k) cexp) (co (co N P cdiv) (cv l) cexp) cmul)) $ >
  $ wceq L (cfv (cfv R czn) czrh) $ >
  $ wi ph (wral a (wbr N (co (cfv K cv1) (cfv (cfv (cv a) (cfv K czrh)) (cfv (cfv K cpl1) cascl)) (cfv (cfv K cpl1) cplusg)) c_sm) (co c1 A2 cfz)) $ >
  $ wi ph (wcel (cmpt x3 (cfv K cbs) (co P (cv x3) (cfv (cfv K cmgp) cmg))) (co K K crs)) $ >
  $ wi ph (wcel M (co (cfv K cmgp) R cprimroots)) $ >
  $ wceq H (cmpt h (co cn0 (co cc0 A2 cfz) cmap) (cfv M (cfv (cfv (cv h) G) (cfv K ce1)))) $ >
  $ wceq D (cfv (cima L (cima E (cxp cn0 cn0))) chash) $ >
  $ wceq S (crab s1 (wbr (csu t (co cc0 A2 cfz) (cfv (cv t) (cv s1))) (co D c1 cmin) cle) (co cn0 (co cc0 A2 cfz) cmap)) $ >
  $ wi ph (wcel U S) $ >
  $ wi ph (wcel V S) $ >
  $ wi ph (wceq (cfv U (cres H S)) (cfv V (cres H S))) $ >
  $ wi ph (wne U V) $ >
  $ wceq J (cmpt j (cxp cn0 cn0) (co (cfv (cv j) E) M (cfv (cfv K cmgp) cmg))) $ >
  $ wi ph (wbr (cfv (cima L (cima E (cxp cn0 cn0))) chash) (cfv (cima J (cxp cn0 cn0)) chash) cle) $ >
  $ wi ph (wbr D (cfv (cima (ccnv (cfv (co (cfv U G) (cfv V G) (cfv (cfv K cpl1) csg)) (cfv K ce1))) (csn (cfv K c0g))) chash) cle) $;


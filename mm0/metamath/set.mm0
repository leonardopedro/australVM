theorem cdlemkfid2N {b: setvar} (A2 B2 P R T F H c_or K c_le c_an N W Z: class b):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq Z (co (co P (cfv (cv b) R) c_or) (co (cfv P N) (cfv (ccom (cv b) (ccnv F)) R) c_or) c_an) $ >
  $ wi (w3a (wa (wa (wcel K chlt) (wcel W H)) (wceq F N)) (w3a (wcel F T) (wne F (cres cid B2)) (wcel (cv b) T)) (wa (wne (cfv (cv b) R) (cfv F R)) (wa (wcel P A2) (wn (wbr P W c_le))))) (wceq Z (cfv P (cv b))) $;

--| Lemma for ~ cdlemkid . (Contributed by NM, 24-Jul-2013.)
theorem cdlemkid2 {g2 b: setvar} (A2: class g2 b) (B2 P R T: class b) (F G H: class g2 b) (c_or: class b) (K c_le: class g2 b) (c_an: class b) (N W Y: class g2 b) (Z: class b):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq Z (co (co P (cfv (cv b) R) c_or) (co (cfv P N) (cfv (ccom (cv b) (ccnv F)) R) c_or) c_an) $ >
  $ wceq Y (co (co P (cfv (cv g2) R) c_or) (co Z (cfv (ccom (cv g2) (ccnv (cv b))) R) c_or) c_an) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (w3a (wcel F T) (wcel N T) (wceq (cfv F R) (cfv N R))) (w3a (wa (wcel P A2) (wn (wbr P W c_le))) (wceq G (cres cid B2)) (wa (wcel (cv b) T) (wne (cv b) (cres cid B2))))) (wceq (csb g2 G Y) P) $;


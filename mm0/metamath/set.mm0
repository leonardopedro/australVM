--| Vector independence lemma. (Contributed by NM, 29-Apr-2015.)
theorem mapdindp0 {w: setvar} (ph: wff w) (c_pl N V W X Y c_0 Z: class w):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel Y (cdif V (csn c_0))) $ >
  $ wi ph (wcel Z (cdif V (csn c_0))) $ >
  $ wi ph (wcel (cv w) (cdif V (csn c_0))) $ >
  $ wi ph (wceq (cfv (csn Y) N) (cfv (csn Z) N)) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wn (wcel (cv w) (cfv (cpr X Y) N))) $ >
  $ wi ph (wne (co Y Z c_pl) c_0) $ >
  $ wi ph (wceq (cfv (csn (co Y Z c_pl)) N) (cfv (csn Y) N)) $;


  $ wi (w3a (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (w3a (wa (wcel (cv v) A2) (wbr (cv v) W c_le)) (wa (wcel N A2) (wceq O (cfv K cp0))) (wa (wcel F T) (wcel G T))) (w3a (wne P Q) (wne (cv v) (cfv F R)) (wrex r (wa (wn (wbr (cv r) W c_le)) (wceq (co P (cv r) c_or) (co Q (cv r) c_or))) A2))) (wrex z (wa (wn (wbr (cv z) W c_le)) (w3a (wne (cv z) N) (wne (cv z) O) (wbr (cv z) (co P (cv v) c_or) c_le))) A2) $;


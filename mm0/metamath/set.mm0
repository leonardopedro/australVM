--| Lemma for ~ llnexchb2 . (Contributed by NM, 17-Nov-2012.)
theorem llnexchb2lem (A2 P Q c_or K c_le c_an N X Y: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq N (cfv K clln) $ >
  $ wi (w3a (w3a (wcel K chlt) (wcel X N) (wcel Y N)) (w3a (wcel P A2) (wcel Q A2) (wn (wbr P X c_le))) (wcel (co X Y c_an) A2)) (wb (wbr (co X Y c_an) (co P Q c_or) c_le) (wceq (co X Y c_an) (co X (co P Q c_or) c_an))) $;

--| Line exchange property (compare ~ cvlatexchb2 for atoms). (Contributed by NM, 17-Nov-2012.)
theorem llnexchb2 (A2 c_or K c_le c_an N X Y Z: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq N (cfv K clln) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel X N) (wcel Y N) (wcel Z N)) (wa (wcel (co X Y c_an) A2) (wne X Z))) (wb (wbr (co X Y c_an) Z c_le) (wceq (co X Y c_an) (co X Z c_an))) $;

--| Line exchange property (compare ~ cvlatexch2 for atoms). (Contributed by NM, 18-Nov-2012.) (New usage is discouraged.)
theorem llnexch2N (A2 c_or K c_le c_an N X Y Z: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq N (cfv K clln) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel X N) (wcel Y N) (wcel Z N)) (wa (wcel (co X Y c_an) A2) (wne X Z))) (wi (wbr (co X Y c_an) Z c_le) (wbr (co X Z c_an) Y c_le)) $;

--| Lemma for ~ dalaw . Special case of ~ dath2 , where ` C ` is replaced by ` ( ( P .\/ S ) ./\ ( Q .\/ T ) ) ` . The remaining lemmas will eliminate the conditions on the atoms imposed by ~ dath2 . (Contributed by NM, 6-Oct-2012.)
theorem dalawlem1 (A2 P Q R S T U c_or K c_le c_an O: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq O (cfv K clpl) $ >
  $ wi (w3a (w3a (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel (co (co P Q c_or) R c_or) O) (wcel (co (co S T c_or) U c_or) O)) (w3a (w3a (wn (wbr (co (co P S c_or) (co Q T c_or) c_an) (co P Q c_or) c_le)) (wn (wbr (co (co P S c_or) (co Q T c_or) c_an) (co Q R c_or) c_le)) (wn (wbr (co (co P S c_or) (co Q T c_or) c_an) (co R P c_or) c_le))) (w3a (wn (wbr (co (co P S c_or) (co Q T c_or) c_an) (co S T c_or) c_le)) (wn (wbr (co (co P S c_or) (co Q T c_or) c_an) (co T U c_or) c_le)) (wn (wbr (co (co P S c_or) (co Q T c_or) c_an) (co U S c_or) c_le))) (wbr (co (co P S c_or) (co Q T c_or) c_an) (co R U c_or) c_le))) (wbr (co (co P Q c_or) (co S T c_or) c_an) (co (co (co Q R c_or) (co T U c_or) c_an) (co (co R P c_or) (co U S c_or) c_an) c_or) c_le) $;

--| Lemma for ~ dalaw . Utility lemma that breaks ` ( ( P .\/ Q ) ./\ ( S .\/ T ) ) ` into a join of two pieces. (Contributed by NM, 6-Oct-2012.)
theorem dalawlem2 (A2 P Q S T c_or K c_le c_an: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (wa (wcel P A2) (wcel Q A2)) (wa (wcel S A2) (wcel T A2))) (wbr (co (co P Q c_or) (co S T c_or) c_an) (co (co (co (co P Q c_or) T c_or) S c_an) (co (co (co P Q c_or) S c_or) T c_an) c_or) c_le) $;

--| Lemma for ~ dalaw . First piece of ~ dalawlem5 . (Contributed by NM, 4-Oct-2012.)
theorem dalawlem3 (A2 P Q R S T U c_or K c_le c_an: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (w3a (wcel K chlt) (wbr (co (co P S c_or) (co Q T c_or) c_an) (co P Q c_or) c_le) (wbr (co (co P S c_or) (co Q T c_or) c_an) (co R U c_or) c_le)) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wbr (co (co (co Q T c_or) P c_or) S c_an) (co (co (co Q R c_or) (co T U c_or) c_an) (co (co R P c_or) (co U S c_or) c_an) c_or) c_le) $;

--| Lemma for ~ dalaw . Second piece of ~ dalawlem5 . (Contributed by NM, 4-Oct-2012.)
theorem dalawlem4 (A2 P Q R S T U c_or K c_le c_an: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (w3a (wcel K chlt) (wbr (co (co P S c_or) (co Q T c_or) c_an) (co P Q c_or) c_le) (wbr (co (co P S c_or) (co Q T c_or) c_an) (co R U c_or) c_le)) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wbr (co (co (co P S c_or) Q c_or) T c_an) (co (co (co Q R c_or) (co T U c_or) c_an) (co (co R P c_or) (co U S c_or) c_an) c_or) c_le) $;

--| Lemma for ~ dalaw . Special case to eliminate the requirement ` -. ( P .\/ S ) ./\ ( Q .\/ T ) ) .<_ ( P .\/ Q ) ` in ~ dalawlem1 . (Contributed by NM, 4-Oct-2012.)
theorem dalawlem5 (A2 P Q R S T U c_or K c_le c_an: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >

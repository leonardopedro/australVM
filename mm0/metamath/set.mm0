  $ wi (wa (wcel K chlt) (wcel W H)) (wb (wcel F T) (wrex p (wrex q (w3a (wn (wbr (cv p) W c_le)) (wn (wbr (cv q) W c_le)) (wceq F G)) A2) A2)) $;


--| The characteristic polynomial of a diagonal matrix. (Contributed by AV, 18-Aug-2019.) (Proof shortened by AV, 21-Nov-2019.)
theorem chpdmat {i j k: setvar} (A2: class i j k) (B2: class) (C: class i j k) (P R: class) (S: class i j k) (G: class i j) (M: class) (c_mi: class i j k) (N X: class) (c_0: class i j):
  $ wceq C (co N R cchpmat) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq S (cfv P cascl) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq G (cfv P cmgp) $ >
  $ wceq c_mi (cfv P csg) $ >
  $ wi (wa (w3a (wcel N cfn) (wcel R ccrg) (wcel M B2)) (wral i (wral j (wi (wne (cv i) (cv j)) (wceq (co (cv i) (cv j) M) c_0)) N) N)) (wceq (cfv M C) (co G (cmpt k N (co X (cfv (co (cv k) (cv k) M) S) c_mi)) cgsu)) $;

--| The characteristic polynomial of a (nonempty!) scalar matrix. (Contributed by AV, 21-Aug-2019.)
theorem chpscmat {i j m n c: setvar} (A2: class n) (C: class i j m n c) (D: class i j m c) (P: class m c) (R: class) (S E: class i j m c) (c_ex G: class i j m n c) (I: class i j m c) (M: class) (c_mi: class i j m n c) (N: class) (X: class m n c):
  $ wceq C (co N R cchpmat) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq G (cfv P cmgp) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wceq D (crab m (wrex c (wral i (wral j (wceq (co (cv i) (cv j) (cv m)) (cif (wceq (cv i) (cv j)) (cv c) (cfv R c0g))) N) N) (cfv R cbs)) (cfv A2 cbs)) $ >
  $ wceq S (cfv P cascl) $ >
  $ wceq c_mi (cfv P csg) $ >
  $ wi (wa (wa (wcel N cfn) (wcel R ccrg)) (w3a (wcel M D) (wcel I N) (wral n (wceq (co (cv n) (cv n) M) E) N))) (wceq (cfv M C) (co (cfv N chash) (co X (cfv E S) c_mi) c_ex)) $;

--| The characteristic polynomial of a (nonempty!) scalar matrix, expressed with its diagonal element. (Contributed by AV, 21-Aug-2019.)
theorem chpscmat0 {i j m n c: setvar} (A2: class n) (C: class i j m n c) (D: class i j m c) (P: class m c) (R: class) (S: class i j m c) (c_ex G: class i j m n c) (I: class i j m c) (M: class) (c_mi: class i j m n c) (N: class) (X: class m n c):
  $ wceq C (co N R cchpmat) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq G (cfv P cmgp) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wceq D (crab m (wrex c (wral i (wral j (wceq (co (cv i) (cv j) (cv m)) (cif (wceq (cv i) (cv j)) (cv c) (cfv R c0g))) N) N) (cfv R cbs)) (cfv A2 cbs)) $ >
  $ wceq S (cfv P cascl) $ >
  $ wceq c_mi (cfv P csg) $ >
  $ wi (wa (wa (wcel N cfn) (wcel R ccrg)) (w3a (wcel M D) (wcel I N) (wral n (wceq (co (cv n) (cv n) M) (co I I M)) N))) (wceq (cfv M C) (co (cfv N chash) (co X (cfv (co I I M) S) c_mi) c_ex)) $;

--| The characteristic polynomial of a (nonempty!) scalar matrix, expressed as finite group sum of binomials. (Contributed by AV, 2-Sep-2019.)
theorem chpscmatgsumbin {i j m n c l: setvar} (A2: class n l) (C: class i j m n c l) (D: class i j m c) (P: class m c) (R: class) (S: class i j m c) (c_x: class i j m n c l) (E: class i j m c l) (c_ex F: class i j m n c) (G H: class i j m n c l) (I J: class i j m c) (M: class) (c_mi: class i j m n c l) (N: class) (X: class m n c):
  $ wceq C (co N R cchpmat) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq G (cfv P cmgp) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wceq D (crab m (wrex c (wral i (wral j (wceq (co (cv i) (cv j) (cv m)) (cif (wceq (cv i) (cv j)) (cv c) (cfv R c0g))) N) N) (cfv R cbs)) (cfv A2 cbs)) $ >
  $ wceq S (cfv P cascl) $ >
  $ wceq c_mi (cfv P csg) $ >
  $ wceq F (cfv P cmg) $ >
  $ wceq H (cfv R cmgp) $ >
  $ wceq E (cfv H cmg) $ >
  $ wceq I (cfv R cminusg) $ >
  $ wceq c_x (cfv P cvsca) $ >
  $ wi (wa (wa (wcel N cfn) (wcel R ccrg)) (w3a (wcel M D) (wcel J N) (wral n (wceq (co (cv n) (cv n) M) (co J J M)) N))) (wceq (cfv M C) (co P (cmpt l (co cc0 (cfv N chash) cfz) (co (co (cfv N chash) (cv l) cbc) (co (co (co (cfv N chash) (cv l) cmin) (cfv (co J J M) I) E) (co (cv l) X c_ex) c_x) F)) cgsu)) $;

--| The characteristic polynomial of a (nonempty!) scalar matrix, expressed as finite group sum of scaled monomials. (Contributed by AV, 2-Sep-2019.)
theorem chpscmatgsummon {i j m n c l: setvar} (A2: class n l) (C: class i j m n c l) (D: class i j m c) (P: class m c) (R: class) (S: class i j m c) (c_x: class i j m n c l) (E: class i j m c l) (c_ex F: class i j m n c) (G H: class i j m n c l) (I J: class i j m c) (M: class) (c_mi: class i j m n c l) (N: class) (X: class m n c) (Z: class i j m n c l):
  $ wceq C (co N R cchpmat) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq G (cfv P cmgp) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wceq D (crab m (wrex c (wral i (wral j (wceq (co (cv i) (cv j) (cv m)) (cif (wceq (cv i) (cv j)) (cv c) (cfv R c0g))) N) N) (cfv R cbs)) (cfv A2 cbs)) $ >
  $ wceq S (cfv P cascl) $ >
  $ wceq c_mi (cfv P csg) $ >
  $ wceq F (cfv P cmg) $ >
  $ wceq H (cfv R cmgp) $ >
  $ wceq E (cfv H cmg) $ >
  $ wceq I (cfv R cminusg) $ >
  $ wceq c_x (cfv P cvsca) $ >
  $ wceq Z (cfv R cmg) $ >
  $ wi (wa (wa (wcel N cfn) (wcel R ccrg)) (w3a (wcel M D) (wcel J N) (wral n (wceq (co (cv n) (cv n) M) (co J J M)) N))) (wceq (cfv M C) (co P (cmpt l (co cc0 (cfv N chash) cfz) (co (co (co (cfv N chash) (cv l) cbc) (co (co (cfv N chash) (cv l) cmin) (cfv (co J J M) I) E) Z) (co (cv l) X c_ex) c_x)) cgsu)) $;

--| The characteristic polynomial of the zero matrix. (Contributed by AV, 18-Aug-2019.)
theorem chp0mat (A2 C P R c_ex G N X c_0: class):
  $ wceq C (co N R cchpmat) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq G (cfv P cmgp) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wceq c_0 (cfv A2 c0g) $ >
  $ wi (wa (wcel N cfn) (wcel R ccrg)) (wceq (cfv c_0 C) (co (cfv N chash) X c_ex)) $;

--| The characteristic polynomial of the identity matrix. (Contributed by AV, 19-Aug-2019.)
theorem chpidmat (A2 C P R S c_1 c_ex G I c_mi N X: class):
  $ wceq C (co N R cchpmat) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq G (cfv P cmgp) $ >
  $ wceq c_ex (cfv G cmg) $ >
  $ wceq I (cfv A2 cur) $ >
  $ wceq S (cfv P cascl) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_mi (cfv P csg) $ >
  $ wi (wa (wcel N cfn) (wcel R ccrg)) (wceq (cfv I C) (co (cfv N chash) (co X (cfv c_1 S) c_mi) c_ex)) $;

--| The characteristic polynomial of a matrix multiplied with the identity matrix is a scalar matrix. (Contributed by AV, 30-Oct-2019.) (Revised by AV, 5-Jul-2022.)
theorem chmaidscmat (A2 B2 C P R S c_x c_1 E K M N Y: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq C (co N R cchpmat) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq E (cfv P cbs) $ >
  $ wceq Y (co N P cmat) $ >
  $ wceq K (cfv Y cbs) $ >
  $ wceq c_x (cfv Y cvsca) $ >
  $ wceq c_1 (cfv Y cur) $ >
  $ wceq S (co N P cscmat) $ >
  $ wi (w3a (wcel N cfn) (wcel R ccrg) (wcel M B2)) (wcel (co (cfv M C) c_1 c_x) S) $;

--| The function values of a mapping from the nonnegative integers with four distinct cases. (Contributed by AV, 10-Nov-2019.)
theorem fvmptnn04if {n: setvar} (ph: wff n) (A2 B2 C D: class n) (S: class) (G: class n) (N: class) (V Y: class n):
  $ wceq G (cmpt n cn0 (cif (wceq (cv n) cc0) A2 (cif (wceq (cv n) S) C (cif (wbr S (cv n) clt) D B2)))) $ >
  $ wi ph (wcel S cn) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel Y V) $ >
  $ wi (wa ph (wceq N cc0)) (wceq Y (csb n N A2)) $ >
  $ wi (w3a ph (wbr cc0 N clt) (wbr N S clt)) (wceq Y (csb n N B2)) $ >
  $ wi (wa ph (wceq N S)) (wceq Y (csb n N C)) $ >
  $ wi (wa ph (wbr S N clt)) (wceq Y (csb n N D)) $ >
  $ wi ph (wceq (cfv N G) Y) $;

--| The function value of a mapping from the nonnegative integers with four distinct cases for the first case. (Contributed by AV, 10-Nov-2019.)
theorem fvmptnn04ifa {n: setvar} (ph: wff n) (A2: class) (B2 C D: class n) (S: class) (G: class n) (N V: class):
  $ wceq G (cmpt n cn0 (cif (wceq (cv n) cc0) A2 (cif (wceq (cv n) S) C (cif (wbr S (cv n) clt) D B2)))) $ >
  $ wi ph (wcel S cn) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi (w3a ph (wceq N cc0) (wcel (csb n N A2) V)) (wceq (cfv N G) (csb n N A2)) $;

--| The function value of a mapping from the nonnegative integers with four distinct cases for the second case. (Contributed by AV, 10-Nov-2019.)
theorem fvmptnn04ifb {n: setvar} (ph: wff n) (A2: class) (B2 C D: class n) (S: class) (G: class n) (N V: class):
  $ wceq G (cmpt n cn0 (cif (wceq (cv n) cc0) A2 (cif (wceq (cv n) S) C (cif (wbr S (cv n) clt) D B2)))) $ >
  $ wi ph (wcel S cn) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi (w3a ph (wa (wbr cc0 N clt) (wbr N S clt)) (wcel (csb n N B2) V)) (wceq (cfv N G) (csb n N B2)) $;

--| The function value of a mapping from the nonnegative integers with four distinct cases for the third case. (Contributed by AV, 10-Nov-2019.)
theorem fvmptnn04ifc {n: setvar} (ph: wff n) (A2: class) (B2 C D: class n) (S: class) (G: class n) (N V: class):
  $ wceq G (cmpt n cn0 (cif (wceq (cv n) cc0) A2 (cif (wceq (cv n) S) C (cif (wbr S (cv n) clt) D B2)))) $ >
  $ wi ph (wcel S cn) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi (w3a ph (wceq N S) (wcel (csb n N C) V)) (wceq (cfv N G) (csb n N C)) $;

--| The function value of a mapping from the nonnegative integers with four distinct cases for the forth case. (Contributed by AV, 10-Nov-2019.)
theorem fvmptnn04ifd {n: setvar} (ph: wff n) (A2: class) (B2 C D: class n) (S: class) (G: class n) (N V: class):
  $ wceq G (cmpt n cn0 (cif (wceq (cv n) cc0) A2 (cif (wceq (cv n) S) C (cif (wbr S (cv n) clt) D B2)))) $ >
  $ wi ph (wcel S cn) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi (w3a ph (wbr S N clt) (wcel (csb n N D) V)) (wceq (cfv N G) (csb n N D)) $;

--| The "characteristic factor function" is a function from the nonnegative integers to polynomial matrices. (Contributed by AV, 8-Nov-2019.)
theorem chfacfisf {n s1 b: setvar} (A2: class n s1 b) (B2: class s1 b) (P: class n s1 b) (R: class s1 b) (T c_xp G: class n s1 b) (M: class s1 b) (c_mi: class n s1 b) (N Y: class s1 b) (c_0: class n s1 b):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq Y (co N P cmat) $ >
  $ wceq c_xp (cfv Y cmulr) $ >
  $ wceq c_mi (cfv Y csg) $ >
  $ wceq c_0 (cfv Y c0g) $ >
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq G (cmpt n cn0 (cif (wceq (cv n) cc0) (co c_0 (co (cfv M T) (cfv (cfv cc0 (cv b)) T) c_xp) c_mi) (cif (wceq (cv n) (co (cv s1) c1 caddc)) (cfv (cfv (cv s1) (cv b)) T) (cif (wbr (co (cv s1) c1 caddc) (cv n) clt) c_0 (co (cfv (cfv (co (cv n) c1 cmin) (cv b)) T) (co (cfv M T) (cfv (cfv (cv n) (cv b)) T) c_xp) c_mi))))) $ >
  $ wi (wa (w3a (wcel N cfn) (wcel R crg) (wcel M B2)) (wa (wcel (cv s1) cn) (wcel (cv b) (co B2 (co cc0 (cv s1) cfz) cmap)))) (wf cn0 (cfv Y cbs) G) $;

--| The "characteristic factor function" is a function from the nonnegative integers to constant polynomial matrices. (Contributed by AV, 19-Nov-2019.)
theorem chfacfisfcpmat {n s1 b: setvar} (A2: class n s1 b) (B2: class s1 b) (P: class n s1 b) (R S: class s1 b) (T c_xp G: class n s1 b) (M: class s1 b) (c_mi: class n s1 b) (N Y: class s1 b) (c_0: class n s1 b):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq Y (co N P cmat) $ >
  $ wceq c_xp (cfv Y cmulr) $ >
  $ wceq c_mi (cfv Y csg) $ >
  $ wceq c_0 (cfv Y c0g) $ >
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq G (cmpt n cn0 (cif (wceq (cv n) cc0) (co c_0 (co (cfv M T) (cfv (cfv cc0 (cv b)) T) c_xp) c_mi) (cif (wceq (cv n) (co (cv s1) c1 caddc)) (cfv (cfv (cv s1) (cv b)) T) (cif (wbr (co (cv s1) c1 caddc) (cv n) clt) c_0 (co (cfv (cfv (co (cv n) c1 cmin) (cv b)) T) (co (cfv M T) (cfv (cfv (cv n) (cv b)) T) c_xp) c_mi))))) $ >
  $ wceq S (co N R ccpmat) $ >
  $ wi (wa (w3a (wcel N cfn) (wcel R crg) (wcel M B2)) (wa (wcel (cv s1) cn) (wcel (cv b) (co B2 (co cc0 (cv s1) cfz) cmap)))) (wf cn0 S G) $;

--| The "characteristic factor function" is finitely supported. (Contributed by AV, 20-Nov-2019.) (Proof shortened by AV, 23-Dec-2019.)
theorem chfacffsupp {n s1 b: setvar} (A2: class n s1 b) (B2: class s1 b) (P: class n s1 b) (R: class s1 b) (T c_xp G: class n s1 b) (M: class s1 b) (c_mi: class n s1 b) (N Y: class s1 b) (c_0: class n s1 b):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq P (cfv R cpl1) $ >

  $ wceq S (cfv W (cfv K chdma)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel Y (cdif V (csn c_0))) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel G A2) $ >
  $ wi ph (wcel I A2) $ >
  $ wi ph (wceq (cfv (co F X c_x) S) (co G (cfv X S) c_xb)) $ >
  $ wi ph (wceq (cfv (co F Y c_x) S) (co I (cfv Y S) c_xb)) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wcel J A2) $ >
  $ wi ph (wceq (cfv (co F (co X Y c_pl) c_x) S) (co J (cfv (co X Y c_pl) S) c_xb)) $ >
  $ wi ph (wceq (co (co J (cfv X S) c_xb) (co J (cfv Y S) c_xb) c_pb) (co (co G (cfv X S) c_xb) (co I (cfv Y S) c_xb) c_pb)) $;


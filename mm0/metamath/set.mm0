--| Lemma for ~ cvmlift2 . (Contributed by Mario Carneiro, 1-Jun-2015.)
theorem cvmlift2lem9 {x3 y1 z f2 k s1 b c d: setvar} (ph: wff k s1 c d) (B2: class f2 k s1) (C: class) (P: class s1 b c d) (S: class k s1 c d) (T: class x3 y1 z f2 k) (U: class x3 y1 f2 k s1 b c d) (F: class) (G: class s1 d) (H: class k s1 d) (J: class) (K: class k s1) (M: class f2) (V: class x3 y1 z f2 k s1 b c d) (W: class x3 y1 z f2 k s1 b) (X Y: class s1) (Z: class x3 y1 f2 k s1 b c d):
  $ wceq B2 (cuni C) $ >
  $ wi ph (wcel F (co C J ccvm)) $ >
  $ wi ph (wcel G (co (co cii cii ctx) J ccn)) $ >
  $ wi ph (wcel P B2) $ >
  $ wi ph (wceq (cfv P F) (co cc0 cc0 G)) $ >
  $ wceq H (crio f2 (wa (wceq (ccom F (cv f2)) (cmpt z (co cc0 c1 cicc) (co (cv z) cc0 G))) (wceq (cfv cc0 (cv f2)) P)) (co cii C ccn)) $ >
  $ wceq K (cmpo x3 y1 (co cc0 c1 cicc) (co cc0 c1 cicc) (cfv (cv y1) (crio f2 (wa (wceq (ccom F (cv f2)) (cmpt z (co cc0 c1 cicc) (co (cv x3) (cv z) G))) (wceq (cfv cc0 (cv f2)) (cfv (cv x3) H))) (co cii C ccn)))) $ >
  $ wceq S (cmpt k J (crab s1 (wa (wceq (cuni (cv s1)) (cima (ccnv F) (cv k))) (wral c (wa (wral d (wceq (cin (cv c) (cv d)) c0) (cdif (cv s1) (csn (cv c)))) (wcel (cres F (cv c)) (co (co C (cv c) crest) (co J (cv k) crest) chmeo))) (cv s1))) (cdif (cpw C) (csn c0)))) $ >
  $ wi ph (wcel (co X Y G) M) $ >
  $ wi ph (wcel T (cfv M S)) $ >
  $ wi ph (wcel U cii) $ >
  $ wi ph (wcel V cii) $ >
  $ wi ph (wcel (co cii U crest) cconn) $ >
  $ wi ph (wcel (co cii V crest) cconn) $ >
  $ wi ph (wcel X U) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wss (cxp U V) (cima (ccnv G) M)) $ >
  $ wi ph (wcel Z V) $ >
  $ wi ph (wcel (cres K (cxp U (csn Z))) (co (co (co cii cii ctx) (cxp U (csn Z)) crest) C ccn)) $ >
  $ wceq W (crio b (wcel (co X Y K) (cv b)) T) $ >
  $ wi ph (wcel (cres K (cxp U V)) (co (co (co cii cii ctx) (cxp U V) crest) C ccn)) $;

--| Lemma for ~ cvmlift2 . (Contributed by Mario Carneiro, 1-Jun-2015.)
theorem cvmlift2lem10 {x3 y1 z w v u f2 k s1 c d: setvar} (ph: wff k s1 c d) (B2: class u f2 k s1) (C: class) (P: class w s1 c d) (S: class k s1 c d) (F: class) (G: class s1 d) (H: class k s1 d) (J: class) (K: class k s1) (X Y: class s1):
  $ wceq B2 (cuni C) $ >
  $ wi ph (wcel F (co C J ccvm)) $ >
  $ wi ph (wcel G (co (co cii cii ctx) J ccn)) $ >
  $ wi ph (wcel P B2) $ >
  $ wi ph (wceq (cfv P F) (co cc0 cc0 G)) $ >
  $ wceq H (crio f2 (wa (wceq (ccom F (cv f2)) (cmpt z (co cc0 c1 cicc) (co (cv z) cc0 G))) (wceq (cfv cc0 (cv f2)) P)) (co cii C ccn)) $ >
  $ wceq K (cmpo x3 y1 (co cc0 c1 cicc) (co cc0 c1 cicc) (cfv (cv y1) (crio f2 (wa (wceq (ccom F (cv f2)) (cmpt z (co cc0 c1 cicc) (co (cv x3) (cv z) G))) (wceq (cfv cc0 (cv f2)) (cfv (cv x3) H))) (co cii C ccn)))) $ >
  $ wceq S (cmpt k J (crab s1 (wa (wceq (cuni (cv s1)) (cima (ccnv F) (cv k))) (wral c (wa (wral d (wceq (cin (cv c) (cv d)) c0) (cdif (cv s1) (csn (cv c)))) (wcel (cres F (cv c)) (co (co C (cv c) crest) (co J (cv k) crest) chmeo))) (cv s1))) (cdif (cpw C) (csn c0)))) $ >
  $ wi ph (wcel X (co cc0 c1 cicc)) $ >
  $ wi ph (wcel Y (co cc0 c1 cicc)) $ >
  $ wi ph (wrex u (wrex v (w3a (wcel X (cv u)) (wcel Y (cv v)) (wi (wrex w (wcel (cres K (cxp (cv u) (csn (cv w)))) (co (co (co cii cii ctx) (cxp (cv u) (csn (cv w))) crest) C ccn)) (cv v)) (wcel (cres K (cxp (cv u) (cv v))) (co (co (co cii cii ctx) (cxp (cv u) (cv v)) crest) C ccn)))) cii) cii) $;

--| Lemma for ~ cvmlift2 . (Contributed by Mario Carneiro, 1-Jun-2015.)
theorem cvmlift2lem11 {x3 y1 z w f2: setvar} (ph: wff) (B2: class f2) (C: class) (P: class w) (U: class x3 y1 f2) (F G H J K: class) (M: class w f2) (V: class x3 y1 z f2) (Y: class) (Z: class x3 y1 w f2):
  $ wceq B2 (cuni C) $ >
  $ wi ph (wcel F (co C J ccvm)) $ >
  $ wi ph (wcel G (co (co cii cii ctx) J ccn)) $ >
  $ wi ph (wcel P B2) $ >
  $ wi ph (wceq (cfv P F) (co cc0 cc0 G)) $ >
  $ wceq H (crio f2 (wa (wceq (ccom F (cv f2)) (cmpt z (co cc0 c1 cicc) (co (cv z) cc0 G))) (wceq (cfv cc0 (cv f2)) P)) (co cii C ccn)) $ >
  $ wceq K (cmpo x3 y1 (co cc0 c1 cicc) (co cc0 c1 cicc) (cfv (cv y1) (crio f2 (wa (wceq (ccom F (cv f2)) (cmpt z (co cc0 c1 cicc) (co (cv x3) (cv z) G))) (wceq (cfv cc0 (cv f2)) (cfv (cv x3) H))) (co cii C ccn)))) $ >
  $ wceq M (crab z (wcel K (cfv (cv z) (co (co cii cii ctx) C ccnp))) (cxp (co cc0 c1 cicc) (co cc0 c1 cicc))) $ >
  $ wi ph (wcel U cii) $ >
  $ wi ph (wcel V cii) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wcel Z V) $ >
  $ wi ph (wi (wrex w (wcel (cres K (cxp U (csn (cv w)))) (co (co (co cii cii ctx) (cxp U (csn (cv w))) crest) C ccn)) V) (wcel (cres K (cxp U V)) (co (co (co cii cii ctx) (cxp U V) crest) C ccn))) $ >
  $ wi ph (wi (wss (cxp U (csn Y)) M) (wss (cxp U (csn Z)) M)) $;

--| Lemma for ~ cvmlift2 . (Contributed by Mario Carneiro, 1-Jun-2015.)
theorem cvmlift2lem12 {x3 y1 z u t f2 r a: setvar} (ph: wff) (A2: class y1 z u f2 r) (B2: class u t f2 r a) (C: class) (P: class t r a) (S: class r a) (F: class t r a) (G: class r) (H J: class t r a) (K: class) (M: class t f2):
  $ wceq B2 (cuni C) $ >
  $ wi ph (wcel F (co C J ccvm)) $ >
  $ wi ph (wcel G (co (co cii cii ctx) J ccn)) $ >
  $ wi ph (wcel P B2) $ >
  $ wi ph (wceq (cfv P F) (co cc0 cc0 G)) $ >
  $ wceq H (crio f2 (wa (wceq (ccom F (cv f2)) (cmpt z (co cc0 c1 cicc) (co (cv z) cc0 G))) (wceq (cfv cc0 (cv f2)) P)) (co cii C ccn)) $ >
  $ wceq K (cmpo x3 y1 (co cc0 c1 cicc) (co cc0 c1 cicc) (cfv (cv y1) (crio f2 (wa (wceq (ccom F (cv f2)) (cmpt z (co cc0 c1 cicc) (co (cv x3) (cv z) G))) (wceq (cfv cc0 (cv f2)) (cfv (cv x3) H))) (co cii C ccn)))) $ >
  $ wceq M (crab z (wcel K (cfv (cv z) (co (co cii cii ctx) C ccnp))) (cxp (co cc0 c1 cicc) (co cc0 c1 cicc))) $ >
  $ wceq A2 (crab a (wss (cxp (co cc0 c1 cicc) (csn (cv a))) M) (co cc0 c1 cicc)) $ >
  $ wceq S (copab r t (wa (wcel (cv t) (co cc0 c1 cicc)) (wrex u (wb (wss (cxp (cv u) (csn (cv a))) M) (wss (cxp (cv u) (csn (cv t))) M)) (cfv (csn (cv r)) (cfv cii cnei))))) $ >
  $ wi ph (wcel K (co (co cii cii ctx) C ccn)) $;

--| Lemma for ~ cvmlift2 . (Contributed by Mario Carneiro, 7-May-2015.)
theorem cvmlift2lem13 {x3 y1 z f2 g2: setvar} (ph: wff) (B2: class f2 g2) (C P F G: class) (H: class g2) (J K: class):
  $ wceq B2 (cuni C) $ >
  $ wi ph (wcel F (co C J ccvm)) $ >
  $ wi ph (wcel G (co (co cii cii ctx) J ccn)) $ >
  $ wi ph (wcel P B2) $ >
  $ wi ph (wceq (cfv P F) (co cc0 cc0 G)) $ >
  $ wceq H (crio f2 (wa (wceq (ccom F (cv f2)) (cmpt z (co cc0 c1 cicc) (co (cv z) cc0 G))) (wceq (cfv cc0 (cv f2)) P)) (co cii C ccn)) $ >
  $ wceq K (cmpo x3 y1 (co cc0 c1 cicc) (co cc0 c1 cicc) (cfv (cv y1) (crio f2 (wa (wceq (ccom F (cv f2)) (cmpt z (co cc0 c1 cicc) (co (cv x3) (cv z) G))) (wceq (cfv cc0 (cv f2)) (cfv (cv x3) H))) (co cii C ccn)))) $ >
  $ wi ph (wreu g2 (wa (wceq (ccom F (cv g2)) G) (wceq (co cc0 cc0 (cv g2)) P)) (co (co cii cii ctx) C ccn)) $;

--| A two-dimensional version of ~ cvmlift . There is a unique lift of functions on the unit square ` II tX II ` which commutes with the covering map. (Contributed by Mario Carneiro, 1-Jun-2015.)
theorem cvmlift2 {f2: setvar} (ph: wff) (B2: class f2) (C P F G J: class):
  $ wceq B2 (cuni C) $ >
  $ wi ph (wcel F (co C J ccvm)) $ >
  $ wi ph (wcel G (co (co cii cii ctx) J ccn)) $ >
  $ wi ph (wcel P B2) $ >
  $ wi ph (wceq (cfv P F) (co cc0 cc0 G)) $ >
  $ wi ph (wreu f2 (wa (wceq (ccom F (cv f2)) G) (wceq (co cc0 cc0 (cv f2)) P)) (co (co cii cii ctx) C ccn)) $;

--| Lemma for ~ cvmliftpht . (Contributed by Mario Carneiro, 6-Jul-2015.)
theorem cvmliftphtlem {f2: setvar} (ph: wff f2) (A2 B2 C P F G H J: class) (K M N: class f2):
  $ wceq B2 (cuni C) $ >
  $ wceq M (crio f2 (wa (wceq (ccom F (cv f2)) G) (wceq (cfv cc0 (cv f2)) P)) (co cii C ccn)) $ >
  $ wceq N (crio f2 (wa (wceq (ccom F (cv f2)) H) (wceq (cfv cc0 (cv f2)) P)) (co cii C ccn)) $ >
  $ wi ph (wcel F (co C J ccvm)) $ >
  $ wi ph (wcel P B2) $ >
  $ wi ph (wceq (cfv P F) (cfv cc0 G)) $ >
  $ wi ph (wcel G (co cii J ccn)) $ >
  $ wi ph (wcel H (co cii J ccn)) $ >
  $ wi ph (wcel K (co G H (cfv J cphtpy))) $ >
  $ wi ph (wcel A2 (co (co cii cii ctx) C ccn)) $ >
  $ wi ph (wceq (ccom F A2) K) $ >
  $ wi ph (wceq (co cc0 cc0 A2) P) $ >
  $ wi ph (wcel A2 (co M N (cfv C cphtpy))) $;

--| If ` G ` and ` H ` are path-homotopic, then their lifts ` M ` and ` N ` are also path-homotopic. (Contributed by Mario Carneiro, 6-Jul-2015.)
theorem cvmliftpht {f2: setvar} (ph: wff f2) (B2 C P F G H J: class) (M N: class f2):
  $ wceq B2 (cuni C) $ >
  $ wceq M (crio f2 (wa (wceq (ccom F (cv f2)) G) (wceq (cfv cc0 (cv f2)) P)) (co cii C ccn)) $ >
  $ wceq N (crio f2 (wa (wceq (ccom F (cv f2)) H) (wceq (cfv cc0 (cv f2)) P)) (co cii C ccn)) $ >
  $ wi ph (wcel F (co C J ccvm)) $ >
  $ wi ph (wcel P B2) $ >
  $ wi ph (wceq (cfv P F) (cfv cc0 G)) $ >
  $ wi ph (wbr G H (cfv J cphtpc)) $ >
  $ wi ph (wbr M N (cfv C cphtpc)) $;

--| Lemma for ~ cvmlift3 . (Contributed by Mario Carneiro, 6-Jul-2015.)
theorem cvmlift3lem1 {g2: setvar} (ph: wff g2) (B2 C P F G J K M N O Y: class):
  $ wceq B2 (cuni C) $ >
  $ wceq Y (cuni K) $ >
  $ wi ph (wcel F (co C J ccvm)) $ >
  $ wi ph (wcel K csconn) $ >
  $ wi ph (wcel K (cnlly cpconn)) $ >
  $ wi ph (wcel O Y) $ >
  $ wi ph (wcel G (co K J ccn)) $ >
  $ wi ph (wcel P B2) $ >
  $ wi ph (wceq (cfv P F) (cfv O G)) $ >
  $ wi ph (wcel M (co cii K ccn)) $ >
  $ wi ph (wceq (cfv cc0 M) O) $ >
  $ wi ph (wcel N (co cii K ccn)) $ >
  $ wi ph (wceq (cfv cc0 N) O) $ >
  $ wi ph (wceq (cfv c1 M) (cfv c1 N)) $ >
  $ wi ph (wceq (cfv c1 (crio g2 (wa (wceq (ccom F (cv g2)) (ccom G M)) (wceq (cfv cc0 (cv g2)) P)) (co cii C ccn))) (cfv c1 (crio g2 (wa (wceq (ccom F (cv g2)) (ccom G N)) (wceq (cfv cc0 (cv g2)) P)) (co cii C ccn)))) $;


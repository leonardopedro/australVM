  $ wceq H (cfv Q chof) $ >
  $ wceq R (co (co Q O cxpc) T cfuc) $ >
  $ wceq E (co O S cevlf) $ >
  $ wceq Z (co H (co (co (cop (cfv Y c1st) (ctpos (cfv Y c2nd))) (co Q O c2ndf) ccofu) (co Q O c1stf) cprf) ccofu) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel V W) $ >
  $ wi ph (wss (crn (cfv C chomf)) U) $ >
  $ wi ph (wss (cun (crn (cfv Q chomf)) U) V) $ >
  $ wi ph (wcel F (co O S cfunc)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (co F X (cfv Z c1st)) (co (cfv X (cfv Y c1st)) F (co O S cnat))) $;


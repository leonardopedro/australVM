--| Eliminate ` P =/= Q ` conditions from ~ cdlemg39 . TODO: Fix comment. (Contributed by NM, 31-May-2013.)
theorem cdlemg40 (A2 P Q T F G H c_or K c_le c_an W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wa (wcel F T) (wcel G T))) (wceq (co (co P (cfv (cfv P G) F) c_or) W c_an) (co (co Q (cfv (cfv Q G) F) c_or) W c_an)) $;

--| Convert ~ cdlemg40 to function composition. TODO: Fix comment. (Contributed by NM, 31-May-2013.)
theorem cdlemg41 (A2 P Q T F G H c_or K c_le c_an W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wa (wcel F T) (wcel G T))) (wceq (co (co P (cfv P (ccom F G)) c_or) W c_an) (co (co Q (cfv Q (ccom F G)) c_or) W c_an)) $;

--| The composition of two translations is a translation. Part of proof of Lemma G of [Crawley] p. 116, line 15 on p. 117. (Contributed by NM, 31-May-2013.)
theorem ltrnco (T F G H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wcel G T)) (wcel (ccom F G) T) $;

--| Swap the arguments of the trace of a composition with converse. (Contributed by NM, 1-Jul-2013.)
theorem trlcocnv (R T F G H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wcel G T)) (wceq (cfv (ccom F (ccnv G)) R) (cfv (ccom G (ccnv F)) R)) $;

--| Absorption into a composition by joining with trace. (Contributed by NM, 22-Jul-2013.)
theorem trlcoabs (A2 P R T F G H c_or K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel F T) (wcel G T)) (wa (wcel P A2) (wn (wbr P W c_le)))) (wceq (co (cfv P (ccom F G)) (cfv F R) c_or) (co (cfv P G) (cfv F R) c_or)) $;

--| Absorption of the trace of a composition. (Contributed by NM, 29-Jul-2013.) (New usage is discouraged.)
theorem trlcoabs2N (A2 P R T F G H c_or K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel F T) (wcel G T)) (wa (wcel P A2) (wn (wbr P W c_le)))) (wceq (co (cfv P F) (cfv (ccom G (ccnv F)) R) c_or) (co (cfv P F) (cfv P G) c_or)) $;

--| The trace of a composition of two translations is an atom if their traces are different. (Contributed by NM, 15-Jun-2013.)
theorem trlcoat (A2 R T F G H K W: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel F T) (wcel G T)) (wne (cfv F R) (cfv G R))) (wcel (cfv (ccom F G) R) A2) $;

--| Commonly used special case of ~ trlcoat . (Contributed by NM, 1-Jul-2013.)
theorem trlcocnvat (A2 R T F G H K W: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel F T) (wcel G T)) (wne (cfv F R) (cfv G R))) (wcel (cfv (ccom F (ccnv G)) R) A2) $;

--| The composition of two different translations is not the identity translation. (Contributed by NM, 22-Jul-2013.)
theorem trlconid (B2 R T F G H K W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel F T) (wcel G T)) (wne (cfv F R) (cfv G R))) (wne (ccom F G) (cres cid B2)) $;

--| Lemma for ~ trlco . (Contributed by NM, 1-Jun-2013.)
theorem trlcolem (A2 P R T F G H c_or K c_le c_an W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel F T) (wcel G T)) (wa (wcel P A2) (wn (wbr P W c_le)))) (wbr (cfv (ccom F G) R) (co (cfv F R) (cfv G R) c_or) c_le) $;

--| The trace of a composition of translations is less than or equal to the join of their traces. Part of proof of Lemma G of [Crawley] p. 116, second paragraph on p. 117. (Contributed by NM, 2-Jun-2013.)
theorem trlco (R T F G H c_or K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wcel G T)) (wbr (cfv (ccom F G) R) (co (cfv F R) (cfv G R) c_or) c_le) $;

--| If two translations have different traces, the trace of their composition is also different. (Contributed by NM, 14-Jun-2013.)
theorem trlcone (B2 R T F G H K W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel F T) (wcel G T)) (wa (wne (cfv F R) (cfv G R)) (wne G (cres cid B2)))) (wne (cfv F R) (cfv (ccom F G) R)) $;

--| Part of proof of Lemma G of [Crawley] p. 116, first line of third paragraph on p. 117. (Contributed by NM, 3-Jun-2013.)
theorem cdlemg42 (A2 P R T F G H c_or K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel F T) (wcel G T)) (w3a (wa (wcel P A2) (wn (wbr P W c_le))) (wne (cfv P G) P) (wne (cfv F R) (cfv G R)))) (wn (wbr (cfv P G) (co P (cfv P F) c_or) c_le)) $;

--| Part of proof of Lemma G of [Crawley] p. 116, third line of third paragraph on p. 117. (Contributed by NM, 3-Jun-2013.)
theorem cdlemg43 (A2 P R T F G H c_or K c_le c_an W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel F T) (wcel G T)) (w3a (wa (wcel P A2) (wn (wbr P W c_le))) (wne (cfv P G) P) (wne (cfv F R) (cfv G R)))) (wceq (cfv (cfv P G) F) (co (co (cfv P G) (cfv F R) c_or) (co (cfv P F) (cfv G R) c_or) c_an)) $;

--| Part of proof of Lemma G of [Crawley] p. 116, fourth line of third paragraph on p. 117: "so fg(p) = gf(p)." (Contributed by NM, 3-Jun-2013.)
theorem cdlemg44a (A2 P R T F G H K c_le W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (w3a (wcel F T) (wcel G T) (wa (wcel P A2) (wn (wbr P W c_le)))) (w3a (wne (cfv P F) P) (wne (cfv P G) P) (wne (cfv F R) (cfv G R)))) (wceq (cfv (cfv P G) F) (cfv (cfv P F) G)) $;

--| Eliminate ` ( F `` P ) =/= P ` , ` ( G `` P ) =/= P ` from ~ cdlemg44a . (Contributed by NM, 3-Jun-2013.)
theorem cdlemg44b (A2 P R T F G H K c_le W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (w3a (wcel F T) (wcel G T) (wa (wcel P A2) (wn (wbr P W c_le)))) (wne (cfv F R) (cfv G R))) (wceq (cfv (cfv P G) F) (cfv (cfv P F) G)) $;

--| Part of proof of Lemma G of [Crawley] p. 116, fifth line of third paragraph on p. 117: "and hence fg = gf." (Contributed by NM, 3-Jun-2013.)
theorem cdlemg44 (R T F G H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel F T) (wcel G T)) (wne (cfv F R) (cfv G R))) (wceq (ccom F G) (ccom G F)) $;

--| TODO: fix comment. TODO: Use this above in place of ` ( F `` P ) = P ` antecedents? (Contributed by NM, 5-Jun-2013.)
theorem cdlemg47a (B2 T F G H K W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel F T) (wcel G T)) (wceq F (cres cid B2))) (wceq (ccom F G) (ccom G F)) $;

--| Part of proof of Lemma G of [Crawley] p. 116, seventh line of third paragraph on p. 117: "hf and f have different traces." (Contributed by NM, 5-Jun-2013.)
theorem cdlemg46 (B2 R T: class) (h: setvar) (F H K W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel F T) (wcel (cv h) T)) (w3a (wne F (cres cid B2)) (wne (cv h) (cres cid B2)) (wne (cfv (cv h) R) (cfv F R)))) (wne (cfv (ccom (cv h) F) R) (cfv F R)) $;

--| Part of proof of Lemma G of [Crawley] p. 116, ninth line of third paragraph on p. 117: "we conclude that gf = fg." (Contributed by NM, 5-Jun-2013.)
theorem cdlemg47 (B2 R T: class) (h: setvar) (F G H K W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wcel G T)) (wa (wcel (cv h) T) (wceq (cfv F R) (cfv G R))) (w3a (wne F (cres cid B2)) (wne (cv h) (cres cid B2)) (wne (cfv (cv h) R) (cfv F R)))) (wceq (ccom F G) (ccom G F)) $;

--| Eliminate ` h ` from ~ cdlemg47 . (Contributed by NM, 5-Jun-2013.)
theorem cdlemg48 (B2 R T F G H K W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel F T) (wcel G T)) (wa (wne F (cres cid B2)) (wceq (cfv F R) (cfv G R)))) (wceq (ccom F G) (ccom G F)) $;

--| Composition is commutative for translations. Part of proof of Lemma G of [Crawley] p. 116. (Contributed by NM, 5-Jun-2013.)
theorem ltrncom (T F G H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wcel G T)) (wceq (ccom F G) (ccom G F)) $;

--| Rearrange a composition of 4 translations, analogous to ~ an4 . (Contributed by NM, 10-Jun-2013.)
theorem ltrnco4 (D T E F G H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel E T) (wcel F T)) (wceq (ccom (ccom D E) (ccom F G)) (ccom (ccom D F) (ccom E G))) $;

--| Trace joined with trace of composition. (Contributed by NM, 15-Jun-2013.)
theorem trljco (R T F G H c_or K W: class):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wcel G T)) (wceq (co (cfv F R) (cfv (ccom F G) R) c_or) (co (cfv F R) (cfv G R) c_or)) $;

--| Trace joined with trace of composition. (Contributed by NM, 16-Jun-2013.)
theorem trljco2 (R T F G H c_or K W: class):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wcel G T)) (wceq (co (cfv F R) (cfv (ccom F G) R) c_or) (co (cfv G R) (cfv (ccom F G) R) c_or)) $;

--| Extend class notation with translation group.
term ctgrp: class;

--| Define the class of all translation groups. ` k ` is normally a member of ` HL ` . Each base set is the set of all lattice translations with respect to a hyperplane ` w ` , and the operation is function composition. Similar to definition of G in [Crawley] p. 116, third paragraph (which defines this for geomodular lattices). (Contributed by NM, 5-Jun-2013.)
axiom df_tgrp {w f2 g2 k: setvar}:
  $ wceq ctgrp (cmpt k cvv (cmpt w (cfv (cv k) clh) (cpr (cop (cfv cnx cbs) (cfv (cv w) (cfv (cv k) cltrn))) (cop (cfv cnx cplusg) (cmpo f2 g2 (cfv (cv w) (cfv (cv k) cltrn)) (cfv (cv w) (cfv (cv k) cltrn)) (ccom (cv f2) (cv g2))))))) $;

--| The translation group maps for a lattice ` K ` . (Contributed by NM, 5-Jun-2013.)
theorem tgrpfset {w f2 g2: setvar} (H: class f2 g2) (K: class) (V: class w f2 g2):
  $ wceq H (cfv K clh) $ >
  $ wi (wcel K V) (wceq (cfv K ctgrp) (cmpt w H (cpr (cop (cfv cnx cbs) (cfv (cv w) (cfv K cltrn))) (cop (cfv cnx cplusg) (cmpo f2 g2 (cfv (cv w) (cfv K cltrn)) (cfv (cv w) (cfv K cltrn)) (ccom (cv f2) (cv g2))))))) $;

--| The translation group for a fiducial co-atom ` W ` . (Contributed by NM, 5-Jun-2013.)
theorem tgrpset {f2 g2: setvar} (T: class) (G H: class f2 g2) (K: class) (V: class f2 g2) (W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq G (cfv W (cfv K ctgrp)) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wceq G (cpr (cop (cfv cnx cbs) T) (cop (cfv cnx cplusg) (cmpo f2 g2 T T (ccom (cv f2) (cv g2)))))) $;

--| The base set of the translation group is the set of all translations (for a fiducial co-atom ` W ` ). (Contributed by NM, 5-Jun-2013.)
theorem tgrpbase (C T G H K V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq G (cfv W (cfv K ctgrp)) $ >
  $ wceq C (cfv G cbs) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wceq C T) $;

--| The group operation of the translation group is function composition. (Contributed by NM, 5-Jun-2013.)
theorem tgrpopr {f2 g2: setvar} (c_pl: class f2 g2) (T: class) (G H: class f2 g2) (K: class) (V: class f2 g2) (W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq G (cfv W (cfv K ctgrp)) $ >
  $ wceq c_pl (cfv G cplusg) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wceq c_pl (cmpo f2 g2 T T (ccom (cv f2) (cv g2)))) $;

--| The group operation value of the translation group is the composition of translations. (Contributed by NM, 5-Jun-2013.)
theorem tgrpov (c_pl T G H K V W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq G (cfv W (cfv K ctgrp)) $ >
  $ wceq c_pl (cfv G cplusg) $ >
  $ wi (w3a (wcel K V) (wcel W H) (wa (wcel X T) (wcel Y T))) (wceq (co X Y c_pl) (ccom X Y)) $;

--| Lemma for ~ tgrpgrp . (Contributed by NM, 6-Jun-2013.)
theorem tgrpgrplem (B2 c_pl T G H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq G (cfv W (cfv K ctgrp)) $ >
  $ wceq c_pl (cfv G cplusg) $ >
  $ wceq B2 (cfv K cbs) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wcel G cgrp) $;

--| The translation group is a group. (Contributed by NM, 6-Jun-2013.)
theorem tgrpgrp (G H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq G (cfv W (cfv K ctgrp)) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wcel G cgrp) $;

--| The translation group is an Abelian group. Lemma G of [Crawley] p. 116. (Contributed by NM, 6-Jun-2013.)
theorem tgrpabl (G H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq G (cfv W (cfv K ctgrp)) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wcel G cabl) $;

--| Extend class notation with translation group endomorphisms.
term ctendo: class;

--| Extend class notation with division ring on trace-preserving endomorphisms.
term cedring: class;

--| Extend class notation with division ring on trace-preserving endomorphisms, with multiplication reversed. TODO: remove ` EDRingR ` theorems if not used.
term cedring_rN: class;

--| Define trace-preserving endomorphisms on the set of translations. (Contributed by NM, 8-Jun-2013.)
axiom df_tendo {x3 y1 w f2 k: setvar}:
  $ wceq ctendo (cmpt k cvv (cmpt w (cfv (cv k) clh) (cab f2 (w3a (wf (cfv (cv w) (cfv (cv k) cltrn)) (cfv (cv w) (cfv (cv k) cltrn)) (cv f2)) (wral x3 (wral y1 (wceq (cfv (ccom (cv x3) (cv y1)) (cv f2)) (ccom (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)))) (cfv (cv w) (cfv (cv k) cltrn))) (cfv (cv w) (cfv (cv k) cltrn))) (wral x3 (wbr (cfv (cfv (cv x3) (cv f2)) (cfv (cv w) (cfv (cv k) ctrl))) (cfv (cv x3) (cfv (cv w) (cfv (cv k) ctrl))) (cfv (cv k) cple)) (cfv (cv w) (cfv (cv k) cltrn))))))) $;

--| Define division ring on trace-preserving endomorphisms. Definition of E of [Crawley] p. 117, 4th line from bottom. (Contributed by NM, 8-Jun-2013.)
axiom df_edring_rN {w t f2 k s1: setvar}:
  $ wceq cedring_rN (cmpt k cvv (cmpt w (cfv (cv k) clh) (ctp (cop (cfv cnx cbs) (cfv (cv w) (cfv (cv k) ctendo))) (cop (cfv cnx cplusg) (cmpo s1 t (cfv (cv w) (cfv (cv k) ctendo)) (cfv (cv w) (cfv (cv k) ctendo)) (cmpt f2 (cfv (cv w) (cfv (cv k) cltrn)) (ccom (cfv (cv f2) (cv s1)) (cfv (cv f2) (cv t)))))) (cop (cfv cnx cmulr) (cmpo s1 t (cfv (cv w) (cfv (cv k) ctendo)) (cfv (cv w) (cfv (cv k) ctendo)) (ccom (cv t) (cv s1))))))) $;

--| Define division ring on trace-preserving endomorphisms. The multiplication operation is reversed composition, per the definition of E of [Crawley] p. 117, 4th line from bottom. (Contributed by NM, 8-Jun-2013.)
axiom df_edring {w t f2 k s1: setvar}:
  $ wceq cedring (cmpt k cvv (cmpt w (cfv (cv k) clh) (ctp (cop (cfv cnx cbs) (cfv (cv w) (cfv (cv k) ctendo))) (cop (cfv cnx cplusg) (cmpo s1 t (cfv (cv w) (cfv (cv k) ctendo)) (cfv (cv w) (cfv (cv k) ctendo)) (cmpt f2 (cfv (cv w) (cfv (cv k) cltrn)) (ccom (cfv (cv f2) (cv s1)) (cfv (cv f2) (cv t)))))) (cop (cfv cnx cmulr) (cmpo s1 t (cfv (cv w) (cfv (cv k) ctendo)) (cfv (cv w) (cfv (cv k) ctendo)) (ccom (cv s1) (cv t))))))) $;

--| The set of all trace-preserving endomorphisms on the set of translations for a lattice ` K ` . (Contributed by NM, 8-Jun-2013.)
theorem tendofset {w f2 g2 s1: setvar} (H: class f2 g2 s1) (K: class) (c_le V: class w f2 g2 s1):
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wcel K V) (wceq (cfv K ctendo) (cmpt w H (cab s1 (w3a (wf (cfv (cv w) (cfv K cltrn)) (cfv (cv w) (cfv K cltrn)) (cv s1)) (wral f2 (wral g2 (wceq (cfv (ccom (cv f2) (cv g2)) (cv s1)) (ccom (cfv (cv f2) (cv s1)) (cfv (cv g2) (cv s1)))) (cfv (cv w) (cfv K cltrn))) (cfv (cv w) (cfv K cltrn))) (wral f2 (wbr (cfv (cfv (cv f2) (cv s1)) (cfv (cv w) (cfv K ctrl))) (cfv (cv f2) (cfv (cv w) (cfv K ctrl))) c_le) (cfv (cv w) (cfv K cltrn))))))) $;

--| The set of trace-preserving endomorphisms on the set of translations for a fiducial co-atom ` W ` . (Contributed by NM, 8-Jun-2013.)
theorem tendoset {f2 g2 s1: setvar} (R: class f2 g2 s1) (T: class) (E H: class f2 g2 s1) (K: class) (c_le V: class f2 g2 s1) (W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wceq E (cab s1 (w3a (wf T T (cv s1)) (wral f2 (wral g2 (wceq (cfv (ccom (cv f2) (cv g2)) (cv s1)) (ccom (cfv (cv f2) (cv s1)) (cfv (cv g2) (cv s1)))) T) T) (wral f2 (wbr (cfv (cfv (cv f2) (cv s1)) R) (cfv (cv f2) R) c_le) T)))) $;

--| The predicate "is a trace-preserving endomorphism". Similar to definition of trace-preserving endomorphism in [Crawley] p. 117, penultimate line. (Contributed by NM, 8-Jun-2013.)
theorem istendo {f2 g2: setvar} (R: class f2 g2) (S T: class) (E H: class f2 g2) (K: class) (c_le V: class f2 g2) (W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wb (wcel S E) (w3a (wf T T S) (wral f2 (wral g2 (wceq (cfv (ccom (cv f2) (cv g2)) S) (ccom (cfv (cv f2) S) (cfv (cv g2) S))) T) T) (wral f2 (wbr (cfv (cfv (cv f2) S) R) (cfv (cv f2) R) c_le) T))) $;

--| Trace-preserving property of a trace-preserving endomorphism. (Contributed by NM, 9-Jun-2013.)
theorem tendotp (R S T E F H K c_le V W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wi (w3a (wa (wcel K V) (wcel W H)) (wcel S E) (wcel F T)) (wbr (cfv (cfv F S) R) (cfv F R) c_le) $;

--| Deduce the predicate "is a trace-preserving endomorphism". (Contributed by NM, 9-Jun-2013.)
theorem istendod {f2 g2: setvar} (ph: wff) (R: class g2) (S T: class) (E H: class f2 g2) (K: class) (c_le: class g2) (V: class f2 g2) (W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wi ph (wa (wcel K V) (wcel W H)) $ >
  $ wi ph (wf T T S) $ >
  $ wi (w3a ph (wcel (cv f2) T) (wcel (cv g2) T)) (wceq (cfv (ccom (cv f2) (cv g2)) S) (ccom (cfv (cv f2) S) (cfv (cv g2) S))) $ >
  $ wi (wa ph (wcel (cv f2) T)) (wbr (cfv (cfv (cv f2) S) R) (cfv (cv f2) R) c_le) $ >
  $ wi ph (wcel S E) $;

--| Functionality of a trace-preserving endomorphism. (Contributed by NM, 9-Jun-2013.)
theorem tendof (S T E H K V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wcel S E)) (wf T T S) $;

--| Condition determining equality of two trace-preserving endomorphisms. (Contributed by NM, 11-Jun-2013.)
theorem tendoeq1 {f2: setvar} (T U: class) (E H: class f2) (K V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel U E) (wcel V E)) (wral f2 (wceq (cfv (cv f2) U) (cfv (cv f2) V)) T)) (wceq U V) $;

--| Value of composition of translations in a trace-preserving endomorphism. (Contributed by NM, 9-Jun-2013.)
theorem tendovalco (S T E F G H K V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wi (wa (w3a (wcel K V) (wcel W H) (wcel S E)) (wa (wcel F T) (wcel G T))) (wceq (cfv (ccom F G) S) (ccom (cfv F S) (cfv G S))) $;

--| Value of composition of endomorphisms in a trace-preserving endomorphism. (Contributed by NM, 9-Jun-2013.)
theorem tendocoval (T U E F H K V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wi (w3a (wa (wcel K X) (wcel W H)) (wa (wcel U E) (wcel V E)) (wcel F T)) (wceq (cfv F (ccom U V)) (cfv (cfv F V) U)) $;

--| Closure of a trace-preserving endomorphism. (Contributed by NM, 9-Jun-2013.)
theorem tendocl (S T E F H K V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wi (w3a (wa (wcel K V) (wcel W H)) (wcel S E) (wcel F T)) (wcel (cfv F S) T) $;

--| Distribution of compositions in preparation for endomorphism sum definition. (Contributed by NM, 10-Jun-2013.)
theorem tendoco2 (T U E F G H K V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel U E) (wcel V E)) (wa (wcel F T) (wcel G T))) (wceq (ccom (cfv (ccom F G) U) (cfv (ccom F G) V)) (ccom (ccom (cfv F U) (cfv F V)) (ccom (cfv G U) (cfv G V)))) $;

--| The identity is a trace-preserving endomorphism. (Contributed by NM, 30-Jul-2013.)
theorem tendoidcl (T E H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wcel (cres cid T) E) $;

--| Multiplicative identity multiplied by a trace-preserving endomorphism. (Contributed by NM, 20-Nov-2013.)
theorem tendo1mul (T U E H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel U E)) (wceq (ccom (cres cid T) U) U) $;

--| Multiplicative identity multiplied by a trace-preserving endomorphism. (Contributed by NM, 20-Nov-2013.)
theorem tendo1mulr (T U E H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel U E)) (wceq (ccom U (cres cid T)) U) $;

--| The composition of two trace-preserving endomorphisms (multiplication in the endormorphism ring) is a trace-preserving endomorphism. (Contributed by NM, 9-Jun-2013.)
theorem tendococl (S T E H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel S E) (wcel T E)) (wcel (ccom S T) E) $;

--| The identity value of a trace-preserving endomorphism. (Contributed by NM, 21-Jun-2013.)
theorem tendoid (B2 S E H K W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel S E)) (wceq (cfv (cres cid B2) S) (cres cid B2)) $;

--| Condition determining equality of two trace-preserving endomorphisms, showing it is unnecessary to consider the identity translation. In ~ tendocan , we show that we only need to consider a single non-identity translation. (Contributed by NM, 21-Jun-2013.)
theorem tendoeq2 {f2: setvar} (B2: class f2) (T U E H K V W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel U E) (wcel V E)) (wral f2 (wi (wne (cv f2) (cres cid B2)) (wceq (cfv (cv f2) U) (cfv (cv f2) V))) T)) (wceq U V) $;

--| Define sum operation for trace-preserving endomorphisms. Change bound variables to isolate them later. (Contributed by NM, 11-Jun-2013.)
theorem tendoplcbv {v u t f2 g2 s1: setvar} (P: class v u t f2 g2 s1) (T: class) (E: class f2 g2):
  $ wceq P (cmpo s1 t E E (cmpt f2 T (ccom (cfv (cv f2) (cv s1)) (cfv (cv f2) (cv t))))) $ >
  $ wceq P (cmpo u v E E (cmpt g2 T (ccom (cfv (cv g2) (cv u)) (cfv (cv g2) (cv v))))) $;

--| Value of endomorphism sum operation. (Contributed by NM, 10-Jun-2013.)
theorem tendopl {t f2 g2 s1: setvar} (P: class t f2 g2 s1) (T: class) (U: class t f2 s1) (E: class f2 g2) (K: class t f2 g2 s1) (V: class t f2 s1) (W: class):
  $ wceq P (cmpo s1 t E E (cmpt f2 T (ccom (cfv (cv f2) (cv s1)) (cfv (cv f2) (cv t))))) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (wa (wcel U E) (wcel V E)) (wceq (co U V P) (cmpt g2 T (ccom (cfv (cv g2) U) (cfv (cv g2) V)))) $;

--| Value of result of endomorphism sum operation. (Contributed by NM, 10-Jun-2013.)
theorem tendopl2 {t f2 s1: setvar} (P: class t f2 s1) (T: class) (U: class t f2 s1) (E: class f2) (F K V: class t f2 s1) (W: class):
  $ wceq P (cmpo s1 t E E (cmpt f2 T (ccom (cfv (cv f2) (cv s1)) (cfv (cv f2) (cv t))))) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (w3a (wcel U E) (wcel V E) (wcel F T)) (wceq (cfv F (co U V P)) (ccom (cfv F U) (cfv F V))) $;

--| Value of result of endomorphism sum operation. (Contributed by NM, 10-Jun-2013.)
theorem tendoplcl2 {t f2 s1: setvar} (P: class t f2 s1) (T: class) (U: class t f2 s1) (E: class f2) (F H K V: class t f2 s1) (W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq P (cmpo s1 t E E (cmpt f2 T (ccom (cfv (cv f2) (cv s1)) (cfv (cv f2) (cv t))))) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel U E) (wcel V E)) (wcel F T)) (wcel (cfv F (co U V P)) T) $;

--| Value of result of endomorphism sum operation on a translation composition. (Contributed by NM, 10-Jun-2013.)
theorem tendoplco2 {t f2 s1: setvar} (P: class t f2 s1) (T: class) (U: class t f2 s1) (E: class f2) (F: class t f2 s1) (G: class t s1) (H K V: class t f2 s1) (W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq P (cmpo s1 t E E (cmpt f2 T (ccom (cfv (cv f2) (cv s1)) (cfv (cv f2) (cv t))))) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel U E) (wcel V E)) (wa (wcel F T) (wcel G T))) (wceq (cfv (ccom F G) (co U V P)) (ccom (cfv F (co U V P)) (cfv G (co U V P)))) $;

--| Trace-preserving property of endomorphism sum operation ` P ` , based on Theorems ~ trlco . Part of remark in [Crawley] p. 118, 2nd line, "it is clear from the second part of G (our ~ trlco ) that Delta is a subring of E." (In our development, we will bypass their E and go directly to their Delta, whose base set is our ` ( TEndo `` K ) `` W ` .) (Contributed by NM, 9-Jun-2013.)
theorem tendopltp {t f2 s1: setvar} (P R: class t f2 s1) (T: class) (U: class t f2 s1) (E: class f2) (F H K c_le V: class t f2 s1) (W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq P (cmpo s1 t E E (cmpt f2 T (ccom (cfv (cv f2) (cv s1)) (cfv (cv f2) (cv t))))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel U E) (wcel V E)) (wcel F T)) (wbr (cfv (cfv F (co U V P)) R) (cfv F R) c_le) $;

--| Endomorphism sum is a trace-preserving endomorphism. (Contributed by NM, 10-Jun-2013.)
theorem tendoplcl {t f2 s1: setvar} (P: class t f2 s1) (T: class) (U: class t f2 s1) (E: class f2) (H K V: class t f2 s1) (W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq P (cmpo s1 t E E (cmpt f2 T (ccom (cfv (cv f2) (cv s1)) (cfv (cv f2) (cv t))))) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel U E) (wcel V E)) (wcel (co U V P) E) $;

--| The endomorphism sum operation is commutative. (Contributed by NM, 11-Jun-2013.)
theorem tendoplcom {t f2 s1: setvar} (P: class t f2 s1) (T: class) (U: class t f2 s1) (E: class f2) (H K V: class t f2 s1) (W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq P (cmpo s1 t E E (cmpt f2 T (ccom (cfv (cv f2) (cv s1)) (cfv (cv f2) (cv t))))) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel U E) (wcel V E)) (wceq (co U V P) (co V U P)) $;

--| The endomorphism sum operation is associative. (Contributed by NM, 11-Jun-2013.)
theorem tendoplass {t f2 s1: setvar} (P S: class t f2 s1) (T: class) (U: class t f2 s1) (E: class f2) (H K V: class t f2 s1) (W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq P (cmpo s1 t E E (cmpt f2 T (ccom (cfv (cv f2) (cv s1)) (cfv (cv f2) (cv t))))) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (w3a (wcel S E) (wcel U E) (wcel V E))) (wceq (co (co S U P) V P) (co S (co U V P) P)) $;

--| Endomorphism composition distributes over sum. (Contributed by NM, 13-Jun-2013.)
theorem tendodi1 {t f2 s1: setvar} (P S: class t f2 s1) (T: class) (U: class t f2 s1) (E: class f2) (H K V: class t f2 s1) (W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq P (cmpo s1 t E E (cmpt f2 T (ccom (cfv (cv f2) (cv s1)) (cfv (cv f2) (cv t))))) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (w3a (wcel S E) (wcel U E) (wcel V E))) (wceq (ccom S (co U V P)) (co (ccom S U) (ccom S V) P)) $;

--| Endomorphism composition distributes over sum. (Contributed by NM, 13-Jun-2013.)
theorem tendodi2 {t f2 s1: setvar} (P S: class t f2 s1) (T: class) (U: class t f2 s1) (E: class f2) (H K V: class t f2 s1) (W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq P (cmpo s1 t E E (cmpt f2 T (ccom (cfv (cv f2) (cv s1)) (cfv (cv f2) (cv t))))) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (w3a (wcel S E) (wcel U E) (wcel V E))) (wceq (ccom (co S U P) V) (co (ccom S V) (ccom U V) P)) $;

--| Define additive identity for trace-preserving endomorphisms. Change bound variable to isolate it later. (Contributed by NM, 11-Jun-2013.)
theorem tendo0cbv {f2 g2: setvar} (B2 T: class) (O: class f2 g2):
  $ wceq O (cmpt f2 T (cres cid B2)) $ >
  $ wceq O (cmpt g2 T (cres cid B2)) $;

--| Value of additive identity endomorphism. (Contributed by NM, 11-Jun-2013.)
theorem tendo02 {f2: setvar} (B2 T: class) (F K O: class f2):
  $ wceq O (cmpt f2 T (cres cid B2)) $ >
  $ wceq B2 (cfv K cbs) $ >
  $ wi (wcel F T) (wceq (cfv F O) (cres cid B2)) $;

--| The additive identity trace-preserving endormorphism preserves composition of translations. TODO: why isn't this a special case of ~ tendospdi1 ? (Contributed by NM, 11-Jun-2013.)
theorem tendo0co2 {f2: setvar} (B2 T: class) (E F G H K O W: class f2):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq O (cmpt f2 T (cres cid B2)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wcel G T)) (wceq (cfv (ccom F G) O) (ccom (cfv F O) (cfv G O))) $;

--| Trace-preserving property of endomorphism additive identity. (Contributed by NM, 11-Jun-2013.)
theorem tendo0tp {f2: setvar} (B2: class) (R: class f2) (T: class) (E F H K c_le O W: class f2):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq O (cmpt f2 T (cres cid B2)) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel F T)) (wbr (cfv (cfv F O) R) (cfv F R) c_le) $;

--| The additive identity is a trace-preserving endormorphism. (Contributed by NM, 12-Jun-2013.)
theorem tendo0cl {f2: setvar} (B2 T: class) (E H K O W: class f2):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq O (cmpt f2 T (cres cid B2)) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wcel O E) $;

--| Property of the additive identity endormorphism. (Contributed by NM, 12-Jun-2013.)
theorem tendo0pl {t f2 s1: setvar} (B2: class t s1) (P S: class t f2 s1) (T: class) (E: class f2) (H K O: class t f2 s1) (W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq O (cmpt f2 T (cres cid B2)) $ >
  $ wceq P (cmpo s1 t E E (cmpt f2 T (ccom (cfv (cv f2) (cv s1)) (cfv (cv f2) (cv t))))) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel S E)) (wceq (co O S P) S) $;

--| Property of the additive identity endormorphism. (Contributed by NM, 21-Feb-2014.)
theorem tendo0plr {t f2 s1: setvar} (B2: class t s1) (P S: class t f2 s1) (T: class) (E: class f2) (H K O: class t f2 s1) (W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq O (cmpt f2 T (cres cid B2)) $ >
  $ wceq P (cmpo s1 t E E (cmpt f2 T (ccom (cfv (cv f2) (cv s1)) (cfv (cv f2) (cv t))))) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel S E)) (wceq (co S O P) S) $;

--| Define inverse function for trace-preserving endomorphisms. Change bound variable to isolate it later. (Contributed by NM, 12-Jun-2013.)
theorem tendoicbv {u f2 g2 s1: setvar} (T: class) (E: class f2 g2) (I: class u f2 g2 s1):
  $ wceq I (cmpt s1 E (cmpt f2 T (ccnv (cfv (cv f2) (cv s1))))) $ >
  $ wceq I (cmpt u E (cmpt g2 T (ccnv (cfv (cv g2) (cv u))))) $;

--| Value of inverse endomorphism. (Contributed by NM, 12-Jun-2013.)
theorem tendoi {f2 g2 s1: setvar} (S: class f2 s1) (T: class) (E: class f2 g2) (I K: class f2 g2 s1) (W: class):
  $ wceq I (cmpt s1 E (cmpt f2 T (ccnv (cfv (cv f2) (cv s1))))) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (wcel S E) (wceq (cfv S I) (cmpt g2 T (ccnv (cfv (cv g2) S)))) $;

--| Value of additive inverse endomorphism. (Contributed by NM, 12-Jun-2013.)
theorem tendoi2 {f2 s1: setvar} (S: class f2 s1) (T: class) (E: class f2) (F I K: class f2 s1) (W: class):
  $ wceq I (cmpt s1 E (cmpt f2 T (ccnv (cfv (cv f2) (cv s1))))) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wi (wa (wcel S E) (wcel F T)) (wceq (cfv F (cfv S I)) (ccnv (cfv F S))) $;

--| Closure of the additive inverse endomorphism. (Contributed by NM, 12-Jun-2013.)
theorem tendoicl {f2 s1: setvar} (S: class f2 s1) (T: class) (E: class f2) (H I K: class f2 s1) (W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq I (cmpt s1 E (cmpt f2 T (ccnv (cfv (cv f2) (cv s1))))) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel S E)) (wcel (cfv S I) E) $;

--| Property of the additive inverse endomorphism. (Contributed by NM, 12-Jun-2013.)
theorem tendoipl {t f2 s1: setvar} (B2: class t s1) (P S: class t f2 s1) (T: class) (E: class f2) (H: class t s1) (I: class t f2 s1) (K: class t s1) (O: class t f2 s1) (W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq I (cmpt s1 E (cmpt f2 T (ccnv (cfv (cv f2) (cv s1))))) $ >
  $ wceq B2 (cfv K cbs) $ >
  $ wceq P (cmpo s1 t E E (cmpt f2 T (ccom (cfv (cv f2) (cv s1)) (cfv (cv f2) (cv t))))) $ >
  $ wceq O (cmpt f2 T (cres cid B2)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel S E)) (wceq (co (cfv S I) S P) O) $;

--| Property of the additive inverse endomorphism. (Contributed by NM, 29-Sep-2014.)
theorem tendoipl2 {t f2 s1: setvar} (B2: class t s1) (P S: class t f2 s1) (T: class) (E: class f2) (H: class t s1) (I: class t f2 s1) (K: class t s1) (O: class t f2 s1) (W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq I (cmpt s1 E (cmpt f2 T (ccnv (cfv (cv f2) (cv s1))))) $ >
  $ wceq B2 (cfv K cbs) $ >
  $ wceq P (cmpo s1 t E E (cmpt f2 T (ccom (cfv (cv f2) (cv s1)) (cfv (cv f2) (cv t))))) $ >
  $ wceq O (cmpt f2 T (cres cid B2)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel S E)) (wceq (co S (cfv S I) P) O) $;

--| The division rings on trace-preserving endomorphisms for a lattice ` K ` . (Contributed by NM, 8-Jun-2013.)
theorem erngfset {w t f2 s1: setvar} (H: class t f2 s1) (K: class) (V: class w t f2 s1):
  $ wceq H (cfv K clh) $ >
  $ wi (wcel K V) (wceq (cfv K cedring) (cmpt w H (ctp (cop (cfv cnx cbs) (cfv (cv w) (cfv K ctendo))) (cop (cfv cnx cplusg) (cmpo s1 t (cfv (cv w) (cfv K ctendo)) (cfv (cv w) (cfv K ctendo)) (cmpt f2 (cfv (cv w) (cfv K cltrn)) (ccom (cfv (cv f2) (cv s1)) (cfv (cv f2) (cv t)))))) (cop (cfv cnx cmulr) (cmpo s1 t (cfv (cv w) (cfv K ctendo)) (cfv (cv w) (cfv K ctendo)) (ccom (cv s1) (cv t))))))) $;

--| The division ring on trace-preserving endomorphisms for a fiducial co-atom ` W ` . (Contributed by NM, 5-Jun-2013.)
theorem erngset {t f2 s1: setvar} (D T E H: class t f2 s1) (K: class) (V: class t f2 s1) (W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq D (cfv W (cfv K cedring)) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wceq D (ctp (cop (cfv cnx cbs) E) (cop (cfv cnx cplusg) (cmpo s1 t E E (cmpt f2 T (ccom (cfv (cv f2) (cv s1)) (cfv (cv f2) (cv t)))))) (cop (cfv cnx cmulr) (cmpo s1 t E E (ccom (cv s1) (cv t)))))) $;

--| The base set of the division ring on trace-preserving endomorphisms is the set of all trace-preserving endomorphisms (for a fiducial co-atom ` W ` ). TODO: the .t hypothesis isn't used. (Also look at others.) (Contributed by NM, 9-Jun-2013.)
theorem erngbase (C D T E H K V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq D (cfv W (cfv K cedring)) $ >
  $ wceq C (cfv D cbs) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wceq C E) $;

--| Ring addition operation. (Contributed by NM, 9-Jun-2013.)
theorem erngfplus {t f2 s1: setvar} (D c_pl T: class t f2 s1) (E: class f2) (H: class t f2 s1) (K: class) (V: class t f2 s1) (W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq D (cfv W (cfv K cedring)) $ >
  $ wceq c_pl (cfv D cplusg) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wceq c_pl (cmpo s1 t E E (cmpt f2 T (ccom (cfv (cv f2) (cv s1)) (cfv (cv f2) (cv t)))))) $;

--| Ring addition operation. (Contributed by NM, 10-Jun-2013.)
theorem erngplus {f2: setvar} (D c_pl: class f2) (T U: class) (E H: class f2) (K V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq D (cfv W (cfv K cedring)) $ >
  $ wceq c_pl (cfv D cplusg) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel U E) (wcel V E))) (wceq (co U V c_pl) (cmpt f2 T (ccom (cfv (cv f2) U) (cfv (cv f2) V)))) $;

--| Ring addition operation. (Contributed by NM, 10-Jun-2013.)
theorem erngplus2 (D c_pl T U E F H K V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq D (cfv W (cfv K cedring)) $ >
  $ wceq c_pl (cfv D cplusg) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (w3a (wcel U E) (wcel V E) (wcel F T))) (wceq (cfv F (co U V c_pl)) (ccom (cfv F U) (cfv F V))) $;

--| Ring multiplication operation. (Contributed by NM, 9-Jun-2013.)
theorem erngfmul {t s1: setvar} (D T c_x: class t s1) (E: class) (H: class t s1) (K: class) (V: class t s1) (W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq D (cfv W (cfv K cedring)) $ >
  $ wceq c_x (cfv D cmulr) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wceq c_x (cmpo s1 t E E (ccom (cv s1) (cv t)))) $;

--| Ring addition operation. (Contributed by NM, 10-Jun-2013.)
theorem erngmul (D T c_x U E H K V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq D (cfv W (cfv K cedring)) $ >
  $ wceq c_x (cfv D cmulr) $ >
  $ wi (wa (wa (wcel K X) (wcel W H)) (wa (wcel U E) (wcel V E))) (wceq (co U V c_x) (ccom U V)) $;

--| The division rings on trace-preserving endomorphisms for a lattice ` K ` . (Contributed by NM, 8-Jun-2013.) (New usage is discouraged.)
theorem erngfset_rN {w t f2 s1: setvar} (H: class t f2 s1) (K: class) (V: class w t f2 s1):
  $ wceq H (cfv K clh) $ >
  $ wi (wcel K V) (wceq (cfv K cedring_rN) (cmpt w H (ctp (cop (cfv cnx cbs) (cfv (cv w) (cfv K ctendo))) (cop (cfv cnx cplusg) (cmpo s1 t (cfv (cv w) (cfv K ctendo)) (cfv (cv w) (cfv K ctendo)) (cmpt f2 (cfv (cv w) (cfv K cltrn)) (ccom (cfv (cv f2) (cv s1)) (cfv (cv f2) (cv t)))))) (cop (cfv cnx cmulr) (cmpo s1 t (cfv (cv w) (cfv K ctendo)) (cfv (cv w) (cfv K ctendo)) (ccom (cv t) (cv s1))))))) $;

--| The division ring on trace-preserving endomorphisms for a fiducial co-atom ` W ` . (Contributed by NM, 5-Jun-2013.) (New usage is discouraged.)
theorem erngset_rN {t f2 s1: setvar} (D T E H: class t f2 s1) (K: class) (V: class t f2 s1) (W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq D (cfv W (cfv K cedring_rN)) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wceq D (ctp (cop (cfv cnx cbs) E) (cop (cfv cnx cplusg) (cmpo s1 t E E (cmpt f2 T (ccom (cfv (cv f2) (cv s1)) (cfv (cv f2) (cv t)))))) (cop (cfv cnx cmulr) (cmpo s1 t E E (ccom (cv t) (cv s1)))))) $;

--| The base set of the division ring on trace-preserving endomorphisms is the set of all trace-preserving endomorphisms (for a fiducial co-atom ` W ` ). (Contributed by NM, 9-Jun-2013.) (New usage is discouraged.)
theorem erngbase_rN (C D T E H K V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq D (cfv W (cfv K cedring_rN)) $ >
  $ wceq C (cfv D cbs) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wceq C E) $;

--| Ring addition operation. (Contributed by NM, 9-Jun-2013.) (New usage is discouraged.)
theorem erngfplus_rN {t f2 s1: setvar} (D c_pl T: class t f2 s1) (E: class f2) (H: class t f2 s1) (K: class) (V: class t f2 s1) (W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq D (cfv W (cfv K cedring_rN)) $ >
  $ wceq c_pl (cfv D cplusg) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wceq c_pl (cmpo s1 t E E (cmpt f2 T (ccom (cfv (cv f2) (cv s1)) (cfv (cv f2) (cv t)))))) $;

--| Ring addition operation. (Contributed by NM, 10-Jun-2013.) (New usage is discouraged.)
theorem erngplus_rN {f2: setvar} (D c_pl: class f2) (T U: class) (E H: class f2) (K V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq D (cfv W (cfv K cedring_rN)) $ >
  $ wceq c_pl (cfv D cplusg) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel U E) (wcel V E))) (wceq (co U V c_pl) (cmpt f2 T (ccom (cfv (cv f2) U) (cfv (cv f2) V)))) $;

--| Ring addition operation. (Contributed by NM, 10-Jun-2013.) (New usage is discouraged.)
theorem erngplus2_rN (D c_pl T U E F H K V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq D (cfv W (cfv K cedring_rN)) $ >
  $ wceq c_pl (cfv D cplusg) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (w3a (wcel U E) (wcel V E) (wcel F T))) (wceq (cfv F (co U V c_pl)) (ccom (cfv F U) (cfv F V))) $;

--| Ring multiplication operation. (Contributed by NM, 9-Jun-2013.) (New usage is discouraged.)
theorem erngfmul_rN {t s1: setvar} (D T c_x: class t s1) (E: class) (H: class t s1) (K: class) (V: class t s1) (W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq D (cfv W (cfv K cedring_rN)) $ >
  $ wceq c_x (cfv D cmulr) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wceq c_x (cmpo s1 t E E (ccom (cv t) (cv s1)))) $;

--| Ring addition operation. (Contributed by NM, 10-Jun-2013.) (New usage is discouraged.)
theorem erngmul_rN (D T c_x U E H K V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq D (cfv W (cfv K cedring_rN)) $ >
  $ wceq c_x (cfv D cmulr) $ >
  $ wi (wa (wa (wcel K X) (wcel W H)) (wa (wcel U E) (wcel V E))) (wceq (co U V c_x) (ccom V U)) $;

--| Part of proof of Lemma H of [Crawley] p. 118. (Contributed by NM, 17-Jun-2013.)
theorem cdlemh1 (A2 B2 P Q R S T F G H c_or K c_le c_an W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq S (co (co P (cfv G R) c_or) (co Q (cfv (ccom G (ccnv F)) R) c_or) c_an) $ >
  $ wi (w3a (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wcel G T)) (wa (wcel P A2) (wcel Q A2)) (wa (wbr Q (co P (cfv F R) c_or) c_le) (wne (cfv F R) (cfv G R)))) (wceq (co S (cfv (ccom G (ccnv F)) R) c_or) (co Q (cfv (ccom G (ccnv F)) R) c_or)) $;

--| Part of proof of Lemma H of [Crawley] p. 118. (Contributed by NM, 16-Jun-2013.)
theorem cdlemh2 (A2 B2 P Q R S T F G H c_or K c_le c_an W c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq S (co (co P (cfv G R) c_or) (co Q (cfv (ccom G (ccnv F)) R) c_or) c_an) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wi (w3a (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wcel G T)) (wa (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (w3a (wne F (cres cid B2)) (wne G (cres cid B2)) (wne (cfv F R) (cfv G R)))) (wceq (co S W c_an) c_0) $;

--| Lemma H of [Crawley] p. 118. (Contributed by NM, 17-Jun-2013.)
theorem cdlemh (A2 B2 P Q R S T F G H c_or K c_le c_an W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq S (co (co P (cfv G R) c_or) (co Q (cfv (ccom G (ccnv F)) R) c_or) c_an) $ >
  $ wi (w3a (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wcel G T)) (w3a (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le))) (wbr Q (co P (cfv F R) c_or) c_le)) (w3a (wne F (cres cid B2)) (wne G (cres cid B2)) (wne (cfv F R) (cfv G R)))) (wa (wcel S A2) (wn (wbr S W c_le))) $;

--| Part of proof of Lemma I of [Crawley] p. 118. (Contributed by NM, 18-Jun-2013.)
theorem cdlemi1 (A2 B2 P R T U E G H c_or K c_le c_an W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel U E) (wcel G T)) (wa (wcel P A2) (wn (wbr P W c_le)))) (wbr (cfv P (cfv G U)) (co P (cfv G R) c_or) c_le) $;

--| Part of proof of Lemma I of [Crawley] p. 118. (Contributed by NM, 18-Jun-2013.)
theorem cdlemi2 (A2 B2 P R T U E F G H c_or K c_le c_an W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (w3a (wcel U E) (wcel F T) (wcel G T)) (wa (wcel P A2) (wn (wbr P W c_le)))) (wbr (cfv P (cfv G U)) (co (cfv P (cfv F U)) (cfv (ccom G (ccnv F)) R) c_or) c_le) $;

--| Lemma I of [Crawley] p. 118. (Contributed by NM, 19-Jun-2013.)
theorem cdlemi (A2 B2 P R S T U E F G H c_or K c_le c_an W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq S (co (co P (cfv G R) c_or) (co (cfv P (cfv F U)) (cfv (ccom G (ccnv F)) R) c_or) c_an) $ >
  $ wi (w3a (w3a (wa (wcel K chlt) (wcel W H)) (wcel F T) (wcel G T)) (wa (wcel U E) (wa (wcel P A2) (wn (wbr P W c_le)))) (w3a (wne F (cres cid B2)) (wne G (cres cid B2)) (wne (cfv F R) (cfv G R)))) (wceq (cfv P (cfv G U)) S) $;

--| Part of proof of Lemma J of [Crawley] p. 118. (Contributed by NM, 19-Jun-2013.)
theorem cdlemj1 (A2 B2 R T U: class) (g2 h: setvar) (E F H K c_le V W: class) (p: setvar):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (w3a (wa (wcel K chlt) (wcel W H)) (w3a (wcel U E) (wcel V E) (wceq (cfv F U) (cfv F V))) (w3a (wcel F T) (wne F (cres cid B2)) (wcel (cv h) T))) (w3a (wne (cv h) (cres cid B2)) (wcel (cv g2) T) (wne (cv g2) (cres cid B2))) (w3a (wne (cfv F R) (cfv (cv g2) R)) (wne (cfv (cv g2) R) (cfv (cv h) R)) (wa (wcel (cv p) A2) (wn (wbr (cv p) W c_le))))) (wceq (cfv (cv p) (cfv (cv h) U)) (cfv (cv p) (cfv (cv h) V))) $;

--| Part of proof of Lemma J of [Crawley] p. 118. Eliminate ` p ` . (Contributed by NM, 20-Jun-2013.)
theorem cdlemj2 (B2 R T U: class) (g2 h: setvar) (E F H K V W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wi (w3a (w3a (wa (wcel K chlt) (wcel W H)) (w3a (wcel U E) (wcel V E) (wceq (cfv F U) (cfv F V))) (w3a (wcel F T) (wne F (cres cid B2)) (wcel (cv h) T))) (w3a (wne (cv h) (cres cid B2)) (wcel (cv g2) T) (wne (cv g2) (cres cid B2))) (wa (wne (cfv F R) (cfv (cv g2) R)) (wne (cfv (cv g2) R) (cfv (cv h) R)))) (wceq (cfv (cv h) U) (cfv (cv h) V)) $;

--| Part of proof of Lemma J of [Crawley] p. 118. Eliminate ` g ` . (Contributed by NM, 20-Jun-2013.)
theorem cdlemj3 (B2 R T U: class) (h: setvar) (E F H K V W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wi (wa (w3a (wa (wcel K chlt) (wcel W H)) (w3a (wcel U E) (wcel V E) (wceq (cfv F U) (cfv F V))) (w3a (wcel F T) (wne F (cres cid B2)) (wcel (cv h) T))) (wne (cv h) (cres cid B2))) (wceq (cfv (cv h) U) (cfv (cv h) V)) $;

--| Cancellation law: if the values of two trace-preserving endormorphisms are equal, so are the endormorphisms. Lemma J of [Crawley] p. 118. (Contributed by NM, 21-Jun-2013.)
theorem tendocan (B2 T U E F H K V W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (w3a (wcel U E) (wcel V E) (wceq (cfv F U) (cfv F V))) (wa (wcel F T) (wne F (cres cid B2)))) (wceq U V) $;

--| A trace-preserving endomorphism is the additive identity iff at least one of its values (at a non-identity translation) is the identity translation. (Contributed by NM, 1-Aug-2013.)
theorem tendoid0 {f2: setvar} (B2 T: class) (U E F H K O W: class f2):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq O (cmpt f2 T (cres cid B2)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel U E) (wa (wcel F T) (wne F (cres cid B2)))) (wb (wceq (cfv F U) (cres cid B2)) (wceq U O)) $;

--| Additive identity multiplied by a trace-preserving endomorphism. (Contributed by NM, 1-Aug-2013.)
theorem tendo0mul {f2: setvar} (B2 T: class) (U E H K O W: class f2):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq O (cmpt f2 T (cres cid B2)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel U E)) (wceq (ccom O U) O) $;

--| Additive identity multiplied by a trace-preserving endomorphism. (Contributed by NM, 13-Feb-2014.)
theorem tendo0mulr {f2: setvar} (B2 T: class) (U E H K O W: class f2):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq O (cmpt f2 T (cres cid B2)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel U E)) (wceq (ccom U O) O) $;

--| The identity (unity) is not equal to the zero trace-preserving endomorphism. (Contributed by NM, 8-Aug-2013.)
theorem tendo1ne0 {f2: setvar} (B2 T: class) (E H K O W: class f2):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq O (cmpt f2 T (cres cid B2)) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wne (cres cid T) O) $;

--| The composition (product) of trace-preserving endormorphisms is nonzero when each argument is nonzero. (Contributed by NM, 8-Aug-2013.)
theorem tendoconid {f2: setvar} (B2 T: class) (U E H K O V W: class f2):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq O (cmpt f2 T (cres cid B2)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel U E) (wne U O)) (wa (wcel V E) (wne V O))) (wne (ccom U V) O) $;

--| The trace of the value of a nonzero trace-preserving endomorphism equals the trace of the argument. (Contributed by NM, 11-Aug-2013.)
theorem tendotr {f2: setvar} (B2: class) (R: class f2) (T: class) (U E F H K O W: class f2):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq O (cmpt f2 T (cres cid B2)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel U E) (wne U O)) (wcel F T)) (wceq (cfv (cfv F U) R) (cfv F R)) $;

--| Part of proof of Lemma K of [Crawley] p. 118. (Contributed by NM, 22-Jun-2013.)
theorem cdlemk1 (A2 B2 P R T F H c_or K c_le N W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel F T) (wcel N T)) (wa (wceq (cfv F R) (cfv N R)) (wa (wcel P A2) (wn (wbr P W c_le))))) (wceq (co P (cfv P N) c_or) (co (cfv P F) (cfv F R) c_or)) $;

--| Part of proof of Lemma K of [Crawley] p. 118. (Contributed by NM, 22-Jun-2013.)
theorem cdlemk2 (A2 B2 P R T F G H c_or K c_le W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel F T) (wcel G T)) (wa (wcel P A2) (wn (wbr P W c_le)))) (wceq (co (cfv P G) (cfv (ccom G (ccnv F)) R) c_or) (co (cfv P F) (cfv (ccom G (ccnv F)) R) c_or)) $;

--| Part of proof of Lemma K of [Crawley] p. 118. (Contributed by NM, 3-Jul-2013.)
theorem cdlemk3 (A2 B2 P R T F G H c_or K c_le c_an W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel F T) (wcel G T)) (w3a (wne (cfv G R) (cfv F R)) (wa (wne F (cres cid B2)) (wne G (cres cid B2))) (wa (wcel P A2) (wn (wbr P W c_le))))) (wceq (co (co (cfv P F) (cfv F R) c_or) (co (cfv P F) (cfv (ccom G (ccnv F)) R) c_or) c_an) (cfv P F)) $;

--| Part of proof of Lemma K of [Crawley] p. 118, last line. We use ` X ` for their h, since ` H ` is already used. (Contributed by NM, 24-Jun-2013.)
theorem cdlemk4 (A2 B2 P R T F H c_or K c_le c_an W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq c_an (cfv K cmee) $ >

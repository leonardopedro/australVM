--| Lemma for ~ mdetuni . (Contributed by SO, 15-Jul-2018.)
theorem mdetuni0 {x3 y1 z w: setvar} (ph: wff) (A2 B2 D c_pl R c_x c_1 E F K N c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wf B2 K D) $ >
  $ wi ph (wral x3 (wral y1 (wral z (wi (wa (wne (cv y1) (cv z)) (wral w (wceq (co (cv y1) (cv w) (cv x3)) (co (cv z) (cv w) (cv x3))) N)) (wceq (cfv (cv x3) D) c_0)) N) N) B2) $ >
  $ wi ph (wral x3 (wral y1 (wral z (wral w (wi (w3a (wceq (cres (cv x3) (cxp (csn (cv w)) N)) (co (cres (cv y1) (cxp (csn (cv w)) N)) (cres (cv z) (cxp (csn (cv w)) N)) (cof c_pl))) (wceq (cres (cv x3) (cxp (cdif N (csn (cv w))) N)) (cres (cv y1) (cxp (cdif N (csn (cv w))) N))) (wceq (cres (cv x3) (cxp (cdif N (csn (cv w))) N)) (cres (cv z) (cxp (cdif N (csn (cv w))) N)))) (wceq (cfv (cv x3) D) (co (cfv (cv y1) D) (cfv (cv z) D) c_pl))) N) B2) B2) B2) $ >
  $ wi ph (wral x3 (wral y1 (wral z (wral w (wi (wa (wceq (cres (cv x3) (cxp (csn (cv w)) N)) (co (cxp (cxp (csn (cv w)) N) (csn (cv y1))) (cres (cv z) (cxp (csn (cv w)) N)) (cof c_x))) (wceq (cres (cv x3) (cxp (cdif N (csn (cv w))) N)) (cres (cv z) (cxp (cdif N (csn (cv w))) N)))) (wceq (cfv (cv x3) D) (co (cv y1) (cfv (cv z) D) c_x))) N) B2) K) B2) $ >
  $ wceq E (co N R cmdat) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wceq (cfv F D) (co (cfv (cfv A2 cur) D) (cfv F E) c_x)) $;

--| According to the definition in [Weierstrass] p. 272, the determinant function is the unique multilinear, alternating and normalized function from the algebra of square matrices of the same dimension over a commutative ring to this ring. So for any multilinear (mdetuni.li and mdetuni.sc), alternating (mdetuni.al) and normalized (mdetuni.no) function D (mdetuni.ff) from the algebra of square matrices (mdetuni.a) to their underlying commutative ring (mdetuni.cr), the function value of this function D for a matrix F (mdetuni.f) is the determinant of this matrix. (Contributed by Stefan O'Rear, 15-Jul-2018.) (Revised by Alexander van der Vekens, 8-Feb-2019.)
theorem mdetuni {x3 y1 z w: setvar} (ph: wff) (A2 B2 D c_pl R c_x c_1 E F K N c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wf B2 K D) $ >
  $ wi ph (wral x3 (wral y1 (wral z (wi (wa (wne (cv y1) (cv z)) (wral w (wceq (co (cv y1) (cv w) (cv x3)) (co (cv z) (cv w) (cv x3))) N)) (wceq (cfv (cv x3) D) c_0)) N) N) B2) $ >
  $ wi ph (wral x3 (wral y1 (wral z (wral w (wi (w3a (wceq (cres (cv x3) (cxp (csn (cv w)) N)) (co (cres (cv y1) (cxp (csn (cv w)) N)) (cres (cv z) (cxp (csn (cv w)) N)) (cof c_pl))) (wceq (cres (cv x3) (cxp (cdif N (csn (cv w))) N)) (cres (cv y1) (cxp (cdif N (csn (cv w))) N))) (wceq (cres (cv x3) (cxp (cdif N (csn (cv w))) N)) (cres (cv z) (cxp (cdif N (csn (cv w))) N)))) (wceq (cfv (cv x3) D) (co (cfv (cv y1) D) (cfv (cv z) D) c_pl))) N) B2) B2) B2) $ >
  $ wi ph (wral x3 (wral y1 (wral z (wral w (wi (wa (wceq (cres (cv x3) (cxp (csn (cv w)) N)) (co (cxp (cxp (csn (cv w)) N) (csn (cv y1))) (cres (cv z) (cxp (csn (cv w)) N)) (cof c_x))) (wceq (cres (cv x3) (cxp (cdif N (csn (cv w))) N)) (cres (cv z) (cxp (cdif N (csn (cv w))) N)))) (wceq (cfv (cv x3) D) (co (cv y1) (cfv (cv z) D) c_x))) N) B2) K) B2) $ >
  $ wceq E (co N R cmdat) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wceq (cfv (cfv A2 cur) D) c_1) $ >
  $ wi ph (wceq (cfv F D) (cfv F E)) $;

--| Multiplicativity of the determinant function: the determinant of a matrix product of square matrices equals the product of their determinants. Proposition 4.15 in [Lang] p. 517. (Contributed by Stefan O'Rear, 16-Jul-2018.)
theorem mdetmul (A2 B2 D R c_xb c_x F G N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq D (co N R cmdat) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_xb (cfv A2 cmulr) $ >
  $ wi (w3a (wcel R ccrg) (wcel F B2) (wcel G B2)) (wceq (cfv (co F G c_xb) D) (co (cfv F D) (cfv G D) c_x)) $;

--| Lemma 1 for ~ m2detleib . (Contributed by AV, 12-Dec-2018.)
theorem m2detleiblem1 (P Q R S c_1 N Y: class):
  $ wceq N (cpr c1 c2) $ >
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq Y (cfv R czrh) $ >
  $ wceq S (cfv N cpsgn) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wa (wcel R crg) (wcel Q P)) (wceq (cfv (cfv Q S) Y) (co (cfv Q (cfv N cpsgn)) c_1 (cfv R cmg))) $;

--| Lemma 5 for ~ m2detleib . (Contributed by AV, 20-Dec-2018.)
theorem m2detleiblem5 (P Q R S c_1 N Y: class):
  $ wceq N (cpr c1 c2) $ >
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq Y (cfv R czrh) $ >
  $ wceq S (cfv N cpsgn) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wa (wcel R crg) (wceq Q (cpr (cop c1 c1) (cop c2 c2)))) (wceq (cfv (cfv Q S) Y) c_1) $;

--| Lemma 6 for ~ m2detleib . (Contributed by AV, 20-Dec-2018.)
theorem m2detleiblem6 (P Q R S c_1 I N Y: class):
  $ wceq N (cpr c1 c2) $ >
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq Y (cfv R czrh) $ >
  $ wceq S (cfv N cpsgn) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq I (cfv R cminusg) $ >
  $ wi (wa (wcel R crg) (wceq Q (cpr (cop c1 c2) (cop c2 c1)))) (wceq (cfv (cfv Q S) Y) (cfv c_1 I)) $;

--| Lemma 7 for ~ m2detleib . (Contributed by AV, 20-Dec-2018.)
theorem m2detleiblem7 (P R S c_x c_1 I c_mi N X Y Z: class):
  $ wceq N (cpr c1 c2) $ >
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq Y (cfv R czrh) $ >
  $ wceq S (cfv N cpsgn) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq I (cfv R cminusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_mi (cfv R csg) $ >
  $ wi (w3a (wcel R crg) (wcel X (cfv R cbs)) (wcel Z (cfv R cbs))) (wceq (co X (co (cfv c_1 I) Z c_x) (cfv R cplusg)) (co X Z c_mi)) $;

--| Lemma 2 for ~ m2detleib . (Contributed by AV, 16-Dec-2018.) (Proof shortened by AV, 1-Jan-2019.)
theorem m2detleiblem2 {n: setvar} (A2: class n) (B2 P Q R: class) (G: class n) (M N: class):
  $ wceq N (cpr c1 c2) $ >
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wi (w3a (wcel R crg) (wcel Q P) (wcel M B2)) (wcel (co G (cmpt n N (co (cfv (cv n) Q) (cv n) M)) cgsu) (cfv R cbs)) $;

--| Lemma 3 for ~ m2detleib . (Contributed by AV, 16-Dec-2018.) (Proof shortened by AV, 2-Jan-2019.)
theorem m2detleiblem3 {n: setvar} (A2: class n) (B2 P Q R: class) (c_x G: class n) (M N: class):
  $ wceq N (cpr c1 c2) $ >
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_x (cfv G cplusg) $ >
  $ wi (w3a (wcel R crg) (wceq Q (cpr (cop c1 c1) (cop c2 c2))) (wcel M B2)) (wceq (co G (cmpt n N (co (cfv (cv n) Q) (cv n) M)) cgsu) (co (co c1 c1 M) (co c2 c2 M) c_x)) $;

--| Lemma 4 for ~ m2detleib . (Contributed by AV, 20-Dec-2018.) (Proof shortened by AV, 2-Jan-2019.)
theorem m2detleiblem4 {n: setvar} (A2: class n) (B2 P Q R: class) (c_x G: class n) (M N: class):
  $ wceq N (cpr c1 c2) $ >
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_x (cfv G cplusg) $ >
  $ wi (w3a (wcel R crg) (wceq Q (cpr (cop c1 c2) (cop c2 c1))) (wcel M B2)) (wceq (co G (cmpt n N (co (cfv (cv n) Q) (cv n) M)) cgsu) (co (co c2 c1 M) (co c1 c2 M) c_x)) $;

--| Leibniz' Formula for 2x2-matrices. (Contributed by AV, 21-Dec-2018.) (Revised by AV, 26-Dec-2018.) (Proof shortened by AV, 23-Jul-2019.)
theorem m2detleib (A2 B2 D R c_x M c_mi N: class):
  $ wceq N (cpr c1 c2) $ >
  $ wceq D (co N R cmdat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_mi (cfv R csg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wcel R crg) (wcel M B2)) (wceq (cfv M D) (co (co (co c1 c1 M) (co c2 c2 M) c_x) (co (co c2 c1 M) (co c1 c2 M) c_x) c_mi)) $;

--| Syntax for the matrix adjugate/adjunct function.
term cmadu: class;

--| Syntax for the minor matrices of a square matrix.
term cminmar1: class;

--| Define the adjugate or adjunct (matrix of cofactors) of a square matrix. This definition gives the standard cofactors, however the internal minors are not the standard minors, see definition in [Lang] p. 518. (Contributed by Stefan O'Rear, 7-Sep-2015.) (Revised by SO, 10-Jul-2018.)
axiom df_madu {i j k m n r l: setvar}:
  $ wceq cmadu (cmpo n r cvv cvv (cmpt m (cfv (co (cv n) (cv r) cmat) cbs) (cmpo i j (cv n) (cv n) (cfv (cmpo k l (cv n) (cv n) (cif (wceq (cv k) (cv j)) (cif (wceq (cv l) (cv i)) (cfv (cv r) cur) (cfv (cv r) c0g)) (co (cv k) (cv l) (cv m)))) (co (cv n) (cv r) cmdat))))) $;

--| Define the matrices whose determinants are the minors of a square matrix. In contrast to the standard definition of minors, a row is replaced by 0's and one 1 instead of deleting the column and row (e.g., definition in [Lang] p. 515). By this, the determinant of such a matrix is equal to the minor determined in the standard way (as determinant of a submatrix, see ~ df-subma - note that the matrix is transposed compared with the submatrix defined in ~ df-subma , but this does not matter because the determinants are the same, see ~ mdettpos ). Such matrices are used in the definition of an adjunct of a square matrix, see ~ df-madu . (Contributed by AV, 27-Dec-2018.)
axiom df_minmar1 {i j k m n r l: setvar}:
  $ wceq cminmar1 (cmpo n r cvv cvv (cmpt m (cfv (co (cv n) (cv r) cmat) cbs) (cmpo k l (cv n) (cv n) (cmpo i j (cv n) (cv n) (cif (wceq (cv i) (cv k)) (cif (wceq (cv j) (cv l)) (cfv (cv r) cur) (cfv (cv r) c0g)) (co (cv i) (cv j) (cv m))))))) $;

--| Lemma for ~ maducoeval2 . (Contributed by SO, 16-Jul-2018.)
theorem mndifsplit (ph ps: wff) (A2 B2 c_pl M c_0: class):
  $ wceq B2 (cfv M cbs) $ >
  $ wceq c_0 (cfv M c0g) $ >
  $ wceq c_pl (cfv M cplusg) $ >
  $ wi (w3a (wcel M cmnd) (wcel A2 B2) (wn (wa ph ps))) (wceq (cif (wo ph ps) A2 c_0) (co (cif ph A2 c_0) (cif ps A2 c_0) c_pl)) $;

--| First substitution for the adjunct (cofactor) matrix. (Contributed by SO, 11-Jul-2018.)
theorem madufval {i j k m l: setvar} (A2: class i j k m l) (B2: class i j k l) (D: class i j k m l) (R: class) (c_1 J: class i j k m l) (N: class) (c_0: class i j k m l):
  $ wceq A2 (co N R cmat) $ >
  $ wceq D (co N R cmdat) $ >
  $ wceq J (co N R cmadu) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq J (cmpt m B2 (cmpo i j N N (cfv (cmpo k l N N (cif (wceq (cv k) (cv j)) (cif (wceq (cv l) (cv i)) c_1 c_0) (co (cv k) (cv l) (cv m)))) D))) $;

--| Second substitution for the adjunct (cofactor) matrix. (Contributed by SO, 11-Jul-2018.)
theorem maduval {i j k l: setvar} (A2 B2 D: class i j k l) (R: class) (c_1 J: class i j k l) (M N: class) (c_0: class i j k l):
  $ wceq A2 (co N R cmat) $ >
  $ wceq D (co N R cmdat) $ >
  $ wceq J (co N R cmadu) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wcel M B2) (wceq (cfv M J) (cmpo i j N N (cfv (cmpo k l N N (cif (wceq (cv k) (cv j)) (cif (wceq (cv l) (cv i)) c_1 c_0) (co (cv k) (cv l) M))) D))) $;

--| An entry of the adjunct (cofactor) matrix. (Contributed by SO, 11-Jul-2018.)
theorem maducoeval {k l: setvar} (A2 B2 D: class k l) (R: class) (c_1: class k l) (H I: class) (J: class k l) (M N: class) (c_0: class k l):
  $ wceq A2 (co N R cmat) $ >
  $ wceq D (co N R cmdat) $ >
  $ wceq J (co N R cmadu) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (w3a (wcel M B2) (wcel I N) (wcel H N)) (wceq (co I H (cfv M J)) (cfv (cmpo k l N N (cif (wceq (cv k) H) (cif (wceq (cv l) I) c_1 c_0) (co (cv k) (cv l) M))) D)) $;

--| An entry of the adjunct (cofactor) matrix. (Contributed by SO, 17-Jul-2018.)
theorem maducoeval2 {k l: setvar} (A2: class k l) (B2: class) (D: class k l) (R: class) (c_1: class l) (H I: class) (J: class k l) (M N: class) (c_0: class l):
  $ wceq A2 (co N R cmat) $ >
  $ wceq D (co N R cmdat) $ >
  $ wceq J (co N R cmadu) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (w3a (wa (wcel R ccrg) (wcel M B2)) (wcel I N) (wcel H N)) (wceq (co I H (cfv M J)) (cfv (cmpo k l N N (cif (wo (wceq (cv k) H) (wceq (cv l) I)) (cif (wa (wceq (cv l) I) (wceq (cv k) H)) c_1 c_0) (co (cv k) (cv l) M))) D)) $;

--| Creating the adjunct of matrices is a function from the set of matrices into the set of matrices. (Contributed by Stefan O'Rear, 11-Jul-2018.)
theorem maduf (A2 B2 R J N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq J (co N R cmadu) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wi (wcel R ccrg) (wf B2 B2 J) $;

--| The adjuct of a transposed matrix is the transposition of the adjunct of the matrix. (Contributed by Stefan O'Rear, 17-Jul-2018.)
theorem madutpos (A2 B2 R J M N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq J (co N R cmadu) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wi (wa (wcel R ccrg) (wcel M B2)) (wceq (cfv (ctpos M) J) (ctpos (cfv M J))) $;

--| The determinant of a matrix with a row ` L ` consisting of the same element ` X ` is the sum of the elements of the ` L ` -th column of the adjunct of the matrix multiplied with ` X ` . (Contributed by Stefan O'Rear, 16-Jul-2018.)
theorem madugsum {i j: setvar} (ph: wff) (A2: class i j) (B2: class) (D: class i j) (R: class) (c_x J: class j) (K L M N: class) (X: class i):
  $ wceq A2 (co N R cmat) $ >
  $ wceq J (co N R cmadu) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq D (co N R cmdat) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq K (cfv R cbs) $ >
  $ wi ph (wcel M B2) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi (wa ph (wcel (cv i) N)) (wcel X K) $ >
  $ wi ph (wcel L N) $ >
  $ wi ph (wceq (co R (cmpt i N (co X (co (cv i) L (cfv M J)) c_x)) cgsu) (cfv (cmpo j i N N (cif (wceq (cv j) L) X (co (cv j) (cv i) M))) D)) $;

--| Multiplying a matrix with its adjunct results in the identity matrix multiplied with the determinant of the matrix. See Proposition 4.16 in [Lang] p. 518. (Contributed by Stefan O'Rear, 16-Jul-2018.)
theorem madurid (A2 B2 D R c_xb c_x c_1 J M N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq J (co N R cmadu) $ >
  $ wceq D (co N R cmdat) $ >
  $ wceq c_1 (cfv A2 cur) $ >
  $ wceq c_x (cfv A2 cmulr) $ >
  $ wceq c_xb (cfv A2 cvsca) $ >
  $ wi (wa (wcel M B2) (wcel R ccrg)) (wceq (co M (cfv M J) c_x) (co (cfv M D) c_1 c_xb)) $;

--| Multiplying the adjunct of a matrix with the matrix results in the identity matrix multiplied with the determinant of the matrix. See Proposition 4.16 in [Lang] p. 518. (Contributed by Stefan O'Rear, 17-Jul-2018.)
theorem madulid (A2 B2 D R c_xb c_x c_1 J M N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq J (co N R cmadu) $ >
  $ wceq D (co N R cmdat) $ >
  $ wceq c_1 (cfv A2 cur) $ >
  $ wceq c_x (cfv A2 cmulr) $ >
  $ wceq c_xb (cfv A2 cvsca) $ >
  $ wi (wa (wcel M B2) (wcel R ccrg)) (wceq (co (cfv M J) M c_x) (co (cfv M D) c_1 c_xb)) $;

--| First substitution for the definition of a matrix for a minor. (Contributed by AV, 31-Dec-2018.)
theorem minmar1fval {i j k m l: setvar} (A2: class i j k m l) (B2: class i j k l) (Q: class i j k m l) (R: class) (c_1: class i j k m l) (N: class) (c_0: class i j k m l):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq Q (co N R cminmar1) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq Q (cmpt m B2 (cmpo k l N N (cmpo i j N N (cif (wceq (cv i) (cv k)) (cif (wceq (cv j) (cv l)) c_1 c_0) (co (cv i) (cv j) (cv m)))))) $;

--| Second substitution for the definition of a matrix for a minor. (Contributed by AV, 31-Dec-2018.)
theorem minmar1val0 {i j k l: setvar} (A2 B2 Q: class i j k l) (R: class) (c_1: class i j k l) (M N: class) (c_0: class i j k l):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq Q (co N R cminmar1) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wcel M B2) (wceq (cfv M Q) (cmpo k l N N (cmpo i j N N (cif (wceq (cv i) (cv k)) (cif (wceq (cv j) (cv l)) c_1 c_0) (co (cv i) (cv j) M))))) $;

--| Third substitution for the definition of a matrix for a minor. (Contributed by AV, 31-Dec-2018.)
theorem minmar1val {i j: setvar} (A2 B2 Q: class i j) (R: class) (c_1: class i j) (K L M N: class) (c_0: class i j):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq Q (co N R cminmar1) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (w3a (wcel M B2) (wcel K N) (wcel L N)) (wceq (co K L (cfv M Q)) (cmpo i j N N (cif (wceq (cv i) K) (cif (wceq (cv j) L) c_1 c_0) (co (cv i) (cv j) M)))) $;

--| An entry of a matrix for a minor. (Contributed by AV, 31-Dec-2018.)
theorem minmar1eval (A2 B2 Q R c_1 I J K L M N c_0: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq Q (co N R cminmar1) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (w3a (wcel M B2) (wa (wcel K N) (wcel L N)) (wa (wcel I N) (wcel J N))) (wceq (co I J (co K L (cfv M Q))) (cif (wceq I K) (cif (wceq J L) c_1 c_0) (co I J M))) $;

--| The minor matrix is a special case of a matrix with a replaced row. (Contributed by AV, 12-Feb-2019.) (Revised by AV, 4-Jul-2022.)
theorem minmar1marrep (A2 B2 R c_1 M N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wa (wcel R crg) (wcel M B2)) (wceq (cfv M (co N R cminmar1)) (co M c_1 (co N R cmarrep))) $;

--| Closure of the row replacement function for square matrices: The matrix for a minor is a matrix. (Contributed by AV, 13-Feb-2019.)
theorem minmar1cl (A2 B2 R K L M N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wi (wa (wa (wcel R crg) (wcel M B2)) (wa (wcel K N) (wcel L N))) (wcel (co K L (cfv M (co N R cminmar1))) B2) $;

--| The coefficients of an adjunct (matrix of cofactors) expressed as determinants of the minor matrices (alternative definition) of the original matrix. (Contributed by AV, 31-Dec-2018.)
theorem maducoevalmin1 (A2 B2 D R H I J M N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq D (co N R cmdat) $ >
  $ wceq J (co N R cmadu) $ >
  $ wi (w3a (wcel M B2) (wcel I N) (wcel H N)) (wceq (co I H (cfv M J)) (cfv (co H I (cfv M (co N R cminmar1))) D)) $;

--| Lemma for ~ symgmatr01 . (Contributed by AV, 3-Jan-2019.)
theorem symgmatr01lem {k q: setvar} (A2 B2: class q) (P Q K L: class) (M N: class q):
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wi (wa (wcel K N) (wcel L N)) (wi (wcel Q (cdif P (crab q (wceq (cfv K (cv q)) L) P))) (wrex k (wceq (cif (wceq (cv k) K) (cif (wceq (cfv (cv k) Q) L) A2 B2) (co (cv k) (cfv (cv k) Q) M)) B2) N)) $;

--| Applying a permutation that does not fix a certain element of a set to a second element to an index of a matrix a row with 0's and a 1. (Contributed by AV, 3-Jan-2019.)
theorem symgmatr01 {i j k q: setvar} (P Q: class) (R: class i j k q) (c_1: class q) (K L: class) (M N c_0: class q):
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wa (wcel K N) (wcel L N)) (wi (wcel Q (cdif P (crab q (wceq (cfv K (cv q)) L) P))) (wrex k (wceq (co (cv k) (cfv (cv k) Q) (cmpo i j N N (cif (wceq (cv i) K) (cif (wceq (cv j) L) c_1 c_0) (co (cv i) (cv j) M)))) c_0) N)) $;

--| Lemma A for ~ gsummatr01 . (Contributed by AV, 8-Jan-2019.)
theorem gsummatr01lem1 {r: setvar} (P Q: class) (R: class r) (K L: class) (N X: class r):
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq R (crab r (wceq (cfv K (cv r)) L) P) $ >
  $ wi (wa (wcel Q R) (wcel X N)) (wcel (cfv X Q) N) $;

--| Lemma B for ~ gsummatr01 . (Contributed by AV, 8-Jan-2019.)
theorem gsummatr01lem2 {i j r: setvar} (A2: class r) (P: class i j) (Q: class) (R G: class r) (K L: class) (N X: class r):
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq R (crab r (wceq (cfv K (cv r)) L) P) $ >
  $ wi (wa (wcel Q R) (wcel X N)) (wi (wral i (wral j (wcel (co (cv i) (cv j) A2) (cfv G cbs)) N) N) (wcel (co X (cfv X Q) A2) (cfv G cbs))) $;

--| Lemma 1 for ~ gsummatr01 . (Contributed by AV, 8-Jan-2019.)
theorem gsummatr01lem3 {i j n r: setvar} (A2 B2: class r) (P: class i j n) (Q: class) (R S G: class r) (K L: class) (N c_0: class r):
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq R (crab r (wceq (cfv K (cv r)) L) P) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wceq S (cfv G cbs) $ >
  $ wi (w3a (wa (wcel G ccmn) (wcel N cfn)) (wa (wral i (wral j (wcel (co (cv i) (cv j) A2) S) N) N) (wcel B2 S)) (w3a (wcel K N) (wcel L N) (wcel Q R))) (wceq (co G (cmpt n (cun (cdif N (csn K)) (csn K)) (co (cv n) (cfv (cv n) Q) (cmpo i j N N (cif (wceq (cv i) K) (cif (wceq (cv j) L) c_0 B2) (co (cv i) (cv j) A2))))) cgsu) (co (co G (cmpt n (cdif N (csn K)) (co (cv n) (cfv (cv n) Q) (cmpo i j N N (cif (wceq (cv i) K) (cif (wceq (cv j) L) c_0 B2) (co (cv i) (cv j) A2))))) cgsu) (co K (cfv K Q) (cmpo i j N N (cif (wceq (cv i) K) (cif (wceq (cv j) L) c_0 B2) (co (cv i) (cv j) A2)))) (cfv G cplusg))) $;

--| Lemma 2 for ~ gsummatr01 . (Contributed by AV, 8-Jan-2019.)
theorem gsummatr01lem4 {i j r: setvar} (A2 B2: class r) (P: class i j) (Q: class) (R S: class r) (n: setvar) (G: class r) (K L: class) (N c_0: class r):
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq R (crab r (wceq (cfv K (cv r)) L) P) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wceq S (cfv G cbs) $ >
  $ wi (wa (w3a (wa (wcel G ccmn) (wcel N cfn)) (wa (wral i (wral j (wcel (co (cv i) (cv j) A2) S) N) N) (wcel B2 S)) (w3a (wcel K N) (wcel L N) (wcel Q R))) (wcel (cv n) (cdif N (csn K)))) (wceq (co (cv n) (cfv (cv n) Q) (cmpo i j N N (cif (wceq (cv i) K) (cif (wceq (cv j) L) c_0 B2) (co (cv i) (cv j) A2)))) (co (cv n) (cfv (cv n) Q) (cmpo i j (cdif N (csn K)) (cdif N (csn L)) (co (cv i) (cv j) A2)))) $;

--| Lemma 1 for ~ smadiadetlem4 . (Contributed by AV, 8-Jan-2019.)
theorem gsummatr01 {i j n r: setvar} (A2 B2: class r) (P: class i j n) (Q: class) (R S G: class r) (K L: class) (N c_0: class r):
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq R (crab r (wceq (cfv K (cv r)) L) P) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wceq S (cfv G cbs) $ >
  $ wi (w3a (wa (wcel G ccmn) (wcel N cfn)) (wa (wral i (wral j (wcel (co (cv i) (cv j) A2) S) N) N) (wcel B2 S)) (w3a (wcel K N) (wcel L N) (wcel Q R))) (wceq (co G (cmpt n N (co (cv n) (cfv (cv n) Q) (cmpo i j N N (cif (wceq (cv i) K) (cif (wceq (cv j) L) c_0 B2) (co (cv i) (cv j) A2))))) cgsu) (co G (cmpt n (cdif N (csn K)) (co (cv n) (cfv (cv n) Q) (cmpo i j (cdif N (csn K)) (cdif N (csn L)) (co (cv i) (cv j) A2)))) cgsu)) $;

--| Replacing a row of a square matrix by a row with 0's and a 1 results in a square matrix of the same dimension. (Contributed by AV, 30-Dec-2018.)
theorem marep01ma {k l: setvar} (A2: class k l) (B2 R: class) (c_1 H I: class k l) (M N: class) (c_0: class k l):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wcel R ccrg $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wcel M B2) (wcel (cmpo k l N N (cif (wceq (cv k) H) (cif (wceq (cv l) I) c_1 c_0) (co (cv k) (cv l) M))) B2) $;

--| Lemma 0 for ~ smadiadet : The products of the Leibniz' formula vanish for all permutations fixing the index of the row containing the 0's and the 1 to the column with the 1. (Contributed by AV, 3-Jan-2019.)
theorem smadiadetlem0 {i j n q: setvar} (A2: class i j n q) (B2: class q) (P Q: class) (R c_1: class q) (G: class i j q) (K L: class) (M N c_0: class q):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wcel R ccrg $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wi (w3a (wcel M B2) (wcel K N) (wcel L N)) (wi (wcel Q (cdif P (crab q (wceq (cfv K (cv q)) L) P))) (wceq (co G (cmpt n N (co (cv n) (cfv (cv n) Q) (cmpo i j N N (cif (wceq (cv i) K) (cif (wceq (cv j) L) c_1 c_0) (co (cv i) (cv j) M))))) cgsu) c_0)) $;

--| Lemma 1 for ~ smadiadet : A summand of the determinant of a matrix belongs to the underlying ring. (Contributed by AV, 1-Jan-2019.)
theorem smadiadetlem1 {i j n: setvar} (A2: class i j n) (B2 P R: class) (S c_x: class i j n) (c_1: class) (G: class i j) (K M N: class) (Y: class i j n) (c_0: class) (p: setvar):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wcel R ccrg $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq Y (cfv R czrh) $ >
  $ wceq S (cfv N cpsgn) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wa (wcel M B2) (wcel K N)) (wcel (cv p) P)) (wcel (co (cfv (cv p) (ccom Y S)) (co G (cmpt n N (co (cv n) (cfv (cv n) (cv p)) (cmpo i j N N (cif (wceq (cv i) K) (cif (wceq (cv j) K) c_1 c_0) (co (cv i) (cv j) M))))) cgsu) (cfv R cmulr)) (cfv R cbs)) $;

--| Lemma 1a for ~ smadiadet : The summands of the Leibniz' formula vanish for all permutations fixing the index of the row containing the 0's and the 1 to the column with the 1. (Contributed by AV, 3-Jan-2019.)
theorem smadiadetlem1a {i j n q p: setvar} (A2: class i j n q p) (B2: class q) (P: class) (R: class q) (S c_x: class i j n q p) (c_1: class q p) (G: class i j q p) (K L: class) (M N: class q) (Y: class i j n q p) (c_0: class q p):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wcel R ccrg $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq Y (cfv R czrh) $ >
  $ wceq S (cfv N cpsgn) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (w3a (wcel M B2) (wcel K N) (wcel L N)) (wceq (co R (cmpt p (cdif P (crab q (wceq (cfv K (cv q)) L) P)) (co (cfv (cv p) (ccom Y S)) (co G (cmpt n N (co (cv n) (cfv (cv n) (cv p)) (cmpo i j N N (cif (wceq (cv i) K) (cif (wceq (cv j) L) c_1 c_0) (co (cv i) (cv j) M))))) cgsu) c_x)) cgsu) c_0) $;

--| Lemma 2 for ~ smadiadet : The summands of the Leibniz' formula vanish for all permutations fixing the index of the row containing the 0's and the 1 to itself. (Contributed by AV, 31-Dec-2018.)
theorem smadiadetlem2 {i j n q p: setvar} (A2: class i j n q p) (B2: class q) (P: class) (R: class q) (S c_x: class i j n q p) (c_1: class q p) (G: class i j q p) (K: class) (M N: class q) (Y: class i j n q p) (c_0: class q p):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wcel R ccrg $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq Y (cfv R czrh) $ >
  $ wceq S (cfv N cpsgn) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wcel M B2) (wcel K N)) (wceq (co R (cmpt p (cdif P (crab q (wceq (cfv K (cv q)) K) P)) (co (cfv (cv p) (ccom Y S)) (co G (cmpt n N (co (cv n) (cfv (cv n) (cv p)) (cmpo i j N N (cif (wceq (cv i) K) (cif (wceq (cv j) K) c_1 c_0) (co (cv i) (cv j) M))))) cgsu) c_x)) cgsu) c_0) $;

--| Lemma 0 for ~ smadiadetlem3 . (Contributed by AV, 12-Jan-2019.)
theorem smadiadetlem3lem0 {i j n: setvar} (A2: class i j n) (B2 P Q R: class) (S c_x: class i j n) (c_1: class) (G: class i j) (K M N: class) (W: class i j) (Y: class i j n) (c_0: class) (Z: class i j n):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wcel R ccrg $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq Y (cfv R czrh) $ >
  $ wceq S (cfv N cpsgn) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq W (cfv (cfv (cdif N (csn K)) csymg) cbs) $ >
  $ wceq Z (cfv (cdif N (csn K)) cpsgn) $ >
  $ wi (wa (wa (wcel M B2) (wcel K N)) (wcel Q W)) (wcel (co (cfv Q (ccom Y Z)) (co G (cmpt n (cdif N (csn K)) (co (cv n) (cfv (cv n) Q) (cmpo i j (cdif N (csn K)) (cdif N (csn K)) (co (cv i) (cv j) M)))) cgsu) (cfv R cmulr)) (cfv R cbs)) $;

--| Lemma 1 for ~ smadiadetlem3 . (Contributed by AV, 12-Jan-2019.)
theorem smadiadetlem3lem1 {i j n p: setvar} (A2: class i j n p) (B2 P R: class) (S c_x: class i j n p) (c_1: class p) (G: class i j p) (K M N: class) (W: class i j) (Y: class i j n p) (c_0: class p) (Z: class i j n p):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wcel R ccrg $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq Y (cfv R czrh) $ >
  $ wceq S (cfv N cpsgn) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq W (cfv (cfv (cdif N (csn K)) csymg) cbs) $ >
  $ wceq Z (cfv (cdif N (csn K)) cpsgn) $ >
  $ wi (wa (wcel M B2) (wcel K N)) (wf W (cfv R cbs) (cmpt p W (co (cfv (cv p) (ccom Y Z)) (co G (cmpt n (cdif N (csn K)) (co (cv n) (cfv (cv n) (cv p)) (cmpo i j (cdif N (csn K)) (cdif N (csn K)) (co (cv i) (cv j) M)))) cgsu) (cfv R cmulr)))) $;

--| Lemma 2 for ~ smadiadetlem3 . (Contributed by AV, 12-Jan-2019.)
theorem smadiadetlem3lem2 {i j n p: setvar} (A2: class i j n p) (B2 P R: class) (S c_x: class i j n p) (c_1: class p) (G: class i j p) (K M N: class) (W: class i j) (Y: class i j n p) (c_0: class p) (Z: class i j n p):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wcel R ccrg $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq Y (cfv R czrh) $ >
  $ wceq S (cfv N cpsgn) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq W (cfv (cfv (cdif N (csn K)) csymg) cbs) $ >
  $ wceq Z (cfv (cdif N (csn K)) cpsgn) $ >
  $ wi (wa (wcel M B2) (wcel K N)) (wss (crn (cmpt p W (co (cfv (cv p) (ccom Y Z)) (co G (cmpt n (cdif N (csn K)) (co (cv n) (cfv (cv n) (cv p)) (cmpo i j (cdif N (csn K)) (cdif N (csn K)) (co (cv i) (cv j) M)))) cgsu) (cfv R cmulr)))) (cfv (crn (cmpt p W (co (cfv (cv p) (ccom Y Z)) (co G (cmpt n (cdif N (csn K)) (co (cv n) (cfv (cv n) (cv p)) (cmpo i j (cdif N (csn K)) (cdif N (csn K)) (co (cv i) (cv j) M)))) cgsu) (cfv R cmulr)))) (cfv R ccntz))) $;

--| Lemma 3 for ~ smadiadet . (Contributed by AV, 31-Jan-2019.)
theorem smadiadetlem3 {i j n q p: setvar} (A2: class i j n q p) (B2: class q) (P: class) (R: class q) (S c_x: class i j n q p) (c_1: class q p) (G: class i j q) (K: class) (M N: class q) (W: class i j q) (Y: class i j n q) (c_0: class q p) (Z: class i j n q):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wcel R ccrg $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq Y (cfv R czrh) $ >
  $ wceq S (cfv N cpsgn) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq W (cfv (cfv (cdif N (csn K)) csymg) cbs) $ >
  $ wceq Z (cfv (cdif N (csn K)) cpsgn) $ >
  $ wi (wa (wcel M B2) (wcel K N)) (wceq (co R (cmpt p (crab q (wceq (cfv K (cv q)) K) P) (co (cfv (cv p) (ccom Y S)) (co G (cmpt n (cdif N (csn K)) (co (cv n) (cfv (cv n) (cv p)) (cmpo i j (cdif N (csn K)) (cdif N (csn K)) (co (cv i) (cv j) M)))) cgsu) (cfv R cmulr))) cgsu) (co R (cmpt p W (co (cfv (cv p) (ccom Y Z)) (co G (cmpt n (cdif N (csn K)) (co (cv n) (cfv (cv n) (cv p)) (cmpo i j (cdif N (csn K)) (cdif N (csn K)) (co (cv i) (cv j) M)))) cgsu) (cfv R cmulr))) cgsu)) $;

--| Lemma 4 for ~ smadiadet . (Contributed by AV, 31-Jan-2019.)
theorem smadiadetlem4 {i j n q p: setvar} (A2: class i j n q p) (B2: class q) (P: class) (R: class q) (S c_x: class i j n q p) (c_1: class q p) (G: class q) (K: class) (M N: class q) (W: class i j q) (Y: class i j n q) (c_0: class q p) (Z: class i j n q):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wcel R ccrg $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq P (cfv (cfv N csymg) cbs) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq Y (cfv R czrh) $ >
  $ wceq S (cfv N cpsgn) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq W (cfv (cfv (cdif N (csn K)) csymg) cbs) $ >
  $ wceq Z (cfv (cdif N (csn K)) cpsgn) $ >
  $ wi (wa (wcel M B2) (wcel K N)) (wceq (co R (cmpt p (crab q (wceq (cfv K (cv q)) K) P) (co (cfv (cv p) (ccom Y S)) (co G (cmpt n N (co (cv n) (cfv (cv n) (cv p)) (cmpo i j N N (cif (wceq (cv i) K) (cif (wceq (cv j) K) c_1 c_0) (co (cv i) (cv j) M))))) cgsu) (cfv R cmulr))) cgsu) (co R (cmpt p W (co (cfv (cv p) (ccom Y Z)) (co G (cmpt n (cdif N (csn K)) (co (cv n) (cfv (cv n) (cv p)) (cmpo i j (cdif N (csn K)) (cdif N (csn K)) (co (cv i) (cv j) M)))) cgsu) (cfv R cmulr))) cgsu)) $;

--| The determinant of a submatrix of a square matrix obtained by removing a row and a column at the same index equals the determinant of the original matrix with the row replaced with 0's and a 1 at the diagonal position. (Contributed by AV, 31-Jan-2019.) (Proof shortened by AV, 24-Jul-2019.)
theorem smadiadet (A2 B2 D R E K M N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wcel R ccrg $ >
  $ wceq D (co N R cmdat) $ >
  $ wceq E (co (cdif N (csn K)) R cmdat) $ >
  $ wi (wa (wcel M B2) (wcel K N)) (wceq (cfv (co K K (cfv M (co N R csubma))) E) (cfv (co K K (cfv M (co N R cminmar1))) D)) $;

--| Lemma 1 for ~ smadiadetg . (Contributed by AV, 13-Feb-2019.)
theorem smadiadetglem1 (A2 B2 D R S E K M N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wcel R ccrg $ >
  $ wceq D (co N R cmdat) $ >
  $ wceq E (co (cdif N (csn K)) R cmdat) $ >
  $ wi (w3a (wcel M B2) (wcel K N) (wcel S (cfv R cbs))) (wceq (cres (co K K (co M S (co N R cmarrep))) (cxp (cdif N (csn K)) N)) (cres (co K K (cfv M (co N R cminmar1))) (cxp (cdif N (csn K)) N))) $;

--| Lemma 2 for ~ smadiadetg . (Contributed by AV, 14-Feb-2019.)
theorem smadiadetglem2 (A2 B2 D R S c_x E K M N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wcel R ccrg $ >
  $ wceq D (co N R cmdat) $ >
  $ wceq E (co (cdif N (csn K)) R cmdat) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (w3a (wcel M B2) (wcel K N) (wcel S (cfv R cbs))) (wceq (cres (co K K (co M S (co N R cmarrep))) (cxp (csn K) N)) (co (cxp (cxp (csn K) N) (csn S)) (cres (co K K (cfv M (co N R cminmar1))) (cxp (csn K) N)) (cof c_x))) $;

--| The determinant of a square matrix with one row replaced with 0's and an arbitrary element of the underlying ring at the diagonal position equals the ring element multiplied with the determinant of a submatrix of the square matrix obtained by removing the row and the column at the same index. (Contributed by AV, 14-Feb-2019.)
theorem smadiadetg (A2 B2 D R S c_x E K M N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wcel R ccrg $ >
  $ wceq D (co N R cmdat) $ >
  $ wceq E (co (cdif N (csn K)) R cmdat) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (w3a (wcel M B2) (wcel K N) (wcel S (cfv R cbs))) (wceq (cfv (co K K (co M S (co N R cmarrep))) D) (co S (cfv (co K K (cfv M (co N R csubma))) E) c_x)) $;

--| Lemma for ~ smadiadetr : version of ~ smadiadetg with all hypotheses defining class variables removed, i.e. all class variables defined in the hypotheses replaced in the theorem by their definition. (Contributed by AV, 15-Feb-2019.)
theorem smadiadetg0 (R S K M N: class):
  $ wcel R ccrg $ >
  $ wi (w3a (wcel M (cfv (co N R cmat) cbs)) (wcel K N) (wcel S (cfv R cbs))) (wceq (cfv (co K K (co M S (co N R cmarrep))) (co N R cmdat)) (co S (cfv (co K K (cfv M (co N R csubma))) (co (cdif N (csn K)) R cmdat)) (cfv R cmulr))) $;

--| The determinant of a square matrix with one row replaced with 0's and an arbitrary element of the underlying ring at the diagonal position equals the ring element multiplied with the determinant of a submatrix of the square matrix obtained by removing the row and the column at the same index. Closed form of ~ smadiadetg . Special case of the "Laplace expansion", see definition in [Lang] p. 515. (Contributed by AV, 15-Feb-2019.)
theorem smadiadetr (R S K M N: class):
  $ wi (wa (wa (wcel R ccrg) (wcel M (cfv (co N R cmat) cbs))) (wa (wcel K N) (wcel S (cfv R cbs)))) (wceq (cfv (co K K (co M S (co N R cmarrep))) (co N R cmdat)) (co S (cfv (co K K (cfv M (co N R csubma))) (co (cdif N (csn K)) R cmdat)) (cfv R cmulr))) $;

--| If a matrix multiplied with a given matrix (from the left as well as from the right) results in the identity matrix, this matrix is the inverse (matrix) of the given matrix. (Contributed by Stefan O'Rear, 17-Jul-2018.)
theorem invrvald (ph: wff) (B2 R c_x U c_1 I X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq I (cfv R cinvr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (co X Y c_x) c_1) $ >
  $ wi ph (wceq (co Y X c_x) c_1) $ >
  $ wi ph (wa (wcel X U) (wceq (cfv X I) Y)) $;

--| The inverse of a matrix is the adjunct of the matrix multiplied with the inverse of the determinant of the matrix if the determinant is a unit in the underlying ring. Proposition 4.16 in [Lang] p. 518. (Contributed by Stefan O'Rear, 17-Jul-2018.)
theorem matinv (A2 B2 D R c_xb U H I J M N V: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq J (co N R cmadu) $ >
  $ wceq D (co N R cmdat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq U (cfv A2 cui) $ >
  $ wceq V (cfv R cui) $ >
  $ wceq H (cfv R cinvr) $ >
  $ wceq I (cfv A2 cinvr) $ >
  $ wceq c_xb (cfv A2 cvsca) $ >
  $ wi (w3a (wcel R ccrg) (wcel M B2) (wcel (cfv M D) V)) (wa (wcel M U) (wceq (cfv M I) (co (cfv (cfv M D) H) (cfv M J) c_xb))) $;

--| A matrix is a unit in the ring of matrices iff its determinant is a unit in the underlying ring. (Contributed by Stefan O'Rear, 17-Jul-2018.)
theorem matunit (A2 B2 D R U M N V: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq D (co N R cmdat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq U (cfv A2 cui) $ >
  $ wceq V (cfv R cui) $ >
  $ wi (wa (wcel R ccrg) (wcel M B2)) (wb (wcel M U) (wcel (cfv M D) V)) $;

--| One direction of ~ matunitlindf . (Contributed by Brendan Leahy, 2-Jun-2021.)
theorem matunitlindflem1 (R I M: class):
  $ wi (wa (wa (wcel R cfield) (wf (cxp I I) (cfv R cbs) M)) (wcel I (cdif cfn (csn c0)))) (wi (wn (wbr (ccur M) (co R I cfrlm) clindf)) (wceq (cfv M (co I R cmdat)) (cfv R c0g))) $;

--| One direction of ~ matunitlindf . (Contributed by Brendan Leahy, 2-Jun-2021.)
theorem matunitlindflem2 (R I M: class):
  $ wi (wa (wa (wa (wcel R cfield) (wcel M (cfv (co I R cmat) cbs))) (wne I c0)) (wbr (ccur M) (co R I cfrlm) clindf)) (wcel (cfv M (co I R cmdat)) (cfv R cui)) $;

--| A matrix over a field is invertible iff the rows are linearly independent. (Contributed by Brendan Leahy, 2-Jun-2021.)
theorem matunitlindf (R I M: class):
  $ wi (wa (wcel R cfield) (wcel M (cfv (co I R cmat) cbs))) (wb (wcel M (cfv (co I R cmat) cui)) (wbr (ccur M) (co R I cfrlm) clindf)) $;

--| Every solution of a system of linear equations represented by a matrix and a vector is a vector. (Contributed by AV, 10-Feb-2019.) (Revised by AV, 27-Feb-2019.)
theorem slesolvec (A2 B2 R c_x N V X Y Z: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq V (co (cfv R cbs) N cmap) $ >
  $ wceq c_x (co R (cop N N) cmvmul) $ >
  $ wi (wa (wa (wne N c0) (wcel R crg)) (wa (wcel X B2) (wcel Y V))) (wi (wceq (co X Z c_x) Y) (wcel Z V)) $;

--| The solution of a system of linear equations represented by a matrix with a unit as determinant is the multiplication of the inverse of the matrix with the right-hand side vector. (Contributed by AV, 10-Feb-2019.) (Revised by AV, 28-Feb-2019.)
theorem slesolinv (A2 B2 D R c_x I N V X Y Z: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq V (co (cfv R cbs) N cmap) $ >
  $ wceq c_x (co R (cop N N) cmvmul) $ >
  $ wceq D (co N R cmdat) $ >
  $ wceq I (cfv A2 cinvr) $ >
  $ wi (w3a (wa (wne N c0) (wcel R ccrg)) (wa (wcel X B2) (wcel Y V)) (wa (wcel (cfv X D) (cfv R cui)) (wceq (co X Z c_x) Y))) (wceq Z (co (cfv X I) Y c_x)) $;

--| The solution of a system of linear equations represented by a matrix with a unit as determinant is the multiplication of the inverse of the matrix with the right-hand side vector. (Contributed by AV, 11-Feb-2019.) (Revised by AV, 28-Feb-2019.)
theorem slesolinvbi (A2 B2 D R c_x I N V X Y Z: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq V (co (cfv R cbs) N cmap) $ >
  $ wceq c_x (co R (cop N N) cmvmul) $ >
  $ wceq D (co N R cmdat) $ >
  $ wceq I (cfv A2 cinvr) $ >
  $ wi (w3a (wa (wne N c0) (wcel R ccrg)) (wa (wcel X B2) (wcel Y V)) (wcel (cfv X D) (cfv R cui))) (wb (wceq (co X Z c_x) Y) (wceq Z (co (cfv X I) Y c_x))) $;

--| Every system of linear equations represented by a matrix with a unit as determinant has a solution. (Contributed by AV, 11-Feb-2019.) (Revised by AV, 28-Feb-2019.)
theorem slesolex {z: setvar} (A2 B2 D R c_x N V X Y: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq V (co (cfv R cbs) N cmap) $ >
  $ wceq c_x (co R (cop N N) cmvmul) $ >
  $ wceq D (co N R cmdat) $ >
  $ wi (w3a (wa (wne N c0) (wcel R ccrg)) (wa (wcel X B2) (wcel Y V)) (wcel (cfv X D) (cfv R cui))) (wrex z (wceq (co X (cv z) c_x) Y) V) $;

--| Lemma 1 for ~ cramerimp : The determinant of the identity matrix with the ith column replaced by a (column) vector equals the ith component of the vector. (Contributed by AV, 15-Feb-2019.) (Revised by AV, 5-Jul-2022.)
theorem cramerimplem1 (A2 D R E I N V Z: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq V (co (cfv R cbs) N cmap) $ >
  $ wceq E (cfv I (co (cfv A2 cur) Z (co N R cmatrepV))) $ >
  $ wceq D (co N R cmdat) $ >
  $ wi (wa (w3a (wcel N cfn) (wcel R ccrg) (wcel I N)) (wcel Z V)) (wceq (cfv E D) (cfv I Z)) $;

--| Lemma 2 for ~ cramerimp : The matrix of a system of linear equations multiplied with the identity matrix with the ith column replaced by the solution vector of the system of linear equations equals the matrix of the system of linear equations with the ith column replaced by the right-hand side vector of the system of linear equations. (Contributed by AV, 19-Feb-2019.) (Revised by AV, 1-Mar-2019.)
theorem cramerimplem2 (A2 B2 R c_x c_xp E H I N V X Y Z: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq V (co (cfv R cbs) N cmap) $ >
  $ wceq E (cfv I (co (cfv A2 cur) Z (co N R cmatrepV))) $ >
  $ wceq H (cfv I (co X Y (co N R cmatrepV))) $ >
  $ wceq c_x (co R (cop N N) cmvmul) $ >
  $ wceq c_xp (co R (cotp N N N) cmmul) $ >
  $ wi (w3a (wa (wcel R ccrg) (wcel I N)) (wa (wcel X B2) (wcel Y V)) (wceq (co X Z c_x) Y)) (wceq (co X E c_xp) H) $;

--| Lemma 3 for ~ cramerimp : The determinant of the matrix of a system of linear equations multiplied with the determinant of the identity matrix with the ith column replaced by the solution vector of the system of linear equations equals the determinant of the matrix of the system of linear equations with the ith column replaced by the right-hand side vector of the system of linear equations. (Contributed by AV, 19-Feb-2019.) (Revised by AV, 1-Mar-2019.)
theorem cramerimplem3 (A2 B2 D R c_x c_xo E H I N V X Y Z: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq V (co (cfv R cbs) N cmap) $ >
  $ wceq E (cfv I (co (cfv A2 cur) Z (co N R cmatrepV))) $ >
  $ wceq H (cfv I (co X Y (co N R cmatrepV))) $ >
  $ wceq c_x (co R (cop N N) cmvmul) $ >
  $ wceq D (co N R cmdat) $ >
  $ wceq c_xo (cfv R cmulr) $ >
  $ wi (w3a (wa (wcel R ccrg) (wcel I N)) (wa (wcel X B2) (wcel Y V)) (wceq (co X Z c_x) Y)) (wceq (co (cfv X D) (cfv E D) c_xo) (cfv H D)) $;

--| One direction of Cramer's rule (according to Wikipedia "Cramer's rule", 21-Feb-2019, ~ https://en.wikipedia.org/wiki/Cramer%27s_rule : "[Cramer's rule] ... expresses the solution [of a system of linear equations] in terms of the determinants of the (square) coefficient matrix and of matrices obtained from it by replacing one column by the column vector of right-hand sides of the equations."): The ith component of the solution vector of a system of linear equations equals the determinant of the matrix of the system of linear equations with the ith column replaced by the righthand side vector of the system of linear equations divided by the determinant of the matrix of the system of linear equations. (Contributed by AV, 19-Feb-2019.) (Revised by AV, 1-Mar-2019.)
theorem cramerimp (A2 B2 D c_dv R c_x E H I N V X Y Z: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq V (co (cfv R cbs) N cmap) $ >
  $ wceq E (cfv I (co (cfv A2 cur) Z (co N R cmatrepV))) $ >
  $ wceq H (cfv I (co X Y (co N R cmatrepV))) $ >
  $ wceq c_x (co R (cop N N) cmvmul) $ >
  $ wceq D (co N R cmdat) $ >
  $ wceq c_dv (cfv R cdvr) $ >
  $ wi (w3a (wa (wcel R ccrg) (wcel I N)) (wa (wcel X B2) (wcel Y V)) (wa (wceq (co X Z c_x) Y) (wcel (cfv X D) (cfv R cui)))) (wceq (cfv I Z) (co (cfv H D) (cfv X D) c_dv)) $;

--| Lemma 1 for ~ cramer . (Contributed by AV, 21-Feb-2019.) (Revised by AV, 1-Mar-2019.)
theorem cramerlem1 {i: setvar} (A2: class i) (B2 D c_dv R c_x N V X Y Z: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq V (co (cfv R cbs) N cmap) $ >
  $ wceq D (co N R cmdat) $ >
  $ wceq c_x (co R (cop N N) cmvmul) $ >
  $ wceq c_dv (cfv R cdvr) $ >
  $ wi (w3a (wcel R ccrg) (wa (wcel X B2) (wcel Y V)) (w3a (wcel (cfv X D) (cfv R cui)) (wcel Z V) (wceq (co X Z c_x) Y))) (wceq Z (cmpt i N (co (cfv (cfv (cv i) (co X Y (co N R cmatrepV))) D) (cfv X D) c_dv))) $;

--| Lemma 2 for ~ cramer . (Contributed by AV, 21-Feb-2019.) (Revised by AV, 1-Mar-2019.)
theorem cramerlem2 {z i: setvar} (A2: class z i) (B2 D: class) (c_dv: class z) (R: class) (c_x: class z) (N V X Y: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq V (co (cfv R cbs) N cmap) $ >
  $ wceq D (co N R cmdat) $ >
  $ wceq c_x (co R (cop N N) cmvmul) $ >
  $ wceq c_dv (cfv R cdvr) $ >
  $ wi (w3a (wcel R ccrg) (wa (wcel X B2) (wcel Y V)) (wcel (cfv X D) (cfv R cui))) (wral z (wi (wceq (co X (cv z) c_x) Y) (wceq (cv z) (cmpt i N (co (cfv (cfv (cv i) (co X Y (co N R cmatrepV))) D) (cfv X D) c_dv)))) V) $;

--| Lemma 3 for ~ cramer . (Contributed by AV, 21-Feb-2019.) (Revised by AV, 1-Mar-2019.)
theorem cramerlem3 {i: setvar} (A2: class i) (B2 D c_dv R c_x N V X Y Z: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq V (co (cfv R cbs) N cmap) $ >
  $ wceq D (co N R cmdat) $ >
  $ wceq c_x (co R (cop N N) cmvmul) $ >
  $ wceq c_dv (cfv R cdvr) $ >
  $ wi (w3a (wa (wne N c0) (wcel R ccrg)) (wa (wcel X B2) (wcel Y V)) (wcel (cfv X D) (cfv R cui))) (wi (wceq Z (cmpt i N (co (cfv (cfv (cv i) (co X Y (co N R cmatrepV))) D) (cfv X D) c_dv))) (wceq (co X Z c_x) Y)) $;

--| Special case of Cramer's rule for 0-dimensional matrices/vectors. (Contributed by AV, 28-Feb-2019.)
theorem cramer0 {i: setvar} (A2: class i) (B2 D c_dv R c_x N V X Y Z: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq V (co (cfv R cbs) N cmap) $ >
  $ wceq D (co N R cmdat) $ >
  $ wceq c_x (co R (cop N N) cmvmul) $ >
  $ wceq c_dv (cfv R cdvr) $ >
  $ wi (w3a (wa (wceq N c0) (wcel R ccrg)) (wa (wcel X B2) (wcel Y V)) (wcel (cfv X D) (cfv R cui))) (wi (wceq Z (cmpt i N (co (cfv (cfv (cv i) (co X Y (co N R cmatrepV))) D) (cfv X D) c_dv))) (wceq (co X Z c_x) Y)) $;

--| Cramer's rule. According to Wikipedia "Cramer's rule", 21-Feb-2019, ~ https://en.wikipedia.org/wiki/Cramer%27s_rule : "[Cramer's rule] ... expresses the [[unique] solution [of a system of linear equations] in terms of the determinants of the (square) coefficient matrix and of matrices obtained from it by replacing one column by the column vector of right-hand sides of the equations." If it is assumed that a (unique) solution exists, it can be obtained by Cramer's rule (see also ~ cramerimp ). On the other hand, if a vector can be constructed by Cramer's rule, it is a solution of the system of linear equations, so at least one solution exists. The uniqueness is ensured by considering only systems of linear equations whose matrix has a unit (of the underlying ring) as determinant, see ~ matunit or ~ slesolinv . For fields as underlying rings, this requirement is equivalent to the determinant not being 0. Theorem 4.4 in [Lang] p. 513. This is Metamath 100 proof #97. (Contributed by Alexander van der Vekens, 21-Feb-2019.) (Revised by Alexander van der Vekens, 1-Mar-2019.)
theorem cramer {i: setvar} (A2: class i) (B2 D c_dv R c_x N V X Y Z: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq V (co (cfv R cbs) N cmap) $ >
  $ wceq D (co N R cmdat) $ >
  $ wceq c_x (co R (cop N N) cmvmul) $ >
  $ wceq c_dv (cfv R cdvr) $ >
  $ wi (w3a (wa (wcel R ccrg) (wne N c0)) (wa (wcel X B2) (wcel Y V)) (wcel (cfv X D) (cfv R cui))) (wb (wceq Z (cmpt i N (co (cfv (cfv (cv i) (co X Y (co N R cmatrepV))) D) (cfv X D) c_dv))) (wceq (co X Z c_x) Y)) $;

--| The set of polynomial matrices over a ring is a ring. (Contributed by AV, 6-Nov-2019.)
theorem pmatring (C P R N: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wcel C crg) $;

--| The set of polynomial matrices over a ring is a left module. (Contributed by AV, 6-Nov-2019.)
theorem pmatlmod (C P R N: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wcel C clmod) $;

--| The set of polynomial matrices over a commutative ring is an associative algebra. (Contributed by AV, 16-Jun-2024.)
theorem pmatassa (C P R N: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wi (wa (wcel N cfn) (wcel R ccrg)) (wcel C casa) $;

--| The zero polynomial matrix over a ring represented as operation. (Contributed by AV, 16-Nov-2019.)
theorem pmat0op {i j: setvar} (C: class i j) (P: class) (R: class i j) (N: class) (c_0: class i j):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq c_0 (cfv P c0g) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wceq (cfv C c0g) (cmpo i j N N c_0)) $;

--| The identity polynomial matrix over a ring represented as operation. (Contributed by AV, 16-Nov-2019.)
theorem pmat1op {i j: setvar} (C P: class) (R: class i j) (c_1 N c_0: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq c_0 (cfv P c0g) $ >
  $ wceq c_1 (cfv P cur) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wceq (cfv C cur) (cmpo i j N N (cif (wceq (cv i) (cv j)) c_1 c_0))) $;

--| Entries of the identity polynomial matrix over a ring, deduction form. (Contributed by AV, 16-Nov-2019.)
theorem pmat1ovd (ph: wff) (C P R U c_1 I J N c_0: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq c_0 (cfv P c0g) $ >
  $ wceq c_1 (cfv P cur) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel I N) $ >
  $ wi ph (wcel J N) $ >
  $ wceq U (cfv C cur) $ >
  $ wi ph (wceq (co I J U) (cif (wceq I J) c_1 c_0)) $;

--| The zero polynomial matrix over a ring represented as operation with "lifted scalars" (i.e. elements of the ring underlying the polynomial ring embedded into the polynomial ring by the scalar injection/algebra scalar lifting function ` algSc ` ). (Contributed by AV, 16-Nov-2019.)
theorem pmat0opsc {i j: setvar} (A2 C: class i j) (P R N: class) (c_0: class i j):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wceq (cfv C c0g) (cmpo i j N N (cfv c_0 A2))) $;

--| The identity polynomial matrix over a ring represented as operation with "lifted scalars". (Contributed by AV, 16-Nov-2019.)
theorem pmat1opsc {i j: setvar} (A2: class i j) (C P R: class) (c_1: class i j) (N: class) (c_0: class i j):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wceq (cfv C cur) (cmpo i j N N (cif (wceq (cv i) (cv j)) (cfv c_1 A2) (cfv c_0 A2)))) $;

--| Entries of the identity polynomial matrix over a ring represented with "lifted scalars", deduction form. (Contributed by AV, 16-Nov-2019.)
theorem pmat1ovscd (ph: wff) (A2 C P R U c_1 I J N c_0: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi ph (wcel N cfn) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel I N) $ >
  $ wi ph (wcel J N) $ >
  $ wceq U (cfv C cur) $ >
  $ wi ph (wceq (co I J U) (cif (wceq I J) (cfv c_1 A2) (cfv c_0 A2))) $;

--| For a polynomial matrix there is an upper bound for the coefficients of all the polynomials being not 0. (Contributed by AV, 3-Oct-2019.) (Proof shortened by AV, 28-Nov-2019.)
theorem pmatcoe1fsupp {x3 i j s1: setvar} (B2: class) (C P: class x3 i j s1) (R M N c_0: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (w3a (wcel N cfn) (wcel R crg) (wcel M B2)) (wrex s1 (wral x3 (wi (wbr (cv s1) (cv x3) clt) (wral i (wral j (wceq (cfv (cv x3) (cfv (co (cv i) (cv j) M) cco1)) c_0) N) N)) cn0) cn0) $;

--| The scalar product of the identity polynomial matrix with a polynomial is a polynomial matrix. (Contributed by AV, 2-Nov-2019.) (Revised by AV, 4-Dec-2019.)
theorem _1pmatscmul (B2 C P Q R c_1 E c_as N: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq E (cfv P cbs) $ >
  $ wceq c_as (cfv C cvsca) $ >
  $ wceq c_1 (cfv C cur) $ >
  $ wi (w3a (wcel N cfn) (wcel R crg) (wcel Q E)) (wcel (co Q c_1 c_as) B2) $;

--| Extend class notation with the set of all constant polynomial matrices.
term ccpmat: class;

--| Extend class notation with the transformation of a matrix into a matrix of polynomials.
term cmat2pmat: class;

--| Extend class notation with the transformation of a constant polynomial matrix into a matrix.
term ccpmat2mat: class;

--| The set of all constant polynomial matrices, which are all matrices whose entries are constant polynomials (or "scalar polynomials", see ~ ply1sclf ). (Contributed by AV, 15-Nov-2019.)
axiom df_cpmat {i j k m n r: setvar}:
  $ wceq ccpmat (cmpo n r cfn cvv (crab m (wral i (wral j (wral k (wceq (cfv (cv k) (cfv (co (cv i) (cv j) (cv m)) cco1)) (cfv (cv r) c0g)) cn) (cv n)) (cv n)) (cfv (co (cv n) (cfv (cv r) cpl1) cmat) cbs))) $;

--| Transformation of a matrix (over a ring) into a matrix over the corresponding polynomial ring. (Contributed by AV, 31-Jul-2019.)
axiom df_mat2pmat {x3 y1 m n r: setvar}:
  $ wceq cmat2pmat (cmpo n r cfn cvv (cmpt m (cfv (co (cv n) (cv r) cmat) cbs) (cmpo x3 y1 (cv n) (cv n) (cfv (co (cv x3) (cv y1) (cv m)) (cfv (cfv (cv r) cpl1) cascl))))) $;

--| Transformation of a constant polynomial matrix (over a ring) into a matrix over the corresponding ring. Since this function is the inverse function of ` matToPolyMat ` , see ~ m2cpminv , it is also called "inverse matrix transformation" in the following. (Contributed by AV, 14-Dec-2019.)
axiom df_cpmat2mat {x3 y1 m n r: setvar}:
  $ wceq ccpmat2mat (cmpo n r cfn cvv (cmpt m (co (cv n) (cv r) ccpmat) (cmpo x3 y1 (cv n) (cv n) (cfv cc0 (cfv (co (cv x3) (cv y1) (cv m)) cco1))))) $;

--| Value of the constructor of the set of all constant polynomial matrices, i.e. the set of all ` N ` x ` N ` matrices of polynomials over a ring ` R ` . (Contributed by AV, 15-Nov-2019.)
theorem cpmat {i j k m: setvar} (B2: class i j k) (C P: class i j k m) (R: class) (S: class i j k m) (N: class) (V: class i j k m):
  $ wceq S (co N R ccpmat) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi (wa (wcel N cfn) (wcel R V)) (wceq S (crab m (wral i (wral j (wral k (wceq (cfv (cv k) (cfv (co (cv i) (cv j) (cv m)) cco1)) (cfv R c0g)) cn) N) N) B2)) $;

--| A constant polynomial matrix is a polynomial matrix. (Contributed by AV, 16-Nov-2019.)
theorem cpmatpmat (B2 C P R S M N V: class):
  $ wceq S (co N R ccpmat) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi (w3a (wcel N cfn) (wcel R V) (wcel M S)) (wcel M B2) $;

--| Property of a constant polynomial matrix. (Contributed by AV, 15-Nov-2019.)
theorem cpmatel {i j k: setvar} (B2 C P: class i j k) (R: class) (S: class i j k) (M N: class) (V: class i j k):
  $ wceq S (co N R ccpmat) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi (w3a (wcel N cfn) (wcel R V) (wcel M B2)) (wb (wcel M S) (wral i (wral j (wral k (wceq (cfv (cv k) (cfv (co (cv i) (cv j) M) cco1)) (cfv R c0g)) cn) N) N)) $;

--| Implication of a set being a constant polynomial matrix. (Contributed by AV, 18-Nov-2019.)
theorem cpmatelimp {i j k: setvar} (B2 C P: class i j k) (R: class) (S: class i j k) (M N: class):
  $ wceq S (co N R ccpmat) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wi (wcel M S) (wa (wcel M B2) (wral i (wral j (wral k (wceq (cfv (cv k) (cfv (co (cv i) (cv j) M) cco1)) (cfv R c0g)) cn) N) N))) $;

--| Another property of a constant polynomial matrix. (Contributed by AV, 16-Nov-2019.) (Proof shortened by AV, 27-Nov-2019.)
theorem cpmatel2 {i j k: setvar} (A2: class i j) (B2: class k) (C: class i j k) (P: class i j) (R: class) (S: class i j k) (K: class i j) (M N: class):
  $ wceq S (co N R ccpmat) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wi (w3a (wcel N cfn) (wcel R crg) (wcel M B2)) (wb (wcel M S) (wral i (wral j (wrex k (wceq (co (cv i) (cv j) M) (cfv (cv k) A2)) K) N) N)) $;

--| Another implication of a set being a constant polynomial matrix. (Contributed by AV, 17-Nov-2019.)
theorem cpmatelimp2 {i j k: setvar} (A2: class i j) (B2: class k) (C: class i j k) (P: class i j) (R: class) (S: class i j k) (K: class i j) (M N: class):
  $ wceq S (co N R ccpmat) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wi (wcel M S) (wa (wcel M B2) (wral i (wral j (wrex k (wceq (co (cv i) (cv j) M) (cfv (cv k) A2)) K) N) N))) $;

--| The identity of the ring of all polynomial matrices over the ring ` R ` is a constant polynomial matrix. (Contributed by AV, 16-Nov-2019.)
theorem _1elcpmat (C P R S N: class):
  $ wceq S (co N R ccpmat) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wcel (cfv C cur) S) $;

--| The set of all constant polynomial matrices over a ring ` R ` is closed under addition. (Contributed by AV, 17-Nov-2019.) (Proof shortened by AV, 28-Nov-2019.)
theorem cpmatacl {x3 y1: setvar} (C P: class x3 y1) (R: class) (S: class x3) (N: class):
  $ wceq S (co N R ccpmat) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wral x3 (wral y1 (wcel (co (cv x3) (cv y1) (cfv C cplusg)) S) S) S) $;

--| The set of all constant polynomial matrices over a ring ` R ` is closed under inversion. (Contributed by AV, 17-Nov-2019.) (Proof shortened by AV, 28-Nov-2019.)
theorem cpmatinvcl {x3: setvar} (C P: class x3) (R: class) (S: class x3) (N: class):
  $ wceq S (co N R ccpmat) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wral x3 (wcel (cfv (cv x3) (cfv C cminusg)) S) S) $;

--| Lemma for ~ cpmatmcl . (Contributed by AV, 18-Nov-2019.)
theorem cpmatmcllem {i j k c: setvar} (x3 y1: setvar) (C: class) (P: class i j) (R: class) (S: class i j k c) (N: class):
  $ wceq S (co N R ccpmat) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wi (wa (wa (wcel N cfn) (wcel R crg)) (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wral i (wral j (wral c (wceq (cfv (cv c) (cfv (co P (cmpt k N (co (co (cv i) (cv k) (cv x3)) (co (cv k) (cv j) (cv y1)) (cfv P cmulr))) cgsu) cco1)) (cfv R c0g)) cn) N) N) $;

--| The set of all constant polynomial matrices over a ring ` R ` is closed under multiplication. (Contributed by AV, 18-Nov-2019.)
theorem cpmatmcl {x3 y1: setvar} (C P: class x3 y1) (R: class) (S: class x3) (N: class):
  $ wceq S (co N R ccpmat) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wral x3 (wral y1 (wcel (co (cv x3) (cv y1) (cfv C cmulr)) S) S) S) $;

--| The set of all constant polynomial matrices over a ring ` R ` is an additive subgroup of the ring of all polynomial matrices over the ring ` R ` . (Contributed by AV, 15-Nov-2019.)
theorem cpmatsubgpmat (C P R S N: class):
  $ wceq S (co N R ccpmat) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wcel S (cfv C csubg)) $;

--| The set of all constant polynomial matrices over a ring ` R ` is a subring of the ring of all polynomial matrices over the ring ` R ` . (Contributed by AV, 18-Nov-2019.)
theorem cpmatsrgpmat (C P R S N: class):
  $ wceq S (co N R ccpmat) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wcel S (cfv C csubrg)) $;

--| The zero of the ring of all polynomial matrices over the ring ` R ` is a constant polynomial matrix. (Contributed by AV, 27-Nov-2019.)
theorem _0elcpmat (C P R S N: class):
  $ wceq S (co N R ccpmat) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wcel (cfv C c0g) S) $;

--| Value of the matrix transformation. (Contributed by AV, 31-Jul-2019.)
theorem mat2pmatfval {x3 y1 m: setvar} (A2: class x3 y1 m) (B2: class x3 y1) (P: class x3 y1 m) (R: class) (S T: class x3 y1 m) (N: class) (V: class x3 y1 m):
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq S (cfv P cascl) $ >
  $ wi (wa (wcel N cfn) (wcel R V)) (wceq T (cmpt m B2 (cmpo x3 y1 N N (cfv (co (cv x3) (cv y1) (cv m)) S)))) $;

--| The result of a matrix transformation. (Contributed by AV, 31-Jul-2019.)
theorem mat2pmatval {x3 y1: setvar} (A2 B2 P: class x3 y1) (R: class) (S T: class x3 y1) (M N: class) (V: class x3 y1):
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq S (cfv P cascl) $ >
  $ wi (w3a (wcel N cfn) (wcel R V) (wcel M B2)) (wceq (cfv M T) (cmpo x3 y1 N N (cfv (co (cv x3) (cv y1) M) S))) $;

--| A (matrix) element of the result of a matrix transformation. (Contributed by AV, 31-Jul-2019.)
theorem mat2pmatvalel (A2 B2 P R S T M N V X Y: class):
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq S (cfv P cascl) $ >
  $ wi (wa (w3a (wcel N cfn) (wcel R V) (wcel M B2)) (wa (wcel X N) (wcel Y N))) (wceq (co X Y (cfv M T)) (cfv (co X Y M) S)) $;

--| The result of a matrix transformation is a polynomial matrix. (Contributed by AV, 1-Aug-2019.)
theorem mat2pmatbas (A2 B2 C P R T M N: class):
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wi (w3a (wcel N cfn) (wcel R crg) (wcel M B2)) (wcel (cfv M T) (cfv C cbs)) $;

--| The result of a matrix transformation is a polynomial matrix. (Contributed by AV, 27-Oct-2019.)
theorem mat2pmatbas0 (A2 B2 C P R T H M N: class):
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq H (cfv C cbs) $ >
  $ wi (w3a (wcel N cfn) (wcel R crg) (wcel M B2)) (wcel (cfv M T) H) $;

--| The matrix transformation is a function from the matrices to the polynomial matrices. (Contributed by AV, 27-Oct-2019.)
theorem mat2pmatf (A2 B2 C P R T H N: class):
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq H (cfv C cbs) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wf B2 H T) $;

--| The matrix transformation is a 1-1 function from the matrices to the polynomial matrices. (Contributed by AV, 28-Oct-2019.) (Proof shortened by AV, 27-Nov-2019.)
theorem mat2pmatf1 (A2 B2 C P R T H N: class):
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq H (cfv C cbs) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wf1 B2 H T) $;

--| The transformation of matrices into polynomial matrices is an additive group homomorphism. (Contributed by AV, 28-Oct-2019.) (Proof shortened by AV, 28-Nov-2019.)
theorem mat2pmatghm (A2 B2 C P R T H N: class):
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq H (cfv C cbs) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wcel T (co A2 C cghm)) $;

--| The transformation of matrices into polynomial matrices preserves the multiplication. (Contributed by AV, 29-Oct-2019.) (Proof shortened by AV, 28-Nov-2019.)
theorem mat2pmatmul {x3 y1: setvar} (A2 B2 C P R T H N: class):
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq H (cfv C cbs) $ >
  $ wi (wa (wcel N cfn) (wcel R ccrg)) (wral x3 (wral y1 (wceq (cfv (co (cv x3) (cv y1) (cfv A2 cmulr)) T) (co (cfv (cv x3) T) (cfv (cv y1) T) (cfv C cmulr))) B2) B2) $;

--| The transformation of the identity matrix results in the identity polynomial matrix. (Contributed by AV, 29-Oct-2019.)
theorem mat2pmat1 (A2 B2 C P R T H N: class):
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq H (cfv C cbs) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wceq (cfv (cfv A2 cur) T) (cfv C cur)) $;

--| The transformation of matrices into polynomial matrices is a homomorphism of multiplicative monoids. (Contributed by AV, 29-Oct-2019.)
theorem mat2pmatmhm (A2 B2 C P R T H N: class):
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq H (cfv C cbs) $ >
  $ wi (wa (wcel N cfn) (wcel R ccrg)) (wcel T (co (cfv A2 cmgp) (cfv C cmgp) cmhm)) $;

--| The transformation of matrices into polynomial matrices is a ring homomorphism. (Contributed by AV, 29-Oct-2019.)
theorem mat2pmatrhm (A2 B2 C P R T H N: class):
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq H (cfv C cbs) $ >
  $ wi (wa (wcel N cfn) (wcel R ccrg)) (wcel T (co A2 C crh)) $;

--| The transformation of matrices into polynomial matrices is "linear", analogous to ~ lmhmlin . Since ` A ` and ` C ` have different scalar rings, ` T ` cannot be a left module homomorphism as defined in ~ df-lmhm , see ~ lmhmsca . (Contributed by AV, 13-Nov-2019.) (Proof shortened by AV, 28-Nov-2019.)
theorem mat2pmatlin (A2 B2 C P R S T c_x c_xp H K N X Y: class):
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq H (cfv C cbs) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq S (cfv P cascl) $ >
  $ wceq c_x (cfv A2 cvsca) $ >
  $ wceq c_xp (cfv C cvsca) $ >
  $ wi (wa (wa (wcel N cfn) (wcel R ccrg)) (wa (wcel X K) (wcel Y B2))) (wceq (cfv (co X Y c_x) T) (co (cfv X S) (cfv Y T) c_xp)) $;

--| The transformed zero matrix is the zero polynomial matrix. (Contributed by AV, 5-Aug-2019.) (Proof shortened by AV, 19-Nov-2019.)
theorem _0mat2pmat (P R T N c_0 Z: class):
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq c_0 (cfv (co N R cmat) c0g) $ >
  $ wceq Z (cfv (co N P cmat) c0g) $ >
  $ wi (wa (wcel R crg) (wcel N cfn)) (wceq (cfv c_0 T) Z) $;

--| The transformed identity matrix is the identity polynomial matrix. (Contributed by AV, 1-Aug-2019.) (Proof shortened by AV, 19-Nov-2019.)
theorem idmatidpmat (P R T c_1 I N: class):
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq c_1 (cfv (co N R cmat) cur) $ >
  $ wceq I (cfv (co N P cmat) cur) $ >
  $ wi (wa (wcel R crg) (wcel N cfn)) (wceq (cfv c_1 T) I) $;

--| The transformed empty set as matrix of dimenson 0 is the empty set (i.e., the polynomial matrix of dimension 0). (Contributed by AV, 4-Aug-2019.)
theorem d0mat2pmat (R V: class):
  $ wi (wcel R V) (wceq (cfv c0 (co c0 R cmat2pmat)) c0) $;

--| The transformation of a matrix of dimenson 1. (Contributed by AV, 4-Aug-2019.)
theorem d1mat2pmat (A2 B2 P R S T M N V: class):
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq B2 (cfv (co N R cmat) cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq S (cfv P cascl) $ >
  $ wi (w3a (wcel R V) (wa (wceq N (csn A2)) (wcel A2 V)) (wcel M B2)) (wceq (cfv M T) (csn (cop (cop A2 A2) (cfv (co A2 A2 M) S)))) $;

--| A transformed matrix multiplied with a power of the variable of a polynomial is a polynomial matrix. (Contributed by AV, 6-Nov-2019.) (Proof shortened by AV, 28-Nov-2019.)
theorem mat2pmatscmxcl (A2 B2 C P R T c_ex c_as K L M N X: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq K (cfv A2 cbs) $ >
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq c_as (cfv C cvsca) $ >
  $ wceq c_ex (cfv (cfv P cmgp) cmg) $ >
  $ wceq X (cfv R cv1) $ >
  $ wi (wa (wa (wcel N cfn) (wcel R crg)) (wa (wcel M K) (wcel L cn0))) (wcel (co (co L X c_ex) (cfv M T) c_as) B2) $;

--| The result of a matrix transformation is a constant polynomial matrix. (Contributed by AV, 18-Nov-2019.) (Proof shortened by AV, 28-Nov-2019.)
theorem m2cpm (A2 B2 R S T M N: class):
  $ wceq S (co N R ccpmat) $ >
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wi (w3a (wcel N cfn) (wcel R crg) (wcel M B2)) (wcel (cfv M T) S) $;

--| The matrix transformation is a function from the matrices to the constant polynomial matrices. (Contributed by AV, 18-Nov-2019.)
theorem m2cpmf (A2 B2 R S T N: class):
  $ wceq S (co N R ccpmat) $ >
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wf B2 S T) $;

--| The matrix transformation is a 1-1 function from the matrices to the constant polynomial matrices. (Contributed by AV, 18-Nov-2019.)
theorem m2cpmf1 (A2 B2 R S T N: class):
  $ wceq S (co N R ccpmat) $ >
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wf1 B2 S T) $;

--| The transformation of matrices into constant polynomial matrices is an additive group homomorphism. (Contributed by AV, 18-Nov-2019.)
theorem m2cpmghm (A2 B2 C P R S T U N: class):
  $ wceq S (co N R ccpmat) $ >
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq U (co C S cress) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wcel T (co A2 U cghm)) $;

--| The transformation of matrices into constant polynomial matrices is a homomorphism of multiplicative monoids. (Contributed by AV, 18-Nov-2019.)
theorem m2cpmmhm (A2 B2 C P R S T U N: class):
  $ wceq S (co N R ccpmat) $ >
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq U (co C S cress) $ >
  $ wi (wa (wcel N cfn) (wcel R ccrg)) (wcel T (co (cfv A2 cmgp) (cfv U cmgp) cmhm)) $;

--| The transformation of matrices into constant polynomial matrices is a ring homomorphism. (Contributed by AV, 18-Nov-2019.)
theorem m2cpmrhm (A2 B2 C P R S T U N: class):
  $ wceq S (co N R ccpmat) $ >
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq U (co C S cress) $ >
  $ wi (wa (wcel N cfn) (wcel R ccrg)) (wcel T (co A2 U crh)) $;

--| The transformed values of a (finite) mapping of integers to matrices. (Contributed by AV, 4-Nov-2019.)
theorem m2pmfzmap (A2 B2 P R S T I N Y: class) (b: setvar):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq Y (co N P cmat) $ >
  $ wceq T (co N R cmat2pmat) $ >
  $ wi (wa (w3a (wcel N cfn) (wcel R crg) (wcel S cn0)) (wa (wcel (cv b) (co B2 (co cc0 S cfz) cmap)) (wcel I (co cc0 S cfz)))) (wcel (cfv (cfv I (cv b)) T) (cfv Y cbs)) $;

--| Closure of the sum of scaled transformed matrices. (Contributed by AV, 4-Nov-2019.) (Proof shortened by AV, 28-Nov-2019.)
theorem m2pmfzgsumcl {i: setvar} (A2: class i) (B2: class) (P: class i) (R: class) (T c_x c_ex: class i) (M N: class) (X: class i) (Y: class) (s1 b: setvar):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq Y (co N P cmat) $ >
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq c_ex (cfv (cfv P cmgp) cmg) $ >
  $ wceq c_x (cfv Y cvsca) $ >
  $ wi (wa (w3a (wcel N cfn) (wcel R ccrg) (wcel M B2)) (wa (wcel (cv s1) cn0) (wcel (cv b) (co B2 (co cc0 (cv s1) cfz) cmap)))) (wcel (co Y (cmpt i (co cc0 (cv s1) cfz) (co (co (cv i) X c_ex) (cfv (cfv (cv i) (cv b)) T) c_x)) cgsu) (cfv Y cbs)) $;

--| Value of the inverse matrix transformation. (Contributed by AV, 14-Dec-2019.)
theorem cpm2mfval {x3 y1 m: setvar} (R: class) (S: class x3 y1) (I: class x3 y1 m) (N: class) (V: class x3 y1 m):
  $ wceq I (co N R ccpmat2mat) $ >
  $ wceq S (co N R ccpmat) $ >
  $ wi (wa (wcel N cfn) (wcel R V)) (wceq I (cmpt m S (cmpo x3 y1 N N (cfv cc0 (cfv (co (cv x3) (cv y1) (cv m)) cco1))))) $;

--| The result of an inverse matrix transformation. (Contributed by AV, 12-Nov-2019.) (Revised by AV, 14-Dec-2019.)
theorem cpm2mval {x3 y1: setvar} (R: class) (S I: class x3 y1) (M N: class) (V: class x3 y1):
  $ wceq I (co N R ccpmat2mat) $ >
  $ wceq S (co N R ccpmat) $ >
  $ wi (w3a (wcel N cfn) (wcel R V) (wcel M S)) (wceq (cfv M I) (cmpo x3 y1 N N (cfv cc0 (cfv (co (cv x3) (cv y1) M) cco1)))) $;

--| A (matrix) element of the result of an inverse matrix transformation. (Contributed by AV, 14-Dec-2019.)
theorem cpm2mvalel (R S I M N V X Y: class):
  $ wceq I (co N R ccpmat2mat) $ >
  $ wceq S (co N R ccpmat) $ >
  $ wi (wa (w3a (wcel N cfn) (wcel R V) (wcel M S)) (wa (wcel X N) (wcel Y N))) (wceq (co X Y (cfv M I)) (cfv cc0 (cfv (co X Y M) cco1))) $;

--| The inverse matrix transformation is a function from the constant polynomial matrices to the matrices over the base ring of the polynomials. (Contributed by AV, 24-Nov-2019.) (Revised by AV, 15-Dec-2019.)
theorem cpm2mf (A2 R S I K N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq K (cfv A2 cbs) $ >
  $ wceq S (co N R ccpmat) $ >
  $ wceq I (co N R ccpmat2mat) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wf S K I) $;

--| The inverse transformation applied to the transformation of a matrix over a ring R results in the matrix itself. (Contributed by AV, 12-Nov-2019.) (Revised by AV, 13-Dec-2019.)
theorem m2cpminvid (A2 R T I K M N: class):
  $ wceq I (co N R ccpmat2mat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq K (cfv A2 cbs) $ >
  $ wceq T (co N R cmat2pmat) $ >
  $ wi (w3a (wcel N cfn) (wcel R crg) (wcel M K)) (wceq (cfv (cfv M T) I) M) $;

--| Lemma for ~ m2cpminvid2 . (Contributed by AV, 12-Nov-2019.) (Revised by AV, 14-Dec-2019.)
theorem m2cpminvid2lem {n: setvar} (x3 y1: setvar) (P R S M N: class):
  $ wceq S (co N R ccpmat) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wi (wa (w3a (wcel N cfn) (wcel R crg) (wcel M S)) (wa (wcel (cv x3) N) (wcel (cv y1) N))) (wral n (wceq (cfv (cv n) (cfv (cfv (cfv cc0 (cfv (co (cv x3) (cv y1) M) cco1)) (cfv P cascl)) cco1)) (cfv (cv n) (cfv (co (cv x3) (cv y1) M) cco1))) cn0) $;

--| The transformation applied to the inverse transformation of a constant polynomial matrix over the ring ` R ` results in the matrix itself. (Contributed by AV, 12-Nov-2019.) (Revised by AV, 14-Dec-2019.)
theorem m2cpminvid2 (R S T I M N: class):
  $ wceq S (co N R ccpmat) $ >
  $ wceq I (co N R ccpmat2mat) $ >
  $ wceq T (co N R cmat2pmat) $ >
  $ wi (w3a (wcel N cfn) (wcel R crg) (wcel M S)) (wceq (cfv (cfv M I) T) M) $;

--| The matrix transformation is a function from the matrices onto the constant polynomial matrices. (Contributed by AV, 19-Nov-2019.) (Proof shortened by AV, 28-Nov-2019.)
theorem m2cpmfo (A2 R S T K N: class):
  $ wceq S (co N R ccpmat) $ >
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq K (cfv A2 cbs) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wfo K S T) $;

--| The matrix transformation is a 1-1 function from the matrices onto the constant polynomial matrices. (Contributed by AV, 19-Nov-2019.)
theorem m2cpmf1o (A2 R S T K N: class):
  $ wceq S (co N R ccpmat) $ >
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq K (cfv A2 cbs) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wf1o K S T) $;

--| The transformation of matrices into constant polynomial matrices is a ring isomorphism. (Contributed by AV, 19-Nov-2019.)
theorem m2cpmrngiso (A2 C P R S T U K N: class):
  $ wceq S (co N R ccpmat) $ >
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq K (cfv A2 cbs) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq U (co C S cress) $ >
  $ wi (wa (wcel N cfn) (wcel R ccrg)) (wcel T (co A2 U crs)) $;

--| The ring of matrices over a commutative ring is isomorphic to the ring of scalar matrices over the same ring. (Contributed by AV, 30-Dec-2019.)
theorem matcpmric (A2 C P R S U N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq S (co N R ccpmat) $ >
  $ wceq U (co C S cress) $ >
  $ wi (wa (wcel N cfn) (wcel R ccrg)) (wbr A2 U cric) $;

--| The inverse matrix transformation is a 1-1 function from the constant polynomial matrices onto the matrices over the base ring of the polynomials. (Contributed by AV, 27-Nov-2019.) (Revised by AV, 15-Dec-2019.)
theorem m2cpminv (A2 R S T I K N: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq K (cfv A2 cbs) $ >
  $ wceq S (co N R ccpmat) $ >
  $ wceq I (co N R ccpmat2mat) $ >
  $ wceq T (co N R cmat2pmat) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wa (wf1o S K I) (wceq (ccnv I) T)) $;

--| The inverse matrix transformation applied to the zero polynomial matrix results in the zero of the matrices over the base ring of the polynomials. (Contributed by AV, 24-Nov-2019.) (Revised by AV, 15-Dec-2019.)
theorem m2cpminv0 (A2 C P R I N c_0 Z: class):
  $ wceq A2 (co N R cmat) $ >
  $ wceq I (co N R ccpmat2mat) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq c_0 (cfv A2 c0g) $ >
  $ wceq Z (cfv C c0g) $ >
  $ wi (wa (wcel N cfn) (wcel R crg)) (wceq (cfv Z I) c_0) $;

--| Extend class notation to include the decomposition of polynomial matrices.
term cdecpmat: class;

--| Define the decomposition of polynomial matrices. This function collects the coefficients of a polynomial matrix ` m ` belong to the ` k ` th power of the polynomial variable for each entry of ` m ` . (Contributed by AV, 2-Dec-2019.)
axiom df_decpmat {i j k m: setvar}:
  $ wceq cdecpmat (cmpo m k cvv cn0 (cmpo i j (cdm (cdm (cv m))) (cdm (cdm (cv m))) (cfv (cv k) (cfv (co (cv i) (cv j) (cv m)) cco1)))) $;

--| The matrix consisting of the coefficients in the polynomial entries of a polynomial matrix for the same power, most general version. (Contributed by AV, 2-Dec-2019.)
theorem decpmatval0 {i j: setvar} (K M: class) (V: class i j):
  $ wi (wa (wcel M V) (wcel K cn0)) (wceq (co M K cdecpmat) (cmpo i j (cdm (cdm M)) (cdm (cdm M)) (cfv K (cfv (co (cv i) (cv j) M) cco1)))) $;

--| The matrix consisting of the coefficients in the polynomial entries of a polynomial matrix for the same power, general version for arbitrary matrices. (Contributed by AV, 28-Sep-2019.) (Revised by AV, 2-Dec-2019.)
theorem decpmatval {i j: setvar} (A2: class i j) (B2: class) (R: class i j) (K M: class) (N: class i j):
  $ wceq A2 (co N R cmat) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wi (wa (wcel M B2) (wcel K cn0)) (wceq (co M K cdecpmat) (cmpo i j N N (cfv K (cfv (co (cv i) (cv j) M) cco1)))) $;

--| An entry of the matrix consisting of the coefficients in the entries of a polynomial matrix is the corresponding coefficient in the polynomial entry of the given matrix. (Contributed by AV, 28-Sep-2019.) (Revised by AV, 2-Dec-2019.)
theorem decpmate (B2 C P R I J K M N V: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi (wa (w3a (wcel R V) (wcel M B2) (wcel K cn0)) (wa (wcel I N) (wcel J N))) (wceq (co I J (co M K cdecpmat)) (cfv K (cfv (co I J M) cco1))) $;

--| Closure of the decomposition of a polynomial matrix: The matrix consisting of the coefficients in the polynomial entries of a polynomial matrix for the same power is a matrix. (Contributed by AV, 28-Sep-2019.) (Revised by AV, 2-Dec-2019.)
theorem decpmatcl (A2 B2 C D P R K M N V: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq D (cfv A2 cbs) $ >
  $ wi (w3a (wcel R V) (wcel M B2) (wcel K cn0)) (wcel (co M K cdecpmat) D) $;

--| The matrix consisting of the coefficients in the polynomial entries of a polynomial matrix for the same power is 0 for almost all powers. (Contributed by AV, 3-Nov-2019.) (Revised by AV, 3-Dec-2019.)
theorem decpmataa0 {x3 s1: setvar} (A2: class x3 s1) (B2: class) (C P: class x3 s1) (R M N c_0: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq c_0 (cfv A2 c0g) $ >
  $ wi (wa (wcel R crg) (wcel M B2)) (wrex s1 (wral x3 (wi (wbr (cv s1) (cv x3) clt) (wceq (co M (cv x3) cdecpmat) c_0)) cn0) cn0) $;

--| The mapping to the matrices consisting of the coefficients in the polynomial entries of a given matrix for the same power is finitely supported. (Contributed by AV, 5-Oct-2019.) (Revised by AV, 3-Dec-2019.)
theorem decpmatfsupp {k: setvar} (A2: class k) (B2: class) (C P: class k) (R M: class) (N c_0: class k):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq c_0 (cfv A2 c0g) $ >
  $ wi (wa (wcel R crg) (wcel M B2)) (wbr (cmpt k cn0 (co M (cv k) cdecpmat)) c_0 cfsupp) $;

--| The matrix consisting of the coefficients in the polynomial entries of the identity matrix is an identity or a zero matrix. (Contributed by AV, 28-Sep-2019.) (Revised by AV, 2-Dec-2019.)
theorem decpmatid (A2 C P R c_1 I K N c_0: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq I (cfv C cur) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq c_0 (cfv A2 c0g) $ >
  $ wceq c_1 (cfv A2 cur) $ >
  $ wi (w3a (wcel N cfn) (wcel R crg) (wcel K cn0)) (wceq (co I K cdecpmat) (cif (wceq K cc0) c_1 c_0)) $;

--| Lemma for ~ decpmatmul . (Contributed by AV, 20-Oct-2019.) (Revised by AV, 3-Dec-2019.)
theorem decpmatmullem {t l: setvar} (B2: class l) (C: class t l) (P: class l) (R U I J K: class) (N: class l) (W: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi (w3a (wa (wcel N cfn) (wcel R crg)) (wa (wcel U B2) (wcel W B2)) (w3a (wcel I N) (wcel J N) (wcel K cn0))) (wceq (co I J (co (co U W (cfv C cmulr)) K cdecpmat)) (co R (cmpt t N (co R (cmpt l (co cc0 K cfz) (co (cfv (cv l) (cfv (co I (cv t) U) cco1)) (cfv (co K (cv l) cmin) (cfv (co (cv t) J W) cco1)) (cfv R cmulr))) cgsu)) cgsu)) $;

--| The matrix consisting of the coefficients in the polynomial entries of the product of two polynomial matrices is a sum of products of the matrices consisting of the coefficients in the polynomial entries of the polynomial matrices for the same power. (Contributed by AV, 21-Oct-2019.) (Revised by AV, 3-Dec-2019.)
theorem decpmatmul {k: setvar} (A2 B2: class) (C: class k) (P R U K N W: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wi (w3a (wcel R crg) (wa (wcel U B2) (wcel W B2)) (wcel K cn0)) (wceq (co (co U W (cfv C cmulr)) K cdecpmat) (co A2 (cmpt k (co cc0 K cfz) (co (co U (cv k) cdecpmat) (co W (co K (cv k) cmin) cdecpmat) (cfv A2 cmulr))) cgsu)) $;

--| Lemma 0 for ~ pm2mpmhm . (Contributed by AV, 21-Oct-2019.)
theorem decpmatmulsumfsupp {k l: setvar} (x3 y1: setvar) (A2 B2: class) (C: class k l) (P: class l) (R: class) (c_x: class k) (N: class) (c_0: class k l):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq c_x (cfv A2 cmulr) $ >
  $ wceq c_0 (cfv A2 c0g) $ >
  $ wi (wa (wa (wcel N cfn) (wcel R crg)) (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wbr (cmpt l cn0 (co A2 (cmpt k (co cc0 (cv l) cfz) (co (co (cv x3) (cv k) cdecpmat) (co (cv y1) (co (cv l) (cv k) cmin) cdecpmat) c_x)) cgsu)) c_0 cfsupp) $;

--| Lemma 1 for ~ pmatcollpw1 . (Contributed by AV, 28-Sep-2019.) (Revised by AV, 3-Dec-2019.)
theorem pmatcollpw1lem1 {n: setvar} (B2: class) (C P: class n) (R c_xp c_ex I J M N X: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq c_xp (cfv P cvsca) $ >
  $ wceq c_ex (cfv (cfv P cmgp) cmg) $ >
  $ wceq X (cfv R cv1) $ >
  $ wi (w3a (w3a (wcel N cfn) (wcel R crg) (wcel M B2)) (wcel I N) (wcel J N)) (wbr (cmpt n cn0 (co (co I J (co M (cv n) cdecpmat)) (co (cv n) X c_ex) c_xp)) (cfv P c0g) cfsupp) $;

--| Lemma 2 for ~ pmatcollpw1 : An entry of a polynomial matrix is the sum of the entries of the matrix consisting of the coefficients in the entries of the polynomial matrix multiplied with the corresponding power of the variable. (Contributed by AV, 25-Sep-2019.) (Revised by AV, 3-Dec-2019.)
theorem pmatcollpw1lem2 {n: setvar} (B2: class) (C: class n) (P R c_xp c_ex M N X: class) (a b: setvar):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq c_xp (cfv P cvsca) $ >
  $ wceq c_ex (cfv (cfv P cmgp) cmg) $ >
  $ wceq X (cfv R cv1) $ >
  $ wi (wa (w3a (wcel N cfn) (wcel R crg) (wcel M B2)) (wa (wcel (cv a) N) (wcel (cv b) N))) (wceq (co (cv a) (cv b) M) (co P (cmpt n cn0 (co (co (cv a) (cv b) (co M (cv n) cdecpmat)) (co (cv n) X c_ex) c_xp)) cgsu)) $;

--| Write a polynomial matrix as a matrix of sums of scaled monomials. (Contributed by AV, 29-Sep-2019.) (Revised by AV, 3-Dec-2019.)
theorem pmatcollpw1 {i j n: setvar} (B2: class) (C: class i j n) (P R c_xp c_ex M N X: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq c_xp (cfv P cvsca) $ >
  $ wceq c_ex (cfv (cfv P cmgp) cmg) $ >
  $ wceq X (cfv R cv1) $ >
  $ wi (w3a (wcel N cfn) (wcel R crg) (wcel M B2)) (wceq M (cmpo i j N N (co P (cmpt n cn0 (co (co (cv i) (cv j) (co M (cv n) cdecpmat)) (co (cv n) X c_ex) c_xp)) cgsu))) $;

--| Lemma for ~ pmatcollpw2 . (Contributed by AV, 3-Oct-2019.) (Revised by AV, 3-Dec-2019.)
theorem pmatcollpw2lem {i j n: setvar} (B2: class) (C: class i j n) (P R c_xp c_ex M N X: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq c_xp (cfv P cvsca) $ >
  $ wceq c_ex (cfv (cfv P cmgp) cmg) $ >
  $ wceq X (cfv R cv1) $ >
  $ wi (w3a (wcel N cfn) (wcel R crg) (wcel M B2)) (wbr (cmpt n cn0 (cmpo i j N N (co (co (cv i) (cv j) (co M (cv n) cdecpmat)) (co (cv n) X c_ex) c_xp))) (cfv C c0g) cfsupp) $;

--| Write a polynomial matrix as a sum of matrices whose entries are products of variable powers and constant polynomials collecting like powers. (Contributed by AV, 3-Oct-2019.) (Revised by AV, 3-Dec-2019.)
theorem pmatcollpw2 {i j n: setvar} (B2: class) (C: class i j n) (P R c_xp c_ex M N X: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq c_xp (cfv P cvsca) $ >
  $ wceq c_ex (cfv (cfv P cmgp) cmg) $ >
  $ wceq X (cfv R cv1) $ >
  $ wi (w3a (wcel N cfn) (wcel R crg) (wcel M B2)) (wceq M (co C (cmpt n cn0 (cmpo i j N N (co (co (cv i) (cv j) (co M (cv n) cdecpmat)) (co (cv n) X c_ex) c_xp))) cgsu)) $;

--| The matrix consisting of the coefficients in the polynomial entries of a polynomial matrix having scaled monomials with the same power as entries is the matrix of the coefficients of the monomials or a zero matrix. Generalization of ~ decpmatid (but requires ` R ` to be commutative!). (Contributed by AV, 11-Nov-2019.) (Revised by AV, 4-Dec-2019.)
theorem monmatcollpw (A2 C P R T c_x c_ex I K L M N X c_0: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq K (cfv A2 cbs) $ >
  $ wceq c_0 (cfv A2 c0g) $ >
  $ wceq c_ex (cfv (cfv P cmgp) cmg) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq c_x (cfv C cvsca) $ >
  $ wceq T (co N R cmat2pmat) $ >
  $ wi (wa (wa (wcel N cfn) (wcel R ccrg)) (w3a (wcel M K) (wcel L cn0) (wcel I cn0))) (wceq (co (co (co L X c_ex) (cfv M T) c_x) I cdecpmat) (cif (wceq I L) M c_0)) $;

--| Lemma for ~ pmatcollpw . (Contributed by AV, 26-Oct-2019.) (Revised by AV, 4-Dec-2019.)
theorem pmatcollpwlem (B2 C P R T: class) (n: setvar) (c_ex c_as M N X: class) (a b: setvar):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq c_as (cfv C cvsca) $ >
  $ wceq c_ex (cfv (cfv P cmgp) cmg) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq T (co N R cmat2pmat) $ >
  $ wi (w3a (wa (w3a (wcel N cfn) (wcel R ccrg) (wcel M B2)) (wcel (cv n) cn0)) (wcel (cv a) N) (wcel (cv b) N)) (wceq (co (co (cv a) (cv b) (co M (cv n) cdecpmat)) (co (cv n) X c_ex) (cfv P cvsca)) (co (cv a) (cv b) (co (co (cv n) X c_ex) (cfv (co M (cv n) cdecpmat) T) c_as))) $;

--| Write a polynomial matrix (over a commutative ring) as a sum of products of variable powers and constant matrices with scalar entries. (Contributed by AV, 26-Oct-2019.) (Revised by AV, 4-Dec-2019.)
theorem pmatcollpw {n: setvar} (B2: class) (C: class n) (P R: class) (T: class n) (c_ex: class) (c_as: class n) (M N X: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq c_as (cfv C cvsca) $ >
  $ wceq c_ex (cfv (cfv P cmgp) cmg) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq T (co N R cmat2pmat) $ >
  $ wi (w3a (wcel N cfn) (wcel R ccrg) (wcel M B2)) (wceq M (co C (cmpt n cn0 (co (co (cv n) X c_ex) (cfv (co M (cv n) cdecpmat) T) c_as)) cgsu)) $;

--| Write a polynomial matrix (over a commutative ring) as a finite sum of products of variable powers and constant matrices with scalar entries. (Contributed by AV, 4-Nov-2019.) (Revised by AV, 4-Dec-2019.) (Proof shortened by AV, 3-Jul-2022.)
theorem pmatcollpwfi {n s1: setvar} (B2: class) (C P: class s1) (R: class) (T: class n s1) (c_ex: class s1) (c_as: class n s1) (M N: class) (X: class s1):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq c_as (cfv C cvsca) $ >
  $ wceq c_ex (cfv (cfv P cmgp) cmg) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq T (co N R cmat2pmat) $ >
  $ wi (w3a (wcel N cfn) (wcel R ccrg) (wcel M B2)) (wrex s1 (wceq M (co C (cmpt n (co cc0 (cv s1) cfz) (co (co (cv n) X c_ex) (cfv (co M (cv n) cdecpmat) T) c_as)) cgsu)) cn0) $;

--| Lemma for ~ pmatcollpw3 and ~ pmatcollpw3fi : Write a polynomial matrix (over a commutative ring) as a sum of products of variable powers and constant matrices with scalar entries. (Contributed by AV, 8-Dec-2019.)
theorem pmatcollpw3lem {f2 n: setvar} (A2: class f2 n) (B2 C: class) (D: class n) (P: class f2) (R: class) (T: class n) (c_ex I: class) (c_as: class n) (M N X: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq c_as (cfv C cvsca) $ >
  $ wceq c_ex (cfv (cfv P cmgp) cmg) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq D (cfv A2 cbs) $ >
  $ wi (wa (w3a (wcel N cfn) (wcel R ccrg) (wcel M B2)) (wa (wss I cn0) (wne I c0))) (wi (wceq M (co C (cmpt n I (co (co (cv n) X c_ex) (cfv (co M (cv n) cdecpmat) T) c_as)) cgsu)) (wrex f2 (wceq M (co C (cmpt n I (co (co (cv n) X c_ex) (cfv (cfv (cv n) (cv f2)) T) c_as)) cgsu)) (co D I cmap))) $;

--| Write a polynomial matrix (over a commutative ring) as a sum of products of variable powers and constant matrices with scalar entries. (Contributed by AV, 27-Oct-2019.) (Revised by AV, 4-Dec-2019.) (Proof shortened by AV, 8-Dec-2019.)
theorem pmatcollpw3 {f2 n: setvar} (A2: class f2 n) (B2 C: class) (D: class n) (P: class f2) (R: class) (T: class n) (c_ex: class) (c_as: class n) (M N X: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq c_as (cfv C cvsca) $ >
  $ wceq c_ex (cfv (cfv P cmgp) cmg) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq D (cfv A2 cbs) $ >
  $ wi (w3a (wcel N cfn) (wcel R ccrg) (wcel M B2)) (wrex f2 (wceq M (co C (cmpt n cn0 (co (co (cv n) X c_ex) (cfv (cfv (cv n) (cv f2)) T) c_as)) cgsu)) (co D cn0 cmap)) $;

--| Write a polynomial matrix (over a commutative ring) as a finite sum of products of variable powers and constant matrices with scalar entries. (Contributed by AV, 4-Nov-2019.) (Revised by AV, 4-Dec-2019.) (Proof shortened by AV, 8-Dec-2019.)
theorem pmatcollpw3fi {f2 n s1: setvar} (A2: class f2 n s1) (B2: class) (C: class s1) (D: class n s1) (P: class f2 s1) (R: class) (T: class n s1) (c_ex: class s1) (c_as: class n s1) (M N: class) (X: class s1):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq c_as (cfv C cvsca) $ >
  $ wceq c_ex (cfv (cfv P cmgp) cmg) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq D (cfv A2 cbs) $ >
  $ wi (w3a (wcel N cfn) (wcel R ccrg) (wcel M B2)) (wrex s1 (wrex f2 (wceq M (co C (cmpt n (co cc0 (cv s1) cfz) (co (co (cv n) X c_ex) (cfv (cfv (cv n) (cv f2)) T) c_as)) cgsu)) (co D (co cc0 (cv s1) cfz) cmap)) cn0) $;

--| Lemma 1 for ~ pmatcollpw3fi1 . (Contributed by AV, 6-Nov-2019.) (Revised by AV, 4-Dec-2019.)
theorem pmatcollpw3fi1lem1 {n l: setvar} (A2: class n) (B2: class) (C: class l) (D: class) (P: class l) (R: class) (T: class n l) (c_ex: class l) (G: class) (H c_as: class n l) (M N: class) (X: class l) (c_0: class n l):
  $ wceq P (cfv R cpl1) $ >
  $ wceq C (co N P cmat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq c_as (cfv C cvsca) $ >
  $ wceq c_ex (cfv (cfv P cmgp) cmg) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq A2 (co N R cmat) $ >
  $ wceq D (cfv A2 cbs) $ >
  $ wceq c_0 (cfv A2 c0g) $ >
  $ wceq H (cmpt l (co cc0 c1 cfz) (cif (wceq (cv l) cc0) (cfv cc0 G) c_0)) $ >
  $ wi (w3a (wa (wcel N cfn) (wcel R crg)) (wcel G (co D (csn cc0) cmap)) (wceq M (co C (cmpt n (csn cc0) (co (co (cv n) X c_ex) (cfv (cfv (cv n) G) T) c_as)) cgsu))) (wceq M (co C (cmpt n (co cc0 c1 cfz) (co (co (cv n) X c_ex) (cfv (cfv (cv n) H) T) c_as)) cgsu)) $;

--| Lemma 2 for ~ pmatcollpw3fi1 . (Contributed by AV, 6-Nov-2019.) (Revised by AV, 4-Dec-2019.)
theorem pmatcollpw3fi1lem2 {f2 n s1: setvar} (A2 B2 C D: class) (P: class f2 s1) (R: class) (T: class n) (c_ex: class) (c_as: class n) (M N X: class):

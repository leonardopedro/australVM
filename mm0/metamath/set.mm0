  $ wceq J (cfv C clspn) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq I (cmpt x3 cvv (cif (wceq (cfv (cv x3) c2nd) c_0) Q (crio h (wa (wceq (cfv (cfv (csn (cfv (cv x3) c2nd)) N) M) (cfv (csn (cv h)) J)) (wceq (cfv (cfv (csn (co (cfv (cfv (cv x3) c1st) c1st) (cfv (cv x3) c2nd) c_mi)) N) M) (cfv (csn (co (cfv (cfv (cv x3) c1st) c2nd) (cv h) R)) J))) D))) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel F D) $ >
  $ wi ph (wceq (cfv (cfv (csn X) N) M) (cfv (csn F) J)) $ >
  $ wi ph (wceq (cfv (cotp X F Y) I) G) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel Y (cdif V (csn c_0))) $ >
  $ wi ph (wceq (cfv (cotp Y G X) I) F) $;

--| Part (7) of [Baer] p. 48 line 10 (4 of 6 cases). (Contributed by NM, 2-May-2015.)
theorem mapdh75d {x3 h: setvar} (ph: wff x3) (C: class x3) (D: class) (Q: class h) (R: class) (U: class x3) (E F G: class) (H I: class x3 h) (J: class) (K: class x3 h) (M c_mi N: class) (V W: class x3 h) (X Y c_0 Z: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq D (cfv C cbs) $ >
  $ wceq R (cfv C csg) $ >
  $ wceq Q (cfv C c0g) $ >
  $ wceq J (cfv C clspn) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq I (cmpt x3 cvv (cif (wceq (cfv (cv x3) c2nd) c_0) Q (crio h (wa (wceq (cfv (cfv (csn (cfv (cv x3) c2nd)) N) M) (cfv (csn (cv h)) J)) (wceq (cfv (cfv (csn (co (cfv (cfv (cv x3) c1st) c1st) (cfv (cv x3) c2nd) c_mi)) N) M) (cfv (csn (co (cfv (cfv (cv x3) c1st) c2nd) (cv h) R)) J))) D))) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel F D) $ >
  $ wi ph (wceq (cfv (cfv (csn X) N) M) (cfv (csn F) J)) $ >
  $ wi ph (wceq (cfv (cotp X F Y) I) G) $ >
  $ wi ph (wceq (cfv (cotp X F Z) I) E) $ >
  $ wi ph (wne (cfv (csn Y) N) (cfv (csn Z) N)) $ >
  $ wi ph (wn (wcel X (cfv (cpr Y Z) N))) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel Y (cdif V (csn c_0))) $ >
  $ wi ph (wcel Z (cdif V (csn c_0))) $ >
  $ wi ph (wceq (cfv (cotp Y G Z) I) E) $;

--| Part (7) of [Baer] p. 48 line 10 (6 of 6 cases). (Contributed by NM, 2-May-2015.) (New usage is discouraged.)
theorem mapdh75fN {x3 h: setvar} (ph: wff x3) (C: class x3) (D: class) (Q: class h) (R: class) (U: class x3) (E F G: class) (H I: class x3 h) (J: class) (K: class x3 h) (M c_mi N: class) (V W: class x3 h) (X Y c_0 Z: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq D (cfv C cbs) $ >
  $ wceq R (cfv C csg) $ >
  $ wceq Q (cfv C c0g) $ >
  $ wceq J (cfv C clspn) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq I (cmpt x3 cvv (cif (wceq (cfv (cv x3) c2nd) c_0) Q (crio h (wa (wceq (cfv (cfv (csn (cfv (cv x3) c2nd)) N) M) (cfv (csn (cv h)) J)) (wceq (cfv (cfv (csn (co (cfv (cfv (cv x3) c1st) c1st) (cfv (cv x3) c2nd) c_mi)) N) M) (cfv (csn (co (cfv (cfv (cv x3) c1st) c2nd) (cv h) R)) J))) D))) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel F D) $ >
  $ wi ph (wceq (cfv (cfv (csn X) N) M) (cfv (csn F) J)) $ >
  $ wi ph (wceq (cfv (cotp X F Y) I) G) $ >
  $ wi ph (wceq (cfv (cotp X F Z) I) E) $ >
  $ wi ph (wne (cfv (csn Y) N) (cfv (csn Z) N)) $ >
  $ wi ph (wn (wcel X (cfv (cpr Y Z) N))) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel Y (cdif V (csn c_0))) $ >
  $ wi ph (wcel Z (cdif V (csn c_0))) $ >
  $ wi ph (wceq (cfv (cotp Z E Y) I) G) $;

--| Extend class notation with vector to dual map.
term chvm: class;

--| Extend class notation with a map from each nonzero vector ` x ` to a unique nonzero functional in the closed kernel dual space. (We could extend it to include the zero vector, but that is unnecessary for our purposes.) TODO: This pattern is used several times earlier, e.g., ~ lcf1o , ~ dochfl1 - should we update those to use this definition? (Contributed by NM, 23-Mar-2015.)
axiom df_hvmap {x3 w v t j k: setvar}:
  $ wceq chvm (cmpt k cvv (cmpt w (cfv (cv k) clh) (cmpt x3 (cdif (cfv (cfv (cv w) (cfv (cv k) cdvh)) cbs) (csn (cfv (cfv (cv w) (cfv (cv k) cdvh)) c0g))) (cmpt v (cfv (cfv (cv w) (cfv (cv k) cdvh)) cbs) (crio j (wrex t (wceq (cv v) (co (cv t) (co (cv j) (cv x3) (cfv (cfv (cv w) (cfv (cv k) cdvh)) cvsca)) (cfv (cfv (cv w) (cfv (cv k) cdvh)) cplusg))) (cfv (csn (cv x3)) (cfv (cv w) (cfv (cv k) coch)))) (cfv (cfv (cfv (cv w) (cfv (cv k) cdvh)) csca) cbs)))))) $;

--| Map from nonzero vectors to nonzero functionals in the closed kernel dual space. (Contributed by NM, 23-Mar-2015.)
theorem hvmapffval {x3 w v t j: setvar} (H: class x3 v t j) (K: class) (X: class x3 w v t j):
  $ wceq H (cfv K clh) $ >
  $ wi (wcel K X) (wceq (cfv K chvm) (cmpt w H (cmpt x3 (cdif (cfv (cfv (cv w) (cfv K cdvh)) cbs) (csn (cfv (cfv (cv w) (cfv K cdvh)) c0g))) (cmpt v (cfv (cfv (cv w) (cfv K cdvh)) cbs) (crio j (wrex t (wceq (cv v) (co (cv t) (co (cv j) (cv x3) (cfv (cfv (cv w) (cfv K cdvh)) cvsca)) (cfv (cfv (cv w) (cfv K cdvh)) cplusg))) (cfv (csn (cv x3)) (cfv (cv w) (cfv K coch)))) (cfv (cfv (cfv (cv w) (cfv K cdvh)) csca) cbs)))))) $;

--| Map from nonzero vectors to nonzero functionals in the closed kernel dual space. (Contributed by NM, 23-Mar-2015.)
theorem hvmapfval {x3 v t j: setvar} (ph: wff x3 v t j) (A2 c_pl: class x3 v t j) (R: class x3 v t) (S c_x U H: class x3 v t j) (K: class) (M: class x3 v t j) (O: class x3 v j) (V: class v t j) (W: class) (c_0: class v t j):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq O (cfv W (cfv K coch)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq S (cfv U csca) $ >
  $ wceq R (cfv S cbs) $ >
  $ wceq M (cfv W (cfv K chvm)) $ >
  $ wi ph (wa (wcel K A2) (wcel W H)) $ >
  $ wi ph (wceq M (cmpt x3 (cdif V (csn c_0)) (cmpt v V (crio j (wrex t (wceq (cv v) (co (cv t) (co (cv j) (cv x3) c_x) c_pl)) (cfv (csn (cv x3)) O)) R)))) $;

--| Value of map from nonzero vectors to nonzero functionals in the closed kernel dual space. (Contributed by NM, 23-Mar-2015.)
theorem hvmapval {v t j: setvar} (ph: wff v t j) (A2 c_pl: class v t j) (R: class v t) (S c_x U H: class v t j) (K: class) (M: class v t j) (O: class v j) (V: class t j) (W X: class) (c_0: class v t j):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq O (cfv W (cfv K coch)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq S (cfv U csca) $ >
  $ wceq R (cfv S cbs) $ >
  $ wceq M (cfv W (cfv K chvm)) $ >
  $ wi ph (wa (wcel K A2) (wcel W H)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wceq (cfv X M) (cmpt v V (crio j (wrex t (wceq (cv v) (co (cv t) (co (cv j) X c_x) c_pl)) (cfv (csn X) O)) R))) $;

--| Value of value of map (i.e. functional value) from nonzero vectors to nonzero functionals in the closed kernel dual space. (Contributed by NM, 23-Mar-2015.) (New usage is discouraged.)
theorem hvmapvalvalN {t j: setvar} (ph: wff t j) (A2 c_pl: class t j) (R: class t) (S c_x U H: class t j) (K: class) (M: class t j) (O: class j) (V: class t j) (W X Y: class) (c_0: class t j):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq O (cfv W (cfv K coch)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq S (cfv U csca) $ >
  $ wceq R (cfv S cbs) $ >
  $ wceq M (cfv W (cfv K chvm)) $ >
  $ wi ph (wa (wcel K A2) (wcel W H)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wceq (cfv Y (cfv X M)) (crio j (wrex t (wceq Y (co (cv t) (co (cv j) X c_x) c_pl)) (cfv (csn X) O)) R)) $;

--| The value of the vector to functional map, at the vector, is one. (Contributed by NM, 23-Mar-2015.) (New usage is discouraged.)
theorem hvmapidN (ph: wff) (S U c_1 H K M V W X c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq S (cfv U csca) $ >
  $ wceq c_1 (cfv S cur) $ >
  $ wceq M (cfv W (cfv K chvm)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wceq (cfv X (cfv X M)) c_1) $;

--| The vector to functional map provides a bijection from nonzero vectors ` V ` to nonzero functionals with closed kernels ` C ` . (Contributed by NM, 27-Mar-2015.)
theorem hvmap1o {f2: setvar} (ph: wff f2) (C D Q: class f2) (U F: class) (H K: class f2) (L: class) (M: class f2) (O V: class) (W c_0: class f2):
  $ wceq H (cfv K clh) $ >
  $ wceq O (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq D (cfv U cld) $ >
  $ wceq Q (cfv D c0g) $ >
  $ wceq C (crab f2 (wceq (cfv (cfv (cfv (cv f2) L) O) O) (cfv (cv f2) L)) F) $ >
  $ wceq M (cfv W (cfv K chvm)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wf1o (cdif V (csn c_0)) (cdif C (csn Q)) M) $;

--| Closure of the vector to functional map. (Contributed by NM, 27-Mar-2015.) (New usage is discouraged.)
theorem hvmapclN {f2: setvar} (ph: wff f2) (C D Q: class f2) (U F: class) (H K: class f2) (L: class) (M: class f2) (O V: class) (W X c_0: class f2):
  $ wceq H (cfv K clh) $ >
  $ wceq O (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq D (cfv U cld) $ >
  $ wceq Q (cfv D c0g) $ >
  $ wceq C (crab f2 (wceq (cfv (cfv (cfv (cv f2) L) O) O) (cfv (cv f2) L)) F) $ >
  $ wceq M (cfv W (cfv K chvm)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel (cfv X M) (cdif C (csn Q))) $;

--| The vector to functional map provides a bijection from nonzero vectors ` V ` to nonzero functionals with closed kernels ` C ` . (Contributed by NM, 27-Mar-2015.)
theorem hvmap1o2 (ph: wff) (C U F H K M O V W c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq F (cfv C cbs) $ >
  $ wceq O (cfv C c0g) $ >
  $ wceq M (cfv W (cfv K chvm)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wf1o (cdif V (csn c_0)) (cdif F (csn O)) M) $;

--| Closure of the vector to functional map. (Contributed by NM, 27-Mar-2015.)
theorem hvmapcl2 (ph: wff) (C U F H K M O V W X c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq F (cfv C cbs) $ >
  $ wceq O (cfv C c0g) $ >
  $ wceq M (cfv W (cfv K chvm)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel (cfv X M) (cdif F (csn O))) $;

--| The vector to functional map value is a functional. (Contributed by NM, 28-Mar-2015.)
theorem hvmaplfl (ph: wff) (U F H K M V W X c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq M (cfv W (cfv K chvm)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel (cfv X M) F) $;

--| Kernel of the vector to functional map. TODO: make this become ~ lcfrlem11 . (Contributed by NM, 29-Mar-2015.)
theorem hvmaplkr (ph: wff) (U H K L M O V W X c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq O (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq M (cfv W (cfv K chvm)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wceq (cfv (cfv X M) L) (cfv (csn X) O)) $;

--| Relationship between ` mapd ` and ` HVMap ` , which can be used to satisfy the last hypothesis of ~ mapdpg . Equation 10 of [Baer] p. 48. (Contributed by NM, 29-Mar-2015.)
theorem mapdhvmap (ph: wff) (C P U H J K M N V W X c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq J (cfv C clspn) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq P (cfv W (cfv K chvm)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wceq (cfv (cfv (csn X) N) M) (cfv (csn (cfv X P)) J)) $;

--| Obtain an independent vector set ` U , X , Y ` from a vector ` U ` dependent on ` X ` and ` Z ` and another independent set ` Z , X , Y ` . (Here we don't show the ` ( N `` { X } ) =/= ( N `` { Y } ) ` part of the independence, which passes straight through. We also don't show nonzero vector requirements that are redundant for this theorem. Different orderings can be obtained using ~ lspexch and ~ prcom .) (Contributed by NM, 4-May-2015.)
theorem lspindp5 (ph: wff) (U N V W X Y Z: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wcel Z (cfv (cpr X U) N)) $ >
  $ wi ph (wn (wcel Z (cfv (cpr X Y) N))) $ >
  $ wi ph (wn (wcel U (cfv (cpr X Y) N))) $;

--| Lemma to convert a frequently-used union condition. TODO: see if this can be applied to other hdmap* theorems. (Contributed by NM, 17-May-2015.)
theorem hdmaplem1 (ph: wff) (N V W X Y Z: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel Z V) $ >
  $ wi ph (wn (wcel Z (cun (cfv (csn X) N) (cfv (csn Y) N)))) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wne (cfv (csn Z) N) (cfv (csn X) N)) $;

--| Lemma to convert a frequently-used union condition. TODO: see if this can be applied to other hdmap* theorems. (Contributed by NM, 17-May-2015.) (New usage is discouraged.)
theorem hdmaplem2N (ph: wff) (N V W X Y Z: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel Z V) $ >
  $ wi ph (wn (wcel Z (cun (cfv (csn X) N) (cfv (csn Y) N)))) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wne (cfv (csn Z) N) (cfv (csn Y) N)) $;

--| Lemma to convert a frequently-used union condition. TODO: see if this can be applied to other hdmap* theorems. (Contributed by NM, 17-May-2015.)
theorem hdmaplem3 (ph: wff) (N V W X Y c_0 Z: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel Z V) $ >
  $ wi ph (wn (wcel Z (cun (cfv (csn X) N) (cfv (csn Y) N)))) $ >
  $ wi ph (wcel Y V) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi ph (wcel Z (cdif V (csn c_0))) $;

--| Lemma to convert a frequently-used union condition. TODO: see if this can be applied to other hdmap* theorems. (Contributed by NM, 17-May-2015.)
theorem hdmaplem4 (ph: wff) (N V W X Y c_0 Z: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wcel Z (cdif V (csn c_0))) $ >
  $ wi ph (wne (cfv (csn Z) N) (cfv (csn X) N)) $ >
  $ wi ph (wne (cfv (csn Z) N) (cfv (csn Y) N)) $ >
  $ wi ph (wn (wcel Z (cun (cfv (csn X) N) (cfv (csn Y) N)))) $;

--| Part of Part (8) in [Baer] p. 48. (Contributed by NM, 5-May-2015.)
theorem mapdh8a {x3 h: setvar} (ph: wff x3) (C: class x3) (D: class) (Q: class h) (R T: class) (U: class x3) (F G: class) (H: class x3 h) (I: class x3) (J: class) (K: class x3 h) (M c_mi N: class) (V W: class x3 h) (X Y c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq D (cfv C cbs) $ >
  $ wceq R (cfv C csg) $ >
  $ wceq Q (cfv C c0g) $ >
  $ wceq J (cfv C clspn) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >

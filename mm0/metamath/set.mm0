  $ wi (wcel C (cdif O E)) (wn (wrex k (wceq (cfv (cv k) (cfv C F)) cc0) (co c1 (co (cfv C I) c1 cmin) cfz))) $;

--| If the first vote is for B, the vote on the first tie is for A. (Contributed by Thierry Arnoux, 1-Dec-2016.)
theorem ballotlemic {x3 i k c: setvar} (C: class x3 c) (P: class x3 i k c) (E F: class x3) (I: class x3 c) (M N O: class x3):
  $ wcel M cn $ >
  $ wcel N cn $ >
  $ wceq O (crab c (wceq (cfv (cv c) chash) M) (cpw (co c1 (co M N caddc) cfz))) $ >
  $ wceq P (cmpt x3 (cpw O) (co (cfv (cv x3) chash) (cfv O chash) cdiv)) $ >
  $ wceq F (cmpt c O (cmpt i cz (co (cfv (cin (co c1 (cv i) cfz) (cv c)) chash) (cfv (cdif (co c1 (cv i) cfz) (cv c)) chash) cmin))) $ >
  $ wceq E (crab c (wral i (wbr cc0 (cfv (cv i) (cfv (cv c) F)) clt) (co c1 (co M N caddc) cfz)) O) $ >

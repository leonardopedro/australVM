  $ wi ph (wb (wne A2 B2) ps) $;

--| Contrapositive inference for inequality. (Contributed by NM, 31-Jan-2008.)
theorem necon1bbid (ph ps: wff) (A2 B2: class):
  $ wi ph (wb (wne A2 B2) ps) $ >
  $ wi ph (wb (wn ps) (wceq A2 B2)) $;

--| Contrapositive law deduction for inequality. (Contributed by NM, 11-Jan-2008.) (Proof shortened by Wolf Lammen, 24-Nov-2019.)
theorem necon4abid (ph ps: wff) (A2 B2: class):
  $ wi ph (wb (wne A2 B2) (wn ps)) $ >
  $ wi ph (wb (wceq A2 B2) ps) $;

--| Contrapositive law deduction for inequality. (Contributed by NM, 9-May-2012.)
theorem necon4bbid (ph ps: wff) (A2 B2: class):
  $ wi ph (wb (wn ps) (wne A2 B2)) $ >
  $ wi ph (wb ps (wceq A2 B2)) $;

--| Contrapositive deduction for inequality. (Contributed by NM, 18-Jul-2007.) (Proof shortened by Wolf Lammen, 24-Nov-2019.)
theorem necon2abid (ph ps: wff) (A2 B2: class):
  $ wi ph (wb (wceq A2 B2) (wn ps)) $ >
  $ wi ph (wb ps (wne A2 B2)) $;

--| Contrapositive deduction for inequality. (Contributed by NM, 13-Apr-2007.) (Proof shortened by Wolf Lammen, 24-Nov-2019.)
theorem necon2bbid (ph ps: wff) (A2 B2: class):
  $ wi ph (wb ps (wne A2 B2)) $ >
  $ wi ph (wb (wceq A2 B2) (wn ps)) $;

--| Deduction from equality to inequality. (Contributed by NM, 23-Feb-2005.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem necon3bid (ph: wff) (A2 B2 C D: class):
  $ wi ph (wb (wceq A2 B2) (wceq C D)) $ >
  $ wi ph (wb (wne A2 B2) (wne C D)) $;

--| Contrapositive law deduction for inequality. (Contributed by NM, 29-Jun-2007.)
theorem necon4bid (ph: wff) (A2 B2 C D: class):
  $ wi ph (wb (wne A2 B2) (wne C D)) $ >
  $ wi ph (wb (wceq A2 B2) (wceq C D)) $;

--| Deduction from equality to inequality. (Contributed by NM, 9-Nov-2007.)
theorem necon3abii (ph: wff) (A2 B2: class):
  $ wb (wceq A2 B2) ph $ >
  $ wb (wne A2 B2) (wn ph) $;

--| Deduction from equality to inequality. (Contributed by NM, 13-Apr-2007.)
theorem necon3bbii (ph: wff) (A2 B2: class):
  $ wb ph (wceq A2 B2) $ >
  $ wb (wn ph) (wne A2 B2) $;

--| Contrapositive inference for inequality. (Contributed by NM, 17-Mar-2007.) (Proof shortened by Wolf Lammen, 25-Nov-2019.)
theorem necon1abii (ph: wff) (A2 B2: class):
  $ wb (wn ph) (wceq A2 B2) $ >
  $ wb (wne A2 B2) ph $;

--| Contrapositive inference for inequality. (Contributed by NM, 17-Mar-2007.) (Proof shortened by Wolf Lammen, 24-Nov-2019.)
theorem necon1bbii (ph: wff) (A2 B2: class):
  $ wb (wne A2 B2) ph $ >
  $ wb (wn ph) (wceq A2 B2) $;

--| Contrapositive inference for inequality. (Contributed by NM, 2-Mar-2007.)
theorem necon2abii (ph: wff) (A2 B2: class):
  $ wb (wceq A2 B2) (wn ph) $ >
  $ wb ph (wne A2 B2) $;

--| Contrapositive inference for inequality. (Contributed by NM, 13-Apr-2007.)
theorem necon2bbii (ph: wff) (A2 B2: class):
  $ wb ph (wne A2 B2) $ >
  $ wb (wceq A2 B2) (wn ph) $;

--| Inference from equality to inequality. (Contributed by NM, 23-Feb-2005.)
theorem necon3bii (A2 B2 C D: class):
  $ wb (wceq A2 B2) (wceq C D) $ >
  $ wb (wne A2 B2) (wne C D) $;

--| Commutation of inequality. (Contributed by NM, 14-May-1999.)
theorem necom (A2 B2: class):
  $ wb (wne A2 B2) (wne B2 A2) $;

--| Inference from commutative law for inequality. (Contributed by NM, 17-Oct-2012.)
theorem necomi (A2 B2: class):
  $ wne A2 B2 $ >
  $ wne B2 A2 $;

--| Deduction from commutative law for inequality. (Contributed by NM, 12-Feb-2008.)
theorem necomd (ph: wff) (A2 B2: class):
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wne B2 A2) $;

--| Characterization of inequality in terms of reversed equality (see ~ bicom ). (Contributed by BJ, 7-Jul-2018.)
theorem nesym (A2 B2: class):
  $ wb (wne A2 B2) (wn (wceq B2 A2)) $;

--| Inference associated with ~ nesym . (Contributed by BJ, 7-Jul-2018.) (Proof shortened by Wolf Lammen, 25-Nov-2019.)
theorem nesymi (A2 B2: class):
  $ wne A2 B2 $ >
  $ wn (wceq B2 A2) $;

--| Inference associated with ~ nesym . (Contributed by BJ, 7-Jul-2018.) (Proof shortened by Wolf Lammen, 25-Nov-2019.)
theorem nesymir (A2 B2: class):
  $ wn (wceq A2 B2) $ >
  $ wne B2 A2 $;

--| Deduction for inequality. (Contributed by NM, 25-Oct-1999.) (Proof shortened by Wolf Lammen, 19-Nov-2019.)
theorem neeq1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wne A2 C) (wne B2 C)) $;

--| Deduction for inequality. (Contributed by NM, 25-Oct-1999.) (Proof shortened by Wolf Lammen, 19-Nov-2019.)
theorem neeq2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wne C A2) (wne C B2)) $;

--| Deduction for inequality. (Contributed by NM, 24-Jul-2012.) (Proof shortened by Wolf Lammen, 25-Nov-2019.)
theorem neeq12d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wb (wne A2 C) (wne B2 D)) $;

--| Equality theorem for inequality. (Contributed by NM, 19-Nov-1994.) (Proof shortened by Wolf Lammen, 18-Nov-2019.)
theorem neeq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wb (wne A2 C) (wne B2 C)) $;

--| Equality theorem for inequality. (Contributed by NM, 19-Nov-1994.) (Proof shortened by Wolf Lammen, 18-Nov-2019.)
theorem neeq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wb (wne C A2) (wne C B2)) $;

--| Inference for inequality. (Contributed by NM, 29-Apr-2005.) (Proof shortened by Wolf Lammen, 19-Nov-2019.)
theorem neeq1i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wb (wne A2 C) (wne B2 C) $;

--| Inference for inequality. (Contributed by NM, 29-Apr-2005.) (Proof shortened by Wolf Lammen, 19-Nov-2019.)
theorem neeq2i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wb (wne C A2) (wne C B2) $;

--| Inference for inequality. (Contributed by NM, 24-Jul-2012.) (Proof shortened by Wolf Lammen, 25-Nov-2019.)
theorem neeq12i (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq C D $ >
  $ wb (wne A2 C) (wne B2 D) $;

--| Substitution of equal classes into an inequality. (Contributed by NM, 4-Jul-2012.)
theorem eqnetrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wne B2 C) $ >
  $ wi ph (wne A2 C) $;

--| Substitution of equal classes into an inequality. (Contributed by NM, 4-Jul-2012.)
theorem eqnetrrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wne A2 C) $ >
  $ wi ph (wne B2 C) $;

--| Substitution of equal classes into an inequality. (Contributed by NM, 4-Jul-2012.)
theorem neeqtrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wceq B2 C) $ >
  $ wi ph (wne A2 C) $;

--| Substitution of equal classes into an inequality. (Contributed by NM, 4-Jul-2012.)
theorem eqnetri (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wne B2 C $ >
  $ wne A2 C $;

--| Substitution of equal classes into an inequality. (Contributed by NM, 4-Jul-2012.)
theorem eqnetrri (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wne A2 C $ >
  $ wne B2 C $;

--| Substitution of equal classes into an inequality. (Contributed by NM, 4-Jul-2012.)
theorem neeqtri (A2 B2 C: class):
  $ wne A2 B2 $ >
  $ wceq B2 C $ >
  $ wne A2 C $;

--| Substitution of equal classes into an inequality. (Contributed by NM, 4-Jul-2012.)
theorem neeqtrri (A2 B2 C: class):
  $ wne A2 B2 $ >
  $ wceq C B2 $ >
  $ wne A2 C $;

--| Substitution of equal classes into an inequality. (Contributed by NM, 4-Jul-2012.)
theorem neeqtrrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wceq C B2) $ >
  $ wi ph (wne A2 C) $;

--| A chained equality inference for inequality. (Contributed by NM, 6-Jun-2012.) (Proof shortened by Wolf Lammen, 19-Nov-2019.)
theorem eqnetrrid (ph: wff) (A2 B2 C: class):
  $ wceq B2 A2 $ >
  $ wi ph (wne B2 C) $ >
  $ wi ph (wne A2 C) $;

--| Substitution of equality into both sides of an inequality. (Contributed by NM, 24-Jul-2012.) (Proof shortened by Wolf Lammen, 19-Nov-2019.)
theorem _3netr3d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wceq A2 C) $ >
  $ wi ph (wceq B2 D) $ >
  $ wi ph (wne C D) $;

--| Substitution of equality into both sides of an inequality. (Contributed by NM, 24-Jul-2012.) (Proof shortened by Wolf Lammen, 21-Nov-2019.)
theorem _3netr4d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wceq C A2) $ >
  $ wi ph (wceq D B2) $ >
  $ wi ph (wne C D) $;

--| Substitution of equality into both sides of an inequality. (Contributed by NM, 24-Jul-2012.)
theorem _3netr3g (ph: wff) (A2 B2 C D: class):
  $ wi ph (wne A2 B2) $ >
  $ wceq A2 C $ >
  $ wceq B2 D $ >
  $ wi ph (wne C D) $;

--| Substitution of equality into both sides of an inequality. (Contributed by NM, 14-Jun-2012.)
theorem _3netr4g (ph: wff) (A2 B2 C D: class):
  $ wi ph (wne A2 B2) $ >
  $ wceq C A2 $ >
  $ wceq D B2 $ >
  $ wi ph (wne C D) $;

--| Contraposition law for inequality. (Contributed by NM, 28-Dec-2008.)
theorem nebi (A2 B2 C D: class):
  $ wb (wb (wceq A2 B2) (wceq C D)) (wb (wne A2 B2) (wne C D)) $;

--| Theorem *13.18 in [WhiteheadRussell] p. 178. (Contributed by Andrew Salmon, 3-Jun-2011.) (Proof shortened by Wolf Lammen, 29-Oct-2024.)
theorem pm13_18 (A2 B2 C: class):
  $ wi (wa (wceq A2 B2) (wne A2 C)) (wne B2 C) $;

--| Theorem *13.181 in [WhiteheadRussell] p. 178. (Contributed by Andrew Salmon, 3-Jun-2011.) (Proof shortened by Wolf Lammen, 30-Oct-2024.)
theorem pm13_181 (A2 B2 C: class):
  $ wi (wa (wceq A2 B2) (wne B2 C)) (wne A2 C) $;

--| Inference eliminating an inequality in an antecedent. (Contributed by NM, 16-Jan-2007.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem pm2_61ine (ph: wff) (A2 B2: class):
  $ wi (wceq A2 B2) ph $ >
  $ wi (wne A2 B2) ph $ >
  $ ph $;

--| A contradiction implies anything. Equality/inequality deduction form. (Contributed by David Moews, 28-Feb-2017.)
theorem pm2_21ddne (ph ps: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph ps $;

--| Deduction eliminating an inequality in an antecedent. (Contributed by NM, 24-May-2006.) (Proof shortened by Andrew Salmon, 25-May-2011.) (Proof shortened by Wolf Lammen, 25-Nov-2019.)
theorem pm2_61ne (ph ps ch: wff) (A2 B2: class):
  $ wi (wceq A2 B2) (wb ps ch) $ >
  $ wi (wa ph (wne A2 B2)) ps $ >
  $ wi ph ch $ >
  $ wi ph ps $;

--| Deduction eliminating an inequality in an antecedent. (Contributed by NM, 1-Jun-2007.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem pm2_61dne (ph ps: wff) (A2 B2: class):
  $ wi ph (wi (wceq A2 B2) ps) $ >
  $ wi ph (wi (wne A2 B2) ps) $ >
  $ wi ph ps $;

--| Deduction eliminating an inequality in an antecedent. (Contributed by NM, 30-Nov-2011.)
theorem pm2_61dane (ph ps: wff) (A2 B2: class):
  $ wi (wa ph (wceq A2 B2)) ps $ >
  $ wi (wa ph (wne A2 B2)) ps $ >
  $ wi ph ps $;

--| Deduction eliminating two inequalities in an antecedent. (Contributed by NM, 29-May-2013.)
theorem pm2_61da2ne (ph ps: wff) (A2 B2 C D: class):
  $ wi (wa ph (wceq A2 B2)) ps $ >
  $ wi (wa ph (wceq C D)) ps $ >
  $ wi (wa ph (wa (wne A2 B2) (wne C D))) ps $ >
  $ wi ph ps $;

--| Deduction eliminating three inequalities in an antecedent. (Contributed by NM, 15-Jun-2013.) (Proof shortened by Wolf Lammen, 25-Nov-2019.)
theorem pm2_61da3ne (ph ps: wff) (A2 B2 C D E F: class):
  $ wi (wa ph (wceq A2 B2)) ps $ >
  $ wi (wa ph (wceq C D)) ps $ >
  $ wi (wa ph (wceq E F)) ps $ >
  $ wi (wa ph (w3a (wne A2 B2) (wne C D) (wne E F))) ps $ >
  $ wi ph ps $;

--| Equality version of ~ pm2.61ii . (Contributed by Scott Fenton, 13-Jun-2013.) (Proof shortened by Wolf Lammen, 25-Nov-2019.)
theorem pm2_61iine (ph: wff) (A2 B2 C D: class):
  $ wi (wa (wne A2 C) (wne B2 D)) ph $ >
  $ wi (wceq A2 C) ph $ >
  $ wi (wceq B2 D) ph $ >
  $ ph $;

--| A modus tollens deduction for inequality. (Contributed by Steven Nguyen, 1-Jun-2023.)
theorem mteqand (ph: wff) (A2 B2 C D: class):
  $ wi ph (wne C D) $ >
  $ wi (wa ph (wceq A2 B2)) (wceq C D) $ >
  $ wi ph (wne A2 B2) $;

--| Logical OR with an equality. (Contributed by NM, 29-Apr-2007.)
theorem neor (ps: wff) (A2 B2: class):
  $ wb (wo (wceq A2 B2) ps) (wi (wne A2 B2) ps) $;

--| A De Morgan's law for inequality. (Contributed by NM, 18-May-2007.)
theorem neanior (A2 B2 C D: class):
  $ wb (wa (wne A2 B2) (wne C D)) (wn (wo (wceq A2 B2) (wceq C D))) $;

--| A De Morgan's law for inequality. (Contributed by NM, 30-Sep-2013.)
theorem ne3anior (A2 B2 C D E F: class):
  $ wb (w3a (wne A2 B2) (wne C D) (wne E F)) (wn (w3o (wceq A2 B2) (wceq C D) (wceq E F))) $;

--| A De Morgan's law for inequality. (Contributed by NM, 18-May-2007.)
theorem neorian (A2 B2 C D: class):
  $ wb (wo (wne A2 B2) (wne C D)) (wn (wa (wceq A2 B2) (wceq C D))) $;

--| An inference from an inequality, related to modus tollens. (Contributed by NM, 13-Apr-2007.)
theorem nemtbir (ph: wff) (A2 B2: class):
  $ wne A2 B2 $ >
  $ wb ph (wceq A2 B2) $ >
  $ wn ph $;

--| Two classes are different if they don't contain the same element. (Contributed by NM, 3-Feb-2012.) (Proof shortened by Wolf Lammen, 14-May-2023.)
theorem nelne1 (A2 B2 C: class):
  $ wi (wa (wcel A2 B2) (wn (wcel A2 C))) (wne B2 C) $;

--| Two classes are different if they don't belong to the same class. (Contributed by NM, 25-Jun-2012.) (Proof shortened by Wolf Lammen, 14-May-2023.)
theorem nelne2 (A2 B2 C: class):
  $ wi (wa (wcel A2 C) (wn (wcel B2 C))) (wne A2 B2) $;

--| Two classes are not equal if there is an element of one which is not an element of the other. (Contributed by Rohan Ridenour, 11-Aug-2023.)
theorem elnelneqd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel C A2) $ >
  $ wi ph (wn (wcel C B2)) $ >
  $ wi ph (wn (wceq A2 B2)) $;

--| Two classes are not equal if one but not the other is an element of a given class. (Contributed by Rohan Ridenour, 12-Aug-2023.)
theorem elnelneq2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 C) $ >
  $ wi ph (wn (wcel B2 C)) $ >
  $ wi ph (wn (wceq A2 B2)) $;

--| Two classes are different if they don't belong to the same class. (Contributed by Rodolfo Medina, 17-Oct-2010.) (Proof shortened by AV, 10-May-2020.)
theorem nelelne (A2 B2 C: class):
  $ wi (wn (wcel A2 B2)) (wi (wcel C B2) (wne C A2)) $;

--| If two classes are different, a third class must be different of at least one of them. (Contributed by Thierry Arnoux, 8-Aug-2020.)
theorem neneor (A2 B2 C: class):
  $ wi (wne A2 B2) (wo (wne A2 C) (wne B2 C)) $;

--| Bound-variable hypothesis builder for inequality. (Contributed by NM, 10-Nov-2007.) (Revised by Mario Carneiro, 7-Oct-2016.)
theorem nfne {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnf x3 (wne A2 B2) $;

--| Bound-variable hypothesis builder for inequality. (Contributed by NM, 10-Nov-2007.) (Revised by Mario Carneiro, 7-Oct-2016.)
theorem nfned {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 B2) $ >
  $ wi ph (wnf x3 (wne A2 B2)) $;

--| Not equivalent wff's correspond to not equal class abstractions. (Contributed by AV, 7-Apr-2019.) (Proof shortened by Wolf Lammen, 25-Nov-2019.) Definitial form. (Revised by Wolf Lammen, 5-Mar-2025.)
theorem nabbib {x3: setvar} (ph ps: wff x3):
  $ wb (wne (cab x3 ph) (cab x3 ps)) (wex x3 (wb ph (wn ps))) $;

--| Extend wff notation to include negated membership.
term wnel (A2 B2: class): wff;

--| Define negated membership. (Contributed by NM, 7-Aug-1994.)
axiom df_nel (A2 B2: class):
  $ wb (wnel A2 B2) (wn (wcel A2 B2)) $;

--| Inference associated with ~ df-nel . (Contributed by BJ, 7-Jul-2018.)
theorem neli (A2 B2: class):
  $ wnel A2 B2 $ >
  $ wn (wcel A2 B2) $;

--| Inference associated with ~ df-nel . (Contributed by BJ, 7-Jul-2018.)
theorem nelir (A2 B2: class):
  $ wn (wcel A2 B2) $ >
  $ wnel A2 B2 $;

--| Contrapositive law deduction for negated membership. (Contributed by AV, 28-Jan-2020.)
theorem nelcon3d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wi (wcel A2 B2) (wcel C D)) $ >
  $ wi ph (wi (wnel C D) (wnel A2 B2)) $;

--| Equality theorem for negated membership. (Contributed by FL, 10-Aug-2016.) (Proof shortened by Wolf Lammen, 25-Nov-2019.)
theorem neleq12d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wb (wnel A2 C) (wnel B2 D)) $;

--| Equality theorem for negated membership. (Contributed by NM, 20-Nov-1994.) (Proof shortened by Wolf Lammen, 25-Nov-2019.)
theorem neleq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wb (wnel A2 C) (wnel B2 C)) $;

--| Equality theorem for negated membership. (Contributed by NM, 20-Nov-1994.) (Proof shortened by Wolf Lammen, 25-Nov-2019.)
theorem neleq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wb (wnel C A2) (wnel C B2)) $;

--| Bound-variable hypothesis builder for negated membership. (Contributed by David Abernethy, 26-Jun-2011.) (Revised by Mario Carneiro, 7-Oct-2016.)
theorem nfnel {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnf x3 (wnel A2 B2) $;

--| Bound-variable hypothesis builder for negated membership. (Contributed by David Abernethy, 26-Jun-2011.) (Revised by Mario Carneiro, 7-Oct-2016.)
theorem nfneld {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 B2) $ >
  $ wi ph (wnf x3 (wnel A2 B2)) $;

--| Negation of negated membership, analogous to ~ nne . (Contributed by Alexander van der Vekens, 18-Jan-2018.) (Proof shortened by Wolf Lammen, 25-Nov-2019.)
theorem nnel (A2 B2: class):
  $ wb (wn (wnel A2 B2)) (wcel A2 B2) $;

--| Two classes are different if they don't contain the same element. (Contributed by AV, 28-Jan-2020.)
theorem elnelne1 (A2 B2 C: class):
  $ wi (wa (wcel A2 B2) (wnel A2 C)) (wne B2 C) $;

--| Two classes are different if they don't belong to the same class. (Contributed by AV, 28-Jan-2020.)
theorem elnelne2 (A2 B2 C: class):
  $ wi (wa (wcel A2 C) (wnel B2 C)) (wne A2 B2) $;

--| A contradiction concerning membership implies anything. (Contributed by Alexander van der Vekens, 25-Jan-2018.)
theorem pm2_24nel (ph: wff) (A2 B2: class):
  $ wi (wcel A2 B2) (wi (wnel A2 B2) ph) $;

--| Deduction eliminating an elementhood in an antecedent. (Contributed by AV, 5-Dec-2021.)
theorem pm2_61danel (ph ps: wff) (A2 B2: class):
  $ wi (wa ph (wcel A2 B2)) ps $ >
  $ wi (wa ph (wnel A2 B2)) ps $ >
  $ wi ph ps $;

--| Extend wff notation to include restricted universal quantification.
term wral {x3: setvar} (ph: wff x3) (A2: class x3): wff;

--| Define restricted universal quantification. Special case of Definition 4.15(3) of [TakeutiZaring] p. 22. Note: This notation is most often used to express that ` ph ` holds for all elements of a given class ` A ` . For this reading ` F/_ x A ` is required, though, for example, asserted when ` x ` and ` A ` are disjoint. Should instead ` A ` depend on ` x ` , you rather focus on those ` x ` that happen to be contained in the corresponding ` A ( x ) ` . This hardly used interpretation could still occur naturally. For some examples, look at ~ ralndv1 or ~ ralndv2 , courtesy of AV. So be careful to either keep ` A ` independent of ` x ` , or adjust your comments to include such exotic cases. (Contributed by NM, 19-Aug-1993.)
axiom df_ral {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wral x3 ph A2) (wal x3 (wi (wcel (cv x3) A2) ph)) $;

--| Generalization rule for restricted quantification. (Contributed by NM, 19-Nov-1994.)
theorem rgen {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wcel (cv x3) A2) ph $ >
  $ wral x3 ph A2 $;

--| All elements of a class are elements of the class. (Contributed by AV, 30-Oct-2020.)
theorem ralel {x3: setvar} (A2: class x3):
  $ wral x3 (wcel (cv x3) A2) A2 $;

--| Generalization rule for restricted quantification. (Contributed by NM, 18-Jun-2014.)
theorem rgenw {x3: setvar} (ph: wff x3) (A2: class x3):
  $ ph $ >
  $ wral x3 ph A2 $;

--| Generalization rule for restricted quantification. Note that ` x ` and ` y ` needn't be distinct. (Contributed by NM, 18-Jun-2014.)
theorem rgen2w {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ ph $ >
  $ wral x3 (wral y1 ph B2) A2 $;

--| Modus ponens combined with restricted generalization. (Contributed by NM, 10-Aug-2004.)
theorem mprg {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wral x3 ph A2) ps $ >
  $ wi (wcel (cv x3) A2) ph $ >
  $ ps $;

--| Modus ponens on biconditional combined with restricted generalization. (Contributed by NM, 21-Mar-2004.)
theorem mprgbir {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb ph (wral x3 ps A2) $ >
  $ wi (wcel (cv x3) A2) ps $ >
  $ ph $;

--| Sufficient condition for the restricted universal quantifier. Deduction form. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.)
theorem ralrid {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi ph (wal x3 (wi (wcel (cv x3) A2) ps)) $ >
  $ wi ph (wral x3 ps A2) $;

--| Restricted universally quantified negation expressed as a universally quantified negation. (Contributed by BJ, 16-Jul-2021.)
theorem raln {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wral x3 (wn ph) A2) (wal x3 (wn (wa (wcel (cv x3) A2) ph))) $;

--| Extend wff notation to include restricted existential quantification.
term wrex {x3: setvar} (ph: wff x3) (A2: class x3): wff;

--| Define restricted existential quantification. Special case of Definition 4.15(4) of [TakeutiZaring] p. 22. Note: This notation is most often used to express that ` ph ` holds for at least one element of a given class ` A ` . For this reading ` F/_ x A ` is required, though, for example, asserted when ` x ` and ` A ` are disjoint. Should instead ` A ` depend on ` x ` , you rather assert at least one ` x ` fulfilling ` ph ` happens to be contained in the corresponding ` A ( x ) ` . This interpretation is rarely needed (see also ~ df-ral ). (Contributed by NM, 30-Aug-1993.)
axiom df_rex {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wrex x3 ph A2) (wex x3 (wa (wcel (cv x3) A2) ph)) $;

--| Relationship between restricted universal and existential quantifiers. (Contributed by NM, 21-Jan-1997.) (Proof shortened by BJ, 16-Jul-2021.)
theorem ralnex {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wral x3 (wn ph) A2) (wn (wrex x3 ph A2)) $;

--| Relationship between restricted universal and existential quantifiers. (Contributed by NM, 21-Jan-1997.) (Proof shortened by Wolf Lammen, 26-Nov-2019.)
theorem dfrex2 {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wrex x3 ph A2) (wn (wral x3 (wn ph) A2)) $;

--| Inference adding restricted existential quantifier to negated wff. (Contributed by NM, 16-Oct-2003.)
theorem nrex {x3: setvar} (ps: wff x3) (A2: class x3):
  $ wi (wcel (cv x3) A2) (wn ps) $ >
  $ wn (wrex x3 ps A2) $;

--| Universal quantification implies restricted quantification. (Contributed by NM, 20-Oct-2006.)
theorem alral {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wal x3 ph) (wral x3 ph A2) $;

--| Restricted existence implies existence. (Contributed by NM, 11-Nov-1995.)
theorem rexex {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wrex x3 ph A2) (wex x3 ph) $;

--| Two ways of expressing that a class has at least one element. (Contributed by Zhi Wang, 23-Sep-2024.)
theorem rextru {x3: setvar} (A2: class x3):
  $ wb (wex x3 (wcel (cv x3) A2)) (wrex x3 wtru A2) $;

--| Inference quantifying both antecedent and consequent. (Contributed by NM, 22-Feb-2004.)
theorem ralimi2 {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wi (wi (wcel (cv x3) A2) ph) (wi (wcel (cv x3) B2) ps) $ >
  $ wi (wral x3 ph A2) (wral x3 ps B2) $;

--| Inference quantifying both antecedent and consequent, based on Theorem 19.22 of [Margaris] p. 90. (Contributed by NM, 8-Nov-2004.)
theorem reximi2 {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wi (wa (wcel (cv x3) A2) ph) (wa (wcel (cv x3) B2) ps) $ >
  $ wi (wrex x3 ph A2) (wrex x3 ps B2) $;

--| Inference quantifying both antecedent and consequent. (Contributed by NM, 19-Jul-1996.)
theorem ralimia {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wcel (cv x3) A2) (wi ph ps) $ >
  $ wi (wral x3 ph A2) (wral x3 ps A2) $;

--| Inference quantifying both antecedent and consequent. (Contributed by NM, 10-Feb-1997.) (Proof shortened by Wolf Lammen, 31-Oct-2024.)
theorem reximia {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wcel (cv x3) A2) (wi ph ps) $ >
  $ wi (wrex x3 ph A2) (wrex x3 ps A2) $;

--| Inference quantifying both antecedent and consequent. (Contributed by NM, 4-Aug-2007.)
theorem ralimiaa {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wa (wcel (cv x3) A2) ph) ps $ >
  $ wi (wral x3 ph A2) (wral x3 ps A2) $;

--| Inference quantifying both antecedent and consequent, with strong hypothesis. (Contributed by NM, 4-Mar-1997.)
theorem ralimi {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi ph ps $ >
  $ wi (wral x3 ph A2) (wral x3 ps A2) $;

--| Inference quantifying both antecedent and consequent. (Contributed by NM, 18-Oct-1996.)
theorem reximi {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi ph ps $ >
  $ wi (wrex x3 ph A2) (wrex x3 ps A2) $;

--| Inference quantifying antecedent, nested antecedent, and consequent, with a strong hypothesis. (Contributed by NM, 19-Dec-2006.) Allow shortening of ~ ralim . (Revised by Wolf Lammen, 1-Dec-2019.)
theorem ral2imi {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wi ph (wi ps ch) $ >
  $ wi (wral x3 ph A2) (wi (wral x3 ps A2) (wral x3 ch A2)) $;

--| Distribution of restricted quantification over implication. (Contributed by NM, 9-Feb-1997.) (Proof shortened by Wolf Lammen, 1-Dec-2019.)
theorem ralim {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wral x3 (wi ph ps) A2) (wi (wral x3 ph A2) (wral x3 ps A2)) $;

--| Theorem 19.22 of [Margaris] p. 90. (Restricted quantifier version.) (Contributed by NM, 22-Nov-1994.) (Proof shortened by Andrew Salmon, 30-May-2011.)
theorem rexim {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wral x3 (wi ph ps) A2) (wi (wrex x3 ph A2) (wrex x3 ps A2)) $;

--| Inference adding different restricted universal quantifiers to each side of an equivalence. (Contributed by NM, 15-Aug-2005.)
theorem ralbii2 {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wb (wi (wcel (cv x3) A2) ph) (wi (wcel (cv x3) B2) ps) $ >
  $ wb (wral x3 ph A2) (wral x3 ps B2) $;

--| Inference adding different restricted existential quantifiers to each side of an equivalence. (Contributed by NM, 4-Feb-2004.)
theorem rexbii2 {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wb (wa (wcel (cv x3) A2) ph) (wa (wcel (cv x3) B2) ps) $ >
  $ wb (wrex x3 ph A2) (wrex x3 ps B2) $;

--| Inference adding restricted universal quantifier to both sides of an equivalence. (Contributed by NM, 26-Nov-2000.)
theorem ralbiia {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wcel (cv x3) A2) (wb ph ps) $ >
  $ wb (wral x3 ph A2) (wral x3 ps A2) $;

--| Inference adding restricted existential quantifier to both sides of an equivalence. (Contributed by NM, 26-Oct-1999.)
theorem rexbiia {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wcel (cv x3) A2) (wb ph ps) $ >
  $ wb (wrex x3 ph A2) (wrex x3 ps A2) $;

--| Inference adding restricted universal quantifier to both sides of an equivalence. (Contributed by NM, 23-Nov-1994.) (Revised by Mario Carneiro, 17-Oct-2016.) (Proof shortened by Wolf Lammen, 4-Dec-2019.)
theorem ralbii {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb ph ps $ >
  $ wb (wral x3 ph A2) (wral x3 ps A2) $;

--| Inference adding restricted existential quantifier to both sides of an equivalence. (Contributed by NM, 23-Nov-1994.) (Revised by Mario Carneiro, 17-Oct-2016.) (Proof shortened by Wolf Lammen, 6-Dec-2019.)
theorem rexbii {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb ph ps $ >
  $ wb (wrex x3 ph A2) (wrex x3 ps A2) $;

--| Cancellation law for restricted universal quantification. (Contributed by Peter Mazsa, 30-Dec-2018.) (Proof shortened by Wolf Lammen, 29-Jun-2023.)
theorem ralanid {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wral x3 (wa (wcel (cv x3) A2) ph) A2) (wral x3 ph A2) $;

--| Cancellation law for restricted existential quantification. (Contributed by Peter Mazsa, 24-May-2018.) (Proof shortened by Wolf Lammen, 8-Jul-2023.)
theorem rexanid {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wrex x3 (wa (wcel (cv x3) A2) ph) A2) (wrex x3 ph A2) $;

--| A commutation law for restricted universal quantifiers that swaps the domains of the restriction. (Contributed by NM, 22-Feb-2004.) (Proof shortened by Wolf Lammen, 22-Dec-2024.)
theorem ralcom3 {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wb (wral x3 (wi (wcel (cv x3) B2) ph) A2) (wral x3 (wi (wcel (cv x3) A2) ph) B2) $;

--| Relationship between restricted universal and existential quantifiers. (Contributed by NM, 21-Jan-1997.) Allow shortening of ~ rexnal . (Revised by Wolf Lammen, 9-Dec-2019.)
theorem dfral2 {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wral x3 ph A2) (wn (wrex x3 (wn ph) A2)) $;

--| Relationship between restricted universal and existential quantifiers. (Contributed by NM, 21-Jan-1997.) (Proof shortened by Wolf Lammen, 9-Dec-2019.)
theorem rexnal {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wrex x3 (wn ph) A2) (wn (wral x3 ph A2)) $;

--| A transformation of restricted quantifiers and logical connectives. (Contributed by NM, 4-Sep-2005.)
theorem ralinexa {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb (wral x3 (wi ph (wn ps)) A2) (wn (wrex x3 (wa ph ps) A2)) $;

--| A transformation of restricted quantifiers and logical connectives. (Contributed by NM, 4-Sep-2005.) (Proof shortened by Wolf Lammen, 27-Dec-2019.)
theorem rexanali {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb (wrex x3 (wa ph (wn ps)) A2) (wn (wral x3 (wi ph ps) A2)) $;

--| Distribute a restricted universal quantifier over a biconditional. Restricted quantification version of ~ albi . (Contributed by NM, 6-Oct-2003.) Reduce axiom usage. (Revised by Wolf Lammen, 17-Jun-2023.)
theorem ralbi {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wral x3 (wb ph ps) A2) (wb (wral x3 ph A2) (wral x3 ps A2)) $;

--| Distribute restricted quantification over a biconditional. (Contributed by Scott Fenton, 7-Aug-2024.) (Proof shortened by Wolf Lammen, 3-Nov-2024.)
theorem rexbi {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wral x3 (wb ph ps) A2) (wb (wrex x3 ph A2) (wrex x3 ps A2)) $;

--| Formula-building rule for restricted existential quantifier, using a restricted universal quantifier to bind the quantified variable in the antecedent. (Contributed by AV, 21-Oct-2023.) Reduce axiom usage. (Revised by SN, 13-Nov-2023.) (Proof shortened by Wolf Lammen, 4-Nov-2024.)
theorem ralrexbid {x3: setvar} (ph ps th: wff x3) (A2: class x3):
  $ wi ph (wb ps th) $ >
  $ wi (wral x3 ph A2) (wb (wrex x3 ps A2) (wrex x3 th A2)) $;

--| Restricted quantifier version of ~ 19.35 . (Contributed by NM, 20-Sep-2003.) (Proof shortened by Wolf Lammen, 22-Dec-2024.)
theorem r19_35 {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb (wrex x3 (wi ph ps) A2) (wi (wral x3 ph A2) (wrex x3 ps A2)) $;

--| Version of ~ 19.26 and ~ r19.26 with restricted quantifiers ranging over different classes. (Contributed by NM, 22-Feb-2004.)
theorem r19_26m {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wb (wal x3 (wa (wi (wcel (cv x3) A2) ph) (wi (wcel (cv x3) B2) ps))) (wa (wral x3 ph A2) (wral x3 ps B2)) $;

--| Restricted quantifier version of ~ 19.26 . (Contributed by NM, 28-Jan-1997.) (Proof shortened by Andrew Salmon, 30-May-2011.)
theorem r19_26 {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb (wral x3 (wa ph ps) A2) (wa (wral x3 ph A2) (wral x3 ps A2)) $;

--| Version of ~ r19.26 with three quantifiers. (Contributed by FL, 22-Nov-2010.)
theorem r19_26_3 {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wb (wral x3 (w3a ph ps ch) A2) (w3a (wral x3 ph A2) (wral x3 ps A2) (wral x3 ch A2)) $;

--| Split a biconditional and distribute quantifier. Restricted quantifier version of ~ albiim . (Contributed by NM, 3-Jun-2012.)
theorem ralbiim {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb (wral x3 (wb ph ps) A2) (wa (wral x3 (wi ph ps) A2) (wral x3 (wi ps ph) A2)) $;

--| Restricted quantifier version of ~ 19.29 . See also ~ r19.29r . (Contributed by NM, 31-Aug-1999.) (Proof shortened by Andrew Salmon, 30-May-2011.) (Proof shortened by Wolf Lammen, 22-Dec-2024.)
theorem r19_29 {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wa (wral x3 ph A2) (wrex x3 ps A2)) (wrex x3 (wa ph ps) A2) $;

--| Restricted quantifier version of ~ 19.29r ; variation of ~ r19.29 . (Contributed by NM, 31-Aug-1999.) (Proof shortened by Wolf Lammen, 29-Jun-2023.)
theorem r19_29r {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wa (wrex x3 ph A2) (wral x3 ps A2)) (wrex x3 (wa ph ps) A2) $;

--| Theorem 19.29 of [Margaris] p. 90 with an implication in the hypothesis containing the generalization, deduction version. (Contributed by AV, 19-Jan-2019.)
theorem r19_29imd {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wi ph (wrex x3 ps A2) $ >
  $ wi ph (wral x3 (wi ps ch) A2) $ >
  $ wi ph (wrex x3 (wa ps ch) A2) $;

--| Restricted quantifier version of Theorem 19.40 of [Margaris] p. 90. (Contributed by NM, 2-Apr-2004.)
theorem r19_40 {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wrex x3 (wa ph ps) A2) (wa (wrex x3 ph A2) (wrex x3 ps A2)) $;

--| Restricted quantifier version of ~ 19.30 . (Contributed by Scott Fenton, 25-Feb-2011.) (Proof shortened by Wolf Lammen, 5-Nov-2024.)
theorem r19_30 {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wral x3 (wo ph ps) A2) (wo (wral x3 ph A2) (wrex x3 ps A2)) $;

--| Restricted quantifier version of ~ 19.43 . (Contributed by NM, 27-May-1998.) (Proof shortened by Andrew Salmon, 30-May-2011.)
theorem r19_43 {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb (wrex x3 (wo ph ps) A2) (wo (wrex x3 ph A2) (wrex x3 ps A2)) $;

--| Restricted quantifier version of ~ 19.43 for a triple disjunction . (Contributed by AV, 2-Nov-2025.)
theorem _3r19_43 {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wb (wrex x3 (w3o ph ps ch) A2) (w3o (wrex x3 ph A2) (wrex x3 ps A2) (wrex x3 ch A2)) $;

--| Inference quantifying both antecedent and consequent two times, with strong hypothesis. (Contributed by AV, 3-Dec-2021.)
theorem _2ralimi {x3 y1: setvar} (ph ps: wff x3 y1) (A2 B2: class x3 y1):
  $ wi ph ps $ >
  $ wi (wral x3 (wral y1 ph B2) A2) (wral x3 (wral y1 ps B2) A2) $;

--| Inference quantifying both antecedent and consequent three times, with strong hypothesis. (Contributed by Scott Fenton, 5-Mar-2025.)
theorem _3ralimi {x3 y1 z: setvar} (ph ps: wff x3 y1 z) (A2 B2 C: class x3 y1 z):
  $ wi ph ps $ >
  $ wi (wral x3 (wral y1 (wral z ph C) B2) A2) (wral x3 (wral y1 (wral z ps C) B2) A2) $;

--| Inference quantifying both antecedent and consequent four times, with strong hypothesis. (Contributed by Scott Fenton, 5-Mar-2025.)
theorem _4ralimi {x3 y1 z w: setvar} (ph ps: wff x3 y1 z w) (A2 B2 C D: class x3 y1 z w):
  $ wi ph ps $ >
  $ wi (wral x3 (wral y1 (wral z (wral w ph D) C) B2) A2) (wral x3 (wral y1 (wral z (wral w ps D) C) B2) A2) $;

--| Inference quantifying both antecedent and consequent five times, with strong hypothesis. (Contributed by Scott Fenton, 5-Mar-2025.)
theorem _5ralimi {x3 y1 z w t: setvar} (ph ps: wff x3 y1 z w t) (A2 B2 C D E: class x3 y1 z w t):
  $ wi ph ps $ >
  $ wi (wral x3 (wral y1 (wral z (wral w (wral t ph E) D) C) B2) A2) (wral x3 (wral y1 (wral z (wral w (wral t ps E) D) C) B2) A2) $;

--| Inference quantifying both antecedent and consequent six times, with strong hypothesis. (Contributed by Scott Fenton, 5-Mar-2025.)
theorem _6ralimi {x3 y1 z w u t: setvar} (ph ps: wff x3 y1 z w u t) (A2 B2 C D E F: class x3 y1 z w u t):
  $ wi ph ps $ >
  $ wi (wral x3 (wral y1 (wral z (wral w (wral t (wral u ph F) E) D) C) B2) A2) (wral x3 (wral y1 (wral z (wral w (wral t (wral u ps F) E) D) C) B2) A2) $;

--| Inference adding two restricted universal quantifiers to both sides of an equivalence. (Contributed by NM, 1-Aug-2004.)
theorem _2ralbii {x3 y1: setvar} (ph ps: wff x3 y1) (A2 B2: class x3 y1):
  $ wb ph ps $ >
  $ wb (wral x3 (wral y1 ph B2) A2) (wral x3 (wral y1 ps B2) A2) $;

--| Inference adding two restricted existential quantifiers to both sides of an equivalence. (Contributed by NM, 11-Nov-1995.)
theorem _2rexbii {x3 y1: setvar} (ph ps: wff x3 y1) (A2 B2: class x3 y1):
  $ wb ph ps $ >
  $ wb (wrex x3 (wrex y1 ph B2) A2) (wrex x3 (wrex y1 ps B2) A2) $;

--| Inference adding three restricted universal quantifiers to both sides of an equivalence. (Contributed by Peter Mazsa, 25-Jul-2019.)
theorem _3ralbii {x3 y1 z: setvar} (ph ps: wff x3 y1 z) (A2 B2 C: class x3 y1 z):
  $ wb ph ps $ >
  $ wb (wral x3 (wral y1 (wral z ph C) B2) A2) (wral x3 (wral y1 (wral z ps C) B2) A2) $;

--| Inference adding four restricted universal quantifiers to both sides of an equivalence. (Contributed by Scott Fenton, 28-Feb-2025.)
theorem _4ralbii {x3 y1 z w: setvar} (ph ps: wff x3 y1 z w) (A2 B2 C D: class x3 y1 z w):
  $ wb ph ps $ >
  $ wb (wral x3 (wral y1 (wral z (wral w ph D) C) B2) A2) (wral x3 (wral y1 (wral z (wral w ps D) C) B2) A2) $;

--| Split a biconditional and distribute two restricted universal quantifiers, analogous to ~ 2albiim and ~ ralbiim . (Contributed by Alexander van der Vekens, 2-Jul-2017.)
theorem _2ralbiim {x3 y1: setvar} (ph ps: wff x3 y1) (A2 B2: class x3 y1):
  $ wb (wral x3 (wral y1 (wb ph ps) B2) A2) (wa (wral x3 (wral y1 (wi ph ps) B2) A2) (wral x3 (wral y1 (wi ps ph) B2) A2)) $;

--| Relationship between two restricted universal and existential quantifiers. (Contributed by Glauco Siliprandi, 11-Dec-2019.) (Proof shortened by Wolf Lammen, 18-May-2023.)
theorem ralnex2 {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ wb (wral x3 (wral y1 (wn ph) B2) A2) (wn (wrex x3 (wrex y1 ph B2) A2)) $;

--| Relationship between three restricted universal and existential quantifiers. (Contributed by Thierry Arnoux, 12-Jul-2020.) (Proof shortened by Wolf Lammen, 18-May-2023.)
theorem ralnex3 {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2 B2 C: class x3 y1 z):
  $ wb (wral x3 (wral y1 (wral z (wn ph) C) B2) A2) (wn (wrex x3 (wrex y1 (wrex z ph C) B2) A2)) $;

--| Relationship between two restricted universal and existential quantifiers. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem rexnal2 {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ wb (wrex x3 (wrex y1 (wn ph) B2) A2) (wn (wral x3 (wral y1 ph B2) A2)) $;

--| Relationship between three restricted universal and existential quantifiers. (Contributed by Thierry Arnoux, 12-Jul-2020.)
theorem rexnal3 {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2 B2 C: class x3 y1 z):
  $ wb (wrex x3 (wrex y1 (wrex z (wn ph) C) B2) A2) (wn (wral x3 (wral y1 (wral z ph C) B2) A2)) $;

--| Negation of a complex predicate calculus formula. (Contributed by FL, 31-Jul-2009.)
theorem nrexralim {x3 y1: setvar} (ph ps: wff x3 y1) (A2 B2: class x3 y1):
  $ wb (wn (wrex x3 (wral y1 (wi ph ps) B2) A2)) (wral x3 (wrex y1 (wa ph (wn ps)) B2) A2) $;

--| Restricted quantifier version of ~ 19.26-2 . Version of ~ r19.26 with two quantifiers. (Contributed by NM, 10-Aug-2004.)
theorem r19_26_2 {x3 y1: setvar} (ph ps: wff x3 y1) (A2 B2: class x3 y1):
  $ wb (wral x3 (wral y1 (wa ph ps) B2) A2) (wa (wral x3 (wral y1 ph B2) A2) (wral x3 (wral y1 ps B2) A2)) $;

--| Theorem ~ r19.29 with two quantifiers. (Contributed by Rodolfo Medina, 25-Sep-2010.)
theorem _2r19_29 {x3 y1: setvar} (ph ps: wff x3 y1) (A2 B2: class x3 y1):
  $ wi (wa (wral x3 (wral y1 ph B2) A2) (wrex x3 (wrex y1 ps B2) A2)) (wrex x3 (wrex y1 (wa ph ps) B2) A2) $;

--| Theorem 19.29 of [Margaris] p. 90 with two restricted quantifiers, deduction version. (Contributed by Thierry Arnoux, 30-Jan-2017.) (Proof shortened by Wolf Lammen, 4-Nov-2024.)
theorem r19_29d2r {x3 y1: setvar} (ph ps ch: wff x3 y1) (A2 B2: class x3 y1):
  $ wi ph (wral x3 (wral y1 ps B2) A2) $ >
  $ wi ph (wrex x3 (wrex y1 ch B2) A2) $ >
  $ wi ph (wrex x3 (wrex y1 (wa ps ch) B2) A2) $;

--| Lemma factoring out common proof steps of ~ r2alf and ~ r2al . Introduced to reduce dependencies on axioms. (Contributed by Wolf Lammen, 9-Jan-2020.)
theorem r2allem {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ wb (wal y1 (wi (wcel (cv x3) A2) (wi (wcel (cv y1) B2) ph))) (wi (wcel (cv x3) A2) (wal y1 (wi (wcel (cv y1) B2) ph))) $ >
  $ wb (wral x3 (wral y1 ph B2) A2) (wal x3 (wal y1 (wi (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ph))) $;

--| Lemma factoring out common proof steps in ~ r2exf an ~ r2ex . Introduced to reduce dependencies on axioms. (Contributed by Wolf Lammen, 10-Jan-2020.)
theorem r2exlem {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ wb (wral x3 (wral y1 (wn ph) B2) A2) (wal x3 (wal y1 (wi (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) (wn ph)))) $ >
  $ wb (wrex x3 (wrex y1 ph B2) A2) (wex x3 (wex y1 (wa (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ph))) $;

--| Inference from Theorem 19.21 of [Margaris] p. 90 (restricted quantifier version). This theorem contains the common proof steps for ~ ralrimi and ~ ralrimiv . Its main advantage over these two is its minimal references to axioms. The proof is extracted from NM's previous work. (Contributed by Wolf Lammen, 4-Dec-2019.)
theorem hbralrimi {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi ph (wal x3 ph) $ >
  $ wi ph (wi (wcel (cv x3) A2) ps) $ >
  $ wi ph (wral x3 ps A2) $;

--| Inference from Theorem 19.21 of [Margaris] p. 90. (Restricted quantifier version.) (Contributed by NM, 22-Nov-1994.) Reduce dependencies on axioms. (Revised by Wolf Lammen, 4-Dec-2019.)
theorem ralrimiv {x3: setvar} (ph: wff) (ps: wff x3) (A2: class x3):
  $ wi ph (wi (wcel (cv x3) A2) ps) $ >
  $ wi ph (wral x3 ps A2) $;

--| Inference from Theorem 19.21 of [Margaris] p. 90. (Restricted quantifier version.) (Contributed by NM, 2-Jan-2006.)
theorem ralrimiva {x3: setvar} (ph: wff) (ps: wff x3) (A2: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) ps $ >
  $ wi ph (wral x3 ps A2) $;

--| Inference from Theorem 19.23 of [Margaris] p. 90 (restricted quantifier version). (Contributed by NM, 18-Dec-2006.) Shorten dependent theorems. (Revised by Wolf lammen, 23-Dec-2024.)
theorem rexlimiva {x3: setvar} (ph: wff x3) (ps: wff) (A2: class x3):
  $ wi (wa (wcel (cv x3) A2) ph) ps $ >
  $ wi (wrex x3 ph A2) ps $;

--| Inference from Theorem 19.23 of [Margaris] p. 90. (Restricted quantifier version.) (Contributed by NM, 20-Nov-1994.) Reduce dependencies on axioms. (Revised by Wolf Lammen, 14-Jan-2020.)
theorem rexlimiv {x3: setvar} (ph: wff x3) (ps: wff) (A2: class x3):
  $ wi (wcel (cv x3) A2) (wi ph ps) $ >
  $ wi (wrex x3 ph A2) ps $;

--| Deduction adding restricted existential quantifier to negated wff. (Contributed by NM, 16-Oct-2003.) (Proof shortened by Wolf Lammen, 5-Jan-2020.)
theorem nrexdv {x3: setvar} (ph: wff) (ps: wff x3) (A2: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wn ps) $ >
  $ wi ph (wn (wrex x3 ps A2)) $;

--| Inference from Theorem 19.21 of [Margaris] p. 90. (Restricted quantifier version.) (Contributed by NM, 18-Jun-2014.)
theorem ralrimivw {x3: setvar} (ph: wff) (ps: wff x3) (A2: class x3):
  $ wi ph ps $ >
  $ wi ph (wral x3 ps A2) $;

--| Weaker version of ~ rexlimiv . (Contributed by FL, 19-Sep-2011.) (Proof shortened by Wolf Lammen, 23-Dec-2024.)
theorem rexlimivw {x3: setvar} (ph: wff x3) (ps: wff) (A2: class x3):
  $ wi ph ps $ >
  $ wi (wrex x3 ph A2) ps $;

--| Inference from Theorem 19.21 of [Margaris] p. 90. (Restricted quantifier version.) (Contributed by NM, 27-May-1998.) Reduce dependencies on axioms. (Revised by Wolf Lammen, 28-Dec-2019.)
theorem ralrimdv {x3: setvar} (ph ps: wff) (ch: wff x3) (A2: class x3):
  $ wi ph (wi ps (wi (wcel (cv x3) A2) ch)) $ >
  $ wi ph (wi ps (wral x3 ch A2)) $;

--| Inference from Theorem 19.23 of [Margaris] p. 90 (restricted quantifier version). (Contributed by NM, 14-Nov-2002.) (Proof shortened by Eric Schmidt, 22-Dec-2006.) Reduce dependencies on axioms. (Revised by Wolf Lammen, 14-Jan-2020.)
theorem rexlimdv {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2: class x3):
  $ wi ph (wi (wcel (cv x3) A2) (wi ps ch)) $ >
  $ wi ph (wi (wrex x3 ps A2) ch) $;

--| Inference from Theorem 19.21 of [Margaris] p. 90. (Restricted quantifier version.) (Contributed by NM, 2-Feb-2008.) (Proof shortened by Wolf Lammen, 28-Dec-2019.)
theorem ralrimdva {x3: setvar} (ph ps: wff) (ch: wff x3) (A2: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wi ps ch) $ >
  $ wi ph (wi ps (wral x3 ch A2)) $;

--| Inference from Theorem 19.23 of [Margaris] p. 90 (restricted quantifier version). (Contributed by NM, 20-Jan-2007.)
theorem rexlimdva {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wi ps ch) $ >
  $ wi ph (wi (wrex x3 ps A2) ch) $;

--| Inference from Theorem 19.23 of [Margaris] p. 90 (restricted quantifier version). (Contributed by Mario Carneiro, 15-Jun-2016.)
theorem rexlimdvaa {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2: class x3):
  $ wi (wa ph (wa (wcel (cv x3) A2) ps)) ch $ >
  $ wi ph (wi (wrex x3 ps A2) ch) $;

--| Inference from Theorem 19.23 of [Margaris] p. 90 (restricted quantifier version). (Contributed by Glauco Siliprandi, 2-Jan-2022.)
theorem rexlimdva2 {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2: class x3):
  $ wi (wa (wa ph (wcel (cv x3) A2)) ps) ch $ >
  $ wi ph (wi (wrex x3 ps A2) ch) $;

--| A commonly used pattern in the spirit of ~ r19.29 . (Contributed by Thierry Arnoux, 29-Dec-2019.) (Proof shortened by Wolf Lammen, 17-Jun-2023.)
theorem r19_29an {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2: class x3):
  $ wi (wa (wa ph (wcel (cv x3) A2)) ps) ch $ >
  $ wi (wa ph (wrex x3 ps A2)) ch $;

--| Inference from Theorem 19.23 of [Margaris] p. 90 (restricted quantifier version). Frequently-used variant of ~ rexlimdv . (Contributed by NM, 7-Jun-2015.)
theorem rexlimdv3a {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2: class x3):
  $ wi (w3a ph (wcel (cv x3) A2) ps) ch $ >
  $ wi ph (wi (wrex x3 ps A2) ch) $;

--| Inference from Theorem 19.23 of [Margaris] p. 90 (restricted quantifier version). (Contributed by NM, 18-Jun-2014.)
theorem rexlimdvw {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2: class x3):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi (wrex x3 ps A2) ch) $;

--| Restricted existential elimination rule of natural deduction. (Contributed by Mario Carneiro, 15-Jun-2016.)
theorem rexlimddv {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2: class x3):
  $ wi ph (wrex x3 ps A2) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) ps)) ch $ >
  $ wi ph ch $;

--| A commonly used pattern in the spirit of ~ r19.29 . (Contributed by Thierry Arnoux, 22-Nov-2017.) Reduce axiom usage. (Revised by Wolf Lammen, 17-Jun-2023.)
theorem r19_29a {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2: class x3):
  $ wi (wa (wa ph (wcel (cv x3) A2)) ps) ch $ >
  $ wi ph (wrex x3 ps A2) $ >
  $ wi ph ch $;

--| Inference quantifying both antecedent and consequent. (Contributed by NM, 1-Feb-2005.)
theorem ralimdv2 {x3: setvar} (ph: wff) (ps ch: wff x3) (A2 B2: class x3):
  $ wi ph (wi (wi (wcel (cv x3) A2) ps) (wi (wcel (cv x3) B2) ch)) $ >
  $ wi ph (wi (wral x3 ps A2) (wral x3 ch B2)) $;

--| Deduction quantifying both antecedent and consequent, based on Theorem 19.22 of [Margaris] p. 90. (Contributed by NM, 17-Sep-2003.)
theorem reximdv2 {x3: setvar} (ph: wff) (ps ch: wff x3) (A2 B2: class x3):
  $ wi ph (wi (wa (wcel (cv x3) A2) ps) (wa (wcel (cv x3) B2) ch)) $ >
  $ wi ph (wi (wrex x3 ps A2) (wrex x3 ch B2)) $;

--| Deduction quantifying both antecedent and consequent, based on Theorem 19.22 of [Margaris] p. 90. (Contributed by NM, 14-Nov-2002.) Reduce dependencies on axioms. (Revised by Wolf Lammen, 8-Jan-2020.) (Proof shortened by Wolf Lammen, 4-Nov-2024.)
theorem reximdvai {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi ph (wi (wcel (cv x3) A2) (wi ps ch)) $ >
  $ wi ph (wi (wrex x3 ps A2) (wrex x3 ch A2)) $;

--| Deduction quantifying both antecedent and consequent, based on Theorem 19.20 of [Margaris] p. 90. (Contributed by NM, 22-May-1999.) Reduce dependencies on axioms. (Revised by Wolf Lammen, 5-Dec-2019.)
theorem ralimdva {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wi ps ch) $ >
  $ wi ph (wi (wral x3 ps A2) (wral x3 ch A2)) $;

--| Deduction quantifying both antecedent and consequent, based on Theorem 19.22 of [Margaris] p. 90. (Contributed by NM, 22-May-1999.)
theorem reximdva {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wi ps ch) $ >
  $ wi ph (wi (wrex x3 ps A2) (wrex x3 ch A2)) $;

--| Deduction quantifying both antecedent and consequent, based on Theorem 19.20 of [Margaris] p. 90 ( ~ alim ). (Contributed by NM, 8-Oct-2003.)
theorem ralimdv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi (wral x3 ps A2) (wral x3 ch A2)) $;

--| Deduction from Theorem 19.22 of [Margaris] p. 90. (Restricted quantifier version with strong hypothesis.) (Contributed by NM, 24-Jun-1998.)
theorem reximdv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi (wrex x3 ps A2) (wrex x3 ch A2)) $;

--| Deduction from Theorem 19.22 of [Margaris] p. 90. (Contributed by Thierry Arnoux, 7-Dec-2016.)
theorem reximddv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi (wa ph (wa (wcel (cv x3) A2) ps)) ch $ >
  $ wi ph (wrex x3 ps A2) $ >
  $ wi ph (wrex x3 ch A2) $;

--| Deduction from Theorem 19.22 of [Margaris] p. 90. (Contributed by Glauco Siliprandi, 5-Feb-2022.)
theorem reximddv3 {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi (wa (wa ph (wcel (cv x3) A2)) ps) ch $ >
  $ wi ph (wrex x3 ps A2) $ >
  $ wi ph (wrex x3 ch A2) $;

--| Derivation of a restricted existential quantification over a subset (the second hypothesis implies ` A C_ B ` ), deduction form. (Contributed by AV, 21-Aug-2022.)
theorem reximssdv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2 B2: class x3):
  $ wi ph (wrex x3 ps B2) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) ps)) (wcel (cv x3) A2) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) ps)) ch $ >
  $ wi ph (wrex x3 ch A2) $;

--| Formula-building rule for restricted universal quantifier (deduction form). (Contributed by NM, 6-Apr-1997.)
theorem ralbidv2 {x3: setvar} (ph: wff) (ps ch: wff x3) (A2 B2: class x3):
  $ wi ph (wb (wi (wcel (cv x3) A2) ps) (wi (wcel (cv x3) B2) ch)) $ >
  $ wi ph (wb (wral x3 ps A2) (wral x3 ch B2)) $;

--| Formula-building rule for restricted existential quantifier (deduction form). (Contributed by NM, 22-May-1999.)
theorem rexbidv2 {x3: setvar} (ph: wff) (ps ch: wff x3) (A2 B2: class x3):
  $ wi ph (wb (wa (wcel (cv x3) A2) ps) (wa (wcel (cv x3) B2) ch)) $ >
  $ wi ph (wb (wrex x3 ps A2) (wrex x3 ch B2)) $;

--| Formula-building rule for restricted universal quantifier (deduction form). (Contributed by NM, 4-Mar-1997.) Reduce dependencies on axioms. (Revised by Wolf Lammen, 29-Dec-2019.)
theorem ralbidva {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wral x3 ps A2) (wral x3 ch A2)) $;

--| Formula-building rule for restricted existential quantifier (deduction form). (Contributed by NM, 9-Mar-1997.) Reduce dependencies on axioms. (Revised by Wolf Lammen, 6-Dec-2019.) (Proof shortened by Wolf Lammen, 10-Dec-2019.)
theorem rexbidva {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wrex x3 ps A2) (wrex x3 ch A2)) $;

--| Formula-building rule for restricted universal quantifier (deduction form). (Contributed by NM, 20-Nov-1994.) Reduce dependencies on axioms. (Revised by Wolf Lammen, 5-Dec-2019.)
theorem ralbidv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wral x3 ps A2) (wral x3 ch A2)) $;

--| Formula-building rule for restricted existential quantifier (deduction form). (Contributed by NM, 20-Nov-1994.) Reduce dependencies on axioms. (Revised by Wolf Lammen, 6-Dec-2019.)
theorem rexbidv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wrex x3 ps A2) (wrex x3 ch A2)) $;

--| Restricted quantifier version of ~ 19.21v . (Contributed by NM, 15-Oct-2003.) (Proof shortened by Andrew Salmon, 30-May-2011.) Reduce dependencies on axioms. (Revised by Wolf Lammen, 2-Jan-2020.) (Proof shortened by Wolf Lammen, 11-Dec-2024.)
theorem r19_21v {x3: setvar} (ph: wff) (ps: wff x3) (A2: class x3):
  $ wb (wral x3 (wi ph ps) A2) (wi ph (wral x3 ps A2)) $;

--| Restricted quantifier version of one direction of ~ 19.37v . (The other direction holds iff ` A ` is nonempty, see ~ r19.37zv .) (Contributed by NM, 2-Apr-2004.) Reduce axiom usage. (Revised by Wolf Lammen, 18-Jun-2023.)
theorem r19_37v {x3: setvar} (ph: wff) (ps: wff x3) (A2: class x3):
  $ wi (wrex x3 (wi ph ps) A2) (wi ph (wrex x3 ps A2)) $;

--| Restricted quantifier version of ~ 19.23v . Version of ~ r19.23 with a disjoint variable condition. (Contributed by NM, 31-Aug-1999.) Reduce dependencies on axioms. (Revised by Wolf Lammen, 14-Jan-2020.)
theorem r19_23v {x3: setvar} (ph: wff x3) (ps: wff) (A2: class x3):
  $ wb (wral x3 (wi ph ps) A2) (wi (wrex x3 ph A2) ps) $;

--| Restricted quantifier version of one direction of ~ 19.36 . (The other direction holds iff ` A ` is nonempty, see ~ r19.36zv .) (Contributed by NM, 22-Oct-2003.)
theorem r19_36v {x3: setvar} (ph: wff x3) (ps: wff) (A2: class x3):
  $ wi (wrex x3 (wi ph ps) A2) (wi (wral x3 ph A2) ps) $;

--| Restricted quantitifer version of one direction of ~ 19.27 . (Assuming ` F/_ x A ` , the other direction holds when ` A ` is nonempty, see ~ r19.27zv .) (Contributed by NM, 3-Jun-2004.) (Proof shortened by Andrew Salmon, 30-May-2011.) (Proof shortened by Wolf Lammen, 17-Jun-2023.)
theorem r19_27v {x3: setvar} (ph: wff x3) (ps: wff) (A2: class x3):
  $ wi (wa (wral x3 ph A2) ps) (wral x3 (wa ph ps) A2) $;

--| Restricted quantifier version ~ 19.41v . Version of ~ r19.41 with a disjoint variable condition, requiring fewer axioms. (Contributed by NM, 17-Dec-2003.) Reduce dependencies on axioms. (Revised by BJ, 29-Mar-2020.)
theorem r19_41v {x3: setvar} (ph: wff x3) (ps: wff) (A2: class x3):
  $ wb (wrex x3 (wa ph ps) A2) (wa (wrex x3 ph A2) ps) $;

--| Restricted quantifier version of one direction of ~ 19.28 . (Assuming ` F/_ x A ` , the other direction holds when ` A ` is nonempty, see ~ r19.28zv .) (Contributed by NM, 2-Apr-2004.) (Proof shortened by Wolf Lammen, 17-Jun-2023.)
theorem r19_28v {x3: setvar} (ph: wff) (ps: wff x3) (A2: class x3):
  $ wi (wa ph (wral x3 ps A2)) (wral x3 (wa ph ps) A2) $;

--| Restricted quantifier version of ~ 19.42v (see also ~ 19.42 ). (Contributed by NM, 27-May-1998.)
theorem r19_42v {x3: setvar} (ph: wff) (ps: wff x3) (A2: class x3):
  $ wb (wrex x3 (wa ph ps) A2) (wa ph (wrex x3 ps A2)) $;

--| Restricted quantifier version of ~ 19.32v . (Contributed by NM, 25-Nov-2003.)
theorem r19_32v {x3: setvar} (ph: wff) (ps: wff x3) (A2: class x3):
  $ wb (wral x3 (wo ph ps) A2) (wo ph (wral x3 ps A2)) $;

--| Restricted quantifier version of one direction of ~ 19.45 . The other direction holds when ` A ` is nonempty, see ~ r19.45zv . (Contributed by NM, 2-Apr-2004.)
theorem r19_45v {x3: setvar} (ph: wff) (ps: wff x3) (A2: class x3):
  $ wi (wrex x3 (wo ph ps) A2) (wo ph (wrex x3 ps A2)) $;

--| One direction of a restricted quantifier version of ~ 19.44 . The other direction holds when ` A ` is nonempty, see ~ r19.44zv . (Contributed by NM, 2-Apr-2004.)
theorem r19_44v {x3: setvar} (ph: wff x3) (ps: wff) (A2: class x3):
  $ wi (wrex x3 (wo ph ps) A2) (wo (wrex x3 ph A2) ps) $;

--| Double restricted universal quantification. (Contributed by NM, 19-Nov-1995.) Reduce dependencies on axioms. (Revised by Wolf Lammen, 9-Jan-2020.)
theorem r2al {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wb (wral x3 (wral y1 ph B2) A2) (wal x3 (wal y1 (wi (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ph))) $;

--| Double restricted existential quantification. (Contributed by NM, 11-Nov-1995.) Reduce dependencies on axioms. (Revised by Wolf Lammen, 10-Jan-2020.)
theorem r2ex {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wb (wrex x3 (wrex y1 ph B2) A2) (wex x3 (wex y1 (wa (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ph))) $;

--| Triple restricted universal quantification. (Contributed by NM, 19-Nov-1995.) (Proof shortened by Wolf Lammen, 30-Dec-2019.)
theorem r3al {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2: class x3) (B2: class x3 y1) (C: class x3 y1 z):
  $ wb (wral x3 (wral y1 (wral z ph C) B2) A2) (wal x3 (wal y1 (wal z (wi (w3a (wcel (cv x3) A2) (wcel (cv y1) B2) (wcel (cv z) C)) ph)))) $;

--| Triple existential quantification. (Contributed by AV, 21-Jul-2025.)
theorem r3ex {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2: class x3) (B2: class x3 y1) (C: class x3 y1 z):
  $ wb (wrex x3 (wrex y1 (wrex z ph C) B2) A2) (wex x3 (wex y1 (wex z (wa (w3a (wcel (cv x3) A2) (wcel (cv y1) B2) (wcel (cv z) C)) ph)))) $;

--| Generalization rule for restricted quantification, with two quantifiers. This theorem should be used in place of ~ rgen2a since it depends on a smaller set of axioms. (Contributed by NM, 30-May-1999.)
theorem rgen2 {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wi (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ph $ >
  $ wral x3 (wral y1 ph B2) A2 $;

--| Inference from Theorem 19.21 of [Margaris] p. 90. (Restricted quantifier version with double quantification.) (Contributed by NM, 24-Jul-2004.)
theorem ralrimivv {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wi ph (wi (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ps) $ >
  $ wi ph (wral x3 (wral y1 ps B2) A2) $;

--| Inference from Theorem 19.23 of [Margaris] p. 90 (restricted quantifier version). (Contributed by NM, 17-Feb-2004.)
theorem rexlimivv {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2: class x3) (B2: class x3 y1):
  $ wi (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) (wi ph ps) $ >
  $ wi (wrex x3 (wrex y1 ph B2) A2) ps $;

--| Inference from Theorem 19.21 of [Margaris] p. 90. (Restricted quantifier version with double quantification.) (Contributed by Jeff Madsen, 19-Jun-2011.)
theorem ralrimivva {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) B2))) ps $ >
  $ wi ph (wral x3 (wral y1 ps B2) A2) $;

--| Inference from Theorem 19.21 of [Margaris] p. 90. (Restricted quantifier version with double quantification.) (Contributed by NM, 1-Jun-2005.)
theorem ralrimdvv {x3 y1: setvar} (ph ps: wff) (ch: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wi ph (wi ps (wi (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ch)) $ >
  $ wi ph (wi ps (wral x3 (wral y1 ch B2) A2)) $;

--| Generalization rule for restricted quantification, with three quantifiers. (Contributed by NM, 12-Jan-2008.)
theorem rgen3 {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2: class x3) (B2: class x3 y1) (C: class x3 y1 z):
  $ wi (w3a (wcel (cv x3) A2) (wcel (cv y1) B2) (wcel (cv z) C)) ph $ >
  $ wral x3 (wral y1 (wral z ph C) B2) A2 $;

--| Inference from Theorem 19.21 of [Margaris] p. 90. (Restricted quantifier version with triple quantification.) (Contributed by Mario Carneiro, 9-Jul-2014.)
theorem ralrimivvva {x3 y1 z: setvar} (ph: wff) (ps: wff x3 y1 z) (A2: class x3) (B2: class x3 y1) (C: class x3 y1 z):
  $ wi (wa ph (w3a (wcel (cv x3) A2) (wcel (cv y1) B2) (wcel (cv z) C))) ps $ >
  $ wi ph (wral x3 (wral y1 (wral z ps C) B2) A2) $;

--| Deduction doubly quantifying both antecedent and consequent, based on Theorem 19.20 of [Margaris] p. 90 ( ~ alim ). (Contributed by AV, 27-Nov-2019.)
theorem ralimdvva {x3 y1: setvar} (ph: wff) (ps ch: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) B2))) (wi ps ch) $ >
  $ wi ph (wi (wral x3 (wral y1 ps B2) A2) (wral x3 (wral y1 ch B2) A2)) $;

--| Deduction doubly quantifying both antecedent and consequent, based on Theorem 19.22 of [Margaris] p. 90. (Contributed by AV, 5-Jan-2022.)
theorem reximdvva {x3 y1: setvar} (ph: wff) (ps ch: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) B2))) (wi ps ch) $ >
  $ wi ph (wi (wrex x3 (wrex y1 ps B2) A2) (wrex x3 (wrex y1 ch B2) A2)) $;

--| Deduction doubly quantifying both antecedent and consequent. (Contributed by Scott Fenton, 2-Mar-2025.) Shorten and reduce DV conditions. (Revised by Eric Schmidt, 18-Nov-2025.)
theorem ralimdvv {x3 y1: setvar} (ph: wff) (ps ch: wff x3 y1) (A2 B2: class x3 y1):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi (wral x3 (wral y1 ps B2) A2) (wral x3 (wral y1 ch B2) A2)) $;

--| Obsolete version of ~ ralimdvv as of 18-Nov-2025. (Contributed by Scott Fenton, 2-Mar-2025.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem ralimdvvOLD {x3 y1: setvar} (ph: wff) (ps ch: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi (wral x3 (wral y1 ps B2) A2) (wral x3 (wral y1 ch B2) A2)) $;

--| Deduction quadrupally quantifying both antecedent and consequent. (Contributed by Scott Fenton, 2-Mar-2025.) Reduce DV conditions. (Revised by Eric Schmidt, 18-Nov-2025.)
theorem ralimd4v {x3 y1 z w: setvar} (ph: wff) (ps ch: wff x3 y1 z w) (A2 B2 C D: class x3 y1 z w):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi (wral x3 (wral y1 (wral z (wral w ps D) C) B2) A2) (wral x3 (wral y1 (wral z (wral w ch D) C) B2) A2)) $;

--| Obsolete version of ~ ralimd4v as of 18-Nov-2025. (Contributed by Scott Fenton, 2-Mar-2025.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem ralimd4vOLD {x3 y1 z w: setvar} (ph: wff) (ps ch: wff x3 y1 z w) (A2: class x3) (B2: class x3 y1) (C: class x3 y1 z) (D: class x3 y1 z w):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi (wral x3 (wral y1 (wral z (wral w ps D) C) B2) A2) (wral x3 (wral y1 (wral z (wral w ch D) C) B2) A2)) $;

--| Deduction sextupally quantifying both antecedent and consequent. (Contributed by Scott Fenton, 5-Mar-2025.) Reduce DV conditions. (Revised by Eric Schmidt, 18-Nov-2025.)
theorem ralimd6v {x3 y1 z w q p: setvar} (ph: wff) (ps ch: wff x3 y1 z w q p) (A2 B2 C D E F: class x3 y1 z w q p):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi (wral x3 (wral y1 (wral z (wral w (wral p (wral q ps F) E) D) C) B2) A2) (wral x3 (wral y1 (wral z (wral w (wral p (wral q ch F) E) D) C) B2) A2)) $;

--| Obsolete version of ~ ralimdvv as of 18-Nov-2025. (Contributed by Scott Fenton, 2-Mar-2025.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem ralimd6vOLD {x3 y1 z w q p: setvar} (ph: wff) (ps ch: wff x3 y1 z w q p) (A2: class x3 q p) (B2: class x3 y1 q p) (C: class x3 y1 z q p) (D: class x3 y1 z w q p) (E: class x3 y1 z w p) (F: class x3 y1 z w q p):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi (wral x3 (wral y1 (wral z (wral w (wral p (wral q ps F) E) D) C) B2) A2) (wral x3 (wral y1 (wral z (wral w (wral p (wral q ch F) E) D) C) B2) A2)) $;

--| Inference from Theorem 19.21 of [Margaris] p. 90. (Restricted quantifier version with double quantification.) (Contributed by NM, 2-Feb-2008.)
theorem ralrimdvva {x3 y1: setvar} (ph ps: wff) (ch: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) B2))) (wi ps ch) $ >
  $ wi ph (wi ps (wral x3 (wral y1 ch B2) A2)) $;

--| Inference from Theorem 19.23 of [Margaris] p. 90. (Restricted quantifier version.) (Contributed by NM, 22-Jul-2004.)
theorem rexlimdvv {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (ch: wff) (A2: class x3) (B2: class x3 y1):
  $ wi ph (wi (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) (wi ps ch)) $ >
  $ wi ph (wi (wrex x3 (wrex y1 ps B2) A2) ch) $;

--| Inference from Theorem 19.23 of [Margaris] p. 90. (Restricted quantifier version.) (Contributed by NM, 18-Jun-2014.)
theorem rexlimdvva {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (ch: wff) (A2: class x3) (B2: class x3 y1):
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) B2))) (wi ps ch) $ >
  $ wi ph (wi (wrex x3 (wrex y1 ps B2) A2) ch) $;

--| Inference from Theorem 19.23 of [Margaris] p. 90, for three restricted quantifiers. (Contributed by AV, 23-Aug-2025.)
theorem rexlimdvvva {x3 y1 z: setvar} (ph: wff) (ps: wff x3 y1 z) (ch: wff) (A2: class x3) (B2: class x3 y1) (C: class x3 y1 z):
  $ wi (wa ph (w3a (wcel (cv x3) A2) (wcel (cv y1) B2) (wcel (cv z) C))) (wi ps ch) $ >
  $ wi ph (wi (wrex x3 (wrex y1 (wrex z ps C) B2) A2) ch) $;

--| Double deduction from Theorem 19.22 of [Margaris] p. 90. (Contributed by Thierry Arnoux, 15-Dec-2019.)
theorem reximddv2 {x3 y1: setvar} (ph: wff) (ps ch: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wi (wa (wa (wa ph (wcel (cv x3) A2)) (wcel (cv y1) B2)) ps) ch $ >
  $ wi ph (wrex x3 (wrex y1 ps B2) A2) $ >
  $ wi ph (wrex x3 (wrex y1 ch B2) A2) $;

--| A commonly used pattern based on ~ r19.29 , version with two restricted quantifiers. (Contributed by Thierry Arnoux, 26-Nov-2017.) (Proof shortened by Wolf Lammen, 4-Nov-2024.)
theorem r19_29vva {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (ch: wff) (A2: class x3) (B2: class x3 y1):
  $ wi (wa (wa (wa ph (wcel (cv x3) A2)) (wcel (cv y1) B2)) ps) ch $ >
  $ wi ph (wrex x3 (wrex y1 ps B2) A2) $ >
  $ wi ph ch $;

--| Inference adding two restricted existential quantifiers to both sides of an equivalence. (Contributed by NM, 1-Aug-2004.)
theorem _2rexbiia {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wi (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) (wb ph ps) $ >
  $ wb (wrex x3 (wrex y1 ph B2) A2) (wrex x3 (wrex y1 ps B2) A2) $;

--| Formula-building rule for restricted universal quantifiers (deduction form). (Contributed by NM, 4-Mar-1997.) Reduce dependencies on axioms. (Revised by Wolf Lammen, 9-Dec-2019.)
theorem _2ralbidva {x3 y1: setvar} (ph: wff) (ps ch: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) B2))) (wb ps ch) $ >
  $ wi ph (wb (wral x3 (wral y1 ps B2) A2) (wral x3 (wral y1 ch B2) A2)) $;

--| Formula-building rule for restricted existential quantifiers (deduction form). (Contributed by NM, 15-Dec-2004.)
theorem _2rexbidva {x3 y1: setvar} (ph: wff) (ps ch: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) B2))) (wb ps ch) $ >
  $ wi ph (wb (wrex x3 (wrex y1 ps B2) A2) (wrex x3 (wrex y1 ch B2) A2)) $;

--| Formula-building rule for restricted universal quantifiers (deduction form). (Contributed by NM, 28-Jan-2006.) (Revised by Szymon Jaroszewicz, 16-Mar-2007.)
theorem _2ralbidv {x3 y1: setvar} (ph: wff) (ps ch: wff x3 y1) (A2 B2: class x3 y1):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wral x3 (wral y1 ps B2) A2) (wral x3 (wral y1 ch B2) A2)) $;

--| Formula-building rule for restricted existential quantifiers (deduction form). (Contributed by NM, 28-Jan-2006.)
theorem _2rexbidv {x3 y1: setvar} (ph: wff) (ps ch: wff x3 y1) (A2 B2: class x3 y1):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wrex x3 (wrex y1 ps B2) A2) (wrex x3 (wrex y1 ch B2) A2)) $;

--| Formula-building rule for restricted quantifiers (deduction form). (Contributed by NM, 28-Jan-2006.)
theorem rexralbidv {x3 y1: setvar} (ph: wff) (ps ch: wff x3 y1) (A2 B2: class x3 y1):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wrex x3 (wral y1 ps B2) A2) (wrex x3 (wral y1 ch B2) A2)) $;

--| Formula-building rule for restricted universal quantifiers (deduction form.) (Contributed by Scott Fenton, 20-Feb-2025.)
theorem _3ralbidv {x3 y1 z: setvar} (ph: wff) (ps ch: wff x3 y1 z) (A2 B2 C: class x3 y1 z):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wral x3 (wral y1 (wral z ps C) B2) A2) (wral x3 (wral y1 (wral z ch C) B2) A2)) $;

--| Formula-building rule for restricted universal quantifiers (deduction form.) (Contributed by Scott Fenton, 20-Feb-2025.)
theorem _4ralbidv {x3 y1 z w: setvar} (ph: wff) (ps ch: wff x3 y1 z w) (A2 B2 C D: class x3 y1 z w):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wral x3 (wral y1 (wral z (wral w ps D) C) B2) A2) (wral x3 (wral y1 (wral z (wral w ch D) C) B2) A2)) $;

--| Formula-building rule for restricted universal quantifiers (deduction form.) (Contributed by Scott Fenton, 5-Mar-2025.)
theorem _6ralbidv {x3 y1 z w u t: setvar} (ph: wff) (ps ch: wff x3 y1 z w u t) (A2 B2 C D E F: class x3 y1 z w u t):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wral x3 (wral y1 (wral z (wral w (wral t (wral u ps F) E) D) C) B2) A2) (wral x3 (wral y1 (wral z (wral w (wral t (wral u ch F) E) D) C) B2) A2)) $;

--| Version of ~ r19.41v with two quantifiers. (Contributed by Thierry Arnoux, 25-Jan-2017.)
theorem r19_41vv {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2 B2: class x3 y1):
  $ wb (wrex x3 (wrex y1 (wa ph ps) B2) A2) (wa (wrex x3 (wrex y1 ph B2) A2) ps) $;

--| Lemma factoring out common proof steps of ~ reeanv and ~ reean . (Contributed by Wolf Lammen, 20-Aug-2023.)
theorem reeanlem {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wb (wex x3 (wex y1 (wa (wa (wcel (cv x3) A2) ph) (wa (wcel (cv y1) B2) ps)))) (wa (wex x3 (wa (wcel (cv x3) A2) ph)) (wex y1 (wa (wcel (cv y1) B2) ps))) $ >
  $ wb (wrex x3 (wrex y1 (wa ph ps) B2) A2) (wa (wrex x3 ph A2) (wrex y1 ps B2)) $;

--| Rearrange restricted existential quantifiers. (Contributed by NM, 9-May-1999.)
theorem reeanv {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class x3) (B2: class y1):
  $ wb (wrex x3 (wrex y1 (wa ph ps) B2) A2) (wa (wrex x3 ph A2) (wrex y1 ps B2)) $;

--| Rearrange three restricted existential quantifiers. (Contributed by Jeff Madsen, 11-Jun-2010.)
theorem _3reeanv {x3 y1 z: setvar} (ph: wff x3) (ps: wff y1) (ch: wff z) (A2: class x3 z) (B2: class y1) (C: class z):
  $ wb (wrex x3 (wrex y1 (wrex z (w3a ph ps ch) C) B2) A2) (w3a (wrex x3 ph A2) (wrex y1 ps B2) (wrex z ch C)) $;

--| Distribute restricted universal quantification over "or". (Contributed by Jeff Madsen, 19-Jun-2010.) Shorten, reduce dv conditions. (Revised by Wolf Lammen, 20-Nov-2024.)
theorem _2ralor {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class x3 y1) (B2: class y1):
  $ wb (wral x3 (wral y1 (wo ph ps) B2) A2) (wo (wral x3 ph A2) (wral y1 ps B2)) $;

--| Two ways to say " ` A ` belongs to ` B ` ". (Contributed by NM, 22-Nov-1994.)
theorem risset {x3: setvar} (A2 B2: class):
  $ wb (wcel A2 B2) (wrex x3 (wceq (cv x3) A2) B2) $;

--| A definition of ` -. A e. B ` . (Contributed by Thierry Arnoux, 20-Nov-2023.) (Proof shortened by SN, 23-Jan-2024.) (Proof shortened by Wolf Lammen, 3-Nov-2024.)
theorem nelb {x3: setvar} (A2 B2: class):
  $ wb (wn (wcel A2 B2)) (wral x3 (wne (cv x3) A2) B2) $;

--| Restricted specialization. Weak version of ~ rsp , requiring ~ ax-8 , but not ~ ax-12 . (Contributed by GG, 3-Oct-2024.)
theorem rspw {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wral x3 ph A2) (wi (wcel (cv x3) A2) ph) $;

--| Change the bound variable of a restricted universal quantifier using implicit substitution. Version of ~ cbvralv with a disjoint variable condition, which does not require ~ ax-10 , ~ ax-11 , ~ ax-12 , ~ ax-13 . (Contributed by NM, 28-Jan-1997.) Avoid ~ ax-13 . (Revised by GG, 10-Jan-2024.)
theorem cbvralvw {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wral x3 ph A2) (wral y1 ps A2) $;

--| Change the bound variable of a restricted existential quantifier using implicit substitution. Version of ~ cbvrexv with a disjoint variable condition, which does not require ~ ax-10 , ~ ax-11 , ~ ax-12 , ~ ax-13 . (Contributed by NM, 2-Jun-1998.) Avoid ~ ax-13 . (Revised by GG, 10-Jan-2024.)
theorem cbvrexvw {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wrex x3 ph A2) (wrex y1 ps A2) $;

--| Rule used to change the bound variable in a restricted universal quantifier with implicit substitution. Deduction form. (Contributed by David Moews, 1-May-2017.) Avoid ~ ax-9 , ~ ax-ext . (Revised by Wolf Lammen, 9-Mar-2025.)
theorem cbvraldva {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (A2: class):
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wb ps ch) $ >
  $ wi ph (wb (wral x3 ps A2) (wral y1 ch A2)) $;

--| Rule used to change the bound variable in a restricted existential quantifier with implicit substitution. Deduction form. (Contributed by David Moews, 1-May-2017.) Avoid ~ ax-9 , ~ ax-ext . (Revised by Wolf Lammen, 9-Mar-2025.)
theorem cbvrexdva {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (A2: class):
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wb ps ch) $ >
  $ wi ph (wb (wrex x3 ps A2) (wrex y1 ch A2)) $;

--| Change bound variables of double restricted universal quantification, using implicit substitution. Version of ~ cbvral2v with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by NM, 10-Aug-2004.) Avoid ~ ax-13 . (Revised by GG, 10-Jan-2024.)
theorem cbvral2vw {x3 y1 z w: setvar} (ph: wff x3 y1 w) (ps: wff x3 z w) (ch: wff y1 z) (A2: class y1 w) (B2: class):
  $ wi (wceq (cv x3) (cv z)) (wb ph ch) $ >
  $ wi (wceq (cv y1) (cv w)) (wb ch ps) $ >
  $ wb (wral x3 (wral y1 ph B2) A2) (wral z (wral w ps B2) A2) $;

--| Change bound variables of double restricted universal quantification, using implicit substitution. Version of ~ cbvral2v with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by NM, 10-Aug-2004.) Avoid ~ ax-13 . (Revised by GG, 10-Jan-2024.)
theorem cbvral2vw_b {x3 y1 z: setvar} (ph: wff x3 y1) (ps: wff x3 z) (ch: wff y1 z) (A2: class y1) (B2: class):
  $ wi (wceq (cv x3) (cv z)) (wb ph ch) $ >
  $ wi (wceq (cv y1) (cv x3)) (wb ch ps) $ >
  $ wb (wral x3 (wral y1 ph B2) A2) (wral z (wral x3 ps B2) A2) $;

--| Change bound variables of double restricted universal quantification, using implicit substitution. Version of ~ cbvrex2v with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by FL, 2-Jul-2012.) Avoid ~ ax-13 . (Revised by GG, 10-Jan-2024.)
theorem cbvrex2vw {x3 y1 z w: setvar} (ph: wff x3 y1 w) (ps: wff x3 z w) (ch: wff y1 z) (A2: class y1 w) (B2: class):
  $ wi (wceq (cv x3) (cv z)) (wb ph ch) $ >
  $ wi (wceq (cv y1) (cv w)) (wb ch ps) $ >
  $ wb (wrex x3 (wrex y1 ph B2) A2) (wrex z (wrex w ps B2) A2) $;

--| Change bound variables of triple restricted universal quantification, using implicit substitution. Version of ~ cbvral3v with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by NM, 10-May-2005.) Avoid ~ ax-13 . (Revised by GG, 10-Jan-2024.)
theorem cbvral3vw {x3 y1 z w v u: setvar} (ph: wff x3 y1 z v u) (ps: wff x3 y1 w v u) (ch: wff y1 z w u) (th: wff x3 z w v) (A2: class y1 z v u) (B2: class z u) (C: class):
  $ wi (wceq (cv x3) (cv w)) (wb ph ch) $ >
  $ wi (wceq (cv y1) (cv v)) (wb ch th) $ >
  $ wi (wceq (cv z) (cv u)) (wb th ps) $ >
  $ wb (wral x3 (wral y1 (wral z ph C) B2) A2) (wral w (wral v (wral u ps C) B2) A2) $;

--| Change bound variables of quadruple restricted universal quantification, using implicit substitution. (Contributed by Scott Fenton, 2-Mar-2025.)
theorem cbvral4vw {x3 y1 z w a b c d: setvar} (ph: wff x3 y1 z w b c d) (ps: wff x3 y1 z a b c d) (ch: wff y1 z w a c d) (th: wff x3 z w a b d) (ta: wff x3 y1 w a b c) (A2: class y1 z w b c d) (B2: class z w c d) (C: class w d) (D: class):
  $ wi (wceq (cv x3) (cv a)) (wb ph ch) $ >
  $ wi (wceq (cv y1) (cv b)) (wb ch th) $ >
  $ wi (wceq (cv z) (cv c)) (wb th ta) $ >
  $ wi (wceq (cv w) (cv d)) (wb ta ps) $ >
  $ wb (wral x3 (wral y1 (wral z (wral w ph D) C) B2) A2) (wral a (wral b (wral c (wral d ps D) C) B2) A2) $;

--| Change bound variables of sextuple restricted universal quantification, using implicit substitution. (Contributed by Scott Fenton, 5-Mar-2025.)
theorem cbvral6vw {x3 y1 z w e f2 q p a b c d: setvar} (ph: wff x3 y1 z w e f2 q p b c d) (ps: wff x3 y1 z w e f2 p a b c d) (ch: wff y1 z w e f2 q p a c d) (th: wff x3 z w e f2 q p a b d) (ta: wff x3 y1 w e f2 q p a b c) (et: wff x3 y1 z f2 q p a b c d) (ze: wff x3 y1 z w e q a b c d) (A2: class y1 z w e f2 q p b c d) (B2: class z w e f2 q p c d) (C: class w e f2 q p d) (D: class e f2 q p) (E: class f2 q) (F: class):
  $ wi (wceq (cv x3) (cv a)) (wb ph ch) $ >
  $ wi (wceq (cv y1) (cv b)) (wb ch th) $ >
  $ wi (wceq (cv z) (cv c)) (wb th ta) $ >
  $ wi (wceq (cv w) (cv d)) (wb ta et) $ >
  $ wi (wceq (cv p) (cv e)) (wb et ze) $ >
  $ wi (wceq (cv q) (cv f2)) (wb ze ps) $ >
  $ wb (wral x3 (wral y1 (wral z (wral w (wral p (wral q ph F) E) D) C) B2) A2) (wral a (wral b (wral c (wral d (wral e (wral f2 ps F) E) D) C) B2) A2) $;

--| Change bound variables of octuple restricted universal quantification, using implicit substitution. (Contributed by Scott Fenton, 2-Mar-2025.)
theorem cbvral8vw {x3 y1 z w e f2 g2 h s1 r q p a b c d: setvar} (ph: wff x3 y1 z w e f2 g2 h s1 r q p b c d) (ps: wff x3 y1 z w e f2 g2 h r q p a b c d) (ch: wff y1 z w e f2 g2 h s1 r q p a c d) (th: wff x3 z w e f2 g2 h s1 r q p a b d) (ta: wff x3 y1 w e f2 g2 h s1 r q p a b c) (et: wff x3 y1 z f2 g2 h s1 r q p a b c d) (ze: wff x3 y1 z w e g2 h s1 r q a b c d) (si: wff x3 y1 z w e f2 h s1 r p a b c d) (rh: wff x3 y1 z w e f2 g2 s1 q p a b c d) (A2: class y1 z w e f2 g2 h s1 r q p b c d) (B2: class z w e f2 g2 h s1 r q p c d) (C: class w e f2 g2 h s1 r q p d) (D: class e f2 g2 h s1 r q p) (E: class f2 g2 h s1 r q) (F: class g2 h s1 r) (G: class h s1) (H: class):
  $ wi (wceq (cv x3) (cv a)) (wb ph ch) $ >
  $ wi (wceq (cv y1) (cv b)) (wb ch th) $ >
  $ wi (wceq (cv z) (cv c)) (wb th ta) $ >
  $ wi (wceq (cv w) (cv d)) (wb ta et) $ >
  $ wi (wceq (cv p) (cv e)) (wb et ze) $ >
  $ wi (wceq (cv q) (cv f2)) (wb ze si) $ >
  $ wi (wceq (cv r) (cv g2)) (wb si rh) $ >
  $ wi (wceq (cv s1) (cv h)) (wb rh ps) $ >
  $ wb (wral x3 (wral y1 (wral z (wral w (wral p (wral q (wral r (wral s1 ph H) G) F) E) D) C) B2) A2) (wral a (wral b (wral c (wral d (wral e (wral f2 (wral g2 (wral h ps H) G) F) E) D) C) B2) A2) $;

--| Restricted specialization. (Contributed by NM, 17-Oct-1996.)
theorem rsp {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wral x3 ph A2) (wi (wcel (cv x3) A2) ph) $;

--| Restricted specialization. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem rspa {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wa (wral x3 ph A2) (wcel (cv x3) A2)) ph $;

--| Restricted specialization. (Contributed by NM, 12-Oct-1999.)
theorem rspe {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wa (wcel (cv x3) A2) ph) (wrex x3 ph A2) $;

--| Specialization rule for restricted quantification. (Contributed by NM, 19-Nov-1994.)
theorem rspec {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wral x3 ph A2 $ >
  $ wi (wcel (cv x3) A2) ph $;

--| Inference from Theorem 19.21 of [Margaris] p. 90. (Restricted quantifier version.) (Contributed by NM, 20-Nov-1994.) (Proof shortened by Wolf Lammen, 11-Jun-2023.)
theorem r19_21bi {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi ph (wral x3 ps A2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) ps $;

--| Inference from Theorem 19.21 of [Margaris] p. 90. (Restricted quantifier version.) (Contributed by NM, 21-Nov-1994.)
theorem r19_21be {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi ph (wral x3 ps A2) $ >
  $ wral x3 (wi ph ps) A2 $;

--| Restricted quantifier version of ~ 19.21t ; closed form of ~ r19.21 . (Contributed by NM, 1-Mar-2008.) (Proof shortened by Wolf Lammen, 2-Jan-2020.)
theorem r19_21t {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wnf x3 ph) (wb (wral x3 (wi ph ps) A2) (wi ph (wral x3 ps A2))) $;

--| Restricted quantifier version of ~ 19.21 . (Contributed by Scott Fenton, 30-Mar-2011.)
theorem r19_21 {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wb (wral x3 (wi ph ps) A2) (wi ph (wral x3 ps A2)) $;

--| Closed theorem form of ~ r19.23 . (Contributed by NM, 4-Mar-2013.) (Revised by Mario Carneiro, 8-Oct-2016.)
theorem r19_23t {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wnf x3 ps) (wb (wral x3 (wi ph ps) A2) (wi (wrex x3 ph A2) ps)) $;

--| Restricted quantifier version of ~ 19.23 . See ~ r19.23v for a version requiring fewer axioms. (Contributed by NM, 22-Oct-2010.) (Proof shortened by Mario Carneiro, 8-Oct-2016.)
theorem r19_23 {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wnf x3 ps $ >
  $ wb (wral x3 (wi ph ps) A2) (wi (wrex x3 ph A2) ps) $;

--| Inference from Theorem 19.21 of [Margaris] p. 90 (restricted quantifier version). For a version based on fewer axioms see ~ ralrimiv . (Contributed by NM, 10-Oct-1999.) Shortened after introduction of ~ hbralrimi . (Revised by Wolf Lammen, 4-Dec-2019.)
theorem ralrimi {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wi (wcel (cv x3) A2) ps) $ >
  $ wi ph (wral x3 ps A2) $;

--| Inference from Theorem 19.21 of [Margaris] p. 90 (restricted quantifier version). (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem ralrimia {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wi (wa ph (wcel (cv x3) A2)) ps $ >
  $ wi ph (wral x3 ps A2) $;

--| Restricted quantifier version of ~ exlimi . For a version based on fewer axioms see ~ rexlimiv . (Contributed by NM, 30-Nov-2003.) (Proof shortened by Andrew Salmon, 30-May-2011.)
theorem rexlimi {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wnf x3 ps $ >
  $ wi (wcel (cv x3) A2) (wi ph ps) $ >
  $ wi (wrex x3 ph A2) ps $;

--| Deduction quantifying both antecedent and consequent, based on Theorem 19.20 of [Margaris] p. 90. (Contributed by NM, 22-Sep-2003.) (Proof shortened by Wolf Lammen, 29-Dec-2019.)
theorem ralimdaa {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wi ps ch) $ >
  $ wi ph (wi (wral x3 ps A2) (wral x3 ch A2)) $;

--| Deduction from Theorem 19.22 of [Margaris] p. 90. (Restricted quantifier version.) (Contributed by NM, 31-Aug-1999.)
theorem reximdai {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wi (wcel (cv x3) A2) (wi ps ch)) $ >
  $ wi ph (wi (wrex x3 ps A2) (wrex x3 ch A2)) $;

--| Restricted quantifier version of one direction of ~ 19.37 . (The other direction does not hold when ` A ` is empty.) (Contributed by FL, 13-May-2012.) (Revised by Mario Carneiro, 11-Dec-2016.)
theorem r19_37 {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wi (wrex x3 (wi ph ps) A2) (wi ph (wrex x3 ps A2)) $;

--| Restricted quantifier version of ~ 19.41 . See ~ r19.41v for a version with a disjoint variable condition, requiring fewer axioms. (Contributed by NM, 1-Nov-2010.)
theorem r19_41 {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wnf x3 ps $ >
  $ wb (wrex x3 (wa ph ps) A2) (wa (wrex x3 ph A2) ps) $;

--| Inference from Theorem 19.21 of [Margaris] p. 90. (Restricted quantifier version.) For a version based on fewer axioms see ~ ralrimdv . (Contributed by NM, 16-Feb-2004.)
theorem ralrimd {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wnf x3 ps $ >
  $ wi ph (wi ps (wi (wcel (cv x3) A2) ch)) $ >
  $ wi ph (wi ps (wral x3 ch A2)) $;

--| Version of ~ rexlimd with deduction version of second hypothesis. (Contributed by NM, 21-Jul-2013.) (Revised by Mario Carneiro, 8-Oct-2016.)
theorem rexlimd2 {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wnf x3 ch) $ >
  $ wi ph (wi (wcel (cv x3) A2) (wi ps ch)) $ >
  $ wi ph (wi (wrex x3 ps A2) ch) $;

--| Deduction form of ~ rexlimd . For a version based on fewer axioms see ~ rexlimdv . (Contributed by NM, 27-May-1998.) (Proof shortened by Andrew Salmon, 30-May-2011.) (Proof shortened by Wolf Lammen, 14-Jan-2020.)
theorem rexlimd {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wnf x3 ch $ >
  $ wi ph (wi (wcel (cv x3) A2) (wi ps ch)) $ >
  $ wi ph (wi (wrex x3 ps A2) ch) $;

--| A commonly used pattern based on ~ r19.29 . (Contributed by Thierry Arnoux, 17-Dec-2017.) (Proof shortened by OpenAI, 25-Mar-2020.)
theorem r19_29af2 {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wnf x3 ch $ >
  $ wi (wa (wa ph (wcel (cv x3) A2)) ps) ch $ >
  $ wi ph (wrex x3 ps A2) $ >
  $ wi ph ch $;

--| A commonly used pattern based on ~ r19.29 . See ~ r19.29a , ~ r19.29an for a variant when ` x ` is disjoint from ` ph ` . (Contributed by Thierry Arnoux, 29-Nov-2017.)
theorem r19_29af {x3: setvar} (ph ps: wff x3) (ch: wff) (A2: class x3):
  $ wnf x3 ph $ >
  $ wi (wa (wa ph (wcel (cv x3) A2)) ps) ch $ >
  $ wi ph (wrex x3 ps A2) $ >
  $ wi ph ch $;

--| Deduction quantifying both antecedent and consequent, based on Theorem 19.22 of [Margaris] p. 90. (Contributed by Thierry Arnoux, 27-Jan-2020.)
theorem reximd2a {x3: setvar} (ph ps ch: wff x3) (A2 B2: class x3):
  $ wnf x3 ph $ >
  $ wi (wa (wa ph (wcel (cv x3) A2)) ps) (wcel (cv x3) B2) $ >
  $ wi (wa (wa ph (wcel (cv x3) A2)) ps) ch $ >
  $ wi ph (wrex x3 ps A2) $ >
  $ wi ph (wrex x3 ch B2) $;

--| Formula-building rule for restricted universal quantifier (deduction form). (Contributed by NM, 6-Oct-2003.) (Proof shortened by Wolf Lammen, 31-Oct-2024.)
theorem ralbida {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wral x3 ps A2) (wral x3 ch A2)) $;

--| Formula-building rule for restricted existential quantifier (deduction form). (Contributed by NM, 6-Oct-2003.)
theorem rexbida {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wrex x3 ps A2) (wrex x3 ch A2)) $;

--| Formula-building rule for restricted universal quantifier (deduction form). For a version based on fewer axioms see ~ ralbidv . (Contributed by NM, 27-Jun-1998.)
theorem ralbid {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wral x3 ps A2) (wral x3 ch A2)) $;

--| Formula-building rule for restricted existential quantifier (deduction form). For a version based on fewer axioms see ~ rexbidv . (Contributed by NM, 27-Jun-1998.)
theorem rexbid {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wrex x3 ps A2) (wrex x3 ch A2)) $;

--| Alternate proof of ~ rexbidv , shorter but requires more axioms. (Contributed by NM, 20-Nov-1994.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rexbidvALT {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wrex x3 ps A2) (wrex x3 ch A2)) $;

--| Alternate proof of ~ rexbidva , shorter but requires more axioms. (Contributed by NM, 9-Mar-1997.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rexbidvaALT {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wrex x3 ps A2) (wrex x3 ch A2)) $;

--| Restricted specialization, with two quantifiers. (Contributed by NM, 11-Feb-1997.)
theorem rsp2 {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ wi (wral x3 (wral y1 ph B2) A2) (wi (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ph) $;

--| Restricted specialization. (Contributed by FL, 4-Jun-2012.) (Proof shortened by Wolf Lammen, 7-Jan-2020.)
theorem rsp2e {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ wi (w3a (wcel (cv x3) A2) (wcel (cv y1) B2) ph) (wrex x3 (wrex y1 ph B2) A2) $;

--| Specialization rule for restricted quantification, with two quantifiers. (Contributed by NM, 20-Nov-1994.)
theorem rspec2 {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ wral x3 (wral y1 ph B2) A2 $ >
  $ wi (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ph $;

--| Specialization rule for restricted quantification, with three quantifiers. (Contributed by NM, 20-Nov-1994.)
theorem rspec3 {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2 B2 C: class x3 y1 z):
  $ wral x3 (wral y1 (wral z ph C) B2) A2 $ >
  $ wi (w3a (wcel (cv x3) A2) (wcel (cv y1) B2) (wcel (cv z) C)) ph $;

--| Double restricted universal quantification. For a version based on fewer axioms see ~ r2al . (Contributed by Mario Carneiro, 14-Oct-2016.) Use ~ r2allem . (Revised by Wolf Lammen, 9-Jan-2020.)
theorem r2alf {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wb (wral x3 (wral y1 ph B2) A2) (wal x3 (wal y1 (wi (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ph))) $;

--| Double restricted existential quantification. For a version based on fewer axioms see ~ r2ex . (Contributed by Mario Carneiro, 14-Oct-2016.) Use ~ r2exlem . (Revised by Wolf Lammen, 10-Jan-2020.)
theorem r2exf {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wb (wrex x3 (wrex y1 ph B2) A2) (wex x3 (wex y1 (wa (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ph))) $;

--| Formula-building rule for restricted universal quantifier (deduction form). (Contributed by NM, 24-Feb-2004.)
theorem _2ralbida {x3 y1: setvar} (ph ps ch: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) B2))) (wb ps ch) $ >
  $ wi ph (wb (wral x3 (wral y1 ps B2) A2) (wral x3 (wral y1 ch B2) A2)) $;

--| The setvar ` x ` is not free in ` A. x e. A ph ` . (Contributed by NM, 18-Oct-1996.) (Revised by Mario Carneiro, 7-Oct-2016.)
theorem nfra1 {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wnf x3 (wral x3 ph A2) $;

--| The setvar ` x ` is not free in ` E. x e. A ph ` . (Contributed by NM, 19-Mar-1997.) (Revised by Mario Carneiro, 7-Oct-2016.)
theorem nfre1 {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wnf x3 (wrex x3 ph A2) $;

--| Commutation of restricted and unrestricted universal quantifiers. (Contributed by NM, 26-Mar-2004.) (Proof shortened by Andrew Salmon, 8-Jun-2011.) Reduce axiom dependencies. (Revised by BJ, 13-Jun-2019.) (Proof shortened by Wolf Lammen, 31-Oct-2024.)
theorem ralcom4 {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3):
  $ wb (wral x3 (wal y1 ph) A2) (wal y1 (wral x3 ph A2)) $;

--| Commutation of restricted and unrestricted existential quantifiers. (Contributed by NM, 12-Apr-2004.) (Proof shortened by Andrew Salmon, 8-Jun-2011.) Reduce axiom dependencies. (Revised by BJ, 13-Jun-2019.)
theorem rexcom4 {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3):
  $ wb (wrex x3 (wex y1 ph) A2) (wex y1 (wrex x3 ph A2)) $;

--| Commutation of restricted universal quantifiers. See ~ ralcom2 for a version without disjoint variable condition on ` x , y ` . This theorem should be used in place of ~ ralcom2 since it depends on a smaller set of axioms. (Contributed by NM, 13-Oct-1999.) (Revised by Mario Carneiro, 14-Oct-2016.)
theorem ralcom {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class y1):
  $ wb (wral x3 (wral y1 ph B2) A2) (wral y1 (wral x3 ph A2) B2) $;

--| Commutation of restricted existential quantifiers. (Contributed by NM, 19-Nov-1995.) (Revised by Mario Carneiro, 14-Oct-2016.) (Proof shortened by BJ, 26-Aug-2023.) (Proof shortened by Wolf Lammen, 8-Dec-2024.)
theorem rexcom {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class y1):
  $ wb (wrex x3 (wrex y1 ph B2) A2) (wrex y1 (wrex x3 ph A2) B2) $;

--| Specialized existential commutation lemma. (Contributed by Jeff Madsen, 1-Jun-2011.)
theorem rexcom4a {x3 y1: setvar} (ph: wff y1) (ps: wff x3 y1) (A2: class y1):
  $ wb (wex x3 (wrex y1 (wa ph ps) A2)) (wrex y1 (wa ph (wex x3 ps)) A2) $;

--| Rotate three restricted universal quantifiers. (Contributed by AV, 3-Dec-2021.)
theorem ralrot3 {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2 B2: class x3 y1) (C: class z):
  $ wb (wral x3 (wral y1 (wral z ph C) B2) A2) (wral z (wral x3 (wral y1 ph B2) A2) C) $;

--| Swap first and third restricted universal quantifiers. (Contributed by AV, 3-Dec-2021.) (Proof shortened by Wolf Lammen, 2-Jan-2025.)
theorem ralcom13 {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2: class x3) (B2: class y1) (C: class z):
  $ wb (wral x3 (wral y1 (wral z ph C) B2) A2) (wral z (wral y1 (wral x3 ph A2) B2) C) $;

--| Swap first and third restricted existential quantifiers. (Contributed by NM, 8-Apr-2015.)
theorem rexcom13 {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2: class x3) (B2: class y1) (C: class z):
  $ wb (wrex x3 (wrex y1 (wrex z ph C) B2) A2) (wrex z (wrex y1 (wrex x3 ph A2) B2) C) $;

--| Rotate four restricted existential quantifiers twice. (Contributed by NM, 8-Apr-2015.)
theorem rexrot4 {x3 y1 z w: setvar} (ph: wff x3 y1 z w) (A2 B2: class x3 y1) (C: class z) (D: class w):
  $ wb (wrex x3 (wrex y1 (wrex z (wrex w ph D) C) B2) A2) (wrex z (wrex w (wrex x3 (wrex y1 ph B2) A2) D) C) $;

--| Rotate two existential quantifiers and two restricted existential quantifiers. (Contributed by AV, 9-Nov-2023.)
theorem _2ex2rexrot {x3 y1 z w: setvar} (ph: wff x3 y1 z w) (A2 B2: class z w):
  $ wb (wex x3 (wex y1 (wrex z (wrex w ph B2) A2))) (wrex z (wrex w (wex x3 (wex y1 ph)) B2) A2) $;

--| Similar to Lemma 24 of [Monk2] p. 114, except that quantification is restricted. Once derived from ~ hbra2VD . Version of ~ nfra2 with a disjoint variable condition not requiring ~ ax-13 . (Contributed by Alan Sare, 31-Dec-2011.) Reduce axiom usage. (Revised by GG, 24-Sep-2024.) (Proof shortened by Wolf Lammen, 3-Jan-2025.)
theorem nfra2w {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wnf y1 (wral x3 (wral y1 ph B2) A2) $;

--| The setvar ` x ` is not free in ` A. x e. A ph ` . (Contributed by NM, 18-Oct-1996.) (Proof shortened by Wolf Lammen, 7-Dec-2019.)
theorem hbra1 {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wral x3 ph A2) (wal x3 (wral x3 ph A2)) $;

--| Commutation of restricted universal quantifiers. For a version based on fewer axioms see ~ ralcom . (Contributed by Mario Carneiro, 14-Oct-2016.)
theorem ralcomf {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wnfc x3 B2 $ >
  $ wb (wral x3 (wral y1 ph B2) A2) (wral y1 (wral x3 ph A2) B2) $;

--| Commutation of restricted existential quantifiers. For a version based on fewer axioms see ~ rexcom . (Contributed by Mario Carneiro, 14-Oct-2016.)
theorem rexcomf {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wnfc x3 B2 $ >
  $ wb (wrex x3 (wrex y1 ph B2) A2) (wrex y1 (wrex x3 ph A2) B2) $;

--| Rule used to change bound variables, using implicit substitution. Version of ~ cbvralf with a disjoint variable condition, which does not require ~ ax-10 , ~ ax-13 . For a version not dependent on ~ ax-11 and ax-12, see ~ cbvralvw . (Contributed by NM, 7-Mar-2004.) Avoid ~ ax-10 , ~ ax-13 . (Revised by GG, 23-May-2024.)
theorem cbvralfw {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wral x3 ph A2) (wral y1 ps A2) $;

--| Rule used to change bound variables, using implicit substitution. Version of ~ cbvrexf with a disjoint variable condition, which does not require ~ ax-13 . For a version not dependent on ~ ax-11 and ax-12, see ~ cbvrexvw . (Contributed by FL, 27-Apr-2008.) Avoid ~ ax-10 , ~ ax-13 . (Revised by GG, 10-Jan-2024.)
theorem cbvrexfw {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wrex x3 ph A2) (wrex y1 ps A2) $;

--| Rule used to change bound variables, using implicit substitution. Version of ~ cbvralfw with more disjoint variable conditions. (Contributed by NM, 31-Jul-2003.) Avoid ~ ax-13 . (Revised by GG, 10-Jan-2024.)
theorem cbvralw {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wral x3 ph A2) (wral y1 ps A2) $;

--| Rule used to change bound variables, using implicit substitution. Version of ~ cbvrexfw with more disjoint variable conditions. (Contributed by NM, 31-Jul-2003.) Avoid ~ ax-13 . (Revised by GG, 10-Jan-2024.)
theorem cbvrexw {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wrex x3 ph A2) (wrex y1 ps A2) $;

--| Bound-variable hypothesis builder for restricted quantification. (Contributed by NM, 1-Sep-1999.) (Revised by David Abernethy, 13-Dec-2009.)
theorem hbral {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wi (wcel (cv y1) A2) (wal x3 (wcel (cv y1) A2)) $ >
  $ wi ph (wal x3 ph) $ >
  $ wi (wral y1 ph A2) (wal x3 (wral y1 ph A2)) $;

--| Deduction version of ~ nfralw . Version of ~ nfrald with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by NM, 15-Feb-2013.) Avoid ~ ax-9 , ~ ax-ext . (Revised by GG, 24-Sep-2024.)
theorem nfraldw {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3 y1):
  $ wnf y1 ph $ >
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnf x3 (wral y1 ps A2)) $;

--| Deduction version of ~ nfrexw . (Contributed by Mario Carneiro, 14-Oct-2016.) Add disjoint variable condition to avoid ~ ax-13 . See ~ nfrexd for a less restrictive version requiring more axioms. (Revised by GG, 20-Jan-2024.)
theorem nfrexdw {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3 y1):
  $ wnf y1 ph $ >
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnf x3 (wrex y1 ps A2)) $;

--| Bound-variable hypothesis builder for restricted quantification. Version of ~ nfral with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by NM, 1-Sep-1999.) Avoid ~ ax-13 . (Revised by GG, 10-Jan-2024.) (Proof shortened by Wolf Lammen, 13-Dec-2024.)
theorem nfralw {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnf x3 ph $ >
  $ wnf x3 (wral y1 ph A2) $;

--| Bound-variable hypothesis builder for restricted quantification. (Contributed by NM, 1-Sep-1999.) (Revised by Mario Carneiro, 7-Oct-2016.) (Proof shortened by Wolf Lammen, 30-Dec-2019.) Add disjoint variable condition to avoid ~ ax-13 . See ~ nfrex for a less restrictive version requiring more axioms. (Revised by GG, 20-Jan-2024.)
theorem nfrexw {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnf x3 ph $ >
  $ wnf x3 (wrex y1 ph A2) $;

--| Restricted quantifier version of ~ 19.12 . (Contributed by NM, 15-Oct-2003.) (Proof shortened by Andrew Salmon, 30-May-2011.) Avoid ~ ax-13 , ~ ax-ext . (Revised by Wolf Lammen, 17-Jun-2023.) (Proof shortened by Wolf Lammen, 4-Nov-2024.)
theorem r19_12 {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class y1):
  $ wi (wrex x3 (wral y1 ph B2) A2) (wral y1 (wrex x3 ph A2) B2) $;

--| Rearrange restricted existential quantifiers. For a version based on fewer axioms see ~ reeanv . (Contributed by NM, 27-Oct-2010.) (Proof shortened by Andrew Salmon, 30-May-2011.)
theorem reean {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3) (B2: class y1):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wb (wrex x3 (wrex y1 (wa ph ps) B2) A2) (wa (wrex x3 ph A2) (wrex y1 ps B2)) $;

--| Change bound variable by using a substitution. Version of ~ cbvralsv with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by NM, 20-Nov-2005.) Avoid ~ ax-13 . (Revised by GG, 10-Jan-2024.) (Proof shortened by Wolf Lammen, 8-Mar-2025.) Avoid ~ ax-10 , ~ ax-12 . (Revised by SN, 21-Aug-2025.)
theorem cbvralsvw {x3 y1: setvar} (ph: wff x3) (A2: class):
  $ wb (wral x3 ph A2) (wral y1 (wsb x3 ph y1) A2) $;

--| Change bound variable by using a substitution. Version of ~ cbvrexsv with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by NM, 2-Mar-2008.) Avoid ~ ax-13 . (Revised by GG, 10-Jan-2024.) (Proof shortened by Wolf Lammen, 8-Mar-2025.)
theorem cbvrexsvw {x3 y1: setvar} (ph: wff x3) (A2: class):
  $ wb (wrex x3 ph A2) (wrex y1 (wsb x3 ph y1) A2) $;

--| Equality theorem for restricted existential quantifier. (Contributed by NM, 29-Oct-1995.) Remove usage of ~ ax-10 , ~ ax-11 , and ~ ax-12 . (Revised by Steven Nguyen, 30-Apr-2023.) Shorten other proofs. (Revised by Wolf Lammen, 8-Mar-2025.)
theorem rexeq {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (wceq A2 B2) (wb (wrex x3 ph A2) (wrex x3 ph B2)) $;

--| Equality theorem for restricted universal quantifier. (Contributed by NM, 16-Nov-1995.) Remove usage of ~ ax-10 , ~ ax-11 , and ~ ax-12 . (Revised by Steven Nguyen, 30-Apr-2023.) Shorten other proofs. (Revised by Wolf Lammen, 8-Mar-2025.)
theorem raleq {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (wceq A2 B2) (wb (wral x3 ph A2) (wral x3 ph B2)) $;

--| Equality inference for restricted universal quantifier. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem raleqi {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wb (wral x3 ph A2) (wral x3 ph B2) $;

--| Equality inference for restricted existential quantifier. (Contributed by Mario Carneiro, 23-Apr-2015.)
theorem rexeqi {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wb (wrex x3 ph A2) (wrex x3 ph B2) $;

--| Equality deduction for restricted universal quantifier. (Contributed by NM, 13-Nov-2005.)
theorem raleqdv {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wral x3 ps A2) (wral x3 ps B2)) $;

--| Equality deduction for restricted existential quantifier. (Contributed by NM, 14-Jan-2007.)
theorem rexeqdv {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wrex x3 ps A2) (wrex x3 ps B2)) $;

--| Substitution of equal classes into a restricted universal quantifier. (Contributed by Matthew House, 21-Jul-2025.)
theorem raleqtrdv {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wi ph (wral x3 ps A2) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wral x3 ps B2) $;

--| Substitution of equal classes into a restricted existential quantifier. (Contributed by Matthew House, 21-Jul-2025.)
theorem rexeqtrdv {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wi ph (wrex x3 ps A2) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wrex x3 ps B2) $;

--| Substitution of equal classes into a restricted universal quantifier. (Contributed by Matthew House, 21-Jul-2025.)
theorem raleqtrrdv {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wi ph (wral x3 ps A2) $ >
  $ wi ph (wceq B2 A2) $ >
  $ wi ph (wral x3 ps B2) $;

--| Substitution of equal classes into a restricted existential quantifier. (Contributed by Matthew House, 21-Jul-2025.)
theorem rexeqtrrdv {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wi ph (wrex x3 ps A2) $ >
  $ wi ph (wceq B2 A2) $ >
  $ wi ph (wrex x3 ps B2) $;

--| Equality deduction for restricted universal quantifier. (Contributed by Mario Carneiro, 5-Jan-2017.)
theorem raleqbidva {x3: setvar} (ph: wff) (ps ch: wff x3) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wral x3 ps A2) (wral x3 ch B2)) $;

--| Equality deduction for restricted universal quantifier. (Contributed by Mario Carneiro, 5-Jan-2017.)
theorem rexeqbidva {x3: setvar} (ph: wff) (ps ch: wff x3) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wrex x3 ps A2) (wrex x3 ch B2)) $;

--| Version of ~ raleqbidv with additional disjoint variable conditions, not requiring ~ ax-8 nor ~ df-clel . (Contributed by BJ, 22-Sep-2024.)
theorem raleqbidvv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wral x3 ps A2) (wral x3 ch B2)) $;

--| Version of ~ rexeqbidv with additional disjoint variable conditions, not requiring ~ ax-8 nor ~ df-clel . (Contributed by Wolf Lammen, 25-Sep-2024.)
theorem rexeqbidvv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wrex x3 ps A2) (wrex x3 ch B2)) $;

--| Equality deduction for restricted universal quantifier. (Contributed by NM, 16-Nov-1995.) (Proof shortened by Steven Nguyen, 5-May-2023.)
theorem raleqbi1dv {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wi (wceq A2 B2) (wb ph ps) $ >
  $ wi (wceq A2 B2) (wb (wral x3 ph A2) (wral x3 ps B2)) $;

--| Equality deduction for restricted existential quantifier. (Contributed by NM, 18-Mar-1997.) (Proof shortened by Steven Nguyen, 5-May-2023.)
theorem rexeqbi1dv {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wi (wceq A2 B2) (wb ph ps) $ >
  $ wi (wceq A2 B2) (wb (wrex x3 ph A2) (wrex x3 ps B2)) $;

--| All elements of a class are elements of a class equal to this class. (Contributed by AV, 30-Oct-2020.) (Proof shortened by Wolf Lammen, 18-Jul-2025.)
theorem raleleq {x3: setvar} (A2 B2: class):
  $ wi (wceq A2 B2) (wral x3 (wcel (cv x3) B2) A2) $;

--| Equality deduction for restricted universal quantifier, changing both formula and quantifier domain. Inference form. (Contributed by David Moews, 1-May-2017.)
theorem raleqbii {x3: setvar} (ps ch: wff x3) (A2 B2: class x3):
  $ wceq A2 B2 $ >
  $ wb ps ch $ >
  $ wb (wral x3 ps A2) (wral x3 ch B2) $;

--| Equality deduction for restricted existential quantifier, changing both formula and quantifier domain. Inference form. (Contributed by David Moews, 1-May-2017.)
theorem rexeqbii {x3: setvar} (ps ch: wff x3) (A2 B2: class x3):
  $ wceq A2 B2 $ >
  $ wb ps ch $ >
  $ wb (wrex x3 ps A2) (wrex x3 ch B2) $;

--| Equality deduction for restricted universal quantifier. (Contributed by NM, 6-Nov-2007.) Remove usage of ~ ax-10 , ~ ax-11 , and ~ ax-12 and reduce distinct variable conditions. (Revised by Steven Nguyen, 30-Apr-2023.)
theorem raleqbidv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2 B2: class x3):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wral x3 ps A2) (wral x3 ch B2)) $;

--| Equality deduction for restricted universal quantifier. (Contributed by NM, 6-Nov-2007.) Remove usage of ~ ax-10 , ~ ax-11 , and ~ ax-12 and reduce distinct variable conditions. (Revised by Steven Nguyen, 30-Apr-2023.)
theorem rexeqbidv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2 B2: class x3):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wrex x3 ps A2) (wrex x3 ch B2)) $;

--| Rule used to change the bound variable in a restricted universal quantifier with implicit substitution which also changes the quantifier domain. Deduction form. (Contributed by David Moews, 1-May-2017.)
theorem cbvraldva2 {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (A2: class x3) (B2: class y1):
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wb ps ch) $ >
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wceq A2 B2) $ >
  $ wi ph (wb (wral x3 ps A2) (wral y1 ch B2)) $;

--| Rule used to change the bound variable in a restricted existential quantifier with implicit substitution which also changes the quantifier domain. Deduction form. (Contributed by David Moews, 1-May-2017.) (Proof shortened by Wolf Lammen, 8-Jan-2025.)
theorem cbvrexdva2 {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (A2: class x3) (B2: class y1):
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wb ps ch) $ >
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wceq A2 B2) $ >
  $ wi ph (wb (wrex x3 ps A2) (wrex y1 ch B2)) $;

--| Implicit to explicit substitution that swaps variables in a restrictedly universally quantified expression. (Contributed by NM, 5-Sep-2004.) Avoid ~ ax-ext , ~ df-cleq , ~ df-clel . (Revised by Wolf Lammen, 10-Mar-2025.) Avoid ~ ax-10 , ~ ax-12 . (Revised by SN, 13-Nov-2025.)
theorem sbralie {x3 y1: setvar} (ph: wff x3) (ps: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wral x3 ph (cv y1)) (wsb x3 (wral y1 ps (cv x3)) y1) $;

--| Alternative shorter proof of ~ sbralie dependent on ~ ax-ext , ~ df-cleq , ~ df-clel . (Contributed by NM, 5-Sep-2004.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem sbralieALT {x3 y1: setvar} (ph: wff x3) (ps: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wral x3 ph (cv y1)) (wsb x3 (wral y1 ps (cv x3)) y1) $;

--| Obsolete version of ~ sbralie as of 13-Nov-2025. (Contributed by NM, 5-Sep-2004.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem sbralieOLD {x3 y1: setvar} (ph: wff x3) (ps: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wral x3 ph (cv y1)) (wsb x3 (wral y1 ps (cv x3)) y1) $;

--| Equality theorem for restricted universal quantifier, with bound-variable hypotheses instead of distinct variable restrictions. See ~ raleq for a version based on fewer axioms. (Contributed by NM, 7-Mar-2004.) (Revised by Andrew Salmon, 11-Jul-2011.)
theorem raleqf {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wi (wceq A2 B2) (wb (wral x3 ph A2) (wral x3 ph B2)) $;

--| Equality theorem for restricted existential quantifier, with bound-variable hypotheses instead of distinct variable restrictions. See ~ rexeq for a version based on fewer axioms. (Contributed by NM, 9-Oct-2003.) (Revised by Andrew Salmon, 11-Jul-2011.) (Proof shortened by Wolf Lammen, 9-Mar-2025.)
theorem rexeqf {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wi (wceq A2 B2) (wb (wrex x3 ph A2) (wrex x3 ph B2)) $;

--| Equality deduction for restricted universal quantifier. See ~ raleqbidv for a version based on fewer axioms. (Contributed by Thierry Arnoux, 8-Mar-2017.)
theorem raleqbid {x3: setvar} (ph ps ch: wff x3) (A2 B2: class x3):
  $ wnf x3 ph $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wral x3 ps A2) (wral x3 ch B2)) $;

--| Equality deduction for restricted existential quantifier. See ~ rexeqbidv for a version based on fewer axioms. (Contributed by Thierry Arnoux, 8-Mar-2017.)
theorem rexeqbid {x3: setvar} (ph ps ch: wff x3) (A2 B2: class x3):
  $ wnf x3 ph $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wrex x3 ps A2) (wrex x3 ch B2)) $;

--| Rule used to change bound variables, using implicit substitution. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ cbvralfw when possible. (Contributed by NM, 7-Mar-2004.) (Revised by Mario Carneiro, 9-Oct-2016.) (New usage is discouraged.)
theorem cbvralf {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wral x3 ph A2) (wral y1 ps A2) $;

--| Rule used to change bound variables, using implicit substitution. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ cbvrexfw when possible. (Contributed by FL, 27-Apr-2008.) (Revised by Mario Carneiro, 9-Oct-2016.) (New usage is discouraged.)
theorem cbvrexf {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wrex x3 ph A2) (wrex y1 ps A2) $;

--| Rule used to change bound variables, using implicit substitution. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ cbvralw when possible. (Contributed by NM, 31-Jul-2003.) (New usage is discouraged.)
theorem cbvral {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wral x3 ph A2) (wral y1 ps A2) $;

--| Rule used to change bound variables, using implicit substitution. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ cbvrexw when possible. (Contributed by NM, 31-Jul-2003.) (Proof shortened by Andrew Salmon, 8-Jun-2011.) (New usage is discouraged.)
theorem cbvrex {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wrex x3 ph A2) (wrex y1 ps A2) $;

--| Change the bound variable of a restricted universal quantifier using implicit substitution. See ~ cbvralvw based on fewer axioms , but extra disjoint variables. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ cbvralvw when possible. (Contributed by NM, 28-Jan-1997.) (New usage is discouraged.)
theorem cbvralv {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wral x3 ph A2) (wral y1 ps A2) $;

--| Change the bound variable of a restricted existential quantifier using implicit substitution. See ~ cbvrexvw based on fewer axioms , but extra disjoint variables. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ cbvrexvw when possible. (Contributed by NM, 2-Jun-1998.) (New usage is discouraged.)
theorem cbvrexv {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wrex x3 ph A2) (wrex y1 ps A2) $;

--| Change bound variable by using a substitution. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ cbvralsvw when possible. (Contributed by NM, 20-Nov-2005.) (Revised by Andrew Salmon, 11-Jul-2011.) (New usage is discouraged.)
theorem cbvralsv {x3 y1: setvar} (ph: wff x3) (A2: class):
  $ wb (wral x3 ph A2) (wral y1 (wsb x3 ph y1) A2) $;

--| Change bound variable by using a substitution. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ cbvrexsvw when possible. (Contributed by NM, 2-Mar-2008.) (Revised by Andrew Salmon, 11-Jul-2011.) (New usage is discouraged.)
theorem cbvrexsv {x3 y1: setvar} (ph: wff x3) (A2: class):
  $ wb (wrex x3 ph A2) (wrex y1 (wsb x3 ph y1) A2) $;

--| Change bound variables of double restricted universal quantification, using implicit substitution. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ cbvral2vw when possible. (Contributed by NM, 10-Aug-2004.) (New usage is discouraged.)
theorem cbvral2v {x3 y1 z w: setvar} (ph: wff x3 y1 w) (ps: wff x3 z w) (ch: wff y1 z) (A2: class y1 w) (B2: class):
  $ wi (wceq (cv x3) (cv z)) (wb ph ch) $ >
  $ wi (wceq (cv y1) (cv w)) (wb ch ps) $ >
  $ wb (wral x3 (wral y1 ph B2) A2) (wral z (wral w ps B2) A2) $;

--| Change bound variables of double restricted universal quantification, using implicit substitution. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ cbvrex2vw when possible. (Contributed by FL, 2-Jul-2012.) (New usage is discouraged.)
theorem cbvrex2v {x3 y1 z w: setvar} (ph: wff x3 y1 w) (ps: wff x3 z w) (ch: wff y1 z) (A2: class y1 w) (B2: class):
  $ wi (wceq (cv x3) (cv z)) (wb ph ch) $ >
  $ wi (wceq (cv y1) (cv w)) (wb ch ps) $ >
  $ wb (wrex x3 (wrex y1 ph B2) A2) (wrex z (wrex w ps B2) A2) $;

--| Change bound variables of triple restricted universal quantification, using implicit substitution. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ cbvral3vw when possible. (Contributed by NM, 10-May-2005.) (New usage is discouraged.)
theorem cbvral3v {x3 y1 z w v u: setvar} (ph: wff x3 y1 z v u) (ps: wff x3 y1 w v u) (ch: wff y1 z w u) (th: wff x3 z w v) (A2: class y1 z v u) (B2: class z u) (C: class):
  $ wi (wceq (cv x3) (cv w)) (wb ph ch) $ >
  $ wi (wceq (cv y1) (cv v)) (wb ch th) $ >
  $ wi (wceq (cv z) (cv u)) (wb th ps) $ >
  $ wb (wral x3 (wral y1 (wral z ph C) B2) A2) (wral w (wral v (wral u ps C) B2) A2) $;

--| Generalization rule for restricted quantification. Note that ` x ` and ` y ` are not required to be disjoint. This proof illustrates the use of ~ dvelim . This theorem relies on the full set of axioms up to ~ ax-ext and it should no longer be used. Usage of ~ rgen2 is highly encouraged. (Contributed by NM, 23-Nov-1994.) (Proof shortened by Andrew Salmon, 25-May-2011.) (Proof shortened by Wolf Lammen, 1-Jan-2020.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem rgen2a {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3):
  $ wi (wa (wcel (cv x3) A2) (wcel (cv y1) A2)) ph $ >
  $ wral x3 (wral y1 ph A2) A2 $;

--| Deduction version of ~ nfral . Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ nfraldw when possible. (Contributed by NM, 15-Feb-2013.) (Revised by Mario Carneiro, 7-Oct-2016.) (New usage is discouraged.)
theorem nfrald {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3 y1):
  $ wnf y1 ph $ >
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnf x3 (wral y1 ps A2)) $;

--| Deduction version of ~ nfrex . Usage of this theorem is discouraged because it depends on ~ ax-13 . See ~ nfrexdw for a version with a disjoint variable condition, but not requiring ~ ax-13 . (Contributed by Mario Carneiro, 14-Oct-2016.) (New usage is discouraged.)
theorem nfrexd {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3 y1):
  $ wnf y1 ph $ >
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnf x3 (wrex y1 ps A2)) $;

--| Bound-variable hypothesis builder for restricted quantification. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ nfralw when possible. (Contributed by NM, 1-Sep-1999.) (Revised by Mario Carneiro, 7-Oct-2016.) (New usage is discouraged.)
theorem nfral {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnf x3 ph $ >
  $ wnf x3 (wral y1 ph A2) $;

--| Bound-variable hypothesis builder for restricted quantification. Usage of this theorem is discouraged because it depends on ~ ax-13 . See ~ nfrexw for a version with a disjoint variable condition, but not requiring ~ ax-13 . (Contributed by NM, 1-Sep-1999.) (Revised by Mario Carneiro, 7-Oct-2016.) (Proof shortened by Wolf Lammen, 30-Dec-2019.) (New usage is discouraged.)
theorem nfrex {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnf x3 ph $ >
  $ wnf x3 (wrex y1 ph A2) $;

--| Similar to Lemma 24 of [Monk2] p. 114, except the quantification of the antecedent is restricted. Derived automatically from ~ hbra2VD . Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ nfra2w when possible. (Contributed by Alan Sare, 31-Dec-2011.) (New usage is discouraged.)
theorem nfra2 {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wnf y1 (wral x3 (wral y1 ph B2) A2) $;

--| Commutation of restricted universal quantifiers. Note that ` x ` and ` y ` need not be disjoint (this makes the proof longer). This theorem relies on the full set of axioms up to ~ ax-ext and it should no longer be used. Usage of ~ ralcom is highly encouraged. (Contributed by NM, 24-Nov-1994.) (Proof shortened by Mario Carneiro, 17-Oct-2016.) (New usage is discouraged.)
theorem ralcom2 {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wi (wral x3 (wral y1 ph A2) A2) (wral y1 (wral x3 ph A2) A2) $;

--| Extend wff notation to include restricted existential uniqueness.
term wreu {x3: setvar} (ph: wff x3) (A2: class x3): wff;

--| Extend wff notation to include restricted "at most one".
term wrmo {x3: setvar} (ph: wff x3) (A2: class x3): wff;

--| Define restricted "at most one". Note: This notation is most often used to express that ` ph ` holds for at most one element of a given class ` A ` . For this reading ` F/_ x A ` is required, though, for example, asserted when ` x ` and ` A ` are disjoint. Should instead ` A ` depend on ` x ` , you rather assert at most one ` x ` fulfilling ` ph ` happens to be contained in the corresponding ` A ( x ) ` . This interpretation is rarely needed (see also ~ df-ral ). (Contributed by NM, 16-Jun-2017.)
axiom df_rmo {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wrmo x3 ph A2) (wmo x3 (wa (wcel (cv x3) A2) ph)) $;

--| Define restricted existential uniqueness. Note: This notation is most often used to express that ` ph ` holds for exactly one element of a given class ` A ` . For this reading ` F/_ x A ` is required, though, for example, asserted when ` x ` and ` A ` are disjoint. Should instead ` A ` depend on ` x ` , you rather assert exactly one ` x ` fulfilling ` ph ` happens to be contained in the corresponding ` A ( x ) ` . This interpretation is rarely needed (see also ~ df-ral ). (Contributed by NM, 22-Nov-1994.)
axiom df_reu {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wreu x3 ph A2) (weu x3 (wa (wcel (cv x3) A2) ph)) $;

--| Restricted uniqueness in terms of "at most one". (Contributed by NM, 23-May-1999.) (Revised by NM, 16-Jun-2017.)
theorem reu5 {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wreu x3 ph A2) (wa (wrex x3 ph A2) (wrmo x3 ph A2)) $;

--| Restricted existential uniqueness implies restricted "at most one." (Contributed by NM, 16-Jun-2017.)
theorem reurmo {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wreu x3 ph A2) (wrmo x3 ph A2) $;

--| Restricted unique existence implies restricted existence. (Contributed by NM, 19-Aug-1999.)
theorem reurex {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wreu x3 ph A2) (wrex x3 ph A2) $;

--| Unrestricted "at most one" implies restricted "at most one". (Contributed by NM, 16-Jun-2017.)
theorem mormo {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wmo x3 ph) (wrmo x3 ph A2) $;

--| Formula-building rule for restricted at-most-one quantifier (inference form). (Contributed by NM, 16-Jun-2017.)
theorem rmobiia {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wcel (cv x3) A2) (wb ph ps) $ >
  $ wb (wrmo x3 ph A2) (wrmo x3 ps A2) $;

--| Formula-building rule for restricted existential uniqueness quantifier (inference form). (Contributed by NM, 14-Nov-2004.)
theorem reubiia {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wcel (cv x3) A2) (wb ph ps) $ >
  $ wb (wreu x3 ph A2) (wreu x3 ps A2) $;

--| Formula-building rule for restricted at-most-one quantifier (inference form). (Contributed by NM, 16-Jun-2017.)
theorem rmobii {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb ph ps $ >
  $ wb (wrmo x3 ph A2) (wrmo x3 ps A2) $;

--| Formula-building rule for restricted existential uniqueness quantifier (inference form). (Contributed by NM, 22-Oct-1999.)
theorem reubii {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb ph ps $ >
  $ wb (wreu x3 ph A2) (wreu x3 ps A2) $;

--| Cancellation law for restricted at-most-one quantification. (Contributed by Peter Mazsa, 24-May-2018.) (Proof shortened by Wolf Lammen, 12-Jan-2025.)
theorem rmoanid {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wrmo x3 (wa (wcel (cv x3) A2) ph) A2) (wrmo x3 ph A2) $;

--| Cancellation law for restricted unique existential quantification. (Contributed by Peter Mazsa, 12-Feb-2018.) (Proof shortened by Wolf Lammen, 12-Jan-2025.)
theorem reuanid {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wreu x3 (wa (wcel (cv x3) A2) ph) A2) (wreu x3 ph A2) $;

--| Double restricted existential uniqueness, analogous to ~ 2eu2ex . (Contributed by Alexander van der Vekens, 25-Jun-2017.)
theorem _2reu2rex {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ wi (wreu x3 (wreu y1 ph B2) A2) (wrex x3 (wrex y1 ph B2) A2) $;

--| Formula-building rule for restricted at-most-one quantifier (deduction form). (Contributed by NM, 16-Jun-2017.) Avoid ~ ax-12 . (Revised by Wolf Lammen, 23-Nov-2024.)
theorem rmobidva {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wrmo x3 ps A2) (wrmo x3 ch A2)) $;

--| Formula-building rule for restricted existential uniqueness quantifier (deduction form). (Contributed by NM, 13-Nov-2004.) Reduce axiom usage. (Revised by Wolf Lammen, 14-Jan-2023.)
theorem reubidva {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wreu x3 ps A2) (wreu x3 ch A2)) $;

--| Formula-building rule for restricted at-most-one quantifier (deduction form). (Contributed by NM, 16-Jun-2017.)
theorem rmobidv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wrmo x3 ps A2) (wrmo x3 ch A2)) $;

--| Formula-building rule for restricted existential uniqueness quantifier (deduction form). (Contributed by NM, 17-Oct-1996.)
theorem reubidv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wreu x3 ps A2) (wreu x3 ch A2)) $;

--| Restricted existential uniqueness is equivalent to existential uniqueness if the unique element is in the restricting class. (Contributed by AV, 4-Jan-2021.)
theorem reueubd {x3: setvar} (ph: wff) (ps: wff x3) (V: class x3):
  $ wi (wa ph ps) (wcel (cv x3) V) $ >
  $ wi ph (wb (wreu x3 ps V) (weu x3 ps)) $;

--| Restricted "at most one" in term of uniqueness. (Contributed by NM, 16-Jun-2017.)
theorem rmo5 {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wrmo x3 ph A2) (wi (wrex x3 ph A2) (wreu x3 ph A2)) $;

--| Nonexistence implies restricted "at most one". (Contributed by NM, 17-Jun-2017.)
theorem nrexrmo {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wn (wrex x3 ph A2)) (wrmo x3 ph A2) $;

--| "At most one" element in a set. (Contributed by Thierry Arnoux, 26-Jul-2018.) Avoid ~ ax-11 . (Revised by Wolf Lammen, 23-Nov-2024.)
theorem moel {x3 y1: setvar} (A2: class):
  $ wb (wmo x3 (wcel (cv x3) A2)) (wral x3 (wral y1 (wceq (cv x3) (cv y1)) A2) A2) $;

--| Change the bound variable of a restricted at-most-one quantifier using implicit substitution. Version of ~ cbvrmov with a disjoint variable condition, which requires fewer axioms. (Contributed by NM, 16-Jun-2017.) (Revised by GG, 30-Sep-2024.)
theorem cbvrmovw {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wrmo x3 ph A2) (wrmo y1 ps A2) $;

--| Change the bound variable of a restricted unique existential quantifier using implicit substitution. Version of ~ cbvreuv with a disjoint variable condition, which requires fewer axioms. (Contributed by NM, 5-Apr-2004.) (Revised by GG, 30-Sep-2024.)
theorem cbvreuvw {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wreu x3 ph A2) (wreu y1 ps A2) $;

--| Formula-building rule for restricted existential quantifier (deduction form). (Contributed by NM, 16-Jun-2017.)
theorem rmobida {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wrmo x3 ps A2) (wrmo x3 ch A2)) $;

--| Formula-building rule for restricted existential quantifier (deduction form). (Contributed by Mario Carneiro, 19-Nov-2016.)
theorem reubida {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wreu x3 ps A2) (wreu x3 ch A2)) $;

--| Change the bound variable of a restricted at-most-one quantifier using implicit substitution. Version of ~ cbvrmo with a disjoint variable condition, which does not require ~ ax-10 , ~ ax-13 . (Contributed by NM, 16-Jun-2017.) Avoid ~ ax-10 , ~ ax-13 . (Revised by GG, 23-May-2024.)
theorem cbvrmow {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wrmo x3 ph A2) (wrmo y1 ps A2) $;

--| Change the bound variable of a restricted unique existential quantifier using implicit substitution. Version of ~ cbvreu with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by Mario Carneiro, 15-Oct-2016.) Avoid ~ ax-13 . (Revised by GG, 10-Jan-2024.) Avoid ~ ax-10 . (Revised by Wolf Lammen, 10-Dec-2024.)
theorem cbvreuw {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wreu x3 ph A2) (wreu y1 ps A2) $;

--| The setvar ` x ` is not free in ` E* x e. A ph ` . (Contributed by NM, 16-Jun-2017.)
theorem nfrmo1 {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wnf x3 (wrmo x3 ph A2) $;

--| The setvar ` x ` is not free in ` E! x e. A ph ` . (Contributed by NM, 19-Mar-1997.)
theorem nfreu1 {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wnf x3 (wreu x3 ph A2) $;

--| Bound-variable hypothesis builder for restricted uniqueness. Version of ~ nfrmo with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by NM, 16-Jun-2017.) Avoid ~ ax-13 . (Revised by GG, 10-Jan-2024.) Avoid ~ ax-9 , ~ ax-ext . (Revised by Wolf Lammen, 21-Nov-2024.)
theorem nfrmow {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnf x3 ph $ >
  $ wnf x3 (wrmo y1 ph A2) $;

--| Bound-variable hypothesis builder for restricted unique existence. Version of ~ nfreu with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by NM, 30-Oct-2010.) Avoid ~ ax-13 . (Revised by GG, 10-Jan-2024.) Avoid ~ ax-9 , ~ ax-ext . (Revised by Wolf Lammen, 21-Nov-2024.)
theorem nfreuw {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnf x3 ph $ >
  $ wnf x3 (wreu y1 ph A2) $;

--| Equality theorem for restricted at-most-one quantifier. (Contributed by Alexander van der Vekens, 17-Jun-2017.) Remove usage of ~ ax-10 , ~ ax-11 , and ~ ax-12 . (Revised by Steven Nguyen, 30-Apr-2023.) Avoid ~ ax-8 . (Revised by Wolf Lammen, 12-Mar-2025.)
theorem rmoeq1 {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (wceq A2 B2) (wb (wrmo x3 ph A2) (wrmo x3 ph B2)) $;

--| Equality theorem for restricted unique existential quantifier. (Contributed by NM, 5-Apr-2004.) Remove usage of ~ ax-10 , ~ ax-11 , and ~ ax-12 . (Revised by Steven Nguyen, 30-Apr-2023.) Avoid ~ ax-8 . (Revised by Wolf Lammen, 12-Mar-2025.)
theorem reueq1 {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (wceq A2 B2) (wb (wreu x3 ph A2) (wreu x3 ph B2)) $;

--| Equality deduction for restricted at-most-one quantifier. (Contributed by Alexander van der Vekens, 17-Jun-2017.)
theorem rmoeqd {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wi (wceq A2 B2) (wb ph ps) $ >
  $ wi (wceq A2 B2) (wb (wrmo x3 ph A2) (wrmo x3 ps B2)) $;

--| Equality deduction for restricted unique existential quantifier. (Contributed by NM, 5-Apr-2004.)
theorem reueqd {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wi (wceq A2 B2) (wb ph ps) $ >
  $ wi (wceq A2 B2) (wb (wreu x3 ph A2) (wreu x3 ps B2)) $;

--| Formula-building rule for restricted existential uniqueness quantifier. Deduction form. (Contributed by GG, 1-Sep-2025.)
theorem reueqdv {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wreu x3 ps A2) (wreu x3 ps B2)) $;

--| Formula-building rule for restricted existential uniqueness quantifier. Deduction form. General version of ~ reubidv . (Contributed by GG, 1-Sep-2025.)
theorem reueqbidv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2 B2: class x3):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wreu x3 ps A2) (wreu x3 ch B2)) $;

--| Equality theorem for restricted at-most-one quantifier, with bound-variable hypotheses instead of distinct variable restrictions. (Contributed by Alexander van der Vekens, 17-Jun-2017.)
theorem rmoeq1f {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wi (wceq A2 B2) (wb (wrmo x3 ph A2) (wrmo x3 ph B2)) $;

--| Equality theorem for restricted unique existential quantifier, with bound-variable hypotheses instead of distinct variable restrictions. (Contributed by NM, 5-Apr-2004.) (Revised by Andrew Salmon, 11-Jul-2011.)
theorem reueq1f {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wi (wceq A2 B2) (wb (wreu x3 ph A2) (wreu x3 ph B2)) $;

--| Change the bound variable of a restricted unique existential quantifier using implicit substitution. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ cbvreuw when possible. (Contributed by Mario Carneiro, 15-Oct-2016.) (New usage is discouraged.)
theorem cbvreu {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wreu x3 ph A2) (wreu y1 ps A2) $;

--| Change the bound variable of a restricted at-most-one quantifier using implicit substitution. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ cbvrmow , ~ cbvrmovw when possible. (Contributed by NM, 16-Jun-2017.) (New usage is discouraged.)
theorem cbvrmo {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wrmo x3 ph A2) (wrmo y1 ps A2) $;

--| Change the bound variable of a restricted at-most-one quantifier using implicit substitution. Usage of this theorem is discouraged because it depends on ~ ax-13 . (Contributed by Alexander van der Vekens, 17-Jun-2017.) (New usage is discouraged.)
theorem cbvrmov {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wrmo x3 ph A2) (wrmo y1 ps A2) $;

--| Change the bound variable of a restricted unique existential quantifier using implicit substitution. See ~ cbvreuvw for a version without ~ ax-13 , but extra disjoint variables. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ cbvreuvw when possible. (Contributed by NM, 5-Apr-2004.) (Revised by Mario Carneiro, 15-Oct-2016.) (New usage is discouraged.)
theorem cbvreuv {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wreu x3 ph A2) (wreu y1 ps A2) $;

--| Deduction version of ~ nfrmo . Usage of this theorem is discouraged because it depends on ~ ax-13 . (Contributed by NM, 17-Jun-2017.) (New usage is discouraged.)
theorem nfrmod {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3 y1):
  $ wnf y1 ph $ >
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnf x3 (wrmo y1 ps A2)) $;

--| Deduction version of ~ nfreu . Usage of this theorem is discouraged because it depends on ~ ax-13 . (Contributed by NM, 15-Feb-2013.) (Revised by Mario Carneiro, 8-Oct-2016.) (New usage is discouraged.)
theorem nfreud {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3 y1):
  $ wnf y1 ph $ >
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnf x3 (wreu y1 ps A2)) $;

--| Bound-variable hypothesis builder for restricted uniqueness. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ nfrmow when possible. (Contributed by NM, 16-Jun-2017.) (New usage is discouraged.)
theorem nfrmo {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnf x3 ph $ >
  $ wnf x3 (wrmo y1 ph A2) $;

--| Bound-variable hypothesis builder for restricted unique existence. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ nfreuw when possible. (Contributed by NM, 30-Oct-2010.) (Revised by Mario Carneiro, 8-Oct-2016.) (New usage is discouraged.)
theorem nfreu {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnf x3 ph $ >
  $ wnf x3 (wreu y1 ph A2) $;

--| Extend class notation to include the restricted class abstraction (class builder).
term crab {x3: setvar} (ph: wff x3) (A2: class x3): class;

--| Define a restricted class abstraction (class builder): ` { x e. A | ph } ` is the class of all sets ` x ` in ` A ` such that ` ph ( x ) ` is true. Definition of [TakeutiZaring] p. 20. For the interpretation given in the previous paragraph to be correct, we need to assume ` F/_ x A ` , which is the case as soon as ` x ` and ` A ` are disjoint, which is generally the case. If ` A ` were to depend on ` x ` , then the interpretation would be less obvious (think of the two extreme cases ` A = { x } ` and ` A = x ` , for instance). See also ~ df-ral . (Contributed by NM, 22-Nov-1994.)
axiom df_rab {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wceq (crab x3 ph A2) (cab x3 (wa (wcel (cv x3) A2) ph)) $;

--| Equivalent wff's yield equal restricted class abstractions. (Contributed by Thierry Arnoux, 4-Feb-2017.)
theorem rabbidva2 {x3: setvar} (ph: wff) (ps ch: wff x3) (A2 B2: class x3):
  $ wi ph (wb (wa (wcel (cv x3) A2) ps) (wa (wcel (cv x3) B2) ch)) $ >
  $ wi ph (wceq (crab x3 ps A2) (crab x3 ch B2)) $;

--| Equivalent wff's yield equal restricted class abstractions. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem rabbia2 {x3: setvar} (ps ch: wff x3) (A2 B2: class x3):
  $ wb (wa (wcel (cv x3) A2) ps) (wa (wcel (cv x3) B2) ch) $ >
  $ wceq (crab x3 ps A2) (crab x3 ch B2) $;

--| Equivalent formulas yield equal restricted class abstractions (inference form). (Contributed by NM, 22-May-1999.) (Proof shortened by Wolf Lammen, 12-Jan-2025.)
theorem rabbiia {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wcel (cv x3) A2) (wb ph ps) $ >
  $ wceq (crab x3 ph A2) (crab x3 ps A2) $;

--| Equivalent wff's correspond to equal restricted class abstractions. Inference form of ~ rabbidv . (Contributed by Peter Mazsa, 1-Nov-2019.)
theorem rabbii {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb ph ps $ >
  $ wceq (crab x3 ph A2) (crab x3 ps A2) $;

--| Equivalent wff's yield equal restricted class abstractions (deduction form). (Contributed by NM, 28-Nov-2003.) (Proof shortened by SN, 3-Dec-2023.)
theorem rabbidva {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wceq (crab x3 ps A2) (crab x3 ch A2)) $;

--| Equivalent wff's yield equal restricted class abstractions (deduction form). (Contributed by NM, 10-Feb-1995.)
theorem rabbidv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wceq (crab x3 ps A2) (crab x3 ch A2)) $;

--| Equivalent wff's correspond to restricted class abstractions which are equal with the same class. (Contributed by Peter Mazsa, 8-Jul-2019.)
theorem rabbieq {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wceq B2 (crab x3 ph A2) $ >
  $ wb ph ps $ >
  $ wceq B2 (crab x3 ps A2) $;

--| Swap with a membership relation in a restricted class abstraction. (Contributed by NM, 4-Jul-2005.)
theorem rabswap {x3: setvar} (A2 B2: class x3):
  $ wceq (crab x3 (wcel (cv x3) B2) A2) (crab x3 (wcel (cv x3) A2) B2) $;

--| Rule to change the bound variable in a restricted class abstraction, using implicit substitution. (Contributed by NM, 26-May-1999.) Require ` x ` , ` y ` be disjoint to avoid ~ ax-11 and ~ ax-13 . (Revised by Steven Nguyen, 4-Dec-2022.)
theorem cbvrabv {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wceq (crab x3 ph A2) (crab y1 ps A2) $;

--| When ` ps ` is always true in a context, a restricted class abstraction is equal to the restricting class. Deduction form of ~ rabeqc . (Contributed by Steven Nguyen, 7-Jun-2023.)
theorem rabeqcda {x3: setvar} (ph: wff) (ps: wff x3) (A2: class):
  $ wi (wa ph (wcel (cv x3) A2)) ps $ >
  $ wi ph (wceq (crab x3 ps A2) A2) $;

--| A restricted class abstraction equals the restricting class if its condition follows from the membership of the free setvar variable in the restricting class. (Contributed by AV, 20-Apr-2022.) (Proof shortened by SN, 15-Jan-2025.)
theorem rabeqc {x3: setvar} (ph: wff x3) (A2: class):
  $ wi (wcel (cv x3) A2) ph $ >
  $ wceq (crab x3 ph A2) A2 $;

--| Equality theorem for restricted class abstractions. Inference form of ~ rabeqf . (Contributed by Glauco Siliprandi, 26-Jun-2021.) Avoid ~ ax-10 , ~ ax-11 , ~ ax-12 . (Revised by GG, 3-Jun-2024.)
theorem rabeqi {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wceq A2 B2 $ >
  $ wceq (crab x3 ph A2) (crab x3 ph B2) $;

--| Equality theorem for restricted class abstractions. (Contributed by NM, 15-Oct-2003.) Avoid ~ ax-10 , ~ ax-11 , ~ ax-12 . (Revised by GG, 20-Aug-2023.)
theorem rabeq {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (crab x3 ph A2) (crab x3 ph B2)) $;

--| Equality of restricted class abstractions. Deduction form of ~ rabeq . (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem rabeqdv {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (crab x3 ps A2) (crab x3 ps B2)) $;

--| Equality of restricted class abstractions. (Contributed by Mario Carneiro, 26-Jan-2017.) Remove DV conditions. (Revised by GG, 1-Sep-2025.)
theorem rabeqbidva {x3: setvar} (ph: wff) (ps ch: wff x3) (A2 B2: class x3):
  $ wi ph (wceq A2 B2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wceq (crab x3 ps A2) (crab x3 ch B2)) $;

--| Equality of restricted class abstractions. (Contributed by Jeff Madsen, 1-Dec-2009.)
theorem rabeqbidv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2 B2: class x3):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wceq (crab x3 ps A2) (crab x3 ch B2)) $;

--| Abstract builder restricted to another restricted abstract builder with implicit substitution. (Contributed by AV, 2-Aug-2022.) Avoid ~ ax-10 , ~ ax-11 and ~ ax-12 . (Revised by GG, 12-Oct-2024.)
theorem rabrabi {x3 y1: setvar} (ph ps: wff x3 y1) (ch: wff x3) (A2: class x3):
  $ wi (wceq (cv x3) (cv y1)) (wb ch ph) $ >
  $ wceq (crab x3 ps (crab y1 ph A2)) (crab x3 (wa ch ps) A2) $;

--| The abstraction variable in a restricted class abstraction isn't free. (Contributed by NM, 19-Mar-1997.)
theorem nfrab1 {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wnfc x3 (crab x3 ph A2) $;

--| An "identity" law of concretion for restricted abstraction. Special case of Definition 2.1 of [Quine] p. 16. (Contributed by NM, 9-Oct-2003.)
theorem rabid {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wcel (cv x3) (crab x3 ph A2)) (wa (wcel (cv x3) A2) ph) $;

--| Membership in a restricted abstraction, implication. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem rabidim1 {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wcel (cv x3) (crab x3 ph A2)) (wcel (cv x3) A2) $;

--| Inference from equality of a class variable and a restricted class abstraction. (Contributed by NM, 16-Feb-2004.)
theorem reqabi {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wceq A2 (crab x3 ph B2) $ >
  $ wb (wcel (cv x3) A2) (wa (wcel (cv x3) B2) ph) $;

--| Abstract builder restricted to another restricted abstract builder. (Contributed by Thierry Arnoux, 30-Aug-2017.)
theorem rabrab {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wceq (crab x3 ps (crab x3 ph A2)) (crab x3 (wa ph ps) A2) $;

--| Version of ~ rabbidva2 with disjoint variable condition replaced by nonfreeness hypothesis. (Contributed by BJ, 27-Apr-2019.)
theorem rabbida4 {x3: setvar} (ph ps ch: wff x3) (A2 B2: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wb (wa (wcel (cv x3) A2) ps) (wa (wcel (cv x3) B2) ch)) $ >
  $ wi ph (wceq (crab x3 ps A2) (crab x3 ch B2)) $;

--| Equivalent wff's yield equal restricted class abstractions (deduction form). Version of ~ rabbidva with disjoint variable condition replaced by nonfreeness hypothesis. (Contributed by BJ, 27-Apr-2019.) Avoid ~ ax-10 , ~ ax-11 . (Revised by Wolf Lammen, 14-Mar-2025.)
theorem rabbida {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wceq (crab x3 ps A2) (crab x3 ch A2)) $;

--| Version of ~ rabbidv with disjoint variable condition replaced by nonfreeness hypothesis. (Contributed by BJ, 27-Apr-2019.)
theorem rabbid {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wceq (crab x3 ps A2) (crab x3 ch A2)) $;

--| Deduction form of ~ rabeq . Note that contrary to ~ rabeq it has no disjoint variable condition. (Contributed by BJ, 27-Apr-2019.)
theorem rabeqd {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (crab x3 ps A2) (crab x3 ps B2)) $;

--| Version of ~ rabeqbidva with two disjoint variable conditions removed and the third replaced by a nonfreeness hypothesis. (Contributed by BJ, 27-Apr-2019.)
theorem rabeqbida {x3: setvar} (ph ps ch: wff x3) (A2 B2: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wceq (crab x3 ps A2) (crab x3 ch B2)) $;

--| Equivalent wff's correspond to equal restricted class abstractions. Closed theorem form of ~ rabbii . (Contributed by NM, 25-Nov-2013.)
theorem rabbi {x3: setvar} (ps ch: wff x3) (A2: class x3):
  $ wb (wral x3 (wb ps ch) A2) (wceq (crab x3 ps A2) (crab x3 ch A2)) $;

--| An "identity" law for restricted class abstraction. (Contributed by NM, 9-Oct-2003.) (Proof shortened by Andrew Salmon, 30-May-2011.) (Revised by Thierry Arnoux, 13-Mar-2017.)
theorem rabid2f {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wb (wceq A2 (crab x3 ph A2)) (wral x3 ph A2) $;

--| One direction of ~ rabid2 is based on fewer axioms. (Contributed by Wolf Lammen, 26-May-2025.)
theorem rabid2im {x3: setvar} (ph: wff x3) (A2: class):
  $ wi (wral x3 ph A2) (wceq A2 (crab x3 ph A2)) $;

--| An "identity" law for restricted class abstraction. Prefer ~ rabid2im if one direction is sufficient. (Contributed by NM, 9-Oct-2003.) (Proof shortened by Andrew Salmon, 30-May-2011.) (Proof shortened by Wolf Lammen, 24-Nov-2024.)
theorem rabid2 {x3: setvar} (ph: wff x3) (A2: class):
  $ wb (wceq A2 (crab x3 ph A2)) (wral x3 ph A2) $;

--| Equality theorem for restricted class abstractions, with bound-variable hypotheses instead of distinct variable restrictions. (Contributed by NM, 7-Mar-2004.)
theorem rabeqf {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wi (wceq A2 B2) (wceq (crab x3 ph A2) (crab x3 ph B2)) $;

--| Rule to change the bound variable in a restricted class abstraction, using implicit substitution. Version of ~ cbvrab with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by Andrew Salmon, 11-Jul-2011.) Avoid ~ ax-13 . (Revised by GG, 10-Jan-2024.) Avoid ~ ax-10 . (Revised by Wolf Lammen, 19-Jul-2025.)
theorem cbvrabw {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wceq (crab x3 ph A2) (crab y1 ps A2) $;

--| A variable not free in a wff remains so in a restricted class abstraction. Version of ~ nfrab with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by NM, 13-Oct-2003.) Avoid ~ ax-13 . (Revised by GG, 10-Jan-2024.) (Proof shortened by Wolf Lammen, 23-Nov-2024.)
theorem nfrabw {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wnf x3 ph $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 (crab y1 ph A2) $;

--| A variable not free in a wff remains so in a restricted class abstraction. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ nfrabw when possible. (Contributed by NM, 13-Oct-2003.) (Revised by Mario Carneiro, 9-Oct-2016.) (New usage is discouraged.)
theorem nfrab {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wnf x3 ph $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 (crab y1 ph A2) $;

--| Rule to change the bound variable in a restricted class abstraction, using implicit substitution. This version has bound-variable hypotheses in place of distinct variable conditions. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ cbvrabw when possible. (Contributed by Andrew Salmon, 11-Jul-2011.) (Revised by Mario Carneiro, 9-Oct-2016.) (New usage is discouraged.)
theorem cbvrab {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wceq (crab x3 ph A2) (crab y1 ps A2) $;

--| Extend class notation to include the universal class symbol.
term cvv: class;

--| Justification theorem for ~ df-v . (Contributed by Rodolfo Medina, 27-Apr-2010.)
theorem vjust {x3 y1: setvar}:
  $ wceq (cab x3 (wceq (cv x3) (cv x3))) (cab y1 (wceq (cv y1) (cv y1))) $;

--| Define the universal class. Definition 5.20 of [TakeutiZaring] p. 21. Also Definition 2.9 of [Quine] p. 19. The class ` _V ` can be described as the "class of all sets"; ~ vprc proves that ` _V ` is not itself a set in ZF. We will frequently use the expression ` A e. _V ` as a short way to say " ` A ` is a set", and ~ isset proves that this expression has the same meaning as ` E. x x = A ` . In well-founded set theories without urelements, like ZF, the class ` _V ` is equal to the von Neumann universe. However, the letter "V" does not stand for "von Neumann". The letter "V" was used earlier by Peano in 1889 for the universe of sets, where the letter V is derived from the Latin word "Verum", referring to the true truth constant ` T. ` . Peano's notation ` _V ` was adopted by Whitehead and Russell in Principia Mathematica for the class of all sets in 1910. The class constant ` _V ` is the first class constant introduced in this database. As a constant, as opposed to a variable, it cannot be substituted with anything, and in particular it is not part of any disjoint variable condition. For a general discussion of the theory of classes, see ~ mmset.html#class . See ~ dfv2 for an alternate definition. (Contributed by NM, 26-May-1993.)
axiom df_v {x3: setvar}:
  $ wceq cvv (cab x3 (wceq (cv x3) (cv x3))) $;

--| Alternate definition of the universal class (see ~ df-v ). (Contributed by BJ, 30-Nov-2019.)
theorem dfv2 {x3: setvar}:
  $ wceq cvv (cab x3 wtru) $;

--| All setvar variables are sets (see ~ isset ). Theorem 6.8 of [Quine] p. 43. A shorter proof is possible from ~ eleq2i but it uses more axioms. (Contributed by NM, 26-May-1993.) Remove use of ~ ax-12 . (Revised by SN, 28-Aug-2023.) (Proof shortened by BJ, 4-Sep-2024.)
theorem vex {x3: setvar}:
  $ wcel (cv x3) cvv $;

--| If a proposition is implied by ` x e. _V ` (which is true, see ~ vex ), then it is true. (Contributed by Peter Mazsa, 13-Oct-2018.)
theorem elv {x3: setvar} (ph: wff x3):
  $ wi (wcel (cv x3) cvv) ph $ >
  $ ph $;

--| If a proposition is implied by ` x e. _V ` (which is true, see ~ vex ) and another antecedent, then it is implied by that other antecedent. Deduction associated with ~ elv . (Contributed by Peter Mazsa, 23-Oct-2018.)
theorem elvd {x3: setvar} (ph ps: wff x3):
  $ wi (wa ph (wcel (cv x3) cvv)) ps $ >
  $ wi ph ps $;

--| If a proposition is implied by ` x e. _V ` and ` y e. _V ` (which is true, see ~ vex ), then it is true. (Contributed by Peter Mazsa, 13-Oct-2018.)
theorem el2v {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wa (wcel (cv x3) cvv) (wcel (cv y1) cvv)) ph $ >
  $ ph $;

--| If a proposition is implied by ` x e. _V ` and ` y e. _V ` (which is true, see ~ vex ), then it is true. (Contributed by Peter Mazsa, 13-Oct-2018.)
theorem el2v_b {x3: setvar} (ph: wff x3):
  $ wi (wa (wcel (cv x3) cvv) (wcel (cv x3) cvv)) ph $ >
  $ ph $;

--| If a proposition is implied by ` x e. _V ` , ` y e. _V ` and ` z e. _V ` (which is true, see ~ vex ), then it is true. Inference forms (with ` |- A e. _V ` , ` |- B e. _V ` and ` |- C e. _V ` hypotheses) of the general theorems (proving ` |- ( ( A e. V /\ B e. W /\ C e. X ) -> ` assertions) may be superfluous. (Contributed by Peter Mazsa, 13-Oct-2018.)
theorem el3v {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi (w3a (wcel (cv x3) cvv) (wcel (cv y1) cvv) (wcel (cv z) cvv)) ph $ >
  $ ph $;

--| If a proposition is implied by ` z e. _V ` (which is true, see ~ vex ) and two other antecedents, then it is implied by these other antecedents. (Contributed by Peter Mazsa, 16-Oct-2020.)
theorem el3v3 {z: setvar} (ph ps th: wff z):
  $ wi (w3a ph ps (wcel (cv z) cvv)) th $ >
  $ wi (wa ph ps) th $;

--| The universe contains every set. (Contributed by NM, 11-Sep-2006.) Remove dependency on ~ ax-10 , ~ ax-11 , ~ ax-13 . (Revised by BJ, 10-Aug-2022.)
theorem eqv {x3: setvar} (A2: class):
  $ wb (wceq A2 cvv) (wal x3 (wcel (cv x3) A2)) $;

--| The universe contains every set. (Contributed by BJ, 15-Jul-2021.)
theorem eqvf {x3: setvar} (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wb (wceq A2 cvv) (wal x3 (wcel (cv x3) A2)) $;

--| The class of sets verifying a property is the universal class if and only if that property is a tautology. The reverse implication ( ~ bj-abv ) requires fewer axioms. (Contributed by BJ, 19-Mar-2021.) Avoid ~ df-clel , ~ ax-8 . (Revised by GG, 30-Aug-2024.) (Proof shortened by BJ, 30-Aug-2024.)
theorem abv {x3: setvar} (ph: wff x3):
  $ wb (wceq (cab x3 ph) cvv) (wal x3 ph) $;

--| Alternate proof of ~ abv , shorter but using more axioms. (Contributed by BJ, 19-Mar-2021.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem abvALT {x3: setvar} (ph: wff x3):
  $ wb (wceq (cab x3 ph) cvv) (wal x3 ph) $;

--| Two ways to express that " ` A ` is a set": A class ` A ` is a member of the universal class ` _V ` (see ~ df-v ) if and only if the class ` A ` exists (i.e., there exists some set ` x ` equal to class ` A ` ). Theorem 6.9 of [Quine] p. 43. A class ` A ` which is not a set is called a _proper class_. _Conventions_: We will often use the expression " ` A e. _V ` " to mean " ` A ` is a set", for example in ~ uniex . To make some theorems more readily applicable, we will also use the more general expression ` A e. V ` instead of ` A e. _V ` to mean " ` A ` is a set", typically in an antecedent, or in a hypothesis for theorems in deduction form (see for instance ~ uniexg compared with ~ uniex ). That this is more general is seen either by substitution (when the variable ` V ` has no other occurrences), or by ~ elex . (Contributed by NM, 26-May-1993.)
theorem isset {x3: setvar} (A2: class):
  $ wb (wcel A2 cvv) (wex x3 (wceq (cv x3) A2)) $;

--| The expression ` E. x x = A ` means " ` A ` is a set" even if ` A ` contains ` x ` as a bound variable. This lemma helps minimizing axiom or ~ df-clab usage in some cases. Extracted from the proof of ~ issetft . (Contributed by Wolf Lammen, 30-Jul-2025.)
theorem cbvexeqsetf {x3 y1: setvar} (A2: class x3):
  $ wi (wnfc x3 A2) (wb (wex x3 (wceq (cv x3) A2)) (wex y1 (wceq (cv y1) A2))) $;

--| Closed theorem form of ~ isset that does not require ` x ` and ` A ` to be distinct. Extracted from the proof of ~ vtoclgft . (Contributed by Wolf Lammen, 9-Apr-2025.)
theorem issetft {x3: setvar} (A2: class x3):
  $ wi (wnfc x3 A2) (wb (wcel A2 cvv) (wex x3 (wceq (cv x3) A2))) $;

--| A version of ~ isset that does not require ` x ` and ` A ` to be distinct. (Contributed by Andrew Salmon, 6-Jun-2011.) (Revised by Mario Carneiro, 10-Oct-2016.)
theorem issetf {x3: setvar} (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wb (wcel A2 cvv) (wex x3 (wceq (cv x3) A2)) $;

--| A way to say " ` A ` is a set" (inference form). (Contributed by NM, 24-Jun-1993.) Remove dependencies on axioms. (Revised by BJ, 13-Jul-2019.)
theorem isseti {x3: setvar} (A2: class):
  $ wcel A2 cvv $ >
  $ wex x3 (wceq (cv x3) A2) $;

--| A way to say " ` A ` is a set" (inference form). (Contributed by NM, 21-Jun-1993.)
theorem issetri {x3: setvar} (A2: class):
  $ wex x3 (wceq (cv x3) A2) $ >
  $ wcel A2 cvv $;

--| A class equal to a variable is a set. Note the absence of disjoint variable condition, contrary to ~ isset and ~ issetri . (Contributed by BJ, 27-Apr-2019.)
theorem eqvisset {x3: setvar} (A2: class x3):
  $ wi (wceq (cv x3) A2) (wcel A2 cvv) $;

--| If a class is a member of another class, then it is a set. Theorem 6.12 of [Quine] p. 44. (Contributed by NM, 26-May-1993.) (Proof shortened by Andrew Salmon, 8-Jun-2011.) (Proof shortened by Wolf Lammen, 28-May-2025.)
theorem elex (A2 B2: class):
  $ wi (wcel A2 B2) (wcel A2 cvv) $;

--| If a class is a member of another class, then it is a set. Inference associated with ~ elex . (Contributed by NM, 11-Jun-1994.)
theorem elexi (A2 B2: class):
  $ wcel A2 B2 $ >
  $ wcel A2 cvv $;

--| If a class is a member of another class, then it is a set. Deduction associated with ~ elex . (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem elexd (ph: wff) (A2 V: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel A2 cvv) $;

--| If two classes each contain another class, then both contain some set. (Contributed by Alan Sare, 24-Oct-2011.)
theorem elex22 {x3: setvar} (A2 B2 C: class):
  $ wi (wa (wcel A2 B2) (wcel A2 C)) (wex x3 (wa (wcel (cv x3) B2) (wcel (cv x3) C))) $;

--| A proper class doesn't belong to any class. (Contributed by Glauco Siliprandi, 17-Aug-2020.) (Proof shortened by AV, 14-Nov-2020.)
theorem prcnel (A2 V: class):
  $ wi (wn (wcel A2 cvv)) (wn (wcel A2 V)) $;

--| A universal quantifier restricted to the universe is unrestricted. (Contributed by NM, 26-Mar-2004.)
theorem ralv {x3: setvar} (ph: wff x3):
  $ wb (wral x3 ph cvv) (wal x3 ph) $;

--| An existential quantifier restricted to the universe is unrestricted. (Contributed by NM, 26-Mar-2004.)
theorem rexv {x3: setvar} (ph: wff x3):
  $ wb (wrex x3 ph cvv) (wex x3 ph) $;

--| A unique existential quantifier restricted to the universe is unrestricted. (Contributed by NM, 1-Nov-2010.)
theorem reuv {x3: setvar} (ph: wff x3):
  $ wb (wreu x3 ph cvv) (weu x3 ph) $;

--| An at-most-one quantifier restricted to the universe is unrestricted. (Contributed by Alexander van der Vekens, 17-Jun-2017.)
theorem rmov {x3: setvar} (ph: wff x3):
  $ wb (wrmo x3 ph cvv) (wmo x3 ph) $;

--| A class abstraction restricted to the universe is unrestricted. (Contributed by NM, 27-Dec-2004.) (Proof shortened by Andrew Salmon, 8-Jun-2011.)
theorem rabab {x3: setvar} (ph: wff x3):
  $ wceq (crab x3 ph cvv) (cab x3 ph) $;

--| Specialized existential commutation lemma. (Contributed by Jeff Madsen, 1-Jun-2011.)
theorem rexcom4b {x3 y1: setvar} (ph: wff y1) (A2 B2: class y1):
  $ wcel B2 cvv $ >
  $ wb (wex x3 (wrex y1 (wa ph (wceq (cv x3) B2)) A2)) (wrex y1 ph A2) $;

--| One direction of ~ ceqsalt is based on fewer assumptions and fewer axioms. It is at the same time the reverse direction of ~ vtoclgft . Extracted from a proof of ~ ceqsalt . (Contributed by Wolf Lammen, 25-Mar-2025.)
theorem ceqsal1t {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wa (wnf x3 ps) (wal x3 (wi (wceq (cv x3) A2) (wb ph ps)))) (wi ps (wal x3 (wi (wceq (cv x3) A2) ph))) $;

--| Closed theorem version of ~ ceqsalg . (Contributed by NM, 28-Feb-2013.) (Revised by Mario Carneiro, 10-Oct-2016.)
theorem ceqsalt {x3: setvar} (ph ps: wff x3) (A2: class) (V: class x3):
  $ wi (w3a (wnf x3 ps) (wal x3 (wi (wceq (cv x3) A2) (wb ph ps))) (wcel A2 V)) (wb (wal x3 (wi (wceq (cv x3) A2) ph)) ps) $;

--| Restricted quantifier version of ~ ceqsalt . (Contributed by NM, 28-Feb-2013.) (Revised by Mario Carneiro, 10-Oct-2016.)
theorem ceqsralt {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wi (w3a (wnf x3 ps) (wal x3 (wi (wceq (cv x3) A2) (wb ph ps))) (wcel A2 B2)) (wb (wral x3 (wi (wceq (cv x3) A2) ph) B2) ps) $;

--| A representation of explicit substitution of a class for a variable, inferred from an implicit substitution hypothesis. For an alternate proof, see ~ ceqsalgALT . (Contributed by NM, 29-Oct-2003.) (Proof shortened by BJ, 29-Sep-2019.)
theorem ceqsalg {x3: setvar} (ph ps: wff x3) (A2: class) (V: class x3):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wb (wal x3 (wi (wceq (cv x3) A2) ph)) ps) $;

--| Alternate proof of ~ ceqsalg , not using ~ ceqsalt . (Contributed by NM, 29-Oct-2003.) (Proof shortened by Andrew Salmon, 8-Jun-2011.) (Revised by BJ, 29-Sep-2019.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ceqsalgALT {x3: setvar} (ph ps: wff x3) (A2: class) (V: class x3):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wb (wal x3 (wi (wceq (cv x3) A2) ph)) ps) $;

--| A representation of explicit substitution of a class for a variable, inferred from an implicit substitution hypothesis. (Contributed by NM, 18-Aug-1993.) Avoid ~ df-clab . (Revised by Wolf Lammen, 23-Jan-2025.)
theorem ceqsal {x3: setvar} (ph ps: wff x3) (A2: class):
  $ wnf x3 ps $ >
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wal x3 (wi (wceq (cv x3) A2) ph)) ps $;

--| A representation of explicit substitution of a class for a variable, inferred from an implicit substitution hypothesis. Shorter proof uses ~ df-clab . (Contributed by NM, 18-Aug-1993.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ceqsalALT {x3: setvar} (ph ps: wff x3) (A2: class):
  $ wnf x3 ps $ >
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wal x3 (wi (wceq (cv x3) A2) ph)) ps $;

--| A representation of explicit substitution of a class for a variable, inferred from an implicit substitution hypothesis. (Contributed by NM, 18-Aug-1993.) Avoid ~ ax-12 . (Revised by SN, 8-Sep-2024.)
theorem ceqsalv {x3: setvar} (ph: wff x3) (ps: wff) (A2: class):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wal x3 (wi (wceq (cv x3) A2) ph)) ps $;

--| Restricted quantifier version of ~ ceqsalv . (Contributed by NM, 21-Jun-2013.) Avoid ~ ax-9 , ~ ax-12 , ~ ax-ext . (Revised by SN, 8-Sep-2024.)
theorem ceqsralv {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 B2) (wb (wral x3 (wi (wceq (cv x3) A2) ph) B2) ps) $;

--| Implicit substitution for class with embedded variable. (Contributed by NM, 17-May-1996.)
theorem gencl {x3: setvar} (ph: wff x3) (ps: wff) (ch th: wff x3) (A2 B2: class x3):
  $ wb th (wex x3 (wa ch (wceq A2 B2))) $ >
  $ wi (wceq A2 B2) (wb ph ps) $ >
  $ wi ch ph $ >
  $ wi th ps $;

--| Implicit substitution for class with embedded variable. (Contributed by NM, 17-May-1996.)
theorem _2gencl {x3 y1: setvar} (ph: wff x3 y1) (ps: wff y1) (ch: wff x3) (A2 B2: class x3 y1) (C: class x3) (D: class x3 y1) (R: class y1) (S: class x3):
  $ wb (wcel C S) (wrex x3 (wceq A2 C) R) $ >
  $ wb (wcel D S) (wrex y1 (wceq B2 D) R) $ >
  $ wi (wceq A2 C) (wb ph ps) $ >
  $ wi (wceq B2 D) (wb ps ch) $ >
  $ wi (wa (wcel (cv x3) R) (wcel (cv y1) R)) ph $ >
  $ wi (wa (wcel C S) (wcel D S)) ch $;

--| Implicit substitution for class with embedded variable. (Contributed by NM, 17-May-1996.)
theorem _3gencl {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff y1 z) (ch: wff x3 z) (th: wff x3 y1) (A2 B2 C: class x3 y1 z) (D: class x3) (R: class z) (S: class x3) (F: class x3 y1) (G: class x3 y1 z):
  $ wb (wcel D S) (wrex x3 (wceq A2 D) R) $ >
  $ wb (wcel F S) (wrex y1 (wceq B2 F) R) $ >
  $ wb (wcel G S) (wrex z (wceq C G) R) $ >
  $ wi (wceq A2 D) (wb ph ps) $ >
  $ wi (wceq B2 F) (wb ps ch) $ >
  $ wi (wceq C G) (wb ch th) $ >
  $ wi (w3a (wcel (cv x3) R) (wcel (cv y1) R) (wcel (cv z) R)) ph $ >
  $ wi (w3a (wcel D S) (wcel F S) (wcel G S)) th $;

--| Implicit substitution inference for general classes. (Contributed by NM, 26-Aug-2007.)
theorem cgsexg {x3: setvar} (ph: wff x3) (ps: wff) (ch: wff x3) (A2: class) (V: class x3):
  $ wi (wceq (cv x3) A2) ch $ >
  $ wi ch (wb ph ps) $ >
  $ wi (wcel A2 V) (wb (wex x3 (wa ch ph)) ps) $;

--| Implicit substitution inference for general classes. (Contributed by NM, 26-Jul-1995.)
theorem cgsex2g {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (ch: wff x3 y1) (A2 B2: class) (V W: class x3 y1):
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) ch $ >
  $ wi ch (wb ph ps) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wex x3 (wex y1 (wa ch ph))) ps) $;

--| An implicit substitution inference for 4 general classes. (Contributed by NM, 5-Aug-1995.) Avoid ~ ax-10 , ~ ax-11 . (Revised by GG, 28-Jun-2024.) Avoid ~ ax-9 , ~ ax-ext . (Revised by Wolf Lammen, 21-Mar-2025.)
theorem cgsex4g {x3 y1 z w: setvar} (ph: wff x3 y1 z w) (ps: wff) (ch: wff x3 y1 z w) (A2 B2 C D: class) (R S: class x3 y1 z w):
  $ wi (wa (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wa (wceq (cv z) C) (wceq (cv w) D))) ch $ >
  $ wi ch (wb ph ps) $ >
  $ wi (wa (wa (wcel A2 R) (wcel B2 S)) (wa (wcel C R) (wcel D S))) (wb (wex x3 (wex y1 (wex z (wex w (wa ch ph))))) ps) $;

--| Elimination of an existential quantifier, using implicit substitution. (Contributed by NM, 2-Mar-1995.) (Revised by Mario Carneiro, 10-Oct-2016.) (Proof shortened by Wolf Lammen, 22-Jan-2025.)
theorem ceqsex {x3: setvar} (ph ps: wff x3) (A2: class):
  $ wnf x3 ps $ >
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wex x3 (wa (wceq (cv x3) A2) ph)) ps $;

--| Elimination of an existential quantifier, using implicit substitution. (Contributed by NM, 2-Mar-1995.) Avoid ~ ax-12 . (Revised by GG, 12-Oct-2024.) (Proof shortened by Wolf Lammen, 22-Jan-2025.)
theorem ceqsexv {x3: setvar} (ph: wff x3) (ps: wff) (A2: class):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wex x3 (wa (wceq (cv x3) A2) ph)) ps $;

--| Elimination of an existential quantifier, using implicit substitution. (Contributed by Thierry Arnoux, 10-Sep-2016.) Shorten, reduce dv conditions. (Revised by Wolf Lammen, 5-Jun-2025.) (Proof shortened by SN, 5-Jun-2025.)
theorem ceqsexv2d {x3: setvar} (ph ps: wff x3) (A2: class):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ ps $ >
  $ wex x3 ph $;

--| Elimination of two existential quantifiers, using implicit substitution. (Contributed by Scott Fenton, 7-Jun-2006.)
theorem ceqsex2 {x3 y1: setvar} (ph ps ch: wff x3 y1) (A2 B2: class):
  $ wnf x3 ps $ >
  $ wnf y1 ch $ >
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wb (wex x3 (wex y1 (w3a (wceq (cv x3) A2) (wceq (cv y1) B2) ph))) ch $;

--| Elimination of two existential quantifiers, using implicit substitution. (Contributed by Scott Fenton, 7-Jun-2006.) Avoid ~ ax-10 and ~ ax-11 . (Revised by GG, 20-Aug-2023.)
theorem ceqsex2v {x3 y1: setvar} (ph: wff x3 y1) (ps: wff y1) (ch: wff x3) (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wb (wex x3 (wex y1 (w3a (wceq (cv x3) A2) (wceq (cv y1) B2) ph))) ch $;

--| Elimination of three existential quantifiers, using implicit substitution. (Contributed by NM, 16-Aug-2011.)
theorem ceqsex3v {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff y1 z) (ch: wff x3 z) (th: wff x3 y1) (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wceq (cv z) C) (wb ch th) $ >
  $ wb (wex x3 (wex y1 (wex z (wa (w3a (wceq (cv x3) A2) (wceq (cv y1) B2) (wceq (cv z) C)) ph)))) th $;

--| Elimination of four existential quantifiers, using implicit substitution. (Contributed by NM, 23-Sep-2011.)
theorem ceqsex4v {x3 y1 z w: setvar} (ph: wff x3 y1 z w) (ps: wff y1 z w) (ch: wff x3 z w) (th: wff x3 y1 w) (ta: wff x3 y1 z) (A2 B2 C D: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wcel D cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wceq (cv z) C) (wb ch th) $ >
  $ wi (wceq (cv w) D) (wb th ta) $ >
  $ wb (wex x3 (wex y1 (wex z (wex w (w3a (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wa (wceq (cv z) C) (wceq (cv w) D)) ph))))) ta $;

--| Elimination of six existential quantifiers, using implicit substitution. (Contributed by NM, 21-Sep-2011.)
theorem ceqsex6v {x3 y1 z w v u: setvar} (ph: wff x3 y1 z w v u) (ps: wff y1 z w v u) (ch: wff x3 z w v u) (th: wff x3 y1 w v u) (ta: wff x3 y1 z v u) (et: wff x3 y1 z w u) (ze: wff x3 y1 z w v) (A2 B2 C D E F: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wcel D cvv $ >
  $ wcel E cvv $ >
  $ wcel F cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wceq (cv z) C) (wb ch th) $ >
  $ wi (wceq (cv w) D) (wb th ta) $ >
  $ wi (wceq (cv v) E) (wb ta et) $ >
  $ wi (wceq (cv u) F) (wb et ze) $ >
  $ wb (wex x3 (wex y1 (wex z (wex w (wex v (wex u (w3a (w3a (wceq (cv x3) A2) (wceq (cv y1) B2) (wceq (cv z) C)) (w3a (wceq (cv w) D) (wceq (cv v) E) (wceq (cv u) F)) ph))))))) ze $;

--| Elimination of eight existential quantifiers, using implicit substitution. (Contributed by NM, 23-Sep-2011.)
theorem ceqsex8v {x3 y1 z w v u t s1: setvar} (ph: wff x3 y1 z w v u t s1) (ps: wff y1 z w v u t s1) (ch: wff x3 z w v u t s1) (th: wff x3 y1 w v u t s1) (ta: wff x3 y1 z v u t s1) (et: wff x3 y1 z w u t s1) (ze: wff x3 y1 z w v t s1) (si: wff x3 y1 z w v u s1) (rh: wff x3 y1 z w v u t) (A2 B2 C D E F G H: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wcel D cvv $ >
  $ wcel E cvv $ >
  $ wcel F cvv $ >
  $ wcel G cvv $ >
  $ wcel H cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wceq (cv z) C) (wb ch th) $ >
  $ wi (wceq (cv w) D) (wb th ta) $ >
  $ wi (wceq (cv v) E) (wb ta et) $ >
  $ wi (wceq (cv u) F) (wb et ze) $ >
  $ wi (wceq (cv t) G) (wb ze si) $ >
  $ wi (wceq (cv s1) H) (wb si rh) $ >
  $ wb (wex x3 (wex y1 (wex z (wex w (wex v (wex u (wex t (wex s1 (w3a (wa (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wa (wceq (cv z) C) (wceq (cv w) D))) (wa (wa (wceq (cv v) E) (wceq (cv u) F)) (wa (wceq (cv t) G) (wceq (cv s1) H))) ph))))))))) rh $;

--| Change of bound variable using implicit substitution. (Contributed by NM, 17-May-1996.) (Proof shortened by Andrew Salmon, 8-Jun-2011.)
theorem gencbvex {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (ch: wff x3) (th: wff y1) (A2: class x3):
  $ wcel A2 cvv $ >
  $ wi (wceq A2 (cv y1)) (wb ph ps) $ >
  $ wi (wceq A2 (cv y1)) (wb ch th) $ >
  $ wb th (wex x3 (wa ch (wceq A2 (cv y1)))) $ >
  $ wb (wex x3 (wa ch ph)) (wex y1 (wa th ps)) $;

--| Restatement of ~ gencbvex with weaker hypotheses. (Contributed by Jeff Hankins, 6-Dec-2006.)
theorem gencbvex2 {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (ch: wff x3) (th: wff y1) (A2: class x3):
  $ wcel A2 cvv $ >
  $ wi (wceq A2 (cv y1)) (wb ph ps) $ >
  $ wi (wceq A2 (cv y1)) (wb ch th) $ >
  $ wi th (wex x3 (wa ch (wceq A2 (cv y1)))) $ >
  $ wb (wex x3 (wa ch ph)) (wex y1 (wa th ps)) $;

--| Change of bound variable using implicit substitution. (Contributed by NM, 17-May-1996.)
theorem gencbval {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (ch: wff x3) (th: wff y1) (A2: class x3):
  $ wcel A2 cvv $ >
  $ wi (wceq A2 (cv y1)) (wb ph ps) $ >
  $ wi (wceq A2 (cv y1)) (wb ch th) $ >
  $ wb th (wex x3 (wa ch (wceq A2 (cv y1)))) $ >
  $ wb (wal x3 (wi ch ph)) (wal y1 (wi th ps)) $;

--| Introduce an explicit substitution into an implicit substitution hypothesis. See also ~ csbhypf . (Contributed by Raph Levien, 10-Apr-2004.) (Proof shortened by Wolf Lammen, 25-Jan-2025.)
theorem sbhypf {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class y1):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) A2) (wb (wsb x3 ph y1) ps) $;

--| Closed theorem form of ~ spcimgf . (Contributed by Wolf Lammen, 28-Jul-2025.)
theorem spcimgft {x3: setvar} (ph ps: wff x3) (A2 V: class x3):
  $ wi (wa (wa (wnfc x3 A2) (wnf x3 ps)) (wal x3 (wi (wceq (cv x3) A2) (wi ph ps)))) (wi (wcel A2 V) (wi (wal x3 ph) ps)) $;

--| A closed version of ~ spcimgf . (Contributed by Mario Carneiro, 4-Jan-2017.) (Proof shortened by Wolf Lammen, 27-Jul-2025.)
theorem spcimgfi1 {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wnf x3 ps $ >
  $ wnfc x3 A2 $ >
  $ wi (wal x3 (wi (wceq (cv x3) A2) (wi ph ps))) (wi (wcel A2 B2) (wi (wal x3 ph) ps)) $;

--| A closed version of ~ spcgf . (Contributed by Andrew Salmon, 6-Jun-2011.) (Revised by Mario Carneiro, 4-Jan-2017.)
theorem spcgft {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wnf x3 ps $ >
  $ wnfc x3 A2 $ >
  $ wi (wal x3 (wi (wceq (cv x3) A2) (wb ph ps))) (wi (wcel A2 B2) (wi (wal x3 ph) ps)) $;

--| Rule of specialization, using implicit substitution. Compare Theorem 7.3 of [Quine] p. 44. (Contributed by Mario Carneiro, 4-Jan-2017.)
theorem spcimgf {x3: setvar} (ph ps: wff x3) (A2 V: class x3):
  $ wnfc x3 A2 $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wi ph ps) $ >
  $ wi (wcel A2 V) (wi (wal x3 ph) ps) $;

--| Existential specialization, using implicit substitution. (Contributed by Mario Carneiro, 4-Jan-2017.)
theorem spcimegf {x3: setvar} (ph ps: wff x3) (A2 V: class x3):
  $ wnfc x3 A2 $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wi ps ph) $ >
  $ wi (wcel A2 V) (wi ps (wex x3 ph)) $;

--| Closed theorem form of ~ vtoclgf . The reverse implication is proven in ~ ceqsal1t . See ~ ceqsalt for a version with ` x ` and ` A ` disjoint. (Contributed by NM, 17-Feb-2013.) (Revised by Mario Carneiro, 12-Oct-2016.) (Proof shortened by JJ, 11-Aug-2021.) Avoid ~ ax-13 . (Revised by GG, 6-Oct-2023.)
theorem vtoclgft {x3: setvar} (ph ps: wff x3) (A2 V: class x3):
  $ wi (w3a (wa (wnfc x3 A2) (wnf x3 ps)) (wa (wal x3 (wi (wceq (cv x3) A2) (wb ph ps))) (wal x3 ph)) (wcel A2 V)) ps $;

--| Implicit substitution of a class for a setvar variable. (Contributed by NM, 21-Jun-1993.)
theorem vtocleg {x3: setvar} (ph: wff) (A2: class) (V: class x3):
  $ wi (wceq (cv x3) A2) ph $ >
  $ wi (wcel A2 V) ph $;

--| Implicit substitution of a class expression for a setvar variable. (Contributed by NM, 17-Apr-1995.) Avoid ~ ax-12 . (Revised by SN, 20-Apr-2024.) (Proof shortened by Wolf Lammen, 26-Jan-2025.)
theorem vtoclg {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (V: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ ph $ >
  $ wi (wcel A2 V) ps $;

--| Implicit substitution of a class for a setvar variable. (Contributed by NM, 9-Sep-1993.) Avoid ~ df-clab . (Revised by Wolf Lammen, 31-May-2025.)
theorem vtocle {x3: setvar} (ph: wff) (A2: class):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) ph $ >
  $ ph $;

--| Implicit substitution of a class for a setvar variable. (Contributed by NM, 29-Apr-1994.)
theorem vtoclbg {x3: setvar} (ph ps: wff x3) (ch th: wff) (A2: class) (V: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ch) $ >
  $ wi (wceq (cv x3) A2) (wb ps th) $ >
  $ wb ph ps $ >
  $ wi (wcel A2 V) (wb ch th) $;

--| Implicit substitution of a class for a setvar variable. (Contributed by NM, 30-Aug-1993.) Remove dependency on ~ ax-10 . (Revised by BJ, 29-Nov-2020.) (Proof shortened by SN, 20-Apr-2024.) (Proof shortened by Wolf Lammen, 20-Jun-2025.)
theorem vtocl {x3: setvar} (ph: wff x3) (ps: wff) (A2: class):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ ph $ >
  $ ps $;

--| Implicit substitution of a class for a setvar variable. (Contributed by Mario Carneiro, 15-Oct-2016.)
theorem vtocldf {x3: setvar} (ph ps ch: wff x3) (A2 V: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi ph ps $ >
  $ wnf x3 ph $ >
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnf x3 ch) $ >
  $ wi ph ch $;

--| Implicit substitution of a class for a setvar variable. (Contributed by Mario Carneiro, 15-Oct-2016.) Avoid ~ ax-10 , ~ ax-11 , ~ ax-12 . (Revised by SN, 2-Sep-2024.)
theorem vtocld {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2: class) (V: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi ph ps $ >
  $ wi ph ch $;

--| Implicit substitution of two classes for two setvar variables. (Contributed by Thierry Arnoux, 25-Aug-2020.) (Revised by BTernaryTau, 19-Oct-2023.)
theorem vtocl2d {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (ch: wff) (A2: class y1) (B2: class) (V W: class x3 y1):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ps ch) $ >
  $ wi ph ps $ >
  $ wi ph ch $;

--| Implicit substitution of a class for a setvar variable. (Contributed by NM, 18-Aug-1993.)
theorem vtoclef {x3: setvar} (ph: wff x3) (A2: class):
  $ wnf x3 ph $ >
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) ph $ >
  $ ph $;

--| Implicit substitution of a class for a setvar variable. This is a generalization of ~ chvar . (Contributed by NM, 30-Aug-1993.) (Proof shortened by Wolf Lammen, 26-Jan-2025.)
theorem vtoclf {x3: setvar} (ph ps: wff x3) (A2: class):
  $ wnf x3 ps $ >
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ ph $ >
  $ ps $;

--| Implicit substitution of classes for setvar variables. (Contributed by NM, 26-Jul-1995.) (Proof shortened by Andrew Salmon, 8-Jun-2011.)
theorem vtocl2 {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2: class y1) (B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ ph $ >
  $ ps $;

--| Implicit substitution of classes for setvar variables. (Contributed by NM, 3-Jun-1995.) (Proof shortened by Andrew Salmon, 8-Jun-2011.) Avoid ~ ax-10 and ~ ax-11 . (Revised by GG, 20-Aug-2023.) (Proof shortened by Wolf Lammen, 23-Aug-2023.)
theorem vtocl3 {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff) (A2: class y1 z) (B2: class z) (C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wi (w3a (wceq (cv x3) A2) (wceq (cv y1) B2) (wceq (cv z) C)) (wb ph ps) $ >
  $ ph $ >
  $ ps $;

--| Implicit substitution of a class for a setvar variable. (Contributed by NM, 23-Dec-1993.)
theorem vtoclb {x3: setvar} (ph ps: wff x3) (ch th: wff) (A2: class):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ch) $ >
  $ wi (wceq (cv x3) A2) (wb ps th) $ >
  $ wb ph ps $ >
  $ wb ch th $;

--| Implicit substitution of a class for a setvar variable, with bound-variable hypotheses in place of disjoint variable restrictions. (Contributed by NM, 21-Sep-2003.) (Proof shortened by Mario Carneiro, 10-Oct-2016.)
theorem vtoclgf {x3: setvar} (ph ps: wff x3) (A2 V: class x3):
  $ wnfc x3 A2 $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ ph $ >
  $ wi (wcel A2 V) ps $;

--| Version of ~ vtoclgf with one nonfreeness hypothesis replaced with a disjoint variable condition, thus avoiding dependency on ~ ax-10 and ~ ax-11 . (Contributed by BJ, 1-May-2019.)
theorem vtoclg1f {x3: setvar} (ph ps: wff x3) (A2: class) (V: class x3):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ ph $ >
  $ wi (wcel A2 V) ps $;

--| Implicit substitution of a class for a setvar variable. (Contributed by NM, 25-Apr-1995.)
theorem vtocl2gf {x3 y1: setvar} (ph ps ch: wff x3 y1) (A2 B2 V W: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wnfc y1 B2 $ >
  $ wnf x3 ps $ >
  $ wnf y1 ch $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ ph $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) ch $;

--| Implicit substitution of a class for a setvar variable. (Contributed by NM, 10-Aug-2013.) (Revised by Mario Carneiro, 10-Oct-2016.)
theorem vtocl3gf {x3 y1 z: setvar} (ph ps ch th: wff x3 y1 z) (A2 B2 C V W X: class x3 y1 z):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wnfc z A2 $ >
  $ wnfc y1 B2 $ >
  $ wnfc z B2 $ >
  $ wnfc z C $ >
  $ wnf x3 ps $ >
  $ wnf y1 ch $ >
  $ wnf z th $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wceq (cv z) C) (wb ch th) $ >
  $ ph $ >
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel C X)) th $;

--| Implicit substitution of 2 classes for 2 setvar variables. (Contributed by NM, 25-Apr-1995.) Remove dependency on ~ ax-10 , ~ ax-11 , and ~ ax-13 . (Revised by Steven Nguyen, 29-Nov-2022.)
theorem vtocl2g {x3 y1: setvar} (ph: wff x3 y1) (ps: wff y1) (ch: wff x3) (A2: class) (B2: class x3) (V W: class x3 y1):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ ph $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) ch $;

--| Implicit substitution of a class for a setvar variable. Version of ~ vtocl3gf with disjoint variable conditions instead of nonfreeness hypotheses, requiring fewer axioms. (Contributed by GG, 3-Oct-2024.)
theorem vtocl3g {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff y1 z) (ch: wff x3 z) (th: wff x3 y1) (A2: class) (B2: class x3) (C: class x3 y1) (V W X: class x3 y1 z):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wceq (cv z) C) (wb ch th) $ >
  $ ph $ >
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel C X)) th $;

--| Implicit substitution of a class for a setvar variable. (Contributed by NM, 17-Feb-2006.) (Revised by Mario Carneiro, 10-Oct-2016.)
theorem vtoclgaf {x3: setvar} (ph ps: wff x3) (A2: class x3) (B2: class):
  $ wnfc x3 A2 $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel (cv x3) B2) ph $ >
  $ wi (wcel A2 B2) ps $;

--| Implicit substitution of a class for a setvar variable. (Contributed by NM, 20-Aug-1995.) Avoid ~ ax-10 and ~ ax-11 . (Revised by GG, 20-Aug-2023.)
theorem vtoclga {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel (cv x3) B2) ph $ >
  $ wi (wcel A2 B2) ps $;

--| Implicit substitution of 2 classes for 2 setvar variables. (Contributed by NM, 20-Aug-1995.) Avoid ~ ax-10 and ~ ax-11 . (Revised by GG, 20-Aug-2023.) (Proof shortened by Wolf Lammen, 23-Aug-2023.)
theorem vtocl2ga {x3 y1: setvar} (ph: wff x3 y1) (ps: wff y1) (ch: wff x3) (A2: class) (B2: class x3) (C D: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wa (wcel (cv x3) C) (wcel (cv y1) D)) ph $ >
  $ wi (wa (wcel A2 C) (wcel B2 D)) ch $;

--| Implicit substitution of 2 classes for 2 setvar variables. (Contributed by NM, 10-Aug-2013.) (Proof shortened by Wolf Lammen, 31-May-2025.)
theorem vtocl2gaf {x3 y1: setvar} (ph ps ch: wff x3 y1) (A2 B2: class x3 y1) (C D: class):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wnfc y1 B2 $ >
  $ wnf x3 ps $ >
  $ wnf y1 ch $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wa (wcel (cv x3) C) (wcel (cv y1) D)) ph $ >
  $ wi (wa (wcel A2 C) (wcel B2 D)) ch $;

--| Implicit substitution of 3 classes for 3 setvar variables. (Contributed by NM, 10-Aug-2013.) (Revised by Mario Carneiro, 11-Oct-2016.) (Proof shortened by Wolf Lammen, 31-May-2025.)
theorem vtocl3gaf {x3 y1 z: setvar} (ph ps ch th: wff x3 y1 z) (A2 B2 C: class x3 y1 z) (R S T: class):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wnfc z A2 $ >
  $ wnfc y1 B2 $ >
  $ wnfc z B2 $ >
  $ wnfc z C $ >
  $ wnf x3 ps $ >
  $ wnf y1 ch $ >
  $ wnf z th $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wceq (cv z) C) (wb ch th) $ >
  $ wi (w3a (wcel (cv x3) R) (wcel (cv y1) S) (wcel (cv z) T)) ph $ >
  $ wi (w3a (wcel A2 R) (wcel B2 S) (wcel C T)) th $;

--| Implicit substitution of 3 classes for 3 setvar variables. (Contributed by NM, 20-Aug-1995.) Reduce axiom usage. (Revised by GG, 3-Oct-2024.) (Proof shortened by Wolf Lammen, 31-May-2025.)
theorem vtocl3ga {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff y1 z) (ch: wff x3 z) (th: wff x3 y1) (A2: class) (B2: class x3) (C: class x3 y1) (D R S: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wceq (cv z) C) (wb ch th) $ >
  $ wi (w3a (wcel (cv x3) D) (wcel (cv y1) R) (wcel (cv z) S)) ph $ >
  $ wi (w3a (wcel A2 D) (wcel B2 R) (wcel C S)) th $;

--| Implicit substitution of 4 classes for 4 setvar variables. (Contributed by AV, 22-Jan-2019.)
theorem vtocl4g {x3 y1 z w: setvar} (ph: wff x3 y1 z w) (ps: wff y1 z w) (ch: wff x3 z w) (th: wff x3 y1 z) (rh: wff x3 y1 w) (A2: class) (B2: class x3) (C: class x3 y1) (D: class x3 y1 z) (Q R: class x3 y1) (S T: class x3 y1 z w):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wceq (cv z) C) (wb ch rh) $ >
  $ wi (wceq (cv w) D) (wb rh th) $ >
  $ ph $ >
  $ wi (wa (wa (wcel A2 Q) (wcel B2 R)) (wa (wcel C S) (wcel D T))) th $;

--| Implicit substitution of 4 classes for 4 setvar variables. (Contributed by AV, 22-Jan-2019.) (Proof shortened by Wolf Lammen, 31-May-2025.)
theorem vtocl4ga {x3 y1 z w: setvar} (ph: wff x3 y1 z w) (ps: wff y1 z w) (ch: wff x3 z w) (th: wff x3 y1 z) (rh: wff x3 y1 w) (A2: class) (B2: class x3) (C: class x3 y1) (D: class x3 y1 z) (Q R S T: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wceq (cv z) C) (wb ch rh) $ >
  $ wi (wceq (cv w) D) (wb rh th) $ >
  $ wi (wa (wa (wcel (cv x3) Q) (wcel (cv y1) R)) (wa (wcel (cv z) S) (wcel (cv w) T))) ph $ >
  $ wi (wa (wa (wcel A2 Q) (wcel B2 R)) (wa (wcel C S) (wcel D T))) th $;

--| Implicit substitution of a class for a setvar variable. (Closed theorem version of ~ vtoclef .) (Contributed by NM, 7-Nov-2005.) (Revised by Mario Carneiro, 11-Oct-2016.) (Proof shortened by Wolf Lammen, 26-Jan-2025.)
theorem vtoclegft {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3):
  $ wi (w3a (wcel A2 B2) (wnf x3 ph) (wal x3 (wi (wceq (cv x3) A2) ph))) ph $;

--| Implicit substitution of a class for a setvar variable. (Contributed by NM, 21-Nov-1994.)
theorem vtoclri {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wral x3 ph B2 $ >
  $ wi (wcel A2 B2) ps $;

--| Rule of specialization, using implicit substitution. Compare Theorem 7.3 of [Quine] p. 44. (Contributed by NM, 2-Feb-1997.) (Revised by Andrew Salmon, 12-Aug-2011.)
theorem spcgf {x3: setvar} (ph ps: wff x3) (A2 V: class x3):
  $ wnfc x3 A2 $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wi (wal x3 ph) ps) $;

--| Existential specialization, using implicit substitution. (Contributed by NM, 2-Feb-1997.)
theorem spcegf {x3: setvar} (ph ps: wff x3) (A2 V: class x3):
  $ wnfc x3 A2 $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wi ps (wex x3 ph)) $;

--| Restricted specialization, using implicit substitution. (Contributed by Mario Carneiro, 4-Jan-2017.) Avoid ~ ax-10 and ~ ax-11 . (Revised by GG, 20-Aug-2023.)
theorem spcimdv {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2: class) (B2: class x3):
  $ wi ph (wcel A2 B2) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wi ps ch) $ >
  $ wi ph (wi (wal x3 ps) ch) $;

--| Rule of specialization, using implicit substitution. Analogous to ~ rspcdv . (Contributed by David Moews, 1-May-2017.)
theorem spcdv {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2: class) (B2: class x3):
  $ wi ph (wcel A2 B2) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wi (wal x3 ps) ch) $;

--| Restricted existential specialization, using implicit substitution. (Contributed by Mario Carneiro, 4-Jan-2017.)
theorem spcimedv {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2: class) (B2: class x3):
  $ wi ph (wcel A2 B2) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wi ch ps) $ >
  $ wi ph (wi ch (wex x3 ps)) $;

--| Rule of specialization, using implicit substitution. Compare Theorem 7.3 of [Quine] p. 44. (Contributed by NM, 22-Jun-1994.) Avoid ~ ax-10 , ~ ax-11 . (Revised by Wolf Lammen, 25-Aug-2023.)
theorem spcgv {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (V: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wi (wal x3 ph) ps) $;

--| Existential specialization, using implicit substitution. (Contributed by NM, 14-Aug-1994.) Avoid ~ ax-10 , ~ ax-11 . (Revised by Wolf Lammen, 25-Aug-2023.)
theorem spcegv {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (V: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wi ps (wex x3 ph)) $;

--| Existential specialization, using implicit substitution, deduction version. (Contributed by RP, 12-Aug-2020.) (Revised by AV, 16-Aug-2024.)
theorem spcedv {x3: setvar} (ph ps: wff x3) (ch: wff) (V: class x3) (X: class):
  $ wi ph (wcel X V) $ >
  $ wi ph ch $ >
  $ wi (wceq (cv x3) X) (wb ps ch) $ >
  $ wi ph (wex x3 ps) $;

--| Existential specialization with two quantifiers, using implicit substitution. (Contributed by NM, 3-Aug-1995.)
theorem spc2egv {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2 B2: class) (V W: class x3 y1):
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wi ps (wex x3 (wex y1 ph))) $;

--| Specialization with two quantifiers, using implicit substitution. (Contributed by NM, 27-Apr-2004.)
theorem spc2gv {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2 B2: class) (V W: class x3 y1):
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wi (wal x3 (wal y1 ph)) ps) $;

--| Existential specialization with 2 quantifiers, using implicit substitution. (Contributed by Thierry Arnoux, 23-Aug-2017.)
theorem spc2ed {x3 y1: setvar} (ph: wff) (ps ch: wff x3 y1) (A2 B2: class) (V W: class x3 y1):
  $ wnf x3 ch $ >
  $ wnf y1 ch $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wb ps ch) $ >
  $ wi (wa ph (wa (wcel A2 V) (wcel B2 W))) (wi ch (wex x3 (wex y1 ps))) $;

--| Specialization with 2 quantifiers, using implicit substitution. (Contributed by Thierry Arnoux, 23-Aug-2017.)
theorem spc2d {x3 y1: setvar} (ph: wff) (ps ch: wff x3 y1) (A2 B2: class) (V W: class x3 y1):
  $ wnf x3 ch $ >
  $ wnf y1 ch $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wb ps ch) $ >
  $ wi (wa ph (wa (wcel A2 V) (wcel B2 W))) (wi (wal x3 (wal y1 ps)) ch) $;

--| Existential specialization with three quantifiers, using implicit substitution. (Contributed by NM, 12-May-2008.) Avoid ~ ax-10 and ~ ax-11 . (Revised by GG, 20-Aug-2023.) (Proof shortened by Wolf Lammen, 25-Aug-2023.)
theorem spc3egv {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff) (A2 B2 C: class) (V W X: class x3 y1 z):
  $ wi (w3a (wceq (cv x3) A2) (wceq (cv y1) B2) (wceq (cv z) C)) (wb ph ps) $ >
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel C X)) (wi ps (wex x3 (wex y1 (wex z ph)))) $;

--| Specialization with three quantifiers, using implicit substitution. (Contributed by NM, 12-May-2008.)
theorem spc3gv {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff) (A2 B2 C: class) (V W X: class x3 y1 z):
  $ wi (w3a (wceq (cv x3) A2) (wceq (cv y1) B2) (wceq (cv z) C)) (wb ph ps) $ >
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel C X)) (wi (wal x3 (wal y1 (wal z ph))) ps) $;

--| Rule of specialization, using implicit substitution. (Contributed by NM, 22-Jun-1994.)
theorem spcv {x3: setvar} (ph: wff x3) (ps: wff) (A2: class):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wal x3 ph) ps $;

--| Existential specialization, using implicit substitution. (Contributed by NM, 31-Dec-1993.) (Proof shortened by Eric Schmidt, 22-Dec-2006.)
theorem spcev {x3: setvar} (ph: wff x3) (ps: wff) (A2: class):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi ps (wex x3 ph) $;

--| Existential specialization, using implicit substitution. (Contributed by NM, 3-Aug-1995.)
theorem spc2ev {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ wi ps (wex x3 (wex y1 ph)) $;

--| A closed version of ~ rspc . (Contributed by Andrew Salmon, 6-Jun-2011.)
theorem rspct {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wnf x3 ps $ >
  $ wi (wal x3 (wi (wceq (cv x3) A2) (wb ph ps))) (wi (wcel A2 B2) (wi (wral x3 ph B2) ps)) $;

--| Restricted specialization, using implicit substitution. (Contributed by Emmett Weisz, 16-Jan-2020.)
theorem rspcdf {x3: setvar} (ph ps ch: wff x3) (A2 B2: class):
  $ wnf x3 ph $ >
  $ wnf x3 ch $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wi (wral x3 ps B2) ch) $;

--| Restricted specialization, using implicit substitution. (Contributed by NM, 19-Apr-2005.) (Revised by Mario Carneiro, 11-Oct-2016.)
theorem rspc {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 B2) (wi (wral x3 ph B2) ps) $;

--| Restricted existential specialization, using implicit substitution. (Contributed by NM, 26-May-1998.) (Revised by Mario Carneiro, 11-Oct-2016.)
theorem rspce {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wa (wcel A2 B2) ps) (wrex x3 ph B2) $;

--| Restricted specialization, using implicit substitution. (Contributed by Mario Carneiro, 4-Jan-2017.)
theorem rspcimdv {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2 B2: class):
  $ wi ph (wcel A2 B2) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wi ps ch) $ >
  $ wi ph (wi (wral x3 ps B2) ch) $;

--| Restricted existential specialization, using implicit substitution. (Contributed by Mario Carneiro, 4-Jan-2017.)
theorem rspcimedv {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2 B2: class):
  $ wi ph (wcel A2 B2) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wi ch ps) $ >
  $ wi ph (wi ch (wrex x3 ps B2)) $;

--| Restricted specialization, using implicit substitution. (Contributed by NM, 17-Feb-2007.) (Revised by Mario Carneiro, 4-Jan-2017.)
theorem rspcdv {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2 B2: class):
  $ wi ph (wcel A2 B2) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wi (wral x3 ps B2) ch) $;

--| Restricted existential specialization, using implicit substitution. (Contributed by FL, 17-Apr-2007.) (Revised by Mario Carneiro, 4-Jan-2017.)
theorem rspcedv {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2 B2: class):
  $ wi ph (wcel A2 B2) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wi ch (wrex x3 ps B2)) $;

--| Restricted existential specialization, using implicit substitution in both directions. (Contributed by AV, 8-Jan-2022.)
theorem rspcebdv {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2 B2: class):
  $ wi ph (wcel A2 B2) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi (wa ph ps) (wceq (cv x3) A2) $ >
  $ wi ph (wb (wrex x3 ps B2) ch) $;

--| Restricted specialization, using implicit substitution. (Contributed by Stanislas Polu, 9-Mar-2020.)
theorem rspcdv2 {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2 B2: class):
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wral x3 ps B2) $ >
  $ wi ph ch $;

--| Restricted specialization, using implicit substitution. (Contributed by NM, 26-May-1998.) Drop ~ ax-10 , ~ ax-11 , ~ ax-12 . (Revised by SN, 12-Dec-2023.)
theorem rspcv {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 B2) (wi (wral x3 ph B2) ps) $;

--| Restricted specialization, using implicit substitution. (Contributed by NM, 2-Feb-2006.)
theorem rspccv {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wral x3 ph B2) (wi (wcel A2 B2) ps) $;

--| Restricted specialization, using implicit substitution. (Contributed by NM, 13-Sep-2005.)
theorem rspcva {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wa (wcel A2 B2) (wral x3 ph B2)) ps $;

--| Restricted specialization, using implicit substitution. (Contributed by NM, 26-Jul-2006.) (Proof shortened by Andrew Salmon, 8-Jun-2011.)
theorem rspccva {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wa (wral x3 ph B2) (wcel A2 B2)) ps $;

--| Restricted existential specialization, using implicit substitution. (Contributed by NM, 26-May-1998.) Drop ~ ax-10 , ~ ax-11 , ~ ax-12 . (Revised by SN, 12-Dec-2023.)
theorem rspcev {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wa (wcel A2 B2) ps) (wrex x3 ph B2) $;

--| Restricted specialization, using implicit substitution. (Contributed by Thierry Arnoux, 21-Jun-2020.)
theorem rspcdva {x3: setvar} (ph ps: wff x3) (ch: wff) (A2 C: class):
  $ wi (wceq (cv x3) C) (wb ps ch) $ >
  $ wi ph (wral x3 ps A2) $ >
  $ wi ph (wcel C A2) $ >
  $ wi ph ch $;

--| Restricted existential specialization, using implicit substitution. Variant of ~ rspcedv . (Contributed by AV, 27-Nov-2019.)
theorem rspcedvd {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2 B2: class):
  $ wi ph (wcel A2 B2) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi ph ch $ >
  $ wi ph (wrex x3 ps B2) $;

--| Version of ~ rspcedvd where the implicit substitution hypothesis does not have an antecedent, which also avoids a disjoint variable condition on ` ph , x ` . (Contributed by SN, 20-Aug-2024.)
theorem rspcedvdw {x3: setvar} (ph ps: wff x3) (ch: wff) (A2 B2: class):
  $ wi (wceq (cv x3) A2) (wb ps ch) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi ph ch $ >
  $ wi ph (wrex x3 ps B2) $;

--| Restricted existential specialization, using implicit substitution in both directions. (Contributed by Zhi Wang, 28-Sep-2024.)
theorem rspceb2dv {x3: setvar} (ph: wff) (ps: wff x3) (ch th: wff) (A2 B2: class):
  $ wi (wa ph (wcel (cv x3) B2)) (wi ps ch) $ >
  $ wi (wa ph ch) (wcel A2 B2) $ >
  $ wi (wa ph ch) th $ >
  $ wi (wceq (cv x3) A2) (wb ps th) $ >
  $ wi ph (wb (wrex x3 ps B2) ch) $;

--| Prove a restricted existential. (Contributed by Rohan Ridenour, 3-Aug-2023.)
theorem rspcime {x3: setvar} (ph: wff) (ps: wff x3) (A2 B2: class):
  $ wi (wa ph (wceq (cv x3) A2)) ps $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wrex x3 ps B2) $;

--| Restricted existential specialization of a universally quantified implication. (Contributed by BJ, 24-Aug-2022.)
theorem rspceaimv {x3 y1: setvar} (ph: wff x3 y1) (ps ch: wff y1) (A2: class) (B2 C: class y1):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wa (wcel A2 B2) (wral y1 (wi ps ch) C)) (wrex x3 (wral y1 (wi ph ch) C) B2) $;

--| Restricted existential specialization, using implicit substitution. Variant of ~ rspcedvd for equations. (Contributed by AV, 24-Dec-2019.)
theorem rspcedeqvd {x3: setvar} (ph: wff) (A2 B2: class) (C D: class x3):
  $ wi ph (wcel A2 B2) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wceq C D) $ >
  $ wi ph (wrex x3 (wceq C D) B2) $;

--| Restricted specialization with two quantifiers, using implicit substitution. (Contributed by NM, 9-Nov-2012.)
theorem rspc2 {x3 y1: setvar} (ph ps ch: wff x3 y1) (A2: class) (B2: class x3) (C: class y1) (D: class):
  $ wnf x3 ch $ >
  $ wnf y1 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ch) $ >
  $ wi (wceq (cv y1) B2) (wb ch ps) $ >
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wi (wral x3 (wral y1 ph D) C) ps) $;

--| Restricted specialization with two quantifiers, using implicit substitution. (Contributed by BJ, 2-Dec-2021.)
theorem rspc2gv {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2 B2 V W: class):
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wi (wral x3 (wral y1 ph W) V) ps) $;

--| 2-variable restricted specialization, using implicit substitution. (Contributed by NM, 13-Sep-1999.)
theorem rspc2v {x3 y1: setvar} (ph: wff x3 y1) (ps: wff x3) (ch: wff y1) (A2: class) (B2: class x3) (C: class y1) (D: class):
  $ wi (wceq (cv x3) A2) (wb ph ch) $ >
  $ wi (wceq (cv y1) B2) (wb ch ps) $ >
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wi (wral x3 (wral y1 ph D) C) ps) $;

--| 2-variable restricted specialization, using implicit substitution. (Contributed by NM, 18-Jun-2014.)
theorem rspc2va {x3 y1: setvar} (ph: wff x3 y1) (ps: wff x3) (ch: wff y1) (A2: class) (B2: class x3) (C: class y1) (D: class):
  $ wi (wceq (cv x3) A2) (wb ph ch) $ >
  $ wi (wceq (cv y1) B2) (wb ch ps) $ >
  $ wi (wa (wa (wcel A2 C) (wcel B2 D)) (wral x3 (wral y1 ph D) C)) ps $;

--| 2-variable restricted existential specialization, using implicit substitution. (Contributed by NM, 16-Oct-1999.)
theorem rspc2ev {x3 y1: setvar} (ph: wff x3 y1) (ps: wff x3) (ch: wff y1) (A2: class) (B2: class x3) (C: class y1) (D: class):
  $ wi (wceq (cv x3) A2) (wb ph ch) $ >
  $ wi (wceq (cv y1) B2) (wb ch ps) $ >
  $ wi (w3a (wcel A2 C) (wcel B2 D) ps) (wrex x3 (wrex y1 ph D) C) $;

--| Double application of ~ rspcedvdw . (Contributed by SN, 24-Aug-2024.)
theorem _2rspcedvdw {x3 y1: setvar} (ph ps: wff x3 y1) (ch: wff y1) (th: wff x3) (A2: class) (B2: class x3) (X: class y1) (Y: class):
  $ wi (wceq (cv x3) A2) (wb ps ch) $ >
  $ wi (wceq (cv y1) B2) (wb ch th) $ >
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wcel B2 Y) $ >
  $ wi ph th $ >
  $ wi ph (wrex x3 (wrex y1 ps Y) X) $;

--| 2-variable restricted specialization, using implicit substitution. (Contributed by Scott Fenton, 6-Mar-2025.)
theorem rspc2dv {x3 y1: setvar} (ph ps: wff x3 y1) (ch: wff x3) (th: wff y1) (A2: class) (B2: class x3) (C: class y1) (D: class):
  $ wi (wceq (cv x3) A2) (wb ps th) $ >
  $ wi (wceq (cv y1) B2) (wb th ch) $ >
  $ wi ph (wral x3 (wral y1 ps D) C) $ >
  $ wi ph (wcel A2 C) $ >
  $ wi ph (wcel B2 D) $ >
  $ wi ph ch $;

--| 3-variable restricted specialization, using implicit substitution. (Contributed by NM, 10-May-2005.)
theorem rspc3v {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff x3 y1) (ch: wff y1 z) (th: wff x3 z) (A2: class) (B2: class x3) (C: class x3 y1) (R: class y1 z) (S: class z) (T: class):
  $ wi (wceq (cv x3) A2) (wb ph ch) $ >
  $ wi (wceq (cv y1) B2) (wb ch th) $ >
  $ wi (wceq (cv z) C) (wb th ps) $ >
  $ wi (w3a (wcel A2 R) (wcel B2 S) (wcel C T)) (wi (wral x3 (wral y1 (wral z ph T) S) R) ps) $;

--| 3-variable restricted existential specialization, using implicit substitution. (Contributed by NM, 25-Jul-2012.)
theorem rspc3ev {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff x3 y1) (ch: wff y1 z) (th: wff x3 z) (A2: class) (B2: class x3) (C: class x3 y1) (R: class y1 z) (S: class z) (T: class):
  $ wi (wceq (cv x3) A2) (wb ph ch) $ >
  $ wi (wceq (cv y1) B2) (wb ch th) $ >
  $ wi (wceq (cv z) C) (wb th ps) $ >
  $ wi (wa (w3a (wcel A2 R) (wcel B2 S) (wcel C T)) ps) (wrex x3 (wrex y1 (wrex z ph T) S) R) $;

--| Triple application of ~ rspcedvdw . (Contributed by SN, 20-Aug-2024.)
theorem _3rspcedvdw {x3 y1 z: setvar} (ph ps: wff x3 y1 z) (ch: wff y1 z) (th: wff x3 z) (ta: wff x3 y1) (A2: class) (B2: class x3) (C: class x3 y1) (X: class y1 z) (Y: class z) (Z: class):
  $ wi (wceq (cv x3) A2) (wb ps ch) $ >
  $ wi (wceq (cv y1) B2) (wb ch th) $ >
  $ wi (wceq (cv z) C) (wb th ta) $ >
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wcel B2 Y) $ >
  $ wi ph (wcel C Z) $ >
  $ wi ph ta $ >
  $ wi ph (wrex x3 (wrex y1 (wrex z ps Z) Y) X) $;

--| 3-variable restricted specialization, using implicit substitution. (Contributed by Scott Fenton, 10-Mar-2025.)
theorem rspc3dv {x3 y1 z: setvar} (ph ps: wff x3 y1 z) (ch: wff x3 y1) (th: wff y1 z) (ta: wff x3 z) (A2: class) (B2: class x3) (C: class x3 y1) (D: class y1 z) (E: class z) (F: class):
  $ wi (wceq (cv x3) A2) (wb ps th) $ >
  $ wi (wceq (cv y1) B2) (wb th ta) $ >
  $ wi (wceq (cv z) C) (wb ta ch) $ >
  $ wi ph (wral x3 (wral y1 (wral z ps F) E) D) $ >
  $ wi ph (wcel A2 D) $ >
  $ wi ph (wcel B2 E) $ >
  $ wi ph (wcel C F) $ >
  $ wi ph ch $;

--| 4-variable restricted specialization, using implicit substitution. (Contributed by Scott Fenton, 7-Feb-2025.)
theorem rspc4v {x3 y1 z w: setvar} (ph: wff x3 y1 z w) (ps: wff x3 y1 z) (ch: wff y1 z w) (th: wff x3 z w) (ta: wff x3 y1 w) (A2: class) (B2: class x3) (C: class x3 y1) (D: class x3 y1 z) (R: class y1 z w) (S: class z w) (T: class w) (U: class):
  $ wi (wceq (cv x3) A2) (wb ph ch) $ >
  $ wi (wceq (cv y1) B2) (wb ch th) $ >
  $ wi (wceq (cv z) C) (wb th ta) $ >
  $ wi (wceq (cv w) D) (wb ta ps) $ >
  $ wi (wa (wa (wcel A2 R) (wcel B2 S)) (wa (wcel C T) (wcel D U))) (wi (wral x3 (wral y1 (wral z (wral w ph U) T) S) R) ps) $;

--| 6-variable restricted specialization, using implicit substitution. (Contributed by Scott Fenton, 20-Feb-2025.)
theorem rspc6v {x3 y1 z w q p: setvar} (ph: wff x3 y1 z w q p) (ps: wff x3 y1 z w p) (ch: wff y1 z w q p) (th: wff x3 z w q p) (ta: wff x3 y1 w q p) (et: wff x3 y1 z q p) (ze: wff x3 y1 z w q) (A2: class) (B2: class x3) (C: class x3 y1) (D: class x3 y1 z) (R: class y1 z w q p) (S: class z w q p) (T: class w q p) (U: class q p) (E: class x3 y1 z w) (F: class x3 y1 z w p) (V: class q) (W: class):
  $ wi (wceq (cv x3) A2) (wb ph ch) $ >
  $ wi (wceq (cv y1) B2) (wb ch th) $ >
  $ wi (wceq (cv z) C) (wb th ta) $ >
  $ wi (wceq (cv w) D) (wb ta et) $ >
  $ wi (wceq (cv p) E) (wb et ze) $ >
  $ wi (wceq (cv q) F) (wb ze ps) $ >
  $ wi (w3a (wa (wcel A2 R) (wcel B2 S)) (wa (wcel C T) (wcel D U)) (wa (wcel E V) (wcel F W))) (wi (wral x3 (wral y1 (wral z (wral w (wral p (wral q ph W) V) U) T) S) R) ps) $;

--| 8-variable restricted specialization, using implicit substitution. (Contributed by Scott Fenton, 20-Feb-2025.)
theorem rspc8v {x3 y1 z w s1 r q p: setvar} (ph: wff x3 y1 z w s1 r q p) (ps: wff x3 y1 z w r q p) (ch: wff y1 z w s1 r q p) (th: wff x3 z w s1 r q p) (ta: wff x3 y1 w s1 r q p) (et: wff x3 y1 z s1 r q p) (ze: wff x3 y1 z w s1 r q) (si: wff x3 y1 z w s1 r p) (rh: wff x3 y1 z w s1 q p) (A2: class) (B2: class x3) (C: class x3 y1) (D: class x3 y1 z) (R: class y1 z w s1 r q p) (S: class z w s1 r q p) (T: class w s1 r q p) (U: class s1 r q p) (E: class x3 y1 z w) (F: class x3 y1 z w p) (G: class x3 y1 z w q p) (H: class x3 y1 z w r q p) (V: class s1 r q) (W: class s1 r) (X: class s1) (Y: class):
  $ wi (wceq (cv x3) A2) (wb ph ch) $ >
  $ wi (wceq (cv y1) B2) (wb ch th) $ >
  $ wi (wceq (cv z) C) (wb th ta) $ >
  $ wi (wceq (cv w) D) (wb ta et) $ >
  $ wi (wceq (cv p) E) (wb et ze) $ >
  $ wi (wceq (cv q) F) (wb ze si) $ >
  $ wi (wceq (cv r) G) (wb si rh) $ >
  $ wi (wceq (cv s1) H) (wb rh ps) $ >
  $ wi (wa (wa (wa (wcel A2 R) (wcel B2 S)) (wa (wcel C T) (wcel D U))) (wa (wa (wcel E V) (wcel F W)) (wa (wcel G X) (wcel H Y)))) (wi (wral x3 (wral y1 (wral z (wral w (wral p (wral q (wral r (wral s1 ph Y) X) W) V) U) T) S) R) ps) $;

--| Restricted existential specialization in an equality, using implicit substitution. (Contributed by BJ, 2-Sep-2022.)
theorem rspceeqv {x3: setvar} (A2 B2: class) (C: class x3) (D E: class):
  $ wi (wceq (cv x3) A2) (wceq C D) $ >
  $ wi (wa (wcel A2 B2) (wceq E D)) (wrex x3 (wceq E C) B2) $;

--| Transfer a universal quantifier between one variable with pair-like semantics and two. (Contributed by Stefan O'Rear, 27-Feb-2015.)
theorem ralxpxfr2d {x3 y1 z: setvar} (ph: wff) (ps: wff x3) (ch: wff y1 z) (A2: class y1 z) (B2: class x3 y1 z) (C D: class y1 z):
  $ wcel A2 cvv $ >
  $ wi ph (wb (wcel (cv x3) B2) (wrex y1 (wrex z (wceq (cv x3) A2) D) C)) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wral x3 ps B2) (wral y1 (wral z ch D) C)) $;

--| Statement following from existence and generalization with equality. (Contributed by AV, 9-Feb-2019.)
theorem rexraleqim {x3 z: setvar} (ph: wff z) (ps th: wff x3) (A2 Y: class):
  $ wi (wceq (cv x3) (cv z)) (wb ps ph) $ >
  $ wi (wceq (cv z) Y) (wb ph th) $ >
  $ wi (wa (wrex z ph A2) (wral x3 (wi ps (wceq (cv x3) Y)) A2)) th $;

--| A variable introduction law for class equality, closed form. (Contributed by Thierry Arnoux, 2-Mar-2017.)
theorem eqvincg {x3: setvar} (A2 B2: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wceq A2 B2) (wex x3 (wa (wceq (cv x3) A2) (wceq (cv x3) B2)))) $;

--| A variable introduction law for class equality. (Contributed by NM, 14-Apr-1995.) (Proof shortened by Andrew Salmon, 8-Jun-2011.) (Proof shortened by Thierry Arnoux, 23-Jan-2022.)
theorem eqvinc {x3: setvar} (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wb (wceq A2 B2) (wex x3 (wa (wceq (cv x3) A2) (wceq (cv x3) B2))) $;

--| A variable introduction law for class equality, using bound-variable hypotheses instead of distinct variable conditions. (Contributed by NM, 14-Sep-2003.)
theorem eqvincf {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wcel A2 cvv $ >
  $ wb (wceq A2 B2) (wex x3 (wa (wceq (cv x3) A2) (wceq (cv x3) B2))) $;

--| Two ways to express substitution of ` A ` for ` x ` in ` ph ` . This is the analogue for classes of ~ sbalex . (Contributed by NM, 2-Mar-1995.) (Revised by BJ, 27-Apr-2019.)
theorem alexeqg {x3: setvar} (ph: wff x3) (A2: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wal x3 (wi (wceq (cv x3) A2) ph)) (wex x3 (wa (wceq (cv x3) A2) ph))) $;

--| Equality implies equivalence with substitution. (Contributed by NM, 2-Mar-1995.) (Proof shortened by BJ, 1-May-2019.)
theorem ceqex {x3: setvar} (ph: wff x3) (A2: class):
  $ wi (wceq (cv x3) A2) (wb ph (wex x3 (wa (wceq (cv x3) A2) ph))) $;

--| A representation of explicit substitution of a class for a variable, inferred from an implicit substitution hypothesis. (Contributed by NM, 11-Oct-2004.)
theorem ceqsexg {x3: setvar} (ph ps: wff x3) (A2: class) (V: class x3):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wb (wex x3 (wa (wceq (cv x3) A2) ph)) ps) $;

--| Elimination of an existential quantifier, using implicit substitution. (Contributed by NM, 29-Dec-1996.) Drop ~ ax-10 and ~ ax-12 . (Revised by GG, 1-Dec-2023.)
theorem ceqsexgv {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (V: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wb (wex x3 (wa (wceq (cv x3) A2) ph)) ps) $;

--| Elimination of a restricted existential quantifier, using implicit substitution. (Contributed by NM, 30-Apr-2004.)
theorem ceqsrexv {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 B2) (wb (wrex x3 (wa (wceq (cv x3) A2) ph) B2) ps) $;

--| Elimination of a restricted existential quantifier, using implicit substitution. (Contributed by Mario Carneiro, 14-Mar-2014.)
theorem ceqsrexbv {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wrex x3 (wa (wceq (cv x3) A2) ph) B2) (wa (wcel A2 B2) ps) $;

--| Elimination of a restricted universal quantifier, using implicit substitution. (Contributed by Scott Fenton, 7-Dec-2020.)
theorem ceqsralbv {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wral x3 (wi (wceq (cv x3) A2) ph) B2) (wi (wcel A2 B2) ps) $;

--| Elimination of a restricted existential quantifier, using implicit substitution. (Contributed by NM, 29-Oct-2005.)
theorem ceqsrex2v {x3 y1: setvar} (ph: wff x3 y1) (ps: wff y1) (ch: wff x3) (A2 B2: class) (C: class y1) (D: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wb (wrex x3 (wrex y1 (wa (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) ph) D) C) ch) $;

--| Alternate definition of membership when the member is a set. (Contributed by NM, 18-Aug-1993.) Strengthen from sethood hypothesis to sethood antecedent. (Revised by BJ, 12-Feb-2022.) Avoid ~ ax-12 . (Revised by BJ, 1-Sep-2024.)
theorem clel2g {x3: setvar} (A2 B2: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wcel A2 B2) (wal x3 (wi (wceq (cv x3) A2) (wcel (cv x3) B2)))) $;

--| Alternate definition of membership when the member is a set. (Contributed by NM, 18-Aug-1993.)
theorem clel2 {x3: setvar} (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 B2) (wal x3 (wi (wceq (cv x3) A2) (wcel (cv x3) B2))) $;

--| Alternate definition of membership in a set. (Contributed by NM, 13-Aug-2005.)
theorem clel3g {x3: setvar} (A2 B2: class) (V: class x3):
  $ wi (wcel B2 V) (wb (wcel A2 B2) (wex x3 (wa (wceq (cv x3) B2) (wcel A2 (cv x3))))) $;

--| Alternate definition of membership in a set. (Contributed by NM, 18-Aug-1993.)
theorem clel3 {x3: setvar} (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wb (wcel A2 B2) (wex x3 (wa (wceq (cv x3) B2) (wcel A2 (cv x3)))) $;

--| Alternate definition of membership in a set. (Contributed by NM, 18-Aug-1993.) Strengthen from sethood hypothesis to sethood antecedent and avoid ~ ax-12 . (Revised by BJ, 1-Sep-2024.)
theorem clel4g {x3: setvar} (A2 B2: class) (V: class x3):
  $ wi (wcel B2 V) (wb (wcel A2 B2) (wal x3 (wi (wceq (cv x3) B2) (wcel A2 (cv x3))))) $;

--| Alternate definition of membership in a set. (Contributed by NM, 18-Aug-1993.)
theorem clel4 {x3: setvar} (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wb (wcel A2 B2) (wal x3 (wi (wceq (cv x3) B2) (wcel A2 (cv x3)))) $;

--| Alternate definition of class membership: a class ` X ` is an element of another class ` A ` iff there is an element of ` A ` equal to ` X ` . (Contributed by AV, 13-Nov-2020.) Remove use of ~ ax-10 , ~ ax-11 , and ~ ax-12 . (Revised by Steven Nguyen, 19-May-2023.)
theorem clel5 {x3: setvar} (A2 X: class):
  $ wb (wcel X A2) (wrex x3 (wceq X (cv x3)) A2) $;

--| Compare theorem *13.183 in [WhiteheadRussell] p. 178. Only ` A ` is required to be a set. (Contributed by Andrew Salmon, 3-Jun-2011.) Avoid ~ ax-13 . (Revised by Wolf Lammen, 29-Apr-2023.)
theorem pm13_183 {z: setvar} (A2 B2: class) (V: class z):
  $ wi (wcel A2 V) (wb (wceq A2 B2) (wal z (wb (wceq (cv z) A2) (wceq (cv z) B2)))) $;

--| Restricted quantifier version of Theorem 19.3 of [Margaris] p. 89. We don't need the nonempty class condition of ~ r19.3rzv when there is an outer quantifier. (Contributed by NM, 25-Oct-2012.)
theorem rr19_3v {x3 y1: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wral x3 (wral y1 ph A2) A2) (wral x3 ph A2) $;

--| Restricted quantifier version of Theorem 19.28 of [Margaris] p. 90. We don't need the nonempty class condition of ~ r19.28zv when there is an outer quantifier. (Contributed by NM, 29-Oct-2012.)
theorem rr19_28v {x3 y1: setvar} (ph: wff x3) (ps: wff x3 y1) (A2: class x3):
  $ wb (wral x3 (wral y1 (wa ph ps) A2) A2) (wral x3 (wa ph (wral y1 ps A2)) A2) $;

--| Membership in a class abstraction. Class version of ~ sb6 . (Contributed by SN, 5-Oct-2024.)
theorem elab6g {x3: setvar} (ph: wff x3) (A2: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wcel A2 (cab x3 ph)) (wal x3 (wi (wceq (cv x3) A2) ph))) $;

--| Membership in a class abstraction, using implicit substitution. Deduction version of ~ elab . (Contributed by GG, 12-Oct-2024.) (Revised by BJ, 16-Oct-2024.)
theorem elabd2 {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2: class) (B2 V: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wceq B2 (cab x3 ps)) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wcel A2 B2) ch) $;

--| Membership in a class abstraction, using implicit substitution. Deduction version of ~ elab . (Contributed by GG, 12-Oct-2024.)
theorem elabd3 {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2: class) (V: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wcel A2 (cab x3 ps)) ch) $;

--| Membership in a class abstraction, using implicit substitution. (Closed theorem version of ~ elabg .) (Contributed by NM, 7-Nov-2005.) (Proof shortened by Andrew Salmon, 8-Jun-2011.) Reduce axiom usage. (Revised by GG, 12-Oct-2024.) (Proof shortened by Wolf Lammen, 11-May-2025.) (Proof shortened by SN, 1-Dec-2025.)
theorem elabgt {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (B2: class x3):
  $ wi (wa (wcel A2 B2) (wal x3 (wi (wceq (cv x3) A2) (wb ph ps)))) (wb (wcel A2 (cab x3 ph)) ps) $;

--| Obsolete version of ~ elabgt as of 1-Dec-2025. (Contributed by NM, 7-Nov-2005.) (Proof shortened by Andrew Salmon, 8-Jun-2011.) Reduce axiom usage. (Revised by GG, 12-Oct-2024.) (Proof shortened by Wolf Lammen, 11-May-2025.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem elabgtOLD {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (B2: class x3):
  $ wi (wa (wcel A2 B2) (wal x3 (wi (wceq (cv x3) A2) (wb ph ps)))) (wb (wcel A2 (cab x3 ph)) ps) $;

--| Membership in a class abstraction, using implicit substitution. Compare Theorem 6.13 of [Quine] p. 44. This version has bound-variable hypotheses in place of distinct variable restrictions. (Contributed by NM, 21-Sep-2003.) (Revised by Mario Carneiro, 12-Oct-2016.)
theorem elabgf {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 B2) (wb (wcel A2 (cab x3 ph)) ps) $;

--| Membership in a class abstraction, using implicit substitution. (Contributed by NM, 1-Aug-1994.) (Revised by Mario Carneiro, 12-Oct-2016.)
theorem elabf {x3: setvar} (ph ps: wff x3) (A2: class):
  $ wnf x3 ps $ >
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wcel A2 (cab x3 ph)) ps $;

--| Membership in a class abstraction, using implicit substitution. Compare Theorem 6.13 of [Quine] p. 44. (Contributed by NM, 14-Apr-1995.) Avoid ~ ax-13 . (Revised by SN, 23-Nov-2022.) Avoid ~ ax-10 , ~ ax-11 , ~ ax-12 . (Revised by SN, 5-Oct-2024.)
theorem elabg {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (V: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wb (wcel A2 (cab x3 ph)) ps) $;

--| Membership in a class abstraction, using two substitution hypotheses to avoid a disjoint variable condition on ` x ` and ` A ` . This is to ~ elabg what ~ sbievw2 is to ~ sbievw . (Contributed by SN, 20-Apr-2024.)
theorem elabgw {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (ch: wff x3) (A2: class x3) (V: class x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wceq (cv y1) A2) (wb ps ch) $ >
  $ wi (wcel A2 V) (wb (wcel A2 (cab x3 ph)) ch) $;

--| Membership in a class abstraction, using two substitution hypotheses to avoid a disjoint variable condition on ` x ` and ` A ` , which is not usually significant since ` B ` is usually a constant. (Contributed by SN, 16-May-2024.)
theorem elab2gw {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (ch: wff x3) (A2: class x3) (B2 V: class x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wceq (cv y1) A2) (wb ps ch) $ >
  $ wceq B2 (cab x3 ph) $ >
  $ wi (wcel A2 V) (wb (wcel A2 B2) ch) $;

--| Membership in a class abstraction, using implicit substitution. Compare Theorem 6.13 of [Quine] p. 44. (Contributed by NM, 1-Aug-1994.) Avoid ~ ax-10 , ~ ax-11 , ~ ax-12 . (Revised by SN, 5-Oct-2024.)
theorem elab {x3: setvar} (ph: wff x3) (ps: wff) (A2: class):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wcel A2 (cab x3 ph)) ps $;

--| Membership in a class abstraction, using implicit substitution. (Contributed by NM, 13-Sep-1995.)
theorem elab2g {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (B2 V: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wceq B2 (cab x3 ph) $ >
  $ wi (wcel A2 V) (wb (wcel A2 B2) ps) $;

--| Explicit demonstration the class ` { x | ps } ` is not empty by the example ` A ` . (Contributed by RP, 12-Aug-2020.) (Revised by AV, 23-Mar-2024.)
theorem elabd {x3: setvar} (ph ps: wff x3) (ch: wff) (A2: class) (V: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi ph ch $ >
  $ wi (wceq (cv x3) A2) (wb ps ch) $ >
  $ wi ph (wcel A2 (cab x3 ps)) $;

--| Membership in a class abstraction, using implicit substitution. (Contributed by NM, 13-Sep-1995.)
theorem elab2 {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (B2: class x3):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wceq B2 (cab x3 ph) $ >
  $ wb (wcel A2 B2) ps $;

--| Membership in a class abstraction, using implicit substitution. (Contributed by NM, 17-Oct-2012.)
theorem elab4g {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (B2: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wceq B2 (cab x3 ph) $ >
  $ wb (wcel A2 B2) (wa (wcel A2 cvv) ps) $;

--| Membership in a class abstraction, with a weaker antecedent than ~ elabgf . (Contributed by NM, 6-Sep-2011.)
theorem elab3gf {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wi ps (wcel A2 B2)) (wb (wcel A2 (cab x3 ph)) ps) $;

--| Membership in a class abstraction, with a weaker antecedent than ~ elabg . (Contributed by NM, 29-Aug-2006.)
theorem elab3g {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (B2: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wi ps (wcel A2 B2)) (wb (wcel A2 (cab x3 ph)) ps) $;

--| Membership in a class abstraction using implicit substitution. (Contributed by NM, 10-Nov-2000.) (Revised by AV, 16-Aug-2024.)
theorem elab3 {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (V: class x3):
  $ wi ps (wcel A2 V) $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wcel A2 (cab x3 ph)) ps $;

--| Implication for the membership in a restricted class abstraction. (Contributed by Alexander van der Vekens, 31-Dec-2017.) Remove disjoint variable condition on ` A , x ` and avoid ~ ax-10 , ~ ax-11 , ~ ax-12 . (Revised by SN, 5-Aug-2024.)
theorem elrabi {x3: setvar} (ph: wff x3) (A2: class x3) (V: class):
  $ wi (wcel A2 (crab x3 ph V)) (wcel A2 V) $;

--| Membership in a restricted class abstraction, using implicit substitution. This version has bound-variable hypotheses in place of distinct variable restrictions. (Contributed by NM, 21-Sep-2003.)
theorem elrabf {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wcel A2 (crab x3 ph B2)) (wa (wcel A2 B2) ps) $;

--| Abstract builder using the constant wff ` T. ` . (Contributed by Thierry Arnoux, 4-May-2020.)
theorem rabtru {x3: setvar} (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wceq (crab x3 wtru A2) A2 $;

--| Membership in a restricted class abstraction, using implicit substitution. (Closed theorem version of ~ elrab3 .) (Contributed by Thierry Arnoux, 31-Aug-2017.)
theorem elrab3t {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wa (wal x3 (wi (wceq (cv x3) A2) (wb ph ps))) (wcel A2 B2)) (wb (wcel A2 (crab x3 ph B2)) ps) $;

--| Membership in a restricted class abstraction, using implicit substitution. (Contributed by NM, 21-May-1999.) Remove dependency on ~ ax-13 . (Revised by Steven Nguyen, 23-Nov-2022.)
theorem elrab {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wcel A2 (crab x3 ph B2)) (wa (wcel A2 B2) ps) $;

--| Membership in a restricted class abstraction, using implicit substitution. (Contributed by NM, 5-Oct-2006.)
theorem elrab3 {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 B2) (wb (wcel A2 (crab x3 ph B2)) ps) $;

--| Membership in a restricted class abstraction, using implicit substitution. Deduction version of ~ elrab . (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem elrabd {x3: setvar} (ph ps: wff x3) (ch: wff) (A2 B2: class):
  $ wi (wceq (cv x3) A2) (wb ps ch) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi ph ch $ >
  $ wi ph (wcel A2 (crab x3 ps B2)) $;

--| Deduction version of ~ elrab , just like ~ elrabd , but backwards direction. (Contributed by Thierry Arnoux, 15-Jan-2026.)
theorem elrabrd {x3: setvar} (ph ps: wff x3) (ch: wff) (A2 B2: class):
  $ wi (wceq (cv x3) A2) (wb ps ch) $ >
  $ wi ph (wcel A2 (crab x3 ps B2)) $ >
  $ wi ph ch $;

--| Membership in a restricted class abstraction, using implicit substitution. (Contributed by NM, 2-Nov-2006.)
theorem elrab2 {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class) (C: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wceq C (crab x3 ph B2) $ >
  $ wb (wcel A2 C) (wa (wcel A2 B2) ps) $;

--| Membership in a restricted class abstraction. This is to ~ elrab2 what ~ elab2gw is to ~ elab2g . (Contributed by SN, 2-Sep-2024.)
theorem elrab2w {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (ch: wff x3) (A2: class x3) (B2: class) (C: class x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wceq (cv y1) A2) (wb ps ch) $ >
  $ wceq C (crab x3 ph B2) $ >
  $ wb (wcel A2 C) (wa (wcel A2 B2) ch) $;

--| Universal quantification over a class abstraction. (Contributed by Jeff Madsen, 10-Jun-2010.) Reduce axiom usage. (Revised by GG, 2-Nov-2024.)
theorem ralab {x3 y1: setvar} (ph: wff x3 y1) (ps: wff x3) (ch: wff x3 y1):
  $ wi (wceq (cv y1) (cv x3)) (wb ph ps) $ >
  $ wb (wral x3 ch (cab y1 ph)) (wal x3 (wi ps ch)) $;

--| Universal quantification over a restricted class abstraction. (Contributed by Jeff Madsen, 10-Jun-2010.)
theorem ralrab {x3 y1: setvar} (ph: wff x3 y1) (ps: wff x3) (ch: wff x3 y1) (A2: class x3):
  $ wi (wceq (cv y1) (cv x3)) (wb ph ps) $ >
  $ wb (wral x3 ch (crab y1 ph A2)) (wral x3 (wi ps ch) A2) $;

--| Existential quantification over a class abstraction. (Contributed by Mario Carneiro, 23-Jan-2014.) (Revised by Mario Carneiro, 3-Sep-2015.) Reduce axiom usage. (Revised by GG, 2-Nov-2024.)
theorem rexab {x3 y1: setvar} (ph: wff x3 y1) (ps: wff x3) (ch: wff x3 y1):
  $ wi (wceq (cv y1) (cv x3)) (wb ph ps) $ >
  $ wb (wrex x3 ch (cab y1 ph)) (wex x3 (wa ps ch)) $;

--| Existential quantification over a class abstraction. (Contributed by Jeff Madsen, 17-Jun-2011.) (Revised by Mario Carneiro, 3-Sep-2015.)
theorem rexrab {x3 y1: setvar} (ph: wff x3 y1) (ps: wff x3) (ch: wff x3 y1) (A2: class x3):
  $ wi (wceq (cv y1) (cv x3)) (wb ph ps) $ >
  $ wb (wrex x3 ch (crab y1 ph A2)) (wrex x3 (wa ps ch) A2) $;

--| Universal quantification over a class abstraction. (Contributed by Mario Carneiro, 3-Sep-2015.) Drop ~ ax-8 . (Revised by GG, 1-Dec-2023.)
theorem ralab2 {x3 y1: setvar} (ph: wff y1) (ps: wff x3) (ch: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ps ch) $ >
  $ wb (wral x3 ps (cab y1 ph)) (wal y1 (wi ph ch)) $;

--| Universal quantification over a restricted class abstraction. (Contributed by Mario Carneiro, 3-Sep-2015.)
theorem ralrab2 {x3 y1: setvar} (ph: wff y1) (ps: wff x3) (ch: wff y1) (A2: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ps ch) $ >
  $ wb (wral x3 ps (crab y1 ph A2)) (wral y1 (wi ph ch) A2) $;

--| Existential quantification over a class abstraction. (Contributed by Mario Carneiro, 3-Sep-2015.) Drop ~ ax-8 . (Revised by GG, 1-Dec-2023.)
theorem rexab2 {x3 y1: setvar} (ph: wff y1) (ps: wff x3) (ch: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ps ch) $ >
  $ wb (wrex x3 ps (cab y1 ph)) (wex y1 (wa ph ch)) $;

--| Existential quantification over a class abstraction. (Contributed by Mario Carneiro, 3-Sep-2015.)
theorem rexrab2 {x3 y1: setvar} (ph: wff y1) (ps: wff x3) (ch: wff y1) (A2: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ps ch) $ >
  $ wb (wrex x3 ps (crab y1 ph A2)) (wrex y1 (wa ph ch) A2) $;

--| Restricted existential uniqueness of a restricted abstraction. (Contributed by Scott Fenton, 8-Aug-2024.)
theorem reurab {x3 y1: setvar} (ph: wff x3) (ps ch: wff x3 y1) (A2: class x3):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wreu x3 ch (crab y1 ps A2)) (wreu x3 (wa ph ch) A2) $;

--| Identity used to create closed-form versions of bound-variable hypothesis builders for class expressions. (Contributed by NM, 10-Nov-2005.) (Proof shortened by Mario Carneiro, 12-Oct-2016.)
theorem abidnf {x3 z: setvar} (A2: class x3):
  $ wi (wnfc x3 A2) (wceq (cab z (wal x3 (wcel (cv z) A2))) A2) $;

--| A deduction theorem for converting the inference ` |- F/_ x A ` => ` |- ph ` into a closed theorem. Use ~ nfa1 and ~ nfab to eliminate the hypothesis of the substitution instance ` ps ` of the inference. For converting the inference form into a deduction form, ~ abidnf is useful. (Contributed by NM, 8-Dec-2006.)
theorem dedhb {x3 z: setvar} (ph ps: wff x3 z) (A2: class x3):
  $ wi (wceq A2 (cab z (wal x3 (wcel (cv z) A2)))) (wb ph ps) $ >
  $ ps $ >
  $ wi (wnfc x3 A2) ph $;

--| Writing a set as a class abstraction. This theorem looks artificial but was added to characterize the class abstraction whose existence is proved in ~ class2set . (Contributed by NM, 13-Dec-2005.) (Proof shortened by Raph Levien, 30-Jun-2006.)
theorem class2seteq {x3: setvar} (A2: class) (V: class x3):
  $ wi (wcel A2 V) (wceq (crab x3 (wcel A2 cvv) A2) A2) $;

--| Deduce negative membership from an implication. (Contributed by Thierry Arnoux, 27-Nov-2017.)
theorem nelrdva {x3: setvar} (ph: wff) (A2 B2: class):
  $ wi (wa ph (wcel (cv x3) A2)) (wne (cv x3) B2) $ >
  $ wi ph (wn (wcel B2 A2)) $;

--| A condition which implies existential uniqueness. (Contributed by Jeff Hankins, 8-Sep-2009.)
theorem eqeu {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (B2: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (w3a (wcel A2 B2) ps (wal x3 (wi ph (wceq (cv x3) A2)))) (weu x3 ph) $;

--| There exists at most one set equal to a given class. (Contributed by NM, 8-Mar-1995.) Shorten combined proofs of ~ moeq and ~ eueq . (Proof shortened by BJ, 24-Sep-2022.)
theorem moeq {x3: setvar} (A2: class):
  $ wmo x3 (wceq (cv x3) A2) $;

--| A class is a set if and only if there exists a unique set equal to it. (Contributed by NM, 25-Nov-1994.) Shorten combined proofs of ~ moeq and ~ eueq . (Proof shortened by BJ, 24-Sep-2022.)
theorem eueq {x3: setvar} (A2: class):
  $ wb (wcel A2 cvv) (weu x3 (wceq (cv x3) A2)) $;

--| There exists a unique set equal to a given set. Inference associated with ~ euequ . See ~ euequ in the case of a setvar. (Contributed by NM, 5-Apr-1995.)
theorem eueqi {x3: setvar} (A2: class):
  $ wcel A2 cvv $ >
  $ weu x3 (wceq (cv x3) A2) $;

--| Equality has existential uniqueness (split into 2 cases). (Contributed by NM, 5-Apr-1995.)
theorem eueq2 {x3: setvar} (ph: wff) (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ weu x3 (wo (wa ph (wceq (cv x3) A2)) (wa (wn ph) (wceq (cv x3) B2))) $;

--| Equality has existential uniqueness (split into 3 cases). (Contributed by NM, 5-Apr-1995.) (Proof shortened by Mario Carneiro, 28-Sep-2015.)
theorem eueq3 {x3: setvar} (ph ps: wff) (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wn (wa ph ps) $ >
  $ weu x3 (w3o (wa ph (wceq (cv x3) A2)) (wa (wn (wo ph ps)) (wceq (cv x3) B2)) (wa ps (wceq (cv x3) C))) $;

--| "At most one" property of equality (split into 3 cases). (The first two hypotheses could be eliminated with longer proof.) (Contributed by NM, 23-Apr-1995.)
theorem moeq3 {x3: setvar} (ph ps: wff) (A2 B2 C: class):
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wn (wa ph ps) $ >
  $ wmo x3 (w3o (wa ph (wceq (cv x3) A2)) (wa (wn (wo ph ps)) (wceq (cv x3) B2)) (wa ps (wceq (cv x3) C))) $;

--| "At most one" remains true after substitution. (Contributed by NM, 9-Mar-1995.)
theorem mosub {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wmo x3 ph $ >
  $ wmo x3 (wex y1 (wa (wceq (cv y1) A2) ph)) $;

--| Theorem for inferring "at most one". (Contributed by NM, 17-Oct-1996.)
theorem mo2icl {x3: setvar} (ph: wff x3) (A2: class):
  $ wi (wal x3 (wi ph (wceq (cv x3) A2))) (wmo x3 ph) $;

--| Consequence of "at most one". (Contributed by NM, 2-Jan-2015.)
theorem mob2 {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (B2: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (w3a (wcel A2 B2) (wmo x3 ph) ph) (wb (wceq (cv x3) A2) ps) $;

--| Consequence of "at most one". (Contributed by NM, 29-Jun-2008.)
theorem moi2 {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (B2: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wa (wa (wcel A2 B2) (wmo x3 ph)) (wa ph ps)) (wceq (cv x3) A2) $;

--| Equality implied by "at most one". (Contributed by NM, 18-Feb-2006.)
theorem mob {x3: setvar} (ph: wff x3) (ps ch: wff) (A2 B2: class) (C D: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv x3) B2) (wb ph ch) $ >
  $ wi (w3a (wa (wcel A2 C) (wcel B2 D)) (wmo x3 ph) ps) (wb (wceq A2 B2) ch) $;

--| Equality implied by "at most one". (Contributed by NM, 18-Feb-2006.)
theorem moi {x3: setvar} (ph: wff x3) (ps ch: wff) (A2 B2: class) (C D: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv x3) B2) (wb ph ch) $ >
  $ wi (w3a (wa (wcel A2 C) (wcel B2 D)) (wmo x3 ph) (wa ps ch)) (wceq A2 B2) $;

--| Derive membership from uniqueness. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem morex {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wi (wceq (cv x3) B2) (wb ph ps) $ >
  $ wi (wa (wrex x3 ph A2) (wmo x3 ph)) (wi ps (wcel B2 A2)) $;

--| Transfer existential uniqueness from a variable ` x ` to another variable ` y ` contained in expression ` A ` . Version of ~ euxfr2 with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by NM, 14-Nov-2004.) Avoid ~ ax-13 . (Revised by GG, 10-Jan-2024.)
theorem euxfr2w {x3 y1: setvar} (ph: wff y1) (A2: class y1):
  $ wcel A2 cvv $ >
  $ wmo y1 (wceq (cv x3) A2) $ >
  $ wb (weu x3 (wex y1 (wa (wceq (cv x3) A2) ph))) (weu y1 ph) $;

--| Transfer existential uniqueness from a variable ` x ` to another variable ` y ` contained in expression ` A ` . Version of ~ euxfr with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by NM, 14-Nov-2004.) Avoid ~ ax-13 . (Revised by GG, 10-Jan-2024.)
theorem euxfrw {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class y1):
  $ wcel A2 cvv $ >
  $ weu y1 (wceq (cv x3) A2) $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (weu x3 ph) (weu y1 ps) $;

--| Transfer existential uniqueness from a variable ` x ` to another variable ` y ` contained in expression ` A ` . Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ euxfr2w when possible. (Contributed by NM, 14-Nov-2004.) (New usage is discouraged.)
theorem euxfr2 {x3 y1: setvar} (ph: wff y1) (A2: class y1):
  $ wcel A2 cvv $ >
  $ wmo y1 (wceq (cv x3) A2) $ >
  $ wb (weu x3 (wex y1 (wa (wceq (cv x3) A2) ph))) (weu y1 ph) $;

--| Transfer existential uniqueness from a variable ` x ` to another variable ` y ` contained in expression ` A ` . Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ euxfrw when possible. (Contributed by NM, 14-Nov-2004.) (New usage is discouraged.)
theorem euxfr {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class y1):
  $ wcel A2 cvv $ >
  $ weu y1 (wceq (cv x3) A2) $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (weu x3 ph) (weu y1 ps) $;

--| Existential uniqueness via an indirect equality. (Contributed by NM, 11-Oct-2010.)
theorem euind {x3 y1 z: setvar} (ph: wff x3) (ps: wff y1) (A2: class x3) (B2: class y1):
  $ wcel B2 cvv $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wa (wal x3 (wal y1 (wi (wa ph ps) (wceq A2 B2)))) (wex x3 ph)) (weu z (wal x3 (wi ph (wceq (cv z) A2)))) $;

--| A way to express restricted uniqueness. (Contributed by NM, 22-Nov-1994.)
theorem reu2 {x3 y1: setvar} (ph: wff x3) (A2: class):
  $ wb (wreu x3 ph A2) (wa (wrex x3 ph A2) (wral x3 (wral y1 (wi (wa ph (wsb x3 ph y1)) (wceq (cv x3) (cv y1))) A2) A2)) $;

--| A way to express restricted uniqueness. (Contributed by NM, 20-Oct-2006.)
theorem reu6 {x3 y1: setvar} (ph: wff x3) (A2: class):
  $ wb (wreu x3 ph A2) (wrex y1 (wral x3 (wb ph (wceq (cv x3) (cv y1))) A2) A2) $;

--| A way to express restricted uniqueness. (Contributed by NM, 24-Oct-2006.)
theorem reu3 {x3 y1: setvar} (ph: wff x3) (A2: class):
  $ wb (wreu x3 ph A2) (wa (wrex x3 ph A2) (wrex y1 (wral x3 (wi ph (wceq (cv x3) (cv y1))) A2) A2)) $;

--| A condition which implies existential uniqueness. (Contributed by Mario Carneiro, 2-Oct-2015.)
theorem reu6i {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (wa (wcel B2 A2) (wral x3 (wb ph (wceq (cv x3) B2)) A2)) (wreu x3 ph A2) $;

--| A condition which implies existential uniqueness. (Contributed by Mario Carneiro, 2-Oct-2015.)
theorem eqreu {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wceq (cv x3) B2) (wb ph ps) $ >
  $ wi (w3a (wcel B2 A2) ps (wral x3 (wi ph (wceq (cv x3) B2)) A2)) (wreu x3 ph A2) $;

--| Restricted "at most one" using implicit substitution. (Contributed by NM, 24-Oct-2006.) (Revised by NM, 16-Jun-2017.)
theorem rmo4 {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wrmo x3 ph A2) (wral x3 (wral y1 (wi (wa ph ps) (wceq (cv x3) (cv y1))) A2) A2) $;

--| Restricted uniqueness using implicit substitution. (Contributed by NM, 23-Nov-1994.)
theorem reu4 {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wreu x3 ph A2) (wa (wrex x3 ph A2) (wral x3 (wral y1 (wi (wa ph ps) (wceq (cv x3) (cv y1))) A2) A2)) $;

--| Restricted uniqueness using implicit substitution. (Contributed by NM, 24-Oct-2006.)
theorem reu7 {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wreu x3 ph A2) (wa (wrex x3 ph A2) (wrex x3 (wral y1 (wi ps (wceq (cv x3) (cv y1))) A2) A2)) $;

--| Restricted uniqueness using implicit substitution. (Contributed by NM, 24-Oct-2006.)
theorem reu8 {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wreu x3 ph A2) (wrex x3 (wa ph (wral y1 (wi ps (wceq (cv x3) (cv y1))) A2)) A2) $;

--| Restricted "at most one" using explicit substitution. (Contributed by NM, 4-Nov-2012.) (Revised by NM, 16-Jun-2017.) (Revised by Thierry Arnoux, 8-Oct-2017.)
theorem rmo3f {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wnf y1 ph $ >
  $ wb (wrmo x3 ph A2) (wral x3 (wral y1 (wi (wa ph (wsb x3 ph y1)) (wceq (cv x3) (cv y1))) A2) A2) $;

--| Restricted "at most one" using implicit substitution. (Contributed by NM, 24-Oct-2006.) (Revised by Thierry Arnoux, 11-Oct-2016.) (Revised by Thierry Arnoux, 8-Mar-2017.) (Revised by Thierry Arnoux, 8-Oct-2017.)
theorem rmo4f {x3 y1: setvar} (ph: wff x3) (ps: wff x3 y1) (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wrmo x3 ph A2) (wral x3 (wral y1 (wi (wa ph ps) (wceq (cv x3) (cv y1))) A2) A2) $;

--| Deduce equality from restricted uniqueness, deduction version. (Contributed by Thierry Arnoux, 27-Nov-2019.)
theorem reu2eqd {x3: setvar} (ph ps: wff x3) (ch th: wff) (A2 B2 C: class):
  $ wi (wceq (cv x3) B2) (wb ps ch) $ >
  $ wi (wceq (cv x3) C) (wb ps th) $ >
  $ wi ph (wreu x3 ps A2) $ >
  $ wi ph (wcel B2 A2) $ >
  $ wi ph (wcel C A2) $ >
  $ wi ph ch $ >
  $ wi ph th $ >
  $ wi ph (wceq B2 C) $;

--| Equality has existential uniqueness. (Contributed by Mario Carneiro, 1-Sep-2015.)
theorem reueq {x3: setvar} (A2 B2: class):
  $ wb (wcel B2 A2) (wreu x3 (wceq (cv x3) B2) A2) $;

--| Equality's restricted existential "at most one" property. (Contributed by Thierry Arnoux, 30-Mar-2018.) (Revised by AV, 27-Oct-2020.) (Proof shortened by NM, 29-Oct-2020.)
theorem rmoeq {x3: setvar} (A2: class) (B2: class x3):
  $ wrmo x3 (wceq (cv x3) A2) B2 $;

--| Restricted "at most one" still holds when a conjunct is added. (Contributed by NM, 16-Jun-2017.)
theorem rmoan {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wrmo x3 ph A2) (wrmo x3 (wa ps ph) A2) $;

--| Restricted "at most one" is preserved through implication (note wff reversal). (Contributed by Alexander van der Vekens, 17-Jun-2017.)
theorem rmoim {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wral x3 (wi ph ps) A2) (wi (wrmo x3 ps A2) (wrmo x3 ph A2)) $;

--| Restricted "at most one" is preserved through implication (note wff reversal). (Contributed by Alexander van der Vekens, 17-Jun-2017.)
theorem rmoimia {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wcel (cv x3) A2) (wi ph ps) $ >
  $ wi (wrmo x3 ps A2) (wrmo x3 ph A2) $;

--| Restricted "at most one" is preserved through implication (note wff reversal). (Contributed by Alexander van der Vekens, 17-Jun-2017.)
theorem rmoimi {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi ph ps $ >
  $ wi (wrmo x3 ps A2) (wrmo x3 ph A2) $;

--| Restricted "at most one" is preserved through implication (note wff reversal). (Contributed by Alexander van der Vekens, 17-Jun-2017.)
theorem rmoimi2 {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wal x3 (wi (wa (wcel (cv x3) A2) ph) (wa (wcel (cv x3) B2) ps)) $ >
  $ wi (wrmo x3 ps B2) (wrmo x3 ph A2) $;

--| Double restricted existential uniqueness in terms of restricted existence and restricted "at most one". (Contributed by Alexander van der Vekens, 17-Jun-2017.)
theorem _2reu5a {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ wb (wreu x3 (wreu y1 ph B2) A2) (wa (wrex x3 (wa (wrex y1 ph B2) (wrmo y1 ph B2)) A2) (wrmo x3 (wa (wrex y1 ph B2) (wrmo y1 ph B2)) A2)) $;

--| Restricted uniqueness implies restricted "at most one" through implication, analogous to ~ euimmo . (Contributed by Alexander van der Vekens, 25-Jun-2017.)
theorem reuimrmo {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wral x3 (wi ph ps) A2) (wi (wreu x3 ps A2) (wrmo x3 ph A2)) $;

--| A condition allowing swap of uniqueness and existential quantifiers. (Contributed by Thierry Arnoux, 7-Apr-2017.) (Revised by NM, 16-Jun-2017.)
theorem _2reuswap {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class y1):
  $ wi (wral x3 (wrmo y1 ph B2) A2) (wi (wreu x3 (wrex y1 ph B2) A2) (wreu y1 (wrex x3 ph A2) B2)) $;

--| A condition allowing swap of uniqueness and existential quantifiers. (Contributed by Thierry Arnoux, 7-Apr-2017.)
theorem _2reuswap2 {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class y1):
  $ wi (wral x3 (wmo y1 (wa (wcel (cv y1) B2) ph)) A2) (wi (wreu x3 (wrex y1 ph B2) A2) (wreu y1 (wrex x3 ph A2) B2)) $;

--| Transfer existential uniqueness from a variable ` x ` to another variable ` y ` contained in expression ` A ` . (Contributed by NM, 16-Jan-2012.) Separate variables ` B ` and ` C ` . (Revised by Thierry Arnoux, 8-Oct-2017.)
theorem reuxfrd {x3 y1: setvar} (ph: wff) (ps: wff y1) (A2: class y1) (B2 C: class):
  $ wi (wa ph (wcel (cv y1) C)) (wcel A2 B2) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wrmo y1 (wceq (cv x3) A2) C) $ >
  $ wi ph (wb (wreu x3 (wrex y1 (wa (wceq (cv x3) A2) ps) C) B2) (wreu y1 ps C)) $;

--| Transfer existential uniqueness from a variable ` x ` to another variable ` y ` contained in expression ` A ` . (Contributed by NM, 14-Nov-2004.) (Revised by NM, 16-Jun-2017.)
theorem reuxfr {x3 y1: setvar} (ph: wff y1) (A2: class y1) (B2 C: class):
  $ wi (wcel (cv y1) C) (wcel A2 B2) $ >
  $ wi (wcel (cv x3) B2) (wrmo y1 (wceq (cv x3) A2) C) $ >
  $ wb (wreu x3 (wrex y1 (wa (wceq (cv x3) A2) ph) C) B2) (wreu y1 ph C) $;

--| Transfer existential uniqueness from a variable ` x ` to another variable ` y ` contained in expression ` A ` . Cf. ~ reuxfr1ds . (Contributed by Thierry Arnoux, 7-Apr-2017.)
theorem reuxfr1d {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (A2: class y1) (B2 C: class):
  $ wi (wa ph (wcel (cv y1) C)) (wcel A2 B2) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wreu y1 (wceq (cv x3) A2) C) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wreu x3 ps B2) (wreu y1 ch C)) $;

--| Transfer existential uniqueness from a variable ` x ` to another variable ` y ` contained in expression ` A ` . Use ~ reuhypd to eliminate the second hypothesis. (Contributed by NM, 16-Jan-2012.)
theorem reuxfr1ds {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (A2: class y1) (B2 C: class):
  $ wi (wa ph (wcel (cv y1) C)) (wcel A2 B2) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wreu y1 (wceq (cv x3) A2) C) $ >
  $ wi (wceq (cv x3) A2) (wb ps ch) $ >
  $ wi ph (wb (wreu x3 ps B2) (wreu y1 ch C)) $;

--| Transfer existential uniqueness from a variable ` x ` to another variable ` y ` contained in expression ` A ` . Use ~ reuhyp to eliminate the second hypothesis. (Contributed by NM, 14-Nov-2004.)
theorem reuxfr1 {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class y1) (B2 C: class):
  $ wi (wcel (cv y1) C) (wcel A2 B2) $ >
  $ wi (wcel (cv x3) B2) (wreu y1 (wceq (cv x3) A2) C) $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wreu x3 ph B2) (wreu y1 ps C) $;

--| Existential uniqueness via an indirect equality. (Contributed by NM, 16-Oct-2010.)
theorem reuind {x3 y1 z: setvar} (ph: wff x3) (ps: wff y1) (A2: class x3) (B2: class y1) (C: class):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq A2 B2) $ >
  $ wi (wa (wal x3 (wal y1 (wi (wa (wa (wcel A2 C) ph) (wa (wcel B2 C) ps)) (wceq A2 B2)))) (wex x3 (wa (wcel A2 C) ph))) (wreu z (wal x3 (wi (wa (wcel A2 C) ph) (wceq (cv z) A2))) C) $;

--| Double restricted quantification with "at most one", analogous to ~ 2moex . (Contributed by Alexander van der Vekens, 17-Jun-2017.)
theorem _2rmorex {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class y1):
  $ wi (wrmo x3 (wrex y1 ph B2) A2) (wral y1 (wrmo x3 ph A2) B2) $;

--| Lemma for ~ 2reu5 . Note that ` E! x e. A E! y e. B ph ` does not mean "there is exactly one ` x ` in ` A ` and exactly one ` y ` in ` B ` such that ` ph ` holds"; see comment for ~ 2eu5 . (Contributed by Alexander van der Vekens, 17-Jun-2017.)
theorem _2reu5lem1 {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wb (wreu x3 (wreu y1 ph B2) A2) (weu x3 (weu y1 (w3a (wcel (cv x3) A2) (wcel (cv y1) B2) ph))) $;

--| Lemma for ~ 2reu5 . (Contributed by Alexander van der Vekens, 17-Jun-2017.)
theorem _2reu5lem2 {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class x3 y1):
  $ wb (wral x3 (wrmo y1 ph B2) A2) (wal x3 (wmo y1 (w3a (wcel (cv x3) A2) (wcel (cv y1) B2) ph))) $;

--| Lemma for ~ 2reu5 . This lemma is interesting in its own right, showing that existential restriction in the last conjunct (the "at most one" part) is optional; compare ~ rmo2 . (Contributed by Alexander van der Vekens, 17-Jun-2017.)
theorem _2reu5lem3 {x3 y1 z w: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class y1):
  $ wb (wa (wreu x3 (wreu y1 ph B2) A2) (wral x3 (wrmo y1 ph B2) A2)) (wa (wrex x3 (wrex y1 ph B2) A2) (wex z (wex w (wral x3 (wral y1 (wi ph (wa (wceq (cv x3) (cv z)) (wceq (cv y1) (cv w)))) B2) A2)))) $;

--| Double restricted existential uniqueness in terms of restricted existential quantification and restricted universal quantification, analogous to ~ 2eu5 and ~ reu3 . (Contributed by Alexander van der Vekens, 17-Jun-2017.)
theorem _2reu5 {x3 y1 z w: setvar} (ph: wff x3 y1) (A2 B2: class):
  $ wb (wa (wreu x3 (wreu y1 ph B2) A2) (wral x3 (wrmo y1 ph B2) A2)) (wa (wrex x3 (wrex y1 ph B2) A2) (wrex z (wrex w (wral x3 (wral y1 (wi ph (wa (wceq (cv x3) (cv z)) (wceq (cv y1) (cv w)))) B2) A2) B2) A2)) $;

--| Double restricted quantification with restricted existential uniqueness and restricted "at most one", analogous to ~ 2eumo . (Contributed by Alexander van der Vekens, 24-Jun-2017.)
theorem _2reurmo {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ wi (wreu x3 (wrmo y1 ph B2) A2) (wrmo x3 (wreu y1 ph B2) A2) $;

--| Double restricted quantification with existential uniqueness, analogous to ~ 2euex . (Contributed by Alexander van der Vekens, 24-Jun-2017.)
theorem _2reurex {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class y1):
  $ wi (wreu x3 (wrex y1 ph B2) A2) (wrex y1 (wreu x3 ph A2) B2) $;

--| A condition allowing to swap restricted "at most one" and restricted existential quantifiers, analogous to ~ 2moswap . (Contributed by Alexander van der Vekens, 25-Jun-2017.)
theorem _2rmoswap {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class y1):
  $ wi (wral x3 (wrmo y1 ph B2) A2) (wi (wrmo x3 (wrex y1 ph B2) A2) (wrmo y1 (wrex x3 ph A2) B2)) $;

--| Double restricted existential uniqueness implies double restricted unique existential quantification, analogous to ~ 2exeu . (Contributed by Alexander van der Vekens, 25-Jun-2017.)
theorem _2rexreu {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class y1):
  $ wi (wa (wreu x3 (wrex y1 ph B2) A2) (wreu y1 (wrex x3 ph A2) B2)) (wreu x3 (wreu y1 ph B2) A2) $;

--| Extend wff notation to include conditional equality. This is a technical device used in the proof that ` F/ ` is the not-free predicate, and that definitions are conservative as a result.
term wcdeq (ph: wff) (x3 y1: setvar): wff;

--| Define conditional equality. All the notation to the left of the ` <-> ` is fake; the parentheses and arrows are all part of the notation, which could equally well be written ` CondEq x y ph ` . On the right side is the actual implication arrow. The reason for this definition is to "flatten" the structure on the right side (whose tree structure is something like (wi (wceq (cv vx) (cv vy)) wph) ) into just (wcdeq vx vy wph). (Contributed by Mario Carneiro, 11-Aug-2016.)
axiom df_cdeq (ph: wff) (x3 y1: setvar):
  $ wb (wcdeq ph x3 y1) (wi (wceq (cv x3) (cv y1)) ph) $;

--| Deduce conditional equality. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem cdeqi {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wceq (cv x3) (cv y1)) ph $ >
  $ wcdeq ph x3 y1 $;

--| Property of conditional equality. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem cdeqri {x3 y1: setvar} (ph: wff x3 y1):
  $ wcdeq ph x3 y1 $ >
  $ wi (wceq (cv x3) (cv y1)) ph $;

--| Deduce conditional equality from a theorem. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem cdeqth {x3 y1: setvar} (ph: wff x3 y1):
  $ ph $ >
  $ wcdeq ph x3 y1 $;

--| Distribute conditional equality over negation. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem cdeqnot {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wcdeq (wb ph ps) x3 y1 $ >
  $ wcdeq (wb (wn ph) (wn ps)) x3 y1 $;

--| Distribute conditional equality over quantification. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem cdeqal {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wcdeq (wb ph ps) x3 y1 $ >
  $ wcdeq (wb (wal z ph) (wal z ps)) x3 y1 $;

--| Distribute conditional equality over abstraction. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem cdeqab {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wcdeq (wb ph ps) x3 y1 $ >
  $ wcdeq (wceq (cab z ph) (cab z ps)) x3 y1 $;

--| Distribute conditional equality over quantification. Usage of this theorem is discouraged because it depends on ~ ax-13 . (Contributed by Mario Carneiro, 11-Aug-2016.) (New usage is discouraged.)
theorem cdeqal1 {x3 y1: setvar} (ph: wff x3) (ps: wff y1):
  $ wcdeq (wb ph ps) x3 y1 $ >
  $ wcdeq (wb (wal x3 ph) (wal y1 ps)) x3 y1 $;

--| Distribute conditional equality over abstraction. Usage of this theorem is discouraged because it depends on ~ ax-13 . (Contributed by Mario Carneiro, 11-Aug-2016.) (New usage is discouraged.)
theorem cdeqab1 {x3 y1: setvar} (ph: wff x3) (ps: wff y1):
  $ wcdeq (wb ph ps) x3 y1 $ >
  $ wcdeq (wceq (cab x3 ph) (cab y1 ps)) x3 y1 $;

--| Distribute conditional equality over implication. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem cdeqim {x3 y1: setvar} (ph ps ch th: wff x3 y1):
  $ wcdeq (wb ph ps) x3 y1 $ >
  $ wcdeq (wb ch th) x3 y1 $ >
  $ wcdeq (wb (wi ph ch) (wi ps th)) x3 y1 $;

--| Conditional equality for set-to-class promotion. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem cdeqcv {x3 y1: setvar}:
  $ wcdeq (wceq (cv x3) (cv y1)) x3 y1 $;

--| Distribute conditional equality over equality. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem cdeqeq {x3 y1: setvar} (A2 B2 C D: class x3 y1):
  $ wcdeq (wceq A2 B2) x3 y1 $ >
  $ wcdeq (wceq C D) x3 y1 $ >
  $ wcdeq (wb (wceq A2 C) (wceq B2 D)) x3 y1 $;

--| Distribute conditional equality over elementhood. (Contributed by Mario Carneiro, 11-Aug-2016.)
theorem cdeqel {x3 y1: setvar} (A2 B2 C D: class x3 y1):
  $ wcdeq (wceq A2 B2) x3 y1 $ >
  $ wcdeq (wceq C D) x3 y1 $ >
  $ wcdeq (wb (wcel A2 C) (wcel B2 D)) x3 y1 $;

--| If we have a conditional equality proof, where ` ph ` is ` ph ( x ) ` and ` ps ` is ` ph ( y ) ` , and ` ph ( x ) ` in fact does not have ` x ` free in it according to ` F/ ` , then ` ph ( x ) <-> ph ( y ) ` unconditionally. This proves that ` F/ x ph ` is actually a not-free predicate. Usage of this theorem is discouraged because it depends on ~ ax-13 . (Contributed by Mario Carneiro, 11-Aug-2016.) (New usage is discouraged.)
theorem nfcdeq {x3 y1: setvar} (ph: wff x3 y1) (ps: wff y1):
  $ wnf x3 ph $ >
  $ wcdeq (wb ph ps) x3 y1 $ >
  $ wb ph ps $;

--| Variation of ~ nfcdeq for classes. Usage of this theorem is discouraged because it depends on ~ ax-13 . (Contributed by Mario Carneiro, 11-Aug-2016.) Avoid ~ ax-11 . (Revised by GG, 19-May-2023.) (New usage is discouraged.)
theorem nfccdeq {x3 y1: setvar} (A2: class x3 y1) (B2: class y1):
  $ wnfc x3 A2 $ >
  $ wcdeq (wceq A2 B2) x3 y1 $ >
  $ wceq A2 B2 $;

--| Relative version of Russell's paradox ~ ru (which corresponds to the case ` A = _V ` ). Originally a subproof in ~ pwnss . (Contributed by Stefan O'Rear, 22-Feb-2015.) Avoid ~ df-nel . (Revised by Steven Nguyen, 23-Nov-2022.) Reduce axiom usage. (Revised by GG, 30-Aug-2024.)
theorem rru {x3: setvar} (A2: class):
  $ wn (wcel (crab x3 (wn (wcel (cv x3) (cv x3))) A2) A2) $;

--| Russell's Paradox. Proposition 4.14 of [TakeutiZaring] p. 14. In the late 1800s, Frege's Axiom of (unrestricted) Comprehension, expressed in our notation as ` A e. _V ` , asserted that any collection of sets ` A ` is a set i.e. belongs to the universe ` _V ` of all sets. In particular, by substituting ` { x | x e/ x } ` (the "Russell class") for ` A ` , it asserted ` { x | x e/ x } e. _V ` , meaning that the "collection of all sets which are not members of themselves" is a set. However, here we prove ` { x | x e/ x } e/ _V ` . This contradiction was discovered by Russell in 1901 (published in 1903), invalidating the Comprehension Axiom and leading to the collapse of Frege's system, which Frege acknowledged in the second edition of his _Grundgesetze der Arithmetik_. In 1908, Zermelo rectified this fatal flaw by replacing Comprehension with a weaker Subset (or Separation) Axiom ~ ssex asserting that ` A ` is a set only when it is smaller than some other set ` B ` . However, Zermelo was then faced with a "chicken and egg" problem of how to show ` B ` is a set, leading him to introduce the set-building axioms of Null Set ~ 0ex , Pairing ~ prex , Union ~ uniex , Power Set ~ pwex , and Infinity ~ omex to give him some starting sets to work with (all of which, before Russell's Paradox, were immediate consequences of Frege's Comprehension). In 1922 Fraenkel strengthened the Subset Axiom with our present Replacement Axiom ~ funimaex (whose modern formalization is due to Skolem, also in 1922). Thus, in a very real sense Russell's Paradox spawned the invention of ZF set theory and completely revised the foundations of mathematics! Another mainstream formalization of set theory, devised by von Neumann, Bernays, and Goedel, uses class variables rather than setvar variables as its primitives. The axiom system NBG in [Mendelson] p. 225 is suitable for a Metamath encoding. NBG is a conservative extension of ZF in that it proves exactly the same theorems as ZF that are expressible in the language of ZF. An advantage of NBG is that it is finitely axiomatizable - the Axiom of Replacement can be broken down into a finite set of formulas that eliminate its wff metavariable. Finite axiomatizability is required by some proof languages (although not by Metamath). There is a stronger version of NBG called Morse-Kelley (axiom system MK in [Mendelson] p. 287). Russell himself continued in a different direction, avoiding the paradox with his "theory of types". Quine extended Russell's ideas to formulate his New Foundations set theory (axiom system NF of [Quine] p. 331). In NF, the collection of all sets is a set, contrarily to ZF and NBG set theories. Russell's paradox has other consequences: when classes are too large (beyond the size of those used in standard mathematics), the axiom of choice ~ ac4 and Cantor's theorem ~ canth are provably false. (See ~ ncanth for some intuition behind the latter.) Recent results (as of 2014) seem to show that NF is equiconsistent to Z (ZF in which ~ ax-sep replaces ~ ax-rep ) with ~ ax-sep restricted to only bounded quantifiers. NF is finitely axiomatizable and can be encoded in Metamath using the axioms from T. Hailperin, "A set of axioms for logic", _J. Symb. Logic_ 9:1-19 (1944). Under our ZF set theory, every set is a member of the Russell class by ~ elirrv (derived from the Axiom of Regularity), so for us the Russell class equals the universe ` _V ` (Theorem ~ ruv ). See ~ ruALT for an alternate proof of ~ ru derived from that fact. (Contributed by NM, 7-Aug-1994.) Remove use of ~ ax-13 . (Revised by BJ, 12-Oct-2019.) Remove use of ~ ax-10 , ~ ax-11 , and ~ ax-12 . (Revised by BTernaryTau, 20-Jun-2025.) (Proof modification is discouraged.)
theorem ru {x3: setvar}:
  $ wnel (cab x3 (wnel (cv x3) (cv x3))) cvv $;

--| Extend wff notation to include the proper substitution of a class for a set. Read this notation as "the proper substitution of class ` A ` for setvar variable ` x ` in wff ` ph ` ".
term wsbc {x3: setvar} (ph: wff x3) (A2: class): wff;

--| Define the proper substitution of a class for a set. When ` A ` is a proper class, our definition evaluates to false (see ~ sbcex ). This is somewhat arbitrary: we could have, instead, chosen the conclusion of ~ sbc6 for our definition, whose right-hand side always evaluates to true for proper classes. Our definition also does not produce the same results as discussed in the proof of Theorem 6.6 of [Quine] p. 42 (although Theorem 6.6 itself does hold, as shown by ~ dfsbcq below). For example, if ` A ` is a proper class, Quine's substitution of ` A ` for ` y ` in ` 0 e. y ` evaluates to ` 0 e. A ` rather than our falsehood. (This can be seen by substituting ` A ` , ` y ` , and ` 0 ` for alpha, beta, and gamma in Subcase 1 of Quine's discussion on p. 42.) Unfortunately, Quine's definition requires a recursive syntactic breakdown of ` ph ` , and it does not seem possible to express it with a single closed formula. If we did not want to commit to any specific proper class behavior, we could use this definition _only_ to prove Theorem ~ dfsbcq , which holds for both our definition and Quine's, and from which we can derive a weaker version of ~ df-sbc in the form of ~ sbc8g . However, the behavior of Quine's definition at proper classes is similarly arbitrary, and for practical reasons (to avoid having to prove sethood of ` A ` in every use of this definition) we allow direct reference to ~ df-sbc and assert that ` [. A / x ]. ph ` is always false when ` A ` is a proper class. Theorem ~ sbc2or shows the apparently "strongest" statement we can make regarding behavior at proper classes if we start from ~ dfsbcq . The related definition ~ df-csb defines proper substitution into a class variable (as opposed to a wff variable). (Contributed by NM, 14-Apr-1995.) (Revised by NM, 25-Dec-2016.)
axiom df_sbc {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wsbc x3 ph A2) (wcel A2 (cab x3 ph)) $;

--| Proper substitution of a class for a set in a wff given equal classes. This is the essence of the sixth axiom of Frege, specifically Proposition 52 of [Frege1879] p. 50. This theorem, which is similar to Theorem 6.7 of [Quine] p. 42 and holds under both our definition and Quine's, provides us with a weak definition of the proper substitution of a class for a set. Since our ~ df-sbc does not result in the same behavior as Quine's for proper classes, if we wished to avoid conflict with Quine's definition we could start with this theorem and ~ dfsbcq2 instead of ~ df-sbc . ( ~ dfsbcq2 is needed because unlike Quine we do not overload the ~ df-sb syntax.) As a consequence of these theorems, we can derive ~ sbc8g , which is a weaker version of ~ df-sbc that leaves substitution undefined when ` A ` is a proper class. However, it is often a nuisance to have to prove the sethood hypothesis of ~ sbc8g , so we will allow direct use of ~ df-sbc after Theorem ~ sbc2or below. Proper substitution with a proper class is rarely needed, and when it is, we can simply use the expansion of Quine's definition. (Contributed by NM, 14-Apr-1995.)
theorem dfsbcq {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wi (wceq A2 B2) (wb (wsbc x3 ph A2) (wsbc x3 ph B2)) $;

--| This theorem, which is similar to Theorem 6.7 of [Quine] p. 42 and holds under both our definition and Quine's, relates logic substitution ~ df-sb and substitution for class variables ~ df-sbc . Unlike Quine, we use a different syntax for each in order to avoid overloading it. See remarks in ~ dfsbcq . (Contributed by NM, 31-Dec-2016.)
theorem dfsbcq2 {x3: setvar} (ph: wff x3) (y1: setvar) (A2: class x3):
  $ wi (wceq (cv y1) A2) (wb (wsb x3 ph y1) (wsbc x3 ph A2)) $;

--| This theorem, which is similar to Theorem 6.7 of [Quine] p. 42 and holds under both our definition and Quine's, relates logic substitution ~ df-sb and substitution for class variables ~ df-sbc . Unlike Quine, we use a different syntax for each in order to avoid overloading it. See remarks in ~ dfsbcq . (Contributed by NM, 31-Dec-2016.)
theorem dfsbcq2_b {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wceq (cv x3) A2) (wb (wsb x3 ph x3) (wsbc x3 ph A2)) $;

--| Show that ~ df-sb and ~ df-sbc are equivalent when the class term ` A ` in ~ df-sbc is a setvar variable. This theorem lets us reuse theorems based on ~ df-sb for proofs involving ~ df-sbc . (Contributed by NM, 31-Dec-2016.) (Proof modification is discouraged.)
theorem sbsbc {x3: setvar} (ph: wff x3) (y1: setvar):
  $ wb (wsb x3 ph y1) (wsbc x3 ph (cv y1)) $;

--| Show that ~ df-sb and ~ df-sbc are equivalent when the class term ` A ` in ~ df-sbc is a setvar variable. This theorem lets us reuse theorems based on ~ df-sb for proofs involving ~ df-sbc . (Contributed by NM, 31-Dec-2016.) (Proof modification is discouraged.)
theorem sbsbc_b {x3: setvar} (ph: wff x3):
  $ wb (wsb x3 ph x3) (wsbc x3 ph (cv x3)) $;

--| Equality theorem for class substitution. (Contributed by Mario Carneiro, 9-Feb-2017.) (Revised by NM, 30-Jun-2018.)
theorem sbceq1d {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wsbc x3 ps A2) (wsbc x3 ps B2)) $;

--| Equality theorem for class substitution. (Contributed by Mario Carneiro, 9-Feb-2017.) (Revised by NM, 30-Jun-2018.)
theorem sbceq1dd {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wsbc x3 ps A2) $ >
  $ wi ph (wsbc x3 ps B2) $;

--| Equality theorem for class substitution. (Contributed by Thierry Arnoux, 4-Sep-2018.)
theorem sbceqbid {x3: setvar} (ph: wff) (ps ch: wff x3) (A2 B2: class x3):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wsbc x3 ps A2) (wsbc x3 ch B2)) $;

--| This is the closest we can get to ~ df-sbc if we start from ~ dfsbcq (see its comments) and ~ dfsbcq2 . (Contributed by NM, 18-Nov-2008.) (Proof shortened by Andrew Salmon, 29-Jun-2011.) (Proof modification is discouraged.)
theorem sbc8g {x3: setvar} (ph: wff x3) (A2 V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 ph A2) (wcel A2 (cab x3 ph))) $;

--| The disjunction of two equivalences for class substitution does not require a class existence hypothesis. This theorem tells us that there are only 2 possibilities for ` [ A / x ] ph ` behavior at proper classes, matching the ~ sbc5 (false) and ~ sbc6 (true) conclusions. This is interesting since ~ dfsbcq and ~ dfsbcq2 (from which it is derived) do not appear to say anything obvious about proper class behavior. Note that this theorem does not tell us that it is always one or the other at proper classes; it could "flip" between false (the first disjunct) and true (the second disjunct) as a function of some other variable ` y ` that ` ph ` or ` A ` may contain. (Contributed by NM, 11-Oct-2004.) (Proof modification is discouraged.)
theorem sbc2or {x3: setvar} (ph: wff x3) (A2: class):
  $ wo (wb (wsbc x3 ph A2) (wex x3 (wa (wceq (cv x3) A2) ph))) (wb (wsbc x3 ph A2) (wal x3 (wi (wceq (cv x3) A2) ph))) $;

--| By our definition of proper substitution, it can only be true if the substituted expression is a set. (Contributed by Mario Carneiro, 13-Oct-2016.)
theorem sbcex {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wsbc x3 ph A2) (wcel A2 cvv) $;

--| Equality theorem for class substitution. Class version of ~ sbequ12 . (Contributed by NM, 26-Sep-2003.)
theorem sbceq1a {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wceq (cv x3) A2) (wb ph (wsbc x3 ph A2)) $;

--| Equality theorem for class substitution. Class version of ~ sbequ12r . (Contributed by NM, 4-Jan-2017.)
theorem sbceq2a {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wceq A2 (cv x3)) (wb (wsbc x3 ph A2) ph) $;

--| Specialization: if a formula is true for all sets, it is true for any class which is a set. Similar to Theorem 6.11 of [Quine] p. 44. This is Frege's ninth axiom per Proposition 58 of [Frege1879] p. 51. See also ~ stdpc4 and ~ rspsbc . (Contributed by NM, 16-Jan-2004.)
theorem spsbc {x3: setvar} (ph: wff x3) (A2 V: class x3):
  $ wi (wcel A2 V) (wi (wal x3 ph) (wsbc x3 ph A2)) $;

--| Specialization: if a formula is true for all sets, it is true for any class which is a set. Similar to Theorem 6.11 of [Quine] p. 44. See also ~ stdpc4 and ~ rspsbc . (Contributed by Mario Carneiro, 9-Feb-2017.)
theorem spsbcd {x3: setvar} (ph ps: wff x3) (A2 V: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wal x3 ps) $ >
  $ wi ph (wsbc x3 ps A2) $;

--| A substitution into a theorem remains true (when ` A ` is a set). (Contributed by NM, 5-Nov-2005.)
theorem sbcth {x3: setvar} (ph: wff x3) (A2 V: class x3):
  $ ph $ >
  $ wi (wcel A2 V) (wsbc x3 ph A2) $;

--| Deduction version of ~ sbcth . (Contributed by NM, 30-Nov-2005.) (Proof shortened by Andrew Salmon, 8-Jun-2011.)
theorem sbcthdv {x3: setvar} (ph: wff) (ps: wff x3) (A2 V: class x3):
  $ wi ph ps $ >
  $ wi (wa ph (wcel A2 V)) (wsbc x3 ps A2) $;

--| An identity theorem for substitution. See ~ sbid . (Contributed by Mario Carneiro, 18-Feb-2017.)
theorem sbcid {x3: setvar} (ph: wff x3):
  $ wb (wsbc x3 ph (cv x3)) ph $;

--| Deduction version of ~ nfsbc1 . (Contributed by NM, 23-May-2006.) (Revised by Mario Carneiro, 12-Oct-2016.)
theorem nfsbc1d {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnf x3 (wsbc x3 ps A2)) $;

--| Bound-variable hypothesis builder for class substitution. (Contributed by NM, 5-Aug-1993.) (Revised by Mario Carneiro, 12-Oct-2016.)
theorem nfsbc1 {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wnf x3 (wsbc x3 ph A2) $;

--| Bound-variable hypothesis builder for class substitution. (Contributed by Mario Carneiro, 12-Oct-2016.)
theorem nfsbc1v {x3: setvar} (ph: wff x3) (A2: class):
  $ wnf x3 (wsbc x3 ph A2) $;

--| Deduction version of ~ nfsbcw . Version of ~ nfsbcd with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by NM, 23-Nov-2005.) Avoid ~ ax-13 . (Revised by GG, 10-Jan-2024.)
theorem nfsbcdw {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3 y1):
  $ wnf y1 ph $ >
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnf x3 (wsbc y1 ps A2)) $;

--| Bound-variable hypothesis builder for class substitution. Version of ~ nfsbc with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by NM, 7-Sep-2014.) Avoid ~ ax-13 . (Revised by GG, 10-Jan-2024.)
theorem nfsbcw {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnf x3 ph $ >
  $ wnf x3 (wsbc y1 ph A2) $;

--| A composition law for class substitution. Version of ~ sbcco with a disjoint variable condition, which requires fewer axioms. (Contributed by NM, 26-Sep-2003.) Avoid ~ ax-13 . (Revised by GG, 10-Jan-2024.)
theorem sbccow {x3 y1: setvar} (ph: wff x3) (A2: class x3 y1):
  $ wb (wsbc y1 (wsbc x3 ph (cv y1)) A2) (wsbc x3 ph A2) $;

--| Deduction version of ~ nfsbc . Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ nfsbcdw when possible. (Contributed by NM, 23-Nov-2005.) (Revised by Mario Carneiro, 12-Oct-2016.) (New usage is discouraged.)
theorem nfsbcd {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3 y1):
  $ wnf y1 ph $ >
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnf x3 (wsbc y1 ps A2)) $;

--| Bound-variable hypothesis builder for class substitution. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ nfsbcw when possible. (Contributed by NM, 7-Sep-2014.) (Revised by Mario Carneiro, 12-Oct-2016.) (New usage is discouraged.)
theorem nfsbc {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnf x3 ph $ >
  $ wnf x3 (wsbc y1 ph A2) $;

--| A composition law for class substitution. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ sbccow when possible. (Contributed by NM, 26-Sep-2003.) (Revised by Mario Carneiro, 13-Oct-2016.) (New usage is discouraged.)
theorem sbcco {x3 y1: setvar} (ph: wff x3) (A2: class x3 y1):
  $ wb (wsbc y1 (wsbc x3 ph (cv y1)) A2) (wsbc x3 ph A2) $;

--| A composition law for class substitution. Importantly, ` x ` may occur free in the class expression substituted for ` A ` . (Contributed by NM, 5-Sep-2004.) (Proof shortened by Andrew Salmon, 8-Jun-2011.)
theorem sbcco2 {x3 y1: setvar} (ph: wff x3) (A2: class x3) (B2: class x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wceq A2 B2) $ >
  $ wb (wsbc y1 (wsbc x3 ph B2) (cv x3)) (wsbc x3 ph A2) $;

--| An equivalence for class substitution. (Contributed by NM, 23-Aug-1993.) (Revised by Mario Carneiro, 12-Oct-2016.) (Proof shortened by SN, 2-Sep-2024.)
theorem sbc5 {x3: setvar} (ph: wff x3) (A2: class):
  $ wb (wsbc x3 ph A2) (wex x3 (wa (wceq (cv x3) A2) ph)) $;

--| Alternate proof of ~ sbc5 . This proof helps show how ~ clelab works, since it is equivalent but shorter thanks to now-available library theorems like ~ vtoclbg and ~ isset . (Contributed by NM, 23-Aug-1993.) (Revised by Mario Carneiro, 12-Oct-2016.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem sbc5ALT {x3: setvar} (ph: wff x3) (A2: class):
  $ wb (wsbc x3 ph A2) (wex x3 (wa (wceq (cv x3) A2) ph)) $;

--| An equivalence for class substitution. (Contributed by NM, 11-Oct-2004.) (Proof shortened by Andrew Salmon, 8-Jun-2011.) (Proof shortened by SN, 5-Oct-2024.)
theorem sbc6g {x3: setvar} (ph: wff x3) (A2: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 ph A2) (wal x3 (wi (wceq (cv x3) A2) ph))) $;

--| An equivalence for class substitution. (Contributed by NM, 23-Aug-1993.) (Proof shortened by Eric Schmidt, 17-Jan-2007.)
theorem sbc6 {x3: setvar} (ph: wff x3) (A2: class):
  $ wcel A2 cvv $ >
  $ wb (wsbc x3 ph A2) (wal x3 (wi (wceq (cv x3) A2) ph)) $;

--| An equivalence for class substitution in the spirit of ~ df-clab . Note that ` x ` and ` A ` don't have to be distinct. (Contributed by NM, 18-Nov-2008.) (Revised by Mario Carneiro, 13-Oct-2016.)
theorem sbc7 {x3 y1: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wsbc x3 ph A2) (wex y1 (wa (wceq (cv y1) A2) (wsbc x3 ph (cv y1)))) $;

--| Change bound variables in a wff substitution. Version of ~ cbvsbc with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by Jeff Hankins, 19-Sep-2009.) Avoid ~ ax-13 . (Revised by GG, 10-Jan-2024.)
theorem cbvsbcw {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3 y1):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wsbc x3 ph A2) (wsbc y1 ps A2) $;

--| Change the bound variable of a class substitution using implicit substitution. Version of ~ cbvsbcv with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by NM, 30-Sep-2008.) Avoid ~ ax-13 . (Revised by GG, 10-Jan-2024.)
theorem cbvsbcvw {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wsbc x3 ph A2) (wsbc y1 ps A2) $;

--| Change bound variables in a wff substitution. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ cbvsbcw when possible. (Contributed by Jeff Hankins, 19-Sep-2009.) (Proof shortened by Andrew Salmon, 8-Jun-2011.) (New usage is discouraged.)
theorem cbvsbc {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3 y1):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wsbc x3 ph A2) (wsbc y1 ps A2) $;

--| Change the bound variable of a class substitution using implicit substitution. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ cbvsbcvw when possible. (Contributed by NM, 30-Sep-2008.) (Revised by Mario Carneiro, 13-Oct-2016.) (New usage is discouraged.)
theorem cbvsbcv {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wsbc x3 ph A2) (wsbc y1 ps A2) $;

--| Conversion of implicit substitution to explicit class substitution, using a bound-variable hypothesis instead of distinct variables. (Closed theorem version of ~ sbciegf .) (Contributed by NM, 10-Nov-2005.) (Revised by Mario Carneiro, 13-Oct-2016.) (Proof shortened by SN, 14-May-2025.)
theorem sbciegft {x3: setvar} (ph ps: wff x3) (A2: class) (V: class x3):
  $ wi (w3a (wcel A2 V) (wnf x3 ps) (wal x3 (wi (wceq (cv x3) A2) (wb ph ps)))) (wb (wsbc x3 ph A2) ps) $;

--| Conversion of implicit substitution to explicit class substitution. (Contributed by NM, 14-Dec-2005.) (Revised by Mario Carneiro, 13-Oct-2016.)
theorem sbciegf {x3: setvar} (ph ps: wff x3) (A2: class) (V: class x3):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wb (wsbc x3 ph A2) ps) $;

--| Conversion of implicit substitution to explicit class substitution. (Contributed by NM, 10-Nov-2005.) Avoid ~ ax-10 , ~ ax-12 . (Revised by GG, 12-Oct-2024.)
theorem sbcieg {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (V: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wb (wsbc x3 ph A2) ps) $;

--| Conversion of implicit substitution to explicit class substitution. This version of ~ sbcie avoids a disjointness condition on ` x , A ` by substituting twice. (Contributed by Mario Carneiro, 15-Oct-2016.)
theorem sbcie2g {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (ch: wff x3) (A2: class x3) (V: class x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wceq (cv y1) A2) (wb ps ch) $ >
  $ wi (wcel A2 V) (wb (wsbc x3 ph A2) ch) $;

--| Conversion of implicit substitution to explicit class substitution. (Contributed by NM, 4-Sep-2004.)
theorem sbcie {x3: setvar} (ph: wff x3) (ps: wff) (A2: class):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wsbc x3 ph A2) ps $;

--| Conversion of implicit substitution to explicit class substitution, deduction form. (Contributed by NM, 29-Dec-2014.)
theorem sbciedf {x3: setvar} (ph ps ch: wff x3) (A2: class) (V: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wnf x3 ph $ >
  $ wi ph (wnf x3 ch) $ >
  $ wi ph (wb (wsbc x3 ps A2) ch) $;

--| Conversion of implicit substitution to explicit class substitution, deduction form. (Contributed by NM, 13-Dec-2014.) Avoid ~ ax-10 , ~ ax-12 . (Revised by GG, 12-Oct-2024.)
theorem sbcied {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2: class) (V: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wsbc x3 ps A2) ch) $;

--| Conversion of implicit substitution to explicit class substitution, deduction form. (Contributed by NM, 13-Dec-2014.)
theorem sbcied2 {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (A2: class) (B2 V: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi (wa ph (wceq (cv x3) B2)) (wb ps ch) $ >
  $ wi ph (wb (wsbc x3 ps A2) ch) $;

--| Membership in a restricted class abstraction, expressed with explicit class substitution. (The variation ~ elrabf has implicit substitution). The hypothesis specifies that ` x ` must not be a free variable in ` B ` . (Contributed by NM, 30-Sep-2003.) (Proof shortened by Mario Carneiro, 13-Oct-2016.)
theorem elrabsf {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wnfc x3 B2 $ >
  $ wb (wcel A2 (crab x3 ph B2)) (wa (wcel A2 B2) (wsbc x3 ph A2)) $;

--| Substitution for the left-hand side in an equality. Class version of ~ eqsb1 . (Contributed by Andrew Salmon, 29-Jun-2011.) Avoid ~ ax-13 . (Revised by Wolf Lammen, 29-Apr-2023.)
theorem eqsbc1 {x3: setvar} (A2: class x3) (B2: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wceq (cv x3) B2) A2) (wceq A2 B2)) $;

--| Move negation in and out of class substitution. (Contributed by NM, 16-Jan-2004.)
theorem sbcng {x3: setvar} (ph: wff x3) (A2 V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wn ph) A2) (wn (wsbc x3 ph A2))) $;

--| Distribution of class substitution over implication. (Contributed by NM, 16-Jan-2004.)
theorem sbcimg {x3: setvar} (ph ps: wff x3) (A2 V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wi ph ps) A2) (wi (wsbc x3 ph A2) (wsbc x3 ps A2))) $;

--| Distribution of class substitution over conjunction. (Contributed by NM, 31-Dec-2016.) (Revised by NM, 17-Aug-2018.)
theorem sbcan {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb (wsbc x3 (wa ph ps) A2) (wa (wsbc x3 ph A2) (wsbc x3 ps A2)) $;

--| Distribution of class substitution over disjunction. (Contributed by NM, 31-Dec-2016.) (Revised by NM, 17-Aug-2018.)
theorem sbcor {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb (wsbc x3 (wo ph ps) A2) (wo (wsbc x3 ph A2) (wsbc x3 ps A2)) $;

--| Distribution of class substitution over biconditional. (Contributed by Raph Levien, 10-Apr-2004.)
theorem sbcbig {x3: setvar} (ph ps: wff x3) (A2 V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wb ph ps) A2) (wb (wsbc x3 ph A2) (wsbc x3 ps A2))) $;

--| Move negation in and out of class substitution. One direction of ~ sbcng that holds for proper classes. (Contributed by NM, 17-Aug-2018.)
theorem sbcn1 {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wsbc x3 (wn ph) A2) (wn (wsbc x3 ph A2)) $;

--| Distribution of class substitution over implication. One direction of ~ sbcimg that holds for proper classes. (Contributed by NM, 17-Aug-2018.) Avoid ~ ax-10 , ~ ax-12 . (Revised by SN, 26-Oct-2024.)
theorem sbcim1 {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wsbc x3 (wi ph ps) A2) (wi (wsbc x3 ph A2) (wsbc x3 ps A2)) $;

--| Formula-building deduction for class substitution. (Contributed by NM, 29-Dec-2014.)
theorem sbcbid {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wsbc x3 ps A2) (wsbc x3 ch A2)) $;

--| Formula-building deduction for class substitution. (Contributed by NM, 29-Dec-2014.) Drop ~ ax-12 . (Revised by GG, 1-Dec-2023.)
theorem sbcbidv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wsbc x3 ps A2) (wsbc x3 ch A2)) $;

--| Formula-building inference for class substitution. (Contributed by NM, 11-Nov-2005.)
theorem sbcbii {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb ph ps $ >
  $ wb (wsbc x3 ph A2) (wsbc x3 ps A2) $;

--| Distribution of class substitution over biconditional. One direction of ~ sbcbig that holds for proper classes. (Contributed by NM, 17-Aug-2018.)
theorem sbcbi1 {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wsbc x3 (wb ph ps) A2) (wb (wsbc x3 ph A2) (wsbc x3 ps A2)) $;

--| Substituting into equivalent wff's gives equivalent results. (Contributed by Giovanni Mascellani, 9-Apr-2018.) (Proof shortened by Wolf Lammen, 4-May-2023.) Avoid ~ ax-10 , ~ ax-12 . (Revised by Steven Nguyen, 5-May-2024.)
theorem sbcbi2 {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wal x3 (wb ph ps)) (wb (wsbc x3 ph A2) (wsbc x3 ps A2)) $;

--| Move universal quantifier in and out of class substitution. (Contributed by NM, 31-Dec-2016.) (Revised by NM, 18-Aug-2018.)
theorem sbcal {x3 y1: setvar} (ph: wff x3 y1) (A2: class y1):
  $ wb (wsbc y1 (wal x3 ph) A2) (wal x3 (wsbc y1 ph A2)) $;

--| Move existential quantifier in and out of class substitution. (Contributed by NM, 21-May-2004.) (Revised by NM, 18-Aug-2018.)
theorem sbcex2 {x3 y1: setvar} (ph: wff x3 y1) (A2: class y1):
  $ wb (wsbc y1 (wex x3 ph) A2) (wex x3 (wsbc y1 ph A2)) $;

--| Class version of one implication of ~ equvelv . (Contributed by Andrew Salmon, 28-Jun-2011.) (Proof shortened by SN, 26-Oct-2024.)
theorem sbceqal {x3: setvar} (A2 B2: class) (V: class x3):
  $ wi (wcel A2 V) (wi (wal x3 (wi (wceq (cv x3) A2) (wceq (cv x3) B2))) (wceq A2 B2)) $;

--| Theorem *14.121 in [WhiteheadRussell] p. 185. (Contributed by Andrew Salmon, 28-Jun-2011.) (Proof shortened by Wolf Lammen, 9-May-2013.)
theorem sbeqalb {x3: setvar} (ph: wff x3) (A2 B2: class) (V: class x3):
  $ wi (wcel A2 V) (wi (wa (wal x3 (wb ph (wceq (cv x3) A2))) (wal x3 (wb ph (wceq (cv x3) B2)))) (wceq A2 B2)) $;

--| Substitution for the right-hand side in an equality. (Contributed by Alan Sare, 24-Oct-2011.) (Proof shortened by JJ, 7-Jul-2021.)
theorem eqsbc2 {x3: setvar} (A2: class x3) (B2: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wceq B2 (cv x3)) A2) (wceq B2 A2)) $;

--| Distribution of class substitution over triple conjunction. (Contributed by NM, 14-Dec-2006.) (Revised by NM, 17-Aug-2018.)
theorem sbc3an {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wb (wsbc x3 (w3a ph ps ch) A2) (w3a (wsbc x3 ph A2) (wsbc x3 ps A2) (wsbc x3 ch A2)) $;

--| Class substitution into a membership relation. (Contributed by NM, 17-Aug-2018.) Avoid ~ ax-13 . (Revised by Wolf Lammen, 30-Apr-2023.)
theorem sbcel1v {x3: setvar} (A2: class x3) (B2: class):
  $ wb (wsbc x3 (wcel (cv x3) B2) A2) (wcel A2 B2) $;

--| Class substitution into a membership relation. (Contributed by NM, 17-Nov-2006.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem sbcel2gv {x3: setvar} (A2: class) (B2 V: class x3):
  $ wi (wcel B2 V) (wb (wsbc x3 (wcel A2 (cv x3)) B2) (wcel A2 B2)) $;

--| Class substitution into a membership relation. One direction of ~ sbcel2gv that holds for proper classes. (Contributed by NM, 17-Aug-2018.)
theorem sbcel21v {x3: setvar} (A2: class) (B2: class x3):
  $ wi (wsbc x3 (wcel A2 (cv x3)) B2) (wcel A2 B2) $;

--| Substitution analogue of Theorem 19.20 of [Margaris] p. 90 ( ~ alim ). (Contributed by NM, 11-Nov-2005.) (Revised by NM, 17-Aug-2018.) (Proof shortened by JJ, 7-Jul-2021.) Reduce axiom usage. (Revised by GG, 12-Oct-2024.)
theorem sbcimdv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi (wsbc x3 ps A2) (wsbc x3 ch A2)) $;

--| Substitution for a variable not free in a wff does not affect it. (Contributed by Mario Carneiro, 14-Oct-2016.)
theorem sbctt {x3: setvar} (ph: wff x3) (A2 V: class x3):
  $ wi (wa (wcel A2 V) (wnf x3 ph)) (wb (wsbc x3 ph A2) ph) $;

--| Substitution for a variable not free in a wff does not affect it. (Contributed by NM, 11-Oct-2004.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem sbcgf {x3: setvar} (ph: wff x3) (A2 V: class x3):
  $ wnf x3 ph $ >
  $ wi (wcel A2 V) (wb (wsbc x3 ph A2) ph) $;

--| Substitution for a variable not free in antecedent affects only the consequent. (Contributed by NM, 11-Oct-2004.)
theorem sbc19_21g {x3: setvar} (ph ps: wff x3) (A2 V: class x3):
  $ wnf x3 ph $ >
  $ wi (wcel A2 V) (wb (wsbc x3 (wi ph ps) A2) (wi ph (wsbc x3 ps A2))) $;

--| Substitution for a variable not occurring in a wff does not affect it. Distinct variable form of ~ sbcgf . (Contributed by Alan Sare, 10-Nov-2012.) Reduce axiom usage. (Revised by GG, 12-Oct-2024.)
theorem sbcg {x3: setvar} (ph: wff) (A2 V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 ph A2) ph) $;

--| Substitution for a variable not free in a wff does not affect it, in inference form. (Contributed by Giovanni Mascellani, 1-Jun-2019.)
theorem sbcgfi {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wcel A2 cvv $ >
  $ wnf x3 ph $ >
  $ wb (wsbc x3 ph A2) ph $;

--| Substituting a class in the false truth constant results in the false truth constant. The analogous result with the true truth constant does not hold in general since substituting a proper class results in falsehood ( ~ sbcex ), but holds for sets by ~ sbcg . (Contributed by BJ, 11-Oct-2026.)
theorem sbcfal {x3: setvar} (A2: class x3):
  $ wb (wsbc x3 wfal A2) wfal $;

--| Conversion of implicit substitution to explicit class substitution. (Contributed by Mario Carneiro, 19-Dec-2013.)
theorem sbc2iegf {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class) (B2: class x3) (V: class y1) (W: class x3):
  $ wnf x3 ps $ >
  $ wnf y1 ps $ >
  $ wnf x3 (wcel B2 W) $ >
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wsbc x3 (wsbc y1 ph B2) A2) ps) $;

--| Conversion of implicit substitution to explicit class substitution. (Contributed by NM, 16-Dec-2008.) (Revised by Mario Carneiro, 19-Dec-2013.) (Proof shortened by GG, 12-Oct-2024.)
theorem sbc2ie {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2: class) (B2: class x3):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ wb (wsbc x3 (wsbc y1 ph B2) A2) ps $;

--| Conversion of implicit substitution to explicit class substitution. (Contributed by NM, 16-Dec-2008.) (Proof shortened by Mario Carneiro, 18-Oct-2016.)
theorem sbc2iedv {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (ch: wff) (A2: class) (B2: class x3):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi ph (wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ps ch)) $ >
  $ wi ph (wb (wsbc x3 (wsbc y1 ps B2) A2) ch) $;

--| Conversion of implicit substitution to explicit class substitution. (Contributed by Mario Carneiro, 19-Jun-2014.) (Revised by Mario Carneiro, 29-Dec-2014.)
theorem sbc3ie {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff) (A2: class) (B2: class x3) (C: class x3 y1):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wi (w3a (wceq (cv x3) A2) (wceq (cv y1) B2) (wceq (cv z) C)) (wb ph ps) $ >
  $ wb (wsbc x3 (wsbc y1 (wsbc z ph C) B2) A2) ps $;

--| Lemma for ~ sbccom . (Contributed by NM, 14-Nov-2005.) (Revised by Mario Carneiro, 18-Oct-2016.) Avoid ~ ax-10 , ~ ax-12 . (Revised by SN, 20-Aug-2025.)
theorem sbccomlem {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class):
  $ wb (wsbc x3 (wsbc y1 ph B2) A2) (wsbc y1 (wsbc x3 ph A2) B2) $;

--| Commutative law for double class substitution. (Contributed by NM, 15-Nov-2005.) (Proof shortened by Mario Carneiro, 18-Oct-2016.)
theorem sbccom {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class y1):
  $ wb (wsbc x3 (wsbc y1 ph B2) A2) (wsbc y1 (wsbc x3 ph A2) B2) $;

--| Interchange class substitution and restricted quantifier. (Contributed by NM, 1-Mar-2008.) (Revised by David Abernethy, 22-Feb-2010.)
theorem sbcralt {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1) (B2: class y1) (V: class x3 y1):
  $ wi (wa (wcel A2 V) (wnfc y1 A2)) (wb (wsbc x3 (wral y1 ph B2) A2) (wral y1 (wsbc x3 ph A2) B2)) $;

--| Interchange class substitution and restricted existential quantifier. (Contributed by NM, 1-Mar-2008.) (Proof shortened by Mario Carneiro, 13-Oct-2016.) (Revised by NM, 18-Aug-2018.) (Proof shortened by JJ, 7-Jul-2021.)
theorem sbcrext {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1) (B2: class y1):
  $ wi (wnfc y1 A2) (wb (wsbc x3 (wrex y1 ph B2) A2) (wrex y1 (wsbc x3 ph A2) B2)) $;

--| Interchange class substitution and restricted quantifier. (Contributed by NM, 15-Nov-2005.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem sbcralg {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class y1) (V: class x3 y1):
  $ wi (wcel A2 V) (wb (wsbc x3 (wral y1 ph B2) A2) (wral y1 (wsbc x3 ph A2) B2)) $;

--| Interchange class substitution and restricted existential quantifier. (Contributed by NM, 15-Nov-2005.) (Revised by NM, 18-Aug-2018.)
theorem sbcrex {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class y1):
  $ wb (wsbc x3 (wrex y1 ph B2) A2) (wrex y1 (wsbc x3 ph A2) B2) $;

--| Interchange class substitution and restricted unique existential quantifier. (Contributed by NM, 24-Feb-2013.) (Revised by NM, 18-Aug-2018.)
theorem sbcreu {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class y1):
  $ wb (wsbc x3 (wreu y1 ph B2) A2) (wreu y1 (wsbc x3 ph A2) B2) $;

--| Restricted uniqueness using implicit substitution. This version of ~ reu8 uses a nonfreeness hypothesis for ` x ` and ` ps ` instead of distinct variable conditions. (Contributed by AV, 21-Jan-2022.)
theorem reu8nf {x3 y1 w: setvar} (ph ps: wff x3 y1) (ch: wff x3 w) (A2: class):
  $ wnf x3 ps $ >
  $ wnf x3 ch $ >
  $ wi (wceq (cv x3) (cv w)) (wb ph ch) $ >
  $ wi (wceq (cv w) (cv y1)) (wb ch ps) $ >
  $ wb (wreu x3 ph A2) (wrex x3 (wa ph (wral y1 (wi ps (wceq (cv x3) (cv y1))) A2)) A2) $;

--| Interchange class substitution and class abstraction. (Contributed by NM, 5-Nov-2005.)
theorem sbcabel {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2 V: class x3 y1):
  $ wnfc x3 B2 $ >
  $ wi (wcel A2 V) (wb (wsbc x3 (wcel (cab y1 ph) B2) A2) (wcel (cab y1 (wsbc x3 ph A2)) B2)) $;

--| Restricted quantifier version of Axiom 4 of [Mendelson] p. 69. This provides an axiom for a predicate calculus for a restricted domain. This theorem generalizes the unrestricted ~ stdpc4 and ~ spsbc . See also ~ rspsbca and ~ rspcsbela . (Contributed by NM, 17-Nov-2006.) (Proof shortened by Mario Carneiro, 13-Oct-2016.)
theorem rspsbc {x3: setvar} (ph: wff x3) (A2: class x3) (B2: class):
  $ wi (wcel A2 B2) (wi (wral x3 ph B2) (wsbc x3 ph A2)) $;

--| Restricted quantifier version of Axiom 4 of [Mendelson] p. 69. (Contributed by NM, 14-Dec-2005.)
theorem rspsbca {x3: setvar} (ph: wff x3) (A2: class x3) (B2: class):
  $ wi (wa (wcel A2 B2) (wral x3 ph B2)) (wsbc x3 ph A2) $;

--| Existence form of ~ rspsbca . (Contributed by NM, 29-Feb-2008.) (Proof shortened by Mario Carneiro, 13-Oct-2016.)
theorem rspesbca {x3: setvar} (ph: wff x3) (A2: class x3) (B2: class):
  $ wi (wa (wcel A2 B2) (wsbc x3 ph A2)) (wrex x3 ph B2) $;

--| Existence form of ~ spsbc . (Contributed by Mario Carneiro, 18-Nov-2016.)
theorem spesbc {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wsbc x3 ph A2) (wex x3 ph) $;

--| form of ~ spsbc . (Contributed by Mario Carneiro, 9-Feb-2017.)
theorem spesbcd {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi ph (wsbc x3 ps A2) $ >
  $ wi ph (wex x3 ps) $;

--| A substitution into a theorem. (Contributed by NM, 1-Mar-2008.) (Proof shortened by Mario Carneiro, 13-Oct-2016.)
theorem sbcth2 {x3: setvar} (ph: wff x3) (A2: class x3) (B2: class):
  $ wi (wcel (cv x3) B2) ph $ >
  $ wi (wcel A2 B2) (wsbc x3 ph A2) $;

--| Version of ~ ra4 with a disjoint variable condition, requiring fewer axioms. This is ~ stdpc5v for a restricted domain. (Contributed by BJ, 27-Mar-2020.)
theorem ra4v {x3: setvar} (ph: wff) (ps: wff x3) (A2: class x3):
  $ wi (wral x3 (wi ph ps) A2) (wi ph (wral x3 ps A2)) $;

--| Restricted quantifier version of Axiom 5 of [Mendelson] p. 69. This is the axiom ~ stdpc5 of standard predicate calculus for a restricted domain. See ~ ra4v for a version requiring fewer axioms. (Contributed by NM, 16-Jan-2004.) (Proof shortened by BJ, 27-Mar-2020.)
theorem ra4 {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wi (wral x3 (wi ph ps) A2) (wi ph (wral x3 ps A2)) $;

--| Alternate definition of restricted "at most one". Note that ` E* x e. A ph ` is not equivalent to ` E. y e. A A. x e. A ( ph -> x = y ) ` (in analogy to ~ reu6 ); to see this, let ` A ` be the empty set. However, one direction of this pattern holds; see ~ rmo2i . (Contributed by NM, 17-Jun-2017.)
theorem rmo2 {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3):
  $ wnf y1 ph $ >
  $ wb (wrmo x3 ph A2) (wex y1 (wral x3 (wi ph (wceq (cv x3) (cv y1))) A2)) $;

--| Condition implying restricted "at most one". (Contributed by NM, 17-Jun-2017.)
theorem rmo2i {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3):
  $ wnf y1 ph $ >
  $ wi (wrex y1 (wral x3 (wi ph (wceq (cv x3) (cv y1))) A2) A2) (wrmo x3 ph A2) $;

--| Restricted "at most one" using explicit substitution. (Contributed by NM, 4-Nov-2012.) (Revised by NM, 16-Jun-2017.) Avoid ~ ax-13 . (Revised by Wolf Lammen, 30-Apr-2023.)
theorem rmo3 {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wnf y1 ph $ >
  $ wb (wrmo x3 ph A2) (wral x3 (wral y1 (wi (wa ph (wsb x3 ph y1)) (wceq (cv x3) (cv y1))) A2) A2) $;

--| Consequence of "at most one", using implicit substitution. (Contributed by NM, 2-Jan-2015.) (Revised by NM, 16-Jun-2017.)
theorem rmob {x3: setvar} (ph: wff x3) (ps ch: wff) (A2 B2 C: class):
  $ wi (wceq (cv x3) B2) (wb ph ps) $ >
  $ wi (wceq (cv x3) C) (wb ph ch) $ >
  $ wi (wa (wrmo x3 ph A2) (wa (wcel B2 A2) ps)) (wb (wceq B2 C) (wa (wcel C A2) ch)) $;

--| Consequence of "at most one", using implicit substitution. (Contributed by NM, 4-Nov-2012.) (Revised by NM, 16-Jun-2017.)
theorem rmoi {x3: setvar} (ph: wff x3) (ps ch: wff) (A2 B2 C: class):
  $ wi (wceq (cv x3) B2) (wb ph ps) $ >
  $ wi (wceq (cv x3) C) (wb ph ch) $ >
  $ wi (w3a (wrmo x3 ph A2) (wa (wcel B2 A2) ps) (wa (wcel C A2) ch)) (wceq B2 C) $;

--| Deduce the negation of a restricted "at most one" quantifier. (Contributed by Thierry Arnoux, 13-Jul-2026.)
theorem nrmod {x3: setvar} (ph ps: wff x3) (ch th: wff) (A2 X Y: class):
  $ wi (wceq (cv x3) X) (wb ps ch) $ >
  $ wi (wceq (cv x3) Y) (wb ps th) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y A2) $ >
  $ wi ph ch $ >
  $ wi ph th $ >
  $ wi ph (wne X Y) $ >
  $ wi ph (wn (wrmo x3 ps A2)) $;

--| Consequence of "restricted at most one". (Contributed by Thierry Arnoux, 9-Dec-2019.)
theorem rmob2 {x3: setvar} (ph ps: wff x3) (ch: wff) (A2 B2: class):
  $ wi (wceq (cv x3) B2) (wb ps ch) $ >
  $ wi ph (wcel B2 A2) $ >
  $ wi ph (wrmo x3 ps A2) $ >
  $ wi ph (wcel (cv x3) A2) $ >
  $ wi ph ps $ >
  $ wi ph (wb (wceq (cv x3) B2) ch) $;

--| Consequence of "restricted at most one". (Contributed by Thierry Arnoux, 9-Dec-2019.)
theorem rmoi2 {x3: setvar} (ph ps: wff x3) (ch: wff) (A2 B2: class):
  $ wi (wceq (cv x3) B2) (wb ps ch) $ >
  $ wi ph (wcel B2 A2) $ >
  $ wi ph (wrmo x3 ps A2) $ >
  $ wi ph (wcel (cv x3) A2) $ >
  $ wi ph ps $ >
  $ wi ph ch $ >
  $ wi ph (wceq (cv x3) B2) $;

--| Introduction of a conjunct into restricted "at most one" quantifier, analogous to ~ moanim . (Contributed by Alexander van der Vekens, 25-Jun-2017.) Avoid ~ ax-10 and ~ ax-11 . (Revised by GG, 24-Aug-2023.)
theorem rmoanim {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wb (wrmo x3 (wa ph ps) A2) (wi ph (wrmo x3 ps A2)) $;

--| Alternate proof of ~ rmoanim , shorter but requiring ~ ax-10 and ~ ax-11 . (Contributed by Alexander van der Vekens, 25-Jun-2017.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem rmoanimALT {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wb (wrmo x3 (wa ph ps) A2) (wi ph (wrmo x3 ps A2)) $;

--| Introduction of a conjunct into restricted unique existential quantifier, analogous to ~ euan . (Contributed by Alexander van der Vekens, 2-Jul-2017.)
theorem reuan {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wb (wreu x3 (wa ph ps) A2) (wa ph (wreu x3 ps A2)) $;

--| Double restricted existential uniqueness. This theorem shows a condition under which a "naive" definition matches the correct one, analogous to ~ 2eu1 . (Contributed by Alexander van der Vekens, 25-Jun-2017.)
theorem _2reu1 {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class y1):
  $ wi (wral x3 (wrmo y1 ph B2) A2) (wb (wreu x3 (wreu y1 ph B2) A2) (wa (wreu x3 (wrex y1 ph B2) A2) (wreu y1 (wrex x3 ph A2) B2))) $;

--| Double restricted existential uniqueness, analogous to ~ 2eu2 . (Contributed by Alexander van der Vekens, 29-Jun-2017.)
theorem _2reu2 {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class y1):
  $ wi (wreu y1 (wrex x3 ph A2) B2) (wb (wreu x3 (wreu y1 ph B2) A2) (wreu x3 (wrex y1 ph B2) A2)) $;

--| Extend class notation to include the proper substitution of a class for a set into another class.
term csb {x3: setvar} (A2: class) (B2: class x3): class;

--| Define the proper substitution of a class for a set into another class. The underlined brackets distinguish it from the substitution into a wff, ~ wsbc , to prevent ambiguity. Theorem ~ sbcel1g shows an example of how ambiguity could arise if we did not use distinguished brackets. When ` A ` is a proper class, this evaluates to the empty set (see ~ csbprc ). Theorem ~ sbccsb recovers substitution into a wff from this definition. (Contributed by NM, 10-Nov-2005.)
axiom df_csb {x3 y1: setvar} (A2 B2: class x3):
  $ wceq (csb x3 A2 B2) (cab y1 (wsbc x3 (wcel (cv y1) B2) A2)) $;

--| Alternate expression for the proper substitution into a class, without referencing substitution into a wff. Note that ` x ` can be free in ` B ` but cannot occur in ` A ` . (Contributed by NM, 2-Dec-2013.)
theorem csb2 {x3 y1: setvar} (A2: class) (B2: class x3):
  $ wceq (csb x3 A2 B2) (cab y1 (wex x3 (wa (wceq (cv x3) A2) (wcel (cv y1) B2)))) $;

--| Analogue of ~ dfsbcq for proper substitution into a class. (Contributed by NM, 10-Nov-2005.)
theorem csbeq1 {x3: setvar} (A2 B2 C: class x3):
  $ wi (wceq A2 B2) (wceq (csb x3 A2 C) (csb x3 B2 C)) $;

--| Equality deduction for proper substitution into a class. (Contributed by NM, 3-Dec-2005.)
theorem csbeq1d {x3: setvar} (ph: wff x3) (A2 B2 C: class x3):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (csb x3 A2 C) (csb x3 B2 C)) $;

--| Substituting into equivalent classes gives equivalent results. (Contributed by Giovanni Mascellani, 9-Apr-2018.)
theorem csbeq2 {x3: setvar} (A2 B2 C: class x3):
  $ wi (wal x3 (wceq B2 C)) (wceq (csb x3 A2 B2) (csb x3 A2 C)) $;

--| Formula-building deduction for class substitution. (Contributed by NM, 22-Nov-2005.) (Revised by Mario Carneiro, 1-Sep-2015.)
theorem csbeq2d {x3: setvar} (ph: wff x3) (A2 B2 C: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wceq B2 C) $ >
  $ wi ph (wceq (csb x3 A2 B2) (csb x3 A2 C)) $;

--| Formula-building deduction for class substitution. (Contributed by NM, 10-Nov-2005.) (Revised by Mario Carneiro, 1-Sep-2015.)
theorem csbeq2dv {x3: setvar} (ph: wff) (A2 B2 C: class x3):
  $ wi ph (wceq B2 C) $ >
  $ wi ph (wceq (csb x3 A2 B2) (csb x3 A2 C)) $;

--| Formula-building inference for class substitution. (Contributed by NM, 10-Nov-2005.) (Revised by Mario Carneiro, 1-Sep-2015.)
theorem csbeq2i {x3: setvar} (A2 B2 C: class x3):
  $ wceq B2 C $ >
  $ wceq (csb x3 A2 B2) (csb x3 A2 C) $;

--| Formula-building inference for class substitution. (Contributed by SN, 3-Nov-2023.)
theorem csbeq12dv {x3: setvar} (ph: wff) (A2 B2 C D: class x3):
  $ wi ph (wceq A2 C) $ >
  $ wi ph (wceq B2 D) $ >
  $ wi ph (wceq (csb x3 A2 B2) (csb x3 C D)) $;

--| Change bound variables in a class substitution. Interestingly, this does not require any bound variable conditions on ` A ` . Version of ~ cbvcsb with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by Jeff Hankins, 13-Sep-2009.) Avoid ~ ax-13 . (Revised by GG, 10-Jan-2024.)
theorem cbvcsbw {x3 y1: setvar} (A2 C D: class x3 y1):
  $ wnfc y1 C $ >
  $ wnfc x3 D $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq C D) $ >
  $ wceq (csb x3 A2 C) (csb y1 A2 D) $;

--| Change bound variables in a class substitution. Interestingly, this does not require any bound variable conditions on ` A ` . Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ cbvcsbw when possible. (Contributed by Jeff Hankins, 13-Sep-2009.) (Revised by Mario Carneiro, 11-Dec-2016.) (New usage is discouraged.)
theorem cbvcsb {x3 y1: setvar} (A2 C D: class x3 y1):
  $ wnfc y1 C $ >
  $ wnfc x3 D $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq C D) $ >
  $ wceq (csb x3 A2 C) (csb y1 A2 D) $;

--| Change the bound variable of a proper substitution into a class using implicit substitution. (Contributed by NM, 30-Sep-2008.) (Revised by Mario Carneiro, 13-Oct-2016.)
theorem cbvcsbv {x3 y1: setvar} (A2: class x3 y1) (B2: class x3) (C: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 C) $ >
  $ wceq (csb x3 A2 B2) (csb y1 A2 C) $;

--| Analogue of ~ sbid for proper substitution into a class. (Contributed by NM, 10-Nov-2005.)
theorem csbid {x3: setvar} (A2: class x3):
  $ wceq (csb x3 (cv x3) A2) A2 $;

--| Equality theorem for proper substitution into a class. (Contributed by NM, 10-Nov-2005.)
theorem csbeq1a {x3: setvar} (A2 B2: class x3):
  $ wi (wceq (cv x3) A2) (wceq B2 (csb x3 A2 B2)) $;

--| Composition law for chained substitutions into a class. Version of ~ csbco with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by NM, 10-Nov-2005.) Avoid ~ ax-13 . (Revised by GG, 10-Jan-2024.)
theorem csbcow {x3 y1: setvar} (A2: class x3 y1) (B2: class x3):
  $ wceq (csb y1 A2 (csb x3 (cv y1) B2)) (csb x3 A2 B2) $;

--| Composition law for chained substitutions into a class. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ csbcow when possible. (Contributed by NM, 10-Nov-2005.) (New usage is discouraged.)
theorem csbco {x3 y1: setvar} (A2: class x3 y1) (B2: class x3):
  $ wceq (csb y1 A2 (csb x3 (cv y1) B2)) (csb x3 A2 B2) $;

--| Substitution doesn't affect a constant ` B ` (in which ` x ` is not free). (Contributed by Mario Carneiro, 14-Oct-2016.)
theorem csbtt {x3: setvar} (A2 B2 V: class x3):
  $ wi (wa (wcel A2 V) (wnfc x3 B2)) (wceq (csb x3 A2 B2) B2) $;

--| Substitution doesn't affect a constant ` B ` (in which ` x ` is not free). (Contributed by NM, 10-Nov-2005.)
theorem csbconstgf {x3: setvar} (A2 B2 V: class x3):
  $ wnfc x3 B2 $ >
  $ wi (wcel A2 V) (wceq (csb x3 A2 B2) B2) $;

--| Substitution doesn't affect a constant ` B ` (in which ` x ` does not occur). ~ csbconstgf with distinct variable requirement. (Contributed by Alan Sare, 22-Jul-2012.) Avoid ~ ax-12 . (Revised by GG, 15-Oct-2024.)
theorem csbconstg {x3: setvar} (A2: class x3) (B2: class) (V: class x3):
  $ wi (wcel A2 V) (wceq (csb x3 A2 B2) B2) $;

--| Substitution for a variable not free in a class does not affect it, in inference form. (Contributed by Giovanni Mascellani, 4-Jun-2019.)
theorem csbgfi {x3: setvar} (A2 B2: class x3):
  $ wcel A2 cvv $ >
  $ wnfc x3 B2 $ >
  $ wceq (csb x3 A2 B2) B2 $;

--| The proper substitution of a class for a variable in another variable does not modify it, in inference form. (Contributed by Giovanni Mascellani, 30-May-2019.)
theorem csbconstgi {x3: setvar} (y1: setvar) (A2: class x3):
  $ wcel A2 cvv $ >
  $ wceq (csb x3 A2 (cv y1)) (cv y1) $;

--| Bound-variable hypothesis builder for substitution into a class. (Contributed by Mario Carneiro, 12-Oct-2016.)
theorem nfcsb1d {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 (csb x3 A2 B2)) $;

--| Bound-variable hypothesis builder for substitution into a class. (Contributed by Mario Carneiro, 12-Oct-2016.)
theorem nfcsb1 {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 (csb x3 A2 B2) $;

--| Bound-variable hypothesis builder for substitution into a class. (Contributed by NM, 17-Aug-2006.) (Revised by Mario Carneiro, 12-Oct-2016.)
theorem nfcsb1v {x3: setvar} (A2: class) (B2: class x3):
  $ wnfc x3 (csb x3 A2 B2) $;

--| Deduction version of ~ nfcsb . Usage of this theorem is discouraged because it depends on ~ ax-13 . (Contributed by NM, 21-Nov-2005.) (Revised by Mario Carneiro, 12-Oct-2016.) (New usage is discouraged.)
theorem nfcsbd {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ wnf y1 ph $ >
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 B2) $ >
  $ wi ph (wnfc x3 (csb y1 A2 B2)) $;

--| Bound-variable hypothesis builder for substitution into a class. Version of ~ nfcsb with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by Mario Carneiro, 12-Oct-2016.) Avoid ~ ax-13 . (Revised by GG, 10-Jan-2024.)
theorem nfcsbw {x3 y1: setvar} (A2 B2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 (csb y1 A2 B2) $;

--| Bound-variable hypothesis builder for substitution into a class. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ nfcsbw when possible. (Contributed by Mario Carneiro, 12-Oct-2016.) (New usage is discouraged.)
theorem nfcsb {x3 y1: setvar} (A2 B2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 (csb y1 A2 B2) $;

--| Introduce an explicit substitution into an implicit substitution hypothesis. See ~ sbhypf for class substitution version. (Contributed by NM, 19-Dec-2008.)
theorem csbhypf {x3 y1: setvar} (A2 B2 C: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc x3 C $ >
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wi (wceq (cv y1) A2) (wceq (csb x3 (cv y1) B2) C) $;

--| Conversion of implicit substitution to explicit substitution into a class. (Closed theorem version of ~ csbiegf .) (Contributed by NM, 11-Nov-2005.)
theorem csbiebt {x3: setvar} (A2: class) (B2 C V: class x3):
  $ wi (wa (wcel A2 V) (wnfc x3 C)) (wb (wal x3 (wi (wceq (cv x3) A2) (wceq B2 C))) (wceq (csb x3 A2 B2) C)) $;

--| Conversion of implicit substitution to explicit substitution into a class. (Contributed by Mario Carneiro, 13-Oct-2016.)
theorem csbiedf {x3: setvar} (ph: wff x3) (A2: class) (B2 C V: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wnfc x3 C) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wceq B2 C) $ >
  $ wi ph (wceq (csb x3 A2 B2) C) $;

--| Bidirectional conversion between an implicit class substitution hypothesis ` x = A -> B = C ` and its explicit substitution equivalent. (Contributed by NM, 2-Mar-2008.)
theorem csbieb {x3: setvar} (A2: class) (B2 C: class x3):
  $ wcel A2 cvv $ >
  $ wnfc x3 C $ >
  $ wb (wal x3 (wi (wceq (cv x3) A2) (wceq B2 C))) (wceq (csb x3 A2 B2) C) $;

--| Bidirectional conversion between an implicit class substitution hypothesis ` x = A -> B = C ` and its explicit substitution equivalent. (Contributed by NM, 24-Mar-2013.) (Revised by Mario Carneiro, 11-Dec-2016.)
theorem csbiebg {x3: setvar} (A2: class) (B2 C V: class x3):
  $ wnfc x3 C $ >
  $ wi (wcel A2 V) (wb (wal x3 (wi (wceq (cv x3) A2) (wceq B2 C))) (wceq (csb x3 A2 B2) C)) $;

--| Conversion of implicit substitution to explicit substitution into a class. (Contributed by NM, 11-Nov-2005.) (Revised by Mario Carneiro, 13-Oct-2016.)
theorem csbiegf {x3: setvar} (A2: class) (B2 C V: class x3):
  $ wi (wcel A2 V) (wnfc x3 C) $ >
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wi (wcel A2 V) (wceq (csb x3 A2 B2) C) $;

--| Conversion of implicit substitution to explicit substitution into a class. (Contributed by NM, 26-Nov-2005.) (Revised by Mario Carneiro, 13-Oct-2016.)
theorem csbief {x3: setvar} (A2: class) (B2 C: class x3):
  $ wcel A2 cvv $ >
  $ wnfc x3 C $ >
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wceq (csb x3 A2 B2) C $;

--| Conversion of implicit substitution to explicit substitution into a class. (Contributed by AV, 2-Dec-2019.) Reduce axiom usage. (Revised by GG, 15-Oct-2024.)
theorem csbie {x3: setvar} (A2: class) (B2: class x3) (C: class):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wceq (csb x3 A2 B2) C $;

--| Conversion of implicit substitution to explicit substitution into a class. (Contributed by Mario Carneiro, 2-Dec-2014.) (Revised by Mario Carneiro, 13-Oct-2016.) Reduce axiom usage. (Revised by GG, 15-Oct-2024.)
theorem csbied {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (C: class) (V: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wceq B2 C) $ >
  $ wi ph (wceq (csb x3 A2 B2) C) $;

--| Conversion of implicit substitution to explicit class substitution, deduction form. (Contributed by Mario Carneiro, 2-Jan-2017.)
theorem csbied2 {x3: setvar} (ph: wff) (A2: class) (B2 C: class x3) (D: class) (V: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi (wa ph (wceq (cv x3) B2)) (wceq C D) $ >
  $ wi ph (wceq (csb x3 A2 C) D) $;

--| Conversion of implicit substitution to explicit substitution into a class (closed form of ~ csbie2 ). (Contributed by NM, 3-Sep-2007.) (Revised by Mario Carneiro, 13-Oct-2016.)
theorem csbie2t {x3 y1: setvar} (A2 B2: class) (C: class x3 y1) (D: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wal x3 (wal y1 (wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wceq C D)))) (wceq (csb x3 A2 (csb y1 B2 C)) D) $;

--| Conversion of implicit substitution to explicit substitution into a class. (Contributed by NM, 27-Aug-2007.)
theorem csbie2 {x3 y1: setvar} (A2 B2: class) (C: class x3 y1) (D: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wceq C D) $ >
  $ wceq (csb x3 A2 (csb y1 B2 C)) D $;

--| Conversion of implicit substitution to explicit class substitution. This version of ~ csbie avoids a disjointness condition on ` x , A ` and ` x , D ` by substituting twice. (Contributed by Mario Carneiro, 11-Nov-2016.)
theorem csbie2g {x3 y1: setvar} (A2 B2: class x3) (C: class y1) (D: class x3) (V: class x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 C) $ >
  $ wi (wceq (cv y1) A2) (wceq C D) $ >
  $ wi (wcel A2 V) (wceq (csb x3 A2 B2) D) $;

--| Version of ~ cbvrabcsf with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by Andrew Salmon, 13-Jul-2011.) (Revised by GG, 26-Jan-2024.)
theorem cbvrabcsfw {x3 y1: setvar} (ph ps: wff x3 y1) (A2 B2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq A2 B2) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wceq (crab x3 ph A2) (crab y1 ps B2) $;

--| A more general version of ~ cbvralf that doesn't require ` A ` and ` B ` to be distinct from ` x ` or ` y ` . Changes bound variables using implicit substitution. Usage of this theorem is discouraged because it depends on ~ ax-13 . (Contributed by Andrew Salmon, 13-Jul-2011.) (New usage is discouraged.)
theorem cbvralcsf {x3 y1: setvar} (ph ps: wff x3 y1) (A2 B2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq A2 B2) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wral x3 ph A2) (wral y1 ps B2) $;

--| A more general version of ~ cbvrexf that has no distinct variable restrictions. Changes bound variables using implicit substitution. Usage of this theorem is discouraged because it depends on ~ ax-13 . (Contributed by Andrew Salmon, 13-Jul-2011.) (Proof shortened by Mario Carneiro, 7-Dec-2014.) (New usage is discouraged.)
theorem cbvrexcsf {x3 y1: setvar} (ph ps: wff x3 y1) (A2 B2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq A2 B2) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wrex x3 ph A2) (wrex y1 ps B2) $;

--| A more general version of ~ cbvreuv that has no distinct variable restrictions. Changes bound variables using implicit substitution. Usage of this theorem is discouraged because it depends on ~ ax-13 . (Contributed by Andrew Salmon, 13-Jul-2011.) (New usage is discouraged.)
theorem cbvreucsf {x3 y1: setvar} (ph ps: wff x3 y1) (A2 B2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq A2 B2) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wreu x3 ph A2) (wreu y1 ps B2) $;

--| A more general version of ~ cbvrab with no distinct variable restrictions. Usage of this theorem is discouraged because it depends on ~ ax-13 . (Contributed by Andrew Salmon, 13-Jul-2011.) (New usage is discouraged.)
theorem cbvrabcsf {x3 y1: setvar} (ph ps: wff x3 y1) (A2 B2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq A2 B2) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wceq (crab x3 ph A2) (crab y1 ps B2) $;

--| Rule used to change the bound variable in a restricted universal quantifier with implicit substitution which also changes the quantifier domain. Usage of this theorem is discouraged because it depends on ~ ax-13 . (Contributed by David Moews, 1-May-2017.) (New usage is discouraged.)
theorem cbvralv2 {x3 y1: setvar} (ps: wff x3) (ch: wff y1) (A2: class x3) (B2: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ps ch) $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq A2 B2) $ >
  $ wb (wral x3 ps A2) (wral y1 ch B2) $;

--| Rule used to change the bound variable in a restricted existential quantifier with implicit substitution which also changes the quantifier domain. Usage of this theorem is discouraged because it depends on ~ ax-13 . (Contributed by David Moews, 1-May-2017.) (New usage is discouraged.)
theorem cbvrexv2 {x3 y1: setvar} (ps: wff x3) (ch: wff y1) (A2: class x3) (B2: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ps ch) $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq A2 B2) $ >
  $ wb (wrex x3 ps A2) (wrex y1 ch B2) $;

--| Deduction version of 2-variable restricted specialization, using implicit substitution. Notice that the class ` D ` for the second set variable ` y ` may depend on the first set variable ` x ` . (Contributed by AV, 29-Mar-2021.)
theorem rspc2vd {x3 y1: setvar} (ph: wff y1) (ps: wff x3) (ch: wff y1) (th: wff x3 y1) (A2: class) (B2: class x3) (C: class y1) (D: class x3) (E: class y1):
  $ wi (wceq (cv x3) A2) (wb th ch) $ >
  $ wi (wceq (cv y1) B2) (wb ch ps) $ >
  $ wi ph (wcel A2 C) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wceq D E) $ >
  $ wi ph (wcel B2 E) $ >
  $ wi ph (wi (wral x3 (wral y1 th D) C) ps) $;

--| Syntax for the subclass predicate.
term wss (A2 B2: class): wff;

--| Define the subclass relationship. Definition 5.9 of [TakeutiZaring] p. 17. For example, ` { 1 , 2 } C_ { 1 , 2 , 3 } ` ( ~ ex-ss ). Note that ` A C_ A ` (proved in ~ ssid ). Contrast this relationship with the relationship ` A C. B ` (as will be defined in ~ df-pss ). For an alternative definition, not requiring a dummy variable, see ~ dfss2 . Other possible definitions are given by ~ dfss3 , ~ dfss4 , ~ sspss , ~ ssequn1 , ~ ssequn2 , ~ sseqin2 , and ~ ssdif0 . We prefer the label "ss" ("subset") for ` C_ ` , despite the fact that it applies to classes. It is much more common to refer to this as the subset relation than subclass, especially since most of the time the arguments are in fact sets (and for pragmatic reasons we don't want to need to use different operations for sets). The way set.mm is set up, many things are technically classes despite morally (and provably) being sets, like ` 1 ` (cf. ~ df-1 and ~ 1ex ) or ` RR ` ( cf. ~ df-r and ~ reex ). This has to do with the fact that there are no "set expressions": classes are expressions but there are only set variables in set.mm (cf. ~ https://us.metamath.org/downloads/grammar-ambiguity.txt ). This is why we use ` C_ ` both for subclass relations and for subset relations and call it "subset". (Contributed by NM, 8-Jan-2002.) Revised from the original definition ~ dfss2 . (Revised by GG, 15-May-2025.)
axiom df_ss {x3: setvar} (A2 B2: class):
  $ wb (wss A2 B2) (wal x3 (wi (wcel (cv x3) A2) (wcel (cv x3) B2))) $;

--| Alternate definition of subclass relationship. (Contributed by NM, 14-Oct-1999.)
theorem dfss3 {x3: setvar} (A2 B2: class):
  $ wb (wss A2 B2) (wral x3 (wcel (cv x3) B2) A2) $;

--| Alternate definition of subclass relationship. (Contributed by RP, 16-Apr-2020.)
theorem dfss6 {x3: setvar} (A2 B2: class):
  $ wb (wss A2 B2) (wn (wex x3 (wa (wcel (cv x3) A2) (wn (wcel (cv x3) B2))))) $;

--| Equivalence for subclass relation, using bound-variable hypotheses instead of distinct variable conditions. (Contributed by NM, 3-Jul-1994.) (Revised by Andrew Salmon, 27-Aug-2011.) Avoid ~ ax-13 . (Revised by GG, 19-May-2023.)
theorem dfssf {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wb (wss A2 B2) (wal x3 (wi (wcel (cv x3) A2) (wcel (cv x3) B2))) $;

--| Equivalence for subclass relation, using bound-variable hypotheses instead of distinct variable conditions. (Contributed by NM, 20-Mar-2004.)
theorem dfss3f {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wb (wss A2 B2) (wral x3 (wcel (cv x3) B2) A2) $;

--| If ` x ` is not free in ` A ` and ` B ` , it is not free in ` A C_ B ` . (Contributed by NM, 27-Dec-1996.)
theorem nfss {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnf x3 (wss A2 B2) $;

--| Membership relationships follow from a subclass relationship. (Contributed by NM, 5-Aug-1993.) Avoid ~ ax-12 . (Revised by SN, 27-May-2024.)
theorem ssel (A2 B2 C: class):
  $ wi (wss A2 B2) (wi (wcel C A2) (wcel C B2)) $;

--| Membership relationships follow from a subclass relationship. (Contributed by NM, 7-Jun-2004.)
theorem ssel2 (A2 B2 C: class):
  $ wi (wa (wss A2 B2) (wcel C A2)) (wcel C B2) $;

--| Membership implication from subclass relationship. (Contributed by NM, 5-Aug-1993.)
theorem sseli (A2 B2 C: class):
  $ wss A2 B2 $ >
  $ wi (wcel C A2) (wcel C B2) $;

--| Membership inference from subclass relationship. (Contributed by NM, 31-May-1999.)
theorem sselii (A2 B2 C: class):
  $ wss A2 B2 $ >
  $ wcel C A2 $ >
  $ wcel C B2 $;

--| Membership inference from subclass relationship. (Contributed by NM, 25-Jun-2014.)
theorem sselid (ph: wff) (A2 B2 C: class):
  $ wss A2 B2 $ >
  $ wi ph (wcel C A2) $ >
  $ wi ph (wcel C B2) $;

--| Membership deduction from subclass relationship. (Contributed by NM, 15-Nov-1995.)
theorem sseld (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wi (wcel C A2) (wcel C B2)) $;

--| Membership deduction from subclass relationship. (Contributed by NM, 26-Jun-2014.)
theorem sselda (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi (wa ph (wcel C A2)) (wcel C B2) $;

--| Membership inference from subclass relationship. (Contributed by NM, 14-Dec-2004.)
theorem sseldd (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wcel C A2) $ >
  $ wi ph (wcel C B2) $;

--| If a class is not in another class, it is also not in a subclass of that class. Deduction form. (Contributed by David Moews, 1-May-2017.)
theorem ssneld (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wi (wn (wcel C B2)) (wn (wcel C A2))) $;

--| If an element is not in a class, it is also not in a subclass of that class. Deduction form. (Contributed by David Moews, 1-May-2017.)
theorem ssneldd (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wn (wcel C B2)) $ >
  $ wi ph (wn (wcel C A2)) $;

--| Inference based on subclass definition. (Contributed by NM, 21-Jun-1993.)
theorem ssriv {x3: setvar} (A2 B2: class):
  $ wi (wcel (cv x3) A2) (wcel (cv x3) B2) $ >
  $ wss A2 B2 $;

--| Deduction based on subclass definition. (Contributed by Thierry Arnoux, 8-Mar-2017.)
theorem ssrd {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wnf x3 ph $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wi ph (wi (wcel (cv x3) A2) (wcel (cv x3) B2)) $ >
  $ wi ph (wss A2 B2) $;

--| Deduction based on subclass definition. (Contributed by NM, 15-Nov-1995.)
theorem ssrdv {x3: setvar} (ph: wff) (A2 B2: class):
  $ wi ph (wi (wcel (cv x3) A2) (wcel (cv x3) B2)) $ >
  $ wi ph (wss A2 B2) $;

--| Transitivity of subclass relationship. Exercise 5 of [TakeutiZaring] p. 17. (Contributed by NM, 24-Jun-1993.) (Proof shortened by Andrew Salmon, 14-Jun-2011.) Avoid axioms. (Revised by GG, 19-May-2025.)
theorem sstr2 (A2 B2 C: class):
  $ wi (wss A2 B2) (wi (wss B2 C) (wss A2 C)) $;

--| Transitivity of subclass relationship. Theorem 6 of [Suppes] p. 23. (Contributed by NM, 5-Sep-2003.)
theorem sstr (A2 B2 C: class):
  $ wi (wa (wss A2 B2) (wss B2 C)) (wss A2 C) $;

--| Subclass transitivity inference. (Contributed by NM, 5-May-2000.)
theorem sstri (A2 B2 C: class):
  $ wss A2 B2 $ >
  $ wss B2 C $ >
  $ wss A2 C $;

--| Subclass transitivity deduction. (Contributed by NM, 2-Jun-2004.)
theorem sstrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wss B2 C) $ >
  $ wi ph (wss A2 C) $;

--| Subclass transitivity deduction. (Contributed by NM, 6-Feb-2014.)
theorem sstrid (ph: wff) (A2 B2 C: class):
  $ wss A2 B2 $ >
  $ wi ph (wss B2 C) $ >
  $ wi ph (wss A2 C) $;

--| Subclass transitivity deduction. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.)
theorem sstrdi (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wss B2 C $ >
  $ wi ph (wss A2 C) $;

--| A subclass transitivity deduction. (Contributed by NM, 27-Sep-2004.) (Proof shortened by Andrew Salmon, 14-Jun-2011.)
theorem sylan9ss (ph ps: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ps (wss B2 C) $ >
  $ wi (wa ph ps) (wss A2 C) $;

--| A subclass transitivity deduction. (Contributed by NM, 27-Sep-2004.)
theorem sylan9ssr (ph ps: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ps (wss B2 C) $ >
  $ wi (wa ps ph) (wss A2 C) $;

--| The subclass relationship is antisymmetric. Compare Theorem 4 of [Suppes] p. 22. (Contributed by NM, 21-May-1993.)
theorem eqss (A2 B2: class):
  $ wb (wceq A2 B2) (wa (wss A2 B2) (wss B2 A2)) $;

--| Infer equality from two subclass relationships. Compare Theorem 4 of [Suppes] p. 22. (Contributed by NM, 9-Sep-1993.)
theorem eqssi (A2 B2: class):
  $ wss A2 B2 $ >
  $ wss B2 A2 $ >
  $ wceq A2 B2 $;

--| Equality deduction from two subclass relationships. Compare Theorem 4 of [Suppes] p. 22. (Contributed by NM, 27-Jun-2004.)
theorem eqssd (ph: wff) (A2 B2: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wss B2 A2) $ >
  $ wi ph (wceq A2 B2) $;

--| If a class is a subclass of another class, then the classes are equal if and only if the other class is a subclass of the first class. (Contributed by AV, 23-Dec-2020.)
theorem sssseq (A2 B2: class):
  $ wi (wss B2 A2) (wb (wss A2 B2) (wceq A2 B2)) $;

--| Deduce equality of classes from equivalence of membership. (Contributed by Thierry Arnoux, 21-Mar-2017.) (Proof shortened by BJ, 1-Dec-2021.)
theorem eqrd {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wnf x3 ph $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wi ph (wb (wcel (cv x3) A2) (wcel (cv x3) B2)) $ >
  $ wi ph (wceq A2 B2) $;

--| Infer equality of classes from equivalence of membership. (Contributed by Thierry Arnoux, 7-Oct-2017.)
theorem eqri {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wb (wcel (cv x3) A2) (wcel (cv x3) B2) $ >
  $ wceq A2 B2 $;

--| Equality deduction from subclass relationship and membership. (Contributed by AV, 21-Aug-2022.)
theorem eqelssd {x3: setvar} (ph: wff) (A2 B2: class):
  $ wi ph (wss A2 B2) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wcel (cv x3) A2) $ >
  $ wi ph (wceq A2 B2) $;

--| Any class is a subclass of itself. Exercise 10 of [TakeutiZaring] p. 18. (Contributed by NM, 21-Jun-1993.) (Proof shortened by Andrew Salmon, 14-Jun-2011.)
theorem ssid (A2: class):
  $ wss A2 A2 $;

--| Weakening of ~ ssid . (Contributed by BJ, 1-Sep-2022.)
theorem ssidd (ph: wff) (A2: class):
  $ wi ph (wss A2 A2) $;

--| Any class is a subclass of the universal class. Dual of ~ 0ss . (Contributed by NM, 31-Oct-1995.)
theorem ssv (A2: class):
  $ wss A2 cvv $;

--| Equality theorem for subclasses. (Contributed by NM, 24-Jun-1993.) (Proof shortened by Andrew Salmon, 21-Jun-2011.)
theorem sseq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wb (wss A2 C) (wss B2 C)) $;

--| Equality theorem for the subclass relationship. (Contributed by NM, 25-Jun-1998.)
theorem sseq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wb (wss C A2) (wss C B2)) $;

--| Equality theorem for the subclass relationship. (Contributed by NM, 31-May-1999.)
theorem sseq12 (A2 B2 C D: class):
  $ wi (wa (wceq A2 B2) (wceq C D)) (wb (wss A2 C) (wss B2 D)) $;

--| An equality inference for the subclass relationship. (Contributed by NM, 18-Aug-1993.)
theorem sseq1i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wb (wss A2 C) (wss B2 C) $;

--| An equality inference for the subclass relationship. (Contributed by NM, 30-Aug-1993.)
theorem sseq2i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wb (wss C A2) (wss C B2) $;

--| An equality inference for the subclass relationship. (Contributed by NM, 31-May-1999.) (Proof shortened by Eric Schmidt, 26-Jan-2007.)
theorem sseq12i (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq C D $ >
  $ wb (wss A2 C) (wss B2 D) $;

--| An equality deduction for the subclass relationship. (Contributed by NM, 14-Aug-1994.)
theorem sseq1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wss A2 C) (wss B2 C)) $;

--| An equality deduction for the subclass relationship. (Contributed by NM, 14-Aug-1994.)
theorem sseq2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wss C A2) (wss C B2)) $;

--| An equality deduction for the subclass relationship. (Contributed by NM, 31-May-1999.)
theorem sseq12d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wb (wss A2 C) (wss B2 D)) $;

--| Substitution of equality into a subclass relationship. (Contributed by NM, 25-Apr-2004.)
theorem eqsstrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wss B2 C) $ >
  $ wi ph (wss A2 C) $;

--| Substitution of equality into a subclass relationship. (Contributed by NM, 25-Apr-2004.)
theorem eqsstrrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq B2 A2) $ >
  $ wi ph (wss B2 C) $ >
  $ wi ph (wss A2 C) $;

--| Substitution of equality into a subclass relationship. (Contributed by NM, 25-Apr-2004.)
theorem sseqtrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wceq B2 C) $ >
  $ wi ph (wss A2 C) $;

--| Substitution of equality into a subclass relationship. (Contributed by NM, 25-Apr-2004.)
theorem sseqtrrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wceq C B2) $ >
  $ wi ph (wss A2 C) $;

--| A chained subclass and equality deduction. (Contributed by NM, 25-Apr-2004.)
theorem eqsstrid (ph: wff) (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wi ph (wss B2 C) $ >
  $ wi ph (wss A2 C) $;

--| A chained subclass and equality deduction. (Contributed by NM, 25-Apr-2004.)
theorem eqsstrrid (ph: wff) (A2 B2 C: class):
  $ wceq B2 A2 $ >
  $ wi ph (wss B2 C) $ >
  $ wi ph (wss A2 C) $;

--| A chained subclass and equality deduction. (Contributed by NM, 25-Apr-2004.)
theorem sseqtrdi (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wceq B2 C $ >
  $ wi ph (wss A2 C) $;

--| A chained subclass and equality deduction. (Contributed by NM, 25-Apr-2004.)
theorem sseqtrrdi (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wceq C B2 $ >
  $ wi ph (wss A2 C) $;

--| Subclass transitivity deduction. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.)
theorem sseqtrid (ph: wff) (A2 B2 C: class):
  $ wss B2 A2 $ >
  $ wi ph (wceq A2 C) $ >
  $ wi ph (wss B2 C) $;

--| Subclass transitivity deduction. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.)
theorem sseqtrrid (ph: wff) (A2 B2 C: class):
  $ wss B2 A2 $ >
  $ wi ph (wceq C A2) $ >
  $ wi ph (wss B2 C) $;

--| A chained subclass and equality deduction. (Contributed by Mario Carneiro, 2-Jan-2017.)
theorem eqsstrdi (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wss B2 C $ >
  $ wi ph (wss A2 C) $;

--| A chained subclass and equality deduction. (Contributed by Mario Carneiro, 2-Jan-2017.)
theorem eqsstrrdi (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq B2 A2) $ >
  $ wss B2 C $ >
  $ wi ph (wss A2 C) $;

--| Substitution of equality into a subclass relationship. (Contributed by NM, 16-Jul-1995.)
theorem eqsstri (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wss B2 C $ >
  $ wss A2 C $;

--| Substitution of equality into a subclass relationship. (Contributed by NM, 19-Oct-1999.)
theorem eqsstrri (A2 B2 C: class):
  $ wceq B2 A2 $ >
  $ wss B2 C $ >
  $ wss A2 C $;

--| Substitution of equality into a subclass relationship. (Contributed by NM, 28-Jul-1995.)
theorem sseqtri (A2 B2 C: class):
  $ wss A2 B2 $ >
  $ wceq B2 C $ >
  $ wss A2 C $;

--| Substitution of equality into a subclass relationship. (Contributed by NM, 4-Apr-1995.)
theorem sseqtrri (A2 B2 C: class):
  $ wss A2 B2 $ >
  $ wceq C B2 $ >
  $ wss A2 C $;

--| Substitution of equality in both sides of a subclass relationship. (Contributed by NM, 13-Jan-1996.) (Proof shortened by Eric Schmidt, 26-Jan-2007.)
theorem _3sstr3i (A2 B2 C D: class):
  $ wss A2 B2 $ >
  $ wceq A2 C $ >
  $ wceq B2 D $ >
  $ wss C D $;

--| Substitution of equality in both sides of a subclass relationship. (Contributed by NM, 13-Jan-1996.) (Proof shortened by Eric Schmidt, 26-Jan-2007.)
theorem _3sstr4i (A2 B2 C D: class):
  $ wss A2 B2 $ >
  $ wceq C A2 $ >
  $ wceq D B2 $ >
  $ wss C D $;

--| Substitution of equality into both sides of a subclass relationship. (Contributed by NM, 1-Oct-2000.)
theorem _3sstr3g (ph: wff) (A2 B2 C D: class):
  $ wi ph (wss A2 B2) $ >
  $ wceq A2 C $ >
  $ wceq B2 D $ >
  $ wi ph (wss C D) $;

--| Substitution of equality into both sides of a subclass relationship. (Contributed by NM, 16-Aug-1994.) (Proof shortened by Eric Schmidt, 26-Jan-2007.)
theorem _3sstr4g (ph: wff) (A2 B2 C D: class):
  $ wi ph (wss A2 B2) $ >
  $ wceq C A2 $ >
  $ wceq D B2 $ >
  $ wi ph (wss C D) $;

--| Substitution of equality into both sides of a subclass relationship. (Contributed by NM, 1-Oct-2000.)
theorem _3sstr3d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wceq A2 C) $ >
  $ wi ph (wceq B2 D) $ >
  $ wi ph (wss C D) $;

--| Substitution of equality into both sides of a subclass relationship. (Contributed by NM, 30-Nov-1995.) (Proof shortened by Eric Schmidt, 26-Jan-2007.)
theorem _3sstr4d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wceq C A2) $ >
  $ wi ph (wceq D B2) $ >
  $ wi ph (wss C D) $;

--| Equality implies inclusion, deduction version. (Contributed by SN, 6-Nov-2024.)
theorem eqimssd (ph: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wss A2 B2) $;

--| Equality implies inclusion, deduction version. (Contributed by SN, 15-Feb-2025.)
theorem eqimsscd (ph: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wss B2 A2) $;

--| Equality implies inclusion. (Contributed by NM, 21-Jun-1993.) (Proof shortened by Andrew Salmon, 21-Jun-2011.)
theorem eqimss (A2 B2: class):
  $ wi (wceq A2 B2) (wss A2 B2) $;

--| Equality implies inclusion. (Contributed by NM, 23-Nov-2003.)
theorem eqimss2 (A2 B2: class):
  $ wi (wceq B2 A2) (wss A2 B2) $;

--| Infer subclass relationship from equality. (Contributed by NM, 6-Jan-2007.)
theorem eqimssi (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wss A2 B2 $;

--| Infer subclass relationship from equality. (Contributed by NM, 7-Jan-2007.)
theorem eqimss2i (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wss B2 A2 $;

--| Two classes are different if they don't include the same class. (Contributed by NM, 23-Apr-2015.)
theorem nssne1 (A2 B2 C: class):
  $ wi (wa (wss A2 B2) (wn (wss A2 C))) (wne B2 C) $;

--| Two classes are different if they are not subclasses of the same class. (Contributed by NM, 23-Apr-2015.)
theorem nssne2 (A2 B2 C: class):
  $ wi (wa (wss A2 C) (wn (wss B2 C))) (wne A2 B2) $;

--| Negation of subclass relationship. Exercise 13 of [TakeutiZaring] p. 18. (Contributed by NM, 25-Feb-1996.) (Proof shortened by Andrew Salmon, 21-Jun-2011.)
theorem nss {x3: setvar} (A2 B2: class):
  $ wb (wn (wss A2 B2)) (wex x3 (wa (wcel (cv x3) A2) (wn (wcel (cv x3) B2)))) $;

--| Negation of subclass relationship. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem nssrex {x3: setvar} (A2 B2: class):
  $ wb (wn (wss A2 B2)) (wrex x3 (wn (wcel (cv x3) B2)) A2) $;

--| Demonstrate by witnesses that two classes lack a subclass relation. (Contributed by Stefan O'Rear, 5-Feb-2015.)
theorem nelss (A2 B2 C: class):
  $ wi (wa (wcel A2 B2) (wn (wcel A2 C))) (wn (wss B2 C)) $;

--| Restricted existential quantification follows from a subclass relationship. (Contributed by Glauco Siliprandi, 20-Apr-2017.)
theorem ssrexf {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wi (wss A2 B2) (wi (wrex x3 ph A2) (wrex x3 ph B2)) $;

--| "At most one" existential quantification restricted to a subclass. (Contributed by Thierry Arnoux, 8-Oct-2017.)
theorem ssrmof {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wi (wss A2 B2) (wi (wrmo x3 ph B2) (wrmo x3 ph A2)) $;

--| Quantification restricted to a subclass. (Contributed by NM, 11-Mar-2006.) Avoid axioms. (Revised by GG, 19-May-2025.)
theorem ssralv {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (wss A2 B2) (wi (wral x3 ph B2) (wral x3 ph A2)) $;

--| Existential quantification restricted to a subclass. (Contributed by NM, 11-Jan-2007.) Avoid axioms. (Revised by GG, 19-May-2025.)
theorem ssrexv {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (wss A2 B2) (wi (wrex x3 ph A2) (wrex x3 ph B2)) $;

--| Two quantifications restricted to a subclass. (Contributed by AV, 11-Mar-2023.)
theorem ss2ralv {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class):
  $ wi (wss A2 B2) (wi (wral x3 (wral y1 ph B2) B2) (wral x3 (wral y1 ph A2) A2)) $;

--| Two existential quantifications restricted to a subclass. (Contributed by AV, 11-Mar-2023.)
theorem ss2rexv {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class):
  $ wi (wss A2 B2) (wi (wrex x3 (wrex y1 ph A2) A2) (wrex x3 (wrex y1 ph B2) B2)) $;

--| Restricted universal quantification on a subset in terms of superset. (Contributed by Stefan O'Rear, 3-Apr-2015.) Avoid axioms. (Revised by SN, 14-Oct-2025.)
theorem ralss {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (wss A2 B2) (wb (wral x3 ph A2) (wral x3 (wi (wcel (cv x3) A2) ph) B2)) $;

--| Restricted existential quantification on a subset in terms of superset. (Contributed by Stefan O'Rear, 3-Apr-2015.) Avoid axioms. (Revised by SN, 14-Oct-2025.)
theorem rexss {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (wss A2 B2) (wb (wrex x3 ph A2) (wrex x3 (wa (wcel (cv x3) A2) ph) B2)) $;

--| Class abstractions in a subclass relationship. Reverse direction of ~ ss2ab which requires fewer axioms. (Contributed by SN, 22-Dec-2024.)
theorem ss2abim {x3: setvar} (ph ps: wff x3):
  $ wi (wal x3 (wi ph ps)) (wss (cab x3 ph) (cab x3 ps)) $;

--| Class abstractions in a subclass relationship. (Contributed by NM, 3-Jul-1994.)
theorem ss2ab {x3: setvar} (ph ps: wff x3):
  $ wb (wss (cab x3 ph) (cab x3 ps)) (wal x3 (wi ph ps)) $;

--| Class abstraction in a subclass relationship. (Contributed by NM, 16-Aug-2006.)
theorem abss {x3: setvar} (ph: wff x3) (A2: class):
  $ wb (wss (cab x3 ph) A2) (wal x3 (wi ph (wcel (cv x3) A2))) $;

--| Subclass of a class abstraction. (Contributed by NM, 16-Aug-2006.)
theorem ssab {x3: setvar} (ph: wff x3) (A2: class):
  $ wb (wss A2 (cab x3 ph)) (wal x3 (wi (wcel (cv x3) A2) ph)) $;

--| The relation for a subclass of a class abstraction is equivalent to restricted quantification. (Contributed by NM, 6-Sep-2006.)
theorem ssabral {x3: setvar} (ph: wff x3) (A2: class):
  $ wb (wss A2 (cab x3 ph)) (wral x3 ph A2) $;

--| Deduction of abstraction subclass from implication. (Contributed by NM, 29-Jul-2011.) Reduce dependencies on axioms. (Revised by Steven Nguyen, 28-Jun-2024.)
theorem ss2abdv {x3: setvar} (ph: wff) (ps ch: wff x3):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wss (cab x3 ps) (cab x3 ch)) $;

--| Inference of abstraction subclass from implication. (Contributed by NM, 31-Mar-1995.) Avoid ~ ax-8 , ~ ax-10 , ~ ax-11 , ~ ax-12 . (Revised by GG, 28-Jun-2024.)
theorem ss2abi {x3: setvar} (ph ps: wff x3):
  $ wi ph ps $ >
  $ wss (cab x3 ph) (cab x3 ps) $;

--| Deduction of abstraction subclass from implication. (Contributed by NM, 20-Jan-2006.) (Proof shortened by SN, 22-Dec-2024.)
theorem abssdv {x3: setvar} (ph: wff) (ps: wff x3) (A2: class):
  $ wi ph (wi ps (wcel (cv x3) A2)) $ >
  $ wi ph (wss (cab x3 ps) A2) $;

--| Inference of abstraction subclass from implication. (Contributed by NM, 20-Jan-2006.)
theorem abssi {x3: setvar} (ph: wff x3) (A2: class):
  $ wi ph (wcel (cv x3) A2) $ >
  $ wss (cab x3 ph) A2 $;

--| Restricted abstraction classes in a subclass relationship. (Contributed by NM, 30-May-1999.)
theorem ss2rab {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb (wss (crab x3 ph A2) (crab x3 ps A2)) (wral x3 (wi ph ps) A2) $;

--| Restricted class abstraction in a subclass relationship. (Contributed by NM, 16-Aug-2006.)
theorem rabss {x3: setvar} (ph: wff x3) (A2: class x3) (B2: class):
  $ wb (wss (crab x3 ph A2) B2) (wral x3 (wi ph (wcel (cv x3) B2)) A2) $;

--| Subclass of a restricted class abstraction. (Contributed by NM, 16-Aug-2006.)
theorem ssrab {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wb (wss B2 (crab x3 ph A2)) (wa (wss B2 A2) (wral x3 ph B2)) $;

--| Subclass of a restricted class abstraction (deduction form). Saves ~ ax-10 , ~ ax-11 , ~ ax-12 over using ~ ss2rab and ~ sylibr . (Contributed by SN, 4-Feb-2026.)
theorem ss2rabd {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wi ph (wral x3 (wi ps ch) A2) $ >
  $ wi ph (wss (crab x3 ps A2) (crab x3 ch A2)) $;

--| Subclass of a restricted class abstraction (deduction form). (Contributed by NM, 31-Aug-2006.)
theorem ssrabdv {x3: setvar} (ph: wff) (ps: wff x3) (A2 B2: class):
  $ wi ph (wss B2 A2) $ >
  $ wi (wa ph (wcel (cv x3) B2)) ps $ >
  $ wi ph (wss B2 (crab x3 ps A2)) $;

--| Subclass of a restricted class abstraction (deduction form). (Contributed by NM, 2-Feb-2015.)
theorem rabssdv {x3: setvar} (ph: wff) (ps: wff x3) (A2: class x3) (B2: class):
  $ wi (w3a ph (wcel (cv x3) A2) ps) (wcel (cv x3) B2) $ >
  $ wi ph (wss (crab x3 ps A2) B2) $;

--| Deduction of restricted abstraction subclass from implication. (Contributed by NM, 30-May-2006.) Avoid axioms. (Revised by TM, 1-Feb-2026.)
theorem ss2rabdv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wi ps ch) $ >
  $ wi ph (wss (crab x3 ps A2) (crab x3 ch A2)) $;

--| Inference of restricted abstraction subclass from implication. (Contributed by NM, 14-Oct-1999.) Avoid axioms. (Revised by SN, 4-Feb-2025.)
theorem ss2rabi {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wcel (cv x3) A2) (wi ph ps) $ >
  $ wss (crab x3 ph A2) (crab x3 ps A2) $;

--| Subclass law for restricted abstraction. (Contributed by NM, 18-Dec-2004.) (Proof shortened by Andrew Salmon, 26-Jun-2011.) Avoid axioms. (Revised by TM, 1-Feb-2026.)
theorem rabss2 {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (wss A2 B2) (wss (crab x3 ph A2) (crab x3 ph B2)) $;

--| Obsolete version of ~ rabss2 as of 1-Feb-2026. (Contributed by NM, 30-May-2006.) (Proof shortened by Andrew Salmon, 26-Jun-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem rabss2OLD {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (wss A2 B2) (wss (crab x3 ph A2) (crab x3 ph B2)) $;

--| Subclass relation for the restriction of a class abstraction. Prefer using the more natural statement ~ ssrab2 . (Contributed by NM, 31-Mar-1995.)
theorem ssab2 {x3: setvar} (ph: wff x3) (A2: class):
  $ wss (cab x3 (wa (wcel (cv x3) A2) ph)) A2 $;

--| Subclass relation for a restricted class. (Contributed by NM, 19-Mar-1997.) (Proof shortened by BJ and SN, 8-Aug-2024.)
theorem ssrab2 {x3: setvar} (ph: wff x3) (A2: class):
  $ wss (crab x3 ph A2) A2 $;

--| Subclass law for restricted abstraction. (Contributed by Thierry Arnoux, 25-Sep-2017.)
theorem rabss3d {x3: setvar} (ph: wff) (ps: wff x3) (A2 B2: class):
  $ wi (wa ph (wa (wcel (cv x3) A2) ps)) (wcel (cv x3) B2) $ >
  $ wi ph (wss (crab x3 ps A2) (crab x3 ps B2)) $;

--| Subclass relation for a restricted class abstraction. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.)
theorem ssrab3 {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3):
  $ wceq B2 (crab x3 ph A2) $ >
  $ wss B2 A2 $;

--| Subclass of a restricted class abstraction. (Contributed by AV, 4-Jun-2022.)
theorem rabssrabd {x3: setvar} (ph: wff) (ps ch: wff x3) (A2 B2: class):
  $ wi ph (wss A2 B2) $ >
  $ wi (w3a ph ps (wcel (cv x3) A2)) ch $ >
  $ wi ph (wss (crab x3 ps A2) (crab x3 ch B2)) $;

--| If the restricting class of a restricted class abstraction is a subset of this restricted class abstraction, it is equal to this restricted class abstraction. (Contributed by Alexander van der Vekens, 31-Dec-2017.)
theorem ssrabeq {x3: setvar} (ph: wff x3) (V: class):
  $ wb (wss V (crab x3 ph V)) (wceq V (crab x3 ph V)) $;

--| A restricted class is a subclass of the corresponding unrestricted class. (Contributed by Mario Carneiro, 23-Dec-2016.)
theorem rabssab {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wss (crab x3 ph A2) (cab x3 ph) $;

--| Deduce equality with a restricted abstraction. (Contributed by Thierry Arnoux, 11-Apr-2024.)
theorem eqrrabd {x3: setvar} (ph: wff) (ps: wff x3) (A2: class x3) (B2: class):
  $ wi ph (wss B2 A2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wb (wcel (cv x3) B2) ps) $ >
  $ wi ph (wceq B2 (crab x3 ps A2)) $;

--| A subset relationship useful for converting union to indexed union using ~ dfiun2 or ~ dfiun2g and intersection to indexed intersection using ~ dfiin2 . (Contributed by NM, 5-Oct-2006.) (Proof shortened by Mario Carneiro, 26-Sep-2015.)
theorem uniiunlem {x3 y1: setvar} (A2 B2: class x3) (C: class y1) (D: class x3 y1):
  $ wi (wral x3 (wcel B2 D) A2) (wb (wral x3 (wcel B2 C) A2) (wss (cab y1 (wrex x3 (wceq (cv y1) B2) A2)) C)) $;

--| Syntax for the proper subclass predicate.
term wpss (A2 B2: class): wff;

--| Define proper subclass (or strict subclass) relationship between two classes. Definition 5.9 of [TakeutiZaring] p. 17. For example, ` { 1 , 2 } C. { 1 , 2 , 3 } ` ( ~ ex-pss ). Note that ` -. A C. A ` (proved in ~ pssirr ). Contrast this relationship with the relationship ` A C_ B ` (as defined in ~ df-ss ). Other possible definitions are given by ~ dfpss2 and ~ dfpss3 . (Contributed by NM, 7-Feb-1996.)
axiom df_pss (A2 B2: class):
  $ wb (wpss A2 B2) (wa (wss A2 B2) (wne A2 B2)) $;

--| Alternate definition of proper subclass. (Contributed by NM, 7-Feb-1996.)
theorem dfpss2 (A2 B2: class):
  $ wb (wpss A2 B2) (wa (wss A2 B2) (wn (wceq A2 B2))) $;

--| Alternate definition of proper subclass. (Contributed by NM, 7-Feb-1996.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem dfpss3 (A2 B2: class):
  $ wb (wpss A2 B2) (wa (wss A2 B2) (wn (wss B2 A2))) $;

--| Equality theorem for proper subclass. (Contributed by NM, 7-Feb-1996.)
theorem psseq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wb (wpss A2 C) (wpss B2 C)) $;

--| Equality theorem for proper subclass. (Contributed by NM, 7-Feb-1996.)
theorem psseq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wb (wpss C A2) (wpss C B2)) $;

--| An equality inference for the proper subclass relationship. (Contributed by NM, 9-Jun-2004.)
theorem psseq1i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wb (wpss A2 C) (wpss B2 C) $;

--| An equality inference for the proper subclass relationship. (Contributed by NM, 9-Jun-2004.)
theorem psseq2i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wb (wpss C A2) (wpss C B2) $;

--| An equality inference for the proper subclass relationship. (Contributed by NM, 9-Jun-2004.)
theorem psseq12i (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq C D $ >
  $ wb (wpss A2 C) (wpss B2 D) $;

--| An equality deduction for the proper subclass relationship. (Contributed by NM, 9-Jun-2004.)
theorem psseq1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wpss A2 C) (wpss B2 C)) $;

--| An equality deduction for the proper subclass relationship. (Contributed by NM, 9-Jun-2004.)
theorem psseq2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wpss C A2) (wpss C B2)) $;

--| An equality deduction for the proper subclass relationship. (Contributed by NM, 9-Jun-2004.)
theorem psseq12d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wb (wpss A2 C) (wpss B2 D)) $;

--| A proper subclass is a subclass. Theorem 10 of [Suppes] p. 23. (Contributed by NM, 7-Feb-1996.)
theorem pssss (A2 B2: class):
  $ wi (wpss A2 B2) (wss A2 B2) $;

--| Two classes in a proper subclass relationship are not equal. (Contributed by NM, 16-Feb-2015.)
theorem pssne (A2 B2: class):
  $ wi (wpss A2 B2) (wne A2 B2) $;

--| Deduce subclass from proper subclass. (Contributed by NM, 29-Feb-1996.)
theorem pssssd (ph: wff) (A2 B2: class):
  $ wi ph (wpss A2 B2) $ >
  $ wi ph (wss A2 B2) $;

--| Proper subclasses are unequal. Deduction form of ~ pssne . (Contributed by David Moews, 1-May-2017.)
theorem pssned (ph: wff) (A2 B2: class):
  $ wi ph (wpss A2 B2) $ >
  $ wi ph (wne A2 B2) $;

--| Subclass in terms of proper subclass. (Contributed by NM, 25-Feb-1996.)
theorem sspss (A2 B2: class):
  $ wb (wss A2 B2) (wo (wpss A2 B2) (wceq A2 B2)) $;

--| Proper subclass is irreflexive. Theorem 7 of [Suppes] p. 23. (Contributed by NM, 7-Feb-1996.) (Proof shortened by Umit Teoman Dogan, 10-Jun-2026.)
theorem pssirr (A2: class):
  $ wn (wpss A2 A2) $;

--| Obsolete version of ~ pssirr as of 10-Jun-2026. (Contributed by NM, 7-Feb-1996.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem pssirrOLD (A2: class):
  $ wn (wpss A2 A2) $;

--| Proper subclass has no 2-cycle loops. Compare Theorem 8 of [Suppes] p. 23. (Contributed by NM, 7-Feb-1996.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem pssn2lp (A2 B2: class):
  $ wn (wa (wpss A2 B2) (wpss B2 A2)) $;

--| Two ways of stating trichotomy with respect to inclusion. (Contributed by NM, 12-Aug-2004.)
theorem sspsstri (A2 B2: class):
  $ wb (wo (wss A2 B2) (wss B2 A2)) (w3o (wpss A2 B2) (wceq A2 B2) (wpss B2 A2)) $;

--| Partial trichotomy law for subclasses. (Contributed by NM, 16-May-1996.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem ssnpss (A2 B2: class):
  $ wi (wss A2 B2) (wn (wpss B2 A2)) $;

--| Transitive law for proper subclass. Theorem 9 of [Suppes] p. 23. (Contributed by NM, 7-Feb-1996.)
theorem psstr (A2 B2 C: class):
  $ wi (wa (wpss A2 B2) (wpss B2 C)) (wpss A2 C) $;

--| Transitive law for subclass and proper subclass. (Contributed by NM, 3-Apr-1996.)
theorem sspsstr (A2 B2 C: class):
  $ wi (wa (wss A2 B2) (wpss B2 C)) (wpss A2 C) $;

--| Transitive law for subclass and proper subclass. (Contributed by NM, 3-Apr-1996.)
theorem psssstr (A2 B2 C: class):
  $ wi (wa (wpss A2 B2) (wss B2 C)) (wpss A2 C) $;

--| Proper subclass inclusion is transitive. Deduction form of ~ psstr . (Contributed by David Moews, 1-May-2017.)
theorem psstrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wpss A2 B2) $ >
  $ wi ph (wpss B2 C) $ >
  $ wi ph (wpss A2 C) $;

--| Transitivity involving subclass and proper subclass inclusion. Deduction form of ~ sspsstr . (Contributed by David Moews, 1-May-2017.)
theorem sspsstrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wpss B2 C) $ >
  $ wi ph (wpss A2 C) $;

--| Transitivity involving subclass and proper subclass inclusion. Deduction form of ~ psssstr . (Contributed by David Moews, 1-May-2017.)
theorem psssstrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wpss A2 B2) $ >
  $ wi ph (wss B2 C) $ >
  $ wi ph (wpss A2 C) $;

--| A class is not a proper subclass of another iff it satisfies a one-directional form of ~ eqss . (Contributed by Mario Carneiro, 15-May-2015.)
theorem npss (A2 B2: class):
  $ wb (wn (wpss A2 B2)) (wi (wss A2 B2) (wceq A2 B2)) $;

--| A subclass missing a member is a proper subclass. (Contributed by NM, 12-Jan-2002.)
theorem ssnelpss (A2 B2 C: class):
  $ wi (wss A2 B2) (wi (wa (wcel C B2) (wn (wcel C A2))) (wpss A2 B2)) $;

--| Subclass inclusion with one element of the superclass missing is proper subclass inclusion. Deduction form of ~ ssnelpss . (Contributed by David Moews, 1-May-2017.)
theorem ssnelpssd (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wcel C B2) $ >
  $ wi ph (wn (wcel C A2)) $ >
  $ wi ph (wpss A2 B2) $;

--| If there is an element of a class which is not contained in a subclass, the subclass is a proper subclass. (Contributed by AV, 29-Jan-2020.)
theorem ssexnelpss {x3: setvar} (A2 B2: class):
  $ wi (wa (wss A2 B2) (wrex x3 (wnel (cv x3) A2) B2)) (wpss A2 B2) $;

--| Syntax for the difference of two classes.
term cdif (A2 B2: class): class;

--| Soundness justification theorem for ~ df-dif . (Contributed by Rodolfo Medina, 27-Apr-2010.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem difjust {x3 y1: setvar} (A2 B2: class):
  $ wceq (cab x3 (wa (wcel (cv x3) A2) (wn (wcel (cv x3) B2)))) (cab y1 (wa (wcel (cv y1) A2) (wn (wcel (cv y1) B2)))) $;

--| Define class difference, also called relative complement. Definition 5.12 of [TakeutiZaring] p. 20. For example, ` ( { 1 , 3 } \ { 1 , 8 } ) = { 3 } ` ( ~ ex-dif ). Contrast this operation with union ` ( A u. B ) ` ( ~ df-un ) and intersection ` ( A i^i B ) ` ( ~ df-in ). Several notations are used in the literature; we chose the ` \ ` convention used in Definition 5.3 of [Eisenberg] p. 67 instead of the more common minus sign to reserve the latter for later use in, e.g., arithmetic. We will use the terminology " ` A ` excludes ` B ` " to mean ` A \ B ` . We will use " ` B ` is removed from ` A ` " to mean ` A \ { B } ` i.e. the removal of an element or equivalently the exclusion of a singleton. (Contributed by NM, 29-Apr-1994.)
axiom df_dif {x3: setvar} (A2 B2: class):
  $ wceq (cdif A2 B2) (cab x3 (wa (wcel (cv x3) A2) (wn (wcel (cv x3) B2)))) $;

--| Alternate definition of class difference. (Contributed by NM, 25-Mar-2004.)
theorem dfdif2 {x3: setvar} (A2 B2: class):
  $ wceq (cdif A2 B2) (crab x3 (wn (wcel (cv x3) B2)) A2) $;

--| Expansion of membership in a class difference. (Contributed by NM, 29-Apr-1994.)
theorem eldif (A2 B2 C: class):
  $ wb (wcel A2 (cdif B2 C)) (wa (wcel A2 B2) (wn (wcel A2 C))) $;

--| If a class is in one class and not another, it is also in their difference. One-way deduction form of ~ eldif . (Contributed by David Moews, 1-May-2017.)
theorem eldifd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wn (wcel A2 C)) $ >
  $ wi ph (wcel A2 (cdif B2 C)) $;

--| If a class is in the difference of two classes, it is also in the minuend. One-way deduction form of ~ eldif . (Contributed by David Moews, 1-May-2017.)
theorem eldifad (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 (cdif B2 C)) $ >
  $ wi ph (wcel A2 B2) $;

--| If a class is in the difference of two classes, it is not in the subtrahend. One-way deduction form of ~ eldif . (Contributed by David Moews, 1-May-2017.)
theorem eldifbd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 (cdif B2 C)) $ >
  $ wi ph (wn (wcel A2 C)) $;

--| The elements of a set difference and the minuend are not equal. (Contributed by AV, 21-Oct-2023.)
theorem elneeldif (A2 B2 X Y: class):
  $ wi (wa (wcel X A2) (wcel Y (cdif B2 A2))) (wne X Y) $;

--| Characterization of setvar elements of the complement of a class. (Contributed by Andrew Salmon, 15-Jul-2011.)
theorem velcomp {x3: setvar} (A2: class x3):
  $ wb (wcel (cv x3) (cdif cvv A2)) (wn (wcel (cv x3) A2)) $;

--| Alternate definition of class difference. (Contributed by BJ and Jim Kingdon, 16-Jun-2022.) (Proof shortened by SN, 15-Aug-2025.)
theorem dfdif3 {x3 y1: setvar} (A2: class y1) (B2: class):
  $ wceq (cdif A2 B2) (crab x3 (wral y1 (wne (cv x3) (cv y1)) B2) A2) $;

--| Equality theorem for class difference. (Contributed by NM, 10-Feb-1997.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem difeq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cdif A2 C) (cdif B2 C)) $;

--| Equality theorem for class difference. (Contributed by NM, 10-Feb-1997.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem difeq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cdif C A2) (cdif C B2)) $;

--| Equality theorem for class difference. (Contributed by FL, 31-Aug-2009.)
theorem difeq12 (A2 B2 C D: class):
  $ wi (wa (wceq A2 B2) (wceq C D)) (wceq (cdif A2 C) (cdif B2 D)) $;

--| Inference adding difference to the right in a class equality. (Contributed by NM, 15-Nov-2002.)
theorem difeq1i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cdif A2 C) (cdif B2 C) $;

--| Inference adding difference to the left in a class equality. (Contributed by NM, 15-Nov-2002.)
theorem difeq2i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cdif C A2) (cdif C B2) $;

--| Equality inference for class difference. (Contributed by NM, 29-Aug-2004.)
theorem difeq12i (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq C D $ >
  $ wceq (cdif A2 C) (cdif B2 D) $;

--| Deduction adding difference to the right in a class equality. (Contributed by NM, 15-Nov-2002.)
theorem difeq1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cdif A2 C) (cdif B2 C)) $;

--| Deduction adding difference to the left in a class equality. (Contributed by NM, 15-Nov-2002.)
theorem difeq2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cdif C A2) (cdif C B2)) $;

--| Equality deduction for class difference. (Contributed by FL, 29-May-2014.)
theorem difeq12d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq (cdif A2 C) (cdif B2 D)) $;

--| Inference from membership to difference. (Contributed by NM, 17-May-1998.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem difeqri {x3: setvar} (A2 B2 C: class):
  $ wb (wa (wcel (cv x3) A2) (wn (wcel (cv x3) B2))) (wcel (cv x3) C) $ >
  $ wceq (cdif A2 B2) C $;

--| Bound-variable hypothesis builder for class difference. (Contributed by NM, 3-Dec-2003.) (Revised by Mario Carneiro, 13-Oct-2016.) Avoid ~ ax-10 , ~ ax-11 , ~ ax-12 . (Revised by SN, 14-May-2025.)
theorem nfdif {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 (cdif A2 B2) $;

--| Implication of membership in a class difference. (Contributed by NM, 29-Apr-1994.)
theorem eldifi (A2 B2 C: class):
  $ wi (wcel A2 (cdif B2 C)) (wcel A2 B2) $;

--| Implication of membership in a class difference. (Contributed by NM, 3-May-1994.)
theorem eldifn (A2 B2 C: class):
  $ wi (wcel A2 (cdif B2 C)) (wn (wcel A2 C)) $;

--| A set does not belong to a class excluding it. (Contributed by NM, 27-Jun-1994.)
theorem elndif (A2 B2 C: class):
  $ wi (wcel A2 B2) (wn (wcel A2 (cdif C B2))) $;

--| Implication of membership in a class difference. (Contributed by NM, 28-Jun-1994.)
theorem neldif (A2 B2 C: class):
  $ wi (wa (wcel A2 B2) (wn (wcel A2 (cdif B2 C)))) (wcel A2 C) $;

--| Double class difference. Exercise 11 of [TakeutiZaring] p. 22. (Contributed by NM, 17-May-1998.)
theorem difdif (A2 B2: class):
  $ wceq (cdif A2 (cdif B2 A2)) A2 $;

--| Subclass relationship for class difference. Exercise 14 of [TakeutiZaring] p. 22. (Contributed by NM, 29-Apr-1994.)
theorem difss (A2 B2: class):
  $ wss (cdif A2 B2) A2 $;

--| A difference of two classes is contained in the minuend. Deduction form of ~ difss . (Contributed by David Moews, 1-May-2017.)
theorem difssd (ph: wff) (A2 B2: class):
  $ wi ph (wss (cdif A2 B2) A2) $;

--| If a class is contained in a difference, it is contained in the minuend. (Contributed by David Moews, 1-May-2017.)
theorem difss2 (A2 B2 C: class):
  $ wi (wss A2 (cdif B2 C)) (wss A2 B2) $;

--| If a class is contained in a difference, it is contained in the minuend. Deduction form of ~ difss2 . (Contributed by David Moews, 1-May-2017.)
theorem difss2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 (cdif B2 C)) $ >
  $ wi ph (wss A2 B2) $;

--| Preservation of a subclass relationship by class difference. (Contributed by NM, 15-Feb-2007.)
theorem ssdifss (A2 B2 C: class):
  $ wi (wss A2 B2) (wss (cdif A2 C) B2) $;

--| Double complement under universal class. Exercise 4.10(s) of [Mendelson] p. 231. (Contributed by NM, 8-Jan-2002.)
theorem ddif (A2: class):
  $ wceq (cdif cvv (cdif cvv A2)) A2 $;

--| Contraposition law for subsets. (Contributed by NM, 22-Mar-1998.)
theorem ssconb (A2 B2 C: class):
  $ wi (wa (wss A2 C) (wss B2 C)) (wb (wss A2 (cdif C B2)) (wss B2 (cdif C A2))) $;

--| Contraposition law for subsets. Exercise 15 of [TakeutiZaring] p. 22. (Contributed by NM, 22-Mar-1998.)
theorem sscon (A2 B2 C: class):
  $ wi (wss A2 B2) (wss (cdif C B2) (cdif C A2)) $;

--| Difference law for subsets. (Contributed by NM, 28-May-1998.)
theorem ssdif (A2 B2 C: class):
  $ wi (wss A2 B2) (wss (cdif A2 C) (cdif B2 C)) $;

--| If ` A ` is contained in ` B ` , then ` ( A \ C ) ` is contained in ` ( B \ C ) ` . Deduction form of ~ ssdif . (Contributed by David Moews, 1-May-2017.)
theorem ssdifd (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wss (cdif A2 C) (cdif B2 C)) $;

--| If ` A ` is contained in ` B ` , then ` ( C \ B ) ` is contained in ` ( C \ A ) ` . Deduction form of ~ sscon . (Contributed by David Moews, 1-May-2017.)
theorem sscond (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wss (cdif C B2) (cdif C A2)) $;

--| If ` A ` is contained in ` B ` , then ` ( A \ C ) ` is also contained in ` B ` . Deduction form of ~ ssdifss . (Contributed by David Moews, 1-May-2017.)
theorem ssdifssd (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wss (cdif A2 C) B2) $;

--| If ` A ` is contained in ` B ` and ` C ` is contained in ` D ` , then ` ( A \ D ) ` is contained in ` ( B \ C ) ` . Deduction form. (Contributed by David Moews, 1-May-2017.)
theorem ssdif2d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wss C D) $ >
  $ wi ph (wss (cdif A2 D) (cdif B2 C)) $;

--| Restricted universal quantification on a class difference in terms of an implication. (Contributed by Alexander van der Vekens, 3-Jan-2018.)
theorem raldifb {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wb (wral x3 (wi (wnel (cv x3) B2) ph) A2) (wral x3 ph (cdif A2 B2)) $;

--| Restricted existential quantification over a difference. (Contributed by AV, 25-Oct-2023.)
theorem rexdifi {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wi (wa (wrex x3 ph A2) (wral x3 (wn ph) B2)) (wrex x3 ph (cdif A2 B2)) $;

--| Complementation reverses inclusion. (Contributed by Andrew Salmon, 15-Jul-2011.) (Proof shortened by BJ, 19-Mar-2021.)
theorem complss (A2 B2: class):
  $ wb (wss A2 B2) (wss (cdif cvv B2) (cdif cvv A2)) $;

--| Two classes are equal if and only if their complements are equal. (Contributed by BJ, 19-Mar-2021.)
theorem compleq (A2 B2: class):
  $ wb (wceq A2 B2) (wceq (cdif cvv A2) (cdif cvv B2)) $;

--| Syntax for the intersection of two classes.
term cin (A2 B2: class): class;

--| Soundness justification theorem for ~ df-in . (Contributed by Rodolfo Medina, 28-Apr-2010.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem injust {x3 y1: setvar} (A2 B2: class):
  $ wceq (cab x3 (wa (wcel (cv x3) A2) (wcel (cv x3) B2))) (cab y1 (wa (wcel (cv y1) A2) (wcel (cv y1) B2))) $;

--| Define the intersection of two classes. Definition 5.6 of [TakeutiZaring] p. 16. For example, ` ( { 1 , 3 } i^i { 1 , 8 } ) = { 1 } ` ( ~ ex-in ). Contrast this operation with union ` ( A u. B ) ` ( ~ df-un ) and difference ` ( A \ B ) ` ( ~ df-dif ). For alternate definitions in terms of class difference, requiring no dummy variables, see ~ dfin2 and ~ dfin4 . For intersection defined in terms of union, see ~ dfin3 . (Contributed by NM, 29-Apr-1994.)
axiom df_in {x3: setvar} (A2 B2: class):
  $ wceq (cin A2 B2) (cab x3 (wa (wcel (cv x3) A2) (wcel (cv x3) B2))) $;

--| Alternate definition for the intersection of two classes. (Contributed by NM, 6-Jul-2005.)
theorem dfin5 {x3: setvar} (A2 B2: class):
  $ wceq (cin A2 B2) (crab x3 (wcel (cv x3) B2) A2) $;

--| Expansion of membership in an intersection of two classes. Theorem 12 of [Suppes] p. 25. (Contributed by NM, 29-Apr-1994.)
theorem elin (A2 B2 C: class):
  $ wb (wcel A2 (cin B2 C)) (wa (wcel A2 B2) (wcel A2 C)) $;

--| Alternate definition of the subclass relationship between two classes. Exercise 9 of [TakeutiZaring] p. 18. This was the original definition before ~ df-ss . (Contributed by NM, 27-Apr-1994.) Revise ~ df-ss . (Revised by GG, 15-May-2025.)
theorem dfss2 (A2 B2: class):
  $ wb (wss A2 B2) (wceq (cin A2 B2) A2) $;

--| Variant of subclass definition ~ dfss2 . (Contributed by NM, 21-Jun-1993.)
theorem dfss (A2 B2: class):
  $ wb (wss A2 B2) (wceq A2 (cin A2 B2)) $;

--| Membership in an intersection of two classes. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem elini (A2 B2 C: class):
  $ wcel A2 B2 $ >
  $ wcel A2 C $ >
  $ wcel A2 (cin B2 C) $;

--| Deduce membership in an intersection of two classes. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.)
theorem elind (ph: wff) (A2 B2 X: class):
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel X (cin A2 B2)) $;

--| Membership in an intersection implies membership in the first set. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem elinel1 (A2 B2 C: class):
  $ wi (wcel A2 (cin B2 C)) (wcel A2 B2) $;

--| Membership in an intersection implies membership in the second set. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem elinel2 (A2 B2 C: class):
  $ wi (wcel A2 (cin B2 C)) (wcel A2 C) $;

--| Membership in a class defined as an intersection. (Contributed by Stefan O'Rear, 29-Mar-2015.)
theorem elin2 (A2 B2 C X: class):
  $ wceq X (cin B2 C) $ >
  $ wb (wcel A2 X) (wa (wcel A2 B2) (wcel A2 C)) $;

--| Elementhood in the first set of an intersection - deduction version. (Contributed by Thierry Arnoux, 3-May-2020.)
theorem elin1d (ph: wff) (A2 B2 X: class):
  $ wi ph (wcel X (cin A2 B2)) $ >
  $ wi ph (wcel X A2) $;

--| Elementhood in the first set of an intersection - deduction version. (Contributed by Thierry Arnoux, 3-May-2020.)
theorem elin2d (ph: wff) (A2 B2 X: class):
  $ wi ph (wcel X (cin A2 B2)) $ >
  $ wi ph (wcel X B2) $;

--| Membership in a class defined as a ternary intersection. (Contributed by Stefan O'Rear, 29-Mar-2015.)
theorem elin3 (A2 B2 C D X: class):
  $ wceq X (cin (cin B2 C) D) $ >
  $ wb (wcel A2 X) (w3a (wcel A2 B2) (wcel A2 C) (wcel A2 D)) $;

--| Membership in an intersection implies membership in the first set. (Contributed by Glauco Siliprandi, 2-Jan-2022.)
theorem nel1nelin (A2 B2 C: class):
  $ wi (wn (wcel A2 B2)) (wn (wcel A2 (cin B2 C))) $;

--| Membership in an intersection implies membership in the second set. (Contributed by Glauco Siliprandi, 2-Jan-2022.)
theorem nel2nelin (A2 B2 C: class):
  $ wi (wn (wcel A2 C)) (wn (wcel A2 (cin B2 C))) $;

--| Commutative law for intersection of classes. Exercise 7 of [TakeutiZaring] p. 17. (Contributed by NM, 21-Jun-1993.) (Proof shortened by SN, 12-Dec-2023.)
theorem incom (A2 B2: class):
  $ wceq (cin A2 B2) (cin B2 A2) $;

--| Two ways of expressing that two classes have a given intersection. This is often used when that given intersection is the empty set, in which case the statement displays two ways of expressing that two classes are disjoint (when ` C = (/) ` : ` ( ( A i^i B ) = (/) <-> ` ` ( B i^i A ) = (/) ) ` ). (Contributed by Peter Mazsa, 22-Mar-2017.)
theorem ineqcom (A2 B2 C: class):
  $ wb (wceq (cin A2 B2) C) (wceq (cin B2 A2) C) $;

--| Two ways of expressing that two classes have a given intersection. Inference form of ~ ineqcom . Disjointness inference when ` C = (/) ` . (Contributed by Peter Mazsa, 26-Mar-2017.) (Proof shortened by SN, 20-Sep-2024.)
theorem ineqcomi (A2 B2 C: class):
  $ wceq (cin A2 B2) C $ >
  $ wceq (cin B2 A2) C $;

--| Inference from membership to intersection. (Contributed by NM, 21-Jun-1993.)
theorem ineqri {x3: setvar} (A2 B2 C: class):
  $ wb (wa (wcel (cv x3) A2) (wcel (cv x3) B2)) (wcel (cv x3) C) $ >
  $ wceq (cin A2 B2) C $;

--| Equality theorem for intersection of two classes. (Contributed by NM, 14-Dec-1993.) (Proof shortened by SN, 20-Sep-2023.)
theorem ineq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cin A2 C) (cin B2 C)) $;

--| Equality theorem for intersection of two classes. (Contributed by NM, 26-Dec-1993.)
theorem ineq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cin C A2) (cin C B2)) $;

--| Equality theorem for intersection of two classes. (Contributed by NM, 8-May-1994.)
theorem ineq12 (A2 B2 C D: class):
  $ wi (wa (wceq A2 B2) (wceq C D)) (wceq (cin A2 C) (cin B2 D)) $;

--| Equality inference for intersection of two classes. (Contributed by NM, 26-Dec-1993.)
theorem ineq1i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cin A2 C) (cin B2 C) $;

--| Equality inference for intersection of two classes. (Contributed by NM, 26-Dec-1993.)
theorem ineq2i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cin C A2) (cin C B2) $;

--| Equality inference for intersection of two classes. (Contributed by NM, 24-Jun-2004.) (Proof shortened by Eric Schmidt, 26-Jan-2007.)
theorem ineq12i (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq C D $ >
  $ wceq (cin A2 C) (cin B2 D) $;

--| Equality deduction for intersection of two classes. (Contributed by NM, 10-Apr-1994.)
theorem ineq1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cin A2 C) (cin B2 C)) $;

--| Equality deduction for intersection of two classes. (Contributed by NM, 10-Apr-1994.)
theorem ineq2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cin C A2) (cin C B2)) $;

--| Equality deduction for intersection of two classes. (Contributed by NM, 24-Jun-2004.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem ineq12d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq (cin A2 C) (cin B2 D)) $;

--| Equality deduction for intersection of two classes. (Contributed by NM, 7-Feb-2007.)
theorem ineqan12d (ph ps: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ps (wceq C D) $ >
  $ wi (wa ph ps) (wceq (cin A2 C) (cin B2 D)) $;

--| A relationship between subclass and intersection. Similar to Exercise 9 of [TakeutiZaring] p. 18. (Contributed by NM, 17-May-1994.)
theorem sseqin2 (A2 B2: class):
  $ wb (wss A2 B2) (wceq (cin B2 A2) A2) $;

--| Bound-variable hypothesis builder for the intersection of classes. (Contributed by NM, 15-Sep-2003.) (Revised by Mario Carneiro, 14-Oct-2016.) Avoid ~ ax-10 , ~ ax-11 , ~ ax-12 . (Revised by SN, 14-May-2025.)
theorem nfin {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 (cin A2 B2) $;

--| Deduction from a wff to a restricted class abstraction. (Contributed by NM, 14-Jan-2014.)
theorem rabbi2dva {x3: setvar} (ph: wff) (ps: wff x3) (A2 B2: class):
  $ wi (wa ph (wcel (cv x3) A2)) (wb (wcel (cv x3) B2) ps) $ >
  $ wi ph (wceq (cin A2 B2) (crab x3 ps A2)) $;

--| Idempotent law for intersection of classes. Theorem 15 of [Suppes] p. 26. (Contributed by NM, 5-Aug-1993.)
theorem inidm (A2: class):
  $ wceq (cin A2 A2) A2 $;

--| Associative law for intersection of classes. Exercise 9 of [TakeutiZaring] p. 17. (Contributed by NM, 3-May-1994.)
theorem inass (A2 B2 C: class):
  $ wceq (cin (cin A2 B2) C) (cin A2 (cin B2 C)) $;

--| A rearrangement of intersection. (Contributed by NM, 21-Apr-2001.)
theorem in12 (A2 B2 C: class):
  $ wceq (cin A2 (cin B2 C)) (cin B2 (cin A2 C)) $;

--| A rearrangement of intersection. (Contributed by NM, 21-Apr-2001.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem in32 (A2 B2 C: class):
  $ wceq (cin (cin A2 B2) C) (cin (cin A2 C) B2) $;

--| A rearrangement of intersection. (Contributed by NM, 27-Aug-2012.)
theorem in13 (A2 B2 C: class):
  $ wceq (cin A2 (cin B2 C)) (cin C (cin B2 A2)) $;

--| A rearrangement of intersection. (Contributed by NM, 27-Aug-2012.)
theorem in31 (A2 B2 C: class):
  $ wceq (cin (cin A2 B2) C) (cin (cin C B2) A2) $;

--| Rotate the intersection of 3 classes. (Contributed by NM, 27-Aug-2012.)
theorem inrot (A2 B2 C: class):
  $ wceq (cin (cin A2 B2) C) (cin (cin C A2) B2) $;

--| Rearrangement of intersection of 4 classes. (Contributed by NM, 21-Apr-2001.)
theorem in4 (A2 B2 C D: class):
  $ wceq (cin (cin A2 B2) (cin C D)) (cin (cin A2 C) (cin B2 D)) $;

--| Intersection distributes over itself. (Contributed by NM, 6-May-1994.)
theorem inindi (A2 B2 C: class):
  $ wceq (cin A2 (cin B2 C)) (cin (cin A2 B2) (cin A2 C)) $;

--| Intersection distributes over itself. (Contributed by NM, 17-Aug-2004.)
theorem inindir (A2 B2 C: class):
  $ wceq (cin (cin A2 B2) C) (cin (cin A2 C) (cin B2 C)) $;

--| The intersection of two classes is a subset of one of them. Part of Exercise 12 of [TakeutiZaring] p. 18. (Contributed by NM, 27-Apr-1994.)
theorem inss1 (A2 B2: class):
  $ wss (cin A2 B2) A2 $;

--| The intersection of two classes is a subset of one of them. Part of Exercise 12 of [TakeutiZaring] p. 18. (Contributed by NM, 27-Apr-1994.)
theorem inss2 (A2 B2: class):
  $ wss (cin A2 B2) B2 $;

--| Subclass of intersection. Theorem 2.8(vii) of [Monk1] p. 26. (Contributed by NM, 15-Jun-2004.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem ssin (A2 B2 C: class):
  $ wb (wa (wss A2 B2) (wss A2 C)) (wss A2 (cin B2 C)) $;

--| An inference showing that a subclass of two classes is a subclass of their intersection. (Contributed by NM, 24-Nov-2003.)
theorem ssini (A2 B2 C: class):
  $ wss A2 B2 $ >
  $ wss A2 C $ >
  $ wss A2 (cin B2 C) $;

--| A deduction showing that a subclass of two classes is a subclass of their intersection. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.)
theorem ssind (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wss A2 C) $ >
  $ wi ph (wss A2 (cin B2 C)) $;

--| Add right intersection to subclass relation. (Contributed by NM, 16-Aug-1994.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem ssrin (A2 B2 C: class):
  $ wi (wss A2 B2) (wss (cin A2 C) (cin B2 C)) $;

--| Add left intersection to subclass relation. (Contributed by NM, 19-Oct-1999.)
theorem sslin (A2 B2 C: class):
  $ wi (wss A2 B2) (wss (cin C A2) (cin C B2)) $;

--| Add right intersection to subclass relation. (Contributed by Glauco Siliprandi, 2-Jan-2022.)
theorem ssrind (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wss (cin A2 C) (cin B2 C)) $;

--| Intersection of subclasses. (Contributed by NM, 5-May-2000.)
theorem ss2in (A2 B2 C D: class):
  $ wi (wa (wss A2 B2) (wss C D)) (wss (cin A2 C) (cin B2 D)) $;

--| Intersection preserves subclass relationship. (Contributed by NM, 14-Sep-1999.) (Proof shortened by Umit Teoman Dogan, 10-Jun-2026.)
theorem ssinss1 (A2 B2 C: class):
  $ wi (wss A2 C) (wss (cin A2 B2) C) $;

--| Obsolete version of ~ ssinss1 as of 10-Jun-2026. (Contributed by NM, 14-Sep-1999.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ssinss1OLD (A2 B2 C: class):
  $ wi (wss A2 C) (wss (cin A2 B2) C) $;

--| Intersection preserves subclass relationship. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem ssinss1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 C) $ >
  $ wi ph (wss (cin A2 B2) C) $;

--| Inclusion of an intersection of two classes. (Contributed by NM, 30-Oct-2014.)
theorem inss (A2 B2 C: class):
  $ wi (wo (wss A2 C) (wss B2 C)) (wss (cin A2 B2) C) $;

--| Restricted universal quantification over intersection. (Contributed by Peter Mazsa, 8-Sep-2023.)
theorem ralin {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wb (wral x3 ph (cin A2 B2)) (wral x3 (wi (wcel (cv x3) B2) ph) A2) $;

--| Restricted existential quantification over intersection. (Contributed by Peter Mazsa, 17-Dec-2018.)
theorem rexin {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wb (wrex x3 ph (cin A2 B2)) (wrex x3 (wa (wcel (cv x3) B2) ph) A2) $;

--| Alternate definition of subclass relationship. (Contributed by AV, 1-Aug-2022.)
theorem dfss7 {x3: setvar} (A2 B2: class):
  $ wb (wss B2 A2) (wceq (crab x3 (wcel (cv x3) B2) A2) B2) $;

--| Syntax for the union of two classes.
term cun (A2 B2: class): class;

--| Soundness justification theorem for ~ df-un . (Contributed by Rodolfo Medina, 28-Apr-2010.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem unjust {x3 y1: setvar} (A2 B2: class):
  $ wceq (cab x3 (wo (wcel (cv x3) A2) (wcel (cv x3) B2))) (cab y1 (wo (wcel (cv y1) A2) (wcel (cv y1) B2))) $;

--| Define the union of two classes. Definition 5.6 of [TakeutiZaring] p. 16. For example, ` ( { 1 , 3 } u. { 1 , 8 } ) = { 1 , 3 , 8 } ` ( ~ ex-un ). Contrast this operation with difference ` ( A \ B ) ` ( ~ df-dif ) and intersection ` ( A i^i B ) ` ( ~ df-in ). For an alternate definition in terms of class difference, requiring no dummy variables, see ~ dfun2 . For union defined in terms of intersection, see ~ dfun3 . (Contributed by NM, 23-Aug-1993.)
axiom df_un {x3: setvar} (A2 B2: class):
  $ wceq (cun A2 B2) (cab x3 (wo (wcel (cv x3) A2) (wcel (cv x3) B2))) $;

--| Expansion of membership in class union. Theorem 12 of [Suppes] p. 25. (Contributed by NM, 7-Aug-1994.)
theorem elun (A2 B2 C: class):
  $ wb (wcel A2 (cun B2 C)) (wo (wcel A2 B2) (wcel A2 C)) $;

--| A member of a union that is not a member of the first class, is a member of the second class. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem elunnel1 (A2 B2 C: class):
  $ wi (wa (wcel A2 (cun B2 C)) (wn (wcel A2 B2))) (wcel A2 C) $;

--| A member of a union that is not a member of the second class, is a member of the first class. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem elunnel2 (A2 B2 C: class):
  $ wi (wa (wcel A2 (cun B2 C)) (wn (wcel A2 C))) (wcel A2 B2) $;

--| Inference from membership to union. (Contributed by NM, 21-Jun-1993.)
theorem uneqri {x3: setvar} (A2 B2 C: class):
  $ wb (wo (wcel (cv x3) A2) (wcel (cv x3) B2)) (wcel (cv x3) C) $ >
  $ wceq (cun A2 B2) C $;

--| Idempotent law for union of classes. Theorem 23 of [Suppes] p. 27. (Contributed by NM, 21-Jun-1993.)
theorem unidm (A2: class):
  $ wceq (cun A2 A2) A2 $;

--| Commutative law for union of classes. Exercise 6 of [TakeutiZaring] p. 17. (Contributed by NM, 25-Jun-1998.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem uncom (A2 B2: class):
  $ wceq (cun A2 B2) (cun B2 A2) $;

--| If a class equals the union of two other classes, then it equals the union of those two classes commuted. ~ equncom was automatically derived from ~ equncomVD using the tools program translate__without__overwriting.cmd and minimizing. (Contributed by Alan Sare, 18-Feb-2012.)
theorem equncom (A2 B2 C: class):
  $ wb (wceq A2 (cun B2 C)) (wceq A2 (cun C B2)) $;

--| Inference form of ~ equncom . ~ equncomi was automatically derived from ~ equncomiVD using the tools program translate__without__overwriting.cmd and minimizing. (Contributed by Alan Sare, 18-Feb-2012.)
theorem equncomi (A2 B2 C: class):
  $ wceq A2 (cun B2 C) $ >
  $ wceq A2 (cun C B2) $;

--| Equality theorem for the union of two classes. (Contributed by NM, 15-Jul-1993.)
theorem uneq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cun A2 C) (cun B2 C)) $;

--| Equality theorem for the union of two classes. (Contributed by NM, 5-Aug-1993.)
theorem uneq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cun C A2) (cun C B2)) $;

--| Equality theorem for the union of two classes. (Contributed by NM, 29-Mar-1998.)
theorem uneq12 (A2 B2 C D: class):
  $ wi (wa (wceq A2 B2) (wceq C D)) (wceq (cun A2 C) (cun B2 D)) $;

--| Inference adding union to the right in a class equality. (Contributed by NM, 30-Aug-1993.)
theorem uneq1i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cun A2 C) (cun B2 C) $;

--| Inference adding union to the left in a class equality. (Contributed by NM, 30-Aug-1993.)
theorem uneq2i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cun C A2) (cun C B2) $;

--| Equality inference for the union of two classes. (Contributed by NM, 12-Aug-2004.) (Proof shortened by Eric Schmidt, 26-Jan-2007.)
theorem uneq12i (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq C D $ >
  $ wceq (cun A2 C) (cun B2 D) $;

--| Deduction adding union to the right in a class equality. (Contributed by NM, 29-Mar-1998.)
theorem uneq1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cun A2 C) (cun B2 C)) $;

--| Deduction adding union to the left in a class equality. (Contributed by NM, 29-Mar-1998.)
theorem uneq2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cun C A2) (cun C B2)) $;

--| Equality deduction for the union of two classes. (Contributed by NM, 29-Sep-2004.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem uneq12d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq (cun A2 C) (cun B2 D)) $;

--| Bound-variable hypothesis builder for the union of classes. (Contributed by NM, 15-Sep-2003.) (Revised by Mario Carneiro, 14-Oct-2016.) Avoid ~ ax-10 , ~ ax-11 , ~ ax-12 . (Revised by SN, 14-May-2025.)
theorem nfun {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 (cun A2 B2) $;

--| Associative law for union of classes. Exercise 8 of [TakeutiZaring] p. 17. (Contributed by NM, 3-May-1994.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem unass (A2 B2 C: class):
  $ wceq (cun (cun A2 B2) C) (cun A2 (cun B2 C)) $;

--| A rearrangement of union. (Contributed by NM, 12-Aug-2004.)
theorem un12 (A2 B2 C: class):
  $ wceq (cun A2 (cun B2 C)) (cun B2 (cun A2 C)) $;

--| A rearrangement of union. (Contributed by NM, 12-Aug-2004.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem un23 (A2 B2 C: class):
  $ wceq (cun (cun A2 B2) C) (cun (cun A2 C) B2) $;

--| A rearrangement of the union of 4 classes. (Contributed by NM, 12-Aug-2004.)
theorem un4 (A2 B2 C D: class):
  $ wceq (cun (cun A2 B2) (cun C D)) (cun (cun A2 C) (cun B2 D)) $;

--| Union distributes over itself. (Contributed by NM, 17-Aug-2004.)
theorem unundi (A2 B2 C: class):
  $ wceq (cun A2 (cun B2 C)) (cun (cun A2 B2) (cun A2 C)) $;

--| Union distributes over itself. (Contributed by NM, 17-Aug-2004.)
theorem unundir (A2 B2 C: class):
  $ wceq (cun (cun A2 B2) C) (cun (cun A2 C) (cun B2 C)) $;

--| Subclass relationship for union of classes. Theorem 25 of [Suppes] p. 27. (Contributed by NM, 5-Aug-1993.)
theorem ssun1 (A2 B2: class):
  $ wss A2 (cun A2 B2) $;

--| Subclass relationship for union of classes. (Contributed by NM, 30-Aug-1993.)
theorem ssun2 (A2 B2: class):
  $ wss A2 (cun B2 A2) $;

--| Subclass law for union of classes. (Contributed by NM, 5-Aug-1993.)
theorem ssun3 (A2 B2 C: class):
  $ wi (wss A2 B2) (wss A2 (cun B2 C)) $;

--| Subclass law for union of classes. (Contributed by NM, 14-Aug-1994.)
theorem ssun4 (A2 B2 C: class):
  $ wi (wss A2 B2) (wss A2 (cun C B2)) $;

--| Membership law for union of classes. (Contributed by NM, 5-Aug-1993.)
theorem elun1 (A2 B2 C: class):
  $ wi (wcel A2 B2) (wcel A2 (cun B2 C)) $;

--| Membership law for union of classes. (Contributed by NM, 30-Aug-1993.)
theorem elun2 (A2 B2 C: class):
  $ wi (wcel A2 B2) (wcel A2 (cun C B2)) $;

--| A statement is true for every element of the union of a pair of classes if and only if it is true for every element of the first class and for every element of the second class. (Contributed by BTernaryTau, 27-Sep-2023.)
theorem elunant (ph: wff) (A2 B2 C: class):
  $ wb (wi (wcel C (cun A2 B2)) ph) (wa (wi (wcel C A2) ph) (wi (wcel C B2) ph)) $;

--| Subclass law for union of classes. (Contributed by NM, 14-Oct-1999.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem unss1 (A2 B2 C: class):
  $ wi (wss A2 B2) (wss (cun A2 C) (cun B2 C)) $;

--| A relationship between subclass and union. Theorem 26 of [Suppes] p. 27. (Contributed by NM, 30-Aug-1993.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem ssequn1 (A2 B2: class):
  $ wb (wss A2 B2) (wceq (cun A2 B2) B2) $;

--| Subclass law for union of classes. Exercise 7 of [TakeutiZaring] p. 18. (Contributed by NM, 14-Oct-1999.)
theorem unss2 (A2 B2 C: class):
  $ wi (wss A2 B2) (wss (cun C A2) (cun C B2)) $;

--| Subclass law for union of classes. (Contributed by NM, 2-Jun-2004.)
theorem unss12 (A2 B2 C D: class):
  $ wi (wa (wss A2 B2) (wss C D)) (wss (cun A2 C) (cun B2 D)) $;

--| A relationship between subclass and union. (Contributed by NM, 13-Jun-1994.)
theorem ssequn2 (A2 B2: class):
  $ wb (wss A2 B2) (wceq (cun B2 A2) B2) $;

--| The union of two subclasses is a subclass. Theorem 27 of [Suppes] p. 27 and its converse. (Contributed by NM, 11-Jun-2004.)
theorem unss (A2 B2 C: class):
  $ wb (wa (wss A2 C) (wss B2 C)) (wss (cun A2 B2) C) $;

--| An inference showing the union of two subclasses is a subclass. (Contributed by Raph Levien, 10-Dec-2002.)
theorem unssi (A2 B2 C: class):
  $ wss A2 C $ >
  $ wss B2 C $ >
  $ wss (cun A2 B2) C $;

--| A deduction showing the union of two subclasses is a subclass. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.)
theorem unssd (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 C) $ >
  $ wi ph (wss B2 C) $ >
  $ wi ph (wss (cun A2 B2) C) $;

--| If ` ( A u. B ) ` is contained in ` C ` , so is ` A ` . One-way deduction form of ~ unss . Partial converse of ~ unssd . (Contributed by David Moews, 1-May-2017.)
theorem unssad (ph: wff) (A2 B2 C: class):
  $ wi ph (wss (cun A2 B2) C) $ >
  $ wi ph (wss A2 C) $;

--| If ` ( A u. B ) ` is contained in ` C ` , so is ` B ` . One-way deduction form of ~ unss . Partial converse of ~ unssd . (Contributed by David Moews, 1-May-2017.)
theorem unssbd (ph: wff) (A2 B2 C: class):
  $ wi ph (wss (cun A2 B2) C) $ >
  $ wi ph (wss B2 C) $;

--| A condition that implies inclusion in the union of two classes. (Contributed by NM, 23-Nov-2003.)
theorem ssun (A2 B2 C: class):
  $ wi (wo (wss A2 B2) (wss A2 C)) (wss A2 (cun B2 C)) $;

--| Restricted existential quantification over union. (Contributed by Jeff Madsen, 5-Jan-2011.)
theorem rexun {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wb (wrex x3 ph (cun A2 B2)) (wo (wrex x3 ph A2) (wrex x3 ph B2)) $;

--| Restricted quantification over a union. (Contributed by Scott Fenton, 12-Apr-2011.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem ralunb {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wb (wral x3 ph (cun A2 B2)) (wa (wral x3 ph A2) (wral x3 ph B2)) $;

--| Restricted quantification over union. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem ralun {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wi (wa (wral x3 ph A2) (wral x3 ph B2)) (wral x3 ph (cun A2 B2)) $;

--| Declare the syntax for symmetric difference.
term csymdif (A2 B2: class): class;

--| Define the symmetric difference of two classes. Alternate definitions are ~ dfsymdif2 , ~ dfsymdif3 and ~ dfsymdif4 . (Contributed by Scott Fenton, 31-Mar-2012.)
axiom df_symdif (A2 B2: class):
  $ wceq (csymdif A2 B2) (cun (cdif A2 B2) (cdif B2 A2)) $;

--| Symmetric difference is commutative. (Contributed by Scott Fenton, 24-Apr-2012.)
theorem symdifcom (A2 B2: class):
  $ wceq (csymdif A2 B2) (csymdif B2 A2) $;

--| Equality theorem for symmetric difference. (Contributed by Scott Fenton, 24-Apr-2012.)
theorem symdifeq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (csymdif A2 C) (csymdif B2 C)) $;

--| Equality theorem for symmetric difference. (Contributed by Scott Fenton, 24-Apr-2012.)
theorem symdifeq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (csymdif C A2) (csymdif C B2)) $;

--| Hypothesis builder for symmetric difference. (Contributed by Scott Fenton, 19-Feb-2013.) (Revised by Mario Carneiro, 11-Dec-2016.)
theorem nfsymdif {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 (csymdif A2 B2) $;

--| Membership in a symmetric difference. (Contributed by Scott Fenton, 31-Mar-2012.)
theorem elsymdif (A2 B2 C: class):
  $ wb (wcel A2 (csymdif B2 C)) (wn (wb (wcel A2 B2) (wcel A2 C))) $;

--| Alternate definition of the symmetric difference. (Contributed by NM, 17-Aug-2004.) (Revised by AV, 17-Aug-2022.)
theorem dfsymdif4 {x3: setvar} (A2 B2: class):
  $ wceq (csymdif A2 B2) (cab x3 (wn (wb (wcel (cv x3) A2) (wcel (cv x3) B2)))) $;

--| Membership in a symmetric difference is an exclusive-or relationship. (Contributed by David A. Wheeler, 26-Apr-2020.) (Proof shortened by BJ, 13-Aug-2022.)
theorem elsymdifxor (A2 B2 C: class):
  $ wb (wcel A2 (csymdif B2 C)) (wxo (wcel A2 B2) (wcel A2 C)) $;

--| Alternate definition of the symmetric difference. (Contributed by BJ, 30-Apr-2020.)
theorem dfsymdif2 {x3: setvar} (A2 B2: class):
  $ wceq (csymdif A2 B2) (cab x3 (wxo (wcel (cv x3) A2) (wcel (cv x3) B2))) $;

--| Symmetric difference is associative. (Contributed by Scott Fenton, 24-Apr-2012.) (Proof shortened by BJ, 7-Sep-2022.)
theorem symdifass (A2 B2 C: class):
  $ wceq (csymdif (csymdif A2 B2) C) (csymdif A2 (csymdif B2 C)) $;

--| The symmetric difference contains one of the differences. (Proposed by BJ, 18-Aug-2022.) (Contributed by AV, 19-Aug-2022.)
theorem difsssymdif (A2 B2: class):
  $ wss (cdif A2 B2) (csymdif A2 B2) $;

--| If the symmetric difference is contained in ` C ` , so is one of the differences. (Contributed by AV, 17-Aug-2022.)
theorem difsymssdifssd (ph: wff) (A2 B2 C: class):
  $ wi ph (wss (csymdif A2 B2) C) $ >
  $ wi ph (wss (cdif A2 B2) C) $;

--| Absorption law for union. (Contributed by NM, 16-Apr-2006.)
theorem unabs (A2 B2: class):
  $ wceq (cun A2 (cin A2 B2)) A2 $;

--| Absorption law for intersection. (Contributed by NM, 16-Apr-2006.)
theorem inabs (A2 B2: class):
  $ wceq (cin A2 (cun A2 B2)) A2 $;

--| Negation of subclass expressed in terms of intersection and proper subclass. (Contributed by NM, 30-Jun-2004.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem nssinpss (A2 B2: class):
  $ wb (wn (wss A2 B2)) (wpss (cin A2 B2) A2) $;

--| Negation of subclass expressed in terms of proper subclass and union. (Contributed by NM, 15-Sep-2004.)
theorem nsspssun (A2 B2: class):
  $ wb (wn (wss A2 B2)) (wpss B2 (cun A2 B2)) $;

--| Subclass defined in terms of class difference. See comments under ~ dfun2 . (Contributed by NM, 22-Mar-1998.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem dfss4 (A2 B2: class):
  $ wb (wss A2 B2) (wceq (cdif B2 (cdif B2 A2)) A2) $;

--| An alternate definition of the union of two classes in terms of class difference, requiring no dummy variables. Along with ~ dfin2 and ~ dfss4 it shows we can express union, intersection, and subset directly in terms of the single "primitive" operation ` \ ` (class difference). (Contributed by NM, 10-Jun-2004.)
theorem dfun2 (A2 B2: class):
  $ wceq (cun A2 B2) (cdif cvv (cdif (cdif cvv A2) B2)) $;

--| An alternate definition of the intersection of two classes in terms of class difference, requiring no dummy variables. See comments under ~ dfun2 . Another version is given by ~ dfin4 . (Contributed by NM, 10-Jun-2004.)
theorem dfin2 (A2 B2: class):
  $ wceq (cin A2 B2) (cdif A2 (cdif cvv B2)) $;

--| Difference with intersection. Theorem 33 of [Suppes] p. 29. (Contributed by NM, 31-Mar-1998.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem difin (A2 B2: class):
  $ wceq (cdif A2 (cin A2 B2)) (cdif A2 B2) $;

--| Implication of a class difference with a subclass. (Contributed by AV, 3-Jan-2022.)
theorem ssdifim (A2 B2 V: class):
  $ wi (wa (wss A2 V) (wceq B2 (cdif V A2))) (wceq A2 (cdif V B2)) $;

--| Symmetric class differences for subclasses. (Contributed by AV, 3-Jan-2022.)
theorem ssdifsym (A2 B2 V: class):
  $ wi (wa (wss A2 V) (wss B2 V)) (wb (wceq B2 (cdif V A2)) (wceq A2 (cdif V B2))) $;

--| Alternate definition of subclass relationship: a class ` A ` is a subclass of another class ` B ` iff each element of ` A ` is equal to an element of ` B ` . (Contributed by AV, 13-Nov-2020.)
theorem dfss5 {x3 y1: setvar} (A2: class y1) (B2: class):
  $ wb (wss A2 B2) (wral x3 (wrex y1 (wceq (cv x3) (cv y1)) B2) A2) $;

--| Union defined in terms of intersection (De Morgan's law). Definition of union in [Mendelson] p. 231. (Contributed by NM, 8-Jan-2002.)
theorem dfun3 (A2 B2: class):
  $ wceq (cun A2 B2) (cdif cvv (cin (cdif cvv A2) (cdif cvv B2))) $;

--| Intersection defined in terms of union (De Morgan's law). Similar to Exercise 4.10(n) of [Mendelson] p. 231. (Contributed by NM, 8-Jan-2002.)
theorem dfin3 (A2 B2: class):
  $ wceq (cin A2 B2) (cdif cvv (cun (cdif cvv A2) (cdif cvv B2))) $;

--| Alternate definition of the intersection of two classes. Exercise 4.10(q) of [Mendelson] p. 231. (Contributed by NM, 25-Nov-2003.)
theorem dfin4 (A2 B2: class):
  $ wceq (cin A2 B2) (cdif A2 (cdif A2 B2)) $;

--| Intersection with universal complement. Remark in [Stoll] p. 20. (Contributed by NM, 17-Aug-2004.)
theorem invdif (A2 B2: class):
  $ wceq (cin A2 (cdif cvv B2)) (cdif A2 B2) $;

--| Intersection with class difference. Theorem 34 of [Suppes] p. 29. (Contributed by NM, 17-Aug-2004.)
theorem indif (A2 B2: class):
  $ wceq (cin A2 (cdif A2 B2)) (cdif A2 B2) $;

--| Bring an intersection in and out of a class difference. (Contributed by Jeff Hankins, 15-Jul-2009.)
theorem indif2 (A2 B2 C: class):
  $ wceq (cin A2 (cdif B2 C)) (cdif (cin A2 B2) C) $;

--| Bring an intersection in and out of a class difference. (Contributed by Mario Carneiro, 15-May-2015.)
theorem indif1 (A2 B2 C: class):
  $ wceq (cin (cdif A2 C) B2) (cdif (cin A2 B2) C) $;

--| Commutation law for intersection and difference. (Contributed by Scott Fenton, 18-Feb-2013.)
theorem indifcom (A2 B2 C: class):
  $ wceq (cin A2 (cdif B2 C)) (cin B2 (cdif A2 C)) $;

--| Distributive law for intersection over union. Exercise 10 of [TakeutiZaring] p. 17. (Contributed by NM, 30-Sep-2002.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem indi (A2 B2 C: class):
  $ wceq (cin A2 (cun B2 C)) (cun (cin A2 B2) (cin A2 C)) $;

--| Distributive law for union over intersection. Exercise 11 of [TakeutiZaring] p. 17. (Contributed by NM, 30-Sep-2002.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem undi (A2 B2 C: class):
  $ wceq (cun A2 (cin B2 C)) (cin (cun A2 B2) (cun A2 C)) $;

--| Distributive law for intersection over union. Theorem 28 of [Suppes] p. 27. (Contributed by NM, 30-Sep-2002.)
theorem indir (A2 B2 C: class):
  $ wceq (cin (cun A2 B2) C) (cun (cin A2 C) (cin B2 C)) $;

--| Distributive law for union over intersection. Theorem 29 of [Suppes] p. 27. (Contributed by NM, 30-Sep-2002.)
theorem undir (A2 B2 C: class):
  $ wceq (cun (cin A2 B2) C) (cin (cun A2 C) (cun B2 C)) $;

--| Infer equality from equalities of union and intersection. Exercise 20 of [Enderton] p. 32 and its converse. (Contributed by NM, 10-Aug-2004.)
theorem unineq (A2 B2 C: class):
  $ wb (wa (wceq (cun A2 C) (cun B2 C)) (wceq (cin A2 C) (cin B2 C))) (wceq A2 B2) $;

--| Equality of union and intersection is equivalent to equality of the arguments. (Contributed by NM, 16-Apr-2006.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem uneqin (A2 B2: class):
  $ wb (wceq (cun A2 B2) (cin A2 B2)) (wceq A2 B2) $;

--| Distributive law for class difference. Theorem 39 of [Suppes] p. 29. (Contributed by NM, 17-Aug-2004.)
theorem difundi (A2 B2 C: class):
  $ wceq (cdif A2 (cun B2 C)) (cin (cdif A2 B2) (cdif A2 C)) $;

--| Distributive law for class difference. (Contributed by NM, 17-Aug-2004.)
theorem difundir (A2 B2 C: class):
  $ wceq (cdif (cun A2 B2) C) (cun (cdif A2 C) (cdif B2 C)) $;

--| Distributive law for class difference. Theorem 40 of [Suppes] p. 29. (Contributed by NM, 17-Aug-2004.)
theorem difindi (A2 B2 C: class):
  $ wceq (cdif A2 (cin B2 C)) (cun (cdif A2 B2) (cdif A2 C)) $;

--| Distributive law for class difference. (Contributed by NM, 17-Aug-2004.)
theorem difindir (A2 B2 C: class):
  $ wceq (cdif (cin A2 B2) C) (cin (cdif A2 C) (cdif B2 C)) $;

--| Distribute intersection over difference. (Contributed by BTernaryTau, 14-Aug-2024.)
theorem indifdi (A2 B2 C: class):
  $ wceq (cin A2 (cdif B2 C)) (cdif (cin A2 B2) (cin A2 C)) $;

--| Distribute intersection over difference. (Contributed by Scott Fenton, 14-Apr-2011.) (Revised by BTernaryTau, 14-Aug-2024.)
theorem indifdir (A2 B2 C: class):
  $ wceq (cin (cdif A2 B2) C) (cdif (cin A2 C) (cin B2 C)) $;

--| Class difference by a class difference. (Contributed by Thierry Arnoux, 18-Dec-2017.)
theorem difdif2 (A2 B2 C: class):
  $ wceq (cdif A2 (cdif B2 C)) (cun (cdif A2 B2) (cin A2 C)) $;

--| De Morgan's law for union. Theorem 5.2(13) of [Stoll] p. 19. (Contributed by NM, 18-Aug-2004.)
theorem undm (A2 B2: class):
  $ wceq (cdif cvv (cun A2 B2)) (cin (cdif cvv A2) (cdif cvv B2)) $;

--| De Morgan's law for intersection. Theorem 5.2(13') of [Stoll] p. 19. (Contributed by NM, 18-Aug-2004.)
theorem indm (A2 B2: class):
  $ wceq (cdif cvv (cin A2 B2)) (cun (cdif cvv A2) (cdif cvv B2)) $;

--| A relationship involving double difference and union. (Contributed by NM, 29-Aug-2004.)
theorem difun1 (A2 B2 C: class):
  $ wceq (cdif A2 (cun B2 C)) (cdif (cdif A2 B2) C) $;

--| An equality involving class union and class difference. The first equality of Exercise 13 of [TakeutiZaring] p. 22. (Contributed by Alan Sare, 17-Apr-2012.) (Proof shortened by JJ, 13-Jul-2021.)
theorem undif3 (A2 B2 C: class):
  $ wceq (cun A2 (cdif B2 C)) (cdif (cun A2 B2) (cdif C A2)) $;

--| Represent a class difference as an intersection with a larger difference. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem difin2 (A2 B2 C: class):
  $ wi (wss A2 C) (wceq (cdif A2 B2) (cin (cdif C B2) A2)) $;

--| Swap second and third argument of double difference. (Contributed by NM, 18-Aug-2004.)
theorem dif32 (A2 B2 C: class):
  $ wceq (cdif (cdif A2 B2) C) (cdif (cdif A2 C) B2) $;

--| Absorption-like law for class difference: you can remove a class only once. (Contributed by FL, 2-Aug-2009.)
theorem difabs (A2 B2: class):
  $ wceq (cdif (cdif A2 B2) B2) (cdif A2 B2) $;

--| Relative complementation reverses inclusion of subclasses. Relativized version of ~ complss . (Contributed by RP, 3-Jun-2021.)
theorem sscon34b (A2 B2 C: class):
  $ wi (wa (wss A2 C) (wss B2 C)) (wb (wss A2 B2) (wss (cdif C B2) (cdif C A2))) $;

--| Two subclasses are equal if and only if their relative complements are equal. Relativized version of ~ compleq . (Contributed by RP, 10-Jun-2021.)
theorem rcompleq (A2 B2 C: class):
  $ wi (wa (wss A2 C) (wss B2 C)) (wb (wceq A2 B2) (wceq (cdif C A2) (cdif C B2))) $;

--| Alternate definition of the symmetric difference, given in Example 4.1 of [Stoll] p. 262 (the original definition corresponds to [Stoll] p. 13). (Contributed by NM, 17-Aug-2004.) (Revised by BJ, 30-Apr-2020.)
theorem dfsymdif3 (A2 B2: class):
  $ wceq (csymdif A2 B2) (cdif (cun A2 B2) (cin A2 B2)) $;

--| Union of two class abstractions. Version of ~ unab using implicit substitution, which does not require ~ ax-8 , ~ ax-10 , ~ ax-12 . (Contributed by GG, 15-Oct-2024.)
theorem unabw {x3 y1: setvar} (ph ps: wff x3) (ch th: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ch) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ps th) $ >
  $ wceq (cun (cab x3 ph) (cab x3 ps)) (cab y1 (wo ch th)) $;

--| Union of two class abstractions. (Contributed by NM, 29-Sep-2002.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem unab {x3: setvar} (ph ps: wff x3):
  $ wceq (cun (cab x3 ph) (cab x3 ps)) (cab x3 (wo ph ps)) $;

--| Intersection of two class abstractions. (Contributed by NM, 29-Sep-2002.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem inab {x3: setvar} (ph ps: wff x3):
  $ wceq (cin (cab x3 ph) (cab x3 ps)) (cab x3 (wa ph ps)) $;

--| Difference of two class abstractions. (Contributed by NM, 23-Oct-2004.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem difab {x3: setvar} (ph ps: wff x3):
  $ wceq (cdif (cab x3 ph) (cab x3 ps)) (cab x3 (wa ph (wn ps))) $;

--| A class abstraction with a conjunction is a subset of the class abstraction with the left conjunct only. (Contributed by AV, 7-Aug-2024.) (Proof shortened by SN, 22-Aug-2024.)
theorem abanssl {x3: setvar} (ph ps: wff x3):
  $ wss (cab x3 (wa ph ps)) (cab x3 ph) $;

--| A class abstraction with a conjunction is a subset of the class abstraction with the right conjunct only. (Contributed by AV, 7-Aug-2024.) (Proof shortened by SN, 22-Aug-2024.)
theorem abanssr {x3: setvar} (ph ps: wff x3):
  $ wss (cab x3 (wa ph ps)) (cab x3 ps) $;

--| A class abstraction defined by a negation. Version of ~ notab using implicit substitution, which does not require ~ ax-10 , ~ ax-12 . (Contributed by GG, 15-Oct-2024.)
theorem notabw {x3 y1: setvar} (ph: wff x3) (ps: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wceq (cab x3 (wn ph)) (cdif cvv (cab y1 ps)) $;

--| A class abstraction defined by a negation. (Contributed by FL, 18-Sep-2010.)
theorem notab {x3: setvar} (ph: wff x3):
  $ wceq (cab x3 (wn ph)) (cdif cvv (cab x3 ph)) $;

--| Union of two restricted class abstractions. (Contributed by NM, 25-Mar-2004.)
theorem unrab {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wceq (cun (crab x3 ph A2) (crab x3 ps A2)) (crab x3 (wo ph ps) A2) $;

--| Intersection of two restricted class abstractions. (Contributed by NM, 1-Sep-2006.)
theorem inrab {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wceq (cin (crab x3 ph A2) (crab x3 ps A2)) (crab x3 (wa ph ps) A2) $;

--| Intersection with a restricted class abstraction. (Contributed by NM, 19-Nov-2007.)
theorem inrab2 {x3: setvar} (ph: wff x3) (A2: class x3) (B2: class):
  $ wceq (cin (crab x3 ph A2) B2) (crab x3 ph (cin A2 B2)) $;

--| Difference of two restricted class abstractions. (Contributed by NM, 23-Oct-2004.)
theorem difrab {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wceq (cdif (crab x3 ph A2) (crab x3 ps A2)) (crab x3 (wa ph (wn ps)) A2) $;

--| Alternate definition of restricted class abstraction. (Contributed by Mario Carneiro, 8-Sep-2013.)
theorem dfrab3 {x3: setvar} (ph: wff x3) (A2: class):
  $ wceq (crab x3 ph A2) (cin A2 (cab x3 ph)) $;

--| Alternate definition of restricted class abstraction. (Contributed by NM, 20-Sep-2003.) (Proof shortened by BJ, 22-Apr-2019.)
theorem dfrab2 {x3: setvar} (ph: wff x3) (A2: class):
  $ wceq (crab x3 ph A2) (cin (cab x3 ph) A2) $;

--| Move difference in and out of a restricted class abstraction. (Contributed by Steven Nguyen, 6-Jun-2023.)
theorem rabdif {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wceq (cdif (crab x3 ph A2) B2) (crab x3 ph (cdif A2 B2)) $;

--| Complementation of restricted class abstractions. (Contributed by Mario Carneiro, 3-Sep-2015.)
theorem notrab {x3: setvar} (ph: wff x3) (A2: class):
  $ wceq (cdif A2 (crab x3 ph A2)) (crab x3 (wn ph) A2) $;

--| Restricted class abstraction with a common superset. (Contributed by Stefan O'Rear, 12-Sep-2015.) (Proof shortened by Mario Carneiro, 8-Nov-2015.)
theorem dfrab3ss {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (wss A2 B2) (wceq (crab x3 ph A2) (cin A2 (crab x3 ph B2))) $;

--| Abstraction restricted to a union. (Contributed by Stefan O'Rear, 5-Feb-2015.)
theorem rabun2 {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wceq (crab x3 ph (cun A2 B2)) (cun (crab x3 ph A2) (crab x3 ph B2)) $;

--| Transfer uniqueness to a smaller or larger class. (Contributed by NM, 21-Oct-2005.) (Proof shortened by Wolf Lammen, 15-May-2025.)
theorem reuun2 {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wi (wn (wrex x3 ph B2)) (wb (wreu x3 ph (cun A2 B2)) (wreu x3 ph A2)) $;

--| Transfer uniqueness to a smaller subclass. (Contributed by NM, 20-Oct-2005.)
theorem reuss2 {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wi (wa (wa (wss A2 B2) (wral x3 (wi ph ps) A2)) (wa (wrex x3 ph A2) (wreu x3 ps B2))) (wreu x3 ph A2) $;

--| Transfer uniqueness to a smaller subclass. (Contributed by NM, 21-Aug-1999.)
theorem reuss {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (w3a (wss A2 B2) (wrex x3 ph A2) (wreu x3 ph B2)) (wreu x3 ph A2) $;

--| Transfer uniqueness to a smaller class. (Contributed by NM, 21-Oct-2005.)
theorem reuun1 {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wi (wa (wrex x3 ph A2) (wreu x3 (wo ph ps) (cun A2 B2))) (wreu x3 ph A2) $;

--| Restricted uniqueness "picks" a member of a subclass. (Contributed by NM, 21-Aug-1999.)
theorem reupick {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (wa (wa (wss A2 B2) (wa (wrex x3 ph A2) (wreu x3 ph B2))) ph) (wb (wcel (cv x3) A2) (wcel (cv x3) B2)) $;

--| Restricted uniqueness "picks" a member of a subclass. (Contributed by Mario Carneiro, 19-Nov-2016.)
theorem reupick3 {x3: setvar} (ph ps: wff x3) (A2: class):
  $ wi (w3a (wreu x3 ph A2) (wrex x3 (wa ph ps) A2) (wcel (cv x3) A2)) (wi ph ps) $;

--| Restricted uniqueness "picks" a member of a subclass. (Contributed by Mario Carneiro, 15-Dec-2013.) (Proof shortened by Mario Carneiro, 19-Nov-2016.)
theorem reupick2 {x3: setvar} (ph ps: wff x3) (A2: class):
  $ wi (wa (w3a (wral x3 (wi ps ph) A2) (wrex x3 ps A2) (wreu x3 ph A2)) (wcel (cv x3) A2)) (wb ph ps) $;

--| Transfer uniqueness of an element to a smaller subclass. (Contributed by AV, 14-Apr-2020.)
theorem euelss {x3: setvar} (A2 B2: class):
  $ wi (w3a (wss A2 B2) (wex x3 (wcel (cv x3) A2)) (weu x3 (wcel (cv x3) B2))) (weu x3 (wcel (cv x3) A2)) $;

--| Extend class notation to include the empty set.
term c0: class;

--| Define the empty set. More precisely, we should write "empty class". It will be posited in ~ ax-nul that an empty set exists. Then, by uniqueness among classes ( ~ eq0 , as opposed to the weaker uniqueness among sets, ~ nulmo ), it will follow that ` (/) ` is indeed a set ( ~ 0ex ). Special case of Exercise 4.10(o) of [Mendelson] p. 231. For a more traditional definition, but requiring a dummy variable, see ~ dfnul2 . (Contributed by NM, 17-Jun-1993.) Clarify that at this point, it is not established that it is a set. (Revised by BJ, 22-Sep-2022.)
axiom df_nul:
  $ wceq c0 (cdif cvv cvv) $;

--| Alternate definition of the empty class/set. (Contributed by BJ, 30-Nov-2019.) Avoid ~ ax-8 , ~ df-clel . (Revised by GG, 3-Sep-2024.) Prove directly from definition to allow shortening ~ dfnul2 . (Revised by BJ, 23-Sep-2024.)
theorem dfnul4 {x3: setvar}:
  $ wceq c0 (cab x3 wfal) $;

--| Alternate definition of the empty set. Definition 5.14 of [TakeutiZaring] p. 20. (Contributed by NM, 26-Dec-1996.) Remove dependency on ~ ax-10 , ~ ax-11 , and ~ ax-12 . (Revised by Steven Nguyen, 3-May-2023.) (Proof shortened by BJ, 23-Sep-2024.)
theorem dfnul2 {x3: setvar}:
  $ wceq c0 (cab x3 (wn (wceq (cv x3) (cv x3)))) $;

--| Alternate definition of the empty set. (Contributed by NM, 25-Mar-2004.) (Proof shortened by BJ, 23-Sep-2024.)
theorem dfnul3 {x3: setvar} (A2: class x3):
  $ wceq c0 (crab x3 (wn (wcel (cv x3) A2)) A2) $;

--| The empty set has no elements. Theorem 6.14 of [Quine] p. 44. (Contributed by NM, 21-Jun-1993.) (Proof shortened by Mario Carneiro, 1-Sep-2015.) Remove dependency on ~ ax-10 , ~ ax-11 , and ~ ax-12 . (Revised by Steven Nguyen, 3-May-2023.) (Proof shortened by BJ, 23-Sep-2024.) (Proof shortened by BJ, 11-Oct-2026.)
theorem noel (A2: class):
  $ wn (wcel A2 c0) $;

--| Obsolete version of ~ noel as of 11-Oct-2026. (Contributed by NM, 21-Jun-1993.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem noelOLD (A2: class):
  $ wn (wcel A2 c0) $;

--| The empty set has no elements. (Contributed by Peter Mazsa, 4-Jan-2018.)
theorem nel02 (A2 B2: class):
  $ wi (wceq A2 c0) (wn (wcel B2 A2)) $;

--| If a class has elements, then it is not empty. (Contributed by NM, 31-Dec-1993.)
theorem n0i (A2 B2: class):
  $ wi (wcel B2 A2) (wn (wceq A2 c0)) $;

--| If a class has elements, then it is nonempty. (Contributed by NM, 31-Dec-1993.)
theorem ne0i (A2 B2: class):
  $ wi (wcel B2 A2) (wne A2 c0) $;

--| Deduction form of ~ ne0i . If a class has elements, then it is nonempty. (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem ne0d (ph: wff) (A2 B2: class):
  $ wi ph (wcel B2 A2) $ >
  $ wi ph (wne A2 c0) $;

--| If a class has elements, then it is not empty. Inference associated with ~ n0i . (Contributed by BJ, 15-Jul-2021.)
theorem n0ii (A2 B2: class):
  $ wcel A2 B2 $ >
  $ wn (wceq B2 c0) $;

--| If a class has elements, then it is nonempty. Inference associated with ~ ne0i . (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem ne0ii (A2 B2: class):
  $ wcel A2 B2 $ >
  $ wne B2 c0 $;

--| The universal class is not equal to the empty set. (Contributed by NM, 11-Sep-2008.) Avoid ~ ax-8 , ~ df-clel . (Revised by GG, 6-Sep-2024.) (Proof shortened by BJ, 12-Jul-2026.)
theorem vn0:
  $ wne cvv c0 $;

--| Obsolete version of ~ vn0 as of 12-Jul-2026. (Contributed by NM, 11-Sep-2008.) Avoid ~ ax-8 , ~ df-clel . (Revised by GG, 6-Sep-2024.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem vn0OLD:
  $ wne cvv c0 $;

--| Alternate proof of ~ vn0 . Shorter, but requiring ~ df-clel , ~ ax-8 . (Contributed by NM, 11-Sep-2008.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem vn0ALT:
  $ wne cvv c0 $;

--| A class is equal to the empty set if and only if it has no elements. Theorem 2 of [Suppes] p. 22. (Contributed by BJ, 15-Jul-2021.)
theorem eq0f {x3: setvar} (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wb (wceq A2 c0) (wal x3 (wn (wcel (cv x3) A2))) $;

--| A class is not empty if and only if it has at least one element. Proposition 5.17(1) of [TakeutiZaring] p. 20. This version of ~ neq0 requires only that ` x ` not be free in, rather than not occur in, ` A ` . (Contributed by BJ, 15-Jul-2021.)
theorem neq0f {x3: setvar} (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wb (wn (wceq A2 c0)) (wex x3 (wcel (cv x3) A2)) $;

--| A class is nonempty if and only if it has at least one element. Proposition 5.17(1) of [TakeutiZaring] p. 20. This version of ~ n0 requires only that ` x ` not be free in, rather than not occur in, ` A ` . (Contributed by NM, 17-Oct-2003.)
theorem n0f {x3: setvar} (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wb (wne A2 c0) (wex x3 (wcel (cv x3) A2)) $;

--| A class is equal to the empty set if and only if it has no elements. Theorem 2 of [Suppes] p. 22. (Contributed by NM, 29-Aug-1993.) Avoid ~ ax-11 , ~ ax-12 . (Revised by GG and Steven Nguyen, 28-Jun-2024.) Avoid ~ ax-8 , ~ df-clel . (Revised by GG, 6-Sep-2024.)
theorem eq0 {x3: setvar} (A2: class):
  $ wb (wceq A2 c0) (wal x3 (wn (wcel (cv x3) A2))) $;

--| Alternate proof of ~ eq0 . Shorter, but requiring ~ df-clel , ~ ax-8 . (Contributed by NM, 29-Aug-1993.) Avoid ~ ax-11 , ~ ax-12 . (Revised by GG and Steven Nguyen, 28-Jun-2024.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem eq0ALT {x3: setvar} (A2: class):
  $ wb (wceq A2 c0) (wal x3 (wn (wcel (cv x3) A2))) $;

--| A class is not empty if and only if it has at least one element. Proposition 5.17(1) of [TakeutiZaring] p. 20. (Contributed by NM, 21-Jun-1993.) Avoid ~ ax-11 , ~ ax-12 . (Revised by GG, 28-Jun-2024.)
theorem neq0 {x3: setvar} (A2: class):
  $ wb (wn (wceq A2 c0)) (wex x3 (wcel (cv x3) A2)) $;

--| A class is nonempty if and only if it has at least one element. Proposition 5.17(1) of [TakeutiZaring] p. 20. (Contributed by NM, 29-Sep-2006.) Avoid ~ ax-11 , ~ ax-12 . (Revised by GG, 28-Jun-2024.)
theorem n0 {x3: setvar} (A2: class):
  $ wb (wne A2 c0) (wex x3 (wcel (cv x3) A2)) $;

--| Deduction rule for nonempty classes. (Contributed by Thierry Arnoux, 3-Aug-2025.)
theorem n0limd {x3: setvar} (ph ps: wff) (A2: class):
  $ wi ph (wne A2 c0) $ >
  $ wi (wa ph (wcel (cv x3) A2)) ps $ >
  $ wi ph ps $;

--| From the general negation of membership in ` A ` , infer that ` A ` is the empty set. (Contributed by BJ, 6-Oct-2018.)
theorem nel0 {x3: setvar} (A2: class):
  $ wn (wcel (cv x3) A2) $ >
  $ wceq A2 c0 $;

--| Restricted existence deduced from nonempty class. (Contributed by NM, 1-Feb-2012.)
theorem reximdva0 {x3: setvar} (ph: wff) (ps: wff x3) (A2: class):
  $ wi (wa ph (wcel (cv x3) A2)) ps $ >
  $ wi (wa ph (wne A2 c0)) (wrex x3 ps A2) $;

--| Specialization for restricted generalization with a nonempty class. (Contributed by Alexander van der Vekens, 6-Sep-2018.) Avoid ~ ax-10 , ~ ax-12 . (Revised by GG, 28-Jun-2024.)
theorem rspn0 {x3: setvar} (ph: wff) (A2: class):
  $ wi (wne A2 c0) (wi (wral x3 ph A2) ph) $;

--| There is an element in a nonempty class which is an element of the class. (Contributed by AV, 17-Dec-2020.)
theorem n0rex {x3: setvar} (A2: class):
  $ wi (wne A2 c0) (wrex x3 (wcel (cv x3) A2) A2) $;

--| There is an element in a class with a nonempty subclass which is an element of the subclass. (Contributed by AV, 17-Dec-2020.)
theorem ssn0rex {x3: setvar} (A2 B2: class):
  $ wi (wa (wss A2 B2) (wne A2 c0)) (wrex x3 (wcel (cv x3) A2) B2) $;

--| A case of equivalence of "at most one" and "only one". (Contributed by FL, 6-Dec-2010.)
theorem n0moeu {x3: setvar} (A2: class):
  $ wi (wne A2 c0) (wb (wmo x3 (wcel (cv x3) A2)) (weu x3 (wcel (cv x3) A2))) $;

--| Vacuous restricted existential quantification is false. (Contributed by NM, 15-Oct-2003.)
theorem rex0 {x3: setvar} (ph: wff x3):
  $ wn (wrex x3 ph c0) $;

--| Vacuous restricted uniqueness is always false. (Contributed by AV, 3-Apr-2023.)
theorem reu0 {x3: setvar} (ph: wff x3):
  $ wn (wreu x3 ph c0) $;

--| Vacuous restricted at-most-one quantifier is always true. (Contributed by AV, 3-Apr-2023.)
theorem rmo0 {x3: setvar} (ph: wff x3):
  $ wrmo x3 ph c0 $;

--| Membership of the empty set in another class. (Contributed by NM, 29-Jun-2004.)
theorem _0el {x3 y1: setvar} (A2: class y1):
  $ wb (wcel c0 A2) (wrex x3 (wal y1 (wn (wcel (cv y1) (cv x3)))) A2) $;

--| Negated membership of the empty set in another class. (Contributed by Rodolfo Medina, 25-Sep-2010.)
theorem n0el {x3 u: setvar} (A2: class u):
  $ wb (wn (wcel c0 A2)) (wral x3 (wex u (wcel (cv u) (cv x3))) A2) $;

--| A condition which implies the existence of a unique element of a class. (Contributed by AV, 4-Jan-2022.)
theorem eqeuel {x3 y1: setvar} (A2: class):
  $ wi (wa (wne A2 c0) (wal x3 (wal y1 (wi (wa (wcel (cv x3) A2) (wcel (cv y1) A2)) (wceq (cv x3) (cv y1)))))) (weu x3 (wcel (cv x3) A2)) $;

--| Subclass expressed in terms of difference. Exercise 7 of [TakeutiZaring] p. 22. (Contributed by NM, 29-Apr-1994.)
theorem ssdif0 (A2 B2: class):
  $ wb (wss A2 B2) (wceq (cdif A2 B2) c0) $;

--| If the difference of two sets is not empty, then the sets are not equal. (Contributed by Thierry Arnoux, 28-Feb-2017.)
theorem difn0 (A2 B2: class):
  $ wi (wne (cdif A2 B2) c0) (wne A2 B2) $;

--| A proper subclass has a nonempty difference. (Contributed by NM, 3-May-1994.)
theorem pssdifn0 (A2 B2: class):
  $ wi (wa (wss A2 B2) (wne A2 B2)) (wne (cdif B2 A2) c0) $;

--| A proper subclass has a nonempty difference. (Contributed by Mario Carneiro, 27-Apr-2016.)
theorem pssdif (A2 B2: class):
  $ wi (wpss A2 B2) (wne (cdif B2 A2) c0) $;

--| Express that an intersection is not empty. (Contributed by RP, 16-Apr-2020.)
theorem ndisj {x3: setvar} (A2 B2: class):
  $ wb (wne (cin A2 B2) c0) (wex x3 (wa (wcel (cv x3) A2) (wcel (cv x3) B2))) $;

--| A nonempty intersection. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem inn0f {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wb (wne (cin A2 B2) c0) (wrex x3 (wcel (cv x3) B2) A2) $;

--| A nonempty intersection. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem inn0 {x3: setvar} (A2 B2: class):
  $ wb (wne (cin A2 B2) c0) (wrex x3 (wcel (cv x3) B2) A2) $;

--| Difference, intersection, and subclass relationship. (Contributed by NM, 30-Apr-1994.) (Proof shortened by Wolf Lammen, 30-Sep-2014.)
theorem difin0ss (A2 B2 C: class):
  $ wi (wceq (cin (cdif A2 B2) C) c0) (wi (wss C A2) (wss C B2)) $;

--| Intersection, subclass, and difference relationship. (Contributed by NM, 27-Oct-1996.) (Proof shortened by Andrew Salmon, 26-Jun-2011.) (Proof shortened by Wolf Lammen, 30-Sep-2014.) (Proof shortened by BJ, 18-Jul-2026.)
theorem inssdif0 (A2 B2 C: class):
  $ wb (wss (cin A2 B2) C) (wceq (cin A2 (cdif B2 C)) c0) $;

--| Obsolete version of ~ inssdif0 as of 18-Jul-2026. (Contributed by NM, 27-Oct-1996.) (Proof shortened by Andrew Salmon, 26-Jun-2011.) (Proof shortened by Wolf Lammen, 30-Sep-2014.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem inssdif0OLD (A2 B2 C: class):
  $ wb (wss (cin A2 B2) C) (wceq (cin A2 (cdif B2 C)) c0) $;

--| The intersection and class difference of a class with another class are disjoint. With ~ inundif , this shows that such intersection and class difference partition the class ` A ` . (Contributed by Thierry Arnoux, 13-Sep-2017.)
theorem inindif (A2 C: class):
  $ wceq (cin (cin A2 C) (cdif A2 C)) c0 $;

--| The difference between a class and itself is the empty set. Proposition 5.15 of [TakeutiZaring] p. 20. Also Theorem 32 of [Suppes] p. 28. (Contributed by NM, 22-Apr-2004.) (Revised by David Abernethy, 17-Jun-2012.)
theorem difid (A2: class):
  $ wceq (cdif A2 A2) c0 $;

--| Alternate proof of ~ difid . Shorter, but requiring ~ ax-8 , ~ df-clel . (Contributed by NM, 22-Apr-2004.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem difidALT (A2: class):
  $ wceq (cdif A2 A2) c0 $;

--| The difference between a class and the empty set. Part of Exercise 4.4 of [Stoll] p. 16. (Contributed by NM, 17-Aug-2004.)
theorem dif0 (A2: class):
  $ wceq (cdif A2 c0) A2 $;

--| The class of sets verifying a property is the empty class if and only if that property is a contradiction. Version of ~ ab0 using implicit substitution, which requires fewer axioms. (Contributed by GG, 3-Oct-2024.)
theorem ab0w {x3 y1: setvar} (ph: wff x3) (ps: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wceq (cab x3 ph) c0) (wal y1 (wn ps)) $;

--| The class of sets verifying a property is the empty class if and only if that property is a contradiction. See also ~ abn0 (from which it could be proved using as many essential proof steps but one fewer syntactic step, at the cost of depending on ~ df-ne ). (Contributed by BJ, 19-Mar-2021.) Avoid ~ df-clel , ~ ax-8 . (Revised by GG, 30-Aug-2024.) (Proof shortened by SN, 8-Sep-2024.)
theorem ab0 {x3: setvar} (ph: wff x3):
  $ wb (wceq (cab x3 ph) c0) (wal x3 (wn ph)) $;

--| Alternate proof of ~ ab0 , shorter but using more axioms. (Contributed by BJ, 19-Mar-2021.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ab0ALT {x3: setvar} (ph: wff x3):
  $ wb (wceq (cab x3 ph) c0) (wal x3 (wn ph)) $;

--| Characterization of nonfreeness in a formula in terms of its extension. (Contributed by BJ, 19-Mar-2021.)
theorem dfnf5 {x3: setvar} (ph: wff x3):
  $ wb (wnf x3 ph) (wo (wceq (cab x3 ph) cvv) (wceq (cab x3 ph) c0)) $;

--| The class abstraction defined by a formula not containing the abstraction variable is either the empty set or the universal class. (Contributed by Mario Carneiro, 29-Aug-2013.) (Revised by BJ, 22-Mar-2020.) Reduce axiom usage. (Revised by GG, 30-Aug-2024.)
theorem ab0orv {x3: setvar} (ph: wff):
  $ wo (wceq (cab x3 ph) cvv) (wceq (cab x3 ph) c0) $;

--| Alternate proof of ~ ab0orv , shorter but using more axioms. (Contributed by Mario Carneiro, 29-Aug-2013.) (Revised by BJ, 22-Mar-2020.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ab0orvALT {x3: setvar} (ph: wff):
  $ wo (wceq (cab x3 ph) cvv) (wceq (cab x3 ph) c0) $;

--| Nonempty class abstraction. See also ~ ab0 . (Contributed by NM, 26-Dec-1996.) (Proof shortened by Mario Carneiro, 11-Nov-2016.) Avoid ~ df-clel , ~ ax-8 . (Revised by GG, 30-Aug-2024.)
theorem abn0 {x3: setvar} (ph: wff x3):
  $ wb (wne (cab x3 ph) c0) (wex x3 ph) $;

--| Any restricted class abstraction restricted to the empty set is empty. (Contributed by NM, 15-Oct-2003.) (Proof shortened by Andrew Salmon, 26-Jun-2011.) (Proof shortened by JJ, 14-Jul-2021.) (Proof shortened by Umit Teoman Dogan, 10-Jun-2026.)
theorem rab0 {x3: setvar} (ph: wff x3):
  $ wceq (crab x3 ph c0) c0 $;

--| Obsolete version of ~ rab0 as of 10-Jun-2026. (Contributed by NM, 15-Oct-2003.) (Proof shortened by Andrew Salmon, 26-Jun-2011.) (Proof shortened by JJ, 14-Jul-2021.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem rab0OLD {x3: setvar} (ph: wff x3):
  $ wceq (crab x3 ph c0) c0 $;

--| Condition for a restricted class abstraction to be empty. Version of ~ rabeq0 using implicit substitution, which does not require ~ ax-10 , ~ ax-11 , ~ ax-12 , but requires ~ ax-8 . (Contributed by GG, 30-Sep-2024.)
theorem rabeq0w {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wceq (crab x3 ph A2) c0) (wral y1 (wn ps) A2) $;

--| Condition for a restricted class abstraction to be empty. (Contributed by Jeff Madsen, 7-Jun-2010.) (Revised by BJ, 16-Jul-2021.)
theorem rabeq0 {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wceq (crab x3 ph A2) c0) (wral x3 (wn ph) A2) $;

--| Nonempty restricted class abstraction. (Contributed by NM, 29-Aug-1999.) (Revised by BJ, 16-Jul-2021.)
theorem rabn0 {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wne (crab x3 ph A2) c0) (wrex x3 ph A2) $;

--| Law of excluded middle, in terms of restricted class abstractions. (Contributed by Jeff Madsen, 20-Jun-2011.)
theorem rabxm {x3: setvar} (ph: wff x3) (A2: class):
  $ wceq A2 (cun (crab x3 ph A2) (crab x3 (wn ph) A2)) $;

--| Law of noncontradiction, in terms of restricted class abstractions. (Contributed by Jeff Madsen, 20-Jun-2011.)
theorem rabnc {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wceq (cin (crab x3 ph A2) (crab x3 (wn ph) A2)) c0 $;

--| The set of elements ` s ` determining classes ` C ` (which may depend on ` s ` ) containing a special element and the set of elements ` s ` determining classes ` C ` not containing the special element are disjoint. (Contributed by Alexander van der Vekens, 11-Jan-2018.) (Revised by AV, 9-Nov-2020.) (Revised by AV, 17-Dec-2021.)
theorem elneldisj {s1: setvar} (A2: class) (B2 C E N: class s1):
  $ wceq E (crab s1 (wcel B2 C) A2) $ >
  $ wceq N (crab s1 (wnel B2 C) A2) $ >
  $ wceq (cin E N) c0 $;

--| The union of the set of elements ` s ` determining classes ` C ` (which may depend on ` s ` ) containing a special element and the set of elements ` s ` determining classes ` C ` not containing the special element yields the original set. (Contributed by Alexander van der Vekens, 11-Jan-2018.) (Revised by AV, 9-Nov-2020.) (Revised by AV, 17-Dec-2021.)
theorem elnelun {s1: setvar} (A2: class) (B2 C E N: class s1):
  $ wceq E (crab s1 (wcel B2 C) A2) $ >
  $ wceq N (crab s1 (wnel B2 C) A2) $ >
  $ wceq (cun E N) A2 $;

--| The union of a class with the empty set is itself. Dual of ~ inv1 . Commuted form of ~ 0un . Theorem 24 of [Suppes] p. 27. (Contributed by NM, 15-Jul-1993.)
theorem un0 (A2: class):
  $ wceq (cun A2 c0) A2 $;

--| The intersection of a class with the empty set is the empty set. Dual of ~ unv . Commuted form of ~ in0 . Theorem 16 of [Suppes] p. 26. (Contributed by NM, 21-Jun-1993.)
theorem in0 (A2: class):
  $ wceq (cin A2 c0) c0 $;

--| The union of the empty set with a class is itself. Commuted form of ~ un0 . (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem _0un (A2: class):
  $ wceq (cun c0 A2) A2 $;

--| The intersection of the empty set with a class is the empty set. Commuted form of ~ 0in . (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem _0in (A2: class):
  $ wceq (cin c0 A2) c0 $;

--| The intersection of a class with the universal class is itself. Dual of ~ un0 . Exercise 4.10(k) of [Mendelson] p. 231. (Contributed by NM, 17-May-1998.)
theorem inv1 (A2: class):
  $ wceq (cin A2 cvv) A2 $;

--| The union of a class with the universal class is the universal class. Dual of ~ in0 . Exercise 4.10(l) of [Mendelson] p. 231. (Contributed by NM, 17-May-1998.)
theorem unv (A2: class):
  $ wceq (cun A2 cvv) cvv $;

--| The empty set is a subset of any class. Dual of ~ ssv . Part of Exercise 1 of [TakeutiZaring] p. 22. (Contributed by NM, 21-Jun-1993.)
theorem _0ss (A2: class):
  $ wss c0 A2 $;

--| Any subset of the empty set is empty. Dual of ~ vss . Theorem 5 of [Suppes] p. 23 and its converse. (Contributed by NM, 17-Sep-2003.)
theorem ss0b (A2: class):
  $ wb (wss A2 c0) (wceq A2 c0) $;

--| Any subset of the empty set is empty. Theorem 5 of [Suppes] p. 23. (Contributed by NM, 13-Aug-1994.)
theorem ss0 (A2: class):
  $ wi (wss A2 c0) (wceq A2 c0) $;

--| The only subclass of the empty class is itself. (Contributed by NM, 7-Mar-2007.) Strengthen ~ sseq0 to a biconditional. (Revised by BJ, 19-Jul-2026.)
theorem sseq0b (A2 B2: class):
  $ wi (wceq A2 c0) (wb (wss B2 A2) (wceq B2 c0)) $;

--| A subclass of an empty class is empty. (Contributed by NM, 7-Mar-2007.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem sseq0 (A2 B2: class):
  $ wi (wa (wss A2 B2) (wceq B2 c0)) (wceq A2 c0) $;

--| A class with a nonempty subclass is nonempty. (Contributed by NM, 17-Feb-2007.)
theorem ssn0 (A2 B2: class):
  $ wi (wa (wss A2 B2) (wne A2 c0)) (wne B2 c0) $;

--| The difference between the empty set and a class. Part of Exercise 4.4 of [Stoll] p. 16. (Contributed by NM, 17-Aug-2004.)
theorem _0dif (A2: class):
  $ wceq (cdif c0 A2) c0 $;

--| Two classes are both empty if and only if their union is empty. Dual of ~ vvin . (Contributed by NM, 11-Aug-2004.)
theorem un00 (A2 B2: class):
  $ wb (wa (wceq A2 c0) (wceq B2 c0)) (wceq (cun A2 B2) c0) $;

--| Only the universal class has the universal class as a subclass. Dual of ~ ss0b . (Contributed by NM, 17-Sep-2003.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem vss (A2: class):
  $ wb (wss cvv A2) (wceq A2 cvv) $;

--| Two classes are both the universal class if and only if their intersection is the universal class. Dual of ~ un00 . (Contributed by BJ, 12-Jul-2026.)
theorem vvin (A2 B2: class):
  $ wb (wa (wceq A2 cvv) (wceq B2 cvv)) (wceq (cin A2 B2) cvv) $;

--| The empty set is a proper subset of any nonempty set. Dual of ~ pssv . (Contributed by NM, 27-Feb-1996.)
theorem _0pss (A2: class):
  $ wb (wpss c0 A2) (wne A2 c0) $;

--| No set is a proper subset of the empty set. Dual of ~ nvpss . (Contributed by NM, 17-Jun-1998.) (Proof shortened by Andrew Salmon, 26-Jun-2011.) (Proof shortened by JJ, 14-Jul-2021.)
theorem npss0 (A2: class):
  $ wn (wpss A2 c0) $;

--| Any non-universal class is a proper subclass of the universal class. Dual of ~ 0pss . (Contributed by NM, 17-May-1998.)
theorem pssv (A2: class):
  $ wb (wpss A2 cvv) (wn (wceq A2 cvv)) $;

--| No class strictly includes the universal class. Dual of ~ npss0 . (Contributed by BJ, 12-Jul-2026.)
theorem nvpss (A2: class):
  $ wn (wpss cvv A2) $;

--| A class abstraction determined by a false formula is empty. (Contributed by NM, 20-Jan-2012.) Avoid ~ ax-8 , ~ ax-10 , ~ ax-11 , ~ ax-12 . (Revised by GG, 30-Jun-2024.)
theorem abf {x3: setvar} (ph: wff x3):
  $ wn ph $ >
  $ wceq (cab x3 ph) c0 $;

--| Deduction for equality to the empty set. (Contributed by NM, 11-Jul-2014.) Avoid ~ ax-8 , ~ df-clel . (Revised by GG, 6-Sep-2024.)
theorem eq0rdv {x3: setvar} (ph: wff) (A2: class):
  $ wi ph (wn (wcel (cv x3) A2)) $ >
  $ wi ph (wceq A2 c0) $;

--| Alternate proof of ~ eq0rdv . Shorter, but requiring ~ df-clel , ~ ax-8 . (Contributed by NM, 11-Jul-2014.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem eq0rdvALT {x3: setvar} (ph: wff) (A2: class):
  $ wi ph (wn (wcel (cv x3) A2)) $ >
  $ wi ph (wceq A2 c0) $;

--| The proper substitution of a proper class for a set into a class results in the empty set. (Contributed by NM, 17-Aug-2018.) (Proof shortened by JJ, 27-Aug-2021.)
theorem csbprc {x3: setvar} (A2 B2: class x3):
  $ wi (wn (wcel A2 cvv)) (wceq (csb x3 A2 B2) c0) $;

--| The proper substitution of a class into the empty set is the empty set. (Contributed by NM, 18-Aug-2018.)
theorem csb0 {x3: setvar} (A2: class x3):
  $ wceq (csb x3 A2 c0) c0 $;

--| Distribute proper substitution through a membership relation. (Contributed by NM, 10-Nov-2005.) (Revised by NM, 18-Aug-2018.)
theorem sbcel12 {x3: setvar} (A2 B2 C: class x3):
  $ wb (wsbc x3 (wcel B2 C) A2) (wcel (csb x3 A2 B2) (csb x3 A2 C)) $;

--| Distribute proper substitution through an equality relation. (Contributed by NM, 10-Nov-2005.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem sbceqg {x3: setvar} (A2 B2 C V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wceq B2 C) A2) (wceq (csb x3 A2 B2) (csb x3 A2 C))) $;

--| Distribution of class substitution over equality, in inference form. (Contributed by Giovanni Mascellani, 27-May-2019.)
theorem sbceqi {x3: setvar} (A2 B2 C D E: class x3):
  $ wcel A2 cvv $ >
  $ wceq (csb x3 A2 B2) D $ >
  $ wceq (csb x3 A2 C) E $ >
  $ wb (wsbc x3 (wceq B2 C) A2) (wceq D E) $;

--| Distribute proper substitution through negated membership. (Contributed by Andrew Salmon, 18-Jun-2011.)
theorem sbcnel12g {x3: setvar} (A2 B2 C V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wnel B2 C) A2) (wnel (csb x3 A2 B2) (csb x3 A2 C))) $;

--| Distribute proper substitution through an inequality. (Contributed by Andrew Salmon, 18-Jun-2011.) (Revised by NM, 18-Aug-2018.)
theorem sbcne12 {x3: setvar} (A2 B2 C: class x3):
  $ wb (wsbc x3 (wne B2 C) A2) (wne (csb x3 A2 B2) (csb x3 A2 C)) $;

--| Move proper substitution in and out of a membership relation. Note that the scope of ` [. A / x ]. ` is the wff ` B e. C ` , whereas the scope of ` [_ A / x ]_ ` is the class ` B ` . (Contributed by NM, 10-Nov-2005.)
theorem sbcel1g {x3: setvar} (A2 B2: class x3) (C: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wcel B2 C) A2) (wcel (csb x3 A2 B2) C)) $;

--| Move proper substitution to first argument of an equality. (Contributed by NM, 30-Nov-2005.)
theorem sbceq1g {x3: setvar} (A2 B2: class x3) (C: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wceq B2 C) A2) (wceq (csb x3 A2 B2) C)) $;

--| Move proper substitution in and out of a membership relation. (Contributed by NM, 14-Nov-2005.) (Revised by NM, 18-Aug-2018.)
theorem sbcel2 {x3: setvar} (A2: class x3) (B2: class) (C: class x3):
  $ wb (wsbc x3 (wcel B2 C) A2) (wcel B2 (csb x3 A2 C)) $;

--| Move proper substitution to second argument of an equality. (Contributed by NM, 30-Nov-2005.)
theorem sbceq2g {x3: setvar} (A2: class x3) (B2: class) (C V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wceq B2 C) A2) (wceq B2 (csb x3 A2 C))) $;

--| Commutative law for double substitution into a class. (Contributed by NM, 14-Nov-2005.) (Revised by NM, 18-Aug-2018.)
theorem csbcom {x3 y1: setvar} (A2: class x3) (B2: class y1) (C: class x3 y1):
  $ wceq (csb x3 A2 (csb y1 B2 C)) (csb y1 B2 (csb x3 A2 C)) $;

--| Nest the composition of two substitutions. Version of ~ sbcnestgf with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by Mario Carneiro, 11-Nov-2016.) Avoid ~ ax-13 . (Revised by GG, 26-Jan-2024.)
theorem sbcnestgfw {x3 y1: setvar} (ph: wff x3 y1) (A2 B2 V: class x3 y1):
  $ wi (wa (wcel A2 V) (wal y1 (wnf x3 ph))) (wb (wsbc x3 (wsbc y1 ph B2) A2) (wsbc y1 ph (csb x3 A2 B2))) $;

--| Nest the composition of two substitutions. Version of ~ csbnestgf with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by NM, 23-Nov-2005.) Avoid ~ ax-13 . (Revised by GG, 26-Jan-2024.)
theorem csbnestgfw {x3 y1: setvar} (A2 B2 C V: class x3 y1):
  $ wi (wa (wcel A2 V) (wal y1 (wnfc x3 C))) (wceq (csb x3 A2 (csb y1 B2 C)) (csb y1 (csb x3 A2 B2) C)) $;

--| Nest the composition of two substitutions. Version of ~ sbcnestg with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by NM, 27-Nov-2005.) Avoid ~ ax-13 . (Revised by GG, 26-Jan-2024.)
theorem sbcnestgw {x3 y1: setvar} (ph: wff y1) (A2 B2 V: class x3 y1):
  $ wi (wcel A2 V) (wb (wsbc x3 (wsbc y1 ph B2) A2) (wsbc y1 ph (csb x3 A2 B2))) $;

--| Nest the composition of two substitutions. Version of ~ csbnestg with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by NM, 23-Nov-2005.) Avoid ~ ax-13 . (Revised by GG, 26-Jan-2024.)
theorem csbnestgw {x3 y1: setvar} (A2 B2: class x3 y1) (C: class y1) (V: class x3 y1):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (csb y1 B2 C)) (csb y1 (csb x3 A2 B2) C)) $;

--| Composition of two substitutions. Version of ~ sbcco3g with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by NM, 27-Nov-2005.) Avoid ~ ax-13 . (Revised by GG, 26-Jan-2024.)
theorem sbcco3gw {x3 y1: setvar} (ph: wff y1) (A2: class y1) (B2: class x3 y1) (C: class y1) (V: class x3 y1):
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wi (wcel A2 V) (wb (wsbc x3 (wsbc y1 ph B2) A2) (wsbc y1 ph C)) $;

--| Nest the composition of two substitutions. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ sbcnestgfw when possible. (Contributed by Mario Carneiro, 11-Nov-2016.) (New usage is discouraged.)
theorem sbcnestgf {x3 y1: setvar} (ph: wff x3 y1) (A2 B2 V: class x3 y1):
  $ wi (wa (wcel A2 V) (wal y1 (wnf x3 ph))) (wb (wsbc x3 (wsbc y1 ph B2) A2) (wsbc y1 ph (csb x3 A2 B2))) $;

--| Nest the composition of two substitutions. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ csbnestgfw when possible. (Contributed by NM, 23-Nov-2005.) (Proof shortened by Mario Carneiro, 10-Nov-2016.) (New usage is discouraged.)
theorem csbnestgf {x3 y1: setvar} (A2 B2 C V: class x3 y1):
  $ wi (wa (wcel A2 V) (wal y1 (wnfc x3 C))) (wceq (csb x3 A2 (csb y1 B2 C)) (csb y1 (csb x3 A2 B2) C)) $;

--| Nest the composition of two substitutions. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ sbcnestgw when possible. (Contributed by NM, 27-Nov-2005.) (Proof shortened by Mario Carneiro, 11-Nov-2016.) (New usage is discouraged.)
theorem sbcnestg {x3 y1: setvar} (ph: wff y1) (A2 B2 V: class x3 y1):
  $ wi (wcel A2 V) (wb (wsbc x3 (wsbc y1 ph B2) A2) (wsbc y1 ph (csb x3 A2 B2))) $;

--| Nest the composition of two substitutions. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ csbnestgw when possible. (Contributed by NM, 23-Nov-2005.) (Proof shortened by Mario Carneiro, 10-Nov-2016.) (New usage is discouraged.)
theorem csbnestg {x3 y1: setvar} (A2 B2: class x3 y1) (C: class y1) (V: class x3 y1):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (csb y1 B2 C)) (csb y1 (csb x3 A2 B2) C)) $;

--| Composition of two substitutions. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ sbcco3gw when possible. (Contributed by NM, 27-Nov-2005.) (Revised by Mario Carneiro, 11-Nov-2016.) (New usage is discouraged.)
theorem sbcco3g {x3 y1: setvar} (ph: wff y1) (A2: class y1) (B2: class x3 y1) (C: class y1) (V: class x3 y1):
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wi (wcel A2 V) (wb (wsbc x3 (wsbc y1 ph B2) A2) (wsbc y1 ph C)) $;

--| Composition of two class substitutions. Usage of this theorem is discouraged because it depends on ~ ax-13 . (Contributed by NM, 27-Nov-2005.) (Revised by Mario Carneiro, 11-Nov-2016.) (New usage is discouraged.)
theorem csbco3g {x3 y1: setvar} (A2: class y1) (B2: class x3 y1) (C D: class y1) (V: class x3 y1):
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wi (wcel A2 V) (wceq (csb x3 A2 (csb y1 B2 D)) (csb y1 C D)) $;

--| Nest the composition of two substitutions. (Contributed by NM, 23-May-2006.) (Proof shortened by Mario Carneiro, 11-Nov-2016.)
theorem csbnest1g {x3: setvar} (A2 B2 C V: class x3):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (csb x3 B2 C)) (csb x3 (csb x3 A2 B2) C)) $;

--| Idempotent law for class substitutions. (Contributed by NM, 1-Mar-2008.) (Revised by NM, 18-Aug-2018.)
theorem csbidm {x3: setvar} (A2: class) (B2: class x3):
  $ wceq (csb x3 A2 (csb x3 A2 B2)) (csb x3 A2 B2) $;

--| The proper substitution of a class for setvar variable results in the class (if the class exists). (Contributed by NM, 10-Nov-2005.)
theorem csbvarg {x3: setvar} (A2 V: class x3):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (cv x3)) A2) $;

--| The proper substitution of a class for a setvar variable results in the class (if the class exists), in inference form of ~ csbvarg . (Contributed by Giovanni Mascellani, 30-May-2019.)
theorem csbvargi {x3: setvar} (A2: class x3):
  $ wcel A2 cvv $ >
  $ wceq (csb x3 A2 (cv x3)) A2 $;

--| Substitution into a wff expressed in terms of substitution into a class. (Contributed by NM, 15-Aug-2007.) (Revised by NM, 18-Aug-2018.)
theorem sbccsb {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wb (wsbc x3 ph A2) (wcel (cv y1) (csb x3 A2 (cab y1 ph))) $;

--| Substitution into a wff expressed in using substitution into a class. (Contributed by NM, 27-Nov-2005.) (Revised by NM, 18-Aug-2018.)
theorem sbccsb2 {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wsbc x3 ph A2) (wcel A2 (csb x3 A2 (cab x3 ph))) $;

--| Special case related to ~ rspsbc . (Contributed by NM, 10-Dec-2005.) (Proof shortened by Eric Schmidt, 17-Jan-2007.)
theorem rspcsbela {x3: setvar} (A2: class x3) (B2: class) (C: class x3) (D: class):
  $ wi (wa (wcel A2 B2) (wral x3 (wcel C D) B2)) (wcel (csb x3 A2 C) D) $;

--| Two ways of expressing " ` x ` is (effectively) not free in ` A ` ". (Contributed by Mario Carneiro, 14-Oct-2016.)
theorem sbnfc2 {x3 y1 z: setvar} (A2: class x3):
  $ wb (wnfc x3 A2) (wal y1 (wal z (wceq (csb x3 (cv y1) A2) (csb x3 (cv z) A2)))) $;

--| Move substitution into a class abstraction. (Contributed by NM, 13-Dec-2005.) (Revised by NM, 19-Aug-2018.)
theorem csbab {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3):
  $ wceq (csb x3 A2 (cab y1 ph)) (cab y1 (wsbc x3 ph A2)) $;

--| Distribution of class substitution over union of two classes. (Contributed by Drahflow, 23-Sep-2015.) (Revised by Mario Carneiro, 11-Dec-2016.) (Revised by NM, 13-Sep-2018.)
theorem csbun {x3: setvar} (A2 B2 C: class x3):
  $ wceq (csb x3 A2 (cun B2 C)) (cun (csb x3 A2 B2) (csb x3 A2 C)) $;

--| Distribute proper substitution into a class through an intersection relation. (Contributed by Alan Sare, 22-Jul-2012.) (Revised by NM, 18-Aug-2018.)
theorem csbin {x3: setvar} (A2 B2 C: class x3):
  $ wceq (csb x3 A2 (cin B2 C)) (cin (csb x3 A2 B2) (csb x3 A2 C)) $;

--| Conversion of implicit substitution to explicit class substitution. This version of ~ csbiedf avoids a disjointness condition on ` x , A ` and ` x , D ` by substituting twice. Deduction form of ~ csbie2 . (Contributed by AV, 29-Mar-2024.)
theorem csbie2df {x3 y1: setvar} (ph: wff x3) (A2 B2: class x3) (C: class x3 y1) (D: class x3) (V: class x3 y1):
  $ wnf x3 ph $ >
  $ wi ph (wnfc x3 C) $ >
  $ wi ph (wnfc x3 D) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wceq B2 C) $ >
  $ wi (wa ph (wceq (cv y1) A2)) (wceq C D) $ >
  $ wi ph (wceq (csb x3 A2 B2) D) $;

--| If there are two different sets fulfilling a wff (by implicit substitution), then there is no unique set fulfilling the wff. (Contributed by AV, 20-Jun-2023.)
theorem _2nreu {x3: setvar} (ph: wff x3) (ps ch: wff) (A2 B2 X: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv x3) B2) (wb ph ch) $ >
  $ wi (w3a (wcel A2 X) (wcel B2 X) (wne A2 B2)) (wi (wa ps ch) (wn (wreu x3 ph X))) $;

--| Two ways of saying that two classes are disjoint (have no members in common). (Contributed by NM, 17-Feb-2004.) Avoid ~ ax-10 , ~ ax-11 , ~ ax-12 . (Revised by GG, 28-Jun-2024.)
theorem disj {x3: setvar} (A2 B2: class):
  $ wb (wceq (cin A2 B2) c0) (wral x3 (wn (wcel (cv x3) B2)) A2) $;

--| Two ways of saying that two classes are disjoint. (Contributed by Jeff Madsen, 19-Jun-2011.)
theorem disjr {x3: setvar} (A2 B2: class):
  $ wb (wceq (cin A2 B2) c0) (wral x3 (wn (wcel (cv x3) A2)) B2) $;

--| Two ways of saying that two classes are disjoint (have no members in common). (Contributed by NM, 19-Aug-1993.)
theorem disj1 {x3: setvar} (A2 B2: class):
  $ wb (wceq (cin A2 B2) c0) (wal x3 (wi (wcel (cv x3) A2) (wn (wcel (cv x3) B2)))) $;

--| Two ways of saying that two classes are disjoint, using the complement of ` B ` relative to a universe ` C ` . (Contributed by NM, 15-Feb-2007.) (Proof shortened by Andrew Salmon, 26-Jun-2011.) Avoid ~ ax-12 . (Revised by GG, 28-Jun-2024.)
theorem reldisj (A2 B2 C: class):
  $ wi (wss A2 C) (wb (wceq (cin A2 B2) c0) (wss A2 (cdif C B2))) $;

--| Two ways of saying that two classes are disjoint. (Contributed by NM, 19-May-1998.)
theorem disj3 (A2 B2: class):
  $ wb (wceq (cin A2 B2) c0) (wceq A2 (cdif A2 B2)) $;

--| Members of disjoint sets are not equal. (Contributed by NM, 28-Mar-2007.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem disjne (A2 B2 C D: class):
  $ wi (w3a (wceq (cin A2 B2) c0) (wcel C A2) (wcel D B2)) (wne C D) $;

--| Two disjoint sets are equal iff both are empty. (Contributed by AV, 19-Jun-2022.)
theorem disjeq0 (A2 B2: class):
  $ wi (wceq (cin A2 B2) c0) (wb (wceq A2 B2) (wa (wceq A2 c0) (wceq B2 c0))) $;

--| A set can't belong to both members of disjoint classes. (Contributed by NM, 28-Feb-2015.)
theorem disjel (A2 B2 C: class):
  $ wi (wa (wceq (cin A2 B2) c0) (wcel C A2)) (wn (wcel C B2)) $;

--| Two ways of saying that two classes are disjoint. (Contributed by NM, 17-May-1998.)
theorem disj2 (A2 B2: class):
  $ wb (wceq (cin A2 B2) c0) (wss A2 (cdif cvv B2)) $;

--| Two ways of saying that two classes are disjoint. (Contributed by NM, 21-Mar-2004.)
theorem disj4 (A2 B2: class):
  $ wb (wceq (cin A2 B2) c0) (wn (wpss (cdif A2 B2) A2)) $;

--| Intersection with a subclass of a disjoint class. (Contributed by FL, 24-Jan-2007.) (Proof shortened by JJ, 14-Jul-2021.)
theorem ssdisj (A2 B2 C: class):
  $ wi (wa (wss A2 B2) (wceq (cin B2 C) c0)) (wceq (cin A2 C) c0) $;

--| A class is a proper subset of its union with a disjoint nonempty class. (Contributed by NM, 15-Sep-2004.)
theorem disjpss (A2 B2: class):
  $ wi (wa (wceq (cin A2 B2) c0) (wne B2 c0)) (wpss A2 (cun A2 B2)) $;

--| The union of disjoint classes is disjoint. (Contributed by NM, 26-Sep-2004.)
theorem undisj1 (A2 B2 C: class):
  $ wb (wa (wceq (cin A2 C) c0) (wceq (cin B2 C) c0)) (wceq (cin (cun A2 B2) C) c0) $;

--| The union of disjoint classes is disjoint. (Contributed by NM, 13-Sep-2004.)
theorem undisj2 (A2 B2 C: class):
  $ wb (wa (wceq (cin A2 B2) c0) (wceq (cin A2 C) c0)) (wceq (cin A2 (cun B2 C)) c0) $;

--| Subclass expressed in terms of intersection with difference from the universal class. (Contributed by NM, 17-Sep-2003.)
theorem ssindif0 (A2 B2: class):
  $ wb (wss A2 B2) (wceq (cin A2 (cdif cvv B2)) c0) $;

--| The intersection of classes with a common member is nonempty. (Contributed by NM, 7-Apr-1994.)
theorem inelcm (A2 B2 C: class):
  $ wi (wa (wcel A2 B2) (wcel A2 C)) (wne (cin B2 C) c0) $;

--| A minimum element of a class has no elements in common with the class. (Contributed by NM, 22-Jun-1994.) (Proof shortened by JJ, 14-Jul-2021.)
theorem minel (A2 B2 C: class):
  $ wi (wa (wcel A2 B2) (wceq (cin C B2) c0)) (wn (wcel A2 C)) $;

--| Distribute union over difference. (Contributed by NM, 17-May-1998.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem undif4 (A2 B2 C: class):
  $ wi (wceq (cin A2 C) c0) (wceq (cun A2 (cdif B2 C)) (cdif (cun A2 B2) C)) $;

--| Subset relation for disjoint classes. (Contributed by NM, 25-Oct-2005.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem disjssun (A2 B2 C: class):
  $ wi (wceq (cin A2 B2) c0) (wb (wss A2 (cun B2 C)) (wss A2 C)) $;

--| Universal class equality in terms of empty difference. (Contributed by NM, 17-Sep-2003.)
theorem vdif0 (A2: class):
  $ wb (wceq A2 cvv) (wceq (cdif cvv A2) c0) $;

--| If the difference between the restricting class of a restricted class abstraction and the restricted class abstraction is empty, the restricting class is equal to this restricted class abstraction. (Contributed by Alexander van der Vekens, 31-Dec-2017.)
theorem difrab0eq {x3: setvar} (ph: wff x3) (V: class):
  $ wb (wceq (cdif V (crab x3 ph V)) c0) (wceq V (crab x3 ph V)) $;

--| A proper subclass has a member in one argument that's not in both. (Contributed by NM, 29-Feb-1996.)
theorem pssnel {x3: setvar} (A2 B2: class):
  $ wi (wpss A2 B2) (wex x3 (wa (wcel (cv x3) B2) (wn (wcel (cv x3) A2)))) $;

--| A class does not intersect a relative complement of a superclass. (Contributed by NM, 24-Mar-1998.) Generalize from ~ disjdif . (Revised by BJ, 19-Jul-2026.)
theorem disjdifg (A2 B2 C: class):
  $ wi (wss A2 B2) (wceq (cin A2 (cdif C B2)) c0) $;

--| A class and its relative complement are disjoint. Theorem 38 of [Suppes] p. 29. (Contributed by NM, 24-Mar-1998.)
theorem disjdif (A2 B2: class):
  $ wceq (cin A2 (cdif B2 A2)) c0 $;

--| A class and its relative complement are disjoint. Commuted form of ~ disjdif . (Contributed by Thierry Arnoux, 29-Nov-2023.)
theorem disjdifr (A2 B2: class):
  $ wceq (cin (cdif B2 A2) A2) c0 $;

--| The difference of a class from its intersection is empty. Theorem 37 of [Suppes] p. 29. (Contributed by NM, 17-Aug-2004.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem difin0 (A2 B2: class):
  $ wceq (cdif (cin A2 B2) B2) c0 $;

--| The union of a class and its complement is the universe. Theorem 5.1(5) of [Stoll] p. 17. (Contributed by NM, 17-Aug-2004.)
theorem unvdif (A2: class):
  $ wceq (cun A2 (cdif cvv A2)) cvv $;

--| Absorption of difference by union. This decomposes a union into two disjoint classes (see ~ disjdif ). Theorem 35 of [Suppes] p. 29. (Contributed by NM, 19-May-1998.)
theorem undif1 (A2 B2: class):
  $ wceq (cun (cdif A2 B2) B2) (cun A2 B2) $;

--| Absorption of difference by union. This decomposes a union into two disjoint classes (see ~ disjdif ). Part of proof of Corollary 6K of [Enderton] p. 144. (Contributed by NM, 19-May-1998.)
theorem undif2 (A2 B2: class):
  $ wceq (cun A2 (cdif B2 A2)) (cun A2 B2) $;

--| If a statement is true for every element of a class and for every element of its complement relative to a second class, then it is true for every element in the second class. (Contributed by BTernaryTau, 27-Sep-2023.)
theorem srcmpltd (ph ps: wff) (A2 B2 C: class):
  $ wi ph (wi (wcel C A2) ps) $ >
  $ wi ph (wi (wcel C (cdif B2 A2)) ps) $ >
  $ wi ph (wi (wcel C B2) ps) $;

--| If a statement is true for all pairs of elements of a class, all pairs of elements of its complement relative to a second class, and all pairs with one element in each, then it is true for all pairs of elements of the second class. (Contributed by BTernaryTau, 27-Sep-2023.)
theorem prsrcmpltd (ph ps: wff) (A2 B2 C D: class):
  $ wi ph (wi (wa (wcel C A2) (wcel D A2)) ps) $ >
  $ wi ph (wi (wa (wcel C A2) (wcel D (cdif B2 A2))) ps) $ >
  $ wi ph (wi (wa (wcel C (cdif B2 A2)) (wcel D A2)) ps) $ >
  $ wi ph (wi (wa (wcel C (cdif B2 A2)) (wcel D (cdif B2 A2))) ps) $ >
  $ wi ph (wi (wa (wcel C B2) (wcel D B2)) ps) $;

--| Absorption of difference by union. (Contributed by NM, 18-Aug-2013.)
theorem undifabs (A2 B2: class):
  $ wceq (cun A2 (cdif A2 B2)) A2 $;

--| The intersection and class difference of a class with another class unite to give the original class. (Contributed by Paul Chapman, 5-Jun-2009.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem inundif (A2 B2: class):
  $ wceq (cun (cin A2 B2) (cdif A2 B2)) A2 $;

--| The difference of a class and a class disjoint from it is the original class. (Contributed by BJ, 21-Apr-2019.)
theorem disjdif2 (A2 B2: class):
  $ wi (wceq (cin A2 B2) c0) (wceq (cdif A2 B2) A2) $;

--| Absorption of union by difference. Theorem 36 of [Suppes] p. 29. (Contributed by NM, 19-May-1998.)
theorem difun2 (A2 B2: class):
  $ wceq (cdif (cun A2 B2) B2) (cdif A2 B2) $;

--| Union of complementary parts into whole. (Contributed by NM, 22-Mar-1998.)
theorem undif (A2 B2: class):
  $ wb (wss A2 B2) (wceq (cun A2 (cdif B2 A2)) B2) $;

--| Union of complementary parts into whole. Commuted form of ~ undifr . (Contributed by Thierry Arnoux, 21-Nov-2023.) (Proof shortened by SN, 11-Mar-2025.)
theorem undifr (A2 B2: class):
  $ wb (wss A2 B2) (wceq (cun (cdif B2 A2) A2) B2) $;

--| An equality involving class union and class difference. (Contributed by Thierry Arnoux, 26-Jun-2024.)
theorem undif5 (A2 B2: class):
  $ wi (wceq (cin A2 B2) c0) (wceq (cdif (cun A2 B2) B2) A2) $;

--| A subset of a difference does not intersect the subtrahend. (Contributed by Jeff Hankins, 1-Sep-2013.) (Proof shortened by Mario Carneiro, 24-Aug-2015.)
theorem ssdifin0 (A2 B2 C: class):
  $ wi (wss A2 (cdif B2 C)) (wceq (cin A2 C) c0) $;

--| A class is a subclass of itself subtracted from another iff it is the empty set. (Contributed by Steve Rodriguez, 20-Nov-2015.)
theorem ssdifeq0 (A2 B2: class):
  $ wb (wss A2 (cdif B2 A2)) (wceq A2 c0) $;

--| A condition equivalent to inclusion in the union of two classes. (Contributed by NM, 26-Mar-2007.)
theorem ssundif (A2 B2 C: class):
  $ wb (wss A2 (cun B2 C)) (wss (cdif A2 B2) C) $;

--| Swap the arguments of a class difference. (Contributed by NM, 29-Mar-2007.)
theorem difcom (A2 B2 C: class):
  $ wb (wss (cdif A2 B2) C) (wss (cdif A2 C) B2) $;

--| Two ways to express overlapping subsets. (Contributed by Stefan O'Rear, 31-Oct-2014.)
theorem pssdifcom1 (A2 B2 C: class):
  $ wi (wa (wss A2 C) (wss B2 C)) (wb (wpss (cdif C A2) B2) (wpss (cdif C B2) A2)) $;

--| Two ways to express non-covering pairs of subsets. (Contributed by Stefan O'Rear, 31-Oct-2014.)
theorem pssdifcom2 (A2 B2 C: class):
  $ wi (wa (wss A2 C) (wss B2 C)) (wb (wpss B2 (cdif C A2)) (wpss A2 (cdif C B2))) $;

--| Distributive law for class difference. Exercise 4.8 of [Stoll] p. 16. (Contributed by NM, 18-Aug-2004.)
theorem difdifdir (A2 B2 C: class):
  $ wceq (cdif (cdif A2 B2) C) (cdif (cdif A2 C) (cdif B2 C)) $;

--| Two ways to say that ` A ` and ` B ` partition ` C ` (when ` A ` and ` B ` don't overlap and ` A ` is a part of ` C ` ). (Contributed by FL, 17-Nov-2008.) (Proof shortened by JJ, 14-Jul-2021.)
theorem uneqdifeq (A2 B2 C: class):
  $ wi (wa (wss A2 C) (wceq (cin A2 B2) c0)) (wb (wceq (cun A2 B2) C) (wceq (cdif C A2) B2)) $;

--| Equality theorem for restricted universal quantifier. (Contributed by Thierry Arnoux, 6-Jul-2019.)
theorem raldifeq {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wral x3 ps (cdif B2 A2)) $ >
  $ wi ph (wb (wral x3 ps A2) (wral x3 ps B2)) $;

--| Vacuous quantification is always true. (Contributed by NM, 11-Mar-1997.) (Proof shortened by Andrew Salmon, 26-Jun-2011.) Avoid ~ df-clel , ~ ax-8 . (Revised by GG, 2-Sep-2024.)
theorem rzal {x3: setvar} (ph: wff x3) (A2: class):
  $ wi (wceq A2 c0) (wral x3 ph A2) $;

--| Alternate proof of ~ rzal . Shorter, but requiring ~ df-clel , ~ ax-8 . (Contributed by NM, 11-Mar-1997.) (Proof shortened by Andrew Salmon, 26-Jun-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem rzalALT {x3: setvar} (ph: wff x3) (A2: class):
  $ wi (wceq A2 c0) (wral x3 ph A2) $;

--| Restricted existential quantification implies its restriction is nonempty. (Contributed by Szymon Jaroszewicz, 3-Apr-2007.) Avoid ~ df-clel , ~ ax-8 . (Revised by GG, 2-Sep-2024.)
theorem rexn0 {x3: setvar} (ph: wff x3) (A2: class):
  $ wi (wrex x3 ph A2) (wne A2 c0) $;

--| The quantification of a falsehood is vacuous when true. (Contributed by NM, 26-Nov-2005.) (Proof shortened by JJ, 14-Jul-2021.)
theorem ralf0 {x3: setvar} (ph: wff x3) (A2: class):
  $ wn ph $ >
  $ wb (wral x3 ph A2) (wceq A2 c0) $;

--| Vacuous universal quantification is always true. (Contributed by NM, 20-Oct-2005.) Avoid ~ df-clel , ~ ax-8 . (Revised by GG, 2-Sep-2024.)
theorem ral0 {x3: setvar} (ph: wff x3):
  $ wral x3 ph c0 $;

--| Theorem 19.2 of [Margaris] p. 89 with restricted quantifiers (compare ~ 19.2 ). The restricted version is valid only when the domain of quantification is not empty. (Contributed by NM, 15-Nov-2003.)
theorem r19_2z {x3: setvar} (ph: wff x3) (A2: class):
  $ wi (wa (wne A2 c0) (wral x3 ph A2)) (wrex x3 ph A2) $;

--| A response to the notion that the condition ` A =/= (/) ` can be removed in ~ r19.2z . Interestingly enough, ` ph ` does not figure in the left-hand side. (Contributed by Jeff Hankins, 24-Aug-2009.)
theorem r19_2zb {x3: setvar} (ph: wff x3) (A2: class):
  $ wb (wne A2 c0) (wi (wral x3 ph A2) (wrex x3 ph A2)) $;

--| Restricted quantification of wff not containing quantified variable. (Contributed by FL, 3-Jan-2008.)
theorem r19_3rz {x3: setvar} (ph: wff x3) (A2: class):
  $ wnf x3 ph $ >
  $ wi (wne A2 c0) (wb ph (wral x3 ph A2)) $;

--| Restricted quantifier version of Theorem 19.28 of [Margaris] p. 90. It is valid only when the domain of quantification is not empty. (Contributed by NM, 26-Oct-2010.)
theorem r19_28z {x3: setvar} (ph ps: wff x3) (A2: class):
  $ wnf x3 ph $ >
  $ wi (wne A2 c0) (wb (wral x3 (wa ph ps) A2) (wa ph (wral x3 ps A2))) $;

--| Restricted quantification of wff not containing quantified variable. (Contributed by NM, 10-Mar-1997.) Avoid ~ ax-12 . (Revised by TM, 16-Feb-2026.)
theorem r19_3rzv {x3: setvar} (ph: wff) (A2: class):
  $ wi (wne A2 c0) (wb ph (wral x3 ph A2)) $;

--| Obsolete version of ~ r19.3rzv as of 16-Feb-2026. (Contributed by NM, 10-Mar-1997.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem r19_3rzvOLD {x3: setvar} (ph: wff) (A2: class):
  $ wi (wne A2 c0) (wb ph (wral x3 ph A2)) $;

--| Restricted quantification of wff not containing quantified variable. (Contributed by NM, 27-May-1998.)
theorem r19_9rzv {x3: setvar} (ph: wff) (A2: class):
  $ wi (wne A2 c0) (wb ph (wrex x3 ph A2)) $;

--| Restricted quantifier version of Theorem 19.28 of [Margaris] p. 90. It is valid only when the domain of quantification is not empty. (Contributed by NM, 19-Aug-2004.)
theorem r19_28zv {x3: setvar} (ph: wff) (ps: wff x3) (A2: class):
  $ wi (wne A2 c0) (wb (wral x3 (wa ph ps) A2) (wa ph (wral x3 ps A2))) $;

--| Restricted quantifier version of Theorem 19.37 of [Margaris] p. 90. It is valid only when the domain of quantification is not empty. (Contributed by Paul Chapman, 8-Oct-2007.)
theorem r19_37zv {x3: setvar} (ph: wff) (ps: wff x3) (A2: class):
  $ wi (wne A2 c0) (wb (wrex x3 (wi ph ps) A2) (wi ph (wrex x3 ps A2))) $;

--| Restricted version of Theorem 19.45 of [Margaris] p. 90. (Contributed by NM, 27-May-1998.)
theorem r19_45zv {x3: setvar} (ph: wff) (ps: wff x3) (A2: class):
  $ wi (wne A2 c0) (wb (wrex x3 (wo ph ps) A2) (wo ph (wrex x3 ps A2))) $;

--| Restricted version of Theorem 19.44 of [Margaris] p. 90. (Contributed by NM, 27-May-1998.)
theorem r19_44zv {x3: setvar} (ph: wff x3) (ps: wff) (A2: class):
  $ wi (wne A2 c0) (wb (wrex x3 (wo ph ps) A2) (wo (wrex x3 ph A2) ps)) $;

--| Restricted quantifier version of Theorem 19.27 of [Margaris] p. 90. It is valid only when the domain of quantification is not empty. (Contributed by NM, 26-Oct-2010.)
theorem r19_27z {x3: setvar} (ph ps: wff x3) (A2: class):
  $ wnf x3 ps $ >
  $ wi (wne A2 c0) (wb (wral x3 (wa ph ps) A2) (wa (wral x3 ph A2) ps)) $;

--| Restricted quantifier version of Theorem 19.27 of [Margaris] p. 90. It is valid only when the domain of quantification is not empty. (Contributed by NM, 19-Aug-2004.)
theorem r19_27zv {x3: setvar} (ph: wff x3) (ps: wff) (A2: class):
  $ wi (wne A2 c0) (wb (wral x3 (wa ph ps) A2) (wa (wral x3 ph A2) ps)) $;

--| Restricted quantifier version of Theorem 19.36 of [Margaris] p. 90. It is valid only when the domain of quantification is not empty. (Contributed by NM, 20-Sep-2003.)
theorem r19_36zv {x3: setvar} (ph: wff x3) (ps: wff) (A2: class):
  $ wi (wne A2 c0) (wb (wrex x3 (wi ph ps) A2) (wi (wral x3 ph A2) ps)) $;

--| A contradiction concerning restricted generalization for a nonempty set implies anything. (Contributed by Alexander van der Vekens, 4-Sep-2018.)
theorem ralnralall {x3: setvar} (ph ps: wff x3) (A2: class):
  $ wi (wne A2 c0) (wi (wa (wral x3 ph A2) (wral x3 (wn ph) A2)) ps) $;

--| A false statement can only be true for elements of an empty set. (Contributed by AV, 30-Oct-2020.) (Proof shortened by TM, 16-Feb-2026.)
theorem falseral0 {x3: setvar} (ph: wff x3) (A2: class):
  $ wi (wa (wal x3 (wn ph)) (wral x3 ph A2)) (wceq A2 c0) $;

--| Obsolete version of ~ falseral0 as of 16-Feb-2026. (Contributed by AV, 30-Oct-2020.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem falseral0OLD {x3: setvar} (ph: wff x3) (A2: class):
  $ wi (wa (wal x3 (wn ph)) (wral x3 ph A2)) (wceq A2 c0) $;

--| Idempotent law for restricted quantifier. Weak version of ~ ralidm , which does not require ~ ax-10 , ~ ax-12 , but requires ~ ax-8 . (Contributed by GG, 30-Sep-2024.)
theorem ralidmw {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wb (wral x3 (wral x3 ph A2) A2) (wral x3 ph A2) $;

--| Idempotent law for restricted quantifier. (Contributed by NM, 28-Mar-1997.) Reduce axiom usage. (Revised by GG, 2-Sep-2024.)
theorem ralidm {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wral x3 (wral x3 ph A2) A2) (wral x3 ph A2) $;

--| Rearrange restricted quantifiers. (Contributed by NM, 26-Oct-2010.)
theorem raaan {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wb (wral x3 (wral y1 (wa ph ps) A2) A2) (wa (wral x3 ph A2) (wral y1 ps A2)) $;

--| Rearrange restricted quantifiers. (Contributed by NM, 11-Mar-1997.)
theorem raaanv {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class):
  $ wb (wral x3 (wral y1 (wa ph ps) A2) A2) (wa (wral x3 ph A2) (wral y1 ps A2)) $;

--| Set substitution into the first argument of a subset relation. (Contributed by Rodolfo Medina, 7-Jul-2010.) (Proof shortened by Mario Carneiro, 14-Nov-2016.)
theorem sbss {x3 y1: setvar} (A2: class y1):
  $ wb (wsb x3 (wss (cv x3) A2) y1) (wss (cv y1) A2) $;

--| Distribute proper substitution through a subclass relation. (Contributed by Alan Sare, 22-Jul-2012.) (Proof shortened by Alexander van der Vekens, 23-Jul-2017.)
theorem sbcssg {x3: setvar} (A2 B2 C V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wss B2 C) A2) (wss (csb x3 A2 B2) (csb x3 A2 C))) $;

--| Rearrange restricted quantifiers with two different restricting classes, analogous to ~ raaan . It is necessary that either both restricting classes are empty or both are not empty. (Contributed by Alexander van der Vekens, 29-Jun-2017.)
theorem raaan2 {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class y1) (B2: class):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wb (wceq A2 c0) (wceq B2 c0)) (wb (wral x3 (wral y1 (wa ph ps) B2) A2) (wa (wral x3 ph A2) (wral y1 ps B2))) $;

--| Lemma for ~ 2reu4 . (Contributed by Alexander van der Vekens, 1-Jul-2017.)
theorem _2reu4lem {x3 y1 z w: setvar} (ph: wff x3 y1) (A2 B2: class):
  $ wi (wa (wne A2 c0) (wne B2 c0)) (wb (wa (wreu x3 (wrex y1 ph B2) A2) (wreu y1 (wrex x3 ph A2) B2)) (wa (wrex x3 (wrex y1 ph B2) A2) (wrex z (wrex w (wral x3 (wral y1 (wi ph (wa (wceq (cv x3) (cv z)) (wceq (cv y1) (cv w)))) B2) A2) B2) A2))) $;

--| Definition of double restricted existential uniqueness ("exactly one ` x ` and exactly one ` y ` "), analogous to ~ 2eu4 . (Contributed by Alexander van der Vekens, 1-Jul-2017.)
theorem _2reu4 {x3 y1 z w: setvar} (ph: wff x3 y1) (A2 B2: class):
  $ wb (wa (wreu x3 (wrex y1 ph B2) A2) (wreu y1 (wrex x3 ph A2) B2)) (wa (wrex x3 (wrex y1 ph B2) A2) (wrex z (wrex w (wral x3 (wral y1 (wi ph (wa (wceq (cv x3) (cv z)) (wceq (cv y1) (cv w)))) B2) A2) B2) A2)) $;

--| Distribution of class substitution over difference of two classes. (Contributed by ML, 14-Jul-2020.)
theorem csbdif {x3: setvar} (A2 B2 C: class x3):
  $ wceq (csb x3 A2 (cdif B2 C)) (cdif (csb x3 A2 B2) (csb x3 A2 C)) $;

--| Extend class notation to include the conditional operator for classes.
term cif (ph: wff) (A2 B2: class): class;

--| Definition of the conditional operator for classes. The expression ` if ( ph , A , B ) ` is read "if ` ph ` then ` A ` else ` B ` ". See ~ iftrue and ~ iffalse for its values. In the mathematical literature, this operator is rarely defined formally but is implicit in informal definitions such as "let f(x)=0 if x=0 and 1/x otherwise". An important use for us is in conjunction with the weak deduction theorem, which is described in the next section, beginning at ~ dedth . (Contributed by NM, 15-May-1999.)
axiom df_if {x3: setvar} (ph: wff) (A2 B2: class):
  $ wceq (cif ph A2 B2) (cab x3 (wo (wa (wcel (cv x3) A2) ph) (wa (wcel (cv x3) B2) (wn ph)))) $;

--| An alternate definition of the conditional operator ~ df-if with one fewer connectives (but probably less intuitive to understand). (Contributed by NM, 30-Jan-2006.)
theorem dfif2 {x3: setvar} (ph: wff) (A2 B2: class):
  $ wceq (cif ph A2 B2) (cab x3 (wi (wi (wcel (cv x3) B2) ph) (wa (wcel (cv x3) A2) ph))) $;

--| An alternate definition of the conditional operator ~ df-if as a simple class abstraction. (Contributed by Mario Carneiro, 8-Sep-2013.)
theorem dfif6 {x3: setvar} (ph: wff) (A2 B2: class):
  $ wceq (cif ph A2 B2) (cun (crab x3 ph A2) (crab x3 (wn ph) B2)) $;

--| Equality theorem for conditional operator. (Contributed by NM, 1-Sep-2004.) (Revised by Mario Carneiro, 8-Sep-2013.)
theorem ifeq1 (ph: wff) (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cif ph A2 C) (cif ph B2 C)) $;

--| Equality theorem for conditional operator. (Contributed by NM, 1-Sep-2004.) (Revised by Mario Carneiro, 8-Sep-2013.)
theorem ifeq2 (ph: wff) (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cif ph C A2) (cif ph C B2)) $;

--| Value of the conditional operator when its first argument is true. (Contributed by NM, 15-May-1999.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem iftrue (ph: wff) (A2 B2: class):
  $ wi ph (wceq (cif ph A2 B2) A2) $;

--| Inference associated with ~ iftrue . (Contributed by BJ, 7-Oct-2018.)
theorem iftruei (ph: wff) (A2 B2: class):
  $ ph $ >
  $ wceq (cif ph A2 B2) A2 $;

--| Value of the conditional operator when its first argument is true. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem iftrued (ph ch: wff) (A2 B2: class):
  $ wi ph ch $ >
  $ wi ph (wceq (cif ch A2 B2) A2) $;

--| Value of the conditional operator when its first argument is false. (Contributed by NM, 14-Aug-1999.)
theorem iffalse (ph: wff) (A2 B2: class):
  $ wi (wn ph) (wceq (cif ph A2 B2) B2) $;

--| Inference associated with ~ iffalse . (Contributed by BJ, 7-Oct-2018.)
theorem iffalsei (ph: wff) (A2 B2: class):
  $ wn ph $ >
  $ wceq (cif ph A2 B2) B2 $;

--| Value of the conditional operator when its first argument is false. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem iffalsed (ph ch: wff) (A2 B2: class):
  $ wi ph (wn ch) $ >
  $ wi ph (wceq (cif ch A2 B2) B2) $;

--| When values are unequal, but an "if" condition checks if they are equal, then the "false" branch results. This is a simple utility to provide a slight shortening and simplification of proofs versus applying ~ iffalse directly in this case. It happens, e.g., in ~ oevn0 . (Contributed by David A. Wheeler, 15-May-2015.)
theorem ifnefalse (A2 B2 C D: class):
  $ wi (wne A2 B2) (wceq (cif (wceq A2 B2) C D) D) $;

--| When the branches are not equal, an "if" condition results in the first branch if and only if its condition is true. (Contributed by SN, 16-Oct-2025.)
theorem iftrueb (ph: wff) (A2 B2: class):
  $ wi (wne A2 B2) (wb (wceq (cif ph A2 B2) A2) ph) $;

--| Distribute a function over an if-clause. (Contributed by Mario Carneiro, 14-Aug-2013.)
theorem ifsb (ph: wff) (A2 B2 C D E: class):
  $ wi (wceq (cif ph A2 B2) A2) (wceq C D) $ >
  $ wi (wceq (cif ph A2 B2) B2) (wceq C E) $ >
  $ wceq C (cif ph D E) $;

--| Alternate definition of the conditional operator ~ df-if . Note that ` ph ` is independent of ` x ` i.e. a constant true or false. (Contributed by NM, 25-Aug-2013.) (Revised by Mario Carneiro, 8-Sep-2013.)
theorem dfif3 {x3: setvar} (ph: wff) (A2 B2 C: class x3):
  $ wceq C (cab x3 ph) $ >
  $ wceq (cif ph A2 B2) (cun (cin A2 C) (cin B2 (cdif cvv C))) $;

--| Alternate definition of the conditional operator ~ df-if . Note that ` ph ` is independent of ` x ` i.e. a constant true or false. (Contributed by NM, 25-Aug-2013.)
theorem dfif4 {x3: setvar} (ph: wff) (A2 B2 C: class x3):
  $ wceq C (cab x3 ph) $ >
  $ wceq (cif ph A2 B2) (cin (cun A2 B2) (cin (cun A2 (cdif cvv C)) (cun B2 C))) $;

--| Alternate definition of the conditional operator ~ df-if . Note that ` ph ` is independent of ` x ` i.e. a constant true or false (see also ~ ab0orv ). (Contributed by G&eacute;rard Lang, 18-Aug-2013.)
theorem dfif5 {x3: setvar} (ph: wff) (A2 B2 C: class x3):
  $ wceq C (cab x3 ph) $ >
  $ wceq (cif ph A2 B2) (cun (cin A2 B2) (cun (cin (cdif A2 B2) C) (cin (cdif B2 A2) (cdif cvv C)))) $;

--| A conditional class is included in the union of its two alternatives. (Contributed by BJ, 15-Aug-2024.)
theorem ifssun (ph: wff) (A2 B2: class):
  $ wss (cif ph A2 B2) (cun A2 B2) $;

--| Equality theorem for conditional operators. (Contributed by NM, 1-Sep-2004.)
theorem ifeq12 (ph: wff) (A2 B2 C D: class):
  $ wi (wa (wceq A2 B2) (wceq C D)) (wceq (cif ph A2 C) (cif ph B2 D)) $;

--| Equality deduction for conditional operator. (Contributed by NM, 16-Feb-2005.)
theorem ifeq1d (ph ps: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cif ps A2 C) (cif ps B2 C)) $;

--| Equality deduction for conditional operator. (Contributed by NM, 16-Feb-2005.)
theorem ifeq2d (ph ps: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cif ps C A2) (cif ps C B2)) $;

--| Equality deduction for conditional operator. (Contributed by NM, 24-Mar-2015.)
theorem ifeq12d (ph ps: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq (cif ps A2 C) (cif ps B2 D)) $;

--| Equivalence theorem for conditional operators. (Contributed by Raph Levien, 15-Jan-2004.)
theorem ifbi (ph ps: wff) (A2 B2: class):
  $ wi (wb ph ps) (wceq (cif ph A2 B2) (cif ps A2 B2)) $;

--| Equivalence deduction for conditional operators. (Contributed by NM, 18-Apr-2005.)
theorem ifbid (ph ps ch: wff) (A2 B2: class):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wceq (cif ps A2 B2) (cif ch A2 B2)) $;

--| Equivalence/equality deduction for conditional operators. (Contributed by JJ, 25-Sep-2018.)
theorem ifbieq1d (ph ps ch: wff) (A2 B2 C: class):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cif ps A2 C) (cif ch B2 C)) $;

--| Equivalence/equality inference for conditional operators. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem ifbieq2i (ph ps: wff) (A2 B2 C: class):
  $ wb ph ps $ >
  $ wceq A2 B2 $ >
  $ wceq (cif ph C A2) (cif ps C B2) $;

--| Equivalence/equality deduction for conditional operators. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem ifbieq2d (ph ps ch: wff) (A2 B2 C: class):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cif ps C A2) (cif ch C B2)) $;

--| Equivalence deduction for conditional operators. (Contributed by NM, 18-Mar-2013.)
theorem ifbieq12i (ph ps: wff) (A2 B2 C D: class):
  $ wb ph ps $ >
  $ wceq A2 C $ >
  $ wceq B2 D $ >
  $ wceq (cif ph A2 B2) (cif ps C D) $;

--| Equivalence deduction for conditional operators. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem ifbieq12d (ph ps ch: wff) (A2 B2 C D: class):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wceq A2 C) $ >
  $ wi ph (wceq B2 D) $ >
  $ wi ph (wceq (cif ps A2 B2) (cif ch C D)) $;

--| Deduction form of ~ nfif . (Contributed by NM, 15-Feb-2013.) (Revised by Mario Carneiro, 13-Oct-2016.)
theorem nfifd {x3: setvar} (ph ps: wff x3) (A2 B2: class x3):
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 B2) $ >
  $ wi ph (wnfc x3 (cif ps A2 B2)) $;

--| Bound-variable hypothesis builder for a conditional operator. (Contributed by NM, 16-Feb-2005.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem nfif {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wnf x3 ph $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 (cif ph A2 B2) $;

--| Conditional equality. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem ifeq1da (ph ps: wff) (A2 B2 C: class):
  $ wi (wa ph ps) (wceq A2 B2) $ >
  $ wi ph (wceq (cif ps A2 C) (cif ps B2 C)) $;

--| Conditional equality. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem ifeq2da (ph ps: wff) (A2 B2 C: class):
  $ wi (wa ph (wn ps)) (wceq A2 B2) $ >
  $ wi ph (wceq (cif ps C A2) (cif ps C B2)) $;

--| Equivalence deduction for conditional operators. (Contributed by Wolf Lammen, 24-Jun-2021.)
theorem ifeq12da (ph ps: wff) (A2 B2 C D: class):
  $ wi (wa ph ps) (wceq A2 C) $ >
  $ wi (wa ph (wn ps)) (wceq B2 D) $ >
  $ wi ph (wceq (cif ps A2 B2) (cif ps C D)) $;

--| Equivalence deduction for conditional operators. (Contributed by Thierry Arnoux, 14-Feb-2017.) (Proof shortened by Wolf Lammen, 24-Jun-2021.)
theorem ifbieq12d2 (ph ps ch: wff) (A2 B2 C D: class):
  $ wi ph (wb ps ch) $ >
  $ wi (wa ph ps) (wceq A2 C) $ >
  $ wi (wa ph (wn ps)) (wceq B2 D) $ >
  $ wi ph (wceq (cif ps A2 B2) (cif ch C D)) $;

--| Conditional closure. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem ifclda (ph ps: wff) (A2 B2 C: class):
  $ wi (wa ph ps) (wcel A2 C) $ >
  $ wi (wa ph (wn ps)) (wcel B2 C) $ >
  $ wi ph (wcel (cif ps A2 B2) C) $;

--| Separation of the values of the conditional operator. (Contributed by Alexander van der Vekens, 13-Apr-2018.)
theorem ifeqda (ph ps: wff) (A2 B2 C: class):
  $ wi (wa ph ps) (wceq A2 C) $ >
  $ wi (wa ph (wn ps)) (wceq B2 C) $ >
  $ wi ph (wceq (cif ps A2 B2) C) $;

--| Elimination of a conditional operator contained in a wff ` ps ` . (Contributed by NM, 15-Feb-2005.) (Proof shortened by NM, 25-Apr-2019.)
theorem elimif (ph ps ch th: wff) (A2 B2: class):
  $ wi (wceq (cif ph A2 B2) A2) (wb ps ch) $ >
  $ wi (wceq (cif ph A2 B2) B2) (wb ps th) $ >
  $ wb ps (wo (wa ph ch) (wa (wn ph) th)) $;

--| A wff ` th ` containing a conditional operator is true when both of its cases are true. (Contributed by NM, 15-Feb-2015.)
theorem ifbothda (ph ps ch th et: wff) (A2 B2: class):
  $ wi (wceq A2 (cif ph A2 B2)) (wb ps th) $ >
  $ wi (wceq B2 (cif ph A2 B2)) (wb ch th) $ >
  $ wi (wa et ph) ps $ >
  $ wi (wa et (wn ph)) ch $ >
  $ wi et th $;

--| A wff ` th ` containing a conditional operator is true when both of its cases are true. (Contributed by NM, 3-Sep-2006.) (Revised by Mario Carneiro, 15-Feb-2015.)
theorem ifboth (ph ps ch th: wff) (A2 B2: class):
  $ wi (wceq A2 (cif ph A2 B2)) (wb ps th) $ >
  $ wi (wceq B2 (cif ph A2 B2)) (wb ch th) $ >
  $ wi (wa ps ch) th $;

--| Identical true and false arguments in the conditional operator. (Contributed by NM, 18-Apr-2005.)
theorem ifid (ph: wff) (A2: class):
  $ wceq (cif ph A2 A2) A2 $;

--| Expansion of an equality with a conditional operator. (Contributed by NM, 14-Feb-2005.)
theorem eqif (ph: wff) (A2 B2 C: class):
  $ wb (wceq A2 (cif ph B2 C)) (wo (wa ph (wceq A2 B2)) (wa (wn ph) (wceq A2 C))) $;

--| Another expression of the value of the ` if ` predicate, analogous to ~ eqif . See also the more specialized ~ iftrue and ~ iffalse . (Contributed by BJ, 6-Apr-2019.)
theorem ifval (ph: wff) (A2 B2 C: class):
  $ wb (wceq A2 (cif ph B2 C)) (wa (wi ph (wceq A2 B2)) (wi (wn ph) (wceq A2 C))) $;

--| Membership in a conditional operator. (Contributed by NM, 14-Feb-2005.)
theorem elif (ph: wff) (A2 B2 C: class):
  $ wb (wcel A2 (cif ph B2 C)) (wo (wa ph (wcel A2 B2)) (wa (wn ph) (wcel A2 C))) $;

--| Membership of a conditional operator. (Contributed by NM, 10-Sep-2005.)
theorem ifel (ph: wff) (A2 B2 C: class):
  $ wb (wcel (cif ph A2 B2) C) (wo (wa ph (wcel A2 C)) (wa (wn ph) (wcel B2 C))) $;

--| Membership (closure) of a conditional operator. (Contributed by NM, 4-Apr-2005.)
theorem ifcl (ph: wff) (A2 B2 C: class):
  $ wi (wa (wcel A2 C) (wcel B2 C)) (wcel (cif ph A2 B2) C) $;

--| Membership (closure) of a conditional operator, deduction form. (Contributed by SO, 16-Jul-2018.)
theorem ifcld (ph ps: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 C) $ >
  $ wi ph (wcel B2 C) $ >
  $ wi ph (wcel (cif ps A2 B2) C) $;

--| Inference associated with ~ ifcl . Membership (closure) of a conditional operator. Also usable to keep a membership hypothesis for the weak deduction theorem ~ dedth when the special case ` B e. C ` is provable. (Contributed by NM, 14-Aug-1999.) (Proof shortened by BJ, 1-Sep-2022.)
theorem ifcli (ph: wff) (A2 B2 C: class):
  $ wcel A2 C $ >
  $ wcel B2 C $ >
  $ wcel (cif ph A2 B2) C $;

--| Existence of the conditional operator (deduction form). (Contributed by SN, 26-Jul-2024.)
theorem ifexd (ph ps: wff) (A2 B2 V W: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel (cif ps A2 B2) cvv) $;

--| Existence of the conditional operator (closed form). (Contributed by NM, 21-Mar-2011.) (Proof shortened by BJ, 1-Sep-2022.)
theorem ifexg (ph: wff) (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wcel (cif ph A2 B2) cvv) $;

--| Existence of the conditional operator (inference form). (Contributed by NM, 2-Sep-2004.)
theorem ifex (ph: wff) (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel (cif ph A2 B2) cvv $;

--| The possible values of a conditional operator. (Contributed by NM, 17-Jun-2007.) (Proof shortened by Andrew Salmon, 26-Jun-2011.)
theorem ifeqor (ph: wff) (A2 B2: class):
  $ wo (wceq (cif ph A2 B2) A2) (wceq (cif ph A2 B2) B2) $;

--| Negating the first argument swaps the last two arguments of a conditional operator. (Contributed by NM, 21-Jun-2007.)
theorem ifnot (ph: wff) (A2 B2: class):
  $ wceq (cif (wn ph) A2 B2) (cif ph B2 A2) $;

--| Rewrite a conjunction in a conditional as two nested conditionals. (Contributed by Mario Carneiro, 28-Jul-2014.)
theorem ifan (ph ps: wff) (A2 B2: class):
  $ wceq (cif (wa ph ps) A2 B2) (cif ph (cif ps A2 B2) B2) $;

--| Rewrite a disjunction in a conditional as two nested conditionals. (Contributed by Mario Carneiro, 28-Jul-2014.)
theorem ifor (ph ps: wff) (A2 B2: class):
  $ wceq (cif (wo ph ps) A2 B2) (cif ph A2 (cif ps A2 B2)) $;

--| Resolve two nested conditionals. (Contributed by Alexander van der Vekens, 27-Mar-2018.)
theorem _2if2 (ph ps th: wff) (A2 B2 C D: class):
  $ wi (wa ph ps) (wceq D A2) $ >
  $ wi (w3a ph (wn ps) th) (wceq D B2) $ >
  $ wi (w3a ph (wn ps) (wn th)) (wceq D C) $ >
  $ wi ph (wceq D (cif ps A2 (cif th B2 C))) $;

--| Commute the conditions in two nested conditionals if both conditions are not simultaneously true. (Contributed by SO, 15-Jul-2018.)
theorem ifcomnan (ph ps: wff) (A2 B2 C: class):
  $ wi (wn (wa ph ps)) (wceq (cif ph A2 (cif ps B2 C)) (cif ps B2 (cif ph A2 C))) $;

--| Distribute proper substitution through the conditional operator. (Contributed by NM, 24-Feb-2013.) (Revised by NM, 19-Aug-2018.)
theorem csbif {x3: setvar} (ph: wff x3) (A2 B2 C: class x3):
  $ wceq (csb x3 A2 (cif ph B2 C)) (cif (wsbc x3 ph A2) (csb x3 A2 B2) (csb x3 A2 C)) $;

--| Weak deduction theorem that eliminates a hypothesis ` ph ` , making it become an antecedent. We assume that a proof exists for ` ph ` when the class variable ` A ` is replaced with a specific class ` B ` . The hypothesis ` ch ` should be assigned to the inference, and the inference hypothesis eliminated with ~ elimhyp . If the inference has other hypotheses with class variable ` A ` , these can be kept by assigning ~ keephyp to them. For more information, see the Weak Deduction Theorem page ~ mmdeduction.html . (Contributed by NM, 15-May-1999.)
theorem dedth (ph ps ch: wff) (A2 B2: class):
  $ wi (wceq A2 (cif ph A2 B2)) (wb ps ch) $ >
  $ ch $ >
  $ wi ph ps $;

--| Weak deduction theorem eliminating two hypotheses. This theorem is simpler to use than ~ dedth2v but requires that each hypothesis have exactly one class variable. See also comments in ~ dedth . (Contributed by NM, 15-May-1999.)
theorem dedth2h (ph ps ch th ta: wff) (A2 B2 C D: class):
  $ wi (wceq A2 (cif ph A2 C)) (wb ch th) $ >
  $ wi (wceq B2 (cif ps B2 D)) (wb th ta) $ >
  $ ta $ >
  $ wi (wa ph ps) ch $;

--| Weak deduction theorem eliminating three hypotheses. See comments in ~ dedth2h . (Contributed by NM, 15-May-1999.)
theorem dedth3h (ph ps ch th ta et ze: wff) (A2 B2 C D R S: class):
  $ wi (wceq A2 (cif ph A2 D)) (wb th ta) $ >
  $ wi (wceq B2 (cif ps B2 R)) (wb ta et) $ >
  $ wi (wceq C (cif ch C S)) (wb et ze) $ >
  $ ze $ >
  $ wi (w3a ph ps ch) th $;

--| Weak deduction theorem eliminating four hypotheses. See comments in ~ dedth2h . (Contributed by NM, 16-May-1999.)
theorem dedth4h (ph ps ch th ta et ze si rh: wff) (A2 B2 C D R S F G: class):
  $ wi (wceq A2 (cif ph A2 R)) (wb ta et) $ >
  $ wi (wceq B2 (cif ps B2 S)) (wb et ze) $ >
  $ wi (wceq C (cif ch C F)) (wb ze si) $ >
  $ wi (wceq D (cif th D G)) (wb si rh) $ >
  $ rh $ >
  $ wi (wa (wa ph ps) (wa ch th)) ta $;

--| Weak deduction theorem for eliminating a hypothesis with 2 class variables. Note: if the hypothesis can be separated into two hypotheses, each with one class variable, then ~ dedth2h is simpler to use. See also comments in ~ dedth . (Contributed by NM, 13-Aug-1999.) (Proof shortened by Eric Schmidt, 28-Jul-2009.)
theorem dedth2v (ph ps ch th: wff) (A2 B2 C D: class):
  $ wi (wceq A2 (cif ph A2 C)) (wb ps ch) $ >
  $ wi (wceq B2 (cif ph B2 D)) (wb ch th) $ >
  $ th $ >
  $ wi ph ps $;

--| Weak deduction theorem for eliminating a hypothesis with 3 class variables. See comments in ~ dedth2v . (Contributed by NM, 13-Aug-1999.) (Proof shortened by Eric Schmidt, 28-Jul-2009.)
theorem dedth3v (ph ps ch th ta: wff) (A2 B2 C D R S: class):
  $ wi (wceq A2 (cif ph A2 D)) (wb ps ch) $ >
  $ wi (wceq B2 (cif ph B2 R)) (wb ch th) $ >
  $ wi (wceq C (cif ph C S)) (wb th ta) $ >
  $ ta $ >
  $ wi ph ps $;

--| Weak deduction theorem for eliminating a hypothesis with 4 class variables. See comments in ~ dedth2v . (Contributed by NM, 21-Apr-2007.) (Proof shortened by Eric Schmidt, 28-Jul-2009.)
theorem dedth4v (ph ps ch th ta et: wff) (A2 B2 C D R S T U: class):
  $ wi (wceq A2 (cif ph A2 R)) (wb ps ch) $ >
  $ wi (wceq B2 (cif ph B2 S)) (wb ch th) $ >
  $ wi (wceq C (cif ph C T)) (wb th ta) $ >
  $ wi (wceq D (cif ph D U)) (wb ta et) $ >
  $ et $ >
  $ wi ph ps $;

--| Eliminate a hypothesis containing class variable ` A ` when it is known for a specific class ` B ` . For more information, see comments in ~ dedth . (Contributed by NM, 15-May-1999.)
theorem elimhyp (ph ps ch: wff) (A2 B2: class):
  $ wi (wceq A2 (cif ph A2 B2)) (wb ph ps) $ >
  $ wi (wceq B2 (cif ph A2 B2)) (wb ch ps) $ >
  $ ch $ >
  $ ps $;

--| Eliminate a hypothesis containing 2 class variables. (Contributed by NM, 14-Aug-1999.)
theorem elimhyp2v (ph ch th ta et: wff) (A2 B2 C D: class):
  $ wi (wceq A2 (cif ph A2 C)) (wb ph ch) $ >
  $ wi (wceq B2 (cif ph B2 D)) (wb ch th) $ >
  $ wi (wceq C (cif ph A2 C)) (wb ta et) $ >
  $ wi (wceq D (cif ph B2 D)) (wb et th) $ >
  $ ta $ >
  $ th $;

--| Eliminate a hypothesis containing 3 class variables. (Contributed by NM, 14-Aug-1999.)
theorem elimhyp3v (ph ch th ta et ze si: wff) (A2 B2 C D R S: class):
  $ wi (wceq A2 (cif ph A2 D)) (wb ph ch) $ >
  $ wi (wceq B2 (cif ph B2 R)) (wb ch th) $ >
  $ wi (wceq C (cif ph C S)) (wb th ta) $ >
  $ wi (wceq D (cif ph A2 D)) (wb et ze) $ >
  $ wi (wceq R (cif ph B2 R)) (wb ze si) $ >
  $ wi (wceq S (cif ph C S)) (wb si ta) $ >
  $ et $ >
  $ ta $;

--| Eliminate a hypothesis containing 4 class variables (for use with the weak deduction theorem ~ dedth ). (Contributed by NM, 16-Apr-2005.)
theorem elimhyp4v (ph ps ch th ta et ze si rh: wff) (A2 B2 C D R S F G: class):
  $ wi (wceq A2 (cif ph A2 D)) (wb ph ch) $ >
  $ wi (wceq B2 (cif ph B2 R)) (wb ch th) $ >
  $ wi (wceq C (cif ph C S)) (wb th ta) $ >
  $ wi (wceq F (cif ph F G)) (wb ta ps) $ >
  $ wi (wceq D (cif ph A2 D)) (wb et ze) $ >
  $ wi (wceq R (cif ph B2 R)) (wb ze si) $ >
  $ wi (wceq S (cif ph C S)) (wb si rh) $ >
  $ wi (wceq G (cif ph F G)) (wb rh ps) $ >
  $ et $ >
  $ ps $;

--| Eliminate a membership hypothesis for weak deduction theorem, when special case ` B e. C ` is provable. (Contributed by NM, 15-May-1999.)
theorem elimel (A2 B2 C: class):
  $ wcel B2 C $ >
  $ wcel (cif (wcel A2 C) A2 B2) C $;

--| Version of ~ elimhyp where the hypothesis is deduced from the final antecedent. See ~ divalg for an example of its use. (Contributed by Paul Chapman, 25-Mar-2008.)
theorem elimdhyp (ph ps ch th: wff) (A2 B2: class):
  $ wi ph ps $ >
  $ wi (wceq A2 (cif ph A2 B2)) (wb ps ch) $ >
  $ wi (wceq B2 (cif ph A2 B2)) (wb th ch) $ >
  $ th $ >
  $ ch $;

--| Transform a hypothesis ` ps ` that we want to keep (but contains the same class variable ` A ` used in the eliminated hypothesis) for use with the weak deduction theorem. (Contributed by NM, 15-May-1999.)
theorem keephyp (ph ps ch th: wff) (A2 B2: class):
  $ wi (wceq A2 (cif ph A2 B2)) (wb ps th) $ >
  $ wi (wceq B2 (cif ph A2 B2)) (wb ch th) $ >
  $ ps $ >
  $ ch $ >
  $ th $;

--| Keep a hypothesis containing 2 class variables (for use with the weak deduction theorem ~ dedth ). (Contributed by NM, 16-Apr-2005.)
theorem keephyp2v (ph ps ch th ta et: wff) (A2 B2 C D: class):
  $ wi (wceq A2 (cif ph A2 C)) (wb ps ch) $ >
  $ wi (wceq B2 (cif ph B2 D)) (wb ch th) $ >
  $ wi (wceq C (cif ph A2 C)) (wb ta et) $ >
  $ wi (wceq D (cif ph B2 D)) (wb et th) $ >
  $ ps $ >
  $ ta $ >
  $ th $;

--| Keep a hypothesis containing 3 class variables. (Contributed by NM, 27-Sep-1999.)
theorem keephyp3v (ph ch th ta et ze si rh: wff) (A2 B2 C D R S: class):
  $ wi (wceq A2 (cif ph A2 D)) (wb rh ch) $ >
  $ wi (wceq B2 (cif ph B2 R)) (wb ch th) $ >
  $ wi (wceq C (cif ph C S)) (wb th ta) $ >
  $ wi (wceq D (cif ph A2 D)) (wb et ze) $ >
  $ wi (wceq R (cif ph B2 R)) (wb ze si) $ >
  $ wi (wceq S (cif ph C S)) (wb si ta) $ >
  $ rh $ >
  $ et $ >
  $ ta $;

--| Extend class notation to include power class. (The tilde in the Metamath token is meant to suggest the calligraphic font of the P.)
term cpw (A2: class): class;

--| Soundness justification theorem for ~ df-pw . (Contributed by Rodolfo Medina, 28-Apr-2010.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem pwjust {x3 y1: setvar} (A2: class):
  $ wceq (cab x3 (wss (cv x3) A2)) (cab y1 (wss (cv y1) A2)) $;

--| Define power class. Definition 5.10 of [TakeutiZaring] p. 17, but we also let it apply to proper classes, i.e. those that are not members of ` _V ` . When applied to a set, this produces its power set. A power set of S is the set of all subsets of S, including the empty set and S itself. For example, if ` A = { 3 , 5 , 7 } ` , then ` ~P A = { (/) , { 3 } , { 5 } , { 7 } , { 3 , 5 } , ` ` { 3 , 7 } , { 5 , 7 } , { 3 , 5 , 7 } } ` ( ~ ex-pw ). We will later introduce the Axiom of Power Sets ~ ax-pow , which can be expressed in class notation per ~ pwexg . Still later we will prove, in ~ hashpw , that the size of the power set of a finite set is 2 raised to the power of the size of the set. (Contributed by NM, 24-Jun-1993.)
axiom df_pw {x3: setvar} (A2: class):
  $ wceq (cpw A2) (cab x3 (wss (cv x3) A2)) $;

--| Membership in a power class. Theorem 86 of [Suppes] p. 47. See also ~ elpw2g . (Contributed by NM, 6-Aug-2000.) (Proof shortened by BJ, 31-Dec-2023.)
theorem elpwg (A2 B2 V: class):
  $ wi (wcel A2 V) (wb (wcel A2 (cpw B2)) (wss A2 B2)) $;

--| Membership in a power class. Theorem 86 of [Suppes] p. 47. (Contributed by NM, 31-Dec-1993.) (Proof shortened by BJ, 31-Dec-2023.)
theorem elpw (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 (cpw B2)) (wss A2 B2) $;

--| Setvar variable membership in a power class. (Contributed by David A. Wheeler, 8-Dec-2018.)
theorem velpw {x3: setvar} (A2: class x3):
  $ wb (wcel (cv x3) (cpw A2)) (wss (cv x3) A2) $;

--| Membership in a power class. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem elpwd (ph: wff) (A2 B2 V: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wcel A2 (cpw B2)) $;

--| Subset relation implied by membership in a power class. (Contributed by NM, 17-Feb-2007.)
theorem elpwi (A2 B2: class):
  $ wi (wcel A2 (cpw B2)) (wss A2 B2) $;

--| Characterization of the elements of a power class. (Contributed by BJ, 29-Apr-2021.)
theorem elpwb (A2 B2: class):
  $ wb (wcel A2 (cpw B2)) (wa (wcel A2 cvv) (wss A2 B2)) $;

--| An element of a power class is a subclass. Deduction form of ~ elpwi . (Contributed by David Moews, 1-May-2017.)
theorem elpwid (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 (cpw B2)) $ >
  $ wi ph (wss A2 B2) $;

--| If ` A ` belongs to a part of ` C ` , then ` A ` belongs to ` C ` . (Contributed by FL, 3-Aug-2009.)
theorem elelpwi (A2 B2 C: class):
  $ wi (wa (wcel A2 B2) (wcel B2 (cpw C))) (wcel A2 C) $;

--| The powerclass preserves inclusion. See ~ sspwb for the biconditional version. (Contributed by NM, 13-Oct-1996.) Extract forward implication of ~ sspwb since it requires fewer axioms. (Revised by BJ, 13-Apr-2024.)
theorem sspw (A2 B2: class):
  $ wi (wss A2 B2) (wss (cpw A2) (cpw B2)) $;

--| The powerclass preserves inclusion (inference form). (Contributed by BJ, 13-Apr-2024.)
theorem sspwi (A2 B2: class):
  $ wss A2 B2 $ >
  $ wss (cpw A2) (cpw B2) $;

--| The powerclass preserves inclusion (deduction form). (Contributed by BJ, 13-Apr-2024.)
theorem sspwd (ph: wff) (A2 B2: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wss (cpw A2) (cpw B2)) $;

--| Equality theorem for power class. (Contributed by NM, 21-Jun-1993.) (Proof shortened by BJ, 13-Apr-2024.)
theorem pweq (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (cpw A2) (cpw B2)) $;

--| Alternate proof of ~ pweq directly from the definition. (Contributed by NM, 21-Jun-1993.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem pweqALT (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (cpw A2) (cpw B2)) $;

--| Equality inference for power class. (Contributed by NM, 27-Nov-2013.)
theorem pweqi (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wceq (cpw A2) (cpw B2) $;

--| Equality deduction for power class. (Contributed by NM, 27-Nov-2013.)
theorem pweqd (ph: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cpw A2) (cpw B2)) $;

--| The power class of the universe is the universe. Exercise 4.12(d) of [Mendelson] p. 235. The collection of all classes is of course larger than ` _V ` , which is the collection of all sets. But ` ~P _V ` , being a class, cannot contain proper classes, so ` ~P _V ` is actually no larger than ` _V ` . This fact is exploited in ~ ncanth . (Contributed by NM, 14-Sep-2003.)
theorem pwv:
  $ wceq (cpw cvv) cvv $;

--| The power class of the union of two classes includes the union of their power classes. Exercise 4.12(k) of [Mendelson] p. 235. (Contributed by NM, 23-Nov-2003.) Remove use of ~ ax-sep , ~ ax-nul , ~ ax-pr and shorten proof. (Revised by BJ, 13-Apr-2024.)
theorem pwunss (A2 B2: class):
  $ wss (cun (cpw A2) (cpw B2)) (cpw (cun A2 B2)) $;

--| Bound-variable hypothesis builder for power class. (Contributed by NM, 28-Oct-2003.) (Revised by Mario Carneiro, 13-Oct-2016.)
theorem nfpw {x3: setvar} (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 (cpw A2) $;

--| A set is an element of its power set. (Contributed by Stefan O'Rear, 1-Feb-2015.) (Proof shortened by Umit Teoman Dogan, 10-Jun-2026.)
theorem pwidg (A2 V: class):
  $ wi (wcel A2 V) (wcel A2 (cpw A2)) $;

--| Obsolete version of ~ pwidg as of 10-Jun-2026. (Contributed by Stefan O'Rear, 1-Feb-2015.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem pwidgOLD (A2 V: class):
  $ wi (wcel A2 V) (wcel A2 (cpw A2)) $;

--| A class is an element of its powerclass if and only if it is a set. (Contributed by BJ, 31-Dec-2023.)
theorem pwidb (A2: class):
  $ wb (wcel A2 cvv) (wcel A2 (cpw A2)) $;

--| A set is a member of its power class. Theorem 87 of [Suppes] p. 47. (Contributed by NM, 5-Aug-1993.)
theorem pwid (A2: class):
  $ wcel A2 cvv $ >
  $ wcel A2 (cpw A2) $;

--| Subclass relationship for power class. (Contributed by NM, 21-Jun-2009.)
theorem pwss {x3: setvar} (A2 B2: class):
  $ wb (wss (cpw A2) B2) (wal x3 (wi (wss (cv x3) A2) (wcel (cv x3) B2))) $;

--| Break up the power class of a union into a union of smaller classes. (Contributed by NM, 25-Mar-2007.) (Proof shortened by Thierry Arnoux, 20-Dec-2016.) Remove use of ~ ax-sep , ~ ax-nul , ~ ax-pr and shorten proof. (Revised by BJ, 14-Apr-2024.)
theorem pwundif (A2 B2: class):
  $ wceq (cpw (cun A2 B2)) (cun (cdif (cpw (cun A2 B2)) (cpw A2)) (cpw A2)) $;

--| Soundness justification theorem for ~ df-sn . (Contributed by Rodolfo Medina, 28-Apr-2010.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem snjust {x3 y1: setvar} (A2: class):
  $ wceq (cab x3 (wceq (cv x3) A2)) (cab y1 (wceq (cv y1) A2)) $;

--| Extend class notation to include singleton.
term csn (A2: class): class;

--| Define the singleton of a class. Definition 7.1 of [Quine] p. 48. For convenience, it is well-defined for proper classes, i.e., those that are not elements of ` _V ` , see ~ snprc . For an alternate definition see ~ dfsn2 . (Contributed by NM, 21-Jun-1993.)
axiom df_sn {x3: setvar} (A2: class):
  $ wceq (csn A2) (cab x3 (wceq (cv x3) A2)) $;

--| Extend class notation to include unordered pair.
term cpr (A2 B2: class): class;

--| Define unordered pair of classes. Definition 7.1 of [Quine] p. 48. For example, ` A e. { 1 , -u 1 } -> ( A ^ 2 ) = 1 ` ( ~ ex-pr ). They are unordered, so ` { A , B } = { B , A } ` as proven by ~ prcom . For a more traditional definition, but requiring a dummy variable, see ~ dfpr2 . ` { A , A } ` is also an unordered pair, but also a singleton because of ` { A } = { A , A } ` (see ~ dfsn2 ). Therefore, ` { A , B } ` is called a _proper_ (unordered) pair iff ` A =/= B ` and ` A ` and ` B ` are sets. Note: ordered pairs are a completely different object defined below in ~ df-op . When the term "pair" is used without qualifier, it generally means "unordered pair", and the context makes it clear which version is meant. (Contributed by NM, 21-Jun-1993.)
axiom df_pr (A2 B2: class):
  $ wceq (cpr A2 B2) (cun (csn A2) (csn B2)) $;

--| Extend class notation to include unordered triple (sometimes called "unordered triplet").
term ctp (A2 B2 C: class): class;

--| Define unordered triple of classes. Definition of [Enderton] p. 19. Note: ordered triples are a completely different object defined below in ~ df-ot . As with all tuples, when the term "triple" is used without qualifier, it means "ordered triple". (Contributed by NM, 9-Apr-1994.)
axiom df_tp (A2 B2 C: class):
  $ wceq (ctp A2 B2 C) (cun (cpr A2 B2) (csn C)) $;

--| Equality theorem for singletons. Part of Exercise 4 of [TakeutiZaring] p. 15. (Contributed by NM, 21-Jun-1993.)
theorem sneq (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (csn A2) (csn B2)) $;

--| Equality inference for singletons. (Contributed by NM, 22-Jan-2004.)
theorem sneqi (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wceq (csn A2) (csn B2) $;

--| Equality deduction for singletons. (Contributed by NM, 22-Jan-2004.)
theorem sneqd (ph: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (csn A2) (csn B2)) $;

--| Alternate definition of singleton. Definition 5.1 of [TakeutiZaring] p. 15. (Contributed by NM, 24-Apr-1994.)
theorem dfsn2 (A2: class):
  $ wceq (csn A2) (cpr A2 A2) $;

--| There is exactly one element in a singleton. Exercise 2 of [TakeutiZaring] p. 15 (generalized). (Contributed by NM, 13-Sep-1995.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem elsng (A2 B2 V: class):
  $ wi (wcel A2 V) (wb (wcel A2 (csn B2)) (wceq A2 B2)) $;

--| There is exactly one element in a singleton. Exercise 2 of [TakeutiZaring] p. 15. (Contributed by NM, 13-Sep-1995.)
theorem elsn (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 (csn B2)) (wceq A2 B2) $;

--| There is only one element in a singleton. Exercise 2 of [TakeutiZaring] p. 15. (Contributed by NM, 21-Jun-1993.)
theorem velsn {x3: setvar} (A2: class x3):
  $ wb (wcel (cv x3) (csn A2)) (wceq (cv x3) A2) $;

--| There is at most one element in a singleton. (Contributed by NM, 5-Jun-1994.)
theorem elsni (A2 B2: class):
  $ wi (wcel A2 (csn B2)) (wceq A2 B2) $;

--| There is at most one element in a singleton. (Contributed by Thierry Arnoux, 13-Oct-2025.)
theorem elsnd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 (csn B2)) $ >
  $ wi ph (wceq A2 B2) $;

--| Equality of class abstractions restricted to a singleton. (Contributed by AV, 17-May-2025.)
theorem rabsneq {x3: setvar} (ps: wff x3) (N V: class):
  $ wi (wcel N V) (wceq (crab x3 ps (csn N)) (crab x3 (wa (wceq (cv x3) N) ps) V)) $;

--| Condition for a class abstraction to be a singleton. Formerly part of proof of ~ dfiota2 . (Contributed by Andrew Salmon, 30-Jun-2011.) (Revised by AV, 24-Aug-2022.)
theorem absn {x3: setvar} (ph: wff x3) (Y: class):
  $ wb (wceq (cab x3 ph) (csn Y)) (wal x3 (wb ph (wceq (cv x3) Y))) $;

--| Alternate definition of a pair. Definition 5.1 of [TakeutiZaring] p. 15. (Contributed by NM, 24-Apr-1994.)
theorem dfpr2 {x3: setvar} (A2 B2: class):
  $ wceq (cpr A2 B2) (cab x3 (wo (wceq (cv x3) A2) (wceq (cv x3) B2))) $;

--| Alternate definition of singleton, based on the (alternate) definition of pair. Definition 5.1 of [TakeutiZaring] p. 15. (Contributed by AV, 12-Jun-2022.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem dfsn2ALT (A2: class):
  $ wceq (csn A2) (cpr A2 A2) $;

--| A member of a pair of classes is one or the other of them, and conversely as soon as it is a set. Exercise 1 of [TakeutiZaring] p. 15, generalized. (Contributed by NM, 13-Sep-1995.)
theorem elprg (A2 B2 C V: class):
  $ wi (wcel A2 V) (wb (wcel A2 (cpr B2 C)) (wo (wceq A2 B2) (wceq A2 C))) $;

--| If a class is an element of a pair, then it is one of the two paired elements. (Contributed by Scott Fenton, 1-Apr-2011.)
theorem elpri (A2 B2 C: class):
  $ wi (wcel A2 (cpr B2 C)) (wo (wceq A2 B2) (wceq A2 C)) $;

--| A member of a pair of classes is one or the other of them, and conversely as soon as it is a set. Exercise 1 of [TakeutiZaring] p. 15. (Contributed by NM, 13-Sep-1995.)
theorem elpr (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 (cpr B2 C)) (wo (wceq A2 B2) (wceq A2 C)) $;

--| A member of a pair of sets is one or the other of them, and conversely. Exercise 1 of [TakeutiZaring] p. 15. (Contributed by NM, 14-Oct-2005.) Generalize from sethood hypothesis to sethood antecedent. (Revised by BJ, 25-May-2024.)
theorem elpr2g (A2 B2 C V W: class):
  $ wi (wa (wcel B2 V) (wcel C W)) (wb (wcel A2 (cpr B2 C)) (wo (wceq A2 B2) (wceq A2 C))) $;

--| A member of a pair of sets is one or the other of them, and conversely. Exercise 1 of [TakeutiZaring] p. 15. (Contributed by NM, 14-Oct-2005.) (Proof shortened by JJ, 23-Jul-2021.)
theorem elpr2 (A2 B2 C: class):
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wb (wcel A2 (cpr B2 C)) (wo (wceq A2 B2) (wceq A2 C)) $;

--| A member of an unordered pair that is not the "first", must be the "second". (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem elprn1 (A2 B2 C: class):
  $ wi (wa (wcel A2 (cpr B2 C)) (wne A2 B2)) (wceq A2 C) $;

--| A member of an unordered pair that is not the "second", must be the "first". (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem elprn2 (A2 B2 C: class):
  $ wi (wa (wcel A2 (cpr B2 C)) (wne A2 C)) (wceq A2 B2) $;

--| If a class is not an element of an unordered pair, it is not the second listed element. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem nelpr2 (ph: wff) (A2 B2 C V: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wn (wcel A2 (cpr B2 C))) $ >
  $ wi ph (wne A2 C) $;

--| If a class is not an element of an unordered pair, it is not the first listed element. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem nelpr1 (ph: wff) (A2 B2 C V: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wn (wcel A2 (cpr B2 C))) $ >
  $ wi ph (wne A2 B2) $;

--| If an element doesn't match the items in an unordered pair, it is not in the unordered pair. (Contributed by David A. Wheeler, 10-May-2015.)
theorem nelpri (A2 B2 C: class):
  $ wne A2 B2 $ >
  $ wne A2 C $ >
  $ wn (wcel A2 (cpr B2 C)) $;

--| If an element doesn't match the items in an unordered pair, it is not in the unordered pair, using ` e/ ` . (Contributed by David A. Wheeler, 10-May-2015.)
theorem prneli (A2 B2 C: class):
  $ wne A2 B2 $ >
  $ wne A2 C $ >
  $ wnel A2 (cpr B2 C) $;

--| If an element doesn't match the items in an unordered pair, it is not in the unordered pair, deduction version. (Contributed by Alexander van der Vekens, 25-Jan-2018.)
theorem nelprd (ph: wff) (A2 B2 C: class):
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wne A2 C) $ >
  $ wi ph (wn (wcel A2 (cpr B2 C))) $;

--| Membership in a set with two elements removed. Similar to ~ eldifsn and ~ eldiftp . (Contributed by Mario Carneiro, 18-Jul-2017.)
theorem eldifpr (A2 B2 C D: class):
  $ wb (wcel A2 (cdif B2 (cpr C D))) (w3a (wcel A2 B2) (wne A2 C) (wne A2 D)) $;

--| Restricted existential quantification over a set with two elements removed. (Contributed by Alexander van der Vekens, 7-Feb-2018.) (Proof shortened by Wolf Lammen, 15-May-2025.)
theorem rexdifpr {x3: setvar} (ph: wff x3) (A2 B2 C: class x3):
  $ wb (wrex x3 ph (cdif A2 (cpr B2 C))) (wrex x3 (w3a (wne (cv x3) B2) (wne (cv x3) C) ph) A2) $;

--| A set is a member of its singleton. Part of Theorem 7.6 of [Quine] p. 49. (Contributed by NM, 28-Oct-2003.)
theorem snidg (A2 V: class):
  $ wi (wcel A2 V) (wcel A2 (csn A2)) $;

--| A class is a set iff it is a member of its singleton. (Contributed by NM, 5-Apr-2004.)
theorem snidb (A2: class):
  $ wb (wcel A2 cvv) (wcel A2 (csn A2)) $;

--| A set is a member of its singleton. Part of Theorem 7.6 of [Quine] p. 49. (Contributed by NM, 31-Dec-1993.)
theorem snid (A2: class):
  $ wcel A2 cvv $ >
  $ wcel A2 (csn A2) $;

--| A setvar variable is a member of its singleton. (Contributed by David A. Wheeler, 8-Dec-2018.)
theorem vsnid {x3: setvar}:
  $ wcel (cv x3) (csn (cv x3)) $;

--| There is exactly one element in a singleton. Exercise 2 of [TakeutiZaring] p. 15. This variation requires only that ` B ` , rather than ` A ` , be a set. (Contributed by NM, 28-Oct-2003.)
theorem elsn2g (A2 B2 V: class):
  $ wi (wcel B2 V) (wb (wcel A2 (csn B2)) (wceq A2 B2)) $;

--| There is exactly one element in a singleton. Exercise 2 of [TakeutiZaring] p. 15. This variation requires only that ` B ` , rather than ` A ` , be a set. (Contributed by NM, 12-Jun-1994.)
theorem elsn2 (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wb (wcel A2 (csn B2)) (wceq A2 B2) $;

--| If a class is not equal to the class in a singleton, then it is not in the singleton. (Contributed by Glauco Siliprandi, 17-Aug-2020.) (Proof shortened by BJ, 4-May-2021.)
theorem nelsn (A2 B2: class):
  $ wi (wne A2 B2) (wn (wcel A2 (csn B2))) $;

--| Conditions for a restricted class abstraction to be a singleton. (Contributed by AV, 18-Apr-2019.) (Proof shortened by AV, 26-Aug-2022.)
theorem rabeqsn {x3: setvar} (ph: wff x3) (V: class x3) (X: class):
  $ wb (wceq (crab x3 ph V) (csn X)) (wal x3 (wb (wa (wcel (cv x3) V) ph) (wceq (cv x3) X))) $;

--| Conditions for a restricted class abstraction to be a subset of a singleton, i.e. to be a singleton or the empty set. (Contributed by AV, 18-Apr-2019.)
theorem rabsssn {x3: setvar} (ph: wff x3) (V: class x3) (X: class):
  $ wb (wss (crab x3 ph V) (csn X)) (wral x3 (wi ph (wceq (cv x3) X)) V) $;

--| Conditions for a restricted class abstraction to be a singleton, in deduction form. (Contributed by Thierry Arnoux, 2-Dec-2021.)
theorem rabeqsnd {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3) (B2: class):
  $ wi (wceq (cv x3) B2) (wb ps ch) $ >
  $ wi ph (wcel B2 A2) $ >
  $ wi ph ch $ >
  $ wi (wa (wa ph (wcel (cv x3) A2)) ps) (wceq (cv x3) B2) $ >
  $ wi ph (wceq (crab x3 ps A2) (csn B2)) $;

--| Substitution expressed in terms of quantification over a singleton. (Contributed by NM, 14-Dec-2005.) (Revised by Mario Carneiro, 23-Apr-2015.)
theorem ralsnsg {x3: setvar} (ph: wff x3) (A2: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wral x3 ph (csn A2)) (wsbc x3 ph A2)) $;

--| Restricted existential quantification over a singleton. (Contributed by Mario Carneiro, 23-Apr-2015.) (Revised by NM, 22-Aug-2018.)
theorem rexsns {x3: setvar} (ph: wff x3) (A2: class):
  $ wb (wrex x3 ph (csn A2)) (wsbc x3 ph A2) $;

--| Restricted existential quantification over a singleton. (Contributed by NM, 29-Jan-2012.) (Revised by Glauco Siliprandi, 17-Aug-2020.)
theorem rexsngf {x3: setvar} (ph ps: wff x3) (A2: class) (V: class x3):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wb (wrex x3 ph (csn A2)) ps) $;

--| Restricted universal quantification over a singleton. (Contributed by NM, 14-Dec-2005.) (Revised by AV, 3-Apr-2023.)
theorem ralsngf {x3: setvar} (ph ps: wff x3) (A2: class) (V: class x3):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wb (wral x3 ph (csn A2)) ps) $;

--| Restricted existential uniqueness over a singleton. (Contributed by AV, 3-Apr-2023.)
theorem reusngf {x3: setvar} (ph ps: wff x3) (A2: class) (V: class x3):
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wb (wreu x3 ph (csn A2)) ps) $;

--| Substitution expressed in terms of quantification over a singleton. (Contributed by NM, 14-Dec-2005.) (Revised by Mario Carneiro, 23-Apr-2015.) Avoid ~ ax-10 , ~ ax-12 . (Revised by GG, 30-Sep-2024.)
theorem ralsng {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (V: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wb (wral x3 ph (csn A2)) ps) $;

--| Restricted existential quantification over a singleton. (Contributed by NM, 29-Jan-2012.) Avoid ~ ax-10 , ~ ax-12 . (Revised by GG, 30-Sep-2024.)
theorem rexsng {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (V: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wb (wrex x3 ph (csn A2)) ps) $;

--| Restricted existential uniqueness over a singleton. (Contributed by AV, 3-Apr-2023.)
theorem reusng {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (V: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wb (wreu x3 ph (csn A2)) ps) $;

--| Substitution expressed in terms of two quantifications over singletons. (Contributed by AV, 22-Dec-2019.)
theorem _2ralsng {x3 y1: setvar} (ph: wff x3 y1) (ps: wff y1) (ch: wff x3) (A2 B2: class) (V W: class x3 y1):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wral x3 (wral y1 ph (csn B2)) (csn A2)) ch) $;

--| Restricted existential uniqueness over a singleton is equivalent to a restricted existential quantification over a singleton. (Contributed by AV, 3-Apr-2023.)
theorem rexreusng {x3: setvar} (ph: wff x3) (A2: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wrex x3 ph (csn A2)) (wreu x3 ph (csn A2))) $;

--| There is a set being the element of a singleton if and only if there is an element of the singleton. (Contributed by Alexander van der Vekens, 1-Jan-2018.)
theorem exsnrex {x3: setvar} (M: class x3):
  $ wb (wex x3 (wceq M (csn (cv x3)))) (wrex x3 (wceq M (csn (cv x3))) M) $;

--| Convert a universal quantification restricted to a singleton to a substitution. (Contributed by NM, 27-Apr-2009.)
theorem ralsn {x3: setvar} (ph: wff x3) (ps: wff) (A2: class):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wral x3 ph (csn A2)) ps $;

--| Convert an existential quantification restricted to a singleton to a substitution. (Contributed by Jeff Madsen, 5-Jan-2011.)
theorem rexsn {x3: setvar} (ph: wff x3) (ps: wff) (A2: class):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wrex x3 ph (csn A2)) ps $;

--| Elementhood in a union with a singleton. (Contributed by Thierry Arnoux, 14-Dec-2023.)
theorem elunsn (A2 B2 C V: class):
  $ wi (wcel A2 V) (wb (wcel A2 (cun B2 (csn C))) (wo (wcel A2 B2) (wceq A2 C))) $;

--| Membership in an extension of a power class. (Contributed by NM, 26-Mar-2007.)
theorem elpwunsn (A2 B2 C: class):
  $ wi (wcel A2 (cdif (cpw (cun B2 (csn C))) (cpw B2))) (wcel C A2) $;

--| An element of a set is either equal to another element of the set or a member of the difference of the set and the singleton containing the other element. (Contributed by AV, 25-Aug-2020.) (Proof shortened by JJ, 23-Jul-2021.)
theorem eqoreldif (A2 B2 C: class):
  $ wi (wcel B2 C) (wb (wcel A2 C) (wo (wceq A2 B2) (wcel A2 (cdif C (csn B2))))) $;

--| Members of an unordered triple of classes. (Contributed by FL, 2-Feb-2014.) (Proof shortened by Mario Carneiro, 11-Feb-2015.)
theorem eltpg (A2 B2 C D V: class):
  $ wi (wcel A2 V) (wb (wcel A2 (ctp B2 C D)) (w3o (wceq A2 B2) (wceq A2 C) (wceq A2 D))) $;

--| Membership in a set with three elements removed. Similar to ~ eldifsn and ~ eldifpr . (Contributed by David A. Wheeler, 22-Jul-2017.)
theorem eldiftp (A2 B2 C D E: class):
  $ wb (wcel A2 (cdif B2 (ctp C D E))) (wa (wcel A2 B2) (w3a (wne A2 C) (wne A2 D) (wne A2 E))) $;

--| A member of an unordered triple of classes is one of them. (Contributed by Mario Carneiro, 11-Feb-2015.)
theorem eltpi (A2 B2 C D: class):
  $ wi (wcel A2 (ctp B2 C D)) (w3o (wceq A2 B2) (wceq A2 C) (wceq A2 D)) $;

--| A member of an unordered triple of classes is one of them. Special case of Exercise 1 of [TakeutiZaring] p. 17. (Contributed by NM, 8-Apr-1994.) (Revised by Mario Carneiro, 11-Feb-2015.)
theorem eltp (A2 B2 C D: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 (ctp B2 C D)) (w3o (wceq A2 B2) (wceq A2 C) (wceq A2 D)) $;

--| Members of a set with seven elements. Lemma for ~ usgrexmpl2nb0 etc. (Contributed by AV, 9-Aug-2025.)
theorem el7g (A2 B2 C D E F G V X: class):
  $ wi (wcel X V) (wb (wcel X (cun (csn A2) (cun (ctp B2 C D) (ctp E F G)))) (wo (wceq X A2) (wo (w3o (wceq X B2) (wceq X C) (wceq X D)) (w3o (wceq X E) (wceq X F) (wceq X G))))) $;

--| Alternate definition of unordered triple of classes. Special case of Definition 5.3 of [TakeutiZaring] p. 16. (Contributed by NM, 8-Apr-1994.)
theorem dftp2 {x3: setvar} (A2 B2 C: class):
  $ wceq (ctp A2 B2 C) (cab x3 (w3o (wceq (cv x3) A2) (wceq (cv x3) B2) (wceq (cv x3) C))) $;

--| Bound-variable hypothesis builder for unordered pairs. (Contributed by NM, 14-Nov-1995.)
theorem nfpr {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 (cpr A2 B2) $;

--| Membership of a conditional operator in an unordered pair. (Contributed by NM, 17-Jun-2007.)
theorem ifpr (ph: wff) (A2 B2 C D: class):
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wcel (cif ph A2 B2) (cpr A2 B2)) $;

--| Convert a restricted universal quantification over a pair to a conjunction, using bound-variable hypotheses instead of distinct variable conditions. (Contributed by NM, 17-Sep-2011.) (Revised by AV, 8-Apr-2023.)
theorem ralprgf {x3: setvar} (ph ps ch: wff x3) (A2 B2: class) (V W: class x3):
  $ wnf x3 ps $ >
  $ wnf x3 ch $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv x3) B2) (wb ph ch) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wral x3 ph (cpr A2 B2)) (wa ps ch)) $;

--| Convert a restricted existential quantification over a pair to a disjunction, using bound-variable hypotheses instead of distinct variable conditions. (Contributed by NM, 17-Sep-2011.) (Revised by AV, 2-Apr-2023.)
theorem rexprgf {x3: setvar} (ph ps ch: wff x3) (A2 B2: class) (V W: class x3):
  $ wnf x3 ps $ >
  $ wnf x3 ch $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv x3) B2) (wb ph ch) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wrex x3 ph (cpr A2 B2)) (wo ps ch)) $;

--| Convert a restricted universal quantification over a pair to a conjunction. (Contributed by NM, 17-Sep-2011.) (Revised by Mario Carneiro, 23-Apr-2015.) Avoid ~ ax-10 , ~ ax-12 . (Revised by GG, 30-Sep-2024.)
theorem ralprg {x3: setvar} (ph: wff x3) (ps ch: wff) (A2 B2: class) (V W: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv x3) B2) (wb ph ch) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wral x3 ph (cpr A2 B2)) (wa ps ch)) $;

--| Convert a restricted existential quantification over a pair to a disjunction. (Contributed by NM, 17-Sep-2011.) (Revised by Mario Carneiro, 23-Apr-2015.) Avoid ~ ax-10 , ~ ax-12 . (Revised by GG, 30-Sep-2024.)
theorem rexprg {x3: setvar} (ph: wff x3) (ps ch: wff) (A2 B2: class) (V W: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv x3) B2) (wb ph ch) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wrex x3 ph (cpr A2 B2)) (wo ps ch)) $;

--| Convert a restricted universal quantification over a triple to a conjunction. (Contributed by NM, 17-Sep-2011.) (Revised by Mario Carneiro, 23-Apr-2015.)
theorem raltpg {x3: setvar} (ph: wff x3) (ps ch th: wff) (A2 B2 C: class) (V W X: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv x3) B2) (wb ph ch) $ >
  $ wi (wceq (cv x3) C) (wb ph th) $ >
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel C X)) (wb (wral x3 ph (ctp A2 B2 C)) (w3a ps ch th)) $;

--| Convert a restricted existential quantification over a triple to a disjunction. (Contributed by Mario Carneiro, 23-Apr-2015.)
theorem rextpg {x3: setvar} (ph: wff x3) (ps ch th: wff) (A2 B2 C: class) (V W X: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv x3) B2) (wb ph ch) $ >
  $ wi (wceq (cv x3) C) (wb ph th) $ >
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel C X)) (wb (wrex x3 ph (ctp A2 B2 C)) (w3o ps ch th)) $;

--| Convert a restricted universal quantification over a pair to a conjunction. (Contributed by NM, 3-Jun-2007.) (Revised by Mario Carneiro, 23-Apr-2015.)
theorem ralpr {x3: setvar} (ph: wff x3) (ps ch: wff) (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv x3) B2) (wb ph ch) $ >
  $ wb (wral x3 ph (cpr A2 B2)) (wa ps ch) $;

--| Convert a restricted existential quantification over a pair to a disjunction. (Contributed by NM, 3-Jun-2007.) (Revised by Mario Carneiro, 23-Apr-2015.)
theorem rexpr {x3: setvar} (ph: wff x3) (ps ch: wff) (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv x3) B2) (wb ph ch) $ >
  $ wb (wrex x3 ph (cpr A2 B2)) (wo ps ch) $;

--| Convert a restricted existential uniqueness over a pair to a disjunction of conjunctions. (Contributed by AV, 2-Apr-2023.)
theorem reuprg0 {x3: setvar} (ph: wff x3) (ps ch: wff) (A2 B2: class) (V W: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv x3) B2) (wb ph ch) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wreu x3 ph (cpr A2 B2)) (wo (wa ps (wi ch (wceq A2 B2))) (wa ch (wi ps (wceq A2 B2))))) $;

--| Convert a restricted existential uniqueness over a pair to a disjunction and an implication . (Contributed by AV, 2-Apr-2023.)
theorem reuprg {x3: setvar} (ph: wff x3) (ps ch: wff) (A2 B2: class) (V W: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv x3) B2) (wb ph ch) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wreu x3 ph (cpr A2 B2)) (wa (wo ps ch) (wi (wa ch ps) (wceq A2 B2)))) $;

--| Convert a restricted existential uniqueness over a pair to a restricted existential quantification and an implication . (Contributed by AV, 3-Apr-2023.)
theorem reurexprg {x3: setvar} (ph: wff x3) (ps ch: wff) (A2 B2: class) (V W: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv x3) B2) (wb ph ch) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wreu x3 ph (cpr A2 B2)) (wa (wrex x3 ph (cpr A2 B2)) (wi (wa ch ps) (wceq A2 B2)))) $;

--| Convert a universal quantification over an unordered triple to a conjunction. (Contributed by NM, 13-Sep-2011.) (Revised by Mario Carneiro, 23-Apr-2015.)
theorem raltp {x3: setvar} (ph: wff x3) (ps ch th: wff) (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv x3) B2) (wb ph ch) $ >
  $ wi (wceq (cv x3) C) (wb ph th) $ >
  $ wb (wral x3 ph (ctp A2 B2 C)) (w3a ps ch th) $;

--| Convert an existential quantification over an unordered triple to a disjunction. (Contributed by Mario Carneiro, 23-Apr-2015.)
theorem rextp {x3: setvar} (ph: wff x3) (ps ch th: wff) (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv x3) B2) (wb ph ch) $ >
  $ wi (wceq (cv x3) C) (wb ph th) $ >
  $ wb (wrex x3 ph (ctp A2 B2 C)) (w3o ps ch th) $;

--| Bound-variable hypothesis builder for singletons. (Contributed by NM, 14-Nov-1995.)
theorem nfsn {x3: setvar} (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 (csn A2) $;

--| Distribute proper substitution through the singleton of a class. ~ csbsng is derived from the virtual deduction proof ~ csbsngVD . (Contributed by Alan Sare, 10-Nov-2012.)
theorem csbsng {x3: setvar} (A2 B2 V: class x3):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (csn B2)) (csn (csb x3 A2 B2))) $;

--| Distribute proper substitution through a pair of classes. (Contributed by Alexander van der Vekens, 4-Sep-2018.)
theorem csbprg {x3: setvar} (A2 B2 C V: class x3):
  $ wi (wcel C V) (wceq (csb x3 C (cpr A2 B2)) (cpr (csb x3 C A2) (csb x3 C B2))) $;

--| If the intersection of two classes is a (proper) singleton, then the singleton element is a member of both classes. (Contributed by AV, 30-Dec-2021.)
theorem elinsn (A2 B2 C V: class):
  $ wi (wa (wcel A2 V) (wceq (cin B2 C) (csn A2))) (wa (wcel A2 B2) (wcel A2 C)) $;

--| Intersection with the singleton of a non-member is disjoint. (Contributed by NM, 22-May-1998.) (Proof shortened by Andrew Salmon, 29-Jun-2011.) (Proof shortened by Wolf Lammen, 30-Sep-2014.)
theorem disjsn (A2 B2: class):
  $ wb (wceq (cin A2 (csn B2)) c0) (wn (wcel B2 A2)) $;

--| Two distinct singletons are disjoint. (Contributed by NM, 25-May-1998.)
theorem disjsn2 (A2 B2: class):
  $ wi (wne A2 B2) (wceq (cin (csn A2) (csn B2)) c0) $;

--| Two completely distinct unordered pairs are disjoint. (Contributed by Alexander van der Vekens, 11-Nov-2017.) (Proof shortened by JJ, 23-Jul-2021.)
theorem disjpr2 (A2 B2 C D: class):
  $ wi (wa (wa (wne A2 C) (wne B2 C)) (wa (wne A2 D) (wne B2 D))) (wceq (cin (cpr A2 B2) (cpr C D)) c0) $;

--| The disjoint intersection of an unordered pair and a singleton. (Contributed by AV, 23-Jan-2021.)
theorem disjprsn (A2 B2 C: class):
  $ wi (wa (wne A2 C) (wne B2 C)) (wceq (cin (cpr A2 B2) (csn C)) c0) $;

--| The disjoint intersection of an unordered triple and a singleton. (Contributed by AV, 14-Nov-2021.)
theorem disjtpsn (A2 B2 C D: class):
  $ wi (w3a (wne A2 D) (wne B2 D) (wne C D)) (wceq (cin (ctp A2 B2 C) (csn D)) c0) $;

--| Two completely distinct unordered triples are disjoint. (Contributed by AV, 14-Nov-2021.)
theorem disjtp2 (A2 B2 C D E F: class):
  $ wi (w3a (w3a (wne A2 D) (wne B2 D) (wne C D)) (w3a (wne A2 E) (wne B2 E) (wne C E)) (w3a (wne A2 F) (wne B2 F) (wne C F))) (wceq (cin (ctp A2 B2 C) (ctp D E F)) c0) $;

--| The singleton of a proper class (one that doesn't exist) is the empty set. Theorem 7.2 of [Quine] p. 48. (Contributed by NM, 21-Jun-1993.)
theorem snprc (A2: class):
  $ wb (wn (wcel A2 cvv)) (wceq (csn A2) c0) $;

--| A singleton is nonempty iff its argument is a set. (Contributed by Scott Fenton, 8-May-2018.)
theorem snnzb (A2: class):
  $ wb (wcel A2 cvv) (wne (csn A2) c0) $;

--| A restricted at-most-one quantifier over a singleton is always true. (Contributed by AV, 3-Apr-2023.)
theorem rmosn {x3: setvar} (ph: wff x3) (A2: class):
  $ wrmo x3 ph (csn A2) $;

--| Special case of ~ r19.12 where its converse holds. (Contributed by NM, 19-May-2008.) (Revised by Mario Carneiro, 23-Apr-2015.) (Revised by BJ, 18-Mar-2020.)
theorem r19_12sn {x3 y1: setvar} (ph: wff x3 y1) (A2: class) (B2: class y1) (V: class x3 y1):
  $ wi (wcel A2 V) (wb (wrex x3 (wral y1 ph B2) (csn A2)) (wral y1 (wrex x3 ph (csn A2)) B2)) $;

--| Condition where a restricted class abstraction is a singleton. (Contributed by NM, 28-May-2006.) (Proof shortened by AV, 26-Aug-2022.)
theorem rabsn {x3: setvar} (A2 B2: class):
  $ wi (wcel B2 A2) (wceq (crab x3 (wceq (cv x3) B2) A2) (csn B2)) $;

--| A restricted class abstraction restricted to a singleton is either the empty set or the singleton itself. (Contributed by AV, 21-Jul-2019.)
theorem rabsnifsb {x3: setvar} (ph: wff x3) (A2: class):
  $ wceq (crab x3 ph (csn A2)) (cif (wsbc x3 ph A2) (csn A2) c0) $;

--| A restricted class abstraction restricted to a singleton is either the empty set or the singleton itself. (Contributed by AV, 12-Apr-2019.) (Proof shortened by AV, 21-Jul-2019.)
theorem rabsnif {x3: setvar} (ph: wff x3) (ps: wff) (A2: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wceq (crab x3 ph (csn A2)) (cif ps (csn A2) c0) $;

--| A restricted class abstraction restricted to a singleton is either the empty set or the singleton itself. (Contributed by Alexander van der Vekens, 22-Dec-2017.) (Proof shortened by AV, 21-Jul-2019.)
theorem rabrsn {x3: setvar} (ph: wff x3) (A2: class) (M: class x3):
  $ wi (wceq M (crab x3 ph (csn A2))) (wo (wceq M c0) (wceq M (csn A2))) $;

--| Another way to express existential uniqueness of a wff: its class abstraction is a singleton. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem euabsn2 {x3 y1: setvar} (ph: wff x3):
  $ wb (weu x3 ph) (wex y1 (wceq (cab x3 ph) (csn (cv y1)))) $;

--| Another way to express existential uniqueness of a wff: its class abstraction is a singleton. (Contributed by NM, 22-Feb-2004.)
theorem euabsn {x3: setvar} (ph: wff x3):
  $ wb (weu x3 ph) (wex x3 (wceq (cab x3 ph) (csn (cv x3)))) $;

--| A way to express restricted existential uniqueness of a wff: its restricted class abstraction is a singleton. (Contributed by NM, 30-May-2006.) (Proof shortened by Mario Carneiro, 14-Nov-2016.)
theorem reusn {x3 y1: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wreu x3 ph A2) (wex y1 (wceq (crab x3 ph A2) (csn (cv y1)))) $;

--| Restricted existential uniqueness determined by a singleton. (Contributed by NM, 29-May-2006.)
theorem absneu {x3: setvar} (ph: wff x3) (A2 V: class x3):
  $ wi (wa (wcel A2 V) (wceq (cab x3 ph) (csn A2))) (weu x3 ph) $;

--| Restricted existential uniqueness determined by a singleton. (Contributed by NM, 29-May-2006.) (Revised by Mario Carneiro, 23-Dec-2016.)
theorem rabsneu {x3: setvar} (ph: wff x3) (A2 B2 V: class x3):
  $ wi (wa (wcel A2 V) (wceq (crab x3 ph B2) (csn A2))) (wreu x3 ph B2) $;

--| Two ways to express " ` A ` is a singleton". (Contributed by NM, 30-Oct-2010.)
theorem eusn {x3: setvar} (A2: class):
  $ wb (weu x3 (wcel (cv x3) A2)) (wex x3 (wceq A2 (csn (cv x3)))) $;

--| Truth implied by equality of a restricted class abstraction and a singleton. (Contributed by NM, 29-May-2006.) (Proof shortened by Mario Carneiro, 23-Dec-2016.)
theorem rabsnt {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wi (wceq (cv x3) B2) (wb ph ps) $ >
  $ wi (wceq (crab x3 ph A2) (csn B2)) ps $;

--| Commutative law for unordered pairs. (Contributed by NM, 15-Jul-1993.)
theorem prcom (A2 B2: class):
  $ wceq (cpr A2 B2) (cpr B2 A2) $;

--| Equality theorem for unordered pairs. (Contributed by NM, 29-Mar-1998.)
theorem preq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cpr A2 C) (cpr B2 C)) $;

--| Equality theorem for unordered pairs. (Contributed by NM, 15-Jul-1993.)
theorem preq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cpr C A2) (cpr C B2)) $;

--| Equality theorem for unordered pairs. (Contributed by NM, 19-Oct-2012.)
theorem preq12 (A2 B2 C D: class):
  $ wi (wa (wceq A2 C) (wceq B2 D)) (wceq (cpr A2 B2) (cpr C D)) $;

--| Equality inference for unordered pairs. (Contributed by NM, 19-Oct-2012.)
theorem preq1i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cpr A2 C) (cpr B2 C) $;

--| Equality inference for unordered pairs. (Contributed by NM, 19-Oct-2012.)
theorem preq2i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cpr C A2) (cpr C B2) $;

--| Equality inference for unordered pairs. (Contributed by NM, 19-Oct-2012.)
theorem preq12i (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq C D $ >
  $ wceq (cpr A2 C) (cpr B2 D) $;

--| Equality deduction for unordered pairs. (Contributed by NM, 19-Oct-2012.)
theorem preq1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cpr A2 C) (cpr B2 C)) $;

--| Equality deduction for unordered pairs. (Contributed by NM, 19-Oct-2012.)
theorem preq2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cpr C A2) (cpr C B2)) $;

--| Equality deduction for unordered pairs. (Contributed by NM, 19-Oct-2012.)
theorem preq12d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq (cpr A2 C) (cpr B2 D)) $;

--| Equality theorem for unordered triples. (Contributed by NM, 13-Sep-2011.)
theorem tpeq1 (A2 B2 C D: class):
  $ wi (wceq A2 B2) (wceq (ctp A2 C D) (ctp B2 C D)) $;

--| Equality theorem for unordered triples. (Contributed by NM, 13-Sep-2011.)
theorem tpeq2 (A2 B2 C D: class):
  $ wi (wceq A2 B2) (wceq (ctp C A2 D) (ctp C B2 D)) $;

--| Equality theorem for unordered triples. (Contributed by NM, 13-Sep-2011.)
theorem tpeq3 (A2 B2 C D: class):
  $ wi (wceq A2 B2) (wceq (ctp C D A2) (ctp C D B2)) $;

--| Equality theorem for unordered triples. (Contributed by NM, 22-Jun-2014.)
theorem tpeq1d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (ctp A2 C D) (ctp B2 C D)) $;

--| Equality theorem for unordered triples. (Contributed by NM, 22-Jun-2014.)
theorem tpeq2d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (ctp C A2 D) (ctp C B2 D)) $;

--| Equality theorem for unordered triples. (Contributed by NM, 22-Jun-2014.)
theorem tpeq3d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (ctp C D A2) (ctp C D B2)) $;

--| Equality theorem for unordered triples. (Contributed by NM, 22-Jun-2014.)
theorem tpeq123d (ph: wff) (A2 B2 C D E F: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq E F) $ >
  $ wi ph (wceq (ctp A2 C E) (ctp B2 D F)) $;

--| Rotation of the elements of an unordered triple. (Contributed by Alan Sare, 24-Oct-2011.)
theorem tprot (A2 B2 C: class):
  $ wceq (ctp A2 B2 C) (ctp B2 C A2) $;

--| Swap 1st and 2nd members of an unordered triple. (Contributed by NM, 22-May-2015.)
theorem tpcoma (A2 B2 C: class):
  $ wceq (ctp A2 B2 C) (ctp B2 A2 C) $;

--| Swap 2nd and 3rd members of an unordered triple. (Contributed by NM, 22-May-2015.)
theorem tpcomb (A2 B2 C: class):
  $ wceq (ctp A2 B2 C) (ctp A2 C B2) $;

--| Split off the first element of an unordered triple. (Contributed by Mario Carneiro, 5-Jan-2016.)
theorem tpass (A2 B2 C: class):
  $ wceq (ctp A2 B2 C) (cun (csn A2) (cpr B2 C)) $;

--| Two ways to write an unordered quadruple. (Contributed by Mario Carneiro, 5-Jan-2016.)
theorem qdass (A2 B2 C D: class):
  $ wceq (cun (cpr A2 B2) (cpr C D)) (cun (ctp A2 B2 C) (csn D)) $;

--| Two ways to write an unordered quadruple. (Contributed by Mario Carneiro, 5-Jan-2016.)
theorem qdassr (A2 B2 C D: class):
  $ wceq (cun (cpr A2 B2) (cpr C D)) (cun (csn A2) (ctp B2 C D)) $;

--| Unordered triple ` { A , A , B } ` is just an overlong way to write ` { A , B } ` . (Contributed by David A. Wheeler, 10-May-2015.)
theorem tpidm12 (A2 B2: class):
  $ wceq (ctp A2 A2 B2) (cpr A2 B2) $;

--| Unordered triple ` { A , B , A } ` is just an overlong way to write ` { A , B } ` . (Contributed by David A. Wheeler, 10-May-2015.)
theorem tpidm13 (A2 B2: class):
  $ wceq (ctp A2 B2 A2) (cpr A2 B2) $;

--| Unordered triple ` { A , B , B } ` is just an overlong way to write ` { A , B } ` . (Contributed by David A. Wheeler, 10-May-2015.)
theorem tpidm23 (A2 B2: class):
  $ wceq (ctp A2 B2 B2) (cpr A2 B2) $;

--| Unordered triple ` { A , A , A } ` is just an overlong way to write ` { A } ` . (Contributed by David A. Wheeler, 10-May-2015.)
theorem tpidm (A2: class):
  $ wceq (ctp A2 A2 A2) (csn A2) $;

--| An unordered triple is an unordered pair if one of its elements is identical with another element. (Contributed by Alexander van der Vekens, 6-Oct-2017.)
theorem tppreq3 (A2 B2 C: class):
  $ wi (wceq B2 C) (wceq (ctp A2 B2 C) (cpr A2 B2)) $;

--| An unordered pair contains its first member. Part of Theorem 7.6 of [Quine] p. 49. (Contributed by Stefan Allan, 8-Nov-2008.)
theorem prid1g (A2 B2 V: class):
  $ wi (wcel A2 V) (wcel A2 (cpr A2 B2)) $;

--| An unordered pair contains its second member. Part of Theorem 7.6 of [Quine] p. 49. (Contributed by Stefan Allan, 8-Nov-2008.)
theorem prid2g (A2 B2 V: class):
  $ wi (wcel B2 V) (wcel B2 (cpr A2 B2)) $;

--| An unordered pair contains its first member. Part of Theorem 7.6 of [Quine] p. 49. (Contributed by NM, 24-Jun-1993.)
theorem prid1 (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel A2 (cpr A2 B2) $;

--| An unordered pair contains its second member. Part of Theorem 7.6 of [Quine] p. 49. (Note: the proof from ~ prid2g and ~ ax-mp has one fewer essential step but one more total step.) (Contributed by NM, 5-Aug-1993.)
theorem prid2 (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wcel B2 (cpr A2 B2) $;

--| An unordered pair is a singleton or a subset of itself. This theorem is helpful to convert theorems about walks in arbitrary graphs into theorems about walks in pseudographs. (Contributed by AV, 27-Feb-2021.)
theorem ifpprsnss (A2 B2 P: class):
  $ wi (wceq P (cpr A2 B2)) (wif (wceq A2 B2) (wceq P (csn A2)) (wss (cpr A2 B2) P)) $;

--| A proper class vanishes in an unordered pair. (Contributed by NM, 15-Jul-1993.)
theorem prprc1 (A2 B2: class):
  $ wi (wn (wcel A2 cvv)) (wceq (cpr A2 B2) (csn B2)) $;

--| A proper class vanishes in an unordered pair. (Contributed by NM, 22-Mar-2006.)
theorem prprc2 (A2 B2: class):
  $ wi (wn (wcel B2 cvv)) (wceq (cpr A2 B2) (csn A2)) $;

--| An unordered pair containing two proper classes is the empty set. (Contributed by NM, 22-Mar-2006.)
theorem prprc (A2 B2: class):
  $ wi (wa (wn (wcel A2 cvv)) (wn (wcel B2 cvv))) (wceq (cpr A2 B2) c0) $;

--| One of the three elements of an unordered triple. (Contributed by NM, 7-Apr-1994.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem tpid1 (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel A2 (ctp A2 B2 C) $;

--| Closed theorem form of ~ tpid1 . (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem tpid1g (A2 B2 C D: class):
  $ wi (wcel A2 B2) (wcel A2 (ctp A2 C D)) $;

--| One of the three elements of an unordered triple. (Contributed by NM, 7-Apr-1994.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem tpid2 (A2 B2 C: class):
  $ wcel B2 cvv $ >
  $ wcel B2 (ctp A2 B2 C) $;

--| Closed theorem form of ~ tpid2 . (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem tpid2g (A2 B2 C D: class):
  $ wi (wcel A2 B2) (wcel A2 (ctp C A2 D)) $;

--| Closed theorem form of ~ tpid3 . (Contributed by Alan Sare, 24-Oct-2011.) (Proof shortened by JJ, 30-Apr-2021.)
theorem tpid3g (A2 B2 C D: class):
  $ wi (wcel A2 B2) (wcel A2 (ctp C D A2)) $;

--| One of the three elements of an unordered triple. (Contributed by NM, 7-Apr-1994.) (Proof shortened by Andrew Salmon, 29-Jun-2011.) (Proof shortened by JJ, 30-Apr-2021.)
theorem tpid3 (A2 B2 C: class):
  $ wcel C cvv $ >
  $ wcel C (ctp A2 B2 C) $;

--| The singleton of a set is not empty. (Contributed by NM, 14-Dec-2008.)
theorem snnzg (A2 V: class):
  $ wi (wcel A2 V) (wne (csn A2) c0) $;

--| The singleton of a set is not empty. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem snn0d (ph: wff) (A2 V: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wne (csn A2) c0) $;

--| The singleton of a set is not empty. (Contributed by NM, 10-Apr-1994.)
theorem snnz (A2: class):
  $ wcel A2 cvv $ >
  $ wne (csn A2) c0 $;

--| A pair containing a set is not empty. (Contributed by NM, 9-Apr-1994.)
theorem prnz (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wne (cpr A2 B2) c0 $;

--| A pair containing a set is not empty. (Contributed by FL, 19-Sep-2011.) (Proof shortened by JJ, 23-Jul-2021.)
theorem prnzg (A2 B2 V: class):
  $ wi (wcel A2 V) (wne (cpr A2 B2) c0) $;

--| An unordered triple containing a set is not empty. (Contributed by NM, 10-Apr-1994.)
theorem tpnz (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wne (ctp A2 B2 C) c0 $;

--| An unordered triple containing a set is not empty. (Contributed by Thierry Arnoux, 8-Apr-2019.)
theorem tpnzd (ph: wff) (A2 B2 C V: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wne (ctp A2 B2 C) c0) $;

--| Convert a universal quantification over an unordered triple to a conjunction. (Contributed by Thierry Arnoux, 8-Apr-2019.)
theorem raltpd {x3: setvar} (ph: wff) (ps: wff x3) (ch th ta: wff) (A2 B2 C: class) (V W X: class x3):
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi (wa ph (wceq (cv x3) B2)) (wb ps th) $ >
  $ wi (wa ph (wceq (cv x3) C)) (wb ps ta) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel C X) $ >
  $ wi ph (wb (wral x3 ps (ctp A2 B2 C)) (w3a ch th ta)) $;

--| Characterization of the inclusion of a singleton in a class. (Contributed by BJ, 1-Jan-2025.)
theorem snssb (A2 B2: class):
  $ wb (wss (csn A2) B2) (wi (wcel A2 cvv) (wcel A2 B2)) $;

--| The singleton formed on a set is included in a class if and only if the set is an element of that class. Theorem 7.4 of [Quine] p. 49. (Contributed by NM, 22-Jul-2001.) (Proof shortened by BJ, 1-Jan-2025.)
theorem snssg (A2 B2 V: class):
  $ wi (wcel A2 V) (wb (wcel A2 B2) (wss (csn A2) B2)) $;

--| The singleton of an element of a class is a subset of the class (inference form of ~ snssg ). Theorem 7.4 of [Quine] p. 49. (Contributed by NM, 21-Jun-1993.)
theorem snss (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 B2) (wss (csn A2) B2) $;

--| The singleton of an element of a class is a subset of the class. (Contributed by NM, 6-Jun-1994.)
theorem snssi (A2 B2: class):
  $ wi (wcel A2 B2) (wss (csn A2) B2) $;

--| The singleton of an element of a class is a subset of the class (deduction form). (Contributed by Jonathan Ben-Naim, 3-Jun-2011.)
theorem snssd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wss (csn A2) B2) $;

--| Membership in a set with an element removed. (Contributed by NM, 10-Oct-2007.)
theorem eldifsn (A2 B2 C: class):
  $ wb (wcel A2 (cdif B2 (csn C))) (wa (wcel A2 B2) (wne A2 C)) $;

--| Membership in a set with an element removed implies non-equality with that element. (Contributed by Thierry Arnoux, 13-Jul-2026.)
theorem eldifsnbd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 (cdif B2 (csn C))) $ >
  $ wi ph (wne A2 C) $;

--| Membership in a set with an element removed : deduction version. (Contributed by Thierry Arnoux, 4-May-2025.)
theorem eldifsnd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wne A2 C) $ >
  $ wi ph (wcel A2 (cdif B2 (csn C))) $;

--| Subset of a set with an element removed. (Contributed by Emmett Weisz, 7-Jul-2021.) (Proof shortened by JJ, 31-May-2022.)
theorem ssdifsn (A2 B2 C: class):
  $ wb (wss A2 (cdif B2 (csn C))) (wa (wss A2 B2) (wn (wcel C A2))) $;

--| A subset of a set is an element of the power set of the difference of the set with a singleton if the subset does not contain the singleton element. (Contributed by AV, 10-Jan-2020.)
theorem elpwdifsn (A2 S V W: class):
  $ wi (w3a (wcel S W) (wss S V) (wnel A2 S)) (wcel S (cpw (cdif V (csn A2)))) $;

--| Membership in a set with an element removed. (Contributed by NM, 10-Mar-2015.)
theorem eldifsni (A2 B2 C: class):
  $ wi (wcel A2 (cdif B2 (csn C))) (wne A2 C) $;

--| An element of a difference with a singleton is not equal to the element of that singleton. Note that ` ( -. A e. { C } -> -. A = C ) ` need not hold if ` A ` is a proper class. (Contributed by BJ, 18-Mar-2023.) (Proof shortened by Steven Nguyen, 1-Jun-2023.)
theorem eldifsnneq (A2 B2 C: class):
  $ wi (wcel A2 (cdif B2 (csn C))) (wn (wceq A2 C)) $;

--| The class ` A ` is not in ` ( B \ { A } ) ` . (Contributed by David Moews, 1-May-2017.)
theorem neldifsn (A2 B2: class):
  $ wn (wcel A2 (cdif B2 (csn A2))) $;

--| The class ` A ` is not in ` ( B \ { A } ) ` . Deduction form. (Contributed by David Moews, 1-May-2017.)
theorem neldifsnd (ph: wff) (A2 B2: class):
  $ wi ph (wn (wcel A2 (cdif B2 (csn A2)))) $;

--| Restricted existential quantification over a set with an element removed. (Contributed by NM, 4-Feb-2015.)
theorem rexdifsn {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wb (wrex x3 ph (cdif A2 (csn B2))) (wrex x3 (wa (wne (cv x3) B2) ph) A2) $;

--| Rearrangement of a property of a singleton difference. (Contributed by Stefan O'Rear, 27-Feb-2015.)
theorem raldifsni {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wb (wral x3 (wn ph) (cdif A2 (csn B2))) (wral x3 (wi ph (wceq (cv x3) B2)) A2) $;

--| Restricted universal quantification on a class difference with a singleton in terms of an implication. (Contributed by Alexander van der Vekens, 26-Jan-2018.)
theorem raldifsnb {x3: setvar} (ph: wff x3) (A2 Y: class x3):
  $ wb (wral x3 (wi (wne (cv x3) Y) ph) A2) (wral x3 ph (cdif A2 (csn Y))) $;

--| A set is an element of the universal class excluding a singleton iff it is not the singleton element. (Contributed by AV, 7-Apr-2019.)
theorem eldifvsn (A2 B2 V: class):
  $ wi (wcel A2 V) (wb (wcel A2 (cdif cvv (csn B2))) (wne A2 B2)) $;

--| An element not in a set can be removed without affecting the set. (Contributed by NM, 16-Mar-2006.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem difsn (A2 B2: class):
  $ wi (wn (wcel A2 B2)) (wceq (cdif B2 (csn A2)) B2) $;

--| Removal of a singleton from an unordered pair. (Contributed by NM, 16-Mar-2006.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem difprsnss (A2 B2: class):
  $ wss (cdif (cpr A2 B2) (csn A2)) (csn B2) $;

--| Removal of a singleton from an unordered pair. (Contributed by Thierry Arnoux, 4-Feb-2017.)
theorem difprsn1 (A2 B2: class):
  $ wi (wne A2 B2) (wceq (cdif (cpr A2 B2) (csn A2)) (csn B2)) $;

--| Removal of a singleton from an unordered pair. (Contributed by Alexander van der Vekens, 5-Oct-2017.)
theorem difprsn2 (A2 B2: class):
  $ wi (wne A2 B2) (wceq (cdif (cpr A2 B2) (csn B2)) (csn A2)) $;

--| Removal of a singleton from an unordered triple. (Contributed by Alexander van der Vekens, 5-Oct-2017.) (Proof shortened by JJ, 23-Jul-2021.)
theorem diftpsn3 (A2 B2 C: class):
  $ wi (wa (wne A2 C) (wne B2 C)) (wceq (cdif (ctp A2 B2 C) (csn C)) (cpr A2 B2)) $;

--| Removing two elements as pair of elements corresponds to removing each of the two elements as singletons. (Contributed by Alexander van der Vekens, 13-Jul-2018.)
theorem difpr (A2 B2 C: class):
  $ wceq (cdif A2 (cpr B2 C)) (cdif (cdif A2 (csn B2)) (csn C)) $;

--| An unordered triple is an unordered pair if one of its elements is a proper class or is identical with another element. (Contributed by Alexander van der Vekens, 6-Oct-2017.)
theorem tpprceq3 (A2 B2 C: class):
  $ wi (wn (wa (wcel C cvv) (wne C B2))) (wceq (ctp A2 B2 C) (cpr A2 B2)) $;

--| An unordered triple is an unordered pair if and only if one of its elements is a proper class or is identical with one of the another elements. (Contributed by Alexander van der Vekens, 15-Jan-2018.)
theorem tppreqb (A2 B2 C: class):
  $ wb (wn (w3a (wcel C cvv) (wne C A2) (wne C B2))) (wceq (ctp A2 B2 C) (cpr A2 B2)) $;

--| ` ( B \ { A } ) ` equals ` B ` if and only if ` A ` is not a member of ` B ` . Generalization of ~ difsn . (Contributed by David Moews, 1-May-2017.)
theorem difsnb (A2 B2: class):
  $ wb (wn (wcel A2 B2)) (wceq (cdif B2 (csn A2)) B2) $;

--| ` ( B \ { A } ) ` is a proper subclass of ` B ` if and only if ` A ` is a member of ` B ` . (Contributed by David Moews, 1-May-2017.)
theorem difsnpss (A2 B2: class):
  $ wb (wcel A2 B2) (wpss (cdif B2 (csn A2)) B2) $;

--| If we remove a single element from a class then put it back in, we end up with the original class. (Contributed by NM, 2-Oct-2006.)
theorem difsnid (A2 B2: class):
  $ wi (wcel B2 A2) (wceq (cun (cdif A2 (csn B2)) (csn B2)) A2) $;

--| An element of a difference set is an element of the difference with a singleton. (Contributed by AV, 2-Jan-2022.)
theorem eldifeldifsn (A2 B2 X Y: class):
  $ wi (wa (wcel X A2) (wcel Y (cdif B2 A2))) (wcel Y (cdif B2 (csn X))) $;

--| A singleton is a subset of an unordered pair containing its member. (Contributed by NM, 27-Aug-2004.)
theorem snsspr1 (A2 B2: class):
  $ wss (csn A2) (cpr A2 B2) $;

--| A singleton is a subset of an unordered pair containing its member. (Contributed by NM, 2-May-2009.)
theorem snsspr2 (A2 B2: class):
  $ wss (csn B2) (cpr A2 B2) $;

--| A singleton is a subset of an unordered triple containing its member. (Contributed by NM, 9-Oct-2013.)
theorem snsstp1 (A2 B2 C: class):
  $ wss (csn A2) (ctp A2 B2 C) $;

--| A singleton is a subset of an unordered triple containing its member. (Contributed by NM, 9-Oct-2013.)
theorem snsstp2 (A2 B2 C: class):
  $ wss (csn B2) (ctp A2 B2 C) $;

--| A singleton is a subset of an unordered triple containing its member. (Contributed by NM, 9-Oct-2013.)
theorem snsstp3 (A2 B2 C: class):
  $ wss (csn C) (ctp A2 B2 C) $;

--| A pair of elements of a class is a subset of the class. Theorem 7.5 of [Quine] p. 49. (Contributed by NM, 22-Mar-2006.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem prssg (A2 B2 C V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wa (wcel A2 C) (wcel B2 C)) (wss (cpr A2 B2) C)) $;

--| A pair of elements of a class is a subset of the class. Theorem 7.5 of [Quine] p. 49. (Contributed by NM, 30-May-1994.) (Proof shortened by Andrew Salmon, 29-Jun-2011.) (Proof shortened by JJ, 23-Jul-2021.)
theorem prss (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wb (wa (wcel A2 C) (wcel B2 C)) (wss (cpr A2 B2) C) $;

--| A pair of elements of a class is a subset of the class. (Contributed by NM, 16-Jan-2015.)
theorem prssi (A2 B2 C: class):
  $ wi (wa (wcel A2 C) (wcel B2 C)) (wss (cpr A2 B2) C) $;

--| Deduction version of ~ prssi : A pair of elements of a class is a subset of the class. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem prssd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 C) $ >
  $ wi ph (wcel B2 C) $ >
  $ wi ph (wss (cpr A2 B2) C) $;

--| An unordered pair belongs to the power class of a class iff each member belongs to the class. (Contributed by Thierry Arnoux, 3-Oct-2016.) (Revised by NM, 18-Jan-2018.)
theorem prsspwg (A2 B2 C V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wss (cpr A2 B2) (cpw C)) (wa (wss A2 C) (wss B2 C))) $;

--| A pair as subset of a pair. (Contributed by AV, 26-Oct-2020.)
theorem ssprss (A2 B2 C D V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wss (cpr A2 B2) (cpr C D)) (wa (wo (wceq A2 C) (wceq A2 D)) (wo (wceq B2 C) (wceq B2 D)))) $;

--| A proper pair is a subset of a pair iff it is equal to the superset. (Contributed by AV, 26-Oct-2020.)
theorem ssprsseq (A2 B2 C D V W: class):
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wne A2 B2)) (wb (wss (cpr A2 B2) (cpr C D)) (wceq (cpr A2 B2) (cpr C D))) $;

--| The subsets of a singleton. (Contributed by NM, 24-Apr-2004.)
theorem sssn (A2 B2: class):
  $ wb (wss A2 (csn B2)) (wo (wceq A2 c0) (wceq A2 (csn B2))) $;

--| The property of being sandwiched between two sets naturally splits under union with a singleton. This is the induction hypothesis for the determination of large powersets such as ~ pwtp . (Contributed by Mario Carneiro, 2-Jul-2016.)
theorem ssunsn2 (A2 B2 C D: class):
  $ wb (wa (wss B2 A2) (wss A2 (cun C (csn D)))) (wo (wa (wss B2 A2) (wss A2 C)) (wa (wss (cun B2 (csn D)) A2) (wss A2 (cun C (csn D))))) $;

--| Possible values for a set sandwiched between another set and it plus a singleton. (Contributed by Mario Carneiro, 2-Jul-2016.)
theorem ssunsn (A2 B2 C: class):
  $ wb (wa (wss B2 A2) (wss A2 (cun B2 (csn C)))) (wo (wceq A2 B2) (wceq A2 (cun B2 (csn C)))) $;

--| Two ways to express that a nonempty set equals a singleton. (Contributed by NM, 15-Dec-2007.) (Proof shortened by JJ, 23-Jul-2021.)
theorem eqsn {x3: setvar} (A2 B2: class):
  $ wi (wne A2 c0) (wb (wceq A2 (csn B2)) (wral x3 (wceq (cv x3) B2) A2)) $;

--| Deduce that a set is a singleton. (Contributed by Thierry Arnoux, 10-May-2023.) (Proof shortened by SN, 3-Jul-2025.)
theorem eqsnd {x3: setvar} (ph: wff) (A2 B2: class):
  $ wi (wa ph (wcel (cv x3) A2)) (wceq (cv x3) B2) $ >
  $ wi ph (wcel B2 A2) $ >
  $ wi ph (wceq A2 (csn B2)) $;

--| A sufficient condition for a (nonempty) set to be a singleton. (Contributed by AV, 20-Sep-2020.)
theorem issn {x3 y1 z: setvar} (A2: class):
  $ wi (wrex x3 (wral y1 (wceq (cv x3) (cv y1)) A2) A2) (wex z (wceq A2 (csn (cv z)))) $;

--| A nonempty set is either a singleton or contains at least two different elements. (Contributed by AV, 20-Sep-2020.)
theorem n0snor2el {x3 y1 z: setvar} (A2: class):
  $ wi (wne A2 c0) (wo (wrex x3 (wrex y1 (wne (cv x3) (cv y1)) A2) A2) (wex z (wceq A2 (csn (cv z))))) $;

--| A nonempty set is either a singleton or contains at least two different elements. (Contributed by AV, 20-Sep-2020.)
theorem n0snor2el_b {x3 y1: setvar} (A2: class):
  $ wi (wne A2 c0) (wo (wrex x3 (wrex y1 (wne (cv x3) (cv y1)) A2) A2) (wex x3 (wceq A2 (csn (cv x3))))) $;

--| Possible values for a set sandwiched between another set and it plus a singleton. (Contributed by Mario Carneiro, 2-Jul-2016.)
theorem ssunpr (A2 B2 C D: class):
  $ wb (wa (wss B2 A2) (wss A2 (cun B2 (cpr C D)))) (wo (wo (wceq A2 B2) (wceq A2 (cun B2 (csn C)))) (wo (wceq A2 (cun B2 (csn D))) (wceq A2 (cun B2 (cpr C D))))) $;

--| The subsets of a pair. (Contributed by NM, 16-Mar-2006.) (Proof shortened by Mario Carneiro, 2-Jul-2016.)
theorem sspr (A2 B2 C: class):
  $ wb (wss A2 (cpr B2 C)) (wo (wo (wceq A2 c0) (wceq A2 (csn B2))) (wo (wceq A2 (csn C)) (wceq A2 (cpr B2 C)))) $;

--| The subsets of an unordered triple. (Contributed by Mario Carneiro, 2-Jul-2016.)
theorem sstp (A2 B2 C D: class):
  $ wb (wss A2 (ctp B2 C D)) (wo (wo (wo (wceq A2 c0) (wceq A2 (csn B2))) (wo (wceq A2 (csn C)) (wceq A2 (cpr B2 C)))) (wo (wo (wceq A2 (csn D)) (wceq A2 (cpr B2 D))) (wo (wceq A2 (cpr C D)) (wceq A2 (ctp B2 C D))))) $;

--| An unordered triple of elements of a class is a subset of the class. (Contributed by NM, 9-Apr-1994.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem tpss (A2 B2 C D: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wb (w3a (wcel A2 D) (wcel B2 D) (wcel C D)) (wss (ctp A2 B2 C) D) $;

--| An unordered triple of elements of a class is a subset of the class. (Contributed by Alexander van der Vekens, 1-Feb-2018.)
theorem tpssi (A2 B2 C D: class):
  $ wi (w3a (wcel A2 D) (wcel B2 D) (wcel C D)) (wss (ctp A2 B2 C) D) $;

--| Closed form of ~ sneqr . (Contributed by Scott Fenton, 1-Apr-2011.) (Proof shortened by JJ, 23-Jul-2021.)
theorem sneqrg (A2 B2 V: class):
  $ wi (wcel A2 V) (wi (wceq (csn A2) (csn B2)) (wceq A2 B2)) $;

--| If the singletons of two sets are equal, the two sets are equal. Part of Exercise 4 of [TakeutiZaring] p. 15. (Contributed by NM, 27-Aug-1993.)
theorem sneqr (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wi (wceq (csn A2) (csn B2)) (wceq A2 B2) $;

--| If a singleton is a subset of another, their members are equal. (Contributed by NM, 28-May-2006.)
theorem snsssn (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wi (wss (csn A2) (csn B2)) (wceq A2 B2) $;

--| There exists at most one set whose singleton is equal to a given class. See also ~ moeq . (Contributed by BJ, 24-Sep-2022.)
theorem mosneq {x3: setvar} (A2: class):
  $ wmo x3 (wceq (csn (cv x3)) A2) $;

--| Two singletons of sets are equal iff their elements are equal. (Contributed by Scott Fenton, 16-Apr-2012.)
theorem sneqbg (A2 B2 V: class):
  $ wi (wcel A2 V) (wb (wceq (csn A2) (csn B2)) (wceq A2 B2)) $;

--| The singleton of a class is a subset of its power class. (Contributed by NM, 21-Jun-1993.)
theorem snsspw (A2: class):
  $ wss (csn A2) (cpw A2) $;

--| An unordered pair belongs to the power class of a class iff each member belongs to the class. (Contributed by NM, 10-Dec-2003.) (Proof shortened by Andrew Salmon, 26-Jun-2011.) (Proof shortened by OpenAI, 25-Mar-2020.)
theorem prsspw (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wb (wss (cpr A2 B2) (cpw C)) (wa (wss A2 C) (wss B2 C)) $;

--| Biconditional equality lemma for unordered pairs, deduction form. Two unordered pairs have the same second element iff the first elements are equal. (Contributed by AV, 18-Dec-2020.)
theorem preq1b (ph: wff) (A2 B2 C V W: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wb (wceq (cpr A2 C) (cpr B2 C)) (wceq A2 B2)) $;

--| Biconditional equality lemma for unordered pairs, deduction form. Two unordered pairs have the same first element iff the second elements are equal. (Contributed by AV, 18-Dec-2020.)
theorem preq2b (ph: wff) (A2 B2 C V W: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wb (wceq (cpr C A2) (cpr C B2)) (wceq A2 B2)) $;

--| Reverse equality lemma for unordered pairs. If two unordered pairs have the same second element, the first elements are equal. (Contributed by NM, 18-Oct-1995.)
theorem preqr1 (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wceq (cpr A2 C) (cpr B2 C)) (wceq A2 B2) $;

--| Reverse equality lemma for unordered pairs. If two unordered pairs have the same first element, the second elements are equal. (Contributed by NM, 15-Jul-1993.)
theorem preqr2 (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wceq (cpr C A2) (cpr C B2)) (wceq A2 B2) $;

--| Equality relationship for two unordered pairs. (Contributed by NM, 17-Oct-1996.)
theorem preq12b (A2 B2 C D: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wcel D cvv $ >
  $ wb (wceq (cpr A2 B2) (cpr C D)) (wo (wa (wceq A2 C) (wceq B2 D)) (wa (wceq A2 D) (wceq B2 C))) $;

--| An unordered pair has the ordered pair property (compare ~ opth ) under certain conditions. (Contributed by NM, 27-Mar-2007.)
theorem opthpr (A2 B2 C D: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wcel D cvv $ >
  $ wi (wne A2 D) (wb (wceq (cpr A2 B2) (cpr C D)) (wa (wceq A2 C) (wceq B2 D))) $;

--| Reverse equality lemma for unordered pairs. If two unordered pairs have the same second element, the first elements are equal. Closed form of ~ preqr1 . (Contributed by AV, 29-Jan-2021.) (Revised by AV, 18-Sep-2021.)
theorem preqr1g (A2 B2 C V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wi (wceq (cpr A2 C) (cpr B2 C)) (wceq A2 B2)) $;

--| Closed form of ~ preq12b . (Contributed by Scott Fenton, 28-Mar-2014.)
theorem preq12bg (A2 B2 C D V W X Y: class):
  $ wi (wa (wa (wcel A2 V) (wcel B2 W)) (wa (wcel C X) (wcel D Y))) (wb (wceq (cpr A2 B2) (cpr C D)) (wo (wa (wceq A2 C) (wceq B2 D)) (wa (wceq A2 D) (wceq B2 C)))) $;

--| Two pairs are not equal if at least one element of the first pair is not contained in the second pair. (Contributed by Alexander van der Vekens, 13-Aug-2017.)
theorem prneimg (A2 B2 C D U V X Y: class):
  $ wi (wa (wa (wcel A2 U) (wcel B2 V)) (wa (wcel C X) (wcel D Y))) (wi (wo (wa (wne A2 C) (wne A2 D)) (wa (wne B2 C) (wne B2 D))) (wne (cpr A2 B2) (cpr C D))) $;

--| Two pairs are not equal if their counterparts are not equal. (Contributed by AV, 5-Sep-2025.)
theorem prneimg2 (A2 B2 C D U V X Y: class):
  $ wi (wa (wa (wcel A2 U) (wcel B2 V)) (wa (wcel C X) (wcel D Y))) (wb (wne (cpr A2 B2) (cpr C D)) (wa (wo (wne A2 C) (wne B2 D)) (wo (wne A2 D) (wne B2 C)))) $;

--| A (proper) pair is not equal to another (maybe improper) pair if and only if an element of the first pair is not contained in the second pair. (Contributed by Alexander van der Vekens, 16-Jan-2018.)
theorem prnebg (A2 B2 C D U V X Y: class):
  $ wi (w3a (wa (wcel A2 U) (wcel B2 V)) (wa (wcel C X) (wcel D Y)) (wne A2 B2)) (wb (wo (wa (wne A2 C) (wne A2 D)) (wa (wne B2 C) (wne B2 D))) (wne (cpr A2 B2) (cpr C D))) $;

--| A (proper) pair is equal to another (maybe improper) pair containing one element of the first pair if and only if the other element of the first pair is contained in the second pair. (Contributed by Alexander van der Vekens, 26-Jan-2018.)
theorem pr1eqbg (A2 B2 C U V X: class):
  $ wi (wa (w3a (wcel A2 U) (wcel B2 V) (wcel C X)) (wne A2 B2)) (wb (wceq A2 C) (wceq (cpr A2 B2) (cpr B2 C))) $;

--| A (proper) pair is not equal to another (maybe improper) pair containing one element of the first pair if and only if the other element of the first pair is not contained in the second pair. (Contributed by Alexander van der Vekens, 26-Jan-2018.)
theorem pr1nebg (A2 B2 C U V X: class):
  $ wi (wa (w3a (wcel A2 U) (wcel B2 V) (wcel C X)) (wne A2 B2)) (wb (wne A2 C) (wne (cpr A2 B2) (cpr B2 C))) $;

--| Equivalence for a pair equal to a singleton, deduction form. (Contributed by Thierry Arnoux, 27-Dec-2016.) (Revised by AV, 13-Jun-2022.) (Revised by AV, 16-Aug-2024.)
theorem preqsnd (ph: wff) (A2 B2 C V W: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wb (wceq (cpr A2 B2) (csn C)) (wa (wceq A2 C) (wceq B2 C))) $;

--| A proper unordered pair is not a (proper or improper) singleton. (Contributed by AV, 13-Jun-2022.)
theorem prnesn (A2 B2 C V W: class):
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wne A2 B2)) (wne (cpr A2 B2) (csn C)) $;

--| A proper unordered pair is not an improper unordered pair. (Contributed by AV, 13-Jun-2022.)
theorem prneprprc (A2 B2 C D V W: class):
  $ wi (wa (w3a (wcel A2 V) (wcel B2 W) (wne A2 B2)) (wn (wcel C cvv))) (wne (cpr A2 B2) (cpr C D)) $;

--| Equivalence for a pair equal to a singleton. (Contributed by NM, 3-Jun-2008.) (Revised by AV, 12-Jun-2022.)
theorem preqsn (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wb (wceq (cpr A2 B2) (csn C)) (wa (wceq A2 B2) (wceq B2 C)) $;

--| Equality relationship for two proper unordered pairs. (Contributed by AV, 12-Jun-2022.)
theorem preq12nebg (A2 B2 C D V W: class):
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wne A2 B2)) (wb (wceq (cpr A2 B2) (cpr C D)) (wo (wa (wceq A2 C) (wceq B2 D)) (wa (wceq A2 D) (wceq B2 C)))) $;

--| Equality of two unordered pairs. (Contributed by NM, 17-Oct-1996.) (Revised by AV, 9-Dec-2018.) (Revised by AV, 12-Jun-2022.)
theorem prel12g (A2 B2 C D V W: class):
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wne A2 B2)) (wb (wceq (cpr A2 B2) (cpr C D)) (wa (wcel A2 (cpr C D)) (wcel B2 (cpr C D)))) $;

--| An unordered pair has the ordered pair property (compare ~ opth ) under certain conditions. Variant of ~ opthpr in closed form. (Contributed by AV, 13-Jun-2022.)
theorem opthprneg (A2 B2 C D V W: class):
  $ wi (wa (wa (wcel A2 V) (wcel B2 W)) (wa (wne A2 B2) (wne A2 D))) (wb (wceq (cpr A2 B2) (cpr C D)) (wa (wceq A2 C) (wceq B2 D))) $;

--| Lemma for ~ elpreqpr . (Contributed by Scott Fenton, 7-Dec-2020.) (Revised by AV, 9-Dec-2020.)
theorem elpreqprlem {x3: setvar} (B2 C: class) (V: class x3):
  $ wi (wcel B2 V) (wex x3 (wceq (cpr B2 C) (cpr B2 (cv x3)))) $;

--| Equality and membership rule for pairs. (Contributed by Scott Fenton, 7-Dec-2020.)
theorem elpreqpr {x3: setvar} (A2 B2 C: class):
  $ wi (wcel A2 (cpr B2 C)) (wex x3 (wceq (cpr B2 C) (cpr A2 (cv x3)))) $;

--| A set is an element of an unordered pair iff there is another (maybe the same) set which is an element of the unordered pair. (Proposed by BJ, 8-Dec-2020.) (Contributed by AV, 9-Dec-2020.)
theorem elpreqprb {x3: setvar} (A2 B2 C V: class):
  $ wi (wcel A2 V) (wb (wcel A2 (cpr B2 C)) (wex x3 (wceq (cpr B2 C) (cpr A2 (cv x3))))) $;

--| For an element ` A ` of an unordered pair which is a subset of a given set ` V ` , there is another (maybe the same) element ` b ` of the given set ` V ` being an element of the unordered pair. (Contributed by AV, 5-Dec-2020.)
theorem elpr2elpr {b: setvar} (A2 V X Y: class):
  $ wi (w3a (wcel X V) (wcel Y V) (wcel A2 (cpr X Y))) (wrex b (wceq (cpr X Y) (cpr A2 (cv b))) V) $;

--| Restricted quantification over the union of a set and a singleton, using implicit substitution. (Contributed by Paul Chapman, 17-Nov-2012.) (Revised by Mario Carneiro, 23-Apr-2015.)
theorem ralunsn {x3: setvar} (ph: wff x3) (ps: wff) (A2: class x3) (B2: class) (C: class x3):
  $ wi (wceq (cv x3) B2) (wb ph ps) $ >
  $ wi (wcel B2 C) (wb (wral x3 ph (cun A2 (csn B2))) (wa (wral x3 ph A2) ps)) $;

--| Double restricted quantification over the union of a set and a singleton, using implicit substitution. (Contributed by Paul Chapman, 17-Nov-2012.)
theorem _2ralunsn {x3 y1: setvar} (ph: wff x3 y1) (ps: wff x3) (ch th: wff y1) (A2: class y1) (B2: class) (C: class y1):
  $ wi (wceq (cv x3) B2) (wb ph ch) $ >
  $ wi (wceq (cv y1) B2) (wb ph ps) $ >
  $ wi (wceq (cv x3) B2) (wb ps th) $ >
  $ wi (wcel B2 C) (wb (wral x3 (wral y1 ph (cun A2 (csn B2))) (cun A2 (csn B2))) (wa (wa (wral x3 (wral y1 ph A2) A2) (wral x3 ps A2)) (wa (wral y1 ch A2) th))) $;

--| The power set of a singleton. (Contributed by NM, 5-Jun-2006.)
theorem pwsn (A2: class):
  $ wceq (cpw (csn A2)) (cpr c0 (csn A2)) $;

--| The power set of an unordered pair. (Contributed by NM, 1-May-2009.)
theorem pwpr (A2 B2: class):
  $ wceq (cpw (cpr A2 B2)) (cun (cpr c0 (csn A2)) (cpr (csn B2) (cpr A2 B2))) $;

--| The power set of an unordered triple. (Contributed by Mario Carneiro, 2-Jul-2016.)
theorem pwtp (A2 B2 C: class):
  $ wceq (cpw (ctp A2 B2 C)) (cun (cun (cpr c0 (csn A2)) (cpr (csn B2) (cpr A2 B2))) (cun (cpr (csn C) (cpr A2 C)) (cpr (cpr B2 C) (ctp A2 B2 C)))) $;

--| Compute the power set of the empty set. Theorem 89 of [Suppes] p. 47. (Contributed by NM, 5-Aug-1993.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem pw0:
  $ wceq (cpw c0) (csn c0) $;

--| Compute the power set of the power set of the empty set. (See ~ pw0 for the power set of the empty set.) Theorem 90 of [Suppes] p. 48. Although this theorem is a special case of ~ pwsn , we have chosen to show a direct elementary proof. (Contributed by NM, 7-Aug-1994.) Avoid ~ pwsn . (Proof modification is discouraged.)
theorem pwpw0:
  $ wceq (cpw (csn c0)) (cpr c0 (csn c0)) $;

--| Compute the power set of the power set of the power set of the empty set. (See also ~ pw0 and ~ pwpw0 .) (Contributed by NM, 2-May-2009.)
theorem pwpwpw0:
  $ wceq (cpw (cpr c0 (csn c0))) (cun (cpr c0 (csn c0)) (cpr (csn (csn c0)) (cpr c0 (csn c0)))) $;

--| For an element of a proper unordered pair of elements of a class ` V ` , there is another (different) element of the class ` V ` which is an element of the proper pair. (Contributed by AV, 18-Dec-2021.)
theorem prproe {v: setvar} (A2 B2 C V: class):
  $ wi (w3a (wcel C (cpr A2 B2)) (wne A2 B2) (wa (wcel A2 V) (wcel B2 V))) (wrex v (wcel (cv v) (cpr A2 B2)) (cdif V (csn C))) $;

--| If there are three elements in a proper unordered pair, and two of them are different from the third one, the two must be equal. (Contributed by AV, 19-Dec-2021.)
theorem _3elpr2eq (A2 B2 X Y Z: class):
  $ wi (wa (w3a (wcel X (cpr A2 B2)) (wcel Y (cpr A2 B2)) (wcel Z (cpr A2 B2))) (wa (wne Y X) (wne Z X))) (wceq Y Z) $;

--| Extend class notation to include ordered pair.
term cop (A2 B2: class): class;

--| Definition of an ordered pair, equivalent to Kuratowski's definition ` { { A } , { A , B } } ` when the arguments are sets. Since the behavior of Kuratowski definition is not very useful for proper classes, we define it to be empty in this case (see ~ opprc1 , ~ opprc2 , and ~ 0nelop ). For Kuratowski's actual definition when the arguments are sets, see ~ dfop . For the justifying theorem (for sets) see ~ opth . See ~ dfopif for an equivalent formulation using the ` if ` operation. Definition 9.1 of [Quine] p. 58 defines an ordered pair unconditionally as ` <. A , B >. = { { A } , { A , B } } ` , which has different behavior from our ~ df-op when the arguments are proper classes. Ordinarily this difference is not important, since neither definition is meaningful in that case. Our ~ df-op was chosen because it often makes proofs shorter by eliminating unnecessary sethood hypotheses. There are other ways to define ordered pairs. The basic requirement is that two ordered pairs are equal iff their respective members are equal. In 1914 Norbert Wiener gave the first successful definition ` <. A , B >. `_2 ` = { { { A } , (/) } , { { B } } } ` , justified by ~ opthwiener . This was simplified by Kazimierz Kuratowski in 1921 to our present definition. An even simpler definition ` <. A , B >. `_3 ` = { A , { A , B } } ` is justified by ~ opthreg , but it requires the Axiom of Regularity for its justification and is not commonly used. A definition that also works for proper classes is ` <. A , B >. `_4 ` = ( ( A X. { (/) } ) u. ( B X. { { (/) } } ) ) ` , justified by ~ opthprc . Nearly at the same time as Norbert Wiener, Felix Hausdorff proposed the following definition in "Grundz&uuml;ge der Mengenlehre" ("Basics of Set Theory"), p. 32, in 1914: ` <. A , B >. `_5 ` = { { A , O } , { B , T } } ` . Hausdorff used ` 1 ` and ` 2 ` instead of ` O ` and ` T ` , but actually any two different fixed sets will do (e.g., ` O = (/) ` and ` T = { (/) } ` , see ~ 0nep0 ). Furthermore, Hausdorff demanded that ` O ` and ` T ` are both different from ` A ` as well as ` B ` , which is actually not necessary (at least not in full extent), see ~ opthhausdorff0 and ~ opthhausdorff . If we restrict our sets to nonnegative integers, an ordered pair definition that involves only elementary arithmetic is provided by ~ nn0opthi . An ordered pair of real numbers can also be represented by a complex number as shown by ~ cru . Kuratowski's ordered pair definition is standard for ZFC set theory, but it is very inconvenient to use in New Foundations theory because it is not type-level; a common alternate definition in New Foundations is the definition from [Rosser] p. 281. Since there are other ways to define ordered pairs, we discourage direct use of this definition so that most theorems won't depend on this particular construction; theorems will instead rely on ~ dfopif . (Contributed by NM, 28-May-1995.) (Revised by Mario Carneiro, 26-Apr-2015.) (Avoid depending on this detail.)
axiom df_op {x3: setvar} (A2 B2: class):
  $ wceq (cop A2 B2) (cab x3 (w3a (wcel A2 cvv) (wcel B2 cvv) (wcel (cv x3) (cpr (csn A2) (cpr A2 B2))))) $;

--| Rewrite ~ df-op using ` if ` . When both arguments are sets, it reduces to the standard Kuratowski definition; otherwise, it is defined to be the empty set. Avoid directly depending on this detail so that theorems will not depend on the Kuratowski construction. (Contributed by Mario Carneiro, 26-Apr-2015.) (Avoid depending on this detail.)
theorem dfopif (A2 B2: class):
  $ wceq (cop A2 B2) (cif (wa (wcel A2 cvv) (wcel B2 cvv)) (cpr (csn A2) (cpr A2 B2)) c0) $;

--| Value of the ordered pair when the arguments are sets. (Contributed by Mario Carneiro, 26-Apr-2015.) (Avoid depending on this detail.)
theorem dfopg (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wceq (cop A2 B2) (cpr (csn A2) (cpr A2 B2))) $;

--| Value of an ordered pair when the arguments are sets, with the conclusion corresponding to Kuratowski's original definition. (Contributed by NM, 25-Jun-1998.) (Avoid depending on this detail.)
theorem dfop (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq (cop A2 B2) (cpr (csn A2) (cpr A2 B2)) $;

--| Equality theorem for ordered pairs. (Contributed by NM, 25-Jun-1998.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem opeq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cop A2 C) (cop B2 C)) $;

--| Equality theorem for ordered pairs. (Contributed by NM, 25-Jun-1998.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem opeq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cop C A2) (cop C B2)) $;

--| Equality theorem for ordered pairs. (Contributed by NM, 28-May-1995.)
theorem opeq12 (A2 B2 C D: class):
  $ wi (wa (wceq A2 C) (wceq B2 D)) (wceq (cop A2 B2) (cop C D)) $;

--| Equality inference for ordered pairs. (Contributed by NM, 16-Dec-2006.)
theorem opeq1i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cop A2 C) (cop B2 C) $;

--| Equality inference for ordered pairs. (Contributed by NM, 16-Dec-2006.)
theorem opeq2i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cop C A2) (cop C B2) $;

--| Equality inference for ordered pairs. (Contributed by NM, 16-Dec-2006.) (Proof shortened by Eric Schmidt, 4-Apr-2007.)
theorem opeq12i (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq C D $ >
  $ wceq (cop A2 C) (cop B2 D) $;

--| Equality deduction for ordered pairs. (Contributed by NM, 16-Dec-2006.)
theorem opeq1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cop A2 C) (cop B2 C)) $;

--| Equality deduction for ordered pairs. (Contributed by NM, 16-Dec-2006.)
theorem opeq2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cop C A2) (cop C B2)) $;

--| Equality deduction for ordered pairs. (Contributed by NM, 16-Dec-2006.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem opeq12d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq (cop A2 C) (cop B2 D)) $;

--| Bound-variable hypothesis builder for ordered pairs. (Contributed by NM, 14-Nov-1995.)
theorem nfop {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 (cop A2 B2) $;

--| Deduction version of bound-variable hypothesis builder ~ nfop . This shows how the deduction version of a not-free theorem such as ~ nfop can be created from the corresponding not-free inference theorem. (Contributed by NM, 4-Feb-2008.)
theorem nfopd {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 B2) $ >
  $ wi ph (wnfc x3 (cop A2 B2)) $;

--| Distribution of class substitution over ordered pairs. (Contributed by Drahflow, 25-Sep-2015.) (Revised by Mario Carneiro, 29-Oct-2015.) (Revised by ML, 25-Oct-2020.)
theorem csbopg {x3: setvar} (A2 C D V: class x3):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (cop C D)) (cop (csb x3 A2 C) (csb x3 A2 D))) $;

--| The ordered pair ` <. A , A >. ` in Kuratowski's representation. Closed form of ~ opid . (Contributed by Peter Mazsa, 22-Jul-2019.) (Avoid depending on this detail.)
theorem opidg (A2 V: class):
  $ wi (wcel A2 V) (wceq (cop A2 A2) (csn (csn A2))) $;

--| The ordered pair ` <. A , A >. ` in Kuratowski's representation. Inference form of ~ opidg . (Contributed by FL, 28-Dec-2011.) (Proof shortened by AV, 16-Feb-2022.) (Avoid depending on this detail.)
theorem opid (A2: class):
  $ wcel A2 cvv $ >
  $ wceq (cop A2 A2) (csn (csn A2)) $;

--| Expansion of an ordered pair when either member is a proper class. (Contributed by Mario Carneiro, 26-Apr-2015.)
theorem opprc (A2 B2: class):
  $ wi (wn (wa (wcel A2 cvv) (wcel B2 cvv))) (wceq (cop A2 B2) c0) $;

--| Expansion of an ordered pair when the first member is a proper class. See also ~ opprc . (Contributed by NM, 10-Apr-2004.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem opprc1 (A2 B2: class):
  $ wi (wn (wcel A2 cvv)) (wceq (cop A2 B2) c0) $;

--| Expansion of an ordered pair when the second member is a proper class. See also ~ opprc . (Contributed by NM, 15-Nov-1994.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem opprc2 (A2 B2: class):
  $ wi (wn (wcel B2 cvv)) (wceq (cop A2 B2) c0) $;

--| If an ordered pair has an element, then its arguments are sets. (Contributed by Mario Carneiro, 26-Apr-2015.)
theorem oprcl (A2 B2 C: class):
  $ wi (wcel C (cop A2 B2)) (wa (wcel A2 cvv) (wcel B2 cvv)) $;

--| Extend class notation to include ordered triple.
term cotp (A2 B2 C: class): class;

--| Define ordered triple of classes. Definition of ordered triple in [Stoll] p. 25. (Contributed by NM, 3-Apr-2015.)
axiom df_ot (A2 B2 C: class):
  $ wceq (cotp A2 B2 C) (cop (cop A2 B2) C) $;

--| Equality theorem for ordered triples. (Contributed by NM, 3-Apr-2015.)
theorem oteq1 (A2 B2 C D: class):
  $ wi (wceq A2 B2) (wceq (cotp A2 C D) (cotp B2 C D)) $;

--| Equality theorem for ordered triples. (Contributed by NM, 3-Apr-2015.)
theorem oteq2 (A2 B2 C D: class):
  $ wi (wceq A2 B2) (wceq (cotp C A2 D) (cotp C B2 D)) $;

--| Equality theorem for ordered triples. (Contributed by NM, 3-Apr-2015.)
theorem oteq3 (A2 B2 C D: class):
  $ wi (wceq A2 B2) (wceq (cotp C D A2) (cotp C D B2)) $;

--| Equality deduction for ordered triples. (Contributed by Mario Carneiro, 11-Jan-2017.)
theorem oteq1d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cotp A2 C D) (cotp B2 C D)) $;

--| Equality deduction for ordered triples. (Contributed by Mario Carneiro, 11-Jan-2017.)
theorem oteq2d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cotp C A2 D) (cotp C B2 D)) $;

--| Equality deduction for ordered triples. (Contributed by Mario Carneiro, 11-Jan-2017.)
theorem oteq3d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cotp C D A2) (cotp C D B2)) $;

--| Equality deduction for ordered triples. (Contributed by Mario Carneiro, 11-Jan-2017.)
theorem oteq123d (ph: wff) (A2 B2 C D E F: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq E F) $ >
  $ wi ph (wceq (cotp A2 C E) (cotp B2 D F)) $;

--| Extend class notation to include the union of a class. Read: "union (of) ` A ` ".
term cuni (A2: class): class;

--| Define the union of a class i.e. the collection of all members of the members of the class. Definition 5.5 of [TakeutiZaring] p. 16. For example, ` U. { { 1 , 3 } , { 1 , 8 } } = { 1 , 3 , 8 } ` ( ~ ex-uni ). This is similar to the union of two classes ~ df-un . (Contributed by NM, 23-Aug-1993.)
axiom df_uni {x3 y1: setvar} (A2: class):
  $ wceq (cuni A2) (cab x3 (wex y1 (wa (wcel (cv x3) (cv y1)) (wcel (cv y1) A2)))) $;

--| Alternate definition of class union. (Contributed by NM, 28-Jun-1998.)
theorem dfuni2 {x3 y1: setvar} (A2: class):
  $ wceq (cuni A2) (cab x3 (wrex y1 (wcel (cv x3) (cv y1)) A2)) $;

--| Membership in class union. (Contributed by NM, 22-May-1994.)
theorem eluni {x3: setvar} (A2 B2: class):
  $ wb (wcel A2 (cuni B2)) (wex x3 (wa (wcel A2 (cv x3)) (wcel (cv x3) B2))) $;

--| Membership in class union. Restricted quantifier version. (Contributed by NM, 31-Aug-1999.)
theorem eluni2 {x3: setvar} (A2 B2: class):
  $ wb (wcel A2 (cuni B2)) (wrex x3 (wcel A2 (cv x3)) B2) $;

--| Membership in class union. (Contributed by NM, 24-Mar-1995.)
theorem elunii (A2 B2 C: class):
  $ wi (wa (wcel A2 B2) (wcel B2 C)) (wcel A2 (cuni C)) $;

--| Deduction version of ~ nfuni . (Contributed by NM, 18-Feb-2013.)
theorem nfunid {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 (cuni A2)) $;

--| Bound-variable hypothesis builder for union. (Contributed by NM, 30-Dec-1996.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem nfuni {x3: setvar} (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 (cuni A2) $;

--| Subclass relationship for class union. Theorem 61 of [Suppes] p. 39. (Contributed by NM, 22-Mar-1998.) (Proof shortened by Andrew Salmon, 29-Jun-2011.)
theorem uniss (A2 B2: class):
  $ wi (wss A2 B2) (wss (cuni A2) (cuni B2)) $;

--| Subclass relationship for subclass union. Inference form of ~ uniss . (Contributed by David Moews, 1-May-2017.)
theorem unissi (A2 B2: class):
  $ wss A2 B2 $ >
  $ wss (cuni A2) (cuni B2) $;

--| Subclass relationship for subclass union. Deduction form of ~ uniss . (Contributed by David Moews, 1-May-2017.)
theorem unissd (ph: wff) (A2 B2: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wss (cuni A2) (cuni B2)) $;

--| Equality theorem for class union. Exercise 15 of [TakeutiZaring] p. 18. (Contributed by NM, 10-Aug-1993.) (Proof shortened by Andrew Salmon, 29-Jun-2011.) (Proof shortened by BJ, 13-Apr-2024.)
theorem unieq (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (cuni A2) (cuni B2)) $;

--| Inference of equality of two class unions. (Contributed by NM, 30-Aug-1993.)
theorem unieqi (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wceq (cuni A2) (cuni B2) $;

--| Deduction of equality of two class unions. (Contributed by NM, 21-Apr-1995.)
theorem unieqd (ph: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cuni A2) (cuni B2)) $;

--| Membership in union of a class abstraction. (Contributed by NM, 11-Aug-1994.) (Revised by Mario Carneiro, 14-Nov-2016.)
theorem eluniab {x3: setvar} (ph: wff x3) (A2: class):
  $ wb (wcel A2 (cuni (cab x3 ph))) (wex x3 (wa (wcel A2 (cv x3)) ph)) $;

--| Membership in union of a class abstraction. (Contributed by NM, 4-Oct-2006.)
theorem elunirab {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3):
  $ wb (wcel A2 (cuni (crab x3 ph B2))) (wrex x3 (wa (wcel A2 (cv x3)) ph) B2) $;

--| The union of a pair is the union of its members. Proposition 5.7 of [TakeutiZaring] p. 16. (Contributed by NM, 25-Aug-2006.) Avoid using ~ unipr to prove it from ~ uniprg . (Revised by BJ, 1-Sep-2024.)
theorem uniprg (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wceq (cuni (cpr A2 B2)) (cun A2 B2)) $;

--| The union of a pair is the union of its members. Proposition 5.7 of [TakeutiZaring] p. 16. (Contributed by NM, 23-Aug-1993.) (Proof shortened by BJ, 1-Sep-2024.)
theorem unipr (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq (cuni (cpr A2 B2)) (cun A2 B2) $;

--| A set equals the union of its singleton. Theorem 8.2 of [Quine] p. 53. (Contributed by NM, 13-Aug-2002.)
theorem unisng (A2 V: class):
  $ wi (wcel A2 V) (wceq (cuni (csn A2)) A2) $;

--| A set equals the union of its singleton. Theorem 8.2 of [Quine] p. 53. (Contributed by NM, 30-Aug-1993.)
theorem unisn (A2: class):
  $ wcel A2 cvv $ >
  $ wceq (cuni (csn A2)) A2 $;

--| A set equals the union of its singleton (setvar case). (Contributed by NM, 30-Aug-1993.)
theorem unisnv {x3: setvar}:
  $ wceq (cuni (csn (cv x3))) (cv x3) $;

--| Union of a singleton in the form of a restricted class abstraction. (Contributed by NM, 3-Jul-2008.)
theorem unisn3 {x3: setvar} (A2 B2: class):
  $ wi (wcel A2 B2) (wceq (cuni (crab x3 (wceq (cv x3) A2) B2)) A2) $;

--| An alternative statement of the effective freeness of a class ` A ` , when it is a set. (Contributed by Mario Carneiro, 14-Oct-2016.) (Proof shortened by JJ, 26-Jul-2021.)
theorem dfnfc2 {x3 y1: setvar} (A2: class x3) (V: class x3 y1):
  $ wi (wal x3 (wcel A2 V)) (wb (wnfc x3 A2) (wal y1 (wnf x3 (wceq (cv y1) A2)))) $;

--| The class union of the union of two classes. Theorem 8.3 of [Quine] p. 53. (Contributed by NM, 20-Aug-1993.)
theorem uniun (A2 B2: class):
  $ wceq (cuni (cun A2 B2)) (cun (cuni A2) (cuni B2)) $;

--| The class union of the intersection of two classes. Exercise 4.12(n) of [Mendelson] p. 235. See ~ uniinqs for a condition where equality holds. (Contributed by NM, 4-Dec-2003.) (Proof shortened by Andrew Salmon, 29-Jun-2011.) (Proof shortened by Umit Teoman Dogan, 10-Jun-2026.)
theorem uniin (A2 B2: class):
  $ wss (cuni (cin A2 B2)) (cin (cuni A2) (cuni B2)) $;

--| Obsolete version of ~ uniin as of 10-Jun-2026. (Contributed by NM, 4-Dec-2003.) (Proof shortened by Andrew Salmon, 29-Jun-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem uniinOLD (A2 B2: class):
  $ wss (cuni (cin A2 B2)) (cin (cuni A2) (cuni B2)) $;

--| Subclass relationship for class union. (Contributed by NM, 24-May-1994.) (Proof shortened by Andrew Salmon, 29-Jun-2011.) (Proof shortened by JJ, 26-Jul-2021.)
theorem ssuni (A2 B2 C: class):
  $ wi (wa (wss A2 B2) (wcel B2 C)) (wss A2 (cuni C)) $;

--| The union of a set is empty iff the set is included in the singleton of the empty set. (Contributed by NM, 12-Sep-2004.)
theorem uni0b (A2: class):
  $ wb (wceq (cuni A2) c0) (wss A2 (csn c0)) $;

--| The union of a set is empty iff all of its members are empty. (Contributed by NM, 16-Aug-2006.)
theorem uni0c {x3: setvar} (A2: class):
  $ wb (wceq (cuni A2) c0) (wral x3 (wceq (cv x3) c0) A2) $;

--| The union of the empty set is the empty set. Theorem 8.7 of [Quine] p. 54. (Contributed by NM, 16-Sep-1993.) Remove use of ~ ax-nul . (Revised by Eric Schmidt, 4-Apr-2007.) Avoid ~ ax-11 . (Revised by TM, 1-Feb-2026.)
theorem uni0:
  $ wceq (cuni c0) c0 $;

--| Obsolete version of ~ uni0 as of 1-Feb-2026. (Contributed by NM, 16-Sep-1993.) Remove use of ~ ax-nul . (Revised by Eric Schmidt, 4-Apr-2007.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem uni0OLD:
  $ wceq (cuni c0) c0 $;

--| Distribute proper substitution through the union of a class. (Contributed by Alan Sare, 10-Nov-2012.) (Revised by NM, 22-Aug-2018.)
theorem csbuni {x3: setvar} (A2 B2: class x3):
  $ wceq (csb x3 A2 (cuni B2)) (cuni (csb x3 A2 B2)) $;

--| An element of a class is a subclass of its union. Theorem 8.6 of [Quine] p. 54. Also the basis for Proposition 7.20 of [TakeutiZaring] p. 40. (Contributed by NM, 6-Jun-1994.)
theorem elssuni (A2 B2: class):
  $ wi (wcel A2 B2) (wss A2 (cuni B2)) $;

--| Condition turning a subclass relationship for union into an equality. (Contributed by NM, 18-Jul-2006.)
theorem unissel (A2 B2: class):
  $ wi (wa (wss (cuni A2) B2) (wcel B2 A2)) (wceq (cuni A2) B2) $;

--| Relationship involving membership, subset, and union. Exercise 5 of [Enderton] p. 26 and its converse. (Contributed by NM, 20-Sep-2003.) Avoid ~ ax-11 . (Revised by BTernaryTau, 28-Dec-2024.)
theorem unissb {x3: setvar} (A2 B2: class):
  $ wb (wss (cuni A2) B2) (wral x3 (wss (cv x3) B2) A2) $;

--| A subclass condition on the members of two classes that implies a subclass relation on their unions. Proposition 8.6 of [TakeutiZaring] p. 59. See ~ iunss2 for a generalization to indexed unions. (Contributed by NM, 22-Mar-2004.)
theorem uniss2 {x3 y1: setvar} (A2: class y1) (B2: class):
  $ wi (wral x3 (wrex y1 (wss (cv x3) (cv y1)) B2) A2) (wss (cuni A2) (cuni B2)) $;

--| If the difference ` A \ B ` contains the largest members of ` A ` , then the union of the difference is the union of ` A ` . (Contributed by NM, 22-Mar-2004.)
theorem unidif {x3 y1: setvar} (A2 B2: class):
  $ wi (wral x3 (wrex y1 (wss (cv x3) (cv y1)) (cdif A2 B2)) A2) (wceq (cuni (cdif A2 B2)) (cuni A2)) $;

--| Relationship implying union. (Contributed by NM, 10-Nov-1999.)
theorem ssunieq {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 B2) (wral x3 (wss (cv x3) A2) B2)) (wceq A2 (cuni B2)) $;

--| Any member of a class is the largest of those members that it includes. (Contributed by NM, 13-Aug-2002.)
theorem unimax {x3: setvar} (A2 B2: class):
  $ wi (wcel A2 B2) (wceq (cuni (crab x3 (wss (cv x3) A2) B2)) A2) $;

--| A class is a subclass of the power class of its union. Exercise 6(b) of [Enderton] p. 38. (Contributed by NM, 14-Oct-1996.)
theorem pwuni (A2: class):
  $ wss A2 (cpw (cuni A2)) $;

--| Extend class notation to include the intersection of a class. Read: "intersection (of) ` A ` ".
term cint (A2: class): class;

--| Define the intersection of a class. Definition 7.35 of [TakeutiZaring] p. 44. For example, ` |^| { { 1 , 3 } , { 1 , 8 } } = { 1 } ` . Compare this with the intersection of two classes, ~ df-in . (Contributed by NM, 18-Aug-1993.)
axiom df_int {x3 y1: setvar} (A2: class):
  $ wceq (cint A2) (cab x3 (wal y1 (wi (wcel (cv y1) A2) (wcel (cv x3) (cv y1))))) $;

--| Alternate definition of class intersection. (Contributed by NM, 28-Jun-1998.)
theorem dfint2 {x3 y1: setvar} (A2: class):
  $ wceq (cint A2) (cab x3 (wral y1 (wcel (cv x3) (cv y1)) A2)) $;

--| Equality law for intersection. (Contributed by NM, 13-Sep-1999.)
theorem inteq (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (cint A2) (cint B2)) $;

--| Equality inference for class intersection. (Contributed by NM, 2-Sep-2003.)
theorem inteqi (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wceq (cint A2) (cint B2) $;

--| Equality deduction for class intersection. (Contributed by NM, 2-Sep-2003.)
theorem inteqd (ph: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cint A2) (cint B2)) $;

--| Membership in class intersection. (Contributed by NM, 21-May-1994.)
theorem elint {x3: setvar} (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 (cint B2)) (wal x3 (wi (wcel (cv x3) B2) (wcel A2 (cv x3)))) $;

--| Membership in class intersection. (Contributed by NM, 14-Oct-1999.)
theorem elint2 {x3: setvar} (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 (cint B2)) (wral x3 (wcel A2 (cv x3)) B2) $;

--| Membership in class intersection, with the sethood requirement expressed as an antecedent. (Contributed by NM, 20-Nov-2003.) (Proof shortened by JJ, 26-Jul-2021.)
theorem elintg {x3: setvar} (A2 B2: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wcel A2 (cint B2)) (wral x3 (wcel A2 (cv x3)) B2)) $;

--| Membership in class intersection. (Contributed by NM, 14-Oct-1999.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem elinti (A2 B2 C: class):
  $ wi (wcel A2 (cint B2)) (wi (wcel C B2) (wcel A2 C)) $;

--| Bound-variable hypothesis builder for intersection. (Contributed by NM, 2-Feb-1997.) (Proof shortened by Andrew Salmon, 12-Aug-2011.)
theorem nfint {x3: setvar} (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 (cint A2) $;

--| Two ways of saying a set is an element of the intersection of a class. (Contributed by NM, 30-Aug-1993.) Put in closed form. (Revised by RP, 13-Aug-2020.)
theorem elintabg {x3: setvar} (ph: wff x3) (A2: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wcel A2 (cint (cab x3 ph))) (wal x3 (wi ph (wcel A2 (cv x3))))) $;

--| Membership in the intersection of a class abstraction. (Contributed by NM, 30-Aug-1993.)
theorem elintab {x3: setvar} (ph: wff x3) (A2: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 (cint (cab x3 ph))) (wal x3 (wi ph (wcel A2 (cv x3)))) $;

--| Membership in the intersection of a class abstraction. (Contributed by NM, 17-Oct-1999.)
theorem elintrab {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 (cint (crab x3 ph B2))) (wral x3 (wi ph (wcel A2 (cv x3))) B2) $;

--| Membership in the intersection of a class abstraction. (Contributed by NM, 17-Feb-2007.)
theorem elintrabg {x3: setvar} (ph: wff x3) (A2: class) (B2 V: class x3):
  $ wi (wcel A2 V) (wb (wcel A2 (cint (crab x3 ph B2))) (wral x3 (wi ph (wcel A2 (cv x3))) B2)) $;

--| The intersection of the empty set is the universal class. Exercise 2 of [TakeutiZaring] p. 44. (Contributed by NM, 18-Aug-1993.) (Proof shortened by JJ, 26-Jul-2021.)
theorem int0:
  $ wceq (cint c0) cvv $;

--| An element of a class includes the intersection of the class. Exercise 4 of [TakeutiZaring] p. 44 (with correction), generalized to classes. (Contributed by NM, 18-Nov-1995.)
theorem intss1 (A2 B2: class):
  $ wi (wcel A2 B2) (wss (cint B2) A2) $;

--| Subclass of a class intersection. Theorem 5.11(viii) of [Monk1] p. 52 and its converse. (Contributed by NM, 14-Oct-1999.)
theorem ssint {x3: setvar} (A2 B2: class):
  $ wb (wss A2 (cint B2)) (wral x3 (wss A2 (cv x3)) B2) $;

--| Subclass of the intersection of a class abstraction. (Contributed by NM, 31-Jul-2006.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem ssintab {x3: setvar} (ph: wff x3) (A2: class):
  $ wb (wss A2 (cint (cab x3 ph))) (wal x3 (wi ph (wss A2 (cv x3)))) $;

--| Subclass of the least upper bound. (Contributed by NM, 8-Aug-2000.)
theorem ssintub {x3: setvar} (A2 B2: class):
  $ wss A2 (cint (crab x3 (wss A2 (cv x3)) B2)) $;

--| Subclass of the minimum value of class of supersets. (Contributed by NM, 10-Aug-2006.)
theorem ssmin {x3: setvar} (ph: wff x3) (A2: class):
  $ wss A2 (cint (cab x3 (wa (wss A2 (cv x3)) ph))) $;

--| Any member of a class is the smallest of those members that include it. (Contributed by NM, 13-Aug-2002.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem intmin {x3: setvar} (A2 B2: class):
  $ wi (wcel A2 B2) (wceq (cint (crab x3 (wss A2 (cv x3)) B2)) A2) $;

--| Intersection of subclasses. (Contributed by NM, 14-Oct-1999.) (Proof shortened by OpenAI, 25-Mar-2020.)
theorem intss (A2 B2: class):
  $ wi (wss A2 B2) (wss (cint B2) (cint A2)) $;

--| The intersection of a nonempty set is a subclass of its union. (Contributed by NM, 29-Jul-2006.)
theorem intssuni (A2: class):
  $ wi (wne A2 c0) (wss (cint A2) (cuni A2)) $;

--| Subclass of the intersection of a restricted class abstraction. (Contributed by NM, 30-Jan-2015.)
theorem ssintrab {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3):
  $ wb (wss A2 (cint (crab x3 ph B2))) (wral x3 (wi ph (wss A2 (cv x3))) B2) $;

--| If the union of a class is included in its intersection, the class is either the empty set or a singleton ( ~ uniintsn ). (Contributed by NM, 30-Oct-2010.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem unissint (A2: class):
  $ wb (wss (cuni A2) (cint A2)) (wo (wceq A2 c0) (wceq (cuni A2) (cint A2))) $;

--| Subclass relationship for intersection and union. (Contributed by NM, 29-Jul-2006.)
theorem intssuni2 (A2 B2: class):
  $ wi (wa (wss A2 B2) (wne A2 c0)) (wss (cint A2) (cuni B2)) $;

--| Under subset ordering, the intersection of a restricted class abstraction is less than or equal to any of its members. (Contributed by NM, 7-Sep-2013.)
theorem intminss {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wa (wcel A2 B2) ps) (wss (cint (crab x3 ph B2)) A2) $;

--| Any set is the smallest of all sets that include it. (Contributed by NM, 20-Sep-2003.)
theorem intmin2 {x3: setvar} (A2: class):
  $ wcel A2 cvv $ >
  $ wceq (cint (cab x3 (wss A2 (cv x3)))) A2 $;

--| Under subset ordering, the intersection of a class abstraction is less than or equal to any of its members. (Contributed by NM, 3-Jul-2005.)
theorem intmin3 {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (V: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ ps $ >
  $ wi (wcel A2 V) (wss (cint (cab x3 ph)) A2) $;

--| Elimination of a conjunct in a class intersection. (Contributed by NM, 31-Jul-2006.)
theorem intmin4 {x3: setvar} (ph: wff x3) (A2: class):
  $ wi (wss A2 (cint (cab x3 ph))) (wceq (cint (cab x3 (wa (wss A2 (cv x3)) ph))) (cint (cab x3 ph))) $;

--| The intersection of a special case of a class abstraction. ` y ` may be free in ` ph ` and ` A ` , which can be thought of a ` ph ( y ) ` and ` A ( y ) ` . Typically, ~ abrexex2 or ~ abexssex can be used to satisfy the second hypothesis. (Contributed by NM, 28-Jul-2006.) (Proof shortened by Mario Carneiro, 14-Nov-2016.)
theorem intab {x3 y1: setvar} (ph: wff y1) (A2: class y1):
  $ wcel A2 cvv $ >
  $ wcel (cab x3 (wex y1 (wa ph (wceq (cv x3) A2)))) cvv $ >
  $ wceq (cint (cab x3 (wal y1 (wi ph (wcel A2 (cv x3)))))) (cab x3 (wex y1 (wa ph (wceq (cv x3) A2)))) $;

--| The intersection of a class containing the empty set is empty. (Contributed by NM, 24-Apr-2004.)
theorem int0el (A2: class):
  $ wi (wcel c0 A2) (wceq (cint A2) c0) $;

--| The class intersection of the union of two classes. Theorem 78 of [Suppes] p. 42. (Contributed by NM, 22-Sep-2002.)
theorem intun (A2 B2: class):
  $ wceq (cint (cun A2 B2)) (cin (cint A2) (cint B2)) $;

--| The intersection of a pair is the intersection of its members. Closed form of ~ intpr . Theorem 71 of [Suppes] p. 42. (Contributed by FL, 27-Apr-2008.) (Proof shortened by BJ, 1-Sep-2024.)
theorem intprg (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wceq (cint (cpr A2 B2)) (cin A2 B2)) $;

--| The intersection of a pair is the intersection of its members. Theorem 71 of [Suppes] p. 42. (Contributed by NM, 14-Oct-1999.) Prove from ~ intprg . (Revised by BJ, 1-Sep-2024.)
theorem intpr (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq (cint (cpr A2 B2)) (cin A2 B2) $;

--| Intersection of a singleton. (Contributed by Stefan O'Rear, 22-Feb-2015.)
theorem intsng (A2 V: class):
  $ wi (wcel A2 V) (wceq (cint (csn A2)) A2) $;

--| The intersection of a singleton is its member. Theorem 70 of [Suppes] p. 41. (Contributed by NM, 29-Sep-2002.)
theorem intsn (A2: class):
  $ wcel A2 cvv $ >
  $ wceq (cint (csn A2)) A2 $;

--| Two ways to express " ` A ` is a singleton". See also ~ en1 , ~ en1b , ~ card1 , and ~ eusn . (Contributed by NM, 2-Aug-2010.)
theorem uniintsn {x3: setvar} (A2: class):
  $ wb (wceq (cuni A2) (cint A2)) (wex x3 (wceq A2 (csn (cv x3)))) $;

--| The union and the intersection of a class abstraction are equal exactly when there is a unique satisfying value of ` ph ( x ) ` . (Contributed by Mario Carneiro, 24-Dec-2016.)
theorem uniintab {x3: setvar} (ph: wff x3):
  $ wb (weu x3 ph) (wceq (cuni (cab x3 ph)) (cint (cab x3 ph))) $;

--| Theorem joining a singleton to an intersection. (Contributed by NM, 29-Sep-2002.)
theorem intunsn (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wceq (cint (cun A2 (csn B2))) (cin (cint A2) B2) $;

--| Relative intersection of an empty set. (Contributed by Stefan O'Rear, 3-Apr-2015.)
theorem rint0 (A2 X: class):
  $ wi (wceq X c0) (wceq (cin A2 (cint X)) A2) $;

--| Membership in a restricted intersection. (Contributed by Stefan O'Rear, 3-Apr-2015.)
theorem elrint {y1: setvar} (A2: class y1) (B2 X: class):
  $ wb (wcel X (cin A2 (cint B2))) (wa (wcel X A2) (wral y1 (wcel X (cv y1)) B2)) $;

--| Membership in a restricted intersection. (Contributed by Stefan O'Rear, 3-Apr-2015.)
theorem elrint2 {y1: setvar} (A2: class y1) (B2 X: class):
  $ wi (wcel X A2) (wb (wcel X (cin A2 (cint B2))) (wral y1 (wcel X (cv y1)) B2)) $;

--| Extend class notation to include indexed union. Note: Historically (prior to 21-Oct-2005), set.mm used the notation ` U. x e. A B ` , with the same union symbol as ~ cuni . While that syntax was unambiguous, it did not allow for LALR parsing of the syntax constructions in set.mm. The new syntax uses a distinguished symbol ` U_ ` instead of ` U. ` and does allow LALR parsing. Thanks to Peter Backes for suggesting this change.
term ciun {x3: setvar} (A2 B2: class x3): class;

--| Extend class notation to include indexed intersection. Note: Historically (prior to 21-Oct-2005), set.mm used the notation ` |^| x e. A B ` , with the same intersection symbol as ~ cint . Although that syntax was unambiguous, it did not allow for LALR parsing of the syntax constructions in set.mm. The new syntax uses a distinguished symbol ` |^|_ ` instead of ` |^| ` and does allow LALR parsing. Thanks to Peter Backes for suggesting this change.
term ciin {x3: setvar} (A2 B2: class x3): class;

--| Define indexed union. Definition indexed union in [Stoll] p. 45. In most applications, ` A ` is independent of ` x ` (although this is not required by the definition), and ` B ` depends on ` x ` i.e. can be read informally as ` B ( x ) ` . We call ` x ` the index, ` A ` the index set, and ` B ` the indexed set. In most books, ` x e. A ` is written as a subscript or underneath a union symbol ` U. ` . We use a special union symbol ` U_ ` to make it easier to distinguish from plain class union. In many theorems, you will see that ` x ` and ` A ` are in the same distinct variable group (meaning ` A ` cannot depend on ` x ` ) and that ` B ` and ` x ` do not share a distinct variable group (meaning that can be thought of as ` B ( x ) ` i.e. can be substituted with a class expression containing ` x ` ). An alternate definition tying indexed union to ordinary union is ~ dfiun2 . Theorem ~ uniiun provides a definition of ordinary union in terms of indexed union. Theorems ~ fniunfv and ~ funiunfv are useful when ` B ` is a function. (Contributed by NM, 27-Jun-1998.)
axiom df_iun {x3 y1: setvar} (A2 B2: class x3):
  $ wceq (ciun x3 A2 B2) (cab y1 (wrex x3 (wcel (cv y1) B2) A2)) $;

--| Define indexed intersection. Definition of [Stoll] p. 45. See the remarks for its sibling operation of indexed union ~ df-iun . An alternate definition tying indexed intersection to ordinary intersection is ~ dfiin2 . Theorem ~ intiin provides a definition of ordinary intersection in terms of indexed intersection. (Contributed by NM, 27-Jun-1998.)
axiom df_iin {x3 y1: setvar} (A2 B2: class x3):
  $ wceq (ciin x3 A2 B2) (cab y1 (wral x3 (wcel (cv y1) B2) A2)) $;

--| Membership in indexed union. (Contributed by NM, 3-Sep-2003.)
theorem eliun {x3: setvar} (A2: class) (B2 C: class x3):
  $ wb (wcel A2 (ciun x3 B2 C)) (wrex x3 (wcel A2 C) B2) $;

--| Membership in indexed intersection. (Contributed by NM, 3-Sep-2003.)
theorem eliin {x3: setvar} (A2: class) (B2 C V: class x3):
  $ wi (wcel A2 V) (wb (wcel A2 (ciin x3 B2 C)) (wral x3 (wcel A2 C) B2)) $;

--| Membership in an indexed union, one way. (Contributed by JJ, 27-Jul-2021.)
theorem eliuni {x3: setvar} (A2: class) (B2: class x3) (C D E: class):
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wi (wa (wcel A2 D) (wcel E C)) (wcel E (ciun x3 D B2)) $;

--| Membership in indexed union. (Contributed by Glauco Siliprandi, 15-Feb-2025.)
theorem eliund {x3: setvar} (ph: wff x3) (A2: class) (B2 C: class x3):
  $ wi ph (wrex x3 (wcel A2 C) B2) $ >
  $ wi ph (wcel A2 (ciun x3 B2 C)) $;

--| Commutation of indexed unions. (Contributed by NM, 18-Dec-2008.)
theorem iuncom {x3 y1: setvar} (A2: class x3) (B2: class y1) (C: class x3 y1):
  $ wceq (ciun x3 A2 (ciun y1 B2 C)) (ciun y1 B2 (ciun x3 A2 C)) $;

--| Commutation of union with indexed union. (Contributed by Mario Carneiro, 18-Jan-2014.)
theorem iuncom4 {x3: setvar} (A2 B2: class x3):
  $ wceq (ciun x3 A2 (cuni B2)) (cuni (ciun x3 A2 B2)) $;

--| Indexed union of a constant class, i.e. where ` B ` does not depend on ` x ` . (Contributed by NM, 5-Sep-2004.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem iunconst {x3: setvar} (A2 B2: class):
  $ wi (wne A2 c0) (wceq (ciun x3 A2 B2) B2) $;

--| Indexed intersection of a constant class, i.e. where ` B ` does not depend on ` x ` . (Contributed by Mario Carneiro, 6-Feb-2015.)
theorem iinconst {x3: setvar} (A2 B2: class):
  $ wi (wne A2 c0) (wceq (ciin x3 A2 B2) B2) $;

--| Indexed union of identical classes. (Contributed by AV, 5-Mar-2024.)
theorem iuneqconst {x3: setvar} (A2: class) (B2: class x3) (C X: class):
  $ wi (wceq (cv x3) X) (wceq B2 C) $ >
  $ wi (wa (wcel X A2) (wral x3 (wceq B2 C) A2)) (wceq (ciun x3 A2 B2) C) $;

--| Law combining indexed union with indexed intersection. Eq. 14 in [KuratowskiMostowski] p. 109. This theorem also appears as the last example at ~ http://en.wikipedia.org/wiki/Union%5F%28set%5Ftheory%29 . (Contributed by NM, 17-Aug-2004.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem iuniin {x3 y1: setvar} (A2: class x3) (B2: class y1) (C: class x3 y1):
  $ wss (ciun x3 A2 (ciin y1 B2 C)) (ciin y1 B2 (ciun x3 A2 C)) $;

--| An indexed intersection is a subset of the corresponding indexed union. (Contributed by Thierry Arnoux, 31-Dec-2021.)
theorem iinssiun {x3: setvar} (A2: class) (B2: class x3):
  $ wi (wne A2 c0) (wss (ciin x3 A2 B2) (ciun x3 A2 B2)) $;

--| Subclass theorem for indexed union. (Contributed by NM, 10-Dec-2004.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem iunss1 {x3: setvar} (A2 B2: class) (C: class x3):
  $ wi (wss A2 B2) (wss (ciun x3 A2 C) (ciun x3 B2 C)) $;

--| Subclass theorem for indexed intersection. (Contributed by NM, 24-Jan-2012.)
theorem iinss1 {x3: setvar} (A2 B2: class) (C: class x3):
  $ wi (wss A2 B2) (wss (ciin x3 B2 C) (ciin x3 A2 C)) $;

--| Equality theorem for indexed union. (Contributed by NM, 27-Jun-1998.)
theorem iuneq1 {x3: setvar} (A2 B2: class) (C: class x3):
  $ wi (wceq A2 B2) (wceq (ciun x3 A2 C) (ciun x3 B2 C)) $;

--| Equality theorem for indexed intersection. (Contributed by NM, 27-Jun-1998.)
theorem iineq1 {x3: setvar} (A2 B2: class) (C: class x3):
  $ wi (wceq A2 B2) (wceq (ciin x3 A2 C) (ciin x3 B2 C)) $;

--| Subclass theorem for indexed union. (Contributed by NM, 26-Nov-2003.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem ss2iun {x3: setvar} (A2 B2 C: class x3):
  $ wi (wral x3 (wss B2 C) A2) (wss (ciun x3 A2 B2) (ciun x3 A2 C)) $;

--| Equality theorem for indexed union. (Contributed by NM, 22-Oct-2003.)
theorem iuneq2 {x3: setvar} (A2 B2 C: class x3):
  $ wi (wral x3 (wceq B2 C) A2) (wceq (ciun x3 A2 B2) (ciun x3 A2 C)) $;

--| Equality theorem for indexed intersection. (Contributed by NM, 22-Oct-2003.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem iineq2 {x3: setvar} (A2 B2 C: class x3):
  $ wi (wral x3 (wceq B2 C) A2) (wceq (ciin x3 A2 B2) (ciin x3 A2 C)) $;

--| Equality inference for indexed union. (Contributed by NM, 22-Oct-2003.)
theorem iuneq2i {x3: setvar} (A2 B2 C: class x3):
  $ wi (wcel (cv x3) A2) (wceq B2 C) $ >
  $ wceq (ciun x3 A2 B2) (ciun x3 A2 C) $;

--| Equality inference for indexed intersection. (Contributed by NM, 22-Oct-2003.)
theorem iineq2i {x3: setvar} (A2 B2 C: class x3):
  $ wi (wcel (cv x3) A2) (wceq B2 C) $ >
  $ wceq (ciin x3 A2 B2) (ciin x3 A2 C) $;

--| Equality deduction for indexed intersection. (Contributed by NM, 7-Dec-2011.)
theorem iineq2d {x3: setvar} (ph: wff x3) (A2 B2 C: class x3):
  $ wnf x3 ph $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wceq B2 C) $ >
  $ wi ph (wceq (ciin x3 A2 B2) (ciin x3 A2 C)) $;

--| Equality deduction for indexed union. (Contributed by NM, 3-Aug-2004.)
theorem iuneq2dv {x3: setvar} (ph: wff) (A2 B2 C: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wceq B2 C) $ >
  $ wi ph (wceq (ciun x3 A2 B2) (ciun x3 A2 C)) $;

--| Equality deduction for indexed intersection. (Contributed by NM, 3-Aug-2004.)
theorem iineq2dv {x3: setvar} (ph: wff) (A2 B2 C: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wceq B2 C) $ >
  $ wi ph (wceq (ciin x3 A2 B2) (ciin x3 A2 C)) $;

--| Equality deduction for indexed union, deduction version. (Contributed by Thierry Arnoux, 31-Dec-2016.)
theorem iuneq12df {x3: setvar} (ph: wff x3) (A2 B2 C D: class x3):
  $ wnf x3 ph $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq (ciun x3 A2 C) (ciun x3 B2 D)) $;

--| Equality theorem for indexed union, deduction version. (Contributed by Drahflow, 22-Oct-2015.)
theorem iuneq1d {x3: setvar} (ph: wff x3) (A2 B2: class) (C: class x3):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (ciun x3 A2 C) (ciun x3 B2 C)) $;

--| Equality deduction for indexed union, deduction version. (Contributed by Drahflow, 22-Oct-2015.) Remove DV conditions (Revised by GG, 1-Sep-2025.)
theorem iuneq12d {x3: setvar} (ph: wff) (A2 B2 C D: class x3):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq (ciun x3 A2 C) (ciun x3 B2 D)) $;

--| Equality deduction for indexed union. (Contributed by Drahflow, 22-Oct-2015.)
theorem iuneq2d {x3: setvar} (ph: wff) (A2 B2 C: class x3):
  $ wi ph (wceq B2 C) $ >
  $ wi ph (wceq (ciun x3 A2 B2) (ciun x3 A2 C)) $;

--| Bound-variable hypothesis builder for indexed union. (Contributed by Mario Carneiro, 25-Jan-2014.) Add disjoint variable condition to avoid ~ ax-13 . See ~ nfiung for a less restrictive version requiring more axioms. (Revised by GG, 20-Jan-2024.)
theorem nfiun {x3 y1: setvar} (A2 B2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wnfc y1 B2 $ >
  $ wnfc y1 (ciun x3 A2 B2) $;

--| Bound-variable hypothesis builder for indexed intersection. (Contributed by Mario Carneiro, 25-Jan-2014.) Add disjoint variable condition to avoid ~ ax-13 . See ~ nfiing for a less restrictive version requiring more axioms. (Revised by GG, 20-Jan-2024.)
theorem nfiin {x3 y1: setvar} (A2 B2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wnfc y1 B2 $ >
  $ wnfc y1 (ciin x3 A2 B2) $;

--| Bound-variable hypothesis builder for indexed union. Usage of this theorem is discouraged because it depends on ~ ax-13 . See ~ nfiun for a version with more disjoint variable conditions, but not requiring ~ ax-13 . (Contributed by Mario Carneiro, 25-Jan-2014.) (New usage is discouraged.)
theorem nfiung {x3 y1: setvar} (A2 B2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wnfc y1 B2 $ >
  $ wnfc y1 (ciun x3 A2 B2) $;

--| Bound-variable hypothesis builder for indexed intersection. Usage of this theorem is discouraged because it depends on ~ ax-13 . See ~ nfiin for a version with more disjoint variable conditions, but not requiring ~ ax-13 . (Contributed by Mario Carneiro, 25-Jan-2014.) (New usage is discouraged.)
theorem nfiing {x3 y1: setvar} (A2 B2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wnfc y1 B2 $ >
  $ wnfc y1 (ciin x3 A2 B2) $;

--| Bound-variable hypothesis builder for indexed union. (Contributed by NM, 12-Oct-2003.) Avoid ~ ax-11 , ~ ax-12 . (Revised by SN, 14-May-2025.)
theorem nfiu1 {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 (ciun x3 A2 B2) $;

--| Bound-variable hypothesis builder for indexed intersection. (Contributed by NM, 15-Oct-2003.)
theorem nfii1 {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 (ciin x3 A2 B2) $;

--| Alternate definition of indexed union when ` B ` is a set. Definition 15(a) of [Suppes] p. 44. (Contributed by NM, 23-Mar-2006.) (Proof shortened by Andrew Salmon, 25-Jul-2011.) (Proof shortened by Rohan Ridenour, 11-Aug-2023.) Avoid ~ ax-10 , ~ ax-12 . (Revised by SN, 11-Dec-2024.)
theorem dfiun2g {x3 y1: setvar} (A2 B2: class x3) (C: class x3 y1):
  $ wi (wral x3 (wcel B2 C) A2) (wceq (ciun x3 A2 B2) (cuni (cab y1 (wrex x3 (wceq (cv y1) B2) A2)))) $;

--| Alternate definition of indexed intersection when ` B ` is a set. (Contributed by Jeff Hankins, 27-Aug-2009.)
theorem dfiin2g {x3 y1: setvar} (A2 B2: class x3) (C: class x3 y1):
  $ wi (wral x3 (wcel B2 C) A2) (wceq (ciin x3 A2 B2) (cint (cab y1 (wrex x3 (wceq (cv y1) B2) A2)))) $;

--| Alternate definition of indexed union when ` B ` is a set. Definition 15(a) of [Suppes] p. 44. (Contributed by NM, 27-Jun-1998.) (Revised by David Abernethy, 19-Jun-2012.)
theorem dfiun2 {x3 y1: setvar} (A2 B2: class x3):
  $ wcel B2 cvv $ >
  $ wceq (ciun x3 A2 B2) (cuni (cab y1 (wrex x3 (wceq (cv y1) B2) A2))) $;

--| Alternate definition of indexed intersection when ` B ` is a set. Definition 15(b) of [Suppes] p. 44. (Contributed by NM, 28-Jun-1998.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem dfiin2 {x3 y1: setvar} (A2 B2: class x3):
  $ wcel B2 cvv $ >
  $ wceq (ciin x3 A2 B2) (cint (cab y1 (wrex x3 (wceq (cv y1) B2) A2))) $;

--| Define double indexed union. (Contributed by FL, 6-Nov-2013.)
theorem dfiunv2 {x3 y1 z: setvar} (A2 B2 C: class x3 y1):
  $ wceq (ciun x3 A2 (ciun y1 B2 C)) (cab z (wrex x3 (wrex y1 (wcel (cv z) C) B2) A2)) $;

--| Rule used to change the bound variables in an indexed union, with the substitution specified implicitly by the hypothesis. (Contributed by NM, 26-Mar-2006.) (Revised by Andrew Salmon, 25-Jul-2011.) Add disjoint variable condition to avoid ~ ax-13 . See ~ cbviung for a less restrictive version requiring more axioms. (Revised by GG, 20-Jan-2024.)
theorem cbviun {x3 y1: setvar} (A2: class) (B2 C: class x3 y1):
  $ wnfc y1 B2 $ >
  $ wnfc x3 C $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 C) $ >
  $ wceq (ciun x3 A2 B2) (ciun y1 A2 C) $;

--| Change bound variables in an indexed intersection. (Contributed by Jeff Hankins, 26-Aug-2009.) (Revised by Mario Carneiro, 14-Oct-2016.) Add disjoint variable condition to avoid ~ ax-13 . See ~ cbviing for a less restrictive version requiring more axioms. (Revised by GG, 20-Jan-2024.)
theorem cbviin {x3 y1: setvar} (A2: class) (B2 C: class x3 y1):
  $ wnfc y1 B2 $ >
  $ wnfc x3 C $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 C) $ >
  $ wceq (ciin x3 A2 B2) (ciin y1 A2 C) $;

--| Rule used to change the bound variables in an indexed union, with the substitution specified implicitly by the hypothesis. Usage of this theorem is discouraged because it depends on ~ ax-13 . See ~ cbviun for a version with more disjoint variable conditions, but not requiring ~ ax-13 . (Contributed by NM, 26-Mar-2006.) (Revised by Andrew Salmon, 25-Jul-2011.) (New usage is discouraged.)
theorem cbviung {x3 y1: setvar} (A2: class) (B2 C: class x3 y1):
  $ wnfc y1 B2 $ >
  $ wnfc x3 C $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 C) $ >
  $ wceq (ciun x3 A2 B2) (ciun y1 A2 C) $;

--| Change bound variables in an indexed intersection. Usage of this theorem is discouraged because it depends on ~ ax-13 . See ~ cbviin for a version with more disjoint variable conditions, but not requiring ~ ax-13 . (Contributed by Jeff Hankins, 26-Aug-2009.) (Revised by Mario Carneiro, 14-Oct-2016.) (New usage is discouraged.)
theorem cbviing {x3 y1: setvar} (A2: class) (B2 C: class x3 y1):
  $ wnfc y1 B2 $ >
  $ wnfc x3 C $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 C) $ >
  $ wceq (ciin x3 A2 B2) (ciin y1 A2 C) $;

--| Rule used to change the bound variables in an indexed union, with the substitution specified implicitly by the hypothesis. (Contributed by NM, 15-Sep-2003.) Add disjoint variable condition to avoid ~ ax-13 . See ~ cbviunvg for a less restrictive version requiring more axioms. (Revised by GG, 14-Aug-2025.)
theorem cbviunv {x3 y1: setvar} (A2: class) (B2: class x3) (C: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 C) $ >
  $ wceq (ciun x3 A2 B2) (ciun y1 A2 C) $;

--| Change bound variables in an indexed intersection. (Contributed by Jeff Hankins, 26-Aug-2009.) Add disjoint variable condition to avoid ~ ax-13 . See ~ cbviinvg for a less restrictive version requiring more axioms. (Revised by GG, 14-Aug-2025.)
theorem cbviinv {x3 y1: setvar} (A2: class) (B2: class x3) (C: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 C) $ >
  $ wceq (ciin x3 A2 B2) (ciin y1 A2 C) $;

--| Rule used to change the bound variables in an indexed union, with the substitution specified implicitly by the hypothesis. Usage of this theorem is discouraged because it depends on ~ ax-13 . Usage of the weaker ~ cbviunv is preferred. (Contributed by NM, 15-Sep-2003.) (New usage is discouraged.)
theorem cbviunvg {x3 y1: setvar} (A2: class) (B2: class x3) (C: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 C) $ >
  $ wceq (ciun x3 A2 B2) (ciun y1 A2 C) $;

--| Change bound variables in an indexed intersection. Usage of this theorem is discouraged because it depends on ~ ax-13 . Usage of the weaker ~ cbviinv is preferred. (Contributed by Jeff Hankins, 26-Aug-2009.) (New usage is discouraged.)
theorem cbviinvg {x3 y1: setvar} (A2: class) (B2: class x3) (C: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 C) $ >
  $ wceq (ciin x3 A2 B2) (ciin y1 A2 C) $;

--| Subset theorem for an indexed union. (Contributed by Glauco Siliprandi, 3-Mar-2021.) Avoid ~ ax-10 . (Revised by SN, 2-Feb-2026.)
theorem iunssf {x3: setvar} (A2 B2 C: class x3):
  $ wnfc x3 C $ >
  $ wb (wss (ciun x3 A2 B2) C) (wral x3 (wss B2 C) A2) $;

--| Obsolete version of ~ iunssf as of 2-Feb-2026. (Contributed by Glauco Siliprandi, 3-Mar-2021.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem iunssfOLD {x3: setvar} (A2 B2 C: class x3):
  $ wnfc x3 C $ >
  $ wb (wss (ciun x3 A2 B2) C) (wral x3 (wss B2 C) A2) $;

--| Subset theorem for an indexed union. (Contributed by NM, 13-Sep-2003.) (Proof shortened by Andrew Salmon, 25-Jul-2011.) Avoid ~ ax-10 , ~ ax-12 . (Revised by SN, 2-Feb-2026.)
theorem iunss {x3: setvar} (A2 B2: class x3) (C: class):
  $ wb (wss (ciun x3 A2 B2) C) (wral x3 (wss B2 C) A2) $;

--| Obsolete version of ~ iunss as of 2-Feb-2026. (Contributed by NM, 13-Sep-2003.) (Proof shortened by Andrew Salmon, 25-Jul-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem iunssOLD {x3: setvar} (A2 B2: class x3) (C: class):
  $ wb (wss (ciun x3 A2 B2) C) (wral x3 (wss B2 C) A2) $;

--| Subset implication for an indexed union. (Contributed by NM, 3-Sep-2003.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem ssiun {x3: setvar} (A2 B2: class x3) (C: class):
  $ wi (wrex x3 (wss C B2) A2) (wss C (ciun x3 A2 B2)) $;

--| Identity law for subset of an indexed union. (Contributed by NM, 12-Oct-2003.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem ssiun2 {x3: setvar} (A2 B2: class x3):
  $ wi (wcel (cv x3) A2) (wss B2 (ciun x3 A2 B2)) $;

--| Subset relationship for an indexed union. (Contributed by NM, 26-Oct-2003.)
theorem ssiun2s {x3: setvar} (A2: class) (B2: class x3) (C D: class):
  $ wi (wceq (cv x3) C) (wceq B2 D) $ >
  $ wi (wcel C A2) (wss D (ciun x3 A2 B2)) $;

--| A subclass condition on the members of two indexed classes ` C ( x ) ` and ` D ( y ) ` that implies a subclass relation on their indexed unions. Generalization of Proposition 8.6 of [TakeutiZaring] p. 59. Compare ~ uniss2 . (Contributed by NM, 9-Dec-2004.)
theorem iunss2 {x3 y1: setvar} (A2: class x3 y1) (B2: class y1) (C: class x3) (D: class y1):
  $ wi (wral x3 (wrex y1 (wss C D) B2) A2) (wss (ciun x3 A2 C) (ciun y1 B2 D)) $;

--| Subset theorem for an indexed union. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem iunssd {x3: setvar} (ph: wff) (A2 B2: class x3) (C: class):
  $ wi (wa ph (wcel (cv x3) A2)) (wss B2 C) $ >
  $ wi ph (wss (ciun x3 A2 B2) C) $;

--| The indexed union of a class abstraction. (Contributed by NM, 27-Dec-2004.)
theorem iunab {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3):
  $ wceq (ciun x3 A2 (cab y1 ph)) (cab y1 (wrex x3 ph A2)) $;

--| The indexed union of a restricted class abstraction. (Contributed by NM, 3-Jan-2004.) (Proof shortened by Mario Carneiro, 14-Nov-2016.)
theorem iunrab {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class y1):
  $ wceq (ciun x3 A2 (crab y1 ph B2)) (crab y1 (wrex x3 ph A2) B2) $;

--| Indexed union with a class difference as its index. (Contributed by NM, 10-Dec-2004.)
theorem iunxdif2 {x3 y1: setvar} (A2 B2: class) (C: class x3) (D: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wceq C D) $ >
  $ wi (wral x3 (wrex y1 (wss C D) (cdif A2 B2)) A2) (wceq (ciun y1 (cdif A2 B2) D) (ciun x3 A2 C)) $;

--| Subset theorem for an indexed intersection. (Contributed by FL, 15-Oct-2012.) (Proof shortened by Mario Carneiro, 14-Oct-2016.)
theorem ssiinf {x3: setvar} (A2 B2 C: class x3):
  $ wnfc x3 C $ >
  $ wb (wss C (ciin x3 A2 B2)) (wral x3 (wss C B2) A2) $;

--| Subset theorem for an indexed intersection. (Contributed by NM, 15-Oct-2003.)
theorem ssiin {x3: setvar} (A2 B2: class x3) (C: class):
  $ wb (wss C (ciin x3 A2 B2)) (wral x3 (wss C B2) A2) $;

--| Subset implication for an indexed intersection. (Contributed by NM, 15-Oct-2003.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem iinss {x3: setvar} (A2 B2: class x3) (C: class):
  $ wi (wrex x3 (wss B2 C) A2) (wss (ciin x3 A2 B2) C) $;

--| An indexed intersection is included in any of its members. (Contributed by FL, 15-Oct-2012.)
theorem iinss2 {x3: setvar} (A2 B2: class x3):
  $ wi (wcel (cv x3) A2) (wss (ciin x3 A2 B2) B2) $;

--| Class union in terms of indexed union. Definition in [Stoll] p. 43. (Contributed by NM, 28-Jun-1998.)
theorem uniiun {x3: setvar} (A2: class):
  $ wceq (cuni A2) (ciun x3 A2 (cv x3)) $;

--| Class intersection in terms of indexed intersection. Definition in [Stoll] p. 44. (Contributed by NM, 28-Jun-1998.)
theorem intiin {x3: setvar} (A2: class):
  $ wceq (cint A2) (ciin x3 A2 (cv x3)) $;

--| An indexed union of singletons recovers the index set. (Contributed by NM, 6-Sep-2005.) (Proof shortened by SN, 15-Jan-2025.)
theorem iunid {x3: setvar} (A2: class):
  $ wceq (ciun x3 A2 (csn (cv x3))) A2 $;

--| An indexed union of the empty set is empty. (Contributed by NM, 26-Mar-2003.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem iun0 {x3: setvar} (A2: class x3):
  $ wceq (ciun x3 A2 c0) c0 $;

--| An empty indexed union is empty. (Contributed by NM, 4-Dec-2004.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem _0iun {x3: setvar} (A2: class x3):
  $ wceq (ciun x3 c0 A2) c0 $;

--| An empty indexed intersection is the universal class. (Contributed by NM, 20-Oct-2005.)
theorem _0iin {x3: setvar} (A2: class x3):
  $ wceq (ciin x3 c0 A2) cvv $;

--| Indexed intersection with a universal index class. When ` A ` doesn't depend on ` x ` , this evaluates to ` A ` by ~ 19.3 and ~ abid2 . When ` A = x ` , this evaluates to ` (/) ` by ~ intiin and ~ intv . (Contributed by NM, 11-Sep-2008.)
theorem viin {x3 y1: setvar} (A2: class x3):
  $ wceq (ciin x3 cvv A2) (cab y1 (wal x3 (wcel (cv y1) A2))) $;

--| Indexed union of a singleton. Compare ~ dfiun2 and ~ rnmpt . (Contributed by Steven Nguyen, 7-Jun-2023.)
theorem iunsn {x3 y1: setvar} (A2 B2: class x3):
  $ wceq (ciun x3 A2 (csn B2)) (cab y1 (wrex x3 (wceq (cv y1) B2) A2)) $;

--| There is a nonempty class in an indexed collection ` B ( x ) ` iff the indexed union of them is nonempty. (Contributed by NM, 15-Oct-2003.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem iunn0 {x3: setvar} (A2: class) (B2: class x3):
  $ wb (wrex x3 (wne B2 c0) A2) (wne (ciun x3 A2 B2) c0) $;

--| Indexed intersection of a class abstraction. (Contributed by NM, 6-Dec-2011.)
theorem iinab {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3):
  $ wceq (ciin x3 A2 (cab y1 ph)) (cab y1 (wral x3 ph A2)) $;

--| Indexed intersection of a restricted class abstraction. (Contributed by NM, 6-Dec-2011.)
theorem iinrab {x3 y1: setvar} (ph: wff x3 y1) (A2: class) (B2: class y1):
  $ wi (wne A2 c0) (wceq (ciin x3 A2 (crab y1 ph B2)) (crab y1 (wral x3 ph A2) B2)) $;

--| Indexed intersection of a restricted class abstraction. (Contributed by NM, 6-Dec-2011.)
theorem iinrab2 {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class):
  $ wceq (cin (ciin x3 A2 (crab y1 ph B2)) B2) (crab y1 (wral x3 ph A2) B2) $;

--| Indexed union of intersection. Generalization of half of theorem "Distributive laws" in [Enderton] p. 30. Use ~ uniiun to recover Enderton's theorem. (Contributed by NM, 26-Mar-2004.)
theorem iunin2 {x3: setvar} (A2: class x3) (B2: class) (C: class x3):
  $ wceq (ciun x3 A2 (cin B2 C)) (cin B2 (ciun x3 A2 C)) $;

--| Indexed union of intersection. Generalization of half of theorem "Distributive laws" in [Enderton] p. 30. Use ~ uniiun to recover Enderton's theorem. (Contributed by Mario Carneiro, 30-Aug-2015.)
theorem iunin1 {x3: setvar} (A2: class x3) (B2: class) (C: class x3):
  $ wceq (ciun x3 A2 (cin C B2)) (cin (ciun x3 A2 C) B2) $;

--| Indexed intersection of union. Generalization of half of theorem "Distributive laws" in [Enderton] p. 30. Use ~ intiin to recover Enderton's theorem. (Contributed by NM, 19-Aug-2004.)
theorem iinun2 {x3: setvar} (A2: class x3) (B2: class) (C: class x3):
  $ wceq (ciin x3 A2 (cun B2 C)) (cun B2 (ciin x3 A2 C)) $;

--| Indexed union of class difference. Generalization of half of theorem "De Morgan's laws" in [Enderton] p. 31. Use ~ intiin to recover Enderton's theorem. (Contributed by NM, 19-Aug-2004.)
theorem iundif2 {x3: setvar} (A2: class x3) (B2: class) (C: class x3):
  $ wceq (ciun x3 A2 (cdif B2 C)) (cdif B2 (ciin x3 A2 C)) $;

--| Union of intersection. Generalization of half of theorem "Distributive laws" in [Enderton] p. 30. (Contributed by Thierry Arnoux, 21-Jun-2020.)
theorem uniin1 {x3: setvar} (A2 B2: class):
  $ wceq (ciun x3 A2 (cin (cv x3) B2)) (cin (cuni A2) B2) $;

--| Union of intersection. Generalization of half of theorem "Distributive laws" in [Enderton] p. 30. (Contributed by Thierry Arnoux, 21-Jun-2020.)
theorem uniin2 {x3: setvar} (A2 B2: class):
  $ wceq (ciun x3 B2 (cin A2 (cv x3))) (cin A2 (cuni B2)) $;

--| Indexed intersection of class difference with the subtrahend held constant. (Contributed by Thierry Arnoux, 21-Aug-2023.)
theorem iindif1 {x3: setvar} (A2: class) (B2: class x3) (C: class):
  $ wi (wne A2 c0) (wceq (ciin x3 A2 (cdif B2 C)) (cdif (ciin x3 A2 B2) C)) $;

--| Rearrange indexed unions over intersection. (Contributed by NM, 18-Dec-2008.)
theorem _2iunin {x3 y1: setvar} (A2: class x3 y1) (B2: class y1) (C: class x3) (D: class y1):
  $ wceq (ciun x3 A2 (ciun y1 B2 (cin C D))) (cin (ciun x3 A2 C) (ciun y1 B2 D)) $;

--| Indexed intersection of class difference. Generalization of half of theorem "De Morgan's laws" in [Enderton] p. 31. Use ~ uniiun to recover Enderton's theorem. (Contributed by NM, 5-Oct-2006.)
theorem iindif2 {x3: setvar} (A2 B2: class) (C: class x3):
  $ wi (wne A2 c0) (wceq (ciin x3 A2 (cdif B2 C)) (cdif B2 (ciun x3 A2 C))) $;

--| Indexed intersection of intersection. Generalization of half of theorem "Distributive laws" in [Enderton] p. 30. Use ~ intiin to recover Enderton's theorem. (Contributed by Mario Carneiro, 19-Mar-2015.)
theorem iinin2 {x3: setvar} (A2 B2: class) (C: class x3):
  $ wi (wne A2 c0) (wceq (ciin x3 A2 (cin B2 C)) (cin B2 (ciin x3 A2 C))) $;

--| Indexed intersection of intersection. Generalization of half of theorem "Distributive laws" in [Enderton] p. 30. Use ~ intiin to recover Enderton's theorem. (Contributed by Mario Carneiro, 19-Mar-2015.)
theorem iinin1 {x3: setvar} (A2 B2: class) (C: class x3):
  $ wi (wne A2 c0) (wceq (ciin x3 A2 (cin C B2)) (cin (ciin x3 A2 C) B2)) $;

--| The indexed intersection of a complement. (Contributed by G&eacute;rard Lang, 5-Aug-2018.)
theorem iinvdif {x3: setvar} (A2: class) (B2: class x3):
  $ wceq (ciin x3 A2 (cdif cvv B2)) (cdif cvv (ciun x3 A2 B2)) $;

--| Elementhood in a relative intersection. (Contributed by Mario Carneiro, 30-Dec-2016.)
theorem elriin {x3: setvar} (A2 B2: class) (S: class x3) (X: class):
  $ wb (wcel B2 (cin A2 (ciin x3 X S))) (wa (wcel B2 A2) (wral x3 (wcel B2 S) X)) $;

--| Relative intersection of an empty family. (Contributed by Stefan O'Rear, 3-Apr-2015.)
theorem riin0 {x3: setvar} (A2: class) (S: class x3) (X: class):
  $ wi (wceq X c0) (wceq (cin A2 (ciin x3 X S)) A2) $;

--| Relative intersection of a nonempty family. (Contributed by Stefan O'Rear, 3-Apr-2015.)
theorem riinn0 {x3: setvar} (A2: class) (S: class x3) (X: class):
  $ wi (wa (wral x3 (wss S A2) X) (wne X c0)) (wceq (cin A2 (ciin x3 X S)) (ciin x3 X S)) $;

--| Relative intersection of a relative abstraction. (Contributed by Stefan O'Rear, 3-Apr-2015.)
theorem riinrab {x3 y1: setvar} (ph: wff x3 y1) (A2 X: class):
  $ wceq (cin A2 (ciin x3 X (crab y1 ph A2))) (crab y1 (wral x3 ph X) A2) $;

--| Symmetric difference with the empty class. The empty class is the identity element for symmetric difference. (Contributed by Scott Fenton, 24-Apr-2012.)
theorem symdif0 (A2: class):
  $ wceq (csymdif A2 c0) A2 $;

--| The symmetric difference with the universal class is the complement. (Contributed by Scott Fenton, 24-Apr-2012.)
theorem symdifv (A2: class):
  $ wceq (csymdif A2 cvv) (cdif cvv A2) $;

--| The symmetric difference of a class with itself is the empty class. (Contributed by Scott Fenton, 25-Apr-2012.)
theorem symdifid (A2: class):
  $ wceq (csymdif A2 A2) c0 $;

--| A singleton index picks out an instance of an indexed intersection's argument. (Contributed by NM, 15-Jan-2012.) (Proof shortened by Mario Carneiro, 17-Nov-2016.)
theorem iinxsng {x3: setvar} (A2: class) (B2: class x3) (C: class) (V: class x3):
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wi (wcel A2 V) (wceq (ciin x3 (csn A2) B2) C) $;

--| Indexed intersection with an unordered pair index. (Contributed by NM, 25-Jan-2012.)
theorem iinxprg {x3: setvar} (A2 B2: class) (C: class x3) (D E: class) (V W: class x3):
  $ wi (wceq (cv x3) A2) (wceq C D) $ >
  $ wi (wceq (cv x3) B2) (wceq C E) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wceq (ciin x3 (cpr A2 B2) C) (cin D E)) $;

--| A singleton index picks out an instance of an indexed union's argument. (Contributed by Mario Carneiro, 25-Jun-2016.)
theorem iunxsng {x3: setvar} (A2: class) (B2: class x3) (C: class) (V: class x3):
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wi (wcel A2 V) (wceq (ciun x3 (csn A2) B2) C) $;

--| A singleton index picks out an instance of an indexed union's argument. (Contributed by NM, 26-Mar-2004.) (Proof shortened by Mario Carneiro, 25-Jun-2016.)
theorem iunxsn {x3: setvar} (A2: class) (B2: class x3) (C: class):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wceq (ciun x3 (csn A2) B2) C $;

--| A singleton index picks out an instance of an indexed union's argument. (Contributed by Mario Carneiro, 25-Jun-2016.) (Revised by Thierry Arnoux, 2-May-2020.) Avoid ~ ax-13 . (Revised by GG, 19-May-2023.)
theorem iunxsngf {x3: setvar} (A2: class) (B2 C V: class x3):
  $ wnfc x3 C $ >
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wi (wcel A2 V) (wceq (ciun x3 (csn A2) B2) C) $;

--| Separate a union in an indexed union. (Contributed by NM, 27-Dec-2004.) (Proof shortened by Mario Carneiro, 17-Nov-2016.)
theorem iunun {x3: setvar} (A2 B2 C: class x3):
  $ wceq (ciun x3 A2 (cun B2 C)) (cun (ciun x3 A2 B2) (ciun x3 A2 C)) $;

--| Separate a union in the index of an indexed union. (Contributed by NM, 26-Mar-2004.) (Proof shortened by Mario Carneiro, 17-Nov-2016.)
theorem iunxun {x3: setvar} (A2 B2 C: class x3):
  $ wceq (ciun x3 (cun A2 B2) C) (cun (ciun x3 A2 C) (ciun x3 B2 C)) $;

--| An indexed union where some terms are the empty set. See ~ iunxdif2 . (Contributed by Thierry Arnoux, 4-May-2020.)
theorem iunxdif3 {x3: setvar} (A2: class) (B2 E: class x3):
  $ wnfc x3 E $ >
  $ wi (wral x3 (wceq B2 c0) E) (wceq (ciun x3 (cdif A2 E) B2) (ciun x3 A2 B2)) $;

--| A pair index picks out two instances of an indexed union's argument. (Contributed by Alexander van der Vekens, 2-Feb-2018.)
theorem iunxprg {x3: setvar} (A2 B2: class) (C: class x3) (D E: class) (V W: class x3):
  $ wi (wceq (cv x3) A2) (wceq C D) $ >
  $ wi (wceq (cv x3) B2) (wceq C E) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wceq (ciun x3 (cpr A2 B2) C) (cun D E)) $;

--| Separate an indexed union in the index of an indexed union. (Contributed by Mario Carneiro, 5-Dec-2016.)
theorem iunxiun {x3 y1: setvar} (A2: class y1) (B2: class x3 y1) (C: class x3):
  $ wceq (ciun x3 (ciun y1 A2 B2) C) (ciun y1 A2 (ciun x3 B2 C)) $;

--| A relationship involving union and indexed intersection. Exercise 23 of [Enderton] p. 33. (Contributed by NM, 25-Nov-2003.) (Proof shortened by Mario Carneiro, 17-Nov-2016.)
theorem iinuni {x3: setvar} (A2 B2: class):
  $ wceq (cun A2 (cint B2)) (ciin x3 B2 (cun A2 (cv x3))) $;

--| A relationship involving union and indexed union. Exercise 25 of [Enderton] p. 33. (Contributed by NM, 25-Nov-2003.) (Proof shortened by Mario Carneiro, 17-Nov-2016.)
theorem iununi {x3: setvar} (A2 B2: class):
  $ wb (wi (wceq B2 c0) (wceq A2 c0)) (wceq (cun A2 (cuni B2)) (ciun x3 B2 (cun A2 (cv x3)))) $;

--| Subclass relationship for power class and union. (Contributed by NM, 18-Jul-2006.)
theorem sspwuni (A2 B2: class):
  $ wb (wss A2 (cpw B2)) (wss (cuni A2) B2) $;

--| Two ways to express a collection of subclasses. (Contributed by NM, 19-Jul-2006.)
theorem pwssb {x3: setvar} (A2 B2: class):
  $ wb (wss A2 (cpw B2)) (wral x3 (wss (cv x3) B2) A2) $;

--| Characterization of the elements of a double power class: they are exactly the sets whose union is included in that class. (Contributed by BJ, 29-Apr-2021.)
theorem elpwpw (A2 B2: class):
  $ wb (wcel A2 (cpw (cpw B2))) (wa (wcel A2 cvv) (wss (cuni A2) B2)) $;

--| The double power class written as a class abstraction: the class of sets whose union is included in the given class. (Contributed by BJ, 29-Apr-2021.)
theorem pwpwab {x3: setvar} (A2: class):
  $ wceq (cpw (cpw A2)) (cab x3 (wss (cuni (cv x3)) A2)) $;

--| The class of sets whose union is equal to a given class is included in the double power class of that class. (Contributed by BJ, 29-Apr-2021.)
theorem pwpwssunieq {x3: setvar} (A2: class):
  $ wss (cab x3 (wceq (cuni (cv x3)) A2)) (cpw (cpw A2)) $;

--| Relationship for power class and union. (Contributed by NM, 18-Jul-2006.)
theorem elpwuni (A2 B2: class):
  $ wi (wcel B2 A2) (wb (wss A2 (cpw B2)) (wceq (cuni A2) B2)) $;

--| The power class of an intersection in terms of indexed intersection. Exercise 24(a) of [Enderton] p. 33. (Contributed by NM, 29-Nov-2003.)
theorem iinpw {x3: setvar} (A2: class):
  $ wceq (cpw (cint A2)) (ciin x3 A2 (cpw (cv x3))) $;

--| Inclusion of an indexed union of a power class in the power class of the union of its index. Part of Exercise 24(b) of [Enderton] p. 33. (Contributed by NM, 25-Nov-2003.)
theorem iunpwss {x3: setvar} (A2: class):
  $ wss (ciun x3 A2 (cpw (cv x3))) (cpw (cuni A2)) $;

--| A nonempty intersection of a family of subsets of a class is included in that class. (Contributed by BJ, 7-Dec-2021.)
theorem intss2 (A2 X: class):
  $ wi (wss A2 (cpw X)) (wi (wne A2 c0) (wss (cint A2) X)) $;

--| Relative intersection of a nonempty set. (Contributed by Stefan O'Rear, 3-Apr-2015.) (Revised by Mario Carneiro, 5-Jun-2015.)
theorem rintn0 (A2 X: class):
  $ wi (wa (wss X (cpw A2)) (wne X c0)) (wceq (cin A2 (cint X)) (cint X)) $;

--| Extend wff notation to include the statement that a family of classes ` B ( x ) ` , for ` x e. A ` , is a disjoint family.
term wdisj {x3: setvar} (A2 B2: class x3): wff;

--| A collection of classes ` B ( x ) ` is disjoint when for each element ` y ` , it is in ` B ( x ) ` for at most one ` x ` . (Contributed by Mario Carneiro, 14-Nov-2016.) (Revised by NM, 16-Jun-2017.)
axiom df_disj {x3 y1: setvar} (A2 B2: class x3):
  $ wb (wdisj x3 A2 B2) (wal y1 (wrmo x3 (wcel (cv y1) B2) A2)) $;

--| Alternate definition for disjoint classes. (Contributed by NM, 17-Jun-2017.)
theorem dfdisj2 {x3 y1: setvar} (A2 B2: class x3):
  $ wb (wdisj x3 A2 B2) (wal y1 (wmo x3 (wa (wcel (cv x3) A2) (wcel (cv y1) B2)))) $;

--| If each element of a collection is contained in a disjoint collection, the original collection is also disjoint. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem disjss2 {x3: setvar} (A2 B2 C: class x3):
  $ wi (wral x3 (wss B2 C) A2) (wi (wdisj x3 A2 C) (wdisj x3 A2 B2)) $;

--| Equality theorem for disjoint collection. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem disjeq2 {x3: setvar} (A2 B2 C: class x3):
  $ wi (wral x3 (wceq B2 C) A2) (wb (wdisj x3 A2 B2) (wdisj x3 A2 C)) $;

--| Equality deduction for disjoint collection. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem disjeq2dv {x3: setvar} (ph: wff) (A2 B2 C: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wceq B2 C) $ >
  $ wi ph (wb (wdisj x3 A2 B2) (wdisj x3 A2 C)) $;

--| A subset of a disjoint collection is disjoint. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem disjss1 {x3: setvar} (A2 B2: class) (C: class x3):
  $ wi (wss A2 B2) (wi (wdisj x3 B2 C) (wdisj x3 A2 C)) $;

--| Equality theorem for disjoint collection. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem disjeq1 {x3: setvar} (A2 B2: class) (C: class x3):
  $ wi (wceq A2 B2) (wb (wdisj x3 A2 C) (wdisj x3 B2 C)) $;

--| Equality theorem for disjoint collection. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem disjeq1d {x3: setvar} (ph: wff x3) (A2 B2: class) (C: class x3):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wdisj x3 A2 C) (wdisj x3 B2 C)) $;

--| Equality theorem for disjoint collection. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem disjeq12d {x3: setvar} (ph: wff) (A2 B2: class) (C D: class x3):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wb (wdisj x3 A2 C) (wdisj x3 B2 D)) $;

--| Change bound variables in a disjoint collection. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem cbvdisj {x3 y1: setvar} (A2: class) (B2 C: class x3 y1):
  $ wnfc y1 B2 $ >
  $ wnfc x3 C $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 C) $ >
  $ wb (wdisj x3 A2 B2) (wdisj y1 A2 C) $;

--| Change bound variables in a disjoint collection. (Contributed by Mario Carneiro, 11-Dec-2016.)
theorem cbvdisjv {x3 y1: setvar} (A2: class) (B2: class x3) (C: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 C) $ >
  $ wb (wdisj x3 A2 B2) (wdisj y1 A2 C) $;

--| Bound-variable hypothesis builder for disjoint collection. Version of ~ nfdisj with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by Mario Carneiro, 14-Nov-2016.) Avoid ~ ax-13 . (Revised by GG, 26-Jan-2024.)
theorem nfdisjw {x3 y1: setvar} (A2 B2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wnfc y1 B2 $ >
  $ wnf y1 (wdisj x3 A2 B2) $;

--| Bound-variable hypothesis builder for disjoint collection. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ nfdisjw when possible. (Contributed by Mario Carneiro, 14-Nov-2016.) (New usage is discouraged.)
theorem nfdisj {x3 y1: setvar} (A2 B2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wnfc y1 B2 $ >
  $ wnf y1 (wdisj x3 A2 B2) $;

--| Bound-variable hypothesis builder for disjoint collection. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem nfdisj1 {x3: setvar} (A2 B2: class x3):
  $ wnf x3 (wdisj x3 A2 B2) $;

--| Two ways to say that a collection ` B ( i ) ` for ` i e. A ` is disjoint. (Contributed by Mario Carneiro, 26-Mar-2015.) (Revised by Mario Carneiro, 14-Nov-2016.)
theorem disjor {i j: setvar} (A2: class) (B2: class i) (C: class j):
  $ wi (wceq (cv i) (cv j)) (wceq B2 C) $ >
  $ wb (wdisj i A2 B2) (wral i (wral j (wo (wceq (cv i) (cv j)) (wceq (cin B2 C) c0)) A2) A2) $;

--| Two ways to say that a collection ` B ( i ) ` for ` i e. A ` is disjoint. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem disjors {x3 i j: setvar} (A2: class) (B2: class x3):
  $ wb (wdisj x3 A2 B2) (wral i (wral j (wo (wceq (cv i) (cv j)) (wceq (cin (csb x3 (cv i) B2) (csb x3 (cv j) B2)) c0)) A2) A2) $;

--| Property of a disjoint collection: if ` B ( X ) = C ` and ` B ( Y ) = D ` , and ` X =/= Y ` , then ` C ` and ` D ` are disjoint. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem disji2 {x3: setvar} (A2: class) (B2: class x3) (C D X Y: class):
  $ wi (wceq (cv x3) X) (wceq B2 C) $ >
  $ wi (wceq (cv x3) Y) (wceq B2 D) $ >
  $ wi (w3a (wdisj x3 A2 B2) (wa (wcel X A2) (wcel Y A2)) (wne X Y)) (wceq (cin C D) c0) $;

--| Property of a disjoint collection: if ` B ( X ) = C ` and ` B ( Y ) = D ` have a common element ` Z ` , then ` X = Y ` . (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem disji {x3: setvar} (A2: class) (B2: class x3) (C D X Y: class) (Z: class x3):
  $ wi (wceq (cv x3) X) (wceq B2 C) $ >
  $ wi (wceq (cv x3) Y) (wceq B2 D) $ >
  $ wi (w3a (wdisj x3 A2 B2) (wa (wcel X A2) (wcel Y A2)) (wa (wcel Z C) (wcel Z D))) (wceq X Y) $;

--| If there is a function ` C ( y ) ` such that ` C ( y ) = x ` for all ` y e. B ( x ) ` , then the sets ` B ( x ) ` for distinct ` x e. A ` are disjoint. (Contributed by Mario Carneiro, 10-Dec-2016.)
theorem invdisj {x3 y1: setvar} (A2 B2: class x3) (C: class y1):
  $ wi (wral x3 (wral y1 (wceq C (cv x3)) B2) A2) (wdisj x3 A2 B2) $;

--| The restricted class abstractions ` { x e. B | C = y } ` for distinct ` y e. A ` are disjoint. (Contributed by AV, 6-May-2020.) (Proof shortened by GG, 26-Jan-2024.)
theorem invdisjrab {x3 y1: setvar} (A2: class x3 y1) (B2: class y1) (C: class x3):
  $ wdisj y1 A2 (crab x3 (wceq C (cv y1)) B2) $;

--| A disjoint collection yields disjoint indexed unions for disjoint index sets. (Contributed by Mario Carneiro, 26-Mar-2015.) (Revised by Mario Carneiro, 14-Nov-2016.)
theorem disjiun {x3: setvar} (A2: class) (B2: class x3) (C D: class):
  $ wi (wa (wdisj x3 A2 B2) (w3a (wss C A2) (wss D A2) (wceq (cin C D) c0))) (wceq (cin (ciun x3 C B2) (ciun x3 D B2)) c0) $;

--| Conditions for a collection of sets ` A ( a ) ` for ` a e. V ` to be disjoint. (Contributed by AV, 9-Jan-2022.)
theorem disjord {x3 a b: setvar} (ph: wff) (A2: class a) (B2: class b) (V: class):
  $ wi (wceq (cv a) (cv b)) (wceq A2 B2) $ >
  $ wi (w3a ph (wcel (cv x3) A2) (wcel (cv x3) B2)) (wceq (cv a) (cv b)) $ >
  $ wi ph (wdisj a V A2) $;

--| Two ways to say that a collection of index unions ` C ( i , x ) ` for ` i e. A ` and ` x e. B ` is disjoint. (Contributed by AV, 9-Jan-2022.)
theorem disjiunb {x3 i j: setvar} (A2: class x3) (B2: class i) (C: class x3 i) (D: class j) (E: class x3 j):
  $ wi (wceq (cv i) (cv j)) (wceq B2 D) $ >
  $ wi (wceq (cv i) (cv j)) (wceq C E) $ >
  $ wb (wdisj i A2 (ciun x3 B2 C)) (wral i (wral j (wo (wceq (cv i) (cv j)) (wceq (cin (ciun x3 B2 C) (ciun x3 D E)) c0)) A2) A2) $;

--| Conditions for a collection of index unions of sets ` A ( a , b ) ` for ` a e. V ` and ` b e. W ` to be disjoint. (Contributed by AV, 9-Jan-2022.)
theorem disjiund {x3 a b c d: setvar} (ph: wff) (A2: class a b) (C: class b c) (D: class x3 a c d) (V: class x3 b d) (W: class a) (X: class c):
  $ wi (wceq (cv a) (cv c)) (wceq A2 C) $ >
  $ wi (wceq (cv b) (cv d)) (wceq C D) $ >
  $ wi (wceq (cv a) (cv c)) (wceq W X) $ >
  $ wi (w3a ph (wcel (cv x3) A2) (wcel (cv x3) D)) (wceq (cv a) (cv c)) $ >
  $ wi ph (wdisj a V (ciun b W A2)) $;

--| Any collection of singletons is disjoint. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem sndisj {x3: setvar} (A2: class x3):
  $ wdisj x3 A2 (csn (cv x3)) $;

--| Any collection of empty sets is disjoint. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem _0disj {x3: setvar} (A2: class x3):
  $ wdisj x3 A2 c0 $;

--| A singleton collection is disjoint. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem disjxsn {x3: setvar} (A2: class) (B2: class x3):
  $ wdisj x3 (csn A2) B2 $;

--| An empty collection is disjoint. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem disjx0 {x3: setvar} (B2: class x3):
  $ wdisj x3 c0 B2 $;

--| A pair collection is disjoint iff the two sets in the family have empty intersection. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem disjprg {x3: setvar} (A2 B2: class) (C: class x3) (D E: class) (V: class x3):
  $ wi (wceq (cv x3) A2) (wceq C D) $ >
  $ wi (wceq (cv x3) B2) (wceq C E) $ >
  $ wi (w3a (wcel A2 V) (wcel B2 V) (wne A2 B2)) (wb (wdisj x3 (cpr A2 B2) C) (wceq (cin D E) c0)) $;

--| An indexed union of a disjoint collection of disjoint collections is disjoint if each component is disjoint, and the disjoint unions in the collection are also disjoint. Note that ` B ( y ) ` and ` C ( x ) ` may have the displayed free variables. (Contributed by Mario Carneiro, 14-Nov-2016.) (Proof shortened by JJ, 27-May-2021.)
theorem disjxiun {x3 y1: setvar} (A2: class) (B2: class y1) (C: class x3):
  $ wi (wdisj y1 A2 B2) (wb (wdisj x3 (ciun y1 A2 B2) C) (wa (wral y1 (wdisj x3 B2 C) A2) (wdisj y1 A2 (ciun x3 B2 C)))) $;

--| The union of two disjoint collections. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem disjxun {x3 y1: setvar} (A2 B2: class) (C: class x3) (D: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wceq C D) $ >
  $ wi (wceq (cin A2 B2) c0) (wb (wdisj x3 (cun A2 B2) C) (w3a (wdisj x3 A2 C) (wdisj x3 B2 C) (wral x3 (wral y1 (wceq (cin C D) c0) B2) A2))) $;

--| Expand a disjoint collection with any number of empty sets. (Contributed by Mario Carneiro, 15-Nov-2016.)
theorem disjss3 {x3: setvar} (A2 B2: class) (C: class x3):
  $ wi (wa (wss A2 B2) (wral x3 (wceq C c0) (cdif B2 A2))) (wb (wdisj x3 A2 C) (wdisj x3 B2 C)) $;

--| Extend wff notation to include the general binary relation predicate. Note that the syntax is simply three class symbols in a row. Since binary relations are the only possible wff expressions consisting of three class expressions in a row, the syntax is unambiguous. (For an example of how syntax could become ambiguous if we are not careful, see the comment in ~ cneg .)
term wbr (A2 B2 R: class): wff;

--| Define a general binary relation. Note that the syntax is simply three class symbols in a row. Definition 6.18 of [TakeutiZaring] p. 29 generalized to arbitrary classes. Class ` R ` often denotes a relation such as " ` < ` " that compares two classes ` A ` and ` B ` , which might be numbers such as ` 1 ` and ` 2 ` (see ~ df-ltxr for the specific definition of ` < ` ). As a wff, relations are true or false. For example, ` ( R = { <. 2 , 6 >. , <. 3 , 9 >. } -> 3 R 9 ) ` ( ~ ex-br ). Often class ` R ` meets the ` Rel ` criteria to be defined in ~ df-rel , and in particular ` R ` may be a function (see ~ df-fun ). This definition of relations is well-defined, although not very meaningful, when classes ` A ` and/or ` B ` are proper classes (i.e., are not sets). On the other hand, we often find uses for this definition when ` R ` is a proper class (see for example ~ iprc ). (Contributed by NM, 31-Dec-1993.)
axiom df_br (A2 B2 R: class):
  $ wb (wbr A2 B2 R) (wcel (cop A2 B2) R) $;

--| Equality theorem for binary relations. (Contributed by NM, 4-Jun-1995.)
theorem breq (A2 B2 R S: class):
  $ wi (wceq R S) (wb (wbr A2 B2 R) (wbr A2 B2 S)) $;

--| Equality theorem for a binary relation. (Contributed by NM, 31-Dec-1993.)
theorem breq1 (A2 B2 C R: class):
  $ wi (wceq A2 B2) (wb (wbr A2 C R) (wbr B2 C R)) $;

--| Equality theorem for a binary relation. (Contributed by NM, 31-Dec-1993.)
theorem breq2 (A2 B2 C R: class):
  $ wi (wceq A2 B2) (wb (wbr C A2 R) (wbr C B2 R)) $;

--| Equality theorem for a binary relation. (Contributed by NM, 8-Feb-1996.)
theorem breq12 (A2 B2 C D R: class):
  $ wi (wa (wceq A2 B2) (wceq C D)) (wb (wbr A2 C R) (wbr B2 D R)) $;

--| Equality inference for binary relations. (Contributed by NM, 19-Feb-2005.)
theorem breqi (A2 B2 R S: class):
  $ wceq R S $ >
  $ wb (wbr A2 B2 R) (wbr A2 B2 S) $;

--| Equality inference for a binary relation. (Contributed by NM, 8-Feb-1996.)
theorem breq1i (A2 B2 C R: class):
  $ wceq A2 B2 $ >
  $ wb (wbr A2 C R) (wbr B2 C R) $;

--| Equality inference for a binary relation. (Contributed by NM, 8-Feb-1996.)
theorem breq2i (A2 B2 C R: class):
  $ wceq A2 B2 $ >
  $ wb (wbr C A2 R) (wbr C B2 R) $;

--| Equality inference for a binary relation. (Contributed by NM, 8-Feb-1996.) (Proof shortened by Eric Schmidt, 4-Apr-2007.)
theorem breq12i (A2 B2 C D R: class):
  $ wceq A2 B2 $ >
  $ wceq C D $ >
  $ wb (wbr A2 C R) (wbr B2 D R) $;

--| Equality deduction for a binary relation. (Contributed by NM, 8-Feb-1996.)
theorem breq1d (ph: wff) (A2 B2 C R: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wbr A2 C R) (wbr B2 C R)) $;

--| Equality deduction for a binary relation. (Contributed by NM, 29-Oct-2011.)
theorem breqd (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wbr C D A2) (wbr C D B2)) $;

--| Equality deduction for a binary relation. (Contributed by NM, 8-Feb-1996.)
theorem breq2d (ph: wff) (A2 B2 C R: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wbr C A2 R) (wbr C B2 R)) $;

--| Equality deduction for a binary relation. (Contributed by NM, 8-Feb-1996.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem breq12d (ph: wff) (A2 B2 C D R: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wb (wbr A2 C R) (wbr B2 D R)) $;

--| Equality deduction for a binary relation. (Contributed by NM, 29-Oct-2011.)
theorem breq123d (ph: wff) (A2 B2 C D R S: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq R S) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wb (wbr A2 C R) (wbr B2 D S)) $;

--| Equality deduction for a binary relation. (Contributed by Thierry Arnoux, 5-Oct-2020.)
theorem breqdi (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wbr C D A2) $ >
  $ wi ph (wbr C D B2) $;

--| Equality deduction for a binary relation. (Contributed by NM, 8-Feb-1996.)
theorem breqan12d (ph ps: wff) (A2 B2 C D R: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ps (wceq C D) $ >
  $ wi (wa ph ps) (wb (wbr A2 C R) (wbr B2 D R)) $;

--| Equality deduction for a binary relation. (Contributed by NM, 8-Feb-1996.)
theorem breqan12rd (ph ps: wff) (A2 B2 C D R: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ps (wceq C D) $ >
  $ wi (wa ps ph) (wb (wbr A2 C R) (wbr B2 D R)) $;

--| Equality deduction for a binary relation. (Contributed by Thierry Arnoux, 10-Jan-2026.)
theorem breq1dd (ph: wff) (A2 B2 C R: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wbr A2 C R) $ >
  $ wi ph (wbr B2 C R) $;

--| Equality deduction for a binary relation. (Contributed by Thierry Arnoux, 10-Jan-2026.)
theorem breq2dd (ph: wff) (A2 B2 C R: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wbr C A2 R) $ >
  $ wi ph (wbr C B2 R) $;

--| Substitution of equal classes into the negation of a binary relation. (Contributed by Glauco Siliprandi, 3-Jan-2021.)
theorem eqnbrtrd (ph: wff) (A2 B2 C R: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wn (wbr B2 C R)) $ >
  $ wi ph (wn (wbr A2 C R)) $;

--| Two classes are different if they don't have the same relationship to a third class. (Contributed by NM, 3-Jun-2012.)
theorem nbrne1 (A2 B2 C R: class):
  $ wi (wa (wbr A2 B2 R) (wn (wbr A2 C R))) (wne B2 C) $;

--| Two classes are different if they don't have the same relationship to a third class. (Contributed by NM, 3-Jun-2012.)
theorem nbrne2 (A2 B2 C R: class):
  $ wi (wa (wbr A2 C R) (wn (wbr B2 C R))) (wne A2 B2) $;

--| Substitution of equal classes into a binary relation. (Contributed by NM, 1-Aug-1999.)
theorem eqbrtri (A2 B2 C R: class):
  $ wceq A2 B2 $ >
  $ wbr B2 C R $ >
  $ wbr A2 C R $;

--| Substitution of equal classes into a binary relation. (Contributed by NM, 8-Oct-1999.)
theorem eqbrtrd (ph: wff) (A2 B2 C R: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wbr B2 C R) $ >
  $ wi ph (wbr A2 C R) $;

--| Substitution of equal classes into a binary relation. (Contributed by NM, 1-Aug-1999.)
theorem eqbrtrri (A2 B2 C R: class):
  $ wceq A2 B2 $ >
  $ wbr A2 C R $ >
  $ wbr B2 C R $;

--| Substitution of equal classes into a binary relation. (Contributed by NM, 24-Oct-1999.)
theorem eqbrtrrd (ph: wff) (A2 B2 C R: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wbr A2 C R) $ >
  $ wi ph (wbr B2 C R) $;

--| Substitution of equal classes into a binary relation. (Contributed by NM, 1-Aug-1999.)
theorem breqtri (A2 B2 C R: class):
  $ wbr A2 B2 R $ >
  $ wceq B2 C $ >
  $ wbr A2 C R $;

--| Substitution of equal classes into a binary relation. (Contributed by NM, 24-Oct-1999.)
theorem breqtrd (ph: wff) (A2 B2 C R: class):
  $ wi ph (wbr A2 B2 R) $ >
  $ wi ph (wceq B2 C) $ >
  $ wi ph (wbr A2 C R) $;

--| Substitution of equal classes into a binary relation. (Contributed by NM, 1-Aug-1999.)
theorem breqtrri (A2 B2 C R: class):
  $ wbr A2 B2 R $ >
  $ wceq C B2 $ >
  $ wbr A2 C R $;

--| Substitution of equal classes into a binary relation. (Contributed by NM, 24-Oct-1999.)
theorem breqtrrd (ph: wff) (A2 B2 C R: class):
  $ wi ph (wbr A2 B2 R) $ >
  $ wi ph (wceq C B2) $ >
  $ wi ph (wbr A2 C R) $;

--| Substitution of equality into both sides of a binary relation. (Contributed by NM, 11-Aug-1999.)
theorem _3brtr3i (A2 B2 C D R: class):
  $ wbr A2 B2 R $ >
  $ wceq A2 C $ >
  $ wceq B2 D $ >
  $ wbr C D R $;

--| Substitution of equality into both sides of a binary relation. (Contributed by NM, 11-Aug-1999.)
theorem _3brtr4i (A2 B2 C D R: class):
  $ wbr A2 B2 R $ >
  $ wceq C A2 $ >
  $ wceq D B2 $ >
  $ wbr C D R $;

--| Substitution of equality into both sides of a binary relation. (Contributed by NM, 18-Oct-1999.)
theorem _3brtr3d (ph: wff) (A2 B2 C D R: class):
  $ wi ph (wbr A2 B2 R) $ >
  $ wi ph (wceq A2 C) $ >
  $ wi ph (wceq B2 D) $ >
  $ wi ph (wbr C D R) $;

--| Substitution of equality into both sides of a binary relation. (Contributed by NM, 21-Feb-2005.)
theorem _3brtr4d (ph: wff) (A2 B2 C D R: class):
  $ wi ph (wbr A2 B2 R) $ >
  $ wi ph (wceq C A2) $ >
  $ wi ph (wceq D B2) $ >
  $ wi ph (wbr C D R) $;

--| Substitution of equality into both sides of a binary relation. (Contributed by NM, 16-Jan-1997.)
theorem _3brtr3g (ph: wff) (A2 B2 C D R: class):
  $ wi ph (wbr A2 B2 R) $ >
  $ wceq A2 C $ >
  $ wceq B2 D $ >
  $ wi ph (wbr C D R) $;

--| Substitution of equality into both sides of a binary relation. (Contributed by NM, 16-Jan-1997.)
theorem _3brtr4g (ph: wff) (A2 B2 C D R: class):
  $ wi ph (wbr A2 B2 R) $ >
  $ wceq C A2 $ >
  $ wceq D B2 $ >
  $ wi ph (wbr C D R) $;

--| A chained equality inference for a binary relation. (Contributed by NM, 11-Oct-1999.)
theorem eqbrtrid (ph: wff) (A2 B2 C R: class):
  $ wceq A2 B2 $ >
  $ wi ph (wbr B2 C R) $ >
  $ wi ph (wbr A2 C R) $;

--| A chained equality inference for a binary relation. (Contributed by NM, 17-Sep-2004.)
theorem eqbrtrrid (ph: wff) (A2 B2 C R: class):
  $ wceq B2 A2 $ >
  $ wi ph (wbr B2 C R) $ >
  $ wi ph (wbr A2 C R) $;

--| A chained equality inference for a binary relation. (Contributed by NM, 11-Oct-1999.)
theorem breqtrid (ph: wff) (A2 B2 C R: class):
  $ wbr A2 B2 R $ >
  $ wi ph (wceq B2 C) $ >
  $ wi ph (wbr A2 C R) $;

--| A chained equality inference for a binary relation. (Contributed by NM, 24-Apr-2005.)
theorem breqtrrid (ph: wff) (A2 B2 C R: class):
  $ wbr A2 B2 R $ >
  $ wi ph (wceq C B2) $ >
  $ wi ph (wbr A2 C R) $;

--| A chained equality inference for a binary relation. (Contributed by NM, 12-Oct-1999.)
theorem eqbrtrdi (ph: wff) (A2 B2 C R: class):
  $ wi ph (wceq A2 B2) $ >
  $ wbr B2 C R $ >
  $ wi ph (wbr A2 C R) $;

--| A chained equality inference for a binary relation. (Contributed by NM, 4-Jan-2006.)
theorem eqbrtrrdi (ph: wff) (A2 B2 C R: class):
  $ wi ph (wceq B2 A2) $ >
  $ wbr B2 C R $ >
  $ wi ph (wbr A2 C R) $;

--| A chained equality inference for a binary relation. (Contributed by NM, 11-Oct-1999.)
theorem breqtrdi (ph: wff) (A2 B2 C R: class):
  $ wi ph (wbr A2 B2 R) $ >
  $ wceq B2 C $ >
  $ wi ph (wbr A2 C R) $;

--| A chained equality inference for a binary relation. (Contributed by NM, 24-Apr-2005.)
theorem breqtrrdi (ph: wff) (A2 B2 C R: class):
  $ wi ph (wbr A2 B2 R) $ >
  $ wceq C B2 $ >
  $ wi ph (wbr A2 C R) $;

--| Deduction from a subclass relationship of binary relations. (Contributed by NM, 30-Apr-2004.)
theorem ssbrd (ph: wff) (A2 B2 C D: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wi (wbr C D A2) (wbr C D B2)) $;

--| Implication from a subclass relationship of binary relations. (Contributed by Peter Mazsa, 11-Nov-2019.)
theorem ssbr (A2 B2 C D: class):
  $ wi (wss A2 B2) (wi (wbr C D A2) (wbr C D B2)) $;

--| Inference from a subclass relationship of binary relations. (Contributed by NM, 28-Mar-2007.) (Revised by Mario Carneiro, 8-Feb-2015.)
theorem ssbri (A2 B2 C D: class):
  $ wss A2 B2 $ >
  $ wi (wbr C D A2) (wbr C D B2) $;

--| Deduction version of bound-variable hypothesis builder ~ nfbr . (Contributed by NM, 13-Dec-2005.) (Revised by Mario Carneiro, 14-Oct-2016.)
theorem nfbrd {x3: setvar} (ph: wff x3) (A2 B2 R: class x3):
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 R) $ >
  $ wi ph (wnfc x3 B2) $ >
  $ wi ph (wnf x3 (wbr A2 B2 R)) $;

--| Bound-variable hypothesis builder for binary relation. (Contributed by NM, 1-Sep-1999.) (Revised by Mario Carneiro, 14-Oct-2016.)
theorem nfbr {x3: setvar} (A2 B2 R: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 R $ >
  $ wnfc x3 B2 $ >
  $ wnf x3 (wbr A2 B2 R) $;

--| Relationship between a binary relation and a class abstraction. (Contributed by Andrew Salmon, 8-Jul-2011.)
theorem brab1 {x3 z: setvar} (A2 R: class x3):
  $ wb (wbr (cv x3) A2 R) (wcel (cv x3) (cab z (wbr (cv z) A2 R))) $;

--| The empty binary relation never holds. (Contributed by NM, 23-Aug-2018.)
theorem br0 (A2 B2: class):
  $ wn (wbr A2 B2 c0) $;

--| If two sets are in a binary relation, the relation cannot be empty. (Contributed by Alexander van der Vekens, 7-Jul-2018.)
theorem brne0 (A2 B2 R: class):
  $ wi (wbr A2 B2 R) (wne R c0) $;

--| The union of two binary relations. (Contributed by NM, 21-Dec-2008.)
theorem brun (A2 B2 R S: class):
  $ wb (wbr A2 B2 (cun R S)) (wo (wbr A2 B2 R) (wbr A2 B2 S)) $;

--| The intersection of two relations. (Contributed by FL, 7-Oct-2008.)
theorem brin (A2 B2 R S: class):
  $ wb (wbr A2 B2 (cin R S)) (wa (wbr A2 B2 R) (wbr A2 B2 S)) $;

--| The difference of two binary relations. (Contributed by Scott Fenton, 11-Apr-2011.)
theorem brdif (A2 B2 R S: class):
  $ wb (wbr A2 B2 (cdif R S)) (wa (wbr A2 B2 R) (wn (wbr A2 B2 S))) $;

--| Characterization of the symmetric difference of two binary relations. The RHS could also be expressed using exclusive disjunction ~ df-xor . (Contributed by Scott Fenton, 11-Apr-2012.)
theorem brsymdif (A2 B2 R S: class):
  $ wb (wbr A2 B2 (csymdif R S)) (wn (wb (wbr A2 B2 R) (wbr A2 B2 S))) $;

--| Move substitution in and out of a binary relation. (Contributed by NM, 13-Dec-2005.) (Revised by NM, 22-Aug-2018.)
theorem sbcbr123 {x3: setvar} (A2 B2 C R: class x3):
  $ wb (wsbc x3 (wbr B2 C R) A2) (wbr (csb x3 A2 B2) (csb x3 A2 C) (csb x3 A2 R)) $;

--| Move substitution in and out of a binary relation. (Contributed by NM, 23-Aug-2018.)
theorem sbcbr {x3: setvar} (A2: class x3) (B2 C: class) (R: class x3):
  $ wb (wsbc x3 (wbr B2 C R) A2) (wbr B2 C (csb x3 A2 R)) $;

--| Move substitution in and out of a binary relation. (Contributed by NM, 13-Dec-2005.)
theorem sbcbr12g {x3: setvar} (A2 B2 C: class x3) (R: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wbr B2 C R) A2) (wbr (csb x3 A2 B2) (csb x3 A2 C) R)) $;

--| Move substitution in and out of a binary relation. (Contributed by NM, 13-Dec-2005.)
theorem sbcbr1g {x3: setvar} (A2 B2: class x3) (C R: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wbr B2 C R) A2) (wbr (csb x3 A2 B2) C R)) $;

--| Move substitution in and out of a binary relation. (Contributed by NM, 13-Dec-2005.)
theorem sbcbr2g {x3: setvar} (A2: class x3) (B2: class) (C: class x3) (R: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wbr B2 C R) A2) (wbr B2 (csb x3 A2 C) R)) $;

--| Restricted existential specialization with a restricted universal quantifier over a relation, closed form. (Contributed by AV, 20-Aug-2022.)
theorem brralrspcev {x3 y1: setvar} (A2: class y1) (B2: class) (R X Y: class y1):
  $ wi (wa (wcel B2 X) (wral y1 (wbr A2 B2 R) Y)) (wrex x3 (wral y1 (wbr A2 (cv x3) R) Y) X) $;

--| Restricted existential specialization with a restricted universal quantifier over an implication with a relation in the antecedent, closed form. (Contributed by AV, 20-Aug-2022.)
theorem brimralrspcev {x3 y1: setvar} (ph ps: wff y1) (A2: class y1) (B2: class) (R X Y: class y1):
  $ wi (wa (wcel B2 X) (wral y1 (wi (wa ph (wbr A2 B2 R)) ps) Y)) (wrex x3 (wral y1 (wi (wa ph (wbr A2 (cv x3) R)) ps) Y) X) $;

--| Extend class notation to include ordered-pair class abstraction (class builder).
term copab {x3 y1: setvar} (ph: wff x3 y1): class;

--| Define the class abstraction of a collection of ordered pairs. Definition 3.3 of [Monk1] p. 34. Usually ` x ` and ` y ` are distinct, although the definition does not require it (see ~ dfid2 for a case where they are not distinct). The brace notation is called "class abstraction" by Quine; it is also called "class builder" in the literature. An alternate definition using no existential quantifiers is shown by ~ dfopab2 . An example is given by ~ ex-opab . (Contributed by NM, 4-Jul-1994.)
axiom df_opab {x3 y1 z: setvar} (ph: wff x3 y1):
  $ wceq (copab x3 y1 ph) (cab z (wex x3 (wex y1 (wa (wceq (cv z) (cop (cv x3) (cv y1))) ph)))) $;

--| Define the class abstraction of a collection of ordered pairs. Definition 3.3 of [Monk1] p. 34. Usually ` x ` and ` y ` are distinct, although the definition does not require it (see ~ dfid2 for a case where they are not distinct). The brace notation is called "class abstraction" by Quine; it is also called "class builder" in the literature. An alternate definition using no existential quantifiers is shown by ~ dfopab2 . An example is given by ~ ex-opab . (Contributed by NM, 4-Jul-1994.)
axiom df_opab_b {x3 z: setvar} (ph: wff x3):
  $ wceq (copab x3 x3 ph) (cab z (wex x3 (wex x3 (wa (wceq (cv z) (cop (cv x3) (cv x3))) ph)))) $;

--| The collection of ordered pairs in a class is a subclass of it. (Contributed by NM, 27-Dec-1996.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem opabss {x3 y1: setvar} (R: class):
  $ wss (copab x3 y1 (wbr (cv x3) (cv y1) R)) R $;

--| Equivalent wff's yield equal ordered-pair class abstractions (deduction form). (Contributed by NM, 21-Feb-2004.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem opabbid {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wceq (copab x3 y1 ps) (copab x3 y1 ch)) $;

--| Equivalent wff's yield equal ordered-pair class abstractions (deduction form). (Contributed by NM, 15-May-1995.)
theorem opabbidv {x3 y1: setvar} (ph: wff) (ps ch: wff x3 y1):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wceq (copab x3 y1 ps) (copab x3 y1 ch)) $;

--| Equivalent wff's yield equal class abstractions. (Contributed by NM, 15-May-1995.)
theorem opabbii {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wb ph ps $ >
  $ wceq (copab x3 y1 ph) (copab x3 y1 ps) $;

--| Bound-variable hypothesis builder for class abstraction. Deduction form. (Contributed by Scott Fenton, 26-Oct-2024.)
theorem nfopabd {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wi ph (wnf z ps) $ >
  $ wi ph (wnfc z (copab x3 y1 ps)) $;

--| Bound-variable hypothesis builder for class abstraction. (Contributed by NM, 1-Sep-1999.) Remove disjoint variable conditions. (Revised by Andrew Salmon, 11-Jul-2011.) (Revised by Scott Fenton, 26-Oct-2024.)
theorem nfopab {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wnf z ph $ >
  $ wnfc z (copab x3 y1 ph) $;

--| The first abstraction variable in an ordered-pair class abstraction is effectively not free. (Contributed by NM, 16-May-1995.) (Revised by Mario Carneiro, 14-Oct-2016.)
theorem nfopab1 {x3 y1: setvar} (ph: wff x3 y1):
  $ wnfc x3 (copab x3 y1 ph) $;

--| The second abstraction variable in an ordered-pair class abstraction is effectively not free. (Contributed by NM, 16-May-1995.) (Revised by Mario Carneiro, 14-Oct-2016.)
theorem nfopab2 {x3 y1: setvar} (ph: wff x3 y1):
  $ wnfc y1 (copab x3 y1 ph) $;

--| Rule used to change bound variables in an ordered-pair class abstraction, using implicit substitution. (Contributed by NM, 14-Sep-2003.)
theorem cbvopab {x3 y1 z w: setvar} (ph ps: wff x3 y1 z w):
  $ wnf z ph $ >
  $ wnf w ph $ >
  $ wnf x3 ps $ >
  $ wnf y1 ps $ >
  $ wi (wa (wceq (cv x3) (cv z)) (wceq (cv y1) (cv w))) (wb ph ps) $ >
  $ wceq (copab x3 y1 ph) (copab z w ps) $;

--| Rule used to change bound variables in an ordered-pair class abstraction, using implicit substitution. (Contributed by NM, 15-Oct-1996.) Reduce axiom usage. (Revised by GG, 15-Oct-2024.)
theorem cbvopabv {x3 y1 z w: setvar} (ph: wff x3 y1) (ps: wff z w):
  $ wi (wa (wceq (cv x3) (cv z)) (wceq (cv y1) (cv w))) (wb ph ps) $ >
  $ wceq (copab x3 y1 ph) (copab z w ps) $;

--| Change first bound variable in an ordered-pair class abstraction, using explicit substitution. (Contributed by NM, 6-Oct-2004.) (Revised by Mario Carneiro, 14-Oct-2016.) Add disjoint variable condition to avoid ~ ax-13 . See ~ cbvopab1g for a less restrictive version requiring more axioms. (Revised by GG, 17-Jan-2024.)
theorem cbvopab1 {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wnf z ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv z)) (wb ph ps) $ >
  $ wceq (copab x3 y1 ph) (copab z y1 ps) $;

--| Change first bound variable in an ordered-pair class abstraction, using explicit substitution. Usage of this theorem is discouraged because it depends on ~ ax-13 . See ~ cbvopab1 for a version with more disjoint variable conditions, but not requiring ~ ax-13 . (Contributed by NM, 6-Oct-2004.) (Revised by Mario Carneiro, 14-Oct-2016.) (New usage is discouraged.)
theorem cbvopab1g {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wnf z ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv z)) (wb ph ps) $ >
  $ wceq (copab x3 y1 ph) (copab z y1 ps) $;

--| Change second bound variable in an ordered-pair class abstraction, using explicit substitution. (Contributed by NM, 22-Aug-2013.)
theorem cbvopab2 {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wnf z ph $ >
  $ wnf y1 ps $ >
  $ wi (wceq (cv y1) (cv z)) (wb ph ps) $ >
  $ wceq (copab x3 y1 ph) (copab x3 z ps) $;

--| Change first bound variable in an ordered-pair class abstraction, using explicit substitution. (Contributed by NM, 31-Jul-2003.)
theorem cbvopab1s {x3 y1 z: setvar} (ph: wff x3 y1):
  $ wceq (copab x3 y1 ph) (copab z y1 (wsb x3 ph z)) $;

--| Rule used to change the first bound variable in an ordered pair abstraction, using implicit substitution. (Contributed by NM, 31-Jul-2003.) (Proof shortened by Eric Schmidt, 4-Apr-2007.) Reduce axiom usage. (Revised by GG, 17-Nov-2024.)
theorem cbvopab1v {x3 y1 z: setvar} (ph: wff x3 y1) (ps: wff y1 z):
  $ wi (wceq (cv x3) (cv z)) (wb ph ps) $ >
  $ wceq (copab x3 y1 ph) (copab z y1 ps) $;

--| Rule used to change the second bound variable in an ordered pair abstraction, using implicit substitution. (Contributed by NM, 2-Sep-1999.)
theorem cbvopab2v {x3 y1 z: setvar} (ph: wff x3 y1) (ps: wff x3 z):
  $ wi (wceq (cv y1) (cv z)) (wb ph ps) $ >
  $ wceq (copab x3 y1 ph) (copab x3 z ps) $;

--| Union of two ordered pair class abstractions. (Contributed by NM, 30-Sep-2002.)
theorem unopab {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wceq (cun (copab x3 y1 ph) (copab x3 y1 ps)) (copab x3 y1 (wo ph ps)) $;

--| Extend the definition of a class to include maps-to notation for defining a function via a rule.
term cmpt {x3: setvar} (A2 B2: class x3): class;

--| Define maps-to notation for defining a function via a rule. Read as "the function which maps ` x ` (in ` A ` ) to ` B ( x ) ` ". The class expression ` B ` is the value of the function at ` x ` and normally contains the variable ` x ` . An example is the square function for complex numbers, ` ( x e. CC |-> ( x ^ 2 ) ) ` . Similar to the definition of mapping in [ChoquetDD] p. 2. (Contributed by NM, 17-Feb-2008.)
axiom df_mpt {x3 y1: setvar} (A2 B2: class x3):
  $ wceq (cmpt x3 A2 B2) (copab x3 y1 (wa (wcel (cv x3) A2) (wceq (cv y1) B2))) $;

--| An equality inference for the maps-to notation. (Contributed by Glauco Siliprandi, 23-Oct-2021.) Remove dependency on ~ ax-10 . (Revised by SN, 11-Nov-2024.)
theorem mpteq12da {x3: setvar} (ph: wff x3) (A2 B2 C D: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wceq A2 C) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wceq B2 D) $ >
  $ wi ph (wceq (cmpt x3 A2 B2) (cmpt x3 C D)) $;

--| An equality inference for the maps-to notation. Compare ~ mpteq12dv . (Contributed by Scott Fenton, 8-Aug-2013.) (Revised by Mario Carneiro, 11-Dec-2016.) (Proof shortened by SN, 11-Nov-2024.)
theorem mpteq12df {x3: setvar} (ph: wff x3) (A2 B2 C D: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wceq A2 C) $ >
  $ wi ph (wceq B2 D) $ >
  $ wi ph (wceq (cmpt x3 A2 B2) (cmpt x3 C D)) $;

--| An equality theorem for the maps-to notation. (Contributed by Mario Carneiro, 16-Dec-2013.)
theorem mpteq12f {x3: setvar} (A2 B2 C D: class x3):
  $ wi (wa (wal x3 (wceq A2 C)) (wral x3 (wceq B2 D) A2)) (wceq (cmpt x3 A2 B2) (cmpt x3 C D)) $;

--| An equality inference for the maps-to notation. (Contributed by Mario Carneiro, 26-Jan-2017.) Remove dependency on ~ ax-10 , ~ ax-12 . (Revised by SN, 11-Nov-2024.)
theorem mpteq12dva {x3: setvar} (ph: wff) (A2 B2 C D: class x3):
  $ wi ph (wceq A2 C) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wceq B2 D) $ >
  $ wi ph (wceq (cmpt x3 A2 B2) (cmpt x3 C D)) $;

--| An equality inference for the maps-to notation. (Contributed by NM, 24-Aug-2011.) (Revised by Mario Carneiro, 16-Dec-2013.) Remove dependency on ~ ax-10 , ~ ax-12 . (Revised by SN and GG, 1-Dec-2023.)
theorem mpteq12dv {x3: setvar} (ph: wff) (A2 B2 C D: class x3):
  $ wi ph (wceq A2 C) $ >
  $ wi ph (wceq B2 D) $ >
  $ wi ph (wceq (cmpt x3 A2 B2) (cmpt x3 C D)) $;

--| An equality theorem for the maps-to notation. (Contributed by NM, 16-Dec-2013.)
theorem mpteq12 {x3: setvar} (A2: class) (B2: class x3) (C: class) (D: class x3):
  $ wi (wa (wceq A2 C) (wral x3 (wceq B2 D) A2)) (wceq (cmpt x3 A2 B2) (cmpt x3 C D)) $;

--| An equality theorem for the maps-to notation. (Contributed by Mario Carneiro, 16-Dec-2013.) (Proof shortened by SN, 11-Nov-2024.)
theorem mpteq1 {x3: setvar} (A2 B2: class) (C: class x3):
  $ wi (wceq A2 B2) (wceq (cmpt x3 A2 C) (cmpt x3 B2 C)) $;

--| An equality theorem for the maps-to notation. (Contributed by Mario Carneiro, 11-Jun-2016.)
theorem mpteq1d {x3: setvar} (ph: wff x3) (A2 B2: class) (C: class x3):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cmpt x3 A2 C) (cmpt x3 B2 C)) $;

--| An equality theorem for the maps-to notation. (Contributed by Glauco Siliprandi, 17-Aug-2020.) Remove all disjoint variable conditions. (Revised by SN, 11-Nov-2024.)
theorem mpteq1i {x3: setvar} (A2 B2 C: class x3):
  $ wceq A2 B2 $ >
  $ wceq (cmpt x3 A2 C) (cmpt x3 B2 C) $;

--| Slightly more general equality inference for the maps-to notation. (Contributed by FL, 14-Sep-2013.) (Revised by Mario Carneiro, 16-Dec-2013.) (Proof shortened by SN, 11-Nov-2024.)
theorem mpteq2da {x3: setvar} (ph: wff x3) (A2 B2 C: class x3):
  $ wnf x3 ph $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wceq B2 C) $ >
  $ wi ph (wceq (cmpt x3 A2 B2) (cmpt x3 A2 C)) $;

--| Slightly more general equality inference for the maps-to notation. (Contributed by Scott Fenton, 25-Apr-2012.) Remove dependency on ~ ax-10 . (Revised by SN, 11-Nov-2024.)
theorem mpteq2dva {x3: setvar} (ph: wff) (A2 B2 C: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wceq B2 C) $ >
  $ wi ph (wceq (cmpt x3 A2 B2) (cmpt x3 A2 C)) $;

--| An equality inference for the maps-to notation. (Contributed by Mario Carneiro, 23-Aug-2014.)
theorem mpteq2dv {x3: setvar} (ph: wff) (A2 B2 C: class x3):
  $ wi ph (wceq B2 C) $ >
  $ wi ph (wceq (cmpt x3 A2 B2) (cmpt x3 A2 C)) $;

--| An equality inference for the maps-to notation. (Contributed by Mario Carneiro, 16-Dec-2013.) (Proof shortened by SN, 11-Nov-2024.)
theorem mpteq2ia {x3: setvar} (A2 B2 C: class x3):
  $ wi (wcel (cv x3) A2) (wceq B2 C) $ >
  $ wceq (cmpt x3 A2 B2) (cmpt x3 A2 C) $;

--| An equality inference for the maps-to notation. (Contributed by Mario Carneiro, 16-Dec-2013.)
theorem mpteq2i {x3: setvar} (A2 B2 C: class x3):
  $ wceq B2 C $ >
  $ wceq (cmpt x3 A2 B2) (cmpt x3 A2 C) $;

--| An equality inference for the maps-to notation. (Contributed by Scott Fenton, 27-Oct-2010.) (Revised by Mario Carneiro, 16-Dec-2013.)
theorem mpteq12i {x3: setvar} (A2 B2 C D: class x3):
  $ wceq A2 C $ >
  $ wceq B2 D $ >
  $ wceq (cmpt x3 A2 B2) (cmpt x3 C D) $;

--| Bound-variable hypothesis builder for the maps-to notation. (Contributed by NM, 20-Feb-2013.)
theorem nfmpt {x3 y1: setvar} (A2 B2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 (cmpt y1 A2 B2) $;

--| Bound-variable hypothesis builder for the maps-to notation. (Contributed by FL, 17-Feb-2008.)
theorem nfmpt1 {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 (cmpt x3 A2 B2) $;

--| Rule to change the bound variable in a maps-to function, using implicit substitution. This version has bound-variable hypotheses in place of distinct variable conditions. (Contributed by NM, 11-Sep-2011.) (Revised by Thierry Arnoux, 9-Mar-2017.) Add disjoint variable condition to avoid ~ ax-13 . See ~ cbvmptfg for a less restrictive version requiring more axioms. (Revised by GG, 17-Jan-2024.)
theorem cbvmptf {x3 y1: setvar} (A2 B2 C: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wnfc y1 B2 $ >
  $ wnfc x3 C $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 C) $ >
  $ wceq (cmpt x3 A2 B2) (cmpt y1 A2 C) $;

--| Rule to change the bound variable in a maps-to function, using implicit substitution. This version has bound-variable hypotheses in place of distinct variable conditions. Usage of this theorem is discouraged because it depends on ~ ax-13 . See ~ cbvmptf for a version with more disjoint variable conditions, but not requiring ~ ax-13 . (Contributed by NM, 11-Sep-2011.) (Revised by Thierry Arnoux, 9-Mar-2017.) (New usage is discouraged.)
theorem cbvmptfg {x3 y1: setvar} (A2 B2 C: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wnfc y1 B2 $ >
  $ wnfc x3 C $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 C) $ >
  $ wceq (cmpt x3 A2 B2) (cmpt y1 A2 C) $;

--| Rule to change the bound variable in a maps-to function, using implicit substitution. This version has bound-variable hypotheses in place of distinct variable conditions. (Contributed by NM, 11-Sep-2011.) Add disjoint variable condition to avoid ~ ax-13 . See ~ cbvmptg for a less restrictive version requiring more axioms. (Revised by GG, 17-Jan-2024.)
theorem cbvmpt {x3 y1: setvar} (A2: class) (B2 C: class x3 y1):
  $ wnfc y1 B2 $ >
  $ wnfc x3 C $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 C) $ >
  $ wceq (cmpt x3 A2 B2) (cmpt y1 A2 C) $;

--| Rule to change the bound variable in a maps-to function, using implicit substitution. This version has bound-variable hypotheses in place of distinct variable conditions. Usage of this theorem is discouraged because it depends on ~ ax-13 . See ~ cbvmpt for a version with more disjoint variable conditions, but not requiring ~ ax-13 . (Contributed by NM, 11-Sep-2011.) (New usage is discouraged.)
theorem cbvmptg {x3 y1: setvar} (A2: class) (B2 C: class x3 y1):
  $ wnfc y1 B2 $ >
  $ wnfc x3 C $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 C) $ >
  $ wceq (cmpt x3 A2 B2) (cmpt y1 A2 C) $;

--| Rule to change the bound variable in a maps-to function, using implicit substitution. (Contributed by Mario Carneiro, 19-Feb-2013.) Add disjoint variable condition to avoid auxiliary axioms . See ~ cbvmptvg for a less restrictive version requiring more axioms. (Revised by GG, 17-Nov-2024.)
theorem cbvmptv {x3 y1: setvar} (A2: class) (B2: class x3) (C: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 C) $ >
  $ wceq (cmpt x3 A2 B2) (cmpt y1 A2 C) $;

--| Rule to change the bound variable in a maps-to function, using implicit substitution. Usage of this theorem is discouraged because it depends on ~ ax-13 . See ~ cbvmptv for a version with more disjoint variable conditions, but not requiring ~ ax-13 . (Contributed by Mario Carneiro, 19-Feb-2013.) (New usage is discouraged.)
theorem cbvmptvg {x3 y1: setvar} (A2: class) (B2: class x3) (C: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 C) $ >
  $ wceq (cmpt x3 A2 B2) (cmpt y1 A2 C) $;

--| Function with universal domain in maps-to notation. (Contributed by NM, 16-Aug-2013.)
theorem mptv {x3 y1: setvar} (B2: class x3):
  $ wceq (cmpt x3 cvv B2) (copab x3 y1 (wceq (cv y1) B2)) $;

--| Extend wff notation to include transitive classes. Notation from [TakeutiZaring] p. 35.
term wtr (A2: class): wff;

--| Define the transitive class predicate. Not to be confused with a transitive relation (see ~ cotr ). Definition of [Enderton] p. 71 extended to arbitrary classes. For alternate definitions, see ~ dftr2 (which is suggestive of the word "transitive"), ~ dftr2c , ~ dftr3 , ~ dftr4 , ~ dftr5 , and (when ` A ` is a set) ~ unisuc . The term "complete" is used instead of "transitive" in Definition 3 of [Suppes] p. 130. (Contributed by NM, 29-Aug-1993.)
axiom df_tr (A2: class):
  $ wb (wtr A2) (wss (cuni A2) A2) $;

--| An alternate way of defining a transitive class. Exercise 7 of [TakeutiZaring] p. 40. Using ~ dftr2c instead may avoid dependences on ~ ax-11 . (Contributed by NM, 24-Apr-1994.)
theorem dftr2 {x3 y1: setvar} (A2: class):
  $ wb (wtr A2) (wal x3 (wal y1 (wi (wa (wcel (cv x3) (cv y1)) (wcel (cv y1) A2)) (wcel (cv x3) A2)))) $;

--| Variant of ~ dftr2 with commuted quantifiers, useful for shortening proofs and avoiding ~ ax-11 . (Contributed by BTernaryTau, 28-Dec-2024.)
theorem dftr2c {x3 y1: setvar} (A2: class):
  $ wb (wtr A2) (wal y1 (wal x3 (wi (wa (wcel (cv x3) (cv y1)) (wcel (cv y1) A2)) (wcel (cv x3) A2)))) $;

--| An alternate way of defining a transitive class. Definition 1.1 of [Schloeder] p. 1. (Contributed by NM, 20-Mar-2004.) Avoid ~ ax-11 . (Revised by BTernaryTau, 28-Dec-2024.)
theorem dftr5 {x3 y1: setvar} (A2: class):
  $ wb (wtr A2) (wral x3 (wral y1 (wcel (cv y1) A2) (cv x3)) A2) $;

--| An alternate way of defining a transitive class. Definition 7.1 of [TakeutiZaring] p. 35. (Contributed by NM, 29-Aug-1993.)
theorem dftr3 {x3: setvar} (A2: class):
  $ wb (wtr A2) (wral x3 (wss (cv x3) A2) A2) $;

--| An alternate way of defining a transitive class. Definition of [Enderton] p. 71. (Contributed by NM, 29-Aug-1993.)
theorem dftr4 (A2: class):
  $ wb (wtr A2) (wss A2 (cpw A2)) $;

--| Equality theorem for the transitive class predicate. (Contributed by NM, 17-Sep-1993.)
theorem treq (A2 B2: class):
  $ wi (wceq A2 B2) (wb (wtr A2) (wtr B2)) $;

--| In a transitive class, the membership relation is transitive. (Contributed by NM, 19-Apr-1994.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem trel (A2 B2 C: class):
  $ wi (wtr A2) (wi (wa (wcel B2 C) (wcel C A2)) (wcel B2 A2)) $;

--| In a transitive class, the membership relation is transitive. (Contributed by NM, 19-Apr-1994.)
theorem trel3 (A2 B2 C D: class):
  $ wi (wtr A2) (wi (w3a (wcel B2 C) (wcel C D) (wcel D A2)) (wcel B2 A2)) $;

--| An element of a transitive class is a subset of the class. (Contributed by NM, 7-Aug-1994.) (Proof shortened by JJ, 26-Jul-2021.)
theorem trss (A2 B2: class):
  $ wi (wtr A2) (wi (wcel B2 A2) (wss B2 A2)) $;

--| The union of transitive classes is transitive. (Contributed by Eric Schmidt, 19-Apr-2026.)
theorem trun (A2 B2: class):
  $ wi (wa (wtr A2) (wtr B2)) (wtr (cun A2 B2)) $;

--| The intersection of transitive classes is transitive. (Contributed by NM, 9-May-1994.)
theorem trin (A2 B2: class):
  $ wi (wa (wtr A2) (wtr B2)) (wtr (cin A2 B2)) $;

--| The empty set is transitive. (Contributed by NM, 16-Sep-1993.)
theorem tr0:
  $ wtr c0 $;

--| The universe is transitive. (Contributed by NM, 14-Sep-2003.)
theorem trv:
  $ wtr cvv $;

--| An indexed union of a class of transitive sets is transitive. (Contributed by Mario Carneiro, 16-Nov-2014.)
theorem triun {x3: setvar} (A2 B2: class x3):
  $ wi (wral x3 (wtr B2) A2) (wtr (ciun x3 A2 B2)) $;

--| The union of a class of transitive sets is transitive. Exercise 5(a) of [Enderton] p. 73. (Contributed by Scott Fenton, 21-Feb-2011.) (Proof shortened by Mario Carneiro, 26-Apr-2014.)
theorem truni {x3: setvar} (A2: class):
  $ wi (wral x3 (wtr (cv x3)) A2) (wtr (cuni A2)) $;

--| An indexed intersection of a class of transitive sets is transitive. (Contributed by BJ, 3-Oct-2022.)
theorem triin {x3: setvar} (A2 B2: class x3):
  $ wi (wral x3 (wtr B2) A2) (wtr (ciin x3 A2 B2)) $;

--| The intersection of a class of transitive sets is transitive. Exercise 5(b) of [Enderton] p. 73. (Contributed by Scott Fenton, 25-Feb-2011.) (Proof shortened by BJ, 3-Oct-2022.)
theorem trint {x3: setvar} (A2: class):
  $ wi (wral x3 (wtr (cv x3)) A2) (wtr (cint A2)) $;

--| Any nonempty transitive class includes its intersection. Exercise 3 in [TakeutiZaring] p. 44 (which mistakenly does not include the nonemptiness hypothesis). (Contributed by Scott Fenton, 3-Mar-2011.) (Proof shortened by Andrew Salmon, 14-Nov-2011.)
theorem trintss (A2: class):
  $ wi (wa (wtr A2) (wne A2 c0)) (wss (cint A2) A2) $;

--| Axiom of Replacement. An axiom scheme of Zermelo-Fraenkel set theory. Axiom 5 of [TakeutiZaring] p. 19. It tells us that the image of any set under a function is also a set (see the variant ~ funimaex ). Although ` ph ` may be any wff whatsoever, this axiom is useful (i.e. its antecedent is satisfied) when we are given some function and ` ph ` encodes the predicate "the value of the function at ` w ` is ` z ` ". Thus, ` ph ` will ordinarily have free variables ` w ` and ` z ` - think of it informally as ` ph ( w , z ) ` . We prefix ` ph ` with the quantifier ` A. y ` in order to "protect" the axiom from any ` ph ` containing ` y ` , thus allowing us to eliminate any restrictions on ` ph ` . Another common variant is derived as ~ axrep5 , where you can find some further remarks. A slightly more compact version is shown as ~ axrep2 . A quite different variant is ~ zfrep6 , which if used in place of ~ ax-rep would also require that the Separation Scheme ~ axsep be stated as a separate axiom. There is a very strong generalization of Replacement that doesn't demand function-like behavior of ` ph ` . Two versions of this generalization are called the Collection Principle ~ cp and the Boundedness Axiom ~ bnd . Many developments of set theory distinguish the uses of Replacement from uses of the weaker axioms of Separation ~ axsep , Null Set ~ axnul , and Pairing ~ axpr , all of which we derive from Replacement. In order to make it easier to identify the uses of those redundant axioms, we restate them as Axioms ~ ax-sep , ~ ax-nul , and ~ ax-pr below the theorems that prove them. (Contributed by NM, 23-Dec-1993.)
axiom ax_rep {y1 z w: setvar} (ph: wff y1 z w) (x3: setvar):
  $ wi (wal w (wex y1 (wal z (wi (wal y1 ph) (wceq (cv z) (cv y1)))))) (wex y1 (wal z (wb (wcel (cv z) (cv y1)) (wex w (wa (wcel (cv w) (cv x3)) (wal y1 ph)))))) $;

--| The version of the Axiom of Replacement used in the Metamath Solitaire applet ~ https://us.metamath.org/mmsolitaire/mms.html . Equivalence is shown via the path ~ ax-rep ` -> ` ~ axrep1 ` -> ` ~ axrep2 ` -> ` ~ axrepnd ` -> ` ~ zfcndrep = ~ ax-rep . (Contributed by NM, 19-Nov-2005.) (Proof shortened by Mario Carneiro, 17-Nov-2016.) Remove dependency on ~ ax-13 . (Revised by BJ, 31-May-2019.)
theorem axrep1 {x3 y1 z: setvar} (ph: wff x3 z):
  $ wex x3 (wi (wex y1 (wal z (wi ph (wceq (cv z) (cv y1))))) (wal z (wb (wcel (cv z) (cv x3)) (wex x3 (wa (wcel (cv x3) (cv y1)) ph))))) $;

--| Lemma for ~ axrep2 and ~ axrep3 . (Contributed by BJ, 6-Aug-2022.)
theorem axreplem {x3 y1 w v u: setvar} (ph ps ch: wff x3 y1 w v u) (z: setvar):
  $ wi (wceq (cv x3) (cv y1)) (wb (wex u (wi ph (wal v (wb ps (wex w (wa (wcel (cv z) (cv x3)) ch)))))) (wex u (wi ph (wal v (wb ps (wex w (wa (wcel (cv z) (cv y1)) ch))))))) $;

--| Lemma for ~ axrep2 and ~ axrep3 . (Contributed by BJ, 6-Aug-2022.)
theorem axreplem_b {x3 y1 w v: setvar} (ph ps ch: wff x3 y1 w v):
  $ wi (wceq (cv x3) (cv y1)) (wb (wex w (wi ph (wal v (wb ps (wex w (wa (wcel (cv w) (cv x3)) ch)))))) (wex w (wi ph (wal v (wb ps (wex w (wa (wcel (cv w) (cv y1)) ch))))))) $;

--| Axiom of Replacement expressed with the fewest number of different variables and without any restrictions on ` ph ` . (Contributed by NM, 15-Aug-2003.) Remove dependency on ~ ax-13 . (Revised by BJ, 31-May-2019.)
theorem axrep2 {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wex x3 (wi (wex y1 (wal z (wi ph (wceq (cv z) (cv y1))))) (wal z (wb (wcel (cv z) (cv x3)) (wex x3 (wa (wcel (cv x3) (cv y1)) (wal y1 ph)))))) $;

--| Axiom of Replacement slightly strengthened from ~ axrep2 ; ` w ` may occur free in ` ph ` . (Contributed by NM, 2-Jan-1997.) Remove dependency on ~ ax-13 . (Revised by BJ, 31-May-2019.)
theorem axrep3 {x3 y1 z w: setvar} (ph: wff x3 y1 z w):
  $ wex x3 (wi (wex y1 (wal z (wi ph (wceq (cv z) (cv y1))))) (wal z (wb (wcel (cv z) (cv x3)) (wex x3 (wa (wcel (cv x3) (cv w)) (wal y1 ph)))))) $;

--| Version of ~ axrep4 with a disjoint variable condition, requiring fewer axioms. (Contributed by Matthew House, 18-Sep-2025.)
theorem axrep4v {x3 y1 z: setvar} (ph: wff x3 y1) (w: setvar):
  $ wi (wal x3 (wex z (wal y1 (wi ph (wceq (cv y1) (cv z)))))) (wex z (wal y1 (wb (wcel (cv y1) (cv z)) (wex x3 (wa (wcel (cv x3) (cv w)) ph))))) $;

--| A more traditional version of the Axiom of Replacement. (Contributed by NM, 14-Aug-1994.) (Proof shortened by Matthew House, 18-Sep-2025.)
theorem axrep4 {x3 y1 z: setvar} (ph: wff x3 y1 z) (w: setvar):
  $ wnf z ph $ >
  $ wi (wal x3 (wex z (wal y1 (wi ph (wceq (cv y1) (cv z)))))) (wex z (wal y1 (wb (wcel (cv y1) (cv z)) (wex x3 (wa (wcel (cv x3) (cv w)) ph))))) $;

--| Axiom of Replacement (similar to Axiom Rep of [BellMachover] p. 463). The antecedent tells us ` ph ` is analogous to a "function" from ` x ` to ` y ` (although it is not really a function since it is a wff and not a class). In the consequent we postulate the existence of a set ` z ` that corresponds to the "image" of ` ph ` restricted to some other set ` w ` . The hypothesis says ` z ` must not be free in ` ph ` . (Contributed by NM, 26-Nov-1995.) (Revised by Mario Carneiro, 14-Oct-2016.)
theorem axrep5 {x3 y1 z: setvar} (ph: wff x3 y1 z) (w: setvar):
  $ wnf z ph $ >
  $ wi (wal x3 (wi (wcel (cv x3) (cv w)) (wex z (wal y1 (wi ph (wceq (cv y1) (cv z))))))) (wex z (wal y1 (wb (wcel (cv y1) (cv z)) (wex x3 (wa (wcel (cv x3) (cv w)) ph))))) $;

--| A condensed form of ~ ax-rep . (Contributed by SN, 18-Sep-2023.) (Proof shortened by Matthew House, 18-Sep-2025.)
theorem axrep6 {y1 z w: setvar} (ph: wff z w) (x3: setvar):
  $ wi (wal w (wmo z ph)) (wex y1 (wal z (wb (wcel (cv z) (cv y1)) (wrex w ph (cv x3))))) $;

--| A lemma for variants of the axiom of replacement: if we can form the set of images of the functional relation, then we can also form a set containing all its images. The converse requires the axiom of separation. (Contributed by BJ, 5-Apr-2026.)
theorem replem {x3 y1 w: setvar} (ph: wff x3 y1) (z: setvar):
  $ wi (wa (wral x3 (wex y1 ph) (cv z)) (wex w (wal y1 (wb (wcel (cv y1) (cv w)) (wrex x3 ph (cv z)))))) (wex w (wral x3 (wrex y1 ph (cv w)) (cv z))) $;

--| A version of the Axiom of Replacement. Normally ` ph ` would have free variables ` x ` and ` y ` . Axiom 6 of [Kunen] p. 12. The Separation Scheme ~ ax-sep cannot be derived from this version and must be stated as a separate axiom in an axiom system (such as Kunen's) that uses this version in place of our ~ ax-rep . (Contributed by NM, 10-Oct-2003.) Shorten proof and reduce axiom dependencies. (Revised by BJ, 5-Apr-2026.)
theorem zfrep6 {x3 y1 w: setvar} (ph: wff x3 y1) (z: setvar):
  $ wi (wral x3 (weu y1 ph) (cv z)) (wex w (wral x3 (wrex y1 ph (cv w)) (cv z))) $;

--| ~ axrep6 in class notation. It is equivalent to both ~ ax-rep and ~ abrexexg , providing a direct link between the two. (Contributed by SN, 11-Dec-2024.)
theorem axrep6g {x3 y1: setvar} (ps: wff x3 y1) (A2: class) (V: class x3 y1):
  $ wi (wa (wcel A2 V) (wal x3 (wmo y1 ps))) (wcel (cab y1 (wrex x3 ps A2)) cvv) $;

--| An inference based on the Axiom of Replacement. Typically, ` ph ` defines a function from ` x ` to ` y ` . (Contributed by NM, 26-Nov-1995.)
theorem zfrepclf {x3 y1 z: setvar} (ph: wff x3 y1) (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wcel A2 cvv $ >
  $ wi (wcel (cv x3) A2) (wex z (wal y1 (wi ph (wceq (cv y1) (cv z))))) $ >
  $ wex z (wal y1 (wb (wcel (cv y1) (cv z)) (wex x3 (wa (wcel (cv x3) A2) ph)))) $;

--| An inference based on the Axiom of Replacement. Typically, ` ph ` defines a function from ` x ` to ` y ` . (Contributed by NM, 26-Nov-1995.)
theorem zfrep3cl {x3 y1 z: setvar} (ph: wff x3 y1) (A2: class):
  $ wcel A2 cvv $ >
  $ wi (wcel (cv x3) A2) (wex z (wal y1 (wi ph (wceq (cv y1) (cv z))))) $ >
  $ wex z (wal y1 (wb (wcel (cv y1) (cv z)) (wex x3 (wa (wcel (cv x3) A2) ph)))) $;

--| A version of Replacement using class abstractions. (Contributed by NM, 26-Nov-1995.)
theorem zfrep4 {x3 y1 z: setvar} (ph: wff x3) (ps: wff x3 y1):
  $ wcel (cab x3 ph) cvv $ >
  $ wi ph (wex z (wal y1 (wi ps (wceq (cv y1) (cv z))))) $ >
  $ wcel (cab y1 (wex x3 (wa ph ps))) cvv $;

--| A more general version ~ axsepg of the axiom scheme of separation ~ ax-sep derived from the axiom scheme of replacement ~ ax-rep (and first-order logic). The extra generality consists in the absence of a disjoint variable condition on ` z , ph ` (that is, variable ` z ` may occur in formula ` ph ` ). See linked statements for more information. (Contributed by NM, 11-Sep-2006.) Remove dependencies on ~ ax-9 to ~ ax-13 . (Revised by SN, 25-Sep-2023.) Use ~ ax-sep instead (or ~ axsepg if the extra generality is needed). (New usage is discouraged.)
theorem axsepgfromrep {x3 y1: setvar} (ph: wff x3) (z: setvar):
  $ wex y1 (wal x3 (wb (wcel (cv x3) (cv y1)) (wa (wcel (cv x3) (cv z)) ph))) $;

--| Axiom scheme of separation ~ ax-sep derived from the axiom scheme of replacement ~ ax-rep . The statement is identical to that of ~ ax-sep , and therefore shows that ~ ax-sep is redundant when ~ ax-rep is allowed. See ~ ax-sep for more information. (Contributed by NM, 11-Sep-2006.) Use ~ ax-sep instead. (New usage is discouraged.)
theorem axsep {x3 y1: setvar} (ph: wff x3) (z: setvar):
  $ wex y1 (wal x3 (wb (wcel (cv x3) (cv y1)) (wa (wcel (cv x3) (cv z)) ph))) $;

--| Axiom scheme of separation ~ ax-sep derived from the axiom scheme of replacement ~ ax-rep . The statement is identical to that of ~ ax-sep , and therefore shows that ~ ax-sep is redundant when ~ ax-rep is allowed. See ~ ax-sep for more information. (Contributed by NM, 11-Sep-2006.) Use ~ ax-sep instead. (New usage is discouraged.)
theorem ax_sep {x3 y1: setvar} (ph: wff x3) (z: setvar):
  $ wex y1 (wal x3 (wb (wcel (cv x3) (cv y1)) (wa (wcel (cv x3) (cv z)) ph))) $;

--| A more general version of the axiom scheme of separation ~ ax-sep , where variable ` z ` can also occur (in addition to ` x ` ) in formula ` ph ` , which can therefore be thought of as ` ph ( x , z ) ` . This version is derived from the more restrictive ~ ax-sep with no additional set theory axioms. Note that it was also derived from ~ ax-rep but without ~ ax-sep as ~ axsepgfromrep . (Contributed by NM, 10-Dec-2006.) (Proof shortened by Mario Carneiro, 17-Nov-2016.) Remove dependency on ~ ax-12 and ~ ax-13 and shorten proof. (Revised by BJ, 6-Oct-2019.)
theorem axsepg {x3 y1 z: setvar} (ph: wff x3 z):
  $ wex y1 (wal x3 (wb (wcel (cv x3) (cv y1)) (wa (wcel (cv x3) (cv z)) ph))) $;

--| Version of the axiom of separation where the "containing set" is a class variable and the sethood assumption is in the antecedent. (Contributed by NM, 21-Jun-1993.) Put ~ sepgi in closed form. (Revised by BJ, 2-Jul-2022.)
theorem sepg {x3 y1: setvar} (ph: wff x3) (A2: class) (V: class x3 y1):
  $ wi (wcel A2 V) (wex y1 (wal x3 (wb (wcel (cv x3) (cv y1)) (wa (wcel (cv x3) A2) ph)))) $;

--| Inference associated with ~ sepg . The requirement that ` y ` not occur in ` ph ` is necessary, as ~ notsep shows. (Contributed by NM, 21-Jun-1993.) (Revised by BJ, 14-Jul-2026.)
theorem sepgi {x3 y1: setvar} (ph: wff x3) (A2: class):
  $ wcel A2 cvv $ >
  $ wex y1 (wal x3 (wb (wcel (cv x3) (cv y1)) (wa (wcel (cv x3) A2) ph))) $;

--| Obsolete version of ~ sepgi as of 14-Jul-2026. (Contributed by NM, 21-Jun-1993.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem zfausclOLD {x3 y1: setvar} (ph: wff x3) (A2: class):
  $ wcel A2 cvv $ >
  $ wex y1 (wal x3 (wb (wcel (cv x3) (cv y1)) (wa (wcel (cv x3) A2) ph))) $;

--| Lemma for ~ sepex . Use ~ sepex instead. (Contributed by Matthew House, 19-Sep-2025.) (New usage is discouraged.)
theorem sepexlem {x3 y1 z: setvar} (ph: wff x3):
  $ wi (wex y1 (wal x3 (wi ph (wcel (cv x3) (cv y1))))) (wex z (wal x3 (wb (wcel (cv x3) (cv z)) ph))) $;

--| Convert implication to equivalence within an existence statement using the Separation Scheme (Aussonderung) ~ ax-sep . Similar to Theorem 1.3(ii) of [BellMachover] p. 463. (Contributed by Matthew House, 19-Sep-2025.)
theorem sepex {x3 y1 z: setvar} (ph: wff x3):
  $ wi (wex y1 (wal x3 (wi ph (wcel (cv x3) (cv y1))))) (wex z (wal x3 (wb (wcel (cv x3) (cv z)) ph))) $;

--| Convert implication to equivalence within an existence statement using the Separation Scheme (Aussonderung) ~ ax-sep . Similar to Theorem 1.3(ii) of [BellMachover] p. 463. (Contributed by Matthew House, 19-Sep-2025.)
theorem sepex_b {x3 y1: setvar} (ph: wff x3):
  $ wi (wex y1 (wal x3 (wi ph (wcel (cv x3) (cv y1))))) (wex y1 (wal x3 (wb (wcel (cv x3) (cv y1)) ph))) $;

--| Convert implication to equivalence within an existence statement using the Separation Scheme (Aussonderung) ~ ax-sep . Inference associated with ~ sepex . (Contributed by NM, 21-Jun-1993.) Generalize conclusion, extract closed form, and avoid ~ ax-9 . (Revised by Matthew House, 19-Sep-2025.)
theorem sepexi {x3 y1 z: setvar} (ph: wff x3):
  $ wex y1 (wal x3 (wi ph (wcel (cv x3) (cv y1)))) $ >
  $ wex z (wal x3 (wb (wcel (cv x3) (cv z)) ph)) $;

--| Convert implication to equivalence within an existence statement using the Separation Scheme (Aussonderung) ~ ax-sep . Inference associated with ~ sepex . (Contributed by NM, 21-Jun-1993.) Generalize conclusion, extract closed form, and avoid ~ ax-9 . (Revised by Matthew House, 19-Sep-2025.)
theorem sepexi_b {x3 y1: setvar} (ph: wff x3):
  $ wex y1 (wal x3 (wi ph (wcel (cv x3) (cv y1)))) $ >
  $ wex y1 (wal x3 (wb (wcel (cv x3) (cv y1)) ph)) $;

--| Derive ~ ax6v (a weakened version of ~ ax-6 where ` x ` and ` y ` must be distinct), from Separation ~ ax-sep and Extensionality ~ ax-ext . See ~ ax6 for the derivation of ~ ax-6 from ~ ax6v . (Contributed by NM, 12-Nov-2013.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ax6vsep {x3: setvar} (y1: setvar):
  $ wn (wal x3 (wn (wceq (cv x3) (cv y1)))) $;

--| Alternate proof of ~ axnul , proved from propositional calculus, ~ ax-gen , ~ ax-4 , ~ sp , and ~ ax-rep . To check this, replace ~ sp with the obsolete axiom ~ ax-c5 in the proof of ~ axnulALT and type the Metamath program "MM> SHOW TRACE__BACK axnulALT / AXIOMS" command. (Contributed by Jeff Hoffman, 3-Feb-2008.) (Proof shortened by Mario Carneiro, 17-Nov-2016.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem axnulALT {x3 y1: setvar}:
  $ wex x3 (wal y1 (wn (wcel (cv y1) (cv x3)))) $;

--| The Null Set Axiom of ZF set theory: there exists a set with no elements. Axiom of Empty Set of [Enderton] p. 18. In some textbooks, this is presented as a separate axiom; here we show it can be derived from Separation ~ ax-sep . This version of the Null Set Axiom tells us that at least one empty set exists, but does not tell us that it is unique - we need the Axiom of Extensionality to do that (see ~ nulmo ). This proof, suggested by Jeff Hoffman, uses only ~ ax-4 and ~ ax-gen from predicate calculus, which are valid in "free logic" i.e. logic holding in an empty domain (see Axiom A5 and Rule R2 of [LeBlanc] p. 277). Thus, our ~ ax-sep implies the existence of at least one set. Note that Kunen's version of ~ ax-sep (Axiom 3 of [Kunen] p. 11) does not imply the existence of a set because his is universally closed, i.e., prefixed with universal quantifiers to eliminate all free variables. His existence is provided by a separate axiom stating ` E. x x = x ` (Axiom 0 of [Kunen] p. 10). See ~ axnulALT for a proof directly from ~ ax-rep . This theorem should not be referenced by any proof. Instead, use ~ ax-nul below so that the uses of the Null Set Axiom can be more easily identified. (Contributed by Jeff Hoffman, 3-Feb-2008.) (Revised by NM, 4-Feb-2008.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem axnul {x3 y1: setvar}:
  $ wex x3 (wal y1 (wn (wcel (cv y1) (cv x3)))) $;

--| The Null Set Axiom of ZF set theory: there exists a set with no elements. Axiom of Empty Set of [Enderton] p. 18. In some textbooks, this is presented as a separate axiom; here we show it can be derived from Separation ~ ax-sep . This version of the Null Set Axiom tells us that at least one empty set exists, but does not tell us that it is unique - we need the Axiom of Extensionality to do that (see ~ nulmo ). This proof, suggested by Jeff Hoffman, uses only ~ ax-4 and ~ ax-gen from predicate calculus, which are valid in "free logic" i.e. logic holding in an empty domain (see Axiom A5 and Rule R2 of [LeBlanc] p. 277). Thus, our ~ ax-sep implies the existence of at least one set. Note that Kunen's version of ~ ax-sep (Axiom 3 of [Kunen] p. 11) does not imply the existence of a set because his is universally closed, i.e., prefixed with universal quantifiers to eliminate all free variables. His existence is provided by a separate axiom stating ` E. x x = x ` (Axiom 0 of [Kunen] p. 10). See ~ axnulALT for a proof directly from ~ ax-rep . This theorem should not be referenced by any proof. Instead, use ~ ax-nul below so that the uses of the Null Set Axiom can be more easily identified. (Contributed by Jeff Hoffman, 3-Feb-2008.) (Revised by NM, 4-Feb-2008.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem ax_nul {x3 y1: setvar}:
  $ wex x3 (wal y1 (wn (wcel (cv y1) (cv x3)))) $;

--| The Null Set Axiom of ZF set theory: the empty set exists. Corollary 5.16 of [TakeutiZaring] p. 20. For the unabbreviated version, see ~ ax-nul . (Contributed by NM, 21-Jun-1993.) (Proof shortened by Andrew Salmon, 9-Jul-2011.)
theorem _0ex:
  $ wcel c0 cvv $;

--| The empty set is the unique class which is a subclass of any set. (Contributed by AV, 24-Aug-2022.)
theorem al0ssb {y1: setvar} (X: class):
  $ wb (wal y1 (wss X (cv y1))) (wceq X c0) $;

--| Alternate proof of ~ sseli illustrating the use of the weak deduction theorem to prove it from the inference ~ sselii . (Contributed by NM, 24-Aug-2018.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem sseliALT (A2 B2 C: class):
  $ wss A2 B2 $ >
  $ wi (wcel C A2) (wcel C B2) $;

--| The existence of proper substitution into a class. (Contributed by NM, 10-Nov-2005.) (Revised by NM, 17-Aug-2018.)
theorem csbexg {x3: setvar} (A2 B2 W: class x3):
  $ wi (wal x3 (wcel B2 W)) (wcel (csb x3 A2 B2) cvv) $;

--| The existence of proper substitution into a class. (Contributed by NM, 7-Aug-2007.) (Proof shortened by Andrew Salmon, 29-Jun-2011.) (Revised by NM, 17-Aug-2018.)
theorem csbex {x3: setvar} (A2 B2: class x3):
  $ wcel B2 cvv $ >
  $ wcel (csb x3 A2 B2) cvv $;

--| A version of ~ unisn without the ` A e. _V ` hypothesis. (Contributed by Stefan Allan, 14-Mar-2006.)
theorem unisn2 (A2: class):
  $ wcel (cuni (csn A2)) (cpr c0 A2) $;

--| For any set ` x ` , there is a set not contained in ` x ` . The proof is based on Russell's paradox. (Contributed by NM, 23-Aug-1993.) Remove use of ~ ax-12 and ~ ax-13 . (Revised by BJ, 31-May-2019.) Extract from ~ nalset . (Revised by Matthew House, 12-Apr-2026.)
theorem exnelv {y1: setvar} (x3: setvar):
  $ wex y1 (wn (wcel (cv y1) (cv x3))) $;

--| No set contains all sets. Theorem 41 of [Suppes] p. 30. (Contributed by NM, 23-Aug-1993.) Extract ~ exnelv . (Revised by Matthew House, 12-Apr-2026.)
theorem nalset {x3 y1: setvar}:
  $ wn (wex x3 (wal y1 (wcel (cv y1) (cv x3)))) $;

--| Obsolete version of ~ nalset as of 12-Apr-2026. (Contributed by NM, 23-Aug-1993.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem nalsetOLD {x3 y1: setvar}:
  $ wn (wex x3 (wal y1 (wcel (cv y1) (cv x3)))) $;

--| The universal class is not equal to any setvar. (Contributed by NM, 4-Jul-2005.) Extract from ~ vnex and shorten proof. (Revised by BJ, 25-Apr-2026.)
theorem vneqv (x3: setvar):
  $ wn (wceq (cv x3) cvv) $;

--| The universal class does not exist as a set. (Contributed by NM, 4-Jul-2005.) (Proof shortened by BJ, 25-Apr-2026.)
theorem vnex {x3: setvar}:
  $ wn (wex x3 (wceq (cv x3) cvv)) $;

--| Obsolete proof of ~ vnex as of 25-Apr-2026. (Contributed by NM, 4-Jul-2005.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem vnexOLD {x3: setvar}:
  $ wn (wex x3 (wceq (cv x3) cvv)) $;

--| The universal class does not belong to any class. (Contributed by FL, 31-Dec-2006.) Prove it without using ~ vprc , which is then proved as an instance of it. (Revised by BJ, 1-May-2026.)
theorem nvel (A2: class):
  $ wn (wcel cvv A2) $;

--| If a class is the universal class it doesn't belong to any class, generalization of ~ nvel . (Contributed by Alexander van der Vekens, 26-May-2017.)
theorem nvelim (A2 B2: class):
  $ wi (wceq A2 cvv) (wn (wcel A2 B2)) $;

--| The universal class is not a member of itself (and thus is not a set). Proposition 5.21 of [TakeutiZaring] p. 21; our proof, however, does not depend on the Axiom of Regularity. (Contributed by NM, 23-Aug-1993.) (Proof shortened by BJ, 1-May-2026.)
theorem vprc:
  $ wn (wcel cvv cvv) $;

--| Obsolete proof of ~ vprc , obsolete as of 1-May-2026. (Contributed by NM, 23-Aug-1993.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem vprcOLD:
  $ wn (wcel cvv cvv) $;

--| Obsolete proof of ~ nvel , obsolete as of 1-May-2026. (Contributed by FL, 31-Dec-2006.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem nvelOLD (A2: class):
  $ wn (wcel cvv A2) $;

--| Separation Scheme (Aussonderung) using class notation. Compare Exercise 4 of [TakeutiZaring] p. 22. (Contributed by NM, 21-Jun-1993.)
theorem inex1 (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel (cin A2 B2) cvv $;

--| Separation Scheme (Aussonderung) using class notation. (Contributed by NM, 27-Apr-1994.)
theorem inex2 (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel (cin B2 A2) cvv $;

--| Closed-form, generalized Separation Scheme. (Contributed by NM, 7-Apr-1995.)
theorem inex1g (A2 B2 V: class):
  $ wi (wcel A2 V) (wcel (cin A2 B2) cvv) $;

--| Sufficient condition for an intersection to be a set. Commuted form of ~ inex1g . (Contributed by Peter Mazsa, 19-Dec-2018.)
theorem inex2g (A2 B2 V: class):
  $ wi (wcel A2 V) (wcel (cin B2 A2) cvv) $;

--| A subclass of a set is a set. Exercise 3 of [TakeutiZaring] p. 22 (generalized). (Contributed by NM, 14-Aug-1994.) (Proof shortened by BJ, 18-Jul-2026.)
theorem ssexg (A2 B2 C: class):
  $ wi (wa (wss A2 B2) (wcel B2 C)) (wcel A2 cvv) $;

--| A subclass of a set is a set. Exercise 3 of [TakeutiZaring] p. 22. This is one way to express the Axiom of Separation ~ ax-sep (a.k.a. Subset Axiom). (Contributed by NM, 27-Apr-1994.) (Proof shortened by BJ, 18-Jul-2026.)
theorem ssex (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wi (wss A2 B2) (wcel A2 cvv) $;

--| Obsolete version of ~ ssex as of 18-Jul-2026. (Contributed by NM, 27-Apr-1994.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ssexOLD (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wi (wss A2 B2) (wcel A2 cvv) $;

--| A subclass of a set is a set. (Contributed by NM, 9-Sep-1993.)
theorem ssexi (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wss A2 B2 $ >
  $ wcel A2 cvv $;

--| Obsolete version of ~ ssexg as of 18-Jul-2026. (Contributed by NM, 14-Aug-1994.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ssexgOLD (A2 B2 C: class):
  $ wi (wa (wss A2 B2) (wcel B2 C)) (wcel A2 cvv) $;

--| A subclass of a set is a set. Deduction form of ~ ssexg . (Contributed by David Moews, 1-May-2017.)
theorem ssexd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel B2 C) $ >
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wcel A2 cvv) $;

--| Conditions for a class abstraction to be a set, deduction form. (Contributed by AV, 19-Apr-2025.)
theorem abexd {x3: setvar} (ph: wff) (ps: wff x3) (A2: class) (V: class x3):
  $ wi (wa ph ps) (wcel (cv x3) A2) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel (cab x3 ps) cvv) $;

--| Conditions for a class abstraction to be a set. Remark: This proof is shorter than a proof using ~ abexd . (Contributed by AV, 19-Apr-2025.)
theorem abex {x3: setvar} (ph: wff x3) (A2: class):
  $ wi ph (wcel (cv x3) A2) $ >
  $ wcel A2 cvv $ >
  $ wcel (cab x3 ph) cvv $;

--| The superclass of a proper class is a proper class. (Contributed by AV, 27-Dec-2020.)
theorem prcssprc (A2 B2: class):
  $ wi (wa (wss A2 B2) (wnel A2 cvv)) (wnel B2 cvv) $;

--| Membership in a power set. (Contributed by Thierry Arnoux, 18-May-2020.)
theorem sselpwd (ph: wff) (A2 B2 V: class):
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wcel A2 (cpw B2)) $;

--| Existence of a difference. (Contributed by NM, 26-May-1998.)
theorem difexg (A2 B2 V: class):
  $ wi (wcel A2 V) (wcel (cdif A2 B2) cvv) $;

--| Existence of a difference, inference version of ~ difexg . (Contributed by Glauco Siliprandi, 3-Mar-2021.) (Revised by AV, 26-Mar-2021.)
theorem difexi (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel (cdif A2 B2) cvv $;

--| Existence of a difference. (Contributed by SN, 16-Jul-2024.)
theorem difexd (ph: wff) (A2 B2 V: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel (cdif A2 B2) cvv) $;

--| Separation Scheme (Aussonderung) in terms of a class abstraction. Prefer using the more natural statement ~ rabexg . (Contributed by NM, 8-Jun-1994.) Put in closed form. (Revised by BJ, 18-Jul-2026.)
theorem sepab {x3: setvar} (ph: wff x3) (A2: class) (V: class x3):
  $ wi (wcel A2 V) (wcel (cab x3 (wa (wcel (cv x3) A2) ph)) cvv) $;

--| Membership in a power class. Theorem 86 of [Suppes] p. 47. (Contributed by NM, 7-Aug-2000.)
theorem elpw2g (A2 B2 V: class):
  $ wi (wcel B2 V) (wb (wcel A2 (cpw B2)) (wss A2 B2)) $;

--| Membership in a power class. Theorem 86 of [Suppes] p. 47. (Contributed by NM, 11-Oct-2007.)
theorem elpw2 (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wb (wcel A2 (cpw B2)) (wss A2 B2) $;

--| Membership in a power class. (Contributed by Glauco Siliprandi, 3-Mar-2021.) (Proof shortened by Wolf Lammen, 26-May-2024.)
theorem elpwi2 (A2 B2 V: class):
  $ wcel B2 V $ >
  $ wss A2 B2 $ >
  $ wcel A2 (cpw B2) $;

--| A restricted class abstraction is an element of the power set of its restricting set. (Contributed by AV, 9-Oct-2023.)
theorem rabelpw {x3: setvar} (ph: wff x3) (A2: class) (V: class x3):
  $ wi (wcel A2 V) (wcel (crab x3 ph A2) (cpw A2)) $;

--| Separation Scheme in terms of a restricted class abstraction. (Contributed by NM, 23-Oct-1999.) (Proof shortened by BJ, 24-Jul-2025.)
theorem rabexg {x3: setvar} (ph: wff x3) (A2: class) (V: class x3):
  $ wi (wcel A2 V) (wcel (crab x3 ph A2) cvv) $;

--| Separation Scheme in terms of a restricted class abstraction. (Contributed by NM, 19-Jul-1996.)
theorem rabex {x3: setvar} (ph: wff x3) (A2: class):
  $ wcel A2 cvv $ >
  $ wcel (crab x3 ph A2) cvv $;

--| Separation Scheme in terms of a restricted class abstraction, deduction form of ~ rabex2 . (Contributed by AV, 16-Jul-2019.)
theorem rabexd {x3: setvar} (ph ps: wff x3) (A2: class) (B2 V: class x3):
  $ wceq B2 (crab x3 ps A2) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 cvv) $;

--| Separation Scheme in terms of a restricted class abstraction. (Contributed by AV, 16-Jul-2019.) (Revised by AV, 26-Mar-2021.)
theorem rabex2 {x3: setvar} (ps: wff x3) (A2: class) (B2: class x3):
  $ wceq B2 (crab x3 ps A2) $ >
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $;

--| A class abstraction based on a class abstraction based on a set is a set. (Contributed by AV, 16-Jul-2019.) (Revised by AV, 26-Mar-2021.)
theorem rab2ex {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3) (B2: class y1):
  $ wceq B2 (crab y1 ps A2) $ >
  $ wcel A2 cvv $ >
  $ wcel (crab x3 ph B2) cvv $;

--| Membership in a class abstraction involving a subset. Unlike ~ elabg , ` A ` does not have to be a set. (Contributed by NM, 29-Aug-2006.)
theorem elssabg {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class) (V: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel B2 V) (wb (wcel A2 (cab x3 (wa (wss (cv x3) B2) ph))) (wa (wss A2 B2) ps)) $;

--| The intersection of a nonempty class exists. Exercise 5 of [TakeutiZaring] p. 44 and its converse. (Contributed by NM, 13-Aug-2002.)
theorem intex (A2: class):
  $ wb (wne A2 c0) (wcel (cint A2) cvv) $;

--| If a class intersection is not a set, it must be the universe. (Contributed by NM, 3-Jul-2005.)
theorem intnex (A2: class):
  $ wb (wn (wcel (cint A2) cvv)) (wceq (cint A2) cvv) $;

--| The intersection of a nonempty class abstraction exists. (Contributed by NM, 21-Oct-2003.)
theorem intexab {x3: setvar} (ph: wff x3):
  $ wb (wex x3 ph) (wcel (cint (cab x3 ph)) cvv) $;

--| The intersection of a nonempty restricted class abstraction exists. (Contributed by NM, 21-Oct-2003.)
theorem intexrab {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wb (wrex x3 ph A2) (wcel (cint (crab x3 ph A2)) cvv) $;

--| The existence of a class intersection. ` x ` is normally a free-variable parameter in ` B ` , which should be read ` B ( x ) ` . (Contributed by FL, 19-Sep-2011.)
theorem iinexg {x3: setvar} (A2: class) (B2 C: class x3):
  $ wi (wa (wne A2 c0) (wral x3 (wcel B2 C) A2)) (wcel (ciin x3 A2 B2) cvv) $;

--| Absorption of a redundant conjunct in the intersection of a class abstraction. (Contributed by NM, 3-Jul-2005.)
theorem intabs {x3 y1: setvar} (ph: wff x3) (ps ch: wff y1) (A2: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wceq (cv x3) (cint (cab y1 ps))) (wb ph ch) $ >
  $ wa (wss (cint (cab y1 ps)) A2) ch $ >
  $ wceq (cint (cab x3 (wa (wss (cv x3) A2) ph))) (cint (cab x3 ph)) $;

--| The intersection of a union ` U. A ` with a class ` B ` is equal to the union of the intersections of each element of ` A ` with ` B ` . (Contributed by FL, 24-Mar-2007.) (Proof shortened by Wolf Lammen, 15-May-2025.)
theorem inuni {x3 y1: setvar} (A2 B2: class):
  $ wceq (cin (cuni A2) B2) (cuni (cab x3 (wrex y1 (wceq (cv x3) (cin (cv y1) B2)) A2))) $;

--| Two equivalent ways to express the Power Set Axiom. Note that ~ ax-pow is not used by the proof. When ~ ax-pow is assumed and ` A ` is a set, both sides of the biconditional hold. In ZF, both sides hold if and only if ` A ` is a set (see ~ pwexr ). (Contributed by NM, 22-Jun-2009.)
theorem axpweq {x3 y1 z: setvar} (A2: class):
  $ wb (wcel (cpw A2) cvv) (wex x3 (wal y1 (wi (wal z (wi (wcel (cv z) (cv y1)) (wcel (cv z) A2))) (wcel (cv y1) (cv x3))))) $;

--| The power set of a set is never a subset. (Contributed by Stefan O'Rear, 22-Feb-2015.) (Proof shortened by BJ, 24-Jul-2025.)
theorem pwnss (A2 V: class):
  $ wi (wcel A2 V) (wn (wss (cpw A2) A2)) $;

--| No set equals its power set. The sethood antecedent is necessary; compare ~ pwv . (Contributed by NM, 17-Nov-2008.) (Proof shortened by Mario Carneiro, 23-Dec-2016.)
theorem pwne (A2 V: class):
  $ wi (wcel A2 V) (wne (cpw A2) A2) $;

--| A difference is an element of the power set of its minuend. (Contributed by AV, 9-Oct-2023.)
theorem difelpw (A2 B2 V: class):
  $ wi (wcel A2 V) (wcel (cdif A2 B2) (cpw A2)) $;

--| The class of elements of ` A ` "such that ` A ` is a set" is a set. That class is equal to ` A ` when ` A ` is a set (see ~ class2seteq ) and to the empty set when ` A ` is a proper class. (Contributed by NM, 16-Oct-2003.)
theorem class2set {x3: setvar} (A2: class):
  $ wcel (crab x3 (wcel A2 cvv) A2) cvv $;

--| Every power class contains the empty set. (Contributed by NM, 25-Oct-2007.)
theorem _0elpw (A2: class):
  $ wcel c0 (cpw A2) $;

--| A power class is never empty. (Contributed by NM, 3-Sep-2018.)
theorem pwne0 (A2: class):
  $ wne (cpw A2) c0 $;

--| The empty set and its power set are not equal. (Contributed by NM, 23-Dec-1993.)
theorem _0nep0:
  $ wne c0 (csn c0) $;

--| Something cannot be equal to both the empty set and the power set of the empty set. (Contributed by NM, 21-Jun-1993.)
theorem _0inp0 (A2: class):
  $ wi (wceq A2 c0) (wn (wceq A2 (csn c0))) $;

--| The removal of the empty set from a class does not affect its union. (Contributed by NM, 22-Mar-2004.) (Proof shortened by Eric Schmidt, 25-Apr-2026.)
theorem unidif0 (A2: class):
  $ wceq (cuni (cdif A2 (csn c0))) (cuni A2) $;

--| Obsolete version of ~ unidif0 as of 25-Apr-2026. (Contributed by NM, 22-Mar-2004.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem unidif0OLD (A2: class):
  $ wceq (cuni (cdif A2 (csn c0))) (cuni A2) $;

--| If a class is equal to the singleton of its union, then its union exists. (Contributed by BTernaryTau, 24-Sep-2024.)
theorem eqsnuniex (A2: class):
  $ wi (wceq A2 (csn (cuni A2))) (wcel (cuni A2) cvv) $;

--| An indexed intersection of the empty set, with a nonempty index set, is empty. (Contributed by NM, 20-Oct-2005.)
theorem iin0 {x3: setvar} (A2: class):
  $ wb (wne A2 c0) (wceq (ciin x3 A2 c0) c0) $;

--| In the Separation Scheme ~ sepgi , we require that ` y ` not occur in ` ph ` (which can be generalized to "not be free in"). That requirement is necessary: ~ notsep , which requires only ~ ax-ext and ~ ax-nul on top of first-order logic, derives *non*-existence of a "separating set" for specific values of the containing set ` A ` and of the separating condition ` ph ` . Therefore, from the axioms required by ~ notsep and an overly strong axiom of separation without the requirement that ` y ` not occur in ` ph ` , we could derive ` F. ` , a contradiction. (Contributed by NM, 8-Feb-2006.) (Proof shortened by BJ, 18-Nov-2023.)
theorem notsep {x3 y1: setvar} (ph: wff x3 y1) (A2: class y1):
  $ wceq A2 (csn c0) $ >
  $ wb ph (wn (wcel (cv x3) (cv y1))) $ >
  $ wn (wex y1 (wal x3 (wb (wcel (cv x3) (cv y1)) (wa (wcel (cv x3) A2) ph)))) $;

--| The intersection of the universal class is empty. (Contributed by NM, 11-Sep-2008.)
theorem intv:
  $ wceq (cint cvv) c0 $;

--| Axiom of Power Sets. An axiom of Zermelo-Fraenkel set theory. It states that a set ` y ` exists that includes the power set of a given set ` x ` i.e. contains every subset of ` x ` . The variant ~ axpow2 uses explicit subset notation. A version using class notation is ~ pwex . (Contributed by NM, 21-Jun-1993.)
axiom ax_pow {y1 z w: setvar} (x3: setvar):
  $ wex y1 (wal z (wi (wal w (wi (wcel (cv w) (cv z)) (wcel (cv w) (cv x3)))) (wcel (cv z) (cv y1)))) $;

--| Axiom of Power Sets expressed with the fewest number of different variables. (Contributed by NM, 14-Aug-2003.)
theorem zfpow {x3 y1: setvar} (z: setvar):
  $ wex x3 (wal y1 (wi (wal x3 (wi (wcel (cv x3) (cv y1)) (wcel (cv x3) (cv z)))) (wcel (cv y1) (cv x3)))) $;

--| A variant of the Axiom of Power Sets ~ ax-pow using subset notation. Problem in [BellMachover] p. 466. (Contributed by NM, 4-Jun-2006.)
theorem axpow2 {y1 z: setvar} (x3: setvar):
  $ wex y1 (wal z (wi (wss (cv z) (cv x3)) (wcel (cv z) (cv y1)))) $;

--| A variant of the Axiom of Power Sets ~ ax-pow . For any set ` x ` , there exists a set ` y ` whose members are exactly the subsets of ` x ` i.e. the power set of ` x ` . Axiom Pow of [BellMachover] p. 466. (Contributed by NM, 4-Jun-2006.)
theorem axpow3 {y1 z: setvar} (x3: setvar):
  $ wex y1 (wal z (wb (wss (cv z) (cv x3)) (wcel (cv z) (cv y1)))) $;

--| Alternate proof of ~ el using ~ ax-9 and ~ ax-pow instead of ~ ax-pr . (Contributed by NM, 4-Jan-2002.) (Proof shortened by Andrew Salmon, 25-Jul-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem elALT2 {x3 y1: setvar}:
  $ wex y1 (wcel (cv x3) (cv y1)) $;

--| Alternate proof of ~ dtru using ~ ax-pow instead of ~ ax-pr . See ~ dtruALT for another proof using ~ ax-pow instead of ~ ax-pr . (Contributed by NM, 7-Nov-2006.) Avoid ~ ax-13 . (Revised by BJ, 31-May-2019.) Avoid ~ ax-12 . (Revised by Rohan Ridenour, 9-Oct-2024.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem dtruALT2 {x3 y1: setvar}:
  $ wn (wal x3 (wceq (cv x3) (cv y1))) $;

--| Corollary of ~ dtru . This example illustrates the danger of blindly trusting the standard Deduction Theorem without accounting for free variables: the theorem form of this deduction is not valid, as shown by ~ dtrucor2 . (Contributed by NM, 27-Jun-2002.)
theorem dtrucor {x3 y1: setvar}:
  $ wceq (cv x3) (cv y1) $ >
  $ wne (cv x3) (cv y1) $;

--| The theorem form of the deduction ~ dtrucor leads to a contradiction, as mentioned in the "Wrong!" example at ~ mmdeduction.html#bad . Usage of this theorem is discouraged because it depends on ~ ax-13 . (Contributed by NM, 20-Oct-2007.) (New usage is discouraged.)
theorem dtrucor2 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wne (cv x3) (cv y1)) $ >
  $ wa ph (wn ph) $;

--| Demonstration of a theorem that requires the setvar variables ` x ` and ` y ` to be disjoint (but without any other disjointness conditions, and in particular, none on ` z ` ). That theorem bundles the theorems ( ` |- E. x ( x = y -> z e. x ) ` with ` x , y , z ` disjoint), often called its "principal instance", and the two "degenerate instances" ( ` |- E. x ( x = y -> x e. x ) ` with ` x , y ` disjoint) and ( ` |- E. x ( x = y -> y e. x ) ` with ` x , y ` disjoint). Compare with ~ dvdemo2 , which has the same principal instance and one common degenerate instance but crucially differs in the other degenerate instance. See ~ https://us.metamath.org/mpeuni/mmset.html#distinct for details on the "disjoint variable" mechanism. (The verb "bundle" to express this phenomenon was introduced by Raph Levien.) Note that ~ dvdemo1 is partially bundled, in that the pairs of setvar variables ` x , z ` and ` y , z ` need not be disjoint, and in spite of that, its proof does not require ~ ax-11 nor ~ ax-13 . (Contributed by NM, 1-Dec-2006.) (Revised by BJ, 13-Jan-2024.)
theorem dvdemo1 {x3 y1: setvar} (z: setvar):
  $ wex x3 (wi (wceq (cv x3) (cv y1)) (wcel (cv z) (cv x3))) $;

--| Demonstration of a theorem that requires the setvar variables ` x ` and ` z ` to be disjoint (but without any other disjointness conditions, and in particular, none on ` y ` ). That theorem bundles the theorems ( ` |- E. x ( x = y -> z e. x ) ` with ` x , y , z ` disjoint), often called its "principal instance", and the two "degenerate instances" ( ` |- E. x ( x = x -> z e. x ) ` with ` x , z ` disjoint) and ( ` |- E. x ( x = z -> z e. x ) ` with ` x , z ` disjoint). Compare with ~ dvdemo1 , which has the same principal instance and one common degenerate instance but crucially differs in the other degenerate instance. See ~ https://us.metamath.org/mpeuni/mmset.html#distinct for details on the "disjoint variable" mechanism. Note that ~ dvdemo2 is partially bundled, in that the pairs of setvar variables ` x , y ` and ` y , z ` need not be disjoint, and in spite of that, its proof does not require any of the auxiliary axioms ~ ax-10 , ~ ax-11 , ~ ax-12 , ~ ax-13 . (Contributed by NM, 1-Dec-2006.) Avoid ~ ax-13 . (Revised by BJ, 13-Jan-2024.)
theorem dvdemo2 {x3 z: setvar} (y1: setvar):
  $ wex x3 (wi (wceq (cv x3) (cv y1)) (wcel (cv z) (cv x3))) $;

--| A setvar variable is not free from itself. This theorem is not true in a one-element domain, as illustrated by the use of ~ dtruALT2 in its proof. (Contributed by Mario Carneiro, 8-Oct-2016.)
theorem nfnid {x3: setvar}:
  $ wn (wnfc x3 (cv x3)) $;

--| The "distinctor" expression ` -. A. x x = y ` , stating that ` x ` and ` y ` are not the same variable, can be written in terms of ` F/ ` in the obvious way. This theorem is not true in a one-element domain, because then ` F/_ x y ` and ` A. x x = y ` will both be true. (Contributed by Mario Carneiro, 8-Oct-2016.) Usage of this theorem is discouraged because it depends on ~ ax-13 . (New usage is discouraged.)
theorem nfcvb {x3 y1: setvar}:
  $ wb (wnfc x3 (cv y1)) (wn (wal x3 (wceq (cv x3) (cv y1)))) $;

--| Power set axiom: the powerclass of a set is a set. Axiom 4 of [TakeutiZaring] p. 17. (Contributed by NM, 30-Oct-2003.) (Proof shortened by Andrew Salmon, 25-Jul-2011.) Revised to prove ~ pwexg from ~ vpwex . (Revised by BJ, 10-Aug-2022.)
theorem vpwex (x3: setvar):
  $ wcel (cpw (cv x3)) cvv $;

--| Power set axiom expressed in class notation, with the sethood requirement as an antecedent. (Contributed by NM, 30-Oct-2003.)
theorem pwexg (A2 V: class):
  $ wi (wcel A2 V) (wcel (cpw A2) cvv) $;

--| Deduction version of the power set axiom. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem pwexd (ph: wff) (A2 V: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel (cpw A2) cvv) $;

--| Power set axiom expressed in class notation. (Contributed by NM, 21-Jun-1993.)
theorem pwex (A2: class):
  $ wcel A2 cvv $ >
  $ wcel (cpw A2) cvv $;

--| Quantitative version of ~ pwexg : the powerset of an element of a class is an element of the double powerclass of the union of that class. Exercise 10 of [Enderton] p. 26. (Contributed by NM, 13-Jan-2007.) Remove use of ~ ax-nul and ~ ax-pr and shorten proof. (Revised by BJ, 13-Apr-2024.)
theorem pwel (A2 B2: class):
  $ wi (wcel A2 B2) (wcel (cpw A2) (cpw (cpw (cuni B2)))) $;

--| Existence of a class of subsets. (Contributed by NM, 15-Jul-2006.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem abssexg {x3: setvar} (ph: wff x3) (A2: class) (V: class x3):
  $ wi (wcel A2 V) (wcel (cab x3 (wa (wss (cv x3) A2) ph)) cvv) $;

--| Alternate proof of ~ snex using Power Set ( ~ ax-pow ) instead of Pairing ( ~ ax-pr ). Unlike in the proof of ~ zfpair , Replacement ( ~ ax-rep ) is not needed. (Contributed by NM, 7-Aug-1994.) (Proof shortened by Andrew Salmon, 25-Jul-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem snexALT (A2: class):
  $ wcel (csn A2) cvv $;

--| The power set of the empty set (the ordinal 1) is a set. See also ~ p0exALT . (Contributed by NM, 23-Dec-1993.)
theorem p0ex:
  $ wcel (csn c0) cvv $;

--| Alternate proof of ~ p0ex which is quite different and longer if ~ snexALT is expanded. (Contributed by NM, 23-Dec-1993.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem p0exALT:
  $ wcel (csn c0) cvv $;

--| The power set of the power set of the empty set (the ordinal 2) is a set. (Contributed by NM, 24-Jun-1993.)
theorem pp0ex:
  $ wcel (cpr c0 (csn c0)) cvv $;

--| The ordinal number 3 is a set, proved without the Axiom of Union ~ ax-un . (Contributed by NM, 2-May-2009.)
theorem ord3ex:
  $ wcel (ctp c0 (csn c0) (cpr c0 (csn c0))) cvv $;

--| Alternate proof of ~ dtru which requires more axioms but is shorter and may be easier to understand. Like ~ dtruALT2 , it uses ~ ax-pow rather than ~ ax-pr . Assuming that ZF set theory is consistent, we cannot prove this theorem unless we specify that ` x ` and ` y ` be distinct. Specifically, Theorem ~ spcev requires that ` x ` must not occur in the subexpression ` -. y = { (/) } ` in step 4 nor in the subexpression ` -. y = (/) ` in step 9. The proof verifier will require that ` x ` and ` y ` be in a distinct variable group to ensure this. You can check this by deleting the $d statement in set.mm and rerunning the verifier, which will print a detailed explanation of the distinct variable violation. (Contributed by NM, 15-Jul-1994.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem dtruALT {x3: setvar} (y1: setvar):
  $ wn (wal x3 (wceq (cv x3) (cv y1))) $;

--| This theorem shows that Axiom ~ ax-c16 is redundant in the presence of Theorem ~ dtruALT2 , which states simply that at least two things exist. This justifies the remark at ~ mmzfcnd.html#twoness (which links to this theorem). (Proof modification is discouraged.) (New usage is discouraged.) (Contributed by NM, 7-Nov-2006.)
theorem axc16b {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wi ph (wal x3 ph)) $;

--| Existential uniqueness implies there is a value for which the wff argument is false. (Contributed by NM, 24-Oct-2010.) (Proof shortened by BJ, 2-Jan-2023.)
theorem eunex {x3: setvar} (ph: wff x3):
  $ wi (weu x3 ph) (wex x3 (wn ph)) $;

--| Two ways to express single-valuedness of a class expression ` A ( x ) ` . (Contributed by NM, 14-Oct-2010.)
theorem eusv1 {x3 y1: setvar} (A2: class x3):
  $ wb (weu y1 (wal x3 (wceq (cv y1) A2))) (wex y1 (wal x3 (wceq (cv y1) A2))) $;

--| Even if ` x ` is free in ` A ` , it is effectively bound when ` A ( x ) ` is single-valued. (Contributed by NM, 14-Oct-2010.) (Revised by Mario Carneiro, 14-Oct-2016.)
theorem eusvnf {x3 y1: setvar} (A2: class x3):
  $ wi (weu y1 (wal x3 (wceq (cv y1) A2))) (wnfc x3 A2) $;

--| Two ways to say that ` A ( x ) ` is a set expression that does not depend on ` x ` . (Contributed by Mario Carneiro, 18-Nov-2016.)
theorem eusvnfb {x3 y1: setvar} (A2: class x3):
  $ wb (weu y1 (wal x3 (wceq (cv y1) A2))) (wa (wnfc x3 A2) (wcel A2 cvv)) $;

--| Two ways to express single-valuedness of a class expression ` A ( x ) ` . (Contributed by NM, 14-Oct-2010.) (Revised by Mario Carneiro, 18-Nov-2016.)
theorem eusv2i {x3 y1: setvar} (A2: class x3):
  $ wi (weu y1 (wal x3 (wceq (cv y1) A2))) (weu y1 (wex x3 (wceq (cv y1) A2))) $;

--| Two ways to express single-valuedness of a class expression ` A ( x ) ` . (Contributed by Mario Carneiro, 18-Nov-2016.)
theorem eusv2nf {x3 y1: setvar} (A2: class x3):
  $ wcel A2 cvv $ >
  $ wb (weu y1 (wex x3 (wceq (cv y1) A2))) (wnfc x3 A2) $;

--| Two ways to express single-valuedness of a class expression ` A ( x ) ` . (Contributed by NM, 15-Oct-2010.) (Proof shortened by Mario Carneiro, 18-Nov-2016.)
theorem eusv2 {x3 y1: setvar} (A2: class x3):
  $ wcel A2 cvv $ >
  $ wb (weu y1 (wex x3 (wceq (cv y1) A2))) (weu y1 (wal x3 (wceq (cv y1) A2))) $;

--| Two ways to express single-valuedness of a class expression ` C ( y ) ` . (Contributed by NM, 16-Dec-2012.) (Proof shortened by Mario Carneiro, 18-Nov-2016.) (Proof shortened by JJ, 7-Aug-2021.)
theorem reusv1 {x3 y1: setvar} (ph: wff y1) (A2 B2 C: class y1):
  $ wi (wrex y1 ph B2) (wb (wreu x3 (wral y1 (wi ph (wceq (cv x3) C)) B2) A2) (wrex x3 (wral y1 (wi ph (wceq (cv x3) C)) B2) A2)) $;

--| Lemma for ~ reusv2 . (Contributed by NM, 22-Oct-2010.) (Proof shortened by Mario Carneiro, 19-Nov-2016.)
theorem reusv2lem1 {x3 y1: setvar} (A2: class) (B2: class y1):
  $ wi (wne A2 c0) (wb (weu x3 (wral y1 (wceq (cv x3) B2) A2)) (wex x3 (wral y1 (wceq (cv x3) B2) A2))) $;

--| Lemma for ~ reusv2 . (Contributed by NM, 27-Oct-2010.) (Proof shortened by Mario Carneiro, 19-Nov-2016.) (Proof shortened by JJ, 7-Aug-2021.)
theorem reusv2lem2 {x3 y1: setvar} (A2: class) (B2: class y1):
  $ wi (weu x3 (wral y1 (wceq (cv x3) B2) A2)) (weu x3 (wrex y1 (wceq (cv x3) B2) A2)) $;

--| Lemma for ~ reusv2 . (Contributed by NM, 14-Dec-2012.) (Proof shortened by Mario Carneiro, 19-Nov-2016.)
theorem reusv2lem3 {x3 y1: setvar} (A2: class) (B2: class y1):
  $ wi (wral y1 (wcel B2 cvv) A2) (wb (weu x3 (wrex y1 (wceq (cv x3) B2) A2)) (weu x3 (wral y1 (wceq (cv x3) B2) A2))) $;

--| Lemma for ~ reusv2 . (Contributed by NM, 13-Dec-2012.)
theorem reusv2lem4 {x3 y1: setvar} (ph: wff y1) (A2: class) (B2 C: class y1):
  $ wb (wreu x3 (wrex y1 (wa ph (wceq (cv x3) C)) B2) A2) (weu x3 (wral y1 (wi (wa (wcel C A2) ph) (wceq (cv x3) C)) B2)) $;

--| Lemma for ~ reusv2 . (Contributed by NM, 4-Jan-2013.) (Proof shortened by Mario Carneiro, 19-Nov-2016.)
theorem reusv2lem5 {x3 y1: setvar} (A2 B2: class) (C: class y1):
  $ wi (wa (wral y1 (wcel C A2) B2) (wne B2 c0)) (wb (wreu x3 (wrex y1 (wceq (cv x3) C) B2) A2) (wreu x3 (wral y1 (wceq (cv x3) C) B2) A2)) $;

--| Two ways to express single-valuedness of a class expression ` C ( y ) ` that is constant for those ` y e. B ` such that ` ph ` . The first antecedent ensures that the constant value belongs to the existential uniqueness domain ` A ` , and the second ensures that ` C ( y ) ` is evaluated for at least one ` y ` . (Contributed by NM, 4-Jan-2013.) (Proof shortened by Mario Carneiro, 19-Nov-2016.)
theorem reusv2 {x3 y1: setvar} (ph: wff y1) (A2: class) (B2 C: class y1):
  $ wi (wa (wral y1 (wi ph (wcel C A2)) B2) (wrex y1 ph B2)) (wb (wreu x3 (wrex y1 (wa ph (wceq (cv x3) C)) B2) A2) (wreu x3 (wral y1 (wi ph (wceq (cv x3) C)) B2) A2)) $;

--| Two ways of expressing existential uniqueness via an indirect equality. (Contributed by NM, 23-Dec-2012.)
theorem reusv3i {x3 y1 z: setvar} (ph: wff y1) (ps: wff z) (A2: class x3 y1 z) (B2: class) (C: class y1) (D: class z):
  $ wi (wceq (cv y1) (cv z)) (wb ph ps) $ >
  $ wi (wceq (cv y1) (cv z)) (wceq C D) $ >
  $ wi (wrex x3 (wral y1 (wi ph (wceq (cv x3) C)) B2) A2) (wral y1 (wral z (wi (wa ph ps) (wceq C D)) B2) B2) $;

--| Two ways to express single-valuedness of a class expression ` C ( y ) ` . See ~ reusv1 for the connection to uniqueness. (Contributed by NM, 27-Dec-2012.)
theorem reusv3 {x3 y1 z: setvar} (ph: wff y1) (ps: wff z) (A2 B2: class) (C: class y1) (D: class z):
  $ wi (wceq (cv y1) (cv z)) (wb ph ps) $ >
  $ wi (wceq (cv y1) (cv z)) (wceq C D) $ >
  $ wi (wrex y1 (wa ph (wcel C A2)) B2) (wb (wral y1 (wral z (wi (wa ph ps) (wceq C D)) B2) B2) (wrex x3 (wral y1 (wi ph (wceq (cv x3) C)) B2) A2)) $;

--| Two ways to express single-valuedness of a class expression ` B ( y ) ` . (Contributed by NM, 27-Oct-2010.)
theorem eusv4 {x3 y1: setvar} (A2: class) (B2: class y1):
  $ wcel B2 cvv $ >
  $ wb (weu x3 (wrex y1 (wceq (cv x3) B2) A2)) (weu x3 (wral y1 (wceq (cv x3) B2) A2)) $;

--| Transfer universal quantification from a variable ` x ` to another variable ` y ` contained in expression ` A ` . (Contributed by NM, 18-Feb-2007.)
theorem alxfr {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class y1) (B2: class x3 y1):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wa (wal y1 (wcel A2 B2)) (wal x3 (wex y1 (wceq (cv x3) A2)))) (wb (wal x3 ph) (wal y1 ps)) $;

--| Transfer universal quantification from a variable ` x ` to another variable ` y ` contained in expression ` A ` . (Contributed by NM, 15-Aug-2014.) (Proof shortened by Mario Carneiro, 19-Nov-2016.) (Proof shortened by JJ, 7-Aug-2021.)
theorem ralxfrd {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (A2: class y1) (B2: class) (C: class y1):
  $ wi (wa ph (wcel (cv y1) C)) (wcel A2 B2) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wrex y1 (wceq (cv x3) A2) C) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wral x3 ps B2) (wral y1 ch C)) $;

--| Transfer existential quantification from a variable ` x ` to another variable ` y ` contained in expression ` A ` . (Contributed by FL, 10-Apr-2007.) (Revised by Mario Carneiro, 15-Aug-2014.)
theorem rexxfrd {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (A2: class y1) (B2: class) (C: class y1):
  $ wi (wa ph (wcel (cv y1) C)) (wcel A2 B2) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wrex y1 (wceq (cv x3) A2) C) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wrex x3 ps B2) (wrex y1 ch C)) $;

--| Transfer universal quantification from a variable ` x ` to another variable ` y ` contained in expression ` A ` . (Contributed by Mario Carneiro, 20-Aug-2014.)
theorem ralxfr2d {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (A2: class y1) (B2: class) (C: class y1) (V: class x3 y1):
  $ wi (wa ph (wcel (cv y1) C)) (wcel A2 V) $ >
  $ wi ph (wb (wcel (cv x3) B2) (wrex y1 (wceq (cv x3) A2) C)) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wral x3 ps B2) (wral y1 ch C)) $;

--| Transfer existential quantification from a variable ` x ` to another variable ` y ` contained in expression ` A ` . (Contributed by Mario Carneiro, 20-Aug-2014.) (Proof shortened by Mario Carneiro, 19-Nov-2016.)
theorem rexxfr2d {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (A2: class y1) (B2: class) (C: class y1) (V: class x3 y1):
  $ wi (wa ph (wcel (cv y1) C)) (wcel A2 V) $ >
  $ wi ph (wb (wcel (cv x3) B2) (wrex y1 (wceq (cv x3) A2) C)) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wrex x3 ps B2) (wrex y1 ch C)) $;

--| Transfer universal quantification from a variable ` x ` to another variable ` y ` contained in expression ` A ` . Variant of ~ ralxfrd . (Contributed by Alexander van der Vekens, 25-Apr-2018.)
theorem ralxfrd2 {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (A2: class y1) (B2: class) (C: class y1):
  $ wi (wa ph (wcel (cv y1) C)) (wcel A2 B2) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wrex y1 (wceq (cv x3) A2) C) $ >
  $ wi (w3a ph (wcel (cv y1) C) (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wral x3 ps B2) (wral y1 ch C)) $;

--| Transfer existence from a variable ` x ` to another variable ` y ` contained in expression ` A ` . Variant of ~ rexxfrd . (Contributed by Alexander van der Vekens, 25-Apr-2018.)
theorem rexxfrd2 {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (A2: class y1) (B2: class) (C: class y1):
  $ wi (wa ph (wcel (cv y1) C)) (wcel A2 B2) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wrex y1 (wceq (cv x3) A2) C) $ >
  $ wi (w3a ph (wcel (cv y1) C) (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wrex x3 ps B2) (wrex y1 ch C)) $;

--| Transfer universal quantification from a variable ` x ` to another variable ` y ` contained in expression ` A ` . (Contributed by NM, 10-Jun-2005.) (Revised by Mario Carneiro, 15-Aug-2014.)
theorem ralxfr {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class y1) (B2: class) (C: class y1):
  $ wi (wcel (cv y1) C) (wcel A2 B2) $ >
  $ wi (wcel (cv x3) B2) (wrex y1 (wceq (cv x3) A2) C) $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wral x3 ph B2) (wral y1 ps C) $;

--| Alternate proof of ~ ralxfr which does not use ~ ralxfrd . (Contributed by NM, 10-Jun-2005.) (Revised by Mario Carneiro, 15-Aug-2014.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ralxfrALT {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class y1) (B2: class) (C: class y1):
  $ wi (wcel (cv y1) C) (wcel A2 B2) $ >
  $ wi (wcel (cv x3) B2) (wrex y1 (wceq (cv x3) A2) C) $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wral x3 ph B2) (wral y1 ps C) $;

--| Transfer existence from a variable ` x ` to another variable ` y ` contained in expression ` A ` . (Contributed by NM, 10-Jun-2005.) (Revised by Mario Carneiro, 15-Aug-2014.)
theorem rexxfr {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class y1) (B2: class) (C: class y1):
  $ wi (wcel (cv y1) C) (wcel A2 B2) $ >
  $ wi (wcel (cv x3) B2) (wrex y1 (wceq (cv x3) A2) C) $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wb (wrex x3 ph B2) (wrex y1 ps C) $;

--| Membership in a restricted class abstraction after substituting an expression ` A ` (containing ` y ` ) for ` x ` in the formula defining the class abstraction. (Contributed by NM, 16-Jan-2012.)
theorem rabxfrd {x3 y1: setvar} (ph ps: wff x3) (ch: wff y1) (A2: class y1) (B2 C: class x3 y1) (D: class):
  $ wnfc y1 B2 $ >
  $ wnfc y1 C $ >
  $ wi (wa ph (wcel (cv y1) D)) (wcel A2 D) $ >
  $ wi (wceq (cv x3) A2) (wb ps ch) $ >
  $ wi (wceq (cv y1) B2) (wceq A2 C) $ >
  $ wi (wa ph (wcel B2 D)) (wb (wcel C (crab x3 ps D)) (wcel B2 (crab y1 ch D))) $;

--| Membership in a restricted class abstraction after substituting an expression ` A ` (containing ` y ` ) for ` x ` in the formula defining the class abstraction. (Contributed by NM, 10-Jun-2005.)
theorem rabxfr {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class y1) (B2 C: class x3 y1) (D: class):
  $ wnfc y1 B2 $ >
  $ wnfc y1 C $ >
  $ wi (wcel (cv y1) D) (wcel A2 D) $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wceq A2 C) $ >
  $ wi (wcel B2 D) (wb (wcel C (crab x3 ph D)) (wcel B2 (crab y1 ps D))) $;

--| A theorem useful for eliminating the restricted existential uniqueness hypotheses in ~ riotaxfrd . (Contributed by NM, 16-Jan-2012.)
theorem reuhypd {x3 y1: setvar} (ph: wff x3) (A2: class x3 y1) (B2 C: class x3):
  $ wi (wa ph (wcel (cv x3) C)) (wcel B2 C) $ >
  $ wi (w3a ph (wcel (cv x3) C) (wcel (cv y1) C)) (wb (wceq (cv x3) A2) (wceq (cv y1) B2)) $ >
  $ wi (wa ph (wcel (cv x3) C)) (wreu y1 (wceq (cv x3) A2) C) $;

--| A theorem useful for eliminating the restricted existential uniqueness hypotheses in ~ reuxfr1 . (Contributed by NM, 15-Nov-2004.)
theorem reuhyp {x3 y1: setvar} (A2: class x3 y1) (B2 C: class x3):
  $ wi (wcel (cv x3) C) (wcel B2 C) $ >
  $ wi (wa (wcel (cv x3) C) (wcel (cv y1) C)) (wb (wceq (cv x3) A2) (wceq (cv y1) B2)) $ >
  $ wi (wcel (cv x3) C) (wreu y1 (wceq (cv x3) A2) C) $;

--| The Axiom of Pairing of Zermelo-Fraenkel set theory. Axiom 2 of [TakeutiZaring] p. 15. In some textbooks this is stated as a separate axiom; here we show it is redundant since it can be derived from the other axioms. This theorem should not be referenced by any proof other than ~ axprALT . Instead, use ~ zfpair2 below so that the uses of the Axiom of Pairing can be more easily identified. (Contributed by NM, 18-Oct-1995.) (New usage is discouraged.)
theorem zfpair {x3 y1: setvar}:
  $ wcel (cpr (cv x3) (cv y1)) cvv $;

--| Alternate proof of ~ axpr . (Contributed by NM, 14-Nov-2006.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem axprALT {x3 y1 z w: setvar}:
  $ wex z (wal w (wi (wo (wceq (cv w) (cv x3)) (wceq (cv w) (cv y1))) (wcel (cv w) (cv z)))) $;

--| Lemma for ~ axpr . There exists a set to which all empty sets belong. (Contributed by Rohan Ridenour, 10-Aug-2023.) (Revised by BJ, 13-Aug-2023.) (Proof shortened by Matthew House, 6-Apr-2026.)
theorem axprlem1 {x3 y1 z: setvar}:
  $ wex x3 (wal y1 (wi (wal z (wn (wcel (cv z) (cv y1)))) (wcel (cv y1) (cv x3)))) $;

--| Lemma for ~ axpr . There exists a set to which all sets whose only members are empty sets belong. (Contributed by Rohan Ridenour, 9-Aug-2023.) (Revised by BJ, 13-Aug-2023.)
theorem axprlem2 {x3 y1 z w: setvar}:
  $ wex x3 (wal y1 (wi (wral z (wal w (wn (wcel (cv w) (cv z)))) (cv y1)) (wcel (cv y1) (cv x3)))) $;

--| Lemma for ~ axpr . Eliminate the antecedent of the relevant replacement instance. (Contributed by Rohan Ridenour, 10-Aug-2023.) (Proof shortened by Matthew House, 18-Sep-2025.)
theorem axprlem3 {x3 y1 z w n s1: setvar} (p: setvar):
  $ wex z (wal w (wb (wcel (cv w) (cv z)) (wex s1 (wa (wcel (cv s1) (cv p)) (wif (wex n (wcel (cv n) (cv s1))) (wceq (cv w) (cv x3)) (wceq (cv w) (cv y1))))))) $;

--| Lemma for ~ axpr . Eliminate the antecedent of the relevant replacement instance. (Contributed by Rohan Ridenour, 10-Aug-2023.) (Proof shortened by Matthew House, 18-Sep-2025.)
theorem axprlem3_b {x3 z w n s1: setvar} (p: setvar):
  $ wex z (wal w (wb (wcel (cv w) (cv z)) (wex s1 (wa (wcel (cv s1) (cv p)) (wif (wex n (wcel (cv n) (cv s1))) (wceq (cv w) (cv x3)) (wceq (cv w) (cv x3))))))) $;

--| Lemma for ~ axpr . If an existing set of empty sets corresponds to one element of the pair, then the element is included in any superset of the set whose existence is asserted by the axiom of replacement. (Contributed by Rohan Ridenour, 10-Aug-2023.) (Revised by BJ, 13-Aug-2023.) (Revised by Matthew House, 18-Sep-2025.)
theorem axprlem4 {x3 y1 w v t n s1: setvar} (ph: wff x3 y1 w v t n s1) (p: setvar):
  $ wex s1 (wal n ph) $ >
  $ wi ph (wi (wcel (cv n) (cv s1)) (wal t (wn (wcel (cv t) (cv n))))) $ >
  $ wi (wal n ph) (wb (wif (wex n (wcel (cv n) (cv s1))) (wceq (cv w) (cv x3)) (wceq (cv w) (cv y1))) (wceq (cv w) (cv v))) $ >
  $ wi (wal s1 (wi (wral n (wal t (wn (wcel (cv t) (cv n)))) (cv s1)) (wcel (cv s1) (cv p)))) (wi (wceq (cv w) (cv v)) (wex s1 (wa (wcel (cv s1) (cv p)) (wif (wex n (wcel (cv n) (cv s1))) (wceq (cv w) (cv x3)) (wceq (cv w) (cv y1)))))) $;

--| Lemma for ~ axpr . If an existing set of empty sets corresponds to one element of the pair, then the element is included in any superset of the set whose existence is asserted by the axiom of replacement. (Contributed by Rohan Ridenour, 10-Aug-2023.) (Revised by BJ, 13-Aug-2023.) (Revised by Matthew House, 18-Sep-2025.)
theorem axprlem4_b {x3 w t n s1: setvar} (ph: wff x3 w t n s1) (p: setvar):
  $ wex s1 (wal n ph) $ >
  $ wi ph (wi (wcel (cv n) (cv s1)) (wal t (wn (wcel (cv t) (cv n))))) $ >
  $ wi (wal n ph) (wb (wif (wex n (wcel (cv n) (cv s1))) (wceq (cv w) (cv x3)) (wceq (cv w) (cv x3))) (wceq (cv w) (cv x3))) $ >
  $ wi (wal s1 (wi (wral n (wal t (wn (wcel (cv t) (cv n)))) (cv s1)) (wcel (cv s1) (cv p)))) (wi (wceq (cv w) (cv x3)) (wex s1 (wa (wcel (cv s1) (cv p)) (wif (wex n (wcel (cv n) (cv s1))) (wceq (cv w) (cv x3)) (wceq (cv w) (cv x3)))))) $;

--| Lemma for ~ axpr . If an existing set of empty sets corresponds to one element of the pair, then the element is included in any superset of the set whose existence is asserted by the axiom of replacement. (Contributed by Rohan Ridenour, 10-Aug-2023.) (Revised by BJ, 13-Aug-2023.) (Revised by Matthew House, 18-Sep-2025.)
theorem axprlem4_b1 {x3 y1 w t n s1: setvar} (ph: wff x3 y1 w t n s1) (p: setvar):
  $ wex s1 (wal n ph) $ >
  $ wi ph (wi (wcel (cv n) (cv s1)) (wal t (wn (wcel (cv t) (cv n))))) $ >
  $ wi (wal n ph) (wb (wif (wex n (wcel (cv n) (cv s1))) (wceq (cv w) (cv x3)) (wceq (cv w) (cv y1))) (wceq (cv w) (cv x3))) $ >
  $ wi (wal s1 (wi (wral n (wal t (wn (wcel (cv t) (cv n)))) (cv s1)) (wcel (cv s1) (cv p)))) (wi (wceq (cv w) (cv x3)) (wex s1 (wa (wcel (cv s1) (cv p)) (wif (wex n (wcel (cv n) (cv s1))) (wceq (cv w) (cv x3)) (wceq (cv w) (cv y1)))))) $;

--| Lemma for ~ axpr . If an existing set of empty sets corresponds to one element of the pair, then the element is included in any superset of the set whose existence is asserted by the axiom of replacement. (Contributed by Rohan Ridenour, 10-Aug-2023.) (Revised by BJ, 13-Aug-2023.) (Revised by Matthew House, 18-Sep-2025.)
theorem axprlem4_b2 {x3 y1 w t n s1: setvar} (ph: wff x3 y1 w t n s1) (p: setvar):
  $ wex s1 (wal n ph) $ >
  $ wi ph (wi (wcel (cv n) (cv s1)) (wal t (wn (wcel (cv t) (cv n))))) $ >
  $ wi (wal n ph) (wb (wif (wex n (wcel (cv n) (cv s1))) (wceq (cv w) (cv x3)) (wceq (cv w) (cv y1))) (wceq (cv w) (cv y1))) $ >
  $ wi (wal s1 (wi (wral n (wal t (wn (wcel (cv t) (cv n)))) (cv s1)) (wcel (cv s1) (cv p)))) (wi (wceq (cv w) (cv y1)) (wex s1 (wa (wcel (cv s1) (cv p)) (wif (wex n (wcel (cv n) (cv s1))) (wceq (cv w) (cv x3)) (wceq (cv w) (cv y1)))))) $;

--| Unabbreviated version of the Axiom of Pairing of ZF set theory, derived as a theorem from the other axioms. This theorem should not be referenced by any proof. Instead, use ~ ax-pr below so that the uses of the Axiom of Pairing can be more easily identified. For a shorter proof using ~ ax-ext , see ~ axprALT . (Contributed by NM, 14-Nov-2006.) Remove dependency on ~ ax-ext . (Revised by Rohan Ridenour, 10-Aug-2023.) (Proof shortened by BJ, 13-Aug-2023.) (Proof shortened by Matthew House, 18-Sep-2025.) Use ~ ax-pr instead. (New usage is discouraged.)
theorem axpr {x3 y1 z w: setvar}:
  $ wex z (wal w (wi (wo (wceq (cv w) (cv x3)) (wceq (cv w) (cv y1))) (wcel (cv w) (cv z)))) $;

--| Obsolete version of ~ axprlem1 as of 6-Apr-2026. (Contributed by Rohan Ridenour, 10-Aug-2023.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem axprlem1OLD {x3 y1 z: setvar}:
  $ wex x3 (wal y1 (wi (wal z (wn (wcel (cv z) (cv y1)))) (wcel (cv y1) (cv x3)))) $;

--| Unabbreviated version of the Axiom of Pairing of ZF set theory, derived as a theorem from the other axioms. This theorem should not be referenced by any proof. Instead, use ~ ax-pr below so that the uses of the Axiom of Pairing can be more easily identified. For a shorter proof using ~ ax-ext , see ~ axprALT . (Contributed by NM, 14-Nov-2006.) Remove dependency on ~ ax-ext . (Revised by Rohan Ridenour, 10-Aug-2023.) (Proof shortened by BJ, 13-Aug-2023.) (Proof shortened by Matthew House, 18-Sep-2025.) Use ~ ax-pr instead. (New usage is discouraged.)
theorem ax_pr {x3 y1 z w: setvar}:
  $ wex z (wal w (wi (wo (wceq (cv w) (cv x3)) (wceq (cv w) (cv y1))) (wcel (cv w) (cv z)))) $;

--| Unabbreviated version of the Axiom of Pairing of ZF set theory, derived as a theorem from the other axioms. This theorem should not be referenced by any proof. Instead, use ~ ax-pr below so that the uses of the Axiom of Pairing can be more easily identified. For a shorter proof using ~ ax-ext , see ~ axprALT . (Contributed by NM, 14-Nov-2006.) Remove dependency on ~ ax-ext . (Revised by Rohan Ridenour, 10-Aug-2023.) (Proof shortened by BJ, 13-Aug-2023.) (Proof shortened by Matthew House, 18-Sep-2025.) Use ~ ax-pr instead. (New usage is discouraged.)
theorem ax_pr_b {x3 z w: setvar}:
  $ wex z (wal w (wi (wo (wceq (cv w) (cv x3)) (wceq (cv w) (cv x3))) (wcel (cv w) (cv z)))) $;

--| Derive the abbreviated version of the Axiom of Pairing from ~ ax-pr . See ~ zfpair for its derivation from the other axioms. (Contributed by NM, 14-Nov-2006.)
theorem zfpair2 {x3 y1: setvar}:
  $ wcel (cpr (cv x3) (cv y1)) cvv $;

--| Derive the abbreviated version of the Axiom of Pairing from ~ ax-pr . See ~ zfpair for its derivation from the other axioms. (Contributed by NM, 14-Nov-2006.)
theorem zfpair2_b {x3: setvar}:
  $ wcel (cpr (cv x3) (cv x3)) cvv $;

--| A singleton built on a setvar is a set. (Contributed by BJ, 15-Jan-2025.)
theorem vsnex {x3: setvar}:
  $ wcel (csn (cv x3)) cvv $;

--| Lemma for ~ axprg . (Contributed by GG, 11-Mar-2026.)
theorem axprglem {x3 z w: setvar} (A2 B2: class):
  $ wi (wceq (cv x3) A2) (wex z (wal w (wi (wo (wceq (cv w) A2) (wceq (cv w) B2)) (wcel (cv w) (cv z))))) $;

--| Derive The Axiom of Pairing with class variables. (Contributed by GG, 6-Mar-2026.)
theorem axprg {z w: setvar} (A2 B2: class):
  $ wex z (wal w (wi (wo (wceq (cv w) A2) (wceq (cv w) B2)) (wcel (cv w) (cv z)))) $;

--| The Axiom of Pairing using class variables. Theorem 7.13 of [Quine] p. 51. By virtue of its definition, an unordered pair remains a set (even though no longer a pair) even when its components are proper classes (see ~ prprc ), so we can dispense with hypotheses requiring them to be sets. (Contributed by NM, 15-Jul-1993.) Avoid ~ ax-nul and shorten proof. (Revised by GG, 6-Mar-2026.)
theorem prex (A2 B2: class):
  $ wcel (cpr A2 B2) cvv $;

--| A singleton is a set. Theorem 7.12 of [Quine] p. 51, proved using Extensionality, Separation and Pairing. See also ~ snexALT . (Contributed by NM, 7-Aug-1994.) (Revised by Mario Carneiro, 19-May-2013.) Avoid ~ ax-nul and shorten proof. (Revised by GG, 6-Mar-2026.)
theorem snex (A2: class):
  $ wcel (csn A2) cvv $;

--| A singleton built on a set is a set. Special case of ~ snex which is intuitionistically valid. (Contributed by NM, 7-Aug-1994.) (Revised by Mario Carneiro, 19-May-2013.) Extract from ~ snex and shorten proof. (Revised by BJ, 15-Jan-2025.) (Proof shortened by GG, 6-Mar-2026.)
theorem snexg (A2 V: class):
  $ wi (wcel A2 V) (wcel (csn A2) cvv) $;

--| Alternate proof of ~ snexg based on ~ vsnex , which uses an instance of ~ ax-sep . (Contributed by NM, 7-Aug-1994.) (Revised by Mario Carneiro, 19-May-2013.) Extract from ~ snex and shorten proof. (Revised by BJ, 15-Jan-2025.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem snexgALT (A2 V: class):
  $ wi (wcel A2 V) (wcel (csn A2) cvv) $;

--| Obsolete version of ~ snex as of 6-Mar-2026. (Contributed by NM, 7-Aug-1994.) (Revised by Mario Carneiro, 19-May-2013.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem snexOLD (A2: class):
  $ wcel (csn A2) cvv $;

--| Obsolete version of ~ prex as of 6-Mar-2026. (Contributed by NM, 15-Jul-1993.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem prexOLD (A2 B2: class):
  $ wcel (cpr A2 B2) cvv $;

--| There exist two sets, one a member of the other. This theorem looks similar to ~ el , but its meaning is different. It only depends on the axioms ~ ax-mp to ~ ax-4 , ~ ax-6 , and ~ ax-pr . This theorem does not exclude that these two sets could actually be one single set containing itself. That two different sets exist is proved by ~ exexneq . (Contributed by SN, 23-Dec-2024.)
theorem exel {x3 y1: setvar}:
  $ wex y1 (wex x3 (wcel (cv x3) (cv y1))) $;

--| There exist two different sets. (Contributed by NM, 7-Nov-2006.) Avoid ~ ax-13 . (Revised by BJ, 31-May-2019.) Avoid ~ ax-8 . (Revised by SN, 21-Sep-2023.) Avoid ~ ax-12 . (Revised by Rohan Ridenour, 9-Oct-2024.) Use ~ ax-pr instead of ~ ax-pow . (Revised by BTernaryTau, 3-Dec-2024.) Extract this result from the proof of ~ dtru . (Revised by BJ, 2-Jan-2025.)
theorem exexneq {x3 y1: setvar}:
  $ wex x3 (wex y1 (wn (wceq (cv x3) (cv y1)))) $;

--| Given any set (the " ` y ` " in the statement), there exists a set not equal to it. The same statement without disjoint variable condition is false, since we do not have ` E. x -. x = x ` . This theorem is proved directly from set theory axioms (no class definitions) and does not depend on ~ ax-ext , ~ ax-sep , or ~ ax-pow nor auxiliary logical axiom schemes ~ ax-10 to ~ ax-13 . See ~ dtruALT for a shorter proof using more axioms, and ~ dtruALT2 for a proof using ~ ax-pow instead of ~ ax-pr . (Contributed by NM, 7-Nov-2006.) Avoid ~ ax-13 . (Revised by BJ, 31-May-2019.) Avoid ~ ax-8 . (Revised by SN, 21-Sep-2023.) Avoid ~ ax-12 . (Revised by Rohan Ridenour, 9-Oct-2024.) Use ~ ax-pr instead of ~ ax-pow . (Revised by BTernaryTau, 3-Dec-2024.) Extract this result from the proof of ~ dtru . (Revised by BJ, 2-Jan-2025.)
theorem exneq {x3 y1: setvar}:
  $ wex x3 (wn (wceq (cv x3) (cv y1))) $;

--| Given any set (the " ` y ` " in the statement), not all sets are equal to it. The same statement without disjoint variable condition is false since it contradicts ~ stdpc6 . The same comments and revision history concerning axiom usage as in ~ exneq apply. See ~ dtruALT and ~ dtruALT2 for alternate proofs avoiding ~ ax-pr . (Contributed by NM, 7-Nov-2006.) Extract ~ exneq as an intermediate result. (Revised by BJ, 2-Jan-2025.)
theorem dtru {x3 y1: setvar}:
  $ wn (wal x3 (wceq (cv x3) (cv y1))) $;

--| Any set is an element of some other set. See ~ elALT for a shorter proof using more axioms, and see ~ elALT2 for a proof that uses ~ ax-9 and ~ ax-pow instead of ~ ax-pr . (Contributed by NM, 4-Jan-2002.) (Proof shortened by Andrew Salmon, 25-Jul-2011.) Use ~ ax-pr instead of ~ ax-9 and ~ ax-pow . (Revised by BTernaryTau, 2-Dec-2024.) (Proof shortened by Matthew House, 6-Apr-2026.)
theorem el {x3 y1: setvar}:
  $ wex y1 (wcel (cv x3) (cv y1)) $;

--| Obsolete version of ~ el as of 6-Apr-2026. (Contributed by NM, 4-Jan-2002.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem el_OLD {x3 y1: setvar}:
  $ wex y1 (wcel (cv x3) (cv y1)) $;

--| If a class is a set, then it is a member of a set. (Contributed by NM, 4-Jan-2002.) Generalize from the proof of ~ elALT . (Revised by BJ, 3-Apr-2019.) Avoid ~ ax-sep , ~ ax-nul , ~ ax-pow . (Revised by BTernaryTau, 15-Jan-2025.)
theorem sels {x3: setvar} (A2: class) (V: class x3):
  $ wi (wcel A2 V) (wex x3 (wcel A2 (cv x3))) $;

--| Alternate proof of ~ sels , requiring ~ ax-sep but not using ~ el (which is proved from it as ~ elALT ). (especially when the proof of ~ el is inlined in ~ sels ). (Contributed by NM, 4-Jan-2002.) Generalize from the proof of ~ elALT . (Revised by BJ, 3-Apr-2019.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem selsALT {x3: setvar} (A2: class) (V: class x3):
  $ wi (wcel A2 V) (wex x3 (wcel A2 (cv x3))) $;

--| Alternate proof of ~ el , shorter but requiring ~ ax-sep . (Contributed by NM, 4-Jan-2002.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem elALT {x3 y1: setvar}:
  $ wex y1 (wcel (cv x3) (cv y1)) $;

--| A singleton of a set is a member of the powerclass of a class if and only if that set is a member of that class. (Contributed by NM, 1-Apr-1998.) Put in closed form and avoid ~ ax-nul . (Revised by BJ, 17-Jan-2025.)
theorem snelpwg (A2 B2 V: class):
  $ wi (wcel A2 V) (wb (wcel A2 B2) (wcel (csn A2) (cpw B2))) $;

--| If a set is a member of a class, then the singleton of that set is a member of the powerclass of that class. (Contributed by Alan Sare, 25-Aug-2011.)
theorem snelpwi (A2 B2: class):
  $ wi (wcel A2 B2) (wcel (csn A2) (cpw B2)) $;

--| A singleton of a set is a member of the powerclass of a class if and only if that set is a member of that class. (Contributed by NM, 1-Apr-1998.)
theorem snelpw (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 B2) (wcel (csn A2) (cpw B2)) $;

--| An unordered pair of two sets is a member of the powerclass of a class if and only if the two sets are members of that class. (Contributed by AV, 8-Jan-2020.)
theorem prelpw (A2 B2 C V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wa (wcel A2 C) (wcel B2 C)) (wcel (cpr A2 B2) (cpw C))) $;

--| If two sets are members of a class, then the unordered pair of those two sets is a member of the powerclass of that class. (Contributed by Thierry Arnoux, 10-Mar-2017.) (Proof shortened by AV, 23-Oct-2021.)
theorem prelpwi (A2 B2 C: class):
  $ wi (wa (wcel A2 C) (wcel B2 C)) (wcel (cpr A2 B2) (cpw C)) $;

--| A theorem similar to extensionality, requiring the existence of a singleton. Exercise 8 of [TakeutiZaring] p. 16. (Contributed by NM, 10-Aug-1993.)
theorem rext {x3 y1 z: setvar}:
  $ wi (wal z (wi (wcel (cv x3) (cv z)) (wcel (cv y1) (cv z)))) (wceq (cv x3) (cv y1)) $;

--| The powerclass construction preserves and reflects inclusion. Classes are subclasses if and only if their power classes are subclasses. Exercise 18 of [TakeutiZaring] p. 18. (Contributed by NM, 13-Oct-1996.)
theorem sspwb (A2 B2: class):
  $ wb (wss A2 B2) (wss (cpw A2) (cpw B2)) $;

--| A class equals the union of its power class. Exercise 6(a) of [Enderton] p. 38. (Contributed by NM, 14-Oct-1996.) (Proof shortened by Alan Sare, 28-Dec-2008.)
theorem unipw (A2: class):
  $ wceq (cuni (cpw A2)) A2 $;

--| The union of the universe is the universe. Exercise 4.12(c) of [Mendelson] p. 235. (Contributed by NM, 14-Sep-2003.)
theorem univ:
  $ wceq (cuni cvv) cvv $;

--| A class is transitive iff its power class is transitive. (Contributed by Alan Sare, 25-Aug-2011.) (Revised by Mario Carneiro, 15-Jun-2014.)
theorem pwtr (A2: class):
  $ wb (wtr A2) (wtr (cpw A2)) $;

--| An extensionality-like principle defining subclass in terms of subsets. (Contributed by NM, 30-Jun-2004.)
theorem ssextss {x3: setvar} (A2 B2: class):
  $ wb (wss A2 B2) (wal x3 (wi (wss (cv x3) A2) (wss (cv x3) B2))) $;

--| An extensionality-like principle that uses the subset instead of the membership relation: two classes are equal iff they have the same subsets. (Contributed by NM, 30-Jun-2004.)
theorem ssext {x3: setvar} (A2 B2: class):
  $ wb (wceq A2 B2) (wal x3 (wb (wss (cv x3) A2) (wss (cv x3) B2))) $;

--| Negation of subclass relationship. Compare ~ nss . (Contributed by NM, 30-Jun-2004.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem nssss {x3: setvar} (A2 B2: class):
  $ wb (wn (wss A2 B2)) (wex x3 (wa (wss (cv x3) A2) (wn (wss (cv x3) B2)))) $;

--| Classes are equal if and only if their power classes are equal. Exercise 19 of [TakeutiZaring] p. 18. (Contributed by NM, 13-Oct-1996.)
theorem pweqb (A2 B2: class):
  $ wb (wceq A2 B2) (wceq (cpw A2) (cpw B2)) $;

--| The intersection of all sets to which a set belongs is the singleton of that set. (Contributed by NM, 5-Jun-2009.) Put in closed form and avoid ~ ax-nul . (Revised by BJ, 17-Jan-2025.)
theorem intidg {x3: setvar} (A2: class) (V: class x3):
  $ wi (wcel A2 V) (wceq (cint (cab x3 (wcel A2 (cv x3)))) (csn A2)) $;

--| "At most one" existence implies a class abstraction exists. (Contributed by NM, 30-Dec-1996.) Avoid axioms. (Revised by SN, 2-Feb-2026.)
theorem moabex {x3: setvar} (ph: wff x3):
  $ wi (wmo x3 ph) (wcel (cab x3 ph) cvv) $;

--| Obsolete version of ~ moabex as of 2-Feb-2026. (Contributed by NM, 30-Dec-1996.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem moabexOLD {x3: setvar} (ph: wff x3):
  $ wi (wmo x3 ph) (wcel (cab x3 ph) cvv) $;

--| Restricted "at most one" existence implies a restricted class abstraction exists. (Contributed by NM, 17-Jun-2017.)
theorem rmorabex {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wrmo x3 ph A2) (wcel (crab x3 ph A2) cvv) $;

--| The abstraction of a wff with existential uniqueness exists. (Contributed by NM, 25-Nov-1994.)
theorem euabex {x3: setvar} (ph: wff x3):
  $ wi (weu x3 ph) (wcel (cab x3 ph) cvv) $;

--| A nonempty class (even if proper) has a nonempty subset. (Contributed by NM, 23-Aug-2003.)
theorem nnullss {x3: setvar} (A2: class):
  $ wi (wne A2 c0) (wex x3 (wa (wss (cv x3) A2) (wne (cv x3) c0))) $;

--| Restricted existence in a class (even if proper) implies restricted existence in a subset. (Contributed by NM, 23-Aug-2003.)
theorem exss {x3 y1: setvar} (ph: wff x3) (A2: class):
  $ wi (wrex x3 ph A2) (wex y1 (wa (wss (cv y1) A2) (wrex x3 ph (cv y1)))) $;

--| An ordered pair of classes is a set. Exercise 7 of [TakeutiZaring] p. 16. (Contributed by NM, 18-Aug-1993.) (Revised by Mario Carneiro, 26-Apr-2015.) Avoid ~ ax-nul . (Revised by GG, 6-Mar-2026.)
theorem opex (A2 B2: class):
  $ wcel (cop A2 B2) cvv $;

--| Obsolete version of ~ opex as of 6-Mar-2026. (Contributed by NM, 18-Aug-1993.) (Revised by Mario Carneiro, 26-Apr-2015.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem opexOLD (A2 B2: class):
  $ wcel (cop A2 B2) cvv $;

--| An ordered triple of classes is a set. (Contributed by NM, 3-Apr-2015.)
theorem otex (A2 B2 C: class):
  $ wcel (cotp A2 B2 C) cvv $;

--| Characterization of the elements of an ordered pair. Closed form of ~ elop . (Contributed by BJ, 22-Jun-2019.) (Avoid depending on this detail.)
theorem elopg (A2 B2 C V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wcel C (cop A2 B2)) (wo (wceq C (csn A2)) (wceq C (cpr A2 B2)))) $;

--| Characterization of the elements of an ordered pair. Exercise 3 of [TakeutiZaring] p. 15. (Contributed by NM, 15-Jul-1993.) (Revised by Mario Carneiro, 26-Apr-2015.) Remove an extraneous hypothesis. (Revised by BJ, 25-Dec-2020.) (Avoid depending on this detail.)
theorem elop (A2 B2 C: class):
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wb (wcel A2 (cop B2 C)) (wo (wceq A2 (csn B2)) (wceq A2 (cpr B2 C))) $;

--| One of the two elements in an ordered pair. (Contributed by NM, 15-Jul-1993.) (Revised by Mario Carneiro, 26-Apr-2015.) (Avoid depending on this detail.)
theorem opi1 (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel (csn A2) (cop A2 B2) $;

--| One of the two elements of an ordered pair. (Contributed by NM, 5-Aug-1993.) (Revised by Mario Carneiro, 26-Apr-2015.) (Avoid depending on this detail.)
theorem opi2 (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel (cpr A2 B2) (cop A2 B2) $;

--| Each member of an ordered pair belongs to the union of the union of a class to which the ordered pair belongs. Lemma 3D of [Enderton] p. 41. (Contributed by NM, 31-Mar-1995.) (Revised by Mario Carneiro, 27-Feb-2016.)
theorem opeluu (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wcel (cop A2 B2) C) (wa (wcel A2 (cuni (cuni C))) (wcel B2 (cuni (cuni C)))) $;

--| Extract the first member of an ordered pair. Theorem 73 of [Suppes] p. 42. (See ~ op2ndb to extract the second member, ~ op1sta for an alternate version, and ~ op1st for the preferred version.) (Contributed by NM, 25-Nov-2003.)
theorem op1stb (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq (cint (cint (cop A2 B2))) A2 $;

--| Two classes are always in relation by ` _V ` . This is simply equivalent to ` <. A , B >. e. _V ` , and does not imply that ` _V ` is a relation: see ~ nrelv . (Contributed by Scott Fenton, 11-Apr-2012.)
theorem brv (A2 B2: class):
  $ wbr A2 B2 cvv $;

--| An ordered pair is nonempty iff the arguments are sets. (Contributed by NM, 24-Jan-2004.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem opnz (A2 B2: class):
  $ wb (wne (cop A2 B2) c0) (wa (wcel A2 cvv) (wcel B2 cvv)) $;

--| An ordered pair is nonempty if the arguments are sets. (Contributed by Mario Carneiro, 26-Apr-2015.)
theorem opnzi (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wne (cop A2 B2) c0 $;

--| Equality of the first members of equal ordered pairs. (Contributed by NM, 28-May-2008.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem opth1 (A2 B2 C D: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wceq (cop A2 B2) (cop C D)) (wceq A2 C) $;

--| The ordered pair theorem. If two ordered pairs are equal, their first elements are equal and their second elements are equal. Exercise 6 of [TakeutiZaring] p. 16. Note that ` C ` and ` D ` are not required to be sets due our specific ordered pair definition. (Contributed by NM, 28-May-1995.)
theorem opth (A2 B2 C D: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wb (wceq (cop A2 B2) (cop C D)) (wa (wceq A2 C) (wceq B2 D)) $;

--| Ordered pair theorem. ` C ` and ` D ` are not required to be sets under our specific ordered pair definition. (Contributed by NM, 14-Oct-2005.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem opthg (A2 B2 C D V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wceq (cop A2 B2) (cop C D)) (wa (wceq A2 C) (wceq B2 D))) $;

--| Equality of the first members of equal ordered pairs. Closed form of ~ opth1 . (Contributed by AV, 14-Oct-2018.)
theorem opth1g (A2 B2 C D V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wi (wceq (cop A2 B2) (cop C D)) (wceq A2 C)) $;

--| Ordered pair theorem. (Contributed by NM, 14-Oct-2005.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem opthg2 (A2 B2 C D V W: class):
  $ wi (wa (wcel C V) (wcel D W)) (wb (wceq (cop A2 B2) (cop C D)) (wa (wceq A2 C) (wceq B2 D))) $;

--| Ordered pair theorem. (Contributed by NM, 21-Sep-2014.)
theorem opth2 (A2 B2 C D: class):
  $ wcel C cvv $ >
  $ wcel D cvv $ >
  $ wb (wceq (cop A2 B2) (cop C D)) (wa (wceq A2 C) (wceq B2 D)) $;

--| Two ordered pairs are not equal iff their first components or their second components are not equal. (Contributed by AV, 13-Dec-2018.)
theorem opthneg (A2 B2 C D V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wne (cop A2 B2) (cop C D)) (wo (wne A2 C) (wne B2 D))) $;

--| Two ordered pairs are not equal iff their first components or their second components are not equal. (Contributed by AV, 13-Dec-2018.)
theorem opthne (A2 B2 C D: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wb (wne (cop A2 B2) (cop C D)) (wo (wne A2 C) (wne B2 D)) $;

--| Ordered triple theorem, with triple expressed with ordered pairs. (Contributed by NM, 1-May-1995.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem otth2 (A2 B2 C D R S: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel R cvv $ >
  $ wb (wceq (cop (cop A2 B2) R) (cop (cop C D) S)) (w3a (wceq A2 C) (wceq B2 D) (wceq R S)) $;

--| Ordered triple theorem. (Contributed by NM, 25-Sep-2014.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem otth (A2 B2 C D R S: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel R cvv $ >
  $ wb (wceq (cotp A2 B2 R) (cotp C D S)) (w3a (wceq A2 C) (wceq B2 D) (wceq R S)) $;

--| Ordered triple theorem, closed form. (Contributed by Alexander van der Vekens, 10-Mar-2018.)
theorem otthg (A2 B2 C D U E F V W: class):
  $ wi (w3a (wcel A2 U) (wcel B2 V) (wcel C W)) (wb (wceq (cotp A2 B2 C) (cotp D E F)) (w3a (wceq A2 D) (wceq B2 E) (wceq C F))) $;

--| Contrapositive of the ordered triple theorem. (Contributed by Scott Fenton, 31-Jan-2025.)
theorem otthne (A2 B2 C D E F: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wb (wne (cotp A2 B2 C) (cotp D E F)) (w3o (wne A2 D) (wne B2 E) (wne C F)) $;

--| A variable introduction law for ordered pairs. Analogue of Lemma 15 of [Monk2] p. 109. (Contributed by NM, 28-May-1995.)
theorem eqvinop {x3 y1: setvar} (A2 B2 C: class):
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wb (wceq A2 (cop B2 C)) (wex x3 (wex y1 (wa (wceq A2 (cop (cv x3) (cv y1))) (wceq (cop (cv x3) (cv y1)) (cop B2 C))))) $;

--| A variable introduction law for ordered triples, analogous to ~ eqvinop . (Contributed by BTernaryTau, 8-Sep-2026.)
theorem eqvinot {x3 y1 z: setvar} (A2 B2 C D: class):
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wcel D cvv $ >
  $ wb (wceq A2 (cotp B2 C D)) (wex x3 (wex y1 (wex z (wa (wceq A2 (cotp (cv x3) (cv y1) (cv z))) (wceq (cotp (cv x3) (cv y1) (cv z)) (cotp B2 C D)))))) $;

--| The proper substitution of an ordered pair for a setvar variable corresponds to a proper substitution of its first component. (Contributed by AV, 8-Apr-2023.)
theorem sbcop1 {x3 y1 z a: setvar} (ph: wff z a) (ps: wff x3 y1 a):
  $ wi (wceq (cv z) (cop (cv x3) (cv y1))) (wb ph ps) $ >
  $ wb (wsbc x3 ps (cv a)) (wsbc z ph (cop (cv a) (cv y1))) $;

--| The proper substitution of an ordered pair for a setvar variable corresponds to a proper substitution of each of its components. (Contributed by AV, 8-Apr-2023.)
theorem sbcop {x3 y1 z a b: setvar} (ph: wff z a b) (ps: wff x3 y1 a b):
  $ wi (wceq (cv z) (cop (cv x3) (cv y1))) (wb ph ps) $ >
  $ wb (wsbc y1 (wsbc x3 ps (cv a)) (cv b)) (wsbc z ph (cop (cv a) (cv b))) $;

--| Version of ~ copsexg with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by GG, 26-Jan-2024.) Shorten proof and remove dependency on ~ ax-10 . (Revised by Eric Schmidt, 2-May-2026.)
theorem copsexgw {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wi (wceq A2 (cop (cv x3) (cv y1))) (wb ph (wex x3 (wex y1 (wa (wceq A2 (cop (cv x3) (cv y1))) ph)))) $;

--| Obsolete version of ~ copsexgw as of 2-May-2026. (Contributed by GG, 26-Jan-2024.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem copsexgwOLD {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wi (wceq A2 (cop (cv x3) (cv y1))) (wb ph (wex x3 (wex y1 (wa (wceq A2 (cop (cv x3) (cv y1))) ph)))) $;

--| Substitution of class ` A ` for ordered pair ` <. x , y >. ` . Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ copsexgw when possible. (Contributed by NM, 27-Dec-1996.) (Revised by Andrew Salmon, 11-Jul-2011.) (Proof shortened by Wolf Lammen, 25-Aug-2019.) (New usage is discouraged.)
theorem copsexg {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wi (wceq A2 (cop (cv x3) (cv y1))) (wb ph (wex x3 (wex y1 (wa (wceq A2 (cop (cv x3) (cv y1))) ph)))) $;

--| Substitution of class ` A ` for ordered triple ` <. x , y , z >. ` , analogous to ~ copsexgw . (Contributed by BTernaryTau, 8-Sep-2026.)
theorem cotsexgw {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2: class):
  $ wi (wceq A2 (cotp (cv x3) (cv y1) (cv z))) (wb ph (wex x3 (wex y1 (wex z (wa (wceq A2 (cotp (cv x3) (cv y1) (cv z))) ph))))) $;

--| Closed theorem form of ~ copsex2g . (Contributed by NM, 17-Feb-2013.)
theorem copsex2t {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2 B2: class) (V W: class x3 y1):
  $ wi (wa (wal x3 (wal y1 (wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps)))) (wa (wcel A2 V) (wcel B2 W))) (wb (wex x3 (wex y1 (wa (wceq (cop A2 B2) (cop (cv x3) (cv y1))) ph))) ps) $;

--| Implicit substitution inference for ordered pairs. (Contributed by NM, 28-May-1995.) Use a similar proof to ~ copsex4g to reduce axiom usage. (Revised by SN, 1-Sep-2024.)
theorem copsex2g {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2 B2: class) (V W: class x3 y1):
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wex x3 (wex y1 (wa (wceq (cop A2 B2) (cop (cv x3) (cv y1))) ph))) ps) $;

--| Implicit substitution deduction for ordered pairs. (Contributed by Thierry Arnoux, 4-May-2025.)
theorem copsex2dv {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (ch: wff) (A2 B2: class) (U V: class x3 y1):
  $ wi ph (wcel A2 U) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wb ps ch) $ >
  $ wi ph (wb (wex x3 (wex y1 (wa (wceq (cop A2 B2) (cop (cv x3) (cv y1))) ps))) ch) $;

--| An implicit substitution inference for 2 ordered pairs. (Contributed by NM, 5-Aug-1995.)
theorem copsex4g {x3 y1 z w: setvar} (ph: wff x3 y1 z w) (ps: wff) (A2 B2 C D R S: class):
  $ wi (wa (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wa (wceq (cv z) C) (wceq (cv w) D))) (wb ph ps) $ >
  $ wi (wa (wa (wcel A2 R) (wcel B2 S)) (wa (wcel C R) (wcel D S))) (wb (wex x3 (wex y1 (wex z (wex w (wa (wa (wceq (cop A2 B2) (cop (cv x3) (cv y1))) (wceq (cop C D) (cop (cv z) (cv w)))) ph))))) ps) $;

--| A property of ordered pairs. (Contributed by Mario Carneiro, 26-Apr-2015.)
theorem _0nelop (A2 B2: class):
  $ wn (wcel c0 (cop A2 B2)) $;

--| An ordered pair is equal to the ordered pair without the empty set. This is because no ordered pair contains the empty set. (Contributed by AV, 15-Nov-2021.)
theorem opwo0id (X Y: class):
  $ wceq (cop X Y) (cdif (cop X Y) (csn c0)) $;

--| Equivalence of existence implied by equality of ordered pairs. (Contributed by NM, 28-May-2008.)
theorem opeqex (A2 B2 C D: class):
  $ wi (wceq (cop A2 B2) (cop C D)) (wb (wa (wcel A2 cvv) (wcel B2 cvv)) (wa (wcel C cvv) (wcel D cvv))) $;

--| Equivalence of existence implied by equality of ordered triples. (Contributed by NM, 26-Apr-2015.)
theorem oteqex2 (A2 B2 C R S T: class):
  $ wi (wceq (cop (cop A2 B2) C) (cop (cop R S) T)) (wb (wcel C cvv) (wcel T cvv)) $;

--| Equivalence of existence implied by equality of ordered triples. (Contributed by NM, 28-May-2008.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem oteqex (A2 B2 C R S T: class):
  $ wi (wceq (cop (cop A2 B2) C) (cop (cop R S) T)) (wb (w3a (wcel A2 cvv) (wcel B2 cvv) (wcel C cvv)) (w3a (wcel R cvv) (wcel S cvv) (wcel T cvv))) $;

--| An ordered pair commutes iff its members are equal. (Contributed by NM, 28-May-2009.)
theorem opcom (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wb (wceq (cop A2 B2) (cop B2 A2)) (wceq A2 B2) $;

--| "At most one" property of an ordered pair. (Contributed by NM, 11-Apr-2004.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem moop2 {x3: setvar} (A2: class) (B2: class x3):
  $ wcel B2 cvv $ >
  $ wmo x3 (wceq A2 (cop B2 (cv x3))) $;

--| Equivalence for an ordered pair equal to a singleton. (Contributed by NM, 3-Jun-2008.) (Revised by AV, 15-Jul-2022.) (Avoid depending on this detail.)
theorem opeqsng (A2 B2 C V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wceq (cop A2 B2) (csn C)) (wa (wceq A2 B2) (wceq C (csn A2)))) $;

--| Equivalence for an ordered pair equal to a singleton. (Contributed by NM, 3-Jun-2008.) (Revised by AV, 15-Jul-2022.) (Avoid depending on this detail.)
theorem opeqsn (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wb (wceq (cop A2 B2) (csn C)) (wa (wceq A2 B2) (wceq C (csn A2))) $;

--| Equivalence for an ordered pair equal to an unordered pair. (Contributed by NM, 3-Jun-2008.) (Avoid depending on this detail.)
theorem opeqpr (A2 B2 C D: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wcel D cvv $ >
  $ wb (wceq (cop A2 B2) (cpr C D)) (wo (wa (wceq C (csn A2)) (wceq D (cpr A2 B2))) (wa (wceq C (cpr A2 B2)) (wceq D (csn A2)))) $;

--| Equivalence for an ordered pair equal to a singleton of an ordered pair. (Contributed by AV, 18-Sep-2020.) (Revised by AV, 15-Jul-2022.) (Avoid depending on this detail.)
theorem snopeqop (A2 B2 C D: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wb (wceq (csn (cop A2 B2)) (cop C D)) (w3a (wceq A2 B2) (wceq C D) (wceq C (csn A2))) $;

--| Equivalence for an ordered pair equal to a pair of ordered pairs. (Contributed by AV, 18-Sep-2020.) (Proof shortened by AV, 16-Jun-2022.) (Avoid depending on this detail.)
theorem propeqop (A2 B2 C D E F: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wcel D cvv $ >
  $ wcel E cvv $ >
  $ wcel F cvv $ >
  $ wb (wceq (cpr (cop A2 B2) (cop C D)) (cop E F)) (wa (wa (wceq A2 C) (wceq E (csn A2))) (wo (wa (wceq A2 B2) (wceq F (cpr A2 D))) (wa (wceq A2 D) (wceq F (cpr A2 B2))))) $;

--| If a pair of ordered pairs is a subset of an ordered pair, their first components are equal. (Contributed by AV, 20-Sep-2020.) (Proof shortened by AV, 16-Jun-2022.) (Avoid depending on this detail.)
theorem propssopi (A2 B2 C D E F: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wcel D cvv $ >
  $ wcel E cvv $ >
  $ wcel F cvv $ >
  $ wi (wss (cpr (cop A2 B2) (cop C D)) (cop E F)) (wceq A2 C) $;

--| Equivalence for an ordered pair of two identical singletons equal to a singleton of an ordered pair. (Contributed by AV, 24-Sep-2020.) (Revised by AV, 15-Jul-2022.) (Avoid depending on this detail.)
theorem snopeqopsnid (A2: class):
  $ wcel A2 cvv $ >
  $ wceq (csn (cop A2 A2)) (cop (csn A2) (csn A2)) $;

--| "At most one" remains true inside ordered pair quantification. (Contributed by NM, 28-Aug-2007.)
theorem mosubopt {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2: class):
  $ wi (wal y1 (wal z (wmo x3 ph))) (wmo x3 (wex y1 (wex z (wa (wceq A2 (cop (cv y1) (cv z))) ph)))) $;

--| "At most one" remains true inside ordered pair quantification. (Contributed by NM, 28-May-1995.)
theorem mosubop {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2: class):
  $ wmo x3 ph $ >
  $ wmo x3 (wex y1 (wex z (wa (wceq A2 (cop (cv y1) (cv z))) ph))) $;

--| "At most one" remains true inside ordered triple quantification, analogous to ~ mosubopt . (Contributed by BTernaryTau, 8-Sep-2026.)
theorem mosubott {x3 y1 z w: setvar} (ph: wff x3 y1 z w) (A2: class):
  $ wi (wal x3 (wal y1 (wal z (wmo w ph)))) (wmo w (wex x3 (wex y1 (wex z (wa (wceq A2 (cotp (cv x3) (cv y1) (cv z))) ph))))) $;

--| Transfer existential uniqueness to second member of an ordered pair. (Contributed by NM, 10-Apr-2004.)
theorem euop2 {x3 y1: setvar} (ph: wff y1) (A2: class y1):
  $ wcel A2 cvv $ >
  $ wb (weu x3 (wex y1 (wa (wceq (cv x3) (cop A2 (cv y1))) ph))) (weu y1 ph) $;

--| Prove existential uniqueness for an ordered triple. (Contributed by Mario Carneiro, 20-May-2015.)
theorem euotd {x3 a b c: setvar} (ph: wff) (ps: wff x3 a b c) (A2 B2 C: class) (U V W: class x3 a b c):
  $ wi ph (wcel A2 U) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wcel C W) $ >
  $ wi ph (wb ps (w3a (wceq (cv a) A2) (wceq (cv b) B2) (wceq (cv c) C))) $ >
  $ wi ph (weu x3 (wex a (wex b (wex c (wa (wceq (cv x3) (cotp (cv a) (cv b) (cv c))) ps))))) $;

--| Justification theorem for the ordered pair definition in Norbert Wiener, _A simplification of the logic of relations_, Proceedings of the Cambridge Philosophical Society, 1914, vol. 17, pp.387-390. It is also shown as a definition in [Enderton] p. 36 and as Exercise 4.8(b) of [Mendelson] p. 230. It is meaningful only for classes that exist as sets (i.e., are not proper classes). See ~ df-op for other ordered pair definitions. (Contributed by NM, 28-Sep-2003.)
theorem opthwiener (A2 B2 C D: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wb (wceq (cpr (cpr (csn A2) c0) (csn (csn B2))) (cpr (cpr (csn C) c0) (csn (csn D)))) (wa (wceq A2 C) (wceq B2 D)) $;

--| The union of an ordered pair. Theorem 65 of [Suppes] p. 39. (Contributed by NM, 17-Aug-2004.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem uniop (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq (cuni (cop A2 B2)) (cpr A2 B2) $;

--| Ordered pair membership is inherited by class union. (Contributed by NM, 13-May-2008.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem uniopel (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wcel (cop A2 B2) C) (wcel (cuni (cop A2 B2)) (cuni C)) $;

--| Justification theorem for the ordered pair definition of Felix Hausdorff in "Grundz&uuml;ge der Mengenlehre" ("Basics of Set Theory"), 1914, p. 32: ` <. A , B >. `_H ` = { { A , O } , { B , T } } ` . Hausdorff used ` 1 ` and ` 2 ` instead of ` O ` and ` T ` , but actually, any two different fixed sets will do (e.g., ` O = (/) ` and ` T = { (/) } ` , see ~ 0nep0 ). Furthermore, Hausdorff demanded that ` O ` and ` T ` are both different from ` A ` as well as ` B ` , which is actually not necessary in full extent ( ` A =/= T ` is not required). This definition is meaningful only for classes ` A ` and ` B ` that exist as sets (i.e., are not proper classes): If ` A ` and ` C ` were different proper classes ( ` A =/= C ` ), then ` { { A , O } , { B , T } } = { { C , O } , { D , T } ` ` <-> { { O } , { B , T } } = { { O } , { D , T } ` is true if ` B = D ` , but ` ( A = C /\ B = D ) ` would be false. See ~ df-op for other ordered pair definitions. (Contributed by AV, 14-Jun-2022.)
theorem opthhausdorff (A2 B2 C D T O: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wne A2 O $ >
  $ wne B2 O $ >
  $ wne B2 T $ >
  $ wcel O cvv $ >
  $ wcel T cvv $ >
  $ wne O T $ >
  $ wb (wceq (cpr (cpr A2 O) (cpr B2 T)) (cpr (cpr C O) (cpr D T))) (wa (wceq A2 C) (wceq B2 D)) $;

--| Justification theorem for the ordered pair definition of Felix Hausdorff in "Grundz&uuml;ge der Mengenlehre" ("Basics of Set Theory"), 1914, p. 32: ` <. A , B >. `_H ` = { { A , O } , { B , T } } ` . Hausdorff used ` 1 ` and ` 2 ` instead of ` O ` and ` T ` , but actually, any two different fixed sets will do (e.g., ` O = (/) ` and ` T = { (/) } ` , see ~ 0nep0 ). Furthermore, Hausdorff demanded that ` O ` and ` T ` are both different from ` A ` as well as ` B ` , which is actually not necessary if all involved classes exist as sets (i.e. are not proper classes), in contrast to ~ opthhausdorff . See ~ df-op for other ordered pair definitions. (Contributed by AV, 12-Jun-2022.)
theorem opthhausdorff0 (A2 B2 C D T O: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wcel D cvv $ >
  $ wcel O cvv $ >
  $ wcel T cvv $ >
  $ wne O T $ >
  $ wb (wceq (cpr (cpr A2 O) (cpr B2 T)) (cpr (cpr C O) (cpr D T))) (wa (wceq A2 C) (wceq B2 D)) $;

--| The singletons consisting of ordered triples which have distinct third components are disjoint. (Contributed by Alexander van der Vekens, 10-Mar-2018.)
theorem otsndisj {c: setvar} (A2 B2 V X Y: class):
  $ wi (wa (wcel A2 X) (wcel B2 Y)) (wdisj c V (csn (cotp A2 B2 (cv c)))) $;

--| The union of singletons consisting of ordered triples which have distinct first and third components are disjoint. (Contributed by Alexander van der Vekens, 10-Mar-2018.)
theorem otiunsndisj {a c: setvar} (B2 V W X: class):
  $ wi (wcel B2 X) (wdisj a V (ciun c (cdif W (csn (cv a))) (csn (cotp (cv a) B2 (cv c))))) $;

--| Implication of an ordered pair being equal to an indexed union of singletons of ordered pairs. (Contributed by AV, 20-Sep-2020.) Remove antecedent. (Revised by Eric Schmidt, 9-May-2026.) (Avoid depending on this detail.)
theorem iunopeqop {x3 z: setvar} (A2: class) (B2: class x3 z) (C D: class z):
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wcel D cvv $ >
  $ wi (wceq (ciun x3 A2 (csn (cop (cv x3) B2))) (cop C D)) (wex z (wceq A2 (csn (cv z)))) $;

--| Obsolete version of ~ iunopeqop as of 9-May-2026. (Contributed by AV, 20-Sep-2020.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem iunopeqopOLD {x3 z: setvar} (A2: class) (B2: class x3 z) (C D: class z):
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wcel D cvv $ >
  $ wi (wne A2 c0) (wi (wceq (ciun x3 A2 (csn (cop (cv x3) B2))) (cop C D)) (wex z (wceq A2 (csn (cv z))))) $;

--| Binary relation for an ordered pair singleton. (Contributed by Thierry Arnoux, 23-Sep-2023.)
theorem brsnop (A2 B2 V W X Y: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wbr X Y (csn (cop A2 B2))) (wa (wceq X A2) (wceq Y B2))) $;

--| A necessary and sufficient condition for two sets to be related under a binary relation which is an unordered triple. (Contributed by Scott Fenton, 8-Jun-2011.)
theorem brtp (A2 B2 C D E F X Y: class):
  $ wcel X cvv $ >
  $ wcel Y cvv $ >
  $ wb (wbr X Y (ctp (cop A2 B2) (cop C D) (cop E F))) (w3o (wa (wceq X A2) (wceq Y B2)) (wa (wceq X C) (wceq Y D)) (wa (wceq X E) (wceq Y F))) $;

--| The law of concretion. Special case of Theorem 9.5 of [Quine] p. 61. Version of ~ opabid with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by NM, 14-Apr-1995.) Avoid ~ ax-13 . (Revised by GG, 26-Jan-2024.)
theorem opabidw {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wcel (cop (cv x3) (cv y1)) (copab x3 y1 ph)) ph $;

--| The law of concretion. Special case of Theorem 9.5 of [Quine] p. 61. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ opabidw when possible. (Contributed by NM, 14-Apr-1995.) (Proof shortened by Andrew Salmon, 25-Jul-2011.) (New usage is discouraged.)
theorem opabid {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wcel (cop (cv x3) (cv y1)) (copab x3 y1 ph)) ph $;

--| Membership in a class abstraction of ordered pairs. Weaker version of ~ elopab with a sethood antecedent, avoiding ~ ax-sep , ~ ax-nul , and ~ ax-pr . Originally a subproof of ~ elopab . (Contributed by SN, 11-Dec-2024.)
theorem elopabw {x3 y1: setvar} (ph: wff x3 y1) (A2: class) (V: class x3 y1):
  $ wi (wcel A2 V) (wb (wcel A2 (copab x3 y1 ph)) (wex x3 (wex y1 (wa (wceq A2 (cop (cv x3) (cv y1))) ph)))) $;

--| Membership in a class abstraction of ordered pairs. (Contributed by NM, 24-Mar-1998.)
theorem elopab {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wb (wcel A2 (copab x3 y1 ph)) (wex x3 (wex y1 (wa (wceq A2 (cop (cv x3) (cv y1))) ph))) $;

--| Restricted existential quantification over an ordered-pair class abstraction. (Contributed by AV, 8-Nov-2023.)
theorem rexopabb {x3 y1 o: setvar} (ph: wff x3 y1) (ps: wff o) (ch: wff x3 y1) (O: class x3 y1):
  $ wceq O (copab x3 y1 ph) $ >
  $ wi (wceq (cv o) (cop (cv x3) (cv y1))) (wb ps ch) $ >
  $ wb (wrex o ps O) (wex x3 (wex y1 (wa ph ch))) $;

--| The law of concretion in terms of substitutions. Version of ~ opelopabsb with set variables. (Contributed by NM, 30-Sep-2002.) (Proof shortened by Andrew Salmon, 25-Jul-2011.) Remove unnecessary commutation. (Revised by SN, 1-Sep-2024.)
theorem vopelopabsb {x3 y1 z w: setvar} (ph: wff x3 y1 z w):
  $ wb (wcel (cop (cv z) (cv w)) (copab x3 y1 ph)) (wsb x3 (wsb y1 ph w) z) $;

--| The law of concretion in terms of substitutions. (Contributed by NM, 30-Sep-2002.) (Revised by Mario Carneiro, 18-Nov-2016.)
theorem opelopabsb {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1) (B2: class y1):
  $ wb (wcel (cop A2 B2) (copab x3 y1 ph)) (wsbc x3 (wsbc y1 ph B2) A2) $;

--| The law of concretion in terms of substitutions. (Contributed by NM, 17-Mar-2008.)
theorem brabsb {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1) (B2: class y1) (R: class x3 y1):
  $ wceq R (copab x3 y1 ph) $ >
  $ wb (wbr A2 B2 R) (wsbc x3 (wsbc y1 ph B2) A2) $;

--| Closed theorem form of ~ opelopab . (Contributed by NM, 19-Feb-2013.)
theorem opelopabt {x3 y1: setvar} (ph ps: wff x3 y1) (ch: wff) (A2 B2: class) (V W: class x3 y1):
  $ wi (w3a (wal x3 (wal y1 (wi (wceq (cv x3) A2) (wb ph ps)))) (wal x3 (wal y1 (wi (wceq (cv y1) B2) (wb ps ch)))) (wa (wcel A2 V) (wcel B2 W))) (wb (wcel (cop A2 B2) (copab x3 y1 ph)) ch) $;

--| The law of concretion. Theorem 9.5 of [Quine] p. 61. (Contributed by Mario Carneiro, 19-Dec-2013.)
theorem opelopabga {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2 B2: class) (V W: class x3 y1):
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wcel (cop A2 B2) (copab x3 y1 ph)) ps) $;

--| The law of concretion for a binary relation. (Contributed by Mario Carneiro, 19-Dec-2013.)
theorem brabga {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2 B2: class) (R V W: class x3 y1):
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ wceq R (copab x3 y1 ph) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wbr A2 B2 R) ps) $;

--| Ordered pair membership in an ordered pair class abstraction. (Contributed by Mario Carneiro, 19-Dec-2013.)
theorem opelopab2a {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2 B2 C D: class):
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wb (wcel (cop A2 B2) (copab x3 y1 (wa (wa (wcel (cv x3) C) (wcel (cv y1) D)) ph))) ps) $;

--| The law of concretion. Theorem 9.5 of [Quine] p. 61. (Contributed by Mario Carneiro, 19-Dec-2013.)
theorem opelopaba {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ wb (wcel (cop A2 B2) (copab x3 y1 ph)) ps $;

--| The law of concretion for a binary relation. (Contributed by NM, 19-Dec-2013.)
theorem braba {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2 B2: class) (R: class x3 y1):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ wceq R (copab x3 y1 ph) $ >
  $ wb (wbr A2 B2 R) ps $;

--| Expressing that two sets are related by a binary relation which is expressed as a class abstraction of ordered pairs. (Contributed by Thierry Arnoux, 4-May-2025.)
theorem brab2d {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (ch: wff) (A2 B2: class) (R: class x3 y1) (U V: class):
  $ wi ph (wceq R (copab x3 y1 (wa (wa (wcel (cv x3) U) (wcel (cv y1) V)) ps))) $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wb ps ch) $ >
  $ wi ph (wb (wbr A2 B2 R) (wa (wa (wcel A2 U) (wcel B2 V)) ch)) $;

--| The law of concretion. Theorem 9.5 of [Quine] p. 61. (Contributed by NM, 28-May-1995.) (Revised by Mario Carneiro, 19-Dec-2013.)
theorem opelopabg {x3 y1: setvar} (ph ps: wff x3 y1) (ch: wff) (A2 B2: class) (V W: class x3 y1):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wcel (cop A2 B2) (copab x3 y1 ph)) ch) $;

--| The law of concretion for a binary relation. (Contributed by NM, 16-Aug-1999.) (Revised by Mario Carneiro, 19-Dec-2013.)
theorem brabg {x3 y1: setvar} (ph ps: wff x3 y1) (ch: wff) (A2 B2: class) (C D R: class x3 y1):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wceq R (copab x3 y1 ph) $ >
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wb (wbr A2 B2 R) ch) $;

--| The law of concretion. Theorem 9.5 of [Quine] p. 61. This version of ~ opelopabg uses bound-variable hypotheses in place of distinct variable conditions. (Contributed by Alexander van der Vekens, 8-Jul-2018.)
theorem opelopabgf {x3 y1: setvar} (ph ps ch: wff x3 y1) (A2 B2: class) (V W: class x3 y1):
  $ wnf x3 ps $ >
  $ wnf y1 ch $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wcel (cop A2 B2) (copab x3 y1 ph)) ch) $;

--| Ordered pair membership in an ordered pair class abstraction. (Contributed by NM, 14-Oct-2007.) (Revised by Mario Carneiro, 19-Dec-2013.)
theorem opelopab2 {x3 y1: setvar} (ph ps: wff x3 y1) (ch: wff) (A2 B2 C D: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wb (wcel (cop A2 B2) (copab x3 y1 (wa (wa (wcel (cv x3) C) (wcel (cv y1) D)) ph))) ch) $;

--| The law of concretion. Theorem 9.5 of [Quine] p. 61. (Contributed by NM, 16-May-1995.)
theorem opelopab {x3 y1: setvar} (ph ps: wff x3 y1) (ch: wff) (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wb (wcel (cop A2 B2) (copab x3 y1 ph)) ch $;

--| The law of concretion for a binary relation. (Contributed by NM, 16-Aug-1999.)
theorem brab {x3 y1: setvar} (ph ps: wff x3 y1) (ch: wff) (A2 B2: class) (R: class x3 y1):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wceq R (copab x3 y1 ph) $ >
  $ wb (wbr A2 B2 R) ch $;

--| The law of concretion. Theorem 9.5 of [Quine] p. 61. This version of ~ opelopab uses bound-variable hypotheses in place of distinct variable conditions. (Contributed by Mario Carneiro, 19-Dec-2013.) (Proof shortened by Mario Carneiro, 18-Nov-2016.)
theorem opelopabaf {x3 y1: setvar} (ph ps: wff x3 y1) (A2 B2: class):
  $ wnf x3 ps $ >
  $ wnf y1 ps $ >
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ wb (wcel (cop A2 B2) (copab x3 y1 ph)) ps $;

--| The law of concretion. Theorem 9.5 of [Quine] p. 61. This version of ~ opelopab uses bound-variable hypotheses in place of distinct variable conditions. (Contributed by NM, 19-Dec-2008.)
theorem opelopabf {x3 y1: setvar} (ph ps ch: wff x3 y1) (A2 B2: class):
  $ wnf x3 ps $ >
  $ wnf y1 ch $ >
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wb (wcel (cop A2 B2) (copab x3 y1 ph)) ch $;

--| Equivalence of ordered pair abstraction subclass and implication. (Contributed by NM, 27-Dec-1996.) (Revised by Mario Carneiro, 19-May-2013.)
theorem ssopab2 {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wal x3 (wal y1 (wi ph ps))) (wss (copab x3 y1 ph) (copab x3 y1 ps)) $;

--| Equivalence of ordered pair abstraction subclass and implication. Version of ~ ssopab2b with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by NM, 27-Dec-1996.) Avoid ~ ax-13 . (Revised by GG, 26-Jan-2024.)
theorem ssopab2bw {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wb (wss (copab x3 y1 ph) (copab x3 y1 ps)) (wal x3 (wal y1 (wi ph ps))) $;

--| Equivalence of ordered pair abstraction equality and biconditional. Version of ~ eqopab2b with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by Mario Carneiro, 4-Jan-2017.) Avoid ~ ax-13 . (Revised by GG, 26-Jan-2024.)
theorem eqopab2bw {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wb (wceq (copab x3 y1 ph) (copab x3 y1 ps)) (wal x3 (wal y1 (wb ph ps))) $;

--| Equivalence of ordered pair abstraction subclass and implication. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ ssopab2bw when possible. (Contributed by NM, 27-Dec-1996.) (Proof shortened by Mario Carneiro, 18-Nov-2016.) (New usage is discouraged.)
theorem ssopab2b {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wb (wss (copab x3 y1 ph) (copab x3 y1 ps)) (wal x3 (wal y1 (wi ph ps))) $;

--| Inference of ordered pair abstraction subclass from implication. (Contributed by NM, 5-Apr-1995.)
theorem ssopab2i {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi ph ps $ >
  $ wss (copab x3 y1 ph) (copab x3 y1 ps) $;

--| Inference of ordered pair abstraction subclass from implication. (Contributed by NM, 19-Jan-2014.) (Revised by Mario Carneiro, 24-Jun-2014.)
theorem ssopab2dv {x3 y1: setvar} (ph: wff) (ps ch: wff x3 y1):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wss (copab x3 y1 ps) (copab x3 y1 ch)) $;

--| Equivalence of ordered pair abstraction equality and biconditional. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ eqopab2bw when possible. (Contributed by Mario Carneiro, 4-Jan-2017.) (New usage is discouraged.)
theorem eqopab2b {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wb (wceq (copab x3 y1 ph) (copab x3 y1 ps)) (wal x3 (wal y1 (wb ph ps))) $;

--| Nonempty ordered pair class abstraction. (Contributed by NM, 10-Oct-2007.)
theorem opabn0 {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wne (copab x3 y1 ph) c0) (wex x3 (wex y1 ph)) $;

--| Empty ordered pair class abstraction. (Contributed by AV, 29-Oct-2021.)
theorem opab0 {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wceq (copab x3 y1 ph) c0) (wal x3 (wal y1 (wn ph))) $;

--| Move substitution into a class abstraction. Version of ~ csbopabw without a sethood antecedent but depending on more axioms. (Contributed by NM, 6-Aug-2007.) (Revised by NM, 23-Aug-2018.)
theorem csbopab {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2: class x3):
  $ wceq (csb x3 A2 (copab y1 z ph)) (copab y1 z (wsbc x3 ph A2)) $;

--| Move substitution into a class abstraction. Version of ~ csbopab with a sethood antecedent but depending on fewer axioms. (Contributed by NM, 6-Aug-2007.) (Proof shortened by Mario Carneiro, 17-Nov-2016.)
theorem csbopabw {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2: class x3) (V: class x3 y1 z):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (copab y1 z ph)) (copab y1 z (wsbc x3 ph A2))) $;

--| Move substitution into a maps-to notation. (Contributed by AV, 26-Sep-2019.)
theorem csbmpt12 {x3 y1: setvar} (A2 V Y: class x3) (Z: class x3 y1):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (cmpt y1 Y Z)) (cmpt y1 (csb x3 A2 Y) (csb x3 A2 Z))) $;

--| Move substitution into the second part of a maps-to notation. (Contributed by AV, 26-Sep-2019.)
theorem csbmpt2 {x3 y1: setvar} (A2 V: class x3) (Y: class) (Z: class x3 y1):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (cmpt y1 Y Z)) (cmpt y1 Y (csb x3 A2 Z))) $;

--| Move indexed union inside an ordered-pair class abstraction. (Contributed by Stefan O'Rear, 20-Feb-2015.) Avoid ~ ax-sep , ~ ax-nul , ~ ax-pr . (Revised by SN, 11-Nov-2024.)
theorem iunopab {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2: class z):
  $ wceq (ciun z A2 (copab x3 y1 ph)) (copab x3 y1 (wrex z ph A2)) $;

--| Membership in an ordered-pair class abstraction defined by a binary relation. (Contributed by AV, 16-Feb-2021.) (Proof shortened by SN, 11-Dec-2024.)
theorem elopabr {x3 y1: setvar} (A2: class x3 y1) (R: class):
  $ wi (wcel A2 (copab x3 y1 (wbr (cv x3) (cv y1) R))) (wcel A2 R) $;

--| Membership in an ordered-pair class abstraction defined by a restricted binary relation. (Contributed by AV, 16-Feb-2021.)
theorem elopabran {x3 y1: setvar} (ps: wff x3 y1) (A2: class x3 y1) (R: class):
  $ wi (wcel A2 (copab x3 y1 (wa (wbr (cv x3) (cv y1) R) ps))) (wcel A2 R) $;

--| Properties of a pair in an extended binary relation. (Contributed by Alexander van der Vekens, 30-Oct-2017.)
theorem rbropapd {f2 p: setvar} (ph ps: wff f2 p) (ch: wff) (P F: class) (M: class f2 p) (W: class) (X Y: class f2 p):
  $ wi ph (wceq M (copab f2 p (wa (wbr (cv f2) (cv p) W) ps))) $ >
  $ wi (wa (wceq (cv f2) F) (wceq (cv p) P)) (wb ps ch) $ >
  $ wi ph (wi (wa (wcel F X) (wcel P Y)) (wb (wbr F P M) (wa (wbr F P W) ch))) $;

--| Properties of a pair in a restricted binary relation ` M ` expressed as an ordered-pair class abstraction: ` M ` is the binary relation ` W ` restricted by the condition ` ps ` . (Contributed by AV, 31-Jan-2021.)
theorem rbropap {f2 p: setvar} (ph ps: wff f2 p) (ch: wff) (P F: class) (M: class f2 p) (W: class) (X Y: class f2 p):
  $ wi ph (wceq M (copab f2 p (wa (wbr (cv f2) (cv p) W) ps))) $ >
  $ wi (wa (wceq (cv f2) F) (wceq (cv p) P)) (wb ps ch) $ >
  $ wi (w3a ph (wcel F X) (wcel P Y)) (wb (wbr F P M) (wa (wbr F P W) ch)) $;

--| Properties of a pair in a restricted binary relation ` M ` expressed as an ordered-pair class abstraction: ` M ` is the binary relation ` W ` restricted by the conditions ` ps ` and ` ta ` . (Contributed by AV, 31-Jan-2021.)
theorem _2rbropap {f2 p: setvar} (ph ps: wff f2 p) (ch th: wff) (ta: wff f2 p) (P F: class) (M: class f2 p) (W: class) (X Y: class f2 p):
  $ wi ph (wceq M (copab f2 p (w3a (wbr (cv f2) (cv p) W) ps ta))) $ >
  $ wi (wa (wceq (cv f2) F) (wceq (cv p) P)) (wb ps ch) $ >
  $ wi (wa (wceq (cv f2) F) (wceq (cv p) P)) (wb ta th) $ >
  $ wi (w3a ph (wcel F X) (wcel P Y)) (wb (wbr F P M) (w3a (wbr F P W) ch th)) $;

--| The empty set is not an element of an ordered-pair class abstraction. (Contributed by Alexander van der Vekens, 5-Nov-2017.) Reduce axiom usage and shorten proof. (Revised by GG, 3-Oct-2024.)
theorem _0nelopab {x3 y1: setvar} (ph: wff x3 y1):
  $ wn (wcel c0 (copab x3 y1 ph)) $;

--| If two classes are in a relationship given by an ordered-pair class abstraction, the classes are sets. (Contributed by Alexander van der Vekens, 5-Nov-2017.)
theorem brabv {x3 y1: setvar} (ph: wff x3 y1) (X Y: class x3 y1):
  $ wi (wbr X Y (copab x3 y1 ph)) (wa (wcel X cvv) (wcel Y cvv)) $;

--| The power class of the intersection of two classes is the intersection of their power classes. Exercise 4.12(j) of [Mendelson] p. 235. (Contributed by NM, 23-Nov-2003.)
theorem pwin (A2 B2: class):
  $ wceq (cpw (cin A2 B2)) (cin (cpw A2) (cpw B2)) $;

--| The power class of the union of two classes is a subset of the union of their power classes, iff one class is a subclass of the other. Exercise 4.12(l) of [Mendelson] p. 235. (Contributed by NM, 23-Nov-2003.)
theorem pwssun (A2 B2: class):
  $ wb (wo (wss A2 B2) (wss B2 A2)) (wss (cpw (cun A2 B2)) (cun (cpw A2) (cpw B2))) $;

--| The power class of the union of two classes equals the union of their power classes, iff one class is a subclass of the other. Part of Exercise 7(b) of [Enderton] p. 28. (Contributed by NM, 23-Nov-2003.)
theorem pwun (A2 B2: class):
  $ wb (wo (wss A2 B2) (wss B2 A2)) (wceq (cpw (cun A2 B2)) (cun (cpw A2) (cpw B2))) $;

--| Extend the definition of a class to include the identity relation.
term cid: class;

--| Define the identity relation. Definition 9.15 of [Quine] p. 64. For example, ` 5 _I 5 ` and ` -. 4 _I 5 ` ( ~ ex-id ). (Contributed by NM, 13-Aug-1995.)
axiom df_id {x3 y1: setvar}:
  $ wceq cid (copab x3 y1 (wceq (cv x3) (cv y1))) $;

--| The identity function expressed using maps-to notation. (Contributed by Scott Fenton, 15-Dec-2017.)
theorem dfid4 {x3: setvar}:
  $ wceq cid (cmpt x3 cvv (cv x3)) $;

--| Alternate definition of the identity relation. Instance of ~ dfid3 not requiring auxiliary axioms. (Contributed by NM, 15-Mar-2007.) Reduce axiom usage. (Revised by GG, 4-Nov-2024.) (Proof shortened by BJ, 5-Nov-2024.) Use ~ df-id instead to make the semantics of the constructor ~ df-opab clearer. (New usage is discouraged.)
theorem dfid2 {x3: setvar}:
  $ wceq cid (copab x3 x3 (wceq (cv x3) (cv x3))) $;

--| A stronger version of ~ df-id that does not require ` x ` and ` y ` to be disjoint. This is not the definition since, in order to pass our definition soundness test, a definition has to have disjoint dummy variables, see ~ conventions . The proof can be instructive in showing how disjoint variable conditions may be eliminated, a task that is not necessarily obvious. (Contributed by NM, 5-Feb-2008.) (Revised by Mario Carneiro, 18-Nov-2016.) Use ~ df-id instead to make the semantics of the constructor ~ df-opab clearer (in usages, ` x , y ` will typically be dummy variables, so can be assumed disjoint). (New usage is discouraged.)
theorem dfid3 {x3 y1: setvar}:
  $ wceq cid (copab x3 y1 (wceq (cv x3) (cv y1))) $;

--| Extend class notation to include the membership relation.
term cep: class;

--| Define the membership relation (also called "epsilon relation" since it is sometimes denoted by the lowercase Greek letter "epsilon"). Similar to Definition 6.22 of [TakeutiZaring] p. 30. The membership relation and the membership predicate agree, that is, ` ( A _E B <-> A e. B ) ` , when ` B ` is a set (see ~ epelg ). Thus, ` |- 5 _E { 1 , 5 } ` ( ~ ex-eprel ). (Contributed by NM, 13-Aug-1995.)
axiom df_eprel {x3 y1: setvar}:
  $ wceq cep (copab x3 y1 (wcel (cv x3) (cv y1))) $;

--| The membership relation and the membership predicate agree when the "containing" class is a set. General version of ~ epel and closed form of ~ epeli . Definition 1.6 of [Schloeder] p. 1. (Contributed by Scott Fenton, 27-Mar-2011.) (Revised by Mario Carneiro, 28-Apr-2015.) (Proof shortened by BJ, 14-Jul-2023.)
theorem epelg (A2 B2 V: class):
  $ wi (wcel B2 V) (wb (wbr A2 B2 cep) (wcel A2 B2)) $;

--| The membership relation and the membership predicate agree when the "containing" class is a set. Inference associated with ~ epelg . (Contributed by Scott Fenton, 11-Apr-2012.)
theorem epeli (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wb (wbr A2 B2 cep) (wcel A2 B2) $;

--| The membership relation and the membership predicate agree when the "containing" class is a setvar. Definition 1.6 of [Schloeder] p. 1. (Contributed by NM, 13-Aug-1995.) Replace the first setvar variable with a class variable. (Revised by BJ, 13-Sep-2022.)
theorem epel {x3: setvar} (A2: class x3):
  $ wb (wbr A2 (cv x3) cep) (wcel A2 (cv x3)) $;

--| An example for the membership relation. (Contributed by AV, 19-Jun-2022.)
theorem _0sn0ep:
  $ wbr c0 (csn c0) cep $;

--| The membership relation is nonempty. (Contributed by AV, 19-Jun-2022.)
theorem epn0:
  $ wne cep c0 $;

--| Extend wff notation to include the strict partial ordering predicate. Read: " ` R ` is a partial order on ` A ` ".
term wpo (A2 R: class): wff;

--| Extend wff notation to include the strict total ordering predicate. Read: " ` R ` orders ` A ` ".
term wor (A2 R: class): wff;

--| Define the strict partial order predicate. Definition of [Enderton] p. 168. The expression ` R Po A ` means ` R ` is a partial order on ` A ` . For example, ` < Po RR ` is true, while ` <_ Po RR ` is false ( ~ ex-po ). (Contributed by NM, 16-Mar-1997.)
axiom df_po {x3 y1 z: setvar} (A2 R: class):
  $ wb (wpo A2 R) (wral x3 (wral y1 (wral z (wa (wn (wbr (cv x3) (cv x3) R)) (wi (wa (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv z) R)) (wbr (cv x3) (cv z) R))) A2) A2) A2) $;

--| Define the strict complete (linear) order predicate. The expression ` R Or A ` is true if relationship ` R ` orders ` A ` . For example, ` < Or RR ` is true ( ~ ltso ). Equivalent to Definition 6.19(1) of [TakeutiZaring] p. 29. (Contributed by NM, 21-Jan-1996.)
axiom df_so {x3 y1: setvar} (A2 R: class):
  $ wb (wor A2 R) (wa (wpo A2 R) (wral x3 (wral y1 (w3o (wbr (cv x3) (cv y1) R) (wceq (cv x3) (cv y1)) (wbr (cv y1) (cv x3) R)) A2) A2)) $;

--| Subset theorem for the partial ordering predicate. (Contributed by NM, 27-Mar-1997.) (Proof shortened by Mario Carneiro, 18-Nov-2016.)
theorem poss (A2 B2 R: class):
  $ wi (wss A2 B2) (wi (wpo B2 R) (wpo A2 R)) $;

--| Equality theorem for partial ordering predicate. (Contributed by NM, 27-Mar-1997.)
theorem poeq1 (A2 R S: class):
  $ wi (wceq R S) (wb (wpo A2 R) (wpo A2 S)) $;

--| Equality theorem for partial ordering predicate. (Contributed by NM, 27-Mar-1997.)
theorem poeq2 (A2 B2 R: class):
  $ wi (wceq A2 B2) (wb (wpo A2 R) (wpo B2 R)) $;

--| Equality deduction for partial orderings. (Contributed by Matthew House, 10-Sep-2025.)
theorem poeq12d (ph: wff) (A2 B2 R S: class):
  $ wi ph (wceq R S) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wpo A2 R) (wpo B2 S)) $;

--| Bound-variable hypothesis builder for partial orders. (Contributed by Stefan O'Rear, 20-Jan-2015.)
theorem nfpo {x3: setvar} (A2 R: class x3):
  $ wnfc x3 R $ >
  $ wnfc x3 A2 $ >
  $ wnf x3 (wpo A2 R) $;

--| Bound-variable hypothesis builder for total orders. (Contributed by Stefan O'Rear, 20-Jan-2015.)
theorem nfso {x3: setvar} (A2 R: class x3):
  $ wnfc x3 R $ >
  $ wnfc x3 A2 $ >
  $ wnf x3 (wor A2 R) $;

--| Characteristic properties of a partial order in class notation. (Contributed by NM, 27-Mar-1997.) Reduce axiom usage and shorten proof. (Revised by GG, 3-Oct-2024.)
theorem pocl (A2 B2 C D R: class):
  $ wi (wpo A2 R) (wi (w3a (wcel B2 A2) (wcel C A2) (wcel D A2)) (wa (wn (wbr B2 B2 R)) (wi (wa (wbr B2 C R) (wbr C D R)) (wbr B2 D R)))) $;

--| Sufficient conditions for a partial order. (Contributed by NM, 9-Jul-2014.)
theorem ispod {x3 y1 z: setvar} (ph: wff) (A2 R: class):
  $ wi (wa ph (wcel (cv x3) A2)) (wn (wbr (cv x3) (cv x3) R)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) A2) (wcel (cv y1) A2) (wcel (cv z) A2))) (wi (wa (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv z) R)) (wbr (cv x3) (cv z) R)) $ >
  $ wi ph (wpo A2 R) $;

--| Perform the substitutions into the strict weak ordering law. (Contributed by Mario Carneiro, 31-Dec-2014.)
theorem swopolem {x3 y1 z: setvar} (ph: wff) (A2 R X: class) (Y: class x3) (Z: class x3 y1):
  $ wi (wa ph (w3a (wcel (cv x3) A2) (wcel (cv y1) A2) (wcel (cv z) A2))) (wi (wbr (cv x3) (cv y1) R) (wo (wbr (cv x3) (cv z) R) (wbr (cv z) (cv y1) R))) $ >
  $ wi (wa ph (w3a (wcel X A2) (wcel Y A2) (wcel Z A2))) (wi (wbr X Y R) (wo (wbr X Z R) (wbr Z Y R))) $;

--| A strict weak order is a partial order. (Contributed by Mario Carneiro, 9-Jul-2014.)
theorem swopo {x3 y1 z: setvar} (ph: wff) (A2 R: class):
  $ wi (wa ph (wa (wcel (cv y1) A2) (wcel (cv z) A2))) (wi (wbr (cv y1) (cv z) R) (wn (wbr (cv z) (cv y1) R))) $ >
  $ wi (wa ph (w3a (wcel (cv x3) A2) (wcel (cv y1) A2) (wcel (cv z) A2))) (wi (wbr (cv x3) (cv y1) R) (wo (wbr (cv x3) (cv z) R) (wbr (cv z) (cv y1) R))) $ >
  $ wi ph (wpo A2 R) $;

--| A partial order is irreflexive. (Contributed by NM, 27-Mar-1997.)
theorem poirr (A2 B2 R: class):
  $ wi (wa (wpo A2 R) (wcel B2 A2)) (wn (wbr B2 B2 R)) $;

--| A partial order is a transitive relation. (Contributed by NM, 27-Mar-1997.)
theorem potr (A2 B2 C D R: class):
  $ wi (wa (wpo A2 R) (w3a (wcel B2 A2) (wcel C A2) (wcel D A2))) (wi (wa (wbr B2 C R) (wbr C D R)) (wbr B2 D R)) $;

--| A partial order has no 2-cycle loops. (Contributed by NM, 27-Mar-1997.)
theorem po2nr (A2 B2 C R: class):
  $ wi (wa (wpo A2 R) (wa (wcel B2 A2) (wcel C A2))) (wn (wa (wbr B2 C R) (wbr C B2 R))) $;

--| A partial order has no 3-cycle loops. (Contributed by NM, 27-Mar-1997.)
theorem po3nr (A2 B2 C D R: class):
  $ wi (wa (wpo A2 R) (w3a (wcel B2 A2) (wcel C A2) (wcel D A2))) (wn (w3a (wbr B2 C R) (wbr C D R) (wbr D B2 R))) $;

--| Two sets related by a partial order are not equal. (Contributed by AV, 13-Mar-2023.)
theorem po2ne (A2 B2 R V: class):
  $ wi (w3a (wpo V R) (wa (wcel A2 V) (wcel B2 V)) (wbr A2 B2 R)) (wne A2 B2) $;

--| Any relation is a partial order on the empty set. (Contributed by NM, 28-Mar-1997.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem po0 (R: class):
  $ wpo c0 R $;

--| The inverse image of a partial order is a partial order. (Contributed by Jeff Madsen, 18-Jun-2011.)
theorem pofun {x3 y1: setvar} (A2 B2: class y1) (R: class) (S: class x3 y1) (X: class x3) (Y: class y1):
  $ wceq S (copab x3 y1 (wbr X Y R)) $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq X Y) $ >
  $ wi (wa (wpo B2 R) (wral x3 (wcel X B2) A2)) (wpo A2 S) $;

--| A strict linear order is a strict partial order. (Contributed by NM, 28-Mar-1997.)
theorem sopo (A2 R: class):
  $ wi (wor A2 R) (wpo A2 R) $;

--| Subset theorem for the strict ordering predicate. (Contributed by NM, 16-Mar-1997.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem soss (A2 B2 R: class):
  $ wi (wss A2 B2) (wi (wor B2 R) (wor A2 R)) $;

--| Equality theorem for the strict ordering predicate. (Contributed by NM, 16-Mar-1997.)
theorem soeq1 (A2 R S: class):
  $ wi (wceq R S) (wb (wor A2 R) (wor A2 S)) $;

--| Equality theorem for the strict ordering predicate. (Contributed by NM, 16-Mar-1997.)
theorem soeq2 (A2 B2 R: class):
  $ wi (wceq A2 B2) (wb (wor A2 R) (wor B2 R)) $;

--| Equality deduction for total orderings. (Contributed by Stefan O'Rear, 19-Jan-2015.) (Proof shortened by Matthew House, 10-Sep-2025.)
theorem soeq12d (ph: wff) (A2 B2 R S: class):
  $ wi ph (wceq R S) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wor A2 R) (wor B2 S)) $;

--| A strict order relation is irreflexive. (Contributed by NM, 24-Nov-1995.)
theorem sonr (A2 B2 R: class):
  $ wi (wa (wor A2 R) (wcel B2 A2)) (wn (wbr B2 B2 R)) $;

--| A strict order relation is a transitive relation. (Contributed by NM, 21-Jan-1996.)
theorem sotr (A2 B2 C D R: class):
  $ wi (wa (wor A2 R) (w3a (wcel B2 A2) (wcel C A2) (wcel D A2))) (wi (wa (wbr B2 C R) (wbr C D R)) (wbr B2 D R)) $;

--| Transitivity law for strict orderings, deduction form. (Contributed by Scott Fenton, 24-Nov-2021.)
theorem sotrd (ph: wff) (A2 R X Y Z: class):
  $ wi ph (wor A2 R) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y A2) $ >
  $ wi ph (wcel Z A2) $ >
  $ wi ph (wbr X Y R) $ >
  $ wi ph (wbr Y Z R) $ >
  $ wi ph (wbr X Z R) $;

--| A strict order relation is linear (satisfies trichotomy). (Contributed by NM, 21-Jan-1996.)
theorem solin (A2 B2 C R: class):
  $ wi (wa (wor A2 R) (wa (wcel B2 A2) (wcel C A2))) (w3o (wbr B2 C R) (wceq B2 C) (wbr C B2 R)) $;

--| A strict order relation has no 2-cycle loops. (Contributed by NM, 21-Jan-1996.)
theorem so2nr (A2 B2 C R: class):
  $ wi (wa (wor A2 R) (wa (wcel B2 A2) (wcel C A2))) (wn (wa (wbr B2 C R) (wbr C B2 R))) $;

--| A strict order relation has no 3-cycle loops. (Contributed by NM, 21-Jan-1996.)
theorem so3nr (A2 B2 C D R: class):
  $ wi (wa (wor A2 R) (w3a (wcel B2 A2) (wcel C A2) (wcel D A2))) (wn (w3a (wbr B2 C R) (wbr C D R) (wbr D B2 R))) $;

--| A strict order relation satisfies strict trichotomy. (Contributed by NM, 19-Feb-1996.)
theorem sotric (A2 B2 C R: class):
  $ wi (wa (wor A2 R) (wa (wcel B2 A2) (wcel C A2))) (wb (wbr B2 C R) (wn (wo (wceq B2 C) (wbr C B2 R)))) $;

--| Trichotomy law for strict order relation. (Contributed by NM, 9-Apr-1996.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem sotrieq (A2 B2 C R: class):
  $ wi (wa (wor A2 R) (wa (wcel B2 A2) (wcel C A2))) (wb (wceq B2 C) (wn (wo (wbr B2 C R) (wbr C B2 R)))) $;

--| Trichotomy law for strict order relation. (Contributed by NM, 5-May-1999.)
theorem sotrieq2 (A2 B2 C R: class):
  $ wi (wa (wor A2 R) (wa (wcel B2 A2) (wcel C A2))) (wb (wceq B2 C) (wa (wn (wbr B2 C R)) (wn (wbr C B2 R)))) $;

--| Asymmetry law for strict orderings. (Contributed by Scott Fenton, 24-Nov-2021.)
theorem soasym (A2 R X Y: class):
  $ wi (wa (wor A2 R) (wa (wcel X A2) (wcel Y A2))) (wi (wbr X Y R) (wn (wbr Y X R))) $;

--| A transitivity relation. (Read ` B <_ C ` and ` C < D ` implies ` B < D ` .) (Contributed by Mario Carneiro, 10-May-2013.)
theorem sotr2 (A2 B2 C D R: class):
  $ wi (wa (wor A2 R) (w3a (wcel B2 A2) (wcel C A2) (wcel D A2))) (wi (wa (wn (wbr C B2 R)) (wbr C D R)) (wbr B2 D R)) $;

--| An irreflexive, transitive, linear relation is a strict ordering. (Contributed by NM, 21-Jan-1996.) (Revised by Mario Carneiro, 9-Jul-2014.)
theorem issod {x3 y1: setvar} (ph: wff) (A2 R: class):
  $ wi ph (wpo A2 R) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) A2))) (w3o (wbr (cv x3) (cv y1) R) (wceq (cv x3) (cv y1)) (wbr (cv y1) (cv x3) R)) $ >
  $ wi ph (wor A2 R) $;

--| An irreflexive, transitive, linear relation is a strict ordering. (Contributed by NM, 21-Jan-1996.) (Revised by Mario Carneiro, 9-Jul-2014.)
theorem issoi {x3 y1 z: setvar} (A2 R: class):
  $ wi (wcel (cv x3) A2) (wn (wbr (cv x3) (cv x3) R)) $ >
  $ wi (w3a (wcel (cv x3) A2) (wcel (cv y1) A2) (wcel (cv z) A2)) (wi (wa (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv z) R)) (wbr (cv x3) (cv z) R)) $ >
  $ wi (wa (wcel (cv x3) A2) (wcel (cv y1) A2)) (w3o (wbr (cv x3) (cv y1) R) (wceq (cv x3) (cv y1)) (wbr (cv y1) (cv x3) R)) $ >
  $ wor A2 R $;

--| Deduce strict ordering from its properties. (Contributed by NM, 29-Jan-1996.) (Revised by Mario Carneiro, 9-Jul-2014.)
theorem isso2i {x3 y1 z: setvar} (A2 R: class):
  $ wi (wa (wcel (cv x3) A2) (wcel (cv y1) A2)) (wb (wbr (cv x3) (cv y1) R) (wn (wo (wceq (cv x3) (cv y1)) (wbr (cv y1) (cv x3) R)))) $ >
  $ wi (w3a (wcel (cv x3) A2) (wcel (cv y1) A2) (wcel (cv z) A2)) (wi (wa (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv z) R)) (wbr (cv x3) (cv z) R)) $ >
  $ wor A2 R $;

--| Any relation is a strict ordering of the empty set. (Contributed by NM, 16-Mar-1997.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem so0 (R: class):
  $ wor c0 R $;

--| A totally ordered set has at most one minimal element. (Contributed by Mario Carneiro, 24-Jun-2015.) (Revised by NM, 16-Jun-2017.)
theorem somo {x3 y1: setvar} (A2 R: class):
  $ wi (wor A2 R) (wrmo x3 (wral y1 (wn (wbr (cv y1) (cv x3) R)) A2) A2) $;

--| Trichotomy law for strict orderings. (Contributed by Scott Fenton, 8-Dec-2021.)
theorem sotrine (A2 B2 C R: class):
  $ wi (wa (wor A2 R) (wa (wcel B2 A2) (wcel C A2))) (wb (wne B2 C) (wo (wbr B2 C R) (wbr C B2 R))) $;

--| Transitivity law for strict orderings. (Contributed by Scott Fenton, 24-Nov-2021.)
theorem sotr3 (A2 R X Y Z: class):
  $ wi (wa (wor A2 R) (w3a (wcel X A2) (wcel Y A2) (wcel Z A2))) (wi (wa (wbr X Y R) (wn (wbr Z Y R))) (wbr X Z R)) $;

--| Extend wff notation to include the well-founded predicate. Read: " ` R ` is a well-founded relation on ` A ` ".
term wfr (A2 R: class): wff;

--| Extend wff notation to include the set-like predicate. Read: " ` R ` is set-like on ` A ` ".
term wse (A2 R: class): wff;

--| Extend wff notation to include the well-ordering predicate. Read: " ` R ` well-orders ` A ` ".
term wwe (A2 R: class): wff;

--| Define the well-founded relation predicate. Definition 6.24(1) of [TakeutiZaring] p. 30. For alternate definitions, see ~ dffr2 and ~ dffr3 . A class is called well-founded when the membership relation ` _E ` (see ~ df-eprel ) is well-founded on it, that is, ` A ` is well-founded if ` _E Fr A ` (some sources request that the membership relation be well-founded on its transitive closure). (Contributed by NM, 3-Apr-1994.)
axiom df_fr {x3 y1 z: setvar} (A2 R: class):
  $ wb (wfr A2 R) (wal x3 (wi (wa (wss (cv x3) A2) (wne (cv x3) c0)) (wrex y1 (wral z (wn (wbr (cv z) (cv y1) R)) (cv x3)) (cv x3)))) $;

--| Define the set-like predicate. (Contributed by Mario Carneiro, 19-Nov-2014.)
axiom df_se {x3 y1: setvar} (A2 R: class):
  $ wb (wse A2 R) (wral x3 (wcel (crab y1 (wbr (cv y1) (cv x3) R) A2) cvv) A2) $;

--| Define the well-ordering predicate. For an alternate definition, see ~ dfwe2 . (Contributed by NM, 3-Apr-1994.)
axiom df_we (A2 R: class):
  $ wb (wwe A2 R) (wa (wfr A2 R) (wor A2 R)) $;

--| Alternate definition of ~ df-fr . See ~ dffr5 for a definition without dummy variables (but note that their equivalence uses ~ ax-sep ). (Contributed by BJ, 16-Nov-2024.)
theorem dffr6 {x3 y1 z: setvar} (A2 R: class):
  $ wb (wfr A2 R) (wral x3 (wrex y1 (wral z (wn (wbr (cv z) (cv y1) R)) (cv x3)) (cv x3)) (cdif (cpw A2) (csn c0))) $;

--| A nonempty subset of an ` R ` -well-founded class has an ` R ` -minimal element (deduction form). (Contributed by BJ, 16-Nov-2024.)
theorem frd {x3 y1: setvar} (ph: wff) (A2 B2 R: class) (V: class x3 y1):
  $ wi ph (wfr A2 R) $ >
  $ wi ph (wss B2 A2) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wne B2 c0) $ >
  $ wi ph (wrex x3 (wral y1 (wn (wbr (cv y1) (cv x3) R)) B2) B2) $;

--| A nonempty subset of an ` R ` -well-founded class has an ` R ` -minimal element (inference form). (Contributed by BJ, 16-Nov-2024.) (Proof shortened by BJ, 19-Nov-2024.)
theorem fri {x3 y1: setvar} (A2 B2 C R: class):
  $ wi (wa (wa (wcel B2 C) (wfr A2 R)) (wa (wss B2 A2) (wne B2 c0))) (wrex x3 (wral y1 (wn (wbr (cv y1) (cv x3) R)) B2) B2) $;

--| The ` R ` -preimage of an element of the base set in a set-like relation is a set. (Contributed by Mario Carneiro, 19-Nov-2014.)
theorem seex {x3: setvar} (A2 B2 R: class):
  $ wi (wa (wse A2 R) (wcel B2 A2)) (wcel (crab x3 (wbr (cv x3) B2 R) A2) cvv) $;

--| Any relation on a set is set-like on it. (Contributed by Mario Carneiro, 22-Jun-2015.)
theorem exse (A2 R V: class):
  $ wi (wcel A2 V) (wse A2 R) $;

--| Alternate definition of well-founded relation. Similar to Definition 6.21 of [TakeutiZaring] p. 30. (Contributed by NM, 17-Feb-2004.) (Proof shortened by Andrew Salmon, 27-Aug-2011.) (Proof shortened by Mario Carneiro, 23-Jun-2015.) Avoid ~ ax-10 , ~ ax-11 , ~ ax-12 , but use ~ ax-8 . (Revised by GG, 3-Oct-2024.)
theorem dffr2 {x3 y1 z: setvar} (A2 R: class):
  $ wb (wfr A2 R) (wal x3 (wi (wa (wss (cv x3) A2) (wne (cv x3) c0)) (wrex y1 (wceq (crab z (wbr (cv z) (cv y1) R) (cv x3)) c0) (cv x3)))) $;

--| Alternate proof of ~ dffr2 , which avoids ~ ax-8 but requires ~ ax-10 , ~ ax-11 , ~ ax-12 . (Contributed by NM, 17-Feb-2004.) (Proof shortened by Andrew Salmon, 27-Aug-2011.) (Proof shortened by Mario Carneiro, 23-Jun-2015.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem dffr2ALT {x3 y1 z: setvar} (A2 R: class):
  $ wb (wfr A2 R) (wal x3 (wi (wa (wss (cv x3) A2) (wne (cv x3) c0)) (wrex y1 (wceq (crab z (wbr (cv z) (cv y1) R) (cv x3)) c0) (cv x3)))) $;

--| Property of well-founded relation (one direction of definition using class variables). (Contributed by NM, 17-Feb-2004.) (Revised by Mario Carneiro, 19-Nov-2014.)
theorem frc {x3 y1: setvar} (A2 B2 R: class):
  $ wcel B2 cvv $ >
  $ wi (w3a (wfr A2 R) (wss B2 A2) (wne B2 c0)) (wrex x3 (wceq (crab y1 (wbr (cv y1) (cv x3) R) B2) c0) B2) $;

--| Subset theorem for the well-founded predicate. Exercise 1 of [TakeutiZaring] p. 31. (Contributed by NM, 3-Apr-1994.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem frss (A2 B2 R: class):
  $ wi (wss A2 B2) (wi (wfr B2 R) (wfr A2 R)) $;

--| Subset theorem for the set-like predicate. (Contributed by Mario Carneiro, 24-Jun-2015.)
theorem sess1 (A2 R S: class):
  $ wi (wss R S) (wi (wse A2 S) (wse A2 R)) $;

--| Subset theorem for the set-like predicate. (Contributed by Mario Carneiro, 24-Jun-2015.)
theorem sess2 (A2 B2 R: class):
  $ wi (wss A2 B2) (wi (wse B2 R) (wse A2 R)) $;

--| Equality theorem for the well-founded predicate. (Contributed by NM, 9-Mar-1997.)
theorem freq1 (A2 R S: class):
  $ wi (wceq R S) (wb (wfr A2 R) (wfr A2 S)) $;

--| Equality theorem for the well-founded predicate. (Contributed by NM, 3-Apr-1994.)
theorem freq2 (A2 B2 R: class):
  $ wi (wceq A2 B2) (wb (wfr A2 R) (wfr B2 R)) $;

--| Equality deduction for well-founded relations. (Contributed by Stefan O'Rear, 19-Jan-2015.) (Proof shortened by Matthew House, 10-Sep-2025.)
theorem freq12d (ph: wff) (A2 B2 R S: class):
  $ wi ph (wceq R S) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wfr A2 R) (wfr B2 S)) $;

--| Equality theorem for the set-like predicate. (Contributed by Mario Carneiro, 24-Jun-2015.)
theorem seeq1 (A2 R S: class):
  $ wi (wceq R S) (wb (wse A2 R) (wse A2 S)) $;

--| Equality theorem for the set-like predicate. (Contributed by Mario Carneiro, 24-Jun-2015.)
theorem seeq2 (A2 B2 R: class):
  $ wi (wceq A2 B2) (wb (wse A2 R) (wse B2 R)) $;

--| Equality deduction for the set-like predicate. (Contributed by Matthew House, 10-Sep-2025.)
theorem seeq12d (ph: wff) (A2 B2 R S: class):
  $ wi ph (wceq R S) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wse A2 R) (wse B2 S)) $;

--| Bound-variable hypothesis builder for well-founded relations. (Contributed by Stefan O'Rear, 20-Jan-2015.) (Revised by Mario Carneiro, 14-Oct-2016.)
theorem nffr {x3: setvar} (A2 R: class x3):
  $ wnfc x3 R $ >
  $ wnfc x3 A2 $ >
  $ wnf x3 (wfr A2 R) $;

--| Bound-variable hypothesis builder for set-like relations. (Contributed by Mario Carneiro, 24-Jun-2015.) (Revised by Mario Carneiro, 14-Oct-2016.)
theorem nfse {x3: setvar} (A2 R: class x3):
  $ wnfc x3 R $ >
  $ wnfc x3 A2 $ >
  $ wnf x3 (wse A2 R) $;

--| Bound-variable hypothesis builder for well-orderings. (Contributed by Stefan O'Rear, 20-Jan-2015.) (Revised by Mario Carneiro, 14-Oct-2016.)
theorem nfwe {x3: setvar} (A2 R: class x3):
  $ wnfc x3 R $ >
  $ wnfc x3 A2 $ >
  $ wnf x3 (wwe A2 R) $;

--| A well-founded relation is irreflexive. Special case of Proposition 6.23 of [TakeutiZaring] p. 30. (Contributed by NM, 2-Jan-1994.) (Revised by Mario Carneiro, 22-Jun-2015.)
theorem frirr (A2 B2 R: class):
  $ wi (wa (wfr A2 R) (wcel B2 A2)) (wn (wbr B2 B2 R)) $;

--| A well-founded relation has no 2-cycle loops. Special case of Proposition 6.23 of [TakeutiZaring] p. 30. (Contributed by NM, 30-May-1994.) (Revised by Mario Carneiro, 22-Jun-2015.)
theorem fr2nr (A2 B2 C R: class):
  $ wi (wa (wfr A2 R) (wa (wcel B2 A2) (wcel C A2))) (wn (wa (wbr B2 C R) (wbr C B2 R))) $;

--| Any relation is well-founded on the empty set. (Contributed by NM, 17-Sep-1993.)
theorem fr0 (R: class):
  $ wfr c0 R $;

--| If an element of a well-founded set satisfies a property ` ph ` , then there is a minimal element that satisfies ` ph ` . (Contributed by Jeff Madsen, 18-Jun-2010.) (Proof shortened by Mario Carneiro, 18-Nov-2016.)
theorem frminex {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2 R: class):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wfr A2 R) (wi (wrex x3 ph A2) (wrex x3 (wa ph (wral y1 (wi ps (wn (wbr (cv y1) (cv x3) R))) A2)) A2)) $;

--| A well-founded class does not belong to itself. (Contributed by NM, 18-Apr-1994.) (Revised by Mario Carneiro, 22-Jun-2015.)
theorem efrirr (A2: class):
  $ wi (wfr A2 cep) (wn (wcel A2 A2)) $;

--| A well-founded class contains no 2-cycle loops. (Contributed by NM, 19-Apr-1994.)
theorem efrn2lp (A2 B2 C: class):
  $ wi (wa (wfr A2 cep) (wa (wcel B2 A2) (wcel C A2))) (wn (wa (wcel B2 C) (wcel C B2))) $;

--| The membership relation is set-like on any class. (This is the origin of the term "set-like": a set-like relation "acts like" the membership relation of sets and their elements.) (Contributed by Mario Carneiro, 22-Jun-2015.)
theorem epse (A2: class):
  $ wse A2 cep $;

--| Similar to Theorem 7.2 of [TakeutiZaring] p. 35, except that the Axiom of Regularity is not required due to the antecedent ` _E Fr A ` . (Contributed by NM, 4-May-1994.)
theorem tz7_2 (A2 B2: class):
  $ wi (w3a (wtr A2) (wfr A2 cep) (wcel B2 A2)) (wa (wss B2 A2) (wne B2 A2)) $;

--| An alternate way of saying that the membership relation is well-founded. (Contributed by NM, 17-Feb-2004.) (Revised by Mario Carneiro, 23-Jun-2015.)
theorem dfepfr {x3 y1: setvar} (A2: class):
  $ wb (wfr A2 cep) (wal x3 (wi (wa (wss (cv x3) A2) (wne (cv x3) c0)) (wrex y1 (wceq (cin (cv x3) (cv y1)) c0) (cv x3)))) $;

--| A subset of a well-founded class has a minimal element. (Contributed by NM, 17-Feb-2004.) (Revised by David Abernethy, 22-Feb-2011.)
theorem epfrc {x3: setvar} (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wi (w3a (wfr A2 cep) (wss B2 A2) (wne B2 c0)) (wrex x3 (wceq (cin B2 (cv x3)) c0) B2) $;

--| Subset theorem for the well-ordering predicate. Exercise 4 of [TakeutiZaring] p. 31. (Contributed by NM, 19-Apr-1994.)
theorem wess (A2 B2 R: class):
  $ wi (wss A2 B2) (wi (wwe B2 R) (wwe A2 R)) $;

--| Equality theorem for the well-ordering predicate. (Contributed by NM, 9-Mar-1997.)
theorem weeq1 (A2 R S: class):
  $ wi (wceq R S) (wb (wwe A2 R) (wwe A2 S)) $;

--| Equality theorem for the well-ordering predicate. (Contributed by NM, 3-Apr-1994.)
theorem weeq2 (A2 B2 R: class):
  $ wi (wceq A2 B2) (wb (wwe A2 R) (wwe B2 R)) $;

--| Equality deduction for well-orderings. (Contributed by Stefan O'Rear, 19-Jan-2015.) (Proof shortened by Matthew House, 10-Sep-2025.)
theorem weeq12d (ph: wff) (A2 B2 R S: class):
  $ wi ph (wceq R S) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wwe A2 R) (wwe B2 S)) $;

--| A well-ordering is well-founded. (Contributed by NM, 22-Apr-1994.)
theorem wefr (A2 R: class):
  $ wi (wwe A2 R) (wfr A2 R) $;

--| A well-ordering is a strict ordering. (Contributed by NM, 16-Mar-1997.)
theorem weso (A2 R: class):
  $ wi (wwe A2 R) (wor A2 R) $;

--| The elements of a class well-ordered by membership are comparable. (Contributed by NM, 17-May-1994.)
theorem wecmpep {x3 y1: setvar} (A2: class x3 y1):
  $ wi (wa (wwe A2 cep) (wa (wcel (cv x3) A2) (wcel (cv y1) A2))) (w3o (wcel (cv x3) (cv y1)) (wceq (cv x3) (cv y1)) (wcel (cv y1) (cv x3))) $;

--| On a class well-ordered by membership, the membership predicate is transitive. (Contributed by NM, 22-Apr-1994.)
theorem wetrep {y1 z: setvar} (x3: setvar) (A2: class y1 z):
  $ wi (wa (wwe A2 cep) (w3a (wcel (cv x3) A2) (wcel (cv y1) A2) (wcel (cv z) A2))) (wi (wa (wcel (cv x3) (cv y1)) (wcel (cv y1) (cv z))) (wcel (cv x3) (cv z))) $;

--| A nonempty subclass of a class well-ordered by membership has a minimal element. Special case of Proposition 6.26 of [TakeutiZaring] p. 31. (Contributed by NM, 17-Feb-2004.)
theorem wefrc {x3: setvar} (A2: class x3) (B2: class):
  $ wi (w3a (wwe A2 cep) (wss B2 A2) (wne B2 c0)) (wrex x3 (wceq (cin B2 (cv x3)) c0) B2) $;

--| Any relation is a well-ordering of the empty set. (Contributed by NM, 16-Mar-1997.)
theorem we0 (R: class):
  $ wwe c0 R $;

--| A nonempty subset of an ` R ` -well-ordered class has a unique ` R ` -minimal element. (Contributed by NM, 18-Mar-1997.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem wereu {x3 y1: setvar} (A2 B2 R V: class):
  $ wi (wa (wwe A2 R) (w3a (wcel B2 V) (wss B2 A2) (wne B2 c0))) (wreu x3 (wral y1 (wn (wbr (cv y1) (cv x3) R)) B2) B2) $;

--| A nonempty subclass of an ` R ` -well-ordered and ` R ` -setlike class has a unique ` R ` -minimal element. Proposition 6.26 of [TakeutiZaring] p. 31. (Contributed by Scott Fenton, 29-Jan-2011.) (Revised by Mario Carneiro, 24-Jun-2015.)
theorem wereu2 {x3 y1: setvar} (A2 B2 R: class):
  $ wi (wa (wa (wwe A2 R) (wse A2 R)) (wa (wss B2 A2) (wne B2 c0))) (wreu x3 (wral y1 (wn (wbr (cv y1) (cv x3) R)) B2) B2) $;

--| Extend the definition of a class to include the Cartesian product.
term cxp (A2 B2: class): class;

--| Extend the definition of a class to include the converse of a class.
term ccnv (A2: class): class;

--| Extend the definition of a class to include the domain of a class.
term cdm (A2: class): class;

--| Extend the definition of a class to include the range of a class.
term crn (A2: class): class;

--| Extend the definition of a class to include the restriction of a class. Read: "the restriction of ` A ` to ` B ` ".
term cres (A2 B2: class): class;

--| Extend the definition of a class to include the image of a class. Read: "the image of ` B ` under ` A ` ".
term cima (A2 B2: class): class;

--| Extend the definition of a class to include the composition of two classes. (Read: The composition of ` A ` and ` B ` .)
term ccom (A2 B2: class): class;

--| Extend the definition of a wff to include the relation predicate. Read: " ` A ` is a relation".
term wrel (A2: class): wff;

--| Define the Cartesian product of two classes. This is also sometimes called the "cross product" but that term also has other meanings; we intentionally choose a less ambiguous term. Definition 9.11 of [Quine] p. 64. For example, ` ( { 1 , 5 } X. { 2 , 7 } ) = ` ` ( { <. 1 , 2 >. , <. 1 , 7 >. } u. { <. 5 , 2 >. , <. 5 , 7 >. } ) ` ( ~ ex-xp ). Another example is that the set of rational numbers is defined in ~ df-q using the Cartesian product ` ( ZZ X. NN ) ` ; the left- and right-hand sides of the Cartesian product represent the top (integer) and bottom (natural) numbers of a fraction. (Contributed by NM, 4-Jul-1994.)
axiom df_xp {x3 y1: setvar} (A2 B2: class):
  $ wceq (cxp A2 B2) (copab x3 y1 (wa (wcel (cv x3) A2) (wcel (cv y1) B2))) $;

--| Define the relation predicate. Definition 6.4(1) of [TakeutiZaring] p. 23. For alternate definitions, see ~ dfrel2 and ~ dfrel3 . (Contributed by NM, 1-Aug-1994.)
axiom df_rel (A2: class):
  $ wb (wrel A2) (wss A2 (cxp cvv cvv)) $;

--| Define the converse of a class. Definition 9.12 of [Quine] p. 64. The converse of a binary relation swaps its arguments, i.e., if ` A e. _V ` and ` B e. _V ` then ` ( A ``' R B <-> B R A ) ` , as proven in ~ brcnv (see ~ df-br and ~ df-rel for more on relations). For example, ` ``' { <. 2 , 6 >. , <. 3 , 9 >. } = { <. 6 , 2 >. , <. 9 , 3 >. } ` ( ~ ex-cnv ). We use Quine's breve accent (smile) notation. Like Quine, we use it as a prefix, which eliminates the need for parentheses. "Converse" is Quine's terminology. Some authors use a "minus one" exponent and call it "inverse", especially when the argument is a function, although this is not in general a genuine inverse. (Contributed by NM, 4-Jul-1994.)
axiom df_cnv {x3 y1: setvar} (A2: class):
  $ wceq (ccnv A2) (copab x3 y1 (wbr (cv y1) (cv x3) A2)) $;

--| Define the composition of two classes. Definition 6.6(3) of [TakeutiZaring] p. 24. For example, ` ( ( exp o. cos ) `` 0 ) = _e ` ( ~ ex-co ) because ` ( cos `` 0 ) = 1 ` (see ~ cos0 ) and ` ( exp `` 1 ) = _e ` (see ~ df-e ). Note that Definition 7 of [Suppes] p. 63 reverses ` A ` and ` B ` , uses ` /. ` instead of ` o. ` , and calls the operation "relative product". (Contributed by NM, 4-Jul-1994.)
axiom df_co {x3 y1 z: setvar} (A2 B2: class):
  $ wceq (ccom A2 B2) (copab x3 y1 (wex z (wa (wbr (cv x3) (cv z) B2) (wbr (cv z) (cv y1) A2)))) $;

--| Define the domain of a class. Definition 3 of [Suppes] p. 59. For example, ` F = { <. 2 , 6 >. , <. 3 , 9 >. } -> dom F = { 2 , 3 } ` ( ~ ex-dm ). Another example is the domain of the complex arctangent, ` ( A e. dom arctan <-> ( A e. CC /\ A =/= -u _i /\ A =/= _i ) ) ` (for proof see ~ atandm ). Contrast with range (defined in ~ df-rn ). For alternate definitions see ~ dfdm2 , ~ dfdm3 , and ~ dfdm4 . The notation " ` dom ` " is used by Enderton; other authors sometimes use script D. (Contributed by NM, 1-Aug-1994.)
axiom df_dm {x3 y1: setvar} (A2: class):
  $ wceq (cdm A2) (cab x3 (wex y1 (wbr (cv x3) (cv y1) A2))) $;

--| Define the range of a class. For example, ` F = { <. 2 , 6 >. , <. 3 , 9 >. } -> ran F = { 6 , 9 } ` ( ~ ex-rn ). Contrast with domain (defined in ~ df-dm ). For alternate definitions, see ~ dfrn2 , ~ dfrn3 , and ~ dfrn4 . The notation " ` ran ` " is used by Enderton. The range of a function is often also called "the image of the function" (see definition in [Lang] p. ix), which can be justified by ~ imadmrn . Not to be confused with "codomain" (see ~ df-f ), which may be a superset/superclass of the range (see ~ frn ). (Contributed by NM, 1-Aug-1994.)
axiom df_rn (A2: class):
  $ wceq (crn A2) (cdm (ccnv A2)) $;

--| Define the restriction of a class. Definition 6.6(1) of [TakeutiZaring] p. 24. For example, the expression ` ( exp |`` RR ) ` (used in ~ reeff1 ) means "the exponential function e to the x, but the exponent x must be in the reals" ( ~ df-ef defines the exponential function, which normally allows the exponent to be a complex number). Another example is ` ( F = { <. 2 , 6 >. , <. 3 , 9 >. } /\ B = { 1 , 2 } ) -> ` ` ( F |`` B ) = { <. 2 , 6 >. } ` ( ~ ex-res ). We do not introduce a special syntax for the corestriction of a class: it will be expressed either as the intersection ` ( A i^i ( _V X. B ) ) ` or as the converse of the restricted converse (see ~ cnvrescnv ). (Contributed by NM, 2-Aug-1994.)
axiom df_res (A2 B2: class):
  $ wceq (cres A2 B2) (cin A2 (cxp B2 cvv)) $;

--| Define the image of a class (as restricted by another class). Definition 6.6(2) of [TakeutiZaring] p. 24. For example, ` ( F = { <. 2 , 6 >. , <. 3 , 9 >. } /\ B = { 1 , 2 } ) ` ` -> ( F " B ) = { 6 } ` ( ~ ex-ima ). Contrast with restriction ( ~ df-res ) and range ( ~ df-rn ). For an alternate definition, see ~ dfima2 . (Contributed by NM, 2-Aug-1994.)
axiom df_ima (A2 B2: class):
  $ wceq (cima A2 B2) (crn (cres A2 B2)) $;

--| Equality theorem for Cartesian product. (Contributed by NM, 4-Jul-1994.)
theorem xpeq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cxp A2 C) (cxp B2 C)) $;

--| Subset theorem for Cartesian product. Generalization of Theorem 101 of [Suppes] p. 52. (Contributed by NM, 26-Aug-1995.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem xpss12 (A2 B2 C D: class):
  $ wi (wa (wss A2 B2) (wss C D)) (wss (cxp A2 C) (cxp B2 D)) $;

--| A Cartesian product is included in the ordered pair universe. Exercise 3 of [TakeutiZaring] p. 25. (Contributed by NM, 2-Aug-1994.)
theorem xpss (A2 B2: class):
  $ wss (cxp A2 B2) (cxp cvv cvv) $;

--| Intersection with a Cartesian product is a subclass of restriction. (Contributed by Peter Mazsa, 19-Jul-2019.)
theorem inxpssres (A2 B2 R: class):
  $ wss (cin R (cxp A2 B2)) (cres R A2) $;

--| A Cartesian product is a relation. Theorem 3.13(i) of [Monk1] p. 37. (Contributed by NM, 2-Aug-1994.)
theorem relxp (A2 B2: class):
  $ wrel (cxp A2 B2) $;

--| Subset relation for Cartesian product. (Contributed by Jeff Hankins, 30-Aug-2009.)
theorem xpss1 (A2 B2 C: class):
  $ wi (wss A2 B2) (wss (cxp A2 C) (cxp B2 C)) $;

--| Subset relation for Cartesian product. (Contributed by Jeff Hankins, 30-Aug-2009.)
theorem xpss2 (A2 B2 C: class):
  $ wi (wss A2 B2) (wss (cxp C A2) (cxp C B2)) $;

--| Equality theorem for Cartesian product. (Contributed by NM, 5-Jul-1994.)
theorem xpeq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cxp C A2) (cxp C B2)) $;

--| Membership in a Cartesian product. Uses fewer axioms than ~ elxp . (Contributed by NM, 4-Jul-1994.)
theorem elxpi {x3 y1: setvar} (A2 B2 C: class):
  $ wi (wcel A2 (cxp B2 C)) (wex x3 (wex y1 (wa (wceq A2 (cop (cv x3) (cv y1))) (wa (wcel (cv x3) B2) (wcel (cv y1) C))))) $;

--| Membership in a Cartesian product. (Contributed by NM, 4-Jul-1994.)
theorem elxp {x3 y1: setvar} (A2 B2 C: class):
  $ wb (wcel A2 (cxp B2 C)) (wex x3 (wex y1 (wa (wceq A2 (cop (cv x3) (cv y1))) (wa (wcel (cv x3) B2) (wcel (cv y1) C))))) $;

--| Membership in a Cartesian product. (Contributed by NM, 23-Feb-2004.) (Proof shortened by JJ, 13-Aug-2021.)
theorem elxp2 {x3 y1: setvar} (A2 B2 C: class):
  $ wb (wcel A2 (cxp B2 C)) (wrex x3 (wrex y1 (wceq A2 (cop (cv x3) (cv y1))) C) B2) $;

--| Equality theorem for Cartesian product. (Contributed by FL, 31-Aug-2009.)
theorem xpeq12 (A2 B2 C D: class):
  $ wi (wa (wceq A2 B2) (wceq C D)) (wceq (cxp A2 C) (cxp B2 D)) $;

--| Equality inference for Cartesian product. (Contributed by NM, 21-Dec-2008.)
theorem xpeq1i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cxp A2 C) (cxp B2 C) $;

--| Equality inference for Cartesian product. (Contributed by NM, 21-Dec-2008.)
theorem xpeq2i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cxp C A2) (cxp C B2) $;

--| Equality inference for Cartesian product. (Contributed by FL, 31-Aug-2009.)
theorem xpeq12i (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq C D $ >
  $ wceq (cxp A2 C) (cxp B2 D) $;

--| Equality deduction for Cartesian product. (Contributed by Jeff Madsen, 17-Jun-2010.)
theorem xpeq1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cxp A2 C) (cxp B2 C)) $;

--| Equality deduction for Cartesian product. (Contributed by Jeff Madsen, 17-Jun-2010.)
theorem xpeq2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cxp C A2) (cxp C B2)) $;

--| Equality deduction for Cartesian product. (Contributed by NM, 8-Dec-2013.)
theorem xpeq12d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq (cxp A2 C) (cxp B2 D)) $;

--| Equality deduction for a Cartesian square, see Wikipedia "Cartesian product", ~ https://en.wikipedia.org/wiki/Cartesian_product#n-ary_Cartesian_power . (Contributed by AV, 13-Jan-2020.)
theorem sqxpeqd (ph: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cxp A2 A2) (cxp B2 B2)) $;

--| Bound-variable hypothesis builder for Cartesian product. (Contributed by NM, 15-Sep-2003.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem nfxp {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 (cxp A2 B2) $;

--| The empty set is not a member of a Cartesian product. (Contributed by NM, 2-May-1996.) (Revised by Mario Carneiro, 26-Apr-2015.) (Proof shortened by JJ, 13-Aug-2021.)
theorem _0nelxp (A2 B2: class):
  $ wn (wcel c0 (cxp A2 B2)) $;

--| A member of a Cartesian product (ordered pair) doesn't contain the empty set. (Contributed by NM, 15-Dec-2008.)
theorem _0nelelxp (A2 B2 C: class):
  $ wi (wcel C (cxp A2 B2)) (wn (wcel c0 C)) $;

--| Ordered pair membership in a Cartesian product. (Contributed by NM, 15-Nov-1994.) (Proof shortened by Andrew Salmon, 12-Aug-2011.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem opelxp (A2 B2 C D: class):
  $ wb (wcel (cop A2 B2) (cxp C D)) (wa (wcel A2 C) (wcel B2 D)) $;

--| Ordered pair membership in a Cartesian product (implication). (Contributed by NM, 28-May-1995.)
theorem opelxpi (A2 B2 C D: class):
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wcel (cop A2 B2) (cxp C D)) $;

--| Ordered pair membership in a Cartesian product (implication), induction form. (Contributed by Steven Nguyen, 17-Jul-2022.)
theorem opelxpii (A2 B2 C D: class):
  $ wcel A2 C $ >
  $ wcel B2 D $ >
  $ wcel (cop A2 B2) (cxp C D) $;

--| Ordered pair membership in a Cartesian product, deduction form. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem opelxpd (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 C) $ >
  $ wi ph (wcel B2 D) $ >
  $ wi ph (wcel (cop A2 B2) (cxp C D)) $;

--| Ordered pair membership in the universal class of ordered pairs. (Contributed by NM, 22-Aug-2013.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem opelvv (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel (cop A2 B2) (cxp cvv cvv) $;

--| Ordered pair membership in the universal class of ordered pairs. (Contributed by Mario Carneiro, 3-May-2015.)
theorem opelvvg (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wcel (cop A2 B2) (cxp cvv cvv)) $;

--| The first member of an ordered pair of classes in a Cartesian product belongs to first Cartesian product argument. (Contributed by NM, 28-May-2008.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem opelxp1 (A2 B2 C D: class):
  $ wi (wcel (cop A2 B2) (cxp C D)) (wcel A2 C) $;

--| The second member of an ordered pair of classes in a Cartesian product belongs to second Cartesian product argument. (Contributed by Mario Carneiro, 26-Apr-2015.)
theorem opelxp2 (A2 B2 C D: class):
  $ wi (wcel (cop A2 B2) (cxp C D)) (wcel B2 D) $;

--| Ordered triple membership in a triple Cartesian product. (Contributed by Scott Fenton, 31-Jan-2025.)
theorem otelxp (A2 B2 C D E F: class):
  $ wb (wcel (cotp A2 B2 C) (cxp (cxp D E) F)) (w3a (wcel A2 D) (wcel B2 E) (wcel C F)) $;

--| The first member of an ordered triple of classes in a Cartesian product belongs to first Cartesian product argument. (Contributed by NM, 28-May-2008.)
theorem otelxp1 (A2 B2 C R S T: class):
  $ wi (wcel (cop (cop A2 B2) C) (cxp (cxp R S) T)) (wcel A2 R) $;

--| An ordered triple is an element of a doubled Cartesian product. (Contributed by Alexander van der Vekens, 26-Feb-2018.)
theorem otel3xp (A2 B2 C T X Y Z: class):
  $ wi (wa (wceq T (cotp A2 B2 C)) (w3a (wcel A2 X) (wcel B2 Y) (wcel C Z))) (wcel T (cxp (cxp X Y) Z)) $;

--| An ordered-pair class abstraction is a subset of a Cartesian product. Formerly part of proof for ~ opabex2 . (Contributed by AV, 26-Nov-2021.)
theorem opabssxpd {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (A2 B2: class):
  $ wi (wa ph ps) (wcel (cv x3) A2) $ >
  $ wi (wa ph ps) (wcel (cv y1) B2) $ >
  $ wi ph (wss (copab x3 y1 ps) (cxp A2 B2)) $;

--| Class abstraction restricted to a Cartesian product as an ordered-pair class abstraction. (Contributed by NM, 20-Feb-2014.)
theorem rabxp {x3 y1 z: setvar} (ph: wff x3) (ps: wff y1 z) (A2 B2: class):
  $ wi (wceq (cv x3) (cop (cv y1) (cv z))) (wb ph ps) $ >
  $ wceq (crab x3 ph (cxp A2 B2)) (copab y1 z (w3a (wcel (cv y1) A2) (wcel (cv z) B2) ps)) $;

--| Binary relation on a Cartesian product. (Contributed by NM, 22-Apr-2004.)
theorem brxp (A2 B2 C D: class):
  $ wb (wbr A2 B2 (cxp C D)) (wa (wcel A2 C) (wcel B2 D)) $;

--| A set is a binary relation if and only if it belongs to the powerclass of the cartesian square of the universal class. (Contributed by Peter Mazsa, 14-Jun-2018.) (Revised by BJ, 16-Dec-2023.)
theorem pwvrel (A2 V: class):
  $ wi (wcel A2 V) (wb (wcel A2 (cpw (cxp cvv cvv))) (wrel A2)) $;

--| The powerclass of the cartesian square of the universal class is the class of all sets which are binary relations. (Contributed by BJ, 21-Dec-2023.)
theorem pwvabrel {x3: setvar}:
  $ wceq (cpw (cxp cvv cvv)) (cab x3 (wrel (cv x3))) $;

--| Two classes related by a binary relation are sets. (Contributed by Mario Carneiro, 26-Apr-2015.)
theorem brrelex12 (A2 B2 R: class):
  $ wi (wa (wrel R) (wbr A2 B2 R)) (wa (wcel A2 cvv) (wcel B2 cvv)) $;

--| If two classes are related by a binary relation, then the first class is a set. (Contributed by NM, 18-May-2004.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem brrelex1 (A2 B2 R: class):
  $ wi (wa (wrel R) (wbr A2 B2 R)) (wcel A2 cvv) $;

--| If two classes are related by a binary relation, then the second class is a set. (Contributed by Mario Carneiro, 26-Apr-2015.)
theorem brrelex2 (A2 B2 R: class):
  $ wi (wa (wrel R) (wbr A2 B2 R)) (wcel B2 cvv) $;

--| Two classes that are related by a binary relation are sets. Inference form. (Contributed by BJ, 3-Oct-2022.)
theorem brrelex12i (A2 B2 R: class):
  $ wrel R $ >
  $ wi (wbr A2 B2 R) (wa (wcel A2 cvv) (wcel B2 cvv)) $;

--| The first argument of a binary relation exists. (An artifact of our ordered pair definition.) (Contributed by NM, 4-Jun-1998.)
theorem brrelex1i (A2 B2 R: class):
  $ wrel R $ >
  $ wi (wbr A2 B2 R) (wcel A2 cvv) $;

--| The second argument of a binary relation exists. (An artifact of our ordered pair definition.) (Contributed by Mario Carneiro, 26-Apr-2015.)
theorem brrelex2i (A2 B2 R: class):
  $ wrel R $ >
  $ wi (wbr A2 B2 R) (wcel B2 cvv) $;

--| Proper classes are not related via any relation. (Contributed by AV, 29-Oct-2021.)
theorem nprrel12 (A2 B2 R: class):
  $ wrel R $ >
  $ wi (wn (wa (wcel A2 cvv) (wcel B2 cvv))) (wn (wbr A2 B2 R)) $;

--| No proper class is related to anything via any relation. (Contributed by Roy F. Longton, 30-Jul-2005.)
theorem nprrel (A2 B2 R: class):
  $ wrel R $ >
  $ wn (wcel A2 cvv) $ >
  $ wn (wbr A2 B2 R) $;

--| A binary relation does not contain the empty set. (Contributed by AV, 15-Nov-2021.) (Revised by BJ, 14-Jul-2023.)
theorem _0nelrel0 (R: class):
  $ wi (wrel R) (wn (wcel c0 R)) $;

--| A binary relation does not contain the empty set. (Contributed by AV, 15-Nov-2021.)
theorem _0nelrel (R: class):
  $ wi (wrel R) (wnel c0 R) $;

--| Representation of a constant function using the mapping operation. (Note that ` x ` cannot appear free in ` B ` .) (Contributed by NM, 12-Oct-1999.) (Revised by Mario Carneiro, 16-Nov-2013.)
theorem fconstmpt {x3: setvar} (A2 B2: class):
  $ wceq (cxp A2 (csn B2)) (cmpt x3 A2 B2) $;

--| Variable to class conversion of transitive relation. (Contributed by NM, 9-Jun-1998.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem vtoclr {x3 y1 z: setvar} (A2: class z) (B2: class x3 z) (C R: class):
  $ wrel R $ >
  $ wi (wa (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv z) R)) (wbr (cv x3) (cv z) R) $ >
  $ wi (wa (wbr A2 B2 R) (wbr B2 C R)) (wbr A2 C R) $;

--| Justification theorem for an ordered pair definition that works for any classes, including proper classes. This is a possible definition implied by the footnote in [Jech] p. 78, which says, "The sophisticated reader will not object to our use of a pair of classes." (Contributed by NM, 28-Sep-2003.)
theorem opthprc (A2 B2 C D: class):
  $ wb (wceq (cun (cxp A2 (csn c0)) (cxp B2 (csn (csn c0)))) (cun (cxp C (csn c0)) (cxp D (csn (csn c0))))) (wa (wceq A2 C) (wceq B2 D)) $;

--| Two things in a binary relation belong to the relation's domain. (Contributed by NM, 17-May-1996.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem brel (A2 B2 C D R: class):
  $ wss R (cxp C D) $ >
  $ wi (wbr A2 B2 R) (wa (wcel A2 C) (wcel B2 D)) $;

--| Membership in a Cartesian product. (Contributed by NM, 5-Mar-1995.)
theorem elxp3 {x3 y1: setvar} (A2 B2 C: class):
  $ wb (wcel A2 (cxp B2 C)) (wex x3 (wex y1 (wa (wceq (cop (cv x3) (cv y1)) A2) (wcel (cop (cv x3) (cv y1)) (cxp B2 C))))) $;

--| Membership in a union of Cartesian products. (Contributed by Mario Carneiro, 29-Dec-2014.) (Revised by Mario Carneiro, 1-Jan-2017.)
theorem opeliunxp {x3: setvar} (A2 B2 C: class x3):
  $ wb (wcel (cop (cv x3) C) (ciun x3 A2 (cxp (csn (cv x3)) B2))) (wa (wcel (cv x3) A2) (wcel C B2)) $;

--| Membership of an ordered pair in a union of Cartesian products over its second component, analogous to ~ opeliunxp . (Contributed by AV, 30-Mar-2019.)
theorem opeliun2xp {y1: setvar} (A2 B2 C: class y1):
  $ wb (wcel (cop C (cv y1)) (ciun y1 B2 (cxp A2 (csn (cv y1))))) (wa (wcel (cv y1) B2) (wcel C A2)) $;

--| Distributive law for Cartesian product over union. Theorem 103 of [Suppes] p. 52. (Contributed by NM, 12-Aug-2004.)
theorem xpundi (A2 B2 C: class):
  $ wceq (cxp A2 (cun B2 C)) (cun (cxp A2 B2) (cxp A2 C)) $;

--| Distributive law for Cartesian product over union. Similar to Theorem 103 of [Suppes] p. 52. (Contributed by NM, 30-Sep-2002.)
theorem xpundir (A2 B2 C: class):
  $ wceq (cxp (cun A2 B2) C) (cun (cxp A2 C) (cxp B2 C)) $;

--| Distributive law for Cartesian product over indexed union. (Contributed by Mario Carneiro, 27-Apr-2014.)
theorem xpiundi {x3: setvar} (A2 B2: class x3) (C: class):
  $ wceq (cxp C (ciun x3 A2 B2)) (ciun x3 A2 (cxp C B2)) $;

--| Distributive law for Cartesian product over indexed union. (Contributed by Mario Carneiro, 27-Apr-2014.)
theorem xpiundir {x3: setvar} (A2 B2: class x3) (C: class):
  $ wceq (cxp (ciun x3 A2 B2) C) (ciun x3 A2 (cxp B2 C)) $;

--| Membership in a union of Cartesian products when the second factor is constant. (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem iunxpconst {x3: setvar} (A2 B2: class):
  $ wceq (ciun x3 A2 (cxp (csn (cv x3)) B2)) (cxp A2 B2) $;

--| The Cartesian product of two unions. (Contributed by NM, 12-Aug-2004.)
theorem xpun (A2 B2 C D: class):
  $ wceq (cxp (cun A2 B2) (cun C D)) (cun (cun (cxp A2 C) (cxp A2 D)) (cun (cxp B2 C) (cxp B2 D))) $;

--| Membership in universal class of ordered pairs. (Contributed by NM, 4-Jul-1994.) (Proof shortened by BJ, 16-Oct-2026.)
theorem elvv {x3 y1: setvar} (A2: class):
  $ wb (wcel A2 (cxp cvv cvv)) (wex x3 (wex y1 (wceq A2 (cop (cv x3) (cv y1))))) $;

--| Obsolete version of ~ elvv as of 16-Oct-2026. (Contributed by NM, 4-Jul-1994.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem elvvOLD {x3 y1: setvar} (A2: class):
  $ wb (wcel A2 (cxp cvv cvv)) (wex x3 (wex y1 (wceq A2 (cop (cv x3) (cv y1))))) $;

--| Membership in universal class of ordered triples. (Contributed by NM, 17-Dec-2008.)
theorem elvvv {x3 y1 z: setvar} (A2: class):
  $ wb (wcel A2 (cxp (cxp cvv cvv) cvv)) (wex x3 (wex y1 (wex z (wceq A2 (cop (cop (cv x3) (cv y1)) (cv z)))))) $;

--| An ordered pair contains its union. (Contributed by NM, 16-Sep-2006.)
theorem elvvuni (A2: class):
  $ wi (wcel A2 (cxp cvv cvv)) (wcel (cuni A2) A2) $;

--| Intersection of binary relation with Cartesian product. (Contributed by NM, 3-Mar-2007.) (Revised by Mario Carneiro, 26-Apr-2015.) Group conjuncts and avoid ~ df-3an . (Revised by Peter Mazsa, 18-Sep-2022.)
theorem brinxp2 (A2 B2 C D R: class):
  $ wb (wbr C D (cin R (cxp A2 B2))) (wa (wa (wcel C A2) (wcel D B2)) (wbr C D R)) $;

--| Intersection of binary relation with Cartesian product. (Contributed by NM, 9-Mar-1997.)
theorem brinxp (A2 B2 C D R: class):
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wb (wbr A2 B2 R) (wbr A2 B2 (cin R (cxp C D)))) $;

--| Ordered pair element in an intersection with Cartesian product. (Contributed by Peter Mazsa, 21-Jul-2019.)
theorem opelinxp (A2 B2 C D R: class):
  $ wb (wcel (cop C D) (cin R (cxp A2 B2))) (wa (wa (wcel C A2) (wcel D B2)) (wcel (cop C D) R)) $;

--| Intersection of partial order with Cartesian product of its field. (Contributed by Mario Carneiro, 10-Jul-2014.)
theorem poinxp (A2 R: class):
  $ wb (wpo A2 R) (wpo A2 (cin R (cxp A2 A2))) $;

--| Intersection of total order with Cartesian product of its field. (Contributed by Mario Carneiro, 10-Jul-2014.)
theorem soinxp (A2 R: class):
  $ wb (wor A2 R) (wor A2 (cin R (cxp A2 A2))) $;

--| Intersection of well-founded relation with Cartesian product of its field. (Contributed by Mario Carneiro, 10-Jul-2014.)
theorem frinxp (A2 R: class):
  $ wb (wfr A2 R) (wfr A2 (cin R (cxp A2 A2))) $;

--| Intersection of set-like relation with Cartesian product of its field. (Contributed by Mario Carneiro, 22-Jun-2015.)
theorem seinxp (A2 R: class):
  $ wb (wse A2 R) (wse A2 (cin R (cxp A2 A2))) $;

--| Intersection of well-ordering with Cartesian product of its field. (Contributed by NM, 9-Mar-1997.) (Revised by Mario Carneiro, 10-Jul-2014.)
theorem weinxp (A2 R: class):
  $ wb (wwe A2 R) (wwe A2 (cin R (cxp A2 A2))) $;

--| Partial ordering of a singleton. (Contributed by NM, 27-Apr-2009.) (Revised by Mario Carneiro, 23-Apr-2015.)
theorem posn (A2 R: class):
  $ wi (wrel R) (wb (wpo (csn A2) R) (wn (wbr A2 A2 R))) $;

--| Strict ordering on a singleton. (Contributed by Mario Carneiro, 28-Dec-2014.)
theorem sosn (A2 R: class):
  $ wi (wrel R) (wb (wor (csn A2) R) (wn (wbr A2 A2 R))) $;

--| Founded relation on a singleton. (Contributed by Mario Carneiro, 28-Dec-2014.) (Revised by Mario Carneiro, 23-Apr-2015.)
theorem frsn (A2 R: class):
  $ wi (wrel R) (wb (wfr (csn A2) R) (wn (wbr A2 A2 R))) $;

--| Well-ordering of a singleton. (Contributed by Mario Carneiro, 28-Dec-2014.)
theorem wesn (A2 R: class):
  $ wi (wrel R) (wb (wwe (csn A2) R) (wn (wbr A2 A2 R))) $;

--| Membership in an ordered-pair class abstraction implies membership in a Cartesian product. (Contributed by Alexander van der Vekens, 23-Jun-2018.) Avoid ~ ax-sep , ~ ax-nul , ~ ax-pr . (Revised by SN, 11-Dec-2024.)
theorem elopaelxp {x3 y1: setvar} (ps: wff x3 y1) (A2: class x3 y1):
  $ wi (wcel A2 (copab x3 y1 ps)) (wcel A2 (cxp cvv cvv)) $;

--| Two classes related by an ordered-pair class abstraction are sets. (Contributed by AV, 21-Jan-2020.)
theorem bropaex12 {x3 y1: setvar} (ps: wff x3 y1) (A2 B2: class) (R: class x3 y1):
  $ wceq R (copab x3 y1 ps) $ >
  $ wi (wbr A2 B2 R) (wa (wcel A2 cvv) (wcel B2 cvv)) $;

--| An abstraction relation is a subset of a related Cartesian product. (Contributed by NM, 16-Jul-1995.)
theorem opabssxp {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class):
  $ wss (copab x3 y1 (wa (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ph)) (cxp A2 B2) $;

--| The law of concretion for a binary relation. Ordered pair membership in an ordered pair class abstraction. (Contributed by Mario Carneiro, 28-Apr-2015.)
theorem brab2a {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2 B2 C D: class) (R: class x3 y1):
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ wceq R (copab x3 y1 (wa (wa (wcel (cv x3) C) (wcel (cv y1) D)) ph)) $ >
  $ wb (wbr A2 B2 R) (wa (wa (wcel A2 C) (wcel B2 D)) ps) $;

--| Implicit substitution of class for ordered pair. (Contributed by NM, 5-Mar-1995.) Shorten and reduce axiom usage. (Revised by TM, 29-Dec-2025.)
theorem optocl {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2 B2 C: class) (D: class x3 y1):
  $ wceq D (cxp B2 C) $ >
  $ wi (wceq (cop (cv x3) (cv y1)) A2) (wb ph ps) $ >
  $ wi (wa (wcel (cv x3) B2) (wcel (cv y1) C)) ph $ >
  $ wi (wcel A2 D) ps $;

--| Obsolete version of ~ optocl as of 29-Dec-2025. (Contributed by NM, 5-Mar-1995.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem optoclOLD {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2 B2 C: class) (D: class x3 y1):
  $ wceq D (cxp B2 C) $ >
  $ wi (wceq (cop (cv x3) (cv y1)) A2) (wb ph ps) $ >
  $ wi (wa (wcel (cv x3) B2) (wcel (cv y1) C)) ph $ >
  $ wi (wcel A2 D) ps $;

--| Implicit substitution of classes for ordered pairs. (Contributed by NM, 12-Mar-1995.)
theorem _2optocl {x3 y1 z w: setvar} (ph: wff x3 y1 z w) (ps: wff z w) (ch: wff x3 y1) (A2: class) (B2: class x3 y1) (C D: class) (R: class x3 y1):
  $ wceq R (cxp C D) $ >
  $ wi (wceq (cop (cv x3) (cv y1)) A2) (wb ph ps) $ >
  $ wi (wceq (cop (cv z) (cv w)) B2) (wb ps ch) $ >
  $ wi (wa (wa (wcel (cv x3) C) (wcel (cv y1) D)) (wa (wcel (cv z) C) (wcel (cv w) D))) ph $ >
  $ wi (wa (wcel A2 R) (wcel B2 R)) ch $;

--| Implicit substitution of classes for ordered pairs. (Contributed by NM, 12-Mar-1995.)
theorem _3optocl {x3 y1 z w v u: setvar} (ph: wff x3 y1 z w v u) (ps: wff z w v u) (ch: wff x3 y1 v u) (th: wff x3 y1 z w) (A2: class) (B2: class x3 y1) (C: class x3 y1 z w) (D: class) (R: class x3 y1) (F: class):
  $ wceq R (cxp D F) $ >
  $ wi (wceq (cop (cv x3) (cv y1)) A2) (wb ph ps) $ >
  $ wi (wceq (cop (cv z) (cv w)) B2) (wb ps ch) $ >
  $ wi (wceq (cop (cv v) (cv u)) C) (wb ch th) $ >
  $ wi (w3a (wa (wcel (cv x3) D) (wcel (cv y1) F)) (wa (wcel (cv z) D) (wcel (cv w) F)) (wa (wcel (cv v) D) (wcel (cv u) F))) ph $ >
  $ wi (w3a (wcel A2 R) (wcel B2 R) (wcel C R)) th $;

--| Ordered pair membership in a relation. Special case. (Contributed by NM, 5-Aug-1995.)
theorem opbrop {x3 y1 z w v u: setvar} (ph: wff z w v u) (ps: wff x3 y1) (A2 B2 C D: class) (R: class x3 y1 z w v u) (S: class):
  $ wi (wa (wa (wceq (cv z) A2) (wceq (cv w) B2)) (wa (wceq (cv v) C) (wceq (cv u) D))) (wb ph ps) $ >
  $ wceq R (copab x3 y1 (wa (wa (wcel (cv x3) (cxp S S)) (wcel (cv y1) (cxp S S))) (wex z (wex w (wex v (wex u (wa (wa (wceq (cv x3) (cop (cv z) (cv w))) (wceq (cv y1) (cop (cv v) (cv u)))) ph))))))) $ >
  $ wi (wa (wa (wcel A2 S) (wcel B2 S)) (wa (wcel C S) (wcel D S))) (wb (wbr (cop A2 B2) (cop C D) R) ps) $;

--| The Cartesian product with the empty set is empty. Part of Theorem 3.13(ii) of [Monk1] p. 37. (Contributed by NM, 4-Jul-1994.)
theorem _0xp (A2: class):
  $ wceq (cxp c0 A2) c0 $;

--| The Cartesian product with the empty set is empty. Part of Theorem 3.13(ii) of [Monk1] p. 37. (Contributed by NM, 12-Apr-2004.) Avoid axioms. (Revised by TM, 1-Feb-2026.)
theorem xp0 (A2: class):
  $ wceq (cxp A2 c0) c0 $;

--| Distribute proper substitution through the Cartesian product of two classes. (Contributed by Alan Sare, 10-Nov-2012.) (Revised by NM, 23-Aug-2018.)
theorem csbxp {x3: setvar} (A2 B2 C: class x3):
  $ wceq (csb x3 A2 (cxp B2 C)) (cxp (csb x3 A2 B2) (csb x3 A2 C)) $;

--| Equality theorem for the relation predicate. (Contributed by NM, 1-Aug-1994.)
theorem releq (A2 B2: class):
  $ wi (wceq A2 B2) (wb (wrel A2) (wrel B2)) $;

--| Equality inference for the relation predicate. (Contributed by NM, 8-Dec-2006.)
theorem releqi (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wb (wrel A2) (wrel B2) $;

--| Equality deduction for the relation predicate. (Contributed by NM, 8-Mar-2014.)
theorem releqd (ph: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wrel A2) (wrel B2)) $;

--| Bound-variable hypothesis builder for a relation. (Contributed by NM, 31-Jan-2004.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem nfrel {x3: setvar} (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wnf x3 (wrel A2) $;

--| Distribute proper substitution through a relation predicate. (Contributed by Alexander van der Vekens, 23-Jul-2017.)
theorem sbcrel {x3: setvar} (A2 R V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wrel R) A2) (wrel (csb x3 A2 R))) $;

--| Subclass theorem for relation predicate. Theorem 2 of [Suppes] p. 58. (Contributed by NM, 15-Aug-1994.)
theorem relss (A2 B2: class):
  $ wi (wss A2 B2) (wi (wrel B2) (wrel A2)) $;

--| A subclass relationship depends only on a relation's ordered pairs. Theorem 3.2(i) of [Monk1] p. 33. (Contributed by NM, 2-Aug-1994.) (Proof shortened by Andrew Salmon, 27-Aug-2011.) Remove dependency on ~ ax-sep , ~ ax-nul , ~ ax-pr . (Revised by KP, 25-Oct-2021.) Remove dependency on ~ ax-12 . (Revised by SN, 11-Dec-2024.)
theorem ssrel {x3 y1: setvar} (A2 B2: class):
  $ wi (wrel A2) (wb (wss A2 B2) (wal x3 (wal y1 (wi (wcel (cop (cv x3) (cv y1)) A2) (wcel (cop (cv x3) (cv y1)) B2))))) $;

--| Extensionality principle for relations. Theorem 3.2(ii) of [Monk1] p. 33. (Contributed by NM, 2-Aug-1994.)
theorem eqrel {x3 y1: setvar} (A2 B2: class):
  $ wi (wa (wrel A2) (wrel B2)) (wb (wceq A2 B2) (wal x3 (wal y1 (wb (wcel (cop (cv x3) (cv y1)) A2) (wcel (cop (cv x3) (cv y1)) B2))))) $;

--| A subclass relationship depends only on a relation's ordered pairs. This version of ~ ssrel is restricted to the relation's domain. (Contributed by Thierry Arnoux, 25-Jan-2018.)
theorem ssrel2 {x3 y1: setvar} (A2 B2 R S: class):
  $ wi (wss R (cxp A2 B2)) (wb (wss R S) (wral x3 (wral y1 (wi (wcel (cop (cv x3) (cv y1)) R) (wcel (cop (cv x3) (cv y1)) S)) B2) A2)) $;

--| Subclass relation in another form when the subclass is a relation. (Contributed by Peter Mazsa, 16-Feb-2019.)
theorem ssrel3 {x3 y1: setvar} (A2 B2: class):
  $ wi (wrel A2) (wb (wss A2 B2) (wal x3 (wal y1 (wi (wbr (cv x3) (cv y1) A2) (wbr (cv x3) (cv y1) B2))))) $;

--| Inference from subclass principle for relations. (Contributed by NM, 31-Mar-1998.)
theorem relssi {x3 y1: setvar} (A2 B2: class):
  $ wrel A2 $ >
  $ wi (wcel (cop (cv x3) (cv y1)) A2) (wcel (cop (cv x3) (cv y1)) B2) $ >
  $ wss A2 B2 $;

--| Deduction from subclass principle for relations. (Contributed by NM, 11-Sep-2004.)
theorem relssdv {x3 y1: setvar} (ph: wff) (A2 B2: class):
  $ wi ph (wrel A2) $ >
  $ wi ph (wi (wcel (cop (cv x3) (cv y1)) A2) (wcel (cop (cv x3) (cv y1)) B2)) $ >
  $ wi ph (wss A2 B2) $;

--| Inference from extensionality principle for relations. (Contributed by FL, 15-Oct-2012.)
theorem eqrelriv {x3 y1: setvar} (A2 B2: class):
  $ wb (wcel (cop (cv x3) (cv y1)) A2) (wcel (cop (cv x3) (cv y1)) B2) $ >
  $ wi (wa (wrel A2) (wrel B2)) (wceq A2 B2) $;

--| Inference from extensionality principle for relations. (Contributed by NM, 17-Mar-1995.)
theorem eqrelriiv {x3 y1: setvar} (A2 B2: class):
  $ wrel A2 $ >
  $ wrel B2 $ >
  $ wb (wcel (cop (cv x3) (cv y1)) A2) (wcel (cop (cv x3) (cv y1)) B2) $ >
  $ wceq A2 B2 $;

--| Inference from extensionality principle for relations. (Contributed by NM, 12-Dec-2006.)
theorem eqbrriv {x3 y1: setvar} (A2 B2: class):
  $ wrel A2 $ >
  $ wrel B2 $ >
  $ wb (wbr (cv x3) (cv y1) A2) (wbr (cv x3) (cv y1) B2) $ >
  $ wceq A2 B2 $;

--| Deduce equality of relations from equivalence of membership. (Contributed by Rodolfo Medina, 10-Oct-2010.)
theorem eqrelrdv {x3 y1: setvar} (ph: wff) (A2 B2: class):
  $ wrel A2 $ >
  $ wrel B2 $ >
  $ wi ph (wb (wcel (cop (cv x3) (cv y1)) A2) (wcel (cop (cv x3) (cv y1)) B2)) $ >
  $ wi ph (wceq A2 B2) $;

--| Deduction from extensionality principle for relations. (Contributed by Mario Carneiro, 3-Jan-2017.)
theorem eqbrrdv {x3 y1: setvar} (ph: wff) (A2 B2: class):
  $ wi ph (wrel A2) $ >
  $ wi ph (wrel B2) $ >
  $ wi ph (wb (wbr (cv x3) (cv y1) A2) (wbr (cv x3) (cv y1) B2)) $ >
  $ wi ph (wceq A2 B2) $;

--| Deduction from extensionality principle for relations. (Contributed by Rodolfo Medina, 10-Oct-2010.)
theorem eqbrrdiv {x3 y1: setvar} (ph: wff) (A2 B2: class):
  $ wrel A2 $ >
  $ wrel B2 $ >
  $ wi ph (wb (wbr (cv x3) (cv y1) A2) (wbr (cv x3) (cv y1) B2)) $ >
  $ wi ph (wceq A2 B2) $;

--| A version of ~ eqrelrdv . (Contributed by Rodolfo Medina, 10-Oct-2010.)
theorem eqrelrdv2 {x3 y1: setvar} (ph: wff) (A2 B2: class):
  $ wi ph (wb (wcel (cop (cv x3) (cv y1)) A2) (wcel (cop (cv x3) (cv y1)) B2)) $ >
  $ wi (wa (wa (wrel A2) (wrel B2)) ph) (wceq A2 B2) $;

--| A subclass relationship determined by ordered triples. Use ~ relrelss to express the antecedent in terms of the relation predicate. (Contributed by NM, 17-Dec-2008.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem ssrelrel {x3 y1 z: setvar} (A2 B2: class):
  $ wi (wss A2 (cxp (cxp cvv cvv) cvv)) (wb (wss A2 B2) (wal x3 (wal y1 (wal z (wi (wcel (cop (cop (cv x3) (cv y1)) (cv z)) A2) (wcel (cop (cop (cv x3) (cv y1)) (cv z)) B2)))))) $;

--| Extensionality principle for ordered triples (used by 2-place operations ~ df-oprab ), analogous to ~ eqrel . Use ~ relrelss to express the antecedent in terms of the relation predicate. (Contributed by NM, 17-Dec-2008.)
theorem eqrelrel {x3 y1 z: setvar} (A2 B2: class):
  $ wi (wss (cun A2 B2) (cxp (cxp cvv cvv) cvv)) (wb (wceq A2 B2) (wal x3 (wal y1 (wal z (wb (wcel (cop (cop (cv x3) (cv y1)) (cv z)) A2) (wcel (cop (cop (cv x3) (cv y1)) (cv z)) B2)))))) $;

--| A member of a relation is an ordered pair. (Contributed by NM, 17-Sep-2006.)
theorem elrel {x3 y1: setvar} (A2: class) (R: class x3 y1):
  $ wi (wa (wrel R) (wcel A2 R)) (wex x3 (wex y1 (wceq A2 (cop (cv x3) (cv y1))))) $;

--| A member of a relation expressed by an ordered pair. (Contributed by AV, 23-Aug-2026.)
theorem elrelb {x3 y1: setvar} (A2 R: class):
  $ wi (wrel R) (wb (wcel A2 R) (wex x3 (wex y1 (wa (wceq A2 (cop (cv x3) (cv y1))) (wbr (cv x3) (cv y1) R))))) $;

--| The empty set is a relation. (Contributed by NM, 26-Apr-1998.)
theorem rel0:
  $ wrel c0 $;

--| The universal class is not a relation. (Contributed by Thierry Arnoux, 23-Jan-2022.) (Proof shortened by Umit Teoman Dogan, 10-Jun-2026.)
theorem nrelv:
  $ wn (wrel cvv) $;

--| Obsolete version of ~ nrelv as of 10-Jun-2026. (Contributed by Thierry Arnoux, 23-Jan-2022.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem nrelvOLD:
  $ wn (wrel cvv) $;

--| A singleton is a relation iff it is a singleton on an ordered pair. (Contributed by NM, 24-Sep-2013.) (Revised by BJ, 12-Feb-2022.)
theorem relsng (A2 V: class):
  $ wi (wcel A2 V) (wb (wrel (csn A2)) (wcel A2 (cxp cvv cvv))) $;

--| An at-most-singleton is a relation iff it is empty (because it is a "singleton on a proper class") or it is a singleton of an ordered pair. (Contributed by BJ, 26-Feb-2023.)
theorem relsnb (A2: class):
  $ wb (wrel (csn A2)) (wo (wn (wcel A2 cvv)) (wcel A2 (cxp cvv cvv))) $;

--| A singleton of an ordered pair is a relation. (Contributed by NM, 17-May-1998.) (Revised by BJ, 12-Feb-2022.)
theorem relsnopg (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wrel (csn (cop A2 B2))) $;

--| A singleton is a relation iff it is an ordered pair. (Contributed by NM, 24-Sep-2013.)
theorem relsn (A2: class):
  $ wcel A2 cvv $ >
  $ wb (wrel (csn A2)) (wcel A2 (cxp cvv cvv)) $;

--| A singleton of an ordered pair is a relation. (Contributed by NM, 17-May-1998.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem relsnop (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wrel (csn (cop A2 B2)) $;

--| Implicit substitution inference for ordered pairs. Compare ~ copsex2ga . (Contributed by NM, 12-Mar-2014.)
theorem copsex2gb {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (A2: class):
  $ wi (wceq A2 (cop (cv x3) (cv y1))) (wb ph ps) $ >
  $ wb (wex x3 (wex y1 (wa (wceq A2 (cop (cv x3) (cv y1))) ps))) (wa (wcel A2 (cxp cvv cvv)) ph) $;

--| Implicit substitution inference for ordered pairs. Compare ~ copsex2g . (Contributed by NM, 26-Feb-2014.) (Proof shortened by Mario Carneiro, 31-Aug-2015.)
theorem copsex2ga {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (A2: class) (V W: class x3 y1):
  $ wi (wceq A2 (cop (cv x3) (cv y1))) (wb ph ps) $ >
  $ wi (wcel A2 (cxp V W)) (wb ph (wex x3 (wex y1 (wa (wceq A2 (cop (cv x3) (cv y1))) ps)))) $;

--| Membership in an ordered-pair class abstraction. (Contributed by NM, 25-Feb-2014.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem elopaba {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (A2: class):
  $ wi (wceq A2 (cop (cv x3) (cv y1))) (wb ph ps) $ >
  $ wb (wcel A2 (copab x3 y1 ps)) (wa (wcel A2 (cxp cvv cvv)) ph) $;

--| A Cartesian product is included in the power of the power of the union of its arguments. (Contributed by NM, 13-Sep-2006.)
theorem xpsspw (A2 B2: class):
  $ wss (cxp A2 B2) (cpw (cpw (cun A2 B2))) $;

--| The double class union of a Cartesian product is included in the union of its arguments. (Contributed by NM, 16-Sep-2006.)
theorem unixpss (A2 B2: class):
  $ wss (cuni (cuni (cxp A2 B2))) (cun A2 B2) $;

--| The union of two relations is a relation. Compare Exercise 5 of [TakeutiZaring] p. 25. (Contributed by NM, 12-Aug-1994.)
theorem relun (A2 B2: class):
  $ wb (wrel (cun A2 B2)) (wa (wrel A2) (wrel B2)) $;

--| The intersection with a relation is a relation. (Contributed by NM, 16-Aug-1994.)
theorem relin1 (A2 B2: class):
  $ wi (wrel A2) (wrel (cin A2 B2)) $;

--| The intersection with a relation is a relation. (Contributed by NM, 17-Jan-2006.)
theorem relin2 (A2 B2: class):
  $ wi (wrel B2) (wrel (cin A2 B2)) $;

--| Intersection with a Cartesian product is a relation. (Contributed by Peter Mazsa, 4-Mar-2019.)
theorem relinxp (A2 B2 R: class):
  $ wrel (cin R (cxp A2 B2)) $;

--| A difference cutting down a relation is a relation. (Contributed by NM, 31-Mar-1998.)
theorem reldif (A2 B2: class):
  $ wi (wrel A2) (wrel (cdif A2 B2)) $;

--| An indexed union is a relation iff each member of its indexed family is a relation. (Contributed by NM, 19-Dec-2008.) (Proof shortened by SN, 2-Feb-2025.)
theorem reliun {x3: setvar} (A2 B2: class x3):
  $ wb (wrel (ciun x3 A2 B2)) (wral x3 (wrel B2) A2) $;

--| An indexed intersection is a relation if at least one of the member of the indexed family is a relation. (Contributed by NM, 8-Mar-2014.)
theorem reliin {x3: setvar} (A2 B2: class x3):
  $ wi (wrex x3 (wrel B2) A2) (wrel (ciin x3 A2 B2)) $;

--| The union of a class is a relation iff any member is a relation. Exercise 6 of [TakeutiZaring] p. 25 and its converse. (Contributed by NM, 13-Aug-2004.)
theorem reluni {x3: setvar} (A2: class):
  $ wb (wrel (cuni A2)) (wral x3 (wrel (cv x3)) A2) $;

--| The intersection of a class is a relation if at least one member is a relation. (Contributed by NM, 8-Mar-2014.)
theorem relint {x3: setvar} (A2: class):
  $ wi (wrex x3 (wrel (cv x3)) A2) (wrel (cint A2)) $;

--| A class of ordered pairs is a relation. For a version without a disjoint variable condition, but a longer proof using ~ ax-11 and ~ ax-12 , see ~ relopabi . (Contributed by BJ, 22-Jul-2023.)
theorem relopabiv {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wceq A2 (copab x3 y1 ph) $ >
  $ wrel A2 $;

--| A class of ordered pairs is a relation. For a version without a disjoint variable condition, but using ~ ax-11 and ~ ax-12 , see ~ relopab . (Contributed by SN, 8-Sep-2024.)
theorem relopabv {x3 y1: setvar} (ph: wff x3 y1):
  $ wrel (copab x3 y1 ph) $;

--| A class of ordered pairs is a relation. (Contributed by Mario Carneiro, 21-Dec-2013.) Remove dependency on ~ ax-sep , ~ ax-nul , ~ ax-pr . (Revised by KP, 25-Oct-2021.)
theorem relopabi {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wceq A2 (copab x3 y1 ph) $ >
  $ wrel A2 $;

--| Alternate proof of ~ relopabi (shorter but uses more axioms). (Contributed by Mario Carneiro, 21-Dec-2013.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem relopabiALT {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wceq A2 (copab x3 y1 ph) $ >
  $ wrel A2 $;

--| A class of ordered pairs is a relation. (Contributed by NM, 8-Mar-1995.) Remove disjoint variable conditions. (Revised by Alan Sare, 9-Jul-2013.) (Proof shortened by Mario Carneiro, 21-Dec-2013.)
theorem relopab {x3 y1: setvar} (ph: wff x3 y1):
  $ wrel (copab x3 y1 ph) $;

--| The maps-to notation always describes a binary relation. (Contributed by Scott Fenton, 16-Apr-2012.)
theorem mptrel {x3: setvar} (A2 B2: class x3):
  $ wrel (cmpt x3 A2 B2) $;

--| The identity relation is a relation. Part of Exercise 4.12(p) of [Mendelson] p. 235. (Contributed by NM, 26-Apr-1998.) (Revised by Mario Carneiro, 21-Dec-2013.)
theorem reli:
  $ wrel cid $;

--| The membership relation is a relation. (Contributed by NM, 26-Apr-1998.) (Revised by Mario Carneiro, 21-Dec-2013.)
theorem rele:
  $ wrel cep $;

--| A relation expressed as an ordered pair abstraction. (Contributed by NM, 11-Dec-2006.)
theorem opabid2 {x3 y1: setvar} (A2: class):
  $ wi (wrel A2) (wceq (copab x3 y1 (wcel (cop (cv x3) (cv y1)) A2)) A2) $;

--| Intersection of two ordered pair class abstractions. (Contributed by NM, 30-Sep-2002.)
theorem inopab {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wceq (cin (copab x3 y1 ph) (copab x3 y1 ps)) (copab x3 y1 (wa ph ps)) $;

--| Difference of two ordered-pair class abstractions. (Contributed by Stefan O'Rear, 17-Jan-2015.) (Proof shortened by SN, 19-Dec-2024.)
theorem difopab {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wceq (cdif (copab x3 y1 ph) (copab x3 y1 ps)) (copab x3 y1 (wa ph (wn ps))) $;

--| Intersection of two Cartesian products. Exercise 9 of [TakeutiZaring] p. 25. (Contributed by NM, 3-Aug-1994.) (Proof shortened by Andrew Salmon, 27-Aug-2011.) Avoid ~ ax-10 , ~ ax-12 . (Revised by SN, 5-May-2025.)
theorem inxp (A2 B2 C D: class):
  $ wceq (cin (cxp A2 B2) (cxp C D)) (cxp (cin A2 C) (cin B2 D)) $;

--| Distributive law for Cartesian product over intersection. Theorem 102 of [Suppes] p. 52. (Contributed by NM, 26-Sep-2004.)
theorem xpindi (A2 B2 C: class):
  $ wceq (cxp A2 (cin B2 C)) (cin (cxp A2 B2) (cxp A2 C)) $;

--| Distributive law for Cartesian product over intersection. Similar to Theorem 102 of [Suppes] p. 52. (Contributed by NM, 26-Sep-2004.)
theorem xpindir (A2 B2 C: class):
  $ wceq (cxp (cin A2 B2) C) (cin (cxp A2 C) (cxp B2 C)) $;

--| Distributive law for Cartesian product over indexed intersection. (Contributed by Mario Carneiro, 21-Mar-2015.)
theorem xpiindi {x3: setvar} (A2: class) (B2: class x3) (C: class):
  $ wi (wne A2 c0) (wceq (cxp C (ciin x3 A2 B2)) (ciin x3 A2 (cxp C B2))) $;

--| Distributive law for Cartesian product over relativized indexed intersection. (Contributed by Mario Carneiro, 21-Mar-2015.)
theorem xpriindi {x3: setvar} (A2: class) (B2: class x3) (C: class) (D: class x3):
  $ wceq (cxp C (cin D (ciin x3 A2 B2))) (cin (cxp C D) (ciin x3 A2 (cxp C B2))) $;

--| Membership in a union of Cartesian products. Analogue of ~ elxp for nonconstant ` B ( x ) ` . (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem eliunxp {x3 y1: setvar} (A2 B2: class x3) (C: class):
  $ wb (wcel C (ciun x3 A2 (cxp (csn (cv x3)) B2))) (wex x3 (wex y1 (wa (wceq C (cop (cv x3) (cv y1))) (wa (wcel (cv x3) A2) (wcel (cv y1) B2))))) $;

--| Membership in a union of Cartesian products. (Contributed by Mario Carneiro, 14-Feb-2015.)
theorem opeliunxp2 {x3: setvar} (A2: class) (B2: class x3) (C D E: class):
  $ wi (wceq (cv x3) C) (wceq B2 E) $ >
  $ wb (wcel (cop C D) (ciun x3 A2 (cxp (csn (cv x3)) B2))) (wa (wcel C A2) (wcel D E)) $;

--| Write a double restricted quantification as one universal quantifier. In this version of ~ ralxp , ` B ( y ) ` is not assumed to be constant. (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem raliunxp {x3 y1 z: setvar} (ph: wff x3) (ps: wff y1 z) (A2: class) (B2: class y1):
  $ wi (wceq (cv x3) (cop (cv y1) (cv z))) (wb ph ps) $ >
  $ wb (wral x3 ph (ciun y1 A2 (cxp (csn (cv y1)) B2))) (wral y1 (wral z ps B2) A2) $;

--| Write a double restricted quantification as one universal quantifier. In this version of ~ rexxp , ` B ( y ) ` is not assumed to be constant. (Contributed by Mario Carneiro, 14-Feb-2015.)
theorem rexiunxp {x3 y1 z: setvar} (ph: wff x3) (ps: wff y1 z) (A2: class) (B2: class y1):
  $ wi (wceq (cv x3) (cop (cv y1) (cv z))) (wb ph ps) $ >
  $ wb (wrex x3 ph (ciun y1 A2 (cxp (csn (cv y1)) B2))) (wrex y1 (wrex z ps B2) A2) $;

--| Universal quantification restricted to a Cartesian product is equivalent to a double restricted quantification. The hypothesis specifies an implicit substitution. (Contributed by NM, 7-Feb-2004.) (Revised by Mario Carneiro, 29-Dec-2014.)
theorem ralxp {x3 y1 z: setvar} (ph: wff x3) (ps: wff y1 z) (A2 B2: class):
  $ wi (wceq (cv x3) (cop (cv y1) (cv z))) (wb ph ps) $ >
  $ wb (wral x3 ph (cxp A2 B2)) (wral y1 (wral z ps B2) A2) $;

--| Existential quantification restricted to a Cartesian product is equivalent to a double restricted quantification. (Contributed by NM, 11-Nov-1995.) (Revised by Mario Carneiro, 14-Feb-2015.)
theorem rexxp {x3 y1 z: setvar} (ph: wff x3) (ps: wff y1 z) (A2 B2: class):
  $ wi (wceq (cv x3) (cop (cv y1) (cv z))) (wb ph ps) $ >
  $ wb (wrex x3 ph (cxp A2 B2)) (wrex y1 (wrex z ps B2) A2) $;

--| A member of a nested Cartesian product is an ordered triple. (Contributed by Alexander van der Vekens, 15-Feb-2018.)
theorem el2xptp {x3 y1 z: setvar} (A2 B2 C D: class):
  $ wb (wcel A2 (cxp (cxp B2 C) D)) (wrex x3 (wrex y1 (wrex z (wceq A2 (cotp (cv x3) (cv y1) (cv z))) D) C) B2) $;

--| Transfer ordered-pair existence from/to single variable existence. (Contributed by NM, 26-Feb-2014.) (Proof shortened by Mario Carneiro, 31-Aug-2015.)
theorem exopxfr {x3 y1 z: setvar} (ph: wff x3) (ps: wff y1 z):
  $ wi (wceq (cv x3) (cop (cv y1) (cv z))) (wb ph ps) $ >
  $ wb (wrex x3 ph (cxp cvv cvv)) (wex y1 (wex z ps)) $;

--| Transfer ordered-pair existence from/to single variable existence. (Contributed by NM, 26-Feb-2014.)
theorem exopxfr2 {x3 y1 z: setvar} (ph: wff x3) (ps: wff y1 z) (A2: class):
  $ wi (wceq (cv x3) (cop (cv y1) (cv z))) (wb ph ps) $ >
  $ wi (wrel A2) (wb (wrex x3 ph A2) (wex y1 (wex z (wa (wcel (cop (cv y1) (cv z)) A2) ps)))) $;

--| Disjoint union is a subset of a Cartesian product. (Contributed by Stefan O'Rear, 21-Nov-2014.)
theorem djussxp {x3: setvar} (A2: class) (B2: class x3):
  $ wss (ciun x3 A2 (cxp (csn (cv x3)) B2)) (cxp A2 cvv) $;

--| Version of ~ ralxp with bound-variable hypotheses. (Contributed by NM, 18-Aug-2006.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem ralxpf {x3 y1 z: setvar} (ph ps: wff x3 y1 z) (A2: class z) (B2: class):
  $ wnf y1 ph $ >
  $ wnf z ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cop (cv y1) (cv z))) (wb ph ps) $ >
  $ wb (wral x3 ph (cxp A2 B2)) (wral y1 (wral z ps B2) A2) $;

--| Version of ~ rexxp with bound-variable hypotheses. (Contributed by NM, 19-Dec-2008.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem rexxpf {x3 y1 z: setvar} (ph ps: wff x3 y1 z) (A2: class z) (B2: class):
  $ wnf y1 ph $ >
  $ wnf z ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cop (cv y1) (cv z))) (wb ph ps) $ >
  $ wb (wrex x3 ph (cxp A2 B2)) (wrex y1 (wrex z ps B2) A2) $;

--| Indexed union on a Cartesian product equals a double indexed union. The hypothesis specifies an implicit substitution. (Contributed by NM, 19-Dec-2008.)
theorem iunxpf {x3 y1 z: setvar} (A2: class z) (B2: class) (C D: class x3 y1 z):
  $ wnfc y1 C $ >
  $ wnfc z C $ >
  $ wnfc x3 D $ >
  $ wi (wceq (cv x3) (cop (cv y1) (cv z))) (wceq C D) $ >
  $ wceq (ciun x3 (cxp A2 B2) C) (ciun y1 A2 (ciun z B2 D)) $;

--| Deduce equality of a relation and an ordered-pair class abstraction. Compare ~ eqabdv . (Contributed by NM, 24-Feb-2014.)
theorem opabbi2dv {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (A2: class):
  $ wrel A2 $ >
  $ wi ph (wb (wcel (cop (cv x3) (cv y1)) A2) ps) $ >
  $ wi ph (wceq A2 (copab x3 y1 ps)) $;

--| A necessary and sufficient condition for a Kuratowski ordered pair to be a relation. (Contributed by NM, 3-Jun-2008.) A relation is a class of ordered pairs, so the fact that an ordered pair may sometimes be itself a relation is an "accident" depending on the specific encoding of ordered pairs as classes (in set.mm, the Kuratowski encoding). A more meaningful statement is ~ relsnopg , as ~ funsng is to ~ funop . (New usage is discouraged.)
theorem relop {x3 y1: setvar} (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wb (wrel (cop A2 B2)) (wex x3 (wex y1 (wa (wceq A2 (csn (cv x3))) (wceq B2 (cpr (cv x3) (cv y1)))))) $;

--| For sets, the identity relation is the same as equality. (Contributed by NM, 30-Apr-2004.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem ideqg (A2 B2 V: class):
  $ wi (wcel B2 V) (wb (wbr A2 B2 cid) (wceq A2 B2)) $;

--| For sets, the identity relation is the same as equality. (Contributed by NM, 13-Aug-1995.)
theorem ideq (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wb (wbr A2 B2 cid) (wceq A2 B2) $;

--| A set is identical to itself. (Contributed by NM, 28-May-2008.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem ididg (A2 V: class):
  $ wi (wcel A2 V) (wbr A2 A2 cid) $;

--| Two ways of expressing set existence. (Contributed by NM, 16-Feb-2008.) (Proof shortened by Andrew Salmon, 27-Aug-2011.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem issetid (A2: class):
  $ wb (wcel A2 cvv) (wbr A2 A2 cid) $;

--| Subclass theorem for composition. (Contributed by FL, 30-Dec-2010.)
theorem coss1 (A2 B2 C: class):
  $ wi (wss A2 B2) (wss (ccom A2 C) (ccom B2 C)) $;

--| Subclass theorem for composition. (Contributed by NM, 5-Apr-2013.)
theorem coss2 (A2 B2 C: class):
  $ wi (wss A2 B2) (wss (ccom C A2) (ccom C B2)) $;

--| Equality theorem for composition of two classes. (Contributed by NM, 3-Jan-1997.)
theorem coeq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (ccom A2 C) (ccom B2 C)) $;

--| Equality theorem for composition of two classes. (Contributed by NM, 3-Jan-1997.)
theorem coeq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (ccom C A2) (ccom C B2)) $;

--| Equality inference for composition of two classes. (Contributed by NM, 16-Nov-2000.)
theorem coeq1i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (ccom A2 C) (ccom B2 C) $;

--| Equality inference for composition of two classes. (Contributed by NM, 16-Nov-2000.)
theorem coeq2i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (ccom C A2) (ccom C B2) $;

--| Equality deduction for composition of two classes. (Contributed by NM, 16-Nov-2000.)
theorem coeq1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (ccom A2 C) (ccom B2 C)) $;

--| Equality deduction for composition of two classes. (Contributed by NM, 16-Nov-2000.)
theorem coeq2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (ccom C A2) (ccom C B2)) $;

--| Equality inference for composition of two classes. (Contributed by FL, 7-Jun-2012.)
theorem coeq12i (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq C D $ >
  $ wceq (ccom A2 C) (ccom B2 D) $;

--| Equality deduction for composition of two classes. (Contributed by FL, 7-Jun-2012.)
theorem coeq12d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq (ccom A2 C) (ccom B2 D)) $;

--| Bound-variable hypothesis builder for function value. (Contributed by NM, 1-Sep-1999.)
theorem nfco {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 (ccom A2 B2) $;

--| Ordered pair membership in a composition. (Contributed by NM, 24-Feb-2015.)
theorem brcog {x3: setvar} (A2 B2 C D: class) (V W: class x3):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wbr A2 B2 (ccom C D)) (wex x3 (wa (wbr A2 (cv x3) D) (wbr (cv x3) B2 C)))) $;

--| Ordered pair membership in a composition. (Contributed by NM, 27-Jan-1997.) (Revised by Mario Carneiro, 24-Feb-2015.)
theorem opelco2g {x3: setvar} (A2 B2 C D: class) (V W: class x3):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wcel (cop A2 B2) (ccom C D)) (wex x3 (wa (wcel (cop A2 (cv x3)) D) (wcel (cop (cv x3) B2) C)))) $;

--| Ordered pair membership in a composition. (Contributed by Thierry Arnoux, 14-Jan-2018.)
theorem brcogw (A2 B2 C D V W X Z: class):
  $ wi (wa (w3a (wcel A2 V) (wcel B2 W) (wcel X Z)) (wa (wbr A2 X D) (wbr X B2 C))) (wbr A2 B2 (ccom C D)) $;

--| Deduction from extensionality principle for relations, given an equivalence only on the relation domain and range. (Contributed by Thierry Arnoux, 28-Nov-2017.)
theorem eqbrrdva {x3 y1: setvar} (ph: wff) (A2 B2: class) (C D: class x3 y1):
  $ wi ph (wss A2 (cxp C D)) $ >
  $ wi ph (wss B2 (cxp C D)) $ >
  $ wi (w3a ph (wcel (cv x3) C) (wcel (cv y1) D)) (wb (wbr (cv x3) (cv y1) A2) (wbr (cv x3) (cv y1) B2)) $ >
  $ wi ph (wceq A2 B2) $;

--| Binary relation on a composition. (Contributed by NM, 21-Sep-2004.) (Revised by Mario Carneiro, 24-Feb-2015.)
theorem brco {x3: setvar} (A2 B2 C D: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wb (wbr A2 B2 (ccom C D)) (wex x3 (wa (wbr A2 (cv x3) D) (wbr (cv x3) B2 C))) $;

--| Ordered pair membership in a composition. (Contributed by NM, 27-Dec-1996.) (Revised by Mario Carneiro, 24-Feb-2015.)
theorem opelco {x3: setvar} (A2 B2 C D: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wb (wcel (cop A2 B2) (ccom C D)) (wex x3 (wa (wbr A2 (cv x3) D) (wbr (cv x3) B2 C))) $;

--| Subset theorem for converse. (Contributed by NM, 22-Mar-1998.) (Proof shortened by Kyle Wyonch, 27-Apr-2021.)
theorem cnvss (A2 B2: class):
  $ wi (wss A2 B2) (wss (ccnv A2) (ccnv B2)) $;

--| Equality theorem for converse relation. (Contributed by NM, 13-Aug-1995.)
theorem cnveq (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (ccnv A2) (ccnv B2)) $;

--| Equality inference for converse relation. (Contributed by NM, 23-Dec-2008.)
theorem cnveqi (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wceq (ccnv A2) (ccnv B2) $;

--| Equality deduction for converse relation. (Contributed by NM, 6-Dec-2013.)
theorem cnveqd (ph: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (ccnv A2) (ccnv B2)) $;

--| Membership in a converse relation. Equation 5 of [Suppes] p. 62. (Contributed by NM, 24-Mar-1998.)
theorem elcnv {x3 y1: setvar} (A2 R: class):
  $ wb (wcel A2 (ccnv R)) (wex x3 (wex y1 (wa (wceq A2 (cop (cv x3) (cv y1))) (wbr (cv y1) (cv x3) R)))) $;

--| Membership in a converse relation. Equation 5 of [Suppes] p. 62. (Contributed by NM, 11-Aug-2004.)
theorem elcnv2 {x3 y1: setvar} (A2 R: class):
  $ wb (wcel A2 (ccnv R)) (wex x3 (wex y1 (wa (wceq A2 (cop (cv x3) (cv y1))) (wcel (cop (cv y1) (cv x3)) R)))) $;

--| Bound-variable hypothesis builder for converse relation. (Contributed by NM, 31-Jan-2004.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem nfcnv {x3: setvar} (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 (ccnv A2) $;

--| The converse of a binary relation swaps arguments. Theorem 11 of [Suppes] p. 61. (Contributed by NM, 10-Oct-2005.)
theorem brcnvg (A2 B2 C D R: class):
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wb (wbr A2 B2 (ccnv R)) (wbr B2 A2 R)) $;

--| Ordered-pair membership in converse relation. (Contributed by NM, 13-May-1999.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem opelcnvg (A2 B2 C D R: class):
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wb (wcel (cop A2 B2) (ccnv R)) (wcel (cop B2 A2) R)) $;

--| Ordered-pair membership in converse relation. (Contributed by NM, 13-Aug-1995.)
theorem opelcnv (A2 B2 R: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wb (wcel (cop A2 B2) (ccnv R)) (wcel (cop B2 A2) R) $;

--| The converse of a binary relation swaps arguments. Theorem 11 of [Suppes] p. 61. (Contributed by NM, 13-Aug-1995.)
theorem brcnv (A2 B2 R: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wb (wbr A2 B2 (ccnv R)) (wbr B2 A2 R) $;

--| The converse of the empty set. (Contributed by NM, 6-Apr-1998.) Remove dependency on ~ ax-sep , ~ ax-nul , ~ ax-pr . (Revised by KP, 25-Oct-2021.) Avoid ~ ax-12 . (Revised by TM, 31-Jan-2026.)
theorem cnv0:
  $ wceq (ccnv c0) c0 $;

--| Obsolete version of ~ cnv0 as of 31-Jan-2026. (Contributed by NM, 6-Apr-1998.) Remove dependency on ~ ax-sep , ~ ax-nul , ~ ax-pr . (Revised by KP, 25-Oct-2021.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem cnv0OLD:
  $ wceq (ccnv c0) c0 $;

--| The converse of the identity relation. Theorem 3.7(ii) of [Monk1] p. 36. (Contributed by NM, 26-Apr-1998.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem cnvi:
  $ wceq (ccnv cid) cid $;

--| Move class substitution in and out of the converse of a relation. (Contributed by Thierry Arnoux, 8-Feb-2017.) (Revised by NM, 23-Aug-2018.) Remove dependency on ~ ax-sep and ~ ax-pr . (Revised by Eric Schmidt, 4-Jun-2026.)
theorem csbcnv {x3: setvar} (A2 F: class x3):
  $ wceq (ccnv (csb x3 A2 F)) (csb x3 A2 (ccnv F)) $;

--| Obsolete version of ~ csbcnv as of 4-Jun-2026. (Contributed by Thierry Arnoux, 8-Feb-2017.) (Revised by NM, 23-Aug-2018.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem csbcnvOLD {x3: setvar} (A2 F: class x3):
  $ wceq (ccnv (csb x3 A2 F)) (csb x3 A2 (ccnv F)) $;

--| Obsolete version of ~ csbcnv as of 4-Jun-2026. (Contributed by Thierry Arnoux, 8-Feb-2017.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem csbcnvgALTOLD {x3: setvar} (A2 F V: class x3):
  $ wi (wcel A2 V) (wceq (ccnv (csb x3 A2 F)) (csb x3 A2 (ccnv F))) $;

--| Distributive law of converse over class composition. Theorem 26 of [Suppes] p. 64. (Contributed by NM, 19-Mar-1998.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem cnvco (A2 B2: class):
  $ wceq (ccnv (ccom A2 B2)) (ccom (ccnv B2) (ccnv A2)) $;

--| The converse of a class union is the (indexed) union of the converses of its members. (Contributed by NM, 11-Aug-2004.)
theorem cnvuni {x3: setvar} (A2: class):
  $ wceq (ccnv (cuni A2)) (ciun x3 A2 (ccnv (cv x3))) $;

--| Alternate definition of domain. Definition 6.5(1) of [TakeutiZaring] p. 24. (Contributed by NM, 28-Dec-1996.)
theorem dfdm3 {x3 y1: setvar} (A2: class):
  $ wceq (cdm A2) (cab x3 (wex y1 (wcel (cop (cv x3) (cv y1)) A2))) $;

--| Alternate definition of range. Definition 4 of [Suppes] p. 60. (Contributed by NM, 27-Dec-1996.)
theorem dfrn2 {x3 y1: setvar} (A2: class):
  $ wceq (crn A2) (cab y1 (wex x3 (wbr (cv x3) (cv y1) A2))) $;

--| Alternate definition of range. Definition 6.5(2) of [TakeutiZaring] p. 24. (Contributed by NM, 28-Dec-1996.)
theorem dfrn3 {x3 y1: setvar} (A2: class):
  $ wceq (crn A2) (cab y1 (wex x3 (wcel (cop (cv x3) (cv y1)) A2))) $;

--| Membership in a range. (Contributed by Scott Fenton, 2-Feb-2011.)
theorem elrn2g {x3: setvar} (A2 B2: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wcel A2 (crn B2)) (wex x3 (wcel (cop (cv x3) A2) B2))) $;

--| Membership in a range. (Contributed by Scott Fenton, 2-Feb-2011.)
theorem elrng {x3: setvar} (A2 B2: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wcel A2 (crn B2)) (wex x3 (wbr (cv x3) A2 B2))) $;

--| Membership in a range. (Contributed by NM, 10-Jul-1994.)
theorem elrn2 {x3: setvar} (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 (crn B2)) (wex x3 (wcel (cop (cv x3) A2) B2)) $;

--| Membership in a range. (Contributed by NM, 2-Apr-2004.)
theorem elrn {x3: setvar} (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 (crn B2)) (wex x3 (wbr (cv x3) A2 B2)) $;

--| If a relation is a subset of a cartesian product, then for each element of the range of the relation there is an element of the first set of the cartesian product which is related to the element of the range by the relation. (Contributed by AV, 24-Oct-2020.)
theorem ssrelrn {a: setvar} (A2 B2 R Y: class):
  $ wi (wa (wss R (cxp A2 B2)) (wcel Y (crn R))) (wrex a (wbr (cv a) Y R) A2) $;

--| Alternate definition of domain. (Contributed by NM, 28-Dec-1996.)
theorem dfdm4 (A2: class):
  $ wceq (cdm A2) (crn (ccnv A2)) $;

--| Definition of domain, using bound-variable hypotheses instead of distinct variable conditions. (Contributed by NM, 8-Mar-1995.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem dfdmf {x3 y1: setvar} (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wceq (cdm A2) (cab x3 (wex y1 (wbr (cv x3) (cv y1) A2))) $;

--| Distribute proper substitution through the domain of a class. (Contributed by Alexander van der Vekens, 23-Jul-2017.) (Revised by NM, 24-Aug-2018.)
theorem csbdm {x3: setvar} (A2 B2: class x3):
  $ wceq (csb x3 A2 (cdm B2)) (cdm (csb x3 A2 B2)) $;

--| Domain membership. Theorem 4 of [Suppes] p. 59. (Contributed by Mario Carneiro, 9-Jul-2014.)
theorem eldmg {y1: setvar} (A2 B2: class) (V: class y1):
  $ wi (wcel A2 V) (wb (wcel A2 (cdm B2)) (wex y1 (wbr A2 (cv y1) B2))) $;

--| Domain membership. Theorem 4 of [Suppes] p. 59. (Contributed by NM, 27-Jan-1997.) (Revised by Mario Carneiro, 9-Jul-2014.)
theorem eldm2g {y1: setvar} (A2 B2: class) (V: class y1):
  $ wi (wcel A2 V) (wb (wcel A2 (cdm B2)) (wex y1 (wcel (cop A2 (cv y1)) B2))) $;

--| Membership in a domain. Theorem 4 of [Suppes] p. 59. (Contributed by NM, 2-Apr-2004.)
theorem eldm {y1: setvar} (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 (cdm B2)) (wex y1 (wbr A2 (cv y1) B2)) $;

--| Membership in a domain. Theorem 4 of [Suppes] p. 59. (Contributed by NM, 1-Aug-1994.)
theorem eldm2 {y1: setvar} (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 (cdm B2)) (wex y1 (wcel (cop A2 (cv y1)) B2)) $;

--| Subset theorem for domain. (Contributed by NM, 11-Aug-1994.)
theorem dmss (A2 B2: class):
  $ wi (wss A2 B2) (wss (cdm A2) (cdm B2)) $;

--| Equality theorem for domain. (Contributed by NM, 11-Aug-1994.)
theorem dmeq (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (cdm A2) (cdm B2)) $;

--| Equality inference for domain. (Contributed by NM, 4-Mar-2004.)
theorem dmeqi (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wceq (cdm A2) (cdm B2) $;

--| Equality deduction for domain. (Contributed by NM, 4-Mar-2004.)
theorem dmeqd (ph: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cdm A2) (cdm B2)) $;

--| Membership of first of an ordered pair in a domain. Deduction version of ~ opeldm . (Contributed by AV, 11-Mar-2021.)
theorem opeldmd (ph: wff) (A2 B2 C V W: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wi (wcel (cop A2 B2) C) (wcel A2 (cdm C))) $;

--| Membership of first of an ordered pair in a domain. (Contributed by NM, 30-Jul-1995.)
theorem opeldm (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wcel (cop A2 B2) C) (wcel A2 (cdm C)) $;

--| Membership of first of a binary relation in a domain. (Contributed by NM, 30-Jul-1995.)
theorem breldm (A2 B2 R: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wbr A2 B2 R) (wcel A2 (cdm R)) $;

--| Membership of first of a binary relation in a domain. (Contributed by NM, 21-Mar-2007.)
theorem breldmg (A2 B2 C D R: class):
  $ wi (w3a (wcel A2 C) (wcel B2 D) (wbr A2 B2 R)) (wcel A2 (cdm R)) $;

--| The domain of a union is the union of domains. Exercise 56(a) of [Enderton] p. 65. (Contributed by NM, 12-Aug-1994.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem dmun (A2 B2: class):
  $ wceq (cdm (cun A2 B2)) (cun (cdm A2) (cdm B2)) $;

--| The domain of an intersection is included in the intersection of the domains. Theorem 6 of [Suppes] p. 60. (Contributed by NM, 15-Sep-2004.)
theorem dmin (A2 B2: class):
  $ wss (cdm (cin A2 B2)) (cin (cdm A2) (cdm B2)) $;

--| Membership of first of a binary relation in a domain. (Contributed by Glauco Siliprandi, 23-Apr-2023.)
theorem breldmd (ph: wff) (A2 B2 C D R: class):
  $ wi ph (wcel A2 C) $ >
  $ wi ph (wcel B2 D) $ >
  $ wi ph (wbr A2 B2 R) $ >
  $ wi ph (wcel A2 (cdm R)) $;

--| The domain of an indexed union. (Contributed by Mario Carneiro, 26-Apr-2016.)
theorem dmiun {x3: setvar} (A2 B2: class x3):
  $ wceq (cdm (ciun x3 A2 B2)) (ciun x3 A2 (cdm B2)) $;

--| The domain of a union. Part of Exercise 8 of [Enderton] p. 41. (Contributed by NM, 3-Feb-2004.)
theorem dmuni {x3: setvar} (A2: class):
  $ wceq (cdm (cuni A2)) (ciun x3 A2 (cdm (cv x3))) $;

--| The domain of a class of ordered pairs. (Contributed by NM, 16-May-1995.) (Revised by Mario Carneiro, 4-Dec-2016.)
theorem dmopab {x3 y1: setvar} (ph: wff x3 y1):
  $ wceq (cdm (copab x3 y1 ph)) (cab x3 (wex y1 ph)) $;

--| A set is an element of the domain of an ordered pair class abstraction iff there is a second set so that both sets fulfil the wff of the class abstraction. (Contributed by AV, 19-Oct-2023.)
theorem dmopabelb {x3 y1: setvar} (ph: wff x3 y1) (ps: wff y1) (V: class x3 y1) (X: class):
  $ wi (wceq (cv x3) X) (wb ph ps) $ >
  $ wi (wcel X V) (wb (wcel X (cdm (copab x3 y1 ph))) (wex y1 ps)) $;

--| The domain of an ordered pair class abstraction with two nested restricted existential quantifiers. (Contributed by AV, 23-Oct-2023.)
theorem dmopab2rex {x3 y1 v u i: setvar} (A2: class v u i) (B2: class v u) (C D: class v u i) (U: class v u) (I: class v u i) (V: class v u) (W: class x3 y1 v u i) (X: class x3 y1 v u):
  $ wi (wral u (wa (wral v (wcel B2 X) V) (wral i (wcel D W) I)) U) (wceq (cdm (copab x3 y1 (wrex u (wo (wrex v (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) V) (wrex i (wa (wceq (cv x3) C) (wceq (cv y1) D)) I)) U))) (cab x3 (wrex u (wo (wrex v (wceq (cv x3) A2) V) (wrex i (wceq (cv x3) C) I)) U))) $;

--| Upper bound for the domain of a restricted class of ordered pairs. (Contributed by NM, 31-Jan-2004.)
theorem dmopabss {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wss (cdm (copab x3 y1 (wa (wcel (cv x3) A2) ph))) A2 $;

--| The domain of a restricted class of ordered pairs. (Contributed by NM, 31-Jan-2004.)
theorem dmopab3 {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wb (wral x3 (wex y1 ph) A2) (wceq (cdm (copab x3 y1 (wa (wcel (cv x3) A2) ph))) A2) $;

--| The domain of the empty set is empty. Part of Theorem 3.8(v) of [Monk1] p. 36. (Contributed by NM, 4-Jul-1994.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem dm0:
  $ wceq (cdm c0) c0 $;

--| The domain of the identity relation is the universe. (Contributed by NM, 30-Apr-1998.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem dmi:
  $ wceq (cdm cid) cvv $;

--| The domain of the universe is the universe. (Contributed by NM, 8-Aug-2003.)
theorem dmv:
  $ wceq (cdm cvv) cvv $;

--| The domain of the membership relation is the universal class. (Contributed by Scott Fenton, 27-Oct-2010.) (Proof shortened by BJ, 26-Dec-2023.)
theorem dmep:
  $ wceq (cdm cep) cvv $;

--| An empty domain is equivalent to an empty range. (Contributed by NM, 21-May-1998.) Avoid ~ ax-10 , ~ ax-11 , ~ ax-12 . (Revised by TM, 24-Jan-2026.)
theorem dm0rn0 (A2: class):
  $ wb (wceq (cdm A2) c0) (wceq (crn A2) c0) $;

--| Obsolete version of ~ dm0rn0 as of 24-Jan-2026. (Contributed by NM, 21-May-1998.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem dm0rn0OLD (A2: class):
  $ wb (wceq (cdm A2) c0) (wceq (crn A2) c0) $;

--| The range of the empty set is empty. Part of Theorem 3.8(v) of [Monk1] p. 36. (Contributed by NM, 4-Jul-1994.)
theorem rn0:
  $ wceq (crn c0) c0 $;

--| The range of the membership relation is the universal class minus the empty set. (Contributed by BJ, 26-Dec-2023.)
theorem rnep:
  $ wceq (crn cep) (cdif cvv (csn c0)) $;

--| A relation is empty iff its domain is empty. (Contributed by NM, 15-Sep-2004.)
theorem reldm0 (A2: class):
  $ wi (wrel A2) (wb (wceq A2 c0) (wceq (cdm A2) c0)) $;

--| The domain of a Cartesian product. Part of Theorem 3.13(x) of [Monk1] p. 37. (Contributed by NM, 28-Jul-1995.) (Proof shortened by Andrew Salmon, 27-Aug-2011.) Avoid ~ ax-10 , ~ ax-11 , ~ ax-12 . (Revised by SN, 12-Aug-2025.)
theorem dmxp (A2 B2: class):
  $ wi (wne B2 c0) (wceq (cdm (cxp A2 B2)) A2) $;

--| The domain of a Cartesian square. (Contributed by NM, 28-Jul-1995.)
theorem dmxpid (A2: class):
  $ wceq (cdm (cxp A2 A2)) A2 $;

--| The domain of the intersection of two Cartesian squares. Unlike in ~ dmin , equality holds. (Contributed by NM, 29-Jan-2008.)
theorem dmxpin (A2 B2: class):
  $ wceq (cdm (cin (cxp A2 A2) (cxp B2 B2))) (cin A2 B2) $;

--| The Cartesian square is a one-to-one construction. (Contributed by NM, 5-Nov-2006.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem xpid11 (A2 B2: class):
  $ wb (wceq (cxp A2 A2) (cxp B2 B2)) (wceq A2 B2) $;

--| The domain of the double converse of a class is equal to its domain (even when that class in not a relation, in which case ~ dfrel2 gives another proof). (Contributed by NM, 8-Apr-2007.)
theorem dmcnvcnv (A2: class):
  $ wceq (cdm (ccnv (ccnv A2))) (cdm A2) $;

--| The range of the double converse of a class is equal to its range (even when that class in not a relation). (Contributed by NM, 8-Apr-2007.)
theorem rncnvcnv (A2: class):
  $ wceq (crn (ccnv (ccnv A2))) (crn A2) $;

--| The first member of an ordered pair in a relation belongs to the domain of the relation (see ~ op1stb ). (Contributed by NM, 28-Jul-2004.)
theorem elreldm (A2 B2: class):
  $ wi (wa (wrel A2) (wcel B2 A2)) (wcel (cint (cint B2)) (cdm A2)) $;

--| Equality theorem for range. (Contributed by NM, 29-Dec-1996.)
theorem rneq (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (crn A2) (crn B2)) $;

--| Equality inference for range. (Contributed by NM, 4-Mar-2004.)
theorem rneqi (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wceq (crn A2) (crn B2) $;

--| Equality deduction for range. (Contributed by NM, 4-Mar-2004.)
theorem rneqd (ph: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (crn A2) (crn B2)) $;

--| Subset theorem for range. (Contributed by NM, 22-Mar-1998.)
theorem rnss (A2 B2: class):
  $ wi (wss A2 B2) (wss (crn A2) (crn B2)) $;

--| Subclass inference for range. (Contributed by Peter Mazsa, 24-Sep-2022.)
theorem rnssi (A2 B2: class):
  $ wss A2 B2 $ >
  $ wss (crn A2) (crn B2) $;

--| The second argument of a binary relation belongs to its range. (Contributed by NM, 29-Jun-2008.)
theorem brelrng (A2 B2 C F G: class):
  $ wi (w3a (wcel A2 F) (wcel B2 G) (wbr A2 B2 C)) (wcel B2 (crn C)) $;

--| The second argument of a binary relation belongs to its range. (Contributed by NM, 13-Aug-2004.)
theorem brelrn (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wbr A2 B2 C) (wcel B2 (crn C)) $;

--| Membership of second member of an ordered pair in a range. (Contributed by NM, 23-Feb-1997.)
theorem opelrn (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wcel (cop A2 B2) C) (wcel B2 (crn C)) $;

--| The first argument of a binary relation belongs to its domain. Note that ` A R B ` does not imply ` Rel R ` : see for example ~ nrelv and ~ brv . (Contributed by NM, 2-Jul-2008.)
theorem releldm (A2 B2 R: class):
  $ wi (wa (wrel R) (wbr A2 B2 R)) (wcel A2 (cdm R)) $;

--| The second argument of a binary relation belongs to its range. (Contributed by NM, 2-Jul-2008.)
theorem relelrn (A2 B2 R: class):
  $ wi (wa (wrel R) (wbr A2 B2 R)) (wcel B2 (crn R)) $;

--| Membership in a domain. (Contributed by Mario Carneiro, 5-Nov-2015.)
theorem releldmb {x3: setvar} (A2 R: class):
  $ wi (wrel R) (wb (wcel A2 (cdm R)) (wex x3 (wbr A2 (cv x3) R))) $;

--| Membership in a range. (Contributed by Mario Carneiro, 5-Nov-2015.)
theorem relelrnb {x3: setvar} (A2 R: class):
  $ wi (wrel R) (wb (wcel A2 (crn R)) (wex x3 (wbr (cv x3) A2 R))) $;

--| The first argument of a binary relation belongs to its domain. (Contributed by NM, 28-Apr-2015.)
theorem releldmi (A2 B2 R: class):
  $ wrel R $ >
  $ wi (wbr A2 B2 R) (wcel A2 (cdm R)) $;

--| The second argument of a binary relation belongs to its range. (Contributed by NM, 28-Apr-2015.)
theorem relelrni (A2 B2 R: class):
  $ wrel R $ >
  $ wi (wbr A2 B2 R) (wcel B2 (crn R)) $;

--| Definition of range, using bound-variable hypotheses instead of distinct variable conditions. (Contributed by NM, 14-Aug-1995.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem dfrnf {x3 y1: setvar} (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wceq (crn A2) (cab y1 (wex x3 (wbr (cv x3) (cv y1) A2))) $;

--| Bound-variable hypothesis builder for domain. (Contributed by NM, 30-Jan-2004.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem nfdm {x3: setvar} (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 (cdm A2) $;

--| Bound-variable hypothesis builder for range. (Contributed by NM, 1-Sep-1999.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem nfrn {x3: setvar} (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 (crn A2) $;

--| Domain of an intersection. (Contributed by FL, 15-Oct-2012.)
theorem dmiin {x3: setvar} (A2 B2: class x3):
  $ wss (cdm (ciin x3 A2 B2)) (ciin x3 A2 (cdm B2)) $;

--| The range of a class of ordered pairs. (Contributed by NM, 14-Aug-1995.) (Revised by Mario Carneiro, 4-Dec-2016.)
theorem rnopab {x3 y1: setvar} (ph: wff x3 y1):
  $ wceq (crn (copab x3 y1 ph)) (cab y1 (wex x3 ph)) $;

--| Upper bound for the range of a restricted class of ordered pairs. (Contributed by Eric Schmidt, 16-Sep-2025.)
theorem rnopabss {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wss (crn (copab x3 y1 (wa (wcel (cv y1) A2) ph))) A2 $;

--| The range of a restricted class of ordered pairs. (Contributed by Eric Schmidt, 16-Sep-2025.)
theorem rnopab3 {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wb (wral y1 (wex x3 ph) A2) (wceq (crn (copab x3 y1 (wa (wcel (cv y1) A2) ph))) A2) $;

--| The range of a function in maps-to notation. (Contributed by Scott Fenton, 21-Mar-2011.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem rnmpt {x3 y1: setvar} (A2 B2: class x3) (F: class x3 y1):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wceq (crn F) (cab y1 (wrex x3 (wceq (cv y1) B2) A2)) $;

--| The range of a function in maps-to notation. (Contributed by Mario Carneiro, 20-Feb-2015.)
theorem elrnmpt {x3: setvar} (A2 B2: class x3) (C: class) (F V: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wcel C V) (wb (wcel C (crn F)) (wrex x3 (wceq C B2) A2)) $;

--| Elementhood in an image set. (Contributed by Mario Carneiro, 12-Sep-2015.)
theorem elrnmpt1s {x3: setvar} (A2: class) (B2: class x3) (C D: class) (F V: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wceq (cv x3) D) (wceq B2 C) $ >
  $ wi (wa (wcel D A2) (wcel C V)) (wcel C (crn F)) $;

--| Elementhood in an image set. (Contributed by Mario Carneiro, 31-Aug-2015.)
theorem elrnmpt1 {x3: setvar} (A2 B2 F V: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wa (wcel (cv x3) A2) (wcel B2 V)) (wcel B2 (crn F)) $;

--| Membership in the range of a function. (Contributed by NM, 27-Aug-2007.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem elrnmptg {x3: setvar} (A2 B2: class x3) (C: class) (F V: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wral x3 (wcel B2 V) A2) (wb (wcel C (crn F)) (wrex x3 (wceq C B2) A2)) $;

--| Membership in the range of a function. (Contributed by NM, 30-Aug-2004.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem elrnmpti {x3: setvar} (A2 B2: class x3) (C: class) (F: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wcel B2 cvv $ >
  $ wb (wcel C (crn F)) (wrex x3 (wceq C B2) A2) $;

--| The range of a function in maps-to notation. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem elrnmptd {x3: setvar} (ph: wff x3) (A2 B2: class x3) (C: class) (F V: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi ph (wrex x3 (wceq C B2) A2) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wcel C (crn F)) $;

--| Elementhood in an image set. Deducion version of ~ elrnmpt1 . (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem elrnmpt1d {x3: setvar} (ph: wff x3) (A2 B2 F V: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi ph (wcel (cv x3) A2) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wcel B2 (crn F)) $;

--| Elementhood in the range of a function in maps-to notation, deduction form. (Contributed by Rohan Ridenour, 3-Aug-2023.)
theorem elrnmptdv {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (C D: class) (F V: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi ph (wcel C A2) $ >
  $ wi ph (wcel D V) $ >
  $ wi (wa ph (wceq (cv x3) C)) (wceq D B2) $ >
  $ wi ph (wcel D (crn F)) $;

--| Elementhood in the range of a function in maps-to notation, deduction form. (Contributed by Rohan Ridenour, 3-Aug-2023.)
theorem elrnmpt2d {x3: setvar} (ph: wff x3) (A2 B2: class x3) (C: class) (F: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi ph (wcel C (crn F)) $ >
  $ wi ph (wrex x3 (wceq C B2) A2) $;

--| Non-membership in the range of a function in maps-to notation. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem nelrnmpt {x3: setvar} (ph: wff x3) (A2 B2: class x3) (C: class) (F V: class x3):
  $ wnf x3 ph $ >
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi ph (wcel C V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wne C B2) $ >
  $ wi ph (wn (wcel C (crn F))) $;

--| Alternate definition of indexed union when ` B ` is a set. (Contributed by Mario Carneiro, 31-Aug-2015.)
theorem dfiun3g {x3: setvar} (A2 B2 C: class x3):
  $ wi (wral x3 (wcel B2 C) A2) (wceq (ciun x3 A2 B2) (cuni (crn (cmpt x3 A2 B2)))) $;

--| Alternate definition of indexed intersection when ` B ` is a set. (Contributed by Mario Carneiro, 31-Aug-2015.)
theorem dfiin3g {x3: setvar} (A2 B2 C: class x3):
  $ wi (wral x3 (wcel B2 C) A2) (wceq (ciin x3 A2 B2) (cint (crn (cmpt x3 A2 B2)))) $;

--| Alternate definition of indexed union when ` B ` is a set. (Contributed by Mario Carneiro, 31-Aug-2015.)
theorem dfiun3 {x3: setvar} (A2 B2: class x3):
  $ wcel B2 cvv $ >
  $ wceq (ciun x3 A2 B2) (cuni (crn (cmpt x3 A2 B2))) $;

--| Alternate definition of indexed intersection when ` B ` is a set. (Contributed by Mario Carneiro, 31-Aug-2015.)
theorem dfiin3 {x3: setvar} (A2 B2: class x3):
  $ wcel B2 cvv $ >
  $ wceq (ciin x3 A2 B2) (cint (crn (cmpt x3 A2 B2))) $;

--| Express a relative indexed intersection as an intersection. (Contributed by Stefan O'Rear, 22-Feb-2015.)
theorem riinint {k: setvar} (S I: class k) (V X: class):
  $ wi (wa (wcel X V) (wral k (wss S X) I)) (wceq (cin X (ciin k I S)) (cint (cun (csn X) (crn (cmpt k I S))))) $;

--| A relation is empty iff its range is empty. (Contributed by NM, 15-Sep-2004.)
theorem relrn0 (A2: class):
  $ wi (wrel A2) (wb (wceq A2 c0) (wceq (crn A2) c0)) $;

--| The domain and range of a class are included in its double union. (Contributed by NM, 13-May-2008.)
theorem dmrnssfld (A2: class):
  $ wss (cun (cdm A2) (crn A2)) (cuni (cuni A2)) $;

--| Domain of a composition. Theorem 21 of [Suppes] p. 63. (Contributed by NM, 19-Mar-1998.) (Proof shortened by Andrew Salmon, 27-Aug-2011.) Avoid ~ ax-10 and ~ ax-12 . (Revised by TM, 31-Dec-2025.)
theorem dmcoss (A2 B2: class):
  $ wss (cdm (ccom A2 B2)) (cdm B2) $;

--| Obsolete version of ~ dmcosseq as of 31-Dec-2025. (Contributed by NM, 19-Mar-1998.) (Proof shortened by Andrew Salmon, 27-Aug-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem dmcossOLD (A2 B2: class):
  $ wss (cdm (ccom A2 B2)) (cdm B2) $;

--| Range of a composition. (Contributed by NM, 19-Mar-1998.)
theorem rncoss (A2 B2: class):
  $ wss (crn (ccom A2 B2)) (crn A2) $;

--| Domain of a composition. (Contributed by NM, 28-May-1998.) (Proof shortened by Andrew Salmon, 27-Aug-2011.) Avoid ~ ax-11 . (Revised by BTernaryTau, 23-Jun-2025.) Avoid ~ ax-10 and ~ ax-12 . (Revised by TM, 31-Dec-2025.)
theorem dmcosseq (A2 B2: class):
  $ wi (wss (crn B2) (cdm A2)) (wceq (cdm (ccom A2 B2)) (cdm B2)) $;

--| Obsolete version of ~ dmcosseq as of 31-Dec-2025. (Contributed by NM, 28-May-1998.) (Proof shortened by Andrew Salmon, 27-Aug-2011.) Avoid ~ ax-11 . (Revised by BTernaryTau, 23-Jun-2025.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem dmcosseqOLD (A2 B2: class):
  $ wi (wss (crn B2) (cdm A2)) (wceq (cdm (ccom A2 B2)) (cdm B2)) $;

--| Domain of a composition. (Contributed by NM, 19-Mar-1998.)
theorem dmcoeq (A2 B2: class):
  $ wi (wceq (cdm A2) (crn B2)) (wceq (cdm (ccom A2 B2)) (cdm B2)) $;

--| Range of a composition. (Contributed by NM, 19-Mar-1998.)
theorem rncoeq (A2 B2: class):
  $ wi (wceq (cdm A2) (crn B2)) (wceq (crn (ccom A2 B2)) (crn A2)) $;

--| Equality theorem for restrictions. (Contributed by NM, 7-Aug-1994.)
theorem reseq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cres A2 C) (cres B2 C)) $;

--| Equality theorem for restrictions. (Contributed by NM, 8-Aug-1994.)
theorem reseq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cres C A2) (cres C B2)) $;

--| Equality inference for restrictions. (Contributed by NM, 21-Oct-2014.)
theorem reseq1i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cres A2 C) (cres B2 C) $;

--| Equality inference for restrictions. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem reseq2i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cres C A2) (cres C B2) $;

--| Equality inference for restrictions. (Contributed by NM, 21-Oct-2014.)
theorem reseq12i (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq C D $ >
  $ wceq (cres A2 C) (cres B2 D) $;

--| Equality deduction for restrictions. (Contributed by NM, 21-Oct-2014.)
theorem reseq1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cres A2 C) (cres B2 C)) $;

--| Equality deduction for restrictions. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem reseq2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cres C A2) (cres C B2)) $;

--| Equality deduction for restrictions. (Contributed by NM, 21-Oct-2014.)
theorem reseq12d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq (cres A2 C) (cres B2 D)) $;

--| Bound-variable hypothesis builder for restriction. (Contributed by NM, 15-Sep-2003.) (Revised by David Abernethy, 19-Jun-2012.)
theorem nfres {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 (cres A2 B2) $;

--| Distribute proper substitution through the restriction of a class. (Contributed by Alan Sare, 10-Nov-2012.) (Revised by NM, 23-Aug-2018.)
theorem csbres {x3: setvar} (A2 B2 C: class x3):
  $ wceq (csb x3 A2 (cres B2 C)) (cres (csb x3 A2 B2) (csb x3 A2 C)) $;

--| A restriction to the empty set is empty. (Contributed by NM, 12-Nov-1994.)
theorem res0 (A2: class):
  $ wceq (cres A2 c0) c0 $;

--| Alternate definition of restriction. (Contributed by Scott Fenton, 17-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem dfres3 (A2 B2: class):
  $ wceq (cres A2 B2) (cin A2 (cxp B2 (crn A2))) $;

--| Ordered pair elementhood in a restriction. Exercise 13 of [TakeutiZaring] p. 25. (Contributed by NM, 13-Nov-1995.) (Revised by BJ, 18-Feb-2022.) Commute the consequent. (Revised by Peter Mazsa, 24-Sep-2022.)
theorem opelres (A2 B2 C R V: class):
  $ wi (wcel C V) (wb (wcel (cop B2 C) (cres R A2)) (wa (wcel B2 A2) (wcel (cop B2 C) R))) $;

--| Binary relation on a restriction. (Contributed by Mario Carneiro, 4-Nov-2015.) Commute the consequent. (Revised by Peter Mazsa, 24-Sep-2022.)
theorem brres (A2 B2 C R V: class):
  $ wi (wcel C V) (wb (wbr B2 C (cres R A2)) (wa (wcel B2 A2) (wbr B2 C R))) $;

--| Ordered pair membership in a restriction. Exercise 13 of [TakeutiZaring] p. 25. (Contributed by NM, 13-Nov-1995.)
theorem opelresi (A2 B2 C R: class):
  $ wcel C cvv $ >
  $ wb (wcel (cop B2 C) (cres R A2)) (wa (wcel B2 A2) (wcel (cop B2 C) R)) $;

--| Binary relation on a restriction. (Contributed by NM, 12-Dec-2006.)
theorem brresi (A2 B2 C R: class):
  $ wcel C cvv $ >
  $ wb (wbr B2 C (cres R A2)) (wa (wcel B2 A2) (wbr B2 C R)) $;

--| Ordered pair membership in a restriction when the first member belongs to the restricting class. (Contributed by NM, 30-Apr-2004.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem opres (A2 B2 C D: class):
  $ wcel B2 cvv $ >
  $ wi (wcel A2 D) (wb (wcel (cop A2 B2) (cres C D)) (wcel (cop A2 B2) C)) $;

--| A restricted identity relation is equivalent to equality in its domain. (Contributed by NM, 30-Apr-2004.)
theorem resieq (A2 B2 C: class):
  $ wi (wa (wcel B2 A2) (wcel C A2)) (wb (wbr B2 C (cres cid A2)) (wceq B2 C)) $;

--| ` <. A , A >. ` belongs to a restriction of the identity class iff ` A ` belongs to the restricting class. (Contributed by FL, 27-Oct-2008.) (Revised by NM, 30-Mar-2016.)
theorem opelidres (A2 B2 V: class):
  $ wi (wcel A2 V) (wb (wcel (cop A2 A2) (cres cid B2)) (wcel A2 B2)) $;

--| The restriction of a restriction. (Contributed by NM, 27-Mar-2008.)
theorem resres (A2 B2 C: class):
  $ wceq (cres (cres A2 B2) C) (cres A2 (cin B2 C)) $;

--| Distributive law for restriction over union. Theorem 31 of [Suppes] p. 65. (Contributed by NM, 30-Sep-2002.)
theorem resundi (A2 B2 C: class):
  $ wceq (cres A2 (cun B2 C)) (cun (cres A2 B2) (cres A2 C)) $;

--| Distributive law for restriction over union. (Contributed by NM, 23-Sep-2004.)
theorem resundir (A2 B2 C: class):
  $ wceq (cres (cun A2 B2) C) (cun (cres A2 C) (cres B2 C)) $;

--| Class restriction distributes over intersection. (Contributed by FL, 6-Oct-2008.)
theorem resindi (A2 B2 C: class):
  $ wceq (cres A2 (cin B2 C)) (cin (cres A2 B2) (cres A2 C)) $;

--| Class restriction distributes over intersection. (Contributed by NM, 18-Dec-2008.)
theorem resindir (A2 B2 C: class):
  $ wceq (cres (cin A2 B2) C) (cin (cres A2 C) (cres B2 C)) $;

--| Move intersection into class restriction. (Contributed by NM, 18-Dec-2008.)
theorem inres (A2 B2 C: class):
  $ wceq (cin A2 (cres B2 C)) (cres (cin A2 B2) C) $;

--| Commutative law for restriction and difference. (Contributed by AV, 7-Jun-2021.)
theorem resdifcom (A2 B2 C: class):
  $ wceq (cdif (cres A2 B2) C) (cres (cdif A2 C) B2) $;

--| Distribution of restriction over indexed union. (Contributed by Mario Carneiro, 29-May-2015.) (Proof shortened by JJ, 25-Aug-2021.)
theorem resiun1 {x3: setvar} (A2 B2: class x3) (C: class):
  $ wceq (cres (ciun x3 A2 B2) C) (ciun x3 A2 (cres B2 C)) $;

--| Distribution of restriction over indexed union. (Contributed by Mario Carneiro, 29-May-2015.)
theorem resiun2 {x3: setvar} (A2 B2: class x3) (C: class):
  $ wceq (cres C (ciun x3 A2 B2)) (ciun x3 A2 (cres C B2)) $;

--| A class includes its restriction. Exercise 15 of [TakeutiZaring] p. 25. (Contributed by NM, 2-Aug-1994.)
theorem resss (A2 B2: class):
  $ wss (cres A2 B2) A2 $;

--| Commutative law for restriction. (Contributed by NM, 27-Mar-1998.)
theorem rescom (A2 B2 C: class):
  $ wceq (cres (cres A2 B2) C) (cres (cres A2 C) B2) $;

--| Subclass theorem for restriction. (Contributed by NM, 16-Aug-1994.)
theorem ssres (A2 B2 C: class):
  $ wi (wss A2 B2) (wss (cres A2 C) (cres B2 C)) $;

--| Subclass theorem for restriction. (Contributed by NM, 22-Mar-1998.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem ssres2 (A2 B2 C: class):
  $ wi (wss A2 B2) (wss (cres C A2) (cres C B2)) $;

--| A restriction is a relation. Exercise 12 of [TakeutiZaring] p. 25. (Contributed by NM, 2-Aug-1994.) (Proof shortened by Andrew Salmon, 27-Aug-2011.) (Proof shortened by BJ, 16-Oct-2026.)
theorem relres (A2 B2: class):
  $ wrel (cres A2 B2) $;

--| Obsolete version of ~ relres as of 16-Oct-2026. (Contributed by NM, 2-Aug-1994.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem relresOLD (A2 B2: class):
  $ wrel (cres A2 B2) $;

--| Absorption law for restriction. Exercise 17 of [TakeutiZaring] p. 25. (Contributed by NM, 9-Aug-1994.)
theorem resabs1 (A2 B2 C: class):
  $ wi (wss B2 C) (wceq (cres (cres A2 C) B2) (cres A2 B2)) $;

--| Absorption law for restriction. (Contributed by Glauco Siliprandi, 2-Jan-2022.)
theorem resabs1i (A2 B2 C: class):
  $ wss B2 C $ >
  $ wceq (cres (cres A2 C) B2) (cres A2 B2) $;

--| Absorption law for restriction, deduction form. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem resabs1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wss B2 C) $ >
  $ wi ph (wceq (cres (cres A2 C) B2) (cres A2 B2)) $;

--| Absorption law for restriction. (Contributed by NM, 27-Mar-1998.)
theorem resabs2 (A2 B2 C: class):
  $ wi (wss B2 C) (wceq (cres (cres A2 B2) C) (cres A2 B2)) $;

--| Idempotent law for restriction. (Contributed by NM, 27-Mar-1998.)
theorem residm (A2 B2: class):
  $ wceq (cres (cres A2 B2) B2) (cres A2 B2) $;

--| The domain of a restriction is a subset of the original domain. (Contributed by Glauco Siliprandi, 23-Oct-2021.) Proof shortened and axiom usage reduced. (Proof shortened by AV, 15-May-2025.)
theorem dmresss (A2 B2: class):
  $ wss (cdm (cres A2 B2)) (cdm A2) $;

--| The domain of a restriction. Exercise 14 of [TakeutiZaring] p. 25. (Contributed by NM, 1-Aug-1994.)
theorem dmres (A2 B2: class):
  $ wceq (cdm (cres A2 B2)) (cin B2 (cdm A2)) $;

--| A domain restricted to a subclass equals the subclass. (Contributed by NM, 2-Mar-1997.)
theorem ssdmres (A2 B2: class):
  $ wb (wss A2 (cdm B2)) (wceq (cdm (cres B2 A2)) A2) $;

--| The domain of a restriction to a set exists. (Contributed by NM, 7-Apr-1995.)
theorem dmresexg (A2 B2 V: class):
  $ wi (wcel B2 V) (wcel (cdm (cres A2 B2)) cvv) $;

--| The range of a restriction is a subset of the whole range. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem rnresss (A2 B2: class):
  $ wss (crn (cres A2 B2)) (crn A2) $;

--| Restriction of a constant function (or other Cartesian product). (Contributed by Stefan O'Rear, 24-Jan-2015.)
theorem xpssres (A2 B2 C: class):
  $ wi (wss C A2) (wceq (cres (cxp A2 B2) C) (cxp C B2)) $;

--| Membership in an intersection with a Cartesian product. (Contributed by Peter Mazsa, 9-Sep-2022.)
theorem elinxp {x3 y1: setvar} (A2 B2 C R: class):
  $ wb (wcel C (cin R (cxp A2 B2))) (wrex x3 (wrex y1 (wa (wceq C (cop (cv x3) (cv y1))) (wcel (cop (cv x3) (cv y1)) R)) B2) A2) $;

--| Membership in a restriction. (Contributed by Scott Fenton, 17-Mar-2011.) (Proof shortened by Peter Mazsa, 9-Sep-2022.)
theorem elres {x3 y1: setvar} (A2 B2 C: class):
  $ wb (wcel A2 (cres B2 C)) (wrex x3 (wex y1 (wa (wceq A2 (cop (cv x3) (cv y1))) (wcel (cop (cv x3) (cv y1)) B2))) C) $;

--| Membership in restriction to a singleton. (Contributed by Scott Fenton, 17-Mar-2011.)
theorem elsnres {y1: setvar} (A2 B2 C: class):
  $ wcel C cvv $ >
  $ wb (wcel A2 (cres B2 (csn C))) (wex y1 (wa (wceq A2 (cop C (cv y1))) (wcel (cop C (cv y1)) B2))) $;

--| Simplification law for restriction. (Contributed by NM, 16-Aug-1994.)
theorem relssres (A2 B2: class):
  $ wi (wa (wrel A2) (wss (cdm A2) B2)) (wceq (cres A2 B2) A2) $;

--| The domain of a restriction to a singleton is a singleton. (Contributed by Alexander van der Vekens, 2-Jul-2017.)
theorem dmressnsn (A2 F: class):
  $ wi (wcel A2 (cdm F)) (wceq (cdm (cres F (csn A2))) (csn A2)) $;

--| The element of the domain of a restriction to a singleton is the element of the singleton. (Contributed by Alexander van der Vekens, 2-Jul-2017.)
theorem eldmressnsn (A2 F: class):
  $ wi (wcel A2 (cdm F)) (wcel A2 (cdm (cres F (csn A2)))) $;

--| An element of the domain (of a relation) is an element of the domain of the restriction (of the relation) to the singleton containing this element. (Contributed by Alexander van der Vekens, 22-Jul-2018.)
theorem eldmeldmressn (F X: class):
  $ wb (wcel X (cdm F)) (wcel X (cdm (cres F (csn X)))) $;

--| A relation restricted to its domain equals itself. (Contributed by NM, 12-Dec-2006.)
theorem resdm (A2: class):
  $ wi (wrel A2) (wceq (cres A2 (cdm A2)) A2) $;

--| The restriction of a set is a set. (Contributed by NM, 28-Mar-1998.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem resexg (A2 B2 V: class):
  $ wi (wcel A2 V) (wcel (cres A2 B2) cvv) $;

--| The restriction of a set is a set. (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem resexd (ph: wff) (A2 B2 V: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel (cres A2 B2) cvv) $;

--| The restriction of a set is a set. (Contributed by Jeff Madsen, 19-Jun-2011.)
theorem resex (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel (cres A2 B2) cvv $;

--| When restricting a class, intersecting with the domain of the class has no effect. (Contributed by FL, 6-Oct-2008.) Remove antecedent. (Revised by Eric Schmidt, 16-Jun-2026.)
theorem resindm (A2 B2: class):
  $ wceq (cres A2 (cin B2 (cdm A2))) (cres A2 B2) $;

--| Obsolete version of ~ resindm as of 16-Jun-2026. (Contributed by FL, 6-Oct-2008.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem resindmOLD (A2 B2: class):
  $ wi (wrel A2) (wceq (cres A2 (cin B2 (cdm A2))) (cres A2 B2)) $;

--| Restricting a class to its domain without a set is the same as restricting the class to the universe without this set. (Contributed by AV, 2-Dec-2018.) Remove antecedent. (Revised by Eric Schmidt, 16-Jun-2026.)
theorem resdmdfsn (R X: class):
  $ wceq (cres R (cdif cvv (csn X))) (cres R (cdif (cdm R) (csn X))) $;

--| Obsolete version of ~ resdmdfsn as of 16-Jun-2026. (Contributed by AV, 2-Dec-2018.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem resdmdfsnOLD (R X: class):
  $ wi (wrel R) (wceq (cres R (cdif cvv (csn X))) (cres R (cdif (cdm R) (csn X)))) $;

--| Split a relation into two parts based on its domain. (Contributed by Thierry Arnoux, 9-Oct-2023.) Remove requirement that ` A ` and ` B ` are disjoint. (Revised by Eric Schmidt, 20-Jun-2026.)
theorem reldmun (A2 B2 R: class):
  $ wi (wa (wrel R) (wceq (cdm R) (cun A2 B2))) (wceq R (cun (cres R A2) (cres R B2))) $;

--| Obsolete version of ~ reldmun as of 20-Jun-2026. (Contributed by Thierry Arnoux, 9-Oct-2023.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem reldisjunOLD (A2 B2 R: class):
  $ wi (w3a (wrel R) (wceq (cdm R) (cun A2 B2)) (wceq (cin A2 B2) c0)) (wceq R (cun (cres R A2) (cres R B2))) $;

--| Restriction of a disjoint union to the domain of the first term. (Contributed by Thierry Arnoux, 9-Dec-2021.)
theorem relresdm1 (A2 B2: class):
  $ wi (wa (wrel A2) (wceq (cin (cdm A2) (cdm B2)) c0)) (wceq (cres (cun A2 B2) (cdm A2)) A2) $;

--| Restriction of a class abstraction of ordered pairs. (Contributed by NM, 5-Nov-2002.)
theorem resopab {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wceq (cres (copab x3 y1 ph) A2) (copab x3 y1 (wa (wcel (cv x3) A2) ph)) $;

--| A subclass of the identity function is the identity function restricted to its domain. (Contributed by NM, 13-Dec-2003.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem iss (A2: class):
  $ wb (wss A2 cid) (wceq A2 (cres cid (cdm A2))) $;

--| Restriction of a class abstraction of ordered pairs. (Contributed by NM, 24-Aug-2007.)
theorem resopab2 {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class):
  $ wi (wss A2 B2) (wceq (cres (copab x3 y1 (wa (wcel (cv x3) B2) ph)) A2) (copab x3 y1 (wa (wcel (cv x3) A2) ph))) $;

--| Restriction of the mapping operation. (Contributed by Mario Carneiro, 15-Jul-2013.)
theorem resmpt {x3: setvar} (A2 B2: class) (C: class x3):
  $ wi (wss B2 A2) (wceq (cres (cmpt x3 A2 C) B2) (cmpt x3 B2 C)) $;

--| Unconditional restriction of the mapping operation. (Contributed by Stefan O'Rear, 24-Jan-2015.) (Proof shortened by Mario Carneiro, 22-Mar-2015.)
theorem resmpt3 {x3: setvar} (A2 B2: class) (C: class x3):
  $ wceq (cres (cmpt x3 A2 C) B2) (cmpt x3 (cin A2 B2) C) $;

--| Restriction of the mapping operation. (Contributed by Thierry Arnoux, 28-Mar-2017.)
theorem resmptf {x3: setvar} (A2 B2 C: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wi (wss B2 A2) (wceq (cres (cmpt x3 A2 C) B2) (cmpt x3 B2 C)) $;

--| Restriction of the mapping operation, deduction form. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem resmptd {x3: setvar} (ph: wff x3) (A2 B2: class) (C: class x3):
  $ wi ph (wss B2 A2) $ >
  $ wi ph (wceq (cres (cmpt x3 A2 C) B2) (cmpt x3 B2 C)) $;

--| Alternate definition of the restriction operation. (Contributed by Mario Carneiro, 5-Nov-2013.)
theorem dfres2 {x3 y1: setvar} (A2 R: class):
  $ wceq (cres R A2) (copab x3 y1 (wa (wcel (cv x3) A2) (wbr (cv x3) (cv y1) R))) $;

--| Sufficient condition for inclusion among two functions in maps-to notation. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem mptss {x3: setvar} (A2 B2: class) (C: class x3):
  $ wi (wss A2 B2) (wss (cmpt x3 A2 C) (cmpt x3 B2 C)) $;

--| Membership in the image of a mapping. (Contributed by Thierry Arnoux, 3-Jan-2022.)
theorem elimampt {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3) (C D: class) (F W: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi ph (wcel C W) $ >
  $ wi ph (wss D A2) $ >
  $ wi ph (wb (wcel C (cima F D)) (wrex x3 (wceq C B2) D)) $;

--| Characterization of the elements of the intersection of the identity relation with a Cartesian product. (Contributed by Peter Mazsa, 9-Sep-2022.)
theorem elidinxp {x3: setvar} (A2 B2 C: class):
  $ wb (wcel C (cin cid (cxp A2 B2))) (wrex x3 (wceq C (cop (cv x3) (cv x3))) (cin A2 B2)) $;

--| Characterization of the elements of the intersection of the identity relation with a Cartesian square. (Contributed by Peter Mazsa, 9-Sep-2022.)
theorem elidinxpid {x3: setvar} (A2 B2: class):
  $ wb (wcel B2 (cin cid (cxp A2 A2))) (wrex x3 (wceq B2 (cop (cv x3) (cv x3))) A2) $;

--| Characterization of the elements of a restricted identity relation. (Contributed by BJ, 28-Aug-2022.) (Proof shortened by Peter Mazsa, 9-Sep-2022.)
theorem elrid {x3: setvar} (A2 X: class):
  $ wb (wcel A2 (cres cid X)) (wrex x3 (wceq A2 (cop (cv x3) (cv x3))) X) $;

--| The intersection of the identity relation with a cartesian product is the restriction of the identity relation to the intersection of the factors. (Contributed by FL, 2-Aug-2009.) (Proof shortened by Peter Mazsa, 9-Sep-2022.) Generalize statement from cartesian square (now ~ idinxpresid ) to cartesian product. (Revised by BJ, 23-Dec-2023.)
theorem idinxpres (A2 B2: class):
  $ wceq (cin cid (cxp A2 B2)) (cres cid (cin A2 B2)) $;

--| The intersection of the identity relation with the cartesian square of a class is the restriction of the identity relation to that class. (Contributed by FL, 2-Aug-2009.) (Proof shortened by Peter Mazsa, 9-Sep-2022.) (Proof shortened by BJ, 23-Dec-2023.)
theorem idinxpresid (A2: class):
  $ wceq (cin cid (cxp A2 A2)) (cres cid A2) $;

--| A diagonal set as a subset of a Cartesian square. (Contributed by Thierry Arnoux, 29-Dec-2019.) (Proof shortened by BJ, 9-Sep-2022.)
theorem idssxp (A2: class):
  $ wss (cres cid A2) (cxp A2 A2) $;

--| The restricted identity relation expressed as an ordered-pair class abstraction. (Contributed by FL, 25-Apr-2012.)
theorem opabresid {x3 y1: setvar} (A2: class):
  $ wceq (cres cid A2) (copab x3 y1 (wa (wcel (cv x3) A2) (wceq (cv y1) (cv x3)))) $;

--| The restricted identity relation expressed in maps-to notation. (Contributed by FL, 25-Apr-2012.)
theorem mptresid {x3: setvar} (A2: class):
  $ wceq (cres cid A2) (cmpt x3 A2 (cv x3)) $;

--| The domain of a restricted identity function. (Contributed by NM, 27-Aug-2004.)
theorem dmresi (A2: class):
  $ wceq (cdm (cres cid A2)) A2 $;

--| Restriction of the identity to a singleton. (Contributed by FL, 2-Aug-2009.) (Proof shortened by JJ, 25-Aug-2021.) (Proof shortened by Peter Mazsa, 6-Oct-2022.)
theorem restidsing (A2: class):
  $ wceq (cres cid (csn A2)) (cxp (csn A2) (csn A2)) $;

--| The identity function restricted to a class ` A ` is empty iff the class ` A ` is empty. (Contributed by AV, 30-Jan-2024.)
theorem iresn0n0 (A2: class):
  $ wb (wceq A2 c0) (wceq (cres cid A2) c0) $;

--| Equality theorem for image. (Contributed by NM, 14-Aug-1994.)
theorem imaeq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cima A2 C) (cima B2 C)) $;

--| Equality theorem for image. (Contributed by NM, 14-Aug-1994.)
theorem imaeq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cima C A2) (cima C B2)) $;

--| Equality theorem for image. (Contributed by NM, 21-Dec-2008.)
theorem imaeq1i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cima A2 C) (cima B2 C) $;

--| Equality theorem for image. (Contributed by NM, 21-Dec-2008.)
theorem imaeq2i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cima C A2) (cima C B2) $;

--| Equality theorem for image. (Contributed by FL, 15-Dec-2006.)
theorem imaeq1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cima A2 C) (cima B2 C)) $;

--| Equality theorem for image. (Contributed by FL, 15-Dec-2006.)
theorem imaeq2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cima C A2) (cima C B2)) $;

--| Equality theorem for image. (Contributed by Mario Carneiro, 4-Dec-2016.)
theorem imaeq12d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq (cima A2 C) (cima B2 D)) $;

--| Subset theorem for image. (Contributed by NM, 16-Mar-2004.)
theorem imass1 (A2 B2 C: class):
  $ wi (wss A2 B2) (wss (cima A2 C) (cima B2 C)) $;

--| Subset theorem for image. Exercise 22(a) of [Enderton] p. 53. (Contributed by NM, 22-Mar-1998.)
theorem imass2 (A2 B2 C: class):
  $ wi (wss A2 B2) (wss (cima C A2) (cima C B2)) $;

--| A restriction to an image. (Contributed by NM, 29-Sep-2004.)
theorem resima (A2 B2: class):
  $ wceq (cima (cres A2 B2) B2) (cima A2 B2) $;

--| Image under a restricted class. (Contributed by FL, 31-Aug-2009.) (Proof shortened by JJ, 25-Aug-2021.)
theorem resima2 (A2 B2 C: class):
  $ wi (wss B2 C) (wceq (cima (cres A2 C) B2) (cima A2 B2)) $;

--| Alternate definition of image. Compare definition (d) of [Enderton] p. 44. (Contributed by NM, 19-Apr-2004.) (Proof shortened by Andrew Salmon, 27-Aug-2011.) (Proof shortened by Peter Mazsa, 2-Oct-2022.)
theorem dfima2 {x3 y1: setvar} (A2 B2: class):
  $ wceq (cima A2 B2) (cab y1 (wrex x3 (wbr (cv x3) (cv y1) A2) B2)) $;

--| Alternate definition of image. Compare definition (d) of [Enderton] p. 44. (Contributed by NM, 14-Aug-1994.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem dfima3 {x3 y1: setvar} (A2 B2: class):
  $ wceq (cima A2 B2) (cab y1 (wex x3 (wa (wcel (cv x3) B2) (wcel (cop (cv x3) (cv y1)) A2)))) $;

--| Membership in an image. Theorem 34 of [Suppes] p. 65. (Contributed by NM, 20-Jan-2007.)
theorem elimag {x3: setvar} (A2 B2 C: class) (V: class x3):
  $ wi (wcel A2 V) (wb (wcel A2 (cima B2 C)) (wrex x3 (wbr (cv x3) A2 B2) C)) $;

--| Membership in an image. Theorem 34 of [Suppes] p. 65. (Contributed by NM, 19-Apr-2004.)
theorem elima {x3: setvar} (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 (cima B2 C)) (wrex x3 (wbr (cv x3) A2 B2) C) $;

--| Membership in an image. Theorem 34 of [Suppes] p. 65. (Contributed by NM, 11-Aug-2004.)
theorem elima2 {x3: setvar} (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 (cima B2 C)) (wex x3 (wa (wcel (cv x3) C) (wbr (cv x3) A2 B2))) $;

--| Membership in an image. Theorem 34 of [Suppes] p. 65. (Contributed by NM, 14-Aug-1994.)
theorem elima3 {x3: setvar} (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 (cima B2 C)) (wex x3 (wa (wcel (cv x3) C) (wcel (cop (cv x3) A2) B2))) $;

--| Bound-variable hypothesis builder for image. (Contributed by NM, 30-Dec-1996.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem nfima {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 (cima A2 B2) $;

--| Deduction version of bound-variable hypothesis builder ~ nfima . (Contributed by FL, 15-Dec-2006.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem nfimad {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 B2) $ >
  $ wi ph (wnfc x3 (cima A2 B2)) $;

--| The range is equal to the image of any class including the domain. (Contributed by BJ, 27-Sep-2026.)
theorem dfrn7 (A2 B2: class):
  $ wi (wss (cdm A2) B2) (wceq (crn A2) (cima A2 B2)) $;

--| The image of the domain of a class is equal to its range. (Contributed by NM, 14-Aug-1994.) (Proof shortened by BJ, 27-Sep-2026.)
theorem imadmrn (A2: class):
  $ wceq (cima A2 (cdm A2)) (crn A2) $;

--| Obsolete version of ~ imadmrn as of 27-Sep-2026. (Contributed by NM, 14-Aug-1994.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem imadmrnOLD (A2: class):
  $ wceq (cima A2 (cdm A2)) (crn A2) $;

--| Obsolete version of ~ imassrn as of 27-Sep-2026. (Contributed by NM, 31-Mar-1995.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem imassrnOLD (A2 B2: class):
  $ wss (cima A2 B2) (crn A2) $;

--| Image by a function in maps-to notation. (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem mptima {x3: setvar} (A2: class) (B2: class x3) (C: class):
  $ wceq (cima (cmpt x3 A2 B2) C) (crn (cmpt x3 (cin A2 C) B2)) $;

--| Image by a function in maps-to notation of a subset of the domain. (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem mptimass {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3) (C: class):
  $ wi ph (wss C A2) $ >
  $ wi ph (wceq (cima (cmpt x3 A2 B2) C) (crn (cmpt x3 C B2))) $;

--| Image by the identity relation. Theorem 3.16(viii) of [Monk1] p. 38. (Contributed by NM, 30-Apr-1998.)
theorem imai (A2: class):
  $ wceq (cima cid A2) A2 $;

--| The range of the restricted identity function. (Contributed by NM, 27-Aug-2004.)
theorem rnresi (A2: class):
  $ wceq (crn (cres cid A2)) A2 $;

--| The image of a restriction of the identity function. (Contributed by FL, 31-Dec-2006.)
theorem resiima (A2 B2: class):
  $ wi (wss B2 A2) (wceq (cima (cres cid A2) B2) B2) $;

--| Image of the empty set. Theorem 3.16(ii) of [Monk1] p. 38. (Contributed by NM, 20-May-1998.)
theorem ima0 (A2: class):
  $ wceq (cima A2 c0) c0 $;

--| Move class substitution in and out of the image of a function. (Contributed by FL, 15-Dec-2006.) (Revised by NM, 20-Aug-2018.)
theorem csbima12 {x3: setvar} (A2 B2 F: class x3):
  $ wceq (csb x3 A2 (cima F B2)) (cima (csb x3 A2 F) (csb x3 A2 B2)) $;

--| A class whose image under another is empty is disjoint with the other's domain. (Contributed by FL, 24-Jan-2007.)
theorem imadisj (A2 B2: class):
  $ wb (wceq (cima A2 B2) c0) (wceq (cin (cdm A2) B2) c0) $;

--| Deduction form of one negated side of ~ imadisj . (Contributed by Stanislas Polu, 9-Mar-2020.)
theorem imadisjlnd (ph: wff) (A2 B2: class):
  $ wi ph (wne (cin (cdm A2) B2) c0) $ >
  $ wi ph (wne (cima A2 B2) c0) $;

--| The preimage of a superset of the range of a class is equal to the domain of the class. Generalization of ~ cnvimarndm to supersets of the range. (Contributed by AV, 18-Sep-2024.) (Proof shortened by BJ, 29-Sep-2026.)
theorem cnvimassrndm (A2 F: class):
  $ wi (wss (crn F) A2) (wceq (cima (ccnv F) A2) (cdm F)) $;

--| The preimage of the range of a class is equal to the domain of the class. (Contributed by Jeff Hankins, 15-Jul-2009.) (Proof shortened by BJ, 29-Sep-2026.)
theorem cnvimarndm (A2: class):
  $ wceq (cima (ccnv A2) (crn A2)) (cdm A2) $;

--| Obsolete version of ~ cnvimarndm as of 29-Sep-2026. (Contributed by Jeff Hankins, 15-Jul-2009.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem cnvimarndmOLD (A2: class):
  $ wceq (cima (ccnv A2) (crn A2)) (cdm A2) $;

--| The image of a singleton. (Contributed by NM, 8-May-2005.)
theorem imasng {y1: setvar} (A2: class) (B2: class y1) (R: class):
  $ wi (wcel A2 B2) (wceq (cima R (csn A2)) (cab y1 (wbr A2 (cv y1) R))) $;

--| The image of a singleton. (Contributed by NM, 20-May-1998.)
theorem relimasn {y1: setvar} (A2 R: class):
  $ wi (wrel R) (wceq (cima R (csn A2)) (cab y1 (wbr A2 (cv y1) R))) $;

--| Elementhood in the image of a singleton. (Contributed by Mario Carneiro, 3-Nov-2015.)
theorem elrelimasn (A2 B2 R: class):
  $ wi (wrel R) (wb (wcel B2 (cima R (csn A2))) (wbr A2 B2 R)) $;

--| Membership in an image of a singleton. (Contributed by Raph Levien, 21-Oct-2006.) Revise to use ~ df-br and to prove ~ elimasn1 from it. (Revised by BJ, 16-Oct-2024.)
theorem elimasng1 (A2 B2 C V W: class):
  $ wi (wa (wcel B2 V) (wcel C W)) (wb (wcel C (cima A2 (csn B2))) (wbr B2 C A2)) $;

--| Membership in an image of a singleton. (Contributed by NM, 15-Mar-2004.) (Proof shortened by Andrew Salmon, 27-Aug-2011.) Use ~ df-br and shorten proof. (Revised by BJ, 16-Oct-2024.)
theorem elimasn1 (A2 B2 C: class):
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wb (wcel C (cima A2 (csn B2))) (wbr B2 C A2) $;

--| Membership in an image of a singleton. (Contributed by Raph Levien, 21-Oct-2006.) TODO: replace existing usages by usages of ~ elimasng1 , remove, and relabel ~ elimasng1 to "elimasng".
theorem elimasng (A2 B2 C V W: class):
  $ wi (wa (wcel B2 V) (wcel C W)) (wb (wcel C (cima A2 (csn B2))) (wcel (cop B2 C) A2)) $;

--| Membership in an image of a singleton. (Contributed by NM, 15-Mar-2004.) (Proof shortened by Andrew Salmon, 27-Aug-2011.) (Proof shortened by BJ, 16-Oct-2024.) TODO: replace existing usages by usages of ~ elimasn1 , remove, and relabel ~ elimasn1 to "elimasn".
theorem elimasn (A2 B2 C: class):
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wb (wcel C (cima A2 (csn B2))) (wcel (cop B2 C) A2) $;

--| Membership in an image of a singleton. (Contributed by NM, 5-Aug-2010.)
theorem elimasni (A2 B2 C: class):
  $ wi (wcel C (cima A2 (csn B2))) (wbr B2 C A2) $;

--| Two ways to express the class of unique-valued arguments of ` F ` , which is the same as the domain of ` F ` whenever ` F ` is a function. The left-hand side of the equality is from Definition 10.2 of [Quine] p. 65. Quine uses the notation "arg ` F ` " for this class (for which we have no separate notation). Observe the resemblance to the alternate definition ~ dffv4 of function value, which is based on the idea in Quine's definition. (Contributed by NM, 8-May-2005.)
theorem args {x3 y1: setvar} (F: class x3):
  $ wceq (cab x3 (wex y1 (wceq (cima F (csn (cv x3))) (csn (cv y1))))) (cab x3 (weu y1 (wbr (cv x3) (cv y1) F))) $;

--| Membership in the inverse image of a singleton. (Contributed by NM, 28-Apr-2004.) (Proof shortened by Andrew Salmon, 27-Aug-2011.) Put in closed form and shorten proof. (Revised by BJ, 16-Oct-2024.)
theorem elinisegg (A2 B2 C V W: class):
  $ wi (wa (wcel B2 V) (wcel C W)) (wb (wcel C (cima (ccnv A2) (csn B2))) (wbr C B2 A2)) $;

--| Membership in the inverse image of a singleton. An application is to express initial segments for an order relation. See for example Definition 6.21 of [TakeutiZaring] p. 30. (Contributed by NM, 28-Apr-2004.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem eliniseg (A2 B2 C V: class):
  $ wcel C cvv $ >
  $ wi (wcel B2 V) (wb (wcel C (cima (ccnv A2) (csn B2))) (wbr C B2 A2)) $;

--| Any set is equal to its preimage under the converse membership relation. (Contributed by Mario Carneiro, 9-Mar-2013.) Put in closed form. (Revised by BJ, 16-Oct-2024.)
theorem epin (A2 V: class):
  $ wi (wcel A2 V) (wceq (cima (ccnv cep) (csn A2)) A2) $;

--| Any set is equal to its preimage under the converse membership relation. (Contributed by Mario Carneiro, 9-Mar-2013.)
theorem epini (A2: class):
  $ wcel A2 cvv $ >
  $ wceq (cima (ccnv cep) (csn A2)) A2 $;

--| An idiom that signifies an initial segment of an ordering, used, for example, in Definition 6.21 of [TakeutiZaring] p. 30. (Contributed by NM, 28-Apr-2004.)
theorem iniseg {x3: setvar} (A2 B2: class) (V: class x3):
  $ wi (wcel B2 V) (wceq (cima (ccnv A2) (csn B2)) (cab x3 (wbr (cv x3) B2 A2))) $;

--| Nonemptiness of an initial segment in terms of range. (Contributed by Stefan O'Rear, 18-Jan-2015.)
theorem inisegn0 (A2 F: class):
  $ wb (wcel A2 (crn F)) (wne (cima (ccnv F) (csn A2)) c0) $;

--| Alternate definition of well-founded relation. Definition 6.21 of [TakeutiZaring] p. 30. (Contributed by NM, 23-Apr-2004.) (Revised by Mario Carneiro, 23-Jun-2015.)
theorem dffr3 {x3 y1: setvar} (A2 R: class):
  $ wb (wfr A2 R) (wal x3 (wi (wa (wss (cv x3) A2) (wne (cv x3) c0)) (wrex y1 (wceq (cin (cv x3) (cima (ccnv R) (csn (cv y1)))) c0) (cv x3)))) $;

--| Alternate definition of set-like relation. (Contributed by Mario Carneiro, 23-Jun-2015.)
theorem dfse2 {x3: setvar} (A2 R: class):
  $ wb (wse A2 R) (wral x3 (wcel (cin A2 (cima (ccnv R) (csn (cv x3)))) cvv) A2) $;

--| The image of a singleton outside the domain is empty. (Contributed by NM, 22-May-1998.) (Proof shortened by OpenAI, 3-Jul-2020.)
theorem ndmima (A2 B2: class):
  $ wi (wn (wcel A2 (cdm B2))) (wceq (cima B2 (csn A2)) c0) $;

--| A converse is a relation. Theorem 12 of [Suppes] p. 62. (Contributed by NM, 29-Oct-1996.)
theorem relcnv (A2: class):
  $ wrel (ccnv A2) $;

--| When ` R ` is a relation, the sethood assumptions on ~ brcnv can be omitted. (Contributed by Mario Carneiro, 28-Apr-2015.)
theorem relbrcnvg (A2 B2 R: class):
  $ wi (wrel R) (wb (wbr A2 B2 (ccnv R)) (wbr B2 A2 R)) $;

--| Eliminate the class existence constraint in ~ eliniseg . (Contributed by Mario Carneiro, 5-Dec-2014.) (Revised by Mario Carneiro, 17-Nov-2015.)
theorem eliniseg2 (A2 B2 C: class):
  $ wi (wrel A2) (wb (wcel C (cima (ccnv A2) (csn B2))) (wbr C B2 A2)) $;

--| When ` R ` is a relation, the sethood assumptions on ~ brcnv can be omitted. (Contributed by Mario Carneiro, 28-Apr-2015.)
theorem relbrcnv (A2 B2 R: class):
  $ wrel R $ >
  $ wb (wbr A2 B2 (ccnv R)) (wbr B2 A2 R) $;

--| A composition is a relation. Exercise 24 of [TakeutiZaring] p. 25. (Contributed by NM, 26-Jan-1997.)
theorem relco (A2 B2: class):
  $ wrel (ccom A2 B2) $;

--| Two ways of saying that the composition of two relations is included in a third relation. See its special instance ~ cotr for the main application. (Contributed by NM, 27-Dec-1996.) (Proof shortened by Andrew Salmon, 27-Aug-2011.) Generalized from its special instance ~ cotr . (Revised by Richard Penner, 24-Dec-2019.) (Proof shortened by SN, 19-Dec-2024.) Avoid ~ ax-11 . (Revised by BTernaryTau, 29-Dec-2024.)
theorem cotrg {x3 y1 z: setvar} (A2 B2 C: class):
  $ wb (wss (ccom A2 B2) C) (wal x3 (wal y1 (wal z (wi (wa (wbr (cv x3) (cv y1) B2) (wbr (cv y1) (cv z) A2)) (wbr (cv x3) (cv z) C))))) $;

--| Two ways of saying a relation is transitive. Definition of transitivity in [Schechter] p. 51. Special instance of ~ cotrg . (Contributed by NM, 27-Dec-1996.)
theorem cotr {x3 y1 z: setvar} (R: class):
  $ wb (wss (ccom R R) R) (wal x3 (wal y1 (wal z (wi (wa (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv z) R)) (wbr (cv x3) (cv z) R))))) $;

--| Alternate proof of ~ idref not relying on definitions related to functions. Two ways to state that a relation is reflexive on a class. (Contributed by FL, 15-Jan-2012.) (Proof shortened by Mario Carneiro, 3-Nov-2015.) (Revised by NM, 30-Mar-2016.) (Proof shortened by BJ, 28-Aug-2022.) The "proof modification is discouraged" tag is here only because this is an *ALT result. (Proof modification is discouraged.) (New usage is discouraged.)
theorem idrefALT {x3: setvar} (A2 R: class):
  $ wb (wss (cres cid A2) R) (wral x3 (wbr (cv x3) (cv x3) R) A2) $;

--| Two ways of saying a relation is symmetric. Similar to definition of symmetry in [Schechter] p. 51. (Contributed by NM, 28-Dec-1996.) (Proof shortened by Andrew Salmon, 27-Aug-2011.) (Proof shortened by SN, 23-Dec-2024.) Avoid ~ ax-11 . (Revised by BTernaryTau, 29-Dec-2024.)
theorem cnvsym {x3 y1: setvar} (R: class):
  $ wb (wss (ccnv R) R) (wal x3 (wal y1 (wi (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv x3) R)))) $;

--| Two ways of saying a relation is antisymmetric. Definition of antisymmetry in [Schechter] p. 51. (Contributed by NM, 9-Sep-2004.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem intasym {x3 y1: setvar} (R: class):
  $ wb (wss (cin R (ccnv R)) cid) (wal x3 (wal y1 (wi (wa (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv x3) R)) (wceq (cv x3) (cv y1))))) $;

--| Two ways of saying a relation is antisymmetric and reflexive. ` U. U. R ` is the field of a relation by ~ relfld . (Contributed by NM, 6-May-2008.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem asymref {x3 y1: setvar} (R: class):
  $ wb (wceq (cin R (ccnv R)) (cres cid (cuni (cuni R)))) (wral x3 (wal y1 (wb (wa (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv x3) R)) (wceq (cv x3) (cv y1)))) (cuni (cuni R))) $;

--| Two ways of saying a relation is antisymmetric and reflexive. (Contributed by NM, 6-May-2008.) (Proof shortened by Mario Carneiro, 4-Dec-2016.)
theorem asymref2 {x3 y1: setvar} (R: class):
  $ wb (wceq (cin R (ccnv R)) (cres cid (cuni (cuni R)))) (wa (wral x3 (wbr (cv x3) (cv x3) R) (cuni (cuni R))) (wal x3 (wal y1 (wi (wa (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv x3) R)) (wceq (cv x3) (cv y1)))))) $;

--| Two ways of saying a relation is irreflexive. Definition of irreflexivity in [Schechter] p. 51. (Contributed by NM, 9-Sep-2004.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem intirr {x3: setvar} (R: class):
  $ wb (wceq (cin R cid) c0) (wal x3 (wn (wbr (cv x3) (cv x3) R))) $;

--| Two ways of saying that two elements have an upper bound. (Contributed by Mario Carneiro, 3-Nov-2015.)
theorem brcodir {z: setvar} (A2 B2 R V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wbr A2 B2 (ccom (ccnv R) R)) (wex z (wa (wbr A2 (cv z) R) (wbr B2 (cv z) R)))) $;

--| Two ways of saying a relation is directed. (Contributed by Mario Carneiro, 22-Nov-2013.)
theorem codir {x3 y1 z: setvar} (A2 B2 R: class):
  $ wb (wss (cxp A2 B2) (ccom (ccnv R) R)) (wral x3 (wral y1 (wex z (wa (wbr (cv x3) (cv z) R) (wbr (cv y1) (cv z) R))) B2) A2) $;

--| A quantifier-free way of expressing the total order predicate. (Contributed by Mario Carneiro, 22-Nov-2013.)
theorem qfto {x3 y1: setvar} (A2 B2 R: class):
  $ wb (wss (cxp A2 B2) (cun R (ccnv R))) (wral x3 (wral y1 (wo (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv x3) R)) B2) A2) $;

--| A Cartesian square is a transitive relation. (Contributed by FL, 31-Jul-2009.)
theorem xpidtr (A2: class):
  $ wss (ccom (cxp A2 A2) (cxp A2 A2)) (cxp A2 A2) $;

--| The intersection of two transitive classes is transitive. (Contributed by FL, 31-Jul-2009.)
theorem trin2 (R S: class):
  $ wi (wa (wss (ccom R R) R) (wss (ccom S S) S)) (wss (ccom (cin R S) (cin R S)) (cin R S)) $;

--| A partial order is irreflexive. (Contributed by Mario Carneiro, 2-Nov-2015.) (Proof shortened by Peter Mazsa, 2-Oct-2022.)
theorem poirr2 (A2 R: class):
  $ wi (wpo A2 R) (wceq (cin R (cres cid A2)) c0) $;

--| The relation induced by a transitive relation on a part of its field is transitive. (Taking the intersection of a relation with a Cartesian square is a way to restrict it to a subset of its field.) (Contributed by FL, 31-Jul-2009.)
theorem trinxp (A2 R: class):
  $ wi (wss (ccom R R) R) (wss (ccom (cin R (cxp A2 A2)) (cin R (cxp A2 A2))) (cin R (cxp A2 A2))) $;

--| A strict order relation is irreflexive. (Contributed by NM, 10-Feb-1996.) (Revised by Mario Carneiro, 10-May-2013.)
theorem soirri (A2 R S: class):
  $ wor S R $ >
  $ wss R (cxp S S) $ >
  $ wn (wbr A2 A2 R) $;

--| A strict order relation is a transitive relation. (Contributed by NM, 10-Feb-1996.) (Revised by Mario Carneiro, 10-May-2013.)
theorem sotri (A2 B2 C R S: class):
  $ wor S R $ >
  $ wss R (cxp S S) $ >
  $ wi (wa (wbr A2 B2 R) (wbr B2 C R)) (wbr A2 C R) $;

--| A strict order relation has no 2-cycle loops. (Contributed by NM, 10-Feb-1996.) (Revised by Mario Carneiro, 10-May-2013.)
theorem son2lpi (A2 B2 R S: class):
  $ wor S R $ >
  $ wss R (cxp S S) $ >
  $ wn (wa (wbr A2 B2 R) (wbr B2 A2 R)) $;

--| A transitivity relation. (Read ` A <_ B ` and ` B < C ` implies ` A < C ` .) (Contributed by Mario Carneiro, 10-May-2013.)
theorem sotri2 (A2 B2 C R S: class):
  $ wor S R $ >
  $ wss R (cxp S S) $ >
  $ wi (w3a (wcel A2 S) (wn (wbr B2 A2 R)) (wbr B2 C R)) (wbr A2 C R) $;

--| A transitivity relation. (Read ` A < B ` and ` B <_ C ` implies ` A < C ` .) (Contributed by Mario Carneiro, 10-May-2013.)
theorem sotri3 (A2 B2 C R S: class):
  $ wor S R $ >
  $ wss R (cxp S S) $ >
  $ wi (w3a (wcel C S) (wbr A2 B2 R) (wn (wbr C B2 R))) (wbr A2 C R) $;

--| Express "less than or equals" for general strict orders. (Contributed by Stefan O'Rear, 17-Jan-2015.)
theorem poleloe (A2 B2 R V: class):
  $ wi (wcel B2 V) (wb (wbr A2 B2 (cun R cid)) (wo (wbr A2 B2 R) (wceq A2 B2))) $;

--| Transitive law for general strict orders. (Contributed by Stefan O'Rear, 17-Jan-2015.)
theorem poltletr (A2 B2 C R X: class):
  $ wi (wa (wpo X R) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wi (wa (wbr A2 B2 R) (wbr B2 C (cun R cid))) (wbr A2 C R)) $;

--| Property of a minimum in a strict order. (Contributed by Stefan O'Rear, 17-Jan-2015.)
theorem somin1 (A2 B2 R X: class):
  $ wi (wa (wor X R) (wa (wcel A2 X) (wcel B2 X))) (wbr (cif (wbr A2 B2 R) A2 B2) A2 (cun R cid)) $;

--| Commutativity of minimum in a total order. (Contributed by Stefan O'Rear, 17-Jan-2015.)
theorem somincom (A2 B2 R X: class):
  $ wi (wa (wor X R) (wa (wcel A2 X) (wcel B2 X))) (wceq (cif (wbr A2 B2 R) A2 B2) (cif (wbr B2 A2 R) B2 A2)) $;

--| Property of a minimum in a strict order. (Contributed by Stefan O'Rear, 17-Jan-2015.)
theorem somin2 (A2 B2 R X: class):
  $ wi (wa (wor X R) (wa (wcel A2 X) (wcel B2 X))) (wbr (cif (wbr A2 B2 R) A2 B2) B2 (cun R cid)) $;

--| Being less than a minimum, for a general total order. (Contributed by Stefan O'Rear, 17-Jan-2015.)
theorem soltmin (A2 B2 C R X: class):
  $ wi (wa (wor X R) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wb (wbr A2 (cif (wbr B2 C R) B2 C) R) (wa (wbr A2 B2 R) (wbr A2 C R))) $;

--| The converse of a class abstraction of ordered pairs. (Contributed by NM, 11-Dec-2003.) (Proof shortened by Andrew Salmon, 27-Aug-2011.) Avoid ~ ax-10 , ~ ax-12 . (Revised by SN, 7-Jun-2025.)
theorem cnvopab {x3 y1: setvar} (ph: wff x3 y1):
  $ wceq (ccnv (copab x3 y1 ph)) (copab y1 x3 ph) $;

--| The converse of a mapping function. (Contributed by Thierry Arnoux, 16-Jan-2017.)
theorem mptcnv {x3 y1: setvar} (ph: wff) (A2 B2: class x3) (C D: class y1):
  $ wi ph (wb (wa (wcel (cv x3) A2) (wceq (cv y1) B2)) (wa (wcel (cv y1) C) (wceq (cv x3) D))) $ >
  $ wi ph (wceq (ccnv (cmpt x3 A2 B2)) (cmpt y1 C D)) $;

--| The converse of a union is the union of converses. Theorem 16 of [Suppes] p. 62. (Contributed by NM, 25-Mar-1998.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem cnvun (A2 B2: class):
  $ wceq (ccnv (cun A2 B2)) (cun (ccnv A2) (ccnv B2)) $;

--| Distributive law for converse over class difference. (Contributed by Mario Carneiro, 26-Jun-2014.)
theorem cnvdif (A2 B2: class):
  $ wceq (ccnv (cdif A2 B2)) (cdif (ccnv A2) (ccnv B2)) $;

--| Distributive law for converse over intersection. Theorem 15 of [Suppes] p. 62. (Contributed by NM, 25-Mar-1998.) (Revised by Mario Carneiro, 26-Jun-2014.)
theorem cnvin (A2 B2: class):
  $ wceq (ccnv (cin A2 B2)) (cin (ccnv A2) (ccnv B2)) $;

--| Distributive law for range over union. Theorem 8 of [Suppes] p. 60. (Contributed by NM, 24-Mar-1998.)
theorem rnun (A2 B2: class):
  $ wceq (crn (cun A2 B2)) (cun (crn A2) (crn B2)) $;

--| The range of an intersection belongs the intersection of ranges. Theorem 9 of [Suppes] p. 60. (Contributed by NM, 15-Sep-2004.) Avoid ~ ax-pr and ~ ax-sep . (Revised by Umit Teoman Dogan, 10-Jun-2026.)
theorem rnin (A2 B2: class):
  $ wss (crn (cin A2 B2)) (cin (crn A2) (crn B2)) $;

--| Obsolete version of ~ rnin as of 10-Jun-2026. (Contributed by NM, 15-Sep-2004.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem rninOLD (A2 B2: class):
  $ wss (crn (cin A2 B2)) (cin (crn A2) (crn B2)) $;

--| The range of an indexed union. (Contributed by Mario Carneiro, 29-May-2015.)
theorem rniun {x3: setvar} (A2 B2: class x3):
  $ wceq (crn (ciun x3 A2 B2)) (ciun x3 A2 (crn B2)) $;

--| The range of a union. Part of Exercise 8 of [Enderton] p. 41. (Contributed by NM, 17-Mar-2004.) (Revised by Mario Carneiro, 29-May-2015.)
theorem rnuni {x3: setvar} (A2: class):
  $ wceq (crn (cuni A2)) (ciun x3 A2 (crn (cv x3))) $;

--| Distributive law for image over union. Theorem 35 of [Suppes] p. 65. (Contributed by NM, 30-Sep-2002.)
theorem imaundi (A2 B2 C: class):
  $ wceq (cima A2 (cun B2 C)) (cun (cima A2 B2) (cima A2 C)) $;

--| The image of a union. (Contributed by Jeff Hoffman, 17-Feb-2008.)
theorem imaundir (A2 B2 C: class):
  $ wceq (cima (cun A2 B2) C) (cun (cima A2 C) (cima B2 C)) $;

--| An upper bound for intersection with a domain. Theorem 40 of [Suppes] p. 66, who calls it "somewhat surprising". (Contributed by NM, 11-Aug-2004.)
theorem dminss (A2 R: class):
  $ wss (cin (cdm R) A2) (cima (ccnv R) (cima R A2)) $;

--| An upper bound for intersection with an image. Theorem 41 of [Suppes] p. 66. (Contributed by NM, 11-Aug-2004.)
theorem imainss (A2 B2 R: class):
  $ wss (cin (cima R A2) B2) (cima R (cin A2 (cima (ccnv R) B2))) $;

--| The image of an intersection. (Contributed by Thierry Arnoux, 16-Dec-2017.)
theorem inimass (A2 B2 C: class):
  $ wss (cima (cin A2 B2) C) (cin (cima A2 C) (cima B2 C)) $;

--| The intersection of the image of singleton. (Contributed by Thierry Arnoux, 16-Dec-2017.)
theorem inimasn (A2 B2 C V: class):
  $ wi (wcel C V) (wceq (cima (cin A2 B2) (csn C)) (cin (cima A2 (csn C)) (cima B2 (csn C)))) $;

--| The converse of a Cartesian product. Exercise 11 of [Suppes] p. 67. (Contributed by NM, 14-Aug-1999.) (Proof shortened by Andrew Salmon, 27-Aug-2011.) Avoid ~ ax-11 . (Revised by SN, 26-Aug-2026.)
theorem cnvxp (A2 B2: class):
  $ wceq (ccnv (cxp A2 B2)) (cxp B2 A2) $;

--| Obsolete version of ~ cnvxp as of 26-Aug-2026. (Contributed by NM, 14-Aug-1999.) (Proof shortened by Andrew Salmon, 27-Aug-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem cnvxpOLD (A2 B2: class):
  $ wceq (ccnv (cxp A2 B2)) (cxp B2 A2) $;

--| Obsolete version of ~ xp0 as of 1-Feb-2026. (Contributed by NM, 12-Apr-2004.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem xp0OLD (A2: class):
  $ wceq (cxp A2 c0) c0 $;

--| The Cartesian product of nonempty classes is nonempty. (Variation of a theorem contributed by Raph Levien, 30-Jun-2006.) (Contributed by NM, 30-Jun-2006.)
theorem xpnz (A2 B2: class):
  $ wb (wa (wne A2 c0) (wne B2 c0)) (wne (cxp A2 B2) c0) $;

--| At least one member of an empty Cartesian product is empty. (Contributed by NM, 27-Aug-2006.)
theorem xpeq0 (A2 B2: class):
  $ wb (wceq (cxp A2 B2) c0) (wo (wceq A2 c0) (wceq B2 c0)) $;

--| Cartesian products with disjoint sets are disjoint. (Contributed by NM, 13-Sep-2004.)
theorem xpdisj1 (A2 B2 C D: class):
  $ wi (wceq (cin A2 B2) c0) (wceq (cin (cxp A2 C) (cxp B2 D)) c0) $;

--| Cartesian products with disjoint sets are disjoint. (Contributed by NM, 13-Sep-2004.)
theorem xpdisj2 (A2 B2 C D: class):
  $ wi (wceq (cin A2 B2) c0) (wceq (cin (cxp C A2) (cxp D B2)) c0) $;

--| Cartesian products with two different singletons are disjoint. (Contributed by NM, 28-Jul-2004.)
theorem xpsndisj (A2 B2 C D: class):
  $ wi (wne B2 D) (wceq (cin (cxp A2 (csn B2)) (cxp C (csn D))) c0) $;

--| Difference of Cartesian products, expressed in terms of a union of Cartesian products of differences. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 26-Jun-2014.) (Proof shortened by Wolf Lammen, 16-May-2025.)
theorem difxp (A2 B2 C D: class):
  $ wceq (cdif (cxp C D) (cxp A2 B2)) (cun (cxp (cdif C A2) D) (cxp C (cdif D B2))) $;

--| Difference law for Cartesian product. (Contributed by Scott Fenton, 18-Feb-2013.) (Revised by Mario Carneiro, 26-Jun-2014.)
theorem difxp1 (A2 B2 C: class):
  $ wceq (cxp (cdif A2 B2) C) (cdif (cxp A2 C) (cxp B2 C)) $;

--| Difference law for Cartesian product. (Contributed by Scott Fenton, 18-Feb-2013.) (Revised by Mario Carneiro, 26-Jun-2014.)
theorem difxp2 (A2 B2 C: class):
  $ wceq (cxp A2 (cdif B2 C)) (cdif (cxp A2 B2) (cxp A2 C)) $;

--| Disjoint unions with disjoint index sets are disjoint. (Contributed by Stefan O'Rear, 21-Nov-2014.)
theorem djudisj {x3 y1: setvar} (A2: class y1) (B2: class x3) (C D: class x3 y1):
  $ wi (wceq (cin A2 B2) c0) (wceq (cin (ciun x3 A2 (cxp (csn (cv x3)) C)) (ciun y1 B2 (cxp (csn (cv y1)) D))) c0) $;

--| Disjoint unions with disjoint index sets are disjoint. (Contributed by Stefan O'Rear, 21-Nov-2014.)
theorem djudisj_b {x3: setvar} (A2 B2: class) (C D: class x3):
  $ wi (wceq (cin A2 B2) c0) (wceq (cin (ciun x3 A2 (cxp (csn (cv x3)) C)) (ciun x3 B2 (cxp (csn (cv x3)) D))) c0) $;

--| The set of distinct couples in a Cartesian product. (Contributed by Thierry Arnoux, 25-May-2019.)
theorem xpdifid {x3: setvar} (A2 B2: class):
  $ wceq (ciun x3 A2 (cxp (csn (cv x3)) (cdif B2 (csn (cv x3))))) (cdif (cxp A2 B2) cid) $;

--| The set of couples in a Cartesian product, where the second is not an element of the first. (Contributed by Thierry Arnoux, 17-Jun-2026.)
theorem xpdifcnvepel {x3: setvar} (A2 B2: class):
  $ wceq (ciun x3 A2 (cxp (csn (cv x3)) (cdif B2 (cv x3)))) (cdif (cxp A2 B2) (ccnv cep)) $;

--| A double restriction to disjoint classes is the empty set. (Contributed by NM, 7-Oct-2004.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem resdisj (A2 B2 C: class):
  $ wi (wceq (cin A2 B2) c0) (wceq (cres (cres C A2) B2) c0) $;

--| The range of a Cartesian product. Part of Theorem 3.13(x) of [Monk1] p. 37. (Contributed by NM, 12-Apr-2004.)
theorem rnxp (A2 B2: class):
  $ wi (wne A2 c0) (wceq (crn (cxp A2 B2)) B2) $;

--| The domain of a Cartesian product is included in its first factor. (Contributed by NM, 19-Mar-2007.)
theorem dmxpss (A2 B2: class):
  $ wss (cdm (cxp A2 B2)) A2 $;

--| The range of a Cartesian product is included in its second factor. (Contributed by NM, 16-Jan-2006.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem rnxpss (A2 B2: class):
  $ wss (crn (cxp A2 B2)) B2 $;

--| The range of a Cartesian square. (Contributed by FL, 17-May-2010.)
theorem rnxpid (A2: class):
  $ wceq (crn (cxp A2 A2)) A2 $;

--| A Cartesian product subclass relationship is equivalent to the conjunction of the analogous relationships for the factors. (Contributed by NM, 17-Dec-2008.)
theorem ssxpb (A2 B2 C D: class):
  $ wi (wne (cxp A2 B2) c0) (wb (wss (cxp A2 B2) (cxp C D)) (wa (wss A2 C) (wss B2 D))) $;

--| The Cartesian product of nonempty classes is a one-to-one "function" of its two "arguments". In other words, two Cartesian products, at least one with nonempty factors, are equal if and only if their respective factors are equal. (Contributed by NM, 31-May-2008.)
theorem xp11 (A2 B2 C D: class):
  $ wi (wa (wne A2 c0) (wne B2 c0)) (wb (wceq (cxp A2 B2) (cxp C D)) (wa (wceq A2 C) (wceq B2 D))) $;

--| Cancellation law for Cartesian product. (Contributed by NM, 30-Aug-2011.)
theorem xpcan (A2 B2 C: class):
  $ wi (wne C c0) (wb (wceq (cxp C A2) (cxp C B2)) (wceq A2 B2)) $;

--| Cancellation law for Cartesian product. (Contributed by NM, 30-Aug-2011.)
theorem xpcan2 (A2 B2 C: class):
  $ wi (wne C c0) (wb (wceq (cxp A2 C) (cxp B2 C)) (wceq A2 B2)) $;

--| Two ways to express surjectivity of a restricted and corestricted binary relation (intersection of a binary relation with a Cartesian product): the LHS expresses inclusion in the range of the restricted relation, while the RHS expresses equality with the range of the restricted and corestricted relation. (Contributed by NM, 16-Jan-2006.) (Proof shortened by Peter Mazsa, 2-Oct-2022.)
theorem ssrnres (A2 B2 C: class):
  $ wb (wss B2 (crn (cres C A2))) (wceq (crn (cin C (cxp A2 B2))) B2) $;

--| Two ways to express surjectivity of a restricted and corestricted binary relation (intersection of a binary relation with a Cartesian product). (Contributed by NM, 17-Jan-2006.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem rninxp {x3 y1: setvar} (A2: class) (B2: class x3) (C: class):
  $ wb (wceq (crn (cin C (cxp A2 B2))) B2) (wral y1 (wrex x3 (wbr (cv x3) (cv y1) C) A2) B2) $;

--| Two ways to express totality of a restricted and corestricted binary relation (intersection of a binary relation with a Cartesian product). (Contributed by NM, 17-Jan-2006.)
theorem dminxp {x3 y1: setvar} (A2: class y1) (B2 C: class):
  $ wb (wceq (cdm (cin C (cxp A2 B2))) A2) (wral x3 (wrex y1 (wbr (cv x3) (cv y1) C) B2) A2) $;

--| Image by a restricted and corestricted binary relation (intersection of a binary relation with a Cartesian product). (Contributed by Stefan O'Rear, 19-Feb-2015.)
theorem imainrect (A2 B2 G Y: class):
  $ wceq (cima (cin G (cxp A2 B2)) Y) (cin (cima G (cin Y A2)) B2) $;

--| Direct image by a Cartesian product. (Contributed by Thierry Arnoux, 4-Feb-2017.)
theorem xpima (A2 B2 C: class):
  $ wceq (cima (cxp A2 B2) C) (cif (wceq (cin A2 C) c0) c0 B2) $;

--| Direct image by a Cartesian product (case of empty intersection with the domain). (Contributed by Thierry Arnoux, 16-Dec-2017.)
theorem xpima1 (A2 B2 C: class):
  $ wi (wceq (cin A2 C) c0) (wceq (cima (cxp A2 B2) C) c0) $;

--| Direct image by a Cartesian product (case of nonempty intersection with the domain). (Contributed by Thierry Arnoux, 16-Dec-2017.)
theorem xpima2 (A2 B2 C: class):
  $ wi (wne (cin A2 C) c0) (wceq (cima (cxp A2 B2) C) B2) $;

--| Direct image of a singleton by a Cartesian product. (Contributed by Thierry Arnoux, 14-Jan-2018.) (Proof shortened by BJ, 6-Apr-2019.)
theorem xpimasn (A2 B2 X: class):
  $ wi (wcel X A2) (wceq (cima (cxp A2 B2) (csn X)) B2) $;

--| The base set of a strict order is contained in the field of the relation, except possibly for one element (note that ` (/) Or { B } ` ). (Contributed by Mario Carneiro, 27-Apr-2015.)
theorem sossfld (A2 B2 R: class):
  $ wi (wa (wor A2 R) (wcel B2 A2)) (wss (cdif A2 (csn B2)) (cun (cdm R) (crn R))) $;

--| The base set of a nonempty strict order is the same as the field of the relation. (Contributed by Mario Carneiro, 15-May-2015.)
theorem sofld (A2 R: class):
  $ wi (w3a (wor A2 R) (wss R (cxp A2 A2)) (wne R c0)) (wceq A2 (cun (cdm R) (crn R))) $;

--| The set of all ordered pairs in a class is the same as the double converse. (Contributed by Mario Carneiro, 16-Aug-2015.)
theorem cnvcnv3 {x3 y1: setvar} (R: class):
  $ wceq (ccnv (ccnv R)) (copab x3 y1 (wbr (cv x3) (cv y1) R)) $;

--| Alternate definition of relation. Exercise 2 of [TakeutiZaring] p. 25. (Contributed by NM, 29-Dec-1996.)
theorem dfrel2 (R: class):
  $ wb (wrel R) (wceq (ccnv (ccnv R)) R) $;

--| A relation can be expressed as the set of ordered pairs in it. An analogue of ~ dffn5 for relations. (Contributed by Mario Carneiro, 16-Aug-2015.)
theorem dfrel4v {x3 y1: setvar} (R: class):
  $ wb (wrel R) (wceq R (copab x3 y1 (wbr (cv x3) (cv y1) R))) $;

--| A relation can be expressed as the set of ordered pairs in it. An analogue of ~ dffn5 for relations. (Contributed by Mario Carneiro, 16-Aug-2015.) (Revised by Thierry Arnoux, 11-May-2017.)
theorem dfrel4 {x3 y1: setvar} (R: class x3 y1):
  $ wnfc x3 R $ >
  $ wnfc y1 R $ >
  $ wb (wrel R) (wceq R (copab x3 y1 (wbr (cv x3) (cv y1) R))) $;

--| The double converse of a class strips out all elements that are not ordered pairs. (Contributed by NM, 8-Dec-2003.) (Proof shortened by BJ, 26-Nov-2021.)
theorem cnvcnv (A2: class):
  $ wceq (ccnv (ccnv A2)) (cin A2 (cxp cvv cvv)) $;

--| The double converse of a class equals its restriction to the universe. (Contributed by NM, 8-Oct-2007.)
theorem cnvcnv2 (A2: class):
  $ wceq (ccnv (ccnv A2)) (cres A2 cvv) $;

--| The double converse of a class is a subclass. Exercise 2 of [TakeutiZaring] p. 25. (Contributed by NM, 23-Jul-2004.) (Proof shortened by Umit Teoman Dogan, 10-Jun-2026.)
theorem cnvcnvss (A2: class):
  $ wss (ccnv (ccnv A2)) A2 $;

--| Obsolete version of ~ cnvcnvss as of 10-Jun-2026. (Contributed by NM, 23-Jul-2004.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem cnvcnvssOLD (A2: class):
  $ wss (ccnv (ccnv A2)) A2 $;

--| Two ways to express the corestriction of a class. (Contributed by BJ, 28-Dec-2023.)
theorem cnvrescnv (B2 R: class):
  $ wceq (ccnv (cres (ccnv R) B2)) (cin R (cxp cvv B2)) $;

--| Subclass theorem for converse. (Contributed by RP, 22-Oct-2020.)
theorem cnvssb (A2 B2: class):
  $ wi (wrel A2) (wb (wss A2 B2) (wss (ccnv A2) (ccnv B2))) $;

--| Equality theorem for converse. (Contributed by FL, 19-Sep-2011.)
theorem cnveqb (A2 B2: class):
  $ wi (wa (wrel A2) (wrel B2)) (wb (wceq A2 B2) (wceq (ccnv A2) (ccnv B2))) $;

--| A relation is empty iff its converse is empty. (Contributed by FL, 19-Sep-2011.)
theorem cnveq0 (A2: class):
  $ wi (wrel A2) (wb (wceq A2 c0) (wceq (ccnv A2) c0)) $;

--| A class is empty iff it is a relation whose converse is empty. (Contributed by SN, 8-Oct-2026.)
theorem cnveq0b (A2: class):
  $ wb (wceq A2 c0) (wa (wrel A2) (wceq (ccnv A2) c0)) $;

--| Alternate definition of relation. (Contributed by NM, 14-May-2008.)
theorem dfrel3 (R: class):
  $ wb (wrel R) (wceq (cres R cvv) R) $;

--| Characterization of the elements of the identity relation. TODO: reorder theorems to move this theorem and ~ dfrel3 after ~ elrid . (Contributed by BJ, 28-Aug-2022.)
theorem elid {x3: setvar} (A2: class):
  $ wb (wcel A2 cid) (wex x3 (wceq A2 (cop (cv x3) (cv x3)))) $;

--| The domain of a universal restriction. (Contributed by NM, 14-May-2008.)
theorem dmresv (A2: class):
  $ wceq (cdm (cres A2 cvv)) (cdm A2) $;

--| The range of a universal restriction. (Contributed by NM, 14-May-2008.)
theorem rnresv (A2: class):
  $ wceq (crn (cres A2 cvv)) (crn A2) $;

--| Range defined in terms of image. (Contributed by NM, 14-May-2008.)
theorem dfrn4 (A2: class):
  $ wceq (crn A2) (cima A2 cvv) $;

--| Any image by a class is included in the range of the class. Theorem 3.16(xi) of [Monk1] p. 39. (Contributed by NM, 31-Mar-1995.) (Proof shortened by BJ, 27-Sep-2026.)
theorem imassrn (A2 B2: class):
  $ wss (cima A2 B2) (crn A2) $;

--| Any preimage by a class is included in the domain of the class. (Contributed by FL, 29-Jan-2007.)
theorem cnvimass (A2 B2: class):
  $ wss (cima (ccnv A2) B2) (cdm A2) $;

--| Obsolete version of ~ cnvimarndm as of 29-Sep-2026. (Contributed by AV, 18-Sep-2024.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem cnvimassrndmOLD (A2 F: class):
  $ wi (wss (crn F) A2) (wceq (cima (ccnv F) A2) (cdm F)) $;

--| Image under the empty relation. (Contributed by FL, 11-Jan-2007.)
theorem _0ima (A2: class):
  $ wceq (cima c0 A2) c0 $;

--| Condition for the range of a class to be the range of one of its restrictions. (Contributed by AV, 4-Oct-2025.) Remove antecedent. (Revised by Eric Schmidt, 10-Jul-2026.) (Proof shortened by BJ, 29-Sep-2026.)
theorem imadifssrn (A2 F: class):
  $ wi (wss (cima F (cdif (cdm F) A2)) (crn (cres F A2))) (wceq (crn F) (crn (cres F A2))) $;

--| Obsolete version of ~ imadifssrn as of 29-Sep-2026. (Contributed by AV, 4-Oct-2025.) Remove antecedent. (Revised by Eric Schmidt, 10-Jul-2026.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem imadifssranOLD (A2 F: class):
  $ wi (wss (cima F (cdif (cdm F) A2)) (crn (cres F A2))) (wceq (crn F) (crn (cres F A2))) $;

--| Obsolete version of ~ imadifssranOLD as of 10-Jul-2026. (Contributed by AV, 4-Oct-2025.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem imadifssranOLDOLD (A2 F: class):
  $ wi (wa (wrel F) (wss A2 (cdm F))) (wi (wss (cima F (cdif (cdm F) A2)) (crn (cres F A2))) (wceq (crn F) (crn (cres F A2)))) $;

--| Distribute proper substitution through the range of a class. (Contributed by Alan Sare, 10-Nov-2012.)
theorem csbrn {x3: setvar} (A2 B2: class x3):
  $ wceq (csb x3 A2 (crn B2)) (crn (csb x3 A2 B2)) $;

--| The restriction of the double converse of a class. (Contributed by NM, 8-Apr-2007.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem rescnvcnv (A2 B2: class):
  $ wceq (cres (ccnv (ccnv A2)) B2) (cres A2 B2) $;

--| The double converse of the restriction of a class. (Contributed by NM, 3-Jun-2007.)
theorem cnvcnvres (A2 B2: class):
  $ wceq (ccnv (ccnv (cres A2 B2))) (cres (ccnv (ccnv A2)) B2) $;

--| The image of the double converse of a class. (Contributed by NM, 8-Apr-2007.)
theorem imacnvcnv (A2 B2: class):
  $ wceq (cima (ccnv (ccnv A2)) B2) (cima A2 B2) $;

--| The domain of a singleton is nonzero iff the singleton argument is an ordered pair. (Contributed by NM, 14-Dec-2008.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem dmsnn0 (A2: class):
  $ wb (wcel A2 (cxp cvv cvv)) (wne (cdm (csn A2)) c0) $;

--| The range of a singleton is nonzero iff the singleton argument is an ordered pair. (Contributed by NM, 14-Dec-2008.)
theorem rnsnn0 (A2: class):
  $ wb (wcel A2 (cxp cvv cvv)) (wne (crn (csn A2)) c0) $;

--| The domain of the singleton of the empty set is empty. (Contributed by NM, 30-Jan-2004.)
theorem dmsn0:
  $ wceq (cdm (csn c0)) c0 $;

--| The converse of the singleton of the empty set is empty. (Contributed by Mario Carneiro, 30-Aug-2015.)
theorem cnvsn0:
  $ wceq (ccnv (csn c0)) c0 $;

--| The domain of a singleton is empty if the singleton's argument contains the empty set. (Contributed by NM, 15-Dec-2008.)
theorem dmsn0el (A2: class):
  $ wi (wcel c0 A2) (wceq (cdm (csn A2)) c0) $;

--| A singleton is a relation iff it has a nonempty domain. (Contributed by NM, 25-Sep-2013.) Make hypothesis an antecedent. (Revised by BJ, 12-Feb-2022.)
theorem relsn2 (A2 V: class):
  $ wi (wcel A2 V) (wb (wrel (csn A2)) (wne (cdm (csn A2)) c0)) $;

--| The domain of a singleton of an ordered pair is the singleton of the first member. (Contributed by Mario Carneiro, 26-Apr-2015.)
theorem dmsnopg (A2 B2 V: class):
  $ wi (wcel B2 V) (wceq (cdm (csn (cop A2 B2))) (csn A2)) $;

--| The domain of a singleton of an ordered pair is a subset of the singleton of the first member (with no sethood assumptions on ` B ` ). (Contributed by Mario Carneiro, 30-Apr-2015.)
theorem dmsnopss (A2 B2: class):
  $ wss (cdm (csn (cop A2 B2))) (csn A2) $;

--| The domain of an unordered pair of ordered pairs. (Contributed by Mario Carneiro, 26-Apr-2015.)
theorem dmpropg (A2 B2 C D V W: class):
  $ wi (wa (wcel B2 V) (wcel D W)) (wceq (cdm (cpr (cop A2 B2) (cop C D))) (cpr A2 C)) $;

--| The domain of a singleton of an ordered pair is the singleton of the first member. (Contributed by NM, 30-Jan-2004.) (Proof shortened by Andrew Salmon, 27-Aug-2011.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem dmsnop (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wceq (cdm (csn (cop A2 B2))) (csn A2) $;

--| The domain of an unordered pair of ordered pairs. (Contributed by NM, 13-Sep-2011.)
theorem dmprop (A2 B2 C D: class):
  $ wcel B2 cvv $ >
  $ wcel D cvv $ >
  $ wceq (cdm (cpr (cop A2 B2) (cop C D))) (cpr A2 C) $;

--| The domain of an unordered triple of ordered pairs. (Contributed by NM, 14-Sep-2011.)
theorem dmtpop (A2 B2 C D E F: class):
  $ wcel B2 cvv $ >
  $ wcel D cvv $ >
  $ wcel F cvv $ >
  $ wceq (cdm (ctp (cop A2 B2) (cop C D) (cop E F))) (ctp A2 C E) $;

--| Double converse of a singleton of an ordered pair. (Unlike ~ cnvsn , this does not need any sethood assumptions on ` A ` and ` B ` .) (Contributed by Mario Carneiro, 26-Apr-2015.)
theorem cnvcnvsn (A2 B2: class):
  $ wceq (ccnv (ccnv (csn (cop A2 B2)))) (ccnv (csn (cop B2 A2))) $;

--| The domain of the singleton of the singleton of a singleton. (Contributed by NM, 15-Sep-2004.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem dmsnsnsn (A2: class):
  $ wceq (cdm (csn (csn (csn A2)))) (csn A2) $;

--| The range of a singleton of an ordered pair is the singleton of the second member. (Contributed by NM, 24-Jul-2004.) (Revised by Mario Carneiro, 30-Apr-2015.)
theorem rnsnopg (A2 B2 V: class):
  $ wi (wcel A2 V) (wceq (crn (csn (cop A2 B2))) (csn B2)) $;

--| The range of a pair of ordered pairs is the pair of second members. (Contributed by Thierry Arnoux, 3-Jan-2017.)
theorem rnpropg (A2 B2 C D V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wceq (crn (cpr (cop A2 C) (cop B2 D))) (cpr C D)) $;

--| Converse of a singleton of an ordered pair. (Contributed by NM, 23-Jan-2015.) (Proof shortened by BJ, 12-Feb-2022.)
theorem cnvsng (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wceq (ccnv (csn (cop A2 B2))) (csn (cop B2 A2))) $;

--| The range of a singleton of an ordered pair is the singleton of the second member. (Contributed by NM, 24-Jul-2004.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem rnsnop (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wceq (crn (csn (cop A2 B2))) (csn B2) $;

--| Extract the first member of an ordered pair. (See ~ op2nda to extract the second member, ~ op1stb for an alternate version, and ~ op1st for the preferred version.) (Contributed by Raph Levien, 4-Dec-2003.)
theorem op1sta (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq (cuni (cdm (csn (cop A2 B2)))) A2 $;

--| Converse of a singleton of an ordered pair. (Contributed by NM, 11-May-1998.) (Revised by Mario Carneiro, 26-Apr-2015.) (Proof shortened by BJ, 12-Feb-2022.)
theorem cnvsn (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq (ccnv (csn (cop A2 B2))) (csn (cop B2 A2)) $;

--| Extract the second member of an ordered pair. Theorem 5.12(ii) of [Monk1] p. 52. (See ~ op1stb to extract the first member, ~ op2nda for an alternate version, and ~ op2nd for the preferred version.) (Contributed by NM, 25-Nov-2003.)
theorem op2ndb (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq (cint (cint (cint (ccnv (csn (cop A2 B2)))))) B2 $;

--| Extract the second member of an ordered pair. (See ~ op1sta to extract the first member, ~ op2ndb for an alternate version, and ~ op2nd for the preferred version.) (Contributed by NM, 17-Feb-2004.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem op2nda (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq (cuni (crn (csn (cop A2 B2)))) B2 $;

--| Swap the members of an ordered pair. (Contributed by NM, 14-Dec-2008.) (Revised by Mario Carneiro, 30-Aug-2015.)
theorem opswap (A2 B2: class):
  $ wceq (cuni (ccnv (csn (cop A2 B2)))) (cop B2 A2) $;

--| An image under the converse of a restriction. (Contributed by Jeff Hankins, 12-Jul-2009.)
theorem cnvresima (A2 B2 F: class):
  $ wceq (cima (ccnv (cres F A2)) B2) (cin (cima (ccnv F) B2) A2) $;

--| A class restricted to its domain equals its double converse. (Contributed by NM, 8-Apr-2007.)
theorem resdm2 (A2: class):
  $ wceq (cres A2 (cdm A2)) (ccnv (ccnv A2)) $;

--| Restriction to the domain of a restriction. (Contributed by NM, 8-Apr-2007.)
theorem resdmres (A2 B2: class):
  $ wceq (cres A2 (cdm (cres A2 B2))) (cres A2 B2) $;

--| A restriction by an arbitrary set is a restriction by its domain. (Contributed by AV, 16-Nov-2020.)
theorem resresdm (A2 E F: class):
  $ wi (wceq F (cres E A2)) (wceq F (cres E (cdm F))) $;

--| The image of the domain of a restriction. (Contributed by NM, 8-Apr-2007.)
theorem imadmres (A2 B2: class):
  $ wceq (cima A2 (cdm (cres A2 B2))) (cima A2 B2) $;

--| Subset relationship for the domain of a restriction. (Contributed by Scott Fenton, 9-Aug-2024.)
theorem resdmss (A2 B2: class):
  $ wss (cdm (cres A2 B2)) B2 $;

--| Distributive law for restriction over difference. (Contributed by BTernaryTau, 15-Aug-2024.)
theorem resdifdi (A2 B2 C: class):
  $ wceq (cres A2 (cdif B2 C)) (cdif (cres A2 B2) (cres A2 C)) $;

--| Distributive law for restriction over difference. (Contributed by BTernaryTau, 15-Aug-2024.)
theorem resdifdir (A2 B2 C: class):
  $ wceq (cres (cdif A2 B2) C) (cdif (cres A2 C) (cres B2 C)) $;

--| The preimage of a function in maps-to notation. (Contributed by Stefan O'Rear, 25-Jan-2015.)
theorem mptpreima {x3: setvar} (A2 B2: class x3) (C: class) (F: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wceq (cima (ccnv F) C) (crab x3 (wcel B2 C) A2) $;

--| Converse singleton image of a function defined by maps-to. (Contributed by Stefan O'Rear, 25-Jan-2015.)
theorem mptiniseg {x3: setvar} (A2 B2: class x3) (C: class) (F: class x3) (V: class):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wcel C V) (wceq (cima (ccnv F) (csn C)) (crab x3 (wceq B2 C) A2)) $;

--| The domain of the mapping operation in general. (Contributed by NM, 16-May-1995.) (Revised by Mario Carneiro, 22-Mar-2015.)
theorem dmmpt {x3: setvar} (A2 B2 F: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wceq (cdm F) (crab x3 (wcel B2 cvv) A2) $;

--| The domain of a mapping is a subset of its base class. (Contributed by Scott Fenton, 17-Jun-2013.)
theorem dmmptss {x3: setvar} (A2: class) (B2 F: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wss (cdm F) A2 $;

--| The domain of the mapping operation is the stated domain, if the function value is always a set. (Contributed by Mario Carneiro, 9-Feb-2013.) (Revised by Mario Carneiro, 14-Sep-2013.)
theorem dmmptg {x3: setvar} (A2: class) (B2 V: class x3):
  $ wi (wral x3 (wcel B2 V) A2) (wceq (cdm (cmpt x3 A2 B2)) A2) $;

--| The range of a function in maps-to notation is empty if and only if its domain is empty. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem rnmpt0f {x3: setvar} (ph: wff x3) (A2: class) (B2 F V: class x3):
  $ wnf x3 ph $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi ph (wb (wceq (crn F) c0) (wceq A2 c0)) $;

--| The range of a function in maps-to notation is nonempty if the domain is nonempty. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem rnmptn0 {x3: setvar} (ph: wff x3) (A2: class) (B2 F V: class x3):
  $ wnf x3 ph $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi ph (wne A2 c0) $ >
  $ wi ph (wne (crn F) c0) $;

--| Alternate definition of a class composition, using only one bound variable. (Contributed by NM, 19-Dec-2008.)
theorem dfco2 {x3: setvar} (A2 B2: class):
  $ wceq (ccom A2 B2) (ciun x3 cvv (cxp (cima (ccnv B2) (csn (cv x3))) (cima A2 (csn (cv x3))))) $;

--| Generalization of ~ dfco2 , where ` C ` can have any value between ` dom A i^i ran B ` and ` _V ` . (Contributed by NM, 21-Dec-2008.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem dfco2a {x3: setvar} (A2 B2 C: class):
  $ wi (wss (cin (cdm A2) (crn B2)) C) (wceq (ccom A2 B2) (ciun x3 C (cxp (cima (ccnv B2) (csn (cv x3))) (cima A2 (csn (cv x3)))))) $;

--| Class composition distributes over union. (Contributed by NM, 21-Dec-2008.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem coundi (A2 B2 C: class):
  $ wceq (ccom A2 (cun B2 C)) (cun (ccom A2 B2) (ccom A2 C)) $;

--| Class composition distributes over union. (Contributed by NM, 21-Dec-2008.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem coundir (A2 B2 C: class):
  $ wceq (ccom (cun A2 B2) C) (cun (ccom A2 C) (ccom B2 C)) $;

--| Restricted first member of a class composition. (Contributed by NM, 12-Oct-2004.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem cores (A2 B2 C: class):
  $ wi (wss (crn B2) C) (wceq (ccom (cres A2 C) B2) (ccom A2 B2)) $;

--| Associative law for the restriction of a composition. (Contributed by NM, 12-Dec-2006.)
theorem resco (A2 B2 C: class):
  $ wceq (cres (ccom A2 B2) C) (ccom A2 (cres B2 C)) $;

--| Image of the composition of two classes. (Contributed by Jason Orendorff, 12-Dec-2006.) (Proof shortened by Wolf Lammen, 16-May-2025.)
theorem imaco (A2 B2 C: class):
  $ wceq (cima (ccom A2 B2) C) (cima A2 (cima B2 C)) $;

--| The range of the composition of two classes. (Contributed by NM, 12-Dec-2006.) (Proof shortened by Peter Mazsa, 2-Oct-2022.) Avoid ~ ax-11 . (Revised by TM, 24-Jan-2026.)
theorem rnco (A2 B2: class):
  $ wceq (crn (ccom A2 B2)) (crn (cres A2 (crn B2))) $;

--| Obsolete version of ~ rnco as of 24-Jan-2026. (Contributed by NM, 12-Dec-2006.) (Proof shortened by Peter Mazsa, 2-Oct-2022.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem rncoOLD (A2 B2: class):
  $ wceq (crn (ccom A2 B2)) (crn (cres A2 (crn B2))) $;

--| The range of the composition of two classes. (Contributed by NM, 27-Mar-2008.)
theorem rnco2 (A2 B2: class):
  $ wceq (crn (ccom A2 B2)) (cima A2 (crn B2)) $;

--| The domain of a composition. Exercise 27 of [Enderton] p. 53. (Contributed by NM, 4-Feb-2004.)
theorem dmco (A2 B2: class):
  $ wceq (cdm (ccom A2 B2)) (cima (ccnv B2) (cdm A2)) $;

--| A composition of two relations is empty iff there is no overlap between the range of the second and the domain of the first. Useful in combination with ~ coundi and ~ coundir to prune meaningless terms in the result. (Contributed by Stefan O'Rear, 8-Oct-2014.)
theorem coeq0 (A2 B2: class):
  $ wb (wceq (ccom A2 B2) c0) (wceq (cin (cdm A2) (crn B2)) c0) $;

--| Composition with an indexed union. (Contributed by NM, 21-Dec-2008.)
theorem coiun {x3: setvar} (A2: class) (B2 C: class x3):
  $ wceq (ccom A2 (ciun x3 C B2)) (ciun x3 C (ccom A2 B2)) $;

--| A composition is not affected by a double converse of its first argument. (Contributed by NM, 8-Oct-2007.)
theorem cocnvcnv1 (A2 B2: class):
  $ wceq (ccom (ccnv (ccnv A2)) B2) (ccom A2 B2) $;

--| A composition is not affected by a double converse of its second argument. (Contributed by NM, 8-Oct-2007.)
theorem cocnvcnv2 (A2 B2: class):
  $ wceq (ccom A2 (ccnv (ccnv B2))) (ccom A2 B2) $;

--| Absorption of a reverse (preimage) restriction of the second member of a class composition. (Contributed by NM, 11-Dec-2006.)
theorem cores2 (A2 B2 C: class):
  $ wi (wss (cdm A2) C) (wceq (ccom A2 (ccnv (cres (ccnv B2) C))) (ccom A2 B2)) $;

--| Composition with the empty set. Theorem 20 of [Suppes] p. 63. (Contributed by NM, 24-Apr-2004.)
theorem co02 (A2: class):
  $ wceq (ccom A2 c0) c0 $;

--| Composition with the empty set. (Contributed by NM, 24-Apr-2004.)
theorem co01 (A2: class):
  $ wceq (ccom c0 A2) c0 $;

--| Composition with the identity relation. Part of Theorem 3.7(i) of [Monk1] p. 36. (Contributed by NM, 22-Apr-2004.)
theorem coi1 (A2: class):
  $ wi (wrel A2) (wceq (ccom A2 cid) A2) $;

--| Composition with the identity relation. Part of Theorem 3.7(i) of [Monk1] p. 36. (Contributed by NM, 22-Apr-2004.)
theorem coi2 (A2: class):
  $ wi (wrel A2) (wceq (ccom cid A2) A2) $;

--| Composition with a restricted identity relation. (Contributed by FL, 19-Jun-2011.) (Revised by Stefan O'Rear, 7-Mar-2015.)
theorem coires1 (A2 B2: class):
  $ wceq (ccom A2 (cres cid B2)) (cres A2 B2) $;

--| Associative law for class composition. Theorem 27 of [Suppes] p. 64. Also Exercise 21 of [Enderton] p. 53. Interestingly, this law holds for any classes whatsoever, not just functions or even relations. (Contributed by NM, 27-Jan-1997.)
theorem coass (A2 B2 C: class):
  $ wceq (ccom (ccom A2 B2) C) (ccom A2 (ccom B2 C)) $;

--| Subclass law for converse of a composition. A particular case is ` ( ( R o. R ) C_ R <-> ( ``' R o. ``' R ) C_ ``' R ) ` , which says that a relation is transitive iff its converse is transitive. (Contributed by FL, 19-Sep-2011.) Generalize to a statement about three classes rather than one. (Revised by Peter Mazsa, 17-Oct-2023.) Remove antecedent. (Revised by Eric Schmidt, 8-Aug-2026.)
theorem relcnvtrg (R S T: class):
  $ wb (wss (ccom R S) T) (wss (ccom (ccnv S) (ccnv R)) (ccnv T)) $;

--| Obsolete form of ~ relcnvtrg as of 8-Aug-2026. (Contributed by Peter Mazsa, 17-Oct-2023.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem relcnvtrgOLD (R S T: class):
  $ wi (w3a (wrel R) (wrel S) (wrel T)) (wb (wss (ccom R S) T) (wss (ccom (ccnv S) (ccnv R)) (ccnv T))) $;

--| Obsolete form of ~ relcnvtrg as of 8-Aug-2026. (Contributed by FL, 19-Sep-2011.) (Proof shortened by Peter Mazsa, 17-Oct-2023.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem relcnvtrOLD (R: class):
  $ wi (wrel R) (wb (wss (ccom R R) R) (wss (ccom (ccnv R) (ccnv R)) (ccnv R))) $;

--| A relation is included in the Cartesian product of its domain and range. Exercise 4.12(t) of [Mendelson] p. 235. (Contributed by NM, 3-Aug-1994.) (Proof shortened by SN, 23-Dec-2024.)
theorem relssdmrn (A2: class):
  $ wi (wrel A2) (wss A2 (cxp (cdm A2) (crn A2))) $;

--| If the ` R ` -image of a class ` A ` is a subclass of ` B ` , then the restriction of ` R ` to ` A ` is a subset of the Cartesian product of ` A ` and ` B ` . (Contributed by RP, 24-Dec-2019.)
theorem resssxp (A2 B2 R: class):
  $ wb (wss (cima R A2) B2) (wss (cres R A2) (cxp A2 B2)) $;

--| The converse is a subset of the cartesian product of range and domain. (Contributed by Mario Carneiro, 2-Jan-2017.)
theorem cnvssrndm (A2: class):
  $ wss (ccnv A2) (cxp (crn A2) (cdm A2)) $;

--| Composition as a subset of the Cartesian product of factors. (Contributed by Mario Carneiro, 12-Jan-2017.)
theorem cossxp (A2 B2: class):
  $ wss (ccom A2 B2) (cxp (cdm B2) (crn A2)) $;

--| Two ways to describe the structure of a two-place operation. (Contributed by NM, 17-Dec-2008.)
theorem relrelss (A2: class):
  $ wb (wa (wrel A2) (wrel (cdm A2))) (wss A2 (cxp (cxp cvv cvv) cvv)) $;

--| The membership relation for a relation is inherited by class union. (Contributed by NM, 17-Sep-2006.)
theorem unielrel (A2 R: class):
  $ wi (wa (wrel R) (wcel A2 R)) (wcel (cuni A2) (cuni R)) $;

--| The double union of a relation is its field. (Contributed by NM, 17-Sep-2006.)
theorem relfld (R: class):
  $ wi (wrel R) (wceq (cuni (cuni R)) (cun (cdm R) (crn R))) $;

--| Restriction of a relation to its field. (Contributed by FL, 15-Apr-2012.) (Proof shortened by Eric Schmidt, 16-Aug-2026.)
theorem relresfld (R: class):
  $ wi (wrel R) (wceq (cres R (cuni (cuni R))) R) $;

--| Obsolete version of ~ relresfld as of 16-Aug-2026. (Contributed by FL, 15-Apr-2012.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem relresfldOLD (R: class):
  $ wi (wrel R) (wceq (cres R (cuni (cuni R))) R) $;

--| Composition with the identity relation restricted to a relation's field. (Contributed by FL, 2-May-2011.)
theorem relcoi2 (R: class):
  $ wi (wrel R) (wceq (ccom (cres cid (cuni (cuni R))) R) R) $;

--| Composition with the identity relation restricted to a relation's field. (Contributed by FL, 8-May-2011.) (Proof shortened by OpenAI, 3-Jul-2020.)
theorem relcoi1 (R: class):
  $ wi (wrel R) (wceq (ccom R (cres cid (cuni (cuni R)))) R) $;

--| The double union of the converse of a class is its field. (Contributed by NM, 4-Jun-2008.)
theorem unidmrn (A2: class):
  $ wceq (cuni (cuni (ccnv A2))) (cun (cdm A2) (crn A2)) $;

--| if ` R ` is a relation, its double union equals the double union of its converse. (Contributed by FL, 5-Jan-2009.)
theorem relcnvfld (R: class):
  $ wi (wrel R) (wceq (cuni (cuni R)) (cuni (cuni (ccnv R)))) $;

--| Alternate definition of domain ~ df-dm that doesn't require dummy variables. (Contributed by NM, 2-Aug-2010.)
theorem dfdm2 (A2: class):
  $ wceq (cdm A2) (cuni (cuni (ccom (ccnv A2) A2))) $;

--| The double class union of a nonempty Cartesian product is the union of it members. (Contributed by NM, 17-Sep-2006.)
theorem unixp (A2 B2: class):
  $ wi (wne (cxp A2 B2) c0) (wceq (cuni (cuni (cxp A2 B2))) (cun A2 B2)) $;

--| A Cartesian product is empty iff its union is empty. (Contributed by NM, 20-Sep-2006.)
theorem unixp0 (A2 B2: class):
  $ wb (wceq (cxp A2 B2) c0) (wceq (cuni (cxp A2 B2)) c0) $;

--| Field of a Cartesian square. (Contributed by FL, 10-Oct-2009.)
theorem unixpid (A2: class):
  $ wceq (cuni (cuni (cxp A2 A2))) A2 $;

--| Restriction of a class to a singleton. (Contributed by Mario Carneiro, 28-Dec-2014.) (Proof shortened by Peter Mazsa, 2-Oct-2022.)
theorem ressn (A2 B2: class):
  $ wceq (cres A2 (csn B2)) (cxp (csn B2) (cima A2 (csn B2))) $;

--| The converse of an intersection is the intersection of the converse. (Contributed by FL, 15-Oct-2012.)
theorem cnviin {x3: setvar} (A2: class) (B2: class x3):
  $ wi (wne A2 c0) (wceq (ccnv (ciin x3 A2 B2)) (ciin x3 A2 (ccnv B2))) $;

--| The converse of a partial order is a partial order. (Contributed by NM, 15-Jun-2005.)
theorem cnvpo (A2 R: class):
  $ wb (wpo A2 R) (wpo A2 (ccnv R)) $;

--| The converse of a strict order relation is a strict order relation. (Contributed by NM, 15-Jun-2005.)
theorem cnvso (A2 R: class):
  $ wb (wor A2 R) (wor A2 (ccnv R)) $;

--| Composition of two Cartesian products. (Contributed by Thierry Arnoux, 17-Nov-2017.)
theorem xpco (A2 B2 C: class):
  $ wi (wne B2 c0) (wceq (ccom (cxp B2 C) (cxp A2 B2)) (cxp A2 C)) $;

--| Composition of two Cartesian squares. (Contributed by Thierry Arnoux, 14-Jan-2018.)
theorem xpcoid (A2: class):
  $ wceq (ccom (cxp A2 A2) (cxp A2 A2)) (cxp A2 A2) $;

--| Membership in a Cartesian product with a singleton. (Contributed by Thierry Arnoux, 10-Apr-2020.) (Proof shortened by JJ, 14-Jul-2021.)
theorem elsnxp {y1: setvar} (A2 V X Z: class):
  $ wi (wcel X V) (wb (wcel Z (cxp (csn X) A2)) (wrex y1 (wceq Z (cop X (cv y1))) A2)) $;

--| There is a unique ordered pair fulfilling a wff iff there are uniquely two sets fulfilling a corresponding wff. (Contributed by AV, 1-Jul-2023.)
theorem reu3op {x3 y1 p a b: setvar} (ps: wff p) (ch: wff x3 y1 a b) (X Y: class):
  $ wi (wceq (cv p) (cop (cv a) (cv b))) (wb ps ch) $ >
  $ wb (wreu p ps (cxp X Y)) (wa (wrex a (wrex b ch Y) X) (wrex x3 (wrex y1 (wral a (wral b (wi ch (wceq (cop (cv x3) (cv y1)) (cop (cv a) (cv b)))) Y) X) Y) X)) $;

--| There is a unique ordered pair fulfilling a wff iff there are uniquely two sets fulfilling a corresponding wff. (Contributed by AV, 23-Jun-2023.)
theorem reuop {x3 y1 p a b: setvar} (ps: wff p) (ch th: wff x3 y1 a b) (X Y: class):
  $ wi (wceq (cv p) (cop (cv a) (cv b))) (wb ps ch) $ >
  $ wi (wceq (cv p) (cop (cv x3) (cv y1))) (wb ps th) $ >
  $ wb (wreu p ps (cxp X Y)) (wrex a (wrex b (wa ch (wral x3 (wral y1 (wi th (wceq (cop (cv x3) (cv y1)) (cop (cv a) (cv b)))) Y) X)) Y) X) $;

--| There is a unique ordered pair fulfilling a wff iff there are uniquely two sets fulfilling a corresponding wff. (Contributed by AV, 24-Jun-2023.) (Revised by AV, 1-Jul-2023.)
theorem opreu2reurex {p a b: setvar} (ph: wff p) (ch: wff a b) (A2 B2: class):
  $ wi (wceq (cv p) (cop (cv a) (cv b))) (wb ph ch) $ >
  $ wb (wreu p ph (cxp A2 B2)) (wa (wreu a (wrex b ch B2) A2) (wreu b (wrex a ch A2) B2)) $;

--| If there is a unique ordered pair fulfilling a wff, then there is a double restricted unique existential qualification fulfilling a corresponding wff. (Contributed by AV, 25-Jun-2023.) (Revised by AV, 2-Jul-2023.)
theorem opreu2reu {p a b: setvar} (ph: wff p) (ch: wff a b) (A2 B2: class):
  $ wi (wceq (cv p) (cop (cv a) (cv b))) (wb ph ch) $ >
  $ wi (wreu p ph (cxp A2 B2)) (wreu a (wreu b ch B2) A2) $;

--| Quantifier-free definition of a partial ordering. (Contributed by Scott Fenton, 22-Feb-2013.) (Proof shortened by Peter Mazsa, 2-Oct-2022.)
theorem dfpo2 (A2 R: class):
  $ wb (wpo A2 R) (wa (wceq (cin R (cres cid A2)) c0) (wss (ccom (cin R (cxp A2 A2)) (cin R (cxp A2 A2))) R)) $;

--| Distribute proper substitution through a composition of relations. (Contributed by RP, 28-Jun-2020.)
theorem csbcog {x3: setvar} (A2 B2 C V: class x3):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (ccom B2 C)) (ccom (csb x3 A2 B2) (csb x3 A2 C))) $;

--| Condition for restriction of a singleton to be empty. (Contributed by Scott Fenton, 9-Aug-2024.)
theorem snres0 (A2 B2 C: class):
  $ wcel B2 cvv $ >
  $ wb (wceq (cres (csn (cop A2 B2)) C) c0) (wn (wcel A2 C)) $;

--| The image is unaffected by intersection with the domain. (Contributed by Scott Fenton, 17-Dec-2021.)
theorem imaindm (A2 R: class):
  $ wceq (cima R A2) (cima R (cin A2 (cdm R))) $;

--| The predecessors symbol.
term cpred (A2 R X: class): class;

--| Define the predecessor class of a binary relation. This is the class of all elements ` y ` of ` A ` such that ` y R X ` (see ~ elpred ). (Contributed by Scott Fenton, 29-Jan-2011.)
axiom df_pred (A2 R X: class):
  $ wceq (cpred A2 R X) (cin A2 (cima (ccnv R) (csn X))) $;

--| Equality theorem for the predecessor class. (Contributed by Scott Fenton, 13-Jun-2018.)
theorem predeq123 (A2 B2 R S X Y: class):
  $ wi (w3a (wceq R S) (wceq A2 B2) (wceq X Y)) (wceq (cpred A2 R X) (cpred B2 S Y)) $;

--| Equality theorem for the predecessor class. (Contributed by Scott Fenton, 2-Feb-2011.)
theorem predeq1 (A2 R S X: class):
  $ wi (wceq R S) (wceq (cpred A2 R X) (cpred A2 S X)) $;

--| Equality theorem for the predecessor class. (Contributed by Scott Fenton, 2-Feb-2011.)
theorem predeq2 (A2 B2 R X: class):
  $ wi (wceq A2 B2) (wceq (cpred A2 R X) (cpred B2 R X)) $;

--| Equality theorem for the predecessor class. (Contributed by Scott Fenton, 2-Feb-2011.)
theorem predeq3 (A2 R X Y: class):
  $ wi (wceq X Y) (wceq (cpred A2 R X) (cpred A2 R Y)) $;

--| Bound-variable hypothesis builder for the predecessor class. (Contributed by Scott Fenton, 9-Jun-2018.)
theorem nfpred {x3: setvar} (A2 R X: class x3):
  $ wnfc x3 R $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 X $ >
  $ wnfc x3 (cpred A2 R X) $;

--| Move class substitution in and out of the predecessor class of a relation. (Contributed by ML, 25-Oct-2020.)
theorem csbpredg {x3: setvar} (A2 D R V X: class x3):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (cpred D R X)) (cpred (csb x3 A2 D) (csb x3 A2 R) (csb x3 A2 X))) $;

--| If ` A ` is a subset of ` B ` , then their predecessor classes are also subsets. (Contributed by Scott Fenton, 2-Feb-2011.)
theorem predpredss (A2 B2 R X: class):
  $ wi (wss A2 B2) (wss (cpred A2 R X) (cpred B2 R X)) $;

--| The predecessor class of ` A ` is a subset of ` A ` . (Contributed by Scott Fenton, 2-Feb-2011.)
theorem predss (A2 R X: class):
  $ wss (cpred A2 R X) A2 $;

--| Another subset/predecessor class relationship. (Contributed by Scott Fenton, 6-Feb-2011.)
theorem sspred (A2 B2 R X: class):
  $ wi (wa (wss B2 A2) (wss (cpred A2 R X) B2)) (wceq (cpred A2 R X) (cpred B2 R X)) $;

--| An alternate definition of predecessor class when ` X ` is a set. (Contributed by Scott Fenton, 8-Feb-2011.)
theorem dfpred2 {y1: setvar} (A2: class y1) (R X: class):
  $ wcel X cvv $ >
  $ wceq (cpred A2 R X) (cin A2 (cab y1 (wbr (cv y1) X R))) $;

--| An alternate definition of predecessor class when ` X ` is a set. (Contributed by Scott Fenton, 13-Jun-2018.)
theorem dfpred3 {y1: setvar} (A2 R X: class):
  $ wcel X cvv $ >
  $ wceq (cpred A2 R X) (crab y1 (wbr (cv y1) X R) A2) $;

--| An alternate definition of predecessor class when ` X ` is a set. (Contributed by Scott Fenton, 13-Jun-2018.)
theorem dfpred3g {y1: setvar} (A2 R: class) (V: class y1) (X: class):
  $ wi (wcel X V) (wceq (cpred A2 R X) (crab y1 (wbr (cv y1) X R) A2)) $;

--| Membership in a predecessor class. (Contributed by Scott Fenton, 17-Apr-2011.) Generalize to closed form. (Revised by BJ, 16-Oct-2024.)
theorem elpredgg (A2 R V W X Y: class):
  $ wi (wa (wcel X V) (wcel Y W)) (wb (wcel Y (cpred A2 R X)) (wa (wcel Y A2) (wbr Y X R))) $;

--| Membership in a predecessor class. (Contributed by Scott Fenton, 17-Apr-2011.) (Proof shortened by BJ, 16-Oct-2024.)
theorem elpredg (A2 B2 R X Y: class):
  $ wi (wa (wcel X B2) (wcel Y A2)) (wb (wcel Y (cpred A2 R X)) (wbr Y X R)) $;

--| Membership in a predecessor class - implicative version. (Contributed by Scott Fenton, 13-Apr-2011.) (Revised by NM, 5-Apr-2016.) (Proof shortened by BJ, 16-Oct-2024.)
theorem elpredimg (A2 R V X Y: class):
  $ wi (wa (wcel X V) (wcel Y (cpred A2 R X))) (wbr Y X R) $;

--| Membership in a predecessor class - implicative version. (Contributed by Scott Fenton, 9-May-2012.) (Proof shortened by BJ, 16-Oct-2024.)
theorem elpredim (A2 R X Y: class):
  $ wcel X cvv $ >
  $ wi (wcel Y (cpred A2 R X)) (wbr Y X R) $;

--| Membership in a predecessor class. (Contributed by Scott Fenton, 4-Feb-2011.) (Proof shortened by BJ, 16-Oct-2024.)
theorem elpred (A2 D R X Y: class):
  $ wcel Y cvv $ >
  $ wi (wcel X D) (wb (wcel Y (cpred A2 R X)) (wa (wcel Y A2) (wbr Y X R))) $;

--| The predecessor class exists when ` A ` does. (Contributed by Scott Fenton, 8-Feb-2011.) Generalize to closed form. (Revised by BJ, 27-Oct-2024.)
theorem predexg (A2 R V X: class):
  $ wi (wcel A2 V) (wcel (cpred A2 R X) cvv) $;

--| Alternate definition of well-founded relation. (Contributed by Scott Fenton, 2-Feb-2011.)
theorem dffr4 {x3 y1: setvar} (A2 R: class):
  $ wb (wfr A2 R) (wal x3 (wi (wa (wss (cv x3) A2) (wne (cv x3) c0)) (wrex y1 (wceq (cpred (cv x3) R (cv y1)) c0) (cv x3)))) $;

--| Membership in the predecessor class implies membership in the base class. (Contributed by Scott Fenton, 11-Feb-2011.)
theorem predel (A2 R X Y: class):
  $ wi (wcel Y (cpred A2 R X)) (wcel Y A2) $;

--| If ` R ` is transitive over ` A ` and ` Y R X ` , then ` Pred ( R , A , Y ) ` is a subclass of ` Pred ( R , A , X ) ` . (Contributed by Scott Fenton, 28-Oct-2024.)
theorem predtrss (A2 R X Y: class):
  $ wi (w3a (wss (ccom (cin R (cxp A2 A2)) (cin R (cxp A2 A2))) R) (wcel Y (cpred A2 R X)) (wcel X A2)) (wss (cpred A2 R Y) (cpred A2 R X)) $;

--| Property of the predecessor class for partial orders. (Contributed by Scott Fenton, 28-Apr-2012.) (Proof shortened by Scott Fenton, 28-Oct-2024.)
theorem predpo (A2 R X Y: class):
  $ wi (wa (wpo A2 R) (wcel X A2)) (wi (wcel Y (cpred A2 R X)) (wss (cpred A2 R Y) (cpred A2 R X))) $;

--| Property of the predecessor class for strict total orders. (Contributed by Scott Fenton, 11-Feb-2011.)
theorem predso (A2 R X Y: class):
  $ wi (wa (wor A2 R) (wcel X A2)) (wi (wcel Y (cpred A2 R X)) (wss (cpred A2 R Y) (cpred A2 R X))) $;

--| If ` R ` is set-like in ` A ` , then all predecessor classes of elements of ` A ` exist. (Contributed by Scott Fenton, 20-Feb-2011.) (Revised by Mario Carneiro, 26-Jun-2015.)
theorem setlikespec (A2 R X: class):
  $ wi (wa (wcel X A2) (wse A2 R)) (wcel (cpred A2 R X) cvv) $;

--| Idempotent law for the predecessor class. (Contributed by Scott Fenton, 29-Mar-2011.)
theorem predidm (A2 R X: class):
  $ wceq (cpred (cpred A2 R X) R X) (cpred A2 R X) $;

--| Intersection law for predecessor classes. (Contributed by Scott Fenton, 29-Mar-2011.)
theorem predin (A2 B2 R X: class):
  $ wceq (cpred (cin A2 B2) R X) (cin (cpred A2 R X) (cpred B2 R X)) $;

--| Union law for predecessor classes. (Contributed by Scott Fenton, 29-Mar-2011.)
theorem predun (A2 B2 R X: class):
  $ wceq (cpred (cun A2 B2) R X) (cun (cpred A2 R X) (cpred B2 R X)) $;

--| Difference law for predecessor classes. (Contributed by Scott Fenton, 14-Apr-2011.)
theorem preddif (A2 B2 R X: class):
  $ wceq (cpred (cdif A2 B2) R X) (cdif (cpred A2 R X) (cpred B2 R X)) $;

--| The predecessor under the membership relation is equivalent to an intersection. (Contributed by Scott Fenton, 27-Mar-2011.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem predep (A2 B2 X: class):
  $ wi (wcel X B2) (wceq (cpred A2 cep X) (cin A2 X)) $;

--| The class of predecessors of an element of a transitive class for the membership relation is that element. (Contributed by BJ, 12-Oct-2024.)
theorem trpred (A2 X: class):
  $ wi (wa (wtr A2) (wcel X A2)) (wceq (cpred A2 cep X) X) $;

--| A property of classes that are downward closed under predecessor. (Contributed by Scott Fenton, 13-Apr-2011.)
theorem preddowncl {x3: setvar} (A2 B2 R: class) (X: class x3):
  $ wi (wa (wss B2 A2) (wral x3 (wss (cpred A2 R (cv x3)) B2) B2)) (wi (wcel X B2) (wceq (cpred B2 R X) (cpred A2 R X))) $;

--| Given a partial ordering, a class is not a member of its predecessor class. (Contributed by Scott Fenton, 17-Apr-2011.)
theorem predpoirr (A2 R X: class):
  $ wi (wpo A2 R) (wn (wcel X (cpred A2 R X))) $;

--| Given a well-founded relation, a class is not a member of its predecessor class. (Contributed by Scott Fenton, 22-Apr-2011.)
theorem predfrirr (A2 R X: class):
  $ wi (wfr A2 R) (wn (wcel X (cpred A2 R X))) $;

--| The predecessor class over ` (/) ` is always ` (/) ` . (Contributed by Scott Fenton, 16-Apr-2011.) (Proof shortened by AV, 11-Jun-2021.)
theorem pred0 (R X: class):
  $ wceq (cpred c0 R X) c0 $;

--| Alternate definition of set-like relationships. (Contributed by Scott Fenton, 19-Aug-2024.)
theorem dfse3 {x3: setvar} (A2 R: class):
  $ wb (wse A2 R) (wral x3 (wcel (cpred A2 R (cv x3)) cvv) A2) $;

--| Subset carries from relation to predecessor class. (Contributed by Scott Fenton, 25-Nov-2024.)
theorem predrelss (A2 R S X: class):
  $ wi (wss R S) (wss (cpred A2 R X) (cpred A2 S X)) $;

--| The predecessor of a proper class is empty. (Contributed by Scott Fenton, 25-Nov-2024.)
theorem predprc (A2 R X: class):
  $ wi (wn (wcel X cvv)) (wceq (cpred A2 R X) c0) $;

--| Predecessor class is unaffected by restriction to the base class. (Contributed by Scott Fenton, 25-Nov-2024.)
theorem predres (A2 R X: class):
  $ wceq (cpred A2 R X) (cpred A2 (cres R A2) X) $;

--| Every nonempty (possibly proper) subclass of a class ` A ` with a well-founded set-like partial order ` R ` has a minimal element. The additional condition of partial order over ~ frmin enables avoiding the axiom of infinity. (Contributed by Scott Fenton, 11-Feb-2022.)
theorem frpomin {x3 y1: setvar} (A2 B2 R: class):
  $ wi (wa (w3a (wfr A2 R) (wpo A2 R) (wse A2 R)) (wa (wss B2 A2) (wne B2 c0))) (wrex x3 (wral y1 (wn (wbr (cv y1) (cv x3) R)) B2) B2) $;

--| Every nonempty (possibly proper) subclass of a class ` A ` with a well-founded set-like partial order ` R ` has a minimal element. The additional condition of partial order over ~ frmin enables avoiding the axiom of infinity. (Contributed by Scott Fenton, 11-Feb-2022.)
theorem frpomin2 {x3: setvar} (A2 B2 R: class):
  $ wi (wa (w3a (wfr A2 R) (wpo A2 R) (wse A2 R)) (wa (wss B2 A2) (wne B2 c0))) (wrex x3 (wceq (cpred B2 R (cv x3)) c0) B2) $;

--| The principle of well-founded induction over a partial order. This theorem is a version of ~ frind that does not require the axiom of infinity and can be used to prove ~ wfi and ~ tfi . (Contributed by Scott Fenton, 11-Feb-2022.)
theorem frpoind {y1: setvar} (A2 B2 R: class):
  $ wi (wa (w3a (wfr A2 R) (wpo A2 R) (wse A2 R)) (wa (wss B2 A2) (wral y1 (wi (wss (cpred A2 R (cv y1)) B2) (wcel (cv y1) B2)) A2))) (wceq A2 B2) $;

--| Well-Founded Induction Schema (variant). If a property passes from all elements less than ` y ` of a well-founded set-like partial order class ` A ` to ` y ` itself (induction hypothesis), then the property holds for all elements of ` A ` . (Contributed by Scott Fenton, 11-Feb-2022.)
theorem frpoinsg {y1 z: setvar} (ph: wff y1) (A2 R: class):
  $ wi (wa (w3a (wfr A2 R) (wpo A2 R) (wse A2 R)) (wcel (cv y1) A2)) (wi (wral z (wsbc y1 ph (cv z)) (cpred A2 R (cv y1))) ph) $ >
  $ wi (w3a (wfr A2 R) (wpo A2 R) (wse A2 R)) (wral y1 ph A2) $;

--| Well-Founded Induction schema, using implicit substitution. (Contributed by Scott Fenton, 24-Aug-2022.)
theorem frpoins2fg {y1 z: setvar} (ph: wff y1) (ps: wff y1 z) (A2 R: class):
  $ wi (wcel (cv y1) A2) (wi (wral z ps (cpred A2 R (cv y1))) ph) $ >
  $ wnf y1 ps $ >
  $ wi (wceq (cv y1) (cv z)) (wb ph ps) $ >
  $ wi (w3a (wfr A2 R) (wpo A2 R) (wse A2 R)) (wral y1 ph A2) $;

--| Well-Founded Induction schema, using implicit substitution. (Contributed by Scott Fenton, 24-Aug-2022.)
theorem frpoins2g {y1 z: setvar} (ph: wff y1) (ps: wff z) (A2 R: class):
  $ wi (wcel (cv y1) A2) (wi (wral z ps (cpred A2 R (cv y1))) ph) $ >
  $ wi (wceq (cv y1) (cv z)) (wb ph ps) $ >
  $ wi (w3a (wfr A2 R) (wpo A2 R) (wse A2 R)) (wral y1 ph A2) $;

--| Well-Founded Induction schema, using implicit substitution. (Contributed by Scott Fenton, 19-Aug-2024.)
theorem frpoins3g {x3 y1: setvar} (ph: wff x3) (ps ch: wff y1) (A2: class) (B2: class y1) (R: class):
  $ wi (wcel (cv x3) A2) (wi (wral y1 ps (cpred A2 R (cv x3))) ph) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wceq (cv x3) B2) (wb ph ch) $ >
  $ wi (wa (w3a (wfr A2 R) (wpo A2 R) (wse A2 R)) (wcel B2 A2)) ch $;

--| All nonempty subclasses of a class having a well-ordered set-like relation have minimal elements for that relation. Proposition 6.26 of [TakeutiZaring] p. 31. (Contributed by Scott Fenton, 29-Jan-2011.) (Revised by Mario Carneiro, 26-Jun-2015.) (Proof shortened by Scott Fenton, 17-Nov-2024.)
theorem tz6_26 {y1: setvar} (A2 B2 R: class):
  $ wi (wa (wa (wwe A2 R) (wse A2 R)) (wa (wss B2 A2) (wne B2 c0))) (wrex y1 (wceq (cpred B2 R (cv y1)) c0) B2) $;

--| All nonempty subclasses of a class having a well-ordered set-like relation ` R ` have ` R `-minimal elements. Proposition 6.26 of [TakeutiZaring] p. 31. (Contributed by Scott Fenton, 14-Apr-2011.) (Revised by Mario Carneiro, 26-Jun-2015.)
theorem tz6_26i {y1: setvar} (A2 B2 R: class):
  $ wwe A2 R $ >
  $ wse A2 R $ >
  $ wi (wa (wss B2 A2) (wne B2 c0)) (wrex y1 (wceq (cpred B2 R (cv y1)) c0) B2) $;

--| The Principle of Well-Ordered Induction. Theorem 6.27 of [TakeutiZaring] p. 32. This principle states that if ` B ` is a subclass of a well-ordered class ` A ` with the property that every element of ` B ` whose inital segment is included in ` A ` is itself equal to ` A ` . (Contributed by Scott Fenton, 29-Jan-2011.) (Revised by Mario Carneiro, 26-Jun-2015.) (Proof shortened by Scott Fenton, 17-Nov-2024.)
theorem wfi {y1: setvar} (A2 B2 R: class):
  $ wi (wa (wa (wwe A2 R) (wse A2 R)) (wa (wss B2 A2) (wral y1 (wi (wss (cpred A2 R (cv y1)) B2) (wcel (cv y1) B2)) A2))) (wceq A2 B2) $;

--| The Principle of Well-Ordered Induction. Theorem 6.27 of [TakeutiZaring] p. 32. This principle states that if ` B ` is a subclass of a well-ordered class ` A ` with the property that every element of ` B ` whose inital segment is included in ` A ` is itself equal to ` A ` . (Contributed by Scott Fenton, 29-Jan-2011.) (Revised by Mario Carneiro, 26-Jun-2015.)
theorem wfii {y1: setvar} (A2 B2 R: class):
  $ wwe A2 R $ >
  $ wse A2 R $ >
  $ wi (wa (wss B2 A2) (wral y1 (wi (wss (cpred A2 R (cv y1)) B2) (wcel (cv y1) B2)) A2)) (wceq A2 B2) $;

--| Well-Ordered Induction Schema. If a property passes from all elements less than ` y ` of a well-ordered class ` A ` to ` y ` itself (induction hypothesis), then the property holds for all elements of ` A ` . (Contributed by Scott Fenton, 11-Feb-2011.) (Proof shortened by Scott Fenton, 17-Nov-2024.)
theorem wfisg {y1 z: setvar} (ph: wff y1) (A2 R: class):
  $ wi (wcel (cv y1) A2) (wi (wral z (wsbc y1 ph (cv z)) (cpred A2 R (cv y1))) ph) $ >
  $ wi (wa (wwe A2 R) (wse A2 R)) (wral y1 ph A2) $;

--| Well-Ordered Induction Schema. If all elements less than a given set ` x ` of the well-ordered class ` A ` have a property (induction hypothesis), then all elements of ` A ` have that property. (Contributed by Scott Fenton, 29-Jan-2011.)
theorem wfis {y1 z: setvar} (ph: wff y1) (A2 R: class):
  $ wwe A2 R $ >
  $ wse A2 R $ >
  $ wi (wcel (cv y1) A2) (wi (wral z (wsbc y1 ph (cv z)) (cpred A2 R (cv y1))) ph) $ >
  $ wi (wcel (cv y1) A2) ph $;

--| Well-Ordered Induction Schema, using implicit substitution. (Contributed by Scott Fenton, 11-Feb-2011.) (Proof shortened by Scott Fenton, 17-Nov-2024.)
theorem wfis2fg {y1 z: setvar} (ph: wff y1) (ps: wff y1 z) (A2 R: class):
  $ wnf y1 ps $ >
  $ wi (wceq (cv y1) (cv z)) (wb ph ps) $ >
  $ wi (wcel (cv y1) A2) (wi (wral z ps (cpred A2 R (cv y1))) ph) $ >
  $ wi (wa (wwe A2 R) (wse A2 R)) (wral y1 ph A2) $;

--| Well-Ordered Induction schema, using implicit substitution. (Contributed by Scott Fenton, 29-Jan-2011.)
theorem wfis2f {y1 z: setvar} (ph: wff y1) (ps: wff y1 z) (A2 R: class):
  $ wwe A2 R $ >
  $ wse A2 R $ >
  $ wnf y1 ps $ >
  $ wi (wceq (cv y1) (cv z)) (wb ph ps) $ >
  $ wi (wcel (cv y1) A2) (wi (wral z ps (cpred A2 R (cv y1))) ph) $ >
  $ wi (wcel (cv y1) A2) ph $;

--| Well-Ordered Induction Schema, using implicit substitution. (Contributed by Scott Fenton, 11-Feb-2011.)
theorem wfis2g {y1 z: setvar} (ph: wff y1) (ps: wff z) (A2 R: class):
  $ wi (wceq (cv y1) (cv z)) (wb ph ps) $ >
  $ wi (wcel (cv y1) A2) (wi (wral z ps (cpred A2 R (cv y1))) ph) $ >
  $ wi (wa (wwe A2 R) (wse A2 R)) (wral y1 ph A2) $;

--| Well-Ordered Induction schema, using implicit substitution. (Contributed by Scott Fenton, 29-Jan-2011.)
theorem wfis2 {y1 z: setvar} (ph: wff y1) (ps: wff z) (A2 R: class):
  $ wwe A2 R $ >
  $ wse A2 R $ >
  $ wi (wceq (cv y1) (cv z)) (wb ph ps) $ >
  $ wi (wcel (cv y1) A2) (wi (wral z ps (cpred A2 R (cv y1))) ph) $ >
  $ wi (wcel (cv y1) A2) ph $;

--| Well-Ordered Induction schema, using implicit substitution. (Contributed by Scott Fenton, 29-Jan-2011.)
theorem wfis3 {y1 z: setvar} (ph: wff y1) (ps ch: wff z) (A2: class) (B2: class z) (R: class):
  $ wwe A2 R $ >
  $ wse A2 R $ >
  $ wi (wceq (cv y1) (cv z)) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ph ch) $ >
  $ wi (wcel (cv y1) A2) (wi (wral z ps (cpred A2 R (cv y1))) ph) $ >
  $ wi (wcel B2 A2) ch $;

--| Extend the definition of a wff to include the ordinal predicate.
term word (A2: class): wff;

--| Extend the definition of a class to include the class of all ordinal numbers. (The 0 in the name prevents creating a file called con.html, which causes problems in Windows.)
term con0: class;

--| Extend the definition of a wff to include the limit ordinal predicate.
term wlim (A2: class): wff;

--| Extend class notation to include the successor function.
term csuc (A2: class): class;

--| Define the ordinal predicate, which is true for a class that is transitive and is well-ordered by the membership relation. Variant of definition of [BellMachover] p. 468. Some sources will define a notation for ordinal order corresponding to ` < ` and ` <_ ` but we just use ` e. ` and ` C_ ` respectively. (Contributed by NM, 17-Sep-1993.)
axiom df_ord (A2: class):
  $ wb (word A2) (wa (wtr A2) (wwe A2 cep)) $;

--| Define the class of all ordinal numbers. Definition 7.11 of [TakeutiZaring] p. 38. (Contributed by NM, 5-Jun-1994.)
axiom df_on {x3: setvar}:
  $ wceq con0 (cab x3 (word (cv x3))) $;

--| Define the limit ordinal predicate, which is true for a nonempty ordinal that is not a successor (i.e. that is the union of itself). Our definition combines the definition of Lim of [BellMachover] p. 471 and Exercise 1 of [TakeutiZaring] p. 42. See ~ dflim2 , ~ dflim3 , and ~ dflim4 for alternate definitions. (Contributed by NM, 22-Apr-1994.)
axiom df_lim (A2: class):
  $ wb (wlim A2) (w3a (word A2) (wne A2 c0) (wceq A2 (cuni A2))) $;

--| Define the successor of a class. When applied to an ordinal number, the successor means the same thing as "plus 1" (see ~ oa1suc ). Definition 7.22 of [TakeutiZaring] p. 41, who use "+ 1" to denote this function. Definition 1.4 of [Schloeder] p. 1, similarly. Ordinal natural numbers defined using this successor function and 0 as the empty set are also called von Neumann ordinals; 0 is the empty set {}, 1 is {0, {0}}, 2 is {1, {1}}, and so on. Our definition is a generalization to classes. Although it is not conventional to use it with proper classes, it has no effect on a proper class ( ~ sucprc ), so that the successor of any ordinal class is still an ordinal class ( ~ ordsuc ), simplifying certain proofs. Some authors denote the successor operation with a prime (apostrophe-like) symbol, such as Definition 6 of [Suppes] p. 134 and the definition of successor in [Mendelson] p. 246 (who uses the symbol "Suc" as a predicate to mean "is a successor ordinal"). The definition of successor of [Enderton] p. 68 denotes the operation with a plus-sign superscript. (Contributed by NM, 30-Aug-1993.)
axiom df_suc (A2: class):
  $ wceq (csuc A2) (cun A2 (csn A2)) $;

--| Equality theorem for the ordinal predicate. (Contributed by NM, 17-Sep-1993.)
theorem ordeq (A2 B2: class):
  $ wi (wceq A2 B2) (wb (word A2) (word B2)) $;

--| An ordinal number is an ordinal set. (Contributed by NM, 5-Jun-1994.)
theorem elong (A2 V: class):
  $ wi (wcel A2 V) (wb (wcel A2 con0) (word A2)) $;

--| An ordinal number is an ordinal set. (Contributed by NM, 5-Jun-1994.)
theorem elon (A2: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 con0) (word A2) $;

--| An ordinal number has the ordinal property. (Contributed by NM, 5-Jun-1994.)
theorem eloni (A2: class):
  $ wi (wcel A2 con0) (word A2) $;

--| An ordinal number is an ordinal set. Part of Definition 1.2 of [Schloeder] p. 1. (Contributed by NM, 8-Feb-2004.)
theorem elon2 (A2: class):
  $ wb (wcel A2 con0) (wa (word A2) (wcel A2 cvv)) $;

--| Equality theorem for the limit predicate. (Contributed by NM, 22-Apr-1994.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem limeq (A2 B2: class):
  $ wi (wceq A2 B2) (wb (wlim A2) (wlim B2)) $;

--| Membership well-orders every ordinal. Proposition 7.4 of [TakeutiZaring] p. 36. (Contributed by NM, 3-Apr-1994.)
theorem ordwe (A2: class):
  $ wi (word A2) (wwe A2 cep) $;

--| An ordinal class is transitive. (Contributed by NM, 3-Apr-1994.)
theorem ordtr (A2: class):
  $ wi (word A2) (wtr A2) $;

--| Membership is well-founded on an ordinal class. In other words, an ordinal class is well-founded. (Contributed by NM, 22-Apr-1994.)
theorem ordfr (A2: class):
  $ wi (word A2) (wfr A2 cep) $;

--| An element of an ordinal class is a subset of it. (Contributed by NM, 30-May-1994.)
theorem ordelss (A2 B2: class):
  $ wi (wa (word A2) (wcel B2 A2)) (wss B2 A2) $;

--| A transitive subclass of an ordinal class is ordinal. (Contributed by NM, 29-May-1994.)
theorem trssord (A2 B2: class):
  $ wi (w3a (wtr A2) (wss A2 B2) (word B2)) (word A2) $;

--| No ordinal class is a member of itself. In other words, the membership relation is irreflexive on ordinal classes. Theorem 2.2(i) of [BellMachover] p. 469, generalized to classes. Theorem 1.9(i) of [Schloeder] p. 1. We prove this without invoking the Axiom of Regularity. (Contributed by NM, 2-Jan-1994.)
theorem ordirr (A2: class):
  $ wi (word A2) (wn (wcel A2 A2)) $;

--| A member of an ordinal class is not equal to it. (Contributed by NM, 25-May-1998.)
theorem nordeq (A2 B2: class):
  $ wi (wa (word A2) (wcel B2 A2)) (wne A2 B2) $;

--| An ordinal class cannot be an element of one of its members. Variant of first part of Theorem 2.2(vii) of [BellMachover] p. 469. (Contributed by NM, 3-Apr-1994.)
theorem ordn2lp (A2 B2: class):
  $ wi (word A2) (wn (wa (wcel A2 B2) (wcel B2 A2))) $;

--| A nonempty subclass of an ordinal class has a minimal element. Proposition 7.5 of [TakeutiZaring] p. 36. (Contributed by NM, 18-Feb-2004.) (Revised by David Abernethy, 16-Mar-2011.)
theorem tz7_5 {x3: setvar} (A2: class x3) (B2: class):
  $ wi (w3a (word A2) (wss B2 A2) (wne B2 c0)) (wrex x3 (wceq (cin B2 (cv x3)) c0) B2) $;

--| An element of an ordinal class is ordinal. Proposition 7.6 of [TakeutiZaring] p. 36. Lemma 1.3 of [Schloeder] p. 1. (Contributed by NM, 23-Apr-1994.)
theorem ordelord (A2 B2: class):
  $ wi (wa (word A2) (wcel B2 A2)) (word B2) $;

--| The class of all ordinal numbers is transitive. (Contributed by NM, 4-May-2009.)
theorem tron:
  $ wtr con0 $;

--| An element of an ordinal class is an ordinal number. Lemma 1.3 of [Schloeder] p. 1. (Contributed by NM, 26-Oct-2003.)
theorem ordelon (A2 B2: class):
  $ wi (wa (word A2) (wcel B2 A2)) (wcel B2 con0) $;

--| An element of an ordinal number is an ordinal number. Theorem 2.2(iii) of [BellMachover] p. 469. Lemma 1.3 of [Schloeder] p. 1. (Contributed by NM, 26-Oct-2003.)
theorem onelon (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 A2)) (wcel B2 con0) $;

--| A transitive class belongs to an ordinal class iff it is strictly included in it. Proposition 7.7 of [TakeutiZaring] p. 37. (Contributed by NM, 5-May-1994.)
theorem tz7_7 (A2 B2: class):
  $ wi (wa (word A2) (wtr B2)) (wb (wcel B2 A2) (wa (wss B2 A2) (wne B2 A2))) $;

--| For ordinal classes, membership is equivalent to strict inclusion. Corollary 7.8 of [TakeutiZaring] p. 37. (Contributed by NM, 25-Nov-1995.)
theorem ordelssne (A2 B2: class):
  $ wi (wa (word A2) (word B2)) (wb (wcel A2 B2) (wa (wss A2 B2) (wne A2 B2))) $;

--| For ordinal classes, membership is equivalent to strict inclusion. Corollary 7.8 of [TakeutiZaring] p. 37. (Contributed by NM, 17-Jun-1998.)
theorem ordelpss (A2 B2: class):
  $ wi (wa (word A2) (word B2)) (wb (wcel A2 B2) (wpss A2 B2)) $;

--| ~ ordelpss with an antecedent removed. (Contributed by Andrew Salmon, 25-Jul-2011.)
theorem ordpss (A2 B2: class):
  $ wi (word B2) (wi (wcel A2 B2) (wpss A2 B2)) $;

--| For ordinal classes, inclusion is equivalent to membership or equality. (Contributed by NM, 25-Nov-1995.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem ordsseleq (A2 B2: class):
  $ wi (wa (word A2) (word B2)) (wb (wss A2 B2) (wo (wcel A2 B2) (wceq A2 B2))) $;

--| The intersection of two ordinal classes is ordinal. Proposition 7.9 of [TakeutiZaring] p. 37. (Contributed by NM, 9-May-1994.)
theorem ordin (A2 B2: class):
  $ wi (wa (word A2) (word B2)) (word (cin A2 B2)) $;

--| The intersection of two ordinal numbers is an ordinal number. (Contributed by NM, 7-Apr-1995.)
theorem onin (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wcel (cin A2 B2) con0) $;

--| A trichotomy law for ordinals. Proposition 7.10 of [TakeutiZaring] p. 38. Theorem 1.9(iii) of [Schloeder] p. 1. (Contributed by NM, 10-May-1994.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem ordtri3or (A2 B2: class):
  $ wi (wa (word A2) (word B2)) (w3o (wcel A2 B2) (wceq A2 B2) (wcel B2 A2)) $;

--| A trichotomy law for ordinals. (Contributed by NM, 25-Mar-1995.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem ordtri1 (A2 B2: class):
  $ wi (wa (word A2) (word B2)) (wb (wss A2 B2) (wn (wcel B2 A2))) $;

--| A trichotomy law for ordinal numbers. (Contributed by NM, 6-Nov-2003.)
theorem ontri1 (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wb (wss A2 B2) (wn (wcel B2 A2))) $;

--| A trichotomy law for ordinals. (Contributed by NM, 25-Nov-1995.)
theorem ordtri2 (A2 B2: class):
  $ wi (wa (word A2) (word B2)) (wb (wcel A2 B2) (wn (wo (wceq A2 B2) (wcel B2 A2)))) $;

--| A trichotomy law for ordinals. (Contributed by NM, 18-Oct-1995.) (Proof shortened by Andrew Salmon, 25-Jul-2011.) (Proof shortened by JJ, 24-Sep-2021.)
theorem ordtri3 (A2 B2: class):
  $ wi (wa (word A2) (word B2)) (wb (wceq A2 B2) (wn (wo (wcel A2 B2) (wcel B2 A2)))) $;

--| A trichotomy law for ordinals. (Contributed by NM, 1-Nov-2003.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem ordtri4 (A2 B2: class):
  $ wi (wa (word A2) (word B2)) (wb (wceq A2 B2) (wa (wss A2 B2) (wn (wcel A2 B2)))) $;

--| An ordinal class and its singleton are disjoint. (Contributed by NM, 19-May-1998.)
theorem orddisj (A2: class):
  $ wi (word A2) (wceq (cin A2 (csn A2)) c0) $;

--| The ordinal class is well-founded. This proof does not require the axiom of regularity. This lemma is used in ~ ordon (through ~ epweon ) in order to eliminate the need for the axiom of regularity. (Contributed by NM, 17-May-1994.)
theorem onfr:
  $ wfr con0 cep $;

--| Relationship between membership and proper subset of an ordinal number. (Contributed by NM, 15-Sep-1995.)
theorem onelpss (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wb (wcel A2 B2) (wa (wss A2 B2) (wne A2 B2))) $;

--| Relationship between subset and membership of an ordinal number. (Contributed by NM, 15-Sep-1995.)
theorem onsseleq (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wb (wss A2 B2) (wo (wcel A2 B2) (wceq A2 B2))) $;

--| An element of an ordinal number is a subset of the number. (Contributed by NM, 5-Jun-1994.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem onelss (A2 B2: class):
  $ wi (wcel A2 con0) (wi (wcel B2 A2) (wss B2 A2)) $;

--| The elementhood relation on the ordinals is complete, so we have triality. Theorem 1.9(iii) of [Schloeder] p. 1. See ~ ordtri3or . (Contributed by RP, 15-Jan-2025.)
theorem oneltri (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (w3o (wcel A2 B2) (wcel B2 A2) (wceq A2 B2)) $;

--| Transitive law for ordinal classes. (Contributed by NM, 12-Dec-2004.)
theorem ordtr1 (A2 B2 C: class):
  $ wi (word C) (wi (wa (wcel A2 B2) (wcel B2 C)) (wcel A2 C)) $;

--| Transitive law for ordinal classes. (Contributed by NM, 12-Dec-2004.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem ordtr2 (A2 B2 C: class):
  $ wi (wa (word A2) (word C)) (wi (wa (wss A2 B2) (wcel B2 C)) (wcel A2 C)) $;

--| Transitive law for ordinal classes. (Contributed by Mario Carneiro, 30-Dec-2014.) (Proof shortened by JJ, 24-Sep-2021.)
theorem ordtr3 (A2 B2 C: class):
  $ wi (wa (word B2) (word C)) (wi (wcel A2 B2) (wo (wcel A2 C) (wcel C B2))) $;

--| Transitive law for ordinal numbers. Theorem 7M(b) of [Enderton] p. 192. Theorem 1.9(ii) of [Schloeder] p. 1. (Contributed by NM, 11-Aug-1994.)
theorem ontr1 (A2 B2 C: class):
  $ wi (wcel C con0) (wi (wa (wcel A2 B2) (wcel B2 C)) (wcel A2 C)) $;

--| Transitive law for ordinal numbers. Exercise 3 of [TakeutiZaring] p. 40. (Contributed by NM, 6-Nov-2003.)
theorem ontr2 (A2 B2 C: class):
  $ wi (wa (wcel A2 con0) (wcel C con0)) (wi (wa (wss A2 B2) (wcel B2 C)) (wcel A2 C)) $;

--| Ordinal less than is equivalent to having an ordinal between them. (Contributed by Scott Fenton, 8-Aug-2024.)
theorem onelssex {b: setvar} (A2 C: class):
  $ wi (wa (wcel A2 con0) (wcel C con0)) (wb (wcel A2 C) (wrex b (wss A2 (cv b)) C)) $;

--| The union of an ordinal stays the same if a subset equal to one of its elements is removed. (Contributed by NM, 10-Dec-2004.)
theorem ordunidif (A2 B2: class):
  $ wi (wa (word A2) (wcel B2 A2)) (wceq (cuni (cdif A2 B2)) (cuni A2)) $;

--| If ` B ` is smaller than ` A ` , then it equals the intersection of the difference. Exercise 11 in [TakeutiZaring] p. 44. (Contributed by Andrew Salmon, 14-Nov-2011.)
theorem ordintdif (A2 B2: class):
  $ wi (w3a (word A2) (word B2) (wne (cdif A2 B2) c0)) (wceq B2 (cint (cdif A2 B2))) $;

--| If a property is true for an ordinal number, then the minimum ordinal number for which it is true is smaller or equal. Theorem Schema 61 of [Suppes] p. 228. (Contributed by NM, 3-Oct-2003.)
theorem onintss {x3: setvar} (ph: wff x3) (ps: wff) (A2: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 con0) (wi ps (wss (cint (crab x3 ph con0)) A2)) $;

--| A way to show that an ordinal number equals the minimum of a collection of ordinal numbers: it must be in the collection, and it must not be larger than any member of the collection. (Contributed by NM, 14-Nov-2003.)
theorem oneqmini {x3: setvar} (A2 B2: class):
  $ wi (wss B2 con0) (wi (wa (wcel A2 B2) (wral x3 (wn (wcel (cv x3) B2)) A2)) (wceq A2 (cint B2))) $;

--| The empty set is an ordinal class. Remark 1.5 of [Schloeder] p. 1. (Contributed by NM, 11-May-1994.)
theorem ord0:
  $ word c0 $;

--| The empty set is an ordinal number. Corollary 7N(b) of [Enderton] p. 193. Remark 1.5 of [Schloeder] p. 1. (Contributed by NM, 17-Sep-1993.)
theorem _0elon:
  $ wcel c0 con0 $;

--| A nonempty ordinal contains the empty set. Lemma 1.10 of [Schloeder] p. 2. (Contributed by NM, 25-Nov-1995.)
theorem ord0eln0 (A2: class):
  $ wi (word A2) (wb (wcel c0 A2) (wne A2 c0)) $;

--| An ordinal number contains zero iff it is nonzero. (Contributed by NM, 6-Dec-2004.)
theorem on0eln0 (A2: class):
  $ wi (wcel A2 con0) (wb (wcel c0 A2) (wne A2 c0)) $;

--| An alternate definition of a limit ordinal. (Contributed by NM, 4-Nov-2004.)
theorem dflim2 (A2: class):
  $ wb (wlim A2) (w3a (word A2) (wcel c0 A2) (wceq A2 (cuni A2))) $;

--| The intersection of the class of ordinal numbers is the empty set. (Contributed by NM, 20-Oct-2003.)
theorem inton:
  $ wceq (cint con0) c0 $;

--| The empty set is not a limit ordinal. (Contributed by NM, 24-Mar-1995.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem nlim0:
  $ wn (wlim c0) $;

--| A limit ordinal is ordinal. (Contributed by NM, 4-May-1995.)
theorem limord (A2: class):
  $ wi (wlim A2) (word A2) $;

--| A limit ordinal is its own supremum (union). Lemma 2.13 of [Schloeder] p. 5. (Contributed by NM, 4-May-1995.)
theorem limuni (A2: class):
  $ wi (wlim A2) (wceq A2 (cuni A2)) $;

--| The union of a limit ordinal is a limit ordinal. (Contributed by NM, 19-Sep-2006.)
theorem limuni2 (A2: class):
  $ wi (wlim A2) (wlim (cuni A2)) $;

--| A limit ordinal contains the empty set. (Contributed by NM, 15-May-1994.)
theorem _0ellim (A2: class):
  $ wi (wlim A2) (wcel c0 A2) $;

--| A limit ordinal class that is also a set is an ordinal number. (Contributed by NM, 26-Apr-2004.)
theorem limelon (A2 B2: class):
  $ wi (wa (wcel A2 B2) (wlim A2)) (wcel A2 con0) $;

--| The class of all ordinal numbers is not empty. (Contributed by NM, 17-Sep-1995.)
theorem onn0:
  $ wne con0 c0 $;

--| Deduction associated with ~ suceq . (Contributed by Rohan Ridenour, 8-Aug-2023.)
theorem suceqd (ph: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (csuc A2) (csuc B2)) $;

--| Equality of successors. (Contributed by NM, 30-Aug-1993.) (Proof shortened by Andrew Salmon, 25-Jul-2011.)
theorem suceq (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (csuc A2) (csuc B2)) $;

--| Membership in a successor. This one-way implication does not require that either ` A ` or ` B ` be sets. Lemma 1.13 of [Schloeder] p. 2. (Contributed by NM, 6-Jun-1994.)
theorem elsuci (A2 B2: class):
  $ wi (wcel A2 (csuc B2)) (wo (wcel A2 B2) (wceq A2 B2)) $;

--| Membership in a successor. Exercise 5 of [TakeutiZaring] p. 17. (Contributed by NM, 15-Sep-1995.)
theorem elsucg (A2 B2 V: class):
  $ wi (wcel A2 V) (wb (wcel A2 (csuc B2)) (wo (wcel A2 B2) (wceq A2 B2))) $;

--| Variant of membership in a successor, requiring that ` B ` rather than ` A ` be a set. (Contributed by NM, 28-Oct-2003.)
theorem elsuc2g (A2 B2 V: class):
  $ wi (wcel B2 V) (wb (wcel A2 (csuc B2)) (wo (wcel A2 B2) (wceq A2 B2))) $;

--| Membership in a successor. Exercise 5 of [TakeutiZaring] p. 17. (Contributed by NM, 15-Sep-2003.)
theorem elsuc (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wb (wcel A2 (csuc B2)) (wo (wcel A2 B2) (wceq A2 B2)) $;

--| Membership in a successor. (Contributed by NM, 15-Sep-2003.)
theorem elsuc2 (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wb (wcel B2 (csuc A2)) (wo (wcel B2 A2) (wceq B2 A2)) $;

--| Bound-variable hypothesis builder for successor. (Contributed by NM, 15-Sep-2003.)
theorem nfsuc {x3: setvar} (A2: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 (csuc A2) $;

--| Membership in a successor. (Contributed by NM, 20-Jun-1998.)
theorem elelsuc (A2 B2: class):
  $ wi (wcel A2 B2) (wcel A2 (csuc B2)) $;

--| Membership of a successor in another class. (Contributed by NM, 29-Jun-2004.)
theorem sucel {x3 y1: setvar} (A2: class) (B2: class y1):
  $ wb (wcel (csuc A2) B2) (wrex x3 (wal y1 (wb (wcel (cv y1) (cv x3)) (wo (wcel (cv y1) A2) (wceq (cv y1) A2)))) B2) $;

--| The successor of the empty set. (Contributed by NM, 1-Feb-2005.)
theorem suc0:
  $ wceq (csuc c0) (csn c0) $;

--| A proper class is its own successor. (Contributed by NM, 3-Apr-1995.)
theorem sucprc (A2: class):
  $ wi (wn (wcel A2 cvv)) (wceq (csuc A2) A2) $;

--| The union of the successor of a set is equal to the binary union of that set with its union. (Contributed by NM, 30-Aug-1993.) Extract from ~ unisuc . (Revised by BJ, 28-Dec-2024.)
theorem unisucs (A2 V: class):
  $ wi (wcel A2 V) (wceq (cuni (csuc A2)) (cun (cuni A2) A2)) $;

--| A transitive class is equal to the union of its successor, closed form. Combines Theorem 4E of [Enderton] p. 72 and Exercise 6 of [Enderton] p. 73. (Contributed by NM, 30-Aug-1993.) Generalize from ~ unisuc . (Revised by BJ, 28-Dec-2024.)
theorem unisucg (A2 V: class):
  $ wi (wcel A2 V) (wb (wtr A2) (wceq (cuni (csuc A2)) A2)) $;

--| A transitive class is equal to the union of its successor, inference form. Combines Theorem 4E of [Enderton] p. 72 and Exercise 6 of [Enderton] p. 73. (Contributed by NM, 30-Aug-1993.)
theorem unisuc (A2: class):
  $ wcel A2 cvv $ >
  $ wb (wtr A2) (wceq (cuni (csuc A2)) A2) $;

--| A class is included in its own successor. Part of Proposition 7.23 of [TakeutiZaring] p. 41 (generalized to arbitrary classes). (Contributed by NM, 31-May-1994.)
theorem sssucid (A2: class):
  $ wss A2 (csuc A2) $;

--| Part of Proposition 7.23 of [TakeutiZaring] p. 41 (generalized). Lemma 1.7 of [Schloeder] p. 1. (Contributed by NM, 25-Mar-1995.) (Proof shortened by Scott Fenton, 20-Feb-2012.)
theorem sucidg (A2 V: class):
  $ wi (wcel A2 V) (wcel A2 (csuc A2)) $;

--| A set belongs to its successor. (Contributed by NM, 22-Jun-1994.) (Proof shortened by Alan Sare, 18-Feb-2012.) (Proof shortened by Scott Fenton, 20-Feb-2012.)
theorem sucid (A2: class):
  $ wcel A2 cvv $ >
  $ wcel A2 (csuc A2) $;

--| No successor is empty. (Contributed by NM, 3-Apr-1995.)
theorem nsuceq0 (A2: class):
  $ wne (csuc A2) c0 $;

--| A set belongs to the successor of an equal set. (Contributed by NM, 18-Aug-1994.)
theorem eqelsuc (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wi (wceq A2 B2) (wcel A2 (csuc B2)) $;

--| Inductive definition for the indexed union at a successor. (Contributed by Mario Carneiro, 4-Feb-2013.) (Proof shortened by Mario Carneiro, 18-Nov-2016.)
theorem iunsuc {x3: setvar} (A2: class) (B2: class x3) (C: class):
  $ wcel A2 cvv $ >
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wceq (ciun x3 (csuc A2) B2) (cun (ciun x3 A2 B2) C) $;

--| The successor of a transitive class is transitive. (Contributed by Alan Sare, 11-Apr-2009.) (Proof shortened by JJ, 24-Sep-2021.)
theorem suctr (A2: class):
  $ wi (wtr A2) (wtr (csuc A2)) $;

--| A set whose successor belongs to a transitive class also belongs. (Contributed by NM, 5-Sep-2003.) (Proof shortened by Andrew Salmon, 12-Aug-2011.)
theorem trsuc (A2 B2: class):
  $ wi (wa (wtr A2) (wcel (csuc B2) A2)) (wcel B2 A2) $;

--| A member of the successor of a transitive class is a subclass of it. Lemma 1.13 of [Schloeder] p. 2. (Contributed by NM, 4-Oct-2003.)
theorem trsucss (A2 B2: class):
  $ wi (wtr A2) (wi (wcel B2 (csuc A2)) (wss B2 A2)) $;

--| An ordinal is a subset of another ordinal if and only if it belongs to its successor. (Contributed by NM, 28-Nov-2003.)
theorem ordsssuc (A2 B2: class):
  $ wi (wa (wcel A2 con0) (word B2)) (wb (wss A2 B2) (wcel A2 (csuc B2))) $;

--| A subset of an ordinal number belongs to its successor. (Contributed by NM, 15-Sep-1995.)
theorem onsssuc (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wb (wss A2 B2) (wcel A2 (csuc B2))) $;

--| An ordinal subset of an ordinal number belongs to its successor. (Contributed by NM, 1-Feb-2005.) (Proof shortened by Andrew Salmon, 12-Aug-2011.)
theorem ordsssuc2 (A2 B2: class):
  $ wi (wa (word A2) (wcel B2 con0)) (wb (wss A2 B2) (wcel A2 (csuc B2))) $;

--| When its successor is subtracted from a class of ordinal numbers, an ordinal number is less than the minimum of the resulting subclass. (Contributed by NM, 1-Dec-2003.)
theorem onmindif (A2 B2: class):
  $ wi (wa (wss A2 con0) (wcel B2 con0)) (wcel B2 (cint (cdif A2 (csuc B2)))) $;

--| There is no set between an ordinal class and its successor. Generalized Proposition 7.25 of [TakeutiZaring] p. 41. Lemma 1.15 of [Schloeder] p. 2. (Contributed by NM, 21-Jun-1998.) (Proof shortened by JJ, 24-Sep-2021.)
theorem ordnbtwn (A2 B2: class):
  $ wi (word A2) (wn (wa (wcel A2 B2) (wcel B2 (csuc A2)))) $;

--| There is no set between an ordinal number and its successor. Proposition 7.25 of [TakeutiZaring] p. 41. Lemma 1.15 of [Schloeder] p. 2. (Contributed by NM, 9-Jun-1994.)
theorem onnbtwn (A2 B2: class):
  $ wi (wcel A2 con0) (wn (wa (wcel A2 B2) (wcel B2 (csuc A2)))) $;

--| A set whose successor is a subset of another class is a member of that class. (Contributed by NM, 16-Sep-1995.)
theorem sucssel (A2 B2 V: class):
  $ wi (wcel A2 V) (wi (wss (csuc A2) B2) (wcel A2 B2)) $;

--| Ordinal derived from its successor. (Contributed by NM, 20-May-1998.)
theorem orddif (A2: class):
  $ wi (word A2) (wceq A2 (cdif (csuc A2) (csn A2))) $;

--| An ordinal class includes its union. (Contributed by NM, 13-Sep-2003.)
theorem orduniss (A2: class):
  $ wi (word A2) (wss (cuni A2) A2) $;

--| A trichotomy law for ordinal classes. (Contributed by NM, 13-Sep-2003.) (Proof shortened by Andrew Salmon, 12-Aug-2011.)
theorem ordtri2or (A2 B2: class):
  $ wi (wa (word A2) (word B2)) (wo (wcel A2 B2) (wss B2 A2)) $;

--| A trichotomy law for ordinal classes. (Contributed by NM, 2-Nov-2003.)
theorem ordtri2or2 (A2 B2: class):
  $ wi (wa (word A2) (word B2)) (wo (wss A2 B2) (wss B2 A2)) $;

--| A consequence of total ordering for ordinal classes. Similar to ~ ordtri2or2 . (Contributed by David Moews, 1-May-2017.)
theorem ordtri2or3 (A2 B2: class):
  $ wi (wa (word A2) (word B2)) (wo (wceq A2 (cin A2 B2)) (wceq B2 (cin A2 B2))) $;

--| The intersection of two ordinal classes is an element of a third if and only if either one of them is. (Contributed by David Moews, 1-May-2017.) (Proof shortened by JJ, 24-Sep-2021.)
theorem ordelinel (A2 B2 C: class):
  $ wi (w3a (word A2) (word B2) (word C)) (wb (wcel (cin A2 B2) C) (wo (wcel A2 C) (wcel B2 C))) $;

--| Property of a subclass of the maximum (i.e. union) of two ordinals. (Contributed by NM, 28-Nov-2003.)
theorem ordssun (A2 B2 C: class):
  $ wi (wa (word B2) (word C)) (wb (wss A2 (cun B2 C)) (wo (wss A2 B2) (wss A2 C))) $;

--| The maximum (i.e. union) of two ordinals is either one or the other. Similar to Exercise 14 of [TakeutiZaring] p. 40. (Contributed by NM, 28-Nov-2003.)
theorem ordequn (A2 B2 C: class):
  $ wi (wa (word B2) (word C)) (wi (wceq A2 (cun B2 C)) (wo (wceq A2 B2) (wceq A2 C))) $;

--| The maximum (i.e., union) of two ordinals is ordinal. Exercise 12 of [TakeutiZaring] p. 40. (Contributed by NM, 28-Nov-2003.)
theorem ordun (A2 B2: class):
  $ wi (wa (word A2) (word B2)) (word (cun A2 B2)) $;

--| The union of two ordinals is in a third iff both of the first two are. (Contributed by Scott Fenton, 10-Sep-2024.)
theorem onunel (A2 B2 C: class):
  $ wi (w3a (wcel A2 con0) (wcel B2 con0) (wcel C con0)) (wb (wcel (cun A2 B2) C) (wa (wcel A2 C) (wcel B2 C))) $;

--| A subclass relationship for union and successor of ordinal classes. (Contributed by NM, 28-Nov-2003.)
theorem ordunisssuc (A2 B2: class):
  $ wi (wa (wss A2 con0) (word B2)) (wb (wss (cuni A2) B2) (wss A2 (csuc B2))) $;

--| The successor operation behaves like a one-to-one function. Compare Exercise 16 of [Enderton] p. 194. (Contributed by NM, 3-Sep-2003.)
theorem suc11 (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wb (wceq (csuc A2) (csuc B2)) (wceq A2 B2)) $;

--| The union of two ordinals is an ordinal. (Contributed by Scott Fenton, 9-Aug-2024.)
theorem onun2 (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wcel (cun A2 B2) con0) $;

--| An ordinal number is a transitive class. (Contributed by NM, 11-Jun-1994.) Put in closed form. (Resised by BJ, 28-Dec-2024.)
theorem ontr (A2: class):
  $ wi (wcel A2 con0) (wtr A2) $;

--| An ordinal number is equal to the union of its successor. (Contributed by NM, 12-Jun-1994.) Generalize from ~ onunisuci . (Revised by BJ, 28-Dec-2024.)
theorem onunisuc (A2: class):
  $ wi (wcel A2 con0) (wceq (cuni (csuc A2)) A2) $;

--| An ordinal number is an ordinal class. (Contributed by NM, 11-Jun-1994.)
theorem onordi (A2: class):
  $ wcel A2 con0 $ >
  $ word A2 $;

--| An ordinal number is not a member of itself. Theorem 7M(c) of [Enderton] p. 192. (Contributed by NM, 11-Jun-1994.)
theorem onirri (A2: class):
  $ wcel A2 con0 $ >
  $ wn (wcel A2 A2) $;

--| A member of an ordinal number is an ordinal number. Theorem 7M(a) of [Enderton] p. 192. (Contributed by NM, 11-Jun-1994.)
theorem oneli (A2 B2: class):
  $ wcel A2 con0 $ >
  $ wi (wcel B2 A2) (wcel B2 con0) $;

--| A member of an ordinal number is a subset of it. (Contributed by NM, 11-Aug-1994.)
theorem onelssi (A2 B2: class):
  $ wcel A2 con0 $ >
  $ wi (wcel B2 A2) (wss B2 A2) $;

--| An ordering law for ordinal numbers. (Contributed by NM, 13-Jun-1994.)
theorem onssneli (A2 B2: class):
  $ wcel A2 con0 $ >
  $ wi (wss A2 B2) (wn (wcel B2 A2)) $;

--| An ordering law for ordinal numbers. (Contributed by NM, 13-Jun-1994.)
theorem onssnel2i (A2 B2: class):
  $ wcel A2 con0 $ >
  $ wi (wss B2 A2) (wn (wcel A2 B2)) $;

--| An element of an ordinal number equals the intersection with it. (Contributed by NM, 11-Jun-1994.)
theorem onelini (A2 B2: class):
  $ wcel A2 con0 $ >
  $ wi (wcel B2 A2) (wceq B2 (cin B2 A2)) $;

--| An ordinal number equals its union with any element. (Contributed by NM, 13-Jun-1994.)
theorem oneluni (A2 B2: class):
  $ wcel A2 con0 $ >
  $ wi (wcel B2 A2) (wceq (cun A2 B2) A2) $;

--| An ordinal number is equal to the union of its successor. (Contributed by NM, 12-Jun-1994.)
theorem onunisuci (A2: class):
  $ wcel A2 con0 $ >
  $ wceq (cuni (csuc A2)) A2 $;

--| Subset is equivalent to membership or equality for ordinal numbers. (Contributed by NM, 15-Sep-1995.)
theorem onsseli (A2 B2: class):
  $ wcel A2 con0 $ >
  $ wcel B2 con0 $ >
  $ wb (wss A2 B2) (wo (wcel A2 B2) (wceq A2 B2)) $;

--| The union of two ordinal numbers is an ordinal number. (Contributed by NM, 13-Jun-1994.)
theorem onun2i (A2 B2: class):
  $ wcel A2 con0 $ >
  $ wcel B2 con0 $ >
  $ wcel (cun A2 B2) con0 $;

--| An ordinal equal to its own union is either zero or a limit ordinal. (Contributed by NM, 1-Oct-2003.)
theorem unizlim (A2: class):
  $ wi (word A2) (wb (wceq A2 (cuni A2)) (wo (wceq A2 c0) (wlim A2))) $;

--| An ordinal number either equals zero or contains zero. (Contributed by NM, 1-Jun-2004.)
theorem on0eqel (A2: class):
  $ wi (wcel A2 con0) (wo (wceq A2 c0) (wcel c0 A2)) $;

--| The singleton of the singleton of the empty set is not an ordinal (nor a natural number by ~ omsson ). It can be used to represent an "undefined" value for a partial operation on natural or ordinal numbers. See also ~ onxpdisj . (Contributed by NM, 21-May-2004.) (Proof shortened by Andrew Salmon, 12-Aug-2011.)
theorem snsn0non:
  $ wn (wcel (csn (csn c0)) con0) $;

--| Ordinal numbers and ordered pairs are disjoint collections. This theorem can be used if we want to extend a set of ordinal numbers or ordered pairs with disjoint elements. See also ~ snsn0non . (Contributed by NM, 1-Jun-2004.) (Proof shortened by Andrew Salmon, 27-Aug-2011.)
theorem onxpdisj:
  $ wceq (cin con0 (cxp cvv cvv)) c0 $;

--| The class of ordinal numbers is not equal to the universe. (Contributed by NM, 16-Jun-2007.) (Proof shortened by Mario Carneiro, 10-Jan-2013.) (Proof shortened by Wolf Lammen, 27-May-2024.)
theorem onnev:
  $ wne con0 cvv $;

--| Extend class notation with Russell's definition description binder (inverted iota).
term cio {x3: setvar} (ph: wff x3): class;

--| Soundness justification theorem for ~ df-iota . (Contributed by Andrew Salmon, 29-Jun-2011.)
theorem iotajust {x3 y1 z: setvar} (ph: wff x3):
  $ wceq (cuni (cab y1 (wceq (cab x3 ph) (csn (cv y1))))) (cuni (cab z (wceq (cab x3 ph) (csn (cv z))))) $;

--| Define Russell's definition description binder, which can be read as "the unique ` x ` such that ` ph ` ", where ` ph ` ordinarily contains ` x ` as a free variable. Our definition is meaningful only when there is exactly one ` x ` such that ` ph ` is true (see ~ iotaval ); otherwise, it evaluates to the empty set (see ~ iotanul ). Russell used the inverted iota symbol ` iota ` to represent the binder. Sometimes proofs need to expand an iota-based definition. That is, given "X = the x for which ... x ... x ..." holds, the proof needs to get to "... X ... X ...". A general strategy to do this is to use ~ riotacl2 (or ~ iotacl for unbounded iota), as demonstrated in the proof of ~ supub . This can be easier than applying ~ riotasbc or a version that applies an explicit substitution, because substituting an iota into its own property always has a bound variable clash which must be first renamed or else guarded with NF. (Contributed by Andrew Salmon, 30-Jun-2011.)
axiom df_iota {x3 y1: setvar} (ph: wff x3):
  $ wceq (cio x3 ph) (cuni (cab y1 (wceq (cab x3 ph) (csn (cv y1))))) $;

--| Alternate definition for descriptions. Definition 8.18 in [Quine] p. 56. (Contributed by Andrew Salmon, 30-Jun-2011.)
theorem dfiota2 {x3 y1: setvar} (ph: wff x3):
  $ wceq (cio x3 ph) (cuni (cab y1 (wal x3 (wb ph (wceq (cv x3) (cv y1)))))) $;

--| Bound-variable hypothesis builder for the ` iota ` class. (Contributed by Andrew Salmon, 11-Jul-2011.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem nfiota1 {x3: setvar} (ph: wff x3):
  $ wnfc x3 (cio x3 ph) $;

--| Deduction version of ~ nfiotaw . Version of ~ nfiotad with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by NM, 18-Feb-2013.) Avoid ~ ax-13 . (Revised by GG, 26-Jan-2024.)
theorem nfiotadw {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf y1 ph $ >
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnfc x3 (cio y1 ps)) $;

--| Bound-variable hypothesis builder for the ` iota ` class. Version of ~ nfiota with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by NM, 23-Aug-2011.) Avoid ~ ax-13 . (Revised by GG, 26-Jan-2024.)
theorem nfiotaw {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf x3 ph $ >
  $ wnfc x3 (cio y1 ph) $;

--| Deduction version of ~ nfiota . Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ nfiotadw when possible. (Contributed by NM, 18-Feb-2013.) (New usage is discouraged.)
theorem nfiotad {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf y1 ph $ >
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnfc x3 (cio y1 ps)) $;

--| Bound-variable hypothesis builder for the ` iota ` class. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ nfiotaw when possible. (Contributed by NM, 23-Aug-2011.) (New usage is discouraged.)
theorem nfiota {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf x3 ph $ >
  $ wnfc x3 (cio y1 ph) $;

--| Change bound variables in a description binder. Version of ~ cbviota with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by Andrew Salmon, 1-Aug-2011.) Avoid ~ ax-13 . (Revised by GG, 26-Jan-2024.)
theorem cbviotaw {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wceq (cio x3 ph) (cio y1 ps) $;

--| Change bound variables in a description binder. Version of ~ cbviotav with a disjoint variable condition, which requires fewer axioms . (Contributed by Andrew Salmon, 1-Aug-2011.) (Revised by GG, 30-Sep-2024.)
theorem cbviotavw {x3 y1: setvar} (ph: wff x3) (ps: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wceq (cio x3 ph) (cio y1 ps) $;

--| Change bound variables in a description binder. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ cbviotaw when possible. (Contributed by Andrew Salmon, 1-Aug-2011.) (New usage is discouraged.)
theorem cbviota {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wceq (cio x3 ph) (cio y1 ps) $;

--| Change bound variables in a description binder. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ cbviotavw when possible. (Contributed by Andrew Salmon, 1-Aug-2011.) (New usage is discouraged.)
theorem cbviotav {x3 y1: setvar} (ph: wff x3) (ps: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wceq (cio x3 ph) (cio y1 ps) $;

--| Variable substitution in description binder. Compare ~ sb8eu . Usage of this theorem is discouraged because it depends on ~ ax-13 . (Contributed by NM, 18-Mar-2013.) (New usage is discouraged.)
theorem sb8iota {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf y1 ph $ >
  $ wceq (cio x3 ph) (cio y1 (wsb x3 ph y1)) $;

--| Equality theorem for descriptions. Usage of this theorem is discouraged because it depends on ~ ax-13 . (Contributed by Andrew Salmon, 30-Jun-2011.) (New usage is discouraged.)
theorem iotaeq {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wceq (cio x3 ph) (cio y1 ph)) $;

--| Equivalence theorem for descriptions. (Contributed by Andrew Salmon, 30-Jun-2011.)
theorem iotabi {x3: setvar} (ph ps: wff x3):
  $ wi (wal x3 (wb ph ps)) (wceq (cio x3 ph) (cio x3 ps)) $;

--| Part of Theorem 8.17 in [Quine] p. 56. This theorem serves as a lemma for the fundamental property of iota. (Contributed by Andrew Salmon, 11-Jul-2011.)
theorem uniabio {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wb ph (wceq (cv x3) (cv y1)))) (wceq (cuni (cab x3 ph)) (cv y1)) $;

--| Version of ~ iotaval using ~ df-iota instead of ~ dfiota2 . (Contributed by SN, 6-Nov-2024.)
theorem iotaval2 {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wceq (cab x3 ph) (csn (cv y1))) (wceq (cio x3 ph) (cv y1)) $;

--| Version of ~ iotauni using ~ df-iota instead of ~ dfiota2 . (Contributed by SN, 6-Nov-2024.)
theorem iotauni2 {x3 y1: setvar} (ph: wff x3):
  $ wi (wex y1 (wceq (cab x3 ph) (csn (cv y1)))) (wceq (cio x3 ph) (cuni (cab x3 ph))) $;

--| Version of ~ iotanul using ~ df-iota instead of ~ dfiota2 . (Contributed by SN, 6-Nov-2024.)
theorem iotanul2 {x3 y1: setvar} (ph: wff x3):
  $ wi (wn (wex y1 (wceq (cab x3 ph) (csn (cv y1))))) (wceq (cio x3 ph) c0) $;

--| Theorem 8.19 in [Quine] p. 57. This theorem is the fundamental property of iota. (Contributed by Andrew Salmon, 11-Jul-2011.) Remove dependency on ~ ax-10 , ~ ax-11 , ~ ax-12 . (Revised by SN, 23-Nov-2024.)
theorem iotaval {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wb ph (wceq (cv x3) (cv y1)))) (wceq (cio x3 ph) (cv y1)) $;

--| Equivalence between two different forms of ` iota ` . (Contributed by Andrew Salmon, 15-Jul-2011.)
theorem iotain {x3: setvar} (ph: wff x3):
  $ wi (weu x3 ph) (wceq (cint (cab x3 ph)) (cio x3 ph)) $;

--| The ` iota ` class is a subset of the union of all elements satisfying ` ph ` . (Contributed by Mario Carneiro, 24-Dec-2016.) Remove dependency on ~ ax-10 , ~ ax-11 , ~ ax-12 . (Revised by SN, 6-Nov-2024.)
theorem iotassuni {x3: setvar} (ph: wff x3):
  $ wss (cio x3 ph) (cuni (cab x3 ph)) $;

--| Theorem 8.23 in [Quine] p. 58. This theorem proves the existence of the ` iota ` class under our definition. (Contributed by Andrew Salmon, 11-Jul-2011.) Remove dependency on ~ ax-10 , ~ ax-11 , ~ ax-12 . (Revised by SN, 6-Nov-2024.)
theorem iotaex {x3: setvar} (ph: wff x3):
  $ wcel (cio x3 ph) cvv $;

--| Equivalence between two different forms of ` iota ` . (Contributed by Andrew Salmon, 12-Jul-2011.)
theorem iotauni {x3: setvar} (ph: wff x3):
  $ wi (weu x3 ph) (wceq (cio x3 ph) (cuni (cab x3 ph))) $;

--| Equivalence between two different forms of ` iota ` . (Contributed by Mario Carneiro, 24-Dec-2016.)
theorem iotaint {x3: setvar} (ph: wff x3):
  $ wi (weu x3 ph) (wceq (cio x3 ph) (cint (cab x3 ph))) $;

--| Property of iota. (Contributed by NM, 23-Aug-2011.) (Revised by Mario Carneiro, 23-Dec-2016.)
theorem iota1 {x3: setvar} (ph: wff x3):
  $ wi (weu x3 ph) (wb ph (wceq (cio x3 ph) (cv x3))) $;

--| Theorem 8.22 in [Quine] p. 57. This theorem is the result if there isn't exactly one ` x ` that satisfies ` ph ` . (Contributed by Andrew Salmon, 11-Jul-2011.)
theorem iotanul {x3: setvar} (ph: wff x3):
  $ wi (wn (weu x3 ph)) (wceq (cio x3 ph) c0) $;

--| Theorem *14.22 in [WhiteheadRussell] p. 190. (Contributed by Andrew Salmon, 12-Jul-2011.)
theorem iota4 {x3: setvar} (ph: wff x3):
  $ wi (weu x3 ph) (wsbc x3 ph (cio x3 ph)) $;

--| Theorem *14.23 in [WhiteheadRussell] p. 191. (Contributed by Andrew Salmon, 12-Jul-2011.)
theorem iota4an {x3: setvar} (ph ps: wff x3):
  $ wi (weu x3 (wa ph ps)) (wsbc x3 ph (cio x3 (wa ph ps))) $;

--| A method for computing iota. (Contributed by NM, 17-Sep-2013.)
theorem iota5 {x3: setvar} (ph: wff) (ps: wff x3) (A2 V: class):
  $ wi (wa ph (wcel A2 V)) (wb ps (wceq (cv x3) A2)) $ >
  $ wi (wa ph (wcel A2 V)) (wceq (cio x3 ps) A2) $;

--| Formula-building deduction for iota. (Contributed by NM, 20-Aug-2011.)
theorem iotabidv {x3: setvar} (ph: wff) (ps ch: wff x3):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wceq (cio x3 ps) (cio x3 ch)) $;

--| Formula-building deduction for iota. (Contributed by Mario Carneiro, 2-Oct-2015.)
theorem iotabii {x3: setvar} (ph ps: wff x3):
  $ wb ph ps $ >
  $ wceq (cio x3 ph) (cio x3 ps) $;

--| Membership law for descriptions. This can be useful for expanding an unbounded iota-based definition (see ~ df-iota ). If you have a bounded iota-based definition, ~ riotacl2 may be useful. (Contributed by Andrew Salmon, 1-Aug-2011.)
theorem iotacl {x3: setvar} (ph: wff x3):
  $ wi (weu x3 ph) (wcel (cio x3 ph) (cab x3 ph)) $;

--| A condition that allows to represent "the unique element such that ` ph ` " with a class expression ` A ` . (Contributed by NM, 30-Dec-2014.)
theorem iota2df {x3: setvar} (ph ps ch: wff x3) (B2 V: class x3):
  $ wi ph (wcel B2 V) $ >
  $ wi ph (weu x3 ps) $ >
  $ wi (wa ph (wceq (cv x3) B2)) (wb ps ch) $ >
  $ wnf x3 ph $ >
  $ wi ph (wnf x3 ch) $ >
  $ wi ph (wnfc x3 B2) $ >
  $ wi ph (wb ch (wceq (cio x3 ps) B2)) $;

--| A condition that allows to represent "the unique element such that ` ph ` " with a class expression ` A ` . (Contributed by NM, 30-Dec-2014.)
theorem iota2d {x3: setvar} (ph: wff) (ps: wff x3) (ch: wff) (B2: class) (V: class x3):
  $ wi ph (wcel B2 V) $ >
  $ wi ph (weu x3 ps) $ >
  $ wi (wa ph (wceq (cv x3) B2)) (wb ps ch) $ >
  $ wi ph (wb ch (wceq (cio x3 ps) B2)) $;

--| The unique element such that ` ph ` . (Contributed by Jeff Madsen, 1-Jun-2011.) (Revised by Mario Carneiro, 23-Dec-2016.)
theorem iota2 {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (B2: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wa (wcel A2 B2) (weu x3 ph)) (wb ps (wceq (cio x3 ph) A2)) $;

--| Representation of "the unique element such that ` ph ` " with a class expression ` A ` which is not the empty set (that means that "the unique element such that ` ph ` " exists). (Contributed by AV, 30-Jan-2024.) Remove sethood antecedent. (Revised by Eric Schmidt, 17-Oct-2026.)
theorem iotan0 {x3: setvar} (ph: wff x3) (ps: wff) (A2: class):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wa (wne A2 c0) (wceq A2 (cio x3 ph))) ps $;

--| Obsolete version of ~ iotan0 as of 17-Oct-2026. (Contributed by AV, 30-Jan-2024.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem iotan0OLD {x3: setvar} (ph: wff x3) (ps: wff) (A2: class) (V: class x3):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (w3a (wcel A2 V) (wne A2 c0) (wceq A2 (cio x3 ph))) ps $;

--| A class abstraction with a unique member can be expressed as a singleton. (Contributed by Mario Carneiro, 23-Dec-2016.)
theorem sniota {x3: setvar} (ph: wff x3):
  $ wi (weu x3 ph) (wceq (cab x3 ph) (csn (cio x3 ph))) $;

--| The ` iota ` operation using the ` if ` operator. (Contributed by Scott Fenton, 6-Oct-2017.) (Proof shortened by JJ, 28-Oct-2021.)
theorem dfiota4 {x3: setvar} (ph: wff x3):
  $ wceq (cio x3 ph) (cif (weu x3 ph) (cuni (cab x3 ph)) c0) $;

--| Class substitution within a description binder. (Contributed by Scott Fenton, 6-Oct-2017.) (Revised by NM, 23-Aug-2018.)
theorem csbiota {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3):
  $ wceq (csb x3 A2 (cio y1 ph)) (cio y1 (wsbc x3 ph A2)) $;

--| Extend the definition of a wff to include the function predicate. (Read: ` A ` is a function.)
term wfun (A2: class): wff;

--| Extend the definition of a wff to include the function predicate with a domain. (Read: ` A ` is a function on ` B ` .)
term wfn (A2 B2: class): wff;

--| Extend the definition of a wff to include the function predicate with domain and codomain. (Read: ` F ` maps ` A ` into ` B ` .)
term wf (A2 B2 F: class): wff;

--| Extend the definition of a wff to include one-to-one functions. (Read: ` F ` maps ` A ` one-to-one into ` B ` .) The notation ("1-1" above the arrow) is from Definition 6.15(5) of [TakeutiZaring] p. 27.
term wf1 (A2 B2 F: class): wff;

--| Extend the definition of a wff to include onto functions. (Read: ` F ` maps ` A ` onto ` B ` .) The notation ("onto" below the arrow) is from Definition 6.15(4) of [TakeutiZaring] p. 27.
term wfo (A2 B2 F: class): wff;

--| Extend the definition of a wff to include one-to-one onto functions. (Read: ` F ` maps ` A ` one-to-one onto ` B ` .) The notation ("1-1" above the arrow and "onto" below the arrow) is from Definition 6.15(6) of [TakeutiZaring] p. 27.
term wf1o (A2 B2 F: class): wff;

--| Extend the definition of a class to include the value of a function. Read: "the value of ` F ` at ` A ` ", or " ` F ` of ` A ` ".
term cfv (A2 F: class): class;

--| Extend the definition of a wff to include the isomorphism property. Read: " ` H ` is an ` R ` , ` S ` isomorphism of ` A ` onto ` B ` ".
term wiso (A2 B2 R S H: class): wff;

--| Define predicate that determines if some class ` A ` is a function. Definition 10.1 of [Quine] p. 65. For example, the expression ` Fun cos ` is true once we define cosine ( ~ df-cos ). This is not the same as defining a specific function's mapping, which is typically done using the format of ~ cmpt with the maps-to notation (see ~ df-mpt and ~ df-mpo ). Contrast this predicate with the predicates to determine if some class is a function with a given domain ( ~ df-fn ), a function with a given domain and codomain ( ~ df-f ), a one-to-one function ( ~ df-f1 ), an onto function ( ~ df-fo ), or a one-to-one onto function ( ~ df-f1o ). For alternate definitions, see ~ dffun2 , ~ dffun3 , ~ dffun4 , ~ dffun5 , ~ dffun6 , ~ dffun7 , ~ dffun8 , and ~ dffun9 . (Contributed by NM, 1-Aug-1994.)
axiom df_fun (A2: class):
  $ wb (wfun A2) (wa (wrel A2) (wss (ccom A2 (ccnv A2)) cid)) $;

--| Define a function with domain. Definition 6.15(1) of [TakeutiZaring] p. 27. For alternate definitions, see ~ dffn2 , ~ dffn3 , ~ dffn4 , and ~ dffn5 . (Contributed by NM, 1-Aug-1994.)
axiom df_fn (A2 B2: class):
  $ wb (wfn A2 B2) (wa (wfun A2) (wceq (cdm A2) B2)) $;

--| Define a function (mapping) with domain and codomain. Definition 6.15(3) of [TakeutiZaring] p. 27. ` F : A --> B ` can be read as " ` F ` is a function from ` A ` to ` B ` ". For alternate definitions, see ~ dff2 , ~ dff3 , and ~ dff4 . (Contributed by NM, 1-Aug-1994.)
axiom df_f (A2 B2 F: class):
  $ wb (wf A2 B2 F) (wa (wfn F A2) (wss (crn F) B2)) $;

--| Define a one-to-one function. For equivalent definitions see ~ dff12 and ~ dff13 . Compare Definition 6.15(5) of [TakeutiZaring] p. 27. We use their notation ("1-1" above the arrow). A one-to-one function is also called an "injection" or an "injective function", ` F : A -1-1-> B ` can be read as " ` F ` is an injection from ` A ` into ` B ` ". Injections are precisely the monomorphisms in the category ` SetCat ` of sets and set functions, see ~ setcmon . (Contributed by NM, 1-Aug-1994.)
axiom df_f1 (A2 B2 F: class):
  $ wb (wf1 A2 B2 F) (wa (wf A2 B2 F) (wfun (ccnv F))) $;

--| Define an onto function. Definition 6.15(4) of [TakeutiZaring] p. 27. We use their notation ("onto" under the arrow). For alternate definitions, see ~ dffo2 , ~ dffo3 , ~ dffo4 , and ~ dffo5 . An onto function is also called a "surjection" or a "surjective function", ` F : A -onto-> B ` can be read as " ` F ` is a surjection from ` A ` onto ` B ` ". Surjections are precisely the epimorphisms in the category ` SetCat ` of sets and set functions, see ~ setcepi . (Contributed by NM, 1-Aug-1994.)
axiom df_fo (A2 B2 F: class):
  $ wb (wfo A2 B2 F) (wa (wfn F A2) (wceq (crn F) B2)) $;

--| Define a one-to-one onto function. For equivalent definitions see ~ dff1o2 , ~ dff1o3 , ~ dff1o4 , and ~ dff1o5 . Compare Definition 6.15(6) of [TakeutiZaring] p. 27. We use their notation ("1-1" above the arrow and "onto" below the arrow). A one-to-one onto function is also called a "bijection" or a "bijective function", ` F : A -1-1-onto-> B ` can be read as " ` F ` is a bijection between ` A ` and ` B ` ". Bijections are precisely the isomorphisms in the category ` SetCat ` of sets and set functions, see ~ setciso . Therefore, two sets are called "isomorphic" if there is a bijection between them. According to ~ isof1oidb , two sets are isomorphic iff there is an isomorphism ` Isom ` regarding the identity relation. In this case, the two sets are also "equinumerous", see ~ bren . (Contributed by NM, 1-Aug-1994.)
axiom df_f1o (A2 B2 F: class):
  $ wb (wf1o A2 B2 F) (wa (wf1 A2 B2 F) (wfo A2 B2 F)) $;

--| Define the value of a function, ` ( F `` A ) ` , also known as function application. For example, ` ( cos `` 0 ) = 1 ` (we prove this in ~ cos0 after we define cosine in ~ df-cos ). Typically, function ` F ` is defined using maps-to notation (see ~ df-mpt and ~ df-mpo ), but this is not required. For example, ` F = { <. 2 , 6 >. , <. 3 , 9 >. } -> ( F `` 3 ) = 9 ` ( ~ ex-fv ). Note that ~ df-ov will define two-argument functions using ordered pairs as ` ( A F B ) = ( F `` <. A , B >. ) ` . This particular definition is quite convenient: it can be applied to any class and evaluates to the empty set when it is not meaningful (as shown by ~ ndmfv and ~ fvprc ). The left apostrophe notation originated with Peano and was adopted in Definition *30.01 of [WhiteheadRussell] p. 235, Definition 10.11 of [Quine] p. 68, and Definition 6.11 of [TakeutiZaring] p. 26. It means the same thing as the more familiar ` F ( A ) ` notation for a function's value at ` A ` , i.e., " ` F ` of ` A ` ", but without context-dependent notational ambiguity. Alternate definitions are ~ dffv2 , ~ dffv3 , ~ fv2 , and ~ fv3 (the latter two previously required ` A ` to be a set.) Restricted equivalents that require ` F ` to be a function are shown in ~ funfv and ~ funfv2 . For the familiar definition of function value in terms of ordered pair membership, see ~ funopfvb . (Contributed by NM, 1-Aug-1994.) Revised to use ` iota ` . Original version is now Theorem ~ dffv4 . (Revised by Scott Fenton, 6-Oct-2017.)
axiom df_fv {x3: setvar} (A2 F: class):
  $ wceq (cfv A2 F) (cio x3 (wbr A2 (cv x3) F)) $;

--| Define the isomorphism predicate. We read this as " ` H ` is an ` R ` , ` S ` isomorphism of ` A ` onto ` B ` ". Normally, ` R ` and ` S ` are ordering relations on ` A ` and ` B ` respectively. Definition 6.28 of [TakeutiZaring] p. 32, whose notation is the same as ours except that ` R ` and ` S ` are subscripts. (Contributed by NM, 4-Mar-1997.)
axiom df_isom {x3 y1: setvar} (A2 B2 R S H: class):
  $ wb (wiso A2 B2 R S H) (wa (wf1o A2 B2 H) (wral x3 (wral y1 (wb (wbr (cv x3) (cv y1) R) (wbr (cfv (cv x3) H) (cfv (cv y1) H) S)) A2) A2)) $;

--| Alternate definition of a function. (Contributed by NM, 29-Dec-1996.) Avoid ~ ax-10 , ~ ax-12 . (Revised by SN, 19-Dec-2024.) Avoid ~ ax-11 . (Revised by BTernaryTau, 29-Dec-2024.)
theorem dffun2 {x3 y1 z: setvar} (A2: class):
  $ wb (wfun A2) (wa (wrel A2) (wal x3 (wal y1 (wal z (wi (wa (wbr (cv x3) (cv y1) A2) (wbr (cv x3) (cv z) A2)) (wceq (cv y1) (cv z))))))) $;

--| Alternate definition of a function using "at most one" notation. (Contributed by NM, 9-Mar-1995.) Avoid ~ ax-10 , ~ ax-12 . (Revised by SN, 19-Dec-2024.)
theorem dffun6 {x3 y1: setvar} (F: class):
  $ wb (wfun F) (wa (wrel F) (wal x3 (wmo y1 (wbr (cv x3) (cv y1) F)))) $;

--| Alternate definition of function. (Contributed by NM, 29-Dec-1996.) (Proof shortened by SN, 19-Dec-2024.)
theorem dffun3 {x3 y1 z: setvar} (A2: class):
  $ wb (wfun A2) (wa (wrel A2) (wal x3 (wex z (wal y1 (wi (wbr (cv x3) (cv y1) A2) (wceq (cv y1) (cv z))))))) $;

--| Alternate definition of a function. Definition 6.4(4) of [TakeutiZaring] p. 24. (Contributed by NM, 29-Dec-1996.)
theorem dffun4 {x3 y1 z: setvar} (A2: class):
  $ wb (wfun A2) (wa (wrel A2) (wal x3 (wal y1 (wal z (wi (wa (wcel (cop (cv x3) (cv y1)) A2) (wcel (cop (cv x3) (cv z)) A2)) (wceq (cv y1) (cv z))))))) $;

--| Alternate definition of function. (Contributed by NM, 29-Dec-1996.)
theorem dffun5 {x3 y1 z: setvar} (A2: class):
  $ wb (wfun A2) (wa (wrel A2) (wal x3 (wex z (wal y1 (wi (wcel (cop (cv x3) (cv y1)) A2) (wceq (cv y1) (cv z))))))) $;

--| Definition of function, using bound-variable hypotheses instead of distinct variable conditions. (Contributed by NM, 9-Mar-1995.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem dffun6f {x3 y1: setvar} (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wb (wfun A2) (wa (wrel A2) (wal x3 (wmo y1 (wbr (cv x3) (cv y1) A2)))) $;

--| A function has at most one value for each argument. (Contributed by NM, 24-May-1998.) (Proof shortened by SN, 19-Dec-2024.)
theorem funmo {y1: setvar} (A2 F: class):
  $ wi (wfun F) (wmo y1 (wbr A2 (cv y1) F)) $;

--| Functions are single-valued. (Contributed by Scott Fenton, 18-Feb-2013.)
theorem fununiq (A2 B2 C F: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wi (wfun F) (wi (wa (wbr A2 B2 F) (wbr A2 C F)) (wceq B2 C)) $;

--| A function is a relation. (Contributed by NM, 1-Aug-1994.)
theorem funrel (A2: class):
  $ wi (wfun A2) (wrel A2) $;

--| A function does not contain the empty set. (Contributed by BJ, 26-Nov-2021.)
theorem _0nelfun (R: class):
  $ wi (wfun R) (wnel c0 R) $;

--| Subclass theorem for function predicate. (Contributed by NM, 16-Aug-1994.) (Proof shortened by Mario Carneiro, 24-Jun-2014.)
theorem funss (A2 B2: class):
  $ wi (wss A2 B2) (wi (wfun B2) (wfun A2)) $;

--| Equality theorem for function predicate. (Contributed by NM, 16-Aug-1994.)
theorem funeq (A2 B2: class):
  $ wi (wceq A2 B2) (wb (wfun A2) (wfun B2)) $;

--| Equality inference for the function predicate. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.)
theorem funeqi (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wb (wfun A2) (wfun B2) $;

--| Equality deduction for the function predicate. (Contributed by NM, 23-Feb-2013.)
theorem funeqd (ph: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wfun A2) (wfun B2)) $;

--| Bound-variable hypothesis builder for a function. (Contributed by NM, 30-Jan-2004.)
theorem nffun {x3: setvar} (F: class x3):
  $ wnfc x3 F $ >
  $ wnf x3 (wfun F) $;

--| Distribute proper substitution through the function predicate. (Contributed by Alexander van der Vekens, 23-Jul-2017.) Shorten proof and remove dependency on ~ ax-sep and ~ ax-pr . (Revised by Eric Schmidt, 12-Sep-2026.)
theorem sbcfung {x3: setvar} (A2 F V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wfun F) A2) (wfun (csb x3 A2 F))) $;

--| Obsolete version of ~ sbcfung as of 12-Sep-2026. (Contributed by Alexander van der Vekens, 23-Jul-2017.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem sbcfungOLD {x3: setvar} (A2 F V: class x3):
  $ wi (wcel A2 V) (wb (wsbc x3 (wfun F) A2) (wfun (csb x3 A2 F))) $;

--| There is exactly one value of a function. (Contributed by NM, 22-Apr-2004.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem funeu {y1: setvar} (A2: class) (B2: class y1) (F: class):
  $ wi (wa (wfun F) (wbr A2 B2 F)) (weu y1 (wbr A2 (cv y1) F)) $;

--| There is exactly one value of a function. (Contributed by NM, 3-Aug-1994.)
theorem funeu2 {y1: setvar} (A2: class) (B2: class y1) (F: class):
  $ wi (wa (wfun F) (wcel (cop A2 B2) F)) (weu y1 (wcel (cop A2 (cv y1)) F)) $;

--| Alternate definition of a function. One possibility for the definition of a function in [Enderton] p. 42. (Enderton's definition is ambiguous because "there is only one" could mean either "there is at most one" or "there is exactly one". However, ~ dffun8 shows that it does not matter which meaning we pick.) (Contributed by NM, 4-Nov-2002.)
theorem dffun7 {x3 y1: setvar} (A2: class):
  $ wb (wfun A2) (wa (wrel A2) (wral x3 (wmo y1 (wbr (cv x3) (cv y1) A2)) (cdm A2))) $;

--| Alternate definition of a function. One possibility for the definition of a function in [Enderton] p. 42. Compare ~ dffun7 . (Contributed by NM, 4-Nov-2002.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem dffun8 {x3 y1: setvar} (A2: class):
  $ wb (wfun A2) (wa (wrel A2) (wral x3 (weu y1 (wbr (cv x3) (cv y1) A2)) (cdm A2))) $;

--| Alternate definition of a function. (Contributed by NM, 28-Mar-2007.) (Revised by NM, 16-Jun-2017.)
theorem dffun9 {x3 y1: setvar} (A2: class):
  $ wb (wfun A2) (wa (wrel A2) (wral x3 (wrmo y1 (wbr (cv x3) (cv y1) A2) (crn A2)) (cdm A2))) $;

--| A class is a function if and only if it is a function on its domain. (Contributed by NM, 13-Aug-2004.)
theorem funfn (A2: class):
  $ wb (wfun A2) (wfn A2 (cdm A2)) $;

--| A function is a function on its domain. (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem funfnd (ph: wff) (A2: class):
  $ wi ph (wfun A2) $ >
  $ wi ph (wfn A2 (cdm A2)) $;

--| The identity relation is a function. Part of Theorem 10.4 of [Quine] p. 65. See also ~ idfn . (Contributed by NM, 30-Apr-1998.)
theorem funi:
  $ wfun cid $;

--| The universal class is not a function. (Contributed by Raph Levien, 27-Jan-2004.)
theorem nfunv:
  $ wn (wfun cvv) $;

--| A Kuratowski ordered pair of sets is a function only if its components are equal. (Contributed by NM, 5-Jun-2008.) (Revised by Mario Carneiro, 26-Apr-2015.) A function is a class of ordered pairs, so the fact that an ordered pair may sometimes be itself a function is an "accident" depending on the specific encoding of ordered pairs as classes (in set.mm, the Kuratowski encoding). A more meaningful statement is ~ funsng , as ~ relsnopg is to ~ relop . (New usage is discouraged.)
theorem funopg (A2 B2 V W: class):
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wfun (cop A2 B2))) (wceq A2 B2) $;

--| A class of ordered pairs is a function when there is at most one second member for each pair. (Contributed by NM, 16-May-1995.)
theorem funopab {x3 y1: setvar} (ph: wff x3 y1):
  $ wb (wfun (copab x3 y1 ph)) (wal x3 (wmo y1 ph)) $;

--| A class of ordered pairs of values is a function. (Contributed by NM, 14-Nov-1995.)
theorem funopabeq {x3 y1: setvar} (A2: class x3):
  $ wfun (copab x3 y1 (wceq (cv y1) A2)) $;

--| A class of ordered pairs of values in the form used by ~ df-mpt is a function. (Contributed by NM, 17-Feb-2013.)
theorem funopab4 {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3):
  $ wfun (copab x3 y1 (wa ph (wceq (cv y1) A2))) $;

--| A function in maps-to notation is a function. (Contributed by Mario Carneiro, 13-Jan-2013.)
theorem funmpt {x3: setvar} (A2 B2: class x3):
  $ wfun (cmpt x3 A2 B2) $;

--| Functionality of a class given by a maps-to notation. (Contributed by FL, 17-Feb-2008.) (Revised by Mario Carneiro, 31-May-2014.)
theorem funmpt2 {x3: setvar} (A2 B2 F: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wfun F $;

--| The composition of two functions is a function. Exercise 29 of [TakeutiZaring] p. 25. (Contributed by NM, 26-Jan-1997.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem funco (F G: class):
  $ wi (wa (wfun F) (wfun G)) (wfun (ccom F G)) $;

--| Composition of two functions, generalization of ~ funco . (Contributed by Alexander van der Vekens, 25-Jul-2017.)
theorem funresfunco (F G: class):
  $ wi (wa (wfun (cres F (crn G))) (wfun G)) (wfun (ccom F G)) $;

--| A restriction of a function is a function. Compare Exercise 18 of [TakeutiZaring] p. 25. (Contributed by NM, 16-Aug-1994.)
theorem funres (A2 F: class):
  $ wi (wfun F) (wfun (cres F A2)) $;

--| A restriction of a function is a function. (Contributed by Glauco Siliprandi, 2-Jan-2022.)
theorem funresd (ph: wff) (A2 F: class):
  $ wi ph (wfun F) $ >
  $ wi ph (wfun (cres F A2)) $;

--| The restriction of a function to the domain of a subclass equals the subclass. (Contributed by NM, 15-Aug-1994.)
theorem funssres (F G: class):
  $ wi (wa (wfun F) (wss G F)) (wceq (cres F (cdm G)) G) $;

--| Equality of restrictions of a function and a subclass. (Contributed by NM, 16-Aug-1994.)
theorem fun2ssres (A2 F G: class):
  $ wi (w3a (wfun F) (wss G F) (wss A2 (cdm G))) (wceq (cres F A2) (cres G A2)) $;

--| The union of functions with disjoint domains is a function. Theorem 4.6 of [Monk1] p. 43. (Contributed by NM, 12-Aug-1994.)
theorem funun (F G: class):
  $ wi (wa (wa (wfun F) (wfun G)) (wceq (cin (cdm F) (cdm G)) c0)) (wfun (cun F G)) $;

--| If the union of classes is a function, there is at most one element in relation to an arbitrary element regarding one of these classes. (Contributed by AV, 18-Jul-2019.)
theorem fununmo {y1: setvar} (x3: setvar) (F G: class):
  $ wi (wfun (cun F G)) (wmo y1 (wbr (cv x3) (cv y1) F)) $;

--| If the union of classes is a function, the classes themselves are functions. (Contributed by AV, 18-Jul-2019.) Shorten proof and remove dependency on ~ ax-sep and ~ ax-pr . (Revised by Eric Schmidt, 24-Oct-2026.)
theorem fununfun (F G: class):
  $ wi (wfun (cun F G)) (wa (wfun F) (wfun G)) $;

--| Obsolete version of ~ fununfun as of 24-Oct-2026. (Contributed by AV, 18-Jul-2019.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem fununfunOLD (F G: class):
  $ wi (wfun (cun F G)) (wa (wfun F) (wfun G)) $;

--| A function with removed elements is still a function. (Contributed by AV, 7-Jun-2021.) Shorten proof and remove dependency on ~ ax-sep and ~ ax-pr . (Revised by Eric Schmidt, 24-Oct-2026.)
theorem fundif (A2 F: class):
  $ wi (wfun F) (wfun (cdif F A2)) $;

--| Obsolete version of ~ fundif as of 24-Oct-2026. (Contributed by AV, 7-Jun-2021.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem fundifOLD (A2 F: class):
  $ wi (wfun F) (wfun (cdif F A2)) $;

--| The converse singleton of an ordered pair is a function. This is equivalent to ~ funsn via ~ cnvsn , but stating it this way allows to skip the sethood assumptions on ` A ` and ` B ` . (Contributed by NM, 30-Apr-2015.)
theorem funcnvsn (A2 B2: class):
  $ wfun (ccnv (csn (cop A2 B2))) $;

--| A singleton of an ordered pair is a function. Theorem 10.5 of [Quine] p. 65. (Contributed by NM, 28-Jun-2011.)
theorem funsng (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wfun (csn (cop A2 B2))) $;

--| Functionality and domain of the singleton of an ordered pair. (Contributed by Mario Carneiro, 30-Apr-2015.)
theorem fnsng (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wfn (csn (cop A2 B2)) (csn A2)) $;

--| A singleton of an ordered pair is a function. Theorem 10.5 of [Quine] p. 65. (Contributed by NM, 12-Aug-1994.)
theorem funsn (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wfun (csn (cop A2 B2)) $;

--| A set of two pairs is a function if their first members are different. (Contributed by FL, 26-Jun-2011.) (Proof shortened by JJ, 14-Jul-2021.)
theorem funprg (A2 B2 C D V W X Y: class):
  $ wi (w3a (wa (wcel A2 V) (wcel B2 W)) (wa (wcel C X) (wcel D Y)) (wne A2 B2)) (wfun (cpr (cop A2 C) (cop B2 D))) $;

--| A set of three pairs is a function if their first members are different. (Contributed by Alexander van der Vekens, 5-Dec-2017.) (Proof shortened by JJ, 14-Jul-2021.)
theorem funtpg (A2 B2 C U F G H V W X Y Z: class):
  $ wi (w3a (w3a (wcel X U) (wcel Y V) (wcel Z W)) (w3a (wcel A2 F) (wcel B2 G) (wcel C H)) (w3a (wne X Y) (wne X Z) (wne Y Z))) (wfun (ctp (cop X A2) (cop Y B2) (cop Z C))) $;

--| A function with a domain of two elements. (Contributed by Jeff Madsen, 20-Jun-2010.)
theorem funpr (A2 B2 C D: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wcel D cvv $ >
  $ wi (wne A2 B2) (wfun (cpr (cop A2 C) (cop B2 D))) $;

--| A function with a domain of three elements. (Contributed by NM, 14-Sep-2011.)
theorem funtp (A2 B2 C D E F: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wcel D cvv $ >
  $ wcel E cvv $ >
  $ wcel F cvv $ >
  $ wi (w3a (wne A2 B2) (wne A2 C) (wne B2 C)) (wfun (ctp (cop A2 D) (cop B2 E) (cop C F))) $;

--| Functionality and domain of the singleton of an ordered pair. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.)
theorem fnsn (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wfn (csn (cop A2 B2)) (csn A2) $;

--| Function with a domain of two different values. (Contributed by FL, 26-Jun-2011.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem fnprg (A2 B2 C D V W X Y: class):
  $ wi (w3a (wa (wcel A2 V) (wcel B2 W)) (wa (wcel C X) (wcel D Y)) (wne A2 B2)) (wfn (cpr (cop A2 C) (cop B2 D)) (cpr A2 B2)) $;

--| Function with a domain of three different values. (Contributed by Alexander van der Vekens, 5-Dec-2017.)
theorem fntpg (A2 B2 C U F G H V W X Y Z: class):
  $ wi (w3a (w3a (wcel X U) (wcel Y V) (wcel Z W)) (w3a (wcel A2 F) (wcel B2 G) (wcel C H)) (w3a (wne X Y) (wne X Z) (wne Y Z))) (wfn (ctp (cop X A2) (cop Y B2) (cop Z C)) (ctp X Y Z)) $;

--| A function with a domain of three elements. (Contributed by NM, 14-Sep-2011.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem fntp (A2 B2 C D E F: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wcel D cvv $ >
  $ wcel E cvv $ >
  $ wcel F cvv $ >
  $ wi (w3a (wne A2 B2) (wne A2 C) (wne B2 C)) (wfn (ctp (cop A2 D) (cop B2 E) (cop C F)) (ctp A2 B2 C)) $;

--| The converse pair of ordered pairs is a function if the second members are different. Note that the second members need not be sets. (Contributed by AV, 23-Jan-2021.)
theorem funcnvpr (A2 B2 C D U V: class):
  $ wi (w3a (wcel A2 U) (wcel C V) (wne B2 D)) (wfun (ccnv (cpr (cop A2 B2) (cop C D)))) $;

--| The converse triple of ordered pairs is a function if the second members are pairwise different. Note that the second members need not be sets. (Contributed by AV, 23-Jan-2021.)
theorem funcnvtp (A2 B2 C D U E F V W: class):
  $ wi (wa (w3a (wcel A2 U) (wcel C V) (wcel E W)) (w3a (wne B2 D) (wne B2 F) (wne D F))) (wfun (ccnv (ctp (cop A2 B2) (cop C D) (cop E F)))) $;

--| The converse quadruple of ordered pairs is a function if the second members are pairwise different. Note that the second members need not be sets. (Contributed by AV, 23-Jan-2021.) (Proof shortened by JJ, 14-Jul-2021.)
theorem funcnvqp (A2 B2 C D T U E F G H V W: class):
  $ wi (wa (wa (wa (wcel A2 U) (wcel C V)) (wa (wcel E W) (wcel G T))) (w3a (w3a (wne B2 D) (wne B2 F) (wne B2 H)) (wa (wne D F) (wne D H)) (wne F H))) (wfun (ccnv (cun (cpr (cop A2 B2) (cop C D)) (cpr (cop E F) (cop G H))))) $;

--| The empty set is a function. Theorem 10.3 of [Quine] p. 65. (Contributed by NM, 7-Apr-1998.)
theorem fun0:
  $ wfun c0 $;

--| The converse of the empty set is a function. (Contributed by AV, 7-Jan-2021.)
theorem funcnv0:
  $ wfun (ccnv c0) $;

--| The double converse of a function is a function. (Contributed by NM, 21-Sep-2004.)
theorem funcnvcnv (A2: class):
  $ wi (wfun A2) (wfun (ccnv (ccnv A2))) $;

--| A simpler equivalence for single-rooted (see ~ funcnv ). (Contributed by NM, 9-Aug-2004.)
theorem funcnv2 {x3 y1: setvar} (A2: class):
  $ wb (wfun (ccnv A2)) (wal y1 (wmo x3 (wbr (cv x3) (cv y1) A2))) $;

--| The converse of a class is a function iff the class is single-rooted, which means that for any ` y ` in the range of ` A ` there is at most one ` x ` such that ` x A y ` . Definition of single-rooted in [Enderton] p. 43. See ~ funcnv2 for a simpler version. (Contributed by NM, 13-Aug-2004.)
theorem funcnv {x3 y1: setvar} (A2: class):
  $ wb (wfun (ccnv A2)) (wral y1 (wmo x3 (wbr (cv x3) (cv y1) A2)) (crn A2)) $;

--| A condition showing a class is single-rooted. (See ~ funcnv ). (Contributed by NM, 26-May-2006.)
theorem funcnv3 {x3 y1: setvar} (A2: class):
  $ wb (wfun (ccnv A2)) (wral y1 (wreu x3 (wbr (cv x3) (cv y1) A2) (cdm A2)) (crn A2)) $;

--| The double converse of a class is a function iff the class is single-valued. Each side is equivalent to Definition 6.4(2) of [TakeutiZaring] p. 23, who use the notation "Un(A)" for single-valued. Note that ` A ` is not necessarily a function. (Contributed by NM, 13-Aug-2004.)
theorem fun2cnv {x3 y1: setvar} (A2: class):
  $ wb (wfun (ccnv (ccnv A2))) (wal x3 (wmo y1 (wbr (cv x3) (cv y1) A2))) $;

--| A single-valued relation is a function. (See ~ fun2cnv for "single-valued.") Definition 6.4(4) of [TakeutiZaring] p. 24. (Contributed by NM, 17-Jan-2006.)
theorem svrelfun (A2: class):
  $ wb (wfun A2) (wa (wrel A2) (wfun (ccnv (ccnv A2)))) $;

--| Single-rootedness (see ~ funcnv ) of a class cut down by a Cartesian product. (Contributed by NM, 5-Mar-2007.)
theorem fncnv {x3 y1: setvar} (A2 B2 R: class):
  $ wb (wfn (ccnv (cin R (cxp A2 B2))) B2) (wral y1 (wreu x3 (wbr (cv x3) (cv y1) R) A2) B2) $;

--| Two ways of stating that ` A ` is one-to-one (but not necessarily a function). Each side is equivalent to Definition 6.4(3) of [TakeutiZaring] p. 24, who use the notation "Un_2 (A)" for one-to-one (but not necessarily a function). (Contributed by NM, 17-Jan-2006.)
theorem fun11 {x3 y1 z w: setvar} (A2: class):
  $ wb (wa (wfun (ccnv (ccnv A2))) (wfun (ccnv A2))) (wal x3 (wal y1 (wal z (wal w (wi (wa (wbr (cv x3) (cv y1) A2) (wbr (cv z) (cv w) A2)) (wb (wceq (cv x3) (cv z)) (wceq (cv y1) (cv w)))))))) $;

--| The union of a chain (with respect to inclusion) of functions is a function. (Contributed by NM, 10-Aug-2004.)
theorem fununi {f2 g2: setvar} (A2: class):
  $ wi (wral f2 (wa (wfun (cv f2)) (wral g2 (wo (wss (cv f2) (cv g2)) (wss (cv g2) (cv f2))) A2)) A2) (wfun (cuni A2)) $;

--| The intersection with a function is a function. Exercise 14(a) of [Enderton] p. 53. (Contributed by NM, 19-Mar-2004.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem funin (F G: class):
  $ wi (wfun F) (wfun (cin F G)) $;

--| The restriction of a one-to-one function is one-to-one. (Contributed by NM, 25-Mar-1998.)
theorem funres11 (A2 F: class):
  $ wi (wfun (ccnv F)) (wfun (ccnv (cres F A2))) $;

--| The converse of a restricted function. (Contributed by NM, 27-Mar-1998.)
theorem funcnvres (A2 F: class):
  $ wi (wfun (ccnv F)) (wceq (ccnv (cres F A2)) (cres (ccnv F) (cima F A2))) $;

--| Converse of a restricted identity function. (Contributed by FL, 4-Mar-2007.)
theorem cnvresid (A2: class):
  $ wceq (ccnv (cres cid A2)) (cres cid A2) $;

--| The converse of a restriction of the converse of a function equals the function restricted to the image of its converse. (Contributed by NM, 4-May-2005.)
theorem funcnvres2 (A2 F: class):
  $ wi (wfun F) (wceq (ccnv (cres (ccnv F) A2)) (cres F (cima (ccnv F) A2))) $;

--| The image of the preimage of a function. (Contributed by NM, 25-May-2004.)
theorem funimacnv (A2 F: class):
  $ wi (wfun F) (wceq (cima F (cima (ccnv F) A2)) (cin A2 (crn F))) $;

--| A kind of contraposition law that infers a subclass of an image from a preimage subclass. (Contributed by NM, 25-May-2004.)
theorem funimass1 (A2 B2 F: class):
  $ wi (wa (wfun F) (wss A2 (crn F))) (wi (wss (cima (ccnv F) A2) B2) (wss A2 (cima F B2))) $;

--| A kind of contraposition law that infers an image subclass from a subclass of a preimage. (Contributed by NM, 25-May-2004.)
theorem funimass2 (A2 B2 F: class):
  $ wi (wa (wfun F) (wss A2 (cima (ccnv F) B2))) (wss (cima F A2) B2) $;

--| The image of a difference is the difference of images. (Contributed by NM, 24-May-1998.)
theorem imadif (A2 B2 F: class):
  $ wi (wfun (ccnv F)) (wceq (cima F (cdif A2 B2)) (cdif (cima F A2) (cima F B2))) $;

--| The image of an intersection is the intersection of images. (Contributed by Paul Chapman, 11-Apr-2009.)
theorem imain (A2 B2 F: class):
  $ wi (wfun (ccnv F)) (wceq (cima F (cin A2 B2)) (cin (cima F A2) (cima F B2))) $;

--| Axiom of Replacement using abbreviations. Axiom 39(vi) of [Quine] p. 284. Compare Exercise 9 of [TakeutiZaring] p. 29. (Contributed by NM, 10-Sep-2006.) Shorten proof and avoid ~ ax-10 , ~ ax-12 . (Revised by SN, 19-Dec-2024.)
theorem funimaexg (A2 B2 C: class):
  $ wi (wa (wfun A2) (wcel B2 C)) (wcel (cima A2 B2) cvv) $;

--| The image of a set under any function is also a set. Equivalent of Axiom of Replacement ~ ax-rep . Axiom 39(vi) of [Quine] p. 284. Compare Exercise 9 of [TakeutiZaring] p. 29. (Contributed by NM, 17-Nov-2002.)
theorem funimaex (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wi (wfun A2) (wcel (cima A2 B2) cvv) $;

--| Part of a study of the Axiom of Replacement used by the Isabelle prover. The object PrimReplace is apparently the image of the function encoded by ` ph ( x , y ) ` i.e. the class ` ( { <. x , y >. | ph } " A ) ` . If so, we can prove Isabelle's "Axiom of Replacement" conclusion without using the Axiom of Replacement, for which I (N. Megill) currently have no explanation. (Contributed by NM, 26-Oct-2006.) (Proof shortened by Mario Carneiro, 4-Dec-2016.) (Proof shortened by SN, 19-Dec-2024.)
theorem isarep1 {x3 y1 b: setvar} (ph: wff x3 y1 b) (A2: class y1 b):
  $ wb (wcel (cv b) (cima (copab x3 y1 ph) A2)) (wrex x3 (wsb y1 ph b) A2) $;

--| Part of a study of the Axiom of Replacement used by the Isabelle prover. In Isabelle, the sethood of PrimReplace is apparently postulated implicitly by its type signature " ` [ ` i, ` [ ` i, i ` ] ` => o ` ] ` => i", which automatically asserts that it is a set without using any axioms. To prove that it is a set in Metamath, we need the hypotheses of Isabelle's "Axiom of Replacement" as well as the Axiom of Replacement in the form ~ funimaex . (Contributed by NM, 26-Oct-2006.)
theorem isarep2 {x3 y1 z w: setvar} (ph: wff x3 y1) (A2: class z):
  $ wcel A2 cvv $ >
  $ wral x3 (wal y1 (wal z (wi (wa ph (wsb y1 ph z)) (wceq (cv y1) (cv z))))) A2 $ >
  $ wex w (wceq (cv w) (cima (copab x3 y1 ph) A2)) $;

--| Equality theorem for function predicate with domain. (Contributed by NM, 1-Aug-1994.)
theorem fneq1 (A2 F G: class):
  $ wi (wceq F G) (wb (wfn F A2) (wfn G A2)) $;

--| Equality theorem for function predicate with domain. (Contributed by NM, 1-Aug-1994.)
theorem fneq2 (A2 B2 F: class):
  $ wi (wceq A2 B2) (wb (wfn F A2) (wfn F B2)) $;

--| Equality deduction for function predicate with domain. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem fneq1d (ph: wff) (A2 F G: class):
  $ wi ph (wceq F G) $ >
  $ wi ph (wb (wfn F A2) (wfn G A2)) $;

--| Equality deduction for function predicate with domain. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem fneq2d (ph: wff) (A2 B2 F: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wfn F A2) (wfn F B2)) $;

--| Equality deduction for function predicate with domain. (Contributed by NM, 26-Jun-2011.)
theorem fneq12d (ph: wff) (A2 B2 F G: class):
  $ wi ph (wceq F G) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wfn F A2) (wfn G B2)) $;

--| Equality theorem for function predicate with domain. (Contributed by Thierry Arnoux, 31-Jan-2017.)
theorem fneq12 (A2 B2 F G: class):
  $ wi (wa (wceq F G) (wceq A2 B2)) (wb (wfn F A2) (wfn G B2)) $;

--| Equality inference for function predicate with domain. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem fneq1i (A2 F G: class):
  $ wceq F G $ >
  $ wb (wfn F A2) (wfn G A2) $;

--| Equality inference for function predicate with domain. (Contributed by NM, 4-Sep-2011.)
theorem fneq2i (A2 B2 F: class):
  $ wceq A2 B2 $ >
  $ wb (wfn F A2) (wfn F B2) $;

--| Bound-variable hypothesis builder for a function with domain. (Contributed by NM, 30-Jan-2004.)
theorem nffn {x3: setvar} (A2 F: class x3):
  $ wnfc x3 F $ >
  $ wnfc x3 A2 $ >
  $ wnf x3 (wfn F A2) $;

--| A function with domain is a function. (Contributed by NM, 1-Aug-1994.)
theorem fnfun (A2 F: class):
  $ wi (wfn F A2) (wfun F) $;

--| A function with domain is a function, deduction form. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.)
theorem fnfund (ph: wff) (A2 F: class):
  $ wi ph (wfn F A2) $ >
  $ wi ph (wfun F) $;

--| A function with domain is a relation. (Contributed by NM, 1-Aug-1994.)
theorem fnrel (A2 F: class):
  $ wi (wfn F A2) (wrel F) $;

--| The domain of a function. (Contributed by NM, 2-Aug-1994.)
theorem fndm (A2 F: class):
  $ wi (wfn F A2) (wceq (cdm F) A2) $;

--| The domain of a function. (Contributed by Wolf Lammen, 1-Jun-2024.)
theorem fndmi (A2 F: class):
  $ wfn F A2 $ >
  $ wceq (cdm F) A2 $;

--| The domain of a function. (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem fndmd (ph: wff) (A2 F: class):
  $ wi ph (wfn F A2) $ >
  $ wi ph (wceq (cdm F) A2) $;

--| Inference to convert a function and domain antecedent. (Contributed by NM, 22-Apr-2004.)
theorem funfni (ph: wff) (A2 B2 F: class):
  $ wi (wa (wfun F) (wcel B2 (cdm F))) ph $ >
  $ wi (wa (wfn F A2) (wcel B2 A2)) ph $;

--| A function has a unique domain. (Contributed by NM, 11-Aug-1994.)
theorem fndmu (A2 B2 F: class):
  $ wi (wa (wfn F A2) (wfn F B2)) (wceq A2 B2) $;

--| The first argument of binary relation on a function belongs to the function's domain. (Contributed by NM, 7-May-2004.)
theorem fnbr (A2 B2 C F: class):
  $ wi (wa (wfn F A2) (wbr B2 C F)) (wcel B2 A2) $;

--| The first argument of an ordered pair in a function belongs to the function's domain. (Contributed by NM, 8-Aug-1994.)
theorem fnop (A2 B2 C F: class):
  $ wi (wa (wfn F A2) (wcel (cop B2 C) F)) (wcel B2 A2) $;

--| There is exactly one value of a function. (Contributed by NM, 22-Apr-2004.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem fneu {y1: setvar} (A2: class y1) (B2 F: class):
  $ wi (wa (wfn F A2) (wcel B2 A2)) (weu y1 (wbr B2 (cv y1) F)) $;

--| There is exactly one value of a function. (Contributed by NM, 7-Nov-1995.)
theorem fneu2 {y1: setvar} (A2: class y1) (B2 F: class):
  $ wi (wa (wfn F A2) (wcel B2 A2)) (weu y1 (wcel (cop B2 (cv y1)) F)) $;

--| Restriction of a disjoint union to the domain of the first function. (Contributed by Thierry Arnoux, 9-Dec-2021.)
theorem fnunres1 (A2 B2 F G: class):
  $ wi (w3a (wfn F A2) (wfn G B2) (wceq (cin A2 B2) c0)) (wceq (cres (cun F G) A2) F) $;

--| Restriction of a disjoint union to the domain of the second function. (Contributed by Thierry Arnoux, 12-Oct-2023.)
theorem fnunres2 (A2 B2 F G: class):
  $ wi (w3a (wfn F A2) (wfn G B2) (wceq (cin A2 B2) c0)) (wceq (cres (cun F G) B2) G) $;

--| The union of two functions with disjoint domains. (Contributed by NM, 22-Sep-2004.)
theorem fnun (A2 B2 F G: class):
  $ wi (wa (wa (wfn F A2) (wfn G B2)) (wceq (cin A2 B2) c0)) (wfn (cun F G) (cun A2 B2)) $;

--| The union of two functions with disjoint domains, a deduction version. (Contributed by metakunt, 28-May-2024.)
theorem fnund (ph: wff) (A2 B2 F G: class):
  $ wi ph (wfn F A2) $ >
  $ wi ph (wfn G B2) $ >
  $ wi ph (wceq (cin A2 B2) c0) $ >
  $ wi ph (wfn (cun F G) (cun A2 B2)) $;

--| Extension of a function with a new ordered pair. (Contributed by NM, 28-Sep-2013.) (Revised by Mario Carneiro, 30-Apr-2015.) (Revised by AV, 16-Aug-2024.)
theorem fnunop (ph: wff) (D E F G V W X Y: class):
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y W) $ >
  $ wi ph (wfn F D) $ >
  $ wceq G (cun F (csn (cop X Y))) $ >
  $ wceq E (cun D (csn X)) $ >
  $ wi ph (wn (wcel X D)) $ >
  $ wi ph (wfn G E) $;

--| Composition of a function with domain and a function as a function with domain. Generalization of ~ fnco . (Contributed by AV, 17-Sep-2024.)
theorem fncofn (A2 F G: class):
  $ wi (wa (wfn F A2) (wfun G)) (wfn (ccom F G) (cima (ccnv G) A2)) $;

--| Composition of two functions with domains as a function with domain. (Contributed by NM, 22-May-2006.) (Proof shortened by AV, 20-Sep-2024.)
theorem fnco (A2 B2 F G: class):
  $ wi (w3a (wfn F A2) (wfn G B2) (wss (crn G) A2)) (wfn (ccom F G) B2) $;

--| A function does not change when restricted to its domain. (Contributed by NM, 5-Sep-2004.)
theorem fnresdm (A2 F: class):
  $ wi (wfn F A2) (wceq (cres F A2) F) $;

--| A function restricted to a class disjoint with its domain is empty. (Contributed by NM, 23-Sep-2004.)
theorem fnresdisj (A2 B2 F: class):
  $ wi (wfn F A2) (wb (wceq (cin A2 B2) c0) (wceq (cres F B2) c0)) $;

--| Membership in two functions restricted by each other's domain. (Contributed by NM, 8-Aug-1994.)
theorem _2elresin {y1 z: setvar} (x3: setvar) (A2 B2 F G: class y1 z):
  $ wi (wa (wfn F A2) (wfn G B2)) (wb (wa (wcel (cop (cv x3) (cv y1)) F) (wcel (cop (cv x3) (cv z)) G)) (wa (wcel (cop (cv x3) (cv y1)) (cres F (cin A2 B2))) (wcel (cop (cv x3) (cv z)) (cres G (cin A2 B2))))) $;

--| Restriction of a function with a subclass of its domain. (Contributed by NM, 10-Oct-2007.)
theorem fnssresb (A2 B2 F: class):
  $ wi (wfn F A2) (wb (wfn (cres F B2) B2) (wss B2 A2)) $;

--| Restriction of a function with a subclass of its domain. (Contributed by NM, 2-Aug-1994.)
theorem fnssres (A2 B2 F: class):
  $ wi (wa (wfn F A2) (wss B2 A2)) (wfn (cres F B2) B2) $;

--| Restriction of a function to a subclass of its domain. (Contributed by Glauco Siliprandi, 5-Feb-2022.)
theorem fnssresd (ph: wff) (A2 B2 F: class):
  $ wi ph (wfn F A2) $ >
  $ wi ph (wss B2 A2) $ >
  $ wi ph (wfn (cres F B2) B2) $;

--| Restriction of a function's domain with an intersection. (Contributed by NM, 9-Aug-1994.)
theorem fnresin1 (A2 B2 F: class):
  $ wi (wfn F A2) (wfn (cres F (cin A2 B2)) (cin A2 B2)) $;

--| Restriction of a function's domain with an intersection. (Contributed by NM, 9-Aug-1994.)
theorem fnresin2 (A2 B2 F: class):
  $ wi (wfn F A2) (wfn (cres F (cin B2 A2)) (cin B2 A2)) $;

--| An equivalence for functionality of a restriction. Compare ~ dffun8 . (Contributed by Mario Carneiro, 20-May-2015.) (Proof shortened by Peter Mazsa, 2-Oct-2022.)
theorem fnres {x3 y1: setvar} (A2 F: class):
  $ wb (wfn (cres F A2) A2) (wral x3 (weu y1 (wbr (cv x3) (cv y1) F)) A2) $;

--| The identity relation is a function on the universal class. See also ~ funi . (Contributed by BJ, 23-Dec-2023.)
theorem idfn:
  $ wfn cid cvv $;

--| The restricted identity relation is a function on the restricting class. (Contributed by NM, 27-Aug-2004.) (Proof shortened by BJ, 27-Dec-2023.)
theorem fnresi (A2: class):
  $ wfn (cres cid A2) A2 $;

--| The image of a function's domain is its range. (Contributed by NM, 4-Nov-2004.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem fnima (A2 F: class):
  $ wi (wfn F A2) (wceq (cima F A2) (crn F)) $;

--| A function with empty domain is empty. (Contributed by NM, 15-Apr-1998.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem fn0 (F: class):
  $ wb (wfn F c0) (wceq F c0) $;

--| A class that is disjoint with the domain of a function has an empty image under the function. (Contributed by FL, 24-Jan-2007.)
theorem fnimadisj (A2 C F: class):
  $ wi (wa (wfn F A2) (wceq (cin A2 C) c0)) (wceq (cima F C) c0) $;

--| Images under a function never map nonempty sets to empty sets. (Contributed by Stefan O'Rear, 21-Jan-2015.)
theorem fnimaeq0 (A2 B2 F: class):
  $ wi (wa (wfn F A2) (wss B2 A2)) (wb (wceq (cima F B2) c0) (wceq B2 c0)) $;

--| Alternate definition for the maps-to notation ~ df-mpt . (Contributed by Mario Carneiro, 30-Dec-2016.)
theorem dfmpt3 {x3: setvar} (A2 B2: class x3):
  $ wceq (cmpt x3 A2 B2) (ciun x3 A2 (cxp (csn (cv x3)) (csn B2))) $;

--| The maps-to notation defines a function with domain. (Contributed by Scott Fenton, 21-Mar-2011.) (Revised by Thierry Arnoux, 10-May-2017.)
theorem mptfnf {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wb (wral x3 (wcel B2 cvv) A2) (wfn (cmpt x3 A2 B2) A2) $;

--| The maps-to notation defines a function with domain. (Contributed by NM, 9-Apr-2013.) (Revised by Thierry Arnoux, 10-May-2017.)
theorem fnmptf {x3: setvar} (A2 B2 V: class x3):
  $ wnfc x3 A2 $ >
  $ wi (wral x3 (wcel B2 V) A2) (wfn (cmpt x3 A2 B2) A2) $;

--| Functionality and domain of an ordered-pair class abstraction. (Contributed by NM, 30-Jan-2004.) (Proof shortened by Mario Carneiro, 4-Dec-2016.)
theorem fnopabg {x3 y1: setvar} (ph: wff x3 y1) (A2: class) (F: class x3 y1):
  $ wceq F (copab x3 y1 (wa (wcel (cv x3) A2) ph)) $ >
  $ wb (wral x3 (weu y1 ph) A2) (wfn F A2) $;

--| Functionality and domain of an ordered-pair class abstraction. (Contributed by NM, 5-Mar-1996.)
theorem fnopab {x3 y1: setvar} (ph: wff x3 y1) (A2: class) (F: class x3 y1):
  $ wi (wcel (cv x3) A2) (weu y1 ph) $ >
  $ wceq F (copab x3 y1 (wa (wcel (cv x3) A2) ph)) $ >
  $ wfn F A2 $;

--| The maps-to notation defines a function with domain. (Contributed by Scott Fenton, 21-Mar-2011.)
theorem mptfng {x3: setvar} (A2: class) (B2 F: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wb (wral x3 (wcel B2 cvv) A2) (wfn F A2) $;

--| The maps-to notation defines a function with domain. (Contributed by NM, 9-Apr-2013.)
theorem fnmpt {x3: setvar} (A2: class) (B2 F V: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wral x3 (wcel B2 V) A2) (wfn F A2) $;

--| The maps-to notation defines a function with domain. (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem fnmptd {x3: setvar} (ph: wff x3) (A2: class) (B2 F V: class x3):
  $ wnf x3 ph $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi ph (wfn F A2) $;

--| A mapping operation with empty domain. (Contributed by Mario Carneiro, 28-Dec-2014.)
theorem mpt0 {x3: setvar} (A2: class x3):
  $ wceq (cmpt x3 c0 A2) c0 $;

--| The maps-to notation defines a function with domain. (Contributed by NM, 29-Jan-2004.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem fnmpti {x3: setvar} (A2: class) (B2 F: class x3):
  $ wcel B2 cvv $ >
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wfn F A2 $;

--| Domain of the mapping operation. (Contributed by NM, 6-Sep-2005.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem dmmpti {x3: setvar} (A2: class) (B2 F: class x3):
  $ wcel B2 cvv $ >
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wceq (cdm F) A2 $;

--| The domain of the mapping operation, deduction form. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem dmmptd {x3: setvar} (ph: wff) (A2: class x3) (B2: class) (C V: class x3):
  $ wceq A2 (cmpt x3 B2 C) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wcel C V) $ >
  $ wi ph (wceq (cdm A2) B2) $;

--| Union of mappings which are mutually compatible. (Contributed by Mario Carneiro, 31-Aug-2015.)
theorem mptun {x3: setvar} (A2 B2 C: class x3):
  $ wceq (cmpt x3 (cun A2 B2) C) (cun (cmpt x3 A2 C) (cmpt x3 B2 C)) $;

--| Rewrite a function defined by parts, using a mapping and an if construct, into a union of functions on disjoint domains. (Contributed by Thierry Arnoux, 30-Mar-2017.)
theorem partfun {x3: setvar} (A2 B2 C D: class x3):
  $ wceq (cmpt x3 A2 (cif (wcel (cv x3) B2) C D)) (cun (cmpt x3 (cin A2 B2) C) (cmpt x3 (cdif A2 B2) D)) $;

--| Equality theorem for functions. (Contributed by NM, 1-Aug-1994.)
theorem feq1 (A2 B2 F G: class):
  $ wi (wceq F G) (wb (wf A2 B2 F) (wf A2 B2 G)) $;

--| Equality theorem for functions. (Contributed by NM, 1-Aug-1994.)
theorem feq2 (A2 B2 C F: class):
  $ wi (wceq A2 B2) (wb (wf A2 C F) (wf B2 C F)) $;

--| Equality theorem for functions. (Contributed by NM, 1-Aug-1994.)
theorem feq3 (A2 B2 C F: class):
  $ wi (wceq A2 B2) (wb (wf C A2 F) (wf C B2 F)) $;

--| Equality theorem for functions. (Contributed by FL, 14-Jul-2007.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem feq23 (A2 B2 C D F: class):
  $ wi (wa (wceq A2 C) (wceq B2 D)) (wb (wf A2 B2 F) (wf C D F)) $;

--| Equality deduction for functions. (Contributed by NM, 19-Feb-2008.)
theorem feq1d (ph: wff) (A2 B2 F G: class):
  $ wi ph (wceq F G) $ >
  $ wi ph (wb (wf A2 B2 F) (wf A2 B2 G)) $;

--| Equality deduction for functions. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem feq1dd (ph: wff) (A2 B2 F G: class):
  $ wi ph (wceq F G) $ >
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wf A2 B2 G) $;

--| Equality deduction for functions. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem feq2d (ph: wff) (A2 B2 C F: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wf A2 C F) (wf B2 C F)) $;

--| Equality deduction for functions. (Contributed by AV, 1-Jan-2020.)
theorem feq3d (ph: wff) (A2 B2 F X: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wf X A2 F) (wf X B2 F)) $;

--| Equality deduction for functions. (Contributed by Thierry Arnoux, 27-May-2025.)
theorem feq2dd (ph: wff) (A2 B2 C F: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wf A2 C F) $ >
  $ wi ph (wf B2 C F) $;

--| Equality deduction for functions. (Contributed by Thierry Arnoux, 27-May-2025.)
theorem feq3dd (ph: wff) (A2 B2 C F: class):
  $ wi ph (wceq B2 C) $ >
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wf A2 C F) $;

--| Equality deduction for functions. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem feq12d (ph: wff) (A2 B2 C F G: class):
  $ wi ph (wceq F G) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wf A2 C F) (wf B2 C G)) $;

--| Equality deduction for functions. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem feq123d (ph: wff) (A2 B2 C D F G: class):
  $ wi ph (wceq F G) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wb (wf A2 C F) (wf B2 D G)) $;

--| Equality theorem for functions. (Contributed by FL, 16-Nov-2008.)
theorem feq123 (A2 B2 C D F G: class):
  $ wi (w3a (wceq F G) (wceq A2 C) (wceq B2 D)) (wb (wf A2 B2 F) (wf C D G)) $;

--| Equality inference for functions. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem feq1i (A2 B2 F G: class):
  $ wceq F G $ >
  $ wb (wf A2 B2 F) (wf A2 B2 G) $;

--| Equality inference for functions. (Contributed by NM, 5-Sep-2011.)
theorem feq2i (A2 B2 C F: class):
  $ wceq A2 B2 $ >
  $ wb (wf A2 C F) (wf B2 C F) $;

--| Equality inference for functions. (Contributed by AV, 7-Feb-2021.)
theorem feq12i (A2 B2 C F G: class):
  $ wceq F G $ >
  $ wceq A2 B2 $ >
  $ wb (wf A2 C F) (wf B2 C G) $;

--| Equality inference for functions. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem feq23i (A2 B2 C D F: class):
  $ wceq A2 C $ >
  $ wceq B2 D $ >
  $ wb (wf A2 B2 F) (wf C D F) $;

--| Equality deduction for functions. (Contributed by NM, 8-Jun-2013.)
theorem feq23d (ph: wff) (A2 B2 C D F: class):
  $ wi ph (wceq A2 C) $ >
  $ wi ph (wceq B2 D) $ >
  $ wi ph (wb (wf A2 B2 F) (wf C D F)) $;

--| Bound-variable hypothesis builder for a mapping. (Contributed by NM, 29-Jan-2004.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem nff {x3: setvar} (A2 B2 F: class x3):
  $ wnfc x3 F $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnf x3 (wf A2 B2 F) $;

--| Distribute proper substitution through the function predicate with a domain. (Contributed by Alexander van der Vekens, 15-Jul-2018.)
theorem sbcfng {x3: setvar} (A2 F: class x3) (V X: class):
  $ wi (wcel X V) (wb (wsbc x3 (wfn F A2) X) (wfn (csb x3 X F) (csb x3 X A2))) $;

--| Distribute proper substitution through the function predicate with domain and codomain. (Contributed by Alexander van der Vekens, 15-Jul-2018.)
theorem sbcfg {x3: setvar} (A2 B2 F: class x3) (V X: class):
  $ wi (wcel X V) (wb (wsbc x3 (wf A2 B2 F) X) (wf (csb x3 X A2) (csb x3 X B2) (csb x3 X F))) $;

--| Eliminate a mapping hypothesis for the weak deduction theorem ~ dedth , when a special case ` G : A --> B ` is provable, in order to convert ` F : A --> B ` from a hypothesis to an antecedent. (Contributed by NM, 24-Aug-2006.)
theorem elimf (A2 B2 F G: class):
  $ wf A2 B2 G $ >
  $ wf A2 B2 (cif (wf A2 B2 F) F G) $;

--| A mapping is a function with domain. (Contributed by NM, 2-Aug-1994.)
theorem ffn (A2 B2 F: class):
  $ wi (wf A2 B2 F) (wfn F A2) $;

--| A mapping is a function with domain, deduction form. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem ffnd (ph: wff) (A2 B2 F: class):
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wfn F A2) $;

--| Any function is a mapping into ` _V ` . (Contributed by NM, 31-Oct-1995.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem dffn2 (A2 F: class):
  $ wb (wfn F A2) (wf A2 cvv F) $;

--| A mapping is a function. (Contributed by NM, 3-Aug-1994.) (Proof shortened by Umit Teoman Dogan, 10-Jun-2026.)
theorem ffun (A2 B2 F: class):
  $ wi (wf A2 B2 F) (wfun F) $;

--| Obsolete version of ~ ffun as of 10-Jun-2026. (Contributed by NM, 3-Aug-1994.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ffunOLD (A2 B2 F: class):
  $ wi (wf A2 B2 F) (wfun F) $;

--| A mapping is a function, deduction version. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem ffund (ph: wff) (A2 B2 F: class):
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wfun F) $;

--| A mapping is a relation. (Contributed by NM, 3-Aug-1994.)
theorem frel (A2 B2 F: class):
  $ wi (wf A2 B2 F) (wrel F) $;

--| A mapping is a relation. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem freld (ph: wff) (A2 B2 F: class):
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wrel F) $;

--| The range of a mapping. (Contributed by NM, 3-Aug-1994.)
theorem frn (A2 B2 F: class):
  $ wi (wf A2 B2 F) (wss (crn F) B2) $;

--| Deduction form of ~ frn . The range of a mapping. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem frnd (ph: wff) (A2 B2 F: class):
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wss (crn F) B2) $;

--| The domain of a mapping. (Contributed by NM, 2-Aug-1994.) (Proof shortened by Wolf Lammen, 29-May-2024.)
theorem fdm (A2 B2 F: class):
  $ wi (wf A2 B2 F) (wceq (cdm F) A2) $;

--| Deduction form of ~ fdm . The domain of a mapping. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem fdmd (ph: wff) (A2 B2 F: class):
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wceq (cdm F) A2) $;

--| Inference associated with ~ fdm . The domain of a mapping. (Contributed by NM, 28-Jul-2008.)
theorem fdmi (A2 B2 F: class):
  $ wf A2 B2 F $ >
  $ wceq (cdm F) A2 $;

--| A function maps to its range. (Contributed by NM, 1-Sep-1999.)
theorem dffn3 (A2 F: class):
  $ wb (wfn F A2) (wf A2 (crn F) F) $;

--| A function maps to its range. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem ffrn (A2 B2 F: class):
  $ wi (wf A2 B2 F) (wf A2 (crn F) F) $;

--| Characterization of a function with domain and codomain (essentially using that the range is always included in the codomain). Generalization of ~ ffrn . (Contributed by BJ, 21-Sep-2024.)
theorem ffrnb (A2 B2 F: class):
  $ wb (wf A2 B2 F) (wa (wf A2 (crn F) F) (wss (crn F) B2)) $;

--| A function maps to its range iff the range is a subset of its codomain. Generalization of ~ ffrn . (Contributed by AV, 20-Sep-2024.)
theorem ffrnbd (ph: wff) (A2 B2 F: class):
  $ wi ph (wss (crn F) B2) $ >
  $ wi ph (wb (wf A2 B2 F) (wf A2 (crn F) F)) $;

--| Expanding the codomain of a mapping. (Contributed by NM, 10-May-1998.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem fss (A2 B2 C F: class):
  $ wi (wa (wf A2 B2 F) (wss B2 C)) (wf A2 C F) $;

--| Expanding the codomain of a mapping, deduction form. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem fssd (ph: wff) (A2 B2 C F: class):
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wss B2 C) $ >
  $ wi ph (wf A2 C F) $;

--| Expressing that a class is a subclass of the domain of a function expressed in maps-to notation, deduction form. (Contributed by AV, 21-Aug-2022.)
theorem fssdmd (ph: wff) (A2 B2 D F: class):
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wss D (cdm F)) $ >
  $ wi ph (wss D A2) $;

--| Expressing that a class is a subclass of the domain of a function expressed in maps-to notation, semi-deduction form. (Contributed by AV, 21-Aug-2022.)
theorem fssdm (ph: wff) (A2 B2 D F: class):
  $ wss D (cdm F) $ >
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wss D A2) $;

--| The image of a class under a function with domain and codomain is a subset of its codomain. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem fimass (A2 B2 F X: class):
  $ wi (wf A2 B2 F) (wss (cima F X) B2) $;

--| The image of a class is a subset of its codomain. (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem fimassd (ph: wff) (A2 B2 F X: class):
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wss (cima F X) B2) $;

--| The preimage of the codomain of a function is the function's domain. (Contributed by FL, 25-Jan-2007.) (Proof shortened by AV, 20-Sep-2024.)
theorem fimacnv (A2 B2 F: class):
  $ wi (wf A2 B2 F) (wceq (cima (ccnv F) B2) A2) $;

--| Composition of a function with domain and codomain and a function as a function with domain and codomain. Generalization of ~ fco . (Contributed by AV, 18-Sep-2024.)
theorem fcof (A2 B2 F G: class):
  $ wi (wa (wf A2 B2 F) (wfun G)) (wf (cima (ccnv G) A2) B2 (ccom F G)) $;

--| Composition of two functions with domain and codomain as a function with domain and codomain. (Contributed by NM, 29-Aug-1999.) (Proof shortened by Andrew Salmon, 17-Sep-2011.) (Proof shortened by AV, 20-Sep-2024.)
theorem fco (A2 B2 C F G: class):
  $ wi (wa (wf B2 C F) (wf A2 B2 G)) (wf A2 C (ccom F G)) $;

--| Composition of two mappings. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem fcod (ph: wff) (A2 B2 C F G: class):
  $ wi ph (wf B2 C F) $ >
  $ wi ph (wf A2 B2 G) $ >
  $ wi ph (wf A2 C (ccom F G)) $;

--| Functionality of a composition with weakened out of domain condition on the first argument. (Contributed by Stefan O'Rear, 11-Mar-2015.)
theorem fco2 (A2 B2 C F G: class):
  $ wi (wa (wf B2 C (cres F B2)) (wf A2 B2 G)) (wf A2 C (ccom F G)) $;

--| A mapping is a class of ordered pairs. (Contributed by NM, 3-Aug-1994.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem fssxp (A2 B2 F: class):
  $ wi (wf A2 B2 F) (wss F (cxp A2 B2)) $;

--| Two ways of specifying a partial function from ` A ` to ` B ` . (Contributed by NM, 13-Nov-2007.)
theorem funssxp (A2 B2 F: class):
  $ wb (wa (wfun F) (wss F (cxp A2 B2))) (wa (wf (cdm F) B2 F) (wss (cdm F) A2)) $;

--| A mapping is a partial function. (Contributed by NM, 25-Nov-2007.)
theorem ffdm (A2 B2 F: class):
  $ wi (wf A2 B2 F) (wa (wf (cdm F) B2 F) (wss (cdm F) A2)) $;

--| The domain of a function. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem ffdmd (ph: wff) (A2 B2 F: class):
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wf (cdm F) B2 F) $;

--| A different way to write ` F ` is a function. (Contributed by Thierry Arnoux, 7-Dec-2016.)
theorem fdmrn (F: class):
  $ wb (wfun F) (wf (cdm F) (crn F) F) $;

--| Composition of two functions as a function with domain and codomain. (Contributed by Glauco Siliprandi, 26-Jun-2021.) (Proof shortened by AV, 20-Sep-2024.)
theorem funcofd (ph: wff) (F G: class):
  $ wi ph (wfun F) $ >
  $ wi ph (wfun G) $ >
  $ wi ph (wf (cima (ccnv G) (cdm F)) (crn F) (ccom F G)) $;

--| The members of an ordered pair element of a mapping belong to the mapping's domain and codomain. (Contributed by NM, 10-Dec-2003.) (Revised by Mario Carneiro, 26-Apr-2015.)
theorem opelf (A2 B2 C D F: class):
  $ wi (wa (wf A2 B2 F) (wcel (cop C D) F)) (wa (wcel C A2) (wcel D B2)) $;

--| The union of two functions with disjoint domains. (Contributed by NM, 22-Sep-2004.)
theorem fun (A2 B2 C D F G: class):
  $ wi (wa (wa (wf A2 C F) (wf B2 D G)) (wceq (cin A2 B2) c0)) (wf (cun A2 B2) (cun C D) (cun F G)) $;

--| The union of two functions with disjoint domains. (Contributed by Mario Carneiro, 12-Mar-2015.)
theorem fun2 (A2 B2 C F G: class):
  $ wi (wa (wa (wf A2 C F) (wf B2 C G)) (wceq (cin A2 B2) c0)) (wf (cun A2 B2) C (cun F G)) $;

--| The union of functions with disjoint domains is a function, deduction version of ~ fun2 . (Contributed by AV, 11-Oct-2020.) (Revised by AV, 24-Oct-2021.)
theorem fun2d (ph: wff) (A2 B2 C F G: class):
  $ wi ph (wf A2 C F) $ >
  $ wi ph (wf B2 C G) $ >
  $ wi ph (wceq (cin A2 B2) c0) $ >
  $ wi ph (wf (cun A2 B2) C (cun F G)) $;

--| Composition of two functions. (Contributed by NM, 22-May-2006.)
theorem fnfco (A2 B2 F G: class):
  $ wi (wa (wfn F A2) (wf B2 A2 G)) (wfn (ccom F G) B2) $;

--| Restriction of a function with a subclass of its domain. (Contributed by NM, 23-Sep-2004.)
theorem fssres (A2 B2 C F: class):
  $ wi (wa (wf A2 B2 F) (wss C A2)) (wf C B2 (cres F C)) $;

--| Restriction of a function with a subclass of its domain, deduction form. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem fssresd (ph: wff) (A2 B2 C F: class):
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wss C A2) $ >
  $ wi ph (wf C B2 (cres F C)) $;

--| Restriction of a restricted function with a subclass of its domain. (Contributed by NM, 21-Jul-2005.)
theorem fssres2 (A2 B2 C F: class):
  $ wi (wa (wf A2 B2 (cres F A2)) (wss C A2)) (wf C B2 (cres F C)) $;

--| An identity for the mapping relationship under restriction. (Contributed by Scott Fenton, 4-Sep-2011.) (Proof shortened by Mario Carneiro, 26-May-2016.)
theorem fresin (A2 B2 F X: class):
  $ wi (wf A2 B2 F) (wf (cin A2 X) B2 (cres F X)) $;

--| If two functions agree on their common domain, express their union as a union of three functions with pairwise disjoint domains. (Contributed by Stefan O'Rear, 9-Oct-2014.)
theorem resasplit (A2 B2 F G: class):
  $ wi (w3a (wfn F A2) (wfn G B2) (wceq (cres F (cin A2 B2)) (cres G (cin A2 B2)))) (wceq (cun F G) (cun (cres F (cin A2 B2)) (cun (cres F (cdif A2 B2)) (cres G (cdif B2 A2))))) $;

--| The union of two functions which agree on their common domain is a function. (Contributed by Stefan O'Rear, 9-Oct-2014.)
theorem fresaun (A2 B2 C F G: class):
  $ wi (w3a (wf A2 C F) (wf B2 C G) (wceq (cres F (cin A2 B2)) (cres G (cin A2 B2)))) (wf (cun A2 B2) C (cun F G)) $;

--| From the union of two functions that agree on the domain overlap, either component can be recovered by restriction. (Contributed by Stefan O'Rear, 9-Oct-2014.)
theorem fresaunres2 (A2 B2 C F G: class):
  $ wi (w3a (wf A2 C F) (wf B2 C G) (wceq (cres F (cin A2 B2)) (cres G (cin A2 B2)))) (wceq (cres (cun F G) B2) G) $;

--| From the union of two functions that agree on the domain overlap, either component can be recovered by restriction. (Contributed by Mario Carneiro, 16-Feb-2015.)
theorem fresaunres1 (A2 B2 C F G: class):
  $ wi (w3a (wf A2 C F) (wf B2 C G) (wceq (cres F (cin A2 B2)) (cres G (cin A2 B2)))) (wceq (cres (cun F G) A2) F) $;

--| Composition of a mapping and restricted identity. (Contributed by NM, 13-Dec-2003.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem fcoi1 (A2 B2 F: class):
  $ wi (wf A2 B2 F) (wceq (ccom F (cres cid A2)) F) $;

--| Composition of restricted identity and a mapping. (Contributed by NM, 13-Dec-2003.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem fcoi2 (A2 B2 F: class):
  $ wi (wf A2 B2 F) (wceq (ccom (cres cid B2) F) F) $;

--| There is exactly one value of a function in its codomain. (Contributed by NM, 10-Dec-2003.)
theorem feu {y1: setvar} (A2 B2 C F: class):
  $ wi (wa (wf A2 B2 F) (wcel C A2)) (wreu y1 (wcel (cop C (cv y1)) F) B2) $;

--| The converse of a restriction of a function. (Contributed by NM, 26-Mar-1998.)
theorem fcnvres (A2 B2 F: class):
  $ wi (wf A2 B2 F) (wceq (ccnv (cres F A2)) (cres (ccnv F) B2)) $;

--| The preimage of a class disjoint with a mapping's codomain is empty. (Contributed by FL, 24-Jan-2007.)
theorem fimacnvdisj (A2 B2 C F: class):
  $ wi (wa (wf A2 B2 F) (wceq (cin B2 C) c0)) (wceq (cima (ccnv F) C) c0) $;

--| Function into an intersection. (Contributed by NM, 14-Oct-1999.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem fint {x3: setvar} (A2 B2 F: class):
  $ wne B2 c0 $ >
  $ wb (wf A2 (cint B2) F) (wral x3 (wf A2 (cv x3) F) B2) $;

--| Mapping into an intersection. (Contributed by NM, 14-Sep-1999.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem fin (A2 B2 C F: class):
  $ wb (wf A2 (cin B2 C) F) (wa (wf A2 B2 F) (wf A2 C F)) $;

--| The empty function. (Contributed by NM, 14-Aug-1999.)
theorem f0 (A2: class):
  $ wf c0 A2 c0 $;

--| A class is a function with empty codomain iff it and its domain are empty. (Contributed by NM, 10-Dec-2003.)
theorem f00 (A2 F: class):
  $ wb (wf A2 c0 F) (wa (wceq F c0) (wceq A2 c0)) $;

--| A function with empty domain is empty. (Contributed by Alexander van der Vekens, 30-Jun-2018.)
theorem f0bi (F X: class):
  $ wb (wf c0 X F) (wceq F c0) $;

--| A function is empty iff it has an empty domain. (Contributed by AV, 10-Feb-2019.)
theorem f0dom0 (F X Y: class):
  $ wi (wf X Y F) (wb (wceq X c0) (wceq F c0)) $;

--| If there is no element in the range of a function, its domain must be empty. (Contributed by Alexander van der Vekens, 12-Jul-2018.)
theorem f0rn0 {y1: setvar} (E: class) (X: class y1) (Y: class):
  $ wi (wa (wf X Y E) (wn (wrex y1 (wcel (cv y1) (crn E)) Y))) (wceq X c0) $;

--| A Cartesian product with a singleton is a constant function. (Contributed by NM, 14-Aug-1999.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem fconst (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wf A2 (csn B2) (cxp A2 (csn B2)) $;

--| A Cartesian product with a singleton is a constant function. (Contributed by NM, 19-Oct-2004.)
theorem fconstg (A2 B2 V: class):
  $ wi (wcel B2 V) (wf A2 (csn B2) (cxp A2 (csn B2))) $;

--| A Cartesian product with a singleton is a constant function. (Contributed by NM, 24-Jul-2014.)
theorem fnconstg (A2 B2 V: class):
  $ wi (wcel B2 V) (wfn (cxp A2 (csn B2)) A2) $;

--| Constant function with loose range. (Contributed by Stefan O'Rear, 1-Feb-2015.)
theorem fconst6g (A2 B2 C: class):
  $ wi (wcel B2 C) (wf A2 C (cxp A2 (csn B2))) $;

--| A constant function as a mapping. (Contributed by Jeff Madsen, 30-Nov-2009.) (Revised by Mario Carneiro, 22-Apr-2015.)
theorem fconst6 (A2 B2 C: class):
  $ wcel B2 C $ >
  $ wf A2 C (cxp A2 (csn B2)) $;

--| Equality theorem for one-to-one functions. (Contributed by NM, 10-Feb-1997.)
theorem f1eq1 (A2 B2 F G: class):
  $ wi (wceq F G) (wb (wf1 A2 B2 F) (wf1 A2 B2 G)) $;

--| Equality theorem for one-to-one functions. (Contributed by NM, 10-Feb-1997.)
theorem f1eq2 (A2 B2 C F: class):
  $ wi (wceq A2 B2) (wb (wf1 A2 C F) (wf1 B2 C F)) $;

--| Equality theorem for one-to-one functions. (Contributed by NM, 10-Feb-1997.)
theorem f1eq3 (A2 B2 C F: class):
  $ wi (wceq A2 B2) (wb (wf1 C A2 F) (wf1 C B2 F)) $;

--| Bound-variable hypothesis builder for a one-to-one function. (Contributed by NM, 16-May-2004.)
theorem nff1 {x3: setvar} (A2 B2 F: class x3):
  $ wnfc x3 F $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnf x3 (wf1 A2 B2 F) $;

--| Alternate definition of a one-to-one function. (Contributed by NM, 31-Dec-1996.)
theorem dff12 {x3 y1: setvar} (A2 B2: class x3 y1) (F: class):
  $ wb (wf1 A2 B2 F) (wa (wf A2 B2 F) (wal y1 (wmo x3 (wbr (cv x3) (cv y1) F)))) $;

--| A one-to-one mapping is a mapping. (Contributed by NM, 31-Dec-1996.)
theorem f1f (A2 B2 F: class):
  $ wi (wf1 A2 B2 F) (wf A2 B2 F) $;

--| A one-to-one mapping is a function on its domain. (Contributed by NM, 8-Mar-2014.)
theorem f1fn (A2 B2 F: class):
  $ wi (wf1 A2 B2 F) (wfn F A2) $;

--| A one-to-one mapping is a function. (Contributed by NM, 8-Mar-2014.) (Proof shortened by Umit Teoman Dogan, 10-Jun-2026.)
theorem f1fun (A2 B2 F: class):
  $ wi (wf1 A2 B2 F) (wfun F) $;

--| Obsolete version of ~ f1fun as of 10-Jun-2026. (Contributed by NM, 8-Mar-2014.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem f1funOLD (A2 B2 F: class):
  $ wi (wf1 A2 B2 F) (wfun F) $;

--| A one-to-one onto mapping is a relation. (Contributed by NM, 8-Mar-2014.) (Proof shortened by Umit Teoman Dogan, 10-Jun-2026.)
theorem f1rel (A2 B2 F: class):
  $ wi (wf1 A2 B2 F) (wrel F) $;

--| Obsolete version of ~ f1rel as of 10-Jun-2026. (Contributed by NM, 8-Mar-2014.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem f1relOLD (A2 B2 F: class):
  $ wi (wf1 A2 B2 F) (wrel F) $;

--| The domain of a one-to-one mapping. (Contributed by NM, 8-Mar-2014.) (Proof shortened by Wolf Lammen, 29-May-2024.)
theorem f1dm (A2 B2 F: class):
  $ wi (wf1 A2 B2 F) (wceq (cdm F) A2) $;

--| A function that is one-to-one is also one-to-one on some superset of its codomain. (Contributed by Mario Carneiro, 12-Jan-2013.)
theorem f1ss (A2 B2 C F: class):
  $ wi (wa (wf1 A2 B2 F) (wss B2 C)) (wf1 A2 C F) $;

--| A function that is one-to-one is also one-to-one on some superset of its range. (Contributed by Stefan O'Rear, 20-Feb-2015.)
theorem f1ssr (A2 B2 C F: class):
  $ wi (wa (wf1 A2 B2 F) (wss (crn F) C)) (wf1 A2 C F) $;

--| A function that is one-to-one is also one-to-one on any subclass of its domain. (Contributed by Mario Carneiro, 17-Jan-2015.)
theorem f1ssres (A2 B2 C F: class):
  $ wi (wa (wf1 A2 B2 F) (wss C A2)) (wf1 C B2 (cres F C)) $;

--| The restriction of an injective function is injective. (Contributed by AV, 28-Jun-2022.)
theorem f1resf1 (A2 B2 C D F: class):
  $ wi (w3a (wf1 A2 B2 F) (wss C A2) (wf C D (cres F C))) (wf1 C D (cres F C)) $;

--| Two ways to express that a set ` A ` (not necessarily a function) is one-to-one. Each side is equivalent to Definition 6.4(3) of [TakeutiZaring] p. 24, who use the notation "Un_2 (A)" for one-to-one. We do not introduce a separate notation since we rarely use it. (Contributed by NM, 13-Aug-2004.)
theorem f1cnvcnv (A2: class):
  $ wb (wf1 (cdm A2) cvv (ccnv (ccnv A2))) (wa (wfun (ccnv A2)) (wfun (ccnv (ccnv A2)))) $;

--| Composition of two one-to-one functions. Generalization of ~ f1co . (Contributed by AV, 18-Sep-2024.)
theorem f1cof1 (A2 B2 C D F G: class):
  $ wi (wa (wf1 C D F) (wf1 A2 B2 G)) (wf1 (cima (ccnv G) C) D (ccom F G)) $;

--| Composition of one-to-one functions when the codomain of the first matches the domain of the second. Exercise 30 of [TakeutiZaring] p. 25. (Contributed by NM, 28-May-1998.) (Proof shortened by AV, 20-Sep-2024.)
theorem f1co (A2 B2 C F G: class):
  $ wi (wa (wf1 B2 C F) (wf1 A2 B2 G)) (wf1 A2 C (ccom F G)) $;

--| Equality theorem for onto functions. (Contributed by NM, 1-Aug-1994.)
theorem foeq1 (A2 B2 F G: class):
  $ wi (wceq F G) (wb (wfo A2 B2 F) (wfo A2 B2 G)) $;

--| Equality theorem for onto functions. (Contributed by NM, 1-Aug-1994.)
theorem foeq2 (A2 B2 C F: class):
  $ wi (wceq A2 B2) (wb (wfo A2 C F) (wfo B2 C F)) $;

--| Equality theorem for onto functions. (Contributed by NM, 1-Aug-1994.)
theorem foeq3 (A2 B2 C F: class):
  $ wi (wceq A2 B2) (wb (wfo C A2 F) (wfo C B2 F)) $;

--| Bound-variable hypothesis builder for an onto function. (Contributed by NM, 16-May-2004.)
theorem nffo {x3: setvar} (A2 B2 F: class x3):
  $ wnfc x3 F $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnf x3 (wfo A2 B2 F) $;

--| An onto mapping is a mapping. (Contributed by NM, 3-Aug-1994.)
theorem fof (A2 B2 F: class):
  $ wi (wfo A2 B2 F) (wf A2 B2 F) $;

--| An onto mapping is a function. (Contributed by NM, 29-Mar-2008.)
theorem fofun (A2 B2 F: class):
  $ wi (wfo A2 B2 F) (wfun F) $;

--| An onto mapping is a function on its domain. (Contributed by NM, 16-Dec-2008.)
theorem fofn (A2 B2 F: class):
  $ wi (wfo A2 B2 F) (wfn F A2) $;

--| The codomain of an onto function is its range. (Contributed by NM, 3-Aug-1994.)
theorem forn (A2 B2 F: class):
  $ wi (wfo A2 B2 F) (wceq (crn F) B2) $;

--| Alternate definition of an onto function. (Contributed by NM, 22-Mar-2006.)
theorem dffo2 (A2 B2 F: class):
  $ wb (wfo A2 B2 F) (wa (wf A2 B2 F) (wceq (crn F) B2)) $;

--| The image of the domain of an onto function. (Contributed by NM, 29-Nov-2002.)
theorem foima (A2 B2 F: class):
  $ wi (wfo A2 B2 F) (wceq (cima F A2) B2) $;

--| A function maps onto its range. (Contributed by NM, 10-May-1998.)
theorem dffn4 (A2 F: class):
  $ wb (wfn F A2) (wfo A2 (crn F) F) $;

--| A function maps its domain onto its range. (Contributed by NM, 23-Jul-2004.)
theorem funforn (A2: class):
  $ wb (wfun A2) (wfo (cdm A2) (crn A2) A2) $;

--| An onto function has unique domain and range. (Contributed by NM, 5-Nov-2006.)
theorem fodmrnu (A2 B2 C D F: class):
  $ wi (wa (wfo A2 B2 F) (wfo C D F)) (wa (wceq A2 C) (wceq B2 D)) $;

--| A function is a function onto the image of its domain. (Contributed by AV, 1-Dec-2022.)
theorem fimadmfo (A2 B2 F: class):
  $ wi (wf A2 B2 F) (wfo A2 (cima F A2) F) $;

--| Restriction of an onto function. (Contributed by NM, 4-Mar-1997.)
theorem fores (A2 F: class):
  $ wi (wa (wfun F) (wss A2 (cdm F))) (wfo A2 (cima F A2) (cres F A2)) $;

--| Alternate proof of ~ fimadmfo , based on ~ fores . A function is a function onto the image of its domain. (Contributed by AV, 1-Dec-2022.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem fimadmfoALT (A2 B2 F: class):
  $ wi (wf A2 B2 F) (wfo A2 (cima F A2) F) $;

--| The preimage of the codomain of a surjection is its domain. (Contributed by AV, 29-Sep-2024.)
theorem focnvimacdmdm (A2 B2 G: class):
  $ wi (wfo A2 B2 G) (wceq (cima (ccnv G) B2) A2) $;

--| Composition of onto functions. Generalisation of ~ foco . (Contributed by AV, 29-Sep-2024.)
theorem focofo (A2 B2 F G: class):
  $ wi (w3a (wfo A2 B2 F) (wfun G) (wss A2 (crn G))) (wfo (cima (ccnv G) A2) B2 (ccom F G)) $;

--| Composition of onto functions. (Contributed by NM, 22-Mar-2006.) (Proof shortened by AV, 29-Sep-2024.)
theorem foco (A2 B2 C F G: class):
  $ wi (wa (wfo B2 C F) (wfo A2 B2 G)) (wfo A2 C (ccom F G)) $;

--| A nonzero constant function is onto. (Contributed by NM, 12-Jan-2007.)
theorem foconst (A2 B2 F: class):
  $ wi (wa (wf A2 (csn B2) F) (wne F c0)) (wfo A2 (csn B2) F) $;

--| Equality theorem for one-to-one onto functions. (Contributed by NM, 10-Feb-1997.)
theorem f1oeq1 (A2 B2 F G: class):
  $ wi (wceq F G) (wb (wf1o A2 B2 F) (wf1o A2 B2 G)) $;

--| Equality theorem for one-to-one onto functions. (Contributed by NM, 10-Feb-1997.)
theorem f1oeq2 (A2 B2 C F: class):
  $ wi (wceq A2 B2) (wb (wf1o A2 C F) (wf1o B2 C F)) $;

--| Equality theorem for one-to-one onto functions. (Contributed by NM, 10-Feb-1997.)
theorem f1oeq3 (A2 B2 C F: class):
  $ wi (wceq A2 B2) (wb (wf1o C A2 F) (wf1o C B2 F)) $;

--| Equality theorem for one-to-one onto functions. (Contributed by FL, 14-Jul-2012.)
theorem f1oeq23 (A2 B2 C D F: class):
  $ wi (wa (wceq A2 B2) (wceq C D)) (wb (wf1o A2 C F) (wf1o B2 D F)) $;

--| Equality deduction for one-to-one functions. (Contributed by Mario Carneiro, 27-Jan-2017.)
theorem f1eq123d (ph: wff) (A2 B2 C D F G: class):
  $ wi ph (wceq F G) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wb (wf1 A2 C F) (wf1 B2 D G)) $;

--| Equality deduction for onto functions. (Contributed by Mario Carneiro, 27-Jan-2017.)
theorem foeq123d (ph: wff) (A2 B2 C D F G: class):
  $ wi ph (wceq F G) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wb (wfo A2 C F) (wfo B2 D G)) $;

--| Equality deduction for one-to-one onto functions. (Contributed by Mario Carneiro, 27-Jan-2017.)
theorem f1oeq123d (ph: wff) (A2 B2 C D F G: class):
  $ wi ph (wceq F G) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wb (wf1o A2 C F) (wf1o B2 D G)) $;

--| Equality deduction for one-to-one onto functions. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem f1oeq1d (ph: wff) (A2 B2 F G: class):
  $ wi ph (wceq F G) $ >
  $ wi ph (wb (wf1o A2 B2 F) (wf1o A2 B2 G)) $;

--| Equality deduction for one-to-one onto functions. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem f1oeq2d (ph: wff) (A2 B2 C F: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wf1o A2 C F) (wf1o B2 C F)) $;

--| Equality deduction for one-to-one onto functions. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem f1oeq3d (ph: wff) (A2 B2 C F: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wf1o C A2 F) (wf1o C B2 F)) $;

--| Bound-variable hypothesis builder for a one-to-one onto function. (Contributed by NM, 16-May-2004.)
theorem nff1o {x3: setvar} (A2 B2 F: class x3):
  $ wnfc x3 F $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnf x3 (wf1o A2 B2 F) $;

--| A one-to-one onto mapping is a one-to-one mapping. (Contributed by NM, 12-Dec-2003.)
theorem f1of1 (A2 B2 F: class):
  $ wi (wf1o A2 B2 F) (wf1 A2 B2 F) $;

--| A one-to-one onto mapping is a mapping. (Contributed by NM, 12-Dec-2003.)
theorem f1of (A2 B2 F: class):
  $ wi (wf1o A2 B2 F) (wf A2 B2 F) $;

--| A one-to-one onto mapping is function on its domain. (Contributed by NM, 12-Dec-2003.)
theorem f1ofn (A2 B2 F: class):
  $ wi (wf1o A2 B2 F) (wfn F A2) $;

--| A one-to-one onto mapping is a function. (Contributed by NM, 12-Dec-2003.)
theorem f1ofun (A2 B2 F: class):
  $ wi (wf1o A2 B2 F) (wfun F) $;

--| A one-to-one onto mapping is a relation. (Contributed by NM, 13-Dec-2003.)
theorem f1orel (A2 B2 F: class):
  $ wi (wf1o A2 B2 F) (wrel F) $;

--| The domain of a one-to-one onto mapping. (Contributed by NM, 8-Mar-2014.) (Proof shortened by Umit Teoman Dogan, 10-Jun-2026.)
theorem f1odm (A2 B2 F: class):
  $ wi (wf1o A2 B2 F) (wceq (cdm F) A2) $;

--| Obsolete version of ~ f1odm as of 10-Jun-2026. (Contributed by NM, 8-Mar-2014.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem f1odmOLD (A2 B2 F: class):
  $ wi (wf1o A2 B2 F) (wceq (cdm F) A2) $;

--| Alternate definition of one-to-one onto function. (Contributed by NM, 10-Feb-1997.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem dff1o2 (A2 B2 F: class):
  $ wb (wf1o A2 B2 F) (w3a (wfn F A2) (wfun (ccnv F)) (wceq (crn F) B2)) $;

--| Alternate definition of one-to-one onto function. (Contributed by NM, 25-Mar-1998.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem dff1o3 (A2 B2 F: class):
  $ wb (wf1o A2 B2 F) (wa (wfo A2 B2 F) (wfun (ccnv F))) $;

--| A one-to-one onto function is an onto function. (Contributed by NM, 28-Apr-2004.)
theorem f1ofo (A2 B2 F: class):
  $ wi (wf1o A2 B2 F) (wfo A2 B2 F) $;

--| Alternate definition of one-to-one onto function. (Contributed by NM, 25-Mar-1998.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem dff1o4 (A2 B2 F: class):
  $ wb (wf1o A2 B2 F) (wa (wfn F A2) (wfn (ccnv F) B2)) $;

--| Alternate definition of one-to-one onto function. (Contributed by NM, 10-Dec-2003.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem dff1o5 (A2 B2 F: class):
  $ wb (wf1o A2 B2 F) (wa (wf1 A2 B2 F) (wceq (crn F) B2)) $;

--| A one-to-one function maps onto its range. (Contributed by NM, 13-Aug-2004.)
theorem f1orn (A2 F: class):
  $ wb (wf1o A2 (crn F) F) (wa (wfn F A2) (wfun (ccnv F))) $;

--| A one-to-one function maps one-to-one onto its range. (Contributed by NM, 4-Sep-2004.)
theorem f1f1orn (A2 B2 F: class):
  $ wi (wf1 A2 B2 F) (wf1o A2 (crn F) F) $;

--| The converse of a one-to-one onto function is also one-to-one onto. (Contributed by NM, 11-Feb-1997.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem f1ocnv (A2 B2 F: class):
  $ wi (wf1o A2 B2 F) (wf1o B2 A2 (ccnv F)) $;

--| A relation is a one-to-one onto function iff its converse is a one-to-one onto function with domain and codomain/range interchanged. (Contributed by NM, 8-Dec-2003.)
theorem f1ocnvb (A2 B2 F: class):
  $ wi (wrel F) (wb (wf1o A2 B2 F) (wf1o B2 A2 (ccnv F))) $;

--| The restriction of a one-to-one function maps one-to-one onto the image. (Contributed by NM, 25-Mar-1998.)
theorem f1ores (A2 B2 C F: class):
  $ wi (wa (wf1 A2 B2 F) (wss C A2)) (wf1o C (cima F C) (cres F C)) $;

--| The converse of a one-to-one-onto restricted function. (Contributed by Paul Chapman, 21-Apr-2008.)
theorem f1orescnv (P R F: class):
  $ wi (wa (wfun (ccnv F)) (wf1o R P (cres F R))) (wf1o P R (cres (ccnv F) P)) $;

--| Preimage of an image. (Contributed by NM, 30-Sep-2004.)
theorem f1imacnv (A2 B2 C F: class):
  $ wi (wa (wf1 A2 B2 F) (wss C A2)) (wceq (cima (ccnv F) (cima F C)) C) $;

--| A reverse version of ~ f1imacnv . (Contributed by Jeff Hankins, 16-Jul-2009.)
theorem foimacnv (A2 B2 C F: class):
  $ wi (wa (wfo A2 B2 F) (wss C B2)) (wceq (cima F (cima (ccnv F) C)) C) $;

--| The union of two onto functions with disjoint domains is an onto function. (Contributed by Mario Carneiro, 22-Jun-2016.)
theorem foun (A2 B2 C D F G: class):
  $ wi (wa (wa (wfo A2 B2 F) (wfo C D G)) (wceq (cin A2 C) c0)) (wfo (cun A2 C) (cun B2 D) (cun F G)) $;

--| The union of two one-to-one onto functions with disjoint domains and ranges. (Contributed by NM, 26-Mar-1998.)
theorem f1oun (A2 B2 C D F G: class):
  $ wi (wa (wa (wf1o A2 B2 F) (wf1o C D G)) (wa (wceq (cin A2 C) c0) (wceq (cin B2 D) c0))) (wf1o (cun A2 C) (cun B2 D) (cun F G)) $;

--| The union of two one-to-one functions with disjoint domains and codomains. (Contributed by BTernaryTau, 3-Dec-2024.)
theorem f1un (A2 B2 C D F G: class):
  $ wi (wa (wa (wf1 A2 B2 F) (wf1 C D G)) (wa (wceq (cin A2 C) c0) (wceq (cin B2 D) c0))) (wf1 (cun A2 C) (cun B2 D) (cun F G)) $;

--| The restriction of a one-to-one onto function to a difference maps onto the difference of the images. (Contributed by Paul Chapman, 11-Apr-2009.)
theorem resdif (A2 B2 C D F: class):
  $ wi (w3a (wfun (ccnv F)) (wfo A2 C (cres F A2)) (wfo B2 D (cres F B2))) (wf1o (cdif A2 B2) (cdif C D) (cres F (cdif A2 B2))) $;

--| The restriction of a one-to-one onto function to an intersection maps onto the intersection of the images. (Contributed by Paul Chapman, 11-Apr-2009.)
theorem resin (A2 B2 C D F: class):
  $ wi (w3a (wfun (ccnv F)) (wfo A2 C (cres F A2)) (wfo B2 D (cres F B2))) (wf1o (cin A2 B2) (cin C D) (cres F (cin A2 B2))) $;

--| Composition of one-to-one onto functions. (Contributed by NM, 19-Mar-1998.)
theorem f1oco (A2 B2 C F G: class):
  $ wi (wa (wf1o B2 C F) (wf1o A2 B2 G)) (wf1o A2 C (ccom F G)) $;

--| The converse of an injective function is bijective. (Contributed by FL, 11-Nov-2011.)
theorem f1cnv (A2 B2 F: class):
  $ wi (wf1 A2 B2 F) (wf1o (crn F) A2 (ccnv F)) $;

--| Composition with the converse. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem funcocnv2 (F: class):
  $ wi (wfun F) (wceq (ccom F (ccnv F)) (cres cid (crn F))) $;

--| The composition of an onto function and its converse. (Contributed by Stefan O'Rear, 12-Feb-2015.)
theorem fococnv2 (A2 B2 F: class):
  $ wi (wfo A2 B2 F) (wceq (ccom F (ccnv F)) (cres cid B2)) $;

--| The composition of a one-to-one onto function and its converse equals the identity relation restricted to the function's range. (Contributed by NM, 13-Dec-2003.) (Proof shortened by Stefan O'Rear, 12-Feb-2015.)
theorem f1ococnv2 (A2 B2 F: class):
  $ wi (wf1o A2 B2 F) (wceq (ccom F (ccnv F)) (cres cid B2)) $;

--| Composition of an injective function with its converse. (Contributed by FL, 11-Nov-2011.)
theorem f1cocnv2 (A2 B2 F: class):
  $ wi (wf1 A2 B2 F) (wceq (ccom F (ccnv F)) (cres cid (crn F))) $;

--| The composition of a one-to-one onto function's converse and itself equals the identity relation restricted to the function's domain. (Contributed by NM, 13-Dec-2003.)
theorem f1ococnv1 (A2 B2 F: class):
  $ wi (wf1o A2 B2 F) (wceq (ccom (ccnv F) F) (cres cid A2)) $;

--| Composition of an injective function with its converse. (Contributed by FL, 11-Nov-2011.)
theorem f1cocnv1 (A2 B2 F: class):
  $ wi (wf1 A2 B2 F) (wceq (ccom (ccnv F) F) (cres cid A2)) $;

--| Express a constraint on a composition as a constraint on the composand. (Contributed by Stefan O'Rear, 7-Mar-2015.)
theorem funcoeqres (F G H: class):
  $ wi (wa (wfun G) (wceq (ccom F G) H)) (wceq (cres F (crn G)) (ccom H (ccnv G))) $;

--| A subset of an injective function is injective. (Contributed by AV, 20-Nov-2020.)
theorem f1ssf1 (F G: class):
  $ wi (w3a (wfun F) (wfun (ccnv F)) (wss G F)) (wfun (ccnv G)) $;

--| The empty set maps one-to-one into any class. (Contributed by NM, 7-Apr-1998.)
theorem f10 (A2: class):
  $ wf1 c0 A2 c0 $;

--| The empty set maps one-to-one into any class, deduction version. (Contributed by AV, 25-Nov-2020.)
theorem f10d (ph: wff) (A2 F: class):
  $ wi ph (wceq F c0) $ >
  $ wi ph (wf1 (cdm F) A2 F) $;

--| One-to-one onto mapping of the empty set. (Contributed by NM, 15-Apr-1998.)
theorem f1o00 (A2 F: class):
  $ wb (wf1o c0 A2 F) (wa (wceq F c0) (wceq A2 c0)) $;

--| Onto mapping of the empty set. (Contributed by NM, 22-Mar-2006.)
theorem fo00 (A2 F: class):
  $ wb (wfo c0 A2 F) (wa (wceq F c0) (wceq A2 c0)) $;

--| One-to-one onto mapping of the empty set. (Contributed by NM, 10-Sep-2004.)
theorem f1o0:
  $ wf1o c0 c0 c0 $;

--| A restriction of the identity relation is a one-to-one onto function. (Contributed by NM, 30-Apr-1998.) (Proof shortened by Andrew Salmon, 22-Oct-2011.) Avoid ~ ax-12 . (Revised by TM, 10-Feb-2026.)
theorem f1oi (A2: class):
  $ wf1o A2 A2 (cres cid A2) $;

--| Obsolete version of ~ f1oi as of 10-Feb-2026. (Contributed by NM, 30-Apr-1998.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem f1oiOLD (A2: class):
  $ wf1o A2 A2 (cres cid A2) $;

--| The identity relation is a one-to-one onto function on the universe. (Contributed by NM, 16-May-2004.)
theorem f1ovi:
  $ wf1o cvv cvv cid $;

--| A singleton of an ordered pair is one-to-one onto function. (Contributed by NM, 18-May-1998.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem f1osn (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wf1o (csn A2) (csn B2) (csn (cop A2 B2)) $;

--| A singleton of an ordered pair is one-to-one onto function. (Contributed by Mario Carneiro, 12-Jan-2013.)
theorem f1osng (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wf1o (csn A2) (csn B2) (csn (cop A2 B2))) $;

--| A singleton of an ordered pair is a one-to-one function. (Contributed by AV, 17-Apr-2021.)
theorem f1sng (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wf1 (csn A2) W (csn (cop A2 B2))) $;

--| A singleton of an ordered pair is a function. (Contributed by AV, 17-Apr-2021.)
theorem fsnd (ph: wff) (A2 B2 V W: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wf (csn A2) W (csn (cop A2 B2))) $;

--| A two-element swap is a bijection on a pair. (Contributed by Mario Carneiro, 23-Jan-2015.)
theorem f1oprswap (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wf1o (cpr A2 B2) (cpr A2 B2) (cpr (cop A2 B2) (cop B2 A2))) $;

--| An unordered pair of ordered pairs with different elements is a one-to-one onto function, analogous to ~ f1oprswap . (Contributed by Alexander van der Vekens, 14-Aug-2017.)
theorem f1oprg (A2 B2 C D V W X Y: class):
  $ wi (wa (wa (wcel A2 V) (wcel B2 W)) (wa (wcel C X) (wcel D Y))) (wi (wa (wne A2 C) (wne B2 D)) (wf1o (cpr A2 C) (cpr B2 D) (cpr (cop A2 B2) (cop C D)))) $;

--| Function value when ` F ` is not a function. Theorem 6.12(2) of [TakeutiZaring] p. 27. (Contributed by NM, 30-Apr-2004.) (Proof shortened by Mario Carneiro, 31-Aug-2015.) Avoid ~ ax-10 , ~ ax-11 , ~ ax-12 . (Revised by TM, 25-Jan-2026.)
theorem tz6_12_2 {x3: setvar} (A2 F: class):
  $ wi (wn (weu x3 (wbr A2 (cv x3) F))) (wceq (cfv A2 F) c0) $;

--| Obsolete version of ~ tz6.12-2 as of 25-Jan-2026. (Contributed by NM, 30-Apr-2004.) (Proof shortened by Mario Carneiro, 31-Aug-2015.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem tz6_12_2OLD {x3: setvar} (A2 F: class):
  $ wi (wn (weu x3 (wbr A2 (cv x3) F))) (wceq (cfv A2 F) c0) $;

--| The value of a function at a unique point. (Contributed by Scott Fenton, 6-Oct-2017.)
theorem fveu {x3: setvar} (A2 F: class):
  $ wi (weu x3 (wbr A2 (cv x3) F)) (wceq (cfv A2 F) (cuni (cab x3 (wbr A2 (cv x3) F)))) $;

--| If ` A ` is a proper class and ` F ` is any class, then there is no unique set which is related to ` A ` through the binary relation ` F ` . See ~ brprcneuALT for a proof that uses ~ ax-pow instead of ~ ax-pr . (Contributed by Scott Fenton, 7-Oct-2017.)
theorem brprcneu {x3: setvar} (A2 F: class):
  $ wi (wn (wcel A2 cvv)) (wn (weu x3 (wbr A2 (cv x3) F))) $;

--| Alternate proof of ~ brprcneu using ~ ax-pow instead of ~ ax-pr . (Contributed by Scott Fenton, 7-Oct-2017.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem brprcneuALT {x3: setvar} (A2 F: class):
  $ wi (wn (wcel A2 cvv)) (wn (weu x3 (wbr A2 (cv x3) F))) $;

--| A function's value at a proper class is the empty set. See ~ fvprcALT for a proof that uses ~ ax-pow instead of ~ ax-pr . (Contributed by NM, 20-May-1998.) Avoid ~ ax-pow . (Revised by BTernaryTau, 3-Aug-2024.) (Proof shortened by BTernaryTau, 3-Dec-2024.)
theorem fvprc (A2 F: class):
  $ wi (wn (wcel A2 cvv)) (wceq (cfv A2 F) c0) $;

--| Alternate proof of ~ fvprc using ~ ax-pow instead of ~ ax-pr . (Contributed by NM, 20-May-1998.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem fvprcALT (A2 F: class):
  $ wi (wn (wcel A2 cvv)) (wceq (cfv A2 F) c0) $;

--| The range of a function value at a proper class is empty. (Contributed by AV, 20-Aug-2022.)
theorem rnfvprc (F X Y: class):
  $ wceq Y (cfv X F) $ >
  $ wi (wn (wcel X cvv)) (wceq (crn Y) c0) $;

--| Alternate definition of function value. Definition 10.11 of [Quine] p. 68. (Contributed by NM, 30-Apr-2004.) (Proof shortened by Andrew Salmon, 17-Sep-2011.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem fv2 {x3 y1: setvar} (A2 F: class):
  $ wceq (cfv A2 F) (cuni (cab x3 (wal y1 (wb (wbr A2 (cv y1) F) (wceq (cv y1) (cv x3)))))) $;

--| A definition of function value in terms of iota. (Contributed by Scott Fenton, 19-Feb-2013.)
theorem dffv3 {x3: setvar} (A2 F: class):
  $ wceq (cfv A2 F) (cio x3 (wcel (cv x3) (cima F (csn A2)))) $;

--| The previous definition of function value, from before the ` iota ` operator was introduced. Although based on the idea embodied by Definition 10.2 of [Quine] p. 65 (see ~ args ), this definition apparently does not appear in the literature. (Contributed by NM, 1-Aug-1994.)
theorem dffv4 {x3: setvar} (A2 F: class):
  $ wceq (cfv A2 F) (cuni (cab x3 (wceq (cima F (csn A2)) (csn (cv x3))))) $;

--| Membership in a function value. (Contributed by NM, 30-Apr-2004.)
theorem elfv {x3 y1: setvar} (A2: class y1) (B2 F: class):
  $ wb (wcel A2 (cfv B2 F)) (wex x3 (wa (wcel A2 (cv x3)) (wal y1 (wb (wbr B2 (cv y1) F) (wceq (cv y1) (cv x3)))))) $;

--| Equality theorem for function value. (Contributed by NM, 29-Dec-1996.)
theorem fveq1 (A2 F G: class):
  $ wi (wceq F G) (wceq (cfv A2 F) (cfv A2 G)) $;

--| Equality theorem for function value. (Contributed by NM, 29-Dec-1996.)
theorem fveq2 (A2 B2 F: class):
  $ wi (wceq A2 B2) (wceq (cfv A2 F) (cfv B2 F)) $;

--| Equality inference for function value. (Contributed by NM, 2-Sep-2003.)
theorem fveq1i (A2 F G: class):
  $ wceq F G $ >
  $ wceq (cfv A2 F) (cfv A2 G) $;

--| Equality deduction for function value. (Contributed by NM, 2-Sep-2003.)
theorem fveq1d (ph: wff) (A2 F G: class):
  $ wi ph (wceq F G) $ >
  $ wi ph (wceq (cfv A2 F) (cfv A2 G)) $;

--| Equality inference for function value. (Contributed by NM, 28-Jul-1999.)
theorem fveq2i (A2 B2 F: class):
  $ wceq A2 B2 $ >
  $ wceq (cfv A2 F) (cfv B2 F) $;

--| Equality deduction for function value. (Contributed by NM, 29-May-1999.)
theorem fveq2d (ph: wff) (A2 B2 F: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cfv A2 F) (cfv B2 F)) $;

--| Equality theorem for nested function values. (Contributed by AV, 14-Aug-2022.)
theorem _2fveq3 (A2 B2 F G: class):
  $ wi (wceq A2 B2) (wceq (cfv (cfv A2 G) F) (cfv (cfv B2 G) F)) $;

--| Equality deduction for function value. (Contributed by FL, 27-Jun-2014.)
theorem fveq12i (A2 B2 F G: class):
  $ wceq F G $ >
  $ wceq A2 B2 $ >
  $ wceq (cfv A2 F) (cfv B2 G) $;

--| Equality deduction for function value. (Contributed by FL, 22-Dec-2008.)
theorem fveq12d (ph: wff) (A2 B2 F G: class):
  $ wi ph (wceq F G) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cfv A2 F) (cfv B2 G)) $;

--| Equality deduction for function value. (Contributed by BJ, 30-Aug-2022.)
theorem fveqeq2d (ph: wff) (A2 B2 C F: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb (wceq (cfv A2 F) C) (wceq (cfv B2 F) C)) $;

--| Equality deduction for function value. (Contributed by BJ, 31-Aug-2022.)
theorem fveqeq2 (A2 B2 C F: class):
  $ wi (wceq A2 B2) (wb (wceq (cfv A2 F) C) (wceq (cfv B2 F) C)) $;

--| Bound-variable hypothesis builder for function value. (Contributed by NM, 14-Nov-1995.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem nffv {x3: setvar} (A2 F: class x3):
  $ wnfc x3 F $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 (cfv A2 F) $;

--| Bound-variable hypothesis builder for mapping, special case. (Contributed by Mario Carneiro, 25-Dec-2016.)
theorem nffvmpt1 {x3: setvar} (A2 B2: class x3) (C: class):
  $ wnfc x3 (cfv C (cmpt x3 A2 B2)) $;

--| Deduction version of bound-variable hypothesis builder ~ nffv . (Contributed by NM, 10-Nov-2005.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem nffvd {x3: setvar} (ph: wff x3) (A2 F: class x3):
  $ wi ph (wnfc x3 F) $ >
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 (cfv A2 F)) $;

--| The value of a class exists. Corollary 6.13 of [TakeutiZaring] p. 27. (Contributed by NM, 30-Dec-1996.)
theorem fvex (A2 F: class):
  $ wcel (cfv A2 F) cvv $;

--| The value of a class exists. Inference form of ~ fvex . (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem fvexi (A2 B2 F: class):
  $ wceq A2 (cfv B2 F) $ >
  $ wcel A2 cvv $;

--| The value of a class exists (as consequent of anything). (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem fvexd (ph: wff) (A2 F: class):
  $ wi ph (wcel (cfv A2 F) cvv) $;

--| Move a conditional outside of a function. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem fvif (ph: wff) (A2 B2 F: class):
  $ wceq (cfv (cif ph A2 B2) F) (cif ph (cfv A2 F) (cfv B2 F)) $;

--| Move a conditional outside of a function. (Contributed by Thierry Arnoux, 28-Sep-2018.)
theorem iffv (ph: wff) (A2 F G: class):
  $ wceq (cfv A2 (cif ph F G)) (cif ph (cfv A2 F) (cfv A2 G)) $;

--| Alternate definition of the value of a function. Definition 6.11 of [TakeutiZaring] p. 26. (Contributed by NM, 30-Apr-2004.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem fv3 {x3 y1: setvar} (A2 F: class):
  $ wceq (cfv A2 F) (cab x3 (wa (wex y1 (wa (wcel (cv x3) (cv y1)) (wbr A2 (cv y1) F))) (weu y1 (wbr A2 (cv y1) F)))) $;

--| The value of a restricted function. (Contributed by NM, 2-Aug-1994.)
theorem fvres (A2 B2 F: class):
  $ wi (wcel A2 B2) (wceq (cfv A2 (cres F B2)) (cfv A2 F)) $;

--| The value of a restricted function, deduction version of ~ fvres . (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem fvresd (ph: wff) (A2 B2 F: class):
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wceq (cfv A2 (cres F B2)) (cfv A2 F)) $;

--| The value of a member of the domain of a subclass of a function. (Contributed by NM, 15-Aug-1994.)
theorem funssfv (A2 F G: class):
  $ wi (w3a (wfun F) (wss G F) (wcel A2 (cdm G))) (wceq (cfv A2 F) (cfv A2 G)) $;

--| Corollary of Theorem 6.12(1) of [TakeutiZaring] p. 27. (Contributed by NM, 30-Apr-2004.) (Proof shortened by SN, 23-Dec-2024.)
theorem tz6_12c {y1: setvar} (A2 F: class):
  $ wi (weu y1 (wbr A2 (cv y1) F)) (wb (wceq (cfv A2 F) (cv y1)) (wbr A2 (cv y1) F)) $;

--| Function value. Theorem 6.12(1) of [TakeutiZaring] p. 27. (Contributed by NM, 30-Apr-2004.) (Proof shortened by SN, 23-Dec-2024.)
theorem tz6_12_1 {y1: setvar} (A2 F: class):
  $ wi (wa (wbr A2 (cv y1) F) (weu y1 (wbr A2 (cv y1) F))) (wceq (cfv A2 F) (cv y1)) $;

--| Function value. Theorem 6.12(1) of [TakeutiZaring] p. 27. (Contributed by NM, 10-Jul-1994.)
theorem tz6_12 {y1: setvar} (A2 F: class):
  $ wi (wa (wcel (cop A2 (cv y1)) F) (weu y1 (wcel (cop A2 (cv y1)) F))) (wceq (cfv A2 F) (cv y1)) $;

--| Function value, using bound-variable hypotheses instead of distinct variable conditions. (Contributed by NM, 30-Aug-1999.)
theorem tz6_12f {y1: setvar} (A2: class) (F: class y1):
  $ wnfc y1 F $ >
  $ wi (wa (wcel (cop A2 (cv y1)) F) (weu y1 (wcel (cop A2 (cv y1)) F))) (wceq (cfv A2 F) (cv y1)) $;

--| Corollary of Theorem 6.12(2) of [TakeutiZaring] p. 27. (Contributed by Mario Carneiro, 17-Nov-2014.)
theorem tz6_12i (A2 B2 F: class):
  $ wi (wne B2 c0) (wi (wceq (cfv A2 F) B2) (wbr A2 B2 F)) $;

--| Two possibilities for the behavior of a function value. (Contributed by Stefan O'Rear, 2-Nov-2014.) (Proof shortened by Mario Carneiro, 31-Aug-2015.)
theorem fvbr0 (F X: class):
  $ wo (wbr X (cfv X F) F) (wceq (cfv X F) c0) $;

--| A function value is a member of the range plus null. (Contributed by Scott Fenton, 8-Jun-2011.) (Revised by Stefan O'Rear, 3-Jan-2015.)
theorem fvrn0 (F X: class):
  $ wcel (cfv X F) (cun (crn F) (csn c0)) $;

--| If the value of a function is not null, the value is an element of the range of the function. (Contributed by Alexander van der Vekens, 22-Jul-2018.) (Proof shortened by SN, 13-Jan-2025.)
theorem fvn0fvelrn (F X: class):
  $ wi (wne (cfv X F) c0) (wcel (cfv X F) (crn F)) $;

--| A function value is a subset of the union of the range. (An artifact of our function value definition, compare ~ elfvdm ). (Contributed by Thierry Arnoux, 13-Nov-2016.) Remove functionhood antecedent. (Revised by SN, 10-Jan-2025.)
theorem elfvunirn (A2 B2 F: class):
  $ wi (wcel B2 (cfv A2 F)) (wcel B2 (cuni (crn F))) $;

--| The result of a function value is always a subset of the union of the range, even if it is invalid and thus empty. (Contributed by Stefan O'Rear, 2-Nov-2014.) (Revised by Mario Carneiro, 31-Aug-2015.) (Proof shortened by SN, 13-Jan-2025.)
theorem fvssunirn (F X: class):
  $ wss (cfv X F) (cuni (crn F)) $;

--| The value of a class outside its domain is the empty set. (An artifact of our function value definition.) (Contributed by NM, 24-Aug-1995.)
theorem ndmfv (A2 F: class):
  $ wi (wn (wcel A2 (cdm F))) (wceq (cfv A2 F) c0) $;

--| Reverse closure law for function with the empty set not in its domain (if ` R = S ` ). (Contributed by NM, 26-Apr-1996.) The class containing the function value does not have to be the domain. (Revised by Zhi Wang, 10-Nov-2025.)
theorem ndmfvrcl (A2 R S F: class):
  $ wceq (cdm F) S $ >
  $ wn (wcel c0 R) $ >
  $ wi (wcel (cfv A2 F) R) (wcel A2 S) $;

--| If a function value has a member, then the argument belongs to the domain. (An artifact of our function value definition.) (Contributed by NM, 12-Feb-2007.) (Proof shortened by BJ, 22-Oct-2022.)
theorem elfvdm (A2 B2 F: class):
  $ wi (wcel A2 (cfv B2 F)) (wcel B2 (cdm F)) $;

--| If a function value has a member, then the argument is a set. (An artifact of our function value definition.) (Contributed by Mario Carneiro, 6-Nov-2015.)
theorem elfvex (A2 B2 F: class):
  $ wi (wcel A2 (cfv B2 F)) (wcel B2 cvv) $;

--| If a function value has a member, then its argument is a set. Deduction form of ~ elfvex . (An artifact of our function value definition.) (Contributed by David Moews, 1-May-2017.)
theorem elfvexd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 (cfv C B2)) $ >
  $ wi ph (wcel C cvv) $;

--| A nonempty function value is an element of the image of the function. (Contributed by Thierry Arnoux, 25-Jun-2019.)
theorem eliman0 (A2 B2 F: class):
  $ wi (wa (wcel A2 B2) (wn (wceq (cfv A2 F) c0))) (wcel (cfv A2 F) (cima F B2)) $;

--| The value of a non-member of a restriction is the empty set. (An artifact of our function value definition.) (Contributed by NM, 13-Nov-1995.)
theorem nfvres (A2 B2 F: class):
  $ wi (wn (wcel A2 B2)) (wceq (cfv A2 (cres F B2)) c0) $;

--| If the restriction of a class to a singleton is not a function, then its value is the empty set. (An artifact of our function value definition.) (Contributed by NM, 8-Aug-2010.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem nfunsn (A2 F: class):
  $ wi (wn (wfun (cres F (csn A2)))) (wceq (cfv A2 F) c0) $;

--| If the "value of a class" at an argument is not the empty set, then the argument is in the domain of the class and the class restricted to the singleton formed on that argument is a function. (Contributed by Alexander van der Vekens, 26-May-2017.) (Proof shortened by BJ, 13-Aug-2022.)
theorem fvfundmfvn0 (A2 F: class):
  $ wi (wne (cfv A2 F) c0) (wa (wcel A2 (cdm F)) (wfun (cres F (csn A2)))) $;

--| Function value of the empty set. (Contributed by Stefan O'Rear, 26-Nov-2014.)
theorem _0fv (A2: class):
  $ wceq (cfv A2 c0) c0 $;

--| A function value of a function value at a proper class is the empty set. (Contributed by AV, 8-Apr-2021.)
theorem fv2prc (A2 B2 F: class):
  $ wi (wn (wcel A2 cvv)) (wceq (cfv B2 (cfv A2 F)) c0) $;

--| If a function value of a function value has a member, then the first argument is a set. (Contributed by AV, 8-Apr-2021.)
theorem elfv2ex (A2 B2 C F: class):
  $ wi (wcel A2 (cfv C (cfv B2 F))) (wcel B2 cvv) $;

--| Equal values imply equal values in a restriction. (Contributed by NM, 13-Nov-1995.)
theorem fveqres (A2 B2 F G: class):
  $ wi (wceq (cfv A2 F) (cfv A2 G)) (wceq (cfv A2 (cres F B2)) (cfv A2 (cres G B2))) $;

--| Move class substitution in and out of a function value. (Contributed by NM, 11-Nov-2005.) (Revised by NM, 20-Aug-2018.)
theorem csbfv12 {x3: setvar} (A2 B2 F: class x3):
  $ wceq (csb x3 A2 (cfv B2 F)) (cfv (csb x3 A2 B2) (csb x3 A2 F)) $;

--| Move class substitution in and out of a function value. (Contributed by NM, 10-Nov-2005.)
theorem csbfv2g {x3: setvar} (A2 B2 C: class x3) (F: class):
  $ wi (wcel A2 C) (wceq (csb x3 A2 (cfv B2 F)) (cfv (csb x3 A2 B2) F)) $;

--| Substitution for a function value. (Contributed by NM, 1-Jan-2006.) (Revised by NM, 20-Aug-2018.)
theorem csbfv {x3: setvar} (A2: class x3) (F: class):
  $ wceq (csb x3 A2 (cfv (cv x3) F)) (cfv A2 F) $;

--| The second argument of a binary relation on a function is the function's value. (Contributed by NM, 30-Apr-2004.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem funbrfv (A2 B2 F: class):
  $ wi (wfun F) (wi (wbr A2 B2 F) (wceq (cfv A2 F) B2)) $;

--| The second element in an ordered pair member of a function is the function's value. (Contributed by NM, 19-Jul-1996.)
theorem funopfv (A2 B2 F: class):
  $ wi (wfun F) (wi (wcel (cop A2 B2) F) (wceq (cfv A2 F) B2)) $;

--| Equivalence of function value and binary relation. (Contributed by NM, 19-Apr-2004.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem fnbrfvb (A2 B2 C F: class):
  $ wi (wa (wfn F A2) (wcel B2 A2)) (wb (wceq (cfv B2 F) C) (wbr B2 C F)) $;

--| Equivalence of function value and ordered pair membership. (Contributed by NM, 7-Nov-1995.)
theorem fnopfvb (A2 B2 C F: class):
  $ wi (wa (wfn F A2) (wcel B2 A2)) (wb (wceq (cfv B2 F) C) (wcel (cop B2 C) F)) $;

--| Function value in an image. (Contributed by Glauco Siliprandi, 2-Jan-2022.)
theorem fvelima2 {x3: setvar} (A2 B2 C F: class):
  $ wi (wa (wfn F A2) (wcel B2 (cima F C))) (wrex x3 (wceq (cfv (cv x3) F) B2) (cin A2 C)) $;

--| Equivalence of function value and binary relation. (Contributed by NM, 26-Mar-2006.)
theorem funbrfvb (A2 B2 F: class):
  $ wi (wa (wfun F) (wcel A2 (cdm F))) (wb (wceq (cfv A2 F) B2) (wbr A2 B2 F)) $;

--| Equivalence of function value and ordered pair membership. Theorem 4.3(ii) of [Monk1] p. 42. (Contributed by NM, 26-Jan-1997.)
theorem funopfvb (A2 B2 F: class):
  $ wi (wa (wfun F) (wcel A2 (cdm F))) (wb (wceq (cfv A2 F) B2) (wcel (cop A2 B2) F)) $;

--| Version of ~ fnbrfvb for functions on Cartesian products: function value expressed as a binary relation. See ~ fnbrovb for the form when ` F ` is seen as a binary operation. (Contributed by BJ, 15-Feb-2022.)
theorem fnbrfvb2 (A2 B2 C F V W: class):
  $ wi (wa (wfn F (cxp V W)) (wa (wcel A2 V) (wcel B2 W))) (wb (wceq (cfv (cop A2 B2) F) C) (wbr (cop A2 B2) C F)) $;

--| There is exactly one codomain element for each element of the domain of a function. (Contributed by AV, 20-Apr-2025.)
theorem fdmeu {y1: setvar} (A2 B2 F X: class):
  $ wi (wa (wf A2 B2 F) (wcel X A2)) (wreu y1 (wceq (cfv X F) (cv y1)) B2) $;

--| Function value in terms of a binary relation. (Contributed by Mario Carneiro, 19-Mar-2014.)
theorem funbrfv2b (A2 B2 F: class):
  $ wi (wfun F) (wb (wbr A2 B2 F) (wa (wcel A2 (cdm F)) (wceq (cfv A2 F) B2))) $;

--| Representation of a function in terms of its values. (Contributed by FL, 14-Sep-2013.) (Proof shortened by Mario Carneiro, 31-Aug-2015.)
theorem dffn5 {x3: setvar} (A2 F: class):
  $ wb (wfn F A2) (wceq F (cmpt x3 A2 (cfv (cv x3) F))) $;

--| The range of a function expressed as a collection of the function's values. (Contributed by NM, 20-Oct-2005.) (Proof shortened by Mario Carneiro, 31-Aug-2015.)
theorem fnrnfv {x3 y1: setvar} (A2 F: class):
  $ wi (wfn F A2) (wceq (crn F) (cab y1 (wrex x3 (wceq (cv y1) (cfv (cv x3) F)) A2))) $;

--| A member of a function's range is a value of the function. (Contributed by NM, 31-Oct-1995.)
theorem fvelrnb {x3: setvar} (A2 B2 F: class):
  $ wi (wfn F A2) (wb (wcel B2 (crn F)) (wrex x3 (wceq (cfv (cv x3) F) B2) A2)) $;

--| A member of a surjective function's codomain is a value of the function. (Contributed by Thierry Arnoux, 23-Jan-2020.)
theorem foelcdmi {x3: setvar} (A2 B2 F Y: class):
  $ wi (wa (wfo A2 B2 F) (wcel Y B2)) (wrex x3 (wceq (cfv (cv x3) F) Y) A2) $;

--| Alternate definition of the image of a function. (Contributed by Raph Levien, 20-Nov-2006.)
theorem dfimafn {x3 y1: setvar} (A2 F: class):
  $ wi (wa (wfun F) (wss A2 (cdm F))) (wceq (cima F A2) (cab y1 (wrex x3 (wceq (cfv (cv x3) F) (cv y1)) A2))) $;

--| Alternate definition of the image of a function as an indexed union of singletons of function values. (Contributed by Raph Levien, 20-Nov-2006.)
theorem dfimafn2 {x3: setvar} (A2 F: class):
  $ wi (wa (wfun F) (wss A2 (cdm F))) (wceq (cima F A2) (ciun x3 A2 (csn (cfv (cv x3) F)))) $;

--| Membership relation for the values of a function whose image is a subclass. (Contributed by Raph Levien, 20-Nov-2006.)
theorem funimass4 {x3: setvar} (A2 B2 F: class):
  $ wi (wa (wfun F) (wss A2 (cdm F))) (wb (wss (cima F A2) B2) (wral x3 (wcel (cfv (cv x3) F) B2) A2)) $;

--| Function value in an image. Part of Theorem 4.4(iii) of [Monk1] p. 42. (Contributed by NM, 29-Apr-2004.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem fvelima {x3: setvar} (A2 B2 F: class):
  $ wi (wa (wfun F) (wcel A2 (cima F B2))) (wrex x3 (wceq (cfv (cv x3) F) A2) B2) $;

--| Sufficient condition for the image of a function being a subclass. (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem funimassd {x3: setvar} (ph: wff x3) (A2 B2 F: class):
  $ wnf x3 ph $ >
  $ wi ph (wfun F) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel (cfv (cv x3) F) B2) $ >
  $ wi ph (wss (cima F A2) B2) $;

--| Function value in an image. (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem fvelimad {x3: setvar} (ph: wff x3) (A2 B2 C: class) (F: class x3):
  $ wnfc x3 F $ >
  $ wi ph (wfn F A2) $ >
  $ wi ph (wcel C (cima F B2)) $ >
  $ wi ph (wrex x3 (wceq (cfv (cv x3) F) C) (cin A2 B2)) $;

--| Deduction form of ~ dffn5 . (Contributed by Mario Carneiro, 8-Jan-2015.)
theorem feqmptd {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3) (F: class):
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wceq F (cmpt x3 A2 (cfv (cv x3) F))) $;

--| Express a restricted function as a mapping. (Contributed by Mario Carneiro, 18-May-2016.)
theorem feqresmpt {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3) (C F: class):
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wss C A2) $ >
  $ wi ph (wceq (cres F C) (cmpt x3 C (cfv (cv x3) F))) $;

--| Deduction form of ~ dffn5f . (Contributed by Mario Carneiro, 8-Jan-2015.) (Revised by Thierry Arnoux, 10-May-2017.)
theorem feqmptdf {x3: setvar} (ph: wff x3) (A2 B2 F: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 F $ >
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wceq F (cmpt x3 A2 (cfv (cv x3) F))) $;

--| Representation of a function in terms of its values. (Contributed by Mario Carneiro, 3-Jul-2015.)
theorem dffn5f {x3: setvar} (A2: class) (F: class x3):
  $ wnfc x3 F $ >
  $ wb (wfn F A2) (wceq F (cmpt x3 A2 (cfv (cv x3) F))) $;

--| Function value in an image. (Contributed by NM, 20-Jan-2007.) (Proof shortened by Andrew Salmon, 22-Oct-2011.) (Revised by David Abernethy, 17-Dec-2011.)
theorem fvelimab {x3: setvar} (A2: class x3) (B2 C F: class):
  $ wi (wa (wfn F A2) (wss B2 A2)) (wb (wcel C (cima F B2)) (wrex x3 (wceq (cfv (cv x3) F) C) B2)) $;

--| Deduction form of ~ fvelimab . (Contributed by Stanislas Polu, 9-Mar-2020.)
theorem fvelimabd {x3: setvar} (ph: wff x3) (A2: class x3) (B2 C F: class):
  $ wi ph (wfn F A2) $ >
  $ wi ph (wss B2 A2) $ >
  $ wi ph (wb (wcel C (cima F B2)) (wrex x3 (wceq (cfv (cv x3) F) C) B2)) $;

--| Expressing the image of a set as a restricted abstract builder. (Contributed by Thierry Arnoux, 27-Jan-2020.)
theorem fimarab {x3 y1: setvar} (A2 B2: class x3) (F X: class):
  $ wi (wa (wf A2 B2 F) (wss X A2)) (wceq (cima F X) (crab y1 (wrex x3 (wceq (cfv (cv x3) F) (cv y1)) X) B2)) $;

--| Image of a union. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem unima (A2 B2 C F: class):
  $ wi (w3a (wfn F A2) (wss B2 A2) (wss C A2)) (wceq (cima F (cun B2 C)) (cun (cima F B2) (cima F C))) $;

--| The value of the identity function. (Contributed by NM, 1-May-2004.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem fvi (A2 V: class):
  $ wi (wcel A2 V) (wceq (cfv A2 cid) A2) $;

--| The value of the identity function is a subset of the argument. (An artifact of our function value definition.) (Contributed by Mario Carneiro, 27-Feb-2016.)
theorem fviss (A2: class):
  $ wss (cfv A2 cid) A2 $;

--| The indexed intersection of a function's values is the intersection of its range. (Contributed by NM, 20-Oct-2005.)
theorem fniinfv {x3: setvar} (A2 F: class):
  $ wi (wfn F A2) (wceq (ciin x3 A2 (cfv (cv x3) F)) (cint (crn F))) $;

--| Singleton of function value. (Contributed by NM, 22-May-1998.) (Proof shortened by Scott Fenton, 8-Aug-2024.)
theorem fnsnfv (A2 B2 F: class):
  $ wi (wa (wfn F A2) (wcel B2 A2)) (wceq (csn (cfv B2 F)) (cima F (csn B2))) $;

--| Define a function whose value is "the unique ` y ` such that ` ph ( x , y ) ` ". (Contributed by NM, 19-May-2015.)
theorem opabiotafun {x3 y1: setvar} (ph: wff x3 y1) (F: class):
  $ wceq F (copab x3 y1 (wceq (cab y1 ph) (csn (cv y1)))) $ >
  $ wfun F $;

--| Define a function whose value is "the unique ` y ` such that ` ph ( x , y ) ` ". (Contributed by NM, 16-Nov-2013.)
theorem opabiotadm {x3 y1: setvar} (ph: wff x3 y1) (F: class):
  $ wceq F (copab x3 y1 (wceq (cab y1 ph) (csn (cv y1)))) $ >
  $ wceq (cdm F) (cab x3 (weu y1 ph)) $;

--| Define a function whose value is "the unique ` y ` such that ` ph ( x , y ) ` ". (Contributed by NM, 16-Nov-2013.)
theorem opabiota {x3 y1: setvar} (ph: wff x3 y1) (ps: wff y1) (B2 F: class):
  $ wceq F (copab x3 y1 (wceq (cab y1 ph) (csn (cv y1)))) $ >
  $ wi (wceq (cv x3) B2) (wb ph ps) $ >
  $ wi (wcel B2 (cdm F)) (wceq (cfv B2 F) (cio y1 ps)) $;

--| The image of a pair under a function. (Contributed by Jeff Madsen, 6-Jan-2011.)
theorem fnimapr (A2 B2 C F: class):
  $ wi (w3a (wfn F A2) (wcel B2 A2) (wcel C A2)) (wceq (cima F (cpr B2 C)) (cpr (cfv B2 F) (cfv C F))) $;

--| The image of an unordered triple under a function. (Contributed by Thierry Arnoux, 19-Sep-2023.)
theorem fnimatpd (ph: wff) (A2 B2 C D F: class):
  $ wi ph (wfn F D) $ >
  $ wi ph (wcel A2 D) $ >
  $ wi ph (wcel B2 D) $ >
  $ wi ph (wcel C D) $ >
  $ wi ph (wceq (cima F (ctp A2 B2 C)) (ctp (cfv A2 F) (cfv B2 F) (cfv C F))) $;

--| The existence of a subimage. (Contributed by NM, 8-Apr-2007.)
theorem ssimaex {x3: setvar} (A2 B2 F: class):
  $ wcel A2 cvv $ >
  $ wi (wa (wfun F) (wss B2 (cima F A2))) (wex x3 (wa (wss (cv x3) A2) (wceq B2 (cima F (cv x3))))) $;

--| The existence of a subimage. (Contributed by FL, 15-Apr-2007.)
theorem ssimaexg {x3: setvar} (A2 B2: class) (C: class x3) (F: class):
  $ wi (w3a (wcel A2 C) (wfun F) (wss B2 (cima F A2))) (wex x3 (wa (wss (cv x3) A2) (wceq B2 (cima F (cv x3))))) $;

--| A simplified expression for the value of a function when we know it is a function. (Contributed by NM, 22-May-1998.)
theorem funfv (A2 F: class):
  $ wi (wfun F) (wceq (cfv A2 F) (cuni (cima F (csn A2)))) $;

--| The value of a function. Definition of function value in [Enderton] p. 43. (Contributed by NM, 22-May-1998.)
theorem funfv2 {y1: setvar} (A2 F: class):
  $ wi (wfun F) (wceq (cfv A2 F) (cuni (cab y1 (wbr A2 (cv y1) F)))) $;

--| The value of a function. Version of ~ funfv2 using a bound-variable hypotheses instead of distinct variable conditions. (Contributed by NM, 19-Feb-2006.)
theorem funfv2f {y1: setvar} (A2 F: class y1):
  $ wnfc y1 A2 $ >
  $ wnfc y1 F $ >
  $ wi (wfun F) (wceq (cfv A2 F) (cuni (cab y1 (wbr A2 (cv y1) F)))) $;

--| Value of the union of two functions when the domains are separate. (Contributed by FL, 7-Nov-2011.)
theorem fvun (A2 F G: class):
  $ wi (wa (wa (wfun F) (wfun G)) (wceq (cin (cdm F) (cdm G)) c0)) (wceq (cfv A2 (cun F G)) (cun (cfv A2 F) (cfv A2 G))) $;

--| The value of a union when the argument is in the first domain. (Contributed by Scott Fenton, 29-Jun-2013.)
theorem fvun1 (A2 B2 F G X: class):
  $ wi (w3a (wfn F A2) (wfn G B2) (wa (wceq (cin A2 B2) c0) (wcel X A2))) (wceq (cfv X (cun F G)) (cfv X F)) $;

--| The value of a union when the argument is in the second domain. (Contributed by Scott Fenton, 29-Jun-2013.)
theorem fvun2 (A2 B2 F G X: class):
  $ wi (w3a (wfn F A2) (wfn G B2) (wa (wceq (cin A2 B2) c0) (wcel X B2))) (wceq (cfv X (cun F G)) (cfv X G)) $;

--| The value of a union when the argument is in the first domain, a deduction version. (Contributed by metakunt, 28-May-2024.)
theorem fvun1d (ph: wff) (A2 B2 F G X: class):
  $ wi ph (wfn F A2) $ >
  $ wi ph (wfn G B2) $ >
  $ wi ph (wceq (cin A2 B2) c0) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wceq (cfv X (cun F G)) (cfv X F)) $;

--| The value of a union when the argument is in the second domain, a deduction version. (Contributed by metakunt, 28-May-2024.)
theorem fvun2d (ph: wff) (A2 B2 F G X: class):
  $ wi ph (wfn F A2) $ >
  $ wi ph (wfn G B2) $ >
  $ wi ph (wceq (cin A2 B2) c0) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (cfv X (cun F G)) (cfv X G)) $;

--| Alternate definition of function value ~ df-fv that doesn't require dummy variables. (Contributed by NM, 4-Aug-2010.)
theorem dffv2 (A2 F: class):
  $ wceq (cfv A2 F) (cuni (cdif (cima F (csn A2)) (cuni (cuni (cdif (ccom (cres F (csn A2)) (ccnv (cres F (csn A2)))) cid))))) $;

--| Domains of a function composition. (Contributed by NM, 27-Jan-1997.)
theorem dmfco (A2 F G: class):
  $ wi (wa (wfun G) (wcel A2 (cdm G))) (wb (wcel A2 (cdm (ccom F G))) (wcel (cfv A2 G) (cdm F))) $;

--| Value of a function composition. Similar to second part of Theorem 3H of [Enderton] p. 47. (Contributed by NM, 9-Oct-2004.) (Proof shortened by Andrew Salmon, 22-Oct-2011.) (Revised by Stefan O'Rear, 16-Oct-2014.)
theorem fvco2 (A2 F G X: class):
  $ wi (wa (wfn G A2) (wcel X A2)) (wceq (cfv X (ccom F G)) (cfv (cfv X G) F)) $;

--| Value of a function composition. Similar to Exercise 5 of [TakeutiZaring] p. 28. (Contributed by NM, 22-Apr-2006.) (Proof shortened by Mario Carneiro, 26-Dec-2014.)
theorem fvco (A2 F G: class):
  $ wi (wa (wfun G) (wcel A2 (cdm G))) (wceq (cfv A2 (ccom F G)) (cfv (cfv A2 G) F)) $;

--| Value of a function composition. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem fvcod (ph: wff) (A2 F G H: class):
  $ wi ph (wfun G) $ >
  $ wi ph (wcel A2 (cdm G)) $ >
  $ wceq H (ccom F G) $ >
  $ wi ph (wceq (cfv A2 H) (cfv (cfv A2 G) F)) $;

--| Value of a function composition. (Contributed by NM, 3-Jan-2004.) (Revised by Mario Carneiro, 26-Dec-2014.)
theorem fvco3 (A2 B2 C F G: class):
  $ wi (wa (wf A2 B2 G) (wcel C A2)) (wceq (cfv C (ccom F G)) (cfv (cfv C G) F)) $;

--| Value of a function composition. Deduction form of ~ fvco3 . (Contributed by Stanislas Polu, 9-Mar-2020.)
theorem fvco3d (ph: wff) (A2 B2 C F G: class):
  $ wi ph (wf A2 B2 G) $ >
  $ wi ph (wcel C A2) $ >
  $ wi ph (wceq (cfv C (ccom F G)) (cfv (cfv C G) F)) $;

--| Conditions for a composition to be expandable without conditions on the argument. (Contributed by Stefan O'Rear, 31-Mar-2015.)
theorem fvco4i (F G X: class):
  $ wceq c0 (cfv c0 F) $ >
  $ wfun G $ >
  $ wceq (cfv X (ccom F G)) (cfv (cfv X G) F) $;

--| Value of a function given by ordered-pair class abstraction. (Contributed by NM, 6-Mar-1996.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem fvopab3g {x3 y1: setvar} (ph ps: wff x3 y1) (ch: wff) (A2 B2 C: class) (D F: class x3 y1):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wcel (cv x3) C) (weu y1 ph) $ >
  $ wceq F (copab x3 y1 (wa (wcel (cv x3) C) ph)) $ >
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wb (wceq (cfv A2 F) B2) ch) $;

--| Value of a function given by ordered-pair class abstraction. (Contributed by NM, 23-Oct-1999.)
theorem fvopab3ig {x3 y1: setvar} (ph ps: wff x3 y1) (ch: wff) (A2 B2 C: class) (D F: class x3 y1):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wcel (cv x3) C) (wmo y1 ph) $ >
  $ wceq F (copab x3 y1 (wa (wcel (cv x3) C) ph)) $ >
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wi ch (wceq (cfv A2 F) B2)) $;

--| The binary relation of a function value which is an ordered-pair class abstraction of a restricted binary relation is the restricted binary relation. The first hypothesis can often be obtained by using ~ fvmptopab . (Contributed by AV, 29-Oct-2021.)
theorem brfvopabrbr {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2: class x3 y1) (B2 X Y Z: class):
  $ wceq (cfv Z A2) (copab x3 y1 (wa (wbr (cv x3) (cv y1) (cfv Z B2)) ph)) $ >
  $ wi (wa (wceq (cv x3) X) (wceq (cv y1) Y)) (wb ph ps) $ >
  $ wrel (cfv Z B2) $ >
  $ wb (wbr X Y (cfv Z A2)) (wa (wbr X Y (cfv Z B2)) ps) $;

--| Value of a function given in maps-to notation. (Contributed by NM, 2-Oct-2007.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem fvmptg {x3: setvar} (A2: class) (B2: class x3) (C D: class) (R F: class x3):
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wceq F (cmpt x3 D B2) $ >
  $ wi (wa (wcel A2 D) (wcel C R)) (wceq (cfv A2 F) C) $;

--| Value of a function given in maps-to notation. (Contributed by Mario Carneiro, 23-Apr-2014.)
theorem fvmpti {x3: setvar} (A2: class) (B2: class x3) (C D: class) (F: class x3):
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wceq F (cmpt x3 D B2) $ >
  $ wi (wcel A2 D) (wceq (cfv A2 F) (cfv C cid)) $;

--| Value of a function given in maps-to notation. (Contributed by NM, 17-Aug-2011.)
theorem fvmpt {x3: setvar} (A2: class) (B2: class x3) (C D: class) (F: class x3):
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wceq F (cmpt x3 D B2) $ >
  $ wcel C cvv $ >
  $ wi (wcel A2 D) (wceq (cfv A2 F) C) $;

--| Value of a function given by the maps-to notation. (Contributed by Thierry Arnoux, 9-Mar-2017.)
theorem fvmpt2f {x3: setvar} (A2 B2 C: class x3):
  $ wnfc x3 A2 $ >
  $ wi (wa (wcel (cv x3) A2) (wcel B2 C)) (wceq (cfv (cv x3) (cmpt x3 A2 B2)) B2) $;

--| Condition for a function in maps-to notation to be single-rooted. (Contributed by Thierry Arnoux, 28-Feb-2017.) (Proof shortened by Peter Mazsa, 24-Feb-2026.)
theorem funcnvmpt {x3 y1: setvar} (ph: wff x3) (A2 B2: class x3 y1) (F: class x3) (V: class x3 y1):
  $ wnf x3 ph $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 F $ >
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi ph (wb (wfun (ccnv F)) (wal y1 (wrmo x3 (wceq (cv y1) B2) A2))) $;

--| Functionality of a tuple-restriction function. (Contributed by Stefan O'Rear, 24-Jan-2015.)
theorem fvtresfn {x3: setvar} (B2: class) (F: class x3) (V X: class):
  $ wceq F (cmpt x3 B2 (cres (cv x3) V)) $ >
  $ wi (wcel X B2) (wceq (cfv X F) (cres X V)) $;

--| Value of a function given in maps-to notation, using explicit class substitution. (Contributed by Scott Fenton, 17-Jul-2013.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem fvmpts {x3: setvar} (A2 B2: class x3) (C: class) (F V: class x3):
  $ wceq F (cmpt x3 C B2) $ >
  $ wi (wa (wcel A2 C) (wcel (csb x3 A2 B2) V)) (wceq (cfv A2 F) (csb x3 A2 B2)) $;

--| Value of a function given in maps-to notation, with a slightly different sethood condition. (Contributed by Stefan O'Rear, 30-Jan-2015.)
theorem fvmpt3 {x3: setvar} (A2: class) (B2: class x3) (C D: class) (F: class x3) (V: class):
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wceq F (cmpt x3 D B2) $ >
  $ wi (wcel (cv x3) D) (wcel B2 V) $ >
  $ wi (wcel A2 D) (wceq (cfv A2 F) C) $;

--| Value of a function given in maps-to notation, with a slightly different sethood condition. (Contributed by Mario Carneiro, 11-Sep-2015.)
theorem fvmpt3i {x3: setvar} (A2: class) (B2: class x3) (C D: class) (F: class x3):
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wceq F (cmpt x3 D B2) $ >
  $ wcel B2 cvv $ >
  $ wi (wcel A2 D) (wceq (cfv A2 F) C) $;

--| Deduction version of ~ fvmptd using bound-variable hypotheses instead of distinct variable conditions. (Contributed by AV, 29-Mar-2024.)
theorem fvmptdf {x3: setvar} (ph: wff x3) (A2 B2 C: class x3) (D: class) (F V: class x3):
  $ wi ph (wceq F (cmpt x3 D B2)) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wceq B2 C) $ >
  $ wi ph (wcel A2 D) $ >
  $ wi ph (wcel C V) $ >
  $ wnf x3 ph $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 C $ >
  $ wi ph (wceq (cfv A2 F) C) $;

--| Deduction version of ~ fvmpt . (Contributed by Scott Fenton, 18-Feb-2013.) (Revised by Mario Carneiro, 31-Aug-2015.) (Proof shortened by AV, 29-Mar-2024.)
theorem fvmptd {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (C D: class) (F V: class x3):
  $ wi ph (wceq F (cmpt x3 D B2)) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wceq B2 C) $ >
  $ wi ph (wcel A2 D) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wceq (cfv A2 F) C) $;

--| Deduction version of ~ fvmpt (where the definition of the mapping does not depend on the common antecedent ` ph ` ). (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem fvmptd2 {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (C D: class) (F V: class x3):
  $ wceq F (cmpt x3 D B2) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wceq B2 C) $ >
  $ wi ph (wcel A2 D) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wceq (cfv A2 F) C) $;

--| Reverse closure for a mapping: If the function value of a mapping has a member, the argument belongs to the base class of the mapping. (Contributed by AV, 4-Apr-2020.)
theorem mptrcl {x3: setvar} (A2: class) (B2 F I X: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wcel I (cfv X F)) (wcel X A2) $;

--| Value of a function given by the maps-to notation. (Contributed by Mario Carneiro, 23-Apr-2014.)
theorem fvmpt2i {x3: setvar} (A2: class) (B2 F: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wcel (cv x3) A2) (wceq (cfv (cv x3) F) (cfv B2 cid)) $;

--| Value of a function given by the maps-to notation. (Contributed by FL, 21-Jun-2010.)
theorem fvmpt2 {x3: setvar} (A2: class) (B2 C F: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wa (wcel (cv x3) A2) (wcel B2 C)) (wceq (cfv (cv x3) F) B2) $;

--| If all the values of the mapping are subsets of a class ` C ` , then so is any evaluation of the mapping, even if ` D ` is not in the base set ` A ` . (Contributed by Mario Carneiro, 13-Feb-2015.)
theorem fvmptss {x3: setvar} (A2: class) (B2: class x3) (C: class) (D F: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wral x3 (wss B2 C) A2) (wss (cfv D F) C) $;

--| Deduction version of ~ fvmpt2 . (Contributed by Thierry Arnoux, 8-Dec-2016.)
theorem fvmpt2d {x3: setvar} (ph: wff x3) (A2: class) (B2 F V: class x3):
  $ wi ph (wceq F (cmpt x3 A2 B2)) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wceq (cfv (cv x3) F) B2) $;

--| Express a function ` F ` whose value ` B ` may not always be a set in terms of another function ` G ` for which sethood is guaranteed. (Note that ` ( _I `` B ) ` is just shorthand for ` if ( B e. _V , B , (/) ) ` , and it is always a set by ~ fvex .) Note also that these functions are not the same; wherever ` B ( C ) ` is not a set, ` C ` is not in the domain of ` F ` (so it evaluates to the empty set), but ` C ` is in the domain of ` G ` , and ` G ( C ) ` is defined to be the empty set. (Contributed by Mario Carneiro, 14-Jul-2013.) (Revised by Mario Carneiro, 23-Apr-2014.)
theorem fvmptex {x3: setvar} (A2: class) (B2 C F G: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wceq G (cmpt x3 A2 (cfv B2 cid)) $ >
  $ wceq (cfv C F) (cfv C G) $;

--| Alternate deduction version of ~ fvmpt with three nonfreeness hypotheses instead of distinct variable conditions. (Contributed by AV, 19-Jan-2022.)
theorem fvmptd3f {x3: setvar} (ph ps: wff x3) (A2: class) (B2: class x3) (D: class) (F V: class x3):
  $ wi ph (wcel A2 D) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wcel B2 V) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wi (wceq (cfv A2 F) B2) ps) $ >
  $ wnfc x3 F $ >
  $ wnf x3 ps $ >
  $ wnf x3 ph $ >
  $ wi ph (wi (wceq F (cmpt x3 D B2)) ps) $;

--| Alternate deduction version of ~ fvmpt , suitable for iteration. (Contributed by Mario Carneiro, 7-Jan-2017.) (Proof shortened by AV, 19-Jan-2022.)
theorem fvmptd2f {x3: setvar} (ph: wff) (ps: wff x3) (A2: class) (B2: class x3) (D: class) (F V: class x3):
  $ wi ph (wcel A2 D) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wcel B2 V) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wi (wceq (cfv A2 F) B2) ps) $ >
  $ wnfc x3 F $ >
  $ wnf x3 ps $ >
  $ wi ph (wi (wceq F (cmpt x3 D B2)) ps) $;

--| Alternate deduction version of ~ fvmpt , suitable for iteration. (Contributed by Mario Carneiro, 7-Jan-2017.)
theorem fvmptdv {x3: setvar} (ph ps: wff) (A2: class) (B2: class x3) (D F: class) (V: class x3):
  $ wi ph (wcel A2 D) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wcel B2 V) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wi (wceq (cfv A2 F) B2) ps) $ >
  $ wi ph (wi (wceq F (cmpt x3 D B2)) ps) $;

--| Alternate deduction version of ~ fvmpt , suitable for iteration. (Contributed by Mario Carneiro, 7-Jan-2017.)
theorem fvmptdv2 {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (C D: class) (F V: class x3):
  $ wi ph (wcel A2 D) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wcel B2 V) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wceq B2 C) $ >
  $ wi ph (wi (wceq F (cmpt x3 D B2)) (wceq (cfv A2 F) C)) $;

--| Bidirectional equality theorem for a mapping abstraction. Equivalent to ~ eqfnfv . (Contributed by Mario Carneiro, 14-Nov-2014.)
theorem mpteqb {x3: setvar} (A2: class) (B2 C V: class x3):
  $ wi (wral x3 (wcel B2 V) A2) (wb (wceq (cmpt x3 A2 B2) (cmpt x3 A2 C)) (wral x3 (wceq B2 C) A2)) $;

--| Closed theorem form of ~ fvmpt . (Contributed by Scott Fenton, 21-Feb-2013.) (Revised by Mario Carneiro, 11-Sep-2015.)
theorem fvmptt {x3: setvar} (A2: class) (B2: class x3) (C D: class) (F V: class x3):
  $ wi (w3a (wal x3 (wi (wceq (cv x3) A2) (wceq B2 C))) (wceq F (cmpt x3 D B2)) (wa (wcel A2 D) (wcel C V))) (wceq (cfv A2 F) C) $;

--| Value of a function given by an ordered-pair class abstraction. This version of ~ fvmptg uses bound-variable hypotheses instead of distinct variable conditions. (Contributed by NM, 8-Nov-2005.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem fvmptf {x3: setvar} (A2 B2 C: class x3) (D: class) (F V: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 C $ >
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wceq F (cmpt x3 D B2) $ >
  $ wi (wa (wcel A2 D) (wcel C V)) (wceq (cfv A2 F) C) $;

--| The value of a function given by an ordered-pair class abstraction is the empty set when the class it would otherwise map to is a proper class. This version of ~ fvmptn uses bound-variable hypotheses instead of distinct variable conditions. (Contributed by NM, 21-Oct-2003.) (Revised by Mario Carneiro, 11-Sep-2015.)
theorem fvmptnf {x3: setvar} (A2 B2 C: class x3) (D: class) (F: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 C $ >
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wceq F (cmpt x3 D B2) $ >
  $ wi (wn (wcel C cvv)) (wceq (cfv A2 F) c0) $;

--| Deduction version of ~ fvmpt . (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem fvmptd3 {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3) (C D: class) (F V: class x3):
  $ wceq F (cmpt x3 D B2) $ >
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wi ph (wcel A2 D) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wceq (cfv A2 F) C) $;

--| Deduction version of ~ fvmpt (where the substitution hypothesis does not have the antecedent ` ph ` ). (Contributed by SN, 26-Jul-2024.)
theorem fvmptd4 {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (C D: class) (F V: class x3):
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wi ph (wceq F (cmpt x3 D B2)) $ >
  $ wi ph (wcel A2 D) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wceq (cfv A2 F) C) $;

--| This somewhat non-intuitive theorem tells us the value of its function is the empty set when the class ` C ` it would otherwise map to is a proper class. This is a technical lemma that can help eliminate redundant sethood antecedents otherwise required by ~ fvmptg . (Contributed by NM, 21-Oct-2003.) (Revised by Mario Carneiro, 9-Sep-2013.)
theorem fvmptn {x3: setvar} (A2: class) (B2: class x3) (C D: class) (F: class x3):
  $ wi (wceq (cv x3) D) (wceq B2 C) $ >
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wn (wcel C cvv)) (wceq (cfv D F) c0) $;

--| A mapping always evaluates to a subset of the substituted expression in the mapping, even if this is a proper class, or we are out of the domain. (Contributed by Mario Carneiro, 13-Feb-2015.)
theorem fvmptss2 {x3: setvar} (A2: class) (B2: class x3) (C D: class) (F: class x3):
  $ wi (wceq (cv x3) D) (wceq B2 C) $ >
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wss (cfv D F) C $;

--| Implications for the value of a function defined by the maps-to notation with a class abstraction as a result having an element. Here, the base set of the class abstraction depends on the argument of the function. Version of ~ elfvmptrab1 with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by Alexander van der Vekens, 15-Jul-2018.) Avoid ~ ax-13 . (Revised by GG, 26-Jan-2024.)
theorem elfvmptrab1w {x3 y1 m: setvar} (ph: wff x3 y1 m) (F: class x3 y1 m) (M: class m) (V: class y1 m) (X: class m) (Y: class x3 m):
  $ wceq F (cmpt x3 V (crab y1 ph (csb m (cv x3) M))) $ >
  $ wi (wcel X V) (wcel (csb m X M) cvv) $ >
  $ wi (wcel Y (cfv X F)) (wa (wcel X V) (wcel Y (csb m X M))) $;

--| Implications for the value of a function defined by the maps-to notation with a class abstraction as a result having an element. Here, the base set of the class abstraction depends on the argument of the function. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ elfvmptrab1w when possible. (Contributed by Alexander van der Vekens, 15-Jul-2018.) (New usage is discouraged.)
theorem elfvmptrab1 {x3 y1 m: setvar} (ph: wff x3 y1 m) (F: class x3 y1 m) (M: class m) (V: class y1 m) (X: class m) (Y: class x3 m):
  $ wceq F (cmpt x3 V (crab y1 ph (csb m (cv x3) M))) $ >
  $ wi (wcel X V) (wcel (csb m X M) cvv) $ >
  $ wi (wcel Y (cfv X F)) (wa (wcel X V) (wcel Y (csb m X M))) $;

--| Implications for the value of a function defined by the maps-to notation with a class abstraction as a result having an element. (Contributed by Alexander van der Vekens, 15-Jul-2018.)
theorem elfvmptrab {x3 y1: setvar} (ph: wff x3 y1) (F: class x3 y1) (M: class) (V: class y1) (X: class) (Y: class x3):
  $ wceq F (cmpt x3 V (crab y1 ph M)) $ >
  $ wi (wcel X V) (wcel M cvv) $ >
  $ wi (wcel Y (cfv X F)) (wa (wcel X V) (wcel Y M)) $;

--| Value of a function given by an ordered-pair class abstraction, outside of its domain. (Contributed by NM, 28-Mar-2008.)
theorem fvopab4ndm {x3 y1: setvar} (ph: wff x3 y1) (A2: class) (B2 F: class x3 y1):
  $ wceq F (copab x3 y1 (wa (wcel (cv x3) A2) ph)) $ >
  $ wi (wn (wcel B2 A2)) (wceq (cfv B2 F) c0) $;

--| Value of a function given by the maps-to notation, outside of its domain. (Contributed by AV, 31-Dec-2020.)
theorem fvmptndm {x3: setvar} (A2: class) (B2 F X: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wn (wcel X A2)) (wceq (cfv X F) c0) $;

--| Value of a function mapping a set to a class abstraction restricting the value of another function. (Contributed by AV, 18-Feb-2022.)
theorem fvmptrabfv {x3 y1: setvar} (ph: wff x3 y1) (ps: wff y1) (F: class x3 y1) (G X: class):
  $ wceq F (cmpt x3 cvv (crab y1 ph (cfv (cv x3) G))) $ >
  $ wi (wceq (cv x3) X) (wb ph ps) $ >
  $ wceq (cfv X F) (crab y1 ps (cfv X G)) $;

--| The value of a function that is expressed as an ordered pair abstraction. (Contributed by NM, 19-Feb-2006.) (Revised by Mario Carneiro, 11-Sep-2015.)
theorem fvopab5 {x3 y1: setvar} (ph: wff x3 y1) (ps: wff y1) (A2: class) (F V: class x3 y1):
  $ wceq F (copab x3 y1 ph) $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wcel A2 V) (wceq (cfv A2 F) (cio y1 ps)) $;

--| Value of a function given by ordered-pair class abstraction. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 11-Sep-2015.)
theorem fvopab6 {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2: class) (B2: class x3) (C: class) (D R F: class x3 y1):
  $ wceq F (copab x3 y1 (wa ph (wceq (cv y1) B2))) $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wi (w3a (wcel A2 D) (wcel C R) ps) (wceq (cfv A2 F) C) $;

--| Equality of functions is determined by their values. Special case of Exercise 4 of [TakeutiZaring] p. 28 (with domain equality omitted). (Contributed by NM, 3-Aug-1994.) (Proof shortened by Andrew Salmon, 22-Oct-2011.) (Proof shortened by Mario Carneiro, 31-Aug-2015.)
theorem eqfnfv {x3: setvar} (A2 F G: class):
  $ wi (wa (wfn F A2) (wfn G A2)) (wb (wceq F G) (wral x3 (wceq (cfv (cv x3) F) (cfv (cv x3) G)) A2)) $;

--| Equality of functions is determined by their values. Exercise 4 of [TakeutiZaring] p. 28. (Contributed by NM, 3-Aug-1994.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem eqfnfv2 {x3: setvar} (A2: class) (B2: class x3) (F G: class):
  $ wi (wa (wfn F A2) (wfn G B2)) (wb (wceq F G) (wa (wceq A2 B2) (wral x3 (wceq (cfv (cv x3) F) (cfv (cv x3) G)) A2))) $;

--| Derive equality of functions from equality of their values. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem eqfnfv3 {x3: setvar} (A2 B2 F G: class):
  $ wi (wa (wfn F A2) (wfn G B2)) (wb (wceq F G) (wa (wss B2 A2) (wral x3 (wa (wcel (cv x3) B2) (wceq (cfv (cv x3) F) (cfv (cv x3) G))) A2))) $;

--| Deduction for equality of functions. (Contributed by Mario Carneiro, 24-Jul-2014.)
theorem eqfnfvd {x3: setvar} (ph: wff) (A2 F G: class):
  $ wi ph (wfn F A2) $ >
  $ wi ph (wfn G A2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wceq (cfv (cv x3) F) (cfv (cv x3) G)) $ >
  $ wi ph (wceq F G) $;

--| Equality of functions is determined by their values. Special case of Exercise 4 of [TakeutiZaring] p. 28 (with domain equality omitted). This version of ~ eqfnfv uses bound-variable hypotheses instead of distinct variable conditions. (Contributed by NM, 29-Jan-2004.)
theorem eqfnfv2f {x3: setvar} (A2: class) (F G: class x3):
  $ wnfc x3 F $ >
  $ wnfc x3 G $ >
  $ wi (wa (wfn F A2) (wfn G A2)) (wb (wceq F G) (wral x3 (wceq (cfv (cv x3) F) (cfv (cv x3) G)) A2)) $;

--| Equality condition for two functions defined on a singleton. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem fsneq (ph: wff) (A2 B2 F G V: class):
  $ wi ph (wcel A2 V) $ >
  $ wceq B2 (csn A2) $ >
  $ wi ph (wfn F B2) $ >
  $ wi ph (wfn G B2) $ >
  $ wi ph (wb (wceq F G) (wceq (cfv A2 F) (cfv A2 G))) $;

--| Equality of functions is determined by their values. (Contributed by Scott Fenton, 19-Jun-2011.)
theorem eqfunfv {x3: setvar} (F G: class):
  $ wi (wa (wfun F) (wfun G)) (wb (wceq F G) (wa (wceq (cdm F) (cdm G)) (wral x3 (wceq (cfv (cv x3) F) (cfv (cv x3) G)) (cdm F)))) $;

--| Two functions on ` A u. B ` are equal if and only if they have equal restrictions to both ` A ` and ` B ` . (Contributed by Jeff Madsen, 19-Jun-2011.)
theorem eqfnun (A2 B2 F G: class):
  $ wi (wa (wfn F (cun A2 B2)) (wfn G (cun A2 B2))) (wb (wceq F G) (wa (wceq (cres F A2) (cres G A2)) (wceq (cres F B2) (cres G B2)))) $;

--| Equality of restricted functions is determined by their values (for functions with different domains). (Contributed by AV, 6-Jan-2019.)
theorem fvreseq0 {x3: setvar} (A2: class x3) (B2: class) (C: class x3) (F G: class):
  $ wi (wa (wa (wfn F A2) (wfn G C)) (wa (wss B2 A2) (wss B2 C))) (wb (wceq (cres F B2) (cres G B2)) (wral x3 (wceq (cfv (cv x3) F) (cfv (cv x3) G)) B2)) $;

--| Equality of a function restricted to the domain of another function. (Contributed by AV, 6-Jan-2019.)
theorem fvreseq1 {x3: setvar} (A2: class x3) (B2 F G: class):
  $ wi (wa (wa (wfn F A2) (wfn G B2)) (wss B2 A2)) (wb (wceq (cres F B2) G) (wral x3 (wceq (cfv (cv x3) F) (cfv (cv x3) G)) B2)) $;

--| Equality of restricted functions is determined by their values. (Contributed by NM, 3-Aug-1994.) (Proof shortened by AV, 4-Mar-2019.)
theorem fvreseq {x3: setvar} (A2: class x3) (B2 F G: class):
  $ wi (wa (wa (wfn F A2) (wfn G A2)) (wss B2 A2)) (wb (wceq (cres F B2) (cres G B2)) (wral x3 (wceq (cfv (cv x3) F) (cfv (cv x3) G)) B2)) $;

--| A function with a given domain is a mapping defined by its function values. (Contributed by AV, 1-Mar-2019.)
theorem fnmptfvd {i a: setvar} (ph: wff) (A2: class) (C: class a) (D: class i) (U M V: class):
  $ wi ph (wfn M A2) $ >
  $ wi (wceq (cv i) (cv a)) (wceq D C) $ >
  $ wi (wa ph (wcel (cv i) A2)) (wcel D U) $ >
  $ wi (wa ph (wcel (cv a) A2)) (wcel C V) $ >
  $ wi ph (wb (wceq M (cmpt a A2 C)) (wral i (wceq (cfv (cv i) M) D) A2)) $;

--| Two ways to express the locus of differences between two functions. (Contributed by Stefan O'Rear, 17-Jan-2015.)
theorem fndmdif {x3: setvar} (A2 F G: class):
  $ wi (wa (wfn F A2) (wfn G A2)) (wceq (cdm (cdif F G)) (crab x3 (wne (cfv (cv x3) F) (cfv (cv x3) G)) A2)) $;

--| The difference set between two functions is commutative. (Contributed by Stefan O'Rear, 17-Jan-2015.)
theorem fndmdifcom (A2 F G: class):
  $ wi (wa (wfn F A2) (wfn G A2)) (wceq (cdm (cdif F G)) (cdm (cdif G F))) $;

--| The difference set of two functions is empty if and only if the functions are equal. (Contributed by Stefan O'Rear, 17-Jan-2015.)
theorem fndmdifeq0 (A2 F G: class):
  $ wi (wa (wfn F A2) (wfn G A2)) (wb (wceq (cdm (cdif F G)) c0) (wceq F G)) $;

--| Two ways to express the locus of equality between two functions. (Contributed by Stefan O'Rear, 17-Jan-2015.)
theorem fndmin {x3: setvar} (A2 F G: class):
  $ wi (wa (wfn F A2) (wfn G A2)) (wceq (cdm (cin F G)) (crab x3 (wceq (cfv (cv x3) F) (cfv (cv x3) G)) A2)) $;

--| Two functions are equal iff their equalizer is the whole domain. (Contributed by Stefan O'Rear, 7-Mar-2015.)
theorem fneqeql (A2 F G: class):
  $ wi (wa (wfn F A2) (wfn G A2)) (wb (wceq F G) (wceq (cdm (cin F G)) A2)) $;

--| Two functions are equal iff their equalizer contains the whole domain. (Contributed by Stefan O'Rear, 9-Mar-2015.)
theorem fneqeql2 (A2 F G: class):
  $ wi (wa (wfn F A2) (wfn G A2)) (wb (wceq F G) (wss A2 (cdm (cin F G)))) $;

--| Two functions are equal on a subset iff their equalizer contains that subset. (Contributed by Stefan O'Rear, 7-Mar-2015.)
theorem fnreseql (A2 F G X: class):
  $ wi (w3a (wfn F A2) (wfn G A2) (wss X A2)) (wb (wceq (cres F X) (cres G X)) (wss X (cdm (cin F G)))) $;

--| The range of a choice function (a function that chooses an element from each member of its domain) is included in the union of its domain. (Contributed by NM, 31-Aug-1999.)
theorem chfnrn {x3: setvar} (A2 F: class):
  $ wi (wa (wfn F A2) (wral x3 (wcel (cfv (cv x3) F) (cv x3)) A2)) (wss (crn F) (cuni A2)) $;

--| Ordered pair with function value. Part of Theorem 4.3(i) of [Monk1] p. 41. (Contributed by NM, 14-Oct-1996.)
theorem funfvop (A2 F: class):
  $ wi (wa (wfun F) (wcel A2 (cdm F))) (wcel (cop A2 (cfv A2 F)) F) $;

--| Two ways to say that ` A ` is in the domain of ` F ` . (Contributed by Mario Carneiro, 1-May-2014.)
theorem funfvbrb (A2 F: class):
  $ wi (wfun F) (wb (wcel A2 (cdm F)) (wbr A2 (cfv A2 F) F)) $;

--| A member of a preimage is a function value argument. (Contributed by NM, 4-May-2007.)
theorem fvimacnvi (A2 B2 F: class):
  $ wi (wa (wfun F) (wcel A2 (cima (ccnv F) B2))) (wcel (cfv A2 F) B2) $;

--| The argument of a function value belongs to the preimage of any class containing the function value. Raph Levien remarks: "This proof is unsatisfying, because it seems to me that ~ funimass2 could probably be strengthened to a biconditional." (Contributed by Raph Levien, 20-Nov-2006.)
theorem fvimacnv (A2 B2 F: class):
  $ wi (wa (wfun F) (wcel A2 (cdm F))) (wb (wcel (cfv A2 F) B2) (wcel A2 (cima (ccnv F) B2))) $;

--| A kind of contraposition law that infers an image subclass from a subclass of a preimage. Raph Levien remarks: "Likely this could be proved directly, and ~ fvimacnv would be the special case of ` A ` being a singleton, but it works this way round too." (Contributed by Raph Levien, 20-Nov-2006.)
theorem funimass3 (A2 B2 F: class):
  $ wi (wa (wfun F) (wss A2 (cdm F))) (wb (wss (cima F A2) B2) (wss A2 (cima (ccnv F) B2))) $;

--| A subclass of a preimage in terms of function values. (Contributed by NM, 15-May-2007.)
theorem funimass5 {x3: setvar} (A2 B2 F: class):
  $ wi (wa (wfun F) (wss A2 (cdm F))) (wb (wss A2 (cima (ccnv F) B2)) (wral x3 (wcel (cfv (cv x3) F) B2) A2)) $;

--| Two ways of specifying that a function is constant on a subdomain. (Contributed by NM, 8-Mar-2007.)
theorem funconstss {x3: setvar} (A2 B2 F: class):
  $ wi (wa (wfun F) (wss A2 (cdm F))) (wb (wral x3 (wceq (cfv (cv x3) F) B2) A2) (wss A2 (cima (ccnv F) (csn B2)))) $;

--| Alternate proof of ~ fvimacnv , based on ~ funimass3 . If ~ funimass3 is ever proved directly, as opposed to using ~ funimacnv pointwise, then the proof of ~ funimacnv should be replaced with this one. (Contributed by Raph Levien, 20-Nov-2006.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem fvimacnvALT (A2 B2 F: class):
  $ wi (wa (wfun F) (wcel A2 (cdm F))) (wb (wcel (cfv A2 F) B2) (wcel A2 (cima (ccnv F) B2))) $;

--| Membership in the preimage of a class under a function. (Contributed by Jeff Madsen, 2-Sep-2009.) (Proof shortened by Sky Winter, 22-Oct-2026.)
theorem elpreima (A2 B2 C F: class):
  $ wi (wfn F A2) (wb (wcel B2 (cima (ccnv F) C)) (wa (wcel B2 A2) (wcel (cfv B2 F) C))) $;

--| Obsolete version of ~ elpreima as of 22-Oct-2026. (Contributed by Jeff Madsen, 2-Sep-2009.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem elpreimaOLD (A2 B2 C F: class):
  $ wi (wfn F A2) (wb (wcel B2 (cima (ccnv F) C)) (wa (wcel B2 A2) (wcel (cfv B2 F) C))) $;

--| Membership in the preimage of a set under a function. (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem elpreimad (ph: wff) (A2 B2 C F: class):
  $ wi ph (wfn F A2) $ >
  $ wi ph (wcel B2 A2) $ >
  $ wi ph (wcel (cfv B2 F) C) $ >
  $ wi ph (wcel B2 (cima (ccnv F) C)) $;

--| Membership in the preimage of a singleton, under a function. (Contributed by Mario Carneiro, 12-May-2014.) (Proof shortened by Mario Carneiro , 28-Apr-2015.)
theorem fniniseg (A2 B2 C F: class):
  $ wi (wfn F A2) (wb (wcel C (cima (ccnv F) (csn B2))) (wa (wcel C A2) (wceq (cfv C F) B2))) $;

--| Inverse images under functions expressed as abstractions. (Contributed by Stefan O'Rear, 1-Feb-2015.)
theorem fncnvima2 {x3: setvar} (A2 B2 F: class):
  $ wi (wfn F A2) (wceq (cima (ccnv F) B2) (crab x3 (wcel (cfv (cv x3) F) B2) A2)) $;

--| Inverse point images under functions expressed as abstractions. (Contributed by Stefan O'Rear, 1-Feb-2015.)
theorem fniniseg2 {x3: setvar} (A2 B2 F: class):
  $ wi (wfn F A2) (wceq (cima (ccnv F) (csn B2)) (crab x3 (wceq (cfv (cv x3) F) B2) A2)) $;

--| Preimage of a union. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem unpreima (A2 B2 F: class):
  $ wi (wfun F) (wceq (cima (ccnv F) (cun A2 B2)) (cun (cima (ccnv F) A2) (cima (ccnv F) B2))) $;

--| Preimage of an intersection. (Contributed by Jeff Madsen, 2-Sep-2009.) (Proof shortened by Mario Carneiro, 14-Jun-2016.)
theorem inpreima (A2 B2 F: class):
  $ wi (wfun F) (wceq (cima (ccnv F) (cin A2 B2)) (cin (cima (ccnv F) A2) (cima (ccnv F) B2))) $;

--| Preimage of a difference. (Contributed by Mario Carneiro, 14-Jun-2016.)
theorem difpreima (A2 B2 F: class):
  $ wi (wfun F) (wceq (cima (ccnv F) (cdif A2 B2)) (cdif (cima (ccnv F) A2) (cima (ccnv F) B2))) $;

--| The preimage of a restricted function. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem respreima (A2 B2 F: class):
  $ wi (wfun F) (wceq (cima (ccnv (cres F B2)) A2) (cin (cima (ccnv F) A2) B2)) $;

--| The preimage of the intersection of the range of a class and a class ` A ` is the preimage of the class ` A ` . (Contributed by AV, 17-Sep-2024.)
theorem cnvimainrn (A2 F: class):
  $ wi (wfun F) (wceq (cima (ccnv F) (cin (crn F) A2)) (cima (ccnv F) A2)) $;

--| The preimage of a subset is a subset of the preimage. (Contributed by Brendan Leahy, 23-Sep-2017.)
theorem sspreima (A2 B2 F: class):
  $ wi (wa (wfun F) (wss A2 B2)) (wss (cima (ccnv F) A2) (cima (ccnv F) B2)) $;

--| Preimage of an indexed union. (Contributed by Thierry Arnoux, 27-Mar-2018.)
theorem iunpreima {x3: setvar} (A2: class) (B2: class x3) (F: class):
  $ wi (wfun F) (wceq (cima (ccnv F) (ciun x3 A2 B2)) (ciun x3 A2 (cima (ccnv F) B2))) $;

--| Preimage of an intersection. (Contributed by FL, 16-Apr-2012.)
theorem iinpreima {x3: setvar} (A2: class) (B2: class x3) (F: class):
  $ wi (wa (wfun F) (wne A2 c0)) (wceq (cima (ccnv F) (ciin x3 A2 B2)) (ciin x3 A2 (cima (ccnv F) B2))) $;

--| Preimage of an intersection. (Contributed by FL, 28-Apr-2012.)
theorem intpreima {x3: setvar} (A2 F: class):
  $ wi (wa (wfun F) (wne A2 c0)) (wceq (cima (ccnv F) (cint A2)) (ciin x3 A2 (cima (ccnv F) (cv x3)))) $;

--| Taking the converse image of a set can be limited to the range of the function used. (Contributed by Thierry Arnoux, 21-Jan-2017.)
theorem fimacnvinrn (A2 F: class):
  $ wi (wfun F) (wceq (cima (ccnv F) A2) (cima (ccnv F) (cin A2 (crn F)))) $;

--| Taking the converse image of a set can be limited to the range of the function used. (Contributed by Thierry Arnoux, 17-Feb-2017.)
theorem fimacnvinrn2 (A2 B2 F: class):
  $ wi (wa (wfun F) (wss (crn F) B2)) (wceq (cima (ccnv F) A2) (cima (ccnv F) (cin A2 B2))) $;

--| The restriction of a function to a preimage of a class is a function onto the intersection of this class and the range of the function. (Contributed by AV, 13-Sep-2024.) (Revised by AV, 29-Sep-2024.)
theorem rescnvimafod (ph: wff) (A2 B2 D E F: class):
  $ wi ph (wfn F A2) $ >
  $ wi ph (wceq E (cin (crn F) B2)) $ >
  $ wi ph (wceq D (cima (ccnv F) B2)) $ >
  $ wi ph (wfo D E (cres F D)) $;

--| If a class' function values for certain arguments is not the empty set, the arguments are contained in the domain of the class, and the class restricted to the arguments is a function, analogous to ~ fvfundmfvn0 . (Contributed by AV, 27-Jan-2020.) (Proof shortened by Peter Mazsa, 2-Oct-2022.)
theorem fvn0ssdmfun {a: setvar} (D F: class):
  $ wi (wral a (wne (cfv (cv a) F) c0) D) (wa (wss D (cdm F)) (wfun (cres F D))) $;

--| Ordered pair with function value. Part of Theorem 4.3(i) of [Monk1] p. 41. (Contributed by NM, 30-Sep-2004.)
theorem fnopfv (A2 B2 F: class):
  $ wi (wa (wfn F A2) (wcel B2 A2)) (wcel (cop B2 (cfv B2 F)) F) $;

--| A function's value belongs to its range. (Contributed by NM, 14-Oct-1996.)
theorem fvelrn (A2 F: class):
  $ wi (wa (wfun F) (wcel A2 (cdm F))) (wcel (cfv A2 F) (crn F)) $;

--| A function value cannot be any element not contained in the range of the function. (Contributed by AV, 28-Jan-2020.)
theorem nelrnfvne (F X Y: class):
  $ wi (w3a (wfun F) (wcel X (cdm F)) (wnel Y (crn F))) (wne (cfv X F) Y) $;

--| If the empty set is not contained in the range of a function, and the function values of another class (not necessarily a function) are equal to the function values of the function for all elements of the domain of the function, then the domain of the function is contained in the domain of the class. (Contributed by AV, 28-Jan-2020.)
theorem fveqdmss {x3: setvar} (A2 B2 D: class):
  $ wceq D (cdm B2) $ >
  $ wi (w3a (wfun B2) (wnel c0 (crn B2)) (wral x3 (wceq (cfv (cv x3) A2) (cfv (cv x3) B2)) D)) (wss D (cdm A2)) $;

--| If the empty set is not contained in the range of a function, and the function values of another class (not necessarily a function) are equal to the function values of the function for all elements of the domain of the function, then the class restricted to the domain of the function is the function itself. (Contributed by AV, 28-Jan-2020.)
theorem fveqressseq {x3: setvar} (A2 B2 D: class):
  $ wceq D (cdm B2) $ >
  $ wi (w3a (wfun B2) (wnel c0 (crn B2)) (wral x3 (wceq (cfv (cv x3) A2) (cfv (cv x3) B2)) D)) (wceq (cres A2 D) B2) $;

--| A function's value belongs to its range. (Contributed by NM, 15-Oct-1996.)
theorem fnfvelrn (A2 B2 F: class):
  $ wi (wa (wfn F A2) (wcel B2 A2)) (wcel (cfv B2 F) (crn F)) $;

--| A function's value belongs to its codomain. (Contributed by NM, 12-Aug-1999.)
theorem ffvelcdm (A2 B2 C F: class):
  $ wi (wa (wf A2 B2 F) (wcel C A2)) (wcel (cfv C F) B2) $;

--| A function's value belongs to its range. (Contributed by Glauco Siliprandi, 2-Jan-2022.)
theorem fnfvelrnd (ph: wff) (A2 B2 F: class):
  $ wi ph (wfn F A2) $ >
  $ wi ph (wcel B2 A2) $ >
  $ wi ph (wcel (cfv B2 F) (crn F)) $;

--| A function's value belongs to its codomain. (Contributed by NM, 6-Apr-2005.)
theorem ffvelcdmi (A2 B2 C F: class):
  $ wf A2 B2 F $ >
  $ wi (wcel C A2) (wcel (cfv C F) B2) $;

--| A function's value belongs to its codomain. (Contributed by Mario Carneiro, 29-Dec-2016.)
theorem ffvelcdmda (ph: wff) (A2 B2 C F: class):
  $ wi ph (wf A2 B2 F) $ >
  $ wi (wa ph (wcel C A2)) (wcel (cfv C F) B2) $;

--| A function's value belongs to its codomain. (Contributed by Mario Carneiro, 29-Dec-2016.)
theorem ffvelcdmd (ph: wff) (A2 B2 C F: class):
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wcel C A2) $ >
  $ wi ph (wcel (cfv C F) B2) $;

--| A class is an element of the domain iff it's function value is an element of the codomain of a function. (Contributed by AV, 22-Apr-2025.)
theorem feldmfvelcdm (A2 B2 F X: class):
  $ wi (wa (wf A2 B2 F) (wnel c0 B2)) (wb (wcel X A2) (wcel (cfv X F) B2)) $;

--| Restricted existential quantification over the range of a function. (Contributed by Mario Carneiro, 24-Dec-2013.) (Revised by Mario Carneiro, 20-Aug-2014.)
theorem rexrn {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2 F: class):
  $ wi (wceq (cv x3) (cfv (cv y1) F)) (wb ph ps) $ >
  $ wi (wfn F A2) (wb (wrex x3 ph (crn F)) (wrex y1 ps A2)) $;

--| Restricted universal quantification over the range of a function. (Contributed by Mario Carneiro, 24-Dec-2013.) (Revised by Mario Carneiro, 20-Aug-2014.)
theorem ralrn {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2 F: class):
  $ wi (wceq (cv x3) (cfv (cv y1) F)) (wb ph ps) $ >
  $ wi (wfn F A2) (wb (wral x3 ph (crn F)) (wral y1 ps A2)) $;

--| For any element in the range of a function there is an element in the domain of the function for which the function value is the element of the range. (Contributed by Alexander van der Vekens, 8-Dec-2017.)
theorem elrnrexdm {x3: setvar} (F Y: class):
  $ wi (wfun F) (wi (wcel Y (crn F)) (wrex x3 (wceq Y (cfv (cv x3) F)) (cdm F))) $;

--| For any element in the range of a function there is an element in the domain of the function for which the function value is the element of the range. (Contributed by Alexander van der Vekens, 17-Dec-2017.)
theorem elrnrexdmb {x3: setvar} (F Y: class):
  $ wi (wfun F) (wb (wcel Y (crn F)) (wrex x3 (wceq Y (cfv (cv x3) F)) (cdm F))) $;

--| For any element in the domain of a function there is an element in the range of the function which is the function value for the element of the domain. (Contributed by Alexander van der Vekens, 8-Dec-2017.)
theorem eldmrexrn {x3: setvar} (F Y: class):
  $ wi (wfun F) (wi (wcel Y (cdm F)) (wrex x3 (wceq (cv x3) (cfv Y F)) (crn F))) $;

--| For any element in the domain of a function, there is an element in the range of the function which is the value of the function at that element. Because of the definition ~ df-fv of the value of a function, the theorem is only valid in general if the empty set is not contained in the range of the function (the implication "to the right" is always valid). Indeed, with the definition ~ df-fv of the value of a function, ` ( F `` Y ) = (/) ` may mean that the value of ` F ` at ` Y ` is the empty set or that ` F ` is not defined at ` Y ` . (Contributed by Alexander van der Vekens, 17-Dec-2017.)
theorem eldmrexrnb {x3: setvar} (F Y: class):
  $ wi (wa (wfun F) (wnel c0 (crn F))) (wb (wcel Y (cdm F)) (wrex x3 (wceq (cv x3) (cfv Y F)) (crn F))) $;

--| The values of two function compositions are equal if the values of the composed functions are pairwise equal. (Contributed by AV, 26-Jan-2019.)
theorem fvcofneq {x3: setvar} (A2 B2: class x3) (F G H K X: class):
  $ wi (wa (wfn G A2) (wfn K B2)) (wi (w3a (wcel X (cin A2 B2)) (wceq (cfv X G) (cfv X K)) (wral x3 (wceq (cfv (cv x3) F) (cfv (cv x3) H)) (cin (crn G) (crn K)))) (wceq (cfv X (ccom F G)) (cfv X (ccom H K)))) $;

--| A restricted quantifier over an image set. Version of ~ ralrnmpt with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by Mario Carneiro, 20-Aug-2015.) Avoid ~ ax-13 . (Revised by GG, 26-Jan-2024.)
theorem ralrnmptw {x3 y1: setvar} (ps: wff y1) (ch: wff x3) (A2: class y1) (B2 F: class x3) (V: class x3 y1):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wral x3 (wcel B2 V) A2) (wb (wral y1 ps (crn F)) (wral x3 ch A2)) $;

--| A restricted quantifier over an image set. Version of ~ rexrnmpt with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by Mario Carneiro, 20-Aug-2015.) Avoid ~ ax-13 . (Revised by GG, 26-Jan-2024.)
theorem rexrnmptw {x3 y1: setvar} (ps: wff y1) (ch: wff x3) (A2: class y1) (B2 F: class x3) (V: class x3 y1):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wral x3 (wcel B2 V) A2) (wb (wrex y1 ps (crn F)) (wrex x3 ch A2)) $;

--| A restricted quantifier over an image set. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ ralrnmptw when possible. (Contributed by Mario Carneiro, 20-Aug-2015.) (New usage is discouraged.)
theorem ralrnmpt {x3 y1: setvar} (ps: wff y1) (ch: wff x3) (A2: class y1) (B2 F: class x3) (V: class x3 y1):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wral x3 (wcel B2 V) A2) (wb (wral y1 ps (crn F)) (wral x3 ch A2)) $;

--| A restricted quantifier over an image set. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ rexrnmptw when possible. (Contributed by Mario Carneiro, 20-Aug-2015.) (New usage is discouraged.)
theorem rexrnmpt {x3 y1: setvar} (ps: wff y1) (ch: wff x3) (A2: class y1) (B2 F: class x3) (V: class x3 y1):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wral x3 (wcel B2 V) A2) (wb (wrex y1 ps (crn F)) (wrex x3 ch A2)) $;

--| Unconditional closure of a function when the codomain includes the empty set. (Contributed by Mario Carneiro, 12-Sep-2013.)
theorem f0cli (A2 B2 C F: class):
  $ wf A2 B2 F $ >
  $ wcel c0 B2 $ >
  $ wcel (cfv C F) B2 $;

--| Alternate definition of a mapping. (Contributed by NM, 14-Nov-2007.)
theorem dff2 (A2 B2 F: class):
  $ wb (wf A2 B2 F) (wa (wfn F A2) (wss F (cxp A2 B2))) $;

--| Alternate definition of a mapping. (Contributed by NM, 20-Mar-2007.)
theorem dff3 {x3 y1: setvar} (A2 B2 F: class):
  $ wb (wf A2 B2 F) (wa (wss F (cxp A2 B2)) (wral x3 (weu y1 (wbr (cv x3) (cv y1) F)) A2)) $;

--| Alternate definition of a mapping. (Contributed by NM, 20-Mar-2007.)
theorem dff4 {x3 y1: setvar} (A2 B2 F: class):
  $ wb (wf A2 B2 F) (wa (wss F (cxp A2 B2)) (wral x3 (wreu y1 (wbr (cv x3) (cv y1) F) B2) A2)) $;

--| An onto mapping expressed in terms of function values. (Contributed by NM, 29-Oct-2006.)
theorem dffo3 {x3 y1: setvar} (A2 B2 F: class):
  $ wb (wfo A2 B2 F) (wa (wf A2 B2 F) (wral y1 (wrex x3 (wceq (cv y1) (cfv (cv x3) F)) A2) B2)) $;

--| Alternate definition of an onto mapping. (Contributed by NM, 20-Mar-2007.)
theorem dffo4 {x3 y1: setvar} (A2 B2 F: class):
  $ wb (wfo A2 B2 F) (wa (wf A2 B2 F) (wral y1 (wrex x3 (wbr (cv x3) (cv y1) F) A2) B2)) $;

--| Alternate definition of an onto mapping. (Contributed by NM, 20-Mar-2007.)
theorem dffo5 {x3 y1: setvar} (A2 B2 F: class):
  $ wb (wfo A2 B2 F) (wa (wf A2 B2 F) (wral y1 (wex x3 (wbr (cv x3) (cv y1) F)) B2)) $;

--| A relation equivalent to the existence of an onto mapping. The right-hand ` f ` is not necessarily a function. (Contributed by NM, 20-Mar-2007.)
theorem exfo {x3 y1 f2: setvar} (A2 B2: class):
  $ wb (wex f2 (wfo A2 B2 (cv f2))) (wex f2 (wa (wral x3 (wreu y1 (wbr (cv x3) (cv y1) (cv f2)) B2) A2) (wral x3 (wrex y1 (wbr (cv y1) (cv x3) (cv f2)) A2) B2))) $;

--| An onto mapping expressed in terms of function values. As ~ dffo3 but with less disjoint vars constraints. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem dffo3f {x3 y1: setvar} (A2 B2: class) (F: class x3):
  $ wnfc x3 F $ >
  $ wb (wfo A2 B2 F) (wa (wf A2 B2 F) (wral y1 (wrex x3 (wceq (cv y1) (cfv (cv x3) F)) A2) B2)) $;

--| Property of a surjective function. (Contributed by Jeff Madsen, 4-Jan-2011.)
theorem foelrn {x3: setvar} (A2 B2 C F: class):
  $ wi (wa (wfo A2 B2 F) (wcel C B2)) (wrex x3 (wceq C (cfv (cv x3) F)) A2) $;

--| Property of a surjective function. As ~ foelrn but with less disjoint vars constraints. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem foelrnf {x3: setvar} (A2 B2 C: class) (F: class x3):
  $ wnfc x3 F $ >
  $ wi (wa (wfo A2 B2 F) (wcel C B2)) (wrex x3 (wceq C (cfv (cv x3) F)) A2) $;

--| If a composition of two functions is surjective, then the function on the left is surjective. (Contributed by Jeff Madsen, 16-Jun-2011.) (Proof shortened by JJ, 14-Jul-2021.)
theorem foco2 (A2 B2 C F G: class):
  $ wi (w3a (wf B2 C F) (wf A2 B2 G) (wfo A2 C (ccom F G))) (wfo B2 C F) $;

--| Functionality of the mapping operation. (Contributed by Mario Carneiro, 26-Jul-2013.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem fmpt {x3: setvar} (A2 B2: class) (C F: class x3):
  $ wceq F (cmpt x3 A2 C) $ >
  $ wb (wral x3 (wcel C B2) A2) (wf A2 B2 F) $;

--| Express bijection for a mapping operation. (Contributed by Mario Carneiro, 30-May-2015.) (Revised by Mario Carneiro, 4-Dec-2016.)
theorem f1ompt {x3 y1: setvar} (A2 B2: class) (C F: class x3):
  $ wceq F (cmpt x3 A2 C) $ >
  $ wb (wf1o A2 B2 F) (wa (wral x3 (wcel C B2) A2) (wral y1 (wreu x3 (wceq (cv y1) C) A2) B2)) $;

--| Functionality of the mapping operation. (Contributed by NM, 19-Mar-2005.) (Revised by Mario Carneiro, 1-Sep-2015.)
theorem fmpti {x3: setvar} (A2 B2: class) (C F: class x3):
  $ wceq F (cmpt x3 A2 C) $ >
  $ wi (wcel (cv x3) A2) (wcel C B2) $ >
  $ wf A2 B2 F $;

--| The value of a function at a point of its domain belongs to its codomain. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem fvmptelcdm {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3) (C: class):
  $ wi ph (wf A2 C (cmpt x3 A2 B2)) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 C) $;

--| Domain and codomain of the mapping operation; deduction form. (Contributed by Mario Carneiro, 13-Jan-2013.)
theorem fmptd {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (C: class) (F: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 C) $ >
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi ph (wf A2 C F) $;

--| Version of ~ fmptd with inlined definition. Domain and codomain of the mapping operation; deduction form. (Contributed by Glauco Siliprandi, 23-Oct-2021.) (Proof shortened by BJ, 16-Aug-2022.)
theorem fmpttd {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (C: class):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 C) $ >
  $ wi ph (wf A2 C (cmpt x3 A2 B2)) $;

--| Domain and codomain of the mapping operation; deduction form. (Contributed by Thierry Arnoux, 4-Jun-2017.)
theorem fmpt3d {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (C: class) (F: class x3):
  $ wi ph (wceq F (cmpt x3 A2 B2)) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 C) $ >
  $ wi ph (wf A2 C F) $;

--| A version of ~ fmptd using bound-variable hypothesis instead of a distinct variable condition for ` ph ` . (Contributed by Glauco Siliprandi, 29-Jun-2017.)
theorem fmptdf {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3) (C: class) (F: class x3):
  $ wnf x3 ph $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 C) $ >
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi ph (wf A2 C F) $;

--| Express being onto for a mapping operation. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem fompt {x3 y1: setvar} (A2 B2: class) (C F: class x3):
  $ wceq F (cmpt x3 A2 C) $ >
  $ wb (wfo A2 B2 F) (wa (wral x3 (wcel C B2) A2) (wral y1 (wrex x3 (wceq (cv y1) C) A2) B2)) $;

--| A function maps to a class to which all values belong. (Contributed by NM, 3-Dec-2003.)
theorem ffnfv {x3: setvar} (A2 B2 F: class):
  $ wb (wf A2 B2 F) (wa (wfn F A2) (wral x3 (wcel (cfv (cv x3) F) B2) A2)) $;

--| A function maps to a class to which all values belong. This version of ~ ffnfv uses bound-variable hypotheses instead of distinct variable conditions. (Contributed by NM, 28-Sep-2006.)
theorem ffnfvf {x3: setvar} (A2 B2 F: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 F $ >
  $ wb (wf A2 B2 F) (wa (wfn F A2) (wral x3 (wcel (cfv (cv x3) F) B2) A2)) $;

--| An upper bound for range determined by function values. (Contributed by NM, 8-Oct-2004.)
theorem fnfvrnss {x3: setvar} (A2 B2 F: class):
  $ wi (wa (wfn F A2) (wral x3 (wcel (cfv (cv x3) F) B2) A2)) (wss (crn F) B2) $;

--| A function is a function into a subset of its codomain if all of its values are elements of this subset. (Contributed by AV, 7-Feb-2021.)
theorem fcdmssb {k: setvar} (A2 F V: class) (W: class k):
  $ wi (wa (wss V W) (wral k (wcel (cfv (cv k) F) V) A2)) (wb (wf A2 W F) (wf A2 V F)) $;

--| The range of an operation given by the maps-to notation as a subset. (Contributed by Thierry Arnoux, 24-Sep-2017.)
theorem rnmptss {x3: setvar} (A2: class) (B2: class x3) (C: class) (F: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wral x3 (wcel B2 C) A2) (wss (crn F) C) $;

--| The range of a function given by the maps-to notation as a subset. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem rnmptssd {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3) (C: class) (F: class x3):
  $ wnf x3 ph $ >
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 C) $ >
  $ wi ph (wss (crn F) C) $;

--| Domain and codomain of the mapping operation; deduction form. (Contributed by NM, 27-Dec-2014.)
theorem fmpt2d {x3 y1: setvar} (ph: wff) (A2: class) (B2: class x3 y1) (C F: class x3) (V: class x3 y1):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi ph (wceq F (cmpt x3 A2 B2)) $ >
  $ wi (wa ph (wcel (cv y1) A2)) (wcel (cfv (cv y1) F) C) $ >
  $ wi ph (wf A2 C F) $;

--| Domain and codomain of the mapping operation; deduction form. (Contributed by NM, 27-Dec-2014.)
theorem fmpt2d_b {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (C F: class) (V: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi ph (wceq F (cmpt x3 A2 B2)) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel (cfv (cv x3) F) C) $ >
  $ wi ph (wf A2 C F) $;

--| A necessary and sufficient condition for a restricted function. (Contributed by Mario Carneiro, 14-Nov-2013.)
theorem ffvresb {x3: setvar} (A2 B2 F: class):
  $ wi (wfun F) (wb (wf A2 B2 (cres F A2)) (wral x3 (wa (wcel (cv x3) (cdm F)) (wcel (cfv (cv x3) F) B2)) A2)) $;

--| Restriction of a function to a subclass of its domain as a function with domain and codomain. (Contributed by AV, 13-May-2025.)
theorem fssrescdmd (ph: wff) (A2 B2 C D F: class):
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wss C A2) $ >
  $ wi ph (wss (cima F C) D) $ >
  $ wi ph (wf C D (cres F C)) $;

--| Build a bijection between restricted abstract builders, given a bijection between the base classes, deduction version. (Contributed by Thierry Arnoux, 17-Aug-2018.)
theorem f1oresrab {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (A2 B2: class) (C: class x3) (F: class x3 y1):
  $ wceq F (cmpt x3 A2 C) $ >
  $ wi ph (wf1o A2 B2 F) $ >
  $ wi (w3a ph (wcel (cv x3) A2) (wceq (cv y1) C)) (wb ch ps) $ >
  $ wi ph (wf1o (crab x3 ps A2) (crab y1 ch B2) (cres F (crab x3 ps A2))) $;

--| Restricting a bijection, which is a mapping from a restricted class abstraction, to a subset is a bijection. (Contributed by AV, 7-Aug-2022.)
theorem f1ossf1o {x3 y1 w: setvar} (ph: wff w) (ps: wff y1 w) (ch: wff w) (ta: wff y1 w) (A2: class y1) (B2: class x3 w) (C: class w) (F G: class x3 y1 w) (X: class y1 w) (Y: class w):
  $ wceq X (crab w (wa ps ch) A2) $ >
  $ wceq Y (crab w ps A2) $ >
  $ wceq F (cmpt x3 X B2) $ >
  $ wceq G (cmpt x3 Y B2) $ >
  $ wi ph (wf1o Y C G) $ >
  $ wi (w3a ph (wcel (cv x3) Y) (wceq (cv y1) B2)) (wb ta (wsb w ch x3)) $ >
  $ wi ph (wf1o X (crab y1 ta C) F) $;

--| Composition of two functions expressed as ordered-pair class abstractions. If ` F ` has the equation ` ( x + 2 ) ` and ` G ` the equation ` ( 3 * z ) ` then ` ( G o. F ) ` has the equation ` ( 3 * ( x + 2 ) ) ` . (Contributed by FL, 21-Jun-2012.) (Revised by Mario Carneiro, 24-Jul-2014.)
theorem fmptco {x3 y1: setvar} (ph: wff y1) (A2: class y1) (B2: class) (R: class x3) (S: class y1) (T: class x3) (F G: class x3 y1):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel R B2) $ >
  $ wi ph (wceq F (cmpt x3 A2 R)) $ >
  $ wi ph (wceq G (cmpt y1 B2 S)) $ >
  $ wi (wceq (cv y1) R) (wceq S T) $ >
  $ wi ph (wceq (ccom G F) (cmpt x3 A2 T)) $;

--| Version of ~ fmptco where ` ph ` needn't be distinct from ` x ` . (Contributed by NM, 27-Dec-2014.)
theorem fmptcof {x3 y1: setvar} (ph: wff x3 y1) (A2: class y1) (B2: class) (R: class x3) (S: class y1) (T: class x3) (F G: class x3 y1):
  $ wi ph (wral x3 (wcel R B2) A2) $ >
  $ wi ph (wceq F (cmpt x3 A2 R)) $ >
  $ wi ph (wceq G (cmpt y1 B2 S)) $ >
  $ wi (wceq (cv y1) R) (wceq S T) $ >
  $ wi ph (wceq (ccom G F) (cmpt x3 A2 T)) $;

--| Composition of two functions expressed as mapping abstractions. (Contributed by NM, 22-May-2006.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem fmptcos {x3 y1: setvar} (ph: wff x3 y1) (A2: class y1) (B2: class) (R: class x3) (S: class y1) (F G: class x3 y1):
  $ wi ph (wral x3 (wcel R B2) A2) $ >
  $ wi ph (wceq F (cmpt x3 A2 R)) $ >
  $ wi ph (wceq G (cmpt y1 B2 S)) $ >
  $ wi ph (wceq (ccom G F) (cmpt x3 A2 (csb y1 R S))) $;

--| Express composition of a maps-to function with another function in a maps-to notation. (Contributed by Thierry Arnoux, 29-Jun-2017.)
theorem cofmpt {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (C: class) (D: class x3) (F: class):
  $ wi ph (wf C D F) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 C) $ >
  $ wi ph (wceq (ccom F (cmpt x3 A2 B2)) (cmpt x3 A2 (cfv B2 F))) $;

--| Express composition of two functions as a maps-to applying both in sequence. (Contributed by Stefan O'Rear, 5-Oct-2014.) (Proof shortened by Mario Carneiro, 27-Dec-2014.)
theorem fcompt {x3: setvar} (A2 B2 C D E: class):
  $ wi (wa (wf D E A2) (wf C D B2)) (wceq (ccom A2 B2) (cmpt x3 C (cfv (cfv (cv x3) B2) A2))) $;

--| Composition with a constant function. (Contributed by Stefan O'Rear, 11-Mar-2015.)
theorem fcoconst (F I X Y: class):
  $ wi (wa (wfn F X) (wcel Y X)) (wceq (ccom F (cxp I (csn Y))) (cxp I (csn (cfv Y F)))) $;

--| A function maps a singleton to a singleton iff it is the singleton of an ordered pair. (Contributed by NM, 10-Dec-2003.)
theorem fsn (A2 B2 F: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wb (wf (csn A2) (csn B2) F) (wceq F (csn (cop A2 B2))) $;

--| A function that maps a singleton to a class is the singleton of an ordered pair. (Contributed by NM, 19-May-2004.)
theorem fsn2 (A2 B2 F: class):
  $ wcel A2 cvv $ >
  $ wb (wf (csn A2) B2 F) (wa (wcel (cfv A2 F) B2) (wceq F (csn (cop A2 (cfv A2 F))))) $;

--| A function maps a singleton to a singleton iff it is the singleton of an ordered pair. (Contributed by NM, 26-Oct-2012.)
theorem fsng (A2 B2 C D F: class):
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wb (wf (csn A2) (csn B2) F) (wceq F (csn (cop A2 B2)))) $;

--| A function that maps a singleton to a class is the singleton of an ordered pair. (Contributed by Thierry Arnoux, 11-Jul-2020.)
theorem fsn2g (A2 B2 F V: class):
  $ wi (wcel A2 V) (wb (wf (csn A2) B2 F) (wa (wcel (cfv A2 F) B2) (wceq F (csn (cop A2 (cfv A2 F)))))) $;

--| The Cartesian product of two singletons is the singleton consisting in the associated ordered pair. (Contributed by Mario Carneiro, 30-Apr-2015.)
theorem xpsng (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wceq (cxp (csn A2) (csn B2)) (csn (cop A2 B2))) $;

--| The Cartesian product of two singletons is the singleton consisting in the associated ordered pair. (Contributed by NM, 4-Nov-2006.)
theorem xpsn (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq (cxp (csn A2) (csn B2)) (csn (cop A2 B2)) $;

--| The Cartesian product of an unordered pair and a singleton. (Contributed by AV, 20-May-2019.)
theorem xpprsng (A2 B2 C U V W: class):
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel C U)) (wceq (cxp (cpr A2 B2) (csn C)) (cpr (cop A2 C) (cop B2 C))) $;

--| The Cartesian product of a singleton and an unordered pair. (Contributed by AV, 21-Aug-2026.)
theorem xpsnprg (A2 B2 C U V W: class):
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel C U)) (wceq (cxp (csn A2) (cpr B2 C)) (cpr (cop A2 B2) (cop A2 C))) $;

--| The Cartesian product of a singleton and an unordered triple. (Contributed by AV, 18-Aug-2026.)
theorem xpsntpg (A2 B2 C D T U V W: class):
  $ wi (wa (wa (wcel A2 V) (wcel B2 W)) (wa (wcel C U) (wcel D T))) (wceq (cxp (csn A2) (ctp B2 C D)) (ctp (cop A2 B2) (cop A2 C) (cop A2 D))) $;

--| A singleton consisting in a nested ordered pair is a one-to-one function from the cartesian product of two singletons onto a singleton (case where the two singletons are equal). (Contributed by AV, 15-Aug-2019.)
theorem f1o2sn (E V W X: class):
  $ wi (wa (wcel E V) (wcel X W)) (wf1o (cxp (csn E) (csn E)) (csn X) (csn (cop (cop E E) X))) $;

--| Restriction of the identity to a pair. (Contributed by AV, 11-Dec-2018.)
theorem residpr (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wceq (cres cid (cpr A2 B2)) (cpr (cop A2 A2) (cop B2 B2))) $;

--| Alternate definition for the maps-to notation ~ df-mpt (although it requires that ` B ` be a set). (Contributed by NM, 24-Aug-2010.) (Revised by Mario Carneiro, 30-Dec-2016.)
theorem dfmpt {x3: setvar} (A2 B2: class x3):
  $ wcel B2 cvv $ >
  $ wceq (cmpt x3 A2 B2) (ciun x3 A2 (csn (cop (cv x3) B2))) $;

--| A function expressed as the range of another function. (Contributed by Mario Carneiro, 22-Jun-2013.) (Proof shortened by Mario Carneiro, 31-Aug-2015.)
theorem fnasrn {x3: setvar} (A2 B2: class x3):
  $ wcel B2 cvv $ >
  $ wceq (cmpt x3 A2 B2) (crn (cmpt x3 A2 (cop (cv x3) B2))) $;

--| Two ways to state that a relation is reflexive on a class. (Contributed by FL, 15-Jan-2012.) (Proof shortened by Mario Carneiro, 3-Nov-2015.) (Revised by NM, 30-Mar-2016.)
theorem idref {x3: setvar} (A2 R: class):
  $ wb (wss (cres cid A2) R) (wral x3 (wbr (cv x3) (cv x3) R) A2) $;

--| A function is a union of singletons of ordered pairs indexed by its domain. (Contributed by AV, 18-Sep-2020.)
theorem funiun {x3: setvar} (F: class):
  $ wi (wfun F) (wceq F (ciun x3 (cdm F) (csn (cop (cv x3) (cfv (cv x3) F))))) $;

--| If a function is an ordered pair then it is a singleton of an ordered pair. (Contributed by AV, 20-Sep-2020.) (Proof shortened by AV, 15-Jul-2021.) (Proof shortened by Eric Schmidt, 9-May-2026.) A function is a class of ordered pairs, so the fact that an ordered pair may sometimes be itself a function is an "accident" depending on the specific encoding of ordered pairs as classes (in set.mm, the Kuratowski encoding). A more meaningful statement is ~ funsng , as ~ relsnopg is to ~ relop . (New usage is discouraged.)
theorem funopsn {a: setvar} (F X Y: class):
  $ wcel X cvv $ >
  $ wcel Y cvv $ >
  $ wi (wa (wfun F) (wceq F (cop X Y))) (wex a (wa (wceq X (csn (cv a))) (wceq F (csn (cop (cv a) (cv a)))))) $;

--| Obsolete version of ~ funopsn as of 9-May-2026. (Contributed by AV, 20-Sep-2020.) (Proof shortened by AV, 15-Jul-2021.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem funopsnOLD {a: setvar} (F X Y: class):
  $ wcel X cvv $ >
  $ wcel Y cvv $ >
  $ wi (wa (wfun F) (wceq F (cop X Y))) (wex a (wa (wceq X (csn (cv a))) (wceq F (csn (cop (cv a) (cv a)))))) $;

--| An ordered pair is a function iff it is a singleton of an ordered pair. (Contributed by AV, 20-Sep-2020.) A function is a class of ordered pairs, so the fact that an ordered pair may sometimes be itself a function is an "accident" depending on the specific encoding of ordered pairs as classes (in set.mm, the Kuratowski encoding). A more meaningful statement is ~ funsng , as ~ relsnopg is to ~ relop . (New usage is discouraged.)
theorem funop {a: setvar} (X Y: class):
  $ wcel X cvv $ >
  $ wcel Y cvv $ >
  $ wb (wfun (cop X Y)) (wex a (wa (wceq X (csn (cv a))) (wceq (cop X Y) (csn (cop (cv a) (cv a)))))) $;

--| The domain of a function which is an ordered pair is a singleton. (Contributed by AV, 15-Nov-2021.) (Avoid depending on this detail.)
theorem funopdmsn (A2 B2 G V W X Y: class):
  $ wceq G (cop X Y) $ >
  $ wcel X V $ >
  $ wcel Y W $ >
  $ wi (w3a (wfun G) (wcel A2 (cdm G)) (wcel B2 (cdm G))) (wceq A2 B2) $;

--| A singleton of an ordered pair is not an ordered pair if the components are different. (Contributed by AV, 23-Sep-2020.) (Avoid depending on this detail.)
theorem funsndifnop (A2 B2 G: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq G (csn (cop A2 B2)) $ >
  $ wi (wne A2 B2) (wn (wcel G (cxp cvv cvv))) $;

--| A singleton of an ordered pair is an ordered pair iff the components are equal. (Contributed by AV, 24-Sep-2020.) (Avoid depending on this detail.)
theorem funsneqopb (A2 B2 G: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq G (csn (cop A2 B2)) $ >
  $ wb (wceq A2 B2) (wcel G (cxp cvv cvv)) $;

--| If ` A ` is not in ` C ` , then the restriction of a singleton of ` <. A , B >. ` to ` C ` is null. (Contributed by Scott Fenton, 15-Apr-2011.)
theorem ressnop0 (A2 B2 C: class):
  $ wi (wn (wcel A2 C)) (wceq (cres (csn (cop A2 B2)) C) c0) $;

--| A function with a domain of two elements. (Contributed by Jeff Madsen, 20-Jun-2010.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem fpr (A2 B2 C D: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wcel D cvv $ >
  $ wi (wne A2 B2) (wf (cpr A2 B2) (cpr C D) (cpr (cop A2 C) (cop B2 D))) $;

--| A function with a domain of two elements. (Contributed by FL, 2-Feb-2014.)
theorem fprg (A2 B2 C D E F G H: class):
  $ wi (w3a (wa (wcel A2 E) (wcel B2 F)) (wa (wcel C G) (wcel D H)) (wne A2 B2)) (wf (cpr A2 B2) (cpr C D) (cpr (cop A2 C) (cop B2 D))) $;

--| A function with a domain of three elements. (Contributed by Alexander van der Vekens, 4-Dec-2017.)
theorem ftpg (A2 B2 C U F G H V W X Y Z: class):
  $ wi (w3a (w3a (wcel X U) (wcel Y V) (wcel Z W)) (w3a (wcel A2 F) (wcel B2 G) (wcel C H)) (w3a (wne X Y) (wne X Z) (wne Y Z))) (wf (ctp X Y Z) (ctp A2 B2 C) (ctp (cop X A2) (cop Y B2) (cop Z C))) $;

--| A function with a domain of three elements. (Contributed by Stefan O'Rear, 17-Oct-2014.) (Proof shortened by Alexander van der Vekens, 23-Jan-2018.)
theorem ftp (A2 B2 C X Y Z: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wcel X cvv $ >
  $ wcel Y cvv $ >
  $ wcel Z cvv $ >
  $ wne A2 B2 $ >
  $ wne A2 C $ >
  $ wne B2 C $ >
  $ wf (ctp A2 B2 C) (ctp X Y Z) (ctp (cop A2 X) (cop B2 Y) (cop C Z)) $;

--| A function restricted to a singleton. (Contributed by NM, 9-Oct-2004.)
theorem fnressn (A2 B2 F: class):
  $ wi (wa (wfn F A2) (wcel B2 A2)) (wceq (cres F (csn B2)) (csn (cop B2 (cfv B2 F)))) $;

--| A function restricted to a singleton. (Contributed by Mario Carneiro, 16-Nov-2014.)
theorem funressn (B2 F: class):
  $ wi (wfun F) (wss (cres F (csn B2)) (csn (cop B2 (cfv B2 F)))) $;

--| The value of a function restricted to a singleton. (Contributed by NM, 9-Oct-2004.)
theorem fressnfv (A2 B2 C F: class):
  $ wi (wa (wfn F A2) (wcel B2 A2)) (wb (wf (csn B2) C (cres F (csn B2))) (wcel (cfv B2 F) C)) $;

--| If the value of a function is in the range of the function restricted to the singleton containing the argument, then the value of the function is in the range of the function. (Contributed by Alexander van der Vekens, 22-Jul-2018.)
theorem fvrnressn (F V X: class):
  $ wi (wcel X V) (wi (wcel (cfv X F) (crn (cres F (csn X)))) (wcel (cfv X F) (crn F))) $;

--| The value of a function restricted to the singleton containing the argument equals the value of the function for this argument. (Contributed by Alexander van der Vekens, 22-Jul-2018.)
theorem fvressn (F V X: class):
  $ wi (wcel X V) (wceq (cfv X (cres F (csn X))) (cfv X F)) $;

--| The value of a constant function. (Contributed by NM, 30-May-1999.)
theorem fvconst (A2 B2 C F: class):
  $ wi (wa (wf A2 (csn B2) F) (wcel C A2)) (wceq (cfv C F) B2) $;

--| If a class belongs to a function on a singleton, then that class is the obvious ordered pair. Note that this theorem also holds when ` A ` is a proper class, but its meaning is then different. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (Proof shortened by Mario Carneiro, 22-Dec-2016.)
theorem fnsnr (A2 B2 F: class):
  $ wi (wfn F (csn A2)) (wi (wcel B2 F) (wceq B2 (cop A2 (cfv A2 F)))) $;

--| A function's domain is a singleton iff the function is a singleton. (Contributed by Steven Nguyen, 18-Aug-2023.) Relax condition for being in the universal class. (Revised by Zhi Wang, 21-Oct-2025.)
theorem fnsnbg (A2 F V: class):
  $ wi (wcel A2 V) (wb (wfn F (csn A2)) (wceq F (csn (cop A2 (cfv A2 F))))) $;

--| A function whose domain is a singleton can be represented as a singleton of an ordered pair. (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) Revised to add reverse implication. (Revised by NM, 29-Dec-2018.) (Proof shortened by Zhi Wang, 21-Oct-2025.)
theorem fnsnb (A2 F: class):
  $ wcel A2 cvv $ >
  $ wb (wfn F (csn A2)) (wceq F (csn (cop A2 (cfv A2 F)))) $;

--| Express a singleton function in maps-to notation. (Contributed by NM, 6-Jun-2006.) (Proof shortened by Andrew Salmon, 22-Oct-2011.) (Revised by Stefan O'Rear, 28-Feb-2015.)
theorem fmptsn {x3: setvar} (A2 B2: class) (V W: class x3):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wceq (csn (cop A2 B2)) (cmpt x3 (csn A2) B2)) $;

--| Express a singleton function in maps-to notation. Version of ~ fmptsn allowing the value ` B ` to depend on the variable ` x ` . (Contributed by AV, 27-Feb-2019.)
theorem fmptsng {x3: setvar} (A2: class) (B2: class x3) (C: class) (V W: class x3):
  $ wi (wceq (cv x3) A2) (wceq B2 C) $ >
  $ wi (wa (wcel A2 V) (wcel C W)) (wceq (csn (cop A2 C)) (cmpt x3 (csn A2) B2)) $;

--| Express a singleton function in maps-to notation. Deduction form of ~ fmptsng . (Contributed by AV, 4-Aug-2019.)
theorem fmptsnd {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (C: class) (V W: class x3):
  $ wi (wa ph (wceq (cv x3) A2)) (wceq B2 C) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel C W) $ >
  $ wi ph (wceq (csn (cop A2 C)) (cmpt x3 (csn A2) B2)) $;

--| Append an additional value to a function. (Contributed by NM, 6-Jun-2006.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem fmptap {x3: setvar} (A2 B2: class) (C: class x3) (R S: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq (cun R (csn A2)) S $ >
  $ wi (wceq (cv x3) A2) (wceq C B2) $ >
  $ wceq (cun (cmpt x3 R C) (csn (cop A2 B2))) (cmpt x3 S C) $;

--| Append an additional value to a function. (Contributed by Thierry Arnoux, 3-Jan-2017.) (Revised by AV, 10-Aug-2024.)
theorem fmptapd {x3: setvar} (ph: wff) (A2 B2: class) (C: class x3) (R S: class) (V W: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wceq (cun R (csn A2)) S) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wceq C B2) $ >
  $ wi ph (wceq (cun (cmpt x3 R C) (csn (cop A2 B2))) (cmpt x3 S C)) $;

--| Express a pair function in maps-to notation. (Contributed by Thierry Arnoux, 3-Jan-2017.)
theorem fmptpr {x3: setvar} (ph: wff) (A2 B2 C D: class) (E V W X Y: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel C X) $ >
  $ wi ph (wcel D Y) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wceq E C) $ >
  $ wi (wa ph (wceq (cv x3) B2)) (wceq E D) $ >
  $ wi ph (wceq (cpr (cop A2 C) (cop B2 D)) (cmpt x3 (cpr A2 B2) E)) $;

--| The value of a restricted identity function. (Contributed by NM, 19-May-2004.)
theorem fvresi (A2 B2: class):
  $ wi (wcel B2 A2) (wceq (cfv B2 (cres cid A2)) B2) $;

--| Express the class of fixed points of a function. (Contributed by Stefan O'Rear, 1-Feb-2015.)
theorem fninfp {x3: setvar} (A2 F: class):
  $ wi (wfn F A2) (wceq (cdm (cin F cid)) (crab x3 (wceq (cfv (cv x3) F) (cv x3)) A2)) $;

--| Property of a fixed point of a function. (Contributed by Stefan O'Rear, 1-Feb-2015.)
theorem fnelfp (A2 F X: class):
  $ wi (wa (wfn F A2) (wcel X A2)) (wb (wcel X (cdm (cin F cid))) (wceq (cfv X F) X)) $;

--| Express the class of non-fixed points of a function. (Contributed by Stefan O'Rear, 14-Aug-2015.)
theorem fndifnfp {x3: setvar} (A2 F: class):
  $ wi (wfn F A2) (wceq (cdm (cdif F cid)) (crab x3 (wne (cfv (cv x3) F) (cv x3)) A2)) $;

--| Property of a non-fixed point of a function. (Contributed by Stefan O'Rear, 15-Aug-2015.)
theorem fnelnfp (A2 F X: class):
  $ wi (wa (wfn F A2) (wcel X A2)) (wb (wcel X (cdm (cdif F cid))) (wne (cfv X F) X)) $;

--| A function is the identity iff it moves no points. (Contributed by Stefan O'Rear, 25-Aug-2015.)
theorem fnnfpeq0 (A2 F: class):
  $ wi (wfn F A2) (wb (wceq (cdm (cdif F cid)) c0) (wceq F (cres cid A2))) $;

--| Remove an ordered pair not participating in a function value. (Contributed by NM, 1-Oct-2013.) (Revised by Mario Carneiro, 28-May-2014.)
theorem fvunsn (A2 B2 C D: class):
  $ wi (wne B2 D) (wceq (cfv D (cun A2 (csn (cop B2 C)))) (cfv D A2)) $;

--| The value of a singleton of an ordered pair is the second member. (Contributed by NM, 26-Oct-2012.) (Proof shortened by BJ, 25-Feb-2023.)
theorem fvsng (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wceq (cfv A2 (csn (cop A2 B2))) B2) $;

--| The value of a singleton of an ordered pair is the second member. (Contributed by NM, 12-Aug-1994.) (Proof shortened by BJ, 25-Feb-2023.)
theorem fvsn (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq (cfv A2 (csn (cop A2 B2))) B2 $;

--| The value of a function with one of its ordered pairs replaced, at the replaced ordered pair. See also ~ fvsnun2 . (Contributed by NM, 23-Sep-2007.) Put in deduction form. (Revised by BJ, 25-Feb-2023.)
theorem fvsnun1 (ph: wff) (A2 B2 C F G V W: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wceq G (cun (csn (cop A2 B2)) (cres F (cdif C (csn A2)))) $ >
  $ wi ph (wceq (cfv A2 G) B2) $;

--| The value of a function with one of its ordered pairs replaced, at arguments other than the replaced one. See also ~ fvsnun1 . (Contributed by NM, 23-Sep-2007.) Put in deduction form. (Revised by BJ, 25-Feb-2023.)
theorem fvsnun2 (ph: wff) (A2 B2 C D F G V W: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wceq G (cun (csn (cop A2 B2)) (cres F (cdif C (csn A2)))) $ >
  $ wi ph (wcel D (cdif C (csn A2))) $ >
  $ wi ph (wceq (cfv D G) (cfv D F)) $;

--| Split a function into a single point and all the rest. (Contributed by Stefan O'Rear, 27-Feb-2015.)
theorem fnsnsplit (A2 F X: class):
  $ wi (wa (wfn F A2) (wcel X A2)) (wceq F (cun (cres F (cdif A2 (csn X))) (csn (cop X (cfv X F))))) $;

--| Adjoining a point to a function gives a function. (Contributed by Stefan O'Rear, 28-Feb-2015.)
theorem fsnunf (S T F V X Y: class):
  $ wi (w3a (wf S T F) (wa (wcel X V) (wn (wcel X S))) (wcel Y T)) (wf (cun S (csn X)) T (cun F (csn (cop X Y)))) $;

--| Adjoining a point to a punctured function gives a function. (Contributed by Stefan O'Rear, 28-Feb-2015.)
theorem fsnunf2 (S T F X Y: class):
  $ wi (w3a (wf (cdif S (csn X)) T F) (wcel X S) (wcel Y T)) (wf S T (cun F (csn (cop X Y)))) $;

--| Recover the added point from a point-added function. (Contributed by Stefan O'Rear, 28-Feb-2015.) (Revised by NM, 18-May-2017.)
theorem fsnunfv (F V W X Y: class):
  $ wi (w3a (wcel X V) (wcel Y W) (wn (wcel X (cdm F)))) (wceq (cfv X (cun F (csn (cop X Y)))) Y) $;

--| Recover the original function from a point-added function. (Contributed by Stefan O'Rear, 28-Feb-2015.)
theorem fsnunres (S F X Y: class):
  $ wi (wa (wfn F S) (wn (wcel X S))) (wceq (cres (cun F (csn (cop X Y))) S) F) $;

--| Restricting a function to a domain without one element of the domain of the function, and adding a pair of this element and the function value of the element results in the function itself. (Contributed by AV, 2-Dec-2018.)
theorem funresdfunsn (F X: class):
  $ wi (wa (wfun F) (wcel X (cdm F))) (wceq (cun (cres F (cdif cvv (csn X))) (csn (cop X (cfv X F)))) F) $;

--| The value of a function with a domain of (at most) two elements. (Contributed by Alexander van der Vekens, 3-Dec-2017.)
theorem fvpr1g (A2 B2 C D V W: class):
  $ wi (w3a (wcel A2 V) (wcel C W) (wne A2 B2)) (wceq (cfv A2 (cpr (cop A2 C) (cop B2 D))) C) $;

--| The value of a function with a domain of (at most) two elements. (Contributed by Alexander van der Vekens, 3-Dec-2017.) (Proof shortened by BJ, 26-Sep-2024.)
theorem fvpr2g (A2 B2 C D V W: class):
  $ wi (w3a (wcel B2 V) (wcel D W) (wne A2 B2)) (wceq (cfv B2 (cpr (cop A2 C) (cop B2 D))) D) $;

--| The value of a function with a domain of two elements. (Contributed by Jeff Madsen, 20-Jun-2010.) (Proof shortened by BJ, 26-Sep-2024.)
theorem fvpr1 (A2 B2 C D: class):
  $ wcel A2 cvv $ >
  $ wcel C cvv $ >
  $ wi (wne A2 B2) (wceq (cfv A2 (cpr (cop A2 C) (cop B2 D))) C) $;

--| The value of a function with a domain of two elements. (Contributed by Jeff Madsen, 20-Jun-2010.) (Proof shortened by BJ, 26-Sep-2024.)
theorem fvpr2 (A2 B2 C D: class):
  $ wcel B2 cvv $ >
  $ wcel D cvv $ >
  $ wi (wne A2 B2) (wceq (cfv B2 (cpr (cop A2 C) (cop B2 D))) D) $;

--| A condition for functionhood over a pair. (Contributed by Scott Fenton, 16-Sep-2013.)
theorem fprb {x3 y1: setvar} (A2 B2 R F: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wne A2 B2) (wb (wf (cpr A2 B2) R F) (wrex x3 (wrex y1 (wceq F (cpr (cop A2 (cv x3)) (cop B2 (cv y1)))) R) R)) $;

--| The first value of a function with a domain of three elements. (Contributed by NM, 14-Sep-2011.)
theorem fvtp1 (A2 B2 C D E F: class):
  $ wcel A2 cvv $ >
  $ wcel D cvv $ >
  $ wi (wa (wne A2 B2) (wne A2 C)) (wceq (cfv A2 (ctp (cop A2 D) (cop B2 E) (cop C F))) D) $;

--| The second value of a function with a domain of three elements. (Contributed by NM, 14-Sep-2011.)
theorem fvtp2 (A2 B2 C D E F: class):
  $ wcel B2 cvv $ >
  $ wcel E cvv $ >
  $ wi (wa (wne A2 B2) (wne B2 C)) (wceq (cfv B2 (ctp (cop A2 D) (cop B2 E) (cop C F))) E) $;

--| The third value of a function with a domain of three elements. (Contributed by NM, 14-Sep-2011.)
theorem fvtp3 (A2 B2 C D E F: class):
  $ wcel C cvv $ >
  $ wcel F cvv $ >
  $ wi (wa (wne A2 C) (wne B2 C)) (wceq (cfv C (ctp (cop A2 D) (cop B2 E) (cop C F))) F) $;

--| The value of a function with a domain of (at most) three elements. (Contributed by Alexander van der Vekens, 4-Dec-2017.)
theorem fvtp1g (A2 B2 C D E F V W: class):
  $ wi (wa (wa (wcel A2 V) (wcel D W)) (wa (wne A2 B2) (wne A2 C))) (wceq (cfv A2 (ctp (cop A2 D) (cop B2 E) (cop C F))) D) $;

--| The value of a function with a domain of (at most) three elements. (Contributed by Alexander van der Vekens, 4-Dec-2017.)
theorem fvtp2g (A2 B2 C D E F V W: class):
  $ wi (wa (wa (wcel B2 V) (wcel E W)) (wa (wne A2 B2) (wne B2 C))) (wceq (cfv B2 (ctp (cop A2 D) (cop B2 E) (cop C F))) E) $;

--| The value of a function with a domain of (at most) three elements. (Contributed by Alexander van der Vekens, 4-Dec-2017.)
theorem fvtp3g (A2 B2 C D E F V W: class):
  $ wi (wa (wa (wcel C V) (wcel F W)) (wa (wne A2 C) (wne B2 C))) (wceq (cfv C (ctp (cop A2 D) (cop B2 E) (cop C F))) F) $;

--| The undefined value of a function with a domain of three elements. (Contributed by AV, 18-Aug-2026.)
theorem fvtp0 (A2 B2 C D E F X: class):
  $ wcel D cvv $ >
  $ wcel E cvv $ >
  $ wcel F cvv $ >
  $ wcel X cvv $ >
  $ wi (w3a (wne X A2) (wne X B2) (wne X C)) (wceq (cfv X (ctp (cop A2 D) (cop B2 E) (cop C F))) c0) $;

--| An unordered triple of ordered pairs restricted to all but one first components of the pairs is an unordered pair of ordered pairs. (Contributed by AV, 14-Mar-2020.)
theorem tpres (ph: wff) (A2 B2 C D T E F V: class):
  $ wi ph (wceq T (ctp (cop A2 D) (cop B2 E) (cop C F))) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wcel E V) $ >
  $ wi ph (wcel F V) $ >
  $ wi ph (wne B2 A2) $ >
  $ wi ph (wne C A2) $ >
  $ wi ph (wceq (cres T (cdif cvv (csn A2))) (cpr (cop B2 E) (cop C F))) $;

--| The value of a constant function. (Contributed by NM, 20-Aug-2005.)
theorem fvconst2g (A2 B2 C D: class):
  $ wi (wa (wcel B2 D) (wcel C A2)) (wceq (cfv C (cxp A2 (csn B2))) B2) $;

--| A constant function expressed as a Cartesian product. (Contributed by NM, 27-Nov-2007.)
theorem fconst2g (A2 B2 C F: class):
  $ wi (wcel B2 C) (wb (wf A2 (csn B2) F) (wceq F (cxp A2 (csn B2)))) $;

--| The value of a constant function. (Contributed by NM, 16-Apr-2005.)
theorem fvconst2 (A2 B2 C: class):
  $ wcel B2 cvv $ >
  $ wi (wcel C A2) (wceq (cfv C (cxp A2 (csn B2))) B2) $;

--| A constant function expressed as a Cartesian product. (Contributed by NM, 20-Aug-1999.)
theorem fconst2 (A2 B2 F: class):
  $ wcel B2 cvv $ >
  $ wb (wf A2 (csn B2) F) (wceq F (cxp A2 (csn B2))) $;

--| Two ways to express that a function is constant. (Contributed by NM, 27-Nov-2007.)
theorem fconst5 (A2 B2 F: class):
  $ wi (wa (wfn F A2) (wne A2 c0)) (wb (wceq F (cxp A2 (csn B2))) (wceq (crn F) (csn B2))) $;

--| Range of a constant function in maps-to notation. (Contributed by Glauco Siliprandi, 11-Dec-2019.) Remove extra hypothesis. (Revised by SN, 17-Apr-2024.)
theorem rnmptc {x3: setvar} (ph: wff x3) (A2 B2: class) (F: class x3):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi ph (wne A2 c0) $ >
  $ wi ph (wceq (crn F) (csn B2)) $;

--| A function whose domain has at most two elements can be represented as a set of at most two ordered pairs. (Contributed by FL, 26-Jun-2011.) (Proof shortened by Scott Fenton, 12-Oct-2017.) Eliminate unnecessary antecedent ` A =/= B ` . (Revised by NM, 29-Dec-2018.)
theorem fnprb (A2 B2 F: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wb (wfn F (cpr A2 B2)) (wceq F (cpr (cop A2 (cfv A2 F)) (cop B2 (cfv B2 F)))) $;

--| A function whose domain has at most three elements can be represented as a set of at most three ordered pairs. (Contributed by AV, 26-Jan-2021.)
theorem fntpb (A2 B2 C F: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wb (wfn F (ctp A2 B2 C)) (wceq F (ctp (cop A2 (cfv A2 F)) (cop B2 (cfv B2 F)) (cop C (cfv C F)))) $;

--| A function whose domain has at most two elements can be represented as a set of at most two ordered pairs. (Contributed by Thierry Arnoux, 12-Jul-2020.)
theorem fnpr2g (A2 B2 F V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wfn F (cpr A2 B2)) (wceq F (cpr (cop A2 (cfv A2 F)) (cop B2 (cfv B2 F))))) $;

--| A function that maps a pair to a class is a pair of ordered pairs. (Contributed by Thierry Arnoux, 12-Jul-2020.)
theorem fpr2g (A2 B2 C F V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wf (cpr A2 B2) C F) (w3a (wcel (cfv A2 F) C) (wcel (cfv B2 F) C) (wceq F (cpr (cop A2 (cfv A2 F)) (cop B2 (cfv B2 F)))))) $;

--| A constant function expressed in terms of its functionality, domain, and value. See also ~ fconst2 . (Contributed by NM, 27-Aug-2004.) (Proof shortened by OpenAI, 25-Mar-2020.)
theorem fconstfv {x3: setvar} (A2 B2 F: class):
  $ wb (wf A2 (csn B2) F) (wa (wfn F A2) (wral x3 (wceq (cfv (cv x3) F) B2) A2)) $;

--| Two ways to express a constant function. (Contributed by NM, 15-Mar-2007.)
theorem fconst3 (A2 B2 F: class):
  $ wb (wf A2 (csn B2) F) (wa (wfn F A2) (wss A2 (cima (ccnv F) (csn B2)))) $;

--| Two ways to express a constant function. (Contributed by NM, 8-Mar-2007.)
theorem fconst4 (A2 B2 F: class):
  $ wb (wf A2 (csn B2) F) (wa (wfn F A2) (wceq (cima (ccnv F) (csn B2)) A2)) $;

--| The restriction of a function to a set exists. Compare Proposition 6.17 of [TakeutiZaring] p. 28. (Contributed by NM, 7-Apr-1995.) (Revised by Mario Carneiro, 22-Jun-2013.)
theorem resfunexg (A2 B2 C: class):
  $ wi (wa (wfun A2) (wcel B2 C)) (wcel (cres A2 B2) cvv) $;

--| The restriction of the identity relation to a set is a set. (Contributed by AV, 15-Feb-2020.)
theorem resiexd (ph: wff) (B2 V: class):
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wcel (cres cid B2) cvv) $;

--| If the domain of a function is a set, the function is a set. Theorem 6.16(1) of [TakeutiZaring] p. 28. This theorem is derived using the Axiom of Replacement in the form of ~ resfunexg . See ~ fnexALT for alternate proof. (Contributed by NM, 14-Aug-1994.) (Proof shortened by Andrew Salmon, 17-Sep-2011.)
theorem fnex (A2 B2 F: class):
  $ wi (wa (wfn F A2) (wcel A2 B2)) (wcel F cvv) $;

--| If the domain of a function is a set, the function is a set. (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem fnexd (ph: wff) (A2 F V: class):
  $ wi ph (wfn F A2) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel F cvv) $;

--| If the domain of a function exists, so does the function. Part of Theorem 4.15(v) of [Monk1] p. 46. This theorem is derived using the Axiom of Replacement in the form of ~ fnex . (Note: Any resemblance between F.U.N.E.X. and "Have You Any Eggs" is purely a coincidence originated by Swedish chefs.) (Contributed by NM, 11-Nov-1995.)
theorem funex (B2 F: class):
  $ wi (wa (wfun F) (wcel (cdm F) B2)) (wcel F cvv) $;

--| Existence of a function expressed as class of ordered pairs. (Contributed by NM, 21-Jul-1996.)
theorem opabex {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wcel A2 cvv $ >
  $ wi (wcel (cv x3) A2) (wmo y1 ph) $ >
  $ wcel (copab x3 y1 (wa (wcel (cv x3) A2) ph)) cvv $;

--| If the domain of a function given by maps-to notation is a set, the function is a set. (Contributed by FL, 6-Jun-2011.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem mptexg {x3: setvar} (A2: class) (B2 V: class x3):
  $ wi (wcel A2 V) (wcel (cmpt x3 A2 B2) cvv) $;

--| If the domain of a function given by maps-to notation is a set, the function is a set. (Contributed by FL, 6-Jun-2011.) (Revised by Mario Carneiro, 31-Aug-2015.) (Revised by Thierry Arnoux, 17-May-2020.)
theorem mptexgf {x3: setvar} (A2 B2 V: class x3):
  $ wnfc x3 A2 $ >
  $ wi (wcel A2 V) (wcel (cmpt x3 A2 B2) cvv) $;

--| If the domain of a function given by maps-to notation is a set, the function is a set. Inference version of ~ mptexg . (Contributed by NM, 22-Apr-2005.) (Revised by Mario Carneiro, 20-Dec-2013.)
theorem mptex {x3: setvar} (A2: class) (B2: class x3):
  $ wcel A2 cvv $ >
  $ wcel (cmpt x3 A2 B2) cvv $;

--| If the domain of a function given by maps-to notation is a set, the function is a set. Deduction version of ~ mptexg . (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem mptexd {x3: setvar} (ph: wff x3) (A2: class) (B2 V: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) cvv) $;

--| If the domain of a function given by maps-to notation is a class abstraction based on a set, the function is a set. (Contributed by AV, 16-Jul-2019.) (Revised by AV, 26-Mar-2021.)
theorem mptrabex {x3 y1: setvar} (ph: wff y1) (A2: class) (B2: class x3 y1):
  $ wcel A2 cvv $ >
  $ wcel (cmpt x3 (crab y1 ph A2) B2) cvv $;

--| If the domain of a mapping is a set, the function is a set. (Contributed by NM, 3-Oct-1999.)
theorem fex (A2 B2 C F: class):
  $ wi (wa (wf A2 B2 F) (wcel A2 C)) (wcel F cvv) $;

--| If the domain of a mapping is a set, the function is a set. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem fexd (ph: wff) (A2 B2 C F: class):
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wcel A2 C) $ >
  $ wi ph (wcel F cvv) $;

--| A function in maps-to notation as the value of another function in maps-to notation. (Contributed by AV, 20-Aug-2022.)
theorem mptfvmpt {x3 y1: setvar} (A2: class x3) (F G M: class x3 y1) (V: class) (W: class x3) (X: class x3 y1) (Y: class x3):
  $ wi (wceq (cv y1) Y) (wceq M (cmpt x3 V A2)) $ >
  $ wceq G (cmpt y1 W M) $ >
  $ wceq V (cfv X F) $ >
  $ wi (wcel Y W) (wceq (cfv Y G) (cmpt x3 V A2)) $;

--| A function is uniquely determined by its values. (Contributed by NM, 31-Aug-2011.)
theorem eufnfv {x3 f2: setvar} (A2: class) (B2: class x3):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ weu f2 (wa (wfn (cv f2) A2) (wral x3 (wceq (cfv (cv x3) (cv f2)) B2) A2)) $;

--| A function's value in a preimage belongs to the image. (Contributed by NM, 23-Sep-2003.)
theorem funfvima (A2 B2 F: class):
  $ wi (wa (wfun F) (wcel B2 (cdm F))) (wi (wcel B2 A2) (wcel (cfv B2 F) (cima F A2))) $;

--| A function's value in an included preimage belongs to the image. (Contributed by NM, 3-Feb-1997.)
theorem funfvima2 (A2 B2 F: class):
  $ wi (wa (wfun F) (wss A2 (cdm F))) (wi (wcel B2 A2) (wcel (cfv B2 F) (cima F A2))) $;

--| A function's value in a preimage belongs to the image. (Contributed by Stanislas Polu, 9-Mar-2020.) (Revised by AV, 23-Mar-2024.)
theorem funfvima2d (ph: wff) (A2 B2 F X: class):
  $ wi ph (wf A2 B2 F) $ >
  $ wi (wa ph (wcel X A2)) (wcel (cfv X F) (cima F A2)) $;

--| The function value of an operand in a set is contained in the image of that set, using the ` Fn ` abbreviation. (Contributed by Stefan O'Rear, 10-Mar-2015.)
theorem fnfvima (A2 S F X: class):
  $ wi (w3a (wfn F A2) (wss S A2) (wcel X S)) (wcel (cfv X F) (cima F S)) $;

--| A function's value belongs to the image. (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem fnfvimad (ph: wff) (A2 B2 C F: class):
  $ wi ph (wfn F A2) $ >
  $ wi ph (wcel B2 A2) $ >
  $ wi ph (wcel B2 C) $ >
  $ wi ph (wcel (cfv B2 F) (cima F C)) $;

--| The value of the function value of a restriction for a function restricted to the image of the restricting subset. (Contributed by AV, 6-Mar-2021.)
theorem resfvresima (ph: wff) (S F H X: class):
  $ wi ph (wfun F) $ >
  $ wi ph (wss S (cdm F)) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wceq (cfv (cfv X (cres F S)) (cres H (cima F S))) (cfv (cfv X F) H)) $;

--| A class including a function contains the function's value in the image of the singleton of the argument. (Contributed by NM, 23-Mar-2004.)
theorem funfvima3 (A2 F G: class):
  $ wi (wa (wfun F) (wss F G)) (wi (wcel A2 (cdm F)) (wcel (cfv A2 F) (cima G (csn A2)))) $;

--| Universal quantification under an image in terms of the base set. (Contributed by Stefan O'Rear, 21-Jan-2015.) Reduce DV conditions. (Revised by Matthew House, 14-Aug-2025.)
theorem ralima {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class x3 y1) (B2 F: class):
  $ wi (wceq (cv x3) (cfv (cv y1) F)) (wb ph ps) $ >
  $ wi (wa (wfn F A2) (wss B2 A2)) (wb (wral x3 ph (cima F B2)) (wral y1 ps B2)) $;

--| Existential quantification under an image in terms of the base set. (Contributed by Stefan O'Rear, 21-Jan-2015.) Reduce DV conditions. (Revised by Matthew House, 14-Aug-2025.)
theorem rexima {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class x3 y1) (B2 F: class):
  $ wi (wceq (cv x3) (cfv (cv y1) F)) (wb ph ps) $ >
  $ wi (wa (wfn F A2) (wss B2 A2)) (wb (wrex x3 ph (cima F B2)) (wrex y1 ps B2)) $;

--| Upper bound for the class of values of a class. (Contributed by NM, 9-Nov-1995.)
theorem fvclss {x3 y1: setvar} (F: class):
  $ wss (cab y1 (wex x3 (wceq (cv y1) (cfv (cv x3) F)))) (cun (crn F) (csn c0)) $;

--| Elementhood in an image set. (Contributed by Mario Carneiro, 14-Jan-2014.)
theorem elabrex {x3 y1: setvar} (A2: class) (B2: class x3):
  $ wcel B2 cvv $ >
  $ wi (wcel (cv x3) A2) (wcel B2 (cab y1 (wrex x3 (wceq (cv y1) B2) A2))) $;

--| Elementhood in an image set. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem elabrexg {x3 y1: setvar} (A2: class) (B2: class x3) (V: class x3 y1):
  $ wi (wa (wcel (cv x3) A2) (wcel B2 V)) (wcel B2 (cab y1 (wrex x3 (wceq (cv y1) B2) A2))) $;

--| Composition of two image maps ` C ( y ) ` and ` B ( w ) ` . (Contributed by NM, 27-May-2013.)
theorem abrexco {x3 y1 z w: setvar} (A2 B2: class x3 w) (C: class x3 y1 z) (D: class x3 z w):
  $ wcel B2 cvv $ >
  $ wi (wceq (cv y1) B2) (wceq C D) $ >
  $ wceq (cab x3 (wrex y1 (wceq (cv x3) C) (cab z (wrex w (wceq (cv z) B2) A2)))) (cab x3 (wrex w (wceq (cv x3) D) A2)) $;

--| The image of an indexed union is the indexed union of the images. (Contributed by Mario Carneiro, 18-Jun-2014.)
theorem imaiun {x3: setvar} (A2: class) (B2 C: class x3):
  $ wceq (cima A2 (ciun x3 B2 C)) (ciun x3 B2 (cima A2 C)) $;

--| The image of a union is the indexed union of the images. Theorem 3K(a) of [Enderton] p. 50. (Contributed by NM, 9-Aug-2004.) (Proof shortened by Mario Carneiro, 18-Jun-2014.)
theorem imauni {x3: setvar} (A2 B2: class):
  $ wceq (cima A2 (cuni B2)) (ciun x3 B2 (cima A2 (cv x3))) $;

--| The indexed union of a function's values is the union of its range. Compare Definition 5.4 of [Monk1] p. 50. (Contributed by NM, 27-Sep-2004.)
theorem fniunfv {x3: setvar} (A2 F: class):
  $ wi (wfn F A2) (wceq (ciun x3 A2 (cfv (cv x3) F)) (cuni (crn F))) $;

--| The indexed union of a function's values is the union of its image under the index class. Note: This theorem depends on the fact that our function value is the empty set outside of its domain. If the antecedent is changed to ` F Fn A ` , the theorem can be proved without this dependency. (Contributed by NM, 26-Mar-2006.) (Proof shortened by Mario Carneiro, 31-Aug-2015.)
theorem funiunfv {x3: setvar} (A2 F: class):
  $ wi (wfun F) (wceq (ciun x3 A2 (cfv (cv x3) F)) (cuni (cima F A2))) $;

--| The indexed union of a function's values is the union of its image under the index class. This version of ~ funiunfv uses a bound-variable hypothesis in place of a distinct variable condition. (Contributed by NM, 26-Mar-2006.) (Revised by David Abernethy, 15-Apr-2013.)
theorem funiunfvf {x3: setvar} (A2: class) (F: class x3):
  $ wnfc x3 F $ >
  $ wi (wfun F) (wceq (ciun x3 A2 (cfv (cv x3) F)) (cuni (cima F A2))) $;

--| Membership in the union of an image of a function. (Contributed by NM, 28-Sep-2006.)
theorem eluniima {x3: setvar} (A2 B2 F: class):
  $ wi (wfun F) (wb (wcel B2 (cuni (cima F A2))) (wrex x3 (wcel B2 (cfv (cv x3) F)) A2)) $;

--| Membership in the union of the range of a function. See ~ elunirnALT for a shorter proof which uses ~ ax-pow . See ~ elfvunirn for a more general version of the reverse direction. (Contributed by NM, 24-Sep-2006.)
theorem elunirn {x3: setvar} (A2 F: class):
  $ wi (wfun F) (wb (wcel A2 (cuni (crn F))) (wrex x3 (wcel A2 (cfv (cv x3) F)) (cdm F))) $;

--| Alternate proof of ~ elunirn . It is shorter but requires ~ ax-pow (through ~ eluniima , ~ funiunfv , ~ ndmfv ). (Contributed by NM, 24-Sep-2006.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem elunirnALT {x3: setvar} (A2 F: class):
  $ wi (wfun F) (wb (wcel A2 (cuni (crn F))) (wrex x3 (wcel A2 (cfv (cv x3) F)) (cdm F))) $;

--| Membership in a union of some function-defined family of sets. (Contributed by Stefan O'Rear, 30-Jan-2015.)
theorem fnunirn {x3: setvar} (A2 F I: class):
  $ wi (wfn F I) (wb (wcel A2 (cuni (crn F))) (wrex x3 (wcel A2 (cfv (cv x3) F)) I)) $;

--| A one-to-one function in terms of function values. Compare Theorem 4.8(iv) of [Monk1] p. 43. (Contributed by NM, 29-Oct-1996.)
theorem dff13 {x3 y1: setvar} (A2: class) (B2: class x3 y1) (F: class):
  $ wb (wf1 A2 B2 F) (wa (wf A2 B2 F) (wral x3 (wral y1 (wi (wceq (cfv (cv x3) F) (cfv (cv y1) F)) (wceq (cv x3) (cv y1))) A2) A2)) $;

--| A one-to-one function in terms of function values. Compare Theorem 4.8(iv) of [Monk1] p. 43. (Contributed by NM, 31-Jul-2003.)
theorem dff13f {x3 y1: setvar} (A2: class) (B2 F: class x3 y1):
  $ wnfc x3 F $ >
  $ wnfc y1 F $ >
  $ wb (wf1 A2 B2 F) (wa (wf A2 B2 F) (wral x3 (wral y1 (wi (wceq (cfv (cv x3) F) (cfv (cv y1) F)) (wceq (cv x3) (cv y1))) A2) A2)) $;

--| If the values of a one-to-one function for two arguments are equal, the arguments themselves must be equal. (Contributed by Alexander van der Vekens, 12-Nov-2017.)
theorem f1veqaeq (A2 B2 C D F: class):
  $ wi (wa (wf1 A2 B2 F) (wa (wcel C A2) (wcel D A2))) (wi (wceq (cfv C F) (cfv D F)) (wceq C D)) $;

--| If the values of a composition of one-to-one functions for two arguments are equal, the arguments themselves must be equal. (Contributed by AV, 3-Feb-2021.)
theorem f1cofveqaeq (A2 B2 C F G X Y: class):
  $ wi (wa (wa (wf1 B2 C F) (wf1 A2 B2 G)) (wa (wcel X A2) (wcel Y A2))) (wi (wceq (cfv (cfv X G) F) (cfv (cfv Y G) F)) (wceq X Y)) $;

--| Alternate proof of ~ f1cofveqaeq , 1 essential step shorter, but having more bytes (305 versus 282). (Contributed by AV, 3-Feb-2021.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem f1cofveqaeqALT (A2 B2 C F G X Y: class):
  $ wi (wa (wa (wf1 B2 C F) (wf1 A2 B2 G)) (wa (wcel X A2) (wcel Y A2))) (wi (wceq (cfv (cfv X G) F) (cfv (cfv Y G) F)) (wceq X Y)) $;

--| A one-to-one function maps different arguments onto different values. Implication of the alternate definition ~ dff14a . (Contributed by AV, 30-Oct-2025.)
theorem dff14i (A2 B2 F X Y: class):
  $ wi (wa (wf1 A2 B2 F) (w3a (wcel X A2) (wcel Y A2) (wne X Y))) (wne (cfv X F) (cfv Y F)) $;

--| If two one-to-one functions are applied on different arguments, also the values are different. (Contributed by Alexander van der Vekens, 25-Jan-2018.) (Proof shortened by AV, 30-Oct-2025.)
theorem _2f1fvneq (A2 B2 C D R E F X Y: class):
  $ wi (w3a (wa (wf1 D R E) (wf1 C D F)) (wa (wcel A2 C) (wcel B2 C)) (wne A2 B2)) (wi (wa (wceq (cfv (cfv A2 F) E) X) (wceq (cfv (cfv B2 F) E) Y)) (wne X Y)) $;

--| Express injection for a mapping operation. (Contributed by Mario Carneiro, 2-Jan-2017.)
theorem f1mpt {x3 y1: setvar} (A2 B2: class) (C: class x3) (D: class y1) (F: class x3):
  $ wceq F (cmpt x3 A2 C) $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq C D) $ >
  $ wb (wf1 A2 B2 F) (wa (wral x3 (wcel C B2) A2) (wral x3 (wral y1 (wi (wceq C D) (wceq (cv x3) (cv y1))) A2) A2)) $;

--| Equality of function values for a one-to-one function. (Contributed by NM, 11-Feb-1997.)
theorem f1fveq (A2 B2 C D F: class):
  $ wi (wa (wf1 A2 B2 F) (wa (wcel C A2) (wcel D A2))) (wb (wceq (cfv C F) (cfv D F)) (wceq C D)) $;

--| Membership in the image of a 1-1 map. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem f1elima (A2 B2 F X Y: class):
  $ wi (w3a (wf1 A2 B2 F) (wcel X A2) (wss Y A2)) (wb (wcel (cfv X F) (cima F Y)) (wcel X Y)) $;

--| Taking images under a one-to-one function preserves subsets. (Contributed by Stefan O'Rear, 30-Oct-2014.)
theorem f1imass (A2 B2 C D F: class):
  $ wi (wa (wf1 A2 B2 F) (wa (wss C A2) (wss D A2))) (wb (wss (cima F C) (cima F D)) (wss C D)) $;

--| Taking images under a one-to-one function preserves equality. (Contributed by Stefan O'Rear, 30-Oct-2014.)
theorem f1imaeq (A2 B2 C D F: class):
  $ wi (wa (wf1 A2 B2 F) (wa (wss C A2) (wss D A2))) (wb (wceq (cima F C) (cima F D)) (wceq C D)) $;

--| Taking images under a one-to-one function preserves proper subsets. (Contributed by Stefan O'Rear, 30-Oct-2014.)
theorem f1imapss (A2 B2 C D F: class):
  $ wi (wa (wf1 A2 B2 F) (wa (wss C A2) (wss D A2))) (wb (wpss (cima F C) (cima F D)) (wpss C D)) $;

--| A function, given by an unordered pair of ordered pairs, which is not injective/one-to-one. (Contributed by Alexander van der Vekens, 22-Oct-2017.) (Revised by AV, 8-Jan-2021.)
theorem fpropnf1 (U F V W X Y Z: class):
  $ wceq F (cpr (cop X Z) (cop Y Z)) $ >
  $ wi (wa (w3a (wcel X U) (wcel Y V) (wcel Z W)) (wne X Y)) (wa (wfun F) (wn (wfun (ccnv F)))) $;

--| The function values for a 1-1 function from a set with three different elements are different. (Contributed by AV, 20-Mar-2019.)
theorem f1dom3fv3dif (ph: wff) (A2 B2 C R F X Y Z: class):
  $ wi ph (w3a (wcel A2 X) (wcel B2 Y) (wcel C Z)) $ >
  $ wi ph (w3a (wne A2 B2) (wne A2 C) (wne B2 C)) $ >
  $ wi ph (wf1 (ctp A2 B2 C) R F) $ >
  $ wi ph (w3a (wne (cfv A2 F) (cfv B2 F)) (wne (cfv A2 F) (cfv C F)) (wne (cfv B2 F) (cfv C F))) $;

--| The codomain of a 1-1 function from a set with three different elements has (at least) three different elements. (Contributed by AV, 20-Mar-2019.)
theorem f1dom3el3dif {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2 B2 C R F: class) (X Y Z: class x3 y1 z):
  $ wi ph (w3a (wcel A2 X) (wcel B2 Y) (wcel C Z)) $ >
  $ wi ph (w3a (wne A2 B2) (wne A2 C) (wne B2 C)) $ >
  $ wi ph (wf1 (ctp A2 B2 C) R F) $ >
  $ wi ph (wrex x3 (wrex y1 (wrex z (w3a (wne (cv x3) (cv y1)) (wne (cv x3) (cv z)) (wne (cv y1) (cv z))) R) R) R) $;

--| A one-to-one function in terms of different function values for different arguments. (Contributed by Alexander van der Vekens, 26-Jan-2018.)
theorem dff14a {x3 y1: setvar} (A2: class) (B2: class x3 y1) (F: class):
  $ wb (wf1 A2 B2 F) (wa (wf A2 B2 F) (wral x3 (wral y1 (wi (wne (cv x3) (cv y1)) (wne (cfv (cv x3) F) (cfv (cv y1) F))) A2) A2)) $;

--| A one-to-one function in terms of different function values for different arguments. (Contributed by Alexander van der Vekens, 26-Jan-2018.)
theorem dff14b {x3 y1: setvar} (A2: class) (B2: class x3 y1) (F: class):
  $ wb (wf1 A2 B2 F) (wa (wf A2 B2 F) (wral x3 (wral y1 (wne (cfv (cv x3) F) (cfv (cv y1) F)) (cdif A2 (csn (cv x3)))) A2)) $;

--| A one-to-one function in terms of different arguments never having the same function value. (Contributed by BTernaryTau, 24-Oct-2023.)
theorem dff15 {x3 y1: setvar} (A2: class) (B2: class x3 y1) (F: class):
  $ wb (wf1 A2 B2 F) (wa (wf A2 B2 F) (wn (wrex x3 (wrex y1 (wa (wceq (cfv (cv x3) F) (cfv (cv y1) F)) (wne (cv x3) (cv y1))) A2) A2))) $;

--| If a function restricted to a class is one-to-one, then for any two elements of the class, the values of the function at those elements are equal only if the two elements are the same element. (Contributed by BTernaryTau, 27-Sep-2023.)
theorem f1resveqaeq (A2 B2 C D F: class):
  $ wi (wa (wf1 A2 B2 (cres F A2)) (wa (wcel C A2) (wcel D A2))) (wi (wceq (cfv C F) (cfv D F)) (wceq C D)) $;

--| Lemma for ~ f1resrcmplf1d . (Contributed by BTernaryTau, 27-Sep-2023.) (Revised by Mingli Yuan, 15-Aug-2026.)
theorem f1resrcmplf1dlem (ph: wff) (A2 B2 C D F X Y: class):
  $ wi ph (wss C A2) $ >
  $ wi ph (wss D A2) $ >
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wceq (cin (cima F C) (cima F D)) c0) $ >
  $ wi ph (wcel X C) $ >
  $ wi ph (wcel Y D) $ >
  $ wi ph (wceq (cfv X F) (cfv Y F)) $ >
  $ wi ph (wceq X Y) $;

--| If a function's restriction to a subclass of its domain and its restriction to the relative complement of that subclass are both one-to-one, and if the ranges of those two restrictions are disjoint, then the function is itself one-to-one. (Contributed by BTernaryTau, 28-Sep-2023.)
theorem f1resrcmplf1d (ph: wff) (A2 B2 C F: class):
  $ wi ph (wss C A2) $ >
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wf1 C B2 (cres F C)) $ >
  $ wi ph (wf1 (cdif A2 C) B2 (cres F (cdif A2 C))) $ >
  $ wi ph (wceq (cin (cima F C) (cima F (cdif A2 C))) c0) $ >
  $ wi ph (wf1 A2 B2 F) $;

--| Extension of a bijection by an ordered pair. (Contributed by AV, 15-Sep-2025.)
theorem f1ounsn (A2 B2 F G V W X Y: class):
  $ wceq F (cun G (csn (cop X Y))) $ >
  $ wi (w3a (wf1o A2 B2 G) (wa (wcel X V) (wcel Y W)) (wa (wnel X A2) (wnel Y B2))) (wf1o (cun A2 (csn X)) (cun B2 (csn Y)) F) $;

--| A one-to-one function with a domain with at least two different elements in terms of function values. (Contributed by Alexander van der Vekens, 2-Mar-2018.)
theorem f12dfv (A2 B2 U F V X Y: class):
  $ wceq A2 (cpr X Y) $ >
  $ wi (wa (wa (wcel X U) (wcel Y V)) (wne X Y)) (wb (wf1 A2 B2 F) (wa (wf A2 B2 F) (wne (cfv X F) (cfv Y F)))) $;

--| A one-to-one function with a domain with at least three different elements in terms of function values. (Contributed by Alexander van der Vekens, 26-Jan-2018.)
theorem f13dfv (A2 B2 U F V W X Y Z: class):
  $ wceq A2 (ctp X Y Z) $ >
  $ wi (wa (w3a (wcel X U) (wcel Y V) (wcel Z W)) (w3a (wne X Y) (wne X Z) (wne Y Z))) (wb (wf1 A2 B2 F) (wa (wf A2 B2 F) (w3a (wne (cfv X F) (cfv Y F)) (wne (cfv X F) (cfv Z F)) (wne (cfv Y F) (cfv Z F))))) $;

--| A one-to-one onto function in terms of function values. (Contributed by NM, 29-Mar-2008.)
theorem dff1o6 {x3 y1: setvar} (A2: class) (B2: class x3 y1) (F: class):
  $ wb (wf1o A2 B2 F) (w3a (wfn F A2) (wceq (crn F) B2) (wral x3 (wral y1 (wi (wceq (cfv (cv x3) F) (cfv (cv y1) F)) (wceq (cv x3) (cv y1))) A2) A2)) $;

--| The converse value of the value of a one-to-one onto function. (Contributed by NM, 20-May-2004.)
theorem f1ocnvfv1 (A2 B2 C F: class):
  $ wi (wa (wf1o A2 B2 F) (wcel C A2)) (wceq (cfv (cfv C F) (ccnv F)) C) $;

--| The value of the converse value of a one-to-one onto function. (Contributed by NM, 20-May-2004.)
theorem f1ocnvfv2 (A2 B2 C F: class):
  $ wi (wa (wf1o A2 B2 F) (wcel C B2)) (wceq (cfv (cfv C (ccnv F)) F) C) $;

--| Relationship between the value of a one-to-one onto function and the value of its converse. (Contributed by Raph Levien, 10-Apr-2004.)
theorem f1ocnvfv (A2 B2 C D F: class):
  $ wi (wa (wf1o A2 B2 F) (wcel C A2)) (wi (wceq (cfv C F) D) (wceq (cfv D (ccnv F)) C)) $;

--| Relationship between the value of a one-to-one onto function and the value of its converse. (Contributed by NM, 20-May-2004.)
theorem f1ocnvfvb (A2 B2 C D F: class):
  $ wi (w3a (wf1o A2 B2 F) (wcel C A2) (wcel D B2)) (wb (wceq (cfv C F) D) (wceq (cfv D (ccnv F)) C)) $;

--| An involution is a bijection. (Contributed by Thierry Arnoux, 7-Dec-2016.)
theorem nvof1o (A2 F: class):
  $ wi (wa (wfn F A2) (wceq (ccnv F) F)) (wf1o A2 A2 F) $;

--| The converse of an involution is the function itself. (Contributed by Thierry Arnoux, 7-May-2019.)
theorem nvocnv {x3: setvar} (A2 F: class):
  $ wi (wa (wf A2 A2 F) (wral x3 (wceq (cfv (cfv (cv x3) F) F) (cv x3)) A2)) (wceq (ccnv F) F) $;

--| If a one-to-one function with a nonempty domain has a singleton as its codomain, its domain must also be a singleton. (Contributed by BTernaryTau, 1-Dec-2024.)
theorem f1cdmsn {x3: setvar} (A2: class) (B2 F: class x3):
  $ wi (wa (wf1 A2 (csn B2) F) (wne A2 c0)) (wex x3 (wceq A2 (csn (cv x3)))) $;

--| Relate a function with a singleton as domain and one variable. (Contributed by Thierry Arnoux, 12-Jul-2020.)
theorem fsnex {x3 f2: setvar} (ph: wff f2) (ps: wff x3) (A2 D V: class):
  $ wi (wceq (cv x3) (cfv A2 (cv f2))) (wb ps ph) $ >
  $ wi (wcel A2 V) (wb (wex f2 (wa (wf (csn A2) D (cv f2)) ph)) (wrex x3 ps D)) $;

--| Relate a one-to-one function with a pair as domain and two different variables. (Contributed by Thierry Arnoux, 12-Jul-2020.)
theorem f1prex {x3 y1 f2: setvar} (ph: wff f2) (ps: wff x3 y1) (ch: wff y1 f2) (A2 B2 D V W: class):
  $ wi (wceq (cv x3) (cfv A2 (cv f2))) (wb ps ch) $ >
  $ wi (wceq (cv y1) (cfv B2 (cv f2))) (wb ch ph) $ >
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wne A2 B2)) (wb (wex f2 (wa (wf1 (cpr A2 B2) D (cv f2)) ph)) (wrex x3 (wrex y1 (wa (wne (cv x3) (cv y1)) ps) D) D)) $;

--| The value of the converse of a one-to-one onto function belongs to its domain. (Contributed by NM, 26-May-2006.)
theorem f1ocnvdm (A2 B2 C F: class):
  $ wi (wa (wf1o A2 B2 F) (wcel C B2)) (wcel (cfv C (ccnv F)) A2) $;

--| If the values of a one-to-one function for two arguments from the range of the function are equal, the arguments themselves must be equal. (Contributed by Alexander van der Vekens, 12-Nov-2017.)
theorem f1ocnvfvrneq (A2 B2 C D F: class):
  $ wi (wa (wf1 A2 B2 F) (wa (wcel C (crn F)) (wcel D (crn F)))) (wi (wceq (cfv C (ccnv F)) (cfv D (ccnv F))) (wceq C D)) $;

--| An application is injective if a retraction exists. Proposition 8 of [BourbakiEns] p. E.II.18. (Contributed by FL, 11-Nov-2011.) (Revised by Mario Carneiro, 27-Dec-2014.)
theorem fcof1 (A2 B2 R F: class):
  $ wi (wa (wf A2 B2 F) (wceq (ccom R F) (cres cid A2))) (wf1 A2 B2 F) $;

--| An application is surjective if a section exists. Proposition 8 of [BourbakiEns] p. E.II.18. (Contributed by FL, 17-Nov-2011.) (Proof shortened by Mario Carneiro, 27-Dec-2014.)
theorem fcofo (A2 B2 S F: class):
  $ wi (w3a (wf A2 B2 F) (wf B2 A2 S) (wceq (ccom F S) (cres cid B2))) (wfo A2 B2 F) $;

--| Change bound variable between domain and range of function. (Contributed by NM, 23-Feb-1997.) (Proof shortened by Mario Carneiro, 21-Mar-2015.)
theorem cbvfo {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class) (B2: class x3) (F: class):
  $ wi (wceq (cfv (cv x3) F) (cv y1)) (wb ph ps) $ >
  $ wi (wfo A2 B2 F) (wb (wral x3 ph A2) (wral y1 ps B2)) $;

--| Change bound variable between domain and range of function. (Contributed by NM, 23-Feb-1997.)
theorem cbvexfo {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class) (B2: class x3) (F: class):
  $ wi (wceq (cfv (cv x3) F) (cv y1)) (wb ph ps) $ >
  $ wi (wfo A2 B2 F) (wb (wrex x3 ph A2) (wrex y1 ps B2)) $;

--| An injection is left-cancelable. (Contributed by FL, 2-Aug-2009.) (Revised by Mario Carneiro, 21-Mar-2015.)
theorem cocan1 (A2 B2 C F H K: class):
  $ wi (w3a (wf1 B2 C F) (wf A2 B2 H) (wf A2 B2 K)) (wb (wceq (ccom F H) (ccom F K)) (wceq H K)) $;

--| A surjection is right-cancelable. (Contributed by FL, 21-Nov-2011.) (Proof shortened by Mario Carneiro, 21-Mar-2015.)
theorem cocan2 (A2 B2 F H K: class):
  $ wi (w3a (wfo A2 B2 F) (wfn H B2) (wfn K B2)) (wb (wceq (ccom H F) (ccom K F)) (wceq H K)) $;

--| Show that a function is the inverse of a bijective function if their composition is the identity function. Formerly part of proof of ~ fcof1o . (Contributed by Mario Carneiro, 21-Mar-2015.) (Revised by AV, 15-Dec-2019.)
theorem fcof1oinvd (ph: wff) (A2 B2 F G: class):
  $ wi ph (wf1o A2 B2 F) $ >
  $ wi ph (wf B2 A2 G) $ >
  $ wi ph (wceq (ccom F G) (cres cid B2)) $ >
  $ wi ph (wceq (ccnv F) G) $;

--| A function is bijective if a "retraction" and a "section" exist, see comments for ~ fcof1 and ~ fcofo . Formerly part of proof of ~ fcof1o . (Contributed by Mario Carneiro, 21-Mar-2015.) (Revised by AV, 15-Dec-2019.)
theorem fcof1od (ph: wff) (A2 B2 F G: class):
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wf B2 A2 G) $ >
  $ wi ph (wceq (ccom G F) (cres cid A2)) $ >
  $ wi ph (wceq (ccom F G) (cres cid B2)) $ >
  $ wi ph (wf1o A2 B2 F) $;

--| Show that a function is the inverse of a function if their compositions are the identity functions. (Contributed by Mario Carneiro, 21-Mar-2015.) (Revised by AV, 15-Dec-2019.)
theorem _2fcoidinvd (ph: wff) (A2 B2 F G: class):
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wf B2 A2 G) $ >
  $ wi ph (wceq (ccom G F) (cres cid A2)) $ >
  $ wi ph (wceq (ccom F G) (cres cid B2)) $ >
  $ wi ph (wceq (ccnv F) G) $;

--| Show that two functions are inverse to each other by computing their compositions. (Contributed by Mario Carneiro, 21-Mar-2015.) (Proof shortened by AV, 15-Dec-2019.)
theorem fcof1o (A2 B2 F G: class):
  $ wi (wa (wa (wf A2 B2 F) (wf B2 A2 G)) (wa (wceq (ccom F G) (cres cid B2)) (wceq (ccom G F) (cres cid A2)))) (wa (wf1o A2 B2 F) (wceq (ccnv F) G)) $;

--| Show that the composition of two functions is the identity function by applying both functions to each value of the domain of the first function. (Contributed by AV, 15-Dec-2019.)
theorem _2fvcoidd {a: setvar} (ph: wff a) (A2: class) (B2: class a) (F G: class):
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wf B2 A2 G) $ >
  $ wi ph (wral a (wceq (cfv (cfv (cv a) F) G) (cv a)) A2) $ >
  $ wi ph (wceq (ccom G F) (cres cid A2)) $;

--| A function is bijective if it has an inverse function. (Contributed by AV, 15-Dec-2019.)
theorem _2fvidf1od {a b: setvar} (ph: wff a b) (A2: class b) (B2: class a) (F G: class):
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wf B2 A2 G) $ >
  $ wi ph (wral a (wceq (cfv (cfv (cv a) F) G) (cv a)) A2) $ >
  $ wi ph (wral b (wceq (cfv (cfv (cv b) G) F) (cv b)) B2) $ >
  $ wi ph (wf1o A2 B2 F) $;

--| Show that two functions are inverse to each other by applying them twice to each value of their domains. (Contributed by AV, 13-Dec-2019.)
theorem _2fvidinvd {a b: setvar} (ph: wff a b) (A2: class b) (B2: class a) (F G: class):
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wf B2 A2 G) $ >
  $ wi ph (wral a (wceq (cfv (cfv (cv a) F) G) (cv a)) A2) $ >
  $ wi ph (wral b (wceq (cfv (cfv (cv b) G) F) (cv b)) B2) $ >
  $ wi ph (wceq (ccnv F) G) $;

--| Condition for function equality in terms of vanishing of the composition with the converse. _EDITORIAL_: Is there a relation-algebraic proof of this? (Contributed by Stefan O'Rear, 12-Feb-2015.)
theorem foeqcnvco (A2 B2 F G: class):
  $ wi (wa (wfo A2 B2 F) (wfo A2 B2 G)) (wb (wceq F G) (wceq (ccom F (ccnv G)) (cres cid B2))) $;

--| Condition for function equality in terms of vanishing of the composition with the inverse. (Contributed by Stefan O'Rear, 12-Feb-2015.) (Proof shortened by Wolf Lammen, 29-May-2024.)
theorem f1eqcocnv (A2 B2 F G: class):
  $ wi (wa (wf1 A2 B2 F) (wf1 A2 B2 G)) (wb (wceq F G) (wceq (ccom (ccnv F) G) (cres cid A2))) $;

--| Given a bijection ` F ` , produce another bijection ` G ` which additionally maps two specified points. (Contributed by Mario Carneiro, 30-May-2015.)
theorem fveqf1o (A2 B2 C D F G: class):
  $ wceq G (ccom F (cun (cres cid (cdif A2 (cpr C (cfv D (ccnv F))))) (cpr (cop C (cfv D (ccnv F))) (cop (cfv D (ccnv F)) C)))) $ >
  $ wi (w3a (wf1o A2 B2 F) (wcel C A2) (wcel D B2)) (wa (wf1o A2 B2 G) (wceq (cfv C G) D)) $;

--| The composition of two bijections as bijection onto the image of the range of the first bijection. (Contributed by AV, 15-Aug-2025.)
theorem f1ocoima (A2 B2 C D F G: class):
  $ wi (w3a (wf1o A2 B2 F) (wf1o C D G) (wss B2 C)) (wf1o A2 (cima G B2) (ccom G F)) $;

--| A constant function from at least two elements is not one-to-one. (Contributed by AV, 30-Mar-2024.)
theorem nf1const (A2 B2 C F X Y: class):
  $ wi (wa (wf A2 (csn B2) F) (w3a (wcel X A2) (wcel Y A2) (wne X Y))) (wn (wf1 A2 C F)) $;

--| A constant function from at least two elements is not bijective. (Contributed by AV, 30-Mar-2024.)
theorem nf1oconst (A2 B2 C F X Y: class):
  $ wi (wa (wf A2 (csn B2) F) (w3a (wcel X A2) (wcel Y A2) (wne X Y))) (wn (wf1o A2 C F)) $;

--| Swapping two values in a bijection between two classes yields another bijection between those classes. (Contributed by BTernaryTau, 31-Aug-2024.)
theorem f1ofvswap (A2 B2 F X Y: class):
  $ wi (w3a (wf1o A2 B2 F) (wcel X A2) (wcel Y A2)) (wf1o A2 B2 (cun (cres F (cdif A2 (cpr X Y))) (cpr (cop X (cfv Y F)) (cop Y (cfv X F))))) $;

--| Values of a one-to-one function between two sets with two elements. Actually, such a function is a bijection. (Contributed by AV, 22-Jul-2025.)
theorem fvf1pr (A2 B2 F V W X Y: class):
  $ wi (wa (w3a (wcel A2 V) (wcel B2 W) (wne A2 B2)) (wf1 (cpr A2 B2) (cpr X Y) F)) (wo (wa (wceq (cfv A2 F) X) (wceq (cfv B2 F) Y)) (wa (wceq (cfv A2 F) Y) (wceq (cfv B2 F) X))) $;

--| ` F ` , a function lift, is a subset of ` R X. S ` . (Contributed by Mario Carneiro, 23-Dec-2016.)
theorem fliftrel {x3: setvar} (ph: wff) (A2 B2: class x3) (R S: class) (F: class x3) (X: class):
  $ wceq F (crn (cmpt x3 X (cop A2 B2))) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel A2 R) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel B2 S) $ >
  $ wi ph (wss F (cxp R S)) $;

--| Elementhood in the relation ` F ` . (Contributed by Mario Carneiro, 23-Dec-2016.)
theorem fliftel {x3: setvar} (ph: wff) (A2 B2: class x3) (C D R S: class) (F: class x3) (X: class):
  $ wceq F (crn (cmpt x3 X (cop A2 B2))) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel A2 R) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel B2 S) $ >
  $ wi ph (wb (wbr C D F) (wrex x3 (wa (wceq C A2) (wceq D B2)) X)) $;

--| Elementhood in the relation ` F ` . (Contributed by Mario Carneiro, 23-Dec-2016.)
theorem fliftel1 {x3: setvar} (ph: wff) (A2 B2: class x3) (R S: class) (F: class x3) (X: class):
  $ wceq F (crn (cmpt x3 X (cop A2 B2))) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel A2 R) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel B2 S) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wbr A2 B2 F) $;

--| Converse of the relation ` F ` . (Contributed by Mario Carneiro, 23-Dec-2016.)
theorem fliftcnv {x3: setvar} (ph: wff) (A2 B2: class x3) (R S: class) (F: class x3) (X: class):
  $ wceq F (crn (cmpt x3 X (cop A2 B2))) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel A2 R) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel B2 S) $ >
  $ wi ph (wceq (ccnv F) (crn (cmpt x3 X (cop B2 A2)))) $;

--| The function ` F ` is the unique function defined by ` F `` A = B ` , provided that the well-definedness condition holds. (Contributed by Mario Carneiro, 23-Dec-2016.)
theorem fliftfun {x3 y1: setvar} (ph: wff) (A2 B2: class x3) (C D: class y1) (R S: class) (F: class x3) (X: class):
  $ wceq F (crn (cmpt x3 X (cop A2 B2))) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel A2 R) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel B2 S) $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq A2 C) $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 D) $ >
  $ wi ph (wb (wfun F) (wral x3 (wral y1 (wi (wceq A2 C) (wceq B2 D)) X) X)) $;

--| The function ` F ` is the unique function defined by ` F `` A = B ` , provided that the well-definedness condition holds. (Contributed by Mario Carneiro, 23-Dec-2016.)
theorem fliftfund {x3 y1: setvar} (ph: wff) (A2 B2: class x3) (C D: class y1) (R S: class) (F: class x3) (X: class):
  $ wceq F (crn (cmpt x3 X (cop A2 B2))) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel A2 R) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel B2 S) $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq A2 C) $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 D) $ >
  $ wi (wa ph (w3a (wcel (cv x3) X) (wcel (cv y1) X) (wceq A2 C))) (wceq B2 D) $ >
  $ wi ph (wfun F) $;

--| The function ` F ` is the unique function defined by ` F `` A = B ` , provided that the well-definedness condition holds. (Contributed by Mario Carneiro, 23-Dec-2016.)
theorem fliftfuns {x3 y1 z: setvar} (ph: wff) (A2 B2: class x3) (R S: class) (F: class x3) (X: class):
  $ wceq F (crn (cmpt x3 X (cop A2 B2))) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel A2 R) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel B2 S) $ >
  $ wi ph (wb (wfun F) (wral y1 (wral z (wi (wceq (csb x3 (cv y1) A2) (csb x3 (cv z) A2)) (wceq (csb x3 (cv y1) B2) (csb x3 (cv z) B2))) X) X)) $;

--| The domain and range of the function ` F ` . (Contributed by Mario Carneiro, 23-Dec-2016.)
theorem fliftf {x3: setvar} (ph: wff) (A2 B2: class x3) (R S: class) (F: class x3) (X: class):
  $ wceq F (crn (cmpt x3 X (cop A2 B2))) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel A2 R) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel B2 S) $ >
  $ wi ph (wb (wfun F) (wf (crn (cmpt x3 X A2)) S F)) $;

--| The value of the function ` F ` . (Contributed by Mario Carneiro, 23-Dec-2016.)
theorem fliftval {x3: setvar} (ph: wff) (A2 B2: class x3) (C D R S: class) (F: class x3) (X Y: class):
  $ wceq F (crn (cmpt x3 X (cop A2 B2))) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel A2 R) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wcel B2 S) $ >
  $ wi (wceq (cv x3) Y) (wceq A2 C) $ >
  $ wi (wceq (cv x3) Y) (wceq B2 D) $ >
  $ wi ph (wfun F) $ >
  $ wi (wa ph (wcel Y X)) (wceq (cfv C F) D) $;

--| Equality theorem for isomorphisms. (Contributed by NM, 17-May-2004.)
theorem isoeq1 (A2 B2 R S G H: class):
  $ wi (wceq H G) (wb (wiso A2 B2 R S H) (wiso A2 B2 R S G)) $;

--| Equality theorem for isomorphisms. (Contributed by NM, 17-May-2004.)
theorem isoeq2 (A2 B2 R S T H: class):
  $ wi (wceq R T) (wb (wiso A2 B2 R S H) (wiso A2 B2 T S H)) $;

--| Equality theorem for isomorphisms. (Contributed by NM, 17-May-2004.)
theorem isoeq3 (A2 B2 R S T H: class):
  $ wi (wceq S T) (wb (wiso A2 B2 R S H) (wiso A2 B2 R T H)) $;

--| Equality theorem for isomorphisms. (Contributed by NM, 17-May-2004.)
theorem isoeq4 (A2 B2 C R S H: class):
  $ wi (wceq A2 C) (wb (wiso A2 B2 R S H) (wiso C B2 R S H)) $;

--| Equality theorem for isomorphisms. (Contributed by NM, 17-May-2004.)
theorem isoeq5 (A2 B2 C R S H: class):
  $ wi (wceq B2 C) (wb (wiso A2 B2 R S H) (wiso A2 C R S H)) $;

--| Bound-variable hypothesis builder for an isomorphism. (Contributed by NM, 17-May-2004.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem nfiso {x3: setvar} (A2 B2 R S H: class x3):
  $ wnfc x3 H $ >
  $ wnfc x3 R $ >
  $ wnfc x3 S $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnf x3 (wiso A2 B2 R S H) $;

--| An isomorphism is a one-to-one onto function. (Contributed by NM, 27-Apr-2004.)
theorem isof1o (A2 B2 R S H: class):
  $ wi (wiso A2 B2 R S H) (wf1o A2 B2 H) $;

--| A function is a bijection iff it is an isomorphism regarding the identity relation. (Contributed by AV, 9-May-2021.)
theorem isof1oidb (A2 B2 H: class):
  $ wb (wf1o A2 B2 H) (wiso A2 B2 cid cid H) $;

--| A function is a bijection iff it is an isomorphism regarding the universal class of ordered pairs as relations. (Contributed by AV, 9-May-2021.)
theorem isof1oopb (A2 B2 H: class):
  $ wb (wf1o A2 B2 H) (wiso A2 B2 (cxp cvv cvv) (cxp cvv cvv) H) $;

--| An isomorphism connects binary relations via its function values. (Contributed by NM, 27-Apr-2004.)
theorem isorel (A2 B2 C D R S H: class):
  $ wi (wa (wiso A2 B2 R S H) (wa (wcel C A2) (wcel D A2))) (wb (wbr C D R) (wbr (cfv C H) (cfv D H) S)) $;

--| Express the condition of isomorphism on two strict orders for a function's restriction. (Contributed by Mario Carneiro, 22-Jan-2015.)
theorem soisores {x3 y1: setvar} (A2: class) (B2 C: class x3 y1) (R S F: class):
  $ wi (wa (wa (wor B2 R) (wor C S)) (wa (wf B2 C F) (wss A2 B2))) (wb (wiso A2 (cima F A2) R S (cres F A2)) (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) R) (wbr (cfv (cv x3) F) (cfv (cv y1) F) S)) A2) A2)) $;

--| Infer isomorphism from one direction of an order proof for isomorphisms between strict orders. (Contributed by Stefan O'Rear, 2-Nov-2014.)
theorem soisoi {x3 y1: setvar} (A2 B2 R S H: class):
  $ wi (wa (wa (wor A2 R) (wpo B2 S)) (wa (wfo A2 B2 H) (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) R) (wbr (cfv (cv x3) H) (cfv (cv y1) H) S)) A2) A2))) (wiso A2 B2 R S H) $;

--| Identity law for isomorphism. Proposition 6.30(1) of [TakeutiZaring] p. 33. (Contributed by NM, 27-Apr-2004.)
theorem isoid (A2 R: class):
  $ wiso A2 A2 R R (cres cid A2) $;

--| Converse law for isomorphism. Proposition 6.30(2) of [TakeutiZaring] p. 33. (Contributed by NM, 27-Apr-2004.)
theorem isocnv (A2 B2 R S H: class):
  $ wi (wiso A2 B2 R S H) (wiso B2 A2 S R (ccnv H)) $;

--| Converse law for isomorphism. (Contributed by Mario Carneiro, 30-Jan-2014.)
theorem isocnv2 (A2 B2 R S H: class):
  $ wb (wiso A2 B2 R S H) (wiso A2 B2 (ccnv R) (ccnv S) H) $;

--| Complementation law for isomorphism. (Contributed by Mario Carneiro, 9-Sep-2015.)
theorem isocnv3 (A2 B2 C D R S H: class):
  $ wceq C (cdif (cxp A2 A2) R) $ >
  $ wceq D (cdif (cxp B2 B2) S) $ >
  $ wb (wiso A2 B2 R S H) (wiso A2 B2 C D H) $;

--| An isomorphism from one well-order to another can be restricted on either well-order. (Contributed by Mario Carneiro, 15-Jan-2013.)
theorem isores2 (A2 B2 R S H: class):
  $ wb (wiso A2 B2 R S H) (wiso A2 B2 R (cin S (cxp B2 B2)) H) $;

--| An isomorphism from one well-order to another can be restricted on either well-order. (Contributed by Mario Carneiro, 15-Jan-2013.)
theorem isores1 (A2 B2 R S H: class):
  $ wb (wiso A2 B2 R S H) (wiso A2 B2 (cin R (cxp A2 A2)) S H) $;

--| Induced isomorphism on a subset. (Contributed by Stefan O'Rear, 5-Nov-2014.)
theorem isores3 (A2 B2 R S H K X: class):
  $ wi (w3a (wiso A2 B2 R S H) (wss K A2) (wceq X (cima H K))) (wiso K X R S (cres H K)) $;

--| Composition (transitive) law for isomorphism. Proposition 6.30(3) of [TakeutiZaring] p. 33. (Contributed by NM, 27-Apr-2004.) (Proof shortened by Mario Carneiro, 5-Dec-2016.)
theorem isotr (A2 B2 C R S T G H: class):
  $ wi (wa (wiso A2 B2 R S H) (wiso B2 C S T G)) (wiso A2 C R T (ccom G H)) $;

--| Isomorphisms preserve minimal elements. Note that ` ( ``' R " { D } ) ` is Takeuti and Zaring's idiom for the initial segment ` { x | x R D } ` . Proposition 6.31(1) of [TakeutiZaring] p. 33. (Contributed by NM, 19-Apr-2004.)
theorem isomin (A2 B2 C D R S H: class):
  $ wi (wa (wiso A2 B2 R S H) (wa (wss C A2) (wcel D A2))) (wb (wceq (cin C (cima (ccnv R) (csn D))) c0) (wceq (cin (cima H C) (cima (ccnv S) (csn (cfv D H)))) c0)) $;

--| Isomorphisms preserve initial segments. Proposition 6.31(2) of [TakeutiZaring] p. 33. (Contributed by NM, 20-Apr-2004.)
theorem isoini (A2 B2 D R S H: class):
  $ wi (wa (wiso A2 B2 R S H) (wcel D A2)) (wceq (cima H (cin A2 (cima (ccnv R) (csn D)))) (cin B2 (cima (ccnv S) (csn (cfv D H))))) $;

--| Isomorphisms are isomorphisms on their initial segments. (Contributed by Mario Carneiro, 29-Mar-2014.)
theorem isoini2 (A2 B2 C D R S H X: class):
  $ wceq C (cin A2 (cima (ccnv R) (csn X))) $ >
  $ wceq D (cin B2 (cima (ccnv S) (csn (cfv X H)))) $ >
  $ wi (wa (wiso A2 B2 R S H) (wcel X A2)) (wiso C D R S (cres H C)) $;

--| Lemma for ~ isofr . (Contributed by NM, 29-Apr-2004.) (Revised by Mario Carneiro, 18-Nov-2014.)
theorem isofrlem {x3: setvar} (ph: wff) (A2 B2 R S H: class):
  $ wi ph (wiso A2 B2 R S H) $ >
  $ wi ph (wcel (cima H (cv x3)) cvv) $ >
  $ wi ph (wi (wfr B2 S) (wfr A2 R)) $;

--| Lemma for ~ isose . (Contributed by Mario Carneiro, 23-Jun-2015.)
theorem isoselem {x3: setvar} (ph: wff) (A2 B2 R S H: class):
  $ wi ph (wiso A2 B2 R S H) $ >
  $ wi ph (wcel (cima H (cv x3)) cvv) $ >
  $ wi ph (wi (wse A2 R) (wse B2 S)) $;

--| An isomorphism preserves well-foundedness. Proposition 6.32(1) of [TakeutiZaring] p. 33. (Contributed by NM, 30-Apr-2004.) (Revised by Mario Carneiro, 18-Nov-2014.)
theorem isofr (A2 B2 R S H: class):
  $ wi (wiso A2 B2 R S H) (wb (wfr A2 R) (wfr B2 S)) $;

--| An isomorphism preserves set-like relations. (Contributed by Mario Carneiro, 23-Jun-2015.)
theorem isose (A2 B2 R S H: class):
  $ wi (wiso A2 B2 R S H) (wb (wse A2 R) (wse B2 S)) $;

--| A weak form of ~ isofr that does not need Replacement. (Contributed by Mario Carneiro, 18-Nov-2014.)
theorem isofr2 (A2 B2 R S H V: class):
  $ wi (wa (wiso A2 B2 R S H) (wcel B2 V)) (wi (wfr B2 S) (wfr A2 R)) $;

--| Lemma for ~ isopo . (Contributed by Stefan O'Rear, 16-Nov-2014.)
theorem isopolem (A2 B2 R S H: class):
  $ wi (wiso A2 B2 R S H) (wi (wpo B2 S) (wpo A2 R)) $;

--| An isomorphism preserves the property of being a partial order. (Contributed by Stefan O'Rear, 16-Nov-2014.)
theorem isopo (A2 B2 R S H: class):
  $ wi (wiso A2 B2 R S H) (wb (wpo A2 R) (wpo B2 S)) $;

--| Lemma for ~ isoso . (Contributed by Stefan O'Rear, 16-Nov-2014.)
theorem isosolem (A2 B2 R S H: class):
  $ wi (wiso A2 B2 R S H) (wi (wor B2 S) (wor A2 R)) $;

--| An isomorphism preserves the property of being a strict total order. (Contributed by Stefan O'Rear, 16-Nov-2014.)
theorem isoso (A2 B2 R S H: class):
  $ wi (wiso A2 B2 R S H) (wb (wor A2 R) (wor B2 S)) $;

--| An isomorphism preserves the property of being a well-ordering. Proposition 6.32(3) of [TakeutiZaring] p. 33. (Contributed by NM, 30-Apr-2004.) (Revised by Mario Carneiro, 18-Nov-2014.)
theorem isowe (A2 B2 R S H: class):
  $ wi (wiso A2 B2 R S H) (wb (wwe A2 R) (wwe B2 S)) $;

--| A weak form of ~ isowe that does not need Replacement. (Contributed by Mario Carneiro, 18-Nov-2014.)
theorem isowe2 {x3: setvar} (A2 B2 R S H: class):
  $ wi (wa (wiso A2 B2 R S H) (wal x3 (wcel (cima H (cv x3)) cvv))) (wi (wwe B2 S) (wwe A2 R)) $;

--| Any one-to-one onto function determines an isomorphism with an induced relation ` S ` . Proposition 6.33 of [TakeutiZaring] p. 34. (Contributed by NM, 30-Apr-2004.)
theorem f1oiso {x3 y1 z w: setvar} (A2: class) (B2: class z w) (R: class) (S: class x3 y1 z w) (H: class):
  $ wi (wa (wf1o A2 B2 H) (wceq S (copab z w (wrex x3 (wrex y1 (wa (wa (wceq (cv z) (cfv (cv x3) H)) (wceq (cv w) (cfv (cv y1) H))) (wbr (cv x3) (cv y1) R)) A2) A2)))) (wiso A2 B2 R S H) $;

--| Any one-to-one onto function determines an isomorphism with an induced relation ` S ` . (Contributed by Mario Carneiro, 9-Mar-2013.)
theorem f1oiso2 {x3 y1: setvar} (A2 B2 R: class) (S: class x3 y1) (H: class):
  $ wceq S (copab x3 y1 (wa (wa (wcel (cv x3) B2) (wcel (cv y1) B2)) (wbr (cfv (cv x3) (ccnv H)) (cfv (cv y1) (ccnv H)) R))) $ >
  $ wi (wf1o A2 B2 H) (wiso A2 B2 R S H) $;

--| Well-ordering of isomorphic relations. (Contributed by NM, 4-Mar-1997.) Strengthen to biconditional. (Revised by Eric Schmidt, 5-Aug-2026.)
theorem f1owe {x3 y1: setvar} (A2 B2 R: class x3 y1) (S F: class):
  $ wceq R (copab x3 y1 (wbr (cfv (cv x3) F) (cfv (cv y1) F) S)) $ >
  $ wi (wf1o A2 B2 F) (wb (wwe A2 R) (wwe B2 S)) $;

--| Obsolete version of f1owe as of 5-Aug-2026. (Contributed by NM, 4-Mar-1997.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem f1oweOLD {x3 y1: setvar} (A2 B2 R: class x3 y1) (S F: class):
  $ wceq R (copab x3 y1 (wbr (cfv (cv x3) F) (cfv (cv y1) F) S)) $ >
  $ wi (wf1o A2 B2 F) (wi (wwe B2 S) (wwe A2 R)) $;

--| Pull back a well ordering by a one-to-one function. (Contributed by Eric Schmidt, 4-Aug-2026.)
theorem f1we {x3 y1: setvar} (A2 B2 R: class x3 y1) (S F: class):
  $ wceq R (copab x3 y1 (wbr (cfv (cv x3) F) (cfv (cv y1) F) S)) $ >
  $ wi (wf1 A2 B2 F) (wi (wwe B2 S) (wwe A2 R)) $;

--| A set-like well-ordering has no nontrivial automorphisms. (Contributed by Stefan O'Rear, 16-Nov-2014.) (Revised by Mario Carneiro, 25-Jun-2015.)
theorem weniso (A2 R F: class):
  $ wi (w3a (wwe A2 R) (wse A2 R) (wiso A2 A2 R R F)) (wceq F (cres cid A2)) $;

--| Thus, there is at most one isomorphism between any two set-like well-ordered classes. Class version of ~ wemoiso . (Contributed by Mario Carneiro, 25-Jun-2015.)
theorem weisoeq (A2 B2 R S F G: class):
  $ wi (wa (wa (wwe A2 R) (wse A2 R)) (wa (wiso A2 B2 R S F) (wiso A2 B2 R S G))) (wceq F G) $;

--| Thus, there is at most one isomorphism between any two set-like well-ordered classes. Class version of ~ wemoiso2 . (Contributed by Mario Carneiro, 25-Jun-2015.)
theorem weisoeq2 (A2 B2 R S F G: class):
  $ wi (wa (wa (wwe B2 S) (wse B2 S)) (wa (wiso A2 B2 R S F) (wiso A2 B2 R S G))) (wceq F G) $;

--| The Knaster-Tarski theorem says that every monotone function over a complete lattice has a (least) fixpoint. Here we specialize this theorem to the case when the lattice is the powerset lattice ` ~P A ` . (Contributed by Mario Carneiro, 11-Jun-2015.)
theorem knatar {x3 y1 z: setvar} (A2 F: class) (V: class x3 y1 z) (X: class z):
  $ wceq X (cint (crab z (wss (cfv (cv z) F) (cv z)) (cpw A2))) $ >
  $ wi (w3a (wcel A2 V) (wss (cfv A2 F) A2) (wral x3 (wral y1 (wss (cfv (cv y1) F) (cfv (cv x3) F)) (cpw (cv x3))) (cpw A2))) (wa (wss X A2) (wceq (cfv X F) X)) $;

--| The value of a restricted function at a class is either the empty set or the value of the unrestricted function at that class. (Contributed by Scott Fenton, 4-Sep-2011.)
theorem fvresval (A2 B2 F: class):
  $ wo (wceq (cfv A2 (cres F B2)) (cfv A2 F)) (wceq (cfv A2 (cres F B2)) c0) $;

--| If ` (/) ` is not part of the range of a function ` F ` , then ` A ` is in the domain of ` F ` iff ` ( F `` A ) =/= (/) ` . (Contributed by Scott Fenton, 7-Dec-2021.)
theorem funeldmb (A2 F: class):
  $ wi (wa (wfun F) (wn (wcel c0 (crn F)))) (wb (wcel A2 (cdm F)) (wne (cfv A2 F) c0)) $;

--| Law for adjoining an element to restrictions of functions. (Contributed by Scott Fenton, 6-Dec-2021.)
theorem eqfunresadj (F G X Y: class):
  $ wi (w3a (wa (wfun F) (wfun G)) (wceq (cres F X) (cres G X)) (w3a (wcel Y (cdm F)) (wcel Y (cdm G)) (wceq (cfv Y F) (cfv Y G)))) (wceq (cres F (cun X (csn Y))) (cres G (cun X (csn Y)))) $;

--| Law for equality of restriction to successors. This is primarily useful when ` X ` is an ordinal, but it does not require that. (Contributed by Scott Fenton, 6-Dec-2021.)
theorem eqfunressuc (F G X: class):
  $ wi (w3a (wa (wfun F) (wfun G)) (wceq (cres F X) (cres G X)) (w3a (wcel X (cdm F)) (wcel X (cdm G)) (wceq (cfv X F) (cfv X G)))) (wceq (cres F (csuc X)) (cres G (csuc X))) $;

--| Condition for subset of an intersection of an image. (Contributed by Scott Fenton, 16-Aug-2024.)
theorem fnssintima {x3: setvar} (A2: class x3) (B2 C F: class):
  $ wi (wa (wfn F A2) (wss B2 A2)) (wb (wss C (cint (cima F B2))) (wral x3 (wss C (cfv (cv x3) F)) B2)) $;

--| The image of a function by a singleton whose element is in the domain of the function. (Contributed by Steven Nguyen, 7-Jun-2023.)
theorem fnimasnd (ph: wff) (A2 S F: class):
  $ wi ph (wfn F A2) $ >
  $ wi ph (wcel S A2) $ >
  $ wi ph (wceq (cima F (csn S)) (csn (cfv S F))) $;

--| No set ` A ` is equinumerous to its power set (Cantor's theorem), i.e., no function can map ` A ` onto its power set. Compare Theorem 6B(b) of [Enderton] p. 132. For the equinumerosity version, see ~ canth2 . Note that ` A ` must be a set: this theorem does not hold when ` A ` is too large to be a set; see ~ ncanth for a counterexample. (Use ~ nex if you want the form ` -. E. f f : A -onto-> ~P A ` .) (Contributed by NM, 7-Aug-1994.) (Proof shortened by Mario Carneiro, 7-Jun-2016.)
theorem canth (A2 F: class):
  $ wcel A2 cvv $ >
  $ wn (wfo A2 (cpw A2) F) $;

--| Cantor's theorem fails for the universal class (which is not a set but a proper class by ~ vprc ). Specifically, the identity function maps the universe onto its power class. Compare ~ canth that works for sets. This failure comes from a limitation of the collection principle (which is necessary to avoid Russell's paradox ~ ru ): ` ~P _V ` , being a class, cannot contain proper classes, so it is no larger than ` _V ` , which is why the identity function "succeeds" in being surjective onto ` ~P _V ` (see ~ pwv ). See also the remark in ~ ru about NF, in which Cantor's theorem fails for sets that are "too large". This theorem gives some intuition behind that failure: in NF the universal class is a set, and it equals its own power set. (Contributed by NM, 29-Jun-2004.) (Proof shortened by BJ, 29-Dec-2023.)
theorem ncanth:
  $ wfo cvv (cpw cvv) cid $;

--| Extend class notation with restricted description binder.
term crio {x3: setvar} (ph: wff x3) (A2: class x3): class;

--| Define restricted description binder. In case there is no unique ` x ` such that ` ( x e. A /\ ph ) ` holds, it evaluates to the empty set. See also comments for ~ df-iota . (Contributed by NM, 15-Sep-2011.) (Revised by Mario Carneiro, 15-Oct-2016.) (Revised by NM, 2-Sep-2018.)
axiom df_riota {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wceq (crio x3 ph A2) (cio x3 (wa (wcel (cv x3) A2) ph)) $;

--| Formula-building deduction for iota. (Contributed by NM, 15-Sep-2011.)
theorem riotaeqdv {x3: setvar} (ph: wff) (ps: wff x3) (A2 B2: class x3):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (crio x3 ps A2) (crio x3 ps B2)) $;

--| Formula-building deduction for restricted iota. (Contributed by NM, 15-Sep-2011.)
theorem riotabidv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wceq (crio x3 ps A2) (crio x3 ch A2)) $;

--| Equality deduction for restricted universal quantifier. (Contributed by NM, 15-Sep-2011.)
theorem riotaeqbidv {x3: setvar} (ph: wff) (ps ch: wff x3) (A2 B2: class x3):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wceq (crio x3 ps A2) (crio x3 ch B2)) $;

--| Restricted iota is a set. (Contributed by NM, 15-Sep-2011.)
theorem riotaex {x3: setvar} (ps: wff x3) (A2: class x3):
  $ wcel (crio x3 ps A2) cvv $;

--| An iota restricted to the universe is unrestricted. (Contributed by NM, 18-Sep-2011.)
theorem riotav {x3: setvar} (ph: wff x3):
  $ wceq (crio x3 ph cvv) (cio x3 ph) $;

--| Restricted iota in terms of class union. (Contributed by NM, 11-Oct-2011.)
theorem riotauni {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wreu x3 ph A2) (wceq (crio x3 ph A2) (cuni (crab x3 ph A2))) $;

--| The abstraction variable in a restricted iota descriptor isn't free. (Contributed by NM, 12-Oct-2011.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem nfriota1 {x3: setvar} (ph: wff x3) (A2: class):
  $ wnfc x3 (crio x3 ph A2) $;

--| Deduction version of ~ nfriota with a disjoint variable condition, which contrary to ~ nfriotad does not require ~ ax-13 . (Contributed by NM, 18-Feb-2013.) Avoid ~ ax-13 . (Revised by GG, 26-Jan-2024.)
theorem nfriotadw {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3 y1):
  $ wnf y1 ph $ >
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 (crio y1 ps A2)) $;

--| Change bound variable in a restricted description binder. Version of ~ cbvriota with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by NM, 18-Mar-2013.) Avoid ~ ax-13 . (Revised by GG, 26-Jan-2024.)
theorem cbvriotaw {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wceq (crio x3 ph A2) (crio y1 ps A2) $;

--| Change bound variable in a restricted description binder. Version of ~ cbvriotav with a disjoint variable condition, which requires fewer axioms . (Contributed by NM, 18-Mar-2013.) (Revised by GG, 30-Sep-2024.)
theorem cbvriotavw {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wceq (crio x3 ph A2) (crio y1 ps A2) $;

--| Deduction version of ~ nfriota . Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ nfriotadw when possible. (Contributed by NM, 18-Feb-2013.) (Revised by Mario Carneiro, 15-Oct-2016.) (New usage is discouraged.)
theorem nfriotad {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3 y1):
  $ wnf y1 ph $ >
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 (crio y1 ps A2)) $;

--| A variable not free in a wff remains so in a restricted iota descriptor. (Contributed by NM, 12-Oct-2011.)
theorem nfriota {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wnf x3 ph $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 (crio y1 ph A2) $;

--| Change bound variable in a restricted description binder. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ cbvriotaw when possible. (Contributed by NM, 18-Mar-2013.) (Revised by Mario Carneiro, 15-Oct-2016.) (New usage is discouraged.)
theorem cbvriota {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class):
  $ wnf y1 ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wceq (crio x3 ph A2) (crio y1 ps A2) $;

--| Change bound variable in a restricted description binder. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ cbvriotavw when possible. (Contributed by NM, 18-Mar-2013.) (Revised by Mario Carneiro, 15-Oct-2016.) (New usage is discouraged.)
theorem cbvriotav {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (A2: class):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wceq (crio x3 ph A2) (crio y1 ps A2) $;

--| Interchange class substitution and restricted description binder. (Contributed by NM, 24-Feb-2013.) (Revised by NM, 2-Sep-2018.)
theorem csbriota {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class y1):
  $ wceq (csb x3 A2 (crio y1 ph B2)) (crio y1 (wsbc x3 ph A2) B2) $;

--| Membership law for "the unique element in ` A ` such that ` ph ` ". (Contributed by NM, 21-Aug-2011.) (Revised by Mario Carneiro, 23-Dec-2016.)
theorem riotacl2 {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wreu x3 ph A2) (wcel (crio x3 ph A2) (crab x3 ph A2)) $;

--| Closure of restricted iota. (Contributed by NM, 21-Aug-2011.)
theorem riotacl {x3: setvar} (ph: wff x3) (A2: class):
  $ wi (wreu x3 ph A2) (wcel (crio x3 ph A2) A2) $;

--| Substitution law for descriptions. Compare ~ iotasbc . (Contributed by NM, 23-Aug-2011.) (Proof shortened by Mario Carneiro, 24-Dec-2016.)
theorem riotasbc {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wreu x3 ph A2) (wsbc x3 ph (crio x3 ph A2)) $;

--| Equivalent wff's yield equal restricted class abstractions (deduction form). ( ~ rabbidva analog.) (Contributed by NM, 17-Jan-2012.)
theorem riotabidva {x3: setvar} (ph: wff) (ps ch: wff x3) (A2: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wceq (crio x3 ps A2) (crio x3 ch A2)) $;

--| Equivalent wff's yield equal restricted iotas (inference form). ( ~ rabbiia analog.) (Contributed by NM, 16-Jan-2012.)
theorem riotabiia {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wcel (cv x3) A2) (wb ph ps) $ >
  $ wceq (crio x3 ph A2) (crio x3 ps A2) $;

--| Property of restricted iota. Compare ~ iota1 . (Contributed by Mario Carneiro, 15-Oct-2016.)
theorem riota1 {x3: setvar} (ph: wff x3) (A2: class):
  $ wi (wreu x3 ph A2) (wb (wa (wcel (cv x3) A2) ph) (wceq (crio x3 ph A2) (cv x3))) $;

--| Property of iota. (Contributed by NM, 23-Aug-2011.)
theorem riota1a {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wa (wcel (cv x3) A2) (wreu x3 ph A2)) (wb ph (wceq (cio x3 (wa (wcel (cv x3) A2) ph)) (cv x3))) $;

--| A deduction version of ~ riota2f . (Contributed by NM, 17-Feb-2013.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem riota2df {x3: setvar} (ph ps ch: wff x3) (A2: class) (B2: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wnfc x3 B2) $ >
  $ wi ph (wnf x3 ch) $ >
  $ wi ph (wcel B2 A2) $ >
  $ wi (wa ph (wceq (cv x3) B2)) (wb ps ch) $ >
  $ wi (wa ph (wreu x3 ps A2)) (wb ch (wceq (crio x3 ps A2) B2)) $;

--| This theorem shows a condition that allows to represent a descriptor with a class expression ` B ` . (Contributed by NM, 23-Aug-2011.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem riota2f {x3: setvar} (ph ps: wff x3) (A2: class) (B2: class x3):
  $ wnfc x3 B2 $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) B2) (wb ph ps) $ >
  $ wi (wa (wcel B2 A2) (wreu x3 ph A2)) (wb ps (wceq (crio x3 ph A2) B2)) $;

--| This theorem shows a condition that allows to represent a descriptor with a class expression ` B ` . (Contributed by NM, 23-Aug-2011.) (Revised by Mario Carneiro, 10-Dec-2016.)
theorem riota2 {x3: setvar} (ph: wff x3) (ps: wff) (A2 B2: class):
  $ wi (wceq (cv x3) B2) (wb ph ps) $ >
  $ wi (wa (wcel B2 A2) (wreu x3 ph A2)) (wb ps (wceq (crio x3 ph A2) B2)) $;

--| If two restricted iota descriptors for an equality are equal, then the terms of the equality are equal. (Contributed by AV, 6-Dec-2020.)
theorem riotaeqimp {a: setvar} (ph: wff a) (A2: class a) (I J V X Y: class):
  $ wceq I (crio a (wceq X A2) V) $ >
  $ wceq J (crio a (wceq Y A2) V) $ >
  $ wi ph (wreu a (wceq X A2) V) $ >
  $ wi ph (wreu a (wceq Y A2) V) $ >
  $ wi (wa ph (wceq I J)) (wceq X Y) $;

--| Properties of a restricted definite description operator. (Contributed by NM, 23-Nov-2013.)
theorem riotaprop {x3: setvar} (ph ps: wff x3) (A2: class) (B2: class x3):
  $ wnf x3 ps $ >
  $ wceq B2 (crio x3 ph A2) $ >
  $ wi (wceq (cv x3) B2) (wb ph ps) $ >
  $ wi (wreu x3 ph A2) (wa (wcel B2 A2) ps) $;

--| A method for computing restricted iota. (Contributed by NM, 16-Apr-2013.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem riota5f {x3: setvar} (ph: wff) (ps: wff x3) (A2: class) (B2: class x3):
  $ wi ph (wnfc x3 B2) $ >
  $ wi ph (wcel B2 A2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps (wceq (cv x3) B2)) $ >
  $ wi ph (wceq (crio x3 ps A2) B2) $;

--| A method for computing restricted iota. (Contributed by NM, 20-Oct-2011.) (Revised by Mario Carneiro, 6-Dec-2016.)
theorem riota5 {x3: setvar} (ph: wff) (ps: wff x3) (A2 B2: class):
  $ wi ph (wcel B2 A2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps (wceq (cv x3) B2)) $ >
  $ wi ph (wceq (crio x3 ps A2) B2) $;

--| Restriction of a unique element to a smaller class. (Contributed by NM, 21-Aug-2011.) (Revised by NM, 22-Mar-2013.)
theorem riotass2 {x3: setvar} (ph ps: wff x3) (A2 B2: class):
  $ wi (wa (wa (wss A2 B2) (wral x3 (wi ph ps) A2)) (wa (wrex x3 ph A2) (wreu x3 ps B2))) (wceq (crio x3 ph A2) (crio x3 ps B2)) $;

--| Restriction of a unique element to a smaller class. (Contributed by NM, 19-Oct-2005.) (Revised by Mario Carneiro, 24-Dec-2016.)
theorem riotass {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (w3a (wss A2 B2) (wrex x3 ph A2) (wreu x3 ph B2)) (wceq (crio x3 ph A2) (crio x3 ph B2)) $;

--| Restriction of a unique element to a smaller class. (Contributed by NM, 19-Feb-2006.) (Revised by NM, 16-Jun-2017.)
theorem moriotass {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi (w3a (wss A2 B2) (wrex x3 ph A2) (wrmo x3 ph B2)) (wceq (crio x3 ph A2) (crio x3 ph B2)) $;

--| A restricted class abstraction with a unique member can be expressed as a singleton. (Contributed by NM, 30-May-2006.)
theorem snriota {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi (wreu x3 ph A2) (wceq (crab x3 ph A2) (csn (crio x3 ph A2))) $;

--| Change the variable ` x ` in the expression for "the unique ` x ` such that ` ps ` " to another variable ` y ` contained in expression ` B ` . Use ~ reuhypd to eliminate the last hypothesis. (Contributed by NM, 16-Jan-2012.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem riotaxfrd {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (A2: class) (B2 C: class y1):
  $ wnfc y1 C $ >
  $ wi (wa ph (wcel (cv y1) A2)) (wcel B2 A2) $ >
  $ wi (wa ph (wcel (crio y1 ch A2) A2)) (wcel C A2) $ >
  $ wi (wceq (cv x3) B2) (wb ps ch) $ >
  $ wi (wceq (cv y1) (crio y1 ch A2)) (wceq B2 C) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wreu y1 (wceq (cv x3) B2) A2) $ >
  $ wi (wa ph (wreu x3 ps A2)) (wceq (crio x3 ps A2) C) $;

--| Specify the same property in two ways when class ` B ( y ) ` is single-valued. (Contributed by NM, 1-Nov-2010.) (Proof shortened by Mario Carneiro, 24-Dec-2016.)
theorem eusvobj2 {x3 y1: setvar} (A2: class) (B2: class y1):
  $ wcel B2 cvv $ >
  $ wi (weu x3 (wrex y1 (wceq (cv x3) B2) A2)) (wb (wrex y1 (wceq (cv x3) B2) A2) (wral y1 (wceq (cv x3) B2) A2)) $;

--| Specify the same object in two ways when class ` B ( y ) ` is single-valued. (Contributed by NM, 1-Nov-2010.) (Proof shortened by Mario Carneiro, 19-Nov-2016.)
theorem eusvobj1 {x3 y1: setvar} (A2: class) (B2: class y1):
  $ wcel B2 cvv $ >
  $ wi (weu x3 (wrex y1 (wceq (cv x3) B2) A2)) (wceq (cio x3 (wrex y1 (wceq (cv x3) B2) A2)) (cio x3 (wral y1 (wceq (cv x3) B2) A2))) $;

--| There is one domain element for each value of a one-to-one onto function. (Contributed by NM, 26-May-2006.)
theorem f1ofveu {x3: setvar} (A2 B2 C F: class):
  $ wi (wa (wf1o A2 B2 F) (wcel C B2)) (wreu x3 (wceq (cfv (cv x3) F) C) A2) $;

--| Value of the converse of a one-to-one onto function. (Contributed by NM, 26-May-2006.) (Proof shortened by Mario Carneiro, 24-Dec-2016.)
theorem f1ocnvfv3 {x3: setvar} (A2 B2 C F: class):
  $ wi (wa (wf1o A2 B2 F) (wcel C B2)) (wceq (cfv C (ccnv F)) (crio x3 (wceq (cfv (cv x3) F) C) A2)) $;

--| Restricted iota equals the empty set when not meaningful. (Contributed by NM, 16-Jan-2012.) (Revised by Mario Carneiro, 15-Oct-2016.) (Revised by NM, 13-Sep-2018.)
theorem riotaund {x3: setvar} (ph: wff x3) (A2: class):
  $ wi (wn (wreu x3 ph A2)) (wceq (crio x3 ph A2) c0) $;

--| The restricted iota class is limited in size by the base set. (Contributed by Mario Carneiro, 24-Dec-2016.)
theorem riotassuni {x3: setvar} (ph: wff x3) (A2: class):
  $ wss (crio x3 ph A2) (cun (cpw (cuni A2)) (cuni A2)) $;

--| Bidirectional closure of restricted iota when domain is not empty. (Contributed by NM, 28-Feb-2013.) (Revised by Mario Carneiro, 24-Dec-2016.) (Revised by NM, 13-Sep-2018.)
theorem riotaclb {x3: setvar} (ph: wff x3) (A2: class):
  $ wi (wn (wcel c0 A2)) (wb (wreu x3 ph A2) (wcel (crio x3 ph A2) A2)) $;

--| Restricted iota of a restricted abstraction. (Contributed by Scott Fenton, 8-Aug-2024.)
theorem riotarab {x3 y1: setvar} (ph: wff x3) (ps ch: wff x3 y1) (A2: class x3):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wceq (crio x3 ch (crab y1 ps A2)) (crio x3 (wa ph ch) A2) $;

--| Extend class notation to include the value of an operation ` F ` (such as ` + ` ) for two arguments ` A ` and ` B ` . Note that the syntax is simply three class symbols in a row surrounded by parentheses. Since operation values are the only possible class expressions consisting of three class expressions in a row surrounded by parentheses, the syntax is unambiguous. (For an example of how syntax could become ambiguous if we are not careful, see the comment in ~ cneg .)
term co (A2 B2 F: class): class;

--| Extend class notation to include class abstraction (class builder) of nested ordered pairs.
term coprab {x3 y1 z: setvar} (ph: wff x3 y1 z): class;

--| Extend the definition of a class to include maps-to notation for defining an operation via a rule.
term cmpo {x3 y1: setvar} (A2 B2 C: class x3 y1): class;

--| Define the value of an operation. Definition of operation value in [Enderton] p. 79. Note that the syntax is simply three class expressions in a row bracketed by parentheses. There are no restrictions of any kind on what those class expressions may be, although only certain kinds of class expressions - a binary operation ` F ` and its arguments ` A ` and ` B ` - will be useful for proving meaningful theorems. For example, if class ` F ` is the operation ` + ` and arguments ` A ` and ` B ` are ` 3 ` and ` 2 ` , the expression ` ( 3 + 2 ) ` can be proved to equal ` 5 ` (see ~ 3p2e5 ). This definition is well-defined, although not very meaningful, when classes ` A ` and/or ` B ` are proper classes (i.e. are not sets); see ~ ovprc1 and ~ ovprc2 . On the other hand, we often find uses for this definition when ` F ` is a proper class, such as ` +o ` in ~ oav . ` F ` is normally equal to a class of nested ordered pairs of the form defined by ~ df-oprab . (Contributed by NM, 28-Feb-1995.)
axiom df_ov (A2 B2 F: class):
  $ wceq (co A2 B2 F) (cfv (cop A2 B2) F) $;

--| Define the class abstraction (class builder) of a collection of nested ordered pairs (for use in defining operations). This is a special case of Definition 4.16 of [TakeutiZaring] p. 14. Normally ` x ` , ` y ` , and ` z ` are distinct, although the definition doesn't strictly require it. See ~ df-ov for the value of an operation. The brace notation is called "class abstraction" by Quine; it is also called a "class builder" in the literature. The value of an operation given by a class abstraction is given by ~ ovmpo . (Contributed by NM, 12-Mar-1995.)
axiom df_oprab {x3 y1 z w: setvar} (ph: wff x3 y1 z):
  $ wceq (coprab x3 y1 z ph) (cab w (wex x3 (wex y1 (wex z (wa (wceq (cv w) (cop (cop (cv x3) (cv y1)) (cv z))) ph))))) $;

--| Define maps-to notation for defining an operation via a rule. Read as "the operation defined by the map from ` x , y ` (in ` A X. B ` ) to ` C ( x , y ) ` ". An extension of ~ df-mpt for two arguments. (Contributed by NM, 17-Feb-2008.)
axiom df_mpo {x3 y1 z: setvar} (A2 B2 C: class x3 y1):
  $ wceq (cmpo x3 y1 A2 B2 C) (coprab x3 y1 z (wa (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) (wceq (cv z) C))) $;

--| Equality theorem for operation value. (Contributed by NM, 28-Feb-1995.)
theorem oveq (A2 B2 F G: class):
  $ wi (wceq F G) (wceq (co A2 B2 F) (co A2 B2 G)) $;

--| Equality theorem for operation value. (Contributed by NM, 28-Feb-1995.)
theorem oveq1 (A2 B2 C F: class):
  $ wi (wceq A2 B2) (wceq (co A2 C F) (co B2 C F)) $;

--| Equality theorem for operation value. (Contributed by NM, 28-Feb-1995.)
theorem oveq2 (A2 B2 C F: class):
  $ wi (wceq A2 B2) (wceq (co C A2 F) (co C B2 F)) $;

--| Equality theorem for operation value. (Contributed by NM, 16-Jul-1995.)
theorem oveq12 (A2 B2 C D F: class):
  $ wi (wa (wceq A2 B2) (wceq C D)) (wceq (co A2 C F) (co B2 D F)) $;

--| Equality inference for operation value. (Contributed by NM, 28-Feb-1995.)
theorem oveq1i (A2 B2 C F: class):
  $ wceq A2 B2 $ >
  $ wceq (co A2 C F) (co B2 C F) $;

--| Equality inference for operation value. (Contributed by NM, 28-Feb-1995.)
theorem oveq2i (A2 B2 C F: class):
  $ wceq A2 B2 $ >
  $ wceq (co C A2 F) (co C B2 F) $;

--| Equality inference for operation value. (Contributed by NM, 28-Feb-1995.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem oveq12i (A2 B2 C D F: class):
  $ wceq A2 B2 $ >
  $ wceq C D $ >
  $ wceq (co A2 C F) (co B2 D F) $;

--| Equality inference for operation value. (Contributed by NM, 24-Nov-2007.)
theorem oveqi (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq (co C D A2) (co C D B2) $;

--| Equality inference for operation value. (Contributed by FL, 11-Jul-2010.)
theorem oveq123i (A2 B2 C D F G: class):
  $ wceq A2 C $ >
  $ wceq B2 D $ >
  $ wceq F G $ >
  $ wceq (co A2 B2 F) (co C D G) $;

--| Equality deduction for operation value. (Contributed by NM, 13-Mar-1995.)
theorem oveq1d (ph: wff) (A2 B2 C F: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (co A2 C F) (co B2 C F)) $;

--| Equality deduction for operation value. (Contributed by NM, 13-Mar-1995.)
theorem oveq2d (ph: wff) (A2 B2 C F: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (co C A2 F) (co C B2 F)) $;

--| Equality deduction for operation value. (Contributed by NM, 9-Sep-2006.)
theorem oveqd (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (co C D A2) (co C D B2)) $;

--| Equality deduction for operation value. (Contributed by NM, 13-Mar-1995.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem oveq12d (ph: wff) (A2 B2 C D F: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq (co A2 C F) (co B2 D F)) $;

--| Equality deduction for operation value. (Contributed by NM, 10-Aug-1995.)
theorem oveqan12d (ph ps: wff) (A2 B2 C D F: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ps (wceq C D) $ >
  $ wi (wa ph ps) (wceq (co A2 C F) (co B2 D F)) $;

--| Equality deduction for operation value. (Contributed by NM, 10-Aug-1995.)
theorem oveqan12rd (ph ps: wff) (A2 B2 C D F: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ps (wceq C D) $ >
  $ wi (wa ps ph) (wceq (co A2 C F) (co B2 D F)) $;

--| Equality deduction for operation value. (Contributed by FL, 22-Dec-2008.)
theorem oveq123d (ph: wff) (A2 B2 C D F G: class):
  $ wi ph (wceq F G) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq (co A2 C F) (co B2 D G)) $;

--| Equality deduction for nested function and operation value. (Contributed by AV, 23-Jul-2022.)
theorem fvoveq1d (ph: wff) (A2 B2 C F O: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cfv (co A2 C O) F) (cfv (co B2 C O) F)) $;

--| Equality theorem for nested function and operation value. Closed form of ~ fvoveq1d . (Contributed by AV, 23-Jul-2022.)
theorem fvoveq1 (A2 B2 C F O: class):
  $ wi (wceq A2 B2) (wceq (cfv (co A2 C O) F) (cfv (co B2 C O) F)) $;

--| Equality theorem for a conjunction with an operation values within a restricted universal quantification. Technical theorem to be used to reduce the size of a significant number of proofs. (Contributed by AV, 13-Aug-2022.)
theorem ovanraleqv {x3: setvar} (ph ps: wff x3) (A2: class x3) (B2: class) (C c_x V: class x3) (X: class):
  $ wi (wceq B2 X) (wb ph ps) $ >
  $ wi (wceq B2 X) (wb (wral x3 (wa ph (wceq (co A2 B2 c_x) C)) V) (wral x3 (wa ps (wceq (co A2 X c_x) C)) V)) $;

--| Equality theorem for nested function and operation value in an implication for a binary relation. Technical theorem to be used to reduce the size of a significant number of proofs. (Contributed by AV, 17-Aug-2022.)
theorem imbrov2fvoveq (ph ps: wff) (A2 R c_x F G O X Y: class):
  $ wi (wceq X Y) (wb ph ps) $ >
  $ wi (wceq X Y) (wb (wi ph (wbr (cfv (co (cfv X G) O c_x) F) A2 R)) (wi ps (wbr (cfv (co (cfv Y G) O c_x) F) A2 R))) $;

--| If an operation value is an element of a class for all operands of two classes, then the operation value is an element of the class for specific operands of the two classes. (Contributed by Mario Carneiro, 6-Dec-2014.)
theorem ovrspc2v {x3 y1: setvar} (A2 B2 C F X: class) (Y: class x3):
  $ wi (wa (wa (wcel X A2) (wcel Y B2)) (wral x3 (wral y1 (wcel (co (cv x3) (cv y1) F) C) B2) A2)) (wcel (co X Y F) C) $;

--| Restricted specialization of operands, using implicit substitution. (Contributed by Mario Carneiro, 6-Dec-2014.)
theorem oveqrspc2v {x3 y1: setvar} (ph: wff) (A2 B2 F G X: class) (Y: class x3):
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) F) (co (cv x3) (cv y1) G)) $ >
  $ wi (wa ph (wa (wcel X A2) (wcel Y B2))) (wceq (co X Y F) (co X Y G)) $;

--| Equality of two operations for any two operands. Useful in proofs using *propd theorems. (Contributed by Mario Carneiro, 29-Jun-2015.)
theorem oveqdr (ph ps: wff) (x3 y1: setvar) (F G: class):
  $ wi ph (wceq F G) $ >
  $ wi (wa ph ps) (wceq (co (cv x3) (cv y1) F) (co (cv x3) (cv y1) G)) $;

--| Equality of two operations for any two operands. Useful in proofs using *propd theorems. (Contributed by Mario Carneiro, 29-Jun-2015.)
theorem oveqdr_b (ph ps: wff) (x3: setvar) (F G: class):
  $ wi ph (wceq F G) $ >
  $ wi (wa ph ps) (wceq (co (cv x3) (cv x3) F) (co (cv x3) (cv x3) G)) $;

--| Deduction version of bound-variable hypothesis builder ~ nfov . (Contributed by NM, 13-Dec-2005.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem nfovd {x3: setvar} (ph: wff x3) (A2 B2 F: class x3):
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 F) $ >
  $ wi ph (wnfc x3 B2) $ >
  $ wi ph (wnfc x3 (co A2 B2 F)) $;

--| Bound-variable hypothesis builder for operation value. (Contributed by NM, 4-May-2004.)
theorem nfov {x3: setvar} (A2 B2 F: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 F $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 (co A2 B2 F) $;

--| The law of concretion. Special case of Theorem 9.5 of [Quine] p. 61. Version of ~ oprabid with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by Mario Carneiro, 20-Mar-2013.) Avoid ~ ax-13 . (Revised by GG, 26-Jan-2024.)
theorem oprabidw {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wb (wcel (cop (cop (cv x3) (cv y1)) (cv z)) (coprab x3 y1 z ph)) ph $;

--| The law of concretion. Special case of Theorem 9.5 of [Quine] p. 61. Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ oprabidw when possible. (Contributed by Mario Carneiro, 20-Mar-2013.) (New usage is discouraged.)
theorem oprabid {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wb (wcel (cop (cop (cv x3) (cv y1)) (cv z)) (coprab x3 y1 z ph)) ph $;

--| The result of an operation is a set. (Contributed by NM, 13-Mar-1995.)
theorem ovex (A2 B2 F: class):
  $ wcel (co A2 B2 F) cvv $;

--| The result of an operation is a set. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem ovexi (A2 B2 C F: class):
  $ wceq A2 (co B2 C F) $ >
  $ wcel A2 cvv $;

--| The result of an operation is a set. (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem ovexd (ph: wff) (A2 B2 F: class):
  $ wi ph (wcel (co A2 B2 F) cvv) $;

--| The result of an operation value is always a subset of the union of the range. (Contributed by Mario Carneiro, 12-Jan-2017.)
theorem ovssunirn (F X Y: class):
  $ wss (co X Y F) (cuni (crn F)) $;

--| Operation value of the empty set. (Contributed by AV, 15-May-2021.)
theorem _0ov (A2 B2: class):
  $ wceq (co A2 B2 c0) c0 $;

--| The value of an operation when the one of the arguments is a proper class. Note: this theorem is dependent on our particular definitions of operation value, function value, and ordered pair. (Contributed by Mario Carneiro, 26-Apr-2015.)
theorem ovprc (A2 B2 F: class):
  $ wrel (cdm F) $ >
  $ wi (wn (wa (wcel A2 cvv) (wcel B2 cvv))) (wceq (co A2 B2 F) c0) $;

--| The value of an operation when the first argument is a proper class. (Contributed by NM, 16-Jun-2004.)
theorem ovprc1 (A2 B2 F: class):
  $ wrel (cdm F) $ >
  $ wi (wn (wcel A2 cvv)) (wceq (co A2 B2 F) c0) $;

--| The value of an operation when the second argument is a proper class. (Contributed by Mario Carneiro, 26-Apr-2015.)
theorem ovprc2 (A2 B2 F: class):
  $ wrel (cdm F) $ >
  $ wi (wn (wcel B2 cvv)) (wceq (co A2 B2 F) c0) $;

--| Reverse closure for an operation value. (Contributed by Mario Carneiro, 5-May-2015.)
theorem ovrcl (A2 B2 C F: class):
  $ wrel (cdm F) $ >
  $ wi (wcel C (co A2 B2 F)) (wa (wcel A2 cvv) (wcel B2 cvv)) $;

--| Utility theorem: reverse closure for any operation that results in a function. (Contributed by SN, 18-May-2025.)
theorem elfvov1 (ph: wff) (R S I O X Y: class):
  $ wrel (cdm O) $ >
  $ wceq S (co I R O) $ >
  $ wi ph (wcel X (cfv Y S)) $ >
  $ wi ph (wcel I cvv) $;

--| Utility theorem: reverse closure for any operation that results in a function. (Contributed by SN, 4-Aug-2025.)
theorem elfvov2 (ph: wff) (R S I O X Y: class):
  $ wrel (cdm O) $ >
  $ wceq S (co I R O) $ >
  $ wi ph (wcel X (cfv Y S)) $ >
  $ wi ph (wcel R cvv) $;

--| Move class substitution in and out of an operation. (Contributed by NM, 12-Nov-2005.) (Revised by NM, 23-Aug-2018.)
theorem csbov123 {x3: setvar} (A2 B2 C F: class x3):
  $ wceq (csb x3 A2 (co B2 C F)) (co (csb x3 A2 B2) (csb x3 A2 C) (csb x3 A2 F)) $;

--| Move class substitution in and out of an operation. (Contributed by NM, 23-Aug-2018.)
theorem csbov {x3: setvar} (A2: class x3) (B2 C: class) (F: class x3):
  $ wceq (csb x3 A2 (co B2 C F)) (co B2 C (csb x3 A2 F)) $;

--| Move class substitution in and out of an operation. (Contributed by NM, 12-Nov-2005.)
theorem csbov12g {x3: setvar} (A2 B2 C: class x3) (F: class) (V: class x3):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (co B2 C F)) (co (csb x3 A2 B2) (csb x3 A2 C) F)) $;

--| Move class substitution in and out of an operation. (Contributed by NM, 12-Nov-2005.)
theorem csbov1g {x3: setvar} (A2 B2: class x3) (C F: class) (V: class x3):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (co B2 C F)) (co (csb x3 A2 B2) C F)) $;

--| Move class substitution in and out of an operation. (Contributed by NM, 12-Nov-2005.)
theorem csbov2g {x3: setvar} (A2: class x3) (B2: class) (C: class x3) (F: class) (V: class x3):
  $ wi (wcel A2 V) (wceq (csb x3 A2 (co B2 C F)) (co B2 (csb x3 A2 C) F)) $;

--| A frequently used special case of ~ rspc2ev for operation values. (Contributed by NM, 21-Mar-2007.)
theorem rspceov {x3 y1: setvar} (A2: class y1) (B2 C: class) (D: class x3) (S F: class):
  $ wi (w3a (wcel C A2) (wcel D B2) (wceq S (co C D F))) (wrex x3 (wrex y1 (wceq S (co (cv x3) (cv y1) F)) B2) A2) $;

--| Elementhood of the image set of an operation value. (Contributed by Thierry Arnoux, 13-Mar-2017.)
theorem elovimad (ph: wff) (A2 B2 C D F: class):
  $ wi ph (wcel A2 C) $ >
  $ wi ph (wcel B2 D) $ >
  $ wi ph (wfun F) $ >
  $ wi ph (wss (cxp C D) (cdm F)) $ >
  $ wi ph (wcel (co A2 B2 F) (cima F (cxp C D))) $;

--| Value of a binary operation expressed as a binary relation. See also ~ fnbrfvb for functions on Cartesian products. (Contributed by BJ, 15-Feb-2022.)
theorem fnbrovb (A2 B2 C F V W: class):
  $ wi (wa (wfn F (cxp V W)) (wa (wcel A2 V) (wcel B2 W))) (wb (wceq (co A2 B2 F) C) (wbr (cop A2 B2) C F)) $;

--| Equivalence of operation value and ordered triple membership, analogous to ~ fnopfvb . (Contributed by NM, 17-Dec-2008.) (Revised by Mario Carneiro, 28-Apr-2015.) (Proof shortened by BJ, 15-Feb-2022.)
theorem fnotovb (A2 B2 C D R F: class):
  $ wi (w3a (wfn F (cxp A2 B2)) (wcel C A2) (wcel D B2)) (wb (wceq (co C D F) R) (wcel (cotp C D R) F)) $;

--| A collection of ordered pairs with an extension of a binary relation is a set. (Contributed by Alexander van der Vekens, 1-Nov-2017.) (Revised by BJ/AV, 20-Jun-2019.) (Proof shortened by OpenAI, 25-Mar-2020.)
theorem opabbrex {x3 y1: setvar} (ph ps: wff x3 y1) (R V: class x3 y1):
  $ wi (wa (wal x3 (wal y1 (wi (wbr (cv x3) (cv y1) R) ph))) (wcel (copab x3 y1 ph) V)) (wcel (copab x3 y1 (wa (wbr (cv x3) (cv y1) R) ps)) cvv) $;

--| Restrictions of a collection of ordered pairs of related elements are sets. (Contributed by Alexander van der Vekens, 1-Nov-2017.) (Revised by AV, 15-Jan-2021.) Add disjoint variable conditions betweem ` W , G ` and ` x , y ` to remove hypotheses. (Revised by SN, 13-Dec-2024.)
theorem opabresex2 {x3 y1: setvar} (th: wff x3 y1) (G W: class):
  $ wcel (copab x3 y1 (wa (wbr (cv x3) (cv y1) (cfv G W)) th)) cvv $;

--| The function value of a mapping ` M ` to a restricted binary relation expressed as an ordered-pair class abstraction: The restricted binary relation is a binary relation given as value of a function ` F ` restricted by the condition ` ps ` . (Contributed by AV, 31-Jan-2021.) (Revised by AV, 29-Oct-2021.) Add disjoint variable condition on ` F , x , y ` to remove a sethood hypothesis. (Revised by SN, 13-Dec-2024.)
theorem fvmptopab {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff x3 y1) (F: class) (M: class x3 y1 z) (Z: class):
  $ wi (wceq (cv z) Z) (wb ph ps) $ >
  $ wceq M (cmpt z cvv (copab x3 y1 (wa (wbr (cv x3) (cv y1) (cfv (cv z) F)) ph))) $ >
  $ wceq (cfv Z M) (copab x3 y1 (wa (wbr (cv x3) (cv y1) (cfv Z F)) ps)) $;

--| Condition for an operation to be one-to-one. (Contributed by Jeff Madsen, 17-Jun-2010.)
theorem f1opr {u t s1 r: setvar} (A2 B2: class) (C: class u t s1 r) (F: class):
  $ wb (wf1 (cxp A2 B2) C F) (wa (wf (cxp A2 B2) C F) (wral r (wral s1 (wral t (wral u (wi (wceq (co (cv r) (cv s1) F) (co (cv t) (cv u) F)) (wa (wceq (cv r) (cv t)) (wceq (cv s1) (cv u)))) B2) A2) B2) A2)) $;

--| The classes involved in a binary relation of a function value which is an ordered-pair class abstraction are sets. (Contributed by AV, 7-Jan-2021.)
theorem brfvopab {y1 z: setvar} (ph: wff y1 z) (A2 B2 F X: class y1 z):
  $ wi (wcel X cvv) (wceq (cfv X F) (copab y1 z ph)) $ >
  $ wi (wbr A2 B2 (cfv X F)) (w3a (wcel X cvv) (wcel A2 cvv) (wcel B2 cvv)) $;

--| Class abstraction for operations in terms of class abstraction of ordered pairs. (Contributed by NM, 12-Mar-1995.)
theorem dfoprab2 {x3 y1 z w: setvar} (ph: wff x3 y1 z):
  $ wceq (coprab x3 y1 z ph) (copab w z (wex x3 (wex y1 (wa (wceq (cv w) (cop (cv x3) (cv y1))) ph)))) $;

--| An operation class abstraction is a relation. (Contributed by NM, 16-Jun-2004.)
theorem reloprab {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wrel (coprab x3 y1 z ph) $;

--| If a pair and a class are in a relationship given by a class abstraction of a collection of nested ordered pairs, the involved classes are sets. (Contributed by Alexander van der Vekens, 8-Jul-2018.)
theorem oprabv {x3 y1 z: setvar} (ph: wff x3 y1 z) (X Y Z: class):
  $ wi (wbr (cop X Y) Z (coprab x3 y1 z ph)) (w3a (wcel X cvv) (wcel Y cvv) (wcel Z cvv)) $;

--| The abstraction variables in an operation class abstraction are not free. (Contributed by NM, 25-Apr-1995.) (Revised by David Abernethy, 19-Jun-2012.)
theorem nfoprab1 {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wnfc x3 (coprab x3 y1 z ph) $;

--| The abstraction variables in an operation class abstraction are not free. (Contributed by NM, 25-Apr-1995.) (Revised by David Abernethy, 30-Jul-2012.)
theorem nfoprab2 {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wnfc y1 (coprab x3 y1 z ph) $;

--| The abstraction variables in an operation class abstraction are not free. (Contributed by NM, 22-Aug-2013.)
theorem nfoprab3 {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wnfc z (coprab x3 y1 z ph) $;

--| Bound-variable hypothesis builder for an operation class abstraction. (Contributed by NM, 22-Aug-2013.)
theorem nfoprab {x3 y1 z w: setvar} (ph: wff x3 y1 z w):
  $ wnf w ph $ >
  $ wnfc w (coprab x3 y1 z ph) $;

--| Equivalent wff's yield equal operation class abstractions (deduction form). (Contributed by NM, 21-Feb-2004.) (Revised by Mario Carneiro, 24-Jun-2014.)
theorem oprabbid {x3 y1 z: setvar} (ph ps ch: wff x3 y1 z):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wnf z ph $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wceq (coprab x3 y1 z ps) (coprab x3 y1 z ch)) $;

--| Equivalent wff's yield equal operation class abstractions (deduction form). (Contributed by NM, 21-Feb-2004.)
theorem oprabbidv {x3 y1 z: setvar} (ph: wff) (ps ch: wff x3 y1 z):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wceq (coprab x3 y1 z ps) (coprab x3 y1 z ch)) $;

--| Equivalent wff's yield equal operation class abstractions. (Contributed by NM, 28-May-1995.) (Revised by David Abernethy, 19-Jun-2012.)
theorem oprabbii {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wb ph ps $ >
  $ wceq (coprab x3 y1 z ph) (coprab x3 y1 z ps) $;

--| Equivalence of ordered pair abstraction subclass and implication. Compare ~ ssopab2 . (Contributed by FL, 6-Nov-2013.) (Proof shortened by Mario Carneiro, 11-Dec-2016.)
theorem ssoprab2 {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wi (wal x3 (wal y1 (wal z (wi ph ps)))) (wss (coprab x3 y1 z ph) (coprab x3 y1 z ps)) $;

--| Equivalence of ordered pair abstraction subclass and implication. Compare ~ ssopab2b . Usage of this theorem is discouraged because it depends on ~ ax-13 . (Contributed by FL, 6-Nov-2013.) (Proof shortened by Mario Carneiro, 11-Dec-2016.) (New usage is discouraged.)
theorem ssoprab2b {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wb (wss (coprab x3 y1 z ph) (coprab x3 y1 z ps)) (wal x3 (wal y1 (wal z (wi ph ps)))) $;

--| Equivalence of ordered pair abstraction subclass and biconditional. Version of ~ eqoprab2b with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by Mario Carneiro, 4-Jan-2017.) Avoid ~ ax-13 . (Revised by GG, 26-Jan-2024.)
theorem eqoprab2bw {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wb (wceq (coprab x3 y1 z ph) (coprab x3 y1 z ps)) (wal x3 (wal y1 (wal z (wb ph ps)))) $;

--| Equivalence of ordered pair abstraction subclass and biconditional. Compare ~ eqopab2b . Usage of this theorem is discouraged because it depends on ~ ax-13 . Use the weaker ~ eqoprab2bw when possible. (Contributed by Mario Carneiro, 4-Jan-2017.) (New usage is discouraged.)
theorem eqoprab2b {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wb (wceq (coprab x3 y1 z ph) (coprab x3 y1 z ps)) (wal x3 (wal y1 (wal z (wb ph ps)))) $;

--| An equality theorem for the maps-to notation. (Contributed by Mario Carneiro, 16-Dec-2013.) (Revised by Mario Carneiro, 19-Mar-2015.)
theorem mpoeq123 {x3 y1: setvar} (A2: class) (B2: class x3) (C: class x3 y1) (D: class) (E: class x3) (F: class x3 y1):
  $ wi (wa (wceq A2 D) (wral x3 (wa (wceq B2 E) (wral y1 (wceq C F) B2)) A2)) (wceq (cmpo x3 y1 A2 B2 C) (cmpo x3 y1 D E F)) $;

--| An equality theorem for the maps-to notation. (Contributed by Mario Carneiro, 16-Dec-2013.)
theorem mpoeq12 {x3 y1: setvar} (A2 B2 C D: class) (E: class x3 y1):
  $ wi (wa (wceq A2 C) (wceq B2 D)) (wceq (cmpo x3 y1 A2 B2 E) (cmpo x3 y1 C D E)) $;

--| An equality deduction for the maps-to notation. (Contributed by Mario Carneiro, 26-Jan-2017.)
theorem mpoeq123dva {x3 y1: setvar} (ph: wff) (A2 B2 C D E F: class x3 y1):
  $ wi ph (wceq A2 D) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wceq B2 E) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) B2))) (wceq C F) $ >
  $ wi ph (wceq (cmpo x3 y1 A2 B2 C) (cmpo x3 y1 D E F)) $;

--| An equality deduction for the maps-to notation. (Contributed by NM, 12-Sep-2011.)
theorem mpoeq123dv {x3 y1: setvar} (ph: wff) (A2 B2 C D E F: class x3 y1):
  $ wi ph (wceq A2 D) $ >
  $ wi ph (wceq B2 E) $ >
  $ wi ph (wceq C F) $ >
  $ wi ph (wceq (cmpo x3 y1 A2 B2 C) (cmpo x3 y1 D E F)) $;

--| An equality inference for the maps-to notation. (Contributed by NM, 15-Jul-2013.)
theorem mpoeq123i {x3 y1: setvar} (A2 B2 C D E F: class x3 y1):
  $ wceq A2 D $ >
  $ wceq B2 E $ >
  $ wceq C F $ >
  $ wceq (cmpo x3 y1 A2 B2 C) (cmpo x3 y1 D E F) $;

--| Slightly more general equality inference for the maps-to notation. (Contributed by NM, 17-Oct-2013.)
theorem mpoeq3dva {x3 y1: setvar} (ph: wff) (A2 B2 C D: class x3 y1):
  $ wi (w3a ph (wcel (cv x3) A2) (wcel (cv y1) B2)) (wceq C D) $ >
  $ wi ph (wceq (cmpo x3 y1 A2 B2 C) (cmpo x3 y1 A2 B2 D)) $;

--| An equality inference for the maps-to notation. (Contributed by Mario Carneiro, 16-Dec-2013.)
theorem mpoeq3ia {x3 y1: setvar} (A2 B2 C D: class x3 y1):
  $ wi (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) (wceq C D) $ >
  $ wceq (cmpo x3 y1 A2 B2 C) (cmpo x3 y1 A2 B2 D) $;

--| An equality deduction for the maps-to notation restricted to the value of the operation. (Contributed by SO, 16-Jul-2018.)
theorem mpoeq3dv {x3 y1: setvar} (ph: wff) (A2 B2 C D: class x3 y1):
  $ wi ph (wceq C D) $ >
  $ wi ph (wceq (cmpo x3 y1 A2 B2 C) (cmpo x3 y1 A2 B2 D)) $;

--| Bound-variable hypothesis builder for an operation in maps-to notation. (Contributed by NM, 27-Aug-2013.)
theorem nfmpo1 {x3 y1: setvar} (A2 B2 C: class x3 y1):
  $ wnfc x3 (cmpo x3 y1 A2 B2 C) $;

--| Bound-variable hypothesis builder for an operation in maps-to notation. (Contributed by NM, 27-Aug-2013.)
theorem nfmpo2 {x3 y1: setvar} (A2 B2 C: class x3 y1):
  $ wnfc y1 (cmpo x3 y1 A2 B2 C) $;

--| Bound-variable hypothesis builder for the maps-to notation. (Contributed by NM, 20-Feb-2013.)
theorem nfmpo {x3 y1 z: setvar} (A2 B2 C: class x3 y1 z):
  $ wnfc z A2 $ >
  $ wnfc z B2 $ >
  $ wnfc z C $ >
  $ wnfc z (cmpo x3 y1 A2 B2 C) $;

--| A mapping operation with empty domain is empty. Generalization of ~ mpo0 . (Contributed by AV, 27-Jan-2024.)
theorem _0mpo0 {x3 y1: setvar} (A2 B2: class) (C: class x3 y1):
  $ wi (wo (wceq A2 c0) (wceq B2 c0)) (wceq (cmpo x3 y1 A2 B2 C) c0) $;

--| A mapping operation with empty domain. (Contributed by Stefan O'Rear, 29-Jan-2015.) (Revised by Mario Carneiro, 15-May-2015.) (Proof shortened by AV, 27-Jan-2024.)
theorem mpo0v {x3 y1: setvar} (B2: class) (C: class x3 y1):
  $ wceq (cmpo x3 y1 c0 B2 C) c0 $;

--| A mapping operation with empty domain. In this version of ~ mpo0v , the class of the second operator may depend on the first operator. (Contributed by Stefan O'Rear, 29-Jan-2015.) (Revised by Mario Carneiro, 15-May-2015.)
theorem mpo0 {x3 y1: setvar} (B2 C: class x3 y1):
  $ wceq (cmpo x3 y1 c0 B2 C) c0 $;

--| Two ways to state the domain of an operation. (Contributed by FL, 24-Jan-2010.)
theorem oprab4 {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2 B2: class x3 y1 z):
  $ wceq (coprab x3 y1 z (wa (wcel (cop (cv x3) (cv y1)) (cxp A2 B2)) ph)) (coprab x3 y1 z (wa (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ph)) $;

--| Rule used to change first bound variable in an operation abstraction, using implicit substitution. (Contributed by NM, 20-Dec-2008.) (Revised by Mario Carneiro, 5-Dec-2016.)
theorem cbvoprab1 {x3 y1 z w: setvar} (ph ps: wff x3 y1 z w):
  $ wnf w ph $ >
  $ wnf x3 ps $ >
  $ wi (wceq (cv x3) (cv w)) (wb ph ps) $ >
  $ wceq (coprab x3 y1 z ph) (coprab w y1 z ps) $;

--| Change the second bound variable in an operation abstraction. (Contributed by Jeff Madsen, 11-Jun-2010.) (Revised by Mario Carneiro, 11-Dec-2016.)
theorem cbvoprab2 {x3 y1 z w: setvar} (ph ps: wff x3 y1 z w):
  $ wnf w ph $ >
  $ wnf y1 ps $ >
  $ wi (wceq (cv y1) (cv w)) (wb ph ps) $ >
  $ wceq (coprab x3 y1 z ph) (coprab x3 w z ps) $;

--| Rule used to change first two bound variables in an operation abstraction, using implicit substitution. (Contributed by NM, 21-Feb-2004.) (Proof shortened by Andrew Salmon, 22-Oct-2011.)
theorem cbvoprab12 {x3 y1 z w v: setvar} (ph ps: wff x3 y1 z w v):
  $ wnf w ph $ >
  $ wnf v ph $ >
  $ wnf x3 ps $ >
  $ wnf y1 ps $ >
  $ wi (wa (wceq (cv x3) (cv w)) (wceq (cv y1) (cv v))) (wb ph ps) $ >
  $ wceq (coprab x3 y1 z ph) (coprab w v z ps) $;

--| Rule used to change first two bound variables in an operation abstraction, using implicit substitution. (Contributed by NM, 8-Oct-2004.)
theorem cbvoprab12v {x3 y1 z w v: setvar} (ph: wff x3 y1 z) (ps: wff z w v):
  $ wi (wa (wceq (cv x3) (cv w)) (wceq (cv y1) (cv v))) (wb ph ps) $ >
  $ wceq (coprab x3 y1 z ph) (coprab w v z ps) $;

--| Rule used to change the third bound variable in an operation abstraction, using implicit substitution. (Contributed by NM, 22-Aug-2013.)
theorem cbvoprab3 {x3 y1 z w: setvar} (ph ps: wff x3 y1 z w):
  $ wnf w ph $ >
  $ wnf z ps $ >
  $ wi (wceq (cv z) (cv w)) (wb ph ps) $ >
  $ wceq (coprab x3 y1 z ph) (coprab x3 y1 w ps) $;

--| Rule used to change the third bound variable in an operation abstraction, using implicit substitution. (Contributed by NM, 8-Oct-2004.) (Revised by David Abernethy, 19-Jun-2012.)
theorem cbvoprab3v {x3 y1 z w: setvar} (ph: wff x3 y1 z) (ps: wff x3 y1 w):
  $ wi (wceq (cv z) (cv w)) (wb ph ps) $ >
  $ wceq (coprab x3 y1 z ph) (coprab x3 y1 w ps) $;

--| Rule to change the bound variable in a maps-to function, using implicit substitution. This version of ~ cbvmpo allows ` B ` to be a function of ` x ` . (Contributed by NM, 29-Dec-2014.)
theorem cbvmpox {x3 y1 z w: setvar} (A2: class) (B2: class x3 y1 z) (C: class x3 y1 z w) (D: class x3 z w) (E: class x3 y1 z w):
  $ wnfc z B2 $ >
  $ wnfc x3 D $ >
  $ wnfc z C $ >
  $ wnfc w C $ >
  $ wnfc x3 E $ >
  $ wnfc y1 E $ >
  $ wi (wceq (cv x3) (cv z)) (wceq B2 D) $ >
  $ wi (wa (wceq (cv x3) (cv z)) (wceq (cv y1) (cv w))) (wceq C E) $ >
  $ wceq (cmpo x3 y1 A2 B2 C) (cmpo z w A2 D E) $;

--| Rule to change the bound variable in a maps-to function, using implicit substitution. (Contributed by NM, 17-Dec-2013.)
theorem cbvmpo {x3 y1 z w: setvar} (A2 B2: class) (C D: class x3 y1 z w):
  $ wnfc z C $ >
  $ wnfc w C $ >
  $ wnfc x3 D $ >
  $ wnfc y1 D $ >
  $ wi (wa (wceq (cv x3) (cv z)) (wceq (cv y1) (cv w))) (wceq C D) $ >
  $ wceq (cmpo x3 y1 A2 B2 C) (cmpo z w A2 B2 D) $;

--| Rule to change the bound variable in a maps-to function, using implicit substitution. With a longer proof analogous to ~ cbvmpt , some distinct variable requirements could be eliminated. (Contributed by NM, 11-Jun-2013.)
theorem cbvmpov {x3 y1 z w: setvar} (A2 B2: class) (C: class x3 y1) (D: class z w) (E: class x3 y1 z w):
  $ wi (wceq (cv x3) (cv z)) (wceq C E) $ >
  $ wi (wceq (cv y1) (cv w)) (wceq E D) $ >
  $ wceq (cmpo x3 y1 A2 B2 C) (cmpo z w A2 B2 D) $;

--| Eliminate a hypothesis which is a predicate expressing membership in the result of an operator (deduction version). (Contributed by Paul Chapman, 25-Mar-2008.)
theorem elimdelov (ph: wff) (A2 B2 C F X Y Z: class):
  $ wi ph (wcel C (co A2 B2 F)) $ >
  $ wcel Z (co X Y F) $ >
  $ wcel (cif ph C Z) (co (cif ph A2 X) (cif ph B2 Y) F) $;

--| Move a relation inside and outside the conditional operator. (Contributed by SN, 14-Aug-2024.)
theorem brif1 (ph: wff) (A2 B2 C R: class):
  $ wb (wbr (cif ph A2 B2) C R) (wif ph (wbr A2 C R) (wbr B2 C R)) $;

--| Move a conditional outside of an operation. (Contributed by Thierry Arnoux, 25-Jan-2017.)
theorem ovif (ph: wff) (A2 B2 C F: class):
  $ wceq (co (cif ph A2 B2) C F) (cif ph (co A2 C F) (co B2 C F)) $;

--| Move a conditional outside of an operation. (Contributed by Thierry Arnoux, 1-Oct-2018.)
theorem ovif2 (ph: wff) (A2 B2 C F: class):
  $ wceq (co A2 (cif ph B2 C) F) (cif ph (co A2 B2 F) (co A2 C F)) $;

--| Move a conditional outside of an operation. (Contributed by Thierry Arnoux, 25-Jan-2017.)
theorem ovif12 (ph: wff) (A2 B2 C D F: class):
  $ wceq (co (cif ph A2 B2) (cif ph C D) F) (cif ph (co A2 C F) (co B2 D F)) $;

--| Move a conditional outside of an operation. (Contributed by AV, 11-Nov-2019.)
theorem ifov (ph: wff) (A2 B2 F G: class):
  $ wceq (co A2 B2 (cif ph F G)) (cif ph (co A2 B2 F) (co A2 B2 G)) $;

--| Move a conditional inside and outside a function in maps-to notation. (Contributed by SN, 16-Oct-2025.)
theorem ifmpt2v {x3: setvar} (ph: wff) (A2 B2 C: class x3):
  $ wceq (cmpt x3 A2 (cif ph B2 C)) (cif ph (cmpt x3 A2 B2) (cmpt x3 A2 C)) $;

--| The domain of an operation class abstraction. (Contributed by NM, 17-Mar-1995.) (Revised by David Abernethy, 19-Jun-2012.)
theorem dmoprab {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wceq (cdm (coprab x3 y1 z ph)) (copab x3 y1 (wex z ph)) $;

--| The domain of an operation class abstraction. (Contributed by NM, 24-Aug-1995.)
theorem dmoprabss {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2 B2: class):
  $ wss (cdm (coprab x3 y1 z (wa (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ph))) (cxp A2 B2) $;

--| The range of an operation class abstraction. (Contributed by NM, 30-Aug-2004.) (Revised by David Abernethy, 19-Apr-2013.)
theorem rnoprab {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wceq (crn (coprab x3 y1 z ph)) (cab z (wex x3 (wex y1 ph))) $;

--| The range of a restricted operation class abstraction. (Contributed by Scott Fenton, 21-Mar-2012.)
theorem rnoprab2 {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2: class x3 z) (B2: class x3 y1 z):
  $ wceq (crn (coprab x3 y1 z (wa (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ph))) (cab z (wrex x3 (wrex y1 ph B2) A2)) $;

--| The domain of an operation class abstraction is a relation. (Contributed by NM, 17-Mar-1995.)
theorem reldmoprab {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wrel (cdm (coprab x3 y1 z ph)) $;

--| Structure of an operation class abstraction. (Contributed by NM, 28-Nov-2006.)
theorem oprabss {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wss (coprab x3 y1 z ph) (cxp (cxp cvv cvv) cvv) $;

--| The law of concretion for operation class abstraction. Compare ~ elopab . (Contributed by NM, 14-Sep-1999.) Remove unnecessary distinct variable conditions. (Revised by David Abernethy, 19-Jun-2012.) (Revised by Mario Carneiro, 19-Dec-2013.) Avoid ~ ax-10 , ~ ax-11 . (Revised by Wolf Lammen, 15-Oct-2024.)
theorem eloprabga {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff) (A2 B2 C: class) (V W X: class x3 y1 z):
  $ wi (w3a (wceq (cv x3) A2) (wceq (cv y1) B2) (wceq (cv z) C)) (wb ph ps) $ >
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel C X)) (wb (wcel (cop (cop A2 B2) C) (coprab x3 y1 z ph)) ps) $;

--| The law of concretion for operation class abstraction. Compare ~ elopab . (Contributed by NM, 14-Sep-1999.) (Revised by David Abernethy, 19-Jun-2012.)
theorem eloprabg {x3 y1 z: setvar} (ph ps ch: wff x3 y1 z) (th: wff) (A2 B2 C: class) (V W X: class x3 y1 z):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wceq (cv z) C) (wb ch th) $ >
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel C X)) (wb (wcel (cop (cop A2 B2) C) (coprab x3 y1 z ph)) th) $;

--| Inference of operation class abstraction subclass from implication. (Contributed by NM, 11-Nov-1995.) (Revised by David Abernethy, 19-Jun-2012.)
theorem ssoprab2i {x3 y1 z: setvar} (ph ps: wff x3 y1 z):
  $ wi ph ps $ >
  $ wss (coprab x3 y1 z ph) (coprab x3 y1 z ps) $;

--| Operation with universal domain in maps-to notation. (Contributed by NM, 16-Aug-2013.)
theorem mpov {x3 y1 z: setvar} (C: class x3 y1):
  $ wceq (cmpo x3 y1 cvv cvv C) (coprab x3 y1 z (wceq (cv z) C)) $;

--| Express a two-argument function as a one-argument function, or vice-versa. In this version ` B ( x ) ` is not assumed to be constant w.r.t ` x ` . (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem mpomptx {x3 y1 z: setvar} (A2: class) (B2: class x3) (C: class z) (D: class x3 y1):
  $ wi (wceq (cv z) (cop (cv x3) (cv y1))) (wceq C D) $ >
  $ wceq (cmpt z (ciun x3 A2 (cxp (csn (cv x3)) B2)) C) (cmpo x3 y1 A2 B2 D) $;

--| Express a two-argument function as a one-argument function, or vice-versa. (Contributed by Mario Carneiro, 17-Dec-2013.) (Revised by Mario Carneiro, 29-Dec-2014.)
theorem mpompt {x3 y1 z: setvar} (A2 B2: class) (C: class z) (D: class x3 y1):
  $ wi (wceq (cv z) (cop (cv x3) (cv y1))) (wceq C D) $ >
  $ wceq (cmpt z (cxp A2 B2) C) (cmpo x3 y1 A2 B2 D) $;

--| A mapping with two arguments with the first argument from a difference set with a singleton and a conditional as result. (Contributed by AV, 13-Feb-2019.)
theorem mpodifsnif {i j: setvar} (A2 B2 C D X: class i j):
  $ wceq (cmpo i j (cdif A2 (csn X)) B2 (cif (wceq (cv i) X) C D)) (cmpo i j (cdif A2 (csn X)) B2 D) $;

--| A mapping with two arguments with the first argument from a singleton and a conditional as result. (Contributed by AV, 14-Feb-2019.)
theorem mposnif {i j: setvar} (B2 C D X: class i j):
  $ wceq (cmpo i j (csn X) B2 (cif (wceq (cv i) X) C D)) (cmpo i j (csn X) B2 C) $;

--| Representation of a constant operation using the mapping operation. (Contributed by SO, 11-Jul-2018.)
theorem fconstmpo {x3 y1: setvar} (A2 B2 C: class):
  $ wceq (cxp (cxp A2 B2) (csn C)) (cmpo x3 y1 A2 B2 C) $;

--| Restriction of an operation class abstraction. (Contributed by NM, 10-Feb-2007.)
theorem resoprab {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2 B2: class):
  $ wceq (cres (coprab x3 y1 z ph) (cxp A2 B2)) (coprab x3 y1 z (wa (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ph)) $;

--| Restriction of an operator abstraction. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem resoprab2 {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2 B2 C D: class):
  $ wi (wa (wss C A2) (wss D B2)) (wceq (cres (coprab x3 y1 z (wa (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ph)) (cxp C D)) (coprab x3 y1 z (wa (wa (wcel (cv x3) C) (wcel (cv y1) D)) ph))) $;

--| Restriction of the mapping operation. (Contributed by Mario Carneiro, 17-Dec-2013.)
theorem resmpo {x3 y1: setvar} (A2 B2 C D: class) (E: class x3 y1):
  $ wi (wa (wss C A2) (wss D B2)) (wceq (cres (cmpo x3 y1 A2 B2 E) (cxp C D)) (cmpo x3 y1 C D E)) $;

--| "At most one" is a sufficient condition for an operation class abstraction to be a function. (Contributed by NM, 28-Aug-2007.)
theorem funoprabg {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wi (wal x3 (wal y1 (wmo z ph))) (wfun (coprab x3 y1 z ph)) $;

--| "At most one" is a sufficient condition for an operation class abstraction to be a function. (Contributed by NM, 17-Mar-1995.)
theorem funoprab {x3 y1 z: setvar} (ph: wff x3 y1 z):
  $ wmo z ph $ >
  $ wfun (coprab x3 y1 z ph) $;

--| Functionality and domain of an operation class abstraction. (Contributed by NM, 28-Aug-2007.)
theorem fnoprabg {x3 y1 z: setvar} (ph: wff x3 y1) (ps: wff x3 y1 z):
  $ wi (wal x3 (wal y1 (wi ph (weu z ps)))) (wfn (coprab x3 y1 z (wa ph ps)) (copab x3 y1 ph)) $;

--| The maps-to notation for an operation is always a function. (Contributed by Scott Fenton, 21-Mar-2012.) (Proof shortened by SN, 23-Jul-2024.)
theorem mpofun {x3 y1: setvar} (A2 B2 C F: class x3 y1):
  $ wceq F (cmpo x3 y1 A2 B2 C) $ >
  $ wfun F $;

--| Functionality and domain of an operation class abstraction. (Contributed by NM, 15-May-1995.)
theorem fnoprab {x3 y1 z: setvar} (ph: wff x3 y1) (ps: wff x3 y1 z):
  $ wi ph (weu z ps) $ >
  $ wfn (coprab x3 y1 z (wa ph ps)) (copab x3 y1 ph) $;

--| An operation maps to a class to which all values belong. (Contributed by NM, 7-Feb-2004.)
theorem ffnov {x3 y1: setvar} (A2 B2 C F: class):
  $ wb (wf (cxp A2 B2) C F) (wa (wfn F (cxp A2 B2)) (wral x3 (wral y1 (wcel (co (cv x3) (cv y1) F) C) B2) A2)) $;

--| Closure law for an operation. (Contributed by NM, 19-Apr-2007.) (Revised by Thierry Arnoux, 17-Feb-2017.)
theorem fovcld (ph: wff) (A2 B2 C R S F: class):
  $ wi ph (wf (cxp R S) C F) $ >
  $ wi (w3a ph (wcel A2 R) (wcel B2 S)) (wcel (co A2 B2 F) C) $;

--| Closure law for an operation. (Contributed by NM, 19-Apr-2007.) (Proof shortened by AV, 9-Mar-2025.)
theorem fovcl (A2 B2 C R S F: class):
  $ wf (cxp R S) C F $ >
  $ wi (wa (wcel A2 R) (wcel B2 S)) (wcel (co A2 B2 F) C) $;

--| Equality of two operations is determined by their values. (Contributed by NM, 1-Sep-2005.)
theorem eqfnov {x3 y1: setvar} (A2 B2: class) (C D: class x3 y1) (F G: class):
  $ wi (wa (wfn F (cxp A2 B2)) (wfn G (cxp C D))) (wb (wceq F G) (wa (wceq (cxp A2 B2) (cxp C D)) (wral x3 (wral y1 (wceq (co (cv x3) (cv y1) F) (co (cv x3) (cv y1) G)) B2) A2))) $;

--| Two operators with the same domain are equal iff their values at each point in the domain are equal. (Contributed by Jeff Madsen, 7-Jun-2010.)
theorem eqfnov2 {x3 y1: setvar} (A2 B2 F G: class):
  $ wi (wa (wfn F (cxp A2 B2)) (wfn G (cxp A2 B2))) (wb (wceq F G) (wral x3 (wral y1 (wceq (co (cv x3) (cv y1) F) (co (cv x3) (cv y1) G)) B2) A2)) $;

--| Representation of a function in terms of its values. (Contributed by NM, 7-Feb-2004.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem fnov {x3 y1: setvar} (A2 B2 F: class):
  $ wb (wfn F (cxp A2 B2)) (wceq F (cmpo x3 y1 A2 B2 (co (cv x3) (cv y1) F))) $;

--| Bidirectional equality theorem for a mapping abstraction. Equivalent to ~ eqfnov2 . (Contributed by Mario Carneiro, 4-Jan-2017.)
theorem mpo2eqb {x3 y1: setvar} (A2: class) (B2: class x3) (C D V: class x3 y1):
  $ wi (wral x3 (wral y1 (wcel C V) B2) A2) (wb (wceq (cmpo x3 y1 A2 B2 C) (cmpo x3 y1 A2 B2 D)) (wral x3 (wral y1 (wceq C D) B2) A2)) $;

--| The range of an operation given by the maps-to notation. (Contributed by FL, 20-Jun-2011.)
theorem rnmpo {x3 y1 z: setvar} (A2: class x3) (B2 C F: class x3 y1):
  $ wceq F (cmpo x3 y1 A2 B2 C) $ >
  $ wceq (crn F) (cab z (wrex x3 (wrex y1 (wceq (cv z) C) B2) A2)) $;

--| The domain of an operation defined by maps-to notation is a relation. (Contributed by Stefan O'Rear, 27-Nov-2014.)
theorem reldmmpo {x3 y1: setvar} (A2: class x3) (B2 C F: class x3 y1):
  $ wceq F (cmpo x3 y1 A2 B2 C) $ >
  $ wrel (cdm F) $;

--| Membership in the range of an operation class abstraction. (Contributed by NM, 27-Aug-2007.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem elrnmpog {x3 y1: setvar} (A2: class x3) (B2 C: class x3 y1) (D: class) (F V: class x3 y1):
  $ wceq F (cmpo x3 y1 A2 B2 C) $ >
  $ wi (wcel D V) (wb (wcel D (crn F)) (wrex x3 (wrex y1 (wceq D C) B2) A2)) $;

--| Membership in the range of an operation class abstraction. (Contributed by NM, 1-Aug-2004.) (Revised by Mario Carneiro, 31-Aug-2015.)
theorem elrnmpo {x3 y1: setvar} (A2: class x3) (B2 C: class x3 y1) (D: class) (F: class x3 y1):
  $ wceq F (cmpo x3 y1 A2 B2 C) $ >
  $ wcel C cvv $ >
  $ wb (wcel D (crn F)) (wrex x3 (wrex y1 (wceq D C) B2) A2) $;

--| Membership in the image of an operation. (Contributed by SN, 27-Apr-2025.)
theorem elimampo {x3 y1: setvar} (ph: wff) (A2 B2: class) (C: class x3 y1) (D: class) (F V: class x3 y1) (X Y: class):
  $ wceq F (cmpo x3 y1 A2 B2 C) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wss X A2) $ >
  $ wi ph (wss Y B2) $ >
  $ wi ph (wb (wcel D (cima F (cxp X Y))) (wrex x3 (wrex y1 (wceq D C) Y) X)) $;

--| Membership in the range of a restricted operation class abstraction. (Contributed by Thierry Arnoux, 25-May-2019.)
theorem elrnmpores {x3 y1: setvar} (A2: class x3) (B2 C: class x3 y1) (D R: class) (F V: class x3 y1):
  $ wceq F (cmpo x3 y1 A2 B2 C) $ >
  $ wi (wcel D V) (wb (wcel D (crn (cres F R))) (wrex x3 (wrex y1 (wa (wceq D C) (wbr (cv x3) (cv y1) R)) B2) A2)) $;

--| A restricted quantifier over an image set. (Contributed by Mario Carneiro, 1-Sep-2015.)
theorem ralrnmpo {x3 y1 z: setvar} (ph: wff z) (ps: wff x3 y1) (A2: class x3) (B2 C F: class x3 y1) (V: class x3 y1 z):
  $ wceq F (cmpo x3 y1 A2 B2 C) $ >
  $ wi (wceq (cv z) C) (wb ph ps) $ >
  $ wi (wral x3 (wral y1 (wcel C V) B2) A2) (wb (wral z ph (crn F)) (wral x3 (wral y1 ps B2) A2)) $;

--| A restricted quantifier over an image set. (Contributed by Mario Carneiro, 1-Sep-2015.)
theorem rexrnmpo {x3 y1 z: setvar} (ph: wff z) (ps: wff x3 y1) (A2: class x3) (B2 C F: class x3 y1) (V: class x3 y1 z):
  $ wceq F (cmpo x3 y1 A2 B2 C) $ >
  $ wi (wceq (cv z) C) (wb ph ps) $ >
  $ wi (wral x3 (wral y1 (wcel C V) B2) A2) (wb (wrex z ph (crn F)) (wrex x3 (wrex y1 ps B2) A2)) $;

--| The value of an operation class abstraction. (Contributed by NM, 16-May-1995.) (Revised by David Abernethy, 19-Jun-2012.)
theorem ovid {x3 y1 z: setvar} (ph: wff x3 y1 z) (R S: class x3 y1) (F: class x3 y1 z):
  $ wi (wa (wcel (cv x3) R) (wcel (cv y1) S)) (weu z ph) $ >
  $ wceq F (coprab x3 y1 z (wa (wa (wcel (cv x3) R) (wcel (cv y1) S)) ph)) $ >
  $ wi (wa (wcel (cv x3) R) (wcel (cv y1) S)) (wb (wceq (co (cv x3) (cv y1) F) (cv z)) ph) $;

--| The value of an operation class abstraction. Compare ~ ovidi . The condition ` ( x e. R /\ y e. S ) ` is been removed. (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem ovidig {x3 y1 z: setvar} (ph: wff x3 y1 z) (F: class x3 y1 z):
  $ wmo z ph $ >
  $ wceq F (coprab x3 y1 z ph) $ >
  $ wi ph (wceq (co (cv x3) (cv y1) F) (cv z)) $;

--| The value of an operation class abstraction (weak version). (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem ovidi {x3 y1 z: setvar} (ph: wff x3 y1 z) (R S: class x3 y1) (F: class x3 y1 z):
  $ wi (wa (wcel (cv x3) R) (wcel (cv y1) S)) (wmo z ph) $ >
  $ wceq F (coprab x3 y1 z (wa (wa (wcel (cv x3) R) (wcel (cv y1) S)) ph)) $ >
  $ wi (wa (wcel (cv x3) R) (wcel (cv y1) S)) (wi ph (wceq (co (cv x3) (cv y1) F) (cv z))) $;

--| The value of an operation class abstraction. (Contributed by NM, 16-May-1995.) (Revised by David Abernethy, 19-Jun-2012.)
theorem ov {x3 y1 z: setvar} (ph ps ch: wff x3 y1 z) (th: wff) (A2 B2 C R S: class) (F: class x3 y1 z):
  $ wcel C cvv $ >
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wceq (cv z) C) (wb ch th) $ >
  $ wi (wa (wcel (cv x3) R) (wcel (cv y1) S)) (weu z ph) $ >
  $ wceq F (coprab x3 y1 z (wa (wa (wcel (cv x3) R) (wcel (cv y1) S)) ph)) $ >
  $ wi (wa (wcel A2 R) (wcel B2 S)) (wb (wceq (co A2 B2 F) C) th) $;

--| The value of an operation class abstraction. Compared with ~ ovig , the condition ` ( x e. R /\ y e. S ) ` is removed. (Contributed by FL, 24-Mar-2007.) (Revised by Mario Carneiro, 19-Dec-2013.)
theorem ovigg {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff) (A2 B2 C: class) (F V W X: class x3 y1 z):
  $ wi (w3a (wceq (cv x3) A2) (wceq (cv y1) B2) (wceq (cv z) C)) (wb ph ps) $ >
  $ wmo z ph $ >
  $ wceq F (coprab x3 y1 z ph) $ >
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel C X)) (wi ps (wceq (co A2 B2 F) C)) $;

--| The value of an operation class abstraction (weak version). (Contributed by NM, 14-Sep-1999.) Remove unnecessary distinct variable conditions. (Revised by David Abernethy, 19-Jun-2012.) (Revised by Mario Carneiro, 19-Dec-2013.)
theorem ovig {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff) (A2 B2 C: class) (D: class x3 y1 z) (R S: class) (F: class x3 y1 z):
  $ wi (w3a (wceq (cv x3) A2) (wceq (cv y1) B2) (wceq (cv z) C)) (wb ph ps) $ >
  $ wi (wa (wcel (cv x3) R) (wcel (cv y1) S)) (wmo z ph) $ >
  $ wceq F (coprab x3 y1 z (wa (wa (wcel (cv x3) R) (wcel (cv y1) S)) ph)) $ >
  $ wi (w3a (wcel A2 R) (wcel B2 S) (wcel C D)) (wi ps (wceq (co A2 B2 F) C)) $;

--| Value of a function given by the maps-to notation. (This is the operation analogue of ~ fvmpt2 .) (Contributed by NM, 21-Feb-2004.) (Revised by Mario Carneiro, 1-Sep-2015.)
theorem ovmpt4g {x3 y1: setvar} (A2 B2 C F V: class x3 y1):
  $ wceq F (cmpo x3 y1 A2 B2 C) $ >
  $ wi (w3a (wcel (cv x3) A2) (wcel (cv y1) B2) (wcel C V)) (wceq (co (cv x3) (cv y1) F) C) $;

--| Value of a function given by the maps-to notation, expressed using explicit substitution. (Contributed by Mario Carneiro, 30-Apr-2015.)
theorem ovmpos {x3 y1: setvar} (A2 B2 C D: class) (R F V: class x3 y1):
  $ wceq F (cmpo x3 y1 C D R) $ >
  $ wi (w3a (wcel A2 C) (wcel B2 D) (wcel (csb x3 A2 (csb y1 B2 R)) V)) (wceq (co A2 B2 F) (csb x3 A2 (csb y1 B2 R))) $;

--| The value of an operation class abstraction. A version of ~ ovmpog using bound-variable hypotheses. (Contributed by NM, 17-Aug-2006.) (Revised by Mario Carneiro, 19-Dec-2013.)
theorem ov2gf {x3 y1: setvar} (A2 B2: class x3 y1) (C D: class) (R S F G H: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wnfc y1 B2 $ >
  $ wnfc x3 G $ >
  $ wnfc y1 S $ >
  $ wi (wceq (cv x3) A2) (wceq R G) $ >
  $ wi (wceq (cv y1) B2) (wceq G S) $ >
  $ wceq F (cmpo x3 y1 C D R) $ >
  $ wi (w3a (wcel A2 C) (wcel B2 D) (wcel S H)) (wceq (co A2 B2 F) S) $;

--| Value of an operation given by a maps-to rule, deduction form. (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem ovmpodxf {x3 y1: setvar} (ph: wff x3 y1) (A2: class y1) (B2: class x3) (C D R S F L X: class x3 y1):
  $ wi ph (wceq F (cmpo x3 y1 C D R)) $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wceq R S) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wceq D L) $ >
  $ wi ph (wcel A2 C) $ >
  $ wi ph (wcel B2 L) $ >
  $ wi ph (wcel S X) $ >
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wnfc y1 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 S $ >
  $ wnfc y1 S $ >
  $ wi ph (wceq (co A2 B2 F) S) $;

--| Value of an operation given by a maps-to rule, deduction form. (Contributed by Mario Carneiro, 29-Dec-2014.)
theorem ovmpodx {x3 y1: setvar} (ph: wff) (A2 B2: class) (C D R: class x3 y1) (S: class) (F L X: class x3 y1):
  $ wi ph (wceq F (cmpo x3 y1 C D R)) $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wceq R S) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wceq D L) $ >
  $ wi ph (wcel A2 C) $ >
  $ wi ph (wcel B2 L) $ >
  $ wi ph (wcel S X) $ >
  $ wi ph (wceq (co A2 B2 F) S) $;

--| Value of an operation given by a maps-to rule, deduction form. (Contributed by Mario Carneiro, 7-Dec-2014.)
theorem ovmpod {x3 y1: setvar} (ph: wff) (A2 B2: class) (C D R: class x3 y1) (S: class) (F X: class x3 y1):
  $ wi ph (wceq F (cmpo x3 y1 C D R)) $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wceq R S) $ >
  $ wi ph (wcel A2 C) $ >
  $ wi ph (wcel B2 D) $ >
  $ wi ph (wcel S X) $ >
  $ wi ph (wceq (co A2 B2 F) S) $;

--| The value of an operation class abstraction. Variant of ~ ovmpoga which does not require ` D ` and ` x ` to be distinct. (Contributed by Jeff Madsen, 10-Jun-2010.) (Revised by Mario Carneiro, 20-Dec-2013.)
theorem ovmpox {x3 y1: setvar} (A2 B2 C: class) (D R: class x3 y1) (S: class) (F H: class x3 y1) (L: class):
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wceq R S) $ >
  $ wi (wceq (cv x3) A2) (wceq D L) $ >
  $ wceq F (cmpo x3 y1 C D R) $ >
  $ wi (w3a (wcel A2 C) (wcel B2 L) (wcel S H)) (wceq (co A2 B2 F) S) $;

--| Value of an operation given by a maps-to rule. (Contributed by Mario Carneiro, 19-Dec-2013.)
theorem ovmpoga {x3 y1: setvar} (A2 B2 C D: class) (R: class x3 y1) (S: class) (F H: class x3 y1):
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wceq R S) $ >
  $ wceq F (cmpo x3 y1 C D R) $ >
  $ wi (w3a (wcel A2 C) (wcel B2 D) (wcel S H)) (wceq (co A2 B2 F) S) $;

--| Value of an operation given by a maps-to rule. (Contributed by NM, 19-Dec-2013.)
theorem ovmpoa {x3 y1: setvar} (A2 B2 C D: class) (R: class x3 y1) (S: class) (F: class x3 y1):
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wceq R S) $ >
  $ wceq F (cmpo x3 y1 C D R) $ >
  $ wcel S cvv $ >
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wceq (co A2 B2 F) S) $;

--| Alternate deduction version of ~ ovmpo , suitable for iteration. (Contributed by Mario Carneiro, 7-Jan-2017.)
theorem ovmpodf {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (A2: class) (B2: class x3) (C D R F V: class x3 y1):
  $ wi ph (wcel A2 C) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wcel B2 D) $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wcel R V) $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wi (wceq (co A2 B2 F) R) ps) $ >
  $ wnfc x3 F $ >
  $ wnf x3 ps $ >
  $ wnfc y1 F $ >
  $ wnf y1 ps $ >
  $ wi ph (wi (wceq F (cmpo x3 y1 C D R)) ps) $;

--| Alternate deduction version of ~ ovmpo , suitable for iteration. (Contributed by Mario Carneiro, 7-Jan-2017.)
theorem ovmpodv {x3 y1: setvar} (ph ps: wff) (A2: class) (B2: class x3) (C D R: class x3 y1) (F: class) (V: class x3 y1):
  $ wi ph (wcel A2 C) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wcel B2 D) $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wcel R V) $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wi (wceq (co A2 B2 F) R) ps) $ >
  $ wi ph (wi (wceq F (cmpo x3 y1 C D R)) ps) $;

--| Alternate deduction version of ~ ovmpo , suitable for iteration. (Contributed by Mario Carneiro, 7-Jan-2017.)
theorem ovmpodv2 {x3 y1: setvar} (ph: wff) (A2 B2: class) (C D R: class x3 y1) (S: class) (F V: class x3 y1):
  $ wi ph (wcel A2 C) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wcel B2 D) $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wcel R V) $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wceq R S) $ >
  $ wi ph (wi (wceq F (cmpo x3 y1 C D R)) (wceq (co A2 B2 F) S)) $;

--| Value of an operation given by a maps-to rule. Special case. (Contributed by NM, 14-Sep-1999.) (Revised by David Abernethy, 19-Jun-2012.)
theorem ovmpog {x3 y1: setvar} (A2 B2 C D: class) (R: class x3 y1) (S: class) (F G H: class x3 y1):
  $ wi (wceq (cv x3) A2) (wceq R G) $ >
  $ wi (wceq (cv y1) B2) (wceq G S) $ >
  $ wceq F (cmpo x3 y1 C D R) $ >
  $ wi (w3a (wcel A2 C) (wcel B2 D) (wcel S H)) (wceq (co A2 B2 F) S) $;

--| Value of an operation given by a maps-to rule. Special case. (Contributed by NM, 16-May-1995.) (Revised by David Abernethy, 19-Jun-2012.)
theorem ovmpo {x3 y1: setvar} (A2 B2 C D: class) (R: class x3 y1) (S: class) (F G: class x3 y1):
  $ wi (wceq (cv x3) A2) (wceq R G) $ >
  $ wi (wceq (cv y1) B2) (wceq G S) $ >
  $ wceq F (cmpo x3 y1 C D R) $ >
  $ wcel S cvv $ >
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wceq (co A2 B2 F) S) $;

--| The value of an operation is equal to the value of the same operation expressed in maps-to notation. (Contributed by GG, 16-Mar-2025.) (Revised by GG, 13-Apr-2025.)
theorem ovmpot {x3 y1: setvar} (A2 B2 C D F: class):
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wceq (co A2 B2 (cmpo x3 y1 C D (co (cv x3) (cv y1) F))) (co A2 B2 F)) $;

--| Value of an operation given by maps-to notation. (Contributed by Rohan Ridenour, 14-May-2024.)
theorem fvmpopr2d {a b: setvar} (ph: wff a b) (A2 B2: class) (C P F V: class a b):
  $ wi ph (wceq F (cmpo a b A2 B2 C)) $ >
  $ wi ph (wceq P (cop (cv a) (cv b))) $ >
  $ wi (w3a ph (wcel (cv a) A2) (wcel (cv b) B2)) (wcel C V) $ >
  $ wi (w3a ph (wcel (cv a) A2) (wcel (cv b) B2)) (wceq (cfv P F) C) $;

--| The value of an operation class abstraction. Special case. (Contributed by NM, 28-May-1995.) (Revised by Mario Carneiro, 29-Dec-2014.)
theorem ov3 {x3 y1 z w v u f2: setvar} (A2 B2: class) (C D: class x3) (R: class w v u f2) (S: class x3 y1) (F: class x3 y1 z w v u f2) (H: class):
  $ wcel S cvv $ >
  $ wi (wa (wa (wceq (cv w) A2) (wceq (cv v) B2)) (wa (wceq (cv u) C) (wceq (cv f2) D))) (wceq R S) $ >
  $ wceq F (coprab x3 y1 z (wa (wa (wcel (cv x3) (cxp H H)) (wcel (cv y1) (cxp H H))) (wex w (wex v (wex u (wex f2 (wa (wa (wceq (cv x3) (cop (cv w) (cv v))) (wceq (cv y1) (cop (cv u) (cv f2)))) (wceq (cv z) R)))))))) $ >
  $ wi (wa (wa (wcel A2 H) (wcel B2 H)) (wa (wcel C H) (wcel D H))) (wceq (co (cop A2 B2) (cop C D) F) S) $;

--| The value of an operation class abstraction. Special case. (Contributed by NM, 13-Nov-2006.)
theorem ov6g {x3 y1 z: setvar} (A2 B2 C: class) (R: class x3 y1) (S: class) (F G H J: class x3 y1 z):
  $ wi (wceq (cop (cv x3) (cv y1)) (cop A2 B2)) (wceq R S) $ >
  $ wceq F (coprab x3 y1 z (wa (wcel (cop (cv x3) (cv y1)) C) (wceq (cv z) R))) $ >
  $ wi (wa (w3a (wcel A2 G) (wcel B2 H) (wcel (cop A2 B2) C)) (wcel S J)) (wceq (co A2 B2 F) S) $;

--| The value of an operation class abstraction. (Contributed by Jeff Madsen, 10-Jun-2010.)
theorem ovg {x3 y1 z: setvar} (ph: wff x3 y1 z) (ps: wff y1 z) (ch: wff z) (th: wff) (ta: wff z) (A2 B2 C: class) (D: class x3 y1 z) (R S: class) (F: class x3 y1 z):
  $ wi (wceq (cv x3) A2) (wb ph ps) $ >
  $ wi (wceq (cv y1) B2) (wb ps ch) $ >
  $ wi (wceq (cv z) C) (wb ch th) $ >
  $ wi (wa ta (wa (wcel (cv x3) R) (wcel (cv y1) S))) (weu z ph) $ >
  $ wceq F (coprab x3 y1 z (wa (wa (wcel (cv x3) R) (wcel (cv y1) S)) ph)) $ >
  $ wi (wa ta (w3a (wcel A2 R) (wcel B2 S) (wcel C D))) (wb (wceq (co A2 B2 F) C) th) $;

--| The value of a restricted operation. (Contributed by FL, 10-Nov-2006.)
theorem ovres (A2 B2 C D F: class):
  $ wi (wa (wcel A2 C) (wcel B2 D)) (wceq (co A2 B2 (cres F (cxp C D))) (co A2 B2 F)) $;

--| Lemma for converting metric theorems to metric space theorems. (Contributed by Mario Carneiro, 2-Oct-2015.)
theorem ovresd (ph: wff) (A2 B2 D X: class):
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wcel B2 X) $ >
  $ wi ph (wceq (co A2 B2 (cres D (cxp X X))) (co A2 B2 D)) $;

--| The restriction of an operation is an operation. (Contributed by NM, 1-Feb-2008.) (Revised by AV, 19-Oct-2021.)
theorem oprres {x3 y1: setvar} (ph: wff) (R S: class x3 y1) (F G: class) (X: class x3 y1) (Y: class):
  $ wi (w3a ph (wcel (cv x3) Y) (wcel (cv y1) Y)) (wceq (co (cv x3) (cv y1) F) (co (cv x3) (cv y1) G)) $ >
  $ wi ph (wss Y X) $ >
  $ wi ph (wf (cxp Y Y) R F) $ >
  $ wi ph (wf (cxp X X) S G) $ >
  $ wi ph (wceq F (cres G (cxp Y Y))) $;

--| If a class' operation value for two operands is not the empty set, the operands are contained in the domain of the class, and the class restricted to the operands is a function, analogous to ~ fvfundmfvn0 . (Contributed by AV, 27-Jan-2020.)
theorem ovn0ssdmfun {a b: setvar} (D E F: class):
  $ wi (wral a (wral b (wne (co (cv a) (cv b) F) c0) E) D) (wa (wss (cxp D E) (cdm F)) (wfun (cres F (cxp D E)))) $;

--| The value of a member of the domain of a subclass of an operation. (Contributed by NM, 23-Aug-2007.)
theorem oprssov (A2 B2 C D F G: class):
  $ wi (wa (w3a (wfun F) (wfn G (cxp C D)) (wss G F)) (wa (wcel A2 C) (wcel B2 D))) (wceq (co A2 B2 F) (co A2 B2 G)) $;

--| An operation's value belongs to its codomain. (Contributed by NM, 27-Aug-2006.)
theorem fovcdm (A2 B2 C R S F: class):
  $ wi (w3a (wf (cxp R S) C F) (wcel A2 R) (wcel B2 S)) (wcel (co A2 B2 F) C) $;

--| An operation's value belongs to its codomain. (Contributed by Mario Carneiro, 29-Dec-2016.)
theorem fovcdmda (ph: wff) (A2 B2 C R S F: class):
  $ wi ph (wf (cxp R S) C F) $ >
  $ wi (wa ph (wa (wcel A2 R) (wcel B2 S))) (wcel (co A2 B2 F) C) $;

--| An operation's value belongs to its codomain. (Contributed by Mario Carneiro, 29-Dec-2016.)
theorem fovcdmd (ph: wff) (A2 B2 C R S F: class):
  $ wi ph (wf (cxp R S) C F) $ >
  $ wi ph (wcel A2 R) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel (co A2 B2 F) C) $;

--| The range of an operation expressed as a collection of the operation's values. (Contributed by NM, 29-Oct-2006.)
theorem fnrnov {x3 y1 z: setvar} (A2 B2 F: class):
  $ wi (wfn F (cxp A2 B2)) (wceq (crn F) (cab z (wrex x3 (wrex y1 (wceq (cv z) (co (cv x3) (cv y1) F)) B2) A2))) $;

--| An onto mapping of an operation expressed in terms of operation values. (Contributed by NM, 29-Oct-2006.)
theorem foov {x3 y1 z: setvar} (A2 B2: class) (C: class x3 y1) (F: class):
  $ wb (wfo (cxp A2 B2) C F) (wa (wf (cxp A2 B2) C F) (wral z (wrex x3 (wrex y1 (wceq (cv z) (co (cv x3) (cv y1) F)) B2) A2) C)) $;

--| An operation's value belongs to its range. (Contributed by NM, 10-Feb-2007.)
theorem fnovrn (A2 B2 C D F: class):
  $ wi (w3a (wfn F (cxp A2 B2)) (wcel C A2) (wcel D B2)) (wcel (co C D F) (crn F)) $;

--| A member of an operation's range is a value of the operation. (Contributed by NM, 7-Feb-2007.) (Revised by Mario Carneiro, 30-Jan-2014.)
theorem ovelrn {x3 y1: setvar} (A2 B2 C F: class):
  $ wi (wfn F (cxp A2 B2)) (wb (wcel C (crn F)) (wrex x3 (wrex y1 (wceq C (co (cv x3) (cv y1) F)) B2) A2)) $;

--| Membership relation for the values of a function whose image is a subclass. (Contributed by Mario Carneiro, 23-Dec-2013.)
theorem funimassov {x3 y1: setvar} (A2 B2 C F: class):
  $ wi (wa (wfun F) (wss (cxp A2 B2) (cdm F))) (wb (wss (cima F (cxp A2 B2)) C) (wral x3 (wral y1 (wcel (co (cv x3) (cv y1) F) C) B2) A2)) $;

--| Operation value in an image. (Contributed by Mario Carneiro, 23-Dec-2013.) (Revised by Mario Carneiro, 29-Jan-2014.)
theorem ovelimab {x3 y1: setvar} (A2 B2 C D F: class):
  $ wi (wa (wfn F A2) (wss (cxp B2 C) A2)) (wb (wcel D (cima F (cxp B2 C))) (wrex x3 (wrex y1 (wceq D (co (cv x3) (cv y1) F)) C) B2)) $;

--| An operation value is a member of the image plus null. (Contributed by Thierry Arnoux, 25-Jun-2019.)
theorem ovima0 (A2 B2 R X Y: class):
  $ wi (wa (wcel X A2) (wcel Y B2)) (wcel (co X Y R) (cun (cima R (cxp A2 B2)) (csn c0))) $;

--| The value of a constant operation. (Contributed by NM, 5-Nov-2006.)
theorem ovconst2 (A2 B2 C R S: class):
  $ wcel C cvv $ >
  $ wi (wa (wcel R A2) (wcel S B2)) (wceq (co R S (cxp (cxp A2 B2) (csn C))) C) $;

--| Domain of closure of an operation. (Contributed by NM, 24-Aug-1995.)
theorem oprssdm {x3 y1: setvar} (S F: class):
  $ wn (wcel c0 S) $ >
  $ wi (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wcel (co (cv x3) (cv y1) F) S) $ >
  $ wss (cxp S S) (cdm F) $;

--| The value of an operation outside its domain. (Contributed by Alexander van der Vekens, 7-Sep-2017.)
theorem nssdmovg (A2 B2 R S F: class):
  $ wi (wa (wss (cdm F) (cxp R S)) (wn (wa (wcel A2 R) (wcel B2 S)))) (wceq (co A2 B2 F) c0) $;

--| The value of an operation outside its domain. (Contributed by NM, 28-Mar-2008.)
theorem ndmovg (A2 B2 R S F: class):
  $ wi (wa (wceq (cdm F) (cxp R S)) (wn (wa (wcel A2 R) (wcel B2 S)))) (wceq (co A2 B2 F) c0) $;

--| The value of an operation outside its domain. (Contributed by NM, 24-Aug-1995.)
theorem ndmov (A2 B2 S F: class):
  $ wceq (cdm F) (cxp S S) $ >
  $ wi (wn (wa (wcel A2 S) (wcel B2 S))) (wceq (co A2 B2 F) c0) $;

--| The closure of an operation outside its domain, when the domain includes the empty set. This technical lemma can make the operation more convenient to work in some cases. It is dependent on our particular definitions of operation value, function value, and ordered pair. (Contributed by NM, 24-Sep-2004.)
theorem ndmovcl (A2 B2 S F: class):
  $ wceq (cdm F) (cxp S S) $ >
  $ wi (wa (wcel A2 S) (wcel B2 S)) (wcel (co A2 B2 F) S) $ >
  $ wcel c0 S $ >
  $ wcel (co A2 B2 F) S $;

--| Reverse closure law, when an operation's domain doesn't contain the empty set. (Contributed by NM, 3-Feb-1996.)
theorem ndmovrcl (A2 B2 S F: class):
  $ wceq (cdm F) (cxp S S) $ >
  $ wn (wcel c0 S) $ >
  $ wi (wcel (co A2 B2 F) S) (wa (wcel A2 S) (wcel B2 S)) $;

--| Any operation is commutative outside its domain. (Contributed by NM, 24-Aug-1995.)
theorem ndmovcom (A2 B2 S F: class):
  $ wceq (cdm F) (cxp S S) $ >
  $ wi (wn (wa (wcel A2 S) (wcel B2 S))) (wceq (co A2 B2 F) (co B2 A2 F)) $;

--| Any operation is associative outside its domain, if the domain doesn't contain the empty set. (Contributed by NM, 24-Aug-1995.)
theorem ndmovass (A2 B2 C S F: class):
  $ wceq (cdm F) (cxp S S) $ >
  $ wn (wcel c0 S) $ >
  $ wi (wn (w3a (wcel A2 S) (wcel B2 S) (wcel C S))) (wceq (co (co A2 B2 F) C F) (co A2 (co B2 C F) F)) $;

--| Any operation is distributive outside its domain, if the domain doesn't contain the empty set. (Contributed by NM, 24-Aug-1995.)
theorem ndmovdistr (A2 B2 C S F G: class):
  $ wceq (cdm F) (cxp S S) $ >
  $ wn (wcel c0 S) $ >
  $ wceq (cdm G) (cxp S S) $ >
  $ wi (wn (w3a (wcel A2 S) (wcel B2 S) (wcel C S))) (wceq (co A2 (co B2 C F) G) (co (co A2 B2 G) (co A2 C G) F)) $;

--| Elimination of redundant antecedents in an ordering law. (Contributed by NM, 7-Mar-1996.)
theorem ndmovord (A2 B2 C R S F: class):
  $ wceq (cdm F) (cxp S S) $ >
  $ wss R (cxp S S) $ >
  $ wn (wcel c0 S) $ >
  $ wi (w3a (wcel A2 S) (wcel B2 S) (wcel C S)) (wb (wbr A2 B2 R) (wbr (co C A2 F) (co C B2 F) R)) $ >
  $ wi (wcel C S) (wb (wbr A2 B2 R) (wbr (co C A2 F) (co C B2 F) R)) $;

--| Elimination of redundant antecedent in an ordering law. (Contributed by NM, 25-Jun-1998.)
theorem ndmovordi (A2 B2 C R S F: class):
  $ wceq (cdm F) (cxp S S) $ >
  $ wss R (cxp S S) $ >
  $ wn (wcel c0 S) $ >
  $ wi (wcel C S) (wb (wbr A2 B2 R) (wbr (co C A2 F) (co C B2 F) R)) $ >
  $ wi (wbr (co C A2 F) (co C B2 F) R) (wbr A2 B2 R) $;

--| Convert an operation closure law to class notation. (Contributed by Mario Carneiro, 26-May-2014.)
theorem caovclg {x3 y1: setvar} (ph: wff) (A2: class) (B2: class x3) (C D E F: class):
  $ wi (wa ph (wa (wcel (cv x3) C) (wcel (cv y1) D))) (wcel (co (cv x3) (cv y1) F) E) $ >
  $ wi (wa ph (wa (wcel A2 C) (wcel B2 D))) (wcel (co A2 B2 F) E) $;

--| Convert an operation closure law to class notation. (Contributed by Mario Carneiro, 30-Dec-2014.)
theorem caovcld {x3 y1: setvar} (ph: wff) (A2: class) (B2: class x3) (C D E F: class):
  $ wi (wa ph (wa (wcel (cv x3) C) (wcel (cv y1) D))) (wcel (co (cv x3) (cv y1) F) E) $ >
  $ wi ph (wcel A2 C) $ >
  $ wi ph (wcel B2 D) $ >
  $ wi ph (wcel (co A2 B2 F) E) $;

--| Convert an operation closure law to class notation. (Contributed by NM, 4-Aug-1995.) (Revised by Mario Carneiro, 26-May-2014.)
theorem caovcl {x3 y1: setvar} (A2: class) (B2: class x3) (S F: class):
  $ wi (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wcel (co (cv x3) (cv y1) F) S) $ >
  $ wi (wa (wcel A2 S) (wcel B2 S)) (wcel (co A2 B2 F) S) $;

--| Convert an operation commutative law to class notation. (Contributed by Mario Carneiro, 1-Jun-2013.)
theorem caovcomg {x3 y1: setvar} (ph: wff) (A2 B2 S F: class):
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wceq (co (cv x3) (cv y1) F) (co (cv y1) (cv x3) F)) $ >
  $ wi (wa ph (wa (wcel A2 S) (wcel B2 S))) (wceq (co A2 B2 F) (co B2 A2 F)) $;

--| Convert an operation commutative law to class notation. (Contributed by Mario Carneiro, 30-Dec-2014.)
theorem caovcomd {x3 y1: setvar} (ph: wff) (A2 B2 S F: class):
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wceq (co (cv x3) (cv y1) F) (co (cv y1) (cv x3) F)) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wceq (co A2 B2 F) (co B2 A2 F)) $;

--| Convert an operation commutative law to class notation. (Contributed by NM, 26-Aug-1995.) (Revised by Mario Carneiro, 1-Jun-2013.)
theorem caovcom {x3 y1: setvar} (A2 B2 F: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq (co (cv x3) (cv y1) F) (co (cv y1) (cv x3) F) $ >
  $ wceq (co A2 B2 F) (co B2 A2 F) $;

--| Convert an operation associative law to class notation. (Contributed by Mario Carneiro, 1-Jun-2013.) (Revised by Mario Carneiro, 26-May-2014.)
theorem caovassg {x3 y1 z: setvar} (ph: wff) (A2 B2 C S F: class):
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wceq (co (co (cv x3) (cv y1) F) (cv z) F) (co (cv x3) (co (cv y1) (cv z) F) F)) $ >
  $ wi (wa ph (w3a (wcel A2 S) (wcel B2 S) (wcel C S))) (wceq (co (co A2 B2 F) C F) (co A2 (co B2 C F) F)) $;

--| Convert an operation associative law to class notation. (Contributed by Mario Carneiro, 30-Dec-2014.)
theorem caovassd {x3 y1 z: setvar} (ph: wff) (A2 B2 C S F: class):
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wceq (co (co (cv x3) (cv y1) F) (cv z) F) (co (cv x3) (co (cv y1) (cv z) F) F)) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C S) $ >
  $ wi ph (wceq (co (co A2 B2 F) C F) (co A2 (co B2 C F) F)) $;

--| Convert an operation associative law to class notation. (Contributed by NM, 26-Aug-1995.) (Revised by Mario Carneiro, 26-May-2014.)
theorem caovass {x3 y1 z: setvar} (A2 B2 C F: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wceq (co (co (cv x3) (cv y1) F) (cv z) F) (co (cv x3) (co (cv y1) (cv z) F) F) $ >
  $ wceq (co (co A2 B2 F) C F) (co A2 (co B2 C F) F) $;

--| Convert an operation cancellation law to class notation. (Contributed by NM, 20-Aug-1995.) (Revised by Mario Carneiro, 30-Dec-2014.)
theorem caovcang {x3 y1 z: setvar} (ph: wff) (A2 B2 C S T F: class):
  $ wi (wa ph (w3a (wcel (cv x3) T) (wcel (cv y1) S) (wcel (cv z) S))) (wb (wceq (co (cv x3) (cv y1) F) (co (cv x3) (cv z) F)) (wceq (cv y1) (cv z))) $ >
  $ wi (wa ph (w3a (wcel A2 T) (wcel B2 S) (wcel C S))) (wb (wceq (co A2 B2 F) (co A2 C F)) (wceq B2 C)) $;

--| Convert an operation cancellation law to class notation. (Contributed by Mario Carneiro, 30-Dec-2014.)
theorem caovcand {x3 y1 z: setvar} (ph: wff) (A2 B2 C S T F: class):
  $ wi (wa ph (w3a (wcel (cv x3) T) (wcel (cv y1) S) (wcel (cv z) S))) (wb (wceq (co (cv x3) (cv y1) F) (co (cv x3) (cv z) F)) (wceq (cv y1) (cv z))) $ >
  $ wi ph (wcel A2 T) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C S) $ >
  $ wi ph (wb (wceq (co A2 B2 F) (co A2 C F)) (wceq B2 C)) $;

--| Commute the arguments of an operation cancellation law. (Contributed by Mario Carneiro, 30-Dec-2014.)
theorem caovcanrd {x3 y1 z: setvar} (ph: wff) (A2 B2 C S T F: class):
  $ wi (wa ph (w3a (wcel (cv x3) T) (wcel (cv y1) S) (wcel (cv z) S))) (wb (wceq (co (cv x3) (cv y1) F) (co (cv x3) (cv z) F)) (wceq (cv y1) (cv z))) $ >
  $ wi ph (wcel A2 T) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C S) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wceq (co (cv x3) (cv y1) F) (co (cv y1) (cv x3) F)) $ >
  $ wi ph (wb (wceq (co B2 A2 F) (co C A2 F)) (wceq B2 C)) $;

--| Convert an operation cancellation law to class notation. (Contributed by NM, 20-Aug-1995.)
theorem caovcan {x3 y1 z: setvar} (A2 B2 C S F: class):
  $ wcel C cvv $ >
  $ wi (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wi (wceq (co (cv x3) (cv y1) F) (co (cv x3) (cv z) F)) (wceq (cv y1) (cv z))) $ >
  $ wi (wa (wcel A2 S) (wcel B2 S)) (wi (wceq (co A2 B2 F) (co A2 C F)) (wceq B2 C)) $;

--| Convert an operation ordering law to class notation. (Contributed by Mario Carneiro, 31-Dec-2014.)
theorem caovordig {x3 y1 z: setvar} (ph: wff) (A2 B2 C R S F: class):
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wi (wbr (cv x3) (cv y1) R) (wbr (co (cv z) (cv x3) F) (co (cv z) (cv y1) F) R)) $ >
  $ wi (wa ph (w3a (wcel A2 S) (wcel B2 S) (wcel C S))) (wi (wbr A2 B2 R) (wbr (co C A2 F) (co C B2 F) R)) $;

--| Convert an operation ordering law to class notation. (Contributed by Mario Carneiro, 31-Dec-2014.)
theorem caovordid {x3 y1 z: setvar} (ph: wff) (A2 B2 C R S F: class):
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wi (wbr (cv x3) (cv y1) R) (wbr (co (cv z) (cv x3) F) (co (cv z) (cv y1) F) R)) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C S) $ >
  $ wi ph (wi (wbr A2 B2 R) (wbr (co C A2 F) (co C B2 F) R)) $;

--| Convert an operation ordering law to class notation. (Contributed by NM, 19-Feb-1996.) (Revised by Mario Carneiro, 30-Dec-2014.)
theorem caovordg {x3 y1 z: setvar} (ph: wff) (A2 B2 C R S F: class):
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wb (wbr (cv x3) (cv y1) R) (wbr (co (cv z) (cv x3) F) (co (cv z) (cv y1) F) R)) $ >
  $ wi (wa ph (w3a (wcel A2 S) (wcel B2 S) (wcel C S))) (wb (wbr A2 B2 R) (wbr (co C A2 F) (co C B2 F) R)) $;

--| Convert an operation ordering law to class notation. (Contributed by Mario Carneiro, 30-Dec-2014.)
theorem caovordd {x3 y1 z: setvar} (ph: wff) (A2 B2 C R S F: class):
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wb (wbr (cv x3) (cv y1) R) (wbr (co (cv z) (cv x3) F) (co (cv z) (cv y1) F) R)) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C S) $ >
  $ wi ph (wb (wbr A2 B2 R) (wbr (co C A2 F) (co C B2 F) R)) $;

--| Operation ordering law with commuted arguments. (Contributed by Mario Carneiro, 30-Dec-2014.)
theorem caovord2d {x3 y1 z: setvar} (ph: wff) (A2 B2 C R S F: class):
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wb (wbr (cv x3) (cv y1) R) (wbr (co (cv z) (cv x3) F) (co (cv z) (cv y1) F) R)) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C S) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wceq (co (cv x3) (cv y1) F) (co (cv y1) (cv x3) F)) $ >
  $ wi ph (wb (wbr A2 B2 R) (wbr (co A2 C F) (co B2 C F) R)) $;

--| Ordering law. (Contributed by Mario Carneiro, 30-Dec-2014.)
theorem caovord3d {x3 y1 z: setvar} (ph: wff) (A2 B2 C D R S F: class):
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wb (wbr (cv x3) (cv y1) R) (wbr (co (cv z) (cv x3) F) (co (cv z) (cv y1) F) R)) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C S) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wceq (co (cv x3) (cv y1) F) (co (cv y1) (cv x3) F)) $ >
  $ wi ph (wcel D S) $ >
  $ wi ph (wi (wceq (co A2 B2 F) (co C D F)) (wb (wbr A2 C R) (wbr D B2 R))) $;

--| Convert an operation ordering law to class notation. (Contributed by NM, 19-Feb-1996.)
theorem caovord {x3 y1 z: setvar} (A2 B2 C R S F: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wcel (cv z) S) (wb (wbr (cv x3) (cv y1) R) (wbr (co (cv z) (cv x3) F) (co (cv z) (cv y1) F) R)) $ >
  $ wi (wcel C S) (wb (wbr A2 B2 R) (wbr (co C A2 F) (co C B2 F) R)) $;

--| Operation ordering law with commuted arguments. (Contributed by NM, 27-Feb-1996.)
theorem caovord2 {x3 y1 z: setvar} (A2 B2 C R S F: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wcel (cv z) S) (wb (wbr (cv x3) (cv y1) R) (wbr (co (cv z) (cv x3) F) (co (cv z) (cv y1) F) R)) $ >
  $ wcel C cvv $ >
  $ wceq (co (cv x3) (cv y1) F) (co (cv y1) (cv x3) F) $ >
  $ wi (wcel C S) (wb (wbr A2 B2 R) (wbr (co A2 C F) (co B2 C F) R)) $;

--| Ordering law. (Contributed by NM, 29-Feb-1996.)
theorem caovord3 {x3 y1 z: setvar} (A2 B2 C D R S F: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (wcel (cv z) S) (wb (wbr (cv x3) (cv y1) R) (wbr (co (cv z) (cv x3) F) (co (cv z) (cv y1) F) R)) $ >
  $ wcel C cvv $ >
  $ wceq (co (cv x3) (cv y1) F) (co (cv y1) (cv x3) F) $ >
  $ wcel D cvv $ >
  $ wi (wa (wa (wcel B2 S) (wcel C S)) (wceq (co A2 B2 F) (co C D F))) (wb (wbr A2 C R) (wbr D B2 R)) $;

--| Convert an operation distributive law to class notation. (Contributed by NM, 25-Aug-1995.) (Revised by Mario Carneiro, 26-Jul-2014.)
theorem caovdig {x3 y1 z: setvar} (ph: wff) (A2 B2 C S F G H K: class):
  $ wi (wa ph (w3a (wcel (cv x3) K) (wcel (cv y1) S) (wcel (cv z) S))) (wceq (co (cv x3) (co (cv y1) (cv z) F) G) (co (co (cv x3) (cv y1) G) (co (cv x3) (cv z) G) H)) $ >
  $ wi (wa ph (w3a (wcel A2 K) (wcel B2 S) (wcel C S))) (wceq (co A2 (co B2 C F) G) (co (co A2 B2 G) (co A2 C G) H)) $;

--| Convert an operation distributive law to class notation. (Contributed by Mario Carneiro, 30-Dec-2014.)
theorem caovdid {x3 y1 z: setvar} (ph: wff) (A2 B2 C S F G H K: class):
  $ wi (wa ph (w3a (wcel (cv x3) K) (wcel (cv y1) S) (wcel (cv z) S))) (wceq (co (cv x3) (co (cv y1) (cv z) F) G) (co (co (cv x3) (cv y1) G) (co (cv x3) (cv z) G) H)) $ >
  $ wi ph (wcel A2 K) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C S) $ >
  $ wi ph (wceq (co A2 (co B2 C F) G) (co (co A2 B2 G) (co A2 C G) H)) $;

--| Convert an operation distributive law to class notation. (Contributed by Mario Carneiro, 30-Dec-2014.)
theorem caovdir2d {x3 y1 z: setvar} (ph: wff) (A2 B2 C S F G: class):
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wceq (co (cv x3) (co (cv y1) (cv z) F) G) (co (co (cv x3) (cv y1) G) (co (cv x3) (cv z) G) F)) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C S) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wcel (co (cv x3) (cv y1) F) S) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wceq (co (cv x3) (cv y1) G) (co (cv y1) (cv x3) G)) $ >
  $ wi ph (wceq (co (co A2 B2 F) C G) (co (co A2 C G) (co B2 C G) F)) $;

--| Convert an operation reverse distributive law to class notation. (Contributed by Mario Carneiro, 19-Oct-2014.)
theorem caovdirg {x3 y1 z: setvar} (ph: wff) (A2 B2 C S F G H K: class):
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) K))) (wceq (co (co (cv x3) (cv y1) F) (cv z) G) (co (co (cv x3) (cv z) G) (co (cv y1) (cv z) G) H)) $ >
  $ wi (wa ph (w3a (wcel A2 S) (wcel B2 S) (wcel C K))) (wceq (co (co A2 B2 F) C G) (co (co A2 C G) (co B2 C G) H)) $;

--| Convert an operation distributive law to class notation. (Contributed by Mario Carneiro, 30-Dec-2014.)
theorem caovdird {x3 y1 z: setvar} (ph: wff) (A2 B2 C S F G H K: class):
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) K))) (wceq (co (co (cv x3) (cv y1) F) (cv z) G) (co (co (cv x3) (cv z) G) (co (cv y1) (cv z) G) H)) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C K) $ >
  $ wi ph (wceq (co (co A2 B2 F) C G) (co (co A2 C G) (co B2 C G) H)) $;

--| Convert an operation distributive law to class notation. (Contributed by NM, 25-Aug-1995.) (Revised by Mario Carneiro, 28-Jun-2013.)
theorem caovdi {x3 y1 z: setvar} (A2 B2 C F G: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wceq (co (cv x3) (co (cv y1) (cv z) F) G) (co (co (cv x3) (cv y1) G) (co (cv x3) (cv z) G) F) $ >
  $ wceq (co A2 (co B2 C F) G) (co (co A2 B2 G) (co A2 C G) F) $;


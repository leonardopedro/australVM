--| Lemma 1 for ~ 2itscp . (Contributed by AV, 4-Mar-2023.)
theorem _2itscplem1 (ph: wff) (A2 B2 D E X Y: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel X cr) $ >
  $ wi ph (wcel Y cr) $ >
  $ wceq D (co X A2 cmin) $ >
  $ wceq E (co B2 Y cmin) $ >
  $ wi ph (wceq (co (co (co (co E c2 cexp) (co B2 c2 cexp) cmul) (co (co D c2 cexp) (co A2 c2 cexp) cmul) caddc) (co c2 (co (co D A2 cmul) (co E B2 cmul) cmul) cmul) cmin) (co (co (co D A2 cmul) (co E B2 cmul) cmin) c2 cexp)) $;

--| Lemma 2 for ~ 2itscp . (Contributed by AV, 4-Mar-2023.)
theorem _2itscplem2 (ph: wff) (A2 B2 C D E X Y: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel X cr) $ >
  $ wi ph (wcel Y cr) $ >
  $ wceq D (co X A2 cmin) $ >
  $ wceq E (co B2 Y cmin) $ >
  $ wceq C (co (co D B2 cmul) (co E A2 cmul) caddc) $ >
  $ wi ph (wceq (co C c2 cexp) (co (co (co (co D c2 cexp) (co B2 c2 cexp) cmul) (co c2 (co (co D A2 cmul) (co E B2 cmul) cmul) cmul) caddc) (co (co E c2 cexp) (co A2 c2 cexp) cmul) caddc)) $;

--| Lemma D for ~ 2itscp . (Contributed by AV, 4-Mar-2023.)
theorem _2itscplem3 (ph: wff) (A2 B2 C D Q R S E X Y: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel X cr) $ >
  $ wi ph (wcel Y cr) $ >
  $ wceq D (co X A2 cmin) $ >
  $ wceq E (co B2 Y cmin) $ >
  $ wceq C (co (co D B2 cmul) (co E A2 cmul) caddc) $ >
  $ wi ph (wcel R cr) $ >
  $ wceq Q (co (co E c2 cexp) (co D c2 cexp) caddc) $ >
  $ wceq S (co (co (co R c2 cexp) Q cmul) (co C c2 cexp) cmin) $ >
  $ wi ph (wceq S (co (co (co (co E c2 cexp) (co (co R c2 cexp) (co A2 c2 cexp) cmin) cmul) (co (co D c2 cexp) (co (co R c2 cexp) (co B2 c2 cexp) cmin) cmul) caddc) (co c2 (co (co D A2 cmul) (co E B2 cmul) cmul) cmul) cmin)) $;

--| A condition for a quadratic equation with real coefficients (for the intersection points of a line with a circle) to have (exactly) two different real solutions. (Contributed by AV, 5-Mar-2023.) (Revised by AV, 16-May-2023.)
theorem _2itscp (ph: wff) (A2 B2 C D Q R S E X Y: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel X cr) $ >
  $ wi ph (wcel Y cr) $ >
  $ wceq D (co X A2 cmin) $ >
  $ wceq E (co B2 Y cmin) $ >
  $ wceq C (co (co D B2 cmul) (co E A2 cmul) caddc) $ >
  $ wi ph (wcel R cr) $ >
  $ wi ph (wbr (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co R c2 cexp) clt) $ >
  $ wi ph (wo (wne B2 Y) (wne A2 X)) $ >
  $ wceq Q (co (co E c2 cexp) (co D c2 cexp) caddc) $ >
  $ wceq S (co (co (co R c2 cexp) Q cmul) (co C c2 cexp) cmin) $ >
  $ wi ph (wbr cc0 S clt) $;

--| Lemma 1 for ~ itscnhlinecirc02p . (Contributed by AV, 6-Mar-2023.)
theorem itscnhlinecirc02plem1 (ph: wff) (A2 B2 C D R E X Y: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel X cr) $ >
  $ wi ph (wcel Y cr) $ >
  $ wceq D (co X A2 cmin) $ >
  $ wceq E (co B2 Y cmin) $ >
  $ wceq C (co (co D B2 cmul) (co E A2 cmul) caddc) $ >
  $ wi ph (wcel R cr) $ >
  $ wi ph (wbr (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co R c2 cexp) clt) $ >
  $ wi ph (wne B2 Y) $ >
  $ wi ph (wbr cc0 (co (co (cneg (co c2 (co D C cmul) cmul)) c2 cexp) (co c4 (co (co (co E c2 cexp) (co D c2 cexp) caddc) (co (co C c2 cexp) (co (co E c2 cexp) (co R c2 cexp) cmul) cmin) cmul) cmul) cmin) clt) $;

--| Lemma 2 for ~ itscnhlinecirc02p . (Contributed by AV, 10-Mar-2023.)
theorem itscnhlinecirc02plem2 (A2 B2 C D R E X Y: class):
  $ wceq D (co X A2 cmin) $ >
  $ wceq E (co B2 Y cmin) $ >
  $ wceq C (co (co B2 X cmul) (co A2 Y cmul) cmin) $ >
  $ wi (wa (w3a (wa (wcel A2 cr) (wcel B2 cr)) (wa (wcel X cr) (wcel Y cr)) (wne B2 Y)) (wa (wcel R cr) (wbr (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co R c2 cexp) clt))) (wbr cc0 (co (co (cneg (co c2 (co D C cmul) cmul)) c2 cexp) (co c4 (co (co (co E c2 cexp) (co D c2 cexp) caddc) (co (co C c2 cexp) (co (co E c2 cexp) (co R c2 cexp) cmul) cmin) cmul) cmul) cmin) clt) $;

--| Lemma 3 for ~ itscnhlinecirc02p . (Contributed by AV, 10-Mar-2023.)
theorem itscnhlinecirc02plem3 (D P R S E I L X Y c_0: class):
  $ wceq I (co cc0 c2 cfzo) $ >
  $ wceq E (cfv I crrx) $ >
  $ wceq P (co cr I cmap) $ >
  $ wceq S (cfv E csph) $ >
  $ wceq c_0 (cxp I (csn cc0)) $ >
  $ wceq L (cfv E cline) $ >
  $ wceq D (cfv E cds) $ >
  $ wi (wa (w3a (wcel X P) (wcel Y P) (wne (cfv c1 X) (cfv c1 Y))) (wa (wcel R crp) (wbr (co X c_0 D) R clt))) (wbr cc0 (co (co (cneg (co c2 (co (co (cfv cc0 Y) (cfv cc0 X) cmin) (co (co (cfv c1 X) (cfv cc0 Y) cmul) (co (cfv cc0 X) (cfv c1 Y) cmul) cmin) cmul) cmul)) c2 cexp) (co c4 (co (co (co (co (cfv c1 X) (cfv c1 Y) cmin) c2 cexp) (co (co (cfv cc0 Y) (cfv cc0 X) cmin) c2 cexp) caddc) (co (co (co (co (cfv c1 X) (cfv cc0 Y) cmul) (co (cfv cc0 X) (cfv c1 Y) cmul) cmin) c2 cexp) (co (co (co (cfv c1 X) (cfv c1 Y) cmin) c2 cexp) (co R c2 cexp) cmul) cmin) cmul) cmul) cmin) clt) $;

--| Intersection of a nonhorizontal line with a circle: A nonhorizontal line passing through a point within a circle around the origin intersects the circle at exactly two different points. (Contributed by AV, 28-Jan-2023.)
theorem itscnhlinecirc02p {x3 y1 s1: setvar} (D P R: class) (S E I L: class x3 y1 s1) (X Y c_0: class):
  $ wceq I (co cc0 c2 cfzo) $ >
  $ wceq E (cfv I crrx) $ >
  $ wceq P (co cr I cmap) $ >
  $ wceq S (cfv E csph) $ >
  $ wceq c_0 (cxp I (csn cc0)) $ >
  $ wceq L (cfv E cline) $ >
  $ wceq D (cfv E cds) $ >
  $ wi (wa (w3a (wcel X P) (wcel Y P) (wne (cfv c1 X) (cfv c1 Y))) (wa (wcel R crp) (wbr (co X c_0 D) R clt))) (wreu s1 (wa (wceq (cfv (cv s1) chash) c2) (wral y1 (wreu x3 (wa (wcel (cs2 (cv x3) (cv y1)) (co c_0 R S)) (wcel (cs2 (cv x3) (cv y1)) (co X Y L))) cr) (cv s1))) (cpw cr)) $;

--| Lemma for ~ inlinecirc02p . (Contributed by AV, 7-May-2023.) (Revised by AV, 15-May-2023.)
theorem inlinecirc02plem {a b: setvar} (A2 B2 C D P Q R S: class) (E I: class a b) (L X Y c_0: class):
  $ wceq I (co cc0 c2 cfzo) $ >
  $ wceq E (cfv I crrx) $ >
  $ wceq P (co cr I cmap) $ >
  $ wceq S (cfv E csph) $ >
  $ wceq c_0 (cxp I (csn cc0)) $ >
  $ wceq L (cfv E cline) $ >
  $ wceq Q (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) $ >
  $ wceq D (co (co (co R c2 cexp) Q cmul) (co C c2 cexp) cmin) $ >
  $ wceq A2 (co (cfv c1 X) (cfv c1 Y) cmin) $ >
  $ wceq B2 (co (cfv cc0 Y) (cfv cc0 X) cmin) $ >
  $ wceq C (co (co (cfv c1 X) (cfv cc0 Y) cmul) (co (cfv cc0 X) (cfv c1 Y) cmul) cmin) $ >
  $ wi (wa (w3a (wcel X P) (wcel Y P) (wne X Y)) (wa (wcel R crp) (wbr cc0 D clt))) (wrex a (wrex b (wa (wceq (cin (co c_0 R S) (co X Y L)) (cpr (cv a) (cv b))) (wne (cv a) (cv b))) P) P) $;

--| Intersection of a line with a circle: A line passing through a point within a circle around the origin intersects the circle at exactly two different points. (Contributed by AV, 9-May-2023.) (Revised by AV, 16-May-2023.)
theorem inlinecirc02p (D P R S E I L X Y c_0: class):
  $ wceq I (co cc0 c2 cfzo) $ >
  $ wceq E (cfv I crrx) $ >
  $ wceq P (co cr I cmap) $ >
  $ wceq S (cfv E csph) $ >
  $ wceq c_0 (cxp I (csn cc0)) $ >
  $ wceq L (cfv E cline) $ >
  $ wceq D (cfv E cds) $ >
  $ wi (wa (w3a (wcel X P) (wcel Y P) (wne X Y)) (wa (wcel R crp) (wbr (co X c_0 D) R clt))) (wcel (cin (co c_0 R S) (co X Y L)) (cfv P cprpr)) $;

--| Intersection of a line with a circle: A line passing through a point within a circle around the origin intersects the circle at exactly two different points, expressed with restricted uniqueness (and without the definition of proper pairs). (Contributed by AV, 16-May-2023.)
theorem inlinecirc02preu {p: setvar} (D: class p) (P R S: class) (E I: class p) (L X Y c_0: class):
  $ wceq I (co cc0 c2 cfzo) $ >
  $ wceq E (cfv I crrx) $ >
  $ wceq P (co cr I cmap) $ >
  $ wceq S (cfv E csph) $ >
  $ wceq c_0 (cxp I (csn cc0)) $ >
  $ wceq L (cfv E cline) $ >
  $ wceq D (cfv E cds) $ >
  $ wi (wa (w3a (wcel X P) (wcel Y P) (wne X Y)) (wa (wcel R crp) (wbr (co X c_0 D) R clt))) (wreu p (wa (wceq (cfv (cv p) chash) c2) (wceq (cv p) (cin (co c_0 R S) (co X Y L)))) (cpw P)) $;

--| Distribution of implication over biconditional with replacement (deduction form). (Contributed by Zhi Wang, 30-Aug-2024.)
theorem imbi12d2 (ph ps ch th ta: wff):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wi ps (wb th ta)) $ >
  $ wi ph (wb (wi ps th) (wi ch ta)) $;

--| Variant of ~ imbi12d2 . (Contributed by Zhi Wang, 30-Aug-2024.)
theorem imbi12d2a (ph ps ch th ta: wff):
  $ wi ph (wb ps ch) $ >
  $ wi (wa ph ps) (wb th ta) $ >
  $ wi ph (wb (wi ps th) (wi ch ta)) $;

--| Variant of ~ imbi12d2 . (Contributed by Zhi Wang, 30-Aug-2024.)
theorem imbi12d3 (ph ps ch th ta: wff):
  $ wi ph (wb ps ch) $ >
  $ wi ph (wi (wa ps ch) (wb th ta)) $ >
  $ wi ph (wb (wi ps th) (wi ch ta)) $;

--| Distribution of implication over biconditional (deduction form). Variant of ~ pm5.32da . (Contributed by Zhi Wang, 30-Aug-2024.)
theorem pm5_32rda (ph ps ch th: wff):
  $ wi (wa ph ps) (wb ch th) $ >
  $ wi ph (wb (wa ch ps) (wa th ps)) $;

--| Reverse distribution of implication over biconditional (deduction form). (Contributed by Zhi Wang, 6-Sep-2024.)
theorem pm5_32dar (ph ps ch th: wff):
  $ wi ph (wb (wa ps ch) (wa ps th)) $ >
  $ wi (wa ph ps) (wb ch th) $;

--| The import-export theorem ( ~ impexp ) for biconditionals (deduction form). (Contributed by Zhi Wang, 3-Sep-2024.)
theorem exp12bd (ph ps ch th ta et ze: wff):
  $ wi ph (wb (wi (wa ps ch) th) (wi (wa ta et) ze)) $ >
  $ wi ph (wb (wi ps (wi ch th)) (wi ta (wi et ze))) $;

--| Equivalence with a conjunction one of whose conjuncts is a consequence of the other. Deduction form. (Contributed by Zhi Wang, 24-Sep-2024.)
theorem mpbiran3d (ph ps ch th: wff):
  $ wi ph (wb ps (wa ch th)) $ >
  $ wi (wa ph ch) th $ >
  $ wi ph (wb ps ch) $;

--| Equivalence with a conjunction one of whose conjuncts is a consequence of the other. Deduction form. (Contributed by Zhi Wang, 27-Sep-2024.)
theorem mpbiran4d (ph ps ch th: wff):
  $ wi ph (wb ps (wa ch th)) $ >
  $ wi (wa ph th) ch $ >
  $ wi ph (wb ps th) $;

--| An example of how ~ ax-5 without a distinct variable condition causes paradox in models of at least two objects. The hypothesis "dtrucor3.1" is provable from ~ dtru in the ZF set theory. ~ axc16nf and ~ euae demonstrate that the violation of ~ dtru leads to a model with only one object assuming its existence ( ~ ax-6 ). The conclusion is also provable in the empty model ( see ~ emptyal ). See also ~ nf5 and ~ nf5i for the relation between unconditional ~ ax-5 and being not free. (Contributed by Zhi Wang, 23-Sep-2024.)
theorem dtrucor3 {x3 y1: setvar}:
  $ wn (wal x3 (wceq (cv x3) (cv y1))) $ >
  $ wi (wceq (cv x3) (cv y1)) (wal x3 (wceq (cv x3) (cv y1))) $ >
  $ wal x3 (wceq (cv x3) (cv y1)) $;

--| Formula-building rule for restricted universal quantifier and additional condition (deduction form). See ~ ralbidc for a more generalized form. (Contributed by Zhi Wang, 6-Sep-2024.)
theorem ralbidb {x3: setvar} (ph: wff) (ps ch th: wff x3) (A2 B2: class x3):
  $ wi ph (wb (wcel (cv x3) A2) (wa (wcel (cv x3) B2) ps)) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wb ch th) $ >
  $ wi ph (wb (wral x3 ch A2) (wral x3 (wi ps th) B2)) $;

--| Formula-building rule for restricted universal quantifier and additional condition (deduction form). A variant of ~ ralbidb . (Contributed by Zhi Wang, 30-Aug-2024.)
theorem ralbidc {x3: setvar} (ph: wff) (ps ch th: wff x3) (A2 B2: class x3):
  $ wi ph (wb (wcel (cv x3) A2) (wa (wcel (cv x3) B2) ps)) $ >
  $ wi ph (wi (wa (wcel (cv x3) A2) (wa (wcel (cv x3) B2) ps)) (wb ch th)) $ >
  $ wi ph (wb (wral x3 ch A2) (wral x3 (wi ps th) B2)) $;

--| A complex deduction form of ~ r19.41v . (Contributed by Zhi Wang, 6-Sep-2024.)
theorem r19_41dv {x3: setvar} (ph ps: wff x3) (ch: wff) (A2: class x3):
  $ wi ph (wrex x3 ps A2) $ >
  $ wi (wa ph ch) (wrex x3 (wa ps ch) A2) $;

--| Two ways of expressing "at most one" element. (Contributed by Zhi Wang, 19-Sep-2024.) (Proof shortened by BJ, 23-Sep-2024.)
theorem rmotru {x3: setvar} (A2: class x3):
  $ wb (wmo x3 (wcel (cv x3) A2)) (wrmo x3 wtru A2) $;

--| Two ways of expressing "exactly one" element. (Contributed by Zhi Wang, 23-Sep-2024.)
theorem reutru {x3: setvar} (A2: class x3):
  $ wb (weu x3 (wcel (cv x3) A2)) (wreu x3 wtru A2) $;

--| Alternate proof of ~ reutru . (Contributed by Zhi Wang, 23-Sep-2024.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem reutruALT {x3: setvar} (A2: class x3):
  $ wb (weu x3 (wcel (cv x3) A2)) (wreu x3 wtru A2) $;

--| Formula-building rule for restricted existential uniqueness quantifier. Deduction form. General version of ~ reueqbidv . (Contributed by Zhi Wang, 20-Nov-2025.)
theorem reueqbidva {x3: setvar} (ph: wff) (ps ch: wff x3) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wreu x3 ps A2) (wreu x3 ch B2)) $;

--| Transfer existential uniqueness from a variable ` x ` to another variable ` y ` contained in expression ` A ` . Simplifies ~ reuxfr1d . (Contributed by Zhi Wang, 20-Sep-2025.)
theorem reuxfr1dd {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (A2: class y1) (B2 C: class):
  $ wi (wa ph (wcel (cv y1) C)) (wcel A2 B2) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wreu y1 (wceq (cv x3) A2) C) $ >
  $ wi (wa ph (wa (wcel (cv y1) C) (wceq (cv x3) A2))) (wb ps ch) $ >
  $ wi ph (wb (wreu x3 ps B2) (wreu y1 ch C)) $;

--| Subset preserves disjointness. Deduction form of ~ ssdisj . (Contributed by Zhi Wang, 7-Sep-2024.)
theorem ssdisjd (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wceq (cin B2 C) c0) $ >
  $ wi ph (wceq (cin A2 C) c0) $;

--| Subset preserves disjointness. Deduction form of ~ ssdisj . Alternatively this could be proved with ~ ineqcom in tandem with ~ ssdisjd . (Contributed by Zhi Wang, 7-Sep-2024.)
theorem ssdisjdr (ph: wff) (A2 B2 C: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wceq (cin C B2) c0) $ >
  $ wi ph (wceq (cin C A2) c0) $;

--| Relative complement is anticommutative regarding intersection. (Contributed by Zhi Wang, 5-Sep-2024.)
theorem disjdifb (A2 B2: class):
  $ wceq (cin (cdif A2 B2) (cdif B2 A2)) c0 $;

--| Preimages of disjoint sets are disjoint. (Contributed by Zhi Wang, 9-Sep-2024.)
theorem predisj (ph: wff) (A2 B2 S T F: class):
  $ wi ph (wfun F) $ >
  $ wi ph (wceq (cin A2 B2) c0) $ >
  $ wi ph (wss S (cima (ccnv F) A2)) $ >
  $ wi ph (wss T (cima (ccnv F) B2)) $ >
  $ wi ph (wceq (cin S T) c0) $;

--| Membership in a conditional class with an empty set in the false-branch is equivalent to the condition and membership in the first class. (Contributed by Zhi Wang, 14-Sep-2026.)
theorem elif0 (ph: wff) (A2 B2: class):
  $ wb (wcel A2 (cif ph B2 c0)) (wa ph (wcel A2 B2)) $;

--| The singleton of the universal class is the empty set. (Contributed by Zhi Wang, 19-Sep-2024.)
theorem vsn:
  $ wceq (csn cvv) c0 $;

--| "At most one" element in a singleton. (Contributed by Zhi Wang, 19-Sep-2024.)
theorem mosn {x3: setvar} (A2 B2: class):
  $ wi (wceq A2 (csn B2)) (wmo x3 (wcel (cv x3) A2)) $;

--| "At most one" element in an empty set. (Contributed by Zhi Wang, 19-Sep-2024.)
theorem mo0 {x3: setvar} (A2: class):
  $ wi (wceq A2 c0) (wmo x3 (wcel (cv x3) A2)) $;

--| "At most one" element in a subclass of a singleton. (Contributed by Zhi Wang, 23-Sep-2024.)
theorem mosssn {x3: setvar} (A2 B2: class):
  $ wi (wss A2 (csn B2)) (wmo x3 (wcel (cv x3) A2)) $;

--| Two ways of expressing "at most one" element in a class. (Contributed by Zhi Wang, 19-Sep-2024.)
theorem mo0sn {x3 y1: setvar} (A2: class):
  $ wb (wmo x3 (wcel (cv x3) A2)) (wo (wceq A2 c0) (wex y1 (wceq A2 (csn (cv y1))))) $;

--| Two ways of expressing "at most one" element in a class. (Contributed by Zhi Wang, 19-Sep-2024.)
theorem mo0sn_b {x3: setvar} (A2: class):
  $ wb (wmo x3 (wcel (cv x3) A2)) (wo (wceq A2 c0) (wex x3 (wceq A2 (csn (cv x3))))) $;

--| Two ways of expressing "at most one" element in a class. (Contributed by Zhi Wang, 23-Sep-2024.)
theorem mosssn2 {x3 y1: setvar} (A2: class):
  $ wb (wmo x3 (wcel (cv x3) A2)) (wex y1 (wss A2 (csn (cv y1)))) $;

--| Two ways of expressing "at most one" element in a class. (Contributed by Zhi Wang, 23-Sep-2024.)
theorem mosssn2_b {x3: setvar} (A2: class):
  $ wb (wmo x3 (wcel (cv x3) A2)) (wex x3 (wss A2 (csn (cv x3)))) $;

--| Superclass of the greatest lower bound. A dual statement of ~ ssintub . (Contributed by Zhi Wang, 29-Sep-2024.)
theorem unilbss {x3: setvar} (A2 B2: class):
  $ wss (cuni (crab x3 (wss (cv x3) A2) B2)) A2 $;

--| An indexed union is empty iff all indexed classes are empty. (Contributed by Zhi Wang, 1-Nov-2025.)
theorem iuneq0 {x3: setvar} (A2 B2: class x3):
  $ wb (wral x3 (wceq B2 c0) A2) (wceq (ciun x3 A2 B2) c0) $;

--| An indexed intersection is empty if one of the intersected classes is empty. (Contributed by Zhi Wang, 30-Oct-2025.)
theorem iineq0 {x3: setvar} (A2 B2: class x3):
  $ wi (wrex x3 (wceq B2 c0) A2) (wceq (ciin x3 A2 B2) c0) $;

--| The indexed union is the the lowest upper bound if it exists. (Contributed by Zhi Wang, 1-Nov-2025.)
theorem iunlub {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (C X: class):
  $ wi ph (wcel X A2) $ >
  $ wi (wa ph (wceq (cv x3) X)) (wceq B2 C) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wss B2 C) $ >
  $ wi ph (wceq (ciun x3 A2 B2) C) $;

--| The indexed intersection is the the greatest lower bound if it exists. (Contributed by Zhi Wang, 1-Nov-2025.)
theorem iinglb {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (C X: class):
  $ wi ph (wcel X A2) $ >
  $ wi (wa ph (wceq (cv x3) X)) (wceq B2 C) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wss C B2) $ >
  $ wi ph (wceq (ciin x3 A2 B2) C) $;

--| Indexed union of identical classes. (Contributed by Zhi Wang, 6-Nov-2025.)
theorem iuneqconst2 {x3: setvar} (A2: class) (B2: class x3) (C: class):
  $ wi (wa (wne A2 c0) (wral x3 (wceq B2 C) A2)) (wceq (ciun x3 A2 B2) C) $;

--| Indexed intersection of identical classes. (Contributed by Zhi Wang, 6-Nov-2025.)
theorem iineqconst2 {x3: setvar} (A2: class) (B2: class x3) (C: class):
  $ wi (wa (wne A2 c0) (wral x3 (wceq B2 C) A2)) (wceq (ciin x3 A2 B2) C) $;

--| Two ways of expressing a collection of subsets as seen in ~ df-ntr , ~ unimax , and others. (Contributed by Zhi Wang, 27-Sep-2024.)
theorem inpw {x3: setvar} (A2 B2 V: class):
  $ wi (wcel B2 V) (wceq (cin A2 (cpw B2)) (crab x3 (wss (cv x3) B2) A2)) $;

--| Two ordered pairs are not equal if their first components are not equal. (Contributed by Zhi Wang, 7-Oct-2025.)
theorem opth1neg (A2 B2 C D V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wi (wne A2 C) (wne (cop A2 B2) (cop C D))) $;

--| Two ordered pairs are not equal if their second components are not equal. (Contributed by Zhi Wang, 7-Oct-2025.)
theorem opth2neg (A2 B2 C D V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wi (wne B2 D) (wne (cop A2 B2) (cop C D))) $;

--| Expressing that two sets are related by a binary relation which is expressed as a class abstraction of ordered pairs. (Contributed by Zhi Wang, 24-Sep-2025.)
theorem brab2dd {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (ch: wff) (A2 B2: class) (C D R: class x3 y1) (U V: class):
  $ wi ph (wceq R (copab x3 y1 (wa (wa (wcel (cv x3) C) (wcel (cv y1) D)) ps))) $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wb ps ch) $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wb (wa (wcel (cv x3) C) (wcel (cv y1) D)) (wa (wcel A2 U) (wcel B2 V))) $ >
  $ wi ph (wb (wbr A2 B2 R) (wa (wa (wcel A2 U) (wcel B2 V)) ch)) $;

--| Expressing that two sets are related by a binary relation which is expressed as a class abstraction of ordered pairs. (Contributed by Zhi Wang, 24-Sep-2025.)
theorem brab2ddw {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (ch: wff) (th: wff x3 y1) (A2 B2: class) (C D R: class x3 y1) (U V: class):
  $ wi ph (wceq R (copab x3 y1 (wa (wa (wcel (cv x3) C) (wcel (cv y1) D)) ps))) $ >
  $ wi (wceq (cv x3) A2) (wb ps th) $ >
  $ wi (wceq (cv y1) B2) (wb th ch) $ >
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wceq C U) $ >
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wceq D V) $ >
  $ wi ph (wb (wbr A2 B2 R) (wa (wa (wcel A2 U) (wcel B2 V)) ch)) $;

--| Expressing that two sets are related by a binary relation which is expressed as a class abstraction of ordered pairs. (Contributed by Zhi Wang, 24-Sep-2025.)
theorem brab2ddw2 {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (ch: wff) (th: wff x3 y1) (A2 B2: class) (C D R: class x3 y1) (U V: class):
  $ wi ph (wceq R (copab x3 y1 (wa (wa (wcel (cv x3) C) (wcel (cv y1) D)) ps))) $ >
  $ wi (wceq (cv x3) A2) (wb ps th) $ >
  $ wi (wceq (cv y1) B2) (wb th ch) $ >
  $ wi (wceq (cv x3) A2) (wceq C U) $ >
  $ wi (wceq (cv y1) B2) (wceq D V) $ >
  $ wi ph (wb (wbr A2 B2 R) (wa (wa (wcel A2 U) (wcel B2 V)) ch)) $;

--| Indexed intersection of Cartesian products is the Cartesian product of indexed intersections. See also ~ inxp and ~ intxpd . (Contributed by Zhi Wang, 30-Oct-2025.)
theorem iinxp {x3: setvar} (A2: class) (B2 C: class x3):
  $ wi (wne A2 c0) (wceq (ciin x3 A2 (cxp B2 C)) (cxp (ciin x3 A2 B2) (ciin x3 A2 C))) $;

--| Intersection of Cartesian products is the Cartesian product of intersection of domains and ranges. See also ~ inxp and ~ iinxp . (Contributed by Zhi Wang, 30-Oct-2025.)
theorem intxpd {x3: setvar} (ph: wff) (A2: class) (X Y: class x3):
  $ wi ph (wne A2 c0) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wceq (cv x3) (cxp (cdm (cv x3)) (crn (cv x3)))) $ >
  $ wceq X (ciin x3 A2 (cdm (cv x3))) $ >
  $ wceq Y (ciin x3 A2 (crn (cv x3))) $ >
  $ wi ph (wceq (cint A2) (cxp X Y)) $;

--| Composition with a Cartesian product. (Contributed by Zhi Wang, 6-Oct-2025.)
theorem coxp (A2 B2 C: class):
  $ wceq (ccom A2 (cxp B2 C)) (cxp B2 (cima A2 C)) $;

--| Composition with an ordered pair singleton. (Contributed by Zhi Wang, 6-Oct-2025.)
theorem cosn (A2 B2 C U V: class):
  $ wi (wa (wcel B2 U) (wcel C V)) (wceq (ccom A2 (csn (cop B2 C))) (cxp (csn B2) (cima A2 (csn C)))) $;

--| Composition with an ordered pair singleton. (Contributed by Zhi Wang, 6-Oct-2025.)
theorem cosni (A2 B2 C: class):
  $ wcel B2 cvv $ >
  $ wcel C cvv $ >
  $ wceq (ccom A2 (csn (cop B2 C))) (cxp (csn B2) (cima A2 (csn C))) $;

--| The inverse image of a singleton subset of an image is non-empty. (Contributed by Zhi Wang, 7-Nov-2025.)
theorem inisegn0a (A2 B2 F: class):
  $ wi (wcel A2 (cima F B2)) (wne (cima (ccnv F) (csn A2)) c0) $;

--| A Cartesian product is the Cartesian product of its domain and range. (Contributed by Zhi Wang, 30-Oct-2025.)
theorem dmrnxp (A2 B2 R: class):
  $ wi (wceq R (cxp A2 B2)) (wceq R (cxp (cdm R) (crn R))) $;

--| There is at most one function into the empty set. (Contributed by Zhi Wang, 19-Sep-2024.)
theorem mof0 {f2: setvar} (A2: class f2):
  $ wmo f2 (wf A2 c0 (cv f2)) $;

--| A variant of ~ mof0 . (Contributed by Zhi Wang, 20-Sep-2024.)
theorem mof02 {f2: setvar} (A2: class f2) (B2: class):
  $ wi (wceq B2 c0) (wmo f2 (wf A2 B2 (cv f2))) $;

--| Alternate proof of ~ mof0 with stronger requirements on distinct variables. Uses ~ mo4 . (Contributed by Zhi Wang, 19-Sep-2024.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem mof0ALT {f2: setvar} (A2: class):
  $ wmo f2 (wf A2 c0 (cv f2)) $;

--| There is exactly one function into a singleton. For a simpler hypothesis, see ~ eufsn assuming ~ ax-rep , or ~ eufsn2 assuming ~ ax-pow and ~ ax-un . (Contributed by Zhi Wang, 19-Sep-2024.)
theorem eufsnlem {f2: setvar} (ph: wff) (A2 B2: class) (V W: class f2):
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel (cxp A2 (csn B2)) V) $ >
  $ wi ph (weu f2 (wf A2 (csn B2) (cv f2))) $;

--| There is exactly one function into a singleton, assuming ~ ax-rep . See ~ eufsn2 for different axiom requirements. If existence is not needed, use ~ mofsn or ~ mofsn2 for fewer axiom assumptions. (Contributed by Zhi Wang, 19-Sep-2024.)
theorem eufsn {f2: setvar} (ph: wff) (A2 B2: class) (V W: class f2):
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (weu f2 (wf A2 (csn B2) (cv f2))) $;

--| There is exactly one function into a singleton, assuming ~ ax-pow and ~ ax-un . Variant of ~ eufsn . If existence is not needed, use ~ mofsn or ~ mofsn2 for fewer axiom assumptions. (Contributed by Zhi Wang, 19-Sep-2024.)
theorem eufsn2 {f2: setvar} (ph: wff) (A2 B2: class) (V W: class f2):
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (weu f2 (wf A2 (csn B2) (cv f2))) $;

--| There is at most one function into a singleton, with fewer axioms than ~ eufsn and ~ eufsn2 . See also ~ mofsn2 . (Contributed by Zhi Wang, 19-Sep-2024.)
theorem mofsn {f2: setvar} (A2 B2 V: class):
  $ wi (wcel B2 V) (wmo f2 (wf A2 (csn B2) (cv f2))) $;

--| There is at most one function into a singleton. An unconditional variant of ~ mofsn , i.e., the singleton could be empty if ` Y ` is a proper class. (Contributed by Zhi Wang, 19-Sep-2024.)
theorem mofsn2 {f2: setvar} (A2 B2 Y: class):
  $ wi (wceq B2 (csn Y)) (wmo f2 (wf A2 B2 (cv f2))) $;

--| There is at most one function into a subclass of a singleton. (Contributed by Zhi Wang, 24-Sep-2024.)
theorem mofsssn {f2: setvar} (A2 B2 Y: class):
  $ wi (wss B2 (csn Y)) (wmo f2 (wf A2 B2 (cv f2))) $;

--| There is at most one function into a class containing at most one element. (Contributed by Zhi Wang, 19-Sep-2024.)
theorem mofmo {x3 f2: setvar} (A2: class x3) (B2: class):
  $ wi (wmo x3 (wcel (cv x3) B2)) (wmo f2 (wf A2 B2 (cv f2))) $;

--| The uniqueness of a function into a set with at most one element. (Contributed by Zhi Wang, 1-Oct-2024.)
theorem mofeu {x3: setvar} (ph: wff x3) (A2: class x3) (B2: class) (F G: class x3):
  $ wceq G (cxp A2 B2) $ >
  $ wi ph (wi (wceq B2 c0) (wceq A2 c0)) $ >
  $ wi ph (wmo x3 (wcel (cv x3) B2)) $ >
  $ wi ph (wb (wf A2 B2 F) (wceq F G)) $;

--| If a function value has a member, then the function is not an empty set (An artifact of our function value definition.) (Contributed by Zhi Wang, 16-Sep-2024.)
theorem elfvne0 (A2 B2 F: class):
  $ wi (wcel A2 (cfv B2 F)) (wne F c0) $;

--| A function with non-empty domain is non-empty and has non-empty codomain. (Contributed by Zhi Wang, 1-Oct-2024.)
theorem fdomne0 (F X Y: class):
  $ wi (wa (wf X Y F) (wne X c0)) (wa (wne F c0) (wne Y c0)) $;

--| A function that maps a singleton to a class is injective. (Contributed by Zhi Wang, 1-Oct-2024.)
theorem f1sn2g (A2 B2 F V: class):
  $ wi (wa (wcel A2 V) (wf (csn A2) B2 F)) (wf1 (csn A2) B2 F) $;

--| A function that maps the empty set to a class is injective. (Contributed by Zhi Wang, 1-Oct-2024.)
theorem f102g (A2 B2 F: class):
  $ wi (wa (wceq A2 c0) (wf A2 B2 F)) (wf1 A2 B2 F) $;

--| A function that maps a set with at most one element to a class is injective. (Contributed by Zhi Wang, 1-Oct-2024.)
theorem f1mo {x3: setvar} (A2: class) (B2 F: class x3):
  $ wi (wa (wmo x3 (wcel (cv x3) A2)) (wf A2 B2 F)) (wf1 A2 B2 F) $;

--| A function with an empty codomain must have empty domain. (Contributed by Zhi Wang, 1-Oct-2024.)
theorem f002 (ph: wff) (A2 B2 F: class):
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wi (wceq B2 c0) (wceq A2 c0)) $;

--| A function exists iff an empty codomain is accompanied with an empty domain. (Contributed by Zhi Wang, 1-Oct-2024.)
theorem map0cor {f2: setvar} (ph: wff f2) (A2 B2 V W: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wb (wi (wceq B2 c0) (wceq A2 c0)) (wex f2 (wf A2 B2 (cv f2)))) $;

--| Relation with function value. (Contributed by Zhi Wang, 25-Nov-2025.)
theorem ffvbr (A2 B2 F X: class):
  $ wi (wa (wf A2 B2 F) (wcel X A2)) (wbr X (cfv X F) F) $;

--| Composition of a Cartesian product with a function. (Contributed by Zhi Wang, 25-Nov-2025.)
theorem xpco2 (A2 B2 C F: class):
  $ wi (wf A2 B2 F) (wceq (ccom (cxp B2 C) F) (cxp A2 C)) $;

--| The operation value of a singleton of a nested ordered pair is the last member. (Contributed by Zhi Wang, 22-Oct-2025.)
theorem ovsng (A2 B2 C V: class):
  $ wi (wcel C V) (wceq (co A2 B2 (csn (cop (cop A2 B2) C))) C) $;

--| The operation value of a singleton of an ordered triple is the last member. (Contributed by Zhi Wang, 22-Oct-2025.)
theorem ovsng2 (A2 B2 C V: class):
  $ wi (wcel C V) (wceq (co A2 B2 (csn (cotp A2 B2 C))) C) $;

--| The operation value of a singleton of a nested ordered pair is the last member. (Contributed by Zhi Wang, 22-Oct-2025.)
theorem ovsn (A2 B2 C: class):
  $ wcel C cvv $ >
  $ wceq (co A2 B2 (csn (cop (cop A2 B2) C))) C $;

--| The operation value of a singleton of an ordered triple is the last member. (Contributed by Zhi Wang, 22-Oct-2025.)
theorem ovsn2 (A2 B2 C: class):
  $ wcel C cvv $ >
  $ wceq (co A2 B2 (csn (cotp A2 B2 C))) C $;

--| Two ways of expressing ` A R B ` . (Contributed by Zhi Wang, 18-Sep-2024.)
theorem ovconstbrd (ph: wff) (A2 B2 R F V Y: class):
  $ wi ph (wceq F (cxp R (csn Y))) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wne Y c0) $ >
  $ wi ph (wb (wbr A2 B2 R) (wceq (co A2 B2 F) Y)) $;

--| Two ways of expressing ` A R B ` . (Contributed by Zhi Wang, 20-Sep-2024.)
theorem ovconstbrn0d (ph: wff) (A2 B2 R F V Y: class):
  $ wi ph (wceq F (cxp R (csn Y))) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wne Y c0) $ >
  $ wi ph (wb (wbr A2 B2 R) (wne (co A2 B2 F) c0)) $;

--| Two ways of expressing ` A R B ` . (Contributed by Zhi Wang, 18-Sep-2024.)
theorem elovconstbrd (ph: wff) (A2 B2 R F X Y: class):
  $ wi ph (wceq F (cxp R (csn Y))) $ >
  $ wi ph (wcel X (co A2 B2 F)) $ >
  $ wi ph (wbr A2 B2 R) $;

--| Deduction version of ~ ovmpt4g . (This is the operation analogue of ~ fvmpt2d .) (Contributed by Zhi Wang, 9-Oct-2025.)
theorem ovmpt4d {x3 y1: setvar} (ph: wff x3 y1) (A2 B2 C F V: class x3 y1):
  $ wi ph (wceq F (cmpo x3 y1 A2 B2 C)) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) B2))) (wcel C V) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) F) C) $;

--| Deduction for equality of operations. (Contributed by Zhi Wang, 19-Nov-2025.)
theorem eqfnovd {x3 y1: setvar} (ph: wff) (A2 B2 F G: class):
  $ wi ph (wfn F (cxp A2 B2)) $ >
  $ wi ph (wfn G (cxp A2 B2)) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) F) (co (cv x3) (cv y1) G)) $ >
  $ wi ph (wceq F G) $;

--| The domain of a surjection is a proper class if the range is a proper class as well. Can be used to prove that if a structure component extractor restricted to a class maps onto a proper class, then the class is a proper class as well. (Contributed by Zhi Wang, 20-Oct-2025.)
theorem fonex (A2 B2 F: class):
  $ wnel B2 cvv $ >
  $ wfo A2 B2 F $ >
  $ wnel A2 cvv $;

--| Reconstruction of a nested ordered pair in terms of its ordered pair components. (Contributed by Zhi Wang, 27-Oct-2025.)
theorem eloprab1st2nd {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2: class):
  $ wi (wcel A2 (coprab x3 y1 z ph)) (wceq A2 (cop (cop (cfv (cfv A2 c1st) c1st) (cfv (cfv A2 c1st) c2nd)) (cfv A2 c2nd))) $;

--| If a value of an operation given by maps-to notation has a member, it equals the substituted body. (Contributed by Zhi Wang, 17-Sep-2026.)
theorem elovmpoeq {x3 y1: setvar} (A2 B2: class) (C: class x3 y1) (D F: class) (N: class x3 y1) (X Y: class):
  $ wceq F (cmpo x3 y1 A2 B2 C) $ >
  $ wi (wa (wceq (cv x3) X) (wceq (cv y1) Y)) (wceq C D) $ >
  $ wi (wcel N (co X Y F)) (wceq (co X Y F) D) $;

--| Characterization of the outer domain of a chained maps-to expression. (Contributed by Zhi Wang, 14-Sep-2026.)
theorem fnmpompt {v u a: setvar} (A2: class a) (B2: class) (H: class v u) (L: class v u a):
  $ wceq L (cmpo u v B2 B2 (cmpt a (co (cv u) (cv v) H) (cfv (cv a) A2))) $ >
  $ wfn L (cxp B2 B2) $;

--| The outer value of an iterated maps-to function is the corresponding inner maps-to function. (Contributed by Zhi Wang, 14-Sep-2026.)
theorem ovmpomptd {v u a: setvar} (ph: wff) (A2: class a) (B2 U H: class) (L: class v u a) (V: class):
  $ wceq L (cmpo u v B2 B2 (cmpt a (co (cv u) (cv v) H) (cfv (cv a) A2))) $ >
  $ wi ph (wcel U B2) $ >
  $ wi ph (wcel V B2) $ >
  $ wi ph (wceq (co U V L) (cmpt a (co U V H) (cfv (cv a) A2))) $;

--| At an element of its inner domain, an iterated maps-to function has the value of its body. The operation ` H ` is arbitrary; evaluation on a morphism in a hom-set is one application. (Contributed by Zhi Wang, 14-Sep-2026.)
theorem fvmpomptd {v u a: setvar} (ph: wff) (A2 B2 U F H: class) (L: class v u a) (V: class):
  $ wceq L (cmpo u v B2 B2 (cmpt a (co (cv u) (cv v) H) (cfv (cv a) A2))) $ >
  $ wi ph (wcel U B2) $ >
  $ wi ph (wcel V B2) $ >
  $ wi ph (wcel F (co U V H)) $ >
  $ wi ph (wceq (cfv F (co U V L)) (cfv F A2)) $;

--| Lemma for ~ resinsnALT . (Contributed by Zhi Wang, 6-Oct-2025.)
theorem resinsnlem (ph ps ch: wff):
  $ wi ph (wb ch (wn ps)) $ >
  $ wi (wn ph) ch $ >
  $ wb (wa ph ps) (wn ch) $;

--| Restriction to the intersection with a singleton. (Contributed by Zhi Wang, 6-Oct-2025.)
theorem resinsn (A2 B2 F: class):
  $ wb (wceq (cres F (cin A2 (csn B2))) c0) (wn (wcel B2 (cin (cdm F) A2))) $;

--| Restriction to the intersection with a singleton. (Contributed by Zhi Wang, 6-Oct-2025.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem resinsnALT (A2 B2 F: class):
  $ wb (wceq (cres F (cin A2 (csn B2))) c0) (wn (wcel B2 (cin (cdm F) A2))) $;

--| Alternate definition of ` tpos ` . (Contributed by Zhi Wang, 6-Oct-2025.)
theorem dftpos5 {x3: setvar} (F: class):
  $ wceq (ctpos F) (ccom F (cun (cmpt x3 (ccnv (cdm F)) (cuni (ccnv (csn (cv x3))))) (csn (cop c0 c0)))) $;

--| Alternate definition of ` tpos ` . The second half of the right hand side could apply ~ ressn and become ` ( F |`` { (/) } ) ` . (Contributed by Zhi Wang, 6-Oct-2025.)
theorem dftpos6 {x3: setvar} (F: class):
  $ wceq (ctpos F) (cun (ccom F (cmpt x3 (ccnv (cdm F)) (cuni (ccnv (csn (cv x3)))))) (cxp (csn c0) (cima F (csn c0)))) $;

--| The domain of ` tpos F ` is a subset. (Contributed by Zhi Wang, 6-Oct-2025.)
theorem dmtposss (F: class):
  $ wss (cdm (ctpos F)) (cun (cxp cvv cvv) (csn c0)) $;

--| The transposition of a set restricted to the empty set is the set restricted to the empty set. See also ~ ressn and ~ dftpos6 for an alternate proof. (Contributed by Zhi Wang, 6-Oct-2025.)
theorem tposres0 (F: class):
  $ wceq (cres (ctpos F) (csn c0)) (cres F (csn c0)) $;

--| The transposition restricted to a set. (Contributed by Zhi Wang, 6-Oct-2025.)
theorem tposresg (R F: class):
  $ wceq (cres (ctpos F) R) (cun (cres (ctpos F) (ccnv (ccnv R))) (cres F (cin R (csn c0)))) $;

--| The transposition restricted to a converse is the transposition of the restricted class, with the empty set removed from the domain. Note that the right hand side is a more useful form of ` ( tpos ( F |`` R ) |`` ( _V \ { (/) } ) ) ` by ~ df-tpos . (Contributed by Zhi Wang, 6-Oct-2025.)
theorem tposrescnv {x3: setvar} (R F: class):
  $ wceq (cres (ctpos F) (ccnv R)) (ccom F (cmpt x3 (ccnv (cdm (cres F R))) (cuni (ccnv (csn (cv x3)))))) $;

--| The transposition restricted to a set. (Contributed by Zhi Wang, 6-Oct-2025.)
theorem tposres2 (ph: wff) (R F: class):
  $ wi ph (wn (wcel c0 (cin (cdm F) R))) $ >
  $ wi ph (wceq (cres (ctpos F) R) (cres (ctpos F) (ccnv (ccnv R)))) $;

--| The transposition restricted to a set. (Contributed by Zhi Wang, 6-Oct-2025.)
theorem tposres3 (ph: wff) (R F: class):
  $ wi ph (wn (wcel c0 (cin (cdm F) R))) $ >
  $ wi ph (wceq (cres (ctpos F) R) (ctpos (cres F (ccnv R)))) $;

--| The transposition restricted to a relation. (Contributed by Zhi Wang, 6-Oct-2025.)
theorem tposres (R F: class):
  $ wi (wrel R) (wceq (cres (ctpos F) R) (ctpos (cres F (ccnv R)))) $;

--| The transposition restricted to a Cartesian product. (Contributed by Zhi Wang, 6-Oct-2025.)
theorem tposresxp (A2 B2 F: class):
  $ wceq (cres (ctpos F) (cxp A2 B2)) (ctpos (cres F (cxp B2 A2))) $;

--| Condition of a bijective transposition. (Contributed by Zhi Wang, 5-Oct-2025.)
theorem tposf1o (A2 B2 C F: class):
  $ wi (wf1o (cxp A2 B2) C F) (wf1o (cxp B2 A2) C (ctpos F)) $;

--| Swap an ordered pair. (Contributed by Zhi Wang, 5-Oct-2025.)
theorem tposid (X Y: class):
  $ wceq (co X Y (ctpos cid)) (cop Y X) $;

--| Swap an ordered pair. (Contributed by Zhi Wang, 5-Oct-2025.)
theorem tposidres (ph: wff) (A2 B2 X Y: class):
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (co Y X (ctpos (cres cid (cxp A2 B2)))) (cop X Y)) $;

--| The swap function, or the twisting map, is bijective. (Contributed by Zhi Wang, 5-Oct-2025.)
theorem tposidf1o (A2 B2: class):
  $ wf1o (cxp B2 A2) (cxp A2 B2) (ctpos (cres cid (cxp A2 B2))) $;

--| Two ways of expressing the swap function. (Contributed by Zhi Wang, 6-Oct-2025.)
theorem tposideq {x3: setvar} (R: class):
  $ wi (wrel R) (wceq (cres (ctpos cid) R) (cmpt x3 R (cuni (ccnv (csn (cv x3)))))) $;

--| Two ways of expressing the swap function. (Contributed by Zhi Wang, 6-Oct-2025.)
theorem tposideq2 {x3: setvar} (A2 B2: class x3) (R: class):
  $ wceq R (cxp A2 B2) $ >
  $ wceq (cres (ctpos cid) R) (cmpt x3 R (cuni (ccnv (csn (cv x3))))) $;

--| Infinite Cartesian product of the universal class is the set of functions with a fixed domain. (Contributed by Zhi Wang, 1-Nov-2025.)
theorem ixpv {x3 f2: setvar} (A2: class):
  $ wceq (cixp x3 A2 cvv) (cab f2 (wfn (cv f2) A2)) $;

--| Membership in an indexed Cartesian product over a set is equivalent to being its exact function graph with components of the indicated types. (Contributed by Zhi Wang, 14-Sep-2026.)
theorem elixpmpt {x3: setvar} (A2: class) (B2: class x3) (F: class):
  $ wcel A2 cvv $ >
  $ wb (wcel F (cixp x3 A2 B2)) (wa (wceq F (cmpt x3 A2 (cfv (cv x3) F))) (wral x3 (wcel (cfv (cv x3) F) B2) A2)) $;

--| A constant function's value is either the constant or the empty set. (An artifact of our function value definition.) (Contributed by Zhi Wang, 18-Sep-2024.)
theorem fvconst0ci (A2 B2 X Y: class):
  $ wcel B2 cvv $ >
  $ wceq Y (cfv X (cxp A2 (csn B2))) $ >
  $ wo (wceq Y c0) (wceq Y B2) $;

--| A constant function's value is dominated by the constant. (An artifact of our function value definition.) (Contributed by Zhi Wang, 18-Sep-2024.)
theorem fvconstdomi (A2 B2 X: class):
  $ wcel B2 cvv $ >
  $ wbr (cfv X (cxp A2 (csn B2))) B2 cdom $;

--| There is at most one element in the function value of a constant function whose output is ` 1o ` . (An artifact of our function value definition.) Proof could be significantly shortened by ~ fvconstdomi assuming ~ ax-un (see ~ f1omoALT ). (Contributed by Zhi Wang, 19-Sep-2024.) (Proof shortened by SN, 24-Nov-2025.)
theorem f1omo {y1: setvar} (ph: wff) (A2 F X: class):
  $ wi ph (wceq F (cxp A2 (csn c1o))) $ >
  $ wi ph (wmo y1 (wcel (cv y1) (cfv X F))) $;

--| Obsolete version of ~ f1omo as of 24-Nov-2025. (Contributed by Zhi Wang, 19-Sep-2024.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem f1omoOLD {y1: setvar} (ph: wff) (A2 F X: class):
  $ wi ph (wceq F (cxp A2 (csn c1o))) $ >
  $ wi ph (wmo y1 (wcel (cv y1) (cfv X F))) $;

--| There is at most one element in the function value of a constant function whose output is ` 1o ` . (An artifact of our function value definition.) Use ~ f1omo without assuming ~ ax-un . (Contributed by Zhi Wang, 18-Sep-2024.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem f1omoALT {y1: setvar} (ph: wff y1) (A2: class y1) (F X: class):
  $ wi ph (wceq F (cxp A2 (csn c1o))) $ >
  $ wi ph (wmo y1 (wcel (cv y1) (cfv X F))) $;

--| Intersection of two closed intervals of extended reals. (Contributed by Zhi Wang, 9-Sep-2024.)
theorem iccin (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cxr) (wcel B2 cxr)) (wa (wcel C cxr) (wcel D cxr))) (wceq (cin (co A2 B2 cicc) (co C D cicc)) (co (cif (wbr A2 C cle) C A2) (cif (wbr B2 D cle) B2 D) cicc)) $;

--| If the upper bound of one closed interval is less than the lower bound of the other, the intervals are disjoint. (Contributed by Zhi Wang, 9-Sep-2024.)
theorem iccdisj2 (A2 B2 C D: class):
  $ wi (w3a (wcel A2 cxr) (wcel D cxr) (wbr B2 C clt)) (wceq (cin (co A2 B2 cicc) (co C D cicc)) c0) $;

--| If the upper bound of one closed interval is less than the lower bound of the other, the intervals are disjoint. (Contributed by Zhi Wang, 9-Sep-2024.)
theorem iccdisj (A2 B2 C D: class):
  $ wi (wa (wa (wa (wcel A2 cxr) (wcel B2 cxr)) (wa (wcel C cxr) (wcel D cxr))) (wbr B2 C clt)) (wceq (cin (co A2 B2 cicc) (co C D cicc)) c0) $;

--| The condition of a structure component extractor restricted to a class being a surjection. This combined with ~ fonex can be used to prove a class being proper. (Contributed by Zhi Wang, 20-Oct-2025.)
theorem slotresfo {k b: setvar} (A2 E: class) (K: class b) (V: class):
  $ wfn E cvv $ >
  $ wi (wcel (cv k) A2) (wcel (cfv (cv k) E) V) $ >
  $ wi (wcel (cv b) V) (wcel K A2) $ >
  $ wi (wcel (cv b) V) (wceq (cv b) (cfv K E)) $ >
  $ wfo A2 V (cres E A2) $;

--| The union of a collection of closed sets is a subset. (Contributed by Zhi Wang, 29-Sep-2024.)
theorem mreuniss (C S X: class):
  $ wi (wa (wcel C (cfv X cmre)) (wss S C)) (wss (cuni S) X) $;

--| The union of closed sets is the underlying set of the topology (the union of open sets). (Contributed by Zhi Wang, 6-Sep-2024.)
theorem clduni (J: class):
  $ wi (wcel J ctop) (wceq (cuni (cfv J ccld)) (cuni J)) $;

--| Conditions on open sets are equivalent to conditions on closed sets. (Contributed by Zhi Wang, 30-Aug-2024.)
theorem opncldbid {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (J: class):
  $ wi ph (wcel J ctop) $ >
  $ wi (wa ph (wceq (cv x3) (cdif (cuni J) (cv y1)))) (wb ps ch) $ >
  $ wi ph (wb (wral x3 ps J) (wral y1 ch (cfv J ccld))) $;

--| Two ways of saying that two open sets are disjoint, if ` J ` is a topology and ` X ` is an open set. (Contributed by Zhi Wang, 6-Sep-2024.)
theorem opndisj (J X Y Z: class):
  $ wi (wceq Z (cdif (cuni J) X)) (wb (wcel Y (cin J (cpw Z))) (wa (wcel Y J) (wceq (cin X Y) c0))) $;

--| Two ways of saying that two closed sets are disjoint, if ` J ` is a topology and ` X ` is a closed set. An alternative proof is similar to that of ~ opndisj with ~ elssuni replaced by the combination of ~ cldss and ~ eqid . (Contributed by Zhi Wang, 6-Sep-2024.)
theorem clddisj (J X Y Z: class):
  $ wi (wceq Z (cdif (cuni J) X)) (wb (wcel Y (cin (cfv J ccld) (cpw Z))) (wa (wcel Y (cfv J ccld)) (wceq (cin X Y) c0))) $;

--| Reverse closure of the neighborhood operation. (This theorem depends on a function's value being empty outside of its domain, but it will make later theorems simpler to state.) (Contributed by Zhi Wang, 16-Sep-2024.)
theorem neircl (S J N: class):
  $ wi (wcel N (cfv S (cfv J cnei))) (wcel J ctop) $;

--| Lemma factoring out common proof steps of ~ opnneil and ~ opnneirv . (Contributed by Zhi Wang, 31-Aug-2024.)
theorem opnneilem {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (S J: class):
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wb ps ch) $ >
  $ wi ph (wb (wrex x3 (wa (wss S (cv x3)) ps) J) (wrex y1 (wa (wss S (cv y1)) ch) J)) $;

--| If something is true for an open neighborhood, it must be true for a neighborhood. (Contributed by Zhi Wang, 31-Aug-2024.)
theorem opnneir {x3: setvar} (ph ps: wff x3) (S: class x3) (J: class):
  $ wi ph (wcel J ctop) $ >
  $ wi ph (wi (wrex x3 (wa (wss S (cv x3)) ps) J) (wrex x3 ps (cfv S (cfv J cnei)))) $;

--| A variant of ~ opnneir with different dummy variables. (Contributed by Zhi Wang, 31-Aug-2024.)
theorem opnneirv {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (S J: class):
  $ wi ph (wcel J ctop) $ >
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wb ps ch) $ >
  $ wi ph (wi (wrex x3 (wa (wss S (cv x3)) ps) J) (wrex y1 ch (cfv S (cfv J cnei)))) $;

--| The converse of ~ opnneir with different dummy variables. Note that the second hypothesis could be generalized by adding ` y e. J ` to the antecedent. See the proof for details. Although ` J e. Top ` might be redundant here (see ~ neircl ), it is listed for explicitness. (Contributed by Zhi Wang, 31-Aug-2024.)
theorem opnneilv {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (S J: class):
  $ wi ph (wcel J ctop) $ >
  $ wi (wa ph (wss (cv y1) (cv x3))) (wi ps ch) $ >
  $ wi ph (wi (wrex x3 ps (cfv S (cfv J cnei))) (wrex y1 (wa (wss S (cv y1)) ch) J)) $;

--| A variant of ~ opnneilv . (Contributed by Zhi Wang, 31-Aug-2024.)
theorem opnneil {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (S J: class):
  $ wi ph (wcel J ctop) $ >
  $ wi (wa ph (wss (cv y1) (cv x3))) (wi ps ch) $ >
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wb ps ch) $ >
  $ wi ph (wi (wrex x3 ps (cfv S (cfv J cnei))) (wrex x3 (wa (wss S (cv x3)) ps) J)) $;

--| The equivalence between neighborhood and open neighborhood. See ~ opnneibid2 for different dummy variables. (Contributed by Zhi Wang, 31-Aug-2024.)
theorem opnneibid {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (S J: class):
  $ wi ph (wcel J ctop) $ >
  $ wi (wa ph (wss (cv y1) (cv x3))) (wi ps ch) $ >
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wb ps ch) $ >
  $ wi ph (wb (wrex x3 ps (cfv S (cfv J cnei))) (wrex x3 (wa (wss S (cv x3)) ps) J)) $;

--| The equivalence between neighborhood and open neighborhood. A variant of ~ opnneibid with two dummy variables. (Contributed by Zhi Wang, 31-Aug-2024.)
theorem opnneibid2 {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (S J: class):
  $ wi ph (wcel J ctop) $ >
  $ wi (wa ph (wss (cv y1) (cv x3))) (wi ps ch) $ >
  $ wi (wa ph (wceq (cv x3) (cv y1))) (wb ps ch) $ >
  $ wi ph (wb (wrex x3 ps (cfv S (cfv J cnei))) (wrex y1 (wa (wss S (cv y1)) ch) J)) $;

--| A closed set in a subspace topology is a subset of the subspace. (Contributed by Zhi Wang, 2-Sep-2024.)
theorem restcls2lem (ph: wff) (S J K X Y: class):
  $ wi ph (wcel J ctop) $ >
  $ wi ph (wceq X (cuni J)) $ >
  $ wi ph (wss Y X) $ >
  $ wi ph (wceq K (co J Y crest)) $ >
  $ wi ph (wcel S (cfv K ccld)) $ >
  $ wi ph (wss S Y) $;

--| A closed set in a subspace topology is the closure in the original topology intersecting with the subspace. (Contributed by Zhi Wang, 2-Sep-2024.)
theorem restcls2 (ph: wff) (S J K X Y: class):
  $ wi ph (wcel J ctop) $ >
  $ wi ph (wceq X (cuni J)) $ >
  $ wi ph (wss Y X) $ >
  $ wi ph (wceq K (co J Y crest)) $ >
  $ wi ph (wcel S (cfv K ccld)) $ >
  $ wi ph (wceq S (cin (cfv S (cfv J ccl)) Y)) $;

--| Lemma for ~ restclssep . (Contributed by Zhi Wang, 2-Sep-2024.)
theorem restclsseplem (ph: wff) (S T J K X Y: class):
  $ wi ph (wcel J ctop) $ >
  $ wi ph (wceq X (cuni J)) $ >
  $ wi ph (wss Y X) $ >
  $ wi ph (wceq K (co J Y crest)) $ >
  $ wi ph (wcel S (cfv K ccld)) $ >
  $ wi ph (wceq (cin S T) c0) $ >
  $ wi ph (wss T Y) $ >
  $ wi ph (wceq (cin (cfv S (cfv J ccl)) T) c0) $;

--| Two disjoint closed sets in a subspace topology are separated in the original topology. (Contributed by Zhi Wang, 2-Sep-2024.)
theorem restclssep (ph: wff) (S T J K X Y: class):
  $ wi ph (wcel J ctop) $ >
  $ wi ph (wceq X (cuni J)) $ >
  $ wi ph (wss Y X) $ >
  $ wi ph (wceq K (co J Y crest)) $ >
  $ wi ph (wcel S (cfv K ccld)) $ >
  $ wi ph (wceq (cin S T) c0) $ >
  $ wi ph (wcel T (cfv K ccld)) $ >
  $ wi ph (wa (wceq (cin S (cfv T (cfv J ccl))) c0) (wceq (cin (cfv S (cfv J ccl)) T) c0)) $;

--| Given a continuous function, the preimage of a neighborhood is a neighborhood. To be precise, the preimage of a neighborhood of a subset ` T ` of the codomain of a continuous function is a neighborhood of any subset of the preimage of ` T ` . (Contributed by Zhi Wang, 9-Sep-2024.)
theorem cnneiima (ph: wff) (S T F J K N: class):
  $ wi ph (wcel F (co J K ccn)) $ >
  $ wi ph (wcel N (cfv T (cfv K cnei))) $ >
  $ wi ph (wss S (cima (ccnv F) T)) $ >
  $ wi ph (wcel (cima (ccnv F) N) (cfv S (cfv J cnei))) $;

--| Open intervals are open sets of ` II ` . (Contributed by Zhi Wang, 9-Sep-2024.)
theorem iooii (A2 B2: class):
  $ wi (wa (wbr cc0 A2 cle) (wbr B2 c1 cle)) (wcel (co A2 B2 cioo) cii) $;

--| Closed intervals are closed sets of ` II ` . Note that ~ iccss , ~ iccordt , and ~ ordtresticc are proved from ~ ixxss12 , ~ ordtcld3 , and ~ ordtrest2 , respectively. An alternate proof uses ~ restcldi , ~ dfii2 , and ~ icccld . (Contributed by Zhi Wang, 8-Sep-2024.)
theorem icccldii (A2 B2: class):
  $ wi (wa (wbr cc0 A2 cle) (wbr B2 c1 cle)) (wcel (co A2 B2 cicc) (cfv cii ccld)) $;

--| ` ( 0 [,) A ) ` is open in ` II ` . (Contributed by Zhi Wang, 9-Sep-2024.)
theorem i0oii (A2: class):
  $ wi (wbr A2 c1 cle) (wcel (co cc0 A2 cico) cii) $;

--| ` ( A (,] 1 ) ` is open in ` II ` . (Contributed by Zhi Wang, 9-Sep-2024.)
theorem io1ii (A2: class):
  $ wi (wbr cc0 A2 cle) (wcel (co A2 c1 cioc) cii) $;

--| Lemma for ~ sepnsepo . (Contributed by Zhi Wang, 1-Sep-2024.)
theorem sepnsepolem1 {x3 y1: setvar} (ph: wff x3) (ps ch: wff x3 y1) (J: class x3 y1):
  $ wb (wrex x3 (wrex y1 (w3a ph ps ch) J) J) (wrex x3 (wa ph (wrex y1 (wa ps ch) J)) J) $;

--| Open neighborhood and neighborhood is equivalent regarding disjointness. Lemma for ~ sepnsepo . Proof could be shortened by 1 step using ~ ssdisjdr . (Contributed by Zhi Wang, 1-Sep-2024.)
theorem sepnsepolem2 {y1: setvar} (ph: wff y1) (x3: setvar) (D J: class):
  $ wi ph (wcel J ctop) $ >
  $ wi ph (wb (wrex y1 (wceq (cin (cv x3) (cv y1)) c0) (cfv D (cfv J cnei))) (wrex y1 (wa (wss D (cv y1)) (wceq (cin (cv x3) (cv y1)) c0)) J)) $;

--| Open neighborhood and neighborhood is equivalent regarding disjointness for both sides. Namely, separatedness by open neighborhoods is equivalent to separatedness by neighborhoods. (Contributed by Zhi Wang, 1-Sep-2024.)
theorem sepnsepo {x3 y1: setvar} (ph: wff x3 y1) (C D J: class):
  $ wi ph (wcel J ctop) $ >
  $ wi ph (wb (wrex x3 (wrex y1 (wceq (cin (cv x3) (cv y1)) c0) (cfv D (cfv J cnei))) (cfv C (cfv J cnei))) (wrex x3 (wrex y1 (w3a (wss C (cv x3)) (wss D (cv y1)) (wceq (cin (cv x3) (cv y1)) c0)) J) J)) $;

--| Separated sets are disjoint. Note that in general separatedness also requires ` T C_ U. J ` and ` ( S i^i ( ( cls `` J ) `` T ) ) = (/) ` as well but they are unnecessary here. (Contributed by Zhi Wang, 7-Sep-2024.)
theorem sepdisj (ph: wff) (S T J: class):
  $ wi ph (wcel J ctop) $ >
  $ wi ph (wss S (cuni J)) $ >
  $ wi ph (wceq (cin (cfv S (cfv J ccl)) T) c0) $ >
  $ wi ph (wceq (cin S T) c0) $;

--| If two sets are separated by (open) neighborhoods, then they are separated subsets of the underlying set. Note that separatedness by open neighborhoods is equivalent to separatedness by neighborhoods. See ~ sepnsepo . The relationship between separatedness and closure is also seen in ~ isnrm , ~ isnrm2 , ~ isnrm3 . (Contributed by Zhi Wang, 7-Sep-2024.)
theorem seposep {m n: setvar} (ph: wff m n) (S T J: class):
  $ wi ph (wcel J ctop) $ >
  $ wi ph (wrex n (wrex m (w3a (wss S (cv n)) (wss T (cv m)) (wceq (cin (cv n) (cv m)) c0)) J) J) $ >
  $ wi ph (wa (wa (wss S (cuni J)) (wss T (cuni J))) (wa (wceq (cin S (cfv T (cfv J ccl))) c0) (wceq (cin (cfv S (cfv J ccl)) T) c0))) $;

--| If two sets are separated by closed neighborhoods, then they are separated by (open) neighborhoods. See ~ sepnsepo for the equivalence between separatedness by open neighborhoods and separatedness by neighborhoods. Although ` J e. Top ` might be redundant here, it is listed for explicitness. ` J e. Top ` can be obtained from ~ neircl , ~ adantr , and ~ rexlimiva . (Contributed by Zhi Wang, 8-Sep-2024.)
theorem sepcsepo {m n: setvar} (ph: wff m n) (S T J: class):
  $ wi ph (wcel J ctop) $ >
  $ wi ph (wrex n (wrex m (w3a (wcel (cv n) (cfv J ccld)) (wcel (cv m) (cfv J ccld)) (wceq (cin (cv n) (cv m)) c0)) (cfv T (cfv J cnei))) (cfv S (cfv J cnei))) $ >
  $ wi ph (wrex n (wrex m (w3a (wss S (cv n)) (wss T (cv m)) (wceq (cin (cv n) (cv m)) c0)) J) J) $;

--| If two sets are separated by a continuous function, then they are separated by closed neighborhoods. (Contributed by Zhi Wang, 9-Sep-2024.)
theorem sepfsepc {f2 m n: setvar} (ph: wff f2 m n) (S: class m) (T J: class):
  $ wi ph (wrex f2 (wa (wss S (cima (ccnv (cv f2)) (csn cc0))) (wss T (cima (ccnv (cv f2)) (csn c1)))) (co J cii ccn)) $ >
  $ wi ph (wrex n (wrex m (w3a (wcel (cv n) (cfv J ccld)) (wcel (cv m) (cfv J ccld)) (wceq (cin (cv n) (cv m)) c0)) (cfv T (cfv J cnei))) (cfv S (cfv J cnei))) $;

--| If two sets are precisely separated by a continuous function, then they are separated by the continuous function. (Contributed by Zhi Wang, 9-Sep-2024.)
theorem seppsepf {f2: setvar} (ph: wff f2) (S T J: class f2):
  $ wi ph (wrex f2 (wa (wceq S (cima (ccnv (cv f2)) (csn cc0))) (wceq T (cima (ccnv (cv f2)) (csn c1)))) (co J cii ccn)) $ >
  $ wi ph (wrex f2 (wa (wss S (cima (ccnv (cv f2)) (csn cc0))) (wss T (cima (ccnv (cv f2)) (csn c1)))) (co J cii ccn)) $;

--| If two sets are precisely separated by a continuous function, then they are closed. An alternate proof involves ` II e. Fre ` . (Contributed by Zhi Wang, 9-Sep-2024.)
theorem seppcld {f2: setvar} (ph: wff f2) (S T J: class):
  $ wi ph (wrex f2 (wa (wceq S (cima (ccnv (cv f2)) (csn cc0))) (wceq T (cima (ccnv (cv f2)) (csn c1)))) (co J cii ccn)) $ >
  $ wi ph (wa (wcel S (cfv J ccld)) (wcel T (cfv J ccld))) $;

--| A topological space is normal iff any two disjoint closed sets are separated by neighborhoods. (Contributed by Zhi Wang, 1-Sep-2024.)
theorem isnrm4 {x3 y1 c d: setvar} (J: class):
  $ wb (wcel J cnrm) (wa (wcel J ctop) (wral c (wral d (wi (wceq (cin (cv c) (cv d)) c0) (wrex x3 (wrex y1 (wceq (cin (cv x3) (cv y1)) c0) (cfv (cv d) (cfv J cnei))) (cfv (cv c) (cfv J cnei)))) (cfv J ccld)) (cfv J ccld))) $;

--| A topological space is normal if any disjoint closed sets can be separated by open neighborhoods. An alternate definition of ~ df-nrm . (Contributed by Zhi Wang, 30-Aug-2024.)
theorem dfnrm2 {x3 y1 j c d: setvar}:
  $ wceq cnrm (crab j (wral c (wral d (wi (wceq (cin (cv c) (cv d)) c0) (wrex x3 (wrex y1 (w3a (wss (cv c) (cv x3)) (wss (cv d) (cv y1)) (wceq (cin (cv x3) (cv y1)) c0)) (cv j)) (cv j))) (cfv (cv j) ccld)) (cfv (cv j) ccld)) ctop) $;

--| A topological space is normal if any disjoint closed sets can be separated by neighborhoods. An alternate definition of ~ df-nrm . (Contributed by Zhi Wang, 2-Sep-2024.)
theorem dfnrm3 {x3 y1 j c d: setvar}:
  $ wceq cnrm (crab j (wral c (wral d (wi (wceq (cin (cv c) (cv d)) c0) (wrex x3 (wrex y1 (wceq (cin (cv x3) (cv y1)) c0) (cfv (cv d) (cfv (cv j) cnei))) (cfv (cv c) (cfv (cv j) cnei)))) (cfv (cv j) ccld)) (cfv (cv j) ccld)) ctop) $;

--| Lemma for ~ iscnrm3 . Subspace topology is a topology. (Contributed by Zhi Wang, 3-Sep-2024.)
theorem iscnrm3lem1 {x3: setvar} (ph: wff x3) (A2: class x3) (J: class):
  $ wi (wcel J ctop) (wb (wral x3 ph A2) (wral x3 (wa (wcel (co J (cv x3) crest) ctop) ph) A2)) $;

--| Lemma for ~ iscnrm3 proving a biconditional on restricted universal quantifications. (Contributed by Zhi Wang, 3-Sep-2024.)
theorem iscnrm3lem2 {x3 y1 z w v: setvar} (ph: wff) (ps: wff x3 y1 z) (ch: wff w v) (A2: class x3) (B2: class x3 y1) (C: class x3 y1 z) (D: class w) (E: class w v):
  $ wi ph (wi (wral x3 (wral y1 (wral z ps C) B2) A2) (wi (wa (wcel (cv w) D) (wcel (cv v) E)) ch)) $ >
  $ wi ph (wi (wral w (wral v ch E) D) (wi (w3a (wcel (cv x3) A2) (wcel (cv y1) B2) (wcel (cv z) C)) ps)) $ >
  $ wi ph (wb (wral x3 (wral y1 (wral z ps C) B2) A2) (wral w (wral v ch E) D)) $;

--| Lemma for ~ iscnrm3lem5 and ~ iscnrm3r . (Contributed by Zhi Wang, 4-Sep-2024.)
theorem iscnrm3lem4 (ph ps ch th ta et ze: wff):
  $ wi et (wi ps ze) $ >
  $ wi (w3a ph ch th) et $ >
  $ wi (w3a ph ch th) (wi ze ta) $ >
  $ wi ph (wi ps (wi ch (wi th ta))) $;

--| Lemma for ~ iscnrm3l . (Contributed by Zhi Wang, 3-Sep-2024.)
theorem iscnrm3lem5 {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (ch: wff x3 y1) (th: wff) (ta et ze si: wff x3 y1) (S T V W: class):
  $ wi (wa (wceq (cv x3) S) (wceq (cv y1) T)) (wb ph ps) $ >
  $ wi (wa (wceq (cv x3) S) (wceq (cv y1) T)) (wb ch th) $ >
  $ wi (w3a ta et ze) (wa (wcel S V) (wcel T W)) $ >
  $ wi (w3a ta et ze) (wi (wi ps th) si) $ >
  $ wi ta (wi (wral x3 (wral y1 (wi ph ch) W) V) (wi et (wi ze si))) $;

--| Lemma for ~ iscnrm3lem7 . (Contributed by Zhi Wang, 5-Sep-2024.)
theorem iscnrm3lem6 {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (ch: wff) (V: class x3) (W: class x3 y1):
  $ wi (w3a ph (wa (wcel (cv x3) V) (wcel (cv y1) W)) ps) ch $ >
  $ wi ph (wi (wrex x3 (wrex y1 ps W) V) ch) $;

--| Lemma for ~ iscnrm3rlem8 and ~ iscnrm3llem2 involving restricted existential quantifications. (Contributed by Zhi Wang, 5-Sep-2024.)
theorem iscnrm3lem7 {x3 y1 z w: setvar} (ph: wff z w) (ps: wff x3 y1 z w) (ch: wff z w) (th: wff x3 y1 w) (ta: wff x3 y1 z) (A2: class x3 z w) (B2: class x3 y1 z w) (C: class w) (D: class) (W: class x3 y1 z) (Z: class x3 y1):
  $ wi (wceq (cv z) Z) (wb ch th) $ >
  $ wi (wceq (cv w) W) (wb th ta) $ >
  $ wi (w3a ph (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) ps) (w3a (wcel Z C) (wcel W D) ta) $ >
  $ wi ph (wi (wrex x3 (wrex y1 ps B2) A2) (wrex z (wrex w ch D) C)) $;

--| Lemma for ~ iscnrm3rlem2 . The hypothesis could be generalized to ` ( ph -> ( S \ T ) C_ X ) ` . (Contributed by Zhi Wang, 5-Sep-2024.)
theorem iscnrm3rlem1 (ph: wff) (S T X: class):
  $ wi ph (wss S X) $ >
  $ wi ph (wceq (cdif S T) (cin S (cdif X (cin S T)))) $;

--| Lemma for ~ iscnrm3rlem3 . (Contributed by Zhi Wang, 5-Sep-2024.)
theorem iscnrm3rlem2 (ph: wff) (S T J: class):
  $ wi ph (wcel J ctop) $ >
  $ wi ph (wss S (cuni J)) $ >
  $ wi ph (wcel (cdif (cfv S (cfv J ccl)) T) (cfv (co J (cdif (cuni J) (cin (cfv S (cfv J ccl)) T)) crest) ccld)) $;

--| Lemma for ~ iscnrm3r . The designed subspace is a subset of the original set; the two sets are closed sets in the subspace. (Contributed by Zhi Wang, 5-Sep-2024.)
theorem iscnrm3rlem3 (S T J: class):
  $ wi (wa (wcel J ctop) (wa (wcel S (cpw (cuni J))) (wcel T (cpw (cuni J))))) (w3a (wcel (cdif (cuni J) (cin (cfv S (cfv J ccl)) (cfv T (cfv J ccl)))) (cpw (cuni J))) (wcel (cdif (cfv S (cfv J ccl)) (cfv T (cfv J ccl))) (cfv (co J (cdif (cuni J) (cin (cfv S (cfv J ccl)) (cfv T (cfv J ccl)))) crest) ccld)) (wcel (cdif (cfv T (cfv J ccl)) (cfv S (cfv J ccl))) (cfv (co J (cdif (cuni J) (cin (cfv S (cfv J ccl)) (cfv T (cfv J ccl)))) crest) ccld))) $;

--| Lemma for ~ iscnrm3rlem8 . Given two disjoint subsets ` S ` and ` T ` of the underlying set of a topology ` J ` , if ` N ` is a superset of ` ( ( ( cls `` J ) `` S ) \ T ) ` , then it is a superset of ` S ` . (Contributed by Zhi Wang, 5-Sep-2024.)
theorem iscnrm3rlem4 (ph: wff) (S T J N: class):
  $ wi ph (wcel J ctop) $ >
  $ wi ph (wss S (cuni J)) $ >
  $ wi ph (wceq (cin S T) c0) $ >
  $ wi ph (wss (cdif (cfv S (cfv J ccl)) T) N) $ >
  $ wi ph (wss S N) $;

--| Lemma for ~ iscnrm3rlem6 . (Contributed by Zhi Wang, 5-Sep-2024.)
theorem iscnrm3rlem5 (ph: wff) (S T J: class):
  $ wi ph (wcel J ctop) $ >
  $ wi ph (wss S (cuni J)) $ >
  $ wi ph (wss T (cuni J)) $ >
  $ wi ph (wcel (cdif (cuni J) (cin (cfv S (cfv J ccl)) (cfv T (cfv J ccl)))) J) $;

--| Lemma for ~ iscnrm3rlem7 . (Contributed by Zhi Wang, 5-Sep-2024.)
theorem iscnrm3rlem6 (ph: wff) (S T J O: class):
  $ wi ph (wcel J ctop) $ >
  $ wi ph (wss S (cuni J)) $ >
  $ wi ph (wss T (cuni J)) $ >
  $ wi ph (wss O (cdif (cuni J) (cin (cfv S (cfv J ccl)) (cfv T (cfv J ccl))))) $ >
  $ wi ph (wb (wcel O (co J (cdif (cuni J) (cin (cfv S (cfv J ccl)) (cfv T (cfv J ccl)))) crest)) (wcel O J)) $;

--| Lemma for ~ iscnrm3rlem8 . Open neighborhoods in the subspace topology are open neighborhoods in the original topology given that the subspace is an open set in the original topology. (Contributed by Zhi Wang, 5-Sep-2024.)
theorem iscnrm3rlem7 (ph: wff) (S T J O: class):
  $ wi ph (wcel J ctop) $ >
  $ wi ph (wss S (cuni J)) $ >
  $ wi ph (wss T (cuni J)) $ >
  $ wi ph (wcel O (co J (cdif (cuni J) (cin (cfv S (cfv J ccl)) (cfv T (cfv J ccl)))) crest)) $ >
  $ wi ph (wcel O J) $;

--| Lemma for ~ iscnrm3r . Disjoint open neighborhoods in the subspace topology are disjoint open neighborhoods in the original topology given that the subspace is an open set in the original topology. Therefore, given any two sets separated in the original topology and separated by open neighborhoods in the subspace topology, they must be separated by open neighborhoods in the original topology. (Contributed by Zhi Wang, 5-Sep-2024.)
theorem iscnrm3rlem8 {k m n l: setvar} (S T J: class):
  $ wi (w3a (wcel J ctop) (wa (wcel S (cpw (cuni J))) (wcel T (cpw (cuni J)))) (wa (wceq (cin S (cfv T (cfv J ccl))) c0) (wceq (cin (cfv S (cfv J ccl)) T) c0))) (wi (wrex l (wrex k (w3a (wss (cdif (cfv S (cfv J ccl)) (cfv T (cfv J ccl))) (cv l)) (wss (cdif (cfv T (cfv J ccl)) (cfv S (cfv J ccl))) (cv k)) (wceq (cin (cv l) (cv k)) c0)) (co J (cdif (cuni J) (cin (cfv S (cfv J ccl)) (cfv T (cfv J ccl)))) crest)) (co J (cdif (cuni J) (cin (cfv S (cfv J ccl)) (cfv T (cfv J ccl)))) crest)) (wrex n (wrex m (w3a (wss S (cv n)) (wss T (cv m)) (wceq (cin (cv n) (cv m)) c0)) J) J)) $;

--| Lemma for ~ iscnrm3 . If all subspaces of a topology are normal, i.e., two disjoint closed sets can be separated by open neighborhoods, then in the original topology two separated sets can be separated by open neighborhoods. (Contributed by Zhi Wang, 5-Sep-2024.)
theorem iscnrm3r {z k m n c d l: setvar} (S T J: class):
  $ wi (wcel J ctop) (wi (wral z (wral c (wral d (wi (wceq (cin (cv c) (cv d)) c0) (wrex l (wrex k (w3a (wss (cv c) (cv l)) (wss (cv d) (cv k)) (wceq (cin (cv l) (cv k)) c0)) (co J (cv z) crest)) (co J (cv z) crest))) (cfv (co J (cv z) crest) ccld)) (cfv (co J (cv z) crest) ccld)) (cpw (cuni J))) (wi (wa (wcel S (cpw (cuni J))) (wcel T (cpw (cuni J)))) (wi (wa (wceq (cin S (cfv T (cfv J ccl))) c0) (wceq (cin (cfv S (cfv J ccl)) T) c0)) (wrex n (wrex m (w3a (wss S (cv n)) (wss T (cv m)) (wceq (cin (cv n) (cv m)) c0)) J) J)))) $;

--| Lemma for ~ iscnrm3l . Closed sets in the subspace are subsets of the underlying set of the original topology. (Contributed by Zhi Wang, 4-Sep-2024.)
theorem iscnrm3llem1 (C D J Z: class):
  $ wi (w3a (wcel J ctop) (w3a (wcel Z (cpw (cuni J))) (wcel C (cfv (co J Z crest) ccld)) (wcel D (cfv (co J Z crest) ccld))) (wceq (cin C D) c0)) (wa (wcel C (cpw (cuni J))) (wcel D (cpw (cuni J)))) $;

--| Lemma for ~ iscnrm3l . If there exist disjoint open neighborhoods in the original topology for two disjoint closed sets in a subspace, then they can be separated by open neighborhoods in the subspace topology. (Could shorten proof with ~ ssin0 .) (Contributed by Zhi Wang, 5-Sep-2024.)
theorem iscnrm3llem2 {k m n l: setvar} (C D J Z: class):
  $ wi (w3a (wcel J ctop) (w3a (wcel Z (cpw (cuni J))) (wcel C (cfv (co J Z crest) ccld)) (wcel D (cfv (co J Z crest) ccld))) (wceq (cin C D) c0)) (wi (wrex n (wrex m (w3a (wss C (cv n)) (wss D (cv m)) (wceq (cin (cv n) (cv m)) c0)) J) J) (wrex l (wrex k (w3a (wss C (cv l)) (wss D (cv k)) (wceq (cin (cv l) (cv k)) c0)) (co J Z crest)) (co J Z crest))) $;

--| Lemma for ~ iscnrm3 . Given a topology ` J ` , if two separated sets can be separated by open neighborhoods, then all subspaces of the topology ` J ` are normal, i.e., two disjoint closed sets can be separated by open neighborhoods. (Contributed by Zhi Wang, 5-Sep-2024.)
theorem iscnrm3l {t k m n s1 l: setvar} (C D J: class) (Z: class t s1):
  $ wi (wcel J ctop) (wi (wral s1 (wral t (wi (wa (wceq (cin (cv s1) (cfv (cv t) (cfv J ccl))) c0) (wceq (cin (cfv (cv s1) (cfv J ccl)) (cv t)) c0)) (wrex n (wrex m (w3a (wss (cv s1) (cv n)) (wss (cv t) (cv m)) (wceq (cin (cv n) (cv m)) c0)) J) J)) (cpw (cuni J))) (cpw (cuni J))) (wi (w3a (wcel Z (cpw (cuni J))) (wcel C (cfv (co J Z crest) ccld)) (wcel D (cfv (co J Z crest) ccld))) (wi (wceq (cin C D) c0) (wrex l (wrex k (w3a (wss C (cv l)) (wss D (cv k)) (wceq (cin (cv l) (cv k)) c0)) (co J Z crest)) (co J Z crest))))) $;

--| A completely normal topology is a topology in which two separated sets can be separated by open neighborhoods. (Contributed by Zhi Wang, 5-Sep-2024.)
theorem iscnrm3 {t m n s1: setvar} (J: class):
  $ wb (wcel J ccnrm) (wa (wcel J ctop) (wral s1 (wral t (wi (wa (wceq (cin (cv s1) (cfv (cv t) (cfv J ccl))) c0) (wceq (cin (cfv (cv s1) (cfv J ccl)) (cv t)) c0)) (wrex n (wrex m (w3a (wss (cv s1) (cv n)) (wss (cv t) (cv m)) (wceq (cin (cv n) (cv m)) c0)) J) J)) (cpw (cuni J))) (cpw (cuni J)))) $;

--| A topology is completely normal iff two separated sets can be separated by open neighborhoods. (Contributed by Zhi Wang, 10-Sep-2024.)
theorem iscnrm3v {t m n s1: setvar} (J: class):
  $ wi (wcel J ctop) (wb (wcel J ccnrm) (wral s1 (wral t (wi (wa (wceq (cin (cv s1) (cfv (cv t) (cfv J ccl))) c0) (wceq (cin (cfv (cv s1) (cfv J ccl)) (cv t)) c0)) (wrex n (wrex m (w3a (wss (cv s1) (cv n)) (wss (cv t) (cv m)) (wceq (cin (cv n) (cv m)) c0)) J) J)) (cpw (cuni J))) (cpw (cuni J)))) $;

--| A completely normal topology is a topology in which two separated sets can be separated by neighborhoods. (Contributed by Zhi Wang, 5-Sep-2024.)
theorem iscnrm4 {t m n s1: setvar} (J: class):
  $ wb (wcel J ccnrm) (wa (wcel J ctop) (wral s1 (wral t (wi (wa (wceq (cin (cv s1) (cfv (cv t) (cfv J ccl))) c0) (wceq (cin (cfv (cv s1) (cfv J ccl)) (cv t)) c0)) (wrex n (wrex m (wceq (cin (cv n) (cv m)) c0) (cfv (cv t) (cfv J cnei))) (cfv (cv s1) (cfv J cnei)))) (cpw (cuni J))) (cpw (cuni J)))) $;

--| Property of being a preordered set (deduction form). (Contributed by Zhi Wang, 18-Sep-2024.)
theorem isprsd {x3 y1 z: setvar} (ph: wff) (B2: class x3 y1 z) (K: class) (c_le V: class x3 y1 z):
  $ wi ph (wceq B2 (cfv K cbs)) $ >
  $ wi ph (wceq c_le (cfv K cple)) $ >
  $ wi ph (wcel K V) $ >
  $ wi ph (wb (wcel K cproset) (wral x3 (wral y1 (wral z (wa (wbr (cv x3) (cv x3) c_le) (wi (wa (wbr (cv x3) (cv y1) c_le) (wbr (cv y1) (cv z) c_le)) (wbr (cv x3) (cv z) c_le))) B2) B2) B2)) $;

--| Member of the domain of the least upper bound function of a poset. (Contributed by Zhi Wang, 26-Sep-2024.)
theorem lubeldm2 {x3 y1 z: setvar} (ph ps: wff x3 y1 z) (B2 S: class) (U: class x3 y1 z) (K c_le: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq U (cfv K club) $ >
  $ wb ps (wa (wral y1 (wbr (cv y1) (cv x3) c_le) S) (wral z (wi (wral y1 (wbr (cv y1) (cv z) c_le) S) (wbr (cv x3) (cv z) c_le)) B2)) $ >
  $ wi ph (wcel K cpo) $ >
  $ wi ph (wb (wcel S (cdm U)) (wa (wss S B2) (wrex x3 ps B2))) $;

--| Member of the domain of the greatest lower bound function of a poset. (Contributed by Zhi Wang, 26-Sep-2024.)
theorem glbeldm2 {x3 y1 z: setvar} (ph ps: wff x3 y1 z) (B2 S: class) (G: class x3 y1 z) (K c_le: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq G (cfv K cglb) $ >
  $ wb ps (wa (wral y1 (wbr (cv x3) (cv y1) c_le) S) (wral z (wi (wral y1 (wbr (cv z) (cv y1) c_le) S) (wbr (cv z) (cv x3) c_le)) B2)) $ >
  $ wi ph (wcel K cpo) $ >
  $ wi ph (wb (wcel S (cdm G)) (wa (wss S B2) (wrex x3 ps B2))) $;

--| Member of the domain of the least upper bound function of a poset. (Contributed by Zhi Wang, 28-Sep-2024.)
theorem lubeldm2d {x3 y1 z: setvar} (ph: wff) (ps: wff x3 y1 z) (B2: class x3 y1 z) (S: class) (U: class x3 y1 z) (K: class) (c_le: class x3 y1 z):
  $ wi ph (wceq B2 (cfv K cbs)) $ >
  $ wi ph (wceq c_le (cfv K cple)) $ >
  $ wi ph (wceq U (cfv K club)) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wb ps (wa (wral y1 (wbr (cv y1) (cv x3) c_le) S) (wral z (wi (wral y1 (wbr (cv y1) (cv z) c_le) S) (wbr (cv x3) (cv z) c_le)) B2))) $ >
  $ wi ph (wcel K cpo) $ >
  $ wi ph (wb (wcel S (cdm U)) (wa (wss S B2) (wrex x3 ps B2))) $;

--| Member of the domain of the greatest lower bound function of a poset. (Contributed by Zhi Wang, 29-Sep-2024.)
theorem glbeldm2d {x3 y1 z: setvar} (ph: wff) (ps: wff x3 y1 z) (B2: class x3 y1 z) (S: class) (G: class x3 y1 z) (K: class) (c_le: class x3 y1 z):
  $ wi ph (wceq B2 (cfv K cbs)) $ >
  $ wi ph (wceq c_le (cfv K cple)) $ >
  $ wi ph (wceq G (cfv K cglb)) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wb ps (wa (wral y1 (wbr (cv x3) (cv y1) c_le) S) (wral z (wi (wral y1 (wbr (cv z) (cv y1) c_le) S) (wbr (cv z) (cv x3) c_le)) B2))) $ >
  $ wi ph (wcel K cpo) $ >
  $ wi ph (wb (wcel S (cdm G)) (wa (wss S B2) (wrex x3 ps B2))) $;

--| If a subset of ` S ` contains the LUB of ` S ` , then the two sets have the same LUB. (Contributed by Zhi Wang, 26-Sep-2024.)
theorem lubsscl (ph: wff) (S T U K: class):
  $ wi ph (wcel K cpo) $ >
  $ wi ph (wss T S) $ >
  $ wceq U (cfv K club) $ >
  $ wi ph (wcel S (cdm U)) $ >
  $ wi ph (wcel (cfv S U) T) $ >
  $ wi ph (wa (wcel T (cdm U)) (wceq (cfv T U) (cfv S U))) $;

--| If a subset of ` S ` contains the GLB of ` S ` , then the two sets have the same GLB. (Contributed by Zhi Wang, 26-Sep-2024.)
theorem glbsscl (ph: wff) (S T G K: class):
  $ wi ph (wcel K cpo) $ >
  $ wi ph (wss T S) $ >
  $ wceq G (cfv K cglb) $ >
  $ wi ph (wcel S (cdm G)) $ >
  $ wi ph (wcel (cfv S G) T) $ >
  $ wi ph (wa (wcel T (cdm G)) (wceq (cfv T G) (cfv S G))) $;

--| Lemma for ~ lubprdm and ~ lubpr . (Contributed by Zhi Wang, 26-Sep-2024.)
theorem lubprlem (ph: wff) (B2 S U K c_le X Y: class):
  $ wi ph (wcel K cpo) $ >
  $ wceq B2 (cfv K cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wi ph (wbr X Y c_le) $ >
  $ wi ph (wceq S (cpr X Y)) $ >
  $ wceq U (cfv K club) $ >
  $ wi ph (wa (wcel S (cdm U)) (wceq (cfv S U) Y)) $;

--| The set of two comparable elements in a poset has LUB. (Contributed by Zhi Wang, 26-Sep-2024.)
theorem lubprdm (ph: wff) (B2 S U K c_le X Y: class):
  $ wi ph (wcel K cpo) $ >
  $ wceq B2 (cfv K cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wi ph (wbr X Y c_le) $ >
  $ wi ph (wceq S (cpr X Y)) $ >
  $ wceq U (cfv K club) $ >
  $ wi ph (wcel S (cdm U)) $;

--| The LUB of the set of two comparable elements in a poset is the greater one of the two. (Contributed by Zhi Wang, 26-Sep-2024.)
theorem lubpr (ph: wff) (B2 S U K c_le X Y: class):
  $ wi ph (wcel K cpo) $ >
  $ wceq B2 (cfv K cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wi ph (wbr X Y c_le) $ >
  $ wi ph (wceq S (cpr X Y)) $ >
  $ wceq U (cfv K club) $ >
  $ wi ph (wceq (cfv S U) Y) $;

--| Lemma for ~ glbprdm and ~ glbpr . (Contributed by Zhi Wang, 26-Sep-2024.)
theorem glbprlem (ph: wff) (B2 S G K c_le X Y: class):
  $ wi ph (wcel K cpo) $ >
  $ wceq B2 (cfv K cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wi ph (wbr X Y c_le) $ >
  $ wi ph (wceq S (cpr X Y)) $ >
  $ wceq G (cfv K cglb) $ >
  $ wi ph (wa (wcel S (cdm G)) (wceq (cfv S G) X)) $;

--| The set of two comparable elements in a poset has GLB. (Contributed by Zhi Wang, 26-Sep-2024.)
theorem glbprdm (ph: wff) (B2 S G K c_le X Y: class):
  $ wi ph (wcel K cpo) $ >
  $ wceq B2 (cfv K cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wi ph (wbr X Y c_le) $ >
  $ wi ph (wceq S (cpr X Y)) $ >
  $ wceq G (cfv K cglb) $ >
  $ wi ph (wcel S (cdm G)) $;

--| The GLB of the set of two comparable elements in a poset is the less one of the two. (Contributed by Zhi Wang, 26-Sep-2024.)
theorem glbpr (ph: wff) (B2 S G K c_le X Y: class):
  $ wi ph (wcel K cpo) $ >
  $ wceq B2 (cfv K cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wi ph (wbr X Y c_le) $ >
  $ wi ph (wceq S (cpr X Y)) $ >
  $ wceq G (cfv K cglb) $ >
  $ wi ph (wceq (cfv S G) X) $;

--| The join of any two elements always exists iff all unordered pairs have LUB. (Contributed by Zhi Wang, 25-Sep-2024.)
theorem joindm2 {x3 y1: setvar} (ph: wff) (B2: class) (U: class x3 y1) (c_or: class) (K V: class x3 y1):
  $ wceq B2 (cfv K cbs) $ >
  $ wi ph (wcel K V) $ >
  $ wceq U (cfv K club) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wi ph (wb (wceq (cdm c_or) (cxp B2 B2)) (wral x3 (wral y1 (wcel (cpr (cv x3) (cv y1)) (cdm U)) B2) B2)) $;

--| The join of any two elements always exists iff all unordered pairs have LUB (expanded version). (Contributed by Zhi Wang, 25-Sep-2024.)
theorem joindm3 {x3 y1 z w: setvar} (ph: wff z w) (B2: class) (U: class x3 y1 z w) (c_or: class) (K: class x3 y1) (c_le V: class x3 y1 z w):
  $ wceq B2 (cfv K cbs) $ >
  $ wi ph (wcel K V) $ >
  $ wceq U (cfv K club) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wi ph (wb (wceq (cdm c_or) (cxp B2 B2)) (wral x3 (wral y1 (wreu z (wa (wa (wbr (cv x3) (cv z) c_le) (wbr (cv y1) (cv z) c_le)) (wral w (wi (wa (wbr (cv x3) (cv w) c_le) (wbr (cv y1) (cv w) c_le)) (wbr (cv z) (cv w) c_le)) B2)) B2) B2) B2)) $;

--| The meet of any two elements always exists iff all unordered pairs have GLB. (Contributed by Zhi Wang, 25-Sep-2024.)
theorem meetdm2 {x3 y1: setvar} (ph: wff) (B2: class) (G K: class x3 y1) (c_an: class) (V: class x3 y1):
  $ wceq B2 (cfv K cbs) $ >
  $ wi ph (wcel K V) $ >
  $ wceq G (cfv K cglb) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wi ph (wb (wceq (cdm c_an) (cxp B2 B2)) (wral x3 (wral y1 (wcel (cpr (cv x3) (cv y1)) (cdm G)) B2) B2)) $;

--| The meet of any two elements always exists iff all unordered pairs have GLB (expanded version). (Contributed by Zhi Wang, 25-Sep-2024.)
theorem meetdm3 {x3 y1 z w: setvar} (ph: wff z w) (B2: class) (G: class x3 y1 z w) (K: class x3 y1) (c_le: class x3 y1 z w) (c_an: class) (V: class x3 y1 z w):
  $ wceq B2 (cfv K cbs) $ >
  $ wi ph (wcel K V) $ >
  $ wceq G (cfv K cglb) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wi ph (wb (wceq (cdm c_an) (cxp B2 B2)) (wral x3 (wral y1 (wreu z (wa (wa (wbr (cv z) (cv x3) c_le) (wbr (cv z) (cv y1) c_le)) (wral w (wi (wa (wbr (cv w) (cv x3) c_le) (wbr (cv w) (cv y1) c_le)) (wbr (cv w) (cv z) c_le)) B2)) B2) B2) B2)) $;

--| Poset join is idempotent. ~ latjidm could be shortened by this. (Contributed by Zhi Wang, 27-Sep-2024.)
theorem posjidm (B2 c_or K X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wi (wa (wcel K cpo) (wcel X B2)) (wceq (co X X c_or) X) $;

--| Poset meet is idempotent. ~ latmidm could be shortened by this. (Contributed by Zhi Wang, 27-Sep-2024.)
theorem posmidm (B2 K c_an X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wi (wa (wcel K cpo) (wcel X B2)) (wceq (co X X c_an) X) $;

--| Construct a poset ( ~ resipos ) for any base set. (Contributed by Zhi Wang, 20-Oct-2025.)
theorem resiposbas (B2 K V: class):
  $ wceq K (cpr (cop (cfv cnx cbs) B2) (cop (cfv cnx cple) (cres cid B2))) $ >
  $ wi (wcel B2 V) (wceq B2 (cfv K cbs)) $;

--| A set equipped with an order where no distinct elements are comparable is a poset. (Contributed by Zhi Wang, 20-Oct-2025.)
theorem resipos (B2 K V: class):
  $ wceq K (cpr (cop (cfv cnx cbs) B2) (cop (cfv cnx cple) (cres cid B2))) $ >
  $ wi (wcel B2 V) (wcel K cpo) $;

--| There exists a poset for any base set. (Contributed by Zhi Wang, 20-Oct-2025.)
theorem exbaspos {k: setvar} (B2: class) (V: class k):
  $ wi (wcel B2 V) (wrex k (wceq B2 (cfv (cv k) cbs)) cpo) $;

--| There exists a preordered set for any base set. (Contributed by Zhi Wang, 20-Oct-2025.)
theorem exbasprs {k: setvar} (B2: class) (V: class k):
  $ wi (wcel B2 V) (wrex k (wceq B2 (cfv (cv k) cbs)) cproset) $;

--| The base function restricted to the class of posets maps the class of posets onto the universal class. (Contributed by Zhi Wang, 20-Oct-2025.)
theorem basresposfo:
  $ wfo cpo cvv (cres cbs cpo) $;

--| The base function restricted to the class of preordered sets maps the class of preordered sets onto the universal class. (Contributed by Zhi Wang, 20-Oct-2025.)
theorem basresprsfo:
  $ wfo cproset cvv (cres cbs cproset) $;

--| The class of posets is a proper class. (Contributed by Zhi Wang, 20-Oct-2025.)
theorem posnex:
  $ wnel cpo cvv $;

--| The class of preordered sets is a proper class. (Contributed by Zhi Wang, 20-Oct-2025.)
theorem prsnex:
  $ wnel cproset cvv $;

--| A toset is a lattice. (Contributed by Zhi Wang, 26-Sep-2024.)
theorem toslat (K: class):
  $ wi (wcel K ctos) (wcel K clat) $;

--| The predicate "is a complete lattice" (deduction form). (Contributed by Zhi Wang, 29-Sep-2024.)
theorem isclatd {s1: setvar} (ph: wff) (B2 U G: class) (K: class s1):
  $ wi ph (wceq B2 (cfv K cbs)) $ >
  $ wi ph (wceq U (cfv K club)) $ >
  $ wi ph (wceq G (cfv K cglb)) $ >
  $ wi ph (wcel K cpo) $ >
  $ wi (wa ph (wss (cv s1) B2)) (wcel (cv s1) (cdm U)) $ >
  $ wi (wa ph (wss (cv s1) B2)) (wcel (cv s1) (cdm G)) $ >
  $ wi ph (wcel K ccla) $;

--| Existential uniqueness of the least upper bound. (Contributed by Zhi Wang, 28-Sep-2024.)
theorem intubeu {x3 y1: setvar} (A2 B2: class) (C: class x3):
  $ wi (wcel C B2) (wb (wa (wss A2 C) (wral y1 (wi (wss A2 (cv y1)) (wss C (cv y1))) B2)) (wceq C (cint (crab x3 (wss A2 (cv x3)) B2)))) $;

--| Existential uniqueness of the greatest lower bound. (Contributed by Zhi Wang, 29-Sep-2024.)
theorem unilbeu {x3 y1: setvar} (A2 B2: class) (C: class x3):
  $ wi (wcel C B2) (wb (wa (wss C A2) (wral y1 (wi (wss (cv y1) A2) (wss (cv y1) C)) B2)) (wceq C (cuni (crab x3 (wss (cv x3) A2) B2)))) $;

--| Lemma for ~ ipolubdm and ~ ipolub . (Contributed by Zhi Wang, 28-Sep-2024.)
theorem ipolublem {y1 z: setvar} (ph: wff) (S: class z) (F: class) (I c_le V: class y1 z) (X: class):
  $ wceq I (cfv F cipo) $ >
  $ wi ph (wcel F V) $ >
  $ wi ph (wss S F) $ >
  $ wceq c_le (cfv I cple) $ >
  $ wi (wa ph (wcel X F)) (wb (wa (wss (cuni S) X) (wral z (wi (wss (cuni S) (cv z)) (wss X (cv z))) F)) (wa (wral y1 (wbr (cv y1) X c_le) S) (wral z (wi (wral y1 (wbr (cv y1) (cv z) c_le) S) (wbr X (cv z) c_le)) F))) $;

--| The domain of the LUB of the inclusion poset. (Contributed by Zhi Wang, 28-Sep-2024.)
theorem ipolubdm {x3: setvar} (ph: wff x3) (S: class) (T U: class x3) (F: class) (I V: class x3):
  $ wceq I (cfv F cipo) $ >
  $ wi ph (wcel F V) $ >
  $ wi ph (wss S F) $ >
  $ wi ph (wceq U (cfv I club)) $ >
  $ wi ph (wceq T (cint (crab x3 (wss (cuni S) (cv x3)) F))) $ >
  $ wi ph (wb (wcel S (cdm U)) (wcel T F)) $;

--| The LUB of the inclusion poset. (hypotheses "ipolub.s" and "ipolub.t" could be eliminated with ` S e. dom U ` .) Could be significantly shortened if ~ poslubdg is in quantified form. ~ mrelatlub could potentially be shortened using this. See ~ mrelatlubALT . (Contributed by Zhi Wang, 28-Sep-2024.)
theorem ipolub {x3: setvar} (ph: wff x3) (S: class) (T U: class x3) (F: class) (I V: class x3):
  $ wceq I (cfv F cipo) $ >
  $ wi ph (wcel F V) $ >
  $ wi ph (wss S F) $ >
  $ wi ph (wceq U (cfv I club)) $ >
  $ wi ph (wceq T (cint (crab x3 (wss (cuni S) (cv x3)) F))) $ >
  $ wi ph (wcel T F) $ >
  $ wi ph (wceq (cfv S U) T) $;

--| Lemma for ~ ipoglbdm and ~ ipoglb . (Contributed by Zhi Wang, 29-Sep-2024.)
theorem ipoglblem {y1 z: setvar} (ph: wff) (S: class z) (F: class) (I c_le V: class y1 z) (X: class):
  $ wceq I (cfv F cipo) $ >
  $ wi ph (wcel F V) $ >
  $ wi ph (wss S F) $ >
  $ wceq c_le (cfv I cple) $ >
  $ wi (wa ph (wcel X F)) (wb (wa (wss X (cint S)) (wral z (wi (wss (cv z) (cint S)) (wss (cv z) X)) F)) (wa (wral y1 (wbr X (cv y1) c_le) S) (wral z (wi (wral y1 (wbr (cv z) (cv y1) c_le) S) (wbr (cv z) X c_le)) F))) $;

--| The domain of the GLB of the inclusion poset. (Contributed by Zhi Wang, 29-Sep-2024.)
theorem ipoglbdm {x3: setvar} (ph: wff x3) (S: class) (T: class x3) (F: class) (G I V: class x3):
  $ wceq I (cfv F cipo) $ >
  $ wi ph (wcel F V) $ >
  $ wi ph (wss S F) $ >
  $ wi ph (wceq G (cfv I cglb)) $ >
  $ wi ph (wceq T (cuni (crab x3 (wss (cv x3) (cint S)) F))) $ >
  $ wi ph (wb (wcel S (cdm G)) (wcel T F)) $;

--| The GLB of the inclusion poset. (hypotheses "ipolub.s" and "ipoglb.t" could be eliminated with ` S e. dom G ` .) Could be significantly shortened if ~ posglbdg is in quantified form. ~ mrelatglb could potentially be shortened using this. See ~ mrelatglbALT . (Contributed by Zhi Wang, 29-Sep-2024.)
theorem ipoglb {x3: setvar} (ph: wff x3) (S: class) (T: class x3) (F: class) (G I V: class x3):
  $ wceq I (cfv F cipo) $ >
  $ wi ph (wcel F V) $ >
  $ wi ph (wss S F) $ >
  $ wi ph (wceq G (cfv I cglb)) $ >
  $ wi ph (wceq T (cuni (crab x3 (wss (cv x3) (cint S)) F))) $ >
  $ wi ph (wcel T F) $ >
  $ wi ph (wceq (cfv S G) T) $;

--| The LUB of the empty set is the intersection of the base. (Contributed by Zhi Wang, 30-Sep-2024.)
theorem ipolub0 (ph: wff) (U F I V: class):
  $ wceq I (cfv F cipo) $ >
  $ wi ph (wceq U (cfv I club)) $ >
  $ wi ph (wcel (cint F) F) $ >
  $ wi ph (wcel F V) $ >
  $ wi ph (wceq (cfv c0 U) (cint F)) $;

--| The LUB of the empty set is the empty set if it is contained. (Contributed by Zhi Wang, 30-Sep-2024.)
theorem ipolub00 (ph: wff) (U F I: class):
  $ wceq I (cfv F cipo) $ >
  $ wi ph (wceq U (cfv I club)) $ >
  $ wi ph (wcel c0 F) $ >
  $ wi ph (wceq (cfv c0 U) c0) $;

--| The GLB of the empty set is the union of the base. (Contributed by Zhi Wang, 30-Sep-2024.)
theorem ipoglb0 (ph: wff) (F G I: class):
  $ wceq I (cfv F cipo) $ >
  $ wi ph (wceq G (cfv I cglb)) $ >
  $ wi ph (wcel (cuni F) F) $ >
  $ wi ph (wceq (cfv c0 G) (cuni F)) $;

--| Least upper bounds in a Moore space are realized by the closure of the union. (Contributed by Stefan O'Rear, 31-Jan-2015.) (Proof shortened by Zhi Wang, 29-Sep-2024.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem mrelatlubALT (C U F I L X: class):
  $ wceq I (cfv C cipo) $ >
  $ wceq F (cfv C cmrc) $ >
  $ wceq L (cfv I club) $ >
  $ wi (wa (wcel C (cfv X cmre)) (wss U C)) (wceq (cfv U L) (cfv (cuni U) F)) $;

--| Greatest lower bounds in a Moore space are realized by intersections. (Contributed by Stefan O'Rear, 31-Jan-2015.) (Proof shortened by Zhi Wang, 29-Sep-2024.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem mrelatglbALT (C U G I X: class):
  $ wceq I (cfv C cipo) $ >
  $ wceq G (cfv I cglb) $ >
  $ wi (w3a (wcel C (cfv X cmre)) (wss U C) (wne U c0)) (wceq (cfv U G) (cint U)) $;

--| A Moore space is a complete lattice under inclusion. (Contributed by Zhi Wang, 30-Sep-2024.)
theorem mreclat (C I X: class):
  $ wceq I (cfv C cipo) $ >
  $ wi (wcel C (cfv X cmre)) (wcel I ccla) $;

--| A topology is a complete lattice under inclusion. (Contributed by Zhi Wang, 30-Sep-2024.)
theorem topclat (I J: class):
  $ wceq I (cfv J cipo) $ >
  $ wi (wcel J ctop) (wcel I ccla) $;

--| The empty intersection in a topology is realized by the base set. (Contributed by Zhi Wang, 30-Sep-2024.)
theorem toplatglb0 (ph: wff) (G I J: class):
  $ wceq I (cfv J cipo) $ >
  $ wi ph (wcel J ctop) $ >
  $ wceq G (cfv I cglb) $ >
  $ wi ph (wceq (cfv c0 G) (cuni J)) $;

--| Least upper bounds in a topology are realized by unions. (Contributed by Zhi Wang, 30-Sep-2024.)
theorem toplatlub (ph: wff) (S U I J: class):
  $ wceq I (cfv J cipo) $ >
  $ wi ph (wcel J ctop) $ >
  $ wi ph (wss S J) $ >
  $ wceq U (cfv I club) $ >
  $ wi ph (wceq (cfv S U) (cuni S)) $;

--| Greatest lower bounds in a topology are realized by the interior of the intersection. (Contributed by Zhi Wang, 30-Sep-2024.)
theorem toplatglb (ph: wff) (S G I J: class):
  $ wceq I (cfv J cipo) $ >
  $ wi ph (wcel J ctop) $ >
  $ wi ph (wss S J) $ >
  $ wceq G (cfv I cglb) $ >
  $ wi ph (wne S c0) $ >
  $ wi ph (wceq (cfv S G) (cfv (cint S) (cfv J cnt))) $;

--| Joins in a topology are realized by unions. (Contributed by Zhi Wang, 30-Sep-2024.)
theorem toplatjoin (ph: wff) (A2 B2 I J c_or: class):
  $ wceq I (cfv J cipo) $ >
  $ wi ph (wcel J ctop) $ >
  $ wi ph (wcel A2 J) $ >
  $ wi ph (wcel B2 J) $ >
  $ wceq c_or (cfv I cjn) $ >
  $ wi ph (wceq (co A2 B2 c_or) (cun A2 B2)) $;

--| Meets in a topology are realized by intersections. (Contributed by Zhi Wang, 30-Sep-2024.)
theorem toplatmeet (ph: wff) (A2 B2 I J c_an: class):
  $ wceq I (cfv J cipo) $ >
  $ wi ph (wcel J ctop) $ >
  $ wi ph (wcel A2 J) $ >
  $ wi ph (wcel B2 J) $ >
  $ wceq c_an (cfv I cmee) $ >
  $ wi ph (wceq (co A2 B2 c_an) (cin A2 B2)) $;

--| A topology is a distributive lattice under inclusion. (Contributed by Zhi Wang, 30-Sep-2024.)
theorem topdlat (I J: class):
  $ wceq I (cfv J cipo) $ >
  $ wi (wcel J ctop) (wcel I cdlat) $;

--| The center of a ring. (Contributed by Zhi Wang, 11-Sep-2025.)
theorem elmgpcntrd {y1: setvar} (ph: wff) (B2 R M X: class) (Z: class y1):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wceq Z (cfv M ccntr) $ >
  $ wi ph (wcel X B2) $ >
  $ wi (wa ph (wcel (cv y1) B2)) (wceq (co X (cv y1) (cfv R cmulr)) (co (cv y1) X (cfv R cmulr))) $ >
  $ wi ph (wcel X Z) $;

--| Alternate proof of ~ asclelbas . (Contributed by Zhi Wang, 11-Sep-2025.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem asclelbasALT (ph: wff) (A2 B2 C F W: class):
  $ wceq A2 (cfv W cascl) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wi ph (wcel W casa) $ >
  $ wi ph (wcel C B2) $ >
  $ wi ph (wcel (cfv C A2) (cfv W cbs)) $;

--| The algebra scalar lifting function maps into the center of the algebra. Equivalently, a lifted scalar is a center of the algebra. (Contributed by Zhi Wang, 11-Sep-2025.)
theorem asclcntr (ph: wff) (A2 B2 C F M W: class):
  $ wceq A2 (cfv W cascl) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wi ph (wcel W casa) $ >
  $ wi ph (wcel C B2) $ >
  $ wceq M (cfv W cmgp) $ >
  $ wi ph (wcel (cfv C A2) (cfv M ccntr)) $;

--| Scalars are commutative after being lifted. However, the scalars themselves are not necessarily commutative if the algebra is not a faithful module. For example, Let ` F ` be the 2 by 2 upper triangular matrix algebra over a commutative ring ` W ` . It is provable that ` F ` is in general non-commutative. Define scalar multiplication ` C .x. X ` as multipying the top-left entry, which is a "vector" element of ` W ` , of the "scalar" ` C ` , which is now an upper triangular matrix, with the "vector" ` X e. ( Base `` W ) ` . Equivalently, the algebra scalar lifting function is not necessarily injective unless the algebra is faithful. Therefore, all "scalar injection" was renamed. Alternate proof involves ~ assa2ass , ~ assa2ass2 , and ~ asclval , by setting ` X ` and ` Y ` the multiplicative identity of the algebra. (Contributed by Zhi Wang, 11-Sep-2025.)
theorem asclcom (ph: wff) (A2 B2 C D F c_as W: class):
  $ wceq A2 (cfv W cascl) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wi ph (wcel W casa) $ >
  $ wi ph (wcel C B2) $ >
  $ wceq c_as (cfv F cmulr) $ >
  $ wi ph (wcel D B2) $ >
  $ wi ph (wceq (cfv (co C D c_as) A2) (cfv (co D C c_as) A2)) $;

--| The base is empty iff the functionalized Hom-set operation is empty. (Contributed by Zhi Wang, 23-Oct-2025.)
theorem homf0 (C: class):
  $ wb (wceq (cfv C cbs) c0) (wceq (cfv C chomf) c0) $;

--| Lemma for ~ catprs . (Contributed by Zhi Wang, 18-Sep-2024.)
theorem catprslem {x3 y1: setvar} (ph: wff x3 y1) (B2 H c_le: class) (X Y: class x3 y1):
  $ wi ph (wral x3 (wral y1 (wb (wbr (cv x3) (cv y1) c_le) (wne (co (cv x3) (cv y1) H) c0)) B2) B2) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wb (wbr X Y c_le) (wne (co X Y H) c0)) $;

--| A preorder can be extracted from a category. See ~ catprs2 for more details. (Contributed by Zhi Wang, 18-Sep-2024.)
theorem catprs {x3 y1: setvar} (ph: wff x3 y1) (B2: class) (C: class x3 y1) (H c_le: class) (X Y Z: class x3 y1):
  $ wi ph (wral x3 (wral y1 (wb (wbr (cv x3) (cv y1) c_le) (wne (co (cv x3) (cv y1) H) c0)) B2) B2) $ >
  $ wi ph (wceq B2 (cfv C cbs)) $ >
  $ wi ph (wceq H (cfv C chom)) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi (wa ph (w3a (wcel X B2) (wcel Y B2) (wcel Z B2))) (wa (wbr X X c_le) (wi (wa (wbr X Y c_le) (wbr Y Z c_le)) (wbr X Z c_le))) $;

--| A category equipped with the induced preorder, where an object ` x ` is defined to be "less than or equal to" ` y ` iff there is a morphism from ` x ` to ` y ` , is a preordered set, or a proset. The category might not be thin. See ~ catprsc and ~ catprsc2 for constructions satisfying the hypothesis "catprs.1". See ~ catprs for a more primitive version. See ~ prsthinc for constructing a thin category from a proset. (Contributed by Zhi Wang, 18-Sep-2024.)
theorem catprs2 {x3 y1: setvar} (ph: wff x3 y1) (B2: class) (C: class x3 y1) (H c_le: class):
  $ wi ph (wral x3 (wral y1 (wb (wbr (cv x3) (cv y1) c_le) (wne (co (cv x3) (cv y1) H) c0)) B2) B2) $ >
  $ wi ph (wceq B2 (cfv C cbs)) $ >
  $ wi ph (wceq H (cfv C chom)) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wceq c_le (cfv C cple)) $ >
  $ wi ph (wcel C cproset) $;

--| A construction of the preorder induced by a category. See ~ catprs2 for details. See also ~ catprsc2 for an alternate construction. (Contributed by Zhi Wang, 18-Sep-2024.)
theorem catprsc {x3 y1 z w: setvar} (ph: wff x3 y1) (B2: class z) (H: class z w) (c_le: class x3 y1 z w):
  $ wi ph (wceq c_le (copab x3 y1 (w3a (wcel (cv x3) B2) (wcel (cv y1) B2) (wne (co (cv x3) (cv y1) H) c0)))) $ >
  $ wi ph (wral z (wral w (wb (wbr (cv z) (cv w) c_le) (wne (co (cv z) (cv w) H) c0)) B2) B2) $;

--| An alternate construction of the preorder induced by a category. See ~ catprs2 for details. See also ~ catprsc for a different construction. The two constructions are different because ~ df-cat does not require the domain of ` H ` to be ` B X. B ` . (Contributed by Zhi Wang, 23-Sep-2024.)
theorem catprsc2 {x3 y1 z w: setvar} (ph: wff x3 y1) (B2: class x3 y1 z) (H: class z w) (c_le: class x3 y1 z w):
  $ wi ph (wceq c_le (copab x3 y1 (wne (co (cv x3) (cv y1) H) c0))) $ >
  $ wi ph (wral z (wral w (wb (wbr (cv z) (cv w) c_le) (wne (co (cv z) (cv w) H) c0)) B2) B2) $;

--| A diagonal hom-set in a category equipped with the restriction of the composition has a structure of monoid. See also ~ df-mndtc for converting a monoid to a category. Lemma for ~ bj-endmnd . (Contributed by Zhi Wang, 25-Sep-2024.)
theorem endmndlem (ph: wff) (B2 C c_x H M X: class):
  $ wceq B2 (cfv C cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wceq c_x (cfv C cco) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (co X X H) (cfv M cbs)) $ >
  $ wi ph (wceq (co (cop X X) X c_x) (cfv M cplusg)) $ >
  $ wi ph (wcel M cmnd) $;

--| An opposite category is a category. (Contributed by Zhi Wang, 23-Oct-2025.)
theorem oppccatb (ph: wff) (C O V: class):
  $ wceq O (cfv C coppc) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wb (wcel C ccat) (wcel O ccat)) $;

--| Lemma for ~ oppcmndc . Everything is true for two distinct elements in a singleton or an empty set (since it is impossible). Note that if this theorem and ~ oppcendc are in ` -. x = y ` form, then both proofs should be one step shorter. (Contributed by Zhi Wang, 16-Oct-2025.)
theorem oppcmndclem (ph ps: wff) (A2 B2 X Y: class):
  $ wi ph (wceq B2 (csn A2)) $ >
  $ wi (wa ph (wa (wcel X B2) (wcel Y B2))) (wi (wne X Y) ps) $;

--| The opposite category of a category whose morphisms are all endomorphisms has the same base and hom-sets as the original category. (Contributed by Zhi Wang, 16-Oct-2025.)
theorem oppcendc {x3 y1: setvar} (ph: wff) (B2: class) (C: class x3 y1) (H: class) (O: class x3 y1):
  $ wceq O (cfv C coppc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wi (wne (cv x3) (cv y1)) (wceq (co (cv x3) (cv y1) H) c0)) $ >
  $ wi ph (wceq (cfv C chomf) (cfv O chomf)) $;

--| The opposite category of a category whose base set is a singleton or an empty set has the same base and hom-sets as the original category. (Contributed by Zhi Wang, 16-Oct-2025.)
theorem oppcmndc (ph: wff) (B2 C O X: class):
  $ wceq O (cfv C coppc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wceq B2 (csn X)) $ >
  $ wi ph (wceq (cfv C chomf) (cfv O chomf)) $;

--| An identity arrow, or an identity morphism, is a monomorphism. (Contributed by Zhi Wang, 21-Sep-2024.)
theorem idmon (ph: wff) (B2 C c_1 H M X: class):
  $ wceq B2 (cfv C cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wceq c_1 (cfv C ccid) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel X B2) $ >
  $ wceq M (cfv C cmon) $ >
  $ wi ph (wcel (cfv X c_1) (co X X M)) $;

--| An identity arrow, or an identity morphism, is an epimorphism. (Contributed by Zhi Wang, 21-Sep-2024.)
theorem idepi (ph: wff) (B2 C c_1 E H X: class):
  $ wceq B2 (cfv C cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wceq c_1 (cfv C ccid) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel X B2) $ >
  $ wceq E (cfv C cepi) $ >
  $ wi ph (wcel (cfv X c_1) (co X X E)) $;

--| Reverse closure for section relations. (Contributed by Zhi Wang, 14-Nov-2025.)
theorem sectrcl (ph: wff) (C S F G X Y: class):
  $ wceq S (cfv C csect) $ >
  $ wi ph (wbr F G (co X Y S)) $ >
  $ wi ph (wcel C ccat) $;

--| Reverse closure for section relations. (Contributed by Zhi Wang, 14-Nov-2025.)
theorem sectrcl2 (ph: wff) (B2 C S F G X Y: class):
  $ wceq S (cfv C csect) $ >
  $ wi ph (wbr F G (co X Y S)) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wa (wcel X B2) (wcel Y B2)) $;

--| Reverse closure for inverse relations. (Contributed by Zhi Wang, 14-Nov-2025.)
theorem invrcl (ph: wff) (C F G N X Y: class):
  $ wceq N (cfv C cinv) $ >
  $ wi ph (wbr F G (co X Y N)) $ >
  $ wi ph (wcel C ccat) $;

--| Reverse closure for inverse relations. (Contributed by Zhi Wang, 14-Nov-2025.)
theorem invrcl2 (ph: wff) (B2 C F G N X Y: class):
  $ wceq N (cfv C cinv) $ >
  $ wi ph (wbr F G (co X Y N)) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wa (wcel X B2) (wcel Y B2)) $;

--| The property " ` F ` is an inverse of ` G ` ". (Contributed by Zhi Wang, 14-Nov-2025.)
theorem isinv2 (C S F G N X Y: class):
  $ wceq N (cfv C cinv) $ >
  $ wceq S (cfv C csect) $ >
  $ wb (wbr F G (co X Y N)) (wa (wbr F G (co X Y S)) (wbr G F (co Y X S))) $;

--| The predicate "is an isomorphism" (deduction form). (Contributed by Zhi Wang, 16-Sep-2025.)
theorem isisod (ph: wff) (B2 C c_x c_1 F G H I X Y: class):
  $ wceq B2 (cfv C cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wceq c_x (cfv C cco) $ >
  $ wceq I (cfv C ciso) $ >
  $ wceq c_1 (cfv C ccid) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel F (co X Y H)) $ >
  $ wi ph (wcel G (co Y X H)) $ >
  $ wi ph (wceq (co G F (co (cop X Y) X c_x)) (cfv X c_1)) $ >
  $ wi ph (wceq (co F G (co (cop Y X) Y c_x)) (cfv Y c_1)) $ >
  $ wi ph (wcel F (co X Y I)) $;

--| Lemma for ~ upeu2 . There exists a unique morphism from ` Y ` to ` Z ` that commutes if ` F : X --> Y ` is an isomorphism. (Contributed by Zhi Wang, 20-Sep-2025.)
theorem upeu2lem {k: setvar} (ph: wff) (B2: class k) (C c_x F G H: class) (I: class k) (X Y Z: class):
  $ wceq B2 (cfv C cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wceq c_x (cfv C cco) $ >
  $ wceq I (cfv C ciso) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wcel F (co X Y I)) $ >
  $ wi ph (wcel G (co X Z H)) $ >
  $ wi ph (wreu k (wceq G (co (cv k) F (co (cop X Y) Z c_x))) (co Y Z H)) $;

--| The function value of the function returning the sections of a category is a function over the Cartesian square of the base set of the category. (Contributed by Zhi Wang, 27-Oct-2025.)
theorem sectfn (C: class):
  $ wi (wcel C ccat) (wfn (cfv C csect) (cxp (cfv C cbs) (cfv C cbs))) $;

--| The function value of the function returning the inverses of a category is a function over the Cartesian square of the base set of the category. Simplifies ~ isofn (see ~ isofnALT ). (Contributed by Zhi Wang, 27-Oct-2025.)
theorem invfn (C: class):
  $ wi (wcel C ccat) (wfn (cfv C cinv) (cxp (cfv C cbs) (cfv C cbs))) $;

--| The function value of the function returning the isomorphisms of a category is a function over the Cartesian square of the base set of the category. (Contributed by AV, 5-Apr-2020.) (Proof shortened by Zhi Wang, 3-Nov-2025.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem isofnALT (C: class):
  $ wi (wcel C ccat) (wfn (cfv C ciso) (cxp (cfv C cbs) (cfv C cbs))) $;

--| Function value of the function returning the isomorphisms of a category. (Contributed by Zhi Wang, 27-Oct-2025.)
theorem isofval2 {x3 y1: setvar} (ph: wff) (B2: class) (C: class x3 y1) (I: class) (N: class x3 y1):
  $ wceq B2 (cfv C cbs) $ >
  $ wceq N (cfv C cinv) $ >
  $ wi ph (wcel C ccat) $ >
  $ wceq I (cfv C ciso) $ >
  $ wi ph (wceq I (cmpo x3 y1 B2 B2 (cdm (co (cv x3) (cv y1) N)))) $;

--| Reverse closure for isomorphism relations. (Contributed by Zhi Wang, 17-Nov-2025.)
theorem isorcl (ph: wff) (C F I X Y: class):
  $ wceq I (cfv C ciso) $ >
  $ wi ph (wcel F (co X Y I)) $ >
  $ wi ph (wcel C ccat) $;

--| Reverse closure for isomorphism relations. (Contributed by Zhi Wang, 17-Nov-2025.)
theorem isorcl2 (ph: wff) (B2 C F I X Y: class):
  $ wceq I (cfv C ciso) $ >
  $ wi ph (wcel F (co X Y I)) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wa (wcel X B2) (wcel Y B2)) $;

--| The isomorphisms are the domain of the inverse relation. (Contributed by Zhi Wang, 17-Nov-2025.)
theorem isoval2 (C I N X Y: class):
  $ wceq N (cfv C cinv) $ >
  $ wceq I (cfv C ciso) $ >
  $ wceq (co X Y I) (cdm (co X Y N)) $;

--| Lemma for ~ sectpropd . (Contributed by Zhi Wang, 27-Oct-2025.)
theorem sectpropdlem (ph: wff) (C D P: class):
  $ wi ph (wceq (cfv C chomf) (cfv D chomf)) $ >
  $ wi ph (wceq (cfv C ccomf) (cfv D ccomf)) $ >
  $ wi (wa ph (wcel P (cfv C csect))) (wcel P (cfv D csect)) $;

--| Two structures with the same base, hom-sets and composition operation have the same sections. (Contributed by Zhi Wang, 27-Oct-2025.)
theorem sectpropd (ph: wff) (C D: class):
  $ wi ph (wceq (cfv C chomf) (cfv D chomf)) $ >
  $ wi ph (wceq (cfv C ccomf) (cfv D ccomf)) $ >
  $ wi ph (wceq (cfv C csect) (cfv D csect)) $;

--| Lemma for ~ invpropd . (Contributed by Zhi Wang, 27-Oct-2025.)
theorem invpropdlem (ph: wff) (C D P: class):
  $ wi ph (wceq (cfv C chomf) (cfv D chomf)) $ >
  $ wi ph (wceq (cfv C ccomf) (cfv D ccomf)) $ >
  $ wi (wa ph (wcel P (cfv C cinv))) (wcel P (cfv D cinv)) $;

--| Two structures with the same base, hom-sets and composition operation have the same inverses. (Contributed by Zhi Wang, 27-Oct-2025.)
theorem invpropd (ph: wff) (C D: class):
  $ wi ph (wceq (cfv C chomf) (cfv D chomf)) $ >
  $ wi ph (wceq (cfv C ccomf) (cfv D ccomf)) $ >
  $ wi ph (wceq (cfv C cinv) (cfv D cinv)) $;

--| Lemma for ~ isopropd . (Contributed by Zhi Wang, 27-Oct-2025.)
theorem isopropdlem (ph: wff) (C D P: class):
  $ wi ph (wceq (cfv C chomf) (cfv D chomf)) $ >
  $ wi ph (wceq (cfv C ccomf) (cfv D ccomf)) $ >
  $ wi (wa ph (wcel P (cfv C ciso))) (wcel P (cfv D ciso)) $;

--| Two structures with the same base, hom-sets and composition operation have the same isomorphisms. (Contributed by Zhi Wang, 27-Oct-2025.)
theorem isopropd (ph: wff) (C D: class):
  $ wi ph (wceq (cfv C chomf) (cfv D chomf)) $ >
  $ wi ph (wceq (cfv C ccomf) (cfv D ccomf)) $ >
  $ wi ph (wceq (cfv C ciso) (cfv D ciso)) $;

--| ` ~=c ` is a function on ` Cat ` . (Contributed by Zhi Wang, 26-Oct-2025.)
theorem cicfn:
  $ wfn ccic ccat $;

--| Isomorphism implies the structure being a category. (Contributed by Zhi Wang, 26-Oct-2025.)
theorem cicrcl2 (C R S: class):
  $ wi (wbr R S (cfv C ccic)) (wcel C ccat) $;

--| Isomorphic objects are isomorphic in the opposite category. (Contributed by Zhi Wang, 26-Oct-2025.)
theorem oppccic (ph: wff) (C R S O: class):
  $ wceq O (cfv C coppc) $ >
  $ wi ph (wbr R S (cfv C ccic)) $ >
  $ wi ph (wbr R S (cfv O ccic)) $;

--| The set of isomorphic objects is a relation. Simplifies ~ cicer (see ~ cicerALT ). (Contributed by Zhi Wang, 27-Oct-2025.)
theorem relcic (C: class):
  $ wi (wcel C ccat) (wrel (cfv C ccic)) $;

--| Isomorphism is an equivalence relation on objects of a category. Remark 3.16 in [Adamek] p. 29. (Contributed by AV, 5-Apr-2020.) (Proof shortened by Zhi Wang, 3-Nov-2025.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem cicerALT (C: class):
  $ wi (wcel C ccat) (wer (cfv C cbs) (cfv C ccic)) $;

--| Reconstruction of a pair of isomorphic objects in terms of its ordered pair components. (Contributed by Zhi Wang, 27-Oct-2025.)
theorem cic1st2nd (C P: class):
  $ wi (wcel P (cfv C ccic)) (wceq P (cop (cfv P c1st) (cfv P c2nd))) $;

--| Rewrite the predicate of isomorphic objects with separated parts. (Contributed by Zhi Wang, 27-Oct-2025.)
theorem cic1st2ndbr (C P: class):
  $ wi (wcel P (cfv C ccic)) (wbr (cfv P c1st) (cfv P c2nd) (cfv C ccic)) $;

--| Lemma for ~ cicpropd . (Contributed by Zhi Wang, 27-Oct-2025.)
theorem cicpropdlem (ph: wff) (C D P: class):
  $ wi ph (wceq (cfv C chomf) (cfv D chomf)) $ >
  $ wi ph (wceq (cfv C ccomf) (cfv D ccomf)) $ >
  $ wi (wa ph (wcel P (cfv C ccic))) (wcel P (cfv D ccic)) $;

--| Two structures with the same base, hom-sets and composition operation have the same isomorphic objects. (Contributed by Zhi Wang, 27-Oct-2025.)
theorem cicpropd (ph: wff) (C D: class):
  $ wi ph (wceq (cfv C chomf) (cfv D chomf)) $ >
  $ wi ph (wceq (cfv C ccomf) (cfv D ccomf)) $ >
  $ wi ph (wceq (cfv C ccic) (cfv D ccic)) $;

--| Isomorphic objects are isomorphic in the opposite category. (Contributed by Zhi Wang, 27-Oct-2025.)
theorem oppccicb (C R S O: class):
  $ wceq O (cfv C coppc) $ >
  $ wb (wbr R S (cfv C ccic)) (wbr R S (cfv O ccic)) $;

--| The opposite category has the same isomorphic objects as the original category. (Contributed by Zhi Wang, 27-Oct-2025.)
theorem oppcciceq (C O: class):
  $ wceq O (cfv C coppc) $ >
  $ wceq (cfv C ccic) (cfv O ccic) $;

--| The double domain of a function on a Cartesian square. (Contributed by Zhi Wang, 1-Nov-2025.)
theorem dmdm (A2 B2: class):
  $ wi (wfn A2 (cxp B2 B2)) (wceq B2 (cdm (cdm A2))) $;

--| Lemma for ~ iinfssc . (Contributed by Zhi Wang, 31-Oct-2025.)
theorem iinfssclem1 {x3 y1 z w: setvar} (ph: wff x3 y1 z w) (A2: class) (S H: class x3) (J K: class x3 y1 z w):
  $ wi ph (wne A2 c0) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wbr H J cssc) $ >
  $ wi ph (wceq K (cmpt y1 (ciin x3 A2 (cdm H)) (ciin x3 A2 (cfv (cv y1) H)))) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wceq S (cdm (cdm H))) $ >
  $ wnf x3 ph $ >
  $ wi ph (wceq K (cmpo z w (ciin x3 A2 S) (ciin x3 A2 S) (ciin x3 A2 (co (cv z) (cv w) H)))) $;

--| Lemma for ~ iinfssc . (Contributed by Zhi Wang, 31-Oct-2025.)
theorem iinfssclem2 {x3 y1: setvar} (ph: wff x3 y1) (A2: class) (S H: class x3) (J K: class x3 y1):
  $ wi ph (wne A2 c0) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wbr H J cssc) $ >
  $ wi ph (wceq K (cmpt y1 (ciin x3 A2 (cdm H)) (ciin x3 A2 (cfv (cv y1) H)))) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wceq S (cdm (cdm H))) $ >
  $ wnf x3 ph $ >
  $ wi ph (wfn K (cxp (ciin x3 A2 S) (ciin x3 A2 S))) $;

--| Lemma for ~ iinfssc . (Contributed by Zhi Wang, 31-Oct-2025.)
theorem iinfssclem3 {x3 y1: setvar} (ph: wff x3 y1) (A2: class) (S H: class x3) (J K: class x3 y1) (X Y: class y1):
  $ wi ph (wne A2 c0) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wbr H J cssc) $ >
  $ wi ph (wceq K (cmpt y1 (ciin x3 A2 (cdm H)) (ciin x3 A2 (cfv (cv y1) H)))) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wceq S (cdm (cdm H))) $ >
  $ wnf x3 ph $ >
  $ wi ph (wcel X (ciin x3 A2 S)) $ >
  $ wi ph (wcel Y (ciin x3 A2 S)) $ >
  $ wi ph (wceq (co X Y K) (ciin x3 A2 (co X Y H))) $;

--| Indexed intersection of subcategories is a subcategory (the category-agnostic version). (Contributed by Zhi Wang, 31-Oct-2025.)
theorem iinfssc {x3 y1: setvar} (ph: wff) (A2: class) (H: class x3) (J: class y1) (K: class x3 y1):
  $ wi ph (wne A2 c0) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wbr H J cssc) $ >
  $ wi ph (wceq K (cmpt y1 (ciin x3 A2 (cdm H)) (ciin x3 A2 (cfv (cv y1) H)))) $ >
  $ wi ph (wbr K J cssc) $;

--| Indexed intersection of subcategories is a subcategory. (Contributed by Zhi Wang, 31-Oct-2025.)
theorem iinfsubc {x3 y1: setvar} (ph: wff) (A2: class) (C: class y1) (H: class x3) (K: class x3 y1):
  $ wi ph (wne A2 c0) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel H (cfv C csubc)) $ >
  $ wi ph (wceq K (cmpt y1 (ciin x3 A2 (cdm H)) (ciin x3 A2 (cfv (cv y1) H)))) $ >
  $ wi ph (wcel K (cfv C csubc)) $;

--| Indexed intersection of functions with an unordered pair index. (Contributed by Zhi Wang, 31-Oct-2025.)
theorem iinfprg {x3 y1: setvar} (A2 B2: class) (V W: class y1):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wceq (cmpt x3 (cin (cdm A2) (cdm B2)) (cin (cfv (cv x3) A2) (cfv (cv x3) B2))) (cmpt x3 (ciin y1 (cpr A2 B2) (cdm (cv y1))) (ciin y1 (cpr A2 B2) (cfv (cv x3) (cv y1))))) $;

--| The intersection of two subcategories is a subcategory. (Contributed by Zhi Wang, 31-Oct-2025.)
theorem infsubc {x3: setvar} (A2 B2 C: class):
  $ wi (wa (wcel A2 (cfv C csubc)) (wcel B2 (cfv C csubc))) (wcel (cmpt x3 (cin (cdm A2) (cdm B2)) (cin (cfv (cv x3) A2) (cfv (cv x3) B2))) (cfv C csubc)) $;

--| The intersection of two subcategories is a subcategory. (Contributed by Zhi Wang, 31-Oct-2025.)
theorem infsubc2 {x3 y1: setvar} (A2 B2 C: class):
  $ wi (wa (wcel A2 (cfv C csubc)) (wcel B2 (cfv C csubc))) (wcel (cmpo x3 y1 (cin (cdm (cdm A2)) (cdm (cdm B2))) (cin (cdm (cdm A2)) (cdm (cdm B2))) (cin (co (cv x3) (cv y1) A2) (co (cv x3) (cv y1) B2))) (cfv C csubc)) $;

--| The intersection of two subcategories is a subcategory. (Contributed by Zhi Wang, 31-Oct-2025.)
theorem infsubc2d {x3 y1: setvar} (ph: wff x3 y1) (C S T H J: class):
  $ wi ph (wfn H (cxp S S)) $ >
  $ wi ph (wfn J (cxp T T)) $ >
  $ wi ph (wcel H (cfv C csubc)) $ >
  $ wi ph (wcel J (cfv C csubc)) $ >
  $ wi ph (wcel (cmpo x3 y1 (cin S T) (cin S T) (cin (co (cv x3) (cv y1) H) (co (cv x3) (cv y1) J))) (cfv C csubc)) $;

--| Lemma for ~ discsubc . (Contributed by Zhi Wang, 1-Nov-2025.)
theorem discsubclem {x3 y1: setvar} (S: class) (I J: class x3 y1):
  $ wceq J (cmpo x3 y1 S S (cif (wceq (cv x3) (cv y1)) (csn (cfv (cv x3) I)) c0)) $ >
  $ wfn J (cxp S S) $;

--| A discrete category, whose only morphisms are the identity morphisms, is a subcategory. (Contributed by Zhi Wang, 1-Nov-2025.)
theorem discsubc {x3 y1: setvar} (ph: wff x3 y1) (B2 C: class x3 y1) (S I: class) (J: class x3 y1):
  $ wceq J (cmpo x3 y1 S S (cif (wceq (cv x3) (cv y1)) (csn (cfv (cv x3) I)) c0)) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq I (cfv C ccid) $ >
  $ wi ph (wss S B2) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel J (cfv C csubc)) $;

--| Lemma for ~ iinfconstbas . (Contributed by Zhi Wang, 1-Nov-2025.)
theorem iinfconstbaslem {x3 y1 j: setvar} (ph: wff x3 y1 j) (A2 B2 C: class x3 y1 j) (S: class) (I: class j) (J: class x3 y1):
  $ wceq J (cmpo x3 y1 S S (cif (wceq (cv x3) (cv y1)) (csn (cfv (cv x3) I)) c0)) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq I (cfv C ccid) $ >
  $ wi ph (wss S B2) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wceq A2 (cin (cfv C csubc) (cab j (wfn (cv j) (cxp S S))))) $ >
  $ wi ph (wcel J A2) $;

--| The discrete category is the indexed intersection of all subcategories with the same base. (Contributed by Zhi Wang, 1-Nov-2025.)
theorem iinfconstbas {x3 y1 z h j: setvar} (ph: wff z j) (A2: class j) (B2 C: class x3 y1 z h j) (S: class) (I: class z j) (J: class x3 y1 z):
  $ wceq J (cmpo x3 y1 S S (cif (wceq (cv x3) (cv y1)) (csn (cfv (cv x3) I)) c0)) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq I (cfv C ccid) $ >
  $ wi ph (wss S B2) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wceq A2 (cin (cfv C csubc) (cab j (wfn (cv j) (cxp S S))))) $ >
  $ wi ph (wceq J (cmpt z (ciin h A2 (cdm (cv h))) (ciin h A2 (cfv (cv z) (cv h))))) $;

--| Lemma for ~ nelsubc . (Contributed by Zhi Wang, 5-Nov-2025.)
theorem nelsubclem {x3 y1 z f2: setvar} (ph: wff f2) (ps: wff x3 y1 z f2) (B2 C: class x3 y1 z f2) (S: class f2) (H I: class x3 y1 z f2) (J: class x3 y1 z):
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wss S B2) $ >
  $ wi ph (wne S c0) $ >
  $ wi ph (wceq J (cxp (cxp S S) (csn c0))) $ >
  $ wceq H (cfv C chomf) $ >
  $ wi ph (wa (wfn J (cxp S S)) (wa (wbr J H cssc) (wa (wn (wral x3 (wcel I (co (cv x3) (cv x3) J)) S)) (wral x3 (wral y1 (wral z (wral f2 ps (co (cv x3) (cv y1) J)) S) S) S)))) $;

--| An empty "hom-set" for non-empty base satisfies all conditions for a subcategory but the existence of identity morphisms. (Contributed by Zhi Wang, 5-Nov-2025.)
theorem nelsubc {x3 y1 z f2 g2: setvar} (ph: wff f2 g2) (B2 C: class x3 y1 z f2 g2) (S: class f2 g2) (c_x c_1 H: class x3 y1 z f2 g2) (J: class x3 y1 z g2):
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wss S B2) $ >
  $ wi ph (wne S c0) $ >
  $ wi ph (wceq J (cxp (cxp S S) (csn c0))) $ >
  $ wceq H (cfv C chomf) $ >
  $ wceq c_1 (cfv C ccid) $ >
  $ wceq c_x (cfv C cco) $ >
  $ wi ph (wa (wfn J (cxp S S)) (wa (wbr J H cssc) (wa (wn (wral x3 (wcel (cfv (cv x3) c_1) (co (cv x3) (cv x3) J)) S)) (wral x3 (wral y1 (wral z (wral f2 (wral g2 (wcel (co (cv g2) (cv f2) (co (cop (cv x3) (cv y1)) (cv z) c_x)) (co (cv x3) (cv z) J)) (co (cv y1) (cv z) J)) (co (cv x3) (cv y1) J)) S) S) S)))) $;

--| An empty "hom-set" for non-empty base is not a subcategory. (Contributed by Zhi Wang, 5-Nov-2025.)
theorem nelsubc2 (ph: wff) (B2 C S J: class):
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wss S B2) $ >
  $ wi ph (wne S c0) $ >
  $ wi ph (wceq J (cxp (cxp S S) (csn c0))) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wn (wcel J (cfv C csubc))) $;

--| Lemma for ~ nelsubc3 . (Contributed by Zhi Wang, 5-Nov-2025.)
theorem nelsubc3lem {x3 y1 z f2 g2 j s1 c: setvar} (C: class) (S: class f2 g2 j c) (J: class c):
  $ wcel C ccat $ >
  $ wcel J cvv $ >
  $ wcel S cvv $ >
  $ wa (wfn J (cxp S S)) (wa (wbr J (cfv C chomf) cssc) (wa (wn (wral x3 (wcel (cfv (cv x3) (cfv C ccid)) (co (cv x3) (cv x3) J)) S)) (wral x3 (wral y1 (wral z (wral f2 (wral g2 (wcel (co (cv g2) (cv f2) (co (cop (cv x3) (cv y1)) (cv z) (cfv C cco))) (co (cv x3) (cv z) J)) (co (cv y1) (cv z) J)) (co (cv x3) (cv y1) J)) S) S) S))) $ >
  $ wrex c (wex j (wex s1 (wa (wfn (cv j) (cxp (cv s1) (cv s1))) (wa (wbr (cv j) (cfv (cv c) chomf) cssc) (wa (wn (wral x3 (wcel (cfv (cv x3) (cfv (cv c) ccid)) (co (cv x3) (cv x3) (cv j))) (cv s1))) (wral x3 (wral y1 (wral z (wral f2 (wral g2 (wcel (co (cv g2) (cv f2) (co (cop (cv x3) (cv y1)) (cv z) (cfv (cv c) cco))) (co (cv x3) (cv z) (cv j))) (co (cv y1) (cv z) (cv j))) (co (cv x3) (cv y1) (cv j))) (cv s1)) (cv s1)) (cv s1))))))) ccat $;

--| Remark 4.2(2) of [Adamek] p. 48. There exists a set satisfying all conditions for a subcategory but the existence of identity morphisms. Therefore such condition in ~ df-subc is necessary. Note that this theorem cheated a little bit because ` ( C |``cat J ) ` is not a category. In fact ` ( C |``cat J ) e. Cat ` is a stronger statement than the condition (d) of Definition 4.1(1) of [Adamek] p. 48, as stated here (see the proof of ~ issubc3 ). To construct such a category, see ~ setc1onsubc and ~ cnelsubc . (Contributed by Zhi Wang, 5-Nov-2025.)
theorem nelsubc3 {x3 y1 z f2 g2 j s1 c: setvar}:
  $ wrex c (wex j (wex s1 (wa (wfn (cv j) (cxp (cv s1) (cv s1))) (wa (wbr (cv j) (cfv (cv c) chomf) cssc) (wa (wn (wral x3 (wcel (cfv (cv x3) (cfv (cv c) ccid)) (co (cv x3) (cv x3) (cv j))) (cv s1))) (wral x3 (wral y1 (wral z (wral f2 (wral g2 (wcel (co (cv g2) (cv f2) (co (cop (cv x3) (cv y1)) (cv z) (cfv (cv c) cco))) (co (cv x3) (cv z) (cv j))) (co (cv y1) (cv z) (cv j))) (co (cv x3) (cv y1) (cv j))) (cv s1)) (cv s1)) (cv s1))))))) ccat $;

--| A category ` C ` restricted by ` J ` is a category if all of the following are satisfied: a) the base is a subset of base of ` C ` , b) all hom-sets are subsets of hom-sets of ` C ` , c) it has identity morphisms for all objects, d) the composition under ` C ` is closed in ` J ` . But ` J ` might not be a subcategory of ` C ` (see ~ cnelsubc ). (Contributed by Zhi Wang, 6-Nov-2025.)
theorem ssccatid {x3 y1 z f2 g2 m a b: setvar} (ph: wff) (C: class x3 y1 z f2 g2 m a b) (D: class x3 f2 m a b) (S c_x: class) (c_1: class y1) (H: class x3 y1 z f2 g2 m a b) (J: class):
  $ wceq H (cfv C chomf) $ >
  $ wceq D (co C J cresc) $ >
  $ wceq c_x (cfv C cco) $ >
  $ wi ph (wbr J H cssc) $ >
  $ wi ph (wfn J (cxp S S)) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi (wa ph (wcel (cv y1) S)) (wcel c_1 (co (cv y1) (cv y1) J)) $ >
  $ wi (wa ph (w3a (wcel (cv a) S) (wcel (cv b) S) (wcel (cv m) (co (cv a) (cv b) J)))) (wceq (co c_1 (cv m) (co (cop (cv a) (cv b)) (cv b) c_x)) (cv m)) $ >
  $ wi (wa ph (w3a (wcel (cv a) S) (wcel (cv b) S) (wcel (cv m) (co (cv a) (cv b) J)))) (wceq (co (cv m) c_1 (co (cop (cv a) (cv a)) (cv b) c_x)) (cv m)) $ >
  $ wi (w3a ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S)) (wa (wcel (cv f2) (co (cv x3) (cv y1) J)) (wcel (cv g2) (co (cv y1) (cv z) J)))) (wcel (co (cv g2) (cv f2) (co (cop (cv x3) (cv y1)) (cv z) c_x)) (co (cv x3) (cv z) J)) $ >
  $ wi ph (wa (wcel D ccat) (wceq (cfv D ccid) (cmpt y1 S c_1))) $;

--| Lemma for ~ resccat . (Contributed by Zhi Wang, 6-Nov-2025.)
theorem resccatlem {x3 y1 z f2 g2: setvar} (ph: wff) (B2 C: class x3 y1 z f2 g2) (D S: class) (c_xb: class z) (c_x U: class x3 y1 z f2 g2) (E: class x3 y1) (J: class x3 y1 z f2) (V: class x3 y1 z f2 g2):
  $ wceq D (co C J cresc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq S (cfv E cbs) $ >
  $ wceq J (cfv E chomf) $ >
  $ wceq c_x (cfv C cco) $ >
  $ wceq c_xb (cfv E cco) $ >
  $ wi (wa (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wa (wcel (cv f2) (co (cv x3) (cv y1) J)) (wcel (cv g2) (co (cv y1) (cv z) J)))) (wceq (co (cv g2) (cv f2) (co (cop (cv x3) (cv y1)) (cv z) c_x)) (co (cv g2) (cv f2) (co (cop (cv x3) (cv y1)) (cv z) c_xb))) $ >
  $ wi ph (wcel E V) $ >
  $ wi ph (wss S B2) $ >
  $ wi ph (wcel C U) $ >
  $ wi ph (wb (wcel D ccat) (wcel E ccat)) $;

--| A class ` C ` restricted by the hom-sets of another set ` E ` , whose base is a subset of the base of ` C ` and whose composition is compatible with ` C ` , is a category iff ` E ` is a category. Note that the compatibility condition "resccat.1" can be weakened by removing ` x e. S ` because ` f e. ( x J y ) ` implies these. (Contributed by Zhi Wang, 6-Nov-2025.)
theorem resccat {x3 y1 z f2 g2: setvar} (ph: wff) (B2: class x3 y1 z f2 g2) (C D S: class) (c_xb: class z) (c_x: class x3 y1 z f2 g2) (E: class x3 y1) (J: class x3 y1 z f2) (V: class x3 y1 z f2 g2):
  $ wceq D (co C J cresc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq S (cfv E cbs) $ >
  $ wceq J (cfv E chomf) $ >
  $ wceq c_x (cfv C cco) $ >
  $ wceq c_xb (cfv E cco) $ >
  $ wi (wa (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wa (wcel (cv f2) (co (cv x3) (cv y1) J)) (wcel (cv g2) (co (cv y1) (cv z) J)))) (wceq (co (cv g2) (cv f2) (co (cop (cv x3) (cv y1)) (cv z) c_x)) (co (cv g2) (cv f2) (co (cop (cv x3) (cv y1)) (cv z) c_xb))) $ >
  $ wi ph (wcel E V) $ >
  $ wi ph (wss S B2) $ >
  $ wi ph (wb (wcel D ccat) (wcel E ccat)) $;

--| The domain of ` Func ` is a relation. (Contributed by Zhi Wang, 12-Nov-2025.)
theorem reldmfunc:
  $ wrel (cdm cfunc) $;

--| Rewrite the functor predicate with separated parts. (Contributed by Zhi Wang, 19-Oct-2025.)
theorem func1st2nd (ph: wff) (C D F: class):
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wbr (cfv F c1st) (cfv F c2nd) (co C D cfunc)) $;

--| Extract the first member of a functor. (Contributed by Zhi Wang, 15-Nov-2025.)
theorem func1st (ph: wff) (C D F G: class):
  $ wi ph (wbr F G (co C D cfunc)) $ >
  $ wi ph (wceq (cfv (cop F G) c1st) F) $;

--| Extract the second member of a functor. (Contributed by Zhi Wang, 15-Nov-2025.)
theorem func2nd (ph: wff) (C D F G: class):
  $ wi ph (wbr F G (co C D cfunc)) $ >
  $ wi ph (wceq (cfv (cop F G) c2nd) G) $;

--| Reverse closure for a functor. (Contributed by Zhi Wang, 17-Sep-2025.)
theorem funcrcl2 (ph: wff) (D E F G: class):
  $ wi ph (wbr F G (co D E cfunc)) $ >
  $ wi ph (wcel D ccat) $;

--| Reverse closure for a functor. (Contributed by Zhi Wang, 17-Sep-2025.)
theorem funcrcl3 (ph: wff) (D E F G: class):
  $ wi ph (wbr F G (co D E cfunc)) $ >
  $ wi ph (wcel E ccat) $;

--| A utility theorem for proving equivalence of "is a functor". (Contributed by Zhi Wang, 1-Oct-2024.)
theorem funcf2lem {x3 y1 z: setvar} (B2 F G H J: class):
  $ wb (wcel G (cixp z (cxp B2 B2) (co (co (cfv (cfv (cv z) c1st) F) (cfv (cfv (cv z) c2nd) F) J) (cfv (cv z) H) cmap))) (w3a (wcel G cvv) (wfn G (cxp B2 B2)) (wral x3 (wral y1 (wf (co (cv x3) (cv y1) H) (co (cfv (cv x3) F) (cfv (cv y1) F) J) (co (cv x3) (cv y1) G)) B2) B2)) $;

--| A utility theorem for proving equivalence of "is a functor". (Contributed by Zhi Wang, 25-Sep-2025.)
theorem funcf2lem2 {x3 y1 z: setvar} (B2: class) (C E: class x3 y1 z) (F G H J: class):
  $ wceq B2 (cfv C E) $ >
  $ wb (wcel G (cixp z (cxp B2 B2) (co (co (cfv (cfv (cv z) c1st) F) (cfv (cfv (cv z) c2nd) F) J) (cfv (cv z) H) cmap))) (wa (wfn G (cxp B2 B2)) (wral x3 (wral y1 (wf (co (cv x3) (cv y1) H) (co (cfv (cv x3) F) (cfv (cv y1) F) J) (co (cv x3) (cv y1) G)) B2) B2)) $;

--| A member of an indexed product of function spaces has the indicated function type at each pair of indices. Hom-functions of a functor are one application. (Contributed by Zhi Wang, 14-Sep-2026.)
theorem ixpovf {z: setvar} (ph: wff z) (P U H N O V W: class):
  $ wi ph (wcel P (cixp z (cxp W W) (co (co (cfv (cfv (cv z) c1st) O) (cfv (cfv (cv z) c2nd) O) N) (cfv (cv z) H) cmap))) $ >
  $ wi ph (wcel U W) $ >
  $ wi ph (wcel V W) $ >
  $ wi ph (wf (co U V H) (co (cfv U O) (cfv V O) N) (co U V P)) $;

--| Lemma for ~ 0funcg . (Contributed by Zhi Wang, 17-Oct-2025.)
theorem _0funcglem (ph ps ch th ta et ze: wff):
  $ wi ph (wb ps (w3a ch th ta)) $ >
  $ wi ph (wb ch et) $ >
  $ wi ph (wb th ze) $ >
  $ wi ph ta $ >
  $ wi ph (wb ps (wa et ze)) $;

--| The functor from the empty category. (Contributed by Zhi Wang, 17-Oct-2025.)
theorem _0funcg2 (ph: wff) (C D F G V: class):
  $ wi ph (wcel C V) $ >
  $ wi ph (wceq c0 (cfv C cbs)) $ >
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wb (wbr F G (co C D cfunc)) (wa (wceq F c0) (wceq G c0))) $;

--| The functor from the empty category. Corollary of Definition 3.47 of [Adamek] p. 40, Definition 7.1 of [Adamek] p. 101, Example 3.3(4.c) of [Adamek] p. 24, and Example 7.2(3) of [Adamek] p. 101. (Contributed by Zhi Wang, 17-Oct-2025.)
theorem _0funcg (ph: wff) (C D V: class):
  $ wi ph (wcel C V) $ >
  $ wi ph (wceq c0 (cfv C cbs)) $ >
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wceq (co C D cfunc) (csn (cop c0 c0))) $;

--| Lemma for ~ 0funcALT . (Contributed by Zhi Wang, 7-Oct-2025.)
theorem _0funclem (ph ps ch th ta et ze: wff):
  $ wi ph (wb ps (w3a ch th ta)) $ >
  $ wb ch et $ >
  $ wb th ze $ >
  $ ta $ >
  $ wi ph (wb ps (wa et ze)) $;

--| The functor from the empty category. (Contributed by Zhi Wang, 7-Oct-2025.) (Proof shortened by Zhi Wang, 17-Oct-2025.)
theorem _0func (ph: wff) (C: class):
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wceq (co c0 C cfunc) (csn (cop c0 c0))) $;

--| Alternate proof of ~ 0func . (Contributed by Zhi Wang, 7-Oct-2025.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem _0funcALT (ph: wff) (C: class):
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wceq (co c0 C cfunc) (csn (cop c0 c0))) $;

--| The source category of a functor to the empty category must be empty as well. (Contributed by Zhi Wang, 19-Oct-2025.)
theorem func0g (ph: wff) (A2 B2 C D F G: class):
  $ wceq A2 (cfv C cbs) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wceq B2 c0) $ >
  $ wi ph (wbr F G (co C D cfunc)) $ >
  $ wi ph (wceq A2 c0) $;

--| The source category of a functor to the empty category must be empty as well. (Contributed by Zhi Wang, 19-Oct-2025.)
theorem func0g2 (ph: wff) (A2 B2 C D F: class):
  $ wceq A2 (cfv C cbs) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wceq B2 c0) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wceq A2 c0) $;

--| Sets with empty base are the only initial objects in the category of small categories. Example 7.2(3) of [Adamek] p. 101. (Contributed by Zhi Wang, 15-Nov-2025.)
theorem initc {f2 d: setvar} (C: class):
  $ wb (wa (wcel C cvv) (wceq c0 (cfv C cbs))) (wral d (weu f2 (wcel (cv f2) (co C (cv d) cfunc))) ccat) $;

--| Rewrite the functor composition with separated functor parts. (Contributed by Zhi Wang, 15-Nov-2025.)
theorem cofu1st2nd (ph: wff) (C D E F G: class):
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wcel G (co D E cfunc)) $ >
  $ wi ph (wceq (co G F ccofu) (co (cop (cfv G c1st) (cfv G c2nd)) (cop (cfv F c1st) (cfv F c2nd)) ccofu)) $;

--| The restriction of functor composition is a function from product functor space to functor space. (Contributed by Zhi Wang, 25-Sep-2025.)
theorem rescofuf (C D E: class):
  $ wf (cxp (co D E cfunc) (co C D cfunc)) (co C E cfunc) (cres ccofu (cxp (co D E cfunc) (co C D cfunc))) $;

--| Value of the object part of the functor composition. (Contributed by Zhi Wang, 16-Nov-2025.)
theorem cofu1a (ph: wff) (B2 C D E F G K L M N X: class):
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wbr F G (co C D cfunc)) $ >
  $ wi ph (wbr K L (co D E cfunc)) $ >
  $ wi ph (wceq (co (cop K L) (cop F G) ccofu) (cop M N)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (cfv (cfv X F) K) (cfv X M)) $;

--| Value of the morphism part of the functor composition. (Contributed by Zhi Wang, 16-Nov-2025.)
theorem cofu2a (ph: wff) (B2 C D R E F G H K L M N X Y: class):
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wbr F G (co C D cfunc)) $ >
  $ wi ph (wbr K L (co D E cfunc)) $ >
  $ wi ph (wceq (co (cop K L) (cop F G) ccofu) (cop M N)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wcel R (co X Y H)) $ >
  $ wi ph (wceq (cfv (cfv R (co X Y G)) (co (cfv X F) (cfv Y F) L)) (cfv R (co X Y N))) $;

--| The composition of two functors is a functor. Proposition 3.23 of [Adamek] p. 33. (Contributed by Zhi Wang, 16-Nov-2025.)
theorem cofucla (ph: wff) (C D E F G K L: class):
  $ wi ph (wbr F G (co C D cfunc)) $ >
  $ wi ph (wbr K L (co D E cfunc)) $ >
  $ wi ph (wcel (co (cop K L) (cop F G) ccofu) (co C E cfunc)) $;

--| Post-composition by an object-fixing functor preserves the entire object function, including its exact domain. (Contributed by Zhi Wang, 14-Sep-2026.) (Revised by Zhi Wang, 17-Sep-2026.)
theorem cofu1stfix (ph: wff) (A2 D E F K: class):
  $ wceq A2 (cfv E cbs) $ >
  $ wi ph (wcel F (co D E cfunc)) $ >
  $ wi ph (wcel K (co E E cfunc)) $ >
  $ wi ph (wceq (cfv K c1st) (cres cid A2)) $ >
  $ wi ph (wceq (cfv (co K F ccofu) c1st) (cfv F c1st)) $;

--| Source categories of a functor have the same set of objects and morphisms. (Contributed by Zhi Wang, 10-Nov-2025.)
theorem funchomf (ph: wff) (A2 B2 C D F G: class):
  $ wi ph (wbr F G (co A2 C cfunc)) $ >
  $ wi ph (wbr F G (co B2 D cfunc)) $ >
  $ wi ph (wceq (cfv A2 chomf) (cfv B2 chomf)) $;

--| Reverse closure for an identity functor. (Contributed by Zhi Wang, 10-Nov-2025.)
theorem idfurcl (C D E: class):
  $ wi (wcel (cfv C cidfu) (co D E cfunc)) (wcel C ccat) $;

--| The identity functor/inclusion functor is bijective on objects. (Contributed by Zhi Wang, 16-Nov-2025.)
theorem idfu1stf1o (B2 C I: class):
  $ wceq I (cfv C cidfu) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi (wcel C ccat) (wf1o B2 B2 (cfv I c1st)) $;

--| Lemma for ~ idfu1sta . (Contributed by Zhi Wang, 10-Nov-2025.)
theorem idfu1stalem (ph: wff) (B2 C D E I: class):
  $ wceq I (cfv C cidfu) $ >
  $ wi ph (wcel I (co D E cfunc)) $ >
  $ wi ph (wceq B2 (cfv D cbs)) $ >
  $ wi ph (wceq B2 (cfv C cbs)) $;

--| Value of the object part of the identity functor. (Contributed by Zhi Wang, 10-Nov-2025.)
theorem idfu1sta (ph: wff) (B2 C D E I: class):
  $ wceq I (cfv C cidfu) $ >
  $ wi ph (wcel I (co D E cfunc)) $ >
  $ wi ph (wceq B2 (cfv D cbs)) $ >
  $ wi ph (wceq (cfv I c1st) (cres cid B2)) $;

--| Value of the object part of the identity functor. (Contributed by Zhi Wang, 10-Nov-2025.)
theorem idfu1a (ph: wff) (B2 C D E I X: class):
  $ wceq I (cfv C cidfu) $ >
  $ wi ph (wcel I (co D E cfunc)) $ >
  $ wi ph (wceq B2 (cfv D cbs)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (cfv X (cfv I c1st)) X) $;

--| Value of the morphism part of the identity functor. (Contributed by Zhi Wang, 10-Nov-2025.)
theorem idfu2nda (ph: wff) (B2 C D E H I X Y: class):
  $ wceq I (cfv C cidfu) $ >
  $ wi ph (wcel I (co D E cfunc)) $ >
  $ wi ph (wceq B2 (cfv D cbs)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq H (co X Y (cfv D chom))) $ >
  $ wi ph (wceq (co X Y (cfv I c2nd)) (cres cid H)) $;

--| Lemma for ~ imasubc . (Contributed by Zhi Wang, 6-Nov-2025.)
theorem imasubclem1 {x3: setvar} (ph: wff x3) (A2 B2: class) (C D: class x3) (F G: class) (H V W: class x3):
  $ wi ph (wcel F V) $ >
  $ wi ph (wcel G W) $ >
  $ wi ph (wcel (ciun x3 (cxp (cima (ccnv F) A2) (cima (ccnv G) B2)) (cima (cfv C H) D)) cvv) $;

--| Lemma for ~ imasubc . (Contributed by Zhi Wang, 7-Nov-2025.)
theorem imasubclem2 {x3 y1 z: setvar} (ph: wff x3) (A2 B2: class y1 z) (C D: class x3 y1 z) (F G: class y1 z) (H K V W: class x3 y1 z) (X Y: class x3):
  $ wi ph (wcel F V) $ >
  $ wi ph (wcel G W) $ >
  $ wceq K (cmpo y1 z X Y (ciun x3 (cxp (cima (ccnv F) A2) (cima (ccnv G) B2)) (cima (cfv C H) D))) $ >
  $ wi ph (wfn K (cxp X Y)) $;

--| Lemma for ~ imasubc . (Contributed by Zhi Wang, 7-Nov-2025.)
theorem imasubclem3 {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2 B2 C D: class z) (F G: class) (H: class z) (K V W: class x3 y1 z) (X Y: class):
  $ wi ph (wcel F V) $ >
  $ wi ph (wcel G W) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq K (cmpo x3 y1 A2 B2 (ciun z (cxp (cima (ccnv F) (csn (cv x3))) (cima (ccnv G) (csn (cv y1)))) (cima (cfv C H) D))) $ >
  $ wi ph (wceq (co X Y K) (ciun z (cxp (cima (ccnv F) (csn X)) (cima (ccnv G) (csn Y))) (cima (cfv C H) D))) $;

--| Lemma for ~ imaf1hom and other theorems. (Contributed by Zhi Wang, 7-Nov-2025.)
theorem imaf1homlem (ph: wff) (A2 B2 C S F X: class):
  $ wceq S (cima F A2) $ >
  $ wi ph (wf1 B2 C F) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (w3a (wceq (csn (cfv X (ccnv F))) (cima (ccnv F) (csn X))) (wceq (cfv (cfv X (ccnv F)) F) X) (wcel (cfv X (ccnv F)) B2)) $;

--| The hom-set of an image of a functor injective on objects. (Contributed by Zhi Wang, 7-Nov-2025.)
theorem imaf1hom {x3 y1 p: setvar} (ph: wff x3 y1 p) (A2 B2 C: class x3 y1 p) (S: class p) (F G H: class) (K V: class x3 y1 p) (X Y: class):
  $ wceq S (cima F A2) $ >
  $ wi ph (wf1 B2 C F) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wcel Y S) $ >
  $ wi ph (wcel F V) $ >
  $ wceq K (cmpo x3 y1 S S (ciun p (cxp (cima (ccnv F) (csn (cv x3))) (cima (ccnv F) (csn (cv y1)))) (cima (cfv (cv p) G) (cfv (cv p) H)))) $ >
  $ wi ph (wceq (co X Y K) (cima (co (cfv X (ccnv F)) (cfv Y (ccnv F)) G) (co (cfv X (ccnv F)) (cfv Y (ccnv F)) H))) $;

--| Lemma for ~ imaidfu2 . (Contributed by Zhi Wang, 10-Nov-2025.)
theorem imaidfu2lem (ph: wff) (C D E I: class):
  $ wceq I (cfv C cidfu) $ >
  $ wi ph (wcel I (co D E cfunc)) $ >
  $ wi ph (wceq (cima (cfv I c1st) (cfv D cbs)) (cfv D cbs)) $;

--| The image of the identity functor. (Contributed by Zhi Wang, 10-Nov-2025.)
theorem imaidfu {x3 y1 p: setvar} (ph: wff p) (A2 C D: class x3 y1 p) (S: class p) (E: class x3 y1 p) (H I: class) (J K: class x3 y1 p):
  $ wceq I (cfv C cidfu) $ >
  $ wi ph (wcel I (co D E cfunc)) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq J (cfv D chomf) $ >
  $ wceq K (cmpo x3 y1 S S (ciun p (cxp (cima (ccnv (cfv I c1st)) (csn (cv x3))) (cima (ccnv (cfv I c1st)) (csn (cv y1)))) (cima (cfv (cv p) (cfv I c2nd)) (cfv (cv p) H)))) $ >
  $ wceq S (cima (cfv I c1st) A2) $ >
  $ wi ph (wceq (cres J (cxp S S)) K) $;

--| The image of the identity functor. (Contributed by Zhi Wang, 10-Nov-2025.)
theorem imaidfu2 {x3 y1 p: setvar} (ph: wff p) (C: class x3 y1 p) (D: class p) (S E: class x3 y1 p) (H I: class) (J K: class x3 y1 p):
  $ wceq I (cfv C cidfu) $ >
  $ wi ph (wcel I (co D E cfunc)) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq J (cfv D chomf) $ >
  $ wceq K (cmpo x3 y1 S S (ciun p (cxp (cima (ccnv (cfv I c1st)) (csn (cv x3))) (cima (ccnv (cfv I c1st)) (csn (cv y1)))) (cima (cfv (cv p) (cfv I c2nd)) (cfv (cv p) H)))) $ >
  $ wi ph (wceq S (cfv D cbs)) $ >
  $ wi ph (wceq J K) $;

--| Express the object part of ` ( G o.func F ) = I ` explicitly. (Contributed by Zhi Wang, 15-Nov-2025.)
theorem cofid1a (ph: wff) (B2 D E F G I X: class):
  $ wceq I (cfv D cidfu) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel F (co D E cfunc)) $ >
  $ wi ph (wcel G (co E D cfunc)) $ >
  $ wi ph (wceq (co G F ccofu) I) $ >
  $ wi ph (wceq (cfv (cfv X (cfv F c1st)) (cfv G c1st)) X) $;

--| Express the morphism part of ` ( G o.func F ) = I ` explicitly. (Contributed by Zhi Wang, 15-Nov-2025.)
theorem cofid2a (ph: wff) (B2 D R E F G H I X Y: class):
  $ wceq I (cfv D cidfu) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel F (co D E cfunc)) $ >
  $ wi ph (wcel G (co E D cfunc)) $ >
  $ wi ph (wceq (co G F ccofu) I) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq H (cfv D chom) $ >
  $ wi ph (wcel R (co X Y H)) $ >
  $ wi ph (wceq (cfv (cfv R (co X Y (cfv F c2nd))) (co (cfv X (cfv F c1st)) (cfv Y (cfv F c1st)) (cfv G c2nd))) R) $;

--| Express the object part of ` ( G o.func F ) = I ` explicitly. (Contributed by Zhi Wang, 15-Nov-2025.)
theorem cofid1 (ph: wff) (B2 D E F G I K L X: class):
  $ wceq I (cfv D cidfu) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wbr F G (co D E cfunc)) $ >
  $ wi ph (wbr K L (co E D cfunc)) $ >
  $ wi ph (wceq (co (cop K L) (cop F G) ccofu) I) $ >
  $ wi ph (wceq (cfv (cfv X F) K) X) $;

--| Express the morphism part of ` ( G o.func F ) = I ` explicitly. (Contributed by Zhi Wang, 15-Nov-2025.)
theorem cofid2 (ph: wff) (B2 D R E F G H I K L X Y: class):
  $ wceq I (cfv D cidfu) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wbr F G (co D E cfunc)) $ >
  $ wi ph (wbr K L (co E D cfunc)) $ >
  $ wi ph (wceq (co (cop K L) (cop F G) ccofu) I) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq H (cfv D chom) $ >
  $ wi ph (wcel R (co X Y H)) $ >
  $ wi ph (wceq (cfv (cfv R (co X Y G)) (co (cfv X F) (cfv Y F) L)) R) $;

--| The property " ` F ` is a section of ` G ` " in a category of small categories (in a universe); expressed explicitly. (Contributed by Zhi Wang, 15-Nov-2025.)
theorem cofidvala {x3 y1 z: setvar} (ph: wff) (B2: class) (D: class x3 y1) (E: class x3 y1 z) (F G: class z) (H: class x3 y1) (I: class x3 y1 z):
  $ wceq I (cfv D cidfu) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wcel F (co D E cfunc)) $ >
  $ wi ph (wcel G (co E D cfunc)) $ >
  $ wi ph (wceq (co G F ccofu) I) $ >
  $ wceq H (cfv D chom) $ >
  $ wi ph (wa (wceq (ccom (cfv G c1st) (cfv F c1st)) (cres cid B2)) (wceq (cmpo x3 y1 B2 B2 (ccom (co (cfv (cv x3) (cfv F c1st)) (cfv (cv y1) (cfv F c1st)) (cfv G c2nd)) (co (cv x3) (cv y1) (cfv F c2nd)))) (cmpt z (cxp B2 B2) (cres cid (cfv (cv z) H))))) $;

--| If " ` F ` is a section of ` G ` " in a category of small categories (in a universe), then the morphism part of ` F ` is injective, and the morphism part of ` G ` is surjective in the image of ` F ` . (Contributed by Zhi Wang, 15-Nov-2025.)
theorem cofidf2a (ph: wff) (B2 D E F G H I J X Y: class):
  $ wceq I (cfv D cidfu) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wcel F (co D E cfunc)) $ >
  $ wi ph (wcel G (co E D cfunc)) $ >
  $ wi ph (wceq (co G F ccofu) I) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq J (cfv E chom) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wa (wf1 (co X Y H) (co (cfv X (cfv F c1st)) (cfv Y (cfv F c1st)) J) (co X Y (cfv F c2nd))) (wfo (co (cfv X (cfv F c1st)) (cfv Y (cfv F c1st)) J) (co X Y H) (co (cfv X (cfv F c1st)) (cfv Y (cfv F c1st)) (cfv G c2nd)))) $;

--| If " ` F ` is a section of ` G ` " in a category of small categories (in a universe), then the object part of ` F ` is injective, and the object part of ` G ` is surjective. (Contributed by Zhi Wang, 15-Nov-2025.)
theorem cofidf1a (ph: wff) (B2 C D E F G I: class):
  $ wceq I (cfv D cidfu) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wcel F (co D E cfunc)) $ >
  $ wi ph (wcel G (co E D cfunc)) $ >
  $ wi ph (wceq (co G F ccofu) I) $ >
  $ wceq C (cfv E cbs) $ >
  $ wi ph (wa (wf1 B2 C (cfv F c1st)) (wfo C B2 (cfv G c1st))) $;

--| The property " ` <. F , G >. ` is a section of ` <. K , L >. ` " in a category of small categories (in a universe); expressed explicitly. (Contributed by Zhi Wang, 15-Nov-2025.)
theorem cofidval {x3 y1 z: setvar} (ph: wff) (B2: class) (D: class x3 y1) (E: class x3 y1 z) (F G: class z) (H: class x3 y1) (I: class x3 y1 z) (K L: class z):
  $ wceq I (cfv D cidfu) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wbr F G (co D E cfunc)) $ >
  $ wi ph (wbr K L (co E D cfunc)) $ >
  $ wi ph (wceq (co (cop K L) (cop F G) ccofu) I) $ >
  $ wceq H (cfv D chom) $ >
  $ wi ph (wa (wceq (ccom K F) (cres cid B2)) (wceq (cmpo x3 y1 B2 B2 (ccom (co (cfv (cv x3) F) (cfv (cv y1) F) L) (co (cv x3) (cv y1) G))) (cmpt z (cxp B2 B2) (cres cid (cfv (cv z) H))))) $;

--| If " ` F ` is a section of ` G ` " in a category of small categories (in a universe), then the morphism part of ` F ` is injective, and the morphism part of ` G ` is surjective in the image of ` F ` . (Contributed by Zhi Wang, 15-Nov-2025.)
theorem cofidf2 (ph: wff) (B2 D E F G H I J K L X Y: class):
  $ wceq I (cfv D cidfu) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wbr F G (co D E cfunc)) $ >
  $ wi ph (wbr K L (co E D cfunc)) $ >
  $ wi ph (wceq (co (cop K L) (cop F G) ccofu) I) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq J (cfv E chom) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wa (wf1 (co X Y H) (co (cfv X F) (cfv Y F) J) (co X Y G)) (wfo (co (cfv X F) (cfv Y F) J) (co X Y H) (co (cfv X F) (cfv Y F) L))) $;

--| If " ` <. F , G >. ` is a section of ` <. K , L >. ` " in a category of small categories (in a universe), then ` F ` is injective, and ` K ` is surjective. (Contributed by Zhi Wang, 15-Nov-2025.)
theorem cofidf1 (ph: wff) (B2 C D E F G I K L: class):
  $ wceq I (cfv D cidfu) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wbr F G (co D E cfunc)) $ >
  $ wi ph (wbr K L (co E D cfunc)) $ >
  $ wi ph (wceq (co (cop K L) (cop F G) ccofu) I) $ >
  $ wceq C (cfv E cbs) $ >
  $ wi ph (wa (wf1 B2 C F) (wfo C B2 K)) $;

--| Extend class notation with the operation generating opposite functors.
term coppf: class;

--| Definition of the operation generating opposite functors. Definition 3.41 of [Adamek] p. 39. The object part of the functor is unchanged while the morphism part is transposed due to reversed direction of arrows in the opposite category. The opposite functor is a functor on opposite categories ( ~ oppfoppc ). (Contributed by Zhi Wang, 4-Nov-2025.) Better reverse closure. (Revised by Zhi Wang, 13-Nov-2025.)
axiom df_oppf {f2 g2: setvar}:
  $ wceq coppf (cmpo f2 g2 cvv cvv (cif (wa (wrel (cv g2)) (wrel (cdm (cv g2)))) (cop (cv f2) (ctpos (cv g2))) c0)) $;

--| ` oppFunc ` is a function on ` ( _V X. _V ) ` . (Contributed by Zhi Wang, 17-Nov-2025.)
theorem oppffn:
  $ wfn coppf (cxp cvv cvv) $;

--| The domain of ` oppFunc ` is a relation. (Contributed by Zhi Wang, 13-Nov-2025.)
theorem reldmoppf:
  $ wrel (cdm coppf) $;

--| Value of the opposite functor. (Contributed by Zhi Wang, 13-Nov-2025.)
theorem oppfvalg (F G: class):
  $ wi (wa (wcel F cvv) (wcel G cvv)) (wceq (co F G coppf) (cif (wa (wrel G) (wrel (cdm G))) (cop F (ctpos G)) c0)) $;

--| Lemma for ~ oppfrcl . (Contributed by Zhi Wang, 14-Nov-2025.)
theorem oppfrcllem (ph: wff) (R G: class):
  $ wi ph (wcel G R) $ >
  $ wrel R $ >
  $ wi ph (wne G c0) $;

--| If an opposite functor of a class is a functor, then the original class must be an ordered pair. (Contributed by Zhi Wang, 14-Nov-2025.)
theorem oppfrcl (ph: wff) (R F G: class):
  $ wi ph (wcel G R) $ >
  $ wrel R $ >
  $ wceq G (cfv F coppf) $ >
  $ wi ph (wcel F (cxp cvv cvv)) $;

--| If an opposite functor of a class is a functor, then the two components of the original class must be sets. (Contributed by Zhi Wang, 14-Nov-2025.)
theorem oppfrcl2 (ph: wff) (A2 B2 R F G: class):
  $ wi ph (wcel G R) $ >
  $ wrel R $ >
  $ wceq G (cfv F coppf) $ >
  $ wi ph (wceq F (cop A2 B2)) $ >
  $ wi ph (wa (wcel A2 cvv) (wcel B2 cvv)) $;

--| If an opposite functor of a class is a functor, then the second component of the original class must be a relation whose domain is a relation as well. (Contributed by Zhi Wang, 14-Nov-2025.)
theorem oppfrcl3 (ph: wff) (A2 B2 R F G: class):
  $ wi ph (wcel G R) $ >
  $ wrel R $ >
  $ wceq G (cfv F coppf) $ >
  $ wi ph (wceq F (cop A2 B2)) $ >
  $ wi ph (wa (wrel B2) (wrel (cdm B2))) $;

--| Rewrite the opposite functor into its components ( ~ eqopi ). (Contributed by Zhi Wang, 14-Nov-2025.)
theorem oppf1st2nd (ph: wff) (A2 B2 R F G: class):
  $ wi ph (wcel G R) $ >
  $ wrel R $ >
  $ wceq G (cfv F coppf) $ >
  $ wi ph (wceq F (cop A2 B2)) $ >
  $ wi ph (wa (wcel G (cxp cvv cvv)) (wa (wceq (cfv G c1st) A2) (wceq (cfv G c2nd) (ctpos B2)))) $;

--| The double opposite functor is the original functor. Remark 3.42 of [Adamek] p. 39. (Contributed by Zhi Wang, 14-Nov-2025.)
theorem _2oppf (ph: wff) (R F G: class):
  $ wi ph (wcel G R) $ >
  $ wrel R $ >
  $ wceq G (cfv F coppf) $ >
  $ wi ph (wceq (cfv G coppf) F) $;

--| The pre-image of a non-empty opposite functor is non-empty; and the second component of the pre-image is a relation on triples. (Contributed by Zhi Wang, 18-Nov-2025.)
theorem eloppf (ph: wff) (F G X: class):
  $ wceq G (cfv F coppf) $ >
  $ wi ph (wcel X G) $ >
  $ wi ph (wa (wne F c0) (wa (wrel (cfv F c2nd)) (wrel (cdm (cfv F c2nd))))) $;

--| Both components of a pre-image of a non-empty opposite functor exist; and the second component is a relation on triples. (Contributed by Zhi Wang, 18-Nov-2025.)
theorem eloppf2 (ph: wff) (F G K X: class):
  $ wceq (co F G coppf) K $ >
  $ wi ph (wcel X K) $ >
  $ wi ph (wa (wa (wcel F cvv) (wcel G cvv)) (wa (wrel G) (wrel (cdm G)))) $;

--| Lemma for ~ oppfval . (Contributed by Zhi Wang, 13-Nov-2025.)
theorem oppfvallem (C D F G: class):
  $ wi (wbr F G (co C D cfunc)) (wa (wrel G) (wrel (cdm G))) $;

--| Value of the opposite functor. (Contributed by Zhi Wang, 4-Nov-2025.)
theorem oppfval (C D F G: class):
  $ wi (wbr F G (co C D cfunc)) (wceq (co F G coppf) (cop F (ctpos G))) $;

--| Value of the opposite functor. (Contributed by Zhi Wang, 13-Nov-2025.)
theorem oppfval2 (C D F: class):
  $ wi (wcel F (co C D cfunc)) (wceq (cfv F coppf) (cop (cfv F c1st) (ctpos (cfv F c2nd)))) $;

--| Value of the opposite functor. (Contributed by Zhi Wang, 19-Nov-2025.)
theorem oppfval3 (ph: wff) (C D F G K: class):
  $ wi ph (wceq F (cop G K)) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wceq (cfv F coppf) (cop G (ctpos K))) $;

--| Value of the object part of the opposite functor. (Contributed by Zhi Wang, 19-Nov-2025.)
theorem oppf1 (ph: wff) (C D F: class):
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wceq (cfv (cfv F coppf) c1st) (cfv F c1st)) $;

--| Value of the morphism part of the opposite functor. (Contributed by Zhi Wang, 19-Nov-2025.)
theorem oppf2 (ph: wff) (C D F M N: class):
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wceq (co M N (cfv (cfv F coppf) c2nd)) (co N M (cfv F c2nd))) $;

--| The opposite functor is a functor on opposite categories. (Contributed by Zhi Wang, 4-Nov-2025.)
theorem oppfoppc (ph: wff) (C D P F G O: class):
  $ wceq O (cfv C coppc) $ >
  $ wceq P (cfv D coppc) $ >
  $ wi ph (wbr F G (co C D cfunc)) $ >
  $ wi ph (wcel (co F G coppf) (co O P cfunc)) $;

--| The opposite functor is a functor on opposite categories. (Contributed by Zhi Wang, 14-Nov-2025.)
theorem oppfoppc2 (ph: wff) (C D P F O: class):
  $ wceq O (cfv C coppc) $ >
  $ wceq P (cfv D coppc) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wcel (cfv F coppf) (co O P cfunc)) $;

--| A functor on opposite categories yields a functor on the original categories. (Contributed by Zhi Wang, 4-Nov-2025.)
theorem funcoppc2 (ph: wff) (C D P F G O V W: class):
  $ wceq O (cfv C coppc) $ >
  $ wceq P (cfv D coppc) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wcel D W) $ >
  $ wi ph (wbr F G (co O P cfunc)) $ >
  $ wi ph (wbr F (ctpos G) (co C D cfunc)) $;

--| A functor on opposite categories yields a functor on the original categories. (Contributed by Zhi Wang, 14-Nov-2025.)
theorem funcoppc4 (ph: wff) (C D P F G O V W: class):
  $ wceq O (cfv C coppc) $ >
  $ wceq P (cfv D coppc) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wcel D W) $ >
  $ wi ph (wcel (co F G coppf) (co O P cfunc)) $ >
  $ wi ph (wbr F G (co C D cfunc)) $;

--| A functor on opposite categories yields a functor on the original categories. (Contributed by Zhi Wang, 14-Nov-2025.)
theorem funcoppc5 (ph: wff) (C D P F O V W: class):
  $ wceq O (cfv C coppc) $ >
  $ wceq P (cfv D coppc) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wcel D W) $ >
  $ wi ph (wcel (cfv F coppf) (co O P cfunc)) $ >
  $ wi ph (wcel F (co C D cfunc)) $;

--| The opposite functor of an opposite functor is a functor on the original categories. (Contributed by Zhi Wang, 14-Nov-2025.) The functor in opposite categories does not have to be an opposite functor. (Revised by Zhi Wang, 17-Nov-2025.)
theorem _2oppffunc (ph: wff) (C D P F O V W: class):
  $ wceq O (cfv C coppc) $ >
  $ wceq P (cfv D coppc) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wcel D W) $ >
  $ wi ph (wcel F (co O P cfunc)) $ >
  $ wi ph (wcel (cfv F coppf) (co C D cfunc)) $;

--| A functor on opposite categories yields a functor on the original categories. (Contributed by Zhi Wang, 4-Nov-2025.)
theorem funcoppc3 (ph: wff) (A2 B2 C D P F G O V W: class):
  $ wceq O (cfv C coppc) $ >
  $ wceq P (cfv D coppc) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wcel D W) $ >
  $ wi ph (wbr F (ctpos G) (co O P cfunc)) $ >
  $ wi ph (wfn G (cxp A2 B2)) $ >
  $ wi ph (wbr F G (co C D cfunc)) $;

--| The operation generating opposite functors is injective. (Contributed by Zhi Wang, 17-Nov-2025.)
theorem oppff1 (C D P O: class):
  $ wceq O (cfv C coppc) $ >
  $ wceq P (cfv D coppc) $ >
  $ wf1 (co C D cfunc) (co O P cfunc) (cres coppf (co C D cfunc)) $;

--| The operation generating opposite functors is bijective. (Contributed by Zhi Wang, 17-Nov-2025.)
theorem oppff1o (ph: wff) (C D P O V W: class):
  $ wceq O (cfv C coppc) $ >
  $ wceq P (cfv D coppc) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wcel D W) $ >
  $ wi ph (wf1o (co C D cfunc) (co O P cfunc) (cres coppf (co C D cfunc))) $;

--| Composition of opposite functors. (Contributed by Zhi Wang, 26-Nov-2025.)
theorem cofuoppf (ph: wff) (C D E F G K: class):
  $ wi ph (wceq (co G F ccofu) K) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wcel G (co D E cfunc)) $ >
  $ wi ph (wceq (co (cfv G coppf) (cfv F coppf) ccofu) (cfv K coppf)) $;

--| An image of a full functor is a full subcategory. Remark 4.2(3) of [Adamek] p. 48. (Contributed by Zhi Wang, 7-Nov-2025.)
theorem imasubc {x3 y1 p: setvar} (ph: wff p) (A2 C D: class x3 y1 p) (S: class p) (E: class x3 y1) (F G H: class) (J K: class x3 y1 p):
  $ wceq S (cima F A2) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq K (cmpo x3 y1 S S (ciun p (cxp (cima (ccnv F) (csn (cv x3))) (cima (ccnv F) (csn (cv y1)))) (cima (cfv (cv p) G) (cfv (cv p) H)))) $ >
  $ wi ph (wbr F G (co D E cful)) $ >
  $ wceq C (cfv E cbs) $ >
  $ wceq J (cfv E chomf) $ >
  $ wi ph (w3a (wfn K (cxp S S)) (wss S C) (wceq (cres J (cxp S S)) K)) $;

--| An image of a full functor is a (full) subcategory. Remark 4.2(3) of [Adamek] p. 48. (Contributed by Zhi Wang, 7-Nov-2025.)
theorem imasubc2 {x3 y1 p: setvar} (ph: wff p) (A2 D: class x3 y1 p) (S: class p) (E: class x3 y1) (F G H: class) (K: class x3 y1 p):
  $ wceq S (cima F A2) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq K (cmpo x3 y1 S S (ciun p (cxp (cima (ccnv F) (csn (cv x3))) (cima (ccnv F) (csn (cv y1)))) (cima (cfv (cv p) G) (cfv (cv p) H)))) $ >
  $ wi ph (wbr F G (co D E cful)) $ >
  $ wi ph (wcel K (cfv E csubc)) $;

--| An image of a functor satisfies the subcategory subset relation. (Contributed by Zhi Wang, 7-Nov-2025.)
theorem imassc {x3 y1 p: setvar} (ph: wff p) (A2 D: class x3 y1 p) (S: class p) (E: class x3 y1) (F G H: class) (J K: class x3 y1 p):
  $ wceq S (cima F A2) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq K (cmpo x3 y1 S S (ciun p (cxp (cima (ccnv F) (csn (cv x3))) (cima (ccnv F) (csn (cv y1)))) (cima (cfv (cv p) G) (cfv (cv p) H)))) $ >
  $ wi ph (wbr F G (co D E cfunc)) $ >
  $ wceq J (cfv E chomf) $ >
  $ wi ph (wbr K J cssc) $;

--| An image of a functor preserves the identity morphism. (Contributed by Zhi Wang, 7-Nov-2025.)
theorem imaid {x3 y1 p: setvar} (ph: wff x3 y1 p) (A2 D: class x3 y1 p) (S: class p) (E: class x3 y1 p) (F G H: class) (I: class x3 y1) (K: class x3 y1 p) (X: class):
  $ wceq S (cima F A2) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq K (cmpo x3 y1 S S (ciun p (cxp (cima (ccnv F) (csn (cv x3))) (cima (ccnv F) (csn (cv y1)))) (cima (cfv (cv p) G) (cfv (cv p) H)))) $ >
  $ wi ph (wbr F G (co D E cfunc)) $ >
  $ wceq I (cfv E ccid) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wcel (cfv X I) (co X X K)) $;

--| An image of a functor whose object part is injective preserves the composition. (Contributed by Zhi Wang, 7-Nov-2025.)
theorem imaf1co {x3 y1 p: setvar} (ph: wff x3 y1 p) (A2 B2 C D: class x3 y1 p) (S: class p) (c_xb E: class x3 y1 p) (F G H: class) (K M N: class x3 y1 p) (X Y Z: class):
  $ wceq S (cima F A2) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq K (cmpo x3 y1 S S (ciun p (cxp (cima (ccnv F) (csn (cv x3))) (cima (ccnv F) (csn (cv y1)))) (cima (cfv (cv p) G) (cfv (cv p) H)))) $ >
  $ wi ph (wbr F G (co D E cfunc)) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wceq C (cfv E cbs) $ >
  $ wceq c_xb (cfv E cco) $ >
  $ wi ph (wf1 B2 C F) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wcel Y S) $ >
  $ wi ph (wcel Z S) $ >
  $ wi ph (wcel M (co X Y K)) $ >
  $ wi ph (wcel N (co Y Z K)) $ >
  $ wi ph (wcel (co N M (co (cop X Y) Z c_xb)) (co X Z K)) $;

--| An image of a functor injective on objects is a subcategory. Remark 4.2(3) of [Adamek] p. 48. (Contributed by Zhi Wang, 7-Nov-2025.)
theorem imasubc3 {x3 y1 p: setvar} (ph: wff p) (A2 D: class x3 y1 p) (S: class p) (E: class x3 y1) (F G H: class) (K: class x3 y1 p):
  $ wceq S (cima F A2) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq K (cmpo x3 y1 S S (ciun p (cxp (cima (ccnv F) (csn (cv x3))) (cima (ccnv F) (csn (cv y1)))) (cima (cfv (cv p) G) (cfv (cv p) H)))) $ >
  $ wi ph (wbr F G (co D E cfunc)) $ >
  $ wi ph (wfun (ccnv F)) $ >
  $ wi ph (wcel K (cfv E csubc)) $;

--| Source categories of a faithful functor have the same base, hom-sets and composition operation if the composition is compatible in images of the functor. (Contributed by Zhi Wang, 10-Nov-2025.)
theorem fthcomf {x3 y1 z f2 g2: setvar} (ph: wff) (A2 B2: class) (C D F G: class x3 y1 z f2 g2):
  $ wi ph (wbr F G (co A2 C cfth)) $ >
  $ wi ph (wbr F G (co B2 D cfunc)) $ >
  $ wi (wa (wa ph (w3a (wcel (cv x3) (cfv A2 cbs)) (wcel (cv y1) (cfv A2 cbs)) (wcel (cv z) (cfv A2 cbs)))) (wa (wcel (cv f2) (co (cv x3) (cv y1) (cfv A2 chom))) (wcel (cv g2) (co (cv y1) (cv z) (cfv A2 chom))))) (wceq (co (cfv (cv g2) (co (cv y1) (cv z) G)) (cfv (cv f2) (co (cv x3) (cv y1) G)) (co (cop (cfv (cv x3) F) (cfv (cv y1) F)) (cfv (cv z) F) (cfv C cco))) (co (cfv (cv g2) (co (cv y1) (cv z) G)) (cfv (cv f2) (co (cv x3) (cv y1) G)) (co (cop (cfv (cv x3) F) (cfv (cv y1) F)) (cfv (cv z) F) (cfv D cco)))) $ >
  $ wi ph (wceq (cfv A2 ccomf) (cfv B2 ccomf)) $;

--| The inclusion functor is a faithful functor. (Contributed by Zhi Wang, 10-Nov-2025.)
theorem idfth (C D E I: class):
  $ wceq I (cfv C cidfu) $ >
  $ wi (wcel I (co D E cfunc)) (wcel I (co D E cfth)) $;

--| The inclusion functor is an embedding. Remark 4.4(1) in [Adamek] p. 49. (Contributed by Zhi Wang, 16-Nov-2025.)
theorem idemb (C D E I: class):
  $ wceq I (cfv C cidfu) $ >
  $ wi (wcel I (co D E cfunc)) (wa (wcel I (co D E cfth)) (wfun (ccnv (cfv I c1st)))) $;

--| The source category of an inclusion functor is a subcategory of the target category. See also Remark 4.4 in [Adamek] p. 49. (Contributed by Zhi Wang, 10-Nov-2025.)
theorem idsubc (C D E H I: class):
  $ wceq I (cfv C cidfu) $ >
  $ wceq H (cfv D chomf) $ >
  $ wi (wcel I (co D E cfunc)) (wcel H (cfv E csubc)) $;

--| The source category of an inclusion functor is a full subcategory of the target category if the inclusion functor is full. Remark 4.4(2) in [Adamek] p. 49. See also ~ ressffth . (Contributed by Zhi Wang, 11-Nov-2025.)
theorem idfullsubc (B2 C D E H I J: class):
  $ wceq I (cfv C cidfu) $ >
  $ wceq H (cfv D chomf) $ >
  $ wceq J (cfv E chomf) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wceq C (cfv E cbs) $ >
  $ wi (wcel I (co D E cful)) (wa (wss B2 C) (wceq (cres J (cxp B2 B2)) H)) $;

--| If " ` F ` is a section of ` G ` " in a category of small categories (in a universe), then ` F ` is faithful. Combined with ~ cofidf1 , this theorem proves that ` F ` is an embedding (a faithful functor injective on objects, remark 3.28(1) of [Adamek] p. 34). (Contributed by Zhi Wang, 15-Nov-2025.)
theorem cofidfth (ph: wff) (D E F G I K L: class):
  $ wceq I (cfv D cidfu) $ >
  $ wi ph (wbr F G (co D E cfunc)) $ >
  $ wi ph (wbr K L (co E D cfunc)) $ >
  $ wi ph (wceq (co (cop K L) (cop F G) ccofu) I) $ >
  $ wi ph (wbr F G (co D E cfth)) $;

--| The opposite functor of a full functor is also full. Proposition 3.43(d) in [Adamek] p. 39. (Contributed by Zhi Wang, 26-Nov-2025.)
theorem fulloppf (ph: wff) (C D P F O: class):
  $ wceq O (cfv C coppc) $ >
  $ wceq P (cfv D coppc) $ >
  $ wi ph (wcel F (co C D cful)) $ >
  $ wi ph (wcel (cfv F coppf) (co O P cful)) $;

--| The opposite functor of a faithful functor is also faithful. Proposition 3.43(c) in [Adamek] p. 39. (Contributed by Zhi Wang, 26-Nov-2025.)
theorem fthoppf (ph: wff) (C D P F O: class):
  $ wceq O (cfv C coppc) $ >
  $ wceq P (cfv D coppc) $ >
  $ wi ph (wcel F (co C D cfth)) $ >
  $ wi ph (wcel (cfv F coppf) (co O P cfth)) $;

--| The opposite functor of a fully faithful functor is also full and faithful. (Contributed by Zhi Wang, 26-Nov-2025.)
theorem ffthoppf (ph: wff) (C D P F O: class):
  $ wceq O (cfv C coppc) $ >
  $ wceq P (cfv D coppc) $ >
  $ wi ph (wcel F (cin (co C D cful) (co C D cfth))) $ >
  $ wi ph (wcel (cfv F coppf) (cin (co O P cful) (co O P cfth))) $;

--| Lemma for ~ upcic , ~ upeu , and ~ upeu2 . (Contributed by Zhi Wang, 16-Sep-2025.) (Proof shortened by Zhi Wang, 5-Nov-2025.)
theorem upciclem1 {y1 k n l: setvar} (ph: wff y1 k n l) (B2: class k n l) (F G H: class) (J: class k l) (M: class) (N: class y1) (O X Y Z: class):
  $ wi ph (wral y1 (wral n (wreu k (wceq (cv n) (co (cfv (cv k) (co X (cv y1) G)) M (co (cop Z (cfv X F)) (cfv (cv y1) F) O))) (co X (cv y1) H)) (co Z (cfv (cv y1) F) J)) B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel N (co Z (cfv Y F) J)) $ >
  $ wi ph (wreu l (wceq N (co (cfv (cv l) (co X Y G)) M (co (cop Z (cfv X F)) (cfv Y F) O))) (co X Y H)) $;

--| Lemma for ~ upciclem3 and ~ upeu2 . (Contributed by Zhi Wang, 19-Sep-2025.)
theorem upciclem2 (ph: wff) (B2 C D c_x E F G H J K L M N O W X Y Z: class):
  $ wceq B2 (cfv D cbs) $ >
  $ wceq C (cfv E cbs) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq J (cfv E chom) $ >
  $ wceq O (cfv E cco) $ >
  $ wi ph (wbr F G (co D E cfunc)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wcel W C) $ >
  $ wi ph (wcel M (co W (cfv X F) J)) $ >
  $ wceq c_x (cfv D cco) $ >
  $ wi ph (wcel K (co X Y H)) $ >
  $ wi ph (wcel L (co Y Z H)) $ >
  $ wi ph (wceq N (co (cfv K (co X Y G)) M (co (cop W (cfv X F)) (cfv Y F) O))) $ >
  $ wi ph (wceq (co (cfv (co L K (co (cop X Y) Z c_x)) (co X Z G)) M (co (cop W (cfv X F)) (cfv Z F) O)) (co (cfv L (co Y Z G)) N (co (cop W (cfv Y F)) (cfv Z F) O))) $;

--| Lemma for ~ upciclem4 . (Contributed by Zhi Wang, 17-Sep-2025.)
theorem upciclem3 {w f2 k: setvar} (ph: wff w f2 k) (B2: class f2 k) (C D c_x E: class w f2 k) (F G H: class) (J: class k) (K L: class w f2 k) (M: class) (N: class w f2 k) (O X: class) (Y: class w f2 k) (Z: class):
  $ wceq B2 (cfv D cbs) $ >
  $ wceq C (cfv E cbs) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq J (cfv E chom) $ >
  $ wceq O (cfv E cco) $ >
  $ wi ph (wbr F G (co D E cfunc)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z C) $ >
  $ wi ph (wcel M (co Z (cfv X F) J)) $ >
  $ wi ph (wral w (wral f2 (wreu k (wceq (cv f2) (co (cfv (cv k) (co X (cv w) G)) M (co (cop Z (cfv X F)) (cfv (cv w) F) O))) (co X (cv w) H)) (co Z (cfv (cv w) F) J)) B2) $ >
  $ wceq c_x (cfv D cco) $ >
  $ wi ph (wcel K (co X Y H)) $ >
  $ wi ph (wcel L (co Y X H)) $ >
  $ wi ph (wceq M (co (cfv L (co Y X G)) N (co (cop Z (cfv Y F)) (cfv X F) O))) $ >
  $ wi ph (wceq N (co (cfv K (co X Y G)) M (co (cop Z (cfv X F)) (cfv Y F) O))) $ >
  $ wi ph (wceq (co L K (co (cop X Y) X c_x)) (cfv X (cfv D ccid))) $;

--| Lemma for ~ upcic and ~ upeu . (Contributed by Zhi Wang, 19-Sep-2025.)
theorem upciclem4 {w v f2 g2 k r l: setvar} (ph: wff w v f2 g2 k r l) (B2: class f2 g2 k r l) (C: class w v f2 g2 k r l) (D: class w v f2 g2 k l) (E: class w v f2 g2 k r l) (F G H: class) (J: class k r l) (M: class v) (N: class w) (O X Y Z: class):
  $ wceq B2 (cfv D cbs) $ >
  $ wceq C (cfv E cbs) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq J (cfv E chom) $ >
  $ wceq O (cfv E cco) $ >
  $ wi ph (wbr F G (co D E cfunc)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z C) $ >
  $ wi ph (wcel M (co Z (cfv X F) J)) $ >
  $ wi ph (wral w (wral f2 (wreu k (wceq (cv f2) (co (cfv (cv k) (co X (cv w) G)) M (co (cop Z (cfv X F)) (cfv (cv w) F) O))) (co X (cv w) H)) (co Z (cfv (cv w) F) J)) B2) $ >
  $ wi ph (wcel N (co Z (cfv Y F) J)) $ >
  $ wi ph (wral v (wral g2 (wreu l (wceq (cv g2) (co (cfv (cv l) (co Y (cv v) G)) N (co (cop Z (cfv Y F)) (cfv (cv v) F) O))) (co Y (cv v) H)) (co Z (cfv (cv v) F) J)) B2) $ >
  $ wi ph (wa (wbr X Y (cfv D ccic)) (wrex r (wceq N (co (cfv (cv r) (co X Y G)) M (co (cop Z (cfv X F)) (cfv Y F) O))) (co X Y (cfv D ciso)))) $;

--| Lemma for ~ upcic and ~ upeu . (Contributed by Zhi Wang, 19-Sep-2025.)
theorem upciclem4_b {w f2 k r: setvar} (ph: wff w f2 k r) (B2: class f2 k r) (C: class w f2 k r) (D: class w f2 k) (E: class w f2 k r) (F G H: class) (J: class k r) (M N O X Y Z: class):
  $ wceq B2 (cfv D cbs) $ >
  $ wceq C (cfv E cbs) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq J (cfv E chom) $ >
  $ wceq O (cfv E cco) $ >
  $ wi ph (wbr F G (co D E cfunc)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z C) $ >
  $ wi ph (wcel M (co Z (cfv X F) J)) $ >
  $ wi ph (wral w (wral f2 (wreu k (wceq (cv f2) (co (cfv (cv k) (co X (cv w) G)) M (co (cop Z (cfv X F)) (cfv (cv w) F) O))) (co X (cv w) H)) (co Z (cfv (cv w) F) J)) B2) $ >
  $ wi ph (wcel N (co Z (cfv Y F) J)) $ >
  $ wi ph (wral w (wral f2 (wreu k (wceq (cv f2) (co (cfv (cv k) (co Y (cv w) G)) N (co (cop Z (cfv Y F)) (cfv (cv w) F) O))) (co Y (cv w) H)) (co Z (cfv (cv w) F) J)) B2) $ >
  $ wi ph (wa (wbr X Y (cfv D ccic)) (wrex r (wceq N (co (cfv (cv r) (co X Y G)) M (co (cop Z (cfv X F)) (cfv Y F) O))) (co X Y (cfv D ciso)))) $;

--| A universal property defines an object up to isomorphism given its existence. (Contributed by Zhi Wang, 17-Sep-2025.)
theorem upcic {w v f2 g2 k l: setvar} (ph: wff w v f2 g2 k l) (B2: class f2 g2 k l) (C D E: class w v f2 g2 k l) (F G H: class) (J: class k l) (M: class v) (N: class w) (O X Y Z: class):
  $ wceq B2 (cfv D cbs) $ >
  $ wceq C (cfv E cbs) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq J (cfv E chom) $ >
  $ wceq O (cfv E cco) $ >
  $ wi ph (wbr F G (co D E cfunc)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z C) $ >
  $ wi ph (wcel M (co Z (cfv X F) J)) $ >
  $ wi ph (wral w (wral f2 (wreu k (wceq (cv f2) (co (cfv (cv k) (co X (cv w) G)) M (co (cop Z (cfv X F)) (cfv (cv w) F) O))) (co X (cv w) H)) (co Z (cfv (cv w) F) J)) B2) $ >
  $ wi ph (wcel N (co Z (cfv Y F) J)) $ >
  $ wi ph (wral v (wral g2 (wreu l (wceq (cv g2) (co (cfv (cv l) (co Y (cv v) G)) N (co (cop Z (cfv Y F)) (cfv (cv v) F) O))) (co Y (cv v) H)) (co Z (cfv (cv v) F) J)) B2) $ >
  $ wi ph (wbr X Y (cfv D ccic)) $;

--| A universal property defines an essentially unique (strong form) pair of object ` X ` and morphism ` M ` if it exists. (Contributed by Zhi Wang, 19-Sep-2025.)
theorem upeu {w v f2 g2 k r l: setvar} (ph: wff w v f2 g2 k r l) (B2: class f2 g2 k r l) (C: class w v f2 g2 k r l) (D: class w v f2 g2 k l) (E: class w v f2 g2 k r l) (F G H: class) (J: class k r l) (M: class v) (N: class w) (O X Y Z: class):
  $ wceq B2 (cfv D cbs) $ >
  $ wceq C (cfv E cbs) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq J (cfv E chom) $ >
  $ wceq O (cfv E cco) $ >
  $ wi ph (wbr F G (co D E cfunc)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z C) $ >
  $ wi ph (wcel M (co Z (cfv X F) J)) $ >
  $ wi ph (wral w (wral f2 (wreu k (wceq (cv f2) (co (cfv (cv k) (co X (cv w) G)) M (co (cop Z (cfv X F)) (cfv (cv w) F) O))) (co X (cv w) H)) (co Z (cfv (cv w) F) J)) B2) $ >
  $ wi ph (wcel N (co Z (cfv Y F) J)) $ >
  $ wi ph (wral v (wral g2 (wreu l (wceq (cv g2) (co (cfv (cv l) (co Y (cv v) G)) N (co (cop Z (cfv Y F)) (cfv (cv v) F) O))) (co Y (cv v) H)) (co Z (cfv (cv v) F) J)) B2) $ >
  $ wi ph (wreu r (wceq N (co (cfv (cv r) (co X Y G)) M (co (cop Z (cfv X F)) (cfv Y F) O))) (co X Y (cfv D ciso))) $;

--| A universal property defines an essentially unique (strong form) pair of object ` X ` and morphism ` M ` if it exists. (Contributed by Zhi Wang, 19-Sep-2025.)
theorem upeu_b {w f2 k r: setvar} (ph: wff w f2 k r) (B2: class f2 k r) (C: class w f2 k r) (D: class w f2 k) (E: class w f2 k r) (F G H: class) (J: class k r) (M N O X Y Z: class):
  $ wceq B2 (cfv D cbs) $ >
  $ wceq C (cfv E cbs) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq J (cfv E chom) $ >
  $ wceq O (cfv E cco) $ >
  $ wi ph (wbr F G (co D E cfunc)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z C) $ >
  $ wi ph (wcel M (co Z (cfv X F) J)) $ >
  $ wi ph (wral w (wral f2 (wreu k (wceq (cv f2) (co (cfv (cv k) (co X (cv w) G)) M (co (cop Z (cfv X F)) (cfv (cv w) F) O))) (co X (cv w) H)) (co Z (cfv (cv w) F) J)) B2) $ >
  $ wi ph (wcel N (co Z (cfv Y F) J)) $ >
  $ wi ph (wral w (wral f2 (wreu k (wceq (cv f2) (co (cfv (cv k) (co Y (cv w) G)) N (co (cop Z (cfv Y F)) (cfv (cv w) F) O))) (co Y (cv w) H)) (co Z (cfv (cv w) F) J)) B2) $ >
  $ wi ph (wreu r (wceq N (co (cfv (cv r) (co X Y G)) M (co (cop Z (cfv X F)) (cfv Y F) O))) (co X Y (cfv D ciso))) $;

--| Generate new universal morphism through isomorphism from existing universal object. (Contributed by Zhi Wang, 20-Sep-2025.)
theorem upeu2 {w v f2 g2 k l: setvar} (ph: wff w f2 k) (B2: class v f2 k) (C: class w v f2 g2 k l) (D: class w v f2 g2 k) (E: class w v f2 g2 k l) (F G H: class v g2) (I: class w v f2 g2 k l) (J: class v g2 k) (K: class w v f2 g2 k) (M: class v g2) (N: class w v f2 g2 k l) (O X: class v g2) (Y: class w v f2 g2 k) (Z: class v g2):
  $ wceq B2 (cfv D cbs) $ >
  $ wceq C (cfv E cbs) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq J (cfv E chom) $ >
  $ wceq O (cfv E cco) $ >
  $ wi ph (wbr F G (co D E cfunc)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z C) $ >
  $ wi ph (wcel M (co Z (cfv X F) J)) $ >
  $ wi ph (wral w (wral f2 (wreu k (wceq (cv f2) (co (cfv (cv k) (co X (cv w) G)) M (co (cop Z (cfv X F)) (cfv (cv w) F) O))) (co X (cv w) H)) (co Z (cfv (cv w) F) J)) B2) $ >
  $ wceq I (cfv D ciso) $ >
  $ wi ph (wcel K (co X Y I)) $ >
  $ wi ph (wceq N (co (cfv K (co X Y G)) M (co (cop Z (cfv X F)) (cfv Y F) O))) $ >
  $ wi ph (wa (wcel N (co Z (cfv Y F) J)) (wral v (wral g2 (wreu l (wceq (cv g2) (co (cfv (cv l) (co Y (cv v) G)) N (co (cop Z (cfv Y F)) (cfv (cv v) F) O))) (co Y (cv v) H)) (co Z (cfv (cv v) F) J)) B2)) $;

--| Generate new universal morphism through isomorphism from existing universal object. (Contributed by Zhi Wang, 20-Sep-2025.)
theorem upeu2_b {w v f2 g2 k: setvar} (ph: wff w f2) (B2: class v f2) (C: class w v f2 g2 k) (D: class w v f2 g2) (E: class w v f2 g2 k) (F G H: class v g2) (I: class w v f2 g2 k) (J: class v g2) (K: class w v f2 g2) (M: class v g2) (N: class w v f2 g2 k) (O X: class v g2) (Y: class w v f2 g2) (Z: class v g2):
  $ wceq B2 (cfv D cbs) $ >
  $ wceq C (cfv E cbs) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq J (cfv E chom) $ >
  $ wceq O (cfv E cco) $ >
  $ wi ph (wbr F G (co D E cfunc)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z C) $ >
  $ wi ph (wcel M (co Z (cfv X F) J)) $ >
  $ wi ph (wral w (wral f2 (wreu k (wceq (cv f2) (co (cfv (cv k) (co X (cv w) G)) M (co (cop Z (cfv X F)) (cfv (cv w) F) O))) (co X (cv w) H)) (co Z (cfv (cv w) F) J)) B2) $ >
  $ wceq I (cfv D ciso) $ >
  $ wi ph (wcel K (co X Y I)) $ >
  $ wi ph (wceq N (co (cfv K (co X Y G)) M (co (cop Z (cfv X F)) (cfv Y F) O))) $ >
  $ wi ph (wa (wcel N (co Z (cfv Y F) J)) (wral v (wral g2 (wreu k (wceq (cv g2) (co (cfv (cv k) (co Y (cv v) G)) N (co (cop Z (cfv Y F)) (cfv (cv v) F) O))) (co Y (cv v) H)) (co Z (cfv (cv v) F) J)) B2)) $;

--| Extend class notation with the class of universal properties.
term cup: class;

--| Definition of the class of universal properties. Given categories ` D ` and ` E ` , if ` F : D --> E ` is a functor and ` W ` an object of ` E ` , a universal pair from ` W ` to ` F ` is a pair ` <. X , M >. ` consisting of an object ` X ` of ` D ` and a morphism ` M : W --> F X ` of ` E ` , such that to every pair ` <. y , g >. ` with ` y ` an object of ` D ` and ` g : W --> F y ` a morphism of ` E ` , there is a unique morphism ` k : X --> y ` of ` D ` with ` F k .o. M = g ` . Such property is commonly referred to as a universal property. In our definition, it is denoted as ` X ( F ( D UP E ) W ) M ` . Note that the universal pair is termed differently as "universal arrow" in p. 55 of Mac Lane, Saunders, _Categories for the Working Mathematician_, 2nd Edition, Springer Science+Business Media, New York, (1998) [QA169.M33 1998]; available at ~ https://math.mit.edu/~~hrm/palestine/maclane-categories.pdf (retrieved 6 Oct 2025). Interestingly, the "universal arrow" is referring to the morphism ` M ` instead of the pair near the end of the same piece of the text, causing name collision. The name "universal arrow" is also adopted in papers such as ~ https://arxiv.org/pdf/2212.08981 . Alternatively, the universal pair is called the "universal morphism" in Wikipedia ( ~ https://en.wikipedia.org/wiki/Universal_property ) as well as published works, e.g., ~ https://arxiv.org/pdf/2412.12179 . But the pair ` <. X , M >. ` should be named differently as the morphism ` M ` , and thus we call ` X ` the _universal object_, ` M ` the _universal morphism_, and ` <. X , M >. ` the _universal pair_. Given its existence, such universal pair is essentially unique ( ~ upeu3 ), and can be generated from an existing universal pair by isomorphisms ( ~ upeu4 ). See also ~ oppcup for the dual concept. (Contributed by Zhi Wang, 24-Sep-2025.)
axiom df_up {x3 y1 w e f2 g2 h j k m o b c d: setvar}:
  $ wceq cup (cmpo d e cvv cvv (csb b (cfv (cv d) cbs) (csb c (cfv (cv e) cbs) (csb h (cfv (cv d) chom) (csb j (cfv (cv e) chom) (csb o (cfv (cv e) cco) (cmpo f2 w (co (cv d) (cv e) cfunc) (cv c) (copab x3 m (wa (wa (wcel (cv x3) (cv b)) (wcel (cv m) (co (cv w) (cfv (cv x3) (cfv (cv f2) c1st)) (cv j)))) (wral y1 (wral g2 (wreu k (wceq (cv g2) (co (cfv (cv k) (co (cv x3) (cv y1) (cfv (cv f2) c2nd))) (cv m) (co (cop (cv w) (cfv (cv x3) (cfv (cv f2) c1st))) (cfv (cv y1) (cfv (cv f2) c1st)) (cv o)))) (co (cv x3) (cv y1) (cv h))) (co (cv w) (cfv (cv y1) (cfv (cv f2) c1st)) (cv j))) (cv b))))))))))) $;

--| The domain of ` UP ` is a relation. (Contributed by Zhi Wang, 25-Sep-2025.)
theorem reldmup:
  $ wrel (cdm cup) $;

--| Function value of the class of universal properties. (Contributed by Zhi Wang, 24-Sep-2025.) (Proof shortened by Zhi Wang, 12-Nov-2025.)
theorem upfval {x3 y1 w f2 g2 k m: setvar} (B2 C D E H J O: class):
  $ wceq B2 (cfv D cbs) $ >
  $ wceq C (cfv E cbs) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq J (cfv E chom) $ >
  $ wceq O (cfv E cco) $ >
  $ wceq (co D E cup) (cmpo f2 w (co D E cfunc) C (copab x3 m (wa (wa (wcel (cv x3) B2) (wcel (cv m) (co (cv w) (cfv (cv x3) (cfv (cv f2) c1st)) J))) (wral y1 (wral g2 (wreu k (wceq (cv g2) (co (cfv (cv k) (co (cv x3) (cv y1) (cfv (cv f2) c2nd))) (cv m) (co (cop (cv w) (cfv (cv x3) (cfv (cv f2) c1st))) (cfv (cv y1) (cfv (cv f2) c1st)) O))) (co (cv x3) (cv y1) H)) (co (cv w) (cfv (cv y1) (cfv (cv f2) c1st)) J)) B2)))) $;

--| Function value of the class of universal properties. (Contributed by Zhi Wang, 24-Sep-2025.)
theorem upfval2 {x3 y1 g2 k m: setvar} (ph: wff y1 g2 k) (B2 C D E F H J O W: class):
  $ wceq B2 (cfv D cbs) $ >
  $ wceq C (cfv E cbs) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq J (cfv E chom) $ >
  $ wceq O (cfv E cco) $ >
  $ wi ph (wcel W C) $ >
  $ wi ph (wcel F (co D E cfunc)) $ >
  $ wi ph (wceq (co F W (co D E cup)) (copab x3 m (wa (wa (wcel (cv x3) B2) (wcel (cv m) (co W (cfv (cv x3) (cfv F c1st)) J))) (wral y1 (wral g2 (wreu k (wceq (cv g2) (co (cfv (cv k) (co (cv x3) (cv y1) (cfv F c2nd))) (cv m) (co (cop W (cfv (cv x3) (cfv F c1st))) (cfv (cv y1) (cfv F c1st)) O))) (co (cv x3) (cv y1) H)) (co W (cfv (cv y1) (cfv F c1st)) J)) B2)))) $;

--| Function value of the class of universal properties. (Contributed by Zhi Wang, 24-Sep-2025.)
theorem upfval3 {x3 y1 g2 k m: setvar} (ph: wff y1 g2 k) (B2 C D E F G H J O W: class):
  $ wceq B2 (cfv D cbs) $ >
  $ wceq C (cfv E cbs) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq J (cfv E chom) $ >
  $ wceq O (cfv E cco) $ >
  $ wi ph (wcel W C) $ >
  $ wi ph (wbr F G (co D E cfunc)) $ >
  $ wi ph (wceq (co (cop F G) W (co D E cup)) (copab x3 m (wa (wa (wcel (cv x3) B2) (wcel (cv m) (co W (cfv (cv x3) F) J))) (wral y1 (wral g2 (wreu k (wceq (cv g2) (co (cfv (cv k) (co (cv x3) (cv y1) G)) (cv m) (co (cop W (cfv (cv x3) F)) (cfv (cv y1) F) O))) (co (cv x3) (cv y1) H)) (co W (cfv (cv y1) F) J)) B2)))) $;

--| Lemma for ~ isup and other theorems. (Contributed by Zhi Wang, 25-Sep-2025.)
theorem isuplem {y1 g2 k: setvar} (ph: wff y1 g2 k) (B2 C D E F G H J M O W X: class):
  $ wceq B2 (cfv D cbs) $ >
  $ wceq C (cfv E cbs) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq J (cfv E chom) $ >
  $ wceq O (cfv E cco) $ >
  $ wi ph (wcel W C) $ >
  $ wi ph (wbr F G (co D E cfunc)) $ >
  $ wi ph (wb (wbr X M (co (cop F G) W (co D E cup))) (wa (wa (wcel X B2) (wcel M (co W (cfv X F) J))) (wral y1 (wral g2 (wreu k (wceq (cv g2) (co (cfv (cv k) (co X (cv y1) G)) M (co (cop W (cfv X F)) (cfv (cv y1) F) O))) (co X (cv y1) H)) (co W (cfv (cv y1) F) J)) B2))) $;

--| The predicate "is a universal pair". (Contributed by Zhi Wang, 24-Sep-2025.)
theorem isup {y1 g2 k: setvar} (ph: wff y1 g2 k) (B2 C D E F G H J M O W X: class):
  $ wceq B2 (cfv D cbs) $ >
  $ wceq C (cfv E cbs) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq J (cfv E chom) $ >
  $ wceq O (cfv E cco) $ >
  $ wi ph (wcel W C) $ >
  $ wi ph (wbr F G (co D E cfunc)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel M (co W (cfv X F) J)) $ >
  $ wi ph (wb (wbr X M (co (cop F G) W (co D E cup))) (wral y1 (wral g2 (wreu k (wceq (cv g2) (co (cfv (cv k) (co X (cv y1) G)) M (co (cop W (cfv X F)) (cfv (cv y1) F) O))) (co X (cv y1) H)) (co W (cfv (cv y1) F) J)) B2)) $;

--| If two categories have the same set of objects, morphisms, and compositions, then they have the same universal pairs. (Contributed by Zhi Wang, 20-Nov-2025.)
theorem uppropd (ph: wff) (A2 B2 C D V: class):
  $ wi ph (wceq (cfv A2 chomf) (cfv B2 chomf)) $ >
  $ wi ph (wceq (cfv A2 ccomf) (cfv B2 ccomf)) $ >
  $ wi ph (wceq (cfv C chomf) (cfv D chomf)) $ >
  $ wi ph (wceq (cfv C ccomf) (cfv D ccomf)) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wceq (co A2 C cup) (co B2 D cup)) $;

--| The domain of ` ( D UP E ) ` is a relation. (Contributed by Zhi Wang, 16-Oct-2025.)
theorem reldmup2 (D E: class):
  $ wrel (cdm (co D E cup)) $;

--| The set of universal pairs is a relation. (Contributed by Zhi Wang, 25-Sep-2025.)
theorem relup (D E F W: class):
  $ wrel (co F W (co D E cup)) $;

--| Reverse closure for the class of universal property. (Contributed by Zhi Wang, 25-Sep-2025.)
theorem uprcl (C D E F W X: class):
  $ wceq C (cfv E cbs) $ >
  $ wi (wcel X (co F W (co D E cup))) (wa (wcel F (co D E cfunc)) (wcel W C)) $;

--| Rewrite the universal property predicate with separated parts. (Contributed by Zhi Wang, 23-Oct-2025.)
theorem up1st2nd (ph: wff) (D E F M W X: class):
  $ wi ph (wbr X M (co F W (co D E cup))) $ >
  $ wi ph (wbr X M (co (cop (cfv F c1st) (cfv F c2nd)) W (co D E cup))) $;

--| Combine separated parts in the universal property predicate. (Contributed by Zhi Wang, 23-Oct-2025.)
theorem up1st2ndr (ph: wff) (D E F M W X: class):
  $ wi ph (wcel F (co D E cfunc)) $ >
  $ wi ph (wbr X M (co (cop (cfv F c1st) (cfv F c2nd)) W (co D E cup))) $ >
  $ wi ph (wbr X M (co F W (co D E cup))) $;

--| Combine/separate parts in the universal property predicate. (Contributed by Zhi Wang, 23-Oct-2025.)
theorem up1st2ndb (ph: wff) (D E F M W X: class):
  $ wi ph (wcel F (co D E cfunc)) $ >
  $ wi ph (wb (wbr X M (co F W (co D E cup))) (wbr X M (co (cop (cfv F c1st) (cfv F c2nd)) W (co D E cup)))) $;

--| Rewrite the universal property predicate with separated parts. (Contributed by Zhi Wang, 23-Oct-2025.)
theorem up1st2nd2 (ph: wff) (D E F W X: class):
  $ wi ph (wcel X (co F W (co D E cup))) $ >
  $ wi ph (wbr (cfv X c1st) (cfv X c2nd) (co F W (co D E cup))) $;

--| Reverse closure for the class of universal property. (Contributed by Zhi Wang, 25-Sep-2025.)
theorem uprcl2 (ph: wff) (D E F G M W X: class):
  $ wi ph (wbr X M (co (cop F G) W (co D E cup))) $ >
  $ wi ph (wbr F G (co D E cfunc)) $;

--| Reverse closure for the class of universal property. (Contributed by Zhi Wang, 25-Sep-2025.)
theorem uprcl3 (ph: wff) (C D E F G M W X: class):
  $ wi ph (wbr X M (co (cop F G) W (co D E cup))) $ >
  $ wceq C (cfv E cbs) $ >
  $ wi ph (wcel W C) $;

--| Reverse closure for the class of universal property. (Contributed by Zhi Wang, 25-Sep-2025.)
theorem uprcl4 (ph: wff) (B2 D E F G M W X: class):
  $ wi ph (wbr X M (co (cop F G) W (co D E cup))) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wcel X B2) $;

--| Reverse closure for the class of universal property. (Contributed by Zhi Wang, 25-Sep-2025.)
theorem uprcl5 (ph: wff) (D E F G J M W X: class):
  $ wi ph (wbr X M (co (cop F G) W (co D E cup))) $ >
  $ wceq J (cfv E chom) $ >
  $ wi ph (wcel M (co W (cfv X F) J)) $;

--| Reverse closure for universal object. (Contributed by Zhi Wang, 17-Nov-2025.)
theorem uobrcl (D E F W X: class):
  $ wi (wcel X (cdm (co F W (co D E cup)))) (wa (wcel D ccat) (wcel E ccat)) $;

--| The universal property of a universal pair. (Contributed by Zhi Wang, 24-Sep-2025.)
theorem isup2 {y1 g2 k: setvar} (ph: wff y1 g2 k) (B2 D E F G H J M O W X: class):
  $ wceq B2 (cfv D cbs) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq J (cfv E chom) $ >
  $ wceq O (cfv E cco) $ >
  $ wi ph (wbr X M (co (cop F G) W (co D E cup))) $ >
  $ wi ph (wral y1 (wral g2 (wreu k (wceq (cv g2) (co (cfv (cv k) (co X (cv y1) G)) M (co (cop W (cfv X F)) (cfv (cv y1) F) O))) (co X (cv y1) H)) (co W (cfv (cv y1) F) J)) B2) $;

--| The universal pair ` <. X , M >. ` from object ` W ` to functor ` <. F , G >. ` is essentially unique (strong form) if it exists. (Contributed by Zhi Wang, 24-Sep-2025.)
theorem upeu3 {r: setvar} (ph: wff) (D E F G: class) (I: class r) (M N W X Y: class) (c_op: class r):
  $ wi ph (wceq I (cfv D ciso)) $ >
  $ wi ph (wceq c_op (co (cop W (cfv X F)) (cfv Y F) (cfv E cco))) $ >
  $ wi ph (wbr X M (co (cop F G) W (co D E cup))) $ >
  $ wi ph (wbr Y N (co (cop F G) W (co D E cup))) $ >
  $ wi ph (wreu r (wceq N (co (cfv (cv r) (co X Y G)) M c_op)) (co X Y I)) $;

--| Generate a new universal morphism through an isomorphism from an existing universal object, and pair with the codomain of the isomorphism to form a universal pair. (Contributed by Zhi Wang, 25-Sep-2025.)
theorem upeu4 (ph: wff) (D E F G I K M N W X Y c_op: class):
  $ wi ph (wceq I (cfv D ciso)) $ >
  $ wi ph (wceq c_op (co (cop W (cfv X F)) (cfv Y F) (cfv E cco))) $ >
  $ wi ph (wbr X M (co (cop F G) W (co D E cup))) $ >
  $ wi ph (wcel K (co X Y I)) $ >
  $ wi ph (wceq N (co (cfv K (co X Y G)) M c_op)) $ >
  $ wi ph (wbr Y N (co (cop F G) W (co D E cup))) $;

--| Lemma for ~ uptpos . (Contributed by Zhi Wang, 4-Nov-2025.)
theorem uptposlem (ph: wff) (P F G H M O W X: class):
  $ wi ph (wbr X M (co (cop F G) W (co O P cup))) $ >
  $ wi ph (wceq (ctpos G) H) $ >
  $ wi ph (wceq (ctpos H) G) $;

--| Rewrite the predicate of universal property in the form of opposite functor. (Contributed by Zhi Wang, 4-Nov-2025.)
theorem uptpos (ph: wff) (P F G H M O W X: class):
  $ wi ph (wbr X M (co (cop F G) W (co O P cup))) $ >
  $ wi ph (wceq (ctpos G) H) $ >
  $ wi ph (wbr X M (co (cop F (ctpos H)) W (co O P cup))) $;

--| Reverse closure for the class of universal property in opposite categories. (Contributed by Zhi Wang, 4-Nov-2025.)
theorem oppcuprcl4 (ph: wff) (B2 D P F G M O W X: class):
  $ wi ph (wbr X M (co (cop F G) W (co O P cup))) $ >
  $ wceq O (cfv D coppc) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wcel X B2) $;

--| Reverse closure for the class of universal property in opposite categories. (Contributed by Zhi Wang, 4-Nov-2025.)
theorem oppcuprcl3 (ph: wff) (C P E F G M O W X: class):
  $ wi ph (wbr X M (co (cop F G) W (co O P cup))) $ >
  $ wceq P (cfv E coppc) $ >
  $ wceq C (cfv E cbs) $ >
  $ wi ph (wcel W C) $;

--| Reverse closure for the class of universal property in opposite categories. (Contributed by Zhi Wang, 4-Nov-2025.)
theorem oppcuprcl5 (ph: wff) (P E F G J M O W X: class):
  $ wi ph (wbr X M (co (cop F G) W (co O P cup))) $ >
  $ wceq P (cfv E coppc) $ >
  $ wceq J (cfv E chom) $ >
  $ wi ph (wcel M (co (cfv X F) W J)) $;

--| Reverse closure for the class of universal property in opposite categories. (Contributed by Zhi Wang, 4-Nov-2025.)
theorem oppcuprcl2 (ph: wff) (D P U E F G H M O V W X: class):
  $ wi ph (wbr X M (co (cop F G) W (co O P cup))) $ >
  $ wceq P (cfv E coppc) $ >
  $ wceq O (cfv D coppc) $ >
  $ wi ph (wcel D U) $ >
  $ wi ph (wcel E V) $ >
  $ wi ph (wceq (ctpos G) H) $ >
  $ wi ph (wbr F H (co D E cfunc)) $;

--| Reverse closure for the class of universal property. (Contributed by Zhi Wang, 14-Nov-2025.)
theorem uprcl2a (ph: wff) (P G M O W X: class):
  $ wi ph (wbr X M (co G W (co O P cup))) $ >
  $ wi ph (wcel G (co O P cfunc)) $;

--| Reverse closure for the class of universal property for opposite functors. (Contributed by Zhi Wang, 14-Nov-2025.)
theorem oppfuprcl (ph: wff) (D P U E F G M O V W X: class):
  $ wi ph (wbr X M (co G W (co O P cup))) $ >
  $ wceq G (cfv F coppf) $ >
  $ wceq O (cfv D coppc) $ >
  $ wceq P (cfv E coppc) $ >
  $ wi ph (wcel D U) $ >
  $ wi ph (wcel E V) $ >
  $ wi ph (wcel F (co D E cfunc)) $;

--| Reverse closure for the class of universal property for opposite functors. (Contributed by Zhi Wang, 14-Nov-2025.)
theorem oppfuprcl2 (ph: wff) (A2 B2 D P U E F G M O V W X: class):
  $ wi ph (wbr X M (co G W (co O P cup))) $ >
  $ wceq G (cfv F coppf) $ >
  $ wceq O (cfv D coppc) $ >
  $ wceq P (cfv E coppc) $ >
  $ wi ph (wcel D U) $ >
  $ wi ph (wcel E V) $ >
  $ wi ph (wceq F (cop A2 B2)) $ >
  $ wi ph (wbr A2 B2 (co D E cfunc)) $;

--| Lemma for ~ oppcup3 . (Contributed by Zhi Wang, 4-Nov-2025.)
theorem oppcup3lem {y1 k n l: setvar} (ph: wff y1 k n l) (B2: class k n l) (F G H: class) (J: class k l) (M: class) (N: class y1) (O X Y Z: class):
  $ wi ph (wral y1 (wral n (wreu k (wceq (cv n) (co M (cfv (cv k) (co (cv y1) X G)) (co (cop (cfv (cv y1) F) (cfv X F)) Z O))) (co (cv y1) X H)) (co (cfv (cv y1) F) Z J)) B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel N (co (cfv Y F) Z J)) $ >
  $ wi ph (wreu l (wceq N (co M (cfv (cv l) (co Y X G)) (co (cop (cfv Y F) (cfv X F)) Z O))) (co Y X H)) $;

--| Lemma for ~ oppcup3 . (Contributed by Zhi Wang, 4-Nov-2025.)
theorem oppcup3lem_b {y1 k n: setvar} (ph: wff y1 k n) (B2: class k n) (F G H: class) (J: class k) (M: class) (N: class y1) (O X Y Z: class):
  $ wi ph (wral y1 (wral n (wreu k (wceq (cv n) (co M (cfv (cv k) (co (cv y1) X G)) (co (cop (cfv (cv y1) F) (cfv X F)) Z O))) (co (cv y1) X H)) (co (cfv (cv y1) F) Z J)) B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel N (co (cfv Y F) Z J)) $ >
  $ wi ph (wreu k (wceq N (co M (cfv (cv k) (co Y X G)) (co (cop (cfv Y F) (cfv X F)) Z O))) (co Y X H)) $;

--| The universal pair ` <. X , M >. ` from a functor to an object is universal from an object to a functor in the opposite category. (Contributed by Zhi Wang, 24-Sep-2025.)
theorem oppcup {y1 g2 k: setvar} (ph: wff) (B2 C: class) (D: class y1 g2 k) (P: class) (c_xb E: class y1 g2 k) (F G: class) (H: class y1 g2) (J: class y1 g2 k) (M O W X: class):
  $ wceq B2 (cfv D cbs) $ >
  $ wceq C (cfv E cbs) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq J (cfv E chom) $ >
  $ wceq c_xb (cfv E cco) $ >
  $ wi ph (wcel W C) $ >
  $ wi ph (wbr F G (co D E cfunc)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel M (co (cfv X F) W J)) $ >
  $ wceq O (cfv D coppc) $ >
  $ wceq P (cfv E coppc) $ >
  $ wi ph (wb (wbr X M (co (cop F (ctpos G)) W (co O P cup))) (wral y1 (wral g2 (wreu k (wceq (cv g2) (co M (cfv (cv k) (co (cv y1) X G)) (co (cop (cfv (cv y1) F) (cfv X F)) W c_xb))) (co (cv y1) X H)) (co (cfv (cv y1) F) W J)) B2)) $;

--| The universal property for the universal pair ` <. X , M >. ` from a functor to an object, expressed explicitly. (Contributed by Zhi Wang, 4-Nov-2025.)
theorem oppcup2 {y1 g2 k: setvar} (ph: wff) (B2: class) (D: class y1 g2 k) (P: class) (c_xb: class y1 g2 k) (E F G: class) (H: class y1 g2) (J: class y1 g2 k) (M O W X: class):
  $ wceq B2 (cfv D cbs) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq J (cfv E chom) $ >
  $ wceq c_xb (cfv E cco) $ >
  $ wceq O (cfv D coppc) $ >
  $ wceq P (cfv E coppc) $ >
  $ wi ph (wbr F G (co D E cfunc)) $ >
  $ wi ph (wbr X M (co (cop F (ctpos G)) W (co O P cup))) $ >
  $ wi ph (wral y1 (wral g2 (wreu k (wceq (cv g2) (co M (cfv (cv k) (co (cv y1) X G)) (co (cop (cfv (cv y1) F) (cfv X F)) W c_xb))) (co (cv y1) X H)) (co (cfv (cv y1) F) W J)) B2) $;

--| The universal property for the universal pair ` <. X , M >. ` from a functor to an object, expressed explicitly. (Contributed by Zhi Wang, 4-Nov-2025.)
theorem oppcup3 {k: setvar} (ph: wff) (B2: class) (D: class k) (P c_xb: class) (T: class k) (E F G H: class) (J: class k) (M N O W X Y: class):
  $ wceq B2 (cfv D cbs) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq J (cfv E chom) $ >
  $ wceq c_xb (cfv E cco) $ >
  $ wceq O (cfv D coppc) $ >
  $ wceq P (cfv E coppc) $ >
  $ wi ph (wbr X M (co (cop F T) W (co O P cup))) $ >
  $ wi ph (wceq (ctpos T) G) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel N (co (cfv Y F) W J)) $ >
  $ wi ph (wreu k (wceq N (co M (cfv (cv k) (co Y X G)) (co (cop (cfv Y F) (cfv X F)) W c_xb))) (co Y X H)) $;

--| Lemma for ~ uptr . (Contributed by Zhi Wang, 16-Nov-2025.)
theorem uptrlem1 {g2 h k: setvar} (ph: wff) (A2: class g2 k) (B2: class h k) (C D: class g2 h k) (c_xb: class g2 k) (E: class g2 h k) (F: class) (G: class g2 k) (H: class k) (I: class) (J K: class k) (L: class h k) (M: class g2 h k) (N W X: class) (Y: class k) (c_op: class h k) (Z: class k):
  $ wceq H (cfv C chom) $ >
  $ wceq I (cfv D chom) $ >
  $ wceq J (cfv E chom) $ >
  $ wceq c_xb (cfv D cco) $ >
  $ wceq c_op (cfv E cco) $ >
  $ wi ph (wcel X (cfv D cbs)) $ >
  $ wi ph (wceq (cfv X M) Y) $ >
  $ wi ph (wcel Z (cfv C cbs)) $ >
  $ wi ph (wcel W (cfv C cbs)) $ >
  $ wi ph (wcel A2 (co X (cfv Z F) I)) $ >
  $ wi ph (wceq (cfv A2 (co X (cfv Z F) N)) B2) $ >
  $ wi ph (wbr F G (co C D cfunc)) $ >
  $ wi ph (wbr M N (cin (co D E cful) (co D E cfth))) $ >
  $ wi ph (wceq (co (cop M N) (cop F G) ccofu) (cop K L)) $ >
  $ wi ph (wb (wral h (wreu k (wceq (cv h) (co (cfv (cv k) (co Z W L)) B2 (co (cop Y (cfv Z K)) (cfv W K) c_op))) (co Z W H)) (co Y (cfv W K) J)) (wral g2 (wreu k (wceq (cv g2) (co (cfv (cv k) (co Z W G)) A2 (co (cop X (cfv Z F)) (cfv W F) c_xb))) (co Z W H)) (co X (cfv W F) I))) $;

--| Lemma for ~ uptr . (Contributed by Zhi Wang, 16-Nov-2025.)
theorem uptrlem2 {g2 h k: setvar} (ph: wff) (A2 B2 C D: class g2 h k) (c_xb: class g2 k) (E: class g2 h k) (F: class) (G H: class k) (I: class) (J: class k) (K: class) (M: class g2 k) (N: class h k) (W X: class) (Y: class k) (c_op: class h k) (Z: class k):
  $ wceq H (cfv C chom) $ >
  $ wceq I (cfv D chom) $ >
  $ wceq J (cfv E chom) $ >
  $ wceq c_xb (cfv D cco) $ >
  $ wceq c_op (cfv E cco) $ >
  $ wceq A2 (cfv C cbs) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (cfv X (cfv K c1st)) Y) $ >
  $ wi ph (wcel Z A2) $ >
  $ wi ph (wcel W A2) $ >
  $ wi ph (wcel M (co X (cfv Z (cfv F c1st)) I)) $ >
  $ wi ph (wceq (cfv M (co X (cfv Z (cfv F c1st)) (cfv K c2nd))) N) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wcel K (cin (co D E cful) (co D E cfth))) $ >
  $ wi ph (wceq (co K F ccofu) G) $ >
  $ wi ph (wb (wral h (wreu k (wceq (cv h) (co (cfv (cv k) (co Z W (cfv G c2nd))) N (co (cop Y (cfv Z (cfv G c1st))) (cfv W (cfv G c1st)) c_op))) (co Z W H)) (co Y (cfv W (cfv G c1st)) J)) (wral g2 (wreu k (wceq (cv g2) (co (cfv (cv k) (co Z W (cfv F c2nd))) M (co (cop X (cfv Z (cfv F c1st))) (cfv W (cfv F c1st)) c_xb))) (co Z W H)) (co X (cfv W (cfv F c1st)) I))) $;

--| Lemma for ~ uptr . (Contributed by Zhi Wang, 16-Nov-2025.)
theorem uptrlem3 (ph: wff) (A2 B2 C D R S E F G J K L M N X Y Z: class):
  $ wi ph (wceq (cfv X R) Y) $ >
  $ wi ph (wbr R S (cin (co D E cful) (co D E cfth))) $ >
  $ wi ph (wceq (co (cop R S) (cop F G) ccofu) (cop K L)) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wbr F G (co C D cfunc)) $ >
  $ wi ph (wceq (cfv M (co X (cfv Z F) S)) N) $ >
  $ wceq J (cfv D chom) $ >
  $ wi ph (wcel M (co X (cfv Z F) J)) $ >
  $ wceq A2 (cfv C cbs) $ >
  $ wi ph (wcel Z A2) $ >
  $ wi ph (wb (wbr Z M (co (cop F G) X (co C D cup))) (wbr Z N (co (cop K L) Y (co C E cup)))) $;

--| Universal property and fully faithful functor. (Contributed by Zhi Wang, 16-Nov-2025.)
theorem uptr (ph: wff) (B2 C D R S E F G J K L M N X Y Z: class):
  $ wi ph (wceq (cfv X R) Y) $ >
  $ wi ph (wbr R S (cin (co D E cful) (co D E cfth))) $ >
  $ wi ph (wceq (co (cop R S) (cop F G) ccofu) (cop K L)) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wbr F G (co C D cfunc)) $ >
  $ wi ph (wceq (cfv M (co X (cfv Z F) S)) N) $ >
  $ wceq J (cfv D chom) $ >
  $ wi ph (wcel M (co X (cfv Z F) J)) $ >
  $ wi ph (wb (wbr Z M (co (cop F G) X (co C D cup))) (wbr Z N (co (cop K L) Y (co C E cup)))) $;

--| Universal property and fully faithful functor. (Contributed by Zhi Wang, 16-Nov-2025.)
theorem uptri (ph: wff) (C D R S E F G K L M N X Y Z: class):
  $ wi ph (wceq (cfv X R) Y) $ >
  $ wi ph (wbr R S (cin (co D E cful) (co D E cfth))) $ >
  $ wi ph (wceq (co (cop R S) (cop F G) ccofu) (cop K L)) $ >
  $ wi ph (wceq (cfv M (co X (cfv Z F) S)) N) $ >
  $ wi ph (wbr Z M (co (cop F G) X (co C D cup))) $ >
  $ wi ph (wbr Z N (co (cop K L) Y (co C E cup))) $;

--| Universal property and fully faithful functor. (Contributed by Zhi Wang, 16-Nov-2025.)
theorem uptra (ph: wff) (B2 C D E F G J K M N X Y Z: class):
  $ wi ph (wceq (cfv X (cfv K c1st)) Y) $ >
  $ wi ph (wcel K (cin (co D E cful) (co D E cfth))) $ >
  $ wi ph (wceq (co K F ccofu) G) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wceq (cfv M (co X (cfv Z (cfv F c1st)) (cfv K c2nd))) N) $ >
  $ wceq J (cfv D chom) $ >
  $ wi ph (wcel M (co X (cfv Z (cfv F c1st)) J)) $ >
  $ wi ph (wb (wbr Z M (co F X (co C D cup))) (wbr Z N (co G Y (co C E cup)))) $;

--| Universal property and fully faithful functor. (Contributed by Zhi Wang, 17-Nov-2025.)
theorem uptrar (ph: wff) (B2 C D E F G K M N X Y Z: class):
  $ wi ph (wceq (cfv X (cfv K c1st)) Y) $ >
  $ wi ph (wcel K (cin (co D E cful) (co D E cfth))) $ >
  $ wi ph (wceq (co K F ccofu) G) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wceq (cfv N (ccnv (co X (cfv Z (cfv F c1st)) (cfv K c2nd)))) M) $ >
  $ wi ph (wbr Z N (co G Y (co C E cup))) $ >
  $ wi ph (wbr Z M (co F X (co C D cup))) $;

--| Universal property and fully faithful functor. (Contributed by Zhi Wang, 16-Nov-2025.)
theorem uptrai (ph: wff) (C D E F G K M N X Y Z: class):
  $ wi ph (wceq (cfv X (cfv K c1st)) Y) $ >
  $ wi ph (wcel K (cin (co D E cful) (co D E cfth))) $ >
  $ wi ph (wceq (co K F ccofu) G) $ >
  $ wi ph (wceq (cfv M (co X (cfv Z (cfv F c1st)) (cfv K c2nd))) N) $ >
  $ wi ph (wbr Z M (co F X (co C D cup))) $ >
  $ wi ph (wbr Z N (co G Y (co C E cup))) $;

--| A fully faithful functor generates equal sets of universal objects. (Contributed by Zhi Wang, 19-Nov-2025.)
theorem uobffth (ph: wff) (B2 C D E F G K X Y: class):
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wceq (co K F ccofu) G) $ >
  $ wi ph (wceq (cfv X (cfv K c1st)) Y) $ >
  $ wi ph (wcel K (cin (co D E cful) (co D E cfth))) $ >
  $ wi ph (wceq (cdm (co F X (co C D cup))) (cdm (co G Y (co C E cup)))) $;

--| If a full functor (in fact, a full embedding) is a section of a fully faithful functor (surjective on objects), then the sets of universal objects are equal. (Contributed by Zhi Wang, 17-Nov-2025.)
theorem uobeqw (ph: wff) (B2 C D E F G I K L X Y: class):
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wceq (co K F ccofu) G) $ >
  $ wi ph (wceq (cfv X (cfv K c1st)) Y) $ >
  $ wceq I (cfv D cidfu) $ >
  $ wi ph (wcel K (co D E cful)) $ >
  $ wi ph (wceq (co L K ccofu) I) $ >
  $ wi ph (wcel L (cin (co E D cful) (co E D cfth))) $ >
  $ wi ph (wceq (cdm (co F X (co C D cup))) (cdm (co G Y (co C E cup)))) $;

--| If a full functor (in fact, a full embedding) is a section of a functor (surjective on objects), then the sets of universal objects are equal. (Contributed by Zhi Wang, 17-Nov-2025.)
theorem uobeq (ph: wff) (B2 C D E F G I K L X Y: class):
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wceq (co K F ccofu) G) $ >
  $ wi ph (wceq (cfv X (cfv K c1st)) Y) $ >
  $ wceq I (cfv D cidfu) $ >
  $ wi ph (wcel K (co D E cful)) $ >
  $ wi ph (wceq (co L K ccofu) I) $ >
  $ wi ph (wcel L (co E D cfunc)) $ >
  $ wi ph (wceq (cdm (co F X (co C D cup))) (cdm (co G Y (co C E cup)))) $;

--| Universal property and fully faithful functor surjective on objects. (Contributed by Zhi Wang, 25-Nov-2025.)
theorem uptr2 (ph: wff) (A2 B2 C D R S E F G K L M X Y Z: class):
  $ wceq A2 (cfv C cbs) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wceq Y (cfv X R)) $ >
  $ wi ph (wfo A2 B2 R) $ >
  $ wi ph (wbr R S (cin (co C D cful) (co C D cfth))) $ >
  $ wi ph (wceq (co (cop K L) (cop R S) ccofu) (cop F G)) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wbr K L (co D E cfunc)) $ >
  $ wi ph (wb (wbr X M (co (cop F G) Z (co C E cup))) (wbr Y M (co (cop K L) Z (co D E cup)))) $;

--| Universal property and fully faithful functor surjective on objects. (Contributed by Zhi Wang, 25-Nov-2025.)
theorem uptr2a (ph: wff) (A2 B2 C D E F G K M X Y Z: class):
  $ wceq A2 (cfv C cbs) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wceq Y (cfv X (cfv K c1st))) $ >
  $ wi ph (wceq (co G K ccofu) F) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel G (co D E cfunc)) $ >
  $ wi ph (wcel K (cin (co C D cful) (co C D cfth))) $ >
  $ wi ph (wfo A2 B2 (cfv K c1st)) $ >
  $ wi ph (wb (wbr X M (co F Z (co C E cup))) (wbr Y M (co G Z (co D E cup)))) $;

--| Property of being a natural transformation; deduction form. (Contributed by Zhi Wang, 29-Sep-2025.)
theorem isnatd {x3 y1 h: setvar} (ph: wff) (A2 B2 C D: class) (c_x: class x3 y1 h) (F G: class) (H: class x3 y1) (J: class x3 y1 h) (K L: class) (N: class x3 y1 h):
  $ wceq N (co C D cnat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wceq J (cfv D chom) $ >
  $ wceq c_x (cfv D cco) $ >
  $ wi ph (wbr F G (co C D cfunc)) $ >
  $ wi ph (wbr K L (co C D cfunc)) $ >
  $ wi ph (wfn A2 B2) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wcel (cfv (cv x3) A2) (co (cfv (cv x3) F) (cfv (cv x3) K) J)) $ >
  $ wi (wa (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wcel (cv h) (co (cv x3) (cv y1) H))) (wceq (co (cfv (cv y1) A2) (cfv (cv h) (co (cv x3) (cv y1) G)) (co (cop (cfv (cv x3) F) (cfv (cv y1) F)) (cfv (cv y1) K) c_x)) (co (cfv (cv h) (co (cv x3) (cv y1) L)) (cfv (cv x3) A2) (co (cop (cfv (cv x3) F) (cfv (cv x3) K)) (cfv (cv y1) K) c_x))) $ >
  $ wi ph (wcel A2 (co (cop F G) (cop K L) N)) $;

--| Reverse closure for a natural transformation. (Contributed by Zhi Wang, 1-Oct-2025.)
theorem natrcl2 (ph: wff) (A2 C D F G K L N: class):
  $ wceq N (co C D cnat) $ >
  $ wi ph (wcel A2 (co (cop F G) (cop K L) N)) $ >
  $ wi ph (wbr F G (co C D cfunc)) $;

--| Reverse closure for a natural transformation. (Contributed by Zhi Wang, 1-Oct-2025.)
theorem natrcl3 (ph: wff) (A2 C D F G K L N: class):
  $ wceq N (co C D cnat) $ >
  $ wi ph (wcel A2 (co (cop F G) (cop K L) N)) $ >
  $ wi ph (wbr K L (co C D cfunc)) $;

--| A natural transformation is an exact component function with typed values satisfying naturality. (Contributed by Zhi Wang, 14-Sep-2026.)
theorem isnat3 {x3 y1 h: setvar} (ph: wff) (A2 B2 C D c_x F G H J N: class):
  $ wceq N (co C D cnat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wceq J (cfv D chom) $ >
  $ wceq c_x (cfv D cco) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wcel G (co C D cfunc)) $ >
  $ wi ph (wb (wcel A2 (co F G N)) (w3a (wceq A2 (cmpt x3 B2 (cfv (cv x3) A2))) (wral x3 (wcel (cfv (cv x3) A2) (co (cfv (cv x3) (cfv F c1st)) (cfv (cv x3) (cfv G c1st)) J)) B2) (wral x3 (wral y1 (wral h (wceq (co (cfv (cv y1) A2) (cfv (cv h) (co (cv x3) (cv y1) (cfv F c2nd))) (co (cop (cfv (cv x3) (cfv F c1st)) (cfv (cv y1) (cfv F c1st))) (cfv (cv y1) (cfv G c1st)) c_x)) (co (cfv (cv h) (co (cv x3) (cv y1) (cfv G c2nd))) (cfv (cv x3) A2) (co (cop (cfv (cv x3) (cfv F c1st)) (cfv (cv x3) (cfv G c1st))) (cfv (cv y1) (cfv G c1st)) c_x))) (co (cv x3) (cv y1) H)) B2) B2))) $;

--| A natural transformation is a function on the objects of the source category. (Contributed by Zhi Wang, 14-Sep-2026.)
theorem natfn2 (ph: wff) (A2 B2 C D F G N: class):
  $ wceq N (co C D cnat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel A2 (co F G N)) $ >
  $ wi ph (wfn A2 B2) $;

--| Two natural transformations with the same source and target are equal exactly when all their components agree. (Contributed by Zhi Wang, 14-Sep-2026.)
theorem nateq {x3: setvar} (ph: wff) (A2 B2: class) (C D F G: class x3) (L: class) (N: class x3):
  $ wceq N (co C D cnat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel A2 (co F G N)) $ >
  $ wi ph (wcel L (co F G N)) $ >
  $ wi ph (wb (wceq A2 L) (wral x3 (wceq (cfv (cv x3) A2) (cfv (cv x3) L)) B2)) $;

--| A natural transformation is an identity exactly when all its components are identities. This also covers an empty object set. (Contributed by Zhi Wang, 14-Sep-2026.)
theorem natideq {x3: setvar} (ph: wff) (A2 B2 C D Q F I J N: class):
  $ wceq Q (co C D cfuc) $ >
  $ wceq N (co C D cnat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq I (cfv Q ccid) $ >
  $ wceq J (cfv D ccid) $ >
  $ wi ph (wcel A2 (co F F N)) $ >
  $ wi ph (wb (wceq A2 (cfv F I)) (wral x3 (wceq (cfv (cv x3) A2) (cfv (cfv (cv x3) (cfv F c1st)) J)) B2)) $;

--| A natural transformation equals a composite exactly when all its components equal the corresponding composites, including when the object set is empty. (Contributed by Zhi Wang, 14-Sep-2026.)
theorem natcoeq {x3: setvar} (ph: wff) (A2 B2 C D Q R c_x F G H L N c_op: class):
  $ wceq Q (co C D cfuc) $ >
  $ wceq N (co C D cnat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq c_op (cfv D cco) $ >
  $ wceq c_x (cfv Q cco) $ >
  $ wi ph (wcel A2 (co F G N)) $ >
  $ wi ph (wcel R (co G H N)) $ >
  $ wi ph (wcel L (co F H N)) $ >
  $ wi ph (wb (wceq L (co R A2 (co (cop F G) H c_x))) (wral x3 (wceq (cfv (cv x3) L) (co (cfv (cv x3) R) (cfv (cv x3) A2) (co (cop (cfv (cv x3) (cfv F c1st)) (cfv (cv x3) (cfv G c1st))) (cfv (cv x3) (cfv H c1st)) c_op))) B2)) $;

--| Componentwise functor laws for a correctly typed hom-family into a functor category. The source category ` T ` and object assignment ` O ` are arbitrary: the identity and composition laws are equivalent to their component equations. No functor law is assumed in the hypotheses. Functor composition is an application in ~ fucoisfunc2 . (Contributed by Zhi Wang, 14-Sep-2026.)
theorem fucidcobi {x3 y1 z v t m n: setvar} (ph: wff v) (B2 C P Q c_xb T c_x E H I J K O W c_op: class):
  $ wceq W (cfv T cbs) $ >
  $ wceq Q (co C E cfuc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq H (cfv T chom) $ >
  $ wceq I (cfv T ccid) $ >
  $ wceq J (cfv Q ccid) $ >
  $ wceq K (cfv E ccid) $ >
  $ wceq c_x (cfv T cco) $ >
  $ wceq c_op (cfv Q cco) $ >
  $ wceq c_xb (cfv E cco) $ >
  $ wi ph (wcel T ccat) $ >
  $ wi ph (wcel P (cixp v (cxp W W) (co (co (cfv (cfv (cv v) c1st) O) (cfv (cfv (cv v) c2nd) O) (co C E cnat)) (cfv (cv v) H) cmap))) $ >
  $ wi ph (wb (wral x3 (wa (wceq (cfv (cfv (cv x3) I) (co (cv x3) (cv x3) P)) (cfv (cfv (cv x3) O) J)) (wral y1 (wral z (wral m (wral n (wceq (cfv (co (cv n) (cv m) (co (cop (cv x3) (cv y1)) (cv z) c_x)) (co (cv x3) (cv z) P)) (co (cfv (cv n) (co (cv y1) (cv z) P)) (cfv (cv m) (co (cv x3) (cv y1) P)) (co (cop (cfv (cv x3) O) (cfv (cv y1) O)) (cfv (cv z) O) c_op))) (co (cv y1) (cv z) H)) (co (cv x3) (cv y1) H)) W) W)) W) (wral x3 (wa (wral t (wceq (cfv (cv t) (cfv (cfv (cv x3) I) (co (cv x3) (cv x3) P))) (cfv (cfv (cv t) (cfv (cfv (cv x3) O) c1st)) K)) B2) (wral y1 (wral z (wral m (wral n (wral t (wceq (cfv (cv t) (cfv (co (cv n) (cv m) (co (cop (cv x3) (cv y1)) (cv z) c_x)) (co (cv x3) (cv z) P))) (co (cfv (cv t) (cfv (cv n) (co (cv y1) (cv z) P))) (cfv (cv t) (cfv (cv m) (co (cv x3) (cv y1) P))) (co (cop (cfv (cv t) (cfv (cfv (cv x3) O) c1st)) (cfv (cv t) (cfv (cfv (cv y1) O) c1st))) (cfv (cv t) (cfv (cfv (cv z) O) c1st)) c_xb))) B2) (co (cv y1) (cv z) H)) (co (cv x3) (cv y1) H)) W) W)) W)) $;

--| The base of the category structure. (Contributed by Zhi Wang, 5-Nov-2025.)
theorem catbas (B2 C c_x H: class):
  $ wceq C (ctp (cop (cfv cnx cbs) B2) (cop (cfv cnx chom) H) (cop (cfv cnx cco) c_x)) $ >
  $ wcel B2 cvv $ >
  $ wceq B2 (cfv C cbs) $;

--| The hom-sets of the category structure. (Contributed by Zhi Wang, 5-Nov-2025.)
theorem cathomfval (B2 C c_x H: class):
  $ wceq C (ctp (cop (cfv cnx cbs) B2) (cop (cfv cnx chom) H) (cop (cfv cnx cco) c_x)) $ >
  $ wcel H cvv $ >
  $ wceq H (cfv C chom) $;

--| Composition of the category structure. (Contributed by Zhi Wang, 5-Nov-2025.)
theorem catcofval (B2 C c_x H: class):
  $ wceq C (ctp (cop (cfv cnx cbs) B2) (cop (cfv cnx chom) H) (cop (cfv cnx cco) c_x)) $ >
  $ wcel c_x cvv $ >
  $ wceq c_x (cfv C cco) $;

--| A natural transformation is natural between opposite functors. (Contributed by Zhi Wang, 18-Nov-2025.)
theorem natoppf (ph: wff) (A2 C D P F G K L M N O: class):
  $ wceq O (cfv C coppc) $ >
  $ wceq P (cfv D coppc) $ >
  $ wceq N (co C D cnat) $ >
  $ wceq M (co O P cnat) $ >
  $ wi ph (wcel A2 (co (cop F G) (cop K L) N)) $ >
  $ wi ph (wcel A2 (co (cop K (ctpos L)) (cop F (ctpos G)) M)) $;

--| A natural transformation is natural between opposite functors. (Contributed by Zhi Wang, 18-Nov-2025.)
theorem natoppf2 (ph: wff) (A2 C D P F G K L M N O: class):
  $ wceq O (cfv C coppc) $ >
  $ wceq P (cfv D coppc) $ >
  $ wceq N (co C D cnat) $ >
  $ wceq M (co O P cnat) $ >
  $ wi ph (wceq K (cfv F coppf)) $ >
  $ wi ph (wceq L (cfv G coppf)) $ >
  $ wi ph (wcel A2 (co F G N)) $ >
  $ wi ph (wcel A2 (co L K M)) $;

--| A natural transformation is natural between opposite functors, and vice versa. (Contributed by Zhi Wang, 18-Nov-2025.)
theorem natoppfb (ph: wff) (C D P F G K L M N O V W: class):
  $ wceq O (cfv C coppc) $ >
  $ wceq P (cfv D coppc) $ >
  $ wceq N (co C D cnat) $ >
  $ wceq M (co O P cnat) $ >
  $ wi ph (wceq K (cfv F coppf)) $ >
  $ wi ph (wceq L (cfv G coppf)) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wcel D W) $ >
  $ wi ph (wceq (co F G N) (co L K M)) $;

--| An initial object is an object in the base set. (Contributed by Zhi Wang, 23-Oct-2025.)
theorem initoo2 (B2 C O: class):
  $ wceq B2 (cfv C cbs) $ >
  $ wi (wcel O (cfv C cinito)) (wcel O B2) $;

--| A terminal object is an object in the base set. (Contributed by Zhi Wang, 23-Oct-2025.)
theorem termoo2 (B2 C O: class):
  $ wceq B2 (cfv C cbs) $ >
  $ wi (wcel O (cfv C ctermo)) (wcel O B2) $;

--| A zero object is an object in the base set. (Contributed by Zhi Wang, 23-Oct-2025.)
theorem zeroo2 (B2 C O: class):
  $ wceq B2 (cfv C cbs) $ >
  $ wi (wcel O (cfv C czeroo)) (wcel O B2) $;

--| Initial objects are terminal in the opposite category. (Contributed by Zhi Wang, 23-Oct-2025.)
theorem oppcinito (C I: class):
  $ wb (wcel I (cfv C cinito)) (wcel I (cfv (cfv C coppc) ctermo)) $;

--| Terminal objects are initial in the opposite category. Comments before Definition 7.4 in [Adamek] p. 102. (Contributed by Zhi Wang, 26-Oct-2025.)
theorem oppctermo (C I: class):
  $ wb (wcel I (cfv C ctermo)) (wcel I (cfv (cfv C coppc) cinito)) $;

--| Zero objects are zero in the opposite category. Remark 7.8 of [Adamek] p. 103. (Contributed by Zhi Wang, 27-Oct-2025.)
theorem oppczeroo (C I: class):
  $ wb (wcel I (cfv C czeroo)) (wcel I (cfv (cfv C coppc) czeroo)) $;

--| Terminal objects are essentially unique; if ` A ` is a terminal object, then so is every object that is isomorphic to ` A ` . (Contributed by Zhi Wang, 26-Oct-2025.)
theorem termoeu2 (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel A2 (cfv C ctermo)) $ >
  $ wi ph (wbr A2 B2 (cfv C ccic)) $ >
  $ wi ph (wcel B2 (cfv C ctermo)) $;

--| Lemma for ~ initopropdlem , ~ termopropdlem , and ~ zeroopropdlem . (Contributed by Zhi Wang, 26-Oct-2025.)
theorem initopropdlemlem (ph: wff) (A2 B2 F X Y: class):
  $ wfn F X $ >
  $ wi ph (wn (wcel A2 Y)) $ >
  $ wss X Y $ >
  $ wi (wa ph (wcel B2 X)) (wceq (cfv B2 F) c0) $ >
  $ wi ph (wceq (cfv A2 F) (cfv B2 F)) $;

--| Lemma for ~ initopropd . (Contributed by Zhi Wang, 26-Oct-2025.)
theorem initopropdlem (ph: wff) (C D: class):
  $ wi ph (wceq (cfv C chomf) (cfv D chomf)) $ >
  $ wi ph (wceq (cfv C ccomf) (cfv D ccomf)) $ >
  $ wi ph (wn (wcel C cvv)) $ >
  $ wi ph (wceq (cfv C cinito) (cfv D cinito)) $;

--| Lemma for ~ termopropd . (Contributed by Zhi Wang, 26-Oct-2025.)
theorem termopropdlem (ph: wff) (C D: class):
  $ wi ph (wceq (cfv C chomf) (cfv D chomf)) $ >
  $ wi ph (wceq (cfv C ccomf) (cfv D ccomf)) $ >
  $ wi ph (wn (wcel C cvv)) $ >
  $ wi ph (wceq (cfv C ctermo) (cfv D ctermo)) $;

--| Lemma for ~ zeroopropd . (Contributed by Zhi Wang, 26-Oct-2025.)
theorem zeroopropdlem (ph: wff) (C D: class):
  $ wi ph (wceq (cfv C chomf) (cfv D chomf)) $ >
  $ wi ph (wceq (cfv C ccomf) (cfv D ccomf)) $ >
  $ wi ph (wn (wcel C cvv)) $ >
  $ wi ph (wceq (cfv C czeroo) (cfv D czeroo)) $;

--| Two structures with the same base, hom-sets and composition operation have the same initial objects. (Contributed by Zhi Wang, 23-Oct-2025.)
theorem initopropd (ph: wff) (C D: class):
  $ wi ph (wceq (cfv C chomf) (cfv D chomf)) $ >
  $ wi ph (wceq (cfv C ccomf) (cfv D ccomf)) $ >
  $ wi ph (wceq (cfv C cinito) (cfv D cinito)) $;

--| Two structures with the same base, hom-sets and composition operation have the same terminal objects. (Contributed by Zhi Wang, 26-Oct-2025.)
theorem termopropd (ph: wff) (C D: class):
  $ wi ph (wceq (cfv C chomf) (cfv D chomf)) $ >
  $ wi ph (wceq (cfv C ccomf) (cfv D ccomf)) $ >
  $ wi ph (wceq (cfv C ctermo) (cfv D ctermo)) $;

--| Two structures with the same base, hom-sets and composition operation have the same zero objects. (Contributed by Zhi Wang, 26-Oct-2025.)
theorem zeroopropd (ph: wff) (C D: class):
  $ wi ph (wceq (cfv C chomf) (cfv D chomf)) $ >
  $ wi ph (wceq (cfv C ccomf) (cfv D ccomf)) $ >
  $ wi ph (wceq (cfv C czeroo) (cfv D czeroo)) $;

--| The binary product of categories is a proper operator, so it can be used with ~ ovprc1 , ~ elbasov , ~ strov2rcl , and so on. See ~ reldmxpcALT for an alternate proof with less "essential steps" but more "bytes". (Proposed by SN, 15-Oct-2025.) (Contributed by Zhi Wang, 15-Oct-2025.)
theorem reldmxpc:
  $ wrel (cdm cxpc) $;

--| Alternate proof of ~ reldmxpc . (Contributed by Zhi Wang, 15-Oct-2025.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem reldmxpcALT:
  $ wrel (cdm cxpc) $;

--| A non-empty base set of the product category indicates the existence of the first factor of the product category. (Contributed by Zhi Wang, 8-Oct-2025.) (Proof shortened by SN, 15-Oct-2025.)
theorem elxpcbasex1 (ph: wff) (B2 C D T X: class):
  $ wceq T (co C D cxpc) $ >
  $ wceq B2 (cfv T cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel C cvv) $;

--| Alternate proof of ~ elxpcbasex1 . (Contributed by Zhi Wang, 8-Oct-2025.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem elxpcbasex1ALT (ph: wff) (B2 C D T X: class):
  $ wceq T (co C D cxpc) $ >
  $ wceq B2 (cfv T cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel C cvv) $;

--| A non-empty base set of the product category indicates the existence of the second factor of the product category. (Contributed by Zhi Wang, 8-Oct-2025.) (Proof shortened by SN, 15-Oct-2025.)
theorem elxpcbasex2 (ph: wff) (B2 C D T X: class):
  $ wceq T (co C D cxpc) $ >
  $ wceq B2 (cfv T cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel D cvv) $;

--| Alternate proof of ~ elxpcbasex2 . (Contributed by Zhi Wang, 8-Oct-2025.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem elxpcbasex2ALT (ph: wff) (B2 C D T X: class):
  $ wceq T (co C D cxpc) $ >
  $ wceq B2 (cfv T cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel D cvv) $;

--| The base set of the product of two categories of functors. (Contributed by Zhi Wang, 1-Oct-2025.)
theorem xpcfucbas (B2 C D T E: class):
  $ wceq T (co (co B2 C cfuc) (co D E cfuc) cxpc) $ >
  $ wceq (cxp (co B2 C cfunc) (co D E cfunc)) (cfv T cbs) $;

--| Set of morphisms of the binary product of categories of functors. (Contributed by Zhi Wang, 1-Oct-2025.)
theorem xpcfuchomfval {v u: setvar} (A2 B2 C D: class) (T: class v u) (E: class) (K: class v u):
  $ wceq T (co (co B2 C cfuc) (co D E cfuc) cxpc) $ >
  $ wceq A2 (cfv T cbs) $ >
  $ wceq K (cfv T chom) $ >
  $ wceq K (cmpo u v A2 A2 (cxp (co (cfv (cv u) c1st) (cfv (cv v) c1st) (co B2 C cnat)) (co (cfv (cv u) c2nd) (cfv (cv v) c2nd) (co D E cnat)))) $;

--| Set of morphisms of the binary product of categories of functors. (Contributed by Zhi Wang, 1-Oct-2025.)
theorem xpcfuchom (ph: wff) (A2 B2 C D T E K X Y: class):
  $ wceq T (co (co B2 C cfuc) (co D E cfuc) cxpc) $ >
  $ wceq A2 (cfv T cbs) $ >
  $ wceq K (cfv T chom) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y A2) $ >
  $ wi ph (wceq (co X Y K) (cxp (co (cfv X c1st) (cfv Y c1st) (co B2 C cnat)) (co (cfv X c2nd) (cfv Y c2nd) (co D E cnat)))) $;

--| Value of the set of morphisms in the binary product of categories of functors. (Contributed by Zhi Wang, 1-Oct-2025.)
theorem xpcfuchom2 (ph: wff) (B2 C D P Q T E K M N: class):
  $ wceq T (co (co B2 C cfuc) (co D E cfuc) cxpc) $ >
  $ wi ph (wcel M (co B2 C cfunc)) $ >
  $ wi ph (wcel N (co D E cfunc)) $ >
  $ wi ph (wcel P (co B2 C cfunc)) $ >
  $ wi ph (wcel Q (co D E cfunc)) $ >
  $ wceq K (cfv T chom) $ >
  $ wi ph (wceq (co (cop M N) (cop P Q) K) (cxp (co M P (co B2 C cnat)) (co N Q (co D E cnat)))) $;

--| Value of composition in the binary product of categories of functors. (Contributed by Zhi Wang, 1-Oct-2025.)
theorem xpcfucco2 (ph: wff) (B2 C D P Q R S T E F G K L M N O: class):
  $ wceq T (co (co B2 C cfuc) (co D E cfuc) cxpc) $ >
  $ wceq O (cfv T cco) $ >
  $ wi ph (wcel F (co M P (co B2 C cnat))) $ >
  $ wi ph (wcel G (co N Q (co D E cnat))) $ >
  $ wi ph (wcel K (co P R (co B2 C cnat))) $ >
  $ wi ph (wcel L (co Q S (co D E cnat))) $ >
  $ wi ph (wceq (co (cop K L) (cop F G) (co (cop (cop M N) (cop P Q)) (cop R S) O)) (cop (co K F (co (cop M P) R (cfv (co B2 C cfuc) cco))) (co L G (co (cop N Q) S (cfv (co D E cfuc) cco))))) $;

--| The composition of two natural transformations is a natural transformation. (Contributed by Zhi Wang, 1-Oct-2025.)
theorem xpcfuccocl (ph: wff) (B2 C D P Q R S T E F G K L M N O: class):
  $ wceq T (co (co B2 C cfuc) (co D E cfuc) cxpc) $ >
  $ wceq O (cfv T cco) $ >
  $ wi ph (wcel F (co M P (co B2 C cnat))) $ >
  $ wi ph (wcel G (co N Q (co D E cnat))) $ >
  $ wi ph (wcel K (co P R (co B2 C cnat))) $ >
  $ wi ph (wcel L (co Q S (co D E cnat))) $ >
  $ wi ph (wcel (co (cop K L) (cop F G) (co (cop (cop M N) (cop P Q)) (cop R S) O)) (cxp (co M R (co B2 C cnat)) (co N S (co D E cnat)))) $;

--| Value of composition in the binary product of categories of functors; expressed explicitly. (Contributed by Zhi Wang, 1-Oct-2025.)
theorem xpcfucco3 {x3 y1: setvar} (ph: wff) (B2 C: class y1) (D: class x3) (P: class y1) (Q: class x3) (R: class y1) (S c_xb: class x3) (T: class x3 y1) (c_x: class y1) (E: class x3) (F: class y1) (G: class x3) (K: class y1) (L: class x3) (M: class y1) (N: class x3) (O: class x3 y1) (X: class y1) (Y: class x3):
  $ wceq T (co (co B2 C cfuc) (co D E cfuc) cxpc) $ >
  $ wceq O (cfv T cco) $ >
  $ wi ph (wcel F (co M P (co B2 C cnat))) $ >
  $ wi ph (wcel G (co N Q (co D E cnat))) $ >
  $ wi ph (wcel K (co P R (co B2 C cnat))) $ >
  $ wi ph (wcel L (co Q S (co D E cnat))) $ >
  $ wceq X (cfv B2 cbs) $ >
  $ wceq Y (cfv D cbs) $ >
  $ wceq c_x (cfv C cco) $ >
  $ wceq c_xb (cfv E cco) $ >
  $ wi ph (wceq (co (cop K L) (cop F G) (co (cop (cop M N) (cop P Q)) (cop R S) O)) (cop (cmpt x3 X (co (cfv (cv x3) K) (cfv (cv x3) F) (co (cop (cfv (cv x3) (cfv M c1st)) (cfv (cv x3) (cfv P c1st))) (cfv (cv x3) (cfv R c1st)) c_x))) (cmpt y1 Y (co (cfv (cv y1) L) (cfv (cv y1) G) (co (cop (cfv (cv y1) (cfv N c1st)) (cfv (cv y1) (cfv Q c1st))) (cfv (cv y1) (cfv S c1st)) c_xb))))) $;

--| Value of composition in the binary product of categories of functors; expressed explicitly. (Contributed by Zhi Wang, 1-Oct-2025.)
theorem xpcfucco3_b {x3: setvar} (ph: wff) (B2 C D P Q R S c_xb: class) (T: class x3) (c_x E F G K L M N: class) (O: class x3) (X Y: class):
  $ wceq T (co (co B2 C cfuc) (co D E cfuc) cxpc) $ >
  $ wceq O (cfv T cco) $ >
  $ wi ph (wcel F (co M P (co B2 C cnat))) $ >
  $ wi ph (wcel G (co N Q (co D E cnat))) $ >
  $ wi ph (wcel K (co P R (co B2 C cnat))) $ >
  $ wi ph (wcel L (co Q S (co D E cnat))) $ >
  $ wceq X (cfv B2 cbs) $ >
  $ wceq Y (cfv D cbs) $ >
  $ wceq c_x (cfv C cco) $ >
  $ wceq c_xb (cfv E cco) $ >
  $ wi ph (wceq (co (cop K L) (cop F G) (co (cop (cop M N) (cop P Q)) (cop R S) O)) (cop (cmpt x3 X (co (cfv (cv x3) K) (cfv (cv x3) F) (co (cop (cfv (cv x3) (cfv M c1st)) (cfv (cv x3) (cfv P c1st))) (cfv (cv x3) (cfv R c1st)) c_x))) (cmpt x3 Y (co (cfv (cv x3) L) (cfv (cv x3) G) (co (cop (cfv (cv x3) (cfv N c1st)) (cfv (cv x3) (cfv Q c1st))) (cfv (cv x3) (cfv S c1st)) c_xb))))) $;

--| Extend class notation with the class of swap functors.
term cswapf: class;

--| Define the swap functor from ` ( C Xc. D ) ` to ` ( D Xc. C ) ` by swapping all objects ( ~ swapf1 ) and morphisms ( ~ swapf2 ) . Such functor is called a "swap functor" in ~ https://arxiv.org/pdf/2302.07810 or a "twist functor" in ~ https://arxiv.org/pdf/2508.01886 , the latter of which finds its counterpart as "twisting map" in ~ https://arxiv.org/pdf/2411.04102 for tensor product of algebras. The "swap functor" or "twisting map" is often denoted as a small tau ` ta ` in literature. However, the term "twist functor" is defined differently in ~ https://arxiv.org/pdf/1208.4046 and thus not adopted here. ` tpos _I ` depends on more mathbox theorems, and thus are not adopted here. See ~ dfswapf2 for an alternate definition. (Contributed by Zhi Wang, 7-Oct-2025.)
axiom df_swapf {x3 v u f2 h s1 b c d: setvar}:
  $ wceq cswapf (cmpo c d cvv cvv (csb s1 (co (cv c) (cv d) cxpc) (csb b (cfv (cv s1) cbs) (csb h (cfv (cv s1) chom) (cop (cmpt x3 (cv b) (cuni (ccnv (csn (cv x3))))) (cmpo u v (cv b) (cv b) (cmpt f2 (co (cv u) (cv v) (cv h)) (cuni (ccnv (csn (cv f2))))))))))) $;

--| Alternate definition of ` swapF ` ( ~ df-swapf ). (Contributed by Zhi Wang, 9-Oct-2025.)
theorem dfswapf2 {v u h s1 b c d: setvar}:
  $ wceq cswapf (cmpo c d cvv cvv (csb s1 (co (cv c) (cv d) cxpc) (csb b (cfv (cv s1) cbs) (csb h (cfv (cv s1) chom) (cop (cres (ctpos cid) (cv b)) (cmpo u v (cv b) (cv b) (cres (ctpos cid) (co (cv u) (cv v) (cv h))))))))) $;

--| Value of the swap functor. (Contributed by Zhi Wang, 7-Oct-2025.)
theorem swapfval {x3 v u f2: setvar} (ph: wff x3 f2) (B2: class f2) (C D S: class x3 f2) (U: class x3 v u f2) (H: class x3) (V: class x3 v u f2):
  $ wi ph (wcel C U) $ >
  $ wi ph (wcel D V) $ >
  $ wceq S (co C D cxpc) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wceq H (cfv S chom)) $ >
  $ wi ph (wceq (co C D cswapf) (cop (cmpt x3 B2 (cuni (ccnv (csn (cv x3))))) (cmpo u v B2 B2 (cmpt f2 (co (cv u) (cv v) H) (cuni (ccnv (csn (cv f2)))))))) $;

--| A swap functor is an ordered pair. (Contributed by Zhi Wang, 7-Oct-2025.)
theorem swapfelvv (ph: wff) (C D U V: class):
  $ wi ph (wcel C U) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel (co C D cswapf) (cxp cvv cvv)) $;

--| The morphism part of the swap functor. See also ~ swapf2fval . (Contributed by Zhi Wang, 7-Oct-2025.)
theorem swapf2fvala {v u f2: setvar} (ph: wff f2) (B2 C D S: class f2) (U: class v u f2) (H: class) (V: class v u f2):
  $ wi ph (wcel C U) $ >
  $ wi ph (wcel D V) $ >
  $ wceq S (co C D cxpc) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wceq H (cfv S chom)) $ >
  $ wi ph (wceq (cfv (co C D cswapf) c2nd) (cmpo u v B2 B2 (cmpt f2 (co (cv u) (cv v) H) (cuni (ccnv (csn (cv f2))))))) $;

--| The morphism part of the swap functor. See also ~ swapf2fvala . (Contributed by Zhi Wang, 7-Oct-2025.)
theorem swapf2fval {v u f2: setvar} (ph: wff f2) (B2 C D: class f2) (P: class v u f2) (S: class f2) (U: class v u f2) (H: class) (O V: class v u f2):
  $ wi ph (wcel C U) $ >
  $ wi ph (wcel D V) $ >
  $ wceq S (co C D cxpc) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wceq H (cfv S chom)) $ >
  $ wi ph (wceq (co C D cswapf) (cop O P)) $ >
  $ wi ph (wceq P (cmpo u v B2 B2 (cmpt f2 (co (cv u) (cv v) H) (cuni (ccnv (csn (cv f2))))))) $;

--| The object part of the swap functor. See also ~ swapf1val . (Contributed by Zhi Wang, 7-Oct-2025.)
theorem swapf1vala {x3: setvar} (ph: wff x3) (B2: class) (C D S U V: class x3):
  $ wi ph (wcel C U) $ >
  $ wi ph (wcel D V) $ >
  $ wceq S (co C D cxpc) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wceq (cfv (co C D cswapf) c1st) (cmpt x3 B2 (cuni (ccnv (csn (cv x3)))))) $;

--| The object part of the swap functor. See also ~ swapf1vala . (Contributed by Zhi Wang, 7-Oct-2025.)
theorem swapf1val {x3: setvar} (ph: wff x3) (B2: class) (C D P S U O V: class x3):
  $ wi ph (wcel C U) $ >
  $ wi ph (wcel D V) $ >
  $ wceq S (co C D cxpc) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wceq (co C D cswapf) (cop O P)) $ >
  $ wi ph (wceq O (cmpt x3 B2 (cuni (ccnv (csn (cv x3)))))) $;

--| The morphism part of the swap functor is a function on the Cartesian square of the base set. (Contributed by Zhi Wang, 7-Oct-2025.)
theorem swapf2fn (ph: wff) (B2 C D P S U O V: class):
  $ wi ph (wcel C U) $ >
  $ wi ph (wcel D V) $ >
  $ wceq S (co C D cxpc) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wceq (co C D cswapf) (cop O P)) $ >
  $ wi ph (wfn P (cxp B2 B2)) $;

--| The object part of the swap functor swaps the objects. (Contributed by Zhi Wang, 7-Oct-2025.)
theorem swapf1a (ph: wff) (B2 C D P S O X: class):
  $ wi ph (wceq (co C D cswapf) (cop O P)) $ >
  $ wceq S (co C D cxpc) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (cfv X O) (cop (cfv X c2nd) (cfv X c1st))) $;

--| The morphism part of the swap functor swaps the morphisms. (Contributed by Zhi Wang, 7-Oct-2025.)
theorem swapf2vala {f2: setvar} (ph: wff f2) (B2 C D P S: class f2) (H: class) (O: class f2) (X Y: class):
  $ wi ph (wceq (co C D cswapf) (cop O P)) $ >
  $ wceq S (co C D cxpc) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq H (cfv S chom)) $ >
  $ wi ph (wceq (co X Y P) (cmpt f2 (co X Y H) (cuni (ccnv (csn (cv f2)))))) $;

--| The morphism part of the swap functor swaps the morphisms. (Contributed by Zhi Wang, 7-Oct-2025.)
theorem swapf2a (ph: wff) (B2 C D P S F H O X Y: class):
  $ wi ph (wceq (co C D cswapf) (cop O P)) $ >
  $ wceq S (co C D cxpc) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq H (cfv S chom)) $ >
  $ wi ph (wcel F (co X Y H)) $ >
  $ wi ph (wceq (cfv F (co X Y P)) (cop (cfv F c2nd) (cfv F c1st))) $;

--| The object part of the swap functor swaps the objects. (Contributed by Zhi Wang, 7-Oct-2025.)
theorem swapf1 (ph: wff) (C D P O X Y: class):
  $ wi ph (wceq (co C D cswapf) (cop O P)) $ >
  $ wi ph (wcel X (cfv C cbs)) $ >
  $ wi ph (wcel Y (cfv D cbs)) $ >
  $ wi ph (wceq (co X Y O) (cop Y X)) $;

--| The morphism part of the swap functor swaps the morphisms. (Contributed by Zhi Wang, 7-Oct-2025.)
theorem swapf2val {f2: setvar} (ph: wff f2) (C D P S: class f2) (H: class) (O: class f2) (W X Y Z: class):
  $ wi ph (wceq (co C D cswapf) (cop O P)) $ >
  $ wi ph (wcel X (cfv C cbs)) $ >
  $ wi ph (wcel Y (cfv D cbs)) $ >
  $ wi ph (wcel Z (cfv C cbs)) $ >
  $ wi ph (wcel W (cfv D cbs)) $ >
  $ wceq S (co C D cxpc) $ >
  $ wi ph (wceq H (cfv S chom)) $ >
  $ wi ph (wceq (co (cop X Y) (cop Z W) P) (cmpt f2 (co (cop X Y) (cop Z W) H) (cuni (ccnv (csn (cv f2)))))) $;

--| The morphism part of the swap functor swaps the morphisms. (Contributed by Zhi Wang, 7-Oct-2025.)
theorem swapf2 (ph: wff) (C D P F G O W X Y Z: class):
  $ wi ph (wceq (co C D cswapf) (cop O P)) $ >
  $ wi ph (wcel X (cfv C cbs)) $ >
  $ wi ph (wcel Y (cfv D cbs)) $ >
  $ wi ph (wcel Z (cfv C cbs)) $ >
  $ wi ph (wcel W (cfv D cbs)) $ >
  $ wi ph (wcel F (co X Z (cfv C chom))) $ >
  $ wi ph (wcel G (co Y W (cfv D chom))) $ >
  $ wi ph (wceq (co F G (co (cop X Y) (cop Z W) P)) (cop G F)) $;

--| The object part of the swap functor is a bijection between base sets. (Contributed by Zhi Wang, 8-Oct-2025.)
theorem swapf1f1o (ph: wff) (A2 B2 C D P S T U O V: class):
  $ wi ph (wceq (co C D cswapf) (cop O P)) $ >
  $ wceq S (co C D cxpc) $ >
  $ wceq T (co D C cxpc) $ >
  $ wi ph (wcel C U) $ >
  $ wi ph (wcel D V) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq A2 (cfv T cbs) $ >
  $ wi ph (wf1o B2 A2 O) $;

--| The morphism part of the swap functor is a bijection between hom-sets. (Contributed by Zhi Wang, 8-Oct-2025.)
theorem swapf2f1o (ph: wff) (C D P S T H J O W X Y Z: class):
  $ wi ph (wceq (co C D cswapf) (cop O P)) $ >
  $ wceq S (co C D cxpc) $ >
  $ wceq T (co D C cxpc) $ >
  $ wceq H (cfv S chom) $ >
  $ wceq J (cfv T chom) $ >
  $ wi ph (wcel X (cfv C cbs)) $ >
  $ wi ph (wcel Y (cfv D cbs)) $ >
  $ wi ph (wcel Z (cfv C cbs)) $ >
  $ wi ph (wcel W (cfv D cbs)) $ >
  $ wi ph (wf1o (co (cop X Y) (cop Z W) H) (co (cop Y X) (cop W Z) J) (co (cop X Y) (cop Z W) P)) $;

--| The morphism part of the swap functor is a bijection between hom-sets. (Contributed by Zhi Wang, 9-Oct-2025.)
theorem swapf2f1oa (ph: wff) (B2 C D P S T H J O X Y: class):
  $ wi ph (wceq (co C D cswapf) (cop O P)) $ >
  $ wceq S (co C D cxpc) $ >
  $ wceq T (co D C cxpc) $ >
  $ wceq H (cfv S chom) $ >
  $ wceq J (cfv T chom) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wf1o (co X Y H) (co (cfv X O) (cfv Y O) J) (co X Y P)) $;

--| Alternate proof of ~ swapf2f1oa . (Contributed by Zhi Wang, 8-Oct-2025.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem swapf2f1oaALT (ph: wff) (B2 C D P S T H J O X Y: class):
  $ wi ph (wceq (co C D cswapf) (cop O P)) $ >
  $ wceq S (co C D cxpc) $ >
  $ wceq T (co D C cxpc) $ >
  $ wceq H (cfv S chom) $ >
  $ wceq J (cfv T chom) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wf1o (co X Y H) (co (cfv X O) (cfv Y O) J) (co X Y P)) $;

--| Each identity morphism in the source category is mapped to the corresponding identity morphism in the target category. See also ~ swapfida . (Contributed by Zhi Wang, 8-Oct-2025.)
theorem swapfid (ph: wff) (C D P S T c_1 I O X Y: class):
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wceq S (co C D cxpc) $ >
  $ wceq T (co D C cxpc) $ >
  $ wi ph (wceq (co C D cswapf) (cop O P)) $ >
  $ wi ph (wcel X (cfv C cbs)) $ >
  $ wi ph (wcel Y (cfv D cbs)) $ >
  $ wceq c_1 (cfv S ccid) $ >
  $ wceq I (cfv T ccid) $ >
  $ wi ph (wceq (cfv (cfv (cop X Y) c_1) (co (cop X Y) (cop X Y) P)) (cfv (cfv (cop X Y) O) I)) $;

--| Each identity morphism in the source category is mapped to the corresponding identity morphism in the target category. See also ~ swapfid . (Contributed by Zhi Wang, 8-Oct-2025.)
theorem swapfida (ph: wff) (B2 C D P S T c_1 I O X: class):
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wceq S (co C D cxpc) $ >
  $ wceq T (co D C cxpc) $ >
  $ wi ph (wceq (co C D cswapf) (cop O P)) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wceq c_1 (cfv S ccid) $ >
  $ wceq I (cfv T ccid) $ >
  $ wi ph (wceq (cfv (cfv X c_1) (co X X P)) (cfv (cfv X O) I)) $;

--| Composition in the source category is mapped to composition in the target. ` ( ph -> C e. Cat ) ` and ` ( ph -> D e. Cat ) ` can be replaced by a weaker hypothesis ` ( ph -> S e. Cat ) ` . (Contributed by Zhi Wang, 8-Oct-2025.)
theorem swapfcoa (ph: wff) (B2 C D P S c_xb T c_x H M N O X Y Z: class):
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wceq S (co C D cxpc) $ >
  $ wceq T (co D C cxpc) $ >
  $ wi ph (wceq (co C D cswapf) (cop O P)) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wceq H (cfv S chom) $ >
  $ wi ph (wcel M (co X Y H)) $ >
  $ wi ph (wcel N (co Y Z H)) $ >
  $ wceq c_x (cfv S cco) $ >
  $ wceq c_xb (cfv T cco) $ >
  $ wi ph (wceq (cfv (co N M (co (cop X Y) Z c_x)) (co X Z P)) (co (cfv N (co Y Z P)) (cfv M (co X Y P)) (co (cop (cfv X O) (cfv Y O)) (cfv Z O) c_xb))) $;

--| The swap functor is a functor. (Contributed by Zhi Wang, 8-Oct-2025.)
theorem swapffunc (ph: wff) (C D P S T O: class):
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wceq S (co C D cxpc) $ >
  $ wceq T (co D C cxpc) $ >
  $ wi ph (wceq (co C D cswapf) (cop O P)) $ >
  $ wi ph (wbr O P (co S T cfunc)) $;

--| The swap functor is a fully faithful functor. (Contributed by Zhi Wang, 8-Oct-2025.)
theorem swapfffth (ph: wff) (C D P S T O: class):
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wceq S (co C D cxpc) $ >
  $ wceq T (co D C cxpc) $ >
  $ wi ph (wceq (co C D cswapf) (cop O P)) $ >
  $ wi ph (wbr O P (cin (co S T cful) (co S T cfth))) $;

--| The swap functor is a functor. (Contributed by Zhi Wang, 9-Oct-2025.)
theorem swapffunca (ph: wff) (C D S T: class):
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wceq S (co C D cxpc) $ >
  $ wceq T (co D C cxpc) $ >
  $ wi ph (wcel (co C D cswapf) (co S T cfunc)) $;

--| The swap functor is an isomorphism between product categories. (Contributed by Zhi Wang, 8-Oct-2025.)
theorem swapfiso (ph: wff) (C D S T U E I V: class):
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wceq S (co C D cxpc) $ >
  $ wceq T (co D C cxpc) $ >
  $ wceq E (cfv U ccatc) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wcel S U) $ >
  $ wi ph (wcel T U) $ >
  $ wceq I (cfv E ciso) $ >
  $ wi ph (wcel (co C D cswapf) (co S T I)) $;

--| The product category is categorically isomorphic to the swapped product category. (Contributed by Zhi Wang, 8-Oct-2025.)
theorem swapciso (ph: wff) (C D S T U E V: class):
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wceq S (co C D cxpc) $ >
  $ wceq T (co D C cxpc) $ >
  $ wceq E (cfv U ccatc) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wcel S U) $ >
  $ wi ph (wcel T U) $ >
  $ wi ph (wbr S T (cfv E ccic)) $;

--| A utility theorem for proving theorems on projection functors of opposite categories. (Contributed by Zhi Wang, 19-Nov-2025.)
theorem oppc1stflem {c d: setvar} (ph: wff c d) (C D P F O V W Y: class c d):
  $ wceq O (cfv C coppc) $ >
  $ wceq P (cfv D coppc) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wcel D W) $ >
  $ wi (wa ph (wa (wcel C ccat) (wcel D ccat))) (wceq (cfv (co C D F) coppf) (co O P F)) $ >
  $ wceq F (cmpo c d ccat ccat Y) $ >
  $ wi ph (wceq (cfv (co C D F) coppf) (co O P F)) $;

--| The opposite functor of the first projection functor is the first projection functor of opposite categories. (Contributed by Zhi Wang, 19-Nov-2025.)
theorem oppc1stf (ph: wff) (C D P O V W: class):
  $ wceq O (cfv C coppc) $ >
  $ wceq P (cfv D coppc) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wcel D W) $ >
  $ wi ph (wceq (cfv (co C D c1stf) coppf) (co O P c1stf)) $;

--| The opposite functor of the second projection functor is the second projection functor of opposite categories. (Contributed by Zhi Wang, 19-Nov-2025.)
theorem oppc2ndf (ph: wff) (C D P O V W: class):
  $ wceq O (cfv C coppc) $ >
  $ wceq P (cfv D coppc) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wcel D W) $ >
  $ wi ph (wceq (cfv (co C D c2ndf) coppf) (co O P c2ndf)) $;

--| If two categories have the same set of objects, morphisms, and compositions, then they have same first projection functors. (Contributed by Zhi Wang, 20-Nov-2025.)
theorem _1stfpropd (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq (cfv A2 chomf) (cfv B2 chomf)) $ >
  $ wi ph (wceq (cfv A2 ccomf) (cfv B2 ccomf)) $ >
  $ wi ph (wceq (cfv C chomf) (cfv D chomf)) $ >
  $ wi ph (wceq (cfv C ccomf) (cfv D ccomf)) $ >
  $ wi ph (wcel A2 ccat) $ >
  $ wi ph (wcel B2 ccat) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wceq (co A2 C c1stf) (co B2 D c1stf)) $;

--| If two categories have the same set of objects, morphisms, and compositions, then they have same second projection functors. (Contributed by Zhi Wang, 20-Nov-2025.)
theorem _2ndfpropd (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq (cfv A2 chomf) (cfv B2 chomf)) $ >
  $ wi ph (wceq (cfv A2 ccomf) (cfv B2 ccomf)) $ >
  $ wi ph (wceq (cfv C chomf) (cfv D chomf)) $ >
  $ wi ph (wceq (cfv C ccomf) (cfv D ccomf)) $ >
  $ wi ph (wcel A2 ccat) $ >
  $ wi ph (wcel B2 ccat) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wceq (co A2 C c2ndf) (co B2 D c2ndf)) $;

--| If two categories have the same set of objects, morphisms, and compositions, then they have same diagonal functors. (Contributed by Zhi Wang, 20-Nov-2025.)
theorem diagpropd (ph: wff) (A2 B2 C D: class):
  $ wi ph (wceq (cfv A2 chomf) (cfv B2 chomf)) $ >
  $ wi ph (wceq (cfv A2 ccomf) (cfv B2 ccomf)) $ >
  $ wi ph (wceq (cfv C chomf) (cfv D chomf)) $ >
  $ wi ph (wceq (cfv C ccomf) (cfv D ccomf)) $ >
  $ wi ph (wcel A2 ccat) $ >
  $ wi ph (wcel B2 ccat) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wceq (co A2 C cdiag) (co B2 D cdiag)) $;

--| The bifunctor pre-composed with a swap functor is a bifunctor. (Contributed by Zhi Wang, 10-Oct-2025.)
theorem cofuswapfcl (ph: wff) (C D E F G: class):
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wcel F (co (co D C cxpc) E cfunc)) $ >
  $ wi ph (wceq G (co F (co C D cswapf) ccofu)) $ >
  $ wi ph (wcel G (co (co C D cxpc) E cfunc)) $;

--| The object part of a bifunctor pre-composed with a swap functor. (Contributed by Zhi Wang, 9-Oct-2025.)
theorem cofuswapf1 (ph: wff) (A2 B2 C D E F G X Y: class):
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wcel F (co (co D C cxpc) E cfunc)) $ >
  $ wi ph (wceq G (co F (co C D cswapf) ccofu)) $ >
  $ wceq A2 (cfv C cbs) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (co X Y (cfv G c1st)) (co Y X (cfv F c1st))) $;

--| The morphism part of a bifunctor pre-composed with a swap functor. (Contributed by Zhi Wang, 9-Oct-2025.)
theorem cofuswapf2 (ph: wff) (A2 B2 C D E F G H J M N W X Y Z: class):
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wcel F (co (co D C cxpc) E cfunc)) $ >
  $ wi ph (wceq G (co F (co C D cswapf) ccofu)) $ >
  $ wceq A2 (cfv C cbs) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z A2) $ >
  $ wi ph (wcel W B2) $ >
  $ wceq H (cfv C chom) $ >
  $ wceq J (cfv D chom) $ >
  $ wi ph (wcel M (co X Z H)) $ >
  $ wi ph (wcel N (co Y W J)) $ >
  $ wi ph (wceq (co M N (co (cop X Y) (cop Z W) (cfv G c2nd))) (co N M (co (cop Y X) (cop W Z) (cfv F c2nd)))) $;

--| The partially evaluated transposed curry functor is a functor. (Contributed by Zhi Wang, 9-Oct-2025.)
theorem tposcurf1cl (ph: wff) (A2 C D E F G K X: class):
  $ wi ph (wceq G (co (cop C D) (co F (co C D cswapf) ccofu) ccurf)) $ >
  $ wceq A2 (cfv C cbs) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wcel F (co (co D C cxpc) E cfunc)) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wceq K (cfv X (cfv G c1st))) $ >
  $ wi ph (wcel K (co D E cfunc)) $;

--| Value of the double evaluated transposed curry functor. (Contributed by Zhi Wang, 9-Oct-2025.)
theorem tposcurf11 (ph: wff) (A2 B2 C D E F G K X Y: class):
  $ wi ph (wceq G (co (cop C D) (co F (co C D cswapf) ccofu) ccurf)) $ >
  $ wceq A2 (cfv C cbs) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wcel F (co (co D C cxpc) E cfunc)) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wceq K (cfv X (cfv G c1st))) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (cfv Y (cfv K c1st)) (co Y X (cfv F c1st))) $;

--| The partially evaluated transposed curry functor at a morphism. (Contributed by Zhi Wang, 9-Oct-2025.)
theorem tposcurf12 (ph: wff) (A2 B2 C D c_1 E F G H J K X Y Z: class):
  $ wi ph (wceq G (co (cop C D) (co F (co C D cswapf) ccofu) ccurf)) $ >
  $ wceq A2 (cfv C cbs) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wcel F (co (co D C cxpc) E cfunc)) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wceq K (cfv X (cfv G c1st))) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq J (cfv D chom) $ >
  $ wceq c_1 (cfv C ccid) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wcel H (co Y Z J)) $ >
  $ wi ph (wceq (cfv H (co Y Z (cfv K c2nd))) (co H (cfv X c_1) (co (cop Y X) (cop Z X) (cfv F c2nd)))) $;

--| Value of the object part of the transposed curry functor. (Contributed by Zhi Wang, 9-Oct-2025.)
theorem tposcurf1 {y1 z g2: setvar} (ph: wff) (A2: class z g2) (B2 C D c_1 E F: class) (G: class y1 z g2) (J: class y1 z) (K: class y1 z g2) (X: class):
  $ wi ph (wceq G (co (cop C D) (co F (co C D cswapf) ccofu) ccurf)) $ >
  $ wceq A2 (cfv C cbs) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wcel F (co (co D C cxpc) E cfunc)) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wceq K (cfv X (cfv G c1st))) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wceq J (cfv D chom) $ >
  $ wceq c_1 (cfv C ccid) $ >
  $ wi ph (wceq K (cop (cmpt y1 B2 (co (cv y1) X (cfv F c1st))) (cmpo y1 z B2 B2 (cmpt g2 (co (cv y1) (cv z) J) (co (cv g2) (cfv X c_1) (co (cop (cv y1) X) (cop (cv z) X) (cfv F c2nd))))))) $;

--| Value of the transposed curry functor at a morphism. (Contributed by Zhi Wang, 10-Oct-2025.)
theorem tposcurf2 {z: setvar} (ph: wff) (A2: class z) (B2 C D E F: class) (G: class z) (H I K: class) (L: class z) (X Y: class):
  $ wi ph (wceq G (co (cop C D) (co F (co C D cswapf) ccofu) ccurf)) $ >
  $ wceq A2 (cfv C cbs) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wcel F (co (co D C cxpc) E cfunc)) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wceq I (cfv D ccid) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y A2) $ >
  $ wi ph (wcel K (co X Y H)) $ >
  $ wi ph (wceq L (cfv K (co X Y (cfv G c2nd)))) $ >
  $ wi ph (wceq L (cmpt z B2 (co (cfv (cv z) I) K (co (cop (cv z) X) (cop (cv z) Y) (cfv F c2nd))))) $;

--| Value of a component of the transposed curry functor natural transformation. (Contributed by Zhi Wang, 10-Oct-2025.)
theorem tposcurf2val (ph: wff) (A2 B2 C D E F G H I K L X Y Z: class):
  $ wi ph (wceq G (co (cop C D) (co F (co C D cswapf) ccofu) ccurf)) $ >
  $ wceq A2 (cfv C cbs) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wcel F (co (co D C cxpc) E cfunc)) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wceq I (cfv D ccid) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y A2) $ >
  $ wi ph (wcel K (co X Y H)) $ >
  $ wi ph (wceq L (cfv K (co X Y (cfv G c2nd)))) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wceq (cfv Z L) (co (cfv Z I) K (co (cop Z X) (cop Z Y) (cfv F c2nd)))) $;

--| The transposed curry functor at a morphism is a natural transformation. (Contributed by Zhi Wang, 10-Oct-2025.)
theorem tposcurf2cl (ph: wff) (A2 B2 C D E F G H I K L N X Y: class):
  $ wi ph (wceq G (co (cop C D) (co F (co C D cswapf) ccofu) ccurf)) $ >
  $ wceq A2 (cfv C cbs) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wcel F (co (co D C cxpc) E cfunc)) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wceq I (cfv D ccid) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y A2) $ >
  $ wi ph (wcel K (co X Y H)) $ >
  $ wi ph (wceq L (cfv K (co X Y (cfv G c2nd)))) $ >
  $ wceq N (co D E cnat) $ >
  $ wi ph (wcel L (co (cfv X (cfv G c1st)) (cfv Y (cfv G c1st)) N)) $;

--| The transposed curry functor of a functor ` F : D X. C --> E ` is a functor tposcurry ` ( F ) : C --> ( D --> E ) ` . (Contributed by Zhi Wang, 9-Oct-2025.)
theorem tposcurfcl (ph: wff) (C D Q E F G: class):
  $ wi ph (wceq G (co (cop C D) (co F (co C D cswapf) ccofu) ccurf)) $ >
  $ wceq Q (co D E cfuc) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wcel F (co (co D C cxpc) E cfunc)) $ >
  $ wi ph (wcel G (co C Q cfunc)) $;

--| The constant functor of ` X ` . Example 3.20(2) of [Adamek] p. 30. (Contributed by Zhi Wang, 17-Oct-2025.)
theorem diag1 {y1 z f2: setvar} (ph: wff) (A2: class y1 z f2) (B2: class) (C D c_1: class y1 z f2) (J: class y1 z) (K: class) (L X: class y1 z f2):
  $ wceq L (co C D cdiag) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wceq A2 (cfv C cbs) $ >
  $ wi ph (wcel X A2) $ >
  $ wceq K (cfv X (cfv L c1st)) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wceq J (cfv D chom) $ >
  $ wceq c_1 (cfv C ccid) $ >
  $ wi ph (wceq K (cop (cmpt y1 B2 X) (cmpo y1 z B2 B2 (cmpt f2 (co (cv y1) (cv z) J) (cfv X c_1))))) $;

--| The constant functor of ` X ` . (Contributed by Zhi Wang, 19-Oct-2025.)
theorem diag1a {y1 z: setvar} (ph: wff) (A2: class y1 z) (B2: class) (C D c_1 J: class y1 z) (K: class) (L: class y1 z) (X: class z):
  $ wceq L (co C D cdiag) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wceq A2 (cfv C cbs) $ >
  $ wi ph (wcel X A2) $ >
  $ wceq K (cfv X (cfv L c1st)) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wceq J (cfv D chom) $ >
  $ wceq c_1 (cfv C ccid) $ >
  $ wi ph (wceq K (cop (cxp B2 (csn X)) (cmpo y1 z B2 B2 (cxp (co (cv y1) (cv z) J) (csn (cfv X c_1)))))) $;

--| The object part of the diagonal functor is 1-1 if ` B ` is non-empty. Note that ` ( ph -> ( M = N <-> X = Y ) ) ` also holds because of ~ diag1f1 and ~ f1fveq . (Contributed by Zhi Wang, 19-Oct-2025.)
theorem diag1f1lem (ph: wff) (A2 B2 C D L M N X Y: class):
  $ wceq L (co C D cdiag) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wceq A2 (cfv C cbs) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wne B2 c0) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y A2) $ >
  $ wceq M (cfv X (cfv L c1st)) $ >
  $ wceq N (cfv Y (cfv L c1st)) $ >
  $ wi ph (wi (wceq M N) (wceq X Y)) $;

--| The object part of the diagonal functor is 1-1 if ` B ` is non-empty. (Contributed by Zhi Wang, 19-Oct-2025.)
theorem diag1f1 (ph: wff) (A2 B2 C D L: class):
  $ wceq L (co C D cdiag) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wceq A2 (cfv C cbs) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wne B2 c0) $ >
  $ wi ph (wf1 A2 (co D C cfunc) (cfv L c1st)) $;

--| Lemma for ~ diag2f1 . The converse is trivial ( ~ fveq2 ). (Contributed by Zhi Wang, 21-Oct-2025.)
theorem diag2f1lem (ph: wff) (A2 B2 C D F G H L X Y: class):
  $ wceq L (co C D cdiag) $ >
  $ wceq A2 (cfv C cbs) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y A2) $ >
  $ wi ph (wne B2 c0) $ >
  $ wi ph (wcel F (co X Y H)) $ >
  $ wi ph (wcel G (co X Y H)) $ >
  $ wi ph (wi (wceq (cfv F (co X Y (cfv L c2nd))) (cfv G (co X Y (cfv L c2nd)))) (wceq F G)) $;

--| If ` B ` is non-empty, the morphism part of a diagonal functor is injective functions from hom-sets into sets of natural transformations. (Contributed by Zhi Wang, 21-Oct-2025.)
theorem diag2f1 (ph: wff) (A2 B2 C D H L N X Y: class):
  $ wceq L (co C D cdiag) $ >
  $ wceq A2 (cfv C cbs) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y A2) $ >
  $ wi ph (wne B2 c0) $ >
  $ wceq N (co D C cnat) $ >
  $ wi ph (wf1 (co X Y H) (co (cfv X (cfv L c1st)) (cfv Y (cfv L c1st)) N) (co X Y (cfv L c2nd))) $;

--| Lemma for proving functor theorems. (Contributed by Zhi Wang, 25-Sep-2025.)
theorem fucofulem1 (ph ps ch th ta et: wff):
  $ wi ph (wb ps (w3a ch th ta)) $ >
  $ wi (wa ph (wa th ta)) et $ >
  $ ch $ >
  $ wi (wa ph et) th $ >
  $ wi (wa ph et) ta $ >
  $ wi ph (wb ps et) $;

--| Lemma for proving functor theorems. Maybe consider ~ eufnfv to prove the uniqueness of a functor. (Contributed by Zhi Wang, 25-Sep-2025.)
theorem fucofulem2 {z v u m n q p a b: setvar} (B2: class q p a b) (C: class v u) (D: class z v u m n) (E: class v u) (F: class v u a b) (G: class) (H: class v u q p a b):
  $ wceq B2 (cxp (co D E cfunc) (co C D cfunc)) $ >
  $ wceq H (cfv (co (co D E cfuc) (co C D cfuc) cxpc) chom) $ >
  $ wb (wcel G (cixp z (cxp B2 B2) (co (co (cfv (cfv (cv z) c1st) F) (cfv (cfv (cv z) c2nd) F) (co C E cnat)) (cfv (cv z) H) cmap))) (wa (wceq G (cmpo u v B2 B2 (co (cv u) (cv v) G))) (wral m (wral n (wa (wceq (co (cv m) (cv n) G) (cmpo b a (co (cfv (cv m) c1st) (cfv (cv n) c1st) (co D E cnat)) (co (cfv (cv m) c2nd) (cfv (cv n) c2nd) (co C D cnat)) (co (cv b) (cv a) (co (cv m) (cv n) G)))) (wral p (wral q (wcel (co (cv p) (cv q) (co (cv m) (cv n) G)) (co (cfv (cv m) F) (cfv (cv n) F) (co C E cnat))) (co (cfv (cv m) c2nd) (cfv (cv n) c2nd) (co C D cnat))) (co (cfv (cv m) c1st) (cfv (cv n) c1st) (co D E cnat)))) B2) B2)) $;

--| Equivalence of product functor. (Contributed by Zhi Wang, 29-Sep-2025.)
theorem fuco2el (R S F G K L: class):
  $ wb (wcel (cop (cop K L) (cop F G)) (cxp S R)) (wa (wbr K L S) (wbr F G R)) $;

--| Equivalence of product functor. (Contributed by Zhi Wang, 29-Sep-2025.)
theorem fuco2eld (ph: wff) (R S U F G K L W: class):
  $ wi ph (wceq W (cxp S R)) $ >
  $ wi ph (wceq U (cop (cop K L) (cop F G))) $ >
  $ wi ph (wbr K L S) $ >
  $ wi ph (wbr F G R) $ >
  $ wi ph (wcel U W) $;

--| Equivalence of product functor. (Contributed by Zhi Wang, 29-Sep-2025.)
theorem fuco2eld2 (ph: wff) (R S U W: class):
  $ wi ph (wceq W (cxp S R)) $ >
  $ wi ph (wcel U W) $ >
  $ wrel S $ >
  $ wrel R $ >
  $ wi ph (wceq U (cop (cop (cfv (cfv U c1st) c1st) (cfv (cfv U c1st) c2nd)) (cop (cfv (cfv U c2nd) c1st) (cfv (cfv U c2nd) c2nd)))) $;

--| Equivalence of product functor. (Contributed by Zhi Wang, 29-Sep-2025.)
theorem fuco2eld3 (ph: wff) (R S U W: class):
  $ wi ph (wceq W (cxp S R)) $ >
  $ wi ph (wcel U W) $ >
  $ wrel S $ >
  $ wrel R $ >
  $ wi ph (wa (wbr (cfv (cfv U c1st) c1st) (cfv (cfv U c1st) c2nd) S) (wbr (cfv (cfv U c2nd) c1st) (cfv (cfv U c2nd) c2nd) R)) $;

--| Extend class notation with functor composition bifunctors.
term cfuco: class;

--| Definition of functor composition bifunctors. Given three categories ` C ` , ` D ` , and ` E ` , ` ( <. C , D >. o.F E ) ` is a functor from the product category of two categories of functors to a category of functors ( ~ fucofunc ). The object part maps two functors to their composition ( ~ fuco11 and ~ fuco11b ). The morphism part defines the "composition" of two natural transformations ( ~ fuco22 ) into another natural transformation ( ~ fuco22nat ) such that a "cube-like" diagram commutes. The naturality property also gives an alternate definition ( ~ fuco23a ). Note that such "composition" is different from ~ fucco because they "compose" along different "axes". (Contributed by Zhi Wang, 29-Sep-2025.)
axiom df_fuco {x3 w v u e f2 k m r p a b c d l: setvar}:
  $ wceq cfuco (cmpo p e cvv cvv (csb c (cfv (cv p) c1st) (csb d (cfv (cv p) c2nd) (csb w (cxp (co (cv d) (cv e) cfunc) (co (cv c) (cv d) cfunc)) (cop (cres ccofu (cv w)) (cmpo u v (cv w) (cv w) (csb f2 (cfv (cfv (cv u) c2nd) c1st) (csb k (cfv (cfv (cv u) c1st) c1st) (csb l (cfv (cfv (cv u) c1st) c2nd) (csb m (cfv (cfv (cv v) c2nd) c1st) (csb r (cfv (cfv (cv v) c1st) c1st) (cmpo b a (co (cfv (cv u) c1st) (cfv (cv v) c1st) (co (cv d) (cv e) cnat)) (co (cfv (cv u) c2nd) (cfv (cv v) c2nd) (co (cv c) (cv d) cnat)) (cmpt x3 (cfv (cv c) cbs) (co (cfv (cfv (cv x3) (cv m)) (cv b)) (cfv (cfv (cv x3) (cv a)) (co (cfv (cv x3) (cv f2)) (cfv (cv x3) (cv m)) (cv l))) (co (cop (cfv (cfv (cv x3) (cv f2)) (cv k)) (cfv (cfv (cv x3) (cv m)) (cv k))) (cfv (cfv (cv x3) (cv m)) (cv r)) (cfv (cv e) cco)))))))))))))))) $;

--| Value of the function giving the functor composition bifunctor. (Contributed by Zhi Wang, 7-Oct-2025.)
theorem fucofvalg {x3 v u f2 k m r a b l: setvar} (ph: wff) (C D P: class) (U: class x3 v u f2 k m r a b l) (E: class) (V: class x3 v u f2 k m r a b l) (W: class) (c_op: class x3 v u f2 k m r a b l):
  $ wi ph (wcel P U) $ >
  $ wi ph (wceq (cfv P c1st) C) $ >
  $ wi ph (wceq (cfv P c2nd) D) $ >
  $ wi ph (wcel E V) $ >
  $ wi ph (wceq (co P E cfuco) c_op) $ >
  $ wi ph (wceq W (cxp (co D E cfunc) (co C D cfunc))) $ >
  $ wi ph (wceq c_op (cop (cres ccofu W) (cmpo u v W W (csb f2 (cfv (cfv (cv u) c2nd) c1st) (csb k (cfv (cfv (cv u) c1st) c1st) (csb l (cfv (cfv (cv u) c1st) c2nd) (csb m (cfv (cfv (cv v) c2nd) c1st) (csb r (cfv (cfv (cv v) c1st) c1st) (cmpo b a (co (cfv (cv u) c1st) (cfv (cv v) c1st) (co D E cnat)) (co (cfv (cv u) c2nd) (cfv (cv v) c2nd) (co C D cnat)) (cmpt x3 (cfv C cbs) (co (cfv (cfv (cv x3) (cv m)) (cv b)) (cfv (cfv (cv x3) (cv a)) (co (cfv (cv x3) (cv f2)) (cfv (cv x3) (cv m)) (cv l))) (co (cop (cfv (cfv (cv x3) (cv f2)) (cv k)) (cfv (cfv (cv x3) (cv m)) (cv k))) (cfv (cfv (cv x3) (cv m)) (cv r)) (cfv E cco))))))))))))) $;

--| Value of the function giving the functor composition bifunctor. Hypotheses fucofval.c and fucofval.d are not redundant ( ~ fucofvalne ). (Contributed by Zhi Wang, 29-Sep-2025.)
theorem fucofval {x3 v u f2 k m r a b l: setvar} (ph: wff) (C D: class) (T U: class x3 v u f2 k m r a b l) (E: class) (V: class x3 v u f2 k m r a b l) (W: class) (c_op: class x3 v u f2 k m r a b l):
  $ wi ph (wcel C T) $ >
  $ wi ph (wcel D U) $ >
  $ wi ph (wcel E V) $ >
  $ wi ph (wceq (co (cop C D) E cfuco) c_op) $ >
  $ wi ph (wceq W (cxp (co D E cfunc) (co C D cfunc))) $ >
  $ wi ph (wceq c_op (cop (cres ccofu W) (cmpo u v W W (csb f2 (cfv (cfv (cv u) c2nd) c1st) (csb k (cfv (cfv (cv u) c1st) c1st) (csb l (cfv (cfv (cv u) c1st) c2nd) (csb m (cfv (cfv (cv v) c2nd) c1st) (csb r (cfv (cfv (cv v) c1st) c1st) (cmpo b a (co (cfv (cv u) c1st) (cfv (cv v) c1st) (co D E cnat)) (co (cfv (cv u) c2nd) (cfv (cv v) c2nd) (co C D cnat)) (cmpt x3 (cfv C cbs) (co (cfv (cfv (cv x3) (cv m)) (cv b)) (cfv (cfv (cv x3) (cv a)) (co (cfv (cv x3) (cv f2)) (cfv (cv x3) (cv m)) (cv l))) (co (cop (cfv (cfv (cv x3) (cv f2)) (cv k)) (cfv (cfv (cv x3) (cv m)) (cv k))) (cfv (cfv (cv x3) (cv m)) (cv r)) (cfv E cco))))))))))))) $;

--| A functor composition bifunctor is an ordered pair. Enables ~ 1st2ndb . (Contributed by Zhi Wang, 29-Sep-2025.)
theorem fucoelvv (ph: wff) (C D T U E V c_op: class):
  $ wi ph (wcel C T) $ >
  $ wi ph (wcel D U) $ >
  $ wi ph (wcel E V) $ >
  $ wi ph (wceq (co (cop C D) E cfuco) c_op) $ >
  $ wi ph (wcel c_op (cxp cvv cvv)) $;

--| The object part of the functor composition bifunctor. (Contributed by Zhi Wang, 29-Sep-2025.)
theorem fuco1 (ph: wff) (C D P T U E O V W: class):
  $ wi ph (wcel C T) $ >
  $ wi ph (wcel D U) $ >
  $ wi ph (wcel E V) $ >
  $ wi ph (wceq (co (cop C D) E cfuco) (cop O P)) $ >
  $ wi ph (wceq W (cxp (co D E cfunc) (co C D cfunc))) $ >
  $ wi ph (wceq O (cres ccofu W)) $;

--| The object part of the functor composition bifunctor maps ` ( ( D Func E ) X. ( C Func D ) ) ` into ` ( C Func E ) ` . (Contributed by Zhi Wang, 29-Sep-2025.)
theorem fucof1 (ph: wff) (C D P T U E O V W: class):
  $ wi ph (wcel C T) $ >
  $ wi ph (wcel D U) $ >
  $ wi ph (wcel E V) $ >
  $ wi ph (wceq (co (cop C D) E cfuco) (cop O P)) $ >
  $ wi ph (wceq W (cxp (co D E cfunc) (co C D cfunc))) $ >
  $ wi ph (wf W (co C E cfunc) O) $;

--| The morphism part of the functor composition bifunctor. (Contributed by Zhi Wang, 29-Sep-2025.)
theorem fuco2 {x3 v u f2 k m r a b l: setvar} (ph: wff) (C D: class) (P T U: class x3 v u f2 k m r a b l) (E: class) (O V: class x3 v u f2 k m r a b l) (W: class):
  $ wi ph (wcel C T) $ >
  $ wi ph (wcel D U) $ >
  $ wi ph (wcel E V) $ >
  $ wi ph (wceq (co (cop C D) E cfuco) (cop O P)) $ >
  $ wi ph (wceq W (cxp (co D E cfunc) (co C D cfunc))) $ >
  $ wi ph (wceq P (cmpo u v W W (csb f2 (cfv (cfv (cv u) c2nd) c1st) (csb k (cfv (cfv (cv u) c1st) c1st) (csb l (cfv (cfv (cv u) c1st) c2nd) (csb m (cfv (cfv (cv v) c2nd) c1st) (csb r (cfv (cfv (cv v) c1st) c1st) (cmpo b a (co (cfv (cv u) c1st) (cfv (cv v) c1st) (co D E cnat)) (co (cfv (cv u) c2nd) (cfv (cv v) c2nd) (co C D cnat)) (cmpt x3 (cfv C cbs) (co (cfv (cfv (cv x3) (cv m)) (cv b)) (cfv (cfv (cv x3) (cv a)) (co (cfv (cv x3) (cv f2)) (cfv (cv x3) (cv m)) (cv l))) (co (cop (cfv (cfv (cv x3) (cv f2)) (cv k)) (cfv (cfv (cv x3) (cv m)) (cv k))) (cfv (cfv (cv x3) (cv m)) (cv r)) (cfv E cco)))))))))))) $;

--| The morphism part of the functor composition bifunctor is a function on the Cartesian square of the base set. (Contributed by Zhi Wang, 29-Sep-2025.)
theorem fucofn2 (ph: wff) (C D P T U E O V W: class):
  $ wi ph (wcel C T) $ >
  $ wi ph (wcel D U) $ >
  $ wi ph (wcel E V) $ >
  $ wi ph (wceq (co (cop C D) E cfuco) (cop O P)) $ >
  $ wi ph (wceq W (cxp (co D E cfunc) (co C D cfunc))) $ >
  $ wi ph (wfn P (cxp W W)) $;

--| Value of the function giving the functor composition bifunctor, if ` C ` or ` D ` are not sets. (Contributed by Zhi Wang, 7-Oct-2025.)
theorem fucofvalne {x3 v u f2 k m r a b l: setvar} (ph: wff) (C D: class x3 v u f2 k m r a b l) (E: class) (W c_op: class x3 v u f2 k m r a b l):
  $ wi ph (wn (wa (wcel C cvv) (wcel D cvv))) $ >
  $ wi ph (wcel E ccat) $ >
  $ wi ph (wceq (co (cop C D) E cfuco) c_op) $ >
  $ wi ph (wceq W (cxp (co D E cfunc) (co C D cfunc))) $ >
  $ wi ph (wne c_op (cop (cres ccofu W) (cmpo u v W W (csb f2 (cfv (cfv (cv u) c2nd) c1st) (csb k (cfv (cfv (cv u) c1st) c1st) (csb l (cfv (cfv (cv u) c1st) c2nd) (csb m (cfv (cfv (cv v) c2nd) c1st) (csb r (cfv (cfv (cv v) c1st) c1st) (cmpo b a (co (cfv (cv u) c1st) (cfv (cv v) c1st) (co D E cnat)) (co (cfv (cv u) c2nd) (cfv (cv v) c2nd) (co C D cnat)) (cmpt x3 (cfv C cbs) (co (cfv (cfv (cv x3) (cv m)) (cv b)) (cfv (cfv (cv x3) (cv a)) (co (cfv (cv x3) (cv f2)) (cfv (cv x3) (cv m)) (cv l))) (co (cop (cfv (cfv (cv x3) (cv f2)) (cv k)) (cfv (cfv (cv x3) (cv m)) (cv k))) (cfv (cfv (cv x3) (cv m)) (cv r)) (cfv E cco))))))))))))) $;

--| The object part of the functor composition bifunctor maps two functors to their composition. (Contributed by Zhi Wang, 30-Sep-2025.)
theorem fuco11 (ph: wff) (C D P U E F G K L O: class):
  $ wi ph (wceq (co (cop C D) E cfuco) (cop O P)) $ >
  $ wi ph (wbr F G (co C D cfunc)) $ >
  $ wi ph (wbr K L (co D E cfunc)) $ >
  $ wi ph (wceq U (cop (cop K L) (cop F G))) $ >
  $ wi ph (wceq (cfv U O) (co (cop K L) (cop F G) ccofu)) $;

--| The object part of the functor composition bifunctor maps into ` ( C Func E ) ` . (Contributed by Zhi Wang, 30-Sep-2025.)
theorem fuco11cl (ph: wff) (C D P U E F G K L O: class):
  $ wi ph (wceq (co (cop C D) E cfuco) (cop O P)) $ >
  $ wi ph (wbr F G (co C D cfunc)) $ >
  $ wi ph (wbr K L (co D E cfunc)) $ >
  $ wi ph (wceq U (cop (cop K L) (cop F G))) $ >
  $ wi ph (wcel (cfv U O) (co C E cfunc)) $;

--| The object part of the functor composition bifunctor maps two functors to their composition, expressed explicitly. (Contributed by Zhi Wang, 30-Sep-2025.)
theorem fuco11a {x3 y1: setvar} (ph: wff) (B2: class) (C D P U E: class x3 y1) (F G K L: class) (O: class x3 y1):
  $ wi ph (wceq (co (cop C D) E cfuco) (cop O P)) $ >
  $ wi ph (wbr F G (co C D cfunc)) $ >
  $ wi ph (wbr K L (co D E cfunc)) $ >
  $ wi ph (wceq U (cop (cop K L) (cop F G))) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wceq (cfv U O) (cop (ccom K F) (cmpo x3 y1 B2 B2 (ccom (co (cfv (cv x3) F) (cfv (cv y1) F) L) (co (cv x3) (cv y1) G))))) $;

--| The object part of the functor composition bifunctor maps two functors to their composition, expressed explicitly for the morphism part of the composed functor. (Contributed by Zhi Wang, 3-Oct-2025.)
theorem fuco112 {x3 y1: setvar} (ph: wff) (B2: class) (C D P U E: class x3 y1) (F G K L: class) (O: class x3 y1):
  $ wi ph (wceq (co (cop C D) E cfuco) (cop O P)) $ >
  $ wi ph (wbr F G (co C D cfunc)) $ >
  $ wi ph (wbr K L (co D E cfunc)) $ >
  $ wi ph (wceq U (cop (cop K L) (cop F G))) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wceq (cfv (cfv U O) c2nd) (cmpo x3 y1 B2 B2 (ccom (co (cfv (cv x3) F) (cfv (cv y1) F) L) (co (cv x3) (cv y1) G)))) $;

--| The object part of the functor composition bifunctor maps two functors to their composition, expressed explicitly for the object part of the composed functor. (Contributed by Zhi Wang, 2-Oct-2025.)
theorem fuco111 (ph: wff) (C D P U E F G K L O: class):
  $ wi ph (wceq (co (cop C D) E cfuco) (cop O P)) $ >
  $ wi ph (wbr F G (co C D cfunc)) $ >
  $ wi ph (wbr K L (co D E cfunc)) $ >
  $ wi ph (wceq U (cop (cop K L) (cop F G))) $ >
  $ wi ph (wceq (cfv (cfv U O) c1st) (ccom K F)) $;

--| The object part of the functor composition bifunctor maps two functors to their composition, expressed explicitly for the object part of the composed functor. An object is mapped by two functors in succession. (Contributed by Zhi Wang, 3-Oct-2025.)
theorem fuco111x (ph: wff) (C D P U E F G K L O X: class):
  $ wi ph (wceq (co (cop C D) E cfuco) (cop O P)) $ >
  $ wi ph (wbr F G (co C D cfunc)) $ >
  $ wi ph (wbr K L (co D E cfunc)) $ >
  $ wi ph (wceq U (cop (cop K L) (cop F G))) $ >
  $ wi ph (wcel X (cfv C cbs)) $ >
  $ wi ph (wceq (cfv X (cfv (cfv U O) c1st)) (cfv (cfv X F) K)) $;

--| The object part of the functor composition bifunctor maps two functors to their composition, expressed explicitly for the morphism part of the composed functor. (Contributed by Zhi Wang, 3-Oct-2025.)
theorem fuco112x (ph: wff) (C D P U E F G K L O X Y: class):
  $ wi ph (wceq (co (cop C D) E cfuco) (cop O P)) $ >
  $ wi ph (wbr F G (co C D cfunc)) $ >
  $ wi ph (wbr K L (co D E cfunc)) $ >
  $ wi ph (wceq U (cop (cop K L) (cop F G))) $ >
  $ wi ph (wcel X (cfv C cbs)) $ >
  $ wi ph (wcel Y (cfv C cbs)) $ >
  $ wi ph (wceq (co X Y (cfv (cfv U O) c2nd)) (ccom (co (cfv X F) (cfv Y F) L) (co X Y G))) $;

--| The object part of the functor composition bifunctor maps two functors to their composition, expressed explicitly for the morphism part of the composed functor. A morphism is mapped by two functors in succession. (Contributed by Zhi Wang, 3-Oct-2025.)
theorem fuco112xa (ph: wff) (A2 C D P U E F G K L O X Y: class):
  $ wi ph (wceq (co (cop C D) E cfuco) (cop O P)) $ >
  $ wi ph (wbr F G (co C D cfunc)) $ >
  $ wi ph (wbr K L (co D E cfunc)) $ >
  $ wi ph (wceq U (cop (cop K L) (cop F G))) $ >
  $ wi ph (wcel X (cfv C cbs)) $ >
  $ wi ph (wcel Y (cfv C cbs)) $ >
  $ wi ph (wcel A2 (co X Y (cfv C chom))) $ >
  $ wi ph (wceq (cfv A2 (co X Y (cfv (cfv U O) c2nd))) (cfv (cfv A2 (co X Y G)) (co (cfv X F) (cfv Y F) L))) $;

--| The identity morphism of the mapped object. (Contributed by Zhi Wang, 30-Sep-2025.)
theorem fuco11id (ph: wff) (C D P Q U c_1 E F G I K L O: class):
  $ wi ph (wceq (co (cop C D) E cfuco) (cop O P)) $ >
  $ wi ph (wbr F G (co C D cfunc)) $ >
  $ wi ph (wbr K L (co D E cfunc)) $ >
  $ wi ph (wceq U (cop (cop K L) (cop F G))) $ >
  $ wceq Q (co C E cfuc) $ >
  $ wceq I (cfv Q ccid) $ >
  $ wceq c_1 (cfv E ccid) $ >
  $ wi ph (wceq (cfv (cfv U O) I) (ccom c_1 (ccom K F))) $;

--| The identity morphism of the mapped object. (Contributed by Zhi Wang, 3-Oct-2025.)
theorem fuco11idx (ph: wff) (C D P Q U c_1 E F G I K L O X: class):
  $ wi ph (wceq (co (cop C D) E cfuco) (cop O P)) $ >
  $ wi ph (wbr F G (co C D cfunc)) $ >
  $ wi ph (wbr K L (co D E cfunc)) $ >
  $ wi ph (wceq U (cop (cop K L) (cop F G))) $ >
  $ wceq Q (co C E cfuc) $ >
  $ wceq I (cfv Q ccid) $ >
  $ wceq c_1 (cfv E ccid) $ >
  $ wi ph (wcel X (cfv C cbs)) $ >
  $ wi ph (wceq (cfv X (cfv (cfv U O) I)) (cfv (cfv (cfv X F) K) c_1)) $;

--| The morphism part of the functor composition bifunctor. (Contributed by Zhi Wang, 29-Sep-2025.)
theorem fuco21 {x3 a b: setvar} (ph: wff) (C D: class) (P: class x3 a b) (R: class) (S: class x3) (U E F: class) (G: class x3) (K L M: class) (N: class x3) (O: class x3 a b) (V: class):
  $ wi ph (wceq (co (cop C D) E cfuco) (cop O P)) $ >
  $ wi ph (wbr F G (co C D cfunc)) $ >
  $ wi ph (wbr K L (co D E cfunc)) $ >
  $ wi ph (wceq U (cop (cop K L) (cop F G))) $ >
  $ wi ph (wbr M N (co C D cfunc)) $ >
  $ wi ph (wbr R S (co D E cfunc)) $ >
  $ wi ph (wceq V (cop (cop R S) (cop M N))) $ >
  $ wi ph (wceq (co U V P) (cmpo b a (co (cop K L) (cop R S) (co D E cnat)) (co (cop F G) (cop M N) (co C D cnat)) (cmpt x3 (cfv C cbs) (co (cfv (cfv (cv x3) M) (cv b)) (cfv (cfv (cv x3) (cv a)) (co (cfv (cv x3) F) (cfv (cv x3) M) L)) (co (cop (cfv (cfv (cv x3) F) K) (cfv (cfv (cv x3) M) K)) (cfv (cfv (cv x3) M) R) (cfv E cco)))))) $;

--| The object part of the functor composition bifunctor maps two functors to their composition. (Contributed by Zhi Wang, 11-Oct-2025.)
theorem fuco11b (ph: wff) (C D E F G O: class):
  $ wi ph (wceq (cfv (co (cop C D) E cfuco) c1st) O) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wcel G (co D E cfunc)) $ >
  $ wi ph (wceq (co G F O) (co G F ccofu)) $;

--| Alternate proof of ~ fuco11b . (Contributed by Zhi Wang, 11-Oct-2025.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem fuco11bALT (ph: wff) (C D E F G O: class):
  $ wi ph (wceq (cfv (co (cop C D) E cfuco) c1st) O) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wcel G (co D E cfunc)) $ >
  $ wi ph (wceq (co G F O) (co G F ccofu)) $;

--| The morphism part of the functor composition bifunctor. See also ~ fuco22a . (Contributed by Zhi Wang, 29-Sep-2025.)
theorem fuco22 {x3: setvar} (ph: wff) (A2 B2 C D: class) (P: class x3) (R: class) (S: class x3) (U E F: class) (G: class x3) (K L M: class) (N O: class x3) (V: class):
  $ wi ph (wceq (co (cop C D) E cfuco) (cop O P)) $ >
  $ wi ph (wceq U (cop (cop K L) (cop F G))) $ >
  $ wi ph (wceq V (cop (cop R S) (cop M N))) $ >
  $ wi ph (wcel A2 (co (cop F G) (cop M N) (co C D cnat))) $ >
  $ wi ph (wcel B2 (co (cop K L) (cop R S) (co D E cnat))) $ >
  $ wi ph (wceq (co B2 A2 (co U V P)) (cmpt x3 (cfv C cbs) (co (cfv (cfv (cv x3) M) B2) (cfv (cfv (cv x3) A2) (co (cfv (cv x3) F) (cfv (cv x3) M) L)) (co (cop (cfv (cfv (cv x3) F) K) (cfv (cfv (cv x3) M) K)) (cfv (cfv (cv x3) M) R) (cfv E cco))))) $;

--| The morphism part of the functor composition bifunctor maps two natural transformations to a function on a base set. (Contributed by Zhi Wang, 30-Sep-2025.)
theorem fucofn22 (ph: wff) (A2 B2 C D P R S U E F G K L M N O V: class):
  $ wi ph (wceq (co (cop C D) E cfuco) (cop O P)) $ >
  $ wi ph (wceq U (cop (cop K L) (cop F G))) $ >
  $ wi ph (wceq V (cop (cop R S) (cop M N))) $ >
  $ wi ph (wcel A2 (co (cop F G) (cop M N) (co C D cnat))) $ >
  $ wi ph (wcel B2 (co (cop K L) (cop R S) (co D E cnat))) $ >
  $ wi ph (wfn (co B2 A2 (co U V P)) (cfv C cbs)) $;

--| The morphism part of the functor composition bifunctor. See also ~ fuco23a . (Contributed by Zhi Wang, 29-Sep-2025.)
theorem fuco23 (ph: wff) (A2 B2 C D P R S U E F G c_as K L M N O V X: class):
  $ wi ph (wceq (co (cop C D) E cfuco) (cop O P)) $ >
  $ wi ph (wceq U (cop (cop K L) (cop F G))) $ >
  $ wi ph (wceq V (cop (cop R S) (cop M N))) $ >
  $ wi ph (wcel A2 (co (cop F G) (cop M N) (co C D cnat))) $ >
  $ wi ph (wcel B2 (co (cop K L) (cop R S) (co D E cnat))) $ >
  $ wi ph (wcel X (cfv C cbs)) $ >
  $ wi ph (wceq c_as (co (cop (cfv (cfv X F) K) (cfv (cfv X M) K)) (cfv (cfv X M) R) (cfv E cco))) $ >
  $ wi ph (wceq (cfv X (co B2 A2 (co U V P))) (co (cfv (cfv X M) B2) (cfv (cfv X A2) (co (cfv X F) (cfv X M) L)) c_as)) $;

--| Lemma for ~ fuco22nat . The commutative square of natural transformation ` A ` in category ` D ` , mapped to category ` E ` by the morphism part ` L ` of the functor. (Contributed by Zhi Wang, 30-Sep-2025.)
theorem fuco22natlem1 (ph: wff) (A2 C D E F G H K L M N X Y: class):
  $ wi ph (wcel X (cfv C cbs)) $ >
  $ wi ph (wcel Y (cfv C cbs)) $ >
  $ wi ph (wcel A2 (co (cop F G) (cop M N) (co C D cnat))) $ >
  $ wi ph (wcel H (co X Y (cfv C chom))) $ >
  $ wi ph (wbr K L (co D E cfunc)) $ >
  $ wi ph (wceq (co (cfv (cfv Y A2) (co (cfv Y F) (cfv Y M) L)) (cfv (cfv H (co X Y G)) (co (cfv X F) (cfv Y F) L)) (co (cop (cfv (cfv X F) K) (cfv (cfv Y F) K)) (cfv (cfv Y M) K) (cfv E cco))) (co (cfv (cfv H (co X Y N)) (co (cfv X M) (cfv Y M) L)) (cfv (cfv X A2) (co (cfv X F) (cfv X M) L)) (co (cop (cfv (cfv X F) K) (cfv (cfv X M) K)) (cfv (cfv Y M) K) (cfv E cco)))) $;

--| Lemma for ~ fuco22nat . The commutative square of natural transformation ` B ` in category ` E ` , combined with the commutative square of ~ fuco22natlem1 . (Contributed by Zhi Wang, 30-Sep-2025.)
theorem fuco22natlem2 (ph: wff) (A2 B2 C D R S E F G H K L M N X Y: class):
  $ wi ph (wcel X (cfv C cbs)) $ >
  $ wi ph (wcel Y (cfv C cbs)) $ >
  $ wi ph (wcel A2 (co (cop F G) (cop M N) (co C D cnat))) $ >
  $ wi ph (wcel H (co X Y (cfv C chom))) $ >
  $ wi ph (wcel B2 (co (cop K L) (cop R S) (co D E cnat))) $ >
  $ wi ph (wceq (co (co (cfv (cfv Y M) B2) (cfv (cfv Y A2) (co (cfv Y F) (cfv Y M) L)) (co (cop (cfv (cfv Y F) K) (cfv (cfv Y M) K)) (cfv (cfv Y M) R) (cfv E cco))) (cfv (cfv H (co X Y G)) (co (cfv X F) (cfv Y F) L)) (co (cop (cfv (cfv X F) K) (cfv (cfv Y F) K)) (cfv (cfv Y M) R) (cfv E cco))) (co (cfv (cfv H (co X Y N)) (co (cfv X M) (cfv Y M) S)) (co (cfv (cfv X M) B2) (cfv (cfv X A2) (co (cfv X F) (cfv X M) L)) (co (cop (cfv (cfv X F) K) (cfv (cfv X M) K)) (cfv (cfv X M) R) (cfv E cco))) (co (cop (cfv (cfv X F) K) (cfv (cfv X M) R)) (cfv (cfv Y M) R) (cfv E cco)))) $;

--| Combine ~ fuco22natlem2 with ~ fuco23 . (Contributed by Zhi Wang, 30-Sep-2025.)
theorem fuco22natlem3 (ph: wff) (A2 B2 C D P R S U E F G H K L M N O V X Y: class):
  $ wi ph (wcel X (cfv C cbs)) $ >
  $ wi ph (wcel Y (cfv C cbs)) $ >
  $ wi ph (wcel A2 (co (cop F G) (cop M N) (co C D cnat))) $ >
  $ wi ph (wcel H (co X Y (cfv C chom))) $ >
  $ wi ph (wcel B2 (co (cop K L) (cop R S) (co D E cnat))) $ >
  $ wi ph (wceq (co (cop C D) E cfuco) (cop O P)) $ >
  $ wi ph (wceq U (cop (cop K L) (cop F G))) $ >
  $ wi ph (wceq V (cop (cop R S) (cop M N))) $ >
  $ wi ph (wceq (co (cfv Y (co B2 A2 (co U V P))) (cfv H (ccom (co (cfv X F) (cfv Y F) L) (co X Y G))) (co (cop (cfv X (ccom K F)) (cfv Y (ccom K F))) (cfv Y (ccom R M)) (cfv E cco))) (co (cfv H (ccom (co (cfv X M) (cfv Y M) S) (co X Y N))) (cfv X (co B2 A2 (co U V P))) (co (cop (cfv X (ccom K F)) (cfv X (ccom R M))) (cfv Y (ccom R M)) (cfv E cco)))) $;

--| The composed natural transformation is a natural transformation. Use ~ fuco22nat instead. (New usage is discouraged.) (Contributed by Zhi Wang, 30-Sep-2025.)
theorem fuco22natlem (ph: wff) (A2 B2 C D P R S U E F G K L M N O V: class):
  $ wi ph (wceq (co (cop C D) E cfuco) (cop O P)) $ >
  $ wi ph (wcel A2 (co (cop F G) (cop M N) (co C D cnat))) $ >
  $ wi ph (wcel B2 (co (cop K L) (cop R S) (co D E cnat))) $ >
  $ wi ph (wceq U (cop (cop K L) (cop F G))) $ >
  $ wi ph (wceq V (cop (cop R S) (cop M N))) $ >
  $ wi ph (wcel (co B2 A2 (co U V P)) (co (cfv U O) (cfv V O) (co C E cnat))) $;

--| The composed natural transformation is a natural transformation. (Contributed by Zhi Wang, 2-Oct-2025.)
theorem fuco22nat (ph: wff) (A2 B2 C D P R U E F K M O V: class):
  $ wi ph (wceq (co (cop C D) E cfuco) (cop O P)) $ >
  $ wi ph (wcel A2 (co F M (co C D cnat))) $ >
  $ wi ph (wcel B2 (co K R (co D E cnat))) $ >
  $ wi ph (wceq U (cop K F)) $ >
  $ wi ph (wceq V (cop R M)) $ >
  $ wi ph (wcel (co B2 A2 (co U V P)) (co (cfv U O) (cfv V O) (co C E cnat))) $;

--| The morphism part of the functor composition bifunctor maps a hom-set of the product category into a set of natural transformations. (Contributed by Zhi Wang, 30-Sep-2025.)
theorem fucof21 (ph: wff) (C D P T U E J O V W: class):
  $ wi ph (wceq (co (cop C D) E cfuco) (cop O P)) $ >
  $ wceq T (co (co D E cfuc) (co C D cfuc) cxpc) $ >
  $ wceq J (cfv T chom) $ >
  $ wi ph (wceq W (cxp (co D E cfunc) (co C D cfunc))) $ >
  $ wi ph (wcel U W) $ >
  $ wi ph (wcel V W) $ >
  $ wi ph (wf (co U V J) (co (cfv U O) (cfv V O) (co C E cnat)) (co U V P)) $;

--| Each identity morphism in the source category is mapped to the corresponding identity morphism in the target category. See also ~ fucoid2 . (Contributed by Zhi Wang, 30-Sep-2025.)
theorem fucoid (ph: wff) (C D P Q T U c_1 E F G I K L O: class):
  $ wi ph (wceq (co (cop C D) E cfuco) (cop O P)) $ >
  $ wceq T (co (co D E cfuc) (co C D cfuc) cxpc) $ >
  $ wceq c_1 (cfv T ccid) $ >
  $ wceq Q (co C E cfuc) $ >
  $ wceq I (cfv Q ccid) $ >
  $ wi ph (wbr F G (co C D cfunc)) $ >
  $ wi ph (wbr K L (co D E cfunc)) $ >
  $ wi ph (wceq U (cop (cop K L) (cop F G))) $ >
  $ wi ph (wceq (cfv (cfv U c_1) (co U U P)) (cfv (cfv U O) I)) $;

--| Each identity morphism in the source category is mapped to the corresponding identity morphism in the target category. See also ~ fucoid . (Contributed by Zhi Wang, 30-Sep-2025.)
theorem fucoid2 (ph: wff) (C D P Q T U c_1 E I O W: class):
  $ wi ph (wceq (co (cop C D) E cfuco) (cop O P)) $ >
  $ wceq T (co (co D E cfuc) (co C D cfuc) cxpc) $ >
  $ wceq c_1 (cfv T ccid) $ >
  $ wceq Q (co C E cfuc) $ >
  $ wceq I (cfv Q ccid) $ >
  $ wi ph (wceq W (cxp (co D E cfunc) (co C D cfunc))) $ >
  $ wi ph (wcel U W) $ >
  $ wi ph (wceq (cfv (cfv U c_1) (co U U P)) (cfv (cfv U O) I)) $;

--| The morphism part of the functor composition bifunctor. See also ~ fuco22 . (Contributed by Zhi Wang, 1-Oct-2025.)
theorem fuco22a {x3: setvar} (ph: wff) (A2 B2 C D: class) (P: class x3) (R U E F K M: class) (O: class x3) (V: class):
  $ wi ph (wceq (co (cop C D) E cfuco) (cop O P)) $ >
  $ wi ph (wceq U (cop K F)) $ >
  $ wi ph (wceq V (cop R M)) $ >
  $ wi ph (wcel A2 (co F M (co C D cnat))) $ >
  $ wi ph (wcel B2 (co K R (co D E cnat))) $ >
  $ wi ph (wceq (co B2 A2 (co U V P)) (cmpt x3 (cfv C cbs) (co (cfv (cfv (cv x3) (cfv M c1st)) B2) (cfv (cfv (cv x3) A2) (co (cfv (cv x3) (cfv F c1st)) (cfv (cv x3) (cfv M c1st)) (cfv K c2nd))) (co (cop (cfv (cfv (cv x3) (cfv F c1st)) (cfv K c1st)) (cfv (cfv (cv x3) (cfv M c1st)) (cfv K c1st))) (cfv (cfv (cv x3) (cfv M c1st)) (cfv R c1st)) (cfv E cco))))) $;

--| The naturality property ( ~ nati ) in category ` E ` . (Contributed by Zhi Wang, 3-Oct-2025.)
theorem fuco23alem (ph: wff) (A2 B2 C D R S c_x E F G K L M N X: class):
  $ wi ph (wcel A2 (co (cop F G) (cop M N) (co C D cnat))) $ >
  $ wi ph (wcel B2 (co (cop K L) (cop R S) (co D E cnat))) $ >
  $ wi ph (wcel X (cfv C cbs)) $ >
  $ wceq c_x (cfv E cco) $ >
  $ wi ph (wceq (co (cfv (cfv X M) B2) (cfv (cfv X A2) (co (cfv X F) (cfv X M) L)) (co (cop (cfv (cfv X F) K) (cfv (cfv X M) K)) (cfv (cfv X M) R) c_x)) (co (cfv (cfv X A2) (co (cfv X F) (cfv X M) S)) (cfv (cfv X F) B2) (co (cop (cfv (cfv X F) K) (cfv (cfv X F) R)) (cfv (cfv X M) R) c_x))) $;

--| The morphism part of the functor composition bifunctor. An alternate definition of ` o.F ` . See also ~ fuco23 . (Contributed by Zhi Wang, 3-Oct-2025.)
theorem fuco23a (ph: wff) (A2 B2 C D P R S U E F G c_as K L M N O V X: class):
  $ wi ph (wcel A2 (co (cop F G) (cop M N) (co C D cnat))) $ >
  $ wi ph (wcel B2 (co (cop K L) (cop R S) (co D E cnat))) $ >
  $ wi ph (wcel X (cfv C cbs)) $ >
  $ wi ph (wceq (co (cop C D) E cfuco) (cop O P)) $ >
  $ wi ph (wceq U (cop (cop K L) (cop F G))) $ >
  $ wi ph (wceq V (cop (cop R S) (cop M N))) $ >
  $ wi ph (wceq c_as (co (cop (cfv (cfv X F) K) (cfv (cfv X F) R)) (cfv (cfv X M) R) (cfv E cco))) $ >
  $ wi ph (wceq (cfv X (co B2 A2 (co U V P))) (co (cfv (cfv X A2) (co (cfv X F) (cfv X M) S)) (cfv (cfv X F) B2) c_as)) $;

--| Lemma for ~ fucoco . Associativity for morphisms in category ` E ` . To simply put, ` ( ( a .x. b ) .x. ( c .x. d ) ) = ( a .x. ( ( b .x. c ) .x. d ) ) ` for morphism compositions. (Contributed by Zhi Wang, 2-Oct-2025.)
theorem fucocolem1 (ph: wff) (A2 B2 C D P Q R S U E F G K L M N V X: class):
  $ wi ph (wcel R (co F K (co D E cnat))) $ >
  $ wi ph (wcel S (co G L (co C D cnat))) $ >
  $ wi ph (wcel U (co K M (co D E cnat))) $ >
  $ wi ph (wcel V (co L N (co C D cnat))) $ >
  $ wi ph (wcel X (cfv C cbs)) $ >
  $ wi ph (wcel P (co D E cfunc)) $ >
  $ wi ph (wcel Q (co C D cfunc)) $ >
  $ wi ph (wcel A2 (co (cfv (cfv X (cfv Q c1st)) (cfv P c1st)) (cfv (cfv X (cfv N c1st)) (cfv K c1st)) (cfv E chom))) $ >
  $ wi ph (wcel B2 (co (cfv (cfv X (cfv L c1st)) (cfv F c1st)) (cfv (cfv X (cfv Q c1st)) (cfv P c1st)) (cfv E chom))) $ >
  $ wi ph (wceq (co (co (cfv (cfv X (cfv N c1st)) U) A2 (co (cop (cfv (cfv X (cfv Q c1st)) (cfv P c1st)) (cfv (cfv X (cfv N c1st)) (cfv K c1st))) (cfv (cfv X (cfv N c1st)) (cfv M c1st)) (cfv E cco))) (co B2 (cfv (cfv X S) (co (cfv X (cfv G c1st)) (cfv X (cfv L c1st)) (cfv F c2nd))) (co (cop (cfv (cfv X (cfv G c1st)) (cfv F c1st)) (cfv (cfv X (cfv L c1st)) (cfv F c1st))) (cfv (cfv X (cfv Q c1st)) (cfv P c1st)) (cfv E cco))) (co (cop (cfv (cfv X (cfv G c1st)) (cfv F c1st)) (cfv (cfv X (cfv Q c1st)) (cfv P c1st))) (cfv (cfv X (cfv N c1st)) (cfv M c1st)) (cfv E cco))) (co (cfv (cfv X (cfv N c1st)) U) (co (co A2 B2 (co (cop (cfv (cfv X (cfv L c1st)) (cfv F c1st)) (cfv (cfv X (cfv Q c1st)) (cfv P c1st))) (cfv (cfv X (cfv N c1st)) (cfv K c1st)) (cfv E cco))) (cfv (cfv X S) (co (cfv X (cfv G c1st)) (cfv X (cfv L c1st)) (cfv F c2nd))) (co (cop (cfv (cfv X (cfv G c1st)) (cfv F c1st)) (cfv (cfv X (cfv L c1st)) (cfv F c1st))) (cfv (cfv X (cfv N c1st)) (cfv K c1st)) (cfv E cco))) (co (cop (cfv (cfv X (cfv G c1st)) (cfv F c1st)) (cfv (cfv X (cfv N c1st)) (cfv K c1st))) (cfv (cfv X (cfv N c1st)) (cfv M c1st)) (cfv E cco)))) $;

--| Lemma for ~ fucoco . The composed natural transformations are mapped to composition of 4 natural transformations. (Contributed by Zhi Wang, 2-Oct-2025.)
theorem fucocolem2 {x3: setvar} (ph: wff) (A2 B2: class x3) (C D: class) (P: class x3) (R S: class) (T c_x: class x3) (U E F G c_as K L M N: class) (O: class x3) (V X: class) (Y: class x3) (Z: class):
  $ wi ph (wcel R (co F K (co D E cnat))) $ >
  $ wi ph (wcel S (co G L (co C D cnat))) $ >
  $ wi ph (wcel U (co K M (co D E cnat))) $ >
  $ wi ph (wcel V (co L N (co C D cnat))) $ >
  $ wi ph (wceq (co (cop C D) E cfuco) (cop O P)) $ >
  $ wi ph (wceq X (cop F G)) $ >
  $ wi ph (wceq Y (cop K L)) $ >
  $ wi ph (wceq Z (cop M N)) $ >
  $ wi ph (wceq A2 (cop R S)) $ >
  $ wi ph (wceq B2 (cop U V)) $ >
  $ wceq T (co (co D E cfuc) (co C D cfuc) cxpc) $ >
  $ wceq c_x (cfv T cco) $ >
  $ wceq c_as (cfv D cco) $ >
  $ wi ph (wceq (cfv (co B2 A2 (co (cop X Y) Z c_x)) (co X Z P)) (cmpt x3 (cfv C cbs) (co (co (cfv (cfv (cv x3) (cfv N c1st)) U) (cfv (cfv (cv x3) (cfv N c1st)) R) (co (cop (cfv (cfv (cv x3) (cfv N c1st)) (cfv F c1st)) (cfv (cfv (cv x3) (cfv N c1st)) (cfv K c1st))) (cfv (cfv (cv x3) (cfv N c1st)) (cfv M c1st)) (cfv E cco))) (cfv (co (cfv (cv x3) V) (cfv (cv x3) S) (co (cop (cfv (cv x3) (cfv G c1st)) (cfv (cv x3) (cfv L c1st))) (cfv (cv x3) (cfv N c1st)) c_as)) (co (cfv (cv x3) (cfv G c1st)) (cfv (cv x3) (cfv N c1st)) (cfv F c2nd))) (co (cop (cfv (cfv (cv x3) (cfv G c1st)) (cfv F c1st)) (cfv (cfv (cv x3) (cfv N c1st)) (cfv F c1st))) (cfv (cfv (cv x3) (cfv N c1st)) (cfv M c1st)) (cfv E cco))))) $;

--| Lemma for ~ fucoco . The composed natural transformations are mapped to composition of 4 natural transformations. (Contributed by Zhi Wang, 3-Oct-2025.)
theorem fucocolem3 {x3: setvar} (ph: wff) (A2 B2: class x3) (C D: class) (P: class x3) (R S: class) (T c_x: class x3) (U E F G c_as K L M N: class) (O: class x3) (V X: class) (Y: class x3) (Z: class):
  $ wi ph (wcel R (co F K (co D E cnat))) $ >
  $ wi ph (wcel S (co G L (co C D cnat))) $ >
  $ wi ph (wcel U (co K M (co D E cnat))) $ >
  $ wi ph (wcel V (co L N (co C D cnat))) $ >
  $ wi ph (wceq (co (cop C D) E cfuco) (cop O P)) $ >
  $ wi ph (wceq X (cop F G)) $ >
  $ wi ph (wceq Y (cop K L)) $ >
  $ wi ph (wceq Z (cop M N)) $ >
  $ wi ph (wceq A2 (cop R S)) $ >
  $ wi ph (wceq B2 (cop U V)) $ >
  $ wceq T (co (co D E cfuc) (co C D cfuc) cxpc) $ >
  $ wceq c_x (cfv T cco) $ >
  $ wceq c_as (cfv D cco) $ >
  $ wi ph (wceq (cfv (co B2 A2 (co (cop X Y) Z c_x)) (co X Z P)) (cmpt x3 (cfv C cbs) (co (cfv (cfv (cv x3) (cfv N c1st)) U) (co (co (cfv (cfv (cv x3) (cfv N c1st)) R) (cfv (cfv (cv x3) V) (co (cfv (cv x3) (cfv L c1st)) (cfv (cv x3) (cfv N c1st)) (cfv F c2nd))) (co (cop (cfv (cfv (cv x3) (cfv L c1st)) (cfv F c1st)) (cfv (cfv (cv x3) (cfv N c1st)) (cfv F c1st))) (cfv (cfv (cv x3) (cfv N c1st)) (cfv K c1st)) (cfv E cco))) (cfv (cfv (cv x3) S) (co (cfv (cv x3) (cfv G c1st)) (cfv (cv x3) (cfv L c1st)) (cfv F c2nd))) (co (cop (cfv (cfv (cv x3) (cfv G c1st)) (cfv F c1st)) (cfv (cfv (cv x3) (cfv L c1st)) (cfv F c1st))) (cfv (cfv (cv x3) (cfv N c1st)) (cfv K c1st)) (cfv E cco))) (co (cop (cfv (cfv (cv x3) (cfv G c1st)) (cfv F c1st)) (cfv (cfv (cv x3) (cfv N c1st)) (cfv K c1st))) (cfv (cfv (cv x3) (cfv N c1st)) (cfv M c1st)) (cfv E cco))))) $;

--| Lemma for ~ fucoco . The composed natural transformations are mapped to composition of 4 natural transformations. (Contributed by Zhi Wang, 2-Oct-2025.)
theorem fucocolem4 {x3: setvar} (ph: wff) (A2 B2 C D P: class) (Q: class x3) (R S: class) (c_xb: class x3) (U E F G K L M N O V X Y Z: class):
  $ wi ph (wcel R (co F K (co D E cnat))) $ >
  $ wi ph (wcel S (co G L (co C D cnat))) $ >
  $ wi ph (wcel U (co K M (co D E cnat))) $ >
  $ wi ph (wcel V (co L N (co C D cnat))) $ >
  $ wi ph (wceq (co (cop C D) E cfuco) (cop O P)) $ >
  $ wi ph (wceq X (cop F G)) $ >
  $ wi ph (wceq Y (cop K L)) $ >
  $ wi ph (wceq Z (cop M N)) $ >
  $ wi ph (wceq A2 (cop R S)) $ >
  $ wi ph (wceq B2 (cop U V)) $ >
  $ wceq Q (co C E cfuc) $ >
  $ wceq c_xb (cfv Q cco) $ >
  $ wi ph (wceq (co (cfv B2 (co Y Z P)) (cfv A2 (co X Y P)) (co (cop (cfv X O) (cfv Y O)) (cfv Z O) c_xb)) (cmpt x3 (cfv C cbs) (co (co (cfv (cfv (cv x3) (cfv N c1st)) U) (cfv (cfv (cv x3) V) (co (cfv (cv x3) (cfv L c1st)) (cfv (cv x3) (cfv N c1st)) (cfv K c2nd))) (co (cop (cfv (cfv (cv x3) (cfv L c1st)) (cfv K c1st)) (cfv (cfv (cv x3) (cfv N c1st)) (cfv K c1st))) (cfv (cfv (cv x3) (cfv N c1st)) (cfv M c1st)) (cfv E cco))) (co (cfv (cfv (cv x3) (cfv L c1st)) R) (cfv (cfv (cv x3) S) (co (cfv (cv x3) (cfv G c1st)) (cfv (cv x3) (cfv L c1st)) (cfv F c2nd))) (co (cop (cfv (cfv (cv x3) (cfv G c1st)) (cfv F c1st)) (cfv (cfv (cv x3) (cfv L c1st)) (cfv F c1st))) (cfv (cfv (cv x3) (cfv L c1st)) (cfv K c1st)) (cfv E cco))) (co (cop (cfv (cfv (cv x3) (cfv G c1st)) (cfv F c1st)) (cfv (cfv (cv x3) (cfv L c1st)) (cfv K c1st))) (cfv (cfv (cv x3) (cfv N c1st)) (cfv M c1st)) (cfv E cco))))) $;

--| Composition in the source category is mapped to composition in the target. See also ~ fucoco2 . (Contributed by Zhi Wang, 3-Oct-2025.)
theorem fucoco (ph: wff) (A2 B2 C D P Q R S c_xb T c_x U E F G K L M N O V X Y Z: class):
  $ wi ph (wcel R (co F K (co D E cnat))) $ >
  $ wi ph (wcel S (co G L (co C D cnat))) $ >
  $ wi ph (wcel U (co K M (co D E cnat))) $ >
  $ wi ph (wcel V (co L N (co C D cnat))) $ >
  $ wi ph (wceq (co (cop C D) E cfuco) (cop O P)) $ >
  $ wi ph (wceq X (cop F G)) $ >
  $ wi ph (wceq Y (cop K L)) $ >
  $ wi ph (wceq Z (cop M N)) $ >
  $ wi ph (wceq A2 (cop R S)) $ >
  $ wi ph (wceq B2 (cop U V)) $ >
  $ wceq Q (co C E cfuc) $ >
  $ wceq c_xb (cfv Q cco) $ >
  $ wceq T (co (co D E cfuc) (co C D cfuc) cxpc) $ >
  $ wceq c_x (cfv T cco) $ >
  $ wi ph (wceq (cfv (co B2 A2 (co (cop X Y) Z c_x)) (co X Z P)) (co (cfv B2 (co Y Z P)) (cfv A2 (co X Y P)) (co (cop (cfv X O) (cfv Y O)) (cfv Z O) c_xb))) $;

--| Composition in the source category is mapped to composition in the target. See also ~ fucoco . (Contributed by Zhi Wang, 3-Oct-2025.)
theorem fucoco2 (ph: wff) (A2 B2 C D P Q c_xb T c_x E J O W X Y Z: class):
  $ wceq T (co (co D E cfuc) (co C D cfuc) cxpc) $ >
  $ wceq Q (co C E cfuc) $ >
  $ wi ph (wceq (co (cop C D) E cfuco) (cop O P)) $ >
  $ wceq c_x (cfv T cco) $ >
  $ wceq c_xb (cfv Q cco) $ >
  $ wi ph (wceq W (cxp (co D E cfunc) (co C D cfunc))) $ >
  $ wi ph (wcel X W) $ >
  $ wi ph (wcel Y W) $ >
  $ wi ph (wcel Z W) $ >
  $ wceq J (cfv T chom) $ >
  $ wi ph (wcel A2 (co X Y J)) $ >
  $ wi ph (wcel B2 (co Y Z J)) $ >
  $ wi ph (wceq (cfv (co B2 A2 (co (cop X Y) Z c_x)) (co X Z P)) (co (cfv B2 (co Y Z P)) (cfv A2 (co X Y P)) (co (cop (cfv X O) (cfv Y O)) (cfv Z O) c_xb))) $;

--| The functor composition bifunctor is a functor. See also ~ fucofunca . Its object function need not determine its morphism function; see ~ fuconuniqex2 . In ~ fuconuniqex both source categories are ` ( SetCat `` 1o ) ` . The witness target is the category of ~ par2cat , with two objects and two parallel nonidentity arrows. The map in ~ fuconuniq exchanges those arrows and gives another functor with exactly the same object function; ~ fuconuniq2 states its existence. At a natural-transformation/identity pair, the canonical and alternative components are respectively ` (/) ` and ` 1o ` , as proved in ~ fuconuniqvals . For arbitrary categories, ~ fucoisfunc characterizes all morphism parts with the object function ` ( o.func |`` W ) ` of functor composition. The componentwise version ~ fucoisfunc2 expresses the three exact function domains suggested by ~ df-fuco and ~ fuco23 , together with component typing, naturality, and the identity and composition laws. These conditions allow component values other than those of the canonical construction. (Contributed by Zhi Wang, 3-Oct-2025.)
theorem fucofunc (ph: wff) (C D P Q T E O: class):
  $ wceq T (co (co D E cfuc) (co C D cfuc) cxpc) $ >
  $ wceq Q (co C E cfuc) $ >
  $ wi ph (wceq (co (cop C D) E cfuco) (cop O P)) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wcel E ccat) $ >
  $ wi ph (wbr O P (co T Q cfunc)) $;

--| The functor composition bifunctor is a functor. See also ~ fucofunc . (Contributed by Zhi Wang, 10-Oct-2025.)
theorem fucofunca (ph: wff) (C D Q T E: class):
  $ wceq T (co (co D E cfuc) (co C D cfuc) cxpc) $ >
  $ wceq Q (co C E cfuc) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wcel E ccat) $ >
  $ wi ph (wcel (co (cop C D) E cfuco) (co T Q cfunc)) $;

--| Post-compose a natural transformation with an identity natural transformation. (Contributed by Zhi Wang, 11-Oct-2025.)
theorem fucolid {x3: setvar} (ph: wff) (A2 C D: class) (P Q: class x3) (E F G H: class) (I: class x3):
  $ wi ph (wceq (cfv (co (cop C D) E cfuco) c2nd) P) $ >
  $ wceq I (cfv Q ccid) $ >
  $ wceq Q (co D E cfuc) $ >
  $ wi ph (wcel A2 (co G H (co C D cnat))) $ >
  $ wi ph (wcel F (co D E cfunc)) $ >
  $ wi ph (wceq (co (cfv F I) A2 (co (cop F G) (cop F H) P)) (cmpt x3 (cfv C cbs) (cfv (cfv (cv x3) A2) (co (cfv (cv x3) (cfv G c1st)) (cfv (cv x3) (cfv H c1st)) (cfv F c2nd))))) $;

--| Pre-composing a natural transformation with the identity natural transformation of a functor is pre-composing it with the object part of the functor, in maps-to notation. (Contributed by Zhi Wang, 11-Oct-2025.)
theorem fucorid {x3: setvar} (ph: wff) (A2 C D: class) (P Q: class x3) (E F G H: class) (I: class x3):
  $ wi ph (wceq (cfv (co (cop C D) E cfuco) c2nd) P) $ >
  $ wceq I (cfv Q ccid) $ >
  $ wceq Q (co C D cfuc) $ >
  $ wi ph (wcel A2 (co G H (co D E cnat))) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wceq (co A2 (cfv F I) (co (cop G F) (cop H F) P)) (cmpt x3 (cfv C cbs) (cfv (cfv (cv x3) (cfv F c1st)) A2))) $;

--| Pre-composing a natural transformation with the identity natural transformation of a functor is pre-composing it with the object part of the functor. (Contributed by Zhi Wang, 11-Oct-2025.)
theorem fucorid2 (ph: wff) (A2 C D P Q E F G H I: class):
  $ wi ph (wceq (cfv (co (cop C D) E cfuco) c2nd) P) $ >
  $ wceq I (cfv Q ccid) $ >
  $ wceq Q (co C D cfuc) $ >
  $ wi ph (wcel A2 (co G H (co D E cnat))) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wceq (co A2 (cfv F I) (co (cop G F) (cop H F) P)) (ccom A2 (cfv F c1st))) $;

--| Horizontal composition with the identity natural transformation of the identity functor leaves a natural transformation unchanged. (Contributed by Zhi Wang, 14-Sep-2026.) (Revised by Zhi Wang, 17-Sep-2026.)
theorem fucoridid (ph: wff) (A2 C P Q E G H I J: class):
  $ wi ph (wceq (cfv (co (cop C C) E cfuco) c2nd) P) $ >
  $ wceq Q (co C C cfuc) $ >
  $ wceq J (cfv Q ccid) $ >
  $ wceq I (cfv C cidfu) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel A2 (co G H (co C E cnat))) $ >
  $ wi ph (wceq (co A2 (cfv I J) (co (cop G I) (cop H I) P)) A2) $;

--| A characterization of functors with the object part of functor composition, in terms of an exact morphism function and compatible component functors. See ~ fucoisfunc2 for the componentwise form. (Contributed by Zhi Wang, 14-Sep-2026.)
theorem fucoisfunc {x3 y1 z v u m n q p a b: setvar} (ph: wff) (C D P Q T c_x E H I J O W c_op: class):
  $ wceq W (cxp (co D E cfunc) (co C D cfunc)) $ >
  $ wceq T (co (co D E cfuc) (co C D cfuc) cxpc) $ >
  $ wceq Q (co C E cfuc) $ >
  $ wceq O (cres ccofu W) $ >
  $ wceq H (cfv T chom) $ >
  $ wceq I (cfv T ccid) $ >
  $ wceq J (cfv Q ccid) $ >
  $ wceq c_x (cfv T cco) $ >
  $ wceq c_op (cfv Q cco) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wcel E ccat) $ >
  $ wi ph (wb (wbr O P (co T Q cfunc)) (wa (wa (wceq P (cmpo u v W W (co (cv u) (cv v) P))) (wral m (wral n (wa (wceq (co (cv m) (cv n) P) (cmpo b a (co (cfv (cv m) c1st) (cfv (cv n) c1st) (co D E cnat)) (co (cfv (cv m) c2nd) (cfv (cv n) c2nd) (co C D cnat)) (co (cv b) (cv a) (co (cv m) (cv n) P)))) (wral p (wral q (wcel (co (cv p) (cv q) (co (cv m) (cv n) P)) (co (cfv (cv m) O) (cfv (cv n) O) (co C E cnat))) (co (cfv (cv m) c2nd) (cfv (cv n) c2nd) (co C D cnat))) (co (cfv (cv m) c1st) (cfv (cv n) c1st) (co D E cnat)))) W) W)) (wral x3 (wa (wceq (cfv (cfv (cv x3) I) (co (cv x3) (cv x3) P)) (cfv (cfv (cv x3) O) J)) (wral y1 (wral z (wral m (wral n (wceq (cfv (co (cv n) (cv m) (co (cop (cv x3) (cv y1)) (cv z) c_x)) (co (cv x3) (cv z) P)) (co (cfv (cv n) (co (cv y1) (cv z) P)) (cfv (cv m) (co (cv x3) (cv y1) P)) (co (cop (cfv (cv x3) O) (cfv (cv y1) O)) (cfv (cv z) O) c_op))) (co (cv y1) (cv z) H)) (co (cv x3) (cv y1) H)) W) W)) W))) $;

--| Lemma for ~ fucoisfunc2lem2 . An equivalence that expands the transformation outputs of a composition-shaped hom-family into exact component functions, component typing, and naturality. The component values are arbitrary; no canonical value is imposed. (Contributed by Zhi Wang, 14-Sep-2026.)
theorem fucoisfunc2lem1 {x3 y1 v u h m n q p a b: setvar} (B2 C D P R S c_xb E O W: class):
  $ wceq W (cxp (co D E cfunc) (co C D cfunc)) $ >
  $ wceq O (cres ccofu W) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq R (cfv C chom) $ >
  $ wceq S (cfv E chom) $ >
  $ wceq c_xb (cfv E cco) $ >
  $ wb (wa (wceq P (cmpo u v W W (co (cv u) (cv v) P))) (wral m (wral n (wa (wceq (co (cv m) (cv n) P) (cmpo b a (co (cfv (cv m) c1st) (cfv (cv n) c1st) (co D E cnat)) (co (cfv (cv m) c2nd) (cfv (cv n) c2nd) (co C D cnat)) (co (cv b) (cv a) (co (cv m) (cv n) P)))) (wral p (wral q (wcel (co (cv p) (cv q) (co (cv m) (cv n) P)) (co (cfv (cv m) O) (cfv (cv n) O) (co C E cnat))) (co (cfv (cv m) c2nd) (cfv (cv n) c2nd) (co C D cnat))) (co (cfv (cv m) c1st) (cfv (cv n) c1st) (co D E cnat)))) W) W)) (wa (wceq P (cmpo u v W W (co (cv u) (cv v) P))) (wral m (wral n (wa (wceq (co (cv m) (cv n) P) (cmpo b a (co (cfv (cv m) c1st) (cfv (cv n) c1st) (co D E cnat)) (co (cfv (cv m) c2nd) (cfv (cv n) c2nd) (co C D cnat)) (co (cv b) (cv a) (co (cv m) (cv n) P)))) (wral p (wral q (w3a (wceq (co (cv p) (cv q) (co (cv m) (cv n) P)) (cmpt x3 B2 (cfv (cv x3) (co (cv p) (cv q) (co (cv m) (cv n) P))))) (wral x3 (wcel (cfv (cv x3) (co (cv p) (cv q) (co (cv m) (cv n) P))) (co (cfv (cv x3) (cfv (cfv (cv m) O) c1st)) (cfv (cv x3) (cfv (cfv (cv n) O) c1st)) S)) B2) (wral x3 (wral y1 (wral h (wceq (co (cfv (cv y1) (co (cv p) (cv q) (co (cv m) (cv n) P))) (cfv (cv h) (co (cv x3) (cv y1) (cfv (cfv (cv m) O) c2nd))) (co (cop (cfv (cv x3) (cfv (cfv (cv m) O) c1st)) (cfv (cv y1) (cfv (cfv (cv m) O) c1st))) (cfv (cv y1) (cfv (cfv (cv n) O) c1st)) c_xb)) (co (cfv (cv h) (co (cv x3) (cv y1) (cfv (cfv (cv n) O) c2nd))) (cfv (cv x3) (co (cv p) (cv q) (co (cv m) (cv n) P))) (co (cop (cfv (cv x3) (cfv (cfv (cv m) O) c1st)) (cfv (cv x3) (cfv (cfv (cv n) O) c1st))) (cfv (cv y1) (cfv (cfv (cv n) O) c1st)) c_xb))) (co (cv x3) (cv y1) R)) B2) B2)) (co (cfv (cv m) c2nd) (cfv (cv n) c2nd) (co C D cnat))) (co (cfv (cv m) c1st) (cfv (cv n) c1st) (co D E cnat)))) W) W)) $;

--| Lemma for ~ fucoisfunc2 . (Contributed by Zhi Wang, 14-Sep-2026.) (New usage is discouraged.)
theorem fucoisfunc2lem2 {x3 y1 z v u t h m n q p a b: setvar} (ph: wff) (B2 C D P Q R S c_xb T c_x E H I J K O W c_op: class):
  $ wceq W (cxp (co D E cfunc) (co C D cfunc)) $ >
  $ wceq O (cres ccofu W) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq R (cfv C chom) $ >
  $ wceq S (cfv E chom) $ >
  $ wceq c_xb (cfv E cco) $ >
  $ wceq T (co (co D E cfuc) (co C D cfuc) cxpc) $ >
  $ wceq Q (co C E cfuc) $ >
  $ wceq H (cfv T chom) $ >
  $ wceq I (cfv T ccid) $ >
  $ wceq c_x (cfv T cco) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wcel E ccat) $ >
  $ wceq K (cfv E ccid) $ >
  $ wceq J (cfv Q ccid) $ >
  $ wceq c_op (cfv Q cco) $ >
  $ wi ph (wb (wbr O P (co T Q cfunc)) (wa (wa (wceq P (cmpo u v W W (co (cv u) (cv v) P))) (wral m (wral n (wa (wceq (co (cv m) (cv n) P) (cmpo b a (co (cfv (cv m) c1st) (cfv (cv n) c1st) (co D E cnat)) (co (cfv (cv m) c2nd) (cfv (cv n) c2nd) (co C D cnat)) (co (cv b) (cv a) (co (cv m) (cv n) P)))) (wral p (wral q (w3a (wceq (co (cv p) (cv q) (co (cv m) (cv n) P)) (cmpt x3 B2 (cfv (cv x3) (co (cv p) (cv q) (co (cv m) (cv n) P))))) (wral x3 (wcel (cfv (cv x3) (co (cv p) (cv q) (co (cv m) (cv n) P))) (co (cfv (cv x3) (cfv (cfv (cv m) O) c1st)) (cfv (cv x3) (cfv (cfv (cv n) O) c1st)) S)) B2) (wral x3 (wral y1 (wral h (wceq (co (cfv (cv y1) (co (cv p) (cv q) (co (cv m) (cv n) P))) (cfv (cv h) (co (cv x3) (cv y1) (cfv (cfv (cv m) O) c2nd))) (co (cop (cfv (cv x3) (cfv (cfv (cv m) O) c1st)) (cfv (cv y1) (cfv (cfv (cv m) O) c1st))) (cfv (cv y1) (cfv (cfv (cv n) O) c1st)) c_xb)) (co (cfv (cv h) (co (cv x3) (cv y1) (cfv (cfv (cv n) O) c2nd))) (cfv (cv x3) (co (cv p) (cv q) (co (cv m) (cv n) P))) (co (cop (cfv (cv x3) (cfv (cfv (cv m) O) c1st)) (cfv (cv x3) (cfv (cfv (cv n) O) c1st))) (cfv (cv y1) (cfv (cfv (cv n) O) c1st)) c_xb))) (co (cv x3) (cv y1) R)) B2) B2)) (co (cfv (cv m) c2nd) (cfv (cv n) c2nd) (co C D cnat))) (co (cfv (cv m) c1st) (cfv (cv n) c1st) (co D E cnat)))) W) W)) (wral x3 (wa (wral t (wceq (cfv (cv t) (cfv (cfv (cv x3) I) (co (cv x3) (cv x3) P))) (cfv (cfv (cv t) (cfv (cfv (cv x3) O) c1st)) K)) B2) (wral y1 (wral z (wral m (wral n (wral t (wceq (cfv (cv t) (cfv (co (cv n) (cv m) (co (cop (cv x3) (cv y1)) (cv z) c_x)) (co (cv x3) (cv z) P))) (co (cfv (cv t) (cfv (cv n) (co (cv y1) (cv z) P))) (cfv (cv t) (cfv (cv m) (co (cv x3) (cv y1) P))) (co (cop (cfv (cv t) (cfv (cfv (cv x3) O) c1st)) (cfv (cv t) (cfv (cfv (cv y1) O) c1st))) (cfv (cv t) (cfv (cfv (cv z) O) c1st)) c_xb))) B2) (co (cv y1) (cv z) H)) (co (cv x3) (cv y1) H)) W) W)) W))) $;

--| Full componentwise characterization of an arbitrary morphism part with the object function of functor composition. See also ~ fucoisfunc . Its three exact function domains, component types and naturality, and pointwise identity and composition laws are necessary and sufficient. Empty object and hom domains are permitted. For a concrete failure of uniqueness, see ~ fuconuniq and ~ fuconuniqex2 . (Contributed by Zhi Wang, 14-Sep-2026.) (Revised by Zhi Wang, 17-Sep-2026.)
theorem fucoisfunc2 {x3 y1 z v u t h m n q p a b: setvar} (ph: wff) (B2 C D P Q R S c_xb T c_x E H I K O W: class):
  $ wceq W (cxp (co D E cfunc) (co C D cfunc)) $ >
  $ wceq O (cres ccofu W) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq R (cfv C chom) $ >
  $ wceq S (cfv E chom) $ >
  $ wceq c_xb (cfv E cco) $ >
  $ wceq T (co (co D E cfuc) (co C D cfuc) cxpc) $ >
  $ wceq Q (co C E cfuc) $ >
  $ wceq H (cfv T chom) $ >
  $ wceq I (cfv T ccid) $ >
  $ wceq c_x (cfv T cco) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wcel E ccat) $ >
  $ wceq K (cfv E ccid) $ >
  $ wi ph (wb (wbr O P (co T Q cfunc)) (wa (wa (wceq P (cmpo u v W W (co (cv u) (cv v) P))) (wral m (wral n (wa (wceq (co (cv m) (cv n) P) (cmpo b a (co (cfv (cv m) c1st) (cfv (cv n) c1st) (co D E cnat)) (co (cfv (cv m) c2nd) (cfv (cv n) c2nd) (co C D cnat)) (co (cv b) (cv a) (co (cv m) (cv n) P)))) (wral p (wral q (w3a (wceq (co (cv p) (cv q) (co (cv m) (cv n) P)) (cmpt x3 B2 (cfv (cv x3) (co (cv p) (cv q) (co (cv m) (cv n) P))))) (wral x3 (wcel (cfv (cv x3) (co (cv p) (cv q) (co (cv m) (cv n) P))) (co (cfv (cv x3) (cfv (cfv (cv m) O) c1st)) (cfv (cv x3) (cfv (cfv (cv n) O) c1st)) S)) B2) (wral x3 (wral y1 (wral h (wceq (co (cfv (cv y1) (co (cv p) (cv q) (co (cv m) (cv n) P))) (cfv (cv h) (co (cv x3) (cv y1) (cfv (cfv (cv m) O) c2nd))) (co (cop (cfv (cv x3) (cfv (cfv (cv m) O) c1st)) (cfv (cv y1) (cfv (cfv (cv m) O) c1st))) (cfv (cv y1) (cfv (cfv (cv n) O) c1st)) c_xb)) (co (cfv (cv h) (co (cv x3) (cv y1) (cfv (cfv (cv n) O) c2nd))) (cfv (cv x3) (co (cv p) (cv q) (co (cv m) (cv n) P))) (co (cop (cfv (cv x3) (cfv (cfv (cv m) O) c1st)) (cfv (cv x3) (cfv (cfv (cv n) O) c1st))) (cfv (cv y1) (cfv (cfv (cv n) O) c1st)) c_xb))) (co (cv x3) (cv y1) R)) B2) B2)) (co (cfv (cv m) c2nd) (cfv (cv n) c2nd) (co C D cnat))) (co (cfv (cv m) c1st) (cfv (cv n) c1st) (co D E cnat)))) W) W)) (wral x3 (wa (wral t (wceq (cfv (cv t) (cfv (cfv (cv x3) I) (co (cv x3) (cv x3) P))) (cfv (cfv (cv t) (cfv (cfv (cv x3) O) c1st)) K)) B2) (wral y1 (wral z (wral m (wral n (wral t (wceq (cfv (cv t) (cfv (co (cv n) (cv m) (co (cop (cv x3) (cv y1)) (cv z) c_x)) (co (cv x3) (cv z) P))) (co (cfv (cv t) (cfv (cv n) (co (cv y1) (cv z) P))) (cfv (cv t) (cfv (cv m) (co (cv x3) (cv y1) P))) (co (cop (cfv (cv t) (cfv (cfv (cv x3) O) c1st)) (cfv (cv t) (cfv (cfv (cv y1) O) c1st))) (cfv (cv t) (cfv (cfv (cv z) O) c1st)) c_xb))) B2) (co (cv y1) (cv z) H)) (co (cv x3) (cv y1) H)) W) W)) W))) $;

--| Post-compose functor composition with an object-fixing endofunctor of its target. The original object function remains literally fixed for arbitrary source and intermediate categories. (Contributed by Zhi Wang, 14-Sep-2026.)
theorem fucoaltfunc (ph: wff) (C D Q T E K L: class):
  $ wceq Q (co C E cfuc) $ >
  $ wceq T (co (co D E cfuc) (co C D cfuc) cxpc) $ >
  $ wceq L (co (cop C D) E cfuco) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wcel E ccat) $ >
  $ wi ph (wcel K (co Q Q cfunc)) $ >
  $ wi ph (wceq (cfv K c1st) (cres cid (co C E cfunc))) $ >
  $ wi ph (wbr (cfv L c1st) (cfv (co K L ccofu) c2nd) (co T Q cfunc)) $;

--| Lemma for ~ fucoaltval . (Contributed by Zhi Wang, 14-Sep-2026.) (New usage is discouraged.)
theorem fucoaltvallem (ph: wff) (A2 C Q T E F G I J K L: class):
  $ wceq Q (co C E cfuc) $ >
  $ wceq L (co (cop C C) E cfuco) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel E ccat) $ >
  $ wi ph (wcel K (co Q Q cfunc)) $ >
  $ wi ph (wcel F (co C E cfunc)) $ >
  $ wi ph (wcel G (co C E cfunc)) $ >
  $ wi ph (wcel A2 (co F G (co C E cnat))) $ >
  $ wceq I (cfv C cidfu) $ >
  $ wceq J (cfv (co C C cfuc) ccid) $ >
  $ wceq T (co (co C E cfuc) (co C C cfuc) cxpc) $ >
  $ wi ph (wceq (co A2 (cfv I J) (co (cop F I) (cop G I) (cfv (co K L ccofu) c2nd))) (cfv A2 (co F G (cfv K c2nd)))) $;

--| At a pair consisting of a natural transformation and the identity of the identity functor, post-composed functor composition acts by the post- composing functor on that natural transformation. (Contributed by Zhi Wang, 14-Sep-2026.) (Revised by Zhi Wang, 17-Sep-2026.)
theorem fucoaltval (ph: wff) (A2 C Q E F G I J K L: class):
  $ wceq Q (co C E cfuc) $ >
  $ wceq L (co (cop C C) E cfuco) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel E ccat) $ >
  $ wi ph (wcel K (co Q Q cfunc)) $ >
  $ wi ph (wcel F (co C E cfunc)) $ >
  $ wi ph (wcel G (co C E cfunc)) $ >
  $ wi ph (wcel A2 (co F G (co C E cnat))) $ >
  $ wceq I (cfv C cidfu) $ >
  $ wceq J (cfv (co C C cfuc) ccid) $ >
  $ wi ph (wceq (co A2 (cfv I J) (co (cop F I) (cop G I) (cfv (co K L ccofu) c2nd))) (cfv A2 (co F G (cfv K c2nd)))) $;

--| Lemma for ~ fucoaltne . (Contributed by Zhi Wang, 14-Sep-2026.) (New usage is discouraged.)
theorem fucoaltnelem (ph: wff) (A2 C Q T E F G I J K L: class):
  $ wceq Q (co C E cfuc) $ >
  $ wceq L (co (cop C C) E cfuco) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel E ccat) $ >
  $ wi ph (wcel K (co Q Q cfunc)) $ >
  $ wi ph (wcel F (co C E cfunc)) $ >
  $ wi ph (wcel G (co C E cfunc)) $ >
  $ wi ph (wcel A2 (co F G (co C E cnat))) $ >
  $ wi ph (wne (cfv A2 (co F G (cfv K c2nd))) A2) $ >
  $ wceq T (co (co C E cfuc) (co C C cfuc) cxpc) $ >
  $ wceq I (cfv C cidfu) $ >
  $ wceq J (cfv (co C C cfuc) ccid) $ >
  $ wi ph (wne (cfv (co K L ccofu) c2nd) (cfv L c2nd)) $;

--| A changed natural transformation witnesses that post-composed functor composition has a different morphism part. (Contributed by Zhi Wang, 14-Sep-2026.) (Revised by Zhi Wang, 17-Sep-2026.)
theorem fucoaltne (ph: wff) (A2 C Q E F G K L: class):
  $ wceq Q (co C E cfuc) $ >
  $ wceq L (co (cop C C) E cfuco) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel E ccat) $ >
  $ wi ph (wcel K (co Q Q cfunc)) $ >
  $ wi ph (wcel F (co C E cfunc)) $ >
  $ wi ph (wcel G (co C E cfunc)) $ >
  $ wi ph (wcel A2 (co F G (co C E cnat))) $ >
  $ wi ph (wne (cfv A2 (co F G (cfv K c2nd))) A2) $ >
  $ wi ph (wne (cfv (co K L ccofu) c2nd) (cfv L c2nd)) $;

--| Value of the post-composition functor as a curry of the functor composition bifunctor. (Contributed by Zhi Wang, 11-Oct-2025.)
theorem postcofval {x3 g2 h a: setvar} (ph: wff) (C D: class) (Q R: class x3) (E F: class) (K: class x3) (c_op: class x3 g2 h a):
  $ wceq Q (co C D cfuc) $ >
  $ wceq R (co D E cfuc) $ >
  $ wceq c_op (co (cop R Q) (co (cop C D) E cfuco) ccurf) $ >
  $ wi ph (wcel F (co D E cfunc)) $ >
  $ wi ph (wcel C ccat) $ >
  $ wceq K (cfv F (cfv c_op c1st)) $ >
  $ wi ph (wceq K (cop (cmpt g2 (co C D cfunc) (co F (cv g2) ccofu)) (cmpo g2 h (co C D cfunc) (co C D cfunc) (cmpt a (co (cv g2) (cv h) (co C D cnat)) (cmpt x3 (cfv C cbs) (cfv (cfv (cv x3) (cv a)) (co (cfv (cv x3) (cfv (cv g2) c1st)) (cfv (cv x3) (cfv (cv h) c1st)) (cfv F c2nd)))))))) $;

--| The post-composition functor as a curry of the functor composition bifunctor is a functor. (Contributed by Zhi Wang, 11-Oct-2025.)
theorem postcofcl (ph: wff) (C D Q R S E F K c_op: class):
  $ wceq Q (co C D cfuc) $ >
  $ wceq R (co D E cfuc) $ >
  $ wceq c_op (co (cop R Q) (co (cop C D) E cfuco) ccurf) $ >
  $ wi ph (wcel F (co D E cfunc)) $ >
  $ wi ph (wcel C ccat) $ >
  $ wceq K (cfv F (cfv c_op c1st)) $ >
  $ wceq S (co C E cfuc) $ >
  $ wi ph (wcel K (co Q S cfunc)) $;

--| The object part of the explicit post-composition functor sends each functor to its post-composition with ` F ` . (Contributed by Zhi Wang, 14-Sep-2026.)
theorem postcof1st {g2: setvar} (ph: wff) (C D Q R E F K: class) (c_op: class g2):
  $ wceq Q (co C D cfuc) $ >
  $ wceq R (co D E cfuc) $ >
  $ wceq c_op (co (cop R Q) (co (cop C D) E cfuco) ccurf) $ >
  $ wi ph (wcel F (co D E cfunc)) $ >
  $ wi ph (wcel C ccat) $ >
  $ wceq K (cfv F (cfv c_op c1st)) $ >
  $ wi ph (wceq (cfv K c1st) (cmpt g2 (co C D cfunc) (co F (cv g2) ccofu))) $;

--| The morphism part of the explicit post-composition functor sends a pair of functors to the induced map on natural transformations. (Contributed by Zhi Wang, 14-Sep-2026.)
theorem postcof2nd {x3 g2 h a: setvar} (ph: wff) (C D: class) (Q R: class x3) (E F: class) (K: class x3) (c_op: class x3 g2 h a):
  $ wceq Q (co C D cfuc) $ >
  $ wceq R (co D E cfuc) $ >
  $ wceq c_op (co (cop R Q) (co (cop C D) E cfuco) ccurf) $ >
  $ wi ph (wcel F (co D E cfunc)) $ >
  $ wi ph (wcel C ccat) $ >
  $ wceq K (cfv F (cfv c_op c1st)) $ >
  $ wi ph (wceq (cfv K c2nd) (cmpo g2 h (co C D cfunc) (co C D cfunc) (cmpt a (co (cv g2) (cv h) (co C D cnat)) (cmpt x3 (cfv C cbs) (cfv (cfv (cv x3) (cv a)) (co (cfv (cv x3) (cfv (cv g2) c1st)) (cfv (cv x3) (cfv (cv h) c1st)) (cfv F c2nd))))))) $;

--| A component of the action of a post-composition functor is obtained by applying the morphism part of ` F ` to the component morphism. (Contributed by Zhi Wang, 14-Sep-2026.)
theorem postcof2 (ph: wff) (A2 C D Q R E F G H K X c_op: class):
  $ wceq Q (co C D cfuc) $ >
  $ wceq R (co D E cfuc) $ >
  $ wceq c_op (co (cop R Q) (co (cop C D) E cfuco) ccurf) $ >
  $ wi ph (wcel F (co D E cfunc)) $ >
  $ wi ph (wcel C ccat) $ >
  $ wceq K (cfv F (cfv c_op c1st)) $ >
  $ wi ph (wcel G (co C D cfunc)) $ >
  $ wi ph (wcel H (co C D cfunc)) $ >
  $ wi ph (wcel A2 (co G H (co C D cnat))) $ >
  $ wi ph (wcel X (cfv C cbs)) $ >
  $ wi ph (wceq (cfv X (cfv A2 (co G H (cfv K c2nd)))) (cfv (cfv X A2) (co (cfv X (cfv G c1st)) (cfv X (cfv H c1st)) (cfv F c2nd)))) $;

--| Lemma for ~ precofval to enable ~ catlid or ~ catrid . (Contributed by Zhi Wang, 11-Oct-2025.)
theorem precofvallem (ph: wff) (A2 B2 C D c_1 E F G I K L X: class):
  $ wceq A2 (cfv C cbs) $ >
  $ wceq B2 (cfv E cbs) $ >
  $ wceq c_1 (cfv D ccid) $ >
  $ wceq I (cfv E ccid) $ >
  $ wi ph (wbr F G (co C D cfunc)) $ >
  $ wi ph (wbr K L (co D E cfunc)) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wa (wceq (cfv (cfv X (ccom c_1 F)) (co (cfv X F) (cfv X F) L)) (cfv (cfv (cfv X F) K) I)) (wcel (cfv (cfv X F) K) B2)) $;

--| Value of the pre-composition functor as a transposed curry of the functor composition bifunctor. (Contributed by Zhi Wang, 11-Oct-2025.)
theorem precofval {x3 g2 h a: setvar} (ph: wff) (C D: class) (Q R: class x3) (E F: class) (K c_op: class x3 g2 h a):
  $ wceq Q (co C D cfuc) $ >
  $ wceq R (co D E cfuc) $ >
  $ wi ph (wceq c_op (co (cop Q R) (co (co (cop C D) E cfuco) (co Q R cswapf) ccofu) ccurf)) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wcel E ccat) $ >
  $ wi ph (wceq K (cfv F (cfv c_op c1st))) $ >
  $ wi ph (wceq K (cop (cmpt g2 (co D E cfunc) (co (cv g2) F ccofu)) (cmpo g2 h (co D E cfunc) (co D E cfunc) (cmpt a (co (cv g2) (cv h) (co D E cnat)) (cmpt x3 (cfv C cbs) (cfv (cfv (cv x3) (cfv F c1st)) (cv a))))))) $;

--| Alternate proof of ~ precofval . (Contributed by Zhi Wang, 11-Oct-2025.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem precofvalALT {x3 g2 h a: setvar} (ph: wff) (C D: class) (Q R: class x3) (E F: class) (K c_op: class x3 g2 h a):
  $ wceq Q (co C D cfuc) $ >
  $ wceq R (co D E cfuc) $ >
  $ wi ph (wceq c_op (co (cop Q R) (co (co (cop C D) E cfuco) (co Q R cswapf) ccofu) ccurf)) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wcel E ccat) $ >
  $ wi ph (wceq K (cfv F (cfv c_op c1st))) $ >
  $ wi ph (wceq K (cop (cmpt g2 (co D E cfunc) (co (cv g2) F ccofu)) (cmpo g2 h (co D E cfunc) (co D E cfunc) (cmpt a (co (cv g2) (cv h) (co D E cnat)) (cmpt x3 (cfv C cbs) (cfv (cfv (cv x3) (cfv F c1st)) (cv a))))))) $;

--| Value of the pre-composition functor as a transposed curry of the functor composition bifunctor. (Contributed by Zhi Wang, 11-Oct-2025.)
theorem precofval2 {g2 h a: setvar} (ph: wff) (C D Q R E F: class) (K c_op: class g2 h a):
  $ wceq Q (co C D cfuc) $ >
  $ wceq R (co D E cfuc) $ >
  $ wi ph (wceq c_op (co (cop Q R) (co (co (cop C D) E cfuco) (co Q R cswapf) ccofu) ccurf)) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wcel E ccat) $ >
  $ wi ph (wceq K (cfv F (cfv c_op c1st))) $ >
  $ wi ph (wceq K (cop (cmpt g2 (co D E cfunc) (co (cv g2) F ccofu)) (cmpo g2 h (co D E cfunc) (co D E cfunc) (cmpt a (co (cv g2) (cv h) (co D E cnat)) (ccom (cv a) (cfv F c1st)))))) $;

--| The pre-composition functor as a transposed curry of the functor composition bifunctor is a functor. (Contributed by Zhi Wang, 11-Oct-2025.)
theorem precofcl (ph: wff) (C D Q R S E F K c_op: class):
  $ wceq Q (co C D cfuc) $ >
  $ wceq R (co D E cfuc) $ >
  $ wi ph (wceq c_op (co (cop Q R) (co (co (cop C D) E cfuco) (co Q R cswapf) ccofu) ccurf)) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wcel E ccat) $ >
  $ wi ph (wceq K (cfv F (cfv c_op c1st))) $ >
  $ wceq S (co C E cfuc) $ >
  $ wi ph (wcel K (co R S cfunc)) $;

--| Value of the pre-composition functor as a transposed curry of the functor composition bifunctor. (Contributed by Zhi Wang, 20-Oct-2025.)
theorem precofval3 {g2 h a: setvar} (ph: wff) (B2: class g2 h a) (C D Q R E F G: class) (K L M N c_op: class g2 h a):
  $ wceq R (co D E cfuc) $ >
  $ wceq B2 (co D E cfunc) $ >
  $ wceq N (co D E cnat) $ >
  $ wi ph (wbr F G (co C D cfunc)) $ >
  $ wi ph (wcel E ccat) $ >
  $ wi ph (wceq K (cmpt g2 B2 (co (cv g2) (cop F G) ccofu))) $ >
  $ wi ph (wceq L (cmpo g2 h B2 B2 (cmpt a (co (cv g2) (cv h) N) (ccom (cv a) F)))) $ >
  $ wceq Q (co C D cfuc) $ >
  $ wi ph (wceq c_op (co (cop Q R) (co (co (cop C D) E cfuco) (co Q R cswapf) ccofu) ccurf)) $ >
  $ wi ph (wceq M (cfv (cop F G) (cfv c_op c1st))) $ >
  $ wi ph (wceq (cop K L) M) $;

--| The pre-composition functor, expressed explicitly, is a functor. (Contributed by Zhi Wang, 11-Oct-2025.) (Proof shortened by Zhi Wang, 20-Oct-2025.)
theorem precoffunc {g2 h a: setvar} (ph: wff) (B2: class g2 h a) (C D R: class) (S: class g2 h a) (E F G: class) (K L N: class g2 h a):
  $ wceq R (co D E cfuc) $ >
  $ wceq B2 (co D E cfunc) $ >
  $ wceq N (co D E cnat) $ >
  $ wi ph (wbr F G (co C D cfunc)) $ >
  $ wi ph (wcel E ccat) $ >
  $ wi ph (wceq K (cmpt g2 B2 (co (cv g2) (cop F G) ccofu))) $ >
  $ wi ph (wceq L (cmpo g2 h B2 B2 (cmpt a (co (cv g2) (cv h) N) (ccom (cv a) F)))) $ >
  $ wceq S (co C E cfuc) $ >
  $ wi ph (wbr K L (co R S cfunc)) $;

--| Extend class notation with pre-composition functors.
term cprcof: class;

--| Definition of pre-composition functors. The object part of the pre-composition functor given by ` F ` pre-composes a functor with ` F ` ; the morphism part pre-composes a natural transformation with the object part of ` F ` , in terms of function composition. Comments before the definition in <HTML>&sect;</HTML> 3 of Chapter X in p. 236 of Mac Lane, Saunders, _Categories for the Working Mathematician_, 2nd Edition, Springer Science+Business Media, New York, (1998) [QA169.M33 1998]; available at ~ https://math.mit.edu/~~hrm/palestine/maclane-categories.pdf (retrieved 3 Nov 2025). The notation ` -o.F ` is inspired by this page: ~ https://1lab.dev/Cat.Functor.Compose.html . The pre-composition functor can also be defined as a transposed curry of the functor composition bifunctor ( ~ precofval3 ). But such definition requires an explicit third category. ~ prcoftposcurfuco and ~ prcoftposcurfucoa prove the equivalence. (Contributed by Zhi Wang, 2-Nov-2025.)
axiom df_prcof {e f2 k p a b d l: setvar}:
  $ wceq cprcof (cmpo p f2 cvv cvv (csb d (cfv (cv p) c1st) (csb e (cfv (cv p) c2nd) (csb b (co (cv d) (cv e) cfunc) (cop (cmpt k (cv b) (co (cv k) (cv f2) ccofu)) (cmpo k l (cv b) (cv b) (cmpt a (co (cv k) (cv l) (co (cv d) (cv e) cnat)) (ccom (cv a) (cfv (cv f2) c1st))))))))) $;

--| The domain of ` -o.F ` is a relation. (Contributed by Zhi Wang, 2-Nov-2025.)
theorem reldmprcof:
  $ wrel (cdm cprcof) $;

--| Value of the pre-composition functor. (Contributed by Zhi Wang, 2-Nov-2025.)
theorem prcofvalg {k a l: setvar} (ph: wff) (B2 D P: class) (U: class k a l) (E F: class) (N V: class k a l):
  $ wceq B2 (co D E cfunc) $ >
  $ wceq N (co D E cnat) $ >
  $ wi ph (wcel F U) $ >
  $ wi ph (wcel P V) $ >
  $ wi ph (wceq (cfv P c1st) D) $ >
  $ wi ph (wceq (cfv P c2nd) E) $ >
  $ wi ph (wceq (co P F cprcof) (cop (cmpt k B2 (co (cv k) F ccofu)) (cmpo k l B2 B2 (cmpt a (co (cv k) (cv l) N) (ccom (cv a) (cfv F c1st)))))) $;

--| Value of the pre-composition functor. (Contributed by Zhi Wang, 2-Nov-2025.)
theorem prcofvala {k a l: setvar} (ph: wff) (B2 D: class) (U: class k a l) (E F: class) (N V W: class k a l):
  $ wceq B2 (co D E cfunc) $ >
  $ wceq N (co D E cnat) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel E W) $ >
  $ wi ph (wcel F U) $ >
  $ wi ph (wceq (co (cop D E) F cprcof) (cop (cmpt k B2 (co (cv k) F ccofu)) (cmpo k l B2 B2 (cmpt a (co (cv k) (cv l) N) (ccom (cv a) (cfv F c1st)))))) $;

--| Value of the pre-composition functor. (Contributed by Zhi Wang, 2-Nov-2025.)
theorem prcofval {k a l: setvar} (ph: wff) (B2 D: class) (R: class k a l) (E F G: class) (N V W: class k a l):
  $ wceq B2 (co D E cfunc) $ >
  $ wceq N (co D E cnat) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel E W) $ >
  $ wrel R $ >
  $ wi ph (wbr F G R) $ >
  $ wi ph (wceq (co (cop D E) (cop F G) cprcof) (cop (cmpt k B2 (co (cv k) (cop F G) ccofu)) (cmpo k l B2 B2 (cmpt a (co (cv k) (cv l) N) (ccom (cv a) F))))) $;

--| If the categories have the same set of objects, morphisms, and compositions, then they have the same pre-composition functors. (Contributed by Zhi Wang, 21-Nov-2025.)
theorem prcofpropd (ph: wff) (A2 B2 C D F V W: class):
  $ wi ph (wceq (cfv A2 chomf) (cfv B2 chomf)) $ >
  $ wi ph (wceq (cfv A2 ccomf) (cfv B2 ccomf)) $ >
  $ wi ph (wceq (cfv C chomf) (cfv D chomf)) $ >
  $ wi ph (wceq (cfv C ccomf) (cfv D ccomf)) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel F W) $ >
  $ wi ph (wceq (co (cop A2 C) F cprcof) (co (cop B2 D) F cprcof)) $;

--| The pre-composition functor is an ordered pair. (Contributed by Zhi Wang, 4-Nov-2025.)
theorem prcofelvv (ph: wff) (P U F V: class):
  $ wi ph (wcel F U) $ >
  $ wi ph (wcel P V) $ >
  $ wi ph (wcel (co P F cprcof) (cxp cvv cvv)) $;

--| The domain of the object part of the pre-composition functor is a relation. (Contributed by Zhi Wang, 2-Nov-2025.)
theorem reldmprcof1 (P F: class):
  $ wrel (cdm (cfv (co P F cprcof) c1st)) $;

--| The domain of the morphism part of the pre-composition functor is a relation. (Contributed by Zhi Wang, 2-Nov-2025.)
theorem reldmprcof2 (P F: class):
  $ wrel (cdm (cfv (co P F cprcof) c2nd)) $;

--| The pre-composition functor is the transposed curry of the functor composition bifunctor. (Contributed by Zhi Wang, 2-Nov-2025.)
theorem prcoftposcurfuco (ph: wff) (C D Q R E F G M c_op: class):
  $ wceq R (co D E cfuc) $ >
  $ wi ph (wcel E ccat) $ >
  $ wceq Q (co C D cfuc) $ >
  $ wi ph (wceq c_op (co (cop Q R) (co (co (cop C D) E cfuco) (co Q R cswapf) ccofu) ccurf)) $ >
  $ wi ph (wceq M (cfv (cop F G) (cfv c_op c1st))) $ >
  $ wi ph (wbr F G (co C D cfunc)) $ >
  $ wi ph (wceq (co (cop D E) (cop F G) cprcof) M) $;

--| The pre-composition functor is the transposed curry of the functor composition bifunctor. (Contributed by Zhi Wang, 2-Nov-2025.)
theorem prcoftposcurfucoa (ph: wff) (C D Q R E F M c_op: class):
  $ wceq R (co D E cfuc) $ >
  $ wi ph (wcel E ccat) $ >
  $ wceq Q (co C D cfuc) $ >
  $ wi ph (wceq c_op (co (cop Q R) (co (co (cop C D) E cfuco) (co Q R cswapf) ccofu) ccurf)) $ >
  $ wi ph (wceq M (cfv F (cfv c_op c1st))) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wceq (co (cop D E) F cprcof) M) $;

--| The pre-composition functor is a functor. (Contributed by Zhi Wang, 2-Nov-2025.)
theorem prcoffunc (ph: wff) (C D R S E F G: class):
  $ wceq R (co D E cfuc) $ >
  $ wi ph (wcel E ccat) $ >
  $ wceq S (co C E cfuc) $ >
  $ wi ph (wbr F G (co C D cfunc)) $ >
  $ wi ph (wcel (co (cop D E) (cop F G) cprcof) (co R S cfunc)) $;

--| The pre-composition functor is a functor. (Contributed by Zhi Wang, 2-Nov-2025.)
theorem prcoffunca (ph: wff) (C D R S E F: class):
  $ wceq R (co D E cfuc) $ >
  $ wi ph (wcel E ccat) $ >
  $ wceq S (co C E cfuc) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wcel (co (cop D E) F cprcof) (co R S cfunc)) $;

--| The pre-composition functor is a functor. (Contributed by Zhi Wang, 4-Nov-2025.)
theorem prcoffunca2 (ph: wff) (C D R S E F K L: class):
  $ wceq R (co D E cfuc) $ >
  $ wi ph (wcel E ccat) $ >
  $ wceq S (co C E cfuc) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wceq (co (cop D E) F cprcof) (cop K L)) $ >
  $ wi ph (wbr K L (co R S cfunc)) $;

--| The object part of the pre-composition functor. (Contributed by Zhi Wang, 3-Nov-2025.)
theorem prcof1 (ph: wff) (D E F K O: class):
  $ wi ph (wcel K (co D E cfunc)) $ >
  $ wi ph (wceq (cfv (co (cop D E) F cprcof) c1st) O) $ >
  $ wi ph (wceq (cfv K O) (co K F ccofu)) $;

--| The morphism part of the pre-composition functor. (Contributed by Zhi Wang, 3-Nov-2025.)
theorem prcof2a {a: setvar} (ph: wff) (D: class) (P U: class a) (E F K L N: class):
  $ wceq N (co D E cnat) $ >
  $ wi ph (wcel K (co D E cfunc)) $ >
  $ wi ph (wcel L (co D E cfunc)) $ >
  $ wi ph (wceq (cfv (co (cop D E) F cprcof) c2nd) P) $ >
  $ wi ph (wcel F U) $ >
  $ wi ph (wceq (co K L P) (cmpt a (co K L N) (ccom (cv a) (cfv F c1st)))) $;

--| The morphism part of the pre-composition functor. (Contributed by Zhi Wang, 3-Nov-2025.)
theorem prcof2 {a: setvar} (ph: wff) (D: class) (P R: class a) (E F G K L N: class):
  $ wceq N (co D E cnat) $ >
  $ wi ph (wcel K (co D E cfunc)) $ >
  $ wi ph (wcel L (co D E cfunc)) $ >
  $ wi ph (wceq (cfv (co (cop D E) (cop F G) cprcof) c2nd) P) $ >
  $ wrel R $ >
  $ wi ph (wbr F G R) $ >
  $ wi ph (wceq (co K L P) (cmpt a (co K L N) (ccom (cv a) F))) $;

--| The morphism part of the pre-composition functor. (Contributed by Zhi Wang, 3-Nov-2025.)
theorem prcof21a (ph: wff) (A2 D P U E F K L N: class):
  $ wceq N (co D E cnat) $ >
  $ wi ph (wcel A2 (co K L N)) $ >
  $ wi ph (wceq (cfv (co (cop D E) F cprcof) c2nd) P) $ >
  $ wi ph (wcel F U) $ >
  $ wi ph (wceq (cfv A2 (co K L P)) (ccom A2 (cfv F c1st))) $;

--| The morphism part of the pre-composition functor. (Contributed by Zhi Wang, 3-Nov-2025.)
theorem prcof22a (ph: wff) (A2 B2 C D P E F K L N X: class):
  $ wceq N (co D E cnat) $ >
  $ wi ph (wcel A2 (co K L N)) $ >
  $ wi ph (wceq (cfv (co (cop D E) F cprcof) c2nd) P) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wceq (cfv X (cfv A2 (co K L P))) (cfv (cfv X (cfv F c1st)) A2)) $;

--| A constant functor pre-composed by a functor is another constant functor. (Contributed by Zhi Wang, 25-Nov-2025.)
theorem prcofdiag1 (ph: wff) (B2 C D E F L M X: class):
  $ wceq L (co C D cdiag) $ >
  $ wceq M (co C E cdiag) $ >
  $ wi ph (wcel F (co E D cfunc)) $ >
  $ wi ph (wcel C ccat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (co (cfv X (cfv L c1st)) F ccofu) (cfv X (cfv M c1st))) $;

--| A diagonal functor post-composed by a pre-composition functor is another diagonal functor. (Contributed by Zhi Wang, 25-Nov-2025.)
theorem prcofdiag (ph: wff) (C D E F G L M: class):
  $ wceq L (co C D cdiag) $ >
  $ wceq M (co C E cdiag) $ >
  $ wi ph (wcel F (co E D cfunc)) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wceq (co (cop D C) F cprcof) G) $ >
  $ wi ph (wceq (co G L ccofu) M) $;

--| Reverse closure for the category of categories (in a universe) (Contributed by Zhi Wang, 14-Nov-2025.)
theorem catcrcl (ph: wff) (C U F H X Y: class):
  $ wceq C (cfv U ccatc) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wcel F (co X Y H)) $ >
  $ wi ph (wcel U cvv) $;

--| Reverse closure for the category of categories (in a universe) (Contributed by Zhi Wang, 14-Nov-2025.)
theorem catcrcl2 (ph: wff) (B2 C U F H X Y: class):
  $ wceq C (cfv U ccatc) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wcel F (co X Y H)) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wa (wcel X B2) (wcel Y B2)) $;

--| A morphism of the category of categories (in a universe) is a functor. See ~ df-catc for the definition of the category Cat, which consists of all categories in the universe ` u ` (i.e., " ` u ` -small categories", see Definition 3.44. of [Adamek] p. 39), with functors as the morphisms ( ~ catchom ). (Contributed by Zhi Wang, 14-Nov-2025.)
theorem elcatchom (ph: wff) (C U F H X Y: class):
  $ wceq C (cfv U ccatc) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wcel F (co X Y H)) $ >
  $ wi ph (wcel F (co X Y cfunc)) $;

--| The property " ` F ` is a section of ` G ` " in a category of small categories (in a universe). (Contributed by Zhi Wang, 14-Nov-2025.)
theorem catcsect (C S U F G H I X Y: class):
  $ wceq C (cfv U ccatc) $ >
  $ wceq H (cfv C chom) $ >
  $ wceq I (cfv X cidfu) $ >
  $ wceq S (cfv C csect) $ >
  $ wb (wbr F G (co X Y S)) (wa (wa (wcel F (co X Y H)) (wcel G (co Y X H))) (wceq (co G F ccofu) I)) $;

--| The property " ` F ` is an inverse of ` G ` " in a category of small categories (in a universe). (Contributed by Zhi Wang, 14-Nov-2025.)
theorem catcinv (C U F G H I J N X Y: class):
  $ wceq C (cfv U ccatc) $ >
  $ wceq N (cfv C cinv) $ >
  $ wceq H (cfv C chom) $ >
  $ wceq I (cfv X cidfu) $ >
  $ wceq J (cfv Y cidfu) $ >
  $ wb (wbr F G (co X Y N)) (wa (wa (wcel F (co X Y H)) (wcel G (co Y X H))) (wa (wceq (co G F ccofu) I) (wceq (co F G ccofu) J))) $;

--| A functor is an isomorphism of categories only if it is full and faithful, and is a bijection on the objects. Remark 3.28(2) in [Adamek] p. 34. (Contributed by Zhi Wang, 17-Nov-2025.)
theorem catcisoi (ph: wff) (C R S U F I X Y: class):
  $ wceq C (cfv U ccatc) $ >
  $ wceq R (cfv X cbs) $ >
  $ wceq S (cfv Y cbs) $ >
  $ wceq I (cfv C ciso) $ >
  $ wi ph (wcel F (co X Y I)) $ >
  $ wi ph (wa (wcel F (cin (co X Y cful) (co X Y cfth))) (wf1o R S (cfv F c1st))) $;

--| If a full functor (in fact, a full embedding) is a section, then the sets of universal objects are equal. (Contributed by Zhi Wang, 17-Nov-2025.)
theorem uobeq2 (ph: wff) (B2 C D Q S U E F G K X Y: class):
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wceq (co K F ccofu) G) $ >
  $ wi ph (wceq (cfv X (cfv K c1st)) Y) $ >
  $ wceq Q (cfv U ccatc) $ >
  $ wceq S (cfv Q csect) $ >
  $ wi ph (wcel K (co D E cful)) $ >
  $ wi ph (wcel K (cdm (co D E S))) $ >
  $ wi ph (wceq (cdm (co F X (co C D cup))) (cdm (co G Y (co C E cup)))) $;

--| An isomorphism between categories generates equal sets of universal objects. (Contributed by Zhi Wang, 17-Nov-2025.)
theorem uobeq3 (ph: wff) (B2 C D Q U E F G I K X Y: class):
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wceq (co K F ccofu) G) $ >
  $ wi ph (wceq (cfv X (cfv K c1st)) Y) $ >
  $ wceq Q (cfv U ccatc) $ >
  $ wceq I (cfv Q ciso) $ >
  $ wi ph (wcel K (co D E I)) $ >
  $ wi ph (wceq (cdm (co F X (co C D cup))) (cdm (co G Y (co C E cup)))) $;

--| The object part of the op functor on functor categories. Lemma for ~ fucoppc . (Contributed by Zhi Wang, 18-Nov-2025.)
theorem opf11 (ph: wff) (C D F X: class):
  $ wi ph (wceq F (cres coppf (co C D cfunc))) $ >
  $ wi ph (wcel X (co C D cfunc)) $ >
  $ wi ph (wceq (cfv (cfv X F) c1st) (cfv X c1st)) $;

--| The object part of the op functor on functor categories. Lemma for ~ oppfdiag . (Contributed by Zhi Wang, 19-Nov-2025.)
theorem opf12 (ph: wff) (C D F M N X: class):
  $ wi ph (wceq F (cres coppf (co C D cfunc))) $ >
  $ wi ph (wcel X (co C D cfunc)) $ >
  $ wi ph (wceq (co M N (cfv (cfv X F) c2nd)) (co N M (cfv X c2nd))) $;

--| The morphism part of the op functor on functor categories. Lemma for ~ fucoppc . (Contributed by Zhi Wang, 18-Nov-2025.)
theorem opf2fval {x3 y1: setvar} (ph: wff) (A2 B2 F: class x3 y1) (N X Y: class):
  $ wi ph (wceq F (cmpo x3 y1 A2 B2 (cres cid (co (cv y1) (cv x3) N)))) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (co X Y F) (cres cid (co Y X N))) $;

--| The morphism part of the op functor on functor categories. Lemma for ~ fucoppc . (Contributed by Zhi Wang, 18-Nov-2025.)
theorem opf2 {x3 y1: setvar} (ph: wff) (A2 B2 C D F: class x3 y1) (N X Y: class):
  $ wi ph (wceq F (cmpo x3 y1 A2 B2 (cres cid (co (cv y1) (cv x3) N)))) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq C D) $ >
  $ wi ph (wcel D (co Y X N)) $ >
  $ wi ph (wceq (cfv C (co X Y F)) D) $;

--| Lemma for ~ fucoppc . (Contributed by Zhi Wang, 18-Nov-2025.)
theorem fucoppclem (ph: wff) (C D P F N O X Y: class):
  $ wceq O (cfv C coppc) $ >
  $ wceq P (cfv D coppc) $ >
  $ wceq N (co C D cnat) $ >
  $ wi ph (wceq F (cres coppf (co C D cfunc))) $ >
  $ wi ph (wcel X (co C D cfunc)) $ >
  $ wi ph (wcel Y (co C D cfunc)) $ >
  $ wi ph (wceq (co Y X N) (co (cfv X F) (cfv Y F) (co O P cnat))) $;

--| The opposite category of functors is compatible with the category of opposite functors in terms of identity morphism. (Contributed by Zhi Wang, 18-Nov-2025.)
theorem fucoppcid {x3 y1: setvar} (ph: wff) (C D P Q R S F G: class x3 y1) (N: class) (O: class x3 y1) (X: class):
  $ wceq O (cfv C coppc) $ >
  $ wceq P (cfv D coppc) $ >
  $ wceq Q (co C D cfuc) $ >
  $ wceq R (cfv Q coppc) $ >
  $ wceq S (co O P cfuc) $ >
  $ wceq N (co C D cnat) $ >
  $ wi ph (wceq F (cres coppf (co C D cfunc))) $ >
  $ wi ph (wceq G (cmpo x3 y1 (co C D cfunc) (co C D cfunc) (cres cid (co (cv y1) (cv x3) N)))) $ >
  $ wi ph (wcel X (co C D cfunc)) $ >
  $ wi ph (wceq (cfv (cfv X (cfv R ccid)) (co X X G)) (cfv (cfv X F) (cfv S ccid))) $;

--| The opposite category of functors is compatible with the category of opposite functors in terms of composition. (Contributed by Zhi Wang, 18-Nov-2025.)
theorem fucoppcco {x3 y1: setvar} (ph: wff) (A2 B2 C D P Q R S F G: class x3 y1) (N: class) (O: class x3 y1) (X Y Z: class):
  $ wceq O (cfv C coppc) $ >
  $ wceq P (cfv D coppc) $ >
  $ wceq Q (co C D cfuc) $ >
  $ wceq R (cfv Q coppc) $ >
  $ wceq S (co O P cfuc) $ >
  $ wceq N (co C D cnat) $ >
  $ wi ph (wceq F (cres coppf (co C D cfunc))) $ >
  $ wi ph (wceq G (cmpo x3 y1 (co C D cfunc) (co C D cfunc) (cres cid (co (cv y1) (cv x3) N)))) $ >
  $ wi ph (wcel A2 (co X Y (cfv R chom))) $ >
  $ wi ph (wcel B2 (co Y Z (cfv R chom))) $ >
  $ wi ph (wceq (cfv (co B2 A2 (co (cop X Y) Z (cfv R cco))) (co X Z G)) (co (cfv B2 (co Y Z G)) (cfv A2 (co X Y G)) (co (cop (cfv X F) (cfv Y F)) (cfv Z F) (cfv S cco)))) $;

--| The isomorphism from the opposite category of functors to the category of opposite functors. (Contributed by Zhi Wang, 18-Nov-2025.)
theorem fucoppc {x3 y1: setvar} (ph: wff) (B2: class x3 y1) (C D: class) (P Q: class x3 y1) (R: class) (S T U F G I: class x3 y1) (N: class) (O V W: class x3 y1):
  $ wceq O (cfv C coppc) $ >
  $ wceq P (cfv D coppc) $ >
  $ wceq Q (co C D cfuc) $ >
  $ wceq R (cfv Q coppc) $ >
  $ wceq S (co O P cfuc) $ >
  $ wceq N (co C D cnat) $ >
  $ wi ph (wceq F (cres coppf (co C D cfunc))) $ >
  $ wi ph (wceq G (cmpo x3 y1 (co C D cfunc) (co C D cfunc) (cres cid (co (cv y1) (cv x3) N)))) $ >
  $ wceq T (cfv U ccatc) $ >
  $ wceq B2 (cfv T cbs) $ >
  $ wceq I (cfv T ciso) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wcel D W) $ >
  $ wi ph (wcel R B2) $ >
  $ wi ph (wcel S B2) $ >
  $ wi ph (wbr F G (co R S I)) $;

--| A fully faithful functor from the opposite category of functors to the category of opposite functors. (Contributed by Zhi Wang, 19-Nov-2025.)
theorem fucoppcffth {x3 y1: setvar} (ph: wff) (C D: class) (P Q: class x3 y1) (R: class) (S F G: class x3 y1) (N: class) (O: class x3 y1):
  $ wceq O (cfv C coppc) $ >
  $ wceq P (cfv D coppc) $ >
  $ wceq Q (co C D cfuc) $ >
  $ wceq R (cfv Q coppc) $ >
  $ wceq S (co O P cfuc) $ >
  $ wceq N (co C D cnat) $ >
  $ wi ph (wceq F (cres coppf (co C D cfunc))) $ >
  $ wi ph (wceq G (cmpo x3 y1 (co C D cfunc) (co C D cfunc) (cres cid (co (cv y1) (cv x3) N)))) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wbr F G (cin (co R S cful) (co R S cfth))) $;

--| A functor from the opposite category of functors to the category of opposite functors. (Contributed by Zhi Wang, 19-Nov-2025.)
theorem fucoppcfunc {x3 y1: setvar} (ph: wff) (C D: class) (P Q: class x3 y1) (R: class) (S F G: class x3 y1) (N: class) (O: class x3 y1):
  $ wceq O (cfv C coppc) $ >
  $ wceq P (cfv D coppc) $ >
  $ wceq Q (co C D cfuc) $ >
  $ wceq R (cfv Q coppc) $ >
  $ wceq S (co O P cfuc) $ >
  $ wceq N (co C D cnat) $ >
  $ wi ph (wceq F (cres coppf (co C D cfunc))) $ >
  $ wi ph (wceq G (cmpo x3 y1 (co C D cfunc) (co C D cfunc) (cres cid (co (cv y1) (cv x3) N)))) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wbr F G (co R S cfunc)) $;

--| The opposite category of functors is isomorphic to the category of opposite functors. (Contributed by Zhi Wang, 18-Nov-2025.)
theorem fucoppccic (ph: wff) (B2 C D U E V W X Y: class):
  $ wceq C (cfv U ccatc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq X (cfv (co D E cfuc) coppc) $ >
  $ wceq Y (co (cfv D coppc) (cfv E coppc) cfuc) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel E W) $ >
  $ wi ph (wbr X Y (cfv C ccic)) $;

--| A constant functor for opposite categories is the opposite functor of the constant functor for original categories. (Contributed by Zhi Wang, 19-Nov-2025.)
theorem oppfdiag1 (ph: wff) (A2 C D P F L O X: class):
  $ wceq O (cfv C coppc) $ >
  $ wceq P (cfv D coppc) $ >
  $ wceq L (co C D cdiag) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wceq F (cres coppf (co D C cfunc))) $ >
  $ wceq A2 (cfv C cbs) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wceq (cfv (cfv X (cfv L c1st)) F) (cfv X (cfv (co O P cdiag) c1st))) $;

--| A constant functor for opposite categories is the opposite functor of the constant functor for original categories. (Contributed by Zhi Wang, 19-Nov-2025.)
theorem oppfdiag1a (ph: wff) (A2 C D P L O X: class):
  $ wceq O (cfv C coppc) $ >
  $ wceq P (cfv D coppc) $ >
  $ wceq L (co C D cdiag) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wceq A2 (cfv C cbs) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wceq (cfv (cfv X (cfv L c1st)) coppf) (cfv X (cfv (co O P cdiag) c1st))) $;

--| A diagonal functor for opposite categories is the opposite functor of the diagonal functor for original categories post-composed by an isomorphism ( ~ fucoppc ). (Contributed by Zhi Wang, 19-Nov-2025.)
theorem oppfdiag {m n: setvar} (ph: wff) (C D: class) (P F G: class m n) (L N: class) (O: class m n):
  $ wceq O (cfv C coppc) $ >
  $ wceq P (cfv D coppc) $ >
  $ wceq L (co C D cdiag) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wceq F (cres coppf (co D C cfunc))) $ >
  $ wceq N (co D C cnat) $ >
  $ wi ph (wceq G (cmpo m n (co D C cfunc) (co D C cfunc) (cres cid (co (cv n) (cv m) N)))) $ >
  $ wi ph (wceq (co (cop F G) (cfv L coppf) ccofu) (co O P cdiag)) $;

--| Extend class notation with the class of thin categories.
term cthinc: class;

--| Definition of the class of thin categories, or posetal categories, whose hom-sets each contain at most one morphism. Example 3.26(2) of [Adamek] p. 33. "ThinCat" was taken instead of "PosCat" because the latter might mean the category of posets. (Contributed by Zhi Wang, 17-Sep-2024.)
axiom df_thinc {x3 y1 f2 h b c: setvar}:
  $ wceq cthinc (crab c (wsbc b (wsbc h (wral x3 (wral y1 (wmo f2 (wcel (cv f2) (co (cv x3) (cv y1) (cv h)))) (cv b)) (cv b)) (cfv (cv c) chom)) (cfv (cv c) cbs)) ccat) $;

--| The predicate "is a thin category". (Contributed by Zhi Wang, 17-Sep-2024.)
theorem isthinc {x3 y1 f2: setvar} (B2 C H: class):
  $ wceq B2 (cfv C cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wb (wcel C cthinc) (wa (wcel C ccat) (wral x3 (wral y1 (wmo f2 (wcel (cv f2) (co (cv x3) (cv y1) H))) B2) B2)) $;

--| A thin category is a category in which all hom-sets have cardinality less than or equal to the cardinality of ` 1o ` . (Contributed by Zhi Wang, 17-Sep-2024.)
theorem isthinc2 {x3 y1: setvar} (B2 C H: class):
  $ wceq B2 (cfv C cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wb (wcel C cthinc) (wa (wcel C ccat) (wral x3 (wral y1 (wbr (co (cv x3) (cv y1) H) c1o cdom) B2) B2)) $;

--| A thin category is a category in which, given a pair of objects ` x ` and ` y ` and any two morphisms ` f , g ` from ` x ` to ` y ` , the morphisms are equal. (Contributed by Zhi Wang, 17-Sep-2024.)
theorem isthinc3 {x3 y1 f2 g2: setvar} (B2 C H: class):
  $ wceq B2 (cfv C cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wb (wcel C cthinc) (wa (wcel C ccat) (wral x3 (wral y1 (wral f2 (wral g2 (wceq (cv f2) (cv g2)) (co (cv x3) (cv y1) H)) (co (cv x3) (cv y1) H)) B2) B2)) $;

--| A thin category is a category. (Contributed by Zhi Wang, 17-Sep-2024.)
theorem thinccat (C: class):
  $ wi (wcel C cthinc) (wcel C ccat) $;

--| A thin category is a category (deduction form). (Contributed by Zhi Wang, 24-Sep-2024.)
theorem thinccatd (ph: wff) (C: class):
  $ wi ph (wcel C cthinc) $ >
  $ wi ph (wcel C ccat) $;

--| A thin category is a category. (Contributed by Zhi Wang, 17-Sep-2024.)
theorem thincssc:
  $ wss cthinc ccat $;

--| Lemma for ~ isthincd2 and ~ thincmo2 . (Contributed by Zhi Wang, 17-Sep-2024.)
theorem isthincd2lem1 {x3 y1 f2: setvar} (ph: wff x3 y1 f2) (B2: class f2) (F G: class x3 y1 f2) (H: class) (X: class x3 y1) (Y: class x3 y1 f2):
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel F (co X Y H)) $ >
  $ wi ph (wcel G (co X Y H)) $ >
  $ wi ph (wral x3 (wral y1 (wmo f2 (wcel (cv f2) (co (cv x3) (cv y1) H))) B2) B2) $ >
  $ wi ph (wceq F G) $;

--| Morphisms in the same hom-set are identical. (Contributed by Zhi Wang, 17-Sep-2024.)
theorem thincmo2 (ph: wff) (B2 C F G H X Y: class):
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel F (co X Y H)) $ >
  $ wi ph (wcel G (co X Y H)) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wcel C cthinc) $ >
  $ wi ph (wceq F G) $;

--| A non-empty hom-set of a thin category is given by its element. (Contributed by Zhi Wang, 20-Oct-2025.)
theorem thinchom (ph: wff) (B2 C F H X Y: class):
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel F (co X Y H)) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wcel C cthinc) $ >
  $ wi ph (wceq (co X Y H) (csn F)) $;

--| There is at most one morphism in each hom-set. (Contributed by Zhi Wang, 21-Sep-2024.)
theorem thincmo {f2: setvar} (ph: wff) (B2 C H X Y: class):
  $ wi ph (wcel C cthinc) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wmo f2 (wcel (cv f2) (co X Y H))) $;

--| Alternate proof of ~ thincmo . (Contributed by Zhi Wang, 21-Sep-2024.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem thincmoALT {f2: setvar} (ph: wff) (B2 C H X Y: class):
  $ wi ph (wcel C cthinc) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wmo f2 (wcel (cv f2) (co X Y H))) $;

--| At most one morphism in each hom-set (deduction form). (Contributed by Zhi Wang, 21-Sep-2024.)
theorem thincmod {f2: setvar} (ph: wff) (B2 C H X Y: class):
  $ wi ph (wcel C cthinc) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq B2 (cfv C cbs)) $ >
  $ wi ph (wceq H (cfv C chom)) $ >
  $ wi ph (wmo f2 (wcel (cv f2) (co X Y H))) $;

--| In a thin category, a hom-set being non-empty is equivalent to having a unique element. (Contributed by Zhi Wang, 21-Sep-2024.)
theorem thincn0eu {f2: setvar} (ph: wff) (B2 C H X Y: class):
  $ wi ph (wcel C cthinc) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq B2 (cfv C cbs)) $ >
  $ wi ph (wceq H (cfv C chom)) $ >
  $ wi ph (wb (wne (co X Y H) c0) (weu f2 (wcel (cv f2) (co X Y H)))) $;

--| In a thin category, a morphism from an object to itself is an identity morphism. (Contributed by Zhi Wang, 24-Sep-2024.)
theorem thincid (ph: wff) (B2 C c_1 F H X: class):
  $ wi ph (wcel C cthinc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wcel X B2) $ >
  $ wceq c_1 (cfv C ccid) $ >
  $ wi ph (wcel F (co X X H)) $ >
  $ wi ph (wceq F (cfv X c_1)) $;

--| In a thin category, all morphisms are monomorphisms. Example 7.33(9) of [Adamek] p. 110. The converse does not hold. See ~ grptcmon . (Contributed by Zhi Wang, 24-Sep-2024.)
theorem thincmon (ph: wff) (B2 C H M X Y: class):
  $ wi ph (wcel C cthinc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq M (cfv C cmon) $ >
  $ wi ph (wceq (co X Y M) (co X Y H)) $;

--| In a thin category, all morphisms are epimorphisms. The converse does not hold. See ~ grptcepi . (Contributed by Zhi Wang, 24-Sep-2024.)
theorem thincepi (ph: wff) (B2 C E H X Y: class):
  $ wi ph (wcel C cthinc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq E (cfv C cepi) $ >
  $ wi ph (wceq (co X Y E) (co X Y H)) $;

--| Lemma for ~ isthincd2 . (Contributed by Zhi Wang, 17-Sep-2024.)
theorem isthincd2lem2 {x3 y1 z f2 g2: setvar} (ph: wff x3 y1 z f2 g2) (B2: class f2 g2) (c_x: class) (F G: class x3 y1 z f2 g2) (H: class) (X Y Z: class x3 y1 z f2 g2):
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wcel F (co X Y H)) $ >
  $ wi ph (wcel G (co Y Z H)) $ >
  $ wi ph (wral x3 (wral y1 (wral z (wral f2 (wral g2 (wcel (co (cv g2) (cv f2) (co (cop (cv x3) (cv y1)) (cv z) c_x)) (co (cv x3) (cv z) H)) (co (cv y1) (cv z) H)) (co (cv x3) (cv y1) H)) B2) B2) B2) $ >
  $ wi ph (wcel (co G F (co (cop X Y) Z c_x)) (co X Z H)) $;

--| The predicate "is a thin category" (deduction form). (Contributed by Zhi Wang, 17-Sep-2024.)
theorem isthincd {x3 y1 f2: setvar} (ph: wff) (B2: class x3 f2) (C: class) (H: class x3 y1 f2):
  $ wi ph (wceq B2 (cfv C cbs)) $ >
  $ wi ph (wceq H (cfv C chom)) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wmo f2 (wcel (cv f2) (co (cv x3) (cv y1) H))) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel C cthinc) $;

--| The predicate " ` C ` is a thin category" without knowing ` C ` is a category (deduction form). The identity arrow operator is also provided as a byproduct. (Contributed by Zhi Wang, 17-Sep-2024.)
theorem isthincd2 {x3 y1 z f2 g2: setvar} (ph: wff) (ps: wff x3 y1 z f2 g2) (B2 C c_x: class) (c_1: class y1) (H: class) (V: class x3 y1 z f2 g2):
  $ wi ph (wceq B2 (cfv C cbs)) $ >
  $ wi ph (wceq H (cfv C chom)) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wmo f2 (wcel (cv f2) (co (cv x3) (cv y1) H))) $ >
  $ wi ph (wceq c_x (cfv C cco)) $ >
  $ wi ph (wcel C V) $ >
  $ wb ps (wa (w3a (wcel (cv x3) B2) (wcel (cv y1) B2) (wcel (cv z) B2)) (wa (wcel (cv f2) (co (cv x3) (cv y1) H)) (wcel (cv g2) (co (cv y1) (cv z) H)))) $ >
  $ wi (wa ph (wcel (cv y1) B2)) (wcel c_1 (co (cv y1) (cv y1) H)) $ >
  $ wi (wa ph ps) (wcel (co (cv g2) (cv f2) (co (cop (cv x3) (cv y1)) (cv z) c_x)) (co (cv x3) (cv z) H)) $ >
  $ wi ph (wa (wcel C cthinc) (wceq (cfv C ccid) (cmpt y1 B2 c_1))) $;

--| The opposite category of a thin category is thin. (Contributed by Zhi Wang, 29-Sep-2024.)
theorem oppcthin (C O: class):
  $ wceq O (cfv C coppc) $ >
  $ wi (wcel C cthinc) (wcel O cthinc) $;

--| If the opposite category of a thin category has the same base and hom-sets as the original category, then it has the same composition operation as the original category. (Contributed by Zhi Wang, 16-Oct-2025.)
theorem oppcthinco (ph: wff) (C O: class):
  $ wceq O (cfv C coppc) $ >
  $ wi ph (wcel C cthinc) $ >
  $ wi ph (wceq (cfv C chomf) (cfv O chomf)) $ >
  $ wi ph (wceq (cfv C ccomf) (cfv O ccomf)) $;

--| The opposite category of a thin category whose morphisms are all endomorphisms has the same base, hom-sets ( ~ oppcendc ) and composition operation as the original category. (Contributed by Zhi Wang, 16-Oct-2025.)
theorem oppcthinendc {x3 y1: setvar} (ph: wff) (B2 C H O: class):
  $ wceq O (cfv C coppc) $ >
  $ wi ph (wcel C cthinc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wi (wne (cv x3) (cv y1)) (wceq (co (cv x3) (cv y1) H) c0)) $ >
  $ wi ph (wceq (cfv C ccomf) (cfv O ccomf)) $;

--| Alternate proof of ~ oppcthinendc . (Contributed by Zhi Wang, 16-Oct-2025.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem oppcthinendcALT {x3 y1: setvar} (ph: wff) (B2 C H O: class):
  $ wceq O (cfv C coppc) $ >
  $ wi ph (wcel C cthinc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wi (wne (cv x3) (cv y1)) (wceq (co (cv x3) (cv y1) H) c0)) $ >
  $ wi ph (wceq (cfv C ccomf) (cfv O ccomf)) $;

--| Two structures with the same base, hom-sets and composition operation are either both thin categories or neither. (Contributed by Zhi Wang, 16-Oct-2025.)
theorem thincpropd (ph: wff) (C D V W: class):
  $ wi ph (wceq (cfv C chomf) (cfv D chomf)) $ >
  $ wi ph (wceq (cfv C ccomf) (cfv D ccomf)) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wcel D W) $ >
  $ wi ph (wb (wcel C cthinc) (wcel D cthinc)) $;

--| A subcategory of a thin category is thin. (Contributed by Zhi Wang, 30-Sep-2024.)
theorem subthinc (ph: wff) (C D J: class):
  $ wceq D (co C J cresc) $ >
  $ wi ph (wcel J (cfv C csubc)) $ >
  $ wi ph (wcel C cthinc) $ >
  $ wi ph (wcel D cthinc) $;

--| Lemma for ~ functhinc . Given the object part, there is only one possible morphism part such that the mapped morphism is in its corresponding hom-set. (Contributed by Zhi Wang, 1-Oct-2024.)
theorem functhinclem1 {x3 y1 z w: setvar} (ph: wff x3 y1) (B2: class) (C D E: class x3 y1 z w) (F: class) (G: class x3 y1) (H J: class) (K: class x3 y1):
  $ wceq B2 (cfv D cbs) $ >
  $ wceq C (cfv E cbs) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq J (cfv E chom) $ >
  $ wi ph (wcel E cthinc) $ >
  $ wi ph (wf B2 C F) $ >
  $ wceq K (cmpo x3 y1 B2 B2 (cxp (co (cv x3) (cv y1) H) (co (cfv (cv x3) F) (cfv (cv y1) F) J))) $ >
  $ wi (wa ph (wa (wcel (cv z) B2) (wcel (cv w) B2))) (wi (wceq (co (cfv (cv z) F) (cfv (cv w) F) J) c0) (wceq (co (cv z) (cv w) H) c0)) $ >
  $ wi ph (wb (w3a (wcel G cvv) (wfn G (cxp B2 B2)) (wral z (wral w (wf (co (cv z) (cv w) H) (co (cfv (cv z) F) (cfv (cv w) F) J) (co (cv z) (cv w) G)) B2) B2)) (wceq G K)) $;

--| Lemma for ~ functhinc . (Contributed by Zhi Wang, 1-Oct-2024.)
theorem functhinclem2 {x3 y1: setvar} (ph: wff x3 y1) (B2 F H J X Y: class):
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wral x3 (wral y1 (wi (wceq (co (cfv (cv x3) F) (cfv (cv y1) F) J) c0) (wceq (co (cv x3) (cv y1) H) c0)) B2) B2) $ >
  $ wi ph (wi (wceq (co (cfv X F) (cfv Y F) J) c0) (wceq (co X Y H) c0)) $;

--| Lemma for ~ functhinc . The mapped morphism is in its corresponding hom-set. (Contributed by Zhi Wang, 1-Oct-2024.)
theorem functhinclem3 {x3 y1 n: setvar} (ph: wff n) (B2: class x3 y1 n) (F: class) (G: class x3 y1 n) (H: class n) (J: class) (M: class x3 y1 n) (X Y: class):
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel M (co X Y H)) $ >
  $ wi ph (wceq G (cmpo x3 y1 B2 B2 (cxp (co (cv x3) (cv y1) H) (co (cfv (cv x3) F) (cfv (cv y1) F) J)))) $ >
  $ wi ph (wi (wceq (co (cfv X F) (cfv Y F) J) c0) (wceq (co X Y H) c0)) $ >
  $ wi ph (wmo n (wcel (cv n) (co (cfv X F) (cfv Y F) J))) $ >
  $ wi ph (wcel (cfv M (co X Y G)) (co (cfv X F) (cfv Y F) J)) $;

--| Lemma for ~ functhinc . Other requirements on the morphism part are automatically satisfied. (Contributed by Zhi Wang, 1-Oct-2024.)
theorem functhinclem4 {x3 y1 z w m n a b c: setvar} (ph: wff x3 y1 z w) (B2: class a) (C D c_x c_1 E: class x3 y1 z w m n a b c) (F: class m n a b c) (G: class x3 y1 z w) (H: class m a b c) (I: class x3 y1 z w m n a b c) (J: class m n a b c) (K: class x3 y1 z w) (O: class x3 y1 z w m n a b c):
  $ wceq B2 (cfv D cbs) $ >
  $ wceq C (cfv E cbs) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq J (cfv E chom) $ >
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wcel E cthinc) $ >
  $ wi ph (wf B2 C F) $ >
  $ wceq K (cmpo x3 y1 B2 B2 (cxp (co (cv x3) (cv y1) H) (co (cfv (cv x3) F) (cfv (cv y1) F) J))) $ >
  $ wi ph (wral z (wral w (wi (wceq (co (cfv (cv z) F) (cfv (cv w) F) J) c0) (wceq (co (cv z) (cv w) H) c0)) B2) B2) $ >
  $ wceq c_1 (cfv D ccid) $ >
  $ wceq I (cfv E ccid) $ >
  $ wceq c_x (cfv D cco) $ >
  $ wceq O (cfv E cco) $ >
  $ wi (wa ph (wceq G K)) (wral a (wa (wceq (cfv (cfv (cv a) c_1) (co (cv a) (cv a) G)) (cfv (cfv (cv a) F) I)) (wral b (wral c (wral m (wral n (wceq (cfv (co (cv n) (cv m) (co (cop (cv a) (cv b)) (cv c) c_x)) (co (cv a) (cv c) G)) (co (cfv (cv n) (co (cv b) (cv c) G)) (cfv (cv m) (co (cv a) (cv b) G)) (co (cop (cfv (cv a) F) (cfv (cv b) F)) (cfv (cv c) F) O))) (co (cv b) (cv c) H)) (co (cv a) (cv b) H)) B2) B2)) B2) $;

--| Lemma for ~ functhinc . Other requirements on the morphism part are automatically satisfied. (Contributed by Zhi Wang, 1-Oct-2024.)
theorem functhinclem4_b {x3 y1 m n a b c: setvar} (ph: wff x3 y1) (B2: class a) (C D c_x c_1 E: class x3 y1 m n a b c) (F: class m n a b c) (G: class x3 y1) (H: class m a b c) (I: class x3 y1 m n a b c) (J: class m n a b c) (K: class x3 y1) (O: class x3 y1 m n a b c):
  $ wceq B2 (cfv D cbs) $ >
  $ wceq C (cfv E cbs) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq J (cfv E chom) $ >
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wcel E cthinc) $ >
  $ wi ph (wf B2 C F) $ >
  $ wceq K (cmpo x3 y1 B2 B2 (cxp (co (cv x3) (cv y1) H) (co (cfv (cv x3) F) (cfv (cv y1) F) J))) $ >
  $ wi ph (wral x3 (wral y1 (wi (wceq (co (cfv (cv x3) F) (cfv (cv y1) F) J) c0) (wceq (co (cv x3) (cv y1) H) c0)) B2) B2) $ >
  $ wceq c_1 (cfv D ccid) $ >
  $ wceq I (cfv E ccid) $ >
  $ wceq c_x (cfv D cco) $ >
  $ wceq O (cfv E cco) $ >
  $ wi (wa ph (wceq G K)) (wral a (wa (wceq (cfv (cfv (cv a) c_1) (co (cv a) (cv a) G)) (cfv (cfv (cv a) F) I)) (wral b (wral c (wral m (wral n (wceq (cfv (co (cv n) (cv m) (co (cop (cv a) (cv b)) (cv c) c_x)) (co (cv a) (cv c) G)) (co (cfv (cv n) (co (cv b) (cv c) G)) (cfv (cv m) (co (cv a) (cv b) G)) (co (cop (cfv (cv a) F) (cfv (cv b) F)) (cfv (cv c) F) O))) (co (cv b) (cv c) H)) (co (cv a) (cv b) H)) B2) B2)) B2) $;

--| A functor to a thin category is determined entirely by the object part. The hypothesis "functhinc.1" is related to a monotone function if preorders induced by the categories are considered ( ~ catprs2 ), and can be obtained from ~ funcf2 , ~ f002 , and ~ ralrimivva . (Contributed by Zhi Wang, 1-Oct-2024.)
theorem functhinc {x3 y1 z w: setvar} (ph: wff x3 y1 z w) (B2: class) (C D E: class x3 y1 z w) (F: class) (G: class x3 y1 z w) (H J: class) (K: class x3 y1 z w):
  $ wceq B2 (cfv D cbs) $ >
  $ wceq C (cfv E cbs) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq J (cfv E chom) $ >
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wcel E cthinc) $ >
  $ wi ph (wf B2 C F) $ >
  $ wceq K (cmpo x3 y1 B2 B2 (cxp (co (cv x3) (cv y1) H) (co (cfv (cv x3) F) (cfv (cv y1) F) J))) $ >
  $ wi ph (wral z (wral w (wi (wceq (co (cfv (cv z) F) (cfv (cv w) F) J) c0) (wceq (co (cv z) (cv w) H) c0)) B2) B2) $ >
  $ wi ph (wb (wbr F G (co D E cfunc)) (wceq G K)) $;

--| A functor to a thin category is determined entirely by the object part. The hypothesis "functhinc.1" is related to a monotone function if preorders induced by the categories are considered ( ~ catprs2 ), and can be obtained from ~ funcf2 , ~ f002 , and ~ ralrimivva . (Contributed by Zhi Wang, 1-Oct-2024.)
theorem functhinc_b1 {x3 y1: setvar} (ph: wff x3 y1) (B2: class) (C D E: class x3 y1) (F: class) (G: class x3 y1) (H J: class) (K: class x3 y1):
  $ wceq B2 (cfv D cbs) $ >
  $ wceq C (cfv E cbs) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq J (cfv E chom) $ >
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wcel E cthinc) $ >
  $ wi ph (wf B2 C F) $ >
  $ wceq K (cmpo x3 y1 B2 B2 (cxp (co (cv x3) (cv y1) H) (co (cfv (cv x3) F) (cfv (cv y1) F) J))) $ >
  $ wi ph (wral x3 (wral y1 (wi (wceq (co (cfv (cv x3) F) (cfv (cv y1) F) J) c0) (wceq (co (cv x3) (cv y1) H) c0)) B2) B2) $ >
  $ wi ph (wb (wbr F G (co D E cfunc)) (wceq G K)) $;

--| A functor to a thin category is determined entirely by the object part. (Contributed by Zhi Wang, 16-Oct-2025.)
theorem functhincfun (ph: wff) (C D: class):
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D cthinc) $ >
  $ wi ph (wfun (co C D cfunc)) $;

--| A functor to a thin category is full iff empty hom-sets are mapped to empty hom-sets. (Contributed by Zhi Wang, 1-Oct-2024.)
theorem fullthinc {x3 y1: setvar} (ph: wff x3 y1) (B2 C D F G H J: class):
  $ wceq B2 (cfv C cbs) $ >
  $ wceq J (cfv D chom) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wcel D cthinc) $ >
  $ wi ph (wbr F G (co C D cfunc)) $ >
  $ wi ph (wb (wbr F G (co C D cful)) (wral x3 (wral y1 (wi (wceq (co (cv x3) (cv y1) H) c0) (wceq (co (cfv (cv x3) F) (cfv (cv y1) F) J) c0)) B2) B2)) $;

--| A full functor to a thin category maps empty hom-sets to empty hom-sets. (Contributed by Zhi Wang, 1-Oct-2024.)
theorem fullthinc2 (ph: wff) (B2 C D F G H J X Y: class):
  $ wceq B2 (cfv C cbs) $ >
  $ wceq J (cfv D chom) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wcel D cthinc) $ >
  $ wi ph (wbr F G (co C D cful)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wb (wceq (co X Y H) c0) (wceq (co (cfv X F) (cfv Y F) J) c0)) $;

--| A functor from a thin category is faithful. (Contributed by Zhi Wang, 1-Oct-2024.)
theorem thincfth (ph: wff) (C D F G: class):
  $ wi ph (wcel C cthinc) $ >
  $ wi ph (wbr F G (co C D cfunc)) $ >
  $ wi ph (wbr F G (co C D cfth)) $;

--| Two thin categories are isomorphic iff the induced preorders are order-isomorphic. Example 3.26(2) of [Adamek] p. 33. Note that "thincciso.u" is redundant thanks to ~ elbasfv . (Contributed by Zhi Wang, 16-Oct-2024.)
theorem thincciso {x3 y1 f2: setvar} (ph: wff) (B2: class x3 y1 f2) (C R: class) (S: class x3 y1) (U: class x3 y1 f2) (H J: class) (V: class x3 y1 f2) (X Y: class):
  $ wceq C (cfv U ccatc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq R (cfv X cbs) $ >
  $ wceq S (cfv Y cbs) $ >
  $ wceq H (cfv X chom) $ >
  $ wceq J (cfv Y chom) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel X cthinc) $ >
  $ wi ph (wcel Y cthinc) $ >
  $ wi ph (wb (wbr X Y (cfv C ccic)) (wex f2 (wa (wral x3 (wral y1 (wb (wceq (co (cv x3) (cv y1) H) c0) (wceq (co (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) J) c0)) R) R) (wf1o R S (cv f2))))) $;

--| Two thin categories are isomorphic if the induced preorders are order-isomorphic (deduction form). Example 3.26(2) of [Adamek] p. 33. (Contributed by Zhi Wang, 22-Sep-2025.)
theorem thinccisod {x3 y1: setvar} (ph: wff) (C R: class) (S U: class x3 y1) (F H J: class) (V: class x3 y1) (X Y: class):
  $ wceq C (cfv U ccatc) $ >
  $ wceq R (cfv X cbs) $ >
  $ wceq S (cfv Y cbs) $ >
  $ wceq H (cfv X chom) $ >
  $ wceq J (cfv Y chom) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wcel X U) $ >
  $ wi ph (wcel Y U) $ >
  $ wi ph (wcel X cthinc) $ >
  $ wi ph (wcel Y cthinc) $ >
  $ wi ph (wf1o R S F) $ >
  $ wi (wa ph (wa (wcel (cv x3) R) (wcel (cv y1) R))) (wb (wceq (co (cv x3) (cv y1) H) c0) (wceq (co (cfv (cv x3) F) (cfv (cv y1) F) J) c0)) $ >
  $ wi ph (wbr X Y (cfv C ccic)) $;

--| Categories isomorphic to a thin category are thin. Example 3.26(2) of [Adamek] p. 33. Note that "thincciso2.u" is redundant thanks to ~ elbasfv . (Contributed by Zhi Wang, 18-Oct-2025.)
theorem thincciso2 (ph: wff) (B2 C U F I V X Y: class):
  $ wceq C (cfv U ccatc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq I (cfv C ciso) $ >
  $ wi ph (wcel F (co X Y I)) $ >
  $ wi ph (wcel Y cthinc) $ >
  $ wi ph (wcel X cthinc) $;

--| Categories isomorphic to a thin category are thin. Example 3.26(2) of [Adamek] p. 33. Note that "thincciso2.u" is redundant thanks to ~ elbasfv . (Contributed by Zhi Wang, 18-Oct-2025.)
theorem thincciso3 (ph: wff) (B2 C U F I V X Y: class):
  $ wceq C (cfv U ccatc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq I (cfv C ciso) $ >
  $ wi ph (wcel F (co X Y I)) $ >
  $ wi ph (wcel X cthinc) $ >
  $ wi ph (wcel Y cthinc) $;

--| Two isomorphic categories are either both thin or neither. Note that "thincciso2.u" is redundant thanks to ~ elbasfv . (Contributed by Zhi Wang, 18-Oct-2025.)
theorem thincciso4 (ph: wff) (B2 C U V X Y: class):
  $ wceq C (cfv U ccatc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wbr X Y (cfv C ccic)) $ >
  $ wi ph (wb (wcel X cthinc) (wcel Y cthinc)) $;

--| Any structure with an empty set of objects is a thin category. (Contributed by Zhi Wang, 17-Sep-2024.)
theorem _0thincg (C V: class):
  $ wi (wa (wcel C V) (wceq c0 (cfv C cbs))) (wcel C cthinc) $;

--| The empty category (see ~ 0cat ) is thin. (Contributed by Zhi Wang, 17-Sep-2024.)
theorem _0thinc:
  $ wcel c0 cthinc $;

--| An indiscrete category, i.e., a category where all hom-sets have exactly one morphism, is thin. (Contributed by Zhi Wang, 11-Nov-2025.)
theorem indcthing {x3 y1: setvar} (ph: wff) (B2: class x3) (C: class) (F H: class x3 y1):
  $ wi ph (wceq B2 (cfv C cbs)) $ >
  $ wi ph (wceq H (cfv C chom)) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) H) (csn F)) $ >
  $ wi ph (wcel C cthinc) $;

--| A discrete category, i.e., a category where all morphisms are identity morphisms, is thin. Example 3.26(1) of [Adamek] p. 33. (Contributed by Zhi Wang, 11-Nov-2025.)
theorem discthing {x3 y1: setvar} (ph: wff) (B2: class x3) (C: class) (H I: class x3 y1):
  $ wi ph (wceq B2 (cfv C cbs)) $ >
  $ wi ph (wceq H (cfv C chom)) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) H) (cif (wceq (cv x3) (cv y1)) (csn I) c0)) $ >
  $ wi ph (wcel C cthinc) $;

--| An indiscrete category in which all hom-sets have exactly one morphism is a thin category. Constructed here is an indiscrete category where all morphisms are ` (/) ` . This is a special case of ~ prsthinc , where ` .<_ = ( B X. B ) ` . This theorem also implies a functor from the category of sets to the category of small categories. (Contributed by Zhi Wang, 17-Sep-2024.) (Proof shortened by Zhi Wang, 19-Sep-2024.)
theorem indthinc {y1: setvar} (ph: wff) (B2 C: class) (V: class y1):
  $ wi ph (wceq B2 (cfv C cbs)) $ >
  $ wi ph (wceq (cxp (cxp B2 B2) (csn c1o)) (cfv C chom)) $ >
  $ wi ph (wceq c0 (cfv C cco)) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wa (wcel C cthinc) (wceq (cfv C ccid) (cmpt y1 B2 c0))) $;

--| An alternate proof of ~ indthinc assuming more axioms including ~ ax-pow and ~ ax-un . (Contributed by Zhi Wang, 17-Sep-2024.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem indthincALT {y1: setvar} (ph: wff) (B2 C: class) (V: class y1):
  $ wi ph (wceq B2 (cfv C cbs)) $ >
  $ wi ph (wceq (cxp (cxp B2 B2) (csn c1o)) (cfv C chom)) $ >
  $ wi ph (wceq c0 (cfv C cco)) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wa (wcel C cthinc) (wceq (cfv C ccid) (cmpt y1 B2 c0))) $;

--| Preordered sets as categories. Similar to example 3.3(4.d) of [Adamek] p. 24, but the hom-sets are not pairwise disjoint. One can define a functor from the category of prosets to the category of small thin categories. See ~ catprs and ~ catprs2 for inducing a preorder from a category. Example 3.26(2) of [Adamek] p. 33 indicates that it induces a bijection from the equivalence class of isomorphic small thin categories to the equivalence class of order-isomorphic preordered sets. (Contributed by Zhi Wang, 18-Sep-2024.)
theorem prsthinc {y1: setvar} (ph: wff) (B2 C c_le: class):
  $ wi ph (wceq B2 (cfv C cbs)) $ >
  $ wi ph (wceq (cxp c_le (csn c1o)) (cfv C chom)) $ >
  $ wi ph (wceq c0 (cfv C cco)) $ >
  $ wi ph (wceq c_le (cfv C cple)) $ >
  $ wi ph (wcel C cproset) $ >
  $ wi ph (wa (wcel C cthinc) (wceq (cfv C ccid) (cmpt y1 B2 c0))) $;

--| A category of sets all of whose objects contain at most one element is thin. (Contributed by Zhi Wang, 20-Sep-2024.)
theorem setcthin {x3 p: setvar} (ph: wff x3 p) (C: class x3 p) (U: class) (V: class x3 p):
  $ wi ph (wceq C (cfv U csetc)) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wral x3 (wmo p (wcel (cv p) (cv x3))) U) $ >
  $ wi ph (wcel C cthinc) $;

--| The category ` ( SetCat `` 2o ) ` is thin. A special case of ~ setcthin . (Contributed by Zhi Wang, 20-Sep-2024.)
theorem setc2othin:
  $ wcel (cfv c2o csetc) cthinc $;

--| In a thin category, one morphism is a section of another iff they are pointing towards each other. (Contributed by Zhi Wang, 24-Sep-2024.)
theorem thincsect (ph: wff) (B2 C S F G H X Y: class):
  $ wi ph (wcel C cthinc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq S (cfv C csect) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wb (wbr F G (co X Y S)) (wa (wcel F (co X Y H)) (wcel G (co Y X H)))) $;

--| In a thin category, ` F ` is a section of ` G ` iff ` G ` is a section of ` F ` . Example 7.25(4) of [Adamek] p. 108. (Contributed by Zhi Wang, 24-Sep-2024.)
theorem thincsect2 (ph: wff) (B2 C S F G X Y: class):
  $ wi ph (wcel C cthinc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq S (cfv C csect) $ >
  $ wi ph (wb (wbr F G (co X Y S)) (wbr G F (co Y X S))) $;

--| In a thin category, ` F ` is an inverse of ` G ` iff ` F ` is a section of ` G ` . Example 7.20(7) of [Adamek] p. 107. (Contributed by Zhi Wang, 24-Sep-2024.)
theorem thincinv (ph: wff) (B2 C S F G N X Y: class):
  $ wi ph (wcel C cthinc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq S (cfv C csect) $ >
  $ wceq N (cfv C cinv) $ >
  $ wi ph (wb (wbr F G (co X Y N)) (wbr F G (co X Y S))) $;

--| In a thin category, ` F : X --> Y ` is an isomorphism iff there is a morphism from ` Y ` to ` X ` . (Contributed by Zhi Wang, 25-Sep-2024.)
theorem thinciso (ph: wff) (B2 C F H I X Y: class):
  $ wi ph (wcel C cthinc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq H (cfv C chom) $ >
  $ wceq I (cfv C ciso) $ >
  $ wi ph (wcel F (co X Y H)) $ >
  $ wi ph (wb (wcel F (co X Y I)) (wne (co Y X H) c0)) $;

--| In a thin category, two objects are isomorphic iff there are morphisms between them in both directions. (Contributed by Zhi Wang, 25-Sep-2024.)
theorem thinccic (ph: wff) (B2 C H X Y: class):
  $ wi ph (wcel C cthinc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wb (wbr X Y (cfv C ccic)) (wa (wne (co X Y H) c0) (wne (co Y X H) c0))) $;

--| Extend class notation with the class of terminal categories.
term ctermc: class;

--| Definition of the proper class ( ~ termcnex ) of terminal categories, or final categories, i.e., categories with exactly one object and exactly one morphism, the latter of which is an identity morphism ( ~ termcid ). These are exactly the thin categories with a singleton base set. Example 3.3(4.c) of [Adamek] p. 24. As the name indicates, ` TermCat ` is the class of all terminal objects in the category of small categories ( ~ termcterm3 ). ` TermCat ` is also the class of categories to which all categories have exactly one functor ( ~ dftermc2 ). See also ~ dftermc3 where ` TermCat ` is defined as categories with exactly one disjointified arrow. Unlike ~ https://ncatlab.org/nlab/show/terminal+category , we reserve the term "trivial category" for ` ( SetCat `` 1o ) ` , justified by ~ setc1oterm . Followed directly from the definition, terminal categories are thin ( ~ termcthin ). The opposite category of a terminal category is "almost" itself ( ~ oppctermco ). Any category ` C ` is isomorphic to the category of functors from a terminal category to the category ` C ` ( ~ diagcic ). Having defined the terminal category, we can then use it to define the universal property of initial ( ~ dfinito4 ) and terminal objects ( ~ dftermo4 ). The universal properties provide an alternate proof of ~ initoeu1 , ~ termoeu1 , ~ initoeu2 , and ~ termoeu2 . Since terminal categories are terminal objects, all terminal categories are mutually isomorphic ( ~ termcciso ). The dual concept is the initial category, or the empty category (Example 7.2(3) of [Adamek] p. 101). See ~ 0catg , ~ 0thincg , ~ func0g , ~ 0funcg , and ~ initc . (Contributed by Zhi Wang, 16-Oct-2025.)
axiom df_termc {x3 c: setvar}:
  $ wceq ctermc (crab c (wex x3 (wceq (cfv (cv c) cbs) (csn (cv x3)))) cthinc) $;

--| The predicate "is a terminal category". A terminal category is a thin category with a singleton base set. (Contributed by Zhi Wang, 16-Oct-2025.)
theorem istermc {x3: setvar} (B2: class x3) (C: class):
  $ wceq B2 (cfv C cbs) $ >
  $ wb (wcel C ctermc) (wa (wcel C cthinc) (wex x3 (wceq B2 (csn (cv x3))))) $;

--| The predicate "is a terminal category". A terminal category is a thin category with exactly one object. (Contributed by Zhi Wang, 16-Oct-2025.)
theorem istermc2 {x3: setvar} (B2 C: class):
  $ wceq B2 (cfv C cbs) $ >
  $ wb (wcel C ctermc) (wa (wcel C cthinc) (weu x3 (wcel (cv x3) B2))) $;

--| The predicate "is a terminal category". A terminal category is a thin category whose base set is equinumerous to ` 1o ` . Consider ~ en1b , ~ map1 , and ~ euen1b . (Contributed by Zhi Wang, 16-Oct-2025.)
theorem istermc3 (B2 C: class):
  $ wceq B2 (cfv C cbs) $ >
  $ wb (wcel C ctermc) (wa (wcel C cthinc) (wbr B2 c1o cen)) $;

--| A terminal category is a thin category. (Contributed by Zhi Wang, 16-Oct-2025.)
theorem termcthin (C: class):
  $ wi (wcel C ctermc) (wcel C cthinc) $;

--| A terminal category is a thin category (deduction form). (Contributed by Zhi Wang, 16-Oct-2025.)
theorem termcthind (ph: wff) (C: class):
  $ wi ph (wcel C ctermc) $ >
  $ wi ph (wcel C cthinc) $;

--| A terminal category is a category (deduction form). (Contributed by Zhi Wang, 16-Oct-2025.)
theorem termccatd (ph: wff) (C: class):
  $ wi ph (wcel C ctermc) $ >
  $ wi ph (wcel C ccat) $;

--| The base of a terminal category is a singleton. (Contributed by Zhi Wang, 16-Oct-2025.)
theorem termcbas {x3: setvar} (ph: wff x3) (B2: class x3) (C: class):
  $ wi ph (wcel C ctermc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wex x3 (wceq B2 (csn (cv x3)))) $;

--| The object of a terminal category. (Contributed by Zhi Wang, 17-Nov-2025.)
theorem termco (ph: wff) (B2 C: class):
  $ wi ph (wcel C ctermc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel (cuni B2) B2) $;

--| The base of a terminal category is given by its object. (Contributed by Zhi Wang, 20-Oct-2025.)
theorem termcbas2 (ph: wff) (B2 C X: class):
  $ wi ph (wcel C ctermc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq B2 (csn X)) $;

--| Two objects in a terminal category are identical. (Contributed by Zhi Wang, 16-Oct-2025.)
theorem termcbasmo (ph: wff) (B2 C X Y: class):
  $ wi ph (wcel C ctermc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq X Y) $;

--| All hom-sets of a terminal category are non-empty. (Contributed by Zhi Wang, 17-Oct-2025.)
theorem termchomn0 (ph: wff) (B2 C H X Y: class):
  $ wi ph (wcel C ctermc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wn (wceq (co X Y H) c0)) $;

--| All morphisms of a terminal category are identical. (Contributed by Zhi Wang, 16-Oct-2025.)
theorem termchommo (ph: wff) (B2 C F G H W X Y Z: class):
  $ wi ph (wcel C ctermc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wcel F (co X Y H)) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wcel W B2) $ >
  $ wi ph (wcel G (co Z W H)) $ >
  $ wi ph (wceq F G) $;

--| The morphism of a terminal category is an identity morphism. (Contributed by Zhi Wang, 16-Oct-2025.)
theorem termcid (ph: wff) (B2 C c_1 F H X Y: class):
  $ wi ph (wcel C ctermc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wcel F (co X Y H)) $ >
  $ wceq c_1 (cfv C ccid) $ >
  $ wi ph (wceq F (cfv X c_1)) $;

--| The morphism of a terminal category is an identity morphism. (Contributed by Zhi Wang, 16-Oct-2025.)
theorem termcid2 (ph: wff) (B2 C c_1 F H X Y: class):
  $ wi ph (wcel C ctermc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wcel F (co X Y H)) $ >
  $ wceq c_1 (cfv C ccid) $ >
  $ wi ph (wceq F (cfv Y c_1)) $;

--| The hom-set of a terminal category is a singleton of the identity morphism. (Contributed by Zhi Wang, 20-Oct-2025.)
theorem termchom (ph: wff) (B2 C c_1 H X Y: class):
  $ wi ph (wcel C ctermc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq H (cfv C chom) $ >
  $ wceq c_1 (cfv C ccid) $ >
  $ wi ph (wceq (co X Y H) (csn (cfv X c_1))) $;

--| The hom-set of a terminal category is a singleton of the identity morphism. (Contributed by Zhi Wang, 21-Oct-2025.)
theorem termchom2 (ph: wff) (B2 C c_1 H X Y Z: class):
  $ wi ph (wcel C ctermc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq H (cfv C chom) $ >
  $ wceq c_1 (cfv C ccid) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wceq (co X Y H) (csn (cfv Z c_1))) $;

--| The category of one set, either a singleton set or an empty set, is terminal. (Contributed by Zhi Wang, 18-Oct-2025.)
theorem setcsnterm (A2: class):
  $ wcel (cfv (csn (csn A2)) csetc) ctermc $;

--| The category ` ( SetCat `` 1o ) ` , i.e., the _trivial category_, is terminal. (Contributed by Zhi Wang, 18-Oct-2025.)
theorem setc1oterm:
  $ wcel (cfv c1o csetc) ctermc $;

--| The base of the trivial category. (Contributed by Zhi Wang, 22-Oct-2025.)
theorem setc1obas (c_1: class):
  $ wceq c_1 (cfv c1o csetc) $ >
  $ wceq c1o (cfv c_1 cbs) $;

--| Set of morphisms of the trivial category. (Contributed by Zhi Wang, 22-Oct-2025.)
theorem setc1ohomfval (c_1: class):
  $ wceq c_1 (cfv c1o csetc) $ >
  $ wceq (csn (cotp c0 c0 c1o)) (cfv c_1 chom) $;

--| Composition in the trivial category. (Contributed by Zhi Wang, 22-Oct-2025.)
theorem setc1ocofval (c_1: class):
  $ wceq c_1 (cfv c1o csetc) $ >
  $ wceq (csn (cotp (cop c0 c0) c0 (csn (cotp c0 c0 c0)))) (cfv c_1 cco) $;

--| The identity morphism of the trivial category. (Contributed by Zhi Wang, 22-Oct-2025.)
theorem setc1oid (c_1 I: class):
  $ wceq c_1 (cfv c1o csetc) $ >
  $ wceq I (cfv c_1 ccid) $ >
  $ wceq (cfv c0 I) c0 $;

--| The functor to the trivial category. The converse is also true due to reverse closure. (Contributed by Zhi Wang, 22-Oct-2025.)
theorem funcsetc1ocl (ph: wff) (C c_1 F: class):
  $ wceq c_1 (cfv c1o csetc) $ >
  $ wceq F (cfv c0 (cfv (co c_1 C cdiag) c1st)) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel F (co C c_1 cfunc)) $;

--| Value of the functor to the trivial category. The converse is also true because ` F ` would be the empty set if ` C ` were not a category; and the empty set cannot equal an ordered pair of two sets. (Contributed by Zhi Wang, 22-Oct-2025.)
theorem funcsetc1o {x3 y1: setvar} (ph: wff) (B2: class) (C c_1: class x3 y1) (F: class) (H: class x3 y1):
  $ wceq c_1 (cfv c1o csetc) $ >
  $ wceq F (cfv c0 (cfv (co c_1 C cdiag) c1st)) $ >
  $ wi ph (wcel C ccat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wceq F (cop (cxp B2 c1o) (cmpo x3 y1 B2 B2 (cxp (co (cv x3) (cv y1) H) c1o)))) $;

--| The predicate "is an initial object" of a category, using universal property. (Contributed by Zhi Wang, 23-Oct-2025.)
theorem isinito2lem (ph: wff) (C c_1 F I: class):
  $ wceq c_1 (cfv c1o csetc) $ >
  $ wceq F (cfv c0 (cfv (co c_1 C cdiag) c1st)) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel I (cfv C cbs)) $ >
  $ wi ph (wb (wcel I (cfv C cinito)) (wbr I c0 (co F c0 (co C c_1 cup)))) $;

--| The predicate "is an initial object" of a category, using universal property. (Contributed by Zhi Wang, 23-Oct-2025.)
theorem isinito2 (C c_1 F I: class):
  $ wceq c_1 (cfv c1o csetc) $ >
  $ wceq F (cfv c0 (cfv (co c_1 C cdiag) c1st)) $ >
  $ wb (wcel I (cfv C cinito)) (wbr I c0 (co F c0 (co C c_1 cup))) $;

--| The predicate "is an initial object" of a category, using universal property. (Contributed by Zhi Wang, 23-Oct-2025.)
theorem isinito3 (C c_1 F I: class):
  $ wceq c_1 (cfv c1o csetc) $ >
  $ wceq F (cfv c0 (cfv (co c_1 C cdiag) c1st)) $ >
  $ wb (wcel I (cfv C cinito)) (wcel I (cdm (co F c0 (co C c_1 cup)))) $;

--| An alternate definition of ~ df-inito using universal property. See also the "Equivalent formulations" section of ~ https://en.wikipedia.org/wiki/Initial_and_terminal_objects . (Contributed by Zhi Wang, 23-Oct-2025.)
theorem dfinito4 {f2 c d: setvar}:
  $ wceq cinito (cmpt c ccat (csb d (cfv c1o csetc) (csb f2 (cfv c0 (cfv (co (cv d) (cv c) cdiag) c1st)) (cdm (co (cv f2) c0 (co (cv c) (cv d) cup)))))) $;

--| An alternate definition of ~ df-termo using universal property. See also the "Equivalent formulations" section of ~ https://en.wikipedia.org/wiki/Initial_and_terminal_objects . (Contributed by Zhi Wang, 23-Oct-2025.)
theorem dftermo4 {f2 o c d: setvar}:
  $ wceq ctermo (cmpt c ccat (csb o (cfv (cv c) coppc) (csb d (cfv c1o csetc) (csb f2 (cfv c0 (cfv (co (cv d) (cv o) cdiag) c1st)) (cdm (co (cv f2) c0 (co (cv o) (cv d) cup))))))) $;

--| Two structures with the same base, hom-sets and composition operation are either both terminal categories or neither. (Contributed by Zhi Wang, 16-Oct-2025.)
theorem termcpropd (ph: wff) (C D V W: class):
  $ wi ph (wceq (cfv C chomf) (cfv D chomf)) $ >
  $ wi ph (wceq (cfv C ccomf) (cfv D ccomf)) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wcel D W) $ >
  $ wi ph (wb (wcel C ctermc) (wcel D ctermc)) $;

--| The opposite category of a terminal category has the same base and hom-sets as the original category. (Contributed by Zhi Wang, 16-Oct-2025.)
theorem oppctermhom (ph: wff) (C O: class):
  $ wceq O (cfv C coppc) $ >
  $ wi ph (wcel C ctermc) $ >
  $ wi ph (wceq (cfv C chomf) (cfv O chomf)) $;

--| The opposite category of a terminal category has the same base, hom-sets and composition operation as the original category. Note that ` C = O ` cannot be proved because ` C ` might not even be a function. For example, let ` C ` be ` ( { <. ( Base `` ndx ) , { (/) } >. , ` ` <. ( Hom `` ndx ) , ( ( _V X. _V ) X. { { (/) } } ) >. } u. ` ` { <. ( comp `` ndx ) , { (/) } >. , <. ( comp `` ndx ) , 2o >. } ) ` ; it should be a terminal category, but the opposite category is not itself. See the definitions ~ df-oppc and ~ df-sets . (Contributed by Zhi Wang, 16-Oct-2025.)
theorem oppctermco (ph: wff) (C O: class):
  $ wceq O (cfv C coppc) $ >
  $ wi ph (wcel C ctermc) $ >
  $ wi ph (wceq (cfv C ccomf) (cfv O ccomf)) $;

--| The opposite category of a terminal category is a terminal category. (Contributed by Zhi Wang, 16-Oct-2025.)
theorem oppcterm (ph: wff) (C O: class):
  $ wceq O (cfv C coppc) $ >
  $ wi ph (wcel C ctermc) $ >
  $ wi ph (wcel O ctermc) $;

--| Lemma for ~ functermc . (Contributed by Zhi Wang, 17-Oct-2025.)
theorem functermclem (ph: wff) (R F G K L: class):
  $ wi (wa ph (wbr K L R)) (wceq K F) $ >
  $ wi ph (wb (wbr F L R) (wceq L G)) $ >
  $ wi ph (wb (wbr K L R) (wa (wceq K F) (wceq L G))) $;

--| Functor to a terminal category. (Contributed by Zhi Wang, 17-Oct-2025.)
theorem functermc {x3 y1: setvar} (ph: wff x3 y1) (B2: class) (C D E: class x3 y1) (F: class) (G: class x3 y1) (H J: class) (K L: class x3 y1):
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wcel E ctermc) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wceq C (cfv E cbs) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq J (cfv E chom) $ >
  $ wceq F (cxp B2 C) $ >
  $ wceq G (cmpo x3 y1 B2 B2 (cxp (co (cv x3) (cv y1) H) (co (cfv (cv x3) F) (cfv (cv y1) F) J))) $ >
  $ wi ph (wb (wbr K L (co D E cfunc)) (wa (wceq K F) (wceq L G))) $;

--| Functor to a terminal category. (Contributed by Zhi Wang, 17-Oct-2025.)
theorem functermc2 {x3 y1: setvar} (ph: wff x3 y1) (B2: class) (C D E: class x3 y1) (F: class) (G: class x3 y1) (H J: class):
  $ wi ph (wcel D ccat) $ >
  $ wi ph (wcel E ctermc) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wceq C (cfv E cbs) $ >
  $ wceq H (cfv D chom) $ >
  $ wceq J (cfv E chom) $ >
  $ wceq F (cxp B2 C) $ >
  $ wceq G (cmpo x3 y1 B2 B2 (cxp (co (cv x3) (cv y1) H) (co (cfv (cv x3) F) (cfv (cv y1) F) J))) $ >
  $ wi ph (wceq (co D E cfunc) (csn (cop F G))) $;

--| There exists a unique functor to a terminal category. (Contributed by Zhi Wang, 17-Oct-2025.)
theorem functermceu {f2: setvar} (ph: wff f2) (C D: class):
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ctermc) $ >
  $ wi ph (weu f2 (wcel (cv f2) (co C D cfunc))) $;

--| A functor to a terminal category is full iff all hom-sets of the source category are non-empty. (Contributed by Zhi Wang, 17-Oct-2025.)
theorem fulltermc {x3 y1: setvar} (ph: wff) (B2 C D F G H: class):
  $ wceq B2 (cfv C cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wcel D ctermc) $ >
  $ wi ph (wbr F G (co C D cfunc)) $ >
  $ wi ph (wb (wbr F G (co C D cful)) (wral x3 (wral y1 (wn (wceq (co (cv x3) (cv y1) H) c0)) B2) B2)) $;

--| Given a full functor to a terminal category, the source category must not have empty hom-sets. (Contributed by Zhi Wang, 17-Oct-2025.) (Proof shortened by Zhi Wang, 6-Nov-2025.)
theorem fulltermc2 (ph: wff) (B2 C D F G H X Y: class):
  $ wceq B2 (cfv C cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wcel D ctermc) $ >
  $ wi ph (wbr F G (co C D cful)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wn (wceq (co X Y H) c0)) $;

--| A terminal category is a terminal object of the category of small categories. (Contributed by Zhi Wang, 17-Oct-2025.)
theorem termcterm (ph: wff) (C U E V: class):
  $ wceq E (cfv U ccatc) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wcel C U) $ >
  $ wi ph (wcel C ctermc) $ >
  $ wi ph (wcel C (cfv E ctermo)) $;

--| A terminal object of the category of small categories is a terminal category. (Contributed by Zhi Wang, 18-Oct-2025.) (Proof shortened by Zhi Wang, 23-Oct-2025.)
theorem termcterm2 (ph: wff) (C U E: class):
  $ wceq E (cfv U ccatc) $ >
  $ wi ph (wne (cin U ctermc) c0) $ >
  $ wi ph (wcel C (cfv E ctermo)) $ >
  $ wi ph (wcel C ctermc) $;

--| In the category of small categories, a terminal object is equivalent to a terminal category. (Contributed by Zhi Wang, 18-Oct-2025.)
theorem termcterm3 (ph: wff) (C U E V: class):
  $ wceq E (cfv U ccatc) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wcel C U) $ >
  $ wi ph (wcel (cfv c1o csetc) U) $ >
  $ wi ph (wb (wcel C ctermc) (wcel C (cfv E ctermo))) $;

--| A category is isomorphic to a terminal category iff it itself is terminal. (Contributed by Zhi Wang, 26-Oct-2025.)
theorem termcciso (ph: wff) (B2 C U X Y: class):
  $ wceq C (cfv U ccatc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel X ctermc) $ >
  $ wi ph (wb (wcel Y ctermc) (wbr X Y (cfv C ccic))) $;

--| The isomorphism between terminal categories is unique. (Contributed by Zhi Wang, 26-Oct-2025.)
theorem termccisoeu {f2: setvar} (ph: wff) (B2: class f2) (C: class) (U: class f2) (X Y: class):
  $ wceq C (cfv U ccatc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel X ctermc) $ >
  $ wi ph (wcel Y ctermc) $ >
  $ wi ph (weu f2 (wcel (cv f2) (co X Y (cfv C ciso)))) $;

--| If there exists a unique functor from both the category itself and the trivial category, then the category is terminal. Note that the converse also holds, so that it is a biconditional. See the proof of ~ termc for hints. See also ~ eufunc and ~ euendfunc2 for some insights on why two categories are sufficient. (Contributed by Zhi Wang, 18-Oct-2025.) (Proof shortened by Zhi Wang, 20-Oct-2025.)
theorem termc2 {f2 d: setvar} (C: class):
  $ wi (wral d (weu f2 (wcel (cv f2) (co (cv d) C cfunc))) (cin (cpr C (cfv c1o csetc)) ccat)) (wcel C ctermc) $;

--| Alternate definition of ` TermCat ` . See also ~ df-termc . (Contributed by Zhi Wang, 18-Oct-2025.)
theorem termc {f2 d: setvar} (C: class):
  $ wb (wcel C ctermc) (wral d (weu f2 (wcel (cv f2) (co (cv d) C cfunc))) ccat) $;

--| Alternate definition of ` TermCat ` . See also ~ df-termc and ~ dftermc3 . (Contributed by Zhi Wang, 18-Oct-2025.)
theorem dftermc2 {f2 c d: setvar}:
  $ wceq ctermc (cab c (wral d (weu f2 (wcel (cv f2) (co (cv d) (cv c) cfunc))) ccat)) $;

--| If there exists a unique functor from a non-empty category, then the base of the target category is at most a singleton. (Contributed by Zhi Wang, 19-Oct-2025.)
theorem eufunclem {f2: setvar} (ph: wff f2) (A2 B2: class f2) (C D: class):
  $ wi ph (weu f2 (wcel (cv f2) (co C D cfunc))) $ >
  $ wceq A2 (cfv C cbs) $ >
  $ wi ph (wne A2 c0) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wbr B2 c1o cdom) $;

--| If there exists a unique functor from a non-empty category, then the base of the target category is a singleton. (Contributed by Zhi Wang, 19-Oct-2025.)
theorem eufunc {x3 f2: setvar} (ph: wff x3 f2) (A2: class x3) (B2: class) (C D: class x3):
  $ wi ph (weu f2 (wcel (cv f2) (co C D cfunc))) $ >
  $ wceq A2 (cfv C cbs) $ >
  $ wi ph (wne A2 c0) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (weu x3 (wcel (cv x3) B2)) $;

--| Lemma for ~ idfudiag1bas and ~ idfudiag1 . (Contributed by Zhi Wang, 19-Oct-2025.)
theorem idfudiag1lem (ph: wff) (A2 B2: class):
  $ wi ph (wceq (cres cid A2) (cxp A2 (csn B2))) $ >
  $ wi ph (wne A2 c0) $ >
  $ wi ph (wceq A2 (csn B2)) $;

--| If the identity functor of a category is the same as a constant functor to the category, then the base is a singleton. (Contributed by Zhi Wang, 19-Oct-2025.)
theorem idfudiag1bas (ph: wff) (B2 C I K L X: class):
  $ wceq I (cfv C cidfu) $ >
  $ wceq L (co C C cdiag) $ >
  $ wi ph (wcel C ccat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wceq K (cfv X (cfv L c1st)) $ >
  $ wi ph (wceq I K) $ >
  $ wi ph (wceq B2 (csn X)) $;

--| If the identity functor of a category is the same as a constant functor to the category, then the category is terminal. (Contributed by Zhi Wang, 19-Oct-2025.)
theorem idfudiag1 (ph: wff) (B2 C I K L X: class):
  $ wceq I (cfv C cidfu) $ >
  $ wceq L (co C C cdiag) $ >
  $ wi ph (wcel C ccat) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wceq K (cfv X (cfv L c1st)) $ >
  $ wi ph (wceq I K) $ >
  $ wi ph (wcel C ctermc) $;

--| If there exists a unique endofunctor (a functor from a category to itself) for a non-empty category, then the category is terminal. This partially explains why two categories are sufficient in ~ termc2 . (Contributed by Zhi Wang, 20-Oct-2025.)
theorem euendfunc {f2: setvar} (ph: wff f2) (B2: class f2) (C: class):
  $ wi ph (weu f2 (wcel (cv f2) (co C C cfunc))) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wne B2 c0) $ >
  $ wi ph (wcel C ctermc) $;

--| If there exists a unique endofunctor (a functor from a category to itself) for a category, then it is either initial (empty) or terminal. (Contributed by Zhi Wang, 20-Oct-2025.)
theorem euendfunc2 (C: class):
  $ wi (wbr (co C C cfunc) c1o cen) (wo (wceq (cfv C cbs) c0) (wcel C ctermc)) $;

--| There exists a unique disjointified arrow in a terminal category. (Contributed by Zhi Wang, 20-Oct-2025.)
theorem termcarweu {a: setvar} (C: class):
  $ wi (wcel C ctermc) (weu a (wcel (cv a) (cfv C carw))) $;

--| If a structure has a unique disjointified arrow, then the structure is a thin category. (Contributed by Zhi Wang, 20-Oct-2025.)
theorem arweuthinc {a: setvar} (C: class):
  $ wi (weu a (wcel (cv a) (cfv C carw))) (wcel C cthinc) $;

--| If a structure has a unique disjointified arrow, then the structure is a terminal category. (Contributed by Zhi Wang, 20-Oct-2025.)
theorem arweutermc {a: setvar} (C: class):
  $ wi (weu a (wcel (cv a) (cfv C carw))) (wcel C ctermc) $;

--| Alternate definition of ` TermCat ` . See also ~ df-termc , ~ dftermc2 . (Contributed by Zhi Wang, 20-Oct-2025.)
theorem dftermc3 {c: setvar}:
  $ wceq ctermc (cab c (wbr (cfv (cv c) carw) c1o cen)) $;

--| The value of a functor from a terminal category. (Contributed by Zhi Wang, 20-Oct-2025.)
theorem termcfuncval (ph: wff) (A2 B2 C D c_1 I K X Y: class):
  $ wceq A2 (cfv C cbs) $ >
  $ wi ph (wcel D ctermc) $ >
  $ wi ph (wcel K (co D C cfunc)) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq X (cfv Y (cfv K c1st)) $ >
  $ wceq c_1 (cfv C ccid) $ >
  $ wceq I (cfv D ccid) $ >
  $ wi ph (wa (wcel X A2) (wceq K (cop (csn (cop Y X)) (csn (cop (cop Y Y) (csn (cop (cfv Y I) (cfv X c_1)))))))) $;

--| To any functor from a terminal category can an object in the target base be assigned. (Contributed by Zhi Wang, 21-Oct-2025.)
theorem diag1f1olem (ph: wff) (A2 B2 C D K L X Y: class):
  $ wceq A2 (cfv C cbs) $ >
  $ wi ph (wcel D ctermc) $ >
  $ wi ph (wcel K (co D C cfunc)) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq X (cfv Y (cfv K c1st)) $ >
  $ wceq L (co C D cdiag) $ >
  $ wi ph (wa (wcel X A2) (wceq K (cfv X (cfv L c1st)))) $;

--| The object part of the diagonal functor is a bijection if ` D ` is terminal. So any functor from a terminal category is one-to-one correspondent to an object of the target base. (Contributed by Zhi Wang, 21-Oct-2025.)
theorem diag1f1o (ph: wff) (A2 C D L: class):
  $ wceq A2 (cfv C cbs) $ >
  $ wi ph (wcel D ctermc) $ >
  $ wi ph (wcel C ccat) $ >
  $ wceq L (co C D cdiag) $ >
  $ wi ph (wf1o A2 (co D C cfunc) (cfv L c1st)) $;

--| Functors with terminal source are equal when they agree on its object. (Contributed by Zhi Wang, 14-Sep-2026.)
theorem termcfunc1eq (ph: wff) (B2 C D F G Y: class):
  $ wi ph (wcel C ctermc) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel G (co C D cfunc)) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (cfv Y (cfv F c1st)) (cfv Y (cfv G c1st))) $ >
  $ wi ph (wceq F G) $;

--| Post-composition by an object-fixing endofunctor leaves a functor with terminal source literally unchanged. (Contributed by Zhi Wang, 14-Sep-2026.)
theorem termccofix (ph: wff) (A2 C D S F: class):
  $ wi ph (wcel C ctermc) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wcel S (co D D cfunc)) $ >
  $ wi ph (wceq (cfv S c1st) (cres cid A2)) $ >
  $ wi ph (wceq (co S F ccofu) F) $;

--| Post-composition by an object-fixing endofunctor induces an object-fixing endofunctor on a functor category with terminal source. (Contributed by Zhi Wang, 14-Sep-2026.)
theorem termcpostfix (ph: wff) (A2 C D Q R F K c_op: class):
  $ wi ph (wcel C ctermc) $ >
  $ wceq Q (co C D cfuc) $ >
  $ wceq R (co D D cfuc) $ >
  $ wceq c_op (co (cop R Q) (co (cop C D) D cfuco) ccurf) $ >
  $ wceq K (cfv F (cfv c_op c1st)) $ >
  $ wi ph (wcel F (co D D cfunc)) $ >
  $ wi ph (wceq (cfv F c1st) (cres cid A2)) $ >
  $ wi ph (wa (wcel K (co Q Q cfunc)) (wceq (cfv K c1st) (cres cid (co C D cfunc)))) $;

--| Value of natural transformations for a terminal category. (Contributed by Zhi Wang, 21-Oct-2025.)
theorem termcnatval (ph: wff) (A2 B2 C D R F G N X: class):
  $ wi ph (wcel C ctermc) $ >
  $ wceq N (co C D cnat) $ >
  $ wi ph (wcel A2 (co F G N)) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wceq R (cfv X A2) $ >
  $ wi ph (wceq A2 (csn (cop X R))) $;

--| Lemma for ~ diag2f1o . (Contributed by Zhi Wang, 21-Oct-2025.)
theorem diag2f1olem (ph: wff) (A2 B2 C D F H L M N X Y Z: class):
  $ wceq L (co C D cdiag) $ >
  $ wceq A2 (cfv C cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y A2) $ >
  $ wceq N (co D C cnat) $ >
  $ wi ph (wcel D ctermc) $ >
  $ wi ph (wcel M (co (cfv X (cfv L c1st)) (cfv Y (cfv L c1st)) N)) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wi ph (wcel Z B2) $ >
  $ wceq F (cfv Z M) $ >
  $ wi ph (wa (wcel F (co X Y H)) (wceq M (cfv F (co X Y (cfv L c2nd))))) $;

--| If ` D ` is terminal, the morphism part of a diagonal functor is bijective functions from hom-sets into sets of natural transformations. (Contributed by Zhi Wang, 21-Oct-2025.)
theorem diag2f1o (ph: wff) (A2 C D H L N X Y: class):
  $ wceq L (co C D cdiag) $ >
  $ wceq A2 (cfv C cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y A2) $ >
  $ wceq N (co D C cnat) $ >
  $ wi ph (wcel D ctermc) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wf1o (co X Y H) (co (cfv X (cfv L c1st)) (cfv Y (cfv L c1st)) N) (co X Y (cfv L c2nd))) $;

--| The diagonal functor is a fully faithful functor from a category ` C ` to the category of functors from a terminal category to ` C ` . (Contributed by Zhi Wang, 21-Oct-2025.)
theorem diagffth (ph: wff) (C D Q L: class):
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ctermc) $ >
  $ wceq Q (co D C cfuc) $ >
  $ wceq L (co C D cdiag) $ >
  $ wi ph (wcel L (cin (co C Q cful) (co C Q cfth))) $;

--| The diagonal functor is an isomorphism from a category ` C ` to the category of functors from a terminal category to ` C ` . It is provable that the inverse of the diagonal functor is the mapped object by the transposed curry of ` ( D evalF C ) ` , i.e., ` U. ran ( 1st `` ( <. D , Q >. curryF ( ( D evalF C ) ` ` o.func ( D swapF Q ) ) ) ) ` . (Contributed by Zhi Wang, 21-Oct-2025.)
theorem diagciso (ph: wff) (C D Q U E I L V: class):
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ctermc) $ >
  $ wceq Q (co D C cfuc) $ >
  $ wceq E (cfv U ccatc) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wcel C U) $ >
  $ wi ph (wcel Q U) $ >
  $ wceq I (cfv E ciso) $ >
  $ wceq L (co C D cdiag) $ >
  $ wi ph (wcel L (co C Q I)) $;

--| Any category ` C ` is isomorphic to the category of functors from a terminal category to ` C ` . See also the "Properties" section of ~ https://ncatlab.org/nlab/show/terminal+category . Therefore the number of categories isomorphic to a non-empty category is at least the number of singletons, so large ( ~ snnex ) that these isomorphic categories form a proper class. (Contributed by Zhi Wang, 21-Oct-2025.)
theorem diagcic (ph: wff) (C D Q U E V: class):
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ctermc) $ >
  $ wceq Q (co D C cfuc) $ >
  $ wceq E (cfv U ccatc) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wcel C U) $ >
  $ wi ph (wcel Q U) $ >
  $ wi ph (wbr C Q (cfv E ccic)) $;

--| The category of one functor to a thin category is terminal. (Contributed by Zhi Wang, 17-Nov-2025.)
theorem funcsn (ph: wff) (C D Q F V: class):
  $ wceq Q (co C D cfuc) $ >
  $ wi ph (wcel F V) $ >
  $ wi ph (wceq (co C D cfunc) (csn F)) $ >
  $ wi ph (wcel D cthinc) $ >
  $ wi ph (wcel Q ctermc) $;

--| The category of functors to a terminal category is terminal. (Contributed by Zhi Wang, 17-Nov-2025.)
theorem fucterm (ph: wff) (C D Q: class):
  $ wceq Q (co C D cfuc) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel D ctermc) $ >
  $ wi ph (wcel Q ctermc) $;

--| The category of functors from an initial category is terminal. (Contributed by Zhi Wang, 17-Nov-2025.)
theorem _0fucterm (ph: wff) (C D Q V: class):
  $ wi ph (wcel C V) $ >
  $ wi ph (wceq c0 (cfv C cbs)) $ >
  $ wi ph (wcel D ccat) $ >
  $ wceq Q (co C D cfuc) $ >
  $ wi ph (wcel Q ctermc) $;

--| All functors between two terminal categories are isomorphisms. (Contributed by Zhi Wang, 17-Nov-2025.)
theorem termfucterm (ph: wff) (B2 C U I X Y: class):
  $ wceq C (cfv U ccatc) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq I (cfv C ciso) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel X ctermc) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Y ctermc) $ >
  $ wi ph (wceq (co X Y cfunc) (co X Y I)) $;

--| Post-compose with a functor to a terminal category. (Contributed by Zhi Wang, 17-Nov-2025.)
theorem cofuterm (ph: wff) (C D E F G K: class):
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wcel G (co D E cfunc)) $ >
  $ wi ph (wcel K (co C E cfunc)) $ >
  $ wi ph (wcel E ctermc) $ >
  $ wi ph (wceq (co G F ccofu) K) $;

--| Universal objects and terminal categories. (Contributed by Zhi Wang, 17-Nov-2025.)
theorem uobeqterm (ph: wff) (A2 B2 C D E F G X Y: class):
  $ wceq A2 (cfv D cbs) $ >
  $ wceq B2 (cfv E cbs) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wcel G (co C E cfunc)) $ >
  $ wi ph (wcel D ctermc) $ >
  $ wi ph (wcel E ctermc) $ >
  $ wi ph (wceq (cdm (co F X (co C D cup))) (cdm (co G Y (co C E cup)))) $;

--| The predicate "is an initial object" of a category, using universal property. (Contributed by Zhi Wang, 17-Nov-2025.)
theorem isinito4 (ph: wff) (C c_1 F I X: class):
  $ wi ph (wcel c_1 ctermc) $ >
  $ wi ph (wcel X (cfv c_1 cbs)) $ >
  $ wi ph (wcel F (co C c_1 cfunc)) $ >
  $ wi ph (wb (wcel I (cfv C cinito)) (wcel I (cdm (co F X (co C c_1 cup))))) $;

--| The predicate "is an initial object" of a category, using universal property. (Contributed by Zhi Wang, 17-Nov-2025.)
theorem isinito4a (ph: wff) (C c_1 F I X: class):
  $ wi ph (wcel c_1 ctermc) $ >
  $ wi ph (wcel X (cfv c_1 cbs)) $ >
  $ wceq F (cfv X (cfv (co c_1 C cdiag) c1st)) $ >
  $ wi ph (wb (wcel I (cfv C cinito)) (wcel I (cdm (co F X (co C c_1 cup))))) $;

--| Class function defining preordered sets as categories.
term cprstc: class;

--| Definition of the function converting a preordered set to a category. Justified by ~ prsthinc . This definition is somewhat arbitrary. Example 3.3(4.d) of [Adamek] p. 24 demonstrates an alternate definition with pairwise disjoint hom-sets. The behavior of the function is defined entirely, up to isomorphism ( ~ thincciso ), by ~ prstcnid , ~ prstchom , and ~ prstcthin . Other important properties include ~ prstcbas , ~ prstcleval , ~ prstcle , ~ prstcocval , ~ prstcoc , ~ prstchom2 , and ~ prstcprs . Use those instead. Note that the defining property ~ prstchom is equivalent to ~ prstchom2 given ~ prstcthin . See ~ thincn0eu for justification. "ProsetToCat" was taken instead of "ProsetCat" because the latter might mean the category of preordered sets (classes). However, "ProsetToCat" seems too long. (Contributed by Zhi Wang, 20-Sep-2024.) (New usage is discouraged.)
axiom df_prstc {k: setvar}:
  $ wceq cprstc (cmpt k cproset (co (co (cv k) (cop (cfv cnx chom) (cxp (cfv (cv k) cple) (csn c1o))) csts) (cop (cfv cnx cco) c0) csts)) $;

--| Lemma for ~ prstcnidlem and ~ prstcthin . (Contributed by Zhi Wang, 20-Sep-2024.) (New usage is discouraged.)
theorem prstcval (ph: wff) (C K: class):
  $ wi ph (wceq C (cfv K cprstc)) $ >
  $ wi ph (wcel K cproset) $ >
  $ wi ph (wceq C (co (co K (cop (cfv cnx chom) (cxp (cfv K cple) (csn c1o))) csts) (cop (cfv cnx cco) c0) csts)) $;

--| Lemma for ~ prstcnid and ~ prstchomval . (Contributed by Zhi Wang, 20-Sep-2024.) (New usage is discouraged.)
theorem prstcnidlem (ph: wff) (C E K: class):
  $ wi ph (wceq C (cfv K cprstc)) $ >
  $ wi ph (wcel K cproset) $ >
  $ wceq E (cslot (cfv cnx E)) $ >
  $ wne (cfv cnx E) (cfv cnx cco) $ >
  $ wi ph (wceq (cfv C E) (cfv (co K (cop (cfv cnx chom) (cxp (cfv K cple) (csn c1o))) csts) E)) $;

--| Components other than ` Hom ` and ` comp ` are unchanged. (Contributed by Zhi Wang, 20-Sep-2024.)
theorem prstcnid (ph: wff) (C E K: class):
  $ wi ph (wceq C (cfv K cprstc)) $ >
  $ wi ph (wcel K cproset) $ >
  $ wceq E (cslot (cfv cnx E)) $ >
  $ wne (cfv cnx E) (cfv cnx cco) $ >
  $ wne (cfv cnx E) (cfv cnx chom) $ >
  $ wi ph (wceq (cfv K E) (cfv C E)) $;

--| The base set is unchanged. (Contributed by Zhi Wang, 20-Sep-2024.)
theorem prstcbas (ph: wff) (B2 C K: class):
  $ wi ph (wceq C (cfv K cprstc)) $ >
  $ wi ph (wcel K cproset) $ >
  $ wi ph (wceq B2 (cfv K cbs)) $ >
  $ wi ph (wceq B2 (cfv C cbs)) $;

--| Value of the less-than-or-equal-to relation is unchanged. (Contributed by Zhi Wang, 20-Sep-2024.) (Proof shortened by AV, 12-Nov-2024.)
theorem prstcleval (ph: wff) (C K c_le: class):
  $ wi ph (wceq C (cfv K cprstc)) $ >
  $ wi ph (wcel K cproset) $ >
  $ wi ph (wceq c_le (cfv K cple)) $ >
  $ wi ph (wceq c_le (cfv C cple)) $;

--| Value of the less-than-or-equal-to relation is unchanged. (Contributed by Zhi Wang, 20-Sep-2024.)
theorem prstcle (ph: wff) (C K c_le X Y: class):
  $ wi ph (wceq C (cfv K cprstc)) $ >
  $ wi ph (wcel K cproset) $ >
  $ wi ph (wceq c_le (cfv K cple)) $ >
  $ wi ph (wb (wbr X Y c_le) (wbr X Y (cfv C cple))) $;

--| Orthocomplementation is unchanged. (Contributed by Zhi Wang, 20-Sep-2024.) (Proof shortened by AV, 12-Nov-2024.)
theorem prstcocval (ph: wff) (C K c_pe: class):
  $ wi ph (wceq C (cfv K cprstc)) $ >
  $ wi ph (wcel K cproset) $ >
  $ wi ph (wceq c_pe (cfv K coc)) $ >
  $ wi ph (wceq c_pe (cfv C coc)) $;

--| Orthocomplementation is unchanged. (Contributed by Zhi Wang, 20-Sep-2024.)
theorem prstcoc (ph: wff) (C K c_pe X: class):
  $ wi ph (wceq C (cfv K cprstc)) $ >
  $ wi ph (wcel K cproset) $ >
  $ wi ph (wceq c_pe (cfv K coc)) $ >
  $ wi ph (wceq (cfv X c_pe) (cfv X (cfv C coc))) $;

--| Hom-sets of the constructed category which depend on an arbitrary definition. (Contributed by Zhi Wang, 20-Sep-2024.) (New usage is discouraged.)
theorem prstchomval (ph: wff) (C K c_le: class):
  $ wi ph (wceq C (cfv K cprstc)) $ >
  $ wi ph (wcel K cproset) $ >
  $ wi ph (wceq c_le (cfv C cple)) $ >
  $ wi ph (wceq (cxp c_le (csn c1o)) (cfv C chom)) $;

--| The category is a preordered set. (Contributed by Zhi Wang, 20-Sep-2024.)
theorem prstcprs (ph: wff) (C K: class):
  $ wi ph (wceq C (cfv K cprstc)) $ >
  $ wi ph (wcel K cproset) $ >
  $ wi ph (wcel C cproset) $;

--| The preordered set is equipped with a thin category. (Contributed by Zhi Wang, 20-Sep-2024.)
theorem prstcthin (ph: wff) (C K: class):
  $ wi ph (wceq C (cfv K cprstc)) $ >
  $ wi ph (wcel K cproset) $ >
  $ wi ph (wcel C cthinc) $;

--| Hom-sets of the constructed category are dependent on the preorder. Note that prstchom.x and prstchom.y are redundant here due to our definition of ` ProsetToCat ` . However, this should not be assumed as it is definition-dependent. Therefore, the two hypotheses are added for explicitness. (Contributed by Zhi Wang, 20-Sep-2024.)
theorem prstchom (ph: wff) (C H K c_le X Y: class):
  $ wi ph (wceq C (cfv K cprstc)) $ >
  $ wi ph (wcel K cproset) $ >
  $ wi ph (wceq c_le (cfv C cple)) $ >
  $ wi ph (wceq H (cfv C chom)) $ >
  $ wi ph (wcel X (cfv C cbs)) $ >
  $ wi ph (wcel Y (cfv C cbs)) $ >
  $ wi ph (wb (wbr X Y c_le) (wne (co X Y H) c0)) $;

--| Hom-sets of the constructed category are dependent on the preorder. Note that prstchom.x and prstchom.y are redundant here due to our definition of ` ProsetToCat ` ( see ~ prstchom2ALT ). However, this should not be assumed as it is definition-dependent. Therefore, the two hypotheses are added for explicitness. (Contributed by Zhi Wang, 21-Sep-2024.)
theorem prstchom2 {f2: setvar} (ph: wff) (C H: class) (K c_le: class f2) (X Y: class):
  $ wi ph (wceq C (cfv K cprstc)) $ >
  $ wi ph (wcel K cproset) $ >
  $ wi ph (wceq c_le (cfv C cple)) $ >
  $ wi ph (wceq H (cfv C chom)) $ >
  $ wi ph (wcel X (cfv C cbs)) $ >
  $ wi ph (wcel Y (cfv C cbs)) $ >
  $ wi ph (wb (wbr X Y c_le) (weu f2 (wcel (cv f2) (co X Y H)))) $;

--| Hom-sets of the constructed category are dependent on the preorder. This proof depends on the definition ~ df-prstc . See ~ prstchom2 for a version that does not depend on the definition. (Contributed by Zhi Wang, 20-Sep-2024.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem prstchom2ALT {f2: setvar} (ph: wff) (C H: class) (K c_le: class f2) (X Y: class):
  $ wi ph (wceq C (cfv K cprstc)) $ >
  $ wi ph (wcel K cproset) $ >
  $ wi ph (wceq c_le (cfv C cple)) $ >
  $ wi ph (wceq H (cfv C chom)) $ >
  $ wi ph (wb (wbr X Y c_le) (weu f2 (wcel (cv f2) (co X Y H)))) $;

--| The dual of a preordered set and the opposite category have the same set of objects. (Contributed by Zhi Wang, 22-Sep-2025.)
theorem oduoppcbas (ph: wff) (C D K O: class):
  $ wi ph (wceq C (cfv K cprstc)) $ >
  $ wi ph (wcel K cproset) $ >
  $ wi ph (wceq D (cfv (cfv K codu) cprstc)) $ >
  $ wceq O (cfv C coppc) $ >
  $ wi ph (wceq (cfv D cbs) (cfv O cbs)) $;

--| The dual of a preordered set and the opposite category are category-isomorphic. Example 3.6(1) of [Adamek] p. 25. (Contributed by Zhi Wang, 22-Sep-2025.)
theorem oduoppcciso (ph: wff) (C D U K O V: class):
  $ wi ph (wceq C (cfv K cprstc)) $ >
  $ wi ph (wcel K cproset) $ >
  $ wi ph (wceq D (cfv (cfv K codu) cprstc)) $ >
  $ wceq O (cfv C coppc) $ >
  $ wi ph (wcel U V) $ >
  $ wi ph (wcel D U) $ >
  $ wi ph (wcel O U) $ >
  $ wi ph (wbr D O (cfv (cfv U ccatc) ccic)) $;

--| The converted category is a poset iff the original proset is a poset. (Contributed by Zhi Wang, 26-Sep-2024.)
theorem postcpos (ph: wff) (C K: class):
  $ wi ph (wceq C (cfv K cprstc)) $ >
  $ wi ph (wcel K cproset) $ >
  $ wi ph (wb (wcel K cpo) (wcel C cpo)) $;

--| Alternate proof of ~ postcpos . (Contributed by Zhi Wang, 25-Sep-2024.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem postcposALT (ph: wff) (C K: class):
  $ wi ph (wceq C (cfv K cprstc)) $ >
  $ wi ph (wcel K cproset) $ >
  $ wi ph (wb (wcel K cpo) (wcel C cpo)) $;

--| The converted category is a poset iff no distinct objects are isomorphic. (Contributed by Zhi Wang, 25-Sep-2024.)
theorem postc {x3 y1: setvar} (ph: wff) (B2 C: class) (K: class x3 y1):
  $ wi ph (wceq C (cfv K cprstc)) $ >
  $ wi ph (wcel K cproset) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wi ph (wb (wcel C cpo) (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) (cfv C ccic)) (wceq (cv x3) (cv y1))) B2) B2)) $;

--| A singlegon is an element of the class of singlegons. The converse ( ~ basrestermcfolem ) also holds. This is trivial if ` B ` is ` b ` ( ~ abid ). (Contributed by Zhi Wang, 20-Oct-2025.)
theorem discsntermlem {x3 b: setvar} (B2: class):
  $ wi (wex x3 (wceq B2 (csn (cv x3)))) (wcel B2 (cab b (wex x3 (wceq (cv b) (csn (cv x3)))))) $;

--| An element of the class of singlegons is a singlegon. The converse ( ~ discsntermlem ) also holds. This is trivial if ` B ` is ` b ` ( ~ abid ). (Contributed by Zhi Wang, 20-Oct-2025.)
theorem basrestermcfolem {x3 b: setvar} (B2: class):
  $ wi (wcel B2 (cab b (wex x3 (wceq (cv b) (csn (cv x3)))))) (wex x3 (wceq B2 (csn (cv x3)))) $;

--| A discrete category (a category whose only morphisms are the identity morphisms) can be constructed for any base set. (Contributed by Zhi Wang, 20-Oct-2025.)
theorem discbas (B2 C K V: class):
  $ wceq K (cpr (cop (cfv cnx cbs) B2) (cop (cfv cnx cple) (cres cid B2))) $ >
  $ wceq C (cfv K cprstc) $ >
  $ wi (wcel B2 V) (wceq B2 (cfv C cbs)) $;

--| A discrete category (a category whose only morphisms are the identity morphisms) is thin. (Contributed by Zhi Wang, 20-Oct-2025.)
theorem discthin (B2 C K V: class):
  $ wceq K (cpr (cop (cfv cnx cbs) B2) (cop (cfv cnx cple) (cres cid B2))) $ >
  $ wceq C (cfv K cprstc) $ >
  $ wi (wcel B2 V) (wcel C cthinc) $;

--| A discrete category (a category whose only morphisms are the identity morphisms) with a singlegon base is terminal. Corollary of example 3.3(4)(c) of [Adamek] p. 24 and example 3.26(1) of [Adamek] p. 33. (Contributed by Zhi Wang, 20-Oct-2025.)
theorem discsnterm {x3: setvar} (B2 C: class) (K: class x3):
  $ wceq K (cpr (cop (cfv cnx cbs) B2) (cop (cfv cnx cple) (cres cid B2))) $ >
  $ wceq C (cfv K cprstc) $ >
  $ wi (wex x3 (wceq B2 (csn (cv x3)))) (wcel C ctermc) $;

--| The base function restricted to the class of terminal categories maps the class of terminal categories onto the class of singletons. (Contributed by Zhi Wang, 20-Oct-2025.)
theorem basrestermcfo {x3 b: setvar}:
  $ wfo ctermc (cab b (wex x3 (wceq (cv b) (csn (cv x3))))) (cres cbs ctermc) $;

--| The class of all terminal categories is a proper class. Therefore both the class of all thin categories and the class of all categories are proper classes. Note that ~ snnex is equivalent to ` sngl _V e/ _V ` . (Contributed by Zhi Wang, 20-Oct-2025.)
theorem termcnex:
  $ wnel ctermc cvv $;

--| Class function defining monoids as categories.
term cmndtc: class;

--| Definition of the function converting a monoid to a category. Example 3.3(4.e) of [Adamek] p. 24. The definition of the base set is arbitrary. The whole extensible structure becomes the object here (see ~ mndtcbasval ), instead of just the base set, as is the case in Example 3.3(4.e) of [Adamek] p. 24. The resulting category is defined entirely, up to isomorphism, by ~ mndtcbaseu , ~ mndtchom , ~ mndtcco . Use those instead. See example 3.26(3) of [Adamek] p. 33 for more on isomorphism. "MndToCat" was taken instead of "MndCat" because the latter might mean the category of monoids. (Contributed by Zhi Wang, 22-Sep-2024.) (New usage is discouraged.)
axiom df_mndtc {m: setvar}:
  $ wceq cmndtc (cmpt m cmnd (ctp (cop (cfv cnx cbs) (csn (cv m))) (cop (cfv cnx chom) (csn (cotp (cv m) (cv m) (cfv (cv m) cbs)))) (cop (cfv cnx cco) (csn (cop (cotp (cv m) (cv m) (cv m)) (cfv (cv m) cplusg)))))) $;

--| Value of the category built from a monoid. (Contributed by Zhi Wang, 22-Sep-2024.) (New usage is discouraged.)
theorem mndtcval (ph: wff) (C M: class):
  $ wi ph (wceq C (cfv M cmndtc)) $ >
  $ wi ph (wcel M cmnd) $ >
  $ wi ph (wceq C (ctp (cop (cfv cnx cbs) (csn M)) (cop (cfv cnx chom) (csn (cotp M M (cfv M cbs)))) (cop (cfv cnx cco) (csn (cop (cotp M M M) (cfv M cplusg)))))) $;

--| The base set of the category built from a monoid. (Contributed by Zhi Wang, 22-Sep-2024.) (New usage is discouraged.)
theorem mndtcbasval (ph: wff) (B2 C M: class):
  $ wi ph (wceq C (cfv M cmndtc)) $ >
  $ wi ph (wcel M cmnd) $ >
  $ wi ph (wceq B2 (cfv C cbs)) $ >
  $ wi ph (wceq B2 (csn M)) $;

--| The category built from a monoid contains precisely one object. (Contributed by Zhi Wang, 22-Sep-2024.)
theorem mndtcbaseu {x3: setvar} (ph: wff x3) (B2: class) (C: class x3) (M: class):
  $ wi ph (wceq C (cfv M cmndtc)) $ >
  $ wi ph (wcel M cmnd) $ >
  $ wi ph (wceq B2 (cfv C cbs)) $ >
  $ wi ph (weu x3 (wcel (cv x3) B2)) $;

--| Lemma for ~ mndtchom and ~ mndtcco . (Contributed by Zhi Wang, 22-Sep-2024.) (New usage is discouraged.)
theorem mndtcob (ph: wff) (B2 C M X: class):
  $ wi ph (wceq C (cfv M cmndtc)) $ >
  $ wi ph (wcel M cmnd) $ >
  $ wi ph (wceq B2 (cfv C cbs)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq X M) $;

--| Two objects in a category built from a monoid are identical. (Contributed by Zhi Wang, 24-Sep-2024.)
theorem mndtcobeq (ph: wff) (B2 C M X Y: class):
  $ wi ph (wceq C (cfv M cmndtc)) $ >
  $ wi ph (wcel M cmnd) $ >
  $ wi ph (wceq B2 (cfv C cbs)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq X Y) $;

--| The only hom-set of the category built from a monoid is the base set of the monoid. (Contributed by Zhi Wang, 22-Sep-2024.) (Proof shortened by Zhi Wang, 22-Oct-2025.)
theorem mndtchom (ph: wff) (B2 C H M X Y: class):
  $ wi ph (wceq C (cfv M cmndtc)) $ >
  $ wi ph (wcel M cmnd) $ >
  $ wi ph (wceq B2 (cfv C cbs)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq H (cfv C chom)) $ >
  $ wi ph (wceq (co X Y H) (cfv M cbs)) $;

--| The composition of the category built from a monoid is the monoid operation. (Contributed by Zhi Wang, 22-Sep-2024.)
theorem mndtcco (ph: wff) (B2 C c_x M X Y Z: class):
  $ wi ph (wceq C (cfv M cmndtc)) $ >
  $ wi ph (wcel M cmnd) $ >
  $ wi ph (wceq B2 (cfv C cbs)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wceq c_x (cfv C cco)) $ >
  $ wi ph (wceq (co (cop X Y) Z c_x) (cfv M cplusg)) $;

--| The composition of the category built from a monoid is the monoid operation. (Contributed by Zhi Wang, 22-Sep-2024.)
theorem mndtcco2 (ph: wff) (B2 C c_x F G M X Y c_op Z: class):
  $ wi ph (wceq C (cfv M cmndtc)) $ >
  $ wi ph (wcel M cmnd) $ >
  $ wi ph (wceq B2 (cfv C cbs)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wceq c_x (cfv C cco)) $ >
  $ wi ph (wceq c_op (co (cop X Y) Z c_x)) $ >
  $ wi ph (wceq (co G F c_op) (co G F (cfv M cplusg))) $;

--| Lemma for ~ mndtccat and ~ mndtcid . (Contributed by Zhi Wang, 22-Sep-2024.)
theorem mndtccatid {y1: setvar} (ph: wff) (C: class) (M: class y1):
  $ wi ph (wceq C (cfv M cmndtc)) $ >
  $ wi ph (wcel M cmnd) $ >
  $ wi ph (wa (wcel C ccat) (wceq (cfv C ccid) (cmpt y1 (cfv C cbs) (cfv M c0g)))) $;

--| The function value is a category. (Contributed by Zhi Wang, 22-Sep-2024.)
theorem mndtccat (ph: wff) (C M: class):
  $ wi ph (wceq C (cfv M cmndtc)) $ >
  $ wi ph (wcel M cmnd) $ >
  $ wi ph (wcel C ccat) $;

--| The identity morphism, or identity arrow, of the category built from a monoid is the identity element of the monoid. (Contributed by Zhi Wang, 22-Sep-2024.)
theorem mndtcid (ph: wff) (B2 C c_1 M X: class):
  $ wi ph (wceq C (cfv M cmndtc)) $ >
  $ wi ph (wcel M cmnd) $ >
  $ wi ph (wceq B2 (cfv C cbs)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq c_1 (cfv C ccid)) $ >
  $ wi ph (wceq (cfv X c_1) (cfv M c0g)) $;

--| The converted opposite monoid has the same hom-set as that of the opposite category. Example 3.6(2) of [Adamek] p. 25. (Contributed by Zhi Wang, 21-Sep-2025.)
theorem oppgoppchom (ph: wff) (C D H J M O X Y: class):
  $ wi ph (wceq C (cfv M cmndtc)) $ >
  $ wi ph (wcel M cmnd) $ >
  $ wi ph (wceq D (cfv (cfv M coppg) cmndtc)) $ >
  $ wceq O (cfv C coppc) $ >
  $ wi ph (wcel X (cfv D cbs)) $ >
  $ wi ph (wcel Y (cfv O cbs)) $ >
  $ wi ph (wceq H (cfv D chom)) $ >
  $ wi ph (wceq J (cfv O chom)) $ >
  $ wi ph (wceq (co X X H) (co Y Y J)) $;

--| The converted opposite monoid has the same composition as that of the opposite category. Example 3.6(2) of [Adamek] p. 25. (Contributed by Zhi Wang, 22-Sep-2025.)
theorem oppgoppcco (ph: wff) (C D c_xb c_x M O X Y: class):
  $ wi ph (wceq C (cfv M cmndtc)) $ >
  $ wi ph (wcel M cmnd) $ >
  $ wi ph (wceq D (cfv (cfv M coppg) cmndtc)) $ >
  $ wceq O (cfv C coppc) $ >
  $ wi ph (wcel X (cfv D cbs)) $ >
  $ wi ph (wcel Y (cfv O cbs)) $ >
  $ wi ph (wceq c_x (cfv D cco)) $ >
  $ wi ph (wceq c_xb (cfv O cco)) $ >
  $ wi ph (wceq (co (cop X X) X c_x) (co (cop Y Y) Y c_xb)) $;

--| The converted opposite monoid has the same identity morphism as that of the opposite category. Example 3.6(2) of [Adamek] p. 25. (Contributed by Zhi Wang, 22-Sep-2025.)
theorem oppgoppcid (ph: wff) (C D M O X Y: class):
  $ wi ph (wceq C (cfv M cmndtc)) $ >
  $ wi ph (wcel M cmnd) $ >
  $ wi ph (wceq D (cfv (cfv M coppg) cmndtc)) $ >
  $ wceq O (cfv C coppc) $ >
  $ wi ph (wcel X (cfv D cbs)) $ >
  $ wi ph (wcel Y (cfv O cbs)) $ >
  $ wi ph (wceq (cfv X (cfv D ccid)) (cfv Y (cfv O ccid))) $;

--| All morphisms in a category converted from a group are monomorphisms. (Contributed by Zhi Wang, 23-Sep-2024.)
theorem grptcmon (ph: wff) (B2 C G H M X Y: class):
  $ wi ph (wceq C (cfv G cmndtc)) $ >
  $ wi ph (wcel G cgrp) $ >
  $ wi ph (wceq B2 (cfv C cbs)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq H (cfv C chom)) $ >
  $ wi ph (wceq M (cfv C cmon)) $ >
  $ wi ph (wceq (co X Y M) (co X Y H)) $;

--| All morphisms in a category converted from a group are epimorphisms. (Contributed by Zhi Wang, 23-Sep-2024.)
theorem grptcepi (ph: wff) (B2 C E G H X Y: class):
  $ wi ph (wceq C (cfv G cmndtc)) $ >
  $ wi ph (wcel G cgrp) $ >
  $ wi ph (wceq B2 (cfv C cbs)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq H (cfv C chom)) $ >
  $ wi ph (wceq E (cfv C cepi)) $ >
  $ wi ph (wceq (co X Y E) (co X Y H)) $;

--| Lemma for ~ 2arwcat . (Contributed by Zhi Wang, 5-Nov-2025.)
theorem _2arwcatlem1 {x3 y1 z w f2 g2 k: setvar} (c_1 H X c_0: class x3 y1 z w f2 g2 k):
  $ wceq (co X X H) (cpr c_0 c_1) $ >
  $ wb (wa (wa (wa (wceq (cv x3) X) (wceq (cv y1) X)) (wa (wceq (cv z) X) (wceq (cv w) X))) (w3a (wo (wceq (cv f2) c_0) (wceq (cv f2) c_1)) (wo (wceq (cv g2) c_0) (wceq (cv g2) c_1)) (wo (wceq (cv k) c_0) (wceq (cv k) c_1)))) (w3a (wa (wcel (cv x3) (csn X)) (wcel (cv y1) (csn X))) (wa (wcel (cv z) (csn X)) (wcel (cv w) (csn X))) (w3a (wcel (cv f2) (co (cv x3) (cv y1) H)) (wcel (cv g2) (co (cv y1) (cv z) H)) (wcel (cv k) (co (cv z) (cv w) H)))) $;

--| Lemma for ~ 2arwcat . (Contributed by Zhi Wang, 5-Nov-2025.)
theorem _2arwcatlem2 (ph: wff) (A2 B2 C c_x c_1 F X Y c_0 Z: class):
  $ wi ph (wceq A2 X) $ >
  $ wi ph (wceq B2 Y) $ >
  $ wi ph (wceq C Z) $ >
  $ wi ph (wo (wceq F c_0) (wceq F c_1)) $ >
  $ wi ph (wceq (co c_1 c_1 (co (cop X Y) Z c_x)) c_1) $ >
  $ wi ph (wceq (co c_1 c_0 (co (cop X Y) Z c_x)) c_0) $ >
  $ wi ph (wceq (co c_1 F (co (cop A2 B2) C c_x)) F) $;

--| Lemma for ~ 2arwcat . (Contributed by Zhi Wang, 5-Nov-2025.)
theorem _2arwcatlem3 (ph: wff) (A2 B2 C c_x c_1 F X Y c_0 Z: class):
  $ wi ph (wceq A2 X) $ >
  $ wi ph (wceq B2 Y) $ >
  $ wi ph (wceq C Z) $ >
  $ wi ph (wo (wceq F c_0) (wceq F c_1)) $ >
  $ wi ph (wceq (co c_1 c_1 (co (cop X Y) Z c_x)) c_1) $ >
  $ wi ph (wceq (co c_0 c_1 (co (cop X Y) Z c_x)) c_0) $ >
  $ wi ph (wceq (co F c_1 (co (cop A2 B2) C c_x)) F) $;

--| Lemma for ~ 2arwcat . (Contributed by Zhi Wang, 5-Nov-2025.)
theorem _2arwcatlem4 (ph: wff) (A2 B2 C c_x c_1 F G X Y c_0 Z: class):
  $ wi ph (wceq A2 X) $ >
  $ wi ph (wceq B2 Y) $ >
  $ wi ph (wceq C Z) $ >
  $ wi ph (wo (wceq F c_0) (wceq F c_1)) $ >
  $ wi ph (wceq (co c_1 c_1 (co (cop X Y) Z c_x)) c_1) $ >
  $ wi ph (wceq (co c_0 c_1 (co (cop X Y) Z c_x)) c_0) $ >
  $ wi ph (wceq (co c_1 c_0 (co (cop X Y) Z c_x)) c_0) $ >
  $ wi ph (wcel (co c_0 c_0 (co (cop X Y) Z c_x)) (cpr c_0 c_1)) $ >
  $ wi ph (wo (wceq G c_0) (wceq G c_1)) $ >
  $ wi ph (wcel (co G F (co (cop A2 B2) C c_x)) (cpr c_0 c_1)) $;

--| Lemma for ~ 2arwcat . (Contributed by Zhi Wang, 5-Nov-2025.)
theorem _2arwcatlem5 (ph: wff) (c_x c_1 c_0: class):
  $ wi ph (wceq (co c_1 c_0 c_x) c_0) $ >
  $ wi ph (wceq (co c_0 c_1 c_x) c_0) $ >
  $ wi ph (wcel (co c_0 c_0 c_x) (cpr c_0 c_1)) $ >
  $ wi ph (wceq (co (co c_0 c_0 c_x) c_0 c_x) (co c_0 (co c_0 c_0 c_x) c_x)) $;

--| The condition for a structure with at most one object and at most two morphisms being a category. "2arwcat.2" to "2arwcat.5" are also necessary conditions if ` X ` , ` .0. ` , and ` .1. ` are all sets, due to ~ catlid , ~ catrid , and ~ catcocl . (Contributed by Zhi Wang, 5-Nov-2025.)
theorem _2arwcat {y1: setvar} (ph: wff) (C c_x: class) (c_1: class y1) (H X: class) (c_0: class y1):
  $ wi ph (wceq (csn X) (cfv C cbs)) $ >
  $ wi ph (wceq H (cfv C chom)) $ >
  $ wi ph (wceq c_x (cfv C cco)) $ >
  $ wceq (co X X H) (cpr c_0 c_1) $ >
  $ wi ph (wceq (co c_1 c_1 (co (cop X X) X c_x)) c_1) $ >
  $ wi ph (wceq (co c_1 c_0 (co (cop X X) X c_x)) c_0) $ >
  $ wi ph (wceq (co c_0 c_1 (co (cop X X) X c_x)) c_0) $ >
  $ wi ph (wcel (co c_0 c_0 (co (cop X X) X c_x)) (cpr c_0 c_1)) $ >
  $ wi ph (wa (wcel C ccat) (wceq (cfv C ccid) (cmpt y1 (csn X) c_1))) $;

--| Constructing a category with at most one object and at most two morphisms. If ` X ` is a set then ` C ` is the category ` A ` in Exercise 3G of [Adamek] p. 45. (Contributed by Zhi Wang, 5-Nov-2025.)
theorem incat {y1 f2 g2: setvar} (C c_x: class f2 g2) (F G H V: class) (X: class f2 g2):
  $ wceq C (ctp (cop (cfv cnx cbs) (csn X)) (cop (cfv cnx chom) (csn (cotp X X H))) (cop (cfv cnx cco) (csn (cotp (cop X X) X c_x)))) $ >
  $ wceq H (cpr F G) $ >
  $ wceq c_x (cmpo f2 g2 H H (cin (cv f2) (cv g2))) $ >
  $ wi (wa (wss F G) (wcel G V)) (wa (wcel C ccat) (wceq (cfv C ccid) (cmpt y1 (csn X) G))) $;

--| Construct a category with one object and two morphisms and prove that category ` ( SetCat `` 1o ) ` satisfies all conditions for a subcategory but the compatibility of identity morphisms, showing the necessity of the latter condition in defining a subcategory. Exercise 4A of [Adamek] p. 58. (Contributed by Zhi Wang, 6-Nov-2025.)
theorem setc1onsubc {x3 f2 g2: setvar} (C D S c_x c_1 E H J: class x3 f2 g2):
  $ wceq C (ctp (cop (cfv cnx cbs) (csn c0)) (cop (cfv cnx chom) (csn (cotp c0 c0 c2o))) (cop (cfv cnx cco) (csn (cotp (cop c0 c0) c0 c_x)))) $ >
  $ wceq c_x (cmpo f2 g2 c2o c2o (cin (cv f2) (cv g2))) $ >
  $ wceq E (cfv c1o csetc) $ >
  $ wceq J (cfv E chomf) $ >
  $ wceq S c1o $ >
  $ wceq H (cfv C chomf) $ >
  $ wceq c_1 (cfv C ccid) $ >
  $ wceq D (co C J cresc) $ >
  $ w3a (wcel C ccat) (wfn J (cxp S S)) (w3a (wbr J H cssc) (wn (wral x3 (wcel (cfv (cv x3) c_1) (co (cv x3) (cv x3) J)) S)) (wcel D ccat)) $;

--| A weaker version of ~ cnelsubc , which requires fewer axioms. (Contributed by Zhi Wang, 6-Nov-2025.)
theorem cnelsubcw {x3 j s1 c: setvar} (C: class) (S: class j c) (J: class c):
  $ wcel J cvv $ >
  $ wcel S cvv $ >
  $ w3a (wcel C ccat) (wfn J (cxp S S)) (w3a (wbr J (cfv C chomf) cssc) (wn (wral x3 (wcel (cfv (cv x3) (cfv C ccid)) (co (cv x3) (cv x3) J)) S)) (wcel (co C J cresc) ccat)) $ >
  $ wrex c (wex j (wex s1 (wa (wfn (cv j) (cxp (cv s1) (cv s1))) (w3a (wbr (cv j) (cfv (cv c) chomf) cssc) (wn (wral x3 (wcel (cfv (cv x3) (cfv (cv c) ccid)) (co (cv x3) (cv x3) (cv j))) (cv s1))) (wcel (co (cv c) (cv j) cresc) ccat))))) ccat $;

--| Remark 4.2(2) of [Adamek] p. 48. There exists a _category_ satisfying all conditions for a subcategory but the compatibility of identity morphisms. Therefore such condition in ~ df-subc is necessary. A stronger statement than ~ nelsubc3 . (Contributed by Zhi Wang, 6-Nov-2025.)
theorem cnelsubc {x3 j s1 c: setvar}:
  $ wrex c (wex j (wex s1 (wa (wfn (cv j) (cxp (cv s1) (cv s1))) (w3a (wbr (cv j) (cfv (cv c) chomf) cssc) (wn (wral x3 (wcel (cfv (cv x3) (cfv (cv c) ccid)) (co (cv x3) (cv x3) (cv j))) (cv s1))) (wcel (co (cv c) (cv j) cresc) ccat))))) ccat $;

--| At objects in the base, the hom operation has value ` { J } ` on the diagonal, ` S ` from the distinguished source to target, and the empty set otherwise. (Contributed by Zhi Wang, 14-Sep-2026.)
theorem parhomval {x3 y1: setvar} (B2 S U: class) (H: class x3 y1) (J V X Y: class):
  $ wceq H (cmpo x3 y1 B2 B2 (cif (wceq (cv x3) (cv y1)) (csn J) (cif (wa (wceq (cv x3) X) (wceq (cv y1) Y)) S c0))) $ >
  $ wcel S cvv $ >
  $ wi (wa (wcel U B2) (wcel V B2)) (wceq (co U V H) (cif (wceq U V) (csn J) (cif (wa (wceq U X) (wceq V Y)) S c0))) $;

--| Membership in a hom-set of a parallel-arrow category is equivalent to being its identity value on the diagonal, or a member of ` S ` at the distinguished source and target. (Contributed by Zhi Wang, 14-Sep-2026.)
theorem parhomel {x3 y1: setvar} (B2 S U: class) (F H: class x3 y1) (J V X Y: class):
  $ wceq H (cmpo x3 y1 B2 B2 (cif (wceq (cv x3) (cv y1)) (csn J) (cif (wa (wceq (cv x3) X) (wceq (cv y1) Y)) S c0))) $ >
  $ wcel S cvv $ >
  $ wcel J cvv $ >
  $ wi (wa (wcel U B2) (wcel V B2)) (wb (wcel F (co U V H)) (wo (wa (wceq U V) (wceq F J)) (wa (wn (wceq U V)) (wa (wa (wceq U X) (wceq V Y)) (wcel F S))))) $;

--| Variant of ~ parhomcl . (Contributed by Zhi Wang, 14-Sep-2026.) (Revised by Zhi Wang, 17-Sep-2026.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem parhomcl2 {x3 y1: setvar} (ph: wff x3 y1) (B2 S U: class) (F H: class x3 y1) (J: class) (K: class x3 y1) (V X Y: class):
  $ wceq H (cmpo x3 y1 B2 B2 (cif (wceq (cv x3) (cv y1)) (csn J) (cif (wa (wceq (cv x3) X) (wceq (cv y1) Y)) S c0))) $ >
  $ wcel S cvv $ >
  $ wcel J cvv $ >
  $ wceq K (cun S (csn J)) $ >
  $ wi ph (wcel U B2) $ >
  $ wi ph (wcel V B2) $ >
  $ wi ph (wcel F (co U V H)) $ >
  $ wi ph (wcel F K) $;

--| On the diagonal, the parallel-arrow hom operation has value ` { J } ` . (Contributed by Zhi Wang, 16-Sep-2026.)
theorem parhomidval {x3 y1: setvar} (B2 S U: class) (H: class x3 y1) (J X Y: class):
  $ wceq H (cmpo x3 y1 B2 B2 (cif (wceq (cv x3) (cv y1)) (csn J) (cif (wa (wceq (cv x3) X) (wceq (cv y1) Y)) S c0))) $ >
  $ wi (wcel U B2) (wceq (co U U H) (csn J)) $;

--| Every value of the parallel-arrow hom operation is a subclass of the arrow carrier. (Contributed by Zhi Wang, 16-Sep-2026.)
theorem parhomssun {x3 y1: setvar} (B2 S U: class) (H: class x3 y1) (J: class) (K: class x3 y1) (V X Y: class):
  $ wceq H (cmpo x3 y1 B2 B2 (cif (wceq (cv x3) (cv y1)) (csn J) (cif (wa (wceq (cv x3) X) (wceq (cv y1) Y)) S c0))) $ >
  $ wceq K (cun S (csn J)) $ >
  $ wss (co U V H) K $;

--| All hom-sets of the parallel-arrow construction lie in its arrow carrier. (Contributed by Zhi Wang, 14-Sep-2026.) (Revised by Zhi Wang, 16-Sep-2026.)
theorem parhomcl {x3 y1: setvar} (ph: wff x3 y1) (B2 S U: class) (F H: class x3 y1) (J: class) (K: class x3 y1) (V X Y: class):
  $ wceq H (cmpo x3 y1 B2 B2 (cif (wceq (cv x3) (cv y1)) (csn J) (cif (wa (wceq (cv x3) X) (wceq (cv y1) Y)) S c0))) $ >
  $ wceq K (cun S (csn J)) $ >
  $ wi ph (wcel F (co U V H)) $ >
  $ wi ph (wcel F K) $;

--| Variant of ~ parhomideq . (Contributed by Zhi Wang, 14-Sep-2026.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem parhomideq2 {x3 y1: setvar} (ph: wff x3 y1) (B2 S U: class) (F H: class x3 y1) (J V X Y: class):
  $ wceq H (cmpo x3 y1 B2 B2 (cif (wceq (cv x3) (cv y1)) (csn J) (cif (wa (wceq (cv x3) X) (wceq (cv y1) Y)) S c0))) $ >
  $ wi ph (wcel F (co U V H)) $ >
  $ wi ph (wceq U V) $ >
  $ wcel S cvv $ >
  $ wcel J cvv $ >
  $ wi ph (wcel U B2) $ >
  $ wi ph (wcel V B2) $ >
  $ wi ph (wceq F J) $;

--| An endomorphism in the parallel-arrow construction has the identity value. (Contributed by Zhi Wang, 14-Sep-2026.) (Revised by Zhi Wang, 16-Sep-2026.)
theorem parhomideq {x3 y1: setvar} (ph: wff x3 y1) (B2 S U: class) (F H: class x3 y1) (J V X Y: class):
  $ wceq H (cmpo x3 y1 B2 B2 (cif (wceq (cv x3) (cv y1)) (csn J) (cif (wa (wceq (cv x3) X) (wceq (cv y1) Y)) S c0))) $ >
  $ wi ph (wcel F (co U V H)) $ >
  $ wi ph (wceq U V) $ >
  $ wi ph (wceq F J) $;

--| Variant of ~ parhomid . (Contributed by Zhi Wang, 14-Sep-2026.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem parhomid2 {x3 y1: setvar} (ph: wff x3 y1) (B2 S U: class) (H: class x3 y1) (J X Y: class):
  $ wceq H (cmpo x3 y1 B2 B2 (cif (wceq (cv x3) (cv y1)) (csn J) (cif (wa (wceq (cv x3) X) (wceq (cv y1) Y)) S c0))) $ >
  $ wcel J cvv $ >
  $ wi ph (wcel U B2) $ >
  $ wcel S cvv $ >
  $ wi ph (wcel J (co U U H)) $;

--| The identity value belongs to each endomorphism hom-set. (Contributed by Zhi Wang, 14-Sep-2026.) (Revised by Zhi Wang, 16-Sep-2026.)
theorem parhomid {x3 y1: setvar} (ph: wff x3 y1) (B2 S U: class) (H: class x3 y1) (J X Y: class):
  $ wceq H (cmpo x3 y1 B2 B2 (cif (wceq (cv x3) (cv y1)) (csn J) (cif (wa (wceq (cv x3) X) (wceq (cv y1) Y)) S c0))) $ >
  $ wcel J cvv $ >
  $ wi ph (wcel U B2) $ >
  $ wi ph (wcel J (co U U H)) $;

--| Evaluate an inhabited parallel-arrow hom-set. Membership certifies the selected branch even when sethood hypotheses are unavailable. Compare ~ parhomval for evaluation throughout the object domain. (Contributed by Zhi Wang, 17-Sep-2026.)
theorem parhomvaln0 {x3 y1: setvar} (B2 S U: class) (F H: class x3 y1) (J V X Y: class):
  $ wceq H (cmpo x3 y1 B2 B2 (cif (wceq (cv x3) (cv y1)) (csn J) (cif (wa (wceq (cv x3) X) (wceq (cv y1) Y)) S c0))) $ >
  $ wi (wcel F (co U V H)) (wceq (co U V H) (cif (wceq U V) (csn J) (cif (wa (wceq U X) (wceq V Y)) S c0))) $;

--| Variant of ~ parhomne . (Contributed by Zhi Wang, 14-Sep-2026.) (Revised by Zhi Wang, 17-Sep-2026.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem parhomne2 {x3 y1: setvar} (ph: wff x3 y1) (B2 S U: class) (F H: class x3 y1) (J V X Y: class):
  $ wceq H (cmpo x3 y1 B2 B2 (cif (wceq (cv x3) (cv y1)) (csn J) (cif (wa (wceq (cv x3) X) (wceq (cv y1) Y)) S c0))) $ >
  $ wi ph (wcel F (co U V H)) $ >
  $ wi ph (wn (wceq U V)) $ >
  $ wcel S cvv $ >
  $ wcel J cvv $ >
  $ wi ph (wcel U B2) $ >
  $ wi ph (wcel V B2) $ >
  $ wi ph (wa (wceq U X) (wceq V Y)) $;

--| A morphism between different objects has the distinguished source and target. (Contributed by Zhi Wang, 14-Sep-2026.) (Revised by Zhi Wang, 17-Sep-2026.)
theorem parhomne {x3 y1: setvar} (ph: wff x3 y1) (B2 S U: class) (F H: class x3 y1) (J V X Y: class):
  $ wceq H (cmpo x3 y1 B2 B2 (cif (wceq (cv x3) (cv y1)) (csn J) (cif (wa (wceq (cv x3) X) (wceq (cv y1) Y)) S c0))) $ >
  $ wi ph (wcel F (co U V H)) $ >
  $ wi ph (wn (wceq U V)) $ >
  $ wi ph (wa (wceq U X) (wceq V Y)) $;

--| Variant of ~ parhomss . (Contributed by Zhi Wang, 14-Sep-2026.) (Revised by Zhi Wang, 17-Sep-2026.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem parhomss2 {x3 y1: setvar} (ph: wff x3 y1) (B2 S U: class) (F H: class x3 y1) (J V X Y: class):
  $ wceq H (cmpo x3 y1 B2 B2 (cif (wceq (cv x3) (cv y1)) (csn J) (cif (wa (wceq (cv x3) X) (wceq (cv y1) Y)) S c0))) $ >
  $ wss S (cpw J) $ >
  $ wi ph (wcel F (co U V H)) $ >
  $ wcel S cvv $ >
  $ wcel J cvv $ >
  $ wi ph (wcel U B2) $ >
  $ wi ph (wcel V B2) $ >
  $ wi ph (wss F J) $;

--| When every member of the parallel-arrow class ` S ` is a subset of ` J ` , every arrow in a hom-set is a subset of its identity value ` J ` . The subset hypothesis is essential; it does not follow from the hom-set definition alone. (Contributed by Zhi Wang, 14-Sep-2026.) (Revised by Zhi Wang, 17-Sep-2026.)
theorem parhomss {x3 y1: setvar} (ph: wff x3 y1) (B2 S U: class) (F H: class x3 y1) (J V X Y: class):
  $ wceq H (cmpo x3 y1 B2 B2 (cif (wceq (cv x3) (cv y1)) (csn J) (cif (wa (wceq (cv x3) X) (wceq (cv y1) Y)) S c0))) $ >
  $ wss S (cpw J) $ >
  $ wi ph (wcel F (co U V H)) $ >
  $ wi ph (wss F J) $;

--| Variant of ~ parhomeqor . (Contributed by Zhi Wang, 14-Sep-2026.) (Revised by Zhi Wang, 17-Sep-2026.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem parhomeqor2 {x3 y1: setvar} (ph: wff x3 y1) (B2 S U: class) (F G H: class x3 y1) (J V W X Y: class):
  $ wceq H (cmpo x3 y1 B2 B2 (cif (wceq (cv x3) (cv y1)) (csn J) (cif (wa (wceq (cv x3) X) (wceq (cv y1) Y)) S c0))) $ >
  $ wi ph (wcel F (co U V H)) $ >
  $ wi ph (wcel G (co V W H)) $ >
  $ wcel S cvv $ >
  $ wcel J cvv $ >
  $ wne X Y $ >
  $ wi ph (wcel U B2) $ >
  $ wi ph (wcel V B2) $ >
  $ wi ph (wcel W B2) $ >
  $ wi ph (wo (wceq U V) (wceq V W)) $;

--| In a composable pair, at least one arrow is an endomorphism. (Contributed by Zhi Wang, 14-Sep-2026.) (Revised by Zhi Wang, 17-Sep-2026.)
theorem parhomeqor {x3 y1: setvar} (ph: wff x3 y1) (B2 S U: class) (F G H: class x3 y1) (J V W X Y: class):
  $ wceq H (cmpo x3 y1 B2 B2 (cif (wceq (cv x3) (cv y1)) (csn J) (cif (wa (wceq (cv x3) X) (wceq (cv y1) Y)) S c0))) $ >
  $ wi ph (wcel F (co U V H)) $ >
  $ wi ph (wcel G (co V W H)) $ >
  $ wi ph (wo (wceq U V) (wceq V W)) $;

--| Variant of ~ parhomco . (Contributed by Zhi Wang, 14-Sep-2026.) (Revised by Zhi Wang, 17-Sep-2026.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem parhomco2 {x3 y1: setvar} (ph: wff x3 y1) (B2 S U: class) (F G H: class x3 y1) (J V W X Y: class):
  $ wceq H (cmpo x3 y1 B2 B2 (cif (wceq (cv x3) (cv y1)) (csn J) (cif (wa (wceq (cv x3) X) (wceq (cv y1) Y)) S c0))) $ >
  $ wi ph (wcel F (co U V H)) $ >
  $ wi ph (wcel G (co V W H)) $ >
  $ wss S (cpw J) $ >
  $ wcel S cvv $ >
  $ wcel J cvv $ >
  $ wne X Y $ >
  $ wi ph (wcel U B2) $ >
  $ wi ph (wcel V B2) $ >
  $ wi ph (wcel W B2) $ >
  $ wi ph (wcel (cin G F) (co U W H)) $;

--| When every member of the parallel-arrow class ` S ` is a subset of ` J ` , intersection of composable arrows belongs to the hom-set from the first object to the last. The subset hypothesis supplies the required intersection identity laws; it does not follow from the hom construction alone. (Contributed by Zhi Wang, 14-Sep-2026.) (Revised by Zhi Wang, 17-Sep-2026.)
theorem parhomco {x3 y1: setvar} (ph: wff x3 y1) (B2 S U: class) (F G H: class x3 y1) (J V W X Y: class):
  $ wceq H (cmpo x3 y1 B2 B2 (cif (wceq (cv x3) (cv y1)) (csn J) (cif (wa (wceq (cv x3) X) (wceq (cv y1) Y)) S c0))) $ >
  $ wi ph (wcel F (co U V H)) $ >
  $ wi ph (wcel G (co V W H)) $ >
  $ wss S (cpw J) $ >
  $ wi ph (wcel (cin G F) (co U W H)) $;

--| The composition in the specified parallel-arrow categories is intersection. (Contributed by Zhi Wang, 14-Sep-2026.)
theorem parcoval {z f2 g2 p: setvar} (ph: wff) (B2: class) (c_x: class z f2 g2 p) (U F G K: class) (M: class f2 g2) (V W: class):
  $ wceq M (cmpo f2 g2 K K (cin (cv f2) (cv g2))) $ >
  $ wceq c_x (cmpo p z (cxp B2 B2) B2 M) $ >
  $ wcel M cvv $ >
  $ wi ph (wcel U B2) $ >
  $ wi ph (wcel V B2) $ >
  $ wi ph (wcel W B2) $ >
  $ wi ph (wcel F K) $ >
  $ wi ph (wcel G K) $ >
  $ wi ph (wceq (co G F (co (cop U V) W c_x)) (cin G F)) $;

--| Variant of ~ parcatid . (Contributed by Zhi Wang, 14-Sep-2026.) (Revised by Zhi Wang, 17-Sep-2026.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem parcatid2 {y1 m n s1 r q p: setvar} (B2: class) (C: class m n s1 r q p) (S: class) (c_x: class m n s1 r q p) (H: class m n) (J K: class) (M: class s1 r) (X Y: class):
  $ wcel B2 cvv $ >
  $ wcel J cvv $ >
  $ wss S (cpw J) $ >
  $ wceq K (cun S (csn J)) $ >
  $ wceq H (cmpo m n B2 B2 (cif (wceq (cv m) (cv n)) (csn J) (cif (wa (wceq (cv m) X) (wceq (cv n) Y)) S c0))) $ >
  $ wceq M (cmpo r s1 K K (cin (cv r) (cv s1))) $ >
  $ wceq c_x (cmpo p q (cxp B2 B2) B2 M) $ >
  $ wceq C (ctp (cop (cfv cnx cbs) B2) (cop (cfv cnx chom) H) (cop (cfv cnx cco) c_x)) $ >
  $ wcel S cvv $ >
  $ wne X Y $ >
  $ wa (wcel C ccat) (wceq (cfv C ccid) (cmpt y1 B2 J)) $;

--| Construct a category with a family of parallel arrows from ` X ` to ` Y ` and only identity endomorphisms. All arrow values are subsets of ` J ` ; composition is intersection. Nonidentity arrows can occur only when ` X ` and ` Y ` are distinct members of ` B ` . If ` X = Y ` , or either distinguished endpoint is outside ` B ` , the category is discrete. (Contributed by Zhi Wang, 14-Sep-2026.) (Revised by Zhi Wang, 17-Sep-2026.)
theorem parcatid {y1 m n s1 r q p: setvar} (B2: class) (C: class m n s1 r q p) (S: class) (c_x: class m n s1 r q p) (H: class m n) (J K: class) (M: class s1 r) (X Y: class):
  $ wcel B2 cvv $ >
  $ wcel J cvv $ >
  $ wss S (cpw J) $ >
  $ wceq K (cun S (csn J)) $ >
  $ wceq H (cmpo m n B2 B2 (cif (wceq (cv m) (cv n)) (csn J) (cif (wa (wceq (cv m) X) (wceq (cv n) Y)) S c0))) $ >
  $ wceq M (cmpo r s1 K K (cin (cv r) (cv s1))) $ >
  $ wceq c_x (cmpo p q (cxp B2 B2) B2 M) $ >
  $ wceq C (ctp (cop (cfv cnx cbs) B2) (cop (cfv cnx chom) H) (cop (cfv cnx cco) c_x)) $ >
  $ wa (wcel C ccat) (wceq (cfv C ccid) (cmpt y1 B2 J)) $;

--| The identity at any object of a category with the parallel-arrow hom construction is ` J ` . (Contributed by Zhi Wang, 17-Sep-2026.)
theorem paridval {x3 y1: setvar} (ph: wff x3 y1) (B2: class) (C: class x3 y1) (S U: class) (H: class x3 y1) (J X Y: class):
  $ wceq B2 (cfv C cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wceq H (cmpo x3 y1 B2 B2 (cif (wceq (cv x3) (cv y1)) (csn J) (cif (wa (wceq (cv x3) X) (wceq (cv y1) Y)) S c0))) $ >
  $ wi ph (wcel C ccat) $ >
  $ wi ph (wcel U B2) $ >
  $ wi ph (wceq (cfv U (cfv C ccid)) J) $;

--| Composition in a category with the parallel-arrow hom construction. Every composable pair contains an identity, so the category identity laws determine the value. (Contributed by Zhi Wang, 17-Sep-2026.)
theorem parcoval2 {x3 y1: setvar} (ph: wff x3 y1) (B2: class) (C: class x3 y1) (S: class) (c_x: class x3 y1) (U: class) (F G H: class x3 y1) (J V W X Y: class):
  $ wceq B2 (cfv C cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wceq H (cmpo x3 y1 B2 B2 (cif (wceq (cv x3) (cv y1)) (csn J) (cif (wa (wceq (cv x3) X) (wceq (cv y1) Y)) S c0))) $ >
  $ wi ph (wcel C ccat) $ >
  $ wceq c_x (cfv C cco) $ >
  $ wi ph (wcel F (co U V H)) $ >
  $ wi ph (wcel G (co V W H)) $ >
  $ wi ph (wceq (co G F (co (cop U V) W c_x)) (cif (wceq U V) G F)) $;

--| A concrete category with two objects and two parallel nonidentity arrows. The two identity arrows both have raw value ` 2o ` ; their sources and targets distinguish them. The parallel arrows have raw values the empty set and ` 1o ` . (Contributed by Zhi Wang, 14-Sep-2026.)
theorem par2catid {y1 m n s1 r q p: setvar} (C: class m n s1 r q p):
  $ wceq C (ctp (cop (cfv cnx cbs) c2o) (cop (cfv cnx chom) (cmpo m n c2o c2o (cif (wceq (cv m) (cv n)) (csn c2o) (cif (wa (wceq (cv m) c0) (wceq (cv n) c1o)) c2o c0)))) (cop (cfv cnx cco) (cmpo p q (cxp c2o c2o) c2o (cmpo r s1 c3o c3o (cin (cv r) (cv s1)))))) $ >
  $ wa (wcel C ccat) (wceq (cfv C ccid) (cmpt y1 c2o c2o)) $;

--| The explicitly given two-object, two-parallel-arrow category exists. This closed theorem discharges the constructor premises in ~ par2catid . (Contributed by Zhi Wang, 14-Sep-2026.)
theorem par2cat {m n s1 r q p: setvar}:
  $ wcel (ctp (cop (cfv cnx cbs) c2o) (cop (cfv cnx chom) (cmpo m n c2o c2o (cif (wceq (cv m) (cv n)) (csn c2o) (cif (wa (wceq (cv m) c0) (wceq (cv n) c1o)) c2o c0)))) (cop (cfv cnx cco) (cmpo p q (cxp c2o c2o) c2o (cmpo r s1 c3o c3o (cin (cv r) (cv s1)))))) ccat $;

--| The object set, hom operation, and composition of the concrete two-object parallel-arrow category. (Contributed by Zhi Wang, 14-Sep-2026.)
theorem par2str {m n s1 r q p: setvar} (C: class m n s1 r q p):
  $ wceq C (ctp (cop (cfv cnx cbs) c2o) (cop (cfv cnx chom) (cmpo m n c2o c2o (cif (wceq (cv m) (cv n)) (csn c2o) (cif (wa (wceq (cv m) c0) (wceq (cv n) c1o)) c2o c0)))) (cop (cfv cnx cco) (cmpo p q (cxp c2o c2o) c2o (cmpo r s1 c3o c3o (cin (cv r) (cv s1)))))) $ >
  $ w3a (wceq c2o (cfv C cbs)) (wceq (cmpo m n c2o c2o (cif (wceq (cv m) (cv n)) (csn c2o) (cif (wa (wceq (cv m) c0) (wceq (cv n) c1o)) c2o c0))) (cfv C chom)) (wceq (cmpo p q (cxp c2o c2o) c2o (cmpo r s1 c3o c3o (cin (cv r) (cv s1)))) (cfv C cco)) $;

--| Variant of ~ parmapcl . (Contributed by Zhi Wang, 14-Sep-2026.) (Revised by Zhi Wang, 17-Sep-2026.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem parmapcl2 {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1) (B2 S U: class) (F H: class x3 y1) (J V X Y: class):
  $ wceq H (cmpo x3 y1 B2 B2 (cif (wceq (cv x3) (cv y1)) (csn J) (cif (wa (wceq (cv x3) X) (wceq (cv y1) Y)) S c0))) $ >
  $ wi ph (wcel F (co U V H)) $ >
  $ wi ph (wceq (cfv J A2) J) $ >
  $ wi (wa ph (wcel F S)) (wcel (cfv F A2) S) $ >
  $ wcel S cvv $ >
  $ wcel J cvv $ >
  $ wi ph (wcel U B2) $ >
  $ wi ph (wcel V B2) $ >
  $ wi ph (wcel (cfv F A2) (co U V H)) $;

--| A map fixing the identity value and preserving the parallel-arrow class preserves each hom-set. (Contributed by Zhi Wang, 14-Sep-2026.) (Revised by Zhi Wang, 17-Sep-2026.)
theorem parmapcl {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1) (B2 S U: class) (F H: class x3 y1) (J V X Y: class):
  $ wceq H (cmpo x3 y1 B2 B2 (cif (wceq (cv x3) (cv y1)) (csn J) (cif (wa (wceq (cv x3) X) (wceq (cv y1) Y)) S c0))) $ >
  $ wi ph (wcel F (co U V H)) $ >
  $ wi ph (wceq (cfv J A2) J) $ >
  $ wi (wa ph (wcel F S)) (wcel (cfv F A2) S) $ >
  $ wi ph (wcel (cfv F A2) (co U V H)) $;

--| Variant of ~ parmapco . (Contributed by Zhi Wang, 14-Sep-2026.) (Revised by Zhi Wang, 17-Sep-2026.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem parmapco2 {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1) (B2 S U: class) (F G H: class x3 y1) (J V W X Y: class):
  $ wceq H (cmpo x3 y1 B2 B2 (cif (wceq (cv x3) (cv y1)) (csn J) (cif (wa (wceq (cv x3) X) (wceq (cv y1) Y)) S c0))) $ >
  $ wi ph (wcel F (co U V H)) $ >
  $ wi ph (wceq (cfv J A2) J) $ >
  $ wi (wa ph (wcel F S)) (wcel (cfv F A2) S) $ >
  $ wcel S cvv $ >
  $ wcel J cvv $ >
  $ wss S (cpw J) $ >
  $ wne X Y $ >
  $ wi ph (wcel U B2) $ >
  $ wi ph (wcel V B2) $ >
  $ wi ph (wcel W B2) $ >
  $ wi ph (wcel G (co V W H)) $ >
  $ wi (wa ph (wcel G S)) (wcel (cfv G A2) S) $ >
  $ wi ph (wceq (cfv (cin G F) A2) (cin (cfv G A2) (cfv F A2))) $;

--| An identity-fixing map preserving parallel arrows preserves every typed composition. (Contributed by Zhi Wang, 14-Sep-2026.) (Revised by Zhi Wang, 17-Sep-2026.)
theorem parmapco {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1) (B2 S U: class) (F G H: class x3 y1) (J V W X Y: class):
  $ wceq H (cmpo x3 y1 B2 B2 (cif (wceq (cv x3) (cv y1)) (csn J) (cif (wa (wceq (cv x3) X) (wceq (cv y1) Y)) S c0))) $ >
  $ wss S (cpw J) $ >
  $ wi ph (wcel F (co U V H)) $ >
  $ wi ph (wcel G (co V W H)) $ >
  $ wi ph (wceq (cfv J A2) J) $ >
  $ wi (wa ph (wcel F S)) (wcel (cfv F A2) S) $ >
  $ wi (wa ph (wcel G S)) (wcel (cfv G A2) S) $ >
  $ wi ph (wceq (cfv (cin G F) A2) (cin (cfv G A2) (cfv F A2))) $;

--| Variant of ~ parmapfunc . (Contributed by Zhi Wang, 14-Sep-2026.) (Revised by Zhi Wang, 17-Sep-2026.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem parmapfunc2 {v u t f2 g2 s1 r q p a: setvar} (A2 B2: class) (C: class v u t f2 g2 s1 r q p a) (S: class) (c_x: class f2 g2 s1 r q p) (H: class s1 r) (I: class v u t f2 g2 s1 r q p a) (J K: class) (L: class v u f2 g2 s1 r q p a) (M: class f2 g2) (X Y: class):
  $ wceq B2 (cfv C cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wcel C ccat $ >
  $ wceq H (cmpo r s1 B2 B2 (cif (wceq (cv r) (cv s1)) (csn J) (cif (wa (wceq (cv r) X) (wceq (cv s1) Y)) S c0))) $ >
  $ wceq L (cmpo u v B2 B2 (cmpt a (co (cv u) (cv v) H) (cfv (cv a) A2))) $ >
  $ wceq (cfv J A2) J $ >
  $ wral t (wcel (cfv (cv t) A2) S) S $ >
  $ wceq I (cfv C ccid) $ >
  $ wceq c_x (cfv C cco) $ >
  $ wcel S cvv $ >
  $ wcel J cvv $ >
  $ wss S (cpw J) $ >
  $ wne X Y $ >
  $ wceq K (cun S (csn J)) $ >
  $ wceq M (cmpo f2 g2 K K (cin (cv f2) (cv g2))) $ >
  $ wceq c_x (cmpo p q (cxp B2 B2) B2 M) $ >
  $ wceq I (cmpt t B2 J) $ >
  $ wbr (cres cid B2) L (co C C cfunc) $;

--| A map fixing the identity value and preserving the parallel-arrow class induces an endofunctor fixing every object. Category membership and the hom construction suffice: every composable pair contains an identity. (Contributed by Zhi Wang, 14-Sep-2026.) (Revised by Zhi Wang, 17-Sep-2026.)
theorem parmapfunc {v u t s1 r a: setvar} (A2 B2: class) (C: class v u t s1 r a) (S: class) (H: class s1 r) (J: class) (L: class v u s1 r a) (X Y: class):
  $ wceq B2 (cfv C cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wcel C ccat $ >
  $ wceq H (cmpo r s1 B2 B2 (cif (wceq (cv r) (cv s1)) (csn J) (cif (wa (wceq (cv r) X) (wceq (cv s1) Y)) S c0))) $ >
  $ wceq L (cmpo u v B2 B2 (cmpt a (co (cv u) (cv v) H) (cfv (cv a) A2))) $ >
  $ wceq (cfv J A2) J $ >
  $ wral t (wcel (cfv (cv t) A2) S) S $ >
  $ wbr (cres cid B2) L (co C C cfunc) $;

--| Evaluate the transposition of the two parallel-arrow values. (Contributed by Zhi Wang, 14-Sep-2026.)
theorem parswapval {b: setvar} (A2: class b) (U: class):
  $ wceq A2 (cmpt b c3o (cif (wceq (cv b) c2o) c2o (cif (wceq (cv b) c0) c1o c0))) $ >
  $ wi (wcel U c3o) (wceq (cfv U A2) (cif (wceq U c2o) c2o (cif (wceq U c0) c1o c0))) $;

--| The concrete transposition fixes the identity, preserves the parallel arrows, and sends the empty-set arrow to the ordinal-one arrow. (Contributed by Zhi Wang, 14-Sep-2026.)
theorem parswapprop {t b: setvar} (A2: class b):
  $ wceq A2 (cmpt b c3o (cif (wceq (cv b) c2o) c2o (cif (wceq (cv b) c0) c1o c0))) $ >
  $ w3a (wceq (cfv c2o A2) c2o) (wral t (wcel (cfv (cv t) A2) c2o) c2o) (wceq (cfv c0 A2) c1o) $;

--| The explicit exchange of the two parallel nonidentity arrows is an endofunctor with identity object function. (Contributed by Zhi Wang, 14-Sep-2026.)
theorem parswapfunc {v u m n s1 r q p a b: setvar} (A2: class b) (C L: class v u m n s1 r q p a b):
  $ wceq C (ctp (cop (cfv cnx cbs) c2o) (cop (cfv cnx chom) (cmpo m n c2o c2o (cif (wceq (cv m) (cv n)) (csn c2o) (cif (wa (wceq (cv m) c0) (wceq (cv n) c1o)) c2o c0)))) (cop (cfv cnx cco) (cmpo p q (cxp c2o c2o) c2o (cmpo r s1 c3o c3o (cin (cv r) (cv s1)))))) $ >
  $ wceq A2 (cmpt b c3o (cif (wceq (cv b) c2o) c2o (cif (wceq (cv b) c0) c1o c0))) $ >
  $ wceq L (cmpo u v c2o c2o (cmpt a (co (cv u) (cv v) (cmpo m n c2o c2o (cif (wceq (cv m) (cv n)) (csn c2o) (cif (wa (wceq (cv m) c0) (wceq (cv n) c1o)) c2o c0)))) (cfv (cv a) A2))) $ >
  $ wcel (cop (cres cid c2o) L) (co C C cfunc) $;

--| The four hom-sets of the explicit two-object parallel-arrow category. (Contributed by Zhi Wang, 14-Sep-2026.)
theorem par2hom {m n: setvar} (H: class m n):
  $ wceq H (cmpo m n c2o c2o (cif (wceq (cv m) (cv n)) (csn c2o) (cif (wa (wceq (cv m) c0) (wceq (cv n) c1o)) c2o c0))) $ >
  $ w3a (wceq (co c0 c0 H) (csn c2o)) (wceq (co c1o c1o H) (csn c2o)) (wa (wceq (co c0 c1o H) c2o) (wceq (co c1o c0 H) c0)) $;

--| Two constant functors into the concrete parallel-arrow category and a natural transformation whose component is the empty-set arrow. (Contributed by Zhi Wang, 14-Sep-2026.)
theorem par2diag {m n s1 r q p: setvar} (A2 C E F G L: class m n s1 r q p):
  $ wceq C (cfv c1o csetc) $ >
  $ wceq E (ctp (cop (cfv cnx cbs) c2o) (cop (cfv cnx chom) (cmpo m n c2o c2o (cif (wceq (cv m) (cv n)) (csn c2o) (cif (wa (wceq (cv m) c0) (wceq (cv n) c1o)) c2o c0)))) (cop (cfv cnx cco) (cmpo p q (cxp c2o c2o) c2o (cmpo r s1 c3o c3o (cin (cv r) (cv s1)))))) $ >
  $ wceq L (co E C cdiag) $ >
  $ wceq F (cfv c0 (cfv L c1st)) $ >
  $ wceq G (cfv c1o (cfv L c1st)) $ >
  $ wceq A2 (cxp c1o (csn c0)) $ >
  $ w3a (wa (wcel F (co C E cfunc)) (wcel G (co C E cfunc))) (wa (wcel A2 (co F G (co C E cnat))) (wceq (cfv c0 A2) c0)) (wa (wceq (cfv c0 (cfv F c1st)) c0) (wceq (cfv c0 (cfv G c1st)) c1o)) $;

--| Lemma for ~ fuconuniq . (Contributed by Zhi Wang, 14-Sep-2026.) (New usage is discouraged.)
theorem fuconuniqlem {v u m n s1 r q p a b: setvar} (A2: class b) (C D Q R S T E F G K L M N c_op: class v u m n s1 r q p a b):
  $ wceq C (cfv c1o csetc) $ >
  $ wceq E (ctp (cop (cfv cnx cbs) c2o) (cop (cfv cnx chom) (cmpo m n c2o c2o (cif (wceq (cv m) (cv n)) (csn c2o) (cif (wa (wceq (cv m) c0) (wceq (cv n) c1o)) c2o c0)))) (cop (cfv cnx cco) (cmpo p q (cxp c2o c2o) c2o (cmpo r s1 c3o c3o (cin (cv r) (cv s1)))))) $ >
  $ wceq Q (co C E cfuc) $ >
  $ wceq L (co (cop C C) E cfuco) $ >
  $ wceq A2 (cmpt b c3o (cif (wceq (cv b) c2o) c2o (cif (wceq (cv b) c0) c1o c0))) $ >
  $ wceq M (cmpo u v c2o c2o (cmpt a (co (cv u) (cv v) (cmpo m n c2o c2o (cif (wceq (cv m) (cv n)) (csn c2o) (cif (wa (wceq (cv m) c0) (wceq (cv n) c1o)) c2o c0)))) (cfv (cv a) A2))) $ >
  $ wceq S (cop (cres cid c2o) M) $ >
  $ wceq R (co E E cfuc) $ >
  $ wceq c_op (co (cop R Q) (co (cop C E) E cfuco) ccurf) $ >
  $ wceq K (cfv S (cfv c_op c1st)) $ >
  $ wceq T (co (co C E cfuc) (co C C cfuc) cxpc) $ >
  $ wceq D (co E C cdiag) $ >
  $ wceq F (cfv c0 (cfv D c1st)) $ >
  $ wceq G (cfv c1o (cfv D c1st)) $ >
  $ wceq N (cxp c1o (csn c0)) $ >
  $ wa (wbr (cfv L c1st) (cfv (co K L ccofu) c2nd) (co T Q cfunc)) (wne (cfv (co K L ccofu) c2nd) (cfv L c2nd)) $;

--| The arrow map ` A ` fixes the identity arrow ` 2o ` and exchanges the two nonidentity parallel arrows ` (/) ` and ` 1o ` . It gives a concrete alternative to functor composition with the same object function and a different morphism function. All hypotheses name explicit constructed sets; no category or functor existence is assumed. (Contributed by Zhi Wang, 14-Sep-2026.) (Revised by Zhi Wang, 17-Sep-2026.)
theorem fuconuniq {v u m n s1 r q p a b: setvar} (A2: class b) (C Q R S T E K L M c_op: class v u m n s1 r q p a b):
  $ wceq C (cfv c1o csetc) $ >
  $ wceq E (ctp (cop (cfv cnx cbs) c2o) (cop (cfv cnx chom) (cmpo m n c2o c2o (cif (wceq (cv m) (cv n)) (csn c2o) (cif (wa (wceq (cv m) c0) (wceq (cv n) c1o)) c2o c0)))) (cop (cfv cnx cco) (cmpo p q (cxp c2o c2o) c2o (cmpo r s1 c3o c3o (cin (cv r) (cv s1)))))) $ >
  $ wceq Q (co C E cfuc) $ >
  $ wceq L (co (cop C C) E cfuco) $ >
  $ wceq A2 (cmpt b c3o (cif (wceq (cv b) c2o) c2o (cif (wceq (cv b) c0) c1o c0))) $ >
  $ wceq M (cmpo u v c2o c2o (cmpt a (co (cv u) (cv v) (cmpo m n c2o c2o (cif (wceq (cv m) (cv n)) (csn c2o) (cif (wa (wceq (cv m) c0) (wceq (cv n) c1o)) c2o c0)))) (cfv (cv a) A2))) $ >
  $ wceq S (cop (cres cid c2o) M) $ >
  $ wceq R (co E E cfuc) $ >
  $ wceq c_op (co (cop R Q) (co (cop C E) E cfuco) ccurf) $ >
  $ wceq K (cfv S (cfv c_op c1st)) $ >
  $ wceq T (co (co C E cfuc) (co C C cfuc) cxpc) $ >
  $ wa (wbr (cfv L c1st) (cfv (co K L ccofu) c2nd) (co T Q cfunc)) (wne (cfv (co K L ccofu) c2nd) (cfv L c2nd)) $;

--| Lemma for ~ fuconuniqvals . (Contributed by Zhi Wang, 14-Sep-2026.) (New usage is discouraged.)
theorem fuconuniqvalslem {v u m n s1 r q p a b: setvar} (A2: class b) (C D Q R S T E F G K L M N c_op: class v u m n s1 r q p a b):
  $ wceq C (cfv c1o csetc) $ >
  $ wceq E (ctp (cop (cfv cnx cbs) c2o) (cop (cfv cnx chom) (cmpo m n c2o c2o (cif (wceq (cv m) (cv n)) (csn c2o) (cif (wa (wceq (cv m) c0) (wceq (cv n) c1o)) c2o c0)))) (cop (cfv cnx cco) (cmpo p q (cxp c2o c2o) c2o (cmpo r s1 c3o c3o (cin (cv r) (cv s1)))))) $ >
  $ wceq Q (co C E cfuc) $ >
  $ wceq L (co (cop C C) E cfuco) $ >
  $ wceq A2 (cmpt b c3o (cif (wceq (cv b) c2o) c2o (cif (wceq (cv b) c0) c1o c0))) $ >
  $ wceq M (cmpo u v c2o c2o (cmpt a (co (cv u) (cv v) (cmpo m n c2o c2o (cif (wceq (cv m) (cv n)) (csn c2o) (cif (wa (wceq (cv m) c0) (wceq (cv n) c1o)) c2o c0)))) (cfv (cv a) A2))) $ >
  $ wceq S (cop (cres cid c2o) M) $ >
  $ wceq R (co E E cfuc) $ >
  $ wceq c_op (co (cop R Q) (co (cop C E) E cfuco) ccurf) $ >
  $ wceq K (cfv S (cfv c_op c1st)) $ >
  $ wceq D (co E C cdiag) $ >
  $ wceq F (cfv c0 (cfv D c1st)) $ >
  $ wceq G (cfv c1o (cfv D c1st)) $ >
  $ wceq N (cxp c1o (csn c0)) $ >
  $ wceq T (co (co C E cfuc) (co C C cfuc) cxpc) $ >
  $ wa (wceq (cfv c0 (co N (cfv (cfv C cidfu) (cfv (co C C cfuc) ccid)) (co (cop F (cfv C cidfu)) (cop G (cfv C cidfu)) (cfv L c2nd)))) c0) (wceq (cfv c0 (co N (cfv (cfv C cidfu) (cfv (co C C cfuc) ccid)) (co (cop F (cfv C cidfu)) (cop G (cfv C cidfu)) (cfv (co K L ccofu) c2nd)))) c1o) $;

--| At the same natural-transformation/identity input, the canonical and alternative morphism maps give respectively ` (/) ` and ` 1o ` at the unique source object ` (/) ` . (Contributed by Zhi Wang, 14-Sep-2026.) (Revised by Zhi Wang, 17-Sep-2026.)
theorem fuconuniqvals {v u m n s1 r q p a b: setvar} (A2: class b) (C D Q R S E F G K L M N c_op: class v u m n s1 r q p a b):
  $ wceq C (cfv c1o csetc) $ >
  $ wceq E (ctp (cop (cfv cnx cbs) c2o) (cop (cfv cnx chom) (cmpo m n c2o c2o (cif (wceq (cv m) (cv n)) (csn c2o) (cif (wa (wceq (cv m) c0) (wceq (cv n) c1o)) c2o c0)))) (cop (cfv cnx cco) (cmpo p q (cxp c2o c2o) c2o (cmpo r s1 c3o c3o (cin (cv r) (cv s1)))))) $ >
  $ wceq Q (co C E cfuc) $ >
  $ wceq L (co (cop C C) E cfuco) $ >
  $ wceq A2 (cmpt b c3o (cif (wceq (cv b) c2o) c2o (cif (wceq (cv b) c0) c1o c0))) $ >
  $ wceq M (cmpo u v c2o c2o (cmpt a (co (cv u) (cv v) (cmpo m n c2o c2o (cif (wceq (cv m) (cv n)) (csn c2o) (cif (wa (wceq (cv m) c0) (wceq (cv n) c1o)) c2o c0)))) (cfv (cv a) A2))) $ >
  $ wceq S (cop (cres cid c2o) M) $ >
  $ wceq R (co E E cfuc) $ >
  $ wceq c_op (co (cop R Q) (co (cop C E) E cfuco) ccurf) $ >
  $ wceq K (cfv S (cfv c_op c1st)) $ >
  $ wceq D (co E C cdiag) $ >
  $ wceq F (cfv c0 (cfv D c1st)) $ >
  $ wceq G (cfv c1o (cfv D c1st)) $ >
  $ wceq N (cxp c1o (csn c0)) $ >
  $ wa (wceq (cfv c0 (co N (cfv (cfv C cidfu) (cfv (co C C cfuc) ccid)) (co (cop F (cfv C cidfu)) (cop G (cfv C cidfu)) (cfv L c2nd)))) c0) (wceq (cfv c0 (co N (cfv (cfv C cidfu) (cfv (co C C cfuc) ccid)) (co (cop F (cfv C cidfu)) (cop G (cfv C cidfu)) (cfv (co K L ccofu) c2nd)))) c1o) $;

--| The concrete parallel-arrow category supplies a morphism function different from canonical functor composition, with its object function fixed exactly. See ~ par2cat and ~ par2hom for the category and its four hom-sets. (Contributed by Zhi Wang, 14-Sep-2026.)
theorem fuconuniq2 {z m n s1 r q p: setvar} (C Q T E L: class m n s1 r q p):
  $ wceq C (cfv c1o csetc) $ >
  $ wceq E (ctp (cop (cfv cnx cbs) c2o) (cop (cfv cnx chom) (cmpo m n c2o c2o (cif (wceq (cv m) (cv n)) (csn c2o) (cif (wa (wceq (cv m) c0) (wceq (cv n) c1o)) c2o c0)))) (cop (cfv cnx cco) (cmpo p q (cxp c2o c2o) c2o (cmpo r s1 c3o c3o (cin (cv r) (cv s1)))))) $ >
  $ wceq Q (co C E cfuc) $ >
  $ wceq L (co (cop C C) E cfuco) $ >
  $ wceq T (co (co C E cfuc) (co C C cfuc) cxpc) $ >
  $ wex z (wa (wbr (cfv L c1st) (cv z) (co T Q cfunc)) (wne (cv z) (cfv L c2nd))) $;

--| The object function of functor composition does not in general determine its morphism function, even when both source categories are the trivial category. The witness category is the explicit two-object, two-parallel-arrow category of ~ par2cat . (Contributed by Zhi Wang, 14-Sep-2026.)
theorem fuconuniqex {z e: setvar}:
  $ wrex e (wex z (wa (wbr (cfv (co (cop (cfv c1o csetc) (cfv c1o csetc)) (cv e) cfuco) c1st) (cv z) (co (co (co (cfv c1o csetc) (cv e) cfuc) (co (cfv c1o csetc) (cfv c1o csetc) cfuc) cxpc) (co (cfv c1o csetc) (cv e) cfuc) cfunc)) (wne (cv z) (cfv (co (cop (cfv c1o csetc) (cfv c1o csetc)) (cv e) cfuco) c2nd)))) ccat $;

--| There are categories for which the object function of functor composition does not determine its morphism function. Choose both source categories to be the trivial category and apply ~ fuconuniqex . The full compatibility conditions are given in ~ fucoisfunc ; ~ fucoisfunc2 expands the natural-transformation component conditions. (Contributed by Zhi Wang, 14-Sep-2026.)
theorem fuconuniqex2 {z e c d: setvar}:
  $ wrex c (wrex d (wrex e (wex z (wa (wbr (cfv (co (cop (cv c) (cv d)) (cv e) cfuco) c1st) (cv z) (co (co (co (cv d) (cv e) cfuc) (co (cv c) (cv d) cfuc) cxpc) (co (cv c) (cv e) cfuc) cfunc)) (wne (cv z) (cfv (co (cop (cv c) (cv d)) (cv e) cfuco) c2nd)))) ccat) ccat) ccat $;

--| Class function defining the (local) left Kan extension.
term clan: class;

--| Class function defining the (local) right Kan extension.
term cran: class;

--| Definition of the (local) left Kan extension. Given a functor ` F : C --> D ` and a functor ` X : C --> E ` , the set ` ( F ( <. C , D >. Lan E ) X ) ` consists of left Kan extensions of ` X ` along ` F ` , which are universal pairs from ` X ` to the pre-composition functor given by ` F ` ( ~ lanval2 ). See also <HTML>&sect;</HTML> 3 of Chapter X in p. 240 of Mac Lane, Saunders, _Categories for the Working Mathematician_, 2nd Edition, Springer Science+Business Media, New York, (1998) [QA169.M33 1998]; available at ~ https://math.mit.edu/~~hrm/palestine/maclane-categories.pdf (retrieved 3 Nov 2025). A left Kan extension is in the form of ` <. L , A >. ` where the first component is a functor ` L : D --> E ` ( ~ lanrcl4 ) and the second component is a natural transformation ` A : X --> L F ` ( ~ lanrcl5 ) where ` L F ` is the composed functor. Intuitively, the first component ` L ` can be regarded as the result of an "inverse" of pre-composition; the source category of ` X : C --> E ` is "extended" along ` F : C --> D ` . The left Kan extension is a generalization of many categorical concepts such as colimit. In <HTML>&sect;</HTML> 7 of Chapter X of _Categories for the Working Mathematician_, it is concluded that "the notion of Kan extensions subsumes all the other fundamental concepts of category theory". This definition was chosen over the other version in the commented out section due to its better reverse closure property. See ~ df-ran for the dual concept. (Contributed by Zhi Wang, 3-Nov-2025.)
axiom df_lan {x3 e f2 p c d: setvar}:
  $ wceq clan (cmpo p e (cxp cvv cvv) cvv (csb c (cfv (cv p) c1st) (csb d (cfv (cv p) c2nd) (cmpo f2 x3 (co (cv c) (cv d) cfunc) (co (cv c) (cv e) cfunc) (co (co (cop (cv d) (cv e)) (cv f2) cprcof) (cv x3) (co (co (cv d) (cv e) cfuc) (co (cv c) (cv e) cfuc) cup)))))) $;

--| Definition of the (local) right Kan extension. Given a functor ` F : C --> D ` and a functor ` X : C --> E ` , the set ` ( F ( <. C , D >. Ran E ) X ) ` consists of right Kan extensions of ` X ` along ` F ` , which are universal pairs from the pre-composition functor given by ` F ` to ` X ` ( ~ ranval2 ). The definition in <HTML>&sect;</HTML> 3 of Chapter X in p. 236 of Mac Lane, Saunders, _Categories for the Working Mathematician_, 2nd Edition, Springer Science+Business Media, New York, (1998) [QA169.M33 1998]; available at ~ https://math.mit.edu/~~hrm/palestine/maclane-categories.pdf (retrieved 3 Nov 2025). A right Kan extension is in the form of ` <. L , A >. ` where the first component is a functor ` L : D --> E ` ( ~ ranrcl4 ) and the second component is a natural transformation ` A : L F --> X ` ( ~ ranrcl5 ) where ` L F ` is the composed functor. Intuitively, the first component ` L ` can be regarded as the result of an "inverse" of pre-composition; the source category of ` X : C --> E ` is "extended" along ` F : C --> D ` . The right Kan extension is a generalization of many categorical concepts such as limit. In <HTML>&sect;</HTML> 7 of Chapter X of _Categories for the Working Mathematician_, it is concluded that "the notion of Kan extensions subsumes all the other fundamental concepts of category theory". This definition was chosen over the other version in the commented out section due to its better reverse closure property. See ~ df-lan for the dual concept. (Contributed by Zhi Wang, 4-Nov-2025.)
axiom df_ran {x3 e f2 p c d: setvar}:
  $ wceq cran (cmpo p e (cxp cvv cvv) cvv (csb c (cfv (cv p) c1st) (csb d (cfv (cv p) c2nd) (cmpo f2 x3 (co (cv c) (cv d) cfunc) (co (cv c) (cv e) cfunc) (co (cfv (co (cop (cv d) (cv e)) (cv f2) cprcof) coppf) (cv x3) (co (cfv (co (cv d) (cv e) cfuc) coppc) (cfv (co (cv c) (cv e) cfuc) coppc) cup)))))) $;

--| ` Lan ` is a function on ` ( ( _V X. _V ) X. _V ) ` . (Contributed by Zhi Wang, 3-Nov-2025.)
theorem lanfn:
  $ wfn clan (cxp (cxp cvv cvv) cvv) $;

--| ` Ran ` is a function on ` ( ( _V X. _V ) X. _V ) ` . (Contributed by Zhi Wang, 4-Nov-2025.)
theorem ranfn:
  $ wfn cran (cxp (cxp cvv cvv) cvv) $;

--| The domain of ` Lan ` is a relation. (Contributed by Zhi Wang, 3-Nov-2025.)
theorem reldmlan:
  $ wrel (cdm clan) $;

--| The domain of ` Ran ` is a relation. (Contributed by Zhi Wang, 4-Nov-2025.)
theorem reldmran:
  $ wrel (cdm cran) $;

--| Value of the function generating the set of left Kan extensions. (Contributed by Zhi Wang, 3-Nov-2025.)
theorem lanfval {x3 f2: setvar} (ph: wff) (C D: class) (R S U: class x3 f2) (E: class) (V W: class x3 f2):
  $ wceq R (co D E cfuc) $ >
  $ wceq S (co C E cfuc) $ >
  $ wi ph (wcel C U) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel E W) $ >
  $ wi ph (wceq (co (cop C D) E clan) (cmpo f2 x3 (co C D cfunc) (co C E cfunc) (co (co (cop D E) (cv f2) cprcof) (cv x3) (co R S cup)))) $;

--| Value of the function generating the set of right Kan extensions. (Contributed by Zhi Wang, 4-Nov-2025.)
theorem ranfval {x3 f2: setvar} (ph: wff) (C D: class) (P R S U: class x3 f2) (E: class) (O V W: class x3 f2):
  $ wceq R (co D E cfuc) $ >
  $ wceq S (co C E cfuc) $ >
  $ wi ph (wcel C U) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel E W) $ >
  $ wceq O (cfv R coppc) $ >
  $ wceq P (cfv S coppc) $ >
  $ wi ph (wceq (co (cop C D) E cran) (cmpo f2 x3 (co C D cfunc) (co C E cfunc) (co (cfv (co (cop D E) (cv f2) cprcof) coppf) (cv x3) (co O P cup)))) $;

--| If the categories have the same set of objects, morphisms, and compositions, then they have the same left Kan extensions. (Contributed by Zhi Wang, 21-Nov-2025.)
theorem lanpropd (ph: wff) (A2 B2 C D E F V: class):
  $ wi ph (wceq (cfv A2 chomf) (cfv B2 chomf)) $ >
  $ wi ph (wceq (cfv A2 ccomf) (cfv B2 ccomf)) $ >
  $ wi ph (wceq (cfv C chomf) (cfv D chomf)) $ >
  $ wi ph (wceq (cfv C ccomf) (cfv D ccomf)) $ >
  $ wi ph (wceq (cfv E chomf) (cfv F chomf)) $ >
  $ wi ph (wceq (cfv E ccomf) (cfv F ccomf)) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel E V) $ >
  $ wi ph (wcel F V) $ >
  $ wi ph (wceq (co (cop A2 C) E clan) (co (cop B2 D) F clan)) $;

--| If the categories have the same set of objects, morphisms, and compositions, then they have the same right Kan extensions. (Contributed by Zhi Wang, 21-Nov-2025.)
theorem ranpropd (ph: wff) (A2 B2 C D E F V: class):
  $ wi ph (wceq (cfv A2 chomf) (cfv B2 chomf)) $ >
  $ wi ph (wceq (cfv A2 ccomf) (cfv B2 ccomf)) $ >
  $ wi ph (wceq (cfv C chomf) (cfv D chomf)) $ >
  $ wi ph (wceq (cfv C ccomf) (cfv D ccomf)) $ >
  $ wi ph (wceq (cfv E chomf) (cfv F chomf)) $ >
  $ wi ph (wceq (cfv E ccomf) (cfv F ccomf)) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel E V) $ >
  $ wi ph (wcel F V) $ >
  $ wi ph (wceq (co (cop A2 C) E cran) (co (cop B2 D) F cran)) $;

--| The domain of ` ( P Lan E ) ` is a relation. (Contributed by Zhi Wang, 3-Nov-2025.)
theorem reldmlan2 (P E: class):
  $ wrel (cdm (co P E clan)) $;

--| The domain of ` ( P Ran E ) ` is a relation. (Contributed by Zhi Wang, 4-Nov-2025.)
theorem reldmran2 (P E: class):
  $ wrel (cdm (co P E cran)) $;

--| Value of the set of left Kan extensions. (Contributed by Zhi Wang, 3-Nov-2025.)
theorem lanval (ph: wff) (C D R S E F K X: class):
  $ wceq R (co D E cfuc) $ >
  $ wceq S (co C E cfuc) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wcel X (co C E cfunc)) $ >
  $ wi ph (wceq (co (cop D E) F cprcof) K) $ >
  $ wi ph (wceq (co F X (co (cop C D) E clan)) (co K X (co R S cup))) $;

--| Value of the set of right Kan extensions. (Contributed by Zhi Wang, 4-Nov-2025.)
theorem ranval (ph: wff) (C D P R S E F J K O X: class):
  $ wceq R (co D E cfuc) $ >
  $ wceq S (co C E cfuc) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wcel X (co C E cfunc)) $ >
  $ wi ph (wceq (co (cop D E) F cprcof) (cop J K)) $ >
  $ wceq O (cfv R coppc) $ >
  $ wceq P (cfv S coppc) $ >
  $ wi ph (wceq (co F X (co (cop C D) E cran)) (co (cop J (ctpos K)) X (co O P cup))) $;

--| Reverse closure for left Kan extensions. (Contributed by Zhi Wang, 3-Nov-2025.)
theorem lanrcl (C D E F L X: class):
  $ wi (wcel L (co F X (co (cop C D) E clan))) (wa (wcel F (co C D cfunc)) (wcel X (co C E cfunc))) $;

--| Reverse closure for right Kan extensions. (Contributed by Zhi Wang, 4-Nov-2025.)
theorem ranrcl (C D E F L X: class):
  $ wi (wcel L (co F X (co (cop C D) E cran))) (wa (wcel F (co C D cfunc)) (wcel X (co C E cfunc))) $;

--| The set of left Kan extensions is a relation. (Contributed by Zhi Wang, 3-Nov-2025.)
theorem rellan (P E F X: class):
  $ wrel (co F X (co P E clan)) $;

--| The set of right Kan extensions is a relation. (Contributed by Zhi Wang, 4-Nov-2025.)
theorem relran (P E F X: class):
  $ wrel (co F X (co P E cran)) $;

--| A left Kan extension is a universal pair. (Contributed by Zhi Wang, 3-Nov-2025.)
theorem islan (C D R S E F K L X: class):
  $ wceq R (co D E cfuc) $ >
  $ wceq S (co C E cfuc) $ >
  $ wceq K (co (cop D E) F cprcof) $ >
  $ wi (wcel L (co F X (co (cop C D) E clan))) (wcel L (co K X (co R S cup))) $;

--| A left Kan extension is a universal pair. (Contributed by Zhi Wang, 4-Nov-2025.)
theorem islan2 (A2 C D R S E F K L X: class):
  $ wceq R (co D E cfuc) $ >
  $ wceq S (co C E cfuc) $ >
  $ wceq K (co (cop D E) F cprcof) $ >
  $ wi (wbr L A2 (co F X (co (cop C D) E clan))) (wbr L A2 (co K X (co R S cup))) $;

--| The set of left Kan extensions is the set of universal pairs. Therefore, the explicit universal property can be recovered by ~ isup2 and ~ upciclem1 . (Contributed by Zhi Wang, 3-Nov-2025.)
theorem lanval2 (C D R S E F K X: class):
  $ wceq R (co D E cfuc) $ >
  $ wceq S (co C E cfuc) $ >
  $ wceq K (co (cop D E) F cprcof) $ >
  $ wi (wcel F (co C D cfunc)) (wceq (co F X (co (cop C D) E clan)) (co K X (co R S cup))) $;

--| A right Kan extension is a universal pair. (Contributed by Zhi Wang, 4-Nov-2025.)
theorem isran (ph: wff) (C D P E F J K L O X: class):
  $ wceq O (cfv (co D E cfuc) coppc) $ >
  $ wceq P (cfv (co C E cfuc) coppc) $ >
  $ wi ph (wceq (co (cop D E) F cprcof) (cop J K)) $ >
  $ wi ph (wcel L (co F X (co (cop C D) E cran))) $ >
  $ wi ph (wcel L (co (cop J (ctpos K)) X (co O P cup))) $;

--| A right Kan extension is a universal pair. (Contributed by Zhi Wang, 4-Nov-2025.)
theorem isran2 (ph: wff) (A2 C D P E F J K L O X: class):
  $ wceq O (cfv (co D E cfuc) coppc) $ >
  $ wceq P (cfv (co C E cfuc) coppc) $ >
  $ wi ph (wceq (co (cop D E) F cprcof) (cop J K)) $ >
  $ wi ph (wbr L A2 (co F X (co (cop C D) E cran))) $ >
  $ wi ph (wbr L A2 (co (cop J (ctpos K)) X (co O P cup))) $;

--| The set of right Kan extensions is the set of universal pairs. Therefore, the explicit universal property can be recovered by ~ oppcup2 and ~ oppcup3lem . (Contributed by Zhi Wang, 4-Nov-2025.)
theorem ranval2 (ph: wff) (C D P E F J K O X: class):
  $ wceq O (cfv (co D E cfuc) coppc) $ >
  $ wceq P (cfv (co C E cfuc) coppc) $ >
  $ wi ph (wceq (co (cop D E) F cprcof) (cop J K)) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wceq (co F X (co (cop C D) E cran)) (co (cop J (ctpos K)) X (co O P cup))) $;

--| The set of right Kan extensions is the set of universal pairs. (Contributed by Zhi Wang, 26-Nov-2025.)
theorem ranval3 (C D P E F K O X: class):
  $ wceq O (cfv (co D E cfuc) coppc) $ >
  $ wceq P (cfv (co C E cfuc) coppc) $ >
  $ wceq K (co (cop D E) F cprcof) $ >
  $ wi (wcel F (co C D cfunc)) (wceq (co F X (co (cop C D) E cran)) (co (cfv K coppf) X (co O P cup))) $;

--| Reverse closure for left Kan extensions. (Contributed by Zhi Wang, 4-Nov-2025.)
theorem lanrcl2 (ph: wff) (A2 C D E F L X: class):
  $ wi ph (wbr L A2 (co F X (co (cop C D) E clan))) $ >
  $ wi ph (wcel F (co C D cfunc)) $;

--| Reverse closure for left Kan extensions. (Contributed by Zhi Wang, 4-Nov-2025.)
theorem lanrcl3 (ph: wff) (A2 C D E F L X: class):
  $ wi ph (wbr L A2 (co F X (co (cop C D) E clan))) $ >
  $ wi ph (wcel X (co C E cfunc)) $;

--| The first component of a left Kan extension is a functor. (Contributed by Zhi Wang, 4-Nov-2025.)
theorem lanrcl4 (ph: wff) (A2 C D E F L X: class):
  $ wi ph (wbr L A2 (co F X (co (cop C D) E clan))) $ >
  $ wi ph (wcel L (co D E cfunc)) $;

--| The second component of a left Kan extension is a natural transformation. (Contributed by Zhi Wang, 4-Nov-2025.)
theorem lanrcl5 (ph: wff) (A2 C D E F L N X: class):
  $ wi ph (wbr L A2 (co F X (co (cop C D) E clan))) $ >
  $ wceq N (co C E cnat) $ >
  $ wi ph (wcel A2 (co X (co L F ccofu) N)) $;

--| Reverse closure for right Kan extensions. (Contributed by Zhi Wang, 4-Nov-2025.)
theorem ranrcl2 (ph: wff) (A2 C D E F L X: class):
  $ wi ph (wbr L A2 (co F X (co (cop C D) E cran))) $ >
  $ wi ph (wcel F (co C D cfunc)) $;

--| Reverse closure for right Kan extensions. (Contributed by Zhi Wang, 4-Nov-2025.)
theorem ranrcl3 (ph: wff) (A2 C D E F L X: class):
  $ wi ph (wbr L A2 (co F X (co (cop C D) E cran))) $ >
  $ wi ph (wcel X (co C E cfunc)) $;

--| Lemma for ~ ranrcl4 and ~ ranrcl5 . (Contributed by Zhi Wang, 4-Nov-2025.)
theorem ranrcl4lem (ph: wff) (A2 C D E F L X: class):
  $ wi ph (wbr L A2 (co F X (co (cop C D) E cran))) $ >
  $ wi ph (wceq (co (cop D E) F cprcof) (cop (cfv (co (cop D E) F cprcof) c1st) (cfv (co (cop D E) F cprcof) c2nd))) $;

--| The first component of a right Kan extension is a functor. (Contributed by Zhi Wang, 4-Nov-2025.)
theorem ranrcl4 (ph: wff) (A2 C D E F L X: class):
  $ wi ph (wbr L A2 (co F X (co (cop C D) E cran))) $ >
  $ wi ph (wcel L (co D E cfunc)) $;

--| The second component of a right Kan extension is a natural transformation. (Contributed by Zhi Wang, 4-Nov-2025.)
theorem ranrcl5 (ph: wff) (A2 C D E F L N X: class):
  $ wi ph (wbr L A2 (co F X (co (cop C D) E cran))) $ >
  $ wceq N (co C E cnat) $ >
  $ wi ph (wcel A2 (co (co L F ccofu) X N)) $;

--| The universal property of the left Kan extension; expressed explicitly. (Contributed by Zhi Wang, 4-Nov-2025.)
theorem lanup {a b l: setvar} (ph: wff) (A2 C D S c_xb E F L M N X: class):
  $ wceq S (co C E cfuc) $ >
  $ wceq M (co D E cnat) $ >
  $ wceq N (co C E cnat) $ >
  $ wceq c_xb (cfv S cco) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wcel L (co D E cfunc)) $ >
  $ wi ph (wcel A2 (co X (co L F ccofu) N)) $ >
  $ wi ph (wb (wbr L A2 (co F X (co (cop C D) E clan))) (wral l (wral a (wreu b (wceq (cv a) (co (ccom (cv b) (cfv F c1st)) A2 (co (cop X (co L F ccofu)) (co (cv l) F ccofu) c_xb))) (co L (cv l) M)) (co X (co (cv l) F ccofu) N)) (co D E cfunc))) $;

--| The universal property of the right Kan extension; expressed explicitly. (Contributed by Zhi Wang, 5-Nov-2025.)
theorem ranup {a b l: setvar} (ph: wff) (A2 C D S: class) (c_xb: class a b l) (E F L: class) (M: class a l) (N: class l) (X: class):
  $ wceq S (co C E cfuc) $ >
  $ wceq M (co D E cnat) $ >
  $ wceq N (co C E cnat) $ >
  $ wceq c_xb (cfv S cco) $ >
  $ wi ph (wcel F (co C D cfunc)) $ >
  $ wi ph (wcel L (co D E cfunc)) $ >
  $ wi ph (wcel A2 (co (co L F ccofu) X N)) $ >
  $ wi ph (wb (wbr L A2 (co F X (co (cop C D) E cran))) (wral l (wral a (wreu b (wceq (cv a) (co A2 (ccom (cv b) (cfv F c1st)) (co (cop (co (cv l) F ccofu) (co L F ccofu)) X c_xb))) (co (cv l) L M)) (co (co (cv l) F ccofu) X N)) (co D E cfunc))) $;

--| Class function defining the limit of a diagram.
term clmd: class;

--| Class function defining the colimit of a diagram.
term ccmd: class;

--| A diagram of type ` D ` or a ` D ` -shaped diagram in a category ` C ` , is a functor ` F : D --> C ` where the source category ` D ` , usually small or even finite, is called the index category or the scheme of the diagram. The actual objects and morphisms in ` D ` are largely irrelevant; only the way in which they are interrelated matters. The diagram is thought of as indexing a collection of objects and morphisms in ` C ` patterned on ` D ` . Definition 11.1(1) of [Adamek] p. 193. A cone to a diagram, or a natural source for a diagram in a category ` C ` is a pair of an object ` X ` in ` C ` and a natural transformation from the constant functor (or constant diagram) of the object ` X ` to the diagram. The second component associates each object in the index category with a morphism in ` C ` whose domain is ` X ` ( ~ concl ). The naturality guarantees that the combination of the diagram with the cone must commute ( ~ concom ). Definition 11.3(1) of [Adamek] p. 193. A limit of a diagram ` F : D --> C ` of type ` D ` in category ` C ` is a universal pair from the diagonal functor ` ( C DiagFunc D ) ` to the diagram. The universal pair is a cone to the diagram satisfying the universal property, that each cone to the diagram uniquely factors through the limit ( ~ islmd ). Definition 11.3(2) of [Adamek] p. 194. Terminal objects ( ~ termolmd ), products, equalizers, pullbacks, and inverse limits can be considered as limits of some diagram; limits can be further generalized as right Kan extensions ( ~ lmdran ). "lmd" is short for "limit of a diagram". See ~ df-cmd for the dual concept ( ~ lmddu , ~ cmddu ). (Contributed by Zhi Wang, 12-Nov-2025.)
axiom df_lmd {f2 c d: setvar}:
  $ wceq clmd (cmpo c d cvv cvv (cmpt f2 (co (cv d) (cv c) cfunc) (co (cfv (co (cv c) (cv d) cdiag) coppf) (cv f2) (co (cfv (cv c) coppc) (cfv (co (cv d) (cv c) cfuc) coppc) cup)))) $;

--| A co-cone (or cocone) to a diagram (see ~ df-lmd for definition), or a natural sink for a diagram in a category ` C ` is a pair of an object ` X ` in ` C ` and a natural transformation from the diagram to the constant functor (or constant diagram) of the object ` X ` . The second component associates each object in the index category with a morphism in ` C ` whose codomain is ` X ` ( ~ coccl ). The naturality guarantees that the combination of the diagram with the co-cone must commute ( ~ coccom ). Definition 11.27(1) of [Adamek] p. 202. A colimit of a diagram ` F : D --> C ` of type ` D ` in category ` C ` is a universal pair from the diagram to the diagonal functor ` ( C DiagFunc D ) ` . The universal pair is a co-cone to the diagram satisfying the universal property, that each co-cone to the diagram uniquely factors through the colimit. ( ~ iscmd ). Definition 11.27(2) of [Adamek] p. 202. Initial objects ( ~ initocmd ), coproducts, coequalizers, pushouts, and direct limits can be considered as colimits of some diagram; colimits can be further generalized as left Kan extensions ( ~ cmdlan ). "cmd" is short for "colimit of a diagram". See ~ df-lmd for the dual concept ( ~ lmddu , ~ cmddu ). (Contributed by Zhi Wang, 12-Nov-2025.)
axiom df_cmd {f2 c d: setvar}:
  $ wceq ccmd (cmpo c d cvv cvv (cmpt f2 (co (cv d) (cv c) cfunc) (co (co (cv c) (cv d) cdiag) (cv f2) (co (cv c) (co (cv d) (cv c) cfuc) cup)))) $;

--| The domain of ` Limit ` is a relation. (Contributed by Zhi Wang, 12-Nov-2025.)
theorem reldmlmd:
  $ wrel (cdm clmd) $;

--| The domain of ` Colimit ` is a relation. (Contributed by Zhi Wang, 12-Nov-2025.)
theorem reldmcmd:
  $ wrel (cdm ccmd) $;

--| Function value of ` Limit ` . (Contributed by Zhi Wang, 14-Nov-2025.)
theorem lmdfval {f2: setvar} (C D: class):
  $ wceq (co C D clmd) (cmpt f2 (co D C cfunc) (co (cfv (co C D cdiag) coppf) (cv f2) (co (cfv C coppc) (cfv (co D C cfuc) coppc) cup))) $;

--| Function value of ` Colimit ` . (Contributed by Zhi Wang, 12-Nov-2025.)
theorem cmdfval {f2: setvar} (C D: class):
  $ wceq (co C D ccmd) (cmpt f2 (co D C cfunc) (co (co C D cdiag) (cv f2) (co C (co D C cfuc) cup))) $;

--| Reverse closure for a limit of a diagram. (Contributed by Zhi Wang, 20-Nov-2025.)
theorem lmdrcl (C D F X: class):
  $ wi (wcel X (cfv F (co C D clmd))) (wcel F (co D C cfunc)) $;

--| Reverse closure for a colimit of a diagram. (Contributed by Zhi Wang, 20-Nov-2025.)
theorem cmdrcl (C D F X: class):
  $ wi (wcel X (cfv F (co C D ccmd))) (wcel F (co D C cfunc)) $;

--| The domain of ` ( C Limit D ) ` is a relation. (Contributed by Zhi Wang, 14-Nov-2025.)
theorem reldmlmd2 (C D: class):
  $ wrel (cdm (co C D clmd)) $;

--| The domain of ` ( C Colimit D ) ` is a relation. (Contributed by Zhi Wang, 13-Nov-2025.)
theorem reldmcmd2 (C D: class):
  $ wrel (cdm (co C D ccmd)) $;

--| The set of limits of a diagram. (Contributed by Zhi Wang, 14-Nov-2025.)
theorem lmdfval2 (C D F: class):
  $ wceq (cfv F (co C D clmd)) (co (cfv (co C D cdiag) coppf) F (co (cfv C coppc) (cfv (co D C cfuc) coppc) cup)) $;

--| The set of colimits of a diagram. (Contributed by Zhi Wang, 12-Nov-2025.)
theorem cmdfval2 (C D F: class):
  $ wceq (cfv F (co C D ccmd)) (co (co C D cdiag) F (co C (co D C cfuc) cup)) $;

--| If the categories have the same set of objects, morphisms, and compositions, then they have the same limits. (Contributed by Zhi Wang, 20-Nov-2025.)
theorem lmdpropd (ph: wff) (A2 B2 C D V: class):
  $ wi ph (wceq (cfv A2 chomf) (cfv B2 chomf)) $ >
  $ wi ph (wceq (cfv A2 ccomf) (cfv B2 ccomf)) $ >
  $ wi ph (wceq (cfv C chomf) (cfv D chomf)) $ >
  $ wi ph (wceq (cfv C ccomf) (cfv D ccomf)) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wceq (co A2 C clmd) (co B2 D clmd)) $;

--| If the categories have the same set of objects, morphisms, and compositions, then they have the same colimits. (Contributed by Zhi Wang, 20-Nov-2025.)
theorem cmdpropd (ph: wff) (A2 B2 C D V: class):
  $ wi ph (wceq (cfv A2 chomf) (cfv B2 chomf)) $ >
  $ wi ph (wceq (cfv A2 ccomf) (cfv B2 ccomf)) $ >
  $ wi ph (wceq (cfv C chomf) (cfv D chomf)) $ >
  $ wi ph (wceq (cfv C ccomf) (cfv D ccomf)) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wceq (co A2 C ccmd) (co B2 D ccmd)) $;

--| The set of limits of a diagram is a relation. (Contributed by Zhi Wang, 14-Nov-2025.)
theorem rellmd (C D F: class):
  $ wrel (cfv F (co C D clmd)) $;

--| The set of colimits of a diagram is a relation. (Contributed by Zhi Wang, 13-Nov-2025.)
theorem relcmd (C D F: class):
  $ wrel (cfv F (co C D ccmd)) $;

--| A natural transformation from a constant functor of an object maps to morphisms whose domain is the object. Therefore, the range of the second component of a cone are morphisms with a common domain. (Contributed by Zhi Wang, 13-Nov-2025.)
theorem concl (ph: wff) (A2 B2 C D R F H K L N X Y: class):
  $ wceq L (co C D cdiag) $ >
  $ wceq A2 (cfv C cbs) $ >
  $ wceq N (co D C cnat) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wceq K (cfv X (cfv L c1st)) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wcel R (co K F N)) $ >
  $ wi ph (wcel (cfv Y R) (co X (cfv Y (cfv F c1st)) H)) $;

--| A natural transformation to a constant functor of an object maps to morphisms whose codomain is the object. Therefore, the range of the second component of a co-cone are morphisms with a common codomain. (Contributed by Zhi Wang, 13-Nov-2025.)
theorem coccl (ph: wff) (A2 B2 C D R F H K L N X Y: class):
  $ wceq L (co C D cdiag) $ >
  $ wceq A2 (cfv C cbs) $ >
  $ wceq N (co D C cnat) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wceq K (cfv X (cfv L c1st)) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq H (cfv C chom) $ >
  $ wi ph (wcel R (co F K N)) $ >
  $ wi ph (wcel (cfv Y R) (co (cfv Y (cfv F c1st)) X H)) $;

--| A cone to a diagram commutes with the diagram. (Contributed by Zhi Wang, 13-Nov-2025.)
theorem concom (ph: wff) (A2 B2 C D R c_x F J K L M N X Y Z: class):
  $ wceq L (co C D cdiag) $ >
  $ wceq A2 (cfv C cbs) $ >
  $ wceq N (co D C cnat) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wceq K (cfv X (cfv L c1st)) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wcel M (co Y Z J)) $ >
  $ wceq J (cfv D chom) $ >
  $ wceq c_x (cfv C cco) $ >
  $ wi ph (wcel R (co K F N)) $ >
  $ wi ph (wceq (cfv Z R) (co (cfv M (co Y Z (cfv F c2nd))) (cfv Y R) (co (cop X (cfv Y (cfv F c1st))) (cfv Z (cfv F c1st)) c_x))) $;

--| A co-cone to a diagram commutes with the diagram. (Contributed by Zhi Wang, 13-Nov-2025.)
theorem coccom (ph: wff) (A2 B2 C D R c_x F J K L M N X Y Z: class):
  $ wceq L (co C D cdiag) $ >
  $ wceq A2 (cfv C cbs) $ >
  $ wceq N (co D C cnat) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wceq K (cfv X (cfv L c1st)) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wcel M (co Y Z J)) $ >
  $ wceq J (cfv D chom) $ >
  $ wceq c_x (cfv C cco) $ >
  $ wi ph (wcel R (co F K N)) $ >
  $ wi ph (wceq (cfv Y R) (co (cfv Z R) (cfv M (co Y Z (cfv F c2nd))) (co (cop (cfv Y (cfv F c1st)) (cfv Z (cfv F c1st))) X c_x))) $;

--| The universal property of limits of a diagram. (Contributed by Zhi Wang, 14-Nov-2025.)
theorem islmd {x3 j m a: setvar} (A2: class) (B2: class x3 m a) (C D R: class) (c_x: class x3 m a) (F: class) (H: class x3 a) (L N X: class):
  $ wceq L (co C D cdiag) $ >
  $ wceq A2 (cfv C cbs) $ >
  $ wceq N (co D C cnat) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wceq c_x (cfv C cco) $ >
  $ wb (wbr X R (cfv F (co C D clmd))) (wa (wa (wcel X A2) (wcel R (co (cfv X (cfv L c1st)) F N))) (wral x3 (wral a (wreu m (wceq (cv a) (cmpt j B2 (co (cfv (cv j) R) (cv m) (co (cop (cv x3) X) (cfv (cv j) (cfv F c1st)) c_x)))) (co (cv x3) X H)) (co (cfv (cv x3) (cfv L c1st)) F N)) A2)) $;

--| The universal property of colimits of a diagram. (Contributed by Zhi Wang, 13-Nov-2025.)
theorem iscmd {x3 j m a: setvar} (A2: class) (B2: class x3 m a) (C D R: class) (c_x: class x3 m a) (F H L N X: class):
  $ wceq L (co C D cdiag) $ >
  $ wceq A2 (cfv C cbs) $ >
  $ wceq N (co D C cnat) $ >
  $ wceq B2 (cfv D cbs) $ >
  $ wceq H (cfv C chom) $ >
  $ wceq c_x (cfv C cco) $ >
  $ wb (wbr X R (cfv F (co C D ccmd))) (wa (wa (wcel X A2) (wcel R (co F (cfv X (cfv L c1st)) N))) (wral x3 (wral a (wreu m (wceq (cv a) (cmpt j B2 (co (cv m) (cfv (cv j) R) (co (cop (cfv (cv j) (cfv F c1st)) X) (cv x3) c_x)))) (co X (cv x3) H)) (co F (cfv (cv x3) (cfv L c1st)) N)) A2)) $;

--| The duality of limits and colimits: limits of a diagram are colimits of an opposite diagram in opposite categories. (Contributed by Zhi Wang, 20-Nov-2025.)
theorem lmddu (ph: wff) (C D P F G O V W: class):
  $ wceq O (cfv C coppc) $ >
  $ wceq P (cfv D coppc) $ >
  $ wceq G (cfv F coppf) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wcel D W) $ >
  $ wi ph (wceq (cfv F (co C D clmd)) (cfv G (co O P ccmd))) $;

--| The duality of limits and colimits: colimits of a diagram are limits of an opposite diagram in opposite categories. (Contributed by Zhi Wang, 20-Nov-2025.)
theorem cmddu (ph: wff) (C D P F G O V W: class):
  $ wceq O (cfv C coppc) $ >
  $ wceq P (cfv D coppc) $ >
  $ wceq G (cfv F coppf) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wcel D W) $ >
  $ wi ph (wceq (cfv F (co C D ccmd)) (cfv G (co O P clmd))) $;

--| Initial objects are the object part of colimits of the empty diagram. (Contributed by Zhi Wang, 17-Nov-2025.)
theorem initocmd (C: class):
  $ wceq (cfv C cinito) (cdm (co c0 c0 (co C c0 ccmd))) $;

--| Terminal objects are the object part of limits of the empty diagram. (Contributed by Zhi Wang, 20-Nov-2025.)
theorem termolmd (C: class):
  $ wceq (cfv C ctermo) (cdm (co c0 c0 (co C c0 clmd))) $;

--| To each limit of a diagram there is a corresponding right Kan extention of the diagram along a functor to a terminal category. The morphism parts coincide, while the object parts are one-to-one correspondent ( ~ diag1f1o ). (Contributed by Zhi Wang, 26-Nov-2025.)
theorem lmdran (ph: wff) (C D c_1 F G L M X Y: class):
  $ wi ph (wcel c_1 ctermc) $ >
  $ wi ph (wcel G (co D c_1 cfunc)) $ >
  $ wceq L (co C c_1 cdiag) $ >
  $ wi ph (wceq Y (cfv X (cfv L c1st))) $ >
  $ wi ph (wb (wbr X M (cfv F (co C D clmd))) (wbr Y M (co G F (co (cop D c_1) C cran)))) $;

--| To each colimit of a diagram there is a corresponding left Kan extention of the diagram along a functor to a terminal category. The morphism parts coincide, while the object parts are one-to-one correspondent ( ~ diag1f1o ). (Contributed by Zhi Wang, 26-Nov-2025.)
theorem cmdlan (ph: wff) (C D c_1 F G L M X Y: class):
  $ wi ph (wcel c_1 ctermc) $ >
  $ wi ph (wcel G (co D c_1 cfunc)) $ >
  $ wceq L (co C c_1 cdiag) $ >
  $ wi ph (wceq Y (cfv X (cfv L c1st))) $ >
  $ wi ph (wb (wbr X M (cfv F (co C D ccmd))) (wbr Y M (co G F (co (cop D c_1) C clan)))) $;

--| Bound-variable hypothesis builder for intersection. (Contributed by Emmett Weisz, 16-Jan-2020.)
theorem nfintd {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wi ph (wnfc x3 A2) $ >
  $ wi ph (wnfc x3 (cint A2)) $;

--| Bound-variable hypothesis builder for indexed union. (Contributed by Emmett Weisz, 6-Dec-2019.) Add disjoint variable condition to avoid ~ ax-13 . See ~ nfiundg for a less restrictive version requiring more axioms. (Revised by GG, 20-Jan-2024.)
theorem nfiund {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ wnf x3 ph $ >
  $ wi ph (wnfc y1 A2) $ >
  $ wi ph (wnfc y1 B2) $ >
  $ wi ph (wnfc y1 (ciun x3 A2 B2)) $;

--| Bound-variable hypothesis builder for indexed union. Usage of this theorem is discouraged because it depends on ~ ax-13 , see ~ nfiund for a weaker version that does not require it. (Contributed by Emmett Weisz, 6-Dec-2019.) (New usage is discouraged.)
theorem nfiundg {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ wnf x3 ph $ >
  $ wi ph (wnfc y1 A2) $ >
  $ wi ph (wnfc y1 B2) $ >
  $ wi ph (wnfc y1 (ciun x3 A2 B2)) $;

--| The indexed union of a collection of ordinal numbers ` B ( x ) ` is ordinal. This proof is based on the proof of ~ ssorduni , but does not use it directly, since ~ ssorduni does not work when ` B ` is a proper class. (Contributed by Emmett Weisz, 3-Nov-2019.)
theorem iunord {x3: setvar} (A2: class) (B2: class x3):
  $ wi (wral x3 (word B2) A2) (word (ciun x3 A2 B2)) $;

--| The indexed union of a collection of ordinal numbers ` B ( x ) ` is ordinal. (Contributed by Emmett Weisz, 3-Nov-2019.)
theorem iunordi {x3: setvar} (A2: class) (B2: class x3):
  $ word B2 $ >
  $ word (ciun x3 A2 B2) $;

--| Specialization deduction, using implicit substitution. Based on the proof of ~ spimed . (Contributed by Emmett Weisz, 17-Jan-2020.)
theorem spd {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wi ch (wnf x3 ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi ch (wi (wal x3 ph) ps) $;

--| Transfinite Induction Schema, using implicit substitution. (Contributed by Emmett Weisz, 3-May-2020.)
theorem tfis2d {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1):
  $ wi ph (wi (wceq (cv x3) (cv y1)) (wb ps ch)) $ >
  $ wi ph (wi (wcel (cv x3) con0) (wi (wral y1 ch (cv x3)) ps)) $ >
  $ wi ph (wi (wcel (cv x3) con0) ps) $;

--| Equality theorem for set recursion. (Contributed by Emmett Weisz, 17-Feb-2021.)
theorem setrecseq (F G: class):
  $ wi (wceq F G) (wceq (csetrecs F) (csetrecs G)) $;

--| Bound-variable hypothesis builder for ` setrecs ` . (Contributed by Emmett Weisz, 21-Oct-2021.)
theorem nfsetrecs {x3: setvar} (F: class x3):
  $ wnfc x3 F $ >
  $ wnfc x3 (csetrecs F) $;

--| Version of ~ setrec2 where ` F ` is defined using maps-to notation. Deduction form is omitted in the second hypothesis for simplicity. In practice, nothing important is lost since we are only interested in one choice of ` A ` , ` S ` , and ` V ` at a time. However, we are interested in what happens when ` C ` varies, so deduction form is used in the third hypothesis. (Contributed by Emmett Weisz, 4-Jun-2024.)
theorem setrec2mpt {a: setvar} (ph: wff a) (A2: class) (B2: class a) (C: class) (S V: class a):
  $ wceq B2 (csetrecs (cmpt a A2 S)) $ >
  $ wi (wcel (cv a) A2) (wcel S V) $ >
  $ wi ph (wal a (wi (wss (cv a) C) (wss S C))) $ >
  $ wi ph (wss B2 C) $;

--| Version of ~ setrec2 expressed as an induction schema. This theorem is a generalization of ~ tfis3 . (Contributed by Emmett Weisz, 27-Feb-2022.)
theorem setis {a b: setvar} (ph: wff a b) (ps: wff b) (ch: wff a) (A2: class a) (B2: class a b) (F: class):
  $ wceq B2 (csetrecs F) $ >
  $ wi (wceq (cv b) A2) (wb ps ch) $ >
  $ wi ph (wal a (wi (wral b ps (cv a)) (wral b ps (cfv (cv a) F)))) $ >
  $ wi ph (wi (wcel A2 B2) ch) $;

--| Lemma for ~ elsetrecs . Any element of ` setrecs ( F ) ` is generated by some subset of ` setrecs ( F ) ` . This is much weaker than ~ setrec2v . To see why this lemma also requires ~ setrec1 , consider what would happen if we replaced ` B ` with ` { A } ` . The antecedent would still hold, but the consequent would fail in general. Consider dispensing with the deduction form. (Contributed by Emmett Weisz, 11-Jul-2021.) (New usage is discouraged.)
theorem elsetrecslem {x3: setvar} (A2 B2 F: class):
  $ wceq B2 (csetrecs F) $ >
  $ wi (wcel A2 B2) (wex x3 (wa (wss (cv x3) B2) (wcel A2 (cfv (cv x3) F)))) $;

--| A set ` A ` is an element of ` setrecs ( F ) ` iff ` A ` is generated by some subset of ` setrecs ( F ) ` . The proof requires both ~ setrec1 and ~ setrec2 , but this theorem is not strong enough to uniquely determine ` setrecs ( F ) ` . If ` F ` respects the subset relation, the theorem still holds if both occurrences of ` e. ` are replaced by ` C_ ` for a stronger version of the theorem. (Contributed by Emmett Weisz, 12-Jul-2021.)
theorem elsetrecs {x3: setvar} (A2 B2 F: class):
  $ wceq B2 (csetrecs F) $ >
  $ wb (wcel A2 B2) (wex x3 (wa (wss (cv x3) B2) (wcel A2 (cfv (cv x3) F)))) $;

--| The ` setrecs ` operator respects the subset relation between two functions ` F ` and ` G ` . (Contributed by Emmett Weisz, 13-Mar-2022.)
theorem setrecsss (ph: wff) (F G: class):
  $ wi ph (wfun G) $ >
  $ wi ph (wss F G) $ >
  $ wi ph (wss (csetrecs F) (csetrecs G)) $;

--| A recursively generated class is unaffected when its input function is restricted to subsets of the class. (Contributed by Emmett Weisz, 14-Mar-2022.)
theorem setrecsres (ph: wff) (B2 F: class):
  $ wceq B2 (csetrecs F) $ >
  $ wi ph (wfun F) $ >
  $ wi ph (wceq B2 (csetrecs (cres F (cpw B2)))) $;

--| Construct ` _V ` using set recursion. The proof indirectly uses ~ trcl , which relies on ` rec ` , but theoretically ` C ` in ~ trcl could be constructed using ` setrecs ` instead. The proof of this theorem uses the dummy variable ` a ` rather than ` x ` to avoid a distinct variable requirement between ` F ` and ` x ` . (Contributed by Emmett Weisz, 23-Jun-2021.)
theorem vsetrec {x3: setvar} (F: class x3):
  $ wceq F (cmpt x3 cvv (cpw (cv x3))) $ >
  $ wceq (csetrecs F) cvv $;

--| If a function sends the empty set to itself, the function will not recursively generate any sets, regardless of its other values. (Contributed by Emmett Weisz, 23-Jun-2021.)
theorem _0setrec (ph: wff) (F: class):
  $ wi ph (wceq (cfv c0 F) c0) $ >
  $ wi ph (wceq (csetrecs F) c0) $;

--| Lemma for ~ onsetrec . (Contributed by Emmett Weisz, 22-Jun-2021.) (New usage is discouraged.)
theorem onsetreclem1 {x3 a: setvar} (F: class x3 a):
  $ wceq F (cmpt x3 cvv (cpr (cuni (cv x3)) (csuc (cuni (cv x3))))) $ >
  $ wceq (cfv (cv a) F) (cpr (cuni (cv a)) (csuc (cuni (cv a)))) $;

--| Lemma for ~ onsetrec . (Contributed by Emmett Weisz, 22-Jun-2021.) (New usage is discouraged.)
theorem onsetreclem2 {x3 a: setvar} (F: class x3 a):
  $ wceq F (cmpt x3 cvv (cpr (cuni (cv x3)) (csuc (cuni (cv x3))))) $ >
  $ wi (wss (cv a) con0) (wss (cfv (cv a) F) con0) $;

--| Lemma for ~ onsetrec . (Contributed by Emmett Weisz, 22-Jun-2021.) (New usage is discouraged.)
theorem onsetreclem3 {x3 a: setvar} (F: class x3 a):
  $ wceq F (cmpt x3 cvv (cpr (cuni (cv x3)) (csuc (cuni (cv x3))))) $ >
  $ wi (wcel (cv a) con0) (wcel (cv a) (cfv (cv a) F)) $;

--| Construct ` On ` using set recursion. When ` x e. On ` , the function ` F ` constructs the least ordinal greater than any of the elements of ` x ` , which is ` U. x ` for a limit ordinal and ` suc U. x ` for a successor ordinal. For example, ` ( F `` { 1o , 2o } ) ` ` = { U. { 1o , 2o } , suc U. { 1o , 2o } } = { 2o , 3o } ` which contains ` 3o ` , and ` ( F `` _om ) = { U. _om , suc U. _om } = { _om , _om +o 1o } ` , which contains ` _om ` . If we start with the empty set and keep applying ` F ` transfinitely many times, all ordinal numbers will be generated. Any function ` F ` fulfilling lemmas ~ onsetreclem2 and ~ onsetreclem3 will recursively generate ` On ` ; for example, ` F = ( x e. _V |-> suc suc U. x } ) ` also works. Whether this function or the function in the theorem is used, taking this theorem as a definition of ` On ` is unsatisfying because it relies on the different properties of limit and successor ordinals. A different approach could be to let ` F = ( x e. _V |-> { y e. ~P x | Tr y } ) ` , based on ~ dfon2 . The proof of this theorem uses the dummy variable ` a ` rather than ` x ` to avoid a distinct variable condition between ` F ` and ` x ` . (Contributed by Emmett Weisz, 22-Jun-2021.)
theorem onsetrec {x3: setvar} (F: class x3):
  $ wceq F (cmpt x3 cvv (cpr (cuni (cv x3)) (csuc (cuni (cv x3))))) $ >
  $ wceq (csetrecs F) con0 $;

--| Extend class notation to include the class of partisan game forms.
term cpg: class;

--| Define the class of partisan games. More precisely, this is the class of partisan game forms, many of which represent equal partisan games. In Metamath, equality between partisan games is represented by a different equivalence relation than class equality. (Contributed by Emmett Weisz, 22-Aug-2021.)
axiom df_pg {x3: setvar}:
  $ wceq cpg (csetrecs (cmpt x3 cvv (cxp (cpw (cv x3)) (cpw (cv x3))))) $;

--| Lemma for ~ elpg . (Contributed by Emmett Weisz, 28-Aug-2021.)
theorem elpglem1 {x3: setvar} (A2: class):
  $ wi (wex x3 (wa (wss (cv x3) cpg) (wa (wcel (cfv A2 c1st) (cpw (cv x3))) (wcel (cfv A2 c2nd) (cpw (cv x3)))))) (wa (wss (cfv A2 c1st) cpg) (wss (cfv A2 c2nd) cpg)) $;

--| Lemma for ~ elpg . (Contributed by Emmett Weisz, 28-Aug-2021.)
theorem elpglem2 {x3: setvar} (A2: class):
  $ wi (wa (wss (cfv A2 c1st) cpg) (wss (cfv A2 c2nd) cpg)) (wex x3 (wa (wss (cv x3) cpg) (wa (wcel (cfv A2 c1st) (cpw (cv x3))) (wcel (cfv A2 c2nd) (cpw (cv x3)))))) $;

--| Lemma for ~ elpg . (Contributed by Emmett Weisz, 28-Aug-2021.)
theorem elpglem3 {x3 y1: setvar} (A2: class y1):
  $ wb (wex x3 (wa (wss (cv x3) cpg) (wcel A2 (cfv (cv x3) (cmpt y1 cvv (cxp (cpw (cv y1)) (cpw (cv y1)))))))) (wa (wcel A2 (cxp cvv cvv)) (wex x3 (wa (wss (cv x3) cpg) (wa (wcel (cfv A2 c1st) (cpw (cv x3))) (wcel (cfv A2 c2nd) (cpw (cv x3))))))) $;

--| Membership in the class of partisan games. In John Horton Conway's On Numbers and Games, this is stated as "If ` L ` and ` R ` are any two sets of games, then there is a game ` { L | R } ` . All games are constructed in this way." The first sentence corresponds to the backward direction of our theorem, and the second to the forward direction. (Contributed by Emmett Weisz, 27-Aug-2021.)
theorem elpg (A2: class):
  $ wb (wcel A2 cpg) (w3a (wcel A2 (cxp cvv cvv)) (wss (cfv A2 c1st) cpg) (wss (cfv A2 c2nd) cpg)) $;

--| Lemma for ~ pgind . (Contributed by Emmett Weisz, 27-May-2024.) (New usage is discouraged.)
theorem pgindlem (x3 z: setvar):
  $ wi (wcel (cv x3) (cxp (cpw (cv z)) (cpw (cv z)))) (wss (cun (cfv (cv x3) c1st) (cfv (cv x3) c2nd)) (cv z)) $;

--| Version of ~ pgind with extraneous not-free requirements. (Contributed by Emmett Weisz, 27-May-2024.) (New usage is discouraged.)
theorem pgindnf {x3 y1: setvar} (ph: wff x3 y1) (ps: wff x3) (ch: wff y1) (th: wff x3) (A2: class x3):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ps ch) $ >
  $ wi (wceq (cv y1) A2) (wb ch th) $ >
  $ wi ph (wal x3 (wi (wral y1 ch (cun (cfv (cv x3) c1st) (cfv (cv x3) c2nd))) ps)) $ >
  $ wi ph (wi (wcel A2 cpg) th) $;

--| Induction on partizan games. (Contributed by Emmett Weisz, 27-May-2024.)
theorem pgind {x3 y1: setvar} (ph: wff x3 y1) (ps: wff x3) (ch: wff y1) (th: wff x3) (A2: class x3):
  $ wi (wceq (cv x3) (cv y1)) (wb ps ch) $ >
  $ wi (wceq (cv y1) A2) (wb ch th) $ >
  $ wi ph (wal x3 (wi (wral y1 ch (cun (cfv (cv x3) c1st) (cfv (cv x3) c2nd))) ps)) $ >
  $ wi ph (wi (wcel A2 cpg) th) $;

--| An identity theorem for substitution. See ~ sbid . See Remark 9.1 in [Megill] p. 447 (p. 15 of the preprint). (Contributed by DAW, 18-Feb-2017.)
theorem sbidd {x3: setvar} (ph ps: wff x3):
  $ wi ph (wsb x3 ps x3) $ >
  $ wi ph ps $;

--| An identity theorem for substitution. See ~ sbid . See Remark 9.1 in [Megill] p. 447 (p. 15 of the preprint). (Contributed by DAW, 18-Feb-2017.)
theorem sbidd_misc {x3: setvar} (ph ps: wff x3):
  $ wb (wi ph (wsb x3 ps x3)) (wi ph ps) $;

--| Extend wff notation to include the 'greater than or equal to' relation, see ~ df-gte .
term cge_real: class;

--| Extend wff notation to include the 'greater than' relation, see ~ df-gt .
term cgt: class;

--| Define the 'greater than or equal' predicate over the reals. Defined in ISO 80000-2:2009(E) operation 2-7.10. It is used as a primitive in the "NIST Digital Library of Mathematical Functions" , front introduction, "Common Notations and Definitions" section at ~ http://dlmf.nist.gov/front/introduction#Sx4 . This relation is merely the converse of the 'less than or equal to' relation defined by ~ df-le . We do not write this as ` ( x >_ y <-> y <_ x ) ` , and similarly we do not write `` > `` as ` ( x > y <-> y < x ) ` , because these are not definitional axioms as understood by mmj2 (those definitions will be flagged as being "potentially non-conservative"). We could write them this way: ` |- > = { <. x , y >. | ( ( x e. RR* /\ y e. RR* ) /\ y < x ) } ` and ` |- >_ = { <. x , y >. | ( ( x e. RR* /\ y e. RR* ) /\ y <_ x ) } ` but these are very complicated. This definition of ` >_ ` , and the similar one for ` > ` ( ~ df-gt ), are a bit strange when you see them for the first time, but these definitions are much simpler for us to process and are clearly conservative definitions. (My thanks to Mario Carneiro for pointing out this simpler approach.) See ~ gte-lte for a more conventional expression of the relationship between ` < ` and ` > ` . As a stylistic issue, set.mm prefers 'less than' instead of 'greater than' to reduce the number of conversion steps. Thus, we discourage its use, but include its definition so that there _is_ a formal definition of this symbol. (Contributed by David A. Wheeler, 10-May-2015.) (New usage is discouraged.)
axiom df_gte:
  $ wceq cge_real (ccnv cle) $;

--| The 'greater than' relation is merely the converse of the 'less than or equal to' relation defined by ~ df-lt . Defined in ISO 80000-2:2009(E) operation 2-7.12. See ~ df-gte for a discussion on why this approach is used for the definition. See ~ gt-lt and ~ gt-lth for more conventional expression of the relationship between ` < ` and ` > ` . As a stylistic issue, set.mm prefers 'less than or equal' instead of 'greater than or equal' to reduce the number of conversion steps. Thus, we discourage its use, but include its definition so that there _is_ a formal definition of this symbol. (Contributed by David A. Wheeler, 19-Apr-2015.) (New usage is discouraged.)
axiom df_gt:
  $ wceq cgt (ccnv clt) $;

--| Simple relationship between ` <_ ` and ` >_ ` . (Contributed by David A. Wheeler, 10-May-2015.) (New usage is discouraged.)
theorem gte_lte (A2 B2: class):
  $ wi (wa (wcel A2 cvv) (wcel B2 cvv)) (wb (wbr A2 B2 cge_real) (wbr B2 A2 cle)) $;

--| Simple relationship between ` < ` and ` > ` . (Contributed by David A. Wheeler, 19-Apr-2015.) (New usage is discouraged.)
theorem gt_lt (A2 B2: class):
  $ wi (wa (wcel A2 cvv) (wcel B2 cvv)) (wb (wbr A2 B2 cgt) (wbr B2 A2 clt)) $;

--| Relationship between ` <_ ` and ` >_ ` using hypotheses. (Contributed by David A. Wheeler, 10-May-2015.) (New usage is discouraged.)
theorem gte_lteh (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wb (wbr A2 B2 cge_real) (wbr B2 A2 cle) $;

--| Relationship between ` < ` and ` > ` using hypotheses. (Contributed by David A. Wheeler, 19-Apr-2015.) (New usage is discouraged.)
theorem gt_lth (A2 B2: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wb (wbr A2 B2 cgt) (wbr B2 A2 clt) $;

--| Simple example of ` > ` , in this case, 0 is not greater than 0. This is useful as an example, and helps us gain confidence that we've correctly defined the symbol. (Contributed by David A. Wheeler, 1-Jan-2017.) (New usage is discouraged.)
theorem ex_gt:
  $ wn (wbr cc0 cc0 cgt) $;

--| Simple example of ` >_ ` , in this case, 0 is greater than or equal to 0. This is useful as an example, and helps us gain confidence that we've correctly defined the symbol. (Contributed by David A. Wheeler, 1-Jan-2017.) (New usage is discouraged.)
theorem ex_gte:
  $ wbr cc0 cc0 cge_real $;

--| Extend class notation to include the hyperbolic sine function, see ~ df-sinh .
term csinh: class;

--| Extend class notation to include the hyperbolic cosine function. see ~ df-cosh .
term ccosh: class;

--| Extend class notation to include the hyperbolic tangent function, see ~ df-tanh .
term ctanh: class;

--| Define the hyperbolic sine function (sinh). We define it this way for ~ cmpt , which requires the form ` ( x e. A |-> B ) ` . See ~ sinhval-named for a simple way to evaluate it. We define this function by dividing by ` _i ` , which uses fewer operations than many conventional definitions (and thus is more convenient to use in set.mm). See ~ sinh-conventional for a justification that our definition is the same as the conventional definition of sinh used in other sources. (Contributed by David A. Wheeler, 20-Apr-2015.)
axiom df_sinh {x3: setvar}:
  $ wceq csinh (cmpt x3 cc (co (cfv (co ci (cv x3) cmul) csin) ci cdiv)) $;

--| Define the hyperbolic cosine function (cosh). We define it this way for ~ cmpt , which requires the form ` ( x e. A |-> B ) ` . (Contributed by David A. Wheeler, 10-May-2015.)
axiom df_cosh {x3: setvar}:
  $ wceq ccosh (cmpt x3 cc (cfv (co ci (cv x3) cmul) ccos)) $;

--| Define the hyperbolic tangent function (tanh). We define it this way for ~ cmpt , which requires the form ` ( x e. A |-> B ) ` . (Contributed by David A. Wheeler, 10-May-2015.)
axiom df_tanh {x3: setvar}:
  $ wceq ctanh (cmpt x3 (cima (ccnv ccosh) (cdif cc (csn cc0))) (co (cfv (co ci (cv x3) cmul) ctan) ci cdiv)) $;

--| Value of the named sinh function. Here we show the simple conversion to the conventional form used in set.mm, using the definition given by ~ df-sinh . See ~ sinhval for a theorem to convert this further. See ~ sinh-conventional for a justification that our definition is the same as the conventional definition of sinh used in other sources. (Contributed by David A. Wheeler, 20-Apr-2015.)
theorem sinhval_named (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv A2 csinh) (co (cfv (co ci A2 cmul) csin) ci cdiv)) $;

--| Value of the named cosh function. Here we show the simple conversion to the conventional form used in set.mm, using the definition given by ~ df-cosh . See ~ coshval for a theorem to convert this further. (Contributed by David A. Wheeler, 10-May-2015.)
theorem coshval_named (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv A2 ccosh) (cfv (co ci A2 cmul) ccos)) $;

--| Value of the named tanh function. Here we show the simple conversion to the conventional form used in set.mm, using the definition given by ~ df-tanh . (Contributed by David A. Wheeler, 10-May-2015.)
theorem tanhval_named (A2: class):
  $ wi (wcel A2 (cima (ccnv ccosh) (cdif cc (csn cc0)))) (wceq (cfv A2 ctanh) (co (cfv (co ci A2 cmul) ctan) ci cdiv)) $;

--| Conventional definition of sinh. Here we show that the sinh definition we're using has the same meaning as the conventional definition used in some other sources. We choose a slightly different definition of sinh because it has fewer operations, and thus is more convenient to manipulate using set.mm. (Contributed by David A. Wheeler, 10-May-2015.)
theorem sinh_conventional (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv A2 csinh) (co (cneg ci) (cfv (co ci A2 cmul) csin) cmul)) $;

--| Prove that ` ( sinh `` A ) + ( cosh `` A ) = ( exp `` A ) ` using the conventional hyperbolic trigonometric functions. (Contributed by David A. Wheeler, 27-May-2015.)
theorem sinhpcosh (A2: class):
  $ wi (wcel A2 cc) (wceq (co (cfv A2 csinh) (cfv A2 ccosh) caddc) (cfv A2 ce)) $;

--| Extend class notation to include the secant function, see ~ df-sec .
term csec: class;

--| Extend class notation to include the cosecant function, see ~ df-csc .
term ccsc: class;

--| Extend class notation to include the cotangent function, see ~ df-cot .
term ccot: class;

--| Define the secant function. We define it this way for ~ cmpt , which requires the form ` ( x e. A |-> B ) ` . The sec function is defined in ISO 80000-2:2009(E) operation 2-13.6 and "NIST Digital Library of Mathematical Functions" section on "Trigonometric Functions" ~ http://dlmf.nist.gov/4.14 . (Contributed by David A. Wheeler, 14-Mar-2014.)
axiom df_sec {x3 y1: setvar}:
  $ wceq csec (cmpt x3 (crab y1 (wne (cfv (cv y1) ccos) cc0) cc) (co c1 (cfv (cv x3) ccos) cdiv)) $;

--| Define the cosecant function. We define it this way for ~ cmpt , which requires the form ` ( x e. A |-> B ) ` . The csc function is defined in ISO 80000-2:2009(E) operation 2-13.7 and "NIST Digital Library of Mathematical Functions" section on "Trigonometric Functions" ~ http://dlmf.nist.gov/4.14 . (Contributed by David A. Wheeler, 14-Mar-2014.)
axiom df_csc {x3 y1: setvar}:
  $ wceq ccsc (cmpt x3 (crab y1 (wne (cfv (cv y1) csin) cc0) cc) (co c1 (cfv (cv x3) csin) cdiv)) $;

--| Define the cotangent function. We define it this way for ~ cmpt , which requires the form ` ( x e. A |-> B ) ` . The cot function is defined in ISO 80000-2:2009(E) operation 2-13.5 and "NIST Digital Library of Mathematical Functions" section on "Trigonometric Functions" ~ http://dlmf.nist.gov/4.14 . (Contributed by David A. Wheeler, 14-Mar-2014.)
axiom df_cot {x3 y1: setvar}:
  $ wceq ccot (cmpt x3 (crab y1 (wne (cfv (cv y1) csin) cc0) cc) (co (cfv (cv x3) ccos) (cfv (cv x3) csin) cdiv)) $;

--| Value of the secant function. (Contributed by David A. Wheeler, 14-Mar-2014.)
theorem secval (A2: class):
  $ wi (wa (wcel A2 cc) (wne (cfv A2 ccos) cc0)) (wceq (cfv A2 csec) (co c1 (cfv A2 ccos) cdiv)) $;

--| Value of the cosecant function. (Contributed by David A. Wheeler, 14-Mar-2014.)
theorem cscval (A2: class):
  $ wi (wa (wcel A2 cc) (wne (cfv A2 csin) cc0)) (wceq (cfv A2 ccsc) (co c1 (cfv A2 csin) cdiv)) $;

--| Value of the cotangent function. (Contributed by David A. Wheeler, 14-Mar-2014.)
theorem cotval (A2: class):
  $ wi (wa (wcel A2 cc) (wne (cfv A2 csin) cc0)) (wceq (cfv A2 ccot) (co (cfv A2 ccos) (cfv A2 csin) cdiv)) $;

--| The closure of the secant function with a complex argument. (Contributed by David A. Wheeler, 14-Mar-2014.)
theorem seccl (A2: class):
  $ wi (wa (wcel A2 cc) (wne (cfv A2 ccos) cc0)) (wcel (cfv A2 csec) cc) $;

--| The closure of the cosecant function with a complex argument. (Contributed by David A. Wheeler, 14-Mar-2014.)
theorem csccl (A2: class):
  $ wi (wa (wcel A2 cc) (wne (cfv A2 csin) cc0)) (wcel (cfv A2 ccsc) cc) $;

--| The closure of the cotangent function with a complex argument. (Contributed by David A. Wheeler, 15-Mar-2014.)
theorem cotcl (A2: class):
  $ wi (wa (wcel A2 cc) (wne (cfv A2 csin) cc0)) (wcel (cfv A2 ccot) cc) $;

--| The closure of the secant function with a real argument. (Contributed by David A. Wheeler, 15-Mar-2014.)
theorem reseccl (A2: class):
  $ wi (wa (wcel A2 cr) (wne (cfv A2 ccos) cc0)) (wcel (cfv A2 csec) cr) $;

--| The closure of the cosecant function with a real argument. (Contributed by David A. Wheeler, 15-Mar-2014.)
theorem recsccl (A2: class):
  $ wi (wa (wcel A2 cr) (wne (cfv A2 csin) cc0)) (wcel (cfv A2 ccsc) cr) $;

--| The closure of the cotangent function with a real argument. (Contributed by David A. Wheeler, 15-Mar-2014.)
theorem recotcl (A2: class):
  $ wi (wa (wcel A2 cr) (wne (cfv A2 csin) cc0)) (wcel (cfv A2 ccot) cr) $;

--| The reciprocal of secant is cosine. (Contributed by David A. Wheeler, 14-Mar-2014.)
theorem recsec (A2: class):
  $ wi (wa (wcel A2 cc) (wne (cfv A2 ccos) cc0)) (wceq (cfv A2 ccos) (co c1 (cfv A2 csec) cdiv)) $;

--| The reciprocal of cosecant is sine. (Contributed by David A. Wheeler, 14-Mar-2014.)
theorem reccsc (A2: class):
  $ wi (wa (wcel A2 cc) (wne (cfv A2 csin) cc0)) (wceq (cfv A2 csin) (co c1 (cfv A2 ccsc) cdiv)) $;

--| The reciprocal of cotangent is tangent. (Contributed by David A. Wheeler, 21-Mar-2014.)
theorem reccot (A2: class):
  $ wi (w3a (wcel A2 cc) (wne (cfv A2 csin) cc0) (wne (cfv A2 ccos) cc0)) (wceq (cfv A2 ctan) (co c1 (cfv A2 ccot) cdiv)) $;

--| The reciprocal of tangent is cotangent. (Contributed by David A. Wheeler, 21-Mar-2014.)
theorem rectan (A2: class):
  $ wi (w3a (wcel A2 cc) (wne (cfv A2 csin) cc0) (wne (cfv A2 ccos) cc0)) (wceq (cfv A2 ccot) (co c1 (cfv A2 ctan) cdiv)) $;

--| The value of the secant function at zero is one. (Contributed by David A. Wheeler, 16-Mar-2014.)
theorem sec0:
  $ wceq (cfv cc0 csec) c1 $;

--| Prove the tangent squared secant squared identity ` ( 1 + ( ( tan `` A ) ^ 2 ) ) = ( ( sec `` A ) ^ 2 ) ) ` . (Contributed by David A. Wheeler, 25-May-2015.)
theorem onetansqsecsq (A2: class):
  $ wi (wa (wcel A2 cc) (wne (cfv A2 ccos) cc0)) (wceq (co c1 (co (cfv A2 ctan) c2 cexp) caddc) (co (cfv A2 csec) c2 cexp)) $;

--| Prove the tangent squared cosecant squared identity ` ( 1 + ( ( cot `` A ) ^ 2 ) ) = ( ( csc `` A ) ^ 2 ) ) ` . (Contributed by David A. Wheeler, 27-May-2015.)
theorem cotsqcscsq (A2: class):
  $ wi (wa (wcel A2 cc) (wne (cfv A2 csin) cc0)) (wceq (co c1 (co (cfv A2 ccot) c2 cexp) caddc) (co (cfv A2 ccsc) c2 cexp)) $;

--| Derivative of the secant function. (Contributed by Jon Pennant, 28-Aug-2026.)
theorem dvsec {x3: setvar}:
  $ wceq (co cc csec cdv) (cmpt x3 (cdm csec) (co (cfv (cv x3) csec) (cfv (cv x3) ctan) cmul)) $;

--| Derivative of the cosecant function. (Contributed by Jon Pennant, 28-Aug-2026.)
theorem dvcsc {x3: setvar}:
  $ wceq (co cc ccsc cdv) (cmpt x3 (cdm ccsc) (co (cneg (cfv (cv x3) ccsc)) (cfv (cv x3) ccot) cmul)) $;

--| Derivative of the cotangent function. (Contributed by Jon Pennant, 28-Aug-2026.)
theorem dvcot {x3: setvar}:
  $ wceq (co cc ccot cdv) (cmpt x3 (cdm ccot) (cneg (co (cfv (cv x3) ccsc) c2 cexp))) $;

--| If A is not a member of B, but an "if" condition requires it, then the "false" branch results. This is a simple utility to provide a slight shortening and simplification of proofs versus applying ~ iffalse directly in this case. (Contributed by David A. Wheeler, 15-May-2015.)
theorem ifnmfalse (A2 B2 C D: class):
  $ wi (wnel A2 B2) (wceq (cif (wcel A2 B2) C D) D) $;

--| Define the value of the ` logb ` function, the logarithm generalized to an arbitrary base, when used in the 2-argument form ` logb <. B , X >. ` (Contributed by David A. Wheeler, 21-Jan-2017.) (Revised by David A. Wheeler, 16-Jul-2017.)
theorem logb2aval (B2 X: class):
  $ wi (wa (wcel B2 (cdif cc (cpr cc0 c1))) (wcel X (cdif cc (csn cc0)))) (wceq (cfv (cop B2 X) clogb) (co (cfv X clog) (cfv B2 clog) cdiv)) $;

--| Extend class notation to include the logarithm generalized to an arbitrary base.
term clog_: class;

--| Define the ` log_ ` operator. This is the logarithm generalized to an arbitrary base. It can be used as ` ( ( log_ `` B ) `` X ) ` for "log base B of X". This formulation suggested by Mario Carneiro. (Contributed by David A. Wheeler, 14-Jul-2017.) (New usage is discouraged.)
axiom df_logbALT {x3 b: setvar}:
  $ wceq clog_ (cmpt b (cdif cc (cpr cc0 c1)) (cmpt x3 (cdif cc (csn cc0)) (co (cfv (cv x3) clog) (cfv (cv b) clog) cdiv))) $;

--| Extend wff definition to include "Reflexive" applied to a class, which is true iff class R is a reflexive relation over the set A. See ~ df-reflexive . (Contributed by David A. Wheeler, 1-Dec-2019.)
term wreflexive (A2 R: class): wff;

--| Define reflexive relation; relation ` R ` is reflexive over the set ` A ` iff ` A. x e. A x R x ` . (Contributed by David A. Wheeler, 1-Dec-2019.)
axiom df_reflexive {x3: setvar} (A2 R: class):
  $ wb (wreflexive A2 R) (wa (wss R (cxp A2 A2)) (wral x3 (wbr (cv x3) (cv x3) R) A2)) $;

--| Extend wff definition to include "Irreflexive" applied to a class, which is true iff class R is an irreflexive relation over the set A. See ~ df-irreflexive . (Contributed by David A. Wheeler, 1-Dec-2019.)
term wirreflexive (A2 R: class): wff;

--| Define irreflexive relation; relation ` R ` is irreflexive over the set ` A ` iff ` A. x e. A -. x R x ` . Note that a relation can be neither reflexive nor irreflexive. (Contributed by David A. Wheeler, 1-Dec-2019.)
axiom df_irreflexive {x3: setvar} (A2 R: class):
  $ wb (wirreflexive A2 R) (wa (wss R (cxp A2 A2)) (wral x3 (wn (wbr (cv x3) (cv x3) R)) A2)) $;

--| Move the right term in a sum on the LHS to the RHS. (Contributed by David A. Wheeler, 11-Oct-2018.)
theorem mvlraddi (A2 B2 C: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wceq (co A2 B2 caddc) C $ >
  $ wceq A2 (co C B2 cmin) $;

--| Associate RHS addition-subtraction. (Contributed by David A. Wheeler, 11-Oct-2018.)
theorem assraddsubi (A2 B2 C D: class):
  $ wcel B2 cc $ >
  $ wcel C cc $ >
  $ wcel D cc $ >
  $ wceq A2 (co (co B2 C caddc) D cmin) $ >
  $ wceq A2 (co B2 (co C D cmin) caddc) $;

--| Join AB+CB into (A+C) on LHS. (Contributed by David A. Wheeler, 26-Oct-2019.)
theorem joinlmuladdmuli (A2 B2 C D: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wcel C cc $ >
  $ wceq (co (co A2 B2 cmul) (co C B2 cmul) caddc) D $ >
  $ wceq (co (co A2 C caddc) B2 cmul) D $;

--| Join AB-CB into (A-C) on LHS. (Contributed by David A. Wheeler, 15-Oct-2018.)
theorem joinlmulsubmuld (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wceq (co (co A2 B2 cmul) (co C B2 cmul) cmin) D) $ >
  $ wi ph (wceq (co (co A2 C cmin) B2 cmul) D) $;

--| Join AB-CB into (A-C) on LHS. (Contributed by David A. Wheeler, 11-Oct-2018.)
theorem joinlmulsubmuli (A2 B2 C D: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wcel C cc $ >
  $ wceq (co (co A2 B2 cmul) (co C B2 cmul) cmin) D $ >
  $ wceq (co (co A2 C cmin) B2 cmul) D $;

--| Move the right term in a product on the LHS to the RHS, deduction form. (Contributed by David A. Wheeler, 11-Oct-2018.)
theorem mvlrmuld (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wne B2 cc0) $ >
  $ wi ph (wceq (co A2 B2 cmul) C) $ >
  $ wi ph (wceq A2 (co C B2 cdiv)) $;

--| Move the right term in a product on the LHS to the RHS, inference form. (Contributed by David A. Wheeler, 11-Oct-2018.)
theorem mvlrmuli (A2 B2 C: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wne B2 cc0 $ >
  $ wceq (co A2 B2 cmul) C $ >
  $ wceq A2 (co C B2 cdiv) $;

--| Solve for the intersection of two lines expressed in Y = MX+B form (note that the lines cannot be vertical). Here we use inference form. We just solve for X, since Y can be trivially found by using X. This is an example of how to use the algebra helpers. Notice that because this proof uses algebra helpers, the main steps of the proof are higher level and easier to follow by a human reader. (Contributed by David A. Wheeler, 11-Oct-2018.)
theorem i2linesi (A2 B2 C D X Y: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wcel C cc $ >
  $ wcel D cc $ >
  $ wcel X cc $ >
  $ wceq Y (co (co A2 X cmul) B2 caddc) $ >
  $ wceq Y (co (co C X cmul) D caddc) $ >
  $ wne (co A2 C cmin) cc0 $ >
  $ wceq X (co (co D B2 cmin) (co A2 C cmin) cdiv) $;

--| Solve for the intersection of two lines expressed in Y = MX+B form (note that the lines cannot be vertical). Here we use deduction form. We just solve for X, since Y can be trivially found by using X. This is an example of how to use the algebra helpers. Notice that because this proof uses algebra helpers, the main steps of the proof are higher level and easier to follow by a human reader. (Contributed by David A. Wheeler, 15-Oct-2018.)
theorem i2linesd (ph: wff) (A2 B2 C D X Y: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wcel D cc) $ >
  $ wi ph (wcel X cc) $ >
  $ wi ph (wceq Y (co (co A2 X cmul) B2 caddc)) $ >
  $ wi ph (wceq Y (co (co C X cmul) D caddc)) $ >
  $ wi ph (wne (co A2 C cmin) cc0) $ >
  $ wi ph (wceq X (co (co D B2 cmin) (co A2 C cmin) cdiv)) $;

--| Demonstrate that when using "for all" and material implication the consequent can be both always true and always false if there is no case where the antecedent is true. Those inexperienced with formal notations of classical logic can be surprised with what "for all" and material implication do together when the implication's antecedent is never true. This can happen, for example, when the antecedent is set membership but the set is the empty set (e.g., ` x e. M ` and ` M = (/) ` ). This is perhaps best explained using an example. The sentence "All Martians are green" would typically be represented formally using the expression ` A. x ( ph -> ps ) ` . In this expression ` ph ` is true iff ` x ` is a Martian and ` ps ` is true iff ` x ` is green. Similarly, "All Martians are not green" would typically be represented as ` A. x ( ph -> -. ps ) ` . However, if there are no Martians ( ` -. E. x ph ` ), then both of those expressions are _true_. That is surprising to the inexperienced, because the two expressions seem to be the opposite of each other. The reason this occurs is because in classical logic the implication ` ( ph -> ps ) ` is equivalent to ` -. ph \/ ps ` (as proven in ~ imor ). When ` ph ` is always false, ` -. ph ` is always true, and an _or_ with true is always true. Here are a few technical notes. In this notation, ` ph ` and ` ps ` are predicates that return a true or false value and may depend on ` x ` . We only say _may_ because it actually doesn't matter for our proof. In Metamath this simply means that we do not require that ` ph ` , ` ps ` , and ` x ` be distinct (so ` x ` can be part of ` ph ` or ` ps ` ). In natural language the term "implies" often presumes that the antecedent _can_ occur in at one least circumstance _and_ that there is some sort of causality. However, exactly what causality means is complex and situation-dependent. Modern logic typically uses material implication instead; this has a rigorous definition, but it is important for new users of formal notation to precisely understand it. There are ways to solve this, e.g., expressly stating that the antecedent exists (see ~ alimp-no-surprise ) or using the allsome quantifier ( ~ df-als ) . For other "surprises" for new users of classical logic, see ~ empty-surprise and ~ eximp-surprise . (Contributed by David A. Wheeler, 17-Oct-2018.)
theorem alimp_surprise {x3: setvar} (ph ps: wff x3):
  $ wn (wex x3 ph) $ >
  $ wa (wal x3 (wi ph ps)) (wal x3 (wi ph (wn ps))) $;

--| There is no "surprise" in a for-all with implication if there exists a value where the antecedent is true. This is one way to prevent for-all with implication from allowing anything. For a contrast, see ~ alimp-surprise . The allsome quantifier also counters this problem, see ~ df-als . (Contributed by David A. Wheeler, 27-Oct-2018.)
theorem alimp_no_surprise {x3: setvar} (ph ps: wff x3):
  $ wn (w3a (wal x3 (wi ph ps)) (wal x3 (wi ph (wn ps))) (wex x3 ph)) $;

--| Demonstrate that when using restricted "for all" over a class the expression can be both always true and always false if the class is empty. Those inexperienced with formal notations of classical logic can be surprised with what restricted "for all" does over an empty set. It is important to note that ` A. x e. A ph ` is simply an abbreviation for ` A. x ( x e. A -> ph ) ` (per ~ df-ral ). Thus, if ` A ` is the empty set, this expression is _always_ true regardless of the value of ` ph ` (see ~ alimp-surprise ). If you want the expression ` A. x e. A ph ` to not be vacuously true, you need to ensure that set ` A ` is inhabited (e.g., ` E. x e. A ` ). (Technical note: You can also assert that ` A =/= (/) ` ; this is an equivalent claim in classical logic as proven in ~ n0 , but in intuitionistic logic the statement ` A =/= (/) ` is a weaker claim than ` E. x e. A ` .) Some materials on logic (particularly those that discuss "syllogisms") are based on the much older work by Aristotle, but Aristotle expressly excluded empty sets from his system. Aristotle had a specific goal; he was trying to develop a "companion-logic" for science. He relegates fictions like fairy godmothers and mermaids and unicorns to the realms of poetry and literature... This is why he leaves no room for such nonexistent entities in his logic." (Groarke, "Aristotle: Logic", section 7. (Existential Assumptions), _Internet Encyclopedia of Philosophy_, ~ http://www.iep.utm.edu/aris-log/ ). While this made sense for his purposes, it is less flexible than modern (classical) logic which _does_ permit empty sets. If you wish to make claims that require a nonempty set, you must expressly include that requirement, e.g., by stating ` E. x ph ` . Examples of proofs that do this include ~ barbari , ~ celaront , and ~ cesaro . For another "surprise" for new users of classical logic, see ~ alimp-surprise and ~ eximp-surprise . (Contributed by David A. Wheeler, 20-Oct-2018.)
theorem empty_surprise {x3: setvar} (ph: wff x3) (A2: class x3):
  $ wn (wex x3 (wcel (cv x3) A2)) $ >
  $ wral x3 ph A2 $;

--| "Prove" that false is true when using a restricted "for all" over the empty set, to demonstrate that the expression is always true if the value ranges over the empty set. Those inexperienced with formal notations of classical logic can be surprised with what restricted "for all" does over an empty set. We proved the general case in ~ empty-surprise . Here we prove an extreme example: we "prove" that false is true. Of course, we actually do no such thing (see ~ notfal ); the problem is that restricted "for all" works in ways that might seem counterintuitive to the inexperienced when given an empty set. Solutions to this can include requiring that the set not be empty or by using the allsome quantifier ~ df-rals . (Contributed by David A. Wheeler, 20-Oct-2018.)
theorem empty_surprise2 {x3: setvar} (A2: class x3):
  $ wn (wex x3 (wcel (cv x3) A2)) $ >
  $ wral x3 wfal A2 $;

--| Show what implication inside "there exists" really expands to (using implication directly inside "there exists" is usually a mistake). Those inexperienced with formal notations of classical logic may use expressions combining "there exists" with implication. That is usually a mistake, because as proven using ~ imor , such an expression can be rewritten using _not_ with _or_ - and that is often not what the author intended. New users of formal notation who use "there exists" with an implication should consider if they meant "and" instead of "implies". A stark example is shown in ~ eximp-surprise2 . See also ~ alimp-surprise and ~ empty-surprise . (Contributed by David A. Wheeler, 17-Oct-2018.)
theorem eximp_surprise {x3: setvar} (ph ps: wff x3):
  $ wb (wex x3 (wi ph ps)) (wex x3 (wo (wn ph) ps)) $;

--| Show that "there exists" with an implication is always true if there exists a situation where the antecedent is false. Those inexperienced with formal notations of classical logic may use expressions combining "there exists" with implication. This is usually a mistake, because that combination does not mean what an inexperienced person might think it means. For example, if there is some object that does not meet the precondition ` ph ` , then the expression ` E. x ( ph -> ps ) ` as a whole is always true, no matter what ` ps ` is ( ` ps ` could even be false, ` F. ` ). New users of formal notation who use "there exists" with an implication should consider if they meant "and" instead of "implies". See ~ eximp-surprise , which shows what implication really expands to. See also ~ empty-surprise . (Contributed by David A. Wheeler, 18-Oct-2018.)
theorem eximp_surprise2 {x3: setvar} (ph ps: wff x3):
  $ wex x3 (wn ph) $ >
  $ wex x3 (wi ph ps) $;

--| Extend wff definition to include "all some" applied to a top-level implication, which means ` ps ` is true whenever ` ph ` is true, and there is at least one ` x ` where ` ph ` is true. (Contributed by David A. Wheeler, 20-Oct-2018.) (Revised by David A. Wheeler, 12-Jul-2026.)
term wals {x3: setvar} (ph ps: wff x3): wff;

--| Extend wff definition to include "all some" applied to a class, which means ` ps ` is true whenever ` ph ` is true for ` x ` in ` A ` , and there is at least one ` x ` in ` A ` where ` ph ` is true. (Contributed by David A. Wheeler, 20-Oct-2018.) (Revised by David A. Wheeler, 12-Jul-2026.)
term wrals {x3: setvar} (ph ps: wff x3) (A2: class x3): wff;

--| Define "all some" applied to a top-level implication, which means ` ps ` is true whenever ` ph ` is true and there is at least one ` x ` where ` ph ` is true. (Contributed by David A. Wheeler, 20-Oct-2018.)
axiom df_als {x3: setvar} (ph ps: wff x3):
  $ wb (wals x3 ph ps) (wa (wal x3 (wi ph ps)) (wex x3 ph)) $;

--| Define "all some" applied to a class, which means ` ps ` is true whenever ` ph ` is true for ` x ` in ` A ` , and there is at least one ` x ` in ` A ` where ` ph ` is true. An older definition of the "all some" quantifier when scoped to a class, named df-alsc and now removed, instead applied a bare formula ` ph ` to the members of a class, asserting only ` ( A. x e. A ph /\ E. x x e. A ) ` , that is, that the formula held throughout ` A ` and that ` A ` had at least one member. I've now decided that that was a mistake. Its older existence conjunct ` E. x x e. A ` did not require any member of ` A ` to satisfy the antecedent, so if the formula was itself an implication, that inner implication could still be vacuously true, which is precisely what the allsome quantifier exists to prevent. For example, the older definition meant that "among Martians, all tall ones are green" could be considered true if there are Martians, but no tall Martians. This version of the definition instead ensures that claims of the form "among Martians, all tall ones are green" can only be true if all tall Martians are green _and_ that there is at least one tall Martian. (Contributed by David A. Wheeler, 20-Oct-2018.) (Revised by David A. Wheeler, 12-Jul-2026.)
axiom df_rals {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb (wrals x3 ph ps A2) (wa (wral x3 (wi ph ps) A2) (wrex x3 ph A2)) $;

--| The bounded "all some" form is the general form with the class membership folded into the antecedent. (Contributed by David A. Wheeler, 22-Oct-2018.) (Revised by David A. Wheeler, 12-Jul-2026.)
theorem dfrals2 {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb (wrals x3 ph ps A2) (wals x3 (wa (wcel (cv x3) A2) ph) ps) $;

--| Introduction rule: "all some" holds if the "for all" part holds and the antecedent has a witness. This is the converse of ~ als1d and ~ als2d taken together, and is what lets an "all some" statement be proved rather than merely taken apart. (Contributed by David A. Wheeler, 12-Jul-2026.)
theorem alsd {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wal x3 (wi ps ch)) $ >
  $ wi ph (wex x3 ps) $ >
  $ wi ph (wals x3 ps ch) $;

--| Introduction rule for "all some" restricted to a class. This is the converse of ~ rals1d and ~ rals2d taken together. (Contributed by David A. Wheeler, 12-Jul-2026.)
theorem ralsd {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wi ph (wral x3 (wi ps ch) A2) $ >
  $ wi ph (wrex x3 ps A2) $ >
  $ wi ph (wrals x3 ps ch A2) $;

--| Deduction rule: Given "all some" applied to a top-level inference, you can extract the "for all" part. (Contributed by David A. Wheeler, 20-Oct-2018.)
theorem als1d {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wals x3 ps ch) $ >
  $ wi ph (wal x3 (wi ps ch)) $;

--| Deduction rule: Given "all some" applied to a top-level inference, you can extract the "exists" part. (Contributed by David A. Wheeler, 20-Oct-2018.)
theorem als2d {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wals x3 ps ch) $ >
  $ wi ph (wex x3 ps) $;

--| Deduction rule: Given "all some" applied to a class, you can extract the "for all" part. (Contributed by David A. Wheeler, 20-Oct-2018.) (Revised by David A. Wheeler, 12-Jul-2026.)
theorem rals1d {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wi ph (wrals x3 ps ch A2) $ >
  $ wi ph (wral x3 (wi ps ch) A2) $;

--| Deduction rule: Given "all some" applied to a class, you can extract the "there exists" part. Note that the witness must satisfy the antecedent ` ps ` , not merely be a member of ` A ` . (Contributed by David A. Wheeler, 20-Oct-2018.) (Revised by David A. Wheeler, 12-Jul-2026.)
theorem rals2d {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wi ph (wrals x3 ps ch A2) $ >
  $ wi ph (wrex x3 ps A2) $;

--| Deduction rule: Given "all some" applied to a class, the class is not the empty set. (Contributed by David A. Wheeler, 23-Oct-2018.) (Revised by David A. Wheeler, 12-Jul-2026.)
theorem ralsn0d {x3: setvar} (ph ps ch: wff x3) (A2: class):
  $ wi ph (wrals x3 ps ch A2) $ >
  $ wi ph (wne A2 c0) $;

--| The consequent of an "all some" is witnessed: if ` ps ` holds of every ` x ` satisfying ` ph ` , and some ` x ` satisfies ` ph ` , then some ` x ` satisfies ` ps ` . This is the positive counterpart of ~ als-no-surprise , and it is the property that ordinary "for all" with implication lacks: from ` A. x ( ph -> ps ) ` alone nothing whatever follows about ` ps ` , as ~ alimp-surprise shows. It is the reason the allsome quantifier says what a speaker of "all Martians are green" usually means. (Contributed by David A. Wheeler, 12-Jul-2026.)
theorem alsex {x3: setvar} (ph ps: wff x3):
  $ wi (wals x3 ph ps) (wex x3 ps) $;

--| The consequent of an "all some" restricted to a class is witnessed: some member of ` A ` satisfying ` ph ` also satisfies ` ps ` . Restricted counterpart of ~ alsex . (Contributed by David A. Wheeler, 12-Jul-2026.)
theorem ralsex {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wrals x3 ph ps A2) (wrex x3 ps A2) $;

--| Congruence: equivalents may be substituted inside an "all some". (Contributed by David A. Wheeler, 12-Jul-2026.)
theorem alsbii {x3: setvar} (ph ps ch th: wff x3):
  $ wb ph ch $ >
  $ wb ps th $ >
  $ wb (wals x3 ph ps) (wals x3 ch th) $;

--| Congruence for "all some" restricted to a class. (Contributed by David A. Wheeler, 12-Jul-2026.)
theorem ralsbii {x3: setvar} (ph ps ch th: wff x3) (A2: class x3):
  $ wb ph ch $ >
  $ wb ps th $ >
  $ wb (wrals x3 ph ps A2) (wrals x3 ch th A2) $;

--| Deduction form of ~ alsbii . (Contributed by David A. Wheeler, 12-Jul-2026.)
theorem alsbid {x3: setvar} (ph ps ch th ta: wff x3):
  $ wnf x3 ph $ >
  $ wi ph (wb ps th) $ >
  $ wi ph (wb ch ta) $ >
  $ wi ph (wb (wals x3 ps ch) (wals x3 th ta)) $;

--| Bound-variable hypothesis builder for "all some". (Contributed by David A. Wheeler, 12-Jul-2026.)
theorem nfals {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf x3 ph $ >
  $ wnf x3 ps $ >
  $ wnf x3 (wals y1 ph ps) $;

--| Bound-variable hypothesis builder for "all some" restricted to a class. (Contributed by David A. Wheeler, 12-Jul-2026.)
theorem nfrals {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnf x3 ph $ >
  $ wnf x3 ps $ >
  $ wnf x3 (wrals y1 ph ps A2) $;

--| Rule used to change bound variables, using implicit substitution. (Contributed by David A. Wheeler, 12-Jul-2026.)
theorem cbvals {x3 y1: setvar} (ph ps: wff x3) (ch th: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ch) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ps th) $ >
  $ wb (wals x3 ph ps) (wals y1 ch th) $;

--| Demonstrate that there is never a "surprise" when using the allsome quantifier, that is, it is never possible for the consequent to be both always true and always false. This uses the definition of ~ df-als ; the proof itself builds on ~ alimp-no-surprise . For a contrast, see ~ alimp-surprise . (Contributed by David A. Wheeler, 27-Oct-2018.)
theorem als_no_surprise {x3: setvar} (ph ps: wff x3):
  $ wn (wa (wals x3 ph ps) (wals x3 ph (wn ps))) $;

--| Demonstrate that there is never a "surprise" when using the allsome quantifier restricted to a class, that is, it is never possible for the consequent to be both always true and always false of the members of ` A ` that satisfy the antecedent. This is the restricted counterpart of ~ als-no-surprise , and follows from it by ~ dfrals2 . Note that this needs no assumption that ` A ` is nonempty, because allsome requires a member of ` A ` satisfying ` ph ` , and that member would have to satisfy both ` ps ` and ` -. ps ` . The ordinary restricted "for all" requires no such member and can be vacuously true, as shown in ~ empty-surprise2 ; that is the point of allsome. (Contributed by David A. Wheeler, 12-Jul-2026.)
theorem rals_no_surprise {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wn (wa (wrals x3 ph ps A2) (wrals x3 ph (wn ps) A2)) $;

--| If the universal part of a restricted "all some" statement holds, then the statement reduces to the existence of a member of ` A ` satisfying its antecedent. This is the restricted counterpart of ~ ralals . (Contributed by Peter Mazsa and David A. Wheeler, 20-Jul-2026.)
theorem ralrals {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wral x3 (wi ph ps) A2) (wb (wrals x3 ph ps A2) (wrex x3 ph A2)) $;

--| If a member of ` A ` satisfying the antecedent exists, then a restricted "all some" statement reduces to its universal part. This is the restricted counterpart of ~ rexals . (Contributed by Peter Mazsa and David A. Wheeler, 20-Jul-2026.)
theorem rexrals {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wrex x3 ph A2) (wb (wrals x3 ph ps A2) (wral x3 (wi ph ps) A2)) $;

--| An "all some" statement conjoined with the claim that at most one ` x ` satisfies its antecedent is equivalent to the universal part conjoined with the claim that exactly one ` x ` satisfies the antecedent. The "all some" quantifier supplies the existence of such an ` x ` and ` E* x ph ` supplies the at-most-one part, so together they yield ` E! x ph ` . (Contributed by Peter Mazsa and David A. Wheeler, 20-Jul-2026.)
theorem alsanmo {x3: setvar} (ph ps: wff x3):
  $ wb (wa (wals x3 ph ps) (wmo x3 ph)) (wa (wal x3 (wi ph ps)) (weu x3 ph)) $;

--| An "all some" statement restricted to a class, conjoined with the claim that at most one ` x ` in ` A ` satisfies its antecedent, is equivalent to the universal part conjoined with the claim that exactly one ` x ` in ` A ` satisfies the antecedent. This is the restricted counterpart of ~ alsanmo . (Contributed by Peter Mazsa and David A. Wheeler, 20-Jul-2026.)
theorem ralsanmo {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb (wa (wrals x3 ph ps A2) (wrmo x3 ph A2)) (wa (wral x3 (wi ph ps) A2) (wreu x3 ph A2)) $;

--| The general "all some" quantifier with class membership as its antecedent holds if and only if ` ph ` holds for every ` x ` in ` A ` and some ` x ` in ` A ` satisfies ` ph ` . (Contributed by Peter Mazsa, 27-Nov-2018.) (Revised by David A. Wheeler, 15-Jul-2026.)
theorem alsralrex {x3: setvar} (ph: wff x3) (A2: class):
  $ wb (wals x3 (wcel (cv x3) A2) ph) (wa (wral x3 ph A2) (wrex x3 ph A2)) $;

--| The general "all some" quantifier with class membership as its antecedent holds if and only if ` ph ` holds for every ` x ` in ` A ` and ` A ` is not empty. (Contributed by Peter Mazsa, 28-Nov-2018.) (Revised by David A. Wheeler, 15-Jul-2026.)
theorem alsraln0 {x3: setvar} (ph: wff x3) (A2: class):
  $ wb (wals x3 (wcel (cv x3) A2) ph) (wa (wral x3 ph A2) (wne A2 c0)) $;

--| If ` ph ` holds for every ` x ` in ` A ` , then the general "all some" quantifier with class membership as its antecedent reduces to the assertion that some ` x ` in ` A ` satisfies ` ph ` . See ~ ralrals for the restricted counterpart. (Contributed by Peter Mazsa, 19-Dec-2018.) (Revised by David A. Wheeler, 15-Jul-2026.)
theorem ralals {x3: setvar} (ph: wff x3) (A2: class):
  $ wi (wral x3 ph A2) (wb (wals x3 (wcel (cv x3) A2) ph) (wrex x3 ph A2)) $;

--| If some ` x ` in ` A ` satisfies ` ph ` , then the general "all some" quantifier with class membership as its antecedent reduces to the assertion that ` ph ` holds for every ` x ` in ` A ` . See ~ rexrals for the restricted counterpart. (Contributed by Peter Mazsa, 19-Dec-2018.) (Revised by David A. Wheeler, 15-Jul-2026.)
theorem rexals {x3: setvar} (ph: wff x3) (A2: class):
  $ wi (wrex x3 ph A2) (wb (wals x3 (wcel (cv x3) A2) ph) (wral x3 ph A2)) $;

--| If ` A ` is not empty, then the general "all some" quantifier with class membership as its antecedent reduces to the assertion that ` ph ` holds for every ` x ` in ` A ` . (Contributed by Peter Mazsa, 19-Dec-2018.) (Revised by David A. Wheeler, 15-Jul-2026.)
theorem n0als {x3: setvar} (ph: wff x3) (A2: class):
  $ wi (wne A2 c0) (wb (wals x3 (wcel (cv x3) A2) ph) (wral x3 ph A2)) $;

--| Nested general "all some" quantifiers with class membership as their antecedents: ` ph ` holds for every ` x ` in ` A ` and every ` y ` in ` B ` , and both ` A ` and ` B ` are not empty. (Contributed by Peter Mazsa, 28-May-2019.) (Revised by David A. Wheeler, 15-Jul-2026.)
theorem _2alsraln0 {x3 y1: setvar} (ph: wff x3 y1) (A2: class y1) (B2: class):
  $ wb (wals x3 (wcel (cv x3) A2) (wals y1 (wcel (cv y1) B2) ph)) (wa (wral x3 (wral y1 ph B2) A2) (wa (wne A2 c0) (wne B2 c0))) $;

--| Nested general "all some" quantifiers with class membership as their antecedents, for the same class ` A ` : ` ph ` holds for every ` x ` and every ` y ` in ` A ` , and ` A ` is not empty. (Contributed by Peter Mazsa, 28-May-2019.) (Revised by David A. Wheeler, 15-Jul-2026.)
theorem _2alsraln0id {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wb (wals x3 (wcel (cv x3) A2) (wals y1 (wcel (cv y1) A2) ph)) (wa (wral x3 (wral y1 ph A2) A2) (wne A2 c0)) $;

--| Extend wff definition to include "all some one" applied to a top-level implication, which means ` ps ` is true whenever ` ph ` is true, and exactly one ` x ` satisfies ` ph ` . (Contributed by David A. Wheeler, 21-Jul-2026.)
term walseu {x3: setvar} (ph ps: wff x3): wff;

--| Extend wff definition to include "all some one" applied to a class, which means ` ps ` is true whenever ` ph ` is true for ` x ` in ` A ` , and exactly one ` x ` in ` A ` satisfies ` ph ` . (Contributed by David A. Wheeler, 21-Jul-2026.)
term wralseu {x3: setvar} (ph ps: wff x3) (A2: class x3): wff;

--| Define "all some one" applied to a top-level implication, which means ` ps ` is true whenever ` ph ` is true and exactly one ` x ` satisfies ` ph ` . (Contributed by David A. Wheeler, 21-Jul-2026.)
axiom df_alseu {x3: setvar} (ph ps: wff x3):
  $ wb (walseu x3 ph ps) (wa (wal x3 (wi ph ps)) (weu x3 ph)) $;

--| Define "all some one" applied to a class, which means ` ps ` is true whenever ` ph ` is true for ` x ` in ` A ` , and exactly one ` x ` in ` A ` satisfies ` ph ` . (Contributed by David A. Wheeler, 21-Jul-2026.)
axiom df_ralseu {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb (wralseu x3 ph ps A2) (wa (wral x3 (wi ph ps) A2) (wreu x3 ph A2)) $;

--| The bounded "all some one" form is the general form with the class membership folded into the antecedent. This is the "all some one" counterpart of ~ dfrals2 . (Contributed by David A. Wheeler, 21-Jul-2026.)
theorem dfralseu2 {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wb (wralseu x3 ph ps A2) (walseu x3 (wa (wcel (cv x3) A2) ph) ps) $;

--| "All some one" implies "all some": requiring exactly one witness is stronger than requiring at least one. Any consequence of an allsome statement is therefore a consequence of the corresponding "all some one" statement, which is how ~ alseu-no-surprise is proved. (Contributed by David A. Wheeler, 21-Jul-2026.)
theorem alseuals {x3: setvar} (ph ps: wff x3):
  $ wi (walseu x3 ph ps) (wals x3 ph ps) $;

--| "All some one" restricted to a class implies "all some" restricted to that class. Restricted counterpart of ~ alseuals . (Contributed by David A. Wheeler, 21-Jul-2026.)
theorem ralseurals {x3: setvar} (ph ps: wff x3) (A2: class x3):
  $ wi (wralseu x3 ph ps A2) (wrals x3 ph ps A2) $;

--| Introduction rule: "all some one" holds if the "for all" part holds and the antecedent has exactly one witness. This is the converse of ~ alseu1d and ~ alseu2d taken together. (Contributed by David A. Wheeler, 21-Jul-2026.)
theorem alseud {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (wal x3 (wi ps ch)) $ >
  $ wi ph (weu x3 ps) $ >
  $ wi ph (walseu x3 ps ch) $;

--| Introduction rule for "all some one" restricted to a class. This is the converse of ~ ralseu1d and ~ ralseu2d taken together. (Contributed by David A. Wheeler, 21-Jul-2026.)
theorem ralseud {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wi ph (wral x3 (wi ps ch) A2) $ >
  $ wi ph (wreu x3 ps A2) $ >
  $ wi ph (wralseu x3 ps ch A2) $;

--| Deduction rule: Given "all some one" applied to a top-level inference, you can extract the "for all" part. (Contributed by David A. Wheeler, 21-Jul-2026.)
theorem alseu1d {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (walseu x3 ps ch) $ >
  $ wi ph (wal x3 (wi ps ch)) $;

--| Deduction rule: Given "all some one" applied to a top-level inference, you can extract the "exactly one" part. (Contributed by David A. Wheeler, 21-Jul-2026.)
theorem alseu2d {x3: setvar} (ph ps ch: wff x3):
  $ wi ph (walseu x3 ps ch) $ >
  $ wi ph (weu x3 ps) $;

--| Deduction rule: Given "all some one" applied to a class, you can extract the "for all" part. (Contributed by David A. Wheeler, 21-Jul-2026.)
theorem ralseu1d {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wi ph (wralseu x3 ps ch A2) $ >
  $ wi ph (wral x3 (wi ps ch) A2) $;

--| Deduction rule: Given "all some one" applied to a class, you can extract the "exactly one" part. Note that the witness must satisfy the antecedent ` ps ` , not merely be a member of ` A ` . (Contributed by David A. Wheeler, 21-Jul-2026.)
theorem ralseu2d {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wi ph (wralseu x3 ps ch A2) $ >
  $ wi ph (wreu x3 ps A2) $;

--| Congruence: equivalents may be substituted inside an "all some one". This is the "all some one" counterpart of ~ alsbii . (Contributed by David A. Wheeler, 21-Jul-2026.)
theorem alseubii {x3: setvar} (ph ps ch th: wff x3):
  $ wb ph ch $ >
  $ wb ps th $ >
  $ wb (walseu x3 ph ps) (walseu x3 ch th) $;

--| Congruence for "all some one" restricted to a class. This is the "all some one" counterpart of ~ ralsbii . (Contributed by David A. Wheeler, 21-Jul-2026.)
theorem ralseubii {x3: setvar} (ph ps ch th: wff x3) (A2: class x3):
  $ wb ph ch $ >
  $ wb ps th $ >
  $ wb (wralseu x3 ph ps A2) (wralseu x3 ch th A2) $;

--| Bound-variable hypothesis builder for "all some one". This is the "all some one" counterpart of ~ nfals . Unlike ~ nfals it requires ` x ` and ` y ` to be disjoint, because the corresponding builder for ` E! ` is ~ nfeuw , which requires it; the version without that requirement, ~ nfeu , depends on ~ ax-13 and its use is discouraged. (Contributed by David A. Wheeler, 21-Jul-2026.)
theorem nfalseu {x3 y1: setvar} (ph ps: wff x3 y1):
  $ wnf x3 ph $ >
  $ wnf x3 ps $ >
  $ wnf x3 (walseu y1 ph ps) $;

--| Bound-variable hypothesis builder for "all some one" restricted to a class. This is the "all some one" counterpart of ~ nfrals . (Contributed by David A. Wheeler, 21-Jul-2026.)
theorem nfralseu {x3 y1: setvar} (ph ps: wff x3 y1) (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnf x3 ph $ >
  $ wnf x3 ps $ >
  $ wnf x3 (wralseu y1 ph ps A2) $;

--| An "all some one" statement is equivalent to its universal part conjoined with the claim that exactly one ` x ` satisfies both ` ph ` and ` ps ` . In other words, given ` A. x ( ph -> ps ) ` , requiring exactly one ` x ` to satisfy ` ph ` , which is what ~ df-alseu requires, and requiring exactly one ` x ` to satisfy ` ( ph /\ ps ) ` come to the same thing. Read ` ph ` as "is a king" and ` ps ` as "is hungry": if every king is hungry, then "there is exactly one king" and "there is exactly one hungry king" say the same thing, so either of them, together with "every king is hungry", gives "the king is hungry". The universal conjunct is what makes that work, and it cannot be dropped. ` E! x ( ph /\ ps ) ` on its own is strictly weaker than ` AE! x ( ph -> ps ) ` , since it is satisfied when many things are ` ph ` and just one of those is ` ps ` , as in a region with five kings exactly one of whom is hungry; see ~ alseueu for the one direction that does hold without it. Uniqueness attaches to the antecedent, not to the conjunction. Russell's analysis of a definite description is built the same way: its uniqueness clause constrains the description predicate alone, while the predication is a separate conjunct. See his worked example of "the father of Charles II was executed", [Russell1905] p. 482. (Contributed by David A. Wheeler, 21-Jul-2026.)
theorem dfalseu2 {x3: setvar} (ph ps: wff x3):
  $ wb (walseu x3 ph ps) (wa (wal x3 (wi ph ps)) (weu x3 (wa ph ps))) $;

--| "The ` ph ` is ` ps ` " implies that exactly one thing is both ` ph ` and ` ps ` . This is the half of ~ dfalseu2 that drops the universal conjunct; it does not reverse, so ` E! x ( ph /\ ps ) ` cannot be used in place of an "all some one" statement. (Contributed by David A. Wheeler, 21-Jul-2026.)
theorem alseueu {x3: setvar} (ph ps: wff x3):
  $ wi (walseu x3 ph ps) (weu x3 (wa ph ps)) $;

--| Demonstrate that there is never a "surprise" when using the "all some one" quantifier, that is, it is never possible for the consequent to be both always true and always false. This follows from ~ als-no-surprise by ~ alseuals . For a contrast, see ~ alimp-surprise . (Contributed by David A. Wheeler, 21-Jul-2026.)
theorem alseu_no_surprise {x3: setvar} (ph ps: wff x3):
  $ wn (wa (walseu x3 ph ps) (walseu x3 ph (wn ps))) $;

--| Prove that 5 - 4 = 1. (Contributed by David A. Wheeler, 31-Jan-2017.)
theorem _5m4e1:
  $ wceq (co c5 c4 cmin) c1 $;

--| Prove that ` 2 + 2 =/= 5 ` . In George Orwell's "1984", Part One, Chapter Seven, the protagonist Winston notes that, "In the end the Party would announce that two and two made five, and you would have to believe it." ~ http://www.sparknotes.com/lit/1984/section4.rhtml . More generally, the phrase ` 2 + 2 = 5 ` has come to represent an obviously false dogma one may be required to believe. See the Wikipedia article for more about this: ~ https://en.wikipedia.org/wiki/2_%2B_2_%3D_5 . Unsurprisingly, we can easily prove that this claim is false. (Contributed by David A. Wheeler, 31-Jan-2017.)
theorem _2p2ne5:
  $ wne (co c2 c2 caddc) c5 $;

--| Resolution rule. This is the primary inference rule in some automated theorem provers such as prover9. The resolution rule can be traced back to Davis and Putnam (1960). (Contributed by David A. Wheeler, 9-Feb-2017.)
theorem resolution (ph ps ch: wff):
  $ wi (wo (wa ph ps) (wa (wn ph) ch)) (wo ps ch) $;

--| In classical logic all wffs are testable, that is, it is always true that ` ( -. ph \/ -. -. ph ) ` . This is not necessarily true in intuitionistic logic. In intuitionistic logic, if this statement is true for some ` ph ` , then ` ph ` is _testable_. The proof is trivial because it's simply a special case of the law of the excluded middle, which is true in classical logic but not necessarily true in intuitionisic logic. (Contributed by David A. Wheeler, 5-Dec-2018.)
theorem testable (ph: wff):
  $ wo (wn ph) (wn (wn ph)) $;

--| Lemma for other theorems about ` AA ` . (Contributed by Brendan Leahy, 3-Jan-2020.) (Revised by Alexander van der Vekens and David A. Wheeler, 25-Apr-2020.)
theorem aacllem {k n: setvar} (ph: wff) (A2: class) (C: class k n) (N: class) (X: class n):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi (wa ph (wcel (cv n) (co c1 N cfz))) (wcel X cc) $ >
  $ wi (w3a ph (wcel (cv k) (co cc0 N cfz)) (wcel (cv n) (co c1 N cfz))) (wcel C cq) $ >
  $ wi (wa ph (wcel (cv k) (co cc0 N cfz))) (wceq (co A2 (cv k) cexp) (csu n (co c1 N cfz) (co C X cmul))) $ >
  $ wi ph (wcel A2 caa) $;

--| A one-to-one word maps its domain into its alphabet. (Contributed by Mingli Yuan, 11-Aug-2026.)
theorem wrdf1d (ph: wff) (D W: class):
  $ wi ph (wcel W (cword D)) $ >
  $ wi ph (wfun (ccnv W)) $ >
  $ wi ph (wf1 (cdm W) D W) $;

--| ` 1 ` is not equal to ` 3 ` . (Contributed by Jiamin Zhao, 1-Aug-2026.)
theorem _1ne3:
  $ wne c1 c3 $;

--| ` 2 ` is not equal to ` 3 ` . (Contributed by Jiamin Zhao, 1-Aug-2026.)
theorem _2ne3:
  $ wne c2 c3 $;

--| Membership of 1 in the integer interval ( 1 ... 3 ). (Suggested by avekens.) (Contributed by Jiamin Zhao, 1-Aug-2026.) (Proof shortened by Jiamin Zhao, 13-Aug-2026.)
theorem _1elfz13:
  $ wcel c1 (co c1 c3 cfz) $;

--| Membership of 2 in the integer interval ( 1 ... 3 ). (Suggested by tirix.) (Contributed by Jiamin Zhao, 1-Aug-2026.) (Proof shortened by Jiamin Zhao, 13-Aug-2026.)
theorem _2elfz13:
  $ wcel c2 (co c1 c3 cfz) $;

--| Membership of 3 in the integer interval ( 1 ... 3 ). (Contributed by Jiamin Zhao, 1-Aug-2026.)
theorem _3elfz13:
  $ wcel c3 (co c1 c3 cfz) $;

--| The components of a 3-dimensional real coordinate vector are real numbers. (Contributed by Jiamin Zhao, 31-Jul-2026.)
theorem rr3fvcl (A2: class):
  $ wi (wcel A2 (co cr (co c1 c3 cfz) cmap)) (w3a (wcel (cfv c1 A2) cr) (wcel (cfv c2 A2) cr) (wcel (cfv c3 A2) cr)) $;

--| First component of a 3-dimensional real coordinate vector is real. (Contributed by Jiamin Zhao, 10-Aug-2026.)
theorem rr3fv1cld (ph: wff) (A2: class):
  $ wi ph (wcel A2 (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wcel (cfv c1 A2) cr) $;

--| Second component of a 3-dimensional real coordinate vector is real. (Contributed by Jiamin Zhao, 10-Aug-2026.)
theorem rr3fv2cld (ph: wff) (A2: class):
  $ wi ph (wcel A2 (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wcel (cfv c2 A2) cr) $;

--| Third component of a 3-dimensional real coordinate vector is real. (Contributed by Jiamin Zhao, 10-Aug-2026.)
theorem rr3fv3cld (ph: wff) (A2: class):
  $ wi ph (wcel A2 (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wcel (cfv c3 A2) cr) $;

--| Extend class notation to include the cross product operation. (Contributed by Jiamin Zhao, 31-Jul-2026.)
term ccrossp: class;

--| Define the cross product of two 3-dimensional real coordinate vectors. Vectors are represented as functions on ` ( 1 ... 3 ) ` . (Contributed by Jiamin Zhao, 31-Jul-2026.)
axiom df_crossp {v u k: setvar}:
  $ wceq ccrossp (cmpo u v (co cr (co c1 c3 cfz) cmap) (co cr (co c1 c3 cfz) cmap) (cmpt k (co c1 c3 cfz) (cif (wceq (cv k) c1) (co (co (cfv c2 (cv u)) (cfv c3 (cv v)) cmul) (co (cfv c3 (cv u)) (cfv c2 (cv v)) cmul) cmin) (cif (wceq (cv k) c2) (co (co (cfv c3 (cv u)) (cfv c1 (cv v)) cmul) (co (cfv c1 (cv u)) (cfv c3 (cv v)) cmul) cmin) (co (co (cfv c1 (cv u)) (cfv c2 (cv v)) cmul) (co (cfv c2 (cv u)) (cfv c1 (cv v)) cmul) cmin))))) $;

--| Extend class notation to include the scalar triple product of 3-dimensional real coordinate vectors. (Contributed by Jiamin Zhao, 31-Jul-2026.)
term ctripp: class;

--| Define the scalar triple product of three 3-dimensional real coordinate vectors as the dot product of the first vector ` x ` with the cross product of the other two ( ` y ` and ` z ` ). Apply as ` ( y ( tripp `` x ) z ) ` . Vectors are represented as functions on ` ( 1 ... 3 ) ` . (Contributed by Jiamin Zhao, 31-Jul-2026.)
axiom df_tripp {x3 y1 z k: setvar}:
  $ wceq ctripp (cmpt x3 (co cr (co c1 c3 cfz) cmap) (cmpo y1 z (co cr (co c1 c3 cfz) cmap) (co cr (co c1 c3 cfz) cmap) (co crefld (cmpt k (co c1 c3 cfz) (co (cfv (cv k) (cv x3)) (cfv (cv k) (co (cv y1) (cv z) ccrossp)) cmul)) cgsu))) $;

--| Value of the cross product of two 3-dimensional real coordinate vectors as a function on ` ( 1 ... 3 ) ` . (Contributed by Jiamin Zhao, 31-Jul-2026.)
theorem crosspval {k: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 (co cr (co c1 c3 cfz) cmap)) (wcel B2 (co cr (co c1 c3 cfz) cmap))) (wceq (co A2 B2 ccrossp) (cmpt k (co c1 c3 cfz) (cif (wceq (cv k) c1) (co (co (cfv c2 A2) (cfv c3 B2) cmul) (co (cfv c3 A2) (cfv c2 B2) cmul) cmin) (cif (wceq (cv k) c2) (co (co (cfv c3 A2) (cfv c1 B2) cmul) (co (cfv c1 A2) (cfv c3 B2) cmul) cmin) (co (co (cfv c1 A2) (cfv c2 B2) cmul) (co (cfv c2 A2) (cfv c1 B2) cmul) cmin))))) $;

--| Closure of the first component of the cross product's coordinate formula. (Contributed by Jiamin Zhao, 11-Aug-2026.)
theorem crosspcle1d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wcel B2 (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wcel (co (co (cfv c2 A2) (cfv c3 B2) cmul) (co (cfv c3 A2) (cfv c2 B2) cmul) cmin) cr) $;

--| Closure of the second component of the cross product's coordinate formula. (Contributed by Jiamin Zhao, 11-Aug-2026.)
theorem crosspcle2d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wcel B2 (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wcel (co (co (cfv c3 A2) (cfv c1 B2) cmul) (co (cfv c1 A2) (cfv c3 B2) cmul) cmin) cr) $;

--| Closure of the third component of the cross product's coordinate formula. (Contributed by Jiamin Zhao, 11-Aug-2026.)
theorem crosspcle3d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wcel B2 (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wcel (co (co (cfv c1 A2) (cfv c2 B2) cmul) (co (cfv c2 A2) (cfv c1 B2) cmul) cmin) cr) $;

--| Lemma for ~ crosspcld . Closure of the three-way coordinate case split used in the cross product's mapping rule. (Contributed by Jiamin Zhao, 11-Aug-2026.)
theorem crosspclem (ph: wff) (A2 B2: class) (k: setvar):
  $ wi ph (wcel A2 (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wcel B2 (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wcel (cif (wceq (cv k) c1) (co (co (cfv c2 A2) (cfv c3 B2) cmul) (co (cfv c3 A2) (cfv c2 B2) cmul) cmin) (cif (wceq (cv k) c2) (co (co (cfv c3 A2) (cfv c1 B2) cmul) (co (cfv c1 A2) (cfv c3 B2) cmul) cmin) (co (co (cfv c1 A2) (cfv c2 B2) cmul) (co (cfv c2 A2) (cfv c1 B2) cmul) cmin))) cr) $;

--| Closure of the cross product: the cross product of two 3-dimensional real coordinate vectors is again such a vector. (Contributed by Jiamin Zhao, 12-Aug-2026.)
theorem crosspcld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wcel B2 (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wcel (co A2 B2 ccrossp) (co cr (co c1 c3 cfz) cmap)) $;

--| Value of the first component of the cross product. (Contributed by Jiamin Zhao, 12-Aug-2026.)
theorem crosspv1d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wcel B2 (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wceq (cfv c1 (co A2 B2 ccrossp)) (co (co (cfv c2 A2) (cfv c3 B2) cmul) (co (cfv c3 A2) (cfv c2 B2) cmul) cmin)) $;

--| Value of the second component of the cross product. (Contributed by Jiamin Zhao, 12-Aug-2026.)
theorem crosspv2d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wcel B2 (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wceq (cfv c2 (co A2 B2 ccrossp)) (co (co (cfv c3 A2) (cfv c1 B2) cmul) (co (cfv c1 A2) (cfv c3 B2) cmul) cmin)) $;

--| Value of the third component of the cross product. (Contributed by Jiamin Zhao, 12-Aug-2026.)
theorem crosspv3d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wcel B2 (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wceq (cfv c3 (co A2 B2 ccrossp)) (co (co (cfv c1 A2) (cfv c2 B2) cmul) (co (cfv c2 A2) (cfv c1 B2) cmul) cmin)) $;

--| Lemma for ~ crosspdotd . Unfold the curried scalar triple product application into an explicit group sum. (Contributed by Jiamin Zhao, 12-Aug-2026.)
theorem crosspdot0lem {k: setvar} (ph: wff k) (A2 B2 C: class):
  $ wi ph (wcel A2 (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wcel B2 (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wcel C (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wceq (co B2 C (cfv A2 ctripp)) (co crefld (cmpt k (co c1 c3 cfz) (co (cfv (cv k) A2) (cfv (cv k) (co B2 C ccrossp)) cmul)) cgsu)) $;

--| Lemma for ~ crosspdotd . Expand the group sum over ` ( 1 ... 3 ) ` into an explicit three-term sum. (Contributed by Jiamin Zhao, 12-Aug-2026.)
theorem crosspdotsumlem {k: setvar} (ph: wff k) (A2 B2 C: class):
  $ wi ph (wcel A2 (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wcel B2 (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wcel C (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wceq (co crefld (cmpt k (co c1 c3 cfz) (co (cfv (cv k) A2) (cfv (cv k) (co B2 C ccrossp)) cmul)) cgsu) (co (co (cfv c1 A2) (cfv c1 (co B2 C ccrossp)) cmul) (co (co (cfv c2 A2) (cfv c2 (co B2 C ccrossp)) cmul) (co (cfv c3 A2) (cfv c3 (co B2 C ccrossp)) cmul) caddc) caddc)) $;

--| Value of the scalar triple product, expanded into the standard six-term Sarrus polynomial. (Contributed by Jiamin Zhao, 12-Aug-2026.)
theorem crosspdotd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wcel B2 (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wcel C (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wceq (co B2 C (cfv A2 ctripp)) (co (co (co (co (cfv c1 A2) (cfv c2 B2) cmul) (cfv c3 C) cmul) (co (co (cfv c1 A2) (cfv c3 B2) cmul) (cfv c2 C) cmul) cmin) (co (co (co (co (cfv c2 A2) (cfv c3 B2) cmul) (cfv c1 C) cmul) (co (co (cfv c2 A2) (cfv c1 B2) cmul) (cfv c3 C) cmul) cmin) (co (co (co (cfv c3 A2) (cfv c1 B2) cmul) (cfv c2 C) cmul) (co (co (cfv c3 A2) (cfv c2 B2) cmul) (cfv c1 C) cmul) cmin) caddc) caddc)) $;

--| Antisymmetry of the cross product: swapping the two vectors negates the result. (Contributed by Jiamin Zhao, 12-Aug-2026.)
theorem crosspaltd {k: setvar} (ph: wff k) (A2 B2: class):
  $ wi ph (wcel A2 (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wcel B2 (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wceq (co A2 B2 ccrossp) (cmpt k (co c1 c3 cfz) (cneg (cfv (cv k) (co B2 A2 ccrossp))))) $;

--| The vector triple product expansion (BAC-CAB rule): the cross product of ` X ` with ` ( Y crossp Z ) ` equals ` Y ` scaled by the dot product of ` X ` and ` Z ` , minus ` Z ` scaled by the dot product of ` X ` and ` Y ` . The dot products are written out as explicit three-term sums of component products, matching the pointwise style of ~ df-crossp rather than introducing a separate dot product operator. (Contributed by Jiamin Zhao, 12-Aug-2026.)
theorem crossp3d {k: setvar} (ph: wff k) (X Y Z: class):
  $ wi ph (wcel X (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wcel Y (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wcel Z (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wceq (co X (co Y Z ccrossp) ccrossp) (cmpt k (co c1 c3 cfz) (co (co (co (co (co (cfv c1 X) (cfv c1 Z) cmul) (co (cfv c2 X) (cfv c2 Z) cmul) caddc) (co (cfv c3 X) (cfv c3 Z) cmul) caddc) (cfv (cv k) Y) cmul) (co (co (co (co (cfv c1 X) (cfv c1 Y) cmul) (co (cfv c2 X) (cfv c2 Y) cmul) caddc) (co (cfv c3 X) (cfv c3 Y) cmul) caddc) (cfv (cv k) Z) cmul) cmin))) $;

--| Extend class notation to include the quadratic Veronese map on real 3-vectors. (Contributed by Jiamin Zhao, 14-Aug-2026.)
term cveronese: class;

--| Define the quadratic Veronese map on real 3-vectors, with coordinates ordered as ( x^2 , y^2 , z^2 , x y , y z , z x ). (Contributed by Jiamin Zhao, 14-Aug-2026.)
axiom df_veronese {k q: setvar}:
  $ wceq cveronese (cmpt q (co cr (co c1 c3 cfz) cmap) (cmpt k (co c1 c6 cfz) (co (co (co (cif (wceq (cv k) c1) (co (cfv c1 (cv q)) c2 cexp) cc0) (cif (wceq (cv k) c2) (co (cfv c2 (cv q)) c2 cexp) cc0) caddc) (cif (wceq (cv k) c3) (co (cfv c3 (cv q)) c2 cexp) cc0) caddc) (co (co (cif (wceq (cv k) c4) (co (cfv c1 (cv q)) (cfv c2 (cv q)) cmul) cc0) (cif (wceq (cv k) c5) (co (cfv c2 (cv q)) (cfv c3 (cv q)) cmul) cc0) caddc) (cif (wceq (cv k) c6) (co (cfv c3 (cv q)) (cfv c1 (cv q)) cmul) cc0) caddc) caddc))) $;

--| A nonzero coefficient vector whose weighted combination of ` F ` sums to the zero vector implies that ` F ` is not linearly independent. (Contributed by Jiamin Zhao, 27-Aug-2026.)
theorem nellindf (B2 R c_x F I K L W Y c_0: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq R (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq Y (cfv R c0g) $ >
  $ wceq L (cfv (co R I cfrlm) cbs) $ >
  $ wi (wa (w3a (wcel W clmod) (wcel I cvv) (wf I B2 F)) (w3a (wcel K L) (wne K (cxp I (csn Y))) (wceq (co W (co K F (cof c_x)) cgsu) c_0))) (wn (wbr F W clindf)) $;

--| Value of the Veronese map at a point, expressed as a maps-to function on the six coordinates. (Contributed by Jiamin Zhao, 14-Aug-2026.)
theorem veronesevald {k: setvar} (ph: wff k) (P: class):
  $ wi ph (wcel P (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wceq (cfv P cveronese) (cmpt k (co c1 c6 cfz) (co (co (co (cif (wceq (cv k) c1) (co (cfv c1 P) c2 cexp) cc0) (cif (wceq (cv k) c2) (co (cfv c2 P) c2 cexp) cc0) caddc) (cif (wceq (cv k) c3) (co (cfv c3 P) c2 cexp) cc0) caddc) (co (co (cif (wceq (cv k) c4) (co (cfv c1 P) (cfv c2 P) cmul) cc0) (cif (wceq (cv k) c5) (co (cfv c2 P) (cfv c3 P) cmul) cc0) caddc) (cif (wceq (cv k) c6) (co (cfv c3 P) (cfv c1 P) cmul) cc0) caddc) caddc))) $;

--| Every coordinate of the Veronese map of a real 3-vector is real. (Contributed by Jiamin Zhao, 19-Aug-2026.)
theorem veronesefvcl (Q K: class):
  $ wi (wa (wcel Q (co cr (co c1 c3 cfz) cmap)) (wcel K (co c1 c6 cfz))) (wcel (cfv K (cfv Q cveronese)) cr) $;

--| Lemma for ~ veronesevrowd . Value of the first coordinate of the Veronese map at a point. (Contributed by Jiamin Zhao, 15-Aug-2026.)
theorem veronesev1lem (ph: wff) (P: class):
  $ wi ph (wcel P (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wceq (cfv c1 (cfv P cveronese)) (co (cfv c1 P) c2 cexp)) $;

--| Lemma for ~ veronesevrowd . Value of the second coordinate of the Veronese map at a point. (Contributed by Jiamin Zhao, 16-Aug-2026.)
theorem veronesev2lem (ph: wff) (P: class):
  $ wi ph (wcel P (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wceq (cfv c2 (cfv P cveronese)) (co (cfv c2 P) c2 cexp)) $;

--| Lemma for ~ veronesevrowd . Value of the third coordinate of the Veronese map at a point. (Contributed by Jiamin Zhao, 17-Aug-2026.)
theorem veronesev3lem (ph: wff) (P: class):
  $ wi ph (wcel P (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wceq (cfv c3 (cfv P cveronese)) (co (cfv c3 P) c2 cexp)) $;

--| Lemma for ~ veronesevrowd . Value of the fourth coordinate of the Veronese map at a point. (Contributed by Jiamin Zhao, 17-Aug-2026.)
theorem veronesev4lem (ph: wff) (P: class):
  $ wi ph (wcel P (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wceq (cfv c4 (cfv P cveronese)) (co (cfv c1 P) (cfv c2 P) cmul)) $;

--| Lemma for ~ veronesevrowd . Value of the fifth coordinate of the Veronese map at a point. (Contributed by Jiamin Zhao, 17-Aug-2026.)
theorem veronesev5lem (ph: wff) (P: class):
  $ wi ph (wcel P (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wceq (cfv c5 (cfv P cveronese)) (co (cfv c2 P) (cfv c3 P) cmul)) $;

--| Lemma for ~ veronesevrowd . Value of the sixth coordinate of the Veronese map at a point. (Contributed by Jiamin Zhao, 17-Aug-2026.)
theorem veronesev6lem (ph: wff) (P: class):
  $ wi ph (wcel P (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wceq (cfv c6 (cfv P cveronese)) (co (cfv c3 P) (cfv c1 P) cmul)) $;

--| The Veronese map at a point, expressed explicitly as a piecewise maps-to function on the six coordinates. (Contributed by Jiamin Zhao, 17-Aug-2026.)
theorem veronesevrowd {k: setvar} (ph: wff k) (P: class):
  $ wi ph (wcel P (co cr (co c1 c3 cfz) cmap)) $ >
  $ wi ph (wceq (cfv P cveronese) (cmpt k (co c1 c6 cfz) (cif (wceq (cv k) c1) (co (cfv c1 P) c2 cexp) (cif (wceq (cv k) c2) (co (cfv c2 P) c2 cexp) (cif (wceq (cv k) c3) (co (cfv c3 P) c2 cexp) (cif (wceq (cv k) c4) (co (cfv c1 P) (cfv c2 P) cmul) (cif (wceq (cv k) c5) (co (cfv c2 P) (cfv c3 P) cmul) (co (cfv c3 P) (cfv c1 P) cmul)))))))) $;

--| The matrix whose ` i ` -th row is the Veronese image of ` A `` i ` belongs to the base set of ` ( 1 ... 6 ) Mat RRfld ` . (Contributed by Jiamin Zhao, 19-Aug-2026.)
theorem veronesematbasd {i j: setvar} (ph: wff i j) (A2 V: class):
  $ wceq V (cmpo i j (co c1 c6 cfz) (co c1 c6 cfz) (cfv (cv j) (cfv (cfv (cv i) A2) cveronese))) $ >
  $ wi ph (wf (co c1 c6 cfz) (co cr (co c1 c3 cfz) cmap) A2) $ >
  $ wi ph (wcel V (cfv (co (co c1 c6 cfz) crefld cmat) cbs)) $;

--| Currying the Veronese matrix gives the indexed family of Veronese images of the points ` A `` i ` . (Contributed by Jiamin Zhao, 19-Aug-2026.)
theorem veronesematrowd {i j: setvar} (ph: wff i j) (A2 V: class):
  $ wceq V (cmpo i j (co c1 c6 cfz) (co c1 c6 cfz) (cfv (cv j) (cfv (cfv (cv i) A2) cveronese))) $ >
  $ wi ph (wf (co c1 c6 cfz) (co cr (co c1 c3 cfz) cmap) A2) $ >
  $ wi ph (wceq (ccur V) (cmpt i (co c1 c6 cfz) (cfv (cfv (cv i) A2) cveronese))) $;

--| Currying the Veronese matrix gives the indexed family of Veronese images, with each image expressed explicitly by coordinates. (Contributed by Jiamin Zhao, 19-Aug-2026.)
theorem veronesematrowexpd {i j k: setvar} (ph: wff i j k) (A2: class) (V: class k):
  $ wceq V (cmpo i j (co c1 c6 cfz) (co c1 c6 cfz) (cfv (cv j) (cfv (cfv (cv i) A2) cveronese))) $ >
  $ wi ph (wf (co c1 c6 cfz) (co cr (co c1 c3 cfz) cmap) A2) $ >
  $ wi ph (wceq (ccur V) (cmpt i (co c1 c6 cfz) (cmpt k (co c1 c6 cfz) (cif (wceq (cv k) c1) (co (cfv c1 (cfv (cv i) A2)) c2 cexp) (cif (wceq (cv k) c2) (co (cfv c2 (cfv (cv i) A2)) c2 cexp) (cif (wceq (cv k) c3) (co (cfv c3 (cfv (cv i) A2)) c2 cexp) (cif (wceq (cv k) c4) (co (cfv c1 (cfv (cv i) A2)) (cfv c2 (cfv (cv i) A2)) cmul) (cif (wceq (cv k) c5) (co (cfv c2 (cfv (cv i) A2)) (cfv c3 (cfv (cv i) A2)) cmul) (co (cfv c3 (cfv (cv i) A2)) (cfv c1 (cfv (cv i) A2)) cmul))))))))) $;

--| Lemma for ~ veroquadmodzerod . Express the common homogeneous quadratic equation in ` RRfld gsum ` form using the Veronese matrix ` V ` . (Contributed by Jiamin Zhao, 19-Aug-2026.)
theorem veroquadgsumlem {i j: setvar} (ph: wff j) (A2: class) (K: class i) (V: class):
  $ wceq V (cmpo i j (co c1 c6 cfz) (co c1 c6 cfz) (cfv (cv j) (cfv (cfv (cv i) A2) cveronese))) $ >
  $ wi ph (wf (co c1 c6 cfz) (co cr (co c1 c3 cfz) cmap) A2) $ >
  $ wi ph (wf (co c1 c6 cfz) cr K) $ >
  $ wi (wa ph (wcel (cv i) (co c1 c6 cfz))) (wceq (co (co (co (co (cfv c1 K) (co (cfv c1 (cfv (cv i) A2)) c2 cexp) cmul) (co (cfv c2 K) (co (cfv c2 (cfv (cv i) A2)) c2 cexp) cmul) caddc) (co (cfv c3 K) (co (cfv c3 (cfv (cv i) A2)) c2 cexp) cmul) caddc) (co (co (co (cfv c4 K) (co (cfv c1 (cfv (cv i) A2)) (cfv c2 (cfv (cv i) A2)) cmul) cmul) (co (cfv c5 K) (co (cfv c2 (cfv (cv i) A2)) (cfv c3 (cfv (cv i) A2)) cmul) cmul) caddc) (co (cfv c6 K) (co (cfv c3 (cfv (cv i) A2)) (cfv c1 (cfv (cv i) A2)) cmul) cmul) caddc) caddc) cc0) $ >
  $ wi (wa ph (wcel (cv i) (co c1 c6 cfz))) (wceq (co crefld (cmpt j (co c1 c6 cfz) (co (cfv (cv j) K) (cfv (cv j) (cfv (cv i) (ccur V))) cmul)) cgsu) cc0) $;

--| The columns of the Veronese matrix, weighted by the coefficients ` K ` , sum to the zero vector of ` RRfld freeLMod ( 1 ... 6 ) ` . (Contributed by Jiamin Zhao, 19-Aug-2026.)
theorem veroquadmodzerod {i j: setvar} (ph: wff j) (A2: class) (K: class j) (V: class):
  $ wceq V (cmpo i j (co c1 c6 cfz) (co c1 c6 cfz) (cfv (cv j) (cfv (cfv (cv i) A2) cveronese))) $ >
  $ wi ph (wf (co c1 c6 cfz) (co cr (co c1 c3 cfz) cmap) A2) $ >
  $ wi ph (wf (co c1 c6 cfz) cr K) $ >
  $ wi (wa ph (wcel (cv i) (co c1 c6 cfz))) (wceq (co (co (co (co (cfv c1 K) (co (cfv c1 (cfv (cv i) A2)) c2 cexp) cmul) (co (cfv c2 K) (co (cfv c2 (cfv (cv i) A2)) c2 cexp) cmul) caddc) (co (cfv c3 K) (co (cfv c3 (cfv (cv i) A2)) c2 cexp) cmul) caddc) (co (co (co (cfv c4 K) (co (cfv c1 (cfv (cv i) A2)) (cfv c2 (cfv (cv i) A2)) cmul) cmul) (co (cfv c5 K) (co (cfv c2 (cfv (cv i) A2)) (cfv c3 (cfv (cv i) A2)) cmul) cmul) caddc) (co (cfv c6 K) (co (cfv c3 (cfv (cv i) A2)) (cfv c1 (cfv (cv i) A2)) cmul) cmul) caddc) caddc) cc0) $ >
  $ wi ph (wceq (co (co crefld (co c1 c6 cfz) cfrlm) (co K (ccur (ctpos V)) (cof (cfv (co crefld (co c1 c6 cfz) cfrlm) cvsca))) cgsu) (cfv (co crefld (co c1 c6 cfz) cfrlm) c0g)) $;

--| A nonzero homogeneous quadratic equation satisfied by all six points gives a linear dependence among the columns of the Veronese matrix. (Contributed by Jiamin Zhao, 27-Aug-2026.)
theorem veroquadnolindfd {i j: setvar} (ph: wff j) (A2: class) (K: class j) (V: class):
  $ wceq V (cmpo i j (co c1 c6 cfz) (co c1 c6 cfz) (cfv (cv j) (cfv (cfv (cv i) A2) cveronese))) $ >
  $ wi ph (wf (co c1 c6 cfz) (co cr (co c1 c3 cfz) cmap) A2) $ >
  $ wi ph (wf (co c1 c6 cfz) cr K) $ >
  $ wi (wa ph (wcel (cv i) (co c1 c6 cfz))) (wceq (co (co (co (co (cfv c1 K) (co (cfv c1 (cfv (cv i) A2)) c2 cexp) cmul) (co (cfv c2 K) (co (cfv c2 (cfv (cv i) A2)) c2 cexp) cmul) caddc) (co (cfv c3 K) (co (cfv c3 (cfv (cv i) A2)) c2 cexp) cmul) caddc) (co (co (co (cfv c4 K) (co (cfv c1 (cfv (cv i) A2)) (cfv c2 (cfv (cv i) A2)) cmul) cmul) (co (cfv c5 K) (co (cfv c2 (cfv (cv i) A2)) (cfv c3 (cfv (cv i) A2)) cmul) cmul) caddc) (co (cfv c6 K) (co (cfv c3 (cfv (cv i) A2)) (cfv c1 (cfv (cv i) A2)) cmul) cmul) caddc) caddc) cc0) $ >
  $ wi ph (wne K (cxp (co c1 c6 cfz) (csn cc0))) $ >
  $ wi ph (wn (wbr (ccur (ctpos V)) (co crefld (co c1 c6 cfz) cfrlm) clindf)) $;

--| The Veronese matrix of six points satisfying a common nonzero homogeneous quadratic equation has determinant zero. (Contributed by Jiamin Zhao, 27-Aug-2026.)
theorem veroquaddetzerod {i j: setvar} (ph: wff j) (A2: class) (K: class j) (V: class):
  $ wceq V (cmpo i j (co c1 c6 cfz) (co c1 c6 cfz) (cfv (cv j) (cfv (cfv (cv i) A2) cveronese))) $ >
  $ wi ph (wf (co c1 c6 cfz) (co cr (co c1 c3 cfz) cmap) A2) $ >
  $ wi ph (wf (co c1 c6 cfz) cr K) $ >
  $ wi (wa ph (wcel (cv i) (co c1 c6 cfz))) (wceq (co (co (co (co (cfv c1 K) (co (cfv c1 (cfv (cv i) A2)) c2 cexp) cmul) (co (cfv c2 K) (co (cfv c2 (cfv (cv i) A2)) c2 cexp) cmul) caddc) (co (cfv c3 K) (co (cfv c3 (cfv (cv i) A2)) c2 cexp) cmul) caddc) (co (co (co (cfv c4 K) (co (cfv c1 (cfv (cv i) A2)) (cfv c2 (cfv (cv i) A2)) cmul) cmul) (co (cfv c5 K) (co (cfv c2 (cfv (cv i) A2)) (cfv c3 (cfv (cv i) A2)) cmul) cmul) caddc) (co (cfv c6 K) (co (cfv c3 (cfv (cv i) A2)) (cfv c1 (cfv (cv i) A2)) cmul) cmul) caddc) caddc) cc0) $ >
  $ wi ph (wne K (cxp (co c1 c6 cfz) (csn cc0))) $ >
  $ wi ph (wceq (cfv V (co (co c1 c6 cfz) crefld cmdat)) cc0) $;

--| Weighted version of ~ amgmlem . (Contributed by Kunhao Zheng, 19-Jun-2021.)
theorem amgmwlem (ph: wff) (A2 F M W: class):
  $ wceq M (cfv ccnfld cmgp) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wne A2 c0) $ >
  $ wi ph (wf A2 crp F) $ >
  $ wi ph (wf A2 crp W) $ >
  $ wi ph (wceq (co ccnfld W cgsu) c1) $ >
  $ wi ph (wbr (co M (co F W (cof ccxp)) cgsu) (co ccnfld (co F W (cof cmul)) cgsu) cle) $;

--| Alternate proof of ~ amgmlem using ~ amgmwlem . (Contributed by Kunhao Zheng, 20-Jun-2021.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem amgmlemALT (ph: wff) (A2 F M: class):
  $ wceq M (cfv ccnfld cmgp) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wne A2 c0) $ >
  $ wi ph (wf A2 crp F) $ >
  $ wi ph (wbr (co (co M F cgsu) (co c1 (cfv A2 chash) cdiv) ccxp) (co (co ccnfld F cgsu) (cfv A2 chash) cdiv) cle) $;

--| Weighted arithmetic-geometric mean inequality for ` n = 2 ` (compare ~ amgm2d ). (Contributed by Kunhao Zheng, 20-Jun-2021.)
theorem amgmw2d (ph: wff) (A2 B2 P Q: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel P crp) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wcel Q crp) $ >
  $ wi ph (wceq (co P Q caddc) c1) $ >
  $ wi ph (wbr (co (co A2 P ccxp) (co B2 Q ccxp) cmul) (co (co A2 P cmul) (co B2 Q cmul) caddc) cle) $;

--| Young's inequality for ` n = 2 ` , a direct application of ~ amgmw2d . (Contributed by Kunhao Zheng, 6-Jul-2021.)
theorem young2d (ph: wff) (A2 B2 P Q: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel P crp) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wcel Q crp) $ >
  $ wi ph (wceq (co (co c1 P cdiv) (co c1 Q cdiv) caddc) c1) $ >
  $ wi ph (wbr (co A2 B2 cmul) (co (co (co A2 P ccxp) P cdiv) (co (co B2 Q ccxp) Q cdiv) caddc) cle) $;


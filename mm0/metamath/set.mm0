  $ wceq I (cmpt x3 cvv (cif (wceq (cfv (cv x3) c2nd) c_0) Q (crio h (wa (wceq (cfv (cfv (csn (cfv (cv x3) c2nd)) N) M) (cfv (csn (cv h)) J)) (wceq (cfv (cfv (csn (co (cfv (cfv (cv x3) c1st) c1st) (cfv (cv x3) c2nd) c_mi)) N) M) (cfv (csn (co (cfv (cfv (cv x3) c1st) c2nd) (cv h) R)) J))) D))) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel F D) $ >
  $ wi ph (wceq (cfv (cfv (csn X) N) M) (cfv (csn F) J)) $ >
  $ wi ph (wceq (cfv (cotp X F Y) I) G) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel Y (cdif V (csn c_0))) $ >
  $ wi ph (wcel T (cdif V (csn c_0))) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn T) N)) $ >
  $ wi ph (wne (cfv (csn Y) N) (cfv (csn T) N)) $ >
  $ wi ph (wcel X (cfv (cpr Y T) N)) $ >
  $ wi ph (wceq (cfv (cotp Y G T) I) (cfv (cotp X F T) I)) $;

--| Part of Part (8) in [Baer] p. 48. Eliminate ` X e. ( N `` { Y , T } ) ` . TODO: break out ` T =/= .0. ` in ~ mapdh8e so we can share hypotheses. Also, look at hypothesis sharing for earlier mapdh8* and mapdh75* stuff. (Contributed by NM, 10-May-2015.)
theorem mapdh8g {x3 h: setvar} (ph: wff x3) (C: class x3) (D: class) (Q: class h) (R T: class) (U: class x3) (F G: class) (H: class x3 h) (I J: class) (K: class x3 h) (M c_mi N: class) (V: class x3) (W: class x3 h) (X Y c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq D (cfv C cbs) $ >
  $ wceq R (cfv C csg) $ >
  $ wceq Q (cfv C c0g) $ >
  $ wceq J (cfv C clspn) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq I (cmpt x3 cvv (cif (wceq (cfv (cv x3) c2nd) c_0) Q (crio h (wa (wceq (cfv (cfv (csn (cfv (cv x3) c2nd)) N) M) (cfv (csn (cv h)) J)) (wceq (cfv (cfv (csn (co (cfv (cfv (cv x3) c1st) c1st) (cfv (cv x3) c2nd) c_mi)) N) M) (cfv (csn (co (cfv (cfv (cv x3) c1st) c2nd) (cv h) R)) J))) D))) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel F D) $ >
  $ wi ph (wceq (cfv (cfv (csn X) N) M) (cfv (csn F) J)) $ >
  $ wi ph (wceq (cfv (cotp X F Y) I) G) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel Y (cdif V (csn c_0))) $ >
  $ wi ph (wcel T (cdif V (csn c_0))) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn T) N)) $ >
  $ wi ph (wne (cfv (csn Y) N) (cfv (csn T) N)) $ >
  $ wi ph (wceq (cfv (cotp Y G T) I) (cfv (cotp X F T) I)) $;

--| Part of Part (8) in [Baer] p. 48. (Contributed by NM, 11-May-2015.)
theorem mapdh8i {x3 h: setvar} (ph: wff x3) (C: class x3) (D: class) (Q: class h) (R T: class) (U: class x3) (F: class) (H: class x3 h) (I J: class) (K: class x3 h) (M c_mi N: class) (V: class x3) (W: class x3 h) (X Y c_0 Z: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq D (cfv C cbs) $ >
  $ wceq R (cfv C csg) $ >
  $ wceq Q (cfv C c0g) $ >
  $ wceq J (cfv C clspn) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >

--| Lemma for ~ dalaw . Special case to eliminate the requirement ` -. ( ( P .\/ S ) ./\ ( Q .\/ T ) ) .<_ ( R .\/ P ) ` in ~ dalawlem1 . (Contributed by NM, 6-Oct-2012.)
theorem dalawlem9 (A2 P Q R S T U c_or K c_le c_an: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (w3a (wcel K chlt) (wbr (co (co P S c_or) (co Q T c_or) c_an) (co R P c_or) c_le) (wbr (co (co P S c_or) (co Q T c_or) c_an) (co R U c_or) c_le)) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wbr (co (co P Q c_or) (co S T c_or) c_an) (co (co (co Q R c_or) (co T U c_or) c_an) (co (co R P c_or) (co U S c_or) c_an) c_or) c_le) $;

--| Lemma for ~ dalaw . Combine ~ dalawlem5 , ~ dalawlem8 , and dalawlem9 . (Contributed by NM, 6-Oct-2012.)
theorem dalawlem10 (A2 P Q R S T U c_or K c_le c_an: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (w3a (wcel K chlt) (wn (w3a (wn (wbr (co (co P S c_or) (co Q T c_or) c_an) (co P Q c_or) c_le)) (wn (wbr (co (co P S c_or) (co Q T c_or) c_an) (co Q R c_or) c_le)) (wn (wbr (co (co P S c_or) (co Q T c_or) c_an) (co R P c_or) c_le)))) (wbr (co (co P S c_or) (co Q T c_or) c_an) (co R U c_or) c_le)) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wbr (co (co P Q c_or) (co S T c_or) c_an) (co (co (co Q R c_or) (co T U c_or) c_an) (co (co R P c_or) (co U S c_or) c_an) c_or) c_le) $;

--| Lemma for ~ dalaw . First part of ~ dalawlem13 . (Contributed by NM, 17-Sep-2012.)
theorem dalawlem11 (A2 P Q R S T U c_or K c_le c_an: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (w3a (wcel K chlt) (wbr P (co Q R c_or) c_le) (wbr (co (co P S c_or) (co Q T c_or) c_an) (co R U c_or) c_le)) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wbr (co (co P Q c_or) (co S T c_or) c_an) (co (co (co Q R c_or) (co T U c_or) c_an) (co (co R P c_or) (co U S c_or) c_an) c_or) c_le) $;

--| Lemma for ~ dalaw . Second part of ~ dalawlem13 . (Contributed by NM, 17-Sep-2012.)
theorem dalawlem12 (A2 P Q R S T U c_or K c_le c_an: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (w3a (wcel K chlt) (wceq Q R) (wbr (co (co P S c_or) (co Q T c_or) c_an) (co R U c_or) c_le)) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wbr (co (co P Q c_or) (co S T c_or) c_an) (co (co (co Q R c_or) (co T U c_or) c_an) (co (co R P c_or) (co U S c_or) c_an) c_or) c_le) $;

--| Lemma for ~ dalaw . Special case to eliminate the requirement ` ( ( P .\/ Q ) .\/ R ) e. O ` in ~ dalawlem1 . (Contributed by NM, 6-Oct-2012.)
theorem dalawlem13 (A2 P Q R S T U c_or K c_le c_an O: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq O (cfv K clpl) $ >
  $ wi (w3a (w3a (wcel K chlt) (wn (wcel (co (co P Q c_or) R c_or) O)) (wbr (co (co P S c_or) (co Q T c_or) c_an) (co R U c_or) c_le)) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wbr (co (co P Q c_or) (co S T c_or) c_an) (co (co (co Q R c_or) (co T U c_or) c_an) (co (co R P c_or) (co U S c_or) c_an) c_or) c_le) $;

--| Lemma for ~ dalaw . Combine ~ dalawlem10 and ~ dalawlem13 . (Contributed by NM, 6-Oct-2012.)
theorem dalawlem14 (A2 P Q R S T U c_or K c_le c_an O: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq O (cfv K clpl) $ >
  $ wi (w3a (w3a (wcel K chlt) (wn (wa (wcel (co (co P Q c_or) R c_or) O) (w3a (wn (wbr (co (co P S c_or) (co Q T c_or) c_an) (co P Q c_or) c_le)) (wn (wbr (co (co P S c_or) (co Q T c_or) c_an) (co Q R c_or) c_le)) (wn (wbr (co (co P S c_or) (co Q T c_or) c_an) (co R P c_or) c_le))))) (wbr (co (co P S c_or) (co Q T c_or) c_an) (co R U c_or) c_le)) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wbr (co (co P Q c_or) (co S T c_or) c_an) (co (co (co Q R c_or) (co T U c_or) c_an) (co (co R P c_or) (co U S c_or) c_an) c_or) c_le) $;

--| Lemma for ~ dalaw . Swap variable triples ` P Q R ` and ` S T U ` in ~ dalawlem14 , to obtain the elimination of the remaining conditions in ~ dalawlem1 . (Contributed by NM, 6-Oct-2012.)
theorem dalawlem15 (A2 P Q R S T U c_or K c_le c_an O: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq O (cfv K clpl) $ >
  $ wi (w3a (w3a (wcel K chlt) (wn (wa (wcel (co (co S T c_or) U c_or) O) (w3a (wn (wbr (co (co P S c_or) (co Q T c_or) c_an) (co S T c_or) c_le)) (wn (wbr (co (co P S c_or) (co Q T c_or) c_an) (co T U c_or) c_le)) (wn (wbr (co (co P S c_or) (co Q T c_or) c_an) (co U S c_or) c_le))))) (wbr (co (co P S c_or) (co Q T c_or) c_an) (co R U c_or) c_le)) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wbr (co (co P Q c_or) (co S T c_or) c_an) (co (co (co Q R c_or) (co T U c_or) c_an) (co (co R P c_or) (co U S c_or) c_an) c_or) c_le) $;

--| Desargues's law, derived from Desargues's theorem ~ dath and with no conditions on the atoms. If triples ` <. P , Q , R >. ` and ` <. S , T , U >. ` are centrally perspective, i.e., ` ( ( P .\/ S ) ./\ ( Q .\/ T ) ) .<_ ( R .\/ U ) ` , then they are axially perspective. Theorem 13.3 of [Crawley] p. 110. (Contributed by NM, 7-Oct-2012.)
theorem dalaw (A2 P Q R S T U c_or K c_le c_an: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wi (wbr (co (co P S c_or) (co Q T c_or) c_an) (co R U c_or) c_le) (wbr (co (co P Q c_or) (co S T c_or) c_an) (co (co (co Q R c_or) (co T U c_or) c_an) (co (co R P c_or) (co U S c_or) c_an) c_or) c_le)) $;

--| Extend class notation with projective subspace closure.
term cpclN: class;

--| Projective subspace closure, which is the smallest projective subspace containing an arbitrary set of atoms. The subspace closure of the union of a set of projective subspaces is their supremum in ` PSubSp ` . Related to an analogous definition of closure used in Lemma 3.1.4 of [PtakPulmannova] p. 68. (Note that this closure is not necessarily one of the closed projective subspaces ` PSubCl ` of ~ df-psubclN .) (Contributed by NM, 7-Sep-2013.)
axiom df_pclN {x3 y1 k: setvar}:
  $ wceq cpclN (cmpt k cvv (cmpt x3 (cpw (cfv (cv k) catm)) (cint (crab y1 (wss (cv x3) (cv y1)) (cfv (cv k) cpsubsp))))) $;

--| The projective subspace closure function. (Contributed by NM, 7-Sep-2013.) (New usage is discouraged.)
theorem pclfvalN {x3 y1: setvar} (A2 S: class) (U: class x3 y1) (K: class) (V: class x3 y1):
  $ wceq A2 (cfv K catm) $ >
  $ wceq S (cfv K cpsubsp) $ >
  $ wceq U (cfv K cpclN) $ >
  $ wi (wcel K V) (wceq U (cmpt x3 (cpw A2) (cint (crab y1 (wss (cv x3) (cv y1)) S)))) $;

--| Value of the projective subspace closure function. (Contributed by NM, 7-Sep-2013.) (New usage is discouraged.)
theorem pclvalN {y1: setvar} (A2 S: class) (U: class y1) (K: class) (V: class y1) (X: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq S (cfv K cpsubsp) $ >
  $ wceq U (cfv K cpclN) $ >
  $ wi (wa (wcel K V) (wss X A2)) (wceq (cfv X U) (cint (crab y1 (wss X (cv y1)) S))) $;

--| Closure of the projective subspace closure function. (Contributed by NM, 8-Sep-2013.) (New usage is discouraged.)
theorem pclclN (A2 S U K V X: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq S (cfv K cpsubsp) $ >
  $ wceq U (cfv K cpclN) $ >
  $ wi (wa (wcel K V) (wss X A2)) (wcel (cfv X U) S) $;

--| Membership in the projective subspace closure function. (Contributed by NM, 13-Sep-2013.) (New usage is discouraged.)
theorem elpclN {y1: setvar} (A2 Q S: class) (U: class y1) (K V X: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq S (cfv K cpsubsp) $ >
  $ wceq U (cfv K cpclN) $ >
  $ wcel Q cvv $ >
  $ wi (wa (wcel K V) (wss X A2)) (wb (wcel Q (cfv X U)) (wral y1 (wi (wss X (cv y1)) (wcel Q (cv y1))) S)) $;

--| Implication of membership in the projective subspace closure function. (Contributed by NM, 13-Sep-2013.) (New usage is discouraged.)
theorem elpcliN (Q S U K V X Y: class):
  $ wceq S (cfv K cpsubsp) $ >
  $ wceq U (cfv K cpclN) $ >
  $ wi (wa (w3a (wcel K V) (wss X Y) (wcel Y S)) (wcel Q (cfv X U))) (wcel Q Y) $;

--| Ordering is preserved by subspace closure. (Contributed by NM, 8-Sep-2013.) (New usage is discouraged.)
theorem pclssN (A2 U K V X Y: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq U (cfv K cpclN) $ >
  $ wi (w3a (wcel K V) (wss X Y) (wss Y A2)) (wss (cfv X U) (cfv Y U)) $;

--| A set of atoms is included in its projective subspace closure. (Contributed by NM, 12-Sep-2013.) (New usage is discouraged.)
theorem pclssidN (A2 U K V X: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq U (cfv K cpclN) $ >
  $ wi (wa (wcel K V) (wss X A2)) (wss X (cfv X U)) $;

--| The projective subspace closure of a projective subspace is itself. (Contributed by NM, 8-Sep-2013.) (New usage is discouraged.)
theorem pclidN (S U K V X: class):
  $ wceq S (cfv K cpsubsp) $ >
  $ wceq U (cfv K cpclN) $ >
  $ wi (wa (wcel K V) (wcel X S)) (wceq (cfv X U) X) $;

--| A projective subspace sandwiched between a set of atoms and the set's projective subspace closure equals the closure. (Contributed by NM, 8-Sep-2013.) (New usage is discouraged.)
theorem pclbtwnN (S U K V X Y: class):
  $ wceq S (cfv K cpsubsp) $ >
  $ wceq U (cfv K cpclN) $ >
  $ wi (wa (wa (wcel K V) (wcel X S)) (wa (wss Y X) (wss X (cfv Y U)))) (wceq X (cfv Y U)) $;

--| The projective subspace closure of the union of two sets of atoms equals the closure of their projective sum. (Contributed by NM, 12-Sep-2013.) (New usage is discouraged.)
theorem pclunN (A2 c_pl U K V X Y: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wceq U (cfv K cpclN) $ >
  $ wi (w3a (wcel K V) (wss X A2) (wss Y A2)) (wceq (cfv (cun X Y) U) (cfv (co X Y c_pl) U)) $;

--| The projective subspace closure of the union of two subspaces equals their projective sum. (Contributed by NM, 12-Sep-2013.) (New usage is discouraged.)
theorem pclun2N (c_pl S U K X Y: class):
  $ wceq S (cfv K cpsubsp) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wceq U (cfv K cpclN) $ >
  $ wi (w3a (wcel K chlt) (wcel X S) (wcel Y S)) (wceq (cfv (cun X Y) U) (co X Y c_pl)) $;

--| The projective subspace closure of a set equals the union of the closures of its finite subsets. Analogous to Lemma 3.3.6 of [PtakPulmannova] p. 72. Compare the closed subspace version ~ pclfinclN . (Contributed by NM, 10-Sep-2013.) (New usage is discouraged.)
theorem pclfinN {y1: setvar} (A2 U K X: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq U (cfv K cpclN) $ >
  $ wi (wa (wcel K cal) (wss X A2)) (wceq (cfv X U) (ciun y1 (cin cfn (cpw X)) (cfv (cv y1) U))) $;

--| The set of projective subspaces is compactly atomistic: if an atom is in the projective subspace closure of a set of atoms, it also belongs to the projective subspace closure of a finite subset of that set. Analogous to Lemma 3.3.10 of [PtakPulmannova] p. 74. (Contributed by NM, 10-Sep-2013.) (New usage is discouraged.)
theorem pclcmpatN {y1: setvar} (A2 P U K X: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq U (cfv K cpclN) $ >
  $ wi (w3a (wcel K cal) (wss X A2) (wcel P (cfv X U))) (wrex y1 (wa (wss (cv y1) X) (wcel P (cfv (cv y1) U))) cfn) $;

--| Extend class notation with polarity of projective subspace $m$.
term cpolN: class;

--| Define polarity of projective subspace, which is a kind of complement of the subspace. Item 2 in [Holland95] p. 222 bottom. For more generality, we define it for all subsets of atoms, not just projective subspaces. The intersection with ` Atoms `` l ` ensures it is defined when ` m = (/) ` . (Contributed by NM, 23-Oct-2011.)
axiom df_polarityN {m p l: setvar}:
  $ wceq cpolN (cmpt l cvv (cmpt m (cpw (cfv (cv l) catm)) (cin (cfv (cv l) catm) (ciin p (cv m) (cfv (cfv (cv p) (cfv (cv l) coc)) (cfv (cv l) cpmap)))))) $;

--| The projective subspace polarity function. (Contributed by NM, 23-Oct-2011.) (New usage is discouraged.)
theorem polfvalN {m p: setvar} (A2: class p) (B2 P: class m p) (K: class) (M c_pe: class m p):
  $ wceq c_pe (cfv K coc) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wceq P (cfv K cpolN) $ >
  $ wi (wcel K B2) (wceq P (cmpt m (cpw A2) (cin A2 (ciin p (cv m) (cfv (cfv (cv p) c_pe) M))))) $;

--| Value of the projective subspace polarity function. (Contributed by NM, 23-Oct-2011.) (New usage is discouraged.)
theorem polvalN {p: setvar} (A2 B2 P: class p) (K: class) (M c_pe: class p) (X: class):
  $ wceq c_pe (cfv K coc) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wceq P (cfv K cpolN) $ >
  $ wi (wa (wcel K B2) (wss X A2)) (wceq (cfv X P) (cin A2 (ciin p X (cfv (cfv (cv p) c_pe) M)))) $;

--| Alternate expression for value of the projective subspace polarity function. Equation for polarity in [Holland95] p. 223. (Contributed by NM, 22-Jan-2012.) (New usage is discouraged.)
theorem polval2N (A2 P U K M c_pe X: class):
  $ wceq U (cfv K club) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wceq P (cfv K cpolN) $ >
  $ wi (wa (wcel K chlt) (wss X A2)) (wceq (cfv X P) (cfv (cfv (cfv X U) c_pe) M)) $;

--| The polarity of a set of atoms is a projective subspace. (Contributed by NM, 23-Jan-2012.) (New usage is discouraged.)
theorem polsubN (A2 S K c_pe X: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq S (cfv K cpsubsp) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wi (wa (wcel K chlt) (wss X A2)) (wcel (cfv X c_pe) S) $;

--| The polarity of a set of atoms is a set of atoms. (Contributed by NM, 24-Jan-2012.) (New usage is discouraged.)
theorem polssatN (A2 K c_pe X: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wi (wa (wcel K chlt) (wss X A2)) (wss (cfv X c_pe) A2) $;

--| The polarity of the empty projective subspace is the whole space. (Contributed by NM, 29-Oct-2011.) (New usage is discouraged.)
theorem pol0N (A2 B2 K c_pe: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wi (wcel K B2) (wceq (cfv c0 c_pe) A2) $;

--| The polarity of the whole projective subspace is the empty space. Remark in [Holland95] p. 223. (Contributed by NM, 24-Jan-2012.) (New usage is discouraged.)
theorem pol1N (A2 K c_pe: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wi (wcel K chlt) (wceq (cfv A2 c_pe) c0) $;

--| The closed subspace closure of the empty set. (Contributed by NM, 12-Sep-2013.) (New usage is discouraged.)
theorem _2pol0N (K c_pe: class):
  $ wceq c_pe (cfv K cpolN) $ >
  $ wi (wcel K chlt) (wceq (cfv (cfv c0 c_pe) c_pe) c0) $;

--| The polarity of a projective map. (Contributed by NM, 24-Jan-2012.) (New usage is discouraged.)
theorem polpmapN (B2 P K M c_pe X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wceq P (cfv K cpolN) $ >
  $ wi (wa (wcel K chlt) (wcel X B2)) (wceq (cfv (cfv X M) P) (cfv (cfv X c_pe) M)) $;

--| Double polarity of a projective map. (Contributed by NM, 24-Jan-2012.) (New usage is discouraged.)
theorem _2polpmapN (B2 K M c_pe X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wi (wa (wcel K chlt) (wcel X B2)) (wceq (cfv (cfv (cfv X M) c_pe) c_pe) (cfv X M)) $;

--| Value of double polarity. (Contributed by NM, 25-Jan-2012.) (New usage is discouraged.)
theorem _2polvalN (A2 U K M c_pe X: class):
  $ wceq U (cfv K club) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wi (wa (wcel K chlt) (wss X A2)) (wceq (cfv (cfv X c_pe) c_pe) (cfv (cfv X U) M)) $;

--| A set of atoms is a subset of its double polarity. (Contributed by NM, 29-Jan-2012.) (New usage is discouraged.)
theorem _2polssN (A2 K c_pe X: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wi (wa (wcel K chlt) (wss X A2)) (wss X (cfv (cfv X c_pe) c_pe)) $;

--| Triple polarity cancels to a single polarity. (Contributed by NM, 6-Mar-2012.) (New usage is discouraged.)
theorem _3polN (A2 S K c_pe: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wi (wa (wcel K chlt) (wss S A2)) (wceq (cfv (cfv (cfv S c_pe) c_pe) c_pe) (cfv S c_pe)) $;

--| Contraposition law for polarity. Remark in [Holland95] p. 223. (Contributed by NM, 23-Mar-2012.) (New usage is discouraged.)
theorem polcon3N (A2 K c_pe X Y: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wi (w3a (wcel K chlt) (wss Y A2) (wss X Y)) (wss (cfv Y c_pe) (cfv X c_pe)) $;

--| Contraposition law for polarity. (Contributed by NM, 6-Mar-2012.) (New usage is discouraged.)
theorem _2polcon4bN (A2 K c_pe X Y: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wi (w3a (wcel K chlt) (wss X A2) (wss Y A2)) (wb (wss (cfv (cfv X c_pe) c_pe) (cfv (cfv Y c_pe) c_pe)) (wss (cfv Y c_pe) (cfv X c_pe))) $;

--| Contraposition law for polarity. (Contributed by NM, 23-Mar-2012.) (New usage is discouraged.)
theorem polcon2N (A2 K c_pe X Y: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wi (w3a (wcel K chlt) (wss Y A2) (wss X (cfv Y c_pe))) (wss Y (cfv X c_pe)) $;

--| Contraposition law for polarity. (Contributed by NM, 23-Mar-2012.) (New usage is discouraged.)
theorem polcon2bN (A2 K c_pe X Y: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wi (w3a (wcel K chlt) (wss X A2) (wss Y A2)) (wb (wss X (cfv Y c_pe)) (wss Y (cfv X c_pe))) $;

--| The projective subspace closure is a subset of closed subspace closure. (Contributed by NM, 12-Sep-2013.) (New usage is discouraged.)
theorem pclss2polN (A2 U K c_pe X: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wceq U (cfv K cpclN) $ >
  $ wi (wa (wcel K chlt) (wss X A2)) (wss (cfv X U) (cfv (cfv X c_pe) c_pe)) $;

--| The projective subspace closure of the empty subspace. (Contributed by NM, 12-Sep-2013.) (New usage is discouraged.)
theorem pcl0N (U K: class):
  $ wceq U (cfv K cpclN) $ >
  $ wi (wcel K chlt) (wceq (cfv c0 U) c0) $;

--| The projective subspace closure of the empty subspace. (Contributed by NM, 13-Sep-2013.) (New usage is discouraged.)
theorem pcl0bN (A2 P U K: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq U (cfv K cpclN) $ >
  $ wi (wa (wcel K chlt) (wss P A2)) (wb (wceq (cfv P U) c0) (wceq P c0)) $;

--| The LUB of a projective map is the projective map's argument. (Contributed by NM, 13-Mar-2012.) (New usage is discouraged.)
theorem pmaplubN (B2 U K M X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq U (cfv K club) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wi (wa (wcel K chlt) (wcel X B2)) (wceq (cfv (cfv X M) U) X) $;

--| A set of atoms is a subset of the projective map of its LUB. (Contributed by NM, 6-Mar-2012.) (New usage is discouraged.)
theorem sspmaplubN (A2 S U K M: class):
  $ wceq U (cfv K club) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wi (wa (wcel K chlt) (wss S A2)) (wss S (cfv (cfv S U) M)) $;

--| Double projective map of an LUB. (Contributed by NM, 6-Mar-2012.) (New usage is discouraged.)
theorem _2pmaplubN (A2 S U K M: class):
  $ wceq U (cfv K club) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wi (wa (wcel K chlt) (wss S A2)) (wceq (cfv (cfv (cfv (cfv S U) M) U) M) (cfv (cfv S U) M)) $;

--| The closure of the projective sum of two sets of atoms is the same as the closure of their union. (Closure is actually double polarity, which can be trivially inferred from this theorem using ~ fveq2d .) (Contributed by NM, 6-Mar-2012.) (New usage is discouraged.)
theorem paddunN (A2 c_pl S T K c_pe: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wi (w3a (wcel K chlt) (wss S A2) (wss T A2)) (wceq (cfv (co S T c_pl) c_pe) (cfv (cun S T) c_pe)) $;

--| De Morgan's law for polarity of projective sum. ( ~ oldmj1 analog.) (Contributed by NM, 7-Mar-2012.) (New usage is discouraged.)
theorem poldmj1N (A2 c_pl S T K c_pe: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wi (w3a (wcel K chlt) (wss S A2) (wss T A2)) (wceq (cfv (co S T c_pl) c_pe) (cin (cfv S c_pe) (cfv T c_pe))) $;

--| The projective map of the join of two lattice elements. (Contributed by NM, 14-Mar-2012.) (New usage is discouraged.)
theorem pmapj2N (B2 c_pl c_or K M c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wi (w3a (wcel K chlt) (wcel X B2) (wcel Y B2)) (wceq (cfv (co X Y c_or) M) (cfv (cfv (co (cfv X M) (cfv Y M) c_pl) c_pe) c_pe)) $;

--| The projective map of the orthocomplement of the join of two lattice elements. (Contributed by NM, 14-Mar-2012.) (New usage is discouraged.)
theorem pmapocjN (B2 c_pl F c_or K c_an N c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq F (cfv K cpmap) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wceq N (cfv K cpolN) $ >
  $ wi (w3a (wcel K chlt) (wcel X B2) (wcel Y B2)) (wceq (cfv (cfv (co X Y c_or) c_pe) F) (cfv (co (cfv X F) (cfv Y F) c_pl) N)) $;

--| The polarity of the singleton of an atom (i.e. a point). (Contributed by NM, 14-Jan-2012.) (New usage is discouraged.)
theorem polatN (A2 P Q K M c_pe: class):
  $ wceq c_pe (cfv K coc) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wceq P (cfv K cpolN) $ >
  $ wi (wa (wcel K col) (wcel Q A2)) (wceq (cfv (csn Q) P) (cfv (cfv Q c_pe) M)) $;

--| Double polarity of the singleton of an atom (i.e. a point). (Contributed by NM, 25-Jan-2012.) (New usage is discouraged.)
theorem _2polatN (A2 P Q K: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq P (cfv K cpolN) $ >
  $ wi (wa (wcel K chlt) (wcel Q A2)) (wceq (cfv (cfv (csn Q) P) P) (csn Q)) $;

--| The intersection of a set of atoms and its polarity is empty. Definition of nonsingular in [Holland95] p. 214. (Contributed by NM, 29-Jan-2012.) (New usage is discouraged.)
theorem pnonsingN (A2 P K X: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq P (cfv K cpolN) $ >
  $ wi (wa (wcel K chlt) (wss X A2)) (wceq (cin X (cfv X P)) c0) $;

--| Extend class notation with set of all closed projective subspaces for a Hilbert lattice.
term cpscN: class;

--| Define set of all closed projective subspaces, which are those sets of atoms that equal their double polarity. Based on definition in [Holland95] p. 223. (Contributed by NM, 23-Jan-2012.)
axiom df_psubclN {k s1: setvar}:
  $ wceq cpscN (cmpt k cvv (cab s1 (wa (wss (cv s1) (cfv (cv k) catm)) (wceq (cfv (cfv (cv s1) (cfv (cv k) cpolN)) (cfv (cv k) cpolN)) (cv s1))))) $;

--| The set of closed projective subspaces in a Hilbert lattice. (Contributed by NM, 23-Jan-2012.) (New usage is discouraged.)
theorem psubclsetN {s1: setvar} (A2: class) (B2 C: class s1) (K: class) (c_pe: class s1):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wceq C (cfv K cpscN) $ >
  $ wi (wcel K B2) (wceq C (cab s1 (wa (wss (cv s1) A2) (wceq (cfv (cfv (cv s1) c_pe) c_pe) (cv s1))))) $;

--| The predicate "is a closed projective subspace". (Contributed by NM, 23-Jan-2012.) (New usage is discouraged.)
theorem ispsubclN (A2 C D K c_pe X: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wceq C (cfv K cpscN) $ >
  $ wi (wcel K D) (wb (wcel X C) (wa (wss X A2) (wceq (cfv (cfv X c_pe) c_pe) X))) $;

--| Property of a closed projective subspace. (Contributed by NM, 23-Jan-2012.) (New usage is discouraged.)
theorem psubcliN (A2 C D K c_pe X: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wceq C (cfv K cpscN) $ >
  $ wi (wa (wcel K D) (wcel X C)) (wa (wss X A2) (wceq (cfv (cfv X c_pe) c_pe) X)) $;

--| Property of a closed projective subspace. (Contributed by NM, 23-Jan-2012.) (New usage is discouraged.)
theorem psubcli2N (C D K c_pe X: class):
  $ wceq c_pe (cfv K cpolN) $ >
  $ wceq C (cfv K cpscN) $ >
  $ wi (wa (wcel K D) (wcel X C)) (wceq (cfv (cfv X c_pe) c_pe) X) $;

--| A closed projective subspace is a projective subspace. (Contributed by NM, 23-Jan-2012.) (New usage is discouraged.)
theorem psubclsubN (C S K X: class):
  $ wceq S (cfv K cpsubsp) $ >
  $ wceq C (cfv K cpscN) $ >
  $ wi (wa (wcel K chlt) (wcel X C)) (wcel X S) $;

--| A closed projective subspace is a set of atoms. (Contributed by NM, 25-Jan-2012.) (New usage is discouraged.)
theorem psubclssatN (A2 C D K X: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq C (cfv K cpscN) $ >
  $ wi (wa (wcel K D) (wcel X C)) (wss X A2) $;

--| Projective map of the LUB of a closed subspace. (Contributed by NM, 3-Feb-2012.) (New usage is discouraged.)
theorem pmapidclN (C U K M X: class):
  $ wceq U (cfv K club) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wceq C (cfv K cpscN) $ >
  $ wi (wa (wcel K chlt) (wcel X C)) (wceq (cfv (cfv X U) M) X) $;

--| The empty set is a closed projective subspace. (Contributed by NM, 25-Jan-2012.) (New usage is discouraged.)
theorem _0psubclN (C K: class):
  $ wceq C (cfv K cpscN) $ >
  $ wi (wcel K chlt) (wcel c0 C) $;

--| The set of all atoms is a closed projective subspace. (Contributed by NM, 25-Jan-2012.) (New usage is discouraged.)
theorem _1psubclN (A2 C K: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq C (cfv K cpscN) $ >
  $ wi (wcel K chlt) (wcel A2 C) $;

--| A point (singleton of an atom) is a closed projective subspace. (Contributed by NM, 25-Jan-2012.) (New usage is discouraged.)
theorem atpsubclN (A2 C Q K: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq C (cfv K cpscN) $ >
  $ wi (wa (wcel K chlt) (wcel Q A2)) (wcel (csn Q) C) $;

--| A projective map value is a closed projective subspace. (Contributed by NM, 24-Jan-2012.) (New usage is discouraged.)
theorem pmapsubclN (B2 C K M X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wceq C (cfv K cpscN) $ >
  $ wi (wa (wcel K chlt) (wcel X B2)) (wcel (cfv X M) C) $;

--| Alternate predicate for "is a closed projective subspace". Remark in [Holland95] p. 223. (Contributed by NM, 24-Jan-2012.) (New usage is discouraged.)
theorem ispsubcl2N {y1: setvar} (B2: class) (C: class y1) (K M X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wceq C (cfv K cpscN) $ >
  $ wi (wcel K chlt) (wb (wcel X C) (wrex y1 (wceq X (cfv (cv y1) M)) B2)) $;

--| The intersection of two closed subspaces is closed. (Contributed by NM, 25-Mar-2012.) (New usage is discouraged.)
theorem psubclinN (C K X Y: class):
  $ wceq C (cfv K cpscN) $ >
  $ wi (w3a (wcel K chlt) (wcel X C) (wcel Y C)) (wcel (cin X Y) C) $;

--| The projective sum of a closed subspace and an atom is a closed projective subspace. (Contributed by NM, 3-Feb-2012.) (New usage is discouraged.)
theorem paddatclN (A2 C c_pl Q K X: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wceq C (cfv K cpscN) $ >
  $ wi (w3a (wcel K chlt) (wcel X C) (wcel Q A2)) (wcel (co X (csn Q) c_pl) C) $;

--| The projective subspace closure of a finite set of atoms is a closed subspace. Compare the (non-closed) subspace version ~ pclfinN and also ~ pclcmpatN . (Contributed by NM, 13-Sep-2013.) (New usage is discouraged.)
theorem pclfinclN (A2 S U K X: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq U (cfv K cpclN) $ >
  $ wceq S (cfv K cpscN) $ >
  $ wi (w3a (wcel K chlt) (wss X A2) (wcel X cfn)) (wcel (cfv X U) S) $;

--| A line is a closed projective subspace. (Contributed by NM, 25-Jan-2012.) (New usage is discouraged.)
theorem linepsubclN (C K N X: class):
  $ wceq N (cfv K clines) $ >
  $ wceq C (cfv K cpscN) $ >
  $ wi (wa (wcel K chlt) (wcel X N)) (wcel X C) $;

--| A polarity is a closed projective subspace. (Contributed by NM, 24-Jan-2012.) (New usage is discouraged.)
theorem polsubclN (A2 C K c_pe X: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wceq C (cfv K cpscN) $ >
  $ wi (wa (wcel K chlt) (wss X A2)) (wcel (cfv X c_pe) C) $;

--| Orthomodular law for projective lattices. Lemma 3.3(1) in [Holland95] p. 215. (Contributed by NM, 25-Jan-2012.) (New usage is discouraged.)
theorem poml4N (A2 K c_pe X Y: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wi (w3a (wcel K chlt) (wss X A2) (wss Y A2)) (wi (wa (wss X Y) (wceq (cfv (cfv Y c_pe) c_pe) Y)) (wceq (cin (cfv (cin (cfv X c_pe) Y) c_pe) Y) (cfv (cfv X c_pe) c_pe))) $;

--| Orthomodular law for projective lattices. (Contributed by NM, 23-Mar-2012.) (New usage is discouraged.)
theorem poml5N (A2 K c_pe X Y: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wi (w3a (wcel K chlt) (wss Y A2) (wss X (cfv Y c_pe))) (wceq (cin (cfv (cin (cfv X c_pe) (cfv Y c_pe)) c_pe) (cfv Y c_pe)) (cfv (cfv X c_pe) c_pe)) $;

--| Orthomodular law for projective lattices. (Contributed by NM, 25-Mar-2012.) (New usage is discouraged.)
theorem poml6N (C K c_pe X Y: class):
  $ wceq C (cfv K cpscN) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wi (wa (w3a (wcel K chlt) (wcel X C) (wcel Y C)) (wss X Y)) (wceq (cin (cfv (cin (cfv X c_pe) Y) c_pe) Y) X) $;

--| Lemma for ~ osumclN . (Contributed by NM, 25-Mar-2012.) (New usage is discouraged.)
theorem osumcllem1N {p: setvar} (A2 C c_pl U c_or K c_le M c_pe X Y: class p):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wceq C (cfv K cpscN) $ >
  $ wceq M (co X (csn (cv p)) c_pl) $ >
  $ wceq U (cfv (cfv (co X Y c_pl) c_pe) c_pe) $ >
  $ wi (wa (w3a (wcel K chlt) (wss X A2) (wss Y A2)) (wcel (cv p) U)) (wceq (cin U M) M) $;

--| Lemma for ~ osumclN . (Contributed by NM, 25-Mar-2012.) (New usage is discouraged.)
theorem osumcllem2N {p: setvar} (A2 C c_pl U c_or K c_le M c_pe X Y: class p):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wceq C (cfv K cpscN) $ >
  $ wceq M (co X (csn (cv p)) c_pl) $ >
  $ wceq U (cfv (cfv (co X Y c_pl) c_pe) c_pe) $ >
  $ wi (wa (w3a (wcel K chlt) (wss X A2) (wss Y A2)) (wcel (cv p) U)) (wss X (cin U M)) $;

--| Lemma for ~ osumclN . (Contributed by NM, 23-Mar-2012.) (New usage is discouraged.)
theorem osumcllem3N {p: setvar} (A2 C c_pl U c_or K c_le M c_pe X Y: class p):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wceq C (cfv K cpscN) $ >
  $ wceq M (co X (csn (cv p)) c_pl) $ >
  $ wceq U (cfv (cfv (co X Y c_pl) c_pe) c_pe) $ >
  $ wi (w3a (wcel K chlt) (wcel Y C) (wss X (cfv Y c_pe))) (wceq (cin (cfv X c_pe) U) Y) $;

--| Lemma for ~ osumclN . (Contributed by NM, 24-Mar-2012.) (New usage is discouraged.)
theorem osumcllem4N {r q p: setvar} (A2 C c_pl U c_or K c_le M c_pe X Y: class r q p):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wceq C (cfv K cpscN) $ >
  $ wceq M (co X (csn (cv p)) c_pl) $ >
  $ wceq U (cfv (cfv (co X Y c_pl) c_pe) c_pe) $ >
  $ wi (wa (w3a (wcel K chlt) (wss Y A2) (wss X (cfv Y c_pe))) (wa (wcel (cv r) X) (wcel (cv q) Y))) (wne (cv q) (cv r)) $;

--| Lemma for ~ osumclN . (Contributed by NM, 24-Mar-2012.) (New usage is discouraged.)
theorem osumcllem5N {p: setvar} (A2 C c_pl U c_or K c_le M c_pe X Y: class p) (r q: setvar):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wceq C (cfv K cpscN) $ >
  $ wceq M (co X (csn (cv p)) c_pl) $ >
  $ wceq U (cfv (cfv (co X Y c_pl) c_pe) c_pe) $ >
  $ wi (w3a (w3a (wcel K chlt) (wss X A2) (wss Y A2)) (wcel (cv p) A2) (w3a (wcel (cv r) X) (wcel (cv q) Y) (wbr (cv p) (co (cv r) (cv q) c_or) c_le))) (wcel (cv p) (co X Y c_pl)) $;

--| Lemma for ~ osumclN . Use atom exchange ~ hlatexch1 to swap ` p ` and ` q ` . (Contributed by NM, 24-Mar-2012.) (New usage is discouraged.)
theorem osumcllem6N {r q p: setvar} (A2 C c_pl U c_or K c_le M c_pe X Y: class r q p):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wceq C (cfv K cpscN) $ >
  $ wceq M (co X (csn (cv p)) c_pl) $ >
  $ wceq U (cfv (cfv (co X Y c_pl) c_pe) c_pe) $ >
  $ wi (w3a (w3a (wcel K chlt) (wss X A2) (wss Y A2)) (wa (wss X (cfv Y c_pe)) (wcel (cv p) A2)) (w3a (wcel (cv r) X) (wcel (cv q) Y) (wbr (cv q) (co (cv r) (cv p) c_or) c_le))) (wcel (cv p) (co X Y c_pl)) $;

--| Lemma for ~ osumclN . (Contributed by NM, 24-Mar-2012.) (New usage is discouraged.)
theorem osumcllem7N {q p: setvar} (A2: class p) (C: class q p) (c_pl: class p) (U c_or: class q p) (K: class p) (c_le: class q p) (M c_pe X Y: class p):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wceq C (cfv K cpscN) $ >
  $ wceq M (co X (csn (cv p)) c_pl) $ >
  $ wceq U (cfv (cfv (co X Y c_pl) c_pe) c_pe) $ >
  $ wi (w3a (w3a (wcel K chlt) (wss X A2) (wss Y A2)) (w3a (wss X (cfv Y c_pe)) (wne X c0) (wcel (cv p) A2)) (wcel (cv q) (cin Y M))) (wcel (cv p) (co X Y c_pl)) $;

--| Lemma for ~ osumclN . (Contributed by NM, 24-Mar-2012.) (New usage is discouraged.)
theorem osumcllem8N {p: setvar} (A2 C c_pl U c_or K c_le M c_pe X Y: class p):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wceq C (cfv K cpscN) $ >
  $ wceq M (co X (csn (cv p)) c_pl) $ >
  $ wceq U (cfv (cfv (co X Y c_pl) c_pe) c_pe) $ >
  $ wi (w3a (w3a (wcel K chlt) (wss X A2) (wss Y A2)) (w3a (wss X (cfv Y c_pe)) (wne X c0) (wcel (cv p) A2)) (wn (wcel (cv p) (co X Y c_pl)))) (wceq (cin Y M) c0) $;

--| Lemma for ~ osumclN . (Contributed by NM, 24-Mar-2012.) (New usage is discouraged.)
theorem osumcllem9N {p: setvar} (A2 C c_pl U c_or K c_le M c_pe X Y: class p):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wceq C (cfv K cpscN) $ >
  $ wceq M (co X (csn (cv p)) c_pl) $ >
  $ wceq U (cfv (cfv (co X Y c_pl) c_pe) c_pe) $ >
  $ wi (w3a (w3a (wcel K chlt) (wcel X C) (wcel Y C)) (w3a (wss X (cfv Y c_pe)) (wne X c0) (wcel (cv p) U)) (wn (wcel (cv p) (co X Y c_pl)))) (wceq M X) $;

--| Lemma for ~ osumclN . Contradict ~ osumcllem9N . (Contributed by NM, 25-Mar-2012.) (New usage is discouraged.)
theorem osumcllem10N {p: setvar} (A2 C c_pl U c_or K c_le M c_pe X Y: class p):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wceq C (cfv K cpscN) $ >
  $ wceq M (co X (csn (cv p)) c_pl) $ >
  $ wceq U (cfv (cfv (co X Y c_pl) c_pe) c_pe) $ >
  $ wi (w3a (w3a (wcel K chlt) (wss X A2) (wss Y A2)) (wcel (cv p) A2) (wn (wcel (cv p) (co X Y c_pl)))) (wne M X) $;

--| Lemma for ~ osumclN . (Contributed by NM, 25-Mar-2012.) (New usage is discouraged.)
theorem osumcllem11N (C c_pl K c_pe X Y: class):
  $ wceq c_pl (cfv K cpadd) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wceq C (cfv K cpscN) $ >
  $ wi (wa (w3a (wcel K chlt) (wcel X C) (wcel Y C)) (wa (wss X (cfv Y c_pe)) (wne X c0))) (wceq (co X Y c_pl) (cfv (cfv (co X Y c_pl) c_pe) c_pe)) $;

--| Closure of orthogonal sum. If ` X ` and ` Y ` are orthogonal closed projective subspaces, then their sum is closed. (Contributed by NM, 25-Mar-2012.) (New usage is discouraged.)
theorem osumclN (C c_pl K c_pe X Y: class):
  $ wceq c_pl (cfv K cpadd) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wceq C (cfv K cpscN) $ >
  $ wi (wa (w3a (wcel K chlt) (wcel X C) (wcel Y C)) (wss X (cfv Y c_pe))) (wcel (co X Y c_pl) C) $;

--| For orthogonal elements, projective map of join equals projective sum. Compare ~ pmapjoin where only one direction holds. (Contributed by NM, 11-Apr-2012.) (New usage is discouraged.)
theorem pmapojoinN (B2 c_pl c_or K c_le M c_pe X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (w3a (wcel K chlt) (wcel X B2) (wcel Y B2)) (wbr X (cfv Y c_pe) c_le)) (wceq (cfv (co X Y c_or) M) (co (cfv X M) (cfv Y M) c_pl)) $;

--| Excluded middle law for closed projective subspaces, which can be shown to be equivalent to (and derivable from) the orthomodular law ~ poml4N . Lemma 3.3(2) in [Holland95] p. 215, which we prove as a special case of ~ osumclN . (Contributed by NM, 25-Mar-2012.) (New usage is discouraged.)
theorem pexmidN (A2 c_pl K c_pe X: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wi (wa (wa (wcel K chlt) (wss X A2)) (wceq (cfv (cfv X c_pe) c_pe) X)) (wceq (co X (cfv X c_pe) c_pl) A2) $;

--| Lemma for ~ pexmidN . Holland's proof implicitly requires ` q =/= r ` , which we prove here. (Contributed by NM, 2-Feb-2012.) (New usage is discouraged.)
theorem pexmidlem1N {r q p: setvar} (A2 c_pl c_or K c_le M c_pe X: class r q p):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wceq M (co X (csn (cv p)) c_pl) $ >
  $ wi (wa (wa (wcel K chlt) (wss X A2)) (wa (wcel (cv r) X) (wcel (cv q) (cfv X c_pe)))) (wne (cv q) (cv r)) $;

--| Lemma for ~ pexmidN . (Contributed by NM, 2-Feb-2012.) (New usage is discouraged.)
theorem pexmidlem2N {p: setvar} (A2 c_pl c_or K c_le M c_pe X: class p) (r q: setvar):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wceq M (co X (csn (cv p)) c_pl) $ >
  $ wi (wa (w3a (wcel K chlt) (wss X A2) (wcel (cv p) A2)) (w3a (wcel (cv r) X) (wcel (cv q) (cfv X c_pe)) (wbr (cv p) (co (cv r) (cv q) c_or) c_le))) (wcel (cv p) (co X (cfv X c_pe) c_pl)) $;

--| Lemma for ~ pexmidN . Use atom exchange ~ hlatexch1 to swap ` p ` and ` q ` . (Contributed by NM, 2-Feb-2012.) (New usage is discouraged.)
theorem pexmidlem3N {r q p: setvar} (A2 c_pl c_or K c_le M c_pe X: class r q p):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wceq M (co X (csn (cv p)) c_pl) $ >
  $ wi (w3a (w3a (wcel K chlt) (wss X A2) (wcel (cv p) A2)) (wa (wcel (cv r) X) (wcel (cv q) (cfv X c_pe))) (wbr (cv q) (co (cv r) (cv p) c_or) c_le)) (wcel (cv p) (co X (cfv X c_pe) c_pl)) $;

--| Lemma for ~ pexmidN . (Contributed by NM, 2-Feb-2012.) (New usage is discouraged.)
theorem pexmidlem4N {q p: setvar} (A2 c_pl: class p) (c_or: class q p) (K: class p) (c_le: class q p) (M c_pe X: class p):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wceq M (co X (csn (cv p)) c_pl) $ >
  $ wi (wa (w3a (wcel K chlt) (wss X A2) (wcel (cv p) A2)) (wa (wne X c0) (wcel (cv q) (cin (cfv X c_pe) M)))) (wcel (cv p) (co X (cfv X c_pe) c_pl)) $;

--| Lemma for ~ pexmidN . (Contributed by NM, 2-Feb-2012.) (New usage is discouraged.)
theorem pexmidlem5N {p: setvar} (A2 c_pl c_or K c_le M c_pe X: class p):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wceq M (co X (csn (cv p)) c_pl) $ >
  $ wi (wa (w3a (wcel K chlt) (wss X A2) (wcel (cv p) A2)) (wa (wne X c0) (wn (wcel (cv p) (co X (cfv X c_pe) c_pl))))) (wceq (cin (cfv X c_pe) M) c0) $;

--| Lemma for ~ pexmidN . (Contributed by NM, 3-Feb-2012.) (New usage is discouraged.)
theorem pexmidlem6N {p: setvar} (A2 c_pl c_or K c_le M c_pe X: class p):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wceq M (co X (csn (cv p)) c_pl) $ >
  $ wi (wa (w3a (wcel K chlt) (wss X A2) (wcel (cv p) A2)) (w3a (wceq (cfv (cfv X c_pe) c_pe) X) (wne X c0) (wn (wcel (cv p) (co X (cfv X c_pe) c_pl))))) (wceq M X) $;

--| Lemma for ~ pexmidN . Contradict ~ pexmidlem6N . (Contributed by NM, 3-Feb-2012.) (New usage is discouraged.)
theorem pexmidlem7N {p: setvar} (A2 c_pl c_or K c_le M c_pe X: class p):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wceq M (co X (csn (cv p)) c_pl) $ >
  $ wi (wa (w3a (wcel K chlt) (wss X A2) (wcel (cv p) A2)) (w3a (wceq (cfv (cfv X c_pe) c_pe) X) (wne X c0) (wn (wcel (cv p) (co X (cfv X c_pe) c_pl))))) (wne M X) $;

--| Lemma for ~ pexmidN . The contradiction of ~ pexmidlem6N and ~ pexmidlem7N shows that there can be no atom ` p ` that is not in ` X .+ ( ._|_ `` X ) ` , which is therefore the whole atom space. (Contributed by NM, 3-Feb-2012.) (New usage is discouraged.)
theorem pexmidlem8N (A2 c_pl K c_pe X: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wi (wa (wa (wcel K chlt) (wss X A2)) (wa (wceq (cfv (cfv X c_pe) c_pe) X) (wne X c0))) (wceq (co X (cfv X c_pe) c_pl) A2) $;

--| Excluded middle law for closed projective subspaces, which is equivalent to (and derived from) the orthomodular law ~ poml4N . Lemma 3.3(2) in [Holland95] p. 215. In our proof, we use the variables ` X ` , ` M ` , ` p ` , ` q ` , ` r ` in place of Hollands' l, m, P, Q, L respectively. TODO: should we make this obsolete? (Contributed by NM, 3-Feb-2012.) (New usage is discouraged.)
theorem pexmidALTN (A2 c_pl K c_pe X: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wceq c_pe (cfv K cpolN) $ >
  $ wi (wa (wa (wcel K chlt) (wss X A2)) (wceq (cfv (cfv X c_pe) c_pe) X)) (wceq (co X (cfv X c_pe) c_pl) A2) $;

--| Lemma for ~ pl42N . (Contributed by NM, 8-Apr-2012.) (New usage is discouraged.)
theorem pl42lem1N (B2 c_pl F c_or K c_le c_an c_pe V W X Y Z: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq F (cfv K cpmap) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (w3a (wcel K chlt) (wcel X B2) (wcel Y B2)) (w3a (wcel Z B2) (wcel W B2) (wcel V B2))) (wi (wa (wbr X (cfv Y c_pe) c_le) (wbr Z (cfv W c_pe) c_le)) (wceq (cfv (co (co (co (co X Y c_or) Z c_an) W c_or) V c_an) F) (cin (co (cin (co (cfv X F) (cfv Y F) c_pl) (cfv Z F)) (cfv W F) c_pl) (cfv V F)))) $;

--| Lemma for ~ pl42N . (Contributed by NM, 8-Apr-2012.) (New usage is discouraged.)
theorem pl42lem2N (B2 c_pl F c_or K c_le c_an c_pe V W X Y Z: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq F (cfv K cpmap) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (w3a (wcel K chlt) (wcel X B2) (wcel Y B2)) (w3a (wcel Z B2) (wcel W B2) (wcel V B2))) (wss (co (co (cfv X F) (cfv Y F) c_pl) (cin (co (cfv X F) (cfv W F) c_pl) (co (cfv Y F) (cfv V F) c_pl)) c_pl) (cfv (co (co X Y c_or) (co (co X W c_or) (co Y V c_or) c_an) c_or) F)) $;

--| Lemma for ~ pl42N . (Contributed by NM, 8-Apr-2012.) (New usage is discouraged.)
theorem pl42lem3N (B2 c_pl F c_or K c_le c_an c_pe V W X Y Z: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq F (cfv K cpmap) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (w3a (wcel K chlt) (wcel X B2) (wcel Y B2)) (w3a (wcel Z B2) (wcel W B2) (wcel V B2))) (wss (cin (co (cin (co (cfv X F) (cfv Y F) c_pl) (cfv Z F)) (cfv W F) c_pl) (cfv V F)) (cin (co (co (cfv X F) (cfv Y F) c_pl) (cfv W F) c_pl) (co (co (cfv X F) (cfv Y F) c_pl) (cfv V F) c_pl))) $;

--| Lemma for ~ pl42N . (Contributed by NM, 8-Apr-2012.) (New usage is discouraged.)
theorem pl42lem4N (B2 c_pl F c_or K c_le c_an c_pe V W X Y Z: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq F (cfv K cpmap) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (w3a (wcel K chlt) (wcel X B2) (wcel Y B2)) (w3a (wcel Z B2) (wcel W B2) (wcel V B2))) (wi (wa (wbr X (cfv Y c_pe) c_le) (wbr Z (cfv W c_pe) c_le)) (wss (cfv (co (co (co (co X Y c_or) Z c_an) W c_or) V c_an) F) (cfv (co (co X Y c_or) (co (co X W c_or) (co Y V c_or) c_an) c_or) F))) $;

--| Law holding in a Hilbert lattice that fails in orthomodular lattice L42 (Figure 7 in [MegPav2000] p. 2366). (Contributed by NM, 8-Apr-2012.) (New usage is discouraged.)
theorem pl42N (B2 c_or K c_le c_an c_pe V W X Y Z: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wi (wa (w3a (wcel K chlt) (wcel X B2) (wcel Y B2)) (w3a (wcel Z B2) (wcel W B2) (wcel V B2))) (wi (wa (wbr X (cfv Y c_pe) c_le) (wbr Z (cfv W c_pe) c_le)) (wbr (co (co (co (co X Y c_or) Z c_an) W c_or) V c_an) (co (co X Y c_or) (co (co X W c_or) (co Y V c_or) c_an) c_or) c_le)) $;

--| Extend class notation with set of all co-atoms (lattice hyperplanes).
term clh: class;

--| Extend class notation with set of all lattice automorphisms.
term claut: class;

--| Extend class notation with W points.
term cwpointsN: class;

--| Extend class notation with set of all projective automorphisms.
term cpautN: class;

--| Define the set of lattice hyperplanes, which are all lattice elements covered by 1 (i.e., all co-atoms). We call them "hyperplanes" instead of "co-atoms" in analogy with projective geometry hyperplanes. (Contributed by NM, 11-May-2012.)
axiom df_lhyp {x3 k: setvar}:
  $ wceq clh (cmpt k cvv (crab x3 (wbr (cv x3) (cfv (cv k) cp1) (cfv (cv k) ccvr)) (cfv (cv k) cbs))) $;

--| Define set of lattice autoisomorphisms. (Contributed by NM, 11-May-2012.)
axiom df_laut {x3 y1 f2 k: setvar}:
  $ wceq claut (cmpt k cvv (cab f2 (wa (wf1o (cfv (cv k) cbs) (cfv (cv k) cbs) (cv f2)) (wral x3 (wral y1 (wb (wbr (cv x3) (cv y1) (cfv (cv k) cple)) (wbr (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) (cfv (cv k) cple))) (cfv (cv k) cbs)) (cfv (cv k) cbs))))) $;

--| Define W-atoms corresponding to an arbitrary "fiducial (i.e. reference) atom" ` d ` . These are all atoms not in the polarity of ` { d } ) ` , which is the hyperplane determined by ` d ` . Definition of set W in [Crawley] p. 111. (Contributed by NM, 26-Jan-2012.)
axiom df_watsN {k d: setvar}:
  $ wceq cwpointsN (cmpt k cvv (cmpt d (cfv (cv k) catm) (cdif (cfv (cv k) catm) (cfv (csn (cv d)) (cfv (cv k) cpolN))))) $;

--| Define set of all projective automorphisms. This is the intended definition of automorphism in [Crawley] p. 112. (Contributed by NM, 26-Jan-2012.)
axiom df_pautN {x3 y1 f2 k: setvar}:
  $ wceq cpautN (cmpt k cvv (cab f2 (wa (wf1o (cfv (cv k) cpsubsp) (cfv (cv k) cpsubsp) (cv f2)) (wral x3 (wral y1 (wb (wss (cv x3) (cv y1)) (wss (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)))) (cfv (cv k) cpsubsp)) (cfv (cv k) cpsubsp))))) $;

--| The W atoms function. (Contributed by NM, 26-Jan-2012.) (New usage is discouraged.)
theorem watfvalN {d: setvar} (A2: class) (B2 P: class d) (K: class) (W: class d):
  $ wceq A2 (cfv K catm) $ >
  $ wceq P (cfv K cpolN) $ >
  $ wceq W (cfv K cwpointsN) $ >
  $ wi (wcel K B2) (wceq W (cmpt d A2 (cdif A2 (cfv (csn (cv d)) (cfv K cpolN))))) $;

--| Value of the W atoms function. (Contributed by NM, 26-Jan-2012.) (New usage is discouraged.)
theorem watvalN (A2 B2 D P K W: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq P (cfv K cpolN) $ >
  $ wceq W (cfv K cwpointsN) $ >
  $ wi (wa (wcel K B2) (wcel D A2)) (wceq (cfv D W) (cdif A2 (cfv (csn D) (cfv K cpolN)))) $;

--| The predicate "is a W atom" (corresponding to fiducial atom ` D ` ). (Contributed by NM, 26-Jan-2012.) (New usage is discouraged.)
theorem iswatN (A2 B2 D P K W: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq P (cfv K cpolN) $ >
  $ wceq W (cfv K cwpointsN) $ >
  $ wi (wa (wcel K B2) (wcel D A2)) (wb (wcel P (cfv D W)) (wa (wcel P A2) (wn (wcel P (cfv (csn D) (cfv K cpolN)))))) $;

--| The set of co-atoms (lattice hyperplanes). (Contributed by NM, 11-May-2012.)
theorem lhpset {w: setvar} (A2: class w) (B2 C c_1: class) (H: class w) (K: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_1 (cfv K cp1) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wcel K A2) (wceq H (crab w (wbr (cv w) c_1 C) B2)) $;

--| The predicate "is a co-atom (lattice hyperplane)". (Contributed by NM, 11-May-2012.)
theorem islhp (A2 B2 C c_1 H K W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_1 (cfv K cp1) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wcel K A2) (wb (wcel W H) (wa (wcel W B2) (wbr W c_1 C))) $;

--| The predicate "is a co-atom (lattice hyperplane)". (Contributed by NM, 18-May-2012.)
theorem islhp2 (A2 B2 C c_1 H K W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_1 (cfv K cp1) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wa (wcel K A2) (wcel W B2)) (wb (wcel W H) (wbr W c_1 C)) $;

--| A co-atom is a member of the lattice base set (i.e., a lattice element). (Contributed by NM, 18-May-2012.)
theorem lhpbase (B2 H K W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wcel W H) (wcel W B2) $;

--| The lattice unity covers a co-atom (lattice hyperplane). (Contributed by NM, 18-May-2012.)
theorem lhp1cvr (A2 C c_1 H K W: class):
  $ wceq c_1 (cfv K cp1) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wa (wcel K A2) (wcel W H)) (wbr W c_1 C) $;

--| An atom under a co-atom is strictly less than it. TODO: is this needed? (Contributed by NM, 1-Jun-2012.)
theorem lhplt (A2 P c_lt H K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wbr P W c_le))) (wbr P W c_lt) $;

--| The join of two atoms under a co-atom is strictly less than it. (Contributed by NM, 8-Jul-2013.)
theorem lhp2lt (A2 P Q c_lt H c_or K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wbr P W c_le)) (wa (wcel Q A2) (wbr Q W c_le))) (wbr (co P Q c_or) W c_lt) $;

--| There exists an atom less than a co-atom. TODO: is this needed? (Contributed by NM, 1-Jun-2012.)
theorem lhpexlt {p: setvar} (A2 c_lt: class) (H: class p) (K W: class):
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wrex p (wbr (cv p) W c_lt) A2) $;

--| A co-atom is greater than zero. TODO: is this needed? (Contributed by NM, 1-Jun-2012.)
theorem lhp0lt (c_lt H K W c_0: class):
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wbr c_0 W c_lt) $;

--| A co-atom is nonzero. TODO: is this needed? (Contributed by NM, 26-Apr-2013.)
theorem lhpn0 (H K W c_0: class):
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wne W c_0) $;

--| There exists an atom under a co-atom. (Contributed by NM, 26-Apr-2013.)
theorem lhpexle {p: setvar} (A2 H K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wrex p (wbr (cv p) W c_le) A2) $;

--| There exists an atom not under a co-atom. (Contributed by NM, 12-Apr-2013.)
theorem lhpexnle {p: setvar} (A2 H K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wrex p (wn (wbr (cv p) W c_le)) A2) $;

--| Lemma for ~ lhpexle1 and others that eliminates restrictions on ` X ` . (Contributed by NM, 24-Jul-2013.)
theorem lhpexle1lem {p: setvar} (ph: wff) (ps: wff p) (A2 c_le W X: class):
  $ wi ph (wrex p (wa (wbr (cv p) W c_le) ps) A2) $ >
  $ wi (wa ph (wa (wcel X A2) (wbr X W c_le))) (wrex p (w3a (wbr (cv p) W c_le) ps (wne (cv p) X)) A2) $ >
  $ wi ph (wrex p (w3a (wbr (cv p) W c_le) ps (wne (cv p) X)) A2) $;

--| There exists an atom under a co-atom different from any given element. (Contributed by NM, 24-Jul-2013.)
theorem lhpexle1 {p: setvar} (A2 H K c_le W X: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wrex p (wa (wbr (cv p) W c_le) (wne (cv p) X)) A2) $;

--| Lemma for ~ lhpexle2 . (Contributed by NM, 19-Jun-2013.)
theorem lhpexle2lem {p: setvar} (A2 H K c_le W X Y: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel X A2) (wbr X W c_le)) (wa (wcel Y A2) (wbr Y W c_le))) (wrex p (w3a (wbr (cv p) W c_le) (wne (cv p) X) (wne (cv p) Y)) A2) $;

--| There exists atom under a co-atom different from any two other elements. (Contributed by NM, 24-Jul-2013.)
theorem lhpexle2 {p: setvar} (A2 H K c_le W X Y: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wrex p (w3a (wbr (cv p) W c_le) (wne (cv p) X) (wne (cv p) Y)) A2) $;

--| There exists atom under a co-atom different from any three other atoms. TODO: study if adant*, simp* usage can be improved. (Contributed by NM, 9-Jul-2013.)
theorem lhpexle3lem {p: setvar} (A2 H K c_le W X Y Z: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (w3a (wcel X A2) (wcel Y A2) (wcel Z A2)) (w3a (wbr X W c_le) (wbr Y W c_le) (wbr Z W c_le))) (wrex p (wa (wbr (cv p) W c_le) (w3a (wne (cv p) X) (wne (cv p) Y) (wne (cv p) Z))) A2) $;

--| There exists atom under a co-atom different from any three other elements. (Contributed by NM, 24-Jul-2013.)
theorem lhpexle3 {p: setvar} (A2 H K c_le W X Y Z: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wrex p (wa (wbr (cv p) W c_le) (w3a (wne (cv p) X) (wne (cv p) Y) (wne (cv p) Z))) A2) $;

--| There exist at least two different atoms under a co-atom. This allows to create a line under the co-atom. TODO: is this needed? (Contributed by NM, 1-Jun-2012.) (New usage is discouraged.)
theorem lhpex2leN {q p: setvar} (A2 H K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wrex p (wrex q (w3a (wbr (cv p) W c_le) (wbr (cv q) W c_le) (wne (cv p) (cv q))) A2) A2) $;

--| The orthocomplement of a co-atom (lattice hyperplane) is an atom. (Contributed by NM, 18-May-2012.)
theorem lhpoc (A2 B2 H K c_pe W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wa (wcel K chlt) (wcel W B2)) (wb (wcel W H) (wcel (cfv W c_pe) A2)) $;

--| The orthocomplement of an atom is a co-atom (lattice hyperplane). (Contributed by NM, 20-Jun-2012.) (New usage is discouraged.)
theorem lhpoc2N (A2 B2 H K c_pe W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wa (wcel K chlt) (wcel W B2)) (wb (wcel W A2) (wcel (cfv W c_pe) H)) $;

--| The orthocomplement of a co-atom is not under it. (Contributed by NM, 22-May-2012.)
theorem lhpocnle (H K c_le c_pe W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wn (wbr (cfv W c_pe) W c_le)) $;

--| The orthocomplement of a co-atom is an atom. (Contributed by NM, 9-Feb-2013.)
theorem lhpocat (A2 H K c_pe W: class):
  $ wceq c_pe (cfv K coc) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wcel (cfv W c_pe) A2) $;

--| The orthocomplement of a co-atom is an atom not under it. Provides a convenient construction when we need the existence of any object with this property. (Contributed by NM, 25-May-2012.)
theorem lhpocnel (A2 H K c_le c_pe W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wa (wcel (cfv W c_pe) A2) (wn (wbr (cfv W c_pe) W c_le))) $;

--| The orthocomplement of a co-atom is an atom not under it. Provides a convenient construction when we need the existence of any object with this property. (Contributed by NM, 20-Feb-2014.)
theorem lhpocnel2 (A2 P H K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq P (cfv W (cfv K coc)) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) $;

--| The join of a co-atom (hyperplane) and an atom not under it is the lattice unity. (Contributed by NM, 18-May-2012.)
theorem lhpjat1 (A2 P c_1 H c_or K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_1 (cfv K cp1) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le)))) (wceq (co W P c_or) c_1) $;

--| The join of a co-atom (hyperplane) and an atom not under it is the lattice unity. (Contributed by NM, 4-Jun-2012.)
theorem lhpjat2 (A2 P c_1 H c_or K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_1 (cfv K cp1) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le)))) (wceq (co P W c_or) c_1) $;

--| The join of a co-atom (hyperplane) and an element not under it is the lattice unity. (Contributed by NM, 7-Dec-2012.)
theorem lhpj1 (B2 c_1 H c_or K c_le W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_1 (cfv K cp1) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wn (wbr X W c_le)))) (wceq (co W X c_or) c_1) $;

--| The meet of a lattice hyperplane with an element not under it is covered by the element. (Contributed by NM, 7-Dec-2012.)
theorem lhpmcvr (B2 C H K c_le c_an W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wn (wbr X W c_le)))) (wbr (co X W c_an) X C) $;

--| Alternate way to express that the meet of a lattice hyperplane with an element not under it is covered by the element. (Contributed by NM, 9-Apr-2013.)
theorem lhpmcvr2 {p: setvar} (A2 B2: class) (H c_or: class p) (K c_le c_an W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wn (wbr X W c_le)))) (wrex p (wa (wn (wbr (cv p) W c_le)) (wceq (co (cv p) (co X W c_an) c_or) X)) A2) $;

--| Specialization of ~ lhpmcvr2 . TODO: Use this to simplify many uses of ` ( P .\/ ( X ./\ W ) ) = X ` to become ` P .<_ X ` . (Contributed by NM, 6-Apr-2014.)
theorem lhpmcvr3 (A2 B2 P H c_or K c_le c_an W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wn (wbr X W c_le))) (wa (wcel P A2) (wn (wbr P W c_le)))) (wb (wbr P X c_le) (wceq (co P (co X W c_an) c_or) X)) $;

--| Specialization of ~ lhpmcvr2 . (Contributed by NM, 6-Apr-2014.) (New usage is discouraged.)
theorem lhpmcvr4N (A2 B2 P H c_or K c_le c_an W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wa (wcel X B2) (wn (wbr X W c_le))) (wa (wcel P A2) (wn (wbr P W c_le)))) (w3a (wcel Y B2) (wbr (co X Y c_an) W c_le) (wbr P X c_le))) (wn (wbr P Y c_le)) $;

--| Specialization of ~ lhpmcvr2 . (Contributed by NM, 6-Apr-2014.) (New usage is discouraged.)
theorem lhpmcvr5N {p: setvar} (A2 B2 H: class) (c_or: class p) (K c_le c_an W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wn (wbr X W c_le))) (wa (wcel Y B2) (wbr (co X Y c_an) W c_le))) (wrex p (w3a (wn (wbr (cv p) W c_le)) (wn (wbr (cv p) Y c_le)) (wceq (co (cv p) (co X W c_an) c_or) X)) A2) $;

--| Specialization of ~ lhpmcvr2 . (Contributed by NM, 6-Apr-2014.) (New usage is discouraged.)
theorem lhpmcvr6N {p: setvar} (A2 B2 H: class) (c_or: class p) (K c_le c_an W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wn (wbr X W c_le))) (wa (wcel Y B2) (wbr (co X Y c_an) W c_le))) (wrex p (w3a (wn (wbr (cv p) W c_le)) (wn (wbr (cv p) Y c_le)) (wbr (cv p) X c_le)) A2) $;

--| If the meet of a lattice hyperplane with a nonzero element is zero, the element is an atom. (Contributed by NM, 28-Apr-2014.) (New usage is discouraged.)
theorem lhpm0atN (A2 B2 H K c_an W X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (w3a (wcel X B2) (wne X c_0) (wceq (co X W c_an) c_0))) (wcel X A2) $;

--| An element covered by the lattice unity, when conjoined with an atom not under it, equals the lattice zero. (Contributed by NM, 6-Jun-2012.)
theorem lhpmat (A2 P H K c_le c_an W c_0: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le)))) (wceq (co P W c_an) c_0) $;

--| An element covered by the lattice unity, when conjoined with an atom, equals zero iff the atom is not under it. (Contributed by NM, 15-Jun-2013.)
theorem lhpmatb (A2 P H K c_le c_an W c_0: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel P A2)) (wb (wn (wbr P W c_le)) (wceq (co P W c_an) c_0)) $;

--| Join and meet with different atoms under co-atom ` W ` . (Contributed by NM, 15-Jun-2013.)
theorem lhp2at0 (A2 P U H c_or K c_le c_an V W c_0: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (w3a (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wne U V)) (wa (wcel U A2) (wbr U W c_le)) (wa (wcel V A2) (wbr V W c_le))) (wceq (co (co P U c_or) V c_an) c_0) $;

--| Inequality for 2 different atoms under co-atom ` W ` . (Contributed by NM, 17-Jun-2013.)
theorem lhp2atnle (A2 P U H c_or K c_le V W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (w3a (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wne U V)) (wa (wcel U A2) (wbr U W c_le)) (wa (wcel V A2) (wbr V W c_le))) (wn (wbr V (co P U c_or) c_le)) $;

--| Inequality for joins with 2 different atoms under co-atom ` W ` . (Contributed by NM, 22-Jul-2013.)
theorem lhp2atne (A2 P Q U H c_or K c_le V W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (w3a (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wcel Q A2)) (wa (wa (wcel U A2) (wbr U W c_le)) (wa (wcel V A2) (wbr V W c_le))) (wne U V)) (wne (co P U c_or) (co Q V c_or)) $;

--| Inequality for 2 different atoms (or an atom and zero) under co-atom ` W ` . (Contributed by NM, 28-Jul-2013.)
theorem lhp2at0nle (A2 P U H c_or K c_le V W c_0: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (w3a (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wne U V)) (wa (wo (wcel U A2) (wceq U c_0)) (wbr U W c_le)) (wa (wcel V A2) (wbr V W c_le))) (wn (wbr V (co P U c_or) c_le)) $;

--| Inequality for joins with 2 different atoms (or an atom and zero) under co-atom ` W ` . (Contributed by NM, 28-Jul-2013.)
theorem lhp2at0ne (A2 P Q U H c_or K c_le V W c_0: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (w3a (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wcel Q A2)) (wa (wa (wo (wcel U A2) (wceq U c_0)) (wbr U W c_le)) (wa (wcel V A2) (wbr V W c_le))) (wne U V)) (wne (co P U c_or) (co Q V c_or)) $;

--| Eliminate an atom not under a lattice hyperplane. TODO: Look at proofs using ~ lhpmat to see if this can be used to shorten them. (Contributed by NM, 27-Apr-2013.)
theorem lhpelim (A2 B2 P H c_or K c_le c_an W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wcel X B2)) (wceq (co (co P (co X W c_an) c_or) W c_an) (co X W c_an)) $;

--| Modular law for hyperplanes analogous to ~ atmod2i2 for atoms. (Contributed by NM, 9-Feb-2013.)
theorem lhpmod2i2 (B2 H c_or K c_le c_an W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wcel Y B2)) (wbr Y X c_le)) (wceq (co (co X W c_an) Y c_or) (co X (co W Y c_or) c_an)) $;

--| Modular law for hyperplanes analogous to complement of ~ atmod2i1 for atoms. (Contributed by NM, 1-Jun-2013.)
theorem lhpmod6i1 (B2 H c_or K c_le c_an W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wcel Y B2)) (wbr X W c_le)) (wceq (co X (co Y W c_an) c_or) (co (co X Y c_or) W c_an)) $;

--| The Hilbert lattice is relatively atomic with respect to co-atoms (lattice hyperplanes). Dual version of ~ hlrelat3 . (Contributed by NM, 20-Jun-2012.) (New usage is discouraged.)
theorem lhprelat3N {w: setvar} (B2: class w) (C: class) (c_lt: class w) (H K c_le c_an X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wa (w3a (wcel K chlt) (wcel X B2) (wcel Y B2)) (wbr X Y c_lt)) (wrex w (wa (wbr X (co Y (cv w) c_an) c_le) (wbr (co Y (cv w) c_an) Y C)) H) $;

--| Given two atoms not under the fiducial (reference) co-atom ` W ` , there is a third. Lemma B in [Crawley] p. 112. (Contributed by NM, 30-May-2012.)
theorem cdlemb2 {r: setvar} (A2 P Q: class) (H: class r) (c_or K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wne P Q)) (wrex r (wa (wn (wbr (cv r) W c_le)) (wn (wbr (cv r) (co P Q c_or) c_le))) A2) $;

--| Property of a lattice element under a co-atom. (Contributed by NM, 28-Feb-2014.)
theorem lhple (A2 B2 P H c_or K c_le c_an W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel X B2) (wbr X W c_le))) (wceq (co (co P X c_or) W c_an) X) $;

--| Create an atom under a co-atom. Part of proof of Lemma B in [Crawley] p. 112. (Contributed by NM, 23-May-2012.)
theorem lhpat (A2 P Q H c_or K c_le c_an W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wne P Q))) (wcel (co (co P Q c_or) W c_an) A2) $;

--| Property of an atom under a co-atom. (Contributed by NM, 24-Nov-2013.) (New usage is discouraged.)
theorem lhpat4N (A2 P U H c_or K c_le c_an W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel U A2) (wbr U W c_le))) (wceq (co (co P U c_or) W c_an) U) $;

--| Create an atom under a co-atom. Part of proof of Lemma B in [Crawley] p. 112. (Contributed by NM, 21-Nov-2012.)
theorem lhpat2 (A2 P Q R H c_or K c_le c_an W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq R (co (co P Q c_or) W c_an) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wne P Q))) (wcel R A2) $;

--| There is only one atom under both ` P .\/ Q ` and co-atom ` W ` . (Contributed by NM, 21-Nov-2012.)
theorem lhpat3 (A2 P Q R S H c_or K c_le c_an W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq R (co (co P Q c_or) W c_an) $ >
  $ wi (w3a (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le)))) (wa (wcel Q A2) (wcel S A2)) (wa (wne P Q) (wbr S (co P Q c_or) c_le))) (wb (wn (wbr S W c_le)) (wne S R)) $;

--| Lemma for ~ 4atexlem7 . (Contributed by NM, 23-Nov-2012.)
theorem _4atexlemk (ph: wff) (A2 P Q R S T U H c_or K c_le V W: class):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (w3a (wcel S A2) (w3a (wcel R A2) (wn (wbr R W c_le)) (wceq (co P R c_or) (co Q R c_or))) (wa (wcel T A2) (wceq (co U T c_or) (co V T c_or)))) (wa (wne P Q) (wn (wbr S (co P Q c_or) c_le)))) $ >
  $ wi ph (wcel K chlt) $;


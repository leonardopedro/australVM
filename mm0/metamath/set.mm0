  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq F (cfv U csca) $ >
  $ wceq R (cfv F cbs) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq V (cfv C cbs) $ >
  $ wceq c_x (cfv C cvsca) $ >
  $ wceq S (cfv C clss) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel L S) $ >
  $ wi ph (wcel X R) $ >
  $ wi ph (wcel Y L) $ >
  $ wi ph (wcel (co X Y c_x) L) $;

--| Associative law for scalar product in a closed kernel dual vector space. (Contributed by NM, 20-Mar-2015.)
theorem lcdvsass (ph: wff) (C R c_xb c_x U F G H K L W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq L (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq F (cfv C cbs) $ >
  $ wceq c_xb (cfv C cvsca) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X L) $ >
  $ wi ph (wcel Y L) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wceq (co (co Y X c_x) G c_xb) (co X (co Y G c_xb) c_xb)) $;

--| The zero scalar of the closed kernel dual of a vector space. (Contributed by NM, 20-Mar-2015.)
theorem lcd0 (ph: wff) (C S U F H K O W c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq F (cfv U csca) $ >
  $ wceq c_0 (cfv F c0g) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq S (cfv C csca) $ >
  $ wceq O (cfv S c0g) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wceq O c_0) $;

--| The unit scalar of the closed kernel dual of a vector space. (Contributed by NM, 20-Mar-2015.)
theorem lcd1 (ph: wff) (C S U c_1 F H I K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >

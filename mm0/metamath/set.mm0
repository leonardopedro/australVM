 e. A ph ` </td><td>Yes</td> <td> ~ nfreud , ~ reurex </td></tr> <tr><td>rex</td><td>restricted existential quantification</td> <td> ~ df-rex </td><td> ` E. x e. A ph ` </td><td>Yes</td> <td> ~ rexnal , ~ rexrnmpo </td></tr> <tr><td>rmo</td><td>restricted "at most one"</td> <td> ~ df-rmo </td><td> ` E* x e. A ph ` </td><td>Yes</td> <td> ~ nfrmod , ~ nrexrmo </td></tr> <tr><td>rn</td><td>range</td><td> ~ df-rn </td><td> ` ran A ` </td> <td>Yes</td><td> ~ elrng , ~ rncnvcnv </td></tr> <tr><td>ring</td><td>(unital) ring</td><td> ~ df-ring </td> <td> ` Ring ` </td><td>Yes</td> <td> ~ ringidval , ~ isring , ~ ringgrp </td></tr> <tr><td>rng</td><td>non-unital ring</td><td> ~ df-rng </td> <td> ` Rng ` </td><td>Yes</td> <td> ~ isrng , ~ rngabl , ~ rnglz </td></tr> <tr><td>rot</td><td>rotation</td><td> </td> <td> </td><td>No</td><td> ~ 3anrot , ~ 3orrot </td></tr> <tr><td>s</td><td>eliminates need for syllogism (suffix)</td> <td> </td> <td> </td><td>No</td><td> ~ ancoms </td></tr> <tr><td>sb</td><td>(proper) substitution (of a set)</td> <td> ~ df-sb </td><td> ` [ y / x ] ph ` </td><td>Yes</td> <td> ~ spsbe , ~ sbimi </td></tr> <tr><td>sbc</td><td>(proper) substitution of a class</td> <td> ~ df-sbc </td><td> ` [. A / x ]. ph ` </td><td>Yes</td> <td> ~ sbc2or , ~ sbcth </td></tr> <tr><td>sca</td><td>scalar</td><td> ~ df-sca </td> <td> ` ( Scalar `` H ) ` </td><td>Yes</td> <td> ~ resssca , ~ mgpsca </td></tr> <tr><td>simp</td><td>simple, simplification</td><td> </td> <td> </td><td>No</td><td> ~ simpl , ~ simp3r3 </td></tr> <tr><td>sn</td><td>singleton</td><td> ~ df-sn </td> <td> ` { A } ` </td><td>Yes</td><td> ~ eldifsn </td></tr> <tr><td>sp</td><td>specialization</td><td> </td> <td> </td><td>No</td><td> ~ spsbe , ~ spei </td></tr> <tr><td>ss</td><td>subset</td><td> ~ df-ss </td> <td> ` A C_ B ` </td><td>Yes</td><td> ~ difss </td></tr> <tr><td>struct</td><td>structure</td><td> ~ df-struct </td> <td> ` Struct ` </td><td>Yes</td><td> ~ brstruct , ~ structfn </td></tr> <tr><td>sub</td><td>subtract</td><td> ~ df-sub </td> <td> ` ( A - B ) ` </td><td>Yes</td> <td> ~ subval , ~ subaddi </td></tr> <tr><td>sup</td><td>supremum</td><td> ~ df-sup </td> <td> ` sup ( A , B , < ) ` </td><td>Yes</td> <td> ~ fisupcl , ~ supmo </td></tr> <tr><td>supp</td><td>support (of a function)</td><td> ~ df-supp </td> <td> ` ( F supp Z ) ` </td><td>Yes</td> <td> ~ ressuppfi , ~ mptsuppd </td></tr> <tr><td>swap</td><td>swap (two parts within a theorem)</td> <td> </td><td> </td><td>No</td><td> ~ rabswap , ~ 2reuswap </td></tr> <tr><td>syl</td><td>syllogism</td><td> ~ syl </td> <td> </td><td>No</td><td> ~ 3syl </td></tr> <tr><td>sym</td><td>symmetric</td><td> </td> <td> </td><td>No</td><td> ~ df-symdif , ~ cnvsym </td></tr> <tr><td>symg</td><td>symmetric group</td><td> ~ df-symg </td> <td> ` ( SymGrp `` A ) ` </td><td>Yes</td> <td> ~ symghash , ~ pgrpsubgsymg </td></tr> <tr><td><b>t</b></td> <td>times (see "mul"), for all-constant theorems</td> <td> ~ df-mul </td> <td> ` ( 3 x. 2 ) = 6 ` </td><td>Yes</td> <td> ~ 3t2e6 </td></tr> <tr> <td>th, t</td> <td>theorem</td> <td></td> <td></td> <td>No</td> <td> ~ nfth , ~ sbcth , ~ weth , ~ ancomst </td> </tr> <tr><td>tp</td><td>triple</td><td> ~ df-tp </td> <td> ` { A , B , C } ` </td><td>Yes</td> <td> ~ eltpi , ~ tpeq1 </td></tr> <tr><td>tr</td><td>transitive</td><td> </td> <td> </td><td>No</td><td> ~ bitrd , ~ biantr </td></tr> <tr> <td>tru, t</td> <td>true, truth</td> <td> ~ df-tru </td> <td> ` T. ` </td> <td>Yes</td> <td> ~ bitru , ~ truanfal , ~ biimt </td> </tr> <tr><td>un</td><td>union</td><td> ~ df-un </td> <td> ` ( A u. B ) ` </td><td>Yes</td> <td> ~ uneqri , ~ uncom </td></tr> <tr><td>unit</td><td>unit (in a ring)</td> <td> ~ df-unit </td><td> ` ( Unit `` R ) ` </td><td>Yes</td> <td> ~ isunit , ~ nzrunit </td></tr> <tr> <td>v</td> <td>set<b>v</b>ar (especially for specializations of theorems when a class is replaced by a setvar variable)</td> <td></td> <td>x</td> <td>Yes</td> <td> ~ cv , ~ vex , ~ velpw , ~ vtoclf </td> </tr> <tr> <td>v</td> <td>disjoint variable condition used in place of nonfreeness hypothesis (suffix)</td> <td></td> <td></td> <td>No</td> <td> ~ spimv </td> </tr> <tr> <td>vtx</td> <td>vertex</td> <td> ~ df-vtx </td> <td> ` ( Vtx `` G ) ` </td> <td>Yes</td> <td> ~ vtxval0 , ~ opvtxov </td> </tr> <tr> <td>vv</td> <td>two disjoint variable conditions used in place of nonfreeness hypotheses (suffix)</td> <td></td> <td></td> <td>No</td> <td> ~ 19.23vv </td> </tr> <tr><td>w</td><td>weak (version of a theorem) (suffix)</td><td> </td> <td> </td><td>No</td><td> ~ ax11w , ~ spnfw </td></tr> <tr><td><b>wrd</b></td><td>word</td> <td> ~ df-word </td><td> ` Word S ` </td><td>Yes</td> <td> ~ iswrdb , ~ wrdfn , ~ ffz0iswrd </td></tr> <tr><td>xp</td><td>cross product (Cartesian product)</td> <td> ~ df-xp </td><td> ` ( A X. B ) ` </td><td>Yes</td> <td> ~ elxp , ~ opelxpi , ~ xpundi </td></tr> <tr><td>xr</td><td>eXtended reals</td><td> ~ df-xr </td> <td> ` RR* ` </td><td>Yes</td><td> ~ ressxr , ~ rexr , ~ 0xr </td></tr> <tr><td>z</td><td> integers (from German "Zahlen")</td> <td> ~ df-z </td><td> ` ZZ ` </td><td>Yes</td> <td> ~ elz , ~ zcn </td></tr> <tr><td>zn</td><td> ring of integers ` mod N ` </td><td> ~ df-zn </td> <td> ` ( Z/nZ `` N ) ` </td><td>Yes</td> <td> ~ znval , ~ zncrng , ~ znhash </td></tr> <tr><td>zring</td><td>ring of integers</td><td> ~ df-zring </td> <td> ` ZZring ` </td><td>Yes</td><td> ~ zringbas , ~ zringcrng </td></tr> <tr><td><b>0, z</b></td> <td>slashed zero (empty set)</td><td> ~ df-nul </td> <td> ` (/) ` </td><td>Yes</td> <td> ~ n0i , ~ vn0 ; ~ snnz , ~ prnz </td></tr> </table> </HTML> (Contributed by the Metamath team, 27-Dec-2016.) Date of last revision. (Revised by the Metamath team, 22-Sep-2022.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem conventions_labels (ph: wff):
  $ ph $ >
  $ ph $;

--| <HTML> <p> The following gives conventions used in the Metamath Proof Explorer (MPE, set.mm) regarding comments, and more generally nonmathematical conventions. For other conventions, see ~ conventions and links therein. </p> <ul> <li><b>Input format.</b> <p> The input format is ASCII. Tab characters are not allowed. If non-ASCII characters have to be displayed in comments, use embedded mathematical symbols when they have been defined (e.g., "`` -> ``" for " ` -> ` ") or HTML entities (e.g., "&amp;eacute;" for "&eacute;"). Default indentation is by two spaces. Lines are hard-wrapped to be at most 79-character long, excluding the newline character (this can be achieved, except currently for section comments, by the Metamath program "MM> WRITE SOURCE set.mm / REWRAP" command or by running the script scripts/rewrap). The file ends with an empty line. There are no trailing spaces. As for line wrapping in statements, we try to break lines before the most important token. </p> </li> <li><b>Language and spelling.</b> <p> The MPE uses American English, e.g., we write "neighborhood" instead of the British English "neighbourhood". An exception is the word "analog", which can be either a noun or an adjective (furthermore, "analog" has the confounding meaning "not digital"); therefore, "analogue" is used for the noun and "analogous" for the adjective. We favor regular plurals, e.g., "formulas" instead of "formulae", "lemmas" instead of "lemmata". We use the serial comma (Oxford comma) in enumerations. We use commas after "i.e." and "e.g.". </p> <p> We avoid beginning a sentence with a symbol (for instance, by writing "The function F is ..." instead of "F is...").</p> <p> Since comments may contain many space-separated symbols, we use the older convention of two spaces after a period ending a sentence, to better separate sentences (this is also achieved by the Metamath program "MM> WRITE SOURCE set.mm / REWRAP" command). <p> <p> When compound words have several variants, we prefer the concatenated variant (e.g., nonempty, nontrivial, nonpositive, nonzero, nonincreasing, nondegenerate...). </p> </li> <li><b>Quotation style.</b> <p> We use the "logical quotation style", which means that when a quoted text is followed by punctuation not pertaining to the quote, then the quotation mark precedes the punctuation (like at the beginning of this sentence). We use the double quote as default quotation mark (since the single quote also serves as apostrophe), and the single quote in the case of a nested quotation. </p> </li> <li><b>Sectioning and section headers.</b> <p> The database set.mm has a sectioning system with four levels of titles, signaled by "decoration lines" which are 79-character long repetitions of ####, #*#*, =-=-, and -.-. (in descending order of sectioning level). Sections of any level are separated by two blank lines (if there is a "@( Begin $[ ... $] @)" comment (where "@" is actually "$") before a section header, then the double blank line should go before that comment, which is considered as belonging to that section). The format of section headers is best seen in the source file (set.mm); it is as follows: <ul> <li>a line with "@(" (with the "@" replaced by "$");</li> <li>a decoration line;</li> <li>section title indented with two spaces;</li> <li>a (matching) decoration line;</li> <li>[blank line; header comment indented with two spaces; blank line;]</li> <li>a line with "@)" (with the "@" replaced by "$");</li> <li>one blank line.</li> </ul> <p> As everywhere else, lines are hard-wrapped to be 79-character long. It is expected that in a future version, the Metamath program "MM> WRITE SOURCE set.mm / REWRAP" command will reformat section headers to automatically conform with this format. </p> </li> <li><b>Comments.</b> <p> As for formatting of the file set.mm, and in particular formatting and layout of the comments, the foremost rule is consistency. The first sections of set.mm, in particular Part 1 "Classical first-order logic with equality" can serve as a model for contributors. Some formatting rules are enforced when using the Metamath program "MM> WRITE SOURCE set.mm / REWRAP" command. Here are a few other rules, which are not enforced, but that we try to follow: <ul> <li> A math string in a comment should be surrounded by space-separated backquotes on the same line, and if it is too long it should be broken into multiple adjacent math strings on multiple lines. </li> <li> The file set.mm should have a double blank line between sections, and at no other places. In particular, there are no triple blank lines. </li> <li> The header comments should be spaced as those of Part 1, namely, with a blank line before and after the comment, and an indentation of two spaces. </li> <li> As of 20-Sep-2022, section comments are not rewrapped by the Metamath program "MM> WRITE SOURCE set.mm / REWRAP" command, though this is expected in a future version. Similar spacing and wrapping should be used as for other comments: double spaces after a period ending a sentence, line wrapping with line width of 79, and no trailing spaces at the end of lines. </li> </ul> <br> </li> <li><b>Contributors.</b> <p> Each assertion (theorem, definition or axiom) has a contribution tag of the form "(Contributed by xxx, dd-Mmm-yyyy.)" (see Metamath Book, p. 142). The date cannot serve as a proof of anteriority since there is currently no formal guarantee that the date is correct (a claim of anteriority can be backed, for instance, by the uploading of a result to a public repository with verifiable date). The contributor is the first person who proved (or stated, in the case of a definition or axiom) the statement. The list of contributors appears at the beginning of set.mm. </p> <p> An exception should be made if a theorem is essentially an extract or a variant of an already existing theorem, in which case the contributor should be that of the statement from which it is derived, with the modification signaled by a "(Revised by xxx, dd-Mmm-yyyy.)" tag. </p> </li> <li><b>Usage of parentheticals.</b> <p> Usually, the comment of a theorem should contain at most one of the "Revised by" and "Proof shortened by" parentheticals, see Metamath Book, pp. 142-143 (there must always be a "Contributed by" parenthetical for every theorem). Exceptions for "Proof shortened by" parentheticals are essential additional shortenings by a different person. If a proof is shortened by the same person, the date within the "Proof shortened by" parenthetical should be updated only. This also holds for "Revised by" parentheticals, except that also more than one of such parentheticals for the same person are acceptable (if there are good reasons for this). A revision tag is optionally preceded by a short description of the revision. Since this is somewhat subjective, judgment and intellectual honesty should be applied, with collegial settlement in case of dispute. </p> </li> <li><b>Explaining new labels.</b> <p> A comment should explain the first use of an abbreviation within a label. This is often in a definition (e.g., Definition ~ df-an introduces the abbreviation "an" for conjunction ("and")), but not always (e.g., Theorem ~ alim introduces the abbreviation "al" for the universal quantifier ("for all")). See ~ conventions-labels for a table of abbreviations. </p> </li> </ul> </HTML> (Contributed by the Metamath team, 27-Dec-2016.) Date of last revision. (Revised by the Metamath team, 22-Sep-2022.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem conventions_comments (ph: wff):
  $ ph $ >
  $ ph $;

--| Here are typical natural deduction (ND) rules in the style of Gentzen and Ja&#347;kowski, along with MPE translations of them. This also shows the recommended theorems when you find yourself needing these rules (the recommendations encourage a slightly different proof style that works more naturally with set.mm). A decent list of the standard rules of natural deduction can be found beginning with definition /\I in [Pfenning] p. 18. For information about ND and Metamath, see the <A HREF="mmnatded.html">page on Deduction Form and Natural Deduction in Metamath Proof Explorer</A>. Many more citations could be added. <HTML> <P> <TABLE ALIGN=CENTER BORDER CELLSPACING=0 WIDTH="95%"> <TR><TH>Name</TH><TH>Natural Deduction Rule</TH><TH>Translation</TH> <TH>Recommendation</TH><TH>Comments</TH></TR> <TR><TD> IT </TD> <TD> ` _G |- ps ` => ` _G |- ps ` </TD> <TD> ~ idi </TD> <TD> nothing </TD><TD>Reiteration is always redundant in Metamath. Definition "new rule" in [Pfenning] p. 18, definition IT in [Clemente] p. 10. </TD> </TR> <TR><TD> ` /\ `I</TD> <TD> ` _G |- ps ` & ` _G |- ch ` => ` _G |- ps /\ ch ` </TD> <TD> ~ jca </TD> <TD> ~ jca , ~ pm3.2i </TD> <TD>Definition ` /\ `I in [Pfenning] p. 18, definition I` /\ `m,n in [Clemente] p. 10, and definition ` /\ `I in [Indrzejczak] p. 34 (representing both Gentzen's system NK and Ja&#347;kowski)</TD> </TR> <TR><TD> ` /\ `E<SUB>L</SUB></TD> <TD> ` _G |- ps /\ ch ` => ` _G |- ps ` </TD> <TD> ~ simpld </TD> <TD> ~ simpld , ~ adantr </TD> <TD>Definition ` /\ `E<SUB>L</SUB> in [Pfenning] p. 18, definition E` /\ `(1) in [Clemente] p. 11, and definition ` /\ `E in [Indrzejczak] p. 34 (representing both Gentzen's system NK and Ja&#347;kowski)</TD> </TR> <TR><TD> ` /\ `E<SUB>R</SUB></TD> <TD> ` _G |- ps /\ ch ` => ` _G |- ch ` </TD> <TD> ~ simprd </TD> <TD> ~ simpr , ~ adantl </TD> <TD>Definition ` /\ `E<SUB>R</SUB> in [Pfenning] p. 18, definition E` /\ `(2) in [Clemente] p. 11, and definition ` /\ `E in [Indrzejczak] p. 34 (representing both Gentzen's system NK and Ja&#347;kowski)</TD> </TR> <TR><TD> ` -> `I </TD> <TD> ` _G , ps |- ch ` => ` _G |- ps -> ch ` </TD> <TD> ~ ex </TD><TD> ~ ex </TD> <TD>Definition ` -> `I in [Pfenning] p. 18, definition I=>m,n in [Clemente] p. 11, and definition ` -> `I in [Indrzejczak] p. 33. </TD> </TR> <TR><TD> ` -> `E </TD> <TD> ` _G |- ps -> ch ` & ` _G |- ps ` => ` _G |- ch ` </TD> <TD> ~ mpd </TD><TD> ~ ax-mp , ~ mpd , ~ mpdan , ~ imp </TD> <TD>Definition ` -> `E in [Pfenning] p. 18, definition E=>m,n in [Clemente] p. 11, and definition ` -> `E in [Indrzejczak] p. 33. </TD> </TR> <TR><TD> ` \/ `I<SUB>L</SUB> </TD><TD> ` _G |- ps ` => ` _G |- ps \/ ch ` </TD> <TD> ~ olcd </TD> <TD> ~ olc , ~ olci , ~ olcd </TD> <TD>Definition ` \/ `I in [Pfenning] p. 18, definition I` \/ `n(1) in [Clemente] p. 12</TD> </TR> <TR><TD> ` \/ `I<SUB>R</SUB> </TD><TD> ` _G |- ch ` => ` _G |- ps \/ ch ` </TD> <TD> ~ orcd </TD> <TD> ~ orc , ~ orci , ~ orcd </TD> <TD>Definition ` \/ `I<SUB>R</SUB> in [Pfenning] p. 18, definition I` \/ `n(2) in [Clemente] p. 12. </TD> </TR> <TR><TD> ` \/ `E </TD><TD> ` _G |- ps \/ ch ` & ` _G , ps |- th ` & ` _G , ch |- th ` => ` _G |- th ` </TD> <TD> ~ mpjaodan </TD> <TD> ~ mpjaodan , ~ jaodan , ~ jaod </TD> <TD>Definition ` \/ `E in [Pfenning] p. 18, definition E` \/ `m,n,p in [Clemente] p. 12. </TD> </TR> <!-- This is NOT quite the same as Pfenning page 22, because they do not use falsum. (Instead, they use an arbitrary atomic propositional letter in place of F. --> <TR><TD> ` -. `I </TD><TD> ` _G , ps |- F. ` => ` _G |- -. ps ` </TD> <TD> ~ inegd </TD><TD> ~ pm2.01d </TD> <TD></TD> </TR> <TR><TD> ` -. `I </TD><TD> ` _G , ps |- th ` & ` _G |- -. th ` => ` _G |- -. ps ` </TD> <TD> ~ mtand </TD><TD> ~ mtand </TD> <TD>definition I` -. `m,n,p in [Clemente] p. 13. </TD> </TR> <TR><TD> ` -. `I </TD><TD> ` _G , ps |- ch ` & ` _G , ps |- -. ch ` => ` _G |- -. ps ` </TD> <TD> ~ pm2.65da </TD><TD> ~ pm2.65da </TD> <TD>Contradiction.</TD> </TR> <TR><TD> ` -. `I </TD> <TD> ` _G , ps |- -. ps ` => ` _G |- -. ps ` </TD> <TD> ~ pm2.01da </TD><TD> ~ pm2.01d , ~ pm2.65da , ~ pm2.65d </TD> <TD>For an alternative falsum-free natural deduction ruleset</TD> </TR> <TR><TD> ` -. `E </TD> <TD> ` _G |- ps ` & ` _G |- -. ps ` => ` _G |- F. ` </TD> <TD> ~ pm2.21fal </TD> <TD> ~ pm2.21dd </TD><TD></TD> </TR> <TR><TD> ` -. `E </TD> <TD> ` _G , -. ps |- F. ` => ` _G |- ps ` </TD> <TD> </TD> <TD> ~ pm2.21dd </TD> <TD>definition ` -> `E in [Indrzejczak] p. 33. </TD> </TR> <TR><TD> ` -. `E </TD> <TD> ` _G |- ps ` & ` _G |- -. ps ` => ` _G |- th ` </TD> <TD> ~ pm2.21dd </TD><TD> ~ pm2.21dd , ~ pm2.21d , ~ pm2.21 </TD> <TD>For an alternative falsum-free natural deduction ruleset. Definition ` -. `E in [Pfenning] p. 18. </TD> </TR> <TR><TD> ` T. `I </TD><TD> ` _G |- T. ` </TD> <TD> ~ trud </TD><TD> ~ tru , ~ trud , ~ mptru </TD> <TD>Definition ` T. `I in [Pfenning] p. 18. </TD> </TR> <TR><TD> ` F. `E </TD><TD> ` _G , F. |- th ` </TD> <TD> ~ falimd </TD><TD> ~ falim </TD> <TD>Definition ` F. `E in [Pfenning] p. 18. </TD> </TR> <TR><TD> ` A. `I </TD> <TD> ` _G |- [ a / x ] ps ` => ` _G |- A. x ps ` </TD> <TD> ~ alrimiv </TD><TD> ~ alrimiv , ~ ralrimiva </TD> <TD>Definition ` A. `I<SUP>a</SUP> in [Pfenning] p. 18, definition I` A. `n in [Clemente] p. 32. </TD> </TR> <TR><TD> ` A. `E </TD> <TD> ` _G |- A. x ps ` => ` _G |- [ t / x ] ps ` </TD> <TD> ~ spsbcd </TD><TD> ~ spcv , ~ rspcv </TD> <TD>Definition ` A. `E in [Pfenning] p. 18, definition E` A. `n,t in [Clemente] p. 32. </TD> </TR> <TR><TD> ` E. `I </TD> <TD> ` _G |- [ t / x ] ps ` => ` _G |- E. x ps ` </TD> <TD> ~ spesbcd </TD><TD> ~ spcev , ~ rspcev </TD> <TD>Definition ` E. `I in [Pfenning] p. 18, definition I` E. `n,t in [Clemente] p. 32. </TD> </TR> <TR><TD> ` E. `E </TD> <TD> ` _G |- E. x ps ` & ` _G , [ a / x ] ps |- th ` => ` _G |- th ` </TD> <TD> ~ exlimddv </TD><TD> ~ exlimddv , ~ exlimdd , ~ exlimdv , ~ rexlimdva </TD> <TD>Definition ` E. `E<SUP>a,u</SUP> in [Pfenning] p. 18, definition E` E. `m,n,p,a in [Clemente] p. 32. </TD> </TR> <TR><TD> ` F. `C </TD> <TD> ` _G , -. ps |- F. ` => ` _G |- ps ` </TD> <TD> ~ efald </TD><TD> ~ efald </TD> <TD>Proof by contradiction (classical logic), definition ` F. `C in [Pfenning] p. 17. </TD> </TR> <TR><TD> ` F. `C </TD> <TD> ` _G , -. ps |- ps ` => ` _G |- ps ` </TD> <TD> ~ pm2.18da </TD><TD> ~ pm2.18da , ~ pm2.18d , ~ pm2.18 </TD> <TD>For an alternative falsum-free natural deduction ruleset</TD> </TR> <TR><TD> ` -. -. `C </TD> <TD> ` _G |- -. -. ps ` => ` _G |- ps ` </TD> <TD> ~ notnotrd </TD><TD> ~ notnotrd , ~ notnotr </TD> <TD>Double negation rule (classical logic), definition NNC in [Pfenning] p. 17, definition E` -. `n in [Clemente] p. 14. </TD> </TR> <TR><TD> EM </TD><TD> ` _G |- ps \/ -. ps ` </TD> <TD> ~ exmidd </TD><TD> ~ exmid </TD> <TD>Excluded middle (classical logic), definition XM in [Pfenning] p. 17, proof 5.11 in [Clemente] p. 14. </TD> </TR> <TR><TD> ` = `I </TD><TD> ` _G |- A = A ` </TD> <TD> ~ eqidd </TD><TD> ~ eqid , ~ eqidd </TD> <TD>Introduce equality, definition =I in [Pfenning] p. 127. </TD> </TR> <!-- In Metamath, no need to introduce E1 and E2 separately. --> <TR><TD> ` = `E </TD><TD> ` _G |- A = B ` & ` _G [. A / x ]. ps ` => ` _G |- [. B / x ]. ps ` </TD> <TD> ~ sbceq1dd </TD><TD> ~ sbceq1d , equality theorems </TD> <TD>Eliminate equality, definition =E in [Pfenning] p. 127. (Both E1 and E2.) </TD> </TR> </TABLE> </HTML> <p> Note that MPE uses classical logic, not intuitionist logic. As is conventional, the "I" rules are introduction rules, "E" rules are elimination rules, the "C" rules are conversion rules, and ` _G ` represents the set of (current) hypotheses. We use wff variable names beginning with ` ps ` to provide a closer representation of the Metamath equivalents (which typically use the antecedent ` ph ` to represent the context ` _G ` ). Most of this information was developed by Mario Carneiro and posted on 3-Feb-2017. For more information, see the <A HREF="mmnatded.html">page on Deduction Form and Natural Deduction in Metamath Proof Explorer</A>. For annotated examples where some traditional ND rules are directly applied in MPE, see ~ ex-natded5.2 , ~ ex-natded5.3 , ~ ex-natded5.5 , ~ ex-natded5.7 , ~ ex-natded5.8 , ~ ex-natded5.13 , ~ ex-natded9.20 , and ~ ex-natded9.26 . </p> (Contributed by DAW, 4-Feb-2017.) (New usage is discouraged.)
theorem natded (ph: wff):
  $ ph $ >
  $ ph $;

--| Theorem 5.2 of [Clemente] p. 15, translated line by line using the interpretation of natural deduction in Metamath. For information about ND and Metamath, see the <A HREF="mmnatded.html">page on Deduction Form and Natural Deduction in Metamath Proof Explorer</A>. The original proof, which uses Fitch style, was written as follows: <HTML> <TABLE BORDER> <TR><TH NOWRAP>#</TH><TH>MPE#</TH><TH>ND Expression</TH> <TH NOWRAP>MPE Translation</TH><TH>ND Rationale</TH> <TH>MPE Rationale</TH></TR> <TR><TD>1</TD><TD>5</TD><TD NOWRAP> ` ( ( ps /\ ch ) -> th ) ` </TD> <TD NOWRAP> ` ( ph -> ( ( ps /\ ch ) -> th ) ) ` </TD> <TD>Given</TD> <TD>$e. </TD></TR> <TR><TD>2</TD><TD>2</TD><TD NOWRAP> ` ( ch -> ps ) ` </TD> <TD NOWRAP> ` ( ph -> ( ch -> ps ) ) ` </TD> <TD>Given</TD> <TD>$e. </TD></TR> <TR><TD>3</TD><TD>1</TD><TD> ` ch ` </TD> <TD> ` ( ph -> ch ) ` </TD> <TD>Given</TD> <TD>$e. </TD></TR> <TR><TD>4</TD><TD>3</TD><TD> ` ps ` </TD> <TD> ` ( ph -> ps ) ` </TD> <TD> ` -> `E 2,3</TD> <TD> ~ mpd , the MPE equivalent of ` -> `E, 1,2</TD></TR> <TR><TD>5</TD><TD>4</TD><TD> ` ( ps /\ ch ) ` </TD> <TD> ` ( ph -> ( ps /\ ch ) ) ` </TD> <TD> ` /\ `I 4,3</TD> <TD> ~ jca , the MPE equivalent of ` /\ `I, 3,1</TD></TR> <TR><TD>6</TD><TD>6</TD><TD> ` th ` </TD> <TD> ` ( ph -> th ) ` </TD> <TD> ` -> `E 1,5</TD> <TD> ~ mpd , the MPE equivalent of ` -> `E, 4,5</TD></TR> </TABLE> </HTML> The original used Latin letters for predicates; we have replaced them with Greek letters to follow Metamath naming conventions and so that it is easier to follow the Metamath translation. The Metamath line-for-line translation of this natural deduction approach precedes every line with an antecedent including ` ph ` and uses the Metamath equivalents of the natural deduction rules. Below is the final Metamath proof (which reorders some steps). A much more efficient proof, using more of Metamath and MPE's capabilities, is shown in ~ ex-natded5.2-2 . A proof without context is shown in ~ ex-natded5.2i . (Contributed by Mario Carneiro, 9-Feb-2017.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ex_natded5_2 (ph ps ch th: wff):
  $ wi ph (wi (wa ps ch) th) $ >
  $ wi ph (wi ch ps) $ >
  $ wi ph ch $ >
  $ wi ph th $;

--| A more efficient proof of Theorem 5.2 of [Clemente] p. 15. Compare with ~ ex-natded5.2 and ~ ex-natded5.2i . (Contributed by Mario Carneiro, 9-Feb-2017.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ex_natded5_2_21 (ph ps ch th: wff):
  $ wi ph (wi (wa ps ch) th) $ >
  $ wi ph (wi ch ps) $ >
  $ wi ph ch $ >
  $ wi ph th $;

--| The same as ~ ex-natded5.2 and ~ ex-natded5.2-2 but with no context. (Contributed by Mario Carneiro, 9-Feb-2017.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ex_natded5_2i (ps ch th: wff):
  $ wi (wa ps ch) th $ >
  $ wi ch ps $ >
  $ ch $ >
  $ th $;

--| Theorem 5.3 of [Clemente] p. 16, translated line by line using an interpretation of natural deduction in Metamath. A much more efficient proof, using more of Metamath and MPE's capabilities, is shown in ~ ex-natded5.3-2 . A proof without context is shown in ~ ex-natded5.3i . For information about ND and Metamath, see the <HTML> <A HREF="mmnatded.html">page on Deduction Form and Natural Deduction in Metamath Proof Explorer</A></HTML>. The original proof, which uses Fitch style, was written as follows: <HTML> <TABLE BORDER> <TR><TH NOWRAP>#</TH><TH>MPE#</TH><TH>ND Expression</TH> <TH NOWRAP>MPE Translation</TH><TH>ND Rationale</TH> <TH>MPE Rationale</TH></TR> <TR><TD>1</TD><TD>2;3</TD><TD NOWRAP> ` ( ps -> ch ) ` </TD> <TD NOWRAP> ` ( ph -> ( ps -> ch ) ) ` </TD> <TD>Given</TD> <TD>$e; ~ adantr to move it into the ND hypothesis</TD></TR> <TR><TD>2</TD><TD>5;6</TD><TD NOWRAP> ` ( ch -> th ) ` </TD> <TD NOWRAP> ` ( ph -> ( ch -> th ) ) ` </TD> <TD>Given</TD> <TD>$e; ~ adantr to move it into the ND hypothesis</TD></TR> <TR><TD>3</TD><TD>1</TD><TD> ...| ` ps ` </TD> <TD> ` ( ( ph /\ ps ) -> ps ) ` </TD> <TD>ND hypothesis assumption</TD> <TD> ~ simpr , to access the new assumption </TD></TR> <TR><TD>4</TD><TD>4</TD><TD> ... ` ch ` </TD> <TD> ` ( ( ph /\ ps ) -> ch ) ` </TD> <TD> ` -> `E 1,3</TD> <TD> ~ mpd , the MPE equivalent of ` -> `E, 1.3. ~ adantr was used to transform its dependency (we could also use ~ imp to get this directly from 1) </TD></TR> <TR><TD>5</TD><TD>7</TD><TD> ... ` th ` </TD> <TD> ` ( ( ph /\ ps ) -> th ) ` </TD> <TD> ` -> `E 2,4</TD> <TD> ~ mpd , the MPE equivalent of ` -> `E, 4,6. ~ adantr was used to transform its dependency</TD></TR> <TR><TD>6</TD><TD>8</TD><TD> ... ` ( ch /\ th ) ` </TD> <TD> ` ( ( ph /\ ps ) -> ( ch /\ th ) ) ` </TD> <TD> ` /\ `I 4,5</TD> <TD> ~ jca , the MPE equivalent of ` /\ `I, 4,7</TD></TR> <TR><TD>7</TD><TD>9</TD><TD NOWRAP> ` ( ps -> ( ch /\ th ) ) ` </TD> <TD NOWRAP> ` ( ph -> ( ps -> ( ch /\ th ) ) ) ` </TD> <TD> ` -> `I 3,6</TD> <TD> ~ ex , the MPE equivalent of ` -> `I, 8</TD></TR> </TABLE> </HTML> The original used Latin letters for predicates; we have replaced them with Greek letters to follow Metamath naming conventions and so that it is easier to follow the Metamath translation. The Metamath line-for-line translation of this natural deduction approach precedes every line with an antecedent including ` ph ` and uses the Metamath equivalents of the natural deduction rules. (Contributed by Mario Carneiro, 9-Feb-2017.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ex_natded5_3 (ph ps ch th: wff):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi ch th) $ >
  $ wi ph (wi ps (wa ch th)) $;

--| A more efficient proof of Theorem 5.3 of [Clemente] p. 16. Compare with ~ ex-natded5.3 and ~ ex-natded5.3i . (Contributed by Mario Carneiro, 9-Feb-2017.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ex_natded5_3_21 (ph ps ch th: wff):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wi ch th) $ >
  $ wi ph (wi ps (wa ch th)) $;

--| The same as ~ ex-natded5.3 and ~ ex-natded5.3-2 but with no context. Identical to ~ jccir , which should be used instead. (Contributed by Mario Carneiro, 9-Feb-2017.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ex_natded5_3i (ps ch th: wff):
  $ wi ps ch $ >
  $ wi ch th $ >
  $ wi ps (wa ch th) $;

--| Theorem 5.5 of [Clemente] p. 18, translated line by line using the usual translation of natural deduction (ND) in the Metamath Proof Explorer (MPE) notation. For information about ND and Metamath, see the <A HREF="mmnatded.html">page on Deduction Form and Natural Deduction in Metamath Proof Explorer</A>. The original proof, which uses Fitch style, was written as follows (the leading "..." shows an embedded ND hypothesis, beginning with the initial assumption of the ND hypothesis): <HTML> <TABLE BORDER> <TR><TH NOWRAP>#</TH><TH>MPE#</TH><TH>ND Expression</TH> <TH NOWRAP>MPE Translation</TH><TH>ND Rationale</TH> <TH>MPE Rationale</TH></TR> <TR><TD>1</TD><TD>2;3</TD> <TD NOWRAP> ` ( ps -> ch ) ` </TD> <TD NOWRAP> ` ( ph -> ( ps -> ch ) ) ` </TD> <TD>Given</TD> <TD>$e; ~ adantr to move it into the ND hypothesis</TD></TR> <TR><TD>2</TD><TD>5</TD><TD NOWRAP> ` -. ch ` </TD> <TD NOWRAP> ` ( ph -> -. ch ) ` </TD><TD>Given</TD> <TD>$e; we'll use ~ adantr to move it into the ND hypothesis</TD></TR> <TR><TD>3</TD><TD>1</TD> <TD> ...| ` ps ` </TD><TD> ` ( ( ph /\ ps ) -> ps ) ` </TD> <TD>ND hypothesis assumption</TD> <TD> ~ simpr </TD></TR> <TR><TD>4</TD><TD>4</TD><TD> ... ` ch ` </TD> <TD> ` ( ( ph /\ ps ) -> ch ) ` </TD> <TD> ` -> `E 1,3</TD> <TD> ~ mpd 1,3</TD></TR> <TR><TD>5</TD><TD>6</TD><TD> ... ` -. ch ` </TD> <TD> ` ( ( ph /\ ps ) -> -. ch ) ` </TD> <TD>IT 2</TD> <TD> ~ adantr 5</TD></TR> <TR><TD>6</TD><TD>7</TD><TD> ` -. ps ` </TD> <TD> ` ( ph -> -. ps ) ` </TD> <TD> ` /\ `I 3,4,5</TD> <TD> ~ pm2.65da 4,6</TD></TR> </TABLE> </HTML> The original used Latin letters; we have replaced them with Greek letters to follow Metamath naming conventions and so that it is easier to follow the Metamath translation. The Metamath line-for-line translation of this natural deduction approach precedes every line with an antecedent including ` ph ` and uses the Metamath equivalents of the natural deduction rules. To add an assumption, the antecedent is modified to include it (typically by using ~ adantr ; ~ simpr is useful when you want to depend directly on the new assumption). Below is the final Metamath proof (which reorders some steps). A much more efficient proof is ~ mtod ; a proof without context is shown in ~ mto . (Contributed by David A. Wheeler, 19-Feb-2017.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ex_natded5_5 (ph ps ch: wff):
  $ wi ph (wi ps ch) $ >
  $ wi ph (wn ch) $ >
  $ wi ph (wn ps) $;

--| Theorem 5.7 of [Clemente] p. 19, translated line by line using the interpretation of natural deduction in Metamath. A much more efficient proof, using more of Metamath and MPE's capabilities, is shown in ~ ex-natded5.7-2 . For information about ND and Metamath, see the <HTML> <A HREF="mmnatded.html">page on Deduction Form and Natural Deduction in Metamath Proof Explorer</A></HTML>. The original proof, which uses Fitch style, was written as follows: <HTML> <TABLE BORDER> <TR><TH NOWRAP>#</TH><TH>MPE#</TH><TH>ND Expression</TH> <TH NOWRAP>MPE Translation</TH><TH>ND Rationale</TH> <TH>MPE Rationale</TH></TR> <TR><TD>1</TD><TD>6</TD> <TD NOWRAP> ` ( ps \/ ( ch /\ th ) ) ` </TD> <TD NOWRAP> ` ( ph -> ( ps \/ ( ch /\ th ) ) ) ` </TD> <TD>Given</TD> <TD>$e. No need for ~ adantr because we do not move this into an ND hypothesis</TD></TR> <TR><TD>2</TD><TD>1</TD><TD NOWRAP> ...| ` ps ` </TD> <TD NOWRAP> ` ( ( ph /\ ps ) -> ps ) ` </TD> <TD>ND hypothesis assumption (new scope)</TD> <TD> ~ simpr </TD></TR> <TR><TD>3</TD><TD>2</TD><TD> ... ` ( ps \/ ch ) ` </TD> <TD> ` ( ( ph /\ ps ) -> ( ps \/ ch ) ) ` </TD> <TD> ` \/ `I<SUB>L</SUB> 2</TD> <TD> ~ orcd , the MPE equivalent of ` \/ `I<SUB>L</SUB>, 1</TD></TR> <TR><TD>4</TD><TD>3</TD><TD> ...| ` ( ch /\ th ) ` </TD> <TD> ` ( ( ph /\ ( ch /\ th ) ) -> ( ch /\ th ) ) ` </TD> <TD>ND hypothesis assumption (new scope)</TD> <TD> ~ simpr </TD></TR> <TR><TD>5</TD><TD>4</TD><TD> ... ` ch ` </TD> <TD> ` ( ( ph /\ ( ch /\ th ) ) -> ch ) ` </TD> <TD> ` /\ `E<SUB>L</SUB> 4</TD> <TD> ~ simpld , the MPE equivalent of ` /\ `E<SUB>L</SUB>, 3</TD></TR> <TR><TD>6</TD><TD>6</TD><TD> ... ` ( ps \/ ch ) ` </TD> <TD> ` ( ( ph /\ ( ch /\ th ) ) -> ( ps \/ ch ) ) ` </TD> <TD> ` \/ `I<SUB>R</SUB> 5</TD> <TD> ~ olcd , the MPE equivalent of ` \/ `I<SUB>R</SUB>, 4</TD></TR> <TR><TD>7</TD><TD>7</TD><TD NOWRAP> ` ( ps \/ ch ) ` </TD> <TD NOWRAP> ` ( ph -> ( ps \/ ch ) ) ` </TD> <TD> ` \/ `E 1,3,6</TD> <TD> ~ mpjaodan , the MPE equivalent of ` \/ `E, 2,5,6 </TD></TR> </TABLE> </HTML> The original used Latin letters for predicates; we have replaced them with Greek letters to follow Metamath naming conventions and so that it is easier to follow the Metamath translation. The Metamath line-for-line translation of this natural deduction approach precedes every line with an antecedent including ` ph ` and uses the Metamath equivalents of the natural deduction rules. (Contributed by Mario Carneiro, 9-Feb-2017.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ex_natded5_7 (ph ps ch th: wff):
  $ wi ph (wo ps (wa ch th)) $ >
  $ wi ph (wo ps ch) $;

--| A more efficient proof of Theorem 5.7 of [Clemente] p. 19. Compare with ~ ex-natded5.7 . (Contributed by Mario Carneiro, 9-Feb-2017.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ex_natded5_7_2 (ph ps ch th: wff):
  $ wi ph (wo ps (wa ch th)) $ >
  $ wi ph (wo ps ch) $;

--| Theorem 5.8 of [Clemente] p. 20, translated line by line using the usual translation of natural deduction (ND) in the Metamath Proof Explorer (MPE) notation. For information about ND and Metamath, see the <A HREF="mmnatded.html">page on Deduction Form and Natural Deduction in Metamath Proof Explorer</A>. The original proof, which uses Fitch style, was written as follows (the leading "..." shows an embedded ND hypothesis, beginning with the initial assumption of the ND hypothesis): <HTML> <TABLE BORDER> <TR><TH NOWRAP>#</TH><TH>MPE#</TH><TH>ND Expression</TH> <TH NOWRAP>MPE Translation</TH><TH>ND Rationale</TH> <TH>MPE Rationale</TH></TR> <TR><TD>1</TD><TD>10;11</TD> <TD NOWRAP> ` ( ( ps /\ ch ) -> -. th ) ` </TD> <TD NOWRAP> ` ( ph -> ( ( ps /\ ch ) -> -. th ) ) ` </TD> <TD>Given</TD> <TD>$e; ~ adantr to move it into the ND hypothesis</TD></TR> <TR><TD>2</TD><TD>3;4</TD><TD NOWRAP> ` ( ta -> th ) ` </TD> <TD NOWRAP> ` ( ph -> ( ta -> th ) ) ` </TD><TD>Given</TD> <TD>$e; ~ adantr to move it into the ND hypothesis</TD></TR> <TR><TD>3</TD><TD>7;8</TD> <TD> ` ch ` </TD><TD> ` ( ph -> ch ) ` </TD> <TD>Given</TD> <TD>$e; ~ adantr to move it into the ND hypothesis</TD></TR> <TR><TD>4</TD><TD>1;2</TD><TD> ` ta ` </TD><TD> ` ( ph -> ta ) ` </TD> <TD>Given</TD> <TD>$e. ~ adantr to move it into the ND hypothesis</TD></TR> <TR><TD>5</TD><TD>6</TD><TD> ...| ` ps ` </TD> <TD> ` ( ( ph /\ ps ) -> ps ) ` </TD> <TD>ND Hypothesis/Assumption</TD> <TD> ~ simpr . New ND hypothesis scope, each reference outside the scope must change antecedent ` ph ` to ` ( ph /\ ps ) `.</TD></TR> <TR><TD>6</TD><TD>9</TD><TD> ... ` ( ps /\ ch ) ` </TD> <TD> ` ( ( ph /\ ps ) -> ( ps /\ ch ) ) ` </TD> <TD> ` /\ `I 5,3</TD> <TD> ~ jca ( ` /\ `I), 6,8 ( ~ adantr to bring in scope)</TD></TR> <TR><TD>7</TD><TD>5</TD><TD> ... ` -. th ` </TD> <TD> ` ( ( ph /\ ps ) -> -. th ) ` </TD> <TD> ` -> `E 1,6</TD> <TD> ~ mpd ( ` -> `E), 2,4</TD></TR> <TR><TD>8</TD><TD>12</TD><TD> ... ` th ` </TD> <TD> ` ( ( ph /\ ps ) -> th ) ` </TD> <TD> ` -> `E 2,4</TD> <TD> ~ mpd ( ` -> `E), 9,11; note the contradiction with ND line 7 (MPE line 5)</TD></TR> <TR><TD>9</TD><TD>13</TD><TD> ` -. ps ` </TD> <TD> ` ( ph -> -. ps ) ` </TD> <TD> ` -. `I 5,7,8</TD> <TD> ~ pm2.65da ( ` -. `I), 5,12; proof by contradiction. MPE step 6 (ND#5) does not need a reference here, because the assumption is embedded in the antecedents</TD></TR> </TABLE> </HTML> The original used Latin letters; we have replaced them with Greek letters to follow Metamath naming conventions and so that it is easier to follow the Metamath translation. The Metamath line-for-line translation of this natural deduction approach precedes every line with an antecedent including ` ph ` and uses the Metamath equivalents of the natural deduction rules. To add an assumption, the antecedent is modified to include it (typically by using ~ adantr ; ~ simpr is useful when you want to depend directly on the new assumption). Below is the final Metamath proof (which reorders some steps). A much more efficient proof, using more of Metamath and MPE's capabilities, is shown in ~ ex-natded5.8-2 . (Contributed by Mario Carneiro, 9-Feb-2017.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ex_natded5_8 (ph ps ch th ta: wff):
  $ wi ph (wi (wa ps ch) (wn th)) $ >
  $ wi ph (wi ta th) $ >
  $ wi ph ch $ >
  $ wi ph ta $ >
  $ wi ph (wn ps) $;

--| A more efficient proof of Theorem 5.8 of [Clemente] p. 20. For a longer line-by-line translation, see ~ ex-natded5.8 . (Contributed by Mario Carneiro, 9-Feb-2017.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ex_natded5_8_21 (ph ps ch th ta: wff):
  $ wi ph (wi (wa ps ch) (wn th)) $ >
  $ wi ph (wi ta th) $ >
  $ wi ph ch $ >
  $ wi ph ta $ >
  $ wi ph (wn ps) $;

--| Theorem 5.13 of [Clemente] p. 20, translated line by line using the interpretation of natural deduction in Metamath. For information about ND and Metamath, see the <A HREF="mmnatded.html">page on Deduction Form and Natural Deduction in Metamath Proof Explorer</A>. A much more efficient proof, using more of Metamath and MPE's capabilities, is shown in ~ ex-natded5.13-2 . The original proof, which uses Fitch style, was written as follows (the leading "..." shows an embedded ND hypothesis, beginning with the initial assumption of the ND hypothesis): <HTML> <TABLE BORDER> <TR><TH NOWRAP>#</TH><TH>MPE#</TH><TH>ND Expression</TH> <TH NOWRAP>MPE Translation</TH><TH>ND Rationale</TH> <TH>MPE Rationale</TH></TR> <TR><TD>1</TD><TD>15</TD><TD NOWRAP> ` ( ps \/ ch ) ` </TD> <TD NOWRAP> ` ( ph -> ( ps \/ ch ) ) ` </TD> <TD>Given</TD> <TD>$e. </TD></TR> <TR><TD>2;3</TD><TD>2</TD><TD NOWRAP> ` ( ps -> th ) ` </TD> <TD NOWRAP> ` ( ph -> ( ps -> th ) ) ` </TD><TD>Given</TD> <TD>$e. ~ adantr to move it into the ND hypothesis</TD></TR> <TR><TD>3</TD><TD>9</TD><TD> ` ( -. ta -> -. ch ) ` </TD> <TD> ` ( ph -> ( -. ta -> -. ch ) ) ` </TD> <TD>Given</TD> <TD>$e. ~ ad2antrr to move it into the ND sub-hypothesis</TD></TR> <TR><TD>4</TD><TD>1</TD><TD> ...| ` ps ` </TD> <TD> ` ( ( ph /\ ps ) -> ps ) ` </TD> <TD>ND hypothesis assumption</TD> <TD> ~ simpr </TD></TR> <TR><TD>5</TD><TD>4</TD><TD> ... ` th ` </TD> <TD> ` ( ( ph /\ ps ) -> th ) ` </TD> <TD> ` -> `E 2,4</TD> <TD> ~ mpd 1,3</TD></TR> <TR><TD>6</TD><TD>5</TD><TD> ... ` ( th \/ ta ) ` </TD> <TD> ` ( ( ph /\ ps ) -> ( th \/ ta ) ) ` </TD> <TD> ` \/ `I 5</TD> <TD> ~ orcd 4</TD></TR> <TR><TD>7</TD><TD>6</TD><TD> ...| ` ch ` </TD> <TD> ` ( ( ph /\ ch ) -> ch ) ` </TD> <TD>ND hypothesis assumption</TD> <TD> ~ simpr </TD></TR> <TR><TD>8</TD><TD>8</TD><TD> ... ...| ` -. ta ` </TD> <TD> ` ( ( ( ph /\ ch ) /\ -. ta ) -> -. ta ) ` </TD> <TD>(sub) ND hypothesis assumption</TD> <TD> ~ simpr </TD></TR> <TR><TD>9</TD><TD>11</TD><TD> ... ... ` -. ch ` </TD> <TD> ` ( ( ( ph /\ ch ) /\ -. ta ) -> -. ch ) ` </TD> <TD> ` -> `E 3,8</TD> <TD> ~ mpd 8,10</TD></TR> <TR><TD>10</TD><TD>7</TD><TD> ... ... ` ch ` </TD> <TD> ` ( ( ( ph /\ ch ) /\ -. ta ) -> ch ) ` </TD> <TD> IT 7</TD> <TD> ~ adantr 6</TD></TR> <TR><TD>11</TD><TD>12</TD><TD> ... ` -. -. ta ` </TD> <TD> ` ( ( ph /\ ch ) -> -. -. ta ) ` </TD> <TD> ` -. `I 8,9,10</TD> <TD> ~ pm2.65da 7,11</TD></TR> <TR><TD>12</TD><TD>13</TD><TD> ... ` ta ` </TD> <TD> ` ( ( ph /\ ch ) -> ta ) ` </TD> <TD> ` -. `E 11</TD> <TD> ~ notnotrd 12</TD></TR> <TR><TD>13</TD><TD>14</TD><TD> ... ` ( th \/ ta ) ` </TD> <TD> ` ( ( ph /\ ch ) -> ( th \/ ta ) ) ` </TD> <TD> ` \/ `I 12</TD> <TD> ~ olcd 13</TD></TR> <TR><TD>14</TD><TD>16</TD><TD> ` ( th \/ ta ) ` </TD> <TD> ` ( ph -> ( th \/ ta ) ) ` </TD> <TD> ` \/ `E 1,6,13</TD> <TD> ~ mpjaodan 5,14,15</TD></TR> </TABLE> </HTML> The original used Latin letters; we have replaced them with Greek letters to follow Metamath naming conventions and so that it is easier to follow the Metamath translation. The Metamath line-for-line translation of this natural deduction approach precedes every line with an antecedent including ` ph ` and uses the Metamath equivalents of the natural deduction rules. To add an assumption, the antecedent is modified to include it (typically by using ~ adantr ; ~ simpr is useful when you want to depend directly on the new assumption). (Contributed by Mario Carneiro, 9-Feb-2017.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ex_natded5_13 (ph ps ch th ta: wff):
  $ wi ph (wo ps ch) $ >
  $ wi ph (wi ps th) $ >
  $ wi ph (wi (wn ta) (wn ch)) $ >
  $ wi ph (wo th ta) $;

--| A more efficient proof of Theorem 5.13 of [Clemente] p. 20. Compare with ~ ex-natded5.13 . (Contributed by Mario Carneiro, 9-Feb-2017.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ex_natded5_13_21 (ph ps ch th ta: wff):
  $ wi ph (wo ps ch) $ >
  $ wi ph (wi ps th) $ >
  $ wi ph (wi (wn ta) (wn ch)) $ >
  $ wi ph (wo th ta) $;

--| Theorem 9.20 of [Clemente] p. 43, translated line by line using the usual translation of natural deduction (ND) in the Metamath Proof Explorer (MPE) notation. For information about ND and Metamath, see the <A HREF="mmnatded.html">page on Deduction Form and Natural Deduction in Metamath Proof Explorer</A>. The original proof, which uses Fitch style, was written as follows (the leading "..." shows an embedded ND hypothesis, beginning with the initial assumption of the ND hypothesis): <HTML> <TABLE BORDER> <TR><TH NOWRAP>#</TH><TH>MPE#</TH><TH>ND Expression</TH> <TH NOWRAP>MPE Translation</TH><TH>ND Rationale</TH> <TH>MPE Rationale</TH></TR> <TR><TD>1</TD><TD>1</TD> <TD NOWRAP> ` ( ps /\ ( ch \/ th ) ) ` </TD> <TD NOWRAP> ` ( ph -> ( ps /\ ( ch \/ th ) ) ) ` </TD> <TD>Given</TD> <TD>$e</TD></TR> <TR><TD>2</TD><TD>2</TD><TD NOWRAP> ` ps ` </TD> <TD NOWRAP> ` ( ph -> ps ) ` </TD> <TD>` /\ `E<SUB>L</SUB> 1</TD> <TD> ~ simpld 1</TD></TR> <TR><TD>3</TD><TD>11</TD> <TD> ` ( ch \/ th ) ` </TD> <TD> ` ( ph -> ( ch \/ th ) ) ` </TD> <TD> ` /\ `E<SUB>R</SUB> 1</TD> <TD> ~ simprd 1</TD></TR> <TR><TD>4</TD><TD>4</TD> <TD> ...| ` ch ` </TD> <TD> ` ( ( ph /\ ch ) -> ch ) ` </TD> <TD>ND hypothesis assumption</TD> <TD> ~ simpr </TD></TR> <TR><TD>5</TD><TD>5</TD> <TD> ... ` ( ps /\ ch ) ` </TD> <TD> ` ( ( ph /\ ch ) -> ( ps /\ ch ) ) ` </TD> <TD> ` /\ `I 2,4</TD> <TD> ~ jca 3,4</TD></TR> <TR><TD>6</TD><TD>6</TD> <TD> ... ` ( ( ps /\ ch ) \/ ( ps /\ th ) ) ` </TD> <TD> ` ( ( ph /\ ch ) -> ( ( ps /\ ch ) \/ ( ps /\ th ) ) ) ` </TD> <TD> ` \/ `I<SUB>R</SUB> 5</TD> <TD> ~ orcd 5</TD></TR> <TR><TD>7</TD><TD>8</TD> <TD> ...| ` th ` </TD> <TD> ` ( ( ph /\ th ) -> th ) ` </TD> <TD>ND hypothesis assumption</TD> <TD> ~ simpr </TD></TR> <TR><TD>8</TD><TD>9</TD> <TD> ... ` ( ps /\ th ) ` </TD> <TD> ` ( ( ph /\ th ) -> ( ps /\ th ) ) ` </TD> <TD> ` /\ `I 2,7</TD> <TD> ~ jca 7,8</TD></TR> <TR><TD>9</TD><TD>10</TD> <TD> ... ` ( ( ps /\ ch ) \/ ( ps /\ th ) ) ` </TD> <TD> ` ( ( ph /\ th ) -> ( ( ps /\ ch ) \/ ( ps /\ th ) ) ) ` </TD> <TD> ` \/ `I<SUB>L</SUB> 8</TD> <TD> ~ olcd 9</TD></TR> <TR><TD>10</TD><TD>12</TD> <TD> ` ( ( ps /\ ch ) \/ ( ps /\ th ) ) ` </TD> <TD> ` ( ph -> ( ( ps /\ ch ) \/ ( ps /\ th ) ) ) ` </TD> <TD> ` \/ `E 3,6,9</TD> <TD> ~ mpjaodan 6,10,11</TD></TR> </TABLE> </HTML> The original used Latin letters; we have replaced them with Greek letters to follow Metamath naming conventions and so that it is easier to follow the Metamath translation. The Metamath line-for-line translation of this natural deduction approach precedes every line with an antecedent including ` ph ` and uses the Metamath equivalents of the natural deduction rules. To add an assumption, the antecedent is modified to include it (typically by using ~ adantr ; ~ simpr is useful when you want to depend directly on the new assumption). Below is the final Metamath proof (which reorders some steps). A much more efficient proof is ~ ex-natded9.20-2 . (Contributed by David A. Wheeler, 19-Feb-2017.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ex_natded9_20 (ph ps ch th: wff):
  $ wi ph (wa ps (wo ch th)) $ >
  $ wi ph (wo (wa ps ch) (wa ps th)) $;

--| A more efficient proof of Theorem 9.20 of [Clemente] p. 45. Compare with ~ ex-natded9.20 . (Contributed by David A. Wheeler, 19-Feb-2017.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ex_natded9_20_2 (ph ps ch th: wff):
  $ wi ph (wa ps (wo ch th)) $ >
  $ wi ph (wo (wa ps ch) (wa ps th)) $;

--| Theorem 9.26 of [Clemente] p. 45, translated line by line using an interpretation of natural deduction in Metamath. This proof has some additional complications due to the fact that Metamath's existential elimination rule does not change bound variables, so we need to verify that ` x ` is bound in the conclusion. For information about ND and Metamath, see the <A HREF="mmnatded.html">page on Deduction Form and Natural Deduction in Metamath Proof Explorer</A>. The original proof, which uses Fitch style, was written as follows (the leading "..." shows an embedded ND hypothesis, beginning with the initial assumption of the ND hypothesis): <HTML> <TABLE BORDER> <TR><TH NOWRAP>#</TH><TH>MPE#</TH><TH>ND Expression</TH> <TH NOWRAP>MPE Translation</TH><TH>ND Rationale</TH> <TH>MPE Rationale</TH></TR> <TR><TD>1</TD><TD>3</TD><TD NOWRAP> ` E. x A. y ps ( x , y ) ` </TD> <TD NOWRAP> ` ( ph -> E. x A. y ps ) ` </TD> <TD>Given</TD> <TD>$e. </TD></TR> <TR><TD>2</TD><TD>6</TD><TD NOWRAP> ...| ` A. y ps ( x , y ) ` </TD> <TD NOWRAP> ` ( ( ph /\ A. y ps ) -> A. y ps ) ` </TD> <TD>ND hypothesis assumption</TD> <TD> ~ simpr . Later statements will have this scope.</TD></TR> <TR><TD>3</TD><TD>7;5,4</TD><TD> ... ` ps ( x , y ) ` </TD> <TD> ` ( ( ph /\ A. y ps ) -> ps ) ` </TD> <TD> ` A. `E 2,y </TD> <TD> ~ spsbcd (` A. `E), 5,6. To use it we need ~ a1i and ~ vex . This could be immediately done with ~ 19.21bi , but we want to show the general approach for substitution. </TD></TR> <TR><TD>4</TD><TD>12;8,9,10,11</TD><TD> ... ` E. x ps ( x , y ) ` </TD> <TD> ` ( ( ph /\ A. y ps ) -> E. x ps ) ` </TD> <TD> ` E. `I 3,a</TD> <TD> ~ spesbcd (` E. `I), 11. To use it we need ~ sylibr , which in turn requires ~ sylib and two uses of ~ sbcid . This could be more immediately done using ~ 19.8a , but we want to show the general approach for substitution. </TD></TR> <TR><TD>5</TD><TD>13;1,2</TD><TD> ` E. x ps ( x , y ) ` </TD> <TD> ` ( ph -> E. x ps ) ` </TD><TD> ` E. `E 1,2,4,a</TD> <TD> ~ exlimdd (` E. `E), 1,2,3,12. We'll need supporting assertions that the variable is free (not bound), as provided in ~ nfv and ~ nfe1 (MPE# 1,2)</TD></TR> <TR><TD>6</TD><TD>14</TD><TD> ` A. y E. x ps ( x , y ) ` </TD> <TD> ` ( ph -> A. y E. x ps ) ` </TD> <TD> ` A. `I 5</TD> <TD> ~ alrimiv (` A. `I), 13</TD></TR> </TABLE> </HTML> The original used Latin letters for predicates; we have replaced them with Greek letters to follow Metamath naming conventions and so that it is easier to follow the Metamath translation. The Metamath line-for-line translation of this natural deduction approach precedes every line with an antecedent including ` ph ` and uses the Metamath equivalents of the natural deduction rules. Below is the final Metamath proof (which reorders some steps). Note that in the original proof, ` ps ( x , y ) ` has explicit parameters. In Metamath, these parameters are always implicit, and the parameters upon which a wff variable can depend are recorded in the "allowed substitution hints" below. A much more efficient proof, using more of Metamath and MPE's capabilities, is shown in ~ ex-natded9.26-2 . (Contributed by Mario Carneiro, 9-Feb-2017.) (Revised by David A. Wheeler, 18-Feb-2017.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ex_natded9_26 {x3 y1: setvar} (ph: wff) (ps: wff x3 y1):
  $ wi ph (wex x3 (wal y1 ps)) $ >
  $ wi ph (wal y1 (wex x3 ps)) $;

--| A more efficient proof of Theorem 9.26 of [Clemente] p. 45. Compare with ~ ex-natded9.26 . (Contributed by Mario Carneiro, 9-Feb-2017.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ex_natded9_26_2 {x3 y1: setvar} (ph: wff) (ps: wff x3 y1):
  $ wi ph (wex x3 (wal y1 ps)) $ >
  $ wi ph (wal y1 (wex x3 ps)) $;

--| Example for ~ df-or . Example by David A. Wheeler. (Contributed by Mario Carneiro, 9-May-2015.)
theorem ex_or:
  $ wo (wceq c2 c3) (wceq c4 c4) $;

--| Example for ~ df-an . Example by David A. Wheeler. (Contributed by Mario Carneiro, 9-May-2015.)
theorem ex_an:
  $ wa (wceq c2 c2) (wceq c3 c3) $;

--| Example for ~ df-dif . Example by David A. Wheeler. (Contributed by Mario Carneiro, 6-May-2015.)
theorem ex_dif:
  $ wceq (cdif (cpr c1 c3) (cpr c1 c8)) (csn c3) $;

--| Example for ~ df-un . Example by David A. Wheeler. (Contributed by Mario Carneiro, 6-May-2015.)
theorem ex_un:
  $ wceq (cun (cpr c1 c3) (cpr c1 c8)) (ctp c1 c3 c8) $;

--| Example for ~ df-in . Example by David A. Wheeler. (Contributed by Mario Carneiro, 6-May-2015.)
theorem ex_in:
  $ wceq (cin (cpr c1 c3) (cpr c1 c8)) (csn c1) $;

--| Example for ~ df-uni . Example by David A. Wheeler. (Contributed by Mario Carneiro, 2-Jul-2016.)
theorem ex_uni:
  $ wceq (cuni (cpr (cpr c1 c3) (cpr c1 c8))) (ctp c1 c3 c8) $;

--| Example for ~ df-ss . Example by David A. Wheeler. (Contributed by Mario Carneiro, 6-May-2015.)
theorem ex_ss:
  $ wss (cpr c1 c2) (ctp c1 c2 c3) $;

--| Example for ~ df-pss . Example by David A. Wheeler. (Contributed by Mario Carneiro, 6-May-2015.)
theorem ex_pss:
  $ wpss (cpr c1 c2) (ctp c1 c2 c3) $;

--| Example for ~ df-pw . Example by David A. Wheeler. (Contributed by Mario Carneiro, 2-Jul-2016.)
theorem ex_pw (A2: class):
  $ wi (wceq A2 (ctp c3 c5 c7)) (wceq (cpw A2) (cun (cun (csn c0) (ctp (csn c3) (csn c5) (csn c7))) (cun (ctp (cpr c3 c5) (cpr c3 c7) (cpr c5 c7)) (csn (ctp c3 c5 c7))))) $;

--| Example for ~ df-pr . (Contributed by Mario Carneiro, 7-May-2015.)
theorem ex_pr (A2: class):
  $ wi (wcel A2 (cpr c1 (cneg c1))) (wceq (co A2 c2 cexp) c1) $;

--| Example for ~ df-br . Example by David A. Wheeler. (Contributed by Mario Carneiro, 6-May-2015.)
theorem ex_br (R: class):
  $ wi (wceq R (cpr (cop c2 c6) (cop c3 c9))) (wbr c3 c9 R) $;

--| Example for ~ df-opab . Example by David A. Wheeler. (Contributed by Mario Carneiro, 18-Jun-2015.)
theorem ex_opab {x3 y1: setvar} (R: class x3 y1):
  $ wi (wceq R (copab x3 y1 (w3a (wcel (cv x3) cc) (wcel (cv y1) cc) (wceq (co (cv x3) c1 caddc) (cv y1))))) (wbr c3 c4 R) $;

--| Example for ~ df-eprel . Example by David A. Wheeler. (Contributed by Mario Carneiro, 18-Jun-2015.)
theorem ex_eprel:
  $ wbr c5 (cpr c1 c5) cep $;

--| Example for ~ df-id . Example by David A. Wheeler. (Contributed by Mario Carneiro, 18-Jun-2015.)
theorem ex_id:
  $ wa (wbr c5 c5 cid) (wn (wbr c4 c5 cid)) $;

--| Example for ~ df-po . Example by David A. Wheeler. (Contributed by Mario Carneiro, 18-Jun-2015.)
theorem ex_po:
  $ wa (wpo cr clt) (wn (wpo cr cle)) $;

--| Example for ~ df-xp . Example by David A. Wheeler. (Contributed by Mario Carneiro, 7-May-2015.)
theorem ex_xp:
  $ wceq (cxp (cpr c1 c5) (cpr c2 c7)) (cun (cpr (cop c1 c2) (cop c1 c7)) (cpr (cop c5 c2) (cop c5 c7))) $;

--| Example for ~ df-cnv . Example by David A. Wheeler. (Contributed by Mario Carneiro, 6-May-2015.)
theorem ex_cnv:
  $ wceq (ccnv (cpr (cop c2 c6) (cop c3 c9))) (cpr (cop c6 c2) (cop c9 c3)) $;

--| Example for ~ df-co . Example by David A. Wheeler. (Contributed by Mario Carneiro, 7-May-2015.)
theorem ex_co:
  $ wceq (cfv cc0 (ccom ce ccos)) ceu $;

--| Example for ~ df-dm . Example by David A. Wheeler. (Contributed by Mario Carneiro, 7-May-2015.)
theorem ex_dm (F: class):
  $ wi (wceq F (cpr (cop c2 c6) (cop c3 c9))) (wceq (cdm F) (cpr c2 c3)) $;

--| Example for ~ df-rn . Example by David A. Wheeler. (Contributed by Mario Carneiro, 7-May-2015.)
theorem ex_rn (F: class):
  $ wi (wceq F (cpr (cop c2 c6) (cop c3 c9))) (wceq (crn F) (cpr c6 c9)) $;

--| Example for ~ df-res . Example by David A. Wheeler. (Contributed by Mario Carneiro, 7-May-2015.)
theorem ex_res (B2 F: class):
  $ wi (wa (wceq F (cpr (cop c2 c6) (cop c3 c9))) (wceq B2 (cpr c1 c2))) (wceq (cres F B2) (csn (cop c2 c6))) $;

--| Example for ~ df-ima . Example by David A. Wheeler. (Contributed by Mario Carneiro, 7-May-2015.)
theorem ex_ima (B2 F: class):
  $ wi (wa (wceq F (cpr (cop c2 c6) (cop c3 c9))) (wceq B2 (cpr c1 c2))) (wceq (cima F B2) (csn c6)) $;

--| Example for ~ df-fv . Example by David A. Wheeler. (Contributed by Mario Carneiro, 7-May-2015.)
theorem ex_fv (F: class):
  $ wi (wceq F (cpr (cop c2 c6) (cop c3 c9))) (wceq (cfv c3 F) c9) $;

--| Example for ~ df-1st . Example by David A. Wheeler. (Contributed by Mario Carneiro, 18-Jun-2015.)
theorem ex_1st:
  $ wceq (cfv (cop c3 c4) c1st) c3 $;

--| Example for ~ df-2nd . Example by David A. Wheeler. (Contributed by Mario Carneiro, 18-Jun-2015.)
theorem ex_2nd:
  $ wceq (cfv (cop c3 c4) c2nd) c4 $;

--| Example for ~ df-dec , 1000 + 2000 = 3000. This proof disproves (by counterexample) the assertion of Hao Wang, who stated, "There is a theorem in the primitive notation of set theory that corresponds to the arithmetic theorem 1000 + 2000 = 3000. The formula would be forbiddingly long... even if (one) knows the definitions and is asked to simplify the long formula according to them, chances are he will make errors and arrive at some incorrect result." (Hao Wang, "Theory and practice in mathematics" , In Thomas Tymoczko, editor, _New Directions in the Philosophy of Mathematics_, pp 129-152, Birkauser Boston, Inc., Boston, 1986. (QA8.6.N48). The quote itself is on page 140.) This is noted in _Metamath: A Computer Language for Pure Mathematics_ by Norman Megill (2007) section 1.1.3. Megill then states, "A number of writers have conveyed the impression that the kind of absolute rigor provided by Metamath is an impossible dream, suggesting that a complete, formal verification of a typical theorem would take millions of steps in untold volumes of books... These writers assume, however, that in order to achieve the kind of complete formal verification they desire one must break down a proof into individual primitive steps that make direct reference to the axioms. This is not necessary. There is no reason not to make use of previously proved theorems rather than proving them over and over... A hierarchy of theorems and definitions permits an exponential growth in the formula sizes and primitive proof steps to be described with only a linear growth in the number of symbols used. Of course, this is how ordinary informal mathematics is normally done anyway, but with Metamath it can be done with absolute rigor and precision." The proof here starts with ` ( 2 + 1 ) = 3 ` , commutes it, and repeatedly multiplies both sides by ten. This is certainly longer than traditional mathematical proofs, e.g., there are a number of steps explicitly shown here to show that we're allowed to do operations such as multiplication. However, while longer, the proof is clearly a manageable size - even though every step is rigorously derived all the way back to the primitive notions of set theory and logic. And while there's a risk of making errors, the many independent verifiers make it much less likely that an incorrect result will be accepted. This proof heavily relies on the decimal constructor ~ df-dec developed by Mario Carneiro in 2015. The underlying Metamath language has an intentionally very small set of primitives; it doesn't even have a built-in construct for numbers. Instead, the digits are defined using these primitives, and the decimal constructor is used to make it easy to express larger numbers as combinations of digits. (Contributed by David A. Wheeler, 29-Jun-2016.) (Shortened by Mario Carneiro using the arithmetic algorithm in mmj2, 30-Jun-2016.)
theorem _1kp2ke3k:
  $ wceq (co (cdc (cdc (cdc c1 cc0) cc0) cc0) (cdc (cdc (cdc c2 cc0) cc0) cc0) caddc) (cdc (cdc (cdc c3 cc0) cc0) cc0) $;

--| Example for ~ df-fl . Example by David A. Wheeler. (Contributed by Mario Carneiro, 18-Jun-2015.)
theorem ex_fl:
  $ wa (wceq (cfv (co c3 c2 cdiv) cfl) c1) (wceq (cfv (cneg (co c3 c2 cdiv)) cfl) (cneg c2)) $;

--| Example for ~ df-ceil . (Contributed by AV, 4-Sep-2021.)
theorem ex_ceil:
  $ wa (wceq (cfv (co c3 c2 cdiv) cceil) c2) (wceq (cfv (cneg (co c3 c2 cdiv)) cceil) (cneg c1)) $;

--| Example for ~ df-mod . (Contributed by AV, 3-Sep-2021.)
theorem ex_mod:
  $ wa (wceq (co c5 c3 cmo) c2) (wceq (co (cneg c7) c2 cmo) c1) $;

--| Example for ~ df-exp . (Contributed by AV, 4-Sep-2021.)
theorem ex_exp:
  $ wa (wceq (co c5 c2 cexp) (cdc c2 c5)) (wceq (co (cneg c3) (cneg c2) cexp) (co c1 c9 cdiv)) $;

--| Example for ~ df-fac . (Contributed by AV, 4-Sep-2021.)
theorem ex_fac:
  $ wceq (cfv c5 cfa) (cdc (cdc c1 c2) cc0) $;

--| Example for ~ df-bc . (Contributed by AV, 4-Sep-2021.)
theorem ex_bc:
  $ wceq (co c5 c3 cbc) (cdc c1 cc0) $;

--| Example for ~ df-hash . (Contributed by AV, 4-Sep-2021.)
theorem ex_hash:
  $ wceq (cfv (ctp cc0 c1 c2) chash) c3 $;

--| Example for ~ df-sqrt . (Contributed by AV, 4-Sep-2021.)
theorem ex_sqrt:
  $ wceq (cfv (cdc c2 c5) csqrt) c5 $;

--| Example for ~ df-abs . (Contributed by AV, 4-Sep-2021.)
theorem ex_abs:
  $ wceq (cfv (cneg c2) cabs) c2 $;

--| Example for ~ df-dvds : 3 divides into 6. (Contributed by David A. Wheeler, 19-May-2015.)
theorem ex_dvds:
  $ wbr c3 c6 cdvds $;

--| Example for ~ df-gcd . (Contributed by AV, 5-Sep-2021.)
theorem ex_gcd:
  $ wceq (co (cneg c6) c9 cgcd) c3 $;

--| Example for ~ df-lcm . (Contributed by AV, 5-Sep-2021.)
theorem ex_lcm:
  $ wceq (co c6 c9 clcm) (cdc c1 c8) $;

--| Example for ~ df-prmo : ` ( #p `` 1 0 ) = 2 x. 3 x. 5 x. 7 ` . (Contributed by AV, 6-Sep-2021.)
theorem ex_prmo:
  $ wceq (cfv (cdc c1 cc0) cprmo) (cdc (cdc c2 c1) cc0) $;

--| Proof illustrating the comment of ~ aev2 . (Contributed by BJ, 30-Mar-2021.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem aevdemo {x3 y1 e f2 h k a b: setvar} (g2 i j c d l: setvar):
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wa (wo (wex a (wal b (wceq (cv c) (cv d)))) (wex e (wceq (cv f2) (cv g2)))) (wal h (wi (wceq (cv i) (cv j)) (wceq (cv k) (cv l))))) $;

--| Example of a proof by induction (divisibility result). (Contributed by Stanislas Polu, 9-Mar-2020.) (Revised by BJ, 24-Mar-2020.)
theorem ex_ind_dvds (N: class):
  $ wi (wcel N cn0) (wbr c3 (co (co c4 N cexp) c2 caddc) cdvds) $;

--| Formalized example provided in the comment for ~ fpar . (Contributed by AV, 3-Jan-2024.)
theorem ex_fpar (A2 B2 F G H X Y: class):
  $ wceq H (cin (ccom (ccnv (cres c1st (cxp cvv cvv))) (ccom F (cres c1st (cxp cvv cvv)))) (ccom (ccnv (cres c2nd (cxp cvv cvv))) (ccom G (cres c2nd (cxp cvv cvv))))) $ >
  $ wceq A2 (co cc0 cpnf cico) $ >
  $ wceq B2 cr $ >
  $ wceq F (cres csqrt A2) $ >
  $ wceq G (cres csin B2) $ >
  $ wi (wa (wcel X A2) (wcel Y B2)) (wceq (co X Y (ccom caddc H)) (co (cfv X csqrt) (cfv Y csin) caddc)) $;

--| Poisson d'Avril's Theorem. This theorem is noted for its _Selbstdokumentieren_ property, which means, literally, "self-documenting" and recalls the principle of _quidquid german dictum sit, altum viditur_, often used in set theory. Starting with the seemingly simple yet profound fact that any object ` x ` equals itself (proved by Tarski in 1965; see Lemma 6 of [Tarski] p. 68), we demonstrate that the power set of the real numbers, as a relation on the value of the imaginary unit, does not conjoin with an empty relation on the product of the additive and multiplicative identity elements, leading to this startling conclusion that has left even seasoned professional mathematicians scratching their heads. (Contributed by Prof. Loof Lirpa, 1-Apr-2005.) (Proof modification is discouraged.) (New usage is discouraged.) _A reply to skeptics can be found at ~ mmnotes.txt , under the 1-Apr-2006 entry_.
theorem avril1 (A2 F: class):
  $ wn (wa (wbr A2 (cfv c1 ci) (cpw cr)) (wbr F (co cc0 c1 cmul) c0)) $;

--| The law of excluded middle. Act III, Theorem 1 of Shakespeare, _Hamlet, Prince of Denmark_ (1602). Its author leaves its proof as an exercise for the reader - "To be, or not to be: that is the question" - starting a trend that has become standard in modern-day textbooks, serving to make the frustrated reader feel inferior, or in some cases to mask the fact that the author does not know its solution. (Contributed by Prof. Loof Lirpa, 1-Apr-2006.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem _2bornot2b (B2: class):
  $ wo (wbr c2 B2 cmul) (wn (wbr c2 B2 cmul)) $;

--| The classic "Hello world" benchmark has been translated into 314 computer programming languages - see ~ http://helloworldcollection.de . However, for many years it eluded a proof that it is more than just a conjecture, even though a wily mathematician once claimed, "I have discovered a truly marvelous proof of this, which this margin is too narrow to contain." Using an IBM 709 mainframe, a team of mathematicians led by Prof. Loof Lirpa, at the New College of Tahiti, were finally able to put it to rest with a remarkably short proof only four lines long. (Contributed by Prof. Loof Lirpa, 1-Apr-2007.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem helloworld (h: setvar) (L W: class) (d: setvar):
  $ wn (wa (wcel (cv h) (co L cc0 L)) (wbr W (co cnr (cv d) c1) c0)) $;

--| One plus one equals two. Using proof-shortening techniques pioneered by Mr. Mel L. O'Cat, along with the latest supercomputer technology, Prof. Loof Lirpa and colleagues were able to shorten Whitehead and Russell's 360-page proof that 1+1=2 in _Principia Mathematica_ to this remarkable proof only two steps long, thus establishing a new world's record for this famous theorem. (Contributed by Prof. Loof Lirpa, 1-Apr-2008.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem _1p1e2apr1:
  $ wceq (co c1 c1 caddc) c2 $;

--| Law of identity (reflexivity of class equality). Theorem 6.4 of [Quine] p. 41. This law is thought to have originated with Aristotle (_Metaphysics_, Book VII, Part 17). It is one of the three axioms of Ayn Rand's philosophy (_Atlas Shrugged_, Part Three, Chapter VII). While some have proposed extending Rand's axiomatization to include Compassion and Kindness, others fear that such an extension may flirt with logical inconsistency. (Contributed by Stefan Allan, 1-Apr-2009.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem eqid1 (A2: class):
  $ wceq A2 A2 $;

--| Division by zero is forbidden! If we try, we encounter the DO NOT ENTER sign, which in mathematics means it is foolhardy to venture any further, possibly putting the underlying fabric of reality at risk. Based on a dare by David A. Wheeler. (Contributed by Mario Carneiro, 1-Apr-2014.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem _1div0apr:
  $ wceq (co c1 cc0 cdiv) c0 $;

--| Nothing seems to be impossible to Prof. Lirpa. After years of intensive research, he managed to find a proof that when given a chance to reach infinity, one could indeed go beyond, thus giving formal soundness to Buzz Lightyear's motto "To infinity... and beyond!" (Contributed by Prof. Loof Lirpa, 1-Apr-2020.) (Revised by Thierry Arnoux, 2-Aug-2020.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem topnfbey (B2: class):
  $ wi (wcel B2 (co cc0 cpnf cfz)) (wbr cpnf B2 clt) $;

--| 9 + 10 is not equal to 21. This disproves a popular meme which asserts that 9 + 10 does equal 21. See ~ https://www.quora.com/Can-someone-try-to-prove-to-me-that-9+10-21 for attempts to prove that 9 + 10 = 21, and see https://tinyurl.com/9p10e21 for the history of the 9 + 10 = 21 meme. (Contributed by BTernaryTau, 25-Aug-2023.)
theorem _9p10ne21:
  $ wne (co c9 (cdc c1 cc0) caddc) (cdc c2 c1) $;

--| 9 + 10 equals 21. This astonishing thesis lives as a meme on the internet, and may be believed by quite some people. At least repeated requests to falsify it are a permanent part of the story. Prof. Loof Lirpa did not rest until he finally came up with a computer verifiable mathematical proof, that only a fool can think so. (Contributed by Prof. Loof Lirpa, 26-Aug-2023.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem _9p10ne21fool (F: class):
  $ wi (wceq (co c9 (cdc c1 cc0) caddc) (cdc c2 c1)) (wbr F (co cc0 c1 cmul) c0) $;

--| This factoid is e.g. useful for ~ nrt2irr . Andrew has a proof, I'll have a go at formalizing it after my coffee break. In the mean time let's add it as an axiom. (Contributed by Prof. Loof Lirpa, 1-Apr-2025.) (New usage is discouraged.)
axiom ax_flt (N X Y Z: class):
  $ wi (wa (wcel N (cfv c3 cuz)) (w3a (wcel X cn) (wcel Y cn) (wcel Z cn))) (wne (co (co X N cexp) (co Y N cexp) caddc) (co Z N cexp)) $;

--| The ` N ` -th root of 2 is irrational for ` N ` greater than ` 2 ` . For ` N = 2 ` , see ~ sqrt2irr . This short and rather elegant proof has the minor disadvantage that it refers to ~ ax-flt , which is still to be formalized. For a proof not requiring ~ ax-flt , see ~ rtprmirr . (Contributed by Prof. Loof Lirpa, 1-Apr-2025.) (Proof modification is discouraged.)
theorem nrt2irr (N: class):
  $ wi (wcel N (cfv c3 cuz)) (wn (wcel (co c2 (co c1 N cdiv) ccxp) cq)) $;

--| One's wisdom on matters of the universe can be refuted on April Fool's day. (Contributed by Prof. Loof Lirpa, 1-Apr-2026.) (New usage is discouraged.)
theorem nowisdomv (W: class):
  $ wn (wbr W (cdm cvv) (cs2 cid c5)) $;

--| Extend class notation with the class of all planar incidence geometries.
term cplig: class;

--| Define the class of planar incidence geometries. We use Hilbert's axioms and adapt them to planar geometry. We use ` e. ` for the incidence relation. We could have used a generic binary relation, but using ` e. ` allows to reuse previous results. Much of what follows is directly borrowed from Aitken, _Incidence-Betweenness Geometry_, 2008, ~ http://public.csusm.edu/aitken_html/m410/betweenness.08.pdf . The class ` Plig ` is the class of planar incidence geometries, where a planar incidence geometry is defined as a set of lines satisfying three axioms. In the definition below, ` x ` denotes a planar incidence geometry, so ` U. x ` denotes the union of its lines, that is, the set of points in the plane, ` l ` denotes a line, and ` a , b , c ` denote points. Therefore, the axioms are: 1) for all pairs of (distinct) points, there exists a unique line containing them; 2) all lines contain at least two points; 3) there exist three non-collinear points. (Contributed by FL, 2-Aug-2009.)
axiom df_plig {x3 a b c l: setvar}:
  $ wceq cplig (cab x3 (w3a (wral a (wral b (wi (wne (cv a) (cv b)) (wreu l (wa (wcel (cv a) (cv l)) (wcel (cv b) (cv l))) (cv x3))) (cuni (cv x3))) (cuni (cv x3))) (wral l (wrex a (wrex b (w3a (wne (cv a) (cv b)) (wcel (cv a) (cv l)) (wcel (cv b) (cv l))) (cuni (cv x3))) (cuni (cv x3))) (cv x3)) (wrex a (wrex b (wrex c (wral l (wn (w3a (wcel (cv a) (cv l)) (wcel (cv b) (cv l)) (wcel (cv c) (cv l)))) (cv x3)) (cuni (cv x3))) (cuni (cv x3))) (cuni (cv x3))))) $;

--| The predicate "is a planar incidence geometry" for sets. (Contributed by FL, 2-Aug-2009.)
theorem isplig {a b c l: setvar} (A2: class a b c l) (P: class l) (G: class):
  $ wceq P (cuni G) $ >
  $ wi (wcel G A2) (wb (wcel G cplig) (w3a (wral a (wral b (wi (wne (cv a) (cv b)) (wreu l (wa (wcel (cv a) (cv l)) (wcel (cv b) (cv l))) G)) P) P) (wral l (wrex a (wrex b (w3a (wne (cv a) (cv b)) (wcel (cv a) (cv l)) (wcel (cv b) (cv l))) P) P) G) (wrex a (wrex b (wrex c (wral l (wn (w3a (wcel (cv a) (cv l)) (wcel (cv b) (cv l)) (wcel (cv c) (cv l)))) G) P) P) P))) $;

--| The predicate "is a planar incidence geometry". (Contributed by BJ, 2-Dec-2021.)
theorem ispligb {a b c l: setvar} (P: class l) (G: class):
  $ wceq P (cuni G) $ >
  $ wb (wcel G cplig) (wa (wcel G cvv) (w3a (wral a (wral b (wi (wne (cv a) (cv b)) (wreu l (wa (wcel (cv a) (cv l)) (wcel (cv b) (cv l))) G)) P) P) (wral l (wrex a (wrex b (w3a (wne (cv a) (cv b)) (wcel (cv a) (cv l)) (wcel (cv b) (cv l))) P) P) G) (wrex a (wrex b (wrex c (wral l (wn (w3a (wcel (cv a) (cv l)) (wcel (cv b) (cv l)) (wcel (cv c) (cv l)))) G) P) P) P))) $;

--| In any planar incidence geometry, there exist three non-collinear points. (Contributed by FL, 3-Aug-2009.)
theorem tncp {a b c l: setvar} (P: class l) (G: class):
  $ wceq P (cuni G) $ >
  $ wi (wcel G cplig) (wrex a (wrex b (wrex c (wral l (wn (w3a (wcel (cv a) (cv l)) (wcel (cv b) (cv l)) (wcel (cv c) (cv l)))) G) P) P) P) $;

--| For any line in a planar incidence geometry, there exist two different points on the line. (Contributed by AV, 28-Nov-2021.)
theorem l2p {a b: setvar} (P G L: class):
  $ wceq P (cuni G) $ >
  $ wi (wa (wcel G cplig) (wcel L G)) (wrex a (wrex b (w3a (wne (cv a) (cv b)) (wcel (cv a) L) (wcel (cv b) L)) P) P) $;

--| For any line in a planar incidence geometry, there exists a point not on the line. (Contributed by Jeff Hankins, 15-Aug-2009.)
theorem lpni {a: setvar} (P G L: class):
  $ wceq P (cuni G) $ >
  $ wi (wa (wcel G cplig) (wcel L G)) (wrex a (wnel (cv a) L) P) $;

--| There is no "one-point line" in a planar incidence geometry. (Contributed by BJ, 2-Dec-2021.) (Proof shortened by AV, 5-Dec-2021.)
theorem nsnlplig (A2 G: class):
  $ wi (wcel G cplig) (wn (wcel (csn A2) G)) $;

--| Alternate version of ~ nsnlplig using the predicate ` e/ ` instead of ` -. e. ` and whose proof is shorter. (Contributed by AV, 5-Dec-2021.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem nsnlpligALT (A2 G: class):
  $ wi (wcel G cplig) (wnel (csn A2) G) $;

--| There is no "empty line" in a planar incidence geometry. (Contributed by AV, 28-Nov-2021.) (Proof shortened by BJ, 2-Dec-2021.)
theorem n0lplig (G: class):
  $ wi (wcel G cplig) (wn (wcel c0 G)) $;

--| Alternate version of ~ n0lplig using the predicate ` e/ ` instead of ` -. e. ` and whose proof bypasses ~ nsnlplig . (Contributed by AV, 28-Nov-2021.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem n0lpligALT (G: class):
  $ wi (wcel G cplig) (wnel c0 G) $;

--| Through two distinct points of a planar incidence geometry, there is a unique line. (Contributed by BJ, 2-Dec-2021.)
theorem eulplig {l: setvar} (A2 B2: class) (P: class l) (G: class):
  $ wceq P (cuni G) $ >
  $ wi (wa (wcel G cplig) (wa (wa (wcel A2 P) (wcel B2 P)) (wne A2 B2))) (wreu l (wa (wcel A2 (cv l)) (wcel B2 (cv l))) G) $;

--| Any planar incidence geometry ` G ` can be regarded as a hypergraph with its points as vertices and its lines as edges. See ~ incistruhgr for a generalization of this case for arbitrary incidence structures (planar incidence geometries are such incidence structures). (Proposed by Gerard Lang, 24-Nov-2021.) (Contributed by AV, 28-Nov-2021.)
theorem pliguhgr (G: class):
  $ wi (wcel G cplig) (wcel (cop (cuni G) (cres cid G)) cuhgr) $;

--| Alias for ~ a1ii that may be referenced in some older works, and kept here to prevent broken links. If you landed here, please let the originating site and/or us know that the link that made you land here should be changed to a link to ~ a1ii . (Contributed by NM, 7-Feb-2006.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem dummylink (ph ps: wff):
  $ ph $ >
  $ ps $ >
  $ ph $;

--| Alias for ~ idALT that may be referenced in some older works, and kept here to prevent broken links. If you landed here, please let the originating site and/or us know that the link that made you land here should be changed to a link to ~ idALT . (Contributed by NM, 30-Sep-1992.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem id1 (ph: wff):
  $ wi ph ph $;

--| Extend class notation with the class of all group operations.
term cgr: class;

--| Extend class notation with a function mapping a group operation to the group's identity element.
term cgi: class;

--| Extend class notation with a function mapping a group operation to the inverse function for the group.
term cgn: class;

--| Extend class notation with a function mapping a group operation to the division (or subtraction) operation for the group.
term cgs: class;

--| Define the class of all group operations. The base set for a group can be determined from its group operation. Based on the definition in Exercise 28 of [Herstein] p. 54. (Contributed by NM, 10-Oct-2006.) (New usage is discouraged.)
axiom df_grpo {x3 y1 z u t g2: setvar}:
  $ wceq cgr (cab g2 (wex t (w3a (wf (cxp (cv t) (cv t)) (cv t) (cv g2)) (wral x3 (wral y1 (wral z (wceq (co (co (cv x3) (cv y1) (cv g2)) (cv z) (cv g2)) (co (cv x3) (co (cv y1) (cv z) (cv g2)) (cv g2))) (cv t)) (cv t)) (cv t)) (wrex u (wral x3 (wa (wceq (co (cv u) (cv x3) (cv g2)) (cv x3)) (wrex y1 (wceq (co (cv y1) (cv x3) (cv g2)) (cv u)) (cv t))) (cv t)) (cv t))))) $;

--| Define a function that maps a group operation to the group's identity element. (Contributed by FL, 5-Feb-2010.) (Revised by Mario Carneiro, 15-Dec-2013.) (New usage is discouraged.)
axiom df_gid {x3 u g2: setvar}:
  $ wceq cgi (cmpt g2 cvv (crio u (wral x3 (wa (wceq (co (cv u) (cv x3) (cv g2)) (cv x3)) (wceq (co (cv x3) (cv u) (cv g2)) (cv x3))) (crn (cv g2))) (crn (cv g2)))) $;

--| Define a function that maps a group operation to the group's inverse function. (Contributed by NM, 26-Oct-2006.) (New usage is discouraged.)
axiom df_ginv {x3 z g2: setvar}:
  $ wceq cgn (cmpt g2 cgr (cmpt x3 (crn (cv g2)) (crio z (wceq (co (cv z) (cv x3) (cv g2)) (cfv (cv g2) cgi)) (crn (cv g2))))) $;

--| Define a function that maps a group operation to the group's division (or subtraction) operation. (Contributed by NM, 15-Feb-2008.) (New usage is discouraged.)
axiom df_gdiv {x3 y1 g2: setvar}:
  $ wceq cgs (cmpt g2 cgr (cmpo x3 y1 (crn (cv g2)) (crn (cv g2)) (co (cv x3) (cfv (cv y1) (cfv (cv g2) cgn)) (cv g2)))) $;

--| The predicate "is a group operation." Note that ` X ` is the base set of the group. (Contributed by NM, 10-Oct-2006.) (New usage is discouraged.)
theorem isgrpo {x3 y1 z u: setvar} (A2: class x3 y1 z u) (G X: class):
  $ wceq X (crn G) $ >
  $ wi (wcel G A2) (wb (wcel G cgr) (w3a (wf (cxp X X) X G) (wral x3 (wral y1 (wral z (wceq (co (co (cv x3) (cv y1) G) (cv z) G) (co (cv x3) (co (cv y1) (cv z) G) G)) X) X) X) (wrex u (wral x3 (wa (wceq (co (cv u) (cv x3) G) (cv x3)) (wrex y1 (wceq (co (cv y1) (cv x3) G) (cv u)) X)) X) X))) $;

--| Properties that determine a group operation. Read ` N ` as ` N ( x ) ` . (Contributed by NM, 4-Nov-2006.) (New usage is discouraged.)
theorem isgrpoi {x3 y1 z: setvar} (U G: class) (N: class x3 z) (X: class):
  $ wcel X cvv $ >
  $ wf (cxp X X) X G $ >
  $ wi (w3a (wcel (cv x3) X) (wcel (cv y1) X) (wcel (cv z) X)) (wceq (co (co (cv x3) (cv y1) G) (cv z) G) (co (cv x3) (co (cv y1) (cv z) G) G)) $ >
  $ wcel U X $ >
  $ wi (wcel (cv x3) X) (wceq (co U (cv x3) G) (cv x3)) $ >
  $ wi (wcel (cv x3) X) (wcel N X) $ >
  $ wi (wcel (cv x3) X) (wceq (co N (cv x3) G) U) $ >
  $ wcel G cgr $;

--| A group operation maps onto the group's underlying set. (Contributed by NM, 30-Oct-2006.) (New usage is discouraged.)
theorem grpofo (G X: class):
  $ wceq X (crn G) $ >
  $ wi (wcel G cgr) (wfo (cxp X X) X G) $;

--| Closure law for a group operation. (Contributed by NM, 10-Oct-2006.) (New usage is discouraged.)
theorem grpocl (A2 B2 G X: class):
  $ wceq X (crn G) $ >
  $ wi (w3a (wcel G cgr) (wcel A2 X) (wcel B2 X)) (wcel (co A2 B2 G) X) $;

--| A group has a left identity element, and every member has a left inverse. (Contributed by NM, 2-Nov-2006.) (New usage is discouraged.)
theorem grpolidinv {x3 y1 u: setvar} (G X: class):
  $ wceq X (crn G) $ >
  $ wi (wcel G cgr) (wrex u (wral x3 (wa (wceq (co (cv u) (cv x3) G) (cv x3)) (wrex y1 (wceq (co (cv y1) (cv x3) G) (cv u)) X)) X) X) $;

--| The base set of a group is not empty. (Contributed by Szymon Jaroszewicz, 3-Apr-2007.) (New usage is discouraged.)
theorem grpon0 (G X: class):
  $ wceq X (crn G) $ >
  $ wi (wcel G cgr) (wne X c0) $;

--| A group operation is associative. (Contributed by NM, 10-Oct-2006.) (New usage is discouraged.)
theorem grpoass (A2 B2 C G X: class):
  $ wceq X (crn G) $ >
  $ wi (wa (wcel G cgr) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wceq (co (co A2 B2 G) C G) (co A2 (co B2 C G) G)) $;

--| Lemma for ~ grpoidinv . (Contributed by NM, 10-Oct-2006.) (New usage is discouraged.)
theorem grpoidinvlem1 (A2 U G X Y: class):
  $ wceq X (crn G) $ >
  $ wi (wa (wa (wcel G cgr) (wa (wcel Y X) (wcel A2 X))) (wa (wceq (co Y A2 G) U) (wceq (co A2 A2 G) A2))) (wceq (co U A2 G) U) $;

--| Lemma for ~ grpoidinv . (Contributed by NM, 10-Oct-2006.) (New usage is discouraged.)
theorem grpoidinvlem2 (A2 U G X Y: class):
  $ wceq X (crn G) $ >
  $ wi (wa (wa (wcel G cgr) (wa (wcel Y X) (wcel A2 X))) (wa (wceq (co U Y G) Y) (wceq (co Y A2 G) U))) (wceq (co (co A2 Y G) (co A2 Y G) G) (co A2 Y G)) $;

--| Lemma for ~ grpoidinv . (Contributed by NM, 11-Oct-2006.) (New usage is discouraged.)
theorem grpoidinvlem3 {x3 y1 z: setvar} (ph ps: wff x3 z) (A2 U G X: class):
  $ wceq X (crn G) $ >
  $ wb ph (wral x3 (wceq (co U (cv x3) G) (cv x3)) X) $ >
  $ wb ps (wral x3 (wrex z (wceq (co (cv z) (cv x3) G) U) X) X) $ >
  $ wi (wa (wa (wa (wcel G cgr) (wcel U X)) (wa ph ps)) (wcel A2 X)) (wrex y1 (wa (wceq (co (cv y1) A2 G) U) (wceq (co A2 (cv y1) G) U)) X) $;

--| Lemma for ~ grpoidinv . (Contributed by NM, 14-Oct-2006.) (New usage is discouraged.)
theorem grpoidinvlem4 {y1: setvar} (A2 U G X: class):
  $ wceq X (crn G) $ >
  $ wi (wa (wa (wcel G cgr) (wcel A2 X)) (wrex y1 (wa (wceq (co (cv y1) A2 G) U) (wceq (co A2 (cv y1) G) U)) X)) (wceq (co A2 U G) (co U A2 G)) $;

--| A group has a left and right identity element, and every member has a left and right inverse. (Contributed by NM, 14-Oct-2006.) (New usage is discouraged.)
theorem grpoidinv {x3 y1 u: setvar} (G X: class):
  $ wceq X (crn G) $ >
  $ wi (wcel G cgr) (wrex u (wral x3 (wa (wa (wceq (co (cv u) (cv x3) G) (cv x3)) (wceq (co (cv x3) (cv u) G) (cv x3))) (wrex y1 (wa (wceq (co (cv y1) (cv x3) G) (cv u)) (wceq (co (cv x3) (cv y1) G) (cv u))) X)) X) X) $;

--| The left identity element of a group is unique. Lemma 2.2.1(a) of [Herstein] p. 55. (Contributed by NM, 14-Oct-2006.) (New usage is discouraged.)
theorem grpoideu {x3 u: setvar} (G X: class):
  $ wceq X (crn G) $ >
  $ wi (wcel G cgr) (wreu u (wral x3 (wceq (co (cv u) (cv x3) G) (cv x3)) X) X) $;

--| A group's range in terms of its domain. (Contributed by NM, 6-Apr-2008.) (New usage is discouraged.)
theorem grporndm (G: class):
  $ wi (wcel G cgr) (wceq (crn G) (cdm (cdm G))) $;

--| The empty set is not a group. (Contributed by NM, 25-Apr-2007.) (New usage is discouraged.)
theorem _0ngrp:
  $ wn (wcel c0 cgr) $;

--| The value of the identity element of a group. (Contributed by Mario Carneiro, 15-Dec-2013.) (New usage is discouraged.)
theorem gidval {x3 u: setvar} (G: class) (V: class x3 u) (X: class):
  $ wceq X (crn G) $ >
  $ wi (wcel G V) (wceq (cfv G cgi) (crio u (wral x3 (wa (wceq (co (cv u) (cv x3) G) (cv x3)) (wceq (co (cv x3) (cv u) G) (cv x3))) X) X)) $;

--| Lemma for ~ grpoidcl and others. (Contributed by NM, 5-Feb-2010.) (Proof shortened by Mario Carneiro, 15-Dec-2013.) (New usage is discouraged.)
theorem grpoidval {x3 u: setvar} (U G X: class):
  $ wceq X (crn G) $ >
  $ wceq U (cfv G cgi) $ >
  $ wi (wcel G cgr) (wceq U (crio u (wral x3 (wceq (co (cv u) (cv x3) G) (cv x3)) X) X)) $;

--| The identity element of a group belongs to the group. (Contributed by NM, 24-Oct-2006.) (Revised by Mario Carneiro, 15-Dec-2013.) (New usage is discouraged.)
theorem grpoidcl (U G X: class):
  $ wceq X (crn G) $ >
  $ wceq U (cfv G cgi) $ >
  $ wi (wcel G cgr) (wcel U X) $;

--| A group's properties using the explicit identity element. (Contributed by NM, 5-Feb-2010.) (Revised by Mario Carneiro, 15-Dec-2013.) (New usage is discouraged.)
theorem grpoidinv2 {y1: setvar} (A2 U G X: class):
  $ wceq X (crn G) $ >
  $ wceq U (cfv G cgi) $ >
  $ wi (wa (wcel G cgr) (wcel A2 X)) (wa (wa (wceq (co U A2 G) A2) (wceq (co A2 U G) A2)) (wrex y1 (wa (wceq (co (cv y1) A2 G) U) (wceq (co A2 (cv y1) G) U)) X)) $;

--| The identity element of a group is a left identity. (Contributed by NM, 24-Oct-2006.) (Revised by Mario Carneiro, 15-Dec-2013.) (New usage is discouraged.)
theorem grpolid (A2 U G X: class):
  $ wceq X (crn G) $ >
  $ wceq U (cfv G cgi) $ >
  $ wi (wa (wcel G cgr) (wcel A2 X)) (wceq (co U A2 G) A2) $;

--| The identity element of a group is a right identity. (Contributed by NM, 24-Oct-2006.) (Revised by Mario Carneiro, 15-Dec-2013.) (New usage is discouraged.)
theorem grporid (A2 U G X: class):
  $ wceq X (crn G) $ >
  $ wceq U (cfv G cgi) $ >
  $ wi (wa (wcel G cgr) (wcel A2 X)) (wceq (co A2 U G) A2) $;

--| Right cancellation law for groups. (Contributed by NM, 26-Oct-2006.) (New usage is discouraged.)
theorem grporcan (A2 B2 C G X: class):
  $ wceq X (crn G) $ >
  $ wi (wa (wcel G cgr) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wb (wceq (co A2 C G) (co B2 C G)) (wceq A2 B2)) $;

--| The left inverse element of a group is unique. Lemma 2.2.1(b) of [Herstein] p. 55. (Contributed by NM, 27-Oct-2006.) (New usage is discouraged.)
theorem grpoinveu {y1: setvar} (A2 U G X: class):
  $ wceq X (crn G) $ >
  $ wceq U (cfv G cgi) $ >
  $ wi (wa (wcel G cgr) (wcel A2 X)) (wreu y1 (wceq (co (cv y1) A2 G) U) X) $;

--| Two ways of saying that an element of a group is the identity element. (Contributed by Paul Chapman, 25-Feb-2008.) (New usage is discouraged.)
theorem grpoid (A2 U G X: class):
  $ wceq X (crn G) $ >
  $ wceq U (cfv G cgi) $ >
  $ wi (wa (wcel G cgr) (wcel A2 X)) (wb (wceq A2 U) (wceq (co A2 A2 G) A2)) $;

--| The range of a group operation. Useful for satisfying group base set hypotheses of the form ` X = ran G ` . (Contributed by NM, 5-Nov-2006.) (New usage is discouraged.)
theorem grporn (G X: class):
  $ wcel G cgr $ >
  $ wceq (cdm G) (cxp X X) $ >
  $ wceq X (crn G) $;

--| The inverse function of a group. (Contributed by NM, 26-Oct-2006.) (Revised by Mario Carneiro, 15-Dec-2013.) (New usage is discouraged.)
theorem grpoinvfval {x3 y1: setvar} (U: class y1) (G: class) (N: class x3 y1) (X: class):
  $ wceq X (crn G) $ >
  $ wceq U (cfv G cgi) $ >
  $ wceq N (cfv G cgn) $ >
  $ wi (wcel G cgr) (wceq N (cmpt x3 X (crio y1 (wceq (co (cv y1) (cv x3) G) U) X))) $;

--| The inverse of a group element. (Contributed by NM, 26-Oct-2006.) (Revised by Mario Carneiro, 15-Dec-2013.) (New usage is discouraged.)
theorem grpoinvval {y1: setvar} (A2: class) (U: class y1) (G: class) (N: class y1) (X: class):
  $ wceq X (crn G) $ >
  $ wceq U (cfv G cgi) $ >
  $ wceq N (cfv G cgn) $ >
  $ wi (wa (wcel G cgr) (wcel A2 X)) (wceq (cfv A2 N) (crio y1 (wceq (co (cv y1) A2 G) U) X)) $;

--| A group element's inverse is a group element. (Contributed by NM, 27-Oct-2006.) (Revised by Mario Carneiro, 15-Dec-2013.) (New usage is discouraged.)
theorem grpoinvcl (A2 G N X: class):
  $ wceq X (crn G) $ >
  $ wceq N (cfv G cgn) $ >
  $ wi (wa (wcel G cgr) (wcel A2 X)) (wcel (cfv A2 N) X) $;

--| The properties of a group element's inverse. (Contributed by NM, 27-Oct-2006.) (Revised by Mario Carneiro, 15-Dec-2013.) (New usage is discouraged.)
theorem grpoinv (A2 U G N X: class):
  $ wceq X (crn G) $ >
  $ wceq U (cfv G cgi) $ >
  $ wceq N (cfv G cgn) $ >
  $ wi (wa (wcel G cgr) (wcel A2 X)) (wa (wceq (co (cfv A2 N) A2 G) U) (wceq (co A2 (cfv A2 N) G) U)) $;

--| The left inverse of a group element. (Contributed by NM, 27-Oct-2006.) (New usage is discouraged.)
theorem grpolinv (A2 U G N X: class):
  $ wceq X (crn G) $ >
  $ wceq U (cfv G cgi) $ >
  $ wceq N (cfv G cgn) $ >
  $ wi (wa (wcel G cgr) (wcel A2 X)) (wceq (co (cfv A2 N) A2 G) U) $;

--| The right inverse of a group element. (Contributed by NM, 27-Oct-2006.) (New usage is discouraged.)
theorem grporinv (A2 U G N X: class):
  $ wceq X (crn G) $ >
  $ wceq U (cfv G cgi) $ >
  $ wceq N (cfv G cgn) $ >
  $ wi (wa (wcel G cgr) (wcel A2 X)) (wceq (co A2 (cfv A2 N) G) U) $;

--| The inverse of a group element expressed in terms of the identity element. (Contributed by NM, 27-Oct-2006.) (New usage is discouraged.)
theorem grpoinvid1 (A2 B2 U G N X: class):
  $ wceq X (crn G) $ >
  $ wceq U (cfv G cgi) $ >
  $ wceq N (cfv G cgn) $ >
  $ wi (w3a (wcel G cgr) (wcel A2 X) (wcel B2 X)) (wb (wceq (cfv A2 N) B2) (wceq (co A2 B2 G) U)) $;

--| The inverse of a group element expressed in terms of the identity element. (Contributed by NM, 27-Oct-2006.) (New usage is discouraged.)
theorem grpoinvid2 (A2 B2 U G N X: class):
  $ wceq X (crn G) $ >
  $ wceq U (cfv G cgi) $ >
  $ wceq N (cfv G cgn) $ >
  $ wi (w3a (wcel G cgr) (wcel A2 X) (wcel B2 X)) (wb (wceq (cfv A2 N) B2) (wceq (co B2 A2 G) U)) $;

--| Left cancellation law for groups. (Contributed by NM, 27-Oct-2006.) (New usage is discouraged.)
theorem grpolcan (A2 B2 C G X: class):
  $ wceq X (crn G) $ >
  $ wi (wa (wcel G cgr) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wb (wceq (co C A2 G) (co C B2 G)) (wceq A2 B2)) $;

--| Double inverse law for groups. Lemma 2.2.1(c) of [Herstein] p. 55. (Contributed by NM, 27-Oct-2006.) (New usage is discouraged.)
theorem grpo2inv (A2 G N X: class):
  $ wceq X (crn G) $ >
  $ wceq N (cfv G cgn) $ >
  $ wi (wa (wcel G cgr) (wcel A2 X)) (wceq (cfv (cfv A2 N) N) A2) $;

--| Mapping of the inverse function of a group. (Contributed by NM, 29-Mar-2008.) (Revised by Mario Carneiro, 15-Dec-2013.) (New usage is discouraged.)
theorem grpoinvf (G N X: class):
  $ wceq X (crn G) $ >
  $ wceq N (cfv G cgn) $ >
  $ wi (wcel G cgr) (wf1o X X N) $;

--| The inverse of the group operation reverses the arguments. Lemma 2.2.1(d) of [Herstein] p. 55. (Contributed by NM, 27-Oct-2006.) (New usage is discouraged.)
theorem grpoinvop (A2 B2 G N X: class):
  $ wceq X (crn G) $ >
  $ wceq N (cfv G cgn) $ >
  $ wi (w3a (wcel G cgr) (wcel A2 X) (wcel B2 X)) (wceq (cfv (co A2 B2 G) N) (co (cfv B2 N) (cfv A2 N) G)) $;

--| Group division (or subtraction) operation. (Contributed by NM, 15-Feb-2008.) (Revised by Mario Carneiro, 15-Dec-2013.) (New usage is discouraged.)
theorem grpodivfval {x3 y1: setvar} (D: class x3 y1) (G N X: class):
  $ wceq X (crn G) $ >
  $ wceq N (cfv G cgn) $ >
  $ wceq D (cfv G cgs) $ >
  $ wi (wcel G cgr) (wceq D (cmpo x3 y1 X X (co (cv x3) (cfv (cv y1) N) G))) $;

--| Group division (or subtraction) operation value. (Contributed by NM, 15-Feb-2008.) (Revised by Mario Carneiro, 15-Dec-2013.) (New usage is discouraged.)
theorem grpodivval (A2 B2 D G N X: class):
  $ wceq X (crn G) $ >
  $ wceq N (cfv G cgn) $ >
  $ wceq D (cfv G cgs) $ >
  $ wi (w3a (wcel G cgr) (wcel A2 X) (wcel B2 X)) (wceq (co A2 B2 D) (co A2 (cfv B2 N) G)) $;

--| Group division by an inverse. (Contributed by NM, 15-Feb-2008.) (New usage is discouraged.)
theorem grpodivinv (A2 B2 D G N X: class):
  $ wceq X (crn G) $ >
  $ wceq N (cfv G cgn) $ >
  $ wceq D (cfv G cgs) $ >
  $ wi (w3a (wcel G cgr) (wcel A2 X) (wcel B2 X)) (wceq (co A2 (cfv B2 N) D) (co A2 B2 G)) $;

--| Inverse of a group division. (Contributed by NM, 24-Feb-2008.) (New usage is discouraged.)
theorem grpoinvdiv (A2 B2 D G N X: class):
  $ wceq X (crn G) $ >
  $ wceq N (cfv G cgn) $ >
  $ wceq D (cfv G cgs) $ >
  $ wi (w3a (wcel G cgr) (wcel A2 X) (wcel B2 X)) (wceq (cfv (co A2 B2 D) N) (co B2 A2 D)) $;

--| Mapping for group division. (Contributed by NM, 10-Apr-2008.) (Revised by Mario Carneiro, 15-Dec-2013.) (New usage is discouraged.)
theorem grpodivf (D G X: class):
  $ wceq X (crn G) $ >
  $ wceq D (cfv G cgs) $ >
  $ wi (wcel G cgr) (wf (cxp X X) X D) $;

--| Closure of group division (or subtraction) operation. (Contributed by NM, 15-Feb-2008.) (New usage is discouraged.)
theorem grpodivcl (A2 B2 D G X: class):
  $ wceq X (crn G) $ >
  $ wceq D (cfv G cgs) $ >
  $ wi (w3a (wcel G cgr) (wcel A2 X) (wcel B2 X)) (wcel (co A2 B2 D) X) $;

--| Double group division. (Contributed by NM, 24-Feb-2008.) (New usage is discouraged.)
theorem grpodivdiv (A2 B2 C D G X: class):
  $ wceq X (crn G) $ >
  $ wceq D (cfv G cgs) $ >
  $ wi (wa (wcel G cgr) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wceq (co A2 (co B2 C D) D) (co A2 (co C B2 D) G)) $;

--| Associative-type law for multiplication and division. (Contributed by NM, 15-Feb-2008.) (New usage is discouraged.)
theorem grpomuldivass (A2 B2 C D G X: class):
  $ wceq X (crn G) $ >
  $ wceq D (cfv G cgs) $ >
  $ wi (wa (wcel G cgr) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wceq (co (co A2 B2 G) C D) (co A2 (co B2 C D) G)) $;

--| Division of a group member by itself. (Contributed by NM, 15-Feb-2008.) (New usage is discouraged.)
theorem grpodivid (A2 D U G X: class):
  $ wceq X (crn G) $ >
  $ wceq D (cfv G cgs) $ >
  $ wceq U (cfv G cgi) $ >
  $ wi (wa (wcel G cgr) (wcel A2 X)) (wceq (co A2 A2 D) U) $;

--| Cancellation law for group division. ( ~ npcan analog.) (Contributed by NM, 15-Feb-2008.) (New usage is discouraged.)
theorem grponpcan (A2 B2 D G X: class):
  $ wceq X (crn G) $ >
  $ wceq D (cfv G cgs) $ >
  $ wi (w3a (wcel G cgr) (wcel A2 X) (wcel B2 X)) (wceq (co (co A2 B2 D) B2 G) A2) $;

--| Extend class notation with the class of all Abelian group operations.
term cablo: class;

--| Define the class of all Abelian group operations. (Contributed by NM, 2-Nov-2006.) (New usage is discouraged.)
axiom df_ablo {x3 y1 g2: setvar}:
  $ wceq cablo (crab g2 (wral x3 (wral y1 (wceq (co (cv x3) (cv y1) (cv g2)) (co (cv y1) (cv x3) (cv g2))) (crn (cv g2))) (crn (cv g2))) cgr) $;

--| The predicate "is an Abelian (commutative) group operation." (Contributed by NM, 2-Nov-2006.) (New usage is discouraged.)
theorem isablo {x3 y1: setvar} (G X: class):
  $ wceq X (crn G) $ >
  $ wb (wcel G cablo) (wa (wcel G cgr) (wral x3 (wral y1 (wceq (co (cv x3) (cv y1) G) (co (cv y1) (cv x3) G)) X) X)) $;

--| An Abelian group operation is a group operation. (Contributed by NM, 2-Nov-2006.) (New usage is discouraged.)
theorem ablogrpo (G: class):
  $ wi (wcel G cablo) (wcel G cgr) $;

--| An Abelian group operation is commutative. (Contributed by NM, 2-Nov-2006.) (New usage is discouraged.)
theorem ablocom (A2 B2 G X: class):
  $ wceq X (crn G) $ >
  $ wi (w3a (wcel G cablo) (wcel A2 X) (wcel B2 X)) (wceq (co A2 B2 G) (co B2 A2 G)) $;

--| Commutative/associative law for Abelian groups. (Contributed by NM, 26-Apr-2007.) (New usage is discouraged.)
theorem ablo32 (A2 B2 C G X: class):
  $ wceq X (crn G) $ >
  $ wi (wa (wcel G cablo) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wceq (co (co A2 B2 G) C G) (co (co A2 C G) B2 G)) $;

--| Commutative/associative law for Abelian groups. (Contributed by NM, 26-Apr-2007.) (New usage is discouraged.)
theorem ablo4 (A2 B2 C D G X: class):
  $ wceq X (crn G) $ >
  $ wi (w3a (wcel G cablo) (wa (wcel A2 X) (wcel B2 X)) (wa (wcel C X) (wcel D X))) (wceq (co (co A2 B2 G) (co C D G) G) (co (co A2 C G) (co B2 D G) G)) $;

--| Properties that determine an Abelian group operation. (Contributed by NM, 5-Nov-2006.) (New usage is discouraged.)
theorem isabloi {x3 y1: setvar} (G X: class):
  $ wcel G cgr $ >
  $ wceq (cdm G) (cxp X X) $ >
  $ wi (wa (wcel (cv x3) X) (wcel (cv y1) X)) (wceq (co (cv x3) (cv y1) G) (co (cv y1) (cv x3) G)) $ >
  $ wcel G cablo $;

--| Law for group multiplication and division. (Contributed by NM, 15-Feb-2008.) (New usage is discouraged.)
theorem ablomuldiv (A2 B2 C D G X: class):
  $ wceq X (crn G) $ >
  $ wceq D (cfv G cgs) $ >
  $ wi (wa (wcel G cablo) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wceq (co (co A2 B2 G) C D) (co (co A2 C D) B2 G)) $;

--| Law for double group division. (Contributed by NM, 29-Feb-2008.) (New usage is discouraged.)
theorem ablodivdiv (A2 B2 C D G X: class):
  $ wceq X (crn G) $ >
  $ wceq D (cfv G cgs) $ >
  $ wi (wa (wcel G cablo) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wceq (co A2 (co B2 C D) D) (co (co A2 B2 D) C G)) $;

--| Law for double group division. (Contributed by NM, 29-Feb-2008.) (New usage is discouraged.)
theorem ablodivdiv4 (A2 B2 C D G X: class):
  $ wceq X (crn G) $ >
  $ wceq D (cfv G cgs) $ >
  $ wi (wa (wcel G cablo) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wceq (co (co A2 B2 D) C D) (co A2 (co B2 C G) D)) $;

--| Swap the second and third terms in a double division. (Contributed by NM, 29-Feb-2008.) (New usage is discouraged.)
theorem ablodiv32 (A2 B2 C D G X: class):
  $ wceq X (crn G) $ >
  $ wceq D (cfv G cgs) $ >
  $ wi (wa (wcel G cablo) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wceq (co (co A2 B2 D) C D) (co (co A2 C D) B2 D)) $;

--| Cancellation law for group division. ( ~ nncan analog.) (Contributed by NM, 7-Mar-2008.) (New usage is discouraged.)
theorem ablonncan (A2 B2 D G X: class):
  $ wceq X (crn G) $ >
  $ wceq D (cfv G cgs) $ >
  $ wi (w3a (wcel G cablo) (wcel A2 X) (wcel B2 X)) (wceq (co A2 (co A2 B2 D) D) B2) $;

--| Cancellation law for group division. ( ~ nnncan1 analog.) (Contributed by NM, 7-Mar-2008.) (New usage is discouraged.)
theorem ablonnncan1 (A2 B2 C D G X: class):
  $ wceq X (crn G) $ >
  $ wceq D (cfv G cgs) $ >
  $ wi (wa (wcel G cablo) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wceq (co (co A2 B2 D) (co A2 C D) D) (co C B2 D)) $;

--| Extend class notation with the class of all complex vector spaces.
term cvc: class;

--| Define the class of all complex vector spaces. (Contributed by NM, 3-Nov-2006.) (New usage is discouraged.)
axiom df_vc {x3 y1 z g2 s1: setvar}:
  $ wceq cvc (copab g2 s1 (w3a (wcel (cv g2) cablo) (wf (cxp cc (crn (cv g2))) (crn (cv g2)) (cv s1)) (wral x3 (wa (wceq (co c1 (cv x3) (cv s1)) (cv x3)) (wral y1 (wa (wral z (wceq (co (cv y1) (co (cv x3) (cv z) (cv g2)) (cv s1)) (co (co (cv y1) (cv x3) (cv s1)) (co (cv y1) (cv z) (cv s1)) (cv g2))) (crn (cv g2))) (wral z (wa (wceq (co (co (cv y1) (cv z) caddc) (cv x3) (cv s1)) (co (co (cv y1) (cv x3) (cv s1)) (co (cv z) (cv x3) (cv s1)) (cv g2))) (wceq (co (co (cv y1) (cv z) cmul) (cv x3) (cv s1)) (co (cv y1) (co (cv z) (cv x3) (cv s1)) (cv s1)))) cc)) cc)) (crn (cv g2))))) $;

--| The class of all complex vector spaces is a relation. (Contributed by NM, 17-Mar-2007.) (New usage is discouraged.)
theorem vcrel:
  $ wrel cvc $;

--| Obsolete version of ~ cvsi . The properties of a complex vector space, which is an Abelian group (i.e. the vectors, with the operation of vector addition) accompanied by a scalar multiplication operation on the field of complex numbers. The variable ` W ` was chosen because ` _V ` is already used for the universal class. (Contributed by NM, 3-Nov-2006.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem vciOLD {x3 y1 z: setvar} (S G: class) (W: class x3 y1 z) (X: class):
  $ wceq G (cfv W c1st) $ >
  $ wceq S (cfv W c2nd) $ >
  $ wceq X (crn G) $ >
  $ wi (wcel W cvc) (w3a (wcel G cablo) (wf (cxp cc X) X S) (wral x3 (wa (wceq (co c1 (cv x3) S) (cv x3)) (wral y1 (wa (wral z (wceq (co (cv y1) (co (cv x3) (cv z) G) S) (co (co (cv y1) (cv x3) S) (co (cv y1) (cv z) S) G)) X) (wral z (wa (wceq (co (co (cv y1) (cv z) caddc) (cv x3) S) (co (co (cv y1) (cv x3) S) (co (cv z) (cv x3) S) G)) (wceq (co (co (cv y1) (cv z) cmul) (cv x3) S) (co (cv y1) (co (cv z) (cv x3) S) S))) cc)) cc)) X)) $;

--| Functionality of the scalar product of a complex vector space. (Contributed by NM, 3-Nov-2006.) (New usage is discouraged.)
theorem vcsm (S G W X: class):
  $ wceq G (cfv W c1st) $ >
  $ wceq S (cfv W c2nd) $ >
  $ wceq X (crn G) $ >
  $ wi (wcel W cvc) (wf (cxp cc X) X S) $;

--| Closure of the scalar product of a complex vector space. (Contributed by NM, 3-Nov-2006.) (New usage is discouraged.)
theorem vccl (A2 B2 S G W X: class):
  $ wceq G (cfv W c1st) $ >
  $ wceq S (cfv W c2nd) $ >
  $ wceq X (crn G) $ >
  $ wi (w3a (wcel W cvc) (wcel A2 cc) (wcel B2 X)) (wcel (co A2 B2 S) X) $;

--| Identity element for the scalar product of a complex vector space. (Contributed by NM, 3-Nov-2006.) Obsolete theorem, use ~ clmvs1 together with ~ cvsclm instead. (New usage is discouraged.) (Proof modification is discouraged.)
theorem vcidOLD (A2 S G W X: class):
  $ wceq G (cfv W c1st) $ >
  $ wceq S (cfv W c2nd) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wcel W cvc) (wcel A2 X)) (wceq (co c1 A2 S) A2) $;

--| Distributive law for the scalar product of a complex vector space. (Contributed by NM, 3-Nov-2006.) (New usage is discouraged.)
theorem vcdi (A2 B2 C S G W X: class):
  $ wceq G (cfv W c1st) $ >
  $ wceq S (cfv W c2nd) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wcel W cvc) (w3a (wcel A2 cc) (wcel B2 X) (wcel C X))) (wceq (co A2 (co B2 C G) S) (co (co A2 B2 S) (co A2 C S) G)) $;

--| Distributive law for the scalar product of a complex vector space. (Contributed by NM, 3-Nov-2006.) (New usage is discouraged.)
theorem vcdir (A2 B2 C S G W X: class):
  $ wceq G (cfv W c1st) $ >
  $ wceq S (cfv W c2nd) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wcel W cvc) (w3a (wcel A2 cc) (wcel B2 cc) (wcel C X))) (wceq (co (co A2 B2 caddc) C S) (co (co A2 C S) (co B2 C S) G)) $;

--| Associative law for the scalar product of a complex vector space. (Contributed by NM, 3-Nov-2006.) (New usage is discouraged.)
theorem vcass (A2 B2 C S G W X: class):
  $ wceq G (cfv W c1st) $ >
  $ wceq S (cfv W c2nd) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wcel W cvc) (w3a (wcel A2 cc) (wcel B2 cc) (wcel C X))) (wceq (co (co A2 B2 cmul) C S) (co A2 (co B2 C S) S)) $;

--| A vector plus itself is two times the vector. (Contributed by NM, 1-Feb-2007.) Obsolete theorem, use ~ clmvs2 together with ~ cvsclm instead. (New usage is discouraged.) (Proof modification is discouraged.)
theorem vc2OLD (A2 S G W X: class):
  $ wceq G (cfv W c1st) $ >
  $ wceq S (cfv W c2nd) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wcel W cvc) (wcel A2 X)) (wceq (co A2 A2 G) (co c2 A2 S)) $;

--| Vector addition is an Abelian group operation. (Contributed by NM, 3-Nov-2006.) (New usage is discouraged.)
theorem vcablo (G W: class):
  $ wceq G (cfv W c1st) $ >
  $ wi (wcel W cvc) (wcel G cablo) $;

--| Vector addition is a group operation. (Contributed by NM, 4-Nov-2006.) (New usage is discouraged.)
theorem vcgrp (G W: class):
  $ wceq G (cfv W c1st) $ >
  $ wi (wcel W cvc) (wcel G cgr) $;

--| Left cancellation law for vector addition. (Contributed by NM, 4-Nov-2006.) (New usage is discouraged.)
theorem vclcan (A2 B2 C G W X: class):
  $ wceq G (cfv W c1st) $ >
  $ wceq X (crn G) $ >
  $ wi (wa (wcel W cvc) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wb (wceq (co C A2 G) (co C B2 G)) (wceq A2 B2)) $;

--| The zero vector is a vector. (Contributed by NM, 4-Nov-2006.) (New usage is discouraged.)
theorem vczcl (G W X Z: class):
  $ wceq G (cfv W c1st) $ >
  $ wceq X (crn G) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wi (wcel W cvc) (wcel Z X) $;

--| The zero vector is a right identity element. (Contributed by NM, 4-Nov-2006.) (New usage is discouraged.)
theorem vc0rid (A2 G W X Z: class):
  $ wceq G (cfv W c1st) $ >
  $ wceq X (crn G) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wi (wa (wcel W cvc) (wcel A2 X)) (wceq (co A2 Z G) A2) $;

--| Zero times a vector is the zero vector. Equation 1a of [Kreyszig] p. 51. (Contributed by NM, 4-Nov-2006.) (New usage is discouraged.)
theorem vc0 (A2 S G W X Z: class):
  $ wceq G (cfv W c1st) $ >
  $ wceq S (cfv W c2nd) $ >
  $ wceq X (crn G) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wi (wa (wcel W cvc) (wcel A2 X)) (wceq (co cc0 A2 S) Z) $;

--| Anything times the zero vector is the zero vector. Equation 1b of [Kreyszig] p. 51. (Contributed by NM, 24-Nov-2006.) (New usage is discouraged.)
theorem vcz (A2 S G W X Z: class):
  $ wceq G (cfv W c1st) $ >
  $ wceq S (cfv W c2nd) $ >
  $ wceq X (crn G) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wi (wa (wcel W cvc) (wcel A2 cc)) (wceq (co A2 Z S) Z) $;

--| Minus 1 times a vector is the underlying group's inverse element. Equation 2 of [Kreyszig] p. 51. (Contributed by NM, 25-Nov-2006.) (New usage is discouraged.)
theorem vcm (A2 S G M W X: class):
  $ wceq G (cfv W c1st) $ >
  $ wceq S (cfv W c2nd) $ >
  $ wceq X (crn G) $ >
  $ wceq M (cfv G cgn) $ >
  $ wi (wa (wcel W cvc) (wcel A2 X)) (wceq (co (cneg c1) A2 S) (cfv A2 M)) $;

--| Lemma for ~ isvcOLD . (Contributed by NM, 31-May-2008.) (New usage is discouraged.)
theorem isvclem {x3 y1 z: setvar} (S G: class) (X: class y1):
  $ wceq X (crn G) $ >
  $ wi (wa (wcel G cvv) (wcel S cvv)) (wb (wcel (cop G S) cvc) (w3a (wcel G cablo) (wf (cxp cc X) X S) (wral x3 (wa (wceq (co c1 (cv x3) S) (cv x3)) (wral y1 (wa (wral z (wceq (co (cv y1) (co (cv x3) (cv z) G) S) (co (co (cv y1) (cv x3) S) (co (cv y1) (cv z) S) G)) X) (wral z (wa (wceq (co (co (cv y1) (cv z) caddc) (cv x3) S) (co (co (cv y1) (cv x3) S) (co (cv z) (cv x3) S) G)) (wceq (co (co (cv y1) (cv z) cmul) (cv x3) S) (co (cv y1) (co (cv z) (cv x3) S) S))) cc)) cc)) X))) $;

--| The components of a complex vector space are sets. (Contributed by NM, 31-May-2008.) (New usage is discouraged.)
theorem vcex (S G: class):
  $ wi (wcel (cop G S) cvc) (wa (wcel G cvv) (wcel S cvv)) $;

--| The predicate "is a complex vector space." (Contributed by NM, 31-May-2008.) Obsolete version of ~ iscvsp . (New usage is discouraged.) (Proof modification is discouraged.)
theorem isvcOLD {x3 y1 z: setvar} (S G: class) (X: class y1):
  $ wceq X (crn G) $ >
  $ wb (wcel (cop G S) cvc) (w3a (wcel G cablo) (wf (cxp cc X) X S) (wral x3 (wa (wceq (co c1 (cv x3) S) (cv x3)) (wral y1 (wa (wral z (wceq (co (cv y1) (co (cv x3) (cv z) G) S) (co (co (cv y1) (cv x3) S) (co (cv y1) (cv z) S) G)) X) (wral z (wa (wceq (co (co (cv y1) (cv z) caddc) (cv x3) S) (co (co (cv y1) (cv x3) S) (co (cv z) (cv x3) S) G)) (wceq (co (co (cv y1) (cv z) cmul) (cv x3) S) (co (cv y1) (co (cv z) (cv x3) S) S))) cc)) cc)) X)) $;

--| Properties that determine a complex vector space. (Contributed by NM, 5-Nov-2006.) Obsolete version of ~ iscvsi . (New usage is discouraged.) (Proof modification is discouraged.)
theorem isvciOLD {x3 y1 z: setvar} (S G: class) (W: class x3 y1 z) (X: class):
  $ wcel G cablo $ >
  $ wceq (cdm G) (cxp X X) $ >
  $ wf (cxp cc X) X S $ >
  $ wi (wcel (cv x3) X) (wceq (co c1 (cv x3) S) (cv x3)) $ >
  $ wi (w3a (wcel (cv y1) cc) (wcel (cv x3) X) (wcel (cv z) X)) (wceq (co (cv y1) (co (cv x3) (cv z) G) S) (co (co (cv y1) (cv x3) S) (co (cv y1) (cv z) S) G)) $ >
  $ wi (w3a (wcel (cv y1) cc) (wcel (cv z) cc) (wcel (cv x3) X)) (wceq (co (co (cv y1) (cv z) caddc) (cv x3) S) (co (co (cv y1) (cv x3) S) (co (cv z) (cv x3) S) G)) $ >
  $ wi (w3a (wcel (cv y1) cc) (wcel (cv z) cc) (wcel (cv x3) X)) (wceq (co (co (cv y1) (cv z) cmul) (cv x3) S) (co (cv y1) (co (cv z) (cv x3) S) S)) $ >
  $ wceq W (cop G S) $ >
  $ wcel W cvc $;

--| Obsolete version of ~ cnaddabl . Complex number addition is an Abelian group operation. (Contributed by NM, 5-Nov-2006.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem cnaddabloOLD:
  $ wcel caddc cablo $;

--| Obsolete version of ~ cnaddid . The group identity element of complex number addition is zero. (Contributed by Steve Rodriguez, 3-Dec-2006.) (Revised by Mario Carneiro, 21-Dec-2013.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem cnidOLD:
  $ wceq cc0 (cfv caddc cgi) $;

--| Obsolete version of ~ cncvs . The set of complex numbers is a complex vector space. The vector operation is ` + ` , and the scalar product is ` x. ` . (Contributed by NM, 5-Nov-2006.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem cncvcOLD:
  $ wcel (cop caddc cmul) cvc $;

--| Extend class notation with the class of all normed complex vector spaces.
term cnv: class;

--| Extend class notation with vector addition in a normed complex vector space. In the literature, the subscript "v" is omitted, but we need it to avoid ambiguity with complex number addition ` + ` ~ caddc .
term cpv: class;

--| Extend class notation with the base set of a normed complex vector space. (Note that ` BaseSet ` is capitalized because, once it is fixed for a particular vector space ` U ` , it is not a function, unlike e.g., ` normCV ` . This is our typical convention.) (New usage is discouraged.)
term cba: class;

--| Extend class notation with scalar multiplication in a normed complex vector space. In the literature scalar multiplication is usually indicated by juxtaposition, but we need an explicit symbol to prevent ambiguity.
term cns: class;

--| Extend class notation with zero vector in a normed complex vector space.
term cn0v: class;

--| Extend class notation with vector subtraction in a normed complex vector space.
term cnsb: class;

--| Extend class notation with the norm function in a normed complex vector space. In the literature, the norm of ` A ` is usually written "|| ` A ` ||", but we use function notation to take advantage of our existing theorems about functions.
term cnmcv: class;

--| Extend class notation with the class of the induced metrics on normed complex vector spaces.
term cims: class;

--| Define the class of all normed complex vector spaces. (Contributed by NM, 11-Nov-2006.) (New usage is discouraged.)
axiom df_nv {x3 y1 g2 n s1: setvar}:
  $ wceq cnv (coprab g2 s1 n (w3a (wcel (cop (cv g2) (cv s1)) cvc) (wf (crn (cv g2)) cr (cv n)) (wral x3 (w3a (wi (wceq (cfv (cv x3) (cv n)) cc0) (wceq (cv x3) (cfv (cv g2) cgi))) (wral y1 (wceq (cfv (co (cv y1) (cv x3) (cv s1)) (cv n)) (co (cfv (cv y1) cabs) (cfv (cv x3) (cv n)) cmul)) cc) (wral y1 (wbr (cfv (co (cv x3) (cv y1) (cv g2)) (cv n)) (co (cfv (cv x3) (cv n)) (cfv (cv y1) (cv n)) caddc) cle) (crn (cv g2)))) (crn (cv g2))))) $;

--| Structure of the class of all normed complex vectors spaces. (Contributed by NM, 28-Nov-2006.) (Revised by Mario Carneiro, 1-May-2015.) (New usage is discouraged.)
theorem nvss:
  $ wss cnv (cxp cvc cvv) $;

--| A normed complex vector space is a vector space. (Contributed by NM, 5-Jun-2008.) (Revised by Mario Carneiro, 1-May-2015.) (New usage is discouraged.)
theorem nvvcop (N W: class):
  $ wi (wcel (cop W N) cnv) (wcel W cvc) $;

--| Define vector addition on a normed complex vector space. (Contributed by NM, 23-Apr-2007.) (New usage is discouraged.)
axiom df_va:
  $ wceq cpv (ccom c1st c1st) $;

--| Define the base set of a normed complex vector space. (Contributed by NM, 23-Apr-2007.) (New usage is discouraged.)
axiom df_ba {x3: setvar}:
  $ wceq cba (cmpt x3 cvv (crn (cfv (cv x3) cpv))) $;

--| Define scalar multiplication on a normed complex vector space. (Contributed by NM, 24-Apr-2007.) (New usage is discouraged.)
axiom df_sm:
  $ wceq cns (ccom c2nd c1st) $;

--| Define the zero vector in a normed complex vector space. (Contributed by NM, 24-Apr-2007.) (New usage is discouraged.)
axiom df_0v:
  $ wceq cn0v (ccom cgi cpv) $;

--| Define vector subtraction on a normed complex vector space. (Contributed by NM, 15-Feb-2008.) (New usage is discouraged.)
axiom df_vs:
  $ wceq cnsb (ccom cgs cpv) $;

--| Define the norm function in a normed complex vector space. (Contributed by NM, 25-Apr-2007.) (New usage is discouraged.)
axiom df_nmcv:
  $ wceq cnmcv c2nd $;

--| Define the induced metric on a normed complex vector space. (Contributed by NM, 11-Sep-2007.) (New usage is discouraged.)
axiom df_ims {u: setvar}:
  $ wceq cims (cmpt u cnv (ccom (cfv (cv u) cnmcv) (cfv (cv u) cnsb))) $;

--| The class of all normed complex vectors spaces is a relation. (Contributed by NM, 14-Nov-2006.) (New usage is discouraged.)
theorem nvrel:
  $ wrel cnv $;

--| Value of the function for the vector addition (group) operation on a normed complex vector space. (Contributed by NM, 23-Apr-2007.) (New usage is discouraged.)
theorem vafval (U G: class):
  $ wceq G (cfv U cpv) $ >
  $ wceq G (cfv (cfv U c1st) c1st) $;

--| Value of the function for the base set of a normed complex vector space. (Contributed by NM, 23-Apr-2007.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem bafval (U G X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq X (crn G) $;

--| Value of the function for the scalar multiplication operation on a normed complex vector space. (Contributed by NM, 24-Apr-2007.) (New usage is discouraged.)
theorem smfval (S U: class):
  $ wceq S (cfv U cns) $ >
  $ wceq S (cfv (cfv U c1st) c2nd) $;

--| Value of the function for the zero vector on a normed complex vector space. (Contributed by NM, 24-Apr-2007.) (Revised by Mario Carneiro, 21-Dec-2013.) (New usage is discouraged.)
theorem _0vfval (U G V Z: class):
  $ wceq G (cfv U cpv) $ >
  $ wceq Z (cfv U cn0v) $ >
  $ wi (wcel U V) (wceq Z (cfv G cgi)) $;

--| Value of the norm function in a normed complex vector space. (Contributed by NM, 25-Apr-2007.) (New usage is discouraged.)
theorem nmcvfval (U N: class):
  $ wceq N (cfv U cnmcv) $ >
  $ wceq N (cfv U c2nd) $;

--| A normed complex vector space is an ordered pair of a vector space and a norm operation. (Contributed by NM, 28-Nov-2006.) (New usage is discouraged.)
theorem nvop2 (U N W: class):
  $ wceq W (cfv U c1st) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wi (wcel U cnv) (wceq U (cop W N)) $;

--| The vector space component of a normed complex vector space is an ordered pair of the underlying group and a scalar product. (Contributed by NM, 28-Nov-2006.) (New usage is discouraged.)
theorem nvvop (S U G W: class):
  $ wceq W (cfv U c1st) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wi (wcel U cnv) (wceq W (cop G S)) $;

--| Lemma for ~ isnv . (Contributed by NM, 11-Nov-2006.) (New usage is discouraged.)
theorem isnvlem {x3 y1: setvar} (S G N X: class) (Z: class x3 y1):
  $ wceq X (crn G) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wi (w3a (wcel G cvv) (wcel S cvv) (wcel N cvv)) (wb (wcel (cop (cop G S) N) cnv) (w3a (wcel (cop G S) cvc) (wf X cr N) (wral x3 (w3a (wi (wceq (cfv (cv x3) N) cc0) (wceq (cv x3) Z)) (wral y1 (wceq (cfv (co (cv y1) (cv x3) S) N) (co (cfv (cv y1) cabs) (cfv (cv x3) N) cmul)) cc) (wral y1 (wbr (cfv (co (cv x3) (cv y1) G) N) (co (cfv (cv x3) N) (cfv (cv y1) N) caddc) cle) X)) X))) $;

--| The components of a normed complex vector space are sets. (Contributed by NM, 5-Jun-2008.) (Revised by Mario Carneiro, 1-May-2015.) (New usage is discouraged.)
theorem nvex (S G N: class):
  $ wi (wcel (cop (cop G S) N) cnv) (w3a (wcel G cvv) (wcel S cvv) (wcel N cvv)) $;

--| The predicate "is a normed complex vector space." (Contributed by NM, 5-Jun-2008.) (New usage is discouraged.)
theorem isnv {x3 y1: setvar} (S G N X: class) (Z: class x3 y1):
  $ wceq X (crn G) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wb (wcel (cop (cop G S) N) cnv) (w3a (wcel (cop G S) cvc) (wf X cr N) (wral x3 (w3a (wi (wceq (cfv (cv x3) N) cc0) (wceq (cv x3) Z)) (wral y1 (wceq (cfv (co (cv y1) (cv x3) S) N) (co (cfv (cv y1) cabs) (cfv (cv x3) N) cmul)) cc) (wral y1 (wbr (cfv (co (cv x3) (cv y1) G) N) (co (cfv (cv x3) N) (cfv (cv y1) N) caddc) cle) X)) X)) $;

--| Properties that determine a normed complex vector space. (Contributed by NM, 15-Apr-2007.) (New usage is discouraged.)
theorem isnvi {x3 y1: setvar} (S: class) (U: class x3 y1) (G N X: class) (Z: class x3 y1):
  $ wceq X (crn G) $ >
  $ wceq Z (cfv G cgi) $ >
  $ wcel (cop G S) cvc $ >
  $ wf X cr N $ >
  $ wi (wa (wcel (cv x3) X) (wceq (cfv (cv x3) N) cc0)) (wceq (cv x3) Z) $ >
  $ wi (wa (wcel (cv y1) cc) (wcel (cv x3) X)) (wceq (cfv (co (cv y1) (cv x3) S) N) (co (cfv (cv y1) cabs) (cfv (cv x3) N) cmul)) $ >
  $ wi (wa (wcel (cv x3) X) (wcel (cv y1) X)) (wbr (cfv (co (cv x3) (cv y1) G) N) (co (cfv (cv x3) N) (cfv (cv y1) N) caddc) cle) $ >
  $ wceq U (cop (cop G S) N) $ >
  $ wcel U cnv $;

--| The properties of a normed complex vector space, which is a vector space accompanied by a norm. (Contributed by NM, 11-Nov-2006.) (Revised by Mario Carneiro, 21-Dec-2013.) (New usage is discouraged.)
theorem nvi {x3 y1: setvar} (S: class) (U: class y1) (G N X: class) (Z: class x3 y1):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq Z (cfv U cn0v) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wi (wcel U cnv) (w3a (wcel (cop G S) cvc) (wf X cr N) (wral x3 (w3a (wi (wceq (cfv (cv x3) N) cc0) (wceq (cv x3) Z)) (wral y1 (wceq (cfv (co (cv y1) (cv x3) S) N) (co (cfv (cv y1) cabs) (cfv (cv x3) N) cmul)) cc) (wral y1 (wbr (cfv (co (cv x3) (cv y1) G) N) (co (cfv (cv x3) N) (cfv (cv y1) N) caddc) cle) X)) X)) $;

--| The vector space component of a normed complex vector space. (Contributed by NM, 28-Nov-2006.) (Revised by Mario Carneiro, 21-Dec-2013.) (New usage is discouraged.)
theorem nvvc (U W: class):
  $ wceq W (cfv U c1st) $ >
  $ wi (wcel U cnv) (wcel W cvc) $;

--| The vector addition operation of a normed complex vector space is an Abelian group. (Contributed by NM, 15-Feb-2008.) (New usage is discouraged.)
theorem nvablo (U G: class):
  $ wceq G (cfv U cpv) $ >
  $ wi (wcel U cnv) (wcel G cablo) $;

--| The vector addition operation of a normed complex vector space is a group. (Contributed by NM, 15-Feb-2008.) (New usage is discouraged.)
theorem nvgrp (U G: class):
  $ wceq G (cfv U cpv) $ >
  $ wi (wcel U cnv) (wcel G cgr) $;

--| Mapping for the vector addition operation. (Contributed by NM, 28-Jan-2008.) (New usage is discouraged.)
theorem nvgf (U G X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wi (wcel U cnv) (wf (cxp X X) X G) $;

--| Mapping for the scalar multiplication operation. (Contributed by NM, 28-Jan-2008.) (New usage is discouraged.)
theorem nvsf (S U X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq S (cfv U cns) $ >
  $ wi (wcel U cnv) (wf (cxp cc X) X S) $;

--| Closure law for the vector addition (group) operation of a normed complex vector space. (Contributed by NM, 23-Apr-2007.) (New usage is discouraged.)
theorem nvgcl (A2 B2 U G X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wi (w3a (wcel U cnv) (wcel A2 X) (wcel B2 X)) (wcel (co A2 B2 G) X) $;

--| The vector addition (group) operation is commutative. (Contributed by NM, 4-Dec-2007.) (New usage is discouraged.)
theorem nvcom (A2 B2 U G X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wi (w3a (wcel U cnv) (wcel A2 X) (wcel B2 X)) (wceq (co A2 B2 G) (co B2 A2 G)) $;

--| The vector addition (group) operation is associative. (Contributed by NM, 4-Dec-2007.) (New usage is discouraged.)
theorem nvass (A2 B2 C U G X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wi (wa (wcel U cnv) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wceq (co (co A2 B2 G) C G) (co A2 (co B2 C G) G)) $;

--| Commutative/associative law for vector addition. (Contributed by NM, 27-Dec-2007.) (New usage is discouraged.)
theorem nvadd32 (A2 B2 C U G X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wi (wa (wcel U cnv) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wceq (co (co A2 B2 G) C G) (co (co A2 C G) B2 G)) $;

--| Right cancellation law for vector addition. (Contributed by NM, 4-Dec-2007.) (New usage is discouraged.)
theorem nvrcan (A2 B2 C U G X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wi (wa (wcel U cnv) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wb (wceq (co A2 C G) (co B2 C G)) (wceq A2 B2)) $;

--| Rearrangement of 4 terms in a vector sum. (Contributed by NM, 8-Feb-2008.) (New usage is discouraged.)
theorem nvadd4 (A2 B2 C D U G X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wi (w3a (wcel U cnv) (wa (wcel A2 X) (wcel B2 X)) (wa (wcel C X) (wcel D X))) (wceq (co (co A2 B2 G) (co C D G) G) (co (co A2 C G) (co B2 D G) G)) $;

--| Closure law for the scalar product operation of a normed complex vector space. (Contributed by NM, 1-Feb-2007.) (New usage is discouraged.)
theorem nvscl (A2 B2 S U X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq S (cfv U cns) $ >
  $ wi (w3a (wcel U cnv) (wcel A2 cc) (wcel B2 X)) (wcel (co A2 B2 S) X) $;

--| Identity element for the scalar product of a normed complex vector space. (Contributed by NM, 4-Dec-2007.) (New usage is discouraged.)
theorem nvsid (A2 S U X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq S (cfv U cns) $ >
  $ wi (wa (wcel U cnv) (wcel A2 X)) (wceq (co c1 A2 S) A2) $;

--| Associative law for the scalar product of a normed complex vector space. (Contributed by NM, 17-Nov-2007.) (New usage is discouraged.)
theorem nvsass (A2 B2 C S U X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq S (cfv U cns) $ >
  $ wi (wa (wcel U cnv) (w3a (wcel A2 cc) (wcel B2 cc) (wcel C X))) (wceq (co (co A2 B2 cmul) C S) (co A2 (co B2 C S) S)) $;

--| Commutative law for the scalar product of a normed complex vector space. (Contributed by NM, 14-Feb-2008.) (New usage is discouraged.)
theorem nvscom (A2 B2 C S U X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq S (cfv U cns) $ >
  $ wi (wa (wcel U cnv) (w3a (wcel A2 cc) (wcel B2 cc) (wcel C X))) (wceq (co A2 (co B2 C S) S) (co B2 (co A2 C S) S)) $;

--| Distributive law for the scalar product of a complex vector space. (Contributed by NM, 4-Dec-2007.) (New usage is discouraged.)
theorem nvdi (A2 B2 C S U G X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wi (wa (wcel U cnv) (w3a (wcel A2 cc) (wcel B2 X) (wcel C X))) (wceq (co A2 (co B2 C G) S) (co (co A2 B2 S) (co A2 C S) G)) $;

--| Distributive law for the scalar product of a complex vector space. (Contributed by NM, 4-Dec-2007.) (New usage is discouraged.)
theorem nvdir (A2 B2 C S U G X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wi (wa (wcel U cnv) (w3a (wcel A2 cc) (wcel B2 cc) (wcel C X))) (wceq (co (co A2 B2 caddc) C S) (co (co A2 C S) (co B2 C S) G)) $;

--| A vector plus itself is two times the vector. (Contributed by NM, 9-Feb-2008.) (New usage is discouraged.)
theorem nv2 (A2 S U G X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wi (wa (wcel U cnv) (wcel A2 X)) (wceq (co A2 A2 G) (co c2 A2 S)) $;

--| Value of the function for the vector subtraction operation on a normed complex vector space. (Contributed by NM, 15-Feb-2008.) (Revised by Mario Carneiro, 27-Dec-2014.) (New usage is discouraged.)
theorem vsfval (U G M: class):
  $ wceq G (cfv U cpv) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wceq M (cfv G cgs) $;

--| Closure law for the zero vector of a normed complex vector space. (Contributed by NM, 27-Nov-2007.) (Revised by Mario Carneiro, 21-Dec-2013.) (New usage is discouraged.)
theorem nvzcl (U X Z: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Z (cfv U cn0v) $ >
  $ wi (wcel U cnv) (wcel Z X) $;

--| The zero vector is a right identity element. (Contributed by NM, 28-Nov-2007.) (Revised by Mario Carneiro, 21-Dec-2013.) (New usage is discouraged.)
theorem nv0rid (A2 U G X Z: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq Z (cfv U cn0v) $ >
  $ wi (wa (wcel U cnv) (wcel A2 X)) (wceq (co A2 Z G) A2) $;

--| The zero vector is a left identity element. (Contributed by NM, 28-Nov-2007.) (Revised by Mario Carneiro, 21-Dec-2013.) (New usage is discouraged.)
theorem nv0lid (A2 U G X Z: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq Z (cfv U cn0v) $ >
  $ wi (wa (wcel U cnv) (wcel A2 X)) (wceq (co Z A2 G) A2) $;

--| Zero times a vector is the zero vector. (Contributed by NM, 27-Nov-2007.) (Revised by Mario Carneiro, 21-Dec-2013.) (New usage is discouraged.)
theorem nv0 (A2 S U X Z: class):
  $ wceq X (cfv U cba) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq Z (cfv U cn0v) $ >
  $ wi (wa (wcel U cnv) (wcel A2 X)) (wceq (co cc0 A2 S) Z) $;

--| Anything times the zero vector is the zero vector. (Contributed by NM, 28-Nov-2007.) (Revised by Mario Carneiro, 21-Dec-2013.) (New usage is discouraged.)
theorem nvsz (A2 S U Z: class):
  $ wceq S (cfv U cns) $ >
  $ wceq Z (cfv U cn0v) $ >
  $ wi (wa (wcel U cnv) (wcel A2 cc)) (wceq (co A2 Z S) Z) $;

--| Minus 1 times a vector is the underlying group's inverse element. Equation 2 of [Kreyszig] p. 51. (Contributed by NM, 15-Feb-2008.) (New usage is discouraged.)
theorem nvinv (A2 S U G M X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq M (cfv G cgn) $ >
  $ wi (wa (wcel U cnv) (wcel A2 X)) (wceq (co (cneg c1) A2 S) (cfv A2 M)) $;

--| Function for the negative of a vector on a normed complex vector space, in terms of the underlying addition group inverse. (We currently do not have a separate notation for the negative of a vector.) (Contributed by NM, 27-Mar-2008.) (New usage is discouraged.)
theorem nvinvfval (S U G N: class):
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq N (ccom S (ccnv (cres c2nd (cxp (csn (cneg c1)) cvv)))) $ >
  $ wi (wcel U cnv) (wceq N (cfv G cgn)) $;

--| Vector subtraction in terms of group division operation. (Contributed by NM, 15-Feb-2008.) (New usage is discouraged.)
theorem nvm (A2 B2 U G M N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wceq N (cfv G cgs) $ >
  $ wi (w3a (wcel U cnv) (wcel A2 X) (wcel B2 X)) (wceq (co A2 B2 M) (co A2 B2 N)) $;

--| Value of vector subtraction on a normed complex vector space. (Contributed by NM, 11-Sep-2007.) (New usage is discouraged.)
theorem nvmval (A2 B2 S U G M X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wi (w3a (wcel U cnv) (wcel A2 X) (wcel B2 X)) (wceq (co A2 B2 M) (co A2 (co (cneg c1) B2 S) G)) $;

--| Value of vector subtraction on a normed complex vector space. (Contributed by Mario Carneiro, 19-Nov-2013.) (New usage is discouraged.)
theorem nvmval2 (A2 B2 S U G M X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wi (w3a (wcel U cnv) (wcel A2 X) (wcel B2 X)) (wceq (co A2 B2 M) (co (co (cneg c1) B2 S) A2 G)) $;

--| Value of the function for the vector subtraction operation on a normed complex vector space. (Contributed by NM, 11-Sep-2007.) (Revised by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem nvmfval {x3 y1: setvar} (S: class x3 y1) (U G: class) (M: class x3 y1) (X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wi (wcel U cnv) (wceq M (cmpo x3 y1 X X (co (cv x3) (co (cneg c1) (cv y1) S) G))) $;

--| Mapping for the vector subtraction operation. (Contributed by NM, 11-Sep-2007.) (Revised by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem nvmf (U M X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wi (wcel U cnv) (wf (cxp X X) X M) $;

--| Closure law for the vector subtraction operation of a normed complex vector space. (Contributed by NM, 11-Sep-2007.) (New usage is discouraged.)
theorem nvmcl (A2 B2 U M X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wi (w3a (wcel U cnv) (wcel A2 X) (wcel B2 X)) (wcel (co A2 B2 M) X) $;

--| Cancellation law for vector subtraction. ( ~ nnncan1 analog.) (Contributed by NM, 7-Mar-2008.) (New usage is discouraged.)
theorem nvnnncan1 (A2 B2 C U M X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wi (wa (wcel U cnv) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wceq (co (co A2 B2 M) (co A2 C M) M) (co C B2 M)) $;

--| Distributive law for scalar product over subtraction. (Contributed by NM, 14-Feb-2008.) (New usage is discouraged.)
theorem nvmdi (A2 B2 C S U M X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wceq S (cfv U cns) $ >
  $ wi (wa (wcel U cnv) (w3a (wcel A2 cc) (wcel B2 X) (wcel C X))) (wceq (co A2 (co B2 C M) S) (co (co A2 B2 S) (co A2 C S) M)) $;

--| Double negative of a vector. (Contributed by NM, 4-Dec-2007.) (New usage is discouraged.)
theorem nvnegneg (A2 S U X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq S (cfv U cns) $ >
  $ wi (wa (wcel U cnv) (wcel A2 X)) (wceq (co (cneg c1) (co (cneg c1) A2 S) S) A2) $;

--| If a scalar product is zero, one of its factors must be zero. (Contributed by NM, 6-Dec-2007.) (New usage is discouraged.)
theorem nvmul0or (A2 B2 S U X Z: class):
  $ wceq X (cfv U cba) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq Z (cfv U cn0v) $ >
  $ wi (w3a (wcel U cnv) (wcel A2 cc) (wcel B2 X)) (wb (wceq (co A2 B2 S) Z) (wo (wceq A2 cc0) (wceq B2 Z))) $;

--| A vector minus itself. (Contributed by NM, 4-Dec-2007.) (Revised by Mario Carneiro, 21-Dec-2013.) (New usage is discouraged.)
theorem nvrinv (A2 S U G X Z: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq Z (cfv U cn0v) $ >
  $ wi (wa (wcel U cnv) (wcel A2 X)) (wceq (co A2 (co (cneg c1) A2 S) G) Z) $;

--| Minus a vector plus itself. (Contributed by NM, 4-Dec-2007.) (Revised by Mario Carneiro, 21-Dec-2013.) (New usage is discouraged.)
theorem nvlinv (A2 S U G X Z: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq Z (cfv U cn0v) $ >
  $ wi (wa (wcel U cnv) (wcel A2 X)) (wceq (co (co (cneg c1) A2 S) A2 G) Z) $;

--| Cancellation law for vector subtraction. (Contributed by NM, 27-Dec-2007.) (New usage is discouraged.)
theorem nvpncan2 (A2 B2 U G M X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wi (w3a (wcel U cnv) (wcel A2 X) (wcel B2 X)) (wceq (co (co A2 B2 G) A2 M) B2) $;

--| Cancellation law for vector subtraction. (Contributed by NM, 24-Jan-2008.) (New usage is discouraged.)
theorem nvpncan (A2 B2 U G M X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wi (w3a (wcel U cnv) (wcel A2 X) (wcel B2 X)) (wceq (co (co A2 B2 G) B2 M) A2) $;

--| Commutative/associative law for vector addition and subtraction. (Contributed by NM, 24-Jan-2008.) (New usage is discouraged.)
theorem nvaddsub (A2 B2 C U G M X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wi (wa (wcel U cnv) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wceq (co (co A2 B2 G) C M) (co (co A2 C M) B2 G)) $;

--| Cancellation law for a normed complex vector space. (Contributed by NM, 24-Jan-2008.) (New usage is discouraged.)
theorem nvnpcan (A2 B2 U G M X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wi (w3a (wcel U cnv) (wcel A2 X) (wcel B2 X)) (wceq (co (co A2 B2 M) B2 G) A2) $;

--| Rearrangement of 4 terms in a mixed vector addition and subtraction. (Contributed by NM, 8-Feb-2008.) (New usage is discouraged.)
theorem nvaddsub4 (A2 B2 C D U G M X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wi (w3a (wcel U cnv) (wa (wcel A2 X) (wcel B2 X)) (wa (wcel C X) (wcel D X))) (wceq (co (co A2 B2 G) (co C D G) M) (co (co A2 C M) (co B2 D M) G)) $;

--| The difference between two vectors is zero iff they are equal. (Contributed by NM, 24-Jan-2008.) (New usage is discouraged.)
theorem nvmeq0 (A2 B2 U M X Z: class):
  $ wceq X (cfv U cba) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wceq Z (cfv U cn0v) $ >
  $ wi (w3a (wcel U cnv) (wcel A2 X) (wcel B2 X)) (wb (wceq (co A2 B2 M) Z) (wceq A2 B2)) $;

--| A vector minus itself is the zero vector. (Contributed by NM, 28-Jan-2008.) (New usage is discouraged.)
theorem nvmid (A2 U M X Z: class):
  $ wceq X (cfv U cba) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wceq Z (cfv U cn0v) $ >
  $ wi (wa (wcel U cnv) (wcel A2 X)) (wceq (co A2 A2 M) Z) $;

--| Mapping for the norm function. (Contributed by NM, 11-Nov-2006.) (New usage is discouraged.)
theorem nvf (U N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wi (wcel U cnv) (wf X cr N) $;

--| The norm of a normed complex vector space is a real number. (Contributed by NM, 24-Nov-2006.) (New usage is discouraged.)
theorem nvcl (A2 U N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wi (wa (wcel U cnv) (wcel A2 X)) (wcel (cfv A2 N) cr) $;

--| The norm of a normed complex vector space is a real number. (Contributed by NM, 20-Apr-2007.) (New usage is discouraged.)
theorem nvcli (A2 U N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wcel U cnv $ >
  $ wcel A2 X $ >
  $ wcel (cfv A2 N) cr $;

--| Proportionality property of the norm of a scalar product in a normed complex vector space. (Contributed by NM, 11-Nov-2006.) (New usage is discouraged.)
theorem nvs (A2 B2 S U N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wi (w3a (wcel U cnv) (wcel A2 cc) (wcel B2 X)) (wceq (cfv (co A2 B2 S) N) (co (cfv A2 cabs) (cfv B2 N) cmul)) $;

--| The norm of a scalar product with a nonnegative real. (Contributed by NM, 1-Jan-2008.) (New usage is discouraged.)
theorem nvsge0 (A2 B2 S U N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wi (w3a (wcel U cnv) (wa (wcel A2 cr) (wbr cc0 A2 cle)) (wcel B2 X)) (wceq (cfv (co A2 B2 S) N) (co A2 (cfv B2 N) cmul)) $;

--| The norm of the negative of a vector. (Contributed by NM, 28-Nov-2006.) (New usage is discouraged.)
theorem nvm1 (A2 S U N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wi (wa (wcel U cnv) (wcel A2 X)) (wceq (cfv (co (cneg c1) A2 S) N) (cfv A2 N)) $;

--| The norm of the difference between two vectors. (Contributed by NM, 1-Dec-2006.) (New usage is discouraged.)
theorem nvdif (A2 B2 S U G N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wi (w3a (wcel U cnv) (wcel A2 X) (wcel B2 X)) (wceq (cfv (co A2 (co (cneg c1) B2 S) G) N) (cfv (co B2 (co (cneg c1) A2 S) G) N)) $;

--| The norm of a vector plus the imaginary scalar product of another. (Contributed by NM, 2-Feb-2007.) (New usage is discouraged.)
theorem nvpi (A2 B2 S U G N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wi (w3a (wcel U cnv) (wcel A2 X) (wcel B2 X)) (wceq (cfv (co A2 (co ci B2 S) G) N) (cfv (co B2 (co (cneg ci) A2 S) G) N)) $;

--| The norm of a zero vector is zero. (Contributed by NM, 24-Nov-2006.) (New usage is discouraged.)
theorem nvz0 (U N Z: class):
  $ wceq Z (cfv U cn0v) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wi (wcel U cnv) (wceq (cfv Z N) cc0) $;

--| The norm of a vector is zero iff the vector is zero. First part of Problem 2 of [Kreyszig] p. 64. (Contributed by NM, 24-Nov-2006.) (New usage is discouraged.)
theorem nvz (A2 U N X Z: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Z (cfv U cn0v) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wi (wa (wcel U cnv) (wcel A2 X)) (wb (wceq (cfv A2 N) cc0) (wceq A2 Z)) $;

--| Triangle inequality for the norm of a normed complex vector space. (Contributed by NM, 11-Nov-2006.) (Revised by Mario Carneiro, 21-Dec-2013.) (New usage is discouraged.)
theorem nvtri (A2 B2 U G N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wi (w3a (wcel U cnv) (wcel A2 X) (wcel B2 X)) (wbr (cfv (co A2 B2 G) N) (co (cfv A2 N) (cfv B2 N) caddc) cle) $;

--| Triangle inequality for the norm of a vector difference. (Contributed by NM, 27-Dec-2007.) (New usage is discouraged.)
theorem nvmtri (A2 B2 U M N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wi (w3a (wcel U cnv) (wcel A2 X) (wcel B2 X)) (wbr (cfv (co A2 B2 M) N) (co (cfv A2 N) (cfv B2 N) caddc) cle) $;

--| Norm difference property of a normed complex vector space. Problem 3 of [Kreyszig] p. 64. (Contributed by NM, 4-Dec-2006.) (New usage is discouraged.)
theorem nvabs (A2 B2 S U G N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wi (w3a (wcel U cnv) (wcel A2 X) (wcel B2 X)) (wbr (cfv (co (cfv A2 N) (cfv B2 N) cmin) cabs) (cfv (co A2 (co (cneg c1) B2 S) G) N) cle) $;

--| The norm of a normed complex vector space is nonnegative. Second part of Problem 2 of [Kreyszig] p. 64. (Contributed by NM, 28-Nov-2006.) (Proof shortened by AV, 10-Jul-2022.) (New usage is discouraged.)
theorem nvge0 (A2 U N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wi (wa (wcel U cnv) (wcel A2 X)) (wbr cc0 (cfv A2 N) cle) $;

--| A nonzero norm is positive. (Contributed by NM, 20-Nov-2007.) (New usage is discouraged.)
theorem nvgt0 (A2 U N X Z: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Z (cfv U cn0v) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wi (wa (wcel U cnv) (wcel A2 X)) (wb (wne A2 Z) (wbr cc0 (cfv A2 N) clt)) $;

--| From any nonzero vector, construct a vector whose norm is one. (Contributed by NM, 6-Dec-2007.) (New usage is discouraged.)
theorem nv1 (A2 S U N X Z: class):
  $ wceq X (cfv U cba) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq Z (cfv U cn0v) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wi (w3a (wcel U cnv) (wcel A2 X) (wne A2 Z)) (wceq (cfv (co (co c1 (cfv A2 N) cdiv) A2 S) N) c1) $;

--| A complex inner product space in terms of ordered pair components. (Contributed by NM, 11-Sep-2007.) (New usage is discouraged.)
theorem nvop (S U G N: class):
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wi (wcel U cnv) (wceq U (cop (cop G S) N)) $;

--| The set of complex numbers is a normed complex vector space. The vector operation is ` + ` , the scalar product is ` x. ` , and the norm function is ` abs ` . (Contributed by Steve Rodriguez, 3-Dec-2006.) (New usage is discouraged.)
theorem cnnv (U: class):
  $ wceq U (cop (cop caddc cmul) cabs) $ >
  $ wcel U cnv $;

--| The vector addition (group) operation of the normed complex vector space of complex numbers. (Contributed by NM, 12-Jan-2008.) (New usage is discouraged.)
theorem cnnvg (U: class):
  $ wceq U (cop (cop caddc cmul) cabs) $ >
  $ wceq caddc (cfv U cpv) $;

--| The base set of the normed complex vector space of complex numbers. (Contributed by NM, 7-Nov-2007.) (New usage is discouraged.)
theorem cnnvba (U: class):
  $ wceq U (cop (cop caddc cmul) cabs) $ >
  $ wceq cc (cfv U cba) $;

--| The scalar product operation of the normed complex vector space of complex numbers. (Contributed by NM, 12-Jan-2008.) (New usage is discouraged.)
theorem cnnvs (U: class):
  $ wceq U (cop (cop caddc cmul) cabs) $ >
  $ wceq cmul (cfv U cns) $;

--| The norm operation of the normed complex vector space of complex numbers. (Contributed by NM, 12-Jan-2008.) (New usage is discouraged.)
theorem cnnvnm (U: class):
  $ wceq U (cop (cop caddc cmul) cabs) $ >
  $ wceq cabs (cfv U cnmcv) $;

--| The vector subtraction operation of the normed complex vector space of complex numbers. (Contributed by NM, 12-Jan-2008.) (Revised by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem cnnvm (U: class):
  $ wceq U (cop (cop caddc cmul) cabs) $ >
  $ wceq cmin (cfv U cnsb) $;

--| Hypothesis elimination lemma for normed complex vector spaces to assist weak deduction theorem. (Contributed by NM, 16-May-2007.) (New usage is discouraged.)
theorem elimnv (A2 U X Z: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Z (cfv U cn0v) $ >
  $ wcel U cnv $ >
  $ wcel (cif (wcel A2 X) A2 Z) X $;

--| Hypothesis elimination lemma for normed complex vector spaces to assist weak deduction theorem. (Contributed by NM, 16-May-2007.) (New usage is discouraged.)
theorem elimnvu (U: class):
  $ wcel (cif (wcel U cnv) U (cop (cop caddc cmul) cabs)) cnv $;

--| Value of the induced metric of a normed complex vector space. (Contributed by NM, 11-Sep-2007.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem imsval (D U M N: class):
  $ wceq M (cfv U cnsb) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq D (cfv U cims) $ >
  $ wi (wcel U cnv) (wceq D (ccom N M)) $;

--| Value of the induced metric (distance function) of a normed complex vector space. Equation 1 of [Kreyszig] p. 59. (Contributed by NM, 11-Sep-2007.) (Revised by Mario Carneiro, 27-Dec-2014.) (New usage is discouraged.)
theorem imsdval (A2 B2 D U M N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq D (cfv U cims) $ >
  $ wi (w3a (wcel U cnv) (wcel A2 X) (wcel B2 X)) (wceq (co A2 B2 D) (cfv (co A2 B2 M) N)) $;

--| Value of the distance function of the induced metric of a normed complex vector space. Equation 1 of [Kreyszig] p. 59. (Contributed by NM, 28-Nov-2006.) (New usage is discouraged.)
theorem imsdval2 (A2 B2 D S U G N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq D (cfv U cims) $ >
  $ wi (w3a (wcel U cnv) (wcel A2 X) (wcel B2 X)) (wceq (co A2 B2 D) (cfv (co A2 (co (cneg c1) B2 S) G) N)) $;

--| The norm of a normed complex vector space expressed in terms of the distance function of its induced metric. Problem 1 of [Kreyszig] p. 63. (Contributed by NM, 4-Dec-2006.) (New usage is discouraged.)
theorem nvnd (A2 D U N X Z: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Z (cfv U cn0v) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq D (cfv U cims) $ >
  $ wi (wa (wcel U cnv) (wcel A2 X)) (wceq (cfv A2 N) (co A2 Z D)) $;

--| Mapping for the induced metric distance function of a normed complex vector space. (Contributed by NM, 29-Nov-2006.) (New usage is discouraged.)
theorem imsdf (D U X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq D (cfv U cims) $ >
  $ wi (wcel U cnv) (wf (cxp X X) cr D) $;

--| Lemma for ~ imsmet . (Contributed by NM, 29-Nov-2006.) (New usage is discouraged.)
theorem imsmetlem (D S U G M N X Z: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq M (cfv G cgn) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq Z (cfv U cn0v) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq D (cfv U cims) $ >
  $ wcel U cnv $ >
  $ wcel D (cfv X cmet) $;

--| The induced metric of a normed complex vector space is a metric space. Part of Definition 2.2-1 of [Kreyszig] p. 58. (Contributed by NM, 4-Dec-2006.) (Revised by Mario Carneiro, 10-Sep-2015.) (New usage is discouraged.)
theorem imsmet (D U X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq D (cfv U cims) $ >
  $ wi (wcel U cnv) (wcel D (cfv X cmet)) $;

--| The induced metric of a normed complex vector space is an extended metric space. (Contributed by Mario Carneiro, 10-Sep-2015.) (New usage is discouraged.)
theorem imsxmet (D U X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq D (cfv U cims) $ >
  $ wi (wcel U cnv) (wcel D (cfv X cxmet)) $;

--| The metric induced on the complex numbers. ~ cnmet proves that it is a metric. (Contributed by Steve Rodriguez, 5-Dec-2006.) (Revised by NM, 15-Jan-2008.) (New usage is discouraged.)
theorem cnims (D U: class):
  $ wceq U (cop (cop caddc cmul) cabs) $ >
  $ wceq D (ccom cabs cmin) $ >
  $ wceq D (cfv U cims) $;

--| Vector addition is jointly continuous in both arguments. (Contributed by Jeff Hankins, 16-Jun-2009.) (Revised by Mario Carneiro, 10-Sep-2015.) (New usage is discouraged.)
theorem vacn (C U G J: class):
  $ wceq C (cfv U cims) $ >
  $ wceq J (cfv C cmopn) $ >
  $ wceq G (cfv U cpv) $ >
  $ wi (wcel U cnv) (wcel G (co (co J J ctx) J ccn)) $;

--| The norm of a normed complex vector space is a continuous function. (Contributed by NM, 16-May-2007.) (Proof shortened by Mario Carneiro, 10-Jan-2014.) (New usage is discouraged.)
theorem nmcvcn (C U J K N: class):
  $ wceq N (cfv U cnmcv) $ >
  $ wceq C (cfv U cims) $ >
  $ wceq J (cfv C cmopn) $ >
  $ wceq K (cfv (crn cioo) ctg) $ >
  $ wi (wcel U cnv) (wcel N (co J K ccn)) $;

--| The norm of a normed complex vector space is a continuous function to ` CC ` . (For ` RR ` , see ~ nmcvcn .) (Contributed by NM, 12-Aug-2007.) (New usage is discouraged.)
theorem nmcnc (C U J K N: class):
  $ wceq N (cfv U cnmcv) $ >
  $ wceq C (cfv U cims) $ >
  $ wceq J (cfv C cmopn) $ >
  $ wceq K (cfv ccnfld ctopn) $ >
  $ wi (wcel U cnv) (wcel N (co J K ccn)) $;

--| Lemma for ~ smcn . (Contributed by Mario Carneiro, 5-May-2014.) (Revised by Mario Carneiro, 10-Sep-2015.) (New usage is discouraged.)
theorem smcnlem {x3 y1 r: setvar} (C S: class) (T: class x3 y1 r) (U J K: class) (N: class x3 y1 r) (X: class):
  $ wceq C (cfv U cims) $ >
  $ wceq J (cfv C cmopn) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq K (cfv ccnfld ctopn) $ >
  $ wceq X (cfv U cba) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wcel U cnv $ >
  $ wceq T (co c1 (co c1 (co (co (co (cfv (cv y1) N) (cfv (cv x3) cabs) caddc) c1 caddc) (cv r) cdiv) caddc) cdiv) $ >
  $ wcel S (co (co K J ctx) J ccn) $;

--| Scalar multiplication is jointly continuous in both arguments. (Contributed by NM, 16-Jun-2009.) (Revised by Mario Carneiro, 5-May-2014.) (New usage is discouraged.)
theorem smcn (C S U J K: class):
  $ wceq C (cfv U cims) $ >
  $ wceq J (cfv C cmopn) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq K (cfv ccnfld ctopn) $ >
  $ wi (wcel U cnv) (wcel S (co (co K J ctx) J ccn)) $;

--| Vector subtraction is jointly continuous in both arguments. (Contributed by Mario Carneiro, 6-May-2014.) (New usage is discouraged.)
theorem vmcn (C U J M: class):
  $ wceq C (cfv U cims) $ >
  $ wceq J (cfv C cmopn) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wi (wcel U cnv) (wcel M (co (co J J ctx) J ccn)) $;

--| Extend class notation with the class inner product functions.
term cdip: class;

--| Define a function that maps a normed complex vector space to its inner product operation in case its norm satisfies the parallelogram identity (otherwise the operation is still defined, but not meaningful). Based on Exercise 4(a) of [ReedSimon] p. 63 and Theorem 6.44 of [Ponnusamy] p. 361. Vector addition is ` ( 1st `` w ) ` , the scalar product is ` ( 2nd `` w ) ` , and the norm is ` n ` . (Contributed by NM, 10-Apr-2007.) (New usage is discouraged.)
axiom df_dip {x3 y1 u k: setvar}:
  $ wceq cdip (cmpt u cnv (cmpo x3 y1 (cfv (cv u) cba) (cfv (cv u) cba) (co (csu k (co c1 c4 cfz) (co (co ci (cv k) cexp) (co (cfv (co (cv x3) (co (co ci (cv k) cexp) (cv y1) (cfv (cv u) cns)) (cfv (cv u) cpv)) (cfv (cv u) cnmcv)) c2 cexp) cmul)) c4 cdiv))) $;

--| The inner product function on a normed complex vector space. The definition is meaningful for vector spaces that are also inner product spaces, i.e. satisfy the parallelogram law. (Contributed by NM, 10-Apr-2007.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem dipfval {x3 y1 k: setvar} (P: class x3 y1 k) (S U G N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq P (cfv U cdip) $ >
  $ wi (wcel U cnv) (wceq P (cmpo x3 y1 X X (co (csu k (co c1 c4 cfz) (co (co ci (cv k) cexp) (co (cfv (co (cv x3) (co (co ci (cv k) cexp) (cv y1) S) G) N) c2 cexp) cmul)) c4 cdiv))) $;

--| Value of the inner product. The definition is meaningful for normed complex vector spaces that are also inner product spaces, i.e. satisfy the parallelogram law, although for convenience we define it for any normed complex vector space. The vector (group) addition operation is ` G ` , the scalar product is ` S ` , the norm is ` N ` , and the set of vectors is ` X ` . Equation 6.45 of [Ponnusamy] p. 361. (Contributed by NM, 31-Jan-2007.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem ipval {k: setvar} (A2 B2: class) (P: class k) (S U G N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq P (cfv U cdip) $ >
  $ wi (w3a (wcel U cnv) (wcel A2 X) (wcel B2 X)) (wceq (co A2 B2 P) (co (csu k (co c1 c4 cfz) (co (co ci (cv k) cexp) (co (cfv (co A2 (co (co ci (cv k) cexp) B2 S) G) N) c2 cexp) cmul)) c4 cdiv)) $;

--| Lemma for ~ ipval3 . (Contributed by NM, 1-Feb-2007.) (New usage is discouraged.)
theorem ipval2lem2 (A2 B2 C P S U G N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq P (cfv U cdip) $ >
  $ wi (wa (w3a (wcel U cnv) (wcel A2 X) (wcel B2 X)) (wcel C cc)) (wcel (co (cfv (co A2 (co C B2 S) G) N) c2 cexp) cr) $;

--| Lemma for ~ ipval3 . (Contributed by NM, 1-Feb-2007.) (New usage is discouraged.)
theorem ipval2lem3 (A2 B2 P S U G N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq P (cfv U cdip) $ >
  $ wi (w3a (wcel U cnv) (wcel A2 X) (wcel B2 X)) (wcel (co (cfv (co A2 B2 G) N) c2 cexp) cr) $;

--| Lemma for ~ ipval3 . (Contributed by NM, 1-Feb-2007.) (New usage is discouraged.)
theorem ipval2lem4 (A2 B2 C P S U G N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq P (cfv U cdip) $ >
  $ wi (wa (w3a (wcel U cnv) (wcel A2 X) (wcel B2 X)) (wcel C cc)) (wcel (co (cfv (co A2 (co C B2 S) G) N) c2 cexp) cc) $;

--| Expansion of the inner product value ~ ipval . (Contributed by NM, 31-Jan-2007.) (Revised by Mario Carneiro, 5-May-2014.) (New usage is discouraged.)
theorem ipval2 (A2 B2 P S U G N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq P (cfv U cdip) $ >
  $ wi (w3a (wcel U cnv) (wcel A2 X) (wcel B2 X)) (wceq (co A2 B2 P) (co (co (co (co (cfv (co A2 B2 G) N) c2 cexp) (co (cfv (co A2 (co (cneg c1) B2 S) G) N) c2 cexp) cmin) (co ci (co (co (cfv (co A2 (co ci B2 S) G) N) c2 cexp) (co (cfv (co A2 (co (cneg ci) B2 S) G) N) c2 cexp) cmin) cmul) caddc) c4 cdiv)) $;

--| Four times the inner product value ~ ipval3 , useful for simplifying certain proofs. (Contributed by NM, 10-Apr-2007.) (New usage is discouraged.)
theorem _4ipval2 (A2 B2 P S U G N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq P (cfv U cdip) $ >
  $ wi (w3a (wcel U cnv) (wcel A2 X) (wcel B2 X)) (wceq (co c4 (co A2 B2 P) cmul) (co (co (co (cfv (co A2 B2 G) N) c2 cexp) (co (cfv (co A2 (co (cneg c1) B2 S) G) N) c2 cexp) cmin) (co ci (co (co (cfv (co A2 (co ci B2 S) G) N) c2 cexp) (co (cfv (co A2 (co (cneg ci) B2 S) G) N) c2 cexp) cmin) cmul) caddc)) $;

--| Expansion of the inner product value ~ ipval . (Contributed by NM, 17-Nov-2007.) (New usage is discouraged.)
theorem ipval3 (A2 B2 P S U G M N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq P (cfv U cdip) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wi (w3a (wcel U cnv) (wcel A2 X) (wcel B2 X)) (wceq (co A2 B2 P) (co (co (co (co (cfv (co A2 B2 G) N) c2 cexp) (co (cfv (co A2 B2 M) N) c2 cexp) cmin) (co ci (co (co (cfv (co A2 (co ci B2 S) G) N) c2 cexp) (co (cfv (co A2 (co ci B2 S) M) N) c2 cexp) cmin) cmul) caddc) c4 cdiv)) $;

--| The inner product of a vector with itself is the square of the vector's norm. Equation I4 of [Ponnusamy] p. 362. (Contributed by NM, 1-Feb-2007.) (New usage is discouraged.)
theorem ipidsq (A2 P U N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq P (cfv U cdip) $ >
  $ wi (wa (wcel U cnv) (wcel A2 X)) (wceq (co A2 A2 P) (co (cfv A2 N) c2 cexp)) $;

--| Norm expressed in terms of inner product. (Contributed by NM, 11-Sep-2007.) (New usage is discouraged.)
theorem ipnm (A2 P U N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq P (cfv U cdip) $ >
  $ wi (wa (wcel U cnv) (wcel A2 X)) (wceq (cfv A2 N) (cfv (co A2 A2 P) csqrt)) $;

--| An inner product is a complex number. (Contributed by NM, 1-Feb-2007.) (Revised by Mario Carneiro, 5-May-2014.) (New usage is discouraged.)
theorem dipcl (A2 B2 P U X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq P (cfv U cdip) $ >
  $ wi (w3a (wcel U cnv) (wcel A2 X) (wcel B2 X)) (wcel (co A2 B2 P) cc) $;

--| Mapping for the inner product operation. (Contributed by NM, 28-Jan-2008.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem ipf (P U X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq P (cfv U cdip) $ >
  $ wi (wcel U cnv) (wf (cxp X X) cc P) $;

--| The complex conjugate of an inner product reverses its arguments. Equation I1 of [Ponnusamy] p. 362. (Contributed by NM, 1-Feb-2007.) (New usage is discouraged.)
theorem dipcj (A2 B2 P U X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq P (cfv U cdip) $ >
  $ wi (w3a (wcel U cnv) (wcel A2 X) (wcel B2 X)) (wceq (cfv (co A2 B2 P) ccj) (co B2 A2 P)) $;

--| An inner product times its conjugate. (Contributed by NM, 23-Nov-2007.) (New usage is discouraged.)
theorem ipipcj (A2 B2 P U X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq P (cfv U cdip) $ >
  $ wi (w3a (wcel U cnv) (wcel A2 X) (wcel B2 X)) (wceq (co (co A2 B2 P) (co B2 A2 P) cmul) (co (cfv (co A2 B2 P) cabs) c2 cexp)) $;

--| Orthogonality (meaning inner product is 0) is commutative. (Contributed by NM, 17-Apr-2008.) (New usage is discouraged.)
theorem diporthcom (A2 B2 P U X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq P (cfv U cdip) $ >
  $ wi (w3a (wcel U cnv) (wcel A2 X) (wcel B2 X)) (wb (wceq (co A2 B2 P) cc0) (wceq (co B2 A2 P) cc0)) $;

--| Inner product with a zero second argument. (Contributed by NM, 5-Feb-2007.) (New usage is discouraged.)
theorem dip0r (A2 P U X Z: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Z (cfv U cn0v) $ >
  $ wceq P (cfv U cdip) $ >
  $ wi (wa (wcel U cnv) (wcel A2 X)) (wceq (co A2 Z P) cc0) $;

--| Inner product with a zero first argument. Part of proof of Theorem 6.44 of [Ponnusamy] p. 361. (Contributed by NM, 5-Feb-2007.) (New usage is discouraged.)
theorem dip0l (A2 P U X Z: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Z (cfv U cn0v) $ >
  $ wceq P (cfv U cdip) $ >
  $ wi (wa (wcel U cnv) (wcel A2 X)) (wceq (co Z A2 P) cc0) $;

--| The inner product of a vector with itself is zero iff the vector is zero. Part of Definition 3.1-1 of [Kreyszig] p. 129. (Contributed by NM, 24-Jan-2008.) (New usage is discouraged.)
theorem ipz (A2 P U X Z: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Z (cfv U cn0v) $ >
  $ wceq P (cfv U cdip) $ >
  $ wi (wa (wcel U cnv) (wcel A2 X)) (wb (wceq (co A2 A2 P) cc0) (wceq A2 Z)) $;

--| Inner product is jointly continuous in both arguments. (Contributed by NM, 21-Aug-2007.) (Revised by Mario Carneiro, 10-Sep-2015.) (New usage is discouraged.)
theorem dipcn (C P U J K: class):
  $ wceq P (cfv U cdip) $ >
  $ wceq C (cfv U cims) $ >
  $ wceq J (cfv C cmopn) $ >
  $ wceq K (cfv ccnfld ctopn) $ >
  $ wi (wcel U cnv) (wcel P (co (co J J ctx) K ccn)) $;

--| Extend class notation with the class of all subspaces of normed complex vector spaces.
term css: class;

--| Define the class of all subspaces of normed complex vector spaces. (Contributed by NM, 26-Jan-2008.) (New usage is discouraged.)
axiom df_ssp {w u: setvar}:
  $ wceq css (cmpt u cnv (crab w (w3a (wss (cfv (cv w) cpv) (cfv (cv u) cpv)) (wss (cfv (cv w) cns) (cfv (cv u) cns)) (wss (cfv (cv w) cnmcv) (cfv (cv u) cnmcv))) cnv)) $;

--| The set of all subspaces of a normed complex vector space. (Contributed by NM, 26-Jan-2008.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem sspval {w: setvar} (S U G: class) (H: class w) (N: class):
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq H (cfv U css) $ >
  $ wi (wcel U cnv) (wceq H (crab w (w3a (wss (cfv (cv w) cpv) G) (wss (cfv (cv w) cns) S) (wss (cfv (cv w) cnmcv) N)) cnv)) $;

--| The predicate "is a subspace." (Contributed by NM, 26-Jan-2008.) (New usage is discouraged.)
theorem isssp (R S U F G H M N W: class):
  $ wceq G (cfv U cpv) $ >
  $ wceq F (cfv W cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq R (cfv W cns) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq M (cfv W cnmcv) $ >
  $ wceq H (cfv U css) $ >
  $ wi (wcel U cnv) (wb (wcel W H) (wa (wcel W cnv) (w3a (wss F G) (wss R S) (wss M N)))) $;

--| A normed complex vector space is a subspace of itself. (Contributed by NM, 8-Apr-2008.) (New usage is discouraged.)
theorem sspid (U H: class):
  $ wceq H (cfv U css) $ >
  $ wi (wcel U cnv) (wcel U H) $;

--| A subspace is a normed complex vector space. (Contributed by NM, 27-Jan-2008.) (New usage is discouraged.)
theorem sspnv (U H W: class):
  $ wceq H (cfv U css) $ >
  $ wi (wa (wcel U cnv) (wcel W H)) (wcel W cnv) $;

--| The base set of a subspace is included in the parent base set. (Contributed by NM, 27-Jan-2008.) (New usage is discouraged.)
theorem sspba (U H W X Y: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Y (cfv W cba) $ >
  $ wceq H (cfv U css) $ >
  $ wi (wa (wcel U cnv) (wcel W H)) (wss Y X) $;

--| Vector addition on a subspace is a restriction of vector addition on the parent space. (Contributed by NM, 28-Jan-2008.) (New usage is discouraged.)
theorem sspg (U F G H W Y: class):
  $ wceq Y (cfv W cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq F (cfv W cpv) $ >
  $ wceq H (cfv U css) $ >
  $ wi (wa (wcel U cnv) (wcel W H)) (wceq F (cres G (cxp Y Y))) $;

--| Vector addition on a subspace in terms of vector addition on the parent space. (Contributed by NM, 28-Jan-2008.) (New usage is discouraged.)
theorem sspgval (A2 B2 U F G H W Y: class):
  $ wceq Y (cfv W cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq F (cfv W cpv) $ >
  $ wceq H (cfv U css) $ >
  $ wi (wa (wa (wcel U cnv) (wcel W H)) (wa (wcel A2 Y) (wcel B2 Y))) (wceq (co A2 B2 F) (co A2 B2 G)) $;

--| Scalar multiplication on a subspace is a restriction of scalar multiplication on the parent space. (Contributed by NM, 28-Jan-2008.) (New usage is discouraged.)
theorem ssps (R S U H W Y: class):
  $ wceq Y (cfv W cba) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq R (cfv W cns) $ >
  $ wceq H (cfv U css) $ >
  $ wi (wa (wcel U cnv) (wcel W H)) (wceq R (cres S (cxp cc Y))) $;

--| Scalar multiplication on a subspace in terms of scalar multiplication on the parent space. (Contributed by NM, 28-Jan-2008.) (New usage is discouraged.)
theorem sspsval (A2 B2 R S U H W Y: class):
  $ wceq Y (cfv W cba) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq R (cfv W cns) $ >
  $ wceq H (cfv U css) $ >
  $ wi (wa (wa (wcel U cnv) (wcel W H)) (wa (wcel A2 cc) (wcel B2 Y))) (wceq (co A2 B2 R) (co A2 B2 S)) $;

--| Lemma for ~ sspm and others. (Contributed by NM, 1-Feb-2008.) (New usage is discouraged.)
theorem sspmlem {x3 y1: setvar} (R S: class x3 y1) (U F G H W Y: class):
  $ wceq Y (cfv W cba) $ >
  $ wceq H (cfv U css) $ >
  $ wi (wa (wa (wcel U cnv) (wcel W H)) (wa (wcel (cv x3) Y) (wcel (cv y1) Y))) (wceq (co (cv x3) (cv y1) F) (co (cv x3) (cv y1) G)) $ >
  $ wi (wcel W cnv) (wf (cxp Y Y) R F) $ >
  $ wi (wcel U cnv) (wf (cxp (cfv U cba) (cfv U cba)) S G) $ >
  $ wi (wa (wcel U cnv) (wcel W H)) (wceq F (cres G (cxp Y Y))) $;

--| Vector addition on a subspace in terms of vector addition on the parent space. (Contributed by NM, 28-Jan-2008.) (New usage is discouraged.)
theorem sspmval (A2 B2 U H L M W Y: class):
  $ wceq Y (cfv W cba) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wceq L (cfv W cnsb) $ >
  $ wceq H (cfv U css) $ >
  $ wi (wa (wa (wcel U cnv) (wcel W H)) (wa (wcel A2 Y) (wcel B2 Y))) (wceq (co A2 B2 L) (co A2 B2 M)) $;

--| Vector subtraction on a subspace is a restriction of vector subtraction on the parent space. (Contributed by NM, 28-Jan-2008.) (New usage is discouraged.)
theorem sspm (U H L M W Y: class):
  $ wceq Y (cfv W cba) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wceq L (cfv W cnsb) $ >
  $ wceq H (cfv U css) $ >
  $ wi (wa (wcel U cnv) (wcel W H)) (wceq L (cres M (cxp Y Y))) $;

--| The zero vector of a subspace is the same as the parent's. (Contributed by NM, 28-Jan-2008.) (New usage is discouraged.)
theorem sspz (Q U H W Z: class):
  $ wceq Z (cfv U cn0v) $ >
  $ wceq Q (cfv W cn0v) $ >
  $ wceq H (cfv U css) $ >
  $ wi (wa (wcel U cnv) (wcel W H)) (wceq Q Z) $;

--| The norm on a subspace is a restriction of the norm on the parent space. (Contributed by NM, 28-Jan-2008.) (New usage is discouraged.)
theorem sspn (U H M N W Y: class):
  $ wceq Y (cfv W cba) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq M (cfv W cnmcv) $ >
  $ wceq H (cfv U css) $ >
  $ wi (wa (wcel U cnv) (wcel W H)) (wceq M (cres N Y)) $;

--| The norm on a subspace in terms of the norm on the parent space. (Contributed by NM, 28-Jan-2008.) (New usage is discouraged.)
theorem sspnval (A2 U H M N W Y: class):
  $ wceq Y (cfv W cba) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq M (cfv W cnmcv) $ >
  $ wceq H (cfv U css) $ >
  $ wi (w3a (wcel U cnv) (wcel W H) (wcel A2 Y)) (wceq (cfv A2 M) (cfv A2 N)) $;

--| The induced metric on a subspace in terms of the induced metric on the parent space. (Contributed by NM, 1-Feb-2008.) (New usage is discouraged.)
theorem sspimsval (A2 B2 C D U H W Y: class):
  $ wceq Y (cfv W cba) $ >
  $ wceq D (cfv U cims) $ >
  $ wceq C (cfv W cims) $ >
  $ wceq H (cfv U css) $ >
  $ wi (wa (wa (wcel U cnv) (wcel W H)) (wa (wcel A2 Y) (wcel B2 Y))) (wceq (co A2 B2 C) (co A2 B2 D)) $;

--| The induced metric on a subspace is a restriction of the induced metric on the parent space. (Contributed by NM, 1-Feb-2008.) (New usage is discouraged.)
theorem sspims (C D U H W Y: class):
  $ wceq Y (cfv W cba) $ >
  $ wceq D (cfv U cims) $ >
  $ wceq C (cfv W cims) $ >
  $ wceq H (cfv U css) $ >
  $ wi (wa (wcel U cnv) (wcel W H)) (wceq C (cres D (cxp Y Y))) $;

--| Extend class notation with the class of linear operators on normed complex vector spaces.
term clno: class;

--| Extend class notation with the class of operator norms on normed complex vector spaces.
term cnmoo: class;

--| Extend class notation with the class of bounded linear operators on normed complex vector spaces.
term cblo: class;

--| Extend class notation with the class of zero operators on normed complex vector spaces.
term c0o: class;

--| Define the class of linear operators between two normed complex vector spaces. In the literature, an operator may be a partial function, i.e., the domain of an operator is not necessarily the entire vector space. However, since the domain of a linear operator is a vector subspace, we define it with a complete function for convenience and will use subset relations to specify the partial function case. (Contributed by NM, 6-Nov-2007.) (New usage is discouraged.)
axiom df_lno {x3 y1 z w u t: setvar}:
  $ wceq clno (cmpo u w cnv cnv (crab t (wral x3 (wral y1 (wral z (wceq (cfv (co (co (cv x3) (cv y1) (cfv (cv u) cns)) (cv z) (cfv (cv u) cpv)) (cv t)) (co (co (cv x3) (cfv (cv y1) (cv t)) (cfv (cv w) cns)) (cfv (cv z) (cv t)) (cfv (cv w) cpv))) (cfv (cv u) cba)) (cfv (cv u) cba)) cc) (co (cfv (cv w) cba) (cfv (cv u) cba) cmap))) $;

--| Define the norm of an operator between two normed complex vector spaces. This definition produces an operator norm function for each pair of vector spaces ` <. u , w >. ` . Based on definition of linear operator norm in [AkhiezerGlazman] p. 39, although we define it for all operators for convenience. It isn't necessarily meaningful for nonlinear operators, since it doesn't take into account operator values at vectors with norm greater than 1. See Equation 2 of [Kreyszig] p. 92 for a definition that does (although it ignores the value at the zero vector). However, operator norms are rarely if ever used for nonlinear operators. (Contributed by NM, 6-Nov-2007.) (New usage is discouraged.)
axiom df_nmoo {x3 z w u t: setvar}:
  $ wceq cnmoo (cmpo u w cnv cnv (cmpt t (co (cfv (cv w) cba) (cfv (cv u) cba) cmap) (csup (cab x3 (wrex z (wa (wbr (cfv (cv z) (cfv (cv u) cnmcv)) c1 cle) (wceq (cv x3) (cfv (cfv (cv z) (cv t)) (cfv (cv w) cnmcv)))) (cfv (cv u) cba))) cxr clt))) $;

--| Define the class of bounded linear operators between two normed complex vector spaces. (Contributed by NM, 6-Nov-2007.) (New usage is discouraged.)
axiom df_blo {w u t: setvar}:
  $ wceq cblo (cmpo u w cnv cnv (crab t (wbr (cfv (cv t) (co (cv u) (cv w) cnmoo)) cpnf clt) (co (cv u) (cv w) clno))) $;

--| Define the zero operator between two normed complex vector spaces. (Contributed by NM, 28-Nov-2007.) (New usage is discouraged.)
axiom df_0o {w u: setvar}:
  $ wceq c0o (cmpo u w cnv cnv (cxp (cfv (cv u) cba) (csn (cfv (cv w) cn0v)))) $;

--| Adjoint of an operator.
term caj: class;

--| Set of Hermitional (self-adjoint) operators.
term chmo: class;

--| Define the adjoint of an operator (if it exists). The domain of ` U adj W ` is the set of all operators from ` U ` to ` W ` that have an adjoint. Definition 3.9-1 of [Kreyszig] p. 196, although we don't require that ` U ` and ` W ` be Hilbert spaces nor that the operators be linear. Although we define it for any normed vector space for convenience, the definition is meaningful only for inner product spaces. (Contributed by NM, 25-Jan-2008.) (New usage is discouraged.)
axiom df_aj {x3 y1 w u t s1: setvar}:
  $ wceq caj (cmpo u w cnv cnv (copab t s1 (w3a (wf (cfv (cv u) cba) (cfv (cv w) cba) (cv t)) (wf (cfv (cv w) cba) (cfv (cv u) cba) (cv s1)) (wral x3 (wral y1 (wceq (co (cfv (cv x3) (cv t)) (cv y1) (cfv (cv w) cdip)) (co (cv x3) (cfv (cv y1) (cv s1)) (cfv (cv u) cdip))) (cfv (cv w) cba)) (cfv (cv u) cba))))) $;

--| Define the set of Hermitian (self-adjoint) operators on a normed complex vector space (normally a Hilbert space). Although we define it for any normed vector space for convenience, the definition is meaningful only for inner product spaces. (Contributed by NM, 26-Jan-2008.) (New usage is discouraged.)
axiom df_hmo {u t: setvar}:
  $ wceq chmo (cmpt u cnv (crab t (wceq (cfv (cv t) (co (cv u) (cv u) caj)) (cv t)) (cdm (co (cv u) (cv u) caj)))) $;

--| The set of linear operators between two normed complex vector spaces. (Contributed by NM, 6-Nov-2007.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem lnoval {x3 y1 z t: setvar} (R S: class x3 y1 z) (U: class) (G H: class x3 y1 z) (L: class x3 y1 z t) (W: class) (X: class x3) (Y: class x3 y1 z):
  $ wceq X (cfv U cba) $ >
  $ wceq Y (cfv W cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq H (cfv W cpv) $ >
  $ wceq R (cfv U cns) $ >
  $ wceq S (cfv W cns) $ >
  $ wceq L (co U W clno) $ >
  $ wi (wa (wcel U cnv) (wcel W cnv)) (wceq L (crab t (wral x3 (wral y1 (wral z (wceq (cfv (co (co (cv x3) (cv y1) R) (cv z) G) (cv t)) (co (co (cv x3) (cfv (cv y1) (cv t)) S) (cfv (cv z) (cv t)) H)) X) X) cc) (co Y X cmap))) $;

--| The predicate "is a linear operator." (Contributed by NM, 4-Dec-2007.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem islno {x3 y1 z: setvar} (R S: class x3 y1 z) (T U: class) (G H L: class x3 y1 z) (W: class) (X: class x3) (Y: class x3 y1 z):
  $ wceq X (cfv U cba) $ >
  $ wceq Y (cfv W cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq H (cfv W cpv) $ >
  $ wceq R (cfv U cns) $ >
  $ wceq S (cfv W cns) $ >
  $ wceq L (co U W clno) $ >
  $ wi (wa (wcel U cnv) (wcel W cnv)) (wb (wcel T L) (wa (wf X Y T) (wral x3 (wral y1 (wral z (wceq (cfv (co (co (cv x3) (cv y1) R) (cv z) G) T) (co (co (cv x3) (cfv (cv y1) T) S) (cfv (cv z) T) H)) X) X) cc))) $;

--| Basic linearity property of a linear operator. (Contributed by NM, 4-Dec-2007.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem lnolin (A2 B2 C R S T U G H L W X Y: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Y (cfv W cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq H (cfv W cpv) $ >
  $ wceq R (cfv U cns) $ >
  $ wceq S (cfv W cns) $ >
  $ wceq L (co U W clno) $ >
  $ wi (wa (w3a (wcel U cnv) (wcel W cnv) (wcel T L)) (w3a (wcel A2 cc) (wcel B2 X) (wcel C X))) (wceq (cfv (co (co A2 B2 R) C G) T) (co (co A2 (cfv B2 T) S) (cfv C T) H)) $;

--| A linear operator is a mapping. (Contributed by NM, 4-Dec-2007.) (Revised by Mario Carneiro, 18-Nov-2013.) (New usage is discouraged.)
theorem lnof (T U L W X Y: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Y (cfv W cba) $ >
  $ wceq L (co U W clno) $ >
  $ wi (w3a (wcel U cnv) (wcel W cnv) (wcel T L)) (wf X Y T) $;

--| The value of a linear operator at zero is zero. (Contributed by NM, 4-Dec-2007.) (Revised by Mario Carneiro, 18-Nov-2013.) (New usage is discouraged.)
theorem lno0 (Q T U L W X Y Z: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Y (cfv W cba) $ >
  $ wceq Q (cfv U cn0v) $ >
  $ wceq Z (cfv W cn0v) $ >
  $ wceq L (co U W clno) $ >
  $ wi (w3a (wcel U cnv) (wcel W cnv) (wcel T L)) (wceq (cfv Q T) Z) $;

--| The composition of two linear operators is linear. (Contributed by NM, 12-Jan-2008.) (Revised by Mario Carneiro, 19-Nov-2013.) (New usage is discouraged.)
theorem lnocoi (S T U L M N W X: class):
  $ wceq L (co U W clno) $ >
  $ wceq M (co W X clno) $ >
  $ wceq N (co U X clno) $ >
  $ wcel U cnv $ >
  $ wcel W cnv $ >
  $ wcel X cnv $ >
  $ wcel S L $ >
  $ wcel T M $ >
  $ wcel (ccom T S) N $;

--| Addition property of a linear operator. (Contributed by NM, 7-Dec-2007.) (Revised by Mario Carneiro, 19-Nov-2013.) (New usage is discouraged.)
theorem lnoadd (A2 B2 T U G H L W X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq H (cfv W cpv) $ >
  $ wceq L (co U W clno) $ >
  $ wi (wa (w3a (wcel U cnv) (wcel W cnv) (wcel T L)) (wa (wcel A2 X) (wcel B2 X))) (wceq (cfv (co A2 B2 G) T) (co (cfv A2 T) (cfv B2 T) H)) $;

--| Subtraction property of a linear operator. (Contributed by NM, 7-Dec-2007.) (Revised by Mario Carneiro, 19-Nov-2013.) (New usage is discouraged.)
theorem lnosub (A2 B2 T U L M N W X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wceq N (cfv W cnsb) $ >
  $ wceq L (co U W clno) $ >
  $ wi (wa (w3a (wcel U cnv) (wcel W cnv) (wcel T L)) (wa (wcel A2 X) (wcel B2 X))) (wceq (cfv (co A2 B2 M) T) (co (cfv A2 T) (cfv B2 T) N)) $;

--| Scalar multiplication property of a linear operator. (Contributed by NM, 5-Dec-2007.) (Revised by Mario Carneiro, 19-Nov-2013.) (New usage is discouraged.)
theorem lnomul (A2 B2 R S T U L W X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq R (cfv U cns) $ >
  $ wceq S (cfv W cns) $ >
  $ wceq L (co U W clno) $ >
  $ wi (wa (w3a (wcel U cnv) (wcel W cnv) (wcel T L)) (wa (wcel A2 cc) (wcel B2 X))) (wceq (cfv (co A2 B2 R) T) (co A2 (cfv B2 T) S)) $;

--| Two ways to express a zero operator. (Contributed by NM, 27-Nov-2007.) (New usage is discouraged.)
theorem nvo00 (T U X Y Z: class):
  $ wceq X (cfv U cba) $ >
  $ wi (wa (wcel U cnv) (wf X Y T)) (wb (wceq T (cxp X (csn Z))) (wceq (crn T) (csn Z))) $;

--| The operator norm function. (Contributed by NM, 6-Nov-2007.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem nmoofval {x3 z t: setvar} (U: class) (L M: class x3 z) (N: class x3 z t) (W: class) (X: class x3) (Y: class z):
  $ wceq X (cfv U cba) $ >
  $ wceq Y (cfv W cba) $ >
  $ wceq L (cfv U cnmcv) $ >
  $ wceq M (cfv W cnmcv) $ >
  $ wceq N (co U W cnmoo) $ >
  $ wi (wa (wcel U cnv) (wcel W cnv)) (wceq N (cmpt t (co Y X cmap) (csup (cab x3 (wrex z (wa (wbr (cfv (cv z) L) c1 cle) (wceq (cv x3) (cfv (cfv (cv z) (cv t)) M))) X)) cxr clt))) $;

--| The operator norm function. (Contributed by NM, 27-Nov-2007.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem nmooval {x3 z: setvar} (T U: class) (L M N: class x3 z) (W: class) (X: class x3) (Y: class z):
  $ wceq X (cfv U cba) $ >
  $ wceq Y (cfv W cba) $ >
  $ wceq L (cfv U cnmcv) $ >
  $ wceq M (cfv W cnmcv) $ >
  $ wceq N (co U W cnmoo) $ >
  $ wi (w3a (wcel U cnv) (wcel W cnv) (wf X Y T)) (wceq (cfv T N) (csup (cab x3 (wrex z (wa (wbr (cfv (cv z) L) c1 cle) (wceq (cv x3) (cfv (cfv (cv z) T) M))) X)) cxr clt)) $;

--| The set in the supremum of the operator norm definition ~ df-nmoo is a set of reals. (Contributed by NM, 13-Nov-2007.) (New usage is discouraged.)
theorem nmosetre {x3 z: setvar} (T: class) (M N: class x3 z) (W X Y: class):
  $ wceq Y (cfv W cba) $ >
  $ wceq N (cfv W cnmcv) $ >
  $ wi (wa (wcel W cnv) (wf X Y T)) (wss (cab x3 (wrex z (wa (wbr (cfv (cv z) M) c1 cle) (wceq (cv x3) (cfv (cfv (cv z) T) N))) X)) cr) $;

--| The set in the supremum of the operator norm definition ~ df-nmoo is nonempty. (Contributed by NM, 8-Dec-2007.) (New usage is discouraged.)
theorem nmosetn0 {x3 y1: setvar} (T: class) (U: class x3 y1) (M N X Z: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Z (cfv U cn0v) $ >
  $ wceq M (cfv U cnmcv) $ >
  $ wi (wcel U cnv) (wcel (cfv (cfv Z T) N) (cab x3 (wrex y1 (wa (wbr (cfv (cv y1) M) c1 cle) (wceq (cv x3) (cfv (cfv (cv y1) T) N))) X))) $;

--| The norm of an operator is an extended real. (Contributed by NM, 27-Nov-2007.) (New usage is discouraged.)
theorem nmoxr (T U N W X Y: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Y (cfv W cba) $ >
  $ wceq N (co U W cnmoo) $ >
  $ wi (w3a (wcel U cnv) (wcel W cnv) (wf X Y T)) (wcel (cfv T N) cxr) $;

--| The norm of an operator is nonnegative. (Contributed by NM, 8-Dec-2007.) (New usage is discouraged.)
theorem nmooge0 (T U N W X Y: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Y (cfv W cba) $ >
  $ wceq N (co U W cnmoo) $ >
  $ wi (w3a (wcel U cnv) (wcel W cnv) (wf X Y T)) (wbr cc0 (cfv T N) cle) $;

--| The norm of an operator is either real or plus infinity. (Contributed by NM, 8-Dec-2007.) (New usage is discouraged.)
theorem nmorepnf (T U N W X Y: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Y (cfv W cba) $ >
  $ wceq N (co U W cnmoo) $ >
  $ wi (w3a (wcel U cnv) (wcel W cnv) (wf X Y T)) (wb (wcel (cfv T N) cr) (wne (cfv T N) cpnf)) $;

--| The norm of any operator is real iff it is less than plus infinity. (Contributed by NM, 8-Dec-2007.) (New usage is discouraged.)
theorem nmoreltpnf (T U N W X Y: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Y (cfv W cba) $ >
  $ wceq N (co U W cnmoo) $ >
  $ wi (w3a (wcel U cnv) (wcel W cnv) (wf X Y T)) (wb (wcel (cfv T N) cr) (wbr (cfv T N) cpnf clt)) $;

--| The norm of an operator is greater than minus infinity. (Contributed by NM, 8-Dec-2007.) (New usage is discouraged.)
theorem nmogtmnf (T U N W X Y: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Y (cfv W cba) $ >
  $ wceq N (co U W cnmoo) $ >
  $ wi (w3a (wcel U cnv) (wcel W cnv) (wf X Y T)) (wbr cmnf (cfv T N) clt) $;

--| A lower bound for an operator norm. (Contributed by NM, 8-Dec-2007.) (New usage is discouraged.)
theorem nmoolb (A2 T U L M N W X Y: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Y (cfv W cba) $ >
  $ wceq L (cfv U cnmcv) $ >
  $ wceq M (cfv W cnmcv) $ >
  $ wceq N (co U W cnmoo) $ >
  $ wi (wa (w3a (wcel U cnv) (wcel W cnv) (wf X Y T)) (wa (wcel A2 X) (wbr (cfv A2 L) c1 cle))) (wbr (cfv (cfv A2 T) M) (cfv T N) cle) $;

--| An upper bound for an operator norm. (Contributed by NM, 11-Dec-2007.) (New usage is discouraged.)
theorem nmoubi {x3: setvar} (A2 T U L M: class) (N: class x3) (W X Y: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Y (cfv W cba) $ >
  $ wceq L (cfv U cnmcv) $ >
  $ wceq M (cfv W cnmcv) $ >
  $ wceq N (co U W cnmoo) $ >
  $ wcel U cnv $ >
  $ wcel W cnv $ >
  $ wi (wa (wf X Y T) (wcel A2 cxr)) (wb (wbr (cfv T N) A2 cle) (wral x3 (wi (wbr (cfv (cv x3) L) c1 cle) (wbr (cfv (cfv (cv x3) T) M) A2 cle)) X)) $;

--| An upper bound for an operator norm. (Contributed by NM, 12-Dec-2007.) (New usage is discouraged.)
theorem nmoub3i {x3: setvar} (A2 T U L M: class) (N: class x3) (W X Y: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Y (cfv W cba) $ >
  $ wceq L (cfv U cnmcv) $ >
  $ wceq M (cfv W cnmcv) $ >
  $ wceq N (co U W cnmoo) $ >
  $ wcel U cnv $ >
  $ wcel W cnv $ >
  $ wi (w3a (wf X Y T) (wcel A2 cr) (wral x3 (wbr (cfv (cfv (cv x3) T) M) (co A2 (cfv (cv x3) L) cmul) cle) X)) (wbr (cfv T N) (cfv A2 cabs) cle) $;

--| An upper bound for an operator norm. (Contributed by NM, 11-Dec-2007.) (New usage is discouraged.)
theorem nmoub2i {x3: setvar} (A2 T U L M: class) (N: class x3) (W X Y: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Y (cfv W cba) $ >
  $ wceq L (cfv U cnmcv) $ >
  $ wceq M (cfv W cnmcv) $ >
  $ wceq N (co U W cnmoo) $ >
  $ wcel U cnv $ >
  $ wcel W cnv $ >
  $ wi (w3a (wf X Y T) (wa (wcel A2 cr) (wbr cc0 A2 cle)) (wral x3 (wbr (cfv (cfv (cv x3) T) M) (co A2 (cfv (cv x3) L) cmul) cle) X)) (wbr (cfv T N) A2 cle) $;

--| Two ways to express that an operator is bounded. (Contributed by NM, 11-Jan-2008.) (New usage is discouraged.)
theorem nmobndi {y1 r: setvar} (T: class) (U: class r) (L M N: class) (W: class r) (X Y: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Y (cfv W cba) $ >
  $ wceq L (cfv U cnmcv) $ >
  $ wceq M (cfv W cnmcv) $ >
  $ wceq N (co U W cnmoo) $ >
  $ wcel U cnv $ >
  $ wcel W cnv $ >
  $ wi (wf X Y T) (wb (wcel (cfv T N) cr) (wrex r (wral y1 (wi (wbr (cfv (cv y1) L) c1 cle) (wbr (cfv (cfv (cv y1) T) M) (cv r) cle)) X) cr)) $;

--| Two ways two express that an operator is unbounded. (Contributed by NM, 11-Jan-2008.) (New usage is discouraged.)
theorem nmounbi {y1 r: setvar} (T: class) (U: class r) (L M N: class) (W: class r) (X Y: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Y (cfv W cba) $ >
  $ wceq L (cfv U cnmcv) $ >
  $ wceq M (cfv W cnmcv) $ >
  $ wceq N (co U W cnmoo) $ >
  $ wcel U cnv $ >
  $ wcel W cnv $ >
  $ wi (wf X Y T) (wb (wceq (cfv T N) cpnf) (wral r (wrex y1 (wa (wbr (cfv (cv y1) L) c1 cle) (wbr (cv r) (cfv (cfv (cv y1) T) M) clt)) X) cr)) $;

--| An unbounded operator determines an unbounded sequence. (Contributed by NM, 11-Jan-2008.) (Revised by Mario Carneiro, 7-Apr-2013.) (New usage is discouraged.)
theorem nmounbseqi {f2 k: setvar} (T: class) (U: class f2 k) (L M: class) (N: class f2) (W: class f2 k) (X: class) (Y: class f2):
  $ wceq X (cfv U cba) $ >
  $ wceq Y (cfv W cba) $ >
  $ wceq L (cfv U cnmcv) $ >
  $ wceq M (cfv W cnmcv) $ >
  $ wceq N (co U W cnmoo) $ >
  $ wcel U cnv $ >
  $ wcel W cnv $ >
  $ wi (wa (wf X Y T) (wceq (cfv T N) cpnf)) (wex f2 (wa (wf cn X (cv f2)) (wral k (wa (wbr (cfv (cfv (cv k) (cv f2)) L) c1 cle) (wbr (cv k) (cfv (cfv (cfv (cv k) (cv f2)) T) M) clt)) cn))) $;

--| Alternate shorter proof of ~ nmounbseqi based on Axioms ~ ax-reg and ~ ax-ac2 instead of ~ ax-cc . (Contributed by NM, 11-Jan-2008.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem nmounbseqiALT {f2 k: setvar} (T: class) (U: class f2 k) (L M: class) (N: class f2) (W: class f2 k) (X: class) (Y: class f2):
  $ wceq X (cfv U cba) $ >
  $ wceq Y (cfv W cba) $ >
  $ wceq L (cfv U cnmcv) $ >
  $ wceq M (cfv W cnmcv) $ >
  $ wceq N (co U W cnmoo) $ >
  $ wcel U cnv $ >
  $ wcel W cnv $ >
  $ wi (wa (wf X Y T) (wceq (cfv T N) cpnf)) (wex f2 (wa (wf cn X (cv f2)) (wral k (wa (wbr (cfv (cfv (cv k) (cv f2)) L) c1 cle) (wbr (cv k) (cfv (cfv (cfv (cv k) (cv f2)) T) M) clt)) cn))) $;

--| A bounded sequence determines a bounded operator. (Contributed by NM, 18-Jan-2008.) (Revised by Mario Carneiro, 7-Apr-2013.) (New usage is discouraged.)
theorem nmobndseqi {f2 k: setvar} (T: class) (U: class f2 k) (L M: class) (N: class f2) (W: class f2 k) (X: class) (Y: class f2):
  $ wceq X (cfv U cba) $ >
  $ wceq Y (cfv W cba) $ >
  $ wceq L (cfv U cnmcv) $ >
  $ wceq M (cfv W cnmcv) $ >
  $ wceq N (co U W cnmoo) $ >
  $ wcel U cnv $ >
  $ wcel W cnv $ >
  $ wi (wa (wf X Y T) (wal f2 (wi (wa (wf cn X (cv f2)) (wral k (wbr (cfv (cfv (cv k) (cv f2)) L) c1 cle) cn)) (wrex k (wbr (cfv (cfv (cfv (cv k) (cv f2)) T) M) (cv k) cle) cn)))) (wcel (cfv T N) cr) $;

--| Alternate shorter proof of ~ nmobndseqi based on Axioms ~ ax-reg and ~ ax-ac2 instead of ~ ax-cc . (Contributed by NM, 18-Jan-2008.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem nmobndseqiALT {f2 k: setvar} (T: class) (U: class f2 k) (L M: class) (N: class f2) (W: class f2 k) (X: class) (Y: class f2):
  $ wceq X (cfv U cba) $ >
  $ wceq Y (cfv W cba) $ >
  $ wceq L (cfv U cnmcv) $ >
  $ wceq M (cfv W cnmcv) $ >
  $ wceq N (co U W cnmoo) $ >
  $ wcel U cnv $ >
  $ wcel W cnv $ >
  $ wi (wa (wf X Y T) (wal f2 (wi (wa (wf cn X (cv f2)) (wral k (wbr (cfv (cfv (cv k) (cv f2)) L) c1 cle) cn)) (wrex k (wbr (cfv (cfv (cfv (cv k) (cv f2)) T) M) (cv k) cle) cn)))) (wcel (cfv T N) cr) $;

--| The class of bounded linear operators between two normed complex vector spaces. (Contributed by NM, 6-Nov-2007.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem bloval {t: setvar} (B2: class t) (U L N W: class):
  $ wceq N (co U W cnmoo) $ >
  $ wceq L (co U W clno) $ >
  $ wceq B2 (co U W cblo) $ >
  $ wi (wa (wcel U cnv) (wcel W cnv)) (wceq B2 (crab t (wbr (cfv (cv t) N) cpnf clt) L)) $;

--| The predicate "is a bounded linear operator." (Contributed by NM, 6-Nov-2007.) (New usage is discouraged.)
theorem isblo (B2 T U L N W: class):
  $ wceq N (co U W cnmoo) $ >
  $ wceq L (co U W clno) $ >
  $ wceq B2 (co U W cblo) $ >
  $ wi (wa (wcel U cnv) (wcel W cnv)) (wb (wcel T B2) (wa (wcel T L) (wbr (cfv T N) cpnf clt))) $;

--| The predicate "is a bounded linear operator." (Contributed by NM, 8-Dec-2007.) (New usage is discouraged.)
theorem isblo2 (B2 T U L N W: class):
  $ wceq N (co U W cnmoo) $ >
  $ wceq L (co U W clno) $ >
  $ wceq B2 (co U W cblo) $ >
  $ wi (wa (wcel U cnv) (wcel W cnv)) (wb (wcel T B2) (wa (wcel T L) (wcel (cfv T N) cr))) $;

--| A bounded operator is a linear operator. (Contributed by NM, 8-Dec-2007.) (New usage is discouraged.)
theorem bloln (B2 T U L W: class):
  $ wceq L (co U W clno) $ >
  $ wceq B2 (co U W cblo) $ >
  $ wi (w3a (wcel U cnv) (wcel W cnv) (wcel T B2)) (wcel T L) $;

--| A bounded operator is an operator. (Contributed by NM, 8-Dec-2007.) (New usage is discouraged.)
theorem blof (B2 T U W X Y: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Y (cfv W cba) $ >
  $ wceq B2 (co U W cblo) $ >
  $ wi (w3a (wcel U cnv) (wcel W cnv) (wcel T B2)) (wf X Y T) $;

--| The norm of a bounded operator is a real number. (Contributed by NM, 8-Dec-2007.) (New usage is discouraged.)
theorem nmblore (B2 T U N W X Y: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Y (cfv W cba) $ >
  $ wceq N (co U W cnmoo) $ >
  $ wceq B2 (co U W cblo) $ >
  $ wi (w3a (wcel U cnv) (wcel W cnv) (wcel T B2)) (wcel (cfv T N) cr) $;

--| The zero operator between two normed complex vector spaces. (Contributed by NM, 28-Nov-2007.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem _0ofval (U O W X Z: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Z (cfv W cn0v) $ >
  $ wceq O (co U W c0o) $ >
  $ wi (wa (wcel U cnv) (wcel W cnv)) (wceq O (cxp X (csn Z))) $;

--| Value of the zero operator. (Contributed by NM, 28-Nov-2007.) (New usage is discouraged.)
theorem _0oval (A2 U O W X Z: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Z (cfv W cn0v) $ >
  $ wceq O (co U W c0o) $ >
  $ wi (w3a (wcel U cnv) (wcel W cnv) (wcel A2 X)) (wceq (cfv A2 O) Z) $;

--| The zero operator is an operator. (Contributed by NM, 28-Nov-2007.) (New usage is discouraged.)
theorem _0oo (U W X Y Z: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Y (cfv W cba) $ >
  $ wceq Z (co U W c0o) $ >
  $ wi (wa (wcel U cnv) (wcel W cnv)) (wf X Y Z) $;

--| The zero operator is linear. (Contributed by NM, 28-Nov-2007.) (Revised by Mario Carneiro, 19-Nov-2013.) (New usage is discouraged.)
theorem _0lno (U L W Z: class):
  $ wceq Z (co U W c0o) $ >
  $ wceq L (co U W clno) $ >
  $ wi (wa (wcel U cnv) (wcel W cnv)) (wcel Z L) $;

--| The operator norm of the zero operator. (Contributed by NM, 27-Nov-2007.) (New usage is discouraged.)
theorem nmoo0 (U N W Z: class):
  $ wceq N (co U W cnmoo) $ >
  $ wceq Z (co U W c0o) $ >
  $ wi (wa (wcel U cnv) (wcel W cnv)) (wceq (cfv Z N) cc0) $;

--| The zero operator is a bounded linear operator. (Contributed by NM, 8-Dec-2007.) (New usage is discouraged.)
theorem _0blo (B2 U W Z: class):
  $ wceq Z (co U W c0o) $ >
  $ wceq B2 (co U W cblo) $ >
  $ wi (wa (wcel U cnv) (wcel W cnv)) (wcel Z B2) $;

--| Lemma for ~ nmlno0i . (Contributed by NM, 28-Nov-2007.) (New usage is discouraged.)
theorem nmlno0lem (P Q R S T U K L M N W X Y Z: class):
  $ wceq N (co U W cnmoo) $ >
  $ wceq Z (co U W c0o) $ >
  $ wceq L (co U W clno) $ >
  $ wcel U cnv $ >
  $ wcel W cnv $ >
  $ wcel T L $ >
  $ wceq X (cfv U cba) $ >
  $ wceq Y (cfv W cba) $ >
  $ wceq R (cfv U cns) $ >
  $ wceq S (cfv W cns) $ >
  $ wceq P (cfv U cn0v) $ >
  $ wceq Q (cfv W cn0v) $ >
  $ wceq K (cfv U cnmcv) $ >
  $ wceq M (cfv W cnmcv) $ >
  $ wb (wceq (cfv T N) cc0) (wceq T Z) $;

--| The norm of a linear operator is zero iff the operator is zero. (Contributed by NM, 6-Dec-2007.) (New usage is discouraged.)
theorem nmlno0i (T U L N W Z: class):
  $ wceq N (co U W cnmoo) $ >
  $ wceq Z (co U W c0o) $ >
  $ wceq L (co U W clno) $ >
  $ wcel U cnv $ >
  $ wcel W cnv $ >
  $ wi (wcel T L) (wb (wceq (cfv T N) cc0) (wceq T Z)) $;

--| The norm of a linear operator is zero iff the operator is zero. (Contributed by NM, 24-Nov-2007.) (New usage is discouraged.)
theorem nmlno0 (T U L N W Z: class):
  $ wceq N (co U W cnmoo) $ >
  $ wceq Z (co U W c0o) $ >
  $ wceq L (co U W clno) $ >
  $ wi (w3a (wcel U cnv) (wcel W cnv) (wcel T L)) (wb (wceq (cfv T N) cc0) (wceq T Z)) $;

--| An upper bound for the operator norm of a linear operator, using only the properties of nonzero arguments. (Contributed by NM, 1-Jan-2008.) (New usage is discouraged.)
theorem nmlnoubi {x3: setvar} (A2 T U K L M: class) (N: class x3) (W X: class) (Z: class x3):
  $ wceq X (cfv U cba) $ >
  $ wceq Z (cfv U cn0v) $ >
  $ wceq K (cfv U cnmcv) $ >
  $ wceq M (cfv W cnmcv) $ >
  $ wceq N (co U W cnmoo) $ >
  $ wceq L (co U W clno) $ >
  $ wcel U cnv $ >
  $ wcel W cnv $ >
  $ wi (w3a (wcel T L) (wa (wcel A2 cr) (wbr cc0 A2 cle)) (wral x3 (wi (wne (cv x3) Z) (wbr (cfv (cfv (cv x3) T) M) (co A2 (cfv (cv x3) K) cmul) cle)) X)) (wbr (cfv T N) A2 cle) $;

--| The norm of a nonzero linear operator is positive. (Contributed by NM, 10-Dec-2007.) (New usage is discouraged.)
theorem nmlnogt0 (T U L N W Z: class):
  $ wceq N (co U W cnmoo) $ >
  $ wceq Z (co U W c0o) $ >
  $ wceq L (co U W clno) $ >
  $ wi (w3a (wcel U cnv) (wcel W cnv) (wcel T L)) (wb (wne T Z) (wbr cc0 (cfv T N) clt)) $;

--| The domain of a nonzero linear operator contains a nonzero vector. (Contributed by NM, 15-Dec-2007.) (New usage is discouraged.)
theorem lnon0 {x3: setvar} (T U L: class) (O: class x3) (W X: class) (Z: class x3):
  $ wceq X (cfv U cba) $ >
  $ wceq Z (cfv U cn0v) $ >
  $ wceq O (co U W c0o) $ >
  $ wceq L (co U W clno) $ >
  $ wi (wa (w3a (wcel U cnv) (wcel W cnv) (wcel T L)) (wne T O)) (wrex x3 (wne (cv x3) Z) X) $;

--| A lower bound for the norm of a bounded linear operator. (Contributed by NM, 7-Dec-2007.) (New usage is discouraged.)
theorem nmblolbii (A2 B2 T U L M N W X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq L (cfv U cnmcv) $ >
  $ wceq M (cfv W cnmcv) $ >
  $ wceq N (co U W cnmoo) $ >
  $ wceq B2 (co U W cblo) $ >
  $ wcel U cnv $ >
  $ wcel W cnv $ >
  $ wcel T B2 $ >
  $ wi (wcel A2 X) (wbr (cfv (cfv A2 T) M) (co (cfv T N) (cfv A2 L) cmul) cle) $;

--| A lower bound for the norm of a bounded linear operator. (Contributed by NM, 10-Dec-2007.) (New usage is discouraged.)
theorem nmblolbi (A2 B2 T U L M N W X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq L (cfv U cnmcv) $ >
  $ wceq M (cfv W cnmcv) $ >
  $ wceq N (co U W cnmoo) $ >
  $ wceq B2 (co U W cblo) $ >
  $ wcel U cnv $ >
  $ wcel W cnv $ >
  $ wi (wa (wcel T B2) (wcel A2 X)) (wbr (cfv (cfv A2 T) M) (co (cfv T N) (cfv A2 L) cmul) cle) $;

--| The predicate "is a bounded linear operator." Definition 2.7-1 of [Kreyszig] p. 91. (Contributed by NM, 11-Dec-2007.) (New usage is discouraged.)
theorem isblo3i {x3 y1: setvar} (B2 T U: class) (L: class y1) (M N W X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq M (cfv U cnmcv) $ >
  $ wceq N (cfv W cnmcv) $ >
  $ wceq L (co U W clno) $ >
  $ wceq B2 (co U W cblo) $ >
  $ wcel U cnv $ >
  $ wcel W cnv $ >
  $ wb (wcel T B2) (wa (wcel T L) (wrex x3 (wral y1 (wbr (cfv (cfv (cv y1) T) N) (co (cv x3) (cfv (cv y1) M) cmul) cle) X) cr)) $;

--| Properties that determine a bounded linear operator. (Contributed by NM, 13-Jan-2008.) (New usage is discouraged.)
theorem blo3i {y1: setvar} (A2 B2 T U: class) (L: class y1) (M N W X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq M (cfv U cnmcv) $ >
  $ wceq N (cfv W cnmcv) $ >
  $ wceq L (co U W clno) $ >
  $ wceq B2 (co U W cblo) $ >
  $ wcel U cnv $ >
  $ wcel W cnv $ >
  $ wi (w3a (wcel T L) (wcel A2 cr) (wral y1 (wbr (cfv (cfv (cv y1) T) N) (co A2 (cfv (cv y1) M) cmul) cle) X)) (wcel T B2) $;

--| Upper bound for the distance between the values of a bounded linear operator. (Contributed by NM, 11-Dec-2007.) (New usage is discouraged.)
theorem blometi (B2 C D P Q T U N W X Y: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Y (cfv W cba) $ >
  $ wceq C (cfv U cims) $ >
  $ wceq D (cfv W cims) $ >
  $ wceq N (co U W cnmoo) $ >
  $ wceq B2 (co U W cblo) $ >
  $ wcel U cnv $ >
  $ wcel W cnv $ >
  $ wi (w3a (wcel T B2) (wcel P X) (wcel Q X)) (wbr (co (cfv P T) (cfv Q T) D) (co (cfv T N) (co P Q C) cmul) cle) $;

--| Lemma for ~ blocni and ~ lnocni . If a linear operator is continuous at any point, it is bounded. (Contributed by NM, 17-Dec-2007.) (Revised by Mario Carneiro, 10-Jan-2014.) (New usage is discouraged.)
theorem blocnilem (B2 C D P T U J K L W X: class):
  $ wceq C (cfv U cims) $ >
  $ wceq D (cfv W cims) $ >
  $ wceq J (cfv C cmopn) $ >
  $ wceq K (cfv D cmopn) $ >
  $ wceq L (co U W clno) $ >
  $ wceq B2 (co U W cblo) $ >
  $ wcel U cnv $ >
  $ wcel W cnv $ >
  $ wcel T L $ >
  $ wceq X (cfv U cba) $ >
  $ wi (wa (wcel P X) (wcel T (cfv P (co J K ccnp)))) (wcel T B2) $;

--| A linear operator is continuous iff it is bounded. Theorem 2.7-9(a) of [Kreyszig] p. 97. (Contributed by NM, 18-Dec-2007.) (Revised by Mario Carneiro, 10-Jan-2014.) (New usage is discouraged.)
theorem blocni (B2 C D T U J K L W: class):
  $ wceq C (cfv U cims) $ >
  $ wceq D (cfv W cims) $ >
  $ wceq J (cfv C cmopn) $ >
  $ wceq K (cfv D cmopn) $ >
  $ wceq L (co U W clno) $ >
  $ wceq B2 (co U W cblo) $ >
  $ wcel U cnv $ >
  $ wcel W cnv $ >
  $ wcel T L $ >
  $ wb (wcel T (co J K ccn)) (wcel T B2) $;

--| If a linear operator is continuous at any point, it is continuous everywhere. Theorem 2.7-9(b) of [Kreyszig] p. 97. (Contributed by NM, 18-Dec-2007.) (New usage is discouraged.)
theorem lnocni (B2 C D P T U J K L W X: class):
  $ wceq C (cfv U cims) $ >
  $ wceq D (cfv W cims) $ >
  $ wceq J (cfv C cmopn) $ >
  $ wceq K (cfv D cmopn) $ >
  $ wceq L (co U W clno) $ >
  $ wceq B2 (co U W cblo) $ >
  $ wcel U cnv $ >
  $ wcel W cnv $ >
  $ wcel T L $ >
  $ wceq X (cfv U cba) $ >
  $ wi (wa (wcel P X) (wcel T (cfv P (co J K ccnp)))) (wcel T (co J K ccn)) $;

--| A linear operator is continuous iff it is bounded. Theorem 2.7-9(a) of [Kreyszig] p. 97. (Contributed by NM, 25-Dec-2007.) (New usage is discouraged.)
theorem blocn (B2 C D T U J K L W: class):
  $ wceq C (cfv U cims) $ >
  $ wceq D (cfv W cims) $ >
  $ wceq J (cfv C cmopn) $ >
  $ wceq K (cfv D cmopn) $ >
  $ wceq B2 (co U W cblo) $ >
  $ wcel U cnv $ >
  $ wcel W cnv $ >
  $ wceq L (co U W clno) $ >
  $ wi (wcel T L) (wb (wcel T (co J K ccn)) (wcel T B2)) $;

--| A bounded linear operator is continuous. (Contributed by NM, 25-Dec-2007.) (New usage is discouraged.)
theorem blocn2 (B2 C D T U J K W: class):
  $ wceq C (cfv U cims) $ >
  $ wceq D (cfv W cims) $ >
  $ wceq J (cfv C cmopn) $ >
  $ wceq K (cfv D cmopn) $ >
  $ wceq B2 (co U W cblo) $ >
  $ wcel U cnv $ >
  $ wcel W cnv $ >
  $ wi (wcel T B2) (wcel T (co J K ccn)) $;

--| The adjoint function. (Contributed by NM, 25-Jan-2008.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem ajfval {x3 y1 t s1: setvar} (A2 P Q: class x3 y1 t s1) (U W: class) (X: class y1) (Y: class x3):
  $ wceq X (cfv U cba) $ >
  $ wceq Y (cfv W cba) $ >
  $ wceq P (cfv U cdip) $ >
  $ wceq Q (cfv W cdip) $ >
  $ wceq A2 (co U W caj) $ >
  $ wi (wa (wcel U cnv) (wcel W cnv)) (wceq A2 (copab t s1 (w3a (wf X Y (cv t)) (wf Y X (cv s1)) (wral x3 (wral y1 (wceq (co (cfv (cv x3) (cv t)) (cv y1) Q) (co (cv x3) (cfv (cv y1) (cv s1)) P)) Y) X)))) $;

--| The set of Hermitian (self-adjoint) operators on a normed complex vector space. (Contributed by NM, 26-Jan-2008.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem hmoval {t: setvar} (A2 U: class) (H: class t):
  $ wceq H (cfv U chmo) $ >
  $ wceq A2 (co U U caj) $ >
  $ wi (wcel U cnv) (wceq H (crab t (wceq (cfv (cv t) A2) (cv t)) (cdm A2))) $;

--| The predicate "is a hermitian operator." (Contributed by NM, 26-Jan-2008.) (New usage is discouraged.)
theorem ishmo (A2 T U H: class):
  $ wceq H (cfv U chmo) $ >
  $ wceq A2 (co U U caj) $ >
  $ wi (wcel U cnv) (wb (wcel T H) (wa (wcel T (cdm A2)) (wceq (cfv T A2) T))) $;

--| Extend class notation with the class of all complex inner product spaces (also called pre-Hilbert spaces).
term ccphlo: class;

--| Define the class of all complex inner product spaces. An inner product space is a normed vector space whose norm satisfies the parallelogram law (a property that induces an inner product). Based on Exercise 4(b) of [ReedSimon] p. 63. The vector operation is ` g ` , the scalar product is ` s ` , and the norm is ` n ` . An inner product space is also called a pre-Hilbert space. (Contributed by NM, 2-Apr-2007.) (New usage is discouraged.)
axiom df_ph {x3 y1 g2 n s1: setvar}:
  $ wceq ccphlo (cin cnv (coprab g2 s1 n (wral x3 (wral y1 (wceq (co (co (cfv (co (cv x3) (cv y1) (cv g2)) (cv n)) c2 cexp) (co (cfv (co (cv x3) (co (cneg c1) (cv y1) (cv s1)) (cv g2)) (cv n)) c2 cexp) caddc) (co c2 (co (co (cfv (cv x3) (cv n)) c2 cexp) (co (cfv (cv y1) (cv n)) c2 cexp) caddc) cmul)) (crn (cv g2))) (crn (cv g2))))) $;

--| Every complex inner product space is a normed complex vector space. (Contributed by NM, 2-Apr-2007.) (New usage is discouraged.)
theorem phnv (U: class):
  $ wi (wcel U ccphlo) (wcel U cnv) $;

--| The class of all complex inner product spaces is a relation. (Contributed by NM, 2-Apr-2007.) (New usage is discouraged.)
theorem phrel:
  $ wrel ccphlo $;

--| Every complex inner product space is a normed complex vector space. (Contributed by NM, 20-Nov-2007.) (New usage is discouraged.)
theorem phnvi (U: class):
  $ wcel U ccphlo $ >
  $ wcel U cnv $;

--| The predicate "is a complex inner product space." An inner product space is a normed vector space whose norm satisfies the parallelogram law. The vector (group) addition operation is ` G ` , the scalar product is ` S ` , and the norm is ` N ` . An inner product space is also called a pre-Hilbert space. (Contributed by NM, 2-Apr-2007.) (New usage is discouraged.)
theorem isphg {x3 y1: setvar} (A2 B2 C: class x3 y1) (S G N X: class):
  $ wceq X (crn G) $ >
  $ wi (w3a (wcel G A2) (wcel S B2) (wcel N C)) (wb (wcel (cop (cop G S) N) ccphlo) (wa (wcel (cop (cop G S) N) cnv) (wral x3 (wral y1 (wceq (co (co (cfv (co (cv x3) (cv y1) G) N) c2 cexp) (co (cfv (co (cv x3) (co (cneg c1) (cv y1) S) G) N) c2 cexp) caddc) (co c2 (co (co (cfv (cv x3) N) c2 cexp) (co (cfv (cv y1) N) c2 cexp) caddc) cmul)) X) X))) $;

--| A complex inner product space in terms of ordered pair components. (Contributed by NM, 2-Apr-2007.) (New usage is discouraged.)
theorem phop (S U G N: class):
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wi (wcel U ccphlo) (wceq U (cop (cop G S) N)) $;

--| The set of complex numbers is an inner product (pre-Hilbert) space. (Contributed by Steve Rodriguez, 28-Apr-2007.) (Revised by Mario Carneiro, 7-Nov-2013.) (New usage is discouraged.)
theorem cncph (U: class):
  $ wceq U (cop (cop caddc cmul) cabs) $ >
  $ wcel U ccphlo $;

--| Hypothesis elimination lemma for complex inner product spaces to assist weak deduction theorem. (Contributed by NM, 27-Apr-2007.) (New usage is discouraged.)
theorem elimph (A2 U X Z: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Z (cfv U cn0v) $ >
  $ wcel U ccphlo $ >
  $ wcel (cif (wcel A2 X) A2 Z) X $;

--| Hypothesis elimination lemma for complex inner product spaces to assist weak deduction theorem. (Contributed by NM, 6-May-2007.) (New usage is discouraged.)
theorem elimphu (U: class):
  $ wcel (cif (wcel U ccphlo) U (cop (cop caddc cmul) cabs)) ccphlo $;

--| The predicate "is an inner product space." (Contributed by NM, 1-Feb-2008.) (New usage is discouraged.)
theorem isph {x3 y1: setvar} (U G M N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wb (wcel U ccphlo) (wa (wcel U cnv) (wral x3 (wral y1 (wceq (co (co (cfv (co (cv x3) (cv y1) G) N) c2 cexp) (co (cfv (co (cv x3) (cv y1) M) N) c2 cexp) caddc) (co c2 (co (co (cfv (cv x3) N) c2 cexp) (co (cfv (cv y1) N) c2 cexp) caddc) cmul)) X) X)) $;

--| The parallelogram law for an inner product space. (Contributed by NM, 2-Apr-2007.) (New usage is discouraged.)
theorem phpar2 (A2 B2 U G M N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wi (w3a (wcel U ccphlo) (wcel A2 X) (wcel B2 X)) (wceq (co (co (cfv (co A2 B2 G) N) c2 cexp) (co (cfv (co A2 B2 M) N) c2 cexp) caddc) (co c2 (co (co (cfv A2 N) c2 cexp) (co (cfv B2 N) c2 cexp) caddc) cmul)) $;

--| The parallelogram law for an inner product space. (Contributed by NM, 2-Apr-2007.) (New usage is discouraged.)
theorem phpar (A2 B2 S U G N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wi (w3a (wcel U ccphlo) (wcel A2 X) (wcel B2 X)) (wceq (co (co (cfv (co A2 B2 G) N) c2 cexp) (co (cfv (co A2 (co (cneg c1) B2 S) G) N) c2 cexp) caddc) (co c2 (co (co (cfv A2 N) c2 cexp) (co (cfv B2 N) c2 cexp) caddc) cmul)) $;

--| A slight variant of Equation 6.46 of [Ponnusamy] p. 362, where ` J ` is either 1 or -1 to represent +-1. (Contributed by NM, 23-Apr-2007.) (New usage is discouraged.)
theorem ip0i (A2 B2 C P S U G J N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq P (cfv U cdip) $ >
  $ wcel U ccphlo $ >
  $ wcel A2 X $ >
  $ wcel B2 X $ >
  $ wcel C X $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wcel J cc $ >
  $ wceq (co (co (co (cfv (co (co A2 B2 G) (co J C S) G) N) c2 cexp) (co (cfv (co (co A2 B2 G) (co (cneg J) C S) G) N) c2 cexp) cmin) (co (co (cfv (co (co A2 (co (cneg c1) B2 S) G) (co J C S) G) N) c2 cexp) (co (cfv (co (co A2 (co (cneg c1) B2 S) G) (co (cneg J) C S) G) N) c2 cexp) cmin) caddc) (co c2 (co (co (cfv (co A2 (co J C S) G) N) c2 cexp) (co (cfv (co A2 (co (cneg J) C S) G) N) c2 cexp) cmin) cmul) $;

--| Lemma for ~ ip1i . (Contributed by NM, 21-Apr-2007.) (New usage is discouraged.)
theorem ip1ilem (A2 B2 C P S U G J N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq P (cfv U cdip) $ >
  $ wcel U ccphlo $ >
  $ wcel A2 X $ >
  $ wcel B2 X $ >
  $ wcel C X $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wcel J cc $ >
  $ wceq (co (co (co A2 B2 G) C P) (co (co A2 (co (cneg c1) B2 S) G) C P) caddc) (co c2 (co A2 C P) cmul) $;

--| Equation 6.47 of [Ponnusamy] p. 362. (Contributed by NM, 27-Apr-2007.) (New usage is discouraged.)
theorem ip1i (A2 B2 C P S U G X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq P (cfv U cdip) $ >
  $ wcel U ccphlo $ >
  $ wcel A2 X $ >
  $ wcel B2 X $ >
  $ wcel C X $ >
  $ wceq (co (co (co A2 B2 G) C P) (co (co A2 (co (cneg c1) B2 S) G) C P) caddc) (co c2 (co A2 C P) cmul) $;

--| Equation 6.48 of [Ponnusamy] p. 362. (Contributed by NM, 26-Apr-2007.) (New usage is discouraged.)
theorem ip2i (A2 B2 P S U G X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq P (cfv U cdip) $ >
  $ wcel U ccphlo $ >
  $ wcel A2 X $ >
  $ wcel B2 X $ >
  $ wceq (co (co c2 A2 S) B2 P) (co c2 (co A2 B2 P) cmul) $;

--| Lemma for ~ ipdiri . (Contributed by NM, 26-Apr-2007.) (New usage is discouraged.)
theorem ipdirilem (A2 B2 C P S U G X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq P (cfv U cdip) $ >
  $ wcel U ccphlo $ >
  $ wcel A2 X $ >
  $ wcel B2 X $ >
  $ wcel C X $ >
  $ wceq (co (co A2 B2 G) C P) (co (co A2 C P) (co B2 C P) caddc) $;

--| Distributive law for inner product. Equation I3 of [Ponnusamy] p. 362. (Contributed by NM, 27-Apr-2007.) (New usage is discouraged.)
theorem ipdiri (A2 B2 C P S U G X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq P (cfv U cdip) $ >
  $ wcel U ccphlo $ >
  $ wi (w3a (wcel A2 X) (wcel B2 X) (wcel C X)) (wceq (co (co A2 B2 G) C P) (co (co A2 C P) (co B2 C P) caddc)) $;

--| Lemma for ~ ipassi . Show the inner product associative law for nonnegative integers. (Contributed by NM, 27-Apr-2007.) (New usage is discouraged.)
theorem ipasslem1 (A2 B2 P S U G N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq P (cfv U cdip) $ >
  $ wcel U ccphlo $ >
  $ wcel B2 X $ >
  $ wi (wa (wcel N cn0) (wcel A2 X)) (wceq (co (co N A2 S) B2 P) (co N (co A2 B2 P) cmul)) $;

--| Lemma for ~ ipassi . Show the inner product associative law for nonpositive integers. (Contributed by NM, 27-Apr-2007.) (New usage is discouraged.)
theorem ipasslem2 (A2 B2 P S U G N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq P (cfv U cdip) $ >
  $ wcel U ccphlo $ >
  $ wcel B2 X $ >
  $ wi (wa (wcel N cn0) (wcel A2 X)) (wceq (co (co (cneg N) A2 S) B2 P) (co (cneg N) (co A2 B2 P) cmul)) $;

--| Lemma for ~ ipassi . Show the inner product associative law for all integers. (Contributed by NM, 27-Apr-2007.) (New usage is discouraged.)
theorem ipasslem3 (A2 B2 P S U G N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq P (cfv U cdip) $ >
  $ wcel U ccphlo $ >
  $ wcel B2 X $ >
  $ wi (wa (wcel N cz) (wcel A2 X)) (wceq (co (co N A2 S) B2 P) (co N (co A2 B2 P) cmul)) $;

--| Lemma for ~ ipassi . Show the inner product associative law for positive integer reciprocals. (Contributed by NM, 27-Apr-2007.) (New usage is discouraged.)
theorem ipasslem4 (A2 B2 P S U G N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq P (cfv U cdip) $ >
  $ wcel U ccphlo $ >
  $ wcel B2 X $ >
  $ wi (wa (wcel N cn) (wcel A2 X)) (wceq (co (co (co c1 N cdiv) A2 S) B2 P) (co (co c1 N cdiv) (co A2 B2 P) cmul)) $;

--| Lemma for ~ ipassi . Show the inner product associative law for rational numbers. (Contributed by NM, 27-Apr-2007.) (New usage is discouraged.)
theorem ipasslem5 (A2 B2 C P S U G X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq P (cfv U cdip) $ >
  $ wcel U ccphlo $ >
  $ wcel B2 X $ >
  $ wi (wa (wcel C cq) (wcel A2 X)) (wceq (co (co C A2 S) B2 P) (co C (co A2 B2 P) cmul)) $;

--| Lemma for ~ ipassi . Show that ` ( ( w S A ) P B ) - ( w x. ( A P B ) ) ` is continuous on ` RR ` . (Contributed by NM, 23-Aug-2007.) (Revised by Mario Carneiro, 6-May-2014.) (New usage is discouraged.)
theorem ipasslem7 {w: setvar} (A2 B2 P S U: class) (F G J: class w) (K X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq P (cfv U cdip) $ >
  $ wcel U ccphlo $ >
  $ wcel A2 X $ >
  $ wcel B2 X $ >
  $ wceq F (cmpt w cr (co (co (co (cv w) A2 S) B2 P) (co (cv w) (co A2 B2 P) cmul) cmin)) $ >
  $ wceq J (cfv (crn cioo) ctg) $ >
  $ wceq K (cfv ccnfld ctopn) $ >
  $ wcel F (co J K ccn) $;

--| Lemma for ~ ipassi . By ~ ipasslem5 , ` F ` is 0 for all ` QQ ` ; since it is continuous and ` QQ ` is dense in ` RR ` by ~ qdensere2 , we conclude ` F ` is 0 for all ` RR ` . (Contributed by NM, 24-Aug-2007.) (Revised by Mario Carneiro, 6-May-2014.) (New usage is discouraged.)
theorem ipasslem8 {w: setvar} (A2 B2 P S U: class) (F G: class w) (X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq P (cfv U cdip) $ >
  $ wcel U ccphlo $ >
  $ wcel A2 X $ >
  $ wcel B2 X $ >
  $ wceq F (cmpt w cr (co (co (co (cv w) A2 S) B2 P) (co (cv w) (co A2 B2 P) cmul) cmin)) $ >
  $ wf cr (csn cc0) F $;

--| Lemma for ~ ipassi . Conclude from ~ ipasslem8 the inner product associative law for real numbers. (Contributed by NM, 24-Aug-2007.) (New usage is discouraged.)
theorem ipasslem9 (A2 B2 C P S U G X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq P (cfv U cdip) $ >
  $ wcel U ccphlo $ >
  $ wcel A2 X $ >
  $ wcel B2 X $ >
  $ wi (wcel C cr) (wceq (co (co C A2 S) B2 P) (co C (co A2 B2 P) cmul)) $;

--| Lemma for ~ ipassi . Show the inner product associative law for the imaginary number ` _i ` . (Contributed by NM, 24-Aug-2007.) (New usage is discouraged.)
theorem ipasslem10 (A2 B2 P S U G N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq P (cfv U cdip) $ >
  $ wcel U ccphlo $ >
  $ wcel A2 X $ >
  $ wcel B2 X $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq (co (co ci A2 S) B2 P) (co ci (co A2 B2 P) cmul) $;

--| Lemma for ~ ipassi . Show the inner product associative law for all complex numbers. (Contributed by NM, 25-Aug-2007.) (New usage is discouraged.)
theorem ipasslem11 (A2 B2 C P S U G X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq P (cfv U cdip) $ >
  $ wcel U ccphlo $ >
  $ wcel A2 X $ >
  $ wcel B2 X $ >
  $ wi (wcel C cc) (wceq (co (co C A2 S) B2 P) (co C (co A2 B2 P) cmul)) $;

--| Associative law for inner product. Equation I2 of [Ponnusamy] p. 363. (Contributed by NM, 25-Aug-2007.) (New usage is discouraged.)
theorem ipassi (A2 B2 C P S U G X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq P (cfv U cdip) $ >
  $ wcel U ccphlo $ >
  $ wi (w3a (wcel A2 cc) (wcel B2 X) (wcel C X)) (wceq (co (co A2 B2 S) C P) (co A2 (co B2 C P) cmul)) $;

--| Distributive law for inner product. Equation I3 of [Ponnusamy] p. 362. (Contributed by NM, 25-Aug-2007.) (New usage is discouraged.)
theorem dipdir (A2 B2 C P U G X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq P (cfv U cdip) $ >
  $ wi (wa (wcel U ccphlo) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wceq (co (co A2 B2 G) C P) (co (co A2 C P) (co B2 C P) caddc)) $;

--| Distributive law for inner product. (Contributed by NM, 20-Nov-2007.) (New usage is discouraged.)
theorem dipdi (A2 B2 C P U G X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq P (cfv U cdip) $ >
  $ wi (wa (wcel U ccphlo) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wceq (co A2 (co B2 C G) P) (co (co A2 B2 P) (co A2 C P) caddc)) $;

--| Inner product of two sums. (Contributed by NM, 17-Apr-2008.) (New usage is discouraged.)
theorem ip2dii (A2 B2 C D P U G X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq P (cfv U cdip) $ >
  $ wcel U ccphlo $ >
  $ wcel A2 X $ >
  $ wcel B2 X $ >
  $ wcel C X $ >
  $ wcel D X $ >
  $ wceq (co (co A2 B2 G) (co C D G) P) (co (co (co A2 C P) (co B2 D P) caddc) (co (co A2 D P) (co B2 C P) caddc) caddc) $;

--| Associative law for inner product. Equation I2 of [Ponnusamy] p. 363. (Contributed by NM, 25-Aug-2007.) (New usage is discouraged.)
theorem dipass (A2 B2 C P S U X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq P (cfv U cdip) $ >
  $ wi (wa (wcel U ccphlo) (w3a (wcel A2 cc) (wcel B2 X) (wcel C X))) (wceq (co (co A2 B2 S) C P) (co A2 (co B2 C P) cmul)) $;

--| "Associative" law for second argument of inner product (compare ~ dipass ). (Contributed by NM, 22-Nov-2007.) (New usage is discouraged.)
theorem dipassr (A2 B2 C P S U X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq P (cfv U cdip) $ >
  $ wi (wa (wcel U ccphlo) (w3a (wcel A2 X) (wcel B2 cc) (wcel C X))) (wceq (co A2 (co B2 C S) P) (co (cfv B2 ccj) (co A2 C P) cmul)) $;

--| "Associative" law for inner product. Conjugate version of ~ dipassr . (Contributed by NM, 23-Nov-2007.) (New usage is discouraged.)
theorem dipassr2 (A2 B2 C P S U X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq P (cfv U cdip) $ >
  $ wi (wa (wcel U ccphlo) (w3a (wcel A2 X) (wcel B2 cc) (wcel C X))) (wceq (co A2 (co (cfv B2 ccj) C S) P) (co B2 (co A2 C P) cmul)) $;

--| Distributive law for inner product subtraction. (Contributed by NM, 20-Nov-2007.) (New usage is discouraged.)
theorem dipsubdir (A2 B2 C P U M X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wceq P (cfv U cdip) $ >
  $ wi (wa (wcel U ccphlo) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wceq (co (co A2 B2 M) C P) (co (co A2 C P) (co B2 C P) cmin)) $;

--| Distributive law for inner product subtraction. (Contributed by NM, 20-Nov-2007.) (New usage is discouraged.)
theorem dipsubdi (A2 B2 C P U M X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wceq P (cfv U cdip) $ >
  $ wi (wa (wcel U ccphlo) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wceq (co A2 (co B2 C M) P) (co (co A2 B2 P) (co A2 C P) cmin)) $;

--| The Pythagorean theorem for an arbitrary complex inner product (pre-Hilbert) space ` U ` . The square of the norm of the sum of two orthogonal vectors (i.e. whose inner product is 0) is the sum of the squares of their norms. Problem 2 in [Kreyszig] p. 135. (Contributed by NM, 17-Apr-2008.) (New usage is discouraged.)
theorem pythi (A2 B2 P U G N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq P (cfv U cdip) $ >
  $ wcel U ccphlo $ >
  $ wcel A2 X $ >
  $ wcel B2 X $ >
  $ wi (wceq (co A2 B2 P) cc0) (wceq (co (cfv (co A2 B2 G) N) c2 cexp) (co (co (cfv A2 N) c2 cexp) (co (cfv B2 N) c2 cexp) caddc)) $;

--| Lemma for ~ sii . (Contributed by NM, 23-Nov-2007.) (New usage is discouraged.)
theorem siilem1 (A2 B2 C P S U M N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq P (cfv U cdip) $ >
  $ wcel U ccphlo $ >
  $ wcel A2 X $ >
  $ wcel B2 X $ >
  $ wceq M (cfv U cnsb) $ >
  $ wceq S (cfv U cns) $ >
  $ wcel C cc $ >
  $ wcel (co C (co A2 B2 P) cmul) cr $ >
  $ wbr cc0 (co C (co A2 B2 P) cmul) cle $ >
  $ wi (wceq (co B2 A2 P) (co C (co (cfv B2 N) c2 cexp) cmul)) (wbr (cfv (co (co A2 B2 P) (co C (co (cfv B2 N) c2 cexp) cmul) cmul) csqrt) (co (cfv A2 N) (cfv B2 N) cmul) cle) $;

--| Lemma for ~ sii . (Contributed by NM, 24-Nov-2007.) (New usage is discouraged.)
theorem siilem2 (A2 B2 C P S U M N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq P (cfv U cdip) $ >
  $ wcel U ccphlo $ >
  $ wcel A2 X $ >
  $ wcel B2 X $ >
  $ wceq M (cfv U cnsb) $ >
  $ wceq S (cfv U cns) $ >
  $ wi (w3a (wcel C cc) (wcel (co C (co A2 B2 P) cmul) cr) (wbr cc0 (co C (co A2 B2 P) cmul) cle)) (wi (wceq (co B2 A2 P) (co C (co (cfv B2 N) c2 cexp) cmul)) (wbr (cfv (co (co A2 B2 P) (co C (co (cfv B2 N) c2 cexp) cmul) cmul) csqrt) (co (cfv A2 N) (cfv B2 N) cmul) cle)) $;

--| Inference from ~ sii . (Contributed by NM, 20-Nov-2007.) (New usage is discouraged.)
theorem siii (A2 B2 P U N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq P (cfv U cdip) $ >
  $ wcel U ccphlo $ >
  $ wcel A2 X $ >
  $ wcel B2 X $ >
  $ wbr (cfv (co A2 B2 P) cabs) (co (cfv A2 N) (cfv B2 N) cmul) cle $;

--| Obsolete version of ~ ipcau as of 22-Sep-2024. Schwarz inequality. Part of Lemma 3-2.1(a) of [Kreyszig] p. 137. This is also called the Cauchy-Schwarz inequality by some authors and Bunjakovaskij-Cauchy-Schwarz inequality by others. See also Theorems ~ bcseqi , ~ bcsiALT , ~ bcsiHIL , ~ csbren . (Contributed by NM, 12-Jan-2008.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem sii (A2 B2 P U N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq P (cfv U cdip) $ >
  $ wcel U ccphlo $ >
  $ wi (wa (wcel A2 X) (wcel B2 X)) (wbr (cfv (co A2 B2 P) cabs) (co (cfv A2 N) (cfv B2 N) cmul) cle) $;

--| A function ` F ` generated by varying the first argument of an inner product (with its second argument a fixed vector ` A ` ) is a bounded linear functional, i.e. a bounded linear operator from the vector space to ` CC ` . (Contributed by NM, 12-Jan-2008.) (Revised by Mario Carneiro, 19-Nov-2013.) (New usage is discouraged.)
theorem ipblnfi {x3: setvar} (A2: class) (B2 C: class x3) (P U: class) (F: class x3) (X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq P (cfv U cdip) $ >
  $ wcel U ccphlo $ >
  $ wceq C (cop (cop caddc cmul) cabs) $ >
  $ wceq B2 (co U C cblo) $ >
  $ wceq F (cmpt x3 X (co (cv x3) A2 P)) $ >
  $ wi (wcel A2 X) (wcel F B2) $;

--| Two vectors are equal iff their inner products with all other vectors are equal. (Contributed by NM, 24-Jan-2008.) (New usage is discouraged.)
theorem ip2eqi {x3: setvar} (A2 B2 P U X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq P (cfv U cdip) $ >
  $ wcel U ccphlo $ >
  $ wi (wa (wcel A2 X) (wcel B2 X)) (wb (wral x3 (wceq (co (cv x3) A2 P) (co (cv x3) B2 P)) X) (wceq A2 B2)) $;

--| A condition implying that two operators are equal. (Contributed by NM, 25-Jan-2008.) (New usage is discouraged.)
theorem phoeqi {x3 y1: setvar} (P: class y1) (S T: class) (U: class y1) (X Y: class):
  $ wceq X (cfv U cba) $ >
  $ wceq P (cfv U cdip) $ >
  $ wcel U ccphlo $ >
  $ wi (wa (wf Y X S) (wf Y X T)) (wb (wral x3 (wral y1 (wceq (co (cv x3) (cfv (cv y1) S) P) (co (cv x3) (cfv (cv y1) T) P)) Y) X) (wceq S T)) $;

--| Every operator has at most one adjoint. (Contributed by NM, 25-Jan-2008.) (New usage is discouraged.)
theorem ajmoi {x3 y1 s1: setvar} (P: class y1) (Q: class x3 y1) (T: class) (U: class y1 s1) (X Y: class):
  $ wceq X (cfv U cba) $ >
  $ wceq P (cfv U cdip) $ >
  $ wcel U ccphlo $ >
  $ wmo s1 (wa (wf Y X (cv s1)) (wral x3 (wral y1 (wceq (co (cfv (cv x3) T) (cv y1) Q) (co (cv x3) (cfv (cv y1) (cv s1)) P)) Y) X)) $;

--| The adjoint function is a function. (Contributed by NM, 25-Jan-2008.) (New usage is discouraged.)
theorem ajfuni (A2 U W: class):
  $ wceq A2 (co U W caj) $ >
  $ wcel U ccphlo $ >
  $ wcel W cnv $ >
  $ wfun A2 $;

--| The adjoint function is a function. This is not immediately apparent from ~ df-aj but results from the uniqueness shown by ~ ajmoi . (Contributed by NM, 26-Jan-2008.) (New usage is discouraged.)
theorem ajfun (A2 U W: class):
  $ wceq A2 (co U W caj) $ >
  $ wi (wa (wcel U ccphlo) (wcel W cnv)) (wfun A2) $;

--| Value of the adjoint function. (Contributed by NM, 25-Jan-2008.) (New usage is discouraged.)
theorem ajval {x3 y1 s1: setvar} (A2 P Q: class x3 y1 s1) (T U W X: class) (Y: class x3):
  $ wceq X (cfv U cba) $ >
  $ wceq Y (cfv W cba) $ >
  $ wceq P (cfv U cdip) $ >
  $ wceq Q (cfv W cdip) $ >
  $ wceq A2 (co U W caj) $ >
  $ wi (w3a (wcel U ccphlo) (wcel W cnv) (wf X Y T)) (wceq (cfv T A2) (cio s1 (wa (wf Y X (cv s1)) (wral x3 (wral y1 (wceq (co (cfv (cv x3) T) (cv y1) Q) (co (cv x3) (cfv (cv y1) (cv s1)) P)) Y) X)))) $;

--| Extend class notation with the class of all complex Banach spaces.
term ccbn: class;

--| Define the class of all complex Banach spaces. (Contributed by NM, 5-Dec-2006.) Use ~ df-bn instead. (New usage is discouraged.)
axiom df_cbn {u: setvar}:
  $ wceq ccbn (crab u (wcel (cfv (cv u) cims) (cfv (cfv (cv u) cba) ccmet)) cnv) $;

--| A complex Banach space is a normed complex vector space with a complete induced metric. (Contributed by NM, 5-Dec-2006.) Use ~ isbn instead. (New usage is discouraged.)
theorem iscbn (D U X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq D (cfv U cims) $ >
  $ wb (wcel U ccbn) (wa (wcel U cnv) (wcel D (cfv X ccmet))) $;

--| The induced metric on complex Banach space is complete. (Contributed by NM, 8-Sep-2007.) Use ~ bncmet (or preferably ~ bncms ) instead. (New usage is discouraged.)
theorem cbncms (D U X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq D (cfv U cims) $ >
  $ wi (wcel U ccbn) (wcel D (cfv X ccmet)) $;

--| Every complex Banach space is a normed complex vector space. (Contributed by NM, 17-Mar-2007.) Use ~ bnnvc instead. (New usage is discouraged.)
theorem bnnv (U: class):
  $ wi (wcel U ccbn) (wcel U cnv) $;

--| The class of all complex Banach spaces is a relation. (Contributed by NM, 17-Mar-2007.) (New usage is discouraged.)
theorem bnrel:
  $ wrel ccbn $;

--| A subspace of a Banach space is a Banach space iff it is closed in the norm-induced metric of the parent space. (Contributed by NM, 1-Feb-2008.) (New usage is discouraged.)
theorem bnsscmcl (D U H J W X Y: class):
  $ wceq X (cfv U cba) $ >
  $ wceq D (cfv U cims) $ >
  $ wceq J (cfv D cmopn) $ >
  $ wceq H (cfv U css) $ >
  $ wceq Y (cfv W cba) $ >
  $ wi (wa (wcel U ccbn) (wcel W H)) (wb (wcel W ccbn) (wcel Y (cfv J ccld))) $;

--| The set of complex numbers is a complex Banach space. (Contributed by Steve Rodriguez, 4-Jan-2007.) (New usage is discouraged.)
theorem cnbn (U: class):
  $ wceq U (cop (cop caddc cmul) cabs) $ >
  $ wcel U ccbn $;

--| Lemma for ~ ubth . The function ` A ` exhibits a countable collection of sets that are closed, being the inverse image under ` t ` of the closed ball of radius ` k ` , and by assumption they cover ` X ` . Thus, by the Baire Category theorem ~ bcth2 , for some ` n ` the set ` A `` n ` has an interior, meaning that there is a closed ball ` { z e. X | ( y D z ) <_ r } ` in the set. (Contributed by Mario Carneiro, 11-Jan-2014.) (New usage is discouraged.)
theorem ubthlem1 {x3 y1 z t k n r c: setvar} (ph: wff z) (A2: class t) (D: class y1) (T: class) (U: class k) (J: class z r c) (N: class) (W: class z k) (X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq N (cfv W cnmcv) $ >
  $ wceq D (cfv U cims) $ >
  $ wceq J (cfv D cmopn) $ >
  $ wcel U ccbn $ >
  $ wcel W cnv $ >
  $ wi ph (wss T (co U W cblo)) $ >
  $ wi ph (wral x3 (wrex c (wral t (wbr (cfv (cfv (cv x3) (cv t)) N) (cv c) cle) T) cr) X) $ >
  $ wceq A2 (cmpt k cn (crab z (wral t (wbr (cfv (cfv (cv z) (cv t)) N) (cv k) cle) T) X)) $ >
  $ wi ph (wrex n (wrex y1 (wrex r (wss (crab z (wbr (co (cv y1) (cv z) D) (cv r) cle) X) (cfv (cv n) A2)) crp) X) cn) $;

--| Lemma for ~ ubth . Given that there is a closed ball ` B ( P , R ) ` in ` A `` K ` , for any ` x e. B ( 0 , 1 ) ` , we have ` P + R x. x e. B ( P , R ) ` and ` P e. B ( P , R ) ` , so both of these have ` norm ( t ( z ) ) <_ K ` and so ` norm ( t ( x ` ` ) ) <_ ( norm ( t ( P ) ) + norm ( t ( P + R x. x ) ) ) / R <_ ( ` ` K + K ) / R ` , which is our desired uniform bound. (Contributed by Mario Carneiro, 11-Jan-2014.) (New usage is discouraged.)
theorem ubthlem2 {x3 z t k c d: setvar} (ph: wff z d) (A2: class t d) (D: class d) (P: class x3 k c d) (R: class k c) (T: class) (U: class k) (J: class z c d) (K: class c) (N: class) (W: class z k) (X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq N (cfv W cnmcv) $ >
  $ wceq D (cfv U cims) $ >
  $ wceq J (cfv D cmopn) $ >
  $ wcel U ccbn $ >
  $ wcel W cnv $ >
  $ wi ph (wss T (co U W cblo)) $ >
  $ wi ph (wral x3 (wrex c (wral t (wbr (cfv (cfv (cv x3) (cv t)) N) (cv c) cle) T) cr) X) $ >
  $ wceq A2 (cmpt k cn (crab z (wral t (wbr (cfv (cfv (cv z) (cv t)) N) (cv k) cle) T) X)) $ >
  $ wi ph (wcel K cn) $ >
  $ wi ph (wcel P X) $ >
  $ wi ph (wcel R crp) $ >
  $ wi ph (wss (crab z (wbr (co P (cv z) D) R cle) X) (cfv K A2)) $ >
  $ wi ph (wrex d (wral t (wbr (cfv (cv t) (co U W cnmoo)) (cv d) cle) T) cr) $;

--| Lemma for ~ ubth . Prove the reverse implication, using ~ nmblolbi . (Contributed by Mario Carneiro, 11-Jan-2014.) (New usage is discouraged.)
theorem ubthlem3 {x3 t c d: setvar} (ph: wff) (D: class d) (T U: class) (J: class c d) (N W X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq N (cfv W cnmcv) $ >
  $ wceq D (cfv U cims) $ >
  $ wceq J (cfv D cmopn) $ >
  $ wcel U ccbn $ >
  $ wcel W cnv $ >
  $ wi ph (wss T (co U W cblo)) $ >
  $ wi ph (wb (wral x3 (wrex c (wral t (wbr (cfv (cfv (cv x3) (cv t)) N) (cv c) cle) T) cr) X) (wrex d (wral t (wbr (cfv (cv t) (co U W cnmoo)) (cv d) cle) T) cr)) $;

--| Uniform Boundedness Theorem, also called the Banach-Steinhaus Theorem. Let ` T ` be a collection of bounded linear operators on a Banach space. If, for every vector ` x ` , the norms of the operators' values are bounded, then the operators' norms are also bounded. Theorem 4.7-3 of [Kreyszig] p. 249. See also ~ http://en.wikipedia.org/wiki/Uniform_boundedness_principle . (Contributed by NM, 7-Nov-2007.) (Proof shortened by Mario Carneiro, 11-Jan-2014.) (New usage is discouraged.)
theorem ubth {x3 t c d: setvar} (T U: class) (M: class x3 t c d) (N W X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq N (cfv W cnmcv) $ >
  $ wceq M (co U W cnmoo) $ >
  $ wi (w3a (wcel U ccbn) (wcel W cnv) (wss T (co U W cblo))) (wb (wral x3 (wrex c (wral t (wbr (cfv (cfv (cv x3) (cv t)) N) (cv c) cle) T) cr) X) (wrex d (wral t (wbr (cfv (cv t) M) (cv d) cle) T) cr)) $;

--| Lemma for ~ minveco . The set of all distances from points of ` Y ` to ` A ` are a nonempty set of nonnegative reals. (Contributed by Mario Carneiro, 8-May-2014.) (New usage is discouraged.)
theorem minvecolem1 {y1 w: setvar} (ph: wff) (A2 D: class) (R: class y1) (U J M N W: class) (X: class y1) (Y: class):
  $ wceq X (cfv U cba) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq Y (cfv W cba) $ >
  $ wi ph (wcel U ccphlo) $ >
  $ wi ph (wcel W (cin (cfv U css) ccbn)) $ >
  $ wi ph (wcel A2 X) $ >
  $ wceq D (cfv U cims) $ >
  $ wceq J (cfv D cmopn) $ >
  $ wceq R (crn (cmpt y1 Y (cfv (co A2 (cv y1) M) N))) $ >
  $ wi ph (w3a (wss R cr) (wne R c0) (wral w (wbr cc0 (cv w) cle) R)) $;

--| Lemma for ~ minveco . Any two points ` K ` and ` L ` in ` Y ` are close to each other if they are close to the infimum of distance to ` A ` . (Contributed by Mario Carneiro, 9-May-2014.) (Revised by AV, 4-Oct-2020.) (New usage is discouraged.)
theorem minvecolem2 {y1: setvar} (ph: wff) (A2: class) (B2: class y1) (D: class) (R: class y1) (S U J K L M N W: class) (X: class y1) (Y: class):
  $ wceq X (cfv U cba) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq Y (cfv W cba) $ >
  $ wi ph (wcel U ccphlo) $ >
  $ wi ph (wcel W (cin (cfv U css) ccbn)) $ >
  $ wi ph (wcel A2 X) $ >
  $ wceq D (cfv U cims) $ >
  $ wceq J (cfv D cmopn) $ >
  $ wceq R (crn (cmpt y1 Y (cfv (co A2 (cv y1) M) N))) $ >
  $ wceq S (cinf R cr clt) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr cc0 B2 cle) $ >
  $ wi ph (wcel K Y) $ >
  $ wi ph (wcel L Y) $ >
  $ wi ph (wbr (co (co A2 K D) c2 cexp) (co (co S c2 cexp) B2 caddc) cle) $ >
  $ wi ph (wbr (co (co A2 L D) c2 cexp) (co (co S c2 cexp) B2 caddc) cle) $ >
  $ wi ph (wbr (co (co K L D) c2 cexp) (co c4 B2 cmul) cle) $;

--| Lemma for ~ minveco . The sequence formed by taking elements successively closer to the infimum is Cauchy. (Contributed by Mario Carneiro, 8-May-2014.) (Revised by AV, 4-Oct-2020.) (New usage is discouraged.)
theorem minvecolem3 {y1 n: setvar} (ph: wff) (A2 D: class) (R: class y1 n) (S: class) (U: class n) (F J: class) (M N W: class n) (X: class y1) (Y: class):
  $ wceq X (cfv U cba) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq Y (cfv W cba) $ >
  $ wi ph (wcel U ccphlo) $ >
  $ wi ph (wcel W (cin (cfv U css) ccbn)) $ >
  $ wi ph (wcel A2 X) $ >
  $ wceq D (cfv U cims) $ >
  $ wceq J (cfv D cmopn) $ >
  $ wceq R (crn (cmpt y1 Y (cfv (co A2 (cv y1) M) N))) $ >
  $ wceq S (cinf R cr clt) $ >
  $ wi ph (wf cn Y F) $ >
  $ wi (wa ph (wcel (cv n) cn)) (wbr (co (co A2 (cfv (cv n) F) D) c2 cexp) (co (co S c2 cexp) (co c1 (cv n) cdiv) caddc) cle) $ >
  $ wi ph (wcel F (cfv D ccau)) $;

--| Lemma for ~ minveco . ` F ` is convergent in the subspace topology on ` Y ` . (Contributed by Mario Carneiro, 7-May-2014.) (New usage is discouraged.)
theorem minvecolem4a {y1 n: setvar} (ph: wff) (A2 D: class) (R: class y1 n) (S: class) (U: class n) (F J: class) (M N W: class n) (X: class y1) (Y: class):
  $ wceq X (cfv U cba) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq Y (cfv W cba) $ >
  $ wi ph (wcel U ccphlo) $ >
  $ wi ph (wcel W (cin (cfv U css) ccbn)) $ >
  $ wi ph (wcel A2 X) $ >
  $ wceq D (cfv U cims) $ >
  $ wceq J (cfv D cmopn) $ >
  $ wceq R (crn (cmpt y1 Y (cfv (co A2 (cv y1) M) N))) $ >
  $ wceq S (cinf R cr clt) $ >
  $ wi ph (wf cn Y F) $ >
  $ wi (wa ph (wcel (cv n) cn)) (wbr (co (co A2 (cfv (cv n) F) D) c2 cexp) (co (co S c2 cexp) (co c1 (cv n) cdiv) caddc) cle) $ >
  $ wi ph (wbr F (cfv F (cfv (cfv (cres D (cxp Y Y)) cmopn) clm)) (cfv (cfv (cres D (cxp Y Y)) cmopn) clm)) $;

--| Lemma for ~ minveco . The convergent point of the Cauchy sequence ` F ` is a member of the base space. (Contributed by Mario Carneiro, 16-Jun-2014.) (New usage is discouraged.)
theorem minvecolem4b {y1 n: setvar} (ph: wff) (A2 D: class) (R: class y1 n) (S: class) (U: class n) (F J: class) (M N W: class n) (X: class y1) (Y: class):
  $ wceq X (cfv U cba) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq Y (cfv W cba) $ >
  $ wi ph (wcel U ccphlo) $ >
  $ wi ph (wcel W (cin (cfv U css) ccbn)) $ >
  $ wi ph (wcel A2 X) $ >
  $ wceq D (cfv U cims) $ >
  $ wceq J (cfv D cmopn) $ >
  $ wceq R (crn (cmpt y1 Y (cfv (co A2 (cv y1) M) N))) $ >
  $ wceq S (cinf R cr clt) $ >
  $ wi ph (wf cn Y F) $ >
  $ wi (wa ph (wcel (cv n) cn)) (wbr (co (co A2 (cfv (cv n) F) D) c2 cexp) (co (co S c2 cexp) (co c1 (cv n) cdiv) caddc) cle) $ >
  $ wi ph (wcel (cfv F (cfv J clm)) X) $;

--| Lemma for ~ minveco . The infimum of the distances to ` A ` is a real number. (Contributed by Mario Carneiro, 16-Jun-2014.) (Revised by AV, 4-Oct-2020.) (New usage is discouraged.)
theorem minvecolem4c {y1 n: setvar} (ph: wff) (A2 D: class) (R: class y1 n) (S: class) (U: class n) (F J: class) (M N W: class n) (X: class y1) (Y: class):
  $ wceq X (cfv U cba) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq Y (cfv W cba) $ >
  $ wi ph (wcel U ccphlo) $ >
  $ wi ph (wcel W (cin (cfv U css) ccbn)) $ >
  $ wi ph (wcel A2 X) $ >
  $ wceq D (cfv U cims) $ >
  $ wceq J (cfv D cmopn) $ >
  $ wceq R (crn (cmpt y1 Y (cfv (co A2 (cv y1) M) N))) $ >
  $ wceq S (cinf R cr clt) $ >
  $ wi ph (wf cn Y F) $ >
  $ wi (wa ph (wcel (cv n) cn)) (wbr (co (co A2 (cfv (cv n) F) D) c2 cexp) (co (co S c2 cexp) (co c1 (cv n) cdiv) caddc) cle) $ >
  $ wi ph (wcel S cr) $;

--| Lemma for ~ minveco . The convergent point of the Cauchy sequence ` F ` attains the minimum distance, and so is closer to ` A ` than any other point in ` Y ` . (Contributed by Mario Carneiro, 7-May-2014.) (Revised by AV, 4-Oct-2020.) (New usage is discouraged.)
theorem minvecolem4 {x3 y1 n: setvar} (ph: wff) (A2 D: class) (R: class y1 n) (S: class) (T: class x3 y1) (U: class n) (F J: class) (M N W: class n) (X: class y1) (Y: class):
  $ wceq X (cfv U cba) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq Y (cfv W cba) $ >
  $ wi ph (wcel U ccphlo) $ >
  $ wi ph (wcel W (cin (cfv U css) ccbn)) $ >
  $ wi ph (wcel A2 X) $ >
  $ wceq D (cfv U cims) $ >
  $ wceq J (cfv D cmopn) $ >
  $ wceq R (crn (cmpt y1 Y (cfv (co A2 (cv y1) M) N))) $ >
  $ wceq S (cinf R cr clt) $ >
  $ wi ph (wf cn Y F) $ >
  $ wi (wa ph (wcel (cv n) cn)) (wbr (co (co A2 (cfv (cv n) F) D) c2 cexp) (co (co S c2 cexp) (co c1 (cv n) cdiv) caddc) cle) $ >
  $ wceq T (co c1 (co (co (co (co (co A2 (cfv F (cfv J clm)) D) S caddc) c2 cdiv) c2 cexp) (co S c2 cexp) cmin) cdiv) $ >
  $ wi ph (wrex x3 (wral y1 (wbr (cfv (co A2 (cv x3) M) N) (cfv (co A2 (cv y1) M) N) cle) Y) Y) $;

--| Lemma for ~ minveco . Discharge the assumption about the sequence ` F ` by applying countable choice ~ ax-cc . (Contributed by Mario Carneiro, 9-May-2014.) (Revised by AV, 4-Oct-2020.) (New usage is discouraged.)
theorem minvecolem5 {x3 y1: setvar} (ph: wff) (A2 D: class) (R: class y1) (S U J M N W: class) (X: class y1) (Y: class):
  $ wceq X (cfv U cba) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq Y (cfv W cba) $ >
  $ wi ph (wcel U ccphlo) $ >
  $ wi ph (wcel W (cin (cfv U css) ccbn)) $ >
  $ wi ph (wcel A2 X) $ >
  $ wceq D (cfv U cims) $ >
  $ wceq J (cfv D cmopn) $ >
  $ wceq R (crn (cmpt y1 Y (cfv (co A2 (cv y1) M) N))) $ >
  $ wceq S (cinf R cr clt) $ >
  $ wi ph (wrex x3 (wral y1 (wbr (cfv (co A2 (cv x3) M) N) (cfv (co A2 (cv y1) M) N) cle) Y) Y) $;

--| Lemma for ~ minveco . Any minimal point is less than ` S ` away from ` A ` . (Contributed by Mario Carneiro, 9-May-2014.) (Revised by AV, 4-Oct-2020.) (New usage is discouraged.)
theorem minvecolem6 {x3 y1: setvar} (ph: wff) (A2 D: class) (R: class y1) (S U J M N W: class) (X: class y1) (Y: class):
  $ wceq X (cfv U cba) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq Y (cfv W cba) $ >
  $ wi ph (wcel U ccphlo) $ >
  $ wi ph (wcel W (cin (cfv U css) ccbn)) $ >
  $ wi ph (wcel A2 X) $ >
  $ wceq D (cfv U cims) $ >
  $ wceq J (cfv D cmopn) $ >
  $ wceq R (crn (cmpt y1 Y (cfv (co A2 (cv y1) M) N))) $ >
  $ wceq S (cinf R cr clt) $ >
  $ wi (wa ph (wcel (cv x3) Y)) (wb (wbr (co (co A2 (cv x3) D) c2 cexp) (co (co S c2 cexp) cc0 caddc) cle) (wral y1 (wbr (cfv (co A2 (cv x3) M) N) (cfv (co A2 (cv y1) M) N) cle) Y)) $;

--| Lemma for ~ minveco . Since any two minimal points are distance zero away from each other, the minimal point is unique. (Contributed by Mario Carneiro, 9-May-2014.) (New usage is discouraged.)
theorem minvecolem7 {x3 y1: setvar} (ph: wff) (A2 D: class) (R: class y1) (S U J M N W: class) (X: class y1) (Y: class):
  $ wceq X (cfv U cba) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq Y (cfv W cba) $ >
  $ wi ph (wcel U ccphlo) $ >
  $ wi ph (wcel W (cin (cfv U css) ccbn)) $ >
  $ wi ph (wcel A2 X) $ >
  $ wceq D (cfv U cims) $ >
  $ wceq J (cfv D cmopn) $ >
  $ wceq R (crn (cmpt y1 Y (cfv (co A2 (cv y1) M) N))) $ >
  $ wceq S (cinf R cr clt) $ >
  $ wi ph (wreu x3 (wral y1 (wbr (cfv (co A2 (cv x3) M) N) (cfv (co A2 (cv y1) M) N) cle) Y) Y) $;

--| Minimizing vector theorem, or the Hilbert projection theorem. There is exactly one vector in a complete subspace ` W ` that minimizes the distance to an arbitrary vector ` A ` in a parent inner product space. Theorem 3.3-1 of [Kreyszig] p. 144, specialized to subspaces instead of convex subsets. (Contributed by NM, 11-Apr-2008.) (Proof shortened by Mario Carneiro, 9-May-2014.) (New usage is discouraged.)
theorem minveco {x3 y1: setvar} (ph: wff) (A2 U M N W: class) (X: class y1) (Y: class):
  $ wceq X (cfv U cba) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wceq Y (cfv W cba) $ >
  $ wi ph (wcel U ccphlo) $ >
  $ wi ph (wcel W (cin (cfv U css) ccbn)) $ >
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wreu x3 (wral y1 (wbr (cfv (co A2 (cv x3) M) N) (cfv (co A2 (cv y1) M) N) cle) Y) Y) $;

--| Extend class notation with the class of all complex Hilbert spaces.
term chlo: class;

--| Define the class of all complex Hilbert spaces. A Hilbert space is a Banach space which is also an inner product space. (Contributed by Steve Rodriguez, 28-Apr-2007.) (New usage is discouraged.)
axiom df_hlo:
  $ wceq chlo (cin ccbn ccphlo) $;

--| The predicate "is a complex Hilbert space." A Hilbert space is a Banach space which is also an inner product space, i.e. whose norm satisfies the parallelogram law. (Contributed by Steve Rodriguez, 28-Apr-2007.) (New usage is discouraged.)
theorem ishlo (U: class):
  $ wb (wcel U chlo) (wa (wcel U ccbn) (wcel U ccphlo)) $;

--| Every complex Hilbert space is a complex Banach space. (Contributed by Steve Rodriguez, 28-Apr-2007.) (New usage is discouraged.)
theorem hlobn (U: class):
  $ wi (wcel U chlo) (wcel U ccbn) $;

--| Every complex Hilbert space is an inner product space (also called a pre-Hilbert space). (Contributed by NM, 28-Apr-2007.) (New usage is discouraged.)
theorem hlph (U: class):
  $ wi (wcel U chlo) (wcel U ccphlo) $;

--| The class of all complex Hilbert spaces is a relation. (Contributed by NM, 17-Mar-2007.) (New usage is discouraged.)
theorem hlrel:
  $ wrel chlo $;

--| Every complex Hilbert space is a normed complex vector space. (Contributed by NM, 17-Mar-2007.) (New usage is discouraged.)
theorem hlnv (U: class):
  $ wi (wcel U chlo) (wcel U cnv) $;

--| Every complex Hilbert space is a normed complex vector space. (Contributed by NM, 6-Jun-2008.) (New usage is discouraged.)
theorem hlnvi (U: class):
  $ wcel U chlo $ >
  $ wcel U cnv $;

--| Every complex Hilbert space is a complex vector space. (Contributed by NM, 7-Sep-2007.) (New usage is discouraged.)
theorem hlvc (U W: class):
  $ wceq W (cfv U c1st) $ >
  $ wi (wcel U chlo) (wcel W cvc) $;

--| The induced metric on a complex Hilbert space is complete. (Contributed by NM, 8-Sep-2007.) (New usage is discouraged.)
theorem hlcmet (D U X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq D (cfv U cims) $ >
  $ wi (wcel U chlo) (wcel D (cfv X ccmet)) $;

--| The induced metric on a complex Hilbert space. (Contributed by NM, 7-Sep-2007.) (New usage is discouraged.)
theorem hlmet (D U X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq D (cfv U cims) $ >
  $ wi (wcel U chlo) (wcel D (cfv X cmet)) $;

--| The parallelogram law satisfied by Hilbert space vectors. (Contributed by Steve Rodriguez, 28-Apr-2007.) (New usage is discouraged.)
theorem hlpar2 (A2 B2 U G M N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq M (cfv U cnsb) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wi (w3a (wcel U chlo) (wcel A2 X) (wcel B2 X)) (wceq (co (co (cfv (co A2 B2 G) N) c2 cexp) (co (cfv (co A2 B2 M) N) c2 cexp) caddc) (co c2 (co (co (cfv A2 N) c2 cexp) (co (cfv B2 N) c2 cexp) caddc) cmul)) $;

--| The parallelogram law satisfied by Hilbert space vectors. (Contributed by Steve Rodriguez, 28-Apr-2007.) (New usage is discouraged.)
theorem hlpar (A2 B2 S U G N X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wi (w3a (wcel U chlo) (wcel A2 X) (wcel B2 X)) (wceq (co (co (cfv (co A2 B2 G) N) c2 cexp) (co (cfv (co A2 (co (cneg c1) B2 S) G) N) c2 cexp) caddc) (co c2 (co (co (cfv A2 N) c2 cexp) (co (cfv B2 N) c2 cexp) caddc) cmul)) $;

--| The base set of a Hilbert space is a set. (Contributed by NM, 7-Sep-2007.) (New usage is discouraged.)
theorem hlex (U X: class):
  $ wceq X (cfv U cba) $ >
  $ wcel X cvv $;

--| Mapping for Hilbert space vector addition. (Contributed by NM, 7-Sep-2007.) (New usage is discouraged.)
theorem hladdf (U G X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wi (wcel U chlo) (wf (cxp X X) X G) $;

--| Hilbert space vector addition is commutative. (Contributed by NM, 7-Sep-2007.) (New usage is discouraged.)
theorem hlcom (A2 B2 U G X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wi (w3a (wcel U chlo) (wcel A2 X) (wcel B2 X)) (wceq (co A2 B2 G) (co B2 A2 G)) $;

--| Hilbert space vector addition is associative. (Contributed by NM, 7-Sep-2007.) (New usage is discouraged.)
theorem hlass (A2 B2 C U G X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wi (wa (wcel U chlo) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wceq (co (co A2 B2 G) C G) (co A2 (co B2 C G) G)) $;

--| The Hilbert space zero vector. (Contributed by NM, 7-Sep-2007.) (New usage is discouraged.)
theorem hl0cl (U X Z: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Z (cfv U cn0v) $ >
  $ wi (wcel U chlo) (wcel Z X) $;

--| Hilbert space addition with the zero vector. (Contributed by NM, 7-Sep-2007.) (New usage is discouraged.)
theorem hladdid (A2 U G X Z: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq Z (cfv U cn0v) $ >
  $ wi (wa (wcel U chlo) (wcel A2 X)) (wceq (co A2 Z G) A2) $;

--| Mapping for Hilbert space scalar multiplication. (Contributed by NM, 7-Sep-2007.) (New usage is discouraged.)
theorem hlmulf (S U X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq S (cfv U cns) $ >
  $ wi (wcel U chlo) (wf (cxp cc X) X S) $;

--| Hilbert space scalar multiplication by one. (Contributed by NM, 7-Sep-2007.) (New usage is discouraged.)
theorem hlmulid (A2 S U X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq S (cfv U cns) $ >
  $ wi (wa (wcel U chlo) (wcel A2 X)) (wceq (co c1 A2 S) A2) $;

--| Hilbert space scalar multiplication associative law. (Contributed by NM, 7-Sep-2007.) (New usage is discouraged.)
theorem hlmulass (A2 B2 C S U X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq S (cfv U cns) $ >
  $ wi (wa (wcel U chlo) (w3a (wcel A2 cc) (wcel B2 cc) (wcel C X))) (wceq (co (co A2 B2 cmul) C S) (co A2 (co B2 C S) S)) $;

--| Hilbert space scalar multiplication distributive law. (Contributed by NM, 7-Sep-2007.) (New usage is discouraged.)
theorem hldi (A2 B2 C S U G X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wi (wa (wcel U chlo) (w3a (wcel A2 cc) (wcel B2 X) (wcel C X))) (wceq (co A2 (co B2 C G) S) (co (co A2 B2 S) (co A2 C S) G)) $;

--| Hilbert space scalar multiplication distributive law. (Contributed by NM, 7-Sep-2007.) (New usage is discouraged.)
theorem hldir (A2 B2 C S U G X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq S (cfv U cns) $ >
  $ wi (wa (wcel U chlo) (w3a (wcel A2 cc) (wcel B2 cc) (wcel C X))) (wceq (co (co A2 B2 caddc) C S) (co (co A2 C S) (co B2 C S) G)) $;

--| Hilbert space scalar multiplication by zero. (Contributed by NM, 7-Sep-2007.) (New usage is discouraged.)
theorem hlmul0 (A2 S U X Z: class):
  $ wceq X (cfv U cba) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq Z (cfv U cn0v) $ >
  $ wi (wa (wcel U chlo) (wcel A2 X)) (wceq (co cc0 A2 S) Z) $;

--| Mapping for Hilbert space inner product. (Contributed by NM, 19-Nov-2007.) (New usage is discouraged.)
theorem hlipf (P U X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq P (cfv U cdip) $ >
  $ wi (wcel U chlo) (wf (cxp X X) cc P) $;

--| Conjugate law for Hilbert space inner product. (Contributed by NM, 8-Sep-2007.) (New usage is discouraged.)
theorem hlipcj (A2 B2 P U X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq P (cfv U cdip) $ >
  $ wi (w3a (wcel U chlo) (wcel A2 X) (wcel B2 X)) (wceq (co A2 B2 P) (cfv (co B2 A2 P) ccj)) $;

--| Distributive law for Hilbert space inner product. (Contributed by NM, 8-Sep-2007.) (New usage is discouraged.)
theorem hlipdir (A2 B2 C P U G X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq G (cfv U cpv) $ >
  $ wceq P (cfv U cdip) $ >
  $ wi (wa (wcel U chlo) (w3a (wcel A2 X) (wcel B2 X) (wcel C X))) (wceq (co (co A2 B2 G) C P) (co (co A2 C P) (co B2 C P) caddc)) $;

--| Associative law for Hilbert space inner product. (Contributed by NM, 8-Sep-2007.) (New usage is discouraged.)
theorem hlipass (A2 B2 C P S U X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq S (cfv U cns) $ >
  $ wceq P (cfv U cdip) $ >
  $ wi (wa (wcel U chlo) (w3a (wcel A2 cc) (wcel B2 X) (wcel C X))) (wceq (co (co A2 B2 S) C P) (co A2 (co B2 C P) cmul)) $;

--| The inner product of a Hilbert space vector by itself is positive. (Contributed by NM, 8-Sep-2007.) (New usage is discouraged.)
theorem hlipgt0 (A2 P U X Z: class):
  $ wceq X (cfv U cba) $ >
  $ wceq Z (cfv U cn0v) $ >
  $ wceq P (cfv U cdip) $ >
  $ wi (w3a (wcel U chlo) (wcel A2 X) (wne A2 Z)) (wbr cc0 (co A2 A2 P) clt) $;

--| Completeness of a Hilbert space. (Contributed by NM, 8-Sep-2007.) (Revised by Mario Carneiro, 9-May-2014.) (New usage is discouraged.)
theorem hlcompl (D U F J: class):
  $ wceq D (cfv U cims) $ >
  $ wceq J (cfv D cmopn) $ >
  $ wi (wa (wcel U chlo) (wcel F (cfv D ccau))) (wcel F (cdm (cfv J clm))) $;

--| The set of complex numbers is a complex Hilbert space. (Contributed by Steve Rodriguez, 28-Apr-2007.) (New usage is discouraged.)
theorem cnchl (U: class):
  $ wceq U (cop (cop caddc cmul) cabs) $ >
  $ wcel U chlo $;

--| Lemma for ~ htth . The collection ` K ` , which consists of functions ` F ( z ) ( w ) = <. w | T ( z ) >. = <. T ( w ) | z >. ` for each ` z ` in the unit ball, is a collection of bounded linear functions by ~ ipblnfi , so by the Uniform Boundedness theorem ~ ubth , there is a uniform bound ` y ` on ` || F ( x ) || ` for all ` x ` in the unit ball. Then ` | T ( x ) | ^ 2 = <. T ( x ) | T ( x ) >. = F ( x ) ( ` ` T ( x ) ) <_ y | T ( x ) | ` , so ` | T ( x ) | <_ y ` and ` T ` is bounded. (Contributed by NM, 11-Jan-2008.) (Revised by Mario Carneiro, 23-Aug-2014.) (New usage is discouraged.)
theorem htthlem {x3 y1 z w: setvar} (ph: wff) (B2: class x3 y1 z w) (P: class x3 y1) (T U: class) (F: class x3 z) (K: class) (L: class x3 y1 z w) (N W X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq P (cfv U cdip) $ >
  $ wceq L (co U U clno) $ >
  $ wceq B2 (co U U cblo) $ >
  $ wceq N (cfv U cnmcv) $ >
  $ wcel U chlo $ >
  $ wceq W (cop (cop caddc cmul) cabs) $ >
  $ wi ph (wcel T L) $ >
  $ wi ph (wral x3 (wral y1 (wceq (co (cv x3) (cfv (cv y1) T) P) (co (cfv (cv x3) T) (cv y1) P)) X) X) $ >
  $ wceq F (cmpt z X (cmpt w X (co (cv w) (cfv (cv z) T) P))) $ >
  $ wceq K (cima F (crab z (wbr (cfv (cv z) N) c1 cle) X)) $ >
  $ wi ph (wcel T B2) $;

--| Hellinger-Toeplitz Theorem: any self-adjoint linear operator defined on all of Hilbert space is bounded. Theorem 10.1-1 of [Kreyszig] p. 525. Discovered by E. Hellinger and O. Toeplitz in 1910, "it aroused both admiration and puzzlement since the theorem establishes a relation between properties of two different kinds, namely, the properties of being defined everywhere and being bounded." (Contributed by NM, 11-Jan-2008.) (Revised by Mario Carneiro, 23-Aug-2014.) (New usage is discouraged.)
theorem htth {x3 y1: setvar} (B2 P: class x3 y1) (T U: class) (L: class x3 y1) (X: class):
  $ wceq X (cfv U cba) $ >
  $ wceq P (cfv U cdip) $ >
  $ wceq L (co U U clno) $ >
  $ wceq B2 (co U U cblo) $ >
  $ wi (w3a (wcel U chlo) (wcel T L) (wral x3 (wral y1 (wceq (co (cv x3) (cfv (cv y1) T) P) (co (cfv (cv x3) T) (cv y1) P)) X) X)) (wcel T B2) $;

--| Extend class notation with Hilbert vector space.
term chba: class;

--| Extend class notation with vector addition in Hilbert space. In the literature, the subscript "h" is omitted, but we need it to avoid ambiguity with complex number addition ` + ` ~ caddc .
term cva: class;

--| Extend class notation with scalar multiplication in Hilbert space. In the literature scalar multiplication is usually indicated by juxtaposition, but we need an explicit symbol to prevent ambiguity.
term csm: class;

--| Extend class notation with inner (scalar) product in Hilbert space. In the literature, the inner product of ` A ` and ` B ` is usually written ` <. A , B >. ` but our operation notation allows to use existing theorems about operations and also eliminates ambiguity with the definition of an ordered pair ~ df-op .
term csp: class;

--| Extend class notation with the norm function in Hilbert space. In the literature, the norm of ` A ` is usually written "|| ` A ` ||", but we use function notation to take advantage of our existing theorems about functions.
term cno: class;

--| Extend class notation with zero vector in Hilbert space.
term c0v: class;

--| Extend class notation with vector subtraction in Hilbert space.
term cmv: class;

--| Extend class notation with set of Cauchy sequences in Hilbert space.
term ccauold: class;

--| Extend class notation with convergence relation in Hilbert space.
term chli: class;

--| Extend class notation with set of subspaces of a Hilbert space.
term csh: class;

--| Extend class notation with set of closed subspaces of a Hilbert space.
term cch: class;

--| Extend class notation with orthogonal complement in ` CH ` .
term cort: class;

--| Extend class notation with subspace sum in ` CH ` .
term cph: class;

--| Extend class notation with subspace span in ` CH ` .
term cspn: class;

--| Extend class notation with join in ` CH ` .
term chj: class;

--| Extend class notation with supremum of a collection in ` CH ` .
term chsup: class;

--| Extend class notation with zero of ` CH ` .
term c0h: class;

--| Extend class notation with the commutes relation on a Hilbert lattice.
term ccm: class;

--| Extend class notation with set of projections on a Hilbert space.
term cpjh: class;

--| Extend class notation with sum of Hilbert space operators.
term chos: class;

--| Extend class notation with scalar product of a Hilbert space operator.
term chot: class;

--| Extend class notation with difference of Hilbert space operators.
term chod: class;

--| Extend class notation with sum of Hilbert space functionals.
term chfs: class;

--| Extend class notation with scalar product of Hilbert space functional.
term chft: class;

--| Extend class notation with the Hilbert space zero operator.
term ch0o: class;

--| Extend class notation with Hilbert space identity operator.
term chio: class;

--| Extend class notation with the operator norm function.
term cnop: class;

--| Extend class notation with set of continuous Hilbert space operators.
term ccop: class;

--| Extend class notation with set of linear Hilbert space operators.
term clo: class;

--| Extend class notation with set of bounded linear operators.
term cbo: class;

--| Extend class notation with set of unitary Hilbert space operators.
term cuo: class;

--| Extend class notation with set of Hermitian Hilbert space operators.
term cho: class;

--| Extend class notation with the functional norm function.
term cnmf: class;

--| Extend class notation with the functional nullspace function.
term cnl: class;

--| Extend class notation with set of continuous Hilbert space functionals.
term ccnfn: class;

--| Extend class notation with set of linear Hilbert space functionals.
term clf: class;

--| Extend class notation with Hilbert space adjoint function.
term cado: class;

--| Extend class notation with the bra of a vector in Dirac bra-ket notation.
term cbr: class;

--| Extend class notation with the outer product of two vectors in Dirac bra-ket notation.
term ck: class;

--| Extend class notation with positive operator ordering.
term cleo: class;

--| Extend class notation with Hilbert space eigenvector function.
term cei: class;

--| Extend class notation with Hilbert space eigenvalue function.
term cel: class;

--| Extend class notation with the spectrum of an operator.
term cspc: class;

--| Extend class notation with set of states on a Hilbert lattice.
term cst: class;

--| Extend class notation with set of Hilbert-space-valued states on a Hilbert lattice.
term chst: class;

--| Extend class notation with the covers relation on a Hilbert lattice.
term ccv: class;

--| Extend class notation with set of atoms on a Hilbert lattice.
term cat: class;

--| Extend class notation with the modular pair relation on a Hilbert lattice.
term cmd: class;

--| Extend class notation with the dual modular pair relation on a Hilbert lattice.
term cdmd: class;

--| Define the function for the norm of a vector of Hilbert space. See ~ normval for its value and ~ normcl for its closure. Theorems ~ norm-i-i , ~ norm-ii-i , and ~ norm-iii-i show it has the expected properties of a norm. In the literature, the norm of ` A ` is usually written "|| ` A ` ||", but we use function notation to take advantage of our existing theorems about functions. Definition of norm in [Beran] p. 96. (Contributed by NM, 6-Jun-2008.) (New usage is discouraged.)
axiom df_hnorm {x3: setvar}:
  $ wceq cno (cmpt x3 (cdm (cdm csp)) (cfv (co (cv x3) (cv x3) csp) csqrt)) $;

--| Define base set of Hilbert space, for use if we want to develop Hilbert space independently from the axioms (see comments in ~ ax-hilex ). Note that ` ~H ` is considered a primitive in the Hilbert space axioms below, and we don't use this definition outside of this section. This definition can be proved independently from those axioms as Theorem ~ hhba . (Contributed by NM, 31-May-2008.) (New usage is discouraged.)
axiom df_hba:
  $ wceq chba (cfv (cop (cop cva csm) cno) cba) $;

--| Define the zero vector of Hilbert space. Note that ` 0vec ` is considered a primitive in the Hilbert space axioms below, and we don't use this definition outside of this section. It is proved from the axioms as Theorem ~ hh0v . (Contributed by NM, 31-May-2008.) (New usage is discouraged.)
axiom df_h0v:
  $ wceq c0v (cfv (cop (cop cva csm) cno) cn0v) $;

--| Define vector subtraction. See ~ hvsubvali for its value and ~ hvsubcli for its closure. (Contributed by NM, 6-Jun-2008.) (New usage is discouraged.)
axiom df_hvsub {x3 y1: setvar}:
  $ wceq cmv (cmpo x3 y1 chba chba (co (cv x3) (co (cneg c1) (cv y1) csm) cva)) $;

--| Define the limit relation for Hilbert space. See ~ hlimi for its relational expression. Note that ` f : NN --> ~H ` is an infinite sequence of vectors, i.e. a mapping from integers to vectors. Definition of converge in [Beran] p. 96. (Contributed by NM, 6-Jun-2008.) (New usage is discouraged.)
axiom df_hlim {x3 y1 z w f2: setvar}:
  $ wceq chli (copab f2 w (wa (wa (wf cn chba (cv f2)) (wcel (cv w) chba)) (wral x3 (wrex y1 (wral z (wbr (cfv (co (cfv (cv z) (cv f2)) (cv w) cmv) cno) (cv x3) clt) (cfv (cv y1) cuz)) cn) crp))) $;

--| Define the set of Cauchy sequences on a Hilbert space. See ~ hcau for its membership relation. Note that ` f : NN --> ~H ` is an infinite sequence of vectors, i.e. a mapping from integers to vectors. Definition of Cauchy sequence in [Beran] p. 96. (Contributed by NM, 6-Jun-2008.) (New usage is discouraged.)
axiom df_hcau {x3 y1 z f2: setvar}:
  $ wceq ccauold (crab f2 (wral x3 (wrex y1 (wral z (wbr (cfv (co (cfv (cv y1) (cv f2)) (cfv (cv z) (cv f2)) cmv) cno) (cv x3) clt) (cfv (cv y1) cuz)) cn) crp) (co chba cn cmap)) $;

--| The group (addition) operation of Hilbert space. (Contributed by NM, 31-May-2008.) (New usage is discouraged.)
theorem h2hva (U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wcel U cnv $ >
  $ wceq cva (cfv U cpv) $;

--| The scalar product operation of Hilbert space. (Contributed by NM, 31-May-2008.) (New usage is discouraged.)
theorem h2hsm (U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wcel U cnv $ >
  $ wceq csm (cfv U cns) $;

--| The norm function of Hilbert space. (Contributed by NM, 5-Jun-2008.) (New usage is discouraged.)
theorem h2hnm (U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wcel U cnv $ >
  $ wceq cno (cfv U cnmcv) $;

--| The vector subtraction operation of Hilbert space. (Contributed by NM, 6-Jun-2008.) (Revised by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem h2hvs (U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wcel U cnv $ >
  $ wceq chba (cfv U cba) $ >
  $ wceq cmv (cfv U cnsb) $;

--| Value of the distance function of the metric space of Hilbert space. (Contributed by NM, 6-Jun-2008.) (New usage is discouraged.)
theorem h2hmetdval (A2 B2 D U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wcel U cnv $ >
  $ wceq chba (cfv U cba) $ >
  $ wceq D (cfv U cims) $ >
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wceq (co A2 B2 D) (cfv (co A2 B2 cmv) cno)) $;

--| The Cauchy sequences of Hilbert space. (Contributed by NM, 6-Jun-2008.) (Revised by Mario Carneiro, 13-May-2014.) (New usage is discouraged.)
theorem h2hcau (D U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wcel U cnv $ >
  $ wceq chba (cfv U cba) $ >
  $ wceq D (cfv U cims) $ >
  $ wceq ccauold (cin (cfv D ccau) (co chba cn cmap)) $;

--| The limit sequences of Hilbert space. (Contributed by NM, 6-Jun-2008.) (Revised by Mario Carneiro, 13-May-2014.) (Proof shortened by Peter Mazsa, 2-Oct-2022.) (New usage is discouraged.)
theorem h2hlm (D U J: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wcel U cnv $ >
  $ wceq chba (cfv U cba) $ >
  $ wceq D (cfv U cims) $ >
  $ wceq J (cfv D cmopn) $ >
  $ wceq chli (cres (cfv J clm) (co chba cn cmap)) $;

--| Derive Axiom ~ ax-hilex from Hilbert space under ZF set theory. (Contributed by NM, 31-May-2008.) (New usage is discouraged.)
theorem axhilex_zf (U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wcel U chlo $ >
  $ wcel chba cvv $;

--| Derive Axiom ~ ax-hfvadd from Hilbert space under ZF set theory. (Contributed by NM, 31-May-2008.) (New usage is discouraged.)
theorem axhfvadd_zf (U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wcel U chlo $ >
  $ wf (cxp chba chba) chba cva $;

--| Derive Axiom ~ ax-hvcom from Hilbert space under ZF set theory. (Contributed by NM, 27-May-2008.) (New usage is discouraged.)
theorem axhvcom_zf (A2 B2 U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wcel U chlo $ >
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wceq (co A2 B2 cva) (co B2 A2 cva)) $;

--| Derive Axiom ~ ax-hvass from Hilbert space under ZF set theory. (Contributed by NM, 31-May-2008.) (New usage is discouraged.)
theorem axhvass_zf (A2 B2 C U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wcel U chlo $ >
  $ wi (w3a (wcel A2 chba) (wcel B2 chba) (wcel C chba)) (wceq (co (co A2 B2 cva) C cva) (co A2 (co B2 C cva) cva)) $;

--| Derive Axiom ~ ax-hv0cl from Hilbert space under ZF set theory. (Contributed by NM, 31-May-2008.) (New usage is discouraged.)
theorem axhv0cl_zf (U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wcel U chlo $ >
  $ wcel c0v chba $;

--| Derive Axiom ~ ax-hvaddid from Hilbert space under ZF set theory. (Contributed by NM, 31-May-2008.) (New usage is discouraged.)
theorem axhvaddid_zf (A2 U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wcel U chlo $ >
  $ wi (wcel A2 chba) (wceq (co A2 c0v cva) A2) $;

--| Derive Axiom ~ ax-hfvmul from Hilbert space under ZF set theory. (Contributed by NM, 31-May-2008.) (New usage is discouraged.)
theorem axhfvmul_zf (U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wcel U chlo $ >
  $ wf (cxp cc chba) chba csm $;

--| Derive Axiom ~ ax-hvmulid from Hilbert space under ZF set theory. (Contributed by NM, 31-May-2008.) (New usage is discouraged.)
theorem axhvmulid_zf (A2 U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wcel U chlo $ >
  $ wi (wcel A2 chba) (wceq (co c1 A2 csm) A2) $;

--| Derive Axiom ~ ax-hvmulass from Hilbert space under ZF set theory. (Contributed by NM, 31-May-2008.) (New usage is discouraged.)
theorem axhvmulass_zf (A2 B2 C U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wcel U chlo $ >
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C chba)) (wceq (co (co A2 B2 cmul) C csm) (co A2 (co B2 C csm) csm)) $;

--| Derive Axiom ~ ax-hvdistr1 from Hilbert space under ZF set theory. (Contributed by NM, 31-May-2008.) (New usage is discouraged.)
theorem axhvdistr1_zf (A2 B2 C U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wcel U chlo $ >
  $ wi (w3a (wcel A2 cc) (wcel B2 chba) (wcel C chba)) (wceq (co A2 (co B2 C cva) csm) (co (co A2 B2 csm) (co A2 C csm) cva)) $;

--| Derive Axiom ~ ax-hvdistr2 from Hilbert space under ZF set theory. (Contributed by NM, 31-May-2008.) (New usage is discouraged.)
theorem axhvdistr2_zf (A2 B2 C U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wcel U chlo $ >
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C chba)) (wceq (co (co A2 B2 caddc) C csm) (co (co A2 C csm) (co B2 C csm) cva)) $;

--| Derive Axiom ~ ax-hvmul0 from Hilbert space under ZF set theory. (Contributed by NM, 31-May-2008.) (New usage is discouraged.)
theorem axhvmul0_zf (A2 U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wcel U chlo $ >
  $ wi (wcel A2 chba) (wceq (co cc0 A2 csm) c0v) $;

--| Derive Axiom ~ ax-hfi from Hilbert space under ZF set theory. (Contributed by NM, 31-May-2008.) (New usage is discouraged.)
theorem axhfi_zf (U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wcel U chlo $ >
  $ wceq csp (cfv U cdip) $ >
  $ wf (cxp chba chba) cc csp $;

--| Derive Axiom ~ ax-his1 from Hilbert space under ZF set theory. (Contributed by NM, 31-May-2008.) (New usage is discouraged.)
theorem axhis1_zf (A2 B2 U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wcel U chlo $ >
  $ wceq csp (cfv U cdip) $ >
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wceq (co A2 B2 csp) (cfv (co B2 A2 csp) ccj)) $;

--| Derive Axiom ~ ax-his2 from Hilbert space under ZF set theory. (Contributed by NM, 31-May-2008.) (New usage is discouraged.)
theorem axhis2_zf (A2 B2 C U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wcel U chlo $ >
  $ wceq csp (cfv U cdip) $ >
  $ wi (w3a (wcel A2 chba) (wcel B2 chba) (wcel C chba)) (wceq (co (co A2 B2 cva) C csp) (co (co A2 C csp) (co B2 C csp) caddc)) $;

--| Derive Axiom ~ ax-his3 from Hilbert space under ZF set theory. (Contributed by NM, 31-May-2008.) (New usage is discouraged.)
theorem axhis3_zf (A2 B2 C U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wcel U chlo $ >
  $ wceq csp (cfv U cdip) $ >
  $ wi (w3a (wcel A2 cc) (wcel B2 chba) (wcel C chba)) (wceq (co (co A2 B2 csm) C csp) (co A2 (co B2 C csp) cmul)) $;

--| Derive Axiom ~ ax-his4 from Hilbert space under ZF set theory. (Contributed by NM, 31-May-2008.) (New usage is discouraged.)
theorem axhis4_zf (A2 U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wcel U chlo $ >
  $ wceq csp (cfv U cdip) $ >
  $ wi (wa (wcel A2 chba) (wne A2 c0v)) (wbr cc0 (co A2 A2 csp) clt) $;

--| Derive Axiom ~ ax-hcompl from Hilbert space under ZF set theory. (Contributed by NM, 6-Jun-2008.) (Revised by Mario Carneiro, 13-May-2014.) (Proof shortened by Peter Mazsa, 2-Oct-2022.) (New usage is discouraged.)
theorem axhcompl_zf {x3: setvar} (U F: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wcel U chlo $ >
  $ wi (wcel F ccauold) (wrex x3 (wbr F (cv x3) chli) chba) $;

--| This is our first axiom for a complex Hilbert space, which is the foundation for quantum mechanics and quantum field theory. We assume that there exists a primitive class, ` ~H ` , which contains objects called vectors. (Contributed by NM, 16-Aug-1999.) (New usage is discouraged.)
axiom ax_hilex:
  $ wcel chba cvv $;

--| Vector addition is an operation on ` ~H ` . (Contributed by NM, 16-Aug-1999.) (New usage is discouraged.)
axiom ax_hfvadd:
  $ wf (cxp chba chba) chba cva $;

--| Vector addition is commutative. (Contributed by NM, 3-Sep-1999.) (New usage is discouraged.)
axiom ax_hvcom (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wceq (co A2 B2 cva) (co B2 A2 cva)) $;

--| Vector addition is associative. (Contributed by NM, 3-Sep-1999.) (New usage is discouraged.)
axiom ax_hvass (A2 B2 C: class):
  $ wi (w3a (wcel A2 chba) (wcel B2 chba) (wcel C chba)) (wceq (co (co A2 B2 cva) C cva) (co A2 (co B2 C cva) cva)) $;

--| The zero vector is in the vector space. (Contributed by NM, 29-May-1999.) (New usage is discouraged.)
axiom ax_hv0cl:
  $ wcel c0v chba $;

--| Addition with the zero vector. (Contributed by NM, 16-Aug-1999.) (New usage is discouraged.)
axiom ax_hvaddid (A2: class):
  $ wi (wcel A2 chba) (wceq (co A2 c0v cva) A2) $;

--| Scalar multiplication is an operation on ` CC ` and ` ~H ` . (Contributed by NM, 16-Aug-1999.) (New usage is discouraged.)
axiom ax_hfvmul:
  $ wf (cxp cc chba) chba csm $;

--| Scalar multiplication by one. (Contributed by NM, 30-May-1999.) (New usage is discouraged.)
axiom ax_hvmulid (A2: class):
  $ wi (wcel A2 chba) (wceq (co c1 A2 csm) A2) $;

--| Scalar multiplication associative law. (Contributed by NM, 30-May-1999.) (New usage is discouraged.)
axiom ax_hvmulass (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C chba)) (wceq (co (co A2 B2 cmul) C csm) (co A2 (co B2 C csm) csm)) $;

--| Scalar multiplication distributive law. (Contributed by NM, 3-Sep-1999.) (New usage is discouraged.)
axiom ax_hvdistr1 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 chba) (wcel C chba)) (wceq (co A2 (co B2 C cva) csm) (co (co A2 B2 csm) (co A2 C csm) cva)) $;

--| Scalar multiplication distributive law. (Contributed by NM, 30-May-1999.) (New usage is discouraged.)
axiom ax_hvdistr2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C chba)) (wceq (co (co A2 B2 caddc) C csm) (co (co A2 C csm) (co B2 C csm) cva)) $;

--| Scalar multiplication by zero. We can derive the existence of the negative of a vector from this axiom (see ~ hvsubid and ~ hvsubval ). (Contributed by NM, 29-May-1999.) (New usage is discouraged.)
axiom ax_hvmul0 (A2: class):
  $ wi (wcel A2 chba) (wceq (co cc0 A2 csm) c0v) $;

--| The Hilbert space scalar product operation is a set. (Contributed by NM, 17-Apr-2007.) (New usage is discouraged.)
theorem hvmulex:
  $ wcel csm cvv $;

--| Closure of vector addition. (Contributed by NM, 18-Apr-2007.) (New usage is discouraged.)
theorem hvaddcl (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wcel (co A2 B2 cva) chba) $;

--| Closure of scalar multiplication. (Contributed by NM, 19-Apr-2007.) (New usage is discouraged.)
theorem hvmulcl (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 chba)) (wcel (co A2 B2 csm) chba) $;

--| Closure inference for scalar multiplication. (Contributed by NM, 1-Aug-1999.) (New usage is discouraged.)
theorem hvmulcli (A2 B2: class):
  $ wcel A2 cc $ >
  $ wcel B2 chba $ >
  $ wcel (co A2 B2 csm) chba $;

--| Mapping domain and codomain of vector subtraction. (Contributed by NM, 6-Sep-2007.) (New usage is discouraged.)
theorem hvsubf:
  $ wf (cxp chba chba) chba cmv $;

--| Value of vector subtraction. (Contributed by NM, 5-Sep-1999.) (Revised by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem hvsubval (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wceq (co A2 B2 cmv) (co A2 (co (cneg c1) B2 csm) cva)) $;

--| Closure of vector subtraction. (Contributed by NM, 17-Aug-1999.) (New usage is discouraged.)
theorem hvsubcl (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wcel (co A2 B2 cmv) chba) $;

--| Closure of vector addition. (Contributed by NM, 1-Aug-1999.) (New usage is discouraged.)
theorem hvaddcli (A2 B2: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wcel (co A2 B2 cva) chba $;

--| Commutation of vector addition. (Contributed by NM, 3-Sep-1999.) (New usage is discouraged.)
theorem hvcomi (A2 B2: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wceq (co A2 B2 cva) (co B2 A2 cva) $;

--| Value of vector subtraction definition. (Contributed by NM, 3-Sep-1999.) (New usage is discouraged.)
theorem hvsubvali (A2 B2: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wceq (co A2 B2 cmv) (co A2 (co (cneg c1) B2 csm) cva) $;

--| Closure of vector subtraction. (Contributed by NM, 2-Aug-1999.) (New usage is discouraged.)
theorem hvsubcli (A2 B2: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wcel (co A2 B2 cmv) chba $;

--| Prove ` if ( A e. ~H , A , 0h ) e. ~H ` . (Contributed by David A. Wheeler, 7-Dec-2018.) (New usage is discouraged.)
theorem ifhvhv0 (A2: class):
  $ wcel (cif (wcel A2 chba) A2 c0v) chba $;

--| Addition with the zero vector. (Contributed by NM, 18-Oct-1999.) (New usage is discouraged.)
theorem hvaddlid (A2: class):
  $ wi (wcel A2 chba) (wceq (co c0v A2 cva) A2) $;

--| Scalar multiplication with the zero vector. (Contributed by NM, 30-May-1999.) (New usage is discouraged.)
theorem hvmul0 (A2: class):
  $ wi (wcel A2 cc) (wceq (co A2 c0v csm) c0v) $;

--| If a scalar product is zero, one of its factors must be zero. (Contributed by NM, 19-May-2005.) (New usage is discouraged.)
theorem hvmul0or (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 chba)) (wb (wceq (co A2 B2 csm) c0v) (wo (wceq A2 cc0) (wceq B2 c0v))) $;

--| Subtraction of a vector from itself. (Contributed by NM, 30-May-1999.) (New usage is discouraged.)
theorem hvsubid (A2: class):
  $ wi (wcel A2 chba) (wceq (co A2 A2 cmv) c0v) $;

--| Addition of negative of a vector to itself. (Contributed by NM, 4-Jun-2004.) (New usage is discouraged.)
theorem hvnegid (A2: class):
  $ wi (wcel A2 chba) (wceq (co A2 (co (cneg c1) A2 csm) cva) c0v) $;

--| Two ways to express the negative of a vector. (Contributed by NM, 23-May-2005.) (New usage is discouraged.)
theorem hv2neg (A2: class):
  $ wi (wcel A2 chba) (wceq (co c0v A2 cmv) (co (cneg c1) A2 csm)) $;

--| Addition with the zero vector. (Contributed by NM, 18-Aug-1999.) (New usage is discouraged.)
theorem hvaddlidi (A2: class):
  $ wcel A2 chba $ >
  $ wceq (co c0v A2 cva) A2 $;

--| Addition of negative of a vector to itself. (Contributed by NM, 18-Aug-1999.) (New usage is discouraged.)
theorem hvnegidi (A2: class):
  $ wcel A2 chba $ >
  $ wceq (co A2 (co (cneg c1) A2 csm) cva) c0v $;

--| Two ways to express the negative of a vector. (Contributed by NM, 31-Oct-1999.) (New usage is discouraged.)
theorem hv2negi (A2: class):
  $ wcel A2 chba $ >
  $ wceq (co c0v A2 cmv) (co (cneg c1) A2 csm) $;

--| Convert minus one times a scalar product to the negative of the scalar. (Contributed by NM, 4-Jun-2004.) (New usage is discouraged.)
theorem hvm1neg (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 chba)) (wceq (co (cneg c1) (co A2 B2 csm) csm) (co (cneg A2) B2 csm)) $;

--| Value of vector addition in terms of vector subtraction. (Contributed by NM, 10-Jun-2006.) (New usage is discouraged.)
theorem hvaddsubval (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wceq (co A2 B2 cva) (co A2 (co (cneg c1) B2 csm) cmv)) $;

--| Commutative/associative law. (Contributed by NM, 16-Oct-1999.) (New usage is discouraged.)
theorem hvadd32 (A2 B2 C: class):
  $ wi (w3a (wcel A2 chba) (wcel B2 chba) (wcel C chba)) (wceq (co (co A2 B2 cva) C cva) (co (co A2 C cva) B2 cva)) $;

--| Commutative/associative law. (Contributed by NM, 19-Oct-1999.) (New usage is discouraged.)
theorem hvadd12 (A2 B2 C: class):
  $ wi (w3a (wcel A2 chba) (wcel B2 chba) (wcel C chba)) (wceq (co A2 (co B2 C cva) cva) (co B2 (co A2 C cva) cva)) $;

--| Hilbert vector space addition law. (Contributed by NM, 16-Oct-1999.) (New usage is discouraged.)
theorem hvadd4 (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 chba) (wcel B2 chba)) (wa (wcel C chba) (wcel D chba))) (wceq (co (co A2 B2 cva) (co C D cva) cva) (co (co A2 C cva) (co B2 D cva) cva)) $;

--| Hilbert vector space addition/subtraction law. (Contributed by NM, 17-Oct-1999.) (New usage is discouraged.)
theorem hvsub4 (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 chba) (wcel B2 chba)) (wa (wcel C chba) (wcel D chba))) (wceq (co (co A2 B2 cva) (co C D cva) cmv) (co (co A2 C cmv) (co B2 D cmv) cva)) $;

--| Commutative/associative law. (Contributed by NM, 19-Oct-1999.) (New usage is discouraged.)
theorem hvaddsub12 (A2 B2 C: class):
  $ wi (w3a (wcel A2 chba) (wcel B2 chba) (wcel C chba)) (wceq (co A2 (co B2 C cmv) cva) (co B2 (co A2 C cmv) cva)) $;

--| Addition/subtraction cancellation law for vectors in Hilbert space. (Contributed by NM, 7-Jun-2004.) (New usage is discouraged.)
theorem hvpncan (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wceq (co (co A2 B2 cva) B2 cmv) A2) $;

--| Addition/subtraction cancellation law for vectors in Hilbert space. (Contributed by NM, 7-Jun-2004.) (New usage is discouraged.)
theorem hvpncan2 (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wceq (co (co A2 B2 cva) A2 cmv) B2) $;

--| Associativity of sum and difference of Hilbert space vectors. (Contributed by NM, 27-Aug-2004.) (New usage is discouraged.)
theorem hvaddsubass (A2 B2 C: class):
  $ wi (w3a (wcel A2 chba) (wcel B2 chba) (wcel C chba)) (wceq (co (co A2 B2 cva) C cmv) (co A2 (co B2 C cmv) cva)) $;

--| Subtraction and addition of equal Hilbert space vectors. (Contributed by NM, 27-Aug-2004.) (New usage is discouraged.)
theorem hvpncan3 (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wceq (co A2 (co B2 A2 cmv) cva) B2) $;

--| Scalar multiplication commutative law. (Contributed by NM, 19-May-2005.) (New usage is discouraged.)
theorem hvmulcom (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C chba)) (wceq (co A2 (co B2 C csm) csm) (co B2 (co A2 C csm) csm)) $;

--| Hilbert vector space associative law for subtraction. (Contributed by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem hvsubass (A2 B2 C: class):
  $ wi (w3a (wcel A2 chba) (wcel B2 chba) (wcel C chba)) (wceq (co (co A2 B2 cmv) C cmv) (co A2 (co B2 C cva) cmv)) $;

--| Hilbert vector space commutative/associative law. (Contributed by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem hvsub32 (A2 B2 C: class):
  $ wi (w3a (wcel A2 chba) (wcel B2 chba) (wcel C chba)) (wceq (co (co A2 B2 cmv) C cmv) (co (co A2 C cmv) B2 cmv)) $;

--| Scalar multiplication associative law. (Contributed by NM, 3-Sep-1999.) (New usage is discouraged.)
theorem hvmulassi (A2 B2 C: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wcel C chba $ >
  $ wceq (co (co A2 B2 cmul) C csm) (co A2 (co B2 C csm) csm) $;

--| Scalar multiplication commutative law. (Contributed by NM, 3-Sep-1999.) (New usage is discouraged.)
theorem hvmulcomi (A2 B2 C: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wcel C chba $ >
  $ wceq (co A2 (co B2 C csm) csm) (co B2 (co A2 C csm) csm) $;

--| Double negative in scalar multiplication. (Contributed by NM, 3-Sep-1999.) (New usage is discouraged.)
theorem hvmul2negi (A2 B2 C: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wcel C chba $ >
  $ wceq (co (cneg A2) (co (cneg B2) C csm) csm) (co A2 (co B2 C csm) csm) $;

--| Scalar multiplication distributive law for subtraction. (Contributed by NM, 19-May-2005.) (New usage is discouraged.)
theorem hvsubdistr1 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 chba) (wcel C chba)) (wceq (co A2 (co B2 C cmv) csm) (co (co A2 B2 csm) (co A2 C csm) cmv)) $;

--| Scalar multiplication distributive law for subtraction. (Contributed by NM, 19-May-2005.) (New usage is discouraged.)
theorem hvsubdistr2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C chba)) (wceq (co (co A2 B2 cmin) C csm) (co (co A2 C csm) (co B2 C csm) cmv)) $;

--| Scalar multiplication distributive law. (Contributed by NM, 3-Sep-1999.) (New usage is discouraged.)
theorem hvdistr1i (A2 B2 C: class):
  $ wcel A2 cc $ >
  $ wcel B2 chba $ >
  $ wcel C chba $ >
  $ wceq (co A2 (co B2 C cva) csm) (co (co A2 B2 csm) (co A2 C csm) cva) $;

--| Scalar multiplication distributive law. (Contributed by NM, 3-Sep-1999.) (New usage is discouraged.)
theorem hvsubdistr1i (A2 B2 C: class):
  $ wcel A2 cc $ >
  $ wcel B2 chba $ >
  $ wcel C chba $ >
  $ wceq (co A2 (co B2 C cmv) csm) (co (co A2 B2 csm) (co A2 C csm) cmv) $;

--| Hilbert vector space associative law. (Contributed by NM, 3-Sep-1999.) (New usage is discouraged.)
theorem hvassi (A2 B2 C: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wcel C chba $ >
  $ wceq (co (co A2 B2 cva) C cva) (co A2 (co B2 C cva) cva) $;

--| Hilbert vector space commutative/associative law. (Contributed by NM, 18-Aug-1999.) (New usage is discouraged.)
theorem hvadd32i (A2 B2 C: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wcel C chba $ >
  $ wceq (co (co A2 B2 cva) C cva) (co (co A2 C cva) B2 cva) $;

--| Hilbert vector space associative law for subtraction. (Contributed by NM, 7-Oct-1999.) (Revised by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem hvsubassi (A2 B2 C: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wcel C chba $ >
  $ wceq (co (co A2 B2 cmv) C cmv) (co A2 (co B2 C cva) cmv) $;

--| Hilbert vector space commutative/associative law. (Contributed by NM, 7-Oct-1999.) (Revised by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem hvsub32i (A2 B2 C: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wcel C chba $ >
  $ wceq (co (co A2 B2 cmv) C cmv) (co (co A2 C cmv) B2 cmv) $;

--| Hilbert vector space commutative/associative law. (Contributed by NM, 11-Sep-1999.) (New usage is discouraged.)
theorem hvadd12i (A2 B2 C: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wcel C chba $ >
  $ wceq (co A2 (co B2 C cva) cva) (co B2 (co A2 C cva) cva) $;

--| Hilbert vector space addition law. (Contributed by NM, 3-Sep-1999.) (New usage is discouraged.)
theorem hvadd4i (A2 B2 C D: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wcel C chba $ >
  $ wcel D chba $ >
  $ wceq (co (co A2 B2 cva) (co C D cva) cva) (co (co A2 C cva) (co B2 D cva) cva) $;

--| Hilbert vector space addition law. (Contributed by NM, 31-Oct-1999.) (New usage is discouraged.)
theorem hvsubsub4i (A2 B2 C D: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wcel C chba $ >
  $ wcel D chba $ >
  $ wceq (co (co A2 B2 cmv) (co C D cmv) cmv) (co (co A2 C cmv) (co B2 D cmv) cmv) $;

--| Hilbert vector space addition/subtraction law. (Contributed by NM, 2-Apr-2000.) (New usage is discouraged.)
theorem hvsubsub4 (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 chba) (wcel B2 chba)) (wa (wcel C chba) (wcel D chba))) (wceq (co (co A2 B2 cmv) (co C D cmv) cmv) (co (co A2 C cmv) (co B2 D cmv) cmv)) $;

--| Two times a vector. (Contributed by NM, 22-Jun-2006.) (New usage is discouraged.)
theorem hv2times (A2: class):
  $ wi (wcel A2 chba) (wceq (co c2 A2 csm) (co A2 A2 cva)) $;

--| Distribution of negative over subtraction. (Contributed by NM, 31-Oct-1999.) (New usage is discouraged.)
theorem hvnegdii (A2 B2: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wceq (co (cneg c1) (co A2 B2 cmv) csm) (co B2 A2 cmv) $;

--| If the difference between two vectors is zero, they are equal. (Contributed by NM, 18-Aug-1999.) (New usage is discouraged.)
theorem hvsubeq0i (A2 B2: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wb (wceq (co A2 B2 cmv) c0v) (wceq A2 B2) $;

--| Vector cancellation law. (Contributed by NM, 3-Sep-1999.) (New usage is discouraged.)
theorem hvsubcan2i (A2 B2: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wceq (co (co A2 B2 cva) (co A2 B2 cmv) cva) (co c2 A2 csm) $;

--| Cancellation law for vector addition. (Contributed by NM, 11-Sep-1999.) (New usage is discouraged.)
theorem hvaddcani (A2 B2 C: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wcel C chba $ >
  $ wb (wceq (co A2 B2 cva) (co A2 C cva)) (wceq B2 C) $;

--| Relationship between vector subtraction and addition. (Contributed by NM, 11-Sep-1999.) (New usage is discouraged.)
theorem hvsubaddi (A2 B2 C: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wcel C chba $ >
  $ wb (wceq (co A2 B2 cmv) C) (wceq (co B2 C cva) A2) $;

--| Distribution of negative over subtraction. (Contributed by NM, 2-Apr-2000.) (New usage is discouraged.)
theorem hvnegdi (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wceq (co (cneg c1) (co A2 B2 cmv) csm) (co B2 A2 cmv)) $;

--| If the difference between two vectors is zero, they are equal. (Contributed by NM, 23-Oct-1999.) (New usage is discouraged.)
theorem hvsubeq0 (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wb (wceq (co A2 B2 cmv) c0v) (wceq A2 B2)) $;

--| If the sum of two vectors is zero, one is the negative of the other. (Contributed by NM, 10-Jun-2006.) (New usage is discouraged.)
theorem hvaddeq0 (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wb (wceq (co A2 B2 cva) c0v) (wceq A2 (co (cneg c1) B2 csm))) $;

--| Cancellation law for vector addition. (Contributed by NM, 18-May-2005.) (New usage is discouraged.)
theorem hvaddcan (A2 B2 C: class):
  $ wi (w3a (wcel A2 chba) (wcel B2 chba) (wcel C chba)) (wb (wceq (co A2 B2 cva) (co A2 C cva)) (wceq B2 C)) $;

--| Cancellation law for vector addition. (Contributed by NM, 18-May-2005.) (New usage is discouraged.)
theorem hvaddcan2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 chba) (wcel B2 chba) (wcel C chba)) (wb (wceq (co A2 C cva) (co B2 C cva)) (wceq A2 B2)) $;

--| Cancellation law for scalar multiplication. (Contributed by NM, 19-May-2005.) (New usage is discouraged.)
theorem hvmulcan (A2 B2 C: class):
  $ wi (w3a (wa (wcel A2 cc) (wne A2 cc0)) (wcel B2 chba) (wcel C chba)) (wb (wceq (co A2 B2 csm) (co A2 C csm)) (wceq B2 C)) $;

--| Cancellation law for scalar multiplication. (Contributed by NM, 19-May-2005.) (New usage is discouraged.)
theorem hvmulcan2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wa (wcel C chba) (wne C c0v))) (wb (wceq (co A2 C csm) (co B2 C csm)) (wceq A2 B2)) $;

--| Cancellation law for vector addition. (Contributed by NM, 18-May-2005.) (New usage is discouraged.)
theorem hvsubcan (A2 B2 C: class):
  $ wi (w3a (wcel A2 chba) (wcel B2 chba) (wcel C chba)) (wb (wceq (co A2 B2 cmv) (co A2 C cmv)) (wceq B2 C)) $;

--| Cancellation law for vector addition. (Contributed by NM, 18-May-2005.) (New usage is discouraged.)
theorem hvsubcan2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 chba) (wcel B2 chba) (wcel C chba)) (wb (wceq (co A2 C cmv) (co B2 C cmv)) (wceq A2 B2)) $;

--| Subtraction of a zero vector. (Contributed by NM, 2-Apr-2000.) (New usage is discouraged.)
theorem hvsub0 (A2: class):
  $ wi (wcel A2 chba) (wceq (co A2 c0v cmv) A2) $;

--| Relationship between vector subtraction and addition. (Contributed by NM, 30-Oct-1999.) (New usage is discouraged.)
theorem hvsubadd (A2 B2 C: class):
  $ wi (w3a (wcel A2 chba) (wcel B2 chba) (wcel C chba)) (wb (wceq (co A2 B2 cmv) C) (wceq (co B2 C cva) A2)) $;

--| Hilbert vector space addition/subtraction law. (Contributed by NM, 18-May-2005.) (New usage is discouraged.)
theorem hvaddsub4 (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 chba) (wcel B2 chba)) (wa (wcel C chba) (wcel D chba))) (wb (wceq (co A2 B2 cva) (co C D cva)) (wceq (co A2 C cmv) (co D B2 cmv))) $;

--| Inner product maps pairs from ` ~H ` to ` CC ` . (Contributed by NM, 17-Nov-2007.) (New usage is discouraged.)
axiom ax_hfi:
  $ wf (cxp chba chba) cc csp $;

--| Closure of inner product. (Contributed by NM, 17-Nov-2007.) (New usage is discouraged.)
theorem hicl (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wcel (co A2 B2 csp) cc) $;

--| Closure inference for inner product. (Contributed by NM, 1-Aug-1999.) (New usage is discouraged.)
theorem hicli (A2 B2: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wcel (co A2 B2 csp) cc $;

--| Conjugate law for inner product. Postulate (S1) of [Beran] p. 95. Note that ` * `` x ` is the complex conjugate ~ cjval of ` x ` . In the literature, the inner product of ` A ` and ` B ` is usually written ` <. A , B >. ` , but our operation notation ~ co allows to use existing theorems about operations and also avoids a clash with the definition of an ordered pair ~ df-op . Physicists use ` <. B | A >. ` , called Dirac bra-ket notation, to represent this operation; see comments in ~ df-bra . (Contributed by NM, 29-Jul-1999.) (New usage is discouraged.)
axiom ax_his1 (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wceq (co A2 B2 csp) (cfv (co B2 A2 csp) ccj)) $;

--| Distributive law for inner product. Postulate (S2) of [Beran] p. 95. (Contributed by NM, 31-Jul-1999.) (New usage is discouraged.)
axiom ax_his2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 chba) (wcel B2 chba) (wcel C chba)) (wceq (co (co A2 B2 cva) C csp) (co (co A2 C csp) (co B2 C csp) caddc)) $;

--| Associative law for inner product. Postulate (S3) of [Beran] p. 95. Warning: Mathematics textbooks usually use our version of the axiom. Physics textbooks, on the other hand, usually replace the left-hand side with ` ( B .ih ( A .h C ) ) ` (e.g., Equation 1.21b of [Hughes] p. 44; Definition (iii) of [ReedSimon] p. 36). See the comments in ~ df-bra for why the physics definition is swapped. (Contributed by NM, 29-May-1999.) (New usage is discouraged.)
axiom ax_his3 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 chba) (wcel C chba)) (wceq (co (co A2 B2 csm) C csp) (co A2 (co B2 C csp) cmul)) $;

--| Identity law for inner product. Postulate (S4) of [Beran] p. 95. (Contributed by NM, 29-May-1999.) (New usage is discouraged.)
axiom ax_his4 (A2: class):
  $ wi (wa (wcel A2 chba) (wne A2 c0v)) (wbr cc0 (co A2 A2 csp) clt) $;

--| Associative law for inner product. Lemma 3.1(S5) of [Beran] p. 95. (Contributed by NM, 29-Jul-1999.) (New usage is discouraged.)
theorem his5 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 chba) (wcel C chba)) (wceq (co B2 (co A2 C csm) csp) (co (cfv A2 ccj) (co B2 C csp) cmul)) $;

--| Associative law for inner product. (Contributed by NM, 13-Feb-2006.) (New usage is discouraged.)
theorem his52 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 chba) (wcel C chba)) (wceq (co B2 (co (cfv A2 ccj) C csm) csp) (co A2 (co B2 C csp) cmul)) $;

--| Move scalar multiplication to outside of inner product. (Contributed by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem his35 (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cc) (wcel B2 cc)) (wa (wcel C chba) (wcel D chba))) (wceq (co (co A2 C csm) (co B2 D csm) csp) (co (co A2 (cfv B2 ccj) cmul) (co C D csp) cmul)) $;

--| Move scalar multiplication to outside of inner product. (Contributed by NM, 1-Jul-2005.) (Revised by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem his35i (A2 B2 C D: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wcel C chba $ >
  $ wcel D chba $ >
  $ wceq (co (co A2 C csm) (co B2 D csm) csp) (co (co A2 (cfv B2 ccj) cmul) (co C D csp) cmul) $;

--| Distributive law for inner product. Lemma 3.1(S7) of [Beran] p. 95. (Contributed by NM, 31-Jul-1999.) (New usage is discouraged.)
theorem his7 (A2 B2 C: class):
  $ wi (w3a (wcel A2 chba) (wcel B2 chba) (wcel C chba)) (wceq (co A2 (co B2 C cva) csp) (co (co A2 B2 csp) (co A2 C csp) caddc)) $;

--| Distributive/associative law for inner product, useful for linearity proofs. (Contributed by NM, 10-May-2005.) (New usage is discouraged.)
theorem hiassdi (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cc) (wcel B2 chba)) (wa (wcel C chba) (wcel D chba))) (wceq (co (co (co A2 B2 csm) C cva) D csp) (co (co A2 (co B2 D csp) cmul) (co C D csp) caddc)) $;

--| Distributive law for inner product of vector subtraction. (Contributed by NM, 16-Nov-1999.) (New usage is discouraged.)
theorem his2sub (A2 B2 C: class):
  $ wi (w3a (wcel A2 chba) (wcel B2 chba) (wcel C chba)) (wceq (co (co A2 B2 cmv) C csp) (co (co A2 C csp) (co B2 C csp) cmin)) $;

--| Distributive law for inner product of vector subtraction. (Contributed by NM, 13-Feb-2006.) (New usage is discouraged.)
theorem his2sub2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 chba) (wcel B2 chba) (wcel C chba)) (wceq (co A2 (co B2 C cmv) csp) (co (co A2 B2 csp) (co A2 C csp) cmin)) $;

--| A necessary and sufficient condition for an inner product to be real. (Contributed by NM, 2-Jul-2005.) (New usage is discouraged.)
theorem hire (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wb (wcel (co A2 B2 csp) cr) (wceq (co A2 B2 csp) (co B2 A2 csp))) $;

--| Real closure of inner product with self. (Contributed by NM, 29-May-1999.) (New usage is discouraged.)
theorem hiidrcl (A2: class):
  $ wi (wcel A2 chba) (wcel (co A2 A2 csp) cr) $;

--| Inner product with the 0 vector. (Contributed by NM, 29-May-1999.) (New usage is discouraged.)
theorem hi01 (A2: class):
  $ wi (wcel A2 chba) (wceq (co c0v A2 csp) cc0) $;

--| Inner product with the 0 vector. (Contributed by NM, 13-Oct-1999.) (New usage is discouraged.)
theorem hi02 (A2: class):
  $ wi (wcel A2 chba) (wceq (co A2 c0v csp) cc0) $;

--| Inner product with self is not negative. (Contributed by NM, 29-May-1999.) (New usage is discouraged.)
theorem hiidge0 (A2: class):
  $ wi (wcel A2 chba) (wbr cc0 (co A2 A2 csp) cle) $;

--| Zero inner product with self means vector is zero. Lemma 3.1(S6) of [Beran] p. 95. (Contributed by NM, 27-Jul-1999.) (New usage is discouraged.)
theorem his6 (A2: class):
  $ wi (wcel A2 chba) (wb (wceq (co A2 A2 csp) cc0) (wceq A2 c0v)) $;

--| Conjugate law for inner product. Postulate (S1) of [Beran] p. 95. (Contributed by NM, 15-May-2005.) (New usage is discouraged.)
theorem his1i (A2 B2: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wceq (co A2 B2 csp) (cfv (co B2 A2 csp) ccj) $;

--| Commuted inner products have the same absolute values. (Contributed by NM, 26-May-2006.) (New usage is discouraged.)
theorem abshicom (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wceq (cfv (co A2 B2 csp) cabs) (cfv (co B2 A2 csp) cabs)) $;

--| A vector whose inner product is always zero is zero. (Contributed by NM, 24-Oct-1999.) (New usage is discouraged.)
theorem hial0 {x3: setvar} (A2: class):
  $ wi (wcel A2 chba) (wb (wral x3 (wceq (co A2 (cv x3) csp) cc0) chba) (wceq A2 c0v)) $;

--| A vector whose inner product is always zero is zero. (Contributed by NM, 28-Jan-2006.) (New usage is discouraged.)
theorem hial02 {x3: setvar} (A2: class):
  $ wi (wcel A2 chba) (wb (wral x3 (wceq (co (cv x3) A2 csp) cc0) chba) (wceq A2 c0v)) $;

--| Two vector subtractions simultaneously commute in an inner product. (Contributed by NM, 1-Jul-2005.) (New usage is discouraged.)
theorem hisubcomi (A2 B2 C D: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wcel C chba $ >
  $ wcel D chba $ >
  $ wceq (co (co A2 B2 cmv) (co C D cmv) csp) (co (co B2 A2 cmv) (co D C cmv) csp) $;

--| Lemma used to prove equality of vectors. (Contributed by NM, 16-Nov-1999.) (New usage is discouraged.)
theorem hi2eq (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wb (wceq (co A2 (co A2 B2 cmv) csp) (co B2 (co A2 B2 cmv) csp)) (wceq A2 B2)) $;

--| Two vectors whose inner product is always equal are equal. (Contributed by NM, 16-Nov-1999.) (New usage is discouraged.)
theorem hial2eq {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wb (wral x3 (wceq (co A2 (cv x3) csp) (co B2 (cv x3) csp)) chba) (wceq A2 B2)) $;

--| Two vectors whose inner product is always equal are equal. (Contributed by NM, 28-Jan-2006.) (New usage is discouraged.)
theorem hial2eq2 {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wb (wral x3 (wceq (co (cv x3) A2 csp) (co (cv x3) B2 csp)) chba) (wceq A2 B2)) $;

--| Orthogonality commutes. (Contributed by NM, 10-Oct-1999.) (New usage is discouraged.)
theorem orthcom (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wb (wceq (co A2 B2 csp) cc0) (wceq (co B2 A2 csp) cc0)) $;

--| Lemma used to derive properties of norm. Part of Theorem 3.3(ii) of [Beran] p. 97. (Contributed by NM, 7-Oct-1999.) (New usage is discouraged.)
theorem normlem0 (S F G: class):
  $ wcel S cc $ >
  $ wcel F chba $ >
  $ wcel G chba $ >
  $ wceq (co (co F (co S G csm) cmv) (co F (co S G csm) cmv) csp) (co (co (co F F csp) (co (cneg (cfv S ccj)) (co F G csp) cmul) caddc) (co (co (cneg S) (co G F csp) cmul) (co (co S (cfv S ccj) cmul) (co G G csp) cmul) caddc) caddc) $;

--| Lemma used to derive properties of norm. Part of Theorem 3.3(ii) of [Beran] p. 97. (Contributed by NM, 22-Aug-1999.) (New usage is discouraged.)
theorem normlem1 (R S F G: class):
  $ wcel S cc $ >
  $ wcel F chba $ >
  $ wcel G chba $ >
  $ wcel R cr $ >
  $ wceq (cfv S cabs) c1 $ >
  $ wceq (co (co F (co (co S R cmul) G csm) cmv) (co F (co (co S R cmul) G csm) cmv) csp) (co (co (co F F csp) (co (co (cfv S ccj) (cneg R) cmul) (co F G csp) cmul) caddc) (co (co (co S (cneg R) cmul) (co G F csp) cmul) (co (co R c2 cexp) (co G G csp) cmul) caddc) caddc) $;

--| Lemma used to derive properties of norm. Part of Theorem 3.3(ii) of [Beran] p. 97. (Contributed by NM, 27-Jul-1999.) (New usage is discouraged.)
theorem normlem2 (B2 S F G: class):
  $ wcel S cc $ >
  $ wcel F chba $ >
  $ wcel G chba $ >
  $ wceq B2 (cneg (co (co (cfv S ccj) (co F G csp) cmul) (co S (co G F csp) cmul) caddc)) $ >
  $ wcel B2 cr $;

--| Lemma used to derive properties of norm. Part of Theorem 3.3(ii) of [Beran] p. 97. (Contributed by NM, 21-Aug-1999.) (New usage is discouraged.)
theorem normlem3 (A2 B2 C R S F G: class):
  $ wcel S cc $ >
  $ wcel F chba $ >
  $ wcel G chba $ >
  $ wceq B2 (cneg (co (co (cfv S ccj) (co F G csp) cmul) (co S (co G F csp) cmul) caddc)) $ >
  $ wceq A2 (co G G csp) $ >
  $ wceq C (co F F csp) $ >
  $ wcel R cr $ >
  $ wceq (co (co (co A2 (co R c2 cexp) cmul) (co B2 R cmul) caddc) C caddc) (co (co (co F F csp) (co (co (cfv S ccj) (cneg R) cmul) (co F G csp) cmul) caddc) (co (co (co S (cneg R) cmul) (co G F csp) cmul) (co (co R c2 cexp) (co G G csp) cmul) caddc) caddc) $;

--| Lemma used to derive properties of norm. Part of Theorem 3.3(ii) of [Beran] p. 97. (Contributed by NM, 29-Jul-1999.) (New usage is discouraged.)
theorem normlem4 (A2 B2 C R S F G: class):
  $ wcel S cc $ >
  $ wcel F chba $ >
  $ wcel G chba $ >
  $ wceq B2 (cneg (co (co (cfv S ccj) (co F G csp) cmul) (co S (co G F csp) cmul) caddc)) $ >
  $ wceq A2 (co G G csp) $ >
  $ wceq C (co F F csp) $ >
  $ wcel R cr $ >
  $ wceq (cfv S cabs) c1 $ >
  $ wceq (co (co F (co (co S R cmul) G csm) cmv) (co F (co (co S R cmul) G csm) cmv) csp) (co (co (co A2 (co R c2 cexp) cmul) (co B2 R cmul) caddc) C caddc) $;

--| Lemma used to derive properties of norm. Part of Theorem 3.3(ii) of [Beran] p. 97. (Contributed by NM, 10-Aug-1999.) (New usage is discouraged.)
theorem normlem5 (A2 B2 C R S F G: class):
  $ wcel S cc $ >
  $ wcel F chba $ >
  $ wcel G chba $ >
  $ wceq B2 (cneg (co (co (cfv S ccj) (co F G csp) cmul) (co S (co G F csp) cmul) caddc)) $ >
  $ wceq A2 (co G G csp) $ >
  $ wceq C (co F F csp) $ >
  $ wcel R cr $ >
  $ wceq (cfv S cabs) c1 $ >
  $ wbr cc0 (co (co (co A2 (co R c2 cexp) cmul) (co B2 R cmul) caddc) C caddc) cle $;

--| Lemma used to derive properties of norm. Part of Theorem 3.3(ii) of [Beran] p. 97. (Contributed by NM, 2-Aug-1999.) (Revised by Mario Carneiro, 4-Jun-2014.) (New usage is discouraged.)
theorem normlem6 (A2 B2 C S F G: class):
  $ wcel S cc $ >
  $ wcel F chba $ >
  $ wcel G chba $ >
  $ wceq B2 (cneg (co (co (cfv S ccj) (co F G csp) cmul) (co S (co G F csp) cmul) caddc)) $ >
  $ wceq A2 (co G G csp) $ >
  $ wceq C (co F F csp) $ >
  $ wceq (cfv S cabs) c1 $ >
  $ wbr (cfv B2 cabs) (co c2 (co (cfv A2 csqrt) (cfv C csqrt) cmul) cmul) cle $;

--| Lemma used to derive properties of norm. Part of Theorem 3.3(ii) of [Beran] p. 97. (Contributed by NM, 11-Aug-1999.) (New usage is discouraged.)
theorem normlem7 (S F G: class):
  $ wcel S cc $ >
  $ wcel F chba $ >
  $ wcel G chba $ >
  $ wceq (cfv S cabs) c1 $ >
  $ wbr (co (co (cfv S ccj) (co F G csp) cmul) (co S (co G F csp) cmul) caddc) (co c2 (co (cfv (co G G csp) csqrt) (cfv (co F F csp) csqrt) cmul) cmul) cle $;

--| Lemma used to derive properties of norm. (Contributed by NM, 30-Jun-2005.) (New usage is discouraged.)
theorem normlem8 (A2 B2 C D: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wcel C chba $ >
  $ wcel D chba $ >
  $ wceq (co (co A2 B2 cva) (co C D cva) csp) (co (co (co A2 C csp) (co B2 D csp) caddc) (co (co A2 D csp) (co B2 C csp) caddc) caddc) $;

--| Lemma used to derive properties of norm. (Contributed by NM, 30-Jun-2005.) (New usage is discouraged.)
theorem normlem9 (A2 B2 C D: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wcel C chba $ >
  $ wcel D chba $ >
  $ wceq (co (co A2 B2 cmv) (co C D cmv) csp) (co (co (co A2 C csp) (co B2 D csp) caddc) (co (co A2 D csp) (co B2 C csp) caddc) cmin) $;

--| Lemma used to derive properties of norm. Part of Theorem 3.3(ii) of [Beran] p. 97. (Contributed by NM, 11-Oct-1999.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem normlem7tALT (A2 B2 S: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wi (wa (wcel S cc) (wceq (cfv S cabs) c1)) (wbr (co (co (cfv S ccj) (co A2 B2 csp) cmul) (co S (co B2 A2 csp) cmul) caddc) (co c2 (co (cfv (co B2 B2 csp) csqrt) (cfv (co A2 A2 csp) csqrt) cmul) cmul) cle) $;

--| Equality case of Bunjakovaskij-Cauchy-Schwarz inequality. Specifically, in the equality case the two vectors are collinear. Compare ~ bcsiHIL . (Contributed by NM, 16-Jul-2001.) (New usage is discouraged.)
theorem bcseqi (A2 B2: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wb (wceq (co (co A2 B2 csp) (co B2 A2 csp) cmul) (co (co A2 A2 csp) (co B2 B2 csp) cmul)) (wceq (co (co B2 B2 csp) A2 csm) (co (co A2 B2 csp) B2 csm)) $;

--| Lemma used to derive properties of norm. Part of Remark 3.4(B) of [Beran] p. 98. (Contributed by NM, 10-May-2005.) (New usage is discouraged.)
theorem normlem9at (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wceq (co (co A2 B2 cmv) (co A2 B2 cmv) csp) (co (co (co A2 A2 csp) (co B2 B2 csp) caddc) (co (co A2 B2 csp) (co B2 A2 csp) caddc) cmin)) $;

--| Alternate definition of the norm of a vector of Hilbert space. Definition of norm in [Beran] p. 96. (Contributed by NM, 6-Jun-2008.) (Revised by Mario Carneiro, 15-Dec-2013.) (New usage is discouraged.)
theorem dfhnorm2 {x3: setvar}:
  $ wceq cno (cmpt x3 chba (cfv (co (cv x3) (cv x3) csp) csqrt)) $;

--| The norm function maps from Hilbert space to reals. (Contributed by NM, 6-Sep-2007.) (Revised by Mario Carneiro, 15-Dec-2013.) (New usage is discouraged.)
theorem normf:
  $ wf chba cr cno $;

--| The value of the norm of a vector in Hilbert space. Definition of norm in [Beran] p. 96. In the literature, the norm of ` A ` is usually written as "|| ` A ` ||", but we use function value notation to take advantage of our existing theorems about functions. (Contributed by NM, 29-May-1999.) (Revised by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem normval (A2: class):
  $ wi (wcel A2 chba) (wceq (cfv A2 cno) (cfv (co A2 A2 csp) csqrt)) $;

--| Real closure of the norm of a vector. (Contributed by NM, 29-May-1999.) (New usage is discouraged.)
theorem normcl (A2: class):
  $ wi (wcel A2 chba) (wcel (cfv A2 cno) cr) $;

--| The norm of a vector is nonnegative. (Contributed by NM, 29-May-1999.) (New usage is discouraged.)
theorem normge0 (A2: class):
  $ wi (wcel A2 chba) (wbr cc0 (cfv A2 cno) cle) $;

--| The norm of nonzero vector is positive. (Contributed by NM, 10-Apr-2006.) (New usage is discouraged.)
theorem normgt0 (A2: class):
  $ wi (wcel A2 chba) (wb (wne A2 c0v) (wbr cc0 (cfv A2 cno) clt)) $;

--| The norm of a zero vector. (Contributed by NM, 30-May-1999.) (New usage is discouraged.)
theorem norm0:
  $ wceq (cfv c0v cno) cc0 $;

--| Theorem 3.3(i) of [Beran] p. 97. (Contributed by NM, 29-Jul-1999.) (New usage is discouraged.)
theorem norm_i (A2: class):
  $ wi (wcel A2 chba) (wb (wceq (cfv A2 cno) cc0) (wceq A2 c0v)) $;

--| A norm is nonzero iff its argument is a nonzero vector. (Contributed by NM, 11-Mar-2006.) (New usage is discouraged.)
theorem normne0 (A2: class):
  $ wi (wcel A2 chba) (wb (wne (cfv A2 cno) cc0) (wne A2 c0v)) $;

--| Real closure of the norm of a vector. (Contributed by NM, 30-Sep-1999.) (New usage is discouraged.)
theorem normcli (A2: class):
  $ wcel A2 chba $ >
  $ wcel (cfv A2 cno) cr $;

--| The square of a norm. (Contributed by NM, 21-Aug-1999.) (New usage is discouraged.)
theorem normsqi (A2: class):
  $ wcel A2 chba $ >
  $ wceq (co (cfv A2 cno) c2 cexp) (co A2 A2 csp) $;

--| Theorem 3.3(i) of [Beran] p. 97. (Contributed by NM, 5-Sep-1999.) (New usage is discouraged.)
theorem norm_i_i (A2: class):
  $ wcel A2 chba $ >
  $ wb (wceq (cfv A2 cno) cc0) (wceq A2 c0v) $;

--| The square of a norm. (Contributed by NM, 12-May-2005.) (New usage is discouraged.)
theorem normsq (A2: class):
  $ wi (wcel A2 chba) (wceq (co (cfv A2 cno) c2 cexp) (co A2 A2 csp)) $;

--| Two vectors are equal iff the norm of their difference is zero. (Contributed by NM, 18-Aug-1999.) (New usage is discouraged.)
theorem normsub0i (A2 B2: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wb (wceq (cfv (co A2 B2 cmv) cno) cc0) (wceq A2 B2) $;

--| Two vectors are equal iff the norm of their difference is zero. (Contributed by NM, 18-Aug-1999.) (New usage is discouraged.)
theorem normsub0 (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wb (wceq (cfv (co A2 B2 cmv) cno) cc0) (wceq A2 B2)) $;

--| Triangle inequality for norms. Theorem 3.3(ii) of [Beran] p. 97. (Contributed by NM, 11-Aug-1999.) (New usage is discouraged.)
theorem norm_ii_i (A2 B2: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wbr (cfv (co A2 B2 cva) cno) (co (cfv A2 cno) (cfv B2 cno) caddc) cle $;

--| Triangle inequality for norms. Theorem 3.3(ii) of [Beran] p. 97. (Contributed by NM, 10-Mar-2006.) (New usage is discouraged.)
theorem norm_ii (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wbr (cfv (co A2 B2 cva) cno) (co (cfv A2 cno) (cfv B2 cno) caddc) cle) $;

--| Theorem 3.3(iii) of [Beran] p. 97. (Contributed by NM, 29-Jul-1999.) (New usage is discouraged.)
theorem norm_iii_i (A2 B2: class):
  $ wcel A2 cc $ >
  $ wcel B2 chba $ >
  $ wceq (cfv (co A2 B2 csm) cno) (co (cfv A2 cabs) (cfv B2 cno) cmul) $;

--| Theorem 3.3(iii) of [Beran] p. 97. (Contributed by NM, 25-Oct-1999.) (New usage is discouraged.)
theorem norm_iii (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 chba)) (wceq (cfv (co A2 B2 csm) cno) (co (cfv A2 cabs) (cfv B2 cno) cmul)) $;

--| Negative doesn't change the norm of a Hilbert space vector. (Contributed by NM, 11-Aug-1999.) (New usage is discouraged.)
theorem normsubi (A2 B2: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wceq (cfv (co A2 B2 cmv) cno) (cfv (co B2 A2 cmv) cno) $;

--| Analogy to Pythagorean theorem for orthogonal vectors. Remark 3.4(C) of [Beran] p. 98. (Contributed by NM, 17-Oct-1999.) (New usage is discouraged.)
theorem normpythi (A2 B2: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wi (wceq (co A2 B2 csp) cc0) (wceq (co (cfv (co A2 B2 cva) cno) c2 cexp) (co (co (cfv A2 cno) c2 cexp) (co (cfv B2 cno) c2 cexp) caddc)) $;

--| Swapping order of subtraction doesn't change the norm of a vector. (Contributed by NM, 14-Aug-1999.) (New usage is discouraged.)
theorem normsub (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wceq (cfv (co A2 B2 cmv) cno) (cfv (co B2 A2 cmv) cno)) $;

--| The norm of a vector equals the norm of its negative. (Contributed by NM, 23-May-2005.) (New usage is discouraged.)
theorem normneg (A2: class):
  $ wi (wcel A2 chba) (wceq (cfv (co (cneg c1) A2 csm) cno) (cfv A2 cno)) $;

--| Analogy to Pythagorean theorem for orthogonal vectors. Remark 3.4(C) of [Beran] p. 98. (Contributed by NM, 17-Oct-1999.) (New usage is discouraged.)
theorem normpyth (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wi (wceq (co A2 B2 csp) cc0) (wceq (co (cfv (co A2 B2 cva) cno) c2 cexp) (co (co (cfv A2 cno) c2 cexp) (co (cfv B2 cno) c2 cexp) caddc))) $;

--| Corollary to Pythagorean theorem for orthogonal vectors. Remark 3.4(C) of [Beran] p. 98. (Contributed by NM, 26-Oct-1999.) (New usage is discouraged.)
theorem normpyc (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wi (wceq (co A2 B2 csp) cc0) (wbr (cfv A2 cno) (cfv (co A2 B2 cva) cno) cle)) $;

--| Norm of differences around common element. Part of Lemma 3.6 of [Beran] p. 101. (Contributed by NM, 16-Aug-1999.) (New usage is discouraged.)
theorem norm3difi (A2 B2 C: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wcel C chba $ >
  $ wbr (cfv (co A2 B2 cmv) cno) (co (cfv (co A2 C cmv) cno) (cfv (co C B2 cmv) cno) caddc) cle $;

--| Norm of differences around common element. Part of Lemma 3.6 of [Beran] p. 101. (Contributed by NM, 30-Sep-1999.) (New usage is discouraged.)
theorem norm3adifii (A2 B2 C: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wcel C chba $ >
  $ wbr (cfv (co (cfv (co A2 C cmv) cno) (cfv (co B2 C cmv) cno) cmin) cabs) (cfv (co A2 B2 cmv) cno) cle $;

--| Lemma involving norm of differences in Hilbert space. (Contributed by NM, 18-Aug-1999.) (New usage is discouraged.)
theorem norm3lem (A2 B2 C D: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wcel C chba $ >
  $ wcel D cr $ >
  $ wi (wa (wbr (cfv (co A2 C cmv) cno) (co D c2 cdiv) clt) (wbr (cfv (co C B2 cmv) cno) (co D c2 cdiv) clt)) (wbr (cfv (co A2 B2 cmv) cno) D clt) $;

--| Norm of differences around common element. Part of Lemma 3.6 of [Beran] p. 101. (Contributed by NM, 20-Apr-2006.) (New usage is discouraged.)
theorem norm3dif (A2 B2 C: class):
  $ wi (w3a (wcel A2 chba) (wcel B2 chba) (wcel C chba)) (wbr (cfv (co A2 B2 cmv) cno) (co (cfv (co A2 C cmv) cno) (cfv (co C B2 cmv) cno) caddc) cle) $;

--| Norm of differences around common element. (Contributed by NM, 18-Apr-2007.) (New usage is discouraged.)
theorem norm3dif2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 chba) (wcel B2 chba) (wcel C chba)) (wbr (cfv (co A2 B2 cmv) cno) (co (cfv (co C A2 cmv) cno) (cfv (co C B2 cmv) cno) caddc) cle) $;

--| Lemma involving norm of differences in Hilbert space. (Contributed by NM, 18-Aug-1999.) (New usage is discouraged.)
theorem norm3lemt (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 chba) (wcel B2 chba)) (wa (wcel C chba) (wcel D cr))) (wi (wa (wbr (cfv (co A2 C cmv) cno) (co D c2 cdiv) clt) (wbr (cfv (co C B2 cmv) cno) (co D c2 cdiv) clt)) (wbr (cfv (co A2 B2 cmv) cno) D clt)) $;

--| Norm of differences around common element. Part of Lemma 3.6 of [Beran] p. 101. (Contributed by NM, 3-Oct-1999.) (New usage is discouraged.)
theorem norm3adifi (A2 B2 C: class):
  $ wcel C chba $ >
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wbr (cfv (co (cfv (co A2 C cmv) cno) (cfv (co B2 C cmv) cno) cmin) cabs) (cfv (co A2 B2 cmv) cno) cle) $;

--| Parallelogram law for norms. Remark 3.4(B) of [Beran] p. 98. (Contributed by NM, 21-Aug-1999.) (New usage is discouraged.)
theorem normpari (A2 B2: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wceq (co (co (cfv (co A2 B2 cmv) cno) c2 cexp) (co (cfv (co A2 B2 cva) cno) c2 cexp) caddc) (co (co c2 (co (cfv A2 cno) c2 cexp) cmul) (co c2 (co (cfv B2 cno) c2 cexp) cmul) caddc) $;

--| Parallelogram law for norms. Remark 3.4(B) of [Beran] p. 98. (Contributed by NM, 15-Apr-2007.) (New usage is discouraged.)
theorem normpar (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wceq (co (co (cfv (co A2 B2 cmv) cno) c2 cexp) (co (cfv (co A2 B2 cva) cno) c2 cexp) caddc) (co (co c2 (co (cfv A2 cno) c2 cexp) cmul) (co c2 (co (cfv B2 cno) c2 cexp) cmul) caddc)) $;

--| Corollary of parallelogram law for norms. Part of Lemma 3.6 of [Beran] p. 100. (Contributed by NM, 5-Oct-1999.) (New usage is discouraged.)
theorem normpar2i (A2 B2 C: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wcel C chba $ >
  $ wceq (co (cfv (co A2 B2 cmv) cno) c2 cexp) (co (co (co c2 (co (cfv (co A2 C cmv) cno) c2 cexp) cmul) (co c2 (co (cfv (co B2 C cmv) cno) c2 cexp) cmul) caddc) (co (cfv (co (co A2 B2 cva) (co c2 C csm) cmv) cno) c2 cexp) cmin) $;

--| Generalized polarization identity. Generalization of Exercise 4(a) of [ReedSimon] p. 63. (Contributed by NM, 30-Jun-2005.) (New usage is discouraged.)
theorem polid2i (A2 B2 C D: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wcel C chba $ >
  $ wcel D chba $ >
  $ wceq (co A2 B2 csp) (co (co (co (co (co A2 C cva) (co D B2 cva) csp) (co (co A2 C cmv) (co D B2 cmv) csp) cmin) (co ci (co (co (co A2 (co ci C csm) cva) (co D (co ci B2 csm) cva) csp) (co (co A2 (co ci C csm) cmv) (co D (co ci B2 csm) cmv) csp) cmin) cmul) caddc) c4 cdiv) $;

--| Polarization identity. Recovers inner product from norm. Exercise 4(a) of [ReedSimon] p. 63. The outermost operation is + instead of - due to our mathematicians' (rather than physicists') version of Axiom ~ ax-his3 . (Contributed by NM, 30-Jun-2005.) (New usage is discouraged.)
theorem polidi (A2 B2: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wceq (co A2 B2 csp) (co (co (co (co (cfv (co A2 B2 cva) cno) c2 cexp) (co (cfv (co A2 B2 cmv) cno) c2 cexp) cmin) (co ci (co (co (cfv (co A2 (co ci B2 csm) cva) cno) c2 cexp) (co (cfv (co A2 (co ci B2 csm) cmv) cno) c2 cexp) cmin) cmul) caddc) c4 cdiv) $;

--| Polarization identity. Recovers inner product from norm. Exercise 4(a) of [ReedSimon] p. 63. The outermost operation is + instead of - due to our mathematicians' (rather than physicists') version of Axiom ~ ax-his3 . (Contributed by NM, 17-Nov-2007.) (New usage is discouraged.)
theorem polid (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wceq (co A2 B2 csp) (co (co (co (co (cfv (co A2 B2 cva) cno) c2 cexp) (co (cfv (co A2 B2 cmv) cno) c2 cexp) cmin) (co ci (co (co (cfv (co A2 (co ci B2 csm) cva) cno) c2 cexp) (co (cfv (co A2 (co ci B2 csm) cmv) cno) c2 cexp) cmin) cmul) caddc) c4 cdiv)) $;

--| Hilbert space vector addition is an Abelian group operation. (Contributed by NM, 15-Apr-2007.) (New usage is discouraged.)
theorem hilablo:
  $ wcel cva cablo $;

--| The group identity element of Hilbert space vector addition is the zero vector. (Contributed by NM, 16-Apr-2007.) (New usage is discouraged.)
theorem hilid:
  $ wceq (cfv cva cgi) c0v $;

--| Hilbert space is a complex vector space. Vector addition is ` +h ` , and scalar product is ` .h ` . (Contributed by NM, 15-Apr-2007.) (New usage is discouraged.)
theorem hilvc:
  $ wcel (cop cva csm) cvc $;

--| Hilbert space norm in terms of vector space norm. (Contributed by NM, 11-Sep-2007.) (Revised by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem hilnormi (U: class):
  $ wceq chba (cfv U cba) $ >
  $ wceq csp (cfv U cdip) $ >
  $ wcel U cnv $ >
  $ wceq cno (cfv U cnmcv) $;

--| Deduce the structure of Hilbert space from its components. (Contributed by NM, 10-Apr-2008.) (New usage is discouraged.)
theorem hilhhi (U: class):
  $ wceq chba (cfv U cba) $ >
  $ wceq cva (cfv U cpv) $ >
  $ wceq csm (cfv U cns) $ >
  $ wceq csp (cfv U cdip) $ >
  $ wcel U cnv $ >
  $ wceq U (cop (cop cva csm) cno) $;

--| Hilbert space is a normed complex vector space. (Contributed by NM, 17-Nov-2007.) (New usage is discouraged.)
theorem hhnv (U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wcel U cnv $;

--| The group (addition) operation of Hilbert space. (Contributed by NM, 17-Nov-2007.) (New usage is discouraged.)
theorem hhva (U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wceq cva (cfv U cpv) $;

--| The base set of Hilbert space. This theorem provides an independent proof of ~ df-hba (see comments in that definition). (Contributed by NM, 17-Nov-2007.) (New usage is discouraged.)
theorem hhba (U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wceq chba (cfv U cba) $;

--| The zero vector of Hilbert space. (Contributed by NM, 17-Nov-2007.) (Revised by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem hh0v (U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wceq c0v (cfv U cn0v) $;

--| The scalar product operation of Hilbert space. (Contributed by NM, 17-Nov-2007.) (New usage is discouraged.)
theorem hhsm (U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wceq csm (cfv U cns) $;

--| The vector subtraction operation of Hilbert space. (Contributed by NM, 13-Dec-2007.) (New usage is discouraged.)
theorem hhvs (U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wceq cmv (cfv U cnsb) $;

--| The norm function of Hilbert space. (Contributed by NM, 17-Nov-2007.) (New usage is discouraged.)
theorem hhnm (U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wceq cno (cfv U cnmcv) $;

--| The induced metric of Hilbert space. (Contributed by NM, 17-Nov-2007.) (New usage is discouraged.)
theorem hhims (D U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wceq D (ccom cno cmv) $ >
  $ wceq D (cfv U cims) $;

--| Hilbert space distance metric. (Contributed by NM, 10-Apr-2008.) (New usage is discouraged.)
theorem hhims2 (D U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wceq D (cfv U cims) $ >
  $ wceq D (ccom cno cmv) $;

--| The induced metric of Hilbert space. (Contributed by NM, 10-Apr-2008.) (New usage is discouraged.)
theorem hhmet (D U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wceq D (cfv U cims) $ >
  $ wcel D (cfv chba cmet) $;

--| The induced metric of Hilbert space. (Contributed by Mario Carneiro, 10-Sep-2015.) (New usage is discouraged.)
theorem hhxmet (D U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wceq D (cfv U cims) $ >
  $ wcel D (cfv chba cxmet) $;

--| Value of the distance function of the metric space of Hilbert space. (Contributed by NM, 10-Apr-2008.) (New usage is discouraged.)
theorem hhmetdval (A2 B2 D U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wceq D (cfv U cims) $ >
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wceq (co A2 B2 D) (cfv (co A2 B2 cmv) cno)) $;

--| The inner product operation of Hilbert space. (Contributed by NM, 17-Nov-2007.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem hhip (U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wceq csp (cfv U cdip) $;

--| The Hilbert space of the Hilbert Space Explorer is an inner product space. (Contributed by NM, 24-Nov-2007.) (New usage is discouraged.)
theorem hhph (U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wcel U ccphlo $;

--| Bunjakovaskij-Cauchy-Schwarz inequality. Remark 3.4 of [Beran] p. 98. (Contributed by NM, 11-Oct-1999.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem bcsiALT (A2 B2: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wbr (cfv (co A2 B2 csp) cabs) (co (cfv A2 cno) (cfv B2 cno) cmul) cle $;

--| Bunjakovaskij-Cauchy-Schwarz inequality. Remark 3.4 of [Beran] p. 98. (Proved from ZFC version.) (Contributed by NM, 24-Nov-2007.) (New usage is discouraged.)
theorem bcsiHIL (A2 B2: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wbr (cfv (co A2 B2 csp) cabs) (co (cfv A2 cno) (cfv B2 cno) cmul) cle $;

--| Bunjakovaskij-Cauchy-Schwarz inequality. Remark 3.4 of [Beran] p. 98. (Contributed by NM, 16-Feb-2006.) (New usage is discouraged.)
theorem bcs (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wbr (cfv (co A2 B2 csp) cabs) (co (cfv A2 cno) (cfv B2 cno) cmul) cle) $;

--| Corollary of the Bunjakovaskij-Cauchy-Schwarz inequality ~ bcsiHIL . (Contributed by NM, 24-May-2006.) (New usage is discouraged.)
theorem bcs2 (A2 B2: class):
  $ wi (w3a (wcel A2 chba) (wcel B2 chba) (wbr (cfv A2 cno) c1 cle)) (wbr (cfv (co A2 B2 csp) cabs) (cfv B2 cno) cle) $;

--| Corollary of the Bunjakovaskij-Cauchy-Schwarz inequality ~ bcsiHIL . (Contributed by NM, 26-May-2006.) (New usage is discouraged.)
theorem bcs3 (A2 B2: class):
  $ wi (w3a (wcel A2 chba) (wcel B2 chba) (wbr (cfv B2 cno) c1 cle)) (wbr (cfv (co A2 B2 csp) cabs) (cfv A2 cno) cle) $;

--| Member of the set of Cauchy sequences on a Hilbert space. Definition for Cauchy sequence in [Beran] p. 96. (Contributed by NM, 16-Aug-1999.) (Revised by Mario Carneiro, 14-May-2014.) (New usage is discouraged.)
theorem hcau {x3 y1 z: setvar} (F: class):
  $ wb (wcel F ccauold) (wa (wf cn chba F) (wral x3 (wrex y1 (wral z (wbr (cfv (co (cfv (cv y1) F) (cfv (cv z) F) cmv) cno) (cv x3) clt) (cfv (cv y1) cuz)) cn) crp)) $;

--| A Cauchy sequences on a Hilbert space is a sequence. (Contributed by NM, 16-Aug-1999.) (Revised by Mario Carneiro, 14-May-2014.) (New usage is discouraged.)
theorem hcauseq (F: class):
  $ wi (wcel F ccauold) (wf cn chba F) $;

--| A Cauchy sequence on a Hilbert space converges. (Contributed by NM, 16-Aug-1999.) (Revised by Mario Carneiro, 14-May-2014.) (New usage is discouraged.)
theorem hcaucvg {y1 z: setvar} (A2 F: class):
  $ wi (wa (wcel F ccauold) (wcel A2 crp)) (wrex y1 (wral z (wbr (cfv (co (cfv (cv y1) F) (cfv (cv z) F) cmv) cno) A2 clt) (cfv (cv y1) cuz)) cn) $;

--| A sequence on a Hilbert space is a Cauchy sequence if it converges. (Contributed by NM, 16-Aug-1999.) (Revised by Mario Carneiro, 14-May-2014.) (New usage is discouraged.)
theorem seq1hcau {x3 y1 z: setvar} (F: class):
  $ wi (wf cn chba F) (wb (wcel F ccauold) (wral x3 (wrex y1 (wral z (wbr (cfv (co (cfv (cv y1) F) (cfv (cv z) F) cmv) cno) (cv x3) clt) (cfv (cv y1) cuz)) cn) crp)) $;

--| Express the predicate: The limit of vector sequence ` F ` in a Hilbert space is ` A ` , i.e. ` F ` converges to ` A ` . This means that for any real ` x ` , no matter how small, there always exists an integer ` y ` such that the norm of any later vector in the sequence minus the limit is less than ` x ` . Definition of converge in [Beran] p. 96. (Contributed by NM, 16-Aug-1999.) (Revised by Mario Carneiro, 14-May-2014.) (New usage is discouraged.)
theorem hlimi {x3 y1 z: setvar} (A2 F: class):
  $ wcel A2 cvv $ >
  $ wb (wbr F A2 chli) (wa (wa (wf cn chba F) (wcel A2 chba)) (wral x3 (wrex y1 (wral z (wbr (cfv (co (cfv (cv z) F) A2 cmv) cno) (cv x3) clt) (cfv (cv y1) cuz)) cn) crp)) $;

--| A sequence with a limit on a Hilbert space is a sequence. (Contributed by NM, 16-Aug-1999.) (New usage is discouraged.)
theorem hlimseqi (A2 F: class):
  $ wcel A2 cvv $ >
  $ wi (wbr F A2 chli) (wf cn chba F) $;

--| Closure of the limit of a sequence on Hilbert space. (Contributed by NM, 16-Aug-1999.) (New usage is discouraged.)
theorem hlimveci (A2 F: class):
  $ wcel A2 cvv $ >
  $ wi (wbr F A2 chli) (wcel A2 chba) $;

--| Convergence of a sequence on a Hilbert space. (Contributed by NM, 16-Aug-1999.) (Revised by Mario Carneiro, 14-May-2014.) (New usage is discouraged.)
theorem hlimconvi {y1 z: setvar} (A2 B2 F: class):
  $ wcel A2 cvv $ >
  $ wi (wa (wbr F A2 chli) (wcel B2 crp)) (wrex y1 (wral z (wbr (cfv (co (cfv (cv z) F) A2 cmv) cno) B2 clt) (cfv (cv y1) cuz)) cn) $;

--| The limit of a sequence on a Hilbert space. (Contributed by NM, 16-Aug-1999.) (Revised by Mario Carneiro, 14-May-2014.) (New usage is discouraged.)
theorem hlim2 {x3 y1 z: setvar} (A2 F: class):
  $ wi (wa (wf cn chba F) (wcel A2 chba)) (wb (wbr F A2 chli) (wral x3 (wrex y1 (wral z (wbr (cfv (co (cfv (cv z) F) A2 cmv) cno) (cv x3) clt) (cfv (cv y1) cuz)) cn) crp)) $;

--| Limit of the sum of two sequences in a Hilbert vector space. (Contributed by Mario Carneiro, 19-May-2014.) (New usage is discouraged.)
theorem hlimadd {n: setvar} (ph: wff) (A2 B2: class n) (F G: class) (H: class n):
  $ wi ph (wf cn chba F) $ >
  $ wi ph (wf cn chba G) $ >
  $ wi ph (wbr F A2 chli) $ >
  $ wi ph (wbr G B2 chli) $ >
  $ wceq H (cmpt n cn (co (cfv (cv n) F) (cfv (cv n) G) cva)) $ >
  $ wi ph (wbr H (co A2 B2 cva) chli) $;

--| The Hilbert space norm determines a metric space. (Contributed by NM, 17-Apr-2007.) (New usage is discouraged.)
theorem hilmet (D: class):
  $ wceq D (ccom cno cmv) $ >
  $ wcel D (cfv chba cmet) $;

--| The Hilbert space norm determines a metric space. (Contributed by Mario Carneiro, 10-Sep-2015.) (New usage is discouraged.)
theorem hilxmet (D: class):
  $ wceq D (ccom cno cmv) $ >
  $ wcel D (cfv chba cxmet) $;

--| Value of the distance function of the metric space of Hilbert space. (Contributed by NM, 17-Apr-2007.) (New usage is discouraged.)
theorem hilmetdval (A2 B2 D: class):
  $ wceq D (ccom cno cmv) $ >
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wceq (co A2 B2 D) (cfv (co A2 B2 cmv) cno)) $;

--| Hilbert space distance metric. (Contributed by NM, 13-Sep-2007.) (New usage is discouraged.)
theorem hilims (D U: class):
  $ wceq chba (cfv U cba) $ >
  $ wceq cva (cfv U cpv) $ >
  $ wceq csm (cfv U cns) $ >
  $ wceq csp (cfv U cdip) $ >
  $ wceq D (cfv U cims) $ >
  $ wcel U cnv $ >
  $ wceq D (ccom cno cmv) $;

--| The Cauchy sequences of Hilbert space. (Contributed by NM, 19-Nov-2007.) (New usage is discouraged.)
theorem hhcau (D U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wceq D (cfv U cims) $ >
  $ wceq ccauold (cin (cfv D ccau) (co chba cn cmap)) $;

--| The limit sequences of Hilbert space. (Contributed by NM, 19-Nov-2007.) (New usage is discouraged.)
theorem hhlm (D U J: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wceq D (cfv U cims) $ >
  $ wceq J (cfv D cmopn) $ >
  $ wceq chli (cres (cfv J clm) (co chba cn cmap)) $;

--| Lemma used for derivation of the completeness axiom ~ ax-hcompl from ZFC Hilbert space theory. (Contributed by NM, 9-Apr-2008.) (New usage is discouraged.)
theorem hhcmpl {x3: setvar} (D U: class x3) (F: class) (J: class x3):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wceq D (cfv U cims) $ >
  $ wceq J (cfv D cmopn) $ >
  $ wi (wcel F (cfv D ccau)) (wrex x3 (wbr F (cv x3) (cfv J clm)) chba) $ >
  $ wi (wcel F ccauold) (wrex x3 (wbr F (cv x3) chli) chba) $;

--| Lemma used for derivation of the completeness axiom ~ ax-hcompl from ZFC Hilbert space theory. The first five hypotheses would be satisfied by the definitions described in ~ ax-hilex ; the 6th would be satisfied by ~ eqid ; the 7th by a given fixed Hilbert space; and the last by Theorem ~ hlcompl . (Contributed by NM, 13-Sep-2007.) (Revised by Mario Carneiro, 14-May-2014.) (New usage is discouraged.)
theorem hilcompl {x3: setvar} (D U: class x3) (F: class) (J: class x3):
  $ wceq chba (cfv U cba) $ >
  $ wceq cva (cfv U cpv) $ >
  $ wceq csm (cfv U cns) $ >
  $ wceq csp (cfv U cdip) $ >
  $ wceq D (cfv U cims) $ >
  $ wceq J (cfv D cmopn) $ >
  $ wcel U chlo $ >
  $ wi (wcel F (cfv D ccau)) (wrex x3 (wbr F (cv x3) (cfv J clm)) chba) $ >
  $ wi (wcel F ccauold) (wrex x3 (wbr F (cv x3) chli) chba) $;

--| Completeness of a Hilbert space. (Contributed by NM, 7-Aug-2000.) (New usage is discouraged.)
axiom ax_hcompl {x3: setvar} (F: class):
  $ wi (wcel F ccauold) (wrex x3 (wbr F (cv x3) chli) chba) $;

--| The Hilbert space induced metric determines a complete metric space. (Contributed by NM, 10-Apr-2008.) (Proof shortened by Mario Carneiro, 14-May-2014.) (Proof shortened by Peter Mazsa, 2-Oct-2022.) (New usage is discouraged.)
theorem hhcms (D U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wceq D (cfv U cims) $ >
  $ wcel D (cfv chba ccmet) $;

--| The Hilbert space structure is a complex Hilbert space. (Contributed by NM, 10-Apr-2008.) (New usage is discouraged.)
theorem hhhl (U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wcel U chlo $;

--| The Hilbert space norm determines a complete metric space. (Contributed by NM, 17-Apr-2007.) (New usage is discouraged.)
theorem hilcms (D: class):
  $ wceq D (ccom cno cmv) $ >
  $ wcel D (cfv chba ccmet) $;

--| The Hilbert space of the Hilbert Space Explorer is a complex Hilbert space. (Contributed by Steve Rodriguez, 29-Apr-2007.) (New usage is discouraged.)
theorem hilhl:
  $ wcel (cop (cop cva csm) cno) chlo $;

--| Define the set of subspaces of a Hilbert space. See ~ issh for its membership relation. Basically, a subspace is a subset of a Hilbert space that acts like a vector space. From Definition of [Beran] p. 95. (Contributed by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
axiom df_sh {h: setvar}:
  $ wceq csh (crab h (w3a (wcel c0v (cv h)) (wss (cima cva (cxp (cv h) (cv h))) (cv h)) (wss (cima csm (cxp cc (cv h))) (cv h))) (cpw chba)) $;

--| Subspace ` H ` of a Hilbert space. A subspace is a subset of Hilbert space which contains the zero vector and is closed under vector addition and scalar multiplication. (Contributed by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem issh (H: class):
  $ wb (wcel H csh) (wa (wa (wss H chba) (wcel c0v H)) (wa (wss (cima cva (cxp H H)) H) (wss (cima csm (cxp cc H)) H))) $;

--| Subspace ` H ` of a Hilbert space. A subspace is a subset of Hilbert space which contains the zero vector and is closed under vector addition and scalar multiplication. Definition of [Beran] p. 95. (Contributed by NM, 16-Aug-1999.) (Revised by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem issh2 {x3 y1: setvar} (H: class):
  $ wb (wcel H csh) (wa (wa (wss H chba) (wcel c0v H)) (wa (wral x3 (wral y1 (wcel (co (cv x3) (cv y1) cva) H) H) H) (wral x3 (wral y1 (wcel (co (cv x3) (cv y1) csm) H) H) cc))) $;

--| A subspace is a subset of Hilbert space. (Contributed by NM, 9-Oct-1999.) (Revised by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem shss (H: class):
  $ wi (wcel H csh) (wss H chba) $;

--| A member of a subspace of a Hilbert space is a vector. (Contributed by NM, 14-Dec-2004.) (New usage is discouraged.)
theorem shel (A2 H: class):
  $ wi (wa (wcel H csh) (wcel A2 H)) (wcel A2 chba) $;

--| The set of subspaces of a Hilbert space exists (is a set). (Contributed by NM, 23-Oct-1999.) (New usage is discouraged.)
theorem shex:
  $ wcel csh cvv $;

--| A closed subspace of a Hilbert space is a subset of Hilbert space. (Contributed by NM, 6-Oct-1999.) (New usage is discouraged.)
theorem shssii (H: class):
  $ wcel H csh $ >
  $ wss H chba $;

--| A member of a subspace of a Hilbert space is a vector. (Contributed by NM, 6-Oct-1999.) (New usage is discouraged.)
theorem sheli (A2 H: class):
  $ wcel H csh $ >
  $ wi (wcel A2 H) (wcel A2 chba) $;

--| A member of a subspace of a Hilbert space is a vector. (Contributed by NM, 6-Oct-1999.) (New usage is discouraged.)
theorem shelii (A2 H: class):
  $ wcel H csh $ >
  $ wcel A2 H $ >
  $ wcel A2 chba $;

--| The zero vector belongs to any subspace of a Hilbert space. (Contributed by NM, 11-Oct-1999.) (Revised by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem sh0 (H: class):
  $ wi (wcel H csh) (wcel c0v H) $;

--| Closure of vector addition in a subspace of a Hilbert space. (Contributed by NM, 13-Sep-1999.) (New usage is discouraged.)
theorem shaddcl (A2 B2 H: class):
  $ wi (w3a (wcel H csh) (wcel A2 H) (wcel B2 H)) (wcel (co A2 B2 cva) H) $;

--| Closure of vector scalar multiplication in a subspace of a Hilbert space. (Contributed by NM, 13-Sep-1999.) (New usage is discouraged.)
theorem shmulcl (A2 B2 H: class):
  $ wi (w3a (wcel H csh) (wcel A2 cc) (wcel B2 H)) (wcel (co A2 B2 csm) H) $;

--| Subspace ` H ` of a Hilbert space. (Contributed by NM, 16-Aug-1999.) (New usage is discouraged.)
theorem issh3 {x3 y1: setvar} (H: class):
  $ wi (wss H chba) (wb (wcel H csh) (wa (wcel c0v H) (wa (wral x3 (wral y1 (wcel (co (cv x3) (cv y1) cva) H) H) H) (wral x3 (wral y1 (wcel (co (cv x3) (cv y1) csm) H) H) cc)))) $;

--| Closure of vector subtraction in a subspace of a Hilbert space. (Contributed by NM, 18-Oct-1999.) (New usage is discouraged.)
theorem shsubcl (A2 B2 H: class):
  $ wi (w3a (wcel H csh) (wcel A2 H) (wcel B2 H)) (wcel (co A2 B2 cmv) H) $;

--| Define the set of closed subspaces of a Hilbert space. A closed subspace is one in which the limit of every convergent sequence in the subspace belongs to the subspace. For its membership relation, see ~ isch . From Definition of [Beran] p. 107. Alternate definitions are given by ~ isch2 and ~ isch3 . (Contributed by NM, 17-Aug-1999.) (New usage is discouraged.)
axiom df_ch {h: setvar}:
  $ wceq cch (crab h (wss (cima chli (co (cv h) cn cmap)) (cv h)) csh) $;

--| Closed subspace ` H ` of a Hilbert space. (Contributed by NM, 17-Aug-1999.) (Revised by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem isch (H: class):
  $ wb (wcel H cch) (wa (wcel H csh) (wss (cima chli (co H cn cmap)) H)) $;

--| Closed subspace ` H ` of a Hilbert space. Definition of [Beran] p. 107. (Contributed by NM, 17-Aug-1999.) (Revised by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem isch2 {x3 f2: setvar} (H: class):
  $ wb (wcel H cch) (wa (wcel H csh) (wal f2 (wal x3 (wi (wa (wf cn H (cv f2)) (wbr (cv f2) (cv x3) chli)) (wcel (cv x3) H))))) $;

--| A closed subspace is a subspace. (Contributed by NM, 19-Oct-1999.) (Revised by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem chsh (H: class):
  $ wi (wcel H cch) (wcel H csh) $;

--| Closed subspaces are subspaces in a Hilbert space. (Contributed by NM, 29-May-1999.) (Revised by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem chsssh:
  $ wss cch csh $;

--| The set of closed subspaces of a Hilbert space exists (is a set). (Contributed by NM, 23-Oct-1999.) (New usage is discouraged.)
theorem chex:
  $ wcel cch cvv $;

--| A closed subspace is a subspace. (Contributed by NM, 19-Oct-1999.) (New usage is discouraged.)
theorem chshii (H: class):
  $ wcel H cch $ >
  $ wcel H csh $;

--| The zero vector belongs to any closed subspace of a Hilbert space. (Contributed by NM, 24-Aug-1999.) (New usage is discouraged.)
theorem ch0 (H: class):
  $ wi (wcel H cch) (wcel c0v H) $;

--| A closed subspace of a Hilbert space is a subset of Hilbert space. (Contributed by NM, 24-Aug-1999.) (New usage is discouraged.)
theorem chss (H: class):
  $ wi (wcel H cch) (wss H chba) $;

--| A member of a closed subspace of a Hilbert space is a vector. (Contributed by NM, 15-Dec-2004.) (New usage is discouraged.)
theorem chel (A2 H: class):
  $ wi (wa (wcel H cch) (wcel A2 H)) (wcel A2 chba) $;

--| A closed subspace of a Hilbert space is a subset of Hilbert space. (Contributed by NM, 6-Oct-1999.) (New usage is discouraged.)
theorem chssii (H: class):
  $ wcel H cch $ >
  $ wss H chba $;

--| A member of a closed subspace of a Hilbert space is a vector. (Contributed by NM, 6-Oct-1999.) (New usage is discouraged.)
theorem cheli (A2 H: class):
  $ wcel H cch $ >
  $ wi (wcel A2 H) (wcel A2 chba) $;

--| A member of a closed subspace of a Hilbert space is a vector. (Contributed by NM, 6-Oct-1999.) (New usage is discouraged.)
theorem chelii (A2 H: class):
  $ wcel H cch $ >
  $ wcel A2 H $ >
  $ wcel A2 chba $;

--| The limit property of a closed subspace of a Hilbert space. (Contributed by NM, 14-Sep-1999.) (New usage is discouraged.)
theorem chlimi (A2 F H: class):
  $ wcel A2 cvv $ >
  $ wi (w3a (wcel H cch) (wf cn H F) (wbr F A2 chli)) (wcel A2 H) $;

--| The zero sequence in Hilbert space converges to the zero vector. (Contributed by NM, 17-Aug-1999.) (Proof shortened by Mario Carneiro, 14-May-2014.) (New usage is discouraged.)
theorem hlim0:
  $ wbr (cxp cn (csn c0v)) c0v chli $;

--| If a sequence in Hilbert space subset converges to a limit, it is a Cauchy sequence. (Contributed by NM, 17-Aug-1999.) (Proof shortened by Mario Carneiro, 14-May-2014.) (New usage is discouraged.)
theorem hlimcaui (A2 F: class):
  $ wi (wbr F A2 chli) (wcel F ccauold) $;

--| Function-like behavior of the convergence relation. (Contributed by Mario Carneiro, 14-May-2014.) (New usage is discouraged.)
theorem hlimf:
  $ wf (cdm chli) chba chli $;

--| A Hilbert space sequence converges to at most one limit. (Contributed by NM, 19-Aug-1999.) (Revised by Mario Carneiro, 2-May-2015.) (New usage is discouraged.)
theorem hlimuni (A2 B2 F: class):
  $ wi (wa (wbr F A2 chli) (wbr F B2 chli)) (wceq A2 B2) $;

--| The limit of a Hilbert space sequence is unique. (Contributed by NM, 19-Aug-1999.) (Revised by Mario Carneiro, 14-May-2014.) (New usage is discouraged.)
theorem hlimreui {x3: setvar} (F H: class):
  $ wb (wrex x3 (wbr F (cv x3) chli) H) (wreu x3 (wbr F (cv x3) chli) H) $;

--| The limit of a Hilbert space sequence is unique. (Contributed by NM, 19-Aug-1999.) (Proof shortened by Mario Carneiro, 14-May-2014.) (New usage is discouraged.)
theorem hlimeui {x3: setvar} (F: class):
  $ wb (wex x3 (wbr F (cv x3) chli)) (weu x3 (wbr F (cv x3) chli)) $;

--| A Hilbert subspace is closed iff it is complete. A complete subspace is one in which every Cauchy sequence of vectors in the subspace converges to a member of the subspace (Definition of complete subspace in [Beran] p. 96). Remark 3.12 of [Beran] p. 107. (Contributed by NM, 24-Dec-2001.) (Revised by Mario Carneiro, 14-May-2014.) (New usage is discouraged.)
theorem isch3 {x3 f2: setvar} (H: class):
  $ wb (wcel H cch) (wa (wcel H csh) (wral f2 (wi (wf cn H (cv f2)) (wrex x3 (wbr (cv f2) (cv x3) chli) H)) ccauold)) $;

--| Completeness of a closed subspace of Hilbert space. (Contributed by NM, 4-Oct-1999.) (New usage is discouraged.)
theorem chcompl {x3: setvar} (F H: class):
  $ wi (w3a (wcel H cch) (wcel F ccauold) (wf cn H F)) (wrex x3 (wbr F (cv x3) chli) H) $;

--| The Hilbert lattice one (which is all of Hilbert space) belongs to the Hilbert lattice. Part of Proposition 1 of [Kalmbach] p. 65. (Contributed by NM, 6-Sep-1999.) (New usage is discouraged.)
theorem helch:
  $ wcel chba cch $;

--| Prove ` if ( A e. CH , A , ~H ) e. CH ` . (Contributed by David A. Wheeler, 8-Dec-2018.) (New usage is discouraged.)
theorem ifchhv (A2: class):
  $ wcel (cif (wcel A2 cch) A2 chba) cch $;

--| Hilbert space is a subspace of Hilbert space. (Contributed by NM, 2-Jun-2004.) (New usage is discouraged.)
theorem helsh:
  $ wcel chba csh $;

--| Subspaces are subsets of Hilbert space. (Contributed by NM, 24-Nov-2004.) (New usage is discouraged.)
theorem shsspwh:
  $ wss csh (cpw chba) $;

--| Closed subspaces are subsets of Hilbert space. (Contributed by NM, 24-Nov-2004.) (New usage is discouraged.)
theorem chsspwh:
  $ wss cch (cpw chba) $;

--| The zero subspace belongs to the set of closed subspaces of Hilbert space. (Contributed by NM, 14-Oct-1999.) (New usage is discouraged.)
theorem hsn0elch:
  $ wcel (csn c0v) cch $;

--| From any nonzero Hilbert space vector, construct a vector whose norm is 1. (Contributed by NM, 7-Feb-2006.) (New usage is discouraged.)
theorem norm1 (A2: class):
  $ wi (wa (wcel A2 chba) (wne A2 c0v)) (wceq (cfv (co (co c1 (cfv A2 cno) cdiv) A2 csm) cno) c1) $;

--| A normalized vector exists in a subspace iff the subspace has a nonzero vector. (Contributed by NM, 9-Apr-2006.) (New usage is discouraged.)
theorem norm1exi {x3 y1: setvar} (H: class):
  $ wcel H csh $ >
  $ wb (wrex x3 (wne (cv x3) c0v) H) (wrex y1 (wceq (cfv (cv y1) cno) c1) H) $;

--| A normalized vector exists in a subspace iff the subspace has a nonzero vector. (Contributed by NM, 9-Apr-2006.) (New usage is discouraged.)
theorem norm1exi_b {x3: setvar} (H: class):
  $ wcel H csh $ >
  $ wb (wrex x3 (wne (cv x3) c0v) H) (wrex x3 (wceq (cfv (cv x3) cno) c1) H) $;

--| A normalized vector can exist only iff the Hilbert space has a nonzero vector. (Contributed by NM, 21-Jan-2006.) (New usage is discouraged.)
theorem norm1hex {x3 y1: setvar}:
  $ wb (wrex x3 (wne (cv x3) c0v) chba) (wrex y1 (wceq (cfv (cv y1) cno) c1) chba) $;

--| A normalized vector can exist only iff the Hilbert space has a nonzero vector. (Contributed by NM, 21-Jan-2006.) (New usage is discouraged.)
theorem norm1hex_b {x3: setvar}:
  $ wb (wrex x3 (wne (cv x3) c0v) chba) (wrex x3 (wceq (cfv (cv x3) cno) c1) chba) $;

--| Define orthogonal complement of a subset (usually a subspace) of Hilbert space. The orthogonal complement is the set of all vectors orthogonal to all vectors in the subset. See ~ ocval and ~ chocvali for its value. Textbooks usually denote this unary operation with the symbol ` _|_ ` as a small superscript, although Mittelstaedt uses the symbol as a prefix operation. Here we define a function (prefix operation) ` _|_ ` rather than introducing a new syntactic form. This lets us take advantage of the theorems about functions that we already have proved under set theory. Definition of [Mittelstaedt] p. 9. (Contributed by NM, 7-Aug-2000.) (New usage is discouraged.)
axiom df_oc {x3 y1 z: setvar}:
  $ wceq cort (cmpt x3 (cpw chba) (crab y1 (wral z (wceq (co (cv y1) (cv z) csp) cc0) (cv x3)) chba)) $;

--| Define the zero for closed subspaces of Hilbert space. See ~ h0elch for closure law. (Contributed by NM, 30-May-1999.) (New usage is discouraged.)
axiom df_ch0:
  $ wceq c0h (csn c0v) $;

--| Membership in zero for closed subspaces of Hilbert space. (Contributed by NM, 6-Apr-2001.) (New usage is discouraged.)
theorem elch0 (A2: class):
  $ wb (wcel A2 c0h) (wceq A2 c0v) $;

--| The zero subspace is a closed subspace. Part of Proposition 1 of [Kalmbach] p. 65. (Contributed by NM, 30-May-1999.) (New usage is discouraged.)
theorem h0elch:
  $ wcel c0h cch $;

--| The zero subspace is a subspace of Hilbert space. (Contributed by NM, 2-Jun-2004.) (New usage is discouraged.)
theorem h0elsh:
  $ wcel c0h csh $;

--| The vector addition operation on a subspace. (Contributed by NM, 8-Apr-2008.) (New usage is discouraged.)
theorem hhssva (H W: class):
  $ wceq W (cop (cop (cres cva (cxp H H)) (cres csm (cxp cc H))) (cres cno H)) $ >
  $ wceq (cres cva (cxp H H)) (cfv W cpv) $;

--| The scalar multiplication operation on a subspace. (Contributed by NM, 8-Apr-2008.) (New usage is discouraged.)
theorem hhsssm (H W: class):
  $ wceq W (cop (cop (cres cva (cxp H H)) (cres csm (cxp cc H))) (cres cno H)) $ >
  $ wceq (cres csm (cxp cc H)) (cfv W cns) $;

--| The norm operation on a subspace. (Contributed by NM, 8-Apr-2008.) (New usage is discouraged.)
theorem hhssnm (H W: class):
  $ wceq W (cop (cop (cres cva (cxp H H)) (cres csm (cxp cc H))) (cres cno H)) $ >
  $ wceq (cres cno H) (cfv W cnmcv) $;

--| Lemma for ~ hhssabloilem . (Contributed by Paul Chapman, 25-Feb-2008.) (New usage is discouraged.)
theorem issubgoilem {x3 y1: setvar} (A2: class) (B2: class x3) (G H Y: class):
  $ wi (wa (wcel (cv x3) Y) (wcel (cv y1) Y)) (wceq (co (cv x3) (cv y1) H) (co (cv x3) (cv y1) G)) $ >
  $ wi (wa (wcel A2 Y) (wcel B2 Y)) (wceq (co A2 B2 H) (co A2 B2 G)) $;

--| Lemma for ~ hhssabloi . Formerly part of proof for ~ hhssabloi which was based on the deprecated definition "SubGrpOp" for subgroups. (Contributed by NM, 9-Apr-2008.) (Revised by Mario Carneiro, 23-Dec-2013.) (Revised by AV, 27-Aug-2021.) (New usage is discouraged.)
theorem hhssabloilem (H: class):
  $ wcel H csh $ >
  $ w3a (wcel cva cgr) (wcel (cres cva (cxp H H)) cgr) (wss (cres cva (cxp H H)) cva) $;

--| Abelian group property of subspace addition. (Contributed by NM, 9-Apr-2008.) (Revised by Mario Carneiro, 23-Dec-2013.) (Proof shortened by AV, 27-Aug-2021.) (New usage is discouraged.)
theorem hhssabloi (H: class):
  $ wcel H csh $ >
  $ wcel (cres cva (cxp H H)) cablo $;

--| Abelian group property of subspace addition. (Contributed by NM, 9-Apr-2008.) (New usage is discouraged.)
theorem hhssablo (H: class):
  $ wi (wcel H csh) (wcel (cres cva (cxp H H)) cablo) $;

--| Normed complex vector space property of a subspace. (Contributed by NM, 26-Mar-2008.) (New usage is discouraged.)
theorem hhssnv (H W: class):
  $ wceq W (cop (cop (cres cva (cxp H H)) (cres csm (cxp cc H))) (cres cno H)) $ >
  $ wcel H csh $ >
  $ wcel W cnv $;

--| Normed complex vector space property of a subspace. (Contributed by NM, 9-Apr-2008.) (New usage is discouraged.)
theorem hhssnvt (H W: class):
  $ wceq W (cop (cop (cres cva (cxp H H)) (cres csm (cxp cc H))) (cres cno H)) $ >
  $ wi (wcel H csh) (wcel W cnv) $;

--| A member of ` SH ` is a subspace. (Contributed by NM, 6-Apr-2008.) (New usage is discouraged.)
theorem hhsst (U H W: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wceq W (cop (cop (cres cva (cxp H H)) (cres csm (cxp cc H))) (cres cno H)) $ >
  $ wi (wcel H csh) (wcel W (cfv U css)) $;

--| Lemma for ~ hhsssh . (Contributed by NM, 10-Apr-2008.) (New usage is discouraged.)
theorem hhshsslem1 (U H W: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wceq W (cop (cop (cres cva (cxp H H)) (cres csm (cxp cc H))) (cres cno H)) $ >
  $ wcel W (cfv U css) $ >
  $ wss H chba $ >
  $ wceq H (cfv W cba) $;

--| Lemma for ~ hhsssh . (Contributed by NM, 6-Apr-2008.) (New usage is discouraged.)
theorem hhshsslem2 (U H W: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wceq W (cop (cop (cres cva (cxp H H)) (cres csm (cxp cc H))) (cres cno H)) $ >
  $ wcel W (cfv U css) $ >
  $ wss H chba $ >
  $ wcel H csh $;

--| The predicate " ` H ` is a subspace of Hilbert space." (Contributed by NM, 25-Mar-2008.) (New usage is discouraged.)
theorem hhsssh (U H W: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wceq W (cop (cop (cres cva (cxp H H)) (cres csm (cxp cc H))) (cres cno H)) $ >
  $ wb (wcel H csh) (wa (wcel W (cfv U css)) (wss H chba)) $;

--| The predicate " ` H ` is a subspace of Hilbert space." (Contributed by NM, 8-Apr-2008.) (New usage is discouraged.)
theorem hhsssh2 (H W: class):
  $ wceq W (cop (cop (cres cva (cxp H H)) (cres csm (cxp cc H))) (cres cno H)) $ >
  $ wb (wcel H csh) (wa (wcel W cnv) (wss H chba)) $;

--| The base set of a subspace. (Contributed by NM, 10-Apr-2008.) (New usage is discouraged.)
theorem hhssba (H W: class):
  $ wceq W (cop (cop (cres cva (cxp H H)) (cres csm (cxp cc H))) (cres cno H)) $ >
  $ wcel H csh $ >
  $ wceq H (cfv W cba) $;

--| The vector subtraction operation on a subspace. (Contributed by NM, 10-Apr-2008.) (New usage is discouraged.)
theorem hhssvs (H W: class):
  $ wceq W (cop (cop (cres cva (cxp H H)) (cres csm (cxp cc H))) (cres cno H)) $ >
  $ wcel H csh $ >
  $ wceq (cres cmv (cxp H H)) (cfv W cnsb) $;

--| Mapping of the vector subtraction operation on a subspace. (Contributed by NM, 10-Apr-2008.) (New usage is discouraged.)
theorem hhssvsf (H W: class):
  $ wceq W (cop (cop (cres cva (cxp H H)) (cres csm (cxp cc H))) (cres cno H)) $ >
  $ wcel H csh $ >
  $ wf (cxp H H) H (cres cmv (cxp H H)) $;

--| Induced metric of a subspace. (Contributed by NM, 10-Apr-2008.) (New usage is discouraged.)
theorem hhssims (D H W: class):
  $ wceq W (cop (cop (cres cva (cxp H H)) (cres csm (cxp cc H))) (cres cno H)) $ >
  $ wcel H csh $ >
  $ wceq D (cres (ccom cno cmv) (cxp H H)) $ >
  $ wceq D (cfv W cims) $;

--| Induced metric of a subspace. (Contributed by NM, 10-Apr-2008.) (New usage is discouraged.)
theorem hhssims2 (D H W: class):
  $ wceq W (cop (cop (cres cva (cxp H H)) (cres csm (cxp cc H))) (cres cno H)) $ >
  $ wceq D (cfv W cims) $ >
  $ wcel H csh $ >
  $ wceq D (cres (ccom cno cmv) (cxp H H)) $;

--| Induced metric of a subspace. (Contributed by NM, 10-Apr-2008.) (New usage is discouraged.)
theorem hhssmet (D H W: class):
  $ wceq W (cop (cop (cres cva (cxp H H)) (cres csm (cxp cc H))) (cres cno H)) $ >
  $ wceq D (cfv W cims) $ >
  $ wcel H csh $ >
  $ wcel D (cfv H cmet) $;

--| Value of the distance function of the metric space of a subspace. (Contributed by NM, 10-Apr-2008.) (New usage is discouraged.)
theorem hhssmetdval (A2 B2 D H W: class):
  $ wceq W (cop (cop (cres cva (cxp H H)) (cres csm (cxp cc H))) (cres cno H)) $ >
  $ wceq D (cfv W cims) $ >
  $ wcel H csh $ >
  $ wi (wa (wcel A2 H) (wcel B2 H)) (wceq (co A2 B2 D) (cfv (co A2 B2 cmv) cno)) $;

--| The induced metric of a closed subspace is complete. (Contributed by NM, 10-Apr-2008.) (Revised by Mario Carneiro, 14-May-2014.) (New usage is discouraged.)
theorem hhsscms (D H W: class):
  $ wceq W (cop (cop (cres cva (cxp H H)) (cres csm (cxp cc H))) (cres cno H)) $ >
  $ wceq D (cfv W cims) $ >
  $ wcel H cch $ >
  $ wcel D (cfv H ccmet) $;

--| Obsolete version of ~ cssbn : Banach space property of a closed subspace. (Contributed by NM, 10-Apr-2008.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem hhssbnOLD (H W: class):
  $ wceq W (cop (cop (cres cva (cxp H H)) (cres csm (cxp cc H))) (cres cno H)) $ >
  $ wcel H cch $ >
  $ wcel W ccbn $;

--| Value of orthogonal complement of a subset of Hilbert space. (Contributed by NM, 7-Aug-2000.) (Revised by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem ocval {x3 y1: setvar} (H: class):
  $ wi (wss H chba) (wceq (cfv H cort) (crab x3 (wral y1 (wceq (co (cv x3) (cv y1) csp) cc0) H) chba)) $;

--| Membership in orthogonal complement of H subset. (Contributed by NM, 7-Aug-2000.) (New usage is discouraged.)
theorem ocel {x3: setvar} (A2 H: class):
  $ wi (wss H chba) (wb (wcel A2 (cfv H cort)) (wa (wcel A2 chba) (wral x3 (wceq (co A2 (cv x3) csp) cc0) H))) $;

--| Membership in orthogonal complement of H subspace. (Contributed by NM, 9-Oct-1999.) (New usage is discouraged.)
theorem shocel {x3: setvar} (A2 H: class):
  $ wi (wcel H csh) (wb (wcel A2 (cfv H cort)) (wa (wcel A2 chba) (wral x3 (wceq (co A2 (cv x3) csp) cc0) H))) $;

--| The orthogonal complement of a subspace is a subspace. Part of Remark 3.12 of [Beran] p. 107. (Contributed by NM, 7-Aug-2000.) (New usage is discouraged.)
theorem ocsh (A2: class):
  $ wi (wss A2 chba) (wcel (cfv A2 cort) csh) $;

--| The orthogonal complement of a subspace is a subspace. Part of Remark 3.12 of [Beran] p. 107. (Contributed by NM, 10-Oct-1999.) (New usage is discouraged.)
theorem shocsh (A2: class):
  $ wi (wcel A2 csh) (wcel (cfv A2 cort) csh) $;

--| An orthogonal complement is a subset of Hilbert space. (Contributed by NM, 9-Aug-2000.) (New usage is discouraged.)
theorem ocss (A2: class):
  $ wi (wss A2 chba) (wss (cfv A2 cort) chba) $;

--| An orthogonal complement is a subset of Hilbert space. (Contributed by NM, 11-Oct-1999.) (New usage is discouraged.)
theorem shocss (A2: class):
  $ wi (wcel A2 csh) (wss (cfv A2 cort) chba) $;

--| Contraposition law for orthogonal complement. (Contributed by NM, 8-Aug-2000.) (New usage is discouraged.)
theorem occon (A2 B2: class):
  $ wi (wa (wss A2 chba) (wss B2 chba)) (wi (wss A2 B2) (wss (cfv B2 cort) (cfv A2 cort))) $;

--| Double contraposition for orthogonal complement. (Contributed by NM, 22-Jul-2001.) (New usage is discouraged.)
theorem occon2 (A2 B2: class):
  $ wi (wa (wss A2 chba) (wss B2 chba)) (wi (wss A2 B2) (wss (cfv (cfv A2 cort) cort) (cfv (cfv B2 cort) cort))) $;

--| Double contraposition for orthogonal complement. (Contributed by NM, 9-Aug-2000.) (New usage is discouraged.)
theorem occon2i (A2 B2: class):
  $ wss A2 chba $ >
  $ wss B2 chba $ >
  $ wi (wss A2 B2) (wss (cfv (cfv A2 cort) cort) (cfv (cfv B2 cort) cort)) $;

--| The zero vector belongs to an orthogonal complement of a Hilbert subspace. (Contributed by NM, 11-Oct-1999.) (New usage is discouraged.)
theorem oc0 (H: class):
  $ wi (wcel H csh) (wcel c0v (cfv H cort)) $;

--| Members of a subset and its complement are orthogonal. (Contributed by NM, 9-Aug-2000.) (New usage is discouraged.)
theorem ocorth (A2 B2 H: class):
  $ wi (wss H chba) (wi (wa (wcel A2 H) (wcel B2 (cfv H cort))) (wceq (co A2 B2 csp) cc0)) $;

--| Members of a subspace and its complement are orthogonal. (Contributed by NM, 10-Oct-1999.) (New usage is discouraged.)
theorem shocorth (A2 B2 H: class):
  $ wi (wcel H csh) (wi (wa (wcel A2 H) (wcel B2 (cfv H cort))) (wceq (co A2 B2 csp) cc0)) $;

--| Inclusion in complement of complement. Part of Proposition 1 of [Kalmbach] p. 65. (Contributed by NM, 9-Aug-2000.) (New usage is discouraged.)
theorem ococss (A2: class):
  $ wi (wss A2 chba) (wss A2 (cfv (cfv A2 cort) cort)) $;

--| Inclusion in complement of complement. Part of Proposition 1 of [Kalmbach] p. 65. (Contributed by NM, 10-Oct-1999.) (New usage is discouraged.)
theorem shococss (A2: class):
  $ wi (wcel A2 csh) (wss A2 (cfv (cfv A2 cort) cort)) $;

--| Members of orthogonal subspaces are orthogonal. (Contributed by NM, 17-Oct-1999.) (New usage is discouraged.)
theorem shorth (A2 B2 G H: class):
  $ wi (wcel H csh) (wi (wss G (cfv H cort)) (wi (wa (wcel A2 G) (wcel B2 H)) (wceq (co A2 B2 csp) cc0))) $;

--| Intersection of a Hilbert subspace and its complement. Part of Proposition 1 of [Kalmbach] p. 65. (Contributed by NM, 11-Oct-1999.) (New usage is discouraged.)
theorem ocin (A2: class):
  $ wi (wcel A2 csh) (wceq (cin A2 (cfv A2 cort)) c0h) $;

--| Hilbert lattice contraposition law. (Contributed by Mario Carneiro, 18-May-2014.) (New usage is discouraged.)
theorem occon3 (A2 B2: class):
  $ wi (wa (wss A2 chba) (wss B2 chba)) (wb (wss A2 (cfv B2 cort)) (wss B2 (cfv A2 cort))) $;

--| A nonzero vector in the complement of a subspace does not belong to the subspace. (Contributed by NM, 10-Apr-2006.) (New usage is discouraged.)
theorem ocnel (A2 H: class):
  $ wi (w3a (wcel H csh) (wcel A2 (cfv H cort)) (wne A2 c0v)) (wn (wcel A2 H)) $;

--| Value of the orthogonal complement of a Hilbert lattice element. The orthogonal complement of ` A ` is the set of vectors that are orthogonal to all vectors in ` A ` . (Contributed by NM, 8-Aug-2004.) (New usage is discouraged.)
theorem chocvali {x3 y1: setvar} (A2: class):
  $ wcel A2 cch $ >
  $ wceq (cfv A2 cort) (crab x3 (wral y1 (wceq (co (cv x3) (cv y1) csp) cc0) A2) chba) $;

--| Two subspaces with trivial intersection have a unique decomposition of the elements of the subspace sum. (Contributed by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem shuni (ph: wff) (A2 B2 C D H K: class):
  $ wi ph (wcel H csh) $ >
  $ wi ph (wcel K csh) $ >
  $ wi ph (wceq (cin H K) c0h) $ >
  $ wi ph (wcel A2 H) $ >
  $ wi ph (wcel B2 K) $ >
  $ wi ph (wcel C H) $ >
  $ wi ph (wcel D K) $ >
  $ wi ph (wceq (co A2 B2 cva) (co C D cva)) $ >
  $ wi ph (wa (wceq A2 C) (wceq B2 D)) $;

--| Lemma for uniqueness part of Projection Theorem. Theorem 3.7(i) of [Beran] p. 102 (uniqueness part). (Contributed by NM, 23-Oct-1999.) (Proof shortened by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem chocunii (A2 B2 C D R H: class):
  $ wcel H cch $ >
  $ wi (wa (wa (wcel A2 H) (wcel B2 (cfv H cort))) (wa (wcel C H) (wcel D (cfv H cort)))) (wi (wa (wceq R (co A2 B2 cva)) (wceq R (co C D cva))) (wa (wceq A2 C) (wceq B2 D))) $;

--| Projection Theorem, uniqueness part. Any two disjoint subspaces yield a unique decomposition of vectors into each subspace. (Contributed by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem pjhthmo {x3 y1: setvar} (A2 B2 C: class):
  $ wi (w3a (wcel A2 csh) (wcel B2 csh) (wceq (cin A2 B2) c0h)) (wmo x3 (wa (wcel (cv x3) A2) (wrex y1 (wceq C (co (cv x3) (cv y1) cva)) B2))) $;

--| Lemma for ~ occl . (Contributed by NM, 7-Aug-2000.) (Revised by Mario Carneiro, 14-May-2014.) (New usage is discouraged.)
theorem occllem (ph: wff) (A2 B2 F: class):
  $ wi ph (wss A2 chba) $ >
  $ wi ph (wcel F ccauold) $ >
  $ wi ph (wf cn (cfv A2 cort) F) $ >
  $ wi ph (wcel B2 A2) $ >
  $ wi ph (wceq (co (cfv F chli) B2 csp) cc0) $;

--| Closure of complement of Hilbert subset. Part of Remark 3.12 of [Beran] p. 107. (Contributed by NM, 8-Aug-2000.) (Proof shortened by Mario Carneiro, 14-May-2014.) (New usage is discouraged.)
theorem occl (A2: class):
  $ wi (wss A2 chba) (wcel (cfv A2 cort) cch) $;

--| Closure of complement of Hilbert subspace. Part of Remark 3.12 of [Beran] p. 107. (Contributed by NM, 13-Oct-1999.) (New usage is discouraged.)
theorem shoccl (A2: class):
  $ wi (wcel A2 csh) (wcel (cfv A2 cort) cch) $;

--| Closure of complement of Hilbert subspace. Part of Remark 3.12 of [Beran] p. 107. (Contributed by NM, 22-Jul-2001.) (New usage is discouraged.)
theorem choccl (A2: class):
  $ wi (wcel A2 cch) (wcel (cfv A2 cort) cch) $;

--| Closure of ` CH ` orthocomplement. (Contributed by NM, 29-Jul-1999.) (New usage is discouraged.)
theorem choccli (A2: class):
  $ wcel A2 cch $ >
  $ wcel (cfv A2 cort) cch $;

--| Define subspace sum in ` SH ` . See ~ shsval , ~ shsval2i , and ~ shsval3i for its value. (Contributed by NM, 16-Oct-1999.) (New usage is discouraged.)
axiom df_shs {x3 y1: setvar}:
  $ wceq cph (cmpo x3 y1 csh csh (cima cva (cxp (cv x3) (cv y1)))) $;

--| Define the linear span of a subset of Hilbert space. Definition of span in [Schechter] p. 276. See ~ spanval for its value. (Contributed by NM, 2-Jun-2004.) (New usage is discouraged.)
axiom df_span {x3 y1: setvar}:
  $ wceq cspn (cmpt x3 (cpw chba) (cint (crab y1 (wss (cv x3) (cv y1)) csh))) $;

--| Define Hilbert lattice join. See ~ chjval for its value and ~ chjcl for its closure law. Note that we define it over all Hilbert space subsets to allow proving more general theorems. Even for general subsets the join belongs to ` CH ` ; see ~ sshjcl . (Contributed by NM, 1-Nov-2000.) (New usage is discouraged.)
axiom df_chj {x3 y1: setvar}:
  $ wceq chj (cmpo x3 y1 (cpw chba) (cpw chba) (cfv (cfv (cun (cv x3) (cv y1)) cort) cort)) $;

--| Define the supremum of a set of Hilbert lattice elements. See ~ chsupval2 for its value. We actually define the supremum for an arbitrary collection of Hilbert space subsets, not just elements of the Hilbert lattice ` CH ` , to allow more general theorems. Even for general subsets the supremum still a Hilbert lattice element; see ~ hsupcl . (Contributed by NM, 9-Dec-2003.) (New usage is discouraged.)
axiom df_chsup {x3: setvar}:
  $ wceq chsup (cmpt x3 (cpw (cpw chba)) (cfv (cfv (cuni (cv x3)) cort) cort)) $;

--| Value of subspace sum of two Hilbert space subspaces. Definition of subspace sum in [Kalmbach] p. 65. (Contributed by NM, 16-Oct-1999.) (Revised by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem shsval (A2 B2: class):
  $ wi (wa (wcel A2 csh) (wcel B2 csh)) (wceq (co A2 B2 cph) (cima cva (cxp A2 B2))) $;

--| The subspace sum is a subset of Hilbert space. (Contributed by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem shsss (A2 B2: class):
  $ wi (wa (wcel A2 csh) (wcel B2 csh)) (wss (co A2 B2 cph) chba) $;

--| Membership in the subspace sum of two Hilbert subspaces. (Contributed by NM, 14-Dec-2004.) (Revised by Mario Carneiro, 29-Jan-2014.) (New usage is discouraged.)
theorem shsel {x3 y1: setvar} (A2 B2 C: class):
  $ wi (wa (wcel A2 csh) (wcel B2 csh)) (wb (wcel C (co A2 B2 cph)) (wrex x3 (wrex y1 (wceq C (co (cv x3) (cv y1) cva)) B2) A2)) $;

--| Membership in the subspace sum of two Hilbert subspaces, using vector subtraction. (Contributed by NM, 20-Jan-2007.) (New usage is discouraged.)
theorem shsel3 {x3 y1: setvar} (A2 B2 C: class):
  $ wi (wa (wcel A2 csh) (wcel B2 csh)) (wb (wcel C (co A2 B2 cph)) (wrex x3 (wrex y1 (wceq C (co (cv x3) (cv y1) cmv)) B2) A2)) $;

--| Membership in subspace sum. (Contributed by NM, 4-May-2000.) (New usage is discouraged.)
theorem shseli {x3 y1: setvar} (A2 B2 C: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wb (wcel C (co A2 B2 cph)) (wrex x3 (wrex y1 (wceq C (co (cv x3) (cv y1) cva)) B2) A2) $;

--| Closure of subspace sum. (Contributed by NM, 15-Oct-1999.) (Revised by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem shscli (A2 B2: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wcel (co A2 B2 cph) csh $;

--| Closure of subspace sum. (Contributed by NM, 15-Dec-2004.) (New usage is discouraged.)
theorem shscl (A2 B2: class):
  $ wi (wa (wcel A2 csh) (wcel B2 csh)) (wcel (co A2 B2 cph) csh) $;

--| Commutative law for subspace sum. (Contributed by NM, 15-Dec-2004.) (New usage is discouraged.)
theorem shscom (A2 B2: class):
  $ wi (wa (wcel A2 csh) (wcel B2 csh)) (wceq (co A2 B2 cph) (co B2 A2 cph)) $;

--| Vector sum belongs to subspace sum. (Contributed by NM, 15-Dec-2004.) (New usage is discouraged.)
theorem shsva (A2 B2 C D: class):
  $ wi (wa (wcel A2 csh) (wcel B2 csh)) (wi (wa (wcel C A2) (wcel D B2)) (wcel (co C D cva) (co A2 B2 cph))) $;

--| A subspace sum contains a member of one of its subspaces. (Contributed by NM, 15-Dec-2004.) (New usage is discouraged.)
theorem shsel1 (A2 B2 C: class):
  $ wi (wa (wcel A2 csh) (wcel B2 csh)) (wi (wcel C A2) (wcel C (co A2 B2 cph))) $;

--| A subspace sum contains a member of one of its subspaces. (Contributed by NM, 15-Dec-2004.) (New usage is discouraged.)
theorem shsel2 (A2 B2 C: class):
  $ wi (wa (wcel A2 csh) (wcel B2 csh)) (wi (wcel C B2) (wcel C (co A2 B2 cph))) $;

--| Vector subtraction belongs to subspace sum. (Contributed by NM, 15-Dec-2004.) (New usage is discouraged.)
theorem shsvs (A2 B2 C D: class):
  $ wi (wa (wcel A2 csh) (wcel B2 csh)) (wi (wa (wcel C A2) (wcel D B2)) (wcel (co C D cmv) (co A2 B2 cph))) $;

--| Subspace sum is an upper bound of its arguments. (Contributed by NM, 14-Dec-2004.) (New usage is discouraged.)
theorem shsub1 (A2 B2: class):
  $ wi (wa (wcel A2 csh) (wcel B2 csh)) (wss A2 (co A2 B2 cph)) $;

--| Subspace sum is an upper bound of its arguments. (Contributed by NM, 17-Dec-2004.) (New usage is discouraged.)
theorem shsub2 (A2 B2: class):
  $ wi (wa (wcel A2 csh) (wcel B2 csh)) (wss A2 (co B2 A2 cph)) $;

--| The orthocomplement of the zero subspace is the unit subspace. (Contributed by NM, 15-Oct-1999.) (New usage is discouraged.)
theorem choc0:
  $ wceq (cfv c0h cort) chba $;

--| The orthocomplement of the unit subspace is the zero subspace. Does not require Axiom of Choice. (Contributed by NM, 24-Oct-1999.) (New usage is discouraged.)
theorem choc1:
  $ wceq (cfv chba cort) c0h $;

--| Orthogonal complement of the empty set. (Contributed by NM, 31-Oct-2000.) (New usage is discouraged.)
theorem chocnul:
  $ wceq (cfv c0 cort) chba $;

--| Closure of intersection of a nonempty subset of ` SH ` . (Contributed by NM, 14-Oct-1999.) (New usage is discouraged.)
theorem shintcli (A2: class):
  $ wa (wss A2 csh) (wne A2 c0) $ >
  $ wcel (cint A2) csh $;

--| The intersection of a nonempty set of subspaces is a subspace. (Contributed by NM, 2-Jun-2004.) (New usage is discouraged.)
theorem shintcl (A2: class):
  $ wi (wa (wss A2 csh) (wne A2 c0)) (wcel (cint A2) csh) $;

--| The intersection of a nonempty set of closed subspaces is a closed subspace. (Contributed by NM, 14-Oct-1999.) (New usage is discouraged.)
theorem chintcli (A2: class):
  $ wa (wss A2 cch) (wne A2 c0) $ >
  $ wcel (cint A2) cch $;

--| The intersection (infimum) of a nonempty subset of ` CH ` belongs to ` CH ` . Part of Theorem 3.13 of [Beran] p. 108. Also part of Definition 3.4-1 in [MegPav2000] p. 2345 (PDF p. 8). (Contributed by NM, 14-Oct-1999.) (New usage is discouraged.)
theorem chintcl (A2: class):
  $ wi (wa (wss A2 cch) (wne A2 c0)) (wcel (cint A2) cch) $;

--| Value of the linear span of a subset of Hilbert space. The span is the intersection of all subspaces constraining the subset. Definition of span in [Schechter] p. 276. (Contributed by NM, 2-Jun-2004.) (Revised by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem spanval {x3: setvar} (A2: class):
  $ wi (wss A2 chba) (wceq (cfv A2 cspn) (cint (crab x3 (wss A2 (cv x3)) csh))) $;

--| Value of supremum of set of subsets of Hilbert space. For an alternate version of the value, see ~ hsupval2 . (Contributed by NM, 9-Dec-2003.) (Revised by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem hsupval (A2: class):
  $ wi (wss A2 (cpw chba)) (wceq (cfv A2 chsup) (cfv (cfv (cuni A2) cort) cort)) $;

--| The value of the supremum of a set of closed subspaces of Hilbert space. For an alternate version of the value, see ~ chsupval2 . (Contributed by NM, 13-Aug-2002.) (New usage is discouraged.)
theorem chsupval (A2: class):
  $ wi (wss A2 cch) (wceq (cfv A2 chsup) (cfv (cfv (cuni A2) cort) cort)) $;

--| The span of a subset of Hilbert space is a subspace. (Contributed by NM, 2-Jun-2004.) (New usage is discouraged.)
theorem spancl (A2: class):
  $ wi (wss A2 chba) (wcel (cfv A2 cspn) csh) $;

--| A member of a span is a vector. (Contributed by NM, 17-Dec-2004.) (New usage is discouraged.)
theorem elspancl (A2 B2: class):
  $ wi (wa (wss A2 chba) (wcel B2 (cfv A2 cspn))) (wcel B2 chba) $;

--| Closure of the subspace supremum of set of subsets of Hilbert space. (Contributed by NM, 26-Nov-2004.) (New usage is discouraged.)
theorem shsupcl (A2: class):
  $ wi (wss A2 (cpw chba)) (wcel (cfv (cuni A2) cspn) csh) $;

--| Closure of supremum of set of subsets of Hilbert space. Note that the supremum belongs to ` CH ` even if the subsets do not. (Contributed by NM, 10-Nov-1999.) (Revised by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem hsupcl (A2: class):
  $ wi (wss A2 (cpw chba)) (wcel (cfv A2 chsup) cch) $;

--| Closure of supremum of subset of ` CH ` . Definition of supremum in Proposition 1 of [Kalmbach] p. 65. Shows that ` CH ` is a complete lattice. Also part of Definition 3.4-1 in [MegPav2000] p. 2345 (PDF p. 8). (Contributed by NM, 10-Nov-1999.) (New usage is discouraged.)
theorem chsupcl (A2: class):
  $ wi (wss A2 cch) (wcel (cfv A2 chsup) cch) $;

--| Subset relation for supremum of Hilbert space subsets. (Contributed by NM, 24-Nov-2004.) (Revised by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem hsupss (A2 B2: class):
  $ wi (wa (wss A2 (cpw chba)) (wss B2 (cpw chba))) (wi (wss A2 B2) (wss (cfv A2 chsup) (cfv B2 chsup))) $;

--| Subset relation for supremum of subset of ` CH ` . (Contributed by NM, 13-Aug-2002.) (New usage is discouraged.)
theorem chsupss (A2 B2: class):
  $ wi (wa (wss A2 cch) (wss B2 cch)) (wi (wss A2 B2) (wss (cfv A2 chsup) (cfv B2 chsup))) $;

--| The union of a set of Hilbert space subsets is smaller than its supremum. (Contributed by NM, 24-Nov-2004.) (Revised by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem hsupunss (A2: class):
  $ wi (wss A2 (cpw chba)) (wss (cuni A2) (cfv A2 chsup)) $;

--| The union of a set of closed subspaces is smaller than its supremum. (Contributed by NM, 14-Aug-2002.) (New usage is discouraged.)
theorem chsupunss (A2: class):
  $ wi (wss A2 cch) (wss (cuni A2) (cfv A2 chsup)) $;

--| A subset of Hilbert space is included in its span. (Contributed by NM, 2-Jun-2004.) (New usage is discouraged.)
theorem spanss2 (A2: class):
  $ wi (wss A2 chba) (wss A2 (cfv A2 cspn)) $;

--| The union of a set of subspaces is smaller than its supremum. (Contributed by NM, 26-Nov-2004.) (New usage is discouraged.)
theorem shsupunss (A2: class):
  $ wi (wss A2 csh) (wss (cuni A2) (cfv (cuni A2) cspn)) $;

--| A subspace of Hilbert space is its own span. (Contributed by NM, 2-Jun-2004.) (New usage is discouraged.)
theorem spanid (A2: class):
  $ wi (wcel A2 csh) (wceq (cfv A2 cspn) A2) $;

--| Ordering relationship for the spans of subsets of Hilbert space. (Contributed by NM, 2-Jun-2004.) (New usage is discouraged.)
theorem spanss (A2 B2: class):
  $ wi (wa (wss B2 chba) (wss A2 B2)) (wss (cfv A2 cspn) (cfv B2 cspn)) $;

--| The span of a subset of Hilbert space is less than or equal to its closure (double orthogonal complement). (Contributed by NM, 3-Jun-2004.) (New usage is discouraged.)
theorem spanssoc (A2: class):
  $ wi (wss A2 chba) (wss (cfv A2 cspn) (cfv (cfv A2 cort) cort)) $;

--| Value of join for subsets of Hilbert space. (Contributed by NM, 1-Nov-2000.) (Revised by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem sshjval (A2 B2: class):
  $ wi (wa (wss A2 chba) (wss B2 chba)) (wceq (co A2 B2 chj) (cfv (cfv (cun A2 B2) cort) cort)) $;

--| Value of join in ` SH ` . (Contributed by NM, 9-Aug-2000.) (New usage is discouraged.)
theorem shjval (A2 B2: class):
  $ wi (wa (wcel A2 csh) (wcel B2 csh)) (wceq (co A2 B2 chj) (cfv (cfv (cun A2 B2) cort) cort)) $;

--| Value of join in ` CH ` . (Contributed by NM, 9-Aug-2000.) (New usage is discouraged.)
theorem chjval (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wceq (co A2 B2 chj) (cfv (cfv (cun A2 B2) cort) cort)) $;

--| Value of join in ` CH ` . (Contributed by NM, 9-Aug-2000.) (New usage is discouraged.)
theorem chjvali (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wceq (co A2 B2 chj) (cfv (cfv (cun A2 B2) cort) cort) $;

--| Value of join for subsets of Hilbert space in terms of supremum: the join is the supremum of its two arguments. Based on the definition of join in [Beran] p. 3. For later convenience we prove a general version that works for any subset of Hilbert space, not just the elements of the lattice ` CH ` . (Contributed by NM, 2-Mar-2004.) (Revised by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem sshjval3 (A2 B2: class):
  $ wi (wa (wss A2 chba) (wss B2 chba)) (wceq (co A2 B2 chj) (cfv (cpr A2 B2) chsup)) $;

--| Closure of join for subsets of Hilbert space. (Contributed by NM, 1-Nov-2000.) (New usage is discouraged.)
theorem sshjcl (A2 B2: class):
  $ wi (wa (wss A2 chba) (wss B2 chba)) (wcel (co A2 B2 chj) cch) $;

--| Closure of join in ` SH ` . (Contributed by NM, 2-Nov-1999.) (New usage is discouraged.)
theorem shjcl (A2 B2: class):
  $ wi (wa (wcel A2 csh) (wcel B2 csh)) (wcel (co A2 B2 chj) cch) $;

--| Closure of join in ` CH ` . (Contributed by NM, 2-Nov-1999.) (New usage is discouraged.)
theorem chjcl (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wcel (co A2 B2 chj) cch) $;

--| Commutative law for Hilbert lattice join of subspaces. (Contributed by NM, 22-Jun-2004.) (New usage is discouraged.)
theorem shjcom (A2 B2: class):
  $ wi (wa (wcel A2 csh) (wcel B2 csh)) (wceq (co A2 B2 chj) (co B2 A2 chj)) $;

--| Subset implies subset of subspace sum. (Contributed by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem shless (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 csh) (wcel B2 csh) (wcel C csh)) (wss A2 B2)) (wss (co A2 C cph) (co B2 C cph)) $;

--| Add disjunct to both sides of Hilbert subspace ordering. (Contributed by NM, 22-Jun-2004.) (Revised by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem shlej1 (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 csh) (wcel B2 csh) (wcel C csh)) (wss A2 B2)) (wss (co A2 C chj) (co B2 C chj)) $;

--| Add disjunct to both sides of Hilbert subspace ordering. (Contributed by NM, 22-Jun-2004.) (New usage is discouraged.)
theorem shlej2 (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 csh) (wcel B2 csh) (wcel C csh)) (wss A2 B2)) (wss (co C A2 chj) (co C B2 chj)) $;

--| Closure of intersection of two subspaces. (Contributed by NM, 19-Oct-1999.) (New usage is discouraged.)
theorem shincli (A2 B2: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wcel (cin A2 B2) csh $;

--| Commutative law for subspace sum. (Contributed by NM, 17-Oct-1999.) (New usage is discouraged.)
theorem shscomi (A2 B2: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wceq (co A2 B2 cph) (co B2 A2 cph) $;

--| Vector sum belongs to subspace sum. (Contributed by NM, 17-Oct-1999.) (New usage is discouraged.)
theorem shsvai (A2 B2 C D: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wi (wa (wcel C A2) (wcel D B2)) (wcel (co C D cva) (co A2 B2 cph)) $;

--| A subspace sum contains a member of one of its subspaces. (Contributed by NM, 19-Oct-1999.) (New usage is discouraged.)
theorem shsel1i (A2 B2 C: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wi (wcel C A2) (wcel C (co A2 B2 cph)) $;

--| A subspace sum contains a member of one of its subspaces. (Contributed by NM, 19-Oct-1999.) (New usage is discouraged.)
theorem shsel2i (A2 B2 C: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wi (wcel C B2) (wcel C (co A2 B2 cph)) $;

--| Vector subtraction belongs to subspace sum. (Contributed by NM, 19-Oct-1999.) (New usage is discouraged.)
theorem shsvsi (A2 B2 C D: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wi (wa (wcel C A2) (wcel D B2)) (wcel (co C D cmv) (co A2 B2 cph)) $;

--| Union is smaller than subspace sum. (Contributed by NM, 18-Oct-1999.) (New usage is discouraged.)
theorem shunssi (A2 B2: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wss (cun A2 B2) (co A2 B2 cph) $;

--| Union is smaller than Hilbert lattice join. (Contributed by NM, 11-Jun-2004.) (Revised by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem shunssji (A2 B2: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wss (cun A2 B2) (co A2 B2 chj) $;

--| Subspace sum is smaller than Hilbert lattice join. Remark in [Kalmbach] p. 65. (Contributed by NM, 19-Oct-1999.) (Revised by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem shsleji (A2 B2: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wss (co A2 B2 cph) (co A2 B2 chj) $;

--| Commutative law for join in ` SH ` . (Contributed by NM, 19-Oct-1999.) (New usage is discouraged.)
theorem shjcomi (A2 B2: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wceq (co A2 B2 chj) (co B2 A2 chj) $;

--| Subspace sum is an upper bound of its arguments. (Contributed by NM, 19-Oct-1999.) (New usage is discouraged.)
theorem shsub1i (A2 B2: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wss A2 (co A2 B2 cph) $;

--| Subspace sum is an upper bound of its arguments. (Contributed by NM, 17-Dec-2004.) (New usage is discouraged.)
theorem shsub2i (A2 B2: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wss A2 (co B2 A2 cph) $;

--| Hilbert lattice join is an upper bound of two subspaces. (Contributed by NM, 19-Oct-1999.) (New usage is discouraged.)
theorem shub1i (A2 B2: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wss A2 (co A2 B2 chj) $;

--| Closure of ` CH ` join. (Contributed by NM, 19-Oct-1999.) (New usage is discouraged.)
theorem shjcli (A2 B2: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wcel (co A2 B2 chj) cch $;

--| ` SH ` closure of join. (Contributed by NM, 5-May-2000.) (New usage is discouraged.)
theorem shjshcli (A2 B2: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wcel (co A2 B2 chj) csh $;

--| Subset implies subset of subspace sum. (Contributed by NM, 18-Nov-2000.) (New usage is discouraged.)
theorem shlessi (A2 B2 C: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wcel C csh $ >
  $ wi (wss A2 B2) (wss (co A2 C cph) (co B2 C cph)) $;

--| Add disjunct to both sides of Hilbert subspace ordering. (Contributed by NM, 19-Oct-1999.) (Revised by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem shlej1i (A2 B2 C: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wcel C csh $ >
  $ wi (wss A2 B2) (wss (co A2 C chj) (co B2 C chj)) $;

--| Add disjunct to both sides of Hilbert subspace ordering. (Contributed by NM, 19-Oct-1999.) (New usage is discouraged.)
theorem shlej2i (A2 B2 C: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wcel C csh $ >
  $ wi (wss A2 B2) (wss (co C A2 chj) (co C B2 chj)) $;

--| Subspace sum is smaller than subspace join. Remark in [Kalmbach] p. 65. (Contributed by NM, 12-Jul-2004.) (New usage is discouraged.)
theorem shslej (A2 B2: class):
  $ wi (wa (wcel A2 csh) (wcel B2 csh)) (wss (co A2 B2 cph) (co A2 B2 chj)) $;

--| Closure of intersection of two subspaces. (Contributed by NM, 24-Jun-2004.) (New usage is discouraged.)
theorem shincl (A2 B2: class):
  $ wi (wa (wcel A2 csh) (wcel B2 csh)) (wcel (cin A2 B2) csh) $;

--| Hilbert lattice join is an upper bound of two subspaces. (Contributed by NM, 22-Jun-2004.) (New usage is discouraged.)
theorem shub1 (A2 B2: class):
  $ wi (wa (wcel A2 csh) (wcel B2 csh)) (wss A2 (co A2 B2 chj)) $;

--| A subspace is a subset of its Hilbert lattice join with another. (Contributed by NM, 22-Jun-2004.) (New usage is discouraged.)
theorem shub2 (A2 B2: class):
  $ wi (wa (wcel A2 csh) (wcel B2 csh)) (wss A2 (co B2 A2 chj)) $;

--| Idempotent law for Hilbert subspace sum. (Contributed by NM, 6-Jun-2004.) (New usage is discouraged.)
theorem shsidmi (A2: class):
  $ wcel A2 csh $ >
  $ wceq (co A2 A2 cph) A2 $;

--| The least upper bound law for Hilbert subspace sum. (Contributed by NM, 15-Jun-2004.) (New usage is discouraged.)
theorem shslubi (A2 B2 C: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wcel C csh $ >
  $ wb (wa (wss A2 C) (wss B2 C)) (wss (co A2 B2 cph) C) $;

--| Hilbert lattice ordering in terms of subspace sum. (Contributed by NM, 23-Nov-2004.) (New usage is discouraged.)
theorem shlesb1i (A2 B2: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wb (wss A2 B2) (wceq (co A2 B2 cph) B2) $;

--| An alternate way to express subspace sum. (Contributed by NM, 25-Nov-2004.) (New usage is discouraged.)
theorem shsval2i {x3: setvar} (A2 B2: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wceq (co A2 B2 cph) (cint (crab x3 (wss (cun A2 B2) (cv x3)) csh)) $;

--| An alternate way to express subspace sum. (Contributed by NM, 25-Nov-2004.) (New usage is discouraged.)
theorem shsval3i (A2 B2: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wceq (co A2 B2 cph) (cfv (cun A2 B2) cspn) $;

--| The modular law holds for subspace sum. Similar to part of Theorem 16.9 of [MaedaMaeda] p. 70. (Contributed by NM, 23-Nov-2004.) (New usage is discouraged.)
theorem shmodsi (A2 B2 C: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wcel C csh $ >
  $ wi (wss A2 C) (wss (cin (co A2 B2 cph) C) (co A2 (cin B2 C) cph)) $;

--| The modular law is implied by the closure of subspace sum. Part of proof of Theorem 16.9 of [MaedaMaeda] p. 70. (Contributed by NM, 23-Nov-2004.) (New usage is discouraged.)
theorem shmodi (A2 B2 C: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wcel C csh $ >
  $ wi (wa (wceq (co A2 B2 cph) (co A2 B2 chj)) (wss A2 C)) (wss (cin (co A2 B2 chj) C) (co A2 (cin B2 C) chj)) $;

--| Lemma for ~ pjhth . (Contributed by NM, 10-Oct-1999.) (Revised by Mario Carneiro, 15-May-2014.) (Proof shortened by AV, 10-Jul-2022.) (New usage is discouraged.)
theorem pjhthlem1 {x3: setvar} (ph: wff x3) (A2 B2 C T H: class):
  $ wcel H cch $ >
  $ wi ph (wcel A2 chba) $ >
  $ wi ph (wcel B2 H) $ >
  $ wi ph (wcel C H) $ >
  $ wi ph (wral x3 (wbr (cfv (co A2 B2 cmv) cno) (cfv (co A2 (cv x3) cmv) cno) cle) H) $ >
  $ wceq T (co (co (co A2 B2 cmv) C csp) (co (co C C csp) c1 caddc) cdiv) $ >
  $ wi ph (wceq (co (co A2 B2 cmv) C csp) cc0) $;

--| Lemma for ~ pjhth . (Contributed by NM, 10-Oct-1999.) (Revised by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem pjhthlem2 {x3 y1: setvar} (ph: wff) (A2 H: class):
  $ wcel H cch $ >
  $ wi ph (wcel A2 chba) $ >
  $ wi ph (wrex x3 (wrex y1 (wceq A2 (co (cv x3) (cv y1) cva)) (cfv H cort)) H) $;

--| Projection Theorem: Any Hilbert space vector ` A ` can be decomposed uniquely into a member ` x ` of a closed subspace ` H ` and a member ` y ` of the complement of the subspace. Theorem 3.7(i) of [Beran] p. 102 (existence part). (Contributed by NM, 23-Oct-1999.) (Revised by Mario Carneiro, 14-May-2014.) (New usage is discouraged.)
theorem pjhth (H: class):
  $ wi (wcel H cch) (wceq (co H (cfv H cort) cph) chba) $;

--| Projection Theorem: Any Hilbert space vector ` A ` can be decomposed uniquely into a member ` x ` of a closed subspace ` H ` and a member ` y ` of the complement of the subspace. Theorem 3.7(i) of [Beran] p. 102. See ~ pjhtheu2 for the uniqueness of ` y ` . (Contributed by NM, 23-Oct-1999.) (Revised by Mario Carneiro, 14-May-2014.) (New usage is discouraged.)
theorem pjhtheu {x3 y1: setvar} (A2 H: class):
  $ wi (wa (wcel H cch) (wcel A2 chba)) (wreu x3 (wrex y1 (wceq A2 (co (cv x3) (cv y1) cva)) (cfv H cort)) H) $;

--| Define the projection function on a Hilbert space, as a mapping from the Hilbert lattice to a function on Hilbert space. Every closed subspace is associated with a unique projection function. Remark in [Kalmbach] p. 66, adopted as a definition. ` ( projh `` H ) `` A ` is the projection of vector ` A ` onto closed subspace ` H ` . Note that the range of ` projh ` is the set of all projection operators, so ` T e. ran projh ` means that ` T ` is a projection operator. (Contributed by NM, 23-Oct-1999.) (New usage is discouraged.)
axiom df_pjh {x3 y1 z h: setvar}:
  $ wceq cpjh (cmpt h cch (cmpt x3 chba (crio z (wrex y1 (wceq (cv x3) (co (cv z) (cv y1) cva)) (cfv (cv h) cort)) (cv h)))) $;

--| The value of the projection map. (Contributed by NM, 23-Oct-1999.) (Revised by Mario Carneiro, 15-Dec-2013.) (New usage is discouraged.)
theorem pjhfval {x3 y1 z: setvar} (H: class):
  $ wi (wcel H cch) (wceq (cfv H cpjh) (cmpt x3 chba (crio z (wrex y1 (wceq (cv x3) (co (cv z) (cv y1) cva)) (cfv H cort)) H))) $;

--| Value of a projection. (Contributed by NM, 23-Oct-1999.) (Revised by Mario Carneiro, 15-Dec-2013.) (New usage is discouraged.)
theorem pjhval {x3 y1: setvar} (A2 H: class):
  $ wi (wa (wcel H cch) (wcel A2 chba)) (wceq (cfv A2 (cfv H cpjh)) (crio x3 (wrex y1 (wceq A2 (co (cv x3) (cv y1) cva)) (cfv H cort)) H)) $;

--| Equality with a projection. This version of ~ pjeq does not assume the Axiom of Choice via ~ pjhth . (Contributed by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem pjpreeq {x3: setvar} (A2 B2 H: class):
  $ wi (wa (wcel H cch) (wcel A2 (co H (cfv H cort) cph))) (wb (wceq (cfv A2 (cfv H cpjh)) B2) (wa (wcel B2 H) (wrex x3 (wceq A2 (co B2 (cv x3) cva)) (cfv H cort)))) $;

--| Equality with a projection. (Contributed by NM, 20-Jan-2007.) (Revised by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem pjeq {x3: setvar} (A2 B2 H: class):
  $ wi (wa (wcel H cch) (wcel A2 chba)) (wb (wceq (cfv A2 (cfv H cpjh)) B2) (wa (wcel B2 H) (wrex x3 (wceq A2 (co B2 (cv x3) cva)) (cfv H cort)))) $;

--| Closure of a projection in its subspace. If we consider this together with ~ axpjpj to be axioms, the need for the ~ ax-hcompl can often be avoided for the kinds of theorems we are interested in here. An interesting project is to see how far we can go by using them in place of it. In particular, we can prove the orthomodular law ~ pjomli .) (Contributed by NM, 23-Oct-1999.) (Revised by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem axpjcl (A2 H: class):
  $ wi (wa (wcel H cch) (wcel A2 chba)) (wcel (cfv A2 (cfv H cpjh)) H) $;

--| Closure of a projection in Hilbert space. (Contributed by NM, 30-Oct-1999.) (New usage is discouraged.)
theorem pjhcl (A2 H: class):
  $ wi (wa (wcel H cch) (wcel A2 chba)) (wcel (cfv A2 (cfv H cpjh)) chba) $;

--| Lemma for orthomodular law in the Hilbert lattice. (Contributed by NM, 14-Oct-1999.) (New usage is discouraged.)
theorem omlsilem (A2 B2 C G H: class):
  $ wcel G csh $ >
  $ wcel H csh $ >
  $ wss G H $ >
  $ wceq (cin H (cfv G cort)) c0h $ >
  $ wcel A2 H $ >
  $ wcel B2 G $ >
  $ wcel C (cfv G cort) $ >
  $ wi (wceq A2 (co B2 C cva)) (wcel A2 G) $;

--| Subspace inference form of orthomodular law in the Hilbert lattice. (Contributed by NM, 14-Oct-1999.) (Revised by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem omlsii (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 csh $ >
  $ wss A2 B2 $ >
  $ wceq (cin B2 (cfv A2 cort)) c0h $ >
  $ wceq A2 B2 $;

--| Subspace form of orthomodular law in the Hilbert lattice. Compare the orthomodular law in Theorem 2(ii) of [Kalmbach] p. 22. (Contributed by NM, 14-Oct-1999.) (New usage is discouraged.)
theorem omlsi (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 csh $ >
  $ wi (wa (wss A2 B2) (wceq (cin B2 (cfv A2 cort)) c0h)) (wceq A2 B2) $;

--| Complement of complement of a closed subspace of Hilbert space. Theorem 3.7(ii) of [Beran] p. 102. (Contributed by NM, 11-Oct-1999.) (New usage is discouraged.)
theorem ococi (A2: class):
  $ wcel A2 cch $ >
  $ wceq (cfv (cfv A2 cort) cort) A2 $;

--| Complement of complement of a closed subspace of Hilbert space. Theorem 3.7(ii) of [Beran] p. 102. (Contributed by NM, 11-Oct-1999.) (New usage is discouraged.)
theorem ococ (A2: class):
  $ wi (wcel A2 cch) (wceq (cfv (cfv A2 cort) cort) A2) $;

--| Alternate definition of the Hilbert lattice. (Contributed by NM, 8-Aug-2000.) (Revised by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem dfch2 {x3: setvar}:
  $ wceq cch (crab x3 (wceq (cfv (cfv (cv x3) cort) cort) (cv x3)) (cpw chba)) $;

--| The double complement is the smallest closed subspace containing a subset of Hilbert space. Remark 3.12(B) of [Beran] p. 107. (Contributed by NM, 8-Aug-2000.) (New usage is discouraged.)
theorem ococin {x3: setvar} (A2: class):
  $ wi (wss A2 chba) (wceq (cfv (cfv A2 cort) cort) (cint (crab x3 (wss A2 (cv x3)) cch))) $;

--| Alternate definition of supremum of a subset of the Hilbert lattice. Definition of supremum in Proposition 1 of [Kalmbach] p. 65. We actually define it on any collection of Hilbert space subsets, not just the Hilbert lattice ` CH ` , to allow more general theorems. (Contributed by NM, 13-Aug-2002.) (New usage is discouraged.)
theorem hsupval2 {x3: setvar} (A2: class):
  $ wi (wss A2 (cpw chba)) (wceq (cfv A2 chsup) (cint (crab x3 (wss (cuni A2) (cv x3)) cch))) $;

--| The value of the supremum of a set of closed subspaces of Hilbert space. Definition of supremum in Proposition 1 of [Kalmbach] p. 65. (Contributed by NM, 13-Aug-2002.) (New usage is discouraged.)
theorem chsupval2 {x3: setvar} (A2: class):
  $ wi (wss A2 cch) (wceq (cfv A2 chsup) (cint (crab x3 (wss (cuni A2) (cv x3)) cch))) $;

--| Value of join in the set of closed subspaces of Hilbert space ` CH ` . (Contributed by NM, 1-Nov-2000.) (Revised by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem sshjval2 {x3: setvar} (A2 B2: class):
  $ wi (wa (wss A2 chba) (wss B2 chba)) (wceq (co A2 B2 chj) (cint (crab x3 (wss (cun A2 B2) (cv x3)) cch))) $;

--| A subspace is the supremum of all smaller subspaces. (Contributed by NM, 13-Aug-2002.) (New usage is discouraged.)
theorem chsupid {x3: setvar} (A2: class):
  $ wi (wcel A2 cch) (wceq (cfv (crab x3 (wss (cv x3) A2) cch) chsup) A2) $;

--| Value of supremum of subset of ` CH ` on a singleton. (Contributed by NM, 13-Aug-2002.) (New usage is discouraged.)
theorem chsupsn (A2: class):
  $ wi (wcel A2 cch) (wceq (cfv (csn A2) chsup) A2) $;

--| Hilbert lattice join is the least upper bound (among Hilbert lattice elements) of two subspaces. (Contributed by NM, 15-Jun-2004.) (New usage is discouraged.)
theorem shlub (A2 B2 C: class):
  $ wi (w3a (wcel A2 csh) (wcel B2 csh) (wcel C cch)) (wb (wa (wss A2 C) (wss B2 C)) (wss (co A2 B2 chj) C)) $;

--| Hilbert lattice join is the least upper bound (among Hilbert lattice elements) of two subspaces. (Contributed by NM, 11-Jun-2004.) (New usage is discouraged.)
theorem shlubi (A2 B2 C: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wcel C cch $ >
  $ wb (wa (wss A2 C) (wss B2 C)) (wss (co A2 B2 chj) C) $;

--| Uniqueness of ` y ` for the projection theorem. (Contributed by NM, 6-Nov-1999.) (Revised by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem pjhtheu2 {x3 y1: setvar} (A2 H: class):
  $ wi (wa (wcel H cch) (wcel A2 chba)) (wreu y1 (wrex x3 (wceq A2 (co (cv x3) (cv y1) cva)) H) (cfv H cort)) $;

--| Closure of a projection in its subspace. (Contributed by NM, 7-Oct-2000.) (New usage is discouraged.)
theorem pjcli (A2 H: class):
  $ wcel H cch $ >
  $ wi (wcel A2 chba) (wcel (cfv A2 (cfv H cpjh)) H) $;

--| Closure of a projection in Hilbert space. (Contributed by NM, 7-Oct-2000.) (New usage is discouraged.)
theorem pjhcli (A2 H: class):
  $ wcel H cch $ >
  $ wi (wcel A2 chba) (wcel (cfv A2 (cfv H cpjh)) chba) $;

--| Decomposition of a vector into projections. This formulation of ~ axpjpj avoids ~ pjhth . (Contributed by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem pjpjpre (ph: wff) (A2 H: class):
  $ wi ph (wcel H cch) $ >
  $ wi ph (wcel A2 (co H (cfv H cort) cph)) $ >
  $ wi ph (wceq A2 (co (cfv A2 (cfv H cpjh)) (cfv A2 (cfv (cfv H cort) cpjh)) cva)) $;

--| Decomposition of a vector into projections. See comment in ~ axpjcl . (Contributed by NM, 26-Oct-1999.) (Revised by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem axpjpj (A2 H: class):
  $ wi (wa (wcel H cch) (wcel A2 chba)) (wceq A2 (co (cfv A2 (cfv H cpjh)) (cfv A2 (cfv (cfv H cort) cpjh)) cva)) $;

--| Closure of a projection in its subspace. (Contributed by NM, 30-Oct-1999.) (New usage is discouraged.)
theorem pjclii (A2 H: class):
  $ wcel H cch $ >
  $ wcel A2 chba $ >
  $ wcel (cfv A2 (cfv H cpjh)) H $;

--| Closure of a projection in Hilbert space. (Contributed by NM, 30-Oct-1999.) (New usage is discouraged.)
theorem pjhclii (A2 H: class):
  $ wcel H cch $ >
  $ wcel A2 chba $ >
  $ wcel (cfv A2 (cfv H cpjh)) chba $;

--| Decomposition of a vector into projections. (Contributed by NM, 26-Oct-1999.) (Revised by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem pjpj0i (A2 H: class):
  $ wcel H cch $ >
  $ wcel A2 chba $ >
  $ wceq A2 (co (cfv A2 (cfv H cpjh)) (cfv A2 (cfv (cfv H cort) cpjh)) cva) $;

--| Decomposition of a vector into projections. (Contributed by NM, 6-Nov-1999.) (New usage is discouraged.)
theorem pjpji (A2 H: class):
  $ wcel H cch $ >
  $ wcel A2 chba $ >
  $ wceq A2 (co (cfv A2 (cfv H cpjh)) (cfv A2 (cfv (cfv H cort) cpjh)) cva) $;

--| Projection Theorem: Any Hilbert space vector ` A ` can be decomposed into a member ` x ` of a closed subspace ` H ` and a member ` y ` of the complement of the subspace. Theorem 3.7(i) of [Beran] p. 102 (existence part). (Contributed by NM, 6-Nov-1999.) (New usage is discouraged.)
theorem pjpjhth {x3 y1: setvar} (A2 H: class):
  $ wi (wa (wcel H cch) (wcel A2 chba)) (wrex x3 (wrex y1 (wceq A2 (co (cv x3) (cv y1) cva)) (cfv H cort)) H) $;

--| Projection Theorem: Any Hilbert space vector ` A ` can be decomposed into a member ` x ` of a closed subspace ` H ` and a member ` y ` of the complement of the subspace. Theorem 3.7(i) of [Beran] p. 102 (existence part). (Contributed by NM, 6-Nov-1999.) (New usage is discouraged.)
theorem pjpjhthi {x3 y1: setvar} (A2 H: class):
  $ wcel A2 chba $ >
  $ wcel H cch $ >
  $ wrex x3 (wrex y1 (wceq A2 (co (cv x3) (cv y1) cva)) (cfv H cort)) H $;

--| Orthocomplement projection in terms of projection. (Contributed by NM, 5-Nov-1999.) (New usage is discouraged.)
theorem pjop (A2 H: class):
  $ wi (wa (wcel H cch) (wcel A2 chba)) (wceq (cfv A2 (cfv (cfv H cort) cpjh)) (co A2 (cfv A2 (cfv H cpjh)) cmv)) $;

--| Projection in terms of orthocomplement projection. (Contributed by NM, 5-Nov-1999.) (New usage is discouraged.)
theorem pjpo (A2 H: class):
  $ wi (wa (wcel H cch) (wcel A2 chba)) (wceq (cfv A2 (cfv H cpjh)) (co A2 (cfv A2 (cfv (cfv H cort) cpjh)) cmv)) $;

--| Orthocomplement projection in terms of projection. (Contributed by NM, 31-Oct-1999.) (New usage is discouraged.)
theorem pjopi (A2 H: class):
  $ wcel H cch $ >
  $ wcel A2 chba $ >
  $ wceq (cfv A2 (cfv (cfv H cort) cpjh)) (co A2 (cfv A2 (cfv H cpjh)) cmv) $;

--| Projection in terms of orthocomplement projection. (Contributed by NM, 31-Oct-1999.) (New usage is discouraged.)
theorem pjpoi (A2 H: class):
  $ wcel H cch $ >
  $ wcel A2 chba $ >
  $ wceq (cfv A2 (cfv H cpjh)) (co A2 (cfv A2 (cfv (cfv H cort) cpjh)) cmv) $;

--| Projection of a vector in the orthocomplement of the projection subspace. (Contributed by NM, 27-Oct-1999.) (New usage is discouraged.)
theorem pjoc1i (A2 H: class):
  $ wcel H cch $ >
  $ wcel A2 chba $ >
  $ wb (wcel A2 H) (wceq (cfv A2 (cfv (cfv H cort) cpjh)) c0v) $;

--| Projection of a vector in the projection subspace. Lemma 4.4(ii) of [Beran] p. 111. (Contributed by NM, 27-Oct-1999.) (New usage is discouraged.)
theorem pjchi (A2 H: class):
  $ wcel H cch $ >
  $ wcel A2 chba $ >
  $ wb (wcel A2 H) (wceq (cfv A2 (cfv H cpjh)) A2) $;

--| The part of a vector that belongs to the orthocomplemented space. (Contributed by NM, 11-Apr-2006.) (New usage is discouraged.)
theorem pjoccl (A2 H: class):
  $ wi (wa (wcel H cch) (wcel A2 chba)) (wcel (co A2 (cfv A2 (cfv H cpjh)) cmv) (cfv H cort)) $;

--| Projection of a vector in the orthocomplement of the projection subspace. (Contributed by NM, 6-Nov-1999.) (New usage is discouraged.)
theorem pjoc1 (A2 H: class):
  $ wi (wa (wcel H cch) (wcel A2 chba)) (wb (wcel A2 H) (wceq (cfv A2 (cfv (cfv H cort) cpjh)) c0v)) $;

--| Subspace form of orthomodular law in the Hilbert lattice. Compare the orthomodular law in Theorem 2(ii) of [Kalmbach] p. 22. Derived using projections; compare ~ omlsi . (Contributed by NM, 6-Nov-1999.) (New usage is discouraged.)
theorem pjomli (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 csh $ >
  $ wi (wa (wss A2 B2) (wceq (cin B2 (cfv A2 cort)) c0h)) (wceq A2 B2) $;

--| Subspace form of orthomodular law in the Hilbert lattice. Compare the orthomodular law in Theorem 2(ii) of [Kalmbach] p. 22. Derived using projections; compare ~ omlsi . (Contributed by NM, 14-Jun-2006.) (New usage is discouraged.)
theorem pjoml (A2 B2: class):
  $ wi (wa (wa (wcel A2 cch) (wcel B2 csh)) (wa (wss A2 B2) (wceq (cin B2 (cfv A2 cort)) c0h))) (wceq A2 B2) $;

--| Proof of orthocomplement theorem using projections. Compare ~ ococ . (Contributed by NM, 5-Nov-1999.) (New usage is discouraged.)
theorem pjococi (H: class):
  $ wcel H cch $ >
  $ wceq (cfv (cfv H cort) cort) H $;

--| Projection of a vector in the orthocomplement of the projection subspace. Lemma 4.4(iii) of [Beran] p. 111. (Contributed by NM, 27-Oct-1999.) (New usage is discouraged.)
theorem pjoc2i (A2 H: class):
  $ wcel H cch $ >
  $ wcel A2 chba $ >
  $ wb (wcel A2 (cfv H cort)) (wceq (cfv A2 (cfv H cpjh)) c0v) $;

--| Projection of a vector in the orthocomplement of the projection subspace. Lemma 4.4(iii) of [Beran] p. 111. (Contributed by NM, 24-Apr-2006.) (New usage is discouraged.)
theorem pjoc2 (A2 H: class):
  $ wi (wa (wcel H cch) (wcel A2 chba)) (wb (wcel A2 (cfv H cort)) (wceq (cfv A2 (cfv H cpjh)) c0v)) $;

--| The zero subspace is the smallest subspace. (Contributed by NM, 3-Jun-2004.) (New usage is discouraged.)
theorem sh0le (A2: class):
  $ wi (wcel A2 csh) (wss c0h A2) $;

--| The zero subspace is the smallest member of ` CH ` . (Contributed by NM, 14-Aug-2002.) (New usage is discouraged.)
theorem ch0le (A2: class):
  $ wi (wcel A2 cch) (wss c0h A2) $;

--| No subspace is smaller than the zero subspace. (Contributed by NM, 24-Nov-2004.) (New usage is discouraged.)
theorem shle0 (A2: class):
  $ wi (wcel A2 csh) (wb (wss A2 c0h) (wceq A2 c0h)) $;

--| No Hilbert lattice element is smaller than zero. (Contributed by NM, 14-Aug-2002.) (New usage is discouraged.)
theorem chle0 (A2: class):
  $ wi (wcel A2 cch) (wb (wss A2 c0h) (wceq A2 c0h)) $;

--| A Hilbert lattice element that is not a subset of another is nonzero. (Contributed by NM, 30-Jun-2004.) (New usage is discouraged.)
theorem chnlen0 (A2 B2: class):
  $ wi (wcel B2 cch) (wi (wn (wss A2 B2)) (wn (wceq A2 c0h))) $;

--| The zero subspace is a proper subset of nonzero Hilbert lattice elements. (Contributed by NM, 9-Jun-2004.) (New usage is discouraged.)
theorem ch0pss (A2: class):
  $ wi (wcel A2 cch) (wb (wpss c0h A2) (wne A2 c0h)) $;

--| The intersection of orthogonal subspaces is the zero subspace. (Contributed by NM, 24-Jun-2004.) (New usage is discouraged.)
theorem orthin (A2 B2: class):
  $ wi (wa (wcel A2 csh) (wcel B2 csh)) (wi (wss A2 (cfv B2 cort)) (wceq (cin A2 B2) c0h)) $;

--| The lattice join of a subset with its orthocomplement is the whole space. (Contributed by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem ssjo (A2: class):
  $ wi (wss A2 chba) (wceq (co A2 (cfv A2 cort) chj) chba) $;

--| A nonzero subspace has a nonzero vector. (Contributed by NM, 25-Feb-2006.) (New usage is discouraged.)
theorem shne0i {x3: setvar} (A2: class):
  $ wcel A2 csh $ >
  $ wb (wne A2 c0h) (wrex x3 (wne (cv x3) c0v) A2) $;

--| Hilbert subspace sum with the zero subspace. (Contributed by NM, 14-Jan-2005.) (New usage is discouraged.)
theorem shs0i (A2: class):
  $ wcel A2 csh $ >
  $ wceq (co A2 c0h cph) A2 $;

--| Two subspaces are zero iff their join is zero. (Contributed by NM, 7-Aug-2004.) (New usage is discouraged.)
theorem shs00i (A2 B2: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wb (wa (wceq A2 c0h) (wceq B2 c0h)) (wceq (co A2 B2 cph) c0h) $;

--| The closed subspace zero is the smallest member of ` CH ` . (Contributed by NM, 15-Oct-1999.) (New usage is discouraged.)
theorem ch0lei (A2: class):
  $ wcel A2 cch $ >
  $ wss c0h A2 $;

--| No Hilbert closed subspace is smaller than zero. (Contributed by NM, 7-Apr-2001.) (New usage is discouraged.)
theorem chle0i (A2: class):
  $ wcel A2 cch $ >
  $ wb (wss A2 c0h) (wceq A2 c0h) $;

--| A nonzero closed subspace has a nonzero vector. (Contributed by NM, 25-Feb-2006.) (New usage is discouraged.)
theorem chne0i {x3: setvar} (A2: class):
  $ wcel A2 cch $ >
  $ wb (wne A2 c0h) (wrex x3 (wne (cv x3) c0v) A2) $;

--| Intersection of a closed subspace and its orthocomplement. Part of Proposition 1 of [Kalmbach] p. 65. (Contributed by NM, 11-Oct-1999.) (New usage is discouraged.)
theorem chocini (A2: class):
  $ wcel A2 cch $ >
  $ wceq (cin A2 (cfv A2 cort)) c0h $;

--| Join with lattice zero in ` CH ` . (Contributed by NM, 15-Oct-1999.) (New usage is discouraged.)
theorem chj0i (A2: class):
  $ wcel A2 cch $ >
  $ wceq (co A2 c0h chj) A2 $;

--| Meet with lattice one in ` CH ` . (Contributed by NM, 24-Oct-1999.) (New usage is discouraged.)
theorem chm1i (A2: class):
  $ wcel A2 cch $ >
  $ wceq (cin A2 chba) A2 $;

--| Closure of ` CH ` join. (Contributed by NM, 29-Jul-1999.) (New usage is discouraged.)
theorem chjcli (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel (co A2 B2 chj) cch $;

--| Subspace sum is smaller than subspace join. Remark in [Kalmbach] p. 65. (Contributed by NM, 17-Oct-1999.) (New usage is discouraged.)
theorem chsleji (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wss (co A2 B2 cph) (co A2 B2 chj) $;

--| Membership in subspace sum. (Contributed by NM, 19-Oct-1999.) (New usage is discouraged.)
theorem chseli {x3 y1: setvar} (A2 B2 C: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wcel C (co A2 B2 cph)) (wrex x3 (wrex y1 (wceq C (co (cv x3) (cv y1) cva)) B2) A2) $;

--| Closure of Hilbert lattice intersection. (Contributed by NM, 15-Oct-1999.) (New usage is discouraged.)
theorem chincli (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel (cin A2 B2) cch $;

--| Hilbert lattice contraposition law. (Contributed by NM, 15-Oct-1999.) (New usage is discouraged.)
theorem chsscon3i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wss A2 B2) (wss (cfv B2 cort) (cfv A2 cort)) $;

--| Hilbert lattice contraposition law. (Contributed by NM, 15-Oct-1999.) (New usage is discouraged.)
theorem chsscon1i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wss (cfv A2 cort) B2) (wss (cfv B2 cort) A2) $;

--| Hilbert lattice contraposition law. (Contributed by NM, 15-Oct-1999.) (New usage is discouraged.)
theorem chsscon2i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wss A2 (cfv B2 cort)) (wss B2 (cfv A2 cort)) $;

--| Hilbert lattice contraposition law. (Contributed by NM, 24-Jun-2004.) (New usage is discouraged.)
theorem chcon2i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wceq A2 (cfv B2 cort)) (wceq B2 (cfv A2 cort)) $;

--| Hilbert lattice contraposition law. (Contributed by NM, 15-Jun-2006.) (New usage is discouraged.)
theorem chcon1i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wceq (cfv A2 cort) B2) (wceq (cfv B2 cort) A2) $;

--| Hilbert lattice contraposition law. (Contributed by NM, 24-Jun-2004.) (New usage is discouraged.)
theorem chcon3i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wceq A2 B2) (wceq (cfv B2 cort) (cfv A2 cort)) $;

--| Union is smaller than ` CH ` join. (Contributed by NM, 15-Oct-1999.) (New usage is discouraged.)
theorem chunssji (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wss (cun A2 B2) (co A2 B2 chj) $;

--| Commutative law for join in ` CH ` . (Contributed by NM, 14-Oct-1999.) (New usage is discouraged.)
theorem chjcomi (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wceq (co A2 B2 chj) (co B2 A2 chj) $;

--| ` CH ` join is an upper bound of two elements. (Contributed by NM, 15-Oct-1999.) (New usage is discouraged.)
theorem chub1i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wss A2 (co A2 B2 chj) $;

--| ` CH ` join is an upper bound of two elements. (Contributed by NM, 5-Nov-2000.) (New usage is discouraged.)
theorem chub2i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wss A2 (co B2 A2 chj) $;

--| Hilbert lattice join is the least upper bound of two elements. (Contributed by NM, 11-Jun-2004.) (New usage is discouraged.)
theorem chlubi (A2 B2 C: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wb (wa (wss A2 C) (wss B2 C)) (wss (co A2 B2 chj) C) $;

--| Hilbert lattice join is the least upper bound of two elements (one direction of ~ chlubi ). (Contributed by NM, 15-Oct-1999.) (New usage is discouraged.)
theorem chlubii (A2 B2 C: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wi (wa (wss A2 C) (wss B2 C)) (wss (co A2 B2 chj) C) $;

--| Add join to both sides of a Hilbert lattice ordering. (Contributed by NM, 19-Oct-1999.) (New usage is discouraged.)
theorem chlej1i (A2 B2 C: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wi (wss A2 B2) (wss (co A2 C chj) (co B2 C chj)) $;

--| Add join to both sides of a Hilbert lattice ordering. (Contributed by NM, 19-Oct-1999.) (New usage is discouraged.)
theorem chlej2i (A2 B2 C: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wi (wss A2 B2) (wss (co C A2 chj) (co C B2 chj)) $;

--| Add join to both sides of a Hilbert lattice ordering. (Contributed by NM, 19-Oct-1999.) (New usage is discouraged.)
theorem chlej12i (A2 B2 C D: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wcel D cch $ >
  $ wi (wa (wss A2 B2) (wss C D)) (wss (co A2 C chj) (co B2 D chj)) $;

--| Hilbert lattice ordering in terms of join. (Contributed by NM, 15-Oct-1999.) (New usage is discouraged.)
theorem chlejb1i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wss A2 B2) (wceq (co A2 B2 chj) B2) $;

--| De Morgan's law for meet in a Hilbert lattice. (Contributed by NM, 21-Jun-2004.) (New usage is discouraged.)
theorem chdmm1i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wceq (cfv (cin A2 B2) cort) (co (cfv A2 cort) (cfv B2 cort) chj) $;

--| De Morgan's law for meet in a Hilbert lattice. (Contributed by NM, 21-Jun-2004.) (New usage is discouraged.)
theorem chdmm2i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wceq (cfv (cin (cfv A2 cort) B2) cort) (co A2 (cfv B2 cort) chj) $;

--| De Morgan's law for meet in a Hilbert lattice. (Contributed by NM, 21-Jun-2004.) (New usage is discouraged.)
theorem chdmm3i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wceq (cfv (cin A2 (cfv B2 cort)) cort) (co (cfv A2 cort) B2 chj) $;

--| De Morgan's law for meet in a Hilbert lattice. (Contributed by NM, 21-Jun-2004.) (New usage is discouraged.)
theorem chdmm4i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wceq (cfv (cin (cfv A2 cort) (cfv B2 cort)) cort) (co A2 B2 chj) $;

--| De Morgan's law for join in a Hilbert lattice. (Contributed by NM, 21-Jun-2004.) (New usage is discouraged.)
theorem chdmj1i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wceq (cfv (co A2 B2 chj) cort) (cin (cfv A2 cort) (cfv B2 cort)) $;

--| De Morgan's law for join in a Hilbert lattice. (Contributed by NM, 21-Jun-2004.) (New usage is discouraged.)
theorem chdmj2i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wceq (cfv (co (cfv A2 cort) B2 chj) cort) (cin A2 (cfv B2 cort)) $;

--| De Morgan's law for join in a Hilbert lattice. (Contributed by NM, 21-Jun-2004.) (New usage is discouraged.)
theorem chdmj3i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wceq (cfv (co A2 (cfv B2 cort) chj) cort) (cin (cfv A2 cort) B2) $;

--| De Morgan's law for join in a Hilbert lattice. (Contributed by NM, 21-Jun-2004.) (New usage is discouraged.)
theorem chdmj4i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wceq (cfv (co (cfv A2 cort) (cfv B2 cort) chj) cort) (cin A2 B2) $;

--| Equivalent expressions for "not less than" in the Hilbert lattice. (Contributed by NM, 5-Jun-2004.) (New usage is discouraged.)
theorem chnlei (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wn (wss B2 A2)) (wpss A2 (co A2 B2 chj)) $;

--| Associative law for Hilbert lattice join. From definition of lattice in [Kalmbach] p. 14. (Contributed by NM, 10-Jun-2004.) (New usage is discouraged.)
theorem chjassi (A2 B2 C: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wceq (co (co A2 B2 chj) C chj) (co A2 (co B2 C chj) chj) $;

--| Two Hilbert lattice elements are zero iff their join is zero. (Contributed by NM, 7-Aug-2004.) (New usage is discouraged.)
theorem chj00i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wa (wceq A2 c0h) (wceq B2 c0h)) (wceq (co A2 B2 chj) c0h) $;

--| The join of a closed subspace and its orthocomplement. (Contributed by NM, 24-Oct-1999.) (New usage is discouraged.)
theorem chjoi (A2: class):
  $ wcel A2 cch $ >
  $ wceq (co A2 (cfv A2 cort) chj) chba $;

--| Join with Hilbert lattice one. (Contributed by NM, 6-Aug-2004.) (New usage is discouraged.)
theorem chj1i (A2: class):
  $ wcel A2 cch $ >
  $ wceq (co A2 chba chj) chba $;

--| Meet with Hilbert lattice zero. (Contributed by NM, 6-Aug-2004.) (New usage is discouraged.)
theorem chm0i (A2: class):
  $ wcel A2 cch $ >
  $ wceq (cin A2 c0h) c0h $;

--| Meet with Hilbert lattice zero. (Contributed by NM, 14-Jun-2006.) (New usage is discouraged.)
theorem chm0 (A2: class):
  $ wi (wcel A2 cch) (wceq (cin A2 c0h) c0h) $;

--| Hilbert lattice join equals the double orthocomplement of subspace sum. (Contributed by NM, 27-Nov-2004.) (New usage is discouraged.)
theorem shjshsi (A2 B2: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wceq (co A2 B2 chj) (cfv (cfv (co A2 B2 cph) cort) cort) $;

--| A closed subspace sum equals Hilbert lattice join. Part of Lemma 31.1.5 of [MaedaMaeda] p. 136. (Contributed by NM, 30-Nov-2004.) (New usage is discouraged.)
theorem shjshseli (A2 B2: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wb (wcel (co A2 B2 cph) cch) (wceq (co A2 B2 cph) (co A2 B2 chj)) $;

--| A nonzero closed subspace has a nonzero vector. (Contributed by NM, 25-Feb-2006.) (New usage is discouraged.)
theorem chne0 {x3: setvar} (A2: class):
  $ wi (wcel A2 cch) (wb (wne A2 c0h) (wrex x3 (wne (cv x3) c0v) A2)) $;

--| Intersection of a closed subspace and its orthocomplement. Part of Proposition 1 of [Kalmbach] p. 65. (Contributed by NM, 13-Jun-2006.) (New usage is discouraged.)
theorem chocin (A2: class):
  $ wi (wcel A2 cch) (wceq (cin A2 (cfv A2 cort)) c0h) $;

--| A closed subspace less than its orthocomplement is zero. (Contributed by NM, 14-Jun-2006.) (New usage is discouraged.)
theorem chssoc (A2: class):
  $ wi (wcel A2 cch) (wb (wss A2 (cfv A2 cort)) (wceq A2 c0h)) $;

--| Join with Hilbert lattice zero. (Contributed by NM, 22-Jun-2004.) (New usage is discouraged.)
theorem chj0 (A2: class):
  $ wi (wcel A2 cch) (wceq (co A2 c0h chj) A2) $;

--| Subspace sum is smaller than subspace join. Remark in [Kalmbach] p. 65. (Contributed by NM, 12-Jul-2004.) (New usage is discouraged.)
theorem chslej (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wss (co A2 B2 cph) (co A2 B2 chj)) $;

--| Closure of Hilbert lattice intersection. (Contributed by NM, 15-Jun-2004.) (New usage is discouraged.)
theorem chincl (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wcel (cin A2 B2) cch) $;

--| Hilbert lattice contraposition law. (Contributed by NM, 12-Jun-2004.) (New usage is discouraged.)
theorem chsscon3 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wss A2 B2) (wss (cfv B2 cort) (cfv A2 cort))) $;

--| Hilbert lattice contraposition law. (Contributed by NM, 21-Jun-2004.) (New usage is discouraged.)
theorem chsscon1 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wss (cfv A2 cort) B2) (wss (cfv B2 cort) A2)) $;

--| Hilbert lattice contraposition law. (Contributed by NM, 21-Jun-2004.) (New usage is discouraged.)
theorem chsscon2 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wss A2 (cfv B2 cort)) (wss B2 (cfv A2 cort))) $;

--| Hilbert lattice contraposition law for strict ordering. (Contributed by NM, 12-Jun-2004.) (New usage is discouraged.)
theorem chpsscon3 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wpss A2 B2) (wpss (cfv B2 cort) (cfv A2 cort))) $;

--| Hilbert lattice contraposition law for strict ordering. (Contributed by NM, 12-Jun-2004.) (New usage is discouraged.)
theorem chpsscon1 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wpss (cfv A2 cort) B2) (wpss (cfv B2 cort) A2)) $;

--| Hilbert lattice contraposition law for strict ordering. (Contributed by NM, 12-Jun-2004.) (New usage is discouraged.)
theorem chpsscon2 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wpss A2 (cfv B2 cort)) (wpss B2 (cfv A2 cort))) $;

--| Commutative law for Hilbert lattice join. (Contributed by NM, 12-Jun-2004.) (New usage is discouraged.)
theorem chjcom (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wceq (co A2 B2 chj) (co B2 A2 chj)) $;

--| Hilbert lattice join is greater than or equal to its first argument. (Contributed by NM, 12-Jun-2004.) (New usage is discouraged.)
theorem chub1 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wss A2 (co A2 B2 chj)) $;

--| Hilbert lattice join is greater than or equal to its second argument. (Contributed by NM, 12-Jun-2004.) (New usage is discouraged.)
theorem chub2 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wss A2 (co B2 A2 chj)) $;

--| Hilbert lattice join is the least upper bound of two elements. (Contributed by NM, 12-Jun-2004.) (New usage is discouraged.)
theorem chlub (A2 B2 C: class):
  $ wi (w3a (wcel A2 cch) (wcel B2 cch) (wcel C cch)) (wb (wa (wss A2 C) (wss B2 C)) (wss (co A2 B2 chj) C)) $;

--| Add join to both sides of Hilbert lattice ordering. (Contributed by NM, 22-Jun-2004.) (New usage is discouraged.)
theorem chlej1 (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cch) (wcel B2 cch) (wcel C cch)) (wss A2 B2)) (wss (co A2 C chj) (co B2 C chj)) $;

--| Add join to both sides of Hilbert lattice ordering. (Contributed by NM, 22-Jun-2004.) (New usage is discouraged.)
theorem chlej2 (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cch) (wcel B2 cch) (wcel C cch)) (wss A2 B2)) (wss (co C A2 chj) (co C B2 chj)) $;

--| Hilbert lattice ordering in terms of join. (Contributed by NM, 30-Jun-2004.) (New usage is discouraged.)
theorem chlejb1 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wss A2 B2) (wceq (co A2 B2 chj) B2)) $;

--| Hilbert lattice ordering in terms of join. (Contributed by NM, 2-Jul-2004.) (New usage is discouraged.)
theorem chlejb2 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wss A2 B2) (wceq (co B2 A2 chj) B2)) $;

--| Equivalent expressions for "not less than" in the Hilbert lattice. (Contributed by NM, 9-Jun-2004.) (New usage is discouraged.)
theorem chnle (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wn (wss B2 A2)) (wpss A2 (co A2 B2 chj))) $;

--| The join of a closed subspace and its orthocomplement is all of Hilbert space. (Contributed by NM, 31-Oct-2005.) (New usage is discouraged.)
theorem chjo (A2: class):
  $ wi (wcel A2 cch) (wceq (co A2 (cfv A2 cort) chj) chba) $;

--| Hilbert lattice absorption law. From definition of lattice in [Kalmbach] p. 14. (Contributed by NM, 15-Jun-2004.) (New usage is discouraged.)
theorem chabs1 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wceq (co A2 (cin A2 B2) chj) A2) $;

--| Hilbert lattice absorption law. From definition of lattice in [Kalmbach] p. 14. (Contributed by NM, 16-Jun-2004.) (New usage is discouraged.)
theorem chabs2 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wceq (cin A2 (co A2 B2 chj)) A2) $;

--| Hilbert lattice absorption law. From definition of lattice in [Kalmbach] p. 14. (Contributed by NM, 10-Jun-2004.) (New usage is discouraged.)
theorem chabs1i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wceq (co A2 (cin A2 B2) chj) A2 $;

--| Hilbert lattice absorption law. From definition of lattice in [Kalmbach] p. 14. (Contributed by NM, 16-Jun-2004.) (New usage is discouraged.)
theorem chabs2i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wceq (cin A2 (co A2 B2 chj)) A2 $;

--| Idempotent law for Hilbert lattice join. (Contributed by NM, 26-Jun-2004.) (New usage is discouraged.)
theorem chjidm (A2: class):
  $ wi (wcel A2 cch) (wceq (co A2 A2 chj) A2) $;

--| Idempotent law for Hilbert lattice join. (Contributed by NM, 15-Jun-2004.) (New usage is discouraged.)
theorem chjidmi (A2: class):
  $ wcel A2 cch $ >
  $ wceq (co A2 A2 chj) A2 $;

--| A rearrangement of Hilbert lattice join. (Contributed by NM, 29-Apr-2006.) (New usage is discouraged.)
theorem chj12i (A2 B2 C: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wceq (co A2 (co B2 C chj) chj) (co B2 (co A2 C chj) chj) $;

--| Rearrangement of the join of 4 Hilbert lattice elements. (Contributed by NM, 29-Apr-2006.) (New usage is discouraged.)
theorem chj4i (A2 B2 C D: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wcel D cch $ >
  $ wceq (co (co A2 B2 chj) (co C D chj) chj) (co (co A2 C chj) (co B2 D chj) chj) $;

--| Hilbert lattice join distributes over itself. (Contributed by NM, 29-Apr-2006.) (New usage is discouraged.)
theorem chjjdiri (A2 B2 C: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wceq (co (co A2 B2 chj) C chj) (co (co A2 C chj) (co B2 C chj) chj) $;

--| De Morgan's law for meet in a Hilbert lattice. (Contributed by NM, 21-Jun-2004.) (New usage is discouraged.)
theorem chdmm1 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wceq (cfv (cin A2 B2) cort) (co (cfv A2 cort) (cfv B2 cort) chj)) $;

--| De Morgan's law for meet in a Hilbert lattice. (Contributed by NM, 21-Jun-2004.) (New usage is discouraged.)
theorem chdmm2 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wceq (cfv (cin (cfv A2 cort) B2) cort) (co A2 (cfv B2 cort) chj)) $;

--| De Morgan's law for meet in a Hilbert lattice. (Contributed by NM, 21-Jun-2004.) (New usage is discouraged.)
theorem chdmm3 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wceq (cfv (cin A2 (cfv B2 cort)) cort) (co (cfv A2 cort) B2 chj)) $;

--| De Morgan's law for meet in a Hilbert lattice. (Contributed by NM, 21-Jun-2004.) (New usage is discouraged.)
theorem chdmm4 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wceq (cfv (cin (cfv A2 cort) (cfv B2 cort)) cort) (co A2 B2 chj)) $;

--| De Morgan's law for join in a Hilbert lattice. (Contributed by NM, 21-Jun-2004.) (New usage is discouraged.)
theorem chdmj1 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wceq (cfv (co A2 B2 chj) cort) (cin (cfv A2 cort) (cfv B2 cort))) $;

--| De Morgan's law for join in a Hilbert lattice. (Contributed by NM, 21-Jun-2004.) (New usage is discouraged.)
theorem chdmj2 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wceq (cfv (co (cfv A2 cort) B2 chj) cort) (cin A2 (cfv B2 cort))) $;

--| De Morgan's law for join in a Hilbert lattice. (Contributed by NM, 21-Jun-2004.) (New usage is discouraged.)
theorem chdmj3 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wceq (cfv (co A2 (cfv B2 cort) chj) cort) (cin (cfv A2 cort) B2)) $;

--| De Morgan's law for join in a Hilbert lattice. (Contributed by NM, 21-Jun-2004.) (New usage is discouraged.)
theorem chdmj4 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wceq (cfv (co (cfv A2 cort) (cfv B2 cort) chj) cort) (cin A2 B2)) $;

--| Associative law for Hilbert lattice join. From definition of lattice in [Kalmbach] p. 14. (Contributed by NM, 10-Jun-2004.) (New usage is discouraged.)
theorem chjass (A2 B2 C: class):
  $ wi (w3a (wcel A2 cch) (wcel B2 cch) (wcel C cch)) (wceq (co (co A2 B2 chj) C chj) (co A2 (co B2 C chj) chj)) $;

--| A rearrangement of Hilbert lattice join. (Contributed by NM, 15-Jun-2006.) (New usage is discouraged.)
theorem chj12 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cch) (wcel B2 cch) (wcel C cch)) (wceq (co A2 (co B2 C chj) chj) (co B2 (co A2 C chj) chj)) $;

--| Rearrangement of the join of 4 Hilbert lattice elements. (Contributed by NM, 15-Jun-2006.) (New usage is discouraged.)
theorem chj4 (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cch) (wcel B2 cch)) (wa (wcel C cch) (wcel D cch))) (wceq (co (co A2 B2 chj) (co C D chj) chj) (co (co A2 C chj) (co B2 D chj) chj)) $;

--| An ortholattice is distributive in one ordering direction. (Contributed by NM, 6-Aug-2004.) (New usage is discouraged.)
theorem ledii (A2 B2 C: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wss (co (cin A2 B2) (cin A2 C) chj) (cin A2 (co B2 C chj)) $;

--| An ortholattice is distributive in one ordering direction. (Contributed by NM, 27-Apr-2006.) (New usage is discouraged.)
theorem lediri (A2 B2 C: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wss (co (cin A2 C) (cin B2 C) chj) (cin (co A2 B2 chj) C) $;

--| An ortholattice is distributive in one ordering direction (join version). (Contributed by NM, 27-Apr-2006.) (New usage is discouraged.)
theorem lejdii (A2 B2 C: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wss (co A2 (cin B2 C) chj) (cin (co A2 B2 chj) (co A2 C chj)) $;

--| An ortholattice is distributive in one ordering direction (join version). (Contributed by NM, 27-Apr-2006.) (New usage is discouraged.)
theorem lejdiri (A2 B2 C: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wss (co (cin A2 B2) C chj) (cin (co A2 C chj) (co B2 C chj)) $;

--| An ortholattice is distributive in one ordering direction. (Contributed by NM, 14-Jun-2006.) (New usage is discouraged.)
theorem ledi (A2 B2 C: class):
  $ wi (w3a (wcel A2 cch) (wcel B2 cch) (wcel C cch)) (wss (co (cin A2 B2) (cin A2 C) chj) (cin A2 (co B2 C chj))) $;

--| The span of the singleton of the zero vector is the zero subspace. (Contributed by NM, 14-Jan-2005.) (New usage is discouraged.)
theorem spansn0:
  $ wceq (cfv (csn c0v) cspn) c0h $;

--| The span of the empty set is the zero subspace. Remark 11.6.e of [Schechter] p. 276. (Contributed by NM, 3-Jun-2004.) (New usage is discouraged.)
theorem span0:
  $ wceq (cfv c0 cspn) c0h $;

--| Membership in the span of a subset of Hilbert space. (Contributed by NM, 2-Jun-2004.) (New usage is discouraged.)
theorem elspani {x3: setvar} (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wi (wss A2 chba) (wb (wcel B2 (cfv A2 cspn)) (wral x3 (wi (wss A2 (cv x3)) (wcel B2 (cv x3))) csh)) $;

--| The span of a union is the subspace sum of spans. (Contributed by NM, 2-Jun-2004.) (New usage is discouraged.)
theorem spanuni (A2 B2: class):
  $ wss A2 chba $ >
  $ wss B2 chba $ >
  $ wceq (cfv (cun A2 B2) cspn) (co (cfv A2 cspn) (cfv B2 cspn) cph) $;

--| The span of a union is the subspace sum of spans. (Contributed by NM, 9-Jun-2006.) (New usage is discouraged.)
theorem spanun (A2 B2: class):
  $ wi (wa (wss A2 chba) (wss B2 chba)) (wceq (cfv (cun A2 B2) cspn) (co (cfv A2 cspn) (cfv B2 cspn) cph)) $;

--| The join of two Hilbert space subsets (not necessarily closed subspaces) equals the join of their closures (double orthocomplements). (Contributed by NM, 1-Jun-2004.) (Revised by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem sshhococi (A2 B2: class):
  $ wss A2 chba $ >
  $ wss B2 chba $ >
  $ wceq (co A2 B2 chj) (co (cfv (cfv A2 cort) cort) (cfv (cfv B2 cort) cort) chj) $;

--| Hilbert space has a nonzero vector iff it is not trivial. (Contributed by NM, 24-Feb-2006.) (New usage is discouraged.)
theorem hne0 {x3: setvar}:
  $ wb (wne chba c0h) (wrex x3 (wne (cv x3) c0v) chba) $;

--| The supremum of the empty set. (Contributed by NM, 13-Aug-2002.) (New usage is discouraged.)
theorem chsup0:
  $ wceq (cfv c0 chsup) c0h $;

--| Membership in orthocomplement of 1-dimensional subspace. (Contributed by NM, 7-Jul-2001.) (New usage is discouraged.)
theorem h1deoi (A2 B2: class):
  $ wcel B2 chba $ >
  $ wb (wcel A2 (cfv (csn B2) cort)) (wa (wcel A2 chba) (wceq (co A2 B2 csp) cc0)) $;

--| Membership in 1-dimensional subspace. (Contributed by NM, 7-Jul-2001.) (Revised by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem h1dei {x3: setvar} (A2 B2: class):
  $ wcel B2 chba $ >
  $ wb (wcel A2 (cfv (cfv (csn B2) cort) cort)) (wa (wcel A2 chba) (wral x3 (wi (wceq (co B2 (cv x3) csp) cc0) (wceq (co A2 (cv x3) csp) cc0)) chba)) $;

--| A generating vector belongs to the 1-dimensional subspace it generates. (Contributed by NM, 22-Jul-2001.) (New usage is discouraged.)
theorem h1did (A2: class):
  $ wi (wcel A2 chba) (wcel A2 (cfv (cfv (csn A2) cort) cort)) $;

--| A nonzero vector generates a (nonzero) 1-dimensional subspace. (Contributed by NM, 22-Jul-2001.) (New usage is discouraged.)
theorem h1dn0 (A2: class):
  $ wi (wa (wcel A2 chba) (wne A2 c0v)) (wne (cfv (cfv (csn A2) cort) cort) c0h) $;

--| Membership in 1-dimensional subspace. All members are collinear with the generating vector. (Contributed by NM, 17-Jul-2001.) (New usage is discouraged.)
theorem h1de2i (A2 B2: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wi (wcel A2 (cfv (cfv (csn B2) cort) cort)) (wceq (co (co B2 B2 csp) A2 csm) (co (co A2 B2 csp) B2 csm)) $;

--| Membership in 1-dimensional subspace. All members are collinear with the generating vector. (Contributed by NM, 19-Jul-2001.) (Revised by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem h1de2bi (A2 B2: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wi (wne B2 c0v) (wb (wcel A2 (cfv (cfv (csn B2) cort) cort)) (wceq A2 (co (co (co A2 B2 csp) (co B2 B2 csp) cdiv) B2 csm))) $;

--| Lemma for ~ h1de2ci . (Contributed by NM, 19-Jul-2001.) (Revised by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem h1de2ctlem {x3: setvar} (A2 B2: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wb (wcel A2 (cfv (cfv (csn B2) cort) cort)) (wrex x3 (wceq A2 (co (cv x3) B2 csm)) cc) $;

--| Membership in 1-dimensional subspace. All members are collinear with the generating vector. (Contributed by NM, 21-Jul-2001.) (Revised by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem h1de2ci {x3: setvar} (A2 B2: class):
  $ wcel B2 chba $ >
  $ wb (wcel A2 (cfv (cfv (csn B2) cort) cort)) (wrex x3 (wceq A2 (co (cv x3) B2 csm)) cc) $;

--| The span of a singleton in Hilbert space equals its closure. (Contributed by NM, 3-Jun-2004.) (New usage is discouraged.)
theorem spansni (A2: class):
  $ wcel A2 chba $ >
  $ wceq (cfv (csn A2) cspn) (cfv (cfv (csn A2) cort) cort) $;

--| Membership in the span of a singleton. (Contributed by NM, 3-Jun-2004.) (New usage is discouraged.)
theorem elspansni {x3: setvar} (A2 B2: class):
  $ wcel A2 chba $ >
  $ wb (wcel B2 (cfv (csn A2) cspn)) (wrex x3 (wceq B2 (co (cv x3) A2 csm)) cc) $;

--| The span of a singleton in Hilbert space equals its closure. (Contributed by NM, 4-Jun-2004.) (New usage is discouraged.)
theorem spansn (A2: class):
  $ wi (wcel A2 chba) (wceq (cfv (csn A2) cspn) (cfv (cfv (csn A2) cort) cort)) $;

--| The span of a Hilbert space singleton belongs to the Hilbert lattice. (Contributed by NM, 9-Jun-2004.) (New usage is discouraged.)
theorem spansnch (A2: class):
  $ wi (wcel A2 chba) (wcel (cfv (csn A2) cspn) cch) $;

--| The span of a Hilbert space singleton is a subspace. (Contributed by NM, 17-Dec-2004.) (New usage is discouraged.)
theorem spansnsh (A2: class):
  $ wi (wcel A2 chba) (wcel (cfv (csn A2) cspn) csh) $;

--| The span of a singleton in Hilbert space is a closed subspace. (Contributed by NM, 3-Jun-2004.) (New usage is discouraged.)
theorem spansnchi (A2: class):
  $ wcel A2 chba $ >
  $ wcel (cfv (csn A2) cspn) cch $;

--| A vector belongs to the span of its singleton. (Contributed by NM, 3-Jun-2004.) (New usage is discouraged.)
theorem spansnid (A2: class):
  $ wi (wcel A2 chba) (wcel A2 (cfv (csn A2) cspn)) $;

--| A scalar product with a vector belongs to the span of its singleton. (Contributed by NM, 3-Jun-2004.) (New usage is discouraged.)
theorem spansnmul (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 cc)) (wcel (co B2 A2 csm) (cfv (csn A2) cspn)) $;

--| A member of a span of a singleton is a vector. (Contributed by NM, 17-Dec-2004.) (New usage is discouraged.)
theorem elspansncl (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 (cfv (csn A2) cspn))) (wcel B2 chba) $;

--| Membership in the span of a singleton. (Contributed by NM, 5-Jun-2004.) (New usage is discouraged.)
theorem elspansn {x3: setvar} (A2 B2: class):
  $ wi (wcel A2 chba) (wb (wcel B2 (cfv (csn A2) cspn)) (wrex x3 (wceq B2 (co (cv x3) A2 csm)) cc)) $;

--| Membership in the span of a singleton. All members are collinear with the generating vector. (Contributed by NM, 5-Jun-2004.) (New usage is discouraged.)
theorem elspansn2 (A2 B2: class):
  $ wi (w3a (wcel A2 chba) (wcel B2 chba) (wne B2 c0v)) (wb (wcel A2 (cfv (csn B2) cspn)) (wceq A2 (co (co (co A2 B2 csp) (co B2 B2 csp) cdiv) B2 csm))) $;

--| The singletons of collinear vectors have the same span. (Contributed by NM, 6-Jun-2004.) (New usage is discouraged.)
theorem spansncol (A2 B2: class):
  $ wi (w3a (wcel A2 chba) (wcel B2 cc) (wne B2 cc0)) (wceq (cfv (csn (co B2 A2 csm)) cspn) (cfv (csn A2) cspn)) $;

--| Membership relation implied by equality of spans. (Contributed by NM, 6-Jun-2004.) (New usage is discouraged.)
theorem spansneleqi (A2 B2: class):
  $ wi (wcel A2 chba) (wi (wceq (cfv (csn A2) cspn) (cfv (csn B2) cspn)) (wcel A2 (cfv (csn B2) cspn))) $;

--| Membership relation that implies equality of spans. (Contributed by NM, 6-Jun-2004.) (New usage is discouraged.)
theorem spansneleq (A2 B2: class):
  $ wi (wa (wcel B2 chba) (wne A2 c0v)) (wi (wcel A2 (cfv (csn B2) cspn)) (wceq (cfv (csn A2) cspn) (cfv (csn B2) cspn))) $;

--| The span of the singleton of an element of a subspace is included in the subspace. (Contributed by NM, 5-Jun-2004.) (New usage is discouraged.)
theorem spansnss (A2 B2: class):
  $ wi (wa (wcel A2 csh) (wcel B2 A2)) (wss (cfv (csn B2) cspn) A2) $;

--| A member of the span of the singleton of a vector is a member of a subspace containing the vector. (Contributed by NM, 16-Dec-2004.) (New usage is discouraged.)
theorem elspansn3 (A2 B2 C: class):
  $ wi (w3a (wcel A2 csh) (wcel B2 A2) (wcel C (cfv (csn B2) cspn))) (wcel C A2) $;

--| A span membership condition implying two vectors belong to the same subspace. (Contributed by NM, 17-Dec-2004.) (New usage is discouraged.)
theorem elspansn4 (A2 B2 C: class):
  $ wi (wa (wa (wcel A2 csh) (wcel B2 chba)) (wa (wcel C (cfv (csn B2) cspn)) (wne C c0v))) (wb (wcel B2 A2) (wcel C A2)) $;

--| A vector belonging to both a subspace and the span of the singleton of a vector not in it must be zero. (Contributed by NM, 17-Dec-2004.) (New usage is discouraged.)
theorem elspansn5 (A2 B2 C: class):
  $ wi (wcel A2 csh) (wi (wa (wa (wcel B2 chba) (wn (wcel B2 A2))) (wa (wcel C (cfv (csn B2) cspn)) (wcel C A2))) (wceq C c0v)) $;

--| The span of the singleton of an element of a subspace is included in the subspace. (Contributed by NM, 16-Dec-2004.) (New usage is discouraged.)
theorem spansnss2 (A2 B2: class):
  $ wi (wa (wcel A2 csh) (wcel B2 chba)) (wb (wcel B2 A2) (wss (cfv (csn B2) cspn) A2)) $;

--| Cancellation-type law that "extracts" a vector ` A ` from its inner product with a proportional vector ` B ` . (Contributed by NM, 18-Mar-2006.) (New usage is discouraged.)
theorem normcan (A2 B2: class):
  $ wi (w3a (wcel B2 chba) (wne B2 c0v) (wcel A2 (cfv (csn B2) cspn))) (wceq (co (co (co A2 B2 csp) (co (cfv B2 cno) c2 cexp) cdiv) B2 csm) A2) $;

--| A projection on the span of a singleton. (The proof ws shortened by Mario Carneiro, 15-Dec-2013.) (Contributed by NM, 28-May-2006.) (Revised by Mario Carneiro, 15-Dec-2013.) (New usage is discouraged.)
theorem pjspansn (A2 B2: class):
  $ wi (w3a (wcel A2 chba) (wcel B2 chba) (wne A2 c0v)) (wceq (cfv B2 (cfv (cfv (csn A2) cspn) cpjh)) (co (co (co B2 A2 csp) (co (cfv A2 cno) c2 cexp) cdiv) A2 csm)) $;

--| A subset of Hilbert space is orthogonal to the span of the singleton of a projection onto its orthocomplement. (Contributed by NM, 4-Jun-2004.) (Revised by Mario Carneiro, 15-May-2014.) (New usage is discouraged.)
theorem spansnpji (A2 B2: class):
  $ wss A2 chba $ >
  $ wcel B2 chba $ >
  $ wss A2 (cfv (cfv (csn (cfv B2 (cfv (cfv A2 cort) cpjh))) cspn) cort) $;

--| The span of the union of a closed subspace with a singleton equals the span of its union with an orthogonal singleton. (Contributed by NM, 3-Jun-2004.) (New usage is discouraged.)
theorem spanunsni (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 chba $ >
  $ wceq (cfv (cun A2 (csn B2)) cspn) (cfv (cun A2 (csn (cfv B2 (cfv (cfv A2 cort) cpjh)))) cspn) $;

--| The span of a pair of vectors. (Contributed by NM, 9-Jun-2006.) (New usage is discouraged.)
theorem spanpr (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wss (cfv (csn (co A2 B2 cva)) cspn) (cfv (cpr A2 B2) cspn)) $;

--| A 1-dimensional subspace is an atom. (Contributed by NM, 20-Jul-2001.) (New usage is discouraged.)
theorem h1datomi (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 chba $ >
  $ wi (wss A2 (cfv (cfv (csn B2) cort) cort)) (wo (wceq A2 (cfv (cfv (csn B2) cort) cort)) (wceq A2 c0h)) $;

--| A 1-dimensional subspace is an atom. (Contributed by NM, 22-Jul-2001.) (New usage is discouraged.)
theorem h1datom (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 chba)) (wi (wss A2 (cfv (cfv (csn B2) cort) cort)) (wo (wceq A2 (cfv (cfv (csn B2) cort) cort)) (wceq A2 c0h))) $;

--| Define the commutes relation (on the Hilbert lattice). Definition of commutes in [Kalmbach] p. 20, who uses the notation xCy for "x commutes with y." See ~ cmbri for membership relation. (Contributed by NM, 14-Jun-2004.) (New usage is discouraged.)
axiom df_cm {x3 y1: setvar}:
  $ wceq ccm (copab x3 y1 (wa (wa (wcel (cv x3) cch) (wcel (cv y1) cch)) (wceq (cv x3) (co (cin (cv x3) (cv y1)) (cin (cv x3) (cfv (cv y1) cort)) chj)))) $;

--| Binary relation expressing ` A ` commutes with ` B ` . Definition of commutes in [Kalmbach] p. 20. (Contributed by NM, 14-Jun-2004.) (New usage is discouraged.)
theorem cmbr (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wbr A2 B2 ccm) (wceq A2 (co (cin A2 B2) (cin A2 (cfv B2 cort)) chj))) $;

--| Variation of orthomodular law. Definition in [Kalmbach] p. 22. (Contributed by NM, 31-Oct-2000.) (New usage is discouraged.)
theorem pjoml2i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi (wss A2 B2) (wceq (co A2 (cin (cfv A2 cort) B2) chj) B2) $;

--| Variation of orthomodular law. (Contributed by NM, 24-Jun-2004.) (New usage is discouraged.)
theorem pjoml3i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi (wss B2 A2) (wceq (cin A2 (co (cfv A2 cort) B2 chj)) B2) $;

--| Variation of orthomodular law. (Contributed by NM, 6-Dec-2000.) (New usage is discouraged.)
theorem pjoml4i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wceq (co A2 (cin B2 (co (cfv A2 cort) (cfv B2 cort) chj)) chj) (co A2 B2 chj) $;

--| The orthomodular law. Remark in [Kalmbach] p. 22. (Contributed by NM, 12-Jun-2006.) (New usage is discouraged.)
theorem pjoml5i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wceq (co A2 (cin (cfv A2 cort) (co A2 B2 chj)) chj) (co A2 B2 chj) $;

--| An equivalent of the orthomodular law. Theorem 29.13(e) of [MaedaMaeda] p. 132. (Contributed by NM, 30-May-2004.) (New usage is discouraged.)
theorem pjoml6i {x3: setvar} (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi (wss A2 B2) (wrex x3 (wa (wss A2 (cfv (cv x3) cort)) (wceq (co A2 (cv x3) chj) B2)) cch) $;

--| Binary relation expressing the commutes relation. Definition of commutes in [Kalmbach] p. 20. (Contributed by NM, 6-Aug-2004.) (New usage is discouraged.)
theorem cmbri (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wbr A2 B2 ccm) (wceq A2 (co (cin A2 B2) (cin A2 (cfv B2 cort)) chj)) $;

--| Commutation is symmetric. Theorem 3.4 of [Beran] p. 45. (Contributed by NM, 3-Nov-2000.) (New usage is discouraged.)
theorem cmcmlem (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi (wbr A2 B2 ccm) (wbr B2 A2 ccm) $;

--| Commutation is symmetric. Theorem 2(v) of [Kalmbach] p. 22. (Contributed by NM, 4-Nov-2000.) (New usage is discouraged.)
theorem cmcmi (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wbr A2 B2 ccm) (wbr B2 A2 ccm) $;

--| Commutation with orthocomplement. Theorem 2.3(i) of [Beran] p. 39. (Contributed by NM, 4-Nov-2000.) (New usage is discouraged.)
theorem cmcm2i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wbr A2 B2 ccm) (wbr A2 (cfv B2 cort) ccm) $;

--| Commutation with orthocomplement. Remark in [Kalmbach] p. 23. (Contributed by NM, 4-Nov-2000.) (New usage is discouraged.)
theorem cmcm3i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wbr A2 B2 ccm) (wbr (cfv A2 cort) B2 ccm) $;

--| Commutation with orthocomplement. Remark in [Kalmbach] p. 23. (Contributed by NM, 7-Aug-2004.) (New usage is discouraged.)
theorem cmcm4i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wbr A2 B2 ccm) (wbr (cfv A2 cort) (cfv B2 cort) ccm) $;

--| Alternate definition of the commutes relation. Remark in [Kalmbach] p. 23. (Contributed by NM, 7-Aug-2004.) (New usage is discouraged.)
theorem cmbr2i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wbr A2 B2 ccm) (wceq A2 (cin (co A2 B2 chj) (co A2 (cfv B2 cort) chj))) $;

--| Commutation is symmetric. Theorem 2(v) of [Kalmbach] p. 22. (Contributed by NM, 7-Aug-2004.) (New usage is discouraged.)
theorem cmcmii (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wbr A2 B2 ccm $ >
  $ wbr B2 A2 ccm $;

--| Commutation with orthocomplement. Theorem 2.3(i) of [Beran] p. 39. (Contributed by NM, 7-Aug-2004.) (New usage is discouraged.)
theorem cmcm2ii (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wbr A2 B2 ccm $ >
  $ wbr A2 (cfv B2 cort) ccm $;

--| Commutation with orthocomplement. Remark in [Kalmbach] p. 23. (Contributed by NM, 7-Aug-2004.) (New usage is discouraged.)
theorem cmcm3ii (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wbr A2 B2 ccm $ >
  $ wbr (cfv A2 cort) B2 ccm $;

--| Alternate definition for the commutes relation. Lemma 3 of [Kalmbach] p. 23. (Contributed by NM, 6-Dec-2000.) (New usage is discouraged.)
theorem cmbr3i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wbr A2 B2 ccm) (wceq (cin A2 (co (cfv A2 cort) B2 chj)) (cin A2 B2)) $;

--| Alternate definition for the commutes relation. (Contributed by NM, 6-Dec-2000.) (New usage is discouraged.)
theorem cmbr4i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wbr A2 B2 ccm) (wss (cin A2 (co (cfv A2 cort) B2 chj)) B2) $;

--| Comparable Hilbert lattice elements commute. Theorem 2.3(iii) of [Beran] p. 40. (Contributed by NM, 16-Jan-2005.) (New usage is discouraged.)
theorem lecmi (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi (wss A2 B2) (wbr A2 B2 ccm) $;

--| Comparable Hilbert lattice elements commute. Theorem 2.3(iii) of [Beran] p. 40. (Contributed by NM, 7-Aug-2004.) (New usage is discouraged.)
theorem lecmii (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wss A2 B2 $ >
  $ wbr A2 B2 ccm $;

--| A Hilbert lattice element commutes with its join. (Contributed by NM, 7-Aug-2004.) (New usage is discouraged.)
theorem cmj1i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wbr A2 (co A2 B2 chj) ccm $;

--| A Hilbert lattice element commutes with its join. (Contributed by NM, 7-Aug-2004.) (New usage is discouraged.)
theorem cmj2i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wbr B2 (co A2 B2 chj) ccm $;

--| A Hilbert lattice element commutes with its meet. (Contributed by NM, 7-Aug-2004.) (New usage is discouraged.)
theorem cmm1i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wbr A2 (cin A2 B2) ccm $;

--| A Hilbert lattice element commutes with its meet. (Contributed by NM, 7-Aug-2004.) (New usage is discouraged.)
theorem cmm2i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wbr B2 (cin A2 B2) ccm $;

--| Alternate definition for the commutes relation. Lemma 3 of [Kalmbach] p. 23. (Contributed by NM, 14-Jun-2006.) (New usage is discouraged.)
theorem cmbr3 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wbr A2 B2 ccm) (wceq (cin A2 (co (cfv A2 cort) B2 chj)) (cin A2 B2))) $;

--| The zero Hilbert lattice element commutes with every element. (Contributed by NM, 16-Jun-2006.) (New usage is discouraged.)
theorem cm0 (A2: class):
  $ wi (wcel A2 cch) (wbr c0h A2 ccm) $;

--| The commutes relation is reflexive. (Contributed by NM, 7-Aug-2004.) (New usage is discouraged.)
theorem cmidi (A2: class):
  $ wcel A2 cch $ >
  $ wbr A2 A2 ccm $;

--| Variation of orthomodular law. Definition in [Kalmbach] p. 22. (Contributed by NM, 13-Jun-2006.) (New usage is discouraged.)
theorem pjoml2 (A2 B2: class):
  $ wi (w3a (wcel A2 cch) (wcel B2 cch) (wss A2 B2)) (wceq (co A2 (cin (cfv A2 cort) B2) chj) B2) $;

--| Variation of orthomodular law. (Contributed by NM, 24-Jun-2004.) (New usage is discouraged.)
theorem pjoml3 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wi (wss B2 A2) (wceq (cin A2 (co (cfv A2 cort) B2 chj)) B2)) $;

--| The orthomodular law. Remark in [Kalmbach] p. 22. (Contributed by NM, 12-Jun-2006.) (New usage is discouraged.)
theorem pjoml5 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wceq (co A2 (cin (cfv A2 cort) (co A2 B2 chj)) chj) (co A2 B2 chj)) $;

--| Commutation is symmetric. Theorem 2(v) of [Kalmbach] p. 22. (Contributed by NM, 13-Jun-2006.) (New usage is discouraged.)
theorem cmcm (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wbr A2 B2 ccm) (wbr B2 A2 ccm)) $;

--| Commutation with orthocomplement. Remark in [Kalmbach] p. 23. (Contributed by NM, 13-Jun-2006.) (New usage is discouraged.)
theorem cmcm3 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wbr A2 B2 ccm) (wbr (cfv A2 cort) B2 ccm)) $;

--| Commutation with orthocomplement. Theorem 2.3(i) of [Beran] p. 39. (Contributed by NM, 14-Jun-2006.) (New usage is discouraged.)
theorem cmcm2 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wbr A2 B2 ccm) (wbr A2 (cfv B2 cort) ccm)) $;

--| Comparable Hilbert lattice elements commute. Theorem 2.3(iii) of [Beran] p. 40. (Contributed by NM, 13-Jun-2006.) (New usage is discouraged.)
theorem lecm (A2 B2: class):
  $ wi (w3a (wcel A2 cch) (wcel B2 cch) (wss A2 B2)) (wbr A2 B2 ccm) $;

--| Foulis-Holland Theorem. If any 2 pairs in a triple of orthomodular lattice elements commute, the triple is distributive. First of two parts. Theorem 5 of [Kalmbach] p. 25. (Contributed by NM, 14-Jun-2006.) (New usage is discouraged.)
theorem fh1 (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cch) (wcel B2 cch) (wcel C cch)) (wa (wbr A2 B2 ccm) (wbr A2 C ccm))) (wceq (cin A2 (co B2 C chj)) (co (cin A2 B2) (cin A2 C) chj)) $;

--| Foulis-Holland Theorem. If any 2 pairs in a triple of orthomodular lattice elements commute, the triple is distributive. Second of two parts. Theorem 5 of [Kalmbach] p. 25. (Contributed by NM, 14-Jun-2006.) (New usage is discouraged.)
theorem fh2 (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cch) (wcel B2 cch) (wcel C cch)) (wa (wbr B2 A2 ccm) (wbr B2 C ccm))) (wceq (cin A2 (co B2 C chj)) (co (cin A2 B2) (cin A2 C) chj)) $;

--| A lattice element that commutes with two others also commutes with their join. Theorem 4.2 of [Beran] p. 49. (Contributed by NM, 15-Jun-2006.) (New usage is discouraged.)
theorem cm2j (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cch) (wcel B2 cch) (wcel C cch)) (wa (wbr A2 B2 ccm) (wbr A2 C ccm))) (wbr A2 (co B2 C chj) ccm) $;

--| Foulis-Holland Theorem. If any 2 pairs in a triple of orthomodular lattice elements commute, the triple is distributive. First of two parts. Theorem 5 of [Kalmbach] p. 25. (Contributed by NM, 7-Aug-2004.) (New usage is discouraged.)
theorem fh1i (A2 B2 C: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wbr A2 B2 ccm $ >
  $ wbr A2 C ccm $ >
  $ wceq (cin A2 (co B2 C chj)) (co (cin A2 B2) (cin A2 C) chj) $;

--| Foulis-Holland Theorem. If any 2 pairs in a triple of orthomodular lattice elements commute, the triple is distributive. Second of two parts. Theorem 5 of [Kalmbach] p. 25. (Contributed by NM, 7-Aug-2004.) (New usage is discouraged.)
theorem fh2i (A2 B2 C: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wbr A2 B2 ccm $ >
  $ wbr A2 C ccm $ >
  $ wceq (cin B2 (co A2 C chj)) (co (cin B2 A2) (cin B2 C) chj) $;

--| Variation of the Foulis-Holland Theorem. (Contributed by NM, 16-Jan-2005.) (New usage is discouraged.)
theorem fh3i (A2 B2 C: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wbr A2 B2 ccm $ >
  $ wbr A2 C ccm $ >
  $ wceq (co A2 (cin B2 C) chj) (cin (co A2 B2 chj) (co A2 C chj)) $;

--| Variation of the Foulis-Holland Theorem. (Contributed by NM, 16-Jan-2005.) (New usage is discouraged.)
theorem fh4i (A2 B2 C: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wbr A2 B2 ccm $ >
  $ wbr A2 C ccm $ >
  $ wceq (co B2 (cin A2 C) chj) (cin (co B2 A2 chj) (co B2 C chj)) $;

--| A lattice element that commutes with two others also commutes with their join. Theorem 4.2 of [Beran] p. 49. (Contributed by NM, 11-May-2009.) (New usage is discouraged.)
theorem cm2ji (A2 B2 C: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wbr A2 B2 ccm $ >
  $ wbr A2 C ccm $ >
  $ wbr A2 (co B2 C chj) ccm $;

--| A lattice element that commutes with two others also commutes with their meet. Theorem 4.2 of [Beran] p. 49. (Contributed by NM, 11-May-2009.) (New usage is discouraged.)
theorem cm2mi (A2 B2 C: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wbr A2 B2 ccm $ >
  $ wbr A2 C ccm $ >
  $ wbr A2 (cin B2 C) ccm $;

--| One of the equations showing ` CH ` is an ortholattice. (This corresponds to axiom "ax-1" in the Quantum Logic Explorer.) (Contributed by NM, 4-Aug-2004.) (New usage is discouraged.)
theorem qlax1i (A2: class):
  $ wcel A2 cch $ >
  $ wceq A2 (cfv (cfv A2 cort) cort) $;

--| One of the equations showing ` CH ` is an ortholattice. (This corresponds to axiom "ax-2" in the Quantum Logic Explorer.) (Contributed by NM, 4-Aug-2004.) (New usage is discouraged.)
theorem qlax2i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wceq (co A2 B2 chj) (co B2 A2 chj) $;

--| One of the equations showing ` CH ` is an ortholattice. (This corresponds to axiom "ax-3" in the Quantum Logic Explorer.) (Contributed by NM, 4-Aug-2004.) (New usage is discouraged.)
theorem qlax3i (A2 B2 C: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wceq (co (co A2 B2 chj) C chj) (co A2 (co B2 C chj) chj) $;

--| One of the equations showing ` CH ` is an ortholattice. (This corresponds to axiom "ax-4" in the Quantum Logic Explorer.) (Contributed by NM, 4-Aug-2004.) (New usage is discouraged.)
theorem qlax4i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wceq (co A2 (co B2 (cfv B2 cort) chj) chj) (co B2 (cfv B2 cort) chj) $;

--| One of the equations showing ` CH ` is an ortholattice. (This corresponds to axiom "ax-5" in the Quantum Logic Explorer.) (Contributed by NM, 4-Aug-2004.) (New usage is discouraged.)
theorem qlax5i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wceq (co A2 (cfv (co (cfv A2 cort) B2 chj) cort) chj) A2 $;

--| One of the conditions showing ` CH ` is an ortholattice. (This corresponds to axiom "ax-r1" in the Quantum Logic Explorer.) (Contributed by NM, 4-Aug-2004.) (New usage is discouraged.)
theorem qlaxr1i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wceq A2 B2 $ >
  $ wceq B2 A2 $;

--| One of the conditions showing ` CH ` is an ortholattice. (This corresponds to axiom "ax-r2" in the Quantum Logic Explorer.) (Contributed by NM, 4-Aug-2004.) (New usage is discouraged.)
theorem qlaxr2i (A2 B2 C: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wceq A2 B2 $ >
  $ wceq B2 C $ >
  $ wceq A2 C $;

--| One of the conditions showing ` CH ` is an ortholattice. (This corresponds to axiom "ax-r4" in the Quantum Logic Explorer.) (Contributed by NM, 4-Aug-2004.) (New usage is discouraged.)
theorem qlaxr4i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wceq A2 B2 $ >
  $ wceq (cfv A2 cort) (cfv B2 cort) $;

--| One of the conditions showing ` CH ` is an ortholattice. (This corresponds to axiom "ax-r5" in the Quantum Logic Explorer.) (Contributed by NM, 4-Aug-2004.) (New usage is discouraged.)
theorem qlaxr5i (A2 B2 C: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wceq A2 B2 $ >
  $ wceq (co A2 C chj) (co B2 C chj) $;

--| A variation of the orthomodular law, showing ` CH ` is an orthomodular lattice. (This corresponds to axiom "ax-r3" in the Quantum Logic Explorer.) (Contributed by NM, 7-Aug-2004.) (New usage is discouraged.)
theorem qlaxr3i (A2 B2 C: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wceq (co C (cfv C cort) chj) (co (cfv (co (cfv A2 cort) (cfv B2 cort) chj) cort) (cfv (co A2 B2 chj) cort) chj) $ >
  $ wceq A2 B2 $;

--| Lemma for ~ chscl . (Contributed by Mario Carneiro, 19-May-2014.) (New usage is discouraged.)
theorem chscllem1 {u n: setvar} (ph: wff u) (A2 B2: class) (F: class u n) (H: class):
  $ wi ph (wcel A2 cch) $ >
  $ wi ph (wcel B2 cch) $ >
  $ wi ph (wss B2 (cfv A2 cort)) $ >
  $ wi ph (wf cn (co A2 B2 cph) H) $ >
  $ wi ph (wbr H (cv u) chli) $ >
  $ wceq F (cmpt n cn (cfv (cfv (cv n) H) (cfv A2 cpjh))) $ >
  $ wi ph (wf cn A2 F) $;

--| Lemma for ~ chscl . (Contributed by Mario Carneiro, 19-May-2014.) (New usage is discouraged.)
theorem chscllem2 {u n: setvar} (ph: wff u) (A2 B2: class) (F: class u n) (H: class):
  $ wi ph (wcel A2 cch) $ >
  $ wi ph (wcel B2 cch) $ >
  $ wi ph (wss B2 (cfv A2 cort)) $ >
  $ wi ph (wf cn (co A2 B2 cph) H) $ >
  $ wi ph (wbr H (cv u) chli) $ >
  $ wceq F (cmpt n cn (cfv (cfv (cv n) H) (cfv A2 cpjh))) $ >
  $ wi ph (wcel F (cdm chli)) $;

--| Lemma for ~ chscl . (Contributed by Mario Carneiro, 19-May-2014.) (New usage is discouraged.)
theorem chscllem3 {u n: setvar} (ph: wff u) (A2 B2: class) (C D F: class u n) (H: class) (N: class u):
  $ wi ph (wcel A2 cch) $ >
  $ wi ph (wcel B2 cch) $ >
  $ wi ph (wss B2 (cfv A2 cort)) $ >
  $ wi ph (wf cn (co A2 B2 cph) H) $ >
  $ wi ph (wbr H (cv u) chli) $ >
  $ wceq F (cmpt n cn (cfv (cfv (cv n) H) (cfv A2 cpjh))) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel C A2) $ >
  $ wi ph (wcel D B2) $ >
  $ wi ph (wceq (cfv N H) (co C D cva)) $ >
  $ wi ph (wceq C (cfv N F)) $;

--| Lemma for ~ chscl . (Contributed by Mario Carneiro, 19-May-2014.) (New usage is discouraged.)
theorem chscllem4 {u n: setvar} (ph: wff u) (A2 B2: class) (F G: class u n) (H: class):
  $ wi ph (wcel A2 cch) $ >
  $ wi ph (wcel B2 cch) $ >
  $ wi ph (wss B2 (cfv A2 cort)) $ >
  $ wi ph (wf cn (co A2 B2 cph) H) $ >
  $ wi ph (wbr H (cv u) chli) $ >
  $ wceq F (cmpt n cn (cfv (cfv (cv n) H) (cfv A2 cpjh))) $ >
  $ wceq G (cmpt n cn (cfv (cfv (cv n) H) (cfv B2 cpjh))) $ >
  $ wi ph (wcel (cv u) (co A2 B2 cph)) $;

--| The subspace sum of two closed orthogonal spaces is closed. (Contributed by NM, 19-Oct-1999.) (Proof shortened by Mario Carneiro, 19-May-2014.) (New usage is discouraged.)
theorem chscl (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cch) $ >
  $ wi ph (wcel B2 cch) $ >
  $ wi ph (wss B2 (cfv A2 cort)) $ >
  $ wi ph (wcel (co A2 B2 cph) cch) $;

--| If two closed subspaces of a Hilbert space are orthogonal, their subspace sum equals their subspace join. Lemma 3 of [Kalmbach] p. 67. Note that the (countable) Axiom of Choice is used for this proof via ~ pjhth , although "the hard part" of this proof, ~ chscl , requires no choice. (Contributed by NM, 28-Oct-1999.) (Revised by Mario Carneiro, 19-May-2014.) (New usage is discouraged.)
theorem osumi (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi (wss A2 (cfv B2 cort)) (wceq (co A2 B2 cph) (co A2 B2 chj)) $;

--| Corollary of ~ osumi . (Contributed by NM, 5-Nov-2000.) (New usage is discouraged.)
theorem osumcori (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wceq (co (cin A2 B2) (cin A2 (cfv B2 cort)) cph) (co (cin A2 B2) (cin A2 (cfv B2 cort)) chj) $;

--| Corollary of ~ osumi , showing it holds under the weaker hypothesis that ` A ` and ` B ` commute. (Contributed by NM, 6-Dec-2000.) (New usage is discouraged.)
theorem osumcor2i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi (wbr A2 B2 ccm) (wceq (co A2 B2 cph) (co A2 B2 chj)) $;

--| If two closed subspaces of a Hilbert space are orthogonal, their subspace sum equals their subspace join. Lemma 3 of [Kalmbach] p. 67. (Contributed by NM, 31-Oct-2005.) (New usage is discouraged.)
theorem osum (A2 B2: class):
  $ wi (w3a (wcel A2 cch) (wcel B2 cch) (wss A2 (cfv B2 cort))) (wceq (co A2 B2 cph) (co A2 B2 chj)) $;

--| The subspace sum of a closed subspace and a one-dimensional subspace equals their join. (Proof suggested by Eric Schechter 1-Jun-2004.) (Contributed by NM, 1-Jun-2004.) (New usage is discouraged.)
theorem spansnji (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 chba $ >
  $ wceq (co A2 (cfv (csn B2) cspn) cph) (co A2 (cfv (csn B2) cspn) chj) $;

--| The subspace sum of a closed subspace and a one-dimensional subspace equals their join. (Contributed by NM, 4-Jun-2004.) (New usage is discouraged.)
theorem spansnj (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 chba)) (wceq (co A2 (cfv (csn B2) cspn) cph) (co A2 (cfv (csn B2) cspn) chj)) $;

--| The subspace sum of a closed subspace and a one-dimensional subspace is closed. (Contributed by NM, 17-Dec-2004.) (New usage is discouraged.)
theorem spansnscl (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 chba)) (wcel (co A2 (cfv (csn B2) cspn) cph) cch) $;

--| The sum of two vectors belong to the span of one of them iff the other vector also belongs. (Contributed by NM, 1-Nov-2005.) (New usage is discouraged.)
theorem sumspansn (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wb (wcel (co A2 B2 cva) (cfv (csn A2) cspn)) (wcel B2 (cfv (csn A2) cspn))) $;

--| The meet of different one-dimensional subspaces is the zero subspace. (Contributed by NM, 1-Nov-2005.) (New usage is discouraged.)
theorem spansnm0i (A2 B2: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wi (wn (wcel A2 (cfv (csn B2) cspn))) (wceq (cin (cfv (csn A2) cspn) (cfv (csn B2) cspn)) c0h) $;

--| A Hilbert lattice with two or more dimensions fails the distributive law and therefore cannot be a Boolean algebra. This counterexample demonstrates a condition where ` ( ( H i^i F ) vH ( H i^i G ) ) = 0H ` but ` ( H i^i ( F vH G ) ) =/= 0H ` . The antecedent specifies that the vectors ` A ` and ` B ` are nonzero and non-colinear. The last three hypotheses assign one-dimensional subspaces to ` F ` , ` G ` , and ` H ` . (Contributed by NM, 1-Nov-2005.) (New usage is discouraged.)
theorem nonbooli (A2 B2 F G H: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wceq F (cfv (csn A2) cspn) $ >
  $ wceq G (cfv (csn B2) cspn) $ >
  $ wceq H (cfv (csn (co A2 B2 cva)) cspn) $ >
  $ wi (wn (wo (wcel A2 G) (wcel B2 F))) (wne (cin H (co F G chj)) (co (cin H F) (cin H G) chj)) $;

--| Hilbert space has the covering property (using spans of singletons to represent atoms). Exercise 5 of [Kalmbach] p. 153. (Contributed by NM, 7-Jun-2004.) (New usage is discouraged.)
theorem spansncvi (A2 B2 C: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C chba $ >
  $ wi (wa (wpss A2 B2) (wss B2 (co A2 (cfv (csn C) cspn) chj))) (wceq B2 (co A2 (cfv (csn C) cspn) chj)) $;

--| Hilbert space has the covering property (using spans of singletons to represent atoms). Exercise 5 of [Kalmbach] p. 153. (Contributed by NM, 9-Jun-2004.) (New usage is discouraged.)
theorem spansncv (A2 B2 C: class):
  $ wi (w3a (wcel A2 cch) (wcel B2 cch) (wcel C chba)) (wi (wa (wpss A2 B2) (wss B2 (co A2 (cfv (csn C) cspn) chj))) (wceq B2 (co A2 (cfv (csn C) cspn) chj))) $;

--| Lemma for orthoarguesian law 5OA. (Contributed by NM, 1-Apr-2000.) (New usage is discouraged.)
theorem _5oalem1 (x3 y1 z v: setvar) (A2 B2 C R: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wcel C csh $ >
  $ wcel R csh $ >
  $ wi (wa (wa (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) (wceq (cv v) (co (cv x3) (cv y1) cva))) (wa (wcel (cv z) C) (wcel (co (cv x3) (cv z) cmv) R))) (wcel (cv v) (co B2 (cin A2 (co C R cph)) cph)) $;

--| Lemma for orthoarguesian law 5OA. (Contributed by NM, 2-Apr-2000.) (New usage is discouraged.)
theorem _5oalem2 (x3 y1 z w: setvar) (A2 B2 C D: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wcel C csh $ >
  $ wcel D csh $ >
  $ wi (wa (wa (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) (wa (wcel (cv z) C) (wcel (cv w) D))) (wceq (co (cv x3) (cv y1) cva) (co (cv z) (cv w) cva))) (wcel (co (cv x3) (cv z) cmv) (cin (co A2 C cph) (co B2 D cph))) $;

--| Lemma for orthoarguesian law 5OA. (Contributed by NM, 2-Apr-2000.) (New usage is discouraged.)
theorem _5oalem3 (x3 y1 z w: setvar) (A2 B2 C D: class) (f2 g2: setvar) (F G: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wcel C csh $ >
  $ wcel D csh $ >
  $ wcel F csh $ >
  $ wcel G csh $ >
  $ wi (wa (wa (wa (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) (wa (wcel (cv z) C) (wcel (cv w) D))) (wa (wcel (cv f2) F) (wcel (cv g2) G))) (wa (wceq (co (cv x3) (cv y1) cva) (co (cv f2) (cv g2) cva)) (wceq (co (cv z) (cv w) cva) (co (cv f2) (cv g2) cva)))) (wcel (co (cv x3) (cv z) cmv) (co (cin (co A2 F cph) (co B2 G cph)) (cin (co C F cph) (co D G cph)) cph)) $;

--| Lemma for orthoarguesian law 5OA. (Contributed by NM, 2-Apr-2000.) (New usage is discouraged.)
theorem _5oalem4 (x3 y1 z w: setvar) (A2 B2 C D: class) (f2 g2: setvar) (F G: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wcel C csh $ >
  $ wcel D csh $ >
  $ wcel F csh $ >
  $ wcel G csh $ >
  $ wi (wa (wa (wa (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) (wa (wcel (cv z) C) (wcel (cv w) D))) (wa (wcel (cv f2) F) (wcel (cv g2) G))) (wa (wceq (co (cv x3) (cv y1) cva) (co (cv f2) (cv g2) cva)) (wceq (co (cv z) (cv w) cva) (co (cv f2) (cv g2) cva)))) (wcel (co (cv x3) (cv z) cmv) (cin (cin (co A2 C cph) (co B2 D cph)) (co (cin (co A2 F cph) (co B2 G cph)) (cin (co C F cph) (co D G cph)) cph))) $;

--| Lemma for orthoarguesian law 5OA. (Contributed by NM, 2-May-2000.) (New usage is discouraged.)
theorem _5oalem5 (x3 y1 z w v u: setvar) (A2 B2 C D R S: class) (f2 g2: setvar) (F G: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wcel C csh $ >
  $ wcel D csh $ >
  $ wcel F csh $ >
  $ wcel G csh $ >
  $ wcel R csh $ >
  $ wcel S csh $ >
  $ wi (wa (wa (wa (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) (wa (wcel (cv z) C) (wcel (cv w) D))) (wa (wa (wcel (cv f2) F) (wcel (cv g2) G)) (wa (wcel (cv v) R) (wcel (cv u) S)))) (wa (wa (wceq (co (cv x3) (cv y1) cva) (co (cv v) (cv u) cva)) (wceq (co (cv z) (cv w) cva) (co (cv v) (cv u) cva))) (wceq (co (cv f2) (cv g2) cva) (co (cv v) (cv u) cva)))) (wcel (co (cv x3) (cv z) cmv) (cin (cin (cin (co A2 C cph) (co B2 D cph)) (co (cin (co A2 R cph) (co B2 S cph)) (cin (co C R cph) (co D S cph)) cph)) (co (cin (cin (co A2 F cph) (co B2 G cph)) (co (cin (co A2 R cph) (co B2 S cph)) (cin (co F R cph) (co G S cph)) cph)) (cin (cin (co C F cph) (co D G cph)) (co (cin (co C R cph) (co D S cph)) (cin (co F R cph) (co G S cph)) cph)) cph))) $;

--| Lemma for orthoarguesian law 5OA. (Contributed by NM, 4-May-2000.) (New usage is discouraged.)
theorem _5oalem6 (x3 y1 z w v u: setvar) (A2 B2 C D R S: class) (f2 g2 h: setvar) (F G: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wcel C csh $ >
  $ wcel D csh $ >
  $ wcel F csh $ >
  $ wcel G csh $ >
  $ wcel R csh $ >
  $ wcel S csh $ >
  $ wi (wa (wa (wa (wa (wcel (cv x3) A2) (wcel (cv y1) B2)) (wceq (cv h) (co (cv x3) (cv y1) cva))) (wa (wa (wcel (cv z) C) (wcel (cv w) D)) (wceq (cv h) (co (cv z) (cv w) cva)))) (wa (wa (wa (wcel (cv f2) F) (wcel (cv g2) G)) (wceq (cv h) (co (cv f2) (cv g2) cva))) (wa (wa (wcel (cv v) R) (wcel (cv u) S)) (wceq (cv h) (co (cv v) (cv u) cva))))) (wcel (cv h) (co B2 (cin A2 (co C (cin (cin (cin (co A2 C cph) (co B2 D cph)) (co (cin (co A2 R cph) (co B2 S cph)) (cin (co C R cph) (co D S cph)) cph)) (co (cin (cin (co A2 F cph) (co B2 G cph)) (co (cin (co A2 R cph) (co B2 S cph)) (cin (co F R cph) (co G S cph)) cph)) (cin (cin (co C F cph) (co D G cph)) (co (cin (co C R cph) (co D S cph)) (cin (co F R cph) (co G S cph)) cph)) cph)) cph)) cph)) $;

--| Lemma for orthoarguesian law 5OA. (Contributed by NM, 4-May-2000.) TODO: replace uses of ~ ee4anv with ~ 4exdistrv as in ~ 3oalem3 . (New usage is discouraged.)
theorem _5oalem7 (A2 B2 C D R S F G: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wcel C csh $ >
  $ wcel D csh $ >
  $ wcel F csh $ >
  $ wcel G csh $ >
  $ wcel R csh $ >
  $ wcel S csh $ >
  $ wss (cin (cin (co A2 B2 cph) (co C D cph)) (cin (co F G cph) (co R S cph))) (co B2 (cin A2 (co C (cin (cin (cin (co A2 C cph) (co B2 D cph)) (co (cin (co A2 R cph) (co B2 S cph)) (cin (co C R cph) (co D S cph)) cph)) (co (cin (cin (co A2 F cph) (co B2 G cph)) (co (cin (co A2 R cph) (co B2 S cph)) (cin (co F R cph) (co G S cph)) cph)) (cin (cin (co C F cph) (co D G cph)) (co (cin (co C R cph) (co D S cph)) (cin (co F R cph) (co G S cph)) cph)) cph)) cph)) cph) $;

--| Orthoarguesian law 5OA. This 8-variable inference is called 5OA because it can be converted to a 5-variable equation (see Quantum Logic Explorer). (Contributed by NM, 5-May-2000.) (New usage is discouraged.)
theorem _5oai (A2 B2 C D R S F G: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wcel D cch $ >
  $ wcel F cch $ >
  $ wcel G cch $ >
  $ wcel R cch $ >
  $ wcel S cch $ >
  $ wss A2 (cfv B2 cort) $ >
  $ wss C (cfv D cort) $ >
  $ wss F (cfv G cort) $ >
  $ wss R (cfv S cort) $ >
  $ wss (cin (cin (co A2 B2 chj) (co C D chj)) (cin (co F G chj) (co R S chj))) (co B2 (cin A2 (co C (cin (cin (cin (co A2 C chj) (co B2 D chj)) (co (cin (co A2 R chj) (co B2 S chj)) (cin (co C R chj) (co D S chj)) chj)) (co (cin (cin (co A2 F chj) (co B2 G chj)) (co (cin (co A2 R chj) (co B2 S chj)) (cin (co F R chj) (co G S chj)) chj)) (cin (cin (co C F chj) (co D G chj)) (co (cin (co C R chj) (co D S chj)) (cin (co F R chj) (co G S chj)) chj)) chj)) chj)) chj) $;

--| Lemma for 3OA (weak) orthoarguesian law. (Contributed by NM, 19-Oct-1999.) (New usage is discouraged.)
theorem _3oalem1 (x3 y1 z w v: setvar) (B2 C R S: class):
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wcel R cch $ >
  $ wcel S cch $ >
  $ wi (wa (wa (wa (wcel (cv x3) B2) (wcel (cv y1) R)) (wceq (cv v) (co (cv x3) (cv y1) cva))) (wa (wa (wcel (cv z) C) (wcel (cv w) S)) (wceq (cv v) (co (cv z) (cv w) cva)))) (wa (wa (wa (wcel (cv x3) chba) (wcel (cv y1) chba)) (wcel (cv v) chba)) (wa (wcel (cv z) chba) (wcel (cv w) chba))) $;

--| Lemma for 3OA (weak) orthoarguesian law. (Contributed by NM, 19-Oct-1999.) (New usage is discouraged.)
theorem _3oalem2 (x3 y1 z w v: setvar) (B2 C R S: class):
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wcel R cch $ >
  $ wcel S cch $ >
  $ wi (wa (wa (wa (wcel (cv x3) B2) (wcel (cv y1) R)) (wceq (cv v) (co (cv x3) (cv y1) cva))) (wa (wa (wcel (cv z) C) (wcel (cv w) S)) (wceq (cv v) (co (cv z) (cv w) cva)))) (wcel (cv v) (co B2 (cin R (co S (cin (co B2 C cph) (co R S cph)) cph)) cph)) $;

--| Lemma for 3OA (weak) orthoarguesian law. (Contributed by NM, 19-Oct-1999.) (New usage is discouraged.)
theorem _3oalem3 (B2 C R S: class):
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wcel R cch $ >
  $ wcel S cch $ >
  $ wss (cin (co B2 R cph) (co C S cph)) (co B2 (cin R (co S (cin (co B2 C cph) (co R S cph)) cph)) cph) $;

--| Lemma for 3OA (weak) orthoarguesian law. (Contributed by NM, 19-Oct-1999.) (New usage is discouraged.)
theorem _3oalem4 (A2 B2 R: class):
  $ wceq R (cin (cfv B2 cort) (co B2 A2 chj)) $ >
  $ wss R (cfv B2 cort) $;

--| Lemma for 3OA (weak) orthoarguesian law. (Contributed by NM, 19-Oct-1999.) (New usage is discouraged.)
theorem _3oalem5 (A2 B2 C R S: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wceq R (cin (cfv B2 cort) (co B2 A2 chj)) $ >
  $ wceq S (cin (cfv C cort) (co C A2 chj)) $ >
  $ wceq (cin (co B2 R cph) (co C S cph)) (cin (co B2 R chj) (co C S chj)) $;

--| Lemma for 3OA (weak) orthoarguesian law. (Contributed by NM, 19-Oct-1999.) (New usage is discouraged.)
theorem _3oalem6 (A2 B2 C R S: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wceq R (cin (cfv B2 cort) (co B2 A2 chj)) $ >
  $ wceq S (cin (cfv C cort) (co C A2 chj)) $ >
  $ wss (co B2 (cin R (co S (cin (co B2 C cph) (co R S cph)) cph)) cph) (co B2 (cin R (co S (cin (co B2 C chj) (co R S chj)) chj)) chj) $;

--| 3OA (weak) orthoarguesian law. Equation IV of [GodowskiGreechie] p. 249. (Contributed by NM, 19-Oct-1999.) (New usage is discouraged.)
theorem _3oai (A2 B2 C R S: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wceq R (cin (cfv B2 cort) (co B2 A2 chj)) $ >
  $ wceq S (cin (cfv C cort) (co C A2 chj)) $ >
  $ wss (cin (co B2 R chj) (co C S chj)) (co B2 (cin R (co S (cin (co B2 C chj) (co R S chj)) chj)) chj) $;

--| Projection components on orthocomplemented subspaces are orthogonal. (Contributed by NM, 26-Oct-1999.) (New usage is discouraged.)
theorem pjorthi (A2 B2 H: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wi (wcel H cch) (wceq (co (cfv A2 (cfv H cpjh)) (cfv B2 (cfv (cfv H cort) cpjh)) csp) cc0) $;

--| Property of identity projection. Remark in [Beran] p. 111. (Contributed by NM, 28-Oct-1999.) (New usage is discouraged.)
theorem pjch1 (A2: class):
  $ wi (wcel A2 chba) (wceq (cfv A2 (cfv chba cpjh)) A2) $;

--| The orthogonal projection. Lemma 4.4(i) of [Beran] p. 111. (Contributed by NM, 30-Oct-1999.) (New usage is discouraged.)
theorem pjo (A2 H: class):
  $ wi (wa (wcel H cch) (wcel A2 chba)) (wceq (cfv A2 (cfv (cfv H cort) cpjh)) (co (cfv A2 (cfv chba cpjh)) (cfv A2 (cfv H cpjh)) cmv)) $;

--| Component of a projection. (Contributed by NM, 31-Oct-1999.) (Revised by Mario Carneiro, 19-May-2014.) (New usage is discouraged.)
theorem pjcompi (A2 B2 H: class):
  $ wcel H cch $ >
  $ wi (wa (wcel A2 H) (wcel B2 (cfv H cort))) (wceq (cfv (co A2 B2 cva) (cfv H cpjh)) A2) $;

--| A projection is idempotent. Property (ii) of [Beran] p. 109. (Contributed by NM, 28-Oct-1999.) (New usage is discouraged.)
theorem pjidmi (A2 H: class):
  $ wcel H cch $ >
  $ wcel A2 chba $ >
  $ wceq (cfv (cfv A2 (cfv H cpjh)) (cfv H cpjh)) (cfv A2 (cfv H cpjh)) $;

--| A projection is self-adjoint. Property (i) of [Beran] p. 109. (Contributed by NM, 30-Oct-1999.) (New usage is discouraged.)
theorem pjadjii (A2 B2 H: class):
  $ wcel H cch $ >
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wceq (co (cfv A2 (cfv H cpjh)) B2 csp) (co A2 (cfv B2 (cfv H cpjh)) csp) $;

--| Projection of vector sum is sum of projections. (Contributed by NM, 31-Oct-1999.) (New usage is discouraged.)
theorem pjaddii (A2 B2 H: class):
  $ wcel H cch $ >
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wceq (cfv (co A2 B2 cva) (cfv H cpjh)) (co (cfv A2 (cfv H cpjh)) (cfv B2 (cfv H cpjh)) cva) $;

--| The inner product of a projection and its argument is the square of the norm of the projection. Remark in [Halmos] p. 44. (Contributed by NM, 13-Aug-2000.) (New usage is discouraged.)
theorem pjinormii (A2 H: class):
  $ wcel H cch $ >
  $ wcel A2 chba $ >
  $ wceq (co (cfv A2 (cfv H cpjh)) A2 csp) (co (cfv (cfv A2 (cfv H cpjh)) cno) c2 cexp) $;

--| Projection of (scalar) product is product of projection. (Contributed by NM, 31-Oct-1999.) (New usage is discouraged.)
theorem pjmulii (A2 C H: class):
  $ wcel H cch $ >
  $ wcel A2 chba $ >
  $ wcel C cc $ >
  $ wceq (cfv (co C A2 csm) (cfv H cpjh)) (co C (cfv A2 (cfv H cpjh)) csm) $;

--| Projection of vector difference is difference of projections. (Contributed by NM, 31-Oct-1999.) (New usage is discouraged.)
theorem pjsubii (A2 B2 H: class):
  $ wcel H cch $ >
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wceq (cfv (co A2 B2 cmv) (cfv H cpjh)) (co (cfv A2 (cfv H cpjh)) (cfv B2 (cfv H cpjh)) cmv) $;

--| Lemma for subset relationships of projections. (Contributed by NM, 31-Oct-1999.) (New usage is discouraged.)
theorem pjsslem (A2 G H: class):
  $ wcel H cch $ >
  $ wcel A2 chba $ >
  $ wcel G cch $ >
  $ wceq (co (cfv A2 (cfv (cfv H cort) cpjh)) (cfv A2 (cfv (cfv G cort) cpjh)) cmv) (co (cfv A2 (cfv G cpjh)) (cfv A2 (cfv H cpjh)) cmv) $;

--| Subset relationship for projections. Theorem 4.5(i)->(ii) of [Beran] p. 112. (Contributed by NM, 31-Oct-1999.) (New usage is discouraged.)
theorem pjss2i (A2 G H: class):
  $ wcel H cch $ >
  $ wcel A2 chba $ >
  $ wcel G cch $ >
  $ wi (wss H G) (wceq (cfv (cfv A2 (cfv G cpjh)) (cfv H cpjh)) (cfv A2 (cfv H cpjh))) $;

--| Projection meet property. Remark in [Kalmbach] p. 66. Also Theorem 4.5(i)->(iv) of [Beran] p. 112. (Contributed by NM, 31-Oct-1999.) (New usage is discouraged.)
theorem pjssmii (A2 G H: class):
  $ wcel H cch $ >
  $ wcel A2 chba $ >
  $ wcel G cch $ >
  $ wi (wss H G) (wceq (co (cfv A2 (cfv G cpjh)) (cfv A2 (cfv H cpjh)) cmv) (cfv A2 (cfv (cin G (cfv H cort)) cpjh))) $;

--| Theorem 4.5(iv)->(v) of [Beran] p. 112. (Contributed by NM, 13-Aug-2000.) (New usage is discouraged.)
theorem pjssge0ii (A2 G H: class):
  $ wcel H cch $ >
  $ wcel A2 chba $ >
  $ wcel G cch $ >
  $ wi (wceq (co (cfv A2 (cfv G cpjh)) (cfv A2 (cfv H cpjh)) cmv) (cfv A2 (cfv (cin G (cfv H cort)) cpjh))) (wbr cc0 (co (co (cfv A2 (cfv G cpjh)) (cfv A2 (cfv H cpjh)) cmv) A2 csp) cle) $;

--| Theorem 4.5(v)<->(vi) of [Beran] p. 112. (Contributed by NM, 13-Aug-2000.) (New usage is discouraged.)
theorem pjdifnormii (A2 G H: class):
  $ wcel H cch $ >
  $ wcel A2 chba $ >
  $ wcel G cch $ >
  $ wb (wbr cc0 (co (co (cfv A2 (cfv G cpjh)) (cfv A2 (cfv H cpjh)) cmv) A2 csp) cle) (wbr (cfv (cfv A2 (cfv H cpjh)) cno) (cfv (cfv A2 (cfv G cpjh)) cno) cle) $;

--| The projection on a subspace join is the sum of the projections. (Contributed by NM, 1-Nov-1999.) (New usage is discouraged.)
theorem pjcji (A2 G H: class):
  $ wcel H cch $ >
  $ wcel A2 chba $ >
  $ wcel G cch $ >
  $ wi (wss H (cfv G cort)) (wceq (cfv A2 (cfv (co H G chj) cpjh)) (co (cfv A2 (cfv H cpjh)) (cfv A2 (cfv G cpjh)) cva)) $;

--| A projection is self-adjoint. Property (i) of [Beran] p. 109. (Contributed by NM, 6-Oct-2000.) (New usage is discouraged.)
theorem pjadji (A2 B2 H: class):
  $ wcel H cch $ >
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wceq (co (cfv A2 (cfv H cpjh)) B2 csp) (co A2 (cfv B2 (cfv H cpjh)) csp)) $;

--| Projection of vector sum is sum of projections. (Contributed by NM, 14-Nov-2000.) (New usage is discouraged.)
theorem pjaddi (A2 B2 H: class):
  $ wcel H cch $ >
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wceq (cfv (co A2 B2 cva) (cfv H cpjh)) (co (cfv A2 (cfv H cpjh)) (cfv B2 (cfv H cpjh)) cva)) $;

--| The inner product of a projection and its argument is the square of the norm of the projection. Remark in [Halmos] p. 44. (Contributed by NM, 2-Jun-2006.) (New usage is discouraged.)
theorem pjinormi (A2 H: class):
  $ wcel H cch $ >
  $ wi (wcel A2 chba) (wceq (co (cfv A2 (cfv H cpjh)) A2 csp) (co (cfv (cfv A2 (cfv H cpjh)) cno) c2 cexp)) $;

--| Projection of vector difference is difference of projections. (Contributed by NM, 14-Nov-2000.) (New usage is discouraged.)
theorem pjsubi (A2 B2 H: class):
  $ wcel H cch $ >
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wceq (cfv (co A2 B2 cmv) (cfv H cpjh)) (co (cfv A2 (cfv H cpjh)) (cfv B2 (cfv H cpjh)) cmv)) $;

--| Projection of scalar product is scalar product of projection. (Contributed by NM, 26-Nov-2000.) (New usage is discouraged.)
theorem pjmuli (A2 B2 H: class):
  $ wcel H cch $ >
  $ wi (wa (wcel A2 cc) (wcel B2 chba)) (wceq (cfv (co A2 B2 csm) (cfv H cpjh)) (co A2 (cfv B2 (cfv H cpjh)) csm)) $;

--| The inner product of a projection and its argument is nonnegative. (Contributed by NM, 2-Jun-2006.) (New usage is discouraged.)
theorem pjige0i (A2 H: class):
  $ wcel H cch $ >
  $ wi (wcel A2 chba) (wbr cc0 (co (cfv A2 (cfv H cpjh)) A2 csp) cle) $;

--| The inner product of a projection and its argument is nonnegative. (Contributed by NM, 2-Jun-2006.) (New usage is discouraged.)
theorem pjige0 (A2 H: class):
  $ wi (wa (wcel H cch) (wcel A2 chba)) (wbr cc0 (co (cfv A2 (cfv H cpjh)) A2 csp) cle) $;

--| The projection on a subspace join is the sum of the projections. (Contributed by NM, 1-Nov-1999.) (New usage is discouraged.)
theorem pjcjt2 (A2 G H: class):
  $ wi (w3a (wcel H cch) (wcel G cch) (wcel A2 chba)) (wi (wss H (cfv G cort)) (wceq (cfv A2 (cfv (co H G chj) cpjh)) (co (cfv A2 (cfv H cpjh)) (cfv A2 (cfv G cpjh)) cva))) $;

--| The projection of the zero vector. (Contributed by NM, 31-Oct-1999.) (New usage is discouraged.)
theorem pj0i (H: class):
  $ wcel H cch $ >
  $ wceq (cfv c0v (cfv H cpjh)) c0v $;

--| Projection of a vector in the projection subspace. Lemma 4.4(ii) of [Beran] p. 111. (Contributed by NM, 30-Oct-1999.) (New usage is discouraged.)
theorem pjch (A2 H: class):
  $ wi (wa (wcel H cch) (wcel A2 chba)) (wb (wcel A2 H) (wceq (cfv A2 (cfv H cpjh)) A2)) $;

--| The projection of a vector in the projection subspace is itself. (Contributed by NM, 9-Apr-2006.) (New usage is discouraged.)
theorem pjid (A2 H: class):
  $ wi (wa (wcel H cch) (wcel A2 H)) (wceq (cfv A2 (cfv H cpjh)) A2) $;

--| The set of vectors belonging to the subspace of a projection. Part of Theorem 26.2 of [Halmos] p. 44. (Contributed by NM, 11-Apr-2006.) (New usage is discouraged.)
theorem pjvec {x3: setvar} (H: class):
  $ wi (wcel H cch) (wceq H (crab x3 (wceq (cfv (cv x3) (cfv H cpjh)) (cv x3)) chba)) $;

--| The set of vectors belonging to the orthocomplemented subspace of a projection. Second part of Theorem 27.3 of [Halmos] p. 45. (Contributed by NM, 24-Apr-2006.) (New usage is discouraged.)
theorem pjocvec {x3: setvar} (H: class):
  $ wi (wcel H cch) (wceq (cfv H cort) (crab x3 (wceq (cfv (cv x3) (cfv H cpjh)) c0v) chba)) $;

--| Membership of projection in orthocomplement of intersection. (Contributed by NM, 21-Apr-2001.) (New usage is discouraged.)
theorem pjocini (A2 G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wi (wcel A2 (cfv (cin G H) cort)) (wcel (cfv A2 (cfv G cpjh)) (cfv (cin G H) cort)) $;

--| Membership of projection in an intersection. (Contributed by NM, 22-Apr-2001.) (New usage is discouraged.)
theorem pjini (A2 G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wi (wcel A2 (cin G H)) (wcel (cfv A2 (cfv G cpjh)) (cin G H)) $;

--| A sufficient condition for subspace join to be equal to subspace sum. (Contributed by NM, 29-May-2004.) (New usage is discouraged.)
theorem pjjsi {x3: setvar} (G H: class):
  $ wcel G cch $ >
  $ wcel H csh $ >
  $ wi (wral x3 (wcel (cfv (cv x3) (cfv (cfv G cort) cpjh)) H) (co G H chj)) (wceq (co G H chj) (co G H cph)) $;

--| Functionality of a projection. (Contributed by NM, 30-Oct-1999.) (Revised by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem pjfni (H: class):
  $ wcel H cch $ >
  $ wfn (cfv H cpjh) chba $;

--| The range of a projection. Part of Theorem 26.2 of [Halmos] p. 44. (Contributed by NM, 30-Oct-1999.) (Revised by Mario Carneiro, 10-Sep-2015.) (New usage is discouraged.)
theorem pjrni (H: class):
  $ wcel H cch $ >
  $ wceq (crn (cfv H cpjh)) H $;

--| A projection maps onto its subspace. (Contributed by NM, 24-Apr-2006.) (New usage is discouraged.)
theorem pjfoi (H: class):
  $ wcel H cch $ >
  $ wfo chba H (cfv H cpjh) $;

--| The mapping of a projection. (Contributed by NM, 11-Nov-2000.) (New usage is discouraged.)
theorem pjfi (H: class):
  $ wcel H cch $ >
  $ wf chba chba (cfv H cpjh) $;

--| The value of a projection in terms of components. (Contributed by NM, 28-Nov-2000.) (New usage is discouraged.)
theorem pjvi (A2 B2 H: class):
  $ wcel H cch $ >
  $ wi (wa (wcel A2 H) (wcel B2 (cfv H cort))) (wceq (cfv (co A2 B2 cva) (cfv H cpjh)) A2) $;

--| A projection maps onto its subspace. (Contributed by NM, 24-Apr-2006.) (New usage is discouraged.)
theorem pjhfo (H: class):
  $ wi (wcel H cch) (wfo chba H (cfv H cpjh)) $;

--| The range of a projection. Part of Theorem 26.2 of [Halmos] p. 44. (Contributed by NM, 24-Apr-2006.) (New usage is discouraged.)
theorem pjrn (H: class):
  $ wi (wcel H cch) (wceq (crn (cfv H cpjh)) H) $;

--| The mapping of a projection. (Contributed by NM, 24-Apr-2006.) (New usage is discouraged.)
theorem pjhf (H: class):
  $ wi (wcel H cch) (wf chba chba (cfv H cpjh)) $;

--| Functionality of a projection. (Contributed by NM, 30-May-2006.) (New usage is discouraged.)
theorem pjfn (H: class):
  $ wi (wcel H cch) (wfn (cfv H cpjh) chba) $;

--| The projection on a subspace sum is the sum of the projections. (Contributed by NM, 11-Nov-2000.) (New usage is discouraged.)
theorem pjsumi (A2 G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wi (wcel A2 chba) (wi (wss G (cfv H cort)) (wceq (cfv A2 (cfv (co G H cph) cpjh)) (co (cfv A2 (cfv G cpjh)) (cfv A2 (cfv H cpjh)) cva))) $;

--| One-to-one correspondence of projection and subspace. (Contributed by NM, 26-Nov-2000.) (New usage is discouraged.)
theorem pj11i (G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wb (wceq (cfv G cpjh) (cfv H cpjh)) (wceq G H) $;

--| Vector decomposition into sum of projections on orthogonal subspaces. (Contributed by NM, 21-Jun-2006.) (New usage is discouraged.)
theorem pjdsi (A2 G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wi (wa (wcel A2 (co G H chj)) (wss G (cfv H cort))) (wceq A2 (co (cfv A2 (cfv G cpjh)) (cfv A2 (cfv H cpjh)) cva)) $;

--| Vector decomposition into sum of projections on orthogonal subspaces. (Contributed by NM, 22-Jun-2006.) (New usage is discouraged.)
theorem pjds3i (A2 F G H: class):
  $ wcel F cch $ >
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wi (wa (wa (wcel A2 (co (co F G chj) H chj)) (wss F (cfv G cort))) (wa (wss F (cfv H cort)) (wss G (cfv H cort)))) (wceq A2 (co (co (cfv A2 (cfv F cpjh)) (cfv A2 (cfv G cpjh)) cva) (cfv A2 (cfv H cpjh)) cva)) $;

--| One-to-one correspondence of projection and subspace. (Contributed by NM, 24-Apr-2006.) (New usage is discouraged.)
theorem pj11 (G H: class):
  $ wi (wa (wcel G cch) (wcel H cch)) (wb (wceq (cfv G cpjh) (cfv H cpjh)) (wceq G H)) $;

--| Functionality of the projection function. (Contributed by NM, 24-Apr-2006.) (New usage is discouraged.)
theorem pjmfn:
  $ wfn cpjh cch $;

--| The projector function maps one-to-one into the set of Hilbert space operators. (Contributed by NM, 24-Apr-2006.) (New usage is discouraged.)
theorem pjmf1:
  $ wf1 cch (co chba chba cmap) cpjh $;

--| The inner product of projections on orthogonal subspaces vanishes. (Contributed by NM, 30-Jun-2006.) (New usage is discouraged.)
theorem pjoi0 (A2 G H: class):
  $ wi (wa (w3a (wcel G cch) (wcel H cch) (wcel A2 chba)) (wss G (cfv H cort))) (wceq (co (cfv A2 (cfv G cpjh)) (cfv A2 (cfv H cpjh)) csp) cc0) $;

--| The inner product of projections on orthogonal subspaces vanishes. (Contributed by NM, 1-Nov-1999.) (New usage is discouraged.)
theorem pjoi0i (A2 G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wcel A2 chba $ >
  $ wi (wss G (cfv H cort)) (wceq (co (cfv A2 (cfv G cpjh)) (cfv A2 (cfv H cpjh)) csp) cc0) $;

--| Pythagorean theorem for projections on orthogonal subspaces. (Contributed by NM, 1-Nov-1999.) (New usage is discouraged.)
theorem pjopythi (A2 G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wcel A2 chba $ >
  $ wi (wss G (cfv H cort)) (wceq (co (cfv (co (cfv A2 (cfv G cpjh)) (cfv A2 (cfv H cpjh)) cva) cno) c2 cexp) (co (co (cfv (cfv A2 (cfv G cpjh)) cno) c2 cexp) (co (cfv (cfv A2 (cfv H cpjh)) cno) c2 cexp) caddc)) $;

--| Pythagorean theorem for projections on orthogonal subspaces. (Contributed by NM, 2-Nov-1999.) (New usage is discouraged.)
theorem pjopyth (A2 G H: class):
  $ wi (w3a (wcel H cch) (wcel G cch) (wcel A2 chba)) (wi (wss H (cfv G cort)) (wceq (co (cfv (co (cfv A2 (cfv H cpjh)) (cfv A2 (cfv G cpjh)) cva) cno) c2 cexp) (co (co (cfv (cfv A2 (cfv H cpjh)) cno) c2 cexp) (co (cfv (cfv A2 (cfv G cpjh)) cno) c2 cexp) caddc))) $;

--| The norm of the projection is less than or equal to the norm. (Contributed by NM, 27-Oct-1999.) (New usage is discouraged.)
theorem pjnormi (A2 H: class):
  $ wcel H cch $ >
  $ wcel A2 chba $ >
  $ wbr (cfv (cfv A2 (cfv H cpjh)) cno) (cfv A2 cno) cle $;

--| Pythagorean theorem for projections. (Contributed by NM, 27-Oct-1999.) (New usage is discouraged.)
theorem pjpythi (A2 H: class):
  $ wcel H cch $ >
  $ wcel A2 chba $ >
  $ wceq (co (cfv A2 cno) c2 cexp) (co (co (cfv (cfv A2 (cfv H cpjh)) cno) c2 cexp) (co (cfv (cfv A2 (cfv (cfv H cort) cpjh)) cno) c2 cexp) caddc) $;

--| If a vector does not belong to subspace, the norm of its projection is less than its norm. (Contributed by NM, 27-Oct-1999.) (New usage is discouraged.)
theorem pjneli (A2 H: class):
  $ wcel H cch $ >
  $ wcel A2 chba $ >
  $ wb (wn (wcel A2 H)) (wbr (cfv (cfv A2 (cfv H cpjh)) cno) (cfv A2 cno) clt) $;

--| The norm of the projection is less than or equal to the norm. (Contributed by NM, 28-Oct-1999.) (New usage is discouraged.)
theorem pjnorm (A2 H: class):
  $ wi (wa (wcel H cch) (wcel A2 chba)) (wbr (cfv (cfv A2 (cfv H cpjh)) cno) (cfv A2 cno) cle) $;

--| Pythagorean theorem for projectors. (Contributed by NM, 11-Apr-2006.) (New usage is discouraged.)
theorem pjpyth (A2 H: class):
  $ wi (wa (wcel H cch) (wcel A2 chba)) (wceq (co (cfv A2 cno) c2 cexp) (co (co (cfv (cfv A2 (cfv H cpjh)) cno) c2 cexp) (co (cfv (cfv A2 (cfv (cfv H cort) cpjh)) cno) c2 cexp) caddc)) $;

--| If a vector does not belong to subspace, the norm of its projection is less than its norm. (Contributed by NM, 2-Nov-1999.) (New usage is discouraged.)
theorem pjnel (A2 H: class):
  $ wi (wa (wcel H cch) (wcel A2 chba)) (wb (wn (wcel A2 H)) (wbr (cfv (cfv A2 (cfv H cpjh)) cno) (cfv A2 cno) clt)) $;

--| A vector belongs to the subspace of a projection iff the norm of its projection equals its norm. This and ~ pjch yield Theorem 26.3 of [Halmos] p. 44. (Contributed by NM, 7-Apr-2001.) (New usage is discouraged.)
theorem pjnorm2 (A2 H: class):
  $ wi (wa (wcel H cch) (wcel A2 chba)) (wb (wcel A2 H) (wceq (cfv (cfv A2 (cfv H cpjh)) cno) (cfv A2 cno))) $;

--| Mayet's equation E_3. Part of Theorem 4.1 of [Mayet3] p. 1223. (Contributed by NM, 22-Jun-2006.) (New usage is discouraged.)
theorem mayete3i (A2 B2 C D F G X Y Z: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wcel D cch $ >
  $ wcel F cch $ >
  $ wcel G cch $ >
  $ wss A2 (cfv C cort) $ >
  $ wss A2 (cfv F cort) $ >
  $ wss C (cfv F cort) $ >
  $ wss A2 (cfv B2 cort) $ >
  $ wss C (cfv D cort) $ >
  $ wss F (cfv G cort) $ >
  $ wceq X (co (co A2 C chj) F chj) $ >
  $ wceq Y (cin (cin (co A2 B2 chj) (co C D chj)) (co F G chj)) $ >
  $ wceq Z (co (co B2 D chj) G chj) $ >
  $ wss (cin X Y) Z $;

--| Mayet's equation E^*_3, derived from E_3. Solution, for n = 3, to open problem in Remark (b) after Theorem 7.1 of [Mayet3] p. 1240. (Contributed by NM, 10-May-2009.) (New usage is discouraged.)
theorem mayetes3i (A2 B2 C D R F G X Y Z: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wcel D cch $ >
  $ wcel F cch $ >
  $ wcel G cch $ >
  $ wcel R cch $ >
  $ wss A2 (cfv C cort) $ >
  $ wss A2 (cfv F cort) $ >
  $ wss C (cfv F cort) $ >
  $ wss A2 (cfv B2 cort) $ >
  $ wss C (cfv D cort) $ >
  $ wss F (cfv G cort) $ >
  $ wss R (cfv X cort) $ >
  $ wceq X (co (co A2 C chj) F chj) $ >
  $ wceq Y (cin (cin (co A2 B2 chj) (co C D chj)) (co F G chj)) $ >
  $ wceq Z (co (co B2 D chj) G chj) $ >
  $ wss (cin (co X R chj) Y) (co Z R chj) $;

--| Define the sum of two Hilbert space operators. Definition of [Beran] p. 111. (Contributed by NM, 9-Nov-2000.) (New usage is discouraged.)
axiom df_hosum {x3 f2 g2: setvar}:
  $ wceq chos (cmpo f2 g2 (co chba chba cmap) (co chba chba cmap) (cmpt x3 chba (co (cfv (cv x3) (cv f2)) (cfv (cv x3) (cv g2)) cva))) $;

--| Define the scalar product with a Hilbert space operator. Definition of [Beran] p. 111. (Contributed by NM, 20-Feb-2006.) (New usage is discouraged.)
axiom df_homul {x3 f2 g2: setvar}:
  $ wceq chot (cmpo f2 g2 cc (co chba chba cmap) (cmpt x3 chba (co (cv f2) (cfv (cv x3) (cv g2)) csm))) $;

--| Define the difference of two Hilbert space operators. Definition of [Beran] p. 111. (Contributed by NM, 9-Nov-2000.) (New usage is discouraged.)
axiom df_hodif {x3 f2 g2: setvar}:
  $ wceq chod (cmpo f2 g2 (co chba chba cmap) (co chba chba cmap) (cmpt x3 chba (co (cfv (cv x3) (cv f2)) (cfv (cv x3) (cv g2)) cmv))) $;

--| Define the sum of two Hilbert space functionals. Definition of [Beran] p. 111. Note that unlike some authors, we define a functional as any function from ` ~H ` to ` CC ` , not just linear (or bounded linear) ones. (Contributed by NM, 23-May-2006.) (New usage is discouraged.)
axiom df_hfsum {x3 f2 g2: setvar}:
  $ wceq chfs (cmpo f2 g2 (co cc chba cmap) (co cc chba cmap) (cmpt x3 chba (co (cfv (cv x3) (cv f2)) (cfv (cv x3) (cv g2)) caddc))) $;

--| Define the scalar product with a Hilbert space functional. Definition of [Beran] p. 111. (Contributed by NM, 23-May-2006.) (New usage is discouraged.)
axiom df_hfmul {x3 f2 g2: setvar}:
  $ wceq chft (cmpo f2 g2 cc (co cc chba cmap) (cmpt x3 chba (co (cv f2) (cfv (cv x3) (cv g2)) cmul))) $;

--| Value of the sum of two Hilbert space operators. (Contributed by NM, 9-Nov-2000.) (Revised by Mario Carneiro, 23-Aug-2014.) (New usage is discouraged.)
theorem hosmval {x3: setvar} (S T: class):
  $ wi (wa (wf chba chba S) (wf chba chba T)) (wceq (co S T chos) (cmpt x3 chba (co (cfv (cv x3) S) (cfv (cv x3) T) cva))) $;

--| Value of the scalar product with a Hilbert space operator. (Contributed by NM, 20-Feb-2006.) (Revised by Mario Carneiro, 23-Aug-2014.) (New usage is discouraged.)
theorem hommval {x3: setvar} (A2 T: class):
  $ wi (wa (wcel A2 cc) (wf chba chba T)) (wceq (co A2 T chot) (cmpt x3 chba (co A2 (cfv (cv x3) T) csm))) $;

--| Value of the difference of two Hilbert space operators. (Contributed by NM, 9-Nov-2000.) (Revised by Mario Carneiro, 23-Aug-2014.) (New usage is discouraged.)
theorem hodmval {x3: setvar} (S T: class):
  $ wi (wa (wf chba chba S) (wf chba chba T)) (wceq (co S T chod) (cmpt x3 chba (co (cfv (cv x3) S) (cfv (cv x3) T) cmv))) $;

--| Value of the sum of two Hilbert space functionals. (Contributed by NM, 23-May-2006.) (Revised by Mario Carneiro, 23-Aug-2014.) (New usage is discouraged.)
theorem hfsmval {x3: setvar} (S T: class):
  $ wi (wa (wf chba cc S) (wf chba cc T)) (wceq (co S T chfs) (cmpt x3 chba (co (cfv (cv x3) S) (cfv (cv x3) T) caddc))) $;

--| Value of the scalar product with a Hilbert space functional. (Contributed by NM, 23-May-2006.) (Revised by Mario Carneiro, 23-Aug-2014.) (New usage is discouraged.)
theorem hfmmval {x3: setvar} (A2 T: class):
  $ wi (wa (wcel A2 cc) (wf chba cc T)) (wceq (co A2 T chft) (cmpt x3 chba (co A2 (cfv (cv x3) T) cmul))) $;

--| Value of the sum of two Hilbert space operators. (Contributed by NM, 10-Nov-2000.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem hosval (A2 S T: class):
  $ wi (w3a (wf chba chba S) (wf chba chba T) (wcel A2 chba)) (wceq (cfv A2 (co S T chos)) (co (cfv A2 S) (cfv A2 T) cva)) $;

--| Value of the scalar product with a Hilbert space operator. (Contributed by NM, 20-Feb-2006.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem homval (A2 B2 T: class):
  $ wi (w3a (wcel A2 cc) (wf chba chba T) (wcel B2 chba)) (wceq (cfv B2 (co A2 T chot)) (co A2 (cfv B2 T) csm)) $;

--| Value of the difference of two Hilbert space operators. (Contributed by NM, 10-Nov-2000.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem hodval (A2 S T: class):
  $ wi (w3a (wf chba chba S) (wf chba chba T) (wcel A2 chba)) (wceq (cfv A2 (co S T chod)) (co (cfv A2 S) (cfv A2 T) cmv)) $;

--| Value of the sum of two Hilbert space functionals. (Contributed by NM, 23-May-2006.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem hfsval (A2 S T: class):
  $ wi (w3a (wf chba cc S) (wf chba cc T) (wcel A2 chba)) (wceq (cfv A2 (co S T chfs)) (co (cfv A2 S) (cfv A2 T) caddc)) $;

--| Value of the scalar product with a Hilbert space functional. (Contributed by NM, 23-May-2006.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem hfmval (A2 B2 T: class):
  $ wi (w3a (wcel A2 cc) (wf chba cc T) (wcel B2 chba)) (wceq (cfv B2 (co A2 T chft)) (co A2 (cfv B2 T) cmul)) $;

--| Closure of the sum of two Hilbert space operators. (Contributed by NM, 12-Nov-2000.) (New usage is discouraged.)
theorem hoscl (A2 S T: class):
  $ wi (wa (wa (wf chba chba S) (wf chba chba T)) (wcel A2 chba)) (wcel (cfv A2 (co S T chos)) chba) $;

--| Closure of the scalar product of a Hilbert space operator. (Contributed by NM, 20-Feb-2006.) (New usage is discouraged.)
theorem homcl (A2 B2 T: class):
  $ wi (w3a (wcel A2 cc) (wf chba chba T) (wcel B2 chba)) (wcel (cfv B2 (co A2 T chot)) chba) $;

--| Closure of the difference of two Hilbert space operators. (Contributed by NM, 15-Nov-2002.) (New usage is discouraged.)
theorem hodcl (A2 S T: class):
  $ wi (wa (wa (wf chba chba S) (wf chba chba T)) (wcel A2 chba)) (wcel (cfv A2 (co S T chod)) chba) $;

--| Define the Hilbert space zero operator. See ~ df0op2 for alternate definition. (Contributed by NM, 7-Feb-2006.) (New usage is discouraged.)
axiom df_h0op:
  $ wceq ch0o (cfv c0h cpjh) $;

--| Define the Hilbert space identity operator. See ~ dfiop2 for alternate definition. (Contributed by NM, 15-Nov-2000.) (New usage is discouraged.)
axiom df_iop:
  $ wceq chio (cfv chba cpjh) $;

--| Value of the zero Hilbert space operator (null projector). Remark in [Beran] p. 111. (Contributed by NM, 7-Feb-2006.) (New usage is discouraged.)
theorem ho0val (A2: class):
  $ wi (wcel A2 chba) (wceq (cfv A2 ch0o) c0v) $;

--| Functionality of the zero Hilbert space operator. (Contributed by NM, 10-Mar-2006.) (New usage is discouraged.)
theorem ho0f:
  $ wf chba chba ch0o $;

--| Alternate definition of Hilbert space zero operator. (Contributed by NM, 7-Aug-2006.) (New usage is discouraged.)
theorem df0op2:
  $ wceq ch0o (cxp chba c0h) $;

--| Alternate definition of Hilbert space identity operator. (Contributed by NM, 7-Aug-2006.) (New usage is discouraged.)
theorem dfiop2:
  $ wceq chio (cres cid chba) $;

--| Functionality of the Hilbert space identity operator. (Contributed by NM, 8-Aug-2006.) (New usage is discouraged.)
theorem hoif:
  $ wf1o chba chba chio $;

--| The value of the Hilbert space identity operator. (Contributed by NM, 8-Aug-2006.) (New usage is discouraged.)
theorem hoival (A2: class):
  $ wi (wcel A2 chba) (wceq (cfv A2 chio) A2) $;

--| Composition with the Hilbert space identity operator. (Contributed by NM, 24-Aug-2006.) (New usage is discouraged.)
theorem hoico1 (T: class):
  $ wi (wf chba chba T) (wceq (ccom T chio) T) $;

--| Composition with the Hilbert space identity operator. (Contributed by NM, 24-Aug-2006.) (New usage is discouraged.)
theorem hoico2 (T: class):
  $ wi (wf chba chba T) (wceq (ccom chio T) T) $;

--| The sum of Hilbert space operators is an operator. (Contributed by NM, 21-Feb-2006.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem hoaddcl (S T: class):
  $ wi (wa (wf chba chba S) (wf chba chba T)) (wf chba chba (co S T chos)) $;

--| The scalar product of a Hilbert space operator is an operator. (Contributed by NM, 21-Feb-2006.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem homulcl (A2 T: class):
  $ wi (wa (wcel A2 cc) (wf chba chba T)) (wf chba chba (co A2 T chot)) $;

--| Equality of Hilbert space operators. (Contributed by NM, 12-Aug-2006.) (New usage is discouraged.)
theorem hoeq {x3: setvar} (T U: class):
  $ wi (wa (wf chba chba T) (wf chba chba U)) (wb (wral x3 (wceq (cfv (cv x3) T) (cfv (cv x3) U)) chba) (wceq T U)) $;

--| Equality of Hilbert space operators. (Contributed by NM, 14-Nov-2000.) (New usage is discouraged.)
theorem hoeqi {x3: setvar} (S T: class):
  $ wf chba chba S $ >
  $ wf chba chba T $ >
  $ wb (wral x3 (wceq (cfv (cv x3) S) (cfv (cv x3) T)) chba) (wceq S T) $;

--| Closure of Hilbert space operator sum. (Contributed by NM, 12-Nov-2000.) (New usage is discouraged.)
theorem hoscli (A2 S T: class):
  $ wf chba chba S $ >
  $ wf chba chba T $ >
  $ wi (wcel A2 chba) (wcel (cfv A2 (co S T chos)) chba) $;

--| Closure of Hilbert space operator difference. (Contributed by NM, 12-Nov-2000.) (New usage is discouraged.)
theorem hodcli (A2 S T: class):
  $ wf chba chba S $ >
  $ wf chba chba T $ >
  $ wi (wcel A2 chba) (wcel (cfv A2 (co S T chod)) chba) $;

--| Composition of Hilbert space operators. (Contributed by NM, 12-Nov-2000.) (New usage is discouraged.)
theorem hocoi (A2 S T: class):
  $ wf chba chba S $ >
  $ wf chba chba T $ >
  $ wi (wcel A2 chba) (wceq (cfv A2 (ccom S T)) (cfv (cfv A2 T) S)) $;

--| Closure of composition of Hilbert space operators. (Contributed by NM, 12-Nov-2000.) (New usage is discouraged.)
theorem hococli (A2 S T: class):
  $ wf chba chba S $ >
  $ wf chba chba T $ >
  $ wi (wcel A2 chba) (wcel (cfv A2 (ccom S T)) chba) $;

--| Mapping of composition of Hilbert space operators. (Contributed by NM, 14-Nov-2000.) (New usage is discouraged.)
theorem hocofi (S T: class):
  $ wf chba chba S $ >
  $ wf chba chba T $ >
  $ wf chba chba (ccom S T) $;

--| Functionality of composition of Hilbert space operators. (Contributed by NM, 12-Nov-2000.) (New usage is discouraged.)
theorem hocofni (S T: class):
  $ wf chba chba S $ >
  $ wf chba chba T $ >
  $ wfn (ccom S T) chba $;

--| Mapping of sum of Hilbert space operators. (Contributed by NM, 14-Nov-2000.) (New usage is discouraged.)
theorem hoaddcli (S T: class):
  $ wf chba chba S $ >
  $ wf chba chba T $ >
  $ wf chba chba (co S T chos) $;

--| Mapping of difference of Hilbert space operators. (Contributed by NM, 14-Nov-2000.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem hosubcli (S T: class):
  $ wf chba chba S $ >
  $ wf chba chba T $ >
  $ wf chba chba (co S T chod) $;

--| Functionality of sum of Hilbert space operators. (Contributed by NM, 14-Nov-2000.) (New usage is discouraged.)
theorem hoaddfni (S T: class):
  $ wf chba chba S $ >
  $ wf chba chba T $ >
  $ wfn (co S T chos) chba $;

--| Functionality of difference of Hilbert space operators. (Contributed by NM, 2-Jun-2006.) (New usage is discouraged.)
theorem hosubfni (S T: class):
  $ wf chba chba S $ >
  $ wf chba chba T $ >
  $ wfn (co S T chod) chba $;

--| Commutativity of sum of Hilbert space operators. (Contributed by NM, 15-Nov-2000.) (New usage is discouraged.)
theorem hoaddcomi (S T: class):
  $ wf chba chba S $ >
  $ wf chba chba T $ >
  $ wceq (co S T chos) (co T S chos) $;

--| Mapping of difference of Hilbert space operators. (Contributed by NM, 23-Aug-2006.) (New usage is discouraged.)
theorem hosubcl (S T: class):
  $ wi (wa (wf chba chba S) (wf chba chba T)) (wf chba chba (co S T chod)) $;

--| Commutativity of sum of Hilbert space operators. (Contributed by NM, 24-Aug-2006.) (New usage is discouraged.)
theorem hoaddcom (S T: class):
  $ wi (wa (wf chba chba S) (wf chba chba T)) (wceq (co S T chos) (co T S chos)) $;

--| Relationship between Hilbert space operator difference and sum. (Contributed by NM, 17-Nov-2000.) (New usage is discouraged.)
theorem hodsi (R S T: class):
  $ wf chba chba R $ >
  $ wf chba chba S $ >
  $ wf chba chba T $ >
  $ wb (wceq (co R S chod) T) (wceq (co S T chos) R) $;

--| Associativity of sum of Hilbert space operators. (Contributed by NM, 26-Nov-2000.) (New usage is discouraged.)
theorem hoaddassi (R S T: class):
  $ wf chba chba R $ >
  $ wf chba chba S $ >
  $ wf chba chba T $ >
  $ wceq (co (co R S chos) T chos) (co R (co S T chos) chos) $;

--| Commutative/associative law for Hilbert space operator sum that swaps the first two terms. (Contributed by NM, 27-Aug-2004.) (New usage is discouraged.)
theorem hoadd12i (R S T: class):
  $ wf chba chba R $ >
  $ wf chba chba S $ >
  $ wf chba chba T $ >
  $ wceq (co R (co S T chos) chos) (co S (co R T chos) chos) $;

--| Commutative/associative law for Hilbert space operator sum that swaps the second and third terms. (Contributed by NM, 27-Jul-2006.) (New usage is discouraged.)
theorem hoadd32i (R S T: class):
  $ wf chba chba R $ >
  $ wf chba chba S $ >
  $ wf chba chba T $ >
  $ wceq (co (co R S chos) T chos) (co (co R T chos) S chos) $;

--| Distributive law for Hilbert space operator sum. (Contributed by NM, 26-Nov-2000.) (New usage is discouraged.)
theorem hocadddiri (R S T: class):
  $ wf chba chba R $ >
  $ wf chba chba S $ >
  $ wf chba chba T $ >
  $ wceq (ccom (co R S chos) T) (co (ccom R T) (ccom S T) chos) $;

--| Distributive law for Hilbert space operator difference. (Contributed by NM, 26-Nov-2000.) (New usage is discouraged.)
theorem hocsubdiri (R S T: class):
  $ wf chba chba R $ >
  $ wf chba chba S $ >
  $ wf chba chba T $ >
  $ wceq (ccom (co R S chod) T) (co (ccom R T) (ccom S T) chod) $;

--| Double composition of Hilbert space operators. (Contributed by NM, 1-Dec-2000.) (New usage is discouraged.)
theorem ho2coi (A2 R S T: class):
  $ wf chba chba R $ >
  $ wf chba chba S $ >
  $ wf chba chba T $ >
  $ wi (wcel A2 chba) (wceq (cfv A2 (ccom (ccom R S) T)) (cfv (cfv (cfv A2 T) S) R)) $;

--| Associativity of sum of Hilbert space operators. (Contributed by NM, 24-Aug-2006.) (New usage is discouraged.)
theorem hoaddass (R S T: class):
  $ wi (w3a (wf chba chba R) (wf chba chba S) (wf chba chba T)) (wceq (co (co R S chos) T chos) (co R (co S T chos) chos)) $;

--| Commutative/associative law for Hilbert space operator sum that swaps the second and third terms. (Contributed by NM, 24-Aug-2006.) (New usage is discouraged.)
theorem hoadd32 (R S T: class):
  $ wi (w3a (wf chba chba R) (wf chba chba S) (wf chba chba T)) (wceq (co (co R S chos) T chos) (co (co R T chos) S chos)) $;

--| Rearrangement of 4 terms in a sum of Hilbert space operators. (Contributed by NM, 24-Aug-2006.) (New usage is discouraged.)
theorem hoadd4 (R S T U: class):
  $ wi (wa (wa (wf chba chba R) (wf chba chba S)) (wa (wf chba chba T) (wf chba chba U))) (wceq (co (co R S chos) (co T U chos) chos) (co (co R T chos) (co S U chos) chos)) $;

--| Distributive law for Hilbert space operator difference. (Contributed by NM, 23-Aug-2006.) (New usage is discouraged.)
theorem hocsubdir (R S T: class):
  $ wi (w3a (wf chba chba R) (wf chba chba S) (wf chba chba T)) (wceq (ccom (co R S chod) T) (co (ccom R T) (ccom S T) chod)) $;

--| Sum of a Hilbert space operator with the zero operator. (Contributed by NM, 15-Nov-2000.) (New usage is discouraged.)
theorem hoaddridi (T: class):
  $ wf chba chba T $ >
  $ wceq (co T ch0o chos) T $;

--| Difference of a Hilbert space operator from itself. (Contributed by NM, 10-Mar-2006.) (New usage is discouraged.)
theorem hodidi (T: class):
  $ wf chba chba T $ >
  $ wceq (co T T chod) ch0o $;

--| Composition of the zero operator and a Hilbert space operator. (Contributed by NM, 9-Aug-2006.) (New usage is discouraged.)
theorem ho0coi (T: class):
  $ wf chba chba T $ >
  $ wceq (ccom ch0o T) ch0o $;

--| Composition of Hilbert space operator with unit identity. (Contributed by NM, 15-Nov-2000.) (New usage is discouraged.)
theorem hoid1i (T: class):
  $ wf chba chba T $ >
  $ wceq (ccom T chio) T $;

--| Composition of Hilbert space operator with unit identity. (Contributed by NM, 15-Nov-2000.) (New usage is discouraged.)
theorem hoid1ri (T: class):
  $ wf chba chba T $ >
  $ wceq (ccom chio T) T $;

--| Sum of a Hilbert space operator with the zero operator. (Contributed by NM, 25-Jul-2006.) (New usage is discouraged.)
theorem hoaddrid (T: class):
  $ wi (wf chba chba T) (wceq (co T ch0o chos) T) $;

--| Difference of a Hilbert space operator from itself. (Contributed by NM, 23-Jul-2006.) (New usage is discouraged.)
theorem hodid (T: class):
  $ wi (wf chba chba T) (wceq (co T T chod) ch0o) $;

--| A Hilbert space operator is not empty. (Contributed by NM, 24-Mar-2006.) (New usage is discouraged.)
theorem hon0 (T: class):
  $ wi (wf chba chba T) (wn (wceq T c0)) $;

--| Subtraction and addition of equal Hilbert space operators. (Contributed by NM, 27-Aug-2004.) (New usage is discouraged.)
theorem hodseqi (S T: class):
  $ wf chba chba S $ >
  $ wf chba chba T $ >
  $ wceq (co S (co T S chod) chos) T $;

--| Subtraction of Hilbert space operators expressed in terms of difference from zero. (Contributed by NM, 10-Mar-2006.) (New usage is discouraged.)
theorem ho0subi (S T: class):
  $ wf chba chba S $ >
  $ wf chba chba T $ >
  $ wceq (co S T chod) (co S (co ch0o T chod) chos) $;

--| Relationship between Hilbert operator addition and subtraction. (Contributed by NM, 24-Aug-2006.) (New usage is discouraged.)
theorem honegsubi (S T: class):
  $ wf chba chba S $ >
  $ wf chba chba T $ >
  $ wceq (co S (co (cneg c1) T chot) chos) (co S T chod) $;

--| Subtraction of Hilbert space operators expressed in terms of difference from zero. (Contributed by NM, 25-Jul-2006.) (New usage is discouraged.)
theorem ho0sub (S T: class):
  $ wi (wa (wf chba chba S) (wf chba chba T)) (wceq (co S T chod) (co S (co ch0o T chod) chos)) $;

--| The zero operator subtracted from a Hilbert space operator. (Contributed by NM, 25-Jul-2006.) (New usage is discouraged.)
theorem hosubid1 (T: class):
  $ wi (wf chba chba T) (wceq (co T ch0o chod) T) $;

--| Relationship between Hilbert space operator addition and subtraction. (Contributed by NM, 24-Aug-2006.) (New usage is discouraged.)
theorem honegsub (T U: class):
  $ wi (wa (wf chba chba T) (wf chba chba U)) (wceq (co T (co (cneg c1) U chot) chos) (co T U chod)) $;

--| An operator equals its scalar product with one. (Contributed by NM, 12-Aug-2006.) (New usage is discouraged.)
theorem homullid (T: class):
  $ wi (wf chba chba T) (wceq (co c1 T chot) T) $;

--| Associative law for scalar product and composition of operators. (Contributed by NM, 13-Aug-2006.) (New usage is discouraged.)
theorem homco1 (A2 T U: class):
  $ wi (w3a (wcel A2 cc) (wf chba chba T) (wf chba chba U)) (wceq (ccom (co A2 T chot) U) (co A2 (ccom T U) chot)) $;

--| Scalar product associative law for Hilbert space operators. (Contributed by NM, 12-Aug-2006.) (New usage is discouraged.)
theorem homulass (A2 B2 T: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wf chba chba T)) (wceq (co (co A2 B2 cmul) T chot) (co A2 (co B2 T chot) chot)) $;

--| Scalar product distributive law for Hilbert space operators. (Contributed by NM, 12-Aug-2006.) (New usage is discouraged.)
theorem hoadddi (A2 T U: class):
  $ wi (w3a (wcel A2 cc) (wf chba chba T) (wf chba chba U)) (wceq (co A2 (co T U chos) chot) (co (co A2 T chot) (co A2 U chot) chos)) $;

--| Scalar product reverse distributive law for Hilbert space operators. (Contributed by NM, 25-Aug-2006.) (New usage is discouraged.)
theorem hoadddir (A2 B2 T: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wf chba chba T)) (wceq (co (co A2 B2 caddc) T chot) (co (co A2 T chot) (co B2 T chot) chos)) $;

--| Swap first and second factors in a nested operator scalar product. (Contributed by NM, 12-Aug-2006.) (New usage is discouraged.)
theorem homul12 (A2 B2 T: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wf chba chba T)) (wceq (co A2 (co B2 T chot) chot) (co B2 (co A2 T chot) chot)) $;

--| Double negative of a Hilbert space operator. (Contributed by NM, 24-Aug-2006.) (New usage is discouraged.)
theorem honegneg (T: class):
  $ wi (wf chba chba T) (wceq (co (cneg c1) (co (cneg c1) T chot) chot) T) $;

--| Relationship between operator subtraction and negative. (Contributed by NM, 25-Aug-2006.) (New usage is discouraged.)
theorem hosubneg (T U: class):
  $ wi (wa (wf chba chba T) (wf chba chba U)) (wceq (co T (co (cneg c1) U chot) chod) (co T U chos)) $;

--| Scalar product distributive law for operator difference. (Contributed by NM, 12-Aug-2006.) (New usage is discouraged.)
theorem hosubdi (A2 T U: class):
  $ wi (w3a (wcel A2 cc) (wf chba chba T) (wf chba chba U)) (wceq (co A2 (co T U chod) chot) (co (co A2 T chot) (co A2 U chot) chod)) $;

--| Distribution of negative over addition. (Contributed by NM, 24-Aug-2006.) (New usage is discouraged.)
theorem honegdi (T U: class):
  $ wi (wa (wf chba chba T) (wf chba chba U)) (wceq (co (cneg c1) (co T U chos) chot) (co (co (cneg c1) T chot) (co (cneg c1) U chot) chos)) $;

--| Distribution of negative over subtraction. (Contributed by NM, 24-Aug-2006.) (New usage is discouraged.)
theorem honegsubdi (T U: class):
  $ wi (wa (wf chba chba T) (wf chba chba U)) (wceq (co (cneg c1) (co T U chod) chot) (co (co (cneg c1) T chot) U chos)) $;

--| Distribution of negative over subtraction. (Contributed by NM, 24-Aug-2006.) (New usage is discouraged.)
theorem honegsubdi2 (T U: class):
  $ wi (wa (wf chba chba T) (wf chba chba U)) (wceq (co (cneg c1) (co T U chod) chot) (co U T chod)) $;

--| Law for double subtraction of Hilbert space operators. (Contributed by NM, 24-Aug-2006.) (New usage is discouraged.)
theorem hosubsub2 (S T U: class):
  $ wi (w3a (wf chba chba S) (wf chba chba T) (wf chba chba U)) (wceq (co S (co T U chod) chod) (co S (co U T chod) chos)) $;

--| Rearrangement of 4 terms in a mixed addition and subtraction of Hilbert space operators. (Contributed by NM, 24-Aug-2006.) (New usage is discouraged.)
theorem hosub4 (R S T U: class):
  $ wi (wa (wa (wf chba chba R) (wf chba chba S)) (wa (wf chba chba T) (wf chba chba U))) (wceq (co (co R S chos) (co T U chos) chod) (co (co R T chod) (co S U chod) chos)) $;

--| Rearrangement of 4 terms in a mixed addition and subtraction of Hilbert space operators. (Contributed by NM, 24-Aug-2006.) (New usage is discouraged.)
theorem hosubadd4 (R S T U: class):
  $ wi (wa (wa (wf chba chba R) (wf chba chba S)) (wa (wf chba chba T) (wf chba chba U))) (wceq (co (co R S chod) (co T U chod) chod) (co (co R U chos) (co S T chos) chod)) $;

--| Associative-type law for addition and subtraction of Hilbert space operators. (Contributed by NM, 25-Aug-2006.) (New usage is discouraged.)
theorem hoaddsubass (S T U: class):
  $ wi (w3a (wf chba chba S) (wf chba chba T) (wf chba chba U)) (wceq (co (co S T chos) U chod) (co S (co T U chod) chos)) $;

--| Law for operator addition and subtraction of Hilbert space operators. (Contributed by NM, 25-Aug-2006.) (New usage is discouraged.)
theorem hoaddsub (S T U: class):
  $ wi (w3a (wf chba chba S) (wf chba chba T) (wf chba chba U)) (wceq (co (co S T chos) U chod) (co (co S U chod) T chos)) $;

--| Law for double subtraction of Hilbert space operators. (Contributed by NM, 25-Aug-2006.) (New usage is discouraged.)
theorem hosubsub (S T U: class):
  $ wi (w3a (wf chba chba S) (wf chba chba T) (wf chba chba U)) (wceq (co S (co T U chod) chod) (co (co S T chod) U chos)) $;

--| Law for double subtraction of Hilbert space operators. (Contributed by NM, 25-Aug-2006.) (New usage is discouraged.)
theorem hosubsub4 (S T U: class):
  $ wi (w3a (wf chba chba S) (wf chba chba T) (wf chba chba U)) (wceq (co (co S T chod) U chod) (co S (co T U chos) chod)) $;

--| Two times a Hilbert space operator. (Contributed by NM, 26-Aug-2006.) (New usage is discouraged.)
theorem ho2times (T: class):
  $ wi (wf chba chba T) (wceq (co c2 T chot) (co T T chos)) $;

--| Associativity of sum and difference of Hilbert space operators. (Contributed by NM, 27-Aug-2004.) (New usage is discouraged.)
theorem hoaddsubassi (R S T: class):
  $ wf chba chba R $ >
  $ wf chba chba S $ >
  $ wf chba chba T $ >
  $ wceq (co (co R S chos) T chod) (co R (co S T chod) chos) $;

--| Law for sum and difference of Hilbert space operators. (Contributed by NM, 27-Aug-2004.) (New usage is discouraged.)
theorem hoaddsubi (R S T: class):
  $ wf chba chba R $ >
  $ wf chba chba S $ >
  $ wf chba chba T $ >
  $ wceq (co (co R S chos) T chod) (co (co R T chod) S chos) $;

--| Hilbert space operator sum expressed in terms of difference. (Contributed by NM, 27-Aug-2004.) (New usage is discouraged.)
theorem hosd1i (T U: class):
  $ wf chba chba T $ >
  $ wf chba chba U $ >
  $ wceq (co T U chos) (co T (co ch0o U chod) chod) $;

--| Hilbert space operator sum expressed in terms of difference. (Contributed by NM, 27-Aug-2004.) (New usage is discouraged.)
theorem hosd2i (T U: class):
  $ wf chba chba T $ >
  $ wf chba chba U $ >
  $ wceq (co T U chos) (co T (co (co U U chod) U chod) chod) $;

--| Hilbert space operator cancellation law. (Contributed by NM, 10-Mar-2006.) (New usage is discouraged.)
theorem hopncani (T U: class):
  $ wf chba chba T $ >
  $ wf chba chba U $ >
  $ wceq (co (co T U chos) U chod) T $;

--| Hilbert space operator cancellation law. (Contributed by NM, 11-Mar-2006.) (New usage is discouraged.)
theorem honpcani (T U: class):
  $ wf chba chba T $ >
  $ wf chba chba U $ >
  $ wceq (co (co T U chod) U chos) T $;

--| If the difference between two operators is zero, they are equal. (Contributed by NM, 27-Jul-2006.) (New usage is discouraged.)
theorem hosubeq0i (T U: class):
  $ wf chba chba T $ >
  $ wf chba chba U $ >
  $ wb (wceq (co T U chod) ch0o) (wceq T U) $;

--| Hilbert space operator cancellation law. (Contributed by NM, 11-Mar-2006.) (New usage is discouraged.)
theorem honpncani (R S T: class):
  $ wf chba chba R $ >
  $ wf chba chba S $ >
  $ wf chba chba T $ >
  $ wceq (co (co R S chod) (co S T chod) chos) (co R T chod) $;

--| A condition implying that a Hilbert space operator is identically zero. Lemma 3.2(S8) of [Beran] p. 95. (Contributed by NM, 28-Jan-2006.) (New usage is discouraged.)
theorem ho01i {x3 y1: setvar} (T: class):
  $ wf chba chba T $ >
  $ wb (wral x3 (wral y1 (wceq (co (cfv (cv x3) T) (cv y1) csp) cc0) chba) chba) (wceq T ch0o) $;

--| A condition implying that a Hilbert space operator is identically zero. Lemma 3.2(S10) of [Beran] p. 95. (Contributed by NM, 28-Jan-2006.) (New usage is discouraged.)
theorem ho02i {x3 y1: setvar} (T: class):
  $ wf chba chba T $ >
  $ wb (wral x3 (wral y1 (wceq (co (cv x3) (cfv (cv y1) T) csp) cc0) chba) chba) (wceq T ch0o) $;

--| A condition implying that two Hilbert space operators are equal. Lemma 3.2(S9) of [Beran] p. 95. (Contributed by NM, 15-Feb-2006.) (New usage is discouraged.)
theorem hoeq1 {x3 y1: setvar} (S T: class):
  $ wi (wa (wf chba chba S) (wf chba chba T)) (wb (wral x3 (wral y1 (wceq (co (cfv (cv x3) S) (cv y1) csp) (co (cfv (cv x3) T) (cv y1) csp)) chba) chba) (wceq S T)) $;

--| A condition implying that two Hilbert space operators are equal. Lemma 3.2(S11) of [Beran] p. 95. (Contributed by NM, 15-Feb-2006.) (New usage is discouraged.)
theorem hoeq2 {x3 y1: setvar} (S T: class):
  $ wi (wa (wf chba chba S) (wf chba chba T)) (wb (wral x3 (wral y1 (wceq (co (cv x3) (cfv (cv y1) S) csp) (co (cv x3) (cfv (cv y1) T) csp)) chba) chba) (wceq S T)) $;

--| Every Hilbert space operator has at most one adjoint. (Contributed by NM, 18-Feb-2006.) (New usage is discouraged.)
theorem adjmo {x3 y1 u: setvar} (T: class):
  $ wmo u (wa (wf chba chba (cv u)) (wral x3 (wral y1 (wceq (co (cv x3) (cfv (cv y1) T) csp) (co (cfv (cv x3) (cv u)) (cv y1) csp)) chba) chba)) $;

--| Symmetry property of an adjoint. (Contributed by NM, 18-Feb-2006.) (New usage is discouraged.)
theorem adjsym {x3 y1: setvar} (S T: class):
  $ wi (wa (wf chba chba S) (wf chba chba T)) (wb (wral x3 (wral y1 (wceq (co (cv x3) (cfv (cv y1) S) csp) (co (cfv (cv x3) T) (cv y1) csp)) chba) chba) (wral x3 (wral y1 (wceq (co (cv x3) (cfv (cv y1) T) csp) (co (cfv (cv x3) S) (cv y1) csp)) chba) chba)) $;

--| A necessary and sufficient condition (that holds when ` T ` is a Hermitian operator) for an eigenvalue ` B ` to be real. Generalization of Equation 1.30 of [Hughes] p. 49. (Contributed by NM, 21-Jan-2005.) (New usage is discouraged.)
theorem eigrei (A2 B2 T: class):
  $ wcel A2 chba $ >
  $ wcel B2 cc $ >
  $ wi (wa (wceq (cfv A2 T) (co B2 A2 csm)) (wne A2 c0v)) (wb (wceq (co A2 (cfv A2 T) csp) (co (cfv A2 T) A2 csp)) (wcel B2 cr)) $;

--| A necessary and sufficient condition (that holds when ` T ` is a Hermitian operator) for an eigenvalue ` B ` to be real. Generalization of Equation 1.30 of [Hughes] p. 49. (Contributed by NM, 19-Mar-2006.) (New usage is discouraged.)
theorem eigre (A2 B2 T: class):
  $ wi (wa (wa (wcel A2 chba) (wcel B2 cc)) (wa (wceq (cfv A2 T) (co B2 A2 csm)) (wne A2 c0v))) (wb (wceq (co A2 (cfv A2 T) csp) (co (cfv A2 T) A2 csp)) (wcel B2 cr)) $;

--| A sufficient condition (first conjunct pair, that holds when ` T ` is a positive operator) for an eigenvalue ` B ` (second conjunct pair) to be nonnegative. Remark (ii) in [Hughes] p. 137. (Contributed by NM, 2-Jul-2005.) (New usage is discouraged.)
theorem eigposi (A2 B2 T: class):
  $ wcel A2 chba $ >
  $ wcel B2 cc $ >
  $ wi (wa (wa (wcel (co A2 (cfv A2 T) csp) cr) (wbr cc0 (co A2 (cfv A2 T) csp) cle)) (wa (wceq (cfv A2 T) (co B2 A2 csm)) (wne A2 c0v))) (wa (wcel B2 cr) (wbr cc0 B2 cle)) $;

--| A necessary and sufficient condition (that holds when ` T ` is a Hermitian operator) for two eigenvectors ` A ` and ` B ` to be orthogonal. Generalization of Equation 1.31 of [Hughes] p. 49. (Contributed by NM, 23-Jan-2005.) (New usage is discouraged.)
theorem eigorthi (A2 B2 C D T: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wcel C cc $ >
  $ wcel D cc $ >
  $ wi (wa (wa (wceq (cfv A2 T) (co C A2 csm)) (wceq (cfv B2 T) (co D B2 csm))) (wne C (cfv D ccj))) (wb (wceq (co A2 (cfv B2 T) csp) (co (cfv A2 T) B2 csp)) (wceq (co A2 B2 csp) cc0)) $;

--| A necessary and sufficient condition (that holds when ` T ` is a Hermitian operator) for two eigenvectors ` A ` and ` B ` to be orthogonal. Generalization of Equation 1.31 of [Hughes] p. 49. (Contributed by NM, 23-Mar-2006.) (New usage is discouraged.)
theorem eigorth (A2 B2 C D T: class):
  $ wi (wa (wa (wa (wcel A2 chba) (wcel B2 chba)) (wa (wcel C cc) (wcel D cc))) (wa (wa (wceq (cfv A2 T) (co C A2 csm)) (wceq (cfv B2 T) (co D B2 csm))) (wne C (cfv D ccj)))) (wb (wceq (co A2 (cfv B2 T) csp) (co (cfv A2 T) B2 csp)) (wceq (co A2 B2 csp) cc0)) $;

--| Define the norm of a Hilbert space operator. (Contributed by NM, 18-Jan-2006.) (New usage is discouraged.)
axiom df_nmop {x3 z t: setvar}:
  $ wceq cnop (cmpt t (co chba chba cmap) (csup (cab x3 (wrex z (wa (wbr (cfv (cv z) cno) c1 cle) (wceq (cv x3) (cfv (cfv (cv z) (cv t)) cno))) chba)) cxr clt)) $;

--| Define the set of continuous operators on Hilbert space. For every "epsilon" ( ` y ` ) there is a "delta" ( ` z ` ) such that... (Contributed by NM, 28-Jan-2006.) (New usage is discouraged.)
axiom df_cnop {x3 y1 z w t: setvar}:
  $ wceq ccop (crab t (wral x3 (wral y1 (wrex z (wral w (wi (wbr (cfv (co (cv w) (cv x3) cmv) cno) (cv z) clt) (wbr (cfv (co (cfv (cv w) (cv t)) (cfv (cv x3) (cv t)) cmv) cno) (cv y1) clt)) chba) crp) crp) chba) (co chba chba cmap)) $;

--| Define the set of linear operators on Hilbert space. (See ~ df-hosum for definition of operator.) (Contributed by NM, 18-Jan-2006.) (New usage is discouraged.)
axiom df_lnop {x3 y1 z t: setvar}:
  $ wceq clo (crab t (wral x3 (wral y1 (wral z (wceq (cfv (co (co (cv x3) (cv y1) csm) (cv z) cva) (cv t)) (co (co (cv x3) (cfv (cv y1) (cv t)) csm) (cfv (cv z) (cv t)) cva)) chba) chba) cc) (co chba chba cmap)) $;

--| Define the set of bounded linear Hilbert space operators. (See ~ df-hosum for definition of operator.) (Contributed by NM, 18-Jan-2006.) (New usage is discouraged.)
axiom df_bdop {t: setvar}:
  $ wceq cbo (crab t (wbr (cfv (cv t) cnop) cpnf clt) clo) $;

--| Define the set of unitary operators on Hilbert space. (Contributed by NM, 18-Jan-2006.) (New usage is discouraged.)
axiom df_unop {x3 y1 t: setvar}:
  $ wceq cuo (cab t (wa (wfo chba chba (cv t)) (wral x3 (wral y1 (wceq (co (cfv (cv x3) (cv t)) (cfv (cv y1) (cv t)) csp) (co (cv x3) (cv y1) csp)) chba) chba))) $;

--| Define the set of Hermitian operators on Hilbert space. Some books call these "symmetric operators" and others call them "self-adjoint operators", sometimes with slightly different technical meanings. (Contributed by NM, 18-Jan-2006.) (New usage is discouraged.)
axiom df_hmop {x3 y1 t: setvar}:
  $ wceq cho (crab t (wral x3 (wral y1 (wceq (co (cv x3) (cfv (cv y1) (cv t)) csp) (co (cfv (cv x3) (cv t)) (cv y1) csp)) chba) chba) (co chba chba cmap)) $;

--| Define the norm of a Hilbert space functional. (Contributed by NM, 11-Feb-2006.) (New usage is discouraged.)
axiom df_nmfn {x3 z t: setvar}:
  $ wceq cnmf (cmpt t (co cc chba cmap) (csup (cab x3 (wrex z (wa (wbr (cfv (cv z) cno) c1 cle) (wceq (cv x3) (cfv (cfv (cv z) (cv t)) cabs))) chba)) cxr clt)) $;

--| Define the null space of a Hilbert space functional. (Contributed by NM, 11-Feb-2006.) (New usage is discouraged.)
axiom df_nlfn {t: setvar}:
  $ wceq cnl (cmpt t (co cc chba cmap) (cima (ccnv (cv t)) (csn cc0))) $;

--| Define the set of continuous functionals on Hilbert space. For every "epsilon" ( ` y ` ) there is a "delta" ( ` z ` ) such that... (Contributed by NM, 11-Feb-2006.) (New usage is discouraged.)
axiom df_cnfn {x3 y1 z w t: setvar}:
  $ wceq ccnfn (crab t (wral x3 (wral y1 (wrex z (wral w (wi (wbr (cfv (co (cv w) (cv x3) cmv) cno) (cv z) clt) (wbr (cfv (co (cfv (cv w) (cv t)) (cfv (cv x3) (cv t)) cmin) cabs) (cv y1) clt)) chba) crp) crp) chba) (co cc chba cmap)) $;

--| Define the set of linear functionals on Hilbert space. (Contributed by NM, 11-Feb-2006.) (New usage is discouraged.)
axiom df_lnfn {x3 y1 z t: setvar}:
  $ wceq clf (crab t (wral x3 (wral y1 (wral z (wceq (cfv (co (co (cv x3) (cv y1) csm) (cv z) cva) (cv t)) (co (co (cv x3) (cfv (cv y1) (cv t)) cmul) (cfv (cv z) (cv t)) caddc)) chba) chba) cc) (co cc chba cmap)) $;

--| Define the adjoint of a Hilbert space operator (if it exists). The domain of ` adjh ` is the set of all adjoint operators. Definition of adjoint in [Kalmbach2] p. 8. Unlike Kalmbach (and most authors), we do not demand that the operator be linear, but instead show (in ~ adjbdln ) that the adjoint exists for a bounded linear operator. (Contributed by NM, 20-Feb-2006.) (New usage is discouraged.)
axiom df_adjh {x3 y1 u t: setvar}:
  $ wceq cado (copab t u (w3a (wf chba chba (cv t)) (wf chba chba (cv u)) (wral x3 (wral y1 (wceq (co (cfv (cv x3) (cv t)) (cv y1) csp) (co (cv x3) (cfv (cv y1) (cv u)) csp)) chba) chba))) $;

--| Define the bra of a vector used by Dirac notation. Based on definition of bra in [Prugovecki] p. 186 (p. 180 in 1971 edition). In Dirac bra-ket notation, ` <. A | B >. ` is a complex number equal to the inner product ` ( B .ih A ) ` . But physicists like to talk about the individual components ` <. A | ` and ` | B >. ` , called bra and ket respectively. In order for their properties to make sense formally, we define the ket ` | B >. ` as the vector ` B ` itself, and the bra ` <. A | ` as a functional from ` ~H ` to ` CC ` . We represent the Dirac notation ` <. A | B >. ` by ` ( ( bra `` A ) `` B ) ` ; see ~ braval . The reversal of the inner product arguments not only makes the bra-ket behavior consistent with physics literature (see comments under ~ ax-his3 ) but is also required in order for the associative law ~ kbass2 to work. Our definition of bra and the associated outer product ~ df-kb differs from, but is equivalent to, a common approach in the literature that makes use of mappings to a dual space. Our approach eliminates the need to have a parallel development of this dual space and instead keeps everything in Hilbert space. _For an extensive discussion about how our notation maps to the bra-ket notation in physics textbooks, see ~ mmnotes.txt , under the 17-May-2006 entry_. (Contributed by NM, 15-May-2006.) (New usage is discouraged.)
axiom df_bra {x3 y1: setvar}:
  $ wceq cbr (cmpt x3 chba (cmpt y1 chba (co (cv y1) (cv x3) csp))) $;

--| Define a commuted bra and ket juxtaposition used by Dirac notation. In Dirac notation, ` | A >. <. B | ` is an operator known as the outer product of ` A ` and ` B ` , which we represent by ` ( A ketbra B ) ` . Based on Equation 8.1 of [Prugovecki] p. 376. This definition, combined with Definition ~ df-bra , allows any legal juxtaposition of bras and kets to make sense formally and also to obey the associative law when mapped back to Dirac notation. (Contributed by NM, 15-May-2006.) (New usage is discouraged.)
axiom df_kb {x3 y1 z: setvar}:
  $ wceq ck (cmpo x3 y1 chba chba (cmpt z chba (co (co (cv z) (cv y1) csp) (cv x3) csm))) $;

--| Define positive operator ordering. Definition VI.1 of [Retherford] p. 49. Note that ` ( ~H X. 0H ) <_op T ` means that ` T ` is a positive operator. (Contributed by NM, 23-Jul-2006.) (New usage is discouraged.)
axiom df_leop {x3 u t: setvar}:
  $ wceq cleo (copab t u (wa (wcel (co (cv u) (cv t) chod) cho) (wral x3 (wbr cc0 (co (cfv (cv x3) (co (cv u) (cv t) chod)) (cv x3) csp) cle) chba))) $;

--| Define the eigenvector function. Theorem ~ eleigveccl shows that ` eigvec `` T ` , the set of eigenvectors of Hilbert space operator ` T ` , are Hilbert space vectors. (Contributed by NM, 11-Mar-2006.) (New usage is discouraged.)
axiom df_eigvec {x3 z t: setvar}:
  $ wceq cei (cmpt t (co chba chba cmap) (crab x3 (wrex z (wceq (cfv (cv x3) (cv t)) (co (cv z) (cv x3) csm)) cc) (cdif chba c0h))) $;

--| Define the eigenvalue function. The range of ` eigval `` T ` is the set of eigenvalues of Hilbert space operator ` T ` . Theorem ~ eigvalcl shows that ` ( eigval `` T ) `` A ` , the eigenvalue associated with eigenvector ` A ` , is a complex number. (Contributed by NM, 11-Mar-2006.) (New usage is discouraged.)
axiom df_eigval {x3 t: setvar}:
  $ wceq cel (cmpt t (co chba chba cmap) (cmpt x3 (cfv (cv t) cei) (co (co (cfv (cv x3) (cv t)) (cv x3) csp) (co (cfv (cv x3) cno) c2 cexp) cdiv))) $;

--| Define the spectrum of an operator. Definition of spectrum in [Halmos] p. 50. (Contributed by NM, 11-Apr-2006.) (New usage is discouraged.)
axiom df_spec {x3 t: setvar}:
  $ wceq cspc (cmpt t (co chba chba cmap) (crab x3 (wn (wf1 chba chba (co (cv t) (co (cv x3) (cres cid chba) chot) chod))) cc)) $;

--| Value of the norm of a Hilbert space operator. (Contributed by NM, 18-Jan-2006.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem nmopval {x3 y1: setvar} (T: class):
  $ wi (wf chba chba T) (wceq (cfv T cnop) (csup (cab x3 (wrex y1 (wa (wbr (cfv (cv y1) cno) c1 cle) (wceq (cv x3) (cfv (cfv (cv y1) T) cno))) chba)) cxr clt)) $;

--| Property defining a continuous Hilbert space operator. (Contributed by NM, 28-Jan-2006.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem elcnop {x3 y1 z w: setvar} (T: class):
  $ wb (wcel T ccop) (wa (wf chba chba T) (wral x3 (wral y1 (wrex z (wral w (wi (wbr (cfv (co (cv w) (cv x3) cmv) cno) (cv z) clt) (wbr (cfv (co (cfv (cv w) T) (cfv (cv x3) T) cmv) cno) (cv y1) clt)) chba) crp) crp) chba)) $;

--| Property defining a linear Hilbert space operator. (Contributed by NM, 18-Jan-2006.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem ellnop {x3 y1 z: setvar} (T: class):
  $ wb (wcel T clo) (wa (wf chba chba T) (wral x3 (wral y1 (wral z (wceq (cfv (co (co (cv x3) (cv y1) csm) (cv z) cva) T) (co (co (cv x3) (cfv (cv y1) T) csm) (cfv (cv z) T) cva)) chba) chba) cc)) $;

--| A linear Hilbert space operator is a Hilbert space operator. (Contributed by NM, 18-Jan-2006.) (New usage is discouraged.)
theorem lnopf (T: class):
  $ wi (wcel T clo) (wf chba chba T) $;

--| Property defining a bounded linear Hilbert space operator. (Contributed by NM, 18-Jan-2006.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem elbdop (T: class):
  $ wb (wcel T cbo) (wa (wcel T clo) (wbr (cfv T cnop) cpnf clt)) $;

--| A bounded linear Hilbert space operator is a linear operator. (Contributed by NM, 18-Feb-2006.) (New usage is discouraged.)
theorem bdopln (T: class):
  $ wi (wcel T cbo) (wcel T clo) $;

--| A bounded linear Hilbert space operator is a Hilbert space operator. (Contributed by NM, 2-Feb-2006.) (New usage is discouraged.)
theorem bdopf (T: class):
  $ wi (wcel T cbo) (wf chba chba T) $;

--| The set in the supremum of the operator norm definition ~ df-nmop is a set of reals. (Contributed by NM, 2-Feb-2006.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem nmopsetretALT {x3 y1: setvar} (T: class):
  $ wi (wf chba chba T) (wss (cab x3 (wrex y1 (wa (wbr (cfv (cv y1) cno) c1 cle) (wceq (cv x3) (cfv (cfv (cv y1) T) cno))) chba)) cr) $;

--| The set in the supremum of the operator norm definition ~ df-nmop is a set of reals. (Contributed by NM, 2-Feb-2006.) (New usage is discouraged.)
theorem nmopsetretHIL {x3 y1: setvar} (T: class):
  $ wi (wf chba chba T) (wss (cab x3 (wrex y1 (wa (wbr (cfv (cv y1) cno) c1 cle) (wceq (cv x3) (cfv (cfv (cv y1) T) cno))) chba)) cr) $;

--| The set in the supremum of the operator norm definition ~ df-nmop is nonempty. (Contributed by NM, 9-Feb-2006.) (New usage is discouraged.)
theorem nmopsetn0 {x3 y1: setvar} (T: class):
  $ wcel (cfv (cfv c0v T) cno) (cab x3 (wrex y1 (wa (wbr (cfv (cv y1) cno) c1 cle) (wceq (cv x3) (cfv (cfv (cv y1) T) cno))) chba)) $;

--| The norm of a Hilbert space operator is an extended real. (Contributed by NM, 9-Feb-2006.) (New usage is discouraged.)
theorem nmopxr (T: class):
  $ wi (wf chba chba T) (wcel (cfv T cnop) cxr) $;

--| The norm of a Hilbert space operator is either real or plus infinity. (Contributed by NM, 5-Feb-2006.) (New usage is discouraged.)
theorem nmoprepnf (T: class):
  $ wi (wf chba chba T) (wb (wcel (cfv T cnop) cr) (wne (cfv T cnop) cpnf)) $;

--| The norm of a Hilbert space operator is not minus infinity. (Contributed by NM, 2-Feb-2006.) (New usage is discouraged.)
theorem nmopgtmnf (T: class):
  $ wi (wf chba chba T) (wbr cmnf (cfv T cnop) clt) $;

--| The norm of a Hilbert space operator is real iff it is less than infinity. (Contributed by NM, 14-Feb-2006.) (New usage is discouraged.)
theorem nmopreltpnf (T: class):
  $ wi (wf chba chba T) (wb (wcel (cfv T cnop) cr) (wbr (cfv T cnop) cpnf clt)) $;

--| The norm of a bounded operator is a real number. (Contributed by NM, 29-Jan-2006.) (New usage is discouraged.)
theorem nmopre (T: class):
  $ wi (wcel T cbo) (wcel (cfv T cnop) cr) $;

--| Property defining a bounded linear Hilbert space operator. (Contributed by NM, 14-Feb-2006.) (New usage is discouraged.)
theorem elbdop2 (T: class):
  $ wb (wcel T cbo) (wa (wcel T clo) (wcel (cfv T cnop) cr)) $;

--| Property defining a unitary Hilbert space operator. (Contributed by NM, 18-Jan-2006.) (New usage is discouraged.)
theorem elunop {x3 y1: setvar} (T: class):
  $ wb (wcel T cuo) (wa (wfo chba chba T) (wral x3 (wral y1 (wceq (co (cfv (cv x3) T) (cfv (cv y1) T) csp) (co (cv x3) (cv y1) csp)) chba) chba)) $;

--| Property defining a Hermitian Hilbert space operator. (Contributed by NM, 18-Jan-2006.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem elhmop {x3 y1: setvar} (T: class):
  $ wb (wcel T cho) (wa (wf chba chba T) (wral x3 (wral y1 (wceq (co (cv x3) (cfv (cv y1) T) csp) (co (cfv (cv x3) T) (cv y1) csp)) chba) chba)) $;

--| A Hermitian operator is a Hilbert space operator (mapping). (Contributed by NM, 19-Mar-2006.) (New usage is discouraged.)
theorem hmopf (T: class):
  $ wi (wcel T cho) (wf chba chba T) $;

--| The class of Hermitian operators is a set. (Contributed by NM, 17-Aug-2006.) (New usage is discouraged.)
theorem hmopex:
  $ wcel cho cvv $;

--| Value of the norm of a Hilbert space functional. (Contributed by NM, 11-Feb-2006.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem nmfnval {x3 y1: setvar} (T: class):
  $ wi (wf chba cc T) (wceq (cfv T cnmf) (csup (cab x3 (wrex y1 (wa (wbr (cfv (cv y1) cno) c1 cle) (wceq (cv x3) (cfv (cfv (cv y1) T) cabs))) chba)) cxr clt)) $;

--| The set in the supremum of the functional norm definition ~ df-nmfn is a set of reals. (Contributed by NM, 14-Feb-2006.) (New usage is discouraged.)
theorem nmfnsetre {x3 y1: setvar} (T: class):
  $ wi (wf chba cc T) (wss (cab x3 (wrex y1 (wa (wbr (cfv (cv y1) cno) c1 cle) (wceq (cv x3) (cfv (cfv (cv y1) T) cabs))) chba)) cr) $;

--| The set in the supremum of the functional norm definition ~ df-nmfn is nonempty. (Contributed by NM, 14-Feb-2006.) (New usage is discouraged.)
theorem nmfnsetn0 {x3 y1: setvar} (T: class):
  $ wcel (cfv (cfv c0v T) cabs) (cab x3 (wrex y1 (wa (wbr (cfv (cv y1) cno) c1 cle) (wceq (cv x3) (cfv (cfv (cv y1) T) cabs))) chba)) $;

--| The norm of any Hilbert space functional is an extended real. (Contributed by NM, 9-Feb-2006.) (New usage is discouraged.)
theorem nmfnxr (T: class):
  $ wi (wf chba cc T) (wcel (cfv T cnmf) cxr) $;

--| The norm of a Hilbert space functional is either real or plus infinity. (Contributed by NM, 8-Dec-2007.) (New usage is discouraged.)
theorem nmfnrepnf (T: class):
  $ wi (wf chba cc T) (wb (wcel (cfv T cnmf) cr) (wne (cfv T cnmf) cpnf)) $;

--| Value of the null space of a Hilbert space functional. (Contributed by NM, 11-Feb-2006.) (New usage is discouraged.)
theorem nlfnval (T: class):
  $ wi (wf chba cc T) (wceq (cfv T cnl) (cima (ccnv T) (csn cc0))) $;

--| Property defining a continuous functional. (Contributed by NM, 11-Feb-2006.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem elcnfn {x3 y1 z w: setvar} (T: class):
  $ wb (wcel T ccnfn) (wa (wf chba cc T) (wral x3 (wral y1 (wrex z (wral w (wi (wbr (cfv (co (cv w) (cv x3) cmv) cno) (cv z) clt) (wbr (cfv (co (cfv (cv w) T) (cfv (cv x3) T) cmin) cabs) (cv y1) clt)) chba) crp) crp) chba)) $;

--| Property defining a linear functional. (Contributed by NM, 11-Feb-2006.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem ellnfn {x3 y1 z: setvar} (T: class):
  $ wb (wcel T clf) (wa (wf chba cc T) (wral x3 (wral y1 (wral z (wceq (cfv (co (co (cv x3) (cv y1) csm) (cv z) cva) T) (co (co (cv x3) (cfv (cv y1) T) cmul) (cfv (cv z) T) caddc)) chba) chba) cc)) $;

--| A linear Hilbert space functional is a functional. (Contributed by NM, 25-Apr-2006.) (New usage is discouraged.)
theorem lnfnf (T: class):
  $ wi (wcel T clf) (wf chba cc T) $;

--| Alternate definition of the adjoint of a Hilbert space operator. (Contributed by NM, 20-Feb-2006.) (New usage is discouraged.)
theorem dfadj2 {x3 y1 u t: setvar}:
  $ wceq cado (copab t u (w3a (wf chba chba (cv t)) (wf chba chba (cv u)) (wral x3 (wral y1 (wceq (co (cv x3) (cfv (cv y1) (cv t)) csp) (co (cfv (cv x3) (cv u)) (cv y1) csp)) chba) chba))) $;

--| Functionality of the adjoint function. (Contributed by NM, 15-Feb-2006.) (New usage is discouraged.)
theorem funadj:
  $ wfun cado $;

--| The domain of the adjoint function is a subset of the maps from ` ~H ` to ` ~H ` . (Contributed by NM, 15-Feb-2006.) (New usage is discouraged.)
theorem dmadjss:
  $ wss (cdm cado) (co chba chba cmap) $;

--| A member of the domain of the adjoint function is a Hilbert space operator. (Contributed by NM, 15-Feb-2006.) (New usage is discouraged.)
theorem dmadjop (T: class):
  $ wi (wcel T (cdm cado)) (wf chba chba T) $;

--| Elementhood in the domain of the adjoint function. (Contributed by Mario Carneiro, 11-Sep-2015.) (Revised by Mario Carneiro, 24-Dec-2016.) (New usage is discouraged.)
theorem adjeu {x3 y1 u: setvar} (T: class):
  $ wi (wf chba chba T) (wb (wcel T (cdm cado)) (wreu u (wral x3 (wral y1 (wceq (co (cv x3) (cfv (cv y1) T) csp) (co (cfv (cv x3) (cv u)) (cv y1) csp)) chba) chba) (co chba chba cmap))) $;

--| Value of the adjoint function for ` T ` in the domain of ` adjh ` . (Contributed by NM, 19-Feb-2006.) (Revised by Mario Carneiro, 24-Dec-2016.) (New usage is discouraged.)
theorem adjval {x3 y1 u: setvar} (T: class):
  $ wi (wcel T (cdm cado)) (wceq (cfv T cado) (crio u (wral x3 (wral y1 (wceq (co (cv x3) (cfv (cv y1) T) csp) (co (cfv (cv x3) (cv u)) (cv y1) csp)) chba) chba) (co chba chba cmap))) $;

--| Value of the adjoint function. (Contributed by NM, 19-Feb-2006.) (New usage is discouraged.)
theorem adjval2 {x3 y1 u: setvar} (T: class):
  $ wi (wcel T (cdm cado)) (wceq (cfv T cado) (crio u (wral x3 (wral y1 (wceq (co (cfv (cv x3) T) (cv y1) csp) (co (cv x3) (cfv (cv y1) (cv u)) csp)) chba) chba) (co chba chba cmap))) $;

--| The adjoint function equals its converse. (Contributed by NM, 15-Feb-2006.) (New usage is discouraged.)
theorem cnvadj:
  $ wceq (ccnv cado) cado $;

--| The converse of the adjoint function is a function. (Contributed by NM, 25-Jan-2006.) (New usage is discouraged.)
theorem funcnvadj:
  $ wfun (ccnv cado) $;

--| The adjoint function maps one-to-one onto its domain. (Contributed by NM, 15-Feb-2006.) (New usage is discouraged.)
theorem adj1o:
  $ wf1o (cdm cado) (cdm cado) cado $;

--| The adjoint of an operator belongs to the adjoint function's domain. (Contributed by NM, 15-Feb-2006.) (New usage is discouraged.)
theorem dmadjrn (T: class):
  $ wi (wcel T (cdm cado)) (wcel (cfv T cado) (cdm cado)) $;

--| The set of eigenvectors of a Hilbert space operator. (Contributed by NM, 11-Mar-2006.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem eigvecval {x3 y1: setvar} (T: class):
  $ wi (wf chba chba T) (wceq (cfv T cei) (crab x3 (wrex y1 (wceq (cfv (cv x3) T) (co (cv y1) (cv x3) csm)) cc) (cdif chba c0h))) $;

--| The eigenvalues of eigenvectors of a Hilbert space operator. (Contributed by NM, 11-Mar-2006.) (New usage is discouraged.)
theorem eigvalfval {x3: setvar} (T: class):
  $ wi (wf chba chba T) (wceq (cfv T cel) (cmpt x3 (cfv T cei) (co (co (cfv (cv x3) T) (cv x3) csp) (co (cfv (cv x3) cno) c2 cexp) cdiv))) $;

--| The value of the spectrum of an operator. (Contributed by NM, 11-Apr-2006.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem specval {x3: setvar} (T: class):
  $ wi (wf chba chba T) (wceq (cfv T cspc) (crab x3 (wn (wf1 chba chba (co T (co (cv x3) (cres cid chba) chot) chod))) cc)) $;

--| The spectrum of an operator is a set of complex numbers. (Contributed by NM, 11-Apr-2006.) (New usage is discouraged.)
theorem speccl (T: class):
  $ wi (wf chba chba T) (wss (cfv T cspc) cc) $;

--| The linear operators of Hilbert space. (Contributed by NM, 19-Nov-2007.) (Revised by Mario Carneiro, 19-Nov-2013.) (New usage is discouraged.)
theorem hhlnoi (U L: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wceq L (co U U clno) $ >
  $ wceq clo L $;

--| The norm of an operator in Hilbert space. (Contributed by NM, 19-Nov-2007.) (Revised by Mario Carneiro, 17-Nov-2013.) (New usage is discouraged.)
theorem hhnmoi (U N: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wceq N (co U U cnmoo) $ >
  $ wceq cnop N $;

--| A bounded linear operator in Hilbert space. (Contributed by NM, 19-Nov-2007.) (Revised by Mario Carneiro, 19-Nov-2013.) (New usage is discouraged.)
theorem hhbloi (B2 U: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wceq B2 (co U U cblo) $ >
  $ wceq cbo B2 $;

--| The zero operator in Hilbert space. (Contributed by NM, 7-Dec-2007.) (New usage is discouraged.)
theorem hh0oi (U Z: class):
  $ wceq U (cop (cop cva csm) cno) $ >
  $ wceq Z (co U U c0o) $ >
  $ wceq ch0o Z $;

--| The continuous operators of Hilbert space. (Contributed by Mario Carneiro, 19-May-2014.) (New usage is discouraged.)
theorem hhcno (D J: class):
  $ wceq D (ccom cno cmv) $ >
  $ wceq J (cfv D cmopn) $ >
  $ wceq ccop (co J J ccn) $;

--| The continuous functionals of Hilbert space. (Contributed by Mario Carneiro, 19-May-2014.) (New usage is discouraged.)
theorem hhcnf (D J K: class):
  $ wceq D (ccom cno cmv) $ >
  $ wceq J (cfv D cmopn) $ >
  $ wceq K (cfv ccnfld ctopn) $ >
  $ wceq ccnfn (co J K ccn) $;

--| The adjoint of an operator belongs to the adjoint function's domain. (Note: the converse is dependent on our definition of function value, since it uses ~ ndmfv .) (Contributed by NM, 19-Feb-2006.) (New usage is discouraged.)
theorem dmadjrnb (T: class):
  $ wb (wcel T (cdm cado)) (wcel (cfv T cado) (cdm cado)) $;

--| A lower bound for an operator norm. (Contributed by NM, 7-Feb-2006.) (New usage is discouraged.)
theorem nmoplb (A2 T: class):
  $ wi (w3a (wf chba chba T) (wcel A2 chba) (wbr (cfv A2 cno) c1 cle)) (wbr (cfv (cfv A2 T) cno) (cfv T cnop) cle) $;

--| An upper bound for an operator norm. (Contributed by NM, 7-Mar-2006.) (New usage is discouraged.)
theorem nmopub {x3: setvar} (A2 T: class):
  $ wi (wa (wf chba chba T) (wcel A2 cxr)) (wb (wbr (cfv T cnop) A2 cle) (wral x3 (wi (wbr (cfv (cv x3) cno) c1 cle) (wbr (cfv (cfv (cv x3) T) cno) A2 cle)) chba)) $;

--| An upper bound for an operator norm. (Contributed by NM, 12-Apr-2006.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem nmopub2tALT {x3: setvar} (A2 T: class):
  $ wi (w3a (wf chba chba T) (wa (wcel A2 cr) (wbr cc0 A2 cle)) (wral x3 (wbr (cfv (cfv (cv x3) T) cno) (co A2 (cfv (cv x3) cno) cmul) cle) chba)) (wbr (cfv T cnop) A2 cle) $;

--| An upper bound for an operator norm. (Contributed by NM, 13-Dec-2007.) (New usage is discouraged.)
theorem nmopub2tHIL {x3: setvar} (A2 T: class):
  $ wi (w3a (wf chba chba T) (wa (wcel A2 cr) (wbr cc0 A2 cle)) (wral x3 (wbr (cfv (cfv (cv x3) T) cno) (co A2 (cfv (cv x3) cno) cmul) cle) chba)) (wbr (cfv T cnop) A2 cle) $;

--| The norm of any Hilbert space operator is nonnegative. (Contributed by NM, 9-Feb-2006.) (New usage is discouraged.)
theorem nmopge0 (T: class):
  $ wi (wf chba chba T) (wbr cc0 (cfv T cnop) cle) $;

--| A linear Hilbert space operator that is not identically zero has a positive norm. (Contributed by NM, 9-Feb-2006.) (New usage is discouraged.)
theorem nmopgt0 (T: class):
  $ wi (wf chba chba T) (wb (wne (cfv T cnop) cc0) (wbr cc0 (cfv T cnop) clt)) $;

--| Basic continuity property of a continuous Hilbert space operator. (Contributed by NM, 2-Feb-2006.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem cnopc {x3 y1: setvar} (A2 B2 T: class):
  $ wi (w3a (wcel T ccop) (wcel A2 chba) (wcel B2 crp)) (wrex x3 (wral y1 (wi (wbr (cfv (co (cv y1) A2 cmv) cno) (cv x3) clt) (wbr (cfv (co (cfv (cv y1) T) (cfv A2 T) cmv) cno) B2 clt)) chba) crp) $;

--| Basic linearity property of a linear Hilbert space operator. (Contributed by NM, 22-Jan-2006.) (New usage is discouraged.)
theorem lnopl (A2 B2 C T: class):
  $ wi (wa (wa (wcel T clo) (wcel A2 cc)) (wa (wcel B2 chba) (wcel C chba))) (wceq (cfv (co (co A2 B2 csm) C cva) T) (co (co A2 (cfv B2 T) csm) (cfv C T) cva)) $;

--| Basic inner product property of a unitary operator. (Contributed by NM, 22-Jan-2006.) (New usage is discouraged.)
theorem unop (A2 B2 T: class):
  $ wi (w3a (wcel T cuo) (wcel A2 chba) (wcel B2 chba)) (wceq (co (cfv A2 T) (cfv B2 T) csp) (co A2 B2 csp)) $;

--| A unitary operator in Hilbert space is one-to-one and onto. (Contributed by NM, 22-Jan-2006.) (New usage is discouraged.)
theorem unopf1o (T: class):
  $ wi (wcel T cuo) (wf1o chba chba T) $;

--| A unitary operator is idempotent in the norm. (Contributed by NM, 25-Feb-2006.) (New usage is discouraged.)
theorem unopnorm (A2 T: class):
  $ wi (wa (wcel T cuo) (wcel A2 chba)) (wceq (cfv (cfv A2 T) cno) (cfv A2 cno)) $;

--| The inverse (converse) of a unitary operator in Hilbert space is unitary. Theorem in [AkhiezerGlazman] p. 72. (Contributed by NM, 22-Jan-2006.) (New usage is discouraged.)
theorem cnvunop (T: class):
  $ wi (wcel T cuo) (wcel (ccnv T) cuo) $;

--| The inverse (converse) of a unitary operator is its adjoint. Equation 2 of [AkhiezerGlazman] p. 72. (Contributed by NM, 22-Jan-2006.) (New usage is discouraged.)
theorem unopadj (A2 B2 T: class):
  $ wi (w3a (wcel T cuo) (wcel A2 chba) (wcel B2 chba)) (wceq (co (cfv A2 T) B2 csp) (co A2 (cfv B2 (ccnv T)) csp)) $;

--| A unitary operator is linear. Theorem in [AkhiezerGlazman] p. 72. (Contributed by NM, 22-Jan-2006.) (New usage is discouraged.)
theorem unoplin (T: class):
  $ wi (wcel T cuo) (wcel T clo) $;

--| The composition of two unitary operators is unitary. (Contributed by NM, 22-Jan-2006.) (New usage is discouraged.)
theorem counop (S T: class):
  $ wi (wa (wcel S cuo) (wcel T cuo)) (wcel (ccom S T) cuo) $;

--| Basic inner product property of a Hermitian operator. (Contributed by NM, 19-Mar-2006.) (New usage is discouraged.)
theorem hmop (A2 B2 T: class):
  $ wi (w3a (wcel T cho) (wcel A2 chba) (wcel B2 chba)) (wceq (co A2 (cfv B2 T) csp) (co (cfv A2 T) B2 csp)) $;

--| The inner product of the value and argument of a Hermitian operator is real. (Contributed by NM, 23-Jul-2006.) (New usage is discouraged.)
theorem hmopre (A2 T: class):
  $ wi (wa (wcel T cho) (wcel A2 chba)) (wcel (co (cfv A2 T) A2 csp) cr) $;

--| A lower bound for a functional norm. (Contributed by NM, 14-Feb-2006.) (New usage is discouraged.)
theorem nmfnlb (A2 T: class):
  $ wi (w3a (wf chba cc T) (wcel A2 chba) (wbr (cfv A2 cno) c1 cle)) (wbr (cfv (cfv A2 T) cabs) (cfv T cnmf) cle) $;

--| An upper bound for the norm of a functional. (Contributed by NM, 24-May-2006.) (Revised by Mario Carneiro, 7-Sep-2014.) (New usage is discouraged.)
theorem nmfnleub {x3: setvar} (A2 T: class):
  $ wi (wa (wf chba cc T) (wcel A2 cxr)) (wb (wbr (cfv T cnmf) A2 cle) (wral x3 (wi (wbr (cfv (cv x3) cno) c1 cle) (wbr (cfv (cfv (cv x3) T) cabs) A2 cle)) chba)) $;

--| An upper bound for the norm of a functional. (Contributed by NM, 24-May-2006.) (New usage is discouraged.)
theorem nmfnleub2 {x3: setvar} (A2 T: class):
  $ wi (w3a (wf chba cc T) (wa (wcel A2 cr) (wbr cc0 A2 cle)) (wral x3 (wbr (cfv (cfv (cv x3) T) cabs) (co A2 (cfv (cv x3) cno) cmul) cle) chba)) (wbr (cfv T cnmf) A2 cle) $;

--| The norm of any Hilbert space functional is nonnegative. (Contributed by NM, 24-May-2006.) (New usage is discouraged.)
theorem nmfnge0 (T: class):
  $ wi (wf chba cc T) (wbr cc0 (cfv T cnmf) cle) $;

--| Membership in the null space of a Hilbert space functional. (Contributed by NM, 11-Feb-2006.) (Revised by Mario Carneiro, 17-Nov-2013.) (New usage is discouraged.)
theorem elnlfn (A2 T: class):
  $ wi (wf chba cc T) (wb (wcel A2 (cfv T cnl)) (wa (wcel A2 chba) (wceq (cfv A2 T) cc0))) $;

--| Membership in the null space of a Hilbert space functional. (Contributed by NM, 11-Feb-2006.) (Revised by Mario Carneiro, 17-Nov-2013.) (New usage is discouraged.)
theorem elnlfn2 (A2 T: class):
  $ wi (wa (wf chba cc T) (wcel A2 (cfv T cnl))) (wceq (cfv A2 T) cc0) $;

--| Basic continuity property of a continuous functional. (Contributed by NM, 11-Feb-2006.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem cnfnc {x3 y1: setvar} (A2 B2 T: class):
  $ wi (w3a (wcel T ccnfn) (wcel A2 chba) (wcel B2 crp)) (wrex x3 (wral y1 (wi (wbr (cfv (co (cv y1) A2 cmv) cno) (cv x3) clt) (wbr (cfv (co (cfv (cv y1) T) (cfv A2 T) cmin) cabs) B2 clt)) chba) crp) $;

--| Basic linearity property of a linear functional. (Contributed by NM, 11-Feb-2006.) (New usage is discouraged.)
theorem lnfnl (A2 B2 C T: class):
  $ wi (wa (wa (wcel T clf) (wcel A2 cc)) (wa (wcel B2 chba) (wcel C chba))) (wceq (cfv (co (co A2 B2 csm) C cva) T) (co (co A2 (cfv B2 T) cmul) (cfv C T) caddc)) $;

--| Closure of the adjoint of a Hilbert space operator. (Contributed by NM, 17-Jun-2006.) (New usage is discouraged.)
theorem adjcl (A2 T: class):
  $ wi (wa (wcel T (cdm cado)) (wcel A2 chba)) (wcel (cfv A2 (cfv T cado)) chba) $;

--| Property of an adjoint Hilbert space operator. (Contributed by NM, 15-Feb-2006.) (New usage is discouraged.)
theorem adj1 (A2 B2 T: class):
  $ wi (w3a (wcel T (cdm cado)) (wcel A2 chba) (wcel B2 chba)) (wceq (co A2 (cfv B2 T) csp) (co (cfv A2 (cfv T cado)) B2 csp)) $;

--| Property of an adjoint Hilbert space operator. (Contributed by NM, 15-Feb-2006.) (New usage is discouraged.)
theorem adj2 (A2 B2 T: class):
  $ wi (w3a (wcel T (cdm cado)) (wcel A2 chba) (wcel B2 chba)) (wceq (co (cfv A2 T) B2 csp) (co A2 (cfv B2 (cfv T cado)) csp)) $;

--| A property that determines the adjoint of a Hilbert space operator. (Contributed by NM, 20-Feb-2006.) (New usage is discouraged.)
theorem adjeq {x3 y1: setvar} (S T: class):
  $ wi (w3a (wf chba chba T) (wf chba chba S) (wral x3 (wral y1 (wceq (co (cfv (cv x3) T) (cv y1) csp) (co (cv x3) (cfv (cv y1) S) csp)) chba) chba)) (wceq (cfv T cado) S) $;

--| Double adjoint. Theorem 3.11(iv) of [Beran] p. 106. (Contributed by NM, 15-Feb-2006.) (New usage is discouraged.)
theorem adjadj (T: class):
  $ wi (wcel T (cdm cado)) (wceq (cfv (cfv T cado) cado) T) $;

--| Value of the value of the adjoint function. (Contributed by NM, 22-Feb-2006.) (Proof shortened by Mario Carneiro, 10-Sep-2015.) (New usage is discouraged.)
theorem adjvalval {x3 w: setvar} (A2 T: class):
  $ wi (wa (wcel T (cdm cado)) (wcel A2 chba)) (wceq (cfv A2 (cfv T cado)) (crio w (wral x3 (wceq (co (cfv (cv x3) T) A2 csp) (co (cv x3) (cv w) csp)) chba) chba)) $;

--| The adjoint of a unitary operator is its inverse (converse). Equation 2 of [AkhiezerGlazman] p. 72. (Contributed by NM, 23-Feb-2006.) (New usage is discouraged.)
theorem unopadj2 (T: class):
  $ wi (wcel T cuo) (wceq (cfv T cado) (ccnv T)) $;

--| A Hermitian operator is self-adjoint. (Contributed by NM, 24-Mar-2006.) (New usage is discouraged.)
theorem hmopadj (T: class):
  $ wi (wcel T cho) (wceq (cfv T cado) T) $;

--| Every Hermitian operator has an adjoint. (Contributed by NM, 24-Mar-2006.) (New usage is discouraged.)
theorem hmdmadj (T: class):
  $ wi (wcel T cho) (wcel T (cdm cado)) $;

--| An operator is Hermitian iff it is self-adjoint. Definition of Hermitian in [Halmos] p. 41. (Contributed by NM, 9-Apr-2006.) (New usage is discouraged.)
theorem hmopadj2 (T: class):
  $ wi (wcel T (cdm cado)) (wb (wcel T cho) (wceq (cfv T cado) T)) $;

--| A Hermitian operator is linear. (Contributed by NM, 24-Mar-2006.) (New usage is discouraged.)
theorem hmoplin (T: class):
  $ wi (wcel T cho) (wcel T clo) $;

--| The bra of a vector, expressed as ` <. A | ` in Dirac notation. See ~ df-bra . (Contributed by NM, 15-May-2006.) (Revised by Mario Carneiro, 23-Aug-2014.) (New usage is discouraged.)
theorem brafval {x3: setvar} (A2: class):
  $ wi (wcel A2 chba) (wceq (cfv A2 cbr) (cmpt x3 chba (co (cv x3) A2 csp))) $;

--| A bra-ket juxtaposition, expressed as ` <. A | B >. ` in Dirac notation, equals the inner product of the vectors. Based on definition of bra in [Prugovecki] p. 186. (Contributed by NM, 15-May-2006.) (Revised by Mario Carneiro, 17-Nov-2013.) (New usage is discouraged.)
theorem braval (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wceq (cfv B2 (cfv A2 cbr)) (co B2 A2 csp)) $;

--| Linearity property of bra for addition. (Contributed by NM, 23-May-2006.) (New usage is discouraged.)
theorem braadd (A2 B2 C: class):
  $ wi (w3a (wcel A2 chba) (wcel B2 chba) (wcel C chba)) (wceq (cfv (co B2 C cva) (cfv A2 cbr)) (co (cfv B2 (cfv A2 cbr)) (cfv C (cfv A2 cbr)) caddc)) $;

--| Linearity property of bra for multiplication. (Contributed by NM, 23-May-2006.) (New usage is discouraged.)
theorem bramul (A2 B2 C: class):
  $ wi (w3a (wcel A2 chba) (wcel B2 cc) (wcel C chba)) (wceq (cfv (co B2 C csm) (cfv A2 cbr)) (co B2 (cfv C (cfv A2 cbr)) cmul)) $;

--| The bra function is a functional. (Contributed by NM, 23-May-2006.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem brafn (A2: class):
  $ wi (wcel A2 chba) (wf chba cc (cfv A2 cbr)) $;

--| The Dirac bra function is a linear functional. (Contributed by NM, 23-May-2006.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem bralnfn (A2: class):
  $ wi (wcel A2 chba) (wcel (cfv A2 cbr) clf) $;

--| Closure of the bra function. (Contributed by NM, 23-May-2006.) (New usage is discouraged.)
theorem bracl (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wcel (cfv B2 (cfv A2 cbr)) cc) $;

--| The Dirac bra of the zero vector. (Contributed by NM, 25-May-2006.) (Revised by Mario Carneiro, 23-Aug-2014.) (New usage is discouraged.)
theorem bra0:
  $ wceq (cfv c0v cbr) (cxp chba (csn cc0)) $;

--| Anti-linearity property of bra functional for multiplication. (Contributed by NM, 31-May-2006.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem brafnmul (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 chba)) (wceq (cfv (co A2 B2 csm) cbr) (co (cfv A2 ccj) (cfv B2 cbr) chft)) $;

--| The outer product of two vectors, expressed as ` | A >. <. B | ` in Dirac notation. See ~ df-kb . (Contributed by NM, 15-May-2006.) (Revised by Mario Carneiro, 23-Aug-2014.) (New usage is discouraged.)
theorem kbfval {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wceq (co A2 B2 ck) (cmpt x3 chba (co (co (cv x3) B2 csp) A2 csm))) $;

--| The outer product of two vectors, expressed as ` | A >. <. B | ` in Dirac notation, is an operator. (Contributed by NM, 30-May-2006.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem kbop (A2 B2: class):
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wf chba chba (co A2 B2 ck)) $;

--| The value of the operator resulting from the outer product ` | A >. ` ` <. B | ` of two vectors. Equation 8.1 of [Prugovecki] p. 376. (Contributed by NM, 15-May-2006.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem kbval (A2 B2 C: class):
  $ wi (w3a (wcel A2 chba) (wcel B2 chba) (wcel C chba)) (wceq (cfv C (co A2 B2 ck)) (co (co C B2 csp) A2 csm)) $;

--| Multiplication property of outer product. (Contributed by NM, 31-May-2006.) (New usage is discouraged.)
theorem kbmul (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 chba) (wcel C chba)) (wceq (co (co A2 B2 csm) C ck) (co B2 (co (cfv A2 ccj) C csm) ck)) $;

--| If a vector ` A ` has norm 1, the outer product ` | A >. <. A | ` is the projector onto the subspace spanned by ` A ` . ~ http://en.wikipedia.org/wiki/Bra-ket#Linear%5Foperators . (Contributed by NM, 30-May-2006.) (New usage is discouraged.)
theorem kbpj (A2: class):
  $ wi (wa (wcel A2 chba) (wceq (cfv A2 cno) c1)) (wceq (co A2 A2 ck) (cfv (cfv (csn A2) cspn) cpjh)) $;

--| Membership in the set of eigenvectors of a Hilbert space operator. (Contributed by NM, 11-Mar-2006.) (Revised by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem eleigvec {x3: setvar} (A2 T: class):
  $ wi (wf chba chba T) (wb (wcel A2 (cfv T cei)) (w3a (wcel A2 chba) (wne A2 c0v) (wrex x3 (wceq (cfv A2 T) (co (cv x3) A2 csm)) cc))) $;

--| Membership in the set of eigenvectors of a Hilbert space operator. (Contributed by NM, 18-Mar-2006.) (New usage is discouraged.)
theorem eleigvec2 (A2 T: class):
  $ wi (wf chba chba T) (wb (wcel A2 (cfv T cei)) (w3a (wcel A2 chba) (wne A2 c0v) (wcel (cfv A2 T) (cfv (csn A2) cspn)))) $;

--| Closure of an eigenvector of a Hilbert space operator. (Contributed by NM, 23-Mar-2006.) (New usage is discouraged.)
theorem eleigveccl (A2 T: class):
  $ wi (wa (wf chba chba T) (wcel A2 (cfv T cei))) (wcel A2 chba) $;

--| The eigenvalue of an eigenvector of a Hilbert space operator. (Contributed by NM, 11-Mar-2006.) (New usage is discouraged.)
theorem eigvalval (A2 T: class):
  $ wi (wa (wf chba chba T) (wcel A2 (cfv T cei))) (wceq (cfv A2 (cfv T cel)) (co (co (cfv A2 T) A2 csp) (co (cfv A2 cno) c2 cexp) cdiv)) $;

--| An eigenvalue is a complex number. (Contributed by NM, 11-Mar-2006.) (New usage is discouraged.)
theorem eigvalcl (A2 T: class):
  $ wi (wa (wf chba chba T) (wcel A2 (cfv T cei))) (wcel (cfv A2 (cfv T cel)) cc) $;

--| Property of an eigenvector. (Contributed by NM, 12-Mar-2006.) (New usage is discouraged.)
theorem eigvec1 (A2 T: class):
  $ wi (wa (wf chba chba T) (wcel A2 (cfv T cei))) (wa (wceq (cfv A2 T) (co (cfv A2 (cfv T cel)) A2 csm)) (wne A2 c0v)) $;

--| The eigenvalues of a Hermitian operator are real. Equation 1.30 of [Hughes] p. 49. (Contributed by NM, 19-Mar-2006.) (New usage is discouraged.)
theorem eighmre (A2 T: class):
  $ wi (wa (wcel T cho) (wcel A2 (cfv T cei))) (wcel (cfv A2 (cfv T cel)) cr) $;

--| Eigenvectors of a Hermitian operator with distinct eigenvalues are orthogonal. Equation 1.31 of [Hughes] p. 49. (Contributed by NM, 23-Mar-2006.) (New usage is discouraged.)
theorem eighmorth (A2 B2 T: class):
  $ wi (wa (wa (wcel T cho) (wcel A2 (cfv T cei))) (wa (wcel B2 (cfv T cei)) (wne (cfv A2 (cfv T cel)) (cfv B2 (cfv T cel))))) (wceq (co A2 B2 csp) cc0) $;

--| Value of the norm of the negative of a Hilbert space operator. Unlike ~ nmophmi , the operator does not have to be bounded. (Contributed by NM, 10-Mar-2006.) (New usage is discouraged.)
theorem nmopnegi (T: class):
  $ wf chba chba T $ >
  $ wceq (cfv (co (cneg c1) T chot) cnop) (cfv T cnop) $;

--| The value of a linear Hilbert space operator at zero is zero. Remark in [Beran] p. 99. (Contributed by NM, 13-Aug-2006.) (New usage is discouraged.)
theorem lnop0 (T: class):
  $ wi (wcel T clo) (wceq (cfv c0v T) c0v) $;

--| Multiplicative property of a linear Hilbert space operator. (Contributed by NM, 13-Aug-2006.) (New usage is discouraged.)
theorem lnopmul (A2 B2 T: class):
  $ wi (w3a (wcel T clo) (wcel A2 cc) (wcel B2 chba)) (wceq (cfv (co A2 B2 csm) T) (co A2 (cfv B2 T) csm)) $;

--| Basic scalar product property of a linear Hilbert space operator. (Contributed by NM, 23-Jan-2006.) (New usage is discouraged.)
theorem lnopli (A2 B2 C T: class):
  $ wcel T clo $ >
  $ wi (w3a (wcel A2 cc) (wcel B2 chba) (wcel C chba)) (wceq (cfv (co (co A2 B2 csm) C cva) T) (co (co A2 (cfv B2 T) csm) (cfv C T) cva)) $;

--| A linear Hilbert space operator is a Hilbert space operator. (Contributed by NM, 23-Jan-2006.) (New usage is discouraged.)
theorem lnopfi (T: class):
  $ wcel T clo $ >
  $ wf chba chba T $;

--| The value of a linear Hilbert space operator at zero is zero. Remark in [Beran] p. 99. (Contributed by NM, 11-May-2005.) (New usage is discouraged.)
theorem lnop0i (T: class):
  $ wcel T clo $ >
  $ wceq (cfv c0v T) c0v $;

--| Additive property of a linear Hilbert space operator. (Contributed by NM, 11-May-2005.) (New usage is discouraged.)
theorem lnopaddi (A2 B2 T: class):
  $ wcel T clo $ >
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wceq (cfv (co A2 B2 cva) T) (co (cfv A2 T) (cfv B2 T) cva)) $;

--| Multiplicative property of a linear Hilbert space operator. (Contributed by NM, 11-May-2005.) (New usage is discouraged.)
theorem lnopmuli (A2 B2 T: class):
  $ wcel T clo $ >
  $ wi (wa (wcel A2 cc) (wcel B2 chba)) (wceq (cfv (co A2 B2 csm) T) (co A2 (cfv B2 T) csm)) $;

--| Sum/product property of a linear Hilbert space operator. (Contributed by NM, 1-Jul-2005.) (New usage is discouraged.)
theorem lnopaddmuli (A2 B2 C T: class):
  $ wcel T clo $ >
  $ wi (w3a (wcel A2 cc) (wcel B2 chba) (wcel C chba)) (wceq (cfv (co B2 (co A2 C csm) cva) T) (co (cfv B2 T) (co A2 (cfv C T) csm) cva)) $;

--| Subtraction property for a linear Hilbert space operator. (Contributed by NM, 1-Jul-2005.) (New usage is discouraged.)
theorem lnopsubi (A2 B2 T: class):
  $ wcel T clo $ >
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wceq (cfv (co A2 B2 cmv) T) (co (cfv A2 T) (cfv B2 T) cmv)) $;

--| Subtraction/product property of a linear Hilbert space operator. (Contributed by NM, 2-Jul-2005.) (New usage is discouraged.)
theorem lnopsubmuli (A2 B2 C T: class):
  $ wcel T clo $ >
  $ wi (w3a (wcel A2 cc) (wcel B2 chba) (wcel C chba)) (wceq (cfv (co B2 (co A2 C csm) cmv) T) (co (cfv B2 T) (co A2 (cfv C T) csm) cmv)) $;

--| Product/subtraction property of a linear Hilbert space operator. (Contributed by NM, 2-Jul-2005.) (New usage is discouraged.)
theorem lnopmulsubi (A2 B2 C T: class):
  $ wcel T clo $ >
  $ wi (w3a (wcel A2 cc) (wcel B2 chba) (wcel C chba)) (wceq (cfv (co (co A2 B2 csm) C cmv) T) (co (co A2 (cfv B2 T) csm) (cfv C T) cmv)) $;

--| Move a scalar product out of a composition of operators. The operator ` T ` must be linear, unlike ~ homco1 that works for any operators. (Contributed by NM, 13-Aug-2006.) (New usage is discouraged.)
theorem homco2 (A2 T U: class):
  $ wi (w3a (wcel A2 cc) (wcel T clo) (wf chba chba U)) (wceq (ccom T (co A2 U chot)) (co A2 (ccom T U) chot)) $;

--| The identity function (restricted to Hilbert space) is a unitary operator. (Contributed by NM, 21-Jan-2006.) (New usage is discouraged.)
theorem idunop:
  $ wcel (cres cid chba) cuo $;

--| The identically zero function is a continuous Hilbert space operator. (Contributed by NM, 7-Feb-2006.) (New usage is discouraged.)
theorem _0cnop:
  $ wcel ch0o ccop $;

--| The identically zero function is a continuous Hilbert space functional. (Contributed by NM, 7-Feb-2006.) (New usage is discouraged.)
theorem _0cnfn:
  $ wcel (cxp chba (csn cc0)) ccnfn $;

--| The identity function (restricted to Hilbert space) is a continuous operator. (Contributed by NM, 7-Feb-2006.) (New usage is discouraged.)
theorem idcnop:
  $ wcel (cres cid chba) ccop $;

--| The Hilbert space identity operator is a Hermitian operator. (Contributed by NM, 22-Apr-2006.) (New usage is discouraged.)
theorem idhmop:
  $ wcel chio cho $;

--| The identically zero function is a Hermitian operator. (Contributed by NM, 8-Aug-2006.) (New usage is discouraged.)
theorem _0hmop:
  $ wcel ch0o cho $;

--| The identically zero function is a linear Hilbert space operator. (Contributed by NM, 7-Feb-2006.) (New usage is discouraged.)
theorem _0lnop:
  $ wcel ch0o clo $;

--| The identically zero function is a linear Hilbert space functional. (Contributed by NM, 14-Feb-2006.) (New usage is discouraged.)
theorem _0lnfn:
  $ wcel (cxp chba (csn cc0)) clf $;

--| The norm of the zero operator is zero. (Contributed by NM, 8-Feb-2006.) (New usage is discouraged.)
theorem nmop0:
  $ wceq (cfv ch0o cnop) cc0 $;

--| The norm of the identically zero functional is zero. (Contributed by NM, 25-Apr-2006.) (New usage is discouraged.)
theorem nmfn0:
  $ wceq (cfv (cxp chba (csn cc0)) cnmf) cc0 $;

--| A Hermitian operator is a bounded linear operator (Hellinger-Toeplitz Theorem). (Contributed by NM, 18-Jan-2008.) (New usage is discouraged.)
theorem hmopbdoptHIL (T: class):
  $ wi (wcel T cho) (wcel T cbo) $;

--| Distributive law for Hilbert space operator difference. (Interestingly, the reverse distributive law ~ hocsubdiri does not require linearity.) (Contributed by NM, 11-Mar-2006.) (New usage is discouraged.)
theorem hoddii (R S T: class):
  $ wcel R clo $ >
  $ wf chba chba S $ >
  $ wf chba chba T $ >
  $ wceq (ccom R (co S T chod)) (co (ccom R S) (ccom R T) chod) $;

--| Distributive law for Hilbert space operator difference. (Interestingly, the reverse distributive law ~ hocsubdiri does not require linearity.) (Contributed by NM, 23-Aug-2006.) (New usage is discouraged.)
theorem hoddi (R S T: class):
  $ wi (w3a (wcel R clo) (wf chba chba S) (wf chba chba T)) (wceq (ccom R (co S T chod)) (co (ccom R S) (ccom R T) chod)) $;

--| The norm of any operator on the trivial Hilbert space is zero. (This is the reason we need ` ~H =/= 0H ` in ~ nmopun .) (Contributed by NM, 24-Feb-2006.) (New usage is discouraged.)
theorem nmop0h (T: class):
  $ wi (wa (wceq chba c0h) (wf chba chba T)) (wceq (cfv T cnop) cc0) $;

--| The identity function (restricted to Hilbert space) is a linear operator. (Contributed by NM, 24-Jan-2006.) (New usage is discouraged.)
theorem idlnop:
  $ wcel (cres cid chba) clo $;

--| The identically zero operator is bounded. (Contributed by NM, 14-Feb-2006.) (New usage is discouraged.)
theorem _0bdop:
  $ wcel ch0o cbo $;

--| Adjoint of the zero operator. (Contributed by NM, 20-Feb-2006.) (New usage is discouraged.)
theorem adj0:
  $ wceq (cfv ch0o cado) ch0o $;

--| A linear operator with a zero norm is identically zero. (Contributed by NM, 8-Feb-2006.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem nmlnop0iALT (T: class):
  $ wcel T clo $ >
  $ wb (wceq (cfv T cnop) cc0) (wceq T ch0o) $;

--| A linear operator with a zero norm is identically zero. (Contributed by NM, 18-Jan-2008.) (New usage is discouraged.)
theorem nmlnop0iHIL (T: class):
  $ wcel T clo $ >
  $ wb (wceq (cfv T cnop) cc0) (wceq T ch0o) $;

--| A linear Hilbert space operator that is not identically zero has a positive norm. (Contributed by NM, 9-Feb-2006.) (New usage is discouraged.)
theorem nmlnopgt0i (T: class):
  $ wcel T clo $ >
  $ wb (wne T ch0o) (wbr cc0 (cfv T cnop) clt) $;

--| A linear operator with a zero norm is identically zero. (Contributed by NM, 12-Aug-2006.) (New usage is discouraged.)
theorem nmlnop0 (T: class):
  $ wi (wcel T clo) (wb (wceq (cfv T cnop) cc0) (wceq T ch0o)) $;

--| A linear operator with a nonzero norm is nonzero. (Contributed by NM, 12-Aug-2006.) (New usage is discouraged.)
theorem nmlnopne0 (T: class):
  $ wi (wcel T clo) (wb (wne (cfv T cnop) cc0) (wne T ch0o)) $;

--| The scalar product of a linear operator is a linear operator. (Contributed by NM, 10-Mar-2006.) (New usage is discouraged.)
theorem lnopmi (A2 T: class):
  $ wcel T clo $ >
  $ wi (wcel A2 cc) (wcel (co A2 T chot) clo) $;

--| The sum of two linear operators is linear. (Contributed by NM, 10-Mar-2006.) (New usage is discouraged.)
theorem lnophsi (S T: class):
  $ wcel S clo $ >
  $ wcel T clo $ >
  $ wcel (co S T chos) clo $;

--| The difference of two linear operators is linear. (Contributed by NM, 27-Jul-2006.) (New usage is discouraged.)
theorem lnophdi (S T: class):
  $ wcel S clo $ >
  $ wcel T clo $ >
  $ wcel (co S T chod) clo $;

--| The composition of two linear operators is linear. (Contributed by NM, 8-Mar-2006.) (New usage is discouraged.)
theorem lnopcoi (S T: class):
  $ wcel S clo $ >
  $ wcel T clo $ >
  $ wcel (ccom S T) clo $;

--| The composition of a linear operator with one whose norm is zero. (Contributed by NM, 10-Mar-2006.) (New usage is discouraged.)
theorem lnopco0i (S T: class):
  $ wcel S clo $ >
  $ wcel T clo $ >
  $ wi (wceq (cfv T cnop) cc0) (wceq (cfv (ccom S T) cnop) cc0) $;

--| Lemma for ~ lnopeq0i . Apply the generalized polarization identity ~ polid2i to the quadratic form ` ( ( T `` x ) , x ) ` . (Contributed by NM, 26-Jul-2006.) (New usage is discouraged.)
theorem lnopeq0lem1 (A2 B2 T: class):
  $ wcel T clo $ >
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wceq (co (cfv A2 T) B2 csp) (co (co (co (co (cfv (co A2 B2 cva) T) (co A2 B2 cva) csp) (co (cfv (co A2 B2 cmv) T) (co A2 B2 cmv) csp) cmin) (co ci (co (co (cfv (co A2 (co ci B2 csm) cva) T) (co A2 (co ci B2 csm) cva) csp) (co (cfv (co A2 (co ci B2 csm) cmv) T) (co A2 (co ci B2 csm) cmv) csp) cmin) cmul) caddc) c4 cdiv) $;

--| Lemma for ~ lnopeq0i . (Contributed by NM, 26-Jul-2006.) (New usage is discouraged.)
theorem lnopeq0lem2 (A2 B2 T: class):
  $ wcel T clo $ >
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wceq (co (cfv A2 T) B2 csp) (co (co (co (co (cfv (co A2 B2 cva) T) (co A2 B2 cva) csp) (co (cfv (co A2 B2 cmv) T) (co A2 B2 cmv) csp) cmin) (co ci (co (co (cfv (co A2 (co ci B2 csm) cva) T) (co A2 (co ci B2 csm) cva) csp) (co (cfv (co A2 (co ci B2 csm) cmv) T) (co A2 (co ci B2 csm) cmv) csp) cmin) cmul) caddc) c4 cdiv)) $;

--| A condition implying that a linear Hilbert space operator is identically zero. Unlike ~ ho01i for arbitrary operators, when the operator is linear we need to consider only the values of the quadratic form ` ( T `` x ) .ih x ) ` . (Contributed by NM, 26-Jul-2006.) (New usage is discouraged.)
theorem lnopeq0i {x3: setvar} (T: class):
  $ wcel T clo $ >
  $ wb (wral x3 (wceq (co (cfv (cv x3) T) (cv x3) csp) cc0) chba) (wceq T ch0o) $;

--| Two linear Hilbert space operators are equal iff their quadratic forms are equal. (Contributed by NM, 27-Jul-2006.) (New usage is discouraged.)
theorem lnopeqi {x3: setvar} (T U: class):
  $ wcel T clo $ >
  $ wcel U clo $ >
  $ wb (wral x3 (wceq (co (cfv (cv x3) T) (cv x3) csp) (co (cfv (cv x3) U) (cv x3) csp)) chba) (wceq T U) $;

--| Two linear Hilbert space operators are equal iff their quadratic forms are equal. (Contributed by NM, 27-Jul-2006.) (New usage is discouraged.)
theorem lnopeq {x3: setvar} (T U: class):
  $ wi (wa (wcel T clo) (wcel U clo)) (wb (wral x3 (wceq (co (cfv (cv x3) T) (cv x3) csp) (co (cfv (cv x3) U) (cv x3) csp)) chba) (wceq T U)) $;

--| Lemma for ~ lnopunii . (Contributed by NM, 14-May-2005.) (New usage is discouraged.)
theorem lnopunilem1 {x3: setvar} (A2 B2 C: class x3) (T: class):
  $ wcel T clo $ >
  $ wral x3 (wceq (cfv (cfv (cv x3) T) cno) (cfv (cv x3) cno)) chba $ >
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wcel C cc $ >
  $ wceq (cfv (co C (co (cfv A2 T) (cfv B2 T) csp) cmul) cre) (cfv (co C (co A2 B2 csp) cmul) cre) $;

--| Lemma for ~ lnopunii . (Contributed by NM, 12-May-2005.) (New usage is discouraged.)
theorem lnopunilem2 {x3: setvar} (A2 B2: class x3) (T: class):
  $ wcel T clo $ >
  $ wral x3 (wceq (cfv (cfv (cv x3) T) cno) (cfv (cv x3) cno)) chba $ >
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wceq (co (cfv A2 T) (cfv B2 T) csp) (co A2 B2 csp) $;

--| If a linear operator (whose range is ` ~H ` ) is idempotent in the norm, the operator is unitary. Similar to theorem in [AkhiezerGlazman] p. 73. (Contributed by NM, 23-Jan-2006.) (New usage is discouraged.)
theorem lnopunii {x3: setvar} (T: class):
  $ wcel T clo $ >
  $ wfo chba chba T $ >
  $ wral x3 (wceq (cfv (cfv (cv x3) T) cno) (cfv (cv x3) cno)) chba $ >
  $ wcel T cuo $;

--| An operator is unitary iff it is linear, onto, and idempotent in the norm. Similar to theorem in [AkhiezerGlazman] p. 73, and its converse. (Contributed by NM, 24-Feb-2006.) (New usage is discouraged.)
theorem elunop2 {x3: setvar} (T: class):
  $ wb (wcel T cuo) (w3a (wcel T clo) (wfo chba chba T) (wral x3 (wceq (cfv (cfv (cv x3) T) cno) (cfv (cv x3) cno)) chba)) $;

--| Norm of a unitary Hilbert space operator. (Contributed by NM, 25-Feb-2006.) (New usage is discouraged.)
theorem nmopun (T: class):
  $ wi (wa (wne chba c0h) (wcel T cuo)) (wceq (cfv T cnop) c1) $;

--| A unitary operator is a bounded linear operator. (Contributed by NM, 10-Mar-2006.) (New usage is discouraged.)
theorem unopbd (T: class):
  $ wi (wcel T cuo) (wcel T cbo) $;

--| Lemma for ~ lnophmi . (Contributed by NM, 24-Jan-2006.) (New usage is discouraged.)
theorem lnophmlem1 {x3: setvar} (A2 B2 T: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wcel T clo $ >
  $ wral x3 (wcel (co (cv x3) (cfv (cv x3) T) csp) cr) chba $ >
  $ wcel (co A2 (cfv A2 T) csp) cr $;

--| Lemma for ~ lnophmi . (Contributed by NM, 24-Jan-2006.) (New usage is discouraged.)
theorem lnophmlem2 {x3: setvar} (A2 B2 T: class):
  $ wcel A2 chba $ >
  $ wcel B2 chba $ >
  $ wcel T clo $ >
  $ wral x3 (wcel (co (cv x3) (cfv (cv x3) T) csp) cr) chba $ >
  $ wceq (co A2 (cfv B2 T) csp) (co (cfv A2 T) B2 csp) $;

--| A linear operator is Hermitian if ` x .ih ( T `` x ) ` takes only real values. Remark in [ReedSimon] p. 195. (Contributed by NM, 24-Jan-2006.) (New usage is discouraged.)
theorem lnophmi {x3: setvar} (T: class):
  $ wcel T clo $ >
  $ wral x3 (wcel (co (cv x3) (cfv (cv x3) T) csp) cr) chba $ >
  $ wcel T cho $;

--| A linear operator is Hermitian if ` x .ih ( T `` x ) ` takes only real values. Remark in [ReedSimon] p. 195. (Contributed by NM, 24-Jan-2006.) (New usage is discouraged.)
theorem lnophm {x3: setvar} (T: class):
  $ wi (wa (wcel T clo) (wral x3 (wcel (co (cv x3) (cfv (cv x3) T) csp) cr) chba)) (wcel T cho) $;

--| The sum of two Hermitian operators is Hermitian. (Contributed by NM, 23-Jul-2006.) (New usage is discouraged.)
theorem hmops (T U: class):
  $ wi (wa (wcel T cho) (wcel U cho)) (wcel (co T U chos) cho) $;

--| The scalar product of a Hermitian operator with a real is Hermitian. (Contributed by NM, 23-Jul-2006.) (New usage is discouraged.)
theorem hmopm (A2 T: class):
  $ wi (wa (wcel A2 cr) (wcel T cho)) (wcel (co A2 T chot) cho) $;

--| The difference of two Hermitian operators is Hermitian. (Contributed by NM, 23-Jul-2006.) (New usage is discouraged.)
theorem hmopd (T U: class):
  $ wi (wa (wcel T cho) (wcel U cho)) (wcel (co T U chod) cho) $;

--| The composition of two commuting Hermitian operators is Hermitian. (Contributed by NM, 22-Aug-2006.) (New usage is discouraged.)
theorem hmopco (T U: class):
  $ wi (w3a (wcel T cho) (wcel U cho) (wceq (ccom T U) (ccom U T))) (wcel (ccom T U) cho) $;

--| A lower bound for the norm of a bounded linear operator. (Contributed by NM, 14-Feb-2006.) (New usage is discouraged.)
theorem nmbdoplbi (A2 T: class):
  $ wcel T cbo $ >
  $ wi (wcel A2 chba) (wbr (cfv (cfv A2 T) cno) (co (cfv T cnop) (cfv A2 cno) cmul) cle) $;

--| A lower bound for the norm of a bounded linear Hilbert space operator. (Contributed by NM, 18-Feb-2006.) (New usage is discouraged.)
theorem nmbdoplb (A2 T: class):
  $ wi (wa (wcel T cbo) (wcel A2 chba)) (wbr (cfv (cfv A2 T) cno) (co (cfv T cnop) (cfv A2 cno) cmul) cle) $;

--| Lemma for ~ nmcopexi and ~ nmcfnexi . The norm of a continuous linear Hilbert space operator or functional exists. Theorem 3.5(i) of [Beran] p. 99. (Contributed by Mario Carneiro, 17-Nov-2013.) (Proof shortened by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem nmcexi {x3 y1 z m: setvar} (S: class x3 y1 z m) (T N: class):
  $ wrex y1 (wral z (wi (wbr (cfv (cv z) cno) (cv y1) clt) (wbr (cfv (cfv (cv z) T) N) c1 clt)) chba) crp $ >
  $ wceq (cfv T S) (csup (cab m (wrex x3 (wa (wbr (cfv (cv x3) cno) c1 cle) (wceq (cv m) (cfv (cfv (cv x3) T) N))) chba)) cxr clt) $ >
  $ wi (wcel (cv x3) chba) (wcel (cfv (cfv (cv x3) T) N) cr) $ >
  $ wceq (cfv (cfv c0v T) N) cc0 $ >
  $ wi (wa (wcel (co (cv y1) c2 cdiv) crp) (wcel (cv x3) chba)) (wceq (co (co (cv y1) c2 cdiv) (cfv (cfv (cv x3) T) N) cmul) (cfv (cfv (co (co (cv y1) c2 cdiv) (cv x3) csm) T) N)) $ >
  $ wcel (cfv T S) cr $;

--| The norm of a continuous linear Hilbert space operator exists. Theorem 3.5(i) of [Beran] p. 99. (Contributed by NM, 5-Feb-2006.) (Proof shortened by Mario Carneiro, 17-Nov-2013.) (New usage is discouraged.)
theorem nmcopexi (T: class):
  $ wcel T clo $ >
  $ wcel T ccop $ >
  $ wcel (cfv T cnop) cr $;

--| A lower bound for the norm of a continuous linear operator. Theorem 3.5(ii) of [Beran] p. 99. (Contributed by NM, 7-Feb-2006.) (Revised by Mario Carneiro, 17-Nov-2013.) (New usage is discouraged.)
theorem nmcoplbi (A2 T: class):
  $ wcel T clo $ >
  $ wcel T ccop $ >
  $ wi (wcel A2 chba) (wbr (cfv (cfv A2 T) cno) (co (cfv T cnop) (cfv A2 cno) cmul) cle) $;

--| The norm of a continuous linear Hilbert space operator exists. Theorem 3.5(i) of [Beran] p. 99. (Contributed by NM, 7-Feb-2006.) (New usage is discouraged.)
theorem nmcopex (T: class):
  $ wi (wa (wcel T clo) (wcel T ccop)) (wcel (cfv T cnop) cr) $;

--| A lower bound for the norm of a continuous linear Hilbert space operator. Theorem 3.5(ii) of [Beran] p. 99. (Contributed by NM, 7-Feb-2006.) (New usage is discouraged.)
theorem nmcoplb (A2 T: class):
  $ wi (w3a (wcel T clo) (wcel T ccop) (wcel A2 chba)) (wbr (cfv (cfv A2 T) cno) (co (cfv T cnop) (cfv A2 cno) cmul) cle) $;

--| The norm of the scalar product of a bounded linear operator. (Contributed by NM, 10-Mar-2006.) (New usage is discouraged.)
theorem nmophmi (A2 T: class):
  $ wcel T cbo $ >
  $ wi (wcel A2 cc) (wceq (cfv (co A2 T chot) cnop) (co (cfv A2 cabs) (cfv T cnop) cmul)) $;

--| The scalar product of a bounded linear operator is a bounded linear operator. (Contributed by NM, 10-Mar-2006.) (New usage is discouraged.)
theorem bdophmi (A2 T: class):
  $ wcel T cbo $ >
  $ wi (wcel A2 cc) (wcel (co A2 T chot) cbo) $;

--| Lemma for ~ lnopconi and ~ lnfnconi . (Contributed by NM, 7-Feb-2006.) (New usage is discouraged.)
theorem lnconi {x3 y1 z w: setvar} (C: class x3 z w) (S: class z w) (T: class) (M: class x3 z w) (N: class):
  $ wi (wcel T C) (wcel S cr) $ >
  $ wi (wa (wcel T C) (wcel (cv y1) chba)) (wbr (cfv (cfv (cv y1) T) N) (co S (cfv (cv y1) cno) cmul) cle) $ >
  $ wb (wcel T C) (wral x3 (wral z (wrex y1 (wral w (wi (wbr (cfv (co (cv w) (cv x3) cmv) cno) (cv y1) clt) (wbr (cfv (co (cfv (cv w) T) (cfv (cv x3) T) M) N) (cv z) clt)) chba) crp) crp) chba) $ >
  $ wi (wcel (cv y1) chba) (wcel (cfv (cfv (cv y1) T) N) cr) $ >
  $ wi (wa (wcel (cv w) chba) (wcel (cv x3) chba)) (wceq (cfv (co (cv w) (cv x3) cmv) T) (co (cfv (cv w) T) (cfv (cv x3) T) M)) $ >
  $ wb (wcel T C) (wrex x3 (wral y1 (wbr (cfv (cfv (cv y1) T) N) (co (cv x3) (cfv (cv y1) cno) cmul) cle) chba) cr) $;

--| A condition equivalent to " ` T ` is continuous" when ` T ` is linear. Theorem 3.5(iii) of [Beran] p. 99. (Contributed by NM, 7-Feb-2006.) (Proof shortened by Mario Carneiro, 17-Nov-2013.) (New usage is discouraged.)
theorem lnopconi {x3 y1: setvar} (T: class):
  $ wcel T clo $ >
  $ wb (wcel T ccop) (wrex x3 (wral y1 (wbr (cfv (cfv (cv y1) T) cno) (co (cv x3) (cfv (cv y1) cno) cmul) cle) chba) cr) $;

--| A condition equivalent to " ` T ` is continuous" when ` T ` is linear. Theorem 3.5(iii) of [Beran] p. 99. (Contributed by NM, 14-Feb-2006.) (New usage is discouraged.)
theorem lnopcon {x3 y1: setvar} (T: class):
  $ wi (wcel T clo) (wb (wcel T ccop) (wrex x3 (wral y1 (wbr (cfv (cfv (cv y1) T) cno) (co (cv x3) (cfv (cv y1) cno) cmul) cle) chba) cr)) $;

--| A linear operator is continuous iff it is bounded. (Contributed by NM, 14-Feb-2006.) (New usage is discouraged.)
theorem lnopcnbd (T: class):
  $ wi (wcel T clo) (wb (wcel T ccop) (wcel T cbo)) $;

--| A continuous linear operator is a bounded linear operator. This theorem justifies our use of "bounded linear" as an interchangeable condition for "continuous linear" used in some textbook proofs. (Contributed by NM, 18-Feb-2006.) (New usage is discouraged.)
theorem lncnopbd (T: class):
  $ wb (wcel T (cin clo ccop)) (wcel T cbo) $;

--| A continuous linear operator is a bounded linear operator. (Contributed by NM, 18-Feb-2006.) (New usage is discouraged.)
theorem lncnbd:
  $ wceq (cin clo ccop) cbo $;

--| A linear operator is continuous iff it is bounded. (Contributed by NM, 14-Feb-2006.) (New usage is discouraged.)
theorem lnopcnre (T: class):
  $ wi (wcel T clo) (wb (wcel T ccop) (wcel (cfv T cnop) cr)) $;

--| Basic property of a linear Hilbert space functional. (Contributed by NM, 11-Feb-2006.) (New usage is discouraged.)
theorem lnfnli (A2 B2 C T: class):
  $ wcel T clf $ >
  $ wi (w3a (wcel A2 cc) (wcel B2 chba) (wcel C chba)) (wceq (cfv (co (co A2 B2 csm) C cva) T) (co (co A2 (cfv B2 T) cmul) (cfv C T) caddc)) $;

--| A linear Hilbert space functional is a functional. (Contributed by NM, 11-Feb-2006.) (New usage is discouraged.)
theorem lnfnfi (T: class):
  $ wcel T clf $ >
  $ wf chba cc T $;

--| The value of a linear Hilbert space functional at zero is zero. Remark in [Beran] p. 99. (Contributed by NM, 11-Feb-2006.) (New usage is discouraged.)
theorem lnfn0i (T: class):
  $ wcel T clf $ >
  $ wceq (cfv c0v T) cc0 $;

--| Additive property of a linear Hilbert space functional. (Contributed by NM, 11-Feb-2006.) (New usage is discouraged.)
theorem lnfnaddi (A2 B2 T: class):
  $ wcel T clf $ >
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wceq (cfv (co A2 B2 cva) T) (co (cfv A2 T) (cfv B2 T) caddc)) $;

--| Multiplicative property of a linear Hilbert space functional. (Contributed by NM, 11-Feb-2006.) (New usage is discouraged.)
theorem lnfnmuli (A2 B2 T: class):
  $ wcel T clf $ >
  $ wi (wa (wcel A2 cc) (wcel B2 chba)) (wceq (cfv (co A2 B2 csm) T) (co A2 (cfv B2 T) cmul)) $;

--| Sum/product property of a linear Hilbert space functional. (Contributed by NM, 13-Feb-2006.) (New usage is discouraged.)
theorem lnfnaddmuli (A2 B2 C T: class):
  $ wcel T clf $ >
  $ wi (w3a (wcel A2 cc) (wcel B2 chba) (wcel C chba)) (wceq (cfv (co B2 (co A2 C csm) cva) T) (co (cfv B2 T) (co A2 (cfv C T) cmul) caddc)) $;

--| Subtraction property for a linear Hilbert space functional. (Contributed by NM, 13-Feb-2006.) (New usage is discouraged.)
theorem lnfnsubi (A2 B2 T: class):
  $ wcel T clf $ >
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wceq (cfv (co A2 B2 cmv) T) (co (cfv A2 T) (cfv B2 T) cmin)) $;

--| The value of a linear Hilbert space functional at zero is zero. Remark in [Beran] p. 99. (Contributed by NM, 25-Apr-2006.) (New usage is discouraged.)
theorem lnfn0 (T: class):
  $ wi (wcel T clf) (wceq (cfv c0v T) cc0) $;

--| Multiplicative property of a linear Hilbert space functional. (Contributed by NM, 30-May-2006.) (New usage is discouraged.)
theorem lnfnmul (A2 B2 T: class):
  $ wi (w3a (wcel T clf) (wcel A2 cc) (wcel B2 chba)) (wceq (cfv (co A2 B2 csm) T) (co A2 (cfv B2 T) cmul)) $;

--| A lower bound for the norm of a bounded linear functional. (Contributed by NM, 25-Apr-2006.) (New usage is discouraged.)
theorem nmbdfnlbi (A2 T: class):
  $ wa (wcel T clf) (wcel (cfv T cnmf) cr) $ >
  $ wi (wcel A2 chba) (wbr (cfv (cfv A2 T) cabs) (co (cfv T cnmf) (cfv A2 cno) cmul) cle) $;

--| A lower bound for the norm of a bounded linear functional. (Contributed by NM, 25-Apr-2006.) (New usage is discouraged.)
theorem nmbdfnlb (A2 T: class):
  $ wi (w3a (wcel T clf) (wcel (cfv T cnmf) cr) (wcel A2 chba)) (wbr (cfv (cfv A2 T) cabs) (co (cfv T cnmf) (cfv A2 cno) cmul) cle) $;

--| The norm of a continuous linear Hilbert space functional exists. Theorem 3.5(i) of [Beran] p. 99. (Contributed by NM, 14-Feb-2006.) (Proof shortened by Mario Carneiro, 17-Nov-2013.) (New usage is discouraged.)
theorem nmcfnexi (T: class):
  $ wcel T clf $ >
  $ wcel T ccnfn $ >
  $ wcel (cfv T cnmf) cr $;

--| A lower bound for the norm of a continuous linear functional. Theorem 3.5(ii) of [Beran] p. 99. (Contributed by NM, 14-Feb-2006.) (New usage is discouraged.)
theorem nmcfnlbi (A2 T: class):
  $ wcel T clf $ >
  $ wcel T ccnfn $ >
  $ wi (wcel A2 chba) (wbr (cfv (cfv A2 T) cabs) (co (cfv T cnmf) (cfv A2 cno) cmul) cle) $;

--| The norm of a continuous linear Hilbert space functional exists. Theorem 3.5(i) of [Beran] p. 99. (Contributed by NM, 14-Feb-2006.) (New usage is discouraged.)
theorem nmcfnex (T: class):
  $ wi (wa (wcel T clf) (wcel T ccnfn)) (wcel (cfv T cnmf) cr) $;

--| A lower bound of the norm of a continuous linear Hilbert space functional. Theorem 3.5(ii) of [Beran] p. 99. (Contributed by NM, 14-Feb-2006.) (New usage is discouraged.)
theorem nmcfnlb (A2 T: class):
  $ wi (w3a (wcel T clf) (wcel T ccnfn) (wcel A2 chba)) (wbr (cfv (cfv A2 T) cabs) (co (cfv T cnmf) (cfv A2 cno) cmul) cle) $;

--| A condition equivalent to " ` T ` is continuous" when ` T ` is linear. Theorem 3.5(iii) of [Beran] p. 99. (Contributed by NM, 14-Feb-2006.) (Proof shortened by Mario Carneiro, 17-Nov-2013.) (New usage is discouraged.)
theorem lnfnconi {x3 y1: setvar} (T: class):
  $ wcel T clf $ >
  $ wb (wcel T ccnfn) (wrex x3 (wral y1 (wbr (cfv (cfv (cv y1) T) cabs) (co (cv x3) (cfv (cv y1) cno) cmul) cle) chba) cr) $;

--| A condition equivalent to " ` T ` is continuous" when ` T ` is linear. Theorem 3.5(iii) of [Beran] p. 99. (Contributed by NM, 16-Feb-2006.) (New usage is discouraged.)
theorem lnfncon {x3 y1: setvar} (T: class):
  $ wi (wcel T clf) (wb (wcel T ccnfn) (wrex x3 (wral y1 (wbr (cfv (cfv (cv y1) T) cabs) (co (cv x3) (cfv (cv y1) cno) cmul) cle) chba) cr)) $;

--| A linear functional is continuous iff it is bounded. (Contributed by NM, 25-Apr-2006.) (New usage is discouraged.)
theorem lnfncnbd (T: class):
  $ wi (wcel T clf) (wb (wcel T ccnfn) (wcel (cfv T cnmf) cr)) $;

--| The image of a subspace under a linear operator is a subspace. (Contributed by Mario Carneiro, 19-May-2014.) (New usage is discouraged.)
theorem imaelshi (A2 T: class):
  $ wcel T clo $ >
  $ wcel A2 csh $ >
  $ wcel (cima T A2) csh $;

--| The range of a linear operator is a subspace. (Contributed by Mario Carneiro, 17-Nov-2013.) (New usage is discouraged.)
theorem rnelshi (T: class):
  $ wcel T clo $ >
  $ wcel (crn T) csh $;

--| The null space of a linear functional is a subspace. (Contributed by NM, 11-Feb-2006.) (Revised by Mario Carneiro, 17-Nov-2013.) (New usage is discouraged.)
theorem nlelshi (T: class):
  $ wcel T clf $ >
  $ wcel (cfv T cnl) csh $;

--| The null space of a continuous linear functional is a closed subspace. Remark 3.8 of [Beran] p. 103. (Contributed by NM, 11-Feb-2006.) (Proof shortened by Mario Carneiro, 19-May-2014.) (New usage is discouraged.)
theorem nlelchi (T: class):
  $ wcel T clf $ >
  $ wcel T ccnfn $ >
  $ wcel (cfv T cnl) cch $;

--| A continuous linear functional can be expressed as an inner product. Existence part of Theorem 3.9 of [Beran] p. 104. (Contributed by NM, 13-Feb-2006.) (New usage is discouraged.)
theorem riesz3i {w v: setvar} (T: class):
  $ wcel T clf $ >
  $ wcel T ccnfn $ >
  $ wrex w (wral v (wceq (cfv (cv v) T) (co (cv v) (cv w) csp)) chba) chba $;

--| A continuous linear functional can be expressed as an inner product. Uniqueness part of Theorem 3.9 of [Beran] p. 104. (Contributed by NM, 13-Feb-2006.) (New usage is discouraged.)
theorem riesz4i {w v: setvar} (T: class):
  $ wcel T clf $ >
  $ wcel T ccnfn $ >
  $ wreu w (wral v (wceq (cfv (cv v) T) (co (cv v) (cv w) csp)) chba) chba $;

--| A continuous linear functional can be expressed as an inner product. Uniqueness part of Theorem 3.9 of [Beran] p. 104. See ~ riesz2 for the bounded linear functional version. (Contributed by NM, 16-Feb-2006.) (New usage is discouraged.)
theorem riesz4 {w v: setvar} (T: class):
  $ wi (wcel T (cin clf ccnfn)) (wreu w (wral v (wceq (cfv (cv v) T) (co (cv v) (cv w) csp)) chba) chba) $;

--| Part 1 of the Riesz representation theorem for bounded linear functionals. A linear functional is bounded iff its value can be expressed as an inner product. Part of Theorem 17.3 of [Halmos] p. 31. For part 2, see ~ riesz2 . For the continuous linear functional version, see ~ riesz3i and ~ riesz4 . (Contributed by NM, 25-Apr-2006.) (New usage is discouraged.)
theorem riesz1 {x3 y1: setvar} (T: class):
  $ wi (wcel T clf) (wb (wcel (cfv T cnmf) cr) (wrex y1 (wral x3 (wceq (cfv (cv x3) T) (co (cv x3) (cv y1) csp)) chba) chba)) $;

--| Part 2 of the Riesz representation theorem for bounded linear functionals. The value of a bounded linear functional corresponds to a unique inner product. Part of Theorem 17.3 of [Halmos] p. 31. For part 1, see ~ riesz1 . (Contributed by NM, 25-Apr-2006.) (New usage is discouraged.)
theorem riesz2 {x3 y1: setvar} (T: class):
  $ wi (wa (wcel T clf) (wcel (cfv T cnmf) cr)) (wreu y1 (wral x3 (wceq (cfv (cv x3) T) (co (cv x3) (cv y1) csp)) chba) chba) $;

--| Lemma for ~ cnlnadji (Theorem 3.10 of [Beran] p. 104: every continuous linear operator has an adjoint). The value of the auxiliary functional ` G ` . (Contributed by NM, 16-Feb-2006.) (New usage is discouraged.)
theorem cnlnadjlem1 {y1 g2: setvar} (A2 T: class) (G: class y1 g2):
  $ wcel T clo $ >
  $ wcel T ccop $ >
  $ wceq G (cmpt g2 chba (co (cfv (cv g2) T) (cv y1) csp)) $ >
  $ wi (wcel A2 chba) (wceq (cfv A2 G) (co (cfv A2 T) (cv y1) csp)) $;

--| Lemma for ~ cnlnadji . ` G ` is a continuous linear functional. (Contributed by NM, 16-Feb-2006.) (New usage is discouraged.)
theorem cnlnadjlem2 {y1 g2: setvar} (T: class) (G: class y1 g2):
  $ wcel T clo $ >
  $ wcel T ccop $ >
  $ wceq G (cmpt g2 chba (co (cfv (cv g2) T) (cv y1) csp)) $ >
  $ wi (wcel (cv y1) chba) (wa (wcel G clf) (wcel G ccnfn)) $;

--| Lemma for ~ cnlnadji . By ~ riesz4 , ` B ` is the unique vector such that ` ( T `` v ) .ih y ) = ( v .ih w ) ` for all ` v ` . (Contributed by NM, 17-Feb-2006.) (New usage is discouraged.)
theorem cnlnadjlem3 {y1 w v g2: setvar} (B2: class y1 w v g2) (T: class) (G: class y1 g2):
  $ wcel T clo $ >
  $ wcel T ccop $ >
  $ wceq G (cmpt g2 chba (co (cfv (cv g2) T) (cv y1) csp)) $ >
  $ wceq B2 (crio w (wral v (wceq (co (cfv (cv v) T) (cv y1) csp) (co (cv v) (cv w) csp)) chba) chba) $ >
  $ wi (wcel (cv y1) chba) (wcel B2 chba) $;

--| Lemma for ~ cnlnadji . The values of auxiliary function ` F ` are vectors. (Contributed by NM, 17-Feb-2006.) (Proof shortened by Mario Carneiro, 10-Sep-2015.) (New usage is discouraged.)
theorem cnlnadjlem4 {y1 w v g2: setvar} (A2: class) (B2: class y1 w v g2) (T: class) (F: class y1 v g2) (G: class y1 g2):
  $ wcel T clo $ >
  $ wcel T ccop $ >
  $ wceq G (cmpt g2 chba (co (cfv (cv g2) T) (cv y1) csp)) $ >
  $ wceq B2 (crio w (wral v (wceq (co (cfv (cv v) T) (cv y1) csp) (co (cv v) (cv w) csp)) chba) chba) $ >
  $ wceq F (cmpt y1 chba B2) $ >
  $ wi (wcel A2 chba) (wcel (cfv A2 F) chba) $;

--| Lemma for ~ cnlnadji . ` F ` is an adjoint of ` T ` (later, we will show it is unique). (Contributed by NM, 18-Feb-2006.) (New usage is discouraged.)
theorem cnlnadjlem5 {y1 w v g2: setvar} (A2: class) (B2 C: class y1 w v g2) (T: class) (F: class y1 v g2) (G: class y1 g2):
  $ wcel T clo $ >
  $ wcel T ccop $ >
  $ wceq G (cmpt g2 chba (co (cfv (cv g2) T) (cv y1) csp)) $ >
  $ wceq B2 (crio w (wral v (wceq (co (cfv (cv v) T) (cv y1) csp) (co (cv v) (cv w) csp)) chba) chba) $ >
  $ wceq F (cmpt y1 chba B2) $ >
  $ wi (wa (wcel A2 chba) (wcel C chba)) (wceq (co (cfv C T) A2 csp) (co C (cfv A2 F) csp)) $;

--| Lemma for ~ cnlnadji . ` F ` is linear. (Contributed by NM, 17-Feb-2006.) (New usage is discouraged.)
theorem cnlnadjlem6 {y1 w v g2: setvar} (B2: class y1 w v g2) (T: class) (F: class y1 v g2) (G: class y1 g2):
  $ wcel T clo $ >
  $ wcel T ccop $ >
  $ wceq G (cmpt g2 chba (co (cfv (cv g2) T) (cv y1) csp)) $ >
  $ wceq B2 (crio w (wral v (wceq (co (cfv (cv v) T) (cv y1) csp) (co (cv v) (cv w) csp)) chba) chba) $ >
  $ wceq F (cmpt y1 chba B2) $ >
  $ wcel F clo $;

--| Lemma for ~ cnlnadji . Helper lemma to show that ` F ` is continuous. (Contributed by NM, 18-Feb-2006.) (New usage is discouraged.)
theorem cnlnadjlem7 {y1 w v g2: setvar} (A2: class) (B2: class y1 w v g2) (T: class) (F: class y1 v g2) (G: class y1 g2):
  $ wcel T clo $ >
  $ wcel T ccop $ >
  $ wceq G (cmpt g2 chba (co (cfv (cv g2) T) (cv y1) csp)) $ >
  $ wceq B2 (crio w (wral v (wceq (co (cfv (cv v) T) (cv y1) csp) (co (cv v) (cv w) csp)) chba) chba) $ >
  $ wceq F (cmpt y1 chba B2) $ >
  $ wi (wcel A2 chba) (wbr (cfv (cfv A2 F) cno) (co (cfv T cnop) (cfv A2 cno) cmul) cle) $;

--| Lemma for ~ cnlnadji . ` F ` is continuous. (Contributed by NM, 17-Feb-2006.) (New usage is discouraged.)
theorem cnlnadjlem8 {y1 w v g2: setvar} (B2: class y1 w v g2) (T: class) (F: class y1 v g2) (G: class y1 g2):
  $ wcel T clo $ >
  $ wcel T ccop $ >
  $ wceq G (cmpt g2 chba (co (cfv (cv g2) T) (cv y1) csp)) $ >
  $ wceq B2 (crio w (wral v (wceq (co (cfv (cv v) T) (cv y1) csp) (co (cv v) (cv w) csp)) chba) chba) $ >
  $ wceq F (cmpt y1 chba B2) $ >
  $ wcel F ccop $;

--| Lemma for ~ cnlnadji . ` F ` provides an example showing the existence of a continuous linear adjoint. (Contributed by NM, 18-Feb-2006.) (New usage is discouraged.)
theorem cnlnadjlem9 {x3 y1 z w v t g2: setvar} (B2: class x3 y1 w v t g2) (T: class) (F: class y1 v g2) (G: class y1 t g2):
  $ wcel T clo $ >
  $ wcel T ccop $ >
  $ wceq G (cmpt g2 chba (co (cfv (cv g2) T) (cv y1) csp)) $ >
  $ wceq B2 (crio w (wral v (wceq (co (cfv (cv v) T) (cv y1) csp) (co (cv v) (cv w) csp)) chba) chba) $ >
  $ wceq F (cmpt y1 chba B2) $ >
  $ wrex t (wral x3 (wral z (wceq (co (cfv (cv x3) T) (cv z) csp) (co (cv x3) (cfv (cv z) (cv t)) csp)) chba) chba) (cin clo ccop) $;

--| Every continuous linear operator has an adjoint. Theorem 3.10 of [Beran] p. 104. (Contributed by NM, 18-Feb-2006.) (New usage is discouraged.)
theorem cnlnadji {x3 y1 t: setvar} (T: class):
  $ wcel T clo $ >
  $ wcel T ccop $ >
  $ wrex t (wral x3 (wral y1 (wceq (co (cfv (cv x3) T) (cv y1) csp) (co (cv x3) (cfv (cv y1) (cv t)) csp)) chba) chba) (cin clo ccop) $;

--| Every continuous linear operator has a unique adjoint. Theorem 3.10 of [Beran] p. 104. (Contributed by NM, 18-Feb-2006.) (New usage is discouraged.)
theorem cnlnadjeui {x3 y1 t: setvar} (T: class):
  $ wcel T clo $ >
  $ wcel T ccop $ >
  $ wreu t (wral x3 (wral y1 (wceq (co (cfv (cv x3) T) (cv y1) csp) (co (cv x3) (cfv (cv y1) (cv t)) csp)) chba) chba) (cin clo ccop) $;

--| Every continuous linear operator has a unique adjoint. Theorem 3.10 of [Beran] p. 104. (Contributed by NM, 19-Feb-2006.) (New usage is discouraged.)
theorem cnlnadjeu {x3 y1 t: setvar} (T: class):
  $ wi (wcel T (cin clo ccop)) (wreu t (wral x3 (wral y1 (wceq (co (cfv (cv x3) T) (cv y1) csp) (co (cv x3) (cfv (cv y1) (cv t)) csp)) chba) chba) (cin clo ccop)) $;

--| Every continuous linear operator has an adjoint. Theorem 3.10 of [Beran] p. 104. (Contributed by NM, 18-Feb-2006.) (New usage is discouraged.)
theorem cnlnadj {x3 y1 t: setvar} (T: class):
  $ wi (wcel T (cin clo ccop)) (wrex t (wral x3 (wral y1 (wceq (co (cfv (cv x3) T) (cv y1) csp) (co (cv x3) (cfv (cv y1) (cv t)) csp)) chba) chba) (cin clo ccop)) $;

--| Every continuous linear Hilbert space operator has an adjoint. (Contributed by NM, 18-Feb-2006.) (New usage is discouraged.)
theorem cnlnssadj:
  $ wss (cin clo ccop) (cdm cado) $;

--| Every bounded linear Hilbert space operator has an adjoint. (Contributed by NM, 19-Feb-2006.) (New usage is discouraged.)
theorem bdopssadj:
  $ wss cbo (cdm cado) $;

--| Every bounded linear Hilbert space operator has an adjoint. (Contributed by NM, 22-Feb-2006.) (New usage is discouraged.)
theorem bdopadj (T: class):
  $ wi (wcel T cbo) (wcel T (cdm cado)) $;

--| The adjoint of a bounded linear operator is a bounded linear operator. (Contributed by NM, 19-Feb-2006.) (New usage is discouraged.)
theorem adjbdln (T: class):
  $ wi (wcel T cbo) (wcel (cfv T cado) cbo) $;

--| An operator is bounded and linear iff its adjoint is. (Contributed by NM, 19-Feb-2006.) (New usage is discouraged.)
theorem adjbdlnb (T: class):
  $ wb (wcel T cbo) (wcel (cfv T cado) cbo) $;

--| The mapping of adjoints of bounded linear operators is one-to-one onto. (Contributed by NM, 19-Feb-2006.) (New usage is discouraged.)
theorem adjbd1o:
  $ wf1o cbo cbo (cres cado cbo) $;

--| The adjoint of an operator is linear. Proposition 1 of [AkhiezerGlazman] p. 80. (Contributed by NM, 17-Jun-2006.) (New usage is discouraged.)
theorem adjlnop (T: class):
  $ wi (wcel T (cdm cado)) (wcel (cfv T cado) clo) $;

--| Every operator with an adjoint is linear. (Contributed by NM, 17-Jun-2006.) (New usage is discouraged.)
theorem adjsslnop:
  $ wss (cdm cado) clo $;

--| Property of the norm of an adjoint. Part of proof of Theorem 3.10 of [Beran] p. 104. (Contributed by NM, 22-Feb-2006.) (New usage is discouraged.)
theorem nmopadjlei (A2 T: class):
  $ wcel T cbo $ >
  $ wi (wcel A2 chba) (wbr (cfv (cfv A2 (cfv T cado)) cno) (co (cfv T cnop) (cfv A2 cno) cmul) cle) $;

--| Lemma for ~ nmopadji . (Contributed by NM, 22-Feb-2006.) (New usage is discouraged.)
theorem nmopadjlem (T: class):
  $ wcel T cbo $ >
  $ wbr (cfv (cfv T cado) cnop) (cfv T cnop) cle $;

--| Property of the norm of an adjoint. Theorem 3.11(v) of [Beran] p. 106. (Contributed by NM, 22-Feb-2006.) (New usage is discouraged.)
theorem nmopadji (T: class):
  $ wcel T cbo $ >
  $ wceq (cfv (cfv T cado) cnop) (cfv T cnop) $;

--| An operator is zero iff its adjoint is zero. Theorem 3.11(i) of [Beran] p. 106. (Contributed by NM, 20-Feb-2006.) (New usage is discouraged.)
theorem adjeq0 (T: class):
  $ wb (wceq T ch0o) (wceq (cfv T cado) ch0o) $;

--| The adjoint of the scalar product of an operator. Theorem 3.11(ii) of [Beran] p. 106. (Contributed by NM, 21-Feb-2006.) (New usage is discouraged.)
theorem adjmul (A2 T: class):
  $ wi (wa (wcel A2 cc) (wcel T (cdm cado))) (wceq (cfv (co A2 T chot) cado) (co (cfv A2 ccj) (cfv T cado) chot)) $;

--| The adjoint of the sum of two operators. Theorem 3.11(iii) of [Beran] p. 106. (Contributed by NM, 22-Feb-2006.) (New usage is discouraged.)
theorem adjadd (S T: class):
  $ wi (wa (wcel S (cdm cado)) (wcel T (cdm cado))) (wceq (cfv (co S T chos) cado) (co (cfv S cado) (cfv T cado) chos)) $;

--| Triangle inequality for the norms of bounded linear operators. (Contributed by NM, 10-Mar-2006.) (New usage is discouraged.)
theorem nmoptrii (S T: class):
  $ wcel S cbo $ >
  $ wcel T cbo $ >
  $ wbr (cfv (co S T chos) cnop) (co (cfv S cnop) (cfv T cnop) caddc) cle $;

--| Upper bound for the norm of the composition of two bounded linear operators. (Contributed by NM, 10-Mar-2006.) (New usage is discouraged.)
theorem nmopcoi (S T: class):
  $ wcel S cbo $ >
  $ wcel T cbo $ >
  $ wbr (cfv (ccom S T) cnop) (co (cfv S cnop) (cfv T cnop) cmul) cle $;

--| The sum of two bounded linear operators is a bounded linear operator. (Contributed by NM, 9-Mar-2006.) (New usage is discouraged.)
theorem bdophsi (S T: class):
  $ wcel S cbo $ >
  $ wcel T cbo $ >
  $ wcel (co S T chos) cbo $;

--| The difference between two bounded linear operators is bounded. (Contributed by NM, 10-Mar-2006.) (New usage is discouraged.)
theorem bdophdi (S T: class):
  $ wcel S cbo $ >
  $ wcel T cbo $ >
  $ wcel (co S T chod) cbo $;

--| The composition of two bounded linear operators is bounded. (Contributed by NM, 9-Mar-2006.) (New usage is discouraged.)
theorem bdopcoi (S T: class):
  $ wcel S cbo $ >
  $ wcel T cbo $ >
  $ wcel (ccom S T) cbo $;

--| Triangle-type inequality for the norms of bounded linear operators. (Contributed by NM, 10-Mar-2006.) (New usage is discouraged.)
theorem nmoptri2i (S T: class):
  $ wcel S cbo $ >
  $ wcel T cbo $ >
  $ wbr (co (cfv S cnop) (cfv T cnop) cmin) (cfv (co S T chos) cnop) cle $;

--| The adjoint of a composition of bounded linear operators. Theorem 3.11(viii) of [Beran] p. 106. (Contributed by NM, 10-Mar-2006.) (New usage is discouraged.)
theorem adjcoi (S T: class):
  $ wcel S cbo $ >
  $ wcel T cbo $ >
  $ wceq (cfv (ccom S T) cado) (ccom (cfv T cado) (cfv S cado)) $;

--| The norm of an operator composed with its adjoint. Part of Theorem 3.11(vi) of [Beran] p. 106. (Contributed by NM, 8-Mar-2006.) (New usage is discouraged.)
theorem nmopcoadji (T: class):
  $ wcel T cbo $ >
  $ wceq (cfv (ccom (cfv T cado) T) cnop) (co (cfv T cnop) c2 cexp) $;

--| The norm of an operator composed with its adjoint. Part of Theorem 3.11(vi) of [Beran] p. 106. (Contributed by NM, 10-Mar-2006.) (New usage is discouraged.)
theorem nmopcoadj2i (T: class):
  $ wcel T cbo $ >
  $ wceq (cfv (ccom T (cfv T cado)) cnop) (co (cfv T cnop) c2 cexp) $;

--| An operator composed with its adjoint is zero iff the operator is zero. Theorem 3.11(vii) of [Beran] p. 106. (Contributed by NM, 10-Mar-2006.) (New usage is discouraged.)
theorem nmopcoadj0i (T: class):
  $ wcel T cbo $ >
  $ wb (wceq (ccom T (cfv T cado)) ch0o) (wceq T ch0o) $;

--| If we approximate a chain of unitary transformations (quantum computer gates) ` F ` , ` G ` by other unitary transformations ` S ` , ` T ` , the error increases at most additively. Equation 4.73 of [NielsenChuang] p. 195. (Contributed by NM, 10-Mar-2006.) (New usage is discouraged.)
theorem unierri (S T F G: class):
  $ wcel F cuo $ >
  $ wcel G cuo $ >
  $ wcel S cuo $ >
  $ wcel T cuo $ >
  $ wbr (cfv (co (ccom F G) (ccom S T) chod) cnop) (co (cfv (co F S chod) cnop) (cfv (co G T chod) cnop) caddc) cle $;

--| The norm of the bra function. (Contributed by NM, 24-May-2006.) (New usage is discouraged.)
theorem branmfn (A2: class):
  $ wi (wcel A2 chba) (wceq (cfv (cfv A2 cbr) cnmf) (cfv A2 cno)) $;

--| The bra of a vector is a bounded functional. (Contributed by NM, 26-May-2006.) (New usage is discouraged.)
theorem brabn (A2: class):
  $ wi (wcel A2 chba) (wcel (cfv (cfv A2 cbr) cnmf) cr) $;

--| The set of bras equals the set of continuous linear functionals. (Contributed by NM, 26-May-2006.) (New usage is discouraged.)
theorem rnbra:
  $ wceq (crn cbr) (cin clf ccnfn) $;

--| The bra function maps vectors one-to-one onto the set of continuous linear functionals. (Contributed by NM, 26-May-2006.) (Proof shortened by Mario Carneiro, 16-Nov-2013.) (New usage is discouraged.)
theorem bra11:
  $ wf1o chba (cin clf ccnfn) cbr $;

--| A bra is a continuous linear functional. (Contributed by NM, 30-May-2006.) (New usage is discouraged.)
theorem bracnln (A2: class):
  $ wi (wcel A2 chba) (wcel (cfv A2 cbr) (cin clf ccnfn)) $;

--| Value of the converse of the bra function. Based on the Riesz Lemma ~ riesz4 , this very important theorem not only justifies the Dirac bra-ket notation, but allows to extract a unique vector from any continuous linear functional from which the functional can be recovered; i.e. a single vector can "store" _all_ of the information contained in any entire continuous linear functional (mapping from ` ~H ` to ` CC ` ). (Contributed by NM, 26-May-2006.) (New usage is discouraged.)
theorem cnvbraval {x3 y1: setvar} (T: class):
  $ wi (wcel T (cin clf ccnfn)) (wceq (cfv T (ccnv cbr)) (crio y1 (wral x3 (wceq (cfv (cv x3) T) (co (cv x3) (cv y1) csp)) chba) chba)) $;

--| Closure of the converse of the bra function. (Contributed by NM, 26-May-2006.) (New usage is discouraged.)
theorem cnvbracl (T: class):
  $ wi (wcel T (cin clf ccnfn)) (wcel (cfv T (ccnv cbr)) chba) $;

--| The converse bra of the bra of a vector is the vector itself. (Contributed by NM, 30-May-2006.) (New usage is discouraged.)
theorem cnvbrabra (A2: class):
  $ wi (wcel A2 chba) (wceq (cfv (cfv A2 cbr) (ccnv cbr)) A2) $;

--| The bra of the converse bra of a continuous linear functional. (Contributed by NM, 31-May-2006.) (New usage is discouraged.)
theorem bracnvbra (T: class):
  $ wi (wcel T (cin clf ccnfn)) (wceq (cfv (cfv T (ccnv cbr)) cbr) T) $;

--| The vector that a continuous linear functional is the bra of. (Contributed by NM, 26-May-2006.) (New usage is discouraged.)
theorem bracnlnval {x3 y1: setvar} (T: class):
  $ wi (wcel T (cin clf ccnfn)) (wceq T (cfv (crio y1 (wral x3 (wceq (cfv (cv x3) T) (co (cv x3) (cv y1) csp)) chba) chba) cbr)) $;

--| Multiplication property of the converse bra function. (Contributed by NM, 31-May-2006.) (New usage is discouraged.)
theorem cnvbramul (A2 T: class):
  $ wi (wa (wcel A2 cc) (wcel T (cin clf ccnfn))) (wceq (cfv (co A2 T chft) (ccnv cbr)) (co (cfv A2 ccj) (cfv T (ccnv cbr)) csm)) $;

--| Dirac bra-ket associative law ` ( | A >. <. B | ) | C >. = | A >. ( <. B | C >. ) ` , i.e., the juxtaposition of an outer product with a ket equals a bra juxtaposed with an inner product. Since ` <. B | C >. ` is a complex number, it is the first argument in the inner product ` .h ` that it is mapped to, although in Dirac notation it is placed after the ket. (Contributed by NM, 15-May-2006.) (New usage is discouraged.)
theorem kbass1 (A2 B2 C: class):
  $ wi (w3a (wcel A2 chba) (wcel B2 chba) (wcel C chba)) (wceq (cfv C (co A2 B2 ck)) (co (cfv C (cfv B2 cbr)) A2 csm)) $;

--| Dirac bra-ket associative law ` ( <. A | B >. ) <. C | = <. A | ( | B >. <. C | ) ` , i.e., the juxtaposition of an inner product with a bra equals a ket juxtaposed with an outer product. (Contributed by NM, 23-May-2006.) (New usage is discouraged.)
theorem kbass2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 chba) (wcel B2 chba) (wcel C chba)) (wceq (co (cfv B2 (cfv A2 cbr)) (cfv C cbr) chft) (ccom (cfv A2 cbr) (co B2 C ck))) $;

--| Dirac bra-ket associative law ` <. A | B >. <. C | D >. = ( <. A | B >. <. C | ) | D >. ` . (Contributed by NM, 30-May-2006.) (New usage is discouraged.)
theorem kbass3 (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 chba) (wcel B2 chba)) (wa (wcel C chba) (wcel D chba))) (wceq (co (cfv B2 (cfv A2 cbr)) (cfv D (cfv C cbr)) cmul) (cfv D (co (cfv B2 (cfv A2 cbr)) (cfv C cbr) chft))) $;

--| Dirac bra-ket associative law ` <. A | B >. <. C | D >. = <. A | ( | B >. <. C | D >. ) ` . (Contributed by NM, 30-May-2006.) (New usage is discouraged.)
theorem kbass4 (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 chba) (wcel B2 chba)) (wa (wcel C chba) (wcel D chba))) (wceq (co (cfv B2 (cfv A2 cbr)) (cfv D (cfv C cbr)) cmul) (cfv (co (cfv D (cfv C cbr)) B2 csm) (cfv A2 cbr))) $;

--| Dirac bra-ket associative law ` ( | A >. <. B | ) ( | C >. <. D | ) = ` ` ( ( | A >. <. B | ) | C >. ) <. D | ` . (Contributed by NM, 30-May-2006.) (New usage is discouraged.)
theorem kbass5 (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 chba) (wcel B2 chba)) (wa (wcel C chba) (wcel D chba))) (wceq (ccom (co A2 B2 ck) (co C D ck)) (co (cfv C (co A2 B2 ck)) D ck)) $;

--| Dirac bra-ket associative law ` ( | A >. <. B | ) ( | C >. <. D | ) = ` ` | A >. ( <. B | ( | C >. <. D | ) ) ` . (Contributed by NM, 30-May-2006.) (New usage is discouraged.)
theorem kbass6 (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 chba) (wcel B2 chba)) (wa (wcel C chba) (wcel D chba))) (wceq (ccom (co A2 B2 ck) (co C D ck)) (co A2 (cfv (ccom (cfv B2 cbr) (co C D ck)) (ccnv cbr)) ck)) $;

--| Ordering relation for positive operators. Definition of positive operator ordering in [Kreyszig] p. 470. (Contributed by NM, 23-Jul-2006.) (New usage is discouraged.)
theorem leopg {x3: setvar} (A2 B2 T U: class):
  $ wi (wa (wcel T A2) (wcel U B2)) (wb (wbr T U cleo) (wa (wcel (co U T chod) cho) (wral x3 (wbr cc0 (co (cfv (cv x3) (co U T chod)) (cv x3) csp) cle) chba))) $;

--| Ordering relation for operators. Definition of positive operator ordering in [Kreyszig] p. 470. (Contributed by NM, 23-Jul-2006.) (New usage is discouraged.)
theorem leop {x3: setvar} (T U: class):
  $ wi (wa (wcel T cho) (wcel U cho)) (wb (wbr T U cleo) (wral x3 (wbr cc0 (co (cfv (cv x3) (co U T chod)) (cv x3) csp) cle) chba)) $;

--| Ordering relation for operators. Definition of operator ordering in [Young] p. 141. (Contributed by NM, 23-Jul-2006.) (New usage is discouraged.)
theorem leop2 {x3: setvar} (T U: class):
  $ wi (wa (wcel T cho) (wcel U cho)) (wb (wbr T U cleo) (wral x3 (wbr (co (cfv (cv x3) T) (cv x3) csp) (co (cfv (cv x3) U) (cv x3) csp) cle) chba)) $;

--| Operator ordering in terms of a positive operator. Definition of operator ordering in [Retherford] p. 49. (Contributed by NM, 23-Jul-2006.) (New usage is discouraged.)
theorem leop3 (T U: class):
  $ wi (wa (wcel T cho) (wcel U cho)) (wb (wbr T U cleo) (wbr ch0o (co U T chod) cleo)) $;

--| Binary relation defining a positive operator. Definition VI.1 of [Retherford] p. 49. (Contributed by NM, 25-Jul-2006.) (New usage is discouraged.)
theorem leoppos {x3: setvar} (T: class):
  $ wi (wcel T cho) (wb (wbr ch0o T cleo) (wral x3 (wbr cc0 (co (cfv (cv x3) T) (cv x3) csp) cle) chba)) $;

--| The ordering relation for operators is reflexive. (Contributed by NM, 24-Jul-2006.) (New usage is discouraged.)
theorem leoprf2 (T: class):
  $ wi (wf chba chba T) (wbr T T cleo) $;

--| The ordering relation for operators is reflexive. (Contributed by NM, 23-Jul-2006.) (New usage is discouraged.)
theorem leoprf (T: class):
  $ wi (wcel T cho) (wbr T T cleo) $;

--| The square of a Hermitian operator is positive. (Contributed by NM, 23-Aug-2006.) (New usage is discouraged.)
theorem leopsq (T: class):
  $ wi (wcel T cho) (wbr ch0o (ccom T T) cleo) $;

--| The zero operator is a positive operator. (The literature calls it "positive", even though in some sense it is really "nonnegative".) Part of Example 12.2(i) in [Young] p. 142. (Contributed by NM, 23-Jul-2006.) (New usage is discouraged.)
theorem _0leop:
  $ wbr ch0o ch0o cleo $;

--| The identity operator is a positive operator. Part of Example 12.2(i) in [Young] p. 142. (Contributed by NM, 23-Jul-2006.) (New usage is discouraged.)
theorem idleop:
  $ wbr ch0o chio cleo $;

--| The sum of two positive operators is positive. Exercise 1(i) of [Retherford] p. 49. (Contributed by NM, 25-Jul-2006.) (New usage is discouraged.)
theorem leopadd (T U: class):
  $ wi (wa (wa (wcel T cho) (wcel U cho)) (wa (wbr ch0o T cleo) (wbr ch0o U cleo))) (wbr ch0o (co T U chos) cleo) $;

--| The scalar product of a nonnegative real and a positive operator is a positive operator. Exercise 1(ii) of [Retherford] p. 49. (Contributed by NM, 25-Jul-2006.) (New usage is discouraged.)
theorem leopmuli (A2 T: class):
  $ wi (wa (wa (wcel A2 cr) (wcel T cho)) (wa (wbr cc0 A2 cle) (wbr ch0o T cleo))) (wbr ch0o (co A2 T chot) cleo) $;

--| The scalar product of a positive real and a positive operator is a positive operator. Exercise 1(ii) of [Retherford] p. 49. (Contributed by NM, 23-Aug-2006.) (New usage is discouraged.)
theorem leopmul (A2 T: class):
  $ wi (w3a (wcel A2 cr) (wcel T cho) (wbr cc0 A2 clt)) (wb (wbr ch0o T cleo) (wbr ch0o (co A2 T chot) cleo)) $;

--| Scalar product applied to operator ordering. (Contributed by NM, 12-Aug-2006.) (New usage is discouraged.)
theorem leopmul2i (A2 T U: class):
  $ wi (wa (w3a (wcel A2 cr) (wcel T cho) (wcel U cho)) (wa (wbr cc0 A2 cle) (wbr T U cleo))) (wbr (co A2 T chot) (co A2 U chot) cleo) $;

--| The positive operator ordering relation satisfies trichotomy. Exercise 1(iii) of [Retherford] p. 49. (Contributed by NM, 25-Jul-2006.) (New usage is discouraged.)
theorem leoptri (T U: class):
  $ wi (wa (wcel T cho) (wcel U cho)) (wb (wa (wbr T U cleo) (wbr U T cleo)) (wceq T U)) $;

--| The positive operator ordering relation is transitive. Exercise 1(iv) of [Retherford] p. 49. (Contributed by NM, 25-Jul-2006.) (New usage is discouraged.)
theorem leoptr (S T U: class):
  $ wi (wa (w3a (wcel S cho) (wcel T cho) (wcel U cho)) (wa (wbr S T cleo) (wbr T U cleo))) (wbr S U cleo) $;

--| A bounded Hermitian operator is less than or equal to its norm times the identity operator. (Contributed by NM, 11-Aug-2006.) (New usage is discouraged.)
theorem leopnmid (T: class):
  $ wi (wa (wcel T cho) (wcel (cfv T cnop) cr)) (wbr T (co (cfv T cnop) chio chot) cleo) $;

--| A nonzero, bounded Hermitian operator divided by its norm is less than or equal to the identity operator. (Contributed by NM, 12-Aug-2006.) (New usage is discouraged.)
theorem nmopleid (T: class):
  $ wi (w3a (wcel T cho) (wcel (cfv T cnop) cr) (wne T ch0o)) (wbr (co (co c1 (cfv T cnop) cdiv) T chot) chio cleo) $;

--| Lemma for opsqri . (Contributed by NM, 9-Aug-2006.) (New usage is discouraged.)
theorem opsqrlem1 {v u: setvar} (R: class v u) (T: class):
  $ wcel T cho $ >
  $ wcel (cfv T cnop) cr $ >
  $ wbr ch0o T cleo $ >
  $ wceq R (co (co c1 (cfv T cnop) cdiv) T chot) $ >
  $ wi (wne T ch0o) (wrex u (wa (wbr ch0o (cv u) cleo) (wceq (ccom (cv u) (cv u)) R)) cho) $ >
  $ wi (wne T ch0o) (wrex v (wa (wbr ch0o (cv v) cleo) (wceq (ccom (cv v) (cv v)) T)) cho) $;

--| Lemma for opsqri . ` F `` N ` is the recursive function A_n (starting at n=1 instead of 0) of Theorem 9.4-2 of [Kreyszig] p. 476. (Contributed by NM, 17-Aug-2006.) (New usage is discouraged.)
theorem opsqrlem2 {x3 y1: setvar} (S: class x3 y1) (T: class) (F: class x3 y1):
  $ wcel T cho $ >
  $ wceq S (cmpo x3 y1 cho cho (co (cv x3) (co (co c1 c2 cdiv) (co T (ccom (cv x3) (cv x3)) chod) chot) chos)) $ >
  $ wceq F (cseq S (cxp cn (csn ch0o)) c1) $ >
  $ wceq (cfv c1 F) ch0o $;

--| Lemma for opsqri . (Contributed by NM, 22-Aug-2006.) (New usage is discouraged.)
theorem opsqrlem3 {x3 y1: setvar} (S: class x3 y1) (T: class) (F G H: class x3 y1):
  $ wcel T cho $ >
  $ wceq S (cmpo x3 y1 cho cho (co (cv x3) (co (co c1 c2 cdiv) (co T (ccom (cv x3) (cv x3)) chod) chot) chos)) $ >
  $ wceq F (cseq S (cxp cn (csn ch0o)) c1) $ >
  $ wi (wa (wcel G cho) (wcel H cho)) (wceq (co G H S) (co G (co (co c1 c2 cdiv) (co T (ccom G G) chod) chot) chos)) $;

--| Lemma for opsqri . (Contributed by NM, 17-Aug-2006.) (New usage is discouraged.)
theorem opsqrlem4 {x3 y1: setvar} (S: class x3 y1) (T: class) (F: class x3 y1):
  $ wcel T cho $ >
  $ wceq S (cmpo x3 y1 cho cho (co (cv x3) (co (co c1 c2 cdiv) (co T (ccom (cv x3) (cv x3)) chod) chot) chos)) $ >
  $ wceq F (cseq S (cxp cn (csn ch0o)) c1) $ >
  $ wf cn cho F $;

--| Lemma for opsqri . (Contributed by NM, 17-Aug-2006.) (New usage is discouraged.)
theorem opsqrlem5 {x3 y1: setvar} (S: class x3 y1) (T: class) (F N: class x3 y1):
  $ wcel T cho $ >
  $ wceq S (cmpo x3 y1 cho cho (co (cv x3) (co (co c1 c2 cdiv) (co T (ccom (cv x3) (cv x3)) chod) chot) chos)) $ >
  $ wceq F (cseq S (cxp cn (csn ch0o)) c1) $ >
  $ wi (wcel N cn) (wceq (cfv (co N c1 caddc) F) (co (cfv N F) (co (co c1 c2 cdiv) (co T (ccom (cfv N F) (cfv N F)) chod) chot) chos)) $;

--| Lemma for opsqri . (Contributed by NM, 23-Aug-2006.) (New usage is discouraged.)
theorem opsqrlem6 {x3 y1: setvar} (S: class x3 y1) (T: class) (F N: class x3 y1):
  $ wcel T cho $ >
  $ wceq S (cmpo x3 y1 cho cho (co (cv x3) (co (co c1 c2 cdiv) (co T (ccom (cv x3) (cv x3)) chod) chot) chos)) $ >
  $ wceq F (cseq S (cxp cn (csn ch0o)) c1) $ >
  $ wbr T chio cleo $ >
  $ wi (wcel N cn) (wbr (cfv N F) chio cleo) $;

--| A projector is a Hermitian operator. (Contributed by NM, 24-Mar-2006.) (New usage is discouraged.)
theorem pjhmopi (H: class):
  $ wcel H cch $ >
  $ wcel (cfv H cpjh) cho $;

--| A projector is a linear operator. (Contributed by NM, 24-Mar-2006.) (New usage is discouraged.)
theorem pjlnopi (H: class):
  $ wcel H cch $ >
  $ wcel (cfv H cpjh) clo $;

--| The operator norm of a projector on a nonzero closed subspace is one. Part of Theorem 26.1 of [Halmos] p. 43. (Contributed by NM, 9-Apr-2006.) (New usage is discouraged.)
theorem pjnmopi (H: class):
  $ wcel H cch $ >
  $ wi (wne H c0h) (wceq (cfv (cfv H cpjh) cnop) c1) $;

--| A projector is a bounded linear operator. (Contributed by NM, 3-Jun-2006.) (New usage is discouraged.)
theorem pjbdlni (H: class):
  $ wcel H cch $ >
  $ wcel (cfv H cpjh) cbo $;

--| A projection is a Hermitian operator. (Contributed by NM, 24-Apr-2006.) (New usage is discouraged.)
theorem pjhmop (H: class):
  $ wi (wcel H cch) (wcel (cfv H cpjh) cho) $;

--| An idempotent Hermitian operator generates a closed subspace. Part of proof of Theorem of [AkhiezerGlazman] p. 64. (Contributed by NM, 21-Apr-2006.) (Proof shortened by Mario Carneiro, 19-May-2014.) (New usage is discouraged.)
theorem hmopidmchi (T: class):
  $ wcel T cho $ >
  $ wceq (ccom T T) T $ >
  $ wcel (crn T) cch $;

--| An idempotent Hermitian operator is a projection operator. Theorem 26.4 of [Halmos] p. 44. (Halmos seems to omit the proof that ` H ` is a closed subspace, which is not trivial as ~ hmopidmchi shows.) (Contributed by NM, 22-Apr-2006.) (Revised by Mario Carneiro, 19-May-2014.) (New usage is discouraged.)
theorem hmopidmpji (T: class):
  $ wcel T cho $ >
  $ wceq (ccom T T) T $ >
  $ wceq T (cfv (crn T) cpjh) $;

--| An idempotent Hermitian operator generates a closed subspace. Part of proof of Theorem of [AkhiezerGlazman] p. 64. (Contributed by NM, 24-Apr-2006.) (New usage is discouraged.)
theorem hmopidmch (T: class):
  $ wi (wa (wcel T cho) (wceq (ccom T T) T)) (wcel (crn T) cch) $;

--| An idempotent Hermitian operator is a projection operator. Theorem 26.4 of [Halmos] p. 44. (Contributed by NM, 22-Apr-2006.) (New usage is discouraged.)
theorem hmopidmpj (T: class):
  $ wi (wa (wcel T cho) (wceq (ccom T T) T)) (wceq T (cfv (crn T) cpjh)) $;

--| Distributive law for Hilbert space operator sum. (Contributed by NM, 12-Nov-2000.) (New usage is discouraged.)
theorem pjsdii (S T H: class):
  $ wcel H cch $ >
  $ wf chba chba S $ >
  $ wf chba chba T $ >
  $ wceq (ccom (cfv H cpjh) (co S T chos)) (co (ccom (cfv H cpjh) S) (ccom (cfv H cpjh) T) chos) $;

--| Distributive law for Hilbert space operator difference. (Contributed by NM, 24-Nov-2000.) (New usage is discouraged.)
theorem pjddii (S T H: class):
  $ wcel H cch $ >
  $ wf chba chba S $ >
  $ wf chba chba T $ >
  $ wceq (ccom (cfv H cpjh) (co S T chod)) (co (ccom (cfv H cpjh) S) (ccom (cfv H cpjh) T) chod) $;

--| Chained distributive law for Hilbert space operator difference. (Contributed by NM, 30-Nov-2000.) (New usage is discouraged.)
theorem pjsdi2i (R S T H: class):
  $ wcel H cch $ >
  $ wf chba chba R $ >
  $ wf chba chba S $ >
  $ wf chba chba T $ >
  $ wi (wceq (ccom R (co S T chos)) (co (ccom R S) (ccom R T) chos)) (wceq (ccom (ccom (cfv H cpjh) R) (co S T chos)) (co (ccom (ccom (cfv H cpjh) R) S) (ccom (ccom (cfv H cpjh) R) T) chos)) $;

--| Composition of projections. (Contributed by NM, 16-Aug-2000.) (New usage is discouraged.)
theorem pjcoi (A2 G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wi (wcel A2 chba) (wceq (cfv A2 (ccom (cfv G cpjh) (cfv H cpjh))) (cfv (cfv A2 (cfv H cpjh)) (cfv G cpjh))) $;

--| Closure of composition of projections. (Contributed by NM, 29-Nov-2000.) (New usage is discouraged.)
theorem pjcocli (A2 G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wi (wcel A2 chba) (wcel (cfv A2 (ccom (cfv G cpjh) (cfv H cpjh))) G) $;

--| Closure of composition of projections. (Contributed by NM, 7-Oct-2000.) (New usage is discouraged.)
theorem pjcohcli (A2 G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wi (wcel A2 chba) (wcel (cfv A2 (ccom (cfv G cpjh) (cfv H cpjh))) chba) $;

--| Adjoint of composition of projections. Special case of Theorem 3.11(viii) of [Beran] p. 106. (Contributed by NM, 6-Oct-2000.) (New usage is discouraged.)
theorem pjadjcoi (A2 B2 G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wceq (co (cfv A2 (ccom (cfv G cpjh) (cfv H cpjh))) B2 csp) (co A2 (cfv B2 (ccom (cfv H cpjh) (cfv G cpjh))) csp)) $;

--| Functionality of composition of projections. (Contributed by NM, 1-Oct-2000.) (New usage is discouraged.)
theorem pjcofni (G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wfn (ccom (cfv G cpjh) (cfv H cpjh)) chba $;

--| Subset relationship for projections. Theorem 4.5(i)<->(iii) of [Beran] p. 112. (Contributed by NM, 1-Oct-2000.) (New usage is discouraged.)
theorem pjss1coi (G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wb (wss G H) (wceq (ccom (cfv H cpjh) (cfv G cpjh)) (cfv G cpjh)) $;

--| Subset relationship for projections. Theorem 4.5(i)<->(ii) of [Beran] p. 112. (Contributed by NM, 7-Oct-2000.) (New usage is discouraged.)
theorem pjss2coi (G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wb (wss G H) (wceq (ccom (cfv G cpjh) (cfv H cpjh)) (cfv G cpjh)) $;

--| Projection meet property. Remark in [Kalmbach] p. 66. Also Theorem 4.5(i)->(iv) of [Beran] p. 112. (Contributed by NM, 26-Sep-2001.) (New usage is discouraged.)
theorem pjssmi (A2 G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wi (wcel A2 chba) (wi (wss H G) (wceq (co (cfv A2 (cfv G cpjh)) (cfv A2 (cfv H cpjh)) cmv) (cfv A2 (cfv (cin G (cfv H cort)) cpjh)))) $;

--| Theorem 4.5(iv)->(v) of [Beran] p. 112. (Contributed by NM, 26-Sep-2001.) (New usage is discouraged.)
theorem pjssge0i (A2 G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wi (wcel A2 chba) (wi (wceq (co (cfv A2 (cfv G cpjh)) (cfv A2 (cfv H cpjh)) cmv) (cfv A2 (cfv (cin G (cfv H cort)) cpjh))) (wbr cc0 (co (co (cfv A2 (cfv G cpjh)) (cfv A2 (cfv H cpjh)) cmv) A2 csp) cle)) $;

--| Theorem 4.5(v)<->(vi) of [Beran] p. 112. (Contributed by NM, 26-Sep-2001.) (New usage is discouraged.)
theorem pjdifnormi (A2 G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wi (wcel A2 chba) (wb (wbr cc0 (co (co (cfv A2 (cfv G cpjh)) (cfv A2 (cfv H cpjh)) cmv) A2 csp) cle) (wbr (cfv (cfv A2 (cfv H cpjh)) cno) (cfv (cfv A2 (cfv G cpjh)) cno) cle)) $;

--| Theorem 4.5(i)<->(vi) of [Beran] p. 112. (Contributed by NM, 26-Sep-2001.) (New usage is discouraged.)
theorem pjnormssi {x3: setvar} (G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wb (wss G H) (wral x3 (wbr (cfv (cfv (cv x3) (cfv G cpjh)) cno) (cfv (cfv (cv x3) (cfv H cpjh)) cno) cle) chba) $;

--| Composition of projections of orthogonal subspaces. Part (i)->(iia) of Theorem 27.4 of [Halmos] p. 45. (Contributed by NM, 6-Nov-2000.) (New usage is discouraged.)
theorem pjorthcoi (G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wi (wss G (cfv H cort)) (wceq (ccom (cfv G cpjh) (cfv H cpjh)) ch0o) $;

--| The projection of orthogonal subspaces is the sum of the projections. (Contributed by NM, 11-Nov-2000.) (New usage is discouraged.)
theorem pjscji (G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wi (wss G (cfv H cort)) (wceq (cfv (co G H chj) cpjh) (co (cfv G cpjh) (cfv H cpjh) chos)) $;

--| The projection on a subspace sum is the sum of the projections. (Contributed by NM, 11-Nov-2000.) (New usage is discouraged.)
theorem pjssumi (G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wi (wss G (cfv H cort)) (wceq (cfv (co G H cph) cpjh) (co (cfv G cpjh) (cfv H cpjh) chos)) $;

--| Projector ordering can be expressed by the subset relationship between their projection subspaces. (i)<->(iii) of Theorem 29.2 of [Halmos] p. 48. (Contributed by NM, 2-Jun-2006.) (New usage is discouraged.)
theorem pjssposi {x3: setvar} (G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wb (wral x3 (wbr cc0 (co (cfv (cv x3) (co (cfv H cpjh) (cfv G cpjh) chod)) (cv x3) csp) cle) chba) (wss G H) $;

--| The definition of projector ordering in [Halmos] p. 42 is equivalent to the definition of projector ordering in [Beran] p. 110. (We will usually express projector ordering with the even simpler equivalent ` G C_ H ` ; see ~ pjssposi ). (Contributed by NM, 2-Jun-2006.) (New usage is discouraged.)
theorem pjordi {x3: setvar} (G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wb (wral x3 (wbr cc0 (co (cfv (cv x3) (co (cfv H cpjh) (cfv G cpjh) chod)) (cv x3) csp) cle) chba) (wss (cima (cfv G cpjh) chba) (cima (cfv H cpjh) chba)) $;

--| The projection subspace of the difference between two projectors. Part 2 of Theorem 29.3 of [Halmos] p. 48 (shortened with ~ pjssposi ). (Contributed by NM, 2-Jun-2006.) (New usage is discouraged.)
theorem pjssdif2i (G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wb (wss G H) (wceq (co (cfv H cpjh) (cfv G cpjh) chod) (cfv (cin H (cfv G cort)) cpjh)) $;

--| A necessary and sufficient condition for the difference between two projectors to be a projector. Part 1 of Theorem 29.3 of [Halmos] p. 48 (shortened with ~ pjssposi ). (Contributed by NM, 2-Jun-2006.) (New usage is discouraged.)
theorem pjssdif1i (G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wb (wss G H) (wcel (co (cfv H cpjh) (cfv G cpjh) chod) (crn cpjh)) $;

--| The image of a projection. Lemma 5 in Daniel Lehmann, "A presentation of Quantum Logic based on an _and then_ connective", ~ https://doi.org/10.48550/arXiv.quant-ph/0701113 . (Contributed by NM, 20-Jan-2007.) (New usage is discouraged.)
theorem pjimai (A2 B2: class):
  $ wcel A2 csh $ >
  $ wcel B2 cch $ >
  $ wceq (cima (cfv B2 cpjh) A2) (cin (co A2 (cfv B2 cort) cph) B2) $;

--| A projection is idempotent. Property (ii) of [Beran] p. 109. (Contributed by NM, 1-Oct-2000.) (New usage is discouraged.)
theorem pjidmcoi (H: class):
  $ wcel H cch $ >
  $ wceq (ccom (cfv H cpjh) (cfv H cpjh)) (cfv H cpjh) $;

--| Composition of projections of a subspace and its orthocomplement. (Contributed by NM, 14-Nov-2000.) (New usage is discouraged.)
theorem pjoccoi (H: class):
  $ wcel H cch $ >
  $ wceq (ccom (cfv H cpjh) (cfv (cfv H cort) cpjh)) ch0o $;

--| Subspace sum of projection and projection of orthocomplement. (Contributed by NM, 16-Nov-2000.) (New usage is discouraged.)
theorem pjtoi (H: class):
  $ wcel H cch $ >
  $ wceq (co (cfv H cpjh) (cfv (cfv H cort) cpjh) chos) (cfv chba cpjh) $;

--| Projection of orthocomplement. First part of Theorem 27.3 of [Halmos] p. 45. (Contributed by NM, 26-Nov-2000.) (New usage is discouraged.)
theorem pjoci (H: class):
  $ wcel H cch $ >
  $ wceq (co (cfv chba cpjh) (cfv H cpjh) chod) (cfv (cfv H cort) cpjh) $;

--| A projection operator is idempotent. Property (ii) of [Beran] p. 109. (Contributed by NM, 24-Apr-2006.) (New usage is discouraged.)
theorem pjidmco (H: class):
  $ wi (wcel H cch) (wceq (ccom (cfv H cpjh) (cfv H cpjh)) (cfv H cpjh)) $;

--| Definition of projection operator in [Hughes] p. 47, except that we do not need linearity to be explicit by virtue of ~ hmoplin . (Contributed by NM, 24-Apr-2006.) (Revised by Mario Carneiro, 19-May-2014.) (New usage is discouraged.)
theorem dfpjop (T: class):
  $ wb (wcel T (crn cpjh)) (wa (wcel T cho) (wceq (ccom T T) T)) $;

--| Two ways to express the set of all projection operators. (Contributed by NM, 24-Apr-2006.) (Proof shortened by Mario Carneiro, 19-May-2014.) (New usage is discouraged.)
theorem pjhmopidm {t: setvar}:
  $ wceq (crn cpjh) (crab t (wceq (ccom (cv t) (cv t)) (cv t)) cho) $;

--| A projection operator is idempotent. Part of Theorem 26.1 of [Halmos] p. 43. (Contributed by NM, 24-Apr-2006.) (New usage is discouraged.)
theorem elpjidm (T: class):
  $ wi (wcel T (crn cpjh)) (wceq (ccom T T) T) $;

--| A projection operator is Hermitian. Part of Theorem 26.1 of [Halmos] p. 43. (Contributed by NM, 24-Apr-2006.) (New usage is discouraged.)
theorem elpjhmop (T: class):
  $ wi (wcel T (crn cpjh)) (wcel T cho) $;

--| A projector is a positive operator. (Contributed by NM, 27-Sep-2008.) (New usage is discouraged.)
theorem _0leopj (T: class):
  $ wi (wcel T (crn cpjh)) (wbr ch0o T cleo) $;

--| A projector is self-adjoint. Property (i) of [Beran] p. 109. (Contributed by NM, 3-Jun-2006.) (New usage is discouraged.)
theorem pjadj2 (T: class):
  $ wi (wcel T (crn cpjh)) (wceq (cfv T cado) T) $;

--| A projector is self-adjoint. Property (i) of [Beran] p. 109. (Contributed by NM, 20-Feb-2006.) (New usage is discouraged.)
theorem pjadj3 (H: class):
  $ wi (wcel H cch) (wceq (cfv (cfv H cpjh) cado) (cfv H cpjh)) $;

--| Reconstruction of the subspace of a projection operator. Part of Theorem 26.2 of [Halmos] p. 44. (Contributed by NM, 24-Apr-2006.) (New usage is discouraged.)
theorem elpjch (T: class):
  $ wi (wcel T (crn cpjh)) (wa (wcel (crn T) cch) (wceq T (cfv (crn T) cpjh))) $;

--| Reconstruction of the subspace of a projection operator. (Contributed by NM, 24-Apr-2006.) (Revised by Mario Carneiro, 19-May-2014.) (New usage is discouraged.)
theorem elpjrn {x3: setvar} (T: class):
  $ wi (wcel T (crn cpjh)) (wceq (crn T) (crab x3 (wceq (cfv (cv x3) T) (cv x3)) chba)) $;

--| A closed subspace ` H ` with projection ` T ` is invariant under an operator ` S ` iff ` S T = T S T ` . Theorem 27.1 of [Halmos] p. 45. (Contributed by NM, 24-Apr-2006.) (New usage is discouraged.)
theorem pjinvari (S T H: class):
  $ wf chba chba S $ >
  $ wcel H cch $ >
  $ wceq T (cfv H cpjh) $ >
  $ wb (wf chba H (ccom S T)) (wceq (ccom S T) (ccom T (ccom S T))) $;

--| Lemma for Theorem 1.22 of Mittelstaedt, p. 20. (Contributed by NM, 22-Apr-2001.) (New usage is discouraged.)
theorem pjin1i (G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wceq (cfv (cin G H) cpjh) (ccom (cfv G cpjh) (cfv (cin G H) cpjh)) $;

--| Lemma for Theorem 1.22 of Mittelstaedt, p. 20. (Contributed by NM, 22-Apr-2001.) (New usage is discouraged.)
theorem pjin2i (G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wb (wa (wceq (cfv G cpjh) (ccom (cfv G cpjh) (cfv H cpjh))) (wceq (cfv H cpjh) (ccom (cfv H cpjh) (cfv G cpjh)))) (wceq (cfv G cpjh) (cfv H cpjh)) $;

--| Lemma for Theorem 1.22 of Mittelstaedt, p. 20. (Contributed by NM, 22-Apr-2001.) (New usage is discouraged.)
theorem pjin3i (F G H: class):
  $ wcel F cch $ >
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wb (wa (wceq (cfv F cpjh) (ccom (cfv F cpjh) (cfv G cpjh))) (wceq (cfv F cpjh) (ccom (cfv F cpjh) (cfv H cpjh)))) (wceq (cfv F cpjh) (ccom (cfv F cpjh) (cfv (cin G H) cpjh))) $;

--| Lemma for projection commutation theorem. (Contributed by NM, 16-Nov-2000.) (New usage is discouraged.)
theorem pjclem1 (G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wi (wbr G H ccm) (wceq (ccom (cfv G cpjh) (cfv H cpjh)) (cfv (cin G H) cpjh)) $;

--| Lemma for projection commutation theorem. (Contributed by NM, 17-Nov-2000.) (New usage is discouraged.)
theorem pjclem2 (G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wi (wbr G H ccm) (wceq (ccom (cfv G cpjh) (cfv H cpjh)) (ccom (cfv H cpjh) (cfv G cpjh))) $;

--| Lemma for projection commutation theorem. (Contributed by NM, 26-Nov-2000.) (New usage is discouraged.)
theorem pjclem3 (G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wi (wceq (ccom (cfv G cpjh) (cfv H cpjh)) (ccom (cfv H cpjh) (cfv G cpjh))) (wceq (ccom (cfv G cpjh) (cfv (cfv H cort) cpjh)) (ccom (cfv (cfv H cort) cpjh) (cfv G cpjh))) $;

--| Lemma for projection commutation theorem. (Contributed by NM, 2-Dec-2000.) (New usage is discouraged.)
theorem pjclem4a (A2 G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wi (wcel A2 (cin G H)) (wceq (cfv A2 (ccom (cfv G cpjh) (cfv H cpjh))) A2) $;

--| Lemma for projection commutation theorem. (Contributed by NM, 26-Nov-2000.) (New usage is discouraged.)
theorem pjclem4 (G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wi (wceq (ccom (cfv G cpjh) (cfv H cpjh)) (ccom (cfv H cpjh) (cfv G cpjh))) (wceq (ccom (cfv G cpjh) (cfv H cpjh)) (cfv (cin G H) cpjh)) $;

--| Two subspaces commute iff their projections commute. Lemma 4 of [Kalmbach] p. 67. (Contributed by NM, 26-Nov-2000.) (New usage is discouraged.)
theorem pjci (G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wb (wbr G H ccm) (wceq (ccom (cfv G cpjh) (cfv H cpjh)) (ccom (cfv H cpjh) (cfv G cpjh))) $;

--| A necessary and sufficient condition for the product of two projectors to be a projector is that the projectors commute. Part 1 of Theorem 1 of [AkhiezerGlazman] p. 65. (Contributed by NM, 3-Jun-2006.) (New usage is discouraged.)
theorem pjcmul1i (G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wb (wceq (ccom (cfv G cpjh) (cfv H cpjh)) (ccom (cfv H cpjh) (cfv G cpjh))) (wcel (ccom (cfv G cpjh) (cfv H cpjh)) (crn cpjh)) $;

--| The projection subspace of the difference between two projectors. Part 2 of Theorem 1 of [AkhiezerGlazman] p. 65. (Contributed by NM, 3-Jun-2006.) (New usage is discouraged.)
theorem pjcmul2i (G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wb (wceq (ccom (cfv G cpjh) (cfv H cpjh)) (ccom (cfv H cpjh) (cfv G cpjh))) (wceq (ccom (cfv G cpjh) (cfv H cpjh)) (cfv (cin G H) cpjh)) $;

--| Closure of composition of projection and Hilbert space operator. (Contributed by NM, 3-Dec-2000.) (New usage is discouraged.)
theorem pjcohocli (A2 T H: class):
  $ wcel H cch $ >
  $ wf chba chba T $ >
  $ wi (wcel A2 chba) (wcel (cfv A2 (ccom (cfv H cpjh) T)) H) $;

--| Adjoint of double composition of projections. Generalization of special case of Theorem 3.11(viii) of [Beran] p. 106. (Contributed by NM, 1-Dec-2000.) (New usage is discouraged.)
theorem pjadj2coi (A2 B2 F G H: class):
  $ wcel F cch $ >
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wi (wa (wcel A2 chba) (wcel B2 chba)) (wceq (co (cfv A2 (ccom (ccom (cfv F cpjh) (cfv G cpjh)) (cfv H cpjh))) B2 csp) (co A2 (cfv B2 (ccom (ccom (cfv H cpjh) (cfv G cpjh)) (cfv F cpjh))) csp)) $;

--| Closure of double composition of projections. (Contributed by NM, 2-Dec-2000.) (New usage is discouraged.)
theorem pj2cocli (A2 F G H: class):
  $ wcel F cch $ >
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wi (wcel A2 chba) (wcel (cfv A2 (ccom (ccom (cfv F cpjh) (cfv G cpjh)) (cfv H cpjh))) F) $;

--| Lemma for projection triplet theorem. (Contributed by NM, 2-Dec-2000.) (New usage is discouraged.)
theorem pj3lem1 (A2 F G H: class):
  $ wcel F cch $ >
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wi (wcel A2 (cin (cin F G) H)) (wceq (cfv A2 (ccom (ccom (cfv F cpjh) (cfv G cpjh)) (cfv H cpjh))) A2) $;

--| Stronger projection triplet theorem. (Contributed by NM, 2-Dec-2000.) (New usage is discouraged.)
theorem pj3si (F G H: class):
  $ wcel F cch $ >
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wi (wa (wceq (ccom (ccom (cfv F cpjh) (cfv G cpjh)) (cfv H cpjh)) (ccom (ccom (cfv H cpjh) (cfv G cpjh)) (cfv F cpjh))) (wss (crn (ccom (ccom (cfv F cpjh) (cfv G cpjh)) (cfv H cpjh))) G)) (wceq (ccom (ccom (cfv F cpjh) (cfv G cpjh)) (cfv H cpjh)) (cfv (cin (cin F G) H) cpjh)) $;

--| Projection triplet theorem. (Contributed by NM, 2-Dec-2000.) (New usage is discouraged.)
theorem pj3i (F G H: class):
  $ wcel F cch $ >
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wi (wa (wceq (ccom (ccom (cfv F cpjh) (cfv G cpjh)) (cfv H cpjh)) (ccom (ccom (cfv H cpjh) (cfv G cpjh)) (cfv F cpjh))) (wceq (ccom (ccom (cfv F cpjh) (cfv G cpjh)) (cfv H cpjh)) (ccom (ccom (cfv G cpjh) (cfv F cpjh)) (cfv H cpjh)))) (wceq (ccom (ccom (cfv F cpjh) (cfv G cpjh)) (cfv H cpjh)) (cfv (cin (cin F G) H) cpjh)) $;

--| Projection triplet corollary. (Contributed by NM, 2-Dec-2000.) (New usage is discouraged.)
theorem pj3cor1i (F G H: class):
  $ wcel F cch $ >
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wi (wa (wceq (ccom (ccom (cfv F cpjh) (cfv G cpjh)) (cfv H cpjh)) (ccom (ccom (cfv H cpjh) (cfv G cpjh)) (cfv F cpjh))) (wceq (ccom (ccom (cfv F cpjh) (cfv G cpjh)) (cfv H cpjh)) (ccom (ccom (cfv G cpjh) (cfv F cpjh)) (cfv H cpjh)))) (wceq (ccom (ccom (cfv F cpjh) (cfv G cpjh)) (cfv H cpjh)) (ccom (ccom (cfv H cpjh) (cfv F cpjh)) (cfv G cpjh))) $;

--| Theorem S-14 of Watanabe, p. 486. (Contributed by NM, 26-Sep-2001.) (New usage is discouraged.)
theorem pjs14i (A2 G H: class):
  $ wcel G cch $ >
  $ wcel H cch $ >
  $ wi (wcel A2 chba) (wbr (cfv (cfv A2 (ccom (cfv H cpjh) (cfv G cpjh))) cno) (cfv (cfv A2 (cfv G cpjh)) cno) cle) $;

--| Define the set of states on a Hilbert lattice. Definition of [Kalmbach] p. 266. (Contributed by NM, 23-Oct-1999.) (New usage is discouraged.)
axiom df_st {x3 y1 f2: setvar}:
  $ wceq cst (crab f2 (wa (wceq (cfv chba (cv f2)) c1) (wral x3 (wral y1 (wi (wss (cv x3) (cfv (cv y1) cort)) (wceq (cfv (co (cv x3) (cv y1) chj) (cv f2)) (co (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) caddc))) cch) cch)) (co (co cc0 c1 cicc) cch cmap)) $;

--| Define the set of complex Hilbert-space-valued states on a Hilbert lattice. Definition of CH-states in [Mayet3] p. 9. (Contributed by NM, 25-Jun-2006.) (New usage is discouraged.)
axiom df_hst {x3 y1 f2: setvar}:
  $ wceq chst (crab f2 (wa (wceq (cfv (cfv chba (cv f2)) cno) c1) (wral x3 (wral y1 (wi (wss (cv x3) (cfv (cv y1) cort)) (wa (wceq (co (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) csp) cc0) (wceq (cfv (co (cv x3) (cv y1) chj) (cv f2)) (co (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) cva)))) cch) cch)) (co chba cch cmap)) $;

--| Property of a state. (Contributed by NM, 23-Oct-1999.) (Revised by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem isst {x3 y1: setvar} (S: class):
  $ wb (wcel S cst) (w3a (wf cch (co cc0 c1 cicc) S) (wceq (cfv chba S) c1) (wral x3 (wral y1 (wi (wss (cv x3) (cfv (cv y1) cort)) (wceq (cfv (co (cv x3) (cv y1) chj) S) (co (cfv (cv x3) S) (cfv (cv y1) S) caddc))) cch) cch)) $;

--| Property of a complex Hilbert-space-valued state. Definition of CH-states in [Mayet3] p. 9. (Contributed by NM, 25-Jun-2006.) (New usage is discouraged.)
theorem ishst {x3 y1: setvar} (S: class):
  $ wb (wcel S chst) (w3a (wf cch chba S) (wceq (cfv (cfv chba S) cno) c1) (wral x3 (wral y1 (wi (wss (cv x3) (cfv (cv y1) cort)) (wa (wceq (co (cfv (cv x3) S) (cfv (cv y1) S) csp) cc0) (wceq (cfv (co (cv x3) (cv y1) chj) S) (co (cfv (cv x3) S) (cfv (cv y1) S) cva)))) cch) cch)) $;

--| ` [ 0 , 1 ] ` closure of the value of a state. (Contributed by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem sticl (A2 S: class):
  $ wi (wcel S cst) (wi (wcel A2 cch) (wcel (cfv A2 S) (co cc0 c1 cicc))) $;

--| Real closure of the value of a state. (Contributed by NM, 24-Oct-1999.) (Revised by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem stcl (A2 S: class):
  $ wi (wcel S cst) (wi (wcel A2 cch) (wcel (cfv A2 S) cr)) $;

--| Closure of the value of a Hilbert-space-valued state. (Contributed by NM, 25-Jun-2006.) (New usage is discouraged.)
theorem hstcl (A2 S: class):
  $ wi (wa (wcel S chst) (wcel A2 cch)) (wcel (cfv A2 S) chba) $;

--| Unit value of a Hilbert-space-valued state. (Contributed by NM, 25-Jun-2006.) (New usage is discouraged.)
theorem hst1a (S: class):
  $ wi (wcel S chst) (wceq (cfv (cfv chba S) cno) c1) $;

--| Properties of a Hilbert-space-valued state. (Contributed by NM, 25-Jun-2006.) (New usage is discouraged.)
theorem hstel2 (A2 B2 S: class):
  $ wi (wa (wa (wcel S chst) (wcel A2 cch)) (wa (wcel B2 cch) (wss A2 (cfv B2 cort)))) (wa (wceq (co (cfv A2 S) (cfv B2 S) csp) cc0) (wceq (cfv (co A2 B2 chj) S) (co (cfv A2 S) (cfv B2 S) cva))) $;

--| Orthogonality property of a Hilbert-space-valued state. This is a key feature distinguishing it from a real-valued state. (Contributed by NM, 25-Jun-2006.) (New usage is discouraged.)
theorem hstorth (A2 B2 S: class):
  $ wi (wa (wa (wcel S chst) (wcel A2 cch)) (wa (wcel B2 cch) (wss A2 (cfv B2 cort)))) (wceq (co (cfv A2 S) (cfv B2 S) csp) cc0) $;

--| Orthogonal sum property of a Hilbert-space-valued state. (Contributed by NM, 25-Jun-2006.) (New usage is discouraged.)
theorem hstosum (A2 B2 S: class):
  $ wi (wa (wa (wcel S chst) (wcel A2 cch)) (wa (wcel B2 cch) (wss A2 (cfv B2 cort)))) (wceq (cfv (co A2 B2 chj) S) (co (cfv A2 S) (cfv B2 S) cva)) $;

--| Sum of a Hilbert-space-valued state of a lattice element and its orthocomplement. (Contributed by NM, 25-Jun-2006.) (New usage is discouraged.)
theorem hstoc (A2 S: class):
  $ wi (wa (wcel S chst) (wcel A2 cch)) (wceq (co (cfv A2 S) (cfv (cfv A2 cort) S) cva) (cfv chba S)) $;

--| Sum of norms of a Hilbert-space-valued state. (Contributed by NM, 25-Jun-2006.) (New usage is discouraged.)
theorem hstnmoc (A2 S: class):
  $ wi (wa (wcel S chst) (wcel A2 cch)) (wceq (co (co (cfv (cfv A2 S) cno) c2 cexp) (co (cfv (cfv (cfv A2 cort) S) cno) c2 cexp) caddc) c1) $;

--| The value of a state is nonnegative. (Contributed by NM, 24-Oct-1999.) (Revised by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem stge0 (A2 S: class):
  $ wi (wcel S cst) (wi (wcel A2 cch) (wbr cc0 (cfv A2 S) cle)) $;

--| The value of a state is less than or equal to one. (Contributed by NM, 24-Oct-1999.) (Revised by Mario Carneiro, 23-Dec-2013.) (New usage is discouraged.)
theorem stle1 (A2 S: class):
  $ wi (wcel S cst) (wi (wcel A2 cch) (wbr (cfv A2 S) c1 cle)) $;

--| The norm of the value of a Hilbert-space-valued state is less than or equal to one. (Contributed by NM, 25-Jun-2006.) (New usage is discouraged.)
theorem hstle1 (A2 S: class):
  $ wi (wa (wcel S chst) (wcel A2 cch)) (wbr (cfv (cfv A2 S) cno) c1 cle) $;

--| The norm of a Hilbert-space-valued state equals one iff the state value equals the state value of the lattice one. (Contributed by NM, 25-Jun-2006.) (New usage is discouraged.)
theorem hst1h (A2 S: class):
  $ wi (wa (wcel S chst) (wcel A2 cch)) (wb (wceq (cfv (cfv A2 S) cno) c1) (wceq (cfv A2 S) (cfv chba S))) $;

--| The norm of a Hilbert-space-valued state equals zero iff the state value equals zero. (Contributed by NM, 30-Jun-2006.) (New usage is discouraged.)
theorem hst0h (A2 S: class):
  $ wi (wa (wcel S chst) (wcel A2 cch)) (wb (wceq (cfv (cfv A2 S) cno) cc0) (wceq (cfv A2 S) c0v)) $;

--| Pythagorean property of a Hilbert-space-valued state for orthogonal vectors ` A ` and ` B ` . (Contributed by NM, 26-Jun-2006.) (New usage is discouraged.)
theorem hstpyth (A2 B2 S: class):
  $ wi (wa (wa (wcel S chst) (wcel A2 cch)) (wa (wcel B2 cch) (wss A2 (cfv B2 cort)))) (wceq (co (cfv (cfv (co A2 B2 chj) S) cno) c2 cexp) (co (co (cfv (cfv A2 S) cno) c2 cexp) (co (cfv (cfv B2 S) cno) c2 cexp) caddc)) $;

--| Ordering property of a Hilbert-space-valued state. (Contributed by NM, 26-Jun-2006.) (New usage is discouraged.)
theorem hstle (A2 B2 S: class):
  $ wi (wa (wa (wcel S chst) (wcel A2 cch)) (wa (wcel B2 cch) (wss A2 B2))) (wbr (cfv (cfv A2 S) cno) (cfv (cfv B2 S) cno) cle) $;

--| Ordering property of a Hilbert-space-valued state. (Contributed by NM, 30-Jun-2006.) (New usage is discouraged.)
theorem hstles (A2 B2 S: class):
  $ wi (wa (wa (wcel S chst) (wcel A2 cch)) (wa (wcel B2 cch) (wss A2 B2))) (wi (wceq (cfv (cfv A2 S) cno) c1) (wceq (cfv (cfv B2 S) cno) c1)) $;

--| A Hilbert-space-valued state orthogonal to the state of the lattice one is zero. (Contributed by NM, 25-Jun-2006.) (New usage is discouraged.)
theorem hstoh (A2 S: class):
  $ wi (w3a (wcel S chst) (wcel A2 cch) (wceq (co (cfv A2 S) (cfv chba S) csp) cc0)) (wceq (cfv A2 S) c0v) $;

--| A Hilbert-space-valued state is zero at the zero subspace. (Contributed by NM, 30-Jun-2006.) (New usage is discouraged.)
theorem hst0 (S: class):
  $ wi (wcel S chst) (wceq (cfv c0h S) c0v) $;

--| The value of a state at the full Hilbert space. (Contributed by NM, 23-Oct-1999.) (New usage is discouraged.)
theorem sthil (S: class):
  $ wi (wcel S cst) (wceq (cfv chba S) c1) $;

--| The value of a state on a join. (Contributed by NM, 23-Oct-1999.) (New usage is discouraged.)
theorem stj (A2 B2 S: class):
  $ wi (wcel S cst) (wi (wa (wa (wcel A2 cch) (wcel B2 cch)) (wss A2 (cfv B2 cort))) (wceq (cfv (co A2 B2 chj) S) (co (cfv A2 S) (cfv B2 S) caddc))) $;

--| The state of a subspace plus the state of its orthocomplement. (Contributed by NM, 24-Oct-1999.) (New usage is discouraged.)
theorem sto1i (A2 S: class):
  $ wcel A2 cch $ >
  $ wi (wcel S cst) (wceq (co (cfv A2 S) (cfv (cfv A2 cort) S) caddc) c1) $;

--| The state of the orthocomplement. (Contributed by NM, 24-Oct-1999.) (New usage is discouraged.)
theorem sto2i (A2 S: class):
  $ wcel A2 cch $ >
  $ wi (wcel S cst) (wceq (cfv (cfv A2 cort) S) (co c1 (cfv A2 S) cmin)) $;

--| If a state is greater than or equal to 1, it is 1. (Contributed by NM, 11-Nov-1999.) (New usage is discouraged.)
theorem stge1i (A2 S: class):
  $ wcel A2 cch $ >
  $ wi (wcel S cst) (wb (wbr c1 (cfv A2 S) cle) (wceq (cfv A2 S) c1)) $;

--| If a state is less than or equal to 0, it is 0. (Contributed by NM, 11-Nov-1999.) (New usage is discouraged.)
theorem stle0i (A2 S: class):
  $ wcel A2 cch $ >
  $ wi (wcel S cst) (wb (wbr (cfv A2 S) cc0 cle) (wceq (cfv A2 S) cc0)) $;

--| Ordering law for states. (Contributed by NM, 24-Oct-1999.) (New usage is discouraged.)
theorem stlei (A2 B2 S: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi (wcel S cst) (wi (wss A2 B2) (wbr (cfv A2 S) (cfv B2 S) cle)) $;

--| Ordering law for states. (Contributed by NM, 24-Oct-1999.) (New usage is discouraged.)
theorem stlesi (A2 B2 S: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi (wcel S cst) (wi (wss A2 B2) (wi (wceq (cfv A2 S) c1) (wceq (cfv B2 S) c1))) $;

--| Join of components of Sasaki arrow ->1. (Contributed by NM, 24-Oct-1999.) (New usage is discouraged.)
theorem stji1i (A2 B2 S: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi (wcel S cst) (wceq (cfv (co (cfv A2 cort) (cin A2 B2) chj) S) (co (cfv (cfv A2 cort) S) (cfv (cin A2 B2) S) caddc)) $;

--| State of component of unit meet. (Contributed by NM, 11-Nov-1999.) (New usage is discouraged.)
theorem stm1i (A2 B2 S: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi (wcel S cst) (wi (wceq (cfv (cin A2 B2) S) c1) (wceq (cfv A2 S) c1)) $;

--| State of component of unit meet. (Contributed by NM, 11-Nov-1999.) (New usage is discouraged.)
theorem stm1ri (A2 B2 S: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi (wcel S cst) (wi (wceq (cfv (cin A2 B2) S) c1) (wceq (cfv B2 S) c1)) $;

--| Sum of states whose meet is 1. (Contributed by NM, 11-Nov-1999.) (New usage is discouraged.)
theorem stm1addi (A2 B2 S: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi (wcel S cst) (wi (wceq (cfv (cin A2 B2) S) c1) (wceq (co (cfv A2 S) (cfv B2 S) caddc) c2)) $;

--| If the sum of 2 states is 2, then each state is 1. (Contributed by NM, 12-Nov-1999.) (New usage is discouraged.)
theorem staddi (A2 B2 S: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi (wcel S cst) (wi (wceq (co (cfv A2 S) (cfv B2 S) caddc) c2) (wceq (cfv A2 S) c1)) $;

--| Sum of states whose meet is 1. (Contributed by NM, 11-Nov-1999.) (New usage is discouraged.)
theorem stm1add3i (A2 B2 C S: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wi (wcel S cst) (wi (wceq (cfv (cin (cin A2 B2) C) S) c1) (wceq (co (co (cfv A2 S) (cfv B2 S) caddc) (cfv C S) caddc) c3)) $;

--| If the sum of 3 states is 3, then each state is 1. (Contributed by NM, 13-Nov-1999.) (New usage is discouraged.)
theorem stadd3i (A2 B2 C S: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wi (wcel S cst) (wi (wceq (co (co (cfv A2 S) (cfv B2 S) caddc) (cfv C S) caddc) c3) (wceq (cfv A2 S) c1)) $;

--| The state of the zero subspace. (Contributed by NM, 24-Oct-1999.) (New usage is discouraged.)
theorem st0 (S: class):
  $ wi (wcel S cst) (wceq (cfv c0h S) cc0) $;

--| Lemma for strong state theorem: if closed subspace ` A ` is not contained in ` B ` , there is a unit vector ` u ` in their difference. (Contributed by NM, 25-Oct-1999.) (New usage is discouraged.)
theorem strlem1 {u: setvar} (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi (wn (wss A2 B2)) (wrex u (wceq (cfv (cv u) cno) c1) (cdif A2 B2)) $;

--| Lemma for strong state theorem. (Contributed by NM, 28-Oct-1999.) (New usage is discouraged.)
theorem strlem2 {x3 u: setvar} (C: class u) (S: class x3 u):
  $ wceq S (cmpt x3 cch (co (cfv (cfv (cv u) (cfv (cv x3) cpjh)) cno) c2 cexp)) $ >
  $ wi (wcel C cch) (wceq (cfv C S) (co (cfv (cfv (cv u) (cfv C cpjh)) cno) c2 cexp)) $;

--| Lemma for strong state theorem: the function ` S ` , that maps a closed subspace to the square of the norm of its projection onto a unit vector, is a state. (Contributed by NM, 28-Oct-1999.) (New usage is discouraged.)
theorem strlem3a {x3 u: setvar} (S: class x3 u):
  $ wceq S (cmpt x3 cch (co (cfv (cfv (cv u) (cfv (cv x3) cpjh)) cno) c2 cexp)) $ >
  $ wi (wa (wcel (cv u) chba) (wceq (cfv (cv u) cno) c1)) (wcel S cst) $;

--| Lemma for strong state theorem: the function ` S ` , that maps a closed subspace to the square of the norm of its projection onto a unit vector, is a state. This lemma restates the hypotheses in a more convenient form to work with. (Contributed by NM, 28-Oct-1999.) (New usage is discouraged.)
theorem strlem3 {x3 u: setvar} (ph: wff u) (A2 B2: class u) (S: class x3 u):
  $ wceq S (cmpt x3 cch (co (cfv (cfv (cv u) (cfv (cv x3) cpjh)) cno) c2 cexp)) $ >
  $ wb ph (wa (wcel (cv u) (cdif A2 B2)) (wceq (cfv (cv u) cno) c1)) $ >
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi ph (wcel S cst) $;

--| Lemma for strong state theorem. (Contributed by NM, 2-Nov-1999.) (New usage is discouraged.)
theorem strlem4 {x3 u: setvar} (ph: wff u) (A2 B2: class u) (S: class x3 u):
  $ wceq S (cmpt x3 cch (co (cfv (cfv (cv u) (cfv (cv x3) cpjh)) cno) c2 cexp)) $ >
  $ wb ph (wa (wcel (cv u) (cdif A2 B2)) (wceq (cfv (cv u) cno) c1)) $ >
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi ph (wceq (cfv A2 S) c1) $;

--| Lemma for strong state theorem. (Contributed by NM, 2-Nov-1999.) (New usage is discouraged.)
theorem strlem5 {x3 u: setvar} (ph: wff u) (A2 B2: class u) (S: class x3 u):
  $ wceq S (cmpt x3 cch (co (cfv (cfv (cv u) (cfv (cv x3) cpjh)) cno) c2 cexp)) $ >
  $ wb ph (wa (wcel (cv u) (cdif A2 B2)) (wceq (cfv (cv u) cno) c1)) $ >
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi ph (wbr (cfv B2 S) c1 clt) $;

--| Lemma for strong state theorem. (Contributed by NM, 2-Nov-1999.) (New usage is discouraged.)
theorem strlem6 {x3 u: setvar} (ph: wff u) (A2 B2: class u) (S: class x3 u):
  $ wceq S (cmpt x3 cch (co (cfv (cfv (cv u) (cfv (cv x3) cpjh)) cno) c2 cexp)) $ >
  $ wb ph (wa (wcel (cv u) (cdif A2 B2)) (wceq (cfv (cv u) cno) c1)) $ >
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi ph (wn (wi (wceq (cfv A2 S) c1) (wceq (cfv B2 S) c1))) $;

--| Strong state theorem. The states on a Hilbert lattice define an ordering. Remark in [Mayet] p. 370. (Contributed by NM, 2-Nov-1999.) (New usage is discouraged.)
theorem stri {f2: setvar} (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi (wral f2 (wi (wceq (cfv A2 (cv f2)) c1) (wceq (cfv B2 (cv f2)) c1)) cst) (wss A2 B2) $;

--| Strong state theorem (bidirectional version). (Contributed by NM, 7-Apr-2001.) (New usage is discouraged.)
theorem strb {f2: setvar} (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wral f2 (wi (wceq (cfv A2 (cv f2)) c1) (wceq (cfv B2 (cv f2)) c1)) cst) (wss A2 B2) $;

--| Lemma for strong set of CH states theorem. (Contributed by NM, 30-Jun-2006.) (New usage is discouraged.)
theorem hstrlem2 {x3 u: setvar} (C: class u) (S: class x3 u):
  $ wceq S (cmpt x3 cch (cfv (cv u) (cfv (cv x3) cpjh))) $ >
  $ wi (wcel C cch) (wceq (cfv C S) (cfv (cv u) (cfv C cpjh))) $;

--| Lemma for strong set of CH states theorem: the function ` S ` , that maps a closed subspace to the square of the norm of its projection onto a unit vector, is a state. (Contributed by NM, 30-Jun-2006.) (New usage is discouraged.)
theorem hstrlem3a {x3 u: setvar} (S: class x3 u):
  $ wceq S (cmpt x3 cch (cfv (cv u) (cfv (cv x3) cpjh))) $ >
  $ wi (wa (wcel (cv u) chba) (wceq (cfv (cv u) cno) c1)) (wcel S chst) $;

--| Lemma for strong set of CH states theorem: the function ` S ` , that maps a closed subspace to the square of the norm of its projection onto a unit vector, is a state. This lemma restates the hypotheses in a more convenient form to work with. (Contributed by NM, 30-Jun-2006.) (New usage is discouraged.)
theorem hstrlem3 {x3 u: setvar} (ph: wff u) (A2 B2: class u) (S: class x3 u):
  $ wceq S (cmpt x3 cch (cfv (cv u) (cfv (cv x3) cpjh))) $ >
  $ wb ph (wa (wcel (cv u) (cdif A2 B2)) (wceq (cfv (cv u) cno) c1)) $ >
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi ph (wcel S chst) $;

--| Lemma for strong set of CH states theorem. (Contributed by NM, 30-Jun-2006.) (New usage is discouraged.)
theorem hstrlem4 {x3 u: setvar} (ph: wff u) (A2 B2: class u) (S: class x3 u):
  $ wceq S (cmpt x3 cch (cfv (cv u) (cfv (cv x3) cpjh))) $ >
  $ wb ph (wa (wcel (cv u) (cdif A2 B2)) (wceq (cfv (cv u) cno) c1)) $ >
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi ph (wceq (cfv (cfv A2 S) cno) c1) $;

--| Lemma for strong set of CH states theorem. (Contributed by NM, 30-Jun-2006.) (New usage is discouraged.)
theorem hstrlem5 {x3 u: setvar} (ph: wff u) (A2 B2: class u) (S: class x3 u):
  $ wceq S (cmpt x3 cch (cfv (cv u) (cfv (cv x3) cpjh))) $ >
  $ wb ph (wa (wcel (cv u) (cdif A2 B2)) (wceq (cfv (cv u) cno) c1)) $ >
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi ph (wbr (cfv (cfv B2 S) cno) c1 clt) $;

--| Lemma for strong set of CH states theorem. (Contributed by NM, 30-Jun-2006.) (New usage is discouraged.)
theorem hstrlem6 {x3 u: setvar} (ph: wff u) (A2 B2: class u) (S: class x3 u):
  $ wceq S (cmpt x3 cch (cfv (cv u) (cfv (cv x3) cpjh))) $ >
  $ wb ph (wa (wcel (cv u) (cdif A2 B2)) (wceq (cfv (cv u) cno) c1)) $ >
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi ph (wn (wi (wceq (cfv (cfv A2 S) cno) c1) (wceq (cfv (cfv B2 S) cno) c1))) $;

--| Hilbert space admits a strong set of Hilbert-space-valued states (CH-states). Theorem in [Mayet3] p. 10. (Contributed by NM, 30-Jun-2006.) (New usage is discouraged.)
theorem hstri {f2: setvar} (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi (wral f2 (wi (wceq (cfv (cfv A2 (cv f2)) cno) c1) (wceq (cfv (cfv B2 (cv f2)) cno) c1)) chst) (wss A2 B2) $;

--| Strong CH-state theorem (bidirectional version). Theorem in [Mayet3] p. 10 and its converse. (Contributed by NM, 30-Jun-2006.) (New usage is discouraged.)
theorem hstrbi {f2: setvar} (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wral f2 (wi (wceq (cfv (cfv A2 (cv f2)) cno) c1) (wceq (cfv (cfv B2 (cv f2)) cno) c1)) chst) (wss A2 B2) $;

--| A Hilbert lattice admits a largei set of states. Remark in [Mayet] p. 370. (Contributed by NM, 7-Apr-2001.) (New usage is discouraged.)
theorem largei {f2: setvar} (A2: class):
  $ wcel A2 cch $ >
  $ wb (wn (wceq A2 c0h)) (wrex f2 (wceq (cfv A2 (cv f2)) c1) cst) $;

--| Lemma for Jauch-Piron theorem. (Contributed by NM, 8-Apr-2001.) (New usage is discouraged.)
theorem jplem1 (u: setvar) (A2: class):
  $ wcel A2 cch $ >
  $ wi (wa (wcel (cv u) chba) (wceq (cfv (cv u) cno) c1)) (wb (wcel (cv u) A2) (wceq (co (cfv (cfv (cv u) (cfv A2 cpjh)) cno) c2 cexp) c1)) $;

--| Lemma for Jauch-Piron theorem. (Contributed by NM, 8-Apr-2001.) (New usage is discouraged.)
theorem jplem2 {x3 u: setvar} (A2: class u) (S: class x3 u):
  $ wceq S (cmpt x3 cch (co (cfv (cfv (cv u) (cfv (cv x3) cpjh)) cno) c2 cexp)) $ >
  $ wcel A2 cch $ >
  $ wi (wa (wcel (cv u) chba) (wceq (cfv (cv u) cno) c1)) (wb (wcel (cv u) A2) (wceq (cfv A2 S) c1)) $;

--| The function ` S ` , that maps a closed subspace to the square of the norm of its projection onto a unit vector, is a Jauch-Piron state. Remark in [Mayet] p. 370. (See ~ strlem3a for the proof that ` S ` is a state.) (Contributed by NM, 8-Apr-2001.) (New usage is discouraged.)
theorem jpi {x3 u: setvar} (A2 B2: class u) (S: class x3 u):
  $ wceq S (cmpt x3 cch (co (cfv (cfv (cv u) (cfv (cv x3) cpjh)) cno) c2 cexp)) $ >
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi (wa (wcel (cv u) chba) (wceq (cfv (cv u) cno) c1)) (wb (wa (wceq (cfv A2 S) c1) (wceq (cfv B2 S) c1)) (wceq (cfv (cin A2 B2) S) c1)) $;

--| Lemma for Godowski's equation. (Contributed by NM, 10-Nov-2002.) (New usage is discouraged.)
theorem golem1 (A2 B2 C D R S: class) (f2: setvar) (F G H: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wceq F (co (cfv A2 cort) (cin A2 B2) chj) $ >
  $ wceq G (co (cfv B2 cort) (cin B2 C) chj) $ >
  $ wceq H (co (cfv C cort) (cin C A2) chj) $ >
  $ wceq D (co (cfv B2 cort) (cin B2 A2) chj) $ >
  $ wceq R (co (cfv C cort) (cin C B2) chj) $ >
  $ wceq S (co (cfv A2 cort) (cin A2 C) chj) $ >
  $ wi (wcel (cv f2) cst) (wceq (co (co (cfv F (cv f2)) (cfv G (cv f2)) caddc) (cfv H (cv f2)) caddc) (co (co (cfv D (cv f2)) (cfv R (cv f2)) caddc) (cfv S (cv f2)) caddc)) $;

--| Lemma for Godowski's equation. (Contributed by NM, 13-Nov-1999.) (New usage is discouraged.)
theorem golem2 (A2 B2 C D R S: class) (f2: setvar) (F G H: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wceq F (co (cfv A2 cort) (cin A2 B2) chj) $ >
  $ wceq G (co (cfv B2 cort) (cin B2 C) chj) $ >
  $ wceq H (co (cfv C cort) (cin C A2) chj) $ >
  $ wceq D (co (cfv B2 cort) (cin B2 A2) chj) $ >
  $ wceq R (co (cfv C cort) (cin C B2) chj) $ >
  $ wceq S (co (cfv A2 cort) (cin A2 C) chj) $ >
  $ wi (wcel (cv f2) cst) (wi (wceq (cfv (cin (cin F G) H) (cv f2)) c1) (wceq (cfv D (cv f2)) c1)) $;

--| Godowski's equation, shown here as a variant equivalent to Equation SF of [Godowski] p. 730. (Contributed by NM, 10-Nov-2002.) (New usage is discouraged.)
theorem goeqi (A2 B2 C D F G H: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wceq F (co (cfv A2 cort) (cin A2 B2) chj) $ >
  $ wceq G (co (cfv B2 cort) (cin B2 C) chj) $ >
  $ wceq H (co (cfv C cort) (cin C A2) chj) $ >
  $ wceq D (co (cfv B2 cort) (cin B2 A2) chj) $ >
  $ wss (cin (cin F G) H) D $;

--| Property of a strong classical state. (Contributed by NM, 24-Oct-1999.) (New usage is discouraged.)
theorem stcltr1i {x3 y1: setvar} (ph: wff x3 y1) (A2 B2 S: class):
  $ wb ph (wa (wcel S cst) (wral x3 (wral y1 (wi (wi (wceq (cfv (cv x3) S) c1) (wceq (cfv (cv y1) S) c1)) (wss (cv x3) (cv y1))) cch) cch)) $ >
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi ph (wi (wi (wceq (cfv A2 S) c1) (wceq (cfv B2 S) c1)) (wss A2 B2)) $;

--| Property of a strong classical state. (Contributed by NM, 24-Oct-1999.) (New usage is discouraged.)
theorem stcltr2i {x3 y1: setvar} (ph: wff x3 y1) (A2 S: class):
  $ wb ph (wa (wcel S cst) (wral x3 (wral y1 (wi (wi (wceq (cfv (cv x3) S) c1) (wceq (cfv (cv y1) S) c1)) (wss (cv x3) (cv y1))) cch) cch)) $ >
  $ wcel A2 cch $ >
  $ wi ph (wi (wceq (cfv A2 S) c1) (wceq A2 chba)) $;

--| Lemma for strong classical state theorem. (Contributed by NM, 24-Oct-1999.) (New usage is discouraged.)
theorem stcltrlem1 {x3 y1: setvar} (ph: wff x3 y1) (A2 B2 S: class):
  $ wb ph (wa (wcel S cst) (wral x3 (wral y1 (wi (wi (wceq (cfv (cv x3) S) c1) (wceq (cfv (cv y1) S) c1)) (wss (cv x3) (cv y1))) cch) cch)) $ >
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi ph (wi (wceq (cfv B2 S) c1) (wceq (cfv (co (cfv A2 cort) (cin A2 B2) chj) S) c1)) $;

--| Lemma for strong classical state theorem. (Contributed by NM, 24-Oct-1999.) (New usage is discouraged.)
theorem stcltrlem2 {x3 y1: setvar} (ph: wff x3 y1) (A2 B2 S: class):
  $ wb ph (wa (wcel S cst) (wral x3 (wral y1 (wi (wi (wceq (cfv (cv x3) S) c1) (wceq (cfv (cv y1) S) c1)) (wss (cv x3) (cv y1))) cch) cch)) $ >
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi ph (wss B2 (co (cfv A2 cort) (cin A2 B2) chj)) $;

--| Theorem for classically strong set of states. If there exists a "classically strong set of states" on lattice ` CH ` (or actually any ortholattice, which would have an identical proof), then any two elements of the lattice commute, i.e., the lattice is distributive. (Proof due to Mladen Pavicic.) Theorem 3.3 of [MegPav2000] p. 2344. (Contributed by NM, 24-Oct-1999.) (New usage is discouraged.)
theorem stcltrthi {x3 y1 s1: setvar} (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wrex s1 (wral x3 (wral y1 (wi (wi (wceq (cfv (cv x3) (cv s1)) c1) (wceq (cfv (cv y1) (cv s1)) c1)) (wss (cv x3) (cv y1))) cch) cch) cst $ >
  $ wss B2 (co (cfv A2 cort) (cin A2 B2) chj) $;

--| Define the covers relation (on the Hilbert lattice). Definition 3.2.18 of [PtakPulmannova] p. 68, whose notation we use. Ptak/Pulmannova's notation ` A <oH B ` is read " ` B ` covers ` A ` " or " ` A ` is covered by ` B ` " , and it means that ` B ` is larger than ` A ` and there is nothing in between. See ~ cvbr and ~ cvbr2 for membership relations. (Contributed by NM, 4-Jun-2004.) (New usage is discouraged.)
axiom df_cv {x3 y1 z: setvar}:
  $ wceq ccv (copab x3 y1 (wa (wa (wcel (cv x3) cch) (wcel (cv y1) cch)) (wa (wpss (cv x3) (cv y1)) (wn (wrex z (wa (wpss (cv x3) (cv z)) (wpss (cv z) (cv y1))) cch))))) $;

--| Define the modular pair relation (on the Hilbert lattice). Definition 1.1 of [MaedaMaeda] p. 1, who use the notation (x,y)M for "the ordered pair <x,y> is a modular pair." See ~ mdbr for membership relation. (Contributed by NM, 14-Jun-2004.) (New usage is discouraged.)
axiom df_md {x3 y1 z: setvar}:
  $ wceq cmd (copab x3 y1 (wa (wa (wcel (cv x3) cch) (wcel (cv y1) cch)) (wral z (wi (wss (cv z) (cv y1)) (wceq (cin (co (cv z) (cv x3) chj) (cv y1)) (co (cv z) (cin (cv x3) (cv y1)) chj))) cch))) $;

--| Define the dual modular pair relation (on the Hilbert lattice). Definition 1.1 of [MaedaMaeda] p. 1, who use the notation (x,y)M* for "the ordered pair <x,y> is a dual modular pair." See ~ dmdbr for membership relation. (Contributed by NM, 27-Apr-2006.) (New usage is discouraged.)
axiom df_dmd {x3 y1 z: setvar}:
  $ wceq cdmd (copab x3 y1 (wa (wa (wcel (cv x3) cch) (wcel (cv y1) cch)) (wral z (wi (wss (cv y1) (cv z)) (wceq (co (cin (cv z) (cv x3)) (cv y1) chj) (cin (cv z) (co (cv x3) (cv y1) chj)))) cch))) $;

--| Binary relation expressing ` B ` covers ` A ` , which means that ` B ` is larger than ` A ` and there is nothing in between. Definition 3.2.18 of [PtakPulmannova] p. 68. (Contributed by NM, 4-Jun-2004.) (New usage is discouraged.)
theorem cvbr {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wbr A2 B2 ccv) (wa (wpss A2 B2) (wn (wrex x3 (wa (wpss A2 (cv x3)) (wpss (cv x3) B2)) cch)))) $;

--| Binary relation expressing ` B ` covers ` A ` . Definition of covers in [Kalmbach] p. 15. (Contributed by NM, 9-Jun-2004.) (New usage is discouraged.)
theorem cvbr2 {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wbr A2 B2 ccv) (wa (wpss A2 B2) (wral x3 (wi (wa (wpss A2 (cv x3)) (wss (cv x3) B2)) (wceq (cv x3) B2)) cch))) $;

--| Contraposition law for the covers relation. (Contributed by NM, 12-Jun-2004.) (New usage is discouraged.)
theorem cvcon3 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wbr A2 B2 ccv) (wbr (cfv B2 cort) (cfv A2 cort) ccv)) $;

--| The covers relation implies proper subset. (Contributed by NM, 10-Jun-2004.) (New usage is discouraged.)
theorem cvpss (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wi (wbr A2 B2 ccv) (wpss A2 B2)) $;

--| The covers relation implies no in-betweenness. (Contributed by NM, 12-Jun-2004.) (New usage is discouraged.)
theorem cvnbtwn (A2 B2 C: class):
  $ wi (w3a (wcel A2 cch) (wcel B2 cch) (wcel C cch)) (wi (wbr A2 B2 ccv) (wn (wa (wpss A2 C) (wpss C B2)))) $;

--| The covers relation implies no in-betweenness. (Contributed by NM, 12-Jun-2004.) (New usage is discouraged.)
theorem cvnbtwn2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cch) (wcel B2 cch) (wcel C cch)) (wi (wbr A2 B2 ccv) (wi (wa (wpss A2 C) (wss C B2)) (wceq C B2))) $;

--| The covers relation implies no in-betweenness. (Contributed by NM, 12-Jun-2004.) (New usage is discouraged.)
theorem cvnbtwn3 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cch) (wcel B2 cch) (wcel C cch)) (wi (wbr A2 B2 ccv) (wi (wa (wss A2 C) (wpss C B2)) (wceq C A2))) $;

--| The covers relation implies no in-betweenness. Part of proof of Lemma 7.5.1 of [MaedaMaeda] p. 31. (Contributed by NM, 12-Jun-2004.) (New usage is discouraged.)
theorem cvnbtwn4 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cch) (wcel B2 cch) (wcel C cch)) (wi (wbr A2 B2 ccv) (wi (wa (wss A2 C) (wss C B2)) (wo (wceq C A2) (wceq C B2)))) $;

--| The covers relation is not symmetric. (Contributed by NM, 26-Jun-2004.) (New usage is discouraged.)
theorem cvnsym (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wi (wbr A2 B2 ccv) (wn (wbr B2 A2 ccv))) $;

--| The covers relation is not reflexive. (Contributed by NM, 26-Jun-2004.) (New usage is discouraged.)
theorem cvnref (A2: class):
  $ wi (wcel A2 cch) (wn (wbr A2 A2 ccv)) $;

--| The covers relation is not transitive. (Contributed by NM, 26-Jun-2004.) (New usage is discouraged.)
theorem cvntr (A2 B2 C: class):
  $ wi (w3a (wcel A2 cch) (wcel B2 cch) (wcel C cch)) (wi (wa (wbr A2 B2 ccv) (wbr B2 C ccv)) (wn (wbr A2 C ccv))) $;

--| Hilbert space has the covering property (using spans of singletons to represent atoms). Proposition 1(ii) of [Kalmbach] p. 153. (Contributed by NM, 9-Jun-2004.) (New usage is discouraged.)
theorem spansncv2 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 chba)) (wi (wn (wss (cfv (csn B2) cspn) A2)) (wbr A2 (co A2 (cfv (csn B2) cspn) chj) ccv)) $;

--| Binary relation expressing ` <. A , B >. ` is a modular pair. Definition 1.1 of [MaedaMaeda] p. 1. (Contributed by NM, 14-Jun-2004.) (New usage is discouraged.)
theorem mdbr {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wbr A2 B2 cmd) (wral x3 (wi (wss (cv x3) B2) (wceq (cin (co (cv x3) A2 chj) B2) (co (cv x3) (cin A2 B2) chj))) cch)) $;

--| Consequence of the modular pair property. (Contributed by NM, 22-Jun-2004.) (New usage is discouraged.)
theorem mdi (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cch) (wcel B2 cch) (wcel C cch)) (wa (wbr A2 B2 cmd) (wss C B2))) (wceq (cin (co C A2 chj) B2) (co C (cin A2 B2) chj)) $;

--| Binary relation expressing the modular pair property. This version has a weaker constraint than ~ mdbr . (Contributed by NM, 15-Jun-2004.) (New usage is discouraged.)
theorem mdbr2 {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wbr A2 B2 cmd) (wral x3 (wi (wss (cv x3) B2) (wss (cin (co (cv x3) A2 chj) B2) (co (cv x3) (cin A2 B2) chj))) cch)) $;

--| Binary relation expressing the modular pair property. This version quantifies an equality instead of an inference. (Contributed by NM, 6-Jul-2004.) (New usage is discouraged.)
theorem mdbr3 {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wbr A2 B2 cmd) (wral x3 (wceq (cin (co (cin (cv x3) B2) A2 chj) B2) (co (cin (cv x3) B2) (cin A2 B2) chj)) cch)) $;

--| Binary relation expressing the modular pair property. This version quantifies an ordering instead of an inference. (Contributed by NM, 6-Jul-2004.) (New usage is discouraged.)
theorem mdbr4 {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wbr A2 B2 cmd) (wral x3 (wss (cin (co (cin (cv x3) B2) A2 chj) B2) (co (cin (cv x3) B2) (cin A2 B2) chj)) cch)) $;

--| Binary relation expressing the dual modular pair property. (Contributed by NM, 27-Apr-2006.) (New usage is discouraged.)
theorem dmdbr {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wbr A2 B2 cdmd) (wral x3 (wi (wss B2 (cv x3)) (wceq (co (cin (cv x3) A2) B2 chj) (cin (cv x3) (co A2 B2 chj)))) cch)) $;

--| The dual modular pair property expressed in terms of the modular pair property, that hold in Hilbert lattices. Remark 29.6 of [MaedaMaeda] p. 130. (Contributed by NM, 27-Apr-2006.) (New usage is discouraged.)
theorem dmdmd (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wbr A2 B2 cdmd) (wbr (cfv A2 cort) (cfv B2 cort) cmd)) $;

--| The modular pair property expressed in terms of the dual modular pair property. (Contributed by NM, 27-Apr-2006.) (New usage is discouraged.)
theorem mddmd (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wbr A2 B2 cmd) (wbr (cfv A2 cort) (cfv B2 cort) cdmd)) $;

--| Consequence of the dual modular pair property. (Contributed by NM, 27-Apr-2006.) (New usage is discouraged.)
theorem dmdi (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cch) (wcel B2 cch) (wcel C cch)) (wa (wbr A2 B2 cdmd) (wss B2 C))) (wceq (co (cin C A2) B2 chj) (cin C (co A2 B2 chj))) $;

--| Binary relation expressing the dual modular pair property. This version has a weaker constraint than ~ dmdbr . (Contributed by NM, 30-Jun-2004.) (New usage is discouraged.)
theorem dmdbr2 {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wbr A2 B2 cdmd) (wral x3 (wi (wss B2 (cv x3)) (wss (cin (cv x3) (co A2 B2 chj)) (co (cin (cv x3) A2) B2 chj))) cch)) $;

--| Consequence of the dual modular pair property. (Contributed by NM, 14-Jan-2005.) (New usage is discouraged.)
theorem dmdi2 (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cch) (wcel B2 cch) (wcel C cch)) (wa (wbr A2 B2 cdmd) (wss B2 C))) (wss (cin C (co A2 B2 chj)) (co (cin C A2) B2 chj)) $;

--| Binary relation expressing the dual modular pair property. This version quantifies an equality instead of an inference. (Contributed by NM, 6-Jul-2004.) (New usage is discouraged.)
theorem dmdbr3 {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wbr A2 B2 cdmd) (wral x3 (wceq (co (cin (co (cv x3) B2 chj) A2) B2 chj) (cin (co (cv x3) B2 chj) (co A2 B2 chj))) cch)) $;

--| Binary relation expressing the dual modular pair property. This version quantifies an ordering instead of an inference. (Contributed by NM, 6-Jul-2004.) (New usage is discouraged.)
theorem dmdbr4 {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wbr A2 B2 cdmd) (wral x3 (wss (cin (co (cv x3) B2 chj) (co A2 B2 chj)) (co (cin (co (cv x3) B2 chj) A2) B2 chj)) cch)) $;

--| Consequence of the dual modular pair property. (Contributed by NM, 14-Jan-2005.) (New usage is discouraged.)
theorem dmdi4 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cch) (wcel B2 cch) (wcel C cch)) (wi (wbr A2 B2 cdmd) (wss (cin (co C B2 chj) (co A2 B2 chj)) (co (cin (co C B2 chj) A2) B2 chj))) $;

--| Binary relation expressing the dual modular pair property. (Contributed by NM, 15-Jan-2005.) (New usage is discouraged.)
theorem dmdbr5 {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wbr A2 B2 cdmd) (wral x3 (wi (wss (cv x3) (co A2 B2 chj)) (wss (cv x3) (co (cin (co (cv x3) B2 chj) A2) B2 chj))) cch)) $;

--| Relationship between modular pairs and dual-modular pairs. Lemma 1.2 of [MaedaMaeda] p. 1. (Contributed by NM, 21-Jun-2004.) (New usage is discouraged.)
theorem mddmd2 {x3: setvar} (A2: class):
  $ wi (wcel A2 cch) (wb (wral x3 (wbr A2 (cv x3) cmd) cch) (wral x3 (wbr A2 (cv x3) cdmd) cch)) $;

--| A sublattice condition that transfers the modular pair property. Exercise 12 of [Kalmbach] p. 103. Also Lemma 1.5.3 of [MaedaMaeda] p. 2. (Contributed by NM, 22-Jun-2004.) (New usage is discouraged.)
theorem mdsl0 (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cch) (wcel B2 cch)) (wa (wcel C cch) (wcel D cch))) (wi (wa (wa (wa (wss C A2) (wss D B2)) (wceq (cin A2 B2) c0h)) (wbr A2 B2 cmd)) (wbr C D cmd)) $;

--| Ordering implies the modular pair property. Remark in [MaedaMaeda] p. 1. (Contributed by NM, 21-Jun-2004.) (New usage is discouraged.)
theorem ssmd1 (A2 B2: class):
  $ wi (w3a (wcel A2 cch) (wcel B2 cch) (wss A2 B2)) (wbr A2 B2 cmd) $;

--| Ordering implies the modular pair property. Remark in [MaedaMaeda] p. 1. (Contributed by NM, 21-Jun-2004.) (New usage is discouraged.)
theorem ssmd2 (A2 B2: class):
  $ wi (w3a (wcel A2 cch) (wcel B2 cch) (wss A2 B2)) (wbr B2 A2 cmd) $;

--| Ordering implies the dual modular pair property. Remark in [MaedaMaeda] p. 1. (Contributed by NM, 22-Jun-2004.) (New usage is discouraged.)
theorem ssdmd1 (A2 B2: class):
  $ wi (w3a (wcel A2 cch) (wcel B2 cch) (wss A2 B2)) (wbr A2 B2 cdmd) $;

--| Ordering implies the dual modular pair property. Remark in [MaedaMaeda] p. 1. (Contributed by NM, 22-Jun-2004.) (New usage is discouraged.)
theorem ssdmd2 (A2 B2: class):
  $ wi (w3a (wcel A2 cch) (wcel B2 cch) (wss A2 B2)) (wbr (cfv B2 cort) (cfv A2 cort) cmd) $;

--| Sublattice mapping for a dual-modular pair. Part of Theorem 1.3 of [MaedaMaeda] p. 2. (Contributed by NM, 26-Apr-2006.) (New usage is discouraged.)
theorem dmdsl3 (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cch) (wcel B2 cch) (wcel C cch)) (w3a (wbr B2 A2 cdmd) (wss A2 C) (wss C (co A2 B2 chj)))) (wceq (co (cin C B2) A2 chj) C) $;

--| Sublattice mapping for a modular pair. Part of Theorem 1.3 of [MaedaMaeda] p. 2. (Contributed by NM, 26-Apr-2006.) (New usage is discouraged.)
theorem mdsl3 (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cch) (wcel B2 cch) (wcel C cch)) (w3a (wbr A2 B2 cmd) (wss (cin A2 B2) C) (wss C B2))) (wceq (cin (co C A2 chj) B2) C) $;

--| Order preservation of the one-to-one onto mapping between the two sublattices in Lemma 1.3 of [MaedaMaeda] p. 2. (Contributed by NM, 27-Apr-2006.) (New usage is discouraged.)
theorem mdslle1i (A2 B2 C D: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wcel D cch $ >
  $ wi (w3a (wbr B2 A2 cdmd) (wss A2 (cin C D)) (wss (co C D chj) (co A2 B2 chj))) (wb (wss C D) (wss (cin C B2) (cin D B2))) $;

--| Order preservation of the one-to-one onto mapping between the two sublattices in Lemma 1.3 of [MaedaMaeda] p. 2. (Contributed by NM, 27-Apr-2006.) (New usage is discouraged.)
theorem mdslle2i (A2 B2 C D: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wcel D cch $ >
  $ wi (w3a (wbr A2 B2 cmd) (wss (cin A2 B2) (cin C D)) (wss (co C D chj) B2)) (wb (wss C D) (wss (co C A2 chj) (co D A2 chj))) $;

--| Join preservation of the one-to-one onto mapping between the two sublattices in Lemma 1.3 of [MaedaMaeda] p. 2. (Contributed by NM, 27-Apr-2006.) (New usage is discouraged.)
theorem mdslj1i (A2 B2 C D: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wcel D cch $ >
  $ wi (wa (wa (wbr A2 B2 cmd) (wbr B2 A2 cdmd)) (wa (wss A2 (cin C D)) (wss (co C D chj) (co A2 B2 chj)))) (wceq (cin (co C D chj) B2) (co (cin C B2) (cin D B2) chj)) $;

--| Meet preservation of the reverse mapping between the two sublattices in Lemma 1.3 of [MaedaMaeda] p. 2. (Contributed by NM, 27-Apr-2006.) (New usage is discouraged.)
theorem mdslj2i (A2 B2 C D: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wcel D cch $ >
  $ wi (wa (wa (wbr A2 B2 cmd) (wbr B2 A2 cdmd)) (wa (wss (cin A2 B2) (cin C D)) (wss (co C D chj) B2))) (wceq (co (cin C D) A2 chj) (cin (co C A2 chj) (co D A2 chj))) $;

--| If the modular pair property holds in a sublattice, it holds in the whole lattice. Lemma 1.4 of [MaedaMaeda] p. 2. (Contributed by NM, 27-Apr-2006.) (New usage is discouraged.)
theorem mdsl1i {x3: setvar} (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wral x3 (wi (wa (wss (cin A2 B2) (cv x3)) (wss (cv x3) (co A2 B2 chj))) (wi (wss (cv x3) B2) (wceq (cin (co (cv x3) A2 chj) B2) (co (cv x3) (cin A2 B2) chj)))) cch) (wbr A2 B2 cmd) $;

--| If the modular pair property holds in a sublattice, it holds in the whole lattice. Lemma 1.4 of [MaedaMaeda] p. 2. (Contributed by NM, 28-Apr-2006.) (New usage is discouraged.)
theorem mdsl2i {x3: setvar} (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wbr A2 B2 cmd) (wral x3 (wi (wa (wss (cin A2 B2) (cv x3)) (wss (cv x3) B2)) (wss (cin (co (cv x3) A2 chj) B2) (co (cv x3) (cin A2 B2) chj))) cch) $;

--| If the modular pair property holds in a sublattice, it holds in the whole lattice. Lemma 1.4 of [MaedaMaeda] p. 2. (Contributed by NM, 24-Dec-2006.) (New usage is discouraged.)
theorem mdsl2bi {x3: setvar} (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wbr A2 B2 cmd) (wral x3 (wi (wa (wss (cin A2 B2) (cv x3)) (wss (cv x3) B2)) (wceq (cin (co (cv x3) A2 chj) B2) (co (cv x3) (cin A2 B2) chj))) cch) $;

--| The covering property implies the modular pair property. Lemma 7.5.1 of [MaedaMaeda] p. 31. (Contributed by NM, 16-Jun-2004.) (New usage is discouraged.)
theorem cvmdi (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi (wbr (cin A2 B2) B2 ccv) (wbr A2 B2 cmd) $;

--| Lemma for ~ mdslmd1i . (Contributed by NM, 29-Apr-2006.) (New usage is discouraged.)
theorem mdslmd1lem1 (A2 B2 C D R: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wcel D cch $ >
  $ wcel R cch $ >
  $ wi (wa (wa (wbr A2 B2 cmd) (wbr B2 A2 cdmd)) (wa (wa (wss A2 C) (wss A2 D)) (wa (wss C (co A2 B2 chj)) (wss D (co A2 B2 chj))))) (wi (wi (wss (co R A2 chj) D) (wss (cin (co (co R A2 chj) C chj) D) (co (co R A2 chj) (cin C D) chj))) (wi (wa (wss (cin (cin C B2) (cin D B2)) R) (wss R (cin D B2))) (wss (cin (co R (cin C B2) chj) (cin D B2)) (co R (cin (cin C B2) (cin D B2)) chj)))) $;

--| Lemma for ~ mdslmd1i . (Contributed by NM, 29-Apr-2006.) (New usage is discouraged.)
theorem mdslmd1lem2 (A2 B2 C D R: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wcel D cch $ >
  $ wcel R cch $ >
  $ wi (wa (wa (wbr A2 B2 cmd) (wbr B2 A2 cdmd)) (wa (wa (wss A2 C) (wss A2 D)) (wa (wss C (co A2 B2 chj)) (wss D (co A2 B2 chj))))) (wi (wi (wss (cin R B2) (cin D B2)) (wss (cin (co (cin R B2) (cin C B2) chj) (cin D B2)) (co (cin R B2) (cin (cin C B2) (cin D B2)) chj))) (wi (wa (wss (cin C D) R) (wss R D)) (wss (cin (co R C chj) D) (co R (cin C D) chj)))) $;

--| Lemma for ~ mdslmd1i . (Contributed by NM, 29-Apr-2006.) (New usage is discouraged.)
theorem mdslmd1lem3 (x3: setvar) (A2 B2 C D: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wcel D cch $ >
  $ wi (wa (wcel (cv x3) cch) (wa (wa (wbr A2 B2 cmd) (wbr B2 A2 cdmd)) (wa (wa (wss A2 C) (wss A2 D)) (wa (wss C (co A2 B2 chj)) (wss D (co A2 B2 chj)))))) (wi (wi (wss (co (cv x3) A2 chj) D) (wss (cin (co (co (cv x3) A2 chj) C chj) D) (co (co (cv x3) A2 chj) (cin C D) chj))) (wi (wa (wss (cin (cin C B2) (cin D B2)) (cv x3)) (wss (cv x3) (cin D B2))) (wss (cin (co (cv x3) (cin C B2) chj) (cin D B2)) (co (cv x3) (cin (cin C B2) (cin D B2)) chj)))) $;

--| Lemma for ~ mdslmd1i . (Contributed by NM, 29-Apr-2006.) (New usage is discouraged.)
theorem mdslmd1lem4 (x3: setvar) (A2 B2 C D: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wcel D cch $ >
  $ wi (wa (wcel (cv x3) cch) (wa (wa (wbr A2 B2 cmd) (wbr B2 A2 cdmd)) (wa (wa (wss A2 C) (wss A2 D)) (wa (wss C (co A2 B2 chj)) (wss D (co A2 B2 chj)))))) (wi (wi (wss (cin (cv x3) B2) (cin D B2)) (wss (cin (co (cin (cv x3) B2) (cin C B2) chj) (cin D B2)) (co (cin (cv x3) B2) (cin (cin C B2) (cin D B2)) chj))) (wi (wa (wss (cin C D) (cv x3)) (wss (cv x3) D)) (wss (cin (co (cv x3) C chj) D) (co (cv x3) (cin C D) chj)))) $;

--| Preservation of the modular pair property in the one-to-one onto mapping between the two sublattices in Lemma 1.3 of [MaedaMaeda] p. 2 (meet version). (Contributed by NM, 27-Apr-2006.) (New usage is discouraged.)
theorem mdslmd1i (A2 B2 C D: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wcel D cch $ >
  $ wi (wa (wa (wbr A2 B2 cmd) (wbr B2 A2 cdmd)) (wa (wss A2 (cin C D)) (wss (co C D chj) (co A2 B2 chj)))) (wb (wbr C D cmd) (wbr (cin C B2) (cin D B2) cmd)) $;

--| Preservation of the modular pair property in the one-to-one onto mapping between the two sublattices in Lemma 1.3 of [MaedaMaeda] p. 2 (join version). (Contributed by NM, 29-Apr-2006.) (New usage is discouraged.)
theorem mdslmd2i (A2 B2 C D: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wcel D cch $ >
  $ wi (wa (wa (wbr A2 B2 cmd) (wbr B2 A2 cdmd)) (wa (wss (cin A2 B2) (cin C D)) (wss (co C D chj) B2))) (wb (wbr C D cmd) (wbr (co C A2 chj) (co D A2 chj) cmd)) $;

--| Preservation of the dual modular pair property in the one-to-one onto mapping between the two sublattices in Lemma 1.3 of [MaedaMaeda] p. 2. (Contributed by NM, 29-Apr-2006.) (New usage is discouraged.)
theorem mdsldmd1i (A2 B2 C D: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wcel D cch $ >
  $ wi (wa (wa (wbr A2 B2 cmd) (wbr B2 A2 cdmd)) (wa (wss A2 (cin C D)) (wss (co C D chj) (co A2 B2 chj)))) (wb (wbr C D cdmd) (wbr (cin C B2) (cin D B2) cdmd)) $;

--| Modular pair conditions that imply the modular pair property in a sublattice. Lemma 1.5.1 of [MaedaMaeda] p. 2. (Contributed by NM, 23-Dec-2006.) (New usage is discouraged.)
theorem mdslmd3i (A2 B2 C D: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wcel D cch $ >
  $ wi (wa (wa (wbr A2 B2 cmd) (wbr (cin A2 B2) C cmd)) (wa (wss (cin A2 C) D) (wss D A2))) (wbr D (cin B2 C) cmd) $;

--| Modular pair condition that implies the modular pair property in a sublattice. Lemma 1.5.2 of [MaedaMaeda] p. 2. (Contributed by NM, 24-Dec-2006.) (New usage is discouraged.)
theorem mdslmd4i (A2 B2 C D: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wcel D cch $ >
  $ wi (w3a (wbr A2 B2 cmd) (wa (wss (cin A2 B2) C) (wss C A2)) (wa (wss (cin A2 B2) D) (wss D B2))) (wbr C D cmd) $;

--| Cross-symmetry implies M-symmetry. Theorem 1.9.1 of [MaedaMaeda] p. 3. (Contributed by NM, 24-Dec-2006.) (New usage is discouraged.)
theorem csmdsymi {c: setvar} (A2: class c) (B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi (wa (wral c (wi (wbr (cv c) B2 cmd) (wbr B2 (cv c) cdmd)) cch) (wbr A2 B2 cmd)) (wbr B2 A2 cmd) $;

--| An exchange lemma for modular pairs. Lemma 1.6 of [MaedaMaeda] p. 2. (Contributed by NM, 22-Jun-2004.) (New usage is discouraged.)
theorem mdexchi (A2 B2 C: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wcel C cch $ >
  $ wi (w3a (wbr A2 B2 cmd) (wbr C (co A2 B2 chj) cmd) (wss (cin C (co A2 B2 chj)) A2)) (wa (wbr (co C A2 chj) B2 cmd) (wceq (cin (co C A2 chj) B2) (cin A2 B2))) $;

--| The covering property implies the modular pair property. Lemma 7.5.1 of [MaedaMaeda] p. 31. (Contributed by NM, 21-Jun-2004.) (New usage is discouraged.)
theorem cvmd (A2 B2: class):
  $ wi (w3a (wcel A2 cch) (wcel B2 cch) (wbr (cin A2 B2) B2 ccv)) (wbr A2 B2 cmd) $;

--| The covering property implies the dual modular pair property. Lemma 7.5.2 of [MaedaMaeda] p. 31. (Contributed by NM, 21-Jun-2004.) (New usage is discouraged.)
theorem cvdmd (A2 B2: class):
  $ wi (w3a (wcel A2 cch) (wcel B2 cch) (wbr B2 (co A2 B2 chj) ccv)) (wbr A2 B2 cdmd) $;

--| Define the set of atoms in a Hilbert lattice. An atom is a nonzero element of a lattice such that anything less than it is zero, i.e. it is the smallest nonzero element of the lattice. Definition of atom in [Kalmbach] p. 15. See ~ ela and ~ elat2 for membership relations. (Contributed by NM, 14-Aug-2002.) (New usage is discouraged.)
axiom df_at {x3: setvar}:
  $ wceq cat (crab x3 (wbr c0h (cv x3) ccv) cch) $;

--| Atoms in a Hilbert lattice are the elements that cover the zero subspace. Definition of atom in [Kalmbach] p. 15. (Contributed by NM, 9-Jun-2004.) (New usage is discouraged.)
theorem ela (A2: class):
  $ wb (wcel A2 cat) (wa (wcel A2 cch) (wbr c0h A2 ccv)) $;

--| Expanded membership relation for the set of atoms, i.e. the predicate "is an atom (of the Hilbert lattice)." An atom is a nonzero element of a lattice such that anything less than it is zero, i.e. it is the smallest nonzero element of the lattice. (Contributed by NM, 9-Jun-2004.) (New usage is discouraged.)
theorem elat2 {x3: setvar} (A2: class):
  $ wb (wcel A2 cat) (wa (wcel A2 cch) (wa (wne A2 c0h) (wral x3 (wi (wss (cv x3) A2) (wo (wceq (cv x3) A2) (wceq (cv x3) c0h))) cch))) $;

--| A Hilbert lattice element is an atom iff it covers the zero subspace. (Contributed by NM, 26-Jun-2004.) (New usage is discouraged.)
theorem elatcv0 (A2: class):
  $ wi (wcel A2 cch) (wb (wcel A2 cat) (wbr c0h A2 ccv)) $;

--| An atom covers the zero subspace. (Contributed by NM, 26-Jun-2004.) (New usage is discouraged.)
theorem atcv0 (A2: class):
  $ wi (wcel A2 cat) (wbr c0h A2 ccv) $;

--| Atoms are a subset of the Hilbert lattice. (Contributed by NM, 14-Aug-2002.) (New usage is discouraged.)
theorem atssch:
  $ wss cat cch $;

--| An atom is a Hilbert lattice element. (Contributed by NM, 22-Jun-2004.) (New usage is discouraged.)
theorem atelch (A2: class):
  $ wi (wcel A2 cat) (wcel A2 cch) $;

--| An atom is not the Hilbert lattice zero. (Contributed by NM, 13-Aug-2002.) (New usage is discouraged.)
theorem atne0 (A2: class):
  $ wi (wcel A2 cat) (wne A2 c0h) $;

--| A lattice element smaller than an atom is either the atom or zero. (Contributed by NM, 25-Jun-2004.) (New usage is discouraged.)
theorem atss (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cat)) (wi (wss A2 B2) (wo (wceq A2 B2) (wceq A2 c0h))) $;

--| Two atoms in a subset relationship are equal. (Contributed by NM, 26-Jun-2004.) (New usage is discouraged.)
theorem atsseq (A2 B2: class):
  $ wi (wa (wcel A2 cat) (wcel B2 cat)) (wb (wss A2 B2) (wceq A2 B2)) $;

--| A Hilbert lattice element covered by an atom must be the zero subspace. (Contributed by NM, 11-Jun-2004.) (New usage is discouraged.)
theorem atcveq0 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cat)) (wb (wbr A2 B2 ccv) (wceq A2 c0h)) $;

--| A 1-dimensional subspace is an atom. (Contributed by NM, 22-Jul-2001.) (New usage is discouraged.)
theorem h1da (A2: class):
  $ wi (wa (wcel A2 chba) (wne A2 c0v)) (wcel (cfv (cfv (csn A2) cort) cort) cat) $;

--| The span of the singleton of a vector is an atom. (Contributed by NM, 18-Dec-2004.) (New usage is discouraged.)
theorem spansna (A2: class):
  $ wi (wa (wcel A2 chba) (wne A2 c0v)) (wcel (cfv (csn A2) cspn) cat) $;

--| A 1-dimensional subspace is less than or equal to any subspace containing its generating vector. (Contributed by NM, 24-Nov-2004.) (New usage is discouraged.)
theorem sh1dle (A2 B2: class):
  $ wi (wa (wcel A2 csh) (wcel B2 A2)) (wss (cfv (cfv (csn B2) cort) cort) A2) $;

--| A 1-dimensional subspace is less than or equal to any member of ` CH ` containing its generating vector. (Contributed by NM, 30-May-2004.) (New usage is discouraged.)
theorem ch1dle (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 A2)) (wss (cfv (cfv (csn B2) cort) cort) A2) $;

--| The 1-dimensional subspaces of Hilbert space are its atoms. Part of Remark 10.3.5 of [BeltramettiCassinelli] p. 107. (Contributed by NM, 4-Jun-2004.) (New usage is discouraged.)
theorem atom1d {x3: setvar} (A2: class):
  $ wb (wcel A2 cat) (wrex x3 (wa (wne (cv x3) c0v) (wceq A2 (cfv (csn (cv x3)) cspn))) chba) $;

--| Superposition Principle. If ` A ` and ` B ` are distinct atoms, there exists a third atom, distinct from ` A ` and ` B ` , that is the superposition of ` A ` and ` B ` . Definition 3.4-3(a) in [MegPav2000] p. 2345 (PDF p. 8). (Contributed by NM, 9-Jun-2006.) (New usage is discouraged.)
theorem superpos {x3: setvar} (A2 B2: class):
  $ wi (w3a (wcel A2 cat) (wcel B2 cat) (wne A2 B2)) (wrex x3 (w3a (wne (cv x3) A2) (wne (cv x3) B2) (wss (cv x3) (co A2 B2 chj))) cat) $;

--| The Hilbert lattice has the covering property. Proposition 1(ii) of [Kalmbach] p. 140 (and its converse). (Contributed by NM, 11-Jun-2004.) (New usage is discouraged.)
theorem chcv1 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cat)) (wb (wn (wss B2 A2)) (wbr A2 (co A2 B2 chj) ccv)) $;

--| The Hilbert lattice has the covering property. (Contributed by NM, 11-Jun-2004.) (New usage is discouraged.)
theorem chcv2 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cat)) (wb (wpss A2 (co A2 B2 chj)) (wbr A2 (co A2 B2 chj) ccv)) $;

--| The join of a closed subspace and an atom equals their subspace sum. Special case of remark in [Kalmbach] p. 65, stating that if ` A ` or ` B ` is finite-dimensional, then this equality holds. (Contributed by NM, 4-Jun-2004.) (New usage is discouraged.)
theorem chjatom (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cat)) (wceq (co A2 B2 cph) (co A2 B2 chj)) $;

--| The lattice of Hilbert subspaces is atomic, i.e. any nonzero element is greater than or equal to some atom. Part of proof of Theorem 16.9 of [MaedaMaeda] p. 70. (Contributed by NM, 24-Nov-2004.) (New usage is discouraged.)
theorem shatomici {x3: setvar} (A2: class):
  $ wcel A2 csh $ >
  $ wi (wne A2 c0h) (wrex x3 (wss (cv x3) A2) cat) $;

--| The Hilbert lattice is atomic, i.e. any nonzero element is greater than or equal to some atom. Remark in [Kalmbach] p. 140. (Contributed by NM, 22-Jul-2001.) (New usage is discouraged.)
theorem hatomici {x3: setvar} (A2: class):
  $ wcel A2 cch $ >
  $ wi (wne A2 c0h) (wrex x3 (wss (cv x3) A2) cat) $;

--| A Hilbert lattice is atomic, i.e. any nonzero element is greater than or equal to some atom. Remark in [Kalmbach] p. 140. Also Definition 3.4-2 in [MegPav2000] p. 2345 (PDF p. 8). (Contributed by NM, 24-Jun-2004.) (New usage is discouraged.)
theorem hatomic {x3: setvar} (A2: class):
  $ wi (wa (wcel A2 cch) (wne A2 c0h)) (wrex x3 (wss (cv x3) A2) cat) $;

--| The lattice of Hilbert subspaces is atomistic, i.e. any element is the supremum of its atoms. Part of proof of Theorem 16.9 of [MaedaMaeda] p. 70. (Contributed by NM, 26-Nov-2004.) (New usage is discouraged.)
theorem shatomistici {x3: setvar} (A2: class):
  $ wcel A2 csh $ >
  $ wceq A2 (cfv (cuni (crab x3 (wss (cv x3) A2) cat)) cspn) $;

--| ` CH ` is atomistic, i.e. any element is the supremum of its atoms. Remark in [Kalmbach] p. 140. (Contributed by NM, 14-Aug-2002.) (New usage is discouraged.)
theorem hatomistici {x3: setvar} (A2: class):
  $ wcel A2 cch $ >
  $ wceq A2 (cfv (crab x3 (wss (cv x3) A2) cat) chsup) $;

--| Two Hilbert lattice elements in a proper subset relationship imply the existence of an atom less than or equal to one but not the other. (Contributed by NM, 10-Jun-2004.) (New usage is discouraged.)
theorem chpssati {x3: setvar} (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi (wpss A2 B2) (wrex x3 (wa (wss (cv x3) B2) (wn (wss (cv x3) A2))) cat) $;

--| The Hilbert lattice is relatively atomic. Remark 2 of [Kalmbach] p. 149. (Contributed by NM, 11-Jun-2004.) (New usage is discouraged.)
theorem chrelati {x3: setvar} (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi (wpss A2 B2) (wrex x3 (wa (wpss A2 (co A2 (cv x3) chj)) (wss (co A2 (cv x3) chj) B2)) cat) $;

--| A consequence of relative atomicity. (Contributed by NM, 30-Jun-2004.) (New usage is discouraged.)
theorem chrelat2i {x3: setvar} (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wn (wss A2 B2)) (wrex x3 (wa (wss (cv x3) A2) (wn (wss (cv x3) B2))) cat) $;

--| If a Hilbert lattice element covers another, it equals the other joined with some atom. This is a consequence of the relative atomicity of Hilbert space. (Contributed by NM, 30-Nov-2004.) (New usage is discouraged.)
theorem cvati {x3: setvar} (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi (wbr A2 B2 ccv) (wrex x3 (wceq (co A2 (cv x3) chj) B2) cat) $;

--| An alternate way to express the covering property. (Contributed by NM, 30-Nov-2004.) (New usage is discouraged.)
theorem cvbr4i {x3: setvar} (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wbr A2 B2 ccv) (wa (wpss A2 B2) (wrex x3 (wceq (co A2 (cv x3) chj) B2) cat)) $;

--| Lemma for ~ cvexchi . (Contributed by NM, 10-Jun-2004.) (New usage is discouraged.)
theorem cvexchlem (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi (wbr (cin A2 B2) B2 ccv) (wbr A2 (co A2 B2 chj) ccv) $;

--| The Hilbert lattice satisfies the exchange axiom. Proposition 1(iii) of [Kalmbach] p. 140 and its converse. Originally proved by Garrett Birkhoff in 1933. (Contributed by NM, 12-Jun-2004.) (New usage is discouraged.)
theorem cvexchi (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wbr (cin A2 B2) B2 ccv) (wbr A2 (co A2 B2 chj) ccv) $;

--| A consequence of relative atomicity. (Contributed by NM, 1-Jul-2004.) (New usage is discouraged.)
theorem chrelat2 {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wn (wss A2 B2)) (wrex x3 (wa (wss (cv x3) A2) (wn (wss (cv x3) B2))) cat)) $;

--| A consequence of relative atomicity. (Contributed by NM, 2-Jul-2004.) (New usage is discouraged.)
theorem chrelat3 {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wss A2 B2) (wral x3 (wi (wss (cv x3) A2) (wss (cv x3) B2)) cat)) $;

--| A consequence of the relative atomicity of Hilbert space: the ordering of Hilbert lattice elements is completely determined by the atoms they majorize. (Contributed by NM, 30-Jun-2004.) (New usage is discouraged.)
theorem chrelat3i {x3: setvar} (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wss A2 B2) (wral x3 (wi (wss (cv x3) A2) (wss (cv x3) B2)) cat) $;

--| A consequence of relative atomicity. Extensionality principle: two lattice elements are equal iff they majorize the same atoms. (Contributed by NM, 30-Jun-2004.) (New usage is discouraged.)
theorem chrelat4i {x3: setvar} (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wceq A2 B2) (wral x3 (wb (wss (cv x3) A2) (wss (cv x3) B2)) cat) $;

--| The Hilbert lattice satisfies the exchange axiom. Proposition 1(iii) of [Kalmbach] p. 140 and its converse. Originally proved by Garrett Birkhoff in 1933. (Contributed by NM, 21-Jun-2004.) (New usage is discouraged.)
theorem cvexch (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wbr (cin A2 B2) B2 ccv) (wbr A2 (co A2 B2 chj) ccv)) $;

--| The Hilbert lattice satisfies the covering property of Definition 7.4 of [MaedaMaeda] p. 31 and its converse. (Contributed by NM, 21-Jun-2004.) (New usage is discouraged.)
theorem cvp (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cat)) (wb (wceq (cin A2 B2) c0h) (wbr A2 (co A2 B2 chj) ccv)) $;

--| The meet of a Hilbert lattice element and an incomparable atom is the zero subspace. (Contributed by NM, 30-Jun-2004.) (New usage is discouraged.)
theorem atnssm0 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cat)) (wb (wn (wss B2 A2)) (wceq (cin A2 B2) c0h)) $;

--| The meet of distinct atoms is the zero subspace. (Contributed by NM, 25-Jun-2004.) (New usage is discouraged.)
theorem atnemeq0 (A2 B2: class):
  $ wi (wa (wcel A2 cat) (wcel B2 cat)) (wb (wne A2 B2) (wceq (cin A2 B2) c0h)) $;

--| The meet with an atom's superset is the atom. (Contributed by NM, 12-Jun-2006.) (New usage is discouraged.)
theorem atssma (A2 B2: class):
  $ wi (wa (wcel A2 cat) (wcel B2 cch)) (wb (wss A2 B2) (wcel (cin A2 B2) cat)) $;

--| Two atoms covering the zero subspace are equal. (Contributed by NM, 26-Jun-2004.) (New usage is discouraged.)
theorem atcv0eq (A2 B2: class):
  $ wi (wa (wcel A2 cat) (wcel B2 cat)) (wb (wbr c0h (co A2 B2 chj) ccv) (wceq A2 B2)) $;

--| Two atoms covering the zero subspace are equal. (Contributed by NM, 26-Jun-2004.) (New usage is discouraged.)
theorem atcv1 (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cch) (wcel B2 cat) (wcel C cat)) (wbr A2 (co B2 C chj) ccv)) (wb (wceq A2 c0h) (wceq B2 C)) $;

--| The Hilbert lattice satisfies the atom exchange property. Proposition 1(i) of [Kalmbach] p. 140. A version of this theorem related to vector analysis was originally proved by Hermann Grassmann in 1862. Also Definition 3.4-3(b) in [MegPav2000] p. 2345 (PDF p. 8) (use ~ atnemeq0 to obtain atom inequality). (Contributed by NM, 27-Jun-2004.) (New usage is discouraged.)
theorem atexch (A2 B2 C: class):
  $ wi (w3a (wcel A2 cch) (wcel B2 cat) (wcel C cat)) (wi (wa (wss B2 (co A2 C chj)) (wceq (cin A2 B2) c0h)) (wss C (co A2 B2 chj))) $;

--| An assertion holding in atomic orthomodular lattices that is equivalent to the exchange axiom. Proposition 3.2.17 of [PtakPulmannova] p. 66. (Contributed by NM, 24-Jun-2004.) (New usage is discouraged.)
theorem atomli (A2 B2: class):
  $ wcel A2 cch $ >
  $ wi (wcel B2 cat) (wcel (cin (co A2 B2 chj) (cfv A2 cort)) (cun cat (csn c0h))) $;

--| An assertion holding in atomic orthomodular lattices that is equivalent to the exchange axiom. Proposition P8(ii) of [BeltramettiCassinelli1] p. 400. (Contributed by NM, 12-Jun-2006.) (New usage is discouraged.)
theorem atoml2i (A2 B2: class):
  $ wcel A2 cch $ >
  $ wi (wa (wcel B2 cat) (wn (wss B2 A2))) (wcel (cin (co A2 B2 chj) (cfv A2 cort)) cat) $;

--| An ordering law for a Hilbert lattice atom and a commuting subspace. (Contributed by NM, 12-Jun-2006.) (New usage is discouraged.)
theorem atordi (A2 B2: class):
  $ wcel A2 cch $ >
  $ wi (wa (wcel B2 cat) (wbr A2 B2 ccm)) (wo (wss B2 A2) (wss B2 (cfv A2 cort))) $;

--| Lemma for ~ atcvati . (Contributed by NM, 27-Jun-2004.) (New usage is discouraged.)
theorem atcvatlem (A2 B2 C: class):
  $ wcel A2 cch $ >
  $ wi (wa (wa (wcel B2 cat) (wcel C cat)) (wa (wne A2 c0h) (wpss A2 (co B2 C chj)))) (wi (wn (wss B2 A2)) (wcel A2 cat)) $;

--| A nonzero Hilbert lattice element less than the join of two atoms is an atom. (Contributed by NM, 28-Jun-2004.) (New usage is discouraged.)
theorem atcvati (A2 B2 C: class):
  $ wcel A2 cch $ >
  $ wi (wa (wcel B2 cat) (wcel C cat)) (wi (wa (wne A2 c0h) (wpss A2 (co B2 C chj))) (wcel A2 cat)) $;

--| A Hilbert lattice element covered by the join of two distinct atoms is an atom. (Contributed by NM, 26-Jun-2004.) (New usage is discouraged.)
theorem atcvat2i (A2 B2 C: class):
  $ wcel A2 cch $ >
  $ wi (wa (wcel B2 cat) (wcel C cat)) (wi (wa (wn (wceq B2 C)) (wbr A2 (co B2 C chj) ccv)) (wcel A2 cat)) $;

--| An ordering law for a Hilbert lattice atom and a commuting subspace. (Contributed by NM, 12-Jun-2006.) (New usage is discouraged.)
theorem atord (A2 B2: class):
  $ wi (w3a (wcel A2 cch) (wcel B2 cat) (wbr A2 B2 ccm)) (wo (wss B2 A2) (wss B2 (cfv A2 cort))) $;

--| A Hilbert lattice element covered by the join of two distinct atoms is an atom. (Contributed by NM, 29-Jun-2004.) (New usage is discouraged.)
theorem atcvat2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cch) (wcel B2 cat) (wcel C cat)) (wi (wa (wn (wceq B2 C)) (wbr A2 (co B2 C chj) ccv)) (wcel A2 cat)) $;

--| Lemma for ~ chirredi . (Contributed by NM, 14-Jun-2006.) (New usage is discouraged.)
theorem chirredlem1 (A2: class) (r q p: setvar):
  $ wcel A2 cch $ >
  $ wi (wa (wa (wcel (cv p) cat) (wa (wcel (cv q) cch) (wss (cv q) (cfv A2 cort)))) (wa (wa (wcel (cv r) cat) (wss (cv r) A2)) (wss (cv r) (co (cv p) (cv q) chj)))) (wceq (cin (cv p) (cfv (cv r) cort)) c0h) $;

--| Lemma for ~ chirredi . (Contributed by NM, 15-Jun-2006.) (New usage is discouraged.)
theorem chirredlem2 (A2: class) (r q p: setvar):
  $ wcel A2 cch $ >
  $ wi (wa (wa (wa (wcel (cv p) cat) (wss (cv p) A2)) (wa (wcel (cv q) cch) (wss (cv q) (cfv A2 cort)))) (wa (wa (wcel (cv r) cat) (wss (cv r) A2)) (wss (cv r) (co (cv p) (cv q) chj)))) (wceq (cin (cfv (cv r) cort) (co (cv p) (cv q) chj)) (cv q)) $;

--| Lemma for ~ chirredi . (Contributed by NM, 15-Jun-2006.) (New usage is discouraged.)
theorem chirredlem3 {x3: setvar} (A2: class) (r q p: setvar):
  $ wcel A2 cch $ >
  $ wi (wcel (cv x3) cch) (wbr A2 (cv x3) ccm) $ >
  $ wi (wa (wa (wa (wcel (cv p) cat) (wss (cv p) A2)) (wa (wcel (cv q) cat) (wss (cv q) (cfv A2 cort)))) (wa (wcel (cv r) cat) (wss (cv r) (co (cv p) (cv q) chj)))) (wi (wss (cv r) A2) (wceq (cv r) (cv p))) $;

--| Lemma for ~ chirredi . (Contributed by NM, 15-Jun-2006.) (New usage is discouraged.)
theorem chirredlem4 {x3: setvar} (A2: class) (r q p: setvar):
  $ wcel A2 cch $ >
  $ wi (wcel (cv x3) cch) (wbr A2 (cv x3) ccm) $ >
  $ wi (wa (wa (wa (wcel (cv p) cat) (wss (cv p) A2)) (wa (wcel (cv q) cat) (wss (cv q) (cfv A2 cort)))) (wa (wcel (cv r) cat) (wss (cv r) (co (cv p) (cv q) chj)))) (wo (wceq (cv r) (cv p)) (wceq (cv r) (cv q))) $;

--| The Hilbert lattice is irreducible: any element that commutes with all elements must be zero or one. Theorem 14.8.4 of [BeltramettiCassinelli] p. 166. (Contributed by NM, 15-Jun-2006.) (New usage is discouraged.)
theorem chirredi {x3: setvar} (A2: class):
  $ wcel A2 cch $ >
  $ wi (wcel (cv x3) cch) (wbr A2 (cv x3) ccm) $ >
  $ wo (wceq A2 c0h) (wceq A2 chba) $;

--| The Hilbert lattice is irreducible: any element that commutes with all elements must be zero or one. Theorem 14.8.4 of [BeltramettiCassinelli] p. 166. (Contributed by NM, 16-Jun-2006.) (New usage is discouraged.)
theorem chirred {x3: setvar} (A2: class):
  $ wi (wa (wcel A2 cch) (wral x3 (wbr A2 (cv x3) ccm) cch)) (wo (wceq A2 c0h) (wceq A2 chba)) $;

--| A condition implying that a certain lattice element is an atom. Part of Lemma 3.2.20 of [PtakPulmannova] p. 68. (Contributed by NM, 2-Jul-2004.) (New usage is discouraged.)
theorem atcvat3i (A2 B2 C: class):
  $ wcel A2 cch $ >
  $ wi (wa (wcel B2 cat) (wcel C cat)) (wi (wa (wa (wn (wceq B2 C)) (wn (wss C A2))) (wss B2 (co A2 C chj))) (wcel (cin A2 (co B2 C chj)) cat)) $;

--| A condition implying existence of an atom with the properties shown. Lemma 3.2.20 of [PtakPulmannova] p. 68. (Contributed by NM, 2-Jul-2004.) (New usage is discouraged.)
theorem atcvat4i {x3: setvar} (A2 B2 C: class):
  $ wcel A2 cch $ >
  $ wi (wa (wcel B2 cat) (wcel C cat)) (wi (wa (wne A2 c0h) (wss B2 (co A2 C chj))) (wrex x3 (wa (wss (cv x3) A2) (wss B2 (co C (cv x3) chj))) cat)) $;

--| Two Hilbert lattice elements have the dual modular pair property if the first is an atom. Theorem 7.6(c) of [MaedaMaeda] p. 31. (Contributed by NM, 22-Jun-2004.) (New usage is discouraged.)
theorem atdmd (A2 B2: class):
  $ wi (wa (wcel A2 cat) (wcel B2 cch)) (wbr A2 B2 cdmd) $;

--| Two Hilbert lattice elements have the modular pair property if the first is an atom. Theorem 7.6(b) of [MaedaMaeda] p. 31. (Contributed by NM, 22-Jun-2004.) (New usage is discouraged.)
theorem atmd (A2 B2: class):
  $ wi (wa (wcel A2 cat) (wcel B2 cch)) (wbr A2 B2 cmd) $;

--| Two Hilbert lattice elements have the dual modular pair property if the second is an atom. Part of Exercise 6 of [Kalmbach] p. 103. (Contributed by NM, 22-Jun-2004.) (New usage is discouraged.)
theorem atmd2 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cat)) (wbr A2 B2 cmd) $;

--| Absorption of an incomparable atom. Similar to Exercise 7.1 of [MaedaMaeda] p. 34. (Contributed by NM, 15-Jul-2004.) (New usage is discouraged.)
theorem atabsi (A2 B2 C: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi (wcel C cat) (wi (wn (wss C (co A2 B2 chj))) (wceq (cin (co A2 C chj) B2) (cin A2 B2))) $;

--| Absorption of an incomparable atom. (Contributed by NM, 18-Jul-2004.) (New usage is discouraged.)
theorem atabs2i (A2 B2 C: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi (wcel C cat) (wi (wn (wss C (co A2 B2 chj))) (wceq (cin (co A2 C chj) (co A2 B2 chj)) A2)) $;

--| Lemma for ~ mdsymi . (Contributed by NM, 1-Jul-2004.) (New usage is discouraged.)
theorem mdsymlem1 {p: setvar} (A2 B2: class) (C: class p):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wceq C (co A2 (cv p) chj) $ >
  $ wi (wa (wa (wcel (cv p) cch) (wss (cin B2 C) A2)) (wa (wbr B2 A2 cdmd) (wss (cv p) (co A2 B2 chj)))) (wss (cv p) A2) $;

--| Lemma for ~ mdsymi . (Contributed by NM, 1-Jul-2004.) (New usage is discouraged.)
theorem mdsymlem2 {r q p: setvar} (A2 B2: class) (C: class p):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wceq C (co A2 (cv p) chj) $ >
  $ wi (wa (wa (wcel (cv p) cat) (wss (cin B2 C) A2)) (wa (wbr B2 A2 cdmd) (wss (cv p) (co A2 B2 chj)))) (wi (wne B2 c0h) (wrex r (wrex q (wa (wss (cv p) (co (cv q) (cv r) chj)) (wa (wss (cv q) A2) (wss (cv r) B2))) cat) cat)) $;

--| Lemma for ~ mdsymi . (Contributed by NM, 2-Jul-2004.) (New usage is discouraged.)
theorem mdsymlem3 {r q p: setvar} (A2 B2: class) (C: class p):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wceq C (co A2 (cv p) chj) $ >
  $ wi (wa (wa (wa (wcel (cv p) cat) (wn (wss (cin B2 C) A2))) (wss (cv p) (co A2 B2 chj))) (wne A2 c0h)) (wrex r (wrex q (wa (wss (cv p) (co (cv q) (cv r) chj)) (wa (wss (cv q) A2) (wss (cv r) B2))) cat) cat) $;

--| Lemma for ~ mdsymi . This is the forward direction of Lemma 4(i) of [Maeda] p. 168. (Contributed by NM, 2-Jul-2004.) (New usage is discouraged.)
theorem mdsymlem4 {r q p: setvar} (A2 B2: class) (C: class p):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wceq C (co A2 (cv p) chj) $ >
  $ wi (wcel (cv p) cat) (wi (wa (wbr B2 A2 cdmd) (wa (wa (wne A2 c0h) (wne B2 c0h)) (wss (cv p) (co A2 B2 chj)))) (wrex q (wrex r (wa (wss (cv p) (co (cv q) (cv r) chj)) (wa (wss (cv q) A2) (wss (cv r) B2))) cat) cat)) $;

--| Lemma for ~ mdsymi . (Contributed by NM, 2-Jul-2004.) (New usage is discouraged.)
theorem mdsymlem5 {p: setvar} (A2 B2: class) (C: class p) (r q c: setvar):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wceq C (co A2 (cv p) chj) $ >
  $ wi (wa (wcel (cv q) cat) (wcel (cv r) cat)) (wi (wn (wceq (cv q) (cv p))) (wi (wa (wss (cv p) (co (cv q) (cv r) chj)) (wa (wss (cv q) A2) (wss (cv r) B2))) (wi (wa (wa (wcel (cv c) cch) (wss A2 (cv c))) (wcel (cv p) cat)) (wi (wss (cv p) (cv c)) (wss (cv p) (co (cin (cv c) B2) A2 chj)))))) $;

--| Lemma for ~ mdsymi . This is the converse direction of Lemma 4(i) of [Maeda] p. 168, and is based on the proof of Theorem 1(d) to (e) of [Maeda] p. 167. (Contributed by NM, 2-Jul-2004.) (New usage is discouraged.)
theorem mdsymlem6 {r q p: setvar} (A2 B2: class) (C: class p):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wceq C (co A2 (cv p) chj) $ >
  $ wi (wral p (wi (wss (cv p) (co A2 B2 chj)) (wrex q (wrex r (wa (wss (cv p) (co (cv q) (cv r) chj)) (wa (wss (cv q) A2) (wss (cv r) B2))) cat) cat)) cat) (wbr B2 A2 cdmd) $;

--| Lemma for ~ mdsymi . Lemma 4(i) of [Maeda] p. 168. Note that Maeda's 1965 definition of dual modular pair has reversed arguments compared to the later (1970) definition given in Remark 29.6 of [MaedaMaeda] p. 130, which is the one that we use. (Contributed by NM, 3-Jul-2004.) (New usage is discouraged.)
theorem mdsymlem7 {r q p: setvar} (A2 B2: class) (C: class p):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wceq C (co A2 (cv p) chj) $ >
  $ wi (wa (wne A2 c0h) (wne B2 c0h)) (wb (wbr B2 A2 cdmd) (wral p (wi (wss (cv p) (co A2 B2 chj)) (wrex q (wrex r (wa (wss (cv p) (co (cv q) (cv r) chj)) (wa (wss (cv q) A2) (wss (cv r) B2))) cat) cat)) cat)) $;

--| Lemma for ~ mdsymi . Lemma 4(ii) of [Maeda] p. 168. (Contributed by NM, 3-Jul-2004.) (New usage is discouraged.)
theorem mdsymlem8 {p: setvar} (A2 B2: class) (C: class p):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wceq C (co A2 (cv p) chj) $ >
  $ wi (wa (wne A2 c0h) (wne B2 c0h)) (wb (wbr B2 A2 cdmd) (wbr A2 B2 cdmd)) $;

--| M-symmetry of the Hilbert lattice. Lemma 5 of [Maeda] p. 168. (Contributed by NM, 3-Jul-2004.) (New usage is discouraged.)
theorem mdsymi (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wbr A2 B2 cmd) (wbr B2 A2 cmd) $;

--| M-symmetry of the Hilbert lattice. Lemma 5 of [Maeda] p. 168. (Contributed by NM, 6-Jul-2004.) (New usage is discouraged.)
theorem mdsym (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wbr A2 B2 cmd) (wbr B2 A2 cmd)) $;

--| Dual M-symmetry of the Hilbert lattice. (Contributed by NM, 25-Jul-2007.) (New usage is discouraged.)
theorem dmdsym (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cch)) (wb (wbr A2 B2 cdmd) (wbr B2 A2 cdmd)) $;

--| Two Hilbert lattice elements have the dual modular pair property if the second is an atom. (Contributed by NM, 6-Jul-2004.) (New usage is discouraged.)
theorem atdmd2 (A2 B2: class):
  $ wi (wa (wcel A2 cch) (wcel B2 cat)) (wbr A2 B2 cdmd) $;

--| If the subspace sum of two Hilbert lattice elements is closed, then the elements are a dual modular pair. Remark in [MaedaMaeda] p. 139. (Contributed by NM, 12-Jul-2004.) (New usage is discouraged.)
theorem sumdmdii (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi (wceq (co A2 B2 cph) (co A2 B2 chj)) (wbr A2 B2 cdmd) $;

--| Commuting subspaces form a modular pair. (Contributed by NM, 16-Jan-2005.) (New usage is discouraged.)
theorem cmmdi (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi (wbr A2 B2 ccm) (wbr A2 B2 cmd) $;

--| Commuting subspaces form a dual modular pair. (Contributed by NM, 25-Apr-2006.) (New usage is discouraged.)
theorem cmdmdi (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi (wbr A2 B2 ccm) (wbr A2 B2 cdmd) $;

--| Lemma for ~ sumdmdi . The span of vector ` C ` not in the subspace sum is "trimmed off." (Contributed by NM, 18-Dec-2004.) (New usage is discouraged.)
theorem sumdmdlem (A2 B2 C: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi (wa (wcel C chba) (wn (wcel C (co A2 B2 cph)))) (wceq (cin (co B2 (cfv (csn C) cspn) cph) A2) (cin B2 A2)) $;

--| Lemma for ~ sumdmdi . (Contributed by NM, 23-Dec-2004.) (New usage is discouraged.)
theorem sumdmdlem2 {x3: setvar} (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wi (wral x3 (wss (cin (co (cv x3) B2 chj) (co A2 B2 chj)) (co (cin (co (cv x3) B2 chj) A2) B2 chj)) cat) (wceq (co A2 B2 cph) (co A2 B2 chj)) $;

--| The subspace sum of two Hilbert lattice elements is closed iff the elements are a dual modular pair. Theorem 2 of [Holland] p. 1519. (Contributed by NM, 14-Dec-2004.) (New usage is discouraged.)
theorem sumdmdi (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wceq (co A2 B2 cph) (co A2 B2 chj)) (wbr A2 B2 cdmd) $;

--| Dual modular pair property in terms of atoms. (Contributed by NM, 15-Jan-2005.) (New usage is discouraged.)
theorem dmdbr4ati {x3: setvar} (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wbr A2 B2 cdmd) (wral x3 (wss (cin (co (cv x3) B2 chj) (co A2 B2 chj)) (co (cin (co (cv x3) B2 chj) A2) B2 chj)) cat) $;

--| Dual modular pair property in terms of atoms. (Contributed by NM, 14-Jan-2005.) (New usage is discouraged.)
theorem dmdbr5ati {x3: setvar} (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wbr A2 B2 cdmd) (wral x3 (wi (wss (cv x3) (co A2 B2 chj)) (wss (cv x3) (co (cin (co (cv x3) B2 chj) A2) B2 chj))) cat) $;

--| Dual modular pair property in terms of atoms. The modular law takes the form of the shearing identity. (Contributed by NM, 18-Jan-2005.) (New usage is discouraged.)
theorem dmdbr6ati {x3: setvar} (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wbr A2 B2 cdmd) (wral x3 (wceq (cin (co A2 B2 chj) (cv x3)) (cin (co (cin (co (cv x3) B2 chj) A2) B2 chj) (cv x3))) cat) $;

--| Dual modular pair property in terms of atoms. (Contributed by NM, 18-Jan-2005.) (New usage is discouraged.)
theorem dmdbr7ati {x3: setvar} (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wbr A2 B2 cdmd) (wral x3 (wss (cin (co A2 B2 chj) (cv x3)) (co (cin (co (cv x3) B2 chj) A2) B2 chj)) cat) $;

--| Orthocomplements form a modular pair. (Contributed by NM, 29-Apr-2006.) (New usage is discouraged.)
theorem mdoc1i (A2: class):
  $ wcel A2 cch $ >
  $ wbr A2 (cfv A2 cort) cmd $;

--| Orthocomplements form a modular pair. (Contributed by NM, 29-Apr-2006.) (New usage is discouraged.)
theorem mdoc2i (A2: class):
  $ wcel A2 cch $ >
  $ wbr (cfv A2 cort) A2 cmd $;

--| Orthocomplements form a dual modular pair. (Contributed by NM, 29-Apr-2006.) (New usage is discouraged.)
theorem dmdoc1i (A2: class):
  $ wcel A2 cch $ >
  $ wbr A2 (cfv A2 cort) cdmd $;

--| Orthocomplements form a dual modular pair. (Contributed by NM, 29-Apr-2006.) (New usage is discouraged.)
theorem dmdoc2i (A2: class):
  $ wcel A2 cch $ >
  $ wbr (cfv A2 cort) A2 cdmd $;

--| A condition equivalent to the modular pair property. Part of proof of Theorem 1.14 of [MaedaMaeda] p. 4. (Contributed by NM, 29-Apr-2006.) (New usage is discouraged.)
theorem mdcompli (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wbr A2 B2 cmd) (wbr (cin A2 (cfv (cin A2 B2) cort)) (cin B2 (cfv (cin A2 B2) cort)) cmd) $;

--| A condition equivalent to the dual modular pair property. (Contributed by NM, 29-Apr-2006.) (New usage is discouraged.)
theorem dmdcompli (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wb (wbr A2 B2 cdmd) (wbr (cin A2 (cfv (cin A2 B2) cort)) (cin B2 (cfv (cin A2 B2) cort)) cdmd) $;

--| If dual modular implies modular whenever meet is zero, then dual modular implies modular for arbitrary lattice elements. This theorem is needed for the remark after Lemma 7 of [Holland] p. 1524 to hold. (Contributed by NM, 29-Apr-2006.) (New usage is discouraged.)
theorem mddmdin0i {x3 y1: setvar} (A2 B2: class):
  $ wcel A2 cch $ >
  $ wcel B2 cch $ >
  $ wral x3 (wral y1 (wi (wa (wbr (cv x3) (cv y1) cdmd) (wceq (cin (cv x3) (cv y1)) c0h)) (wbr (cv x3) (cv y1) cmd)) cch) cch $ >
  $ wi (wbr A2 B2 cdmd) (wbr A2 B2 cmd) $;

--| A member of the sum of disjoint subspaces has a unique decomposition. Part of Lemma 5 of [Holland] p. 1520. (Contributed by NM, 20-May-2005.) (New usage is discouraged.)
theorem cdjreui {x3 y1: setvar} (A2 B2 C: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wi (wa (wcel C (co A2 B2 cph)) (wceq (cin A2 B2) c0h)) (wreu x3 (wrex y1 (wceq C (co (cv x3) (cv y1) cva)) B2) A2) $;

--| Two ways to express " ` A ` and ` B ` are completely disjoint subspaces." (1) => (2) in Lemma 5 of [Holland] p. 1520. (Contributed by NM, 21-May-2005.) (New usage is discouraged.)
theorem cdj1i {x3 y1 z w v: setvar} (A2: class v) (B2: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wi (wrex w (wa (wbr cc0 (cv w) clt) (wral y1 (wral v (wbr (co (cfv (cv y1) cno) (cfv (cv v) cno) caddc) (co (cv w) (cfv (co (cv y1) (cv v) cva) cno) cmul) cle) B2) A2)) cr) (wrex x3 (wa (wbr cc0 (cv x3) clt) (wral y1 (wral z (wi (wceq (cfv (cv y1) cno) c1) (wbr (cv x3) (cfv (co (cv y1) (cv z) cmv) cno) cle)) B2) A2)) cr) $;

--| A property of " ` A ` and ` B ` are completely disjoint subspaces." Part of Lemma 5 of [Holland] p. 1520. (Contributed by NM, 23-May-2005.) (New usage is discouraged.)
theorem cdj3lem1 {x3 y1 z: setvar} (A2 B2: class):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wi (wrex x3 (wa (wbr cc0 (cv x3) clt) (wral y1 (wral z (wbr (co (cfv (cv y1) cno) (cfv (cv z) cno) caddc) (co (cv x3) (cfv (co (cv y1) (cv z) cva) cno) cmul) cle) B2) A2)) cr) (wceq (cin A2 B2) c0h) $;

--| Lemma for ~ cdj3i . Value of the first-component function ` S ` . (Contributed by NM, 23-May-2005.) (New usage is discouraged.)
theorem cdj3lem2 {x3 z w: setvar} (A2 B2 C D: class) (S: class x3 z w):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wceq S (cmpt x3 (co A2 B2 cph) (crio z (wrex w (wceq (cv x3) (co (cv z) (cv w) cva)) B2) A2)) $ >
  $ wi (w3a (wcel C A2) (wcel D B2) (wceq (cin A2 B2) c0h)) (wceq (cfv (co C D cva) S) C) $;

--| Lemma for ~ cdj3i . Closure of the first-component function ` S ` . (Contributed by NM, 25-May-2005.) (New usage is discouraged.)
theorem cdj3lem2a {x3 z w: setvar} (A2 B2 C: class) (S: class x3 z w):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wceq S (cmpt x3 (co A2 B2 cph) (crio z (wrex w (wceq (cv x3) (co (cv z) (cv w) cva)) B2) A2)) $ >
  $ wi (wa (wcel C (co A2 B2 cph)) (wceq (cin A2 B2) c0h)) (wcel (cfv C S) A2) $;

--| Lemma for ~ cdj3i . The first-component function ` S ` is bounded if the subspaces are completely disjoint. (Contributed by NM, 26-May-2005.) (New usage is discouraged.)
theorem cdj3lem2b {x3 y1 z w v u: setvar} (A2 B2: class) (S: class x3 y1 z w):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wceq S (cmpt x3 (co A2 B2 cph) (crio z (wrex w (wceq (cv x3) (co (cv z) (cv w) cva)) B2) A2)) $ >
  $ wi (wrex v (wa (wbr cc0 (cv v) clt) (wral x3 (wral y1 (wbr (co (cfv (cv x3) cno) (cfv (cv y1) cno) caddc) (co (cv v) (cfv (co (cv x3) (cv y1) cva) cno) cmul) cle) B2) A2)) cr) (wrex v (wa (wbr cc0 (cv v) clt) (wral u (wbr (cfv (cfv (cv u) S) cno) (co (cv v) (cfv (cv u) cno) cmul) cle) (co A2 B2 cph))) cr) $;

--| Lemma for ~ cdj3i . Value of the second-component function ` T ` . (Contributed by NM, 23-May-2005.) (New usage is discouraged.)
theorem cdj3lem3 {x3 z w: setvar} (A2 B2 C D: class) (T: class x3 z w):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wceq T (cmpt x3 (co A2 B2 cph) (crio w (wrex z (wceq (cv x3) (co (cv z) (cv w) cva)) A2) B2)) $ >
  $ wi (w3a (wcel C A2) (wcel D B2) (wceq (cin A2 B2) c0h)) (wceq (cfv (co C D cva) T) D) $;

--| Lemma for ~ cdj3i . Closure of the second-component function ` T ` . (Contributed by NM, 26-May-2005.) (New usage is discouraged.)
theorem cdj3lem3a {x3 z w: setvar} (A2 B2 C: class) (T: class x3 z w):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wceq T (cmpt x3 (co A2 B2 cph) (crio w (wrex z (wceq (cv x3) (co (cv z) (cv w) cva)) A2) B2)) $ >
  $ wi (wa (wcel C (co A2 B2 cph)) (wceq (cin A2 B2) c0h)) (wcel (cfv C T) B2) $;

--| Lemma for ~ cdj3i . The second-component function ` T ` is bounded if the subspaces are completely disjoint. (Contributed by NM, 31-May-2005.) (New usage is discouraged.)
theorem cdj3lem3b {x3 y1 z w v u: setvar} (A2 B2: class) (T: class x3 y1 z w):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wceq T (cmpt x3 (co A2 B2 cph) (crio w (wrex z (wceq (cv x3) (co (cv z) (cv w) cva)) A2) B2)) $ >
  $ wi (wrex v (wa (wbr cc0 (cv v) clt) (wral x3 (wral y1 (wbr (co (cfv (cv x3) cno) (cfv (cv y1) cno) caddc) (co (cv v) (cfv (co (cv x3) (cv y1) cva) cno) cmul) cle) B2) A2)) cr) (wrex v (wa (wbr cc0 (cv v) clt) (wral u (wbr (cfv (cfv (cv u) T) cno) (co (cv v) (cfv (cv u) cno) cmul) cle) (co A2 B2 cph))) cr) $;

--| Two ways to express " ` A ` and ` B ` are completely disjoint subspaces." (1) <=> (3) in Lemma 5 of [Holland] p. 1520. (Contributed by NM, 1-Jun-2005.) (New usage is discouraged.)
theorem cdj3i {x3 y1 z w v u: setvar} (ph ps: wff x3 y1 z w v u) (A2 B2: class) (S T: class x3 y1 z w):
  $ wcel A2 csh $ >
  $ wcel B2 csh $ >
  $ wceq S (cmpt x3 (co A2 B2 cph) (crio z (wrex w (wceq (cv x3) (co (cv z) (cv w) cva)) B2) A2)) $ >
  $ wceq T (cmpt x3 (co A2 B2 cph) (crio w (wrex z (wceq (cv x3) (co (cv z) (cv w) cva)) A2) B2)) $ >
  $ wb ph (wrex v (wa (wbr cc0 (cv v) clt) (wral u (wbr (cfv (cfv (cv u) S) cno) (co (cv v) (cfv (cv u) cno) cmul) cle) (co A2 B2 cph))) cr) $ >
  $ wb ps (wrex v (wa (wbr cc0 (cv v) clt) (wral u (wbr (cfv (cfv (cv u) T) cno) (co (cv v) (cfv (cv u) cno) cmul) cle) (co A2 B2 cph))) cr) $ >
  $ wb (wrex v (wa (wbr cc0 (cv v) clt) (wral x3 (wral y1 (wbr (co (cfv (cv x3) cno) (cfv (cv y1) cno) caddc) (co (cv v) (cfv (co (cv x3) (cv y1) cva) cno) cmul) cle) B2) A2)) cr) (w3a (wceq (cin A2 B2) c0h) ph ps) $;

--| (_This theorem is a dummy placeholder for these guidelines. The label of this theorem, "mathbox", is hard-coded into the Metamath program to identify the start of the mathbox section for web page generation_.) A "mathbox" is a user-contributed section that is maintained by its contributor independently from the main part of set.mm. _For contributors_: By making a contribution, you agree to release it into the public domain, according to the statement at the beginning of set.mm. Mathboxes are provided to help keep your work synchronized with changes in set.mm while allowing you to work independently without affecting other contributors. Even though in a sense your mathbox belongs to you, it is still part of the shared body of knowledge contained in set.mm, and occasionally other people may make maintenance edits to your mathbox for things like keeping it synchronized with the rest of set.mm, reducing proof lengths, moving your theorems to the main part of set.mm when needed, and fixing typos or other errors. If you want to preserve it the way you left it, you can keep a local copy or keep track of the GitHub commit number. _Guidelines_: 1. See ~ conventions for our general style guidelines. For contributing via GitHub, see ~ https://github.com/metamath/set.mm/blob/develop/CONTRIBUTING.md . The Metamath program command "verify markup *" will check that you have followed many of the conventions we use. 2. If at all possible, please use only nullary class constants for new definitions, for example as in ~ df-div . 3. Each $p and $a statement must be immediately preceded with the comment that will be shown on its web page description. The Metamath program "MM> WRITE SOURCE set.mm / REWRAP" command will take care of indentation conventions and line wrapping. 4. All mathbox content will be on public display and should hopefully reflect the overall quality of the website. 5. Mathboxes must be independent from one another (checked by "verify markup *"). If you need a theorem from another mathbox, typically it is moved to the main part of set.mm. New users should consult with more experienced users before doing this. 6. If a contributor is no longer active, we will continue the usual maintenance edits. As time goes on, often theorems will be moved to main or removed in favor of similar replacements. But we are also willing to maintain mathboxes in place, as work by others from years ago may form the foundation of future work; you could even argue that all of mathematics is like that. 7. For theorems of importance (for example, a Metamath 100 theorem or a dependency of one), we prefer to eventually move them out of mathboxes (although a mathbox is perfectly appropriate as proofs are being developed and refined). (Contributed by NM, 20-Feb-2007.) (Revised by the Metamath team, 9-Sep-2023.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem mathbox (ph: wff):
  $ ph $ >
  $ ph $;

--| Non-collinearity of triangle ` A B C ` implies distinct vertices ` A ` and ` C ` . (Contributed by JAG, 12-Aug-2026.)
theorem tgacne (ph: wff) (A2 B2 C P G I L: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wn (wo (wcel C (co A2 B2 L)) (wceq A2 B2))) $ >
  $ wi ph (wne A2 C) $;

--| Non-collinearity of triangle ` A B C ` implies distinct vertices ` B ` and ` C ` . (Contributed by JAG, 12-Aug-2026.)
theorem tgbcne (ph: wff) (A2 B2 C P G I L: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wn (wo (wcel C (co A2 B2 L)) (wceq A2 B2))) $ >
  $ wi ph (wne B2 C) $;

--| Two null angles are congruent: if ` A ` and ` C ` lie on one half-line from ` B ` , and ` D ` and ` F ` on one half-line from ` E ` , then angle ` <" A B C "> ` is congruent to ` <" D E F "> ` . This is GeoCoq l11__21__b ; set.mm has only the converse, ~ cgrahl (GeoCoq l11__21__a ). Proved by copying both arms onto the target rays with ~ hlcgrex and closing the third side by segment subtraction ( ~ tgcgrsub2 ), so it needs no non-collinear frame. (Contributed by JAG, 12-Aug-2026.)
theorem cgrahlb (ph: wff) (A2 B2 C D P E F G I K c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr A2 C (cfv B2 K)) $ >
  $ wi ph (wbr D F (cfv E K)) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) $;

--| A flat sub-angle forces the containing angle flat: if ` W ` is inside angle ` <" D E F "> ` and ` E ` lies between ` D ` and ` W ` , then ` E ` lies between ` D ` and ` F ` . This is GeoCoq bet__in__angle__bet. Proved by unfolding ~ isinag and following its segment point. (Contributed by JAG, 12-Aug-2026.)
theorem inagbtwn (ph: wff) (D P E F G I K W: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wbr W (cs3 D E F) (cfv G cinag)) $ >
  $ wi ph (wcel E (co D W I)) $ >
  $ wi ph (wcel E (co D F I)) $;

--| In-angle transport, degenerate branch (i): the sub-angle ` <" D E W "> ` is **null**, ` W ` lying on ray ` E D ` . The witness is not constructed -- it is ` X ` , the target's own first arm -- and ~ cgrahlb supplies the copied angle from the two ray degeneracies. No GeoCoq counterpart: GeoCoq's branch only locates a witness supplied by its universal statement. (Contributed by JAG, 12-Aug-2026.)
theorem inagcgrasubhl {v: setvar} (ph: wff) (D P E F G I K W X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wbr (cs3 D E F) (cs3 X Y Z) (cfv G ccgra)) $ >
  $ wi ph (wbr D W (cfv E K)) $ >
  $ wi ph (wrex v (wa (wbr (cv v) (cs3 X Y Z) (cfv G cinag)) (wbr (cs3 D E W) (cs3 X Y (cv v)) (cfv G ccgra))) P) $;

--| In-angle transport, degenerate branch (ii): the sub-angle ` <" D E W "> ` is **flat**, ` E ` lying between ` D ` and ` W ` . The witness is built beyond ` Y ` on the ray opposite ` Y X ` with ~ axtgsegcon , and ~ flatcgra supplies the copied angle from the two betweennesses. The in-angle conjunct goes through ~ inagbtwn , which carries the flatness up to the containing angle, then ~ cgrabtwn across the congruence and ~ isinagd on the target. (Contributed by JAG, 12-Aug-2026.)
theorem inagcgrasubbtwn {v: setvar} (ph: wff) (D P E F G I K W X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wbr W (cs3 D E F) (cfv G cinag)) $ >
  $ wi ph (wbr (cs3 D E F) (cs3 X Y Z) (cfv G ccgra)) $ >
  $ wi ph (wcel E (co D W I)) $ >
  $ wi ph (wrex v (wa (wbr (cv v) (cs3 X Y Z) (cfv G cinag)) (wbr (cs3 D E W) (cs3 X Y (cv v)) (cfv G ccgra))) P) $;

--| In-angle transport, degenerate branch (iii): the containing angle is **flat** while the sub-angle is not. This is the ` x = E ` disjunct of ~ isinag , which the non-degenerate spine cannot reach. Unlike branches (i) and (ii) the copied angle must be *constructed*: the congruence hypothesis relates ` W ` to nothing on the target side, and ~ acopy needs a point off line ` X Y ` to pick a side, which the collinear ` Z ` cannot be. ~ ncoltgdim2 takes the dimension from this branch's own non-collinearity and ~ tglowdim2ln produces that point. (Contributed by JAG, 12-Aug-2026.)
theorem inagcgrabtwn {v: setvar} (ph: wff) (D P E F G I K L W X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wbr (cs3 D E F) (cs3 X Y Z) (cfv G ccgra)) $ >
  $ wi ph (wcel E (co D F I)) $ >
  $ wi ph (wn (wo (wcel W (co D E L)) (wceq D E))) $ >
  $ wi ph (wrex v (wa (wbr (cv v) (cs3 X Y Z) (cfv G cinag)) (wbr (cs3 D E W) (cs3 X Y (cv v)) (cfv G ccgra))) P) $;

--| Ray normalization: an angle congruence yields two points on the target rays carrying a full triangle congruence, together with the two arm lengths. This is the forward direction of ~ iscgra (Schwabhauser 11.3) repackaged -- nothing is constructed; the distances are read off the ` cgrG ` with ~ cgr3simp1 and ~ cgr3simp2 . No non-degeneracy hypothesis is needed or wanted: ` cgrA ` carries vertex distinctness intrinsically ( ~ cgrane1 through ~ cgrane4 ), and an extra hypothesis would obstruct the degenerate branches. (Contributed by JAG, 12-Aug-2026.)
theorem iscgrag {x3 y1: setvar} (ph: wff) (A2 B2 C D P E F G I K c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) $ >
  $ wi ph (wrex x3 (wrex y1 (wa (w3a (wbr (cs3 A2 B2 C) (cs3 (cv x3) E (cv y1)) (cfv G ccgrg)) (wbr (cv x3) D (cfv E K)) (wbr (cv y1) F (cfv E K))) (wa (wceq (co E (cv x3) c_mi) (co B2 A2 c_mi)) (wceq (co E (cv y1) c_mi) (co B2 C c_mi)))) P) P) $;

--| Transfer a segment point across a triangle congruence: given ` <" A B C "> cgrG <" X E Z "> ` and ` J ` between ` A ` and ` C ` , the corresponding point on ` ( X I Z ) ` exists, with its betweenness, its two distances and the sub-triangle congruence. GeoCoq reaches this through l4__6 and cong2__conga__cong ; here ~ cgrg3col4 (Schwabhauser 11.28) constructs the point with every pairwise distance and ~ tgbtwnxfr -- which *is* l4__6 -- supplies the image betweenness. The ` A = C ` case takes ~ cgrg3col4 's right disjunct, since ~ tgellng needs ` A =/= C ` and ` cgrA ` does not supply it. (Contributed by JAG, 12-Aug-2026.)
theorem cgrgptxfr {y1: setvar} (ph: wff) (A2 B2 C P E G I J c_mi X Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel J P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 X E Z) (cfv G ccgrg)) $ >
  $ wi ph (wcel J (co A2 C I)) $ >
  $ wi ph (wrex y1 (wa (wa (wcel (cv y1) (co X Z I)) (wbr (cs3 A2 B2 J) (cs3 X E (cv y1)) (cfv G ccgrg))) (wa (wceq (co A2 J c_mi) (co X (cv y1) c_mi)) (wceq (co J C c_mi) (co (cv y1) Z c_mi)))) P) $;

--| In-angle transport, the non-degenerate main case, with its three constructions carried as hypotheses: ` J ` the segment point from ~ isinag , ` S ` and ` T ` the normalized target arms from ~ iscgrag , and ` Q ` the transferred point from ~ cgrgptxfr . Concludes the body of ~ cgrainag 's existential at the witness ` Q ` . **No ~ acopy and no half-plane fact**: the witness is the transferred point, not a fresh angle copy, which is what removes the non-collinearity obligations. (Contributed by JAG, 12-Aug-2026.)
theorem inagcgratrgmain (ph: wff) (D P Q S T E G I J K c_mi W X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel J P) $ >
  $ wi ph (wcel S P) $ >
  $ wi ph (wcel T P) $ >
  $ wi ph (wcel Q P) $ >
  $ wi ph (wne D E) $ >
  $ wi ph (wbr J W (cfv E K)) $ >
  $ wi ph (wbr S X (cfv Y K)) $ >
  $ wi ph (wbr T Z (cfv Y K)) $ >
  $ wi ph (wcel Q (co S T I)) $ >
  $ wi ph (wbr (cs3 D E J) (cs3 S Y Q) (cfv G ccgrg)) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wa (wbr Q (cs3 X Y Z) (cfv G cinag)) (wbr (cs3 D E W) (cs3 X Y Q) (cfv G ccgra))) $;

--| ~ inagcgratrgmain with the existential introduced at its own witness ` Q ` . Split out so that the substitution instance is built once, at the top level, rather than under the existential eliminations that produce ` S ` , ` T ` and ` Q ` . (Contributed by JAG, 12-Aug-2026.)
theorem inagcgratrgw {v: setvar} (ph: wff) (D P Q S T E G I J K W X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel J P) $ >
  $ wi ph (wcel S P) $ >
  $ wi ph (wcel T P) $ >
  $ wi ph (wcel Q P) $ >
  $ wi ph (wne D E) $ >
  $ wi ph (wbr J W (cfv E K)) $ >
  $ wi ph (wbr S X (cfv Y K)) $ >
  $ wi ph (wbr T Z (cfv Y K)) $ >
  $ wi ph (wcel Q (co S T I)) $ >
  $ wi ph (wbr (cs3 D E J) (cs3 S Y Q) (cfv G ccgrg)) $ >
  $ wi ph (wrex v (wa (wbr (cv v) (cs3 X Y Z) (cfv G cinag)) (wbr (cs3 D E W) (cs3 X Y (cv v)) (cfv G ccgra))) P) $;

--| In-angle transport with the target arms already normalized to ` S ` and ` T ` : ~ cgrgptxfr transfers the segment point ` J ` to a point of ` ( S I T ) ` , and that one existential is eliminated here. (Contributed by JAG, 12-Aug-2026.)
theorem inagcgratrgxfr {v: setvar} (ph: wff) (D P S T E F G I J K W X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel J P) $ >
  $ wi ph (wcel S P) $ >
  $ wi ph (wcel T P) $ >
  $ wi ph (wne D E) $ >
  $ wi ph (wcel J (co D F I)) $ >
  $ wi ph (wbr J W (cfv E K)) $ >
  $ wi ph (wbr S X (cfv Y K)) $ >
  $ wi ph (wbr T Z (cfv Y K)) $ >
  $ wi ph (wbr (cs3 D E F) (cs3 S Y T) (cfv G ccgrg)) $ >
  $ wi ph (wrex v (wa (wbr (cv v) (cs3 X Y Z) (cfv G cinag)) (wbr (cs3 D E W) (cs3 X Y (cv v)) (cfv G ccgra))) P) $;

--| In-angle transport once the segment point ` J ` of ~ isinag is on the ray ` E W ` : ~ iscgrag normalizes the target arms and its two existentials are eliminated here, leaving ~ inagcgratrgxfr to do the transfer. (Contributed by JAG, 12-Aug-2026.)
theorem inagcgratrgncol {v: setvar} (ph: wff) (D P E F G I J K W X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wbr (cs3 D E F) (cs3 X Y Z) (cfv G ccgra)) $ >
  $ wi ph (wcel J P) $ >
  $ wi ph (wne D E) $ >
  $ wi ph (wcel J (co D F I)) $ >
  $ wi ph (wbr J W (cfv E K)) $ >
  $ wi ph (wrex v (wa (wbr (cv v) (cs3 X Y Z) (cfv G cinag)) (wbr (cs3 D E W) (cs3 X Y (cv v)) (cfv G ccgra))) P) $;

--| In-angle transport, non-collinear case: unfold ~ isinag , eliminate its segment-point existential, and dispatch on the disjunct it carries -- ` x = E ` to ~ inagcgrabtwn , ` x ( K `` E ) W ` to ~ inagcgratrgncol . (Contributed by JAG, 12-Aug-2026.)
theorem inagcgratrgn {v: setvar} (ph: wff) (D P E F G I K L W X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wbr (cs3 D E F) (cs3 X Y Z) (cfv G ccgra)) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wbr W (cs3 D E F) (cfv G cinag)) $ >
  $ wi ph (wn (wo (wcel W (co D E L)) (wceq D E))) $ >
  $ wi ph (wrex v (wa (wbr (cv v) (cs3 X Y Z) (cfv G cinag)) (wbr (cs3 D E W) (cs3 X Y (cv v)) (cfv G ccgra))) P) $;

--| If ` C ` lies inside angle ` <" A B Y "> ` , then angle ` <" A B C "> ` is less than or equal to ` <" A B Y "> ` . (Contributed by JAG, 12-Aug-2026.)
theorem inaglea (ph: wff) (A2 B2 C P G I K Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wbr C (cs3 A2 B2 Y) (cfv G cinag)) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 A2 B2 Y) (cfv G cleag)) $;

--| Target-side in-angle transport: if ` W ` lies inside angle ` <" D E F "> ` and that angle is congruent to ` <" X Y Z "> ` , then some point inside ` <" X Y Z "> ` makes ` <" X Y v "> ` congruent to the sub-angle ` <" D E W "> ` . The geometric core of ~ leawittrg . (Contributed by JAG, 12-Aug-2026.)
theorem cgrainag {v: setvar} (ph: wff) (D P E F G I K W X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wbr W (cs3 D E F) (cfv G cinag)) $ >
  $ wi ph (wbr (cs3 D E F) (cs3 X Y Z) (cfv G ccgra)) $ >
  $ wi ph (wrex v (wa (wbr (cv v) (cs3 X Y Z) (cfv G cinag)) (wbr (cs3 D E W) (cs3 X Y (cv v)) (cfv G ccgra))) P) $;

--| Target-side ` leA ` witness transport: move a witness inside ` <" D E F "> ` across a congruent target angle ` <" X Y Z "> ` , carrying the angle ` <" H U J "> ` copied at that witness with it. (Contributed by JAG, 12-Aug-2026.)
theorem leawittrg {v: setvar} (ph: wff) (D P U E F G H I J K W X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel H P) $ >
  $ wi ph (wcel U P) $ >
  $ wi ph (wcel J P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wbr W (cs3 D E F) (cfv G cinag)) $ >
  $ wi ph (wbr (cs3 H U J) (cs3 D E W) (cfv G ccgra)) $ >
  $ wi ph (wbr (cs3 D E F) (cs3 X Y Z) (cfv G ccgra)) $ >
  $ wi ph (wrex v (wa (wbr (cv v) (cs3 X Y Z) (cfv G cinag)) (wbr (cs3 H U J) (cs3 X Y (cv v)) (cfv G ccgra))) P) $;

--| Target-side ` leA ` transport: replacing the larger angle by a congruent angle preserves the angle order. Proved from ~ leawittrg and ~ isleag , the witness form of ` leA ` . (Contributed by JAG, 12-Aug-2026.)
theorem leacgra2 (ph: wff) (A2 B2 C D P E F G I K X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 X Y Z) (cfv G cleag)) $ >
  $ wi ph (wbr (cs3 X Y Z) (cs3 D E F) (cfv G ccgra)) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G cleag)) $;

--| Source-side ` leA ` transport: replacing the smaller angle by a congruent angle preserves the angle order. The counterpart of ~ leacgra2 , proved directly from the witness form of ` leA ` ( ~ isleag , ~ isleagd ). (Contributed by JAG, 12-Aug-2026.)
theorem leacgra1 (ph: wff) (A2 B2 C D P U E F G H I J K: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel H P) $ >
  $ wi ph (wcel U P) $ >
  $ wi ph (wcel J P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G cleag)) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 H U J) (cfv G ccgra)) $ >
  $ wi ph (wbr (cs3 H U J) (cs3 D E F) (cfv G cleag)) $;

--| GeoCoq l11__30 analogue: ` leA ` is preserved when both compared angles are replaced by congruent angles. (Contributed by JAG, 12-Aug-2026.)
theorem leacgra (ph: wff) (A2 B2 C D P U E F G H I J K c_le X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wceq c_le (cfv G cleag) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel H P) $ >
  $ wi ph (wcel U P) $ >
  $ wi ph (wcel J P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) c_le) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 H U J) (cfv G ccgra)) $ >
  $ wi ph (wbr (cs3 D E F) (cs3 X Y Z) (cfv G ccgra)) $ >
  $ wi ph (wbr (cs3 H U J) (cs3 X Y Z) c_le) $;

--| Reflecting ` B ` through the midpoint of ` A ` and ` C ` carries triangle ` C A B ` onto ` A C P ` , where ` P ` is the reflected point. The dimension condition the mid* family carries is discharged from the non-collinearity through ~ ncoltgdim2 , not taken as a hypothesis. (Contributed by JAG, 12-Aug-2026.)
theorem tgmircgrg (ph: wff) (A2 B2 C P G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wn (wo (wcel A2 (co B2 C L)) (wceq B2 C))) $ >
  $ wi ph (wbr (cs3 C A2 B2) (cs3 A2 C (cfv B2 (cfv (co A2 C (cfv G cmid)) (cfv G cmir)))) (cfv G ccgrg)) $;

--| The angle congruence the exterior-angle theorem opens with: the interior angle at ` A ` in triangle ` C A B ` is congruent to the angle at ` C ` in the midpoint-reflected triangle. This is ~ cgrcgra over ~ tgmircgrg ; the vertex distinctnesses come from the non-collinearity via ~ tgbcne and ~ tgacne . (Contributed by JAG, 12-Aug-2026.)
theorem tgmircgra (ph: wff) (A2 B2 C P G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wn (wo (wcel A2 (co B2 C L)) (wceq B2 C))) $ >
  $ wi ph (wbr (cs3 C A2 B2) (cs3 A2 C (cfv B2 (cfv (co A2 C (cfv G cmid)) (cfv G cmir)))) (cfv G ccgra)) $;

--| The midpoint-reflected point is off line ` A C ` . If it were on that line, ~ mirln -- whose centre-on-the-line hypothesis is the midpoint, itself on ` A C ` -- would put its reflection there too, and ~ mirmir says that reflection is ` B ` , contradicting the triangle's non-collinearity. This is the strengthening ` inA ` cannot give: it is what turns "inside the angle" into an open half-plane fact. (Contributed by JAG, 12-Aug-2026.)
theorem tgextamirn (ph: wff) (A2 B2 C P G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wn (wo (wcel A2 (co B2 C L)) (wceq B2 C))) $ >
  $ wi ph (wn (wcel (cfv B2 (cfv (co A2 C (cfv G cmid)) (cfv G cmir))) (co A2 C L))) $;

--| The target-side non-collinearity of the exterior angle. Line ` C D ` is line ` C B ` -- ` C ` lies between ` B ` and ` D ` , and ` C =/= D ` -- so ` A ` is off it exactly because the triangle is non-degenerate. This is ~ acopyeu 's acopy.2 frame hypothesis in ~ tgextancgra , and it is what excludes ~ isinag 's ` x = C ` branch in ~ tgextahp . (Contributed by JAG, 12-Aug-2026.)
theorem tgextancd (ph: wff) (A2 B2 C D P G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel C (co B2 D I)) $ >
  $ wi ph (wn (wo (wcel A2 (co B2 C L)) (wceq B2 C))) $ >
  $ wi ph (wne C D) $ >
  $ wi ph (wn (wo (wcel A2 (co C D L)) (wceq C D))) $;

--| The generic open half-plane core. From a point ` X ` between ` A ` and ` D ` that is on the half-line from ` C ` through ` W ` , with ` W ` off line ` A C ` , both ` X ` and ` D ` and both ` X ` and ` W ` land on the same side of line ` A C ` (two ~ colhp applications), and ~ hpgcom / ~ hpgtr compose them. ` X =/= C ` is read off .xk by ~ hlne1 , so no ` x = C ` case reaches here. The $d s are on proof dummies only -- ~ colhp 's class abstraction needs its own bound variables -- so nothing propagates to callers. (Contributed by JAG, 12-Aug-2026.)
theorem tgextahpl (ph: wff) (A2 C D P G I K L c_mi W X: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wn (wo (wcel A2 (co C D L)) (wceq C D))) $ >
  $ wi ph (wn (wcel W (co A2 C L))) $ >
  $ wi ph (wcel X (co A2 D I)) $ >
  $ wi ph (wbr X W (cfv C K)) $ >
  $ wi ph (wbr W D (cfv (co A2 C L) (cfv G chpg))) $;

--| The point obtained by reflecting ` B ` through the midpoint of ` A ` and ` C ` lies inside the exterior angle ` <" A C D "> ` . Proved by Pasch on the midpoint and the extension, turned into an in-angle statement with ~ isinagd and moved from ray ` C M ` to ray ` C A ` by ~ inaghl . (Contributed by JAG, 12-Aug-2026.)
theorem tgextalem1inag (ph: wff) (A2 B2 C D P G I K L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel C (co B2 D I)) $ >
  $ wi ph (wn (wo (wcel A2 (co B2 C L)) (wceq B2 C))) $ >
  $ wi ph (wne C D) $ >
  $ wi ph (wbr (cfv B2 (cfv (co A2 C (cfv G cmid)) (cfv G cmir))) (cs3 A2 C D) (cfv G cinag)) $;

--| The non-strict exterior-angle bound, a checkpoint only. ~ tgmircgra gives the reflected copy of the interior angle, ~ tgextalem1inag puts that copy inside the exterior angle; ~ inaglea turns "inside" into ` leA ` and ~ leacgra1 transports the bound along the congruence (flipped with ~ cgracom ). No new geometry. This bound is deliberately too weak for ~ tgaas , whose contradiction branch already holds an angle congruence and so satisfies ` leA ` for free -- strictness comes later, and only ~ tgexta is the exterior-angle theorem. (Contributed by JAG, 12-Aug-2026.)
theorem tgextale (ph: wff) (A2 B2 C D P G I K L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel C (co B2 D I)) $ >
  $ wi ph (wn (wo (wcel A2 (co B2 C L)) (wceq B2 C))) $ >
  $ wi ph (wne C D) $ >
  $ wi ph (wbr (cs3 C A2 B2) (cs3 A2 C D) (cfv G cleag)) $;

--| The midpoint-reflected point is not on the ray from ` C ` through ` D ` . If it were, then -- ray ` C D ` being the extension of ` B C ` -- it would lie on line ` C B ` ; ~ mirln2 , the converse of the ~ mirln used in ~ tgextamirn , would put the midpoint of ` A ` and ` C ` on that line too; and the midpoint is collinear with ` A ` and ` C ` , so ` A ` would land on line ` C B ` , contradicting the triangle's non-collinearity. ` M =/= C ` comes from ~ ismidb / ~ mirinv / ~ mirne , not from ~ midbtwn . (Contributed by JAG, 12-Aug-2026.)
theorem tgextamirnhl (ph: wff) (A2 B2 C D P G I K L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel C (co B2 D I)) $ >
  $ wi ph (wn (wo (wcel A2 (co B2 C L)) (wceq B2 C))) $ >
  $ wi ph (wne C D) $ >
  $ wi ph (wn (wbr D (cfv B2 (cfv (co A2 C (cfv G cmid)) (cfv G cmir))) (cfv C K))) $;

--| The reflected point and ` D ` lie on the same OPEN half-plane of line ` A C ` -- the fact ~ acopyeu requires and ` inA ` does not give. ~ tgextalem1inag puts the reflected point inside the exterior angle, which is non-strict: ~ isinag 's witness clause is ` ( x = C \/ x ( K `` C ) P ) ` , so a point inside an angle may sit on a boundary ray. The ` x = C ` branch collapses to ` ( A e. ( C L D ) \/ C = D ) ` and is killed by ~ tgextancd ; the main branch is ~ tgextahpl , whose off-line input is ~ tgextamirn . The $d s are the mandatory ones ~ isinag carries for the witness variable. (Contributed by JAG , 12-Aug-2026.)
theorem tgextahp (ph: wff) (A2 B2 C D P G I K L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel C (co B2 D I)) $ >
  $ wi ph (wn (wo (wcel A2 (co B2 C L)) (wceq B2 C))) $ >
  $ wi ph (wne C D) $ >
  $ wi ph (wbr (cfv B2 (cfv (co A2 C (cfv G cmid)) (cfv G cmir))) D (cfv (co A2 C L) (cfv G chpg))) $;

--| The exterior angle is NOT congruent to the remote interior angle -- the strictness ~ tgextale cannot give, and what ~ tgaas 's contradiction branch needs. The exterior angle is ` <" A C D "> ` , at the extension of ` B C ` beyond ` C ` . The tail of GeoCoq's l11__41__aux , run through ~ acopyeu rather than conga__cop__or__out__ts : a congruent exterior angle would, by angle-construction uniqueness, put the midpoint-reflected point of ~ tgmircgra on the ray ` C D ` -- the two rays make congruent angles with the shared base ray ` C A ` and, by ~ tgextahp and ~ hpgid , lie on the same open half-plane of line ` A C ` -- which ~ tgextamirnhl forbids. Both of ~ acopyeu 's non-collinearity hypotheses are discharged, not assumed: source side by rotating the triangle's own ncol , target side by ~ tgextancd . (Contributed by JAG, 12-Aug-2026.)
theorem tgextancgra (ph: wff) (A2 B2 C D P G I K L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel C (co B2 D I)) $ >
  $ wi ph (wn (wo (wcel A2 (co B2 C L)) (wceq B2 C))) $ >
  $ wi ph (wne C D) $ >
  $ wi ph (wn (wbr (cs3 C A2 B2) (cs3 A2 C D) (cfv G ccgra))) $;

--| The two exterior angles at ` C ` are VERTICAL, hence congruent. Ray ` C D ` is opposite ray ` C B ` and ray ` C E ` is opposite ray ` C A ` , so ` <" B C E "> ` and ` <" A C D "> ` have both legs flipped. One ~ sacgr (Schwabhaeuser 11.13, GeoCoq l11__13 ) does it in a single shot, because ~ sacgr flips the first slot of each side independently: the premise it wants is ` <" D C E "> ( cgrA `` G ) <" E C D "> ` , a bare angle reversal by ~ cgraswap , needing no non-collinearity at all. ~ oacgr (11.14) would prove the same thing from two supplements and is not used. (Contributed by JAG, 12-Aug-2026.)
theorem tgextaoa (ph: wff) (A2 B2 C D P E G I K c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel C (co B2 D I)) $ >
  $ wi ph (wcel C (co A2 E I)) $ >
  $ wi ph (wne C B2) $ >
  $ wi ph (wne C A2) $ >
  $ wi ph (wne D C) $ >
  $ wi ph (wne C E) $ >
  $ wi ph (wbr (cs3 B2 C E) (cs3 A2 C D) (cfv G ccgra)) $;

--| ~ tgexta 's FIRST conjunct, strict -- the remote interior angle at ` A ` is strictly less than the exterior angle at ` C ` . ~ tgextale and ~ tgextancgra deliver both halves already, but stated about ` <" C A B "> ` ; ~ tgexta wants ` <" B A C "> ` , the same angle read backwards. So this is ~ cgraswap plus two transports: ~ leacgra1 for the ` leA ` half, and ~ cgratr under ~ mtand for the negation -- if ` <" B A C "> ` were congruent to the exterior angle then so would ` <" C A B "> ` be, which ~ tgextancgra forbids. (Contributed by JAG, 12-Aug-2026.)
theorem tgextalt1 (ph: wff) (A2 B2 C D P G I K L c_le c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq K (cfv G chlg) $ >
  $ wceq c_le (cfv G cleag) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel C (co B2 D I)) $ >
  $ wi ph (wn (wo (wcel A2 (co B2 C L)) (wceq B2 C))) $ >
  $ wi ph (wne C D) $ >
  $ wi ph (wa (wbr (cs3 B2 A2 C) (cs3 A2 C D) c_le) (wn (wbr (cs3 B2 A2 C) (cs3 A2 C D) (cfv G ccgra)))) $;

--| ~ tgexta 's SECOND conjunct, strict, at a supplied second extension point ` E ` . This is NOT a permutation of the first conjunct: ` E ` is a new point, ` C ` between ` A ` and ` E ` , and ~ tgextale / ~ tgextancgra are applied a second time at the reconfigured triangle (the roles of ` A ` and ` B ` exchanged, exterior angle ` <" B C E "> ` ). ~ tgextaoa then identifies ` <" B C E "> ` with ` <" A C D "> ` as vertical angles, and the two halves are transported across that congruence -- ~ leacgra for ` leA ` , and ~ cgratr under ~ mtand for the negation, which ~ leacgra cannot move. ` E ` is existentially constructed by ~ tgexta , not here. (Contributed by JAG, 12-Aug-2026.)
theorem tgextalt2 (ph: wff) (A2 B2 C D P E G I K L c_le c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq K (cfv G chlg) $ >
  $ wceq c_le (cfv G cleag) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel C (co B2 D I)) $ >
  $ wi ph (wcel C (co A2 E I)) $ >
  $ wi ph (wn (wo (wcel A2 (co B2 C L)) (wceq B2 C))) $ >
  $ wi ph (wne C D) $ >
  $ wi ph (wne C E) $ >
  $ wi ph (wa (wbr (cs3 A2 B2 C) (cs3 A2 C D) c_le) (wn (wbr (cs3 A2 B2 C) (cs3 A2 C D) (cfv G ccgra)))) $;

--| The exterior-angle theorem, GeoCoq l11__41 -- BOTH remote interior angles of the triangle are STRICTLY less than the exterior angle at ` C ` . There is no ltA in set.mm , so strictness is carried inline as ` leA ` together with the non-congruence; the pair is what ~ tgaas 's contradiction branch needs, since a bare ` leA ` conclusion is satisfied by a congruence and so contradicts nothing ( ~ tgextan records that the pair is usable). The second conjunct is not a permutation of the first: ~ axtgsegcon builds a second extension point ` y ` beyond ` C ` on line ` A C ` , ~ tgextalt2 reruns the construction there, and the two exterior angles are identified as vertical by ~ tgextaoa . (Contributed by JAG, 12-Aug-2026.)
theorem tgexta (ph: wff) (A2 B2 C D P G I K L c_le c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq K (cfv G chlg) $ >
  $ wceq c_le (cfv G cleag) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel C (co B2 D I)) $ >
  $ wi ph (wn (wo (wcel A2 (co B2 C L)) (wceq B2 C))) $ >
  $ wi ph (wne C D) $ >
  $ wi ph (wa (wa (wbr (cs3 B2 A2 C) (cs3 A2 C D) c_le) (wn (wbr (cs3 B2 A2 C) (cs3 A2 C D) (cfv G ccgra)))) (wa (wbr (cs3 A2 B2 C) (cs3 A2 C D) c_le) (wn (wbr (cs3 A2 B2 C) (cs3 A2 C D) (cfv G ccgra))))) $;

--| ~ tgexta 's strictness can be used -- a remote interior angle congruent to the exterior angle is contradictory, so anything follows. This is the shape ~ tgaasexc consumes: that branch holds an angle congruence and must close on it, which the non-strict ` leA ` -only form of ~ tgexta could never let it do. (Contributed by JAG, 12-Aug-2026.)
theorem tgextan (ph ps: wff) (A2 B2 C D P G I K L c_le c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq K (cfv G chlg) $ >
  $ wceq c_le (cfv G cleag) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel C (co B2 D I)) $ >
  $ wi ph (wn (wo (wcel A2 (co B2 C L)) (wceq B2 C))) $ >
  $ wi ph (wne C D) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 A2 C D) (cfv G ccgra)) $ >
  $ wi ph ps $;

--| Slide a non-collinearity along the line it is off: if ` X ` is off line ` Y Z ` and ` W ` is a point of that line other than ` Z ` , then ` X ` is off line ` Z W ` too. Lines ` Z Y ` and ` Z W ` coincide ( ~ tglineeltr ), which is what the exterior-angle hypothesis of ~ tgaasexc needs at the moving point. (Contributed by JAG, 12-Aug-2026.)
theorem tgaasncol (ph: wff) (P G I L W X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wn (wo (wcel X (co Y Z L)) (wceq Y Z))) $ >
  $ wi ph (wo (wcel W (co Z Y L)) (wceq Z Y)) $ >
  $ wi ph (wne W Z) $ >
  $ wi ph (wn (wo (wcel X (co Z W L)) (wceq Z W))) $;

--| The contradiction branch of AAS, stated once for both orders of the two candidate points. ` S ` lies strictly between ` E ` and ` T ` , and ` D ` is off the line, so ` <" D S E "> ` is an exterior angle of triangle ` D T S ` and is STRICTLY greater than the remote interior angle at ` T ` -- while the hypothesis says the two are congruent. ~ tgextan turns that into anything. (Contributed by JAG, 12-Aug-2026.)
theorem tgaasexc (ph ps: wff) (D P S T E G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel S P) $ >
  $ wi ph (wcel T P) $ >
  $ wi ph (wn (wo (wcel D (co E T L)) (wceq E T))) $ >
  $ wi ph (wcel S (co E T I)) $ >
  $ wi ph (wne S E) $ >
  $ wi ph (wne S T) $ >
  $ wi ph (wbr (cs3 D T E) (cs3 D S E) (cfv G ccgra)) $ >
  $ wi ph ps $;

--| Two DISTINCT points ` F ` and ` H ` on one half-line from ` E ` , subtending congruent angles at a point ` D ` off the line, are contradictory. ~ ishlg unfolds the half-line to "one of them is strictly between ` E ` and the other" -- both sub-branches are proved, each by ~ tgaasexc on its own triangle, and they are not permutations of one another: the second needs the non-collinearity transported to line ` E H ` by ~ cgrancol . (Contributed by JAG, 12-Aug-2026.)
theorem tgaasne (ph ps: wff) (D P E F G H I K L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel H P) $ >
  $ wi ph (wn (wo (wcel D (co E F L)) (wceq E F))) $ >
  $ wi ph (wbr H F (cfv E K)) $ >
  $ wi ph (wne F H) $ >
  $ wi ph (wbr (cs3 D F E) (cs3 D H E) (cfv G ccgra)) $ >
  $ wi ph ps $;

--| The comparison triangle of the AAS route: with ` H ` placed on ray ` E F ` at distance ` B C ` from ` E ` , the triangle ` D E H ` is congruent to ` A B C ` ( ~ cgrahl2 then ~ tgsas ), so its angle at ` H ` can be read off ( ~ cgrcgra ) and matched against the given angle at ` F ` . The result is the angle congruence the case split of ~ tgaas1h consumes. (Contributed by JAG, 12-Aug-2026.)
theorem tgaascgra (ph: wff) (A2 B2 C D P E F G H I K L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel H P) $ >
  $ wi ph (wn (wo (wcel C (co A2 B2 L)) (wceq A2 B2))) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co D E c_mi)) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) $ >
  $ wi ph (wbr (cs3 B2 C A2) (cs3 E F D) (cfv G ccgra)) $ >
  $ wi ph (wbr H F (cfv E K)) $ >
  $ wi ph (wceq (co E H c_mi) (co B2 C c_mi)) $ >
  $ wi ph (wbr (cs3 D F E) (cs3 D H E) (cfv G ccgra)) $;

--| ~ tgaas1 with the constructed point ` H ` still explicit: the case split on ` F = H ` . Equal, and the side equality is a substitution; distinct, and ~ tgaasne closes the branch. BOTH branches are proved -- assuming ` F = H ` would be assuming the theorem. (Contributed by JAG , 12-Aug-2026.)
theorem tgaas1h (ph: wff) (A2 B2 C D P E F G H I K L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel H P) $ >
  $ wi ph (wn (wo (wcel C (co A2 B2 L)) (wceq A2 B2))) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co D E c_mi)) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) $ >
  $ wi ph (wbr (cs3 B2 C A2) (cs3 E F D) (cfv G ccgra)) $ >
  $ wi ph (wbr H F (cfv E K)) $ >
  $ wi ph (wceq (co E H c_mi) (co B2 C c_mi)) $ >
  $ wi ph (wceq (co B2 C c_mi) (co E F c_mi)) $;

--| Under the AAS hypotheses, the side included between the two given angles is congruent. This is the whole content of AAS: ~ tgaas simply packages it with SAS ( ~ tgsas ). The point copied onto ray ` E F ` by ~ tgaascgra is eliminated here. (Contributed by JAG, 12-Aug-2026.)
theorem tgaas1 (ph: wff) (A2 B2 C D P E F G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wn (wo (wcel C (co A2 B2 L)) (wceq A2 B2))) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co D E c_mi)) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) $ >
  $ wi ph (wbr (cs3 B2 C A2) (cs3 E F D) (cfv G ccgra)) $ >
  $ wi ph (wceq (co B2 C c_mi) (co E F c_mi)) $;

--| Angle-angle-side: two triangles with two congruent angles and a congruent side not included between them are congruent. The side included between the two angles is congruent by ~ tgaas1 , which reduces the theorem to SAS ( ~ tgsas ). (Contributed by JAG, 12-Aug-2026.)
theorem tgaas (ph: wff) (A2 B2 C D P E F G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wn (wo (wcel C (co A2 B2 L)) (wceq A2 B2))) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co D E c_mi)) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) $ >
  $ wi ph (wbr (cs3 B2 C A2) (cs3 E F D) (cfv G ccgra)) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgrg)) $;

--| A theorem about the universal class. Inference associated with ~ bj-abv (which is proved from fewer axioms). (Contributed by Stefan Allan, 9-Dec-2008.)
theorem sa_abvi {x3: setvar} (ph: wff x3):
  $ ph $ >
  $ wceq cvv (cab x3 ph) $;

--| A partial converse to ~ 19.9t . (Contributed by Stefan Allan, 21-Dec-2008.) (Revised by Mario Carneiro, 11-Dec-2016.)
theorem xfree {x3: setvar} (ph: wff x3):
  $ wb (wal x3 (wi ph (wal x3 ph))) (wal x3 (wi (wex x3 ph) ph)) $;

--| A partial converse to ~ 19.9t . (Contributed by Stefan Allan, 21-Dec-2008.)
theorem xfree2 {x3: setvar} (ph: wff x3):
  $ wb (wal x3 (wi ph (wal x3 ph))) (wal x3 (wi (wn ph) (wal x3 (wn ph)))) $;

--| A proof readability experiment for ~ addltmul . (Contributed by Stefan Allan, 30-Oct-2010.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem addltmulALT (A2 B2: class):
  $ wi (wa (wa (wcel A2 cr) (wcel B2 cr)) (wa (wbr c2 A2 clt) (wbr c2 B2 clt))) (wbr (co A2 B2 caddc) (co A2 B2 cmul) clt) $;

--| Deduction adding 11 conjuncts to antecedent. (Contributed by Thierry Arnoux, 27-Sep-2025.) (New usage is discouraged.)
theorem ad11antr (ph ps ch th ta et ze si rh mu la ka nu: wff):
  $ wi ph ps $ >
  $ wi (wa (wa (wa (wa (wa (wa (wa (wa (wa (wa (wa ph ch) th) ta) et) ze) si) rh) mu) la) ka) nu) ps $;

--| Simplification of a conjunction. (Contributed by Thierry Arnoux, 5-Oct-2025.) (New usage is discouraged.)
theorem simp_12l (ph ps ch th ta et ze si rh mu la ka nu: wff):
  $ wi (wa (wa (wa (wa (wa (wa (wa (wa (wa (wa (wa (wa ph ps) ch) th) ta) et) ze) si) rh) mu) la) ka) nu) ph $;

--| Simplification of a conjunction. (Contributed by Thierry Arnoux, 5-Oct-2025.) (New usage is discouraged.)
theorem simp_12r (ph ps ch th ta et ze si rh mu la ka nu: wff):
  $ wi (wa (wa (wa (wa (wa (wa (wa (wa (wa (wa (wa (wa ph ps) ch) th) ta) et) ze) si) rh) mu) la) ka) nu) ps $;

--| Inference exchanging the last antecedent with the second. (Contributed by Thierry Arnoux, 3-Jun-2025.)
theorem an52ds (ph ps ch th ta et: wff):
  $ wi (wa (wa (wa (wa ph ps) ch) th) ta) et $ >
  $ wi (wa (wa (wa (wa ph ta) ch) th) ps) et $;

--| Inference exchanging the last antecedent with the second one. (Contributed by Thierry Arnoux, 3-Jun-2025.)
theorem an62ds (ph ps ch th ta et ze: wff):
  $ wi (wa (wa (wa (wa (wa ph ps) ch) th) ta) et) ze $ >
  $ wi (wa (wa (wa (wa (wa ph et) ch) th) ta) ps) ze $;

--| Inference exchanging the last antecedent with the second one. (Contributed by Thierry Arnoux, 3-Jun-2025.)
theorem an72ds (ph ps ch th ta et ze si: wff):
  $ wi (wa (wa (wa (wa (wa (wa ph ps) ch) th) ta) et) ze) si $ >
  $ wi (wa (wa (wa (wa (wa (wa ph ze) ch) th) ta) et) ps) si $;

--| Inference exchanging the last antecedent with the second one. (Contributed by Thierry Arnoux, 3-Jun-2025.)
theorem an82ds (ph ps ch th ta et ze si rh: wff):
  $ wi (wa (wa (wa (wa (wa (wa (wa ph ps) ch) th) ta) et) ze) si) rh $ >
  $ wi (wa (wa (wa (wa (wa (wa (wa ph si) ch) th) ta) et) ze) ps) rh $;

--| Syllogism inference. (Contributed by Thierry Arnoux, 19-Oct-2025.)
theorem syl22anbrc (ph ps ch th ta et: wff):
  $ wi ph ps $ >
  $ wi ph ch $ >
  $ wi ph th $ >
  $ wi ph ta $ >
  $ wb et (wa (wa ps ch) (wa th ta)) $ >
  $ wi ph et $;

--| Distributive law for disjunction. (Contributed by Thierry Arnoux, 3-Jul-2017.)
theorem or3di (ph ps ch ta: wff):
  $ wb (wo ph (w3a ps ch ta)) (w3a (wo ph ps) (wo ph ch) (wo ph ta)) $;

--| Distributive law for disjunction. (Contributed by Thierry Arnoux, 3-Jul-2017.)
theorem or3dir (ph ps ch ta: wff):
  $ wb (wo (w3a ph ps ch) ta) (w3a (wo ph ta) (wo ps ta) (wo ch ta)) $;

--| Deduction eliminating disjunct. (Contributed by Thierry Arnoux, 19-Dec-2016.)
theorem _3o1cs (ph ps ch th: wff):
  $ wi (w3o ph ps ch) th $ >
  $ wi ph th $;

--| Deduction eliminating disjunct. (Contributed by Thierry Arnoux, 19-Dec-2016.)
theorem _3o2cs (ph ps ch th: wff):
  $ wi (w3o ph ps ch) th $ >
  $ wi ps th $;

--| Deduction eliminating disjunct. (Contributed by Thierry Arnoux, 19-Dec-2016.)
theorem _3o3cs (ph ps ch th: wff):
  $ wi (w3o ph ps ch) th $ >
  $ wi ch th $;

--| Conversion of implicit substitution to explicit class substitution. (Contributed by Thierry Arnoux, 4-Jul-2023.)
theorem sbc2iedf {x3 y1: setvar} (ph ps ch: wff x3 y1) (A2 B2: class) (V W: class x3 y1):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wnf x3 ch $ >
  $ wnf y1 ch $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wb ps ch) $ >
  $ wi ph (wb (wsbc x3 (wsbc y1 ps B2) A2) ch) $;

--| Double restricted specialization, using implicit substitution. (Contributed by Thierry Arnoux, 4-Jul-2023.)
theorem rspc2daf {x3 y1: setvar} (ph ps ch: wff x3 y1) (A2 B2: class) (V: class y1) (W: class):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wnf x3 ch $ >
  $ wnf y1 ch $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi (wa ph (wa (wceq (cv x3) A2) (wceq (cv y1) B2))) (wb ps ch) $ >
  $ wi ph (wral x3 (wral y1 ps W) V) $ >
  $ wi ph ch $;

--| Commutation of restricted and unrestricted universal quantifiers. (Contributed by NM, 26-Mar-2004.) (Proof shortened by Andrew Salmon, 8-Jun-2011.) (Revised by Thierry Arnoux, 8-Mar-2017.)
theorem ralcom4f {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wb (wral x3 (wal y1 ph) A2) (wal y1 (wral x3 ph A2)) $;

--| Commutation of restricted and unrestricted existential quantifiers. (Contributed by NM, 12-Apr-2004.) (Proof shortened by Andrew Salmon, 8-Jun-2011.) (Revised by Thierry Arnoux, 8-Mar-2017.)
theorem rexcom4f {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1):
  $ wnfc y1 A2 $ >
  $ wb (wrex x3 (wex y1 ph) A2) (wex y1 (wrex x3 ph A2)) $;

--| A deduction version of one direction of ~ 19.9 with two variables. (Contributed by Thierry Arnoux, 20-Mar-2017.)
theorem _19_9d2rf {x3 y1: setvar} (ph ps: wff x3 y1) (A2 B2: class x3 y1):
  $ wnf y1 ph $ >
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnf y1 ps) $ >
  $ wi ph (wrex x3 (wrex y1 ps B2) A2) $ >
  $ wi ph ps $;

--| A deduction version of one direction of ~ 19.9 with two variables. (Contributed by Thierry Arnoux, 30-Jan-2017.)
theorem _19_9d2r {x3 y1: setvar} (ph: wff x3) (ps: wff x3 y1) (A2 B2: class x3 y1):
  $ wi ph (wnf x3 ps) $ >
  $ wi ph (wnf y1 ps) $ >
  $ wi ph (wrex x3 (wrex y1 ps B2) A2) $ >
  $ wi ph ps $;

--| A commonly used pattern based on ~ r19.29 , version with two restricted quantifiers. (Contributed by Thierry Arnoux, 26-Nov-2017.)
theorem r19_29ffa {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (ch: wff) (A2: class x3) (B2: class x3 y1):
  $ wi (wa (wa (wa ph (wcel (cv x3) A2)) (wcel (cv y1) B2)) ps) ch $ >
  $ wi (wa ph (wrex x3 (wrex y1 ps B2) A2)) ch $;

--| A condition which implies existential uniqueness. (Contributed by Thierry Arnoux, 13-Oct-2025.)
theorem reu6dv {x3: setvar} (ph: wff) (ps: wff x3) (A2 B2: class):
  $ wi ph (wcel B2 A2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps (wceq (cv x3) B2)) $ >
  $ wi ph (wreu x3 ps A2) $;

--| A transposition of equality. (Contributed by Thierry Arnoux, 20-Aug-2023.)
theorem eqtrb (A2 B2 C: class):
  $ wb (wa (wceq A2 B2) (wceq A2 C)) (wa (wceq A2 B2) (wceq B2 C)) $;

--| A variable elimination law for equality within a given set ` A ` . See ~ equvel . (Contributed by Thierry Arnoux, 20-Feb-2025.)
theorem eqelbid {x3: setvar} (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel B2 A2) $ >
  $ wi ph (wcel C A2) $ >
  $ wi ph (wb (wral x3 (wb (wceq (cv x3) B2) (wceq (cv x3) C)) A2) (wceq B2 C)) $;

--| Conversion of implicit substitution to explicit class substitution for ordered pairs. (Contributed by Thierry Arnoux, 4-Jul-2023.)
theorem opsbc2ie {x3 y1 p a b: setvar} (ph: wff x3 y1 p) (ch: wff x3 y1 p a b):
  $ wi (wceq (cv p) (cop (cv a) (cv b))) (wb ph ch) $ >
  $ wi (wceq (cv p) (cop (cv x3) (cv y1))) (wb ph (wsbc b (wsbc a ch (cv x3)) (cv y1))) $;

--| Correspondence between uniqueness of ordered pairs and double restricted existential uniqueness quantification. Alternate proof of one direction only, use ~ opreu2reurex instead. (Contributed by Thierry Arnoux, 4-Jul-2023.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem opreu2reuALT {p a b: setvar} (ph: wff p) (ch: wff) (A2 B2: class):
  $ wi (wceq (cv p) (cop (cv a) (cv b))) (wb ph ch) $ >
  $ wi (wa (wreu a (wrex b ch B2) A2) (wreu b (wrex a ch A2) B2)) (wreu p ph (cxp A2 B2)) $;

--| Syntax for double restricted existential uniqueness quantification.
term w2reu {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1): wff;

--| Define the double restricted existential uniqueness quantifier. (Contributed by Thierry Arnoux, 4-Jul-2023.)
axiom df_2reu {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ wb (w2reu x3 y1 ph A2 B2) (wa (wreu x3 (wrex y1 ph B2) A2) (wreu y1 (wrex x3 ph A2) B2)) $;

--| Double restricted existential uniqueness commutes. (Contributed by Thierry Arnoux, 4-Jul-2023.)
theorem _2reucom {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ wb (w2reu x3 y1 ph A2 B2) (w2reu y1 x3 ph B2 A2) $;

--| Double restricted existential uniqueness implies double restricted existence. (Contributed by Thierry Arnoux, 4-Jul-2023.)
theorem _2reu2rex1 {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ wi (w2reu x3 y1 ph A2 B2) (wrex x3 (wrex y1 ph B2) A2) $;

--| Double restricted existential uniqueness implies restricted existential uniqueness with restricted existence. (Contributed by AV, 5-Jul-2023.)
theorem _2reureurex {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ wi (w2reu x3 y1 ph A2 B2) (wreu x3 (wrex y1 ph B2) A2) $;

--| Double restricted existential uniqueness implies two nested restricted existential uniqueness. (Contributed by AV, 5-Jul-2023.)
theorem _2reu2reu2 {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class y1):
  $ wi (w2reu x3 y1 ph A2 B2) (wreu x3 (wreu y1 ph B2) A2) $;

--| Equivalent definition of the double restricted existential uniqueness quantifier, using uniqueness of ordered pairs. (Contributed by Thierry Arnoux, 4-Jul-2023.)
theorem opreu2reu1 {x3 y1 p: setvar} (ph: wff) (ch: wff p) (A2 B2: class):
  $ wi (wceq (cv p) (cop (cv x3) (cv y1))) (wb ch ph) $ >
  $ wb (w2reu x3 y1 ph A2 B2) (wreu p ch (cxp A2 B2)) $;

--| There exists a unique decomposition of a prime as a sum of squares of two different positive integers iff the prime is of the form ` 4 k + 1 ` . Double restricted existential uniqueness variant of ~ 2sqreunnltb . (Contributed by AV, 5-Jul-2023.)
theorem sq2reunnltb {a b: setvar} (P: class):
  $ wi (wcel P cprime) (wb (wceq (co P c4 cmo) c1) (w2reu a b (wa (wbr (cv a) (cv b) clt) (wceq (co (co (cv a) c2 cexp) (co (cv b) c2 cexp) caddc) P)) cn cn)) $;

--| For each complex number ` C ` , there does not uniquely exist two complex numbers ` a ` and ` b ` , with ` b ` squared and added to ` a ` resulting in the given complex number ` C ` . Double restricted existential uniqueness variant of ~ addsqn2reurex2 . (Contributed by AV, 5-Jul-2023.)
theorem addsqnot2reu {a b: setvar} (C: class):
  $ wi (wcel C cc) (wn (w2reu a b (wceq (co (cv a) (co (cv b) c2 cexp) caddc) C) cc cc)) $;

--| Equality theorem for class substitution. (Contributed by Thierry Arnoux, 4-Sep-2018.)
theorem sbceqbidf {x3: setvar} (ph ps ch: wff x3) (A2 B2: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wb ps ch) $ >
  $ wi ph (wb (wsbc x3 ps A2) (wsbc x3 ch B2)) $;

--| A special version of class substitution commonly used for structures. (Contributed by Thierry Arnoux, 14-Mar-2019.)
theorem sbcies {a: setvar} (ph: wff) (ps: wff a) (w: setvar) (A2: class a) (E W: class):
  $ wceq A2 (cfv W E) $ >
  $ wi (wceq (cv a) A2) (wb ph ps) $ >
  $ wi (wceq (cv w) W) (wb (wsbc a ps (cfv (cv w) E)) ph) $;

--| Alternate definition of "at most one." (Contributed by Thierry Arnoux, 1-Mar-2017.)
theorem mo5f {x3 i j: setvar} (ph: wff x3 i j):
  $ wnf i ph $ >
  $ wnf j ph $ >
  $ wb (wmo x3 ph) (wal i (wal j (wi (wa (wsb x3 ph i) (wsb x3 ph j)) (wceq (cv i) (cv j))))) $;

--| Negation of "at most one". (Contributed by Thierry Arnoux, 26-Feb-2017.)
theorem nmo {x3 y1: setvar} (ph: wff x3 y1):
  $ wnf y1 ph $ >
  $ wb (wn (wmo x3 ph)) (wal y1 (wex x3 (wa ph (wne (cv x3) (cv y1))))) $;

--| Transfer existential uniqueness from a variable ` x ` to another variable ` y ` contained in expression ` A ` . Cf. ~ reuxfrd (Contributed by Thierry Arnoux, 7-Apr-2017.) (Revised by Thierry Arnoux, 8-Oct-2017.) (Revised by Thierry Arnoux, 30-Mar-2018.)
theorem reuxfrdf {x3 y1: setvar} (ph: wff) (ps: wff y1) (A2 B2: class y1) (C: class):
  $ wnfc y1 B2 $ >
  $ wi (wa ph (wcel (cv y1) C)) (wcel A2 B2) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wrmo y1 (wceq (cv x3) A2) C) $ >
  $ wi ph (wb (wreu x3 (wrex y1 (wa (wceq (cv x3) A2) ps) C) B2) (wreu y1 ps C)) $;

--| Restricted existential quantification over the union of the range of a function. Cf. ~ rexrn and ~ eluni2 . (Contributed by Thierry Arnoux, 19-Sep-2017.)
theorem rexunirn {x3 y1: setvar} (ph: wff y1) (A2: class x3) (B2: class x3 y1) (F: class y1) (V: class x3 y1):
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wcel (cv x3) A2) (wcel B2 V) $ >
  $ wi (wrex x3 (wrex y1 ph B2) A2) (wrex y1 ph (cuni (crn F))) $;

--| Transfer "at most one" restricted quantification from a variable ` x ` to another variable ` y ` contained in expression ` A ` . (Contributed by Thierry Arnoux, 7-Apr-2017.) (Revised by Thierry Arnoux, 8-Oct-2017.)
theorem rmoxfrd {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (A2: class y1) (B2 C: class):
  $ wi (wa ph (wcel (cv y1) C)) (wcel A2 B2) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wreu y1 (wceq (cv x3) A2) C) $ >
  $ wi (wa ph (wceq (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wb (wrmo x3 ps B2) (wrmo y1 ch C)) $;

--| "At most one" restricted existential quantifier for a union implies the same quantifier on both sets. (Contributed by Thierry Arnoux, 27-Nov-2023.)
theorem rmoun {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wi (wrmo x3 ph (cun A2 B2)) (wa (wrmo x3 ph A2) (wrmo x3 ph B2)) $;

--| A case where an "at most one" restricted existential quantifier for a union is equivalent to such a quantifier for one of the sets. (Contributed by Thierry Arnoux, 27-Nov-2023.)
theorem rmounid {x3: setvar} (ph: wff) (ps: wff x3) (A2 B2: class x3):
  $ wi (wa ph (wcel (cv x3) B2)) (wn ps) $ >
  $ wi ph (wb (wrmo x3 ps (cun A2 B2)) (wrmo x3 ps A2)) $;

--| Equivalent wff's yield equal restricted definition binders (deduction form). ( ~ raleqbidva analog.) (Contributed by Thierry Arnoux, 29-Jan-2025.)
theorem riotaeqbidva {x3: setvar} (ph: wff) (ps ch: wff x3) (A2 B2: class x3):
  $ wi ph (wceq A2 B2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wb ps ch) $ >
  $ wi ph (wceq (crio x3 ps A2) (crio x3 ch B2)) $;

--| Domain of a restricted class abstraction over a cartesian product. (Contributed by Thierry Arnoux, 3-Jul-2023.)
theorem dmrab {x3 y1 z: setvar} (ph: wff z) (ps: wff x3 y1) (A2 B2: class):
  $ wi (wceq (cv z) (cop (cv x3) (cv y1))) (wb ph ps) $ >
  $ wceq (cdm (crab z ph (cxp A2 B2))) (crab x3 (wrex y1 ps B2) A2) $;

--| Difference of two restricted class abstractions. Compare with ~ difrab . (Contributed by Thierry Arnoux, 3-Jan-2022.)
theorem difrab2 {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wceq (cdif (crab x3 ph A2) (crab x3 ph B2)) (crab x3 ph (cdif A2 B2)) $;

--| Separation Scheme in terms of a restricted class abstraction. To be removed in profit of Glauco's equivalent version. (Contributed by Thierry Arnoux, 11-May-2017.)
theorem rabexgfGS {x3: setvar} (ph: wff x3) (A2 V: class x3):
  $ wnfc x3 A2 $ >
  $ wi (wcel A2 V) (wcel (crab x3 ph A2) cvv) $;

--| Truth implied by equality of a restricted class abstraction and a singleton. (Contributed by Thierry Arnoux, 15-Sep-2018.)
theorem rabsnel {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wcel B2 cvv $ >
  $ wi (wceq (crab x3 ph A2) (csn B2)) (wcel B2 A2) $;

--| Conditions for a restricted class abstraction to be a subset of an unordered pair. (Contributed by Thierry Arnoux, 6-Jul-2025.)
theorem rabsspr {x3: setvar} (ph: wff x3) (V: class x3) (X Y: class):
  $ wb (wss (crab x3 ph V) (cpr X Y)) (wral x3 (wi ph (wo (wceq (cv x3) X) (wceq (cv x3) Y))) V) $;

--| Conditions for a restricted class abstraction to be a subset of an unordered triple. (Contributed by Thierry Arnoux, 6-Jul-2025.)
theorem rabsstp {x3: setvar} (ph: wff x3) (V: class x3) (X Y Z: class):
  $ wb (wss (crab x3 ph V) (ctp X Y Z)) (wral x3 (wi ph (w3o (wceq (cv x3) X) (wceq (cv x3) Y) (wceq (cv x3) Z))) V) $;

--| Union of three restricted class abstractions. (Contributed by Thierry Arnoux, 6-Jul-2025.)
theorem _3unrab {x3: setvar} (ph ps ch: wff x3) (A2: class x3):
  $ wceq (cun (cun (crab x3 ph A2) (crab x3 ps A2)) (crab x3 ch A2)) (crab x3 (w3o ph ps ch) A2) $;

--| From a surjective function, *choose* a subset of the domain, such that the restricted function is bijective. (Contributed by Thierry Arnoux, 27-Jan-2020.) Remove dependency on ~ ax-reg and ~ ax-inf2 . (Revised by Timothy J. O'Malley, 15-Oct-2026.)
theorem foresf1o {x3: setvar} (A2 B2 F: class) (V: class x3):
  $ wi (wa (wcel A2 V) (wfo A2 B2 F)) (wrex x3 (wf1o (cv x3) B2 (cres F (cv x3))) (cpw A2)) $;

--| Domination relation for restricted abstract class builders, based on a surjective function. (Contributed by Thierry Arnoux, 27-Jan-2020.)
theorem rabfodom {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch: wff y1) (A2 B2 F V: class):
  $ wi (w3a ph (wcel (cv x3) A2) (wceq (cv y1) (cfv (cv x3) F))) (wb ch ps) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wfo A2 B2 F) $ >
  $ wi ph (wbr (crab y1 ch B2) (crab x3 ps A2) cdom) $;

--| Conditions for a class abstraction with a restricted existential quantification to be finite. (Contributed by Thierry Arnoux, 6-Jul-2025.)
theorem rabrexfi {x3 y1: setvar} (ph: wff x3) (ps: wff x3 y1) (A2 B2: class):
  $ wi ph (wcel B2 cfn) $ >
  $ wi (wa ph (wcel (cv y1) B2)) (wcel (crab x3 ps A2) cfn) $ >
  $ wi ph (wcel (crab x3 (wrex y1 ps B2) A2) cfn) $;

--| An indexed set is dominated by the indexing set. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem abrexdomjm {x3 y1: setvar} (ph: wff x3 y1) (A2: class) (V: class x3 y1):
  $ wi (wcel (cv y1) A2) (wmo x3 ph) $ >
  $ wi (wcel A2 V) (wbr (cab x3 (wrex y1 ph A2)) A2 cdom) $;

--| An indexed set is dominated by the indexing set. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem abrexdom2jm {x3 y1: setvar} (A2: class) (B2: class y1) (V: class x3 y1):
  $ wi (wcel A2 V) (wbr (cab x3 (wrex y1 (wceq (cv x3) B2) A2)) A2 cdom) $;

--| Existence of a class abstraction of existentially restricted sets. (Contributed by Thierry Arnoux, 10-May-2017.)
theorem abrexexd {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wi ph (wcel A2 cvv) $ >
  $ wi ph (wcel (cab y1 (wrex x3 (wceq (cv y1) B2) A2)) cvv) $;

--| Class substitution in an image set. (Contributed by Thierry Arnoux, 30-Dec-2016.)
theorem elabreximd {x3 y1: setvar} (ph ps ch: wff x3 y1) (A2: class) (B2 C: class x3) (V: class x3 y1):
  $ wnf x3 ph $ >
  $ wnf x3 ch $ >
  $ wi (wceq A2 B2) (wb ch ps) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv x3) C)) ps $ >
  $ wi (wa ph (wcel A2 (cab y1 (wrex x3 (wceq (cv y1) B2) C)))) ch $;

--| Class substitution in an image set. (Contributed by Thierry Arnoux, 30-Dec-2016.)
theorem elabreximdv {x3 y1: setvar} (ph: wff y1) (ps: wff x3 y1) (ch: wff y1) (A2: class) (B2: class x3) (C: class) (V: class x3 y1):
  $ wi (wceq A2 B2) (wb ch ps) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv x3) C)) ps $ >
  $ wi (wa ph (wcel A2 (cab y1 (wrex x3 (wceq (cv y1) B2) C)))) ch $;

--| A necessary condition for an image set to be a subset. (Contributed by Thierry Arnoux, 6-Feb-2017.)
theorem abrexss {x3 y1: setvar} (A2 B2: class x3) (C: class x3 y1):
  $ wnfc x3 C $ >
  $ wi (wral x3 (wcel B2 C) A2) (wss (cab y1 (wrex x3 (wceq (cv y1) B2) A2)) C) $;

--| Negated membership for a union. (Contributed by Thierry Arnoux, 13-Dec-2023.)
theorem nelun (A2 B2 C X: class):
  $ wi (wceq A2 (cun B2 C)) (wb (wn (wcel X A2)) (wa (wn (wcel X B2)) (wn (wcel X C)))) $;

--| If a singleton is a subset of another, their members are equal. (Contributed by NM, 28-May-2006.) (Revised by Thierry Arnoux, 11-Apr-2024.)
theorem snsssng (A2 B2 V: class):
  $ wi (wa (wcel A2 V) (wss (csn A2) (csn B2))) (wceq A2 B2) $;

--| If a class with one element is not a singleton, there is at least another element in this class. (Contributed by AV, 6-Mar-2025.) (Revised by Thierry Arnoux, 28-May-2025.)
theorem n0nsnel {x3: setvar} (A2 B2: class) (C: class x3):
  $ wi (wa (wcel C B2) (wne B2 (csn A2))) (wrex x3 (wne (cv x3) A2) B2) $;

--| Intersection with an intersection. (Contributed by Thierry Arnoux, 27-Dec-2016.)
theorem inin (A2 B2: class):
  $ wceq (cin A2 (cin A2 B2)) (cin A2 B2) $;

--| Condition for the intersections of two sets with a given set to be equal. (Contributed by Thierry Arnoux, 28-Dec-2021.)
theorem difininv (A2 B2 C: class):
  $ wi (wa (wceq (cin (cdif A2 C) B2) c0) (wceq (cin (cdif C A2) B2) c0)) (wceq (cin A2 B2) (cin C B2)) $;

--| Rewriting an equation with class difference, without using quantifiers. (Contributed by Thierry Arnoux, 24-Sep-2017.)
theorem difeq (A2 B2 C: class):
  $ wb (wceq (cdif A2 B2) C) (wa (wceq (cin C B2) c0) (wceq (cun C B2) (cun A2 B2))) $;

--| If both set differences of two sets are empty, those sets are equal. (Contributed by Thierry Arnoux, 16-Nov-2023.)
theorem eqdif (A2 B2: class):
  $ wi (wa (wceq (cdif A2 B2) c0) (wceq (cdif B2 A2) c0)) (wceq A2 B2) $;

--| Two ways to express equality relative to a class ` A ` . (Contributed by Thierry Arnoux, 23-Jun-2024.)
theorem indifbi (A2 B2 C: class):
  $ wb (wceq (cin A2 B2) (cin A2 C)) (wceq (cdif A2 B2) (cdif A2 C)) $;

--| Case where ~ diffi is a biconditional. (Contributed by Thierry Arnoux, 27-Jun-2024.)
theorem diffib (A2 B2: class):
  $ wi (wcel B2 cfn) (wb (wcel A2 cfn) (wcel (cdif A2 B2) cfn)) $;

--| Difference law for Cartesian products. (Contributed by Thierry Arnoux, 24-Jul-2023.)
theorem difxp1ss (A2 B2 C: class):
  $ wss (cxp (cdif A2 C) B2) (cxp A2 B2) $;

--| Difference law for Cartesian products. (Contributed by Thierry Arnoux, 24-Jul-2023.)
theorem difxp2ss (A2 B2 C: class):
  $ wss (cxp A2 (cdif B2 C)) (cxp A2 B2) $;

--| A remarkable equation with sets. (Contributed by Thierry Arnoux, 18-May-2020.)
theorem indifundif (A2 B2 C: class):
  $ wceq (cun (cdif (cin A2 B2) C) (cdif A2 B2)) (cdif A2 (cin B2 C)) $;

--| Closure of intersection with regard to elementhood to a power set. (Contributed by Thierry Arnoux, 18-May-2020.)
theorem elpwincl1 (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 (cpw C)) $ >
  $ wi ph (wcel (cin A2 B2) (cpw C)) $;

--| Closure of class difference with regard to elementhood to a power set. (Contributed by Thierry Arnoux, 18-May-2020.)
theorem elpwdifcl (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 (cpw C)) $ >
  $ wi ph (wcel (cdif A2 B2) (cpw C)) $;

--| Closure of indexed union with regard to elementhood to a power set. (Contributed by Thierry Arnoux, 27-May-2020.)
theorem elpwiuncl {k: setvar} (ph: wff) (A2: class) (B2: class k) (C: class) (V: class k):
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 (cpw C)) $ >
  $ wi ph (wcel (ciun k A2 B2) (cpw C)) $;

--| Equality wihin a pair. (Contributed by Thierry Arnoux, 23-Aug-2017.)
theorem elpreq (ph: wff) (A2 B2 X Y: class):
  $ wi ph (wcel X (cpr A2 B2)) $ >
  $ wi ph (wcel Y (cpr A2 B2)) $ >
  $ wi ph (wb (wceq X A2) (wceq Y A2)) $ >
  $ wi ph (wceq X Y) $;

--| If a pair is a subset of a class, the first element of the pair is an element of that class. (Contributed by Thierry Arnoux, 2-Nov-2025.)
theorem prssad (ph: wff) (A2 B2 C V: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wss (cpr A2 B2) C) $ >
  $ wi ph (wcel A2 C) $;

--| If a pair is a subset of a class, the second element of the pair is an element of that class. (Contributed by Thierry Arnoux, 2-Nov-2025.)
theorem prssbd (ph: wff) (A2 B2 C V: class):
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wss (cpr A2 B2) C) $ >
  $ wi ph (wcel B2 C) $;

--| A set ` A ` not in a pair is neither element of the pair. (Contributed by Thierry Arnoux, 20-Nov-2023.)
theorem nelpr (A2 B2 C V: class):
  $ wi (wcel A2 V) (wb (wn (wcel A2 (cpr B2 C))) (wa (wne A2 B2) (wne A2 C))) $;

--| Rewrite an empty intersection with a pair. (Contributed by Thierry Arnoux, 20-Nov-2023.)
theorem inpr0 (A2 B2 C: class):
  $ wb (wceq (cin A2 (cpr B2 C)) c0) (wa (wn (wcel B2 A2)) (wn (wcel C A2))) $;

--| The first element of a pair is not an element of a difference with this pair. (Contributed by Thierry Arnoux, 20-Nov-2023.)
theorem neldifpr1 (A2 B2 C: class):
  $ wn (wcel A2 (cdif C (cpr A2 B2))) $;

--| The second element of a pair is not an element of a difference with this pair. (Contributed by Thierry Arnoux, 20-Nov-2023.)
theorem neldifpr2 (A2 B2 C: class):
  $ wn (wcel B2 (cdif C (cpr A2 B2))) $;

--| The other element of a pair is an element of the pair. (Contributed by Thierry Arnoux, 26-Aug-2017.) Remove dependency on ~ ax-reg . (Revised by Timothy J. O'Malley, 15-Oct-2026.)
theorem unidifsnel (P X: class):
  $ wi (wa (wcel X P) (wbr P c2o cen)) (wcel (cuni (cdif P (csn X))) P) $;

--| The other element of a pair is not the known element. (Contributed by Thierry Arnoux, 26-Aug-2017.) Remove dependency on ~ ax-reg . (Revised by Timothy J. O'Malley, 15-Oct-2026.)
theorem unidifsnne (P X: class):
  $ wi (wa (wcel X P) (wbr P c2o cen)) (wne (cuni (cdif P (csn X))) X) $;

--| An unordered triple of elements of a class is a subset of the class. (Contributed by Thierry Arnoux, 2-Nov-2025.)
theorem tpssg (A2 B2 C D V W X: class):
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wcel C X)) (wb (w3a (wcel A2 D) (wcel B2 D) (wcel C D)) (wss (ctp A2 B2 C) D)) $;

--| Deduction version of tpssi : An unordered triple of elements of a class is a subset of that class. (Contributed by Thierry Arnoux, 2-Nov-2025.)
theorem tpssd (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 D) $ >
  $ wi ph (wcel B2 D) $ >
  $ wi ph (wcel C D) $ >
  $ wi ph (wss (ctp A2 B2 C) D) $;

--| If an ordered triple is a subset of a class, the first element of the triple is an element of that class. (Contributed by Thierry Arnoux, 2-Nov-2025.)
theorem tpssad (ph: wff) (A2 B2 C D V: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wss (ctp A2 B2 C) D) $ >
  $ wi ph (wcel A2 D) $;

--| If an ordered triple is a subset of a class, the second element of the triple is an element of that class. (Contributed by Thierry Arnoux, 2-Nov-2025.)
theorem tpssbd (ph: wff) (A2 B2 C D V: class):
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wss (ctp A2 B2 C) D) $ >
  $ wi ph (wcel B2 D) $;

--| If an ordered triple is a subset of a class, the third element of the triple is an element of that class. (Contributed by Thierry Arnoux, 2-Nov-2025.)
theorem tpsscd (ph: wff) (A2 B2 C D V: class):
  $ wi ph (wcel C V) $ >
  $ wi ph (wss (ctp A2 B2 C) D) $ >
  $ wi ph (wcel C D) $;

--| An equality theorem tailored for ~ ballotlemsf1o . (Contributed by Thierry Arnoux, 14-Apr-2017.)
theorem ifeqeqx {x3 a: setvar} (ph: wff x3 a) (ps: wff a) (ch: wff x3 a) (th: wff a) (A2 B2: class x3 a) (C V W X Y: class a):
  $ wi (wceq (cv x3) X) (wceq A2 C) $ >
  $ wi (wceq (cv x3) Y) (wceq B2 (cv a)) $ >
  $ wi (wceq (cv x3) X) (wb ch th) $ >
  $ wi (wceq (cv x3) Y) (wb ch ps) $ >
  $ wi ph (wceq (cv a) C) $ >
  $ wi (wa ph ps) th $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wcel X W) $ >
  $ wi (wa ph (wceq (cv x3) (cif ps X Y))) (wceq (cv a) (cif ch A2 B2)) $;

--| Elimination of a conditional operator contained in a wff ` ch ` . (Contributed by Thierry Arnoux, 25-Jan-2017.)
theorem elimifd (ph ps ch th ta: wff) (A2 B2: class):
  $ wi ph (wi (wceq (cif ps A2 B2) A2) (wb ch th)) $ >
  $ wi ph (wi (wceq (cif ps A2 B2) B2) (wb ch ta)) $ >
  $ wi ph (wb ch (wo (wa ps th) (wa (wn ps) ta))) $;

--| Elimination of two conditional operators contained in a wff ` ch ` . (Contributed by Thierry Arnoux, 25-Jan-2017.)
theorem elim2if (ph ps ch th ta et: wff) (A2 B2 C: class):
  $ wi (wceq (cif ph A2 (cif ps B2 C)) A2) (wb ch th) $ >
  $ wi (wceq (cif ph A2 (cif ps B2 C)) B2) (wb ch ta) $ >
  $ wi (wceq (cif ph A2 (cif ps B2 C)) C) (wb ch et) $ >
  $ wb ch (wo (wa ph th) (wa (wn ph) (wo (wa ps ta) (wa (wn ps) et)))) $;

--| Elimination of two conditional operators for an implication. (Contributed by Thierry Arnoux, 25-Jan-2017.)
theorem elim2ifim (ph ps ch th ta et: wff) (A2 B2 C: class):
  $ wi (wceq (cif ph A2 (cif ps B2 C)) A2) (wb ch th) $ >
  $ wi (wceq (cif ph A2 (cif ps B2 C)) B2) (wb ch ta) $ >
  $ wi (wceq (cif ph A2 (cif ps B2 C)) C) (wb ch et) $ >
  $ wi ph th $ >
  $ wi (wa (wn ph) ps) ta $ >
  $ wi (wa (wn ph) (wn ps)) et $ >
  $ ch $;

--| Given an expression ` C ` containing ` if ( ps , E , F ) ` , substitute (hypotheses .1 and .2) and evaluate (hypotheses .3 and .4) it for both cases at the same time. (Contributed by Thierry Arnoux, 13-Dec-2021.)
theorem ifeq3da (ph ps: wff) (A2 B2 C E F G H: class):
  $ wi (wceq (cif ps E F) E) (wceq C G) $ >
  $ wi (wceq (cif ps E F) F) (wceq C H) $ >
  $ wi ph (wceq G A2) $ >
  $ wi ph (wceq H B2) $ >
  $ wi ph (wceq (cif ps A2 B2) C) $;

--| Deduce truth from a conditional operator value. (Contributed by Thierry Arnoux, 20-Feb-2025.)
theorem ifnetrue (ph: wff) (A2 B2: class):
  $ wi (wa (wne A2 B2) (wceq (cif ph A2 B2) A2)) ph $;

--| Deduce falsehood from a conditional operator value. (Contributed by Thierry Arnoux, 20-Feb-2025.)
theorem ifnefals (ph: wff) (A2 B2: class):
  $ wi (wa (wne A2 B2) (wceq (cif ph A2 B2) B2)) (wn ph) $;

--| The converse of ~ ifbi holds if the two values are not equal. (Contributed by Thierry Arnoux, 20-Feb-2025.)
theorem ifnebib (ph ps: wff) (A2 B2: class):
  $ wi (wne A2 B2) (wb (wceq (cif ph A2 B2) (cif ps A2 B2)) (wb ph ps)) $;

--| Commute two nested conditionals. (Contributed by Thierry Arnoux, 4-May-2026.)
theorem ififcom (ph ps: wff) (A2 B2: class):
  $ wceq (cif ph (cif ps A2 B2) B2) (cif ps (cif ph A2 B2) B2) $;

--| Sufficient and necessary condition for a union to intersect with a given set. (Contributed by Thierry Arnoux, 27-Jan-2020.)
theorem uniinn0 {x3: setvar} (A2 B2: class):
  $ wb (wne (cin (cuni A2) B2) c0) (wrex x3 (wne (cin (cv x3) B2) c0) A2) $;

--| Express a class difference using unions and class complements. (Contributed by Thierry Arnoux, 21-Jun-2020.)
theorem difuncomp (A2 B2 C: class):
  $ wi (wss A2 C) (wceq (cdif A2 B2) (cdif C (cun (cdif C A2) B2))) $;

--| Closure of a set union with regard to elementhood to a power set. (Contributed by Thierry Arnoux, 21-Jun-2020.) (Proof shortened by BJ, 6-Apr-2024.)
theorem elpwunicl (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 (cpw (cpw B2))) $ >
  $ wi ph (wcel (cuni A2) (cpw B2)) $;

--| Rule used to change the bound variables in an indexed union, with the substitution specified implicitly by the hypothesis. (Contributed by NM, 26-Mar-2006.) (Revised by Andrew Salmon, 25-Jul-2011.)
theorem cbviunf {x3 y1: setvar} (A2 B2 C: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wnfc y1 B2 $ >
  $ wnfc x3 C $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 C) $ >
  $ wceq (ciun x3 A2 B2) (ciun y1 A2 C) $;

--| Equality deduction for indexed union, deduction version. (Contributed by Thierry Arnoux, 13-Mar-2017.)
theorem iuneq12daf {x3: setvar} (ph: wff x3) (A2 B2 C D: class x3):
  $ wnf x3 ph $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wceq C D) $ >
  $ wi ph (wceq (ciun x3 A2 C) (ciun x3 B2 D)) $;

--| Indexed union of intersection. Generalization of half of theorem "Distributive laws" in [Enderton] p. 30. Use ~ uniiun to recover Enderton's theorem. (Contributed by NM, 26-Mar-2004.) (Revised by Thierry Arnoux, 2-May-2020.)
theorem iunin1f {x3: setvar} (A2 B2 C: class x3):
  $ wnfc x3 C $ >
  $ wceq (ciun x3 A2 (cin B2 C)) (cin (ciun x3 A2 B2) C) $;

--| Subset equivalence for an indexed union. (Contributed by Thierry Arnoux, 17-Oct-2016.)
theorem ssiun3 {x3 y1: setvar} (A2 B2 C: class x3):
  $ wb (wral y1 (wrex x3 (wcel (cv y1) B2) A2) C) (wss C (ciun x3 A2 B2)) $;

--| Subset relationship for an indexed union. (Contributed by Thierry Arnoux, 31-Dec-2016.)
theorem ssiun2sf {x3: setvar} (A2 B2 C D: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 C $ >
  $ wnfc x3 D $ >
  $ wi (wceq (cv x3) C) (wceq B2 D) $ >
  $ wi (wcel C A2) (wss D (ciun x3 A2 B2)) $;

--| The union of an increasing collection of sets is its last element. (Contributed by Thierry Arnoux, 22-Jan-2017.)
theorem iuninc {n: setvar} (ph: wff) (i: setvar) (F: class):
  $ wi ph (wfn F cn) $ >
  $ wi (wa ph (wcel (cv n) cn)) (wss (cfv (cv n) F) (cfv (co (cv n) c1 caddc) F)) $ >
  $ wi (wa ph (wcel (cv i) cn)) (wceq (ciun n (co c1 (cv i) cfz) (cfv (cv n) F)) (cfv (cv i) F)) $;

--| The intersection of a set is the complement of the union of the complements. (Contributed by Thierry Arnoux, 19-Dec-2016.)
theorem iundifdifd {x3: setvar} (A2 O: class):
  $ wi (wss A2 (cpw O)) (wi (wne A2 c0) (wceq (cint A2) (cdif O (ciun x3 A2 (cdif O (cv x3)))))) $;

--| The intersection of a set is the complement of the union of the complements. TODO: shorten using ~ iundifdifd . (Contributed by Thierry Arnoux, 4-Sep-2016.)
theorem iundifdif {x3: setvar} (A2 O: class):
  $ wcel O cvv $ >
  $ wss A2 (cpw O) $ >
  $ wi (wne A2 c0) (wceq (cint A2) (cdif O (ciun x3 A2 (cdif O (cv x3))))) $;

--| Re-index an indexed union. (Contributed by Thierry Arnoux, 6-Apr-2017.)
theorem iunrdx {x3 y1: setvar} (ph: wff) (A2: class) (B2: class x3) (C: class) (D: class y1) (F: class):
  $ wi ph (wfo A2 C F) $ >
  $ wi (wa ph (wceq (cv y1) (cfv (cv x3) F))) (wceq D B2) $ >
  $ wi ph (wceq (ciun x3 A2 B2) (ciun y1 C D)) $;

--| A subset relation for an indexed union over the range of function expressed as a mapping. (Contributed by Thierry Arnoux, 27-Mar-2018.)
theorem iunrnmptss {x3 y1: setvar} (ph: wff) (A2: class x3) (B2: class x3 y1) (C: class y1) (D: class x3) (V: class x3 y1):
  $ wi (wceq (cv y1) B2) (wceq C D) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi ph (wss (ciun y1 (crn (cmpt x3 A2 B2)) C) (ciun x3 A2 D)) $;

--| Appending a set to an indexed union. (Contributed by Thierry Arnoux, 20-Nov-2023.)
theorem iunxunsn {x3: setvar} (A2 B2: class x3) (C: class) (V: class x3) (X: class):
  $ wi (wceq (cv x3) X) (wceq B2 C) $ >
  $ wi (wcel X V) (wceq (ciun x3 (cun A2 (csn X)) B2) (cun (ciun x3 A2 B2) C)) $;

--| Appending two sets to an indexed union. (Contributed by Thierry Arnoux, 20-Nov-2023.)
theorem iunxunpr {x3: setvar} (A2 B2: class x3) (C D: class) (V W: class x3) (X Y: class):
  $ wi (wceq (cv x3) X) (wceq B2 C) $ >
  $ wi (wceq (cv x3) Y) (wceq B2 D) $ >
  $ wi (wa (wcel X V) (wcel Y W)) (wceq (ciun x3 (cun A2 (cpr X Y)) B2) (cun (ciun x3 A2 B2) (cun C D))) $;

--| Provide an upper bound for the indexed union of cartesian products. (Contributed by Thierry Arnoux, 13-Oct-2025.)
theorem iunxpssiun1 {x3: setvar} (ph: wff) (A2: class) (B2 C: class x3) (E: class):
  $ wi (wa ph (wcel (cv x3) A2)) (wss C E) $ >
  $ wi ph (wss (ciun x3 A2 (cxp B2 C)) (cxp (ciun x3 A2 B2) E)) $;

--| Rewriting an indexed intersection into an intersection of its image set. (Contributed by Thierry Arnoux, 15-Jun-2024.)
theorem iinabrex {x3 y1: setvar} (A2: class) (B2: class x3) (V: class x3 y1):
  $ wi (wral x3 (wcel B2 V) A2) (wceq (ciin x3 A2 B2) (cint (cab y1 (wrex x3 (wceq (cv y1) B2) A2)))) $;

--| In case ` x ` is not free in ` B ` , disjointness is not so interesting since it reduces to cases where ` A ` is a singleton. (Google Groups discussion with Peter Mazsa.) (Contributed by Thierry Arnoux, 26-Jul-2018.)
theorem disjnf {x3: setvar} (A2 B2: class):
  $ wb (wdisj x3 A2 B2) (wo (wceq B2 c0) (wmo x3 (wcel (cv x3) A2))) $;

--| Change bound variables in a disjoint collection. (Contributed by Thierry Arnoux, 6-Apr-2017.)
theorem cbvdisjf {x3 y1: setvar} (A2: class x3) (B2 C: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc y1 B2 $ >
  $ wnfc x3 C $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq B2 C) $ >
  $ wb (wdisj x3 A2 B2) (wdisj y1 A2 C) $;

--| A subset of a disjoint collection is disjoint. (Contributed by Thierry Arnoux, 6-Apr-2017.)
theorem disjss1f {x3: setvar} (A2 B2 C: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wi (wss A2 B2) (wi (wdisj x3 B2 C) (wdisj x3 A2 C)) $;

--| Equality theorem for disjoint collection. (Contributed by Mario Carneiro, 14-Nov-2016.)
theorem disjeq1f {x3: setvar} (A2 B2 C: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wi (wceq A2 B2) (wb (wdisj x3 A2 C) (wdisj x3 B2 C)) $;

--| Simplify a disjoint union. (Contributed by Thierry Arnoux, 27-Nov-2023.)
theorem disjxun0 {x3: setvar} (ph: wff) (A2 B2 C: class x3):
  $ wi (wa ph (wcel (cv x3) B2)) (wceq C c0) $ >
  $ wi ph (wb (wdisj x3 (cun A2 B2) C) (wdisj x3 A2 C)) $;

--| A trivial partition into a subset and its complement. (Contributed by Thierry Arnoux, 25-Dec-2016.)
theorem disjdifprg {x3: setvar} (A2 B2: class) (V W: class x3):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wdisj x3 (cpr (cdif B2 A2) A2) (cv x3)) $;

--| A trivial partition of a set into its difference and intersection with another set. (Contributed by Thierry Arnoux, 25-Dec-2016.)
theorem disjdifprg2 {x3: setvar} (A2 B2: class) (V: class x3):
  $ wi (wcel A2 V) (wdisj x3 (cpr (cdif A2 B2) (cin A2 B2)) (cv x3)) $;

--| Property of a disjoint collection: if ` B ( x ) = C ` and ` B ( Y ) = D ` , and ` x =/= Y ` , then ` B ` and ` C ` are disjoint. (Contributed by Thierry Arnoux, 30-Dec-2016.)
theorem disji2f {x3: setvar} (A2: class) (B2 C: class x3) (Y: class):
  $ wnfc x3 C $ >
  $ wi (wceq (cv x3) Y) (wceq B2 C) $ >
  $ wi (w3a (wdisj x3 A2 B2) (wa (wcel (cv x3) A2) (wcel Y A2)) (wne (cv x3) Y)) (wceq (cin B2 C) c0) $;

--| Property of a disjoint collection: if ` B ( x ) ` and ` B ( Y ) = D ` have a common element ` Z ` , then ` x = Y ` . (Contributed by Thierry Arnoux, 30-Dec-2016.)
theorem disjif {x3: setvar} (A2: class) (B2 C: class x3) (Y: class) (Z: class x3):
  $ wnfc x3 C $ >
  $ wi (wceq (cv x3) Y) (wceq B2 C) $ >
  $ wi (w3a (wdisj x3 A2 B2) (wa (wcel (cv x3) A2) (wcel Y A2)) (wa (wcel Z B2) (wcel Z C))) (wceq (cv x3) Y) $;

--| Two ways to say that a collection ` B ( i ) ` for ` i e. A ` is disjoint. (Contributed by Thierry Arnoux, 8-Mar-2017.)
theorem disjorf {i j: setvar} (A2: class i j) (B2: class i) (C: class j):
  $ wnfc i A2 $ >
  $ wnfc j A2 $ >
  $ wi (wceq (cv i) (cv j)) (wceq B2 C) $ >
  $ wb (wdisj i A2 B2) (wral i (wral j (wo (wceq (cv i) (cv j)) (wceq (cin B2 C) c0)) A2) A2) $;

--| Two ways to say that a collection ` B ( i ) ` for ` i e. A ` is disjoint. (Contributed by Thierry Arnoux, 8-Mar-2017.)
theorem disjorsf {x3 i j: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wb (wdisj x3 A2 B2) (wral i (wral j (wo (wceq (cv i) (cv j)) (wceq (cin (csb x3 (cv i) B2) (csb x3 (cv j) B2)) c0)) A2) A2) $;

--| Property of a disjoint collection: if ` B ( x ) ` and ` B ( Y ) = D ` have a common element ` Z ` , then ` x = Y ` . (Contributed by Thierry Arnoux, 6-Apr-2017.)
theorem disjif2 {x3: setvar} (A2 B2 C: class x3) (Y: class) (Z: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 C $ >
  $ wi (wceq (cv x3) Y) (wceq B2 C) $ >
  $ wi (w3a (wdisj x3 A2 B2) (wa (wcel (cv x3) A2) (wcel Y A2)) (wa (wcel Z B2) (wcel Z C))) (wceq (cv x3) Y) $;

--| Rewriting a disjoint collection into a partition of its image set. (Contributed by Thierry Arnoux, 30-Dec-2016.)
theorem disjabrex {x3 y1 z: setvar} (A2: class) (B2: class x3):
  $ wi (wdisj x3 A2 B2) (wdisj y1 (cab z (wrex x3 (wceq (cv z) B2) A2)) (cv y1)) $;

--| Rewriting a disjoint collection into a partition of its image set. (Contributed by Thierry Arnoux, 30-Dec-2016.) (Revised by Thierry Arnoux, 9-Mar-2017.)
theorem disjabrexf {x3 y1 z: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wi (wdisj x3 A2 B2) (wdisj y1 (cab z (wrex x3 (wceq (cv z) B2) A2)) (cv y1)) $;

--| A preimage of a disjoint set is disjoint. (Contributed by Thierry Arnoux, 7-Feb-2017.)
theorem disjpreima {x3: setvar} (A2: class) (B2: class x3) (F: class):
  $ wi (wa (wfun F) (wdisj x3 A2 B2)) (wdisj x3 A2 (cima (ccnv F) B2)) $;

--| Rewriting a disjoint collection using the range of a mapping. (Contributed by Thierry Arnoux, 27-May-2020.)
theorem disjrnmpt {x3 y1: setvar} (A2: class) (B2: class x3):
  $ wi (wdisj x3 A2 B2) (wdisj y1 (crn (cmpt x3 A2 B2)) (cv y1)) $;

--| If a collection is disjoint, so is the collection of the intersections with a given set. (Contributed by Thierry Arnoux, 14-Feb-2017.)
theorem disjin {x3: setvar} (A2 B2 C: class x3):
  $ wi (wdisj x3 B2 C) (wdisj x3 B2 (cin C A2)) $;

--| If a collection is disjoint, so is the collection of the intersections with a given set. (Contributed by Thierry Arnoux, 21-Jun-2020.)
theorem disjin2 {x3: setvar} (A2 B2 C: class x3):
  $ wi (wdisj x3 B2 C) (wdisj x3 B2 (cin A2 C)) $;

--| Derive a disjunction over a Cartesian product from the disjunctions over its first and second elements. (Contributed by Thierry Arnoux, 9-Mar-2018.)
theorem disjxpin {x3 y1 p: setvar} (ph: wff x3 y1 p) (A2: class y1) (B2: class x3) (C D: class x3 y1) (E: class y1 p) (F: class x3 p):
  $ wi (wceq (cv x3) (cfv (cv p) c1st)) (wceq C E) $ >
  $ wi (wceq (cv y1) (cfv (cv p) c2nd)) (wceq D F) $ >
  $ wi ph (wdisj x3 A2 C) $ >
  $ wi ph (wdisj y1 B2 D) $ >
  $ wi ph (wdisj p (cxp A2 B2) (cin E F)) $;

--| Rewrite a countable union as a disjoint union. Cf. ~ iundisj . (Contributed by Thierry Arnoux, 31-Dec-2016.)
theorem iundisjf {k n: setvar} (A2 B2: class k n):
  $ wnfc k A2 $ >
  $ wnfc n B2 $ >
  $ wi (wceq (cv n) (cv k)) (wceq A2 B2) $ >
  $ wceq (ciun n cn A2) (ciun n cn (cdif A2 (ciun k (co c1 (cv n) cfzo) B2))) $;

--| A disjoint union is disjoint. Cf. ~ iundisj2 . (Contributed by Thierry Arnoux, 30-Dec-2016.)
theorem iundisj2f {k n: setvar} (A2 B2: class k n):
  $ wnfc k A2 $ >
  $ wnfc n B2 $ >
  $ wi (wceq (cv n) (cv k)) (wceq A2 B2) $ >
  $ wdisj n cn (cdif A2 (ciun k (co c1 (cv n) cfzo) B2)) $;

--| Re-index a disjunct collection statement. (Contributed by Thierry Arnoux, 7-Apr-2017.)
theorem disjrdx {x3 y1: setvar} (ph: wff) (A2: class) (B2: class x3) (C: class) (D: class y1) (F: class):
  $ wi ph (wf1o A2 C F) $ >
  $ wi (wa ph (wceq (cv y1) (cfv (cv x3) F))) (wceq D B2) $ >
  $ wi ph (wb (wdisj x3 A2 B2) (wdisj y1 C D)) $;

--| Two ways to say that two classes are disjoint (or equal). (Contributed by Thierry Arnoux, 4-Oct-2016.)
theorem disjex {z: setvar} (A2 B2: class):
  $ wb (wi (wex z (wa (wcel (cv z) A2) (wcel (cv z) B2))) (wceq A2 B2)) (wo (wceq A2 B2) (wceq (cin A2 B2) c0)) $;

--| A variant of ~ disjex , applicable for more generic families. (Contributed by Thierry Arnoux, 4-Oct-2016.)
theorem disjexc {x3 y1 z: setvar} (A2 B2: class x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wceq A2 B2) $ >
  $ wi (wi (wex z (wa (wcel (cv z) A2) (wcel (cv z) B2))) (wceq (cv x3) (cv y1))) (wo (wceq A2 B2) (wceq (cin A2 B2) c0)) $;

--| Append an element to a disjoint collection. Similar to ~ ralunsn , ~ gsumunsn , etc. (Contributed by Thierry Arnoux, 28-Mar-2018.)
theorem disjunsn {x3: setvar} (A2: class) (B2: class x3) (C M V: class):
  $ wi (wceq (cv x3) M) (wceq B2 C) $ >
  $ wi (wa (wcel M V) (wn (wcel M A2))) (wb (wdisj x3 (cun A2 (csn M)) B2) (wa (wdisj x3 A2 B2) (wceq (cin (ciun x3 A2 B2) C) c0))) $;

--| Adding the empty element preserves disjointness. (Contributed by Thierry Arnoux, 30-May-2020.)
theorem disjun0 {x3: setvar} (A2: class):
  $ wi (wdisj x3 A2 (cv x3)) (wdisj x3 (cun A2 (csn c0)) (cv x3)) $;

--| A set of elements B of a disjoint set A is disjoint with another element of that set. (Contributed by Thierry Arnoux, 24-May-2020.)
theorem disjiunel {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3) (D E Y: class):
  $ wi ph (wdisj x3 A2 B2) $ >
  $ wi (wceq (cv x3) Y) (wceq B2 D) $ >
  $ wi ph (wss E A2) $ >
  $ wi ph (wcel Y (cdif A2 E)) $ >
  $ wi ph (wceq (cin (ciun x3 E B2) D) c0) $;

--| A set of elements B of a disjoint set A is disjoint with another element of that set. (Contributed by Thierry Arnoux, 24-May-2020.)
theorem disjuniel {x3: setvar} (ph: wff x3) (A2 B2 C: class):
  $ wi ph (wdisj x3 A2 (cv x3)) $ >
  $ wi ph (wss B2 A2) $ >
  $ wi ph (wcel C (cdif A2 B2)) $ >
  $ wi ph (wceq (cin (cuni B2) C) c0) $;

--| Restriction of a constant function (or other Cartesian product) outside of its domain. (Contributed by Thierry Arnoux, 25-Jan-2017.)
theorem xpdisjres (A2 B2 C: class):
  $ wi (wceq (cin A2 C) c0) (wceq (cres (cxp A2 B2) C) c0) $;

--| Ordered pair elementhood outside of the diagonal. (Contributed by Thierry Arnoux, 1-Jan-2020.)
theorem opeldifid (A2 X Y: class):
  $ wi (wrel A2) (wb (wcel (cop X Y) (cdif A2 cid)) (wa (wcel (cop X Y) A2) (wne X Y))) $;

--| Case when class difference in unaffected by restriction. (Contributed by Thierry Arnoux, 1-Jan-2020.)
theorem difres (A2 B2 C: class):
  $ wi (wss A2 (cxp B2 cvv)) (wceq (cdif A2 (cres C B2)) (cdif A2 C)) $;

--| Image of the difference with a Cartesian product. (Contributed by Thierry Arnoux, 13-Dec-2017.)
theorem imadifxp (A2 B2 C R: class):
  $ wi (wss C A2) (wceq (cima (cdif R (cxp A2 B2)) C) (cdif (cima R C) B2)) $;

--| A relation (set) is finite if and only if both its domain and range are finite. (Contributed by Thierry Arnoux, 27-Aug-2017.)
theorem relfi (A2: class):
  $ wi (wrel A2) (wb (wcel A2 cfn) (wa (wcel (cdm A2) cfn) (wcel (crn A2) cfn))) $;

--| Restriction of the empty function. (Contributed by Thierry Arnoux, 20-Nov-2023.)
theorem _0res (A2: class):
  $ wceq (cres c0 A2) c0 $;

--| Build an equivalence relation from a function. Two values are equivalent if they have the same image by the function. See also ~ fcoinvbr . (Contributed by Thierry Arnoux, 3-Jan-2020.)
theorem fcoinver (F X: class):
  $ wi (wfn F X) (wer X (ccom (ccnv F) F)) $;

--| Binary relation for the equivalence relation from ~ fcoinver . (Contributed by Thierry Arnoux, 3-Jan-2020.)
theorem fcoinvbr (A2 c_sm F X Y: class):
  $ wceq c_sm (ccom (ccnv F) F) $ >
  $ wi (w3a (wfn F A2) (wcel X A2) (wcel Y A2)) (wb (wbr X Y c_sm) (wceq (cfv X F) (cfv Y F))) $;

--| The law of concretion for a binary relation. (Contributed by Mario Carneiro, 19-Dec-2013.) (Revised by Thierry Arnoux, 17-May-2020.)
theorem brabgaf {x3 y1: setvar} (ph: wff x3 y1) (ps: wff x3) (A2 B2: class) (R V W: class x3 y1):
  $ wnf x3 ps $ >
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ wceq R (copab x3 y1 ph) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wbr A2 B2 R) ps) $;

--| Two things in a binary relation belong to the relation's domain. (Contributed by Thierry Arnoux, 29-Aug-2017.)
theorem brelg (A2 B2 C D R: class):
  $ wi (wa (wss R (cxp C D)) (wbr A2 B2 R)) (wa (wcel A2 C) (wcel B2 D)) $;

--| Substitution for an eight-place predicate. (Contributed by Scott Fenton, 26-Sep-2013.) (Revised by Mario Carneiro, 3-May-2015.) (Revised by Thierry Arnoux, 21-Mar-2019.)
theorem br8d {e f2 g2 h q p a b c d: setvar} (ph: wff e f2 g2 h q p a b c d) (ps: wff e f2 g2 h a b c d) (ch: wff e f2 g2 h q p b c d) (th: wff e f2 g2 h q p a c d) (ta: wff e f2 g2 h q p a b d) (et: wff e f2 g2 h q p a b c) (ze: wff f2 g2 h q p a b c d) (si: wff e g2 h q p a b c d) (rh: wff e f2 h q p a b c d) (mu: wff q p) (A2 B2 C D P: class) (R: class e f2 g2 h q p a b c d) (E F G H: class):
  $ wi (wceq (cv a) A2) (wb ps ch) $ >
  $ wi (wceq (cv b) B2) (wb ch th) $ >
  $ wi (wceq (cv c) C) (wb th ta) $ >
  $ wi (wceq (cv d) D) (wb ta et) $ >
  $ wi (wceq (cv e) E) (wb et ze) $ >
  $ wi (wceq (cv f2) F) (wb ze si) $ >
  $ wi (wceq (cv g2) G) (wb si rh) $ >
  $ wi (wceq (cv h) H) (wb rh mu) $ >
  $ wi ph (wceq R (copab p q (wrex a (wrex b (wrex c (wrex d (wrex e (wrex f2 (wrex g2 (wrex h (w3a (wceq (cv p) (cop (cop (cv a) (cv b)) (cop (cv c) (cv d)))) (wceq (cv q) (cop (cop (cv e) (cv f2)) (cop (cv g2) (cv h)))) ps) P) P) P) P) P) P) P) P))) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel G P) $ >
  $ wi ph (wcel H P) $ >
  $ wi ph (wb (wbr (cop (cop A2 B2) (cop C D)) (cop (cop E F) (cop G H)) R) mu) $;

--| Relation between two functions implies the same relation for the function value at a given ` X ` . See also ~ fnfvof . (Contributed by Thierry Arnoux, 15-Jan-2026.)
theorem fnfvor (ph: wff) (A2 R F G V X: class):
  $ wi ph (wfn F A2) $ >
  $ wi ph (wfn G A2) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wbr F G (cofr R)) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wbr (cfv X F) (cfv X G) R) $;

--| Function relation between function compositions. (Contributed by Thierry Arnoux, 15-Jan-2026.)
theorem ofrco (ph: wff) (A2 C R F G H V W: class):
  $ wi ph (wfn F A2) $ >
  $ wi ph (wfn G A2) $ >
  $ wi ph (wf C A2 H) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel C W) $ >
  $ wi ph (wbr F G (cofr R)) $ >
  $ wi ph (wbr (ccom F H) (ccom G H) (cofr R)) $;

--| Domain of an ordered-pair class abstraction. (Contributed by Thierry Arnoux, 31-Aug-2017.)
theorem opabdm {x3 y1: setvar} (ph: wff x3 y1) (R: class):
  $ wi (wceq R (copab x3 y1 ph)) (wceq (cdm R) (cab x3 (wex y1 ph))) $;

--| Range of an ordered-pair class abstraction. (Contributed by Thierry Arnoux, 31-Aug-2017.)
theorem opabrn {x3 y1: setvar} (ph: wff x3 y1) (R: class):
  $ wi (wceq R (copab x3 y1 ph)) (wceq (crn R) (cab y1 (wex x3 ph))) $;

--| Sufficient condition for a collection of ordered pairs to be a subclass of a relation. (Contributed by Peter Mazsa, 21-Oct-2019.) (Revised by Thierry Arnoux, 18-Feb-2022.)
theorem opabssi {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wi ph (wcel (cop (cv x3) (cv y1)) A2) $ >
  $ wss (copab x3 y1 ph) A2 $;

--| One direction of ~ opabid2 which holds without a ` Rel A ` requirement. (Contributed by Thierry Arnoux, 18-Feb-2022.)
theorem opabid2ss {x3 y1: setvar} (A2: class):
  $ wss (copab x3 y1 (wcel (cop (cv x3) (cv y1)) A2)) A2 $;

--| A subclass relationship depends only on a relation's ordered pairs. Theorem 3.2(i) of [Monk1] p. 33. (Contributed by NM, 2-Aug-1994.) (Proof shortened by Andrew Salmon, 27-Aug-2011.) (Revised by Thierry Arnoux, 6-Nov-2017.)
theorem ssrelf {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc y1 B2 $ >
  $ wi (wrel A2) (wb (wss A2 B2) (wal x3 (wal y1 (wi (wcel (cop (cv x3) (cv y1)) A2) (wcel (cop (cv x3) (cv y1)) B2))))) $;

--| A version of ~ eqrelrdv2 with explicit nonfree declarations. (Contributed by Thierry Arnoux, 28-Aug-2017.)
theorem eqrelrd2 {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc y1 B2 $ >
  $ wi ph (wb (wcel (cop (cv x3) (cv y1)) A2) (wcel (cop (cv x3) (cv y1)) B2)) $ >
  $ wi (wa (wa (wrel A2) (wrel B2)) ph) (wceq A2 B2) $;

--| Biconditional for equivalent elements. (Contributed by Thierry Arnoux, 6-Jan-2020.)
theorem erbr3b (A2 B2 C R X: class):
  $ wi (wa (wer X R) (wbr A2 B2 R)) (wb (wbr A2 C R) (wbr B2 C R)) $;

--| Image of a singleton by an indexed union involving that singleton. (Contributed by Thierry Arnoux, 10-Apr-2020.)
theorem iunsnima {x3: setvar} (ph: wff x3) (A2 B2 V W: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 W) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wceq (cima (ciun x3 A2 (cxp (csn (cv x3)) B2)) (csn (cv x3))) B2) $;

--| Version of ~ iunsnima with different variables. (Contributed by Thierry Arnoux, 22-Jun-2024.)
theorem iunsnima2 {x3: setvar} (ph: wff x3) (A2: class) (B2 C V W: class x3) (Y: class):
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 W) $ >
  $ wnfc x3 C $ >
  $ wi (wceq (cv x3) Y) (wceq B2 C) $ >
  $ wi (wa ph (wcel Y A2)) (wceq (cima (ciun x3 A2 (cxp (csn (cv x3)) B2)) (csn Y)) C) $;

--| An alternative way to express a constant function. (Contributed by Glauco Siliprandi, 5-Feb-2022.) Removed hyphotheses as suggested by SN (Revised by Thierry Arnoux, 10-Jan-2026.)
theorem fconst7v {x3: setvar} (ph: wff) (A2 B2 F: class):
  $ wi ph (wfn F A2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wceq (cfv (cv x3) F) B2) $ >
  $ wi ph (wceq F (cxp A2 (csn B2))) $;

--| Composition with a constant function. See also ~ fcoconst . (Contributed by Thierry Arnoux, 11-Jan-2026.)
theorem constcof (ph: wff) (F I V X Y: class):
  $ wi ph (wf X I F) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wceq (ccom (cxp I (csn Y)) F) (cxp X (csn Y))) $;

--| Alternate version of ~ ac6 with bound-variable hypothesis. (Contributed by NM, 2-Mar-2008.) (Revised by Thierry Arnoux, 17-May-2020.)
theorem ac6sf2 {x3 y1 f2: setvar} (ph: wff x3 y1) (ps: wff x3 y1 f2) (A2 B2: class y1):
  $ wnfc y1 B2 $ >
  $ wnf y1 ps $ >
  $ wcel A2 cvv $ >
  $ wi (wceq (cv y1) (cfv (cv x3) (cv f2))) (wb ph ps) $ >
  $ wi (wral x3 (wrex y1 ph B2) A2) (wex f2 (wa (wf A2 B2 (cv f2)) (wral x3 ps A2))) $;

--| Axiom of choice equivalent, deduction form. (Contributed by Thierry Arnoux, 13-Oct-2025.) Remove dependency on ~ ax-reg and ~ ax-inf2 . (Revised by Timothy J. O'Malley, 15-Oct-2026.)
theorem ac6mapd {x3 y1 f2: setvar} (ph: wff y1) (ps: wff x3 y1) (ch: wff x3 f2) (A2: class y1) (B2: class) (V W: class x3 y1 f2):
  $ wi (wceq (cv y1) (cfv (cv x3) (cv f2))) (wb ps ch) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wrex y1 ps B2) $ >
  $ wi ph (wrex f2 (wral x3 ch A2) (co B2 A2 cmap)) $;

--| Restriction of a function with a subclass of its domain. (Contributed by Thierry Arnoux, 10-Oct-2017.)
theorem fnresin (A2 B2 F: class):
  $ wi (wfn F A2) (wfn (cres F B2) (cin A2 B2)) $;

--| Recover the original function from a point-added function. See also ~ funresdfunsn and ~ fsnunres . (Contributed by Thierry Arnoux, 15-Feb-2026.)
theorem fresunsn (A2 F X Y: class):
  $ wi (w3a (wfn F A2) (wcel X A2) (wceq (cfv X F) Y)) (wceq (cun (cres F (cdif A2 (csn X))) (csn (cop X Y))) F) $;

--| Describe an implicit one-to-one onto function. (Contributed by Thierry Arnoux, 23-Apr-2017.)
theorem f1o3d {x3 y1: setvar} (ph: wff) (A2 B2: class) (C: class x3) (D: class y1) (F: class x3 y1):
  $ wi ph (wceq F (cmpt x3 A2 C)) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C B2) $ >
  $ wi (wa ph (wcel (cv y1) B2)) (wcel D A2) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) B2))) (wb (wceq (cv x3) D) (wceq (cv y1) C)) $ >
  $ wi ph (wa (wf1o A2 B2 F) (wceq (ccnv F) (cmpt y1 B2 D))) $;

--| A function of nonempty domain is not empty. (Contributed by Thierry Arnoux, 20-Nov-2023.)
theorem eldmne0 (F X: class):
  $ wi (wcel X (cdm F)) (wne F c0) $;

--| Equinumerosity of the range of an injective function. (Contributed by Thierry Arnoux, 7-Jul-2023.)
theorem f1rnen (A2 B2 F V: class):
  $ wi (wa (wf1 A2 B2 F) (wcel A2 V)) (wbr (crn F) A2 cen) $;

--| Equality deduction for one-to-one onto functions. (Contributed by Thierry Arnoux, 10-Jan-2026.)
theorem f1oeq3dd (ph: wff) (A2 B2 C F: class):
  $ wi ph (wf1o C A2 F) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wf1o C B2 F) $;

--| Sufficient conditions for the restriction of an involution to be a bijection. (Contributed by Thierry Arnoux, 7-Dec-2016.)
theorem rinvf1o (A2 B2 F: class):
  $ wfun F $ >
  $ wceq (ccnv F) F $ >
  $ wss (cima F A2) B2 $ >
  $ wss (cima F B2) A2 $ >
  $ wss A2 (cdm F) $ >
  $ wss B2 (cdm F) $ >
  $ wf1o A2 B2 (cres F A2) $;

--| Conditions for a restriction to be a one-to-one onto function. (Contributed by Thierry Arnoux, 7-Dec-2016.)
theorem fresf1o (C F: class):
  $ wi (w3a (wfun F) (wss C (crn F)) (wfun (cres (ccnv F) C))) (wf1o (cima (ccnv F) C) C (cres F (cima (ccnv F) C))) $;

--| The set of fixed points of ` F ` is the complement of the set of points moved by ` F ` . (Contributed by Thierry Arnoux, 17-Nov-2023.)
theorem nfpconfp (A2 F: class):
  $ wi (wfn F A2) (wceq (cdif A2 (cdm (cdif F cid))) (cdm (cin F cid))) $;

--| The action of composing (to the right) with a bijection is itself a bijection of functions. (Contributed by Thierry Arnoux, 3-Jan-2021.)
theorem fmptco1f1o {f2: setvar} (ph: wff) (A2 B2: class) (D R: class f2) (T: class) (E F V W X: class f2):
  $ wceq A2 (co R E cmap) $ >
  $ wceq B2 (co R D cmap) $ >
  $ wceq F (cmpt f2 A2 (ccom (cv f2) T)) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel E W) $ >
  $ wi ph (wcel R X) $ >
  $ wi ph (wf1o D E T) $ >
  $ wi ph (wf1o A2 B2 F) $;

--| Express composition of a maps-to function with another function in a maps-to notation. (Contributed by Thierry Arnoux, 15-Jul-2023.)
theorem cofmpt2 {x3 y1: setvar} (ph: wff) (A2 B2: class) (C: class y1) (D: class x3) (E F: class) (V: class x3 y1):
  $ wi (wa ph (wceq (cv y1) (cfv (cv x3) F))) (wceq C D) $ >
  $ wi (wa ph (wcel (cv y1) B2)) (wcel C E) $ >
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wceq (ccom (cmpt y1 B2 C) F) (cmpt x3 A2 D)) $;

--| Express injection for a mapping operation. (Contributed by Thierry Arnoux, 3-May-2020.)
theorem f1mptrn {x3 y1: setvar} (ph: wff) (A2: class) (B2: class x3) (C: class):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 C) $ >
  $ wi (wa ph (wcel (cv y1) C)) (wreu x3 (wceq (cv y1) B2) A2) $ >
  $ wi ph (wfun (ccnv (cmpt x3 A2 B2))) $;

--| Alternate definition of the image of a function. (Contributed by Raph Levien, 20-Nov-2006.) (Revised by Thierry Arnoux, 24-Apr-2017.)
theorem dfimafnf {x3 y1: setvar} (A2 F: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 F $ >
  $ wi (wa (wfun F) (wss A2 (cdm F))) (wceq (cima F A2) (cab y1 (wrex x3 (wceq (cv y1) (cfv (cv x3) F)) A2))) $;

--| Membership relation for the values of a function whose image is a subclass. (Contributed by Thierry Arnoux, 24-Apr-2017.)
theorem funimass4f {x3: setvar} (A2 B2 F: class x3):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 F $ >
  $ wi (wa (wfun F) (wss A2 (cdm F))) (wb (wss (cima F A2) B2) (wral x3 (wcel (cfv (cv x3) F) B2) A2)) $;

--| Show that the support of a function is contained in a set. (Contributed by Thierry Arnoux, 22-Jun-2017.) (Revised by AV, 1-Sep-2020.)
theorem suppss2f {k: setvar} (ph: wff k) (A2 B2 V W: class k) (Z: class):
  $ wnf k ph $ >
  $ wnfc k A2 $ >
  $ wnfc k W $ >
  $ wi (wa ph (wcel (cv k) (cdif A2 W))) (wceq B2 Z) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wss (co (cmpt k A2 B2) Z csupp) W) $;

--| The range of the function operation. (Contributed by Thierry Arnoux, 8-Jan-2017.)
theorem ofrn (ph: wff) (A2 B2 C c_pl F G V: class):
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wf A2 B2 G) $ >
  $ wi ph (wf (cxp B2 B2) C c_pl) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wss (crn (co F G (cof c_pl))) C) $;

--| The range of the function operation. (Contributed by Thierry Arnoux, 21-Mar-2017.)
theorem ofrn2 (ph: wff) (A2 B2 C c_pl F G V: class):
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wf A2 B2 G) $ >
  $ wi ph (wf (cxp B2 B2) C c_pl) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wss (crn (co F G (cof c_pl))) (cima c_pl (cxp (crn F) (crn G)))) $;

--| The function operation produces a function - alternative form with all antecedents as deduction. (Contributed by Thierry Arnoux, 17-Feb-2017.)
theorem off2 {x3 y1: setvar} (ph: wff) (A2 B2 C: class x3 y1) (R S T U F: class) (G: class x3) (V W: class x3 y1):
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) T))) (wcel (co (cv x3) (cv y1) R) U) $ >
  $ wi ph (wf A2 S F) $ >
  $ wi ph (wf B2 T G) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wceq (cin A2 B2) C) $ >
  $ wi ph (wf C U (co F G (cof R))) $;

--| Applying an operation restricted to the range of the functions does not change the function operation. (Contributed by Thierry Arnoux, 14-Feb-2018.)
theorem ofresid (ph: wff) (A2 B2 R F G V: class):
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wf A2 B2 G) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wceq (co F G (cof R)) (co F G (cof (cres R (cxp B2 B2))))) $;

--| Preimage of a class union. (Contributed by Thierry Arnoux, 7-Feb-2017.)
theorem unipreima {x3: setvar} (A2 F: class):
  $ wi (wfun F) (wceq (cima (ccnv F) (cuni A2)) (ciun x3 A2 (cima (ccnv F) (cv x3)))) $;

--| Value of a function producing ordered pairs. (Contributed by Thierry Arnoux, 3-Jan-2017.)
theorem opfv (x3: setvar) (F: class):
  $ wi (wa (wa (wfun F) (wss (crn F) (cxp cvv cvv))) (wcel (cv x3) (cdm F))) (wceq (cfv (cv x3) F) (cop (cfv (cv x3) (ccom c1st F)) (cfv (cv x3) (ccom c2nd F)))) $;

--| The preimage of a Cartesian product is the intersection of the preimages of each component function. (Contributed by Thierry Arnoux, 6-Jun-2017.)
theorem xppreima (F Y Z: class):
  $ wi (wa (wfun F) (wss (crn F) (cxp cvv cvv))) (wceq (cima (ccnv F) (cxp Y Z)) (cin (cima (ccnv (ccom c1st F)) Y) (cima (ccnv (ccom c2nd F)) Z))) $;

--| Image of a cartesian product by ` 2nd ` . (Contributed by Thierry Arnoux, 23-Jun-2024.)
theorem _2ndimaxp (A2 B2: class):
  $ wi (wne A2 c0) (wceq (cima c2nd (cxp A2 B2)) B2) $;

--| Domain of a disjoint union of non-empty sets. (Contributed by Thierry Arnoux, 5-Oct-2025.)
theorem dmdju {x3: setvar} (ph: wff) (A2: class) (B2: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wne B2 c0) $ >
  $ wi ph (wceq (cdm (ciun x3 A2 (cxp (csn (cv x3)) B2))) A2) $;

--| Stronger version of ~ djussxp . (Contributed by Thierry Arnoux, 23-Jun-2024.)
theorem djussxp2 {k: setvar} (A2: class) (B2: class k):
  $ wss (ciun k A2 (cxp (csn (cv k)) B2)) (cxp A2 (ciun k A2 B2)) $;

--| The ` 2nd ` function restricted to a disjoint union is injective. (Contributed by Thierry Arnoux, 23-Jun-2024.)
theorem _2ndresdju {x3: setvar} (ph: wff) (A2: class) (C U V W: class x3) (X: class):
  $ wceq U (ciun x3 X (cxp (csn (cv x3)) C)) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel X W) $ >
  $ wi ph (wdisj x3 X C) $ >
  $ wi ph (wceq (ciun x3 X C) A2) $ >
  $ wi ph (wf1 U A2 (cres c2nd U)) $;

--| The ` 2nd ` function restricted to a disjoint union is a bijection. See also e.g. ~ 2ndconst . (Contributed by Thierry Arnoux, 23-Jun-2024.)
theorem _2ndresdjuf1o {x3: setvar} (ph: wff) (A2: class) (C U V W: class x3) (X: class):
  $ wceq U (ciun x3 X (cxp (csn (cv x3)) C)) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel X W) $ >
  $ wi ph (wdisj x3 X C) $ >
  $ wi ph (wceq (ciun x3 X C) A2) $ >
  $ wi ph (wf1o U A2 (cres c2nd U)) $;

--| The preimage of a Cartesian product is the intersection of the preimages of each component function. (Contributed by Thierry Arnoux, 7-Jun-2017.)
theorem xppreima2 {x3: setvar} (ph: wff) (A2 B2 C F G H: class) (Y Z: class x3):
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wf A2 C G) $ >
  $ wceq H (cmpt x3 A2 (cop (cfv (cv x3) F) (cfv (cv x3) G))) $ >
  $ wi ph (wceq (cima (ccnv H) (cxp Y Z)) (cin (cima (ccnv F) Y) (cima (ccnv G) Z))) $;

--| Membership in a union of a mapping function-defined family of sets. (Contributed by Thierry Arnoux, 28-Sep-2016.)
theorem abfmpunirn {x3 y1: setvar} (ph: wff x3 y1) (ps: wff x3) (B2 F V: class):
  $ wceq F (cmpt x3 V (cab y1 ph)) $ >
  $ wcel (cab y1 ph) cvv $ >
  $ wi (wceq (cv y1) B2) (wb ph ps) $ >
  $ wb (wcel B2 (cuni (crn F))) (wa (wcel B2 cvv) (wrex x3 ps V)) $;

--| Membership in a union of a mapping function-defined family of sets. (Contributed by Thierry Arnoux, 30-Sep-2016.)
theorem rabfmpunirn {x3 y1: setvar} (ph: wff x3 y1) (ps: wff x3) (B2 F V: class) (W: class x3):
  $ wceq F (cmpt x3 V (crab y1 ph W)) $ >
  $ wcel W cvv $ >
  $ wi (wceq (cv y1) B2) (wb ph ps) $ >
  $ wb (wcel B2 (cuni (crn F))) (wrex x3 (wa (wcel B2 W) ps) V) $;

--| Membership in an element of a mapping function-defined family of sets. (Contributed by Thierry Arnoux, 19-Oct-2016.)
theorem abfmpeld {x3 y1: setvar} (ph: wff) (ps: wff x3 y1) (ch: wff) (A2 B2 F V: class) (W: class x3):
  $ wceq F (cmpt x3 V (cab y1 ps)) $ >
  $ wi ph (wcel (cab y1 ps) cvv) $ >
  $ wi ph (wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ps ch)) $ >
  $ wi ph (wi (wa (wcel A2 V) (wcel B2 W)) (wb (wcel B2 (cfv A2 F)) ch)) $;

--| Membership in an element of a mapping function-defined family of sets. (Contributed by Thierry Arnoux, 19-Oct-2016.)
theorem abfmpel {x3 y1: setvar} (ph: wff x3 y1) (ps: wff) (A2 B2 F V: class) (W: class x3):
  $ wceq F (cmpt x3 V (cab y1 ph)) $ >
  $ wcel (cab y1 ph) cvv $ >
  $ wi (wa (wceq (cv x3) A2) (wceq (cv y1) B2)) (wb ph ps) $ >
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wcel B2 (cfv A2 F)) ps) $;

--| Domain and codomain of the mapping operation; deduction form. This version of ~ fmptd uses bound-variable hypothesis instead of distinct variable conditions. (Contributed by Thierry Arnoux, 28-Mar-2017.)
theorem fmptdf2 {x3: setvar} (ph: wff x3) (A2 B2 C F: class x3):
  $ wnf x3 ph $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 C $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 C) $ >
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi ph (wf A2 C F) $;

--| Composition of two functions expressed as ordered-pair class abstractions. (Contributed by FL, 21-Jun-2012.) (Revised by Mario Carneiro, 24-Jul-2014.) (Revised by Thierry Arnoux, 10-May-2017.)
theorem fmptcof2 {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1) (B2 R: class x3) (S T F G: class x3 y1):
  $ wnfc x3 S $ >
  $ wnfc y1 T $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnf x3 ph $ >
  $ wi ph (wral x3 (wcel R B2) A2) $ >
  $ wi ph (wceq F (cmpt x3 A2 R)) $ >
  $ wi ph (wceq G (cmpt y1 B2 S)) $ >
  $ wi (wceq (cv y1) R) (wceq S T) $ >
  $ wi ph (wceq (ccom G F) (cmpt x3 A2 T)) $;

--| Express composition of two functions as a maps-to applying both in sequence. This version has one less distinct variable restriction compared to ~ fcompt . (Contributed by Thierry Arnoux, 30-Jun-2017.)
theorem fcomptf {x3: setvar} (A2: class) (B2: class x3) (C D E: class):
  $ wnfc x3 B2 $ >
  $ wi (wa (wf D E A2) (wf C D B2)) (wceq (ccom A2 B2) (cmpt x3 C (cfv (cfv (cv x3) B2) A2))) $;

--| Axiom of choice for the union of the range of a mapping to function. (Contributed by Thierry Arnoux, 6-Nov-2019.)
theorem acunirnmpt {y1 f2 j: setvar} (ph: wff) (A2: class y1 f2) (B2: class y1 f2 j) (C: class) (V: class y1 f2 j):
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv j) A2)) (wne B2 c0) $ >
  $ wceq C (crn (cmpt j A2 B2)) $ >
  $ wi ph (wex f2 (wa (wf C (cuni C) (cv f2)) (wral y1 (wrex j (wcel (cfv (cv y1) (cv f2)) B2) A2) C))) $;

--| Axiom of choice for the union of the range of a mapping to function. (Contributed by Thierry Arnoux, 7-Nov-2019.) Remove dependency on ~ ax-reg and ~ ax-inf2 . (Revised by Timothy J. O'Malley, 15-Oct-2026.)
theorem acunirnmpt2 {x3 f2 j: setvar} (ph: wff) (A2: class) (B2: class x3 j) (C: class) (D: class x3 f2) (V: class x3 f2 j):
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv j) A2)) (wne B2 c0) $ >
  $ wceq C (cuni (crn (cmpt j A2 B2))) $ >
  $ wi (wceq (cv j) (cfv (cv x3) (cv f2))) (wceq B2 D) $ >
  $ wi ph (wex f2 (wa (wf C A2 (cv f2)) (wral x3 (wcel (cv x3) D) C))) $;

--| Axiom of choice for the union of the range of a mapping to function. (Contributed by Thierry Arnoux, 7-Nov-2019.) Remove dependency on ~ ax-reg and ~ ax-inf2 . (Revised by Timothy J. O'Malley, 15-Oct-2026.)
theorem acunirnmpt2f {x3 f2 j: setvar} (ph: wff) (A2: class j) (B2: class x3 j) (C: class j) (D V W: class x3 f2 j):
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv j) A2)) (wne B2 c0) $ >
  $ wnfc j A2 $ >
  $ wnfc j C $ >
  $ wnfc j D $ >
  $ wceq C (ciun j A2 B2) $ >
  $ wi (wceq (cv j) (cfv (cv x3) (cv f2))) (wceq B2 D) $ >
  $ wi (wa ph (wcel (cv j) A2)) (wcel B2 W) $ >
  $ wi ph (wex f2 (wa (wf C A2 (cv f2)) (wral x3 (wcel (cv x3) D) C))) $;

--| Choice in an index union. (Contributed by Thierry Arnoux, 8-Nov-2019.)
theorem aciunf1lem {x3 f2 j: setvar} (ph: wff f2) (A2 B2: class j) (V: class x3 f2 j) (W: class x3 f2):
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv j) A2)) (wne B2 c0) $ >
  $ wnfc j A2 $ >
  $ wi (wa ph (wcel (cv j) A2)) (wcel B2 W) $ >
  $ wi ph (wex f2 (wa (wf1 (ciun j A2 B2) (ciun j A2 (cxp (csn (cv j)) B2)) (cv f2)) (wral x3 (wceq (cfv (cfv (cv x3) (cv f2)) c2nd) (cv x3)) (ciun j A2 B2)))) $;

--| Choice in an index union. (Contributed by Thierry Arnoux, 4-May-2020.)
theorem aciunf1 {f2 j k: setvar} (ph: wff) (A2: class) (B2: class j) (V: class f2 j k) (W: class f2 k):
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv j) A2)) (wcel B2 W) $ >
  $ wi ph (wex f2 (wa (wf1 (ciun j A2 B2) (ciun j A2 (cxp (csn (cv j)) B2)) (cv f2)) (wral k (wceq (cfv (cfv (cv k) (cv f2)) c2nd) (cv k)) (ciun j A2 B2)))) $;

--| Function operation as a composition with an operation. (Contributed by Thierry Arnoux, 4-Jun-2017.)
theorem ofoprabco {x3 y1 a: setvar} (ph: wff) (A2 B2 C R F G: class) (M: class x3 y1 a) (N: class x3 y1) (V: class x3 y1 a):
  $ wnfc a M $ >
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wf A2 C G) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wceq M (cmpt a A2 (cop (cfv (cv a) F) (cfv (cv a) G)))) $ >
  $ wi ph (wceq N (cmpo x3 y1 B2 C (co (cv x3) (cv y1) R))) $ >
  $ wi ph (wceq (co F G (cof R)) (ccom N M)) $;

--| Express the preimage of a function operation as a union of preimages. (Contributed by Thierry Arnoux, 8-Mar-2018.)
theorem ofpreima {p: setvar} (ph: wff) (A2: class) (B2 C: class p) (D R F G: class) (V: class p):
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wf A2 C G) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wfn R (cxp B2 C)) $ >
  $ wi ph (wceq (cima (ccnv (co F G (cof R))) D) (ciun p (cima (ccnv R) D) (cin (cima (ccnv F) (csn (cfv (cv p) c1st))) (cima (ccnv G) (csn (cfv (cv p) c2nd)))))) $;

--| Express the preimage of a function operation as a union of preimages. This version of ~ ofpreima iterates the union over a smaller set. (Contributed by Thierry Arnoux, 8-Mar-2018.)
theorem ofpreima2 {p: setvar} (ph: wff) (A2: class) (B2 C: class p) (D R F G: class) (V: class p):
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wf A2 C G) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wfn R (cxp B2 C)) $ >
  $ wi ph (wceq (cima (ccnv (co F G (cof R))) D) (ciun p (cin (cima (ccnv R) D) (cxp (crn F) (crn G))) (cin (cima (ccnv F) (csn (cfv (cv p) c1st))) (cima (ccnv G) (csn (cfv (cv p) c2nd)))))) $;

--| Two ways to say that a function in maps-to notation is single-rooted. (Contributed by Thierry Arnoux, 1-Mar-2017.)
theorem funcnv5mpt {x3 z: setvar} (ph: wff x3) (A2 B2: class x3) (C: class z) (F V: class x3 z):
  $ wnf x3 ph $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 F $ >
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi (wceq (cv x3) (cv z)) (wceq B2 C) $ >
  $ wi ph (wb (wfun (ccnv F)) (wral x3 (wral z (wo (wceq (cv x3) (cv z)) (wne B2 C)) A2) A2)) $;

--| Two ways to say that a function in maps-to notation is single-rooted. (Contributed by Thierry Arnoux, 2-Mar-2017.)
theorem funcnv4mpt {x3 i j: setvar} (ph: wff x3) (A2 B2: class x3) (F: class x3 j) (V: class i j):
  $ wnf x3 ph $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 F $ >
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi ph (wb (wfun (ccnv F)) (wral i (wral j (wo (wceq (cv i) (cv j)) (wne (csb x3 (cv i) B2) (csb x3 (cv j) B2))) A2) A2)) $;

--| Different elements have different preimages. (Contributed by Thierry Arnoux, 7-May-2023.)
theorem preimane (ph: wff) (F X Y: class):
  $ wi ph (wfun F) $ >
  $ wi ph (wne X Y) $ >
  $ wi ph (wcel X (crn F)) $ >
  $ wi ph (wcel Y (crn F)) $ >
  $ wi ph (wne (cima (ccnv F) (csn X)) (cima (ccnv F) (csn Y))) $;

--| Choose a set ` x ` containing a preimage of each element of a given set ` B ` . (Contributed by Thierry Arnoux, 7-May-2023.)
theorem fnpreimac {x3: setvar} (A2 B2 F: class) (V: class x3):
  $ wi (w3a (wcel A2 V) (wfn F A2) (wss B2 (crn F))) (wrex x3 (wa (wbr (cv x3) B2 cen) (wceq (cima F (cv x3)) B2)) (cpw A2)) $;

--| Exactly one point of a function's graph has a given first element. (Contributed by Thierry Arnoux, 1-Apr-2018.)
theorem fgreu {p: setvar} (F X: class):
  $ wi (wa (wfun F) (wcel X (cdm F))) (wreu p (wceq X (cfv (cv p) c1st)) F) $;

--| If the converse of a relation ` A ` is a function, exactly one point of its graph has a given second element (that is, function value). (Contributed by Thierry Arnoux, 1-Apr-2018.)
theorem fcnvgreu {p: setvar} (A2 Y: class):
  $ wi (wa (wa (wrel A2) (wfun (ccnv A2))) (wcel Y (crn A2))) (wreu p (wceq Y (cfv (cv p) c2nd)) A2) $;

--| The range of an operation given by the maps-to notation as a subset. (Contributed by Thierry Arnoux, 23-May-2017.)
theorem rnmposs {x3 y1: setvar} (A2: class x3) (B2 C: class x3 y1) (D: class) (F: class x3 y1):
  $ wceq F (cmpo x3 y1 A2 B2 C) $ >
  $ wi (wral x3 (wral y1 (wcel C D) B2) A2) (wss (crn F) D) $;

--| Deduce subset relation of mapping-to function graphs from a subset relation of domains. Alternative proof of ~ mptss . (Contributed by Thierry Arnoux, 30-May-2020.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem mptssALT {x3: setvar} (A2 B2: class) (C: class x3):
  $ wi (wss A2 B2) (wss (cmpt x3 A2 C) (cmpt x3 B2 C)) $;

--| Alternative definition of the converse of a relation. (Contributed by Thierry Arnoux, 31-Mar-2018.)
theorem dfcnv2 {x3: setvar} (A2 R: class):
  $ wi (wss (crn R) A2) (wceq (ccnv R) (ciun x3 A2 (cxp (csn (cv x3)) (cima (ccnv R) (csn (cv x3)))))) $;

--| Rewrite a function defined by parts, using a mapping and an if construct, into a union of functions on disjoint domains. See also ~ partfun and ~ ifmpt2v . (Contributed by Thierry Arnoux, 25-Jan-2026.)
theorem partfun2 {x3: setvar} (ph: wff x3) (A2: class) (B2 C D: class x3):
  $ wceq D (crab x3 ph A2) $ >
  $ wceq (cmpt x3 A2 (cif ph B2 C)) (cun (cmpt x3 D B2) (cmpt x3 (cdif A2 D) C)) $;

--| The range of a restriction to a singleton is a singleton. See ~ dmressnsn . (Contributed by Thierry Arnoux, 25-Jan-2026.)
theorem rnressnsn (A2 F: class):
  $ wi (wa (wfun F) (wcel A2 (cdm F))) (wceq (crn (cres F (csn A2))) (csn (cfv A2 F))) $;

--| Express a two-argument function as a one-argument function, or vice-versa. In this version ` B ( x ) ` is not assumed to be constant w.r.t ` x ` . (Contributed by Mario Carneiro, 29-Dec-2014.) (Revised by Thierry Arnoux, 31-Mar-2018.)
theorem mpomptxf {x3 y1 z: setvar} (A2: class) (B2: class x3) (C: class x3 y1 z) (D: class x3 y1):
  $ wnfc x3 C $ >
  $ wnfc y1 C $ >
  $ wi (wceq (cv z) (cop (cv x3) (cv y1))) (wceq C D) $ >
  $ wceq (cmpt z (ciun x3 A2 (cxp (csn (cv x3)) B2)) C) (cmpo x3 y1 A2 B2 D) $;

--| Function operation with the empty function. (Contributed by Thierry Arnoux, 27-May-2025.)
theorem of0r (R F: class):
  $ wceq (co F c0 (cof R)) c0 $;

--| A bound for the support of an operation. (Contributed by Thierry Arnoux, 19-Jul-2023.)
theorem suppovss {x3 y1 k: setvar} (ph: wff) (A2 B2: class) (C: class x3 y1 k) (D F: class k) (G: class) (V W: class x3 y1 k) (Z: class):
  $ wceq F (cmpo x3 y1 A2 B2 C) $ >
  $ wceq G (cmpt x3 A2 (cmpt y1 B2 C)) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel Z D) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv y1) B2))) (wcel C D) $ >
  $ wi ph (wss (co F Z csupp) (cxp (co G (cxp B2 (csn Z)) csupp) (ciun k (co G (cxp B2 (csn Z)) csupp) (co (cfv (cv k) G) Z csupp)))) $;

--| Deduce membership in the support of a function. (Contributed by Thierry Arnoux, 5-Oct-2025.)
theorem elsuppfnd (ph: wff) (A2 F V W X Z: class):
  $ wi ph (wfn F A2) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel Z W) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wne (cfv X F) Z) $ >
  $ wi ph (wcel X (co F Z csupp)) $;

--| Formula building theorem for finite support: operator with left annihilator. (Contributed by Thierry Arnoux, 5-Oct-2025.)
theorem fisuppov1 {x3 y1: setvar} (ph: wff) (A2: class y1) (B2: class x3) (D: class y1) (E: class x3 y1) (F: class y1) (O: class x3) (V W X: class x3 y1) (Y: class x3) (c_0 Z: class):
  $ wi ph (wcel Z V) $ >
  $ wi ph (wcel c_0 X) $ >
  $ wi ph (wcel A2 W) $ >
  $ wi ph (wss D A2) $ >
  $ wi (wa ph (wcel (cv x3) D)) (wcel B2 Y) $ >
  $ wi ph (wf A2 E F) $ >
  $ wi ph (wbr F c_0 cfsupp) $ >
  $ wi (wa ph (wcel (cv y1) Y)) (wceq (co c_0 (cv y1) O) Z) $ >
  $ wi ph (wbr (cmpt x3 D (co (cfv (cv x3) F) B2 O)) Z cfsupp) $;

--| The support of a union is the union of the supports. (Contributed by Thierry Arnoux, 5-Oct-2025.)
theorem suppun2 (ph: wff) (F G V W X Z: class):
  $ wi ph (wcel F V) $ >
  $ wi ph (wcel G W) $ >
  $ wi ph (wcel Z X) $ >
  $ wi ph (wceq (co (cun F G) Z csupp) (cun (co F Z csupp) (co G Z csupp))) $;

--| Express the support of a function ` F ` outside of ` B ` in two different ways. (Contributed by Thierry Arnoux, 5-Oct-2025.)
theorem fdifsupp (ph: wff) (A2 B2 F V W Z: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel Z W) $ >
  $ wi ph (wfn F A2) $ >
  $ wi ph (wceq (co (cres F (cdif A2 B2)) Z csupp) (cdif (co F Z csupp) B2)) $;

--| Relation between the support ` ( F supp Z ) ` and the initial segment ` ( ``' F " { Z } ) ` . (Contributed by Thierry Arnoux, 25-Jun-2024.)
theorem suppiniseg (F V W Z: class):
  $ wi (w3a (wfun F) (wcel F V) (wcel Z W)) (wceq (cdif (cdm F) (co F Z csupp)) (cima (ccnv F) (csn Z))) $;

--| The initial segment ` ( ``' F " { Y } ) ` of a nonzero ` Y ` is finite if ` F ` has finite support. (Contributed by Thierry Arnoux, 21-Jun-2024.)
theorem fsuppinisegfi (ph: wff) (F V W Y c_0: class):
  $ wi ph (wcel F V) $ >
  $ wi ph (wcel c_0 W) $ >
  $ wi ph (wcel Y (cdif cvv (csn c_0))) $ >
  $ wi ph (wbr F c_0 cfsupp) $ >
  $ wi ph (wcel (cima (ccnv F) (csn Y)) cfn) $;

--| The restriction of a function to its support. (Contributed by Thierry Arnoux, 25-Jun-2024.)
theorem fressupp (F V W Z: class):
  $ wi (w3a (wfun F) (wcel F V) (wcel Z W)) (wceq (cres F (co F Z csupp)) (cdif F (cxp cvv (csn Z)))) $;

--| A function is a zero constant outside of its support. (Contributed by Thierry Arnoux, 22-Jun-2024.)
theorem fdifsuppconst (A2 F V W Z: class):
  $ wceq A2 (cdif (cdm F) (co F Z csupp)) $ >
  $ wi (w3a (wfun F) (wcel F V) (wcel Z W)) (wceq (cres F A2) (cxp A2 (csn Z))) $;

--| The range of a function restricted to its support. (Contributed by Thierry Arnoux, 25-Jun-2024.)
theorem ressupprn (F V W c_0: class):
  $ wi (w3a (wfun F) (wcel F V) (wcel c_0 W)) (wceq (crn (cres F (co F c_0 csupp))) (cdif (crn F) (csn c_0))) $;

--| Express the support of a function as the preimage of its range except zero. (Contributed by Thierry Arnoux, 24-Jun-2024.)
theorem supppreima (F V W Z: class):
  $ wi (w3a (wfun F) (wcel F V) (wcel Z W)) (wceq (co F Z csupp) (cima (ccnv F) (cdif (crn F) (csn Z)))) $;

--| Finite support implies finite range. (Contributed by Thierry Arnoux, 24-Jun-2024.)
theorem fsupprnfi (F V W c_0: class):
  $ wi (wa (wa (wfun F) (wcel F V)) (wa (wcel c_0 W) (wbr F c_0 cfsupp))) (wcel (crn F) cfn) $;

--| Conditions for a mapping function defined with a conditional to have finite support. (Contributed by Thierry Arnoux, 20-Feb-2025.)
theorem mptiffisupp {x3: setvar} (ph: wff) (A2 B2: class) (C U F: class x3) (V: class) (W: class x3) (Z: class):
  $ wceq F (cmpt x3 A2 (cif (wcel (cv x3) B2) C Z)) $ >
  $ wi ph (wcel A2 U) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wcel C V) $ >
  $ wi ph (wcel Z W) $ >
  $ wi ph (wbr F Z cfsupp) $;

--| Composition of two ordered pair singletons with non-matching domain and range. (Contributed by Thierry Arnoux, 24-Sep-2023.)
theorem cosnopne (ph: wff) (A2 B2 C D W X: class):
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel C X) $ >
  $ wi ph (wne A2 D) $ >
  $ wi ph (wceq (ccom (csn (cop A2 B2)) (csn (cop C D))) c0) $;

--| Composition of two ordered pair singletons with matching domain and range. (Contributed by Thierry Arnoux, 24-Sep-2023.)
theorem cosnop (ph: wff) (A2 B2 C V W X: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel C X) $ >
  $ wi ph (wceq (ccom (csn (cop A2 B2)) (csn (cop C A2))) (csn (cop C B2))) $;

--| Converse of a pair of ordered pairs. (Contributed by Thierry Arnoux, 24-Sep-2023.)
theorem cnvprop (A2 B2 C D V W: class):
  $ wi (wa (wa (wcel A2 V) (wcel B2 W)) (wa (wcel C V) (wcel D W))) (wceq (ccnv (cpr (cop A2 B2) (cop C D))) (cpr (cop B2 A2) (cop D C))) $;

--| Binary relation for a pair of ordered pairs. (Contributed by Thierry Arnoux, 24-Sep-2023.)
theorem brprop (ph: wff) (A2 B2 C D V W X Y: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wcel D W) $ >
  $ wi ph (wb (wbr X Y (cpr (cop A2 B2) (cop C D))) (wo (wa (wceq X A2) (wceq Y B2)) (wa (wceq X C) (wceq Y D)))) $;

--| Rewrite pairs of ordered pairs as mapping to functions. (Contributed by Thierry Arnoux, 24-Sep-2023.)
theorem mptprop {x3: setvar} (ph: wff) (A2 B2 C D: class) (V W: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wcel D W) $ >
  $ wi ph (wne A2 C) $ >
  $ wi ph (wceq (cpr (cop A2 B2) (cop C D)) (cmpt x3 (cpr A2 C) (cif (wceq (cv x3) A2) B2 D))) $;

--| Composition of two pairs of ordered pairs with matching domain and range. (Contributed by Thierry Arnoux, 24-Sep-2023.)
theorem coprprop (ph: wff) (A2 B2 C D E F V W X: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wcel D W) $ >
  $ wi ph (wne A2 C) $ >
  $ wi ph (wcel E X) $ >
  $ wi ph (wcel F X) $ >
  $ wi ph (wne E F) $ >
  $ wi ph (wceq (ccom (cpr (cop A2 B2) (cop C D)) (cpr (cop E A2) (cop F C))) (cpr (cop E B2) (cop F D))) $;

--| Two ways to express a function with a value replaced. (Contributed by Thierry Arnoux, 5-Oct-2025.)
theorem fmptunsnop {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (F X Y: class):
  $ wi ph (wfn F A2) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (cmpt x3 A2 (cif (wceq (cv x3) X) Y (cfv (cv x3) F))) (cun (cres F (cdif A2 (csn X))) (csn (cop X Y)))) $;

--| Two ways to write a strictly decreasing function on the reals. (Contributed by Thierry Arnoux, 6-Apr-2017.)
theorem gtiso (A2 B2 F: class):
  $ wi (wa (wss A2 cxr) (wss B2 cxr)) (wb (wiso A2 B2 clt (ccnv clt) F) (wiso A2 B2 cle (ccnv cle) F)) $;

--| Infer an isomorphism from a union of two isomorphisms. (Contributed by Thierry Arnoux, 30-Mar-2017.)
theorem isoun {x3 y1 z w: setvar} (ph: wff) (A2: class z w) (B2: class) (C: class z w) (D: class) (R: class z w) (S G H: class):
  $ wi ph (wiso A2 B2 R S H) $ >
  $ wi ph (wiso C D R S G) $ >
  $ wi (w3a ph (wcel (cv x3) A2) (wcel (cv y1) C)) (wbr (cv x3) (cv y1) R) $ >
  $ wi (w3a ph (wcel (cv z) B2) (wcel (cv w) D)) (wbr (cv z) (cv w) S) $ >
  $ wi (w3a ph (wcel (cv x3) C) (wcel (cv y1) A2)) (wn (wbr (cv x3) (cv y1) R)) $ >
  $ wi (w3a ph (wcel (cv z) D) (wcel (cv w) B2)) (wn (wbr (cv z) (cv w) S)) $ >
  $ wi ph (wceq (cin A2 C) c0) $ >
  $ wi ph (wceq (cin B2 D) c0) $ >
  $ wi ph (wiso (cun A2 C) (cun B2 D) R S (cun H G)) $;

--| A disjoint collection is distinct, i.e. each set in this collection is different of all others, provided that it does not contain the empty set This can be expressed as "the converse of the mapping function is a function", or "the mapping function is single-rooted". (Cf. ~ funcnv ) (Contributed by Thierry Arnoux, 28-Feb-2017.)
theorem disjdsct {x3: setvar} (ph: wff x3) (A2 B2: class x3) (V: class):
  $ wnf x3 ph $ >
  $ wnfc x3 A2 $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 (cdif V (csn c0))) $ >
  $ wi ph (wdisj x3 A2 B2) $ >
  $ wi ph (wfun (ccnv (cmpt x3 A2 B2))) $;

--| Definition for a restriction of the ` 1st ` (first member of an ordered pair) function. (Contributed by Thierry Arnoux, 27-Sep-2017.)
theorem df1stres {x3 y1: setvar} (A2 B2: class):
  $ wceq (cres c1st (cxp A2 B2)) (cmpo x3 y1 A2 B2 (cv x3)) $;

--| Definition for a restriction of the ` 2nd ` (second member of an ordered pair) function. (Contributed by Thierry Arnoux, 27-Sep-2017.)
theorem df2ndres {x3 y1: setvar} (A2 B2: class):
  $ wceq (cres c2nd (cxp A2 B2)) (cmpo x3 y1 A2 B2 (cv y1)) $;

--| The preimage of a singleton. (Contributed by Thierry Arnoux, 27-Apr-2020.)
theorem _1stpreimas (A2 V X: class):
  $ wi (wa (wrel A2) (wcel X V)) (wceq (cima (ccnv (cres c1st A2)) (csn X)) (cxp (csn X) (cima A2 (csn X)))) $;

--| The preimage by ` 1st ` is a 'vertical band'. (Contributed by Thierry Arnoux, 13-Oct-2017.)
theorem _1stpreima (A2 B2 C: class):
  $ wi (wss A2 B2) (wceq (cima (ccnv (cres c1st (cxp B2 C))) A2) (cxp A2 C)) $;

--| The preimage by ` 2nd ` is an 'horizontal band'. (Contributed by Thierry Arnoux, 13-Oct-2017.)
theorem _2ndpreima (A2 B2 C: class):
  $ wi (wss A2 C) (wceq (cima (ccnv (cres c2nd (cxp B2 C))) A2) (cxp B2 A2)) $;

--| The image of a curried function with a constant second argument. (Contributed by Thierry Arnoux, 25-Sep-2017.)
theorem curry2ima {x3 y1: setvar} (A2 B2 C D F G: class):
  $ wceq G (ccom F (ccnv (cres c1st (cxp cvv (csn C))))) $ >
  $ wi (w3a (wfn F (cxp A2 B2)) (wcel C B2) (wss D A2)) (wceq (cima G D) (cab y1 (wrex x3 (wceq (cv y1) (co (cv x3) C F)) D))) $;

--| The preimage of a nonempty set is nonempty. (Contributed by Thierry Arnoux, 9-Jun-2024.)
theorem preiman0 (A2 F: class):
  $ wi (w3a (wfun F) (wss A2 (crn F)) (wne A2 c0)) (wne (cima (ccnv F) A2) c0) $;

--| The intersection of an image set, as an indexed intersection of function values. (Contributed by Thierry Arnoux, 15-Jun-2024.)
theorem intimafv {x3: setvar} (A2 F: class):
  $ wi (wa (wfun F) (wss A2 (cdm F))) (wceq (cint (cima F A2)) (ciin x3 A2 (cfv (cv x3) F))) $;

--| A singleton is countable. (Contributed by Thierry Arnoux, 16-Sep-2016.)
theorem snct (A2 V: class):
  $ wi (wcel A2 V) (wbr (csn A2) com cdom) $;

--| An unordered pair is countable. (Contributed by Thierry Arnoux, 16-Sep-2016.)
theorem prct (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wbr (cpr A2 B2) com cdom) $;

--| An operation is countable if both its domains are countable. (Contributed by Thierry Arnoux, 17-Sep-2017.)
theorem mpocti {x3 y1: setvar} (A2 B2: class) (C V: class x3 y1):
  $ wral x3 (wral y1 (wcel C V) B2) A2 $ >
  $ wi (wa (wbr A2 com cdom) (wbr B2 com cdom)) (wbr (cmpo x3 y1 A2 B2 C) com cdom) $;

--| A countable mapping set is countable, using bound-variable hypotheses instead of distinct variable conditions. (Contributed by Thierry Arnoux, 8-Mar-2017.)
theorem mptctf {x3: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wi (wbr A2 com cdom) (wbr (cmpt x3 A2 B2) com cdom) $;

--| An image set of a countable set is countable, using bound-variable hypotheses instead of distinct variable conditions. (Contributed by Thierry Arnoux, 8-Mar-2017.)
theorem abrexctf {x3 y1: setvar} (A2 B2: class x3):
  $ wnfc x3 A2 $ >
  $ wi (wbr A2 com cdom) (wbr (cab y1 (wrex x3 (wceq (cv y1) B2) A2)) com cdom) $;

--| Index a countable set with integers and pad with ` Z ` . (Contributed by Thierry Arnoux, 1-Jun-2020.) Avoid ~ ax-rep . (Revised by GG, 2-Apr-2026.)
theorem padct {f2: setvar} (A2 V Z: class):
  $ wi (w3a (wbr A2 com cdom) (wcel Z V) (wn (wcel Z A2))) (wex f2 (w3a (wf cn (cun A2 (csn Z)) (cv f2)) (wss A2 (crn (cv f2))) (wfun (cres (ccnv (cv f2)) A2)))) $;

--| Composing functions with a bijection yields a bijection between sets of functions. (Contributed by Thierry Arnoux, 25-Aug-2017.)
theorem fcobij {f2: setvar} (ph: wff) (R S T: class) (U: class f2) (G: class) (V W: class f2):
  $ wi ph (wf1o S T G) $ >
  $ wi ph (wcel R U) $ >
  $ wi ph (wcel S V) $ >
  $ wi ph (wcel T W) $ >
  $ wi ph (wf1o (co S R cmap) (co T R cmap) (cmpt f2 (co S R cmap) (ccom G (cv f2)))) $;

--| Composing finitely supported functions with a bijection yields a bijection between sets of finitely supported functions. See also ~ mapfien . (Contributed by Thierry Arnoux, 25-Aug-2017.) (Revised by Thierry Arnoux, 1-Sep-2019.)
theorem fcobijfs {f2 g2 h: setvar} (ph: wff g2) (Q: class g2) (R S: class) (T: class g2) (U: class f2 g2 h) (G: class g2) (O: class) (V W: class f2 g2 h) (X Y: class g2 h):
  $ wi ph (wf1o S T G) $ >
  $ wi ph (wcel R U) $ >
  $ wi ph (wcel S V) $ >
  $ wi ph (wcel T W) $ >
  $ wi ph (wcel O S) $ >
  $ wceq Q (cfv O G) $ >
  $ wceq X (crab g2 (wbr (cv g2) O cfsupp) (co S R cmap)) $ >
  $ wceq Y (crab h (wbr (cv h) Q cfsupp) (co T R cmap)) $ >
  $ wi ph (wf1o X Y (cmpt f2 X (ccom G (cv f2)))) $;

--| Composing finitely supported functions with a bijection yields a bijection between sets of finitely supported functions. See also ~ mapfien . (Contributed by Thierry Arnoux, 25-Aug-2017.) (Revised by Thierry Arnoux, 1-Sep-2019.)
theorem fcobijfs_b {f2 h: setvar} (ph: wff) (Q R S T: class) (U: class f2 h) (G O: class) (V W: class f2 h) (X Y: class h):
  $ wi ph (wf1o S T G) $ >
  $ wi ph (wcel R U) $ >
  $ wi ph (wcel S V) $ >
  $ wi ph (wcel T W) $ >
  $ wi ph (wcel O S) $ >
  $ wceq Q (cfv O G) $ >
  $ wceq X (crab f2 (wbr (cv f2) O cfsupp) (co S R cmap)) $ >
  $ wceq Y (crab h (wbr (cv h) Q cfsupp) (co T R cmap)) $ >
  $ wi ph (wf1o X Y (cmpt f2 X (ccom G (cv f2)))) $;

--| Composing finitely supported functions with a bijection yields a bijection between sets of finitely supported functions. See also ~ fcobijfs and ~ mapfien . (Contributed by Thierry Arnoux, 10-Jan-2026.)
theorem fcobijfs2 {f2 g2 h: setvar} (ph: wff g2) (R S T: class) (U: class f2 g2 h) (G: class g2) (O: class) (V W: class f2 g2 h) (X Y: class g2 h):
  $ wi ph (wf1o R S G) $ >
  $ wi ph (wcel R U) $ >
  $ wi ph (wcel S V) $ >
  $ wi ph (wcel T W) $ >
  $ wi ph (wcel O T) $ >
  $ wceq X (crab g2 (wbr (cv g2) O cfsupp) (co T S cmap)) $ >
  $ wceq Y (crab h (wbr (cv h) O cfsupp) (co T R cmap)) $ >
  $ wi ph (wf1o X Y (cmpt f2 X (ccom (cv f2) G))) $;

--| Deduce a function's support's inclusion in another function's support. (Contributed by Thierry Arnoux, 7-Sep-2017.) (Revised by Thierry Arnoux, 1-Sep-2019.)
theorem suppss3 {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (F: class) (G V W: class x3) (Z: class):
  $ wceq G (cmpt x3 A2 B2) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel Z W) $ >
  $ wi ph (wfn F A2) $ >
  $ wi (w3a ph (wcel (cv x3) A2) (wceq (cfv (cv x3) F) Z)) (wceq B2 Z) $ >
  $ wi ph (wss (co G Z csupp) (co F Z csupp)) $;

--| Finite support of a curried function with a constant first argument. (Contributed by Thierry Arnoux, 7-Jul-2023.)
theorem fsuppcurry1 {x3: setvar} (ph: wff x3) (A2: class x3) (B2 C: class) (U: class x3) (F: class) (G V W Z: class x3):
  $ wceq G (cmpt x3 B2 (co C (cv x3) F)) $ >
  $ wi ph (wcel Z U) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wfn F (cxp A2 B2)) $ >
  $ wi ph (wcel C A2) $ >
  $ wi ph (wbr F Z cfsupp) $ >
  $ wi ph (wbr G Z cfsupp) $;

--| Finite support of a curried function with a constant second argument. (Contributed by Thierry Arnoux, 7-Jul-2023.)
theorem fsuppcurry2 {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3) (C: class) (U: class x3) (F: class) (G V W Z: class x3):
  $ wceq G (cmpt x3 A2 (co (cv x3) C F)) $ >
  $ wi ph (wcel Z U) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wfn F (cxp A2 B2)) $ >
  $ wi ph (wcel C B2) $ >
  $ wi ph (wbr F Z cfsupp) $ >
  $ wi ph (wbr G Z cfsupp) $;

--| Finite support for a function operation. (Contributed by Thierry Arnoux, 8-Jul-2023.)
theorem offinsupp1 {x3: setvar} (ph: wff) (A2: class x3) (R: class) (S: class x3) (T: class) (U F: class x3) (G: class) (V W: class x3) (Y Z: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel Y U) $ >
  $ wi ph (wcel Z W) $ >
  $ wi ph (wf A2 S F) $ >
  $ wi ph (wf A2 T G) $ >
  $ wi ph (wbr F Y cfsupp) $ >
  $ wi (wa ph (wcel (cv x3) T)) (wceq (co Y (cv x3) R) Z) $ >
  $ wi ph (wbr (co F G (cof R)) Z cfsupp) $;

--| Rewrite a function's support based with its codomain rather than the universal class. See also ~ fsuppeq . (Contributed by Thierry Arnoux, 27-Aug-2017.) (Revised by Thierry Arnoux, 1-Sep-2019.)
theorem ffs2 (A2 B2 C F V W Z: class):
  $ wceq C (cdif B2 (csn Z)) $ >
  $ wi (w3a (wcel A2 V) (wcel Z W) (wf A2 B2 F)) (wceq (co F Z csupp) (cima (ccnv F) C)) $;

--| The range of a finitely supported function is finite. The proof uses ~ fnrndomnum rather than ~ fnrndomg , and so does not require ~ ax-ac . (Contributed by Thierry Arnoux, 27-Aug-2017.) (Revised by Vincent Gonzalez, 24-Aug-2026.)
theorem ffsrn (ph: wff) (F V W Z: class):
  $ wi ph (wcel Z W) $ >
  $ wi ph (wcel F V) $ >
  $ wi ph (wfun F) $ >
  $ wi ph (wcel (co F Z csupp) cfn) $ >
  $ wi ph (wcel (crn F) cfn) $;

--| Composing with the inverse of a bijection. (Contributed by Thierry Arnoux, 15-Jan-2026.)
theorem cocnvf1o (ph: wff) (A2 B2 F G H: class):
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wf A2 B2 G) $ >
  $ wi ph (wf1o A2 A2 H) $ >
  $ wi ph (wb (wceq F (ccom G H)) (wceq G (ccom F (ccnv H)))) $;

--| Restriction of functions to a superset of their support creates a bijection. (Contributed by Thierry Arnoux, 12-Sep-2017.)
theorem resf1o {f2: setvar} (A2 B2 C: class) (F: class f2) (V W X Z: class):
  $ wceq X (crab f2 (wss (cima (ccnv (cv f2)) (cdif B2 (csn Z))) C) (co B2 A2 cmap)) $ >
  $ wceq F (cmpt f2 X (cres (cv f2) C)) $ >
  $ wi (wa (w3a (wcel A2 V) (wcel B2 W) (wss C A2)) (wcel Z B2)) (wf1o X (co B2 C cmap) F) $;

--| Restricting the range of the mapping operator. (Contributed by Thierry Arnoux, 30-Aug-2017.)
theorem maprnin {f2: setvar} (A2 B2 C: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq (co (cin B2 C) A2 cmap) (crab f2 (wss (crn (cv f2)) C) (co B2 A2 cmap)) $;

--| Lemma for ~ fpwrelmapffs . For this theorem, the sets ` A ` and ` B ` could be infinite, but the relation ` R ` itself is finite. (Contributed by Thierry Arnoux, 1-Sep-2017.) (Revised by Thierry Arnoux, 1-Sep-2019.)
theorem fpwrelmapffslem {x3 y1: setvar} (ph: wff x3 y1) (A2: class) (B2: class x3 y1) (R F: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi ph (wf A2 (cpw B2) F) $ >
  $ wi ph (wceq R (copab x3 y1 (wa (wcel (cv x3) A2) (wcel (cv y1) (cfv (cv x3) F))))) $ >
  $ wi ph (wb (wcel R cfn) (wa (wss (crn F) cfn) (wcel (co F c0 csupp) cfn))) $;

--| Define a canonical mapping between functions from ` A ` into subsets of ` B ` and the relations with domain ` A ` and range within ` B ` . Note that the same relation is used in ~ axdc2lem and ~ marypha2lem1 . (Contributed by Thierry Arnoux, 28-Aug-2017.)
theorem fpwrelmap {x3 y1 f2: setvar} (A2 B2: class) (M: class x3 y1 f2):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq M (cmpt f2 (co (cpw B2) A2 cmap) (copab x3 y1 (wa (wcel (cv x3) A2) (wcel (cv y1) (cfv (cv x3) (cv f2)))))) $ >
  $ wf1o (co (cpw B2) A2 cmap) (cpw (cxp A2 B2)) M $;

--| Define a canonical mapping between finite relations (finite subsets of a cartesian product) and functions with finite support into finite subsets. (Contributed by Thierry Arnoux, 28-Aug-2017.) (Revised by Thierry Arnoux, 1-Sep-2019.)
theorem fpwrelmapffs {x3 y1 f2: setvar} (A2 B2: class) (S M: class x3 y1 f2):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wceq M (cmpt f2 (co (cpw B2) A2 cmap) (copab x3 y1 (wa (wcel (cv x3) A2) (wcel (cv y1) (cfv (cv x3) (cv f2)))))) $ >
  $ wceq S (crab f2 (wcel (co (cv f2) c0 csupp) cfn) (co (cin (cpw B2) cfn) A2 cmap)) $ >
  $ wf1o S (cin (cpw (cxp A2 B2)) cfn) (cres M S) $;

--| Value of the signum of a real number, expresssed using absolute value. (Contributed by Thierry Arnoux, 9-Nov-2025.)
theorem sgnval2 (A2: class):
  $ wi (wa (wcel A2 cr) (wne A2 cc0)) (wceq (cfv A2 csgn) (co A2 (cfv A2 cabs) cdiv)) $;

--| The real representation of complex numbers is zero iff both its terms are zero. Cf. ~ crne0 . (Contributed by Thierry Arnoux, 20-Aug-2023.)
theorem creq0 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wb (wa (wceq A2 cc0) (wceq B2 cc0)) (wceq (co A2 (co ci B2 cmul) caddc) cc0)) $;

--| The imaginary unit ` _i ` is not one. (Contributed by Thierry Arnoux, 20-Aug-2023.)
theorem _1nei:
  $ wne c1 ci $;

--| An integer unit times itself. (Contributed by Thierry Arnoux, 23-Aug-2020.)
theorem _1neg1t1neg1 (N: class):
  $ wi (wcel N (cpr (cneg c1) c1)) (wceq (co N N cmul) c1) $;

--| Multiplying by a positive integer ` M ` yields greater than or equal nonnegative integers. (Contributed by Thierry Arnoux, 13-Dec-2021.)
theorem nnmulge (M N: class):
  $ wi (wa (wcel M cn) (wcel N cn0)) (wbr N (co M N cmul) cle) $;

--| The product of a difference and a sum. Cf. ~ addmulsub . (Contributed by Thierry Arnoux, 6-Jul-2025.)
theorem submuladdd (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wcel D cc) $ >
  $ wi ph (wceq (co (co A2 B2 cmin) (co C D caddc) cmul) (co (co (co A2 C cmul) (co A2 D cmul) caddc) (co (co B2 C cmul) (co B2 D cmul) caddc) cmin)) $;

--| The difference of the squares of the sum and difference of two complex numbers ` A ` and ` B ` . (Contributed by Thierry Arnoux, 5-Nov-2025.)
theorem binom2subadd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wceq (co (co (co A2 B2 caddc) c2 cexp) (co (co A2 B2 cmin) c2 cexp) cmin) (co c4 (co A2 B2 cmul) cmul)) $;

--| Complex conjugate distributes over subtraction. (Contributed by Thierry Arnoux, 1-Jul-2025.)
theorem cjsubd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wceq (cfv (co A2 B2 cmin) ccj) (co (cfv A2 ccj) (cfv B2 ccj) cmin)) $;

--| The conjugate of a pure imaginary number is its negative. (Contributed by Thierry Arnoux, 25-Jun-2025.)
theorem re0cj (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (cfv A2 cre) cc0) $ >
  $ wi ph (wceq (cfv A2 ccj) (cneg A2)) $;

--| Real numbers equal to their own reciprocal have absolute value ` 1 ` . (Contributed by Thierry Arnoux, 9-Nov-2025.)
theorem receqid (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wb (wceq (co c1 A2 cdiv) A2) (wceq (cfv A2 cabs) c1)) $;

--| A simplified version of the Pythagorean theorem, where the points ` A ` and ` B ` respectively lie on the imaginary and real axes, and the right angle is at the origin. (Contributed by Thierry Arnoux, 2-Nov-2025.)
theorem pythagreim (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wceq (co (cfv (co B2 (co ci A2 cmul) cmin) cabs) c2 cexp) (co (co A2 c2 cexp) (co B2 c2 cexp) caddc)) $;

--| The exponential of the "arg" function ` Im o. log ` , deduction version. (Contributed by Thierry Arnoux, 5-Nov-2025.)
theorem efiargd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wceq (cfv (co ci (cfv (cfv A2 clog) cim) cmul) ce) (co A2 (cfv A2 cabs) cdiv)) $;

--| The argument of the inverse of a complex number ` A ` . (Contributed by Thierry Arnoux, 5-Nov-2025.)
theorem arginv (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wn (wcel (cneg A2) crp)) $ >
  $ wi ph (wceq (cfv (cfv (co c1 A2 cdiv) clog) cim) (cneg (cfv (cfv A2 clog) cim))) $;

--| The argument of the conjugate of a complex number ` A ` . (Contributed by Thierry Arnoux, 5-Nov-2025.)
theorem argcj (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wn (wcel (cneg A2) crp)) $ >
  $ wi ph (wceq (cfv (cfv (cfv A2 ccj) clog) cim) (cneg (cfv (cfv A2 clog) cim))) $;

--| Variant of quadratic equation with discriminant expanded. (Contributed by Filip Cernatescu, 19-Oct-2019.) Deduction version. (Revised by Thierry Arnoux, 6-Jul-2025.)
theorem quad3d (ph: wff) (A2 B2 C X: class):
  $ wi ph (wcel X cc) $ >
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wceq (co (co A2 (co X c2 cexp) cmul) (co (co B2 X cmul) C caddc) caddc) cc0) $ >
  $ wi ph (wo (wceq X (co (co (cneg B2) (cfv (co (co B2 c2 cexp) (co c4 (co A2 C cmul) cmul) cmin) csqrt) caddc) (co c2 A2 cmul) cdiv)) (wceq X (co (co (cneg B2) (cfv (co (co B2 c2 cexp) (co c4 (co A2 C cmul) cmul) cmin) csqrt) cmin) (co c2 A2 cmul) cdiv))) $;

--| If the right-hand side of a 'less than' relationship is an addition, then we can express the left-hand side as an addition, too, where each term is respectively less than each term of the original right side. (Contributed by Thierry Arnoux, 15-Mar-2017.)
theorem lt2addrd {b c: setvar} (ph: wff b c) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wbr A2 (co B2 C caddc) clt) $ >
  $ wi ph (wrex b (wrex c (w3a (wceq A2 (co (cv b) (cv c) caddc)) (wbr (cv b) B2 clt) (wbr (cv c) C clt)) cr) cr) $;

--| Nonnegative integers or minus infinity are extended real numbers. (Contributed by Thierry Arnoux, 15-Feb-2026.)
theorem nn0mnfxrd (ph: wff) (A2: class):
  $ wi ph (wcel A2 (cun cn0 (csn cmnf))) $ >
  $ wi ph (wcel A2 cxr) $;

--| Trichotomy law for extended reals. (Contributed by Thierry Arnoux, 12-Sep-2017.)
theorem xrlelttric (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wo (wbr A2 B2 cle) (wbr B2 A2 clt)) $;

--| Two extended reals which add up to zero are each other's negatives. (Contributed by Thierry Arnoux, 13-Jun-2017.)
theorem xaddeq0 (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wb (wceq (co A2 B2 cxad) cc0) (wceq A2 (cxne B2))) $;

--| If the result ` A ` of an extended real multiplication is real, then its first factor ` B ` is also real. See also ~ rexmul . (Contributed by Thierry Arnoux, 26-Oct-2025.)
theorem rexmul2 (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cxr) $ >
  $ wi ph (wcel C cxr) $ >
  $ wi ph (wbr cc0 C clt) $ >
  $ wi ph (wceq A2 (co B2 C cxmu)) $ >
  $ wi ph (wcel B2 cr) $;

--| The extended real numbers are unbounded below. (Contributed by Thierry Arnoux, 18-Feb-2018.) (Revised by AV, 28-Sep-2020.)
theorem xrinfm:
  $ wceq (cinf cxr cxr clt) cmnf $;

--| A sum is less than the whole if each term is less than half. (Contributed by Thierry Arnoux, 29-Nov-2017.)
theorem le2halvesd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wbr A2 (co C c2 cdiv) cle) $ >
  $ wi ph (wbr B2 (co C c2 cdiv) cle) $ >
  $ wi ph (wbr (co A2 B2 caddc) C cle) $;

--| A number is less than or equal to itself plus a nonnegative number. (Contributed by Thierry Arnoux, 28-Dec-2016.)
theorem xraddge02 (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wi (wbr cc0 B2 cle) (wbr A2 (co A2 B2 cxad) cle)) $;

--| A number is less than or equal to itself plus a nonnegative number. (Contributed by Thierry Arnoux, 19-Jul-2020.)
theorem xrge0addge (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 (co cc0 cpnf cicc))) (wbr A2 (co A2 B2 cxad) cle) $;

--| If the right-hand side of a 'less than' relationship is an addition, then we can express the left-hand side as an addition, too, where each term is respectively less than each term of the original right side. (Contributed by Thierry Arnoux, 15-Mar-2017.)
theorem xlt2addrd {b c: setvar} (ph: wff b c) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cxr) $ >
  $ wi ph (wcel C cxr) $ >
  $ wi ph (wne B2 cmnf) $ >
  $ wi ph (wne C cmnf) $ >
  $ wi ph (wbr A2 (co B2 C cxad) clt) $ >
  $ wi ph (wrex b (wrex c (w3a (wceq A2 (co (cv b) (cv c) cxad)) (wbr (cv b) B2 clt) (wbr (cv c) C clt)) cxr) cxr) $;

--| Any subset of nonnegative extended reals has an infimum. (Contributed by Thierry Arnoux, 16-Sep-2019.) (Revised by AV, 4-Oct-2020.)
theorem xrge0infss {x3 y1 z: setvar} (A2: class):
  $ wi (wss A2 (co cc0 cpnf cicc)) (wrex x3 (wa (wral y1 (wn (wbr (cv y1) (cv x3) clt)) A2) (wral y1 (wi (wbr (cv x3) (cv y1) clt) (wrex z (wbr (cv z) (cv y1) clt) A2)) (co cc0 cpnf cicc))) (co cc0 cpnf cicc)) $;

--| Inequality deduction for infimum of a nonnegative extended real subset. (Contributed by Thierry Arnoux, 16-Sep-2019.) (Revised by AV, 4-Oct-2020.)
theorem xrge0infssd (ph: wff) (B2 C: class):
  $ wi ph (wss C B2) $ >
  $ wi ph (wss B2 (co cc0 cpnf cicc)) $ >
  $ wi ph (wbr (cinf B2 (co cc0 cpnf cicc) clt) (cinf C (co cc0 cpnf cicc) clt) cle) $;

--| Nonnegative extended reals are closed under addition. (Contributed by Thierry Arnoux, 16-Sep-2019.)
theorem xrge0addcld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 (co cc0 cpnf cicc)) $ >
  $ wi ph (wcel B2 (co cc0 cpnf cicc)) $ >
  $ wi ph (wcel (co A2 B2 cxad) (co cc0 cpnf cicc)) $;

--| Condition for closure of nonnegative extended reals under subtraction. (Contributed by Thierry Arnoux, 27-May-2020.)
theorem xrge0subcld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 (co cc0 cpnf cicc)) $ >
  $ wi ph (wcel B2 (co cc0 cpnf cicc)) $ >
  $ wi ph (wbr B2 A2 cle) $ >
  $ wi ph (wcel (co A2 (cxne B2) cxad) (co cc0 cpnf cicc)) $;

--| A member of a set of nonnegative extended reals is greater than or equal to the set's infimum. (Contributed by Thierry Arnoux, 19-Jul-2020.) (Revised by AV, 4-Oct-2020.)
theorem infxrge0lb (ph: wff) (A2 B2: class):
  $ wi ph (wss A2 (co cc0 cpnf cicc)) $ >
  $ wi ph (wcel B2 A2) $ >
  $ wi ph (wbr (cinf A2 (co cc0 cpnf cicc) clt) B2 cle) $;

--| The infimum of a set of nonnegative extended reals is the greatest lower bound. (Contributed by Thierry Arnoux, 19-Jul-2020.) (Revised by AV, 4-Oct-2020.)
theorem infxrge0glb {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wi ph (wss A2 (co cc0 cpnf cicc)) $ >
  $ wi ph (wcel B2 (co cc0 cpnf cicc)) $ >
  $ wi ph (wb (wbr (cinf A2 (co cc0 cpnf cicc) clt) B2 clt) (wrex x3 (wbr (cv x3) B2 clt) A2)) $;

--| The infimum of a set of nonnegative extended reals is greater than or equal to a lower bound. (Contributed by Thierry Arnoux, 19-Jul-2020.) (Revised by AV, 4-Oct-2020.)
theorem infxrge0gelb {x3: setvar} (ph: wff) (A2 B2: class):
  $ wi ph (wss A2 (co cc0 cpnf cicc)) $ >
  $ wi ph (wcel B2 (co cc0 cpnf cicc)) $ >
  $ wi ph (wb (wbr B2 (cinf A2 (co cc0 cpnf cicc) clt) cle) (wral x3 (wbr B2 (cv x3) cle) A2)) $;

--| The supremum is preserved by extended addition set operation. (Provided minus infinity is not involved as it does not behave well with addition.) (Contributed by Thierry Arnoux, 20-Mar-2017.)
theorem xrofsup (ph: wff) (X Y Z: class):
  $ wi ph (wss X cxr) $ >
  $ wi ph (wss Y cxr) $ >
  $ wi ph (wne (csup X cxr clt) cmnf) $ >
  $ wi ph (wne (csup Y cxr clt) cmnf) $ >
  $ wi ph (wceq Z (cima cxad (cxp X Y))) $ >
  $ wi ph (wceq (csup Z cxr clt) (co (csup X cxr clt) (csup Y cxr clt) cxad)) $;

--| The supremum of a nonempty set of extended reals which does not contain minus infinity is not minus infinity. (Contributed by Thierry Arnoux, 21-Mar-2017.)
theorem supxrnemnf (A2: class):
  $ wi (w3a (wss A2 cxr) (wne A2 c0) (wn (wcel cmnf A2))) (wne (csup A2 cxr clt) cmnf) $;

--| Nonzero extended nonnegative integers are strictly greater than zero. (Contributed by Thierry Arnoux, 30-Jul-2023.)
theorem xnn0gt0 (N: class):
  $ wi (wa (wcel N cxnn0) (wne N cc0)) (wbr cc0 N clt) $;

--| An extended nonnegative integer is neither 0 nor 1 if and only if it is greater than 1. (Contributed by Thierry Arnoux, 21-Nov-2023.)
theorem xnn01gt (N: class):
  $ wi (wcel N cxnn0) (wb (wn (wcel N (cpr cc0 c1))) (wbr c1 N clt)) $;

--| Finite multiplication in the extended nonnegative integers. (Contributed by Thierry Arnoux, 30-Jul-2023.)
theorem nn0xmulclb (A2 B2: class):
  $ wi (wa (wa (wcel A2 cxnn0) (wcel B2 cxnn0)) (wa (wne A2 cc0) (wne B2 cc0))) (wb (wcel (co A2 B2 cxmu) cn0) (wa (wcel A2 cn0) (wcel B2 cn0))) $;

--| Conditions for an extended nonnegative integer to be a nonnegative integer. (Contributed by Thierry Arnoux, 26-Oct-2025.)
theorem xnn0nn0d (ph: wff) (N: class):
  $ wi ph (wcel N cxnn0) $ >
  $ wi ph (wcel N cr) $ >
  $ wi ph (wcel N cn0) $;

--| Conditions for an extended nonnegative integer to be a positive integer. (Contributed by Thierry Arnoux, 26-Oct-2025.)
theorem xnn0nnd (ph: wff) (N: class):
  $ wi ph (wcel N cxnn0) $ >
  $ wi ph (wcel N cr) $ >
  $ wi ph (wbr cc0 N clt) $ >
  $ wi ph (wcel N cn) $;

--| Disjoint joining an open interval with a closed-below, open-above interval to form a closed-below, open-above interval. (Contributed by Thierry Arnoux, 26-Sep-2017.)
theorem joiniooico (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cxr)) (wa (wbr A2 B2 clt) (wbr B2 C cle))) (wa (wceq (cin (co A2 B2 cioo) (co B2 C cico)) c0) (wceq (cun (co A2 B2 cioo) (co B2 C cico)) (co A2 C cioo))) $;

--| A right-open interval does not contain its right endpoint. (Contributed by Thierry Arnoux, 5-Apr-2017.)
theorem ubico (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cxr)) (wn (wcel B2 (co A2 B2 cico))) $;

--| Equality in terms of 'less than or equal to', 'less than'. (Contributed by Thierry Arnoux, 5-Jul-2017.)
theorem xeqlelt (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wb (wceq A2 B2) (wa (wbr A2 B2 cle) (wn (wbr A2 B2 clt)))) $;

--| Relate elementhood to a closed interval with elementhood to the same closed-below, open-above interval or to its upper bound. (Contributed by Thierry Arnoux, 3-Jul-2017.)
theorem eliccelico (A2 B2 C: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wbr A2 B2 cle)) (wb (wcel C (co A2 B2 cicc)) (wo (wcel C (co A2 B2 cico)) (wceq C B2))) $;

--| Relate elementhood to a closed-below, open-above interval with elementhood to the same open interval or to its lower bound. (Contributed by Thierry Arnoux, 6-Jul-2017.)
theorem elicoelioo (A2 B2 C: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wbr A2 B2 clt)) (wb (wcel C (co A2 B2 cico)) (wo (wceq C A2) (wcel C (co A2 B2 cioo)))) $;

--| Intersection between two open-below, closed-above intervals sharing the same upper bound. (Contributed by Thierry Arnoux, 7-Aug-2017.)
theorem iocinioc2 (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cxr)) (wbr A2 B2 cle)) (wceq (cin (co A2 C cioc) (co B2 C cioc)) (co B2 C cioc)) $;

--| Class difference of a half-open interval in the extended reals. (Contributed by Thierry Arnoux, 1-Aug-2017.)
theorem xrdifh (A2: class):
  $ wcel A2 cxr $ >
  $ wceq (cdif cxr (co A2 cpnf cicc)) (co cmnf A2 cico) $;

--| Relate intersection of two open-below, closed-above intervals with the same upper bound with a conditional construct. (Contributed by Thierry Arnoux, 7-Aug-2017.)
theorem iocinif (A2 B2 C: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cxr)) (wceq (cin (co A2 C cioc) (co B2 C cioc)) (cif (wbr A2 B2 clt) (co B2 C cioc) (co A2 C cioc))) $;

--| The difference between two open intervals sharing the same lower bound. (Contributed by Thierry Arnoux, 26-Sep-2017.)
theorem difioo (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cxr)) (wbr A2 B2 clt)) (wceq (cdif (co A2 C cioo) (co A2 B2 cioo)) (co B2 C cico)) $;

--| The difference between two closed-below, open-above intervals sharing the same upper bound. (Contributed by Thierry Arnoux, 13-Oct-2017.)
theorem difico (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cxr)) (wa (wbr A2 B2 cle) (wbr B2 C cle))) (wceq (cdif (co A2 C cico) (co B2 C cico)) (co A2 B2 cico)) $;

--| Upper integer sets are a subset of the corresponding closed-below, open-above intervals. (Contributed by Thierry Arnoux, 29-Dec-2021.)
theorem uzssico (M: class):
  $ wi (wcel M cz) (wss (cfv M cuz) (co M cpnf cico)) $;

--| A finite set of sequential integers that is a subset of ` NN0 ` . (Contributed by Thierry Arnoux, 8-Dec-2021.)
theorem fz2ssnn0 (M N: class):
  $ wi (wcel M cn0) (wss (co M N cfz) cn0) $;

--| Upper set of the positive integers. (Contributed by Thierry Arnoux, 22-Aug-2017.)
theorem nndiffz1 (N: class):
  $ wi (wcel N cn0) (wceq (cdif cn (co c1 N cfz)) (cfv (co N c1 caddc) cuz)) $;

--| For any finite subset of ` NN ` , find a superset in the form of a set of sequential integers. (Contributed by Thierry Arnoux, 13-Sep-2017.)
theorem ssnnssfz {n: setvar} (A2: class):
  $ wi (wcel A2 (cin (cpw cn) cfn)) (wrex n (wss A2 (co c1 (cv n) cfz)) cn) $;

--| Elementhood of an integer and its predecessor in finite intervals of integers. (Contributed by Thierry Arnoux, 1-Jan-2024.)
theorem fzm1ne1 (K M N: class):
  $ wi (wa (wcel K (co M N cfz)) (wne K M)) (wcel (co K c1 cmin) (co M (co N c1 cmin) cfz)) $;

--| Split the last element of a finite set of sequential integers. More generic than ~ fzsuc . (Contributed by Thierry Arnoux, 7-Nov-2016.)
theorem fzspl (M N: class):
  $ wi (wcel N (cfv M cuz)) (wceq (co M N cfz) (cun (co M (co N c1 cmin) cfz) (csn N))) $;

--| Split the last element of a finite set of sequential integers. More generic than ~ fzsuc . (Contributed by Thierry Arnoux, 22-Aug-2020.)
theorem fzdif2 (M N: class):
  $ wi (wcel N (cfv M cuz)) (wceq (cdif (co M N cfz) (csn N)) (co M (co N c1 cmin) cfz)) $;

--| Split the last element of a half-open range of sequential integers. (Contributed by Thierry Arnoux, 5-Dec-2021.)
theorem fzodif2 (M N: class):
  $ wi (wcel N (cfv M cuz)) (wceq (cdif (co M (co N c1 caddc) cfzo) (csn N)) (co M N cfzo)) $;

--| Set difference of two half-open range of sequential integers sharing the same starting value. (Contributed by Thierry Arnoux, 2-Oct-2023.)
theorem fzodif1 (K M N: class):
  $ wi (wcel K (co M N cfz)) (wceq (cdif (co M N cfzo) (co M K cfzo)) (co K N cfzo)) $;

--| Split a finite interval of integers into two parts. (Contributed by Thierry Arnoux, 2-May-2017.)
theorem fzsplit3 (K M N: class):
  $ wi (wcel K (co M N cfz)) (wceq (co M N cfz) (cun (co M (co K c1 cmin) cfz) (co K N cfz))) $;

--| Upper set of the nonnegative integers. (Contributed by Thierry Arnoux, 25-Jan-2026.)
theorem nn0diffz0 (N: class):
  $ wi (wcel N cn0) (wceq (cdif cn0 (co cc0 N cfz)) (cfv (co N c1 caddc) cuz)) $;

--| The proportion of one binomial coefficient to another with ` N ` decreased by 1. (Contributed by Thierry Arnoux, 9-Nov-2016.)
theorem bcm1n (K N: class):
  $ wi (wa (wcel K (co cc0 (co N c1 cmin) cfz)) (wcel N cn)) (wceq (co (co (co N c1 cmin) K cbc) (co N K cbc) cdiv) (co (co N K cmin) N cdiv)) $;

--| Rewrite a countable union as a disjoint union, finite version. Cf. ~ iundisj . (Contributed by Thierry Arnoux, 15-Feb-2017.)
theorem iundisjfi {k n: setvar} (A2: class n) (B2: class k n) (N: class):
  $ wnfc n B2 $ >
  $ wi (wceq (cv n) (cv k)) (wceq A2 B2) $ >
  $ wceq (ciun n (co c1 N cfzo) A2) (ciun n (co c1 N cfzo) (cdif A2 (ciun k (co c1 (cv n) cfzo) B2))) $;

--| A disjoint union is disjoint, finite version. Cf. ~ iundisj2 . (Contributed by Thierry Arnoux, 16-Feb-2017.)
theorem iundisj2fi {k n: setvar} (A2: class n) (B2: class k n) (N: class):
  $ wnfc n B2 $ >
  $ wi (wceq (cv n) (cv k)) (wceq A2 B2) $ >
  $ wdisj n (co c1 N cfzo) (cdif A2 (ciun k (co c1 (cv n) cfzo) B2)) $;

--| Rewrite a countable union as a disjoint union. (Contributed by Thierry Arnoux, 16-Feb-2017.)
theorem iundisjcnt {k n: setvar} (ph: wff k n) (A2: class n) (B2: class k n) (M N: class):
  $ wnfc n B2 $ >
  $ wi (wceq (cv n) (cv k)) (wceq A2 B2) $ >
  $ wi ph (wo (wceq N cn) (wceq N (co c1 M cfzo))) $ >
  $ wi ph (wceq (ciun n N A2) (ciun n N (cdif A2 (ciun k (co c1 (cv n) cfzo) B2)))) $;

--| A countable disjoint union is disjoint. Cf. ~ iundisj2 . (Contributed by Thierry Arnoux, 16-Feb-2017.)
theorem iundisj2cnt {k n: setvar} (ph: wff k n) (A2: class n) (B2: class k n) (M: class) (N: class k):
  $ wnfc n B2 $ >
  $ wi (wceq (cv n) (cv k)) (wceq A2 B2) $ >
  $ wi ph (wo (wceq N cn) (wceq N (co c1 M cfzo))) $ >
  $ wi ph (wdisj n N (cdif A2 (ciun k (co c1 (cv n) cfzo) B2))) $;

--| Given a countable set ` A ` , number its elements by providing a one-to-one mapping either with ` NN ` or an integer range starting from 1. The domain of the function can then be used with ~ iundisjcnt or ~ iundisj2cnt . (Contributed by Thierry Arnoux, 25-Jul-2020.)
theorem f1ocnt {f2: setvar} (A2: class):
  $ wi (wbr A2 com cdom) (wex f2 (wa (wf1o (cdm (cv f2)) A2 (cv f2)) (wo (wceq (cdm (cv f2)) cn) (wceq (cdm (cv f2)) (co c1 (co (cfv A2 chash) c1 caddc) cfzo))))) $;

--| NN and integer ranges starting from 1 are countable. (Contributed by Thierry Arnoux, 25-Jul-2020.)
theorem fz1nnct (A2 M: class):
  $ wi (wo (wceq A2 cn) (wceq A2 (co c1 M cfzo))) (wbr A2 com cdom) $;

--| NN and integer ranges starting from 1 are a transitive family of set. (Contributed by Thierry Arnoux, 25-Jul-2020.)
theorem fz1nntr (A2 M N: class):
  $ wi (wa (wo (wceq A2 cn) (wceq A2 (co c1 M cfzo))) (wcel N A2)) (wss (co c1 N cfzo) A2) $;

--| Equality for a half open integer range starting at zero is the same as equality of its upper bound, analogous to ~ fzopth and ~ fzoopth . (Contributed by Thierry Arnoux, 27-May-2025.)
theorem fzo0opth (ph: wff) (M N: class):
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wb (wceq (co cc0 M cfzo) (co cc0 N cfzo)) (wceq M N)) $;

--| A nonnegative integer that is not in the half-open range from 0 to ` N ` is at least ` N ` . (Contributed by Thierry Arnoux, 20-Feb-2025.)
theorem nn0difffzod (ph: wff) (M N: class):
  $ wi ph (wcel N cz) $ >
  $ wi ph (wcel M (cdif cn0 (co cc0 N cfzo))) $ >
  $ wi ph (wn (wbr M N clt)) $;

--| Show that the support of a function is contained in an half-open nonnegative integer range. (Contributed by Thierry Arnoux, 20-Feb-2025.)
theorem suppssnn0 {k: setvar} (ph: wff) (F N Z: class):
  $ wi ph (wfn F cn0) $ >
  $ wi (wa (wa ph (wcel (cv k) cn0)) (wbr N (cv k) cle)) (wceq (cfv (cv k) F) Z) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wss (co F Z csupp) (co cc0 N cfzo)) $;

--| The cardinality of a disjoint finite union of finite sets. Cf. ~ hashuni . (Contributed by Thierry Arnoux, 17-Feb-2017.)
theorem hashunif {x3: setvar} (ph: wff x3) (A2: class):
  $ wnf x3 ph $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wss A2 cfn) $ >
  $ wi ph (wdisj x3 A2 (cv x3)) $ >
  $ wi ph (wceq (cfv (cuni A2) chash) (csu x3 A2 (cfv (cv x3) chash))) $;

--| The size of the Cartesian product of two finite sets is the product of their sizes. This is a version of ~ hashxp valid for infinite sets, which uses extended real numbers. (Contributed by Thierry Arnoux, 27-May-2023.)
theorem hashxpe (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wceq (cfv (cxp A2 B2) chash) (co (cfv A2 chash) (cfv B2 chash) cxmu)) $;

--| Restate "set contains at least two elements" in terms of elementhood. (Contributed by Thierry Arnoux, 21-Nov-2023.)
theorem hashgt1 (A2 V: class):
  $ wi (wcel A2 V) (wb (wn (wcel A2 (cima (ccnv chash) (cpr cc0 c1)))) (wbr c1 (cfv A2 chash) clt)) $;

--| Deduce that the size of a set is not zero. (Contributed by Thierry Arnoux, 26-Oct-2025.)
theorem hashne0 (ph: wff) (A2 V: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wne A2 c0) $ >
  $ wi ph (wbr cc0 (cfv A2 chash) clt) $;

--| Taking the image of a set by a one-to-one function does not affect size. (Contributed by Thierry Arnoux, 18-Jan-2026.)
theorem hashimaf1 (ph: wff) (A2 B2 C F V: class):
  $ wi ph (wf1 A2 B2 F) $ >
  $ wi ph (wss C A2) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wceq (cfv (cima F C) chash) (cfv C chash)) $;

--| Elementhood in the rational numbers, providing the canonical representation. (Contributed by Thierry Arnoux, 9-Nov-2025.)
theorem elq2 {q p: setvar} (Q: class):
  $ wi (wcel Q cq) (wrex p (wrex q (wa (wceq Q (co (cv p) (cv q) cdiv)) (wceq (co (cv p) (cv q) cgcd) c1)) cn) cz) $;

--| Numerator of an integer. (Contributed by Thierry Arnoux, 4-May-2025.)
theorem znumd (ph: wff) (Z: class):
  $ wi ph (wcel Z cz) $ >
  $ wi ph (wceq (cfv Z cnumer) Z) $;

--| Denominator of an integer. (Contributed by Thierry Arnoux, 4-May-2025.)
theorem zdend (ph: wff) (Z: class):
  $ wi ph (wcel Z cz) $ >
  $ wi ph (wceq (cfv Z cdenom) c1) $;

--| Numerator and denominator of the negative. (Contributed by Thierry Arnoux, 27-Oct-2017.)
theorem numdenneg (Q: class):
  $ wi (wcel Q cq) (wa (wceq (cfv (cneg Q) cnumer) (cneg (cfv Q cnumer))) (wceq (cfv (cneg Q) cdenom) (cfv Q cdenom))) $;

--| Calculate the reduced form of a quotient using ` gcd ` . This version extends ~ divnumden for the negative integers. (Contributed by Thierry Arnoux, 25-Oct-2017.)
theorem divnumden2 (A2 B2: class):
  $ wi (w3a (wcel A2 cz) (wcel B2 cz) (wcel (cneg B2) cn)) (wa (wceq (cfv (co A2 B2 cdiv) cnumer) (cneg (co A2 (co A2 B2 cgcd) cdiv))) (wceq (cfv (co A2 B2 cdiv) cdenom) (cneg (co B2 (co A2 B2 cgcd) cdiv)))) $;

--| A real number ` A ` raised to an odd integer power is positive iff it is positive. (Contributed by SN, 4-Mar-2023.) Use the more standard ` -. 2 || N ` (Revised by Thierry Arnoux, 14-Jun-2025.)
theorem expgt0b (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wn (wbr c2 N cdvds)) $ >
  $ wi ph (wb (wbr cc0 A2 clt) (wbr cc0 (co A2 N cexp) clt)) $;

--| Split 0 and 1 from the nonnegative integers. (Contributed by Thierry Arnoux, 8-Jun-2025.)
theorem nn0split01:
  $ wceq cn0 (cun (cpr cc0 c1) (cfv c2 cuz)) $;

--| The pair ` { 0 , 1 } ` does not overlap the rest of the nonnegative integers. (Contributed by Thierry Arnoux, 8-Jun-2025.)
theorem nn0disj01:
  $ wceq (cin (cpr cc0 c1) (cfv c2 cuz)) c0 $;

--| Principle of Mathematical Induction, using a bound-variable hypothesis instead of distinct variables. (Contributed by Thierry Arnoux, 6-May-2018.)
theorem nnindf {x3 y1: setvar} (ph: wff x3 y1) (ps ch th ta: wff y1) (A2: class y1):
  $ wnf y1 ph $ >
  $ wi (wceq (cv x3) c1) (wb ph ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ch) $ >
  $ wi (wceq (cv x3) (co (cv y1) c1 caddc)) (wb ph th) $ >
  $ wi (wceq (cv x3) A2) (wb ph ta) $ >
  $ ps $ >
  $ wi (wcel (cv y1) cn) (wi ch th) $ >
  $ wi (wcel A2 cn) ta $;

--| Extracting the minimum positive integer for which a property ` ch ` does not hold. This uses substitutions similar to ~ nn0ind . (Contributed by Thierry Arnoux, 6-May-2018.)
theorem nn0min {m n: setvar} (ph: wff) (ps: wff n) (ch: wff) (th ta: wff m):
  $ wi (wceq (cv n) cc0) (wb ps ch) $ >
  $ wi (wceq (cv n) (cv m)) (wb ps th) $ >
  $ wi (wceq (cv n) (co (cv m) c1 caddc)) (wb ps ta) $ >
  $ wi ph (wn ch) $ >
  $ wi ph (wrex n ps cn) $ >
  $ wi ph (wrex m (wa (wn th) ta) cn0) $;

--| A nonnegative difference is positive if the two numbers are not equal. (Contributed by Thierry Arnoux, 17-Dec-2023.)
theorem subne0nn (ph: wff) (M N: class):
  $ wi ph (wcel M cc) $ >
  $ wi ph (wcel N cc) $ >
  $ wi ph (wcel (co M N cmin) cn0) $ >
  $ wi ph (wne M N) $ >
  $ wi ph (wcel (co M N cmin) cn) $;

--| Subtracting an integer number from another number decreases it. See ~ ltsubrpd . (Contributed by Thierry Arnoux, 18-Apr-2017.)
theorem ltesubnnd (ph: wff) (M N: class):
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr (co (co M c1 caddc) N cmin) M cle) $;

--| If one of the factors is zero the product is zero. (Contributed by Thierry Arnoux, 11-Dec-2021.)
theorem fprodeq02 {k: setvar} (ph: wff) (A2: class) (B2: class k) (C K: class):
  $ wi (wceq (cv k) K) (wceq B2 C) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi ph (wcel K A2) $ >
  $ wi ph (wceq C cc0) $ >
  $ wi ph (wceq (cprod k A2 B2) cc0) $;

--| A product of factors equal to zero or one is zero exactly when one of the factors is zero. (Contributed by Thierry Arnoux, 11-Dec-2021.)
theorem fprodex01 {k l: setvar} (ph: wff) (A2: class) (B2: class k) (C: class l):
  $ wi (wceq (cv k) (cv l)) (wceq B2 C) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 (cpr cc0 c1)) $ >
  $ wi ph (wceq (cprod k A2 B2) (cif (wral l (wceq C c1) A2) c1 cc0)) $;

--| A product over a pair is the product of the elements. (Contributed by Thierry Arnoux, 1-Jan-2022.)
theorem prodpr {k: setvar} (ph: wff) (A2 B2: class) (D: class k) (E F V W: class):
  $ wi (wceq (cv k) A2) (wceq D E) $ >
  $ wi (wceq (cv k) B2) (wceq D F) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel E cc) $ >
  $ wi ph (wcel F cc) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wceq (cprod k (cpr A2 B2) D) (co E F cmul)) $;

--| A product over a triple is the product of the elements. (Contributed by Thierry Arnoux, 1-Jan-2022.)
theorem prodtp {k: setvar} (ph: wff) (A2 B2 C: class) (D: class k) (E F G V W X: class):
  $ wi (wceq (cv k) A2) (wceq D E) $ >
  $ wi (wceq (cv k) B2) (wceq D F) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel E cc) $ >
  $ wi ph (wcel F cc) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi (wceq (cv k) C) (wceq D G) $ >
  $ wi ph (wcel C X) $ >
  $ wi ph (wcel G cc) $ >
  $ wi ph (wne A2 C) $ >
  $ wi ph (wne B2 C) $ >
  $ wi ph (wceq (cprod k (ctp A2 B2 C) D) (co (co E F cmul) G cmul)) $;

--| An upper bound for a term of a positive finite sum. (Contributed by Thierry Arnoux, 27-Dec-2021.)
theorem fsumub {k: setvar} (ph: wff) (A2: class) (B2 C: class k) (D K: class):
  $ wi (wceq (cv k) K) (wceq B2 D) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wceq (csu k A2 B2) C) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 crp) $ >
  $ wi ph (wcel K A2) $ >
  $ wi ph (wbr D C cle) $;

--| Upper bound for a sum of nonnegative terms over an indexed union. The inequality may be strict if the indexed union is non-disjoint, since in the right hand side, a summand may be counted several times. (Contributed by Thierry Arnoux, 1-Jan-2021.)
theorem fsumiunle {x3 k: setvar} (ph: wff) (A2: class) (B2: class x3) (C: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cfn) $ >
  $ wi (wa (wa ph (wcel (cv x3) A2)) (wcel (cv k) B2)) (wcel C cr) $ >
  $ wi (wa (wa ph (wcel (cv x3) A2)) (wcel (cv k) B2)) (wbr cc0 C cle) $ >
  $ wi ph (wbr (csu k (ciun x3 A2 B2) C) (csu x3 A2 (csu k B2 C)) cle) $;

--| Split the hundreds from a decimal value. (Contributed by Thierry Arnoux, 25-Dec-2021.)
theorem dfdec100 (A2 B2 C: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 cn0 $ >
  $ wcel C cr $ >
  $ wceq (cdc (cdc A2 B2) C) (co (co (cdc (cdc c1 cc0) cc0) A2 cmul) (cdc B2 C) caddc) $;

--| Signum is idempotent. (Contributed by Thierry Arnoux, 2-Oct-2018.)
theorem sgnsgn (A2: class):
  $ wi (wcel A2 cxr) (wceq (cfv (cfv A2 csgn) csgn) (cfv A2 csgn)) $;

--| If two real numbers are of same signs, so are their signs. (Contributed by Thierry Arnoux, 12-Oct-2018.)
theorem sgnmulsgp (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wb (wbr cc0 (co A2 B2 cmul) clt) (wbr cc0 (co (cfv A2 csgn) (cfv B2 csgn) cmul) clt)) $;

--| A lower bound for an exponentiation. (Contributed by Thierry Arnoux, 19-Aug-2017.)
theorem nexple (A2 B2: class):
  $ wi (w3a (wcel A2 cn0) (wcel B2 cr) (wbr c2 B2 cle)) (wbr A2 (co B2 A2 cexp) cle) $;

--| If a nonnegative integer ` X ` is a multiple of a power of two, but less than the next power of two, it is itself a power of two. (Contributed by Thierry Arnoux, 19-Oct-2025.)
theorem _2exple2exp {n: setvar} (ph: wff) (K X: class):
  $ wi ph (wcel X cn) $ >
  $ wi ph (wcel K cn0) $ >
  $ wi ph (wbr (co c2 K cexp) X cdvds) $ >
  $ wi ph (wbr X (co c2 (co K c1 caddc) cexp) cle) $ >
  $ wi ph (wrex n (wceq X (co c2 (cv n) cexp)) cn0) $;

--| Even powers are positive. (Contributed by Thierry Arnoux, 9-Nov-2025.)
theorem expevenpos (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wbr c2 N cdvds) $ >
  $ wi ph (wbr cc0 (co A2 N cexp) cle) $;

--| Odd power monomials are monotonic. (Contributed by Thierry Arnoux, 9-Nov-2025.)
theorem oexpled (ph: wff) (A2 B2 N: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wn (wbr c2 N cdvds)) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wi ph (wbr (co A2 N cexp) (co B2 N cexp) cle) $;

--| Finite sum of a product with the indicator function / Cartesian product with the indicator function. (Contributed by Thierry Arnoux, 11-Dec-2021.)
theorem indsumin {k: setvar} (ph: wff) (A2 B2: class) (C: class k) (O: class) (V: class k):
  $ wi ph (wcel O V) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wss A2 O) $ >
  $ wi ph (wss B2 O) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel C cc) $ >
  $ wi ph (wceq (csu k A2 (co (cfv (cv k) (cfv B2 (cfv O cind))) C cmul)) (csu k (cin A2 B2) C)) $;

--| The product of indicators is one if and only if all values are in the set. (Contributed by Thierry Arnoux, 11-Dec-2021.)
theorem prodindf {k: setvar} (ph: wff) (A2 B2 F O: class) (V: class k):
  $ wi ph (wcel O V) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wss B2 O) $ >
  $ wi ph (wf A2 O F) $ >
  $ wi ph (wceq (cprod k A2 (cfv (cfv (cv k) F) (cfv B2 (cfv O cind)))) (cif (wss (crn F) B2) c1 cc0)) $;

--| The indicator function of a singleton. (Contributed by Thierry Arnoux, 15-Feb-2026.)
theorem indsn {x3: setvar} (O V X: class):
  $ wi (wa (wcel O V) (wcel X O)) (wceq (cfv (csn X) (cfv O cind)) (cmpt x3 O (cif (wceq (cv x3) X) c1 cc0))) $;

--| The bijection between a power set and the set of indicator functions. (Contributed by Thierry Arnoux, 14-Aug-2017.)
theorem indf1o (O V: class):
  $ wi (wcel O V) (wf1o (cpw O) (co (cpr cc0 c1) O cmap) (cfv O cind)) $;

--| A function with range ` { 0 , 1 } ` as an indicator of the preimage of ` { 1 } ` . (Contributed by Thierry Arnoux, 23-Aug-2017.)
theorem indpreima (F O V: class):
  $ wi (wa (wcel O V) (wf O (cpr cc0 c1) F)) (wceq F (cfv (cima (ccnv F) (csn c1)) (cfv O cind))) $;

--| The bijection between finite subsets and the indicator functions with finite support. (Contributed by Thierry Arnoux, 22-Aug-2017.)
theorem indf1ofs {f2: setvar} (O: class) (V: class f2):
  $ wi (wcel O V) (wf1o (cin (cpw O) cfn) (crab f2 (wcel (cima (ccnv (cv f2)) (csn c1)) cfn) (co (cpr cc0 c1) O cmap)) (cres (cfv O cind) cfn)) $;

--| The support of the indicator function. (Contributed by Thierry Arnoux, 13-Oct-2025.)
theorem indsupp (A2 O V: class):
  $ wi (wa (wcel O V) (wss A2 O)) (wceq (co (cfv A2 (cfv O cind)) cc0 csupp) A2) $;

--| The indicator function of a finite set has finite support. (Contributed by Thierry Arnoux, 18-Jan-2026.)
theorem indfsd (ph: wff) (A2 O V: class):
  $ wi ph (wcel O V) $ >
  $ wi ph (wss A2 O) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wbr (cfv A2 (cfv O cind)) cc0 cfsupp) $;

--| Conditions for a function to be an indicator function. (Contributed by Thierry Arnoux, 18-Jan-2026.)
theorem indfsid (ph: wff) (F O V: class):
  $ wi ph (wcel O V) $ >
  $ wi ph (wf O (cpr cc0 c1) F) $ >
  $ wi ph (wceq F (cfv (co F cc0 csupp) (cfv O cind))) $;

--| Constant used for decimal fraction constructor. See ~ df-dp2 .
term cdp2 (A2 B2: class): class;

--| Define the "decimal fraction constructor", which is used to build up "decimal fractions" in base 10. This is intentionally similar to ~ df-dec . (Contributed by David A. Wheeler, 15-May-2015.) (Revised by AV, 9-Sep-2021.)
axiom df_dp2 (A2 B2: class):
  $ wceq (cdp2 A2 B2) (co A2 (co B2 (cdc c1 cc0) cdiv) caddc) $;

--| Equality theorem for the decimal expansion constructor. (Contributed by David A. Wheeler, 15-May-2015.)
theorem dp2eq1 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cdp2 A2 C) (cdp2 B2 C)) $;

--| Equality theorem for the decimal expansion constructor. (Contributed by David A. Wheeler, 15-May-2015.)
theorem dp2eq2 (A2 B2 C: class):
  $ wi (wceq A2 B2) (wceq (cdp2 C A2) (cdp2 C B2)) $;

--| Equality theorem for the decimal expansion constructor. (Contributed by David A. Wheeler, 15-May-2015.)
theorem dp2eq1i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cdp2 A2 C) (cdp2 B2 C) $;

--| Equality theorem for the decimal expansion constructor. (Contributed by David A. Wheeler, 15-May-2015.)
theorem dp2eq2i (A2 B2 C: class):
  $ wceq A2 B2 $ >
  $ wceq (cdp2 C A2) (cdp2 C B2) $;

--| Equality theorem for the decimal expansion constructor. (Contributed by David A. Wheeler, 15-May-2015.)
theorem dp2eq12i (A2 B2 C D: class):
  $ wceq A2 B2 $ >
  $ wceq C D $ >
  $ wceq (cdp2 A2 C) (cdp2 B2 D) $;

--| Add a zero in the tenths (lower) place. (Contributed by Thierry Arnoux, 16-Dec-2021.)
theorem dp20u (A2: class):
  $ wcel A2 cn0 $ >
  $ wceq (cdp2 A2 cc0) A2 $;

--| Add a zero in the unit places. (Contributed by Thierry Arnoux, 16-Dec-2021.)
theorem dp20h (A2: class):
  $ wcel A2 crp $ >
  $ wceq (cdp2 cc0 A2) (co A2 (cdc c1 cc0) cdiv) $;

--| Closure for the decimal fraction constructor if both values are reals. (Contributed by David A. Wheeler, 15-May-2015.)
theorem dp2cl (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wcel (cdp2 A2 B2) cr) $;

--| Closure for a decimal fraction. (Contributed by Thierry Arnoux, 16-Dec-2021.)
theorem dp2clq (A2 B2: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 cq $ >
  $ wcel (cdp2 A2 B2) cq $;

--| Closure for a decimal fraction in the positive real numbers. (Contributed by Thierry Arnoux, 16-Dec-2021.)
theorem rpdp2cl (A2 B2: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 crp $ >
  $ wcel (cdp2 A2 B2) crp $;

--| Closure for a decimal fraction with no decimal expansion in the positive real numbers. (Contributed by Thierry Arnoux, 25-Dec-2021.)
theorem rpdp2cl2 (A2: class):
  $ wcel A2 cn $ >
  $ wcel (cdp2 A2 cc0) crp $;

--| Decimal fraction builds real numbers less than 10. (Contributed by Thierry Arnoux, 16-Dec-2021.)
theorem dp2lt10 (A2 B2: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 crp $ >
  $ wbr A2 (cdc c1 cc0) clt $ >
  $ wbr B2 (cdc c1 cc0) clt $ >
  $ wbr (cdp2 A2 B2) (cdc c1 cc0) clt $;

--| Comparing two decimal fractions (equal unit places). (Contributed by Thierry Arnoux, 16-Dec-2021.)
theorem dp2lt (A2 B2 C: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 crp $ >
  $ wcel C crp $ >
  $ wbr B2 C clt $ >
  $ wbr (cdp2 A2 B2) (cdp2 A2 C) clt $;

--| Comparing a decimal fraction with the next integer. (Contributed by Thierry Arnoux, 25-Dec-2021.)
theorem dp2ltsuc (A2 B2 C: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 crp $ >
  $ wbr B2 (cdc c1 cc0) clt $ >
  $ wceq (co A2 c1 caddc) C $ >
  $ wbr (cdp2 A2 B2) C clt $;

--| Comparing two decimal expansions (unequal higher places). (Contributed by Thierry Arnoux, 16-Dec-2021.)
theorem dp2ltc (A2 B2 C D: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 crp $ >
  $ wcel C cn0 $ >
  $ wcel D crp $ >
  $ wbr B2 (cdc c1 cc0) clt $ >
  $ wbr A2 C clt $ >
  $ wbr (cdp2 A2 B2) (cdp2 C D) clt $;

--| Decimal point operator. See ~ df-dp .
term cdp: class;

--| Define the ` . ` (decimal point) operator. For example, ` ( 1 . 5 ) = ( 3 / 2 ) ` , and ` -u ( ; 3 2 . _ 7 _ 1 8 ) = -u ( ; ; ; ; 3 2 7 1 8 / ; ; ; 1 0 0 0 ) ` Unary minus, if applied, should normally be applied in front of the parentheses. Metamath intentionally does not have a built-in construct for numbers, so it can show that numbers are something you can build based on set theory. However, that means that Metamath has no built-in way to parse and handle decimal numbers as traditionally written, e.g., "2.54". Here we create a system for modeling traditional decimal point notation; it is not syntactically identical, but it is sufficiently similar so it is a reasonable model of decimal point notation. It should also serve as a convenient way to write some fractional numbers. The RHS is ` RR ` , not ` QQ ` ; this should simplify some proofs. The LHS is ` NN0 ` , since that is what is used in practice. The definition intentionally does not allow negative numbers on the LHS; if it did, nonzero fractions would produce the wrong results. (It would be possible to define the decimal point to do this, but using it would be more complicated, and the expression ` -u ( A . B ) ` is just as convenient.) (Contributed by David A. Wheeler, 15-May-2015.)
axiom df_dp {x3 y1: setvar}:
  $ wceq cdp (cmpo x3 y1 cn0 cr (cdp2 (cv x3) (cv y1))) $;

--| Define the value of the decimal point operator. See ~ df-dp . (Contributed by David A. Wheeler, 15-May-2015.)
theorem dpval (A2 B2: class):
  $ wi (wa (wcel A2 cn0) (wcel B2 cr)) (wceq (co A2 B2 cdp) (cdp2 A2 B2)) $;

--| Prove that the closure of the decimal point is ` RR ` as we have defined it. See ~ df-dp . (Contributed by David A. Wheeler, 15-May-2015.)
theorem dpcl (A2 B2: class):
  $ wi (wa (wcel A2 cn0) (wcel B2 cr)) (wcel (co A2 B2 cdp) cr) $;

--| Prove a simple equivalence involving the decimal point. See ~ df-dp and ~ dpcl . (Contributed by David A. Wheeler, 15-May-2015.) (Revised by AV, 9-Sep-2021.)
theorem dpfrac1 (A2 B2: class):
  $ wi (wa (wcel A2 cn0) (wcel B2 cr)) (wceq (co A2 B2 cdp) (co (cdc A2 B2) (cdc c1 cc0) cdiv)) $;

--| Value of the decimal point construct. (Contributed by Thierry Arnoux, 16-Dec-2021.)
theorem dpval2 (A2 B2: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 cr $ >
  $ wceq (co A2 B2 cdp) (co A2 (co B2 (cdc c1 cc0) cdiv) caddc) $;

--| Value of the decimal point construct. (Contributed by Thierry Arnoux, 16-Dec-2021.)
theorem dpval3 (A2 B2: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 cr $ >
  $ wceq (co A2 B2 cdp) (cdp2 A2 B2) $;

--| Multiply by 10 a decimal expansion. (Contributed by Thierry Arnoux, 25-Dec-2021.)
theorem dpmul10 (A2 B2: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 cr $ >
  $ wceq (co (co A2 B2 cdp) (cdc c1 cc0) cmul) (cdc A2 B2) $;

--| Divide a decimal number by 10. (Contributed by Thierry Arnoux, 25-Dec-2021.)
theorem decdiv10 (A2 B2: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 cr $ >
  $ wceq (co (cdc A2 B2) (cdc c1 cc0) cdiv) (co A2 B2 cdp) $;

--| Multiply by 100 a decimal expansion. (Contributed by Thierry Arnoux, 25-Dec-2021.)
theorem dpmul100 (A2 B2 C: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 cn0 $ >
  $ wcel C cr $ >
  $ wceq (co (co A2 (cdp2 B2 C) cdp) (cdc (cdc c1 cc0) cc0) cmul) (cdc (cdc A2 B2) C) $;

--| Multiply by 10 a decimal expansion with 3 digits. (Contributed by Thierry Arnoux, 25-Dec-2021.)
theorem dp3mul10 (A2 B2 C: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 cn0 $ >
  $ wcel C cr $ >
  $ wceq (co (co A2 (cdp2 B2 C) cdp) (cdc c1 cc0) cmul) (co (cdc A2 B2) C cdp) $;

--| Multiply by 1000 a decimal expansion. (Contributed by Thierry Arnoux, 25-Dec-2021.)
theorem dpmul1000 (A2 B2 C D: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 cn0 $ >
  $ wcel C cn0 $ >
  $ wcel D cr $ >
  $ wceq (co (co A2 (cdp2 B2 (cdp2 C D)) cdp) (cdc (cdc (cdc c1 cc0) cc0) cc0) cmul) (cdc (cdc (cdc A2 B2) C) D) $;

--| Value of the decimal point construct. (Contributed by Thierry Arnoux, 16-Dec-2021.)
theorem dpval3rp (A2 B2: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 crp $ >
  $ wceq (co A2 B2 cdp) (cdp2 A2 B2) $;

--| Add a zero in the tenths place. (Contributed by Thierry Arnoux, 16-Dec-2021.)
theorem dp0u (A2: class):
  $ wcel A2 cn0 $ >
  $ wceq (co A2 cc0 cdp) A2 $;

--| Remove a zero in the units places. (Contributed by Thierry Arnoux, 16-Dec-2021.)
theorem dp0h (A2: class):
  $ wcel A2 crp $ >
  $ wceq (co cc0 A2 cdp) (co A2 (cdc c1 cc0) cdiv) $;

--| Closure of the decimal point in the positive real numbers. (Contributed by Thierry Arnoux, 16-Dec-2021.)
theorem rpdpcl (A2 B2: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 crp $ >
  $ wcel (co A2 B2 cdp) crp $;

--| Comparing two decimal expansions (equal higher places). (Contributed by Thierry Arnoux, 16-Dec-2021.)
theorem dplt (A2 B2 C: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 crp $ >
  $ wcel C crp $ >
  $ wbr B2 C clt $ >
  $ wbr (co A2 B2 cdp) (co A2 C cdp) clt $;

--| Comparing a decimal expansions with the next higher integer. (Contributed by Thierry Arnoux, 16-Dec-2021.)
theorem dplti (A2 B2 C: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 crp $ >
  $ wcel C cn0 $ >
  $ wbr B2 (cdc c1 cc0) clt $ >
  $ wceq (co A2 c1 caddc) C $ >
  $ wbr (co A2 B2 cdp) C clt $;

--| Comparing a decimal expansions with the next lower integer. (Contributed by Thierry Arnoux, 16-Dec-2021.)
theorem dpgti (A2 B2: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 crp $ >
  $ wbr A2 (co A2 B2 cdp) clt $;

--| Comparing two decimal integers (unequal higher places). (Contributed by Thierry Arnoux, 16-Dec-2021.)
theorem dpltc (A2 B2 C D: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 crp $ >
  $ wcel C cn0 $ >
  $ wcel D crp $ >
  $ wbr A2 C clt $ >
  $ wbr B2 (cdc c1 cc0) clt $ >
  $ wbr (co A2 B2 cdp) (co C D cdp) clt $;

--| Add one zero to the mantisse, and a one to the exponent in a scientific notation. (Contributed by Thierry Arnoux, 16-Dec-2021.)
theorem dpexpp1 (A2 B2 P Q: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 crp $ >
  $ wceq (co P c1 caddc) Q $ >
  $ wcel P cz $ >
  $ wcel Q cz $ >
  $ wceq (co (co A2 B2 cdp) (co (cdc c1 cc0) P cexp) cmul) (co (co cc0 (cdp2 A2 B2) cdp) (co (cdc c1 cc0) Q cexp) cmul) $;

--| Multiply by 10 a decimal expansion which starts with a zero. (Contributed by Thierry Arnoux, 16-Dec-2021.)
theorem _0dp2dp (A2 B2: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 crp $ >
  $ wceq (co (co cc0 (cdp2 A2 B2) cdp) (cdc c1 cc0) cmul) (co A2 B2 cdp) $;

--| Addition with one decimal, no carry. (Contributed by Thierry Arnoux, 29-Dec-2021.)
theorem dpadd2 (A2 B2 C D E F G H I: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 crp $ >
  $ wcel C cn0 $ >
  $ wcel D crp $ >
  $ wcel E cn0 $ >
  $ wcel F crp $ >
  $ wcel G cn0 $ >
  $ wcel H cn0 $ >
  $ wceq (co G H caddc) I $ >
  $ wceq (co (co A2 B2 cdp) (co C D cdp) caddc) (co E F cdp) $ >
  $ wceq (co (co G (cdp2 A2 B2) cdp) (co H (cdp2 C D) cdp) caddc) (co I (cdp2 E F) cdp) $;

--| Addition with one decimal. (Contributed by Thierry Arnoux, 27-Dec-2021.)
theorem dpadd (A2 B2 C D E F: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 cn0 $ >
  $ wcel C cn0 $ >
  $ wcel D cn0 $ >
  $ wcel E cn0 $ >
  $ wcel F cn0 $ >
  $ wceq (co (cdc A2 B2) (cdc C D) caddc) (cdc E F) $ >
  $ wceq (co (co A2 B2 cdp) (co C D cdp) caddc) (co E F cdp) $;

--| Addition with two decimals. (Contributed by Thierry Arnoux, 27-Dec-2021.)
theorem dpadd3 (A2 B2 C D E F G H I: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 cn0 $ >
  $ wcel C cn0 $ >
  $ wcel D cn0 $ >
  $ wcel E cn0 $ >
  $ wcel G cn0 $ >
  $ wcel F cn0 $ >
  $ wcel H cn0 $ >
  $ wcel I cn0 $ >
  $ wceq (co (cdc (cdc A2 B2) C) (cdc (cdc D E) F) caddc) (cdc (cdc G H) I) $ >
  $ wceq (co (co A2 (cdp2 B2 C) cdp) (co D (cdp2 E F) cdp) caddc) (co G (cdp2 H I) cdp) $;

--| Multiplication with one decimal point. (Contributed by Thierry Arnoux, 26-Dec-2021.)
theorem dpmul (A2 B2 C D E F G I J K L M: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 cn0 $ >
  $ wcel C cn0 $ >
  $ wcel D cn0 $ >
  $ wcel E cn0 $ >
  $ wcel G cn0 $ >
  $ wcel J cn0 $ >
  $ wcel K cn0 $ >
  $ wceq (co A2 C cmul) F $ >
  $ wceq (co A2 D cmul) M $ >
  $ wceq (co B2 C cmul) L $ >
  $ wceq (co B2 D cmul) (cdc E K) $ >
  $ wceq (co (co L M caddc) E caddc) (cdc G J) $ >
  $ wceq (co F G caddc) I $ >
  $ wceq (co (co A2 B2 cdp) (co C D cdp) cmul) (co I (cdp2 J K) cdp) $;

--| An upper bound to multiplication of decimal numbers with 4 digits. (Contributed by Thierry Arnoux, 25-Dec-2021.)
theorem dpmul4 (A2 B2 C D P Q R S T U E F G H I J K L M N O W X Y Z: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 cn0 $ >
  $ wcel C cn0 $ >
  $ wcel D cn0 $ >
  $ wcel E cn0 $ >
  $ wcel G cn0 $ >
  $ wcel J cn0 $ >
  $ wcel K cn0 $ >
  $ wcel F cn0 $ >
  $ wcel H cn0 $ >
  $ wcel I cn0 $ >
  $ wcel L cn0 $ >
  $ wcel M cn0 $ >
  $ wcel N cn0 $ >
  $ wcel O cn0 $ >
  $ wcel P cn0 $ >
  $ wcel Q cn0 $ >
  $ wcel R cn0 $ >
  $ wcel S cn0 $ >
  $ wcel T cn0 $ >
  $ wcel U cn0 $ >
  $ wcel W cn0 $ >
  $ wcel X cn0 $ >
  $ wcel Y cn0 $ >
  $ wcel Z cn0 $ >
  $ wbr U (cdc c1 cc0) clt $ >
  $ wbr P (cdc c1 cc0) clt $ >
  $ wbr Q (cdc c1 cc0) clt $ >
  $ wceq (co (cdc (cdc L M) N) O caddc) (cdc (cdc (cdc R S) T) U) $ >
  $ wceq (co (co A2 B2 cdp) (co E F cdp) cmul) (co I (cdp2 J K) cdp) $ >
  $ wceq (co (co C D cdp) (co G H cdp) cmul) (co O (cdp2 P Q) cdp) $ >
  $ wceq (co (cdc (cdc (cdc I J) K) c1) (cdc (cdc R S) T) caddc) (cdc (cdc (cdc W X) Y) Z) $ >
  $ wceq (co (co (co A2 B2 cdp) (co C D cdp) caddc) (co (co E F cdp) (co G H cdp) caddc) cmul) (co (co (co I (cdp2 J K) cdp) (co L (cdp2 M N) cdp) caddc) (co O (cdp2 P Q) cdp) caddc) $ >
  $ wbr (co (co A2 (cdp2 B2 (cdp2 C D)) cdp) (co E (cdp2 F (cdp2 G H)) cdp) cmul) (co W (cdp2 X (cdp2 Y Z)) cdp) clt $;

--| Example theorem demonstrating decimal expansions. (Contributed by Thierry Arnoux, 27-Dec-2021.)
theorem threehalves:
  $ wceq (co c3 c2 cdiv) (co c1 c5 cdp) $;

--| Example theorem demonstrating decimal expansions. (Contributed by Thierry Arnoux, 27-Dec-2021.)
theorem _1mhdrd:
  $ wceq (co (co cc0 (cdp2 c9 c9) cdp) (co cc0 (cdp2 cc0 c1) cdp) caddc) c1 $;

--| Extend class notation to include division of extended reals.
term cxdiv: class;

--| Define division over extended real numbers. (Contributed by Thierry Arnoux, 17-Dec-2016.)
axiom df_xdiv {x3 y1 z: setvar}:
  $ wceq cxdiv (cmpo x3 y1 cxr (cdif cr (csn cc0)) (crio z (wceq (co (cv y1) (cv z) cxmu) (cv x3)) cxr)) $;

--| Value of division: the (unique) element ` x ` such that ` ( B x. x ) = A ` . This is meaningful only when ` B ` is nonzero. (Contributed by Thierry Arnoux, 17-Dec-2016.)
theorem xdivval {x3: setvar} (A2 B2: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cr) (wne B2 cc0)) (wceq (co A2 B2 cxdiv) (crio x3 (wceq (co B2 (cv x3) cxmu) A2) cxr)) $;

--| Existence of reciprocal of nonzero real number. (Contributed by Thierry Arnoux, 17-Dec-2016.)
theorem xrecex {x3: setvar} (A2: class):
  $ wi (wa (wcel A2 cr) (wne A2 cc0)) (wrex x3 (wceq (co A2 (cv x3) cxmu) c1) cr) $;

--| Cancellation law for extended multiplication. (Contributed by Thierry Arnoux, 17-Dec-2016.)
theorem xmulcand (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cxr) $ >
  $ wi ph (wcel B2 cxr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wne C cc0) $ >
  $ wi ph (wb (wceq (co C A2 cxmu) (co C B2 cxmu)) (wceq A2 B2)) $;

--| Existential uniqueness of reciprocals. Theorem I.8 of [Apostol] p. 18. (Contributed by Thierry Arnoux, 17-Dec-2016.)
theorem xreceu {x3: setvar} (A2 B2: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cr) (wne B2 cc0)) (wreu x3 (wceq (co B2 (cv x3) cxmu) A2) cxr) $;

--| Closure law for the extended division. (Contributed by Thierry Arnoux, 15-Mar-2017.)
theorem xdivcld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cxr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wne B2 cc0) $ >
  $ wi ph (wcel (co A2 B2 cxdiv) cxr) $;

--| Closure law for the extended division. (Contributed by Thierry Arnoux, 15-Mar-2017.)
theorem xdivcl (A2 B2: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cr) (wne B2 cc0)) (wcel (co A2 B2 cxdiv) cxr) $;

--| Relationship between division and multiplication. (Contributed by Thierry Arnoux, 24-Dec-2016.)
theorem xdivmul (A2 B2 C: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wa (wcel C cr) (wne C cc0))) (wb (wceq (co A2 C cxdiv) B2) (wceq (co C B2 cxmu) A2)) $;

--| The extended real division operation when both arguments are real. (Contributed by Thierry Arnoux, 18-Dec-2016.)
theorem rexdiv (A2 B2: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wne B2 cc0)) (wceq (co A2 B2 cxdiv) (co A2 B2 cdiv)) $;

--| Relationship between division and reciprocal. (Contributed by Thierry Arnoux, 5-Jul-2017.)
theorem xdivrec (A2 B2: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cr) (wne B2 cc0)) (wceq (co A2 B2 cxdiv) (co A2 (co c1 B2 cxdiv) cxmu)) $;

--| A number divided by itself is one. (Contributed by Thierry Arnoux, 18-Dec-2016.)
theorem xdivid (A2: class):
  $ wi (wa (wcel A2 cr) (wne A2 cc0)) (wceq (co A2 A2 cxdiv) c1) $;

--| Division into zero is zero. (Contributed by Thierry Arnoux, 18-Dec-2016.)
theorem xdiv0 (A2: class):
  $ wi (wa (wcel A2 cr) (wne A2 cc0)) (wceq (co cc0 A2 cxdiv) cc0) $;

--| Division into zero is zero. (Contributed by Thierry Arnoux, 18-Dec-2016.)
theorem xdiv0rp (A2: class):
  $ wi (wcel A2 crp) (wceq (co cc0 A2 cxdiv) cc0) $;

--| Membership in a closed interval of extended reals versus the same open interval. (Contributed by Thierry Arnoux, 18-Dec-2016.)
theorem eliccioo (A2 B2 C: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wbr A2 B2 cle)) (wb (wcel C (co A2 B2 cicc)) (w3o (wceq C A2) (wcel C (co A2 B2 cioo)) (wceq C B2))) $;

--| Elementhood in the set of nonnegative extended reals. (Contributed by Thierry Arnoux, 18-Dec-2016.)
theorem elxrge02 (A2: class):
  $ wb (wcel A2 (co cc0 cpnf cicc)) (w3o (wceq A2 cc0) (wcel A2 crp) (wceq A2 cpnf)) $;

--| Plus infinity divided by a positive real number is plus infinity. (Contributed by Thierry Arnoux, 18-Dec-2016.)
theorem xdivpnfrp (A2: class):
  $ wi (wcel A2 crp) (wceq (co cpnf A2 cxdiv) cpnf) $;

--| Closure law for extended division of positive reals. (Contributed by Thierry Arnoux, 18-Dec-2016.)
theorem rpxdivcld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wcel (co A2 B2 cxdiv) crp) $;

--| Closure law for extended division of positive extended reals. (Contributed by Thierry Arnoux, 18-Dec-2016.)
theorem xrpxdivcld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 (co cc0 cpnf cicc)) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wcel (co A2 B2 cxdiv) (co cc0 cpnf cicc)) $;

--| Condition for the restriction of a word to be a word itself. (Contributed by Thierry Arnoux, 5-Oct-2018.)
theorem wrdres (S N W: class):
  $ wi (wa (wcel W (cword S)) (wcel N (co cc0 (cfv W chash) cfz))) (wcel (cres W (co cc0 N cfzo)) (cword S)) $;

--| Existence of a split of a word at a given index. (Contributed by Thierry Arnoux, 11-Oct-2018.) (Proof shortened by AV, 3-Nov-2022.)
theorem wrdsplex {v: setvar} (S N W: class):
  $ wi (wa (wcel W (cword S)) (wcel N (co cc0 (cfv W chash) cfz))) (wrex v (wceq W (co (cres W (co cc0 N cfzo)) (cv v) cconcat)) (cword S)) $;

--| A word has finite support. (Contributed by Thierry Arnoux, 27-May-2025.)
theorem wrdfsupp (ph: wff) (S V W Z: class):
  $ wi ph (wcel Z V) $ >
  $ wi ph (wcel W (cword S)) $ >
  $ wi ph (wbr W Z cfsupp) $;

--| Closure of a word with permuted symbols. (Contributed by Thierry Arnoux, 27-May-2025.)
theorem wrdpmcl (ph: wff) (S E J W: class):
  $ wceq J (co cc0 (cfv W chash) cfzo) $ >
  $ wi ph (wf1o J J E) $ >
  $ wi ph (wcel W (cword S)) $ >
  $ wi ph (wcel (ccom W E) (cword S)) $;

--| The prefix of length 1 of a length 2 word. (Contributed by Thierry Arnoux, 19-Sep-2023.)
theorem pfx1s2 (A2 B2 V: class):
  $ wi (wa (wcel A2 V) (wcel B2 V)) (wceq (co (cs2 A2 B2) c1 cpfx) (cs1 A2)) $;

--| The range of a prefix of a word is a subset of the range of that word. Stronger version of ~ pfxrn . (Contributed by Thierry Arnoux, 12-Dec-2023.)
theorem pfxrn2 (S L W: class):
  $ wi (wa (wcel W (cword S)) (wcel L (co cc0 (cfv W chash) cfz))) (wss (crn (co W L cpfx)) (crn W)) $;

--| Express the range of a prefix of a word. Stronger version of ~ pfxrn2 . (Contributed by Thierry Arnoux, 13-Dec-2023.)
theorem pfxrn3 (S L W: class):
  $ wi (wa (wcel W (cword S)) (wcel L (co cc0 (cfv W chash) cfz))) (wceq (crn (co W L cpfx)) (cima W (co cc0 L cfzo))) $;

--| Condition for a prefix to be injective. (Contributed by Thierry Arnoux, 13-Dec-2023.)
theorem pfxf1 (ph: wff) (S L W: class):
  $ wi ph (wcel W (cword S)) $ >
  $ wi ph (wf1 (cdm W) S W) $ >
  $ wi ph (wcel L (co cc0 (cfv W chash) cfz)) $ >
  $ wi ph (wf1 (cdm (co W L cpfx)) S (co W L cpfx)) $;

--| Conditions for a length 2 string to be a one-to-one function. (Contributed by Thierry Arnoux, 19-Sep-2023.)
theorem s2f1 (ph: wff) (D I J: class):
  $ wi ph (wcel I D) $ >
  $ wi ph (wcel J D) $ >
  $ wi ph (wne I J) $ >
  $ wi ph (wf1 (cdm (cs2 I J)) D (cs2 I J)) $;

--| Conditions for a length 3 string to be a one-to-one function. (Contributed by Thierry Arnoux, 19-Sep-2023.)
theorem s3f1 (ph: wff) (D I J K: class):
  $ wi ph (wcel I D) $ >
  $ wi ph (wcel J D) $ >
  $ wi ph (wcel K D) $ >
  $ wi ph (wne I J) $ >
  $ wi ph (wne J K) $ >
  $ wi ph (wne K I) $ >
  $ wi ph (wf1 (cdm (cs3 I J K)) D (cs3 I J K)) $;

--| Closure of the words of length 3 in a preimage using the hash function. (Contributed by Thierry Arnoux, 27-Sep-2023.)
theorem s3clhash (I J K: class):
  $ wcel (cs3 I J K) (cima (ccnv chash) (csn c3)) $;

--| Reconstruct a word from its prefix and its last two symbols. (Contributed by Thierry Arnoux, 26-Sep-2023.)
theorem pfxlsw2ccat (N V W: class):
  $ wceq N (cfv W chash) $ >
  $ wi (wa (wcel W (cword V)) (wbr c2 N cle)) (wceq W (co (co W (co N c2 cmin) cpfx) (cs2 (cfv (co N c2 cmin) W) (cfv (co N c1 cmin) W)) cconcat)) $;

--| Conditions for the concatenation of a word and a singleton word to be bijective. (Contributed by Thierry Arnoux, 27-May-2025.)
theorem ccatws1f1o (ph: wff) (T J N: class):
  $ wceq N (cfv T chash) $ >
  $ wceq J (co cc0 (co N c1 caddc) cfzo) $ >
  $ wi ph (wf1o (co cc0 N cfzo) (co cc0 N cfzo) T) $ >
  $ wi ph (wf1o J J (co T (cs1 N) cconcat)) $;

--| Two ways to reorder symbols in a word ` W ` according to permutation ` T ` , and add a last symbol ` X ` . (Contributed by Thierry Arnoux, 27-May-2025.)
theorem ccatws1f1olast (ph: wff) (S T N W X: class):
  $ wceq N (cfv W chash) $ >
  $ wi ph (wcel W (cword S)) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wf1o (co cc0 N cfzo) (co cc0 N cfzo) T) $ >
  $ wi ph (wceq (ccom (co W (cs1 X) cconcat) (co T (cs1 N) cconcat)) (co (ccom W T) (cs1 X) cconcat)) $;

--| Perform an induction over the structure of a word of even length. (Contributed by Thierry Arnoux, 26-Sep-2023.)
theorem wrdt2ind {x3 y1 i j: setvar} (ph: wff x3) (ps: wff x3 y1 i j) (ch th ta: wff y1 i j) (A2: class y1 j) (B2: class):
  $ wi (wceq (cv x3) c0) (wb ph ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ch) $ >
  $ wi (wceq (cv x3) (co (cv y1) (cs2 (cv i) (cv j)) cconcat)) (wb ph th) $ >
  $ wi (wceq (cv x3) A2) (wb ph ta) $ >
  $ ps $ >
  $ wi (w3a (wcel (cv y1) (cword B2)) (wcel (cv i) B2) (wcel (cv j) B2)) (wi ch th) $ >
  $ wi (wa (wcel A2 (cword B2)) (wbr c2 (cfv A2 chash) cdvds)) ta $;

--| The range of a subword is a subset of the range of that word. Stronger version of ~ swrdrn . (Contributed by Thierry Arnoux, 12-Dec-2023.)
theorem swrdrn2 (M N V W: class):
  $ wi (w3a (wcel W (cword V)) (wcel M (co cc0 N cfz)) (wcel N (co cc0 (cfv W chash) cfz))) (wss (crn (co W (cop M N) csubstr)) (crn W)) $;

--| Condition for the range of two subwords of an injective word to be disjoint. (Contributed by Thierry Arnoux, 13-Dec-2023.)
theorem swrdrndisj (ph: wff) (D P M N O W: class):
  $ wi ph (wcel W (cword D)) $ >
  $ wi ph (wcel M (co cc0 N cfz)) $ >
  $ wi ph (wcel N (co cc0 (cfv W chash) cfz)) $ >
  $ wi ph (wf1 (cdm W) D W) $ >
  $ wi ph (wcel O (co N P cfz)) $ >
  $ wi ph (wcel P (co N (cfv W chash) cfz)) $ >
  $ wi ph (wceq (cin (crn (co W (cop M N) csubstr)) (crn (co W (cop O P) csubstr))) c0) $;

--| Symbols to the right of a splice are unaffected. (Contributed by Thierry Arnoux, 14-Dec-2023.)
theorem splfv3 (ph: wff) (A2 R S T F K X: class):
  $ wi ph (wcel S (cword A2)) $ >
  $ wi ph (wcel F (co cc0 T cfz)) $ >
  $ wi ph (wcel T (co cc0 (cfv S chash) cfz)) $ >
  $ wi ph (wcel R (cword A2)) $ >
  $ wi ph (wcel X (co cc0 (co (cfv S chash) T cmin) cfzo)) $ >
  $ wi ph (wceq K (co F (cfv R chash) caddc)) $ >
  $ wi ph (wceq (cfv (co X K caddc) (co S (cotp F T R) csplice)) (cfv (co X T caddc) S)) $;

--| Cyclically shifting a single letter word keeps it unchanged. (Contributed by Thierry Arnoux, 21-Nov-2023.)
theorem _1cshid (N V W: class):
  $ wi (w3a (wcel W (cword V)) (wcel N cz) (wceq (cfv W chash) c1)) (wceq (co W N ccsh) W) $;

--| Cyclically shifting a length 2 word swaps its symbols. (Contributed by Thierry Arnoux, 19-Sep-2023.)
theorem cshw1s2 (A2 B2 V: class):
  $ wi (wa (wcel A2 V) (wcel B2 V)) (wceq (co (cs2 A2 B2) c1 ccsh) (cs2 B2 A2)) $;

--| Cyclically shifting a word preserves its range. (Contributed by Thierry Arnoux, 19-Sep-2023.)
theorem cshwrnid (N V W: class):
  $ wi (wa (wcel W (cword V)) (wcel N cz)) (wceq (crn (co W N ccsh)) (crn W)) $;

--| Condition for the cyclic shift to be a bijection. (Contributed by Thierry Arnoux, 4-Oct-2023.)
theorem cshf1o (D N W: class):
  $ wi (w3a (wcel W (cword D)) (wf1 (cdm W) D W) (wcel N cz)) (wf1o (cdm W) (crn W) (co W N ccsh)) $;

--| The group operation function ` +f ` of a structure's restriction is the operation function's restriction to the new base. (Contributed by Thierry Arnoux, 26-Mar-2017.)
theorem ressplusf (A2 B2 c_pd G H: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq H (co G A2 cress) $ >
  $ wceq c_pd (cfv G cplusg) $ >
  $ wfn c_pd (cxp B2 B2) $ >
  $ wss A2 B2 $ >
  $ wceq (cfv H cplusf) (cres c_pd (cxp A2 A2)) $;

--| The norm in a restricted structure. (Contributed by Thierry Arnoux, 8-Oct-2017.)
theorem ressnm (A2 B2 G H N c_0: class):
  $ wceq H (co G A2 cress) $ >
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wceq N (cfv G cnm) $ >
  $ wi (w3a (wcel G cmnd) (wcel c_0 A2) (wss A2 B2)) (wceq (cres N A2) (cfv H cnm)) $;

--| Weaker version of ~ abvpropd . (Contributed by Thierry Arnoux, 8-Nov-2017.)
theorem abvpropd2 (ph: wff) (K L: class):
  $ wi ph (wceq (cfv K cbs) (cfv L cbs)) $ >
  $ wi ph (wceq (cfv K cplusg) (cfv L cplusg)) $ >
  $ wi ph (wceq (cfv K cmulr) (cfv L cmulr)) $ >
  $ wi ph (wceq (cfv K cabv) (cfv L cabv)) $;

--| The restriction of a proset is a proset. (Contributed by Thierry Arnoux, 11-Sep-2015.)
theorem ressprs (A2 B2 K: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wi (wa (wcel K cproset) (wss A2 B2)) (wcel (co K A2 cress) cproset) $;

--| A poset ordering is asymmetric. (Contributed by Thierry Arnoux, 13-Sep-2018.)
theorem posrasymb (B2 K c_le X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cin (cfv K cple) (cxp B2 B2)) $ >
  $ wi (w3a (wcel K cpo) (wcel X B2) (wcel Y B2)) (wb (wa (wbr X Y c_le) (wbr Y X c_le)) (wceq X Y)) $;

--| Being a toset is a self-dual property. (Contributed by Thierry Arnoux, 13-Sep-2018.)
theorem odutos (D K: class):
  $ wceq D (cfv K codu) $ >
  $ wi (wcel K ctos) (wcel D ctos) $;

--| In a Toset, two elements must compare. (Contributed by Thierry Arnoux, 13-Apr-2018.)
theorem tlt2 (B2 c_lt K c_le X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wi (w3a (wcel K ctos) (wcel X B2) (wcel Y B2)) (wo (wbr X Y c_le) (wbr Y X c_lt)) $;

--| In a Toset, two elements must compare strictly, or be equal. (Contributed by Thierry Arnoux, 13-Apr-2018.)
theorem tlt3 (B2 c_lt K X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wi (w3a (wcel K ctos) (wcel X B2) (wcel Y B2)) (w3o (wceq X Y) (wbr X Y c_lt) (wbr Y X c_lt)) $;

--| In a Toset, two elements must compare. (Contributed by Thierry Arnoux, 12-Sep-2018.)
theorem trleile (B2 K c_le X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cin (cfv K cple) (cxp B2 B2)) $ >
  $ wi (w3a (wcel K ctos) (wcel X B2) (wcel Y B2)) (wo (wbr X Y c_le) (wbr Y X c_le)) $;

--| Lemma for ~ toslub and ~ xrsclat . (Contributed by Thierry Arnoux, 17-Feb-2018.) (Revised by NM, 15-Sep-2018.)
theorem toslublem {b c d: setvar} (ph: wff d) (A2 B2 c_lt: class) (K: class d) (c_le: class b c d) (a: setvar):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wi ph (wcel K ctos) $ >
  $ wi ph (wss A2 B2) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wi (wa ph (wcel (cv a) B2)) (wb (wa (wral b (wbr (cv b) (cv a) c_le) A2) (wral c (wi (wral b (wbr (cv b) (cv c) c_le) A2) (wbr (cv a) (cv c) c_le)) B2)) (wa (wral b (wn (wbr (cv a) (cv b) c_lt)) A2) (wral b (wi (wbr (cv b) (cv a) c_lt) (wrex d (wbr (cv b) (cv d) c_lt) A2)) B2))) $;

--| In a toset, the lowest upper bound ` lub ` , defined for partial orders is the supremum, ` sup ( A , B , .< ) ` , defined for total orders. (these are the set.mm definitions: lowest upper bound and supremum are normally synonymous). Note that those two values are also equal if such a supremum does not exist: in that case, both are equal to the empty set. (Contributed by Thierry Arnoux, 15-Feb-2018.) (Revised by Thierry Arnoux, 24-Sep-2018.)
theorem toslub (ph: wff) (A2 B2 c_lt K: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wi ph (wcel K ctos) $ >
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wceq (cfv A2 (cfv K club)) (csup A2 B2 c_lt)) $;

--| Lemma for ~ tosglb and ~ xrsclat . (Contributed by Thierry Arnoux, 17-Feb-2018.) (Revised by NM, 15-Sep-2018.)
theorem tosglblem {a b c d: setvar} (ph: wff d) (A2 B2 c_lt: class) (K: class d) (c_le: class a b c d):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wi ph (wcel K ctos) $ >
  $ wi ph (wss A2 B2) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wi (wa ph (wcel (cv a) B2)) (wb (wa (wral b (wbr (cv a) (cv b) c_le) A2) (wral c (wi (wral b (wbr (cv c) (cv b) c_le) A2) (wbr (cv c) (cv a) c_le)) B2)) (wa (wral b (wn (wbr (cv a) (cv b) (ccnv c_lt))) A2) (wral b (wi (wbr (cv b) (cv a) (ccnv c_lt)) (wrex d (wbr (cv b) (cv d) (ccnv c_lt)) A2)) B2))) $;

--| Same theorem as ~ toslub , for infinimum. (Contributed by Thierry Arnoux, 17-Feb-2018.) (Revised by AV, 28-Sep-2020.)
theorem tosglb (ph: wff) (A2 B2 c_lt K: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wi ph (wcel K ctos) $ >
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wceq (cfv A2 (cfv K cglb)) (cinf A2 B2 c_lt)) $;

--| The poset zero of a complete lattice belongs to its base. (Contributed by Thierry Arnoux, 17-Feb-2018.)
theorem clatp0cl (B2 W c_0: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_0 (cfv W cp0) $ >
  $ wi (wcel W ccla) (wcel c_0 B2) $;

--| The poset one of a complete lattice belongs to its base. (Contributed by Thierry Arnoux, 17-Feb-2018.)
theorem clatp1cl (B2 c_1 W: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_1 (cfv W cp1) $ >
  $ wi (wcel W ccla) (wcel c_1 B2) $;

--| Extend class notation with monotone functions.
term cmnt: class;

--| Extend class notation with the monotone Galois connection.
term cmgc: class;

--| Define a monotone function between two ordered sets. (Contributed by Thierry Arnoux, 20-Apr-2024.)
axiom df_mnt {x3 y1 w v f2 a: setvar}:
  $ wceq cmnt (cmpo v w cvv cvv (csb a (cfv (cv v) cbs) (crab f2 (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) (cfv (cv v) cple)) (wbr (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) (cfv (cv w) cple))) (cv a)) (cv a)) (co (cfv (cv w) cbs) (cv a) cmap)))) $;

--| Define monotone Galois connections. See ~ mgcval for an expanded version. (Contributed by Thierry Arnoux, 20-Apr-2024.)
axiom df_mgc {x3 y1 w v f2 g2 a b: setvar}:
  $ wceq cmgc (cmpo v w cvv cvv (csb a (cfv (cv v) cbs) (csb b (cfv (cv w) cbs) (copab f2 g2 (wa (wa (wcel (cv f2) (co (cv b) (cv a) cmap)) (wcel (cv g2) (co (cv a) (cv b) cmap))) (wral x3 (wral y1 (wb (wbr (cfv (cv x3) (cv f2)) (cv y1) (cfv (cv w) cple)) (wbr (cv x3) (cfv (cv y1) (cv g2)) (cfv (cv v) cple))) (cv b)) (cv a))))))) $;

--| Operation value of the monotone function. (Contributed by Thierry Arnoux, 23-Apr-2024.)
theorem mntoval {x3 y1 f2: setvar} (A2: class) (B2: class x3 y1) (c_le: class x3 y1 f2) (V W: class) (X Y c_le2: class x3 y1 f2):
  $ wceq A2 (cfv V cbs) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_le (cfv V cple) $ >
  $ wceq c_le2 (cfv W cple) $ >
  $ wi (wa (wcel V X) (wcel W Y)) (wceq (co V W cmnt) (crab f2 (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) c_le) (wbr (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)) c_le2)) A2) A2) (co B2 A2 cmap))) $;

--| Express the statement " ` F ` is monotone". (Contributed by Thierry Arnoux, 23-Apr-2024.)
theorem ismnt {x3 y1: setvar} (A2: class) (B2: class x3 y1) (F: class) (c_le: class x3 y1) (V W: class) (X Y c_le2: class x3 y1):
  $ wceq A2 (cfv V cbs) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_le (cfv V cple) $ >
  $ wceq c_le2 (cfv W cple) $ >
  $ wi (wa (wcel V X) (wcel W Y)) (wb (wcel F (co V W cmnt)) (wa (wf A2 B2 F) (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) c_le) (wbr (cfv (cv x3) F) (cfv (cv y1) F) c_le2)) A2) A2))) $;

--| Property of being a monotone increasing function, deduction version. (Contributed by Thierry Arnoux, 24-Apr-2024.)
theorem ismntd (ph: wff) (A2 B2 C D F c_le V W X Y c_le2: class):
  $ wceq A2 (cfv V cbs) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_le (cfv V cple) $ >
  $ wceq c_le2 (cfv W cple) $ >
  $ wi ph (wcel V C) $ >
  $ wi ph (wcel W D) $ >
  $ wi ph (wcel F (co V W cmnt)) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y A2) $ >
  $ wi ph (wbr X Y c_le) $ >
  $ wi ph (wbr (cfv X F) (cfv Y F) c_le2) $;

--| A monotone function is a function. (Contributed by Thierry Arnoux, 24-Apr-2024.)
theorem mntf (A2 B2 F V W X Y: class):
  $ wceq A2 (cfv V cbs) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wi (w3a (wcel V X) (wcel W Y) (wcel F (co V W cmnt))) (wf A2 B2 F) $;

--| Operation value of the monotone Galois connection. (Contributed by Thierry Arnoux, 23-Apr-2024.)
theorem mgcoval {x3 y1 f2 g2: setvar} (A2 B2: class) (c_le: class x3 y1 f2 g2) (V W X Y: class) (c_le2: class x3 y1 f2 g2):
  $ wceq A2 (cfv V cbs) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_le (cfv V cple) $ >
  $ wceq c_le2 (cfv W cple) $ >
  $ wi (wa (wcel V X) (wcel W Y)) (wceq (co V W cmgc) (copab f2 g2 (wa (wa (wcel (cv f2) (co B2 A2 cmap)) (wcel (cv g2) (co A2 B2 cmap))) (wral x3 (wral y1 (wb (wbr (cfv (cv x3) (cv f2)) (cv y1) c_le2) (wbr (cv x3) (cfv (cv y1) (cv g2)) c_le)) B2) A2)))) $;

--| Monotone Galois connection between two functions ` F ` and ` G ` . If this relation is satisfied, ` F ` is called the lower adjoint of ` G ` , and ` G ` is called the upper adjoint of ` F ` . Technically, this is implemented as an operation taking a pair of structures ` V ` and ` W ` , expected to be posets, which gives a relation between pairs of functions ` F ` and ` G ` . If such a relation exists, it can be proven to be unique. Galois connections generalize the fundamental theorem of Galois theory about the correspondence between subgroups and subfields. (Contributed by Thierry Arnoux, 23-Apr-2024.)
theorem mgcval {x3 y1: setvar} (ph: wff x3 y1) (A2 B2 F G: class) (H c_le: class x3 y1) (V W: class) (c_le2: class x3 y1):
  $ wceq A2 (cfv V cbs) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_le (cfv V cple) $ >
  $ wceq c_le2 (cfv W cple) $ >
  $ wceq H (co V W cmgc) $ >
  $ wi ph (wcel V cproset) $ >
  $ wi ph (wcel W cproset) $ >
  $ wi ph (wb (wbr F G H) (wa (wa (wf A2 B2 F) (wf B2 A2 G)) (wral x3 (wral y1 (wb (wbr (cfv (cv x3) F) (cv y1) c_le2) (wbr (cv x3) (cfv (cv y1) G) c_le)) B2) A2))) $;

--| The lower adjoint ` F ` of a Galois connection is a function. (Contributed by Thierry Arnoux, 24-Apr-2024.)
theorem mgcf1 (ph: wff) (A2 B2 F G H c_le V W c_le2: class):
  $ wceq A2 (cfv V cbs) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_le (cfv V cple) $ >
  $ wceq c_le2 (cfv W cple) $ >
  $ wceq H (co V W cmgc) $ >
  $ wi ph (wcel V cproset) $ >
  $ wi ph (wcel W cproset) $ >
  $ wi ph (wbr F G H) $ >
  $ wi ph (wf A2 B2 F) $;

--| The upper adjoint ` G ` of a Galois connection is a function. (Contributed by Thierry Arnoux, 24-Apr-2024.)
theorem mgcf2 (ph: wff) (A2 B2 F G H c_le V W c_le2: class):
  $ wceq A2 (cfv V cbs) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_le (cfv V cple) $ >
  $ wceq c_le2 (cfv W cple) $ >
  $ wceq H (co V W cmgc) $ >
  $ wi ph (wcel V cproset) $ >
  $ wi ph (wcel W cproset) $ >
  $ wi ph (wbr F G H) $ >
  $ wi ph (wf B2 A2 G) $;

--| An inequality for the kernel operator ` G o. F ` . (Contributed by Thierry Arnoux, 26-Apr-2024.)
theorem mgccole1 (ph: wff) (A2 B2 F G H c_le V W X c_le2: class):
  $ wceq A2 (cfv V cbs) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_le (cfv V cple) $ >
  $ wceq c_le2 (cfv W cple) $ >
  $ wceq H (co V W cmgc) $ >
  $ wi ph (wcel V cproset) $ >
  $ wi ph (wcel W cproset) $ >
  $ wi ph (wbr F G H) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wbr X (cfv (cfv X F) G) c_le) $;

--| Inequality for the closure operator ` ( F o. G ) ` of the Galois connection ` H ` . (Contributed by Thierry Arnoux, 26-Apr-2024.)
theorem mgccole2 (ph: wff) (A2 B2 F G H c_le V W Y c_le2: class):
  $ wceq A2 (cfv V cbs) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_le (cfv V cple) $ >
  $ wceq c_le2 (cfv W cple) $ >
  $ wceq H (co V W cmgc) $ >
  $ wi ph (wcel V cproset) $ >
  $ wi ph (wcel W cproset) $ >
  $ wi ph (wbr F G H) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wbr (cfv (cfv Y G) F) Y c_le2) $;

--| The lower adjoint ` F ` of a Galois connection is monotonically increasing. (Contributed by Thierry Arnoux, 26-Apr-2024.)
theorem mgcmnt1 (ph: wff) (A2 B2 F G H c_le V W X Y c_le2: class):
  $ wceq A2 (cfv V cbs) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_le (cfv V cple) $ >
  $ wceq c_le2 (cfv W cple) $ >
  $ wceq H (co V W cmgc) $ >
  $ wi ph (wcel V cproset) $ >
  $ wi ph (wcel W cproset) $ >
  $ wi ph (wbr F G H) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y A2) $ >
  $ wi ph (wbr X Y c_le) $ >
  $ wi ph (wbr (cfv X F) (cfv Y F) c_le2) $;

--| The upper adjoint ` G ` of a Galois connection is monotonically increasing. (Contributed by Thierry Arnoux, 26-Apr-2024.)
theorem mgcmnt2 (ph: wff) (A2 B2 F G H c_le V W X Y c_le2: class):
  $ wceq A2 (cfv V cbs) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_le (cfv V cple) $ >
  $ wceq c_le2 (cfv W cple) $ >
  $ wceq H (co V W cmgc) $ >
  $ wi ph (wcel V cproset) $ >
  $ wi ph (wcel W cproset) $ >
  $ wi ph (wbr F G H) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wbr X Y c_le2) $ >
  $ wi ph (wbr (cfv X G) (cfv Y G) c_le) $;

--| A Galois connection like statement, for two functions with same range. (Contributed by Thierry Arnoux, 26-Apr-2024.)
theorem mgcmntco {x3 y1: setvar} (ph: wff) (A2 B2: class) (C: class x3 y1) (c_lt F G: class) (H: class x3 y1) (K L: class) (c_le: class x3 y1) (V W X: class) (c_le2: class x3 y1):
  $ wceq A2 (cfv V cbs) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_le (cfv V cple) $ >
  $ wceq c_le2 (cfv W cple) $ >
  $ wceq H (co V W cmgc) $ >
  $ wi ph (wcel V cproset) $ >
  $ wi ph (wcel W cproset) $ >
  $ wi ph (wbr F G H) $ >
  $ wceq C (cfv X cbs) $ >
  $ wceq c_lt (cfv X cple) $ >
  $ wi ph (wcel X cproset) $ >
  $ wi ph (wcel K (co V X cmnt)) $ >
  $ wi ph (wcel L (co W X cmnt)) $ >
  $ wi ph (wb (wral x3 (wbr (cfv (cv x3) K) (cfv (cfv (cv x3) F) L) c_lt) A2) (wral y1 (wbr (cfv (cfv (cv y1) G) K) (cfv (cv y1) L) c_lt) B2)) $;

--| Lemma for dfmgc2, backwards direction. (Contributed by Thierry Arnoux, 26-Apr-2024.)
theorem dfmgc2lem {x3 y1 v u: setvar} (ph: wff y1 v) (A2 B2 F G: class) (H: class x3 y1 v u) (c_le: class) (V W: class u) (c_le2: class):
  $ wceq A2 (cfv V cbs) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_le (cfv V cple) $ >
  $ wceq c_le2 (cfv W cple) $ >
  $ wceq H (co V W cmgc) $ >
  $ wi ph (wcel V cproset) $ >
  $ wi ph (wcel W cproset) $ >
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wf B2 A2 G) $ >
  $ wi ph (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) c_le) (wbr (cfv (cv x3) F) (cfv (cv y1) F) c_le2)) A2) A2) $ >
  $ wi ph (wral u (wral v (wi (wbr (cv u) (cv v) c_le2) (wbr (cfv (cv u) G) (cfv (cv v) G) c_le)) B2) B2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wbr (cv x3) (cfv (cfv (cv x3) F) G) c_le) $ >
  $ wi (wa ph (wcel (cv u) B2)) (wbr (cfv (cfv (cv u) G) F) (cv u) c_le2) $ >
  $ wi ph (wbr F G H) $;

--| Alternate definition of the monotone Galois connection. (Contributed by Thierry Arnoux, 26-Apr-2024.)
theorem dfmgc2 {x3 y1 v u: setvar} (ph: wff) (A2: class u) (B2 F G H c_le: class) (V W: class u) (c_le2: class):
  $ wceq A2 (cfv V cbs) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_le (cfv V cple) $ >
  $ wceq c_le2 (cfv W cple) $ >
  $ wceq H (co V W cmgc) $ >
  $ wi ph (wcel V cproset) $ >
  $ wi ph (wcel W cproset) $ >
  $ wi ph (wb (wbr F G H) (wa (wa (wf A2 B2 F) (wf B2 A2 G)) (wa (wa (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) c_le) (wbr (cfv (cv x3) F) (cfv (cv y1) F) c_le2)) A2) A2) (wral u (wral v (wi (wbr (cv u) (cv v) c_le2) (wbr (cfv (cv u) G) (cfv (cv v) G) c_le)) B2) B2)) (wa (wral u (wbr (cfv (cfv (cv u) G) F) (cv u) c_le2) B2) (wral x3 (wbr (cv x3) (cfv (cfv (cv x3) F) G) c_le) A2))))) $;

--| Galois connection implies monotonicity of the left adjoint. (Contributed by Thierry Arnoux, 21-Jul-2024.)
theorem mgcmnt1d (ph: wff) (F G H V W: class):
  $ wceq H (co V W cmgc) $ >
  $ wi ph (wcel V cproset) $ >
  $ wi ph (wcel W cproset) $ >
  $ wi ph (wbr F G H) $ >
  $ wi ph (wcel F (co V W cmnt)) $;

--| Galois connection implies monotonicity of the right adjoint. (Contributed by Thierry Arnoux, 21-Jul-2024.)
theorem mgcmnt2d (ph: wff) (F G H V W: class):
  $ wceq H (co V W cmgc) $ >
  $ wi ph (wcel V cproset) $ >
  $ wi ph (wcel W cproset) $ >
  $ wi ph (wbr F G H) $ >
  $ wi ph (wcel G (co W V cmnt)) $;

--| The inverse Galois connection is the Galois connection of the dual orders. (Contributed by Thierry Arnoux, 26-Apr-2024.)
theorem mgccnv (F G H M V W: class):
  $ wceq H (co V W cmgc) $ >
  $ wceq M (co (cfv W codu) (cfv V codu) cmgc) $ >
  $ wi (wa (wcel V cproset) (wcel W cproset)) (wb (wbr F G H) (wbr G F M)) $;

--| Given a function ` F ` , exhibit a Galois connection between subsets of its domain and subsets of its range. (Contributed by Thierry Arnoux, 26-Apr-2024.)
theorem pwrssmgc {y1 m n: setvar} (ph: wff) (A2 B2: class y1 m n) (F: class) (G H: class y1 m n) (V W: class) (X: class y1) (Y: class):
  $ wceq G (cmpt n (cpw Y) (cima (ccnv F) (cv n))) $ >
  $ wceq H (cmpt m (cpw X) (crab y1 (wss (cima (ccnv F) (csn (cv y1))) (cv m)) Y)) $ >
  $ wceq V (cfv (cpw Y) cipo) $ >
  $ wceq W (cfv (cpw X) cipo) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wf X Y F) $ >
  $ wi ph (wbr G H (co V W cmgc)) $;

--| Property of a Galois connection, lemma for ~ mgcf1o . (Contributed by Thierry Arnoux, 26-Jul-2024.)
theorem mgcf1olem1 (ph: wff) (A2 B2 F G H c_le V W X c_le2: class):
  $ wceq H (co V W cmgc) $ >
  $ wceq A2 (cfv V cbs) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_le (cfv V cple) $ >
  $ wceq c_le2 (cfv W cple) $ >
  $ wi ph (wcel V cpo) $ >
  $ wi ph (wcel W cpo) $ >
  $ wi ph (wbr F G H) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wceq (cfv (cfv (cfv X F) G) F) (cfv X F)) $;

--| Property of a Galois connection, lemma for ~ mgcf1o . (Contributed by Thierry Arnoux, 26-Jul-2024.)
theorem mgcf1olem2 (ph: wff) (A2 B2 F G H c_le V W Y c_le2: class):
  $ wceq H (co V W cmgc) $ >
  $ wceq A2 (cfv V cbs) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_le (cfv V cple) $ >
  $ wceq c_le2 (cfv W cple) $ >
  $ wi ph (wcel V cpo) $ >
  $ wi ph (wcel W cpo) $ >
  $ wi ph (wbr F G H) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (cfv (cfv (cfv Y G) F) G) (cfv Y G)) $;

--| Given a Galois connection, exhibit an order isomorphism. (Contributed by Thierry Arnoux, 26-Jul-2024.)
theorem mgcf1o (ph: wff) (A2 B2 F G H c_le V W c_le2: class):
  $ wceq H (co V W cmgc) $ >
  $ wceq A2 (cfv V cbs) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_le (cfv V cple) $ >
  $ wceq c_le2 (cfv W cple) $ >
  $ wi ph (wcel V cpo) $ >
  $ wi ph (wcel W cpo) $ >
  $ wi ph (wbr F G H) $ >
  $ wi ph (wiso (crn G) (crn F) c_le c_le2 (cres F (crn G))) $;

--| Assume the scalar component of the extended real structure is the field of the real numbers (this has to be defined in the main body of set.mm). (Contributed by Thierry Arnoux, 22-Oct-2017.)
axiom ax_xrssca:
  $ wceq crefld (cfv cxrs csca) $;

--| Assume the scalar product of the extended real structure is the extended real number multiplication operation (this has to be defined in the main body of set.mm). (Contributed by Thierry Arnoux, 22-Oct-2017.)
axiom ax_xrsvsca:
  $ wceq cxmu (cfv cxrs cvsca) $;

--| The zero of the extended real numbers. The extended real is not a group, as its addition is not associative. (cf. ~ xaddass and ~ df-xrs ), however it has a zero. (Contributed by Thierry Arnoux, 13-Jun-2017.)
theorem xrs0:
  $ wceq cc0 (cfv cxrs c0g) $;

--| The "strictly less than" relation for the extended real structure. (Contributed by Thierry Arnoux, 30-Jan-2018.)
theorem xrslt:
  $ wceq clt (cfv cxrs cplt) $;

--| The inversion operation in the extended real numbers. The extended real is not a group, as its addition is not associative. (cf. ~ xaddass and ~ df-xrs ), however it has an inversion operation. (Contributed by Thierry Arnoux, 13-Jun-2017.)
theorem xrsinvgval (B2: class):
  $ wi (wcel B2 cxr) (wceq (cfv B2 (cfv cxrs cminusg)) (cxne B2)) $;

--| The "multiple" function in the extended real numbers structure. (Contributed by Thierry Arnoux, 14-Jun-2017.)
theorem xrsmulgzz (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cxr)) (wceq (co A2 B2 (cfv cxrs cmg)) (co A2 B2 cxmu)) $;

--| The extended real numbers form a toset. (Contributed by Thierry Arnoux, 15-Feb-2018.)
theorem xrstos:
  $ wcel cxrs ctos $;

--| The extended real numbers form a complete lattice. (Contributed by Thierry Arnoux, 15-Feb-2018.)
theorem xrsclat:
  $ wcel cxrs ccla $;

--| The poset 0 of the extended real numbers is minus infinity. (Contributed by Thierry Arnoux, 18-Feb-2018.) (Proof shortened by AV, 28-Sep-2020.)
theorem xrsp0:
  $ wceq cmnf (cfv cxrs cp0) $;

--| The poset 1 of the extended real numbers is plus infinity. (Contributed by Thierry Arnoux, 18-Feb-2018.)
theorem xrsp1:
  $ wceq cpnf (cfv cxrs cp1) $;

--| The zero of the extended nonnegative real numbers monoid. (Contributed by Thierry Arnoux, 30-Jan-2017.)
theorem xrge00:
  $ wceq cc0 (cfv (co cxrs (co cc0 cpnf cicc) cress) c0g) $;

--| The group multiple function in the extended nonnegative real numbers. (Contributed by Thierry Arnoux, 14-Jun-2017.)
theorem xrge0mulgnn0 (A2 B2: class):
  $ wi (wa (wcel A2 cn0) (wcel B2 (co cc0 cpnf cicc))) (wceq (co A2 B2 (cfv (co cxrs (co cc0 cpnf cicc) cress) cmg)) (co A2 B2 cxmu)) $;

--| Associativity of extended nonnegative real addition. (Contributed by Thierry Arnoux, 8-Jun-2017.)
theorem xrge0addass (A2 B2 C: class):
  $ wi (w3a (wcel A2 (co cc0 cpnf cicc)) (wcel B2 (co cc0 cpnf cicc)) (wcel C (co cc0 cpnf cicc))) (wceq (co (co A2 B2 cxad) C cxad) (co A2 (co B2 C cxad) cxad)) $;

--| The sum of nonnegative and positive numbers is positive. See ~ addgtge0 . (Contributed by Thierry Arnoux, 6-Jul-2017.)
theorem xrge0addgt0 (A2 B2: class):
  $ wi (wa (wa (wcel A2 (co cc0 cpnf cicc)) (wcel B2 (co cc0 cpnf cicc))) (wbr cc0 A2 clt)) (wbr cc0 (co A2 B2 cxad) clt) $;

--| Right-distributivity of extended nonnegative real multiplication over addition. (Contributed by Thierry Arnoux, 30-Jun-2017.)
theorem xrge0adddir (A2 B2 C: class):
  $ wi (w3a (wcel A2 (co cc0 cpnf cicc)) (wcel B2 (co cc0 cpnf cicc)) (wcel C (co cc0 cpnf cicc))) (wceq (co (co A2 B2 cxad) C cxmu) (co (co A2 C cxmu) (co B2 C cxmu) cxad)) $;

--| Left-distributivity of extended nonnegative real multiplication over addition. (Contributed by Thierry Arnoux, 6-Sep-2018.)
theorem xrge0adddi (A2 B2 C: class):
  $ wi (w3a (wcel A2 (co cc0 cpnf cicc)) (wcel B2 (co cc0 cpnf cicc)) (wcel C (co cc0 cpnf cicc))) (wceq (co C (co A2 B2 cxad) cxmu) (co (co C A2 cxmu) (co C B2 cxmu) cxad)) $;

--| Extended nonnegative real version of ~ npcan . (Contributed by Thierry Arnoux, 9-Jun-2017.)
theorem xrge0npcan (A2 B2: class):
  $ wi (w3a (wcel A2 (co cc0 cpnf cicc)) (wcel B2 (co cc0 cpnf cicc)) (wbr B2 A2 cle)) (wceq (co (co A2 (cxne B2) cxad) B2 cxad) A2) $;

--| Closure of a finite sum of nonnegative reals. (Contributed by Thierry Arnoux, 25-Jun-2017.)
theorem fsumrp0cl {k: setvar} (ph: wff) (A2: class) (B2: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 (co cc0 cpnf cico)) $ >
  $ wi ph (wcel (csu k A2 B2) (co cc0 cpnf cico)) $;

--| Closure of the operation of a monoid. (Contributed by Thierry Arnoux, 3-Aug-2025.)
theorem mndcld (ph: wff) (B2 c_pl G X Y: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_pl (cfv G cplusg) $ >
  $ wi ph (wcel G cmnd) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel (co X Y c_pl) B2) $;

--| A monoid operation is associative. (Contributed by Thierry Arnoux, 3-Aug-2025.)
theorem mndassd (ph: wff) (B2 c_pl G X Y Z: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_pl (cfv G cplusg) $ >
  $ wi ph (wcel G cmnd) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wceq (co (co X Y c_pl) Z c_pl) (co X (co Y Z c_pl) c_pl)) $;

--| In a monoid, if an element ` X ` has both a left inverse ` M ` and a right inverse ` N ` , they are equal. (Contributed by Thierry Arnoux, 3-Aug-2025.)
theorem mndlrinv (ph: wff) (B2 c_pl E M N X c_0: class):
  $ wceq B2 (cfv E cbs) $ >
  $ wceq c_0 (cfv E c0g) $ >
  $ wceq c_pl (cfv E cplusg) $ >
  $ wi ph (wcel E cmnd) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel M B2) $ >
  $ wi ph (wcel N B2) $ >
  $ wi ph (wceq (co M X c_pl) c_0) $ >
  $ wi ph (wceq (co X N c_pl) c_0) $ >
  $ wi ph (wceq M N) $;

--| In a monoid, if an element has both a left-inverse and a right-inverse, they are equal. (Contributed by Thierry Arnoux, 3-Aug-2025.)
theorem mndlrinvb {y1 v u: setvar} (ph: wff) (B2 c_pl: class) (E: class y1 v u) (X c_0: class):
  $ wceq B2 (cfv E cbs) $ >
  $ wceq c_0 (cfv E c0g) $ >
  $ wceq c_pl (cfv E cplusg) $ >
  $ wi ph (wcel E cmnd) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wb (wa (wrex u (wceq (co X (cv u) c_pl) c_0) B2) (wrex v (wceq (co (cv v) X c_pl) c_0) B2)) (wrex y1 (wa (wceq (co X (cv y1) c_pl) c_0) (wceq (co (cv y1) X c_pl) c_0)) B2)) $;

--| If an element ` X ` of a monoid ` E ` is right-invertible, with inverse ` Y ` , then its left-translation ` F ` is injective. See also ~ grplactf1o . Remark in chapter I. of [BourbakiAlg1] p. 17 . (Contributed by Thierry Arnoux, 3-Aug-2025.)
theorem mndlactf1 {a: setvar} (ph: wff) (B2 c_pl: class) (E: class a) (F X: class) (Y: class a) (c_0: class):
  $ wceq B2 (cfv E cbs) $ >
  $ wceq c_0 (cfv E c0g) $ >
  $ wceq c_pl (cfv E cplusg) $ >
  $ wceq F (cmpt a B2 (co X (cv a) c_pl)) $ >
  $ wi ph (wcel E cmnd) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (co Y X c_pl) c_0) $ >
  $ wi ph (wf1 B2 B2 F) $;

--| An element ` X ` of a monoid ` E ` is left-invertible iff its left-translation ` F ` is surjective. See also ~ grplactf1o . (Contributed by Thierry Arnoux, 3-Aug-2025.)
theorem mndlactfo {y1 a: setvar} (ph: wff) (B2 c_pl: class) (E: class y1 a) (F X c_0: class):
  $ wceq B2 (cfv E cbs) $ >
  $ wceq c_0 (cfv E c0g) $ >
  $ wceq c_pl (cfv E cplusg) $ >
  $ wceq F (cmpt a B2 (co X (cv a) c_pl)) $ >
  $ wi ph (wcel E cmnd) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wb (wfo B2 B2 F) (wrex y1 (wceq (co X (cv y1) c_pl) c_0) B2)) $;

--| If an element ` X ` of a monoid ` E ` is right-invertible, with inverse ` Y ` , then its left-translation ` G ` is injective. See also ~ grplactf1o . Remark in chapter I. of [BourbakiAlg1] p. 17 . (Contributed by Thierry Arnoux, 3-Aug-2025.)
theorem mndractf1 {a: setvar} (ph: wff) (B2 c_pl: class) (E: class a) (G X: class) (Y: class a) (c_0: class):
  $ wceq B2 (cfv E cbs) $ >
  $ wceq c_0 (cfv E c0g) $ >
  $ wceq c_pl (cfv E cplusg) $ >
  $ wceq G (cmpt a B2 (co (cv a) X c_pl)) $ >
  $ wi ph (wcel E cmnd) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (co X Y c_pl) c_0) $ >
  $ wi ph (wf1 B2 B2 G) $;

--| An element ` X ` of a monoid ` E ` is right-invertible iff its right-translation ` G ` is surjective. (Contributed by Thierry Arnoux, 3-Aug-2025.)
theorem mndractfo {y1 a: setvar} (ph: wff) (B2: class) (c_pl: class y1) (E: class y1 a) (G: class) (X: class y1) (c_0: class):
  $ wceq B2 (cfv E cbs) $ >
  $ wceq c_0 (cfv E c0g) $ >
  $ wceq c_pl (cfv E cplusg) $ >
  $ wceq G (cmpt a B2 (co (cv a) X c_pl)) $ >
  $ wi ph (wcel E cmnd) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wb (wfo B2 B2 G) (wrex y1 (wceq (co (cv y1) X c_pl) c_0) B2)) $;

--| An element ` X ` of a monoid ` E ` is invertible iff its left-translation ` F ` is bijective. See also ~ grplactf1o . Remark in chapter I. of [BourbakiAlg1] p. 17. (Contributed by Thierry Arnoux, 3-Aug-2025.)
theorem mndlactf1o {y1 a: setvar} (ph: wff) (B2 c_pl: class) (E: class y1 a) (F X c_0: class):
  $ wceq B2 (cfv E cbs) $ >
  $ wceq c_0 (cfv E c0g) $ >
  $ wceq c_pl (cfv E cplusg) $ >
  $ wceq F (cmpt a B2 (co X (cv a) c_pl)) $ >
  $ wi ph (wcel E cmnd) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wb (wf1o B2 B2 F) (wrex y1 (wa (wceq (co X (cv y1) c_pl) c_0) (wceq (co (cv y1) X c_pl) c_0)) B2)) $;

--| An element ` X ` of a monoid ` E ` is invertible iff its right-translation ` G ` is bijective. See also ~ mndlactf1o . Remark in chapter I. of [BourbakiAlg1] p. 17 . (Contributed by Thierry Arnoux, 3-Aug-2025.)
theorem mndractf1o {y1 a: setvar} (ph: wff) (B2 c_pl: class) (E: class y1 a) (G X c_0: class):
  $ wceq B2 (cfv E cbs) $ >
  $ wceq c_0 (cfv E c0g) $ >
  $ wceq c_pl (cfv E cplusg) $ >
  $ wceq G (cmpt a B2 (co (cv a) X c_pl)) $ >
  $ wi ph (wcel E cmnd) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wb (wf1o B2 B2 G) (wrex y1 (wa (wceq (co X (cv y1) c_pl) c_0) (wceq (co (cv y1) X c_pl) c_0)) B2)) $;

--| Commutative/associative law for commutative monoids. (Contributed by Thierry Arnoux, 4-May-2025.)
theorem cmn4d (ph: wff) (B2 c_pl G W X Y Z: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_pl (cfv G cplusg) $ >
  $ wi ph (wcel G ccmn) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wcel W B2) $ >
  $ wi ph (wceq (co (co X Y c_pl) (co Z W c_pl) c_pl) (co (co X Z c_pl) (co Y W c_pl) c_pl)) $;

--| Rearrange terms in a commutative monoid sum. Lemma for ~ rlocaddval . (Contributed by Thierry Arnoux, 4-May-2025.)
theorem cmn246135 (ph: wff) (B2 c_pl U G V W X Y Z: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_pl (cfv G cplusg) $ >
  $ wi ph (wcel G ccmn) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wcel U B2) $ >
  $ wi ph (wcel V B2) $ >
  $ wi ph (wcel W B2) $ >
  $ wi ph (wceq (co (co X Y c_pl) (co (co Z U c_pl) (co V W c_pl) c_pl) c_pl) (co (co Y (co U W c_pl) c_pl) (co X (co Z V c_pl) c_pl) c_pl)) $;

--| Rearrange terms in a commutative monoid sum. Lemma for ~ rlocaddval . (Contributed by Thierry Arnoux, 4-May-2025.)
theorem cmn145236 (ph: wff) (B2 c_pl U G V W X Y Z: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_pl (cfv G cplusg) $ >
  $ wi ph (wcel G ccmn) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wcel U B2) $ >
  $ wi ph (wcel V B2) $ >
  $ wi ph (wcel W B2) $ >
  $ wi ph (wceq (co (co X Y c_pl) (co (co Z U c_pl) (co V W c_pl) c_pl) c_pl) (co (co X (co U V c_pl) c_pl) (co Y (co Z W c_pl) c_pl) c_pl)) $;

--| The image of an Abelian group by a group isomorphism is also Abelian. (Contributed by Thierry Arnoux, 8-Mar-2018.)
theorem abliso (F M N: class):
  $ wi (wa (wcel M cabl) (wcel F (co M N cgim))) (wcel N cabl) $;

--| A module homomorphism is a group homomorphism. (Contributed by Thierry Arnoux, 2-Apr-2025.)
theorem lmhmghmd (ph: wff) (S T F: class):
  $ wi ph (wcel F (co S T clmhm)) $ >
  $ wi ph (wcel F (co S T cghm)) $;

--| Value of the operation of the surjective image. (Contributed by Thierry Arnoux, 2-Apr-2025.)
theorem mhmimasplusg (ph: wff) (B2 C c_pl c_pd F V W X Y: class):
  $ wceq W (co F V cimas) $ >
  $ wceq B2 (cfv V cbs) $ >
  $ wceq C (cfv W cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wfo B2 C F) $ >
  $ wi ph (wcel F (co V W cmhm)) $ >
  $ wceq c_pl (cfv V cplusg) $ >
  $ wceq c_pd (cfv W cplusg) $ >
  $ wi ph (wceq (co (cfv X F) (cfv Y F) c_pd) (cfv (co X Y c_pl) F)) $;

--| Value of the scalar product of the surjective image of a module. (Contributed by Thierry Arnoux, 2-Apr-2025.)
theorem lmhmimasvsca (ph: wff) (B2 C c_x c_xp F K V W X Y: class):
  $ wceq W (co F V cimas) $ >
  $ wceq B2 (cfv V cbs) $ >
  $ wceq C (cfv W cbs) $ >
  $ wi ph (wcel X K) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wfo B2 C F) $ >
  $ wi ph (wcel F (co V W clmhm)) $ >
  $ wceq c_x (cfv V cvsca) $ >
  $ wceq c_xp (cfv W cvsca) $ >
  $ wceq K (cfv (cfv V csca) cbs) $ >
  $ wi ph (wceq (co X (cfv Y F) c_xp) (cfv (co X Y c_x) F)) $;

--| The identity element of a group belongs to the group. (Contributed by Thierry Arnoux, 4-May-2026.)
theorem grpidcld (ph: wff) (B2 G c_0: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wi ph (wcel G cgrp) $ >
  $ wi ph (wcel c_0 B2) $;

--| Double inverse law for groups. (Contributed by Thierry Arnoux, 15-Feb-2026.)
theorem grpinvinvd (ph: wff) (B2 G N X: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq N (cfv G cminusg) $ >
  $ wi ph (wcel G cgrp) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (cfv (cfv X N) N) X) $;

--| Closure of group subtraction. (Contributed by Thierry Arnoux, 3-Aug-2025.)
theorem grpsubcld (ph: wff) (B2 G c_mi X Y: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_mi (cfv G csg) $ >
  $ wi ph (wcel G cgrp) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel (co X Y c_mi) B2) $;

--| A subgroup is closed under group subtraction. (Contributed by Thierry Arnoux, 6-Jul-2025.)
theorem subgsubcld (ph: wff) (S G c_mi X Y: class):
  $ wceq c_mi (cfv G csg) $ >
  $ wi ph (wcel S (cfv G csubg)) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wcel Y S) $ >
  $ wi ph (wcel (co X Y c_mi) S) $;

--| Closure of the group multiple within a subgroup. (Contributed by Thierry Arnoux, 5-Oct-2025.)
theorem subgmulgcld (ph: wff) (A2 B2 R S c_x Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmg) $ >
  $ wi ph (wcel R cgrp) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel S (cfv R csubg)) $ >
  $ wi ph (wcel Z cz) $ >
  $ wi ph (wcel (co Z A2 c_x) S) $;

--| Values for the group multiple function in a restricted structure. (Contributed by Thierry Arnoux, 14-Jun-2017.)
theorem ressmulgnn0d (ph: wff) (A2 G H N X: class):
  $ wi ph (wceq (co G A2 cress) H) $ >
  $ wi ph (wceq (cfv G c0g) (cfv H c0g)) $ >
  $ wi ph (wss A2 (cfv G cbs)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wceq (co N X (cfv H cmg)) (co N X (cfv G cmg))) $;

--| An abelian group operation is commutative, deduction version. (Contributed by Thierry Arnoux, 15-Feb-2026.)
theorem ablcomd (ph: wff) (B2 c_pl G X Y: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_pl (cfv G cplusg) $ >
  $ wi ph (wcel G cabl) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (co X Y c_pl) (co Y X c_pl)) $;

--| The group sum in a subgroup is the same as the group sum. (Contributed by Thierry Arnoux, 28-May-2023.)
theorem gsumsubg (ph: wff) (A2 B2 F G H V: class):
  $ wceq H (co G B2 cress) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wcel B2 (cfv G csubg)) $ >
  $ wi ph (wceq (co G F cgsu) (co H F cgsu)) $;

--| The group sum in a subring algebra is the same as the ring's group sum. (Contributed by Thierry Arnoux, 28-May-2023.)
theorem gsumsra (ph: wff) (A2 B2 R U F V W: class):
  $ wceq A2 (cfv B2 (cfv R csra)) $ >
  $ wi ph (wcel F U) $ >
  $ wi ph (wcel R V) $ >
  $ wi ph (wcel A2 W) $ >
  $ wi ph (wss B2 (cfv R cbs)) $ >
  $ wi ph (wceq (co R F cgsu) (co A2 F cgsu)) $;

--| Split a finite sum into a sum of a collection of sums over disjoint subsets. (Contributed by Thierry Arnoux, 27-Mar-2018.)
theorem gsummpt2co {x3 y1: setvar} (ph: wff y1) (A2 B2: class) (C: class x3) (D: class x3 y1) (E F: class) (V: class x3) (W c_0: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi ph (wcel W ccmn) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wcel E V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C B2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel D E) $ >
  $ wceq F (cmpt x3 A2 D) $ >
  $ wi ph (wceq (co W (cmpt x3 A2 C) cgsu) (co W (cmpt y1 E (co W (cmpt x3 (cima (ccnv F) (csn (cv y1))) C) cgsu)) cgsu)) $;

--| Express a finite sum over a two-dimensional range as a double sum. See also ~ gsum2d . (Contributed by Thierry Arnoux, 27-Apr-2020.)
theorem gsummpt2d {x3 y1 z: setvar} (ph: wff y1) (A2 B2: class) (C: class x3 z) (D: class y1 z) (W: class z):
  $ wnfc z C $ >
  $ wnf y1 ph $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wi (wceq (cv x3) (cop (cv y1) (cv z))) (wceq C D) $ >
  $ wi ph (wrel A2) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wcel W ccmn) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C B2) $ >
  $ wi ph (wceq (co W (cmpt x3 A2 C) cgsu) (co W (cmpt y1 (cdm A2) (co W (cmpt z (cima A2 (csn (cv y1))) D) cgsu)) cgsu)) $;

--| Scalar multiplication in a left module by a fixed element is a group homomorphism. (Contributed by Thierry Arnoux, 12-Jun-2023.)
theorem lmodvslmhm {x3: setvar} (c_x F K V W Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wi (wa (wcel W clmod) (wcel Y V)) (wcel (cmpt x3 K (co (cv x3) Y c_x)) (co F W cghm)) $;

--| Pull a scalar multiplication out of a sum of vectors. This theorem properly generalizes ~ gsummulc1 , since every ring is a left module over itself. (Contributed by Thierry Arnoux, 12-Jun-2023.)
theorem gsumvsmul1 {k: setvar} (ph: wff) (A2: class) (B2: class k) (R: class) (S: class k) (c_x K: class) (V X: class k) (Y: class) (c_0: class k):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq S (cfv R csca) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq c_0 (cfv S c0g) $ >
  $ wceq c_x (cfv R cvsca) $ >
  $ wi ph (wcel R clmod) $ >
  $ wi ph (wcel S ccmn) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel X K) $ >
  $ wi ph (wbr (cmpt k A2 X) c_0 cfsupp) $ >
  $ wi ph (wceq (co R (cmpt k A2 (co X Y c_x)) cgsu) (co (co S (cmpt k A2 X) cgsu) Y c_x)) $;

--| Extend a finite group sum by padding outside with zeroes. Proof generated using OpenAI's proof assistant. (Contributed by Thierry Arnoux, 11-Jul-2020.)
theorem gsummptres {x3: setvar} (ph: wff) (A2 B2: class) (C: class x3) (D G: class) (c_0: class x3):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wi ph (wcel G ccmn) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C B2) $ >
  $ wi (wa ph (wcel (cv x3) (cdif A2 D))) (wceq C c_0) $ >
  $ wi ph (wceq (co G (cmpt x3 A2 C) cgsu) (co G (cmpt x3 (cin A2 D) C) cgsu)) $;

--| Extend a finite group sum by padding outside with zeroes. (Contributed by Thierry Arnoux, 22-Jun-2024.)
theorem gsummptres2 {x3: setvar} (ph: wff) (A2 B2 S G: class) (V Y: class x3) (c_0: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wi ph (wcel G ccmn) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv x3) (cdif A2 S))) (wceq Y c_0) $ >
  $ wi ph (wcel S cfn) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel Y B2) $ >
  $ wi ph (wss S A2) $ >
  $ wi ph (wceq (co G (cmpt x3 A2 Y) cgsu) (co G (cmpt x3 S Y) cgsu)) $;

--| Extend a finitely supported group sum by padding outside with zeroes. (Contributed by Thierry Arnoux, 15-Feb-2026.)
theorem gsummptfsres {x3: setvar} (ph: wff) (A2 B2 S: class) (G V Y: class x3) (c_0: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wi ph (wcel G ccmn) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv x3) (cdif A2 S))) (wceq Y c_0) $ >
  $ wi ph (wbr (cmpt x3 A2 Y) c_0 cfsupp) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel Y B2) $ >
  $ wi ph (wss S A2) $ >
  $ wi ph (wceq (co G (cmpt x3 A2 Y) cgsu) (co G (cmpt x3 S Y) cgsu)) $;

--| Re-index a finite group sum using a bijection. (Contributed by Thierry Arnoux, 29-Mar-2018.)
theorem gsummptf1od {x3 y1: setvar} (ph: wff) (A2: class) (B2: class y1) (C: class x3) (D: class) (E: class y1) (F G H c_0: class x3 y1):
  $ wnfc x3 H $ >
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wi (wa (wa ph (wcel (cv y1) D)) (wceq (cv x3) E)) (wceq C H) $ >
  $ wi ph (wcel G ccmn) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wss F B2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C F) $ >
  $ wi (wa ph (wcel (cv y1) D)) (wcel E A2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wreu y1 (wceq (cv x3) E) D) $ >
  $ wi ph (wceq (co G (cmpt x3 A2 C) cgsu) (co G (cmpt y1 D H) cgsu)) $;

--| Revert ordering in a group sum. See also ~ gsumwrev . (Contributed by Thierry Arnoux, 15-Feb-2026.)
theorem gsummptrev {k l: setvar} (ph: wff) (B2: class l) (M: class k l) (N: class) (X: class k) (Y: class l):
  $ wceq B2 (cfv M cbs) $ >
  $ wi ph (wcel M ccmn) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi (wa ph (wcel (cv k) (co cc0 N cfz))) (wcel X B2) $ >
  $ wi (wa (wa ph (wcel (cv l) (co cc0 N cfz))) (wceq (cv k) (co N (cv l) cmin))) (wceq X Y) $ >
  $ wi ph (wceq (co M (cmpt k (co cc0 N cfz) X) cgsu) (co M (cmpt l (co cc0 N cfz) Y) cgsu)) $;

--| Reindex a zero-based sum as a one-base sum. (Contributed by Thierry Arnoux, 15-Feb-2026.)
theorem gsummptp1 {k l: setvar} (ph: wff) (B2: class k) (R: class k l) (N: class) (X: class k) (Y: class l):
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel R ccmn) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi (wa ph (wcel (cv l) (co c1 N cfz))) (wcel Y B2) $ >
  $ wi (wa (wa ph (wcel (cv k) (co cc0 N cfzo))) (wceq (cv l) (co (cv k) c1 caddc))) (wceq Y X) $ >
  $ wi ph (wceq (co R (cmpt k (co cc0 N cfzo) X) cgsu) (co R (cmpt l (co c1 N cfz) Y) cgsu)) $;

--| Split a group sum expressed as mapping with a finite set of sequential integers as domain into two parts, extracting a singleton from the right. (Contributed by Thierry Arnoux, 15-Feb-2026.)
theorem gsummptfzsplitra {k: setvar} (ph: wff) (B2: class) (c_pl G: class k) (M N X: class) (Y: class k):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_pl (cfv G cplusg) $ >
  $ wi ph (wcel G ccmn) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel Y B2) $ >
  $ wi (wa ph (wceq (cv k) N)) (wceq Y X) $ >
  $ wi ph (wceq (co G (cmpt k (co M N cfz) Y) cgsu) (co (co G (cmpt k (co M N cfzo) Y) cgsu) X c_pl)) $;

--| Split a group sum expressed as mapping with a finite set of sequential integers as domain into two parts, extracting a singleton from the left. (Contributed by Thierry Arnoux, 15-Feb-2026.)
theorem gsummptfzsplitla {k: setvar} (ph: wff) (B2: class) (c_pl G: class k) (M N X: class) (Y: class k):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_pl (cfv G cplusg) $ >
  $ wi ph (wcel G ccmn) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel Y B2) $ >
  $ wi (wa ph (wceq (cv k) M)) (wceq Y X) $ >
  $ wi ph (wceq (co G (cmpt k (co M N cfz) Y) cgsu) (co X (co G (cmpt k (co (co M c1 caddc) N cfz) Y) cgsu) c_pl)) $;

--| Re-index a finite group sum using a bijection. A version of ~ gsummptf1o expressed using finite support. (Contributed by Thierry Arnoux, 5-Oct-2025.)
theorem gsummptfsf1o {x3 y1: setvar} (ph: wff) (A2: class) (B2: class y1) (C: class x3) (D: class) (E: class y1) (F G H V c_0: class x3 y1):
  $ wnfc x3 H $ >
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wi (wceq (cv x3) E) (wceq C H) $ >
  $ wi ph (wcel G ccmn) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wbr (cmpt x3 A2 C) c_0 cfsupp) $ >
  $ wi ph (wss F B2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C F) $ >
  $ wi (wa ph (wcel (cv y1) D)) (wcel E A2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wreu y1 (wceq (cv x3) E) D) $ >
  $ wi ph (wceq (co G (cmpt x3 A2 C) cgsu) (co G (cmpt y1 D H) cgsu)) $;

--| Express a finite sum over a two-dimensional range as a double sum. Version of ~ gsum2d using finite support. (Contributed by Thierry Arnoux, 5-Oct-2025.)
theorem gsumfs2d {x3 y1: setvar} (ph: wff) (A2 B2 F W: class) (X: class x3 y1) (c_0: class):
  $ wnf x3 ph $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi ph (wrel A2) $ >
  $ wi ph (wbr F c_0 cfsupp) $ >
  $ wi ph (wcel W ccmn) $ >
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wceq (co W F cgsu) (co W (cmpt x3 (cdm A2) (co W (cmpt y1 (cima A2 (csn (cv x3))) (cfv (cop (cv x3) (cv y1)) F)) cgsu)) cgsu)) $;

--| Append an element to a finite group sum expressed as a function restriction. (Contributed by Thierry Arnoux, 20-Nov-2023.)
theorem gsumzresunsn (ph: wff) (A2 B2 C c_pl F G X Y Z: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_pl (cfv G cplusg) $ >
  $ wceq Z (cfv G ccntz) $ >
  $ wceq Y (cfv X F) $ >
  $ wi ph (wf C B2 F) $ >
  $ wi ph (wss A2 C) $ >
  $ wi ph (wcel G cmnd) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wn (wcel X A2)) $ >
  $ wi ph (wcel X C) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wss (cima F (cun A2 (csn X))) (cfv (cima F (cun A2 (csn X))) Z)) $ >
  $ wi ph (wceq (co G (cres F (cun A2 (csn X))) cgsu) (co (co G (cres F A2) cgsu) Y c_pl)) $;

--| Express a group sum as a double sum, grouping along a (possibly infinite) partition. (Contributed by Thierry Arnoux, 22-Jun-2024.)
theorem gsumpart {x3: setvar} (ph: wff) (A2: class) (B2 C: class x3) (F G: class) (V W: class x3) (X: class) (c_0: class x3):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wi ph (wcel G ccmn) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel X W) $ >
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wbr F c_0 cfsupp) $ >
  $ wi ph (wdisj x3 X C) $ >
  $ wi ph (wceq (ciun x3 X C) A2) $ >
  $ wi ph (wceq (co G F cgsu) (co G (cmpt x3 X (co G (cres F C) cgsu)) cgsu)) $;

--| Group sum of an unordered triple. (Contributed by Thierry Arnoux, 22-Jun-2025.)
theorem gsumtp {k: setvar} (ph: wff) (A2: class k) (B2 C D: class) (c_pl: class k) (E G M N O V W: class) (X: class k):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_pl (cfv G cplusg) $ >
  $ wi (wceq (cv k) M) (wceq A2 C) $ >
  $ wi (wceq (cv k) N) (wceq A2 D) $ >
  $ wi (wceq (cv k) O) (wceq A2 E) $ >
  $ wi ph (wcel G ccmn) $ >
  $ wi ph (wcel M V) $ >
  $ wi ph (wcel N W) $ >
  $ wi ph (wcel O X) $ >
  $ wi ph (wne M N) $ >
  $ wi ph (wne N O) $ >
  $ wi ph (wne M O) $ >
  $ wi ph (wcel C B2) $ >
  $ wi ph (wcel D B2) $ >
  $ wi ph (wcel E B2) $ >
  $ wi ph (wceq (co G (cmpt k (ctp M N O) A2) cgsu) (co (co C D c_pl) E c_pl)) $;

--| Relate a group sum on ` ZZring ` to a finite sum on the complex numbers. See also ~ gsumfsum . (Contributed by Thierry Arnoux, 5-Oct-2025.)
theorem gsumzrsum {k: setvar} (ph: wff) (A2: class) (B2: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cz) $ >
  $ wi ph (wceq (co czring (cmpt k A2 B2) cgsu) (csu k A2 B2)) $;

--| A finite group sum multiplied by a constant. (Contributed by Thierry Arnoux, 5-Oct-2025.)
theorem gsummulgc2 {k: setvar} (ph: wff) (A2 B2 c_x: class) (M X: class k) (Y: class):
  $ wceq B2 (cfv M cbs) $ >
  $ wceq c_x (cfv M cmg) $ >
  $ wi ph (wcel M cgrp) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel X cz) $ >
  $ wi ph (wceq (co M (cmpt k A2 (co X Y c_x)) cgsu) (co (csu k A2 X) Y c_x)) $;

--| Express a group sum by grouping by nonzero values. (Contributed by Thierry Arnoux, 22-Jun-2024.)
theorem gsumhashmul {x3: setvar} (ph: wff) (A2 B2: class) (c_x: class x3) (F G c_0: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wceq c_x (cfv G cmg) $ >
  $ wi ph (wcel G ccmn) $ >
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wbr F c_0 cfsupp) $ >
  $ wi ph (wceq (co G F cgsu) (co G (cmpt x3 (cdif (crn F) (csn c_0)) (co (cfv (cima (ccnv F) (csn (cv x3))) chash) (cv x3) c_x)) cgsu)) $;

--| Distribute a subtraction over an indexed sum, shift one of the resulting sums, and regroup terms. (Contributed by Thierry Arnoux, 15-Feb-2026.)
theorem gsummulsubdishift1 {k: setvar} (ph: wff) (A2 B2 C D: class) (c_pl: class k) (R c_x: class) (E F: class k) (c_mi N: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_mi (cfv R csg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wcel C B2) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wf (co cc0 N cfz) B2 D) $ >
  $ wi ph (wceq E (co (co (cfv N D) A2 c_x) (co (cfv cc0 D) C c_x) c_mi)) $ >
  $ wi (wa ph (wcel (cv k) (co cc0 N cfzo))) (wceq F (co (co (cfv (cv k) D) A2 c_x) (co (cfv (co (cv k) c1 caddc) D) C c_x) c_mi)) $ >
  $ wi ph (wceq (co (co R D cgsu) (co A2 C c_mi) c_x) (co (co R (cmpt k (co cc0 N cfzo) F) cgsu) E c_pl)) $;

--| Distribute a subtraction over an indexed sum, shift one of the resulting sums, and regroup terms. (Contributed by Thierry Arnoux, 15-Feb-2026.)
theorem gsummulsubdishift2 {k: setvar} (ph: wff) (A2 B2 C D: class) (c_pl: class k) (R c_x: class) (E F: class k) (c_mi N: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_mi (cfv R csg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wcel C B2) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wf (co cc0 N cfz) B2 D) $ >
  $ wi ph (wceq E (co (co (cfv cc0 D) A2 c_x) (co (cfv N D) C c_x) c_mi)) $ >
  $ wi (wa ph (wcel (cv k) (co cc0 N cfzo))) (wceq F (co (co (cfv (co (cv k) c1 caddc) D) A2 c_x) (co (cfv (cv k) D) C c_x) c_mi)) $ >
  $ wi ph (wceq (co (co R D cgsu) (co A2 C c_mi) c_x) (co (co R (cmpt k (co cc0 N cfzo) F) cgsu) E c_pl)) $;

--| Distribute a subtraction over an indexed sum, shift one of the resulting sums, and regroup terms. (Contributed by Thierry Arnoux, 15-Feb-2026.)
theorem gsummulsubdishift1s {i k: setvar} (ph: wff) (A2: class i) (B2: class) (C: class i) (P: class k) (c_pl: class i k) (Q: class k) (R c_x: class i) (E F: class i k) (G H: class k) (c_mi: class i) (N: class) (V: class i):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_mi (cfv R csg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wcel C B2) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 N cfz))) (wcel V B2) $ >
  $ wi (wceq (cv i) cc0) (wceq V G) $ >
  $ wi (wceq (cv i) N) (wceq V H) $ >
  $ wi (wceq (cv i) (cv k)) (wceq V P) $ >
  $ wi (wceq (cv i) (co (cv k) c1 caddc)) (wceq V Q) $ >
  $ wi ph (wceq E (co (co H A2 c_x) (co G C c_x) c_mi)) $ >
  $ wi (wa ph (wcel (cv k) (co cc0 N cfzo))) (wceq F (co (co P A2 c_x) (co Q C c_x) c_mi)) $ >
  $ wi ph (wceq (co (co R (cmpt k (co cc0 N cfz) P) cgsu) (co A2 C c_mi) c_x) (co (co R (cmpt k (co cc0 N cfzo) F) cgsu) E c_pl)) $;

--| Distribute a subtraction over an indexed sum, shift one of the resulting sums, and regroup terms. (Contributed by Thierry Arnoux, 15-Feb-2026.)
theorem gsummulsubdishift2s {i k: setvar} (ph: wff) (A2: class i) (B2: class) (C: class i) (P: class k) (c_pl: class i k) (Q: class k) (R c_x: class i) (E F: class i k) (G H: class k) (c_mi: class i) (N: class) (V: class i):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_mi (cfv R csg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wcel C B2) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 N cfz))) (wcel V B2) $ >
  $ wi (wceq (cv i) cc0) (wceq V G) $ >
  $ wi (wceq (cv i) N) (wceq V H) $ >
  $ wi (wceq (cv i) (cv k)) (wceq V P) $ >
  $ wi (wceq (cv i) (co (cv k) c1 caddc)) (wceq V Q) $ >
  $ wi ph (wceq E (co (co G A2 c_x) (co H C c_x) c_mi)) $ >
  $ wi (wa ph (wcel (cv k) (co cc0 N cfzo))) (wceq F (co (co Q A2 c_x) (co P C c_x) c_mi)) $ >
  $ wi ph (wceq (co (co R (cmpt k (co cc0 N cfz) P) cgsu) (co A2 C c_mi) c_x) (co (co R (cmpt k (co cc0 N cfzo) F) cgsu) E c_pl)) $;

--| The support of a function defined as a group sum is a subset of the indexed union of the supports. (Contributed by Thierry Arnoux, 16-Mar-2026.)
theorem suppgsumssiun {x3 y1: setvar} (ph: wff) (A2 B2: class) (C: class x3 y1) (M: class x3) (V: class x3 y1) (W: class x3) (X: class x3 y1) (Z: class y1):
  $ wceq Z (cfv M c0g) $ >
  $ wi ph (wcel M cmnd) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa (wa ph (wcel (cv x3) A2)) (wcel (cv y1) B2)) (wcel C X) $ >
  $ wi ph (wss (co (cmpt x3 A2 (co M (cmpt y1 B2 C) cgsu)) Z csupp) (ciun y1 B2 (co (cmpt x3 A2 C) Z csupp))) $;

--| Any finite or infinite sum in the nonnegative extended reals is uniquely convergent to the supremum of all finite sums. (Contributed by Mario Carneiro, 13-Sep-2015.) (Revised by Thierry Arnoux, 30-Jan-2017.)
theorem xrge0tsmsd {s1: setvar} (ph: wff) (A2: class) (S: class s1) (F G: class) (V: class s1):
  $ wceq G (co cxrs (co cc0 cpnf cicc) cress) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wf A2 (co cc0 cpnf cicc) F) $ >
  $ wi ph (wceq S (csup (crn (cmpt s1 (cin (cpw A2) cfn) (co G (cres F (cv s1)) cgsu))) cxr clt)) $ >
  $ wi ph (wceq (co G F ctsu) (csn S)) $;

--| Any limit of a finite or infinite sum in the nonnegative extended reals is the union of the sets limits, since this set is a singleton. (Contributed by Thierry Arnoux, 23-Jun-2017.)
theorem xrge0tsmsbi (ph: wff) (A2 C F G V: class):
  $ wceq G (co cxrs (co cc0 cpnf cicc) cress) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wf A2 (co cc0 cpnf cicc) F) $ >
  $ wi ph (wb (wcel C (co G F ctsu)) (wceq C (cuni (co G F ctsu)))) $;

--| Any limit of a finite or infinite sum in the nonnegative extended reals is the union of the sets limits, since this set is a singleton. (Contributed by Thierry Arnoux, 24-Mar-2017.)
theorem xrge0tsmseq (ph: wff) (A2 C F G V: class):
  $ wceq G (co cxrs (co cc0 cpnf cicc) cress) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wf A2 (co cc0 cpnf cicc) F) $ >
  $ wi ph (wcel C (co G F ctsu)) $ >
  $ wi ph (wceq C (cuni (co G F ctsu))) $;

--| In a commutative ring, a group sum of a word ` W ` of characters taken from two submonoids ` E ` and ` F ` can be written as a simple sum. (Contributed by Thierry Arnoux, 6-Oct-2025.)
theorem gsumwun {e f2: setvar} (ph: wff) (c_pl E F M W: class):
  $ wceq c_pl (cfv M cplusg) $ >
  $ wi ph (wcel M ccmn) $ >
  $ wi ph (wcel E (cfv M csubmnd)) $ >
  $ wi ph (wcel F (cfv M csubmnd)) $ >
  $ wi ph (wcel W (cword (cun E F))) $ >
  $ wi ph (wrex e (wrex f2 (wceq (co M W cgsu) (co (cv e) (cv f2) c_pl)) F) E) $;

--| Lemma for ~ gsumwrd2dccat . Expose a bijection ` F ` between (ordered) pairs of words and words with a length of a subword. (Contributed by Thierry Arnoux, 5-Oct-2025.)
theorem gsumwrd2dccatlem {w a b: setvar} (ph: wff) (A2: class) (U: class w) (F: class w a) (G V: class w a b):
  $ wceq U (ciun w (cword A2) (cxp (csn (cv w)) (co cc0 (cfv (cv w) chash) cfz))) $ >
  $ wceq F (cmpt a (cxp (cword A2) (cword A2)) (cop (co (cfv (cv a) c1st) (cfv (cv a) c2nd) cconcat) (cfv (cfv (cv a) c1st) chash))) $ >
  $ wceq G (cmpt b U (cop (co (cfv (cv b) c1st) (cfv (cv b) c2nd) cpfx) (co (cfv (cv b) c1st) (cop (cfv (cv b) c2nd) (cfv (cfv (cv b) c1st) chash)) csubstr))) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wa (wf1o (cxp (cword A2) (cword A2)) U F) (wceq (ccnv F) G)) $;

--| Rewrite a sum ranging over pairs of words as a sum of sums over concatenated subwords. (Contributed by Thierry Arnoux, 5-Oct-2025.)
theorem gsumwrd2dccat {w j: setvar} (ph: wff) (A2 B2 F M Z: class):
  $ wceq B2 (cfv M cbs) $ >
  $ wceq Z (cfv M c0g) $ >
  $ wi ph (wf (cxp (cword A2) (cword A2)) B2 F) $ >
  $ wi ph (wbr F Z cfsupp) $ >
  $ wi ph (wcel M ccmn) $ >
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wceq (co M F cgsu) (co M (cmpt w (cword A2) (co M (cmpt j (co cc0 (cfv (cv w) chash) cfz) (cfv (cop (co (cv w) (cv j) cpfx) (co (cv w) (cop (cv j) (cfv (cv w) chash)) csubstr)) F)) cgsu)) cgsu)) $;

--| The centralizer of a union is the intersection of the centralizers. (Contributed by Thierry Arnoux, 27-Nov-2023.)
theorem cntzun (B2 M X Y Z: class):
  $ wceq B2 (cfv M cbs) $ >
  $ wceq Z (cfv M ccntz) $ >
  $ wi (wa (wss X B2) (wss Y B2)) (wceq (cfv (cun X Y) Z) (cin (cfv X Z) (cfv Y Z))) $;

--| The centralizer of the identity element is the whole base set. (Contributed by Thierry Arnoux, 27-Nov-2023.)
theorem cntzsnid (B2 M c_0 Z: class):
  $ wceq B2 (cfv M cbs) $ >
  $ wceq Z (cfv M ccntz) $ >
  $ wceq c_0 (cfv M c0g) $ >
  $ wi (wcel M cmnd) (wceq (cfv (csn c_0) Z) B2) $;

--| The center of a ring is a commutative ring. (Contributed by Thierry Arnoux, 21-Aug-2023.)
theorem cntrcrng (R Z: class):
  $ wceq Z (co R (cfv (cfv R cmgp) ccntr) cress) $ >
  $ wi (wcel R crg) (wcel Z ccrg) $;

--| Uniqueness property of permutations. (Contributed by Thierry Arnoux, 22-Aug-2020.)
theorem symgfcoeu {p: setvar} (D P Q G V: class):
  $ wceq G (cfv (cfv D csymg) cbs) $ >
  $ wi (w3a (wcel D V) (wcel P G) (wcel Q G)) (wreu p (wceq Q (ccom P (cv p))) G) $;

--| Two permutations ` X ` and ` Y ` commute if their orbits are disjoint. (Contributed by Thierry Arnoux, 15-Oct-2023.)
theorem symgcom (ph: wff) (A2 B2 E F G X Y: class):
  $ wceq G (cfv A2 csymg) $ >
  $ wceq B2 (cfv G cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (cres X E) (cres cid E)) $ >
  $ wi ph (wceq (cres Y F) (cres cid F)) $ >
  $ wi ph (wceq (cin E F) c0) $ >
  $ wi ph (wceq (cun E F) A2) $ >
  $ wi ph (wceq (ccom X Y) (ccom Y X)) $;

--| Two permutations ` X ` and ` Y ` commute if their orbits are disjoint. (Contributed by Thierry Arnoux, 17-Nov-2023.)
theorem symgcom2 (ph: wff) (A2 B2 G X Y: class):
  $ wceq G (cfv A2 csymg) $ >
  $ wceq B2 (cfv G cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (cin (cdm (cdif X cid)) (cdm (cdif Y cid))) c0) $ >
  $ wi ph (wceq (ccom X Y) (ccom Y X)) $;

--| All elements of a (finite) set of permutations commute if their orbits are disjoint. (Contributed by Thierry Arnoux, 20-Nov-2023.)
theorem symgcntz {x3: setvar} (ph: wff x3) (A2: class) (B2 D S Z: class x3):
  $ wceq S (cfv D csymg) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq Z (cfv S ccntz) $ >
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wdisj x3 A2 (cdm (cdif (cv x3) cid))) $ >
  $ wi ph (wss A2 (cfv A2 Z)) $;

--| The composition of two odd permutations is even. (Contributed by Thierry Arnoux, 15-Oct-2023.)
theorem odpmco (A2 B2 D S X Y: class):
  $ wceq S (cfv D csymg) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq A2 (cfv D cevpm) $ >
  $ wi (w3a (wcel D cfn) (wcel X (cdif B2 A2)) (wcel Y (cdif B2 A2))) (wcel (ccom X Y) A2) $;

--| The value of the group subtraction operation of the symmetric group. (Contributed by Thierry Arnoux, 15-Oct-2023.)
theorem symgsubg (A2 B2 G c_mi X Y: class):
  $ wceq G (cfv A2 csymg) $ >
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_mi (cfv G csg) $ >
  $ wi (wa (wcel X B2) (wcel Y B2)) (wceq (co X Y c_mi) (ccom X (ccnv Y))) $;

--| In a transposition of two given points, each maps to the other. (Contributed by Thierry Arnoux, 22-Aug-2020.)
theorem pmtrprfv2 (D T V X Y: class):
  $ wceq T (cfv D cpmtr) $ >
  $ wi (wa (wcel D V) (w3a (wcel X D) (wcel Y D) (wne X Y))) (wceq (cfv Y (cfv (cpr X Y) T)) X) $;

--| Composing a permutation ` F ` with a transposition which results in moving at least one less point. Here the set of points moved by a permutation ` F ` is expressed as ` dom ( F \ _I ) ` . (Contributed by Thierry Arnoux, 16-Nov-2023.)
theorem pmtrcnel (ph: wff) (B2 D S T F I J V: class):
  $ wceq S (cfv D csymg) $ >
  $ wceq T (cfv D cpmtr) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq J (cfv I F) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel I (cdm (cdif F cid))) $ >
  $ wi ph (wss (cdm (cdif (ccom (cfv (cpr I J) T) F) cid)) (cdif (cdm (cdif F cid)) (csn I))) $;

--| Variation on ~ pmtrcnel . (Contributed by Thierry Arnoux, 16-Nov-2023.)
theorem pmtrcnel2 (ph: wff) (B2 D S T F I J V: class):
  $ wceq S (cfv D csymg) $ >
  $ wceq T (cfv D cpmtr) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq J (cfv I F) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel I (cdm (cdif F cid))) $ >
  $ wi ph (wss (cdif (cdm (cdif F cid)) (cpr I J)) (cdm (cdif (ccom (cfv (cpr I J) T) F) cid))) $;

--| Composing a permutation ` F ` with a transposition which results in moving one or two less points. (Contributed by Thierry Arnoux, 16-Nov-2023.)
theorem pmtrcnelor (ph: wff) (A2 B2 D S T E F I J V: class):
  $ wceq S (cfv D csymg) $ >
  $ wceq T (cfv D cpmtr) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq J (cfv I F) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel I (cdm (cdif F cid))) $ >
  $ wceq E (cdm (cdif F cid)) $ >
  $ wceq A2 (cdm (cdif (ccom (cfv (cpr I J) T) F) cid)) $ >
  $ wi ph (wo (wceq A2 (cdif E (cpr I J))) (wceq A2 (cdif E (csn I)))) $;

--| Reorder a half-open integer range based at 0, so that the given index ` I ` is at the end. (Contributed by Thierry Arnoux, 27-May-2025.)
theorem fzo0pmtrlast {s1: setvar} (ph: wff s1) (I J N: class):
  $ wceq J (co cc0 N cfzo) $ >
  $ wi ph (wcel I J) $ >
  $ wi ph (wex s1 (wa (wf1o J J (cv s1)) (wceq (cfv (co N c1 cmin) (cv s1)) I))) $;

--| Reorder a word, so that the symbol given at index ` I ` is at the end. (Contributed by Thierry Arnoux, 27-May-2025.)
theorem wrdpmtrlast {s1: setvar} (ph: wff) (S U: class s1) (I J W: class):
  $ wceq J (co cc0 (cfv W chash) cfzo) $ >
  $ wi ph (wcel I J) $ >
  $ wi ph (wcel W (cword S)) $ >
  $ wceq U (co (ccom W (cv s1)) (co (cfv W chash) c1 cmin) cpfx) $ >
  $ wi ph (wex s1 (wa (wf1o J J (cv s1)) (wceq (ccom W (cv s1)) (co U (cs1 (cfv I W)) cconcat)))) $;

--| Transpositions of ` X ` and ` Y ` (understood to be the identity when ` X = Y ` ), are bijections. (Contributed by Thierry Arnoux, 1-Jan-2022.)
theorem pmtridf1o (ph: wff) (A2 T V X Y: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y A2) $ >
  $ wceq T (cif (wceq X Y) (cres cid A2) (cfv (cpr X Y) (cfv A2 cpmtr))) $ >
  $ wi ph (wf1o A2 A2 T) $;

--| Value at X of the transposition of ` X ` and ` Y ` (understood to be the identity when X = Y ). (Contributed by Thierry Arnoux, 3-Jan-2022.)
theorem pmtridfv1 (ph: wff) (A2 T V X Y: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y A2) $ >
  $ wceq T (cif (wceq X Y) (cres cid A2) (cfv (cpr X Y) (cfv A2 cpmtr))) $ >
  $ wi ph (wceq (cfv X T) Y) $;

--| Value at Y of the transposition of ` X ` and ` Y ` (understood to be the identity when X = Y ). (Contributed by Thierry Arnoux, 3-Jan-2022.)
theorem pmtridfv2 (ph: wff) (A2 T V X Y: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y A2) $ >
  $ wceq T (cif (wceq X Y) (cres cid A2) (cfv (cpr X Y) (cfv A2 cpmtr))) $ >
  $ wi ph (wceq (cfv Y T) X) $;

--| Permutation sign of the identity. (Contributed by Thierry Arnoux, 21-Aug-2020.)
theorem psgnid (D S: class):
  $ wceq S (cfv D cpsgn) $ >
  $ wi (wcel D cfn) (wceq (cfv (cres cid D) S) c1) $;

--| For a finite base set, the permutation sign is defined for all permutations. (Contributed by Thierry Arnoux, 22-Aug-2020.)
theorem psgndmfi (D S G: class):
  $ wceq S (cfv D cpsgn) $ >
  $ wceq G (cfv (cfv D csymg) cbs) $ >
  $ wi (wcel D cfn) (wfn S G) $;

--| Useful lemma for the following theorems. (Contributed by Thierry Arnoux, 21-Aug-2020.)
theorem pmtrto1cl (D T K N: class):
  $ wceq D (co c1 N cfz) $ >
  $ wceq T (cfv D cpmtr) $ >
  $ wi (wa (wcel K cn) (wcel (co K c1 caddc) D)) (wcel (cfv (cpr K (co K c1 caddc)) T) (crn T)) $;

--| Lemma for ~ psgnfzto1st . Our permutation of rank ` ( n + 1 ) ` can be written as a permutation of rank ` n ` composed with a transposition. (Contributed by Thierry Arnoux, 21-Aug-2020.)
theorem psgnfzto1stlem {i: setvar} (D K: class) (N: class i):
  $ wceq D (co c1 N cfz) $ >
  $ wi (wa (wcel K cn) (wcel (co K c1 caddc) D)) (wceq (cmpt i D (cif (wceq (cv i) c1) (co K c1 caddc) (cif (wbr (cv i) (co K c1 caddc) cle) (co (cv i) c1 cmin) (cv i)))) (ccom (cfv (cpr K (co K c1 caddc)) (cfv D cpmtr)) (cmpt i D (cif (wceq (cv i) c1) K (cif (wbr (cv i) K cle) (co (cv i) c1 cmin) (cv i)))))) $;

--| Value of our permutation ` P ` at 1. (Contributed by Thierry Arnoux, 23-Aug-2020.)
theorem fzto1stfv1 {i: setvar} (D: class) (P: class i) (I N: class):
  $ wceq D (co c1 N cfz) $ >
  $ wceq P (cmpt i D (cif (wceq (cv i) c1) I (cif (wbr (cv i) I cle) (co (cv i) c1 cmin) (cv i)))) $ >
  $ wi (wcel I D) (wceq (cfv c1 P) I) $;

--| Special case where the permutation defined in ~ psgnfzto1st is the identity. (Contributed by Thierry Arnoux, 21-Aug-2020.)
theorem fzto1st1 {i: setvar} (D: class) (P: class i) (I N: class):
  $ wceq D (co c1 N cfz) $ >
  $ wceq P (cmpt i D (cif (wceq (cv i) c1) I (cif (wbr (cv i) I cle) (co (cv i) c1 cmin) (cv i)))) $ >
  $ wi (wceq I c1) (wceq P (cres cid D)) $;

--| The function moving one element to the first position (and shifting all elements before it) is a permutation. (Contributed by Thierry Arnoux, 21-Aug-2020.)
theorem fzto1st {i: setvar} (B2 D: class) (P G: class i) (I N: class):
  $ wceq D (co c1 N cfz) $ >
  $ wceq P (cmpt i D (cif (wceq (cv i) c1) I (cif (wbr (cv i) I cle) (co (cv i) c1 cmin) (cv i)))) $ >
  $ wceq G (cfv D csymg) $ >
  $ wceq B2 (cfv G cbs) $ >
  $ wi (wcel I D) (wcel P B2) $;

--| Value of the inverse of our permutation ` P ` at ` I ` . (Contributed by Thierry Arnoux, 23-Aug-2020.)
theorem fzto1stinvn {i: setvar} (B2 D: class) (P G: class i) (I N: class):
  $ wceq D (co c1 N cfz) $ >
  $ wceq P (cmpt i D (cif (wceq (cv i) c1) I (cif (wbr (cv i) I cle) (co (cv i) c1 cmin) (cv i)))) $ >
  $ wceq G (cfv D csymg) $ >
  $ wceq B2 (cfv G cbs) $ >
  $ wi (wcel I D) (wceq (cfv I (ccnv P)) c1) $;

--| The permutation sign for moving one element to the first position. (Contributed by Thierry Arnoux, 21-Aug-2020.)
theorem psgnfzto1st {i: setvar} (B2 D: class) (P S G: class i) (I N: class):
  $ wceq D (co c1 N cfz) $ >
  $ wceq P (cmpt i D (cif (wceq (cv i) c1) I (cif (wbr (cv i) I cle) (co (cv i) c1 cmin) (cv i)))) $ >
  $ wceq G (cfv D csymg) $ >
  $ wceq B2 (cfv G cbs) $ >
  $ wceq S (cfv D cpsgn) $ >
  $ wi (wcel I D) (wceq (cfv P S) (co (cneg c1) (co I c1 caddc) cexp)) $;

--| Extend class notation with the permutation cycle builder.
term ctocyc: class;

--| Define a convenience permutation cycle builder. Given a list of elements to be cycled, in the form of a word, this function produces the corresponding permutation cycle. See definition in [Lang] p. 30. (Contributed by Thierry Arnoux, 19-Sep-2023.)
axiom df_tocyc {w u d: setvar}:
  $ wceq ctocyc (cmpt d cvv (cmpt w (crab u (wf1 (cdm (cv u)) (cv d) (cv u)) (cword (cv d))) (cun (cres cid (cdif (cv d) (crn (cv w)))) (ccom (co (cv w) c1 ccsh) (ccnv (cv w)))))) $;

--| Value of the cycle builder. (Contributed by Thierry Arnoux, 22-Sep-2023.)
theorem tocycval {w u: setvar} (C: class w u) (D: class) (V: class w u):
  $ wceq C (cfv D ctocyc) $ >
  $ wi (wcel D V) (wceq C (cmpt w (crab u (wf1 (cdm (cv u)) D (cv u)) (cword D)) (cun (cres cid (cdif D (crn (cv w)))) (ccom (co (cv w) c1 ccsh) (ccnv (cv w)))))) $;

--| Function value of a permutation cycle built from a word. (Contributed by Thierry Arnoux, 18-Sep-2023.)
theorem tocycfv (ph: wff) (C D V W: class):
  $ wceq C (cfv D ctocyc) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel W (cword D)) $ >
  $ wi ph (wf1 (cdm W) D W) $ >
  $ wi ph (wceq (cfv W C) (cun (cres cid (cdif D (crn W))) (ccom (co W c1 ccsh) (ccnv W)))) $;

--| A cyclic permutation is a cyclic shift on its orbit. (Contributed by Thierry Arnoux, 15-Oct-2023.)
theorem tocycfvres1 (ph: wff) (C D V W: class):
  $ wceq C (cfv D ctocyc) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel W (cword D)) $ >
  $ wi ph (wf1 (cdm W) D W) $ >
  $ wi ph (wceq (cres (cfv W C) (crn W)) (ccom (co W c1 ccsh) (ccnv W))) $;

--| A cyclic permutation is the identity outside of its orbit. (Contributed by Thierry Arnoux, 15-Oct-2023.)
theorem tocycfvres2 (ph: wff) (C D V W: class):
  $ wceq C (cfv D ctocyc) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel W (cword D)) $ >
  $ wi ph (wf1 (cdm W) D W) $ >
  $ wi ph (wceq (cres (cfv W C) (cdif D (crn W))) (cres cid (cdif D (crn W)))) $;

--| Lemma for ~ cycpmfv1 and ~ cycpmfv2 . (Contributed by Thierry Arnoux, 22-Sep-2023.)
theorem cycpmfvlem (ph: wff) (C D N V W: class):
  $ wceq C (cfv D ctocyc) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel W (cword D)) $ >
  $ wi ph (wf1 (cdm W) D W) $ >
  $ wi ph (wcel N (co cc0 (cfv W chash) cfzo)) $ >
  $ wi ph (wceq (cfv (cfv N W) (cfv W C)) (cfv (cfv N W) (ccom (co W c1 ccsh) (ccnv W)))) $;

--| Value of a cycle function for any element but the last. (Contributed by Thierry Arnoux, 22-Sep-2023.)
theorem cycpmfv1 (ph: wff) (C D N V W: class):
  $ wceq C (cfv D ctocyc) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel W (cword D)) $ >
  $ wi ph (wf1 (cdm W) D W) $ >
  $ wi ph (wcel N (co cc0 (co (cfv W chash) c1 cmin) cfzo)) $ >
  $ wi ph (wceq (cfv (cfv N W) (cfv W C)) (cfv (co N c1 caddc) W)) $;

--| Value of a cycle function for the last element of the orbit. (Contributed by Thierry Arnoux, 22-Sep-2023.)
theorem cycpmfv2 (ph: wff) (C D N V W: class):
  $ wceq C (cfv D ctocyc) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel W (cword D)) $ >
  $ wi ph (wf1 (cdm W) D W) $ >
  $ wi ph (wbr cc0 (cfv W chash) clt) $ >
  $ wi ph (wceq N (co (cfv W chash) c1 cmin)) $ >
  $ wi ph (wceq (cfv (cfv N W) (cfv W C)) (cfv cc0 W)) $;

--| Values outside of the orbit are unchanged by a cycle. (Contributed by Thierry Arnoux, 22-Sep-2023.)
theorem cycpmfv3 (ph: wff) (C D V W X: class):
  $ wceq C (cfv D ctocyc) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel W (cword D)) $ >
  $ wi ph (wf1 (cdm W) D W) $ >
  $ wi ph (wcel X D) $ >
  $ wi ph (wn (wcel X (crn W))) $ >
  $ wi ph (wceq (cfv X (cfv W C)) X) $;

--| Cyclic permutations are permutations. (Contributed by Thierry Arnoux, 24-Sep-2023.)
theorem cycpmcl (ph: wff) (C D S V W: class):
  $ wceq C (cfv D ctocyc) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel W (cword D)) $ >
  $ wi ph (wf1 (cdm W) D W) $ >
  $ wceq S (cfv D csymg) $ >
  $ wi ph (wcel (cfv W C) (cfv S cbs)) $;

--| The permutation cycle builder as a function. (Contributed by Thierry Arnoux, 25-Sep-2023.)
theorem tocycf {w: setvar} (B2 C: class w) (D: class) (S V: class w):
  $ wceq C (cfv D ctocyc) $ >
  $ wceq S (cfv D csymg) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi (wcel D V) (wf (crab w (wf1 (cdm (cv w)) D (cv w)) (cword D)) B2 C) $;

--| Permutation cycles built from the empty set or a singleton are the identity. (Contributed by Thierry Arnoux, 21-Nov-2023.)
theorem tocyc01 (C D V W: class):
  $ wceq C (cfv D ctocyc) $ >
  $ wi (wa (wcel D V) (wcel W (cin (cdm C) (cima (ccnv chash) (cpr cc0 c1))))) (wceq (cfv W C) (cres cid D)) $;

--| A cyclic permutation of 2 elements is a transposition. (Contributed by Thierry Arnoux, 24-Sep-2023.)
theorem cycpm2tr (ph: wff) (C D T I J V: class):
  $ wceq C (cfv D ctocyc) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel I D) $ >
  $ wi ph (wcel J D) $ >
  $ wi ph (wne I J) $ >
  $ wceq T (cfv D cpmtr) $ >
  $ wi ph (wceq (cfv (cs2 I J) C) (cfv (cpr I J) T)) $;

--| Closure for the 2-cycles. (Contributed by Thierry Arnoux, 24-Sep-2023.)
theorem cycpm2cl (ph: wff) (C D S I J V: class):
  $ wceq C (cfv D ctocyc) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel I D) $ >
  $ wi ph (wcel J D) $ >
  $ wi ph (wne I J) $ >
  $ wceq S (cfv D csymg) $ >
  $ wi ph (wcel (cfv (cs2 I J) C) (cfv S cbs)) $;

--| Function value of a 2-cycle at the first point. (Contributed by Thierry Arnoux, 24-Sep-2023.)
theorem cyc2fv1 (ph: wff) (C D S I J V: class):
  $ wceq C (cfv D ctocyc) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel I D) $ >
  $ wi ph (wcel J D) $ >
  $ wi ph (wne I J) $ >
  $ wceq S (cfv D csymg) $ >
  $ wi ph (wceq (cfv I (cfv (cs2 I J) C)) J) $;

--| Function value of a 2-cycle at the second point. (Contributed by Thierry Arnoux, 24-Sep-2023.)
theorem cyc2fv2 (ph: wff) (C D S I J V: class):
  $ wceq C (cfv D ctocyc) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel I D) $ >
  $ wi ph (wcel J D) $ >
  $ wi ph (wne I J) $ >
  $ wceq S (cfv D csymg) $ >
  $ wi ph (wceq (cfv J (cfv (cs2 I J) C)) I) $;

--| Exhibit the word a transposition corresponds to, as a cycle. (Contributed by Thierry Arnoux, 25-Sep-2023.)
theorem trsp2cyc {i j: setvar} (C: class i j) (D P T V: class):
  $ wceq T (crn (cfv D cpmtr)) $ >
  $ wceq C (cfv D ctocyc) $ >
  $ wi (wa (wcel D V) (wcel P T)) (wrex i (wrex j (wa (wne (cv i) (cv j)) (wceq P (cfv (cs2 (cv i) (cv j)) C))) D) D) $;

--| The word U used in ~ cycpmco2 is injective, so it can represent a cycle and form a cyclic permutation ` ( M `` U ) ` . (Contributed by Thierry Arnoux, 4-Jan-2024.)
theorem cycpmco2f1 (ph: wff) (D S U E I J M V W: class):
  $ wceq M (cfv D ctocyc) $ >
  $ wceq S (cfv D csymg) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel W (cdm M)) $ >
  $ wi ph (wcel I (cdif D (crn W))) $ >
  $ wi ph (wcel J (crn W)) $ >
  $ wceq E (co (cfv J (ccnv W)) c1 caddc) $ >
  $ wceq U (co W (cotp E E (cs1 I)) csplice) $ >
  $ wi ph (wf1 (cdm U) D U) $;

--| The orbit of the composition of a cyclic permutation and a well-chosen transposition is one element more than the orbit of the original permutation. (Contributed by Thierry Arnoux, 4-Jan-2024.)
theorem cycpmco2rn (ph: wff) (D S U E I J M V W: class):
  $ wceq M (cfv D ctocyc) $ >
  $ wceq S (cfv D csymg) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel W (cdm M)) $ >
  $ wi ph (wcel I (cdif D (crn W))) $ >
  $ wi ph (wcel J (crn W)) $ >
  $ wceq E (co (cfv J (ccnv W)) c1 caddc) $ >
  $ wceq U (co W (cotp E E (cs1 I)) csplice) $ >
  $ wi ph (wceq (crn U) (cun (crn W) (csn I))) $;

--| Lemma for ~ cycpmco2 . (Contributed by Thierry Arnoux, 4-Jan-2024.)
theorem cycpmco2lem1 (ph: wff) (D S U E I J M V W: class):
  $ wceq M (cfv D ctocyc) $ >
  $ wceq S (cfv D csymg) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel W (cdm M)) $ >
  $ wi ph (wcel I (cdif D (crn W))) $ >
  $ wi ph (wcel J (crn W)) $ >
  $ wceq E (co (cfv J (ccnv W)) c1 caddc) $ >
  $ wceq U (co W (cotp E E (cs1 I)) csplice) $ >
  $ wi ph (wceq (cfv (cfv I (cfv (cs2 I J) M)) (cfv W M)) (cfv J (cfv W M))) $;

--| Lemma for ~ cycpmco2 . (Contributed by Thierry Arnoux, 4-Jan-2024.)
theorem cycpmco2lem2 (ph: wff) (D S U E I J M V W: class):
  $ wceq M (cfv D ctocyc) $ >
  $ wceq S (cfv D csymg) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel W (cdm M)) $ >
  $ wi ph (wcel I (cdif D (crn W))) $ >
  $ wi ph (wcel J (crn W)) $ >
  $ wceq E (co (cfv J (ccnv W)) c1 caddc) $ >
  $ wceq U (co W (cotp E E (cs1 I)) csplice) $ >
  $ wi ph (wceq (cfv E U) I) $;

--| Lemma for ~ cycpmco2 . (Contributed by Thierry Arnoux, 4-Jan-2024.)
theorem cycpmco2lem3 (ph: wff) (D S U E I J M V W: class):
  $ wceq M (cfv D ctocyc) $ >
  $ wceq S (cfv D csymg) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel W (cdm M)) $ >
  $ wi ph (wcel I (cdif D (crn W))) $ >
  $ wi ph (wcel J (crn W)) $ >
  $ wceq E (co (cfv J (ccnv W)) c1 caddc) $ >
  $ wceq U (co W (cotp E E (cs1 I)) csplice) $ >
  $ wi ph (wceq (co (cfv U chash) c1 cmin) (cfv W chash)) $;

--| Lemma for ~ cycpmco2 . (Contributed by Thierry Arnoux, 4-Jan-2024.)
theorem cycpmco2lem4 (ph: wff) (D S U E I J M V W: class):
  $ wceq M (cfv D ctocyc) $ >
  $ wceq S (cfv D csymg) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel W (cdm M)) $ >
  $ wi ph (wcel I (cdif D (crn W))) $ >
  $ wi ph (wcel J (crn W)) $ >
  $ wceq E (co (cfv J (ccnv W)) c1 caddc) $ >
  $ wceq U (co W (cotp E E (cs1 I)) csplice) $ >
  $ wi ph (wceq (cfv (cfv I (cfv (cs2 I J) M)) (cfv W M)) (cfv I (cfv U M))) $;

--| Lemma for ~ cycpmco2 . (Contributed by Thierry Arnoux, 4-Jan-2024.)
theorem cycpmco2lem5 (ph: wff) (D S U E I J K M V W: class):
  $ wceq M (cfv D ctocyc) $ >
  $ wceq S (cfv D csymg) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel W (cdm M)) $ >
  $ wi ph (wcel I (cdif D (crn W))) $ >
  $ wi ph (wcel J (crn W)) $ >
  $ wceq E (co (cfv J (ccnv W)) c1 caddc) $ >
  $ wceq U (co W (cotp E E (cs1 I)) csplice) $ >
  $ wi ph (wcel K (crn W)) $ >
  $ wi ph (wceq (cfv K (ccnv U)) (co (cfv U chash) c1 cmin)) $ >
  $ wi ph (wceq (cfv K (cfv U M)) (cfv K (cfv W M))) $;

--| Lemma for ~ cycpmco2 . (Contributed by Thierry Arnoux, 4-Jan-2024.)
theorem cycpmco2lem6 (ph: wff) (D S U E I J K M V W: class):
  $ wceq M (cfv D ctocyc) $ >
  $ wceq S (cfv D csymg) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel W (cdm M)) $ >
  $ wi ph (wcel I (cdif D (crn W))) $ >
  $ wi ph (wcel J (crn W)) $ >
  $ wceq E (co (cfv J (ccnv W)) c1 caddc) $ >
  $ wceq U (co W (cotp E E (cs1 I)) csplice) $ >
  $ wi ph (wcel K (crn W)) $ >
  $ wi ph (wne K I) $ >
  $ wi ph (wcel (cfv K (ccnv U)) (co E (co (cfv U chash) c1 cmin) cfzo)) $ >
  $ wi ph (wceq (cfv K (cfv U M)) (cfv K (cfv W M))) $;

--| Lemma for ~ cycpmco2 . (Contributed by Thierry Arnoux, 4-Jan-2024.)
theorem cycpmco2lem7 (ph: wff) (D S U E I J K M V W: class):
  $ wceq M (cfv D ctocyc) $ >
  $ wceq S (cfv D csymg) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel W (cdm M)) $ >
  $ wi ph (wcel I (cdif D (crn W))) $ >
  $ wi ph (wcel J (crn W)) $ >
  $ wceq E (co (cfv J (ccnv W)) c1 caddc) $ >
  $ wceq U (co W (cotp E E (cs1 I)) csplice) $ >
  $ wi ph (wcel K (crn W)) $ >
  $ wi ph (wne K J) $ >
  $ wi ph (wcel (cfv K (ccnv U)) (co cc0 E cfzo)) $ >
  $ wi ph (wceq (cfv K (cfv U M)) (cfv K (cfv W M))) $;

--| The composition of a cyclic permutation and a transposition of one element in the cycle and one outside the cycle results in a cyclic permutation with one more element in its orbit. (Contributed by Thierry Arnoux, 2-Jan-2024.)
theorem cycpmco2 (ph: wff) (D S U E I J M V W: class):
  $ wceq M (cfv D ctocyc) $ >
  $ wceq S (cfv D csymg) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel W (cdm M)) $ >
  $ wi ph (wcel I (cdif D (crn W))) $ >
  $ wi ph (wcel J (crn W)) $ >
  $ wceq E (co (cfv J (ccnv W)) c1 caddc) $ >
  $ wceq U (co W (cotp E E (cs1 I)) csplice) $ >
  $ wi ph (wceq (ccom (cfv W M) (cfv (cs2 I J) M)) (cfv U M)) $;

--| Function value of a 2-cycle outside of its orbit. (Contributed by Thierry Arnoux, 19-Sep-2023.)
theorem cyc2fvx (ph: wff) (C D S I J K V: class):
  $ wceq C (cfv D ctocyc) $ >
  $ wceq S (cfv D csymg) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel I D) $ >
  $ wi ph (wcel J D) $ >
  $ wi ph (wcel K D) $ >
  $ wi ph (wne I J) $ >
  $ wi ph (wne J K) $ >
  $ wi ph (wne K I) $ >
  $ wi ph (wceq (cfv K (cfv (cs2 I J) C)) K) $;

--| Closure of the 3-cycles in the permutations. (Contributed by Thierry Arnoux, 19-Sep-2023.)
theorem cycpm3cl (ph: wff) (C D S I J K V: class):
  $ wceq C (cfv D ctocyc) $ >
  $ wceq S (cfv D csymg) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel I D) $ >
  $ wi ph (wcel J D) $ >
  $ wi ph (wcel K D) $ >
  $ wi ph (wne I J) $ >
  $ wi ph (wne J K) $ >
  $ wi ph (wne K I) $ >
  $ wi ph (wcel (cfv (cs3 I J K) C) (cfv S cbs)) $;

--| Closure of the 3-cycles in the class of 3-cycles. (Contributed by Thierry Arnoux, 19-Sep-2023.)
theorem cycpm3cl2 (ph: wff) (C D S I J K V: class):
  $ wceq C (cfv D ctocyc) $ >
  $ wceq S (cfv D csymg) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel I D) $ >
  $ wi ph (wcel J D) $ >
  $ wi ph (wcel K D) $ >
  $ wi ph (wne I J) $ >
  $ wi ph (wne J K) $ >
  $ wi ph (wne K I) $ >
  $ wi ph (wcel (cfv (cs3 I J K) C) (cima C (cima (ccnv chash) (csn c3)))) $;

--| Function value of a 3-cycle at the first point. (Contributed by Thierry Arnoux, 19-Sep-2023.)
theorem cyc3fv1 (ph: wff) (C D S I J K V: class):
  $ wceq C (cfv D ctocyc) $ >
  $ wceq S (cfv D csymg) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel I D) $ >
  $ wi ph (wcel J D) $ >
  $ wi ph (wcel K D) $ >
  $ wi ph (wne I J) $ >
  $ wi ph (wne J K) $ >
  $ wi ph (wne K I) $ >
  $ wi ph (wceq (cfv I (cfv (cs3 I J K) C)) J) $;

--| Function value of a 3-cycle at the second point. (Contributed by Thierry Arnoux, 19-Sep-2023.)
theorem cyc3fv2 (ph: wff) (C D S I J K V: class):
  $ wceq C (cfv D ctocyc) $ >
  $ wceq S (cfv D csymg) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel I D) $ >
  $ wi ph (wcel J D) $ >
  $ wi ph (wcel K D) $ >
  $ wi ph (wne I J) $ >
  $ wi ph (wne J K) $ >
  $ wi ph (wne K I) $ >
  $ wi ph (wceq (cfv J (cfv (cs3 I J K) C)) K) $;

--| Function value of a 3-cycle at the third point. (Contributed by Thierry Arnoux, 19-Sep-2023.)
theorem cyc3fv3 (ph: wff) (C D S I J K V: class):
  $ wceq C (cfv D ctocyc) $ >
  $ wceq S (cfv D csymg) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel I D) $ >
  $ wi ph (wcel J D) $ >
  $ wi ph (wcel K D) $ >
  $ wi ph (wne I J) $ >
  $ wi ph (wne J K) $ >
  $ wi ph (wne K I) $ >
  $ wi ph (wceq (cfv K (cfv (cs3 I J K) C)) I) $;

--| Represent a 3-cycle as a composition of two 2-cycles. (Contributed by Thierry Arnoux, 19-Sep-2023.)
theorem cyc3co2 (ph: wff) (C D S c_x I J K V: class):
  $ wceq C (cfv D ctocyc) $ >
  $ wceq S (cfv D csymg) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel I D) $ >
  $ wi ph (wcel J D) $ >
  $ wi ph (wcel K D) $ >
  $ wi ph (wne I J) $ >
  $ wi ph (wne J K) $ >
  $ wi ph (wne K I) $ >
  $ wceq c_x (cfv S cplusg) $ >
  $ wi ph (wceq (cfv (cs3 I J K) C) (co (cfv (cs2 I K) C) (cfv (cs2 I J) C) c_x)) $;

--| Lemma for ~ cycpmconjv . (Contributed by Thierry Arnoux, 9-Oct-2023.)
theorem cycpmconjvlem (ph: wff) (B2 D F: class):
  $ wi ph (wf1o D D F) $ >
  $ wi ph (wss B2 D) $ >
  $ wi ph (wceq (ccom (cres F (cdif D B2)) (ccnv F)) (cres cid (cdif D (crn (cres F B2))))) $;

--| A formula for computing conjugacy classes of cyclic permutations. Formula in property (b) of [Lang] p. 32. (Contributed by Thierry Arnoux, 9-Oct-2023.)
theorem cycpmconjv (B2 D c_pl S G M c_mi V W: class):
  $ wceq S (cfv D csymg) $ >
  $ wceq M (cfv D ctocyc) $ >
  $ wceq c_pl (cfv S cplusg) $ >
  $ wceq c_mi (cfv S csg) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi (w3a (wcel D V) (wcel G B2) (wcel W (cdm M))) (wceq (co (co G (cfv W M) c_pl) G c_mi) (cfv (ccom G W) M)) $;

--| The range of the word used to build a cycle is the cycle's orbit, i.e., the set of points it moves. (Contributed by Thierry Arnoux, 20-Nov-2023.)
theorem cycpmrn (ph: wff) (D M V W: class):
  $ wceq M (cfv D ctocyc) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel W (cword D)) $ >
  $ wi ph (wf1 (cdm W) D W) $ >
  $ wi ph (wbr c1 (cfv W chash) clt) $ >
  $ wi ph (wceq (crn W) (cdm (cdif (cfv W M) cid))) $;

--| All elements of a (finite) set of cycles commute if their orbits are disjoint. (Contributed by Thierry Arnoux, 27-Nov-2023.)
theorem tocyccntz {x3: setvar} (ph: wff) (A2: class) (D S: class x3) (M: class) (V Z: class x3):
  $ wceq S (cfv D csymg) $ >
  $ wceq Z (cfv S ccntz) $ >
  $ wceq M (cfv D ctocyc) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wdisj x3 A2 (crn (cv x3))) $ >
  $ wi ph (wss A2 (cdm M)) $ >
  $ wi ph (wss (cima M A2) (cfv (cima M A2) Z)) $;

--| Value of the set of even permutations, the alternating group. (Contributed by Thierry Arnoux, 1-Nov-2023.)
theorem evpmval (A2 D V: class):
  $ wceq A2 (cfv D cevpm) $ >
  $ wi (wcel D V) (wceq A2 (cima (ccnv (cfv D cpsgn)) (csn c1))) $;

--| The neutral element of the sign subgroup of the complex numbers. (Contributed by Thierry Arnoux, 1-Nov-2023.)
theorem cnmsgn0g (U: class):
  $ wceq U (co (cfv ccnfld cmgp) (cpr c1 (cneg c1)) cress) $ >
  $ wceq c1 (cfv U c0g) $;

--| The alternating group is a subgroup of the symmetric group. (Contributed by Thierry Arnoux, 1-Nov-2023.)
theorem evpmsubg (A2 D S: class):
  $ wceq S (cfv D csymg) $ >
  $ wceq A2 (cfv D cevpm) $ >
  $ wi (wcel D cfn) (wcel A2 (cfv S csubg)) $;

--| The identity is an even permutation. (Contributed by Thierry Arnoux, 18-Sep-2023.)
theorem evpmid (D S: class):
  $ wceq S (cfv D csymg) $ >
  $ wi (wcel D cfn) (wcel (cres cid D) (cfv D cevpm)) $;

--| The alternating group ` ( pmEven `` D ) ` is a normal subgroup of the symmetric group. (Contributed by Thierry Arnoux, 18-Sep-2023.)
theorem altgnsg (D S: class):
  $ wceq S (cfv D csymg) $ >
  $ wi (wcel D cfn) (wcel (cfv D cevpm) (cfv S cnsg)) $;

--| 3-Cycles are even permutations. (Contributed by Thierry Arnoux, 24-Sep-2023.)
theorem cyc3evpm (A2 C D: class):
  $ wceq C (cima (cfv D ctocyc) (cima (ccnv chash) (csn c3))) $ >
  $ wceq A2 (cfv D cevpm) $ >
  $ wi (wcel D cfn) (wss C A2) $;

--| Lemma for ~ cyc3genpm . (Contributed by Thierry Arnoux, 24-Sep-2023.)
theorem cyc3genpmlem {c: setvar} (ph: wff) (A2: class c) (C D S c_x E F I J K L M: class) (N V: class c):
  $ wceq C (cima M (cima (ccnv chash) (csn c3))) $ >
  $ wceq A2 (cfv D cevpm) $ >
  $ wceq S (cfv D csymg) $ >
  $ wceq N (cfv D chash) $ >
  $ wceq M (cfv D ctocyc) $ >
  $ wceq c_x (cfv S cplusg) $ >
  $ wi ph (wcel I D) $ >
  $ wi ph (wcel J D) $ >
  $ wi ph (wcel K D) $ >
  $ wi ph (wcel L D) $ >
  $ wi ph (wceq E (cfv (cs2 I J) M)) $ >
  $ wi ph (wceq F (cfv (cs2 K L) M)) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wne I J) $ >
  $ wi ph (wne K L) $ >
  $ wi ph (wrex c (wceq (co E F c_x) (co S (cv c) cgsu)) (cword C)) $;

--| The alternating group ` A ` is generated by 3-cycles. Property (a) of [Lang] p. 32 . (Contributed by Thierry Arnoux, 27-Sep-2023.)
theorem cyc3genpm {w: setvar} (A2 C D Q S: class) (M: class w) (N: class):
  $ wceq C (cima M (cima (ccnv chash) (csn c3))) $ >
  $ wceq A2 (cfv D cevpm) $ >
  $ wceq S (cfv D csymg) $ >
  $ wceq N (cfv D chash) $ >
  $ wceq M (cfv D ctocyc) $ >
  $ wi (wcel D cfn) (wb (wcel Q A2) (wrex w (wceq Q (co S (cv w) cgsu)) (cword C))) $;

--| Cyclic permutations are permutations, similar to ~ cycpmcl , but where the set of cyclic permutations of length ` P ` is expressed in terms of a preimage. (Contributed by Thierry Arnoux, 13-Oct-2023.)
theorem cycpmgcl (B2 C D P S M N V: class):
  $ wceq C (cima M (cima (ccnv chash) (csn P))) $ >
  $ wceq S (cfv D csymg) $ >
  $ wceq N (cfv D chash) $ >
  $ wceq M (cfv D ctocyc) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi (wa (wcel D V) (wcel P (co cc0 N cfz))) (wss C B2) $;

--| Lemma for ~ cycpmconjs . (Contributed by Thierry Arnoux, 14-Oct-2023.)
theorem cycpmconjslem1 (ph: wff) (C D P S M N V W: class):
  $ wceq C (cima M (cima (ccnv chash) (csn P))) $ >
  $ wceq S (cfv D csymg) $ >
  $ wceq N (cfv D chash) $ >
  $ wceq M (cfv D ctocyc) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel W (cword D)) $ >
  $ wi ph (wf1 (cdm W) D W) $ >
  $ wi ph (wceq (cfv W chash) P) $ >
  $ wi ph (wceq (ccom (ccom (ccnv W) (cfv W M)) W) (co (cres cid (co cc0 P cfzo)) c1 ccsh)) $;

--| Lemma for ~ cycpmconjs . (Contributed by Thierry Arnoux, 14-Oct-2023.)
theorem cycpmconjslem2 {q: setvar} (ph: wff q) (B2 C: class q) (D P c_pl Q: class) (S: class q) (M: class) (c_mi: class q) (N: class):
  $ wceq C (cima M (cima (ccnv chash) (csn P))) $ >
  $ wceq S (cfv D csymg) $ >
  $ wceq N (cfv D chash) $ >
  $ wceq M (cfv D ctocyc) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_pl (cfv S cplusg) $ >
  $ wceq c_mi (cfv S csg) $ >
  $ wi ph (wcel P (co cc0 N cfz)) $ >
  $ wi ph (wcel D cfn) $ >
  $ wi ph (wcel Q C) $ >
  $ wi ph (wex q (wa (wf1o (co cc0 N cfzo) D (cv q)) (wceq (ccom (ccom (ccnv (cv q)) Q) (cv q)) (cun (co (cres cid (co cc0 P cfzo)) c1 ccsh) (cres cid (co P N cfzo)))))) $;

--| All cycles of the same length are conjugate in the symmetric group. (Contributed by Thierry Arnoux, 14-Oct-2023.)
theorem cycpmconjs {p: setvar} (ph: wff) (B2: class) (C: class p) (D P c_pl Q: class) (S: class p) (T M c_mi N: class):
  $ wceq C (cima M (cima (ccnv chash) (csn P))) $ >
  $ wceq S (cfv D csymg) $ >
  $ wceq N (cfv D chash) $ >
  $ wceq M (cfv D ctocyc) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_pl (cfv S cplusg) $ >
  $ wceq c_mi (cfv S csg) $ >
  $ wi ph (wcel P (co cc0 N cfz)) $ >
  $ wi ph (wcel D cfn) $ >
  $ wi ph (wcel Q C) $ >
  $ wi ph (wcel T C) $ >
  $ wi ph (wrex p (wceq Q (co (co (cv p) T c_pl) (cv p) c_mi)) B2) $;

--| All 3-cycles are conjugate in the alternating group A_n for n>= 5. Property (b) of [Lang] p. 32. (Contributed by Thierry Arnoux, 15-Oct-2023.)
theorem cyc3conja {p: setvar} (ph: wff) (A2: class) (C: class p) (D c_pl Q S T M c_mi: class) (N: class p):
  $ wceq C (cima M (cima (ccnv chash) (csn c3))) $ >
  $ wceq A2 (cfv D cevpm) $ >
  $ wceq S (cfv D csymg) $ >
  $ wceq N (cfv D chash) $ >
  $ wceq M (cfv D ctocyc) $ >
  $ wceq c_pl (cfv S cplusg) $ >
  $ wceq c_mi (cfv S csg) $ >
  $ wi ph (wbr c5 N cle) $ >
  $ wi ph (wcel D cfn) $ >
  $ wi ph (wcel Q C) $ >
  $ wi ph (wcel T C) $ >
  $ wi ph (wrex p (wceq Q (co (co (cv p) T c_pl) (cv p) c_mi)) A2) $;

--| Extend class notation to include the Signum function.
term csgns: class;

--| Signum function for a structure. See also ~ df-sgn for the version for extended reals. (Contributed by Thierry Arnoux, 10-Sep-2018.)
axiom df_sgns {x3 r: setvar}:
  $ wceq csgns (cmpt r cvv (cmpt x3 (cfv (cv r) cbs) (cif (wceq (cv x3) (cfv (cv r) c0g)) cc0 (cif (wbr (cfv (cv r) c0g) (cv x3) (cfv (cv r) cplt)) c1 (cneg c1))))) $;

--| The sign mapping. (Contributed by Thierry Arnoux, 9-Sep-2018.)
theorem sgnsv {x3: setvar} (B2 R: class) (S: class x3) (c_lt V c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_lt (cfv R cplt) $ >
  $ wceq S (cfv R csgns) $ >
  $ wi (wcel R V) (wceq S (cmpt x3 B2 (cif (wceq (cv x3) c_0) cc0 (cif (wbr c_0 (cv x3) c_lt) c1 (cneg c1))))) $;

--| The sign value. (Contributed by Thierry Arnoux, 9-Sep-2018.)
theorem sgnsval (B2 R S c_lt V X c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_lt (cfv R cplt) $ >
  $ wceq S (cfv R csgns) $ >
  $ wi (wa (wcel R V) (wcel X B2)) (wceq (cfv X S) (cif (wceq X c_0) cc0 (cif (wbr c_0 X c_lt) c1 (cneg c1)))) $;

--| The sign function. (Contributed by Thierry Arnoux, 9-Sep-2018.)
theorem sgnsf (B2 R S c_lt V c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_lt (cfv R cplt) $ >
  $ wceq S (cfv R csgns) $ >
  $ wi (wcel R V) (wf B2 (ctp (cneg c1) cc0 c1) S) $;

--| Extend class notation with the fixed points operation.
term cfxp: class;

--| Define the set of fixed points left unchanged by a group action. (Contributed by Thierry Arnoux, 18-Nov-2025.)
axiom df_fxp {x3 p a b: setvar}:
  $ wceq cfxp (cmpo b a cvv cvv (crab x3 (wral p (wceq (co (cv p) (cv x3) (cv a)) (cv x3)) (cdm (cdm (cv a)))) (cv b))) $;

--| Value of the set of fixed points. (Contributed by Thierry Arnoux, 18-Nov-2025.)
theorem fxpval {x3 p: setvar} (ph: wff x3 p) (A2: class) (B2: class p) (V W: class x3 p):
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wcel A2 W) $ >
  $ wi ph (wceq (co B2 A2 cfxp) (crab x3 (wral p (wceq (co (cv p) (cv x3) A2) (cv x3)) (cdm (cdm A2))) B2)) $;

--| The set of fixed points is a subset of the set acted upon. (Contributed by Thierry Arnoux, 18-Nov-2025.)
theorem fxpss (ph: wff) (A2 B2 V W: class):
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wcel A2 W) $ >
  $ wi ph (wss (co B2 A2 cfxp) B2) $;

--| Value of the set of fixed points for a group action ` A ` . (Contributed by Thierry Arnoux, 18-Nov-2025.)
theorem fxpgaval {x3 p: setvar} (ph: wff p) (A2: class) (C: class p) (U G: class x3):
  $ wceq U (cfv G cbs) $ >
  $ wi ph (wcel A2 (co G C cga)) $ >
  $ wi ph (wceq (co C A2 cfxp) (crab x3 (wral p (wceq (co (cv p) (cv x3) A2) (cv x3)) U) C)) $;

--| Property of being a fixed point. (Contributed by Thierry Arnoux, 18-Nov-2025.)
theorem isfxp {p: setvar} (ph: wff p) (A2: class) (C: class p) (U G X: class):
  $ wceq U (cfv G cbs) $ >
  $ wi ph (wcel A2 (co G C cga)) $ >
  $ wi ph (wcel X C) $ >
  $ wi ph (wb (wcel X (co C A2 cfxp)) (wral p (wceq (co (cv p) X A2) X) U)) $;

--| A fixed point ` X ` is invariant under group action ` A ` . (Contributed by Thierry Arnoux, 18-Nov-2025.)
theorem fxpgaeq (ph: wff) (A2 C P U G X: class):
  $ wceq U (cfv G cbs) $ >
  $ wi ph (wcel A2 (co G C cga)) $ >
  $ wi ph (wcel X (co C A2 cfxp)) $ >
  $ wi ph (wcel P U) $ >
  $ wi ph (wceq (co P X A2) X) $;

--| Group conjugation induces a group action. (Contributed by Thierry Arnoux, 18-Nov-2025.)
theorem conjga {x3 y1: setvar} (B2 c_pl c_po M c_mi: class):
  $ wceq B2 (cfv M cbs) $ >
  $ wceq c_pl (cfv M cplusg) $ >
  $ wceq c_mi (cfv M csg) $ >
  $ wceq c_po (cmpo x3 y1 B2 B2 (co (co (cv x3) (cv y1) c_pl) (cv x3) c_mi)) $ >
  $ wi (wcel M cgrp) (wcel c_po (co M B2 cga)) $;

--| Express the center ` Z ` of a group ` M ` as the set of fixed points of the conjugation operation ` .(+) ` . (Contributed by Thierry Arnoux, 18-Nov-2025.)
theorem cntrval2 {x3 y1: setvar} (B2 c_pl c_po M c_mi: class) (Z: class x3 y1):
  $ wceq B2 (cfv M cbs) $ >
  $ wceq c_pl (cfv M cplusg) $ >
  $ wceq c_mi (cfv M csg) $ >
  $ wceq c_po (cmpo x3 y1 B2 B2 (co (co (cv x3) (cv y1) c_pl) (cv x3) c_mi)) $ >
  $ wceq Z (cfv M ccntr) $ >
  $ wi (wcel M cgrp) (wceq Z (co B2 c_po cfxp)) $;

--| Provided the group action ` A ` induces monoid automorphisms, the set of fixed points of ` A ` on a monoid ` W ` is a submonoid, which could be called the fixed submonoid under ` A ` . (Contributed by Thierry Arnoux, 18-Nov-2025.)
theorem fxpsubm {x3 p: setvar} (ph: wff) (A2 B2 C: class) (F: class x3 p) (G W: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq C (cfv W cbs) $ >
  $ wceq F (cmpt x3 C (co (cv p) (cv x3) A2)) $ >
  $ wi ph (wcel A2 (co G C cga)) $ >
  $ wi (wa ph (wcel (cv p) B2)) (wcel F (co W W cmhm)) $ >
  $ wi ph (wcel (co C A2 cfxp) (cfv W csubmnd)) $;

--| The fixed points of a group action ` A ` on a group ` W ` is a subgroup. (Contributed by Thierry Arnoux, 18-Nov-2025.)
theorem fxpsubg {x3 p: setvar} (ph: wff) (A2 B2 C: class) (F: class x3 p) (G W: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq C (cfv W cbs) $ >
  $ wceq F (cmpt x3 C (co (cv p) (cv x3) A2)) $ >
  $ wi ph (wcel A2 (co G C cga)) $ >
  $ wi (wa ph (wcel (cv p) B2)) (wcel F (co W W cghm)) $ >
  $ wi ph (wcel (co C A2 cfxp) (cfv W csubg)) $;

--| The fixed points of a group action ` A ` on a ring ` W ` is a subgring. (Contributed by Thierry Arnoux, 18-Nov-2025.)
theorem fxpsubrg {x3 p: setvar} (ph: wff) (A2 B2 C: class) (F: class x3 p) (G W: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq C (cfv W cbs) $ >
  $ wceq F (cmpt x3 C (co (cv p) (cv x3) A2)) $ >
  $ wi ph (wcel A2 (co G C cga)) $ >
  $ wi (wa ph (wcel (cv p) B2)) (wcel F (co W W crh)) $ >
  $ wi ph (wcel (co C A2 cfxp) (cfv W csubrg)) $;

--| The fixed points of a group action ` A ` on a division ring ` W ` is a sub-division-ring. Since sub-division-rings of fields are subfields (see ~ fldsdrgfld ), ` ( C FixPts A ) ` might be called the fixed subfield under ` A ` . (Contributed by Thierry Arnoux, 18-Nov-2025.)
theorem fxpsdrg {x3 p: setvar} (ph: wff) (A2 B2 C: class) (F: class x3 p) (G W: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq C (cfv W cbs) $ >
  $ wceq F (cmpt x3 C (co (cv p) (cv x3) A2)) $ >
  $ wi ph (wcel A2 (co G C cga)) $ >
  $ wi (wa ph (wcel (cv p) B2)) (wcel F (co W W crh)) $ >
  $ wi ph (wcel W cdr) $ >
  $ wi ph (wcel (co C A2 cfxp) (cfv W csdrg)) $;

--| Class notation for the infinitesimal relation.
term cinftm: class;

--| Class notation for the Archimedean property.
term carchi: class;

--| Define the relation " ` x ` is infinitesimal with respect to ` y ` " for a structure ` w ` . (Contributed by Thierry Arnoux, 30-Jan-2018.)
axiom df_inftm {x3 y1 w n: setvar}:
  $ wceq cinftm (cmpt w cvv (copab x3 y1 (wa (wa (wcel (cv x3) (cfv (cv w) cbs)) (wcel (cv y1) (cfv (cv w) cbs))) (wa (wbr (cfv (cv w) c0g) (cv x3) (cfv (cv w) cplt)) (wral n (wbr (co (cv n) (cv x3) (cfv (cv w) cmg)) (cv y1) (cfv (cv w) cplt)) cn))))) $;

--| A structure said to be Archimedean if it has no infinitesimal elements. (Contributed by Thierry Arnoux, 30-Jan-2018.)
axiom df_archi {w: setvar}:
  $ wceq carchi (cab w (wceq (cfv (cv w) cinftm) c0)) $;

--| The infinitesimal relation for a structure ` W ` . (Contributed by Thierry Arnoux, 30-Jan-2018.)
theorem inftmrel (B2 V W: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wi (wcel W V) (wss (cfv W cinftm) (cxp B2 B2)) $;

--| Express ` x ` is infinitesimal with respect to ` y ` for a structure ` W ` . (Contributed by Thierry Arnoux, 30-Jan-2018.)
theorem isinftm {n: setvar} (B2 c_lt c_x V: class n) (W X Y: class) (c_0: class n):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq c_x (cfv W cmg) $ >
  $ wceq c_lt (cfv W cplt) $ >
  $ wi (w3a (wcel W V) (wcel X B2) (wcel Y B2)) (wb (wbr X Y (cfv W cinftm)) (wa (wbr c_0 X c_lt) (wral n (wbr (co (cv n) X c_x) Y c_lt) cn))) $;

--| Express the predicate " ` W ` is Archimedean ". (Contributed by Thierry Arnoux, 30-Jan-2018.)
theorem isarchi {x3 y1: setvar} (B2: class) (c_lt V: class x3 y1) (W: class) (c_0: class x3 y1):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq c_lt (cfv W cinftm) $ >
  $ wi (wcel W V) (wb (wcel W carchi) (wral x3 (wral y1 (wn (wbr (cv x3) (cv y1) c_lt)) B2) B2)) $;

--| Plus infinity is an infinite for the completed real line, as any real number is infinitesimal compared to it. (Contributed by Thierry Arnoux, 1-Feb-2018.)
theorem pnfinf (A2: class):
  $ wi (wcel A2 crp) (wbr A2 cpnf (cfv cxrs cinftm)) $;

--| The completed real line is not Archimedean. (Contributed by Thierry Arnoux, 1-Feb-2018.)
theorem xrnarchi:
  $ wn (wcel cxrs carchi) $;

--| Alternative way to express the predicate " ` W ` is Archimedean ", for Tosets. (Contributed by Thierry Arnoux, 30-Jan-2018.)
theorem isarchi2 {x3 y1 n: setvar} (B2: class) (c_lt c_x c_le: class x3 y1 n) (W: class) (c_0: class x3 y1 n):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq c_x (cfv W cmg) $ >
  $ wceq c_le (cfv W cple) $ >
  $ wceq c_lt (cfv W cplt) $ >
  $ wi (wa (wcel W ctos) (wcel W cmnd)) (wb (wcel W carchi) (wral x3 (wral y1 (wi (wbr c_0 (cv x3) c_lt) (wrex n (wbr (cv y1) (co (cv n) (cv x3) c_x) c_le) cn)) B2) B2)) $;

--| A submonoid is archimedean. (Contributed by Thierry Arnoux, 16-Sep-2018.)
theorem submarchi (A2 W: class):
  $ wi (wa (wa (wcel W ctos) (wcel W carchi)) (wcel A2 (cfv W csubmnd))) (wcel (co W A2 cress) carchi) $;

--| This is the usual definition of the Archimedean property for an ordered group. (Contributed by Thierry Arnoux, 30-Jan-2018.)
theorem isarchi3 {x3 y1 n: setvar} (B2: class) (c_lt c_x: class x3 y1) (W: class) (c_0: class x3 y1):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq c_lt (cfv W cplt) $ >
  $ wceq c_x (cfv W cmg) $ >
  $ wi (wcel W cogrp) (wb (wcel W carchi) (wral x3 (wral y1 (wi (wbr c_0 (cv x3) c_lt) (wrex n (wbr (cv y1) (co (cv n) (cv x3) c_x) c_lt) cn)) B2) B2)) $;

--| Property of Archimedean ordered groups, framing positive ` Y ` between multiples of ` X ` . (Contributed by Thierry Arnoux, 12-Apr-2018.)
theorem archirng {n: setvar} (ph: wff) (B2: class n) (c_lt c_x c_le: class) (W: class n) (X Y c_0: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq c_lt (cfv W cplt) $ >
  $ wceq c_le (cfv W cple) $ >
  $ wceq c_x (cfv W cmg) $ >
  $ wi ph (wcel W cogrp) $ >
  $ wi ph (wcel W carchi) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wbr c_0 X c_lt) $ >
  $ wi ph (wbr c_0 Y c_lt) $ >
  $ wi ph (wrex n (wa (wbr (co (cv n) X c_x) Y c_lt) (wbr Y (co (co (cv n) c1 caddc) X c_x) c_le)) cn0) $;

--| Property of Archimedean left and right ordered groups. (Contributed by Thierry Arnoux, 6-May-2018.)
theorem archirngz {n: setvar} (ph: wff) (B2: class n) (c_lt c_x c_le: class) (W: class n) (X Y c_0: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq c_lt (cfv W cplt) $ >
  $ wceq c_le (cfv W cple) $ >
  $ wceq c_x (cfv W cmg) $ >
  $ wi ph (wcel W cogrp) $ >
  $ wi ph (wcel W carchi) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wbr c_0 X c_lt) $ >
  $ wi ph (wcel (cfv W coppg) cogrp) $ >
  $ wi ph (wrex n (wa (wbr (co (cv n) X c_x) Y c_lt) (wbr Y (co (co (cv n) c1 caddc) X c_x) c_le)) cz) $;

--| In an Archimedean group, given two positive elements, there exists a "divisor" ` n ` . (Contributed by Thierry Arnoux, 30-Jan-2018.)
theorem archiexdiv {n: setvar} (B2 c_lt c_x W X Y c_0: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq c_lt (cfv W cplt) $ >
  $ wceq c_x (cfv W cmg) $ >
  $ wi (w3a (wa (wcel W cogrp) (wcel W carchi)) (wa (wcel X B2) (wcel Y B2)) (wbr c_0 X c_lt)) (wrex n (wbr Y (co (cv n) X c_x) c_lt) cn) $;

--| Lemma for ~ archiabl : In case an archimedean group ` W ` admits a smallest positive element ` U ` , then any positive element ` X ` of ` W ` can be written as ` ( n .x. U ) ` with ` n e. NN ` . Since the reciprocal holds for negative elements, ` W ` is then isomorphic to ` ZZ ` . (Contributed by Thierry Arnoux, 12-Apr-2018.)
theorem archiabllem1a {x3 n: setvar} (ph: wff) (B2 c_lt c_x U: class) (c_le: class n) (W X c_0: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq c_le (cfv W cple) $ >
  $ wceq c_lt (cfv W cplt) $ >
  $ wceq c_x (cfv W cmg) $ >
  $ wi ph (wcel W cogrp) $ >
  $ wi ph (wcel W carchi) $ >
  $ wi ph (wcel U B2) $ >
  $ wi ph (wbr c_0 U c_lt) $ >
  $ wi (w3a ph (wcel (cv x3) B2) (wbr c_0 (cv x3) c_lt)) (wbr U (cv x3) c_le) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wbr c_0 X c_lt) $ >
  $ wi ph (wrex n (wceq X (co (cv n) U c_x)) cn) $;

--| Lemma for ~ archiabl . (Contributed by Thierry Arnoux, 13-Apr-2018.)
theorem archiabllem1b {x3 n: setvar} (ph: wff) (y1: setvar) (B2 c_lt c_x U: class) (c_le: class n) (W c_0: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq c_le (cfv W cple) $ >
  $ wceq c_lt (cfv W cplt) $ >
  $ wceq c_x (cfv W cmg) $ >
  $ wi ph (wcel W cogrp) $ >
  $ wi ph (wcel W carchi) $ >
  $ wi ph (wcel U B2) $ >
  $ wi ph (wbr c_0 U c_lt) $ >
  $ wi (w3a ph (wcel (cv x3) B2) (wbr c_0 (cv x3) c_lt)) (wbr U (cv x3) c_le) $ >
  $ wi (wa ph (wcel (cv y1) B2)) (wrex n (wceq (cv y1) (co (cv n) U c_x)) cz) $;

--| Archimedean ordered groups with a minimal positive value are abelian. (Contributed by Thierry Arnoux, 13-Apr-2018.)
theorem archiabllem1 {x3: setvar} (ph: wff) (B2 c_lt c_x U c_le W c_0: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq c_le (cfv W cple) $ >
  $ wceq c_lt (cfv W cplt) $ >
  $ wceq c_x (cfv W cmg) $ >
  $ wi ph (wcel W cogrp) $ >
  $ wi ph (wcel W carchi) $ >
  $ wi ph (wcel U B2) $ >
  $ wi ph (wbr c_0 U c_lt) $ >
  $ wi (w3a ph (wcel (cv x3) B2) (wbr c_0 (cv x3) c_lt)) (wbr U (cv x3) c_le) $ >
  $ wi ph (wcel W cabl) $;

--| Lemma for ~ archiabl , which requires the group to be both left- and right-ordered. (Contributed by Thierry Arnoux, 13-Apr-2018.)
theorem archiabllem2a {a b c: setvar} (ph: wff c) (B2 c_pl c_lt: class) (c_x: class a b c) (c_le W X c_0: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq c_le (cfv W cple) $ >
  $ wceq c_lt (cfv W cplt) $ >
  $ wceq c_x (cfv W cmg) $ >
  $ wi ph (wcel W cogrp) $ >
  $ wi ph (wcel W carchi) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wi ph (wcel (cfv W coppg) cogrp) $ >
  $ wi (w3a ph (wcel (cv a) B2) (wbr c_0 (cv a) c_lt)) (wrex b (wa (wbr c_0 (cv b) c_lt) (wbr (cv b) (cv a) c_lt)) B2) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wbr c_0 X c_lt) $ >
  $ wi ph (wrex c (wa (wbr c_0 (cv c) c_lt) (wbr (co (cv c) (cv c) c_pl) X c_le)) B2) $;

--| Lemma for ~ archiabl . (Contributed by Thierry Arnoux, 1-May-2018.)
theorem archiabllem2c {a b: setvar} (ph: wff) (B2 c_pl c_lt: class) (c_x: class a b) (c_le W X Y c_0: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq c_le (cfv W cple) $ >
  $ wceq c_lt (cfv W cplt) $ >
  $ wceq c_x (cfv W cmg) $ >
  $ wi ph (wcel W cogrp) $ >
  $ wi ph (wcel W carchi) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wi ph (wcel (cfv W coppg) cogrp) $ >
  $ wi (w3a ph (wcel (cv a) B2) (wbr c_0 (cv a) c_lt)) (wrex b (wa (wbr c_0 (cv b) c_lt) (wbr (cv b) (cv a) c_lt)) B2) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wn (wbr (co X Y c_pl) (co Y X c_pl) c_lt)) $;

--| Lemma for ~ archiabl . (Contributed by Thierry Arnoux, 1-May-2018.)
theorem archiabllem2b {a b: setvar} (ph: wff) (B2 c_pl c_lt: class) (c_x: class a b) (c_le W X Y c_0: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq c_le (cfv W cple) $ >
  $ wceq c_lt (cfv W cplt) $ >
  $ wceq c_x (cfv W cmg) $ >
  $ wi ph (wcel W cogrp) $ >
  $ wi ph (wcel W carchi) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wi ph (wcel (cfv W coppg) cogrp) $ >
  $ wi (w3a ph (wcel (cv a) B2) (wbr c_0 (cv a) c_lt)) (wrex b (wa (wbr c_0 (cv b) c_lt) (wbr (cv b) (cv a) c_lt)) B2) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (co X Y c_pl) (co Y X c_pl)) $;

--| Archimedean ordered groups with no minimal positive value are abelian. (Contributed by Thierry Arnoux, 1-May-2018.)
theorem archiabllem2 {a b: setvar} (ph: wff) (B2 c_pl c_lt: class) (c_x: class a b) (c_le W c_0: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq c_le (cfv W cple) $ >
  $ wceq c_lt (cfv W cplt) $ >
  $ wceq c_x (cfv W cmg) $ >
  $ wi ph (wcel W cogrp) $ >
  $ wi ph (wcel W carchi) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wi ph (wcel (cfv W coppg) cogrp) $ >
  $ wi (w3a ph (wcel (cv a) B2) (wbr c_0 (cv a) c_lt)) (wrex b (wa (wbr c_0 (cv b) c_lt) (wbr (cv b) (cv a) c_lt)) B2) $ >
  $ wi ph (wcel W cabl) $;

--| Archimedean left- and right- ordered groups are Abelian. (Contributed by Thierry Arnoux, 1-May-2018.)
theorem archiabl (W: class):
  $ wi (w3a (wcel W cogrp) (wcel (cfv W coppg) cogrp) (wcel W carchi)) (wcel W cabl) $;

--| Axiom of Archimedes : a characterization of the Archimedean property for ordered fields. (Contributed by Thierry Arnoux, 9-Apr-2018.)
theorem isarchiofld {x3 n: setvar} (B2 c_lt: class) (H: class n) (W: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq H (cfv W czrh) $ >
  $ wceq c_lt (cfv W cplt) $ >
  $ wi (wcel W cofld) (wb (wcel W carchi) (wral x3 (wrex n (wbr (cv x3) (cfv (cv n) H) c_lt) cn) B2)) $;

--| Extend class notation with class of all semimodules.
term cslmd: class;

--| Define the class of all (left) modules over semirings, i.e. semimodules, which are generalizations of left modules. A semimodule is a commutative monoid (=vectors) together with a semiring (=scalars) and a left scalar product connecting them. ` ( 0 [,] +oo ) ` for example is not a full fledged left module, but is a semimodule. Definition of [Golan] p. 149. (Contributed by Thierry Arnoux, 21-Mar-2018.)
axiom df_slmd {x3 w v t f2 g2 k s1 r q p a: setvar}:
  $ wceq cslmd (crab g2 (wsbc v (wsbc a (wsbc s1 (wsbc f2 (wsbc k (wsbc p (wsbc t (wa (wcel (cv f2) csrg) (wral q (wral r (wral x3 (wral w (wa (w3a (wcel (co (cv r) (cv w) (cv s1)) (cv v)) (wceq (co (cv r) (co (cv w) (cv x3) (cv a)) (cv s1)) (co (co (cv r) (cv w) (cv s1)) (co (cv r) (cv x3) (cv s1)) (cv a))) (wceq (co (co (cv q) (cv r) (cv p)) (cv w) (cv s1)) (co (co (cv q) (cv w) (cv s1)) (co (cv r) (cv w) (cv s1)) (cv a)))) (w3a (wceq (co (co (cv q) (cv r) (cv t)) (cv w) (cv s1)) (co (cv q) (co (cv r) (cv w) (cv s1)) (cv s1))) (wceq (co (cfv (cv f2) cur) (cv w) (cv s1)) (cv w)) (wceq (co (cfv (cv f2) c0g) (cv w) (cv s1)) (cfv (cv g2) c0g)))) (cv v)) (cv v)) (cv k)) (cv k))) (cfv (cv f2) cmulr)) (cfv (cv f2) cplusg)) (cfv (cv f2) cbs)) (cfv (cv g2) csca)) (cfv (cv g2) cvsca)) (cfv (cv g2) cplusg)) (cfv (cv g2) cbs)) ccmn) $;

--| The predicate "is a semimodule". (Contributed by NM, 4-Nov-2013.) (Revised by Mario Carneiro, 19-Jun-2014.) (Revised by Thierry Arnoux, 1-Apr-2018.)
theorem isslmd {x3 w r q: setvar} (c_pl c_pd c_x c_xp c_1 F K O V W c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_pd (cfv F cplusg) $ >
  $ wceq c_xp (cfv F cmulr) $ >
  $ wceq c_1 (cfv F cur) $ >
  $ wceq O (cfv F c0g) $ >
  $ wb (wcel W cslmd) (w3a (wcel W ccmn) (wcel F csrg) (wral q (wral r (wral x3 (wral w (wa (w3a (wcel (co (cv r) (cv w) c_x) V) (wceq (co (cv r) (co (cv w) (cv x3) c_pl) c_x) (co (co (cv r) (cv w) c_x) (co (cv r) (cv x3) c_x) c_pl)) (wceq (co (co (cv q) (cv r) c_pd) (cv w) c_x) (co (co (cv q) (cv w) c_x) (co (cv r) (cv w) c_x) c_pl))) (w3a (wceq (co (co (cv q) (cv r) c_xp) (cv w) c_x) (co (cv q) (co (cv r) (cv w) c_x) c_x)) (wceq (co c_1 (cv w) c_x) (cv w)) (wceq (co O (cv w) c_x) c_0))) V) V) K) K)) $;

--| Lemma for properties of a semimodule. (Contributed by NM, 8-Dec-2013.) (Revised by Mario Carneiro, 19-Jun-2014.) (Revised by Thierry Arnoux, 1-Apr-2018.)
theorem slmdlema (c_pl c_pd Q R c_x c_xp c_1 F K O V W X Y c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_pd (cfv F cplusg) $ >
  $ wceq c_xp (cfv F cmulr) $ >
  $ wceq c_1 (cfv F cur) $ >
  $ wceq O (cfv F c0g) $ >
  $ wi (w3a (wcel W cslmd) (wa (wcel Q K) (wcel R K)) (wa (wcel X V) (wcel Y V))) (wa (w3a (wcel (co R Y c_x) V) (wceq (co R (co Y X c_pl) c_x) (co (co R Y c_x) (co R X c_x) c_pl)) (wceq (co (co Q R c_pd) Y c_x) (co (co Q Y c_x) (co R Y c_x) c_pl))) (w3a (wceq (co (co Q R c_xp) Y c_x) (co Q (co R Y c_x) c_x)) (wceq (co c_1 Y c_x) Y) (wceq (co O Y c_x) c_0))) $;

--| Left semimodules generalize the notion of left modules. (Contributed by Thierry Arnoux, 1-Apr-2018.)
theorem lmodslmd (W: class):
  $ wi (wcel W clmod) (wcel W cslmd) $;

--| A semimodule is a commutative monoid. (Contributed by Thierry Arnoux, 1-Apr-2018.)
theorem slmdcmn (W: class):
  $ wi (wcel W cslmd) (wcel W ccmn) $;

--| A semimodule is a monoid. (Contributed by Thierry Arnoux, 1-Apr-2018.)
theorem slmdmnd (W: class):
  $ wi (wcel W cslmd) (wcel W cmnd) $;

--| The scalar component of a semimodule is a semiring. (Contributed by NM, 8-Dec-2013.) (Revised by Mario Carneiro, 19-Jun-2014.) (Revised by Thierry Arnoux, 1-Apr-2018.)
theorem slmdsrg (F W: class):
  $ wceq F (cfv W csca) $ >
  $ wi (wcel W cslmd) (wcel F csrg) $;

--| The base set of a semimodule is nonempty. (Contributed by Thierry Arnoux, 1-Apr-2018.) (Proof shortened by AV, 10-Jan-2023.)
theorem slmdbn0 (B2 W: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wi (wcel W cslmd) (wne B2 c0) $;

--| Closure of ring addition for a semimodule. (Contributed by Thierry Arnoux, 1-Apr-2018.)
theorem slmdacl (c_pl F K W X Y: class):
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_pl (cfv F cplusg) $ >
  $ wi (w3a (wcel W cslmd) (wcel X K) (wcel Y K)) (wcel (co X Y c_pl) K) $;

--| Closure of ring multiplication for a semimodule. (Contributed by NM, 14-Jan-2014.) (Revised by Mario Carneiro, 19-Jun-2014.) (Revised by Thierry Arnoux, 1-Apr-2018.)
theorem slmdmcl (c_x F K W X Y: class):
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_x (cfv F cmulr) $ >
  $ wi (w3a (wcel W cslmd) (wcel X K) (wcel Y K)) (wcel (co X Y c_x) K) $;

--| The set of scalars in a semimodule is nonempty. (Contributed by Thierry Arnoux, 1-Apr-2018.) (Proof shortened by AV, 10-Jan-2023.)
theorem slmdsn0 (B2 F W: class):
  $ wceq F (cfv W csca) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wi (wcel W cslmd) (wne B2 c0) $;

--| Closure of vector addition for a semiring left module. (Contributed by NM, 8-Dec-2013.) (Revised by Mario Carneiro, 19-Jun-2014.) (Revised by Thierry Arnoux, 1-Apr-2018.)
theorem slmdvacl (c_pl V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wi (w3a (wcel W cslmd) (wcel X V) (wcel Y V)) (wcel (co X Y c_pl) V) $;

--| Semiring left module vector sum is associative. (Contributed by NM, 10-Jan-2014.) (Revised by Mario Carneiro, 19-Jun-2014.) (Revised by Thierry Arnoux, 1-Apr-2018.)
theorem slmdass (c_pl V W X Y Z: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wi (wa (wcel W cslmd) (w3a (wcel X V) (wcel Y V) (wcel Z V))) (wceq (co (co X Y c_pl) Z c_pl) (co X (co Y Z c_pl) c_pl)) $;

--| Closure of scalar product for a semiring left module. ( ~ hvmulcl analog.) (Contributed by NM, 8-Dec-2013.) (Revised by Mario Carneiro, 19-Jun-2014.) (Revised by Thierry Arnoux, 1-Apr-2018.)
theorem slmdvscl (R c_x F K V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wi (w3a (wcel W cslmd) (wcel R K) (wcel X V)) (wcel (co R X c_x) V) $;

--| Distributive law for scalar product. ( ~ ax-hvdistr1 analog.) (Contributed by NM, 10-Jan-2014.) (Revised by Mario Carneiro, 22-Sep-2015.) (Revised by Thierry Arnoux, 1-Apr-2018.)
theorem slmdvsdi (c_pl R c_x F K V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wi (wa (wcel W cslmd) (w3a (wcel R K) (wcel X V) (wcel Y V))) (wceq (co R (co X Y c_pl) c_x) (co (co R X c_x) (co R Y c_x) c_pl)) $;

--| Distributive law for scalar product. ( ~ ax-hvdistr1 analog.) (Contributed by NM, 10-Jan-2014.) (Revised by Mario Carneiro, 22-Sep-2015.) (Revised by Thierry Arnoux, 1-Apr-2018.)
theorem slmdvsdir (c_pl c_pd Q R c_x F K V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_pd (cfv F cplusg) $ >
  $ wi (wa (wcel W cslmd) (w3a (wcel Q K) (wcel R K) (wcel X V))) (wceq (co (co Q R c_pd) X c_x) (co (co Q X c_x) (co R X c_x) c_pl)) $;

--| Associative law for scalar product. ( ~ ax-hvmulass analog.) (Contributed by NM, 10-Jan-2014.) (Revised by Mario Carneiro, 22-Sep-2015.) (Revised by Thierry Arnoux, 1-Apr-2018.)
theorem slmdvsass (Q R c_x c_xp F K V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_xp (cfv F cmulr) $ >
  $ wi (wa (wcel W cslmd) (w3a (wcel Q K) (wcel R K) (wcel X V))) (wceq (co (co Q R c_xp) X c_x) (co Q (co R X c_x) c_x)) $;

--| The ring zero in a semimodule belongs to the ring base set. (Contributed by NM, 11-Jan-2014.) (Revised by Mario Carneiro, 19-Jun-2014.) (Revised by Thierry Arnoux, 1-Apr-2018.)
theorem slmd0cl (F K W c_0: class):
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_0 (cfv F c0g) $ >
  $ wi (wcel W cslmd) (wcel c_0 K) $;

--| The ring unity in a semiring left module belongs to the ring base set. (Contributed by NM, 11-Jan-2014.) (Revised by Mario Carneiro, 19-Jun-2014.) (Revised by Thierry Arnoux, 1-Apr-2018.)
theorem slmd1cl (c_1 F K W: class):
  $ wceq F (cfv W csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_1 (cfv F cur) $ >
  $ wi (wcel W cslmd) (wcel c_1 K) $;

--| Scalar product with ring unity. ( ~ ax-hvmulid analog.) (Contributed by NM, 10-Jan-2014.) (Revised by Mario Carneiro, 19-Jun-2014.) (Revised by Thierry Arnoux, 1-Apr-2018.)
theorem slmdvs1 (c_x c_1 F V W X: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_1 (cfv F cur) $ >
  $ wi (wa (wcel W cslmd) (wcel X V)) (wceq (co c_1 X c_x) X) $;

--| The zero vector is a vector. ( ~ ax-hv0cl analog.) (Contributed by NM, 10-Jan-2014.) (Revised by Mario Carneiro, 19-Jun-2014.) (Revised by Thierry Arnoux, 1-Apr-2018.)
theorem slmd0vcl (V W c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi (wcel W cslmd) (wcel c_0 V) $;

--| Left identity law for the zero vector. ( ~ hvaddlid analog.) (Contributed by NM, 10-Jan-2014.) (Revised by Mario Carneiro, 19-Jun-2014.) (Revised by Thierry Arnoux, 1-Apr-2018.)
theorem slmd0vlid (c_pl V W X c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi (wa (wcel W cslmd) (wcel X V)) (wceq (co c_0 X c_pl) X) $;

--| Right identity law for the zero vector. ( ~ ax-hvaddid analog.) (Contributed by NM, 10-Jan-2014.) (Revised by Mario Carneiro, 19-Jun-2014.) (Revised by Thierry Arnoux, 1-Apr-2018.)
theorem slmd0vrid (c_pl V W X c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi (wa (wcel W cslmd) (wcel X V)) (wceq (co X c_0 c_pl) X) $;

--| Zero times a vector is the zero vector. Equation 1a of [Kreyszig] p. 51. ( ~ ax-hvmul0 analog.) (Contributed by NM, 12-Jan-2014.) (Revised by Mario Carneiro, 19-Jun-2014.) (Revised by Thierry Arnoux, 1-Apr-2018.)
theorem slmd0vs (c_x F O V W X c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq O (cfv F c0g) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi (wa (wcel W cslmd) (wcel X V)) (wceq (co O X c_x) c_0) $;

--| Anything times the zero vector is the zero vector. Equation 1b of [Kreyszig] p. 51. ( ~ hvmul0 analog.) (Contributed by NM, 12-Jan-2014.) (Revised by Mario Carneiro, 19-Jun-2014.) (Revised by Thierry Arnoux, 1-Apr-2018.)
theorem slmdvs0 (c_x F K W X c_0: class):
  $ wceq F (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi (wa (wcel W cslmd) (wcel X K)) (wceq (co X c_0 c_x) c_0) $;

--| Scalar product of a finite group sum for a left module over a semiring. (Contributed by Thierry Arnoux, 16-Mar-2018.)
theorem gsumvsca1 {k: setvar} (ph: wff) (A2 B2 P: class) (c_pl Q: class k) (c_x: class) (G K: class k) (W: class) (c_0: class k):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq G (cfv W csca) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wi ph (wss K (cfv G cbs)) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wcel W cslmd) $ >
  $ wi ph (wcel P K) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel Q B2) $ >
  $ wi ph (wceq (co W (cmpt k A2 (co P Q c_x)) cgsu) (co P (co W (cmpt k A2 Q) cgsu) c_x)) $;

--| Scalar product of a finite group sum for a left module over a semiring. (Contributed by Thierry Arnoux, 16-Mar-2018.) (Proof shortened by AV, 12-Dec-2019.)
theorem gsumvsca2 {k: setvar} (ph: wff) (A2 B2: class) (P c_pl: class k) (Q c_x G K W: class) (c_0: class k):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq G (cfv W csca) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wi ph (wss K (cfv G cbs)) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wcel W cslmd) $ >
  $ wi ph (wcel Q B2) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel P K) $ >
  $ wi ph (wceq (co W (cmpt k A2 (co P Q c_x)) cgsu) (co (co G (cmpt k A2 P) cgsu) Q c_x)) $;

--| A group of prime order is cyclic if and only if it is simple. This is the first family of finite simple groups. (Contributed by Thierry Arnoux, 21-Sep-2023.)
theorem prmsimpcyc (B2 G: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wi (wcel (cfv B2 chash) cprime) (wb (wcel G csimpg) (wcel G ccyg)) $;

--| A unital ring is a non-unital ring, deduction version. (Contributed by Thierry Arnoux, 15-Feb-2026.)
theorem ringrngd (ph: wff) (R: class):
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel R crng) $;

--| Sufficient condition for ring unities to be equal. (Contributed by Thierry Arnoux, 9-Mar-2025.)
theorem urpropd {x3 y1: setvar} (ph: wff) (B2 S T: class) (V W: class x3 y1):
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel S V) $ >
  $ wi ph (wcel T W) $ >
  $ wi ph (wceq B2 (cfv T cbs)) $ >
  $ wi (wa (wa ph (wcel (cv x3) B2)) (wcel (cv y1) B2)) (wceq (co (cv x3) (cv y1) (cfv S cmulr)) (co (cv x3) (cv y1) (cfv T cmulr))) $ >
  $ wi ph (wceq (cfv S cur) (cfv T cur)) $;

--| A subring is closed under multiplication. (Contributed by Thierry Arnoux, 6-Jul-2025.)
theorem subrgmcld (ph: wff) (A2 R c_x X Y: class):
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel A2 (cfv R csubrg)) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y A2) $ >
  $ wi ph (wcel (co X Y c_x) A2) $;

--| ` 1r ` is unaffected by restriction. This is a bit more generic than ~ subrg1 . (Contributed by Thierry Arnoux, 6-Sep-2018.)
theorem ress1r (A2 B2 R S c_1: class):
  $ wceq S (co R A2 cress) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (w3a (wcel R crg) (wcel c_1 A2) (wss A2 B2)) (wceq c_1 (cfv S cur)) $;

--| Ring exponentiation of minus one: Adding one to the exponent is the same as taking the additive inverse. (Contributed by Thierry Arnoux, 15-Feb-2026.)
theorem ringm1expp1 (ph: wff) (R c_1 c_ex K N: class):
  $ wceq c_1 (cfv R cur) $ >
  $ wceq N (cfv R cminusg) $ >
  $ wceq c_ex (cfv (cfv R cmgp) cmg) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel K cn0) $ >
  $ wi ph (wceq (co (co K c1 caddc) (cfv c_1 N) c_ex) (cfv (co K (cfv c_1 N) c_ex) N)) $;

--| The ring inverse expressed in terms of multiplication. (Contributed by Thierry Arnoux, 23-Oct-2017.)
theorem ringinvval {y1: setvar} (B2: class y1) (R U: class) (c_1 c_as N: class y1) (X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_as (cfv R cmulr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq N (cfv R cinvr) $ >
  $ wceq U (cfv R cui) $ >
  $ wi (wa (wcel R crg) (wcel X U)) (wceq (cfv X N) (crio y1 (wceq (co (cv y1) X c_as) c_1) U)) $;

--| Cancellation law for common factor in ratio. ( ~ divcan5 analog.) (Contributed by Thierry Arnoux, 26-Oct-2016.)
theorem dvrcan5 (B2 c_dv R c_x U X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq c_dv (cfv R cdvr) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wa (wcel R crg) (w3a (wcel X B2) (wcel Y U) (wcel Z U))) (wceq (co (co X Z c_x) (co Y Z c_x) c_dv) (co X Y c_dv)) $;

--| If ` A ` is a subring of ` R ` , then they have the same characteristic. (Contributed by Thierry Arnoux, 24-Feb-2018.)
theorem subrgchr (A2 R: class):
  $ wi (wcel A2 (cfv R csubrg)) (wceq (cfv (co R A2 cress) cchr) (cfv R cchr)) $;

--| A mapping of a multiplication of a constant with a function into a ring is finitely supported if the function is finitely supported. (Contributed by Thierry Arnoux, 3-Jun-2023.)
theorem rmfsupp2 {v: setvar} (ph: wff) (A2: class) (C: class v) (R M V: class) (X: class v):
  $ wceq R (cfv M cbs) $ >
  $ wi ph (wcel M crg) $ >
  $ wi ph (wcel V X) $ >
  $ wi (wa ph (wcel (cv v) V)) (wcel C R) $ >
  $ wi ph (wf V R A2) $ >
  $ wi ph (wbr A2 (cfv M c0g) cfsupp) $ >
  $ wi ph (wbr (cmpt v V (co (cfv (cv v) A2) C (cfv M cmulr))) (cfv M c0g) cfsupp) $;

--| In a nonzero ring, a unit cannot be zero. (Contributed by Thierry Arnoux, 25-Apr-2025.)
theorem unitnz (ph: wff) (R U X c_0: class):
  $ wceq U (cfv R cui) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel R cnzr) $ >
  $ wi ph (wcel X U) $ >
  $ wi ph (wne X c_0) $;

--| Alternate definition of being a unit. (Contributed by Thierry Arnoux, 3-Aug-2025.)
theorem isunit2 {v u: setvar} (B2 R: class) (c_x: class u) (U: class v u) (c_1 X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wb (wcel X U) (wa (wcel X B2) (wa (wrex u (wceq (co X (cv u) c_x) c_1) B2) (wrex v (wceq (co (cv v) X c_x) c_1) B2))) $;

--| Alternate definition of being a unit. (Contributed by Thierry Arnoux, 3-Aug-2025.)
theorem isunit3 {y1: setvar} (ph: wff) (B2 R c_x: class) (U: class y1) (c_1 X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wb (wcel X U) (wrex y1 (wa (wceq (co X (cv y1) c_x) c_1) (wceq (co (cv y1) X c_x) c_1)) B2)) $;

--| Characterize units in a commutative ring. (Contributed by Thierry Arnoux, 6-Jun-2026.)
theorem isunitc {y1: setvar} (ph: wff) (B2 R c_x: class) (U: class y1) (c_1 X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wb (wcel X U) (wrex y1 (wceq (co X (cv y1) c_x) c_1) B2)) $;

--| Lemma for ~ elrgspn . (Contributed by Thierry Arnoux, 5-Oct-2025.)
theorem elrgspnlem1 {w f2 g2: setvar} (ph: wff) (A2 B2 R: class) (S: class f2) (c_x F M: class) (N: class w f2 g2):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wceq c_x (cfv R cmg) $ >
  $ wceq N (cfv R crgspn) $ >
  $ wceq F (crab f2 (wbr (cv f2) cc0 cfsupp) (co cz (cword A2) cmap)) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wss A2 B2) $ >
  $ wceq S (crn (cmpt g2 F (co R (cmpt w (cword A2) (co (cfv (cv w) (cv g2)) (co M (cv w) cgsu) c_x)) cgsu))) $ >
  $ wi ph (wcel S (cfv R csubg)) $;

--| Lemma for ~ elrgspn . (Contributed by Thierry Arnoux, 5-Oct-2025.)
theorem elrgspnlem2 {w f2 g2: setvar} (ph: wff) (A2 B2 R: class) (S: class f2) (c_x F M: class) (N: class w f2 g2):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wceq c_x (cfv R cmg) $ >
  $ wceq N (cfv R crgspn) $ >
  $ wceq F (crab f2 (wbr (cv f2) cc0 cfsupp) (co cz (cword A2) cmap)) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wss A2 B2) $ >
  $ wceq S (crn (cmpt g2 F (co R (cmpt w (cword A2) (co (cfv (cv w) (cv g2)) (co M (cv w) cgsu) c_x)) cgsu))) $ >
  $ wi ph (wcel S (cfv R csubrg)) $;

--| Lemma for ~ elrgspn . (Contributed by Thierry Arnoux, 5-Oct-2025.)
theorem elrgspnlem3 {w f2 g2: setvar} (ph: wff) (A2 B2 R: class) (S: class f2) (c_x F M: class) (N: class w f2 g2):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wceq c_x (cfv R cmg) $ >
  $ wceq N (cfv R crgspn) $ >
  $ wceq F (crab f2 (wbr (cv f2) cc0 cfsupp) (co cz (cword A2) cmap)) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wss A2 B2) $ >
  $ wceq S (crn (cmpt g2 F (co R (cmpt w (cword A2) (co (cfv (cv w) (cv g2)) (co M (cv w) cgsu) c_x)) cgsu))) $ >
  $ wi ph (wss A2 S) $;

--| Lemma for ~ elrgspn . (Contributed by Thierry Arnoux, 5-Oct-2025.)
theorem elrgspnlem4 {w f2 g2: setvar} (ph: wff) (A2 B2 R: class) (S: class f2) (c_x F M: class) (N: class w f2 g2):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wceq c_x (cfv R cmg) $ >
  $ wceq N (cfv R crgspn) $ >
  $ wceq F (crab f2 (wbr (cv f2) cc0 cfsupp) (co cz (cword A2) cmap)) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wss A2 B2) $ >
  $ wceq S (crn (cmpt g2 F (co R (cmpt w (cword A2) (co (cfv (cv w) (cv g2)) (co M (cv w) cgsu) c_x)) cgsu))) $ >
  $ wi ph (wceq (cfv A2 N) S) $;

--| Membership in the subring generated by the subset ` A ` . An element ` X ` lies in that subring if and only if ` X ` is a linear combination with integer coefficients of products of elements of ` A ` . (Contributed by Thierry Arnoux, 5-Oct-2025.)
theorem elrgspn {w f2 g2: setvar} (ph: wff) (A2 B2 R c_x F M: class) (N: class w f2 g2) (X: class w):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wceq c_x (cfv R cmg) $ >
  $ wceq N (cfv R crgspn) $ >
  $ wceq F (crab f2 (wbr (cv f2) cc0 cfsupp) (co cz (cword A2) cmap)) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wb (wcel X (cfv A2 N)) (wrex g2 (wceq X (co R (cmpt w (cword A2) (co (cfv (cv w) (cv g2)) (co M (cv w) cgsu) c_x)) cgsu)) F)) $;

--| Lemma for ~ elrgspnsubrun , first direction. (Contributed by Thierry Arnoux, 13-Oct-2025.)
theorem elrgspnsubrunlem1 {e f2: setvar} (ph: wff) (B2: class f2) (P R T c_x E F: class) (N X: class e f2) (c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq N (cfv R crgspn) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel E (cfv R csubrg)) $ >
  $ wi ph (wcel F (cfv R csubrg)) $ >
  $ wi ph (wf F E P) $ >
  $ wi ph (wbr P c_0 cfsupp) $ >
  $ wi ph (wceq X (co R (cmpt e F (co (cfv (cv e) P) (cv e) c_x)) cgsu)) $ >
  $ wceq T (crn (cmpt f2 (co P c_0 csupp) (cs2 (cfv (cv f2) P) (cv f2)))) $ >
  $ wi ph (wcel X (cfv (cun E F) N)) $;

--| Lemma for ~ elrgspnsubrun , second direction. (Contributed by Thierry Arnoux, 13-Oct-2025.)
theorem elrgspnsubrunlem2 {w f2 p: setvar} (ph: wff) (B2: class p) (R c_x E F G: class) (N: class w f2 p) (X: class w f2) (c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq N (cfv R crgspn) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel E (cfv R csubrg)) $ >
  $ wi ph (wcel F (cfv R csubrg)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wf (cword (cun E F)) cz G) $ >
  $ wi ph (wbr G cc0 cfsupp) $ >
  $ wi ph (wceq X (co R (cmpt w (cword (cun E F)) (co (cfv (cv w) G) (co (cfv R cmgp) (cv w) cgsu) (cfv R cmg))) cgsu)) $ >
  $ wi ph (wrex p (wa (wbr (cv p) c_0 cfsupp) (wceq X (co R (cmpt f2 F (co (cfv (cv f2) (cv p)) (cv f2) c_x)) cgsu))) (co E F cmap)) $;

--| Membership in the ring span of the union of two subrings of a commutative ring. (Contributed by Thierry Arnoux, 13-Oct-2025.)
theorem elrgspnsubrun {f2 p: setvar} (ph: wff) (B2: class p) (R c_x E F N X c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq N (cfv R crgspn) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel E (cfv R csubrg)) $ >
  $ wi ph (wcel F (cfv R csubrg)) $ >
  $ wi ph (wb (wcel X (cfv (cun E F) N)) (wrex p (wa (wbr (cv p) c_0 cfsupp) (wceq X (co R (cmpt f2 F (co (cfv (cv f2) (cv p)) (cv f2) c_x)) cgsu))) (co E F cmap))) $;

--| A ring with an irreducible element cannot be the zero ring. (Contributed by Thierry Arnoux, 18-May-2025.)
theorem irrednzr (ph: wff) (R I X: class):
  $ wceq I (cfv R cir) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wcel R cnzr) $;

--| A subring of a zero ring is a zero ring. (Contributed by Thierry Arnoux, 5-Feb-2025.)
theorem _0ringsubrg (ph: wff) (B2 R S: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wceq (cfv B2 chash) c1) $ >
  $ wi ph (wcel S (cfv R csubrg)) $ >
  $ wi ph (wceq (cfv S chash) c1) $;

--| The zero ring is commutative. (Contributed by Thierry Arnoux, 18-May-2025.)
theorem _0ringcring (ph: wff) (B2 R: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wceq (cfv B2 chash) c1) $ >
  $ wi ph (wcel R ccrg) $;

--| Syntax for ring localization equivalence class operation.
term cerl: class;

--| Syntax for ring localization operation.
term crloc: class;

--| Define the operation giving the equivalence relation used in the localization of a ring ` r ` by a set ` s ` . Two pairs ` a = <. x , y >. ` and ` b = <. z , w >. ` are equivalent if there exists ` t e. s ` such that ` t x. ( x x. w - z x. y ) = 0 ` . This corresponds to the usual comparison of fractions ` x / y ` and ` z / w ` . (Contributed by Thierry Arnoux, 28-Apr-2025.)
axiom df_erl {x3 w t s1 r a b: setvar}:
  $ wceq cerl (cmpo r s1 cvv cvv (csb x3 (cfv (cv r) cmulr) (csb w (cxp (cfv (cv r) cbs) (cv s1)) (copab a b (wa (wa (wcel (cv a) (cv w)) (wcel (cv b) (cv w))) (wrex t (wceq (co (cv t) (co (co (cfv (cv a) c1st) (cfv (cv b) c2nd) (cv x3)) (co (cfv (cv b) c1st) (cfv (cv a) c2nd) (cv x3)) (cfv (cv r) csg)) (cv x3)) (cfv (cv r) c0g)) (cv s1))))))) $;

--| Define the operation giving the localization of a ring ` r ` by a given set ` s ` . The localized ring ` r RLocal s ` is the set of equivalence classes of pairs of elements in ` r ` over the relation ` r ~RL s ` with addition and multiplication defined naturally. (Contributed by Thierry Arnoux, 27-Apr-2025.)
axiom df_rloc {x3 w k s1 r a b: setvar}:
  $ wceq crloc (cmpo r s1 cvv cvv (csb x3 (cfv (cv r) cmulr) (csb w (cxp (cfv (cv r) cbs) (cv s1)) (co (cun (cun (ctp (cop (cfv cnx cbs) (cv w)) (cop (cfv cnx cplusg) (cmpo a b (cv w) (cv w) (cop (co (co (cfv (cv a) c1st) (cfv (cv b) c2nd) (cv x3)) (co (cfv (cv b) c1st) (cfv (cv a) c2nd) (cv x3)) (cfv (cv r) cplusg)) (co (cfv (cv a) c2nd) (cfv (cv b) c2nd) (cv x3))))) (cop (cfv cnx cmulr) (cmpo a b (cv w) (cv w) (cop (co (cfv (cv a) c1st) (cfv (cv b) c1st) (cv x3)) (co (cfv (cv a) c2nd) (cfv (cv b) c2nd) (cv x3)))))) (ctp (cop (cfv cnx csca) (cfv (cv r) csca)) (cop (cfv cnx cvsca) (cmpo k a (cfv (cfv (cv r) csca) cbs) (cv w) (cop (co (cv k) (cfv (cv a) c1st) (cfv (cv r) cvsca)) (cfv (cv a) c2nd)))) (cop (cfv cnx cip) c0))) (ctp (cop (cfv cnx cts) (co (cfv (cv r) cts) (co (cfv (cv r) cts) (cv s1) crest) ctx)) (cop (cfv cnx cple) (copab a b (wa (wa (wcel (cv a) (cv w)) (wcel (cv b) (cv w))) (wbr (co (cfv (cv a) c1st) (cfv (cv b) c2nd) (cv x3)) (co (cfv (cv b) c1st) (cfv (cv a) c2nd) (cv x3)) (cfv (cv r) cple))))) (cop (cfv cnx cds) (cmpo a b (cv w) (cv w) (co (co (cfv (cv a) c1st) (cfv (cv b) c2nd) (cv x3)) (co (cfv (cv b) c1st) (cfv (cv a) c2nd) (cv x3)) (cfv (cv r) cds)))))) (co (cv r) (cv s1) cerl) cqus)))) $;

--| Ring localization is a proper operator, so it can be used with ~ ovprc1 . (Contributed by Thierry Arnoux, 10-May-2025.)
theorem reldmrloc:
  $ wrel (cdm crloc) $;

--| Value of the ring localization equivalence relation. (Contributed by Thierry Arnoux, 4-May-2025.)
theorem erlval {t a b: setvar} (ph: wff t) (B2 c_sm: class t a b) (R S c_x: class) (c_mi: class t a b) (W: class) (c_0: class t a b):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_mi (cfv R csg) $ >
  $ wceq W (cxp B2 S) $ >
  $ wceq c_sm (copab a b (wa (wa (wcel (cv a) W) (wcel (cv b) W)) (wrex t (wceq (co (cv t) (co (co (cfv (cv a) c1st) (cfv (cv b) c2nd) c_x) (co (cfv (cv b) c1st) (cfv (cv a) c2nd) c_x) c_mi) c_x) c_0) S))) $ >
  $ wi ph (wss S B2) $ >
  $ wi ph (wceq (co R S cerl) c_sm) $;

--| Expand the value of the ring localization operation. (Contributed by Thierry Arnoux, 4-May-2025.)
theorem rlocval {k a b: setvar} (ph: wff k a b) (B2 C D c_pl c_po c_sm: class k a b) (R S c_x: class) (c_xp c_xo E F J K c_le c_mi V: class k a b) (W: class) (c_0 c_le2: class k a b):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_mi (cfv R csg) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_le (cfv R cple) $ >
  $ wceq F (cfv R csca) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq C (cfv R cvsca) $ >
  $ wceq W (cxp B2 S) $ >
  $ wceq c_sm (co R S cerl) $ >
  $ wceq J (cfv R cts) $ >
  $ wceq D (cfv R cds) $ >
  $ wceq c_po (cmpo a b W W (cop (co (co (cfv (cv a) c1st) (cfv (cv b) c2nd) c_x) (co (cfv (cv b) c1st) (cfv (cv a) c2nd) c_x) c_pl) (co (cfv (cv a) c2nd) (cfv (cv b) c2nd) c_x))) $ >
  $ wceq c_xo (cmpo a b W W (cop (co (cfv (cv a) c1st) (cfv (cv b) c1st) c_x) (co (cfv (cv a) c2nd) (cfv (cv b) c2nd) c_x))) $ >
  $ wceq c_xp (cmpo k a K W (cop (co (cv k) (cfv (cv a) c1st) C) (cfv (cv a) c2nd))) $ >
  $ wceq c_le2 (copab a b (wa (wa (wcel (cv a) W) (wcel (cv b) W)) (wbr (co (cfv (cv a) c1st) (cfv (cv b) c2nd) c_x) (co (cfv (cv b) c1st) (cfv (cv a) c2nd) c_x) c_le))) $ >
  $ wceq E (cmpo a b W W (co (co (cfv (cv a) c1st) (cfv (cv b) c2nd) c_x) (co (cfv (cv b) c1st) (cfv (cv a) c2nd) c_x) D)) $ >
  $ wi ph (wcel R V) $ >
  $ wi ph (wss S B2) $ >
  $ wi ph (wceq (co R S crloc) (co (cun (cun (ctp (cop (cfv cnx cbs) W) (cop (cfv cnx cplusg) c_po) (cop (cfv cnx cmulr) c_xo)) (ctp (cop (cfv cnx csca) F) (cop (cfv cnx cvsca) c_xp) (cop (cfv cnx cip) c0))) (ctp (cop (cfv cnx cts) (co J (co J S crest) ctx)) (cop (cfv cnx cple) c_le2) (cop (cfv cnx cds) E))) c_sm cqus)) $;

--| Closure for the ring localization equivalence relation. (Contributed by Thierry Arnoux, 4-May-2025.)
theorem erlcl1 (ph: wff) (B2 c_sm R S U V: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_sm (co R S cerl) $ >
  $ wi ph (wss S B2) $ >
  $ wi ph (wbr U V c_sm) $ >
  $ wi ph (wcel U (cxp B2 S)) $;

--| Closure for the ring localization equivalence relation. (Contributed by Thierry Arnoux, 4-May-2025.)
theorem erlcl2 (ph: wff) (B2 c_sm R S U V: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_sm (co R S cerl) $ >
  $ wi ph (wss S B2) $ >
  $ wi ph (wbr U V c_sm) $ >
  $ wi ph (wcel V (cxp B2 S)) $;

--| Main property of the ring localization equivalence relation. (Contributed by Thierry Arnoux, 4-May-2025.)
theorem erldi {t: setvar} (ph: wff t) (B2: class) (c_sm: class t) (R S c_x U: class) (c_mi: class t) (V: class) (c_0: class t):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_sm (co R S cerl) $ >
  $ wi ph (wss S B2) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_mi (cfv R csg) $ >
  $ wi ph (wbr U V c_sm) $ >
  $ wi ph (wrex t (wceq (co (cv t) (co (co (cfv U c1st) (cfv V c2nd) c_x) (co (cfv V c1st) (cfv U c2nd) c_x) c_mi) c_x) c_0) S) $;

--| Deduce the ring localization equivalence relation. If for some ` T e. S ` we have ` T x. ( E x. H - F x. G ) = 0 ` , then pairs ` <. E , G >. ` and ` <. F , H >. ` are equivalent under the localization relation. (Contributed by Thierry Arnoux, 4-May-2025.)
theorem erlbrd (ph: wff) (B2 c_sm R S T c_x U E F G H c_mi V c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_sm (co R S cerl) $ >
  $ wi ph (wss S B2) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_mi (cfv R csg) $ >
  $ wi ph (wceq U (cop E G)) $ >
  $ wi ph (wceq V (cop F H)) $ >
  $ wi ph (wcel E B2) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel G S) $ >
  $ wi ph (wcel H S) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wceq (co T (co (co E H c_x) (co F G c_x) c_mi) c_x) c_0) $ >
  $ wi ph (wbr U V c_sm) $;

--| Deduce the ring localization equivalence relation. Pairs ` <. E , G >. ` and ` <. T x. E , T x. G >. ` for ` T e. S ` are equivalent under the localization relation. (Contributed by Thierry Arnoux, 4-May-2025.)
theorem erlbr2d (ph: wff) (B2 c_sm R S T c_x U E F G H V: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_sm (co R S cerl) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S (cfv (cfv R cmgp) csubmnd)) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wceq U (cop E G)) $ >
  $ wi ph (wceq V (cop F H)) $ >
  $ wi ph (wcel E B2) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel G S) $ >
  $ wi ph (wcel H S) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wceq F (co T E c_x)) $ >
  $ wi ph (wceq H (co T G c_x)) $ >
  $ wi ph (wbr U V c_sm) $;

--| The relation used to build the ring localization is an equivalence relation. (Contributed by Thierry Arnoux, 4-May-2025.)
theorem erler (ph: wff) (B2 c_sm R S c_x c_1 c_mi W c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_mi (cfv R csg) $ >
  $ wceq W (cxp B2 S) $ >
  $ wceq c_sm (co R S cerl) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S (cfv (cfv R cmgp) csubmnd)) $ >
  $ wi ph (wer W c_sm) $;

--| Main property of the ring localization equivalence relation. (Contributed by Thierry Arnoux, 4-May-2025.)
theorem erld2 {t: setvar} (ph: wff) (B2: class) (c_sm: class t) (R S c_x W X Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_sm (co R S cerl) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S (cfv (cfv R cmgp) csubmnd)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y S) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wcel W S) $ >
  $ wi ph (wceq (cec (cop X Y) c_sm) (cec (cop Z W) c_sm)) $ >
  $ wi ph (wrex t (wceq (co (cv t) (co X W c_x) c_x) (co (cv t) (co Z Y c_x) c_x)) S) $;

--| Membership in the basis of a ring localization. (Contributed by Thierry Arnoux, 4-May-2025.)
theorem elrlocbasi {a b: setvar} (ph: wff) (B2 c_sm S X: class):
  $ wi ph (wcel X (cqs (cxp B2 S) c_sm)) $ >
  $ wi ph (wrex a (wrex b (wceq X (cec (cop (cv a) (cv b)) c_sm)) S) B2) $;

--| The base set of a ring localization. (Contributed by Thierry Arnoux, 4-May-2025.)
theorem rlocbas (ph: wff) (B2 c_sm R S c_x L c_mi V W c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_mi (cfv R csg) $ >
  $ wceq W (cxp B2 S) $ >
  $ wceq L (co R S crloc) $ >
  $ wceq c_sm (co R S cerl) $ >
  $ wi ph (wcel R V) $ >
  $ wi ph (wss S B2) $ >
  $ wi ph (wceq (cqs W c_sm) (cfv L cbs)) $;

--| Value of the addition in the ring localization, given two representatives. (Contributed by Thierry Arnoux, 4-May-2025.)
theorem rlocaddval (ph: wff) (B2 c_pl c_po c_sm R S c_x E F G H L: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq L (co R S crloc) $ >
  $ wceq c_sm (co R S cerl) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S (cfv (cfv R cmgp) csubmnd)) $ >
  $ wi ph (wcel E B2) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel G S) $ >
  $ wi ph (wcel H S) $ >
  $ wceq c_po (cfv L cplusg) $ >
  $ wi ph (wceq (co (cec (cop E G) c_sm) (cec (cop F H) c_sm) c_po) (cec (cop (co (co E H c_x) (co F G c_x) c_pl) (co G H c_x)) c_sm)) $;

--| Value of the addition in the ring localization, given two representatives. (Contributed by Thierry Arnoux, 4-May-2025.)
theorem rlocmulval (ph: wff) (B2 c_pl c_sm R S c_x c_xo E F G H L: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq L (co R S crloc) $ >
  $ wceq c_sm (co R S cerl) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S (cfv (cfv R cmgp) csubmnd)) $ >
  $ wi ph (wcel E B2) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel G S) $ >
  $ wi ph (wcel H S) $ >
  $ wceq c_xo (cfv L cmulr) $ >
  $ wi ph (wceq (co (cec (cop E G) c_sm) (cec (cop F H) c_sm) c_xo) (cec (cop (co E F c_x) (co G H c_x)) c_sm)) $;

--| The ring localization ` L ` of a commutative ring ` R ` by a multiplicatively closed set ` S ` is itself a commutative ring. (Contributed by Thierry Arnoux, 4-May-2025.)
theorem rloccring (ph: wff) (B2 c_pl c_sm R S c_x L: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq L (co R S crloc) $ >
  $ wceq c_sm (co R S cerl) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S (cfv (cfv R cmgp) csubmnd)) $ >
  $ wi ph (wcel L ccrg) $;

--| The zero of a ring localization. (Contributed by Thierry Arnoux, 4-May-2025.)
theorem rloc0g (ph: wff) (c_sm R S c_1 L O c_0: class):
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq L (co R S crloc) $ >
  $ wceq c_sm (co R S cerl) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S (cfv (cfv R cmgp) csubmnd)) $ >
  $ wceq O (cec (cop c_0 c_1) c_sm) $ >
  $ wi ph (wceq O (cfv L c0g)) $;

--| The multiplicative identity of a ring localization. (Contributed by Thierry Arnoux, 4-May-2025.)
theorem rloc1r (ph: wff) (c_sm R S c_1 I L c_0: class):
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq L (co R S crloc) $ >
  $ wceq c_sm (co R S cerl) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S (cfv (cfv R cmgp) csubmnd)) $ >
  $ wceq I (cec (cop c_1 c_1) c_sm) $ >
  $ wi ph (wceq I (cfv L cur)) $;

--| The embedding ` F ` of a ring ` R ` into its localization ` L ` . (Contributed by Thierry Arnoux, 4-May-2025.)
theorem rlocf1 {x3: setvar} (ph: wff) (B2 c_sm R S c_1 F L: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq L (co R S crloc) $ >
  $ wceq c_sm (co R S cerl) $ >
  $ wceq F (cmpt x3 B2 (cec (cop (cv x3) c_1) c_sm)) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S (cfv (cfv R cmgp) csubmnd)) $ >
  $ wi ph (wss S (cfv R crlreg)) $ >
  $ wi ph (wa (wf1 B2 (cqs (cxp B2 S) c_sm) F) (wcel F (co R L crh))) $;

--| In the localization of a ring ` R ` at ` S ` , inverses of elements of ` S ` are units. (Contributed by Thierry Arnoux, 6-Jun-2026.)
theorem rlocinvunit (ph: wff) (B2 Q c_sm R S c_1 L W: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_sm (co R S cerl) $ >
  $ wceq L (co R S crloc) $ >
  $ wceq W (cfv L cui) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S (cfv (cfv R cmgp) csubmnd)) $ >
  $ wi ph (wcel Q S) $ >
  $ wi ph (wcel (cec (cop c_1 Q) c_sm) W) $;

--| Characterize the units of the localization ` L ` of a ring ` R ` at ` S ` as the elements with a "numerator" ` P ` in the saturation ` T ` of ` S ` . (Contributed by Thierry Arnoux, 6-Jun-2026.)
theorem rlocisunit {s1 r: setvar} (ph: wff) (B2 P: class) (Q: class s1) (c_sm R S: class) (T: class s1 r) (c_x L: class) (W: class s1 r):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq L (co R S crloc) $ >
  $ wceq W (cfv L cui) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S (cfv (cfv R cmgp) csubmnd)) $ >
  $ wceq c_sm (co R S cerl) $ >
  $ wi ph (wcel P B2) $ >
  $ wi ph (wcel Q S) $ >
  $ wceq T (crab r (wrex s1 (wcel (co (cv r) (cv s1) c_x) S) B2) B2) $ >
  $ wi ph (wb (wcel (cec (cop P Q) c_sm) W) (wcel P T)) $;

--| In a domain, factors of a nonzero product are nonzero. (Contributed by Thierry Arnoux, 8-Jun-2025.)
theorem domnmuln0rd (ph: wff) (B2 R c_x X Y c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel R cdomn) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wne (co X Y c_x) c_0) $ >
  $ wi ph (wa (wne X c_0) (wne Y c_0)) $;

--| In a domain, a finite product of nonzero terms is nonzero. (Contributed by Thierry Arnoux, 6-Jun-2025.)
theorem domnprodn0 (ph: wff) (B2 R F M c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel R cdomn) $ >
  $ wi ph (wcel F (cword (cdif B2 (csn c_0)))) $ >
  $ wi ph (wne (co M F cgsu) c_0) $;

--| A product over a domain is zero exactly when one of the factors is zero. Generalization of ~ domneq0 for any number of factors. See also ~ domnprodn0 . (Contributed by Thierry Arnoux, 15-Feb-2026.)
theorem domnprodeq0 (ph: wff) (A2 B2 R F M c_0: class):
  $ wceq M (cfv R cmgp) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel R cidom) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wb (wceq (co M F cgsu) c_0) (wcel c_0 (crn F))) $;

--| If two structures have the same components (properties), one is a domain iff the other one is. (Contributed by Thierry Arnoux, 13-Oct-2025.)
theorem domnpropd {x3 y1: setvar} (ph: wff) (B2 K L: class):
  $ wi ph (wceq B2 (cfv K cbs)) $ >
  $ wi ph (wceq B2 (cfv L cbs)) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cplusg)) (co (cv x3) (cv y1) (cfv L cplusg))) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cmulr)) (co (cv x3) (cv y1) (cfv L cmulr))) $ >
  $ wi ph (wb (wcel K cdomn) (wcel L cdomn)) $;

--| If two structures have the same components (properties), one is a integral domain iff the other one is. See also ~ domnpropd . (Contributed by Thierry Arnoux, 13-Oct-2025.)
theorem idompropd {x3 y1: setvar} (ph: wff) (B2 K L: class):
  $ wi ph (wceq B2 (cfv K cbs)) $ >
  $ wi ph (wceq B2 (cfv L cbs)) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cplusg)) (co (cv x3) (cv y1) (cfv L cplusg))) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cmulr)) (co (cv x3) (cv y1) (cfv L cmulr))) $ >
  $ wi ph (wb (wcel K cidom) (wcel L cidom)) $;

--| Right-cancellation law for integral domains. (Contributed by Thierry Arnoux, 22-Mar-2025.) (Proof shortened by SN, 21-Jun-2025.)
theorem idomrcan (ph: wff) (B2 R c_x X Y c_0 Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z (cdif B2 (csn c_0))) $ >
  $ wi ph (wcel R cidom) $ >
  $ wi ph (wceq (co X Z c_x) (co Y Z c_x)) $ >
  $ wi ph (wceq X Y) $;

--| The multiplicative identity is a left-regular element. (Contributed by Thierry Arnoux, 6-May-2025.)
theorem _1rrg (ph: wff) (R c_1 E: class):
  $ wceq c_1 (cfv R cur) $ >
  $ wceq E (cfv R crlreg) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel c_1 E) $;

--| The left regular elements of a ring form a submonoid of the multiplicative group. (Contributed by Thierry Arnoux, 10-May-2025.)
theorem rrgsubm (ph: wff) (R E M: class):
  $ wceq E (cfv R crlreg) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel E (cfv M csubmnd)) $;

--| A subring of a domain is a domain. (Contributed by Thierry Arnoux, 18-May-2025.)
theorem subrdom (ph: wff) (R S: class):
  $ wi ph (wcel R cdomn) $ >
  $ wi ph (wcel S (cfv R csubrg)) $ >
  $ wi ph (wcel (co R S cress) cdomn) $;

--| A subring of an integral domain is an integral domain. (Contributed by Thierry Arnoux, 18-May-2025.)
theorem subridom (ph: wff) (R S: class):
  $ wi ph (wcel R cidom) $ >
  $ wi ph (wcel S (cfv R csubrg)) $ >
  $ wi ph (wcel (co R S cress) cidom) $;

--| A subring of a field is an integral domain. (Contributed by Thierry Arnoux, 18-May-2025.)
theorem subrfld (ph: wff) (R S: class):
  $ wi ph (wcel R cfield) $ >
  $ wi ph (wcel S (cfv R csubrg)) $ >
  $ wi ph (wcel (co R S cress) cidom) $;

--| A ring isomorphism maps a nonzero ring to a nonzero ring. (Contributed by Thierry Arnoux, 4-May-2026.)
theorem ricnzr1 (R S: class):
  $ wi (wa (wbr R S cric) (wcel R cnzr)) (wcel S cnzr) $;

--| A ring isomorphism maps a domain to a domain. (Contributed by Thierry Arnoux, 4-May-2026.)
theorem ricdomn1 (R S: class):
  $ wi (wa (wbr R S cric) (wcel R cdomn)) (wcel S cdomn) $;

--| A ring is a domain if and only if an isomorphic ring is a domain. (Contributed by Thierry Arnoux, 4-May-2026.)
theorem ricdomn (R S: class):
  $ wi (wbr R S cric) (wb (wcel R cdomn) (wcel S cdomn)) $;

--| Declare the syntax for the Euclidean function index extractor.
term ceuf: class;

--| Define the Euclidean function. (Contributed by Thierry Arnoux, 22-Mar-2025.) Use its index-independent form ~ eufid instead. (New usage is discouraged.)
axiom df_euf:
  $ wceq ceuf (cslot (cdc c2 c1)) $;

--| Index value of the Euclidean function slot. Use ~ ndxarg . (Contributed by Thierry Arnoux, 22-Mar-2025.) (New usage is discouraged.)
theorem eufndx:
  $ wceq (cfv cnx ceuf) (cdc c2 c1) $;

--| Utility theorem: index-independent form of ~ df-euf . (Contributed by Thierry Arnoux, 22-Mar-2025.)
theorem eufid:
  $ wceq ceuf (cslot (cfv cnx ceuf)) $;

--| Declare the syntax for the Euclidean Domain.
term cedom: class;

--| Define Euclidean Domains. (Contributed by Thierry Arnoux, 22-Mar-2025.)
axiom df_edom {v e r q a b d: setvar}:
  $ wceq cedom (crab d (wsbc e (wsbc v (w3a (wfun (cv e)) (wss (cima (cv e) (cdif (cv v) (csn (cfv (cv d) c0g)))) (co cc0 cpnf cico)) (wral a (wral b (wrex q (wrex r (wa (wceq (cv a) (co (co (cv b) (cv q) (cfv (cv d) cmulr)) (cv r) (cfv (cv d) cplusg))) (wo (wceq (cv r) (cfv (cv d) c0g)) (wbr (cfv (cv r) (cv e)) (cfv (cv b) (cv e)) clt))) (cv v)) (cv v)) (cdif (cv v) (csn (cfv (cv d) c0g)))) (cv v))) (cfv (cv d) cbs)) (cfv (cv d) ceuf)) cidom) $;

--| The image of a division ring by a ring homomorphism is a division ring. (Contributed by Thierry Arnoux, 25-Feb-2025.)
theorem rndrhmcl (ph: wff) (R F M N c_0: class):
  $ wceq R (co N (crn F) cress) $ >
  $ wceq c_0 (cfv N c0g) $ >
  $ wi ph (wcel F (co M N crh)) $ >
  $ wi ph (wne (crn F) (csn c_0)) $ >
  $ wi ph (wcel M cdr) $ >
  $ wi ph (wcel R cdr) $;

--| The field of rational numbers is a field. (Contributed by Thierry Arnoux, 19-Oct-2025.)
theorem qfld (Q: class):
  $ wceq Q (co ccnfld cq cress) $ >
  $ wcel Q cfield $;

--| A subring of a sub-division-ring is a sub-division-ring. See also ~ subsubrg . (Contributed by Thierry Arnoux, 26-Oct-2025.)
theorem subsdrg (ph: wff) (A2 B2 R S: class):
  $ wceq S (co R A2 cress) $ >
  $ wi ph (wcel A2 (cfv R csdrg)) $ >
  $ wi ph (wb (wcel B2 (cfv S csdrg)) (wa (wcel B2 (cfv R csdrg)) (wss B2 A2))) $;

--| A sub-division-ring is closed under the ring division operation. (Contributed by Thierry Arnoux, 15-Jan-2025.)
theorem sdrgdvcl (ph: wff) (A2 c_dv R X Y c_0: class):
  $ wceq c_dv (cfv R cdvr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel A2 (cfv R csdrg)) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y A2) $ >
  $ wi ph (wne Y c_0) $ >
  $ wi ph (wcel (co X Y c_dv) A2) $;

--| A sub-division-ring is closed under the ring inverse operation. (Contributed by Thierry Arnoux, 15-Jan-2025.)
theorem sdrginvcl (A2 R I X c_0: class):
  $ wceq I (cfv R cinvr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (w3a (wcel A2 (cfv R csdrg)) (wcel X A2) (wne X c_0)) (wcel (cfv X I) A2) $;

--| The characteristic of a prime field is the same as the characteristic of the main field. (Contributed by Thierry Arnoux, 21-Aug-2023.)
theorem primefldchr (P R: class):
  $ wceq P (co R (cint (cfv R csdrg)) cress) $ >
  $ wi (wcel R cdr) (wceq (cfv P cchr) (cfv R cchr)) $;

--| Syntax for the field of fractions of a given integral domain.
term cfrac: class;

--| Define the field of fractions of a given integral domain. (Contributed by Thierry Arnoux, 26-Apr-2025.)
axiom df_frac {r: setvar}:
  $ wceq cfrac (cmpt r cvv (co (cv r) (cfv (cv r) crlreg) crloc)) $;

--| Value of the field of fractions. (Contributed by Thierry Arnoux, 5-May-2025.)
theorem fracval (R: class):
  $ wceq (cfv R cfrac) (co R (cfv R crlreg) crloc) $;

--| The base of the field of fractions. (Contributed by Thierry Arnoux, 10-May-2025.)
theorem fracbas (B2 c_sm R E F: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq E (cfv R crlreg) $ >
  $ wceq F (cfv R cfrac) $ >
  $ wceq c_sm (co R E cerl) $ >
  $ wceq (cqs (cxp B2 E) c_sm) (cfv F cbs) $;

--| Rewrite the ring localization equivalence relation in the case of a field of fractions. (Contributed by Thierry Arnoux, 5-May-2025.)
theorem fracerl (ph: wff) (B2 c_sm R c_x E F G H: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_sm (co R (cfv R crlreg) cerl) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel E B2) $ >
  $ wi ph (wcel G B2) $ >
  $ wi ph (wcel F (cfv R crlreg)) $ >
  $ wi ph (wcel H (cfv R crlreg)) $ >
  $ wi ph (wb (wbr (cop E F) (cop G H) c_sm) (wceq (co E H c_x) (co G F c_x))) $;

--| The embedding of a commutative ring ` R ` into its field of fractions. (Contributed by Thierry Arnoux, 10-May-2025.)
theorem fracf1 {x3: setvar} (ph: wff) (B2 c_sm R c_1 E F: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq E (cfv R crlreg) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wceq c_sm (co R E cerl) $ >
  $ wceq F (cmpt x3 B2 (cec (cop (cv x3) c_1) c_sm)) $ >
  $ wi ph (wa (wf1 B2 (cqs (cxp B2 E) c_sm) F) (wcel F (co R (cfv R cfrac) crh))) $;

--| The field of fractions of an integral domain is a field. (Contributed by Thierry Arnoux, 4-May-2025.)
theorem fracfld (ph: wff) (R: class):
  $ wi ph (wcel R cidom) $ >
  $ wi ph (wcel (cfv R cfrac) cfield) $;

--| Every integral domain is isomorphic with a subring of some field. (Proposed by Gerard Lang, 10-May-2025.) (Contributed by Thierry Arnoux, 10-May-2025.)
theorem idomsubr {f2 s1: setvar} (ph: wff) (R: class):
  $ wi ph (wcel R cidom) $ >
  $ wi ph (wrex f2 (wrex s1 (wbr R (co (cv f2) (cv s1) cress) cric) (cfv (cv f2) csubrg)) cfield) $;

--| Syntax for a function generating sub-fields.
term cfldgen: class;

--| Define a function generating the smallest sub-division-ring of a given ring containing a given set. If the base structure is a division ring, then this is also a division ring (see ~ fldgensdrg ). If the base structure is a field, this is a subfield (see ~ fldgenfld and ~ fldsdrgfld ). In general this will be used in the context of fields, hence the name ` fldGen ` . (Contributed by Saveliy Skresanov and Thierry Arnoux, 9-Jan-2025.)
axiom df_fldgen {f2 s1 a: setvar}:
  $ wceq cfldgen (cmpo f2 s1 cvv cvv (cint (crab a (wss (cv s1) (cv a)) (cfv (cv f2) csdrg)))) $;

--| Value of the field generating function: ` ( F fldGen S ) ` is the smallest sub-division-ring of ` F ` containing ` S ` . (Contributed by Thierry Arnoux, 11-Jan-2025.)
theorem fldgenval {a: setvar} (ph: wff) (B2 S F: class):
  $ wceq B2 (cfv F cbs) $ >
  $ wi ph (wcel F cdr) $ >
  $ wi ph (wss S B2) $ >
  $ wi ph (wceq (co F S cfldgen) (cint (crab a (wss S (cv a)) (cfv F csdrg)))) $;

--| The field generated by a set of elements contains those elements. See ~ lspssid . (Contributed by Thierry Arnoux, 15-Jan-2025.)
theorem fldgenssid (ph: wff) (B2 S F: class):
  $ wceq B2 (cfv F cbs) $ >
  $ wi ph (wcel F cdr) $ >
  $ wi ph (wss S B2) $ >
  $ wi ph (wss S (co F S cfldgen)) $;

--| A generated subfield is a sub-division-ring. (Contributed by Thierry Arnoux, 11-Jan-2025.)
theorem fldgensdrg (ph: wff) (B2 S F: class):
  $ wceq B2 (cfv F cbs) $ >
  $ wi ph (wcel F cdr) $ >
  $ wi ph (wss S B2) $ >
  $ wi ph (wcel (co F S cfldgen) (cfv F csdrg)) $;

--| A generated subfield is a subset of the field's base. (Contributed by Thierry Arnoux, 25-Feb-2025.)
theorem fldgenssv (ph: wff) (B2 S F: class):
  $ wceq B2 (cfv F cbs) $ >
  $ wi ph (wcel F cdr) $ >
  $ wi ph (wss S B2) $ >
  $ wi ph (wss (co F S cfldgen) B2) $;

--| Generated subfields preserve subset ordering. ( see ~ lspss and ~ spanss ) (Contributed by Thierry Arnoux, 15-Jan-2025.)
theorem fldgenss (ph: wff) (B2 S T F: class):
  $ wceq B2 (cfv F cbs) $ >
  $ wi ph (wcel F cdr) $ >
  $ wi ph (wss S B2) $ >
  $ wi ph (wss T S) $ >
  $ wi ph (wss (co F T cfldgen) (co F S cfldgen)) $;

--| The subfield generated by a subfield is the subfield itself. (Contributed by Thierry Arnoux, 15-Jan-2025.)
theorem fldgenidfld (ph: wff) (B2 S F: class):
  $ wceq B2 (cfv F cbs) $ >
  $ wi ph (wcel F cdr) $ >
  $ wi ph (wcel S (cfv F csdrg)) $ >
  $ wi ph (wceq (co F S cfldgen) S) $;

--| The field generated by a set of elements in a division ring is contained in any sub-division-ring which contains those elements. (Contributed by Thierry Arnoux, 25-Feb-2025.)
theorem fldgenssp (ph: wff) (B2 S T F: class):
  $ wceq B2 (cfv F cbs) $ >
  $ wi ph (wcel F cdr) $ >
  $ wi ph (wcel S (cfv F csdrg)) $ >
  $ wi ph (wss T S) $ >
  $ wi ph (wss (co F T cfldgen) S) $;

--| The subfield of a field ` F ` generated by the whole base set of ` F ` is ` F ` itself. (Contributed by Thierry Arnoux, 11-Jan-2025.)
theorem fldgenid (ph: wff) (B2 F: class):
  $ wceq B2 (cfv F cbs) $ >
  $ wi ph (wcel F cdr) $ >
  $ wi ph (wceq (co F B2 cfldgen) B2) $;

--| A generated subfield is a field. (Contributed by Thierry Arnoux, 11-Jan-2025.)
theorem fldgenfld (ph: wff) (B2 S F: class):
  $ wceq B2 (cfv F cbs) $ >
  $ wi ph (wcel F cfield) $ >
  $ wi ph (wss S B2) $ >
  $ wi ph (wcel (co F (co F S cfldgen) cress) cfield) $;

--| The prime field of a division ring is the subfield generated by the multiplicative identity element. In general, we should write "prime division ring", but since most later usages are in the case where the ambient ring is commutative, we keep the term "prime field". (Contributed by Thierry Arnoux, 11-Jan-2025.)
theorem primefldgen1 (ph: wff) (B2 R c_1: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi ph (wcel R cdr) $ >
  $ wi ph (wceq (cint (cfv R csdrg)) (co R (csn c_1) cfldgen)) $;

--| The field of rational numbers ` QQ ` is generated by ` 1 ` in ` CCfld ` , that is, ` QQ ` is the prime field of ` CCfld ` . (Contributed by Thierry Arnoux, 15-Jan-2025.)
theorem _1fldgenq:
  $ wceq (co ccnfld (csn c1) cfldgen) cq $;

--| A ring homomorphism preserves ratios. (Contributed by Thierry Arnoux, 22-Oct-2017.)
theorem rhmdvd (A2 B2 C c_dv R S c_x U F X: class):
  $ wceq U (cfv S cui) $ >
  $ wceq X (cfv R cbs) $ >
  $ wceq c_dv (cfv S cdvr) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (w3a (wcel F (co R S crh)) (w3a (wcel A2 X) (wcel B2 X) (wcel C X)) (wa (wcel (cfv B2 F) U) (wcel (cfv C F) U))) (wceq (co (cfv A2 F) (cfv B2 F) c_dv) (co (cfv (co A2 C c_x) F) (cfv (co B2 C c_x) F) c_dv)) $;

--| If a unit element lies in the kernel of a ring homomorphism, then ` 0 = 1 ` , i.e. the target ring is the zero ring. (Contributed by Thierry Arnoux, 24-Oct-2017.)
theorem kerunit (R S U c_1 F c_0: class):
  $ wceq U (cfv R cui) $ >
  $ wceq c_0 (cfv S c0g) $ >
  $ wceq c_1 (cfv S cur) $ >
  $ wi (wa (wcel F (co R S crh)) (wne (cin U (cima (ccnv F) (csn c_0))) c0)) (wceq c_1 c_0) $;

--| Extend class notation with the scalar restriction operation.
term cresv: class;

--| Define an operator to restrict the scalar field component of an extended structure. (Contributed by Thierry Arnoux, 5-Sep-2018.)
axiom df_resv {x3 w: setvar}:
  $ wceq cresv (cmpo w x3 cvv cvv (cif (wss (cfv (cfv (cv w) csca) cbs) (cv x3)) (cv w) (co (cv w) (cop (cfv cnx csca) (co (cfv (cv w) csca) (cv x3) cress)) csts))) $;

--| The scalar restriction is a proper operator, so it can be used with ~ ovprc1 . (Contributed by Thierry Arnoux, 6-Sep-2018.)
theorem reldmresv:
  $ wrel (cdm cresv) $;

--| Value of structure restriction. (Contributed by Thierry Arnoux, 6-Sep-2018.)
theorem resvval (A2 B2 R F W X Y: class):
  $ wceq R (co W A2 cresv) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wi (wa (wcel W X) (wcel A2 Y)) (wceq R (cif (wss B2 A2) W (co W (cop (cfv cnx csca) (co F A2 cress)) csts))) $;

--| General behavior of trivial restriction. (Contributed by Thierry Arnoux, 6-Sep-2018.)
theorem resvid2 (A2 B2 R F W X Y: class):
  $ wceq R (co W A2 cresv) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wi (w3a (wss B2 A2) (wcel W X) (wcel A2 Y)) (wceq R W) $;

--| Value of nontrivial structure restriction. (Contributed by Thierry Arnoux, 6-Sep-2018.)
theorem resvval2 (A2 B2 R F W X Y: class):
  $ wceq R (co W A2 cresv) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wi (w3a (wn (wss B2 A2)) (wcel W X) (wcel A2 Y)) (wceq R (co W (cop (cfv cnx csca) (co F A2 cress)) csts)) $;

--| Base set of a structure restriction. (Contributed by Thierry Arnoux, 6-Sep-2018.)
theorem resvsca (A2 B2 R F V W: class):
  $ wceq R (co W A2 cresv) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wi (wcel A2 V) (wceq (co F A2 cress) (cfv R csca)) $;

--| Other elements of a scalar restriction. (Contributed by Thierry Arnoux, 6-Sep-2018.) (Revised by AV, 31-Oct-2024.)
theorem resvlem (A2 C R E V W: class):
  $ wceq R (co W A2 cresv) $ >
  $ wceq C (cfv W E) $ >
  $ wceq E (cslot (cfv cnx E)) $ >
  $ wne (cfv cnx E) (cfv cnx csca) $ >
  $ wi (wcel A2 V) (wceq C (cfv R E)) $;

--| ` Base ` is unaffected by scalar restriction. (Contributed by Thierry Arnoux, 6-Sep-2018.) (Revised by AV, 31-Oct-2024.)
theorem resvbas (A2 B2 G H V: class):
  $ wceq H (co G A2 cresv) $ >
  $ wceq B2 (cfv G cbs) $ >
  $ wi (wcel A2 V) (wceq B2 (cfv H cbs)) $;

--| ` +g ` is unaffected by scalar restriction. (Contributed by Thierry Arnoux, 6-Sep-2018.) (Revised by AV, 31-Oct-2024.)
theorem resvplusg (A2 c_pl G H V: class):
  $ wceq H (co G A2 cresv) $ >
  $ wceq c_pl (cfv G cplusg) $ >
  $ wi (wcel A2 V) (wceq c_pl (cfv H cplusg)) $;

--| ` .s ` is unaffected by scalar restriction. (Contributed by Thierry Arnoux, 6-Sep-2018.) (Proof shortened by AV, 31-Oct-2024.)
theorem resvvsca (A2 c_x G H V: class):
  $ wceq H (co G A2 cresv) $ >
  $ wceq c_x (cfv G cvsca) $ >
  $ wi (wcel A2 V) (wceq c_x (cfv H cvsca)) $;

--| ` .r ` is unaffected by scalar restriction. (Contributed by Thierry Arnoux, 6-Sep-2018.) (Revised by AV, 31-Oct-2024.)
theorem resvmulr (A2 c_x G H V: class):
  $ wceq H (co G A2 cresv) $ >
  $ wceq c_x (cfv G cmulr) $ >
  $ wi (wcel A2 V) (wceq c_x (cfv H cmulr)) $;

--| ` 0g ` is unaffected by scalar restriction. (Contributed by Thierry Arnoux, 6-Sep-2018.)
theorem resv0g (A2 G H V c_0: class):
  $ wceq H (co G A2 cresv) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wi (wcel A2 V) (wceq c_0 (cfv H c0g)) $;

--| ` 1r ` is unaffected by scalar restriction. (Contributed by Thierry Arnoux, 6-Sep-2018.)
theorem resv1r (A2 c_1 G H V: class):
  $ wceq H (co G A2 cresv) $ >
  $ wceq c_1 (cfv G cur) $ >
  $ wi (wcel A2 V) (wceq c_1 (cfv H cur)) $;

--| Scalar restriction preserves commutative monoids. (Contributed by Thierry Arnoux, 6-Sep-2018.)
theorem resvcmn (A2 G H V: class):
  $ wceq H (co G A2 cresv) $ >
  $ wi (wcel A2 V) (wb (wcel G ccmn) (wcel H ccmn)) $;

--| The gaussian integers form a commutative ring. (Contributed by Thierry Arnoux, 18-Mar-2018.)
theorem gzcrng:
  $ wcel (co ccnfld cgz cress) ccrg $;

--| The complex numbers form a field. (Contributed by Thierry Arnoux, 6-Jul-2025.)
theorem cnfldfld:
  $ wcel ccnfld cfield $;

--| The real numbers form an ordered field. (Contributed by Thierry Arnoux, 21-Jan-2018.)
theorem reofld:
  $ wcel crefld cofld $;

--| The nonnegative integers form an ordered monoid. (Contributed by Thierry Arnoux, 23-Mar-2018.)
theorem nn0omnd:
  $ wcel (co ccnfld cn0 cress) comnd $;

--| The group sum of an indicator function of the set ` A ` gives the size of ` A ` . (Contributed by Thierry Arnoux, 18-Jan-2026.)
theorem gsumind (ph: wff) (A2 O V: class):
  $ wi ph (wcel O V) $ >
  $ wi ph (wss A2 O) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wceq (co ccnfld (cfv A2 (cfv O cind)) cgsu) (cfv A2 chash)) $;

--| The field of the real numbers is Archimedean. See also ~ arch . (Contributed by Thierry Arnoux, 9-Apr-2018.)
theorem rearchi:
  $ wcel crefld carchi $;

--| The monoid of the nonnegative integers is Archimedean. (Contributed by Thierry Arnoux, 16-Sep-2018.)
theorem nn0archi:
  $ wcel (co ccnfld cn0 cress) carchi $;

--| The extended nonnegative real numbers form a semiring left module. One could also have used ` subringAlg ` to get the same structure. (Contributed by Thierry Arnoux, 6-Sep-2018.)
theorem xrge0slmod (G W: class):
  $ wceq G (co cxrs (co cc0 cpnf cicc) cress) $ >
  $ wceq W (co G (co cc0 cpnf cico) cresv) $ >
  $ wcel W cslmd $;

--| The kernel of a quotient map. (Contributed by Thierry Arnoux, 20-May-2023.)
theorem qusker {x3: setvar} (F: class x3) (G M: class) (N: class x3) (V: class) (c_0: class x3):
  $ wceq V (cfv M cbs) $ >
  $ wceq F (cmpt x3 V (cec (cv x3) (co M G cqg))) $ >
  $ wceq N (co M (co M G cqg) cqus) $ >
  $ wceq c_0 (cfv N c0g) $ >
  $ wi (wcel G (cfv M cnsg)) (wceq (cima (ccnv F) (csn c_0)) G) $;

--| The left coset equivalence relation is compatible with the scalar multiplication operation. (Contributed by Thierry Arnoux, 18-May-2023.)
theorem eqgvscpbl (ph: wff) (B2 c_sm S c_x G K M X Y: class):
  $ wceq B2 (cfv M cbs) $ >
  $ wceq c_sm (co M G cqg) $ >
  $ wceq S (cfv (cfv M csca) cbs) $ >
  $ wceq c_x (cfv M cvsca) $ >
  $ wi ph (wcel M clmod) $ >
  $ wi ph (wcel G (cfv M clss)) $ >
  $ wi ph (wcel K S) $ >
  $ wi ph (wi (wbr X Y c_sm) (wbr (co K X c_x) (co K Y c_x) c_sm)) $;

--| The quotient map distributes over the scalar multiplication. (Contributed by Thierry Arnoux, 18-May-2023.)
theorem qusvscpbl {x3: setvar} (ph: wff) (B2: class) (c_sm S c_xb: class x3) (c_x U: class) (F: class x3) (G K M: class) (N: class x3) (V: class):
  $ wceq B2 (cfv M cbs) $ >
  $ wceq c_sm (co M G cqg) $ >
  $ wceq S (cfv (cfv M csca) cbs) $ >
  $ wceq c_x (cfv M cvsca) $ >
  $ wi ph (wcel M clmod) $ >
  $ wi ph (wcel G (cfv M clss)) $ >
  $ wi ph (wcel K S) $ >
  $ wceq N (co M (co M G cqg) cqus) $ >
  $ wceq c_xb (cfv N cvsca) $ >
  $ wceq F (cmpt x3 B2 (cec (cv x3) (co M G cqg))) $ >
  $ wi ph (wcel U B2) $ >
  $ wi ph (wcel V B2) $ >
  $ wi ph (wi (wceq (cfv U F) (cfv V F)) (wceq (cfv (co K U c_x) F) (cfv (co K V c_x) F))) $;

--| Value of the scalar multiplication operation on the quotient structure. (Contributed by Thierry Arnoux, 18-May-2023.)
theorem qusvsval (ph: wff) (B2 c_sm S c_xb c_x G K M N X: class):
  $ wceq B2 (cfv M cbs) $ >
  $ wceq c_sm (co M G cqg) $ >
  $ wceq S (cfv (cfv M csca) cbs) $ >
  $ wceq c_x (cfv M cvsca) $ >
  $ wi ph (wcel M clmod) $ >
  $ wi ph (wcel G (cfv M clss)) $ >
  $ wi ph (wcel K S) $ >
  $ wceq N (co M (co M G cqg) cqus) $ >
  $ wceq c_xb (cfv N cvsca) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (co K (cec X (co M G cqg)) c_xb) (cec (co K X c_x) (co M G cqg))) $;

--| The image structure of a left module is a left module. (Contributed by Thierry Arnoux, 15-May-2023.)
theorem imaslmod {k q p a b: setvar} (ph: wff) (B2 c_pl: class a) (S: class q p) (c_x: class a) (F: class) (M: class a) (N V: class) (c_0: class k a b):
  $ wi ph (wceq N (co F M cimas)) $ >
  $ wceq V (cfv M cbs) $ >
  $ wceq S (cfv (cfv M csca) cbs) $ >
  $ wceq c_pl (cfv M cplusg) $ >
  $ wceq c_x (cfv M cvsca) $ >
  $ wceq c_0 (cfv M c0g) $ >
  $ wi ph (wfo V B2 F) $ >
  $ wi (w3a ph (wa (wcel (cv a) V) (wcel (cv b) V)) (wa (wcel (cv p) V) (wcel (cv q) V))) (wi (wa (wceq (cfv (cv a) F) (cfv (cv p) F)) (wceq (cfv (cv b) F) (cfv (cv q) F))) (wceq (cfv (co (cv a) (cv b) c_pl) F) (cfv (co (cv p) (cv q) c_pl) F))) $ >
  $ wi (wa ph (w3a (wcel (cv k) S) (wcel (cv a) V) (wcel (cv b) V))) (wi (wceq (cfv (cv a) F) (cfv (cv b) F)) (wceq (cfv (co (cv k) (cv a) c_x) F) (cfv (co (cv k) (cv b) c_x) F))) $ >
  $ wi ph (wcel M clmod) $ >
  $ wi ph (wcel N clmod) $;

--| Given a function ` F ` with homomorphic properties, build the image of a monoid. (Contributed by Thierry Arnoux, 2-Apr-2025.)
theorem imasmhm {q p a b: setvar} (ph: wff) (B2: class) (C: class q p a b) (c_pl: class a b) (F W: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wi ph (wf B2 C F) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wi (w3a ph (wa (wcel (cv a) B2) (wcel (cv b) B2)) (wa (wcel (cv p) B2) (wcel (cv q) B2))) (wi (wa (wceq (cfv (cv a) F) (cfv (cv p) F)) (wceq (cfv (cv b) F) (cfv (cv q) F))) (wceq (cfv (co (cv a) (cv b) c_pl) F) (cfv (co (cv p) (cv q) c_pl) F))) $ >
  $ wi ph (wcel W cmnd) $ >
  $ wi ph (wa (wcel (co F W cimas) cmnd) (wcel F (co W (co F W cimas) cmhm))) $;

--| Given a function ` F ` with homomorphic properties, build the image of a group. (Contributed by Thierry Arnoux, 2-Apr-2025.)
theorem imasghm {q p a b: setvar} (ph: wff) (B2: class) (C: class q p a b) (c_pl: class a b) (F W: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wi ph (wf B2 C F) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wi (w3a ph (wa (wcel (cv a) B2) (wcel (cv b) B2)) (wa (wcel (cv p) B2) (wcel (cv q) B2))) (wi (wa (wceq (cfv (cv a) F) (cfv (cv p) F)) (wceq (cfv (cv b) F) (cfv (cv q) F))) (wceq (cfv (co (cv a) (cv b) c_pl) F) (cfv (co (cv p) (cv q) c_pl) F))) $ >
  $ wi ph (wcel W cgrp) $ >
  $ wi ph (wa (wcel (co F W cimas) cgrp) (wcel F (co W (co F W cimas) cghm))) $;

--| Given a function ` F ` with homomorphic properties, build the image of a ring. (Contributed by Thierry Arnoux, 2-Apr-2025.)
theorem imasrhm {q p a b: setvar} (ph: wff) (B2: class) (C: class q p a b) (c_pl c_x: class a b) (F W: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wi ph (wf B2 C F) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wi (w3a ph (wa (wcel (cv a) B2) (wcel (cv b) B2)) (wa (wcel (cv p) B2) (wcel (cv q) B2))) (wi (wa (wceq (cfv (cv a) F) (cfv (cv p) F)) (wceq (cfv (cv b) F) (cfv (cv q) F))) (wceq (cfv (co (cv a) (cv b) c_pl) F) (cfv (co (cv p) (cv q) c_pl) F))) $ >
  $ wceq c_x (cfv W cmulr) $ >
  $ wi (w3a ph (wa (wcel (cv a) B2) (wcel (cv b) B2)) (wa (wcel (cv p) B2) (wcel (cv q) B2))) (wi (wa (wceq (cfv (cv a) F) (cfv (cv p) F)) (wceq (cfv (cv b) F) (cfv (cv q) F))) (wceq (cfv (co (cv a) (cv b) c_x) F) (cfv (co (cv p) (cv q) c_x) F))) $ >
  $ wi ph (wcel W crg) $ >
  $ wi ph (wa (wcel (co F W cimas) crg) (wcel F (co W (co F W cimas) crh))) $;

--| Given a function ` F ` with homomorphic properties, build the image of a left module. (Contributed by Thierry Arnoux, 2-Apr-2025.)
theorem imaslmhm {k q p a b: setvar} (ph: wff) (B2: class) (C D: class k q p a b) (c_pl c_xp: class a) (F: class) (K: class q p) (W: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wi ph (wf B2 C F) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wi (w3a ph (wa (wcel (cv a) B2) (wcel (cv b) B2)) (wa (wcel (cv p) B2) (wcel (cv q) B2))) (wi (wa (wceq (cfv (cv a) F) (cfv (cv p) F)) (wceq (cfv (cv b) F) (cfv (cv q) F))) (wceq (cfv (co (cv a) (cv b) c_pl) F) (cfv (co (cv p) (cv q) c_pl) F))) $ >
  $ wceq D (cfv W csca) $ >
  $ wceq K (cfv D cbs) $ >
  $ wi (wa ph (w3a (wcel (cv k) K) (wcel (cv a) B2) (wcel (cv b) B2))) (wi (wceq (cfv (cv a) F) (cfv (cv b) F)) (wceq (cfv (co (cv k) (cv a) c_xp) F) (cfv (co (cv k) (cv b) c_xp) F))) $ >
  $ wi ph (wcel W clmod) $ >
  $ wceq c_xp (cfv W cvsca) $ >
  $ wi ph (wa (wcel (co F W cimas) clmod) (wcel F (co W (co F W cimas) clmhm))) $;

--| If ` G ` is a submodule in ` M ` , then ` N = M / G ` is a left module, called the quotient module of ` M ` by ` G ` . (Contributed by Thierry Arnoux, 18-May-2023.)
theorem quslmod (ph: wff) (G M N V: class):
  $ wceq N (co M (co M G cqg) cqus) $ >
  $ wceq V (cfv M cbs) $ >
  $ wi ph (wcel M clmod) $ >
  $ wi ph (wcel G (cfv M clss)) $ >
  $ wi ph (wcel N clmod) $;

--| If ` G ` is a submodule of ` M ` , then the "natural map" from elements to their cosets is a left module homomorphism from ` M ` to ` M / G ` . (Contributed by Thierry Arnoux, 18-May-2023.)
theorem quslmhm {x3: setvar} (ph: wff) (F: class x3) (G M N V: class):
  $ wceq N (co M (co M G cqg) cqus) $ >
  $ wceq V (cfv M cbs) $ >
  $ wi ph (wcel M clmod) $ >
  $ wi ph (wcel G (cfv M clss)) $ >
  $ wceq F (cmpt x3 V (cec (cv x3) (co M G cqg))) $ >
  $ wi ph (wcel F (co M N clmhm)) $;

--| If ` S ` is a vector subspace in ` W ` , then ` Q = W / S ` is a vector space, called the quotient space of ` W ` by ` S ` . (Contributed by Thierry Arnoux, 18-May-2023.)
theorem quslvec (ph: wff) (Q S W: class):
  $ wceq Q (co W (co W S cqg) cqus) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel S (cfv W clss)) $ >
  $ wi ph (wcel Q clvec) $;

--| Fermat's little theorem in ` Z/nZ ` . (Contributed by Thierry Arnoux, 24-Jul-2024.)
theorem znfermltl (A2 B2 P c_ex Z: class):
  $ wceq Z (cfv P czn) $ >
  $ wceq B2 (cfv Z cbs) $ >
  $ wceq c_ex (cfv (cfv Z cmgp) cmg) $ >
  $ wi (wa (wcel P cprime) (wcel A2 B2)) (wceq (co P A2 c_ex) A2) $;

--| A set is linearly independent if and only if it has no non-trivial representations of zero. (Contributed by Thierry Arnoux, 18-May-2023.)
theorem islinds5 {v a: setvar} (B2 c_x: class) (F: class v) (K: class a) (O: class v) (V W c_0: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq O (cfv W c0g) $ >
  $ wceq c_0 (cfv F c0g) $ >
  $ wi (wa (wcel W clmod) (wss V B2)) (wb (wcel V (cfv W clinds)) (wral a (wi (wa (wbr (cv a) c_0 cfsupp) (wceq (co W (cmpt v V (co (cfv (cv v) (cv a)) (cv v) c_x)) cgsu) O)) (wceq (cv a) (cxp V (csn c_0)))) (co K V cmap))) $;

--| Variation on ~ ellspd . (Contributed by Thierry Arnoux, 18-May-2023.)
theorem ellspds {v a: setvar} (ph: wff) (B2 S: class v) (c_x K: class) (M N: class v) (V: class) (X c_0: class v):
  $ wceq N (cfv M clspn) $ >
  $ wceq B2 (cfv M cbs) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq S (cfv M csca) $ >
  $ wceq c_0 (cfv S c0g) $ >
  $ wceq c_x (cfv M cvsca) $ >
  $ wi ph (wcel M clmod) $ >
  $ wi ph (wss V B2) $ >
  $ wi ph (wb (wcel X (cfv V N)) (wrex a (wa (wbr (cv a) c_0 cfsupp) (wceq X (co M (cmpt v V (co (cfv (cv v) (cv a)) (cv v) c_x)) cgsu))) (co K V cmap))) $;

--| Zero is in all spans. (Contributed by Thierry Arnoux, 8-May-2023.)
theorem _0ellsp (B2 S N W c_0: class):
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi (wa (wcel W clmod) (wss S B2)) (wcel c_0 (cfv S N)) $;

--| The group identity cannot be an element of an independent set. (Contributed by Thierry Arnoux, 8-May-2023.)
theorem _0nellinds (F W c_0: class):
  $ wceq c_0 (cfv W c0g) $ >
  $ wi (wa (wcel W clvec) (wcel F (cfv W clinds))) (wn (wcel c_0 F)) $;

--| Write the elements of a ring span as finite linear combinations. (Contributed by Thierry Arnoux, 1-Jun-2024.)
theorem elrsp {i a: setvar} (ph: wff) (B2: class i) (R c_x I: class) (N X: class i) (c_0: class i a):
  $ wceq N (cfv R crsp) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wss I B2) $ >
  $ wi ph (wb (wcel X (cfv I N)) (wrex a (wa (wbr (cv a) c_0 cfsupp) (wceq X (co R (cmpt i I (co (cfv (cv i) (cv a)) (cv i) c_x)) cgsu))) (co B2 I cmap))) $;

--| Elementhood in a left principal ideal in terms of the "divides" relation. (Contributed by Thierry Arnoux, 18-May-2025.)
theorem ellpi (ph: wff) (B2 c_pa R K X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq K (cfv R crsp) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wb (wcel Y (cfv (csn X) K)) (wbr X Y c_pa)) $;

--| In a principal ideal ring, ideals are principal. (Contributed by Thierry Arnoux, 3-Jun-2025.)
theorem lpirlidllpi {x3: setvar} (ph: wff x3) (B2 R: class) (I: class x3) (J K: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq I (cfv R clidl) $ >
  $ wceq K (cfv R crsp) $ >
  $ wi ph (wcel R clpir) $ >
  $ wi ph (wcel J I) $ >
  $ wi ph (wrex x3 (wceq J (cfv (csn (cv x3)) K)) B2) $;

--| The ideal span of an ideal is the ideal itself. (Contributed by Thierry Arnoux, 1-Jun-2024.)
theorem rspidlid (R U I K: class):
  $ wceq K (cfv R crsp) $ >
  $ wceq U (cfv R clidl) $ >
  $ wi (wa (wcel R crg) (wcel I U)) (wceq (cfv I K) I) $;

--| The ideal span of a two-sided ideal is the ideal itself. (Contributed by Jeff Madsen, 10-Jun-2010.) (Revised by AV, 24-Aug-2026.)
theorem rsp2idlid (R U I K: class):
  $ wceq K (cfv R crsp) $ >
  $ wceq U (cfv R c2idl) $ >
  $ wi (wa (wcel R crg) (wcel I U)) (wceq (cfv I K) I) $;

--| Any element of a left module ` M ` can be expressed as a linear combination of the elements of a basis ` V ` of ` M ` . (Contributed by Thierry Arnoux, 3-Aug-2023.)
theorem lbslsp {v a: setvar} (ph: wff) (B2 S: class v) (c_x K: class) (M: class v) (V: class) (X c_0: class v):
  $ wceq B2 (cfv M cbs) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq S (cfv M csca) $ >
  $ wceq c_0 (cfv S c0g) $ >
  $ wceq c_x (cfv M cvsca) $ >
  $ wi ph (wcel M clmod) $ >
  $ wi ph (wcel V (cfv M clbs)) $ >
  $ wi ph (wb (wcel X B2) (wrex a (wa (wbr (cv a) c_0 cfsupp) (wceq X (co M (cmpt v V (co (cfv (cv v) (cv a)) (cv v) c_x)) cgsu))) (co K V cmap))) $;

--| Any singleton of a nonzero element is an independent set. (Contributed by Thierry Arnoux, 5-Aug-2023.)
theorem lindssn (B2 W X c_0: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi (w3a (wcel W clvec) (wcel X B2) (wne X c_0)) (wcel (csn X) (cfv W clinds)) $;

--| Conditions for an independent family to be a basis. (Contributed by Thierry Arnoux, 21-Jul-2023.)
theorem lindflbs (ph: wff) (B2 S c_x F I K N O V W c_0: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq K (cfv F cbs) $ >
  $ wceq S (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq O (cfv W c0g) $ >
  $ wceq c_0 (cfv S c0g) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel S cnzr) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wf1 I B2 F) $ >
  $ wi ph (wb (wcel (crn F) (cfv W clbs)) (wa (wbr F W clindf) (wceq (cfv (crn F) N) B2))) $;

--| An equivalent formulation of the basis predicate in a vector space, using a function ` F ` for generating the base. (Contributed by Thierry Arnoux, 20-Feb-2025.)
theorem islbs5 {a: setvar} (ph: wff) (B2 S c_x F I: class) (J K N: class a) (O V W c_0: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq S (cfv W csca) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq O (cfv W c0g) $ >
  $ wceq c_0 (cfv S c0g) $ >
  $ wceq J (cfv W clbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wi ph (wcel W clmod) $ >
  $ wi ph (wcel S cnzr) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wf1 I B2 F) $ >
  $ wi ph (wb (wcel (crn F) (cfv W clbs)) (wa (wral a (wi (wa (wbr (cv a) c_0 cfsupp) (wceq (co W (co (cv a) F (cof c_x)) cgsu) O)) (wceq (cv a) (cxp I (csn c_0)))) (co K I cmap)) (wceq (cfv (crn F) N) B2))) $;

--| Deduce equality of elements in an independent set. (Contributed by Thierry Arnoux, 18-Jul-2023.)
theorem linds2eq (ph: wff) (B2 c_pl c_x F K L W X Y c_0: class):
  $ wceq F (cfv (cfv W csca) cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_0 (cfv (cfv W csca) c0g) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel B2 (cfv W clinds)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel K F) $ >
  $ wi ph (wcel L F) $ >
  $ wi ph (wne K c_0) $ >
  $ wi ph (wceq (co K X c_x) (co L Y c_x)) $ >
  $ wi ph (wa (wceq X Y) (wceq K L)) $;

--| Property deduction for linearly independent families. (Contributed by Thierry Arnoux, 16-Jul-2023.)
theorem lindfpropd {x3 y1: setvar} (ph: wff) (A2: class x3 y1) (K L: class) (V W: class x3 y1) (X: class):
  $ wi ph (wceq (cfv K cbs) (cfv L cbs)) $ >
  $ wi ph (wceq (cfv (cfv K csca) cbs) (cfv (cfv L csca) cbs)) $ >
  $ wi ph (wceq (cfv (cfv K csca) c0g) (cfv (cfv L csca) c0g)) $ >
  $ wi (wa ph (wa (wcel (cv x3) (cfv K cbs)) (wcel (cv y1) (cfv K cbs)))) (wceq (co (cv x3) (cv y1) (cfv K cplusg)) (co (cv x3) (cv y1) (cfv L cplusg))) $ >
  $ wi (wa ph (wa (wcel (cv x3) (cfv (cfv K csca) cbs)) (wcel (cv y1) (cfv K cbs)))) (wcel (co (cv x3) (cv y1) (cfv K cvsca)) (cfv K cbs)) $ >
  $ wi (wa ph (wa (wcel (cv x3) (cfv (cfv K csca) cbs)) (wcel (cv y1) (cfv K cbs)))) (wceq (co (cv x3) (cv y1) (cfv K cvsca)) (co (cv x3) (cv y1) (cfv L cvsca))) $ >
  $ wi ph (wcel K V) $ >
  $ wi ph (wcel L W) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wb (wbr X K clindf) (wbr X L clindf)) $;

--| Property deduction for linearly independent sets. (Contributed by Thierry Arnoux, 16-Jul-2023.)
theorem lindspropd {x3 y1: setvar} (ph: wff) (K L: class) (V W: class x3 y1):
  $ wi ph (wceq (cfv K cbs) (cfv L cbs)) $ >
  $ wi ph (wceq (cfv (cfv K csca) cbs) (cfv (cfv L csca) cbs)) $ >
  $ wi ph (wceq (cfv (cfv K csca) c0g) (cfv (cfv L csca) c0g)) $ >
  $ wi (wa ph (wa (wcel (cv x3) (cfv K cbs)) (wcel (cv y1) (cfv K cbs)))) (wceq (co (cv x3) (cv y1) (cfv K cplusg)) (co (cv x3) (cv y1) (cfv L cplusg))) $ >
  $ wi (wa ph (wa (wcel (cv x3) (cfv (cfv K csca) cbs)) (wcel (cv y1) (cfv K cbs)))) (wcel (co (cv x3) (cv y1) (cfv K cvsca)) (cfv K cbs)) $ >
  $ wi (wa ph (wa (wcel (cv x3) (cfv (cfv K csca) cbs)) (wcel (cv y1) (cfv K cbs)))) (wceq (co (cv x3) (cv y1) (cfv K cvsca)) (co (cv x3) (cv y1) (cfv L cvsca))) $ >
  $ wi ph (wcel K V) $ >
  $ wi ph (wcel L W) $ >
  $ wi ph (wceq (cfv K clinds) (cfv L clinds)) $;

--| If two elements ` X ` and ` Y ` of a ring ` R ` are unit multiples, then they are associates, i.e. each divides the other. (Contributed by Thierry Arnoux, 22-Mar-2025.)
theorem dvdsruassoi (ph: wff) (B2 c_pa R c_x U K V X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq K (cfv R crsp) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel V U) $ >
  $ wi ph (wceq (co V X c_x) Y) $ >
  $ wi ph (wa (wbr X Y c_pa) (wbr Y X c_pa)) $;

--| Two elements ` X ` and ` Y ` of a ring ` R ` are associates, i.e. each divides the other, iff they are unit multiples of each other. (Contributed by Thierry Arnoux, 22-Mar-2025.)
theorem dvdsruasso {u: setvar} (ph: wff) (B2 c_pa R c_x U: class) (K: class u) (X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq K (cfv R crsp) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R cidom) $ >
  $ wi ph (wb (wa (wbr X Y c_pa) (wbr Y X c_pa)) (wrex u (wceq (co (cv u) X c_x) Y) U)) $;

--| A reformulation of ~ dvdsruasso . (Proposed by Gerard Lang, 28-May-2025.) (Contributed by Thiery Arnoux, 29-May-2025.)
theorem dvdsruasso2 {v u: setvar} (ph: wff) (B2 c_pa: class v) (R c_x U: class) (c_1: class u) (K: class v u) (X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq K (cfv R crsp) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R cidom) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi ph (wb (wa (wbr X Y c_pa) (wbr Y X c_pa)) (wrex u (wrex v (w3a (wceq (co (cv u) X c_x) Y) (wceq (co (cv v) Y c_x) X) (wceq (co (cv u) (cv v) c_x) c_1)) U) U)) $;

--| In a ring, an element ` X ` divides ` Y ` iff the ideal generated by ` Y ` is a subset of the ideal generated by ` X ` . (Contributed by Thierry Arnoux, 22-Mar-2025.)
theorem dvdsrspss (ph: wff) (B2 c_pa R K X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq K (cfv R crsp) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wb (wbr X Y c_pa) (wss (cfv (csn Y) K) (cfv (csn X) K))) $;

--| Two elements ` X ` and ` Y ` of a ring ` R ` are associates, i.e. each divides the other, iff the ideals they generate are equal. (Contributed by Thierry Arnoux, 22-Mar-2025.)
theorem rspsnasso (ph: wff) (B2 c_pa R K X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq K (cfv R crsp) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wb (wa (wbr X Y c_pa) (wbr Y X c_pa)) (wceq (cfv (csn Y) K) (cfv (csn X) K))) $;

--| A finite product is a unit iff all factors are units. (Contributed by Thierry Arnoux, 27-May-2025.)
theorem unitprodclb (ph: wff) (B2 R U F M: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel F (cword B2)) $ >
  $ wi ph (wb (wcel (co M F cgsu) U) (wss (crn F) U)) $;

--| Membership in a sumset with a singleton for a group operation. (Contributed by Thierry Arnoux, 21-Jan-2024.)
theorem elgrplsmsn {x3: setvar} (ph: wff) (A2 B2 c_pl: class) (c_po: class x3) (G: class) (V: class x3) (X Z: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_pl (cfv G cplusg) $ >
  $ wceq c_po (cfv G clsm) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wb (wcel Z (co A2 (csn X) c_po)) (wrex x3 (wceq Z (co (cv x3) X c_pl)) A2)) $;

--| The sumset of a group with a single element is the element's orbit by the group action. See ~ gaorb . (Contributed by Thierry Arnoux, 21-Jan-2024.)
theorem lsmsnorb {x3 y1 g2: setvar} (ph: wff x3 y1 g2) (A2: class) (B2: class g2) (c_pl: class) (c_po c_sm G: class x3 y1 g2) (X: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_pl (cfv G cplusg) $ >
  $ wceq c_po (cfv G clsm) $ >
  $ wceq c_sm (copab x3 y1 (wa (wss (cpr (cv x3) (cv y1)) B2) (wrex g2 (wceq (co (cv g2) (cv x3) c_pl) (cv y1)) A2))) $ >
  $ wi ph (wcel G cmnd) $ >
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (co A2 (csn X) c_po) (cec X c_sm)) $;

--| The sumset of a single element with a group is the element's orbit by the group action. See ~ gaorb . (Contributed by Thierry Arnoux, 24-Jul-2024.)
theorem lsmsnorb2 {x3 y1 g2: setvar} (ph: wff x3 y1 g2) (A2: class) (B2: class g2) (c_pl c_po c_sm: class x3 y1 g2) (G X: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_pl (cfv G cplusg) $ >
  $ wceq c_po (cfv G clsm) $ >
  $ wceq c_sm (copab x3 y1 (wa (wss (cpr (cv x3) (cv y1)) B2) (wrex g2 (wceq (co (cv x3) (cv g2) c_pl) (cv y1)) A2))) $ >
  $ wi ph (wcel G cmnd) $ >
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (co (csn X) A2 c_po) (cec X c_sm)) $;

--| Closure of the product of two subsets of a ring. (Contributed by Thierry Arnoux, 20-Jan-2024.)
theorem ringlsmss (ph: wff) (B2 R c_xp E F G: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_xp (cfv G clsm) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wss E B2) $ >
  $ wi ph (wss F B2) $ >
  $ wi ph (wss (co E F c_xp) B2) $;

--| The product of an ideal ` I ` of a commutative ring ` R ` with some set E is a subset of the ideal. (Contributed by Thierry Arnoux, 8-Jun-2024.)
theorem ringlsmss1 (ph: wff) (B2 R c_xp E G I: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_xp (cfv G clsm) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wss E B2) $ >
  $ wi ph (wcel I (cfv R clidl)) $ >
  $ wi ph (wss (co I E c_xp) I) $;

--| The product with an ideal of a ring is a subset of that ideal. (Contributed by Thierry Arnoux, 2-Jun-2024.)
theorem ringlsmss2 (ph: wff) (B2 R c_xp E G I: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_xp (cfv G clsm) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wss E B2) $ >
  $ wi ph (wcel I (cfv R clidl)) $ >
  $ wi ph (wss (co E I c_xp) I) $;

--| The product of the ring with a single element is equal to the principal ideal generated by that element. (Contributed by Thierry Arnoux, 21-Jan-2024.)
theorem lsmsnpridl (ph: wff) (B2 R c_xp G K X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_xp (cfv G clsm) $ >
  $ wceq K (cfv R crsp) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (co B2 (csn X) c_xp) (cfv (csn X) K)) $;

--| The product of the ring with a single element is a principal ideal. (Contributed by Thierry Arnoux, 21-Jan-2024.)
theorem lsmsnidl (ph: wff) (B2 R c_xp G K X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_xp (cfv G clsm) $ >
  $ wceq K (cfv R crsp) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel (co B2 (csn X) c_xp) (cfv R clpidl)) $;

--| Group sum is associative, subset version (see ~ lsmass ). (Contributed by Thierry Arnoux, 1-Jun-2024.)
theorem lsmssass (ph: wff) (B2 c_po R T U G: class):
  $ wceq c_po (cfv G clsm) $ >
  $ wceq B2 (cfv G cbs) $ >
  $ wi ph (wcel G cmnd) $ >
  $ wi ph (wss R B2) $ >
  $ wi ph (wss T B2) $ >
  $ wi ph (wss U B2) $ >
  $ wi ph (wceq (co (co R T c_po) U c_po) (co R (co T U c_po) c_po)) $;

--| Sumset with the identity singleton is the original set. (Contributed by Thierry Arnoux, 27-Jul-2024.)
theorem grplsm0l (A2 B2 c_po G c_0: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_po (cfv G clsm) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wi (w3a (wcel G cgrp) (wss A2 B2) (wne A2 c0)) (wceq (co (csn c_0) A2 c_po) A2) $;

--| The direct sum of an element ` X ` of a subgroup ` A ` is the subgroup itself. (Contributed by Thierry Arnoux, 27-Jul-2024.)
theorem grplsmid (A2 c_po G X: class):
  $ wceq c_po (cfv G clsm) $ >
  $ wi (wa (wcel A2 (cfv G csubg)) (wcel X A2)) (wceq (co (csn X) A2 c_po) A2) $;

--| Express the image by the quotient map in terms of direct sum. (Contributed by Thierry Arnoux, 27-Jul-2024.)
theorem quslsm (ph: wff) (B2 c_po S G X: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_po (cfv G clsm) $ >
  $ wi ph (wcel S (cfv G csubg)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (cec X (co G S cqg)) (co (csn X) S c_po)) $;

--| Alternate definition of the group quotient set, as the set of all cosets of the form ` ( { x } .(+) N ) ` . (Contributed by Thierry Arnoux, 22-Mar-2025.)
theorem qusbas2 {x3: setvar} (ph: wff) (B2: class) (c_po: class x3) (G N: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_po (cfv G clsm) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wcel N (cfv G csubg)) $ >
  $ wi ph (wceq (cqs B2 (co G N cqg)) (crn (cmpt x3 B2 (co (csn (cv x3)) N c_po)))) $;

--| The identity element of a quotient group. (Contributed by Thierry Arnoux, 13-Mar-2025.)
theorem qus0g (Q G N: class):
  $ wceq Q (co G (co G N cqg) cqus) $ >
  $ wi (wcel N (cfv G cnsg)) (wceq (cfv Q c0g) N) $;

--| The image of a subgroup by the natural map from elements to their cosets. (Contributed by Thierry Arnoux, 27-Jul-2024.)
theorem qusima {x3 h: setvar} (ph: wff) (B2: class h) (c_po Q: class x3 h) (S: class x3) (E: class x3 h) (F: class x3) (G: class x3 h) (H: class) (N: class x3 h):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq Q (co G (co G N cqg) cqus) $ >
  $ wceq c_po (cfv G clsm) $ >
  $ wceq E (cmpt h S (crn (cmpt x3 (cv h) (co (csn (cv x3)) N c_po)))) $ >
  $ wceq F (cmpt x3 B2 (cec (cv x3) (co G N cqg))) $ >
  $ wi ph (wcel N (cfv G cnsg)) $ >
  $ wi ph (wcel H S) $ >
  $ wi ph (wss S (cfv G csubg)) $ >
  $ wi ph (wceq (cfv H E) (cima F H)) $;

--| The natural map from elements to their cosets is surjective. (Contributed by Thierry Arnoux, 22-Mar-2025.)
theorem qusrn {x3: setvar} (ph: wff) (B2: class) (U: class x3) (F G N: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq U (cqs B2 (co G N cqg)) $ >
  $ wceq F (cmpt x3 B2 (cec (cv x3) (co G N cqg))) $ >
  $ wi ph (wcel N (cfv G cnsg)) $ >
  $ wi ph (wceq (crn F) U) $;

--| A normal subgroup ` N ` is a member of all subgroups ` F ` of the quotient group by ` N ` . In fact, it is the identity element of the quotient group. (Contributed by Thierry Arnoux, 27-Jul-2024.)
theorem nsgqus0 (Q F G N: class):
  $ wceq Q (co G (co G N cqg) cqus) $ >
  $ wi (wa (wcel N (cfv G cnsg)) (wcel F (cfv Q csubg))) (wcel N F) $;

--| Lemma for ~ nsgmgc . (Contributed by Thierry Arnoux, 27-Jul-2024.)
theorem nsgmgclem {a: setvar} (ph: wff a) (B2 c_po: class) (Q: class a) (F G N: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq Q (co G (co G N cqg) cqus) $ >
  $ wceq c_po (cfv G clsm) $ >
  $ wi ph (wcel N (cfv G cnsg)) $ >
  $ wi ph (wcel F (cfv Q csubg)) $ >
  $ wi ph (wcel (crab a (wcel (co (csn (cv a)) N c_po) F) B2) (cfv G csubg)) $;

--| There is a monotone Galois connection between the lattice of subgroups of a group ` G ` containing a normal subgroup ` N ` and the lattice of subgroups of the quotient group ` G / N ` . This is sometimes called the lattice theorem. (Contributed by Thierry Arnoux, 27-Jul-2024.)
theorem nsgmgc {x3 f2 h a: setvar} (ph: wff) (B2 c_po: class f2) (Q S T E: class) (F: class a) (G: class) (J: class x3 f2 h a) (N: class f2) (V W: class x3 a):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq S (crab h (wss N (cv h)) (cfv G csubg)) $ >
  $ wceq T (cfv Q csubg) $ >
  $ wceq J (co V W cmgc) $ >
  $ wceq V (cfv S cipo) $ >
  $ wceq W (cfv T cipo) $ >
  $ wceq Q (co G (co G N cqg) cqus) $ >
  $ wceq c_po (cfv G clsm) $ >
  $ wceq E (cmpt h S (crn (cmpt x3 (cv h) (co (csn (cv x3)) N c_po)))) $ >
  $ wceq F (cmpt f2 T (crab a (wcel (co (csn (cv a)) N c_po) (cv f2)) B2)) $ >
  $ wi ph (wcel N (cfv G cnsg)) $ >
  $ wi ph (wbr E F J) $;

--| Lemma for ~ nsgqusf1o . (Contributed by Thierry Arnoux, 4-Aug-2024.)
theorem nsgqusf1olem1 {x3 f2 h a: setvar} (ph: wff) (B2 c_po Q S T E: class) (F: class a) (G: class) (c_le: class x3 f2 h a) (N: class) (c_le2: class x3 f2 h a):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq S (crab h (wss N (cv h)) (cfv G csubg)) $ >
  $ wceq T (cfv Q csubg) $ >
  $ wceq c_le (cfv (cfv S cipo) cple) $ >
  $ wceq c_le2 (cfv (cfv T cipo) cple) $ >
  $ wceq Q (co G (co G N cqg) cqus) $ >
  $ wceq c_po (cfv G clsm) $ >
  $ wceq E (cmpt h S (crn (cmpt x3 (cv h) (co (csn (cv x3)) N c_po)))) $ >
  $ wceq F (cmpt f2 T (crab a (wcel (co (csn (cv a)) N c_po) (cv f2)) B2)) $ >
  $ wi ph (wcel N (cfv G cnsg)) $ >
  $ wi (wa (wa ph (wcel (cv h) (cfv G csubg))) (wss N (cv h))) (wcel (crn (cmpt x3 (cv h) (co (csn (cv x3)) N c_po))) T) $;

--| Lemma for ~ nsgqusf1o . (Contributed by Thierry Arnoux, 4-Aug-2024.)
theorem nsgqusf1olem2 {x3 f2 h a: setvar} (ph: wff) (B2 c_po Q S T E: class) (F: class a) (G: class) (c_le: class x3 f2 h a) (N: class) (c_le2: class x3 f2 h a):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq S (crab h (wss N (cv h)) (cfv G csubg)) $ >
  $ wceq T (cfv Q csubg) $ >
  $ wceq c_le (cfv (cfv S cipo) cple) $ >
  $ wceq c_le2 (cfv (cfv T cipo) cple) $ >
  $ wceq Q (co G (co G N cqg) cqus) $ >
  $ wceq c_po (cfv G clsm) $ >
  $ wceq E (cmpt h S (crn (cmpt x3 (cv h) (co (csn (cv x3)) N c_po)))) $ >
  $ wceq F (cmpt f2 T (crab a (wcel (co (csn (cv a)) N c_po) (cv f2)) B2)) $ >
  $ wi ph (wcel N (cfv G cnsg)) $ >
  $ wi ph (wceq (crn E) T) $;

--| Lemma for ~ nsgqusf1o . (Contributed by Thierry Arnoux, 4-Aug-2024.)
theorem nsgqusf1olem3 {x3 f2 h a: setvar} (ph: wff) (B2 c_po Q S T E: class) (F: class a) (G: class) (c_le: class x3 f2 h a) (N: class) (c_le2: class x3 f2 h a):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq S (crab h (wss N (cv h)) (cfv G csubg)) $ >
  $ wceq T (cfv Q csubg) $ >
  $ wceq c_le (cfv (cfv S cipo) cple) $ >
  $ wceq c_le2 (cfv (cfv T cipo) cple) $ >
  $ wceq Q (co G (co G N cqg) cqus) $ >
  $ wceq c_po (cfv G clsm) $ >
  $ wceq E (cmpt h S (crn (cmpt x3 (cv h) (co (csn (cv x3)) N c_po)))) $ >
  $ wceq F (cmpt f2 T (crab a (wcel (co (csn (cv a)) N c_po) (cv f2)) B2)) $ >
  $ wi ph (wcel N (cfv G cnsg)) $ >
  $ wi ph (wceq (crn F) S) $;

--| The canonical projection homomorphism ` E ` defines a bijective correspondence between the set ` S ` of subgroups of ` G ` containing a normal subgroup ` N ` and the subgroups of the quotient group ` G / N ` . This theorem is sometimes called the correspondence theorem, or the fourth isomorphism theorem. (Contributed by Thierry Arnoux, 4-Aug-2024.)
theorem nsgqusf1o {x3 f2 h a: setvar} (ph: wff) (B2 c_po Q S T E: class) (F: class a) (G: class) (c_le: class x3 f2 h a) (N: class) (c_le2: class x3 f2 h a):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq S (crab h (wss N (cv h)) (cfv G csubg)) $ >
  $ wceq T (cfv Q csubg) $ >
  $ wceq c_le (cfv (cfv S cipo) cple) $ >
  $ wceq c_le2 (cfv (cfv T cipo) cple) $ >
  $ wceq Q (co G (co G N cqg) cqus) $ >
  $ wceq c_po (cfv G clsm) $ >
  $ wceq E (cmpt h S (crn (cmpt x3 (cv h) (co (csn (cv x3)) N c_po)))) $ >
  $ wceq F (cmpt f2 T (crab a (wcel (co (csn (cv a)) N c_po) (cv f2)) B2)) $ >
  $ wi ph (wcel N (cfv G cnsg)) $ >
  $ wi ph (wf1o S T E) $;

--| A surjective module homomorphism ` F ` from ` G ` to ` H ` induces an isomorphism ` J ` from ` Q ` to ` H ` , where ` Q ` is the factor group of ` G ` by ` F ` 's kernel ` K ` . (Contributed by Thierry Arnoux, 25-Feb-2025.)
theorem lmhmqusker {q: setvar} (ph: wff) (Q F G H J K: class) (c_0: class q):
  $ wceq c_0 (cfv H c0g) $ >
  $ wi ph (wcel F (co G H clmhm)) $ >
  $ wceq K (cima (ccnv F) (csn c_0)) $ >
  $ wceq Q (co G (co G K cqg) cqus) $ >
  $ wi ph (wceq (crn F) (cfv H cbs)) $ >
  $ wceq J (cmpt q (cfv Q cbs) (cuni (cima F (cv q)))) $ >
  $ wi ph (wcel J (co Q H clmim)) $;

--| The image ` H ` of a module homomorphism ` F ` is isomorphic with the quotient module ` Q ` over ` F ` 's kernel ` K ` . This is part of what is sometimes called the first isomorphism theorem for modules. (Contributed by Thierry Arnoux, 10-Mar-2025.)
theorem lmicqusker (ph: wff) (Q F G H K c_0: class):
  $ wceq c_0 (cfv H c0g) $ >
  $ wi ph (wcel F (co G H clmhm)) $ >
  $ wceq K (cima (ccnv F) (csn c_0)) $ >
  $ wceq Q (co G (co G K cqg) cqus) $ >
  $ wi ph (wceq (crn F) (cfv H cbs)) $ >
  $ wi ph (wbr Q H clmic) $;

--| The intersection of a nonempty collection of ideals is an ideal. (Contributed by Jeff Madsen, 10-Jun-2010.) (Revised by Thierry Arnoux, 8-Jun-2024.)
theorem intlidl (C R: class):
  $ wi (w3a (wcel R crg) (wne C c0) (wss C (cfv R clidl))) (wcel (cint C) (cfv R clidl)) $;

--| The intersection of two ideals is an ideal. (Contributed by Jeff Madsen, 16-Jun-2011.) (Revised by AV, 28-Jun-2026.)
theorem inlidl (R I J: class):
  $ wi (w3a (wcel R crg) (wcel I (cfv R clidl)) (wcel J (cfv R clidl))) (wcel (cin I J) (cfv R clidl)) $;

--| A principal ideal is nonzero iff it is generated by a nonzero element. (Contributed by Thierry Arnoux, 22-Mar-2025.)
theorem pidlnzb (B2 R K X c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq K (cfv R crsp) $ >
  $ wi (wa (wcel R crg) (wcel X B2)) (wb (wne X c_0) (wne (cfv (csn X) K) (csn c_0))) $;

--| If an ideal ` I ` contains a unit ` J ` , then it is the whole ring. (Contributed by Thierry Arnoux, 19-Mar-2025.)
theorem lidlunitel (ph: wff) (B2 R U I J: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R cui) $ >
  $ wi ph (wcel J U) $ >
  $ wi ph (wcel J I) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel I (cfv R clidl)) $ >
  $ wi ph (wceq I B2) $;

--| The ideal ` I ` generated by an element ` X ` of a commutative ring ` R ` is the unit ideal ` B ` iff ` X ` is a ring unit. (Contributed by Thierry Arnoux, 22-Mar-2025.)
theorem unitpidl1 (ph: wff) (B2 R U I K X: class):
  $ wceq U (cfv R cui) $ >
  $ wceq K (cfv R crsp) $ >
  $ wceq I (cfv (csn X) K) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wb (wceq I B2) (wcel X U)) $;

--| The mapping ` J ` induced by a ring homomorphism ` F ` from the quotient group ` Q ` over ` F ` 's kernel ` K ` is a ring homomorphism. (Contributed by Thierry Arnoux, 22-Mar-2025.)
theorem rhmquskerlem {q: setvar} (ph: wff) (Q F G H J K: class) (c_0: class q):
  $ wceq c_0 (cfv H c0g) $ >
  $ wi ph (wcel F (co G H crh)) $ >
  $ wceq K (cima (ccnv F) (csn c_0)) $ >
  $ wceq Q (co G (co G K cqg) cqus) $ >
  $ wceq J (cmpt q (cfv Q cbs) (cuni (cima F (cv q)))) $ >
  $ wi ph (wcel G ccrg) $ >
  $ wi ph (wcel J (co Q H crh)) $;

--| A surjective ring homomorphism ` F ` from ` G ` to ` H ` induces an isomorphism ` J ` from ` Q ` to ` H ` , where ` Q ` is the factor group of ` G ` by ` F ` 's kernel ` K ` . (Contributed by Thierry Arnoux, 25-Feb-2025.)
theorem rhmqusker {q: setvar} (ph: wff) (Q F G H J K: class) (c_0: class q):
  $ wceq c_0 (cfv H c0g) $ >
  $ wi ph (wcel F (co G H crh)) $ >
  $ wceq K (cima (ccnv F) (csn c_0)) $ >
  $ wceq Q (co G (co G K cqg) cqus) $ >
  $ wi ph (wceq (crn F) (cfv H cbs)) $ >
  $ wi ph (wcel G ccrg) $ >
  $ wceq J (cmpt q (cfv Q cbs) (cuni (cima F (cv q)))) $ >
  $ wi ph (wcel J (co Q H crs)) $;

--| The image ` H ` of a ring homomorphism ` F ` is isomorphic with the quotient ring ` Q ` over ` F ` 's kernel ` K ` . This a part of what is sometimes called the first isomorphism theorem for rings. (Contributed by Thierry Arnoux, 10-Mar-2025.)
theorem ricqusker (ph: wff) (Q F G H K c_0: class):
  $ wceq c_0 (cfv H c0g) $ >
  $ wi ph (wcel F (co G H crh)) $ >
  $ wceq K (cima (ccnv F) (csn c_0)) $ >
  $ wceq Q (co G (co G K cqg) cqus) $ >
  $ wi ph (wceq (crn F) (cfv H cbs)) $ >
  $ wi ph (wcel G ccrg) $ >
  $ wi ph (wbr Q H cric) $;

--| Elementhood in the span of a union of ideals. (Contributed by Thierry Arnoux, 30-Jun-2024.) Remove dependency on ~ ax-reg and ~ ax-inf2 . (Revised by Timothy J. O'Malley, 15-Oct-2026.)
theorem elrspunidl {k a: setvar} (ph: wff) (B2 R S c_x: class) (N: class k a) (X c_0: class):
  $ wceq N (cfv R crsp) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wss S (cfv R clidl)) $ >
  $ wi ph (wb (wcel X (cfv (cuni S) N)) (wrex a (w3a (wbr (cv a) c_0 cfsupp) (wceq X (co R (cv a) cgsu)) (wral k (wcel (cfv (cv k) (cv a)) (cv k)) S)) (co B2 S cmap))) $;

--| Membership to the span of an ideal ` R ` and a single element ` X ` . (Contributed by Thierry Arnoux, 9-Mar-2025.)
theorem elrspunsn {i r: setvar} (ph: wff) (A2 B2 c_pl R c_x I: class) (N: class i r) (X c_0: class):
  $ wceq N (cfv R crsp) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wi ph (wcel I (cfv R clidl)) $ >
  $ wi ph (wcel X (cdif B2 I)) $ >
  $ wi ph (wb (wcel A2 (cfv (cun I (csn X)) N)) (wrex r (wrex i (wceq A2 (co (co (cv r) X c_x) (cv i) c_pl)) I) B2)) $;

--| Ideals are closed under intersection. (Contributed by Thierry Arnoux, 5-Jul-2024.)
theorem lidlincl (R U I J: class):
  $ wceq U (cfv R clidl) $ >
  $ wi (w3a (wcel R crg) (wcel I U) (wcel J U)) (wcel (cin I J) U) $;

--| The intersection between an ideal and a subring is an ideal of the subring. (Contributed by Thierry Arnoux, 6-Jul-2024.)
theorem idlinsubrg (A2 R S U I V: class):
  $ wceq S (co R A2 cress) $ >
  $ wceq U (cfv R clidl) $ >
  $ wceq V (cfv S clidl) $ >
  $ wi (wa (wcel A2 (cfv R csubrg)) (wcel I U)) (wcel (cin I A2) V) $;

--| The image of an ideal ` I ` by a surjective ring homomorphism ` F ` is an ideal. (Contributed by Thierry Arnoux, 6-Jul-2024.)
theorem rhmimaidl (B2 R S T U F I: class):
  $ wceq B2 (cfv S cbs) $ >
  $ wceq T (cfv R clidl) $ >
  $ wceq U (cfv S clidl) $ >
  $ wi (w3a (wcel F (co R S crh)) (wceq (crn F) B2) (wcel I T)) (wcel (cima F I) U) $;

--| A ring is a division ring if and only if it admits exactly two ideals. (Proposed by Gerard Lang, 13-Mar-2025.) (Contributed by Thierry Arnoux, 13-Mar-2025.)
theorem drngidlhash (R U: class):
  $ wceq U (cfv R clidl) $ >
  $ wi (wcel R crg) (wb (wcel R cdr) (wceq (cfv U chash) c2)) $;

--| Extend class notation with the class of maximal ideals.
term cmxidl: class;

--| Define the class of maximal ideals of a ring ` R ` . A proper ideal is called maximal if it is maximal with respect to inclusion among proper ideals. (Contributed by Jeff Madsen, 5-Jan-2011.) (Revised by Thierry Arnoux, 19-Jan-2024.)
axiom df_mxidl {i j r: setvar}:
  $ wceq cmxidl (cmpt r crg (crab i (wa (wne (cv i) (cfv (cv r) cbs)) (wral j (wi (wss (cv i) (cv j)) (wo (wceq (cv j) (cv i)) (wceq (cv j) (cfv (cv r) cbs)))) (cfv (cv r) clidl))) (cfv (cv r) clidl))) $;

--| The set of maximal ideals of a ring. (Contributed by Jeff Madsen, 5-Jan-2011.) (Revised by Thierry Arnoux, 19-Jan-2024.)
theorem mxidlval {i j: setvar} (B2: class i j) (R: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel R crg) (wceq (cfv R cmxidl) (crab i (wa (wne (cv i) B2) (wral j (wi (wss (cv i) (cv j)) (wo (wceq (cv j) (cv i)) (wceq (cv j) B2))) (cfv R clidl))) (cfv R clidl))) $;

--| The predicate "is a maximal ideal". (Contributed by Jeff Madsen, 5-Jan-2011.) (Revised by Thierry Arnoux, 19-Jan-2024.)
theorem ismxidl {j: setvar} (B2: class j) (R M: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wcel R crg) (wb (wcel M (cfv R cmxidl)) (w3a (wcel M (cfv R clidl)) (wne M B2) (wral j (wi (wss M (cv j)) (wo (wceq (cv j) M) (wceq (cv j) B2))) (cfv R clidl)))) $;

--| A maximal ideal is an ideal. (Contributed by Jeff Madsen, 5-Jan-2011.) (Revised by Thierry Arnoux, 19-Jan-2024.)
theorem mxidlidl (B2 R M: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wa (wcel R crg) (wcel M (cfv R cmxidl))) (wcel M (cfv R clidl)) $;

--| A maximal ideal is proper. (Contributed by Jeff Madsen, 16-Jun-2011.) (Revised by Thierry Arnoux, 19-Jan-2024.)
theorem mxidlnr (B2 R M: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wa (wcel R crg) (wcel M (cfv R cmxidl))) (wne M B2) $;

--| A maximal ideal is a maximal proper ideal. (Contributed by Jeff Madsen, 16-Jun-2011.) (Revised by Thierry Arnoux, 19-Jan-2024.)
theorem mxidlmax (B2 R I M: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wa (wa (wcel R crg) (wcel M (cfv R cmxidl))) (wa (wcel I (cfv R clidl)) (wss M I))) (wo (wceq I M) (wceq I B2)) $;

--| One is not contained in any maximal ideal. (Contributed by Jeff Madsen, 17-Jun-2011.) (Revised by Thierry Arnoux, 19-Jan-2024.)
theorem mxidln1 (B2 R c_1 M: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi (wa (wcel R crg) (wcel M (cfv R cmxidl))) (wn (wcel c_1 M)) $;

--| A ring with a maximal ideal is a nonzero ring. (Contributed by Jeff Madsen, 17-Jun-2011.) (Revised by Thierry Arnoux, 19-Jan-2024.)
theorem mxidlnzr (B2 R M: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wa (wcel R crg) (wcel M (cfv R cmxidl))) (wcel R cnzr) $;

--| An ideal ` I ` strictly containing a maximal ideal ` M ` is the whole ring ` B ` . (Contributed by Thierry Arnoux, 9-Mar-2025.)
theorem mxidlmaxv (ph: wff) (B2 R I M X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel M (cfv R cmxidl)) $ >
  $ wi ph (wcel I (cfv R clidl)) $ >
  $ wi ph (wss M I) $ >
  $ wi ph (wcel X (cdif I M)) $ >
  $ wi ph (wceq I B2) $;

--| In a commutative ring, maximal ideals of the opposite ring coincide with maximal ideals. (Contributed by Thierry Arnoux, 13-Mar-2025.)
theorem crngmxidl (R M O: class):
  $ wceq M (cfv R cmxidl) $ >
  $ wceq O (cfv R coppr) $ >
  $ wi (wcel R ccrg) (wceq M (cfv O cmxidl)) $;

--| Every maximal ideal is prime. Statement in [Lang] p. 92. (Contributed by Thierry Arnoux, 21-Jan-2024.)
theorem mxidlprm (R c_xp M: class):
  $ wceq c_xp (cfv (cfv R cmgp) clsm) $ >
  $ wi (wa (wcel R ccrg) (wcel M (cfv R cmxidl))) (wcel M (cfv R cprmidl)) $;

--| In an integral domain, the generator of a maximal ideal is irreducible. (Contributed by Thierry Arnoux, 22-Mar-2025.)
theorem mxidlirredi (ph: wff) (B2 R K M X c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq K (cfv R crsp) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq M (cfv (csn X) K) $ >
  $ wi ph (wcel R cidom) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wne X c_0) $ >
  $ wi ph (wcel M (cfv R cmxidl)) $ >
  $ wi ph (wcel X (cfv R cir)) $;

--| In a principal ideal domain, maximal ideals are exactly the ideals generated by irreducible elements. (Contributed by Thierry Arnoux, 22-Mar-2025.)
theorem mxidlirred (ph: wff) (B2 R K M X c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq K (cfv R crsp) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq M (cfv (csn X) K) $ >
  $ wi ph (wcel R cpid) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wne X c_0) $ >
  $ wi ph (wcel M (cfv R clidl)) $ >
  $ wi ph (wb (wcel M (cfv R cmxidl)) (wcel X (cfv R cir))) $;

--| The set ` P ` used in the proof of ~ ssmxidl satisfies the condition of Zorn's Lemma. (Contributed by Thierry Arnoux, 10-Apr-2024.)
theorem ssmxidllem {p: setvar} (ph: wff p) (B2: class) (P: class p) (R I Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq P (crab p (wa (wne (cv p) B2) (wss I (cv p))) (cfv R clidl)) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel I (cfv R clidl)) $ >
  $ wi ph (wne I B2) $ >
  $ wi ph (wss Z P) $ >
  $ wi ph (wne Z c0) $ >
  $ wi ph (wor Z crpss) $ >
  $ wi ph (wcel (cuni Z) P) $;

--| Let ` R ` be a ring, and let ` I ` be a proper ideal of ` R ` . Then there is a maximal ideal of ` R ` containing ` I ` . (Contributed by Thierry Arnoux, 10-Apr-2024.)
theorem ssmxidl {m: setvar} (B2 R I: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wi (w3a (wcel R crg) (wcel I (cfv R clidl)) (wne I B2)) (wrex m (wss I (cv m)) (cfv R cmxidl)) $;

--| In a division ring, the zero ideal is a maximal ideal. (Contributed by Thierry Arnoux, 16-Mar-2025.)
theorem drng0mxidl (R c_0: class):
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wcel R cdr) (wcel (csn c_0) (cfv R cmxidl)) $;

--| The zero ideal is the only ideal of a division ring. (Contributed by Thierry Arnoux, 16-Mar-2025.)
theorem drngmxidl (R c_0: class):
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wcel R cdr) (wceq (cfv R cmxidl) (csn (csn c_0))) $;

--| If a ring's only maximal ideal is the zero ideal, it is a division ring. See also ~ drngmxidl . (Contributed by Thierry Arnoux, 3-Jun-2025.)
theorem drngmxidlr (ph: wff) (B2 R M c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq M (cfv R cmxidl) $ >
  $ wi ph (wcel R cnzr) $ >
  $ wi ph (wceq M (csn (csn c_0))) $ >
  $ wi ph (wcel R cdr) $;

--| Krull's theorem: Any nonzero ring has at least one maximal ideal. (Contributed by Thierry Arnoux, 10-Apr-2024.)
theorem krull {m: setvar} (R: class):
  $ wi (wcel R cnzr) (wex m (wcel (cv m) (cfv R cmxidl))) $;

--| A ring is nonzero if and only if it has maximal ideals. (Contributed by Thierry Arnoux, 10-Apr-2024.)
theorem mxidlnzrb {m: setvar} (R: class):
  $ wi (wcel R crg) (wb (wcel R cnzr) (wex m (wcel (cv m) (cfv R cmxidl)))) $;

--| Krull's theorem for non-division-rings: Existence of a nonzero maximal ideal. (Contributed by Thierry Arnoux, 3-Jun-2025.)
theorem krullndrng {m: setvar} (ph: wff m) (R c_0: class):
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel R cnzr) $ >
  $ wi ph (wn (wcel R cdr)) $ >
  $ wi ph (wrex m (wne (cv m) (csn c_0)) (cfv R cmxidl)) $;

--| The opposite ring of the opposite ring is the original ring. Note the conditions on this theorem, which makes it unpractical in case we only have e.g. ` R e. Ring ` as a premise. (Contributed by Thierry Arnoux, 9-Mar-2025.)
theorem opprabs (ph: wff) (B2 R c_x O V: class):
  $ wceq O (cfv R coppr) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R V) $ >
  $ wi ph (wfun R) $ >
  $ wi ph (wcel (cfv cnx cmulr) (cdm R)) $ >
  $ wi ph (wfn c_x (cxp B2 B2)) $ >
  $ wi ph (wceq R (cfv O coppr)) $;

--| Group coset equivalence relation for the opposite ring. (Contributed by Thierry Arnoux, 9-Mar-2025.)
theorem oppreqg (B2 R I O V: class):
  $ wceq O (cfv R coppr) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wa (wcel R V) (wss I B2)) (wceq (co R I cqg) (co O I cqg)) $;

--| Normal subgroups of the opposite ring are the same as the original normal subgroups. (Contributed by Thierry Arnoux, 13-Mar-2025.)
theorem opprnsg (R O: class):
  $ wceq O (cfv R coppr) $ >
  $ wceq (cfv R cnsg) (cfv O cnsg) $;

--| The ideals of the opposite ring's opposite ring are the ideals of the original ring. (Contributed by Thierry Arnoux, 9-Mar-2025.)
theorem opprlidlabs (ph: wff) (R O: class):
  $ wceq O (cfv R coppr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wceq (cfv R clidl) (cfv (cfv O coppr) clidl)) $;

--| Two sided ideal of the opposite ring. (Contributed by Thierry Arnoux, 9-Mar-2025.)
theorem oppr2idl (ph: wff) (R O: class):
  $ wceq O (cfv R coppr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wceq (cfv R c2idl) (cfv O c2idl)) $;

--| The maximal ideal of the opposite ring's opposite ring. (Contributed by Thierry Arnoux, 9-Mar-2025.)
theorem opprmxidlabs (ph: wff) (R M O: class):
  $ wceq O (cfv R coppr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel M (cfv R cmxidl)) $ >
  $ wi ph (wcel M (cfv (cfv O coppr) cmxidl)) $;

--| The base of the quotient of the opposite ring is the same as the base of the opposite of the quotient ring. (Contributed by Thierry Arnoux, 9-Mar-2025.)
theorem opprqusbas (ph: wff) (B2 Q R I O V: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq O (cfv R coppr) $ >
  $ wceq Q (co R (co R I cqg) cqus) $ >
  $ wi ph (wcel R V) $ >
  $ wi ph (wss I B2) $ >
  $ wi ph (wceq (cfv (cfv Q coppr) cbs) (cfv (co O (co O I cqg) cqus) cbs)) $;

--| The group operation of the quotient of the opposite ring is the same as the group operation of the opposite of the quotient ring. (Contributed by Thierry Arnoux, 13-Mar-2025.)
theorem opprqusplusg (ph: wff) (B2 Q R E I O X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq O (cfv R coppr) $ >
  $ wceq Q (co R (co R I cqg) cqus) $ >
  $ wi ph (wcel I (cfv R cnsg)) $ >
  $ wceq E (cfv Q cbs) $ >
  $ wi ph (wcel X E) $ >
  $ wi ph (wcel Y E) $ >
  $ wi ph (wceq (co X Y (cfv (cfv Q coppr) cplusg)) (co X Y (cfv (co O (co O I cqg) cqus) cplusg))) $;

--| The group identity element of the quotient of the opposite ring is the same as the group identity element of the opposite of the quotient ring. (Contributed by Thierry Arnoux, 13-Mar-2025.)
theorem opprqus0g (ph: wff) (B2 Q R I O: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq O (cfv R coppr) $ >
  $ wceq Q (co R (co R I cqg) cqus) $ >
  $ wi ph (wcel I (cfv R cnsg)) $ >
  $ wi ph (wceq (cfv (cfv Q coppr) c0g) (cfv (co O (co O I cqg) cqus) c0g)) $;

--| The multiplication operation of the quotient of the opposite ring is the same as the multiplication operation of the opposite of the quotient ring. (Contributed by Thierry Arnoux, 9-Mar-2025.)
theorem opprqusmulr (ph: wff) (B2 Q R E I O X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq O (cfv R coppr) $ >
  $ wceq Q (co R (co R I cqg) cqus) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wceq E (cfv Q cbs) $ >
  $ wi ph (wcel X E) $ >
  $ wi ph (wcel Y E) $ >
  $ wi ph (wceq (co X Y (cfv (cfv Q coppr) cmulr)) (co X Y (cfv (co O (co O I cqg) cqus) cmulr))) $;

--| The ring unity of the quotient of the opposite ring is the same as the ring unity of the opposite of the quotient ring. (Contributed by Thierry Arnoux, 9-Mar-2025.)
theorem opprqus1r (ph: wff) (B2 Q R I O: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq O (cfv R coppr) $ >
  $ wceq Q (co R (co R I cqg) cqus) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wi ph (wceq (cfv (cfv Q coppr) cur) (cfv (co O (co O I cqg) cqus) cur)) $;

--| The quotient of the opposite ring is a division ring iff the opposite of the quotient ring is. (Contributed by Thierry Arnoux, 13-Mar-2025.)
theorem opprqusdrng (ph: wff) (B2 Q R I O: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq O (cfv R coppr) $ >
  $ wceq Q (co R (co R I cqg) cqus) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel I (cfv R c2idl)) $ >
  $ wi ph (wb (wcel (cfv Q coppr) cdr) (wcel (co O (co O I cqg) cqus) cdr)) $;

--| Lemma for ~ qsdrngi . (Contributed by Thierry Arnoux, 9-Mar-2025.)
theorem qsdrngilem {v: setvar} (ph: wff) (Q R M: class) (O: class v) (X: class):
  $ wceq O (cfv R coppr) $ >
  $ wceq Q (co R (co R M cqg) cqus) $ >
  $ wi ph (wcel R cnzr) $ >
  $ wi ph (wcel M (cfv R cmxidl)) $ >
  $ wi ph (wcel M (cfv O cmxidl)) $ >
  $ wi ph (wcel X (cfv R cbs)) $ >
  $ wi ph (wn (wcel X M)) $ >
  $ wi ph (wrex v (wceq (co (cv v) (cec X (co R M cqg)) (cfv Q cmulr)) (cfv Q cur)) (cfv Q cbs)) $;

--| A quotient by a maximal left and maximal right ideal is a division ring. (Contributed by Thierry Arnoux, 9-Mar-2025.)
theorem qsdrngi (ph: wff) (Q R M O: class):
  $ wceq O (cfv R coppr) $ >
  $ wceq Q (co R (co R M cqg) cqus) $ >
  $ wi ph (wcel R cnzr) $ >
  $ wi ph (wcel M (cfv R cmxidl)) $ >
  $ wi ph (wcel M (cfv O cmxidl)) $ >
  $ wi ph (wcel Q cdr) $;

--| Lemma for ~ qsdrng . (Contributed by Thierry Arnoux, 13-Mar-2025.)
theorem qsdrnglem2 (ph: wff) (B2 Q R J M O X: class):
  $ wceq O (cfv R coppr) $ >
  $ wceq Q (co R (co R M cqg) cqus) $ >
  $ wi ph (wcel R cnzr) $ >
  $ wi ph (wcel M (cfv R c2idl)) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel Q cdr) $ >
  $ wi ph (wcel J (cfv R clidl)) $ >
  $ wi ph (wss M J) $ >
  $ wi ph (wcel X (cdif J M)) $ >
  $ wi ph (wceq J B2) $;

--| An ideal ` M ` is both left and right maximal if and only if the factor ring ` Q ` is a division ring. (Contributed by Thierry Arnoux, 13-Mar-2025.)
theorem qsdrng (ph: wff) (Q R M O: class):
  $ wceq O (cfv R coppr) $ >
  $ wceq Q (co R (co R M cqg) cqus) $ >
  $ wi ph (wcel R cnzr) $ >
  $ wi ph (wcel M (cfv R c2idl)) $ >
  $ wi ph (wb (wcel Q cdr) (wa (wcel M (cfv R cmxidl)) (wcel M (cfv O cmxidl)))) $;

--| An ideal ` M ` in the commutative ring ` R ` is maximal if and only if the factor ring ` Q ` is a field. (Contributed by Thierry Arnoux, 13-Mar-2025.)
theorem qsfld (ph: wff) (Q R M: class):
  $ wceq Q (co R (co R M cqg) cqus) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel R cnzr) $ >
  $ wi ph (wcel M (cfv R clidl)) $ >
  $ wi ph (wb (wcel Q cfield) (wcel M (cfv R cmxidl))) $;

--| Every maximal ideal is prime - alternative proof. (Contributed by Thierry Arnoux, 15-Mar-2025.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem mxidlprmALT (ph: wff) (R M: class):
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel M (cfv R cmxidl)) $ >
  $ wi ph (wcel M (cfv R cprmidl)) $;

--| A division ring is a local ring. (Contributed by Thierry Arnoux, 2-Jun-2026.)
theorem drnglring (ph: wff) (F: class):
  $ wi ph (wcel F cdr) $ >
  $ wi ph (wcel F clring) $;

--| Alternate definition of a local ring. (Contributed by Thierry Arnoux, 2-Jun-2026.)
theorem dflring2 {x3: setvar} (B2: class x3) (R: class) (U c_1 c_mi: class x3):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_mi (cfv R csg) $ >
  $ wb (wcel R clring) (wa (wcel R cnzr) (wral x3 (wo (wcel (cv x3) U) (wcel (co c_1 (cv x3) c_mi) U)) B2)) $;

--| Lemma for ~ dflring3 . If a ring ` R ` has a single maximal ideal ` M ` , then any element ` X ` outside of ` M ` is a unit. (Contributed by Thierry Arnoux, 2-Jun-2026.)
theorem dflringlem (ph: wff) (B2 R U M X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R cui) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel M (cfv R cmxidl)) $ >
  $ wi ph (wceq (cfv R cmxidl) (csn M)) $ >
  $ wi ph (wcel X (cdif B2 M)) $ >
  $ wi ph (wcel X U) $;

--| Lemma for ~ dflring3 . In a commutative local ring ` R ` , the set ` ( B \ U ) ` of non-units is an ideal. (Contributed by Thierry Arnoux, 2-Jun-2026.)
theorem dflringlem2 (ph: wff) (B2 R U: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R cui) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel R clring) $ >
  $ wi ph (wcel (cdif B2 U) (cfv R clidl)) $;

--| Lemma for ~ dflring3 . In a commutative local ring ` R ` , the set ` ( B \ U ) ` of non-units is a maximal ideal. (Contributed by Thierry Arnoux, 2-Jun-2026.)
theorem dflringlem3 (ph: wff) (B2 R U: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R cui) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel R clring) $ >
  $ wi ph (wcel (cdif B2 U) (cfv R cmxidl)) $;

--| Alternate definition of a local ring: local rings have a single maximal ideal. (Contributed by Thierry Arnoux, 2-Jun-2026.)
theorem dflring3 (R: class):
  $ wi (wcel R ccrg) (wb (wcel R clring) (wbr (cfv R cmxidl) c1o cen)) $;

--| Alternate definition of a local ring: the set ` ( B \ U ) ` of non-units is an ideal. (Contributed by Thierry Arnoux, 2-Jun-2026.)
theorem dflring4 (B2 R U: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R cui) $ >
  $ wi (wcel R ccrg) (wb (wcel R clring) (wcel (cdif B2 U) (cfv R clidl))) $;

--| A field is a local ring. (Contributed by Thierry Arnoux, 3-Jun-2026.) (Proof modification is discouraged.)
theorem fldlring (ph: wff) (F: class):
  $ wi ph (wcel F cfield) $ >
  $ wi ph (wcel F clring) $;

--| Extend class notation with the semiring of ideals of a ring.
term cidlsrg: class;

--| Define a structure for the ideals of a ring. (Contributed by Thierry Arnoux, 21-Jan-2024.)
axiom df_idlsrg {i j r b: setvar}:
  $ wceq cidlsrg (cmpt r cvv (csb b (cfv (cv r) clidl) (cun (ctp (cop (cfv cnx cbs) (cv b)) (cop (cfv cnx cplusg) (cfv (cv r) clsm)) (cop (cfv cnx cmulr) (cmpo i j (cv b) (cv b) (cfv (co (cv i) (cv j) (cfv (cfv (cv r) cmgp) clsm)) (cfv (cv r) crsp))))) (cpr (cop (cfv cnx cts) (crn (cmpt i (cv b) (crab j (wn (wss (cv i) (cv j))) (cv b))))) (cop (cfv cnx cple) (copab i j (wa (wss (cpr (cv i) (cv j)) (cv b)) (wss (cv i) (cv j))))))))) $;

--| A constructed semiring of ideals is a structure. (Contributed by Thierry Arnoux, 1-Jun-2024.)
theorem idlsrgstr (B2 c_pl c_x J c_le W: class):
  $ wceq W (cun (ctp (cop (cfv cnx cbs) B2) (cop (cfv cnx cplusg) c_pl) (cop (cfv cnx cmulr) c_x)) (cpr (cop (cfv cnx cts) J) (cop (cfv cnx cple) c_le))) $ >
  $ wbr W (cop c1 (cdc c1 cc0)) cstr $;

--| Lemma for ~ idlsrgbas through ~ idlsrgtset . (Contributed by Thierry Arnoux, 1-Jun-2024.)
theorem idlsrgval {i j: setvar} (c_po: class i j) (R: class) (c_xo G: class i j) (I: class) (V: class i j):
  $ wceq I (cfv R clidl) $ >
  $ wceq c_po (cfv R clsm) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_xo (cfv G clsm) $ >
  $ wi (wcel R V) (wceq (cfv R cidlsrg) (cun (ctp (cop (cfv cnx cbs) I) (cop (cfv cnx cplusg) c_po) (cop (cfv cnx cmulr) (cmpo i j I I (cfv (co (cv i) (cv j) c_xo) (cfv R crsp))))) (cpr (cop (cfv cnx cts) (crn (cmpt i I (crab j (wn (wss (cv i) (cv j))) I)))) (cop (cfv cnx cple) (copab i j (wa (wss (cpr (cv i) (cv j)) I) (wss (cv i) (cv j)))))))) $;

--| Base of the ideals of a ring. (Contributed by Thierry Arnoux, 1-Jun-2024.)
theorem idlsrgbas (R S I V: class):
  $ wceq S (cfv R cidlsrg) $ >
  $ wceq I (cfv R clidl) $ >
  $ wi (wcel R V) (wceq I (cfv S cbs)) $;

--| Additive operation of the ideals of a ring. (Contributed by Thierry Arnoux, 1-Jun-2024.)
theorem idlsrgplusg (c_po R S V: class):
  $ wceq S (cfv R cidlsrg) $ >
  $ wceq c_po (cfv R clsm) $ >
  $ wi (wcel R V) (wceq c_po (cfv S cplusg)) $;

--| The zero ideal is the additive identity of the semiring of ideals. (Contributed by Thierry Arnoux, 1-Jun-2024.)
theorem idlsrg0g (R S c_0: class):
  $ wceq S (cfv R cidlsrg) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi (wcel R crg) (wceq (csn c_0) (cfv S c0g)) $;

--| Multiplicative operation of the ideals of a ring. (Contributed by Thierry Arnoux, 1-Jun-2024.)
theorem idlsrgmulr {i j: setvar} (B2 R: class) (S c_xo G V: class i j):
  $ wceq S (cfv R cidlsrg) $ >
  $ wceq B2 (cfv R clidl) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_xo (cfv G clsm) $ >
  $ wi (wcel R V) (wceq (cmpo i j B2 B2 (cfv (co (cv i) (cv j) c_xo) (cfv R crsp))) (cfv S cmulr)) $;

--| Topology component of the ideals of a ring. (Contributed by Thierry Arnoux, 1-Jun-2024.)
theorem idlsrgtset {i j: setvar} (R: class) (S: class i j) (I: class) (J: class i j) (V: class j):
  $ wceq S (cfv R cidlsrg) $ >
  $ wceq I (cfv R clidl) $ >
  $ wceq J (crn (cmpt i I (crab j (wn (wss (cv i) (cv j))) I))) $ >
  $ wi (wcel R V) (wceq J (cfv S cts)) $;

--| Value of the ring multiplication for the ideals of a ring ` R ` . (Contributed by Thierry Arnoux, 1-Jun-2024.)
theorem idlsrgmulrval (ph: wff) (B2 R S c_x c_xo G I J V: class):
  $ wceq S (cfv R cidlsrg) $ >
  $ wceq B2 (cfv R clidl) $ >
  $ wceq c_xo (cfv S cmulr) $ >
  $ wceq G (cfv R cmgp) $ >
  $ wceq c_x (cfv G clsm) $ >
  $ wi ph (wcel R V) $ >
  $ wi ph (wcel I B2) $ >
  $ wi ph (wcel J B2) $ >
  $ wi ph (wceq (co I J c_xo) (cfv (co I J c_x) (cfv R crsp))) $;

--| Ideals of a ring ` R ` are closed under multiplication. (Contributed by Thierry Arnoux, 1-Jun-2024.)
theorem idlsrgmulrcl (ph: wff) (B2 R S c_xo I J: class):
  $ wceq S (cfv R cidlsrg) $ >
  $ wceq B2 (cfv R clidl) $ >
  $ wceq c_xo (cfv S cmulr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel I B2) $ >
  $ wi ph (wcel J B2) $ >
  $ wi ph (wcel (co I J c_xo) B2) $;

--| In a commutative ring, the product of two ideals is a subset of the first one. (Contributed by Thierry Arnoux, 16-Jun-2024.)
theorem idlsrgmulrss1 (ph: wff) (B2 R S c_x c_xo I J: class):
  $ wceq S (cfv R cidlsrg) $ >
  $ wceq B2 (cfv R clidl) $ >
  $ wceq c_xo (cfv S cmulr) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel I B2) $ >
  $ wi ph (wcel J B2) $ >
  $ wi ph (wss (co I J c_xo) I) $;

--| The product of two ideals is a subset of the second one. (Contributed by Thierry Arnoux, 2-Jun-2024.)
theorem idlsrgmulrss2 (ph: wff) (B2 R S c_x c_xo I J: class):
  $ wceq S (cfv R cidlsrg) $ >
  $ wceq B2 (cfv R clidl) $ >
  $ wceq c_xo (cfv S cmulr) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel I B2) $ >
  $ wi ph (wcel J B2) $ >
  $ wi ph (wss (co I J c_xo) J) $;

--| In a commutative ring, the product of two ideals is a subset of their intersection. (Contributed by Thierry Arnoux, 17-Jun-2024.)
theorem idlsrgmulrssin (ph: wff) (B2 R S c_xo I J: class):
  $ wceq S (cfv R cidlsrg) $ >
  $ wceq B2 (cfv R clidl) $ >
  $ wceq c_xo (cfv S cmulr) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel I B2) $ >
  $ wi ph (wcel J B2) $ >
  $ wi ph (wss (co I J c_xo) (cin I J)) $;

--| The ideals of a ring form a monoid. (Contributed by Thierry Arnoux, 1-Jun-2024.)
theorem idlsrgmnd (R S: class):
  $ wceq S (cfv R cidlsrg) $ >
  $ wi (wcel R crg) (wcel S cmnd) $;

--| The ideals of a ring form a commutative monoid. (Contributed by Thierry Arnoux, 1-Jun-2024.)
theorem idlsrgcmnd (R S: class):
  $ wceq S (cfv R cidlsrg) $ >
  $ wi (wcel R crg) (wcel S ccmn) $;

--| The prime elements of a ring ` R ` . (Contributed by Thierry Arnoux, 1-Jul-2024.)
theorem rprmval {x3 y1 p: setvar} (B2: class x3 y1) (c_pa: class x3 y1 p) (R: class) (c_x: class x3 y1 p) (U: class x3 y1) (V: class x3 y1 p) (c_0: class x3 y1):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wi (wcel R V) (wceq (cfv R crpm) (crab p (wral x3 (wral y1 (wi (wbr (cv p) (co (cv x3) (cv y1) c_x) c_pa) (wo (wbr (cv p) (cv x3) c_pa) (wbr (cv p) (cv y1) c_pa))) B2) B2) (cdif B2 (cun U (csn c_0))))) $;

--| Property for ` P ` to be a prime element in the ring ` R ` . (Contributed by Thierry Arnoux, 1-Jul-2024.)
theorem isrprm {x3 y1: setvar} (B2 c_pa: class x3 y1) (P R: class) (c_x U V c_0: class x3 y1):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi (wcel R V) (wb (wcel P (cfv R crpm)) (wa (wcel P (cdif B2 (cun U (csn c_0)))) (wral x3 (wral y1 (wi (wbr P (co (cv x3) (cv y1) c_x) c_pa) (wo (wbr P (cv x3) c_pa) (wbr P (cv y1) c_pa))) B2) B2))) $;

--| A ring prime is an element of the base set. (Contributed by Thierry Arnoux, 18-May-2025.)
theorem rprmcl (ph: wff) (B2 P R V X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq P (cfv R crpm) $ >
  $ wi ph (wcel R V) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel X B2) $;

--| If a ring prime ` Q ` divides a product ` X .x. Y ` , then it divides either ` X ` or ` Y ` . (Contributed by Thierry Arnoux, 18-May-2025.)
theorem rprmdvds (ph: wff) (B2 c_pa P Q R c_x V X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq P (cfv R crpm) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R V) $ >
  $ wi ph (wcel Q P) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wbr Q (co X Y c_x) c_pa) $ >
  $ wi ph (wo (wbr Q X c_pa) (wbr Q Y c_pa)) $;

--| A ring prime is nonzero. (Contributed by Thierry Arnoux, 18-May-2025.)
theorem rprmnz (ph: wff) (P Q R V c_0: class):
  $ wceq P (cfv R crpm) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel R V) $ >
  $ wi ph (wcel Q P) $ >
  $ wi ph (wne Q c_0) $;

--| A ring prime is not a unit. (Contributed by Thierry Arnoux, 18-May-2025.)
theorem rprmnunit (ph: wff) (P Q R U V: class):
  $ wceq P (cfv R crpm) $ >
  $ wceq U (cfv R cui) $ >
  $ wi ph (wcel R V) $ >
  $ wi ph (wcel Q P) $ >
  $ wi ph (wn (wcel Q U)) $;

--| In a commutative ring, ideals generated by prime elements are prime ideals. (Contributed by Thierry Arnoux, 18-May-2025.)
theorem rsprprmprmidl (ph: wff) (P R K: class):
  $ wceq K (cfv R crsp) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel P (cfv R crpm)) $ >
  $ wi ph (wcel (cfv (csn P) K) (cfv R cprmidl)) $;

--| An ideal generated by a single element is a prime iff that element is prime. (Contributed by Thierry Arnoux, 18-May-2025.)
theorem rsprprmprmidlb (ph: wff) (B2 P R K X c_0: class):
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq P (cfv R crpm) $ >
  $ wceq K (cfv R crsp) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wne X c_0) $ >
  $ wi ph (wb (wcel X P) (wcel (cfv (csn X) K) (cfv R cprmidl))) $;

--| A ring prime element does not divide the ring multiplicative identity. (Contributed by Thierry Arnoux, 18-May-2025.)
theorem rprmndvdsr1 (ph: wff) (c_pa P Q R c_1: class):
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wceq P (cfv R crpm) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel Q P) $ >
  $ wi ph (wn (wbr Q c_1 c_pa)) $;

--| In an integral domain, the associate of a prime is a prime. (Contributed by Thierry Arnoux, 18-May-2025.)
theorem rprmasso (ph: wff) (B2 c_pa P R X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq P (cfv R crpm) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wi ph (wcel R cidom) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wbr X Y c_pa) $ >
  $ wi ph (wbr Y X c_pa) $ >
  $ wi ph (wcel Y P) $;

--| In an integral domain, if a prime element divides another, they are associates. (Contributed by Thierry Arnoux, 18-May-2025.)
theorem rprmasso2 (ph: wff) (B2 c_pa P R X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq P (cfv R crpm) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wi ph (wcel R cidom) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wbr X Y c_pa) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wbr Y X c_pa) $;

--| In an integral domain, if a prime element divides another, they are associates. (Contributed by Thierry Arnoux, 27-May-2025.)
theorem rprmasso3 {t: setvar} (ph: wff) (B2 c_pa: class) (P: class t) (R c_x U X Y: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq P (cfv R crpm) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wi ph (wcel R cidom) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wbr X Y c_pa) $ >
  $ wi ph (wcel Y P) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq U (cfv R cui) $ >
  $ wi ph (wrex t (wceq (co (cv t) X c_x) Y) U) $;

--| A ring unit multiplied by a ring prime is a ring prime. (Contributed by Thierry Arnoux, 3-Jun-2025.)
theorem unitmulrprm (ph: wff) (P Q R c_x U I: class):
  $ wceq P (cfv R crpm) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel R cidom) $ >
  $ wi ph (wcel I U) $ >
  $ wi ph (wcel Q P) $ >
  $ wi ph (wcel (co I Q c_x) P) $;

--| A ring prime element does not divide any ring unit. (Contributed by Thierry Arnoux, 27-May-2025.)
theorem rprmndvdsru (ph: wff) (c_pa P Q R T U: class):
  $ wceq U (cfv R cui) $ >
  $ wceq P (cfv R crpm) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel Q P) $ >
  $ wi ph (wcel T U) $ >
  $ wi ph (wn (wbr Q T c_pa)) $;

--| Lemma for ~ rprmirred . (Contributed by Thierry Arnoux, 18-May-2025.)
theorem rprmirredlem (ph: wff) (B2 c_pa Q R c_x U X Y c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wi ph (wcel R cidom) $ >
  $ wi ph (wne Q c_0) $ >
  $ wi ph (wcel X (cdif B2 U)) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq Q (co X Y c_x)) $ >
  $ wi ph (wbr Q X c_pa) $ >
  $ wi ph (wcel Y U) $;

--| In an integral domain, ring primes are irreducible. (Contributed by Thierry Arnoux, 18-May-2025.)
theorem rprmirred (ph: wff) (P Q R I: class):
  $ wceq P (cfv R crpm) $ >
  $ wceq I (cfv R cir) $ >
  $ wi ph (wcel Q P) $ >
  $ wi ph (wcel R cidom) $ >
  $ wi ph (wcel Q I) $;

--| In a principal ideal domain, the converse of ~ rprmirred holds, i.e. irreducible elements are prime. (Contributed by Thierry Arnoux, 18-May-2025.)
theorem rprmirredb (ph: wff) (P R I: class):
  $ wceq P (cfv R crpm) $ >
  $ wceq I (cfv R cir) $ >
  $ wi ph (wcel R cpid) $ >
  $ wi ph (wceq I P) $;

--| If a prime element divides a ring "power", it divides the term. (Contributed by Thierry Arnoux, 18-May-2025.)
theorem rprmdvdspow (ph: wff) (B2 c_pa P Q R c_ex M N X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq P (cfv R crpm) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wceq c_ex (cfv M cmg) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Q P) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wbr Q (co N X c_ex) c_pa) $ >
  $ wi ph (wbr Q X c_pa) $;

--| If a prime element ` Q ` divides a product, then it divides one term. (Contributed by Thierry Arnoux, 18-May-2025.)
theorem rprmdvdsprod {x3: setvar} (ph: wff) (B2: class x3) (c_pa: class) (P: class x3) (Q: class) (R: class x3) (c_1 F: class) (I M V: class x3):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq P (cfv R crpm) $ >
  $ wceq c_pa (cfv R cdsr) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel Q P) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wbr F c_1 cfsupp) $ >
  $ wi ph (wf I B2 F) $ >
  $ wi ph (wbr Q (co M F cgsu) c_pa) $ >
  $ wi ph (wrex x3 (wbr Q (cfv (cv x3) F) c_pa) (co F c_1 csupp)) $;

--| Lemma for ~ 1arithidom . (Contributed by Thierry Arnoux, 30-May-2025.)
theorem _1arithidomlem1 {w u g2 k c d: setvar} (ph: wff w u g2 k c d) (P: class w c d) (Q: class c d) (R: class w c d) (S: class) (T: class g2 k c d) (c_x U F: class) (G: class w u g2 k c d) (H: class) (J: class w u g2 k c d) (K: class g2 c d) (M: class w c d) (N: class g2 k c d):
  $ wceq U (cfv R cui) $ >
  $ wceq P (cfv R crpm) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq J (co cc0 (cfv F chash) cfzo) $ >
  $ wi ph (wcel R cidom) $ >
  $ wi ph (wcel F (cword P)) $ >
  $ wi ph (wcel G (cword P)) $ >
  $ wi ph (wceq (co M F cgsu) (co M G cgsu)) $ >
  $ wi ph (wcel Q P) $ >
  $ wi ph (wral g2 (wi (wrex k (wceq (co M F cgsu) (co (cv k) (co M (cv g2) cgsu) c_x)) U) (wex w (wrex u (wa (wf1o (co cc0 (cfv F chash) cfzo) (co cc0 (cfv F chash) cfzo) (cv w)) (wceq (cv g2) (co (cv u) (ccom F (cv w)) (cof c_x)))) (co U (co cc0 (cfv F chash) cfzo) cmap)))) (cword P)) $ >
  $ wi ph (wcel H (cword P)) $ >
  $ wi ph (wrex k (wceq (co M (co F (cs1 Q) cconcat) cgsu) (co (cv k) (co M H cgsu) c_x)) U) $ >
  $ wi ph (wcel K (co cc0 (cfv H chash) cfzo)) $ >
  $ wi ph (wbr Q (cfv K H) (cfv R cdsr)) $ >
  $ wi ph (wcel T U) $ >
  $ wi ph (wceq (co T Q c_x) (cfv K H)) $ >
  $ wi ph (wf1o (co cc0 (cfv H chash) cfzo) (co cc0 (cfv H chash) cfzo) S) $ >
  $ wi ph (wceq (ccom H S) (co (co (ccom H S) (co (cfv H chash) c1 cmin) cpfx) (cs1 (cfv K H)) cconcat)) $ >
  $ wi ph (wcel N U) $ >
  $ wi ph (wceq (co M (co F (cs1 Q) cconcat) cgsu) (co N (co M H cgsu) c_x)) $ >
  $ wi ph (wex c (wrex d (wa (wf1o (co cc0 (cfv F chash) cfzo) (co cc0 (cfv F chash) cfzo) (cv c)) (wceq (co (ccom H S) (co (cfv H chash) c1 cmin) cpfx) (co (cv d) (ccom F (cv c)) (cof c_x)))) (co U (co cc0 (cfv F chash) cfzo) cmap))) $;

--| Lemma for ~ 1arithidom : induction step. (Contributed by Thierry Arnoux, 27-May-2025.)
theorem _1arithidomlem2 {w u g2 k: setvar} (ph: wff w u g2 k) (C: class w g2 k) (D: class w u g2 k) (P: class w) (Q: class) (R: class w) (S: class) (T: class g2 k) (c_x U F: class) (G: class w u g2 k) (H: class) (J: class w u g2 k) (K: class g2) (M: class w) (N: class g2 k):
  $ wceq U (cfv R cui) $ >
  $ wceq P (cfv R crpm) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq J (co cc0 (cfv F chash) cfzo) $ >
  $ wi ph (wcel R cidom) $ >
  $ wi ph (wcel F (cword P)) $ >
  $ wi ph (wcel G (cword P)) $ >
  $ wi ph (wceq (co M F cgsu) (co M G cgsu)) $ >
  $ wi ph (wcel Q P) $ >
  $ wi ph (wral g2 (wi (wrex k (wceq (co M F cgsu) (co (cv k) (co M (cv g2) cgsu) c_x)) U) (wex w (wrex u (wa (wf1o (co cc0 (cfv F chash) cfzo) (co cc0 (cfv F chash) cfzo) (cv w)) (wceq (cv g2) (co (cv u) (ccom F (cv w)) (cof c_x)))) (co U (co cc0 (cfv F chash) cfzo) cmap)))) (cword P)) $ >
  $ wi ph (wcel H (cword P)) $ >
  $ wi ph (wrex k (wceq (co M (co F (cs1 Q) cconcat) cgsu) (co (cv k) (co M H cgsu) c_x)) U) $ >
  $ wi ph (wcel K (co cc0 (cfv H chash) cfzo)) $ >
  $ wi ph (wbr Q (cfv K H) (cfv R cdsr)) $ >
  $ wi ph (wcel T U) $ >
  $ wi ph (wceq (co T Q c_x) (cfv K H)) $ >
  $ wi ph (wf1o (co cc0 (cfv H chash) cfzo) (co cc0 (cfv H chash) cfzo) S) $ >
  $ wi ph (wceq (ccom H S) (co (co (ccom H S) (co (cfv H chash) c1 cmin) cpfx) (cs1 (cfv K H)) cconcat)) $ >
  $ wi ph (wcel N U) $ >
  $ wi ph (wceq (co M (co F (cs1 Q) cconcat) cgsu) (co N (co M H cgsu) c_x)) $ >
  $ wi ph (wcel D (co U (co cc0 (cfv F chash) cfzo) cmap)) $ >
  $ wi ph (wf1o (co cc0 (cfv F chash) cfzo) (co cc0 (cfv F chash) cfzo) C) $ >
  $ wi ph (wceq (co (ccom H S) (co (cfv H chash) c1 cmin) cpfx) (co D (ccom F C) (cof c_x))) $ >
  $ wi ph (wa (wf1o (co cc0 (cfv (co F (cs1 Q) cconcat) chash) cfzo) (co cc0 (cfv (co F (cs1 Q) cconcat) chash) cfzo) (ccom (co C (cs1 (cfv F chash)) cconcat) (ccnv S))) (wceq H (co (ccom (co D (cs1 T) cconcat) (ccnv S)) (ccom (co F (cs1 Q) cconcat) (ccom (co C (cs1 (cfv F chash)) cconcat) (ccnv S))) (cof c_x)))) $;

--| Uniqueness of prime factorizations in an integral domain ` R ` . Given two equal products ` F ` and ` G ` of prime elements, ` F ` and ` G ` are equal up to a renumbering ` w ` and a multiplication by units ` u ` . See also ~ 1arith . Chapter VII, Paragraph 3, Section 3, Proposition 2 of [BourbakiCAlg2], p. 228. (Contributed by Thierry Arnoux, 27-May-2025.)
theorem _1arithidom {w u: setvar} (ph: wff w) (P R c_x U F G: class) (J: class w u) (M: class):
  $ wceq U (cfv R cui) $ >
  $ wceq P (cfv R crpm) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq J (co cc0 (cfv F chash) cfzo) $ >
  $ wi ph (wcel R cidom) $ >
  $ wi ph (wcel F (cword P)) $ >
  $ wi ph (wcel G (cword P)) $ >
  $ wi ph (wceq (co M F cgsu) (co M G cgsu)) $ >
  $ wi ph (wex w (wrex u (wa (wf1o J J (cv w)) (wceq G (co (cv u) (ccom F (cv w)) (cof c_x)))) (co U J cmap))) $;

--| Class of unique factorization domains.
term cufd: class;

--| Define the class of unique factorization domains. A unique factorization domain (UFD for short), is an integral domain such that every nonzero prime ideal contains a prime element (this is a characterization due to Irving Kaplansky). A UFD is sometimes also called a "factorial ring" following the terminology of Bourbaki. (Contributed by Mario Carneiro, 17-Feb-2015.) Exclude the 0 prime ideal. (Revised by Thierry Arnoux, 9-May-2025.) Exclude the 0 ring. (Revised by Thierry Arnoux, 14-Jun-2025.)
axiom df_ufd {i r: setvar}:
  $ wceq cufd (crab r (wral i (wne (cin (cv i) (cfv (cv r) crpm)) c0) (cdif (cfv (cv r) cprmidl) (csn (csn (cfv (cv r) c0g))))) cidom) $;

--| The property of being a Unique Factorization Domain. (Contributed by Thierry Arnoux, 1-Jun-2024.)
theorem isufd {i: setvar} (P: class i) (R: class) (I c_0: class i):
  $ wceq I (cfv R cprmidl) $ >
  $ wceq P (cfv R crpm) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wb (wcel R cufd) (wa (wcel R cidom) (wral i (wne (cin (cv i) P) c0) (cdif I (csn (csn c_0))))) $;

--| In a unique factorization domain ` R ` , a nonzero prime ideal ` J ` contains a prime element ` p ` . (Contributed by Thierry Arnoux, 3-Jun-2025.)
theorem ufdprmidl {p: setvar} (ph: wff p) (P: class) (R I: class p) (J: class) (c_0: class p):
  $ wceq I (cfv R cprmidl) $ >
  $ wceq P (cfv R crpm) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel R cufd) $ >
  $ wi ph (wcel J I) $ >
  $ wi ph (wne J (csn c_0)) $ >
  $ wi ph (wrex p (wcel (cv p) J) P) $;

--| A nonzero unique factorization domain is an integral domain. (Contributed by Thierry Arnoux, 3-Jun-2025.)
theorem ufdidom (ph: wff) (R: class):
  $ wi ph (wcel R cufd) $ >
  $ wi ph (wcel R cidom) $;

--| Every principal ideal domain is a unique factorization domain. (Contributed by Thierry Arnoux, 3-Jun-2025.)
theorem pidufd (ph: wff) (R: class):
  $ wi ph (wcel R cpid) $ >
  $ wi ph (wcel R cufd) $;

--| Lemma for ~ 1arithufd . The set ` S ` of elements which can be written as a product of primes is not empty. (Contributed by Thierry Arnoux, 3-Jun-2025.)
theorem _1arithufdlem1 {x3 f2: setvar} (ph: wff x3) (B2: class f2) (P: class) (R: class x3) (S U: class x3 f2) (M: class) (c_0: class x3):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq P (cfv R crpm) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wi ph (wcel R cufd) $ >
  $ wi ph (wn (wcel R cdr)) $ >
  $ wceq S (crab x3 (wrex f2 (wceq (cv x3) (co M (cv f2) cgsu)) (cword P)) B2) $ >
  $ wi ph (wne S c0) $;

--| Lemma for ~ 1arithufd . The set ` S ` of elements which can be written as a product of primes is multiplicatively closed. (Contributed by Thierry Arnoux, 3-Jun-2025.)
theorem _1arithufdlem2 {x3 f2: setvar} (ph: wff) (B2: class f2) (P: class) (R: class x3) (S: class x3 f2) (c_x: class) (U: class x3 f2) (M X Y: class) (c_0: class x3):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq P (cfv R crpm) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wi ph (wcel R cufd) $ >
  $ wi ph (wn (wcel R cdr)) $ >
  $ wceq S (crab x3 (wrex f2 (wceq (cv x3) (co M (cv f2) cgsu)) (cword P)) B2) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wcel Y S) $ >
  $ wi ph (wcel (co X Y c_x) S) $;

--| Lemma for ~ 1arithufd . If a product ` ( Y .x. X ) ` can be written as a product of primes, with ` X ` non-unit, nonzero, so can ` X ` . (Contributed by Thierry Arnoux, 3-Jun-2025.)
theorem _1arithufdlem3 {x3 f2: setvar} (ph: wff) (B2 P R S c_x U M X Y c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq P (cfv R crpm) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wi ph (wcel R cufd) $ >
  $ wi ph (wn (wcel R cdr)) $ >
  $ wceq S (crab x3 (wrex f2 (wceq (cv x3) (co M (cv f2) cgsu)) (cword P)) B2) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wn (wcel X U)) $ >
  $ wi ph (wne X c_0) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel (co Y X c_x) S) $ >
  $ wi ph (wcel X S) $;

--| Lemma for ~ 1arithufd . Nonzero ring, non-field case. Those trivial cases are handled in the final proof. (Contributed by Thierry Arnoux, 3-Jun-2025.)
theorem _1arithufdlem4 {x3 f2: setvar} (ph: wff) (B2 P R S U M X c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq P (cfv R crpm) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wi ph (wcel R cufd) $ >
  $ wi ph (wn (wcel R cdr)) $ >
  $ wceq S (crab x3 (wrex f2 (wceq (cv x3) (co M (cv f2) cgsu)) (cword P)) B2) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wn (wcel X U)) $ >
  $ wi ph (wne X c_0) $ >
  $ wi ph (wcel X S) $;

--| Existence of a factorization into irreducible elements in a unique factorization domain. Any nonzero, non-unit element ` X ` of a UFD ` R ` can be written as a product of primes ` f ` . As shown in ~ 1arithidom , that factorization is unique, up to the order of the factors and multiplication by units. (Contributed by Thierry Arnoux, 3-Jun-2025.)
theorem _1arithufd {f2: setvar} (ph: wff) (B2 P R U M X c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq P (cfv R crpm) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wi ph (wcel R cufd) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wn (wcel X U)) $ >
  $ wi ph (wne X c_0) $ >
  $ wi ph (wrex f2 (wceq X (co M (cv f2) cgsu)) (cword P)) $;

--| Lemma for ~ dfufd2 . (Contributed by Thierry Arnoux, 6-Jun-2025.)
theorem dfufd2lem (ph: wff) (B2 P R U F I M c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq P (cfv R crpm) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wi ph (wcel R cidom) $ >
  $ wi ph (wcel I (cfv R cprmidl)) $ >
  $ wi ph (wcel F (cword P)) $ >
  $ wi ph (wcel (co M F cgsu) I) $ >
  $ wi ph (wne (co M F cgsu) c_0) $ >
  $ wi ph (wne (cin I P) c0) $;

--| Alternative definition of unique factorization domain (UFD). This is often the textbook definition. Chapter VII, Paragraph 3, Section 3, Proposition 2 of [BourbakiCAlg2], p. 228. (Contributed by Thierry Arnoux, 6-Jun-2025.)
theorem dfufd2 {x3 f2: setvar} (B2 P R U M c_0: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq U (cfv R cui) $ >
  $ wceq P (cfv R crpm) $ >
  $ wceq M (cfv R cmgp) $ >
  $ wb (wcel R cufd) (wa (wcel R cidom) (wral x3 (wrex f2 (wceq (cv x3) (co M (cv f2) cgsu)) (cword P)) (cdif (cdif B2 U) (csn c_0)))) $;

--| The ring of integers is an integral domain. (Contributed by Thierry Arnoux, 4-May-2025.)
theorem zringidom:
  $ wcel czring cidom $;

--| The ring of integers is a principal ideal domain. (Contributed by Thierry Arnoux, 18-May-2025.)
theorem zringpid:
  $ wcel czring cpid $;

--| The (positive) prime elements of the integer ring are the prime numbers. (Contributed by Thierry Arnoux, 18-May-2025.)
theorem dfprm3:
  $ wceq cprime (cin cn (cfv czring crpm)) $;

--| The field of fractions of the ring of integers is isomorphic to the field of the rational numbers. (Contributed by Thierry Arnoux, 4-May-2025.)
theorem zringfrac {q: setvar} (Q c_sm F: class):
  $ wceq Q (co ccnfld cq cress) $ >
  $ wceq c_sm (co czring (cdif cz (csn cc0)) cerl) $ >
  $ wceq F (cmpt q cq (cec (cop (cfv (cv q) cnumer) (cfv (cv q) cdenom)) c_sm)) $ >
  $ wcel F (co Q (cfv czring cfrac) crs) $;

--| Left-associative property of an associative algebra, deduction version. (Contributed by Thierry Arnoux, 15-Feb-2026.)
theorem assaassd (ph: wff) (A2 B2 c_x c_xp F V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_xp (cfv W cmulr) $ >
  $ wi ph (wcel W casa) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wceq (co (co A2 X c_x) Y c_xp) (co A2 (co X Y c_xp) c_x)) $;

--| Right-associative property of an associative algebra, deduction version. (Contributed by Thierry Arnoux, 15-Feb-2026.)
theorem assaassrd (ph: wff) (A2 B2 c_x c_xp F V W X Y: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq F (cfv W csca) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wceq c_x (cfv W cvsca) $ >
  $ wceq c_xp (cfv W cmulr) $ >
  $ wi ph (wcel W casa) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wceq (co X (co A2 Y c_x) c_xp) (co A2 (co X Y c_xp) c_x)) $;

--| There are no monic polynomials over a zero ring. (Contributed by Thierry Arnoux, 5-Feb-2025.)
theorem _0ringmon1p (ph: wff) (B2 R M: class):
  $ wceq M (cfv R cmn1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wceq (cfv B2 chash) c1) $ >
  $ wi ph (wceq M c0) $;

--| Conditions for a function to be a univariate polynomial. (Contributed by Thierry Arnoux, 19-Aug-2023.)
theorem fply1 (ph: wff) (B2 P R F c_0: class):
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq P (cfv (cfv R cpl1) cbs) $ >
  $ wi ph (wf (co cn0 c1o cmap) B2 F) $ >
  $ wi ph (wbr F c_0 cfsupp) $ >
  $ wi ph (wcel F P) $;

--| In a division ring, the univariate polynomials form a vector space. (Contributed by Thierry Arnoux, 19-Feb-2025.)
theorem ply1lvec (ph: wff) (P R: class):
  $ wceq P (cfv R cpl1) $ >
  $ wi ph (wcel R cdr) $ >
  $ wi ph (wcel P clvec) $;

--| Functionality of the subring polynomial evaluation. (Contributed by Thierry Arnoux, 9-Feb-2025.)
theorem evls1fn (ph: wff) (P R S U O: class):
  $ wceq O (co R S ces1) $ >
  $ wceq P (cfv (co R S cress) cpl1) $ >
  $ wceq U (cfv P cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S (cfv R csubrg)) $ >
  $ wi ph (wfn O U) $;

--| The domain of the subring polynomial evaluation function. (Contributed by Thierry Arnoux, 9-Feb-2025.)
theorem evls1dm (ph: wff) (P R S U O: class):
  $ wceq O (co R S ces1) $ >
  $ wceq P (cfv (co R S cress) cpl1) $ >
  $ wceq U (cfv P cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S (cfv R csubrg)) $ >
  $ wi ph (wceq (cdm O) U) $;

--| The subring evaluation function for a univariate polynomial as a function, with domain and codomain. (Contributed by Thierry Arnoux, 22-Mar-2025.)
theorem evls1fvf (ph: wff) (B2 P Q R S U O: class):
  $ wceq O (co R S ces1) $ >
  $ wceq P (cfv (co R S cress) cpl1) $ >
  $ wceq U (cfv P cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S (cfv R csubrg)) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel Q U) $ >
  $ wi ph (wf B2 B2 (cfv Q O)) $;

--| The univariate polynomial evaluation function as a function, with domain and codomain. (Contributed by Thierry Arnoux, 8-Jun-2025.)
theorem evl1fvf (ph: wff) (B2 P Q R U O: class):
  $ wceq O (cfv R ce1) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq U (cfv P cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel Q U) $ >
  $ wi ph (wf B2 B2 (cfv Q O)) $;

--| Evaluation of a univariate polynomial as a function in a power series. (Contributed by Thierry Arnoux, 23-Jan-2025.)
theorem evl1fpws {x3 k: setvar} (ph: wff) (A2 B2 R c_x U: class) (c_ex: class x3 k) (M: class x3) (O: class x3 k) (W: class):
  $ wceq O (cfv R ce1) $ >
  $ wceq W (cfv R cpl1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq U (cfv W cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel M U) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_ex (cfv (cfv R cmgp) cmg) $ >
  $ wceq A2 (cfv M cco1) $ >
  $ wi ph (wceq (cfv M O) (cmpt x3 B2 (co R (cmpt k cn0 (co (cfv (cv k) A2) (co (cv k) (cv x3) c_ex) c_x)) cgsu))) $;

--| Subring evaluation of a univariate polynomial is the same as the subring evaluation in the bigger ring. (Contributed by Thierry Arnoux, 14-Nov-2025.)
theorem ressply1evls1 (ph: wff) (B2 P Q R S E F G K O: class):
  $ wceq G (co E R cress) $ >
  $ wceq O (co E S ces1) $ >
  $ wceq Q (co G S ces1) $ >
  $ wceq P (cfv K cpl1) $ >
  $ wceq K (co E S cress) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wi ph (wcel E ccrg) $ >
  $ wi ph (wcel R (cfv E csubrg)) $ >
  $ wi ph (wcel S (cfv G csubrg)) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wceq (cfv F Q) (cres (cfv F O) R)) $;

--| The degree of a univariate polynomial in a structure restriction. (Contributed by Thierry Arnoux, 20-Jan-2025.)
theorem ressdeg1 (ph: wff) (B2 D P R T U H: class):
  $ wceq H (co R T cress) $ >
  $ wceq D (cfv R cdg1) $ >
  $ wceq U (cfv H cpl1) $ >
  $ wceq B2 (cfv U cbs) $ >
  $ wi ph (wcel P B2) $ >
  $ wi ph (wcel T (cfv R csubrg)) $ >
  $ wi ph (wceq (cfv P D) (cfv P (cfv H cdg1))) $;

--| A restricted polynomial algebra has the same group identity (zero polynomial). (Contributed by Thierry Arnoux, 20-Jan-2025.)
theorem ressply10g (ph: wff) (B2 R S T U H Z: class):
  $ wceq S (cfv R cpl1) $ >
  $ wceq H (co R T cress) $ >
  $ wceq U (cfv H cpl1) $ >
  $ wceq B2 (cfv U cbs) $ >
  $ wi ph (wcel T (cfv R csubrg)) $ >
  $ wceq Z (cfv S c0g) $ >
  $ wi ph (wceq Z (cfv U c0g)) $;

--| The monic polynomials of a restricted polynomial algebra. (Contributed by Thierry Arnoux, 21-Jan-2025.)
theorem ressply1mon1p (ph: wff) (B2 R S T U H M N: class):
  $ wceq S (cfv R cpl1) $ >
  $ wceq H (co R T cress) $ >
  $ wceq U (cfv H cpl1) $ >
  $ wceq B2 (cfv U cbs) $ >
  $ wi ph (wcel T (cfv R csubrg)) $ >
  $ wceq M (cfv R cmn1) $ >
  $ wceq N (cfv H cmn1) $ >
  $ wi ph (wceq N (cin B2 M)) $;

--| An element of a restricted polynomial algebra has the same group inverse. (Contributed by Thierry Arnoux, 30-Jan-2025.)
theorem ressply1invg (ph: wff) (B2 P R S T U H X: class):
  $ wceq S (cfv R cpl1) $ >
  $ wceq H (co R T cress) $ >
  $ wceq U (cfv H cpl1) $ >
  $ wceq B2 (cfv U cbs) $ >
  $ wi ph (wcel T (cfv R csubrg)) $ >
  $ wceq P (co S B2 cress) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (cfv X (cfv U cminusg)) (cfv X (cfv P cminusg))) $;

--| A restricted polynomial algebra has the same subtraction operation. (Contributed by Thierry Arnoux, 30-Jan-2025.)
theorem ressply1sub (ph: wff) (B2 P R S T U H X Y: class):
  $ wceq S (cfv R cpl1) $ >
  $ wceq H (co R T cress) $ >
  $ wceq U (cfv H cpl1) $ >
  $ wceq B2 (cfv U cbs) $ >
  $ wi ph (wcel T (cfv R csubrg)) $ >
  $ wceq P (co S B2 cress) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (co X Y (cfv U csg)) (co X Y (cfv P csg))) $;

--| Closure of the univariate polynomial evaluation for scalars. (Contributed by Thierry Arnoux, 22-Jun-2025.)
theorem ressasclcl (ph: wff) (A2 B2 R S U W X: class):
  $ wceq W (cfv U cpl1) $ >
  $ wceq U (co S R cress) $ >
  $ wceq A2 (cfv W cascl) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel X R) $ >
  $ wi ph (wcel (cfv X A2) B2) $;

--| Univariate polynomial evaluation of a difference of polynomials. (Contributed by Thierry Arnoux, 25-Apr-2025.)
theorem evls1subd (ph: wff) (B2 C D Q R S U K M c_mi N W: class):
  $ wceq Q (co S R ces1) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq W (cfv U cpl1) $ >
  $ wceq U (co S R cress) $ >
  $ wceq B2 (cfv W cbs) $ >
  $ wceq D (cfv W csg) $ >
  $ wceq c_mi (cfv S csg) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel M B2) $ >
  $ wi ph (wcel N B2) $ >
  $ wi ph (wcel C K) $ >
  $ wi ph (wceq (cfv C (cfv (co M N D) Q)) (co (cfv C (cfv M Q)) (cfv C (cfv N Q)) c_mi)) $;

--| A polynomial with nonpositive degree is the zero polynomial iff its constant term is zero. Biconditional version of ~ deg1scl . (Contributed by Thierry Arnoux, 22-Mar-2025.)
theorem deg1le0eq0 (ph: wff) (B2 D P R F O c_0: class):
  $ wceq D (cfv R cdg1) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq O (cfv P c0g) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wbr (cfv F D) cc0 cle) $ >
  $ wi ph (wb (wceq F O) (wceq (cfv cc0 (cfv F cco1)) c_0)) $;

--| A nonzero scalar polynomial over a field ` F ` is a unit. (Contributed by Thierry Arnoux, 22-Mar-2025.)
theorem ply1asclunit (ph: wff) (A2 B2 P F Y c_0: class):
  $ wceq P (cfv F cpl1) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wceq c_0 (cfv F c0g) $ >
  $ wi ph (wcel F cfield) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wne Y c_0) $ >
  $ wi ph (wcel (cfv Y A2) (cfv P cui)) $;

--| In a field ` F ` , a polynomial ` C ` is a unit iff it has degree 0. This corresponds to the nonzero scalars, see ~ ply1asclunit . (Contributed by Thierry Arnoux, 25-Apr-2025.)
theorem ply1unit (ph: wff) (A2 B2 C D P F c_0: class):
  $ wceq P (cfv F cpl1) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wceq B2 (cfv F cbs) $ >
  $ wceq c_0 (cfv F c0g) $ >
  $ wi ph (wcel F cfield) $ >
  $ wceq D (cfv F cdg1) $ >
  $ wi ph (wcel C (cfv P cbs)) $ >
  $ wi ph (wb (wcel C (cfv P cui)) (wceq (cfv C D) cc0)) $;

--| Evaluation of a univariate polynomial of degree 1. (Contributed by Thierry Arnoux, 8-Jun-2025.)
theorem evl1deg1 (ph: wff) (A2 B2 C D P c_pl R c_x U K M O X: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq O (cfv R ce1) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq U (cfv P cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq C (cfv M cco1) $ >
  $ wceq D (cfv R cdg1) $ >
  $ wceq A2 (cfv c1 C) $ >
  $ wceq B2 (cfv cc0 C) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel M U) $ >
  $ wi ph (wceq (cfv M D) c1) $ >
  $ wi ph (wcel X K) $ >
  $ wi ph (wceq (cfv X (cfv M O)) (co (co A2 X c_x) B2 c_pl)) $;

--| Evaluation of a univariate polynomial of degree 2. (Contributed by Thierry Arnoux, 22-Jun-2025.)
theorem evl1deg2 (ph: wff) (A2 B2 C P c_pl R c_x U E c_ex F K M O X: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq O (cfv R ce1) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq U (cfv P cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_ex (cfv (cfv R cmgp) cmg) $ >
  $ wceq F (cfv M cco1) $ >
  $ wceq E (cfv R cdg1) $ >
  $ wceq A2 (cfv c2 F) $ >
  $ wceq B2 (cfv c1 F) $ >
  $ wceq C (cfv cc0 F) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel M U) $ >
  $ wi ph (wceq (cfv M E) c2) $ >
  $ wi ph (wcel X K) $ >
  $ wi ph (wceq (cfv X (cfv M O)) (co (co A2 (co c2 X c_ex) c_x) (co (co B2 X c_x) C c_pl) c_pl)) $;

--| Evaluation of a univariate polynomial of degree 3. (Contributed by Thierry Arnoux, 14-Jun-2025.)
theorem evl1deg3 (ph: wff) (A2 B2 C D P c_pl R c_x U E c_ex F K M O X: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq O (cfv R ce1) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq U (cfv P cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_ex (cfv (cfv R cmgp) cmg) $ >
  $ wceq F (cfv M cco1) $ >
  $ wceq E (cfv R cdg1) $ >
  $ wceq A2 (cfv c3 F) $ >
  $ wceq B2 (cfv c2 F) $ >
  $ wceq C (cfv c1 F) $ >
  $ wceq D (cfv cc0 F) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel M U) $ >
  $ wi ph (wceq (cfv M E) c3) $ >
  $ wi ph (wcel X K) $ >
  $ wi ph (wceq (cfv X (cfv M O)) (co (co (co A2 (co c3 X c_ex) c_x) (co B2 (co c2 X c_ex) c_x) c_pl) (co (co C X c_x) D c_pl) c_pl)) $;

--| Subring evaluation of a scaled monomial. (Contributed by Thierry Arnoux, 10-Jan-2026.)
theorem evls1monply1 (ph: wff) (A2 Q R S c_x U c_ex c_as K c_an N W X Y: class):
  $ wceq Q (co S R ces1) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq W (cfv U cpl1) $ >
  $ wceq U (co S R cress) $ >
  $ wceq X (cfv U cv1) $ >
  $ wceq c_ex (cfv (cfv W cmgp) cmg) $ >
  $ wceq c_an (cfv (cfv S cmgp) cmg) $ >
  $ wceq c_as (cfv W cvsca) $ >
  $ wceq c_x (cfv S cmulr) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wcel A2 R) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel Y K) $ >
  $ wi ph (wceq (cfv Y (cfv (co A2 (co N X c_ex) c_as) Q)) (co A2 (co N Y c_an) c_x)) $;

--| Express the root ` - B / A ` of a polynomial ` A x. X + B ` of degree 1 over a field. (Contributed by Thierry Arnoux, 8-Jun-2025.)
theorem ply1dg1rt (ph: wff) (A2 B2 C D c_dv P R U G N O c_0 Z: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq U (cfv P cbs) $ >
  $ wceq O (cfv R ce1) $ >
  $ wceq D (cfv R cdg1) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel R cfield) $ >
  $ wi ph (wcel G U) $ >
  $ wi ph (wceq (cfv G D) c1) $ >
  $ wceq N (cfv R cminusg) $ >
  $ wceq c_dv (cfv R cdvr) $ >
  $ wceq C (cfv G cco1) $ >
  $ wceq A2 (cfv c1 C) $ >
  $ wceq B2 (cfv cc0 C) $ >
  $ wceq Z (co (cfv B2 N) A2 c_dv) $ >
  $ wi ph (wceq (cima (ccnv (cfv G O)) (csn c_0)) (csn Z)) $;

--| Polynomials of degree 1 over a field always have some roots. (Contributed by Thierry Arnoux, 8-Jun-2025.)
theorem ply1dg1rtn0 (ph: wff) (D P R U G O c_0: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq U (cfv P cbs) $ >
  $ wceq O (cfv R ce1) $ >
  $ wceq D (cfv R cdg1) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel R cfield) $ >
  $ wi ph (wcel G U) $ >
  $ wi ph (wceq (cfv G D) c1) $ >
  $ wi ph (wne (cima (ccnv (cfv G O)) (csn c_0)) c0) $;

--| The roots of a factor ` F ` are also roots of the product of polynomials ` ( F .x. G ) ` . (Contributed by Thierry Arnoux, 8-Jun-2025.)
theorem ply1mulrtss (ph: wff) (D P R c_x U F G O c_0: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq U (cfv P cbs) $ >
  $ wceq O (cfv R ce1) $ >
  $ wceq D (cfv R cdg1) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel F U) $ >
  $ wi ph (wcel G U) $ >
  $ wceq c_x (cfv P cmulr) $ >
  $ wi ph (wss (cima (ccnv (cfv F O)) (csn c_0)) (cima (ccnv (cfv (co F G c_x) O)) (csn c_0))) $;

--| Degree of a product of polynomials. (Contributed by Thierry Arnoux, 15-Feb-2026.)
theorem deg1prod {k: setvar} (ph: wff) (A2 B2 D: class) (P R: class k) (F M c_0: class):
  $ wceq D (cfv R cdg1) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq M (cfv P cmgp) $ >
  $ wceq c_0 (cfv P c0g) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wcel R cidom) $ >
  $ wi ph (wf A2 (cdif B2 (csn c_0)) F) $ >
  $ wi ph (wceq (cfv (co M F cgsu) D) (csu k A2 (cfv (cfv (cv k) F) D))) $;

--| If a cubic polynomial over a field has no roots, it is irreducible. (Proposed by Saveliy Skresanov, 5-Jun-2025.) (Contributed by Thierry Arnoux, 8-Jun-2025.)
theorem ply1dg3rt0irred (ph: wff) (B2 D P Q F O c_0: class):
  $ wceq c_0 (cfv F c0g) $ >
  $ wceq O (cfv F ce1) $ >
  $ wceq D (cfv F cdg1) $ >
  $ wceq P (cfv F cpl1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wi ph (wcel F cfield) $ >
  $ wi ph (wcel Q B2) $ >
  $ wi ph (wceq (cima (ccnv (cfv Q O)) (csn c_0)) c0) $ >
  $ wi ph (wceq (cfv Q D) c3) $ >
  $ wi ph (wcel Q (cfv P cir)) $;

--| If two monic polynomials ` I ` and ` J ` differ by a unit factor ` K ` , then they are equal. (Contributed by Thierry Arnoux, 27-Apr-2025.)
theorem m1pmeq (ph: wff) (P c_x U F I J K M: class):
  $ wceq P (cfv F cpl1) $ >
  $ wceq M (cfv F cmn1) $ >
  $ wceq U (cfv P cui) $ >
  $ wceq c_x (cfv P cmulr) $ >
  $ wi ph (wcel F cfield) $ >
  $ wi ph (wcel I M) $ >
  $ wi ph (wcel J M) $ >
  $ wi ph (wcel K U) $ >
  $ wi ph (wceq I (co K J c_x)) $ >
  $ wi ph (wceq I J) $;

--| Fermat's little theorem for polynomials. If ` P ` is prime, Then ` ( X + A ) ^ P = ( ( X ^ P ) + A ) ` modulo ` P ` . (Contributed by Thierry Arnoux, 24-Jul-2024.)
theorem ply1fermltl (ph: wff) (A2 C P c_pl E c_ex N W X Z: class):
  $ wceq Z (cfv P czn) $ >
  $ wceq W (cfv Z cpl1) $ >
  $ wceq X (cfv Z cv1) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq N (cfv W cmgp) $ >
  $ wceq c_ex (cfv N cmg) $ >
  $ wceq C (cfv W cascl) $ >
  $ wceq A2 (cfv (cfv E (cfv Z czrh)) C) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel E cz) $ >
  $ wi ph (wceq (co P (co X A2 c_pl) c_ex) (co (co P X c_ex) A2 c_pl)) $;

--| Coefficient vector of a monomial. (Contributed by Thierry Arnoux, 20-Feb-2025.)
theorem coe1mon {k: setvar} (ph: wff k) (P R c_1 c_ex N X c_0: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq c_ex (cfv (cfv P cmgp) cmg) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel N cn0) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi ph (wceq (cfv (co N X c_ex) cco1) (cmpt k cn0 (cif (wceq (cv k) N) c_1 c_0))) $;

--| Two monomials are equal iff their powers are equal. (Contributed by Thierry Arnoux, 20-Feb-2025.)
theorem ply1moneq (ph: wff) (P R c_ex M N X: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq c_ex (cfv (cfv P cmgp) cmg) $ >
  $ wi ph (wcel R cnzr) $ >
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wb (wceq (co M X c_ex) (co N X c_ex)) (wceq M N)) $;

--| Decompose a univariate polynomial ` K ` as a sum of powers, up to its degree ` D ` . (Contributed by Thierry Arnoux, 15-Feb-2026.)
theorem ply1coedeg {k: setvar} (ph: wff) (A2 B2 D P R c_x c_ex K: class) (M: class k) (X: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq c_x (cfv P cvsca) $ >
  $ wceq M (cfv P cmgp) $ >
  $ wceq c_ex (cfv M cmg) $ >
  $ wceq A2 (cfv K cco1) $ >
  $ wceq D (cfv K (cfv R cdg1)) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel K B2) $ >
  $ wi ph (wceq K (co P (cmpt k (co cc0 D cfz) (co (cfv (cv k) A2) (co (cv k) X c_ex) c_x)) cgsu)) $;

--| The coefficients of the zero univariate polynomial. (Contributed by Thierry Arnoux, 22-Jun-2025.)
theorem coe1zfv (ph: wff) (P R N c_0 Z: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq Z (cfv P c0g) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (cfv N (cfv Z cco1)) c_0) $;

--| Polynomial coefficient of the variable. (Contributed by Thierry Arnoux, 22-Jun-2025.)
theorem coe1vr1 {k: setvar} (ph: wff k) (P R c_1 X c_0: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq X (cfv R cv1) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi ph (wceq (cfv X cco1) (cmpt k cn0 (cif (wceq (cv k) c1) c_1 c_0))) $;

--| The degree of the variable polynomial is 1. (Contributed by Thierry Arnoux, 22-Jun-2025.)
theorem deg1vr (ph: wff) (D P R X: class):
  $ wceq D (cfv R cdg1) $ >
  $ wceq P (cfv R cpl1) $ >
  $ wceq X (cfv R cv1) $ >
  $ wi ph (wcel R cnzr) $ >
  $ wi ph (wceq (cfv X D) c1) $;

--| A univariate polynomial variable cannot be the zero polynomial. (Contributed by Thierry Arnoux, 14-Nov-2025.)
theorem vr1nz (ph: wff) (P R S U X Z: class):
  $ wceq X (cfv U cv1) $ >
  $ wceq Z (cfv P c0g) $ >
  $ wceq U (co S R cress) $ >
  $ wceq P (cfv U cpl1) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel S cnzr) $ >
  $ wi ph (wcel R (cfv S csubrg)) $ >
  $ wi ph (wne X Z) $;

--| Characterize elementhood in the set ` S ` of polynomials of degree less than ` N ` . (Contributed by Thierry Arnoux, 20-Feb-2025.)
theorem ply1degltel (ph: wff) (B2 D P R S F N: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq D (cfv R cdg1) $ >
  $ wceq S (cima (ccnv D) (co cmnf N cico)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wi ph (wb (wcel F S) (wa (wcel F B2) (wbr (cfv F D) (co N c1 cmin) cle))) $;

--| Characterize elementhood in the set ` S ` of polynomials of degree less than ` N ` . (Contributed by Thierry Arnoux, 2-Apr-2025.)
theorem ply1degleel (ph: wff) (B2 D P R S F N: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq D (cfv R cdg1) $ >
  $ wceq S (cima (ccnv D) (co cmnf N cico)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wi ph (wb (wcel F S) (wa (wcel F B2) (wbr (cfv F D) N clt))) $;

--| The space ` S ` of the univariate polynomials of degree less than ` N ` forms a vector subspace. (Contributed by Thierry Arnoux, 20-Feb-2025.)
theorem ply1degltlss (ph: wff) (D P R S N: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq D (cfv R cdg1) $ >
  $ wceq S (cima (ccnv D) (co cmnf N cico)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel S (cfv P clss)) $;

--| A coefficient of the polynomial represented as a sum of scaled monomials is the coefficient of the corresponding scaled monomial. (Contributed by Thierry Arnoux, 20-Feb-2025.)
theorem gsummoncoe1fzo {k: setvar} (ph: wff) (A2: class k) (B2 C P R c_ex c_as K L N: class) (X: class k) (c_0: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq c_ex (cfv (cfv P cmgp) cmg) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_as (cfv P cvsca) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wral k (wcel A2 K) (co cc0 N cfzo)) $ >
  $ wi ph (wcel L (co cc0 N cfzo)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi (wceq (cv k) L) (wceq A2 C) $ >
  $ wi ph (wceq (cfv L (cfv (co P (cmpt k (co cc0 N cfzo) (co A2 (co (cv k) X c_ex) c_as)) cgsu) cco1)) C) $;

--| A coefficient of the polynomial represented as a sum of scaled monomials is the coefficient of the corresponding scaled monomial. See ~ gsummoncoe1fzo . (Contributed by Thierry Arnoux, 15-Feb-2026.)
theorem gsummoncoe1fz {k: setvar} (ph: wff) (A2: class k) (B2 C D P R c_ex c_as K L: class) (X: class k):
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq c_ex (cfv (cfv P cmgp) cmg) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq K (cfv R cbs) $ >
  $ wceq c_as (cfv P cvsca) $ >
  $ wi ph (wcel D cn0) $ >
  $ wi ph (wral k (wcel A2 K) (co cc0 D cfz)) $ >
  $ wi ph (wcel L (co cc0 D cfz)) $ >
  $ wi (wceq (cv k) L) (wceq A2 C) $ >
  $ wi ph (wceq (cfv L (cfv (co P (cmpt k (co cc0 D cfz) (co A2 (co (cv k) X c_ex) c_as)) cgsu) cco1)) C) $;

--| If a polynomial given as a sum of scaled monomials by factors ` A ` is the zero polynomial, then all factors ` A ` are zero. (Contributed by Thierry Arnoux, 20-Feb-2025.)
theorem ply1gsumz {n: setvar} (ph: wff) (A2 B2: class n) (P R: class) (F: class n) (N: class) (c_0 Z: class n):
  $ wceq P (cfv R cpl1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq F (cmpt n (co cc0 N cfzo) (co (cv n) (cfv R cv1) (cfv (cfv P cmgp) cmg))) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq Z (cfv P c0g) $ >
  $ wi ph (wf (co cc0 N cfzo) B2 A2) $ >
  $ wi ph (wceq (co P (co A2 F (cof (cfv P cvsca))) cgsu) Z) $ >
  $ wi ph (wceq A2 (cxp (co cc0 N cfzo) (csn c_0))) $;

--| If both factors have degree bounded by ` L ` , then the sum of the polynomials also has degree bounded by ` L ` . See also ~ deg1addle . (Contributed by Thierry Arnoux, 2-Apr-2025.)
theorem deg1addlt (ph: wff) (B2 D c_pl R F G L Y: class):
  $ wceq Y (cfv R cpl1) $ >
  $ wceq D (cfv R cdg1) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq B2 (cfv Y cbs) $ >
  $ wceq c_pl (cfv Y cplusg) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel G B2) $ >
  $ wi ph (wcel L cxr) $ >
  $ wi ph (wbr (cfv F D) L clt) $ >
  $ wi ph (wbr (cfv G D) L clt) $ >
  $ wi ph (wbr (cfv (co F G c_pl) D) L clt) $;

--| The polynomial ideal generator is not a unit polynomial. (Contributed by Thierry Arnoux, 19-Mar-2025.)
theorem ig1pnunit (ph: wff) (P R U G I: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq G (cfv R cig1p) $ >
  $ wceq U (cfv P cbs) $ >
  $ wi ph (wcel R cdr) $ >
  $ wi ph (wcel I (cfv P clidl)) $ >
  $ wi ph (wne I U) $ >
  $ wi ph (wn (wcel (cfv I G) (cfv P cui))) $;

--| The polynomial ideal generator is of minimum degree. (Contributed by Thierry Arnoux, 19-Mar-2025.)
theorem ig1pmindeg (ph: wff) (D P R U F G I c_0: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq G (cfv R cig1p) $ >
  $ wceq U (cfv P cbs) $ >
  $ wi ph (wcel R cdr) $ >
  $ wi ph (wcel I (cfv P clidl)) $ >
  $ wceq D (cfv R cdg1) $ >
  $ wceq c_0 (cfv P c0g) $ >
  $ wi ph (wcel F I) $ >
  $ wi ph (wne F c_0) $ >
  $ wi ph (wbr (cfv (cfv I G) D) (cfv F D) cle) $;

--| Distribution of univariate polynomial quotient over addition. (Contributed by Thierry Arnoux, 2-Apr-2025.)
theorem q1pdir (ph: wff) (A2 B2 C c_dv P c_pl R U N: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq U (cfv P cbs) $ >
  $ wceq N (cfv R cuc1p) $ >
  $ wceq c_dv (cfv R cq1p) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel A2 U) $ >
  $ wi ph (wcel C N) $ >
  $ wi ph (wcel B2 U) $ >
  $ wceq c_pl (cfv P cplusg) $ >
  $ wi ph (wceq (co (co A2 B2 c_pl) C c_dv) (co (co A2 C c_dv) (co B2 C c_dv) c_pl)) $;

--| Scalar multiplication property of the polynomial division. (Contributed by Thierry Arnoux, 2-Apr-2025.)
theorem q1pvsca (ph: wff) (A2 B2 C c_dv P R c_xp U K N: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq U (cfv P cbs) $ >
  $ wceq N (cfv R cuc1p) $ >
  $ wceq c_dv (cfv R cq1p) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel A2 U) $ >
  $ wi ph (wcel C N) $ >
  $ wceq c_xp (cfv P cvsca) $ >
  $ wceq K (cfv R cbs) $ >
  $ wi ph (wcel B2 K) $ >
  $ wi ph (wceq (co (co B2 A2 c_xp) C c_dv) (co B2 (co A2 C c_dv) c_xp)) $;

--| Scalar multiplication property of the polynomial remainder operation. (Contributed by Thierry Arnoux, 2-Apr-2025.)
theorem r1pvsca (ph: wff) (A2 B2 D P R c_xp U E K N: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq U (cfv P cbs) $ >
  $ wceq N (cfv R cuc1p) $ >
  $ wceq E (cfv R cr1p) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel A2 U) $ >
  $ wi ph (wcel D N) $ >
  $ wceq c_xp (cfv P cvsca) $ >
  $ wceq K (cfv R cbs) $ >
  $ wi ph (wcel B2 K) $ >
  $ wi ph (wceq (co (co B2 A2 c_xp) D E) (co B2 (co A2 D E) c_xp)) $;

--| Polynomial remainder operation of a division of the zero polynomial. (Contributed by Thierry Arnoux, 2-Apr-2025.)
theorem r1p0 (ph: wff) (D P R U E N c_0: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq U (cfv P cbs) $ >
  $ wceq N (cfv R cuc1p) $ >
  $ wceq E (cfv R cr1p) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel D N) $ >
  $ wceq c_0 (cfv P c0g) $ >
  $ wi ph (wceq (co c_0 D E) c_0) $;

--| The polynomial remainder operation is periodic. See ~ modcyc . (Contributed by Thierry Arnoux, 2-Apr-2025.)
theorem r1pcyc (ph: wff) (A2 B2 C P c_pl R c_x U E N: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq U (cfv P cbs) $ >
  $ wceq N (cfv R cuc1p) $ >
  $ wceq E (cfv R cr1p) $ >
  $ wceq c_pl (cfv P cplusg) $ >
  $ wceq c_x (cfv P cmulr) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel A2 U) $ >
  $ wi ph (wcel B2 N) $ >
  $ wi ph (wcel C U) $ >
  $ wi ph (wceq (co (co A2 (co C B2 c_x) c_pl) B2 E) (co A2 B2 E)) $;

--| Addition property of the polynomial remainder operation, similar to ~ modadd1 . (Contributed by Thierry Arnoux, 2-Apr-2025.)
theorem r1padd1 (ph: wff) (A2 B2 C D P c_pl R U E N: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq U (cfv P cbs) $ >
  $ wceq N (cfv R cuc1p) $ >
  $ wceq E (cfv R cr1p) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel A2 U) $ >
  $ wi ph (wcel D N) $ >
  $ wi ph (wceq (co A2 D E) (co B2 D E)) $ >
  $ wceq c_pl (cfv P cplusg) $ >
  $ wi ph (wcel B2 U) $ >
  $ wi ph (wcel C U) $ >
  $ wi ph (wceq (co (co A2 C c_pl) D E) (co (co B2 C c_pl) D E)) $;

--| The univariate polynomial remainder function ` F ` is a module homomorphism. Its image ` ( F "s P ) ` is sometimes called the "ring of remainders". (Contributed by Thierry Arnoux, 2-Apr-2025.)
theorem r1plmhm {f2: setvar} (ph: wff) (P: class) (R: class f2) (U E: class) (F: class f2) (M: class) (N: class f2):
  $ wceq P (cfv R cpl1) $ >
  $ wceq U (cfv P cbs) $ >
  $ wceq E (cfv R cr1p) $ >
  $ wceq N (cfv R cuc1p) $ >
  $ wceq F (cmpt f2 U (co (cv f2) M E)) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel M N) $ >
  $ wi ph (wcel F (co P (co F P cimas) clmhm)) $;

--| The univariate polynomial remainder ring ` ( F "s P ) ` is module isomorphic with the quotient ring. (Contributed by Thierry Arnoux, 2-Apr-2025.)
theorem r1pquslmic {f2: setvar} (ph: wff) (P Q: class) (R: class f2) (U E F: class) (K: class f2) (M: class) (N: class f2) (c_0: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq U (cfv P cbs) $ >
  $ wceq E (cfv R cr1p) $ >
  $ wceq N (cfv R cuc1p) $ >
  $ wceq F (cmpt f2 U (co (cv f2) M E)) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel M N) $ >
  $ wceq c_0 (cfv P c0g) $ >
  $ wceq K (cima (ccnv F) (csn c_0)) $ >
  $ wceq Q (co P (co P K cqg) cqus) $ >
  $ wi ph (wbr Q (co F P cimas) clmic) $;

--| Rewrite a finite support for nonnegative integers : For functions mapping a set ` I ` to the nonnegative integers, having finite support can also be written as having a finite preimage of the positive integers. The latter expression is used for example in ~ psrbas , but with the former expression, theorems about finite support can be used more directly. (Contributed by Thierry Arnoux, 10-Jan-2026.)
theorem psrbasfsupp {f2: setvar} (D I: class f2):
  $ wceq D (crab f2 (wbr (cv f2) cc0 cfsupp) (co cn0 I cmap)) $ >
  $ wceq D (crab f2 (wcel (cima (ccnv (cv f2)) cn) cfn) (co cn0 I cmap)) $;

--| The ring of power series over a nonzero ring form a nonzero ring. (Contributed by Thierry Arnoux, 4-May-2026.)
theorem psrnzr (ph: wff) (R S I V: class):
  $ wceq S (co I R cmps) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R cnzr) $ >
  $ wi ph (wcel S cnzr) $;

--| The multivariate polynomials over a nonzero ring form a nonzero ring. (Contributed by Thierry Arnoux, 4-May-2026.)
theorem mplnzr (ph: wff) (P R I V: class):
  $ wceq P (co I R cmpl) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R cnzr) $ >
  $ wi ph (wcel P cnzr) $;

--| Build a ring isomorphism between multivariate polynomials with no variables and the underlying ring. (Contributed by Thierry Arnoux, 4-May-2026.)
theorem _0mplrim {p: setvar} (ph: wff) (B2 P R F: class):
  $ wceq B2 (cfv P cbs) $ >
  $ wceq P (co c0 R cmpl) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq F (cmpt p B2 (cfv c0 (cv p))) $ >
  $ wi ph (wcel F (co P R crs)) $;

--| Multivariate polynomials with no variables are isomorphic with the underlying ring. (Contributed by Thierry Arnoux, 4-May-2026.)
theorem _0mplric (ph: wff) (B2 P R: class):
  $ wceq B2 (cfv P cbs) $ >
  $ wceq P (co c0 R cmpl) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wbr P R cric) $;

--| Case where composing an algebra scalar lifting functions with a scalar leads to a scalar. This is useful when working with ` selectVars ` . (Contributed by Thierry Arnoux, 4-May-2026.)
theorem mplasclco {h j: setvar} (ph: wff h j) (A2 B2 C D P Q: class h j) (R: class) (S E: class h j) (I: class j) (J: class h) (O: class j) (V X: class h j):
  $ wceq S (cfv R cbs) $ >
  $ wceq O (co J R cmpl) $ >
  $ wceq P (co I R cmpl) $ >
  $ wceq Q (co I O cmpl) $ >
  $ wceq A2 (cfv O cascl) $ >
  $ wceq B2 (cfv P cascl) $ >
  $ wceq C (cfv Q cascl) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq E (crab j (wcel (cima (ccnv (cv j)) cn) cfn) (co cn0 J cmap)) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wss J I) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wceq (ccom A2 (cfv X B2)) (cfv (cfv X A2) C)) $;

--| Case where composing an algebra scalar lifting functions with a scalar leads to a scalar. This is useful when working with ` selectVars ` . (Contributed by Thierry Arnoux, 4-May-2026.)
theorem mplasclco_b1 {h: setvar} (ph: wff h) (A2 B2 C D P Q: class h) (R: class) (S E: class h) (I J O: class) (V X: class h):
  $ wceq S (cfv R cbs) $ >
  $ wceq O (co J R cmpl) $ >
  $ wceq P (co I R cmpl) $ >
  $ wceq Q (co I O cmpl) $ >
  $ wceq A2 (cfv O cascl) $ >
  $ wceq B2 (cfv P cascl) $ >
  $ wceq C (cfv Q cascl) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq E (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 J cmap)) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wss J I) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wceq (ccom A2 (cfv X B2)) (cfv (cfv X A2) C)) $;

--| The "variable selection" function evaluated at a scalar. (Contributed by Thierry Arnoux, 4-May-2026.)
theorem selvascl (ph: wff) (A2 B2 C D P R T U I J V X: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq P (co I R cmpl) $ >
  $ wceq A2 (cfv P cascl) $ >
  $ wceq C (cfv T cascl) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel X B2) $ >
  $ wceq U (co (cdif I J) R cmpl) $ >
  $ wceq T (co J U cmpl) $ >
  $ wceq D (ccom C (cfv U cascl)) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wss J I) $ >
  $ wi ph (wceq (cfv (cfv X A2) (cfv J (co I R cslv))) (cfv X D)) $;

--| Lemma for ~ selvply1rhm . (Contributed by Thierry Arnoux, 4-May-2026.)
theorem selvply1rhmlema {f2 n: setvar} (ph: wff) (B2: class n) (P Q: class f2 n) (R: class f2) (c_x: class n) (c_xp: class f2 n) (F: class) (M V: class f2 n) (X: class):
  $ wceq B2 (cfv P cbs) $ >
  $ wceq P (co (csn X) R cmpl) $ >
  $ wceq c_x (cfv P cmulr) $ >
  $ wceq c_xp (cfv Q cmulr) $ >
  $ wceq Q (cfv R cpl1) $ >
  $ wceq M (cmpt f2 B2 (cmpt n (co cn0 c1o cmap) (cfv (csn (cop X (cfv c0 (cv n)))) (cv f2)))) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel (cfv F M) (cfv Q cbs)) $;

--| Lemma for ~ selvply1rhm . (Contributed by Thierry Arnoux, 4-May-2026.)
theorem selvply1rhmlemb {f2 n: setvar} (ph: wff) (B2: class n) (P Q: class f2 n) (R: class f2) (c_x: class) (c_xp: class n) (F G M: class) (V: class f2 n) (X: class):
  $ wceq B2 (cfv P cbs) $ >
  $ wceq P (co (csn X) R cmpl) $ >
  $ wceq c_x (cfv P cmulr) $ >
  $ wceq c_xp (cfv Q cmulr) $ >
  $ wceq Q (cfv R cpl1) $ >
  $ wceq M (cmpt f2 B2 (cmpt n (co cn0 c1o cmap) (cfv (csn (cop X (cfv c0 (cv n)))) (cv f2)))) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel G B2) $ >
  $ wi ph (wceq (cfv (co F G c_x) M) (co (cfv F M) (cfv G M) c_xp)) $;

--| Lemma for ~ selvply1rhm . (Contributed by Thierry Arnoux, 4-May-2026.)
theorem selvply1rhmlem1 {f2 n: setvar} (ph: wff) (B2: class) (P: class f2 n) (Q: class n) (R U: class f2) (H: class f2 n) (I: class f2) (V: class f2 n) (X: class f2):
  $ wceq B2 (cfv P cbs) $ >
  $ wceq P (co I R cmpl) $ >
  $ wceq U (co (cdif I (csn X)) R cmpl) $ >
  $ wceq Q (cfv U cpl1) $ >
  $ wceq H (cmpt f2 B2 (cmpt n (co cn0 c1o cmap) (cfv (csn (cop X (cfv c0 (cv n)))) (cfv (cv f2) (cfv (csn X) (co I R cslv)))))) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wf B2 (cfv Q cbs) H) $;

--| Lemma for ~ selvply1rhm : Image of the ring unit by the mapping ` H ` (Contributed by Thierry Arnoux, 4-May-2026.)
theorem selvply1rhmlem2 {f2 n: setvar} (ph: wff) (B2 P: class) (Q: class n) (R: class) (U: class f2) (H: class f2 n) (I: class) (V: class f2 n) (X: class):
  $ wceq B2 (cfv P cbs) $ >
  $ wceq P (co I R cmpl) $ >
  $ wceq U (co (cdif I (csn X)) R cmpl) $ >
  $ wceq Q (cfv U cpl1) $ >
  $ wceq H (cmpt f2 B2 (cmpt n (co cn0 c1o cmap) (cfv (csn (cop X (cfv c0 (cv n)))) (cfv (cv f2) (cfv (csn X) (co I R cslv)))))) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wceq (cfv (cfv P cur) H) (cfv Q cur)) $;

--| Lemma for ~ selvply1rhm . (Contributed by Thierry Arnoux, 4-May-2026.)
theorem selvply1rhmlem3 {f2 n: setvar} (ph: wff n) (B2: class n) (P Q: class f2 n) (R: class) (U: class f2 n) (F: class) (H: class f2 n) (I: class) (N V: class f2 n) (X: class):
  $ wceq B2 (cfv P cbs) $ >
  $ wceq P (co I R cmpl) $ >
  $ wceq U (co (cdif I (csn X)) R cmpl) $ >
  $ wceq Q (cfv U cpl1) $ >
  $ wceq H (cmpt f2 B2 (cmpt n (co cn0 c1o cmap) (cfv (csn (cop X (cfv c0 (cv n)))) (cfv (cv f2) (cfv (csn X) (co I R cslv)))))) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel N (co cn0 c1o cmap)) $ >
  $ wi ph (wceq (cfv N (cfv F H)) (cfv (csn (cop X (cfv c0 N))) (cfv F (cfv (csn X) (co I R cslv))))) $;

--| Lemma for ~ selvply1rhm : The mapping ` H ` is linear. (Contributed by Thierry Arnoux, 4-May-2026.)
theorem selvply1rhmlem4 {f2 n: setvar} (ph: wff) (B2 P Q R U F G: class) (H: class f2) (I: class) (V: class f2 n) (X: class):
  $ wceq B2 (cfv P cbs) $ >
  $ wceq P (co I R cmpl) $ >
  $ wceq U (co (cdif I (csn X)) R cmpl) $ >
  $ wceq Q (cfv U cpl1) $ >
  $ wceq H (cmpt f2 B2 (cmpt n (co cn0 c1o cmap) (cfv (csn (cop X (cfv c0 (cv n)))) (cfv (cv f2) (cfv (csn X) (co I R cslv)))))) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel G B2) $ >
  $ wi ph (wceq (cfv (co F G (cfv P cplusg)) H) (co (cfv F H) (cfv G H) (cfv Q cplusg))) $;

--| Lemma for ~ selvply1rhm . (Contributed by Thierry Arnoux, 4-May-2026.)
theorem selvply1rhmlem5 {f2 n s1 q: setvar} (ph: wff s1) (B2: class n s1 q) (P Q: class f2 n s1 q) (R: class s1) (U: class n s1) (F: class s1) (H: class f2 n s1 q) (I: class s1) (M V: class f2 n s1 q) (X: class):
  $ wceq B2 (cfv P cbs) $ >
  $ wceq P (co I R cmpl) $ >
  $ wceq U (co (cdif I (csn X)) R cmpl) $ >
  $ wceq Q (cfv U cpl1) $ >
  $ wceq H (cmpt f2 B2 (cmpt n (co cn0 c1o cmap) (cfv (csn (cop X (cfv c0 (cv n)))) (cfv (cv f2) (cfv (csn X) (co I R cslv)))))) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel F B2) $ >
  $ wceq M (cmpt q (cfv (co (csn X) U cmpl) cbs) (cmpt s1 (co cn0 c1o cmap) (cfv (csn (cop X (cfv c0 (cv s1)))) (cv q)))) $ >
  $ wi ph (wceq (cfv F H) (cfv (cfv F (cfv (csn X) (co I R cslv))) M)) $;

--| Build a ring homomorphism ` H ` between the multivariate polynomials ` P ` with variables in ` I ` and the univariate polynomials ` Q ` in a single variable ` X ` element of ` I ` . (Contributed by Thierry Arnoux, 4-May-2026.)
theorem selvply1rhm {f2 n: setvar} (ph: wff) (B2 P Q R U: class) (H: class f2) (I: class) (V: class f2 n) (X: class):
  $ wceq B2 (cfv P cbs) $ >
  $ wceq P (co I R cmpl) $ >
  $ wceq U (co (cdif I (csn X)) R cmpl) $ >
  $ wceq Q (cfv U cpl1) $ >
  $ wceq H (cmpt f2 B2 (cmpt n (co cn0 c1o cmap) (cfv (csn (cop X (cfv c0 (cv n)))) (cfv (cv f2) (cfv (csn X) (co I R cslv)))))) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel H (co P Q crh)) $;

--| The ring homomorphism ` H ` built in ~ selvply1rhm is injective. (Contributed by Thierry Arnoux, 4-May-2026.)
theorem selvply1rhm0 {f2 n: setvar} (ph: wff) (B2 P Q R U F: class) (H: class f2) (I: class) (V: class f2 n) (X: class) (c_0 Z: class f2 n):
  $ wceq B2 (cfv P cbs) $ >
  $ wceq P (co I R cmpl) $ >
  $ wceq U (co (cdif I (csn X)) R cmpl) $ >
  $ wceq Q (cfv U cpl1) $ >
  $ wceq H (cmpt f2 B2 (cmpt n (co cn0 c1o cmap) (cfv (csn (cop X (cfv c0 (cv n)))) (cfv (cv f2) (cfv (csn X) (co I R cslv)))))) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wceq c_0 (cfv Q c0g) $ >
  $ wceq Z (cfv P c0g) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wceq (cfv F H) c_0) $ >
  $ wi ph (wceq F Z) $;

--| Lemma for ~ mplidom . (Contributed by Thierry Arnoux, 4-May-2026.)
theorem mplidomlem {x3 f2 j n: setvar} (ph: wff) (C: class x3 j) (P: class) (Q: class x3 j) (R: class) (S U H: class x3 j) (I: class):
  $ wceq P (co I R cmpl) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wcel R cidom) $ >
  $ wceq H (cmpt f2 C (cmpt n (co cn0 c1o cmap) (cfv (csn (cop (cv x3) (cfv c0 (cv n)))) (cfv (cv f2) (cfv (csn (cv x3)) (co (cun (cv j) (csn (cv x3))) R cslv)))))) $ >
  $ wceq C (cfv S cbs) $ >
  $ wceq S (co (cun (cv j) (csn (cv x3))) R cmpl) $ >
  $ wceq U (co (cdif (cun (cv j) (csn (cv x3))) (csn (cv x3))) R cmpl) $ >
  $ wceq Q (cfv U cpl1) $ >
  $ wi ph (wcel P cidom) $;

--| The multivariate polynomials over an integral domain form an integral domain. See ~ ply1idom . (Contributed by Thierry Arnoux, 4-May-2026.)
theorem mplidom (ph: wff) (P R I: class):
  $ wceq P (co I R cmpl) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wcel R cidom) $ >
  $ wi ph (wcel P cidom) $;

--| Extend class notation with the "variable extension" function.
term cextv: class;

--| Define the "variable extension" function. The function ` ( ( I extendVars R ) `` A ) ` converts polynomials with variables indexed by ` ( I \ { A } ) ` into polynomials indexed by ` I ` , and therefore maps elements of ` ( ( I \ { A } ) mPoly R ) ` onto ` ( I mPoly R ) ` . (Contributed by Thierry Arnoux, 20-Jan-2026.)
axiom df_extv {x3 f2 h i r a: setvar}:
  $ wceq cextv (cmpo i r cvv cvv (cmpt a (cv i) (cmpt f2 (cfv (co (cdif (cv i) (csn (cv a))) (cv r) cmpl) cbs) (cmpt x3 (crab h (wbr (cv h) cc0 cfsupp) (co cn0 (cv i) cmap)) (cif (wceq (cfv (cv a) (cv x3)) cc0) (cfv (cres (cv x3) (cdif (cv i) (csn (cv a)))) (cv f2)) (cfv (cv r) c0g)))))) $;

--| Value of the "variable extension" function. (Contributed by Thierry Arnoux, 25-Jan-2026.)
theorem extvval {x3 f2 h a: setvar} (ph: wff x3 f2 h a) (D: class x3 f2 h a) (R: class h) (I: class) (J M V W c_0: class x3 f2 h a):
  $ wceq D (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R W) $ >
  $ wceq J (cdif I (csn (cv a))) $ >
  $ wceq M (cfv (co J R cmpl) cbs) $ >
  $ wi ph (wceq (co I R cextv) (cmpt a I (cmpt f2 M (cmpt x3 D (cif (wceq (cfv (cv a) (cv x3)) cc0) (cfv (cres (cv x3) (cdif I (csn (cv a)))) (cv f2)) c_0))))) $;

--| The "variable extension" function evaluated for adding a variable with index ` A ` . (Contributed by Thierry Arnoux, 25-Jan-2026.)
theorem extvfval {x3 f2 h: setvar} (ph: wff x3 f2 h) (A2: class h) (D: class x3 f2 h) (R: class h) (I: class) (J: class x3 f2 h) (M: class x3 h) (V W c_0: class x3 f2 h):
  $ wceq D (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R W) $ >
  $ wi ph (wcel A2 I) $ >
  $ wceq J (cdif I (csn A2)) $ >
  $ wceq M (cfv (co J R cmpl) cbs) $ >
  $ wi ph (wceq (cfv A2 (co I R cextv)) (cmpt f2 M (cmpt x3 D (cif (wceq (cfv A2 (cv x3)) cc0) (cfv (cres (cv x3) J) (cv f2)) c_0)))) $;

--| The "variable extension" function evaluated for converting a given polynomial ` F ` by adding a variable with index ` A ` . (Contributed by Thierry Arnoux, 25-Jan-2026.)
theorem extvfv {x3 h: setvar} (ph: wff x3 h) (A2 D R F: class h) (I: class) (J M V W c_0: class x3 h):
  $ wceq D (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R W) $ >
  $ wi ph (wcel A2 I) $ >
  $ wceq J (cdif I (csn A2)) $ >
  $ wceq M (cfv (co J R cmpl) cbs) $ >
  $ wi ph (wcel F M) $ >
  $ wi ph (wceq (cfv F (cfv A2 (co I R cextv))) (cmpt x3 D (cif (wceq (cfv A2 (cv x3)) cc0) (cfv (cres (cv x3) J) F) c_0))) $;

--| The "variable extension" function evaluated for converting a given polynomial ` F ` by adding a variable with index ` A ` . (Contributed by Thierry Arnoux, 25-Jan-2026.)
theorem extvfvv {h: setvar} (ph: wff h) (A2 D R F: class h) (I: class) (J M V W X c_0: class h):
  $ wceq D (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R W) $ >
  $ wi ph (wcel A2 I) $ >
  $ wceq J (cdif I (csn A2)) $ >
  $ wceq M (cfv (co J R cmpl) cbs) $ >
  $ wi ph (wcel F M) $ >
  $ wi ph (wcel X D) $ >
  $ wi ph (wceq (cfv X (cfv F (cfv A2 (co I R cextv)))) (cif (wceq (cfv A2 X) cc0) (cfv (cres X J) F) c_0)) $;

--| Closure for the "variable extension" function evaluated for converting a given polynomial ` F ` by adding a variable with index ` A ` . (Contributed by Thierry Arnoux, 25-Jan-2026.)
theorem extvfvvcl {h: setvar} (ph: wff h) (A2: class) (B2 D R F: class h) (I J: class) (M V: class h) (X: class) (c_0: class h):
  $ wceq D (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq J (cdif I (csn A2)) $ >
  $ wceq M (cfv (co J R cmpl) cbs) $ >
  $ wi ph (wcel A2 I) $ >
  $ wi ph (wcel F M) $ >
  $ wi ph (wcel X D) $ >
  $ wi ph (wcel (cfv X (cfv F (cfv A2 (co I R cextv)))) B2) $;

--| Closure for the "variable extension" function evaluated for converting a given polynomial ` F ` by adding a variable with index ` A ` . (Contributed by Thierry Arnoux, 25-Jan-2026.)
theorem extvfvcl {h: setvar} (ph: wff h) (A2: class) (B2 D R F: class h) (I J: class) (M N V c_0: class h):
  $ wceq D (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq J (cdif I (csn A2)) $ >
  $ wceq M (cfv (co J R cmpl) cbs) $ >
  $ wi ph (wcel A2 I) $ >
  $ wi ph (wcel F M) $ >
  $ wceq N (cfv (co I R cmpl) cbs) $ >
  $ wi ph (wcel (cfv F (cfv A2 (co I R cextv))) N) $;

--| The "variable extension" function maps polynomials with variables indexed in ` J ` to polynomials with variables indexed in ` I ` . (Contributed by Thierry Arnoux, 25-Jan-2026.)
theorem extvfvalf {h: setvar} (ph: wff h) (A2: class) (B2 D R: class h) (I J: class) (M N V c_0: class h):
  $ wceq D (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq J (cdif I (csn A2)) $ >
  $ wceq M (cfv (co J R cmpl) cbs) $ >
  $ wi ph (wcel A2 I) $ >
  $ wceq N (cfv (co I R cmpl) cbs) $ >
  $ wi ph (wf M N (cfv A2 (co I R cextv))) $;

--| Value of the generating elements of the power series structure, expressed using the indicator function. (Contributed by Thierry Arnoux, 25-Jan-2026.)
theorem mvrvalind {h: setvar} (ph: wff h) (A2 D R c_1 F: class h) (I: class) (V W: class h) (X: class) (Y c_0: class h):
  $ wceq V (co I R cmvr) $ >
  $ wceq D (crab h (wcel (cima (ccnv (cv h)) cn) cfn) (co cn0 I cmap)) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R Y) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wcel F D) $ >
  $ wceq A2 (cfv (csn X) (cfv I cind)) $ >
  $ wi ph (wceq (cfv F (cfv X V)) (cif (wceq F A2) c_1 c_0)) $;

--| Multiply a polynomial ` F ` with a variable ` X ` (i.e. with a monic monomial). (Contributed by Thierry Arnoux, 25-Jan-2026.)
theorem mplmulmvr {h b: setvar} (ph: wff h) (A2: class b) (D: class h) (P: class h b) (R: class h) (c_x: class h b) (F: class h) (I: class) (M: class h) (V: class h b) (X: class h) (Y: class b) (c_0: class h b):
  $ wceq P (co I R cmpl) $ >
  $ wceq X (cfv Y (co I R cmvr)) $ >
  $ wceq M (cfv P cbs) $ >
  $ wceq c_x (cfv P cmulr) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq D (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) $ >
  $ wceq A2 (cfv (csn Y) (cfv I cind)) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel Y I) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel F M) $ >
  $ wi ph (wceq (co X F c_x) (cmpt b D (cif (wceq (cfv Y (cv b)) cc0) c_0 (cfv (co (cv b) A2 (cof cmin)) F)))) $;

--| Polynomial evaluation for scalars. See ~ evlsscaval . (Contributed by Thierry Arnoux, 15-Feb-2026.)
theorem evlscaval (ph: wff) (A2 B2 Q R I L V W X: class):
  $ wceq Q (co I R cevl) $ >
  $ wceq W (co I R cmpl) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq A2 (cfv W cascl) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wf I B2 L) $ >
  $ wi ph (wceq (cfv L (cfv (cfv X A2) Q)) X) $;

--| Polynomial evaluation builder for a variable. (Contributed by Thierry Arnoux, 15-Feb-2026.)
theorem evlvarval (ph: wff) (A2 B2 P Q S c_xb c_x I K V X Z: class):
  $ wceq Q (co I S cevl) $ >
  $ wceq P (co I S cmpl) $ >
  $ wceq K (cfv S cbs) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wceq c_xb (cfv P cmulr) $ >
  $ wceq c_x (cfv S cmulr) $ >
  $ wi ph (wcel I Z) $ >
  $ wi ph (wcel S ccrg) $ >
  $ wi ph (wcel A2 (co K I cmap)) $ >
  $ wceq V (co I S cmvr) $ >
  $ wi ph (wcel X I) $ >
  $ wi ph (wa (wcel (cfv X V) B2) (wceq (cfv A2 (cfv (cfv X V) Q)) (cfv X A2))) $;

--| Evaluating a variable-extended polynomial is the same as evaluating the polynomial in the original set of variables (in both cases, the additionial variable is ignored). (Contributed by Thierry Arnoux, 15-Feb-2026.)
theorem evlextv (ph: wff) (A2 B2 Q R E F I J M O V Y: class):
  $ wceq Q (co I R cevl) $ >
  $ wceq O (co J R cevl) $ >
  $ wceq J (cdif I (csn Y)) $ >
  $ wceq M (cfv (co J R cmpl) cbs) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq E (co I R cextv) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel Y I) $ >
  $ wi ph (wcel F M) $ >
  $ wi ph (wf I B2 A2) $ >
  $ wi ph (wceq (cfv A2 (cfv (cfv F (cfv Y E)) Q)) (cfv (cres A2 J) (cfv F O))) $;

--| Lemma for ~ mplvrpmga and others. (Contributed by Thierry Arnoux, 11-Jan-2026.)
theorem mplvrpmlem {h: setvar} (ph: wff h) (D: class) (P S: class h) (I: class) (V: class h) (X: class):
  $ wceq S (cfv I csymg) $ >
  $ wceq P (cfv S cbs) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel X (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap))) $ >
  $ wi ph (wcel (ccom X D) (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap))) $;

--| Permuting variables in a multivariate polynomial conserves finite support. (Contributed by Thierry Arnoux, 10-Jan-2026.)
theorem mplvrpmfgalem {x3 f2 h d: setvar} (ph: wff h) (A2 P: class h) (Q: class) (R: class f2 h d) (S: class x3 f2 h d) (F: class h) (I: class) (M: class h) (V c_0: class x3 f2 h d):
  $ wceq S (cfv I csymg) $ >
  $ wceq P (cfv S cbs) $ >
  $ wceq M (cfv (co I R cmpl) cbs) $ >
  $ wceq A2 (cmpo d f2 P M (cmpt x3 (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) (cfv (ccom (cv x3) (cv d)) (cv f2)))) $ >
  $ wi ph (wcel I V) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel F M) $ >
  $ wi ph (wcel Q P) $ >
  $ wi ph (wbr (co Q F A2) c_0 cfsupp) $;

--| The action of permuting variables in a multivariate polynomial is a group action. (Contributed by Thierry Arnoux, 10-Jan-2026.)
theorem mplvrpmga {x3 f2 h d: setvar} (ph: wff h) (A2 P: class h) (R: class f2 h d) (S: class x3 f2 h d) (I: class) (M: class h) (V: class x3 f2 h d):
  $ wceq S (cfv I csymg) $ >
  $ wceq P (cfv S cbs) $ >
  $ wceq M (cfv (co I R cmpl) cbs) $ >
  $ wceq A2 (cmpo d f2 P M (cmpt x3 (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) (cfv (ccom (cv x3) (cv d)) (cv f2)))) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel A2 (co S M cga)) $;

--| The action of permuting variables in a multivariate polynomial is a monoid homomorphism. (Contributed by Thierry Arnoux, 11-Jan-2026.)
theorem mplvrpmmhm {x3 f2 h d: setvar} (ph: wff h) (A2: class h) (D: class) (P: class h) (R: class f2 h d) (S: class x3 f2 h d) (F: class f2 h d) (I: class) (M: class h) (V: class x3 f2 h d) (W: class h):
  $ wceq S (cfv I csymg) $ >
  $ wceq P (cfv S cbs) $ >
  $ wceq M (cfv (co I R cmpl) cbs) $ >
  $ wceq A2 (cmpo d f2 P M (cmpt x3 (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) (cfv (ccom (cv x3) (cv d)) (cv f2)))) $ >
  $ wi ph (wcel I V) $ >
  $ wceq F (cmpt f2 M (co D (cv f2) A2)) $ >
  $ wceq W (co I R cmpl) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel F (co W W cmhm)) $;

--| The action of permuting variables in a multivariate polynomial is a ring homomorphism. (Contributed by Thierry Arnoux, 15-Jan-2026.)
theorem mplvrpmrhm {x3 f2 h d: setvar} (ph: wff h) (A2: class h) (D: class) (P: class h) (R: class) (S: class x3 f2 h d) (F: class f2 h d) (I: class) (M: class h) (V: class f2 h d) (W: class h):
  $ wceq S (cfv I csymg) $ >
  $ wceq P (cfv S cbs) $ >
  $ wceq M (cfv (co I R cmpl) cbs) $ >
  $ wceq A2 (cmpo d f2 P M (cmpt x3 (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) (cfv (ccom (cv x3) (cv d)) (cv f2)))) $ >
  $ wi ph (wcel I V) $ >
  $ wceq F (cmpt f2 M (co D (cv f2) A2)) $ >
  $ wceq W (co I R cmpl) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel F (co W W crh)) $;

--| Finite commutative sums of power series are taken componentwise. (Contributed by Thierry Arnoux, 16-Mar-2026.)
theorem psrgsum {y1 h k: setvar} (ph: wff h) (A2: class h) (B2: class y1 h) (D R: class h) (S: class y1 h) (F: class h) (I: class k) (V: class y1 h k):
  $ wceq S (co I R cmps) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel I V) $ >
  $ wceq D (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wceq (co S F cgsu) (cmpt y1 D (co R (cmpt k A2 (cfv (cv y1) (cfv (cv k) F))) cgsu))) $;

--| A monomial is a power series. (Contributed by Thierry Arnoux, 16-Mar-2026.)
theorem psrmon {y1 h: setvar} (ph: wff h) (B2: class y1 h) (D R: class h) (S: class y1 h) (c_1: class h) (I: class y1) (W: class y1 h) (X c_0: class h):
  $ wceq S (co I R cmps) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq D (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X D) $ >
  $ wi ph (wcel (cmpt y1 D (cif (wceq (cv y1) X) c_1 c_0)) B2) $;

--| The product of two power series monomials adds the exponent vectors together. For example, the product of ` ( x ^ 2 ) ( y ^ 2 ) ` with ` ( y ^ 1 ) ( z ^ 3 ) ` is ` ( x ^ 2 ) ( y ^ 3 ) ( z ^ 3 ) ` , where the exponent vectors ` <. 2 , 2 , 0 >. ` and ` <. 0 , 1 , 3 >. ` are added to give ` <. 2 , 3 , 3 >. ` . (Contributed by Thierry Arnoux, 16-Mar-2026.)
theorem psrmonmul {y1 h: setvar} (ph: wff h) (B2: class y1 h) (D R: class h) (S c_x: class y1 h) (c_1: class h) (I: class y1) (W: class y1 h) (X Y: class) (c_0: class h):
  $ wceq S (co I R cmps) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq D (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X D) $ >
  $ wceq c_x (cfv S cmulr) $ >
  $ wi ph (wcel Y D) $ >
  $ wi ph (wceq (co (cmpt y1 D (cif (wceq (cv y1) X) c_1 c_0)) (cmpt y1 D (cif (wceq (cv y1) Y) c_1 c_0)) c_x) (cmpt y1 D (cif (wceq (cv y1) (co X Y (cof caddc))) c_1 c_0))) $;

--| The product of two power series monomials adds the exponent vectors together. Here, the function ` G ` is a monomial builder, which maps a bag of variables with the monic monomial with only those variables. (Contributed by Thierry Arnoux, 16-Mar-2026.)
theorem psrmonmul2 {y1 z h: setvar} (ph: wff h) (B2: class y1 z h) (D R: class h) (S c_x: class y1 z h) (c_1: class h) (G: class y1 z h) (I: class y1) (W: class y1 z h) (X Y: class) (c_0: class h):
  $ wceq S (co I R cmps) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq D (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) $ >
  $ wi ph (wcel I W) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel X D) $ >
  $ wceq c_x (cfv S cmulr) $ >
  $ wi ph (wcel Y D) $ >
  $ wceq G (cmpt y1 D (cmpt z D (cif (wceq (cv z) (cv y1)) c_1 c_0))) $ >
  $ wi ph (wceq (co (cfv X G) (cfv Y G) c_x) (cfv (co X Y (cof caddc)) G)) $;

--| Finite product of bags of variables in a power series. Here the function ` G ` maps a bag of variables to the corresponding monomial. (Contributed by Thierry Arnoux, 16-Mar-2026.)
theorem psrmonprod {x3 y1 z h i: setvar} (ph: wff h) (A2: class h) (B2: class x3 h i) (D: class x3 h) (R: class x3 i) (S c_1: class x3 h i) (F: class) (G: class x3 h i) (I: class) (M: class x3 y1 z h i) (V: class x3 h i) (c_0: class x3 i):
  $ wceq S (co I R cmps) $ >
  $ wceq B2 (cfv S cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel I V) $ >
  $ wceq D (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wf A2 D F) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq M (cfv S cmgp) $ >
  $ wceq G (cmpt y1 D (cmpt z D (cif (wceq (cv z) (cv y1)) c_1 c_0))) $ >
  $ wi ph (wceq (co M (ccom G F) cgsu) (cfv (cmpt i I (co ccnfld (cmpt x3 A2 (cfv (cv i) (cfv (cv x3) F))) cgsu)) G)) $;

--| Finite commutative sums of polynomials are taken componentwise. (Contributed by Thierry Arnoux, 16-Mar-2026.)
theorem mplgsum {y1 h k: setvar} (ph: wff h) (A2: class h) (B2: class y1 h k) (D: class h) (P: class y1 h k) (R F: class h) (I: class) (V: class y1 h k):
  $ wceq P (co I R cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel I V) $ >
  $ wceq D (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wceq (co P F cgsu) (cmpt y1 D (co R (cmpt k A2 (cfv (cv y1) (cfv (cv k) F))) cgsu))) $;

--| Finite product of monomials. Here the function ` G ` maps a bag of variables to the corresponding monomial. (Contributed by Thierry Arnoux, 16-Mar-2026.)
theorem mplmonprod {x3 y1 z h i: setvar} (ph: wff h) (A2: class h) (B2: class z h i) (D: class x3 h) (P: class y1 z h i) (R: class i) (c_1: class x3 h i) (F: class) (G: class x3 h i) (I: class) (M: class y1 z h i) (V: class x3 h i) (c_0: class x3 i):
  $ wceq P (co I R cmpl) $ >
  $ wceq B2 (cfv P cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel I V) $ >
  $ wceq D (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wf A2 D F) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq M (cfv P cmgp) $ >
  $ wceq G (cmpt y1 D (cmpt z D (cif (wceq (cv z) (cv y1)) c_1 c_0))) $ >
  $ wi ph (wceq (co M (ccom G F) cgsu) (cfv (cmpt i I (co ccnfld (cmpt x3 A2 (cfv (cv i) (cfv (cv x3) F))) cgsu)) G)) $;

--| Extend class notation with the symmetric polynomials.
term csply: class;

--| Extend class notation with the elementary symmetric polynomials.
term cesply: class;

--| Define symmetric polynomials. See ~ splyval for a more readable expression. (Contributed by Thierry Arnoux, 11-Jan-2026.)
axiom df_sply {x3 f2 h i r d: setvar}:
  $ wceq csply (cmpo i r cvv cvv (co (cfv (co (cv i) (cv r) cmpl) cbs) (cmpo d f2 (cfv (cfv (cv i) csymg) cbs) (cfv (co (cv i) (cv r) cmpl) cbs) (cmpt x3 (crab h (wbr (cv h) cc0 cfsupp) (co cn0 (cv i) cmap)) (cfv (ccom (cv x3) (cv d)) (cv f2)))) cfxp)) $;

--| Define elementary symmetric polynomials. (Contributed by Thierry Arnoux, 18-Jan-2026.)
axiom df_esply {h i k r c: setvar}:
  $ wceq cesply (cmpo i r cvv cvv (cmpt k cn0 (ccom (cfv (cv r) czrh) (cfv (cima (cfv (cv i) cind) (crab c (wceq (cfv (cv c) chash) (cv k)) (cpw (cv i)))) (cfv (crab h (wbr (cv h) cc0 cfsupp) (co cn0 (cv i) cmap)) cind))))) $;

--| The symmetric polynomials for a given index ` I ` of variables and base ring ` R ` . These are the fixed points of the action ` A ` which permutes variables. (Contributed by Thierry Arnoux, 11-Jan-2026.)
theorem splyval {x3 f2 h d: setvar} (ph: wff x3 f2 h d) (A2 P: class x3 f2 h d) (R: class x3 h) (S: class x3 f2 h d) (I: class) (M V W: class x3 f2 h d):
  $ wceq S (cfv I csymg) $ >
  $ wceq P (cfv S cbs) $ >
  $ wceq M (cfv (co I R cmpl) cbs) $ >
  $ wceq A2 (cmpo d f2 P M (cmpt x3 (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) (cfv (ccom (cv x3) (cv d)) (cv f2)))) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R W) $ >
  $ wi ph (wceq (co I R csply) (co M A2 cfxp)) $;

--| The symmetric polynomials form a subring of the ring of polynomials. (Contributed by Thierry Arnoux, 15-Jan-2026.)
theorem splysubrg {x3 f2 h d: setvar} (ph: wff h) (A2 P: class h) (R: class) (S: class x3 h) (I: class) (M: class h) (V: class f2 h d):
  $ wceq S (cfv I csymg) $ >
  $ wceq P (cfv S cbs) $ >
  $ wceq M (cfv (co I R cmpl) cbs) $ >
  $ wceq A2 (cmpo d f2 P M (cmpt x3 (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) (cfv (ccom (cv x3) (cv d)) (cv f2)))) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel (co I R csply) (cfv (co I R cmpl) csubrg)) $;

--| Conditions for being a symmetric polynomial. (Contributed by Thierry Arnoux, 18-Jan-2026.)
theorem issply {x3 h p: setvar} (ph: wff) (D: class h p) (P: class) (R: class p) (S: class x3 h) (F: class h) (I M: class) (V W: class x3 h p):
  $ wceq S (cfv I csymg) $ >
  $ wceq P (cfv S cbs) $ >
  $ wceq M (cfv (co I R cmpl) cbs) $ >
  $ wceq D (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R W) $ >
  $ wi ph (wcel F M) $ >
  $ wi (wa (wa ph (wcel (cv p) P)) (wcel (cv x3) D)) (wceq (cfv (ccom (cv x3) (cv p)) F) (cfv (cv x3) F)) $ >
  $ wi ph (wcel F (co I R csply)) $;

--| The elementary polynomials for a given index ` I ` of variables and base ring ` R ` . (Contributed by Thierry Arnoux, 18-Jan-2026.)
theorem esplyval {h k c: setvar} (ph: wff h k c) (D: class h k c) (R: class h c) (I: class) (V W: class h k c):
  $ wceq D (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R W) $ >
  $ wi ph (wceq (co I R cesply) (cmpt k cn0 (ccom (cfv R czrh) (cfv (cima (cfv I cind) (crab c (wceq (cfv (cv c) chash) (cv k)) (cpw I))) (cfv D cind))))) $;

--| The ` K ` -th elementary polynomial for a given index ` I ` of variables and base ring ` R ` . (Contributed by Thierry Arnoux, 18-Jan-2026.)
theorem esplyfval {h c: setvar} (ph: wff h c) (D R: class h c) (I: class) (K: class h) (V W: class h c):
  $ wceq D (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R W) $ >
  $ wi ph (wcel K cn0) $ >
  $ wi ph (wceq (cfv K (co I R cesply)) (ccom (cfv R czrh) (cfv (cima (cfv I cind) (crab c (wceq (cfv (cv c) chash) K) (cpw I))) (cfv D cind)))) $;

--| The ` 0 ` -th elementary symmetric polynomial is the constant ` 1 ` . (Contributed by Thierry Arnoux, 15-Feb-2026.)
theorem esplyfval0 (ph: wff) (R U I V: class):
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel R crg) $ >
  $ wceq U (cfv (co I R cmpl) cur) $ >
  $ wi ph (wceq (cfv cc0 (co I R cesply)) U) $;

--| When ` K ` is out-of-bounds, the ` K ` -th elementary symmetric polynomial is zero. (Contributed by Thierry Arnoux, 25-Jan-2026.)
theorem esplyfval2 {h: setvar} (ph: wff h) (D R: class h) (I: class) (K Z: class h):
  $ wceq D (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel K (cdif cn0 (co cc0 (cfv I chash) cfz))) $ >
  $ wceq Z (cfv (co I R cmpl) c0g) $ >
  $ wi ph (wceq (cfv K (co I R cesply)) Z) $;

--| Lemma for ~ esplyfv and others. (Contributed by Thierry Arnoux, 18-Jan-2026.)
theorem esplylem {h c: setvar} (ph: wff h c) (D R: class h c) (I: class) (K: class h):
  $ wceq D (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel K cn0) $ >
  $ wi ph (wss (cima (cfv I cind) (crab c (wceq (cfv (cv c) chash) K) (cpw I))) D) $;

--| Elementary symmetric polynomials are polynomials. (Contributed by Thierry Arnoux, 18-Jan-2026.)
theorem esplympl {h: setvar} (ph: wff h) (D R: class h) (I: class) (K M: class h):
  $ wceq D (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel K cn0) $ >
  $ wceq M (cfv (co I R cmpl) cbs) $ >
  $ wi ph (wcel (cfv K (co I R cesply)) M) $;

--| The ` K ` -th elementary symmetric polynomial is homogeneous of degree ` K ` . (Contributed by Thierry Arnoux, 18-Jan-2026.)
theorem esplymhp {h: setvar} (ph: wff h) (D R H: class h) (I: class) (K: class h):
  $ wceq D (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel K cn0) $ >
  $ wceq H (co I R cmhp) $ >
  $ wi ph (wcel (cfv K (co I R cesply)) (cfv K H)) $;

--| Coefficient for the ` K ` -th elementary symmetric polynomial and a bag of variables ` F ` where variables are not raised to a power. (Contributed by Thierry Arnoux, 18-Jan-2026.)
theorem esplyfv1 {h: setvar} (ph: wff h) (D R c_1 F: class h) (I: class) (K c_0: class h):
  $ wceq D (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel K (co cc0 (cfv I chash) cfz)) $ >
  $ wi ph (wcel F D) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi ph (wss (crn F) (cpr cc0 c1)) $ >
  $ wi ph (wceq (cfv F (cfv K (co I R cesply))) (cif (wceq (cfv (co F cc0 csupp) chash) K) c_1 c_0)) $;

--| Coefficient for the ` K ` -th elementary symmetric polynomial and a bag of variables ` F ` : the coefficient is ` .1. ` for the bags of exactly ` K ` variables, having exponent at most ` 1 ` . (Contributed by Thierry Arnoux, 18-Jan-2026.)
theorem esplyfv {h: setvar} (ph: wff h) (D R c_1 F: class h) (I: class) (K c_0: class h):
  $ wceq D (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel K (co cc0 (cfv I chash) cfz)) $ >
  $ wi ph (wcel F D) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi ph (wceq (cfv F (cfv K (co I R cesply))) (cif (wa (wss (crn F) (cpr cc0 c1)) (wceq (cfv (co F cc0 csupp) chash) K)) c_1 c_0)) $;

--| The ` K ` -th elementary symmetric polynomial is symmetric. (Contributed by Thierry Arnoux, 18-Jan-2026.)
theorem esplysply {h: setvar} (ph: wff) (D: class h) (R I: class) (K: class h):
  $ wceq D (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel K (co cc0 (cfv I chash) cfz)) $ >
  $ wi ph (wcel (cfv K (co I R cesply)) (co I R csply)) $;

--| Alternate expression for the value of the ` K ` -th elementary symmetric polynomial. (Contributed by Thierry Arnoux, 25-Jan-2026.)
theorem esplyfval3 {f2 h: setvar} (ph: wff h) (D R: class h) (c_1: class f2 h) (I: class) (K c_0: class h):
  $ wceq D (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel K cn0) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wi ph (wceq (cfv K (co I R cesply)) (cmpt f2 D (cif (wa (wss (crn (cv f2)) (cpr cc0 c1)) (wceq (cfv (co (cv f2) cc0 csupp) chash) K)) c_1 c_0))) $;

--| The first elementary symmetric polynomial is the sum of all variables. (Contributed by Thierry Arnoux, 16-Mar-2026.)
theorem esplyfval1 (ph: wff) (R E I V W: class):
  $ wceq W (co I R cmpl) $ >
  $ wceq V (co I R cmvr) $ >
  $ wceq E (co I R cesply) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wceq (cfv c1 E) (co W V cgsu)) $;

--| The last elementary symmetric polynomial is the product of all variables. (Contributed by Thierry Arnoux, 16-Mar-2026.)
theorem esplyfvaln (ph: wff) (R E I M N V W: class):
  $ wceq W (co I R cmpl) $ >
  $ wceq V (co I R cmvr) $ >
  $ wceq E (co I R cesply) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wceq N (cfv I chash) $ >
  $ wceq M (cfv W cmgp) $ >
  $ wi ph (wceq (cfv N E) (co M V cgsu)) $;

--| A recursive formula for the elementary symmetric polynomials. (Contributed by Thierry Arnoux, 25-Jan-2026.)
theorem esplyind {h: setvar} (ph: wff h) (C D c_pl R c_x E G: class h) (I J: class) (K V W: class h) (Y: class):
  $ wceq W (co I R cmpl) $ >
  $ wceq V (co I R cmvr) $ >
  $ wceq c_pl (cfv W cplusg) $ >
  $ wceq c_x (cfv W cmulr) $ >
  $ wceq D (crab h (wbr (cv h) cc0 cfsupp) (co cn0 I cmap)) $ >
  $ wceq G (cfv Y (co I R cextv)) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wcel Y I) $ >
  $ wceq J (cdif I (csn Y)) $ >
  $ wceq E (co J R cesply) $ >
  $ wi ph (wcel K (co c1 (cfv I chash) cfz)) $ >
  $ wceq C (crab h (wbr (cv h) cc0 cfsupp) (co cn0 J cmap)) $ >
  $ wi ph (wceq (cfv K (co I R cesply)) (co (co (cfv Y V) (cfv (cfv (co K c1 cmin) E) G) c_x) (cfv (cfv K E) G) c_pl)) $;

--| A recursive formula for the elementary symmetric polynomials, evaluated at a given set of points ` Z ` . (Contributed by Thierry Arnoux, 15-Feb-2026.)
theorem esplyindfv {h: setvar} (ph: wff h) (B2 C c_pl Q R c_x E F: class h) (I J: class) (K O: class h) (Y: class) (Z: class h):
  $ wceq c_x (cfv R cmulr) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel Y I) $ >
  $ wceq J (cdif I (csn Y)) $ >
  $ wceq E (co J R cesply) $ >
  $ wi ph (wcel K (co cc0 (cfv J chash) cfz)) $ >
  $ wceq C (crab h (wbr (cv h) cc0 cfsupp) (co cn0 J cmap)) $ >
  $ wceq F (cfv (co K c1 caddc) (co I R cesply)) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq Q (co I R cevl) $ >
  $ wceq O (co J R cevl) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wi ph (wf I B2 Z) $ >
  $ wi ph (wceq (cfv Z (cfv F Q)) (co (co (cfv Y Z) (cfv (cres Z J) (cfv (cfv K E) O)) c_x) (cfv (cres Z J) (cfv (cfv (co K c1 caddc) E) O)) c_pl)) $;

--| Express the last elementary symmetric polynomial, evaluated at a given set of points ` Z ` , in terms of the last elementary symmetric polynomial with one less variable. (Contributed by Thierry Arnoux, 15-Feb-2026.)
theorem esplyfvn (ph: wff) (B2 c_pl Q R c_x E F H I J K O Y Z: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq Q (co I R cevl) $ >
  $ wceq O (co J R cevl) $ >
  $ wceq E (co I R cesply) $ >
  $ wceq F (co J R cesply) $ >
  $ wceq H (cfv I chash) $ >
  $ wceq K (cfv J chash) $ >
  $ wceq J (cdif I (csn Y)) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel Y I) $ >
  $ wi ph (wf I B2 Z) $ >
  $ wi ph (wceq (cfv Z (cfv (cfv H E) Q)) (co (cfv Y Z) (cfv (cres Z J) (cfv (cfv K F) O)) c_x)) $;

--| The degree of a product of ` H ` of linear polynomials of the form ` X - Z ` is ` H ` . (Contributed by Thierry Arnoux, 15-Feb-2026.)
theorem vietadeg1 {n: setvar} (ph: wff) (A2: class) (B2: class n) (D: class) (Q R c_x c_1 E c_ex F H: class n) (I: class) (M: class n) (c_mi: class) (N: class n) (W X Z: class):
  $ wceq W (cfv R cpl1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_mi (cfv W csg) $ >
  $ wceq M (cfv W cmgp) $ >
  $ wceq Q (co I R cevl) $ >
  $ wceq E (co I R cesply) $ >
  $ wceq N (cfv R cminusg) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq A2 (cfv W cascl) $ >
  $ wceq c_ex (cfv (cfv R cmgp) cmg) $ >
  $ wceq H (cfv I chash) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wcel R cidom) $ >
  $ wi ph (wf I B2 Z) $ >
  $ wceq F (co M (cmpt n I (co X (cfv (cfv (cv n) Z) A2) c_mi)) cgsu) $ >
  $ wceq D (cfv R cdg1) $ >
  $ wi ph (wceq (cfv F D) H) $;

--| Lemma for ~ vieta : induction step. (Contributed by Thierry Arnoux, 15-Feb-2026.)
theorem vietalem {z k n: setvar} (ph: wff) (A2: class) (B2: class n) (Q R c_x c_1 E c_ex: class) (F: class z k n) (H I J: class) (K: class z n) (M c_mi N: class) (W: class z) (X: class) (Y: class z) (Z: class):
  $ wceq W (cfv R cpl1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_mi (cfv W csg) $ >
  $ wceq M (cfv W cmgp) $ >
  $ wceq Q (co I R cevl) $ >
  $ wceq E (co I R cesply) $ >
  $ wceq N (cfv R cminusg) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq A2 (cfv W cascl) $ >
  $ wceq c_ex (cfv (cfv R cmgp) cmg) $ >
  $ wceq H (cfv I chash) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wcel R cidom) $ >
  $ wi ph (wf I B2 Z) $ >
  $ wceq F (co M (cmpt n I (co X (cfv (cfv (cv n) Z) A2) c_mi)) cgsu) $ >
  $ wi ph (wcel K (co cc0 H cfz)) $ >
  $ wi ph (wcel Y I) $ >
  $ wceq J (cdif I (csn Y)) $ >
  $ wi ph (wral z (wral k (wceq (cfv (co (cfv J chash) (cv k) cmin) (cfv (co M (cmpt n J (co X (cfv (cfv (cv n) (cv z)) A2) c_mi)) cgsu) cco1)) (co (co (cv k) (cfv c_1 N) c_ex) (cfv (cv z) (cfv (cfv (cv k) (co J R cesply)) (co J R cevl))) c_x)) (co cc0 (cfv J chash) cfz)) (co B2 J cmap)) $ >
  $ wi ph (wceq (cfv (co M (cmpt n J (co X (cfv (cfv (cv n) (cres Z J)) A2) c_mi)) cgsu) (cfv R cdg1)) (cfv J chash)) $ >
  $ wi ph (wceq (cfv K (cfv F cco1)) (co (co (co H K cmin) (cfv c_1 N) c_ex) (cfv Z (cfv (cfv (co H K cmin) E) Q)) c_x)) $;

--| Vieta's Formulas: Coefficients of a monic polynomial ` F ` expressed as a product of linear polynomials of the form ` X - Z ` can be expressed in terms of elementary symmetric polynomials. The formulas appear in Chapter 6 of [Lang], p. 190. Theorem ~ vieta1 is a special case for the complex numbers, for the case ` K = 1 ` . (Contributed by Thierry Arnoux, 15-Feb-2026.)
theorem vieta {n: setvar} (ph: wff n) (A2: class) (B2 C Q R c_x c_1 E c_ex F H: class n) (I: class) (K M: class n) (c_mi: class) (N W: class n) (X Z: class):
  $ wceq W (cfv R cpl1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_mi (cfv W csg) $ >
  $ wceq M (cfv W cmgp) $ >
  $ wceq Q (co I R cevl) $ >
  $ wceq E (co I R cesply) $ >
  $ wceq N (cfv R cminusg) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq X (cfv R cv1) $ >
  $ wceq A2 (cfv W cascl) $ >
  $ wceq c_ex (cfv (cfv R cmgp) cmg) $ >
  $ wceq H (cfv I chash) $ >
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wcel R cidom) $ >
  $ wi ph (wf I B2 Z) $ >
  $ wceq F (co M (cmpt n I (co X (cfv (cfv (cv n) Z) A2) c_mi)) cgsu) $ >
  $ wi ph (wcel K (co cc0 H cfz)) $ >
  $ wceq C (cfv F cco1) $ >
  $ wi ph (wceq (cfv (co H K cmin) C) (co (co K (cfv c_1 N) c_ex) (cfv Z (cfv (cfv K E) Q)) c_x)) $;

--| The unity element of a subring algebra. (Contributed by Thierry Arnoux, 24-Jul-2023.)
theorem sra1r (ph: wff) (A2 S c_1 W: class):
  $ wi ph (wceq A2 (cfv S (cfv W csra))) $ >
  $ wi ph (wceq c_1 (cfv W cur)) $ >
  $ wi ph (wss S (cfv W cbs)) $ >
  $ wi ph (wceq c_1 (cfv A2 cur)) $;

--| Condition for a subring algebra to be a division ring. (Contributed by Thierry Arnoux, 29-Jul-2023.)
theorem sradrng (A2 B2 R V: class):
  $ wceq A2 (cfv V (cfv R csra)) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi (wa (wcel R cdr) (wss V B2)) (wcel A2 cdr) $;

--| Condition for a subring algebra to be an integral domain. (Contributed by Thierry Arnoux, 13-Oct-2025.)
theorem sraidom (ph: wff) (A2 B2 R V: class):
  $ wceq A2 (cfv V (cfv R csra)) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel R cidom) $ >
  $ wi ph (wss V B2) $ >
  $ wi ph (wcel A2 cidom) $;

--| A subring of the original structure is also a subring of the constructed subring algebra. (Contributed by Thierry Arnoux, 24-Jul-2023.)
theorem srasubrg (ph: wff) (A2 S U W: class):
  $ wi ph (wceq A2 (cfv S (cfv W csra))) $ >
  $ wi ph (wcel U (cfv W csubrg)) $ >
  $ wi ph (wss S (cfv W cbs)) $ >
  $ wi ph (wcel U (cfv A2 csubrg)) $;

--| Given a sub division ring ` F ` of a division ring ` E ` , ` E ` may be considered as a vector space over ` F ` , which becomes the field of scalars. (Contributed by Thierry Arnoux, 24-May-2023.)
theorem sralvec (A2 U E F: class):
  $ wceq A2 (cfv U (cfv E csra)) $ >
  $ wceq F (co E U cress) $ >
  $ wi (w3a (wcel E cdr) (wcel F cdr) (wcel U (cfv E csubrg))) (wcel A2 clvec) $;

--| Given a subfield ` F ` of a field ` E ` , ` E ` may be considered as a vector space over ` F ` , which becomes the field of scalars. (Contributed by Thierry Arnoux, 24-May-2023.)
theorem srafldlvec (A2 U E F: class):
  $ wceq A2 (cfv U (cfv E csra)) $ >
  $ wceq F (co E U cress) $ >
  $ wi (w3a (wcel E cfield) (wcel F cfield) (wcel U (cfv E csubrg))) (wcel A2 clvec) $;

--| The subring algebra of a restricted structure is the restriction of the subring algebra. (Contributed by Thierry Arnoux, 2-Apr-2025.)
theorem resssra (ph: wff) (A2 B2 C R S V: class):
  $ wceq A2 (cfv R cbs) $ >
  $ wceq S (co R B2 cress) $ >
  $ wi ph (wss B2 A2) $ >
  $ wi ph (wss C B2) $ >
  $ wi ph (wcel R V) $ >
  $ wi ph (wceq (cfv C (cfv S csra)) (co (cfv C (cfv R csra)) B2 cress)) $;

--| A subring is a subspace of the subring algebra. (Contributed by Thierry Arnoux, 2-Apr-2025.)
theorem lsssra (ph: wff) (A2 B2 C R S W: class):
  $ wceq W (cfv C (cfv R csra)) $ >
  $ wceq A2 (cfv R cbs) $ >
  $ wceq S (co R B2 cress) $ >
  $ wi ph (wcel B2 (cfv R csubrg)) $ >
  $ wi ph (wcel C (cfv S csubrg)) $ >
  $ wi ph (wcel B2 (cfv W clss)) $;

--| The "power" operation on a subring algebra. (Contributed by Thierry Arnoux, 10-Jan-2026.)
theorem srapwov (ph: wff) (A2 S W: class):
  $ wceq A2 (cfv S (cfv W csra)) $ >
  $ wi ph (wcel W crg) $ >
  $ wi ph (wss S (cfv W cbs)) $ >
  $ wi ph (wceq (cfv (cfv W cmgp) cmg) (cfv (cfv A2 cmgp) cmg)) $;

--| The additive neutral element of a division ring extension. (Contributed by Thierry Arnoux, 17-Jul-2023.)
theorem drgext0g (ph: wff) (B2 U E: class):
  $ wceq B2 (cfv U (cfv E csra)) $ >
  $ wi ph (wcel E cdr) $ >
  $ wi ph (wcel U (cfv E csubrg)) $ >
  $ wi ph (wceq (cfv E c0g) (cfv B2 c0g)) $;

--| The scalar multiplication operation of a division ring extension. (Contributed by Thierry Arnoux, 17-Jul-2023.)
theorem drgextvsca (ph: wff) (B2 U E: class):
  $ wceq B2 (cfv U (cfv E csra)) $ >
  $ wi ph (wcel E cdr) $ >
  $ wi ph (wcel U (cfv E csubrg)) $ >
  $ wi ph (wceq (cfv E cmulr) (cfv B2 cvsca)) $;

--| The additive neutral element of the scalar field of a division ring extension. (Contributed by Thierry Arnoux, 17-Jul-2023.)
theorem drgext0gsca (ph: wff) (B2 U E: class):
  $ wceq B2 (cfv U (cfv E csra)) $ >
  $ wi ph (wcel E cdr) $ >
  $ wi ph (wcel U (cfv E csubrg)) $ >
  $ wi ph (wceq (cfv B2 c0g) (cfv (cfv B2 csca) c0g)) $;

--| The scalar field is a subring of a division ring extension. (Contributed by Thierry Arnoux, 17-Jul-2023.)
theorem drgextsubrg (ph: wff) (B2 U E F: class):
  $ wceq B2 (cfv U (cfv E csra)) $ >
  $ wi ph (wcel E cdr) $ >
  $ wi ph (wcel U (cfv E csubrg)) $ >
  $ wceq F (co E U cress) $ >
  $ wi ph (wcel F cdr) $ >
  $ wi ph (wcel U (cfv B2 csubrg)) $;

--| The scalar field is a subspace of a subring algebra. (Contributed by Thierry Arnoux, 17-Jul-2023.)
theorem drgextlsp (ph: wff) (B2 U E F: class):
  $ wceq B2 (cfv U (cfv E csra)) $ >
  $ wi ph (wcel E cdr) $ >
  $ wi ph (wcel U (cfv E csubrg)) $ >
  $ wceq F (co E U cress) $ >
  $ wi ph (wcel F cdr) $ >
  $ wi ph (wcel U (cfv B2 clss)) $;

--| Group sum in a division ring extension. (Contributed by Thierry Arnoux, 17-Jul-2023.)
theorem drgextgsum {i: setvar} (ph: wff i) (B2 U E F V: class i) (X: class) (Y: class i):
  $ wceq B2 (cfv U (cfv E csra)) $ >
  $ wi ph (wcel E cdr) $ >
  $ wi ph (wcel U (cfv E csubrg)) $ >
  $ wceq F (co E U cress) $ >
  $ wi ph (wcel F cdr) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wceq (co E (cmpt i X Y) cgsu) (co B2 (cmpt i X Y) cgsu)) $;

--| Finite version of ~ lvecdim which does not require the axiom of choice. The axiom of choice is used in ~ acsmapd , which is required in the infinite case. Suggested by G&eacute;rard Lang. (Contributed by Thierry Arnoux, 24-May-2023.)
theorem lvecdimfi (ph: wff) (S T J W: class):
  $ wceq J (cfv W clbs) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel S J) $ >
  $ wi ph (wcel T J) $ >
  $ wi ph (wcel S cfn) $ >
  $ wi ph (wbr S T cen) $;

--| Any finite generating set ` S ` of a vector space ` W ` contains a basis. (Contributed by Thierry Arnoux, 13-Oct-2025.)
theorem exsslsb {s1: setvar} (ph: wff) (B2 S J K: class) (W: class s1):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq J (cfv W clbs) $ >
  $ wceq K (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel S cfn) $ >
  $ wi ph (wss S B2) $ >
  $ wi ph (wceq (cfv S K) B2) $ >
  $ wi ph (wrex s1 (wss (cv s1) S) J) $;

--| The size of a basis ` X ` of a vector space ` W ` is less than the size of a generating set ` Y ` . (Contributed by Thierry Arnoux, 13-Oct-2025.)
theorem lbslelsp (ph: wff) (B2 J K W X Y: class):
  $ wceq B2 (cfv W cbs) $ >
  $ wceq J (cfv W clbs) $ >
  $ wceq K (cfv W clspn) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel X J) $ >
  $ wi ph (wss Y B2) $ >
  $ wi ph (wceq (cfv Y K) B2) $ >
  $ wi ph (wbr (cfv X chash) (cfv Y chash) cle) $;

--| Extend class notation with the dimension of a vector space.
term cldim: class;

--| Define the dimension of a vector space as the cardinality of its bases. Note that by ~ lvecdim , all bases are equinumerous. (Contributed by Thierry Arnoux, 6-May-2023.)
axiom df_dim {f2: setvar}:
  $ wceq cldim (cmpt f2 cvv (cuni (cima chash (cfv (cv f2) clbs)))) $;

--| The dimension of a vector space ` F ` is the cardinality of one of its bases. (Contributed by Thierry Arnoux, 6-May-2023.)
theorem dimval (S F J: class):
  $ wceq J (cfv F clbs) $ >
  $ wi (wa (wcel F clvec) (wcel S J)) (wceq (cfv F cldim) (cfv S chash)) $;

--| The dimension of a vector space ` F ` is the cardinality of one of its bases. This version of ~ dimval does not depend on the axiom of choice, but it is limited to the case where the base ` S ` is finite. (Contributed by Thierry Arnoux, 24-May-2023.)
theorem dimvalfi (S F J: class):
  $ wceq J (cfv F clbs) $ >
  $ wi (w3a (wcel F clvec) (wcel S J) (wcel S cfn)) (wceq (cfv F cldim) (cfv S chash)) $;

--| Closure of the vector space dimension. (Contributed by Thierry Arnoux, 18-May-2023.)
theorem dimcl (V: class):
  $ wi (wcel V clvec) (wcel (cfv V cldim) cxnn0) $;

--| Module isomorphisms preserve vector space dimensions. (Contributed by Thierry Arnoux, 25-Feb-2025.)
theorem lmimdim (ph: wff) (S T F: class):
  $ wi ph (wcel F (co S T clmim)) $ >
  $ wi ph (wcel S clvec) $ >
  $ wi ph (wceq (cfv S cldim) (cfv T cldim)) $;

--| Module isomorphisms preserve vector space dimensions. (Contributed by Thierry Arnoux, 25-Mar-2025.)
theorem lmicdim (ph: wff) (S T: class):
  $ wi ph (wbr S T clmic) $ >
  $ wi ph (wcel S clvec) $ >
  $ wi ph (wceq (cfv S cldim) (cfv T cldim)) $;

--| A vector space of dimension zero is reduced to its identity element. (Contributed by Thierry Arnoux, 31-Jul-2023.)
theorem lvecdim0i (V c_0: class):
  $ wceq c_0 (cfv V c0g) $ >
  $ wi (wa (wcel V clvec) (wceq (cfv V cldim) cc0)) (wceq (cfv V cbs) (csn c_0)) $;

--| A vector space of dimension zero is reduced to its identity element, biconditional version. (Contributed by Thierry Arnoux, 31-Jul-2023.)
theorem lvecdim0 (V c_0: class):
  $ wceq c_0 (cfv V c0g) $ >
  $ wi (wcel V clvec) (wb (wceq (cfv V cldim) cc0) (wceq (cfv V cbs) (csn c_0))) $;

--| The dimension of a linear subspace is less than or equal to the dimension of the parent vector space. This is corollary 5.4 of [Lang] p. 141. (Contributed by Thierry Arnoux, 20-May-2023.)
theorem lssdimle (U W X: class):
  $ wceq X (co W U cress) $ >
  $ wi (wa (wcel W clvec) (wcel U (cfv W clss))) (wbr (cfv X cldim) (cfv W cldim) cle) $;

--| If two structures have the same components (properties), they have the same dimension. (Contributed by Thierry Arnoux, 18-May-2023.)
theorem dimpropd {x3 y1: setvar} (ph: wff) (B2 P F G K L W: class):
  $ wi ph (wceq B2 (cfv K cbs)) $ >
  $ wi ph (wceq B2 (cfv L cbs)) $ >
  $ wi ph (wss B2 W) $ >
  $ wi (wa ph (wa (wcel (cv x3) W) (wcel (cv y1) W))) (wceq (co (cv x3) (cv y1) (cfv K cplusg)) (co (cv x3) (cv y1) (cfv L cplusg))) $ >
  $ wi (wa ph (wa (wcel (cv x3) P) (wcel (cv y1) B2))) (wcel (co (cv x3) (cv y1) (cfv K cvsca)) W) $ >
  $ wi (wa ph (wa (wcel (cv x3) P) (wcel (cv y1) B2))) (wceq (co (cv x3) (cv y1) (cfv K cvsca)) (co (cv x3) (cv y1) (cfv L cvsca))) $ >
  $ wceq F (cfv K csca) $ >
  $ wceq G (cfv L csca) $ >
  $ wi ph (wceq P (cfv F cbs)) $ >
  $ wi ph (wceq P (cfv G cbs)) $ >
  $ wi (wa ph (wa (wcel (cv x3) P) (wcel (cv y1) P))) (wceq (co (cv x3) (cv y1) (cfv F cplusg)) (co (cv x3) (cv y1) (cfv G cplusg))) $ >
  $ wi ph (wcel K clvec) $ >
  $ wi ph (wcel L clvec) $ >
  $ wi ph (wceq (cfv K cldim) (cfv L cldim)) $;

--| The left vector space induced by a ring over itself has dimension 1. (Contributed by Thierry Arnoux, 5-Aug-2023.) Generalize to division rings. (Revised by SN, 22-Mar-2025.)
theorem rlmdim (F V: class):
  $ wceq V (cfv F crglmod) $ >
  $ wi (wcel F cdr) (wceq (cfv V cldim) c1) $;

--| Dimension of a free left module. (Contributed by Thierry Arnoux, 20-May-2023.)
theorem frlmdim (R F I V: class):
  $ wceq F (co R I cfrlm) $ >
  $ wi (wa (wcel R cdr) (wcel I V)) (wceq (cfv F cldim) (cfv I chash)) $;

--| Augmenting a structure with a norm conserves left vector spaces. (Contributed by Thierry Arnoux, 20-May-2023.)
theorem tnglvec (T G N V: class):
  $ wceq T (co G N ctng) $ >
  $ wi (wcel N V) (wb (wcel G clvec) (wcel T clvec)) $;

--| Dimension of a left vector space augmented with a norm. (Contributed by Thierry Arnoux, 20-May-2023.)
theorem tngdim (T G N V: class):
  $ wceq T (co G N ctng) $ >
  $ wi (wa (wcel G clvec) (wcel N V)) (wceq (cfv G cldim) (cfv T cldim)) $;

--| Dimension of the generalized Euclidean space. (Contributed by Thierry Arnoux, 20-May-2023.)
theorem rrxdim (H I V: class):
  $ wceq H (cfv I crrx) $ >
  $ wi (wcel I V) (wceq (cfv H cldim) (cfv I chash)) $;

--| Dimension of the space of square matrices. (Contributed by Thierry Arnoux, 20-May-2023.)
theorem matdim (A2 R I N: class):
  $ wceq A2 (co I R cmat) $ >
  $ wceq N (cfv I chash) $ >
  $ wi (wa (wcel I cfn) (wcel R cdr)) (wceq (cfv A2 cldim) (co N N cmul)) $;

--| A nonzero vector ` X ` is a basis of a line spanned by the singleton ` X ` . Spans of nonzero singletons are sometimes called "atoms", see ~ df-lsatoms and for example ~ lsatlspsn . (Contributed by Thierry Arnoux, 20-May-2023.)
theorem lbslsat (N V W X Y c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq Y (co W (cfv (csn X) N) cress) $ >
  $ wi (w3a (wcel W clvec) (wcel X V) (wne X c_0)) (wcel (csn X) (cfv Y clbs)) $;

--| A line, spanned by a nonzero singleton, has dimension 1. (Contributed by Thierry Arnoux, 20-May-2023.)
theorem lsatdim (N V W X Y c_0: class):
  $ wceq V (cfv W cbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wceq Y (co W (cfv (csn X) N) cress) $ >
  $ wi (w3a (wcel W clvec) (wcel X V) (wne X c_0)) (wceq (cfv Y cldim) c1) $;

--| The dimension of a vector space that is also a division ring is greater than zero. (Contributed by Thierry Arnoux, 29-Jul-2023.)
theorem drngdimgt0 (F: class):
  $ wi (wa (wcel F clvec) (wcel F cdr)) (wbr cc0 (cfv F cldim) clt) $;

--| A homomorphism of left vector spaces has a left vector space as codomain. (Contributed by Thierry Arnoux, 7-May-2023.)
theorem lmhmlvec2 (U F V: class):
  $ wi (wa (wcel V clvec) (wcel F (co V U clmhm))) (wcel U clvec) $;

--| The kernel of a vector space homomorphism is a vector space itself. (Contributed by Thierry Arnoux, 7-May-2023.)
theorem kerlmhm (U F K V c_0: class):
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq K (co V (cima (ccnv F) (csn c_0)) cress) $ >
  $ wi (wa (wcel V clvec) (wcel F (co V U clmhm))) (wcel K clvec) $;

--| The image of a vector space homomorphism is a vector space itself. (Contributed by Thierry Arnoux, 7-May-2023.)
theorem imlmhm (U F I V: class):
  $ wceq I (co U (crn F) cress) $ >
  $ wi (wa (wcel V clvec) (wcel F (co V U clmhm))) (wcel I clvec) $;

--| Lemma for ~ ply1degltdim . (Contributed by Thierry Arnoux, 20-Feb-2025.)
theorem ply1degltdimlem {n: setvar} (ph: wff) (D: class n) (P R S E F N: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq D (cfv R cdg1) $ >
  $ wceq S (cima (ccnv D) (co cmnf N cico)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel R cdr) $ >
  $ wceq E (co P S cress) $ >
  $ wceq F (cmpt n (co cc0 N cfzo) (co (cv n) (cfv R cv1) (cfv (cfv P cmgp) cmg))) $ >
  $ wi ph (wcel (crn F) (cfv E clbs)) $;

--| The space ` S ` of the univariate polynomials of degree less than ` N ` has dimension ` N ` . (Contributed by Thierry Arnoux, 20-Feb-2025.)
theorem ply1degltdim (ph: wff) (D P R S E N: class):
  $ wceq P (cfv R cpl1) $ >
  $ wceq D (cfv R cdg1) $ >
  $ wceq S (cima (ccnv D) (co cmnf N cico)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel R cdr) $ >
  $ wceq E (co P S cress) $ >
  $ wi ph (wceq (cfv E cldim) N) $;

--| Lemma for ~ lindsun . (Contributed by Thierry Arnoux, 9-May-2023.)
theorem lindsunlem (ph: wff) (C U F K N O V W c_0: class):
  $ wceq N (cfv W clspn) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U (cfv W clinds)) $ >
  $ wi ph (wcel V (cfv W clinds)) $ >
  $ wi ph (wceq (cin (cfv U N) (cfv V N)) (csn c_0)) $ >
  $ wceq O (cfv (cfv W csca) c0g) $ >
  $ wceq F (cfv (cfv W csca) cbs) $ >
  $ wi ph (wcel C U) $ >
  $ wi ph (wcel K (cdif F (csn O))) $ >
  $ wi ph (wcel (co K C (cfv W cvsca)) (cfv (cdif (cun U V) (csn C)) N)) $ >
  $ wi ph wfal $;

--| Condition for the union of two independent sets to be an independent set. (Contributed by Thierry Arnoux, 9-May-2023.)
theorem lindsun (ph: wff) (U N V W c_0: class):
  $ wceq N (cfv W clspn) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi ph (wcel W clvec) $ >
  $ wi ph (wcel U (cfv W clinds)) $ >
  $ wi ph (wcel V (cfv W clinds)) $ >
  $ wi ph (wceq (cin (cfv U N) (cfv V N)) (csn c_0)) $ >
  $ wi ph (wcel (cun U V) (cfv W clinds)) $;

--| The linear spans of two disjunct independent sets only have a trivial intersection. This can be seen as the opposite direction of ~ lindsun . (Contributed by Thierry Arnoux, 17-May-2023.)
theorem lbsdiflsp0 (B2 J N V W c_0: class):
  $ wceq J (cfv W clbs) $ >
  $ wceq N (cfv W clspn) $ >
  $ wceq c_0 (cfv W c0g) $ >
  $ wi (w3a (wcel W clvec) (wcel B2 J) (wss V B2)) (wceq (cin (cfv (cdif B2 V) N) (cfv V N)) (csn c_0)) $;

--| Given a linear map ` F ` between vector spaces ` V ` and ` U ` , the dimension of the vector space ` V ` is the sum of the dimension of ` F ` 's kernel and the dimension of ` F ` 's image. Second part of theorem 5.3 in [Lang] p. 141 This can also be described as the Rank-nullity theorem, ` ( dim `` I ) ` being the rank of ` F ` (the dimension of its image), and ` ( dim `` K ) ` its nullity (the dimension of its kernel). (Contributed by Thierry Arnoux, 17-May-2023.)
theorem dimkerim (U F I K V c_0: class):
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq K (co V (cima (ccnv F) (csn c_0)) cress) $ >
  $ wceq I (co U (crn F) cress) $ >
  $ wi (wa (wcel V clvec) (wcel F (co V U clmhm))) (wceq (cfv V cldim) (co (cfv K cldim) (cfv I cldim) cxad)) $;

--| Let ` W ` be a vector space, and let ` X ` be a subspace. Then the dimension of ` W ` is the sum of the dimension of ` X ` and the dimension of the quotient space of ` X ` . First part of theorem 5.3 in [Lang] p. 141. (Contributed by Thierry Arnoux, 20-May-2023.)
theorem qusdimsum (U W X Y: class):
  $ wceq X (co W U cress) $ >
  $ wceq Y (co W (co W U cqg) cqus) $ >
  $ wi (wa (wcel W clvec) (wcel U (cfv W clss))) (wceq (cfv W cldim) (co (cfv X cldim) (cfv Y cldim) cxad)) $;

--| Lemma for ~ fedgmul . (Contributed by Thierry Arnoux, 20-Jul-2023.)
theorem fedgmullem1 {i j: setvar} (ph: wff) (A2: class) (B2: class i) (C D: class) (U: class j) (E: class) (F: class i j) (G H: class) (K: class i j) (L: class i) (V: class i j) (X Y: class) (Z: class i j):
  $ wceq A2 (cfv V (cfv E csra)) $ >
  $ wceq B2 (cfv U (cfv E csra)) $ >
  $ wceq C (cfv V (cfv F csra)) $ >
  $ wceq F (co E U cress) $ >
  $ wceq K (co E V cress) $ >
  $ wi ph (wcel E cdr) $ >
  $ wi ph (wcel F cdr) $ >
  $ wi ph (wcel K cdr) $ >
  $ wi ph (wcel U (cfv E csubrg)) $ >
  $ wi ph (wcel V (cfv F csubrg)) $ >
  $ wceq D (cmpo j i Y X (co (cv i) (cv j) (cfv E cmulr))) $ >
  $ wceq H (cmpo j i Y X (cfv (cv i) (cfv (cv j) G))) $ >
  $ wi ph (wcel X (cfv C clbs)) $ >
  $ wi ph (wcel Y (cfv B2 clbs)) $ >
  $ wi ph (wcel Z (cfv A2 cbs)) $ >
  $ wi ph (wf Y (cfv (cfv B2 csca) cbs) L) $ >
  $ wi ph (wbr L (cfv (cfv B2 csca) c0g) cfsupp) $ >
  $ wi ph (wceq Z (co B2 (cmpt j Y (co (cfv (cv j) L) (cv j) (cfv B2 cvsca))) cgsu)) $ >
  $ wi ph (wf Y (co (cfv (cfv C csca) cbs) X cmap) G) $ >
  $ wi (wa ph (wcel (cv j) Y)) (wbr (cfv (cv j) G) (cfv (cfv C csca) c0g) cfsupp) $ >
  $ wi (wa ph (wcel (cv j) Y)) (wceq (cfv (cv j) L) (co C (cmpt i X (co (cfv (cv i) (cfv (cv j) G)) (cv i) (cfv C cvsca))) cgsu)) $ >
  $ wi ph (wa (wbr H (cfv (cfv A2 csca) c0g) cfsupp) (wceq Z (co A2 (co H D (cof (cfv A2 cvsca))) cgsu))) $;

--| Lemma for ~ fedgmul . (Contributed by Thierry Arnoux, 20-Jul-2023.)
theorem fedgmullem2 {i j: setvar} (ph: wff) (A2 B2: class) (C: class j) (D: class) (U: class j) (E: class) (F G H K V: class i j) (W X Y: class):
  $ wceq A2 (cfv V (cfv E csra)) $ >
  $ wceq B2 (cfv U (cfv E csra)) $ >
  $ wceq C (cfv V (cfv F csra)) $ >
  $ wceq F (co E U cress) $ >
  $ wceq K (co E V cress) $ >
  $ wi ph (wcel E cdr) $ >
  $ wi ph (wcel F cdr) $ >
  $ wi ph (wcel K cdr) $ >
  $ wi ph (wcel U (cfv E csubrg)) $ >
  $ wi ph (wcel V (cfv F csubrg)) $ >
  $ wceq D (cmpo j i Y X (co (cv i) (cv j) (cfv E cmulr))) $ >
  $ wceq H (cmpo j i Y X (cfv (cv i) (cfv (cv j) G))) $ >
  $ wi ph (wcel X (cfv C clbs)) $ >
  $ wi ph (wcel Y (cfv B2 clbs)) $ >
  $ wi ph (wcel W (cfv (co (cfv A2 csca) (cxp Y X) cfrlm) cbs)) $ >
  $ wi ph (wceq (co A2 (co W D (cof (cfv A2 cvsca))) cgsu) (cfv A2 c0g)) $ >
  $ wi ph (wceq W (cxp (cxp Y X) (csn (cfv (cfv A2 csca) c0g)))) $;

--| The multiplicativity formula for degrees of field extensions. Given ` E ` a field extension of ` F ` , itself a field extension of ` K ` , we have ` [ E : K ] = [ E : F ] [ F : K ] ` . Proposition 1.2 of [Lang], p. 224. Here ` ( dim `` A ) ` is the degree of the extension ` E ` of ` K ` , ` ( dim `` B ) ` is the degree of the extension ` E ` of ` F ` , and ` ( dim `` C ) ` is the degree of the extension ` F ` of ` K ` . This proof is valid for infinite dimensions, and is actually valid for division ring extensions, not just field extensions. (Contributed by Thierry Arnoux, 25-Jul-2023.) Remove dependency on ~ ax-reg . (Revised by Timothy J. O'Malley, 15-Oct-2026.)
theorem fedgmul (ph: wff) (A2 B2 C U E F K V: class):
  $ wceq A2 (cfv V (cfv E csra)) $ >
  $ wceq B2 (cfv U (cfv E csra)) $ >
  $ wceq C (cfv V (cfv F csra)) $ >
  $ wceq F (co E U cress) $ >
  $ wceq K (co E V cress) $ >
  $ wi ph (wcel E cdr) $ >
  $ wi ph (wcel F cdr) $ >
  $ wi ph (wcel K cdr) $ >
  $ wi ph (wcel U (cfv E csubrg)) $ >
  $ wi ph (wcel V (cfv F csubrg)) $ >
  $ wi ph (wceq (cfv A2 cldim) (co (cfv B2 cldim) (cfv C cldim) cxmu)) $;

--| If the dimension of a linear subspace ` L ` is the dimension of the whole vector space ` E ` , then ` L ` is the whole space. (Contributed by Thierry Arnoux, 3-Aug-2025.)
theorem dimlssid (ph: wff) (B2 E L: class):
  $ wceq B2 (cfv E cbs) $ >
  $ wi ph (wcel E clvec) $ >
  $ wi ph (wcel (cfv E cldim) cn0) $ >
  $ wi ph (wcel L (cfv E clss)) $ >
  $ wi ph (wceq (cfv (co E L cress) cldim) (cfv E cldim)) $ >
  $ wi ph (wceq L B2) $;

--| If an endomorphism ` U ` of a vector space ` E ` of finite dimension is injective, then it is bijective. Item (b) of Corollary of Proposition 9 in [BourbakiAlg1] p. 298 . (Contributed by Thierry Arnoux, 3-Aug-2025.)
theorem lvecendof1f1o (ph: wff) (B2 U E: class):
  $ wceq B2 (cfv E cbs) $ >
  $ wi ph (wcel E clvec) $ >
  $ wi ph (wcel (cfv E cldim) cn0) $ >
  $ wi ph (wcel U (co E E clmhm)) $ >
  $ wi ph (wf1 B2 B2 U) $ >
  $ wi ph (wf1o B2 B2 U) $;

--| In an associative algebra ` A ` , left-multiplication by a fixed element of the algebra is a module homomorphism, analogous to ~ ringlghm . (Contributed by Thierry Arnoux, 3-Aug-2025.)
theorem lactlmhm {x3: setvar} (ph: wff) (A2 B2 C c_x: class) (F: class x3):
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_x (cfv A2 cmulr) $ >
  $ wceq F (cmpt x3 B2 (co C (cv x3) c_x)) $ >
  $ wi ph (wcel A2 casa) $ >
  $ wi ph (wcel C B2) $ >
  $ wi ph (wcel F (co A2 A2 clmhm)) $;

--| In an associative algebra ` A ` , left-multiplication by a fixed element of the algebra is bijective. See also ~ lactlmhm . (Contributed by Thierry Arnoux, 3-Aug-2025.)
theorem assalactf1o {x3: setvar} (ph: wff) (A2 B2 C c_x: class) (E F K: class x3):
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_x (cfv A2 cmulr) $ >
  $ wceq F (cmpt x3 B2 (co C (cv x3) c_x)) $ >
  $ wi ph (wcel A2 casa) $ >
  $ wceq E (cfv A2 crlreg) $ >
  $ wceq K (cfv A2 csca) $ >
  $ wi ph (wcel K cdr) $ >
  $ wi ph (wcel (cfv A2 cldim) cn0) $ >
  $ wi ph (wcel C E) $ >
  $ wi ph (wf1o B2 B2 F) $;

--| If an element ` X ` of an associative algebra ` A ` over a division ring ` K ` is regular, then it is a unit. Proposition 2. in Chapter 5. of [BourbakiAlg2] p. 113. (Contributed by Thierry Arnoux, 3-Aug-2025.)
theorem assarrginv (ph: wff) (A2 U E K X: class):
  $ wceq E (cfv A2 crlreg) $ >
  $ wceq U (cfv A2 cui) $ >
  $ wceq K (cfv A2 csca) $ >
  $ wi ph (wcel A2 casa) $ >
  $ wi ph (wcel K cdr) $ >
  $ wi ph (wcel (cfv A2 cldim) cn0) $ >
  $ wi ph (wcel X E) $ >
  $ wi ph (wcel X U) $;

--| If an algebra ` A ` of finite degree over a division ring ` K ` is an integral domain, then it is a field. Corollary of Proposition 2. in Chapter 5. of [BourbakiAlg2] p. 113. (Contributed by Thierry Arnoux, 3-Aug-2025.)
theorem assafld (ph: wff) (A2 K: class):
  $ wceq K (cfv A2 csca) $ >
  $ wi ph (wcel A2 casa) $ >
  $ wi ph (wcel A2 cidom) $ >
  $ wi ph (wcel K cdr) $ >
  $ wi ph (wcel (cfv A2 cldim) cn0) $ >
  $ wi ph (wcel A2 cfield) $;

--| Syntax for the field extension relation.
term cfldext: class;

--| Syntax for the finite field extension relation.
term cfinext: class;

--| Syntax for the field extension degree operation.
term cextdg: class;

--| Definition of the field extension relation. (Contributed by Thierry Arnoux, 29-Jul-2023.)
axiom df_fldext {e f2: setvar}:
  $ wceq cfldext (copab e f2 (wa (wa (wcel (cv e) cfield) (wcel (cv f2) cfield)) (wa (wceq (cv f2) (co (cv e) (cfv (cv f2) cbs) cress)) (wcel (cfv (cv f2) cbs) (cfv (cv e) csubrg))))) $;

--| Definition of the field extension degree operation. (Contributed by Thierry Arnoux, 29-Jul-2023.)
axiom df_extdg {e f2: setvar}:
  $ wceq cextdg (cmpo e f2 cvv (cima cfldext (csn (cv e))) (cfv (cfv (cfv (cv f2) cbs) (cfv (cv e) csra)) cldim)) $;

--| Definition of the finite field extension relation. (Contributed by Thierry Arnoux, 29-Jul-2023.)
axiom df_finext {e f2: setvar}:
  $ wceq cfinext (copab e f2 (wa (wbr (cv e) (cv f2) cfldext) (wcel (co (cv e) (cv f2) cextdg) cn0))) $;

--| The field extension is a relation. (Contributed by Thierry Arnoux, 29-Jul-2023.)
theorem relfldext:
  $ wrel cfldext $;

--| The field extension relation explicited. (Contributed by Thierry Arnoux, 29-Jul-2023.)
theorem brfldext (E F: class):
  $ wi (wa (wcel E cfield) (wcel F cfield)) (wb (wbr E F cfldext) (wa (wceq F (co E (cfv F cbs) cress)) (wcel (cfv F cbs) (cfv E csubrg)))) $;

--| The field of the complex numbers is an extension of the field of the real numbers. (Contributed by Thierry Arnoux, 20-Jul-2023.)
theorem ccfldextrr:
  $ wbr ccnfld crefld cfldext $;

--| A field extension is only defined if the extension is a field. (Contributed by Thierry Arnoux, 29-Jul-2023.)
theorem fldextfld1 (E F: class):
  $ wi (wbr E F cfldext) (wcel E cfield) $;

--| A field extension is only defined if the subfield is a field. (Contributed by Thierry Arnoux, 29-Jul-2023.)
theorem fldextfld2 (E F: class):
  $ wi (wbr E F cfldext) (wcel F cfield) $;

--| Field extension implies a subring relation. (Contributed by Thierry Arnoux, 29-Jul-2023.)
theorem fldextsubrg (U E F: class):
  $ wceq U (cfv F cbs) $ >
  $ wi (wbr E F cfldext) (wcel U (cfv E csubrg)) $;

--| A field ` E ` and any sub-division-ring ` F ` of ` E ` form a field extension. (Contributed by Thierry Arnoux, 26-Oct-2025.)
theorem sdrgfldext (ph: wff) (B2 E F: class):
  $ wceq B2 (cfv E cbs) $ >
  $ wi ph (wcel E cfield) $ >
  $ wi ph (wcel F (cfv E csdrg)) $ >
  $ wi ph (wbr E (co E F cress) cfldext) $;

--| Field extension implies a structure restriction relation. (Contributed by Thierry Arnoux, 29-Jul-2023.)
theorem fldextress (E F: class):
  $ wi (wbr E F cfldext) (wceq F (co E (cfv F cbs) cress)) $;

--| The finite field extension relation explicited. (Contributed by Thierry Arnoux, 29-Jul-2023.)
theorem brfinext (E F: class):
  $ wi (wbr E F cfldext) (wb (wbr E F cfinext) (wcel (co E F cextdg) cn0)) $;

--| Value of the field extension degree operation. (Contributed by Thierry Arnoux, 29-Jul-2023.)
theorem extdgval (E F: class):
  $ wi (wbr E F cfldext) (wceq (co E F cextdg) (cfv (cfv (cfv F cbs) (cfv E csra)) cldim)) $;

--| Deduce sub-division-ring from field extension. (Contributed by Thierry Arnoux, 26-Oct-2025.)
theorem fldextsdrg (ph: wff) (B2 E F: class):
  $ wceq B2 (cfv F cbs) $ >
  $ wi ph (wbr E F cfldext) $ >
  $ wi ph (wcel B2 (cfv E csdrg)) $;

--| The subring algebra associated with a field extension is a vector space. (Contributed by Thierry Arnoux, 3-Aug-2023.)
theorem fldextsralvec (E F: class):
  $ wi (wbr E F cfldext) (wcel (cfv (cfv F cbs) (cfv E csra)) clvec) $;

--| Closure of the field extension degree operation. (Contributed by Thierry Arnoux, 29-Jul-2023.)
theorem extdgcl (E F: class):
  $ wi (wbr E F cfldext) (wcel (co E F cextdg) cxnn0) $;

--| Degrees of field extension are greater than zero. (Contributed by Thierry Arnoux, 30-Jul-2023.)
theorem extdggt0 (E F: class):
  $ wi (wbr E F cfldext) (wbr cc0 (co E F cextdg) clt) $;

--| Field extension is a transitive relation. (Contributed by Thierry Arnoux, 29-Jul-2023.)
theorem fldexttr (E F K: class):
  $ wi (wa (wbr E F cfldext) (wbr F K cfldext)) (wbr E K cfldext) $;

--| The field extension relation is reflexive. (Contributed by Thierry Arnoux, 30-Jul-2023.)
theorem fldextid (F: class):
  $ wi (wcel F cfield) (wbr F F cfldext) $;

--| A trivial field extension has degree one. (Contributed by Thierry Arnoux, 4-Aug-2023.)
theorem extdgid (E: class):
  $ wi (wcel E cfield) (wceq (co E E cextdg) c1) $;

--| A sub-division-ring of a field forms a field extension. (Contributed by Thierry Arnoux, 19-Oct-2025.)
theorem fldsdrgfldext (ph: wff) (A2 F G: class):
  $ wceq G (co F A2 cress) $ >
  $ wi ph (wcel F cfield) $ >
  $ wi ph (wcel A2 (cfv F csdrg)) $ >
  $ wi ph (wbr F G cfldext) $;

--| A sub-sub-division-ring of a field forms a field extension. (Contributed by Thierry Arnoux, 19-Oct-2025.)
theorem fldsdrgfldext2 (ph: wff) (A2 B2 F G H: class):
  $ wceq G (co F A2 cress) $ >
  $ wi ph (wcel F cfield) $ >
  $ wi ph (wcel A2 (cfv F csdrg)) $ >
  $ wi ph (wcel B2 (cfv G csdrg)) $ >
  $ wceq H (co F B2 cress) $ >
  $ wi ph (wbr G H cfldext) $;

--| The multiplicativity formula for degrees of field extensions. Given ` E ` a field extension of ` F ` , itself a field extension of ` K ` , the degree of the extension ` E /FldExt K ` is the product of the degrees of the extensions ` E /FldExt F ` and ` F /FldExt K ` . Proposition 1.2 of [Lang], p. 224. (Contributed by Thierry Arnoux, 30-Jul-2023.)
theorem extdgmul (E F K: class):
  $ wi (wa (wbr E F cfldext) (wbr F K cfldext)) (wceq (co E K cextdg) (co (co E F cextdg) (co F K cextdg) cxmu)) $;

--| A finite field extension is a field extension. (Contributed by Thierry Arnoux, 10-Jan-2026.)
theorem finextfldext (ph: wff) (E F: class):
  $ wi ph (wbr E F cfinext) $ >
  $ wi ph (wbr E F cfldext) $;

--| The extension ` E ` of ` K ` is finite if and only if ` E ` is finite over ` F ` and ` F ` is finite over ` K ` . Corollary 1.3 of [Lang] , p. 225. (Contributed by Thierry Arnoux, 30-Jul-2023.)
theorem finexttrb (E F K: class):
  $ wi (wa (wbr E F cfldext) (wbr F K cfldext)) (wb (wbr E K cfinext) (wa (wbr E F cfinext) (wbr F K cfinext))) $;

--| If the degree of the extension ` E /FldExt F ` is ` 1 ` , then ` E ` and ` F ` are identical. (Contributed by Thierry Arnoux, 6-Aug-2023.)
theorem extdg1id (E F: class):
  $ wi (wa (wbr E F cfldext) (wceq (co E F cextdg) c1)) (wceq E F) $;

--| The degree of the extension ` E /FldExt F ` is ` 1 ` iff ` E ` and ` F ` are the same structure. (Contributed by Thierry Arnoux, 6-Aug-2023.)
theorem extdg1b (E F: class):
  $ wi (wbr E F cfldext) (wb (wceq (co E F cextdg) c1) (wceq E F)) $;

--| A subfield ` F ` extended with a set ` A ` forms a field extension. (Contributed by Thierry Arnoux, 22-Jun-2025.)
theorem fldgenfldext (ph: wff) (A2 B2 E F K L: class):
  $ wceq B2 (cfv E cbs) $ >
  $ wceq K (co E F cress) $ >
  $ wceq L (co E (co E (cun F A2) cfldgen) cress) $ >
  $ wi ph (wcel E cfield) $ >
  $ wi ph (wcel F (cfv E csdrg)) $ >
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wbr L K cfldext) $;

--| The characteristic of a subfield is the same as the characteristic of the larger field. (Contributed by Thierry Arnoux, 20-Aug-2023.)
theorem fldextchr (E F: class):
  $ wi (wbr E F cfldext) (wceq (cfv F cchr) (cfv E cchr)) $;

--| Closure of the subring polynomial evaluation in the field extention. (Contributed by Thierry Arnoux, 2-Apr-2025.)
theorem evls1fldgencl (ph: wff) (A2 B2 P U E F G O: class):
  $ wceq B2 (cfv E cbs) $ >
  $ wceq O (co E F ces1) $ >
  $ wceq P (cfv (co E F cress) cpl1) $ >
  $ wceq U (cfv P cbs) $ >
  $ wi ph (wcel E cfield) $ >
  $ wi ph (wcel F (cfv E csdrg)) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wcel G U) $ >
  $ wi ph (wcel (cfv A2 (cfv G O)) (co E (cun F (csn A2)) cfldgen)) $;

--| The subring algebra of the complex numbers over the real numbers is a left vector space. (Contributed by Thierry Arnoux, 20-Aug-2023.)
theorem ccfldsrarelvec:
  $ wcel (cfv cr (cfv ccnfld csra)) clvec $;

--| The degree of the field extension of the complex numbers over the real numbers is 2. (Suggested by GL, 4-Aug-2023.) (Contributed by Thierry Arnoux, 20-Aug-2023.)
theorem ccfldextdgrr:
  $ wceq (co ccnfld crefld cextdg) c2 $;

--| Lemma for ~ fldextrspunlsp : First direction. Part of the proof of Proposition 5, Chapter 5, of [BourbakiAlg2] p. 116. (Contributed by Thierry Arnoux, 13-Oct-2025.)
theorem fldextrspunlsplem {f2 a b: setvar} (ph: wff) (B2: class) (C: class f2 a b) (P: class) (E: class f2 a b) (F: class) (G: class b) (H: class) (I: class f2 a b) (J: class f2 a) (K L: class) (N: class f2 a b) (X: class f2 b):
  $ wceq K (co L F cress) $ >
  $ wceq I (co L G cress) $ >
  $ wceq J (co L H cress) $ >
  $ wi ph (wcel L cfield) $ >
  $ wi ph (wcel F (cfv I csdrg)) $ >
  $ wi ph (wcel F (cfv J csdrg)) $ >
  $ wi ph (wcel G (cfv L csdrg)) $ >
  $ wi ph (wcel H (cfv L csdrg)) $ >
  $ wceq N (cfv L crgspn) $ >
  $ wceq C (cfv (cun G H) N) $ >
  $ wceq E (co L C cress) $ >
  $ wi ph (wcel B2 (cfv (cfv F (cfv J csra)) clbs)) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wf H G P) $ >
  $ wi ph (wbr P (cfv L c0g) cfsupp) $ >
  $ wi ph (wceq X (co L (cmpt f2 H (co (cfv (cv f2) P) (cv f2) (cfv L cmulr))) cgsu)) $ >
  $ wi ph (wrex a (wa (wbr (cv a) (cfv L c0g) cfsupp) (wceq X (co L (cmpt b B2 (co (cfv (cv b) (cv a)) (cv b) (cfv L cmulr))) cgsu))) (co G B2 cmap)) $;

--| Lemma for ~ fldextrspunfld . The subring generated by the union of two field extensions ` G ` and ` H ` is the vector sub- ` G ` space generated by a basis ` B ` of ` H ` . Part of the proof of Proposition 5, Chapter 5, of [BourbakiAlg2] p. 116. (Contributed by Thierry Arnoux, 13-Oct-2025.)
theorem fldextrspunlsp (ph: wff) (B2 C E F G H I J K L N: class):
  $ wceq K (co L F cress) $ >
  $ wceq I (co L G cress) $ >
  $ wceq J (co L H cress) $ >
  $ wi ph (wcel L cfield) $ >
  $ wi ph (wcel F (cfv I csdrg)) $ >
  $ wi ph (wcel F (cfv J csdrg)) $ >
  $ wi ph (wcel G (cfv L csdrg)) $ >
  $ wi ph (wcel H (cfv L csdrg)) $ >
  $ wceq N (cfv L crgspn) $ >
  $ wceq C (cfv (cun G H) N) $ >
  $ wceq E (co L C cress) $ >
  $ wi ph (wcel B2 (cfv (cfv F (cfv J csra)) clbs)) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wceq C (cfv B2 (cfv (cfv G (cfv L csra)) clspn))) $;

--| Lemma for ~ fldextrspunfld . Part of the proof of Proposition 5, Chapter 5, of [BourbakiAlg2] p. 116. (Contributed by Thierry Arnoux, 13-Oct-2025.)
theorem fldextrspunlem1 (ph: wff) (C E F G H I J K L N: class):
  $ wceq K (co L F cress) $ >
  $ wceq I (co L G cress) $ >
  $ wceq J (co L H cress) $ >
  $ wi ph (wcel L cfield) $ >
  $ wi ph (wcel F (cfv I csdrg)) $ >
  $ wi ph (wcel F (cfv J csdrg)) $ >
  $ wi ph (wcel G (cfv L csdrg)) $ >
  $ wi ph (wcel H (cfv L csdrg)) $ >
  $ wi ph (wcel (co J K cextdg) cn0) $ >
  $ wceq N (cfv L crgspn) $ >
  $ wceq C (cfv (cun G H) N) $ >
  $ wceq E (co L C cress) $ >
  $ wi ph (wbr (cfv (cfv G (cfv E csra)) cldim) (co J K cextdg) cle) $;

--| The ring generated by the union of two field extensions is a field. Part of the proof of Proposition 5, Chapter 5, of [BourbakiAlg2] p. 116. (Contributed by Thierry Arnoux, 13-Oct-2025.)
theorem fldextrspunfld (ph: wff) (C E F G H I J K L N: class):
  $ wceq K (co L F cress) $ >
  $ wceq I (co L G cress) $ >
  $ wceq J (co L H cress) $ >
  $ wi ph (wcel L cfield) $ >
  $ wi ph (wcel F (cfv I csdrg)) $ >
  $ wi ph (wcel F (cfv J csdrg)) $ >
  $ wi ph (wcel G (cfv L csdrg)) $ >
  $ wi ph (wcel H (cfv L csdrg)) $ >
  $ wi ph (wcel (co J K cextdg) cn0) $ >
  $ wceq N (cfv L crgspn) $ >
  $ wceq C (cfv (cun G H) N) $ >
  $ wceq E (co L C cress) $ >
  $ wi ph (wcel E cfield) $;

--| Part of the proof of Proposition 5, Chapter 5, of [BourbakiAlg2] p. 116. (Contributed by Thierry Arnoux, 13-Oct-2025.)
theorem fldextrspunlem2 (ph: wff) (C E F G H I J K L N: class):
  $ wceq K (co L F cress) $ >
  $ wceq I (co L G cress) $ >
  $ wceq J (co L H cress) $ >
  $ wi ph (wcel L cfield) $ >
  $ wi ph (wcel F (cfv I csdrg)) $ >
  $ wi ph (wcel F (cfv J csdrg)) $ >
  $ wi ph (wcel G (cfv L csdrg)) $ >
  $ wi ph (wcel H (cfv L csdrg)) $ >
  $ wi ph (wcel (co J K cextdg) cn0) $ >
  $ wceq N (cfv L crgspn) $ >
  $ wceq C (cfv (cun G H) N) $ >
  $ wceq E (co L C cress) $ >
  $ wi ph (wceq C (co L (cun G H) cfldgen)) $;

--| Inequality involving the degree of two different field extensions ` I ` and ` J ` of a same field ` F ` . Part of the proof of Proposition 5, Chapter 5, of [BourbakiAlg2] p. 116. (Contributed by Thierry Arnoux, 13-Oct-2025.)
theorem fldextrspundgle (ph: wff) (E F G H I J K L: class):
  $ wceq K (co L F cress) $ >
  $ wceq I (co L G cress) $ >
  $ wceq J (co L H cress) $ >
  $ wi ph (wcel L cfield) $ >
  $ wi ph (wcel F (cfv I csdrg)) $ >
  $ wi ph (wcel F (cfv J csdrg)) $ >
  $ wi ph (wcel G (cfv L csdrg)) $ >
  $ wi ph (wcel H (cfv L csdrg)) $ >
  $ wi ph (wcel (co J K cextdg) cn0) $ >
  $ wceq E (co L (co L (cun G H) cfldgen) cress) $ >
  $ wi ph (wbr (co E I cextdg) (co J K cextdg) cle) $;

--| Given two field extensions ` I / K ` and ` J / K ` of the same field ` K ` , ` J / K ` being finite, and the composiste field ` E = I J ` , the degree of the extension of the composite field ` E / K ` is at most the product of the field extension degrees of ` I / K ` and ` J / K ` . (Contributed by Thierry Arnoux, 19-Oct-2025.)
theorem fldextrspundglemul (ph: wff) (E F G H I J K L: class):
  $ wceq K (co L F cress) $ >
  $ wceq I (co L G cress) $ >
  $ wceq J (co L H cress) $ >
  $ wi ph (wcel L cfield) $ >
  $ wi ph (wcel F (cfv I csdrg)) $ >
  $ wi ph (wcel F (cfv J csdrg)) $ >
  $ wi ph (wcel G (cfv L csdrg)) $ >
  $ wi ph (wcel H (cfv L csdrg)) $ >
  $ wi ph (wcel (co J K cextdg) cn0) $ >
  $ wceq E (co L (co L (cun G H) cfldgen) cress) $ >
  $ wi ph (wbr (co E K cextdg) (co (co I K cextdg) (co J K cextdg) cxmu) cle) $;

--| Lemma for ~ fldextrspundgdvds . (Contributed by Thierry Arnoux, 19-Oct-2025.)
theorem fldextrspundgdvdslem (ph: wff) (E F G H I J K L: class):
  $ wceq K (co L F cress) $ >
  $ wceq I (co L G cress) $ >
  $ wceq J (co L H cress) $ >
  $ wi ph (wcel L cfield) $ >
  $ wi ph (wcel F (cfv I csdrg)) $ >
  $ wi ph (wcel F (cfv J csdrg)) $ >
  $ wi ph (wcel G (cfv L csdrg)) $ >
  $ wi ph (wcel H (cfv L csdrg)) $ >
  $ wi ph (wcel (co J K cextdg) cn0) $ >
  $ wceq E (co L (co L (cun G H) cfldgen) cress) $ >
  $ wi ph (wcel (co I K cextdg) cn) $ >
  $ wi ph (wcel (co E I cextdg) cn0) $;

--| Given two finite extensions ` I / K ` and ` J / K ` of the same field ` K ` , the degree of the extension ` I / K ` divides the degree of the extension ` E / K ` , ` E ` being the composite field ` I J ` . (Contributed by Thierry Arnoux, 19-Oct-2025.)
theorem fldextrspundgdvds (ph: wff) (E F G H I J K L: class):
  $ wceq K (co L F cress) $ >
  $ wceq I (co L G cress) $ >
  $ wceq J (co L H cress) $ >
  $ wi ph (wcel L cfield) $ >
  $ wi ph (wcel F (cfv I csdrg)) $ >
  $ wi ph (wcel F (cfv J csdrg)) $ >
  $ wi ph (wcel G (cfv L csdrg)) $ >
  $ wi ph (wcel H (cfv L csdrg)) $ >
  $ wi ph (wcel (co J K cextdg) cn0) $ >
  $ wceq E (co L (co L (cun G H) cfldgen) cress) $ >
  $ wi ph (wcel (co I K cextdg) cn) $ >
  $ wi ph (wbr (co I K cextdg) (co E K cextdg) cdvds) $;

--| Given two field extensions ` I / K ` and ` J / K ` , ` I / K ` being a quadratic extension, and the degree of ` J / K ` being a power of ` 2 ` , the degree of the extension ` E / K ` is a power of 2 , ` E ` being the composite field ` I J ` . (Contributed by Thierry Arnoux, 19-Oct-2025.)
theorem fldext2rspun {n: setvar} (ph: wff) (E: class) (F G H I J: class n) (K: class) (L: class n) (N: class):
  $ wceq K (co L F cress) $ >
  $ wceq I (co L G cress) $ >
  $ wceq J (co L H cress) $ >
  $ wi ph (wcel L cfield) $ >
  $ wi ph (wcel F (cfv I csdrg)) $ >
  $ wi ph (wcel F (cfv J csdrg)) $ >
  $ wi ph (wcel G (cfv L csdrg)) $ >
  $ wi ph (wcel H (cfv L csdrg)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (co I K cextdg) c2) $ >
  $ wi ph (wceq (co J K cextdg) (co c2 N cexp)) $ >
  $ wceq E (co L (co L (cun G H) cfldgen) cress) $ >
  $ wi ph (wrex n (wceq (co E K cextdg) (co c2 (cv n) cexp)) cn0) $;

--| Integral subring of a ring.
term cirng: class;

--| Define the subring of elements of a ring ` r ` integral over a subset ` s ` . (Contributed by Mario Carneiro, 2-Dec-2014.) (Revised by Thierry Arnoux, 28-Jan-2025.)
axiom df_irng {f2 s1 r: setvar}:
  $ wceq cirng (cmpo r s1 cvv cvv (ciun f2 (cfv (co (cv r) (cv s1) cress) cmn1) (cima (ccnv (cfv (cv f2) (co (cv r) (cv s1) ces1))) (csn (cfv (cv r) c0g))))) $;

--| The elements of a field ` R ` integral over a subset ` S ` . In the case of a subfield, those are the algebraic numbers over the field ` S ` within the field ` R ` . That is, the numbers ` X ` which are roots of monic polynomials ` P ( X ) ` with coefficients in ` S ` . (Contributed by Thierry Arnoux, 28-Jan-2025.)
theorem irngval {f2: setvar} (ph: wff) (B2 R S U O: class) (c_0: class f2):
  $ wceq O (co R S ces1) $ >
  $ wceq U (co R S cress) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel R crg) $ >
  $ wi ph (wss S B2) $ >
  $ wi ph (wceq (co R S cirng) (ciun f2 (cfv U cmn1) (cima (ccnv (cfv (cv f2) O)) (csn c_0)))) $;

--| Property for an element ` X ` of a field ` R ` to be integral over a subring ` S ` . (Contributed by Thierry Arnoux, 28-Jan-2025.)
theorem elirng {f2: setvar} (ph: wff) (B2 R S U O X: class) (c_0: class f2):
  $ wceq O (co R S ces1) $ >
  $ wceq U (co R S cress) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S (cfv R csubrg)) $ >
  $ wi ph (wb (wcel X (co R S cirng)) (wa (wcel X B2) (wrex f2 (wceq (cfv X (cfv (cv f2) O)) c_0) (cfv U cmn1)))) $;

--| All elements of a subring ` S ` are integral over ` S ` . This is only true in the case of a nonzero ring, since there are no integral elements in a zero ring (see ~ 0ringirng ). (Contributed by Thierry Arnoux, 28-Jan-2025.)
theorem irngss (ph: wff) (B2 R S U O c_0: class):
  $ wceq O (co R S ces1) $ >
  $ wceq U (co R S cress) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S (cfv R csubrg)) $ >
  $ wi ph (wcel R cnzr) $ >
  $ wi ph (wss S (co R S cirng)) $;

--| An integral element is an element of the base set. (Contributed by Thierry Arnoux, 28-Jan-2025.)
theorem irngssv (ph: wff) (B2 R S U O c_0: class):
  $ wceq O (co R S ces1) $ >
  $ wceq U (co R S cress) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S (cfv R csubrg)) $ >
  $ wi ph (wss (co R S cirng) B2) $;

--| A zero ring ` R ` has no integral elements. (Contributed by Thierry Arnoux, 5-Feb-2025.)
theorem _0ringirng (ph: wff) (B2 R S U O c_0: class):
  $ wceq O (co R S ces1) $ >
  $ wceq U (co R S cress) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S (cfv R csubrg)) $ >
  $ wi ph (wn (wcel R cnzr)) $ >
  $ wi ph (wceq (co R S cirng) c0) $;

--| In the case of a field ` E ` , a root ` X ` of some nonzero polynomial ` P ` with coefficients in a subfield ` F ` is integral over ` F ` . (Contributed by Thierry Arnoux, 5-Feb-2025.)
theorem irngnzply1lem (ph: wff) (B2 P E F O X c_0 Z: class):
  $ wceq O (co E F ces1) $ >
  $ wceq Z (cfv (cfv E cpl1) c0g) $ >
  $ wceq c_0 (cfv E c0g) $ >
  $ wi ph (wcel E cfield) $ >
  $ wi ph (wcel F (cfv E csdrg)) $ >
  $ wceq B2 (cfv E cbs) $ >
  $ wi ph (wcel P (cdm O)) $ >
  $ wi ph (wne P Z) $ >
  $ wi ph (wceq (cfv X (cfv P O)) c_0) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel X (co E F cirng)) $;

--| In the case of a field ` E ` , the roots of nonzero polynomials ` p ` with coefficients in a subfield ` F ` are exactly the integral elements over ` F ` . Roots of nonzero polynomials are called algebraic numbers, so this shows that in the case of a field, elements integral over ` F ` are exactly the algebraic numbers. In this formula, ` dom O ` represents the polynomials, and ` Z ` the zero polynomial. (Contributed by Thierry Arnoux, 5-Feb-2025.)
theorem irngnzply1 {p: setvar} (ph: wff) (E F O: class) (c_0 Z: class p):
  $ wceq O (co E F ces1) $ >
  $ wceq Z (cfv (cfv E cpl1) c0g) $ >
  $ wceq c_0 (cfv E c0g) $ >
  $ wi ph (wcel E cfield) $ >
  $ wi ph (wcel F (cfv E csdrg)) $ >
  $ wi ph (wceq (co E F cirng) (ciun p (cdif (cdm O) (csn Z)) (cima (ccnv (cfv (cv p) O)) (csn c_0)))) $;

--| Lemma for ~ extdgfialg . (Contributed by Thierry Arnoux, 10-Jan-2026.)
theorem extdgfialglem1 {n a: setvar} (ph: wff) (B2 D: class) (c_x: class a) (E F G X: class) (Z: class a):
  $ wceq B2 (cfv E cbs) $ >
  $ wceq D (cfv (cfv F (cfv E csra)) cldim) $ >
  $ wi ph (wcel E cfield) $ >
  $ wi ph (wcel F (cfv E csdrg)) $ >
  $ wi ph (wcel D cn0) $ >
  $ wceq Z (cfv E c0g) $ >
  $ wceq c_x (cfv E cmulr) $ >
  $ wceq G (cmpt n (co cc0 D cfz) (co (cv n) X (cfv (cfv (cfv F (cfv E csra)) cmgp) cmg))) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wrex a (wa (wbr (cv a) Z cfsupp) (wa (wceq (co E (co (cv a) G (cof c_x)) cgsu) Z) (wne (cv a) (cxp (co cc0 D cfz) (csn Z))))) (co F (co cc0 D cfz) cmap)) $;

--| Lemma for ~ extdgfialg . (Contributed by Thierry Arnoux, 10-Jan-2026.)
theorem extdgfialglem2 {n: setvar} (ph: wff) (A2 B2 D c_x E F G X Z: class):
  $ wceq B2 (cfv E cbs) $ >
  $ wceq D (cfv (cfv F (cfv E csra)) cldim) $ >
  $ wi ph (wcel E cfield) $ >
  $ wi ph (wcel F (cfv E csdrg)) $ >
  $ wi ph (wcel D cn0) $ >
  $ wceq Z (cfv E c0g) $ >
  $ wceq c_x (cfv E cmulr) $ >
  $ wceq G (cmpt n (co cc0 D cfz) (co (cv n) X (cfv (cfv (cfv F (cfv E csra)) cmgp) cmg))) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wf (co cc0 D cfz) F A2) $ >
  $ wi ph (wbr A2 Z cfsupp) $ >
  $ wi ph (wceq (co E (co A2 G (cof c_x)) cgsu) Z) $ >
  $ wi ph (wne A2 (cxp (co cc0 D cfz) (csn Z))) $ >
  $ wi ph (wcel X (co E F cirng)) $;

--| A finite field extension ` E / F ` is algebraic. Part of the proof of Proposition 1.1 of [Lang], p. 224. (Contributed by Thierry Arnoux, 10-Jan-2026.)
theorem extdgfialg (ph: wff) (B2 D E F: class):
  $ wceq B2 (cfv E cbs) $ >
  $ wceq D (cfv (cfv F (cfv E csra)) cldim) $ >
  $ wi ph (wcel E cfield) $ >
  $ wi ph (wcel F (cfv E csdrg)) $ >
  $ wi ph (wcel D cn0) $ >
  $ wi ph (wceq (co E F cirng) B2) $;

--| Syntax for the algebraic field extension relation.
term calgext: class;

--| Definition of the algebraic extension relation. (Contributed by Thierry Arnoux, 29-Jul-2023.)
axiom df_algext {e f2: setvar}:
  $ wceq calgext (copab e f2 (wa (wbr (cv e) (cv f2) cfldext) (wceq (co (cv e) (cfv (cv f2) cbs) cirng) (cfv (cv e) cbs)))) $;

--| Express the fact that a field extension ` E / F ` is algebraic. (Contributed by Thierry Arnoux, 10-Jan-2026.)
theorem bralgext (ph: wff) (B2 C E F V: class):
  $ wceq B2 (cfv E cbs) $ >
  $ wceq C (cfv F cbs) $ >
  $ wi ph (wcel E V) $ >
  $ wi ph (wcel F V) $ >
  $ wi ph (wb (wbr E F calgext) (wa (wbr E F cfldext) (wceq (co E C cirng) B2))) $;

--| A finite field extension is algebraic. Proposition 1.1 of [Lang], p. 224. (Contributed by Thierry Arnoux, 10-Jan-2026.)
theorem finextalg (ph: wff) (E F: class):
  $ wi ph (wbr E F cfinext) $ >
  $ wi ph (wbr E F calgext) $;

--| Extend class notation with the minimal polynomial builder function.
term cminply: class;

--| Define the minimal polynomial builder function. (Contributed by Thierry Arnoux, 19-Jan-2025.)
axiom df_minply {x3 e f2 p: setvar}:
  $ wceq cminply (cmpo e f2 cvv cvv (cmpt x3 (cfv (cv e) cbs) (cfv (crab p (wceq (cfv (cv x3) (cfv (cv p) (co (cv e) (cv f2) ces1))) (cfv (cv e) c0g)) (cdm (co (cv e) (cv f2) ces1))) (cfv (co (cv e) (cv f2) cress) cig1p)))) $;

--| Write the set ` Q ` of polynomials annihilating an element ` A ` as the kernel of the ring homomorphism ` F ` mapping polynomials ` p ` to their subring evaluation at a given point ` A ` . (Contributed by Thierry Arnoux, 9-Feb-2025.)
theorem ply1annidllem {q p: setvar} (ph: wff) (A2: class) (B2: class q) (P: class) (Q: class q p) (R S: class q) (F: class p) (O: class) (c_0: class p):
  $ wceq O (co R S ces1) $ >
  $ wceq P (cfv (co R S cress) cpl1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S (cfv R csubrg)) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq Q (crab q (wceq (cfv A2 (cfv (cv q) O)) c_0) (cdm O)) $ >
  $ wceq F (cmpt p (cfv P cbs) (cfv A2 (cfv (cv p) O))) $ >
  $ wi ph (wceq Q (cima (ccnv F) (csn c_0))) $;

--| The set ` Q ` of polynomials annihilating an element ` A ` forms an ideal. (Contributed by Thierry Arnoux, 9-Feb-2025.)
theorem ply1annidl {q: setvar} (ph: wff) (A2: class) (B2: class q) (P: class) (Q R S: class q) (O c_0: class):
  $ wceq O (co R S ces1) $ >
  $ wceq P (cfv (co R S cress) cpl1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S (cfv R csubrg)) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq Q (crab q (wceq (cfv A2 (cfv (cv q) O)) c_0) (cdm O)) $ >
  $ wi ph (wcel Q (cfv P clidl)) $;

--| The set ` Q ` of polynomials annihilating an element ` A ` is not the whole polynomial ring. (Contributed by Thierry Arnoux, 22-Mar-2025.)
theorem ply1annnr {q: setvar} (ph: wff) (A2: class) (B2: class q) (P: class) (Q: class q) (R: class) (S U: class q) (O c_0: class):
  $ wceq O (co R S ces1) $ >
  $ wceq P (cfv (co R S cress) cpl1) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wi ph (wcel R ccrg) $ >
  $ wi ph (wcel S (cfv R csubrg)) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq Q (crab q (wceq (cfv A2 (cfv (cv q) O)) c_0) (cdm O)) $ >
  $ wceq U (cfv P cbs) $ >
  $ wi ph (wcel R cnzr) $ >
  $ wi ph (wne Q U) $;

--| The ideal ` Q ` of polynomials annihilating an element ` A ` is generated by the ideal's canonical generator. (Contributed by Thierry Arnoux, 9-Feb-2025.)
theorem ply1annig1p {q: setvar} (ph: wff) (A2: class) (B2: class q) (P: class) (Q E F G K: class q) (O c_0: class):
  $ wceq O (co E F ces1) $ >
  $ wceq P (cfv (co E F cress) cpl1) $ >
  $ wceq B2 (cfv E cbs) $ >
  $ wi ph (wcel E cfield) $ >
  $ wi ph (wcel F (cfv E csdrg)) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wceq c_0 (cfv E c0g) $ >
  $ wceq Q (crab q (wceq (cfv A2 (cfv (cv q) O)) c_0) (cdm O)) $ >
  $ wceq K (cfv P crsp) $ >
  $ wceq G (cfv (co E F cress) cig1p) $ >
  $ wi ph (wceq Q (cfv (csn (cfv Q G)) K)) $;

--| Expand the value of the minimal polynomial ` ( M `` A ) ` for a given element ` A ` . It is defined as the unique monic polynomial of minimal degree which annihilates ` A ` . By ~ ply1annig1p , that polynomial generates the ideal of the annihilators of ` A ` . (Contributed by Thierry Arnoux, 9-Feb-2025.)
theorem minplyval {q: setvar} (ph: wff) (A2: class) (B2: class q) (P: class) (Q: class q) (E F: class) (G K M: class q) (O c_0: class):
  $ wceq O (co E F ces1) $ >
  $ wceq P (cfv (co E F cress) cpl1) $ >
  $ wceq B2 (cfv E cbs) $ >
  $ wi ph (wcel E cfield) $ >
  $ wi ph (wcel F (cfv E csdrg)) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wceq c_0 (cfv E c0g) $ >
  $ wceq Q (crab q (wceq (cfv A2 (cfv (cv q) O)) c_0) (cdm O)) $ >
  $ wceq K (cfv P crsp) $ >
  $ wceq G (cfv (co E F cress) cig1p) $ >
  $ wceq M (co E F cminply) $ >
  $ wi ph (wceq (cfv A2 M) (cfv Q G)) $;

--| The minimal polynomial is a polynomial. (Contributed by Thierry Arnoux, 22-Mar-2025.)
theorem minplycl {q: setvar} (ph: wff) (A2: class) (B2: class q) (P: class) (Q: class q) (E F: class) (G K M: class q) (O c_0: class):
  $ wceq O (co E F ces1) $ >
  $ wceq P (cfv (co E F cress) cpl1) $ >
  $ wceq B2 (cfv E cbs) $ >
  $ wi ph (wcel E cfield) $ >
  $ wi ph (wcel F (cfv E csdrg)) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wceq c_0 (cfv E c0g) $ >
  $ wceq Q (crab q (wceq (cfv A2 (cfv (cv q) O)) c_0) (cdm O)) $ >
  $ wceq K (cfv P crsp) $ >
  $ wceq G (cfv (co E F cress) cig1p) $ >
  $ wceq M (co E F cminply) $ >
  $ wi ph (wcel (cfv A2 M) (cfv P cbs)) $;

--| The set ` Q ` of polynomials annihilating an element ` A ` is a prime ideal. (Contributed by Thierry Arnoux, 9-Feb-2025.)
theorem ply1annprmidl {q: setvar} (ph: wff) (A2: class) (B2: class q) (P: class) (Q E F: class q) (O c_0: class):
  $ wceq O (co E F ces1) $ >
  $ wceq P (cfv (co E F cress) cpl1) $ >
  $ wceq B2 (cfv E cbs) $ >
  $ wi ph (wcel E cfield) $ >
  $ wi ph (wcel F (cfv E csdrg)) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wceq c_0 (cfv E c0g) $ >
  $ wceq Q (crab q (wceq (cfv A2 (cfv (cv q) O)) c_0) (cdm O)) $ >
  $ wi ph (wcel Q (cfv P cprmidl)) $;

--| The minimal polynomial of ` A ` is minimal among the nonzero annihilators of ` A ` with regard to degree. (Contributed by Thierry Arnoux, 22-Jun-2025.)
theorem minplymindeg (ph: wff) (A2 B2 D P U E F H M O c_0 Z: class):
  $ wceq O (co E F ces1) $ >
  $ wceq P (cfv (co E F cress) cpl1) $ >
  $ wceq B2 (cfv E cbs) $ >
  $ wi ph (wcel E cfield) $ >
  $ wi ph (wcel F (cfv E csdrg)) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wceq c_0 (cfv E c0g) $ >
  $ wceq M (co E F cminply) $ >
  $ wceq D (cfv (co E F cress) cdg1) $ >
  $ wceq Z (cfv P c0g) $ >
  $ wceq U (cfv P cbs) $ >
  $ wi ph (wceq (cfv A2 (cfv H O)) c_0) $ >
  $ wi ph (wcel H U) $ >
  $ wi ph (wne H Z) $ >
  $ wi ph (wbr (cfv (cfv A2 M) D) (cfv H D) cle) $;

--| The minimal polynomial for ` A ` annihilates ` A ` . (Contributed by Thierry Arnoux, 25-Apr-2025.)
theorem minplyann (ph: wff) (A2 B2 P E F M O c_0: class):
  $ wceq O (co E F ces1) $ >
  $ wceq P (cfv (co E F cress) cpl1) $ >
  $ wceq B2 (cfv E cbs) $ >
  $ wi ph (wcel E cfield) $ >
  $ wi ph (wcel F (cfv E csdrg)) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wceq c_0 (cfv E c0g) $ >
  $ wceq M (co E F cminply) $ >
  $ wi ph (wceq (cfv A2 (cfv (cfv A2 M) O)) c_0) $;

--| Lemma for ~ minplyirred . (Contributed by Thierry Arnoux, 22-Mar-2025.)
theorem minplyirredlem (ph: wff) (A2 B2 P E F G H M O Z: class):
  $ wceq O (co E F ces1) $ >
  $ wceq P (cfv (co E F cress) cpl1) $ >
  $ wceq B2 (cfv E cbs) $ >
  $ wi ph (wcel E cfield) $ >
  $ wi ph (wcel F (cfv E csdrg)) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wceq M (co E F cminply) $ >
  $ wceq Z (cfv P c0g) $ >
  $ wi ph (wne (cfv A2 M) Z) $ >
  $ wi ph (wcel G (cfv P cbs)) $ >
  $ wi ph (wcel H (cfv P cbs)) $ >
  $ wi ph (wceq (co G H (cfv P cmulr)) (cfv A2 M)) $ >
  $ wi ph (wceq (cfv A2 (cfv G O)) (cfv E c0g)) $ >
  $ wi ph (wne G Z) $ >
  $ wi ph (wne H Z) $ >
  $ wi ph (wcel H (cfv P cui)) $;

--| A nonzero minimal polynomial is irreducible. (Contributed by Thierry Arnoux, 22-Mar-2025.)
theorem minplyirred (ph: wff) (A2 B2 P E F M O Z: class):
  $ wceq O (co E F ces1) $ >
  $ wceq P (cfv (co E F cress) cpl1) $ >
  $ wceq B2 (cfv E cbs) $ >
  $ wi ph (wcel E cfield) $ >
  $ wi ph (wcel F (cfv E csdrg)) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wceq M (co E F cminply) $ >
  $ wceq Z (cfv P c0g) $ >
  $ wi ph (wne (cfv A2 M) Z) $ >
  $ wi ph (wcel (cfv A2 M) (cfv P cir)) $;

--| Integral elements have nonzero minimal polynomials. (Contributed by Thierry Arnoux, 22-Mar-2025.)
theorem irngnminplynz (ph: wff) (A2 E F M Z: class):
  $ wceq Z (cfv (cfv E cpl1) c0g) $ >
  $ wi ph (wcel E cfield) $ >
  $ wi ph (wcel F (cfv E csdrg)) $ >
  $ wceq M (co E F cminply) $ >
  $ wi ph (wcel A2 (co E F cirng)) $ >
  $ wi ph (wne (cfv A2 M) Z) $;

--| A minimal polynomial is monic. (Contributed by Thierry Arnoux, 2-Apr-2025.)
theorem minplym1p (ph: wff) (A2 U E F M Z: class):
  $ wceq Z (cfv (cfv E cpl1) c0g) $ >
  $ wi ph (wcel E cfield) $ >
  $ wi ph (wcel F (cfv E csdrg)) $ >
  $ wceq M (co E F cminply) $ >
  $ wi ph (wcel A2 (co E F cirng)) $ >
  $ wceq U (cfv (co E F cress) cmn1) $ >
  $ wi ph (wcel (cfv A2 M) U) $;

--| If a minimal polynomial is nonzero, then it is monic. (Contributed by Thierry Arnoux, 26-Oct-2025.)
theorem minplynzm1p (ph: wff) (A2 B2 U E F M Z: class):
  $ wceq B2 (cfv E cbs) $ >
  $ wceq Z (cfv (cfv E cpl1) c0g) $ >
  $ wi ph (wcel E cfield) $ >
  $ wi ph (wcel F (cfv E csdrg)) $ >
  $ wceq M (co E F cminply) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wne (cfv A2 M) Z) $ >
  $ wceq U (cfv (co E F cress) cmn1) $ >
  $ wi ph (wcel (cfv A2 M) U) $;

--| If the minimal polynomial ` F ` of an element ` X ` of a field ` R ` has nonnegative degree, then ` X ` is integral. (Contributed by Thierry Arnoux, 26-Oct-2025.)
theorem minplyelirng (ph: wff) (A2 B2 D R S M: class):
  $ wceq B2 (cfv R cbs) $ >
  $ wceq M (co R S cminply) $ >
  $ wceq D (cfv (co R S cress) cdg1) $ >
  $ wi ph (wcel R cfield) $ >
  $ wi ph (wcel S (cfv R csdrg)) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wcel (cfv (cfv A2 M) D) cn0) $ >
  $ wi ph (wcel A2 (co R S cirng)) $;

--| An irreducible, monic, annihilating polynomial is _the_ minimal polynomial. (Contributed by Thierry Arnoux, 27-Apr-2025.)
theorem irredminply (ph: wff) (A2 B2 P E F G M O c_0 Z: class):
  $ wceq O (co E F ces1) $ >
  $ wceq P (cfv (co E F cress) cpl1) $ >
  $ wceq B2 (cfv E cbs) $ >
  $ wi ph (wcel E cfield) $ >
  $ wi ph (wcel F (cfv E csdrg)) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wceq c_0 (cfv E c0g) $ >
  $ wceq M (co E F cminply) $ >
  $ wceq Z (cfv P c0g) $ >
  $ wi ph (wceq (cfv A2 (cfv G O)) c_0) $ >
  $ wi ph (wcel G (cfv P cir)) $ >
  $ wi ph (wcel G (cfv (co E F cress) cmn1)) $ >
  $ wi ph (wceq G (cfv A2 M)) $;

--| Lemma for ~ algextdeg . (Contributed by Thierry Arnoux, 2-Apr-2025.)
theorem algextdeglem1 (ph: wff) (A2 D E F K L M: class):
  $ wceq K (co E F cress) $ >
  $ wceq L (co E (co E (cun F (csn A2)) cfldgen) cress) $ >
  $ wceq D (cfv E cdg1) $ >
  $ wceq M (co E F cminply) $ >
  $ wi ph (wcel E cfield) $ >
  $ wi ph (wcel F (cfv E csdrg)) $ >
  $ wi ph (wcel A2 (co E F cirng)) $ >
  $ wi ph (wceq (co L F cress) K) $;

--| Lemma for ~ algextdeg . Both the ring of polynomials ` P ` and the field ` L ` generated by ` K ` and the algebraic element ` A ` can be considered as modules over the elements of ` F ` . Then, the evaluation map ` G ` , mapping polynomials to their evaluation at ` A ` , is a module homomorphism between those modules. (Contributed by Thierry Arnoux, 2-Apr-2025.)
theorem algextdeglem2 {x3 p: setvar} (ph: wff) (A2: class x3) (D: class x3 p) (P Q U: class) (E: class x3) (F G J: class) (K: class x3) (L: class) (M: class x3 p) (N: class p) (O: class x3) (Z: class):
  $ wceq K (co E F cress) $ >
  $ wceq L (co E (co E (cun F (csn A2)) cfldgen) cress) $ >
  $ wceq D (cfv E cdg1) $ >
  $ wceq M (co E F cminply) $ >
  $ wi ph (wcel E cfield) $ >
  $ wi ph (wcel F (cfv E csdrg)) $ >
  $ wi ph (wcel A2 (co E F cirng)) $ >
  $ wceq O (co E F ces1) $ >
  $ wceq P (cfv K cpl1) $ >
  $ wceq U (cfv P cbs) $ >
  $ wceq G (cmpt p U (cfv A2 (cfv (cv p) O))) $ >
  $ wceq N (cmpt x3 U (cec (cv x3) (co P Z cqg))) $ >
  $ wceq Z (cima (ccnv G) (csn (cfv L c0g))) $ >
  $ wceq Q (co P (co P Z cqg) cqus) $ >
  $ wceq J (cmpt p (cfv Q cbs) (cuni (cima G (cv p)))) $ >
  $ wi ph (wcel G (co P (cfv F (cfv L csra)) clmhm)) $;

--| Lemma for ~ algextdeg . The quotient ` P / Z ` of the vector space ` P ` of polynomials by the subspace ` Z ` of polynomials annihilating ` A ` is itself a vector space. (Contributed by Thierry Arnoux, 2-Apr-2025.)
theorem algextdeglem3 {x3 p: setvar} (ph: wff) (A2: class x3) (D: class x3 p) (P Q U: class) (E: class x3) (F G J: class) (K: class x3) (L: class) (M: class x3 p) (N: class p) (O: class x3) (Z: class):
  $ wceq K (co E F cress) $ >
  $ wceq L (co E (co E (cun F (csn A2)) cfldgen) cress) $ >
  $ wceq D (cfv E cdg1) $ >
  $ wceq M (co E F cminply) $ >
  $ wi ph (wcel E cfield) $ >
  $ wi ph (wcel F (cfv E csdrg)) $ >
  $ wi ph (wcel A2 (co E F cirng)) $ >
  $ wceq O (co E F ces1) $ >
  $ wceq P (cfv K cpl1) $ >
  $ wceq U (cfv P cbs) $ >
  $ wceq G (cmpt p U (cfv A2 (cfv (cv p) O))) $ >
  $ wceq N (cmpt x3 U (cec (cv x3) (co P Z cqg))) $ >
  $ wceq Z (cima (ccnv G) (csn (cfv L c0g))) $ >
  $ wceq Q (co P (co P Z cqg) cqus) $ >
  $ wceq J (cmpt p (cfv Q cbs) (cuni (cima G (cv p)))) $ >
  $ wi ph (wcel Q clvec) $;

--| Lemma for ~ algextdeg . By ~ lmhmqusker , the surjective module homomorphism ` G ` described in ~ algextdeglem2 induces an isomorphism with the quotient space. Therefore, the dimension of that quotient space ` P / Z ` is the degree of the algebraic field extension. (Contributed by Thierry Arnoux, 2-Apr-2025.)
theorem algextdeglem4 {x3 p: setvar} (ph: wff) (A2: class x3) (D: class x3 p) (P Q U: class) (E: class x3) (F G J: class) (K: class x3) (L: class) (M: class x3 p) (N: class p) (O: class x3) (Z: class):
  $ wceq K (co E F cress) $ >
  $ wceq L (co E (co E (cun F (csn A2)) cfldgen) cress) $ >
  $ wceq D (cfv E cdg1) $ >
  $ wceq M (co E F cminply) $ >
  $ wi ph (wcel E cfield) $ >
  $ wi ph (wcel F (cfv E csdrg)) $ >
  $ wi ph (wcel A2 (co E F cirng)) $ >
  $ wceq O (co E F ces1) $ >
  $ wceq P (cfv K cpl1) $ >
  $ wceq U (cfv P cbs) $ >
  $ wceq G (cmpt p U (cfv A2 (cfv (cv p) O))) $ >
  $ wceq N (cmpt x3 U (cec (cv x3) (co P Z cqg))) $ >
  $ wceq Z (cima (ccnv G) (csn (cfv L c0g))) $ >
  $ wceq Q (co P (co P Z cqg) cqus) $ >
  $ wceq J (cmpt p (cfv Q cbs) (cuni (cima G (cv p)))) $ >
  $ wi ph (wceq (cfv Q cldim) (co L K cextdg)) $;

--| Lemma for ~ algextdeg . The subspace ` Z ` of annihilators of ` A ` is a principal ideal generated by the minimal polynomial. (Contributed by Thierry Arnoux, 2-Apr-2025.)
theorem algextdeglem5 {x3 p: setvar} (ph: wff) (A2: class x3) (D: class x3 p) (P Q U: class) (E: class x3) (F G J: class) (K: class x3) (L: class) (M: class x3 p) (N: class p) (O: class x3) (Z: class):
  $ wceq K (co E F cress) $ >
  $ wceq L (co E (co E (cun F (csn A2)) cfldgen) cress) $ >
  $ wceq D (cfv E cdg1) $ >
  $ wceq M (co E F cminply) $ >
  $ wi ph (wcel E cfield) $ >
  $ wi ph (wcel F (cfv E csdrg)) $ >
  $ wi ph (wcel A2 (co E F cirng)) $ >
  $ wceq O (co E F ces1) $ >
  $ wceq P (cfv K cpl1) $ >
  $ wceq U (cfv P cbs) $ >
  $ wceq G (cmpt p U (cfv A2 (cfv (cv p) O))) $ >
  $ wceq N (cmpt x3 U (cec (cv x3) (co P Z cqg))) $ >
  $ wceq Z (cima (ccnv G) (csn (cfv L c0g))) $ >
  $ wceq Q (co P (co P Z cqg) cqus) $ >
  $ wceq J (cmpt p (cfv Q cbs) (cuni (cima G (cv p)))) $ >
  $ wi ph (wceq Z (cfv (csn (cfv A2 M)) (cfv P crsp))) $;

--| Lemma for ~ algextdeg . By ~ r1pquslmic , the univariate polynomial remainder ring ` ( H "s P ) ` is isomorphic with the quotient ring ` Q ` . (Contributed by Thierry Arnoux, 2-Apr-2025.)
theorem algextdeglem6 {x3 p: setvar} (ph: wff) (A2: class x3) (D: class x3 p) (P Q: class) (R: class x3) (U: class) (E: class x3) (F G: class) (H: class x3) (J: class) (K: class x3) (L: class) (M: class x3) (N: class p) (O: class x3) (Z: class):
  $ wceq K (co E F cress) $ >
  $ wceq L (co E (co E (cun F (csn A2)) cfldgen) cress) $ >
  $ wceq D (cfv E cdg1) $ >
  $ wceq M (co E F cminply) $ >
  $ wi ph (wcel E cfield) $ >
  $ wi ph (wcel F (cfv E csdrg)) $ >
  $ wi ph (wcel A2 (co E F cirng)) $ >
  $ wceq O (co E F ces1) $ >
  $ wceq P (cfv K cpl1) $ >
  $ wceq U (cfv P cbs) $ >
  $ wceq G (cmpt p U (cfv A2 (cfv (cv p) O))) $ >
  $ wceq N (cmpt x3 U (cec (cv x3) (co P Z cqg))) $ >
  $ wceq Z (cima (ccnv G) (csn (cfv L c0g))) $ >
  $ wceq Q (co P (co P Z cqg) cqus) $ >
  $ wceq J (cmpt p (cfv Q cbs) (cuni (cima G (cv p)))) $ >
  $ wceq R (cfv K cr1p) $ >
  $ wceq H (cmpt p U (co (cv p) (cfv A2 M) R)) $ >
  $ wi ph (wceq (cfv Q cldim) (cfv (co H P cimas) cldim)) $;

--| Lemma for ~ algextdeg . The polynomials ` X ` of lower degree than the minimal polynomial are left unchanged when taking the remainder of the division by that minimal polynomial. (Contributed by Thierry Arnoux, 2-Apr-2025.)
theorem algextdeglem7 {x3 p: setvar} (ph: wff x3) (A2: class x3) (D: class x3 p) (P: class x3) (Q: class x3 p) (R: class x3) (T: class x3 p) (U E F: class x3) (G H J K L: class x3 p) (M: class x3) (N: class x3 p) (O X: class x3) (Z: class x3 p):
  $ wceq K (co E F cress) $ >
  $ wceq L (co E (co E (cun F (csn A2)) cfldgen) cress) $ >
  $ wceq D (cfv E cdg1) $ >
  $ wceq M (co E F cminply) $ >
  $ wi ph (wcel E cfield) $ >
  $ wi ph (wcel F (cfv E csdrg)) $ >
  $ wi ph (wcel A2 (co E F cirng)) $ >
  $ wceq O (co E F ces1) $ >
  $ wceq P (cfv K cpl1) $ >
  $ wceq U (cfv P cbs) $ >
  $ wceq G (cmpt p U (cfv A2 (cfv (cv p) O))) $ >
  $ wceq N (cmpt x3 U (cec (cv x3) (co P Z cqg))) $ >
  $ wceq Z (cima (ccnv G) (csn (cfv L c0g))) $ >
  $ wceq Q (co P (co P Z cqg) cqus) $ >
  $ wceq J (cmpt p (cfv Q cbs) (cuni (cima G (cv p)))) $ >
  $ wceq R (cfv K cr1p) $ >
  $ wceq H (cmpt p U (co (cv p) (cfv A2 M) R)) $ >
  $ wceq T (cima (ccnv (cfv K cdg1)) (co cmnf (cfv (cfv A2 M) D) cico)) $ >
  $ wi ph (wcel X U) $ >
  $ wi ph (wb (wcel X T) (wceq (cfv X H) X)) $;

--| Lemma for ~ algextdeg . The dimension of the univariate polynomial remainder ring ` ( H "s P ) ` is the degree of the minimal polynomial. (Contributed by Thierry Arnoux, 2-Apr-2025.)
theorem algextdeglem8 {x3 p: setvar} (ph: wff) (A2: class x3) (D: class x3 p) (P Q: class) (R: class x3) (T U: class) (E: class x3) (F G H J: class) (K: class x3) (L: class) (M: class x3) (N: class p) (O: class x3) (Z: class):
  $ wceq K (co E F cress) $ >
  $ wceq L (co E (co E (cun F (csn A2)) cfldgen) cress) $ >
  $ wceq D (cfv E cdg1) $ >
  $ wceq M (co E F cminply) $ >
  $ wi ph (wcel E cfield) $ >
  $ wi ph (wcel F (cfv E csdrg)) $ >
  $ wi ph (wcel A2 (co E F cirng)) $ >
  $ wceq O (co E F ces1) $ >
  $ wceq P (cfv K cpl1) $ >
  $ wceq U (cfv P cbs) $ >
  $ wceq G (cmpt p U (cfv A2 (cfv (cv p) O))) $ >
  $ wceq N (cmpt x3 U (cec (cv x3) (co P Z cqg))) $ >
  $ wceq Z (cima (ccnv G) (csn (cfv L c0g))) $ >
  $ wceq Q (co P (co P Z cqg) cqus) $ >
  $ wceq J (cmpt p (cfv Q cbs) (cuni (cima G (cv p)))) $ >
  $ wceq R (cfv K cr1p) $ >
  $ wceq H (cmpt p U (co (cv p) (cfv A2 M) R)) $ >
  $ wceq T (cima (ccnv (cfv K cdg1)) (co cmnf (cfv (cfv A2 M) D) cico)) $ >
  $ wi ph (wceq (cfv (co H P cimas) cldim) (cfv (cfv A2 M) D)) $;

--| The degree of an algebraic field extension (noted ` [ L : K ] ` ) is the degree of the minimal polynomial ` M ( A ) ` , whereas ` L ` is the field generated by ` K ` and the algebraic element ` A ` . Part of Proposition 1.4 of [Lang], p. 225. (Contributed by Thierry Arnoux, 2-Apr-2025.)
theorem algextdeg (ph: wff) (A2 D E F K L M: class):
  $ wceq K (co E F cress) $ >
  $ wceq L (co E (co E (cun F (csn A2)) cfldgen) cress) $ >
  $ wceq D (cfv E cdg1) $ >
  $ wceq M (co E F cminply) $ >
  $ wi ph (wcel E cfield) $ >
  $ wi ph (wcel F (cfv E csdrg)) $ >
  $ wi ph (wcel A2 (co E F cirng)) $ >
  $ wi ph (wceq (co L K cextdg) (cfv (cfv A2 M) D)) $;

--| Lemma for ~ rtelextdg2 : If an element ` X ` is a solution of a quadratic equation, then the degree of its field extension is at most 2. (Contributed by Thierry Arnoux, 22-Jun-2025.)
theorem rtelextdg2lem (ph: wff) (A2 B2 P c_pl c_po c_x c_xo U E c_ex F G K L c_an V X Y c_0: class):
  $ wceq K (co E F cress) $ >
  $ wceq L (co E (co E (cun F (csn X)) cfldgen) cress) $ >
  $ wceq c_0 (cfv E c0g) $ >
  $ wceq P (cfv K cpl1) $ >
  $ wceq V (cfv E cbs) $ >
  $ wceq c_x (cfv E cmulr) $ >
  $ wceq c_pl (cfv E cplusg) $ >
  $ wceq c_ex (cfv (cfv E cmgp) cmg) $ >
  $ wi ph (wcel E cfield) $ >
  $ wi ph (wcel F (cfv E csdrg)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel A2 F) $ >
  $ wi ph (wcel B2 F) $ >
  $ wi ph (wceq (co (co c2 X c_ex) (co (co A2 X c_x) B2 c_pl) c_pl) c_0) $ >
  $ wceq Y (cfv K cv1) $ >
  $ wceq c_po (cfv P cplusg) $ >
  $ wceq c_xo (cfv P cmulr) $ >
  $ wceq c_an (cfv (cfv P cmgp) cmg) $ >
  $ wceq U (cfv P cascl) $ >
  $ wceq G (co (co c2 Y c_an) (co (co (cfv A2 U) Y c_xo) (cfv B2 U) c_po) c_po) $ >
  $ wi ph (wbr (co L K cextdg) c2 cle) $;

--| If an element ` X ` is a solution of a quadratic equation, then it is either in the base field, or the degree of its field extension is exactly 2. (Contributed by Thierry Arnoux, 22-Jun-2025.)
theorem rtelextdg2 (ph: wff) (A2 B2 P c_pl c_x E c_ex F K L V X c_0: class):
  $ wceq K (co E F cress) $ >
  $ wceq L (co E (co E (cun F (csn X)) cfldgen) cress) $ >
  $ wceq c_0 (cfv E c0g) $ >
  $ wceq P (cfv K cpl1) $ >
  $ wceq V (cfv E cbs) $ >
  $ wceq c_x (cfv E cmulr) $ >
  $ wceq c_pl (cfv E cplusg) $ >
  $ wceq c_ex (cfv (cfv E cmgp) cmg) $ >
  $ wi ph (wcel E cfield) $ >
  $ wi ph (wcel F (cfv E csdrg)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel A2 F) $ >
  $ wi ph (wcel B2 F) $ >
  $ wi ph (wceq (co (co c2 X c_ex) (co (co A2 X c_x) B2 c_pl) c_pl) c_0) $ >
  $ wi ph (wo (wcel X F) (wceq (co L K cextdg) c2)) $;

--| In a non-empty chain ` T ` of quadratic field extensions, the degree of the final extension is always a power of two. (Contributed by Thierry Arnoux, 19-Oct-2025.)
theorem fldext2chn {e f2 n: setvar} (ph: wff e f2) (Q c_lt: class e f2 n) (T: class e f2) (E F L: class e f2 n) (W: class):
  $ wceq E (co W (cv e) cress) $ >
  $ wceq F (co W (cv f2) cress) $ >
  $ wceq c_lt (copab f2 e (wa (wbr E F cfldext) (wceq (co E F cextdg) c2))) $ >
  $ wi ph (wcel T (cchn (cfv W csdrg) c_lt)) $ >
  $ wi ph (wcel W cfield) $ >
  $ wi ph (wceq (co W (cfv cc0 T) cress) Q) $ >
  $ wi ph (wceq (co W (cfv T clsw) cress) L) $ >
  $ wi ph (wbr cc0 (cfv T chash) clt) $ >
  $ wi ph (wa (wbr L Q cfldext) (wrex n (wceq (co L Q cextdg) (co c2 (cv n) cexp)) cn0)) $;

--| Extend class notation with the set of constructible points.
term cconstr: class;

--| Define the set of geometrically constructible points, by recursively adding the line-line, line-circle and circle-circle intersections constructions using points in a previous iteration. Definition 7.4. in [Stewart] p. 92. (Contributed by Saveliy Skresanov, 19-Jan-2025.)
axiom df_constr {x3 t e f2 s1 r a b c d: setvar}:
  $ wceq cconstr (cuni (cima (crdg (cmpt s1 cvv (crab x3 (w3o (wrex a (wrex b (wrex c (wrex d (wrex t (wrex r (w3a (wceq (cv x3) (co (cv a) (co (cv t) (co (cv b) (cv a) cmin) cmul) caddc)) (wceq (cv x3) (co (cv c) (co (cv r) (co (cv d) (cv c) cmin) cmul) caddc)) (wne (cfv (co (cfv (co (cv b) (cv a) cmin) ccj) (co (cv d) (cv c) cmin) cmul) cim) cc0)) cr) cr) (cv s1)) (cv s1)) (cv s1)) (cv s1)) (wrex a (wrex b (wrex c (wrex e (wrex f2 (wrex t (wa (wceq (cv x3) (co (cv a) (co (cv t) (co (cv b) (cv a) cmin) cmul) caddc)) (wceq (cfv (co (cv x3) (cv c) cmin) cabs) (cfv (co (cv e) (cv f2) cmin) cabs))) cr) (cv s1)) (cv s1)) (cv s1)) (cv s1)) (cv s1)) (wrex a (wrex b (wrex c (wrex d (wrex e (wrex f2 (w3a (wne (cv a) (cv d)) (wceq (cfv (co (cv x3) (cv a) cmin) cabs) (cfv (co (cv b) (cv c) cmin) cabs)) (wceq (cfv (co (cv x3) (cv d) cmin) cabs) (cfv (co (cv e) (cv f2) cmin) cabs))) (cv s1)) (cv s1)) (cv s1)) (cv s1)) (cv s1)) (cv s1))) cc)) (cpr cc0 c1)) com)) $;

--| In the construction of constructible numbers, line-line intersections are solutions of linear equations, and can therefore be completely constructed. (Contributed by Thierry Arnoux, 6-Jul-2025.)
theorem constrrtll (ph: wff) (A2 B2 C D R S T N X: class):
  $ wi ph (wss S cc) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C S) $ >
  $ wi ph (wcel D S) $ >
  $ wi ph (wcel T cr) $ >
  $ wi ph (wcel R cr) $ >
  $ wi ph (wceq X (co A2 (co T (co B2 A2 cmin) cmul) caddc)) $ >
  $ wi ph (wceq X (co C (co R (co D C cmin) cmul) caddc)) $ >
  $ wi ph (wne (cfv (co (cfv (co B2 A2 cmin) ccj) (co D C cmin) cmul) cim) cc0) $ >
  $ wceq N (co A2 (co (co (co (co (co A2 C cmin) (co (cfv D ccj) (cfv C ccj) cmin) cmul) (co (co (cfv A2 ccj) (cfv C ccj) cmin) (co D C cmin) cmul) cmin) (co (co (co (cfv B2 ccj) (cfv A2 ccj) cmin) (co D C cmin) cmul) (co (co B2 A2 cmin) (co (cfv D ccj) (cfv C ccj) cmin) cmul) cmin) cdiv) (co B2 A2 cmin) cmul) caddc) $ >
  $ wi ph (wceq X N) $;

--| In the construction of constructible numbers, line-circle intersections are roots of a quadratic equation, non-degenerate case. (Contributed by Thierry Arnoux, 6-Jul-2025.)
theorem constrrtlc1 (ph: wff) (A2 B2 C Q S T E F M N X: class):
  $ wi ph (wss S cc) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C S) $ >
  $ wi ph (wcel E S) $ >
  $ wi ph (wcel F S) $ >
  $ wi ph (wcel T cr) $ >
  $ wi ph (wceq X (co A2 (co T (co B2 A2 cmin) cmul) caddc)) $ >
  $ wi ph (wceq (cfv (co X C cmin) cabs) (cfv (co E F cmin) cabs)) $ >
  $ wceq Q (co (co (cfv B2 ccj) (cfv A2 ccj) cmin) (co B2 A2 cmin) cdiv) $ >
  $ wceq M (co (co (co (co (cfv A2 ccj) (co A2 Q cmul) cmin) (cfv C ccj) cmin) (co C Q cmul) cmin) Q cdiv) $ >
  $ wceq N (co (cneg (co (co C (co (co (cfv A2 ccj) (co A2 Q cmul) cmin) (cfv C ccj) cmin) cmul) (co (co E F cmin) (co (cfv E ccj) (cfv F ccj) cmin) cmul) caddc)) Q cdiv) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wa (wceq (co (co X c2 cexp) (co (co M X cmul) N caddc) caddc) cc0) (wne Q cc0)) $;

--| In the construction of constructible numbers, line-circle intersections are one of the original points, in a degenerate case. (Contributed by Thierry Arnoux, 6-Jul-2025.)
theorem constrrtlc2 (ph: wff) (A2 B2 C S T E F X: class):
  $ wi ph (wss S cc) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel C S) $ >
  $ wi ph (wcel E S) $ >
  $ wi ph (wcel F S) $ >
  $ wi ph (wcel T cr) $ >
  $ wi ph (wceq X (co A2 (co T (co B2 A2 cmin) cmul) caddc)) $ >
  $ wi ph (wceq (cfv (co X C cmin) cabs) (cfv (co E F cmin) cabs)) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq X A2) $;

--| In the construction of constructible numbers, circle-circle intersections are roots of a quadratic equation. Case of non-degenerate circles. (Contributed by Thierry Arnoux, 6-Jul-2025.)

  $ wi ph (wral z (wbr (cfv (co (cfv (cv z) R) (cv z) cdiv) cabs) U cle) (co Y cpnf cico)) $ >
  $ wi ph (wral y1 (wrex z (wa (wa (wbr (cv y1) (cv z) clt) (wbr (co (co c1 (co L E cmul) caddc) (cv z) cmul) (co K (cv y1) cmul) clt)) (wral u (wbr (cfv (co (cfv (cv u) R) (cv u) cdiv) cabs) E cle) (co (cv z) (co (co c1 (co L E cmul) caddc) (cv z) cmul) cicc))) crp) (co X cpnf cioo)) $ >
  $ wceq O (co (co (cfv (co Z (co K (co J c1 caddc) cexp) cdiv) cfl) c1 caddc) (cfv (co Z (co K J cexp) cdiv) cfl) cfz) $ >
  $ wi (wa ph (wcel J (co M N cfzo))) (wbr (co (co U E cmin) (co (co (co L E cmul) c8 cdiv) (cfv Z clog) cmul) cmul) (csu n O (co (co (co U (cv n) cdiv) (cfv (co (cfv (co Z (cv n) cdiv) R) Z cdiv) cabs) cmin) (cfv (cv n) clog) cmul)) cle) $;

--| Lemma for ~ pnt . Add up the pieces in ~ pntlemi to get an estimate slightly better than the naive lower bound ` 0 ` . (Contributed by Mario Carneiro, 13-Apr-2016.)
theorem pntlemf {y1 z u n a: setvar} (ph: wff y1 z u a) (A2 B2: class y1 z u n a) (C: class y1 u n a) (D: class y1 z u n a) (R: class a) (U: class y1 u a) (E: class) (F: class y1 z u n a) (K: class u a) (L: class a) (M N W: class y1 u a) (X: class u a) (Y: class y1 u a) (Z: class y1 a):
  $ wceq R (cmpt a crp (co (cfv (cv a) cchp) (cv a) cmin)) $ >
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wcel L (co cc0 c1 cioo)) $ >
  $ wceq D (co A2 c1 caddc) $ >
  $ wceq F (co (co c1 (co c1 D cdiv) cmin) (co (co L (co (cdc c3 c2) B2 cmul) cdiv) (co D c2 cexp) cdiv) cmul) $ >
  $ wi ph (wcel U crp) $ >
  $ wi ph (wbr U A2 cle) $ >
  $ wceq E (co U D cdiv) $ >
  $ wceq K (cfv (co B2 E cdiv) ce) $ >
  $ wi ph (wa (wcel Y crp) (wbr c1 Y cle)) $ >
  $ wi ph (wa (wcel X crp) (wbr Y X clt)) $ >
  $ wi ph (wcel C crp) $ >
  $ wceq W (co (co (co Y (co c4 (co L E cmul) cdiv) caddc) c2 cexp) (co (co (co X (co K c2 cexp) cmul) c4 cexp) (cfv (co (co (co (cdc c3 c2) B2 cmul) (co (co U E cmin) (co L (co E c2 cexp) cmul) cmul) cdiv) (co (co U c3 cmul) C caddc) cmul) ce) caddc) caddc) $ >
  $ wi ph (wcel Z (co W cpnf cico)) $ >
  $ wceq M (co (cfv (co (cfv X clog) (cfv K clog) cdiv) cfl) c1 caddc) $ >
  $ wceq N (cfv (co (co (cfv Z clog) (cfv K clog) cdiv) c2 cdiv) cfl) $ >
  $ wi ph (wral z (wbr (cfv (co (cfv (cv z) R) (cv z) cdiv) cabs) U cle) (co Y cpnf cico)) $ >
  $ wi ph (wral y1 (wrex z (wa (wa (wbr (cv y1) (cv z) clt) (wbr (co (co c1 (co L E cmul) caddc) (cv z) cmul) (co K (cv y1) cmul) clt)) (wral u (wbr (cfv (co (cfv (cv u) R) (cv u) cdiv) cabs) E cle) (co (cv z) (co (co c1 (co L E cmul) caddc) (cv z) cmul) cicc))) crp) (co X cpnf cioo)) $ >
  $ wi ph (wbr (co (co U E cmin) (co (co (co L (co E c2 cexp) cmul) (co (cdc c3 c2) B2 cmul) cdiv) (co (cfv Z clog) c2 cexp) cmul) cmul) (csu n (co c1 (cfv (co Z Y cdiv) cfl) cfz) (co (co (co U (cv n) cdiv) (cfv (co (cfv (co Z (cv n) cdiv) R) Z cdiv) cabs) cmin) (cfv (cv n) clog) cmul)) cle) $;

--| Lemma for ~ pnt . Evaluate the naive part of the estimate. (Contributed by Mario Carneiro, 14-Apr-2016.)
theorem pntlemk {y1 z u n a: setvar} (ph: wff y1 z u a) (A2 B2: class y1 z u n a) (C: class y1 u n a) (D: class y1 z u n a) (R: class a) (U: class y1 u a) (E: class) (F: class y1 z u n a) (K: class u a) (L: class a) (M N W: class y1 u a) (X: class u a) (Y: class y1 u a) (Z: class y1 a):
  $ wceq R (cmpt a crp (co (cfv (cv a) cchp) (cv a) cmin)) $ >
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wcel L (co cc0 c1 cioo)) $ >
  $ wceq D (co A2 c1 caddc) $ >
  $ wceq F (co (co c1 (co c1 D cdiv) cmin) (co (co L (co (cdc c3 c2) B2 cmul) cdiv) (co D c2 cexp) cdiv) cmul) $ >
  $ wi ph (wcel U crp) $ >
  $ wi ph (wbr U A2 cle) $ >
  $ wceq E (co U D cdiv) $ >
  $ wceq K (cfv (co B2 E cdiv) ce) $ >
  $ wi ph (wa (wcel Y crp) (wbr c1 Y cle)) $ >
  $ wi ph (wa (wcel X crp) (wbr Y X clt)) $ >
  $ wi ph (wcel C crp) $ >
  $ wceq W (co (co (co Y (co c4 (co L E cmul) cdiv) caddc) c2 cexp) (co (co (co X (co K c2 cexp) cmul) c4 cexp) (cfv (co (co (co (cdc c3 c2) B2 cmul) (co (co U E cmin) (co L (co E c2 cexp) cmul) cmul) cdiv) (co (co U c3 cmul) C caddc) cmul) ce) caddc) caddc) $ >
  $ wi ph (wcel Z (co W cpnf cico)) $ >
  $ wceq M (co (cfv (co (cfv X clog) (cfv K clog) cdiv) cfl) c1 caddc) $ >
  $ wceq N (cfv (co (co (cfv Z clog) (cfv K clog) cdiv) c2 cdiv) cfl) $ >
  $ wi ph (wral z (wbr (cfv (co (cfv (cv z) R) (cv z) cdiv) cabs) U cle) (co Y cpnf cico)) $ >
  $ wi ph (wral y1 (wrex z (wa (wa (wbr (cv y1) (cv z) clt) (wbr (co (co c1 (co L E cmul) caddc) (cv z) cmul) (co K (cv y1) cmul) clt)) (wral u (wbr (cfv (co (cfv (cv u) R) (cv u) cdiv) cabs) E cle) (co (cv z) (co (co c1 (co L E cmul) caddc) (cv z) cmul) cicc))) crp) (co X cpnf cioo)) $ >
  $ wi ph (wbr (co c2 (csu n (co c1 (cfv (co Z Y cdiv) cfl) cfz) (co (co U (cv n) cdiv) (cfv (cv n) clog) cmul)) cmul) (co (co U (co (cfv Z clog) c3 caddc) cmul) (cfv Z clog) cmul) cle) $;

--| Lemma for ~ pnt . Combine all the estimates to establish a smaller eventual bound on ` R ( Z ) / Z ` . (Contributed by Mario Carneiro, 14-Apr-2016.)
theorem pntlemo {y1 z u i a: setvar} (ph: wff y1 z u i a) (A2 B2: class y1 z u i a) (C: class y1 u i a) (D: class y1 z u i a) (R: class a) (U: class y1 u i a) (E: class i) (F: class y1 z u i a) (K: class u i a) (L: class i a) (M N W: class y1 u i a) (X: class u i a) (Y: class y1 u a) (Z: class y1 i a):
  $ wceq R (cmpt a crp (co (cfv (cv a) cchp) (cv a) cmin)) $ >
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wcel L (co cc0 c1 cioo)) $ >
  $ wceq D (co A2 c1 caddc) $ >
  $ wceq F (co (co c1 (co c1 D cdiv) cmin) (co (co L (co (cdc c3 c2) B2 cmul) cdiv) (co D c2 cexp) cdiv) cmul) $ >
  $ wi ph (wcel U crp) $ >
  $ wi ph (wbr U A2 cle) $ >
  $ wceq E (co U D cdiv) $ >
  $ wceq K (cfv (co B2 E cdiv) ce) $ >
  $ wi ph (wa (wcel Y crp) (wbr c1 Y cle)) $ >
  $ wi ph (wa (wcel X crp) (wbr Y X clt)) $ >
  $ wi ph (wcel C crp) $ >
  $ wceq W (co (co (co Y (co c4 (co L E cmul) cdiv) caddc) c2 cexp) (co (co (co X (co K c2 cexp) cmul) c4 cexp) (cfv (co (co (co (cdc c3 c2) B2 cmul) (co (co U E cmin) (co L (co E c2 cexp) cmul) cmul) cdiv) (co (co U c3 cmul) C caddc) cmul) ce) caddc) caddc) $ >
  $ wi ph (wcel Z (co W cpnf cico)) $ >
  $ wceq M (co (cfv (co (cfv X clog) (cfv K clog) cdiv) cfl) c1 caddc) $ >
  $ wceq N (cfv (co (co (cfv Z clog) (cfv K clog) cdiv) c2 cdiv) cfl) $ >
  $ wi ph (wral z (wbr (cfv (co (cfv (cv z) R) (cv z) cdiv) cabs) U cle) (co Y cpnf cico)) $ >
  $ wi ph (wral y1 (wrex z (wa (wa (wbr (cv y1) (cv z) clt) (wbr (co (co c1 (co L E cmul) caddc) (cv z) cmul) (co K (cv y1) cmul) clt)) (wral u (wbr (cfv (co (cfv (cv u) R) (cv u) cdiv) cabs) E cle) (co (cv z) (co (co c1 (co L E cmul) caddc) (cv z) cmul) cicc))) crp) (co X cpnf cioo)) $ >
  $ wi ph (wral z (wbr (co (co (co (cfv (cfv (cv z) R) cabs) (cfv (cv z) clog) cmul) (co (co c2 (cfv (cv z) clog) cdiv) (csu i (co c1 (cfv (co (cv z) Y cdiv) cfl) cfz) (co (cfv (cfv (co (cv z) (cv i) cdiv) R) cabs) (cfv (cv i) clog) cmul)) cmul) cmin) (cv z) cdiv) C cle) (co c1 cpnf cioo)) $ >
  $ wi ph (wbr (cfv (co (cfv Z R) Z cdiv) cabs) (co U (co F (co U c3 cexp) cmul) cmin) cle) $;

--| Lemma for ~ pnt . Package up ~ pntlemo in quantifiers. (Contributed by Mario Carneiro, 14-Apr-2016.)
theorem pntleme {y1 z w v u i k a: setvar} (ph: wff y1 z w u i k a) (A2 B2: class y1 z w v u i k a) (C: class y1 w v u i k a) (D: class y1 z w v u i k a) (R: class a) (U: class y1 v u i k a) (E: class w i) (F: class y1 z v u i k a) (K: class w v u i a) (L: class w v i a) (W: class y1 u i k a) (X: class w v u i a) (Y: class y1 w v u k a):
  $ wceq R (cmpt a crp (co (cfv (cv a) cchp) (cv a) cmin)) $ >
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wcel L (co cc0 c1 cioo)) $ >
  $ wceq D (co A2 c1 caddc) $ >
  $ wceq F (co (co c1 (co c1 D cdiv) cmin) (co (co L (co (cdc c3 c2) B2 cmul) cdiv) (co D c2 cexp) cdiv) cmul) $ >
  $ wi ph (wcel U crp) $ >
  $ wi ph (wbr U A2 cle) $ >
  $ wceq E (co U D cdiv) $ >
  $ wceq K (cfv (co B2 E cdiv) ce) $ >
  $ wi ph (wa (wcel Y crp) (wbr c1 Y cle)) $ >
  $ wi ph (wa (wcel X crp) (wbr Y X clt)) $ >
  $ wi ph (wcel C crp) $ >
  $ wceq W (co (co (co Y (co c4 (co L E cmul) cdiv) caddc) c2 cexp) (co (co (co X (co K c2 cexp) cmul) c4 cexp) (cfv (co (co (co (cdc c3 c2) B2 cmul) (co (co U E cmin) (co L (co E c2 cexp) cmul) cmul) cdiv) (co (co U c3 cmul) C caddc) cmul) ce) caddc) caddc) $ >
  $ wi ph (wral z (wbr (cfv (co (cfv (cv z) R) (cv z) cdiv) cabs) U cle) (co Y cpnf cico)) $ >
  $ wi ph (wral k (wral y1 (wrex z (wa (wa (wbr (cv y1) (cv z) clt) (wbr (co (co c1 (co L E cmul) caddc) (cv z) cmul) (co (cv k) (cv y1) cmul) clt)) (wral u (wbr (cfv (co (cfv (cv u) R) (cv u) cdiv) cabs) E cle) (co (cv z) (co (co c1 (co L E cmul) caddc) (cv z) cmul) cicc))) crp) (co X cpnf cioo)) (co K cpnf cico)) $ >
  $ wi ph (wral z (wbr (co (co (co (cfv (cfv (cv z) R) cabs) (cfv (cv z) clog) cmul) (co (co c2 (cfv (cv z) clog) cdiv) (csu i (co c1 (cfv (co (cv z) Y cdiv) cfl) cfz) (co (cfv (cfv (co (cv z) (cv i) cdiv) R) cabs) (cfv (cv i) clog) cmul)) cmul) cmin) (cv z) cdiv) C cle) (co c1 cpnf cioo)) $ >
  $ wi ph (wrex w (wral v (wbr (cfv (co (cfv (cv v) R) (cv v) cdiv) cabs) (co U (co F (co U c3 cexp) cmul) cmin) cle) (co (cv w) cpnf cico)) crp) $;

--| Lemma for ~ pnt . Equation 10.6.35 in [Shapiro], p. 436. (Contributed by Mario Carneiro, 8-Apr-2016.) (Proof shortened by AV, 27-Sep-2020.)
theorem pntlem3 {x3 y1 z u t a: setvar} (ph: wff a) (A2: class u a) (C: class x3 y1 z t a) (R: class a) (T: class y1 z t a):
  $ wceq R (cmpt a crp (co (cfv (cv a) cchp) (cv a) cmin)) $ >
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wral x3 (wbr (cfv (co (cfv (cv x3) R) (cv x3) cdiv) cabs) A2 cle) crp) $ >
  $ wceq T (crab t (wrex y1 (wral z (wbr (cfv (co (cfv (cv z) R) (cv z) cdiv) cabs) (cv t) cle) (co (cv y1) cpnf cico)) crp) (co cc0 A2 cicc)) $ >
  $ wi ph (wcel C crp) $ >
  $ wi (wa ph (wcel (cv u) T)) (wcel (co (cv u) (co C (co (cv u) c3 cexp) cmul) cmin) T) $ >
  $ wi ph (wbr (cmpt x3 crp (co (cfv (cv x3) cchp) (cv x3) cdiv)) c1 crli) $;

--| Lemma for ~ pnt . Wrapping up more quantifiers. (Contributed by Mario Carneiro, 14-Apr-2016.)
theorem pntlemp {x3 y1 z w v u e k a: setvar} (ph: wff z u e k a) (A2: class u e k a) (B2: class u a) (D: class) (R: class a) (U: class x3 y1 u e k a) (E: class) (F: class x3 u e k a) (K: class u a) (L: class a) (Y: class x3 u e):
  $ wceq R (cmpt a crp (co (cfv (cv a) cchp) (cv a) cmin)) $ >
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wral x3 (wbr (cfv (co (cfv (cv x3) R) (cv x3) cdiv) cabs) A2 cle) crp) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wcel L (co cc0 c1 cioo)) $ >
  $ wceq D (co A2 c1 caddc) $ >
  $ wceq F (co (co c1 (co c1 D cdiv) cmin) (co (co L (co (cdc c3 c2) B2 cmul) cdiv) (co D c2 cexp) cdiv) cmul) $ >
  $ wi ph (wral e (wrex x3 (wral k (wral y1 (wrex z (wa (wa (wbr (cv y1) (cv z) clt) (wbr (co (co c1 (co L (cv e) cmul) caddc) (cv z) cmul) (co (cv k) (cv y1) cmul) clt)) (wral u (wbr (cfv (co (cfv (cv u) R) (cv u) cdiv) cabs) (cv e) cle) (co (cv z) (co (co c1 (co L (cv e) cmul) caddc) (cv z) cmul) cicc))) crp) (co (cv x3) cpnf cioo)) (co (cfv (co B2 (cv e) cdiv) ce) cpnf cico)) crp) (co cc0 c1 cioo)) $ >
  $ wi ph (wcel U crp) $ >
  $ wi ph (wbr U A2 cle) $ >
  $ wceq E (co U D cdiv) $ >
  $ wceq K (cfv (co B2 E cdiv) ce) $ >
  $ wi ph (wa (wcel Y crp) (wbr c1 Y cle)) $ >
  $ wi ph (wral z (wbr (cfv (co (cfv (cv z) R) (cv z) cdiv) cabs) U cle) (co Y cpnf cico)) $ >
  $ wi ph (wrex w (wral v (wbr (cfv (co (cfv (cv v) R) (cv v) cdiv) cabs) (co U (co F (co U c3 cexp) cmul) cmin) cle) (co (cv w) cpnf cico)) crp) $;

--| Lemma for ~ pnt . Equation 10.6.35 in [Shapiro], p. 436. (Contributed by Mario Carneiro, 14-Apr-2016.)
theorem pntleml {x3 y1 z u e k a: setvar} (ph: wff u e k a) (A2: class u e k a) (B2: class u a) (D: class) (R: class a) (F: class x3 u e k a) (L: class a):
  $ wceq R (cmpt a crp (co (cfv (cv a) cchp) (cv a) cmin)) $ >
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wral x3 (wbr (cfv (co (cfv (cv x3) R) (cv x3) cdiv) cabs) A2 cle) crp) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wcel L (co cc0 c1 cioo)) $ >
  $ wceq D (co A2 c1 caddc) $ >
  $ wceq F (co (co c1 (co c1 D cdiv) cmin) (co (co L (co (cdc c3 c2) B2 cmul) cdiv) (co D c2 cexp) cdiv) cmul) $ >
  $ wi ph (wral e (wrex x3 (wral k (wral y1 (wrex z (wa (wa (wbr (cv y1) (cv z) clt) (wbr (co (co c1 (co L (cv e) cmul) caddc) (cv z) cmul) (co (cv k) (cv y1) cmul) clt)) (wral u (wbr (cfv (co (cfv (cv u) R) (cv u) cdiv) cabs) (cv e) cle) (co (cv z) (co (co c1 (co L (cv e) cmul) caddc) (cv z) cmul) cicc))) crp) (co (cv x3) cpnf cioo)) (co (cfv (co B2 (cv e) cdiv) ce) cpnf cico)) crp) (co cc0 c1 cioo)) $ >
  $ wi ph (wbr (cmpt x3 crp (co (cfv (cv x3) cchp) (cv x3) cdiv)) c1 crli) $;

--| The Prime Number Theorem, version 3: the second Chebyshev function tends asymptotically to ` x ` . (Contributed by Mario Carneiro, 1-Jun-2016.)
theorem pnt3 {x3: setvar}:
  $ wbr (cmpt x3 crp (co (cfv (cv x3) cchp) (cv x3) cdiv)) c1 crli $;

--| The Prime Number Theorem, version 2: the first Chebyshev function tends asymptotically to ` x ` . (Contributed by Mario Carneiro, 1-Jun-2016.)
theorem pnt2 {x3: setvar}:
  $ wbr (cmpt x3 crp (co (cfv (cv x3) ccht) (cv x3) cdiv)) c1 crli $;

--| The Prime Number Theorem: the number of prime numbers less than ` x ` tends asymptotically to ` x / log ( x ) ` as ` x ` goes to infinity. This is Metamath 100 proof #5. (Contributed by Mario Carneiro, 1-Jun-2016.)
theorem pnt {x3: setvar}:
  $ wbr (cmpt x3 (co c1 cpnf cioo) (co (cfv (cv x3) cppi) (co (cv x3) (cfv (cv x3) clog) cdiv) cdiv)) c1 crli $;

--| Raising an absolute value to a power less than one yields another absolute value. (Contributed by Mario Carneiro, 8-Sep-2014.)
theorem abvcxp {x3: setvar} (A2 B2 R S F: class) (G: class x3):
  $ wceq A2 (cfv R cabv) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq G (cmpt x3 B2 (co (cfv (cv x3) F) S ccxp)) $ >
  $ wi (wa (wcel F A2) (wcel S (co cc0 c1 cioc))) (wcel G A2) $;

--| Value of the p-adic absolute value. (Contributed by Mario Carneiro, 8-Sep-2014.)
theorem padicfval {x3 q: setvar} (P: class) (J: class x3 q):
  $ wceq J (cmpt q cprime (cmpt x3 cq (cif (wceq (cv x3) cc0) cc0 (co (cv q) (cneg (co (cv q) (cv x3) cpc)) cexp)))) $ >
  $ wi (wcel P cprime) (wceq (cfv P J) (cmpt x3 cq (cif (wceq (cv x3) cc0) cc0 (co P (cneg (co P (cv x3) cpc)) cexp)))) $;

--| Value of the p-adic absolute value. (Contributed by Mario Carneiro, 8-Sep-2014.)
theorem padicval {x3 q: setvar} (P: class) (J: class x3 q) (X: class q):
  $ wceq J (cmpt q cprime (cmpt x3 cq (cif (wceq (cv x3) cc0) cc0 (co (cv q) (cneg (co (cv q) (cv x3) cpc)) cexp)))) $ >
  $ wi (wa (wcel P cprime) (wcel X cq)) (wceq (cfv X (cfv P J)) (cif (wceq X cc0) cc0 (co P (cneg (co P X cpc)) cexp))) $;

--| Lemma for ~ ostth2 , although it is just a simple statement about exponentials which does not involve any specifics of ~ ostth2 . If a power is upper bounded by a linear term, the exponent must be less than one. Or in big-O notation, ` n e. o ( A ^ n ) ` for any ` 1 < A ` . (Contributed by Mario Carneiro, 10-Sep-2014.)
theorem ostth2lem1 {n: setvar} (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi (wa ph (wcel (cv n) cn)) (wbr (co A2 (cv n) cexp) (co (cv n) B2 cmul) cle) $ >
  $ wi ph (wbr A2 c1 cle) $;

--| The base set of the field of rationals. (Contributed by Mario Carneiro, 8-Sep-2014.)
theorem qrngbas (Q: class):
  $ wceq Q (co ccnfld cq cress) $ >
  $ wceq cq (cfv Q cbs) $;

--| The rationals form a division ring. (Contributed by Mario Carneiro, 8-Sep-2014.)
theorem qdrng (Q: class):
  $ wceq Q (co ccnfld cq cress) $ >
  $ wcel Q cdr $;

--| The zero element of the field of rationals. (Contributed by Mario Carneiro, 8-Sep-2014.)
theorem qrng0 (Q: class):
  $ wceq Q (co ccnfld cq cress) $ >
  $ wceq cc0 (cfv Q c0g) $;

--| The unity element of the field of rationals. (Contributed by Mario Carneiro, 8-Sep-2014.)
theorem qrng1 (Q: class):
  $ wceq Q (co ccnfld cq cress) $ >
  $ wceq c1 (cfv Q cur) $;

--| The additive inverse in the field of rationals. (Contributed by Mario Carneiro, 8-Sep-2014.)
theorem qrngneg (Q X: class):
  $ wceq Q (co ccnfld cq cress) $ >
  $ wi (wcel X cq) (wceq (cfv X (cfv Q cminusg)) (cneg X)) $;

--| The division operation in the field of rationals. (Contributed by Mario Carneiro, 8-Sep-2014.)
theorem qrngdiv (Q X Y: class):
  $ wceq Q (co ccnfld cq cress) $ >
  $ wi (w3a (wcel X cq) (wcel Y cq) (wne Y cc0)) (wceq (co X Y (cfv Q cdvr)) (co X Y cdiv)) $;

--| By using induction on ` N ` , we show a long-range inequality coming from the triangle inequality. (Contributed by Mario Carneiro, 10-Sep-2014.)
theorem qabvle (A2 Q F N: class):
  $ wceq Q (co ccnfld cq cress) $ >
  $ wceq A2 (cfv Q cabv) $ >
  $ wi (wa (wcel F A2) (wcel N cn0)) (wbr (cfv N F) N cle) $;

--| Induct the product rule ~ abvmul to find the absolute value of a power. (Contributed by Mario Carneiro, 10-Sep-2014.)
theorem qabvexp (A2 Q F M N: class):
  $ wceq Q (co ccnfld cq cress) $ >
  $ wceq A2 (cfv Q cabv) $ >
  $ wi (w3a (wcel F A2) (wcel M cq) (wcel N cn0)) (wceq (cfv (co M N cexp) F) (co (cfv M F) N cexp)) $;

--| Lemma for ~ ostth . If two absolute values agree on the positive integers greater than one, then they agree for all rational numbers and thus are equal as functions. (Contributed by Mario Carneiro, 9-Sep-2014.)
theorem ostthlem1 {n: setvar} (ph: wff) (A2 Q F G: class):
  $ wceq Q (co ccnfld cq cress) $ >
  $ wceq A2 (cfv Q cabv) $ >
  $ wi ph (wcel F A2) $ >
  $ wi ph (wcel G A2) $ >
  $ wi (wa ph (wcel (cv n) (cfv c2 cuz))) (wceq (cfv (cv n) F) (cfv (cv n) G)) $ >
  $ wi ph (wceq F G) $;

--| Lemma for ~ ostth . Refine ~ ostthlem1 so that it is sufficient to only show equality on the primes. (Contributed by Mario Carneiro, 9-Sep-2014.) (Revised by Mario Carneiro, 20-Jun-2015.)
theorem ostthlem2 {p: setvar} (ph: wff) (A2: class) (Q: class p) (F G: class):
  $ wceq Q (co ccnfld cq cress) $ >
  $ wceq A2 (cfv Q cabv) $ >
  $ wi ph (wcel F A2) $ >
  $ wi ph (wcel G A2) $ >
  $ wi (wa ph (wcel (cv p) cprime)) (wceq (cfv (cv p) F) (cfv (cv p) G)) $ >
  $ wi ph (wceq F G) $;

--| The regular absolute value function on the rationals is in fact an absolute value under our definition. (Contributed by Mario Carneiro, 9-Sep-2014.)
theorem qabsabv (A2 Q: class):
  $ wceq Q (co ccnfld cq cress) $ >
  $ wceq A2 (cfv Q cabv) $ >
  $ wcel (cres cabs cq) A2 $;

--| The p-adic absolute value (with arbitrary base) is an absolute value. (Contributed by Mario Carneiro, 9-Sep-2014.)
theorem padicabv {x3: setvar} (A2 P Q: class) (F: class x3) (N: class):
  $ wceq Q (co ccnfld cq cress) $ >
  $ wceq A2 (cfv Q cabv) $ >
  $ wceq F (cmpt x3 cq (cif (wceq (cv x3) cc0) cc0 (co N (co P (cv x3) cpc) cexp))) $ >
  $ wi (wa (wcel P cprime) (wcel N (co cc0 c1 cioo))) (wcel F A2) $;

--| The p-adic absolute value is an absolute value. (Contributed by Mario Carneiro, 9-Sep-2014.)
theorem padicabvf {x3 q: setvar} (A2: class) (Q: class q) (J: class x3 q):
  $ wceq Q (co ccnfld cq cress) $ >
  $ wceq A2 (cfv Q cabv) $ >
  $ wceq J (cmpt q cprime (cmpt x3 cq (cif (wceq (cv x3) cc0) cc0 (co (cv q) (cneg (co (cv q) (cv x3) cpc)) cexp)))) $ >
  $ wf cprime A2 J $;

--| All positive powers of the p-adic absolute value are absolute values. (Contributed by Mario Carneiro, 9-Sep-2014.)
theorem padicabvcxp {x3 y1 q: setvar} (A2 P: class) (Q: class q) (R: class x3) (J: class x3 q):
  $ wceq Q (co ccnfld cq cress) $ >
  $ wceq A2 (cfv Q cabv) $ >
  $ wceq J (cmpt q cprime (cmpt x3 cq (cif (wceq (cv x3) cc0) cc0 (co (cv q) (cneg (co (cv q) (cv x3) cpc)) cexp)))) $ >
  $ wi (wa (wcel P cprime) (wcel R crp)) (wcel (cmpt y1 cq (co (cfv (cv y1) (cfv P J)) R ccxp)) A2) $;

--| - Lemma for ~ ostth : trivial case. (Not that the proof is trivial, but that we are proving that the function is trivial.) If ` F ` is equal to ` 1 ` on the primes, then by complete induction and the multiplicative property ~ abvmul of the absolute value, ` F ` is equal to ` 1 ` on all the integers, and ~ ostthlem1 extends this to the other rational numbers. (Contributed by Mario Carneiro, 10-Sep-2014.)
theorem ostth1 {x3 n q: setvar} (ph: wff) (A2: class) (Q: class q) (F: class) (J: class x3 n q) (K: class x3 q):
  $ wceq Q (co ccnfld cq cress) $ >
  $ wceq A2 (cfv Q cabv) $ >
  $ wceq J (cmpt q cprime (cmpt x3 cq (cif (wceq (cv x3) cc0) cc0 (co (cv q) (cneg (co (cv q) (cv x3) cpc)) cexp)))) $ >
  $ wceq K (cmpt x3 cq (cif (wceq (cv x3) cc0) cc0 c1)) $ >
  $ wi ph (wcel F A2) $ >
  $ wi ph (wral n (wn (wbr c1 (cfv (cv n) F) clt)) cn) $ >
  $ wi ph (wral n (wn (wbr (cfv (cv n) F) c1 clt)) cprime) $ >
  $ wi ph (wceq F K) $;

--| Lemma for ~ ostth2 . (Contributed by Mario Carneiro, 10-Sep-2014.)
theorem ostth2lem2 {x3 q: setvar} (ph: wff) (A2: class) (Q: class q) (R: class x3) (S: class x3 q) (T: class q) (F: class) (J K: class x3 q) (M N X: class q) (Y: class x3 q):
  $ wceq Q (co ccnfld cq cress) $ >
  $ wceq A2 (cfv Q cabv) $ >
  $ wceq J (cmpt q cprime (cmpt x3 cq (cif (wceq (cv x3) cc0) cc0 (co (cv q) (cneg (co (cv q) (cv x3) cpc)) cexp)))) $ >
  $ wceq K (cmpt x3 cq (cif (wceq (cv x3) cc0) cc0 c1)) $ >
  $ wi ph (wcel F A2) $ >
  $ wi ph (wcel N (cfv c2 cuz)) $ >
  $ wi ph (wbr c1 (cfv N F) clt) $ >
  $ wceq R (co (cfv (cfv N F) clog) (cfv N clog) cdiv) $ >
  $ wi ph (wcel M (cfv c2 cuz)) $ >
  $ wceq S (co (cfv (cfv M F) clog) (cfv M clog) cdiv) $ >
  $ wceq T (cif (wbr (cfv M F) c1 cle) c1 (cfv M F)) $ >
  $ wi (w3a ph (wcel X cn0) (wcel Y (co cc0 (co (co M X cexp) c1 cmin) cfz))) (wbr (cfv Y F) (co (co M X cmul) (co T X cexp) cmul) cle) $;

--| Lemma for ~ ostth2 . (Contributed by Mario Carneiro, 10-Sep-2014.)
theorem ostth2lem3 {x3 q: setvar} (ph: wff) (A2: class) (Q: class q) (R: class x3) (S: class x3 q) (T U: class q) (F: class) (J K: class x3 q) (M N X: class q):
  $ wceq Q (co ccnfld cq cress) $ >
  $ wceq A2 (cfv Q cabv) $ >
  $ wceq J (cmpt q cprime (cmpt x3 cq (cif (wceq (cv x3) cc0) cc0 (co (cv q) (cneg (co (cv q) (cv x3) cpc)) cexp)))) $ >
  $ wceq K (cmpt x3 cq (cif (wceq (cv x3) cc0) cc0 c1)) $ >
  $ wi ph (wcel F A2) $ >
  $ wi ph (wcel N (cfv c2 cuz)) $ >
  $ wi ph (wbr c1 (cfv N F) clt) $ >
  $ wceq R (co (cfv (cfv N F) clog) (cfv N clog) cdiv) $ >
  $ wi ph (wcel M (cfv c2 cuz)) $ >
  $ wceq S (co (cfv (cfv M F) clog) (cfv M clog) cdiv) $ >
  $ wceq T (cif (wbr (cfv M F) c1 cle) c1 (cfv M F)) $ >
  $ wceq U (co (cfv N clog) (cfv M clog) cdiv) $ >
  $ wi (wa ph (wcel X cn)) (wbr (co (co (cfv N F) (co T U ccxp) cdiv) X cexp) (co X (co (co M T cmul) (co U c1 caddc) cmul) cmul) cle) $;

--| Lemma for ~ ostth2 . (Contributed by Mario Carneiro, 10-Sep-2014.)
theorem ostth2lem4 {x3 q: setvar} (ph: wff) (A2: class) (Q: class q) (R: class x3) (S: class x3 q) (T U: class q) (F: class) (J K: class x3 q) (M N: class q):
  $ wceq Q (co ccnfld cq cress) $ >
  $ wceq A2 (cfv Q cabv) $ >
  $ wceq J (cmpt q cprime (cmpt x3 cq (cif (wceq (cv x3) cc0) cc0 (co (cv q) (cneg (co (cv q) (cv x3) cpc)) cexp)))) $ >
  $ wceq K (cmpt x3 cq (cif (wceq (cv x3) cc0) cc0 c1)) $ >
  $ wi ph (wcel F A2) $ >
  $ wi ph (wcel N (cfv c2 cuz)) $ >
  $ wi ph (wbr c1 (cfv N F) clt) $ >
  $ wceq R (co (cfv (cfv N F) clog) (cfv N clog) cdiv) $ >
  $ wi ph (wcel M (cfv c2 cuz)) $ >
  $ wceq S (co (cfv (cfv M F) clog) (cfv M clog) cdiv) $ >
  $ wceq T (cif (wbr (cfv M F) c1 cle) c1 (cfv M F)) $ >
  $ wceq U (co (cfv N clog) (cfv M clog) cdiv) $ >
  $ wi ph (wa (wbr c1 (cfv M F) clt) (wbr R S cle)) $;

--| - Lemma for ~ ostth : regular case. (Contributed by Mario Carneiro, 10-Sep-2014.)
theorem ostth2 {x3 y1 q a: setvar} (ph: wff) (A2: class) (Q: class q a) (R: class x3) (F: class) (J: class x3 q) (K: class x3 y1 q a) (N: class q a):
  $ wceq Q (co ccnfld cq cress) $ >
  $ wceq A2 (cfv Q cabv) $ >
  $ wceq J (cmpt q cprime (cmpt x3 cq (cif (wceq (cv x3) cc0) cc0 (co (cv q) (cneg (co (cv q) (cv x3) cpc)) cexp)))) $ >
  $ wceq K (cmpt x3 cq (cif (wceq (cv x3) cc0) cc0 c1)) $ >
  $ wi ph (wcel F A2) $ >
  $ wi ph (wcel N (cfv c2 cuz)) $ >
  $ wi ph (wbr c1 (cfv N F) clt) $ >
  $ wceq R (co (cfv (cfv N F) clog) (cfv N clog) cdiv) $ >
  $ wi ph (wrex a (wceq F (cmpt y1 cq (co (cfv (cv y1) cabs) (cv a) ccxp))) (co cc0 c1 cioc)) $;

--| - Lemma for ~ ostth : p-adic case. (Contributed by Mario Carneiro, 10-Sep-2014.)
theorem ostth3 {x3 y1 n q p a: setvar} (ph: wff) (A2: class) (P: class n) (Q: class q p a) (R: class x3 n) (S: class x3 y1 n q p) (F: class) (J: class x3 n q) (K: class x3 y1 q p a):
  $ wceq Q (co ccnfld cq cress) $ >
  $ wceq A2 (cfv Q cabv) $ >
  $ wceq J (cmpt q cprime (cmpt x3 cq (cif (wceq (cv x3) cc0) cc0 (co (cv q) (cneg (co (cv q) (cv x3) cpc)) cexp)))) $ >
  $ wceq K (cmpt x3 cq (cif (wceq (cv x3) cc0) cc0 c1)) $ >
  $ wi ph (wcel F A2) $ >
  $ wi ph (wral n (wn (wbr c1 (cfv (cv n) F) clt)) cn) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wbr (cfv P F) c1 clt) $ >
  $ wceq R (cneg (co (cfv (cfv P F) clog) (cfv P clog) cdiv)) $ >
  $ wceq S (cif (wbr (cfv P F) (cfv (cv p) F) cle) (cfv (cv p) F) (cfv P F)) $ >
  $ wi ph (wrex a (wceq F (cmpt y1 cq (co (cfv (cv y1) (cfv P J)) (cv a) ccxp))) crp) $;

--| Ostrowski's theorem, which classifies all absolute values on ` QQ ` . Any such absolute value must either be the trivial absolute value ` K ` , a constant exponent ` 0 < a <_ 1 ` times the regular absolute value, or a positive exponent times the p-adic absolute value. (Contributed by Mario Carneiro, 10-Sep-2014.)
theorem ostth {x3 y1 g2 q a: setvar} (A2: class g2) (Q: class g2 q a) (F: class) (J: class x3 q) (K: class x3 y1 g2 q a):
  $ wceq Q (co ccnfld cq cress) $ >
  $ wceq A2 (cfv Q cabv) $ >
  $ wceq J (cmpt q cprime (cmpt x3 cq (cif (wceq (cv x3) cc0) cc0 (co (cv q) (cneg (co (cv q) (cv x3) cpc)) cexp)))) $ >
  $ wceq K (cmpt x3 cq (cif (wceq (cv x3) cc0) cc0 c1)) $ >
  $ wb (wcel F A2) (w3o (wceq F K) (wrex a (wceq F (cmpt y1 cq (co (cfv (cv y1) cabs) (cv a) ccxp))) (co cc0 c1 cioc)) (wrex a (wrex g2 (wceq F (cmpt y1 cq (co (cfv (cv y1) (cv g2)) (cv a) ccxp))) (crn J)) crp)) $;

--| Infinite descent. The hypotheses say that ` S ` is lower bounded, and that if ` ps ` holds for an integer in ` S ` , it holds for a smaller integer in ` S ` . By infinite descent, eventually we cannot go any smaller, therefore ` ps ` holds for no integer in ` S ` . (Contributed by SN, 20-Aug-2024.)
theorem infdesc {x3 y1 z: setvar} (ph ps: wff y1) (ch th: wff x3 z) (S: class) (M: class x3 y1 z):
  $ wi (wceq (cv y1) (cv x3)) (wb ps ch) $ >
  $ wi (wceq (cv y1) (cv z)) (wb ps th) $ >
  $ wi ph (wss S (cfv M cuz)) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) ch)) (wrex z (wa th (wbr (cv z) (cv x3) clt)) S) $ >
  $ wi ph (wceq (crab y1 ps S) c0) $;

--| A counterexample to FLT stays valid when scaled. The hypotheses are more general than they need to be for convenience. (Contributed by SN, 20-Aug-2024.)
theorem fltdiv (ph: wff) (A2 B2 C S N: class):
  $ wi ph (wcel S cc) $ >
  $ wi ph (wne S cc0) $ >
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (co (co A2 N cexp) (co B2 N cexp) caddc) (co C N cexp)) $ >
  $ wi ph (wceq (co (co (co A2 S cdiv) N cexp) (co (co B2 S cdiv) N cexp) caddc) (co (co C S cdiv) N cexp)) $;

--| A counterexample for FLT does not exist for ` N = 0 ` . (Contributed by SN, 20-Aug-2024.)
theorem flt0 (ph: wff) (A2 B2 C N: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (co (co A2 N cexp) (co B2 N cexp) caddc) (co C N cexp)) $ >
  $ wi ph (wcel N cn) $;

--| Any factor of both ` A ` and ` B ` also divides ` C ` . This establishes the validity of ~ fltabcoprmex . (Contributed by SN, 21-Aug-2024.)
theorem fltdvdsabdvdsc (ph: wff) (A2 B2 C N: class):
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wcel C cn) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wceq (co (co A2 N cexp) (co B2 N cexp) caddc) (co C N cexp)) $ >
  $ wi ph (wbr (co A2 B2 cgcd) C cdvds) $;

--| A counterexample to FLT implies a counterexample to FLT with ` A , B ` (assigned to ` A / ( A gcd B ) ` and ` B / ( A gcd B ) ` ) coprime (by ~ divgcdcoprm0 ). (Contributed by SN, 20-Aug-2024.)
theorem fltabcoprmex (ph: wff) (A2 B2 C N: class):
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wcel C cn) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (co (co A2 N cexp) (co B2 N cexp) caddc) (co C N cexp)) $ >
  $ wi ph (wceq (co (co (co A2 (co A2 B2 cgcd) cdiv) N cexp) (co (co B2 (co A2 B2 cgcd) cdiv) N cexp) caddc) (co (co C (co A2 B2 cgcd) cdiv) N cexp)) $;

--| A counterexample to FLT with ` A , B ` coprime also has ` A , C ` coprime. (Contributed by SN, 20-Aug-2024.)
theorem fltaccoprm (ph: wff) (A2 B2 C N: class):
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wcel C cn) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (co (co A2 N cexp) (co B2 N cexp) caddc) (co C N cexp)) $ >
  $ wi ph (wceq (co A2 B2 cgcd) c1) $ >
  $ wi ph (wceq (co A2 C cgcd) c1) $;

--| A counterexample to FLT with ` A , B ` coprime also has ` B , C ` coprime. Proven from ~ fltaccoprm using commutativity of addition. (Contributed by SN, 20-Aug-2024.)
theorem fltbccoprm (ph: wff) (A2 B2 C N: class):
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wcel C cn) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (co (co A2 N cexp) (co B2 N cexp) caddc) (co C N cexp)) $ >
  $ wi ph (wceq (co A2 B2 cgcd) c1) $ >
  $ wi ph (wceq (co B2 C cgcd) c1) $;

--| A counterexample to FLT with ` A , C ` coprime also has ` A , B ` coprime. Converse of ~ fltaccoprm . (Contributed by SN, 22-Aug-2024.)
theorem fltabcoprm (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wcel C cn) $ >
  $ wi ph (wceq (co A2 C cgcd) c1) $ >
  $ wi ph (wceq (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co C c2 cexp)) $ >
  $ wi ph (wceq (co A2 B2 cgcd) c1) $;

--| If a counterexample to FLT exists, its addends are not equal. (Contributed by SN, 1-Jun-2023.)
theorem fltne (ph: wff) (A2 B2 C N: class):
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wcel C cn) $ >
  $ wi ph (wcel N (cfv c2 cuz)) $ >
  $ wi ph (wceq (co (co A2 N cexp) (co B2 N cexp) caddc) (co C N cexp)) $ >
  $ wi ph (wne A2 B2) $;

--| Satisfy the antecedent used in several ~ pythagtrip lemmas. (Contributed by SN, 21-Aug-2024.)
theorem flt4lem1 (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wcel C cn) $ >
  $ wi ph (wn (wbr c2 A2 cdvds)) $ >
  $ wi ph (wceq (co A2 B2 cgcd) c1) $ >
  $ wi ph (wceq (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co C c2 cexp)) $ >
  $ wi ph (w3a (w3a (wcel A2 cn) (wcel B2 cn) (wcel C cn)) (wceq (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co C c2 cexp)) (wa (wceq (co A2 B2 cgcd) c1) (wn (wbr c2 A2 cdvds)))) $;

--| If ` A ` is even, ` B ` is odd. (Contributed by SN, 22-Aug-2024.)
theorem flt4lem2 (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wbr c2 A2 cdvds) $ >
  $ wi ph (wceq (co A2 B2 cgcd) c1) $ >
  $ wi ph (wn (wbr c2 B2 cdvds)) $;

--| Equivalent to ~ pythagtriplem4 . Show that ` C + A ` and ` C - A ` are coprime. (Contributed by SN, 22-Aug-2024.)
theorem flt4lem3 (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wcel C cn) $ >
  $ wi ph (wbr c2 A2 cdvds) $ >
  $ wi ph (wceq (co A2 B2 cgcd) c1) $ >
  $ wi ph (wceq (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co C c2 cexp)) $ >
  $ wi ph (wceq (co (co C A2 caddc) (co C A2 cmin) cgcd) c1) $;

--| If the product of two coprime factors is a perfect square, the factors are perfect squares. (Contributed by SN, 22-Aug-2024.)
theorem flt4lem4 (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wcel C cn) $ >
  $ wi ph (wceq (co A2 B2 cgcd) c1) $ >
  $ wi ph (wceq (co A2 B2 cmul) (co C c2 cexp)) $ >
  $ wi ph (wa (wceq A2 (co (co A2 C cgcd) c2 cexp)) (wceq B2 (co (co B2 C cgcd) c2 cexp))) $;

--| In the context of the lemmas of ~ pythagtrip , ` M ` and ` N ` are coprime. (Contributed by SN, 23-Aug-2024.)
theorem flt4lem5 (A2 B2 C M N: class):
  $ wceq M (co (co (cfv (co C B2 caddc) csqrt) (cfv (co C B2 cmin) csqrt) caddc) c2 cdiv) $ >
  $ wceq N (co (co (cfv (co C B2 caddc) csqrt) (cfv (co C B2 cmin) csqrt) cmin) c2 cdiv) $ >
  $ wi (w3a (w3a (wcel A2 cn) (wcel B2 cn) (wcel C cn)) (wceq (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co C c2 cexp)) (wa (wceq (co A2 B2 cgcd) c1) (wn (wbr c2 A2 cdvds)))) (wceq (co M N cgcd) c1) $;

--| Version of ~ fltaccoprm and ~ fltbccoprm where ` M ` is not squared. This can be proved in general for any polynomial in three variables: using ~ prmdvdsncoprmbd , ~ dvds2addd , and ~ prmdvdsexp , we can show that if two variables are coprime, the third is also coprime to the two. (Contributed by SN, 24-Aug-2024.)
theorem flt4lem5elem (ph: wff) (R S M: class):
  $ wi ph (wcel M cn) $ >
  $ wi ph (wcel R cn) $ >
  $ wi ph (wcel S cn) $ >
  $ wi ph (wceq M (co (co R c2 cexp) (co S c2 cexp) caddc)) $ >
  $ wi ph (wceq (co R S cgcd) c1) $ >
  $ wi ph (wa (wceq (co R M cgcd) c1) (wceq (co S M cgcd) c1)) $;

--| Part 1 of Equation 1 of ~ https://crypto.stanford.edu/pbc/notes/numberfield/fermatn4.html . (Contributed by SN, 22-Aug-2024.)
theorem flt4lem5a (ph: wff) (A2 B2 C R S M N: class):
  $ wceq M (co (co (cfv (co C (co B2 c2 cexp) caddc) csqrt) (cfv (co C (co B2 c2 cexp) cmin) csqrt) caddc) c2 cdiv) $ >
  $ wceq N (co (co (cfv (co C (co B2 c2 cexp) caddc) csqrt) (cfv (co C (co B2 c2 cexp) cmin) csqrt) cmin) c2 cdiv) $ >
  $ wceq R (co (co (cfv (co M N caddc) csqrt) (cfv (co M N cmin) csqrt) caddc) c2 cdiv) $ >
  $ wceq S (co (co (cfv (co M N caddc) csqrt) (cfv (co M N cmin) csqrt) cmin) c2 cdiv) $ >
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wcel C cn) $ >
  $ wi ph (wn (wbr c2 A2 cdvds)) $ >
  $ wi ph (wceq (co A2 B2 cgcd) c1) $ >
  $ wi ph (wceq (co (co A2 c4 cexp) (co B2 c4 cexp) caddc) (co C c2 cexp)) $ >
  $ wi ph (wceq (co (co A2 c2 cexp) (co N c2 cexp) caddc) (co M c2 cexp)) $;

--| Part 2 of Equation 1 of ~ https://crypto.stanford.edu/pbc/notes/numberfield/fermatn4.html . (Contributed by SN, 22-Aug-2024.)
theorem flt4lem5b (ph: wff) (A2 B2 C R S M N: class):
  $ wceq M (co (co (cfv (co C (co B2 c2 cexp) caddc) csqrt) (cfv (co C (co B2 c2 cexp) cmin) csqrt) caddc) c2 cdiv) $ >
  $ wceq N (co (co (cfv (co C (co B2 c2 cexp) caddc) csqrt) (cfv (co C (co B2 c2 cexp) cmin) csqrt) cmin) c2 cdiv) $ >
  $ wceq R (co (co (cfv (co M N caddc) csqrt) (cfv (co M N cmin) csqrt) caddc) c2 cdiv) $ >
  $ wceq S (co (co (cfv (co M N caddc) csqrt) (cfv (co M N cmin) csqrt) cmin) c2 cdiv) $ >
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wcel C cn) $ >
  $ wi ph (wn (wbr c2 A2 cdvds)) $ >
  $ wi ph (wceq (co A2 B2 cgcd) c1) $ >
  $ wi ph (wceq (co (co A2 c4 cexp) (co B2 c4 cexp) caddc) (co C c2 cexp)) $ >
  $ wi ph (wceq (co c2 (co M N cmul) cmul) (co B2 c2 cexp)) $;

--| Part 2 of Equation 2 of ~ https://crypto.stanford.edu/pbc/notes/numberfield/fermatn4.html . (Contributed by SN, 22-Aug-2024.)
theorem flt4lem5c (ph: wff) (A2 B2 C R S M N: class):
  $ wceq M (co (co (cfv (co C (co B2 c2 cexp) caddc) csqrt) (cfv (co C (co B2 c2 cexp) cmin) csqrt) caddc) c2 cdiv) $ >
  $ wceq N (co (co (cfv (co C (co B2 c2 cexp) caddc) csqrt) (cfv (co C (co B2 c2 cexp) cmin) csqrt) cmin) c2 cdiv) $ >
  $ wceq R (co (co (cfv (co M N caddc) csqrt) (cfv (co M N cmin) csqrt) caddc) c2 cdiv) $ >
  $ wceq S (co (co (cfv (co M N caddc) csqrt) (cfv (co M N cmin) csqrt) cmin) c2 cdiv) $ >
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wcel C cn) $ >
  $ wi ph (wn (wbr c2 A2 cdvds)) $ >
  $ wi ph (wceq (co A2 B2 cgcd) c1) $ >
  $ wi ph (wceq (co (co A2 c4 cexp) (co B2 c4 cexp) caddc) (co C c2 cexp)) $ >
  $ wi ph (wceq N (co c2 (co R S cmul) cmul)) $;

--| Part 3 of Equation 2 of ~ https://crypto.stanford.edu/pbc/notes/numberfield/fermatn4.html . (Contributed by SN, 23-Aug-2024.)
theorem flt4lem5d (ph: wff) (A2 B2 C R S M N: class):
  $ wceq M (co (co (cfv (co C (co B2 c2 cexp) caddc) csqrt) (cfv (co C (co B2 c2 cexp) cmin) csqrt) caddc) c2 cdiv) $ >
  $ wceq N (co (co (cfv (co C (co B2 c2 cexp) caddc) csqrt) (cfv (co C (co B2 c2 cexp) cmin) csqrt) cmin) c2 cdiv) $ >
  $ wceq R (co (co (cfv (co M N caddc) csqrt) (cfv (co M N cmin) csqrt) caddc) c2 cdiv) $ >
  $ wceq S (co (co (cfv (co M N caddc) csqrt) (cfv (co M N cmin) csqrt) cmin) c2 cdiv) $ >
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wcel C cn) $ >
  $ wi ph (wn (wbr c2 A2 cdvds)) $ >
  $ wi ph (wceq (co A2 B2 cgcd) c1) $ >
  $ wi ph (wceq (co (co A2 c4 cexp) (co B2 c4 cexp) caddc) (co C c2 cexp)) $ >
  $ wi ph (wceq M (co (co R c2 cexp) (co S c2 cexp) caddc)) $;

--| Satisfy the hypotheses of ~ flt4lem4 . (Contributed by SN, 23-Aug-2024.)
theorem flt4lem5e (ph: wff) (A2 B2 C R S M N: class):
  $ wceq M (co (co (cfv (co C (co B2 c2 cexp) caddc) csqrt) (cfv (co C (co B2 c2 cexp) cmin) csqrt) caddc) c2 cdiv) $ >
  $ wceq N (co (co (cfv (co C (co B2 c2 cexp) caddc) csqrt) (cfv (co C (co B2 c2 cexp) cmin) csqrt) cmin) c2 cdiv) $ >
  $ wceq R (co (co (cfv (co M N caddc) csqrt) (cfv (co M N cmin) csqrt) caddc) c2 cdiv) $ >
  $ wceq S (co (co (cfv (co M N caddc) csqrt) (cfv (co M N cmin) csqrt) cmin) c2 cdiv) $ >
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wcel C cn) $ >
  $ wi ph (wn (wbr c2 A2 cdvds)) $ >
  $ wi ph (wceq (co A2 B2 cgcd) c1) $ >
  $ wi ph (wceq (co (co A2 c4 cexp) (co B2 c4 cexp) caddc) (co C c2 cexp)) $ >
  $ wi ph (w3a (w3a (wceq (co R S cgcd) c1) (wceq (co R M cgcd) c1) (wceq (co S M cgcd) c1)) (w3a (wcel R cn) (wcel S cn) (wcel M cn)) (wa (wceq (co M (co R S cmul) cmul) (co (co B2 c2 cdiv) c2 cexp)) (wcel (co B2 c2 cdiv) cn))) $;

--| Final equation of ~ https://crypto.stanford.edu/pbc/notes/numberfield/fermatn4.html . Given ` A ^ 4 + B ^ 4 = C ^ 2 ` , provide a smaller solution. This satisfies the infinite descent condition. (Contributed by SN, 24-Aug-2024.)
theorem flt4lem5f (ph: wff) (A2 B2 C R S M N: class):
  $ wceq M (co (co (cfv (co C (co B2 c2 cexp) caddc) csqrt) (cfv (co C (co B2 c2 cexp) cmin) csqrt) caddc) c2 cdiv) $ >
  $ wceq N (co (co (cfv (co C (co B2 c2 cexp) caddc) csqrt) (cfv (co C (co B2 c2 cexp) cmin) csqrt) cmin) c2 cdiv) $ >
  $ wceq R (co (co (cfv (co M N caddc) csqrt) (cfv (co M N cmin) csqrt) caddc) c2 cdiv) $ >
  $ wceq S (co (co (cfv (co M N caddc) csqrt) (cfv (co M N cmin) csqrt) cmin) c2 cdiv) $ >
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wcel C cn) $ >
  $ wi ph (wn (wbr c2 A2 cdvds)) $ >
  $ wi ph (wceq (co A2 B2 cgcd) c1) $ >
  $ wi ph (wceq (co (co A2 c4 cexp) (co B2 c4 cexp) caddc) (co C c2 cexp)) $ >
  $ wi ph (wceq (co (co M (co B2 c2 cdiv) cgcd) c2 cexp) (co (co (co R (co B2 c2 cdiv) cgcd) c4 cexp) (co (co S (co B2 c2 cdiv) cgcd) c4 cexp) caddc)) $;

--| Remove shared factors in a solution to ` A ^ 4 + B ^ 4 = C ^ 2 ` . (Contributed by SN, 24-Jul-2024.)
theorem flt4lem6 (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wcel C cn) $ >
  $ wi ph (wceq (co (co A2 c4 cexp) (co B2 c4 cexp) caddc) (co C c2 cexp)) $ >
  $ wi ph (wa (w3a (wcel (co A2 (co A2 B2 cgcd) cdiv) cn) (wcel (co B2 (co A2 B2 cgcd) cdiv) cn) (wcel (co C (co (co A2 B2 cgcd) c2 cexp) cdiv) cn)) (wceq (co (co (co A2 (co A2 B2 cgcd) cdiv) c4 cexp) (co (co B2 (co A2 B2 cgcd) cdiv) c4 cexp) caddc) (co (co C (co (co A2 B2 cgcd) c2 cexp) cdiv) c2 cexp))) $;

--| Convert ~ flt4lem5f into a convenient form for ~ nna4b4nsq . (Contributed by SN, 25-Aug-2024.)
theorem flt4lem7 {g2 h l: setvar} (ph: wff g2 h) (A2: class g2 h l) (B2 C: class g2 h):
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wcel C cn) $ >
  $ wi ph (wn (wbr c2 A2 cdvds)) $ >
  $ wi ph (wceq (co A2 B2 cgcd) c1) $ >
  $ wi ph (wceq (co (co A2 c4 cexp) (co B2 c4 cexp) caddc) (co C c2 cexp)) $ >
  $ wi ph (wrex l (wa (wrex g2 (wrex h (wa (wn (wbr c2 (cv g2) cdvds)) (wa (wceq (co (cv g2) (cv h) cgcd) c1) (wceq (co (co (cv g2) c4 cexp) (co (cv h) c4 cexp) caddc) (co (cv l) c2 cexp)))) cn) cn) (wbr (cv l) C clt)) cn) $;

--| Strengthening of Fermat's last theorem for exponent 4, where the sum is only assumed to be a square. (Contributed by SN, 23-Aug-2024.)
theorem nna4b4nsq (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wcel C cn) $ >
  $ wi ph (wne (co (co A2 c4 cexp) (co B2 c4 cexp) caddc) (co C c2 cexp)) $;

--| Fermat's last theorem for the exponent four. (Contributed by AV, 15-Sep-2026.)
theorem flt4 (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wcel C cn) $ >
  $ wi ph (wne (co (co A2 c4 cexp) (co B2 c4 cexp) caddc) (co C c4 cexp)) $;

--| Fermat's last theorem for the exponent four, derived from Fermat's right triangle theorem (which is not proved yet, see fermrtt: after a proof is available, the hypothesis flt4ALT.r can be removed - TODO-AV). (Contributed by AV, 15-Sep-2026.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem flt4ALT {a b c: setvar} (ph: wff a b c) (A2: class a b) (B2: class a) (C: class):
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wcel C cn) $ >
  $ wi ph (wral a (wral b (wral c (wne (co (co (cv a) c4 cexp) (co (cv b) c4 cexp) cmin) (co (cv c) c2 cexp)) cn) cn) cn) $ >
  $ wi ph (wne (co (co A2 c4 cexp) (co B2 c4 cexp) caddc) (co C c4 cexp)) $;

--| Lemma 1 for ~ fltoprm : Every positive integer is either a power of 2 or has an odd prime factor. (Contributed by AV, 15-Sep-2026.)
theorem fltoprmlem1 {n p: setvar} (N: class):
  $ wi (wcel N cn) (wo (wrex p (wa (wbr c2 (cv p) clt) (wbr (cv p) N cdvds)) cprime) (wrex n (wceq N (co c2 (cv n) cexp)) cn0)) $;

--| Lemma 2 for ~ fltoprm : If an integer greater than or equal to 3 is a power of 2, it is a multiple of 4. (Contributed by AV, 15-Sep-2026.)
theorem fltoprmlem2 (K N: class):
  $ wi (w3a (wcel N (cfv c3 cuz)) (wcel K cn0) (wceq N (co c2 K cexp))) (wbr c4 N cdvds) $;

--| Fermat's last theorem holds for any exponent greater than 2 if it holds for odd prime exponents. (Contributed by AV, 15-Sep-2026.)
theorem fltoprm {p a b c: setvar} (ph: wff p a b c) (A2: class) (B2: class a) (C: class a b) (N: class p a b c):
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wcel C cn) $ >
  $ wi ph (wcel N (cfv c3 cuz)) $ >
  $ wi ph (wral a (wral b (wral c (wral p (wi (wbr c2 (cv p) clt) (wne (co (co (cv a) (cv p) cexp) (co (cv b) (cv p) cexp) caddc) (co (cv c) (cv p) cexp))) cprime) cn) cn) cn) $ >
  $ wi ph (wne (co (co A2 N cexp) (co B2 N cexp) caddc) (co C N cexp)) $;

--| Fermat's last theorem holds for any exponent greater than 2 if it holds for all odd prime exponents greater than 3. (TODO-AV: after a proof is available for ` N = 3 ` , see flt3, the hypothesis fltoprmgt3.3 can be removed.) (Contributed by AV, 15-Sep-2026.)
theorem fltoprmgt3 {p a b c: setvar} (ph: wff) (A2: class) (B2: class a) (C: class a b) (N: class p a b c):
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wcel C cn) $ >
  $ wi ph (wcel N (cfv c3 cuz)) $ >
  $ wi ph (wral a (wral b (wral c (wral p (wi (wbr c3 (cv p) clt) (wne (co (co (cv a) (cv p) cexp) (co (cv b) (cv p) cexp) caddc) (co (cv c) (cv p) cexp))) cprime) cn) cn) cn) $ >
  $ wi ph (wne (co (co (cv a) c3 cexp) (co (cv b) c3 cexp) caddc) (co (cv c) c3 cexp)) $ >
  $ wi ph (wne (co (co A2 N cexp) (co B2 N cexp) caddc) (co C N cexp)) $;

--| Declare the class of all surreal numbers (see ~ df-no ).
term csur: class;

--| Declare the less-than relation over surreal numbers (see ~ df-lts ).
term clts: class;

--| Declare the birthday function for surreal numbers (see ~ df-bday ).
term cbday: class;

--| Define the class of surreal numbers. The surreal numbers are a proper class of numbers developed by John H. Conway and introduced by Donald Knuth in 1975. They form a proper class into which all ordered fields can be embedded. The approach we take to defining them was first introduced by Hary Gonshor, and is based on the conception of a "sign expansion" of a surreal number. We define the surreals as ordinal-indexed sequences of ` 1o ` and ` 2o ` , analogous to Gonshor's ` ( - ) ` and ` ( + ) ` . After introducing this definition, we will abstract away from it using axioms that Norman Alling developed in "Foundations of Analysis over Surreal Number Fields." This is done in an effort to be agnostic towards the exact implementation of surreals. (Contributed by Scott Fenton, 9-Jun-2011.)
axiom df_no {f2 a: setvar}:
  $ wceq csur (cab f2 (wrex a (wf (cv a) (cpr c1o c2o) (cv f2)) con0)) $;

--| Next, we introduce surreal less-than, a comparison relation over the surreals by lexicographically ordering them. (Contributed by Scott Fenton, 9-Jun-2011.)
axiom df_lts {x3 y1 f2 g2: setvar}:
  $ wceq clts (copab f2 g2 (wa (wa (wcel (cv f2) csur) (wcel (cv g2) csur)) (wrex x3 (wa (wral y1 (wceq (cfv (cv y1) (cv f2)) (cfv (cv y1) (cv g2))) (cv x3)) (wbr (cfv (cv x3) (cv f2)) (cfv (cv x3) (cv g2)) (ctp (cop c1o c0) (cop c1o c2o) (cop c0 c2o)))) con0))) $;

--| Finally, we introduce the birthday function. This function maps each surreal to an ordinal. In our implementation, this is the domain of the sign function. The important properties of this function are established later. (Contributed by Scott Fenton, 11-Jun-2011.)
axiom df_bday {x3: setvar}:
  $ wceq cbday (cmpt x3 csur (cdm (cv x3))) $;

--| Membership in the surreals. (Contributed by Scott Fenton, 11-Jun-2011.) (Proof shortened by SF, 14-Apr-2012.) Avoid ~ ax-rep . (Revised by SN, 5-Jun-2025.)
theorem elno {x3: setvar} (A2: class):
  $ wb (wcel A2 csur) (wrex x3 (wf (cv x3) (cpr c1o c2o) A2) con0) $;

--| The value of the surreal less-than relation. (Contributed by Scott Fenton, 14-Jun-2011.)
theorem ltsval {x3 y1: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wb (wbr A2 B2 clts) (wrex x3 (wa (wral y1 (wceq (cfv (cv y1) A2) (cfv (cv y1) B2)) (cv x3)) (wbr (cfv (cv x3) A2) (cfv (cv x3) B2) (ctp (cop c1o c0) (cop c1o c2o) (cop c0 c2o)))) con0)) $;

--| The value of the birthday function within the surreals. (Contributed by Scott Fenton, 14-Jun-2011.)
theorem bdayval (A2: class):
  $ wi (wcel A2 csur) (wceq (cfv A2 cbday) (cdm A2)) $;

--| A surreal is a function. (Contributed by Scott Fenton, 16-Jun-2011.)
theorem nofun (A2: class):
  $ wi (wcel A2 csur) (wfun A2) $;

--| The domain of a surreal is an ordinal. (Contributed by Scott Fenton, 16-Jun-2011.)
theorem nodmon (A2: class):
  $ wi (wcel A2 csur) (wcel (cdm A2) con0) $;

--| The range of a surreal is a subset of the surreal signs. (Contributed by Scott Fenton, 16-Jun-2011.)
theorem norn (A2: class):
  $ wi (wcel A2 csur) (wss (crn A2) (cpr c1o c2o)) $;

--| A surreal is a function over its birthday. (Contributed by Scott Fenton, 16-Jun-2011.)
theorem nofnbday (A2: class):
  $ wi (wcel A2 csur) (wfn A2 (cfv A2 cbday)) $;

--| The domain of a surreal has the ordinal property. (Contributed by Scott Fenton, 16-Jun-2011.)
theorem nodmord (A2: class):
  $ wi (wcel A2 csur) (word (cdm A2)) $;

--| An alternative condition for membership in ` No ` . (Contributed by Scott Fenton, 21-Mar-2012.)
theorem elno2 (A2: class):
  $ wb (wcel A2 csur) (w3a (wfun A2) (wcel (cdm A2) con0) (wss (crn A2) (cpr c1o c2o))) $;

--| Another condition for membership in ` No ` . (Contributed by Scott Fenton, 14-Apr-2012.)
theorem elno3 (A2: class):
  $ wb (wcel A2 csur) (wa (wf (cdm A2) (cpr c1o c2o) A2) (wcel (cdm A2) con0)) $;

--| Alternate expression for surreal less-than. Two surreals obey surreal less-than iff they obey the sign ordering at the first place they differ. (Contributed by Scott Fenton, 17-Jun-2011.)
theorem ltsval2 {a: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wb (wbr A2 B2 clts) (wbr (cfv (cint (crab a (wne (cfv (cv a) A2) (cfv (cv a) B2)) con0)) A2) (cfv (cint (crab a (wne (cfv (cv a) A2) (cfv (cv a) B2)) con0)) B2) (ctp (cop c1o c0) (cop c1o c2o) (cop c0 c2o)))) $;

--| The function value of a surreal is either a sign or the empty set. (Contributed by Scott Fenton, 22-Jun-2011.)
theorem nofv (A2 X: class):
  $ wi (wcel A2 csur) (w3o (wceq (cfv X A2) c0) (wceq (cfv X A2) c1o) (wceq (cfv X A2) c2o)) $;

--| ` (/) ` is not a surreal sign. (Contributed by Scott Fenton, 16-Jun-2011.)
theorem nosgnn0:
  $ wn (wcel c0 (cpr c1o c2o)) $;

--| If ` X ` is a surreal sign, then it is not null. (Contributed by Scott Fenton, 3-Aug-2011.)
theorem nosgnn0i (X: class):
  $ wcel X (cpr c1o c2o) $ >
  $ wne c0 X $;

--| The restriction of a surreal to an ordinal is still a surreal. (Contributed by Scott Fenton, 4-Sep-2011.)
theorem noreson (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 con0)) (wcel (cres A2 B2) csur) $;

--| If ` A <s B ` , then the intersection of all the ordinals that have differing signs in ` A ` and ` B ` exists. (Contributed by Scott Fenton, 22-Feb-2012.)
theorem ltsintdifex {a: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wi (wbr A2 B2 clts) (wcel (cint (crab a (wne (cfv (cv a) A2) (cfv (cv a) B2)) con0)) cvv)) $;

--| If the restrictions of two surreals to a given ordinal obey surreal less-than, then so do the two surreals themselves. (Contributed by Scott Fenton, 4-Sep-2011.)
theorem ltsres (A2 B2 X: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wcel X con0)) (wi (wbr (cres A2 X) (cres B2 X) clts) (wbr A2 B2 clts)) $;

--| The Cartesian product of an ordinal and ` { 1o } ` is a surreal. (Contributed by Scott Fenton, 12-Jun-2011.)
theorem noxp1o (A2: class):
  $ wi (wcel A2 con0) (wcel (cxp A2 (csn c1o)) csur) $;

--| Lemma for ~ nosepon . Consider a case of proper subset domain. (Contributed by Scott Fenton, 21-Sep-2020.)
theorem noseponlem {x3: setvar} (A2 B2: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wcel (cdm A2) (cdm B2))) (wn (wral x3 (wceq (cfv (cv x3) A2) (cfv (cv x3) B2)) con0)) $;

--| Given two unequal surreals, the minimal ordinal at which they differ is an ordinal. (Contributed by Scott Fenton, 21-Sep-2020.)
theorem nosepon {x3: setvar} (A2 B2: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wne A2 B2)) (wcel (cint (crab x3 (wne (cfv (cv x3) A2) (cfv (cv x3) B2)) con0)) con0) $;

--| Extending a surreal by one sign value results in a new surreal. (Contributed by Scott Fenton, 22-Nov-2021.)
theorem noextend (A2 X: class):
  $ wcel X (cpr c1o c2o) $ >
  $ wi (wcel A2 csur) (wcel (cun A2 (csn (cop (cdm A2) X))) csur) $;

--| Extend a surreal by a sequence of ordinals. (Contributed by Scott Fenton, 30-Nov-2021.)
theorem noextendseq (A2 B2 X: class):
  $ wcel X (cpr c1o c2o) $ >
  $ wi (wa (wcel A2 csur) (wcel B2 con0)) (wcel (cun A2 (cxp (cdif B2 (cdm A2)) (csn X))) csur) $;

--| Calculate the place where a surreal and its extension differ. (Contributed by Scott Fenton, 22-Nov-2021.)
theorem noextenddif {x3: setvar} (A2 X: class):
  $ wcel X (cpr c1o c2o) $ >
  $ wi (wcel A2 csur) (wceq (cint (crab x3 (wne (cfv (cv x3) A2) (cfv (cv x3) (cun A2 (csn (cop (cdm A2) X))))) con0)) (cdm A2)) $;

--| Extending a surreal with a negative sign results in a smaller surreal. (Contributed by Scott Fenton, 22-Nov-2021.)
theorem noextendlt (A2: class):
  $ wi (wcel A2 csur) (wbr (cun A2 (csn (cop (cdm A2) c1o))) A2 clts) $;

--| Extending a surreal with a positive sign results in a bigger surreal. (Contributed by Scott Fenton, 22-Nov-2021.)
theorem noextendgt (A2: class):
  $ wi (wcel A2 csur) (wbr A2 (cun A2 (csn (cop (cdm A2) c2o))) clts) $;

--| Given ` A ` less-than or equal to ` B ` , equal to ` B ` up to ` X ` , and ` A ( X ) = 2o ` , then ` B ( X ) = 2o ` . (Contributed by Scott Fenton, 6-Dec-2021.)
theorem nolesgn2o (A2 B2 X: class):
  $ wi (w3a (w3a (wcel A2 csur) (wcel B2 csur) (wcel X con0)) (wa (wceq (cres A2 X) (cres B2 X)) (wceq (cfv X A2) c2o)) (wn (wbr B2 A2 clts))) (wceq (cfv X B2) c2o) $;

--| Given ` A ` less-than or equal to ` B ` , equal to ` B ` up to ` X ` , and ` A ( X ) = 2o ` , then ` ( A |`` suc X ) = ( B |`` suc X ) ` . (Contributed by Scott Fenton, 6-Dec-2021.)
theorem nolesgn2ores (A2 B2 X: class):
  $ wi (w3a (w3a (wcel A2 csur) (wcel B2 csur) (wcel X con0)) (wa (wceq (cres A2 X) (cres B2 X)) (wceq (cfv X A2) c2o)) (wn (wbr B2 A2 clts))) (wceq (cres A2 (csuc X)) (cres B2 (csuc X))) $;

--| Given ` A ` greater than or equal to ` B ` , equal to ` B ` up to ` X ` , and ` A ( X ) = 1o ` , then ` B ( X ) = 1o ` . (Contributed by Scott Fenton, 9-Aug-2024.)
theorem nogesgn1o (A2 B2 X: class):
  $ wi (w3a (w3a (wcel A2 csur) (wcel B2 csur) (wcel X con0)) (wa (wceq (cres A2 X) (cres B2 X)) (wceq (cfv X A2) c1o)) (wn (wbr A2 B2 clts))) (wceq (cfv X B2) c1o) $;

--| Given ` A ` greater than or equal to ` B ` , equal to ` B ` up to ` X ` , and ` A ( X ) = 1o ` , then ` ( A |`` suc X ) = ( B |`` suc X ) ` . (Contributed by Scott Fenton, 6-Dec-2021.)
theorem nogesgn1ores (A2 B2 X: class):
  $ wi (w3a (w3a (wcel A2 csur) (wcel B2 csur) (wcel X con0)) (wa (wceq (cres A2 X) (cres B2 X)) (wceq (cfv X A2) c1o)) (wn (wbr A2 B2 clts))) (wceq (cres A2 (csuc X)) (cres B2 (csuc X))) $;

--| Lemma for ~ ltsso . The "sign expansion" binary relation totally orders the surreal signs. (Contributed by Scott Fenton, 8-Jun-2011.)
theorem ltssolem1:
  $ wor (cun (cpr c1o c2o) (csn c0)) (ctp (cop c1o c0) (cop c1o c2o) (cop c0 c2o)) $;

--| Less-than totally orders the surreals. Axiom O of [Alling] p. 184. (Contributed by Scott Fenton, 9-Jun-2011.)
theorem ltsso:
  $ wor csur clts $;

--| The birthday function maps the surreals onto the ordinals. Axiom B of [Alling] p. 184. (Proof shortened on 14-Apr-2012 by SF). (Contributed by Scott Fenton, 11-Jun-2011.)
theorem bdayfo:
  $ wfo csur con0 cbday $;

--| The value of a surreal at its birthday is ` (/) ` . (Contributed by Scott Fenton, 14-Jun-2011.) (Proof shortened by SF, 14-Apr-2012.)
theorem fvnobday (A2: class):
  $ wi (wcel A2 csur) (wceq (cfv (cfv A2 cbday) A2) c0) $;

--| Lemma for ~ nosepne . (Contributed by Scott Fenton, 24-Nov-2021.)
theorem nosepnelem {x3: setvar} (A2 B2: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wbr A2 B2 clts)) (wne (cfv (cint (crab x3 (wne (cfv (cv x3) A2) (cfv (cv x3) B2)) con0)) A2) (cfv (cint (crab x3 (wne (cfv (cv x3) A2) (cfv (cv x3) B2)) con0)) B2)) $;

--| The value of two non-equal surreals at the first place they differ is different. (Contributed by Scott Fenton, 24-Nov-2021.)
theorem nosepne {x3: setvar} (A2 B2: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wne A2 B2)) (wne (cfv (cint (crab x3 (wne (cfv (cv x3) A2) (cfv (cv x3) B2)) con0)) A2) (cfv (cint (crab x3 (wne (cfv (cv x3) A2) (cfv (cv x3) B2)) con0)) B2)) $;

--| If the value of a surreal at a separator is ` 1o ` then the surreal is lesser. (Contributed by Scott Fenton, 7-Dec-2021.)
theorem nosep1o {x3: setvar} (A2 B2: class):
  $ wi (wa (w3a (wcel A2 csur) (wcel B2 csur) (wne A2 B2)) (wceq (cfv (cint (crab x3 (wne (cfv (cv x3) A2) (cfv (cv x3) B2)) con0)) A2) c1o)) (wbr A2 B2 clts) $;

--| If the value of a surreal at a separator is ` 2o ` then the surreal is greater. (Contributed by Scott Fenton, 7-Dec-2021.)
theorem nosep2o {x3: setvar} (A2 B2: class):
  $ wi (wa (w3a (wcel A2 csur) (wcel B2 csur) (wne A2 B2)) (wceq (cfv (cint (crab x3 (wne (cfv (cv x3) B2) (cfv (cv x3) A2)) con0)) A2) c2o)) (wbr B2 A2 clts) $;

--| Lemma for ~ nosepdm . (Contributed by Scott Fenton, 24-Nov-2021.)
theorem nosepdmlem {x3: setvar} (A2 B2: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wbr A2 B2 clts)) (wcel (cint (crab x3 (wne (cfv (cv x3) A2) (cfv (cv x3) B2)) con0)) (cun (cdm A2) (cdm B2))) $;

--| The first place two surreals differ is an element of the larger of their domains. (Contributed by Scott Fenton, 24-Nov-2021.)
theorem nosepdm {x3: setvar} (A2 B2: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wne A2 B2)) (wcel (cint (crab x3 (wne (cfv (cv x3) A2) (cfv (cv x3) B2)) con0)) (cun (cdm A2) (cdm B2))) $;

--| The values of two surreals at a point less than their separators are equal. (Contributed by Scott Fenton, 6-Dec-2021.)
theorem nosepeq {x3: setvar} (A2 B2 X: class):
  $ wi (wa (w3a (wcel A2 csur) (wcel B2 csur) (wne A2 B2)) (wcel X (cint (crab x3 (wne (cfv (cv x3) A2) (cfv (cv x3) B2)) con0)))) (wceq (cfv X A2) (cfv X B2)) $;

--| Given two non-equal surreals, their separator is less-than or equal to the domain of one of them. Part of Lemma 2.1.1 of [Lipparini] p. 3. (Contributed by Scott Fenton, 6-Dec-2021.)
theorem nosepssdm {x3: setvar} (A2 B2: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wne A2 B2)) (wss (cint (crab x3 (wne (cfv (cv x3) A2) (cfv (cv x3) B2)) con0)) (cdm A2)) $;

--| Lemma for ~ nodense . Show that a particular abstraction is an ordinal. (Contributed by Scott Fenton, 16-Jun-2011.)
theorem nodenselem4 {a: setvar} (A2 B2: class):
  $ wi (wa (wa (wcel A2 csur) (wcel B2 csur)) (wbr A2 B2 clts)) (wcel (cint (crab a (wne (cfv (cv a) A2) (cfv (cv a) B2)) con0)) con0) $;

--| Lemma for ~ nodense . If the birthdays of two distinct surreals are equal, then the ordinal from ~ nodenselem4 is an element of that birthday. (Contributed by Scott Fenton, 16-Jun-2011.)
theorem nodenselem5 {a: setvar} (A2 B2: class):
  $ wi (wa (wa (wcel A2 csur) (wcel B2 csur)) (wa (wceq (cfv A2 cbday) (cfv B2 cbday)) (wbr A2 B2 clts))) (wcel (cint (crab a (wne (cfv (cv a) A2) (cfv (cv a) B2)) con0)) (cfv A2 cbday)) $;

--| The restriction of a surreal to the abstraction from ~ nodenselem4 is still a surreal. (Contributed by Scott Fenton, 16-Jun-2011.)
theorem nodenselem6 {a: setvar} (A2 B2: class):
  $ wi (wa (wa (wcel A2 csur) (wcel B2 csur)) (wa (wceq (cfv A2 cbday) (cfv B2 cbday)) (wbr A2 B2 clts))) (wcel (cres A2 (cint (crab a (wne (cfv (cv a) A2) (cfv (cv a) B2)) con0))) csur) $;

--| Lemma for ~ nodense . ` A ` and ` B ` are equal at all elements of the abstraction. (Contributed by Scott Fenton, 17-Jun-2011.)
theorem nodenselem7 {a: setvar} (A2 B2 C: class):
  $ wi (wa (wa (wcel A2 csur) (wcel B2 csur)) (wa (wceq (cfv A2 cbday) (cfv B2 cbday)) (wbr A2 B2 clts))) (wi (wcel C (cint (crab a (wne (cfv (cv a) A2) (cfv (cv a) B2)) con0))) (wceq (cfv C A2) (cfv C B2))) $;

--| Lemma for ~ nodense . Give a condition for surreal less-than when two surreals have the same birthday. (Contributed by Scott Fenton, 19-Jun-2011.)
theorem nodenselem8 {a: setvar} (A2 B2: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wceq (cfv A2 cbday) (cfv B2 cbday))) (wb (wbr A2 B2 clts) (wa (wceq (cfv (cint (crab a (wne (cfv (cv a) A2) (cfv (cv a) B2)) con0)) A2) c1o) (wceq (cfv (cint (crab a (wne (cfv (cv a) A2) (cfv (cv a) B2)) con0)) B2) c2o))) $;

--| Given two distinct surreals with the same birthday, there is an older surreal lying between the two of them. Axiom SD of [Alling] p. 184. (Contributed by Scott Fenton, 16-Jun-2011.)
theorem nodense {x3: setvar} (A2 B2: class):
  $ wi (wa (wa (wcel A2 csur) (wcel B2 csur)) (wa (wceq (cfv A2 cbday) (cfv B2 cbday)) (wbr A2 B2 clts))) (wrex x3 (w3a (wcel (cfv (cv x3) cbday) (cfv A2 cbday)) (wbr A2 (cv x3) clts) (wbr (cv x3) B2 clts)) csur) $;

--| Lemma for full-eta properties. The successor of the union of the image of the birthday function under a set is an ordinal. (Contributed by Scott Fenton, 20-Aug-2011.)
theorem bdayimaon (A2 V: class):
  $ wi (wcel A2 V) (wcel (csuc (cuni (cima cbday A2))) con0) $;

--| Lemma for ~ nolt02o . If ` A ( X ) ` is undefined with ` A ` surreal and ` X ` ordinal, then ` dom A C_ X ` . (Contributed by Scott Fenton, 6-Dec-2021.)
theorem nolt02olem (A2 X: class):
  $ wi (w3a (wcel A2 csur) (wcel X con0) (wceq (cfv X A2) c0)) (wss (cdm A2) X) $;

--| Given ` A ` less-than ` B ` , equal to ` B ` up to ` X ` , and undefined at ` X ` , then ` B ( X ) = 2o ` . (Contributed by Scott Fenton, 6-Dec-2021.)
theorem nolt02o (A2 B2 X: class):
  $ wi (w3a (w3a (wcel A2 csur) (wcel B2 csur) (wcel X con0)) (wa (wceq (cres A2 X) (cres B2 X)) (wbr A2 B2 clts)) (wceq (cfv X A2) c0)) (wceq (cfv X B2) c2o) $;

--| Given ` A ` greater than ` B ` , equal to ` B ` up to ` X ` , and ` B ( X ) ` undefined, then ` A ( X ) = 1o ` . (Contributed by Scott Fenton, 9-Aug-2024.)
theorem nogt01o (A2 B2 X: class):
  $ wi (w3a (w3a (wcel A2 csur) (wcel B2 csur) (wcel X con0)) (wa (wceq (cres A2 X) (cres B2 X)) (wbr A2 B2 clts)) (wceq (cfv X B2) c0)) (wceq (cfv X A2) c1o) $;

--| Restriction law for surreals. Lemma 2.1.4 of [Lipparini] p. 3. (Contributed by Scott Fenton, 5-Dec-2021.)
theorem noresle {g2: setvar} (A2 S U: class):
  $ wi (wa (wa (wcel U csur) (wcel S csur)) (w3a (wss (cdm U) A2) (wss (cdm S) A2) (wral g2 (wn (wbr (cres S (csuc (cv g2))) (cres U (csuc (cv g2))) clts)) A2))) (wn (wbr S U clts)) $;

--| A class of surreals has at most one maximum. (Contributed by Scott Fenton, 5-Dec-2021.)
theorem nomaxmo {x3 y1: setvar} (S: class):
  $ wi (wss S csur) (wrmo x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) S) S) $;

--| A class of surreals has at most one minimum. (Contributed by Scott Fenton, 8-Aug-2024.)
theorem nominmo {x3 y1: setvar} (S: class):
  $ wi (wss S csur) (wrmo x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) S) S) $;

--| In any class of surreals, there is at most one value of the prefix property. (Contributed by Scott Fenton, 26-Nov-2021.)
theorem nosupprefixmo {x3 v u: setvar} (A2 G: class):
  $ wi (wss A2 csur) (wmo x3 (wrex u (w3a (wcel G (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc G)) (cres (cv v) (csuc G)))) A2) (wceq (cfv G (cv u)) (cv x3))) A2)) $;

--| In any class of surreals, there is at most one value of the prefix property. (Contributed by Scott Fenton, 8-Aug-2024.)
theorem noinfprefixmo {x3 v u: setvar} (A2 G: class):
  $ wi (wss A2 csur) (wmo x3 (wrex u (w3a (wcel G (cdm (cv u))) (wral v (wi (wn (wbr (cv u) (cv v) clts)) (wceq (cres (cv u) (csuc G)) (cres (cv v) (csuc G)))) A2) (wceq (cfv G (cv u)) (cv x3))) A2)) $;

--| Lemma to change bound variables in a surreal supremum. (Contributed by Scott Fenton, 9-Aug-2024.)
theorem nosupcbv {x3 y1 v u e f2 g2 a b c d: setvar} (A2: class) (S: class x3 y1 v u e f2 g2 a b c d):
  $ wceq S (cif (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (cun (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) c2o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) A2)) A2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) A2) (wceq (cfv (cv g2) (cv u)) (cv x3))) A2)))) $ >
  $ wceq S (cif (wrex a (wral b (wn (wbr (cv a) (cv b) clts)) A2) A2) (cun (crio a (wral b (wn (wbr (cv a) (cv b) clts)) A2) A2) (csn (cop (cdm (crio a (wral b (wn (wbr (cv a) (cv b) clts)) A2) A2)) c2o))) (cmpt c (cab d (wrex e (wa (wcel (cv d) (cdm (cv e))) (wral f2 (wi (wn (wbr (cv f2) (cv e) clts)) (wceq (cres (cv e) (csuc (cv d))) (cres (cv f2) (csuc (cv d))))) A2)) A2)) (cio a (wrex e (w3a (wcel (cv c) (cdm (cv e))) (wral f2 (wi (wn (wbr (cv f2) (cv e) clts)) (wceq (cres (cv e) (csuc (cv c))) (cres (cv f2) (csuc (cv c))))) A2) (wceq (cfv (cv c) (cv e)) (cv a))) A2)))) $;

--| Lemma to change bound variables in a surreal supremum. (Contributed by Scott Fenton, 9-Aug-2024.)
theorem nosupcbv_b {x3 y1 v u e f2 g2 a b c: setvar} (A2: class) (S: class x3 y1 v u e f2 g2 a b c):
  $ wceq S (cif (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (cun (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) c2o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) A2)) A2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) A2) (wceq (cfv (cv g2) (cv u)) (cv x3))) A2)))) $ >
  $ wceq S (cif (wrex a (wral b (wn (wbr (cv a) (cv b) clts)) A2) A2) (cun (crio a (wral b (wn (wbr (cv a) (cv b) clts)) A2) A2) (csn (cop (cdm (crio a (wral b (wn (wbr (cv a) (cv b) clts)) A2) A2)) c2o))) (cmpt c (cab b (wrex e (wa (wcel (cv b) (cdm (cv e))) (wral f2 (wi (wn (wbr (cv f2) (cv e) clts)) (wceq (cres (cv e) (csuc (cv b))) (cres (cv f2) (csuc (cv b))))) A2)) A2)) (cio a (wrex e (w3a (wcel (cv c) (cdm (cv e))) (wral f2 (wi (wn (wbr (cv f2) (cv e) clts)) (wceq (cres (cv e) (csuc (cv c))) (cres (cv f2) (csuc (cv c))))) A2) (wceq (cfv (cv c) (cv e)) (cv a))) A2)))) $;

--| The next several theorems deal with a surreal "supremum". This surreal will ultimately be shown to bound ` A ` below and bound the restriction of any surreal above. We begin by showing that the given expression actually defines a surreal number. (Contributed by Scott Fenton, 5-Dec-2021.)
theorem nosupno {x3 y1 v u g2: setvar} (A2: class) (S V: class x3 y1 v u g2):
  $ wceq S (cif (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (cun (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) c2o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) A2)) A2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) A2) (wceq (cfv (cv g2) (cv u)) (cv x3))) A2)))) $ >
  $ wi (wa (wss A2 csur) (wcel A2 V)) (wcel S csur) $;

--| The domain of the surreal supremum when there is no maximum. The primary point of this theorem is to change bound variable. (Contributed by Scott Fenton, 6-Dec-2021.)
theorem nosupdm {x3 y1 z v u g2 q p: setvar} (A2: class x3) (S: class x3 y1 z v u g2 q p):
  $ wceq S (cif (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (cun (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) c2o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) A2)) A2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) A2) (wceq (cfv (cv g2) (cv u)) (cv x3))) A2)))) $ >
  $ wi (wn (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) (wceq (cdm S) (cab z (wrex p (wa (wcel (cv z) (cdm (cv p))) (wral q (wi (wn (wbr (cv q) (cv p) clts)) (wceq (cres (cv p) (csuc (cv z))) (cres (cv q) (csuc (cv z))))) A2)) A2))) $;

--| The domain of the surreal supremum when there is no maximum. The primary point of this theorem is to change bound variable. (Contributed by Scott Fenton, 6-Dec-2021.)
theorem nosupdm_b {x3 y1 z v u q p: setvar} (A2: class x3) (S: class x3 y1 z v u q p):
  $ wceq S (cif (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (cun (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) c2o))) (cmpt z (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) A2)) A2)) (cio x3 (wrex u (w3a (wcel (cv z) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv z))) (cres (cv v) (csuc (cv z))))) A2) (wceq (cfv (cv z) (cv u)) (cv x3))) A2)))) $ >
  $ wi (wn (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) (wceq (cdm S) (cab z (wrex p (wa (wcel (cv z) (cdm (cv p))) (wral q (wi (wn (wbr (cv q) (cv p) clts)) (wceq (cres (cv p) (csuc (cv z))) (cres (cv q) (csuc (cv z))))) A2)) A2))) $;

--| Birthday bounding law for surreal supremum. (Contributed by Scott Fenton, 5-Dec-2021.)
theorem nosupbday {x3 y1 v u g2: setvar} (A2: class) (S: class x3 y1 v u g2) (O: class x3 v g2):
  $ wceq S (cif (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (cun (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) c2o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) A2)) A2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) A2) (wceq (cfv (cv g2) (cv u)) (cv x3))) A2)))) $ >
  $ wi (wa (wa (wss A2 csur) (wcel A2 cvv)) (wa (wcel O con0) (wss (cima cbday A2) O))) (wss (cfv S cbday) O) $;

--| The value of surreal supremum when there is no maximum. (Contributed by Scott Fenton, 5-Dec-2021.)
theorem nosupfv {x3 y1 v u g2: setvar} (A2: class) (S: class x3 y1 v u g2) (U: class y1 g2) (G: class):
  $ wceq S (cif (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (cun (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) c2o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) A2)) A2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) A2) (wceq (cfv (cv g2) (cv u)) (cv x3))) A2)))) $ >
  $ wi (w3a (wn (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) (wa (wss A2 csur) (wcel A2 cvv)) (w3a (wcel U A2) (wcel G (cdm U)) (wral v (wi (wn (wbr (cv v) U clts)) (wceq (cres U (csuc G)) (cres (cv v) (csuc G)))) A2))) (wceq (cfv G S) (cfv G U)) $;

--| A restriction law for surreal supremum when there is no maximum. (Contributed by Scott Fenton, 5-Dec-2021.)
theorem nosupres {x3 y1 v u g2: setvar} (A2: class) (S: class x3 y1 v u g2) (U: class y1 g2) (G: class x3 g2):
  $ wceq S (cif (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (cun (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) c2o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) A2)) A2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) A2) (wceq (cfv (cv g2) (cv u)) (cv x3))) A2)))) $ >
  $ wi (w3a (wn (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) (wa (wss A2 csur) (wcel A2 cvv)) (w3a (wcel U A2) (wcel G (cdm U)) (wral v (wi (wn (wbr (cv v) U clts)) (wceq (cres U (csuc G)) (cres (cv v) (csuc G)))) A2))) (wceq (cres S (csuc G)) (cres U (csuc G))) $;

--| Lemma for ~ nosupbnd1 . Establish a soft upper bound. (Contributed by Scott Fenton, 5-Dec-2021.)
theorem nosupbnd1lem1 {x3 y1 v u g2: setvar} (A2: class) (S: class x3 y1 v u g2) (U: class x3 y1 u g2):
  $ wceq S (cif (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (cun (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) c2o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) A2)) A2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) A2) (wceq (cfv (cv g2) (cv u)) (cv x3))) A2)))) $ >
  $ wi (w3a (wn (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) (wa (wss A2 csur) (wcel A2 cvv)) (wcel U A2)) (wn (wbr S (cres U (cdm S)) clts)) $;

--| Lemma for ~ nosupbnd1 . When there is no maximum, if any member of ` A ` is a prolongment of ` S ` , then so are all elements of ` A ` above it. (Contributed by Scott Fenton, 5-Dec-2021.)
theorem nosupbnd1lem2 {x3 y1 v u g2: setvar} (A2: class) (S U: class x3 y1 v u g2) (W: class x3 y1 u g2):
  $ wceq S (cif (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (cun (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) c2o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) A2)) A2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) A2) (wceq (cfv (cv g2) (cv u)) (cv x3))) A2)))) $ >
  $ wi (w3a (wn (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) (wa (wss A2 csur) (wcel A2 cvv)) (wa (wa (wcel U A2) (wceq (cres U (cdm S)) S)) (wa (wcel W A2) (wn (wbr W U clts))))) (wceq (cres W (cdm S)) S) $;

--| Lemma for ~ nosupbnd1 . If ` U ` is a prolongment of ` S ` and in ` A ` , then ` ( U `` dom S ) ` is not ` 2o ` . (Contributed by Scott Fenton, 6-Dec-2021.)
theorem nosupbnd1lem3 {x3 y1 v u g2: setvar} (A2: class) (S U: class x3 y1 v u g2):
  $ wceq S (cif (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (cun (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) c2o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) A2)) A2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) A2) (wceq (cfv (cv g2) (cv u)) (cv x3))) A2)))) $ >
  $ wi (w3a (wn (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) (wa (wss A2 csur) (wcel A2 cvv)) (wa (wcel U A2) (wceq (cres U (cdm S)) S))) (wne (cfv (cdm S) U) c2o) $;

--| Lemma for ~ nosupbnd1 . If ` U ` is a prolongment of ` S ` and in ` A ` , then ` ( U `` dom S ) ` is not undefined. (Contributed by Scott Fenton, 6-Dec-2021.)
theorem nosupbnd1lem4 {x3 y1 v u g2: setvar} (A2: class) (S: class x3 y1 v u g2) (U: class x3 y1 v g2):
  $ wceq S (cif (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (cun (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) c2o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) A2)) A2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) A2) (wceq (cfv (cv g2) (cv u)) (cv x3))) A2)))) $ >
  $ wi (w3a (wn (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) (wa (wss A2 csur) (wcel A2 cvv)) (wa (wcel U A2) (wceq (cres U (cdm S)) S))) (wne (cfv (cdm S) U) c0) $;

--| Lemma for ~ nosupbnd1 . If ` U ` is a prolongment of ` S ` and in ` A ` , then ` ( U `` dom S ) ` is not ` 1o ` . (Contributed by Scott Fenton, 6-Dec-2021.)
theorem nosupbnd1lem5 {x3 y1 v u g2: setvar} (A2: class) (S U: class x3 y1 v u g2):
  $ wceq S (cif (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (cun (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) c2o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) A2)) A2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) A2) (wceq (cfv (cv g2) (cv u)) (cv x3))) A2)))) $ >
  $ wi (w3a (wn (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) (wa (wss A2 csur) (wcel A2 cvv)) (wa (wcel U A2) (wceq (cres U (cdm S)) S))) (wne (cfv (cdm S) U) c1o) $;

--| Lemma for ~ nosupbnd1 . Establish a hard upper bound when there is no maximum. (Contributed by Scott Fenton, 6-Dec-2021.)
theorem nosupbnd1lem6 {x3 y1 v u g2: setvar} (A2: class) (S: class x3 y1 v u g2) (U: class x3 y1 g2):
  $ wceq S (cif (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (cun (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) c2o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) A2)) A2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) A2) (wceq (cfv (cv g2) (cv u)) (cv x3))) A2)))) $ >
  $ wi (w3a (wn (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) (wa (wss A2 csur) (wcel A2 cvv)) (wcel U A2)) (wbr (cres U (cdm S)) S clts) $;

--| Bounding law from below for the surreal supremum. Proposition 4.2 of [Lipparini] p. 6. (Contributed by Scott Fenton, 6-Dec-2021.)
theorem nosupbnd1 {x3 y1 v u g2: setvar} (A2: class) (S: class x3 y1 v u g2) (U: class g2):
  $ wceq S (cif (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (cun (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) c2o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) A2)) A2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) A2) (wceq (cfv (cv g2) (cv u)) (cv x3))) A2)))) $ >
  $ wi (w3a (wss A2 csur) (wcel A2 cvv) (wcel U A2)) (wbr (cres U (cdm S)) S clts) $;

--| Bounding law from above when a set of surreals has a maximum. (Contributed by Scott Fenton, 6-Dec-2021.)
theorem nosupbnd2lem1 {y1 a: setvar} (A2 U Z: class y1):
  $ wi (w3a (wa (wcel U A2) (wral y1 (wn (wbr U (cv y1) clts)) A2)) (w3a (wss A2 csur) (wcel A2 cvv) (wcel Z csur)) (wral a (wbr (cv a) Z clts) A2)) (wn (wbr (cres Z (csuc (cdm U))) (cun U (csn (cop (cdm U) c2o))) clts)) $;

--| Bounding law from above for the surreal supremum. Proposition 4.3 of [Lipparini] p. 6. (Contributed by Scott Fenton, 6-Dec-2021.)
theorem nosupbnd2 {x3 y1 v u g2 a: setvar} (A2: class) (S: class x3 y1 v u) (Z: class y1 v u):
  $ wceq S (cif (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (cun (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) c2o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) A2)) A2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) A2) (wceq (cfv (cv g2) (cv u)) (cv x3))) A2)))) $ >
  $ wi (w3a (wss A2 csur) (wcel A2 cvv) (wcel Z csur)) (wb (wral a (wbr (cv a) Z clts) A2) (wn (wbr (cres Z (cdm S)) S clts))) $;

--| Change bound variables for surreal infimum. (Contributed by Scott Fenton, 9-Aug-2024.)
theorem noinfcbv {x3 y1 v u e g2 a b c d: setvar} (B2: class) (T: class x3 y1 v u e g2 a b c d):
  $ wceq T (cif (wrex x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2) (cun (crio x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2)) c1o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv u) (cv v) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) B2)) B2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv u) (cv v) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) B2) (wceq (cfv (cv g2) (cv u)) (cv x3))) B2)))) $ >
  $ wceq T (cif (wrex a (wral b (wn (wbr (cv b) (cv a) clts)) B2) B2) (cun (crio a (wral b (wn (wbr (cv b) (cv a) clts)) B2) B2) (csn (cop (cdm (crio a (wral b (wn (wbr (cv b) (cv a) clts)) B2) B2)) c1o))) (cmpt c (cab b (wrex d (wa (wcel (cv b) (cdm (cv d))) (wral e (wi (wn (wbr (cv d) (cv e) clts)) (wceq (cres (cv d) (csuc (cv b))) (cres (cv e) (csuc (cv b))))) B2)) B2)) (cio a (wrex d (w3a (wcel (cv c) (cdm (cv d))) (wral e (wi (wn (wbr (cv d) (cv e) clts)) (wceq (cres (cv d) (csuc (cv c))) (cres (cv e) (csuc (cv c))))) B2) (wceq (cfv (cv c) (cv d)) (cv a))) B2)))) $;

--| The next several theorems deal with a surreal "infimum". This surreal will ultimately be shown to bound ` B ` above and bound the restriction of any surreal below. We begin by showing that the given expression actually defines a surreal number. (Contributed by Scott Fenton, 8-Aug-2024.)
theorem noinfno {x3 y1 v u g2: setvar} (B2: class) (T: class x3 y1 v u g2) (V: class x3 y1 v u):
  $ wceq T (cif (wrex x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2) (cun (crio x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2)) c1o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv u) (cv v) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) B2)) B2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv u) (cv v) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) B2) (wceq (cfv (cv g2) (cv u)) (cv x3))) B2)))) $ >
  $ wi (wa (wss B2 csur) (wcel B2 V)) (wcel T csur) $;

--| Next, we calculate the domain of ` T ` . This is mostly to change bound variables. (Contributed by Scott Fenton, 8-Aug-2024.)
theorem noinfdm {x3 y1 z v u g2 q p: setvar} (B2: class x3) (T: class x3 y1 z v u g2 q p):
  $ wceq T (cif (wrex x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2) (cun (crio x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2)) c1o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv u) (cv v) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) B2)) B2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv u) (cv v) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) B2) (wceq (cfv (cv g2) (cv u)) (cv x3))) B2)))) $ >
  $ wi (wn (wrex x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2)) (wceq (cdm T) (cab z (wrex p (wa (wcel (cv z) (cdm (cv p))) (wral q (wi (wn (wbr (cv p) (cv q) clts)) (wceq (cres (cv p) (csuc (cv z))) (cres (cv q) (csuc (cv z))))) B2)) B2))) $;

--| Next, we calculate the domain of ` T ` . This is mostly to change bound variables. (Contributed by Scott Fenton, 8-Aug-2024.)
theorem noinfdm_b {x3 y1 z v u q p: setvar} (B2: class x3) (T: class x3 y1 z v u q p):
  $ wceq T (cif (wrex x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2) (cun (crio x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2)) c1o))) (cmpt z (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv u) (cv v) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) B2)) B2)) (cio x3 (wrex u (w3a (wcel (cv z) (cdm (cv u))) (wral v (wi (wn (wbr (cv u) (cv v) clts)) (wceq (cres (cv u) (csuc (cv z))) (cres (cv v) (csuc (cv z))))) B2) (wceq (cfv (cv z) (cv u)) (cv x3))) B2)))) $ >
  $ wi (wn (wrex x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2)) (wceq (cdm T) (cab z (wrex p (wa (wcel (cv z) (cdm (cv p))) (wral q (wi (wn (wbr (cv p) (cv q) clts)) (wceq (cres (cv p) (csuc (cv z))) (cres (cv q) (csuc (cv z))))) B2)) B2))) $;

--| Birthday bounding law for surreal infimum. (Contributed by Scott Fenton, 8-Aug-2024.)
theorem noinfbday {x3 y1 v u g2: setvar} (B2: class) (T O: class x3 y1 v u g2) (V: class x3 y1 v u):
  $ wceq T (cif (wrex x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2) (cun (crio x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2)) c1o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv u) (cv v) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) B2)) B2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv u) (cv v) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) B2) (wceq (cfv (cv g2) (cv u)) (cv x3))) B2)))) $ >
  $ wi (wa (wa (wss B2 csur) (wcel B2 V)) (wa (wcel O con0) (wss (cima cbday B2) O))) (wss (cfv T cbday) O) $;


--| A piecewise continuous function is integrable on any closed interval. This lemma uses local definitions, so that the proof is more readable. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem fourierdlem100 {x3 y1 f2 i k m p: setvar} (ph: wff m p) (A2 B2: class) (C D: class k) (P: class x3 y1 f2 i k m p) (Q: class m) (R: class f2 i k m p) (S: class m) (T E: class m p) (F: class f2 k m p) (H: class i k m p) (I: class m p) (J: class f2 k m p) (L: class f2 i k m p) (M: class f2 k) (N: class) (O: class x3 y1 f2 i k m p):
  $ wceq P (cmpt m cn (crab p (wa (wa (wceq (cfv cc0 (cv p)) A2) (wceq (cfv (cv m) (cv p)) B2)) (wral i (wbr (cfv (cv i) (cv p)) (cfv (co (cv i) c1 caddc) (cv p)) clt) (co cc0 (cv m) cfzo))) (co cr (co cc0 (cv m) cfz) cmap))) $ >
  $ wceq T (co B2 A2 cmin) $ >
  $ wi ph (wcel M cn) $ >
  $ wi ph (wcel Q (cfv M P)) $ >
  $ wi ph (wf cr cc F) $ >
  $ wi (wa ph (wcel (cv x3) cr)) (wceq (cfv (co (cv x3) T caddc) F) (cfv (cv x3) F)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (co (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo) cc ccncf)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel R (co (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (cfv (cv i) Q) climc)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel L (co (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (cfv (co (cv i) c1 caddc) Q) climc)) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wcel D (co C cpnf cioo)) $ >
  $ wceq O (cmpt m cn (crab p (wa (wa (wceq (cfv cc0 (cv p)) C) (wceq (cfv (cv m) (cv p)) D)) (wral i (wbr (cfv (cv i) (cv p)) (cfv (co (cv i) c1 caddc) (cv p)) clt) (co cc0 (cv m) cfzo))) (co cr (co cc0 (cv m) cfz) cmap))) $ >
  $ wceq N (co (cfv H chash) c1 cmin) $ >
  $ wceq H (cun (cpr C D) (crab y1 (wrex k (wcel (co (cv y1) (co (cv k) T cmul) caddc) (crn Q)) cz) (co C D cicc))) $ >
  $ wceq S (cio f2 (wiso (co cc0 N cfz) H clt clt (cv f2))) $ >
  $ wceq E (cmpt x3 cr (co (cv x3) (co (cfv (co (co B2 (cv x3) cmin) T cdiv) cfl) T cmul) caddc)) $ >
  $ wceq J (cmpt y1 (co A2 B2 cioc) (cif (wceq (cv y1) B2) A2 (cv y1))) $ >
  $ wceq I (cmpt x3 cr (csup (crab i (wbr (cfv (cv i) Q) (cfv (cfv (cv x3) E) J) cle) (co cc0 M cfzo)) cr clt)) $ >
  $ wi ph (wcel (cmpt x3 (co C D cicc) (cfv (cv x3) F)) cibl) $;

--| Integral by substitution for a piecewise continuous function. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem fourierdlem101 {t i m n s1 p: setvar} (ph: wff m p) (D: class i m n p) (P: class t i m n s1 p) (Q: class m n) (R F: class i m n s1 p) (G: class m n p) (L: class i m n s1 p) (M: class n) (N: class i m p) (X: class m n p):
  $ wceq D (cmpt n cn (cmpt s1 cr (cif (wceq (co (cv s1) (co c2 cpi cmul) cmo) cc0) (co (co (co c2 (cv n) cmul) c1 caddc) (co c2 cpi cmul) cdiv) (co (cfv (co (co (cv n) (co c1 c2 cdiv) caddc) (cv s1) cmul) csin) (co (co c2 cpi cmul) (cfv (co (cv s1) c2 cdiv) csin) cmul) cdiv)))) $ >
  $ wceq P (cmpt m cn (crab p (wa (wa (wceq (cfv cc0 (cv p)) (cneg cpi)) (wceq (cfv (cv m) (cv p)) cpi)) (wral i (wbr (cfv (cv i) (cv p)) (cfv (co (cv i) c1 caddc) (cv p)) clt) (co cc0 (cv m) cfzo))) (co cr (co cc0 (cv m) cfz) cmap))) $ >
  $ wceq G (cmpt t (co (cneg cpi) cpi cicc) (co (cfv (cv t) F) (cfv (co (cv t) X cmin) (cfv N D)) cmul)) $ >
  $ wi ph (wcel Q (cfv M P)) $ >
  $ wi ph (wcel M cn) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel X cr) $ >
  $ wi ph (wf (co (cneg cpi) cpi cicc) cc F) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (co (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo) cc ccncf)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel R (co (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (cfv (cv i) Q) climc)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel L (co (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (cfv (co (cv i) c1 caddc) Q) climc)) $ >
  $ wi ph (wceq (citg t (co (cneg cpi) cpi cicc) (co (cfv (cv t) F) (cfv (co (cv t) X cmin) (cfv N D)) cmul)) (citg s1 (co (co (cneg cpi) X cmin) (co cpi X cmin) cicc) (co (cfv (co X (cv s1) caddc) F) (cfv (cv s1) (cfv N D)) cmul))) $;

--| Integral by substitution for a piecewise continuous function. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem fourierdlem101_b {t i m s1 p: setvar} (ph: wff p) (D: class i m p) (P: class t i m s1 p) (Q: class m) (R F: class i m s1 p) (G: class m p) (L: class i m s1 p) (M: class) (N: class i p) (X: class m p):
  $ wceq D (cmpt m cn (cmpt s1 cr (cif (wceq (co (cv s1) (co c2 cpi cmul) cmo) cc0) (co (co (co c2 (cv m) cmul) c1 caddc) (co c2 cpi cmul) cdiv) (co (cfv (co (co (cv m) (co c1 c2 cdiv) caddc) (cv s1) cmul) csin) (co (co c2 cpi cmul) (cfv (co (cv s1) c2 cdiv) csin) cmul) cdiv)))) $ >
  $ wceq P (cmpt m cn (crab p (wa (wa (wceq (cfv cc0 (cv p)) (cneg cpi)) (wceq (cfv (cv m) (cv p)) cpi)) (wral i (wbr (cfv (cv i) (cv p)) (cfv (co (cv i) c1 caddc) (cv p)) clt) (co cc0 (cv m) cfzo))) (co cr (co cc0 (cv m) cfz) cmap))) $ >
  $ wceq G (cmpt t (co (cneg cpi) cpi cicc) (co (cfv (cv t) F) (cfv (co (cv t) X cmin) (cfv N D)) cmul)) $ >
  $ wi ph (wcel Q (cfv M P)) $ >
  $ wi ph (wcel M cn) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel X cr) $ >
  $ wi ph (wf (co (cneg cpi) cpi cicc) cc F) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (co (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo) cc ccncf)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel R (co (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (cfv (cv i) Q) climc)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel L (co (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (cfv (co (cv i) c1 caddc) Q) climc)) $ >
  $ wi ph (wceq (citg t (co (cneg cpi) cpi cicc) (co (cfv (cv t) F) (cfv (co (cv t) X cmin) (cfv N D)) cmul)) (citg s1 (co (co (cneg cpi) X cmin) (co cpi X cmin) cicc) (co (cfv (co X (cv s1) caddc) F) (cfv (cv s1) (cfv N D)) cmul))) $;

--| For a piecewise smooth function, the left and the right limits exist at any point. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem fourierdlem102 {x3 g2 i n p: setvar} (ph: wff p) (P: class x3 g2 i n p) (Q: class) (T: class g2) (E: class g2 i n p) (F: class g2 p) (G: class g2 n p) (H: class x3 i n p) (M: class) (X: class g2):
  $ wi ph (wf cr cr F) $ >
  $ wceq T (co c2 cpi cmul) $ >
  $ wi (wa ph (wcel (cv x3) cr)) (wceq (cfv (co (cv x3) T caddc) F) (cfv (cv x3) F)) $ >
  $ wceq G (cres (co cr F cdv) (co (cneg cpi) cpi cioo)) $ >
  $ wi ph (wcel (cdif (co (cneg cpi) cpi cioo) (cdm G)) cfn) $ >
  $ wi ph (wcel G (co (cdm G) cc ccncf)) $ >
  $ wi (wa ph (wcel (cv x3) (cdif (co (cneg cpi) cpi cico) (cdm G)))) (wne (co (cres G (co (cv x3) cpnf cioo)) (cv x3) climc) c0) $ >
  $ wi (wa ph (wcel (cv x3) (cdif (co (cneg cpi) cpi cioc) (cdm G)))) (wne (co (cres G (co cmnf (cv x3) cioo)) (cv x3) climc) c0) $ >
  $ wi ph (wcel X cr) $ >
  $ wceq P (cmpt n cn (crab p (wa (wa (wceq (cfv cc0 (cv p)) (cneg cpi)) (wceq (cfv (cv n) (cv p)) cpi)) (wral i (wbr (cfv (cv i) (cv p)) (cfv (co (cv i) c1 caddc) (cv p)) clt) (co cc0 (cv n) cfzo))) (co cr (co cc0 (cv n) cfz) cmap))) $ >
  $ wceq E (cmpt x3 cr (co (cv x3) (co (cfv (co (co cpi (cv x3) cmin) T cdiv) cfl) T cmul) caddc)) $ >
  $ wceq H (cun (ctp (cneg cpi) cpi (cfv X E)) (cdif (co (cneg cpi) cpi cicc) (cdm G))) $ >
  $ wceq M (co (cfv H chash) c1 cmin) $ >
  $ wceq Q (cio g2 (wiso (co cc0 M cfz) H clt clt (cv g2))) $ >
  $ wi ph (wa (wne (co (cres F (co cmnf X cioo)) X climc) c0) (wne (co (cres F (co X cpnf cioo)) X climc) c0)) $;

--| The half lower part of the integral equal to the fourier partial sum, converges to half the left limit of the original function. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem fourierdlem103 {z w t e f2 i k m n s1 p d l: setvar} (ph: wff p) (ch: wff z w t e f2 i k m n p d l) (A2 B2: class z w t e f2 i k m n p d l) (C: class e f2 k m n s1 p d l) (D: class z w t e f2 k n p d l) (P: class z w t e f2 i k m n s1 p d l) (Q: class z w e f2 k m n d) (R: class z w e f2 i k m n p d) (S: class z w t e f2 i k m n p d l) (T: class z w t e i k m n s1 p d l) (U: class z w t e f2 i m p) (E: class z w t e f2 i k m s1 p d l) (F: class e f2 n p d) (G: class z w f2 m n p d l) (H: class z w t e f2 k m n p d l) (J: class e n p d) (K: class z w t e f2 i k m n p d l) (L: class z w e f2 i k m n p d) (M: class z w e f2 n d) (N: class n p d) (O: class z w f2 i m n p d) (V: class z w e f2 m n d l) (W: class e f2 p d) (X: class e f2 n d) (Y: class z w t e f2 i k m n p d l) (Z: class z w t e f2 i k m s1 p d l):
  $ wi ph (wf cr cr F) $ >
  $ wi ph (wcel X cr) $ >
  $ wceq P (cmpt m cn (crab p (wa (wa (wceq (cfv cc0 (cv p)) (co (cneg cpi) X caddc)) (wceq (cfv (cv m) (cv p)) (co cpi X caddc))) (wral i (wbr (cfv (cv i) (cv p)) (cfv (co (cv i) c1 caddc) (cv p)) clt) (co cc0 (cv m) cfzo))) (co cr (co cc0 (cv m) cfz) cmap))) $ >
  $ wi ph (wcel M cn) $ >
  $ wi ph (wcel V (cfv M P)) $ >
  $ wi ph (wcel X (crn V)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel (cres F (co (cfv (cv i) V) (cfv (co (cv i) c1 caddc) V) cioo)) (co (co (cfv (cv i) V) (cfv (co (cv i) c1 caddc) V) cioo) cc ccncf)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wrex w (wral t (wbr (cfv (cfv (cv t) F) cabs) (cv w) cle) (co (cfv (cv i) V) (cfv (co (cv i) c1 caddc) V) cioo)) cr) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel (cres (co cr F cdv) (co (cfv (cv i) V) (cfv (co (cv i) c1 caddc) V) cioo)) (co (co (cfv (cv i) V) (cfv (co (cv i) c1 caddc) V) cioo) cr ccncf)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wrex z (wral t (wbr (cfv (cfv (cv t) (co cr F cdv)) cabs) (cv z) cle) (co (cfv (cv i) V) (cfv (co (cv i) c1 caddc) V) cioo)) cr) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel R (co (cres F (co (cfv (cv i) V) (cfv (co (cv i) c1 caddc) V) cioo)) (cfv (cv i) V) climc)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel L (co (cres F (co (cfv (cv i) V) (cfv (co (cv i) c1 caddc) V) cioo)) (cfv (co (cv i) c1 caddc) V) climc)) $ >
  $ wceq H (cmpt s1 (co (cneg cpi) cpi cicc) (cif (wceq (cv s1) cc0) cc0 (co (co (cfv (co X (cv s1) caddc) F) (cif (wbr cc0 (cv s1) clt) Y W) cmin) (cv s1) cdiv))) $ >
  $ wceq K (cmpt s1 (co (cneg cpi) cpi cicc) (cif (wceq (cv s1) cc0) c1 (co (cv s1) (co c2 (cfv (co (cv s1) c2 cdiv) csin) cmul) cdiv))) $ >
  $ wceq U (cmpt s1 (co (cneg cpi) cpi cicc) (co (cfv (cv s1) H) (cfv (cv s1) K) cmul)) $ >
  $ wceq S (cmpt s1 (co (cneg cpi) cpi cicc) (cfv (co (co (cv n) (co c1 c2 cdiv) caddc) (cv s1) cmul) csin)) $ >
  $ wceq G (cmpt s1 (co (cneg cpi) cpi cicc) (co (cfv (cv s1) U) (cfv (cv s1) S) cmul)) $ >
  $ wceq Z (cmpt m cn (citg s1 (co (cneg cpi) cc0 cioo) (co (cfv (co X (cv s1) caddc) F) (cfv (cv s1) (cfv (cv m) D)) cmul))) $ >
  $ wceq E (cmpt n cn (co (citg s1 (co (cneg cpi) cc0 cioo) (cfv (cv s1) G)) cpi cdiv)) $ >
  $ wi ph (wcel Y (co (cres F (co X cpnf cioo)) X climc)) $ >
  $ wi ph (wcel W (co (cres F (co cmnf X cioo)) X climc)) $ >
  $ wi ph (wcel A2 (co (cres (co cr F cdv) (co cmnf X cioo)) X climc)) $ >
  $ wi ph (wcel B2 (co (cres (co cr F cdv) (co X cpnf cioo)) X climc)) $ >
  $ wceq D (cmpt n cn (cmpt s1 cr (cif (wceq (co (cv s1) (co c2 cpi cmul) cmo) cc0) (co (co (co c2 (cv n) cmul) c1 caddc) (co c2 cpi cmul) cdiv) (co (cfv (co (co (cv n) (co c1 c2 cdiv) caddc) (cv s1) cmul) csin) (co (co c2 cpi cmul) (cfv (co (cv s1) c2 cdiv) csin) cmul) cdiv)))) $ >
  $ wceq O (cres U (co (cneg cpi) (cv d) cicc)) $ >
  $ wceq T (cun (cpr (cneg cpi) (cv d)) (cin (crn Q) (co (cneg cpi) (cv d) cioo))) $ >
  $ wceq N (co (cfv T chash) c1 cmin) $ >
  $ wceq J (cio f2 (wiso (co cc0 N cfz) T clt clt (cv f2))) $ >
  $ wceq Q (cmpt i (co cc0 M cfz) (co (cfv (cv i) V) X cmin)) $ >
  $ wceq C (crio l (wss (co (cfv (cv k) J) (cfv (co (cv k) c1 caddc) J) cioo) (co (cfv (cv l) Q) (cfv (co (cv l) c1 caddc) Q) cioo)) (co cc0 M cfzo)) $ >
  $ wb ch (wa (wa (wa (wa (wa ph (wcel (cv e) crp)) (wcel (cv d) (co (cneg cpi) cc0 cioo))) (wcel (cv k) cn)) (wbr (cfv (citg s1 (co (cv d) cc0 cioo) (co (cfv (cv s1) U) (cfv (co (co (cv k) (co c1 c2 cdiv) caddc) (cv s1) cmul) csin) cmul)) cabs) (co (cv e) c2 cdiv) clt)) (wbr (cfv (citg s1 (co (cneg cpi) (cv d) cioo) (co (cfv (cv s1) U) (cfv (co (co (cv k) (co c1 c2 cdiv) caddc) (cv s1) cmul) csin) cmul)) cabs) (co (cv e) c2 cdiv) clt)) $ >
  $ wi ph (wbr Z (co W c2 cdiv) cli) $;

--| The half lower part of the integral equal to the fourier partial sum, converges to half the left limit of the original function. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem fourierdlem103_b1 {z w t e k m n s1 p d l: setvar} (ph: wff p) (ch: wff z w t e k m n p d l) (A2 B2: class z w t e k m n p d l) (C: class k m n s1 p d l) (D: class z w t k n p d l) (P: class z w t e k m n s1 p d l) (Q: class z w k m n d) (R: class z w e k m n p d) (S: class z w t e k m n p d l) (T: class z t e k m n s1 p d l) (U: class z w t e m p) (E: class z w t e k m s1 p d l) (F: class n p d) (G: class z w m n p d l) (H: class z w t k m n p d l) (J: class n p d) (K: class z w t e k m n p d l) (L: class z w e k m n p d) (M: class z w n d) (N: class n p d) (O: class z w m n p d) (V: class z w m n d l) (W: class p d) (X: class n d) (Y: class z w t e k m n p d l) (Z: class z w t e k m s1 p d l):
  $ wi ph (wf cr cr F) $ >
  $ wi ph (wcel X cr) $ >
  $ wceq P (cmpt m cn (crab p (wa (wa (wceq (cfv cc0 (cv p)) (co (cneg cpi) X caddc)) (wceq (cfv (cv m) (cv p)) (co cpi X caddc))) (wral e (wbr (cfv (cv e) (cv p)) (cfv (co (cv e) c1 caddc) (cv p)) clt) (co cc0 (cv m) cfzo))) (co cr (co cc0 (cv m) cfz) cmap))) $ >
  $ wi ph (wcel M cn) $ >
  $ wi ph (wcel V (cfv M P)) $ >
  $ wi ph (wcel X (crn V)) $ >
  $ wi (wa ph (wcel (cv e) (co cc0 M cfzo))) (wcel (cres F (co (cfv (cv e) V) (cfv (co (cv e) c1 caddc) V) cioo)) (co (co (cfv (cv e) V) (cfv (co (cv e) c1 caddc) V) cioo) cc ccncf)) $ >
  $ wi (wa ph (wcel (cv e) (co cc0 M cfzo))) (wrex w (wral t (wbr (cfv (cfv (cv t) F) cabs) (cv w) cle) (co (cfv (cv e) V) (cfv (co (cv e) c1 caddc) V) cioo)) cr) $ >
  $ wi (wa ph (wcel (cv e) (co cc0 M cfzo))) (wcel (cres (co cr F cdv) (co (cfv (cv e) V) (cfv (co (cv e) c1 caddc) V) cioo)) (co (co (cfv (cv e) V) (cfv (co (cv e) c1 caddc) V) cioo) cr ccncf)) $ >
  $ wi (wa ph (wcel (cv e) (co cc0 M cfzo))) (wrex z (wral t (wbr (cfv (cfv (cv t) (co cr F cdv)) cabs) (cv z) cle) (co (cfv (cv e) V) (cfv (co (cv e) c1 caddc) V) cioo)) cr) $ >
  $ wi (wa ph (wcel (cv e) (co cc0 M cfzo))) (wcel R (co (cres F (co (cfv (cv e) V) (cfv (co (cv e) c1 caddc) V) cioo)) (cfv (cv e) V) climc)) $ >
  $ wi (wa ph (wcel (cv e) (co cc0 M cfzo))) (wcel L (co (cres F (co (cfv (cv e) V) (cfv (co (cv e) c1 caddc) V) cioo)) (cfv (co (cv e) c1 caddc) V) climc)) $ >
  $ wceq H (cmpt s1 (co (cneg cpi) cpi cicc) (cif (wceq (cv s1) cc0) cc0 (co (co (cfv (co X (cv s1) caddc) F) (cif (wbr cc0 (cv s1) clt) Y W) cmin) (cv s1) cdiv))) $ >
  $ wceq K (cmpt s1 (co (cneg cpi) cpi cicc) (cif (wceq (cv s1) cc0) c1 (co (cv s1) (co c2 (cfv (co (cv s1) c2 cdiv) csin) cmul) cdiv))) $ >
  $ wceq U (cmpt s1 (co (cneg cpi) cpi cicc) (co (cfv (cv s1) H) (cfv (cv s1) K) cmul)) $ >
  $ wceq S (cmpt s1 (co (cneg cpi) cpi cicc) (cfv (co (co (cv n) (co c1 c2 cdiv) caddc) (cv s1) cmul) csin)) $ >
  $ wceq G (cmpt s1 (co (cneg cpi) cpi cicc) (co (cfv (cv s1) U) (cfv (cv s1) S) cmul)) $ >
  $ wceq Z (cmpt m cn (citg s1 (co (cneg cpi) cc0 cioo) (co (cfv (co X (cv s1) caddc) F) (cfv (cv s1) (cfv (cv m) D)) cmul))) $ >
  $ wceq E (cmpt n cn (co (citg s1 (co (cneg cpi) cc0 cioo) (cfv (cv s1) G)) cpi cdiv)) $ >
  $ wi ph (wcel Y (co (cres F (co X cpnf cioo)) X climc)) $ >
  $ wi ph (wcel W (co (cres F (co cmnf X cioo)) X climc)) $ >
  $ wi ph (wcel A2 (co (cres (co cr F cdv) (co cmnf X cioo)) X climc)) $ >
  $ wi ph (wcel B2 (co (cres (co cr F cdv) (co X cpnf cioo)) X climc)) $ >
  $ wceq D (cmpt n cn (cmpt s1 cr (cif (wceq (co (cv s1) (co c2 cpi cmul) cmo) cc0) (co (co (co c2 (cv n) cmul) c1 caddc) (co c2 cpi cmul) cdiv) (co (cfv (co (co (cv n) (co c1 c2 cdiv) caddc) (cv s1) cmul) csin) (co (co c2 cpi cmul) (cfv (co (cv s1) c2 cdiv) csin) cmul) cdiv)))) $ >
  $ wceq O (cres U (co (cneg cpi) (cv d) cicc)) $ >
  $ wceq T (cun (cpr (cneg cpi) (cv d)) (cin (crn Q) (co (cneg cpi) (cv d) cioo))) $ >
  $ wceq N (co (cfv T chash) c1 cmin) $ >
  $ wceq J (cio w (wiso (co cc0 N cfz) T clt clt (cv w))) $ >
  $ wceq Q (cmpt e (co cc0 M cfz) (co (cfv (cv e) V) X cmin)) $ >
  $ wceq C (crio l (wss (co (cfv (cv k) J) (cfv (co (cv k) c1 caddc) J) cioo) (co (cfv (cv l) Q) (cfv (co (cv l) c1 caddc) Q) cioo)) (co cc0 M cfzo)) $ >
  $ wb ch (wa (wa (wa (wa (wa ph (wcel (cv e) crp)) (wcel (cv d) (co (cneg cpi) cc0 cioo))) (wcel (cv k) cn)) (wbr (cfv (citg s1 (co (cv d) cc0 cioo) (co (cfv (cv s1) U) (cfv (co (co (cv k) (co c1 c2 cdiv) caddc) (cv s1) cmul) csin) cmul)) cabs) (co (cv e) c2 cdiv) clt)) (wbr (cfv (citg s1 (co (cneg cpi) (cv d) cioo) (co (cfv (cv s1) U) (cfv (co (co (cv k) (co c1 c2 cdiv) caddc) (cv s1) cmul) csin) cmul)) cabs) (co (cv e) c2 cdiv) clt)) $ >
  $ wi ph (wbr Z (co W c2 cdiv) cli) $;

--| The half upper part of the integral equal to the fourier partial sum, converges to half the right limit of the original function. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem fourierdlem104 {z w t e f2 i k m n s1 p d l: setvar} (ph: wff p) (ch: wff z w t e f2 i k m n p d l) (A2 B2: class z w t e f2 i k m n p d l) (C: class e f2 k m n s1 p d l) (D: class z w t e f2 k n p d l) (P: class z w t e f2 i k m n s1 p d l) (Q: class z w e k m n d) (R: class z w e f2 i k m n p d) (S: class z w t e f2 i k m n p d l) (T: class z w t e i k m n s1 p d l) (U: class z w t e f2 i m p) (E: class z w t e f2 i k m s1 p d l) (F: class e f2 n p d) (G: class z w f2 m n p d l) (H: class z w t e f2 k m n p d l) (J: class e n p d) (K: class z w t e f2 i k m n p d l) (L: class z w e f2 i k m n p d) (M: class z w e f2 n d) (N: class n p d) (O: class z w f2 i m n p d) (V: class z w e f2 m n d l) (W: class z w t e f2 i k m n p d l) (X: class e f2 n d) (Y: class e f2 p d) (Z: class z w t e f2 i k m s1 p d l):
  $ wi ph (wf cr cr F) $ >
  $ wi ph (wcel X cr) $ >
  $ wceq P (cmpt m cn (crab p (wa (wa (wceq (cfv cc0 (cv p)) (co (cneg cpi) X caddc)) (wceq (cfv (cv m) (cv p)) (co cpi X caddc))) (wral i (wbr (cfv (cv i) (cv p)) (cfv (co (cv i) c1 caddc) (cv p)) clt) (co cc0 (cv m) cfzo))) (co cr (co cc0 (cv m) cfz) cmap))) $ >
  $ wi ph (wcel M cn) $ >
  $ wi ph (wcel V (cfv M P)) $ >
  $ wi ph (wcel X (crn V)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel (cres F (co (cfv (cv i) V) (cfv (co (cv i) c1 caddc) V) cioo)) (co (co (cfv (cv i) V) (cfv (co (cv i) c1 caddc) V) cioo) cc ccncf)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wrex w (wral t (wbr (cfv (cfv (cv t) F) cabs) (cv w) cle) (co (cfv (cv i) V) (cfv (co (cv i) c1 caddc) V) cioo)) cr) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel (cres (co cr F cdv) (co (cfv (cv i) V) (cfv (co (cv i) c1 caddc) V) cioo)) (co (co (cfv (cv i) V) (cfv (co (cv i) c1 caddc) V) cioo) cr ccncf)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wrex z (wral t (wbr (cfv (cfv (cv t) (co cr F cdv)) cabs) (cv z) cle) (co (cfv (cv i) V) (cfv (co (cv i) c1 caddc) V) cioo)) cr) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel R (co (cres F (co (cfv (cv i) V) (cfv (co (cv i) c1 caddc) V) cioo)) (cfv (cv i) V) climc)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel L (co (cres F (co (cfv (cv i) V) (cfv (co (cv i) c1 caddc) V) cioo)) (cfv (co (cv i) c1 caddc) V) climc)) $ >
  $ wceq H (cmpt s1 (co (cneg cpi) cpi cicc) (cif (wceq (cv s1) cc0) cc0 (co (co (cfv (co X (cv s1) caddc) F) (cif (wbr cc0 (cv s1) clt) Y W) cmin) (cv s1) cdiv))) $ >
  $ wceq K (cmpt s1 (co (cneg cpi) cpi cicc) (cif (wceq (cv s1) cc0) c1 (co (cv s1) (co c2 (cfv (co (cv s1) c2 cdiv) csin) cmul) cdiv))) $ >
  $ wceq U (cmpt s1 (co (cneg cpi) cpi cicc) (co (cfv (cv s1) H) (cfv (cv s1) K) cmul)) $ >
  $ wceq S (cmpt s1 (co (cneg cpi) cpi cicc) (cfv (co (co (cv n) (co c1 c2 cdiv) caddc) (cv s1) cmul) csin)) $ >
  $ wceq G (cmpt s1 (co (cneg cpi) cpi cicc) (co (cfv (cv s1) U) (cfv (cv s1) S) cmul)) $ >
  $ wceq Z (cmpt m cn (citg s1 (co cc0 cpi cioo) (co (cfv (co X (cv s1) caddc) F) (cfv (cv s1) (cfv (cv m) D)) cmul))) $ >
  $ wceq E (cmpt n cn (co (citg s1 (co cc0 cpi cioo) (cfv (cv s1) G)) cpi cdiv)) $ >
  $ wi ph (wcel Y (co (cres F (co X cpnf cioo)) X climc)) $ >
  $ wi ph (wcel W (co (cres F (co cmnf X cioo)) X climc)) $ >
  $ wi ph (wcel A2 (co (cres (co cr F cdv) (co cmnf X cioo)) X climc)) $ >
  $ wi ph (wcel B2 (co (cres (co cr F cdv) (co X cpnf cioo)) X climc)) $ >
  $ wceq D (cmpt n cn (cmpt s1 cr (cif (wceq (co (cv s1) (co c2 cpi cmul) cmo) cc0) (co (co (co c2 (cv n) cmul) c1 caddc) (co c2 cpi cmul) cdiv) (co (cfv (co (co (cv n) (co c1 c2 cdiv) caddc) (cv s1) cmul) csin) (co (co c2 cpi cmul) (cfv (co (cv s1) c2 cdiv) csin) cmul) cdiv)))) $ >
  $ wceq O (cres U (co (cv d) cpi cicc)) $ >
  $ wceq T (cun (cpr (cv d) cpi) (cin (crn Q) (co (cv d) cpi cioo))) $ >
  $ wceq N (co (cfv T chash) c1 cmin) $ >
  $ wceq J (cio f2 (wiso (co cc0 N cfz) T clt clt (cv f2))) $ >
  $ wceq Q (cmpt i (co cc0 M cfz) (co (cfv (cv i) V) X cmin)) $ >
  $ wceq C (crio l (wss (co (cfv (cv k) J) (cfv (co (cv k) c1 caddc) J) cioo) (co (cfv (cv l) Q) (cfv (co (cv l) c1 caddc) Q) cioo)) (co cc0 M cfzo)) $ >
  $ wb ch (wa (wa (wa (wa (wa ph (wcel (cv e) crp)) (wcel (cv d) (co cc0 cpi cioo))) (wcel (cv k) cn)) (wbr (cfv (citg s1 (co cc0 (cv d) cioo) (co (cfv (cv s1) U) (cfv (co (co (cv k) (co c1 c2 cdiv) caddc) (cv s1) cmul) csin) cmul)) cabs) (co (cv e) c2 cdiv) clt)) (wbr (cfv (citg s1 (co (cv d) cpi cioo) (co (cfv (cv s1) U) (cfv (co (co (cv k) (co c1 c2 cdiv) caddc) (cv s1) cmul) csin) cmul)) cabs) (co (cv e) c2 cdiv) clt)) $ >
  $ wi ph (wbr Z (co Y c2 cdiv) cli) $;

--| A piecewise continuous function is integrable on any closed interval. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem fourierdlem105 {x3 i m p: setvar} (ph: wff m p) (A2 B2 C D: class) (P: class x3 i m p) (Q: class) (R: class i m p) (T: class) (F: class m p) (L: class i m p) (M: class):
  $ wceq P (cmpt m cn (crab p (wa (wa (wceq (cfv cc0 (cv p)) A2) (wceq (cfv (cv m) (cv p)) B2)) (wral i (wbr (cfv (cv i) (cv p)) (cfv (co (cv i) c1 caddc) (cv p)) clt) (co cc0 (cv m) cfzo))) (co cr (co cc0 (cv m) cfz) cmap))) $ >
  $ wceq T (co B2 A2 cmin) $ >
  $ wi ph (wcel M cn) $ >
  $ wi ph (wcel Q (cfv M P)) $ >
  $ wi ph (wf cr cc F) $ >
  $ wi (wa ph (wcel (cv x3) cr)) (wceq (cfv (co (cv x3) T caddc) F) (cfv (cv x3) F)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (co (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo) cc ccncf)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel R (co (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (cfv (cv i) Q) climc)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel L (co (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (cfv (co (cv i) c1 caddc) Q) climc)) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wcel D (co C cpnf cioo)) $ >
  $ wi ph (wcel (cmpt x3 (co C D cicc) (cfv (cv x3) F)) cibl) $;

--| For a piecewise smooth function, the left and the right limits exist at any point. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem fourierdlem106 {x3: setvar} (ph: wff) (T F G X: class):
  $ wi ph (wf cr cr F) $ >
  $ wceq T (co c2 cpi cmul) $ >
  $ wi (wa ph (wcel (cv x3) cr)) (wceq (cfv (co (cv x3) T caddc) F) (cfv (cv x3) F)) $ >
  $ wceq G (cres (co cr F cdv) (co (cneg cpi) cpi cioo)) $ >
  $ wi ph (wcel (cdif (co (cneg cpi) cpi cioo) (cdm G)) cfn) $ >
  $ wi ph (wcel G (co (cdm G) cc ccncf)) $ >
  $ wi (wa ph (wcel (cv x3) (cdif (co (cneg cpi) cpi cico) (cdm G)))) (wne (co (cres G (co (cv x3) cpnf cioo)) (cv x3) climc) c0) $ >
  $ wi (wa ph (wcel (cv x3) (cdif (co (cneg cpi) cpi cioc) (cdm G)))) (wne (co (cres G (co cmnf (cv x3) cioo)) (cv x3) climc) c0) $ >
  $ wi ph (wcel X cr) $ >
  $ wi ph (wa (wne (co (cres F (co cmnf X cioo)) X climc) c0) (wne (co (cres F (co X cpnf cioo)) X climc) c0)) $;

--| The integral of a piecewise continuous periodic function ` F ` is unchanged if the domain is shifted by any positive value ` X ` . This lemma generalizes ~ fourierdlem92 where the integral was shifted by the exact period. This lemma uses local definitions, so that the proof is more readable. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem fourierdlem107 {x3 y1 f2 i k m p: setvar} (ph: wff m p) (A2 B2: class) (P: class x3 y1 f2 i k m p) (Q: class) (R: class f2 i k m p) (S: class m) (T: class) (E: class m p) (F: class f2 k m p) (H: class i k m p) (I: class m p) (L: class f2 i k m p) (M: class f2 k) (N: class) (O: class x3 y1 f2 i k m p) (X: class k) (Z: class f2 k m p):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wceq T (co B2 A2 cmin) $ >
  $ wi ph (wcel X crp) $ >
  $ wceq P (cmpt m cn (crab p (wa (wa (wceq (cfv cc0 (cv p)) A2) (wceq (cfv (cv m) (cv p)) B2)) (wral i (wbr (cfv (cv i) (cv p)) (cfv (co (cv i) c1 caddc) (cv p)) clt) (co cc0 (cv m) cfzo))) (co cr (co cc0 (cv m) cfz) cmap))) $ >
  $ wi ph (wcel M cn) $ >
  $ wi ph (wcel Q (cfv M P)) $ >
  $ wi ph (wf cr cc F) $ >
  $ wi (wa ph (wcel (cv x3) cr)) (wceq (cfv (co (cv x3) T caddc) F) (cfv (cv x3) F)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (co (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo) cc ccncf)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel R (co (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (cfv (cv i) Q) climc)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel L (co (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (cfv (co (cv i) c1 caddc) Q) climc)) $ >
  $ wceq O (cmpt m cn (crab p (wa (wa (wceq (cfv cc0 (cv p)) (co A2 X cmin)) (wceq (cfv (cv m) (cv p)) A2)) (wral i (wbr (cfv (cv i) (cv p)) (cfv (co (cv i) c1 caddc) (cv p)) clt) (co cc0 (cv m) cfzo))) (co cr (co cc0 (cv m) cfz) cmap))) $ >
  $ wceq H (cun (cpr (co A2 X cmin) A2) (crab y1 (wrex k (wcel (co (cv y1) (co (cv k) T cmul) caddc) (crn Q)) cz) (co (co A2 X cmin) A2 cicc))) $ >
  $ wceq N (co (cfv H chash) c1 cmin) $ >
  $ wceq S (cio f2 (wiso (co cc0 N cfz) H clt clt (cv f2))) $ >
  $ wceq E (cmpt x3 cr (co (cv x3) (co (cfv (co (co B2 (cv x3) cmin) T cdiv) cfl) T cmul) caddc)) $ >
  $ wceq Z (cmpt y1 (co A2 B2 cioc) (cif (wceq (cv y1) B2) A2 (cv y1))) $ >
  $ wceq I (cmpt x3 cr (csup (crab i (wbr (cfv (cv i) Q) (cfv (cfv (cv x3) E) Z) cle) (co cc0 M cfzo)) cr clt)) $ >
  $ wi ph (wceq (citg x3 (co (co A2 X cmin) (co B2 X cmin) cicc) (cfv (cv x3) F)) (citg x3 (co A2 B2 cicc) (cfv (cv x3) F))) $;

--| The integral of a piecewise continuous periodic function ` F ` is unchanged if the domain is shifted by any positive value ` X ` . This lemma generalizes ~ fourierdlem92 where the integral was shifted by the exact period. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem fourierdlem108 {x3 i m p: setvar} (ph: wff m p) (A2 B2: class) (P: class x3 i m p) (Q: class) (R: class i m p) (T: class) (F: class m p) (L: class i m p) (M X: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wceq T (co B2 A2 cmin) $ >
  $ wi ph (wcel X crp) $ >
  $ wceq P (cmpt m cn (crab p (wa (wa (wceq (cfv cc0 (cv p)) A2) (wceq (cfv (cv m) (cv p)) B2)) (wral i (wbr (cfv (cv i) (cv p)) (cfv (co (cv i) c1 caddc) (cv p)) clt) (co cc0 (cv m) cfzo))) (co cr (co cc0 (cv m) cfz) cmap))) $ >
  $ wi ph (wcel M cn) $ >
  $ wi ph (wcel Q (cfv M P)) $ >
  $ wi ph (wf cr cc F) $ >
  $ wi (wa ph (wcel (cv x3) cr)) (wceq (cfv (co (cv x3) T caddc) F) (cfv (cv x3) F)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (co (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo) cc ccncf)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel R (co (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (cfv (cv i) Q) climc)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel L (co (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (cfv (co (cv i) c1 caddc) Q) climc)) $ >
  $ wi ph (wceq (citg x3 (co (co A2 X cmin) (co B2 X cmin) cicc) (cfv (cv x3) F)) (citg x3 (co A2 B2 cicc) (cfv (cv x3) F))) $;

--| The integral of a piecewise continuous periodic function ` F ` is unchanged if the domain is shifted by any value ` X ` . This lemma generalizes ~ fourierdlem92 where the integral was shifted by the exact period. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem fourierdlem109 {x3 y1 f2 i j k m p: setvar} (ph: wff m p) (A2 B2: class) (P: class x3 y1 f2 i j k m p) (Q: class) (R: class f2 i j k m p) (S T: class) (E: class m p) (F: class f2 k m p) (H: class i j k m p) (I: class j m p) (J: class f2 k m p) (L: class f2 i j k m p) (M: class f2 k) (N: class) (O: class x3 y1 f2 i j k m p) (X: class k):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wceq T (co B2 A2 cmin) $ >
  $ wi ph (wcel X cr) $ >
  $ wceq P (cmpt m cn (crab p (wa (wa (wceq (cfv cc0 (cv p)) A2) (wceq (cfv (cv m) (cv p)) B2)) (wral i (wbr (cfv (cv i) (cv p)) (cfv (co (cv i) c1 caddc) (cv p)) clt) (co cc0 (cv m) cfzo))) (co cr (co cc0 (cv m) cfz) cmap))) $ >
  $ wi ph (wcel M cn) $ >
  $ wi ph (wcel Q (cfv M P)) $ >
  $ wi ph (wf cr cc F) $ >
  $ wi (wa ph (wcel (cv x3) cr)) (wceq (cfv (co (cv x3) T caddc) F) (cfv (cv x3) F)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (co (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo) cc ccncf)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel R (co (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (cfv (cv i) Q) climc)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel L (co (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (cfv (co (cv i) c1 caddc) Q) climc)) $ >
  $ wceq O (cmpt m cn (crab p (wa (wa (wceq (cfv cc0 (cv p)) (co A2 X cmin)) (wceq (cfv (cv m) (cv p)) (co B2 X cmin))) (wral i (wbr (cfv (cv i) (cv p)) (cfv (co (cv i) c1 caddc) (cv p)) clt) (co cc0 (cv m) cfzo))) (co cr (co cc0 (cv m) cfz) cmap))) $ >
  $ wceq H (cun (cpr (co A2 X cmin) (co B2 X cmin)) (crab x3 (wrex k (wcel (co (cv x3) (co (cv k) T cmul) caddc) (crn Q)) cz) (co (co A2 X cmin) (co B2 X cmin) cicc))) $ >
  $ wceq N (co (cfv H chash) c1 cmin) $ >
  $ wceq S (cio f2 (wiso (co cc0 N cfz) H clt clt (cv f2))) $ >
  $ wceq E (cmpt x3 cr (co (cv x3) (co (cfv (co (co B2 (cv x3) cmin) T cdiv) cfl) T cmul) caddc)) $ >
  $ wceq J (cmpt y1 (co A2 B2 cioc) (cif (wceq (cv y1) B2) A2 (cv y1))) $ >
  $ wceq I (cmpt x3 cr (csup (crab j (wbr (cfv (cv j) Q) (cfv (cfv (cv x3) E) J) cle) (co cc0 M cfzo)) cr clt)) $ >
  $ wi ph (wceq (citg x3 (co (co A2 X cmin) (co B2 X cmin) cicc) (cfv (cv x3) F)) (citg x3 (co A2 B2 cicc) (cfv (cv x3) F))) $;

--| The integral of a piecewise continuous periodic function ` F ` is unchanged if the domain is shifted by any value ` X ` . This lemma generalizes ~ fourierdlem92 where the integral was shifted by the exact period. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem fourierdlem110 {x3 i m p: setvar} (ph: wff m p) (A2 B2: class) (P: class x3 i m p) (Q: class) (R: class i m p) (T: class) (F: class m p) (L: class i m p) (M X: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wceq T (co B2 A2 cmin) $ >
  $ wi ph (wcel X cr) $ >
  $ wceq P (cmpt m cn (crab p (wa (wa (wceq (cfv cc0 (cv p)) A2) (wceq (cfv (cv m) (cv p)) B2)) (wral i (wbr (cfv (cv i) (cv p)) (cfv (co (cv i) c1 caddc) (cv p)) clt) (co cc0 (cv m) cfzo))) (co cr (co cc0 (cv m) cfz) cmap))) $ >
  $ wi ph (wcel M cn) $ >
  $ wi ph (wcel Q (cfv M P)) $ >
  $ wi ph (wf cr cc F) $ >
  $ wi (wa ph (wcel (cv x3) cr)) (wceq (cfv (co (cv x3) T caddc) F) (cfv (cv x3) F)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (co (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo) cc ccncf)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel R (co (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (cfv (cv i) Q) climc)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel L (co (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (cfv (co (cv i) c1 caddc) Q) climc)) $ >
  $ wi ph (wceq (citg x3 (co (co A2 X cmin) (co B2 X cmin) cicc) (cfv (cv x3) F)) (citg x3 (co A2 B2 cicc) (cfv (cv x3) F))) $;

--| The fourier partial sum for ` F ` is the sum of two integrals, with the same integrand involving ` F ` and the Dirichlet kernel ` D ` , but on two opposite intervals. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem fourierdlem111 {x3 y1 t i m n s1 p: setvar} (ph: wff p) (A2: class x3 y1 t i s1 p) (B2: class x3 y1 t i n s1 p) (D: class n p) (P: class x3 y1 t i m n s1 p) (Q: class m n) (R: class y1 i m n p) (S: class x3 y1 t i m n s1 p) (T: class y1 t i m n p) (F: class m p) (G: class y1 t m n p) (L: class y1 i m n p) (M: class n) (O: class x3 y1 t i m n s1 p) (W: class t n) (X: class):
  $ wceq A2 (cmpt n cn0 (co (citg t (co (cneg cpi) cpi cioo) (co (cfv (cv t) F) (cfv (co (cv n) (cv t) cmul) ccos) cmul)) cpi cdiv)) $ >
  $ wceq B2 (cmpt n cn (co (citg t (co (cneg cpi) cpi cioo) (co (cfv (cv t) F) (cfv (co (cv n) (cv t) cmul) csin) cmul)) cpi cdiv)) $ >
  $ wceq S (cmpt m cn (co (co (cfv cc0 A2) c2 cdiv) (csu n (co c1 (cv m) cfz) (co (co (cfv (cv n) A2) (cfv (co (cv n) X cmul) ccos) cmul) (co (cfv (cv n) B2) (cfv (co (cv n) X cmul) csin) cmul) caddc)) caddc)) $ >
  $ wceq D (cmpt n cn (cmpt y1 cr (cif (wceq (co (cv y1) (co c2 cpi cmul) cmo) cc0) (co (co (co c2 (cv n) cmul) c1 caddc) (co c2 cpi cmul) cdiv) (co (cfv (co (co (cv n) (co c1 c2 cdiv) caddc) (cv y1) cmul) csin) (co (co c2 cpi cmul) (cfv (co (cv y1) c2 cdiv) csin) cmul) cdiv)))) $ >
  $ wceq P (cmpt m cn (crab p (wa (wa (wceq (cfv cc0 (cv p)) (cneg cpi)) (wceq (cfv (cv m) (cv p)) cpi)) (wral i (wbr (cfv (cv i) (cv p)) (cfv (co (cv i) c1 caddc) (cv p)) clt) (co cc0 (cv m) cfzo))) (co cr (co cc0 (cv m) cfz) cmap))) $ >
  $ wi ph (wcel M cn) $ >
  $ wi ph (wcel Q (cfv M P)) $ >
  $ wi ph (wcel X cr) $ >
  $ wi ph (wf cr cr F) $ >
  $ wi (wa ph (wcel (cv x3) cr)) (wceq (cfv (co (cv x3) T caddc) F) (cfv (cv x3) F)) $ >
  $ wceq G (cmpt x3 cr (co (cfv (co X (cv x3) caddc) F) (cfv (cv x3) (cfv (cv n) D)) cmul)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (co (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo) cc ccncf)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel R (co (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (cfv (cv i) Q) climc)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel L (co (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (cfv (co (cv i) c1 caddc) Q) climc)) $ >
  $ wceq T (co c2 cpi cmul) $ >
  $ wceq O (cmpt m cn (crab p (wa (wa (wceq (cfv cc0 (cv p)) (co (cneg cpi) X cmin)) (wceq (cfv (cv m) (cv p)) (co cpi X cmin))) (wral i (wbr (cfv (cv i) (cv p)) (cfv (co (cv i) c1 caddc) (cv p)) clt) (co cc0 (cv m) cfzo))) (co cr (co cc0 (cv m) cfz) cmap))) $ >
  $ wceq W (cmpt i (co cc0 M cfz) (co (cfv (cv i) Q) X cmin)) $ >
  $ wi (wa ph (wcel (cv n) cn)) (wceq (cfv (cv n) S) (co (citg s1 (co (cneg cpi) cc0 cioo) (co (cfv (co X (cv s1) caddc) F) (cfv (cv s1) (cfv (cv n) D)) cmul)) (citg s1 (co cc0 cpi cioo) (co (cfv (co X (cv s1) caddc) F) (cfv (cv s1) (cfv (cv n) D)) cmul)) caddc)) $;

--| The fourier partial sum for ` F ` is the sum of two integrals, with the same integrand involving ` F ` and the Dirichlet kernel ` D ` , but on two opposite intervals. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem fourierdlem111_b1 {x3 y1 i m n s1 p: setvar} (ph: wff p) (A2: class x3 y1 i s1 p) (B2: class x3 y1 i n s1 p) (D: class n p) (P: class x3 y1 i m n s1 p) (Q: class m n) (R: class y1 i m n p) (S: class x3 y1 i m n s1 p) (T: class y1 i m n p) (F: class m p) (G: class y1 m n p) (L: class y1 i m n p) (M: class n) (O: class x3 y1 i m n s1 p) (W: class n) (X: class):
  $ wceq A2 (cmpt n cn0 (co (citg x3 (co (cneg cpi) cpi cioo) (co (cfv (cv x3) F) (cfv (co (cv n) (cv x3) cmul) ccos) cmul)) cpi cdiv)) $ >
  $ wceq B2 (cmpt n cn (co (citg x3 (co (cneg cpi) cpi cioo) (co (cfv (cv x3) F) (cfv (co (cv n) (cv x3) cmul) csin) cmul)) cpi cdiv)) $ >
  $ wceq S (cmpt m cn (co (co (cfv cc0 A2) c2 cdiv) (csu n (co c1 (cv m) cfz) (co (co (cfv (cv n) A2) (cfv (co (cv n) X cmul) ccos) cmul) (co (cfv (cv n) B2) (cfv (co (cv n) X cmul) csin) cmul) caddc)) caddc)) $ >
  $ wceq D (cmpt n cn (cmpt y1 cr (cif (wceq (co (cv y1) (co c2 cpi cmul) cmo) cc0) (co (co (co c2 (cv n) cmul) c1 caddc) (co c2 cpi cmul) cdiv) (co (cfv (co (co (cv n) (co c1 c2 cdiv) caddc) (cv y1) cmul) csin) (co (co c2 cpi cmul) (cfv (co (cv y1) c2 cdiv) csin) cmul) cdiv)))) $ >
  $ wceq P (cmpt m cn (crab p (wa (wa (wceq (cfv cc0 (cv p)) (cneg cpi)) (wceq (cfv (cv m) (cv p)) cpi)) (wral i (wbr (cfv (cv i) (cv p)) (cfv (co (cv i) c1 caddc) (cv p)) clt) (co cc0 (cv m) cfzo))) (co cr (co cc0 (cv m) cfz) cmap))) $ >
  $ wi ph (wcel M cn) $ >
  $ wi ph (wcel Q (cfv M P)) $ >
  $ wi ph (wcel X cr) $ >
  $ wi ph (wf cr cr F) $ >
  $ wi (wa ph (wcel (cv x3) cr)) (wceq (cfv (co (cv x3) T caddc) F) (cfv (cv x3) F)) $ >
  $ wceq G (cmpt x3 cr (co (cfv (co X (cv x3) caddc) F) (cfv (cv x3) (cfv (cv n) D)) cmul)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (co (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo) cc ccncf)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel R (co (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (cfv (cv i) Q) climc)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel L (co (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (cfv (co (cv i) c1 caddc) Q) climc)) $ >
  $ wceq T (co c2 cpi cmul) $ >
  $ wceq O (cmpt m cn (crab p (wa (wa (wceq (cfv cc0 (cv p)) (co (cneg cpi) X cmin)) (wceq (cfv (cv m) (cv p)) (co cpi X cmin))) (wral i (wbr (cfv (cv i) (cv p)) (cfv (co (cv i) c1 caddc) (cv p)) clt) (co cc0 (cv m) cfzo))) (co cr (co cc0 (cv m) cfz) cmap))) $ >
  $ wceq W (cmpt i (co cc0 M cfz) (co (cfv (cv i) Q) X cmin)) $ >
  $ wi (wa ph (wcel (cv n) cn)) (wceq (cfv (cv n) S) (co (citg s1 (co (cneg cpi) cc0 cioo) (co (cfv (co X (cv s1) caddc) F) (cfv (cv s1) (cfv (cv n) D)) cmul)) (citg s1 (co cc0 cpi cioo) (co (cfv (co X (cv s1) caddc) F) (cfv (cv s1) (cfv (cv n) D)) cmul)) caddc)) $;

--| Here abbreviations (local definitions) are introduced to prove the ~ fourier theorem. ` ( Z `` m ) ` is the m_th partial sum of the fourier series. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem fourierdlem112 {x3 y1 z w t f2 i k m n p: setvar} (ph: wff p) (A2 B2: class x3 y1 z w t f2 i p) (C: class y1 z w f2 i k n p) (D: class z w t f2 p) (P: class x3 y1 z w t f2 i k m n p) (Q: class z w) (R: class x3 y1 f2 p) (S: class x3 y1 z w t f2 i k m n p) (T: class z w) (U: class y1 z w f2 i k n p) (E: class x3 y1 z w t f2 i k m n p) (F: class f2 p) (I: class x3 y1 z w t f2 i k m n p) (L: class x3 y1 f2 p) (M: class z w k) (N: class k) (V: class y1) (X: class) (Z: class x3 y1 z w t f2 i k n p):
  $ wi ph (wf cr cr F) $ >
  $ wceq D (cmpt m cn (cmpt y1 cr (cif (wceq (co (cv y1) (co c2 cpi cmul) cmo) cc0) (co (co (co c2 (cv m) cmul) c1 caddc) (co c2 cpi cmul) cdiv) (co (cfv (co (co (cv m) (co c1 c2 cdiv) caddc) (cv y1) cmul) csin) (co (co c2 cpi cmul) (cfv (co (cv y1) c2 cdiv) csin) cmul) cdiv)))) $ >
  $ wceq P (cmpt n cn (crab p (wa (wa (wceq (cfv cc0 (cv p)) (cneg cpi)) (wceq (cfv (cv n) (cv p)) cpi)) (wral i (wbr (cfv (cv i) (cv p)) (cfv (co (cv i) c1 caddc) (cv p)) clt) (co cc0 (cv n) cfzo))) (co cr (co cc0 (cv n) cfz) cmap))) $ >
  $ wi ph (wcel M cn) $ >
  $ wi ph (wcel Q (cfv M P)) $ >
  $ wceq N (co (cfv (cun (cpr (co (cneg cpi) X caddc) (co cpi X caddc)) (crab y1 (wrex k (wcel (co (cv y1) (co (cv k) T cmul) caddc) (crn Q)) cz) (co (co (cneg cpi) X caddc) (co cpi X caddc) cicc))) chash) c1 cmin) $ >
  $ wceq V (cio f2 (wiso (co cc0 N cfz) (cun (cpr (co (cneg cpi) X caddc) (co cpi X caddc)) (crab y1 (wrex k (wcel (co (cv y1) (co (cv k) T cmul) caddc) (crn Q)) cz) (co (co (cneg cpi) X caddc) (co cpi X caddc) cicc))) clt clt (cv f2))) $ >
  $ wi ph (wcel X cr) $ >
  $ wi ph (wcel X (crn V)) $ >
  $ wceq T (co c2 cpi cmul) $ >
  $ wi (wa ph (wcel (cv x3) cr)) (wceq (cfv (co (cv x3) T caddc) F) (cfv (cv x3) F)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (co (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo) cc ccncf)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel C (co (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (cfv (cv i) Q) climc)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel U (co (cres F (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (cfv (co (cv i) c1 caddc) Q) climc)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel (cres (co cr F cdv) (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (co (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo) cc ccncf)) $ >
  $ wi ph (wcel E (co (cres (co cr F cdv) (co cmnf X cioo)) X climc)) $ >
  $ wi ph (wcel I (co (cres (co cr F cdv) (co X cpnf cioo)) X climc)) $ >
  $ wi ph (wcel L (co (cres F (co cmnf X cioo)) X climc)) $ >
  $ wi ph (wcel R (co (cres F (co X cpnf cioo)) X climc)) $ >
  $ wceq A2 (cmpt n cn0 (co (citg x3 (co (cneg cpi) cpi cioo) (co (cfv (cv x3) F) (cfv (co (cv n) (cv x3) cmul) ccos) cmul)) cpi cdiv)) $ >
  $ wceq B2 (cmpt n cn (co (citg x3 (co (cneg cpi) cpi cioo) (co (cfv (cv x3) F) (cfv (co (cv n) (cv x3) cmul) csin) cmul)) cpi cdiv)) $ >
  $ wceq Z (cmpt m cn (co (co (cfv cc0 A2) c2 cdiv) (csu n (co c1 (cv m) cfz) (co (co (cfv (cv n) A2) (cfv (co (cv n) X cmul) ccos) cmul) (co (cfv (cv n) B2) (cfv (co (cv n) X cmul) csin) cmul) caddc)) caddc)) $ >
  $ wceq S (cmpt n cn (co (co (cfv (cv n) A2) (cfv (co (cv n) X cmul) ccos) cmul) (co (cfv (cv n) B2) (cfv (co (cv n) X cmul) csin) cmul) caddc)) $ >
  $ wi ph (wrex w (wral t (wbr (cfv (cfv (cv t) F) cabs) (cv w) cle) cr) cr) $ >
  $ wi ph (wrex z (wral t (wbr (cfv (cfv (cv t) (co cr F cdv)) cabs) (cv z) cle) (cdm (co cr F cdv))) cr) $ >
  $ wi ph (wcel X cr) $ >
  $ wi ph (wa (wbr (cseq caddc S c1) (co (co (co L R caddc) c2 cdiv) (co (cfv cc0 A2) c2 cdiv) cmin) cli) (wceq (co (co (cfv cc0 A2) c2 cdiv) (csu n cn (co (co (cfv (cv n) A2) (cfv (co (cv n) X cmul) ccos) cmul) (co (cfv (cv n) B2) (cfv (co (cv n) X cmul) csin) cmul) caddc)) caddc) (co (co L R caddc) c2 cdiv))) $;

--| Fourier series convergence for periodic, piecewise smooth functions. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem fourierdlem113 {x3 i n p: setvar} (ph: wff p) (A2 B2: class x3 i p) (P: class x3 i n p) (Q: class) (R: class x3 p) (S: class x3 i n p) (T: class) (E: class i n p) (F: class p) (L: class x3 p) (M X: class):
  $ wi ph (wf cr cr F) $ >
  $ wceq T (co c2 cpi cmul) $ >
  $ wi (wa ph (wcel (cv x3) cr)) (wceq (cfv (co (cv x3) T caddc) F) (cfv (cv x3) F)) $ >
  $ wi ph (wcel X cr) $ >
  $ wi ph (wcel L (co (cres F (co cmnf X cioo)) X climc)) $ >
  $ wi ph (wcel R (co (cres F (co X cpnf cioo)) X climc)) $ >
  $ wceq P (cmpt n cn (crab p (wa (wa (wceq (cfv cc0 (cv p)) (cneg cpi)) (wceq (cfv (cv n) (cv p)) cpi)) (wral i (wbr (cfv (cv i) (cv p)) (cfv (co (cv i) c1 caddc) (cv p)) clt) (co cc0 (cv n) cfzo))) (co cr (co cc0 (cv n) cfz) cmap))) $ >
  $ wi ph (wcel M cn) $ >
  $ wi ph (wcel Q (cfv M P)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wcel (cres (co cr F cdv) (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (co (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo) cc ccncf)) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wne (co (cres (co cr F cdv) (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (cfv (cv i) Q) climc) c0) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 M cfzo))) (wne (co (cres (co cr F cdv) (co (cfv (cv i) Q) (cfv (co (cv i) c1 caddc) Q) cioo)) (cfv (co (cv i) c1 caddc) Q) climc) c0) $ >
  $ wceq A2 (cmpt n cn0 (co (citg x3 (co (cneg cpi) cpi cioo) (co (cfv (cv x3) F) (cfv (co (cv n) (cv x3) cmul) ccos) cmul)) cpi cdiv)) $ >
  $ wceq B2 (cmpt n cn (co (citg x3 (co (cneg cpi) cpi cioo) (co (cfv (cv x3) F) (cfv (co (cv n) (cv x3) cmul) csin) cmul)) cpi cdiv)) $ >
  $ wceq S (cmpt n cn (co (co (cfv (cv n) A2) (cfv (co (cv n) X cmul) ccos) cmul) (co (cfv (cv n) B2) (cfv (co (cv n) X cmul) csin) cmul) caddc)) $ >
  $ wceq E (cmpt x3 cr (co (cv x3) (co (cfv (co (co cpi (cv x3) cmin) T cdiv) cfl) T cmul) caddc)) $ >
  $ wi ph (wcel (cfv X E) (crn Q)) $ >
  $ wi ph (wa (wbr (cseq caddc S c1) (co (co (co L R caddc) c2 cdiv) (co (cfv cc0 A2) c2 cdiv) cmin) cli) (wceq (co (co (cfv cc0 A2) c2 cdiv) (csu n cn (co (co (cfv (cv n) A2) (cfv (co (cv n) X cmul) ccos) cmul) (co (cfv (cv n) B2) (cfv (co (cv n) X cmul) csin) cmul) caddc)) caddc) (co (co L R caddc) c2 cdiv))) $;

--| Fourier series convergence for periodic, piecewise smooth functions. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem fourierdlem114 {x3 g2 i n p: setvar} (ph: wff p) (A2 B2: class x3 g2 i p) (P: class x3 g2 i n p) (Q: class) (R: class x3 g2 p) (S: class x3 g2 i n p) (T: class g2) (E: class g2 i n p) (F: class g2 p) (G: class g2 n p) (H: class x3 i n p) (L: class x3 g2 p) (M: class) (X: class g2):
  $ wi ph (wf cr cr F) $ >
  $ wceq T (co c2 cpi cmul) $ >
  $ wi (wa ph (wcel (cv x3) cr)) (wceq (cfv (co (cv x3) T caddc) F) (cfv (cv x3) F)) $ >
  $ wceq G (cres (co cr F cdv) (co (cneg cpi) cpi cioo)) $ >
  $ wi ph (wcel (cdif (co (cneg cpi) cpi cioo) (cdm G)) cfn) $ >
  $ wi ph (wcel G (co (cdm G) cc ccncf)) $ >
  $ wi (wa ph (wcel (cv x3) (cdif (co (cneg cpi) cpi cico) (cdm G)))) (wne (co (cres G (co (cv x3) cpnf cioo)) (cv x3) climc) c0) $ >
  $ wi (wa ph (wcel (cv x3) (cdif (co (cneg cpi) cpi cioc) (cdm G)))) (wne (co (cres G (co cmnf (cv x3) cioo)) (cv x3) climc) c0) $ >
  $ wi ph (wcel X cr) $ >
  $ wi ph (wcel L (co (cres F (co cmnf X cioo)) X climc)) $ >
  $ wi ph (wcel R (co (cres F (co X cpnf cioo)) X climc)) $ >
  $ wceq A2 (cmpt n cn0 (co (citg x3 (co (cneg cpi) cpi cioo) (co (cfv (cv x3) F) (cfv (co (cv n) (cv x3) cmul) ccos) cmul)) cpi cdiv)) $ >
  $ wceq B2 (cmpt n cn (co (citg x3 (co (cneg cpi) cpi cioo) (co (cfv (cv x3) F) (cfv (co (cv n) (cv x3) cmul) csin) cmul)) cpi cdiv)) $ >
  $ wceq S (cmpt n cn (co (co (cfv (cv n) A2) (cfv (co (cv n) X cmul) ccos) cmul) (co (cfv (cv n) B2) (cfv (co (cv n) X cmul) csin) cmul) caddc)) $ >
  $ wceq P (cmpt n cn (crab p (wa (wa (wceq (cfv cc0 (cv p)) (cneg cpi)) (wceq (cfv (cv n) (cv p)) cpi)) (wral i (wbr (cfv (cv i) (cv p)) (cfv (co (cv i) c1 caddc) (cv p)) clt) (co cc0 (cv n) cfzo))) (co cr (co cc0 (cv n) cfz) cmap))) $ >
  $ wceq E (cmpt x3 cr (co (cv x3) (co (cfv (co (co cpi (cv x3) cmin) T cdiv) cfl) T cmul) caddc)) $ >
  $ wceq H (cun (ctp (cneg cpi) cpi (cfv X E)) (cdif (co (cneg cpi) cpi cicc) (cdm G))) $ >
  $ wceq M (co (cfv H chash) c1 cmin) $ >
  $ wceq Q (cio g2 (wiso (co cc0 M cfz) H clt clt (cv g2))) $ >
  $ wi ph (wa (wbr (cseq caddc S c1) (co (co (co L R caddc) c2 cdiv) (co (cfv cc0 A2) c2 cdiv) cmin) cli) (wceq (co (co (cfv cc0 A2) c2 cdiv) (csu n cn (co (co (cfv (cv n) A2) (cfv (co (cv n) X cmul) ccos) cmul) (co (cfv (cv n) B2) (cfv (co (cv n) X cmul) csin) cmul) caddc)) caddc) (co (co L R caddc) c2 cdiv))) $;

--| Fourier serier convergence, for piecewise smooth functions. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem fourierdlem115 {x3 k n: setvar} (ph: wff n) (A2 B2 R: class x3 n) (S: class x3 k n) (T: class n) (F: class) (G: class n) (L: class x3 n) (X: class):
  $ wi ph (wf cr cr F) $ >
  $ wceq T (co c2 cpi cmul) $ >
  $ wi (wa ph (wcel (cv x3) cr)) (wceq (cfv (co (cv x3) T caddc) F) (cfv (cv x3) F)) $ >
  $ wceq G (cres (co cr F cdv) (co (cneg cpi) cpi cioo)) $ >
  $ wi ph (wcel (cdif (co (cneg cpi) cpi cioo) (cdm G)) cfn) $ >
  $ wi ph (wcel G (co (cdm G) cc ccncf)) $ >
  $ wi (wa ph (wcel (cv x3) (cdif (co (cneg cpi) cpi cico) (cdm G)))) (wne (co (cres G (co (cv x3) cpnf cioo)) (cv x3) climc) c0) $ >
  $ wi (wa ph (wcel (cv x3) (cdif (co (cneg cpi) cpi cioc) (cdm G)))) (wne (co (cres G (co cmnf (cv x3) cioo)) (cv x3) climc) c0) $ >
  $ wi ph (wcel X cr) $ >
  $ wi ph (wcel L (co (cres F (co cmnf X cioo)) X climc)) $ >
  $ wi ph (wcel R (co (cres F (co X cpnf cioo)) X climc)) $ >
  $ wceq A2 (cmpt n cn0 (co (citg x3 (co (cneg cpi) cpi cioo) (co (cfv (cv x3) F) (cfv (co (cv n) (cv x3) cmul) ccos) cmul)) cpi cdiv)) $ >
  $ wceq B2 (cmpt n cn (co (citg x3 (co (cneg cpi) cpi cioo) (co (cfv (cv x3) F) (cfv (co (cv n) (cv x3) cmul) csin) cmul)) cpi cdiv)) $ >
  $ wceq S (cmpt k cn (co (co (cfv (cv k) A2) (cfv (co (cv k) X cmul) ccos) cmul) (co (cfv (cv k) B2) (cfv (co (cv k) X cmul) csin) cmul) caddc)) $ >
  $ wi ph (wa (wbr (cseq caddc S c1) (co (co (co L R caddc) c2 cdiv) (co (cfv cc0 A2) c2 cdiv) cmin) cli) (wceq (co (co (cfv cc0 A2) c2 cdiv) (csu n cn (co (co (cfv (cv n) A2) (cfv (co (cv n) X cmul) ccos) cmul) (co (cfv (cv n) B2) (cfv (co (cv n) X cmul) csin) cmul) caddc)) caddc) (co (co L R caddc) c2 cdiv))) $;

--| Fourier series convergence for periodic, piecewise smooth functions. The series converges to the average value of the left and the right limit of the function. Thus, if the function is continuous at a given point, the series converges exactly to the function value, see ~ fouriercnp . Notice that for a piecewise smooth function, the left and right limits always exist, see ~ fourier2 for an alternative form of the theorem that makes this fact explicit. When the first derivative is continuous, a simpler version of the theorem can be stated, see ~ fouriercn . (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem fourierd {x3 n: setvar} (ph: wff n) (A2 B2 R: class x3 n) (T: class n) (F: class) (G: class n) (L: class x3 n) (X: class):
  $ wi ph (wf cr cr F) $ >
  $ wceq T (co c2 cpi cmul) $ >
  $ wi (wa ph (wcel (cv x3) cr)) (wceq (cfv (co (cv x3) T caddc) F) (cfv (cv x3) F)) $ >
  $ wceq G (cres (co cr F cdv) (co (cneg cpi) cpi cioo)) $ >
  $ wi ph (wcel (cdif (co (cneg cpi) cpi cioo) (cdm G)) cfn) $ >
  $ wi ph (wcel G (co (cdm G) cc ccncf)) $ >
  $ wi (wa ph (wcel (cv x3) (cdif (co (cneg cpi) cpi cico) (cdm G)))) (wne (co (cres G (co (cv x3) cpnf cioo)) (cv x3) climc) c0) $ >
  $ wi (wa ph (wcel (cv x3) (cdif (co (cneg cpi) cpi cioc) (cdm G)))) (wne (co (cres G (co cmnf (cv x3) cioo)) (cv x3) climc) c0) $ >
  $ wi ph (wcel X cr) $ >
  $ wi ph (wcel L (co (cres F (co cmnf X cioo)) X climc)) $ >
  $ wi ph (wcel R (co (cres F (co X cpnf cioo)) X climc)) $ >
  $ wceq A2 (cmpt n cn0 (co (citg x3 (co (cneg cpi) cpi cioo) (co (cfv (cv x3) F) (cfv (co (cv n) (cv x3) cmul) ccos) cmul)) cpi cdiv)) $ >
  $ wceq B2 (cmpt n cn (co (citg x3 (co (cneg cpi) cpi cioo) (co (cfv (cv x3) F) (cfv (co (cv n) (cv x3) cmul) csin) cmul)) cpi cdiv)) $ >
  $ wi ph (wceq (co (co (cfv cc0 A2) c2 cdiv) (csu n cn (co (co (cfv (cv n) A2) (cfv (co (cv n) X cmul) ccos) cmul) (co (cfv (cv n) B2) (cfv (co (cv n) X cmul) csin) cmul) caddc)) caddc) (co (co L R caddc) c2 cdiv)) $;

--| Fourier series convergence, for piecewise smooth functions. See ~ fourierd for the analogous ` sum_ ` equation. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem fourierclimd {x3 n: setvar} (ph: wff n) (A2 B2 R S: class x3 n) (T: class n) (F: class) (G: class n) (L: class x3 n) (X: class):
  $ wi ph (wf cr cr F) $ >
  $ wceq T (co c2 cpi cmul) $ >
  $ wi (wa ph (wcel (cv x3) cr)) (wceq (cfv (co (cv x3) T caddc) F) (cfv (cv x3) F)) $ >
  $ wceq G (cres (co cr F cdv) (co (cneg cpi) cpi cioo)) $ >
  $ wi ph (wcel (cdif (co (cneg cpi) cpi cioo) (cdm G)) cfn) $ >
  $ wi ph (wcel G (co (cdm G) cc ccncf)) $ >
  $ wi (wa ph (wcel (cv x3) (cdif (co (cneg cpi) cpi cico) (cdm G)))) (wne (co (cres G (co (cv x3) cpnf cioo)) (cv x3) climc) c0) $ >
  $ wi (wa ph (wcel (cv x3) (cdif (co (cneg cpi) cpi cioc) (cdm G)))) (wne (co (cres G (co cmnf (cv x3) cioo)) (cv x3) climc) c0) $ >
  $ wi ph (wcel X cr) $ >
  $ wi ph (wcel L (co (cres F (co cmnf X cioo)) X climc)) $ >
  $ wi ph (wcel R (co (cres F (co X cpnf cioo)) X climc)) $ >
  $ wceq A2 (cmpt n cn0 (co (citg x3 (co (cneg cpi) cpi cioo) (co (cfv (cv x3) F) (cfv (co (cv n) (cv x3) cmul) ccos) cmul)) cpi cdiv)) $ >
  $ wceq B2 (cmpt n cn (co (citg x3 (co (cneg cpi) cpi cioo) (co (cfv (cv x3) F) (cfv (co (cv n) (cv x3) cmul) csin) cmul)) cpi cdiv)) $ >
  $ wceq S (cmpt n cn (co (co (cfv (cv n) A2) (cfv (co (cv n) X cmul) ccos) cmul) (co (cfv (cv n) B2) (cfv (co (cv n) X cmul) csin) cmul) caddc)) $ >
  $ wi ph (wbr (cseq caddc S c1) (co (co (co L R caddc) c2 cdiv) (co (cfv cc0 A2) c2 cdiv) cmin) cli) $;

--| Fourier series convergence, for piecewise smooth functions. See ~ fourier for the analogous ` sum_ ` equation. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem fourierclim {x3 n: setvar} (A2 B2 R S: class x3 n) (T: class n) (F: class) (G: class n) (L: class x3 n) (X: class):
  $ wf cr cr F $ >
  $ wceq T (co c2 cpi cmul) $ >
  $ wi (wcel (cv x3) cr) (wceq (cfv (co (cv x3) T caddc) F) (cfv (cv x3) F)) $ >
  $ wceq G (cres (co cr F cdv) (co (cneg cpi) cpi cioo)) $ >
  $ wcel (cdif (co (cneg cpi) cpi cioo) (cdm G)) cfn $ >
  $ wcel G (co (cdm G) cc ccncf) $ >
  $ wi (wcel (cv x3) (cdif (co (cneg cpi) cpi cico) (cdm G))) (wne (co (cres G (co (cv x3) cpnf cioo)) (cv x3) climc) c0) $ >
  $ wi (wcel (cv x3) (cdif (co (cneg cpi) cpi cioc) (cdm G))) (wne (co (cres G (co cmnf (cv x3) cioo)) (cv x3) climc) c0) $ >
  $ wcel X cr $ >
  $ wcel L (co (cres F (co cmnf X cioo)) X climc) $ >
  $ wcel R (co (cres F (co X cpnf cioo)) X climc) $ >
  $ wceq A2 (cmpt n cn0 (co (citg x3 (co (cneg cpi) cpi cioo) (co (cfv (cv x3) F) (cfv (co (cv n) (cv x3) cmul) ccos) cmul)) cpi cdiv)) $ >
  $ wceq B2 (cmpt n cn (co (citg x3 (co (cneg cpi) cpi cioo) (co (cfv (cv x3) F) (cfv (co (cv n) (cv x3) cmul) csin) cmul)) cpi cdiv)) $ >
  $ wceq S (cmpt n cn (co (co (cfv (cv n) A2) (cfv (co (cv n) X cmul) ccos) cmul) (co (cfv (cv n) B2) (cfv (co (cv n) X cmul) csin) cmul) caddc)) $ >
  $ wbr (cseq caddc S c1) (co (co (co L R caddc) c2 cdiv) (co (cfv cc0 A2) c2 cdiv) cmin) cli $;

--| Fourier series convergence for periodic, piecewise smooth functions. The series converges to the average value of the left and the right limit of the function. Thus, if the function is continuous at a given point, the series converges exactly to the function value, see ~ fouriercnp . Notice that for a piecewise smooth function, the left and right limits always exist, see ~ fourier2 for an alternative form of the theorem that makes this fact explicit. When the first derivative is continuous, a simpler version of the theorem can be stated, see ~ fouriercn . (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem fourier {x3 n: setvar} (A2 B2 R: class x3 n) (T: class n) (F: class) (G: class n) (L: class x3 n) (X: class):
  $ wf cr cr F $ >
  $ wceq T (co c2 cpi cmul) $ >
  $ wi (wcel (cv x3) cr) (wceq (cfv (co (cv x3) T caddc) F) (cfv (cv x3) F)) $ >
  $ wceq G (cres (co cr F cdv) (co (cneg cpi) cpi cioo)) $ >
  $ wcel (cdif (co (cneg cpi) cpi cioo) (cdm G)) cfn $ >
  $ wcel G (co (cdm G) cc ccncf) $ >
  $ wi (wcel (cv x3) (cdif (co (cneg cpi) cpi cico) (cdm G))) (wne (co (cres G (co (cv x3) cpnf cioo)) (cv x3) climc) c0) $ >
  $ wi (wcel (cv x3) (cdif (co (cneg cpi) cpi cioc) (cdm G))) (wne (co (cres G (co cmnf (cv x3) cioo)) (cv x3) climc) c0) $ >
  $ wcel X cr $ >
  $ wcel L (co (cres F (co cmnf X cioo)) X climc) $ >
  $ wcel R (co (cres F (co X cpnf cioo)) X climc) $ >
  $ wceq A2 (cmpt n cn0 (co (citg x3 (co (cneg cpi) cpi cioo) (co (cfv (cv x3) F) (cfv (co (cv n) (cv x3) cmul) ccos) cmul)) cpi cdiv)) $ >
  $ wceq B2 (cmpt n cn (co (citg x3 (co (cneg cpi) cpi cioo) (co (cfv (cv x3) F) (cfv (co (cv n) (cv x3) cmul) csin) cmul)) cpi cdiv)) $ >
  $ wceq (co (co (cfv cc0 A2) c2 cdiv) (csu n cn (co (co (cfv (cv n) A2) (cfv (co (cv n) X cmul) ccos) cmul) (co (cfv (cv n) B2) (cfv (co (cv n) X cmul) csin) cmul) caddc)) caddc) (co (co L R caddc) c2 cdiv) $;

--| If ` F ` is continuous at the point ` X ` , then its Fourier series at ` X ` , converges to ` ( F `` X ) ` . (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem fouriercnp {x3 n: setvar} (ph: wff n) (A2 B2: class x3 n) (T: class n) (F: class) (G: class n) (J: class x3 n) (X: class):
  $ wi ph (wf cr cr F) $ >
  $ wceq T (co c2 cpi cmul) $ >
  $ wi (wa ph (wcel (cv x3) cr)) (wceq (cfv (co (cv x3) T caddc) F) (cfv (cv x3) F)) $ >
  $ wceq G (cres (co cr F cdv) (co (cneg cpi) cpi cioo)) $ >
  $ wi ph (wcel (cdif (co (cneg cpi) cpi cioo) (cdm G)) cfn) $ >
  $ wi ph (wcel G (co (cdm G) cc ccncf)) $ >
  $ wi (wa ph (wcel (cv x3) (cdif (co (cneg cpi) cpi cico) (cdm G)))) (wne (co (cres G (co (cv x3) cpnf cioo)) (cv x3) climc) c0) $ >
  $ wi (wa ph (wcel (cv x3) (cdif (co (cneg cpi) cpi cioc) (cdm G)))) (wne (co (cres G (co cmnf (cv x3) cioo)) (cv x3) climc) c0) $ >
  $ wceq J (cfv (crn cioo) ctg) $ >
  $ wi ph (wcel F (cfv X (co J J ccnp))) $ >
  $ wceq A2 (cmpt n cn0 (co (citg x3 (co (cneg cpi) cpi cioo) (co (cfv (cv x3) F) (cfv (co (cv n) (cv x3) cmul) ccos) cmul)) cpi cdiv)) $ >
  $ wceq B2 (cmpt n cn (co (citg x3 (co (cneg cpi) cpi cioo) (co (cfv (cv x3) F) (cfv (co (cv n) (cv x3) cmul) csin) cmul)) cpi cdiv)) $ >
  $ wi ph (wceq (co (co (cfv cc0 A2) c2 cdiv) (csu n cn (co (co (cfv (cv n) A2) (cfv (co (cv n) X cmul) ccos) cmul) (co (cfv (cv n) B2) (cfv (co (cv n) X cmul) csin) cmul) caddc)) caddc) (cfv X F)) $;

--| Fourier series convergence, for a piecewise smooth function. Here it is also proven the existence of the left and right limits of ` F ` at any given point ` X ` . See ~ fourierd for a comparison. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem fourier2 {x3 n r l: setvar} (ph: wff) (A2 B2: class x3 r l) (T: class r l) (F: class) (G: class n r l) (X: class):
  $ wi ph (wf cr cr F) $ >
  $ wceq T (co c2 cpi cmul) $ >
  $ wi (wa ph (wcel (cv x3) cr)) (wceq (cfv (co (cv x3) T caddc) F) (cfv (cv x3) F)) $ >
  $ wceq G (cres (co cr F cdv) (co (cneg cpi) cpi cioo)) $ >
  $ wi ph (wcel (cdif (co (cneg cpi) cpi cioo) (cdm G)) cfn) $ >
  $ wi ph (wcel G (co (cdm G) cc ccncf)) $ >
  $ wi (wa ph (wcel (cv x3) (cdif (co (cneg cpi) cpi cico) (cdm G)))) (wne (co (cres G (co (cv x3) cpnf cioo)) (cv x3) climc) c0) $ >
  $ wi (wa ph (wcel (cv x3) (cdif (co (cneg cpi) cpi cioc) (cdm G)))) (wne (co (cres G (co cmnf (cv x3) cioo)) (cv x3) climc) c0) $ >
  $ wi ph (wcel X cr) $ >
  $ wceq A2 (cmpt n cn0 (co (citg x3 (co (cneg cpi) cpi cioo) (co (cfv (cv x3) F) (cfv (co (cv n) (cv x3) cmul) ccos) cmul)) cpi cdiv)) $ >
  $ wceq B2 (cmpt n cn (co (citg x3 (co (cneg cpi) cpi cioo) (co (cfv (cv x3) F) (cfv (co (cv n) (cv x3) cmul) csin) cmul)) cpi cdiv)) $ >
  $ wi ph (wrex l (wrex r (wceq (co (co (cfv cc0 A2) c2 cdiv) (csu n cn (co (co (cfv (cv n) A2) (cfv (co (cv n) X cmul) ccos) cmul) (co (cfv (cv n) B2) (cfv (co (cv n) X cmul) csin) cmul) caddc)) caddc) (co (co (cv l) (cv r) caddc) c2 cdiv)) (co (cres F (co X cpnf cioo)) X climc)) (co (cres F (co cmnf X cioo)) X climc)) $;

--| Fourier coefficients for the square wave function. Since the square function is an odd function, there is no contribution from the ` A ` coefficients. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem sqwvfoura {x3: setvar} (ph: wff) (T F: class x3) (N: class):
  $ wceq T (co c2 cpi cmul) $ >
  $ wceq F (cmpt x3 cr (cif (wbr (co (cv x3) T cmo) cpi clt) c1 (cneg c1))) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (co (citg x3 (co (cneg cpi) cpi cioo) (co (cfv (cv x3) F) (cfv (co N (cv x3) cmul) ccos) cmul)) cpi cdiv) cc0) $;

--| Fourier series ` B ` coefficients for the square wave function. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem sqwvfourb {x3: setvar} (ph: wff) (T F: class x3) (N: class):
  $ wceq T (co c2 cpi cmul) $ >
  $ wceq F (cmpt x3 cr (cif (wbr (co (cv x3) T cmo) cpi clt) c1 (cneg c1))) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wceq (co (citg x3 (co (cneg cpi) cpi cioo) (co (cfv (cv x3) F) (cfv (co N (cv x3) cmul) csin) cmul)) cpi cdiv) (cif (wbr c2 N cdvds) cc0 (co c4 (co N cpi cmul) cdiv))) $;

--| The Fourier series for the square wave ` F ` converges to ` Y ` , a simpler expression for this special case. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem fourierswlem {x3: setvar} (T: class) (F: class x3) (X: class) (Y: class x3):
  $ wceq T (co c2 cpi cmul) $ >
  $ wceq F (cmpt x3 cr (cif (wbr (co (cv x3) T cmo) cpi clt) c1 (cneg c1))) $ >
  $ wcel X cr $ >
  $ wceq Y (cif (wceq (co X cpi cmo) cc0) cc0 (cfv X F)) $ >
  $ wceq Y (co (co (cif (wcel (co X T cmo) (co cc0 cpi cioc)) c1 (cneg c1)) (cfv X F) caddc) c2 cdiv) $;

--| Fourier series convergence, for the square wave function. Where ` F ` is discontinuous, the series converges to ` 0 ` , the average value of the left and the right limits. Notice that ` F ` is an odd function and its Fourier expansion has only sine terms (coefficients for cosine terms are zero). (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem fouriersw {x3 k n: setvar} (S: class x3 k n) (T: class k n) (F: class k) (X: class) (Y: class x3 n):
  $ wceq T (co c2 cpi cmul) $ >
  $ wceq F (cmpt x3 cr (cif (wbr (co (cv x3) T cmo) cpi clt) c1 (cneg c1))) $ >
  $ wcel X cr $ >
  $ wceq S (cmpt n cn (co (cfv (co (co (co c2 (cv n) cmul) c1 cmin) X cmul) csin) (co (co c2 (cv n) cmul) c1 cmin) cdiv)) $ >
  $ wceq Y (cif (wceq (co X cpi cmo) cc0) cc0 (cfv X F)) $ >
  $ wa (wceq (co (co c4 cpi cdiv) (csu k cn (co (cfv (co (co (co c2 (cv k) cmul) c1 cmin) X cmul) csin) (co (co c2 (cv k) cmul) c1 cmin) cdiv)) cmul) Y) (wbr (cseq caddc S c1) (co (co cpi c4 cdiv) Y cmul) cli) $;

--| If the derivative of ` F ` is continuous, then the Fourier series for ` F ` converges to ` F ` everywhere and the hypothesis are simpler than those for the more general case of a piecewise smooth function (see ~ fourierd for a comparison). (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem fouriercn {x3 n: setvar} (ph: wff n) (A2 B2: class x3 n) (T: class n) (F: class) (G: class n) (X: class):
  $ wi ph (wf cr cr F) $ >
  $ wceq T (co c2 cpi cmul) $ >
  $ wi (wa ph (wcel (cv x3) cr)) (wceq (cfv (co (cv x3) T caddc) F) (cfv (cv x3) F)) $ >
  $ wi ph (wcel (co cr F cdv) (co cr cc ccncf)) $ >
  $ wceq G (cres (co cr F cdv) (co (cneg cpi) cpi cioo)) $ >
  $ wi ph (wcel X cr) $ >
  $ wceq A2 (cmpt n cn0 (co (citg x3 (co (cneg cpi) cpi cioo) (co (cfv (cv x3) F) (cfv (co (cv n) (cv x3) cmul) ccos) cmul)) cpi cdiv)) $ >
  $ wceq B2 (cmpt n cn (co (citg x3 (co (cneg cpi) cpi cioo) (co (cfv (cv x3) F) (cfv (co (cv n) (cv x3) cmul) csin) cmul)) cpi cdiv)) $ >
  $ wi ph (wceq (co (co (cfv cc0 A2) c2 cdiv) (csu n cn (co (co (cfv (cv n) A2) (cfv (co (cv n) X cmul) ccos) cmul) (co (cfv (cv n) B2) (cfv (co (cv n) X cmul) csin) cmul) caddc)) caddc) (cfv X F)) $;

--| Elementhood in the set of nonzero algebraic numbers. ' Only if ' part of ~ elaa2 . (Contributed by Glauco Siliprandi, 5-Apr-2020.) (Revised by AV, 1-Oct-2020.)
theorem elaa2lem {z f2 k n: setvar} (ph: wff f2 n) (A2: class n) (F: class z k n) (G: class f2) (I: class f2 n) (M: class f2):
  $ wi ph (wcel A2 caa) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wcel G (cfv cz cply)) $ >
  $ wi ph (wne G c0p) $ >
  $ wi ph (wceq (cfv A2 G) cc0) $ >
  $ wceq M (cinf (crab n (wne (cfv (cv n) (cfv G ccoe)) cc0) cn0) cr clt) $ >
  $ wceq I (cmpt k cn0 (cfv (co (cv k) M caddc) (cfv G ccoe))) $ >
  $ wceq F (cmpt z cc (csu k (co cc0 (co (cfv G cdgr) M cmin) cfz) (co (cfv (cv k) I) (co (cv z) (cv k) cexp) cmul))) $ >
  $ wi ph (wrex f2 (wa (wne (cfv cc0 (cfv (cv f2) ccoe)) cc0) (wceq (cfv A2 (cv f2)) cc0)) (cfv cz cply)) $;

--| Elementhood in the set of nonzero algebraic numbers: when ` A ` is nonzero, the polynomial ` f ` can be chosen with a nonzero constant term. (Contributed by Glauco Siliprandi, 5-Apr-2020.) (Proof shortened by AV, 1-Oct-2020.)
theorem elaa2 {f2: setvar} (A2: class):
  $ wb (wcel A2 (cdif caa (csn cc0))) (wa (wcel A2 cc) (wrex f2 (wa (wne (cfv cc0 (cfv (cv f2) ccoe)) cc0) (wceq (cfv A2 (cv f2)) cc0)) (cfv cz cply))) $;

--| ` H ` is a function. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem1 {x3 j: setvar} (ph: wff j) (P: class x3) (H: class x3 j) (J: class j) (M: class x3) (X: class):
  $ wi ph (wss X cc) $ >
  $ wi ph (wcel P cn) $ >
  $ wceq H (cmpt j (co cc0 M cfz) (cmpt x3 X (co (co (cv x3) (cv j) cmin) (cif (wceq (cv j) cc0) (co P c1 cmin) P) cexp))) $ >
  $ wi ph (wcel J (co cc0 M cfz)) $ >
  $ wi ph (wf X cc (cfv J H)) $;

--| Derivative of ` G ` . (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem2 {x3 i: setvar} (ph: wff) (R: class) (F: class x3) (G: class x3 i):
  $ wnfc x3 F $ >
  $ wi ph (wf cr cc F) $ >
  $ wi (wa ph (wcel (cv i) (co cc0 (co R c1 caddc) cfz))) (wf cr cc (cfv (cv i) (co cr F cdvn))) $ >
  $ wceq G (cmpt x3 cr (csu i (co cc0 R cfz) (cfv (cv x3) (cfv (cv i) (co cr F cdvn))))) $ >
  $ wi ph (wceq (co cr G cdv) (cmpt x3 cr (csu i (co cc0 R cfz) (cfv (cv x3) (cfv (co (cv i) c1 caddc) (co cr F cdvn)))))) $;

--| The given ` if ` term is an integer. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem3 (ph: wff) (C P J K M N: class):
  $ wi ph (wcel P cn) $ >
  $ wi ph (wf (co cc0 M cfz) (co cc0 N cfz) C) $ >
  $ wi ph (wcel J (co cc0 M cfz)) $ >
  $ wi ph (wcel K cz) $ >
  $ wi ph (wcel (cif (wbr P (cfv J C) clt) cc0 (co (co (cfv P cfa) (cfv (co P (cfv J C) cmin) cfa) cdiv) (co (co K J cmin) (co P (cfv J C) cmin) cexp) cmul)) cz) $;

--| ` F ` expressed as a finite product. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem4 {x3 j: setvar} (ph: wff) (A2: class) (P: class x3) (E F H: class x3 j) (M: class x3):
  $ wi ph (wss A2 cc) $ >
  $ wi ph (wcel P cn) $ >
  $ wi ph (wcel M cn0) $ >
  $ wceq F (cmpt x3 A2 (co (co (cv x3) (co P c1 cmin) cexp) (cprod j (co c1 M cfz) (co (co (cv x3) (cv j) cmin) P cexp)) cmul)) $ >
  $ wceq H (cmpt j (co cc0 M cfz) (cmpt x3 A2 (co (co (cv x3) (cv j) cmin) (cif (wceq (cv j) cc0) (co P c1 cmin) P) cexp))) $ >
  $ wceq E (cmpt x3 A2 (cprod j (co cc0 M cfz) (cfv (cv x3) (cfv (cv j) H)))) $ >
  $ wi ph (wceq F E) $;

--| A change of bound variable, often used in proofs for ~ etransc . (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem5 {x3 y1 j k: setvar} (P: class) (M: class x3 y1) (X: class):
  $ wceq (cmpt j (co cc0 M cfz) (cmpt x3 X (co (co (cv x3) (cv j) cmin) (cif (wceq (cv j) cc0) (co P c1 cmin) P) cexp))) (cmpt k (co cc0 M cfz) (cmpt y1 X (co (co (cv y1) (cv k) cmin) (cif (wceq (cv k) cc0) (co P c1 cmin) P) cexp))) $;

--| A change of bound variable, often used in proofs for ~ etransc . (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem6 {x3 y1 j k: setvar} (P M: class):
  $ wceq (cmpt x3 cr (co (co (cv x3) (co P c1 cmin) cexp) (cprod j (co c1 M cfz) (co (co (cv x3) (cv j) cmin) P cexp)) cmul)) (cmpt y1 cr (co (co (cv y1) (co P c1 cmin) cexp) (cprod k (co c1 M cfz) (co (co (cv y1) (cv k) cmin) P cexp)) cmul)) $;

--| The given product is an integer. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem7 {j: setvar} (ph: wff) (C P J: class j) (M: class) (N: class j):
  $ wi ph (wcel P cn) $ >
  $ wi ph (wf (co cc0 M cfz) (co cc0 N cfz) C) $ >
  $ wi ph (wcel J (co cc0 M cfz)) $ >
  $ wi ph (wcel (cprod j (co c1 M cfz) (cif (wbr P (cfv (cv j) C) clt) cc0 (co (co (cfv P cfa) (cfv (co P (cfv (cv j) C) cmin) cfa) cdiv) (co (co J (cv j) cmin) (co P (cfv (cv j) C) cmin) cexp) cmul))) cz) $;

--| ` F ` is a function. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem8 {x3 j: setvar} (ph: wff) (P F: class x3 j) (M: class x3) (X: class):
  $ wi ph (wss X cc) $ >
  $ wi ph (wcel P cn) $ >
  $ wceq F (cmpt x3 X (co (co (cv x3) (co P c1 cmin) cexp) (cprod j (co c1 M cfz) (co (co (cv x3) (cv j) cmin) P cexp)) cmul)) $ >
  $ wi ph (wf X cc F) $;

--| If ` K ` divides ` N ` but ` K ` does not divide ` M ` then ` M + N ` cannot be zero. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem9 (ph: wff) (K M N: class):
  $ wi ph (wcel K cz) $ >
  $ wi ph (wne K cc0) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wn (wbr K M cdvds)) $ >
  $ wi ph (wbr K N cdvds) $ >
  $ wi ph (wne (co M N caddc) cc0) $;

--| The given ` if ` term is an integer. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem10 (ph: wff) (C P J M N: class):
  $ wi ph (wcel P cn) $ >
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wf (co cc0 M cfz) (co cc0 N cfz) C) $ >
  $ wi ph (wcel J cz) $ >
  $ wi ph (wcel (cif (wbr (co P c1 cmin) (cfv cc0 C) clt) cc0 (co (co (cfv (co P c1 cmin) cfa) (cfv (co (co P c1 cmin) (cfv cc0 C) cmin) cfa) cdiv) (co J (co (co P c1 cmin) (cfv cc0 C) cmin) cexp) cmul)) cz) $;

--| A change of bound variable, often used in proofs for ~ etransc . (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem11 {j k m n c d: setvar} (M: class):
  $ wceq (cmpt n cn0 (crab c (wceq (csu j (co cc0 M cfz) (cfv (cv j) (cv c))) (cv n)) (co (co cc0 (cv n) cfz) (co cc0 M cfz) cmap))) (cmpt m cn0 (crab d (wceq (csu k (co cc0 M cfz) (cfv (cv k) (cv d))) (cv m)) (co (co cc0 (cv m) cfz) (co cc0 M cfz) cmap))) $;

--| ` C ` applied to ` N ` . (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem12 {j n c: setvar} (ph: wff j c) (C: class j n c) (M N: class j):
  $ wceq C (cmpt n cn0 (crab c (wceq (csu j (co cc0 M cfz) (cfv (cv j) (cv c))) (cv n)) (co (co cc0 (cv n) cfz) (co cc0 M cfz) cmap))) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (cfv N C) (crab c (wceq (csu j (co cc0 M cfz) (cfv (cv j) (cv c))) N) (co (co cc0 N cfz) (co cc0 M cfz) cmap))) $;

--| ` F ` applied to ` Y ` . (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem13 {x3 j: setvar} (ph: wff) (P: class) (F: class x3 j) (M X Y: class):
  $ wi ph (wss X cc) $ >
  $ wi ph (wcel P cn) $ >
  $ wi ph (wcel M cn0) $ >
  $ wceq F (cmpt x3 X (co (co (cv x3) (co P c1 cmin) cexp) (cprod j (co c1 M cfz) (co (co (cv x3) (cv j) cmin) P cexp)) cmul)) $ >
  $ wi ph (wcel Y X) $ >
  $ wi ph (wceq (cfv Y F) (cprod j (co cc0 M cfz) (co (co Y (cv j) cmin) (cif (wceq (cv j) cc0) (co P c1 cmin) P) cexp))) $;

--| Value of the term ` T ` , when ` J = 0 ` and ` ( C `` 0 ) = P - 1 ` (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem14 {j: setvar} (ph: wff) (C P T J: class j) (M: class) (N: class j):
  $ wi ph (wcel P cn) $ >
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wf (co cc0 M cfz) (co cc0 N cfz) C) $ >
  $ wceq T (co (co (cfv N cfa) (cprod j (co cc0 M cfz) (cfv (cfv (cv j) C) cfa)) cdiv) (co (cif (wbr (co P c1 cmin) (cfv cc0 C) clt) cc0 (co (co (cfv (co P c1 cmin) cfa) (cfv (co (co P c1 cmin) (cfv cc0 C) cmin) cfa) cdiv) (co J (co (co P c1 cmin) (cfv cc0 C) cmin) cexp) cmul)) (cprod j (co c1 M cfz) (cif (wbr P (cfv (cv j) C) clt) cc0 (co (co (cfv P cfa) (cfv (co P (cfv (cv j) C) cmin) cfa) cdiv) (co (co J (cv j) cmin) (co P (cfv (cv j) C) cmin) cexp) cmul))) cmul) cmul) $ >
  $ wi ph (wceq J cc0) $ >
  $ wi ph (wceq (cfv cc0 C) (co P c1 cmin)) $ >
  $ wi ph (wceq T (co (co (cfv N cfa) (cprod j (co cc0 M cfz) (cfv (cfv (cv j) C) cfa)) cdiv) (co (cfv (co P c1 cmin) cfa) (cprod j (co c1 M cfz) (cif (wbr P (cfv (cv j) C) clt) cc0 (co (co (cfv P cfa) (cfv (co P (cfv (cv j) C) cmin) cfa) cdiv) (co (cneg (cv j)) (co P (cfv (cv j) C) cmin) cexp) cmul))) cmul) cmul)) $;

--| Value of the term ` T ` , when ` J = 0 ` and ` ( C `` 0 ) = P - 1 ` (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem15 {j: setvar} (ph: wff) (C P T J: class j) (M: class) (N: class j):
  $ wi ph (wcel P cn) $ >
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wf (co cc0 M cfz) (co cc0 N cfz) C) $ >
  $ wceq T (co (co (cfv N cfa) (cprod j (co cc0 M cfz) (cfv (cfv (cv j) C) cfa)) cdiv) (co (cif (wbr (co P c1 cmin) (cfv cc0 C) clt) cc0 (co (co (cfv (co P c1 cmin) cfa) (cfv (co (co P c1 cmin) (cfv cc0 C) cmin) cfa) cdiv) (co J (co (co P c1 cmin) (cfv cc0 C) cmin) cexp) cmul)) (cprod j (co c1 M cfz) (cif (wbr P (cfv (cv j) C) clt) cc0 (co (co (cfv P cfa) (cfv (co P (cfv (cv j) C) cmin) cfa) cdiv) (co (co J (cv j) cmin) (co P (cfv (cv j) C) cmin) cexp) cmul))) cmul) cmul) $ >
  $ wi ph (wceq J cc0) $ >
  $ wi ph (wne (cfv cc0 C) (co P c1 cmin)) $ >
  $ wi ph (wceq T cc0) $;

--| Every element in the range of ` C ` is a finite set. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem16 {j n c: setvar} (ph: wff j c) (C: class j n c) (M N: class j):
  $ wceq C (cmpt n cn0 (crab c (wceq (csu j (co cc0 M cfz) (cfv (cv j) (cv c))) (cv n)) (co (co cc0 (cv n) cfz) (co cc0 M cfz) cmap))) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel (cfv N C) cfn) $;

--| The ` N ` -th derivative of ` H ` . (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem17 {x3 j: setvar} (ph: wff) (P: class) (S: class j) (H: class x3 j) (J M: class) (N: class j) (X: class):
  $ wi ph (wcel S (cpr cr cc)) $ >
  $ wi ph (wcel X (co (cfv ccnfld ctopn) S crest)) $ >
  $ wi ph (wcel P cn) $ >
  $ wceq H (cmpt j (co cc0 M cfz) (cmpt x3 X (co (co (cv x3) (cv j) cmin) (cif (wceq (cv j) cc0) (co P c1 cmin) P) cexp))) $ >
  $ wi ph (wcel J (co cc0 M cfz)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (cfv N (co S (cfv J H) cdvn)) (cmpt x3 X (cif (wbr (cif (wceq J cc0) (co P c1 cmin) P) N clt) cc0 (co (co (cfv (cif (wceq J cc0) (co P c1 cmin) P) cfa) (cfv (co (cif (wceq J cc0) (co P c1 cmin) P) N cmin) cfa) cdiv) (co (co (cv x3) J cmin) (co (cif (wceq J cc0) (co P c1 cmin) P) N cmin) cexp) cmul)))) $;

--| The given function is integrable. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem18 {x3 j: setvar} (ph: wff) (A2 B2: class j) (P: class) (F: class x3 j) (M: class):
  $ wi ph (wcel cr (cpr cr cc)) $ >
  $ wi ph (wcel cr (co (cfv ccnfld ctopn) cr crest)) $ >
  $ wi ph (wcel P cn) $ >
  $ wi ph (wcel M cn0) $ >
  $ wceq F (cmpt x3 cr (co (co (cv x3) (co P c1 cmin) cexp) (cprod j (co c1 M cfz) (co (co (cv x3) (cv j) cmin) P cexp)) cmul)) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel (cmpt x3 (co A2 B2 cioo) (co (co ceu (cneg (cv x3)) ccxp) (cfv (cv x3) F) cmul)) cibl) $;

--| The ` N ` -th derivative of ` H ` is 0 if ` N ` is large enough. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem19 {x3 j: setvar} (ph: wff) (P: class) (S: class j) (H: class x3 j) (J M: class) (N: class j) (X: class):
  $ wi ph (wcel S (cpr cr cc)) $ >
  $ wi ph (wcel X (co (cfv ccnfld ctopn) S crest)) $ >
  $ wi ph (wcel P cn) $ >
  $ wceq H (cmpt j (co cc0 M cfz) (cmpt x3 X (co (co (cv x3) (cv j) cmin) (cif (wceq (cv j) cc0) (co P c1 cmin) P) cexp))) $ >
  $ wi ph (wcel J (co cc0 M cfz)) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wbr (cif (wceq J cc0) (co P c1 cmin) P) N clt) $ >
  $ wi ph (wceq (cfv N (co S (cfv J H) cdvn)) (cmpt x3 X cc0)) $;

--| ` H ` is smooth. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem20 {x3 j: setvar} (ph: wff) (P: class) (S: class j) (H: class x3 j) (J M: class) (N: class j) (X: class):
  $ wi ph (wcel S (cpr cr cc)) $ >
  $ wi ph (wcel X (co (cfv ccnfld ctopn) S crest)) $ >
  $ wi ph (wcel P cn) $ >
  $ wceq H (cmpt j (co cc0 M cfz) (cmpt x3 X (co (co (cv x3) (cv j) cmin) (cif (wceq (cv j) cc0) (co P c1 cmin) P) cexp))) $ >
  $ wi ph (wcel J (co cc0 M cfz)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wf X cc (cfv N (co S (cfv J H) cdvn))) $;

--| The ` N ` -th derivative of ` H ` applied to ` Y ` . (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem21 {x3 j: setvar} (ph: wff) (P: class) (S: class j) (H: class x3 j) (J M: class) (N: class j) (X: class) (Y: class j):
  $ wi ph (wcel S (cpr cr cc)) $ >
  $ wi ph (wcel X (co (cfv ccnfld ctopn) S crest)) $ >
  $ wi ph (wcel P cn) $ >
  $ wceq H (cmpt j (co cc0 M cfz) (cmpt x3 X (co (co (cv x3) (cv j) cmin) (cif (wceq (cv j) cc0) (co P c1 cmin) P) cexp))) $ >
  $ wi ph (wcel J (co cc0 M cfz)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel Y X) $ >
  $ wi ph (wceq (cfv Y (cfv N (co S (cfv J H) cdvn))) (cif (wbr (cif (wceq J cc0) (co P c1 cmin) P) N clt) cc0 (co (co (cfv (cif (wceq J cc0) (co P c1 cmin) P) cfa) (cfv (co (cif (wceq J cc0) (co P c1 cmin) P) N cmin) cfa) cdiv) (co (co Y J cmin) (co (cif (wceq J cc0) (co P c1 cmin) P) N cmin) cexp) cmul))) $;

--| The ` N ` -th derivative of ` H ` is continuous. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem22 {x3 j: setvar} (ph: wff) (P: class) (S: class j) (H: class x3 j) (J M: class) (N: class j) (X: class):
  $ wi ph (wcel S (cpr cr cc)) $ >
  $ wi ph (wcel X (co (cfv ccnfld ctopn) S crest)) $ >
  $ wi ph (wcel P cn) $ >
  $ wceq H (cmpt j (co cc0 M cfz) (cmpt x3 X (co (co (cv x3) (cv j) cmin) (cif (wceq (cv j) cc0) (co P c1 cmin) P) cexp))) $ >
  $ wi ph (wcel J (co cc0 M cfz)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel (cfv N (co S (cfv J H) cdvn)) (co X cc ccncf)) $;

--| This is the claim proof in [Juillerat] p. 14 (but in our proof, Stirling's approximation is not used). (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem23 {x3 j: setvar} (ph: wff) (A2: class x3 j) (P: class) (F K L: class x3 j) (M: class):
  $ wi ph (wf cn0 cz A2) $ >
  $ wceq L (csu j (co cc0 M cfz) (co (co (cfv (cv j) A2) (co ceu (cv j) ccxp) cmul) (citg x3 (co cc0 (cv j) cioo) (co (co ceu (cneg (cv x3)) ccxp) (cfv (cv x3) F) cmul)) cmul)) $ >
  $ wceq K (co L (cfv (co P c1 cmin) cfa) cdiv) $ >
  $ wi ph (wcel P cn) $ >
  $ wi ph (wcel M cn) $ >
  $ wceq F (cmpt x3 cr (co (co (cv x3) (co P c1 cmin) cexp) (cprod j (co c1 M cfz) (co (co (cv x3) (cv j) cmin) P cexp)) cmul)) $ >
  $ wi ph (wbr (co (csu j (co cc0 M cfz) (co (cfv (co (cfv (cv j) A2) (co ceu (cv j) ccxp) cmul) cabs) (co M (co M (co M c1 caddc) cexp) cmul) cmul)) (co (co (co M (co M c1 caddc) cexp) (co P c1 cmin) cexp) (cfv (co P c1 cmin) cfa) cdiv) cmul) c1 clt) $ >
  $ wi ph (wbr (cfv K cabs) c1 clt) $;

--| ` P ` divides the I -th derivative of ` F ` applied to ` J ` . when ` J = 0 ` and ` I ` is not equal to ` P - 1 ` . This is the second part of case 2 proven in [Juillerat] p. 13 . (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem24 {j n c: setvar} (ph: wff c) (C: class j n c) (D: class n) (P: class n c) (I: class j) (J: class n c) (M: class):
  $ wi ph (wcel P cn) $ >
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wcel I cn0) $ >
  $ wi ph (wne I (co P c1 cmin)) $ >
  $ wi ph (wceq J cc0) $ >
  $ wceq C (cmpt n cn0 (crab c (wceq (csu j (co cc0 M cfz) (cfv (cv j) (cv c))) (cv n)) (co (co cc0 (cv n) cfz) (co cc0 M cfz) cmap))) $ >
  $ wi ph (wcel D (cfv I C)) $ >
  $ wi ph (wbr P (co (co (co (cfv I cfa) (cprod j (co cc0 M cfz) (cfv (cfv (cv j) D) cfa)) cdiv) (co (cif (wbr (co P c1 cmin) (cfv cc0 D) clt) cc0 (co (co (cfv (co P c1 cmin) cfa) (cfv (co (co P c1 cmin) (cfv cc0 D) cmin) cfa) cdiv) (co J (co (co P c1 cmin) (cfv cc0 D) cmin) cexp) cmul)) (cprod j (co c1 M cfz) (cif (wbr P (cfv (cv j) D) clt) cc0 (co (co (cfv P cfa) (cfv (co P (cfv (cv j) D) cmin) cfa) cdiv) (co (co J (cv j) cmin) (co P (cfv (cv j) D) cmin) cexp) cmul))) cmul) cmul) (cfv (co P c1 cmin) cfa) cdiv) cdvds) $;

--| ` P ` factorial divides the ` N ` -th derivative of ` F ` applied to ` J ` . (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem25 {j: setvar} (ph: wff) (C P: class) (T: class j) (J M: class) (N: class j):
  $ wi ph (wcel P cn) $ >
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wf (co cc0 M cfz) (co cc0 N cfz) C) $ >
  $ wi ph (wceq (csu j (co cc0 M cfz) (cfv (cv j) C)) N) $ >
  $ wceq T (co (co (cfv N cfa) (cprod j (co cc0 M cfz) (cfv (cfv (cv j) C) cfa)) cdiv) (co (cif (wbr (co P c1 cmin) (cfv cc0 C) clt) cc0 (co (co (cfv (co P c1 cmin) cfa) (cfv (co (co P c1 cmin) (cfv cc0 C) cmin) cfa) cdiv) (co J (co (co P c1 cmin) (cfv cc0 C) cmin) cexp) cmul)) (cprod j (co c1 M cfz) (cif (wbr P (cfv (cv j) C) clt) cc0 (co (co (cfv P cfa) (cfv (co P (cfv (cv j) C) cmin) cfa) cdiv) (co (co J (cv j) cmin) (co P (cfv (cv j) C) cmin) cexp) cmul))) cmul) cmul) $ >
  $ wi ph (wcel J (co c1 M cfz)) $ >
  $ wi ph (wbr (cfv P cfa) T cdvds) $;

--| Every term in the sum of the ` N ` -th derivative of ` F ` applied to ` J ` is an integer. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem26 {j n c: setvar} (ph: wff c) (C: class j n c) (D: class n) (P J: class j n c) (M: class) (N: class j):
  $ wi ph (wcel P cn) $ >
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel J cz) $ >
  $ wceq C (cmpt n cn0 (crab c (wceq (csu j (co cc0 M cfz) (cfv (cv j) (cv c))) (cv n)) (co (co cc0 (cv n) cfz) (co cc0 M cfz) cmap))) $ >
  $ wi ph (wcel D (cfv N C)) $ >
  $ wi ph (wcel (co (co (cfv N cfa) (cprod j (co cc0 M cfz) (cfv (cfv (cv j) D) cfa)) cdiv) (co (cif (wbr (co P c1 cmin) (cfv cc0 D) clt) cc0 (co (co (cfv (co P c1 cmin) cfa) (cfv (co (co P c1 cmin) (cfv cc0 D) cmin) cfa) cdiv) (co J (co (co P c1 cmin) (cfv cc0 D) cmin) cexp) cmul)) (cprod j (co c1 M cfz) (cif (wbr P (cfv (cv j) D) clt) cc0 (co (co (cfv P cfa) (cfv (co P (cfv (cv j) D) cmin) cfa) cdiv) (co (co J (cv j) cmin) (co P (cfv (cv j) D) cmin) cexp) cmul))) cmul) cmul) cz) $;

--| The ` N ` -th derivative of ` F ` applied to ` J ` is an integer. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem27 {x3 j l: setvar} (ph: wff) (C: class) (P: class l) (S: class j l) (G: class x3 j l) (H: class j l) (J: class) (M X: class l):
  $ wi ph (wcel S (cpr cr cc)) $ >
  $ wi ph (wcel X (co (cfv ccnfld ctopn) S crest)) $ >
  $ wi ph (wcel P cn) $ >
  $ wceq H (cmpt j (co cc0 M cfz) (cmpt x3 X (co (co (cv x3) (cv j) cmin) (cif (wceq (cv j) cc0) (co P c1 cmin) P) cexp))) $ >
  $ wi ph (wcel C cfn) $ >
  $ wi ph (wf (cdm C) (co cn0 (co cc0 M cfz) cmap) C) $ >
  $ wceq G (cmpt x3 X (csu l (cdm C) (cprod j (co cc0 M cfz) (cfv (cv x3) (cfv (cfv (cv j) (cfv (cv l) C)) (co S (cfv (cv j) H) cdvn)))))) $ >
  $ wi ph (wcel J X) $ >
  $ wi ph (wcel J cz) $ >
  $ wi ph (wcel (cfv J G) cz) $;

--| ` ( P - 1 ) ` factorial divides the ` N ` -th derivative of ` F ` applied to ` J ` . (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem28 {j n c: setvar} (ph: wff c) (C: class j n c) (D: class n) (P: class n c) (T: class j n c) (J: class n c) (M: class) (N: class j):
  $ wi ph (wcel P cn) $ >
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wcel N cn0) $ >
  $ wceq C (cmpt n cn0 (crab c (wceq (csu j (co cc0 M cfz) (cfv (cv j) (cv c))) (cv n)) (co (co cc0 (cv n) cfz) (co cc0 M cfz) cmap))) $ >
  $ wi ph (wcel D (cfv N C)) $ >
  $ wi ph (wcel J (co cc0 M cfz)) $ >
  $ wceq T (co (co (cfv N cfa) (cprod j (co cc0 M cfz) (cfv (cfv (cv j) D) cfa)) cdiv) (co (cif (wbr (co P c1 cmin) (cfv cc0 D) clt) cc0 (co (co (cfv (co P c1 cmin) cfa) (cfv (co (co P c1 cmin) (cfv cc0 D) cmin) cfa) cdiv) (co J (co (co P c1 cmin) (cfv cc0 D) cmin) cexp) cmul)) (cprod j (co c1 M cfz) (cif (wbr P (cfv (cv j) D) clt) cc0 (co (co (cfv P cfa) (cfv (co P (cfv (cv j) D) cmin) cfa) cdiv) (co (co J (cv j) cmin) (co P (cfv (cv j) D) cmin) cexp) cmul))) cmul) cmul) $ >
  $ wi ph (wbr (cfv (co P c1 cmin) cfa) T cdvds) $;

--| The ` N ` -th derivative of ` F ` . (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem29 {x3 j n c: setvar} (ph: wff c) (C: class x3 j n) (P: class n c) (S: class) (E F: class x3 j n c) (H M N: class) (X: class c):
  $ wi ph (wcel S (cpr cr cc)) $ >
  $ wi ph (wcel X (co (cfv ccnfld ctopn) S crest)) $ >
  $ wi ph (wcel P cn) $ >
  $ wi ph (wcel M cn0) $ >
  $ wceq F (cmpt x3 X (co (co (cv x3) (co P c1 cmin) cexp) (cprod j (co c1 M cfz) (co (co (cv x3) (cv j) cmin) P cexp)) cmul)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wceq H (cmpt j (co cc0 M cfz) (cmpt x3 X (co (co (cv x3) (cv j) cmin) (cif (wceq (cv j) cc0) (co P c1 cmin) P) cexp))) $ >
  $ wceq C (cmpt n cn0 (crab c (wceq (csu j (co cc0 M cfz) (cfv (cv j) (cv c))) (cv n)) (co (co cc0 (cv n) cfz) (co cc0 M cfz) cmap))) $ >
  $ wceq E (cmpt x3 X (cprod j (co cc0 M cfz) (cfv (cv x3) (cfv (cv j) H)))) $ >
  $ wi ph (wceq (cfv N (co S F cdvn)) (cmpt x3 X (csu c (cfv N C) (co (co (cfv N cfa) (cprod j (co cc0 M cfz) (cfv (cfv (cv j) (cv c)) cfa)) cdiv) (cprod j (co cc0 M cfz) (cfv (cv x3) (cfv (cfv (cv j) (cv c)) (co S (cfv (cv j) H) cdvn)))) cmul)))) $;

--| The ` N ` -th derivative of ` F ` . (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem30 {x3 j n c: setvar} (ph: wff c) (C: class x3 j n) (P: class n c) (S: class) (F: class x3 j n c) (H M N: class) (X: class c):
  $ wi ph (wcel S (cpr cr cc)) $ >
  $ wi ph (wcel X (co (cfv ccnfld ctopn) S crest)) $ >
  $ wi ph (wcel P cn) $ >
  $ wi ph (wcel M cn0) $ >
  $ wceq F (cmpt x3 X (co (co (cv x3) (co P c1 cmin) cexp) (cprod j (co c1 M cfz) (co (co (cv x3) (cv j) cmin) P cexp)) cmul)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wceq H (cmpt j (co cc0 M cfz) (cmpt x3 X (co (co (cv x3) (cv j) cmin) (cif (wceq (cv j) cc0) (co P c1 cmin) P) cexp))) $ >
  $ wceq C (cmpt n cn0 (crab c (wceq (csu j (co cc0 M cfz) (cfv (cv j) (cv c))) (cv n)) (co (co cc0 (cv n) cfz) (co cc0 M cfz) cmap))) $ >
  $ wi ph (wceq (cfv N (co S F cdvn)) (cmpt x3 X (csu c (cfv N C) (co (co (cfv N cfa) (cprod j (co cc0 M cfz) (cfv (cfv (cv j) (cv c)) cfa)) cdiv) (cprod j (co cc0 M cfz) (cfv (cv x3) (cfv (cfv (cv j) (cv c)) (co S (cfv (cv j) H) cdvn)))) cmul)))) $;

--| The ` N ` -th derivative of ` H ` applied to ` Y ` . (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem31 {x3 j n c: setvar} (ph: wff) (C: class n) (P: class n c) (S: class) (F: class x3 j n c) (H M N: class) (X: class c) (Y: class n):
  $ wi ph (wcel S (cpr cr cc)) $ >
  $ wi ph (wcel X (co (cfv ccnfld ctopn) S crest)) $ >
  $ wi ph (wcel P cn) $ >
  $ wi ph (wcel M cn0) $ >
  $ wceq F (cmpt x3 X (co (co (cv x3) (co P c1 cmin) cexp) (cprod j (co c1 M cfz) (co (co (cv x3) (cv j) cmin) P cexp)) cmul)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wceq H (cmpt j (co cc0 M cfz) (cmpt x3 X (co (co (cv x3) (cv j) cmin) (cif (wceq (cv j) cc0) (co P c1 cmin) P) cexp))) $ >
  $ wceq C (cmpt n cn0 (crab c (wceq (csu j (co cc0 M cfz) (cfv (cv j) (cv c))) (cv n)) (co (co cc0 (cv n) cfz) (co cc0 M cfz) cmap))) $ >
  $ wi ph (wcel Y X) $ >
  $ wi ph (wceq (cfv Y (cfv N (co S F cdvn))) (csu c (cfv N C) (co (co (cfv N cfa) (cprod j (co cc0 M cfz) (cfv (cfv (cv j) (cv c)) cfa)) cdiv) (co (cif (wbr (co P c1 cmin) (cfv cc0 (cv c)) clt) cc0 (co (co (cfv (co P c1 cmin) cfa) (cfv (co (co P c1 cmin) (cfv cc0 (cv c)) cmin) cfa) cdiv) (co Y (co (co P c1 cmin) (cfv cc0 (cv c)) cmin) cexp) cmul)) (cprod j (co c1 M cfz) (cif (wbr P (cfv (cv j) (cv c)) clt) cc0 (co (co (cfv P cfa) (cfv (co P (cfv (cv j) (cv c)) cmin) cfa) cdiv) (co (co Y (cv j) cmin) (co P (cfv (cv j) (cv c)) cmin) cexp) cmul))) cmul) cmul))) $;

--| This is the proof for the last equation in the proof of the derivative calculated in [Juillerat] p. 12, just after equation *(6) . (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem32 {x3 j: setvar} (ph: wff) (P S: class) (F: class x3 j) (H M N X: class):
  $ wi ph (wcel S (cpr cr cc)) $ >
  $ wi ph (wcel X (co (cfv ccnfld ctopn) S crest)) $ >
  $ wi ph (wcel P cn) $ >
  $ wi ph (wcel M cn0) $ >
  $ wceq F (cmpt x3 X (co (co (cv x3) (co P c1 cmin) cexp) (cprod j (co c1 M cfz) (co (co (cv x3) (cv j) cmin) P cexp)) cmul)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wbr (co (co M P cmul) (co P c1 cmin) caddc) N clt) $ >
  $ wceq H (cmpt j (co cc0 M cfz) (cmpt x3 X (co (co (cv x3) (cv j) cmin) (cif (wceq (cv j) cc0) (co P c1 cmin) P) cexp))) $ >
  $ wi ph (wceq (cfv N (co S F cdvn)) (cmpt x3 X cc0)) $;

--| ` F ` is smooth. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem33 {x3 j: setvar} (ph: wff) (P S: class) (F: class x3 j) (M N X: class):
  $ wi ph (wcel S (cpr cr cc)) $ >
  $ wi ph (wcel X (co (cfv ccnfld ctopn) S crest)) $ >
  $ wi ph (wcel P cn) $ >
  $ wi ph (wcel M cn0) $ >
  $ wceq F (cmpt x3 X (co (co (cv x3) (co P c1 cmin) cexp) (cprod j (co c1 M cfz) (co (co (cv x3) (cv j) cmin) P cexp)) cmul)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wf X cc (cfv N (co S F cdvn))) $;

--| The ` N ` -th derivative of ` F ` is continuous. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem34 {x3 k n c: setvar} (ph: wff) (C: class n) (P: class n c) (S: class) (F: class x3 k n) (H M N X: class):
  $ wi ph (wcel S (cpr cr cc)) $ >
  $ wi ph (wcel X (co (cfv ccnfld ctopn) S crest)) $ >
  $ wi ph (wcel P cn) $ >
  $ wi ph (wcel M cn0) $ >
  $ wceq F (cmpt x3 X (co (co (cv x3) (co P c1 cmin) cexp) (cprod k (co c1 M cfz) (co (co (cv x3) (cv k) cmin) P cexp)) cmul)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wceq H (cmpt k (co cc0 M cfz) (cmpt x3 X (co (co (cv x3) (cv k) cmin) (cif (wceq (cv k) cc0) (co P c1 cmin) P) cexp))) $ >
  $ wceq C (cmpt n cn0 (crab c (wceq (csu k (co cc0 M cfz) (cfv (cv k) (cv c))) (cv n)) (co (co cc0 (cv n) cfz) (co cc0 M cfz) cmap))) $ >
  $ wi ph (wcel (cfv N (co S F cdvn)) (co X cc ccncf)) $;

--| ` P ` does not divide the P-1 -th derivative of ` F ` applied to ` 0 ` . This is case 2 of the proof in [Juillerat] p. 13 . (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem35 {x3 j n c: setvar} (ph: wff) (C: class n) (D: class x3 n) (P: class) (F: class x3 j n c) (M: class):
  $ wi ph (wcel P cn) $ >
  $ wi ph (wcel M cn0) $ >
  $ wceq F (cmpt x3 cr (co (co (cv x3) (co P c1 cmin) cexp) (cprod j (co c1 M cfz) (co (co (cv x3) (cv j) cmin) P cexp)) cmul)) $ >
  $ wceq C (cmpt n cn0 (crab c (wceq (csu j (co cc0 M cfz) (cfv (cv j) (cv c))) (cv n)) (co (co cc0 (cv n) cfz) (co cc0 M cfz) cmap))) $ >
  $ wceq D (cmpt j (co cc0 M cfz) (cif (wceq (cv j) cc0) (co P c1 cmin) cc0)) $ >
  $ wi ph (wceq (cfv cc0 (cfv (co P c1 cmin) (co cr F cdvn))) (co (cfv (co P c1 cmin) cfa) (co (cprod j (co c1 M cfz) (cneg (cv j))) P cexp) cmul)) $;

--| The ` N ` -th derivative of ` F ` applied to ` J ` is an integer. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem36 {x3 j n c: setvar} (ph: wff) (C: class) (P: class n c) (S: class) (F: class x3 j n c) (H: class) (J: class n) (M N: class) (X: class c):
  $ wi ph (wcel S (cpr cr cc)) $ >
  $ wi ph (wcel X (co (cfv ccnfld ctopn) S crest)) $ >
  $ wi ph (wcel P cn) $ >
  $ wi ph (wcel M cn0) $ >
  $ wceq F (cmpt x3 X (co (co (cv x3) (co P c1 cmin) cexp) (cprod j (co c1 M cfz) (co (co (cv x3) (cv j) cmin) P cexp)) cmul)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wceq H (cmpt j (co cc0 M cfz) (cmpt x3 X (co (co (cv x3) (cv j) cmin) (cif (wceq (cv j) cc0) (co P c1 cmin) P) cexp))) $ >
  $ wi ph (wcel J X) $ >
  $ wi ph (wcel J cz) $ >
  $ wceq C (cmpt n cn0 (crab c (wceq (csu j (co cc0 M cfz) (cfv (cv j) (cv c))) (cv n)) (co (co cc0 (cv n) cfz) (co cc0 M cfz) cmap))) $ >
  $ wi ph (wcel (cfv J (cfv N (co S F cdvn))) cz) $;

--| ` ( P - 1 ) ` factorial divides the ` N ` -th derivative of ` F ` applied to ` J ` . (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem37 {x3 j n c: setvar} (ph: wff) (C P: class n) (S: class) (F: class x3 j n c) (H: class) (J: class n) (M N: class) (X: class c):
  $ wi ph (wcel S (cpr cr cc)) $ >
  $ wi ph (wcel X (co (cfv ccnfld ctopn) S crest)) $ >
  $ wi ph (wcel P cn) $ >
  $ wi ph (wcel M cn0) $ >
  $ wceq F (cmpt x3 X (co (co (cv x3) (co P c1 cmin) cexp) (cprod j (co c1 M cfz) (co (co (cv x3) (cv j) cmin) P cexp)) cmul)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wceq H (cmpt j (co cc0 M cfz) (cmpt x3 X (co (co (cv x3) (cv j) cmin) (cif (wceq (cv j) cc0) (co P c1 cmin) P) cexp))) $ >
  $ wceq C (cmpt n cn0 (crab c (wceq (csu j (co cc0 M cfz) (cfv (cv j) (cv c))) (cv n)) (co (co cc0 (cv n) cfz) (co cc0 M cfz) cmap))) $ >
  $ wi ph (wcel J (co cc0 M cfz)) $ >
  $ wi ph (wcel J X) $ >
  $ wi ph (wbr (cfv (co P c1 cmin) cfa) (cfv J (cfv N (co S F cdvn))) cdvds) $;

--| ` P ` divides the I -th derivative of ` F ` applied to ` J ` . if it is not the case that ` I = P - 1 ` and ` J = 0 ` . This is case 1 and the second part of case 2 proven in in [Juillerat] p. 13 . (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem38 {x3 j n c: setvar} (ph: wff) (C P: class) (F: class x3 j n c) (I J M: class):
  $ wi ph (wcel P cn) $ >
  $ wi ph (wcel M cn0) $ >
  $ wceq F (cmpt x3 cr (co (co (cv x3) (co P c1 cmin) cexp) (cprod j (co c1 M cfz) (co (co (cv x3) (cv j) cmin) P cexp)) cmul)) $ >
  $ wi ph (wcel I cn0) $ >
  $ wi ph (wcel J (co cc0 M cfz)) $ >
  $ wi ph (wn (wa (wceq I (co P c1 cmin)) (wceq J cc0))) $ >
  $ wceq C (cmpt n cn0 (crab c (wceq (csu j (co cc0 M cfz) (cfv (cv j) (cv c))) (cv n)) (co (co cc0 (cv n) cfz) (co cc0 M cfz) cmap))) $ >
  $ wi ph (wbr P (co (cfv J (cfv I (co cr F cdvn))) (cfv (co P c1 cmin) cfa) cdiv) cdvds) $;

--| ` G ` is a function. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem39 {x3 i j: setvar} (ph: wff) (P: class i) (R: class) (F G: class x3 i j) (M: class i):
  $ wi ph (wcel P cn) $ >
  $ wi ph (wcel M cn0) $ >
  $ wceq F (cmpt x3 cr (co (co (cv x3) (co P c1 cmin) cexp) (cprod j (co c1 M cfz) (co (co (cv x3) (cv j) cmin) P cexp)) cmul)) $ >
  $ wceq G (cmpt x3 cr (csu i (co cc0 R cfz) (cfv (cv x3) (cfv (cv i) (co cr F cdvn))))) $ >
  $ wi ph (wf cr cc G) $;

--| The ` N ` -th derivative of ` F ` is continuous. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem40 {x3 k: setvar} (ph: wff) (P S: class) (F: class x3 k) (M N X: class):
  $ wi ph (wcel S (cpr cr cc)) $ >
  $ wi ph (wcel X (co (cfv ccnfld ctopn) S crest)) $ >
  $ wi ph (wcel P cn) $ >
  $ wi ph (wcel M cn0) $ >
  $ wceq F (cmpt x3 X (co (co (cv x3) (co P c1 cmin) cexp) (cprod k (co c1 M cfz) (co (co (cv x3) (cv k) cmin) P cexp)) cmul)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel (cfv N (co S F cdvn)) (co X cc ccncf)) $;

--| ` P ` does not divide the P-1 -th derivative of ` F ` applied to ` 0 ` . This is the first part of case 2: proven in in [Juillerat] p. 13 . (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem41 {x3 j: setvar} (ph: wff) (P: class) (F: class x3 j) (M: class):
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wbr (cfv M cfa) P clt) $ >
  $ wceq F (cmpt x3 cr (co (co (cv x3) (co P c1 cmin) cexp) (cprod j (co c1 M cfz) (co (co (cv x3) (cv j) cmin) P cexp)) cmul)) $ >
  $ wi ph (wn (wbr P (co (cfv cc0 (cfv (co P c1 cmin) (co cr F cdvn))) (cfv (co P c1 cmin) cfa) cdiv) cdvds)) $;

--| The ` N ` -th derivative of ` F ` applied to ` J ` is an integer. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem42 {x3 j: setvar} (ph: wff) (P S: class) (F: class x3 j) (J M N X: class):
  $ wi ph (wcel S (cpr cr cc)) $ >
  $ wi ph (wcel X (co (cfv ccnfld ctopn) S crest)) $ >
  $ wi ph (wcel P cn) $ >
  $ wi ph (wcel M cn0) $ >
  $ wceq F (cmpt x3 X (co (co (cv x3) (co P c1 cmin) cexp) (cprod j (co c1 M cfz) (co (co (cv x3) (cv j) cmin) P cexp)) cmul)) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel J X) $ >
  $ wi ph (wcel J cz) $ >
  $ wi ph (wcel (cfv J (cfv N (co S F cdvn))) cz) $;

--| ` G ` is a continuous function. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem43 {x3 i j: setvar} (ph: wff) (P: class i) (R: class) (S: class i) (F: class i j) (G: class x3 i j) (M: class i) (X: class):
  $ wi ph (wcel S (cpr cr cc)) $ >
  $ wi ph (wcel X (co (cfv ccnfld ctopn) S crest)) $ >
  $ wi ph (wcel P cn) $ >
  $ wi ph (wcel M cn0) $ >
  $ wceq F (cmpt x3 X (co (co (cv x3) (co P c1 cmin) cexp) (cprod j (co c1 M cfz) (co (co (cv x3) (cv j) cmin) P cexp)) cmul)) $ >
  $ wceq G (cmpt x3 X (csu i (co cc0 R cfz) (cfv (cv x3) (cfv (cv i) (co S F cdvn))))) $ >
  $ wi ph (wcel G (co X cc ccncf)) $;

--| The given finite sum is nonzero. This is the claim proved after equation (7) in [Juillerat] p. 12 . (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem44 {x3 j k: setvar} (ph: wff) (A2: class x3 j) (P: class) (F: class x3 j) (K: class x3 j k) (M: class):
  $ wi ph (wf cn0 cz A2) $ >
  $ wi ph (wne (cfv cc0 A2) cc0) $ >
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wbr (cfv (cfv cc0 A2) cabs) P clt) $ >
  $ wi ph (wbr (cfv M cfa) P clt) $ >
  $ wceq F (cmpt x3 cr (co (co (cv x3) (co P c1 cmin) cexp) (cprod j (co c1 M cfz) (co (co (cv x3) (cv j) cmin) P cexp)) cmul)) $ >
  $ wceq K (co (csu k (cxp (co cc0 M cfz) (co cc0 (co (co M P cmul) (co P c1 cmin) caddc) cfz)) (co (cfv (cfv (cv k) c1st) A2) (cfv (cfv (cv k) c1st) (cfv (cfv (cv k) c2nd) (co cr F cdvn))) cmul)) (cfv (co P c1 cmin) cfa) cdiv) $ >
  $ wi ph (wne K cc0) $;

--| ` K ` is an integer. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem45 {x3 j k: setvar} (ph: wff) (A2: class x3 j k) (P R: class) (F K: class x3 j k) (M: class):
  $ wi ph (wcel P cn) $ >
  $ wi ph (wcel M cn0) $ >
  $ wceq F (cmpt x3 cr (co (co (cv x3) (co P c1 cmin) cexp) (cprod j (co c1 M cfz) (co (co (cv x3) (cv j) cmin) P cexp)) cmul)) $ >
  $ wi ph (wf cn0 cz A2) $ >
  $ wceq K (co (csu k (cxp (co cc0 M cfz) (co cc0 R cfz)) (co (cfv (cfv (cv k) c1st) A2) (cfv (cfv (cv k) c1st) (cfv (cfv (cv k) c2nd) (co cr F cdvn))) cmul)) (cfv (co P c1 cmin) cfa) cdiv) $ >
  $ wi ph (wcel K cz) $;

--| This is the proof for equation *(7) in [Juillerat] p. 12. The proven equality will lead to a contradiction, because the left-hand side goes to ` 0 ` for large ` P ` , but the right-hand side is a nonzero integer. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem46 {x3 i j k: setvar} (ph: wff) (A2: class x3) (P: class i) (Q: class x3 i k) (R F: class) (G: class i k) (L: class x3 i j k) (M: class) (O: class i j k):
  $ wi ph (wcel Q (cdif (cfv cz cply) (csn c0p))) $ >
  $ wi ph (wceq (cfv ceu Q) cc0) $ >
  $ wceq A2 (cfv Q ccoe) $ >
  $ wceq M (cfv Q cdgr) $ >
  $ wi ph (wss cr cr) $ >
  $ wi ph (wcel cr (cpr cr cc)) $ >
  $ wi ph (wcel cr (co (cfv ccnfld ctopn) cr crest)) $ >
  $ wi ph (wcel P cn) $ >
  $ wceq F (cmpt x3 cr (co (co (cv x3) (co P c1 cmin) cexp) (cprod j (co c1 M cfz) (co (co (cv x3) (cv j) cmin) P cexp)) cmul)) $ >
  $ wceq L (csu j (co cc0 M cfz) (co (co (cfv (cv j) A2) (co ceu (cv j) ccxp) cmul) (citg x3 (co cc0 (cv j) cioo) (co (co ceu (cneg (cv x3)) ccxp) (cfv (cv x3) F) cmul)) cmul)) $ >
  $ wceq R (co (co M P cmul) (co P c1 cmin) caddc) $ >
  $ wceq G (cmpt x3 cr (csu i (co cc0 R cfz) (cfv (cv x3) (cfv (cv i) (co cr F cdvn))))) $ >
  $ wceq O (cmpt x3 (co cc0 (cv j) cicc) (cneg (co (co ceu (cneg (cv x3)) ccxp) (cfv (cv x3) G) cmul))) $ >
  $ wi ph (wceq (co L (cfv (co P c1 cmin) cfa) cdiv) (co (cneg (csu k (cxp (co cc0 M cfz) (co cc0 R cfz)) (co (cfv (cfv (cv k) c1st) A2) (cfv (cfv (cv k) c1st) (cfv (cfv (cv k) c2nd) (co cr F cdvn))) cmul))) (cfv (co P c1 cmin) cfa) cdiv)) $;

--| ` _e ` is transcendental. Section *5 of [Juillerat] p. 11 can be used as a reference for this proof. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem etransclem47 {x3 j k: setvar} (ph: wff) (A2: class x3) (P: class) (Q: class x3 k) (F: class) (K: class x3 j) (L: class x3 j k) (M: class):
  $ wi ph (wcel Q (cdif (cfv cz cply) (csn c0p))) $ >
  $ wi ph (wceq (cfv ceu Q) cc0) $ >
  $ wceq A2 (cfv Q ccoe) $ >
  $ wi ph (wne (cfv cc0 A2) cc0) $ >
  $ wceq M (cfv Q cdgr) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wbr (cfv (cfv cc0 A2) cabs) P clt) $ >
  $ wi ph (wbr (cfv M cfa) P clt) $ >
  $ wi ph (wbr (co (csu j (co cc0 M cfz) (co (cfv (co (cfv (cv j) A2) (co ceu (cv j) ccxp) cmul) cabs) (co M (co M (co M c1 caddc) cexp) cmul) cmul)) (co (co (co M (co M c1 caddc) cexp) (co P c1 cmin) cexp) (cfv (co P c1 cmin) cfa) cdiv) cmul) c1 clt) $ >
  $ wceq F (cmpt x3 cr (co (co (cv x3) (co P c1 cmin) cexp) (cprod j (co c1 M cfz) (co (co (cv x3) (cv j) cmin) P cexp)) cmul)) $ >
  $ wceq L (csu j (co cc0 M cfz) (co (co (cfv (cv j) A2) (co ceu (cv j) ccxp) cmul) (citg x3 (co cc0 (cv j) cioo) (co (co ceu (cneg (cv x3)) ccxp) (cfv (cv x3) F) cmul)) cmul)) $ >
  $ wceq K (co L (cfv (co P c1 cmin) cfa) cdiv) $ >
  $ wi ph (wrex k (wa (wne (cv k) cc0) (wbr (cfv (cv k) cabs) c1 clt)) cz) $;

--| ` _e ` is transcendental. Section *5 of [Juillerat] p. 11 can be used as a reference for this proof. In this lemma, a large enough prime ` p ` is chosen: it will be used by subsequent lemmas. (Contributed by Glauco Siliprandi, 5-Apr-2020.) (Revised by AV, 28-Sep-2020.)
theorem etransclem48 {i j k n: setvar} (ph: wff) (A2: class i) (C: class j k) (Q: class i k n) (S: class j k n) (T: class i n) (I: class j k) (M: class i):
  $ wi ph (wcel Q (cdif (cfv cz cply) (csn c0p))) $ >
  $ wi ph (wceq (cfv ceu Q) cc0) $ >
  $ wceq A2 (cfv Q ccoe) $ >
  $ wi ph (wne (cfv cc0 A2) cc0) $ >
  $ wceq M (cfv Q cdgr) $ >
  $ wceq C (csu j (co cc0 M cfz) (co (cfv (co (cfv (cv j) A2) (co ceu (cv j) ccxp) cmul) cabs) (co M (co M (co M c1 caddc) cexp) cmul) cmul)) $ >
  $ wceq S (cmpt n cn0 (co C (co (co (co M (co M c1 caddc) cexp) (cv n) cexp) (cfv (cv n) cfa) cdiv) cmul)) $ >
  $ wceq I (cinf (crab i (wral n (wbr (cfv (cfv (cv n) S) cabs) c1 clt) (cfv (cv i) cuz)) cn0) cr clt) $ >
  $ wceq T (csup (ctp (cfv (cfv cc0 A2) cabs) (cfv M cfa) I) cxr clt) $ >
  $ wi ph (wrex k (wa (wne (cv k) cc0) (wbr (cfv (cv k) cabs) c1 clt)) cz) $;

--| ` _e ` is transcendental. Section *5 of [Juillerat] p. 11 can be used as a reference for this proof. This is Metamath 100 proof #67. (Contributed by Glauco Siliprandi, 5-Apr-2020.) (Proof shortened by AV, 28-Sep-2020.)
theorem etransc:
  $ wcel ceu (cdif cc caa) $;

--| The topology of the generalized real Euclidean space. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem rrxtopn {x3 f2 g2: setvar} (ph: wff x3 f2 g2) (I V: class):
  $ wi ph (wcel I V) $ >
  $ wi ph (wceq (cfv (cfv I crrx) ctopn) (cfv (cmpo f2 g2 (cfv (cfv I crrx) cbs) (cfv (cfv I crrx) cbs) (cfv (co crefld (cmpt x3 I (co (co (cfv (cv x3) (cv f2)) (cfv (cv x3) (cv g2)) cmin) c2 cexp)) cgsu) csqrt)) cmopn)) $;

--| Generalized Euclidean real spaces are normed groups. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem rrxngp (I V: class):
  $ wi (wcel I V) (wcel (cfv I crrx) cngp) $;

--| Generalized Euclidean real spaces are topological spaces. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem rrxtps (I V: class):
  $ wi (wcel I V) (wcel (cfv I crrx) ctps) $;

--| The topology of the n-dimensional real Euclidean space. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem rrxtopnfi {f2 g2 k: setvar} (ph: wff) (I: class):
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wceq (cfv (cfv I crrx) ctopn) (cfv (cmpo f2 g2 (co cr I cmap) (co cr I cmap) (cfv (csu k I (co (co (cfv (cv k) (cv f2)) (cfv (cv k) (cv g2)) cmin) c2 cexp)) csqrt)) cmopn)) $;

--| The topology on generalized Euclidean real spaces. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem rrxtopon (I J V: class):
  $ wceq J (cfv (cfv I crrx) ctopn) $ >
  $ wi (wcel I V) (wcel J (cfv (cfv (cfv I crrx) cbs) ctopon)) $;

--| The topology on generalized Euclidean real spaces. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem rrxtop (I J V: class):
  $ wceq J (cfv (cfv I crrx) ctopn) $ >
  $ wi (wcel I V) (wcel J ctop) $;

--| Given two points in the space of n-dimensional real numbers, if every component is closer than ` E ` then the distance between the two points is less than ` ( ( sqrt `` n ) x. E ) ` . (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem rrndistlt {i: setvar} (ph: wff) (D: class i) (E I: class) (N: class i) (X Y: class):
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wne I c0) $ >
  $ wceq N (cfv I chash) $ >
  $ wi ph (wcel X (co cr I cmap)) $ >
  $ wi ph (wcel Y (co cr I cmap)) $ >
  $ wi (wa ph (wcel (cv i) I)) (wbr (cfv (co (cfv (cv i) X) (cfv (cv i) Y) cmin) cabs) E clt) $ >
  $ wi ph (wcel E crp) $ >
  $ wceq D (cfv (cfv I crrx) cds) $ >
  $ wi ph (wbr (co X Y D) (co (cfv N csqrt) E cmul) clt) $;

--| The topology on n-dimensional Euclidean real spaces. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem rrxtoponfi (I J: class):
  $ wceq J (cfv (cfv I crrx) ctopn) $ >
  $ wi (wcel I cfn) (wcel J (cfv (co cr I cmap) ctopon)) $;

--| The base set of the standard topology on the space of n-dimensional Real numbers. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem rrxunitopnfi (X: class):
  $ wi (wcel X cfn) (wceq (cuni (cfv (cfv X crrx) ctopn)) (co cr X cmap)) $;

--| The topology of the zero-dimensional real Euclidean space. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem rrxtopn0:
  $ wceq (cfv (cfv c0 crrx) ctopn) (cpw (csn c0)) $;

--| n-dimensional rational numbers are dense in the space of n-dimensional real numbers, with respect to the n-dimensional standard topology. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem qndenserrnbllem {y1: setvar} (ph: wff) (D: class y1) (E I X: class):
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wne I c0) $ >
  $ wi ph (wcel X (co cr I cmap)) $ >
  $ wceq D (cfv (cfv I crrx) cds) $ >
  $ wi ph (wcel E crp) $ >
  $ wi ph (wrex y1 (wcel (cv y1) (co X E (cfv D cbl))) (co cq I cmap)) $;

--| n-dimensional rational numbers are dense in the space of n-dimensional real numbers, with respect to the n-dimensional standard topology. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem qndenserrnbl {y1: setvar} (ph: wff) (D E I X: class):
  $ wi ph (wcel I cfn) $ >
  $ wi ph (wcel X (co cr I cmap)) $ >
  $ wceq D (cfv (cfv I crrx) cds) $ >
  $ wi ph (wcel E crp) $ >
  $ wi ph (wrex y1 (wcel (cv y1) (co X E (cfv D cbl))) (co cq I cmap)) $;

--| The topology of the zero-dimensional real Euclidean space. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem rrxtopn0b:
  $ wceq (cfv (cfv c0 crrx) ctopn) (cpr c0 (csn c0)) $;

--| n-dimensional rational numbers are dense in the space of n-dimensional real numbers, with respect to the n-dimensional standard topology. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem qndenserrnopnlem {y1: setvar} (ph: wff) (D I: class) (J: class y1) (V X: class):
  $ wi ph (wcel I cfn) $ >
  $ wceq J (cfv (cfv I crrx) ctopn) $ >
  $ wi ph (wcel V J) $ >
  $ wi ph (wcel X V) $ >
  $ wceq D (cfv (cfv I crrx) cds) $ >
  $ wi ph (wrex y1 (wcel (cv y1) V) (co cq I cmap)) $;

--| n-dimensional rational numbers are dense in the space of n-dimensional real numbers, with respect to the n-dimensional standard topology. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem qndenserrnopn {y1: setvar} (ph: wff) (I: class) (J: class y1) (V: class):
  $ wi ph (wcel I cfn) $ >
  $ wceq J (cfv (cfv I crrx) ctopn) $ >
  $ wi ph (wcel V J) $ >
  $ wi ph (wne V c0) $ >
  $ wi ph (wrex y1 (wcel (cv y1) V) (co cq I cmap)) $;

--| n-dimensional rational numbers are dense in the space of n-dimensional real numbers, with respect to the n-dimensional standard topology. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem qndenserrn (ph: wff) (I J: class):
  $ wi ph (wcel I cfn) $ >
  $ wceq J (cfv (cfv I crrx) ctopn) $ >
  $ wi ph (wceq (cfv (co cq I cmap) (cfv J ccl)) (co cr I cmap)) $;

--| A multidimensional singleton expressed as a multidimensional closed interval. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem rrxsnicc {k: setvar} (ph: wff) (A2 X: class):
  $ wi ph (wcel A2 (co cr X cmap)) $ >
  $ wi ph (wceq (cixp k X (co (cfv (cv k) A2) (cfv (cv k) A2) cicc)) (csn A2)) $;

--| The distance between two points in Euclidean space is greater than the distance between the projections onto one coordinate. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem rrnprjdstle (ph: wff) (D F G I X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wf X cr F) $ >
  $ wi ph (wf X cr G) $ >
  $ wi ph (wcel I X) $ >
  $ wceq D (cfv (cfv X crrx) cds) $ >
  $ wi ph (wbr (cfv (co (cfv I F) (cfv I G) cmin) cabs) (co F G D) cle) $;

--| ` D ` is a metric for the n-dimensional real Euclidean space. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem rrndsmet {f2 g2 k: setvar} (ph: wff f2 g2 k) (D: class f2 g2 k) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wceq D (cmpo f2 g2 (co cr X cmap) (co cr X cmap) (cfv (csu k X (co (co (cfv (cv k) (cv f2)) (cfv (cv k) (cv g2)) cmin) c2 cexp)) csqrt)) $ >
  $ wi ph (wcel D (cfv (co cr X cmap) cmet)) $;

--| ` D ` is an extended metric for the n-dimensional real Euclidean space. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem rrndsxmet {f2 g2 k: setvar} (ph: wff f2 g2 k) (D: class f2 g2 k) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wceq D (cmpo f2 g2 (co cr X cmap) (co cr X cmap) (cfv (csu k X (co (co (cfv (cv k) (cv f2)) (cfv (cv k) (cv g2)) cmin) c2 cexp)) csqrt)) $ >
  $ wi ph (wcel D (cfv (co cr X cmap) cxmet)) $;

--| The a point in an indexed product of open intervals is contained in an open ball that is contained in the indexed product of open intervals. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem ioorrnopnlem {v f2 g2 i k: setvar} (ph: wff v) (A2 B2: class f2 i k) (D E: class v f2 k) (F: class f2 k) (H: class v f2 g2 i k) (V: class f2 g2 i k) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wne X c0) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wf X cr B2) $ >
  $ wi ph (wcel F (cixp i X (co (cfv (cv i) A2) (cfv (cv i) B2) cioo))) $ >
  $ wceq H (crn (cmpt i X (cif (wbr (co (cfv (cv i) B2) (cfv (cv i) F) cmin) (co (cfv (cv i) F) (cfv (cv i) A2) cmin) cle) (co (cfv (cv i) B2) (cfv (cv i) F) cmin) (co (cfv (cv i) F) (cfv (cv i) A2) cmin)))) $ >
  $ wceq E (cinf H cr clt) $ >
  $ wceq V (co F E (cfv D cbl)) $ >
  $ wceq D (cmpo f2 g2 (co cr X cmap) (co cr X cmap) (cfv (csu k X (co (co (cfv (cv k) (cv f2)) (cfv (cv k) (cv g2)) cmin) c2 cexp)) csqrt)) $ >
  $ wi ph (wrex v (wa (wcel F (cv v)) (wss (cv v) (cixp i X (co (cfv (cv i) A2) (cfv (cv i) B2) cioo)))) (cfv (cfv X crrx) ctopn)) $;

--| The indexed product of open intervals is an open set in ` ( RR^ `` X ) ` . (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem ioorrnopn {i: setvar} (ph: wff) (A2 B2 X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wf X cr B2) $ >
  $ wi ph (wcel (cixp i X (co (cfv (cv i) A2) (cfv (cv i) B2) cioo)) (cfv (cfv X crrx) ctopn)) $;

--| Given a point ` F ` that belongs to an indexed product of (possibly unbounded) open intervals, then ` F ` belongs to an open product of bounded open intervals that's a subset of the original indexed product. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem ioorrnopnxrlem {v i: setvar} (ph: wff v) (A2 B2: class i) (R: class v) (F: class) (L: class v) (V: class i) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wf X cxr A2) $ >
  $ wi ph (wf X cxr B2) $ >
  $ wi ph (wcel F (cixp i X (co (cfv (cv i) A2) (cfv (cv i) B2) cioo))) $ >
  $ wceq L (cmpt i X (cif (wceq (cfv (cv i) A2) cmnf) (co (cfv (cv i) F) c1 cmin) (cfv (cv i) A2))) $ >
  $ wceq R (cmpt i X (cif (wceq (cfv (cv i) B2) cpnf) (co (cfv (cv i) F) c1 caddc) (cfv (cv i) B2))) $ >
  $ wceq V (cixp i X (co (cfv (cv i) L) (cfv (cv i) R) cioo)) $ >
  $ wi ph (wrex v (wa (wcel F (cv v)) (wss (cv v) (cixp i X (co (cfv (cv i) A2) (cfv (cv i) B2) cioo)))) (cfv (cfv X crrx) ctopn)) $;

--| The indexed product of open intervals is an open set in ` ( RR^ `` X ) ` . Similar to ~ ioorrnopn but here unbounded intervals are allowed. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem ioorrnopnxr {i: setvar} (ph: wff) (A2 B2 X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wf X cxr A2) $ >
  $ wi ph (wf X cxr B2) $ >
  $ wi ph (wcel (cixp i X (co (cfv (cv i) A2) (cfv (cv i) B2) cioo)) (cfv (cfv X crrx) ctopn)) $;

--| Extend class notation with the class of all sigma-algebras.
term csalg: class;

--| Define the class of sigma-algebras. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
axiom df_salg {x3 y1: setvar}:
  $ wceq csalg (cab x3 (w3a (wcel c0 (cv x3)) (wral y1 (wcel (cdif (cuni (cv x3)) (cv y1)) (cv x3)) (cv x3)) (wral y1 (wi (wbr (cv y1) com cdom) (wcel (cuni (cv y1)) (cv x3))) (cpw (cv x3))))) $;

--| Extend class notation with the class of sigma-algebras on a set.
term csalon: class;

--| Define the set of sigma-algebra on a given set. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
axiom df_salon {x3 s1: setvar}:
  $ wceq csalon (cmpt x3 cvv (crab s1 (wceq (cuni (cv s1)) (cv x3)) csalg)) $;

--| Extend class notation with the class of sigma-algebra generator.
term csalgen: class;

--| Define the sigma-algebra generated by a given set. Definition 111G (b) of [Fremlin1] p. 13. The sigma-algebra generated by a set is the smallest sigma-algebra, on the same base set, that includes the set, see ~ dfsalgen2 . The base set of the sigma-algebras used for the intersection needs to be the same, otherwise the resulting set is not guaranteed to be a sigma-algebra, as shown in the counterexample ~ salgencntex . (Contributed by Glauco Siliprandi, 17-Aug-2020.) (Revised by Glauco Siliprandi, 1-Jan-2021.)
axiom df_salgen {x3 s1: setvar}:
  $ wceq csalgen (cmpt x3 cvv (cint (crab s1 (wa (wceq (cuni (cv s1)) (cuni (cv x3))) (wss (cv x3) (cv s1))) csalg))) $;

--| Express the predicate " ` S ` is a sigma-algebra." (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem issal {y1: setvar} (S: class) (V: class y1):
  $ wi (wcel S V) (wb (wcel S csalg) (w3a (wcel c0 S) (wral y1 (wcel (cdif (cuni S) (cv y1)) S) S) (wral y1 (wi (wbr (cv y1) com cdom) (wcel (cuni (cv y1)) S)) (cpw S)))) $;

--| The power set of a given set is a sigma-algebra (the so called discrete sigma-algebra). (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem pwsal (V X: class):
  $ wi (wcel X V) (wcel (cpw X) csalg) $;

--| SAlg sigma-algebra is closed under countable union. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem salunicl (ph: wff) (S T: class):
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel T (cpw S)) $ >
  $ wi ph (wbr T com cdom) $ >
  $ wi ph (wcel (cuni T) S) $;

--| The union of two sets in a sigma-algebra is in the sigma-algebra. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem saluncl (S E F: class):
  $ wi (w3a (wcel S csalg) (wcel E S) (wcel F S)) (wcel (cun E F) S) $;

--| The pair of the empty set and the whole base is a sigma-algebra. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem prsal (V X: class):
  $ wi (wcel X V) (wcel (cpr c0 X) csalg) $;

--| The complement of an element of a sigma-algebra is in the sigma-algebra. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem saldifcl (S E: class):
  $ wi (wa (wcel S csalg) (wcel E S)) (wcel (cdif (cuni S) E) S) $;

--| The empty set belongs to every sigma-algebra. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem _0sal (S: class):
  $ wi (wcel S csalg) (wcel c0 S) $;

--| The sigma-algebra generated by a set. (Contributed by Glauco Siliprandi, 3-Jan-2021.)
theorem salgenval {s1: setvar} (V: class s1) (X: class):
  $ wi (wcel X V) (wceq (cfv X csalgen) (cint (crab s1 (wa (wceq (cuni (cv s1)) (cuni X)) (wss X (cv s1))) csalg))) $;

--| SAlg sigma-algebra is closed under countable indexed union. (Contributed by Glauco Siliprandi, 24-Jan-2025.)
theorem saliunclf {k: setvar} (ph: wff k) (S E K: class k):
  $ wnf k ph $ >
  $ wnfc k S $ >
  $ wnfc k K $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wbr K com cdom) $ >
  $ wi (wa ph (wcel (cv k) K)) (wcel E S) $ >
  $ wi ph (wcel (ciun k K E) S) $;

--| SAlg sigma-algebra is closed under countable indexed union. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem saliuncl {k: setvar} (ph: wff) (S: class) (E: class k) (K: class):
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wbr K com cdom) $ >
  $ wi (wa ph (wcel (cv k) K)) (wcel E S) $ >
  $ wi ph (wcel (ciun k K E) S) $;

--| The intersection of two sets in a sigma-algebra is in the sigma-algebra. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem salincl (S E F: class):
  $ wi (w3a (wcel S csalg) (wcel E S) (wcel F S)) (wcel (cin E F) S) $;

--| A set is an element of any sigma-algebra on it. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem saluni (S: class):
  $ wi (wcel S csalg) (wcel (cuni S) S) $;

--| SAlg sigma-algebra is closed under countable indexed intersection. (Contributed by Glauco Siliprandi, 24-Jan-2025.)
theorem saliinclf {k: setvar} (ph: wff k) (S E K: class k):
  $ wnf k ph $ >
  $ wnfc k S $ >
  $ wnfc k K $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wbr K com cdom) $ >
  $ wi ph (wne K c0) $ >
  $ wi (wa ph (wcel (cv k) K)) (wcel E S) $ >
  $ wi ph (wcel (ciin k K E) S) $;

--| SAlg sigma-algebra is closed under countable indexed intersection. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem saliincl {k: setvar} (ph: wff) (S: class) (E: class k) (K: class):
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wbr K com cdom) $ >
  $ wi ph (wne K c0) $ >
  $ wi (wa ph (wcel (cv k) K)) (wcel E S) $ >
  $ wi ph (wcel (ciin k K E) S) $;

--| The difference of two elements of a sigma-algebra is in the sigma-algebra. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem saldifcl2 (S E F: class):
  $ wi (w3a (wcel S csalg) (wcel E S) (wcel F S)) (wcel (cdif E F) S) $;

--| The union of an arbitrary intersection of sigma-algebras on the same set ` X ` , is ` X ` . (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem intsaluni {s1: setvar} (ph: wff) (G X: class):
  $ wi ph (wss G csalg) $ >
  $ wi ph (wne G c0) $ >
  $ wi (wa ph (wcel (cv s1) G)) (wceq (cuni (cv s1)) X) $ >
  $ wi ph (wceq (cuni (cint G)) X) $;

--| The arbitrary intersection of sigma-algebra (on the same set ` X ` ) is a sigma-algebra ( on the same set ` X ` , see ~ intsaluni ). (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem intsal {s1: setvar} (ph: wff) (G X: class):
  $ wi ph (wss G csalg) $ >
  $ wi ph (wne G c0) $ >
  $ wi (wa ph (wcel (cv s1) G)) (wceq (cuni (cv s1)) X) $ >
  $ wi ph (wcel (cint G) csalg) $;

--| The set used in the definition of the generated sigma-algebra, is not empty. (Contributed by Glauco Siliprandi, 3-Jan-2021.)
theorem salgenn0 {s1: setvar} (V: class s1) (X: class):
  $ wi (wcel X V) (wne (crab s1 (wa (wceq (cuni (cv s1)) (cuni X)) (wss X (cv s1))) csalg) c0) $;

--| ` SalGen ` actually generates a sigma-algebra. (Contributed by Glauco Siliprandi, 3-Jan-2021.)
theorem salgencl (V X: class):
  $ wi (wcel X V) (wcel (cfv X csalgen) csalg) $;

--| Sufficient condition to prove that ` S ` is sigma-algebra. (Contributed by Glauco Siliprandi, 3-Jan-2021.)
theorem issald {y1: setvar} (ph: wff) (S: class) (V X: class y1):
  $ wi ph (wcel S V) $ >
  $ wi ph (wcel c0 S) $ >
  $ wceq X (cuni S) $ >
  $ wi (wa ph (wcel (cv y1) S)) (wcel (cdif X (cv y1)) S) $ >
  $ wi (w3a ph (wcel (cv y1) (cpw S)) (wbr (cv y1) com cdom)) (wcel (cuni (cv y1)) S) $ >
  $ wi ph (wcel S csalg) $;

--| An example of nontrivial sigma-algebra: the collection of all subsets which either are countable or have countable complement. (Contributed by Glauco Siliprandi, 3-Jan-2021.)
theorem salexct {x3: setvar} (ph: wff) (A2 S: class) (V: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wceq S (crab x3 (wo (wbr (cv x3) com cdom) (wbr (cdif A2 (cv x3)) com cdom)) (cpw A2)) $ >
  $ wi ph (wcel S csalg) $;

--| A set is a subset of the sigma-algebra it generates. (Contributed by Glauco Siliprandi, 3-Jan-2021.)
theorem sssalgen (S V X: class):
  $ wceq S (cfv X csalgen) $ >
  $ wi (wcel X V) (wss X S) $;

--| The sigma-algebra generated by a set is the smallest sigma-algebra, on the same base set, that includes the set. Proposition 111G (b) of [Fremlin1] p. 13. Notice that the condition "on the same base set" is needed, see the counterexample ~ salgensscntex , where a sigma-algebra is shown that includes a set, but does not include the sigma-algebra generated (the key is that its base set is larger than the base set of the generating set). (Contributed by Glauco Siliprandi, 3-Jan-2021.)
theorem salgenss (ph: wff) (S G V X: class):
  $ wi ph (wcel X V) $ >
  $ wceq G (cfv X csalgen) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wss X S) $ >
  $ wi ph (wceq (cuni S) (cuni X)) $ >
  $ wi ph (wss G S) $;

--| The base set of the sigma-algebra generated by a set is the union of the set itself. (Contributed by Glauco Siliprandi, 3-Jan-2021.)
theorem salgenuni (ph: wff) (S U V X: class):
  $ wi ph (wcel X V) $ >
  $ wceq S (cfv X csalgen) $ >
  $ wceq U (cuni X) $ >
  $ wi ph (wceq (cuni S) U) $;

--| One side of ~ dfsalgen2 . If a sigma-algebra on ` U. X ` includes ` X ` and it is included in all the sigma-algebras with such two properties, then it is the sigma-algebra generated by ` X ` . (Contributed by Glauco Siliprandi, 3-Jan-2021.)
theorem issalgend {y1: setvar} (ph: wff) (S: class) (V: class y1) (X: class):
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wceq (cuni S) (cuni X)) $ >
  $ wi ph (wss X S) $ >
  $ wi (wa ph (w3a (wcel (cv y1) csalg) (wceq (cuni (cv y1)) (cuni X)) (wss X (cv y1)))) (wss S (cv y1)) $ >
  $ wi ph (wceq (cfv X csalgen) S) $;

--| An example of a subset that does not belong to a nontrivial sigma-algebra, see ~ salexct . (Contributed by Glauco Siliprandi, 3-Jan-2021.)
theorem salexct2 {x3: setvar} (A2 B2: class) (S: class x3):
  $ wceq A2 (co cc0 c2 cicc) $ >
  $ wceq S (crab x3 (wo (wbr (cv x3) com cdom) (wbr (cdif A2 (cv x3)) com cdom)) (cpw A2)) $ >
  $ wceq B2 (co cc0 c1 cicc) $ >
  $ wn (wcel B2 S) $;

--| The union of a set belongs to the sigma-algebra generated by the set. (Contributed by Glauco Siliprandi, 3-Jan-2021.)
theorem unisalgen (ph: wff) (S U V X: class):
  $ wi ph (wcel X V) $ >
  $ wceq S (cfv X csalgen) $ >
  $ wceq U (cuni X) $ >
  $ wi ph (wcel U S) $;

--| Alternate characterization of the sigma-algebra generated by a set. It is the smallest sigma-algebra, on the same base set, that includes the set. (Contributed by Glauco Siliprandi, 3-Jan-2021.)
theorem dfsalgen2 {y1: setvar} (ph: wff) (S: class) (V: class y1) (X: class):
  $ wi ph (wcel X V) $ >
  $ wi ph (wb (wceq (cfv X csalgen) S) (wa (w3a (wcel S csalg) (wceq (cuni S) (cuni X)) (wss X S)) (wral y1 (wi (wa (wceq (cuni (cv y1)) (cuni X)) (wss X (cv y1))) (wss S (cv y1))) csalg))) $;

--| An example of a sigma-algebra that's not closed under uncountable union. (Contributed by Glauco Siliprandi, 3-Jan-2021.)
theorem salexct3 {x3 y1: setvar} (A2: class y1) (S: class) (X: class y1):
  $ wceq A2 (co cc0 c2 cicc) $ >
  $ wceq S (crab x3 (wo (wbr (cv x3) com cdom) (wbr (cdif A2 (cv x3)) com cdom)) (cpw A2)) $ >
  $ wceq X (crn (cmpt y1 (co cc0 c1 cicc) (csn (cv y1)))) $ >
  $ w3a (wcel S csalg) (wss X S) (wn (wcel (cuni X) S)) $;

--| This counterexample shows that ~ df-salgen needs to require that all containing sigma-algebra have the same base set. Otherwise, the intersection could lead to a set that is not a sigma-algebra. (Contributed by Glauco Siliprandi, 3-Jan-2021.)
theorem salgencntex {x3 s1: setvar} (A2 B2: class s1) (C: class x3) (S: class) (T: class x3) (Z: class x3 s1):
  $ wceq A2 (co cc0 c2 cicc) $ >
  $ wceq S (crab x3 (wo (wbr (cv x3) com cdom) (wbr (cdif A2 (cv x3)) com cdom)) (cpw A2)) $ >
  $ wceq B2 (co cc0 c1 cicc) $ >
  $ wceq T (cpw B2) $ >
  $ wceq C (cin S T) $ >
  $ wceq Z (cint (crab s1 (wss C (cv s1)) csalg)) $ >
  $ wn (wcel Z csalg) $;

--| This counterexample shows that the sigma-algebra generated by a set is not the smallest sigma-algebra containing the set, if we consider also sigma-algebras with a larger base set. (Contributed by Glauco Siliprandi, 3-Jan-2021.)
theorem salgensscntex {x3 y1: setvar} (A2: class y1) (S: class) (G X: class x3 y1):
  $ wceq A2 (co cc0 c2 cicc) $ >
  $ wceq S (crab x3 (wo (wbr (cv x3) com cdom) (wbr (cdif A2 (cv x3)) com cdom)) (cpw A2)) $ >
  $ wceq X (crn (cmpt y1 (co cc0 c1 cicc) (csn (cv y1)))) $ >
  $ wceq G (cfv X csalgen) $ >
  $ w3a (wss X S) (wcel S csalg) (wn (wss G S)) $;

--| Sufficient condition to prove that ` S ` is sigma-algebra. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem issalnnd {y1 e n: setvar} (ph: wff n) (S: class n) (V X: class y1 e n):
  $ wi ph (wcel S V) $ >
  $ wi ph (wcel c0 S) $ >
  $ wceq X (cuni S) $ >
  $ wi (wa ph (wcel (cv y1) S)) (wcel (cdif X (cv y1)) S) $ >
  $ wi (wa ph (wf cn S (cv e))) (wcel (ciun n cn (cfv (cv n) (cv e))) S) $ >
  $ wi ph (wcel S csalg) $;

--| Lebesgue measurable sets form a sigma-algebra. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem dmvolsal:
  $ wcel (cdm cvol) csalg $;

--| The complement of an element of a sigma-algebra is in the sigma-algebra. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem saldifcld (ph: wff) (S E: class):
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel E S) $ >
  $ wi ph (wcel (cdif (cuni S) E) S) $;

--| The union of two sets in a sigma-algebra is in the sigma-algebra. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem saluncld (ph: wff) (S E F: class):
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel E S) $ >
  $ wi ph (wcel F S) $ >
  $ wi ph (wcel (cun E F) S) $;

--| ` SalGen ` actually generates a sigma-algebra. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem salgencld (ph: wff) (S V X: class):
  $ wi ph (wcel X V) $ >
  $ wceq S (cfv X csalgen) $ >
  $ wi ph (wcel S csalg) $;

--| The empty set belongs to every sigma-algebra. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem _0sald (ph: wff) (S: class):
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel c0 S) $;

--| An open interval is a Borel set. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem iooborel (A2 B2 C J: class):
  $ wceq J (cfv (crn cioo) ctg) $ >
  $ wceq B2 (cfv J csalgen) $ >
  $ wcel (co A2 C cioo) B2 $;

--| The intersection of two sets in a sigma-algebra is in the sigma-algebra. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem salincld (ph: wff) (S E F: class):
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel E S) $ >
  $ wi ph (wcel F S) $ >
  $ wi ph (wcel (cin E F) S) $;

--| A set is an element of any sigma-algebra on it. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem salunid (ph: wff) (S: class):
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel (cuni S) S) $;

--| The union of a set belongs is equal to the union of the sigma-algebra generated by the set. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem unisalgen2 (ph: wff) (A2 S V: class):
  $ wi ph (wcel A2 V) $ >
  $ wceq S (cfv A2 csalgen) $ >
  $ wi ph (wceq (cuni S) (cuni A2)) $;

--| The Borel sigma-algebra on the Reals. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem bor1sal (B2 J: class):
  $ wceq J (cfv (crn cioo) ctg) $ >
  $ wceq B2 (cfv J csalgen) $ >
  $ wcel B2 csalg $;

--| A left-open, right-closed interval is a Borel set. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem iocborel (ph: wff) (A2 B2 C J: class):
  $ wi ph (wcel A2 cxr) $ >
  $ wi ph (wcel C cr) $ >
  $ wceq J (cfv (crn cioo) ctg) $ >
  $ wceq B2 (cfv J csalgen) $ >
  $ wi ph (wcel (co A2 C cioc) B2) $;

--| A subspace sigma-algebra is closed under countable union. This is Lemma 121A (iii) of [Fremlin1] p. 35. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem subsaliuncllem {x3 y1 e n: setvar} (ph: wff x3 y1 e) (D: class y1 n) (S: class) (E: class y1) (F: class y1 n) (G H: class x3 e n) (V: class x3 y1 e n):
  $ wnf y1 ph $ >
  $ wi ph (wcel S V) $ >
  $ wceq G (cmpt n cn (crab x3 (wceq (cfv (cv n) F) (cin (cv x3) D)) S)) $ >
  $ wceq E (ccom H G) $ >
  $ wi ph (wfn H (crn G)) $ >
  $ wi ph (wral y1 (wcel (cfv (cv y1) H) (cv y1)) (crn G)) $ >
  $ wi ph (wrex e (wral n (wceq (cfv (cv n) F) (cin (cfv (cv n) (cv e)) D)) cn) (co S cn cmap)) $;

--| A subspace sigma-algebra is closed under countable union. This is Lemma 121A (iii) of [Fremlin1] p. 35. The proof uses ~ fnrndomnum rather than ~ fnrndomg , and so does not require ~ ax-ac . (Contributed by Glauco Siliprandi, 26-Jun-2021.) (Revised by Vincent Gonzalez, 30-Aug-2026.)
theorem subsaliuncl {n: setvar} (ph: wff) (D S: class) (T: class n) (F: class) (V: class n):
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel D V) $ >
  $ wceq T (co S D crest) $ >
  $ wi ph (wf cn T F) $ >
  $ wi ph (wcel (ciun n cn (cfv (cv n) F)) T) $;

--| A subspace sigma-algebra is a sigma algebra. This is Lemma 121A of [Fremlin1] p. 35. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem subsalsal (ph: wff) (D S T V: class):
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel D V) $ >
  $ wceq T (co S D crest) $ >
  $ wi ph (wcel T csalg) $;

--| A set belongs to the subspace sigma-algebra it induces. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem subsaluni (ph: wff) (A2 S: class):
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wss A2 (cuni S)) $ >
  $ wi ph (wcel A2 (co S A2 crest)) $;

--| A sigma-algebra restricted to one of its elements is a subset of the original sigma-algebra. (Contributed by Glauco Siliprandi, 21-Dec-2024.)
theorem salrestss (ph: wff) (S E: class):
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel E S) $ >
  $ wi ph (wss (co S E crest) S) $;

--| Extend class notation to include the sum of nonnegative extended reals.
term csumge0: class;

--| Define the arbitrary sum of nonnegative extended reals. (Contributed by Glauco Siliprandi, 17-Aug-2020.) $.
axiom df_sumge0 {x3 y1 w: setvar}:
  $ wceq csumge0 (cmpt x3 cvv (cif (wcel cpnf (crn (cv x3))) cpnf (csup (crn (cmpt y1 (cin (cpw (cdm (cv x3))) cfn) (csu w (cv y1) (cfv (cv w) (cv x3))))) cxr clt))) $;

--| When ` sum^ ` is applied to nonnegative real numbers the range used in its definition is a subset of the reals. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0rnre {x3 y1: setvar} (ph: wff) (F: class x3 y1) (X: class):
  $ wi ph (wf X (co cc0 cpnf cico) F) $ >
  $ wi ph (wss (crn (cmpt x3 (cin (cpw X) cfn) (csu y1 (cv x3) (cfv (cv y1) F)))) cr) $;

--| If ` F ` maps to nonnegative reals, then ` F ` maps to nonnegative extended reals. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem fge0icoicc (ph: wff) (F X: class):
  $ wi ph (wf X (co cc0 cpnf cico) F) $ >
  $ wi ph (wf X (co cc0 cpnf cicc) F) $;

--| The value of the sum of nonnegative extended reals. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0val {y1 w: setvar} (F: class) (V: class y1 w) (X: class w):
  $ wi (wa (wcel X V) (wf X (co cc0 cpnf cicc) F)) (wceq (cfv F csumge0) (cif (wcel cpnf (crn F)) cpnf (csup (crn (cmpt y1 (cin (cpw X) cfn) (csu w (cv y1) (cfv (cv w) F)))) cxr clt))) $;

--| If ` F ` maps to nonnegative reals, then ` +oo ` is not in its range. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem fge0npnf (ph: wff) (F X: class):
  $ wi ph (wf X (co cc0 cpnf cico) F) $ >
  $ wi ph (wn (wcel cpnf (crn F))) $;

--| The range used in the definition of ` sum^ ` is not empty. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0rnn0 {x3 y1: setvar} (F X: class y1):
  $ wne (crn (cmpt x3 (cin (cpw X) cfn) (csu y1 (cv x3) (cfv (cv y1) F)))) c0 $;

--| The value of the sum of nonnegative extended reals. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0vald {x3 y1: setvar} (ph: wff x3 y1) (F: class) (V: class x3 y1) (X: class y1):
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X (co cc0 cpnf cicc) F) $ >
  $ wi ph (wceq (cfv F csumge0) (cif (wcel cpnf (crn F)) cpnf (csup (crn (cmpt x3 (cin (cpw X) cfn) (csu y1 (cv x3) (cfv (cv y1) F)))) cxr clt))) $;

--| A range of nonnegative extended reals without plus infinity. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem fge0iccico (ph: wff) (F X: class):
  $ wi ph (wf X (co cc0 cpnf cicc) F) $ >
  $ wi ph (wn (wcel cpnf (crn F))) $ >
  $ wi ph (wf X (co cc0 cpnf cico) F) $;

--| Closure of group sum, for finitely supported nonnegative extended reals. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem gsumge0cl (ph: wff) (F G V X: class):
  $ wceq G (co cxrs (co cc0 cpnf cicc) cress) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X (co cc0 cpnf cicc) F) $ >
  $ wi ph (wbr F cc0 cfsupp) $ >
  $ wi ph (wcel (co G F cgsu) (co cc0 cpnf cicc)) $;

--| Value of the sum of nonnegative extended reals, when all terms in the sum are reals. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0reval {x3 y1: setvar} (ph: wff x3 y1) (F: class) (V: class x3 y1) (X: class y1):
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X (co cc0 cpnf cico) F) $ >
  $ wi ph (wceq (cfv F csumge0) (csup (crn (cmpt x3 (cin (cpw X) cfn) (csu y1 (cv x3) (cfv (cv y1) F)))) cxr clt)) $;

--| If a term in the sum of nonnegative extended reals is ` +oo ` , then the value of the sum is ` +oo ` . (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0pnfval (ph: wff) (F V X: class):
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X (co cc0 cpnf cicc) F) $ >
  $ wi ph (wcel cpnf (crn F)) $ >
  $ wi ph (wceq (cfv F csumge0) cpnf) $;

--| A range of nonnegative extended reals without plus infinity. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem fge0iccre (ph: wff) (F X: class):
  $ wi ph (wf X (co cc0 cpnf cicc) F) $ >
  $ wi ph (wn (wcel cpnf (crn F))) $ >
  $ wi ph (wf X cr F) $;

--| Any nonnegative extended sum of zero is zero. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0z {k: setvar} (ph: wff k) (A2: class) (V: class k):
  $ wnf k ph $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wceq (cfv (cmpt k A2 cc0) csumge0) cc0) $;

--| The sum of nonnegative extended reals is zero when applied to the empty set. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge00:
  $ wceq (cfv c0 csumge0) cc0 $;

--| Every finite subsum of nonnegative reals is less than or equal to the extended sum over the whole (possibly infinite) domain. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem fsumlesge0 {x3: setvar} (ph: wff x3) (F: class) (V X: class x3) (Y: class):
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X (co cc0 cpnf cico) F) $ >
  $ wi ph (wss Y X) $ >
  $ wi ph (wcel Y cfn) $ >
  $ wi ph (wbr (csu x3 Y (cfv (cv x3) F)) (cfv F csumge0) cle) $;

--| Value of the sum of nonnegative extended reals, when all terms in the sum are reals. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0revalmpt {x3 y1: setvar} (ph: wff x3) (A2: class) (B2: class x3) (V: class x3 y1):
  $ wnf x3 ph $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 (co cc0 cpnf cico)) $ >
  $ wi ph (wceq (cfv (cmpt x3 A2 B2) csumge0) (csup (crn (cmpt y1 (cin (cpw A2) cfn) (csu x3 (cv y1) B2))) cxr clt)) $;

--| A sum of a nonnegative extended real is the term. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0sn (ph: wff) (A2 F V: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wf (csn A2) (co cc0 cpnf cicc) F) $ >
  $ wi ph (wceq (cfv F csumge0) (cfv A2 F)) $;

--| ` sum^ ` applied to a nonnegative function (its meaningful domain) is the same as the infinite group sum (that's always convergent, in this case). (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0tsms (ph: wff) (F G V X: class):
  $ wceq G (co cxrs (co cc0 cpnf cicc) cress) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X (co cc0 cpnf cicc) F) $ >
  $ wi ph (wcel (cfv F csumge0) (co G F ctsu)) $;

--| The arbitrary sum of nonnegative extended reals is a nonnegative extended real. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0cl (ph: wff) (F V X: class):
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X (co cc0 cpnf cicc) F) $ >
  $ wi ph (wcel (cfv F csumge0) (co cc0 cpnf cicc)) $;

--| Re-index a nonnegative extended sum using a bijection. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0f1o {k n: setvar} (ph: wff k n) (A2: class) (B2: class k) (C: class) (D: class n) (F: class) (G: class n) (V: class k n):
  $ wnf k ph $ >
  $ wnf n ph $ >
  $ wi (wceq (cv k) G) (wceq B2 D) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wf1o C A2 F) $ >
  $ wi (wa ph (wcel (cv n) C)) (wceq (cfv (cv n) F) G) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 (co cc0 cpnf cicc)) $ >
  $ wi ph (wceq (cfv (cmpt k A2 B2) csumge0) (cfv (cmpt n C D) csumge0)) $;

--| A sum of a nonnegative extended real is the term. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0snmpt {k: setvar} (ph: wff) (A2: class) (B2: class k) (C: class) (V: class k):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel C (co cc0 cpnf cicc)) $ >
  $ wi (wceq (cv k) A2) (wceq B2 C) $ >
  $ wi ph (wceq (cfv (cmpt k (csn A2) B2) csumge0) C) $;

--| The sum of nonnegative extended reals is nonnegative. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0ge0 (ph: wff) (F V X: class):
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X (co cc0 cpnf cicc) F) $ >
  $ wi ph (wbr cc0 (cfv F csumge0) cle) $;

--| The arbitrary sum of nonnegative extended reals is an extended real. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0xrcl (ph: wff) (F V X: class):
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X (co cc0 cpnf cicc) F) $ >
  $ wi ph (wcel (cfv F csumge0) cxr) $;

--| The of nonnegative extended reals is a real number if and only if it is not ` +oo ` . (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0repnf (ph: wff) (F V X: class):
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X (co cc0 cpnf cicc) F) $ >
  $ wi ph (wb (wcel (cfv F csumge0) cr) (wn (wceq (cfv F csumge0) cpnf))) $;

--| The arbitrary sum of a finite set of nonnegative extended real numbers is equal to the sum of those numbers, when none of them is ` +oo ` (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0fsum {x3: setvar} (ph: wff) (F X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wf X (co cc0 cpnf cico) F) $ >
  $ wi ph (wceq (cfv F csumge0) (csu x3 X (cfv (cv x3) F))) $;

--| If the sum of nonnegative extended reals is not ` +oo ` then no terms is ` +oo ` . (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0rern (ph: wff) (F V X: class):
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X (co cc0 cpnf cicc) F) $ >
  $ wi ph (wcel (cfv F csumge0) cr) $ >
  $ wi ph (wn (wcel cpnf (crn F))) $;

--| If the arbitrary sum of nonnegative extended reals is real, then it is the supremum (in the real numbers) of finite subsums. Similar to ~ sge0sup , but here we can use ` sup ` with respect to ` RR ` instead of ` RR* ` . (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0supre {x3 y1: setvar} (ph: wff) (F: class) (V: class x3 y1) (X: class):
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X (co cc0 cpnf cicc) F) $ >
  $ wi ph (wcel (cfv F csumge0) cr) $ >
  $ wi ph (wceq (cfv F csumge0) (csup (crn (cmpt x3 (cin (cpw X) cfn) (csu y1 (cv x3) (cfv (cv y1) F)))) cr clt)) $;

--| The arbitrary sum of a finite set of nonnegative extended real numbers is equal to the sum of those numbers, when none of them is ` +oo ` (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0fsummpt {k: setvar} (ph: wff) (A2: class) (B2: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 (co cc0 cpnf cico)) $ >
  $ wi ph (wceq (cfv (cmpt k A2 B2) csumge0) (csu k A2 B2)) $;

--| The arbitrary sum of nonnegative extended reals is the supremum of finite subsums. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0sup {x3: setvar} (ph: wff) (F: class) (V: class x3) (X: class):
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X (co cc0 cpnf cicc) F) $ >
  $ wi ph (wceq (cfv F csumge0) (csup (crn (cmpt x3 (cin (cpw X) cfn) (cfv (cres F (cv x3)) csumge0))) cxr clt)) $;

--| A shorter sum of nonnegative extended reals is smaller than a longer one. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0less (ph: wff) (F V X Y: class):
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X (co cc0 cpnf cicc) F) $ >
  $ wi ph (wbr (cfv (cres F Y) csumge0) (cfv F csumge0) cle) $;

--| The range used in the definition of ` sum^ ` is bounded, when the whole sum is a real number. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0rnbnd {x3 y1 z w: setvar} (ph: wff y1 z) (F: class) (V: class x3 y1 z w) (X: class x3 y1 w):
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X (co cc0 cpnf cicc) F) $ >
  $ wi ph (wcel (cfv F csumge0) cr) $ >
  $ wi ph (wrex z (wral w (wbr (cv w) (cv z) cle) (crn (cmpt x3 (cin (cpw X) cfn) (csu y1 (cv x3) (cfv (cv y1) F))))) cr) $;

--| Sum of a pair of nonnegative extended reals. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0pr {k: setvar} (ph: wff) (A2 B2: class) (C: class k) (D E V W: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel D (co cc0 cpnf cicc)) $ >
  $ wi ph (wcel E (co cc0 cpnf cicc)) $ >
  $ wi (wceq (cv k) A2) (wceq C D) $ >
  $ wi (wceq (cv k) B2) (wceq C E) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wceq (cfv (cmpt k (cpr A2 B2) C) csumge0) (co D E cxad)) $;

--| The arbitrary sum of nonnegative extended reals is greater than or equal to a given extended real number if this number can be approximated from below by finite subsums. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0gerp {x3 z: setvar} (ph: wff) (A2 F: class) (V: class x3 z) (X: class):
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X (co cc0 cpnf cicc) F) $ >
  $ wi ph (wcel A2 cxr) $ >
  $ wi (wa ph (wcel (cv x3) crp)) (wrex z (wbr A2 (co (cfv (cres F (cv z)) csumge0) (cv x3) cxad) cle) (cin (cpw X) cfn)) $ >
  $ wi ph (wbr A2 (cfv F csumge0) cle) $;

--| If the sum of nonnegative extended reals is ` +oo ` , then any real number can be dominated by finite subsums. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0pnffigt {x3: setvar} (ph: wff) (F: class) (V: class x3) (X Y: class):
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X (co cc0 cpnf cicc) F) $ >
  $ wi ph (wceq (cfv F csumge0) cpnf) $ >
  $ wi ph (wcel Y cr) $ >
  $ wi ph (wrex x3 (wbr Y (cfv (cres F (cv x3)) csumge0) clt) (cin (cpw X) cfn)) $;

--| If a sum of nonnegative extended reals is real, than any subsum is real. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0ssre (ph: wff) (F V X Y: class):
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X (co cc0 cpnf cicc) F) $ >
  $ wi ph (wcel (cfv F csumge0) cr) $ >
  $ wi ph (wcel (cfv (cres F Y) csumge0) cr) $;

--| A sum of nonnegative extended reals is smaller than a given extended real if and only if every finite subsum is smaller than it. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0lefi {x3: setvar} (ph: wff) (A2 F: class) (V: class x3) (X: class):
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X (co cc0 cpnf cicc) F) $ >
  $ wi ph (wcel A2 cxr) $ >
  $ wi ph (wb (wbr (cfv F csumge0) A2 cle) (wral x3 (wbr (cfv (cres F (cv x3)) csumge0) A2 cle) (cin (cpw X) cfn))) $;

--| A shorter sum of nonnegative extended reals is smaller than a longer one. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0lessmpt {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (C: class) (V: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 (co cc0 cpnf cicc)) $ >
  $ wi ph (wss C A2) $ >
  $ wi ph (wbr (cfv (cmpt x3 C B2) csumge0) (cfv (cmpt x3 A2 B2) csumge0) cle) $;

--| If the sum of nonnegative extended reals is real, then it can be approximated from below by finite subsums. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0ltfirp {x3: setvar} (ph: wff) (F: class) (V: class x3) (X Y: class):
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X (co cc0 cpnf cicc) F) $ >
  $ wi ph (wcel Y crp) $ >
  $ wi ph (wcel (cfv F csumge0) cr) $ >
  $ wi ph (wrex x3 (wbr (cfv F csumge0) (co (cfv (cres F (cv x3)) csumge0) Y caddc) clt) (cin (cpw X) cfn)) $;

--| The sum of a pair of nonnegative extended reals is less than or equal their extended addition. When it is a distinct pair, than equality holds, see ~ sge0pr . (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0prle {k: setvar} (ph: wff) (A2 B2: class) (C: class k) (D E V W: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel D (co cc0 cpnf cicc)) $ >
  $ wi ph (wcel E (co cc0 cpnf cicc)) $ >
  $ wi (wceq (cv k) A2) (wceq C D) $ >
  $ wi (wceq (cv k) B2) (wceq C E) $ >
  $ wi ph (wbr (cfv (cmpt k (cpr A2 B2) C) csumge0) (co D E cxad) cle) $;

--| The arbitrary sum of nonnegative extended reals is greater than or equal to a given extended real number if this number can be approximated from below by finite subsums. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0gerpmpt {x3 y1 z: setvar} (ph: wff x3) (A2: class) (B2 C: class x3) (V: class x3 y1 z):
  $ wnf x3 ph $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 (co cc0 cpnf cicc)) $ >
  $ wi ph (wcel C cxr) $ >
  $ wi (wa ph (wcel (cv y1) crp)) (wrex z (wbr C (co (cfv (cmpt x3 (cv z) B2) csumge0) (cv y1) cxad) cle) (cin (cpw A2) cfn)) $ >
  $ wi ph (wbr C (cfv (cmpt x3 A2 B2) csumge0) cle) $;

--| The sum of nonnegative extended reals restricted to the range of a function is less than or equal to the sum of the composition of the two functions. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0resrnlem (ph: wff) (A2 B2 F G V X: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wf B2 (co cc0 cpnf cicc) F) $ >
  $ wi ph (wf A2 B2 G) $ >
  $ wi ph (wcel X (cpw A2)) $ >
  $ wi ph (wf1o X (crn G) (cres G X)) $ >
  $ wi ph (wbr (cfv (cres F (crn G)) csumge0) (cfv (ccom F G) csumge0) cle) $;

--| The sum of nonnegative extended reals restricted to the range of a function is less than or equal to the sum of the composition of the two functions (well-order hypothesis allows to avoid using the axiom of choice). (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0resrn (ph: wff) (A2 B2 R F G V: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wf B2 (co cc0 cpnf cicc) F) $ >
  $ wi ph (wf A2 B2 G) $ >
  $ wi ph (wwe A2 R) $ >
  $ wi ph (wbr (cfv (cres F (crn G)) csumge0) (cfv (ccom F G) csumge0) cle) $;

--| If a sum of nonnegative extended reals is real, than any subsum is real. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0ssrempt {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3) (C: class) (V: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 (co cc0 cpnf cicc)) $ >
  $ wi ph (wcel (cfv (cmpt x3 A2 B2) csumge0) cr) $ >
  $ wi ph (wss C A2) $ >
  $ wi ph (wcel (cfv (cmpt x3 C B2) csumge0) cr) $;

--| ` sum^ ` splits into two parts, when it's a real number. This is a special case of ~ sge0split . (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0resplit (ph: wff) (A2 B2 U F V W: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wceq U (cun A2 B2) $ >
  $ wi ph (wceq (cin A2 B2) c0) $ >
  $ wi ph (wf U (co cc0 cpnf cicc) F) $ >
  $ wi ph (wcel (cfv F csumge0) cr) $ >
  $ wi ph (wceq (cfv F csumge0) (co (cfv (cres F A2) csumge0) (cfv (cres F B2) csumge0) caddc)) $;

--| If all of the terms of sums compare, so do the sums. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0le {x3: setvar} (ph: wff) (F G: class) (V: class x3) (X: class):
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X (co cc0 cpnf cicc) F) $ >
  $ wi ph (wf X (co cc0 cpnf cicc) G) $ >
  $ wi (wa ph (wcel (cv x3) X)) (wbr (cfv (cv x3) F) (cfv (cv x3) G) cle) $ >
  $ wi ph (wbr (cfv F csumge0) (cfv G csumge0) cle) $;

--| If the extended sum of nonnegative reals is not ` +oo ` , then it can be approximated from below by finite subsums. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0ltfirpmpt {x3 y1: setvar} (ph: wff x3) (A2: class) (B2: class x3) (V: class x3 y1) (Y: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 (co cc0 cpnf cicc)) $ >
  $ wi ph (wcel Y crp) $ >
  $ wi ph (wcel (cfv (cmpt x3 A2 B2) csumge0) cr) $ >
  $ wi ph (wrex y1 (wbr (cfv (cmpt x3 A2 B2) csumge0) (co (cfv (cmpt x3 (cv y1) B2) csumge0) Y caddc) clt) (cin (cpw A2) cfn)) $;

--| Split a sum of nonnegative extended reals into two parts. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0split (ph: wff) (A2 B2 U F V W: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wceq U (cun A2 B2) $ >
  $ wi ph (wceq (cin A2 B2) c0) $ >
  $ wi ph (wf U (co cc0 cpnf cicc) F) $ >
  $ wi ph (wceq (cfv F csumge0) (co (cfv (cres F A2) csumge0) (cfv (cres F B2) csumge0) cxad)) $;

--| If all of the terms of sums compare, so do the sums. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0lempt {x3: setvar} (ph: wff x3) (A2: class) (B2 C V: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 (co cc0 cpnf cicc)) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C (co cc0 cpnf cicc)) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wbr B2 C cle) $ >
  $ wi ph (wbr (cfv (cmpt x3 A2 B2) csumge0) (cfv (cmpt x3 A2 C) csumge0) cle) $;

--| Split a sum of nonnegative extended reals into two parts. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0splitmpt {x3: setvar} (ph: wff x3) (A2 B2: class) (C V W: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wceq (cin A2 B2) c0) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C (co cc0 cpnf cicc)) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wcel C (co cc0 cpnf cicc)) $ >
  $ wi ph (wceq (cfv (cmpt x3 (cun A2 B2) C) csumge0) (co (cfv (cmpt x3 A2 C) csumge0) (cfv (cmpt x3 B2 C) csumge0) cxad)) $;

--| Change the index set to a subset in a sum of nonnegative extended reals. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0ss {k: setvar} (ph: wff k) (A2 B2: class) (C V: class k):
  $ wnf k ph $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wss A2 B2) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel C (co cc0 cpnf cicc)) $ >
  $ wi (wa ph (wcel (cv k) (cdif B2 A2))) (wceq C cc0) $ >
  $ wi ph (wceq (cfv (cmpt k A2 C) csumge0) (cfv (cmpt k B2 C) csumge0)) $;

--| Sum of nonnegative extended reals over a disjoint indexed union (in this lemma, for a finite index set). (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0iunmptlemfi {x3 k: setvar} (ph: wff) (A2: class) (B2: class x3) (C: class k) (V: class x3 k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi ph (wdisj x3 A2 B2) $ >
  $ wi (w3a ph (wcel (cv x3) A2) (wcel (cv k) B2)) (wcel C (co cc0 cpnf cicc)) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel (cfv (cmpt k B2 C) csumge0) cr) $ >
  $ wi ph (wceq (cfv (cmpt k (ciun x3 A2 B2) C) csumge0) (cfv (cmpt x3 A2 (cfv (cmpt k B2 C) csumge0)) csumge0)) $;

--| The addition of the next term in a finite sum of nonnegative extended reals. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0p1 {k: setvar} (ph: wff) (A2: class k) (B2 M N: class):
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M (co N c1 caddc) cfz))) (wcel A2 (co cc0 cpnf cicc)) $ >
  $ wi (wceq (cv k) (co N c1 caddc)) (wceq A2 B2) $ >
  $ wi ph (wceq (cfv (cmpt k (co M (co N c1 caddc) cfz) A2) csumge0) (co (cfv (cmpt k (co M N cfz) A2) csumge0) B2 cxad)) $;

--| Sum of nonnegative extended reals over a disjoint indexed union. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0iunmptlemre {x3 k: setvar} (ph: wff) (A2: class) (B2: class x3) (C: class k) (V: class x3 k) (W: class k):
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 W) $ >
  $ wi ph (wdisj x3 A2 B2) $ >
  $ wi (w3a ph (wcel (cv x3) A2) (wcel (cv k) B2)) (wcel C (co cc0 cpnf cicc)) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel (cfv (cmpt k B2 C) csumge0) cr) $ >
  $ wi ph (wcel (cfv (cmpt k (ciun x3 A2 B2) C) csumge0) cxr) $ >
  $ wi ph (wcel (cfv (cmpt x3 A2 (cfv (cmpt k B2 C) csumge0)) csumge0) cxr) $ >
  $ wi ph (wf (ciun x3 A2 B2) (co cc0 cpnf cicc) (cmpt k (ciun x3 A2 B2) C)) $ >
  $ wi ph (wcel (ciun x3 A2 B2) cvv) $ >
  $ wi ph (wceq (cfv (cmpt k (ciun x3 A2 B2) C) csumge0) (cfv (cmpt x3 A2 (cfv (cmpt k B2 C) csumge0)) csumge0)) $;

--| Re-index a nonnegative extended sum using an onto function with disjoint range, when the empty set is assigned ` 0 ` in the sum (this is true, for example, both for measures and outer measures). (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0fodjrnlem {k n: setvar} (ph: wff k n) (A2: class) (B2: class k) (C: class) (D: class n) (F: class) (G: class n) (V: class k n) (Z: class):
  $ wnf k ph $ >
  $ wnf n ph $ >
  $ wi (wceq (cv k) G) (wceq B2 D) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wfo C A2 F) $ >
  $ wi ph (wdisj n C (cfv (cv n) F)) $ >
  $ wi (wa ph (wcel (cv n) C)) (wceq (cfv (cv n) F) G) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 (co cc0 cpnf cicc)) $ >
  $ wi (wa ph (wceq (cv k) c0)) (wceq B2 cc0) $ >
  $ wceq Z (cima (ccnv F) (csn c0)) $ >
  $ wi ph (wceq (cfv (cmpt k A2 B2) csumge0) (cfv (cmpt n C D) csumge0)) $;

--| Re-index a nonnegative extended sum using an onto function with disjoint range, when the empty set is assigned ` 0 ` in the sum (this is true, for example, both for measures and outer measures). (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0fodjrn {k n: setvar} (ph: wff k n) (A2: class) (B2: class k) (C: class) (D: class n) (F: class) (G: class n) (V: class k n):
  $ wnf k ph $ >
  $ wnf n ph $ >
  $ wi (wceq (cv k) G) (wceq B2 D) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wfo C A2 F) $ >
  $ wi ph (wdisj n C (cfv (cv n) F)) $ >
  $ wi (wa ph (wcel (cv n) C)) (wceq (cfv (cv n) F) G) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 (co cc0 cpnf cicc)) $ >
  $ wi (wa ph (wceq (cv k) c0)) (wceq B2 cc0) $ >
  $ wi ph (wceq (cfv (cmpt k A2 B2) csumge0) (cfv (cmpt n C D) csumge0)) $;

--| Sum of nonnegative extended reals over a disjoint indexed union. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0iunmpt {x3 k: setvar} (ph: wff) (A2: class) (B2: class x3) (C: class k) (V: class x3 k) (W: class k):
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 W) $ >
  $ wi ph (wdisj x3 A2 B2) $ >
  $ wi (w3a ph (wcel (cv x3) A2) (wcel (cv k) B2)) (wcel C (co cc0 cpnf cicc)) $ >
  $ wi ph (wceq (cfv (cmpt k (ciun x3 A2 B2) C) csumge0) (cfv (cmpt x3 A2 (cfv (cmpt k B2 C) csumge0)) csumge0)) $;

--| Sum of nonnegative extended reals over a disjoint indexed union. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0iun {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (F: class) (V: class x3) (W: class) (X: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 W) $ >
  $ wceq X (ciun x3 A2 B2) $ >
  $ wi ph (wf X (co cc0 cpnf cicc) F) $ >
  $ wi ph (wdisj x3 A2 B2) $ >
  $ wi ph (wceq (cfv F csumge0) (cfv (cmpt x3 A2 (cfv (cres F B2) csumge0)) csumge0)) $;

--| The generalized sum of nonnegative extended reals is not minus infinity. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem sge0nemnf (ph: wff) (A2 F V: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wf A2 (co cc0 cpnf cicc) F) $ >
  $ wi ph (wne (cfv F csumge0) cmnf) $;

--| The sum of an infinite number of a positive constant, is ` +oo ` (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem sge0rpcpnf {x3: setvar} (ph: wff) (A2 B2: class) (V: class x3):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wn (wcel A2 cfn)) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wceq (cfv (cmpt x3 A2 B2) csumge0) cpnf) $;

--| If the sum of nonnegative extended reals is not ` +oo ` then no term is ` +oo ` . (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem sge0rernmpt {x3: setvar} (ph: wff x3) (A2: class) (B2 V: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 (co cc0 cpnf cicc)) $ >
  $ wi ph (wcel (cfv (cmpt x3 A2 B2) csumge0) cr) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 (co cc0 cpnf cico)) $;

--| A sum of nonnegative extended reals is smaller than a given extended real if and only if every finite subsum is smaller than it. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem sge0lefimpt {x3 y1: setvar} (ph: wff x3) (A2: class) (B2 C: class x3) (V: class x3 y1):
  $ wnf x3 ph $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 (co cc0 cpnf cicc)) $ >
  $ wi ph (wcel C cxr) $ >
  $ wi ph (wb (wbr (cfv (cmpt x3 A2 B2) csumge0) C cle) (wral y1 (wbr (cfv (cmpt x3 (cv y1) B2) csumge0) C cle) (cin (cpw A2) cfn))) $;

--| Nonnegative integers are nonnegative reals. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem nn0ssge0:
  $ wss cn0 (co cc0 cpnf cico) $;

--| The generalized sum of nonnegative extended reals is a nonnegative extended real. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem sge0clmpt {x3: setvar} (ph: wff x3) (A2: class) (B2 V: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 (co cc0 cpnf cicc)) $ >
  $ wi ph (wcel (cfv (cmpt x3 A2 B2) csumge0) (co cc0 cpnf cicc)) $;

--| If the extended sum of nonnegative reals is not ` +oo ` , then it can be approximated from below by finite subsums. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0ltfirpmpt2 {x3 y1: setvar} (ph: wff x3) (A2: class) (B2: class x3) (V: class x3 y1) (Y: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 (co cc0 cpnf cicc)) $ >
  $ wi ph (wcel Y crp) $ >
  $ wi ph (wcel (cfv (cmpt x3 A2 B2) csumge0) cr) $ >
  $ wi ph (wrex y1 (wbr (cfv (cmpt x3 A2 B2) csumge0) (co (csu x3 (cv y1) B2) Y caddc) clt) (cin (cpw A2) cfn)) $;

--| If a series of nonnegative reals is convergent, then it agrees with the generalized sum of nonnegative extended reals. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem sge0isum (ph: wff) (B2 F G M Z: class):
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wf Z (co cc0 cpnf cico) F) $ >
  $ wceq G (cseq caddc F M) $ >
  $ wi ph (wbr G B2 cli) $ >
  $ wi ph (wceq (cfv F csumge0) B2) $;

--| The generalized sum of nonnegative extended reals is an extended real. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem sge0xrclmpt {x3: setvar} (ph: wff x3) (A2: class) (B2 V: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 (co cc0 cpnf cicc)) $ >
  $ wi ph (wcel (cfv (cmpt x3 A2 B2) csumge0) cxr) $;

--| Combine two generalized sums of nonnegative extended reals into a single generalized sum over the cartesian product. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem sge0xp {z j k: setvar} (ph: wff k) (A2 B2: class) (C: class j k) (D: class z) (V W: class z j k):
  $ wnf k ph $ >
  $ wi (wceq (cv z) (cop (cv j) (cv k))) (wceq D C) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi (w3a ph (wcel (cv j) A2) (wcel (cv k) B2)) (wcel C (co cc0 cpnf cicc)) $ >
  $ wi ph (wceq (cfv (cmpt j A2 (cfv (cmpt k B2 C) csumge0)) csumge0) (cfv (cmpt z (cxp A2 B2) D) csumge0)) $;

--| If a series of nonnegative reals is convergent, then it agrees with the generalized sum of nonnegative extended reals. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem sge0isummpt {k: setvar} (ph: wff k) (A2 B2 M: class k) (Z: class):
  $ wnf k ph $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel A2 (co cc0 cpnf cico)) $ >
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wbr (cseq caddc (cmpt k Z A2) M) B2 cli) $ >
  $ wi ph (wceq (cfv (cmpt k Z A2) csumge0) B2) $;

--| The value of the infinite geometric series ` 2 ^ -u 1 + 2 ^ -u 2 + ` ... , multiplied by a constant. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem sge0ad2en {n: setvar} (ph: wff) (A2: class):
  $ wi ph (wcel A2 (co cc0 cpnf cico)) $ >
  $ wi ph (wceq (cfv (cmpt n cn (co A2 (co c2 (cv n) cexp) cdiv)) csumge0) A2) $;

--| If a series of nonnegative reals is convergent, then it agrees with the generalized sum of nonnegative extended reals. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem sge0isummpt2 {k: setvar} (ph: wff k) (A2 B2 M: class k) (Z: class):
  $ wnf k ph $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel A2 (co cc0 cpnf cico)) $ >
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wbr (cseq caddc (cmpt k Z A2) M) B2 cli) $ >
  $ wi ph (wceq (cfv (cmpt k Z A2) csumge0) (csu k Z A2)) $;

--| The extended addition of two generalized sums of nonnegative extended reals. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem sge0xaddlem1 {x3 k: setvar} (ph: wff) (A2: class) (B2 C: class k) (U: class) (E V: class x3 k) (W: class):
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 (co cc0 cpnf cico)) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel C (co cc0 cpnf cico)) $ >
  $ wi ph (wcel E crp) $ >
  $ wi ph (wss U A2) $ >
  $ wi ph (wcel U cfn) $ >
  $ wi ph (wss W A2) $ >
  $ wi ph (wcel W cfn) $ >
  $ wi ph (wbr (cfv (cmpt k A2 B2) csumge0) (co (csu k U B2) (co E c2 cdiv) caddc) clt) $ >
  $ wi ph (wbr (cfv (cmpt k A2 C) csumge0) (co (csu k W C) (co E c2 cdiv) caddc) clt) $ >
  $ wi ph (wcel (csup (crn (cmpt x3 (cin (cpw A2) cfn) (csu k (cv x3) (co B2 C caddc)))) cxr clt) (co cc0 cpnf cicc)) $ >
  $ wi ph (wcel (cfv (cmpt k A2 B2) csumge0) cr) $ >
  $ wi ph (wcel (cfv (cmpt k A2 C) csumge0) cr) $ >
  $ wi ph (wbr (co (cfv (cmpt k A2 B2) csumge0) (cfv (cmpt k A2 C) csumge0) caddc) (co (csup (crn (cmpt x3 (cin (cpw A2) cfn) (csu k (cv x3) (co B2 C caddc)))) cxr clt) E cxad) cle) $;

--| The extended addition of two generalized sums of nonnegative extended reals. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem sge0xaddlem2 {k: setvar} (ph: wff) (A2: class) (B2 C V: class k):
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 (co cc0 cpnf cico)) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel C (co cc0 cpnf cico)) $ >
  $ wi ph (wcel (cfv (cmpt k A2 B2) csumge0) cr) $ >
  $ wi ph (wcel (cfv (cmpt k A2 C) csumge0) cr) $ >
  $ wi ph (wceq (cfv (cmpt k A2 (co B2 C cxad)) csumge0) (co (cfv (cmpt k A2 B2) csumge0) (cfv (cmpt k A2 C) csumge0) cxad)) $;

--| The extended addition of two generalized sums of nonnegative extended reals. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem sge0xadd {k: setvar} (ph: wff k) (A2: class) (B2 C V: class k):
  $ wnf k ph $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 (co cc0 cpnf cicc)) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel C (co cc0 cpnf cicc)) $ >
  $ wi ph (wceq (cfv (cmpt k A2 (co B2 C cxad)) csumge0) (co (cfv (cmpt k A2 B2) csumge0) (cfv (cmpt k A2 C) csumge0) cxad)) $;

--| The generalized sum of a finite set of nonnegative extended real numbers is equal to the sum of those numbers, when none of them is ` +oo ` (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem sge0fsummptf {k: setvar} (ph: wff k) (A2: class) (B2: class k):
  $ wnf k ph $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 (co cc0 cpnf cico)) $ >
  $ wi ph (wceq (cfv (cmpt k A2 B2) csumge0) (csu k A2 B2)) $;

--| A sum of a nonnegative extended real is the term. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem sge0snmptf {k: setvar} (ph: wff k) (A2: class) (B2: class k) (C: class) (V: class k):
  $ wnf k ph $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel C (co cc0 cpnf cicc)) $ >
  $ wi (wceq (cv k) A2) (wceq B2 C) $ >
  $ wi ph (wceq (cfv (cmpt k (csn A2) B2) csumge0) C) $;

--| The sum of nonnegative extended reals is nonnegative. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem sge0ge0mpt {k: setvar} (ph: wff k) (A2: class) (B2 V: class k):
  $ wnf k ph $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 (co cc0 cpnf cicc)) $ >
  $ wi ph (wbr cc0 (cfv (cmpt k A2 B2) csumge0) cle) $;

--| The of nonnegative extended reals is a real number if and only if it is not ` +oo ` . (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem sge0repnfmpt {k: setvar} (ph: wff k) (A2: class) (B2 V: class k):
  $ wnf k ph $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 (co cc0 cpnf cicc)) $ >
  $ wi ph (wb (wcel (cfv (cmpt k A2 B2) csumge0) cr) (wn (wceq (cfv (cmpt k A2 B2) csumge0) cpnf))) $;

--| If the generalized sum of nonnegative reals is ` +oo ` , then any real number can be dominated by finite subsums. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem sge0pnffigtmpt {x3 k: setvar} (ph: wff k) (A2: class) (B2: class k) (V: class x3 k) (Y: class k):
  $ wnf k ph $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 (co cc0 cpnf cicc)) $ >
  $ wi ph (wceq (cfv (cmpt k A2 B2) csumge0) cpnf) $ >
  $ wi ph (wcel Y cr) $ >
  $ wi ph (wrex x3 (wbr Y (cfv (cmpt k (cv x3) B2) csumge0) clt) (cin (cpw A2) cfn)) $;

--| Separate out a term in a generalized sum of nonnegative extended reals. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem sge0splitsn {k: setvar} (ph: wff k) (A2 B2: class) (C: class k) (D: class) (V W: class k):
  $ wnf k ph $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wn (wcel B2 A2)) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel C (co cc0 cpnf cicc)) $ >
  $ wi (wceq (cv k) B2) (wceq C D) $ >
  $ wi ph (wcel D (co cc0 cpnf cicc)) $ >
  $ wi ph (wceq (cfv (cmpt k (cun A2 (csn B2)) C) csumge0) (co (cfv (cmpt k A2 C) csumge0) D cxad)) $;

--| If the sum of nonnegative extended reals is ` +oo ` , then any real number can be dominated by finite subsums. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem sge0pnffsumgt {x3 k: setvar} (ph: wff k) (A2: class) (B2: class k) (V: class x3 k) (Y: class k):
  $ wnf k ph $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 (co cc0 cpnf cico)) $ >
  $ wi ph (wceq (cfv (cmpt k A2 B2) csumge0) cpnf) $ >
  $ wi ph (wcel Y cr) $ >
  $ wi ph (wrex x3 (wbr Y (csu k (cv x3) B2) clt) (cin (cpw A2) cfn)) $;

--| If the generalized sum of nonnegative reals is larger than a given number, then that number can be dominated by a finite subsum. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem sge0gtfsumgt {y1 k: setvar} (ph: wff k) (A2: class) (B2 C: class k) (V: class y1 k):
  $ wnf k ph $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 (co cc0 cpnf cico)) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wbr C (cfv (cmpt k A2 B2) csumge0) clt) $ >
  $ wi ph (wrex y1 (wbr C (csu k (cv y1) B2) clt) (cin (cpw A2) cfn)) $;

--| If a real number is smaller than a generalized sum of nonnegative reals, then it is smaller than some finite subsum. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem sge0uzfsumgt {k m: setvar} (ph: wff k) (B2 C: class k) (K Z: class):
  $ wnf k ph $ >
  $ wi ph (wcel K cz) $ >
  $ wceq Z (cfv K cuz) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel B2 (co cc0 cpnf cico)) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wbr C (cfv (cmpt k Z B2) csumge0) clt) $ >
  $ wi ph (wrex m (wbr C (csu k (co K (cv m) cfz) B2) clt) Z) $;

--| If a term in the sum of nonnegative extended reals is ` +oo ` , then the value of the sum is ` +oo ` . (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem sge0pnfmpt {k: setvar} (ph: wff k) (A2: class) (B2 V: class k):
  $ wnf k ph $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 (co cc0 cpnf cicc)) $ >
  $ wi ph (wrex k (wceq B2 cpnf) A2) $ >
  $ wi ph (wceq (cfv (cmpt k A2 B2) csumge0) cpnf) $;

--| A series of nonnegative reals agrees with the generalized sum of nonnegative reals. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem sge0seq (ph: wff) (F G M Z: class):
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wf Z (co cc0 cpnf cico) F) $ >
  $ wceq G (cseq caddc F M) $ >
  $ wi ph (wceq (cfv F csumge0) (csup (crn G) cxr clt)) $;

--| Value of the generalized sum of nonnegative reals, when the domain is a set of upper integers. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem sge0reuz {k n: setvar} (ph: wff k) (B2: class k) (M Z: class):
  $ wnf k ph $ >
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel B2 (co cc0 cpnf cico)) $ >
  $ wi ph (wceq (cfv (cmpt k Z B2) csumge0) (csup (crn (cmpt n Z (csu k (co M (cv n) cfz) B2))) cxr clt)) $;

--| Value of the generalized sum of uniformly bounded nonnegative reals, when the domain is a set of upper integers. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem sge0reuzb {x3 k n: setvar} (ph: wff x3 k) (B2: class k) (M Z: class):
  $ wnf k ph $ >
  $ wnf x3 ph $ >
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel B2 (co cc0 cpnf cico)) $ >
  $ wi ph (wrex x3 (wral n (wbr (csu k (co M (cv n) cfz) B2) (cv x3) cle) Z) cr) $ >
  $ wi ph (wceq (cfv (cmpt k Z B2) csumge0) (csup (crn (cmpt n Z (csu k (co M (cv n) cfz) B2))) cr clt)) $;

--| Extend class notation with the class of measures.
term cmea: class;

--| Define the class of measures. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
axiom df_mea {x3 y1 w: setvar}:
  $ wceq cmea (cab x3 (wa (wa (wa (wf (cdm (cv x3)) (co cc0 cpnf cicc) (cv x3)) (wcel (cdm (cv x3)) csalg)) (wceq (cfv c0 (cv x3)) cc0)) (wral y1 (wi (wa (wbr (cv y1) com cdom) (wdisj w (cv y1) (cv w))) (wceq (cfv (cuni (cv y1)) (cv x3)) (cfv (cres (cv x3) (cv y1)) csumge0))) (cpw (cdm (cv x3)))))) $;

--| Express the predicate " ` M ` is a measure." Definition 112A of [Fremlin1] p. 14. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem ismea {x3 y1: setvar} (M: class y1):
  $ wb (wcel M cmea) (wa (wa (wa (wf (cdm M) (co cc0 cpnf cicc) M) (wcel (cdm M) csalg)) (wceq (cfv c0 M) cc0)) (wral x3 (wi (wa (wbr (cv x3) com cdom) (wdisj y1 (cv x3) (cv y1))) (wceq (cfv (cuni (cv x3)) M) (cfv (cres M (cv x3)) csumge0))) (cpw (cdm M)))) $;

--| The domain of a measure is a sigma-algebra. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem dmmeasal (ph: wff) (S M: class):
  $ wi ph (wcel M cmea) $ >
  $ wceq S (cdm M) $ >
  $ wi ph (wcel S csalg) $;

--| A measure is a function that maps to nonnegative extended reals. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem meaf (ph: wff) (S M: class):
  $ wi ph (wcel M cmea) $ >
  $ wceq S (cdm M) $ >
  $ wi ph (wf S (co cc0 cpnf cicc) M) $;

--| The measure of the empty set is always 0 . (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem mea0 (ph: wff) (M: class):
  $ wi ph (wcel M cmea) $ >
  $ wi ph (wceq (cfv c0 M) cc0) $;

--| There exists a mapping from ` NN ` onto any (nonempty) countable set of disjoint sets, such that elements in the range of the map are disjoint. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem nnfoctbdjlem {y1 f2 n: setvar} (ph: wff f2) (A2: class f2) (F: class) (G: class f2) (X: class):
  $ wi ph (wss A2 cn) $ >
  $ wi ph (wf1o A2 X G) $ >
  $ wi ph (wdisj y1 X (cv y1)) $ >
  $ wceq F (cmpt n cn (cif (wo (wceq (cv n) c1) (wn (wcel (co (cv n) c1 cmin) A2))) c0 (cfv (co (cv n) c1 cmin) G))) $ >
  $ wi ph (wex f2 (wa (wfo cn (cun X (csn c0)) (cv f2)) (wdisj n cn (cfv (cv n) (cv f2))))) $;

--| There exists a mapping from ` NN ` onto any (nonempty) countable set of disjoint sets, such that elements in the range of the map are disjoint. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem nnfoctbdj {y1 f2 n: setvar} (ph: wff f2) (X: class):
  $ wi ph (wbr X com cdom) $ >
  $ wi ph (wne X c0) $ >
  $ wi ph (wdisj y1 X (cv y1)) $ >
  $ wi ph (wex f2 (wa (wfo cn (cun X (csn c0)) (cv f2)) (wdisj n cn (cfv (cv n) (cv f2))))) $;

--| The measure of the disjoint union of a countable set is the extended sum of the measures. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem meadjuni {x3: setvar} (ph: wff x3) (S M: class x3) (X: class):
  $ wi ph (wcel M cmea) $ >
  $ wceq S (cdm M) $ >
  $ wi ph (wss X S) $ >
  $ wi ph (wbr X com cdom) $ >
  $ wi ph (wdisj x3 X (cv x3)) $ >
  $ wi ph (wceq (cfv (cuni X) M) (cfv (cres M X) csumge0)) $;

--| The measure of a set is a nonnegative extended real. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem meacl (ph: wff) (A2 S M: class):
  $ wi ph (wcel M cmea) $ >
  $ wceq S (cdm M) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel (cfv A2 M) (co cc0 cpnf cicc)) $;

--| The sets in the sequence ` F ` are disjoint. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem iundjiunlem {i n: setvar} (ph: wff i n) (E: class) (F: class i n) (J K N: class) (Z: class i):
  $ wceq Z (cfv N cuz) $ >
  $ wceq F (cmpt n Z (cdif (cfv (cv n) E) (ciun i (co N (cv n) cfzo) (cfv (cv i) E)))) $ >
  $ wi ph (wcel J Z) $ >
  $ wi ph (wcel K Z) $ >
  $ wi ph (wbr J K clt) $ >
  $ wi ph (wceq (cin (cfv J F) (cfv K F)) c0) $;

--| Given a sequence ` E ` of sets, a sequence ` F ` of disjoint sets is built, such that the indexed union stays the same. As in the proof of Property 112C (d) of [Fremlin1] p. 16. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem iundjiun {i m n: setvar} (ph: wff n) (E: class) (F: class i n) (N: class) (V: class i m n) (Z: class i):
  $ wnf n ph $ >
  $ wceq Z (cfv N cuz) $ >
  $ wi ph (wf Z V E) $ >
  $ wceq F (cmpt n Z (cdif (cfv (cv n) E) (ciun i (co N (cv n) cfzo) (cfv (cv i) E)))) $ >
  $ wi ph (wa (wa (wral m (wceq (ciun n (co N (cv m) cfz) (cfv (cv n) F)) (ciun n (co N (cv m) cfz) (cfv (cv n) E))) Z) (wceq (ciun n Z (cfv (cv n) F)) (ciun n Z (cfv (cv n) E)))) (wdisj n Z (cfv (cv n) F))) $;

--| The measure of a set is an extended real. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem meaxrcl (ph: wff) (A2 S M: class):
  $ wi ph (wcel M cmea) $ >
  $ wceq S (cdm M) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel (cfv A2 M) cxr) $;

--| The measure of the union of two disjoint sets is the sum of the measures, Property 112C (a) of [Fremlin1] p. 15. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem meadjun (ph: wff) (A2 B2 S M: class):
  $ wi ph (wcel M cmea) $ >
  $ wceq S (cdm M) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wceq (cin A2 B2) c0) $ >
  $ wi ph (wceq (cfv (cun A2 B2) M) (co (cfv A2 M) (cfv B2 M) cxad)) $;

--| The measure of a set is greater than or equal to the measure of a subset, Property 112C (b) of [Fremlin1] p. 15. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem meassle (ph: wff) (A2 B2 S M: class):
  $ wi ph (wcel M cmea) $ >
  $ wceq S (cdm M) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wbr (cfv A2 M) (cfv B2 M) cle) $;

--| The measure of the union of two sets is less than or equal to the sum of the measures, Property 112C (c) of [Fremlin1] p. 15. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem meaunle (ph: wff) (A2 B2 S M: class):
  $ wi ph (wcel M cmea) $ >
  $ wceq S (cdm M) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wbr (cfv (cun A2 B2) M) (co (cfv A2 M) (cfv B2 M) cxad) cle) $;

--| The sum of nonnegative extended reals, restricted to the range of another function. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem meadjiunlem {i: setvar} (ph: wff) (S: class i) (G: class) (M V: class i) (X Y: class):
  $ wi ph (wcel M cmea) $ >
  $ wceq S (cdm M) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X S G) $ >
  $ wceq Y (crab i (wne (cfv (cv i) G) c0) X) $ >
  $ wi ph (wdisj i X (cfv (cv i) G)) $ >
  $ wi ph (wceq (cfv (cres M (crn G)) csumge0) (cfv (ccom M G) csumge0)) $;

--| The measure of the disjoint union of a countable set is the extended sum of the measures. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem meadjiun {k: setvar} (ph: wff k) (A2: class) (B2: class k) (S M: class):
  $ wnf k ph $ >
  $ wi ph (wcel M cmea) $ >
  $ wceq S (cdm M) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 S) $ >
  $ wi ph (wbr A2 com cdom) $ >
  $ wi ph (wdisj k A2 B2) $ >
  $ wi ph (wceq (cfv (ciun k A2 B2) M) (cfv (cmpt k A2 (cfv B2 M)) csumge0)) $;

--| Sufficient condition to prove that ` M ` is a measure. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem ismeannd {e n: setvar} (ph: wff) (S: class e n) (M: class):
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wf S (co cc0 cpnf cicc) M) $ >
  $ wi ph (wceq (cfv c0 M) cc0) $ >
  $ wi (w3a ph (wf cn S (cv e)) (wdisj n cn (cfv (cv n) (cv e)))) (wceq (cfv (ciun n cn (cfv (cv n) (cv e))) M) (cfv (cmpt n cn (cfv (cfv (cv n) (cv e)) M)) csumge0)) $ >
  $ wi ph (wcel M cmea) $;

--| The measure of the union of countable sets is less than or equal to the sum of the measures, Property 112C (d) of [Fremlin1] p. 16. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem meaiunlelem {i n: setvar} (ph: wff n) (S E: class) (F: class i n) (M: class i) (N: class) (Z: class i):
  $ wnf n ph $ >
  $ wi ph (wcel M cmea) $ >
  $ wceq S (cdm M) $ >
  $ wceq Z (cfv N cuz) $ >
  $ wi ph (wf Z S E) $ >
  $ wceq F (cmpt n Z (cdif (cfv (cv n) E) (ciun i (co N (cv n) cfzo) (cfv (cv i) E)))) $ >
  $ wi ph (wbr (cfv (ciun n Z (cfv (cv n) E)) M) (cfv (cmpt n Z (cfv (cfv (cv n) E) M)) csumge0) cle) $;

--| The measure of the union of countable sets is less than or equal to the sum of the measures, Property 112C (d) of [Fremlin1] p. 16. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem meaiunle {n: setvar} (ph: wff n) (S E M N Z: class):
  $ wnf n ph $ >
  $ wi ph (wcel M cmea) $ >
  $ wceq S (cdm M) $ >
  $ wceq Z (cfv N cuz) $ >
  $ wi ph (wf Z S E) $ >
  $ wi ph (wbr (cfv (ciun n Z (cfv (cv n) E)) M) (cfv (cmpt n Z (cfv (cfv (cv n) E) M)) csumge0) cle) $;

--| ` M ` applied to a disjoint union of subsets of its domain is the sum of ` M ` applied to such subset. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem psmeasurelem {x3 y1: setvar} (ph: wff) (H: class) (M: class x3) (V: class x3 y1) (X: class y1) (Y: class):
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X (co cc0 cpnf cicc) H) $ >
  $ wceq M (cmpt x3 (cpw X) (cfv (cres H (cv x3)) csumge0)) $ >
  $ wi ph (wf (cpw X) (co cc0 cpnf cicc) M) $ >
  $ wi ph (wss Y (cpw X)) $ >
  $ wi ph (wdisj y1 Y (cv y1)) $ >
  $ wi ph (wceq (cfv (cuni Y) M) (cfv (cres M Y) csumge0)) $;

--| Point supported measure, Remark 112B (d) of [Fremlin1] p. 15. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem psmeasure {x3: setvar} (ph: wff) (H: class) (M V: class x3) (X: class):
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X (co cc0 cpnf cicc) H) $ >
  $ wceq M (cmpt x3 (cpw X) (cfv (cres H (cv x3)) csumge0)) $ >
  $ wi ph (wcel M cmea) $;

--| The Lebesgue measure function is countably additive. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem voliunsge0lem {n: setvar} (ph: wff) (S: class n) (E: class) (G: class n):
  $ wceq S (cseq caddc G c1) $ >
  $ wceq G (cmpt n cn (cfv (cfv (cv n) E) cvol)) $ >
  $ wi ph (wf cn (cdm cvol) E) $ >
  $ wi ph (wdisj n cn (cfv (cv n) E)) $ >
  $ wi ph (wceq (cfv (ciun n cn (cfv (cv n) E)) cvol) (cfv (cmpt n cn (cfv (cfv (cv n) E) cvol)) csumge0)) $;

--| The Lebesgue measure function is countably additive. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem voliunsge0 {n: setvar} (ph: wff) (E: class):
  $ wi ph (wf cn (cdm cvol) E) $ >
  $ wi ph (wdisj n cn (cfv (cv n) E)) $ >
  $ wi ph (wceq (cfv (ciun n cn (cfv (cv n) E)) cvol) (cfv (cmpt n cn (cfv (cfv (cv n) E) cvol)) csumge0)) $;

--| The Lebesgue measure on the Reals is actually a measure. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem volmea (ph: wff):
  $ wi ph (wcel cvol cmea) $;

--| If the measure of a measurable set is greater than or equal to ` 0 ` . (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem meage0 (ph: wff) (A2 M: class):
  $ wi ph (wcel M cmea) $ >
  $ wi ph (wcel A2 (cdm M)) $ >
  $ wi ph (wbr cc0 (cfv A2 M) cle) $;

--| The measure of the union of two disjoint sets, with finite measure, is the sum of the measures, Property 112C (a) of [Fremlin1] p. 15. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem meadjunre (ph: wff) (A2 B2 S M: class):
  $ wi ph (wcel M cmea) $ >
  $ wceq S (cdm M) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wceq (cin A2 B2) c0) $ >
  $ wi ph (wcel (cfv A2 M) cr) $ >
  $ wi ph (wcel (cfv B2 M) cr) $ >
  $ wi ph (wceq (cfv (cun A2 B2) M) (co (cfv A2 M) (cfv B2 M) caddc)) $;

--| If the measure of a measurable set is real, then the measure of any of its measurable subsets is real. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem meassre (ph: wff) (A2 B2 M: class):
  $ wi ph (wcel M cmea) $ >
  $ wi ph (wcel A2 (cdm M)) $ >
  $ wi ph (wcel (cfv A2 M) cr) $ >
  $ wi ph (wss B2 A2) $ >
  $ wi ph (wcel B2 (cdm M)) $ >
  $ wi ph (wcel (cfv B2 M) cr) $;

--| A measure that is less than or equal to ` 0 ` is ` 0 ` . (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem meale0eq0 (ph: wff) (A2 M: class):
  $ wi ph (wcel M cmea) $ >
  $ wi ph (wcel A2 (cdm M)) $ >
  $ wi ph (wbr (cfv A2 M) cc0 cle) $ >
  $ wi ph (wceq (cfv A2 M) cc0) $;

--| The measure of the difference of two sets. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem meadif (ph: wff) (A2 B2 M: class):
  $ wi ph (wcel M cmea) $ >
  $ wi ph (wcel A2 (cdm M)) $ >
  $ wi ph (wcel (cfv A2 M) cr) $ >
  $ wi ph (wcel B2 (cdm M)) $ >
  $ wi ph (wss B2 A2) $ >
  $ wi ph (wceq (cfv (cdif A2 B2) M) (co (cfv A2 M) (cfv B2 M) cmin)) $;

--| Measures are continuous from below (bounded case): if ` E ` is a sequence of increasing measurable sets (with uniformly bounded measure) then the measure of the union is the union of the measure. This is Proposition 112C (e) of [Fremlin1] p. 16. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem meaiuninclem {x3 i n: setvar} (ph: wff) (S: class i) (E F M N Z: class):
  $ wi ph (wcel M cmea) $ >
  $ wi ph (wcel N cz) $ >
  $ wceq Z (cfv N cuz) $ >
  $ wi ph (wf Z (cdm M) E) $ >
  $ wi (wa ph (wcel (cv n) Z)) (wss (cfv (cv n) E) (cfv (co (cv n) c1 caddc) E)) $ >
  $ wi ph (wrex x3 (wral n (wbr (cfv (cfv (cv n) E) M) (cv x3) cle) Z) cr) $ >
  $ wceq S (cmpt n Z (cfv (cfv (cv n) E) M)) $ >
  $ wceq F (cmpt n Z (cdif (cfv (cv n) E) (ciun i (co N (cv n) cfzo) (cfv (cv i) E)))) $ >
  $ wi ph (wbr S (cfv (ciun n Z (cfv (cv n) E)) M) cli) $;

--| Measures are continuous from below (bounded case): if ` E ` is a sequence of nondecreasing measurable sets (with bounded measure) then the measure of the union is the limit of the measures. This is Proposition 112C (e) of [Fremlin1] p. 16. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem meaiuninc {x3 n: setvar} (ph: wff) (S: class x3 n) (E M N Z: class):
  $ wi ph (wcel M cmea) $ >
  $ wi ph (wcel N cz) $ >
  $ wceq Z (cfv N cuz) $ >
  $ wi ph (wf Z (cdm M) E) $ >
  $ wi (wa ph (wcel (cv n) Z)) (wss (cfv (cv n) E) (cfv (co (cv n) c1 caddc) E)) $ >
  $ wi ph (wrex x3 (wral n (wbr (cfv (cfv (cv n) E) M) (cv x3) cle) Z) cr) $ >
  $ wceq S (cmpt n Z (cfv (cfv (cv n) E) M)) $ >
  $ wi ph (wbr S (cfv (ciun n Z (cfv (cv n) E)) M) cli) $;

--| Measures are continuous from below (bounded case): if ` E ` is a sequence of nondecreasing measurable sets (with bounded measure) then the measure of the union is the limit of the measures. This is Proposition 112C (e) of [Fremlin1] p. 16. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem meaiuninc2 {n: setvar} (ph: wff) (B2: class) (S: class n) (E M N Z: class):
  $ wi ph (wcel M cmea) $ >
  $ wi ph (wcel N cz) $ >
  $ wceq Z (cfv N cuz) $ >
  $ wi ph (wf Z (cdm M) E) $ >
  $ wi (wa ph (wcel (cv n) Z)) (wss (cfv (cv n) E) (cfv (co (cv n) c1 caddc) E)) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi (wa ph (wcel (cv n) Z)) (wbr (cfv (cfv (cv n) E) M) B2 cle) $ >
  $ wceq S (cmpt n Z (cfv (cfv (cv n) E) M)) $ >
  $ wi ph (wbr S (cfv (ciun n Z (cfv (cv n) E)) M) cli) $;

--| Measures are continuous from below (bounded case): if ` E ` is a sequence of nondecreasing measurable sets (with bounded measure) then the measure of the union is the limit of the measures. This is Proposition 112C (e) of [Fremlin1] p. 16. (Contributed by Glauco Siliprandi, 13-Feb-2022.)
theorem meaiunincf {x3 n: setvar} (ph: wff x3 n) (S: class x3 n) (E: class n) (M: class) (N: class x3 n) (Z: class):
  $ wnf n ph $ >
  $ wnfc n E $ >
  $ wi ph (wcel M cmea) $ >
  $ wi ph (wcel N cz) $ >
  $ wceq Z (cfv N cuz) $ >
  $ wi ph (wf Z (cdm M) E) $ >
  $ wi (wa ph (wcel (cv n) Z)) (wss (cfv (cv n) E) (cfv (co (cv n) c1 caddc) E)) $ >
  $ wi ph (wrex x3 (wral n (wbr (cfv (cfv (cv n) E) M) (cv x3) cle) Z) cr) $ >
  $ wceq S (cmpt n Z (cfv (cfv (cv n) E) M)) $ >
  $ wi ph (wbr S (cfv (ciun n Z (cfv (cv n) E)) M) cli) $;

--| Measures are continuous from below: if ` E ` is a sequence of nondecreasing measurable sets (with bounded measure) then the measure of the union is the limit of the measures. This is the general case of Proposition 112C (e) of [Fremlin1] p. 16 . This theorem generalizes ~ meaiuninc and ~ meaiuninc2 where the sequence is required to be bounded. (Contributed by Glauco Siliprandi, 13-Feb-2022.)
theorem meaiuninc3v {n: setvar} (ph: wff) (S: class n) (E M: class) (N: class n) (Z: class):
  $ wi ph (wcel M cmea) $ >
  $ wi ph (wcel N cz) $ >
  $ wceq Z (cfv N cuz) $ >
  $ wi ph (wf Z (cdm M) E) $ >
  $ wi (wa ph (wcel (cv n) Z)) (wss (cfv (cv n) E) (cfv (co (cv n) c1 caddc) E)) $ >
  $ wceq S (cmpt n Z (cfv (cfv (cv n) E) M)) $ >
  $ wi ph (wbr S (cfv (ciun n Z (cfv (cv n) E)) M) clsxlim) $;

--| Measures are continuous from below: if ` E ` is a sequence of nondecreasing measurable sets (with bounded measure) then the measure of the union is the limit of the measures. This is the general case of Proposition 112C (e) of [Fremlin1] p. 16 . This theorem generalizes ~ meaiuninc and ~ meaiuninc2 where the sequence is required to be bounded. (Contributed by Glauco Siliprandi, 13-Feb-2022.)
theorem meaiuninc3 {n: setvar} (ph: wff n) (S E: class n) (M: class) (N: class n) (Z: class):
  $ wnf n ph $ >
  $ wnfc n E $ >
  $ wi ph (wcel M cmea) $ >
  $ wi ph (wcel N cz) $ >
  $ wceq Z (cfv N cuz) $ >
  $ wi ph (wf Z (cdm M) E) $ >
  $ wi (wa ph (wcel (cv n) Z)) (wss (cfv (cv n) E) (cfv (co (cv n) c1 caddc) E)) $ >
  $ wceq S (cmpt n Z (cfv (cfv (cv n) E) M)) $ >
  $ wi ph (wbr S (cfv (ciun n Z (cfv (cv n) E)) M) clsxlim) $;

--| Measures are continuous from above: if ` E ` is a nonincreasing sequence of measurable sets, and any of the sets has finite measure, then the measure of the intersection is the limit of the measures. This is Proposition 112C (f) of [Fremlin1] p. 16. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem meaiininclem {n: setvar} (ph: wff) (S: class n) (E F G K M N Z: class):
  $ wi ph (wcel M cmea) $ >
  $ wi ph (wcel N cz) $ >
  $ wceq Z (cfv N cuz) $ >
  $ wi ph (wf Z (cdm M) E) $ >
  $ wi (wa ph (wcel (cv n) Z)) (wss (cfv (co (cv n) c1 caddc) E) (cfv (cv n) E)) $ >
  $ wi ph (wcel K (cfv N cuz)) $ >
  $ wi ph (wcel (cfv (cfv K E) M) cr) $ >
  $ wceq S (cmpt n Z (cfv (cfv (cv n) E) M)) $ >
  $ wceq G (cmpt n Z (cdif (cfv K E) (cfv (cv n) E))) $ >
  $ wceq F (ciun n Z (cfv (cv n) G)) $ >
  $ wi ph (wbr S (cfv (ciin n Z (cfv (cv n) E)) M) cli) $;

--| Measures are continuous from above: if ` E ` is a nonincreasing sequence of measurable sets, and any of the sets has finite measure, then the measure of the intersection is the limit of the measures. This is Proposition 112C (f) of [Fremlin1] p. 16. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem meaiininc {n: setvar} (ph: wff n) (S: class n) (E K M: class) (N: class n) (Z: class):
  $ wnf n ph $ >
  $ wi ph (wcel M cmea) $ >
  $ wi ph (wcel N cz) $ >
  $ wceq Z (cfv N cuz) $ >
  $ wi ph (wf Z (cdm M) E) $ >
  $ wi (wa ph (wcel (cv n) Z)) (wss (cfv (co (cv n) c1 caddc) E) (cfv (cv n) E)) $ >
  $ wi ph (wcel K (cfv N cuz)) $ >
  $ wi ph (wcel (cfv (cfv K E) M) cr) $ >
  $ wceq S (cmpt n Z (cfv (cfv (cv n) E) M)) $ >
  $ wi ph (wbr S (cfv (ciin n Z (cfv (cv n) E)) M) cli) $;

--| Measures are continuous from above: if ` E ` is a nonincreasing sequence of measurable sets, and any of the sets has finite measure, then the measure of the intersection is the limit of the measures. This is Proposition 112C (f) of [Fremlin1] p. 16. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem meaiininc2 {k n: setvar} (ph: wff k n) (S: class n) (E M: class) (N: class k n) (Z: class):
  $ wnf n ph $ >
  $ wnf k ph $ >
  $ wi ph (wcel M cmea) $ >
  $ wi ph (wcel N cz) $ >
  $ wceq Z (cfv N cuz) $ >
  $ wi ph (wf Z (cdm M) E) $ >
  $ wi (wa ph (wcel (cv n) Z)) (wss (cfv (co (cv n) c1 caddc) E) (cfv (cv n) E)) $ >
  $ wi ph (wrex k (wcel (cfv (cfv (cv k) E) M) cr) Z) $ >
  $ wceq S (cmpt n Z (cfv (cfv (cv n) E) M)) $ >
  $ wi ph (wbr S (cfv (ciin n Z (cfv (cv n) E)) M) cli) $;

--| Extend class notation with the class of outer measures.
term come: class;

--| Define the class of outer measures. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
axiom df_ome {x3 y1 z: setvar}:
  $ wceq come (cab x3 (wa (wa (wa (wa (wf (cdm (cv x3)) (co cc0 cpnf cicc) (cv x3)) (wceq (cdm (cv x3)) (cpw (cuni (cdm (cv x3)))))) (wceq (cfv c0 (cv x3)) cc0)) (wral y1 (wral z (wbr (cfv (cv z) (cv x3)) (cfv (cv y1) (cv x3)) cle) (cpw (cv y1))) (cpw (cuni (cdm (cv x3)))))) (wral y1 (wi (wbr (cv y1) com cdom) (wbr (cfv (cuni (cv y1)) (cv x3)) (cfv (cres (cv x3) (cv y1)) csumge0) cle)) (cpw (cdm (cv x3)))))) $;

--| Extend class notation with a function that takes an outer measure and generates a sigma-algebra and a measure.
term ccaragen: class;

--| Define the sigma-algebra generated by an outer measure. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
axiom df_caragen {e o a: setvar}:
  $ wceq ccaragen (cmpt o come (crab e (wral a (wceq (co (cfv (cin (cv a) (cv e)) (cv o)) (cfv (cdif (cv a) (cv e)) (cv o)) cxad) (cfv (cv a) (cv o))) (cpw (cuni (cdm (cv o))))) (cpw (cuni (cdm (cv o)))))) $;

--| The sigma-algebra generated by an outer measure. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem caragenval {e a: setvar} (O: class):
  $ wi (wcel O come) (wceq (cfv O ccaragen) (crab e (wral a (wceq (co (cfv (cin (cv a) (cv e)) O) (cfv (cdif (cv a) (cv e)) O) cxad) (cfv (cv a) O)) (cpw (cuni (cdm O)))) (cpw (cuni (cdm O))))) $;

--| Express the predicate " ` O ` is an outer measure." Definition 113A of [Fremlin1] p. 19. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem isome {y1 z: setvar} (O: class) (V: class y1 z):
  $ wi (wcel O V) (wb (wcel O come) (wa (wa (wa (wa (wf (cdm O) (co cc0 cpnf cicc) O) (wceq (cdm O) (cpw (cuni (cdm O))))) (wceq (cfv c0 O) cc0)) (wral y1 (wral z (wbr (cfv (cv z) O) (cfv (cv y1) O) cle) (cpw (cv y1))) (cpw (cuni (cdm O))))) (wral y1 (wi (wbr (cv y1) com cdom) (wbr (cfv (cuni (cv y1)) O) (cfv (cres O (cv y1)) csumge0) cle)) (cpw (cdm O))))) $;

--| Membership in the Caratheodory's construction. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem caragenel {a: setvar} (ph: wff a) (S: class a) (E O: class):
  $ wi ph (wcel O come) $ >
  $ wceq S (cfv O ccaragen) $ >
  $ wi ph (wb (wcel E S) (wa (wcel E (cpw (cuni (cdm O)))) (wral a (wceq (co (cfv (cin (cv a) E) O) (cfv (cdif (cv a) E) O) cxad) (cfv (cv a) O)) (cpw (cuni (cdm O)))))) $;

--| An outer measure is a function that maps to nonnegative extended reals. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem omef (ph: wff) (O X: class):
  $ wi ph (wcel O come) $ >
  $ wceq X (cuni (cdm O)) $ >
  $ wi ph (wf (cpw X) (co cc0 cpnf cicc) O) $;

--| The outer measure of the empty set is 0 . (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem ome0 (ph: wff) (O: class):
  $ wi ph (wcel O come) $ >
  $ wi ph (wceq (cfv c0 O) cc0) $;

--| The outer measure of a set is greater than or equal to the measure of a subset, Definition 113A (ii) of [Fremlin1] p. 19. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem omessle (ph: wff) (A2 B2 O X: class):
  $ wi ph (wcel O come) $ >
  $ wceq X (cuni (cdm O)) $ >
  $ wi ph (wss B2 X) $ >
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wbr (cfv A2 O) (cfv B2 O) cle) $;

--| The domain of an outer measure is a power set. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem omedm (O: class):
  $ wi (wcel O come) (wceq (cdm O) (cpw (cuni (cdm O)))) $;

--| If ` E ` is in the set generated by the Caratheodory's method, then it splits any set ` A ` in two parts such that the sum of the outer measures of the two parts is equal to the outer measure of the whole set ` A ` . (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem caragensplit (ph: wff) (A2 S E O X: class):
  $ wi ph (wcel O come) $ >
  $ wceq S (cfv O ccaragen) $ >
  $ wceq X (cuni (cdm O)) $ >
  $ wi ph (wcel E S) $ >
  $ wi ph (wss A2 X) $ >
  $ wi ph (wceq (co (cfv (cin A2 E) O) (cfv (cdif A2 E) O) cxad) (cfv A2 O)) $;

--| An element of the Caratheodory's construction is a subset of the base set of the outer measure. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem caragenelss (ph: wff) (A2 S O X: class):
  $ wi ph (wcel O come) $ >
  $ wceq S (cfv O ccaragen) $ >
  $ wi ph (wcel A2 S) $ >
  $ wceq X (cuni (cdm O)) $ >
  $ wi ph (wss A2 X) $;

--| Membership in the Caratheodory's construction. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem carageneld {a: setvar} (ph: wff) (S: class a) (E O: class) (X: class a):
  $ wi ph (wcel O come) $ >
  $ wceq X (cuni (cdm O)) $ >
  $ wceq S (cfv O ccaragen) $ >
  $ wi ph (wcel E (cpw X)) $ >
  $ wi (wa ph (wcel (cv a) (cpw X))) (wceq (co (cfv (cin (cv a) E) O) (cfv (cdif (cv a) E) O) cxad) (cfv (cv a) O)) $ >
  $ wi ph (wcel E S) $;

--| The outer measure of a set is a nonnegative extended real. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem omecl (ph: wff) (A2 O X: class):
  $ wi ph (wcel O come) $ >
  $ wceq X (cuni (cdm O)) $ >
  $ wi ph (wss A2 X) $ >
  $ wi ph (wcel (cfv A2 O) (co cc0 cpnf cicc)) $;

--| The sigma-algebra generated from an outer measure, by the Caratheodory's construction, is a subset of the domain of the outer measure. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem caragenss (S O: class):
  $ wceq S (cfv O ccaragen) $ >
  $ wi (wcel O come) (wss S (cdm O)) $;

--| The outer measure of the union of a countable set is the less than or equal to the extended sum of the outer measures. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem omeunile (ph: wff) (O X Y: class):
  $ wi ph (wcel O come) $ >
  $ wceq X (cuni (cdm O)) $ >
  $ wi ph (wss Y (cpw X)) $ >
  $ wi ph (wbr Y com cdom) $ >
  $ wi ph (wbr (cfv (cuni Y) O) (cfv (cres O Y) csumge0) cle) $;

--| The empty set belongs to any Caratheodory's construction. First part of Step (b) in the proof of Theorem 113C of [Fremlin1] p. 19. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem caragen0 (ph: wff) (S O: class):
  $ wi ph (wcel O come) $ >
  $ wceq S (cfv O ccaragen) $ >
  $ wi ph (wcel c0 S) $;

--| The outer measure of a set is an extended real. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem omexrcl (ph: wff) (A2 O X: class):
  $ wi ph (wcel O come) $ >
  $ wceq X (cuni (cdm O)) $ >
  $ wi ph (wss A2 X) $ >
  $ wi ph (wcel (cfv A2 O) cxr) $;

--| The base set of an outer measure belongs to the sigma-algebra generated by the Caratheodory's construction. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem caragenunidm (ph: wff) (S O X: class):
  $ wi ph (wcel O come) $ >
  $ wceq X (cuni (cdm O)) $ >
  $ wceq S (cfv O ccaragen) $ >
  $ wi ph (wcel X S) $;

--| The sigma-algebra generated from an outer measure, by the Caratheodory's construction, is a subset of the power set of the base set of the outer measure. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem caragensspw (ph: wff) (S O X: class):
  $ wi ph (wcel O come) $ >
  $ wceq X (cuni (cdm O)) $ >
  $ wceq S (cfv O ccaragen) $ >
  $ wi ph (wss S (cpw X)) $;

--| If the outer measure of a set is real, then the outer measure of any of its subset is real. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem omessre (ph: wff) (A2 B2 O X: class):
  $ wi ph (wcel O come) $ >
  $ wceq X (cuni (cdm O)) $ >
  $ wi ph (wss A2 X) $ >
  $ wi ph (wcel (cfv A2 O) cr) $ >
  $ wi ph (wss B2 A2) $ >
  $ wi ph (wcel (cfv B2 O) cr) $;

--| The base set of the sigma-algebra generated by the Caratheodory's construction is the whole base set of the original outer measure. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem caragenuni (ph: wff) (S O: class):
  $ wi ph (wcel O come) $ >
  $ wceq S (cfv O ccaragen) $ >
  $ wi ph (wceq (cuni S) (cuni (cdm O))) $;

--| The Caratheodory's construction is closed under the union. Step (c) in the proof of Theorem 113C of [Fremlin1] p. 20. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem caragenuncllem (ph: wff) (A2 S E F O X: class):
  $ wi ph (wcel O come) $ >
  $ wceq S (cfv O ccaragen) $ >
  $ wi ph (wcel E S) $ >
  $ wi ph (wcel F S) $ >
  $ wceq X (cuni (cdm O)) $ >
  $ wi ph (wss A2 X) $ >
  $ wi ph (wceq (co (cfv (cin A2 (cun E F)) O) (cfv (cdif A2 (cun E F)) O) cxad) (cfv A2 O)) $;

--| The Caratheodory's construction is closed under the union. Step (c) in the proof of Theorem 113C of [Fremlin1] p. 20. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem caragenuncl (ph: wff) (S E F O: class):
  $ wi ph (wcel O come) $ >
  $ wceq S (cfv O ccaragen) $ >
  $ wi ph (wcel E S) $ >
  $ wi ph (wcel F S) $ >
  $ wi ph (wcel (cun E F) S) $;

--| The Caratheodory's construction is closed under the complement operation. Second part of Step (b) in the proof of Theorem 113C of [Fremlin1] p. 19. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem caragendifcl (ph: wff) (S E O: class):
  $ wi ph (wcel O come) $ >
  $ wceq S (cfv O ccaragen) $ >
  $ wi ph (wcel E S) $ >
  $ wi ph (wcel (cdif (cuni S) E) S) $;

--| The Caratheodory's construction is closed under finite indexed union. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem caragenfiiuncl {k: setvar} (ph: wff k) (A2: class) (B2: class k) (S: class) (O: class k):
  $ wnf k ph $ >
  $ wi ph (wcel O come) $ >
  $ wceq S (cfv O ccaragen) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 S) $ >
  $ wi ph (wcel (ciun k A2 B2) S) $;

--| The outer measure of the union of two sets is less than or equal to the sum of the measures, Remark 113B (c) of [Fremlin1] p. 19. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem omeunle (ph: wff) (A2 B2 O X: class):
  $ wi ph (wcel O come) $ >
  $ wceq X (cuni (cdm O)) $ >
  $ wi ph (wss A2 X) $ >
  $ wi ph (wss B2 X) $ >
  $ wi ph (wbr (cfv (cun A2 B2) O) (co (cfv A2 O) (cfv B2 O) cxad) cle) $;

--| The outer measure of the indexed union of a countable set is less than or equal to the extended sum of the outer measures. The proof uses ~ abrexct rather than ~ fnrndomg , and so does not require ~ ax-ac . (Contributed by Glauco Siliprandi, 17-Aug-2020.) (Revised by Vincent Gonzalez, 19-Aug-2026.)
theorem omeiunle {n: setvar} (ph: wff n) (E N: class n) (O X Z: class):
  $ wnf n ph $ >
  $ wnfc n E $ >
  $ wi ph (wcel O come) $ >
  $ wceq X (cuni (cdm O)) $ >
  $ wceq Z (cfv N cuz) $ >
  $ wi ph (wf Z (cpw X) E) $ >
  $ wi ph (wbr (cfv (ciun n Z (cfv (cv n) E)) O) (cfv (cmpt n Z (cfv (cfv (cv n) E) O)) csumge0) cle) $;

--| The outer measure of a set ` A ` is less than or equal to the extended addition of the outer measures of the decomposition induced on ` A ` by any ` E ` . Step (a) in the proof of Caratheodory's Method, Theorem 113C of [Fremlin1] p. 19. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem omelesplit (ph: wff) (A2 E O X: class):
  $ wi ph (wcel O come) $ >
  $ wceq X (cuni (cdm O)) $ >
  $ wi ph (wss A2 X) $ >
  $ wi ph (wbr (cfv A2 O) (co (cfv (cin A2 E) O) (cfv (cdif A2 E) O) cxad) cle) $;

--| If the outer measure of a countable union is not ` +oo ` , then it can be arbitrarily approximated by finite sums of outer measures. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem omeiunltfirp {z n: setvar} (ph: wff) (E: class) (N: class z n) (O: class) (X: class z) (Y: class n) (Z: class):
  $ wi ph (wcel O come) $ >
  $ wceq X (cuni (cdm O)) $ >
  $ wceq Z (cfv N cuz) $ >
  $ wi ph (wf Z (cpw X) E) $ >
  $ wi ph (wcel (cfv (ciun n Z (cfv (cv n) E)) O) cr) $ >
  $ wi ph (wcel Y crp) $ >
  $ wi ph (wrex z (wbr (cfv (ciun n Z (cfv (cv n) E)) O) (co (csu n (cv z) (cfv (cfv (cv n) E) O)) Y caddc) clt) (cin (cpw Z) cfn)) $;

--| The outer measure of the indexed union of a countable set is less than or equal to the extended sum of the outer measures. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem omeiunlempt {n: setvar} (ph: wff n) (E N: class n) (O X Z: class):
  $ wnf n ph $ >
  $ wi ph (wcel O come) $ >
  $ wceq X (cuni (cdm O)) $ >
  $ wceq Z (cfv N cuz) $ >
  $ wi (wa ph (wcel (cv n) Z)) (wss E X) $ >
  $ wi ph (wbr (cfv (ciun n Z E) O) (cfv (cmpt n Z (cfv E O)) csumge0) cle) $;

--| The outer measure of ` A i^i ( G `` n ) ` is the sum of the outer measures of ` A i^i ( F `` m ) ` . These are lines 7 to 10 of Step (d) in the proof of Theorem 113C of [Fremlin1] p. 20. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem carageniuncllem1 {i n: setvar} (ph: wff) (A2: class i) (S: class n) (E: class) (F: class i) (G: class i n) (K: class i) (M: class) (O: class i) (X: class i n) (Z: class i):
  $ wi ph (wcel O come) $ >
  $ wceq S (cfv O ccaragen) $ >
  $ wceq X (cuni (cdm O)) $ >
  $ wi ph (wss A2 X) $ >
  $ wi ph (wcel (cfv A2 O) cr) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wf Z S E) $ >
  $ wceq G (cmpt n Z (ciun i (co M (cv n) cfz) (cfv (cv i) E))) $ >
  $ wceq F (cmpt n Z (cdif (cfv (cv n) E) (ciun i (co M (cv n) cfzo) (cfv (cv i) E)))) $ >
  $ wi ph (wcel K Z) $ >
  $ wi ph (wceq (csu n (co M K cfz) (cfv (cin A2 (cfv (cv n) F)) O)) (cfv (cin A2 (cfv K G)) O)) $;

--| The Caratheodory's construction is closed under countable union. Step (d) in the proof of Theorem 113C of [Fremlin1] p. 20. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem carageniuncllem2 {i n: setvar} (ph: wff) (A2: class i) (S: class n) (E: class) (F: class i) (G: class i n) (M: class) (O X: class i) (Y: class i n) (Z: class):
  $ wi ph (wcel O come) $ >
  $ wceq S (cfv O ccaragen) $ >
  $ wceq X (cuni (cdm O)) $ >
  $ wi ph (wss A2 X) $ >
  $ wi ph (wcel (cfv A2 O) cr) $ >
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wf Z S E) $ >
  $ wi ph (wcel Y crp) $ >
  $ wceq G (cmpt n Z (ciun i (co M (cv n) cfz) (cfv (cv i) E))) $ >
  $ wceq F (cmpt n Z (cdif (cfv (cv n) E) (ciun i (co M (cv n) cfzo) (cfv (cv i) E)))) $ >
  $ wi ph (wbr (co (cfv (cin A2 (ciun n Z (cfv (cv n) E))) O) (cfv (cdif A2 (ciun n Z (cfv (cv n) E))) O) cxad) (co (cfv A2 O) Y caddc) cle) $;

--| The Caratheodory's construction is closed under indexed countable union. Step (d) in the proof of Theorem 113C of [Fremlin1] p. 20. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem carageniuncl {n: setvar} (ph: wff) (S: class n) (E M O Z: class):
  $ wi ph (wcel O come) $ >
  $ wceq S (cfv O ccaragen) $ >
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wf Z S E) $ >
  $ wi ph (wcel (ciun n Z (cfv (cv n) E)) S) $;

--| The Caratheodory's construction is closed under countable union. Step (d) in the proof of Theorem 113C of [Fremlin1] p. 20. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem caragenunicl (ph: wff) (S O X: class):
  $ wi ph (wcel O come) $ >
  $ wceq S (cfv O ccaragen) $ >
  $ wi ph (wss X S) $ >
  $ wi ph (wbr X com cdom) $ >
  $ wi ph (wcel (cuni X) S) $;

--| Caratheodory's method generates a sigma-algebra. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem caragensal (ph: wff) (S O: class):
  $ wi ph (wcel O come) $ >
  $ wceq S (cfv O ccaragen) $ >
  $ wi ph (wcel S csalg) $;

--| Lemma used to prove that Caratheodory's construction is sigma-additive. This is the proof of the statement in the middle of Step (e) in the proof of Theorem 113C of [Fremlin1] p. 21. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem caratheodorylem1 {i n: setvar} (ph: wff) (S: class i n) (E G M N O: class) (Z: class i):
  $ wi ph (wcel O come) $ >
  $ wceq S (cfv O ccaragen) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wf Z S E) $ >
  $ wi ph (wdisj n Z (cfv (cv n) E)) $ >
  $ wceq G (cmpt n Z (ciun i (co M (cv n) cfz) (cfv (cv i) E))) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi ph (wceq (cfv (cfv N G) O) (cfv (cmpt n (co M N cfz) (cfv (cfv (cv n) E) O)) csumge0)) $;

--| Caratheodory's construction is sigma-additive. Main part of Step (e) in the proof of Theorem 113C of [Fremlin1] p. 21. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem caratheodorylem2 {k n: setvar} (ph: wff) (S: class k n) (E: class) (G: class k) (O: class) (X: class k):
  $ wi ph (wcel O come) $ >
  $ wceq X (cuni (cdm O)) $ >
  $ wceq S (cfv O ccaragen) $ >
  $ wi ph (wf cn S E) $ >
  $ wi ph (wdisj n cn (cfv (cv n) E)) $ >
  $ wceq G (cmpt k cn (ciun n (co c1 (cv k) cfz) (cfv (cv n) E))) $ >
  $ wi ph (wceq (cfv (ciun n cn (cfv (cv n) E)) O) (cfv (cmpt n cn (cfv (cfv (cv n) E) O)) csumge0)) $;

--| Caratheodory's construction of a measure given an outer measure. Proof of Theorem 113C of [Fremlin1] p. 19. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem caratheodory (ph: wff) (S O: class):
  $ wi ph (wcel O come) $ >
  $ wceq S (cfv O ccaragen) $ >
  $ wi ph (wcel (cres O S) cmea) $;

--| The map that assigns 0 to every subset, is an outer measure. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem _0ome {x3: setvar} (ph: wff x3) (O V: class x3) (X: class):
  $ wi ph (wcel X V) $ >
  $ wceq O (cmpt x3 (cpw X) cc0) $ >
  $ wi ph (wcel O come) $;

--| ` O ` is sub-additive w.r.t. countable indexed union, implies that ` O ` is sub-additive w.r.t. countable union. Thus, the definition of Outer Measure can be given using an indexed union. Definition 113A of [Fremlin1] p. 19 . (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem isomenndlem {n a: setvar} (ph: wff) (A2: class) (B2 F: class a) (O: class) (X: class n) (Y: class a):
  $ wi ph (wf (cpw X) (co cc0 cpnf cicc) O) $ >
  $ wi ph (wceq (cfv c0 O) cc0) $ >
  $ wi ph (wss Y (cpw X)) $ >
  $ wi (wa ph (wf cn (cpw X) (cv a))) (wbr (cfv (ciun n cn (cfv (cv n) (cv a))) O) (cfv (cmpt n cn (cfv (cfv (cv n) (cv a)) O)) csumge0) cle) $ >
  $ wi ph (wss B2 cn) $ >
  $ wi ph (wf1o B2 Y F) $ >
  $ wceq A2 (cmpt n cn (cif (wcel (cv n) B2) (cfv (cv n) F) c0)) $ >
  $ wi ph (wbr (cfv (cuni Y) O) (cfv (cres O Y) csumge0) cle) $;

--| Sufficient condition to prove that ` O ` is an outer measure. Definition 113A of [Fremlin1] p. 19 . (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem isomennd {x3 y1 n a: setvar} (ph: wff) (O: class) (V: class x3 y1 n a) (X: class x3 y1 n):
  $ wi ph (wcel X V) $ >
  $ wi ph (wf (cpw X) (co cc0 cpnf cicc) O) $ >
  $ wi ph (wceq (cfv c0 O) cc0) $ >
  $ wi (w3a ph (wss (cv x3) X) (wss (cv y1) (cv x3))) (wbr (cfv (cv y1) O) (cfv (cv x3) O) cle) $ >
  $ wi (wa ph (wf cn (cpw X) (cv a))) (wbr (cfv (ciun n cn (cfv (cv n) (cv a))) O) (cfv (cmpt n cn (cfv (cfv (cv n) (cv a)) O)) csumge0) cle) $ >
  $ wi ph (wcel O come) $;

--| Membership in the Caratheodory's construction. Similar to ~ carageneld , but here "less than or equal to" is used, instead of equality. This is Remark 113D of [Fremlin1] p. 21. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem caragenel2d {a: setvar} (ph: wff) (S: class a) (E O: class) (X: class a):
  $ wi ph (wcel O come) $ >
  $ wceq X (cuni (cdm O)) $ >
  $ wceq S (cfv O ccaragen) $ >
  $ wi ph (wcel E (cpw X)) $ >
  $ wi (wa ph (wcel (cv a) (cpw X))) (wbr (co (cfv (cin (cv a) E) O) (cfv (cdif (cv a) E) O) cxad) (cfv (cv a) O) cle) $ >
  $ wi ph (wcel E S) $;

--| If the outer measure of a set is greater than or equal to ` 0 ` . (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem omege0 (ph: wff) (A2 O X: class):
  $ wi ph (wcel O come) $ >
  $ wceq X (cuni (cdm O)) $ >
  $ wi ph (wss A2 X) $ >
  $ wi ph (wbr cc0 (cfv A2 O) cle) $;

--| If the outer measure of a set is ` 0 ` , then the outer measure of its subsets is ` 0 ` . (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem omess0 (ph: wff) (A2 B2 O X: class):
  $ wi ph (wcel O come) $ >
  $ wceq X (cuni (cdm O)) $ >
  $ wi ph (wss A2 X) $ >
  $ wi ph (wceq (cfv A2 O) cc0) $ >
  $ wi ph (wss B2 A2) $ >
  $ wi ph (wceq (cfv B2 O) cc0) $;

--| A measure built with the Caratheodory's construction is complete. See Definition 112Df of [Fremlin1] p. 19. This is Exercise 113Xa of [Fremlin1] p. 21. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem caragencmpl (ph: wff) (S E O X: class):
  $ wi ph (wcel O come) $ >
  $ wceq X (cuni (cdm O)) $ >
  $ wi ph (wss E X) $ >
  $ wi ph (wceq (cfv E O) cc0) $ >
  $ wceq S (cfv O ccaragen) $ >
  $ wi ph (wcel E S) $;

--| Extend class notation with the class of Lebesgue outer measure for the space of multidimensional real numbers.
term covoln: class;

--| Define the outer measure for the space of multidimensional real numbers. The cardinality of ` x ` is the dimension of the space modeled. Definition 115C of [Fremlin1] p. 30. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
axiom df_ovoln {x3 y1 z i j k: setvar}:
  $ wceq covoln (cmpt x3 cfn (cmpt y1 (cpw (co cr (cv x3) cmap)) (cif (wceq (cv x3) c0) cc0 (cinf (crab z (wrex i (wa (wss (cv y1) (ciun j cn (cixp k (cv x3) (cfv (cv k) (ccom cico (cfv (cv j) (cv i))))))) (wceq (cv z) (cfv (cmpt j cn (cprod k (cv x3) (cfv (cfv (cv k) (ccom cico (cfv (cv j) (cv i)))) cvol))) csumge0))) (co (co (cxp cr cr) (cv x3) cmap) cn cmap)) cxr) cxr clt)))) $;

--| Extend class notation with the class of Lebesgue measure for the space of multidimensional real numbers.
term cvoln: class;

--| Define the Lebesgue measure for the space of multidimensional real numbers. The cardinality of ` x ` is the dimension of the space modeled. Definition 115C of [Fremlin1] p. 30. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
axiom df_voln {x3: setvar}:
  $ wceq cvoln (cmpt x3 cfn (cres (cfv (cv x3) covoln) (cfv (cfv (cv x3) covoln) ccaragen))) $;

--| Value of the Lebesgue measure for a given finite dimension. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem vonval (ph: wff) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wceq (cfv X cvoln) (cres (cfv X covoln) (cfv (cfv X covoln) ccaragen))) $;

--| Value of the Lebesgue outer measure for a given finite dimension. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem ovnval {y1 z i j k: setvar} (ph: wff y1 z i j k) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wceq (cfv X covoln) (cmpt y1 (cpw (co cr X cmap)) (cif (wceq X c0) cc0 (cinf (crab z (wrex i (wa (wss (cv y1) (ciun j cn (cixp k X (cfv (cv k) (ccom cico (cfv (cv j) (cv i))))))) (wceq (cv z) (cfv (cmpt j cn (cprod k X (cfv (cfv (cv k) (ccom cico (cfv (cv j) (cv i)))) cvol))) csumge0))) (co (co (cxp cr cr) X cmap) cn cmap)) cxr) cxr clt)))) $;

--| Membership in a multidimensional half-open interval. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem elhoi {x3: setvar} (ph: wff x3) (A2 B2: class) (V: class x3) (X Y: class):
  $ wi ph (wcel X V) $ >
  $ wi ph (wb (wcel Y (co (co A2 B2 cico) X cmap)) (wa (wf X cxr Y) (wral x3 (wcel (cfv (cv x3) Y) (co A2 B2 cico)) X))) $;

--| A closed-below, open-above real interval is measurable, when the bounds are real. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem icoresmbl:
  $ wss (crn (cres cico (cxp cr cr))) (cdm cvol) $;

--| The projection of a half-open interval onto a single dimension is a subset of ` RR ` . (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem hoissre (ph: wff) (k: setvar) (I X: class):
  $ wi ph (wf X (cxp cr cr) I) $ >
  $ wi (wa ph (wcel (cv k) X)) (wss (cfv (cv k) (ccom cico I)) cr) $;

--| Value of the Lebesgue outer measure of a subset ` A ` of the space of multidimensional real numbers. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem ovnval2 {z i j k: setvar} (ph: wff z i j k) (A2: class j k) (M: class z i j k) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wss A2 (co cr X cmap)) $ >
  $ wceq M (crab z (wrex i (wa (wss A2 (ciun j cn (cixp k X (cfv (cv k) (ccom cico (cfv (cv j) (cv i))))))) (wceq (cv z) (cfv (cmpt j cn (cprod k X (cfv (cfv (cv k) (ccom cico (cfv (cv j) (cv i)))) cvol))) csumge0))) (co (co (cxp cr cr) X cmap) cn cmap)) cxr) $ >
  $ wi ph (wceq (cfv A2 (cfv X covoln)) (cif (wceq X c0) cc0 (cinf M cxr clt))) $;

--| The Lebesgue measure of a left-closed, right-open interval with real bounds, is real. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem volicorecl (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wcel (cfv (co A2 B2 cico) cvol) cr) $;

--| The pre-measure of half-open intervals is a nonnegative real. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem hoiprodcl {k: setvar} (ph: wff k) (I: class k) (X: class):
  $ wnf k ph $ >
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wf X (cxp cr cr) I) $ >
  $ wi ph (wcel (cprod k X (cfv (cfv (cv k) (ccom cico I)) cvol)) (co cc0 cpnf cico)) $;

--| ` I ` is a countable set of half-open intervals that covers the whole multidimensional reals. See Definition 1135 (b) of [Fremlin1] p. 29. (Contributed by Glauco Siliprandi, 11-Oct-2020.) Avoid ~ ax-rep and shorten proof. (Revised by GG, 2-Apr-2026.)
theorem hoicvr {x3 i j: setvar} (ph: wff) (I: class x3 i j) (X: class):
  $ wceq I (cmpt j cn (cmpt x3 X (cop (cneg (cv j)) (cv j)))) $ >
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wss (co cr X cmap) (ciun j cn (cixp i X (cfv (cv i) (ccom cico (cfv (cv j) I)))))) $;

--| A half-open interval is a subset of R^n . (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem hoissrrn {k: setvar} (ph: wff) (I: class k) (X: class):
  $ wi ph (wf X (cxp cr cr) I) $ >
  $ wi ph (wss (cixp k X (cfv (cv k) (ccom cico I))) (co cr X cmap)) $;

--| The Lebesgue outer measure (for the zero dimensional space of reals) of every subset is zero. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem ovn0val (ph: wff) (A2: class):
  $ wi ph (wss A2 (co cr c0 cmap)) $ >
  $ wi ph (wceq (cfv A2 (cfv c0 covoln)) cc0) $;

--| The value of a (multidimensional) Lebesgue outer measure, defined on a nonzero-dimensional space of reals. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem ovnn0val {z i j k: setvar} (ph: wff z i j k) (A2: class j k) (M: class z i j k) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wne X c0) $ >
  $ wi ph (wss A2 (co cr X cmap)) $ >
  $ wceq M (crab z (wrex i (wa (wss A2 (ciun j cn (cixp k X (cfv (cv k) (ccom cico (cfv (cv j) (cv i))))))) (wceq (cv z) (cfv (cmpt j cn (cprod k X (cfv (cfv (cv k) (ccom cico (cfv (cv j) (cv i)))) cvol))) csumge0))) (co (co (cxp cr cr) X cmap) cn cmap)) cxr) $ >
  $ wi ph (wceq (cfv A2 (cfv X covoln)) (cinf M cxr clt)) $;

--| Value of the Lebesgue outer measure of a subset ` A ` of the space of multidimensional real numbers. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem ovnval2b {z i j k a: setvar} (ph: wff z i j k) (A2: class j k) (L: class z i j k a) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wss A2 (co cr X cmap)) $ >
  $ wceq L (cmpt a (cpw (co cr X cmap)) (crab z (wrex i (wa (wss (cv a) (ciun j cn (cixp k X (cfv (cv k) (ccom cico (cfv (cv j) (cv i))))))) (wceq (cv z) (cfv (cmpt j cn (cprod k X (cfv (cfv (cv k) (ccom cico (cfv (cv j) (cv i)))) cvol))) csumge0))) (co (co (cxp cr cr) X cmap) cn cmap)) cxr)) $ >
  $ wi ph (wceq (cfv A2 (cfv X covoln)) (cif (wceq X c0) cc0 (cinf (cfv A2 L) cxr clt))) $;

--| The Lebesgue measure of a left-closed, right-open interval with real bounds, is real. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem volicorescl (A2: class):
  $ wi (wcel A2 (crn (cres cico (cxp cr cr)))) (wcel (cfv A2 cvol) cr) $;

--| The product used in the definition of the outer Lebesgue measure in R^n is a nonnegative real. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem ovnprodcl {k: setvar} (ph: wff k) (F I: class k) (X: class):
  $ wnf k ph $ >
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wf cn (co (cxp cr cr) X cmap) F) $ >
  $ wi ph (wcel I cn) $ >
  $ wi ph (wcel (cprod k X (cfv (cfv (cv k) (ccom cico (cfv I F))) cvol)) (co cc0 cpnf cico)) $;

--| The pre-measure of half-open intervals is a nonnegative real. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem hoiprodcl2 {i k: setvar} (ph: wff k) (I: class) (L: class i k) (X: class):
  $ wnf k ph $ >
  $ wi ph (wcel X cfn) $ >
  $ wceq L (cmpt i (co (cxp cr cr) X cmap) (cprod k X (cfv (cfv (cv k) (ccom cico (cv i))) cvol))) $ >
  $ wi ph (wf X (cxp cr cr) I) $ >
  $ wi ph (wcel (cfv I L) (co cc0 cpnf cico)) $;

--| Any subset of the multidimensional reals can be covered by a countable set of half-open intervals, see Definition 115A (b) of [Fremlin1] p. 29. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem hoicvrrex {i j k: setvar} (ph: wff i) (X: class) (Y: class j k):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wss Y (co cr X cmap)) $ >
  $ wi ph (wrex i (wa (wss Y (ciun j cn (cixp k X (cfv (cv k) (ccom cico (cfv (cv j) (cv i))))))) (wceq cpnf (cfv (cmpt j cn (cprod k X (cfv (cfv (cv k) (ccom cico (cfv (cv j) (cv i)))) cvol))) csumge0))) (co (co (cxp cr cr) X cmap) cn cmap)) $;

--| The set used in the definition of the Lebesgue outer measure is a subset of the nonnegative extended reals. This is a substep for (a)(i) of the proof of Proposition 115D (a) of [Fremlin1] p. 30. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem ovnsupge0 {z i j k: setvar} (ph: wff) (A2 M: class z i j k) (X: class z i):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wss A2 (co cr X cmap)) $ >
  $ wceq M (crab z (wrex i (wa (wss A2 (ciun j cn (cixp k X (cfv (cv k) (ccom cico (cfv (cv j) (cv i))))))) (wceq (cv z) (cfv (cmpt j cn (cprod k X (cfv (cfv (cv k) (ccom cico (cfv (cv j) (cv i)))) cvol))) csumge0))) (co (co (cxp cr cr) X cmap) cn cmap)) cxr) $ >
  $ wi ph (wss M (co cc0 cpnf cicc)) $;

--| Given a subset of multidimensional reals and a set of half-open intervals that covers it, the Lebesgue outer measure of the set is bounded by the generalized sum of the pre-measure of the half-open intervals. The statement would also be true with ` X ` the empty set, but covers are not used for the zero-dimensional case. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem ovnlecvr {i j k: setvar} (ph: wff) (A2: class j k) (I: class) (L: class j k) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wne X c0) $ >
  $ wceq L (cmpt i (co (cxp cr cr) X cmap) (cprod k X (cfv (cfv (cv k) (ccom cico (cv i))) cvol))) $ >
  $ wi ph (wf cn (co (cxp cr cr) X cmap) I) $ >
  $ wi ph (wss A2 (ciun j cn (cixp k X (cfv (cv k) (ccom cico (cfv (cv j) I)))))) $ >
  $ wi ph (wbr (cfv A2 (cfv X covoln)) (cfv (cmpt j cn (cfv (cfv (cv j) I) L)) csumge0) cle) $;

--| ` +oo ` is an element of the set used in the definition of the Lebesgue outer measure. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem ovnpnfelsup {z i j k: setvar} (ph: wff z i) (A2: class j k) (M: class z i j k) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wss A2 (co cr X cmap)) $ >
  $ wceq M (crab z (wrex i (wa (wss A2 (ciun j cn (cixp k X (cfv (cv k) (ccom cico (cfv (cv j) (cv i))))))) (wceq (cv z) (cfv (cmpt j cn (cprod k X (cfv (cfv (cv k) (ccom cico (cfv (cv j) (cv i)))) cvol))) csumge0))) (co (co (cxp cr cr) X cmap) cn cmap)) cxr) $ >
  $ wi ph (wcel cpnf M) $;

--| The (multidimensional, nonzero-dimensional) Lebesgue outer measure of a subset is less than the L.o.m. of the whole set. This is step (iii) of the proof of Proposition 115D (a) of [Fremlin1] p. 30. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem ovnsslelem {z i j k: setvar} (ph: wff j k) (A2 B2: class j k) (M N: class z i j k) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wne X c0) $ >
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wss B2 (co cr X cmap)) $ >
  $ wceq M (crab z (wrex i (wa (wss A2 (ciun j cn (cixp k X (cfv (cv k) (ccom cico (cfv (cv j) (cv i))))))) (wceq (cv z) (cfv (cmpt j cn (cprod k X (cfv (cfv (cv k) (ccom cico (cfv (cv j) (cv i)))) cvol))) csumge0))) (co (co (cxp cr cr) X cmap) cn cmap)) cxr) $ >
  $ wceq N (crab z (wrex i (wa (wss B2 (ciun j cn (cixp k X (cfv (cv k) (ccom cico (cfv (cv j) (cv i))))))) (wceq (cv z) (cfv (cmpt j cn (cprod k X (cfv (cfv (cv k) (ccom cico (cfv (cv j) (cv i)))) cvol))) csumge0))) (co (co (cxp cr cr) X cmap) cn cmap)) cxr) $ >
  $ wi ph (wbr (cfv A2 (cfv X covoln)) (cfv B2 (cfv X covoln)) cle) $;

--| The (multidimensional) Lebesgue outer measure of a subset is less than the L.o.m. of the whole set. This is step (iii) of the proof of Proposition 115D (a) of [Fremlin1] p. 30. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem ovnssle (ph: wff) (A2 B2 X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wss B2 (co cr X cmap)) $ >
  $ wi ph (wbr (cfv A2 (cfv X covoln)) (cfv B2 (cfv X covoln)) cle) $;

--| The Lebesgue outer measure of a subset of multidimensional real numbers can always be approximated by the total outer measure of a cover of half-open (multidimensional) intervals. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem ovnlerp {z i j k: setvar} (ph: wff) (A2: class j k) (E: class i j k) (M: class z i j k) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wne X c0) $ >
  $ wi ph (wss A2 (co cr X cmap)) $ >
  $ wi ph (wcel E crp) $ >
  $ wceq M (crab z (wrex i (wa (wss A2 (ciun j cn (cixp k X (cfv (cv k) (ccom cico (cfv (cv j) (cv i))))))) (wceq (cv z) (cfv (cmpt j cn (cprod k X (cfv (cfv (cv k) (ccom cico (cfv (cv j) (cv i)))) cvol))) csumge0))) (co (co (cxp cr cr) X cmap) cn cmap)) cxr) $ >
  $ wi ph (wrex z (wbr (cv z) (co (cfv A2 (cfv X covoln)) E cxad) cle) M) $;

--| The Lebesgue outer measure is a function that maps sets to nonnegative extended reals. This is step (a)(i) of the proof of Proposition 115D (a) of [Fremlin1] p. 30. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem ovnf (ph: wff) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wf (cpw (co cr X cmap)) (co cc0 cpnf cicc) (cfv X covoln)) $;

--| The Lebesgue outer measure of a subset of multidimensional real numbers can always be approximated by the total outer measure of a cover of half-open (multidimensional) intervals. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem ovncvrrp {e h i j k a l: setvar} (ph: wff h l) (A2: class h j k) (C: class h j k a l) (D: class e h i j k a l) (E: class h j k a l) (L: class h i j k l) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wne X c0) $ >
  $ wi ph (wss A2 (co cr X cmap)) $ >
  $ wi ph (wcel E crp) $ >
  $ wceq C (cmpt a (cpw (co cr X cmap)) (crab l (wss (cv a) (ciun j cn (cixp k X (cfv (cv k) (ccom cico (cfv (cv j) (cv l))))))) (co (co (cxp cr cr) X cmap) cn cmap))) $ >
  $ wceq L (cmpt h (co (cxp cr cr) X cmap) (cprod k X (cfv (cfv (cv k) (ccom cico (cv h))) cvol))) $ >
  $ wceq D (cmpt a (cpw (co cr X cmap)) (cmpt e crp (crab i (wbr (cfv (cmpt j cn (cfv (cfv (cv j) (cv i)) L)) csumge0) (co (cfv (cv a) (cfv X covoln)) (cv e) cxad) cle) (cfv (cv a) C)))) $ >
  $ wi ph (wex i (wcel (cv i) (cfv E (cfv A2 D)))) $;

--| For any finite dimension, the Lebesgue outer measure of the empty set is zero. This is step (a)(ii) of the proof of Proposition 115D (a) of [Fremlin1] p. 30. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem ovn0lem {z i j k l: setvar} (ph: wff z i) (I: class z) (M: class z i j k l) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wne X c0) $ >
  $ wceq M (crab z (wrex i (wceq (cv z) (cfv (cmpt j cn (cprod k X (cfv (cfv (cv k) (ccom cico (cfv (cv j) (cv i)))) cvol))) csumge0)) (co (co (cxp cr cr) X cmap) cn cmap)) cxr) $ >
  $ wi ph (wcel (cinf M cxr clt) (co cc0 cpnf cicc)) $ >
  $ wceq I (cmpt j cn (cmpt l X (cop c1 cc0))) $ >
  $ wi ph (wceq (cinf M cxr clt) cc0) $;

--| For any finite dimension, the Lebesgue outer measure of the empty set is zero. This is step (ii) of the proof of Proposition 115D (a) of [Fremlin1] p. 30. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem ovn0 (ph: wff) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wceq (cfv c0 (cfv X covoln)) cc0) $;

--| The Lebesgue outer measure of a set is a nonnegative extended real. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem ovncl (ph: wff) (A2 X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wss A2 (co cr X cmap)) $ >
  $ wi ph (wcel (cfv A2 (cfv X covoln)) (co cc0 cpnf cicc)) $;

--| For the zero-dimensional space, ` voln* ` assigns zero to every subset. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem ovn02 {x3: setvar}:
  $ wceq (cfv c0 covoln) (cmpt x3 (cpw (csn c0)) cc0) $;

--| The Lebesgue outer measure of a set is an extended real. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem ovnxrcl (ph: wff) (A2 X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wss A2 (co cr X cmap)) $ >
  $ wi ph (wcel (cfv A2 (cfv X covoln)) cxr) $;

--| The Lebesgue outer measure is subadditive. Proposition 115D (a)(iv) of [Fremlin1] p. 31 . (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem ovnsubaddlem1 {z e h i j k m n a: setvar} (ph: wff z h) (A2: class j k m) (C: class z h j k m n) (D: class z e h i j k m a) (E: class z h j k m a) (F: class z) (G: class z e h a) (I: class z e a) (L: class z h k) (X: class) (Z: class z e h i j k m n a):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wne X c0) $ >
  $ wi ph (wf cn (cpw (co cr X cmap)) A2) $ >
  $ wi ph (wcel E crp) $ >
  $ wceq Z (cmpt a (cpw (co cr X cmap)) (crab z (wrex i (wa (wss (cv a) (ciun j cn (cixp k X (cfv (cv k) (ccom cico (cfv (cv j) (cv i))))))) (wceq (cv z) (cfv (cmpt j cn (cprod k X (cfv (cfv (cv k) (ccom cico (cfv (cv j) (cv i)))) cvol))) csumge0))) (co (co (cxp cr cr) X cmap) cn cmap)) cxr)) $ >
  $ wceq C (cmpt a (cpw (co cr X cmap)) (crab h (wss (cv a) (ciun j cn (cixp k X (cfv (cv k) (ccom cico (cfv (cv j) (cv h))))))) (co (co (cxp cr cr) X cmap) cn cmap))) $ >
  $ wceq L (cmpt i (co (cxp cr cr) X cmap) (cprod k X (cfv (cfv (cv k) (ccom cico (cv i))) cvol))) $ >
  $ wceq D (cmpt a (cpw (co cr X cmap)) (cmpt e crp (crab i (wbr (cfv (cmpt j cn (cfv (cfv (cv j) (cv i)) L)) csumge0) (co (cfv (cv a) (cfv X covoln)) (cv e) cxad) cle) (cfv (cv a) C)))) $ >
  $ wi (wa ph (wcel (cv n) cn)) (wcel (cfv (cv n) I) (cfv (co E (co c2 (cv n) cexp) cdiv) (cfv (cfv (cv n) A2) D))) $ >
  $ wi ph (wf1o cn (cxp cn cn) F) $ >
  $ wceq G (cmpt m cn (cfv (cfv (cfv (cv m) F) c2nd) (cfv (cfv (cfv (cv m) F) c1st) I))) $ >
  $ wi ph (wbr (cfv (ciun n cn (cfv (cv n) A2)) (cfv X covoln)) (co (cfv (cmpt n cn (cfv (cfv (cv n) A2) (cfv X covoln))) csumge0) E cxad) cle) $;

--| ` ( voln* `` X ) ` is subadditive. Proposition 115D (a)(iv) of [Fremlin1] p. 31 . (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem ovnsubaddlem2 {z e h i j k n a l: setvar} (ph: wff z h l) (A2: class h) (C: class z h j k n l) (D E: class z h l) (L: class z h k l) (X: class) (Z: class z e h i j k n a l):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wne X c0) $ >
  $ wi ph (wf cn (cpw (co cr X cmap)) A2) $ >
  $ wi ph (wcel E crp) $ >
  $ wceq Z (cmpt a (cpw (co cr X cmap)) (crab z (wrex i (wa (wss (cv a) (ciun j cn (cixp k X (cfv (cv k) (ccom cico (cfv (cv j) (cv i))))))) (wceq (cv z) (cfv (cmpt j cn (cprod k X (cfv (cfv (cv k) (ccom cico (cfv (cv j) (cv i)))) cvol))) csumge0))) (co (co (cxp cr cr) X cmap) cn cmap)) cxr)) $ >
  $ wceq C (cmpt a (cpw (co cr X cmap)) (crab l (wss (cv a) (ciun j cn (cixp k X (cfv (cv k) (ccom cico (cfv (cv j) (cv l))))))) (co (co (cxp cr cr) X cmap) cn cmap))) $ >
  $ wceq L (cmpt h (co (cxp cr cr) X cmap) (cprod k X (cfv (cfv (cv k) (ccom cico (cv h))) cvol))) $ >
  $ wceq D (cmpt a (cpw (co cr X cmap)) (cmpt e crp (crab i (wbr (cfv (cmpt j cn (cfv (cfv (cv j) (cv i)) L)) csumge0) (co (cfv (cv a) (cfv X covoln)) (cv e) cxad) cle) (cfv (cv a) C)))) $ >
  $ wi ph (wbr (cfv (ciun n cn (cfv (cv n) A2)) (cfv X covoln)) (co (cfv (cmpt n cn (cfv (cfv (cv n) A2) (cfv X covoln))) csumge0) E cxad) cle) $;

--| ` ( voln* `` X ) ` is subadditive. Proposition 115D (a)(iv) of [Fremlin1] p. 31 . (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem ovnsubadd {n: setvar} (ph: wff) (A2 X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wf cn (cpw (co cr X cmap)) A2) $ >
  $ wi ph (wbr (cfv (ciun n cn (cfv (cv n) A2)) (cfv X covoln)) (cfv (cmpt n cn (cfv (cfv (cv n) A2) (cfv X covoln))) csumge0) cle) $;

--| ` ( voln* `` X ) ` is an outer measure on the space of multidimensional real numbers with dimension equal to the cardinality of the finite set ` X ` . Proposition 115D (a) of [Fremlin1] p. 30 . (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem ovnome (ph: wff) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wcel (cfv X covoln) come) $;

--| ` ( voln `` X ) ` is a measure on the space of multidimensional real numbers with dimension equal to the cardinality of the finite set ` X ` . Comments in Definition 115E of [Fremlin1] p. 31 . (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem vonmea (ph: wff) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wcel (cfv X cvoln) cmea) $;

--| The measure of a nonempty left-closed, right-open interval. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem volicon0 (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr A2 B2 clt) $ >
  $ wi ph (wceq (cfv (co A2 B2 cico) cvol) (co B2 A2 cmin)) $;

--| ` H ` is a function (that returns the representation of the right side of a half-open interval intersected with a half-space). Step (b) in Lemma 115B of [Fremlin1] p. 29. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem hsphoif {x3 j a: setvar} (ph: wff) (A2: class) (B2: class x3) (H V: class x3 j a) (X: class) (Y: class j):
  $ wceq H (cmpt x3 cr (cmpt a (co cr X cmap) (cmpt j X (cif (wcel (cv j) Y) (cfv (cv j) (cv a)) (cif (wbr (cfv (cv j) (cv a)) (cv x3) cle) (cfv (cv j) (cv a)) (cv x3)))))) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X cr B2) $ >
  $ wi ph (wf X cr (cfv B2 (cfv A2 H))) $;

--| The dimensional volume of a multidimensional half-open interval. Definition 115A (c) of [Fremlin1] p. 29. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem hoidmvval {x3 k a b: setvar} (ph: wff k) (A2 B2: class x3) (L: class x3 k a b) (X: class):
  $ wceq L (cmpt x3 cfn (cmpo a b (co cr (cv x3) cmap) (co cr (cv x3) cmap) (cif (wceq (cv x3) c0) cc0 (cprod k (cv x3) (cfv (co (cfv (cv k) (cv a)) (cfv (cv k) (cv b)) cico) cvol))))) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wf X cr B2) $ >
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wceq (co A2 B2 (cfv X L)) (cif (wceq X c0) cc0 (cprod k X (cfv (co (cfv (cv k) A2) (cfv (cv k) B2) cico) cvol)))) $;

--| A half-open interval is a subset of R^n . (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem hoissrrn2 {k: setvar} (ph: wff k) (A2 B2: class k) (X: class):
  $ wnf k ph $ >
  $ wi (wa ph (wcel (cv k) X)) (wcel A2 cr) $ >
  $ wi (wa ph (wcel (cv k) X)) (wcel B2 cxr) $ >
  $ wi ph (wss (cixp k X (co A2 B2 cico)) (co cr X cmap)) $;

--| ` H ` is a function (that returns the representation of the right side of a half-open interval intersected with a half-space). Step (b) in Lemma 115B of [Fremlin1] p. 29. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem hsphoival {x3 j a: setvar} (ph: wff) (A2: class) (B2: class x3) (H: class x3 j a) (K: class x3 a) (V: class x3 j a) (X Y: class):
  $ wceq H (cmpt x3 cr (cmpt a (co cr X cmap) (cmpt j X (cif (wcel (cv j) Y) (cfv (cv j) (cv a)) (cif (wbr (cfv (cv j) (cv a)) (cv x3) cle) (cfv (cv j) (cv a)) (cv x3)))))) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X cr B2) $ >
  $ wi ph (wcel K X) $ >
  $ wi ph (wceq (cfv K (cfv B2 (cfv A2 H))) (cif (wcel K Y) (cfv K B2) (cif (wbr (cfv K B2) A2 cle) (cfv K B2) A2))) $;

--| The pre-measure of half-open intervals is a nonnegative real. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem hoiprodcl3 {k: setvar} (ph: wff k) (A2 B2: class k) (X: class):
  $ wnf k ph $ >
  $ wi ph (wcel X cfn) $ >
  $ wi (wa ph (wcel (cv k) X)) (wcel A2 cr) $ >
  $ wi (wa ph (wcel (cv k) X)) (wcel B2 cr) $ >
  $ wi ph (wcel (cprod k X (cfv (co A2 B2 cico) cvol)) (co cc0 cpnf cico)) $;

--| The Lebesgue measure of a left-closed right-open interval is a real number. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem volicore (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wcel (cfv (co A2 B2 cico) cvol) cr) $;

--| The dimensional volume of a multidimensional half-open interval is a nonnegative real. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem hoidmvcl {x3 k a b: setvar} (ph: wff) (A2 B2: class x3) (L: class x3 k a b) (X: class):
  $ wceq L (cmpt x3 cfn (cmpo a b (co cr (cv x3) cmap) (co cr (cv x3) cmap) (cif (wceq (cv x3) c0) cc0 (cprod k (cv x3) (cfv (co (cfv (cv k) (cv a)) (cfv (cv k) (cv b)) cico) cvol))))) $ >
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wf X cr B2) $ >
  $ wi ph (wcel (co A2 B2 (cfv X L)) (co cc0 cpnf cico)) $;

--| The dimensional volume of a 0-dimensional half-open interval. Definition 115A (c) of [Fremlin1] p. 29. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem hoidmv0val {x3 k a b: setvar} (ph: wff k) (A2 B2: class x3) (L: class x3 k a b):
  $ wceq L (cmpt x3 cfn (cmpo a b (co cr (cv x3) cmap) (co cr (cv x3) cmap) (cif (wceq (cv x3) c0) cc0 (cprod k (cv x3) (cfv (co (cfv (cv k) (cv a)) (cfv (cv k) (cv b)) cico) cvol))))) $ >
  $ wi ph (wf c0 cr A2) $ >
  $ wi ph (wf c0 cr B2) $ >
  $ wi ph (wceq (co A2 B2 (cfv c0 L)) cc0) $;

--| The dimensional volume of a non-0-dimensional half-open interval. Definition 115A (c) of [Fremlin1] p. 29. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem hoidmvn0val {x3 k a b: setvar} (ph: wff k) (A2 B2: class x3) (L: class x3 k a b) (X: class):
  $ wceq L (cmpt x3 cfn (cmpo a b (co cr (cv x3) cmap) (co cr (cv x3) cmap) (cif (wceq (cv x3) c0) cc0 (cprod k (cv x3) (cfv (co (cfv (cv k) (cv a)) (cfv (cv k) (cv b)) cico) cvol))))) $ >
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wne X c0) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wf X cr B2) $ >
  $ wi ph (wceq (co A2 B2 (cfv X L)) (cprod k X (cfv (co (cfv (cv k) A2) (cfv (cv k) B2) cico) cvol))) $;

--| The dimensional volume of a half-open interval intersected with a two half-spaces. Used in the last inequality of step (c) of Lemma 115B of [Fremlin1] p. 29. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem hsphoidmvle2 {x3 j k a b c: setvar} (ph: wff) (A2: class x3 j c) (B2: class x3) (C D: class) (H: class x3 j c) (L: class x3 j k a b c) (X: class) (Y: class k a b) (Z: class a b):
  $ wceq L (cmpt x3 cfn (cmpo a b (co cr (cv x3) cmap) (co cr (cv x3) cmap) (cif (wceq (cv x3) c0) cc0 (cprod k (cv x3) (cfv (co (cfv (cv k) (cv a)) (cfv (cv k) (cv b)) cico) cvol))))) $ >
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wcel Z (cdif X Y)) $ >
  $ wceq X (cun Y (csn Z)) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wcel D cr) $ >
  $ wi ph (wbr C D cle) $ >
  $ wceq H (cmpt x3 cr (cmpt c (co cr X cmap) (cmpt j X (cif (wcel (cv j) Y) (cfv (cv j) (cv c)) (cif (wbr (cfv (cv j) (cv c)) (cv x3) cle) (cfv (cv j) (cv c)) (cv x3)))))) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wf X cr B2) $ >
  $ wi ph (wbr (co A2 (cfv B2 (cfv C H)) (cfv X L)) (co A2 (cfv B2 (cfv D H)) (cfv X L)) cle) $;

--| The dimensional volume of a half-open interval intersected with a half-space, is less than or equal to the dimensional volume of the original half-open interval. Used in the last inequality of step (e) of Lemma 115B of [Fremlin1] p. 30. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem hsphoidmvle {x3 j k a b c: setvar} (ph: wff) (A2: class x3 j c) (B2: class x3) (C: class) (H: class x3 j c) (L: class x3 j k a b c) (X: class) (Y: class k a b) (Z: class a b):
  $ wceq L (cmpt x3 cfn (cmpo a b (co cr (cv x3) cmap) (co cr (cv x3) cmap) (cif (wceq (cv x3) c0) cc0 (cprod k (cv x3) (cfv (co (cfv (cv k) (cv a)) (cfv (cv k) (cv b)) cico) cvol))))) $ >
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wcel Z (cdif X Y)) $ >
  $ wceq X (cun Y (csn Z)) $ >
  $ wi ph (wcel C cr) $ >
  $ wceq H (cmpt x3 cr (cmpt c (co cr X cmap) (cmpt j X (cif (wcel (cv j) Y) (cfv (cv j) (cv c)) (cif (wbr (cfv (cv j) (cv c)) (cv x3) cle) (cfv (cv j) (cv c)) (cv x3)))))) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wf X cr B2) $ >
  $ wi ph (wbr (co A2 (cfv B2 (cfv C H)) (cfv X L)) (co A2 B2 (cfv X L)) cle) $;

--| The dimensional volume of the (half-open interval) empty set. Definition 115A (c) of [Fremlin1] p. 29. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem hoidmvval0 {x3 j k a b: setvar} (ph: wff j) (A2 B2: class x3) (L: class x3 j k a b) (X: class):
  $ wnf j ph $ >
  $ wceq L (cmpt x3 cfn (cmpo a b (co cr (cv x3) cmap) (co cr (cv x3) cmap) (cif (wceq (cv x3) c0) cc0 (cprod k (cv x3) (cfv (co (cfv (cv k) (cv a)) (cfv (cv k) (cv b)) cico) cvol))))) $ >
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wf X cr B2) $ >
  $ wi ph (wrex j (wbr (cfv (cv j) B2) (cfv (cv j) A2) cle) X) $ >
  $ wi ph (wceq (co A2 B2 (cfv X L)) cc0) $;

--| The dimensional volume of a half-open interval with dimension ` n + 1 ` . Used in the first equality of step (e) of Lemma 115B of [Fremlin1] p. 30. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem hoiprodp1 {x3 k a b: setvar} (ph: wff) (A2 B2: class x3) (G L V: class x3 k a b) (X: class) (Y Z: class x3 a b):
  $ wceq L (cmpt x3 cfn (cmpo a b (co cr (cv x3) cmap) (co cr (cv x3) cmap) (cif (wceq (cv x3) c0) cc0 (cprod k (cv x3) (cfv (co (cfv (cv k) (cv a)) (cfv (cv k) (cv b)) cico) cvol))))) $ >
  $ wi ph (wcel Y cfn) $ >
  $ wi ph (wcel Z V) $ >
  $ wi ph (wn (wcel Z Y)) $ >
  $ wceq X (cun Y (csn Z)) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wf X cr B2) $ >
  $ wceq G (cprod k Y (cfv (co (cfv (cv k) A2) (cfv (cv k) B2) cico) cvol)) $ >
  $ wi ph (wceq (co A2 B2 (cfv X L)) (co G (cfv (co (cfv Z A2) (cfv Z B2) cico) cvol) cmul)) $;

--| If the generalized sum of dimensional volumes of n-dimensional half-open intervals is finite, then the sum stays finite if every half-open interval is intersected with a half-space. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem sge0hsphoire {x3 j k a b c: setvar} (ph: wff) (C: class x3 j c) (D: class x3 j) (S: class j) (H: class x3 j c) (L: class x3 j k a b c) (W: class) (Y: class k a b) (Z: class j a b):
  $ wceq L (cmpt x3 cfn (cmpo a b (co cr (cv x3) cmap) (co cr (cv x3) cmap) (cif (wceq (cv x3) c0) cc0 (cprod k (cv x3) (cfv (co (cfv (cv k) (cv a)) (cfv (cv k) (cv b)) cico) cvol))))) $ >
  $ wi ph (wcel Y cfn) $ >
  $ wi ph (wcel Z (cdif W Y)) $ >
  $ wceq W (cun Y (csn Z)) $ >
  $ wi ph (wf cn (co cr W cmap) C) $ >
  $ wi ph (wf cn (co cr W cmap) D) $ >
  $ wi ph (wcel (cfv (cmpt j cn (co (cfv (cv j) C) (cfv (cv j) D) (cfv W L))) csumge0) cr) $ >
  $ wceq H (cmpt x3 cr (cmpt c (co cr W cmap) (cmpt j W (cif (wcel (cv j) Y) (cfv (cv j) (cv c)) (cif (wbr (cfv (cv j) (cv c)) (cv x3) cle) (cfv (cv j) (cv c)) (cv x3)))))) $ >
  $ wi ph (wcel S cr) $ >
  $ wi ph (wcel (cfv (cmpt j cn (co (cfv (cv j) C) (cfv (cfv (cv j) D) (cfv S H)) (cfv W L))) csumge0) cr) $;

--| The dimensional volume of the (half-open interval) empty set. Definition 115A (c) of [Fremlin1] p. 29. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem hoidmvval0b {x3 k a b: setvar} (ph: wff) (A2: class x3) (L: class x3 k a b) (X: class):
  $ wceq L (cmpt x3 cfn (cmpo a b (co cr (cv x3) cmap) (co cr (cv x3) cmap) (cif (wceq (cv x3) c0) cc0 (cprod k (cv x3) (cfv (co (cfv (cv k) (cv a)) (cfv (cv k) (cv b)) cico) cvol))))) $ >
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wceq (co A2 A2 (cfv X L)) cc0) $;

--| The supremum of ` U ` belongs to ` U ` . This is the last part of step (a) and the whole step (b) in the proof of Lemma 114B of [Fremlin1] p. 23. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem hoidmv1lelem1 {x3 y1 z j: setvar} (ph: wff x3 y1) (A2: class x3) (B2: class j) (C D: class x3 y1 j) (S: class x3 y1) (U: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr A2 B2 clt) $ >
  $ wi ph (wf cn cr C) $ >
  $ wi ph (wf cn cr D) $ >
  $ wi ph (wcel (cfv (cmpt j cn (cfv (co (cfv (cv j) C) (cfv (cv j) D) cico) cvol)) csumge0) cr) $ >
  $ wceq U (crab z (wbr (co (cv z) A2 cmin) (cfv (cmpt j cn (cfv (co (cfv (cv j) C) (cif (wbr (cfv (cv j) D) (cv z) cle) (cfv (cv j) D) (cv z)) cico) cvol)) csumge0) cle) (co A2 B2 cicc)) $ >
  $ wceq S (csup U cr clt) $ >
  $ wi ph (w3a (wcel S U) (wcel A2 U) (wrex x3 (wral y1 (wbr (cv y1) (cv x3) cle) U) cr)) $;

--| This is the contradiction proven in step (c) in the proof of Lemma 114B of [Fremlin1] p. 23. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem hoidmv1lelem2 {z u j: setvar} (ph: wff z u) (A2 B2: class u j) (C D: class u) (S: class) (U: class z j) (K: class z u) (M: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wf cn cr C) $ >
  $ wi ph (wf cn cr D) $ >
  $ wi ph (wcel (cfv (cmpt j cn (cfv (co (cfv (cv j) C) (cfv (cv j) D) cico) cvol)) csumge0) cr) $ >
  $ wceq U (crab z (wbr (co (cv z) A2 cmin) (cfv (cmpt j cn (cfv (co (cfv (cv j) C) (cif (wbr (cfv (cv j) D) (cv z) cle) (cfv (cv j) D) (cv z)) cico) cvol)) csumge0) cle) (co A2 B2 cicc)) $ >
  $ wi ph (wcel S U) $ >
  $ wi ph (wbr A2 S cle) $ >
  $ wi ph (wbr S B2 clt) $ >
  $ wi ph (wcel K cn) $ >
  $ wi ph (wcel S (co (cfv K C) (cfv K D) cico)) $ >
  $ wceq M (cif (wbr (cfv K D) B2 cle) (cfv K D) B2) $ >
  $ wi ph (wrex u (wbr S (cv u) clt) U) $;

--| The dimensional volume of a 1-dimensional half-open interval is less than or equal the generalized sum of the dimensional volumes of countable half-open intervals that cover it. This is the nonempty, finite generalized sum, sub case in Lemma 114B of [Fremlin1] p. 23. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem hoidmv1lelem3 {z j: setvar} (ph: wff) (A2 B2 C D S U: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr A2 B2 clt) $ >
  $ wi ph (wf cn cr C) $ >
  $ wi ph (wf cn cr D) $ >
  $ wi ph (wss (co A2 B2 cico) (ciun j cn (co (cfv (cv j) C) (cfv (cv j) D) cico))) $ >
  $ wi ph (wcel (cfv (cmpt j cn (cfv (co (cfv (cv j) C) (cfv (cv j) D) cico) cvol)) csumge0) cr) $ >
  $ wceq U (crab z (wbr (co (cv z) A2 cmin) (cfv (cmpt j cn (cfv (co (cfv (cv j) C) (cif (wbr (cfv (cv j) D) (cv z) cle) (cfv (cv j) D) (cv z)) cico) cvol)) csumge0) cle) (co A2 B2 cicc)) $ >
  $ wceq S (csup U cr clt) $ >
  $ wi ph (wbr (co B2 A2 cmin) (cfv (cmpt j cn (cfv (co (cfv (cv j) C) (cfv (cv j) D) cico) cvol)) csumge0) cle) $;

--| The dimensional volume of a 1-dimensional half-open interval is less than or equal to the generalized sum of the dimensional volumes of countable half-open intervals that cover it. This is one of the two base cases of the induction of Lemma 115B of [Fremlin1] p. 29 (the other base case is the 0-dimensional case). This proof of the 1-dimensional case is given in Lemma 114B of [Fremlin1] p. 23. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem hoidmv1le {x3 j k a b: setvar} (ph: wff k) (A2 B2 C D: class) (L: class x3 j k a b) (V: class x3 j a b) (X: class j) (Z: class a b):
  $ wceq L (cmpt x3 cfn (cmpo a b (co cr (cv x3) cmap) (co cr (cv x3) cmap) (cif (wceq (cv x3) c0) cc0 (cprod k (cv x3) (cfv (co (cfv (cv k) (cv a)) (cfv (cv k) (cv b)) cico) cvol))))) $ >
  $ wi ph (wcel Z V) $ >
  $ wceq X (csn Z) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wf X cr B2) $ >
  $ wi ph (wf cn (co cr X cmap) C) $ >
  $ wi ph (wf cn (co cr X cmap) D) $ >
  $ wi ph (wss (cixp k X (co (cfv (cv k) A2) (cfv (cv k) B2) cico)) (ciun j cn (cixp k X (co (cfv (cv k) (cfv (cv j) C)) (cfv (cv k) (cfv (cv j) D)) cico)))) $ >
  $ wi ph (wbr (co A2 B2 (cfv X L)) (cfv (cmpt j cn (co (cfv (cv j) C) (cfv (cv j) D) (cfv X L))) csumge0) cle) $;

--| The supremum of ` U ` belongs to ` U ` . Step (c) in the proof of Lemma 115B of [Fremlin1] p. 29. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem hoidmvlelem1 {x3 z j k a b c: setvar} (ph: wff z) (A2: class) (B2 C D: class x3 j) (S U: class) (E G: class x3 j k a b) (H: class x3 j) (L: class x3 j k a b) (W: class) (X: class x3 z j k a b c) (Y: class z) (Z: class):
  $ wceq L (cmpt x3 cfn (cmpo a b (co cr (cv x3) cmap) (co cr (cv x3) cmap) (cif (wceq (cv x3) c0) cc0 (cprod k (cv x3) (cfv (co (cfv (cv k) (cv a)) (cfv (cv k) (cv b)) cico) cvol))))) $ >
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wss Y X) $ >
  $ wi ph (wcel Z (cdif X Y)) $ >
  $ wceq W (cun Y (csn Z)) $ >
  $ wi ph (wf W cr A2) $ >
  $ wi ph (wf W cr B2) $ >
  $ wi ph (wf cn (co cr W cmap) C) $ >
  $ wi ph (wf cn (co cr W cmap) D) $ >
  $ wi ph (wcel (cfv (cmpt j cn (co (cfv (cv j) C) (cfv (cv j) D) (cfv W L))) csumge0) cr) $ >
  $ wceq H (cmpt x3 cr (cmpt c (co cr W cmap) (cmpt j W (cif (wcel (cv j) Y) (cfv (cv j) (cv c)) (cif (wbr (cfv (cv j) (cv c)) (cv x3) cle) (cfv (cv j) (cv c)) (cv x3)))))) $ >
  $ wceq G (co (cres A2 Y) (cres B2 Y) (cfv Y L)) $ >
  $ wi ph (wcel E crp) $ >
  $ wceq U (crab z (wbr (co G (co (cv z) (cfv Z A2) cmin) cmul) (co (co c1 E caddc) (cfv (cmpt j cn (co (cfv (cv j) C) (cfv (cfv (cv j) D) (cfv (cv z) H)) (cfv W L))) csumge0) cmul) cle) (co (cfv Z A2) (cfv Z B2) cicc)) $ >
  $ wceq S (csup U cr clt) $ >
  $ wi ph (wbr (cfv Z A2) (cfv Z B2) clt) $ >
  $ wi ph (wcel S U) $;

--| This is the contradiction proven in step (d) in the proof of Lemma 115B of [Fremlin1] p. 29. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem hoidmvlelem2 {x3 y1 z u i j k a b c: setvar} (ph: wff z u) (A2: class x3 y1 u i j c) (B2: class x3 u i j c) (C: class x3 y1 u c) (D: class x3 u) (P: class y1 z u i j c) (Q: class y1 i) (S: class y1) (U: class x3 y1 z i j k a b c) (E: class x3 y1 u i j k a b c) (F: class x3 y1 z u i j c) (G: class x3 y1 u i j k a b c) (H: class x3 y1 u i j c) (J K: class x3 y1 z u i j c) (L: class x3 y1 u i j k a b c) (M: class x3 y1 z u k a b c) (O: class x3 y1 z u j k a b c) (V: class z u i j k a b c) (W: class y1 u i) (X: class x3 y1 z u i j k a b c) (Y: class z u i) (Z: class u a b):
  $ wceq L (cmpt x3 cfn (cmpo a b (co cr (cv x3) cmap) (co cr (cv x3) cmap) (cif (wceq (cv x3) c0) cc0 (cprod k (cv x3) (cfv (co (cfv (cv k) (cv a)) (cfv (cv k) (cv b)) cico) cvol))))) $ >
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wss Y X) $ >
  $ wi ph (wcel Z (cdif X Y)) $ >
  $ wceq W (cun Y (csn Z)) $ >
  $ wi ph (wf W cr A2) $ >
  $ wi ph (wf W cr B2) $ >
  $ wi ph (wf cn (co cr W cmap) C) $ >
  $ wceq F (cmpt y1 Y cc0) $ >
  $ wceq J (cmpt j cn (cif (wcel S (co (cfv Z (cfv (cv j) C)) (cfv Z (cfv (cv j) D)) cico)) (cres (cfv (cv j) C) Y) F)) $ >
  $ wi ph (wf cn (co cr W cmap) D) $ >
  $ wceq K (cmpt j cn (cif (wcel S (co (cfv Z (cfv (cv j) C)) (cfv Z (cfv (cv j) D)) cico)) (cres (cfv (cv j) D) Y) F)) $ >
  $ wi ph (wcel (cfv (cmpt j cn (co (cfv (cv j) C) (cfv (cv j) D) (cfv W L))) csumge0) cr) $ >
  $ wceq H (cmpt x3 cr (cmpt c (co cr W cmap) (cmpt j W (cif (wcel (cv j) Y) (cfv (cv j) (cv c)) (cif (wbr (cfv (cv j) (cv c)) (cv x3) cle) (cfv (cv j) (cv c)) (cv x3)))))) $ >
  $ wceq G (co (cres A2 Y) (cres B2 Y) (cfv Y L)) $ >
  $ wi ph (wcel E crp) $ >
  $ wceq U (crab z (wbr (co G (co (cv z) (cfv Z A2) cmin) cmul) (co (co c1 E caddc) (cfv (cmpt j cn (co (cfv (cv j) C) (cfv (cfv (cv j) D) (cfv (cv z) H)) (cfv W L))) csumge0) cmul) cle) (co (cfv Z A2) (cfv Z B2) cicc)) $ >
  $ wi ph (wcel S U) $ >
  $ wi ph (wbr S (cfv Z B2) clt) $ >
  $ wceq P (cmpt j cn (co (cfv (cv j) J) (cfv (cv j) K) (cfv Y L))) $ >
  $ wi ph (wcel M cn) $ >
  $ wi ph (wbr G (co (co c1 E caddc) (csu j (co c1 M cfz) (cfv (cv j) P)) cmul) cle) $ >
  $ wceq O (crn (cmpt i (crab j (wcel S (co (cfv Z (cfv (cv j) C)) (cfv Z (cfv (cv j) D)) cico)) (co c1 M cfz)) (cfv Z (cfv (cv i) D)))) $ >
  $ wceq V (cun (csn (cfv Z B2)) O) $ >
  $ wceq Q (cinf V cr clt) $ >
  $ wi ph (wrex u (wbr S (cv u) clt) U) $;

--| This is the contradiction proven in step (d) in the proof of Lemma 115B of [Fremlin1] p. 29. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem hoidmvlelem3 {x3 y1 z u e f2 g2 h j k a b c: setvar} (ph: wff z u e f2 g2) (A2: class y1 u c) (B2: class e) (C D: class e f2 g2) (P: class z u e f2 g2) (S: class e f2 g2) (U: class x3 y1 z e f2 g2 h j k a b c) (E: class u e f2 g2 j) (F: class x3 y1 z u e f2 g2 h k a b c) (G: class u e f2 g2 j) (H: class x3 y1 u e f2 g2 h c) (J: class y1 z u e f2 c) (K: class y1 z u e f2 g2 c) (L: class y1 u c) (O: class x3 y1 z u e f2 g2 h a b c) (W: class y1 u e f2 g2 h) (X: class x3 y1 z u e f2 g2 h j k a b c) (Y: class z u) (Z: class e f2 g2):
  $ wceq L (cmpt x3 cfn (cmpo a b (co cr (cv x3) cmap) (co cr (cv x3) cmap) (cif (wceq (cv x3) c0) cc0 (cprod k (cv x3) (cfv (co (cfv (cv k) (cv a)) (cfv (cv k) (cv b)) cico) cvol))))) $ >
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wss Y X) $ >
  $ wi ph (wcel Z (cdif X Y)) $ >
  $ wceq W (cun Y (csn Z)) $ >
  $ wi ph (wf W cr A2) $ >
  $ wi ph (wf W cr B2) $ >
  $ wi (wa ph (wcel (cv k) W)) (wbr (cfv (cv k) A2) (cfv (cv k) B2) clt) $ >
  $ wceq F (cmpt y1 Y cc0) $ >
  $ wi ph (wf cn (co cr W cmap) C) $ >
  $ wceq J (cmpt j cn (cif (wcel S (co (cfv Z (cfv (cv j) C)) (cfv Z (cfv (cv j) D)) cico)) (cres (cfv (cv j) C) Y) F)) $ >
  $ wi ph (wf cn (co cr W cmap) D) $ >
  $ wceq K (cmpt j cn (cif (wcel S (co (cfv Z (cfv (cv j) C)) (cfv Z (cfv (cv j) D)) cico)) (cres (cfv (cv j) D) Y) F)) $ >
  $ wi ph (wcel (cfv (cmpt j cn (co (cfv (cv j) C) (cfv (cv j) D) (cfv W L))) csumge0) cr) $ >
  $ wceq H (cmpt x3 cr (cmpt c (co cr W cmap) (cmpt j W (cif (wcel (cv j) Y) (cfv (cv j) (cv c)) (cif (wbr (cfv (cv j) (cv c)) (cv x3) cle) (cfv (cv j) (cv c)) (cv x3)))))) $ >
  $ wceq G (co (cres A2 Y) (cres B2 Y) (cfv Y L)) $ >
  $ wi ph (wcel E crp) $ >
  $ wceq U (crab z (wbr (co G (co (cv z) (cfv Z A2) cmin) cmul) (co (co c1 E caddc) (cfv (cmpt j cn (co (cfv (cv j) C) (cfv (cfv (cv j) D) (cfv (cv z) H)) (cfv W L))) csumge0) cmul) cle) (co (cfv Z A2) (cfv Z B2) cicc)) $ >
  $ wi ph (wcel S U) $ >
  $ wi ph (wbr S (cfv Z B2) clt) $ >
  $ wceq P (cmpt j cn (co (cfv (cv j) J) (cfv (cv j) K) (cfv Y L))) $ >
  $ wi ph (wral e (wral f2 (wral g2 (wral h (wi (wss (cixp k Y (co (cfv (cv k) (cv e)) (cfv (cv k) (cv f2)) cico)) (ciun j cn (cixp k Y (co (cfv (cv k) (cfv (cv j) (cv g2))) (cfv (cv k) (cfv (cv j) (cv h))) cico)))) (wbr (co (cv e) (cv f2) (cfv Y L)) (cfv (cmpt j cn (co (cfv (cv j) (cv g2)) (cfv (cv j) (cv h)) (cfv Y L))) csumge0) cle)) (co (co cr Y cmap) cn cmap)) (co (co cr Y cmap) cn cmap)) (co cr Y cmap)) (co cr Y cmap)) $ >
  $ wi ph (wss (cixp k W (co (cfv (cv k) A2) (cfv (cv k) B2) cico)) (ciun j cn (cixp k W (co (cfv (cv k) (cfv (cv j) C)) (cfv (cv k) (cfv (cv j) D)) cico)))) $ >
  $ wceq O (cmpt x3 (cixp k Y (co (cfv (cv k) A2) (cfv (cv k) B2) cico)) (cmpt k W (cif (wcel (cv k) Y) (cfv (cv k) (cv x3)) S))) $ >
  $ wi ph (wrex u (wbr S (cv u) clt) U) $;

--| The dimensional volume of a multidimensional half-open interval is less than or equal the generalized sum of the dimensional volumes of countable half-open intervals that cover it. Induction step of Lemma 115B of [Fremlin1] p. 29, case nonempty interval and dimension of the space greater than ` 1 ` . (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem hoidmvlelem4 {x3 z e f2 g2 h j k a b c: setvar} (ph: wff z e f2 g2) (A2: class) (B2: class e) (C D S: class e f2) (U: class e f2 g2 h) (E G: class e f2 g2 j) (H: class x3 e f2 g2 h) (L: class) (W: class e f2 g2) (X: class x3 z e f2 g2 h j k a b c) (Y: class z) (Z: class e f2):
  $ wceq L (cmpt x3 cfn (cmpo a b (co cr (cv x3) cmap) (co cr (cv x3) cmap) (cif (wceq (cv x3) c0) cc0 (cprod k (cv x3) (cfv (co (cfv (cv k) (cv a)) (cfv (cv k) (cv b)) cico) cvol))))) $ >
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wss Y X) $ >
  $ wi ph (wne Y c0) $ >
  $ wi ph (wcel Z (cdif X Y)) $ >
  $ wceq W (cun Y (csn Z)) $ >
  $ wi ph (wf W cr A2) $ >
  $ wi ph (wf W cr B2) $ >
  $ wi (wa ph (wcel (cv k) W)) (wbr (cfv (cv k) A2) (cfv (cv k) B2) clt) $ >
  $ wi ph (wf cn (co cr W cmap) C) $ >
  $ wi ph (wf cn (co cr W cmap) D) $ >
  $ wi ph (wcel (cfv (cmpt j cn (co (cfv (cv j) C) (cfv (cv j) D) (cfv W L))) csumge0) cr) $ >
  $ wceq H (cmpt x3 cr (cmpt c (co cr W cmap) (cmpt j W (cif (wcel (cv j) Y) (cfv (cv j) (cv c)) (cif (wbr (cfv (cv j) (cv c)) (cv x3) cle) (cfv (cv j) (cv c)) (cv x3)))))) $ >
  $ wceq G (co (cres A2 Y) (cres B2 Y) (cfv Y L)) $ >
  $ wi ph (wcel E crp) $ >
  $ wceq U (crab z (wbr (co G (co (cv z) (cfv Z A2) cmin) cmul) (co (co c1 E caddc) (cfv (cmpt j cn (co (cfv (cv j) C) (cfv (cfv (cv j) D) (cfv (cv z) H)) (cfv W L))) csumge0) cmul) cle) (co (cfv Z A2) (cfv Z B2) cicc)) $ >
  $ wceq S (csup U cr clt) $ >
  $ wi ph (wral e (wral f2 (wral g2 (wral h (wi (wss (cixp k Y (co (cfv (cv k) (cv e)) (cfv (cv k) (cv f2)) cico)) (ciun j cn (cixp k Y (co (cfv (cv k) (cfv (cv j) (cv g2))) (cfv (cv k) (cfv (cv j) (cv h))) cico)))) (wbr (co (cv e) (cv f2) (cfv Y L)) (cfv (cmpt j cn (co (cfv (cv j) (cv g2)) (cfv (cv j) (cv h)) (cfv Y L))) csumge0) cle)) (co (co cr Y cmap) cn cmap)) (co (co cr Y cmap) cn cmap)) (co cr Y cmap)) (co cr Y cmap)) $ >
  $ wi ph (wss (cixp k W (co (cfv (cv k) A2) (cfv (cv k) B2) cico)) (ciun j cn (cixp k W (co (cfv (cv k) (cfv (cv j) C)) (cfv (cv k) (cfv (cv j) D)) cico)))) $ >
  $ wi ph (wbr (co A2 B2 (cfv W L)) (co (co c1 E caddc) (cfv (cmpt j cn (co (cfv (cv j) C) (cfv (cv j) D) (cfv W L))) csumge0) cmul) cle) $;

--| The dimensional volume of a multidimensional half-open interval is less than or equal the generalized sum of the dimensional volumes of countable half-open intervals that cover it. Induction step of Lemma 115B of [Fremlin1] p. 29. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem hoidmvlelem5 {x3 e f2 g2 h j k a b: setvar} (ph: wff e f2 g2) (A2: class) (B2: class e) (C D: class e f2) (L: class) (W: class e f2) (X: class x3 e f2 g2 h j k a b) (Y: class) (Z: class e f2):
  $ wceq L (cmpt x3 cfn (cmpo a b (co cr (cv x3) cmap) (co cr (cv x3) cmap) (cif (wceq (cv x3) c0) cc0 (cprod k (cv x3) (cfv (co (cfv (cv k) (cv a)) (cfv (cv k) (cv b)) cico) cvol))))) $ >
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wss Y X) $ >
  $ wi ph (wcel Z (cdif X Y)) $ >
  $ wceq W (cun Y (csn Z)) $ >
  $ wi ph (wf W cr A2) $ >
  $ wi ph (wf W cr B2) $ >
  $ wi ph (wf cn (co cr W cmap) C) $ >
  $ wi ph (wf cn (co cr W cmap) D) $ >
  $ wi ph (wral e (wral f2 (wral g2 (wral h (wi (wss (cixp k Y (co (cfv (cv k) (cv e)) (cfv (cv k) (cv f2)) cico)) (ciun j cn (cixp k Y (co (cfv (cv k) (cfv (cv j) (cv g2))) (cfv (cv k) (cfv (cv j) (cv h))) cico)))) (wbr (co (cv e) (cv f2) (cfv Y L)) (cfv (cmpt j cn (co (cfv (cv j) (cv g2)) (cfv (cv j) (cv h)) (cfv Y L))) csumge0) cle)) (co (co cr Y cmap) cn cmap)) (co (co cr Y cmap) cn cmap)) (co cr Y cmap)) (co cr Y cmap)) $ >
  $ wi ph (wss (cixp k W (co (cfv (cv k) A2) (cfv (cv k) B2) cico)) (ciun j cn (cixp k W (co (cfv (cv k) (cfv (cv j) C)) (cfv (cv k) (cfv (cv j) D)) cico)))) $ >
  $ wi ph (wne Y c0) $ >
  $ wi ph (wbr (co A2 B2 (cfv W L)) (cfv (cmpt j cn (co (cfv (cv j) C) (cfv (cv j) D) (cfv W L))) csumge0) cle) $;

--| The dimensional volume of a n-dimensional half-open interval is less than or equal the generalized sum of the dimensional volumes of countable half-open intervals that cover it. Lemma 115B of [Fremlin1] p. 29. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem hoidmvle {x3 j k a b: setvar} (ph: wff k) (A2: class x3 j) (B2: class x3 j a) (C D: class x3 a b) (L: class k) (X: class):
  $ wceq L (cmpt x3 cfn (cmpo a b (co cr (cv x3) cmap) (co cr (cv x3) cmap) (cif (wceq (cv x3) c0) cc0 (cprod k (cv x3) (cfv (co (cfv (cv k) (cv a)) (cfv (cv k) (cv b)) cico) cvol))))) $ >
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wf X cr B2) $ >
  $ wi ph (wf cn (co cr X cmap) C) $ >
  $ wi ph (wf cn (co cr X cmap) D) $ >
  $ wi ph (wss (cixp k X (co (cfv (cv k) A2) (cfv (cv k) B2) cico)) (ciun j cn (cixp k X (co (cfv (cv k) (cfv (cv j) C)) (cfv (cv k) (cfv (cv j) D)) cico)))) $ >
  $ wi ph (wbr (co A2 B2 (cfv X L)) (cfv (cmpt j cn (co (cfv (cv j) C) (cfv (cv j) D) (cfv X L))) csumge0) cle) $;

--| The Lebesgue outer measure of a multidimensional half-open interval is less than or equal to the product of its length in each dimension. First part of the proof of Proposition 115D (b) of [Fremlin1] p. 30. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem ovnhoilem1 {z i j k: setvar} (ph: wff z i) (A2 B2: class k) (H: class z k) (I: class j k) (M: class z i j k) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wf X cr B2) $ >
  $ wceq I (cixp k X (co (cfv (cv k) A2) (cfv (cv k) B2) cico)) $ >
  $ wceq M (crab z (wrex i (wa (wss I (ciun j cn (cixp k X (cfv (cv k) (ccom cico (cfv (cv j) (cv i))))))) (wceq (cv z) (cfv (cmpt j cn (cprod k X (cfv (cfv (cv k) (ccom cico (cfv (cv j) (cv i)))) cvol))) csumge0))) (co (co (cxp cr cr) X cmap) cn cmap)) cxr) $ >
  $ wceq H (cmpt j cn (cmpt k X (cif (wceq (cv j) c1) (cop (cfv (cv k) A2) (cfv (cv k) B2)) (cop cc0 cc0)))) $ >
  $ wi ph (wbr (cfv I (cfv X covoln)) (cprod k X (cfv (co (cfv (cv k) A2) (cfv (cv k) B2) cico) cvol)) cle) $;

--| The Lebesgue outer measure of a multidimensional half-open interval is less than or equal to the product of its length in each dimension. Second part of the proof of Proposition 115D (b) of [Fremlin1] p. 30. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem ovnhoilem2 {x3 z i j k n a b l: setvar} (ph: wff j) (A2 B2: class x3 j n l) (S F: class x3 z i j a b l) (I L: class j k l) (M: class x3 j k n a b l) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wne X c0) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wf X cr B2) $ >
  $ wceq I (cixp k X (co (cfv (cv k) A2) (cfv (cv k) B2) cico)) $ >
  $ wceq L (cmpt x3 cfn (cmpo a b (co cr (cv x3) cmap) (co cr (cv x3) cmap) (cif (wceq (cv x3) c0) cc0 (cprod k (cv x3) (cfv (co (cfv (cv k) (cv a)) (cfv (cv k) (cv b)) cico) cvol))))) $ >
  $ wceq M (crab z (wrex i (wa (wss I (ciun j cn (cixp k X (cfv (cv k) (ccom cico (cfv (cv j) (cv i))))))) (wceq (cv z) (cfv (cmpt j cn (cprod k X (cfv (cfv (cv k) (ccom cico (cfv (cv j) (cv i)))) cvol))) csumge0))) (co (co (cxp cr cr) X cmap) cn cmap)) cxr) $ >
  $ wceq F (cmpt i (co (co (cxp cr cr) X cmap) cn cmap) (cmpt n cn (cmpt l X (cfv (cfv (cv l) (cfv (cv n) (cv i))) c1st)))) $ >
  $ wceq S (cmpt i (co (co (cxp cr cr) X cmap) cn cmap) (cmpt n cn (cmpt l X (cfv (cfv (cv l) (cfv (cv n) (cv i))) c2nd)))) $ >
  $ wi ph (wbr (co A2 B2 (cfv X L)) (cfv I (cfv X covoln)) cle) $;

--| The Lebesgue outer measure of a multidimensional half-open interval is its dimensional volume (the product of its length in each dimension, when the dimension is nonzero). Proposition 115D (b) of [Fremlin1] p. 30. (Contributed by Glauco Siliprandi, 21-Nov-2020.)
theorem ovnhoi {x3 k a b: setvar} (ph: wff) (A2 B2: class x3) (I L: class x3 k a b) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wf X cr B2) $ >
  $ wceq I (cixp k X (co (cfv (cv k) A2) (cfv (cv k) B2) cico)) $ >
  $ wceq L (cmpt x3 cfn (cmpo a b (co cr (cv x3) cmap) (co cr (cv x3) cmap) (cif (wceq (cv x3) c0) cc0 (cprod k (cv x3) (cfv (co (cfv (cv k) (cv a)) (cfv (cv k) (cv b)) cico) cvol))))) $ >
  $ wi ph (wceq (cfv I (cfv X covoln)) (co A2 B2 (cfv X L))) $;

--| The domain of the Lebesgue outer measure is the power set of the n-dimensional Real numbers. Step (a)(i) of the proof of Proposition 115D (a) of [Fremlin1] p. 30. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem dmovn (ph: wff) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wceq (cdm (cfv X covoln)) (cpw (co cr X cmap))) $;

--| The half-open interval expressed using a composition of a function into ` ( RR X. RR ) ` and using two distinct real-valued functions for the borders. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem hoicoto2 {k: setvar} (ph: wff) (A2 B2 I: class k) (X: class):
  $ wi ph (wf X (cxp cr cr) I) $ >
  $ wceq A2 (cmpt k X (cfv (cfv (cv k) I) c1st)) $ >
  $ wceq B2 (cmpt k X (cfv (cfv (cv k) I) c2nd)) $ >
  $ wi ph (wceq (cixp k X (cfv (cv k) (ccom cico I))) (cixp k X (co (cfv (cv k) A2) (cfv (cv k) B2) cico))) $;

--| Lebesgue measurable n-dimensional subsets of Reals. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem dmvon (ph: wff) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wceq (cdm (cfv X cvoln)) (cfv (cfv X covoln) ccaragen)) $;

--| The half-open interval expressed using a composition of a function into ` ( RR X. RR ) ` and using two distinct real-valued functions for the borders. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem hoi2toco {k: setvar} (ph: wff k) (A2 B2 I: class k) (X: class):
  $ wnf k ph $ >
  $ wceq I (cmpt k X (cop (cfv (cv k) A2) (cfv (cv k) B2))) $ >
  $ wi ph (wceq (cixp k X (cfv (cv k) (ccom cico I))) (cixp k X (co (cfv (cv k) A2) (cfv (cv k) B2) cico))) $;

--| ` D ` is a function that returns the representation of the left side of the difference of a half-open interval and a half-space. Used in Lemma 115F of [Fremlin1] p. 31 . (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem hoidifhspval {x3 k a: setvar} (ph: wff k a) (D: class x3 k a) (K: class k a) (X: class k) (Y: class):
  $ wceq D (cmpt x3 cr (cmpt a (co cr X cmap) (cmpt k X (cif (wceq (cv k) K) (cif (wbr (cv x3) (cfv (cv k) (cv a)) cle) (cfv (cv k) (cv a)) (cv x3)) (cfv (cv k) (cv a)))))) $ >
  $ wi ph (wcel Y cr) $ >
  $ wi ph (wceq (cfv Y D) (cmpt a (co cr X cmap) (cmpt k X (cif (wceq (cv k) K) (cif (wbr Y (cfv (cv k) (cv a)) cle) (cfv (cv k) (cv a)) Y) (cfv (cv k) (cv a)))))) $;

--| The value of the half-space of n-dimensional Real numbers. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem hspval {x3 y1 i k: setvar} (ph: wff) (H: class x3 y1 i k) (I: class x3) (X: class) (Y: class x3):
  $ wceq H (cmpt x3 cfn (cmpo i y1 (cv x3) cr (cixp k (cv x3) (cif (wceq (cv k) (cv i)) (co cmnf (cv y1) cioo) cr)))) $ >
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wcel I X) $ >
  $ wi ph (wcel Y cr) $ >
  $ wi ph (wceq (co I Y (cfv X H)) (cixp k X (cif (wceq (cv k) I) (co cmnf Y cioo) cr))) $;

--| Given a subset of multidimensional reals and a set of half-open intervals that covers it, the Lebesgue outer measure of the set is bounded by the generalized sum of the pre-measure of the half-open intervals. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem ovnlecvr2 {x3 j k a b: setvar} (ph: wff) (A2: class x3 j k a b) (C D: class x3 j) (L: class x3 j k a b) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wf cn (co cr X cmap) C) $ >
  $ wi ph (wf cn (co cr X cmap) D) $ >
  $ wi ph (wss A2 (ciun j cn (cixp k X (co (cfv (cv k) (cfv (cv j) C)) (cfv (cv k) (cfv (cv j) D)) cico)))) $ >
  $ wceq L (cmpt x3 cfn (cmpo a b (co cr (cv x3) cmap) (co cr (cv x3) cmap) (cif (wceq (cv x3) c0) cc0 (cprod k (cv x3) (cfv (co (cfv (cv k) (cv a)) (cfv (cv k) (cv b)) cico) cvol))))) $ >
  $ wi ph (wbr (cfv A2 (cfv X covoln)) (cfv (cmpt j cn (co (cfv (cv j) C) (cfv (cv j) D) (cfv X L))) csumge0) cle) $;

--| ` B ` and ` T ` are the left and right side of a cover of ` A ` . This cover is made of n-dimensional half-open intervals and approximates the n-dimensional Lebesgue outer volume of ` A ` . (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem ovncvr2 {h i j k r a l: setvar} (ph: wff i l) (A2: class h j k) (B2: class i j k r a l) (C: class h j k l) (D: class h i j k r a l) (T: class i j k r a l) (E: class h j k a l) (I: class r a) (L: class h j k l) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wss A2 (co cr X cmap)) $ >
  $ wi ph (wcel E crp) $ >
  $ wceq C (cmpt a (cpw (co cr X cmap)) (crab l (wss (cv a) (ciun j cn (cixp k X (cfv (cv k) (ccom cico (cfv (cv j) (cv l))))))) (co (co (cxp cr cr) X cmap) cn cmap))) $ >
  $ wceq L (cmpt h (co (cxp cr cr) X cmap) (cprod k X (cfv (cfv (cv k) (ccom cico (cv h))) cvol))) $ >
  $ wceq D (cmpt a (cpw (co cr X cmap)) (cmpt r crp (crab i (wbr (cfv (cmpt j cn (cfv (cfv (cv j) (cv i)) L)) csumge0) (co (cfv (cv a) (cfv X covoln)) (cv r) cxad) cle) (cfv (cv a) C)))) $ >
  $ wi ph (wcel I (cfv E (cfv A2 D))) $ >
  $ wceq B2 (cmpt j cn (cmpt k X (cfv (cfv (cv k) (cfv (cv j) I)) c1st))) $ >
  $ wceq T (cmpt j cn (cmpt k X (cfv (cfv (cv k) (cfv (cv j) I)) c2nd))) $ >
  $ wi ph (wa (wa (wa (wf cn (co cr X cmap) B2) (wf cn (co cr X cmap) T)) (wss A2 (ciun j cn (cixp k X (co (cfv (cv k) (cfv (cv j) B2)) (cfv (cv k) (cfv (cv j) T)) cico))))) (wbr (cfv (cmpt j cn (cprod k X (cfv (co (cfv (cv k) (cfv (cv j) B2)) (cfv (cv k) (cfv (cv j) T)) cico) cvol))) csumge0) (co (cfv A2 (cfv X covoln)) E cxad) cle)) $;

--| ` B ` and ` T ` are the left and right side of a cover of ` A ` . This cover is made of n-dimensional half-open intervals and approximates the n-dimensional Lebesgue outer volume of ` A ` . (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem ovncvr2_b1 {h j k r a l: setvar} (ph: wff l) (A2: class j k) (B2: class j k r a l) (C: class j k l) (D: class h j k r a l) (T: class j k r a l) (E: class j k a l) (I: class r a) (L: class j k l) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wss A2 (co cr X cmap)) $ >
  $ wi ph (wcel E crp) $ >
  $ wceq C (cmpt a (cpw (co cr X cmap)) (crab l (wss (cv a) (ciun j cn (cixp k X (cfv (cv k) (ccom cico (cfv (cv j) (cv l))))))) (co (co (cxp cr cr) X cmap) cn cmap))) $ >
  $ wceq L (cmpt h (co (cxp cr cr) X cmap) (cprod k X (cfv (cfv (cv k) (ccom cico (cv h))) cvol))) $ >
  $ wceq D (cmpt a (cpw (co cr X cmap)) (cmpt r crp (crab h (wbr (cfv (cmpt j cn (cfv (cfv (cv j) (cv h)) L)) csumge0) (co (cfv (cv a) (cfv X covoln)) (cv r) cxad) cle) (cfv (cv a) C)))) $ >
  $ wi ph (wcel I (cfv E (cfv A2 D))) $ >
  $ wceq B2 (cmpt j cn (cmpt k X (cfv (cfv (cv k) (cfv (cv j) I)) c1st))) $ >
  $ wceq T (cmpt j cn (cmpt k X (cfv (cfv (cv k) (cfv (cv j) I)) c2nd))) $ >
  $ wi ph (wa (wa (wa (wf cn (co cr X cmap) B2) (wf cn (co cr X cmap) T)) (wss A2 (ciun j cn (cixp k X (co (cfv (cv k) (cfv (cv j) B2)) (cfv (cv k) (cfv (cv j) T)) cico))))) (wbr (cfv (cmpt j cn (cprod k X (cfv (co (cfv (cv k) (cfv (cv j) B2)) (cfv (cv k) (cfv (cv j) T)) cico) cvol))) csumge0) (co (cfv A2 (cfv X covoln)) E cxad) cle)) $;

--| The domain of the Lebesgue measure is a sigma-algebra. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem dmovnsal (ph: wff) (S X: class):
  $ wi ph (wcel X cfn) $ >
  $ wceq S (cdm (cfv X cvoln)) $ >
  $ wi ph (wcel S csalg) $;

--| Base set of the n-dimensional Lebesgue outer measure. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem unidmovn (ph: wff) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wceq (cuni (cdm (cfv X covoln))) (co cr X cmap)) $;

--| The set of n-dimensional Real numbers is Lebesgue measurable. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem rrnmbl (ph: wff) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wcel (co cr X cmap) (cdm (cfv X cvoln))) $;

--| ` D ` is a function that returns the representation of the left side of the difference of a half-open interval and a half-space. Used in Lemma 115F of [Fremlin1] p. 31 . (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem hoidifhspval2 {x3 k a: setvar} (ph: wff k) (A2: class x3) (D: class x3 k a) (K: class k) (V: class x3 k a) (X Y: class):
  $ wceq D (cmpt x3 cr (cmpt a (co cr X cmap) (cmpt k X (cif (wceq (cv k) K) (cif (wbr (cv x3) (cfv (cv k) (cv a)) cle) (cfv (cv k) (cv a)) (cv x3)) (cfv (cv k) (cv a)))))) $ >
  $ wi ph (wcel Y cr) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wceq (cfv A2 (cfv Y D)) (cmpt k X (cif (wceq (cv k) K) (cif (wbr Y (cfv (cv k) A2) cle) (cfv (cv k) A2) Y) (cfv (cv k) A2)))) $;

--| A n-dimensional half-open interval is the intersection of the difference of half spaces. This is a substep of Proposition 115G (a) of [Fremlin1] p. 32. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem hspdifhsp {x3 y1 i l: setvar} (ph: wff) (A2 B2 H X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wne X c0) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wf X cr B2) $ >
  $ wceq H (cmpt x3 cfn (cmpo l y1 (cv x3) cr (cixp i (cv x3) (cif (wceq (cv i) (cv l)) (co cmnf (cv y1) cioo) cr)))) $ >
  $ wi ph (wceq (cixp i X (co (cfv (cv i) A2) (cfv (cv i) B2) cico)) (ciin i X (cdif (co (cv i) (cfv (cv i) B2) (cfv X H)) (co (cv i) (cfv (cv i) A2) (cfv X H))))) $;

--| Base set of the n-dimensional Lebesgue measure. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem unidmvon (ph: wff) (S X: class):
  $ wi ph (wcel X cfn) $ >
  $ wceq S (cdm (cfv X cvoln)) $ >
  $ wi ph (wceq (cuni S) (co cr X cmap)) $;

--| ` D ` is a function that returns the representation of the left side of the difference of a half-open interval and a half-space. Used in Lemma 115F of [Fremlin1] p. 31 . (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem hoidifhspf {x3 k a: setvar} (ph: wff) (A2: class x3) (D: class x3 k a) (K: class k) (V: class x3 k a) (X Y: class):
  $ wceq D (cmpt x3 cr (cmpt a (co cr X cmap) (cmpt k X (cif (wceq (cv k) K) (cif (wbr (cv x3) (cfv (cv k) (cv a)) cle) (cfv (cv k) (cv a)) (cv x3)) (cfv (cv k) (cv a)))))) $ >
  $ wi ph (wcel Y cr) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wf X cr (cfv A2 (cfv Y D))) $;

--| ` D ` is a function that returns the representation of the left side of the difference of a half-open interval and a half-space. Used in Lemma 115F of [Fremlin1] p. 31 . (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem hoidifhspval3 {x3 k a: setvar} (ph: wff) (A2: class x3) (D: class x3 k a) (J: class x3 a) (K: class) (V: class x3 k a) (X Y: class):
  $ wceq D (cmpt x3 cr (cmpt a (co cr X cmap) (cmpt k X (cif (wceq (cv k) K) (cif (wbr (cv x3) (cfv (cv k) (cv a)) cle) (cfv (cv k) (cv a)) (cv x3)) (cfv (cv k) (cv a)))))) $ >
  $ wi ph (wcel Y cr) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wcel J X) $ >
  $ wi ph (wceq (cfv J (cfv A2 (cfv Y D))) (cif (wceq J K) (cif (wbr Y (cfv J A2) cle) (cfv J A2) Y) (cfv J A2))) $;

--| The dimensional volume of the difference of a half-open interval and a half-space is less than or equal to the dimensional volume of the whole half-open interval. Used in Lemma 115F of [Fremlin1] p. 31 . (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem hoidifhspdmvle {x3 h k a b c: setvar} (ph: wff) (A2: class x3) (B2 D: class x3 h c) (K: class k a b) (L: class x3 h k a b c) (X Y: class):
  $ wceq L (cmpt x3 cfn (cmpo a b (co cr (cv x3) cmap) (co cr (cv x3) cmap) (cif (wceq (cv x3) c0) cc0 (cprod k (cv x3) (cfv (co (cfv (cv k) (cv a)) (cfv (cv k) (cv b)) cico) cvol))))) $ >
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wf X cr B2) $ >
  $ wi ph (wcel K X) $ >
  $ wceq D (cmpt x3 cr (cmpt c (co cr X cmap) (cmpt h X (cif (wceq (cv h) K) (cif (wbr (cv x3) (cfv (cv h) (cv c)) cle) (cfv (cv h) (cv c)) (cv x3)) (cfv (cv h) (cv c)))))) $ >
  $ wi ph (wcel Y cr) $ >
  $ wi ph (wbr (co (cfv A2 (cfv Y D)) B2 (cfv X L)) (co A2 B2 (cfv X L)) cle) $;

--| The Lebesgue measure is complete. See Definition 112Df of [Fremlin1] p. 19. This is an observation written after Definition 115E of [Fremlin1] p. 31. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem voncmpl (ph: wff) (S E F X: class):
  $ wi ph (wcel X cfn) $ >
  $ wceq S (cdm (cfv X cvoln)) $ >
  $ wi ph (wcel E (cdm (cfv X cvoln))) $ >
  $ wi ph (wceq (cfv E (cfv X cvoln)) cc0) $ >
  $ wi ph (wss F E) $ >
  $ wi ph (wcel F S) $;

--| The center of the n-dimensional ball belongs to the half-open interval. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem hoiqssbllem1 {i: setvar} (ph: wff i) (C D E: class i) (X Y: class):
  $ wnf i ph $ >
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wne X c0) $ >
  $ wi ph (wcel Y (co cr X cmap)) $ >
  $ wi ph (wf X cr C) $ >
  $ wi ph (wf X cr D) $ >
  $ wi ph (wcel E crp) $ >
  $ wi (wa ph (wcel (cv i) X)) (wcel (cfv (cv i) C) (co (co (cfv (cv i) Y) (co E (co c2 (cfv (cfv X chash) csqrt) cmul) cdiv) cmin) (cfv (cv i) Y) cioo)) $ >
  $ wi (wa ph (wcel (cv i) X)) (wcel (cfv (cv i) D) (co (cfv (cv i) Y) (co (cfv (cv i) Y) (co E (co c2 (cfv (cfv X chash) csqrt) cmul) cdiv) caddc) cioo)) $ >
  $ wi ph (wcel Y (cixp i X (co (cfv (cv i) C) (cfv (cv i) D) cico))) $;

--| The center of the n-dimensional ball belongs to the half-open interval. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem hoiqssbllem2 {i: setvar} (ph: wff) (C D E X Y: class):
  $ wnf i ph $ >
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wne X c0) $ >
  $ wi ph (wcel Y (co cr X cmap)) $ >
  $ wi ph (wf X cr C) $ >
  $ wi ph (wf X cr D) $ >
  $ wi ph (wcel E crp) $ >
  $ wi (wa ph (wcel (cv i) X)) (wcel (cfv (cv i) C) (co (co (cfv (cv i) Y) (co E (co c2 (cfv (cfv X chash) csqrt) cmul) cdiv) cmin) (cfv (cv i) Y) cioo)) $ >
  $ wi (wa ph (wcel (cv i) X)) (wcel (cfv (cv i) D) (co (cfv (cv i) Y) (co (cfv (cv i) Y) (co E (co c2 (cfv (cfv X chash) csqrt) cmul) cdiv) caddc) cioo)) $ >
  $ wi ph (wss (cixp i X (co (cfv (cv i) C) (cfv (cv i) D) cico)) (co Y E (cfv (cfv (cfv X crrx) cds) cbl))) $;

--| A n-dimensional ball contains a nonempty half-open interval with vertices with rational components. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem hoiqssbllem3 {i c d: setvar} (ph: wff) (E X Y: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wne X c0) $ >
  $ wi ph (wcel Y (co cr X cmap)) $ >
  $ wi ph (wcel E crp) $ >
  $ wi ph (wrex c (wrex d (wa (wcel Y (cixp i X (co (cfv (cv i) (cv c)) (cfv (cv i) (cv d)) cico))) (wss (cixp i X (co (cfv (cv i) (cv c)) (cfv (cv i) (cv d)) cico)) (co Y E (cfv (cfv (cfv X crrx) cds) cbl)))) (co cq X cmap)) (co cq X cmap)) $;

--| A n-dimensional ball contains a nonempty half-open interval with vertices with rational components. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem hoiqssbl {i c d: setvar} (ph: wff) (E X Y: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wcel Y (co cr X cmap)) $ >
  $ wi ph (wcel E crp) $ >
  $ wi ph (wrex c (wrex d (wa (wcel Y (cixp i X (co (cfv (cv i) (cv c)) (cfv (cv i) (cv d)) cico))) (wss (cixp i X (co (cfv (cv i) (cv c)) (cfv (cv i) (cv d)) cico)) (co Y E (cfv (cfv (cfv X crrx) cds) cbl)))) (co cq X cmap)) (co cq X cmap)) $;

--| Any half-space of the n-dimensional Real numbers is Lebesgue measurable. This is Step (a) of Lemma 115F of [Fremlin1] p. 31. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem hspmbllem1 {x3 y1 h k a b c: setvar} (ph: wff) (A2 B2: class x3 y1) (S T: class x3 y1 h c) (K: class a b) (L: class x3 y1 h k a b c) (X Y: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wcel K X) $ >
  $ wi ph (wcel Y cr) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wf X cr B2) $ >
  $ wceq L (cmpt x3 cfn (cmpo a b (co cr (cv x3) cmap) (co cr (cv x3) cmap) (cif (wceq (cv x3) c0) cc0 (cprod k (cv x3) (cfv (co (cfv (cv k) (cv a)) (cfv (cv k) (cv b)) cico) cvol))))) $ >
  $ wceq T (cmpt y1 cr (cmpt c (co cr X cmap) (cmpt h X (cif (wcel (cv h) (cdif X (csn K))) (cfv (cv h) (cv c)) (cif (wbr (cfv (cv h) (cv c)) (cv y1) cle) (cfv (cv h) (cv c)) (cv y1)))))) $ >
  $ wceq S (cmpt x3 cr (cmpt c (co cr X cmap) (cmpt h X (cif (wceq (cv h) K) (cif (wbr (cv x3) (cfv (cv h) (cv c)) cle) (cfv (cv h) (cv c)) (cv x3)) (cfv (cv h) (cv c)))))) $ >
  $ wi ph (wceq (co A2 B2 (cfv X L)) (co (co A2 (cfv B2 (cfv Y T)) (cfv X L)) (co (cfv A2 (cfv Y S)) B2 (cfv X L)) cxad)) $;

--| Any half-space of the n-dimensional Real numbers is Lebesgue measurable. This is Step (b) of Lemma 115F of [Fremlin1] p. 31. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem hspmbllem2 {x3 y1 h j k a b c l: setvar} (ph: wff) (A2: class x3 y1 h a b c l) (C: class x3 y1 j) (D: class x3 y1) (S T: class x3 y1 h j c) (E: class x3 y1 h j k a b c l) (H: class x3 y1 h a b c l) (K: class) (L: class x3 y1 h j k a b c l) (X Y: class):
  $ wceq H (cmpt x3 cfn (cmpo l y1 (cv x3) cr (cixp k (cv x3) (cif (wceq (cv k) (cv l)) (co cmnf (cv y1) cioo) cr)))) $ >
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wcel K X) $ >
  $ wi ph (wcel Y cr) $ >
  $ wi ph (wcel E crp) $ >
  $ wi ph (wf cn (co cr X cmap) C) $ >
  $ wi ph (wf cn (co cr X cmap) D) $ >
  $ wi ph (wss A2 (ciun j cn (cixp k X (co (cfv (cv k) (cfv (cv j) C)) (cfv (cv k) (cfv (cv j) D)) cico)))) $ >
  $ wi ph (wbr (cfv (cmpt j cn (cprod k X (cfv (co (cfv (cv k) (cfv (cv j) C)) (cfv (cv k) (cfv (cv j) D)) cico) cvol))) csumge0) (co (cfv A2 (cfv X covoln)) E caddc) cle) $ >
  $ wi ph (wcel (cfv A2 (cfv X covoln)) cr) $ >
  $ wi ph (wcel (cfv (cin A2 (co K Y (cfv X H))) (cfv X covoln)) cr) $ >
  $ wi ph (wcel (cfv (cdif A2 (co K Y (cfv X H))) (cfv X covoln)) cr) $ >
  $ wceq L (cmpt x3 cfn (cmpo a b (co cr (cv x3) cmap) (co cr (cv x3) cmap) (cif (wceq (cv x3) c0) cc0 (cprod k (cv x3) (cfv (co (cfv (cv k) (cv a)) (cfv (cv k) (cv b)) cico) cvol))))) $ >
  $ wceq T (cmpt y1 cr (cmpt c (co cr X cmap) (cmpt h X (cif (wcel (cv h) (cdif X (csn K))) (cfv (cv h) (cv c)) (cif (wbr (cfv (cv h) (cv c)) (cv y1) cle) (cfv (cv h) (cv c)) (cv y1)))))) $ >
  $ wceq S (cmpt x3 cr (cmpt c (co cr X cmap) (cmpt h X (cif (wceq (cv h) K) (cif (wbr (cv x3) (cfv (cv h) (cv c)) cle) (cfv (cv h) (cv c)) (cv x3)) (cfv (cv h) (cv c)))))) $ >
  $ wi ph (wbr (co (cfv (cin A2 (co K Y (cfv X H))) (cfv X covoln)) (cfv (cdif A2 (co K Y (cfv X H))) (cfv X covoln)) caddc) (co (cfv A2 (cfv X covoln)) E caddc) cle) $;

--| Any half-space of the n-dimensional Real numbers is Lebesgue measurable. Lemma 115F of [Fremlin1] p. 31. This proof handles the non-trivial cases (nonzero dimension and finite outer measure). (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem hspmbllem3 {x3 y1 h i j k r a l: setvar} (ph: wff) (A2: class) (B2: class x3 y1 i j r) (C: class x3 y1 j k l) (D: class i) (T: class x3 y1 i r) (H: class x3 y1 h r a l) (K: class r) (L: class x3 y1 j k l) (X: class) (Y: class r):
  $ wceq H (cmpt x3 cfn (cmpo l y1 (cv x3) cr (cixp k (cv x3) (cif (wceq (cv k) (cv l)) (co cmnf (cv y1) cioo) cr)))) $ >
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wcel K X) $ >
  $ wi ph (wcel Y cr) $ >
  $ wi ph (wcel (cfv A2 (cfv X covoln)) cr) $ >
  $ wi ph (wss A2 (co cr X cmap)) $ >
  $ wceq C (cmpt a (cpw (co cr X cmap)) (crab l (wss (cv a) (ciun j cn (cixp k X (cfv (cv k) (ccom cico (cfv (cv j) (cv l))))))) (co (co (cxp cr cr) X cmap) cn cmap))) $ >
  $ wceq L (cmpt h (co (cxp cr cr) X cmap) (cprod k X (cfv (cfv (cv k) (ccom cico (cv h))) cvol))) $ >
  $ wceq D (cmpt a (cpw (co cr X cmap)) (cmpt r crp (crab i (wbr (cfv (cmpt j cn (cfv (cfv (cv j) (cv i)) L)) csumge0) (co (cfv (cv a) (cfv X covoln)) (cv r) cxad) cle) (cfv (cv a) C)))) $ >
  $ wceq B2 (cmpt j cn (cmpt k X (cfv (cfv (cv k) (cfv (cv j) (cv i))) c1st))) $ >
  $ wceq T (cmpt j cn (cmpt k X (cfv (cfv (cv k) (cfv (cv j) (cv i))) c2nd))) $ >
  $ wi ph (wbr (co (cfv (cin A2 (co K Y (cfv X H))) (cfv X covoln)) (cfv (cdif A2 (co K Y (cfv X H))) (cfv X covoln)) cxad) (cfv A2 (cfv X covoln)) cle) $;

--| Any half-space of the n-dimensional Real numbers is Lebesgue measurable. Lemma 115F of [Fremlin1] p. 31. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem hspmbl {x3 y1 k l: setvar} (ph: wff k) (H: class x3 y1 k l) (K X Y: class k):
  $ wceq H (cmpt x3 cfn (cmpo l y1 (cv x3) cr (cixp k (cv x3) (cif (wceq (cv k) (cv l)) (co cmnf (cv y1) cioo) cr)))) $ >
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wcel K X) $ >
  $ wi ph (wcel Y cr) $ >
  $ wi ph (wcel (co K Y (cfv X H)) (cdm (cfv X cvoln))) $;

--| Any n-dimensional half-open interval is Lebesgue measurable. This is a substep of Proposition 115G (a) of [Fremlin1] p. 32. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem hoimbllem {x3 y1 i l: setvar} (ph: wff) (A2 B2: class) (S: class x3 y1 l) (H X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wne X c0) $ >
  $ wceq S (cdm (cfv X cvoln)) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wf X cr B2) $ >
  $ wceq H (cmpt x3 cfn (cmpo l y1 (cv x3) cr (cixp i (cv x3) (cif (wceq (cv i) (cv l)) (co cmnf (cv y1) cioo) cr)))) $ >
  $ wi ph (wcel (cixp i X (co (cfv (cv i) A2) (cfv (cv i) B2) cico)) S) $;

--| Any n-dimensional half-open interval is Lebesgue measurable. This is a substep of Proposition 115G (a) of [Fremlin1] p. 32. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem hoimbl {i: setvar} (ph: wff) (A2 B2 S X: class):
  $ wi ph (wcel X cfn) $ >
  $ wceq S (cdm (cfv X cvoln)) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wf X cr B2) $ >
  $ wi ph (wcel (cixp i X (co (cfv (cv i) A2) (cfv (cv i) B2) cico)) S) $;

--| The half-open interval expressed using a composition of a function (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem opnvonmbllem1 {h i: setvar} (ph: wff h i) (B2 C D: class h i) (G H: class i) (K V: class h i) (X: class) (Y: class i):
  $ wnf i ph $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wf X cq C) $ >
  $ wi ph (wf X cq D) $ >
  $ wi ph (wss (cixp i X (co (cfv (cv i) C) (cfv (cv i) D) cico)) B2) $ >
  $ wi ph (wss B2 G) $ >
  $ wi ph (wcel Y (cixp i X (co (cfv (cv i) C) (cfv (cv i) D) cico))) $ >
  $ wceq K (crab h (wss (cixp i X (cfv (cv i) (ccom cico (cv h)))) G) (co (cxp cq cq) X cmap)) $ >
  $ wceq H (cmpt i X (cop (cfv (cv i) C) (cfv (cv i) D))) $ >
  $ wi ph (wrex h (wcel Y (cixp i X (cfv (cv i) (ccom cico (cv h))))) K) $;

--| An open subset of the n-dimensional Real numbers is Lebesgue measurable. This is Proposition 115G (a) of [Fremlin1] p. 32. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem opnvonmbllem2 {h i: setvar} (ph: wff) (S G K X: class):
  $ wi ph (wcel X cfn) $ >
  $ wceq S (cdm (cfv X cvoln)) $ >
  $ wi ph (wcel G (cfv (cfv X crrx) ctopn)) $ >
  $ wceq K (crab h (wss (cixp i X (cfv (cv i) (ccom cico (cv h)))) G) (co (cxp cq cq) X cmap)) $ >
  $ wi ph (wcel G S) $;

--| An open subset of the n-dimensional Real numbers is Lebesgue measurable. This is Proposition 115G (a) of [Fremlin1] p. 32. (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem opnvonmbl (ph: wff) (S G X: class):
  $ wi ph (wcel X cfn) $ >
  $ wceq S (cdm (cfv X cvoln)) $ >
  $ wi ph (wcel G (cfv (cfv X crrx) ctopn)) $ >
  $ wi ph (wcel G S) $;

--| Open sets of a generalized real Euclidean space are Borel sets (notice that this theorem is even more general, because ` X ` is not required to be a set). (Contributed by Glauco Siliprandi, 3-Jan-2021.)
theorem opnssborel (A2 B2 X: class):
  $ wceq A2 (cfv (cfv X crrx) ctopn) $ >
  $ wceq B2 (cfv A2 csalgen) $ >
  $ wss A2 B2 $;

--| All Borel subsets of the n-dimensional Real numbers are Lebesgue measurable. This is Proposition 115G (b) of [Fremlin1] p. 32. See also Definition 111G (d) of [Fremlin1] p. 13. (Contributed by Glauco Siliprandi, 3-Jan-2021.)
theorem borelmbl (ph: wff) (B2 S X: class):
  $ wi ph (wcel X cfn) $ >
  $ wceq S (cdm (cfv X cvoln)) $ >
  $ wceq B2 (cfv (cfv (cfv X crrx) ctopn) csalgen) $ >
  $ wi ph (wss B2 S) $;

--| The Lebesgue measure of a left-closed right-open interval with real bounds, is a nonnegative real number. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem volicorege0 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wcel (cfv (co A2 B2 cico) cvol) (co cc0 cpnf cico)) $;

--| The predicate " ` A ` is measurable w.r.t. the n-dimensional Lebesgue measure". A set is measurable if it splits every other set ` x ` in a "nice" way, that is, if the measure of the pieces ` x i^i A ` and ` x \ A ` sum up to the measure of ` x ` . Definition 114E of [Fremlin1] p. 25. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem isvonmbl {a: setvar} (ph: wff a) (E X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wb (wcel E (cdm (cfv X cvoln))) (wa (wss E (co cr X cmap)) (wral a (wceq (co (cfv (cin (cv a) E) (cfv X covoln)) (cfv (cdif (cv a) E) (cfv X covoln)) cxad) (cfv (cv a) (cfv X covoln))) (cpw (co cr X cmap))))) $;

--| The n-dimensional Lebesgue measure of a measurable set is the same as its n-dimensional Lebesgue outer measure. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem mblvon (ph: wff) (A2 X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wcel A2 (cdm (cfv X cvoln))) $ >
  $ wi ph (wceq (cfv A2 (cfv X cvoln)) (cfv A2 (cfv X covoln))) $;

--| n-dimensional Lebesgue measurable sets are subsets of the n-dimensional real Euclidean space. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem vonmblss (ph: wff) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wss (cdm (cfv X cvoln)) (cpw (co cr X cmap))) $;

--| The measure of left-closed right-open interval. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem volico2 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wceq (cfv (co A2 B2 cico) cvol) (cif (wbr A2 B2 cle) (co B2 A2 cmin) cc0)) $;

--| n-dimensional Lebesgue measurable sets are subsets of the n-dimensional real Euclidean space. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem vonmblss2 (ph: wff) (X Y: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wcel Y (cdm (cfv X cvoln))) $ >
  $ wi ph (wss Y (co cr X cmap)) $;

--| The value of the Lebesgue outer measure for subsets of the reals, expressed using ` sum^ ` . (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem ovolval2lem {k n: setvar} (ph: wff n) (F: class):
  $ wi ph (wf cn (cin cle (cxp cr cr)) F) $ >
  $ wi ph (wceq (crn (cseq caddc (ccom (ccom cabs cmin) F) c1)) (crn (cmpt n cn (csu k (co c1 (cv n) cfz) (cfv (cfv (cv k) (ccom cico F)) cvol))))) $;

--| The value of the Lebesgue outer measure for subsets of the reals, expressed using ` sum^ ` . See ~ ovolval for an alternative expression. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem ovolval2 {y1 f2: setvar} (ph: wff) (A2: class) (M: class y1 f2):
  $ wi ph (wss A2 cr) $ >
  $ wceq M (crab y1 (wrex f2 (wa (wss A2 (cuni (crn (ccom cioo (cv f2))))) (wceq (cv y1) (cfv (ccom (ccom cabs cmin) (cv f2)) csumge0))) (co (cin cle (cxp cr cr)) cn cmap)) cxr) $ >
  $ wi ph (wceq (cfv A2 covol) (cinf M cxr clt)) $;

--| ` ( voln* `` X ) ` is subadditive. Proposition 115D (a)(iv) of [Fremlin1] p. 31 . The special case of the union of 2 sets. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem ovnsubadd2lem {n: setvar} (ph: wff) (A2 B2 C X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wss A2 (co cr X cmap)) $ >
  $ wi ph (wss B2 (co cr X cmap)) $ >
  $ wceq C (cmpt n cn (cif (wceq (cv n) c1) A2 (cif (wceq (cv n) c2) B2 c0))) $ >
  $ wi ph (wbr (cfv (cun A2 B2) (cfv X covoln)) (co (cfv A2 (cfv X covoln)) (cfv B2 (cfv X covoln)) cxad) cle) $;

--| ` ( voln* `` X ) ` is subadditive. Proposition 115D (a)(iv) of [Fremlin1] p. 31 . The special case of the union of 2 sets. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem ovnsubadd2 (ph: wff) (A2 B2 X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wss A2 (co cr X cmap)) $ >
  $ wi ph (wss B2 (co cr X cmap)) $ >
  $ wi ph (wbr (cfv (cun A2 B2) (cfv X covoln)) (co (cfv A2 (cfv X covoln)) (cfv B2 (cfv X covoln)) cxad) cle) $;

--| The value of the Lebesgue outer measure for subsets of the reals, expressed using ` sum^ ` and ` vol o. (,) ` . See ~ ovolval and ~ ovolval2 for alternative expressions. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem ovolval3 {y1 f2: setvar} (ph: wff) (A2: class) (M: class y1 f2):
  $ wi ph (wss A2 cr) $ >
  $ wceq M (crab y1 (wrex f2 (wa (wss A2 (cuni (crn (ccom cioo (cv f2))))) (wceq (cv y1) (cfv (ccom (ccom cvol cioo) (cv f2)) csumge0))) (co (cin cle (cxp cr cr)) cn cmap)) cxr) $ >
  $ wi ph (wceq (cfv A2 covol) (cinf M cxr clt)) $;

--| The n-dimensional Lebesgue outer measure function is finitely sub-additive: application to a set split in two parts. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem ovnsplit (ph: wff) (A2 B2 X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wss A2 (co cr X cmap)) $ >
  $ wi ph (wbr (cfv A2 (cfv X covoln)) (co (cfv (cin A2 B2) (cfv X covoln)) (cfv (cdif A2 B2) (cfv X covoln)) cxad) cle) $;

--| |- ( ( ph /\ n e. A ) -> ( ( (,) o. G ) ` n ) = ( ( (,) o. F ) ` n ) ) (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem ovolval4lem1 {n: setvar} (ph: wff) (A2 F G: class):
  $ wi ph (wf cn (cxp cxr cxr) F) $ >
  $ wceq G (cmpt n cn (cop (cfv (cfv (cv n) F) c1st) (cif (wbr (cfv (cfv (cv n) F) c1st) (cfv (cfv (cv n) F) c2nd) cle) (cfv (cfv (cv n) F) c2nd) (cfv (cfv (cv n) F) c1st)))) $ >
  $ wceq A2 (crab n (wbr (cfv (cfv (cv n) F) c1st) (cfv (cfv (cv n) F) c2nd) cle) cn) $ >
  $ wi ph (wa (wceq (cuni (crn (ccom cioo F))) (cuni (crn (ccom cioo G)))) (wceq (ccom cvol (ccom cioo F)) (ccom cvol (ccom cioo G)))) $;

--| The value of the Lebesgue outer measure for subsets of the reals. Similar to ~ ovolval3 , but here ` f ` is may represent unordered interval bounds. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem ovolval4lem2 {y1 f2 n: setvar} (ph: wff f2 n) (A2: class n) (G: class y1 f2) (M: class y1 f2 n):
  $ wi ph (wss A2 cr) $ >
  $ wceq M (crab y1 (wrex f2 (wa (wss A2 (cuni (crn (ccom cioo (cv f2))))) (wceq (cv y1) (cfv (ccom (ccom cvol cioo) (cv f2)) csumge0))) (co (cxp cr cr) cn cmap)) cxr) $ >
  $ wceq G (cmpt n cn (cop (cfv (cfv (cv n) (cv f2)) c1st) (cif (wbr (cfv (cfv (cv n) (cv f2)) c1st) (cfv (cfv (cv n) (cv f2)) c2nd) cle) (cfv (cfv (cv n) (cv f2)) c2nd) (cfv (cfv (cv n) (cv f2)) c1st)))) $ >
  $ wi ph (wceq (cfv A2 covol) (cinf M cxr clt)) $;

--| The value of the Lebesgue outer measure for subsets of the reals. Similar to ~ ovolval3 , but here ` f ` may represent unordered interval bounds. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem ovolval4 {y1 f2: setvar} (ph: wff f2) (A2: class) (M: class y1 f2):
  $ wi ph (wss A2 cr) $ >
  $ wceq M (crab y1 (wrex f2 (wa (wss A2 (cuni (crn (ccom cioo (cv f2))))) (wceq (cv y1) (cfv (ccom (ccom cvol cioo) (cv f2)) csumge0))) (co (cxp cr cr) cn cmap)) cxr) $ >
  $ wi ph (wceq (cfv A2 covol) (cinf M cxr clt)) $;

--| ` |- ( ph -> ( sum^ `` ( n e. NN |-> ( vol `` ( ( A - ( W / ( 2 ^ n ) ` ` ) ) (,) B ) ) ) ) <_ ( ( sum^ `` ( n e. NN |-> ( vol `` ( A [,) B ) ` ` ) ) ) +e W ) ) ` . (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem ovolval5lem1 {n: setvar} (ph: wff) (A2 B2: class n) (C W: class):
  $ wi (wa ph (wcel (cv n) cn)) (wcel A2 cr) $ >
  $ wi (wa ph (wcel (cv n) cn)) (wcel B2 cr) $ >
  $ wi ph (wcel W crp) $ >
  $ wceq C (crab n (wbr A2 B2 clt) cn) $ >
  $ wi ph (wbr (cfv (cmpt n cn (cfv (co (co A2 (co W (co c2 (cv n) cexp) cdiv) cmin) B2 cioo) cvol)) csumge0) (co (cfv (cmpt n cn (cfv (co A2 B2 cico) cvol)) csumge0) W cxad) cle) $;

--| ` |- ( ( ph /\ n e. NN ) -> <. ( ( 1st `` ( F `` n ) ) - ` ` ( W / ( 2 ^ n ) ) ) , ( 2nd `` ( F `` n ) ) >. e. ( RR X. RR ) ) ` . (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem ovolval5lem2 {z f2 n: setvar} (ph: wff z f2) (A2: class n) (Q: class f2 n) (F: class z f2) (G: class z) (W: class f2) (Y: class f2 n) (Z: class n):
  $ wceq Q (crab z (wrex f2 (wa (wss A2 (cuni (crn (ccom cioo (cv f2))))) (wceq (cv z) (cfv (ccom (ccom cvol cioo) (cv f2)) csumge0))) (co (cxp cr cr) cn cmap)) cxr) $ >
  $ wi ph (wceq Y (cfv (ccom (ccom cvol cico) F) csumge0)) $ >
  $ wceq Z (cfv (ccom (ccom cvol cioo) G) csumge0) $ >
  $ wi ph (wf cn (cxp cr cr) F) $ >
  $ wi ph (wss A2 (cuni (crn (ccom cico F)))) $ >
  $ wi ph (wcel W crp) $ >
  $ wceq G (cmpt n cn (cop (co (cfv (cfv (cv n) F) c1st) (co W (co c2 (cv n) cexp) cdiv) cmin) (cfv (cfv (cv n) F) c2nd))) $ >
  $ wi ph (wrex z (wbr (cv z) (co Y W cxad) cle) Q) $;

--| The value of the Lebesgue outer measure for subsets of the reals, using covers of left-closed right-open intervals are used, instead of open intervals. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem ovolval5lem3 {y1 z f2: setvar} (A2 Q: class) (M: class f2):
  $ wceq M (crab y1 (wrex f2 (wa (wss A2 (cuni (crn (ccom cico (cv f2))))) (wceq (cv y1) (cfv (ccom (ccom cvol cico) (cv f2)) csumge0))) (co (cxp cr cr) cn cmap)) cxr) $ >
  $ wceq Q (crab z (wrex f2 (wa (wss A2 (cuni (crn (ccom cioo (cv f2))))) (wceq (cv z) (cfv (ccom (ccom cvol cioo) (cv f2)) csumge0))) (co (cxp cr cr) cn cmap)) cxr) $ >
  $ wceq (cinf Q cxr clt) (cinf M cxr clt) $;

--| The value of the Lebesgue outer measure for subsets of the reals, using covers of left-closed right-open intervals are used, instead of open intervals. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem ovolval5 {y1 f2: setvar} (ph: wff f2) (A2: class) (M: class f2):
  $ wi ph (wss A2 cr) $ >
  $ wceq M (crab y1 (wrex f2 (wa (wss A2 (cuni (crn (ccom cico (cv f2))))) (wceq (cv y1) (cfv (ccom (ccom cvol cico) (cv f2)) csumge0))) (co (cxp cr cr) cn cmap)) cxr) $ >
  $ wi ph (wceq (cfv A2 covol) (cinf M cxr clt)) $;

--| if ` F ` is a cover of ` B ` in ` RR ` , then ` I ` is the corresponding cover in the space of 1-dimensional reals. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem ovnovollem1 {i j k: setvar} (ph: wff i) (A2: class) (B2: class j k) (F: class i) (I: class) (V: class i j) (W: class i j k) (Z: class j k):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel F (co (cxp cr cr) cn cmap)) $ >
  $ wceq I (cmpt j cn (csn (cop A2 (cfv (cv j) F)))) $ >
  $ wi ph (wss B2 (cuni (crn (ccom cico F)))) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wceq Z (cfv (ccom (ccom cvol cico) F) csumge0)) $ >
  $ wi ph (wrex i (wa (wss (co B2 (csn A2) cmap) (ciun j cn (cixp k (csn A2) (cfv (cv k) (ccom cico (cfv (cv j) (cv i))))))) (wceq Z (cfv (cmpt j cn (cprod k (csn A2) (cfv (cfv (cv k) (ccom cico (cfv (cv j) (cv i)))) cvol))) csumge0))) (co (co (cxp cr cr) (csn A2) cmap) cn cmap)) $;

--| if ` I ` is a cover of ` ( B ^m { A } ) ` in ` RR^ 1 ` , then ` F ` is the corresponding cover in the reals. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem ovnovollem2 {f2 j k: setvar} (ph: wff f2) (A2: class f2) (B2: class j k) (F: class) (I V: class f2 j) (W: class f2 j k) (Z: class j k):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel I (co (co (cxp cr cr) (csn A2) cmap) cn cmap)) $ >
  $ wi ph (wss (co B2 (csn A2) cmap) (ciun j cn (cixp k (csn A2) (cfv (cv k) (ccom cico (cfv (cv j) I)))))) $ >
  $ wi ph (wceq Z (cfv (cmpt j cn (cprod k (csn A2) (cfv (cfv (cv k) (ccom cico (cfv (cv j) I))) cvol))) csumge0)) $ >
  $ wceq F (cmpt j cn (cfv A2 (cfv (cv j) I))) $ >
  $ wi ph (wrex f2 (wa (wss B2 (cuni (crn (ccom cico (cv f2))))) (wceq Z (cfv (ccom (ccom cvol cico) (cv f2)) csumge0))) (co (cxp cr cr) cn cmap)) $;

--| The 1-dimensional Lebesgue outer measure agrees with the Lebesgue outer measure on subsets of Real numbers. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem ovnovollem3 {z f2 i j k: setvar} (ph: wff) (A2 B2: class) (M: class z f2 i j k) (N: class f2 i j k) (V: class z f2 i j):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wss B2 cr) $ >
  $ wceq M (crab z (wrex i (wa (wss (co B2 (csn A2) cmap) (ciun j cn (cixp k (csn A2) (cfv (cv k) (ccom cico (cfv (cv j) (cv i))))))) (wceq (cv z) (cfv (cmpt j cn (cprod k (csn A2) (cfv (cfv (cv k) (ccom cico (cfv (cv j) (cv i)))) cvol))) csumge0))) (co (co (cxp cr cr) (csn A2) cmap) cn cmap)) cxr) $ >
  $ wceq N (crab z (wrex f2 (wa (wss B2 (cuni (crn (ccom cico (cv f2))))) (wceq (cv z) (cfv (ccom (ccom cvol cico) (cv f2)) csumge0))) (co (cxp cr cr) cn cmap)) cxr) $ >
  $ wi ph (wceq (cfv (co B2 (csn A2) cmap) (cfv (csn A2) covoln)) (cfv B2 covol)) $;

--| The 1-dimensional Lebesgue outer measure agrees with the Lebesgue outer measure on subsets of Real numbers. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem ovnovol (ph: wff) (A2 B2 V: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wss B2 cr) $ >
  $ wi ph (wceq (cfv (co B2 (csn A2) cmap) (cfv (csn A2) covoln)) (cfv B2 covol)) $;

--| If a subset ` B ` of real numbers is Lebesgue measurable, then its corresponding 1-dimensional set is measurable w.r.t. the n-dimensional Lebesgue measure, (with ` n ` equal to ` 1 ` ). (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem vonvolmbllem {y1 f2: setvar} (ph: wff y1) (A2: class y1) (B2: class f2) (V: class y1 f2) (X: class y1) (Y: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wss B2 cr) $ >
  $ wi ph (wral y1 (wceq (cfv (cv y1) covol) (co (cfv (cin (cv y1) B2) covol) (cfv (cdif (cv y1) B2) covol) cxad)) (cpw cr)) $ >
  $ wi ph (wss X (co cr (csn A2) cmap)) $ >
  $ wceq Y (ciun f2 X (crn (cv f2))) $ >
  $ wi ph (wceq (co (cfv (cin X (co B2 (csn A2) cmap)) (cfv (csn A2) covoln)) (cfv (cdif X (co B2 (csn A2) cmap)) (cfv (csn A2) covoln)) cxad) (cfv X (cfv (csn A2) covoln))) $;

--| A subset of Real numbers is Lebesgue measurable if and only if its corresponding 1-dimensional set is measurable w.r.t. the 1-dimensional Lebesgue measure. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem vonvolmbl (ph: wff) (A2 B2 V: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wss B2 cr) $ >
  $ wi ph (wb (wcel (co B2 (csn A2) cmap) (cdm (cfv (csn A2) cvoln))) (wcel B2 (cdm cvol))) $;

--| The 1-dimensional Lebesgue measure agrees with the Lebesgue measure on subsets of Real numbers. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem vonvol (ph: wff) (A2 B2 V: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 (cdm cvol)) $ >
  $ wi ph (wceq (cfv (co B2 (csn A2) cmap) (cfv (csn A2) cvoln)) (cfv B2 cvol)) $;

--| A subset ` X ` of the space of 1-dimensional Real numbers is Lebesgue measurable if and only if its projection ` Y ` on the Real numbers is Lebesgue measure. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem vonvolmbl2 {f2: setvar} (ph: wff) (A2: class) (V: class f2) (X: class) (Y: class f2):
  $ wnfc f2 Y $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wss X (co cr (csn A2) cmap)) $ >
  $ wceq Y (ciun f2 X (crn (cv f2))) $ >
  $ wi ph (wb (wcel X (cdm (cfv (csn A2) cvoln))) (wcel Y (cdm cvol))) $;

--| The 1-dimensional Lebesgue measure agrees with the Lebesgue measure on subsets of Real numbers. (Contributed by Glauco Siliprandi, 3-Mar-2021.)
theorem vonvol2 {f2: setvar} (ph: wff) (A2: class) (V: class f2) (X: class) (Y: class f2):
  $ wnfc f2 Y $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel X (cdm (cfv (csn A2) cvoln))) $ >
  $ wceq Y (ciun f2 X (crn (cv f2))) $ >
  $ wi ph (wceq (cfv X (cfv (csn A2) cvoln)) (cfv Y cvol)) $;

--| Any n-dimensional half-open interval is Lebesgue measurable. This is a substep of Proposition 115G (a) of [Fremlin1] p. 32. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem hoimbl2 {k: setvar} (ph: wff k) (A2 B2 S: class k) (X: class):
  $ wnf k ph $ >
  $ wi ph (wcel X cfn) $ >
  $ wceq S (cdm (cfv X cvoln)) $ >
  $ wi (wa ph (wcel (cv k) X)) (wcel A2 cr) $ >
  $ wi (wa ph (wcel (cv k) X)) (wcel B2 cr) $ >
  $ wi ph (wcel (cixp k X (co A2 B2 cico)) S) $;

--| The Lebesgue measure of a set is a nonnegative extended real. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem voncl (ph: wff) (A2 S X: class):
  $ wi ph (wcel X cfn) $ >
  $ wceq S (cdm (cfv X cvoln)) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel (cfv A2 (cfv X cvoln)) (co cc0 cpnf cicc)) $;

--| The Lebesgue outer measure of a multidimensional half-open interval is its dimensional volume (the product of its length in each dimension, when the dimension is nonzero). A direct consequence of Proposition 115D (b) of [Fremlin1] p. 30. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem vonhoi {x3 k a b: setvar} (ph: wff) (A2 B2: class x3) (I L: class x3 k a b) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wf X cr B2) $ >
  $ wceq I (cixp k X (co (cfv (cv k) A2) (cfv (cv k) B2) cico)) $ >
  $ wceq L (cmpt x3 cfn (cmpo a b (co cr (cv x3) cmap) (co cr (cv x3) cmap) (cif (wceq (cv x3) c0) cc0 (cprod k (cv x3) (cfv (co (cfv (cv k) (cv a)) (cfv (cv k) (cv b)) cico) cvol))))) $ >
  $ wi ph (wceq (cfv I (cfv X cvoln)) (co A2 B2 (cfv X L))) $;

--| The Lebesgue measure of a set is an extended real. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem vonxrcl (ph: wff) (A2 S X: class):
  $ wi ph (wcel X cfn) $ >
  $ wceq S (cdm (cfv X cvoln)) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel (cfv A2 (cfv X cvoln)) cxr) $;

--| A n-dimensional open interval is a subset of the half-open interval with the same bounds. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem ioosshoi {k: setvar} (A2 B2 X: class k):
  $ wss (cixp k X (co A2 B2 cioo)) (cixp k X (co A2 B2 cico)) $;

--| The Lebesgue outer measure of a multidimensional half-open interval when the dimension of the space is nonzero. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem vonn0hoi {k: setvar} (ph: wff) (A2 B2: class) (I: class k) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wne X c0) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wf X cr B2) $ >
  $ wceq I (cixp k X (co (cfv (cv k) A2) (cfv (cv k) B2) cico)) $ >
  $ wi ph (wceq (cfv I (cfv X cvoln)) (cprod k X (cfv (co (cfv (cv k) A2) (cfv (cv k) B2) cico) cvol))) $;

--| The Lebesgue measure (for the zero dimensional space of reals) of every measurable set is zero. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem von0val (ph: wff) (A2: class):
  $ wi ph (wcel A2 (cdm (cfv c0 cvoln))) $ >
  $ wi ph (wceq (cfv A2 (cfv c0 cvoln)) cc0) $;

--| The Lebesgue measure of a n-dimensional half-open interval is a real number. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem vonhoire {k: setvar} (ph: wff k) (A2 B2: class k) (X: class):
  $ wnf k ph $ >
  $ wi ph (wcel X cfn) $ >
  $ wi (wa ph (wcel (cv k) X)) (wcel A2 cr) $ >
  $ wi (wa ph (wcel (cv k) X)) (wcel B2 cr) $ >
  $ wi ph (wcel (cfv (cixp k X (co A2 B2 cico)) (cfv X cvoln)) cr) $;

--| A n-dimensional closed interval expressed as the indexed intersection of half-open intervals. One side of the double inclusion. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem iinhoiicclem {k n: setvar} (ph: wff k) (A2 B2: class k) (F X: class):
  $ wnf k ph $ >
  $ wi (wa ph (wcel (cv k) X)) (wcel A2 cr) $ >
  $ wi (wa ph (wcel (cv k) X)) (wcel B2 cr) $ >
  $ wi ph (wcel F (ciin n cn (cixp k X (co A2 (co B2 (co c1 (cv n) cdiv) caddc) cico)))) $ >
  $ wi ph (wcel F (cixp k X (co A2 B2 cicc))) $;

--| A n-dimensional closed interval expressed as the indexed intersection of half-open intervals. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem iinhoiicc {k n: setvar} (ph: wff k) (A2 B2: class k) (X: class):
  $ wnf k ph $ >
  $ wi (wa ph (wcel (cv k) X)) (wcel A2 cr) $ >
  $ wi (wa ph (wcel (cv k) X)) (wcel B2 cr) $ >
  $ wi ph (wceq (ciin n cn (cixp k X (co A2 (co B2 (co c1 (cv n) cdiv) caddc) cico))) (cixp k X (co A2 B2 cicc))) $;

--| A n-dimensional open interval expressed as the indexed union of half-open intervals. One side of the double inclusion. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem iunhoiioolem {k n: setvar} (ph: wff k) (A2 B2: class k n) (C: class k) (F: class) (X: class n):
  $ wnf k ph $ >
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wne X c0) $ >
  $ wi (wa ph (wcel (cv k) X)) (wcel A2 cr) $ >
  $ wi (wa ph (wcel (cv k) X)) (wcel B2 cxr) $ >
  $ wi ph (wcel F (cixp k X (co A2 B2 cioo))) $ >
  $ wceq C (cinf (crn (cmpt k X (co (cfv (cv k) F) A2 cmin))) cr clt) $ >
  $ wi ph (wcel F (ciun n cn (cixp k X (co (co A2 (co c1 (cv n) cdiv) caddc) B2 cico)))) $;

--| A n-dimensional open interval expressed as the indexed union of half-open intervals. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem iunhoiioo {k n: setvar} (ph: wff k) (A2 B2: class k) (X: class):
  $ wnf k ph $ >
  $ wi ph (wcel X cfn) $ >
  $ wi (wa ph (wcel (cv k) X)) (wcel A2 cr) $ >
  $ wi (wa ph (wcel (cv k) X)) (wcel B2 cxr) $ >
  $ wi ph (wceq (ciun n cn (cixp k X (co (co A2 (co c1 (cv n) cdiv) caddc) B2 cico))) (cixp k X (co A2 B2 cioo))) $;

--| Any n-dimensional open interval is Lebesgue measurable. This is the first statement in Proposition 115G (c) of [Fremlin1] p. 32. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem ioovonmbl {i: setvar} (ph: wff) (A2 B2: class) (S: class i) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wceq S (cdm (cfv X cvoln)) $ >
  $ wi ph (wf X cxr A2) $ >
  $ wi ph (wf X cxr B2) $ >
  $ wi ph (wcel (cixp i X (co (cfv (cv i) A2) (cfv (cv i) B2) cioo)) S) $;

--| Any n-dimensional closed interval is Lebesgue measurable. This is the second statement in Proposition 115G (c) of [Fremlin1] p. 32. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem iccvonmbllem {i n: setvar} (ph: wff) (A2 B2: class i) (C D: class n) (S: class i) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wceq S (cdm (cfv X cvoln)) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wf X cr B2) $ >
  $ wceq C (cmpt n cn (cmpt i X (co (cfv (cv i) A2) (co c1 (cv n) cdiv) cmin))) $ >
  $ wceq D (cmpt n cn (cmpt i X (co (cfv (cv i) B2) (co c1 (cv n) cdiv) caddc))) $ >
  $ wi ph (wcel (cixp i X (co (cfv (cv i) A2) (cfv (cv i) B2) cicc)) S) $;

--| Any n-dimensional closed interval is Lebesgue measurable. This is the second statement in Proposition 115G (c) of [Fremlin1] p. 32. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem iccvonmbl {i: setvar} (ph: wff) (A2 B2: class) (S: class i) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wceq S (cdm (cfv X cvoln)) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wf X cr B2) $ >
  $ wi ph (wcel (cixp i X (co (cfv (cv i) A2) (cfv (cv i) B2) cicc)) S) $;

--| The sequence of the measures of the half-open intervals converges to the measure of their union. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem vonioolem1 {k n: setvar} (ph: wff) (A2: class k) (B2: class) (C: class n) (D: class k n) (S T: class k) (E N: class k n) (X Z: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wf X cr B2) $ >
  $ wi ph (wne X c0) $ >
  $ wi (wa ph (wcel (cv k) X)) (wbr (cfv (cv k) A2) (cfv (cv k) B2) clt) $ >
  $ wceq C (cmpt n cn (cmpt k X (co (cfv (cv k) A2) (co c1 (cv n) cdiv) caddc))) $ >
  $ wceq D (cmpt n cn (cixp k X (co (cfv (cv k) (cfv (cv n) C)) (cfv (cv k) B2) cico))) $ >
  $ wceq S (cmpt n cn (cfv (cfv (cv n) D) (cfv X cvoln))) $ >
  $ wceq T (cmpt n cn (cprod k X (co (cfv (cv k) B2) (cfv (cv k) (cfv (cv n) C)) cmin))) $ >
  $ wceq E (cinf (crn (cmpt k X (co (cfv (cv k) B2) (cfv (cv k) A2) cmin))) cr clt) $ >
  $ wceq N (co (cfv (co c1 E cdiv) cfl) c1 caddc) $ >
  $ wceq Z (cfv N cuz) $ >
  $ wi ph (wbr S (cprod k X (co (cfv (cv k) B2) (cfv (cv k) A2) cmin)) cli) $;

--| The n-dimensional Lebesgue measure of open intervals. This is the first statement in Proposition 115G (d) of [Fremlin1] p. 32. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem vonioolem2 {k n: setvar} (ph: wff) (A2 B2 C: class) (D I: class k) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wf X cr B2) $ >
  $ wi ph (wne X c0) $ >
  $ wi (wa ph (wcel (cv k) X)) (wbr (cfv (cv k) A2) (cfv (cv k) B2) clt) $ >
  $ wceq I (cixp k X (co (cfv (cv k) A2) (cfv (cv k) B2) cioo)) $ >
  $ wceq C (cmpt n cn (cmpt k X (co (cfv (cv k) A2) (co c1 (cv n) cdiv) caddc))) $ >
  $ wceq D (cmpt n cn (cixp k X (co (cfv (cv k) (cfv (cv n) C)) (cfv (cv k) B2) cico))) $ >
  $ wi ph (wceq (cfv I (cfv X cvoln)) (cprod k X (co (cfv (cv k) B2) (cfv (cv k) A2) cmin))) $;

--| The n-dimensional Lebesgue measure of an open interval. This is the first statement in Proposition 115G (d) of [Fremlin1] p. 32. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem vonioo {x3 k a b: setvar} (ph: wff) (A2 B2: class x3) (I: class x3 k a b) (L: class x3 a b) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wf X cr B2) $ >
  $ wceq I (cixp k X (co (cfv (cv k) A2) (cfv (cv k) B2) cioo)) $ >
  $ wceq L (cmpt x3 cfn (cmpo a b (co cr (cv x3) cmap) (co cr (cv x3) cmap) (cif (wceq (cv x3) c0) cc0 (cprod k (cv x3) (cfv (co (cfv (cv k) (cv a)) (cfv (cv k) (cv b)) cico) cvol))))) $ >
  $ wi ph (wceq (cfv I (cfv X cvoln)) (co A2 B2 (cfv X L))) $;

--| The sequence of the measures of the half-open intervals converges to the measure of their intersection. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem vonicclem1 {k n: setvar} (ph: wff) (A2: class) (B2: class k) (C: class n) (D S: class k n) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wf X cr B2) $ >
  $ wi ph (wne X c0) $ >
  $ wi (wa ph (wcel (cv k) X)) (wbr (cfv (cv k) A2) (cfv (cv k) B2) cle) $ >
  $ wceq C (cmpt n cn (cmpt k X (co (cfv (cv k) B2) (co c1 (cv n) cdiv) caddc))) $ >
  $ wceq D (cmpt n cn (cixp k X (co (cfv (cv k) A2) (cfv (cv k) (cfv (cv n) C)) cico))) $ >
  $ wceq S (cmpt n cn (cfv (cfv (cv n) D) (cfv X cvoln))) $ >
  $ wi ph (wbr S (cprod k X (co (cfv (cv k) B2) (cfv (cv k) A2) cmin)) cli) $;

--| The n-dimensional Lebesgue measure of closed intervals. This is the second statement in Proposition 115G (d) of [Fremlin1] p. 32. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem vonicclem2 {k n: setvar} (ph: wff) (A2 B2 C: class) (D I: class k) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wf X cr B2) $ >
  $ wi ph (wne X c0) $ >
  $ wi (wa ph (wcel (cv k) X)) (wbr (cfv (cv k) A2) (cfv (cv k) B2) cle) $ >
  $ wceq I (cixp k X (co (cfv (cv k) A2) (cfv (cv k) B2) cicc)) $ >
  $ wceq C (cmpt n cn (cmpt k X (co (cfv (cv k) B2) (co c1 (cv n) cdiv) caddc))) $ >
  $ wceq D (cmpt n cn (cixp k X (co (cfv (cv k) A2) (cfv (cv k) (cfv (cv n) C)) cico))) $ >
  $ wi ph (wceq (cfv I (cfv X cvoln)) (cprod k X (co (cfv (cv k) B2) (cfv (cv k) A2) cmin))) $;

--| The n-dimensional Lebesgue measure of a closed interval. This is the second statement in Proposition 115G (d) of [Fremlin1] p. 32. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem vonicc {x3 k a b: setvar} (ph: wff) (A2 B2: class x3) (I L: class x3 k a b) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wf X cr B2) $ >
  $ wceq I (cixp k X (co (cfv (cv k) A2) (cfv (cv k) B2) cicc)) $ >
  $ wceq L (cmpt x3 cfn (cmpo a b (co cr (cv x3) cmap) (co cr (cv x3) cmap) (cif (wceq (cv x3) c0) cc0 (cprod k (cv x3) (cfv (co (cfv (cv k) (cv a)) (cfv (cv k) (cv b)) cico) cvol))))) $ >
  $ wi ph (wceq (cfv I (cfv X cvoln)) (co A2 B2 (cfv X L))) $;

--| A n-dimensional singleton is Lebesgue measurable. This is the first statement in Proposition 115G (e) of [Fremlin1] p. 32. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem snvonmbl (ph: wff) (A2 X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wcel A2 (co cr X cmap)) $ >
  $ wi ph (wcel (csn A2) (cdm (cfv X cvoln))) $;

--| The n-dimensional Lebesgue measure of an open interval when the dimension of the space is nonzero. This is the first statement in Proposition 115G (d) of [Fremlin1] p. 32. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem vonn0ioo {k: setvar} (ph: wff) (A2 B2: class) (I: class k) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wne X c0) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wf X cr B2) $ >
  $ wceq I (cixp k X (co (cfv (cv k) A2) (cfv (cv k) B2) cioo)) $ >
  $ wi ph (wceq (cfv I (cfv X cvoln)) (cprod k X (cfv (co (cfv (cv k) A2) (cfv (cv k) B2) cico) cvol))) $;

--| The n-dimensional Lebesgue measure of a closed interval, when the dimension of the space is nonzero. This is the second statement in Proposition 115G (d) of [Fremlin1] p. 32. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem vonn0icc {k: setvar} (ph: wff) (A2 B2: class) (I: class k) (X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wne X c0) $ >
  $ wi ph (wf X cr A2) $ >
  $ wi ph (wf X cr B2) $ >
  $ wceq I (cixp k X (co (cfv (cv k) A2) (cfv (cv k) B2) cicc)) $ >
  $ wi ph (wceq (cfv I (cfv X cvoln)) (cprod k X (cfv (co (cfv (cv k) A2) (cfv (cv k) B2) cicc) cvol))) $;

--| Any n-dimensional countable set is Lebesgue measurable. This is the second statement in Proposition 115G (e) of [Fremlin1] p. 32. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem ctvonmbl (ph: wff) (A2 X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wss A2 (co cr X cmap)) $ >
  $ wi ph (wbr A2 com cdom) $ >
  $ wi ph (wcel A2 (cdm (cfv X cvoln))) $;

--| The n-dimensional Lebesgue measure of an open interval when the dimension of the space is nonzero. This is the first statement in Proposition 115G (d) of [Fremlin1] p. 32. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem vonn0ioo2 {k: setvar} (ph: wff k) (A2 B2 I: class k) (X: class):
  $ wnf k ph $ >
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wne X c0) $ >
  $ wi (wa ph (wcel (cv k) X)) (wcel A2 cr) $ >
  $ wi (wa ph (wcel (cv k) X)) (wcel B2 cr) $ >
  $ wceq I (cixp k X (co A2 B2 cioo)) $ >
  $ wi ph (wceq (cfv I (cfv X cvoln)) (cprod k X (cfv (co A2 B2 cioo) cvol))) $;

--| The n-dimensional Lebesgue measure of a singleton is zero. This is the first statement in Proposition 115G (e) of [Fremlin1] p. 32. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem vonsn (ph: wff) (A2 X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wcel A2 (co cr X cmap)) $ >
  $ wi ph (wceq (cfv (csn A2) (cfv X cvoln)) cc0) $;

--| The n-dimensional Lebesgue measure of a closed interval, when the dimension of the space is nonzero. This is the second statement in Proposition 115G (d) of [Fremlin1] p. 32. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem vonn0icc2 {k: setvar} (ph: wff k) (A2 B2 I: class k) (X: class):
  $ wnf k ph $ >
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wne X c0) $ >
  $ wi (wa ph (wcel (cv k) X)) (wcel A2 cr) $ >
  $ wi (wa ph (wcel (cv k) X)) (wcel B2 cr) $ >
  $ wceq I (cixp k X (co A2 B2 cicc)) $ >
  $ wi ph (wceq (cfv I (cfv X cvoln)) (cprod k X (cfv (co A2 B2 cicc) cvol))) $;

--| The n-dimensional Lebesgue measure of any countable set is zero. This is the second statement in Proposition 115G (e) of [Fremlin1] p. 32. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem vonct (ph: wff) (A2 X: class):
  $ wi ph (wcel X cfn) $ >
  $ wi ph (wss A2 (co cr X cmap)) $ >
  $ wi ph (wbr A2 com cdom) $ >
  $ wi ph (wceq (cfv A2 (cfv X cvoln)) cc0) $;

--| There are non-measurable sets (the Axiom of Choice is used, in the invoked ~ weth ). (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem vitali2:
  $ wpss (cdm cvol) (cpw cr) $;

--| Extend class notation with the class of real-valued measurable functions w.r.t. sigma-algebras.
term csmblfn: class;

--| Define a real-valued measurable function w.r.t. a given sigma-algebra. See Definition 121C of [Fremlin1] p. 36 and Definition 135E (b) of [Fremlin1] p. 80 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
axiom df_smblfn {f2 s1 a: setvar}:
  $ wceq csmblfn (cmpt s1 csalg (crab f2 (wral a (wcel (cima (ccnv (cv f2)) (co cmnf (cv a) cioo)) (co (cv s1) (cdm (cv f2)) crest)) cr) (co cr (cuni (cv s1)) cpm))) $;

--| Given a real-valued function, the preimage of an open interval, unbounded below, with upper bound ` -oo ` , is the empty set. (Contributed by Glauco Siliprandi, 15-Dec-2024.)
theorem pimltmnf2f {x3: setvar} (ph: wff x3) (A2 F: class x3):
  $ wnfc x3 F $ >
  $ wnfc x3 A2 $ >
  $ wi ph (wf A2 cr F) $ >
  $ wi ph (wceq (crab x3 (wbr (cfv (cv x3) F) cmnf clt) A2) c0) $;

--| Given a real-valued function, the preimage of an open interval, unbounded below, with upper bound ` -oo ` , is the empty set. (Contributed by Glauco Siliprandi, 26-Jun-2021.) (Revised by Glauco Siliprandi, 15-Dec-2024.)
theorem pimltmnf2 {x3: setvar} (ph: wff x3) (A2: class) (F: class x3):
  $ wnfc x3 F $ >
  $ wi ph (wf A2 cr F) $ >
  $ wi ph (wceq (crab x3 (wbr (cfv (cv x3) F) cmnf clt) A2) c0) $;

--| The preimage of a right-open, unbounded below interval, is the complement of a left-closed unbounded above interval. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem preimagelt {x3: setvar} (ph: wff x3) (A2: class) (B2 C: class x3):
  $ wnf x3 ph $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cxr) $ >
  $ wi ph (wcel C cxr) $ >
  $ wi ph (wceq (cdif A2 (crab x3 (wbr C B2 cle) A2)) (crab x3 (wbr B2 C clt) A2)) $;

--| The preimage of a left-open, unbounded above interval, is the complement of a right-closed unbounded below interval. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem preimalegt {x3: setvar} (ph: wff x3) (A2: class) (B2 C: class x3):
  $ wnf x3 ph $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cxr) $ >
  $ wi ph (wcel C cxr) $ >
  $ wi ph (wceq (cdif A2 (crab x3 (wbr B2 C cle) A2)) (crab x3 (wbr C B2 clt) A2)) $;

--| Given a constant function, its preimage with respect to an unbounded below, open interval, with upper bound less than or equal to the constant, is the empty set. Second part of Proposition 121E (a) of [Fremlin1] p. 37 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem pimconstlt0 {x3: setvar} (ph: wff x3) (A2: class) (B2 C F: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wcel B2 cr) $ >
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi ph (wcel C cxr) $ >
  $ wi ph (wbr C B2 cle) $ >
  $ wi ph (wceq (crab x3 (wbr (cfv (cv x3) F) C clt) A2) c0) $;

--| Given a constant function, its preimage with respect to an unbounded below, open interval, with upper bound larger than the constant, is the whole domain. First part of Proposition 121E (a) of [Fremlin1] p. 37 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem pimconstlt1 {x3: setvar} (ph: wff x3) (A2: class) (B2 C F: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wcel B2 cr) $ >
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi ph (wbr B2 C clt) $ >
  $ wi ph (wceq (crab x3 (wbr (cfv (cv x3) F) C clt) A2) A2) $;

--| Given a real-valued function, the preimage of an open interval, unbounded below, with upper bound ` +oo ` , is the whole domain. (Contributed by Glauco Siliprandi, 20-Dec-2024.)
theorem pimltpnff {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wnf x3 ph $ >
  $ wnfc x3 A2 $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi ph (wceq (crab x3 (wbr B2 cpnf clt) A2) A2) $;

--| Given a real-valued function, the preimage of an open interval, unbounded below, with upper bound ` +oo ` , is the whole domain. (Contributed by Glauco Siliprandi, 26-Jun-2021.) (Revised by Glauco Siliprandi, 20-Dec-2024.)
theorem pimltpnf {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3):
  $ wnf x3 ph $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi ph (wceq (crab x3 (wbr B2 cpnf clt) A2) A2) $;

--| Given a real-valued function, the preimage of an open interval, unbounded above, with lower bound ` +oo ` , is the empty set. (Contributed by Glauco Siliprandi, 15-Dec-2021.)
theorem pimgtpnf2f {x3: setvar} (ph: wff x3) (A2 F: class x3):
  $ wnfc x3 F $ >
  $ wnfc x3 A2 $ >
  $ wi ph (wf A2 cr F) $ >
  $ wi ph (wceq (crab x3 (wbr cpnf (cfv (cv x3) F) clt) A2) c0) $;

--| Given a real-valued function, the preimage of an open interval, unbounded above, with lower bound ` +oo ` , is the empty set. (Contributed by Glauco Siliprandi, 26-Jun-2021.) (Revised by Glauco Siliprandi, 15-Dec-2024.)
theorem pimgtpnf2 {x3: setvar} (ph: wff x3) (A2: class) (F: class x3):
  $ wnfc x3 F $ >
  $ wi ph (wf A2 cr F) $ >
  $ wi ph (wceq (crab x3 (wbr cpnf (cfv (cv x3) F) clt) A2) c0) $;

--| If all the preimages of left-closed, unbounded below intervals, belong to a sigma-algebra, then all the preimages of right-open, unbounded below intervals, belong to the sigma-algebra. (iv) implies (i) in Proposition 121B of [Fremlin1] p. 36. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem salpreimagelt {x3 a: setvar} (ph: wff x3 a) (A2: class) (B2: class x3) (C: class) (S: class x3):
  $ wnf x3 ph $ >
  $ wnf a ph $ >
  $ wi ph (wcel S csalg) $ >
  $ wceq A2 (cuni S) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cxr) $ >
  $ wi (wa ph (wcel (cv a) cr)) (wcel (crab x3 (wbr (cv a) B2 cle) A2) S) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wcel (crab x3 (wbr B2 C clt) A2) S) $;

--| The preimage of an unbounded below, open interval, with positive upper bound, for the reciprocal function. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem pimrecltpos {x3: setvar} (ph: wff x3) (A2 B2 C: class x3):
  $ wnf x3 ph $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wne B2 cc0) $ >
  $ wi ph (wcel C crp) $ >
  $ wi ph (wceq (crab x3 (wbr (co c1 B2 cdiv) C clt) A2) (cun (crab x3 (wbr (co c1 C cdiv) B2 clt) A2) (crab x3 (wbr B2 cc0 clt) A2))) $;

--| If all the preimages of right-closed, unbounded below intervals, belong to a sigma-algebra, then all the preimages of left-open, unbounded above intervals, belong to the sigma-algebra. (ii) implies (iii) in Proposition 121B of [Fremlin1] p. 35. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem salpreimalegt {x3 a: setvar} (ph: wff x3 a) (A2: class) (B2: class x3) (C: class) (S: class x3):
  $ wnf x3 ph $ >
  $ wnf a ph $ >
  $ wi ph (wcel S csalg) $ >
  $ wceq A2 (cuni S) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cxr) $ >
  $ wi (wa ph (wcel (cv a) cr)) (wcel (crab x3 (wbr B2 (cv a) cle) A2) S) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wcel (crab x3 (wbr C B2 clt) A2) S) $;

--| The preimage of an open interval is the intersection of the preimage of an unbounded below open interval and an unbounded above open interval. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem pimiooltgt {x3: setvar} (ph: wff x3) (A2: class) (B2 R L: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wcel L cxr) $ >
  $ wi ph (wcel R cxr) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cxr) $ >
  $ wi ph (wceq (crab x3 (wcel B2 (co L R cioo)) A2) (cin (crab x3 (wbr B2 R clt) A2) (crab x3 (wbr L B2 clt) A2))) $;

--| Preimage of an open interval, unbounded below. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem preimaicomnf {x3: setvar} (ph: wff) (A2 B2 F: class):
  $ wi ph (wf A2 cxr F) $ >
  $ wi ph (wcel B2 cxr) $ >
  $ wi ph (wceq (cima (ccnv F) (co cmnf B2 cico)) (crab x3 (wbr (cfv (cv x3) F) B2 clt) A2)) $;

--| Given a real-valued function, the preimage of an open interval, unbounded below, with upper bound ` +oo ` , is the whole domain. (Contributed by Glauco Siliprandi, 15-Dec-2024.)
theorem pimltpnf2f {x3: setvar} (ph: wff x3) (A2 F: class x3):
  $ wnfc x3 F $ >
  $ wnfc x3 A2 $ >
  $ wi ph (wf A2 cr F) $ >
  $ wi ph (wceq (crab x3 (wbr (cfv (cv x3) F) cpnf clt) A2) A2) $;

--| Given a real-valued function, the preimage of an open interval, unbounded below, with upper bound ` +oo ` , is the whole domain. (Contributed by Glauco Siliprandi, 26-Jun-2021.) (Revised by Glauco Siliprandi, 15-Dec-2024.)
theorem pimltpnf2 {x3: setvar} (ph: wff x3) (A2: class) (F: class x3):
  $ wnfc x3 F $ >
  $ wi ph (wf A2 cr F) $ >
  $ wi ph (wceq (crab x3 (wbr (cfv (cv x3) F) cpnf clt) A2) A2) $;

--| Given a real-valued function, the preimage of an open interval, unbounded above, with lower bound ` -oo ` , is the whole domain. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem pimgtmnf2 {x3: setvar} (ph: wff x3) (A2: class) (F: class x3):
  $ wnfc x3 F $ >
  $ wi ph (wf A2 cr F) $ >
  $ wi ph (wceq (crab x3 (wbr cmnf (cfv (cv x3) F) clt) A2) A2) $;

--| Given a nonincreasing function, the preimage of an unbounded above, open interval, when the supremum of the preimage belongs to the preimage. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem pimdecfgtioc {x3 y1: setvar} (ph: wff x3 y1) (A2: class) (R: class y1) (S: class x3) (F: class) (I: class y1) (Y: class x3 y1):
  $ wnf x3 ph $ >
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wf A2 cxr F) $ >
  $ wi ph (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) cle) (wbr (cfv (cv y1) F) (cfv (cv x3) F) cle)) A2) A2) $ >
  $ wi ph (wcel R cxr) $ >
  $ wceq Y (crab x3 (wbr R (cfv (cv x3) F) clt) A2) $ >
  $ wceq S (csup Y cxr clt) $ >
  $ wi ph (wcel S Y) $ >
  $ wceq I (co cmnf S cioc) $ >
  $ wi ph (wceq Y (cin I A2)) $;

--| Given a nondecreasing function, the preimage of an unbounded below, open interval, when the supremum of the preimage belongs to the preimage. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem pimincfltioc {x3 y1: setvar} (ph: wff x3 y1) (A2: class) (R: class y1) (S F I: class) (Y: class x3 y1):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wf A2 cxr F) $ >
  $ wi ph (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) cle) (wbr (cfv (cv x3) F) (cfv (cv y1) F) cle)) A2) A2) $ >
  $ wi ph (wcel R cxr) $ >
  $ wceq Y (crab x3 (wbr (cfv (cv x3) F) R clt) A2) $ >
  $ wceq S (csup Y cxr clt) $ >
  $ wi ph (wcel S Y) $ >
  $ wceq I (co cmnf S cioc) $ >
  $ wi ph (wceq Y (cin I A2)) $;

--| Given a nondecreasing function, the preimage of an unbounded below, open interval, when the supremum of the preimage does not belong to the preimage. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem pimdecfgtioo {x3 y1: setvar} (ph: wff x3 y1) (A2 R: class) (S: class x3 y1) (F I: class) (Y: class x3):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wf A2 cxr F) $ >
  $ wi ph (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) cle) (wbr (cfv (cv y1) F) (cfv (cv x3) F) cle)) A2) A2) $ >
  $ wi ph (wcel R cxr) $ >
  $ wceq Y (crab x3 (wbr R (cfv (cv x3) F) clt) A2) $ >
  $ wceq S (csup Y cxr clt) $ >
  $ wi ph (wn (wcel S Y)) $ >
  $ wceq I (co cmnf S cioo) $ >
  $ wi ph (wceq Y (cin I A2)) $;

--| Given a nondecreasing function, the preimage of an unbounded below, open interval, when the supremum of the preimage does not belong to the preimage. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem pimincfltioo {x3 y1: setvar} (ph: wff x3 y1) (A2 R: class) (S: class x3 y1) (F I: class) (Y: class x3):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wf A2 cxr F) $ >
  $ wi ph (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) cle) (wbr (cfv (cv x3) F) (cfv (cv y1) F) cle)) A2) A2) $ >
  $ wi ph (wcel R cxr) $ >
  $ wceq Y (crab x3 (wbr (cfv (cv x3) F) R clt) A2) $ >
  $ wceq S (csup Y cxr clt) $ >
  $ wi ph (wn (wcel S Y)) $ >
  $ wceq I (co cmnf S cioo) $ >
  $ wi ph (wceq Y (cin I A2)) $;

--| Preimage of an open interval, unbounded below. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem preimaioomnf {x3: setvar} (ph: wff) (A2 B2 F: class):
  $ wi ph (wf A2 cr F) $ >
  $ wi ph (wcel B2 cxr) $ >
  $ wi ph (wceq (cima (ccnv F) (co cmnf B2 cioo)) (crab x3 (wbr (cfv (cv x3) F) B2 clt) A2)) $;

--| A preimage of a left-closed, unbounded above interval, expressed as an indexed intersection of preimages of open, unbounded above intervals. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem preimageiingt {x3 n: setvar} (ph: wff x3) (A2 B2 C: class x3):
  $ wnf x3 ph $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cxr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wceq (crab x3 (wbr C B2 cle) A2) (ciin n cn (crab x3 (wbr (co C (co c1 (cv n) cdiv) cmin) B2 clt) A2))) $;

--| A preimage of a left-open, right-closed, unbounded below interval, expressed as an indexed intersection of preimages of open, unbound below intervals. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem preimaleiinlt {x3 n: setvar} (ph: wff x3) (A2 B2 C: class x3):
  $ wnf x3 ph $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cxr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wceq (crab x3 (wbr B2 C cle) A2) (ciin n cn (crab x3 (wbr B2 (co C (co c1 (cv n) cdiv) caddc) clt) A2))) $;

--| Given a real-valued function, the preimage of an open interval, unbounded above, with lower bound ` -oo ` , is the whole domain. (Contributed by Glauco Siliprandi, 20-Dec-2024.)
theorem pimgtmnff {x3: setvar} (ph: wff x3) (A2 B2: class x3):
  $ wnf x3 ph $ >
  $ wnfc x3 A2 $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi ph (wceq (crab x3 (wbr cmnf B2 clt) A2) A2) $;

--| Given a real-valued function, the preimage of an open interval, unbounded above, with lower bound ` -oo ` , is the whole domain. (Contributed by Glauco Siliprandi, 26-Jun-2021.) (Revised by Glauco Siliprandi, 20-Dec-2024.)
theorem pimgtmnf {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3):
  $ wnf x3 ph $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi ph (wceq (crab x3 (wbr cmnf B2 clt) A2) A2) $;

--| The preimage of an unbounded below, open interval, with negative upper bound, for the reciprocal function. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem pimrecltneg {x3: setvar} (ph: wff x3) (A2 B2 C: class x3):
  $ wnf x3 ph $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wne B2 cc0) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wbr C cc0 clt) $ >
  $ wi ph (wceq (crab x3 (wbr (co c1 B2 cdiv) C clt) A2) (crab x3 (wcel B2 (co (co c1 C cdiv) cc0 cioo)) A2)) $;

--| If all the preimages of left-open, unbounded above intervals, belong to a sigma-algebra, then all the preimages of left-closed, unbounded above intervals, belong to the sigma-algebra. (iii) implies (iv) in Proposition 121B of [Fremlin1] p. 35. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem salpreimagtge {x3 a: setvar} (ph: wff x3 a) (A2 B2: class x3) (C: class) (S: class x3):
  $ wnf x3 ph $ >
  $ wnf a ph $ >
  $ wi ph (wcel S csalg) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cxr) $ >
  $ wi (wa ph (wcel (cv a) cr)) (wcel (crab x3 (wbr (cv a) B2 clt) A2) S) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wcel (crab x3 (wbr C B2 cle) A2) S) $;

--| If all the preimages of right-open, unbounded below intervals, belong to a sigma-algebra, then all the preimages of right-closed, unbounded below intervals, belong to the sigma-algebra. (i) implies (ii) in Proposition 121B of [Fremlin1] p. 35. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem salpreimaltle {x3 a: setvar} (ph: wff x3 a) (A2 B2: class x3) (C: class) (S: class x3):
  $ wnf x3 ph $ >
  $ wnf a ph $ >
  $ wi ph (wcel S csalg) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cxr) $ >
  $ wi (wa ph (wcel (cv a) cr)) (wcel (crab x3 (wbr B2 (cv a) clt) A2) S) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wcel (crab x3 (wbr B2 C cle) A2) S) $;

--| The predicate " ` F ` is a real-valued measurable function w.r.t. to the sigma-algebra ` S ` ". A function is measurable iff the preimages of all open intervals unbounded below are in the subspace sigma-algebra induced by its domain. The domain of ` F ` is required to be a subset of the underlying set of ` S ` . Definition 121C of [Fremlin1] p. 36, and Proposition 121B (i) of [Fremlin1] p. 35 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem issmflem {x3 a: setvar} (ph: wff) (D S F: class):
  $ wi ph (wcel S csalg) $ >
  $ wceq D (cdm F) $ >
  $ wi ph (wb (wcel F (cfv S csmblfn)) (w3a (wss D (cuni S)) (wf D cr F) (wral a (wcel (crab x3 (wbr (cfv (cv x3) F) (cv a) clt) D) (co S D crest)) cr))) $;

--| The predicate " ` F ` is a real-valued measurable function w.r.t. to the sigma-algebra ` S ` ". A function is measurable iff the preimages of all open intervals unbounded below are in the subspace sigma-algebra induced by its domain. The domain of ` F ` is required to be a subset of the underlying set of ` S ` . Definition 121C of [Fremlin1] p. 36, and Proposition 121B (i) of [Fremlin1] p. 35 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem issmf {x3 a: setvar} (ph: wff x3 a) (D: class) (S: class x3) (F: class):
  $ wi ph (wcel S csalg) $ >
  $ wceq D (cdm F) $ >
  $ wi ph (wb (wcel F (cfv S csmblfn)) (w3a (wss D (cuni S)) (wf D cr F) (wral a (wcel (crab x3 (wbr (cfv (cv x3) F) (cv a) clt) D) (co S D crest)) cr))) $;

--| If all the preimages of right-closed, unbounded below intervals, belong to a sigma-algebra, then all the preimages of right-open, unbounded below intervals, belong to the sigma-algebra. (ii) implies (i) in Proposition 121B of [Fremlin1] p. 36. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem salpreimalelt {x3 a: setvar} (ph: wff x3 a) (A2: class) (B2: class x3) (C: class) (S: class x3):
  $ wnf x3 ph $ >
  $ wnf a ph $ >
  $ wi ph (wcel S csalg) $ >
  $ wceq A2 (cuni S) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cxr) $ >
  $ wi (wa ph (wcel (cv a) cr)) (wcel (crab x3 (wbr B2 (cv a) cle) A2) S) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wcel (crab x3 (wbr B2 C clt) A2) S) $;

--| If all the preimages of lef-open, unbounded above intervals, belong to a sigma-algebra, then all the preimages of right-open, unbounded below intervals, belong to the sigma-algebra. (iii) implies (i) in Proposition 121B of [Fremlin1] p. 36. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem salpreimagtlt {x3 a: setvar} (ph: wff x3 a) (A2: class) (B2: class x3) (C: class) (S: class x3):
  $ wnf x3 ph $ >
  $ wnf a ph $ >
  $ wi ph (wcel S csalg) $ >
  $ wceq A2 (cuni S) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cxr) $ >
  $ wi (wa ph (wcel (cv a) cr)) (wcel (crab x3 (wbr (cv a) B2 clt) A2) S) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wcel (crab x3 (wbr B2 C clt) A2) S) $;

--| Given a function measurable w.r.t. to a sigma-algebra, the preimage of an open interval unbounded below is in the subspace sigma-algebra induced by its domain. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smfpreimalt {x3: setvar} (ph: wff x3) (A2 D: class) (S: class x3) (F: class):
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel F (cfv S csmblfn)) $ >
  $ wceq D (cdm F) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel (crab x3 (wbr (cfv (cv x3) F) A2 clt) D) (co S D crest)) $;

--| A function measurable w.r.t. to a sigma-algebra, is actually a function. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smff (ph: wff) (D S F: class):
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel F (cfv S csmblfn)) $ >
  $ wceq D (cdm F) $ >
  $ wi ph (wf D cr F) $;

--| The domain of a function measurable w.r.t. to a sigma-algebra, is a subset of the set underlying the sigma-algebra. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smfdmss (ph: wff) (D S F: class):
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel F (cfv S csmblfn)) $ >
  $ wceq D (cdm F) $ >
  $ wi ph (wss D (cuni S)) $;

--| The predicate " ` F ` is a real-valued measurable function w.r.t. to the sigma-algebra ` S ` ". A function is measurable iff the preimages of all open intervals unbounded below are in the subspace sigma-algebra induced by its domain. The domain of ` F ` is required to be a subset of the underlying set of ` S ` . Definition 121C of [Fremlin1] p. 36, and Proposition 121B (i) of [Fremlin1] p. 35 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem issmff {x3 a: setvar} (ph: wff x3 a) (D S F: class x3):
  $ wnfc x3 F $ >
  $ wi ph (wcel S csalg) $ >
  $ wceq D (cdm F) $ >
  $ wi ph (wb (wcel F (cfv S csmblfn)) (w3a (wss D (cuni S)) (wf D cr F) (wral a (wcel (crab x3 (wbr (cfv (cv x3) F) (cv a) clt) D) (co S D crest)) cr))) $;

--| A sufficient condition for " ` F ` being a real-valued measurable function w.r.t. to the sigma-algebra ` S ` ". (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem issmfd {x3 a: setvar} (ph: wff x3 a) (D: class a) (S: class x3) (F: class):
  $ wnf a ph $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wss D (cuni S)) $ >
  $ wi ph (wf D cr F) $ >
  $ wi (wa ph (wcel (cv a) cr)) (wcel (crab x3 (wbr (cfv (cv x3) F) (cv a) clt) D) (co S D crest)) $ >
  $ wi ph (wcel F (cfv S csmblfn)) $;

--| Given a function measurable w.r.t. to a sigma-algebra, the preimage of an open interval unbounded below is in the subspace sigma-algebra induced by its domain. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smfpreimaltf {x3: setvar} (ph: wff x3) (A2: class) (D S F: class x3):
  $ wnfc x3 F $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel F (cfv S csmblfn)) $ >
  $ wceq D (cdm F) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel (crab x3 (wbr (cfv (cv x3) F) A2 clt) D) (co S D crest)) $;

--| A sufficient condition for " ` F ` being a measurable function w.r.t. to the sigma-algebra ` S ` ". (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem issmfdf {x3 a: setvar} (ph: wff x3 a) (D: class a) (S F: class x3):
  $ wnfc x3 F $ >
  $ wnf a ph $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wss D (cuni S)) $ >
  $ wi ph (wf D cr F) $ >
  $ wi (wa ph (wcel (cv a) cr)) (wcel (crab x3 (wbr (cfv (cv x3) F) (cv a) clt) D) (co S D crest)) $ >
  $ wi ph (wcel F (cfv S csmblfn)) $;

--| The restriction of a sigma-measurable function, is sigma-measurable. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem sssmf (ph: wff) (B2 S F: class):
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel F (cfv S csmblfn)) $ >
  $ wi ph (wcel (cres F B2) (cfv S csmblfn)) $;

--| A real-valued measurable function is a sigma-measurable function (w.r.t. the Lebesgue measure on the Reals). (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem mbfresmf (ph: wff) (S F: class):
  $ wi ph (wcel F cmbf) $ >
  $ wi ph (wss (crn F) cr) $ >
  $ wceq S (cdm cvol) $ >
  $ wi ph (wcel F (cfv S csmblfn)) $;

--| A continuous function is measurable. Proposition 121D (b) of [Fremlin1] p. 36 is a special case of this theorem, where the topology on the domain is induced by the standard topology on n-dimensional Real numbers. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem cnfsmf (ph: wff) (S F J K: class):
  $ wi ph (wcel J ctop) $ >
  $ wceq K (cfv (crn cioo) ctg) $ >
  $ wi ph (wcel F (co (co J (cdm F) crest) K ccn)) $ >
  $ wceq S (cfv J csalgen) $ >
  $ wi ph (wcel F (cfv S csmblfn)) $;

--| A nondecreasing function is Borel measurable. Proposition 121D (c) of [Fremlin1] p. 36 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem incsmflem {x3 y1 b: setvar} (ph: wff x3 y1 b) (A2: class) (B2: class x3 y1) (C: class b) (D: class) (R: class b) (E: class) (F: class b) (J: class x3 y1 b) (Y: class x3):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wf A2 cxr F) $ >
  $ wi ph (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) cle) (wbr (cfv (cv x3) F) (cfv (cv y1) F) cle)) A2) A2) $ >
  $ wceq J (cfv (crn cioo) ctg) $ >
  $ wceq B2 (cfv J csalgen) $ >
  $ wi ph (wcel R cxr) $ >
  $ wceq Y (crab x3 (wbr (cfv (cv x3) F) R clt) A2) $ >
  $ wceq C (csup Y cxr clt) $ >
  $ wceq D (co cmnf C cioo) $ >
  $ wceq E (co cmnf C cioc) $ >
  $ wi ph (wrex b (wceq Y (cin (cv b) A2)) B2) $;

--| A real-valued, nondecreasing function is Borel measurable. Proposition 121D (c) of [Fremlin1] p. 36 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem incsmf {x3 y1: setvar} (ph: wff x3 y1) (A2: class) (B2: class x3 y1) (F: class) (J: class x3 y1):
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wf A2 cr F) $ >
  $ wi ph (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) cle) (wbr (cfv (cv x3) F) (cfv (cv y1) F) cle)) A2) A2) $ >
  $ wceq J (cfv (crn cioo) ctg) $ >
  $ wceq B2 (cfv J csalgen) $ >
  $ wi ph (wcel F (cfv B2 csmblfn)) $;

--| If a function is measurable w.r.t. to a sigma-algebra, then it is measurable w.r.t. to a larger sigma-algebra. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smfsssmf (ph: wff) (R S F: class):
  $ wi ph (wcel R csalg) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wss R S) $ >
  $ wi ph (wcel F (cfv R csmblfn)) $ >
  $ wi ph (wcel F (cfv S csmblfn)) $;

--| The predicate " ` F ` is a real-valued measurable function w.r.t. to the sigma-algebra ` S ` ". A function is measurable iff the preimages of all right-closed intervals unbounded below are in the subspace sigma-algebra induced by its domain. The domain of ` F ` is required to be a subset of the underlying set of ` S ` . Definition 121C of [Fremlin1] p. 36, and Proposition 121B (ii) of [Fremlin1] p. 35 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem issmflelem {x3 a: setvar} (ph: wff x3 a) (D S F: class):
  $ wnf x3 ph $ >
  $ wnf a ph $ >
  $ wi ph (wcel S csalg) $ >
  $ wceq D (cdm F) $ >
  $ wi ph (wss D (cuni S)) $ >
  $ wi ph (wf D cr F) $ >
  $ wi (wa ph (wcel (cv a) cr)) (wcel (crab x3 (wbr (cfv (cv x3) F) (cv a) cle) D) (co S D crest)) $ >
  $ wi ph (wcel F (cfv S csmblfn)) $;

--| The predicate " ` F ` is a real-valued measurable function w.r.t. to the sigma-algebra ` S ` ". A function is measurable iff the preimages of all right-closed intervals unbounded below are in the subspace sigma-algebra induced by its domain. The domain of ` F ` is required to be b subset of the underlying set of ` S ` . Definition 121C of [Fremlin1] p. 36, and Proposition 121B (ii) of [Fremlin1] p. 35 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem issmfle {x3 a: setvar} (ph: wff x3 a) (D: class) (S: class x3) (F: class):
  $ wi ph (wcel S csalg) $ >
  $ wceq D (cdm F) $ >
  $ wi ph (wb (wcel F (cfv S csmblfn)) (w3a (wss D (cuni S)) (wf D cr F) (wral a (wcel (crab x3 (wbr (cfv (cv x3) F) (cv a) cle) D) (co S D crest)) cr))) $;

--| Given a function measurable w.r.t. to a sigma-algebra, the preimage of an open interval unbounded below is in the subspace sigma-algebra induced by its domain. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smfpimltmpt {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3) (R: class) (S V: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wcel S csalg) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) (cfv S csmblfn)) $ >
  $ wi ph (wcel R cr) $ >
  $ wi ph (wcel (crab x3 (wbr B2 R clt) A2) (co S A2 crest)) $;

--| Given a function measurable w.r.t. to a sigma-algebra, the preimage of an open interval unbounded below is in the subspace sigma-algebra induced by its domain. (Contributed by Glauco Siliprandi, 26-Jun-2021.) (Revised by Glauco Siliprandi, 15-Dec-2024.)
theorem smfpimltxr {x3: setvar} (ph: wff x3) (A2: class) (D S F: class x3):
  $ wnfc x3 F $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel F (cfv S csmblfn)) $ >
  $ wceq D (cdm F) $ >
  $ wi ph (wcel A2 cxr) $ >
  $ wi ph (wcel (crab x3 (wbr (cfv (cv x3) F) A2 clt) D) (co S D crest)) $;

--| A sufficient condition for " ` F ` being a measurable function w.r.t. to the sigma-algebra ` S ` ". (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem issmfdmpt {x3 a: setvar} (ph: wff x3 a) (A2: class) (B2 S: class x3):
  $ wnf x3 ph $ >
  $ wnf a ph $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wss A2 (cuni S)) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi (wa ph (wcel (cv a) cr)) (wcel (crab x3 (wbr B2 (cv a) clt) A2) (co S A2 crest)) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) (cfv S csmblfn)) $;

--| Given a sigma-algebra over a base set X, every partial real-valued constant function is measurable. Proposition 121E (a) of [Fremlin1] p. 37 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smfconst {x3: setvar} (ph: wff x3) (A2 B2: class) (S F: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wss A2 (cuni S)) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wceq F (cmpt x3 A2 B2) $ >
  $ wi ph (wcel F (cfv S csmblfn)) $;

--| The restriction of a sigma-measurable function is sigma-measurable. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem sssmfmpt {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3) (C: class) (S: class x3):
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) (cfv S csmblfn)) $ >
  $ wi ph (wss C A2) $ >
  $ wi ph (wcel (cmpt x3 C B2) (cfv S csmblfn)) $;

--| A function, continuous from the standard topology on the space of n-dimensional reals to the standard topology on the reals, is Borel measurable. Proposition 121D (b) of [Fremlin1] p. 36 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem cnfrrnsmf (ph: wff) (B2 F J K X: class):
  $ wi ph (wcel X cfn) $ >
  $ wceq J (cfv (cfv X crrx) ctopn) $ >
  $ wceq K (cfv (crn cioo) ctg) $ >
  $ wi ph (wcel F (co (co J (cdm F) crest) K ccn)) $ >
  $ wceq B2 (cfv J csalgen) $ >
  $ wi ph (wcel F (cfv B2 csmblfn)) $;

--| The identity function is Borel sigma-measurable. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smfid {x3: setvar} (ph: wff) (A2: class) (B2 J: class x3):
  $ wceq J (cfv (crn cioo) ctg) $ >
  $ wceq B2 (cfv J csalgen) $ >
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wcel (cmpt x3 A2 (cv x3)) (cfv B2 csmblfn)) $;

--| A Borel measurable function is Lebesgue measurable. Proposition 121D (a) of [Fremlin1] p. 36 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem bormflebmf (ph: wff) (B2 F L X: class):
  $ wi ph (wcel X cfn) $ >
  $ wceq B2 (cfv (cfv (cfv X crrx) ctopn) csalgen) $ >
  $ wceq L (cdm (cfv X cvoln)) $ >
  $ wi ph (wcel F (cfv B2 csmblfn)) $ >
  $ wi ph (wcel F (cfv L csmblfn)) $;

--| Given a function measurable w.r.t. to a sigma-algebra, the preimage of a closed interval unbounded below is in the subspace sigma-algebra induced by its domain. See Proposition 121B (ii) of [Fremlin1] p. 35 (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smfpreimale {x3: setvar} (ph: wff x3) (A2 D: class) (S: class x3) (F: class):
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel F (cfv S csmblfn)) $ >
  $ wceq D (cdm F) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel (crab x3 (wbr (cfv (cv x3) F) A2 cle) D) (co S D crest)) $;

--| The predicate " ` F ` is a real-valued measurable function w.r.t. to the sigma-algebra ` S ` ". A function is measurable iff the preimages of all left-open intervals unbounded above are in the subspace sigma-algebra induced by its domain. The domain of ` F ` is required to be a subset of the underlying set of ` S ` . Definition 121C of [Fremlin1] p. 36, and Proposition 121B (iii) of [Fremlin1] p. 35 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem issmfgtlem {x3 a: setvar} (ph: wff x3 a) (D S F: class):
  $ wnf x3 ph $ >
  $ wnf a ph $ >
  $ wi ph (wcel S csalg) $ >
  $ wceq D (cdm F) $ >
  $ wi ph (wss D (cuni S)) $ >
  $ wi ph (wf D cr F) $ >
  $ wi ph (wral a (wcel (crab x3 (wbr (cv a) (cfv (cv x3) F) clt) D) (co S D crest)) cr) $ >
  $ wi ph (wcel F (cfv S csmblfn)) $;

--| The predicate " ` F ` is a real-valued measurable function w.r.t. to the sigma-algebra ` S ` ". A function is measurable iff the preimages of all left-open intervals unbounded above are in the subspace sigma-algebra induced by its domain. The domain of ` F ` is required to be b subset of the underlying set of ` S ` . Definition 121C of [Fremlin1] p. 36, and Proposition 121B (iii) of [Fremlin1] p. 35 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem issmfgt {x3 a: setvar} (ph: wff x3 a) (D: class) (S: class x3) (F: class):
  $ wi ph (wcel S csalg) $ >
  $ wceq D (cdm F) $ >
  $ wi ph (wb (wcel F (cfv S csmblfn)) (w3a (wss D (cuni S)) (wf D cr F) (wral a (wcel (crab x3 (wbr (cv a) (cfv (cv x3) F) clt) D) (co S D crest)) cr))) $;

--| A sufficient condition for " ` F ` being a real-valued measurable function w.r.t. to the sigma-algebra ` S ` ". (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem issmfled {x3 a: setvar} (ph: wff x3 a) (D: class a) (S: class x3) (F: class):
  $ wnf a ph $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wss D (cuni S)) $ >
  $ wi ph (wf D cr F) $ >
  $ wi (wa ph (wcel (cv a) cr)) (wcel (crab x3 (wbr (cfv (cv x3) F) (cv a) cle) D) (co S D crest)) $ >
  $ wi ph (wcel F (cfv S csmblfn)) $;

--| Given a function measurable w.r.t. to a sigma-algebra, the preimage of an open interval unbounded below is in the subspace sigma-algebra induced by its domain. (Contributed by Glauco Siliprandi, 20-Dec-2024.)
theorem smfpimltxrmptf {x3: setvar} (ph: wff x3) (A2 B2: class x3) (R: class) (S V: class x3):
  $ wnf x3 ph $ >
  $ wnfc x3 A2 $ >
  $ wi ph (wcel S csalg) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) (cfv S csmblfn)) $ >
  $ wi ph (wcel R cxr) $ >
  $ wi ph (wcel (crab x3 (wbr B2 R clt) A2) (co S A2 crest)) $;

--| Given a function measurable w.r.t. to a sigma-algebra, the preimage of an open interval unbounded below is in the subspace sigma-algebra induced by its domain. (Contributed by Glauco Siliprandi, 26-Jun-2021.) (Revised by Glauco Siliprandi, 20-Dec-2024.)
theorem smfpimltxrmpt {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3) (R: class) (S V: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wcel S csalg) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) (cfv S csmblfn)) $ >
  $ wi ph (wcel R cxr) $ >
  $ wi ph (wcel (crab x3 (wbr B2 R clt) A2) (co S A2 crest)) $;

--| A constant function, with non-lebesgue-measurable domain is a sigma-measurable functions (w.r.t. the Lebesgue measure on the Reals) but it is not a measurable functions ( w.r.t. to ~ df-mbf ). (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smfmbfcex {x3: setvar} (ph: wff) (S F: class x3) (X: class):
  $ wceq S (cdm cvol) $ >
  $ wi ph (wss X cr) $ >
  $ wi ph (wn (wcel X S)) $ >
  $ wceq F (cmpt x3 X cc0) $ >
  $ wi ph (wa (wcel F (cfv S csmblfn)) (wn (wcel F cmbf))) $;

--| A sufficient condition for " ` F ` being a measurable function w.r.t. to the sigma-algebra ` S ` ". (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem issmfgtd {x3 a: setvar} (ph: wff x3 a) (D: class a) (S: class x3) (F: class):
  $ wnf a ph $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wss D (cuni S)) $ >
  $ wi ph (wf D cr F) $ >
  $ wi (wa ph (wcel (cv a) cr)) (wcel (crab x3 (wbr (cv a) (cfv (cv x3) F) clt) D) (co S D crest)) $ >
  $ wi ph (wcel F (cfv S csmblfn)) $;

--| Given a function measurable w.r.t. to a sigma-algebra, the preimage of an open interval unbounded above is in the subspace sigma-algebra induced by its domain. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smfpreimagt {x3: setvar} (ph: wff x3) (A2 D: class) (S: class x3) (F: class):
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel F (cfv S csmblfn)) $ >
  $ wceq D (cdm F) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel (crab x3 (wbr A2 (cfv (cv x3) F) clt) D) (co S D crest)) $;

--| Given the sum of two functions, the preimage of an unbounded below, open interval, expressed as the countable union of intersections of preimages of both functions. Proposition 121E (b) of [Fremlin1] p. 37 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smfaddlem1 {x3 q p: setvar} (ph: wff x3) (A2 B2 C D R: class x3) (K: class q p):
  $ wnf x3 ph $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi (wa ph (wcel (cv x3) C)) (wcel D cr) $ >
  $ wi ph (wcel R cr) $ >
  $ wceq K (cmpt p cq (crab q (wbr (co (cv p) (cv q) caddc) R clt) cq)) $ >
  $ wi ph (wceq (crab x3 (wbr (co B2 D caddc) R clt) (cin A2 C)) (ciun p cq (ciun q (cfv (cv p) K) (crab x3 (wa (wbr B2 (cv p) clt) (wbr D (cv q) clt)) (cin A2 C))))) $;

--| The sum of two sigma-measurable functions is measurable. Proposition 121E (b) of [Fremlin1] p. 37 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smfaddlem2 {x3 q p: setvar} (ph: wff x3) (A2: class) (B2: class x3) (C: class) (D R S: class x3) (K: class p) (V: class x3 q p):
  $ wnf x3 ph $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi (wa ph (wcel (cv x3) C)) (wcel D cr) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) (cfv S csmblfn)) $ >
  $ wi ph (wcel (cmpt x3 C D) (cfv S csmblfn)) $ >
  $ wi ph (wcel R cr) $ >
  $ wceq K (cmpt p cq (crab q (wbr (co (cv p) (cv q) caddc) R clt) cq)) $ >
  $ wi ph (wcel (crab x3 (wbr (co B2 D caddc) R clt) (cin A2 C)) (co S (cin A2 C) crest)) $;

--| The sum of two sigma-measurable functions is measurable. Proposition 121E (b) of [Fremlin1] p. 37 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smfadd {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3) (C: class) (D S V: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi (wa ph (wcel (cv x3) C)) (wcel D cr) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) (cfv S csmblfn)) $ >
  $ wi ph (wcel (cmpt x3 C D) (cfv S csmblfn)) $ >
  $ wi ph (wcel (cmpt x3 (cin A2 C) (co B2 D caddc)) (cfv S csmblfn)) $;

--| A nonincreasing function is Borel measurable. Proposition 121D (c) of [Fremlin1] p. 36 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem decsmflem {x3 y1 b: setvar} (ph: wff x3 y1 b) (A2: class) (B2: class x3 y1) (C: class x3 b) (D: class) (R: class b) (E: class y1) (F: class b) (J: class x3 y1 b) (Y: class x3):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wf A2 cxr F) $ >
  $ wi ph (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) cle) (wbr (cfv (cv y1) F) (cfv (cv x3) F) cle)) A2) A2) $ >
  $ wceq J (cfv (crn cioo) ctg) $ >
  $ wceq B2 (cfv J csalgen) $ >
  $ wi ph (wcel R cxr) $ >
  $ wceq Y (crab x3 (wbr R (cfv (cv x3) F) clt) A2) $ >
  $ wceq C (csup Y cxr clt) $ >
  $ wceq D (co cmnf C cioo) $ >
  $ wceq E (co cmnf C cioc) $ >
  $ wi ph (wrex b (wceq Y (cin (cv b) A2)) B2) $;

--| A real-valued, nonincreasing function is Borel measurable. Proposition 121D (c) of [Fremlin1] p. 36 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem decsmf {x3 y1: setvar} (ph: wff x3 y1) (A2: class) (B2: class x3 y1) (F: class) (J: class x3 y1):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wf A2 cr F) $ >
  $ wi ph (wral x3 (wral y1 (wi (wbr (cv x3) (cv y1) cle) (wbr (cfv (cv y1) F) (cfv (cv x3) F) cle)) A2) A2) $ >
  $ wceq J (cfv (crn cioo) ctg) $ >
  $ wceq B2 (cfv J csalgen) $ >
  $ wi ph (wcel F (cfv B2 csmblfn)) $;

--| Given a function measurable w.r.t. to a sigma-algebra, the preimage of an open interval unbounded above is in the subspace sigma-algebra induced by its domain. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smfpreimagtf {x3: setvar} (ph: wff x3) (A2: class) (D S F: class x3):
  $ wnfc x3 F $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel F (cfv S csmblfn)) $ >
  $ wceq D (cdm F) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel (crab x3 (wbr A2 (cfv (cv x3) F) clt) D) (co S D crest)) $;

--| The predicate " ` F ` is a real-valued measurable function w.r.t. to the sigma-algebra ` S ` ". A function is measurable iff the preimages of all left-closed intervals unbounded above are in the subspace sigma-algebra induced by its domain. The domain of ` F ` is required to be a subset of the underlying set of ` S ` . Definition 121C of [Fremlin1] p. 36, and Proposition 121B (iv) of [Fremlin1] p. 36 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem issmfgelem {x3 a: setvar} (ph: wff x3 a) (D S F: class):
  $ wnf x3 ph $ >
  $ wnf a ph $ >
  $ wi ph (wcel S csalg) $ >
  $ wceq D (cdm F) $ >
  $ wi ph (wss D (cuni S)) $ >
  $ wi ph (wf D cr F) $ >
  $ wi ph (wral a (wcel (crab x3 (wbr (cv a) (cfv (cv x3) F) cle) D) (co S D crest)) cr) $ >
  $ wi ph (wcel F (cfv S csmblfn)) $;

--| The predicate " ` F ` is a real-valued measurable function w.r.t. to the sigma-algebra ` S ` ". A function is measurable iff the preimages of all left-closed intervals unbounded above are in the subspace sigma-algebra induced by its domain. The domain of ` F ` is required to be b subset of the underlying set of ` S ` . Definition 121C of [Fremlin1] p. 36, and Proposition 121B (iv) of [Fremlin1] p. 36 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem issmfge {x3 a: setvar} (ph: wff x3 a) (D: class) (S: class x3) (F: class):
  $ wi ph (wcel S csalg) $ >
  $ wceq D (cdm F) $ >
  $ wi ph (wb (wcel F (cfv S csmblfn)) (w3a (wss D (cuni S)) (wf D cr F) (wral a (wcel (crab x3 (wbr (cv a) (cfv (cv x3) F) cle) D) (co S D crest)) cr))) $;

--| Lemma for the proof that the limit of a sequence of sigma-measurable functions is sigma-measurable, Proposition 121F (a) of [Fremlin1] p. 38 . This lemma proves that ` ( D i^i I ) ` is in the subspace sigma-algebra induced by ` D ` . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smflimlem1 {x3 k m n s1 r: setvar} (ph: wff x3 s1) (A2: class x3 k m n s1 r) (C: class x3 k m n s1) (D: class x3 k m n s1 r) (P: class x3 k m n s1) (S: class x3 r) (F: class k m n s1 r) (H I M: class x3 k m n s1 r) (Z: class s1 r):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wceq D (crab x3 (wcel (cmpt m Z (cfv (cv x3) (cfv (cv m) F))) (cdm cli)) (ciun n Z (ciin m (cfv (cv n) cuz) (cdm (cfv (cv m) F))))) $ >
  $ wceq P (cmpo m k Z cn (crab s1 (wceq (crab x3 (wbr (cfv (cv x3) (cfv (cv m) F)) (co A2 (co c1 (cv k) cdiv) caddc) clt) (cdm (cfv (cv m) F))) (cin (cv s1) (cdm (cfv (cv m) F)))) S)) $ >
  $ wceq H (cmpo m k Z cn (cfv (co (cv m) (cv k) P) C)) $ >
  $ wceq I (ciin k cn (ciun n Z (ciin m (cfv (cv n) cuz) (co (cv m) (cv k) H)))) $ >
  $ wi (wa ph (wcel (cv r) (crn P))) (wcel (cfv (cv r) C) (cv r)) $ >
  $ wi ph (wcel (cin D I) (co S D crest)) $;

--| Lemma for the proof that the limit of sigma-measurable functions is sigma-measurable, Proposition 121F (a) of [Fremlin1] p. 38 . This lemma proves one-side of the double inclusion for the proof that the preimages of right-closed, unbounded-below intervals are in the subspace sigma-algebra induced by ` D ` . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smflimlem2 {x3 k m n s1 r: setvar} (ph: wff s1) (A2: class x3 r) (C: class x3 k m n s1) (D: class x3 s1 r) (P: class x3 k m n s1) (S: class x3 k m n r) (F: class k m r) (G: class x3 s1 r) (H: class x3 k m n r) (I: class k m n s1 r) (M: class x3 k m n s1 r) (Z: class s1 r):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wf Z (cfv S csmblfn) F) $ >
  $ wceq D (crab x3 (wcel (cmpt m Z (cfv (cv x3) (cfv (cv m) F))) (cdm cli)) (ciun n Z (ciin m (cfv (cv n) cuz) (cdm (cfv (cv m) F))))) $ >
  $ wceq G (cmpt x3 D (cfv (cmpt m Z (cfv (cv x3) (cfv (cv m) F))) cli)) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wceq P (cmpo m k Z cn (crab s1 (wceq (crab x3 (wbr (cfv (cv x3) (cfv (cv m) F)) (co A2 (co c1 (cv k) cdiv) caddc) clt) (cdm (cfv (cv m) F))) (cin (cv s1) (cdm (cfv (cv m) F)))) S)) $ >
  $ wceq H (cmpo m k Z cn (cfv (co (cv m) (cv k) P) C)) $ >
  $ wceq I (ciin k cn (ciun n Z (ciin m (cfv (cv n) cuz) (co (cv m) (cv k) H)))) $ >
  $ wi (wa ph (wcel (cv r) (crn P))) (wcel (cfv (cv r) C) (cv r)) $ >
  $ wi ph (wss (crab x3 (wbr (cfv (cv x3) G) A2 cle) D) (cin D I)) $;

--| The limit of sigma-measurable functions is sigma-measurable. Proposition 121F (a) of [Fremlin1] p. 38 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smflimlem3 {x3 y1 i k m n s1: setvar} (ph: wff x3 n s1) (A2: class y1 i n) (C: class x3 i n) (D: class x3 y1 i k m n s1) (P: class x3 i n) (S: class x3 y1 i n) (F: class y1) (H: class x3 y1 s1) (I: class x3 y1 i k m n s1) (K: class n) (M: class x3 y1 i k n s1) (X: class y1 n s1) (Y: class x3 y1 i k m n s1) (Z: class y1 s1):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi (wa ph (wcel (cv m) Z)) (wcel (cfv (cv m) F) (cfv S csmblfn)) $ >
  $ wceq D (crab x3 (wcel (cmpt m Z (cfv (cv x3) (cfv (cv m) F))) (cdm cli)) (ciun n Z (ciin m (cfv (cv n) cuz) (cdm (cfv (cv m) F))))) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wceq P (cmpo m k Z cn (crab s1 (wceq (crab x3 (wbr (cfv (cv x3) (cfv (cv m) F)) (co A2 (co c1 (cv k) cdiv) caddc) clt) (cdm (cfv (cv m) F))) (cin (cv s1) (cdm (cfv (cv m) F)))) S)) $ >
  $ wceq H (cmpo m k Z cn (cfv (co (cv m) (cv k) P) C)) $ >
  $ wceq I (ciin k cn (ciun n Z (ciin m (cfv (cv n) cuz) (co (cv m) (cv k) H)))) $ >
  $ wi (wa ph (wcel (cv y1) (crn P))) (wcel (cfv (cv y1) C) (cv y1)) $ >
  $ wi ph (wcel X (cin D I)) $ >
  $ wi ph (wcel K cn) $ >
  $ wi ph (wcel Y crp) $ >
  $ wi ph (wbr (co c1 K cdiv) Y clt) $ >
  $ wi ph (wrex m (wral i (wa (wcel X (cdm (cfv (cv i) F))) (wbr (cfv X (cfv (cv i) F)) (co A2 Y caddc) clt)) (cfv (cv m) cuz)) Z) $;

--| Lemma for the proof that the limit of sigma-measurable functions is sigma-measurable, Proposition 121F (a) of [Fremlin1] p. 38 . This lemma proves one-side of the double inclusion for the proof that the preimages of right-closed, unbounded-below intervals are in the subspace sigma-algebra induced by ` D ` . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smflimlem4 {x3 k m n s1 r: setvar} (ph: wff s1) (A2: class n r) (C: class x3 n) (D: class s1) (P: class x3 n) (S: class x3 n r) (F: class r) (G: class x3 k n s1 r) (H: class x3 s1 r) (I: class n s1) (M: class x3 k n s1 r) (Z: class s1 r):
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wf Z (cfv S csmblfn) F) $ >
  $ wceq D (crab x3 (wcel (cmpt m Z (cfv (cv x3) (cfv (cv m) F))) (cdm cli)) (ciun n Z (ciin m (cfv (cv n) cuz) (cdm (cfv (cv m) F))))) $ >
  $ wceq G (cmpt x3 D (cfv (cmpt m Z (cfv (cv x3) (cfv (cv m) F))) cli)) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wceq P (cmpo m k Z cn (crab s1 (wceq (crab x3 (wbr (cfv (cv x3) (cfv (cv m) F)) (co A2 (co c1 (cv k) cdiv) caddc) clt) (cdm (cfv (cv m) F))) (cin (cv s1) (cdm (cfv (cv m) F)))) S)) $ >
  $ wceq H (cmpo m k Z cn (cfv (co (cv m) (cv k) P) C)) $ >
  $ wceq I (ciin k cn (ciun n Z (ciin m (cfv (cv n) cuz) (co (cv m) (cv k) H)))) $ >
  $ wi (wa ph (wcel (cv r) (crn P))) (wcel (cfv (cv r) C) (cv r)) $ >
  $ wi ph (wss (cin D I) (crab x3 (wbr (cfv (cv x3) G) A2 cle) D)) $;

--| Lemma for the proof that the limit of sigma-measurable functions is sigma-measurable, Proposition 121F (a) of [Fremlin1] p. 38 . This lemma proves that the preimages of right-closed, unbounded-below intervals are in the subspace sigma-algebra induced by ` D ` . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smflimlem5 {x3 k m n s1 r: setvar} (ph: wff s1) (A2: class r) (C: class x3 n) (D: class s1) (P: class x3 n) (S: class x3 r) (F: class r) (G: class x3 s1 r) (H: class x3 r) (I: class n s1) (M: class x3 k n s1 r) (Z: class s1 r):
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wf Z (cfv S csmblfn) F) $ >
  $ wceq D (crab x3 (wcel (cmpt m Z (cfv (cv x3) (cfv (cv m) F))) (cdm cli)) (ciun n Z (ciin m (cfv (cv n) cuz) (cdm (cfv (cv m) F))))) $ >
  $ wceq G (cmpt x3 D (cfv (cmpt m Z (cfv (cv x3) (cfv (cv m) F))) cli)) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wceq P (cmpo m k Z cn (crab s1 (wceq (crab x3 (wbr (cfv (cv x3) (cfv (cv m) F)) (co A2 (co c1 (cv k) cdiv) caddc) clt) (cdm (cfv (cv m) F))) (cin (cv s1) (cdm (cfv (cv m) F)))) S)) $ >
  $ wceq H (cmpo m k Z cn (cfv (co (cv m) (cv k) P) C)) $ >
  $ wceq I (ciin k cn (ciun n Z (ciin m (cfv (cv n) cuz) (co (cv m) (cv k) H)))) $ >
  $ wi (wa ph (wcel (cv r) (crn P))) (wcel (cfv (cv r) C) (cv r)) $ >
  $ wi ph (wcel (crab x3 (wbr (cfv (cv x3) G) A2 cle) D) (co S D crest)) $;

--| Lemma for the proof that the limit of sigma-measurable functions is sigma-measurable, Proposition 121F (a) of [Fremlin1] p. 38 . This lemma proves that the preimages of right-closed, unbounded-below intervals are in the subspace sigma-algebra induced by ` D ` . The proof uses ~ fnrndomnum rather than ~ fnrndomg , and so does not require ~ ax-ac . (Contributed by Glauco Siliprandi, 26-Jun-2021.) (Revised by Vincent Gonzalez, 30-Aug-2026.)
theorem smflimlem6 {x3 k m n s1: setvar} (ph: wff s1) (A2: class) (D: class s1) (P: class) (S: class x3) (F: class) (G: class x3 s1) (M: class x3 k n s1) (Z: class):
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wf Z (cfv S csmblfn) F) $ >
  $ wceq D (crab x3 (wcel (cmpt m Z (cfv (cv x3) (cfv (cv m) F))) (cdm cli)) (ciun n Z (ciin m (cfv (cv n) cuz) (cdm (cfv (cv m) F))))) $ >
  $ wceq G (cmpt x3 D (cfv (cmpt m Z (cfv (cv x3) (cfv (cv m) F))) cli)) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wceq P (cmpo m k Z cn (crab s1 (wceq (crab x3 (wbr (cfv (cv x3) (cfv (cv m) F)) (co A2 (co c1 (cv k) cdiv) caddc) clt) (cdm (cfv (cv m) F))) (cin (cv s1) (cdm (cfv (cv m) F)))) S)) $ >
  $ wi ph (wcel (crab x3 (wbr (cfv (cv x3) G) A2 cle) D) (co S D crest)) $;

--| The limit of sigma-measurable functions is sigma-measurable. Proposition 121F (a) of [Fremlin1] p. 38 . Notice that every function in the sequence can have a different (partial) domain, and the domain of convergence can be decidedly irregular (Remark 121G of [Fremlin1] p. 39 ). (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smflim {x3 m n: setvar} (ph: wff x3) (D: class x3 m n) (S: class x3) (F: class x3 m) (G M: class x3 m n) (Z: class):
  $ wnfc m F $ >
  $ wnfc x3 F $ >
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wf Z (cfv S csmblfn) F) $ >
  $ wceq D (crab x3 (wcel (cmpt m Z (cfv (cv x3) (cfv (cv m) F))) (cdm cli)) (ciun n Z (ciin m (cfv (cv n) cuz) (cdm (cfv (cv m) F))))) $ >
  $ wceq G (cmpt x3 D (cfv (cmpt m Z (cfv (cv x3) (cfv (cv m) F))) cli)) $ >
  $ wi ph (wcel G (cfv S csmblfn)) $;

--| The sigma-measurable functions (w.r.t. the Lebesgue measure on the Reals) are not a subset of the measurable functions. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem nsssmfmbflem {x3 f2: setvar} (ph: wff f2) (S F: class x3) (X: class f2):
  $ wceq S (cdm cvol) $ >
  $ wi ph (wss X cr) $ >
  $ wi ph (wn (wcel X S)) $ >
  $ wceq F (cmpt x3 X cc0) $ >
  $ wi ph (wex f2 (wa (wcel (cv f2) (cfv S csmblfn)) (wn (wcel (cv f2) cmbf)))) $;

--| The sigma-measurable functions (w.r.t. the Lebesgue measure on the Reals) are not a subset of the measurable functions. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem nsssmfmbf (S: class):
  $ wceq S (cdm cvol) $ >
  $ wn (wss (cfv S csmblfn) cmbf) $;

--| Given a function measurable w.r.t. to a sigma-algebra, the preimage of an open interval unbounded above is in the subspace sigma-algebra induced by its domain. (Contributed by Glauco Siliprandi, 26-Jun-2021.) (Revised by Glauco Siliprandi, 15-Dec-2024.)
theorem smfpimgtxr {x3: setvar} (ph: wff x3) (A2: class) (D S F: class x3):
  $ wnfc x3 F $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel F (cfv S csmblfn)) $ >
  $ wceq D (cdm F) $ >
  $ wi ph (wcel A2 cxr) $ >
  $ wi ph (wcel (crab x3 (wbr A2 (cfv (cv x3) F) clt) D) (co S D crest)) $;

--| Given a function measurable w.r.t. to a sigma-algebra, the preimage of an open interval unbounded above is in the subspace sigma-algebra induced by its domain. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smfpimgtmpt {x3: setvar} (ph: wff x3) (A2: class) (B2 S: class x3) (L: class) (V: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wcel S csalg) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) (cfv S csmblfn)) $ >
  $ wi ph (wcel L cr) $ >
  $ wi ph (wcel (crab x3 (wbr L B2 clt) A2) (co S A2 crest)) $;

--| Given a function measurable w.r.t. to a sigma-algebra, the preimage of a closed interval unbounded above is in the subspace sigma-algebra induced by its domain. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smfpreimage {x3: setvar} (ph: wff x3) (A2 D: class) (S: class x3) (F: class):
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel F (cfv S csmblfn)) $ >
  $ wceq D (cdm F) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel (crab x3 (wbr A2 (cfv (cv x3) F) cle) D) (co S D crest)) $;

--| Real-valued measurable functions are a proper subset of sigma-measurable functions (w.r.t. the Lebesgue measure on the reals). (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem mbfpsssmf (S: class):
  $ wceq S (cdm cvol) $ >
  $ wpss (cin cmbf (co cr cr cpm)) (cfv S csmblfn) $;

--| Given a function measurable w.r.t. to a sigma-algebra, the preimage of an open interval unbounded above is in the subspace sigma-algebra induced by its domain. (Contributed by Glauco Siliprandi, 20-Dec-2024.)
theorem smfpimgtxrmptf {x3: setvar} (ph: wff x3) (A2 B2 S: class x3) (L: class) (V: class x3):
  $ wnf x3 ph $ >
  $ wnfc x3 A2 $ >
  $ wi ph (wcel S csalg) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) (cfv S csmblfn)) $ >
  $ wi ph (wcel L cxr) $ >
  $ wi ph (wcel (crab x3 (wbr L B2 clt) A2) (co S A2 crest)) $;

--| Given a function measurable w.r.t. to a sigma-algebra, the preimage of an open interval unbounded above is in the subspace sigma-algebra induced by its domain. (Contributed by Glauco Siliprandi, 26-Jun-2021.) (Revised by Glauco Siliprandi, 20-Dec-2024.)
theorem smfpimgtxrmpt {x3: setvar} (ph: wff x3) (A2: class) (B2 S: class x3) (L: class) (V: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wcel S csalg) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) (cfv S csmblfn)) $ >
  $ wi ph (wcel L cxr) $ >
  $ wi ph (wcel (crab x3 (wbr L B2 clt) A2) (co S A2 crest)) $;

--| Given a function measurable w.r.t. to a sigma-algebra, the preimage of an open interval is in the subspace sigma-algebra induced by its domain. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smfpimioompt {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3) (R: class) (S: class x3) (L: class) (V W: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 W) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) (cfv S csmblfn)) $ >
  $ wi ph (wcel L cxr) $ >
  $ wi ph (wcel R cxr) $ >
  $ wi ph (wcel (crab x3 (wcel B2 (co L R cioo)) A2) (co S A2 crest)) $;

--| Given a function measurable w.r.t. to a sigma-algebra, the preimage of an open interval is in the subspace sigma-algebra induced by its domain. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smfpimioo (ph: wff) (A2 B2 D S F: class):
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel F (cfv S csmblfn)) $ >
  $ wceq D (cdm F) $ >
  $ wi ph (wcel A2 cxr) $ >
  $ wi ph (wcel B2 cxr) $ >
  $ wi ph (wcel (cima (ccnv F) (co A2 B2 cioo)) (co S D crest)) $;

--| Given a sigma-measurable function, the subsets of ` RR ` whose preimage is in the sigma-algebra induced by the function's domain, form a sigma-algebra. First part of the proof of Proposition 121E (f) of [Fremlin1] p. 38 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smfresal {e: setvar} (ph: wff) (D S: class) (T: class e) (F: class):
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel F (cfv S csmblfn)) $ >
  $ wceq D (cdm F) $ >
  $ wceq T (crab e (wcel (cima (ccnv F) (cv e)) (co S D crest)) (cpw cr)) $ >
  $ wi ph (wcel T csalg) $;

--| The reciprocal of a sigma-measurable functions is sigma-measurable. First part of Proposition 121E (e) of [Fremlin1] p. 38 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smfrec {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3) (C: class) (S V: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) (cfv S csmblfn)) $ >
  $ wceq C (crab x3 (wne B2 cc0) A2) $ >
  $ wi ph (wcel (cmpt x3 C (co c1 B2 cdiv)) (cfv S csmblfn)) $;

--| The restriction of sigma-measurable function is sigma-measurable. Proposition 121E (h) of [Fremlin1] p. 37 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smfres (ph: wff) (A2 S F V: class):
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel F (cfv S csmblfn)) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel (cres F A2) (cfv S csmblfn)) $;

--| The multiplication of two sigma-measurable functions is measurable: this is the step (i) of the proof of Proposition 121E (d) of [Fremlin1] p. 37 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smfmullem1 (ph: wff) (A2 P R S U H I V X Y Z: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel U cr) $ >
  $ wi ph (wcel V cr) $ >
  $ wi ph (wbr (co U V cmul) A2 clt) $ >
  $ wceq X (co (co A2 (co U V cmul) cmin) (co c1 (co (cfv U cabs) (cfv V cabs) caddc) caddc) cdiv) $ >
  $ wceq Y (cif (wbr c1 X cle) c1 X) $ >
  $ wi ph (wcel P (co (co U Y cmin) U cioo)) $ >
  $ wi ph (wcel R (co U (co U Y caddc) cioo)) $ >
  $ wi ph (wcel S (co (co V Y cmin) V cioo)) $ >
  $ wi ph (wcel Z (co V (co V Y caddc) cioo)) $ >
  $ wi ph (wcel H (co P R cioo)) $ >
  $ wi ph (wcel I (co S Z cioo)) $ >
  $ wi ph (wbr (co H I cmul) A2 clt) $;

--| The multiplication of two sigma-measurable functions is measurable: this is the step (i) of the proof of Proposition 121E (d) of [Fremlin1] p. 37 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smfmullem2 {v u q: setvar} (ph: wff q) (A2: class v u) (P R S: class) (U: class v u) (K: class v u q) (V: class v u) (X Y: class v u q) (Z: class):
  $ wi ph (wcel A2 cr) $ >
  $ wceq K (crab q (wral u (wral v (wbr (co (cv u) (cv v) cmul) A2 clt) (co (cfv c2 (cv q)) (cfv c3 (cv q)) cioo)) (co (cfv cc0 (cv q)) (cfv c1 (cv q)) cioo)) (co cq (co cc0 c3 cfz) cmap)) $ >
  $ wi ph (wcel U cr) $ >
  $ wi ph (wcel V cr) $ >
  $ wi ph (wbr (co U V cmul) A2 clt) $ >
  $ wi ph (wcel P cq) $ >
  $ wi ph (wcel R cq) $ >
  $ wi ph (wcel S cq) $ >
  $ wi ph (wcel Z cq) $ >
  $ wi ph (wcel P (co (co U Y cmin) U cioo)) $ >
  $ wi ph (wcel R (co U (co U Y caddc) cioo)) $ >
  $ wi ph (wcel S (co (co V Y cmin) V cioo)) $ >
  $ wi ph (wcel Z (co V (co V Y caddc) cioo)) $ >
  $ wceq X (co (co A2 (co U V cmul) cmin) (co c1 (co (cfv U cabs) (cfv V cabs) caddc) caddc) cdiv) $ >
  $ wceq Y (cif (wbr c1 X cle) c1 X) $ >
  $ wi ph (wrex q (wa (wcel U (co (cfv cc0 (cv q)) (cfv c1 (cv q)) cioo)) (wcel V (co (cfv c2 (cv q)) (cfv c3 (cv q)) cioo))) K) $;

--| The multiplication of two sigma-measurable functions is measurable: this is the step (i) of the proof of Proposition 121E (d) of [Fremlin1] p. 37 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smfmullem3 {v u q: setvar} (ph: wff q) (R: class v u) (U: class) (K: class v u q) (V: class) (X: class v u q) (Y: class q):
  $ wi ph (wcel R cr) $ >
  $ wceq K (crab q (wral u (wral v (wbr (co (cv u) (cv v) cmul) R clt) (co (cfv c2 (cv q)) (cfv c3 (cv q)) cioo)) (co (cfv cc0 (cv q)) (cfv c1 (cv q)) cioo)) (co cq (co cc0 c3 cfz) cmap)) $ >
  $ wi ph (wcel U cr) $ >
  $ wi ph (wcel V cr) $ >
  $ wi ph (wbr (co U V cmul) R clt) $ >
  $ wceq X (co (co R (co U V cmul) cmin) (co c1 (co (cfv U cabs) (cfv V cabs) caddc) caddc) cdiv) $ >
  $ wceq Y (cif (wbr c1 X cle) c1 X) $ >
  $ wi ph (wrex q (wa (wcel U (co (cfv cc0 (cv q)) (cfv c1 (cv q)) cioo)) (wcel V (co (cfv c2 (cv q)) (cfv c3 (cv q)) cioo))) K) $;

--| The multiplication of two sigma-measurable functions is measurable. Proposition 121E (d) of [Fremlin1] p. 37 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smfmullem4 {x3 v u q: setvar} (ph: wff x3) (A2: class) (B2: class x3) (C: class) (D R: class x3) (S: class x3 v u) (E: class x3 v u q) (K: class v u) (V: class x3 v u q):
  $ wnf x3 ph $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi (wa ph (wcel (cv x3) C)) (wcel D cr) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) (cfv S csmblfn)) $ >
  $ wi ph (wcel (cmpt x3 C D) (cfv S csmblfn)) $ >
  $ wi ph (wcel R cr) $ >
  $ wceq K (crab q (wral u (wral v (wbr (co (cv u) (cv v) cmul) R clt) (co (cfv c2 (cv q)) (cfv c3 (cv q)) cioo)) (co (cfv cc0 (cv q)) (cfv c1 (cv q)) cioo)) (co cq (co cc0 c3 cfz) cmap)) $ >
  $ wceq E (cmpt q K (crab x3 (wa (wcel B2 (co (cfv cc0 (cv q)) (cfv c1 (cv q)) cioo)) (wcel D (co (cfv c2 (cv q)) (cfv c3 (cv q)) cioo))) (cin A2 C))) $ >
  $ wi ph (wcel (crab x3 (wbr (co B2 D cmul) R clt) (cin A2 C)) (co S (cin A2 C) crest)) $;

--| The multiplication of two sigma-measurable functions is measurable. Proposition 121E (d) of [Fremlin1] p. 37 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smfmul {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3) (C: class) (D S V: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi (wa ph (wcel (cv x3) C)) (wcel D cr) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) (cfv S csmblfn)) $ >
  $ wi ph (wcel (cmpt x3 C D) (cfv S csmblfn)) $ >
  $ wi ph (wcel (cmpt x3 (cin A2 C) (co B2 D cmul)) (cfv S csmblfn)) $;

--| A sigma-measurable function multiplied by a constant is sigma-measurable. Proposition 121E (c) of [Fremlin1] p. 37 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smfmulc1 {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3) (C: class) (S V: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) (cfv S csmblfn)) $ >
  $ wi ph (wcel (cmpt x3 A2 (co C B2 cmul)) (cfv S csmblfn)) $;

--| The fraction of two sigma-measurable functions is measurable. Proposition 121E (e) of [Fremlin1] p. 37 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smfdiv {x3: setvar} (ph: wff x3) (A2: class) (B2: class x3) (C: class) (D S: class x3) (E: class) (V W: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi ph (wcel C W) $ >
  $ wi (wa ph (wcel (cv x3) C)) (wcel D cr) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) (cfv S csmblfn)) $ >
  $ wi ph (wcel (cmpt x3 C D) (cfv S csmblfn)) $ >
  $ wceq E (crab x3 (wne D cc0) C) $ >
  $ wi ph (wcel (cmpt x3 (cin A2 E) (co B2 D cdiv)) (cfv S csmblfn)) $;

--| Every open set belongs to ` T ` . This is the second step in the proof of Proposition 121E (f) of [Fremlin1] p. 38 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smfpimbor1lem1 {e: setvar} (ph: wff) (D S: class) (T: class e) (F: class) (G J: class e):
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel F (cfv S csmblfn)) $ >
  $ wceq D (cdm F) $ >
  $ wceq J (cfv (crn cioo) ctg) $ >
  $ wi ph (wcel G J) $ >
  $ wceq T (crab e (wcel (cima (ccnv F) (cv e)) (co S D crest)) (cpw cr)) $ >
  $ wi ph (wcel G T) $;

--| Given a sigma-measurable function, the preimage of a Borel set belongs to the subspace sigma-algebra induced by the domain of the function. Proposition 121E (f) of [Fremlin1] p. 37 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smfpimbor1lem2 {e: setvar} (ph: wff) (B2: class e) (D: class) (P: class e) (S: class) (T: class e) (E F J: class):
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel F (cfv S csmblfn)) $ >
  $ wceq D (cdm F) $ >
  $ wceq J (cfv (crn cioo) ctg) $ >
  $ wceq B2 (cfv J csalgen) $ >
  $ wi ph (wcel E B2) $ >
  $ wceq P (cima (ccnv F) E) $ >
  $ wceq T (crab e (wcel (cima (ccnv F) (cv e)) (co S D crest)) (cpw cr)) $ >
  $ wi ph (wcel P (co S D crest)) $;

--| Given a sigma-measurable function, the preimage of a Borel set belongs to the subspace sigma-algebra induced by the domain of the function. Proposition 121E (f) of [Fremlin1] p. 37 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smfpimbor1 (ph: wff) (B2 D P S E F J: class):
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel F (cfv S csmblfn)) $ >
  $ wceq D (cdm F) $ >
  $ wceq J (cfv (crn cioo) ctg) $ >
  $ wceq B2 (cfv J csalgen) $ >
  $ wi ph (wcel E B2) $ >
  $ wceq P (cima (ccnv F) E) $ >
  $ wi ph (wcel P (co S D crest)) $;

--| Twice the identity function is Borel sigma-measurable (just an example, to test previous general theorems). (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smf2id {x3: setvar} (ph: wff) (A2: class) (B2 J: class x3):
  $ wceq J (cfv (crn cioo) ctg) $ >
  $ wceq B2 (cfv J csalgen) $ >
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wcel (cmpt x3 A2 (co c2 (cv x3) cmul)) (cfv B2 csmblfn)) $;

--| The composition of a Borel sigma-measurable function with a sigma-measurable function, is sigma-measurable. Proposition 121E (g) of [Fremlin1] p. 37 . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem smfco (ph: wff) (B2 S F H J: class):
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel F (cfv S csmblfn)) $ >
  $ wceq J (cfv (crn cioo) ctg) $ >
  $ wceq B2 (cfv J csalgen) $ >
  $ wi ph (wcel H (cfv B2 csmblfn)) $ >
  $ wi ph (wcel (ccom H F) (cfv S csmblfn)) $;

--| The negative of a sigma-measurable function is measurable. (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem smfneg {x3: setvar} (ph: wff x3) (A2: class) (B2 S V: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) (cfv S csmblfn)) $ >
  $ wi ph (wcel (cmpt x3 A2 (cneg B2)) (cfv S csmblfn)) $;

--| A function measurable w.r.t. to a sigma-algebra, is actually a function. (Contributed by Glauco Siliprandi, 5-Jan-2025.)
theorem smffmptf {x3: setvar} (ph: wff x3) (A2 B2 S V: class x3):
  $ wnf x3 ph $ >
  $ wnfc x3 A2 $ >
  $ wi ph (wcel S csalg) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) (cfv S csmblfn)) $ >
  $ wi ph (wf A2 cr (cmpt x3 A2 B2)) $;

--| A function measurable w.r.t. to a sigma-algebra, is actually a function. (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem smffmpt {x3: setvar} (ph: wff x3) (A2: class) (B2 S V: class x3):
  $ wnf x3 ph $ >
  $ wi ph (wcel S csalg) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) (cfv S csmblfn)) $ >
  $ wi ph (wf A2 cr (cmpt x3 A2 B2)) $;

--| The limit of a sequence of sigma-measurable functions is sigma-measurable. Proposition 121F (a) of [Fremlin1] p. 38 . Notice that every function in the sequence can have a different (partial) domain, and the domain of convergence can be decidedly irregular (Remark 121G of [Fremlin1] p. 39 ). TODO: this has fewer distinct variable conditions than ~ smflim and should replace it. (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem smflim2 {x3 m n: setvar} (ph: wff x3 m n) (D S: class x3 m n) (F: class x3 m) (G M: class x3 m n) (Z: class):
  $ wnfc m F $ >
  $ wnfc x3 F $ >
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wf Z (cfv S csmblfn) F) $ >
  $ wceq D (crab x3 (wcel (cmpt m Z (cfv (cv x3) (cfv (cv m) F))) (cdm cli)) (ciun n Z (ciin m (cfv (cv n) cuz) (cdm (cfv (cv m) F))))) $ >
  $ wceq G (cmpt x3 D (cfv (cmpt m Z (cfv (cv x3) (cfv (cv m) F))) cli)) $ >
  $ wi ph (wcel G (cfv S csmblfn)) $;

--| Lemma for ~ smfpimcc given the choice function ` C ` . (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem smfpimcclem {y1 h n s1: setvar} (ph: wff h n s1) (A2: class n) (C: class h n) (S: class) (F: class n) (H: class y1 n s1) (V W: class y1 h n s1) (Z: class s1):
  $ wnf n ph $ >
  $ wcel Z V $ >
  $ wi ph (wcel S W) $ >
  $ wi (wa ph (wcel (cv y1) (crn (cmpt n Z (crab s1 (wceq (cima (ccnv (cfv (cv n) F)) A2) (cin (cv s1) (cdm (cfv (cv n) F)))) S))))) (wcel (cfv (cv y1) C) (cv y1)) $ >
  $ wceq H (cmpt n Z (cfv (crab s1 (wceq (cima (ccnv (cfv (cv n) F)) A2) (cin (cv s1) (cdm (cfv (cv n) F)))) S) C)) $ >
  $ wi ph (wex h (wa (wf Z S (cv h)) (wral n (wceq (cima (ccnv (cfv (cv n) F)) A2) (cin (cfv (cv n) (cv h)) (cdm (cfv (cv n) F)))) Z))) $;

--| Given a countable set of sigma-measurable functions, and a Borel set ` A ` there exists a choice function ` h ` that, for each measurable function, chooses a measurable set that, when intersected with the function's domain, gives the preimage of ` A ` . This is a generalization of the observation at the beginning of the proof of Proposition 121F of [Fremlin1] p. 39 . The statement would also be provable for uncountable sets, but in most cases it will suffice to consider the countable case, and only the axiom of countable choice will be needed. (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem smfpimcc {h n: setvar} (ph: wff h n) (A2: class) (B2: class h n) (S F: class n) (J M: class h n) (Z: class):
  $ wnfc n F $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wf Z (cfv S csmblfn) F) $ >
  $ wceq J (cfv (crn cioo) ctg) $ >
  $ wceq B2 (cfv J csalgen) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wex h (wa (wf Z S (cv h)) (wral n (wceq (cima (ccnv (cfv (cv n) F)) A2) (cin (cfv (cv n) (cv h)) (cdm (cfv (cv n) F)))) Z))) $;

--| A sufficient condition for " ` F ` being a measurable function w.r.t. to the sigma-algebra ` S ` ". (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem issmfle2d {a: setvar} (ph: wff a) (D: class a) (S F: class):
  $ wnf a ph $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wss D (cuni S)) $ >
  $ wi ph (wf D cr F) $ >
  $ wi (wa ph (wcel (cv a) cr)) (wcel (cima (ccnv F) (co cmnf (cv a) cioc)) (co S D crest)) $ >
  $ wi ph (wcel F (cfv S csmblfn)) $;

--| The limit of a sequence of sigma-measurable functions is sigma-measurable. Proposition 121F (a) of [Fremlin1] p. 38 . Notice that every function in the sequence can have a different (partial) domain, and the domain of convergence can be decidedly irregular (Remark 121G of [Fremlin1] p. 39 ). ` A ` can contain ` m ` as a free variable, in other words it can be thought as an indexed collection ` A ( m ) ` . ` B ` can be thought as a collection with two indices ` B ( m , x ) ` . (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem smflimmpt {x3 m n: setvar} (ph: wff x3 m n) (A2: class m) (B2: class x3 m) (D: class x3 m n) (S: class x3) (G M V W: class x3 m n) (Z: class):
  $ wnf m ph $ >
  $ wnf x3 ph $ >
  $ wnf n ph $ >
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi (wa ph (wcel (cv m) Z)) (wcel A2 V) $ >
  $ wi (w3a ph (wcel (cv m) Z) (wcel (cv x3) A2)) (wcel B2 W) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi (wa ph (wcel (cv m) Z)) (wcel (cmpt x3 A2 B2) (cfv S csmblfn)) $ >
  $ wceq D (crab x3 (wcel (cmpt m Z B2) (cdm cli)) (ciun n Z (ciin m (cfv (cv n) cuz) A2))) $ >
  $ wceq G (cmpt x3 D (cfv (cmpt m Z B2) cli)) $ >
  $ wi ph (wcel G (cfv S csmblfn)) $;

--| The supremum of a countable set of sigma-measurable functions is sigma-measurable. Proposition 121F (b) of [Fremlin1] p. 38 . (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem smfsuplem1 {x3 y1 n: setvar} (ph: wff) (A2: class y1) (D: class) (S: class x3 y1) (F: class n) (G: class y1) (H: class) (M: class x3 y1) (Z: class):
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wf Z (cfv S csmblfn) F) $ >
  $ wceq D (crab x3 (wrex y1 (wral n (wbr (cfv (cv x3) (cfv (cv n) F)) (cv y1) cle) Z) cr) (ciin n Z (cdm (cfv (cv n) F)))) $ >
  $ wceq G (cmpt x3 D (csup (crn (cmpt n Z (cfv (cv x3) (cfv (cv n) F)))) cr clt)) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wf Z S H) $ >
  $ wi (wa ph (wcel (cv n) Z)) (wceq (cima (ccnv (cfv (cv n) F)) (co cmnf A2 cioc)) (cin (cfv (cv n) H) (cdm (cfv (cv n) F)))) $ >
  $ wi ph (wcel (cima (ccnv G) (co cmnf A2 cioc)) (co S D crest)) $;

--| The supremum of a countable set of sigma-measurable functions is sigma-measurable. Proposition 121F (b) of [Fremlin1] p. 38 . (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem smfsuplem2 {x3 y1 n: setvar} (ph: wff x3 n) (A2: class x3) (D: class n) (S: class x3 n) (F: class) (G M: class x3 y1 n) (Z: class):
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wf Z (cfv S csmblfn) F) $ >
  $ wceq D (crab x3 (wrex y1 (wral n (wbr (cfv (cv x3) (cfv (cv n) F)) (cv y1) cle) Z) cr) (ciin n Z (cdm (cfv (cv n) F)))) $ >
  $ wceq G (cmpt x3 D (csup (crn (cmpt n Z (cfv (cv x3) (cfv (cv n) F)))) cr clt)) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel (cima (ccnv G) (co cmnf A2 cioc)) (co S D crest)) $;

--| The supremum of a countable set of sigma-measurable functions is sigma-measurable. Proposition 121F (b) of [Fremlin1] p. 38 . (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem smfsuplem3 {x3 y1 n: setvar} (ph: wff) (D: class) (S: class x3) (F: class) (G: class x3 y1 n) (M: class x3 y1) (Z: class):
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wf Z (cfv S csmblfn) F) $ >
  $ wceq D (crab x3 (wrex y1 (wral n (wbr (cfv (cv x3) (cfv (cv n) F)) (cv y1) cle) Z) cr) (ciin n Z (cdm (cfv (cv n) F)))) $ >
  $ wceq G (cmpt x3 D (csup (crn (cmpt n Z (cfv (cv x3) (cfv (cv n) F)))) cr clt)) $ >
  $ wi ph (wcel G (cfv S csmblfn)) $;

--| The supremum of a countable set of sigma-measurable functions is sigma-measurable. Proposition 121F (b) of [Fremlin1] p. 38 . (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem smfsup {x3 y1 n: setvar} (ph: wff x3 y1 n) (D S: class x3 y1 n) (F: class x3 n) (G M: class x3 y1 n) (Z: class):
  $ wnfc n F $ >
  $ wnfc x3 F $ >
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wf Z (cfv S csmblfn) F) $ >
  $ wceq D (crab x3 (wrex y1 (wral n (wbr (cfv (cv x3) (cfv (cv n) F)) (cv y1) cle) Z) cr) (ciin n Z (cdm (cfv (cv n) F)))) $ >
  $ wceq G (cmpt x3 D (csup (crn (cmpt n Z (cfv (cv x3) (cfv (cv n) F)))) cr clt)) $ >
  $ wi ph (wcel G (cfv S csmblfn)) $;

--| The supremum of a countable set of sigma-measurable functions is sigma-measurable. Proposition 121F (b) of [Fremlin1] p. 38 . (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem smfsupmpt {x3 y1 n: setvar} (ph: wff x3 y1 n) (A2: class n) (B2: class x3 n) (D: class x3 y1 n) (S: class x3 y1) (G M V: class x3 y1 n) (Z: class):
  $ wnf n ph $ >
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi (w3a ph (wcel (cv n) Z) (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi (wa ph (wcel (cv n) Z)) (wcel (cmpt x3 A2 B2) (cfv S csmblfn)) $ >
  $ wceq D (crab x3 (wrex y1 (wral n (wbr B2 (cv y1) cle) Z) cr) (ciin n Z A2)) $ >
  $ wceq G (cmpt x3 D (csup (crn (cmpt n Z B2)) cr clt)) $ >
  $ wi ph (wcel G (cfv S csmblfn)) $;

--| The supremum of a countable set of sigma-measurable functions is sigma-measurable. Proposition 121F (b) of [Fremlin1] p. 38 . (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem smfsupxr {x3 n: setvar} (ph: wff) (D S F G M: class x3 n) (Z: class):
  $ wnfc n F $ >
  $ wnfc x3 F $ >
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wf Z (cfv S csmblfn) F) $ >
  $ wceq D (crab x3 (wcel (csup (crn (cmpt n Z (cfv (cv x3) (cfv (cv n) F)))) cxr clt) cr) (ciin n Z (cdm (cfv (cv n) F)))) $ >
  $ wceq G (cmpt x3 D (csup (crn (cmpt n Z (cfv (cv x3) (cfv (cv n) F)))) cxr clt)) $ >
  $ wi ph (wcel G (cfv S csmblfn)) $;

--| The infimum of a countable set of sigma-measurable functions is sigma-measurable. Proposition 121F (c) of [Fremlin1] p. 38 . (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem smfinflem {x3 y1 n: setvar} (ph: wff) (D: class) (S: class x3 y1) (F: class) (G M: class x3 y1 n) (Z: class):
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wf Z (cfv S csmblfn) F) $ >
  $ wceq D (crab x3 (wrex y1 (wral n (wbr (cv y1) (cfv (cv x3) (cfv (cv n) F)) cle) Z) cr) (ciin n Z (cdm (cfv (cv n) F)))) $ >
  $ wceq G (cmpt x3 D (cinf (crn (cmpt n Z (cfv (cv x3) (cfv (cv n) F)))) cr clt)) $ >
  $ wi ph (wcel G (cfv S csmblfn)) $;

--| The infimum of a countable set of sigma-measurable functions is sigma-measurable. Proposition 121F (c) of [Fremlin1] p. 38 . (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem smfinf {x3 y1 n: setvar} (ph: wff x3 y1 n) (D S: class x3 y1 n) (F: class x3 n) (G M: class x3 y1 n) (Z: class):
  $ wnfc n F $ >
  $ wnfc x3 F $ >
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wf Z (cfv S csmblfn) F) $ >
  $ wceq D (crab x3 (wrex y1 (wral n (wbr (cv y1) (cfv (cv x3) (cfv (cv n) F)) cle) Z) cr) (ciin n Z (cdm (cfv (cv n) F)))) $ >
  $ wceq G (cmpt x3 D (cinf (crn (cmpt n Z (cfv (cv x3) (cfv (cv n) F)))) cr clt)) $ >
  $ wi ph (wcel G (cfv S csmblfn)) $;

--| The infimum of a countable set of sigma-measurable functions is sigma-measurable. Proposition 121F (c) of [Fremlin1] p. 38 . (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem smfinfmpt {x3 y1 n: setvar} (ph: wff x3 y1 n) (A2: class n) (B2: class x3 n) (D: class x3 y1 n) (S: class x3 y1) (G M V: class x3 y1 n) (Z: class):
  $ wnf n ph $ >
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi (w3a ph (wcel (cv n) Z) (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi (wa ph (wcel (cv n) Z)) (wcel (cmpt x3 A2 B2) (cfv S csmblfn)) $ >
  $ wceq D (crab x3 (wrex y1 (wral n (wbr (cv y1) B2 cle) Z) cr) (ciin n Z A2)) $ >
  $ wceq G (cmpt x3 D (cinf (crn (cmpt n Z B2)) cr clt)) $ >
  $ wi ph (wcel G (cfv S csmblfn)) $;

--| If ` H ` converges, the ` limsup ` of ` F ` is real. (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem smflimsuplem1 {x3 m n: setvar} (ph: wff x3 m n) (E: class m) (F: class) (H: class x3 m n) (K: class m) (M: class x3 m n) (Z: class x3 m):
  $ wceq Z (cfv M cuz) $ >
  $ wceq E (cmpt n Z (crab x3 (wcel (csup (crn (cmpt m (cfv (cv n) cuz) (cfv (cv x3) (cfv (cv m) F)))) cxr clt) cr) (ciin m (cfv (cv n) cuz) (cdm (cfv (cv m) F))))) $ >
  $ wceq H (cmpt n Z (cmpt x3 (cfv (cv n) E) (csup (crn (cmpt m (cfv (cv n) cuz) (cfv (cv x3) (cfv (cv m) F)))) cxr clt))) $ >
  $ wi ph (wcel K Z) $ >
  $ wi ph (wss (cdm (cfv K H)) (cdm (cfv K F))) $;

--| The superior limit of a sequence of sigma-measurable functions is sigma-measurable. Proposition 121F (d) of [Fremlin1] p. 39 . (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem smflimsuplem2 {x3 m n: setvar} (ph: wff x3 m n) (S E: class x3 m n) (F: class m n) (H: class x3 m n) (M X: class x3 n) (Z: class):
  $ wnf m ph $ >
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wf Z (cfv S csmblfn) F) $ >
  $ wceq E (cmpt n Z (crab x3 (wcel (csup (crn (cmpt m (cfv (cv n) cuz) (cfv (cv x3) (cfv (cv m) F)))) cxr clt) cr) (ciin m (cfv (cv n) cuz) (cdm (cfv (cv m) F))))) $ >
  $ wceq H (cmpt n Z (cmpt x3 (cfv (cv n) E) (csup (crn (cmpt m (cfv (cv n) cuz) (cfv (cv x3) (cfv (cv m) F)))) cxr clt))) $ >
  $ wi ph (wcel (cv n) Z) $ >
  $ wi ph (wcel (cfv (cmpt m Z (cfv X (cfv (cv m) F))) clsp) cr) $ >
  $ wi ph (wcel X (ciin m (cfv (cv n) cuz) (cdm (cfv (cv m) F)))) $ >
  $ wi ph (wcel X (cdm (cfv (cv n) H))) $;

--| The limit of the ` ( H `` n ) ` functions is sigma-measurable. (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem smflimsuplem3 {x3 k m n: setvar} (ph: wff) (S: class x3 m) (E: class k m n) (F: class k n) (H: class m n) (M: class x3 k m n) (Z: class):
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wf Z (cfv S csmblfn) F) $ >
  $ wceq E (cmpt n Z (crab x3 (wcel (csup (crn (cmpt m (cfv (cv n) cuz) (cfv (cv x3) (cfv (cv m) F)))) cxr clt) cr) (ciin m (cfv (cv n) cuz) (cdm (cfv (cv m) F))))) $ >
  $ wceq H (cmpt n Z (cmpt x3 (cfv (cv n) E) (csup (crn (cmpt m (cfv (cv n) cuz) (cfv (cv x3) (cfv (cv m) F)))) cxr clt))) $ >
  $ wi ph (wcel (cmpt x3 (crab x3 (wcel (cmpt n Z (cfv (cv x3) (cfv (cv n) H))) (cdm cli)) (ciun k Z (ciin n (cfv (cv k) cuz) (cdm (cfv (cv n) H))))) (cfv (cmpt n Z (cfv (cv x3) (cfv (cv n) H))) cli)) (cfv S csmblfn)) $;

--| If ` H ` converges, the ` limsup ` of ` F ` is real. (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem smflimsuplem4 {x3 m n: setvar} (ph: wff x3 n) (S: class x3 m n) (E: class m) (F: class) (H: class x3 m) (M: class x3 n) (N Z: class x3):
  $ wnf n ph $ >
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wf Z (cfv S csmblfn) F) $ >
  $ wceq E (cmpt n Z (crab x3 (wcel (csup (crn (cmpt m (cfv (cv n) cuz) (cfv (cv x3) (cfv (cv m) F)))) cxr clt) cr) (ciin m (cfv (cv n) cuz) (cdm (cfv (cv m) F))))) $ >
  $ wceq H (cmpt n Z (cmpt x3 (cfv (cv n) E) (csup (crn (cmpt m (cfv (cv n) cuz) (cfv (cv x3) (cfv (cv m) F)))) cxr clt))) $ >
  $ wi ph (wcel N Z) $ >
  $ wi ph (wcel (cv x3) (ciin n (cfv N cuz) (cdm (cfv (cv n) H)))) $ >
  $ wi ph (wcel (cmpt n Z (cfv (cv x3) (cfv (cv n) H))) (cdm cli)) $ >
  $ wi ph (wcel (cfv (cmpt m Z (cfv (cv x3) (cfv (cv m) F))) clsp) cr) $;

--| ` H ` converges to the superior limit of ` F ` . (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem smflimsuplem5 {x3 m n: setvar} (ph: wff x3 m n) (S E: class x3 m n) (F: class m) (H: class x3 m n) (M: class x3 n) (N X: class x3) (Z: class):
  $ wnf n ph $ >
  $ wnf m ph $ >
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wf Z (cfv S csmblfn) F) $ >
  $ wceq E (cmpt n Z (crab x3 (wcel (csup (crn (cmpt m (cfv (cv n) cuz) (cfv (cv x3) (cfv (cv m) F)))) cxr clt) cr) (ciin m (cfv (cv n) cuz) (cdm (cfv (cv m) F))))) $ >
  $ wceq H (cmpt n Z (cmpt x3 (cfv (cv n) E) (csup (crn (cmpt m (cfv (cv n) cuz) (cfv (cv x3) (cfv (cv m) F)))) cxr clt))) $ >
  $ wi ph (wcel (cfv (cmpt m Z (cfv X (cfv (cv m) F))) clsp) cr) $ >
  $ wi ph (wcel N Z) $ >
  $ wi ph (wcel X (ciin m (cfv N cuz) (cdm (cfv (cv m) F)))) $ >
  $ wi ph (wbr (cmpt n (cfv N cuz) (cfv X (cfv (cv n) H))) (cfv (cmpt m (cfv N cuz) (cfv X (cfv (cv m) F))) clsp) cli) $;

--| The superior limit of a sequence of sigma-measurable functions is sigma-measurable. Proposition 121F (d) of [Fremlin1] p. 39 . (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem smflimsuplem6 {x3 m n: setvar} (ph: wff x3 m n) (S E: class x3 m n) (F: class m) (H: class x3 m n) (M: class x3 n) (N X: class x3) (Z: class):
  $ wnf n ph $ >
  $ wnf m ph $ >
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wf Z (cfv S csmblfn) F) $ >
  $ wceq E (cmpt n Z (crab x3 (wcel (csup (crn (cmpt m (cfv (cv n) cuz) (cfv (cv x3) (cfv (cv m) F)))) cxr clt) cr) (ciin m (cfv (cv n) cuz) (cdm (cfv (cv m) F))))) $ >
  $ wceq H (cmpt n Z (cmpt x3 (cfv (cv n) E) (csup (crn (cmpt m (cfv (cv n) cuz) (cfv (cv x3) (cfv (cv m) F)))) cxr clt))) $ >
  $ wi ph (wcel (cfv (cmpt m Z (cfv X (cfv (cv m) F))) clsp) cr) $ >
  $ wi ph (wcel N Z) $ >
  $ wi ph (wcel X (ciin m (cfv N cuz) (cdm (cfv (cv m) F)))) $ >
  $ wi ph (wcel (cmpt n Z (cfv X (cfv (cv n) H))) (cdm cli)) $;

--| The superior limit of a sequence of sigma-measurable functions is sigma-measurable. Proposition 121F (d) of [Fremlin1] p. 39 . (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem smflimsuplem7 {x3 k m n: setvar} (ph: wff) (D S: class x3 k m n) (E: class m n) (F H: class) (M: class x3 k n) (Z: class):
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wf Z (cfv S csmblfn) F) $ >
  $ wceq D (crab x3 (wcel (cfv (cmpt m Z (cfv (cv x3) (cfv (cv m) F))) clsp) cr) (ciun n Z (ciin m (cfv (cv n) cuz) (cdm (cfv (cv m) F))))) $ >
  $ wceq E (cmpt k Z (crab x3 (wcel (csup (crn (cmpt m (cfv (cv k) cuz) (cfv (cv x3) (cfv (cv m) F)))) cxr clt) cr) (ciin m (cfv (cv k) cuz) (cdm (cfv (cv m) F))))) $ >
  $ wceq H (cmpt k Z (cmpt x3 (cfv (cv k) E) (csup (crn (cmpt m (cfv (cv k) cuz) (cfv (cv x3) (cfv (cv m) F)))) cxr clt))) $ >
  $ wi ph (wceq D (crab x3 (wcel (cmpt k Z (cfv (cv x3) (cfv (cv k) H))) (cdm cli)) (ciun n Z (ciin k (cfv (cv n) cuz) (cdm (cfv (cv k) H)))))) $;

--| The superior limit of a sequence of sigma-measurable functions is sigma-measurable. Proposition 121F (d) of [Fremlin1] p. 39 . (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem smflimsuplem8 {x3 k m n: setvar} (ph: wff) (D: class x3) (S: class x3 m) (E: class m n) (F: class) (G: class x3 k m n) (H: class) (M: class x3 k n) (Z: class):
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wf Z (cfv S csmblfn) F) $ >
  $ wceq D (crab x3 (wcel (cfv (cmpt m Z (cfv (cv x3) (cfv (cv m) F))) clsp) cr) (ciun n Z (ciin m (cfv (cv n) cuz) (cdm (cfv (cv m) F))))) $ >
  $ wceq G (cmpt x3 D (cfv (cmpt m Z (cfv (cv x3) (cfv (cv m) F))) clsp)) $ >
  $ wceq E (cmpt k Z (crab x3 (wcel (csup (crn (cmpt m (cfv (cv k) cuz) (cfv (cv x3) (cfv (cv m) F)))) cxr clt) cr) (ciin m (cfv (cv k) cuz) (cdm (cfv (cv m) F))))) $ >
  $ wceq H (cmpt k Z (cmpt x3 (cfv (cv k) E) (csup (crn (cmpt m (cfv (cv k) cuz) (cfv (cv x3) (cfv (cv m) F)))) cxr clt))) $ >
  $ wi ph (wcel G (cfv S csmblfn)) $;

--| The superior limit of a sequence of sigma-measurable functions is sigma-measurable. Proposition 121F (d) of [Fremlin1] p. 39 . (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem smflimsup {x3 m n: setvar} (ph: wff x3 m n) (D S: class x3 m n) (F: class x3 m) (G M: class x3 m n) (Z: class):
  $ wnfc m F $ >
  $ wnfc x3 F $ >
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wf Z (cfv S csmblfn) F) $ >
  $ wceq D (crab x3 (wcel (cfv (cmpt m Z (cfv (cv x3) (cfv (cv m) F))) clsp) cr) (ciun n Z (ciin m (cfv (cv n) cuz) (cdm (cfv (cv m) F))))) $ >
  $ wceq G (cmpt x3 D (cfv (cmpt m Z (cfv (cv x3) (cfv (cv m) F))) clsp)) $ >
  $ wi ph (wcel G (cfv S csmblfn)) $;

--| The superior limit of a sequence of sigma-measurable functions is sigma-measurable. Proposition 121F (d) of [Fremlin1] p. 39 . ` A ` can contain ` m ` as a free variable, in other words it can be thought of as an indexed collection ` A ( m ) ` . ` B ` can be thought of as a collection with two indices ` B ( m , x ) ` . (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem smflimsupmpt {x3 m n: setvar} (ph: wff x3 m n) (A2: class m) (B2: class x3 m) (D: class x3 m n) (S: class x3 n) (G: class x3 m n) (M: class x3 n) (W: class x3 m n) (Z: class):
  $ wnf m ph $ >
  $ wnf x3 ph $ >
  $ wnf n ph $ >
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi (w3a ph (wcel (cv m) Z) (wcel (cv x3) A2)) (wcel B2 W) $ >
  $ wi (wa ph (wcel (cv m) Z)) (wcel (cmpt x3 A2 B2) (cfv S csmblfn)) $ >
  $ wceq D (crab x3 (wcel (cfv (cmpt m Z B2) clsp) cr) (ciun n Z (ciin m (cfv (cv n) cuz) A2))) $ >
  $ wceq G (cmpt x3 D (cfv (cmpt m Z B2) clsp)) $ >
  $ wi ph (wcel G (cfv S csmblfn)) $;

--| The inferior limit of a countable set of sigma-measurable functions is sigma-measurable. Proposition 121F (e) of [Fremlin1] p. 39 . (Contributed by Glauco Siliprandi, 2-Jan-2022.)
theorem smfliminflem {x3 m n: setvar} (ph: wff) (D: class m n) (S: class x3 n) (F: class m) (G: class x3 m n) (M: class x3 n) (Z: class):
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wf Z (cfv S csmblfn) F) $ >
  $ wceq D (crab x3 (wcel (cfv (cmpt m Z (cfv (cv x3) (cfv (cv m) F))) clsi) cr) (ciun n Z (ciin m (cfv (cv n) cuz) (cdm (cfv (cv m) F))))) $ >
  $ wceq G (cmpt x3 D (cfv (cmpt m Z (cfv (cv x3) (cfv (cv m) F))) clsi)) $ >
  $ wi ph (wcel G (cfv S csmblfn)) $;

--| The inferior limit of a countable set of sigma-measurable functions is sigma-measurable. Proposition 121F (e) of [Fremlin1] p. 39 . (Contributed by Glauco Siliprandi, 2-Jan-2022.)
theorem smfliminf {x3 m n: setvar} (ph: wff x3 m n) (D S: class x3 m n) (F: class x3 m) (G M: class x3 m n) (Z: class):
  $ wnfc m F $ >
  $ wnfc x3 F $ >
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wf Z (cfv S csmblfn) F) $ >
  $ wceq D (crab x3 (wcel (cfv (cmpt m Z (cfv (cv x3) (cfv (cv m) F))) clsi) cr) (ciun n Z (ciin m (cfv (cv n) cuz) (cdm (cfv (cv m) F))))) $ >
  $ wceq G (cmpt x3 D (cfv (cmpt m Z (cfv (cv x3) (cfv (cv m) F))) clsi)) $ >
  $ wi ph (wcel G (cfv S csmblfn)) $;

--| The inferior limit of a countable set of sigma-measurable functions is sigma-measurable. Proposition 121F (e) of [Fremlin1] p. 39 . ` A ` can contain ` m ` as a free variable, in other words it can be thought of as an indexed collection ` A ( m ) ` . ` B ` can be thought of as a collection with two indices ` B ( m , x ) ` . (Contributed by Glauco Siliprandi, 2-Jan-2022.)
theorem smfliminfmpt {x3 m n: setvar} (ph: wff x3 m n) (A2: class m) (B2: class x3 m) (D: class x3 m n) (S: class x3 n) (G: class x3 m n) (M: class x3 n) (V: class x3 m n) (Z: class):
  $ wnf m ph $ >
  $ wnf x3 ph $ >
  $ wnf n ph $ >
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi (w3a ph (wcel (cv m) Z) (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi (wa ph (wcel (cv m) Z)) (wcel (cmpt x3 A2 B2) (cfv S csmblfn)) $ >
  $ wceq D (crab x3 (wcel (cfv (cmpt m Z B2) clsi) cr) (ciun n Z (ciin m (cfv (cv n) cuz) A2))) $ >
  $ wceq G (cmpt x3 D (cfv (cmpt m Z B2) clsi)) $ >
  $ wi ph (wcel G (cfv S csmblfn)) $;

--| If two functions have domains in the sigma-algebra, the domain of their addition also belongs to the sigma-algebra. This is the first statement of Proposition 121H of [Fremlin1], p. 39. Note: While the theorem in the book assumes the functions are sigma-measurable, this assumption is unnecessary for the part concerning their addition. (Contributed by Glauco Siliprandi, 30-Dec-2024.)
theorem adddmmbl {x3: setvar} (ph: wff x3) (A2 B2 C D S: class x3):
  $ wnf x3 ph $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel (cdm (cmpt x3 (cin A2 B2) (co C D caddc))) S) $;

--| If two functions have domains in the sigma-algebra, the domain of their addition also belongs to the sigma-algebra. This is the first statement of Proposition 121H of [Fremlin1], p. 39. Note: While the theorem in the book assumes the functions are sigma-measurable, this assumption is unnecessary for the part concerning their addition. (Contributed by Glauco Siliprandi, 30-Dec-2024.)
theorem adddmmbl2 {x3: setvar} (ph: wff x3) (S F G H: class x3):
  $ wnfc x3 F $ >
  $ wnfc x3 G $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel (cdm F) S) $ >
  $ wi ph (wcel (cdm G) S) $ >
  $ wceq H (cmpt x3 (cin (cdm F) (cdm G)) (co (cfv (cv x3) F) (cfv (cv x3) G) caddc)) $ >
  $ wi ph (wcel (cdm H) S) $;

--| If two functions have domains in the sigma-algebra, the domain of their multiplication also belongs to the sigma-algebra. This is the second statement of Proposition 121H of [Fremlin1], p. 39. Note: While the theorem in the book assumes the functions are sigma-measurable, this assumption is unnecessary for the part concerning their multiplication. (Contributed by Glauco Siliprandi, 30-Dec-2024.)
theorem muldmmbl {x3: setvar} (ph: wff x3) (A2 B2 C D S: class x3):
  $ wnf x3 ph $ >
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi ph (wcel (cdm (cmpt x3 (cin A2 B2) (co C D cmul))) S) $;

--| If two functions have domains in the sigma-algebra, the domain of their multiplication also belongs to the sigma-algebra. This is the second statement of Proposition 121H of [Fremlin1], p. 39. Note: While the theorem in the book assumes the functions are sigma-measurable, this assumption is unnecessary for the part concerning their multiplication. (Contributed by Glauco Siliprandi, 30-Dec-2024.)
theorem muldmmbl2 {x3: setvar} (ph: wff x3) (S F G H: class x3):
  $ wnfc x3 F $ >
  $ wnfc x3 G $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel (cdm F) S) $ >
  $ wi ph (wcel (cdm G) S) $ >
  $ wceq H (cmpt x3 (cin (cdm F) (cdm G)) (co (cfv (cv x3) F) (cfv (cv x3) G) cmul)) $ >
  $ wi ph (wcel (cdm H) S) $;

--| If a measurable function w.r.t. to a sigma-algebra has domain in the sigma-algebra, the set of elements that are not mapped to a given real, is in the sigma-algebra. (Contributed by Glauco Siliprandi, 5-Jan-2025.)
theorem smfdmmblpimne {x3: setvar} (ph: wff x3) (A2 B2: class x3) (C: class) (D S: class x3):
  $ wnf x3 ph $ >
  $ wnfc x3 A2 $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) (cfv S csmblfn)) $ >
  $ wi ph (wcel C cr) $ >
  $ wceq D (crab x3 (wne B2 C) A2) $ >
  $ wi ph (wcel D S) $;

--| If a functions and a sigma-measurable function have domains in the sigma-algebra, the domain of the division of the two functions is in the sigma-algebra. This is the third statement of Proposition 121H of [Fremlin1] p. 39 . Note: While the theorem in the book assumes both functions are sigma-measurable, this assumption is unnecessary for the part concerning their division, for the function at the numerator (it is needed only for the function at the denominator). (Contributed by Glauco Siliprandi, 5-Jan-2025.)
theorem smfdivdmmbl {x3: setvar} (ph: wff x3) (A2 B2 D S E W: class x3):
  $ wnf x3 ph $ >
  $ wnfc x3 B2 $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel B2 S) $ >
  $ wi (wa ph (wcel (cv x3) B2)) (wcel D W) $ >
  $ wi ph (wcel (cmpt x3 B2 D) (cfv S csmblfn)) $ >
  $ wceq E (crab x3 (wne D cc0) B2) $ >
  $ wi ph (wcel (cin A2 E) S) $;

--| Given a function measurable w.r.t. to a sigma-algebra, the preimage of reals that are different from a value in the extended reals is in the subspace of sigma-algebra induced by its domain. (Contributed by Glauco Siliprandi, 5-Jan-2025.)
theorem smfpimne {x3: setvar} (ph: wff x3) (A2: class) (D S F: class x3):
  $ wnf x3 ph $ >
  $ wnfc x3 F $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel F (cfv S csmblfn)) $ >
  $ wceq D (cdm F) $ >
  $ wi ph (wcel A2 cxr) $ >
  $ wi ph (wcel (crab x3 (wne (cfv (cv x3) F) A2) D) (co S D crest)) $;

--| Given a function measurable w.r.t. to a sigma-algebra, the preimage of reals that are different from a value is in the subspace sigma-algebra induced by its domain. Notice that ` A ` is not assumed to be an extended real. (Contributed by Glauco Siliprandi, 5-Jan-2025.)
theorem smfpimne2 {x3: setvar} (ph: wff x3) (A2: class) (D S F: class x3):
  $ wnf x3 ph $ >
  $ wnfc x3 F $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wcel F (cfv S csmblfn)) $ >
  $ wceq D (cdm F) $ >
  $ wi ph (wcel (crab x3 (wne (cfv (cv x3) F) A2) D) (co S D crest)) $;

--| If a functions and a sigma-measurable function have domains in the sigma-algebra, the domain of the division of the two functions is in the sigma-algebra. This is the third statement of Proposition 121H of [Fremlin1] p. 39 . Note: While the theorem in the book assumes both functions are sigma-measurable, this assumption is unnecessary for the part concerning their division, for the function at the numerator. It is required only for the function at the denominator. (Contributed by Glauco Siliprandi, 5-Jan-2025.)
theorem smfdivdmmbl2 {x3: setvar} (ph: wff x3) (A2 D S F G H V: class x3):
  $ wnf x3 ph $ >
  $ wnfc x3 F $ >
  $ wnfc x3 G $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wf A2 V F) $ >
  $ wi ph (wcel G (cfv S csmblfn)) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wcel (cdm G) S) $ >
  $ wceq D (crab x3 (wne (cfv (cv x3) G) cc0) (cdm G)) $ >
  $ wceq H (cmpt x3 (cin (cdm F) D) (co (cfv (cv x3) F) (cfv (cv x3) G) cdiv)) $ >
  $ wi ph (wcel (cdm H) S) $;

--| The domain of the sup function is defined in Proposition 121F (b) of [Fremlin1], p. 38. Note that this definition of the sup function is quite general, as it does not require the original functions to be sigma-measurable, and it could be applied to uncountable sets of functions. The equality proved here is part of the proof of the fourth statement of Proposition 121H in [Fremlin1], p. 39. (Contributed by Glauco Siliprandi, 24-Jan-2025.)
theorem fsupdm {x3 y1 m n: setvar} (ph: wff x3 m n) (D: class x3 y1 n) (F: class x3 n) (H: class x3 m n) (Z: class):
  $ wnf n ph $ >
  $ wnf x3 ph $ >
  $ wnf m ph $ >
  $ wnfc x3 F $ >
  $ wi (wa ph (wcel (cv n) Z)) (wf (cdm (cfv (cv n) F)) cxr (cfv (cv n) F)) $ >
  $ wceq D (crab x3 (wrex y1 (wral n (wbr (cfv (cv x3) (cfv (cv n) F)) (cv y1) cle) Z) cr) (ciin n Z (cdm (cfv (cv n) F)))) $ >
  $ wceq H (cmpt n Z (cmpt m cn (crab x3 (wbr (cfv (cv x3) (cfv (cv n) F)) (cv m) clt) (cdm (cfv (cv n) F))))) $ >
  $ wi ph (wceq D (ciun m cn (ciin n Z (cfv (cv m) (cfv (cv n) H))))) $;

--| The domain of the sup function is defined in Proposition 121F (b) of [Fremlin1], p. 38. Note that this definition of the sup function is quite general, as it does not require the original functions to be sigma-measurable, and it could be applied to uncountable sets of functions. The equality proved here is part of the proof of the fourth statement of Proposition 121H in [Fremlin1], p. 39. (Contributed by Glauco Siliprandi, 24-Jan-2025.)
theorem fsupdm2 {x3 y1 m n: setvar} (ph: wff x3 m n) (D: class x3 y1 n) (F: class x3 n) (G: class x3 y1 m n) (H: class x3 m n) (Z: class):
  $ wnf n ph $ >
  $ wnf x3 ph $ >
  $ wnf m ph $ >
  $ wnfc x3 F $ >
  $ wi (wa ph (wcel (cv n) Z)) (wf (cdm (cfv (cv n) F)) cxr (cfv (cv n) F)) $ >
  $ wceq D (crab x3 (wrex y1 (wral n (wbr (cfv (cv x3) (cfv (cv n) F)) (cv y1) cle) Z) cr) (ciin n Z (cdm (cfv (cv n) F)))) $ >
  $ wceq G (cmpt x3 D (csup (crn (cmpt n Z (cfv (cv x3) (cfv (cv n) F)))) cr clt)) $ >
  $ wceq H (cmpt n Z (cmpt m cn (crab x3 (wbr (cfv (cv x3) (cfv (cv n) F)) (cv m) clt) (cdm (cfv (cv n) F))))) $ >
  $ wi ph (wceq (cdm G) (ciun m cn (ciin n Z (cfv (cv m) (cfv (cv n) H))))) $;

--| If a countable set of sigma-measurable functions have domains in the sigma-algebra, then their supremum function has the domain in the sigma-algebra. This is the fourth statement of Proposition 121H of [Fremlin1] p. 39 . (Contributed by Glauco Siliprandi, 24-Jan-2025.)
theorem smfsupdmmbllem {x3 y1 m n: setvar} (ph: wff x3 m n) (D: class x3 y1 n) (S: class x3 y1) (F: class x3 n) (G: class x3 y1 m n) (H: class x3 m n) (M: class x3 y1 m n) (Z: class):
  $ wnf n ph $ >
  $ wnf x3 ph $ >
  $ wnf m ph $ >
  $ wnfc x3 F $ >
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wf Z (cfv S csmblfn) F) $ >
  $ wi (wa ph (wcel (cv n) Z)) (wcel (cdm (cfv (cv n) F)) S) $ >
  $ wceq D (crab x3 (wrex y1 (wral n (wbr (cfv (cv x3) (cfv (cv n) F)) (cv y1) cle) Z) cr) (ciin n Z (cdm (cfv (cv n) F)))) $ >
  $ wceq H (cmpt n Z (cmpt m cn (crab x3 (wbr (cfv (cv x3) (cfv (cv n) F)) (cv m) clt) (cdm (cfv (cv n) F))))) $ >
  $ wceq G (cmpt x3 D (csup (crn (cmpt n Z (cfv (cv x3) (cfv (cv n) F)))) cr clt)) $ >
  $ wi ph (wcel (cdm G) S) $;

--| If a countable set of sigma-measurable functions have domains in the sigma-algebra, then their supremum function has the domain in the sigma-algebra. This is the fourth statement of Proposition 121H of [Fremlin1] p. 39 . (Contributed by Glauco Siliprandi, 24-Jan-2025.)
theorem smfsupdmmbl {x3 y1 n: setvar} (ph: wff x3 n) (D: class x3 y1 n) (S: class x3 y1) (F: class x3 n) (G M: class x3 y1 n) (Z: class):
  $ wnf n ph $ >
  $ wnf x3 ph $ >
  $ wnfc x3 F $ >
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wf Z (cfv S csmblfn) F) $ >
  $ wi (wa ph (wcel (cv n) Z)) (wcel (cdm (cfv (cv n) F)) S) $ >
  $ wceq D (crab x3 (wrex y1 (wral n (wbr (cfv (cv x3) (cfv (cv n) F)) (cv y1) cle) Z) cr) (ciin n Z (cdm (cfv (cv n) F)))) $ >
  $ wceq G (cmpt x3 D (csup (crn (cmpt n Z (cfv (cv x3) (cfv (cv n) F)))) cr clt)) $ >
  $ wi ph (wcel (cdm G) S) $;

--| The domain of the inf function is defined in Proposition 121F (c) of [Fremlin1], p. 39. See ~ smfinf . Note that this definition of the inf function is quite general, as it does not require the original functions to be sigma-measurable, and it could be applied to uncountable sets of functions. The equality proved here is part of the proof of the fifth statement of Proposition 121H in [Fremlin1], p. 39. (Contributed by Glauco Siliprandi, 1-Feb-2025.)
theorem finfdm {x3 y1 m n: setvar} (ph: wff x3 m n) (D: class x3 y1 n) (F: class x3 n) (H: class x3 m n) (Z: class):
  $ wnf n ph $ >
  $ wnf x3 ph $ >
  $ wnf m ph $ >
  $ wnfc x3 F $ >
  $ wi (wa ph (wcel (cv n) Z)) (wf (cdm (cfv (cv n) F)) cxr (cfv (cv n) F)) $ >
  $ wceq D (crab x3 (wrex y1 (wral n (wbr (cv y1) (cfv (cv x3) (cfv (cv n) F)) cle) Z) cr) (ciin n Z (cdm (cfv (cv n) F)))) $ >
  $ wceq H (cmpt n Z (cmpt m cn (crab x3 (wbr (cneg (cv m)) (cfv (cv x3) (cfv (cv n) F)) clt) (cdm (cfv (cv n) F))))) $ >
  $ wi ph (wceq D (ciun m cn (ciin n Z (cfv (cv m) (cfv (cv n) H))))) $;

--| The domain of the inf function is defined in Proposition 121F (c) of [Fremlin1], p. 39. See ~ smfinf . Note that this definition of the inf function is quite general, as it does not require the original functions to be sigma-measurable, and it could be applied to uncountable sets of functions. The equality proved here is part of the proof of the fifth statement of Proposition 121H in [Fremlin1], p. 39. (Contributed by Glauco Siliprandi, 1-Feb-2025.)
theorem finfdm2 {x3 y1 m n: setvar} (ph: wff x3 m n) (D: class x3 y1 n) (F: class x3 n) (G: class x3 y1 m n) (H: class x3 m n) (Z: class):
  $ wnf n ph $ >
  $ wnf x3 ph $ >
  $ wnf m ph $ >
  $ wnfc x3 F $ >
  $ wi (wa ph (wcel (cv n) Z)) (wf (cdm (cfv (cv n) F)) cxr (cfv (cv n) F)) $ >
  $ wceq D (crab x3 (wrex y1 (wral n (wbr (cv y1) (cfv (cv x3) (cfv (cv n) F)) cle) Z) cr) (ciin n Z (cdm (cfv (cv n) F)))) $ >
  $ wceq G (cmpt x3 D (cinf (crn (cmpt n Z (cfv (cv x3) (cfv (cv n) F)))) cr clt)) $ >
  $ wceq H (cmpt n Z (cmpt m cn (crab x3 (wbr (cneg (cv m)) (cfv (cv x3) (cfv (cv n) F)) clt) (cdm (cfv (cv n) F))))) $ >
  $ wi ph (wceq (cdm G) (ciun m cn (ciin n Z (cfv (cv m) (cfv (cv n) H))))) $;

--| If a countable set of sigma-measurable functions have domains in the sigma-algebra, then their infimum function has the domain in the sigma-algebra. This is the fifth statement of Proposition 121H of [Fremlin1] p. 39 . (Contributed by Glauco Siliprandi, 1-Feb-2025.)
theorem smfinfdmmbllem {x3 y1 m n: setvar} (ph: wff x3 m n) (D: class x3 y1 n) (S: class x3 y1) (F: class x3 n) (G: class x3 y1 m n) (H: class x3 m n) (M: class x3 y1 m n) (Z: class):
  $ wnf n ph $ >
  $ wnf x3 ph $ >
  $ wnf m ph $ >
  $ wnfc x3 F $ >
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wf Z (cfv S csmblfn) F) $ >
  $ wi (wa ph (wcel (cv n) Z)) (wcel (cdm (cfv (cv n) F)) S) $ >
  $ wceq D (crab x3 (wrex y1 (wral n (wbr (cv y1) (cfv (cv x3) (cfv (cv n) F)) cle) Z) cr) (ciin n Z (cdm (cfv (cv n) F)))) $ >
  $ wceq G (cmpt x3 D (cinf (crn (cmpt n Z (cfv (cv x3) (cfv (cv n) F)))) cr clt)) $ >
  $ wceq H (cmpt n Z (cmpt m cn (crab x3 (wbr (cneg (cv m)) (cfv (cv x3) (cfv (cv n) F)) clt) (cdm (cfv (cv n) F))))) $ >
  $ wi ph (wcel (cdm G) S) $;

--| If a countable set of sigma-measurable functions have domains in the sigma-algebra, then their infimum function has the domain in the sigma-algebra. This is the fifth statement of Proposition 121H of [Fremlin1] p. 39 . (Contributed by Glauco Siliprandi, 1-Feb-2025.)
theorem smfinfdmmbl {x3 y1 n: setvar} (ph: wff x3 n) (D: class x3 y1 n) (S: class x3 y1) (F: class x3 n) (G M: class x3 y1 n) (Z: class):
  $ wnf n ph $ >
  $ wnf x3 ph $ >
  $ wnfc x3 F $ >
  $ wi ph (wcel M cz) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel S csalg) $ >
  $ wi ph (wf Z (cfv S csmblfn) F) $ >
  $ wi (wa ph (wcel (cv n) Z)) (wcel (cdm (cfv (cv n) F)) S) $ >
  $ wceq D (crab x3 (wrex y1 (wral n (wbr (cv y1) (cfv (cv x3) (cfv (cv n) F)) cle) Z) cr) (ciin n Z (cdm (cfv (cv n) F)))) $ >
  $ wceq G (cmpt x3 D (cinf (crn (cmpt n Z (cfv (cv x3) (cfv (cv n) F)))) cr clt)) $ >
  $ wi ph (wcel (cdm G) S) $;

--| Define the signed area by treating complex numbers as vectors with two components. (Contributed by Saveliy Skresanov, 19-Sep-2017.)
theorem sigarval {x3 y1: setvar} (A2 B2: class) (G: class x3 y1):
  $ wceq G (cmpo x3 y1 cc cc (cfv (co (cfv (cv x3) ccj) (cv y1) cmul) cim)) $ >
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co A2 B2 G) (cfv (co (cfv A2 ccj) B2 cmul) cim)) $;

--| Signed area takes value in reals. (Contributed by Saveliy Skresanov, 19-Sep-2017.)
theorem sigarim {x3 y1: setvar} (A2 B2: class) (G: class x3 y1):
  $ wceq G (cmpo x3 y1 cc cc (cfv (co (cfv (cv x3) ccj) (cv y1) cmul) cim)) $ >
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wcel (co A2 B2 G) cr) $;

--| Signed area is anticommutative. (Contributed by Saveliy Skresanov, 19-Sep-2017.)
theorem sigarac {x3 y1: setvar} (A2 B2: class) (G: class x3 y1):
  $ wceq G (cmpo x3 y1 cc cc (cfv (co (cfv (cv x3) ccj) (cv y1) cmul) cim)) $ >
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co A2 B2 G) (cneg (co B2 A2 G))) $;

--| Signed area is additive by the first argument. (Contributed by Saveliy Skresanov, 19-Sep-2017.)
theorem sigaraf {x3 y1: setvar} (A2 B2 C: class) (G: class x3 y1):
  $ wceq G (cmpo x3 y1 cc cc (cfv (co (cfv (cv x3) ccj) (cv y1) cmul) cim)) $ >
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co A2 C caddc) B2 G) (co (co A2 B2 G) (co C B2 G) caddc)) $;

--| Signed area is additive (with respect to subtraction) by the first argument. (Contributed by Saveliy Skresanov, 19-Sep-2017.)
theorem sigarmf {x3 y1: setvar} (A2 B2 C: class) (G: class x3 y1):
  $ wceq G (cmpo x3 y1 cc cc (cfv (co (cfv (cv x3) ccj) (cv y1) cmul) cim)) $ >
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co A2 C cmin) B2 G) (co (co A2 B2 G) (co C B2 G) cmin)) $;

--| Signed area is additive by the second argument. (Contributed by Saveliy Skresanov, 19-Sep-2017.)
theorem sigaras {x3 y1: setvar} (A2 B2 C: class) (G: class x3 y1):
  $ wceq G (cmpo x3 y1 cc cc (cfv (co (cfv (cv x3) ccj) (cv y1) cmul) cim)) $ >
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co A2 (co B2 C caddc) G) (co (co A2 B2 G) (co A2 C G) caddc)) $;

--| Signed area is additive (with respect to subtraction) by the second argument. (Contributed by Saveliy Skresanov, 19-Sep-2017.)
theorem sigarms {x3 y1: setvar} (A2 B2 C: class) (G: class x3 y1):
  $ wceq G (cmpo x3 y1 cc cc (cfv (co (cfv (cv x3) ccj) (cv y1) cmul) cim)) $ >
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co A2 (co B2 C cmin) G) (co (co A2 B2 G) (co A2 C G) cmin)) $;

--| Signed area is linear by the second argument. (Contributed by Saveliy Skresanov, 19-Sep-2017.)
theorem sigarls {x3 y1: setvar} (A2 B2 C: class) (G: class x3 y1):
  $ wceq G (cmpo x3 y1 cc cc (cfv (co (cfv (cv x3) ccj) (cv y1) cmul) cim)) $ >
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cr)) (wceq (co A2 (co B2 C cmul) G) (co (co A2 B2 G) C cmul)) $;

--| Signed area of a flat parallelogram is zero. (Contributed by Saveliy Skresanov, 20-Sep-2017.)
theorem sigarid {x3 y1: setvar} (A2: class) (G: class x3 y1):
  $ wceq G (cmpo x3 y1 cc cc (cfv (co (cfv (cv x3) ccj) (cv y1) cmul) cim)) $ >
  $ wi (wcel A2 cc) (wceq (co A2 A2 G) cc0) $;

--| Expand the signed area formula by linearity. (Contributed by Saveliy Skresanov, 20-Sep-2017.)
theorem sigarexp {x3 y1: setvar} (A2 B2 C: class) (G: class x3 y1):
  $ wceq G (cmpo x3 y1 cc cc (cfv (co (cfv (cv x3) ccj) (cv y1) cmul) cim)) $ >
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co A2 C cmin) (co B2 C cmin) G) (co (co (co A2 B2 G) (co A2 C G) cmin) (co C B2 G) cmin)) $;

--| Signed area ` ( A - C ) G ( B - C ) ` acts as a double area of a triangle ` A B C ` . Here we prove that cyclically permuting the vertices doesn't change the area. (Contributed by Saveliy Skresanov, 20-Sep-2017.)
theorem sigarperm {x3 y1: setvar} (A2 B2 C: class) (G: class x3 y1):
  $ wceq G (cmpo x3 y1 cc cc (cfv (co (cfv (cv x3) ccj) (cv y1) cmul) cim)) $ >
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co A2 C cmin) (co B2 C cmin) G) (co (co B2 A2 cmin) (co C A2 cmin) G)) $;

--| If signed area between vectors ` B - A ` and ` C - A ` is zero, then those vectors lie on the same line. (Contributed by Saveliy Skresanov, 22-Sep-2017.)
theorem sigardiv {x3 y1: setvar} (ph: wff x3 y1) (A2 B2 C: class) (G: class x3 y1):
  $ wceq G (cmpo x3 y1 cc cc (cfv (co (cfv (cv x3) ccj) (cv y1) cmul) cim)) $ >
  $ wi ph (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) $ >
  $ wi ph (wn (wceq C A2)) $ >
  $ wi ph (wceq (co (co B2 A2 cmin) (co C A2 cmin) G) cc0) $ >
  $ wi ph (wcel (co (co B2 A2 cmin) (co C A2 cmin) cdiv) cr) $;

--| Signed area takes value in complex numbers. Deduction version. (Contributed by Saveliy Skresanov, 23-Sep-2017.)
theorem sigarimcd {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class) (G: class x3 y1):
  $ wceq G (cmpo x3 y1 cc cc (cfv (co (cfv (cv x3) ccj) (cv y1) cmul) cim)) $ >
  $ wi ph (wa (wcel A2 cc) (wcel B2 cc)) $ >
  $ wi ph (wcel (co A2 B2 G) cc) $;

--| If signed area is zero, the signed area with swapped arguments is also zero. Deduction version. (Contributed by Saveliy Skresanov, 23-Sep-2017.)
theorem sigariz {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class) (G: class x3 y1):
  $ wceq G (cmpo x3 y1 cc cc (cfv (co (cfv (cv x3) ccj) (cv y1) cmul) cim)) $ >
  $ wi ph (wa (wcel A2 cc) (wcel B2 cc)) $ >
  $ wi ph (wceq (co A2 B2 G) cc0) $ >
  $ wi ph (wceq (co B2 A2 G) cc0) $;

--| Given three points ` A ` , ` B ` and ` C ` such that ` -. A = B ` , the point ` C ` lies on the line going through ` A ` and ` B ` iff the corresponding signed area is zero. That justifies the usage of signed area as a collinearity indicator. (Contributed by Saveliy Skresanov, 22-Sep-2017.)
theorem sigarcol {x3 y1 t: setvar} (ph: wff x3 y1) (A2 B2 C: class) (G: class x3 y1):
  $ wceq G (cmpo x3 y1 cc cc (cfv (co (cfv (cv x3) ccj) (cv y1) cmul) cim)) $ >
  $ wi ph (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) $ >
  $ wi ph (wn (wceq A2 B2)) $ >
  $ wi ph (wb (wceq (co (co A2 C cmin) (co B2 C cmin) G) cc0) (wrex t (wceq C (co B2 (co (cv t) (co A2 B2 cmin) cmul) caddc)) cr)) $;

--| Let ` A B C ` be a triangle, and let ` D ` lie on the line ` A B ` . Then (doubled) areas of triangles ` A D C ` and ` C D B ` relate as lengths of corresponding bases ` A D ` and ` D B ` . (Contributed by Saveliy Skresanov, 23-Sep-2017.)
theorem sharhght {x3 y1: setvar} (ph: wff x3 y1) (A2 B2 C D: class) (G: class x3 y1):
  $ wceq G (cmpo x3 y1 cc cc (cfv (co (cfv (cv x3) ccj) (cv y1) cmul) cim)) $ >
  $ wi ph (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) $ >
  $ wi ph (wa (wcel D cc) (wceq (co (co A2 D cmin) (co B2 D cmin) G) cc0)) $ >
  $ wi ph (wceq (co (co (co C A2 cmin) (co D A2 cmin) G) (co B2 D cmin) cmul) (co (co (co C B2 cmin) (co D B2 cmin) G) (co A2 D cmin) cmul)) $;

--| Subtracting (double) area of ` A D C ` from ` A B C ` yields the (double) area of ` D B C ` . (Contributed by Saveliy Skresanov, 23-Sep-2017.)
theorem sigaradd {x3 y1: setvar} (ph: wff x3 y1) (A2 B2 C D: class) (G: class x3 y1):
  $ wceq G (cmpo x3 y1 cc cc (cfv (co (cfv (cv x3) ccj) (cv y1) cmul) cim)) $ >
  $ wi ph (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) $ >
  $ wi ph (wa (wcel D cc) (wceq (co (co A2 D cmin) (co B2 D cmin) G) cc0)) $ >
  $ wi ph (wceq (co (co (co B2 C cmin) (co A2 C cmin) G) (co (co D C cmin) (co A2 C cmin) G) cmin) (co (co B2 C cmin) (co D C cmin) G)) $;

--| Ceva's theorem first lemma. Multiplies three identities and divides by the common factors. (Contributed by Saveliy Skresanov, 24-Sep-2017.)
theorem cevathlem1 (ph: wff) (A2 B2 C D E F G H K: class):
  $ wi ph (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) $ >
  $ wi ph (w3a (wcel D cc) (wcel E cc) (wcel F cc)) $ >
  $ wi ph (w3a (wcel G cc) (wcel H cc) (wcel K cc)) $ >
  $ wi ph (w3a (wne A2 cc0) (wne E cc0) (wne C cc0)) $ >
  $ wi ph (w3a (wceq (co A2 B2 cmul) (co C D cmul)) (wceq (co E F cmul) (co A2 G cmul)) (wceq (co C H cmul) (co E K cmul))) $ >
  $ wi ph (wceq (co (co B2 F cmul) H cmul) (co (co D G cmul) K cmul)) $;

--| Ceva's theorem second lemma. Relate (doubled) areas of triangles ` C A O ` and ` A B O ` with of segments ` B D ` and ` D C ` . (Contributed by Saveliy Skresanov, 24-Sep-2017.)
theorem cevathlem2 {x3 y1: setvar} (ph: wff x3 y1) (A2 B2 C D E F: class) (G: class x3 y1) (O: class):
  $ wceq G (cmpo x3 y1 cc cc (cfv (co (cfv (cv x3) ccj) (cv y1) cmul) cim)) $ >
  $ wi ph (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) $ >
  $ wi ph (w3a (wcel F cc) (wcel D cc) (wcel E cc)) $ >
  $ wi ph (wcel O cc) $ >
  $ wi ph (w3a (wceq (co (co A2 O cmin) (co D O cmin) G) cc0) (wceq (co (co B2 O cmin) (co E O cmin) G) cc0) (wceq (co (co C O cmin) (co F O cmin) G) cc0)) $ >
  $ wi ph (w3a (wceq (co (co A2 F cmin) (co B2 F cmin) G) cc0) (wceq (co (co B2 D cmin) (co C D cmin) G) cc0) (wceq (co (co C E cmin) (co A2 E cmin) G) cc0)) $ >
  $ wi ph (w3a (wne (co (co A2 O cmin) (co B2 O cmin) G) cc0) (wne (co (co B2 O cmin) (co C O cmin) G) cc0) (wne (co (co C O cmin) (co A2 O cmin) G) cc0)) $ >
  $ wi ph (wceq (co (co (co C O cmin) (co A2 O cmin) G) (co B2 D cmin) cmul) (co (co (co A2 O cmin) (co B2 O cmin) G) (co D C cmin) cmul)) $;

--| Ceva's theorem. Let ` A B C ` be a triangle and let points ` F ` , ` D ` and ` E ` lie on sides ` A B ` , ` B C ` , ` C A ` correspondingly. Suppose that cevians ` A D ` , ` B E ` and ` C F ` intersect at one point ` O ` . Then triangle's sides are partitioned into segments and their lengths satisfy a certain identity. Here we obtain a bit stronger version by using complex numbers themselves instead of their absolute values. The proof goes by applying ~ cevathlem2 three times and then using ~ cevathlem1 to multiply obtained identities and prove the theorem. In the theorem statement we are using function ` G ` as a collinearity indicator. For justification of that use, see ~ sigarcol . This is Metamath 100 proof #61. (Contributed by Saveliy Skresanov, 24-Sep-2017.)
theorem cevath {x3 y1: setvar} (ph: wff x3 y1) (A2 B2 C D E F: class) (G: class x3 y1) (O: class):
  $ wceq G (cmpo x3 y1 cc cc (cfv (co (cfv (cv x3) ccj) (cv y1) cmul) cim)) $ >
  $ wi ph (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) $ >
  $ wi ph (w3a (wcel F cc) (wcel D cc) (wcel E cc)) $ >
  $ wi ph (wcel O cc) $ >
  $ wi ph (w3a (wceq (co (co A2 O cmin) (co D O cmin) G) cc0) (wceq (co (co B2 O cmin) (co E O cmin) G) cc0) (wceq (co (co C O cmin) (co F O cmin) G) cc0)) $ >
  $ wi ph (w3a (wceq (co (co A2 F cmin) (co B2 F cmin) G) cc0) (wceq (co (co B2 D cmin) (co C D cmin) G) cc0) (wceq (co (co C E cmin) (co A2 E cmin) G) cc0)) $ >
  $ wi ph (w3a (wne (co (co A2 O cmin) (co B2 O cmin) G) cc0) (wne (co (co B2 O cmin) (co C O cmin) G) cc0) (wne (co (co C O cmin) (co A2 O cmin) G) cc0)) $ >
  $ wi ph (wceq (co (co (co A2 F cmin) (co C E cmin) cmul) (co B2 D cmin) cmul) (co (co (co F B2 cmin) (co E A2 cmin) cmul) (co D C cmin) cmul)) $;

--| The center of a simple group is trivial or the group is abelian. (Contributed by SS, 3-Jan-2024.)
theorem simpcntrab (ph: wff) (B2 G c_0 Z: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq c_0 (cfv G c0g) $ >
  $ wceq Z (cfv G ccntr) $ >
  $ wi ph (wcel G csimpg) $ >
  $ wi ph (wo (wceq Z (csn c_0)) (wcel G cabl)) $;

--| Less-than class is never reflexive. (Contributed by Ender Ting, 22-Nov-2024.) Prefer to specify theorem domain and then apply ~ ltnri . (New usage is discouraged.)
theorem et_ltneverrefl (A2: class):
  $ wn (wbr A2 A2 clt) $;

--| Alternative proof that equality is left-Euclidean, using ~ ax7 directly instead of utility theorems; done for practice. (Contributed by Ender Ting, 21-Dec-2024.)
theorem et_equeucl (x3 y1 z: setvar):
  $ wi (wceq (cv x3) (cv z)) (wi (wceq (cv y1) (cv z)) (wceq (cv x3) (cv y1))) $;

--| The square root of a negative number is not a real number. (Contributed by Ender Ting, 5-Jan-2025.)
theorem et_sqrtnegnre (A2: class):
  $ wi (wa (wcel A2 cr) (wbr A2 cc0 clt)) (wn (wcel (cfv A2 csqrt) cr)) $;

--| There can be no formula asserting its own non-universality, in parallel to ~ bj-babygodel ; proof path is shorter but relying on a property of specialization which provability predicates do not have. For a matching proof, see ~ quantgodelALT . (Contributed by Ender Ting, 9-May-2026.)
theorem quantgodel {x3: setvar} (ph: wff x3):
  $ wb ph (wn (wal x3 ph)) $ >
  $ wfal $;

--| There can be no formula asserting its own non-universality; follows the steps of ~ bj-babygodel . (Contributed by Ender Ting, 7-May-2026.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem quantgodelALT {x3: setvar} (ph: wff x3):
  $ wb ph (wn (wal x3 ph)) $ >
  $ wfal $;

--| If elements of a certain sequence are ordered with respect to a certain relation, then its consecutive elements satisfy that relation (so-called "local monotonicity"). (Contributed by Ender Ting, 30-Apr-2025.)
theorem ormklocald {t k: setvar} (ph: wff) (B2 R: class k) (S: class t k) (T: class k):
  $ wi ph (wor S R) $ >
  $ wi ph (wral k (wcel (cfv (cv k) B2) S) (co cc0 (co T c1 caddc) cfzo)) $ >
  $ wi ph (wral k (wral t (wi (wbr (cv k) (cv t) clt) (wbr (cfv (cv k) B2) (cfv (cv t) B2) R)) (co c1 (co T c1 caddc) cfzo)) (co cc0 T cfzo)) $ >
  $ wi ph (wral k (wbr (cfv (cv k) B2) (cfv (co (cv k) c1 caddc) B2) R) (co cc0 T cfzo)) $;

--| If all adjacent elements of a certain sequence are ordered according to a relation which is a total order on S, then any element is so related to anything to right of it (so-called "global monotonicity"). Deduction form. (Contributed by Ender Ting, 30-Apr-2025.)
theorem ormkglobd {t k: setvar} (ph: wff) (B2 R S: class t) (T: class):
  $ wi ph (wor S R) $ >
  $ wi ph (wral k (wcel (cfv (cv k) B2) S) (co cc0 (co T c1 caddc) cfzo)) $ >
  $ wi ph (wral k (wbr (cfv (cv k) B2) (cfv (co (cv k) c1 caddc) B2) R) (co cc0 T cfzo)) $ >
  $ wi ph (wral k (wral t (wi (wbr (cv k) (cv t) clt) (wbr (cfv (cv k) B2) (cfv (cv t) B2) R)) (co c1 (co T c1 caddc) cfzo)) (co cc0 T cfzo)) $;

--| A subsequence of a chain is a word. (Contributed by Ender Ting, 22-Jan-2026.)
theorem chnsubseqword (ph: wff) (A2 c_lt I W: class):
  $ wi ph (wcel W (cchn A2 c_lt)) $ >
  $ wi ph (wcel I (cchn (co cc0 (cfv W chash) cfzo) clt)) $ >
  $ wi ph (wcel (ccom W I) (cword A2)) $;

--| A subsequence of a chain has the same length as its indexing sequence. (Contributed by Ender Ting, 22-Jan-2026.)
theorem chnsubseqwl (ph: wff) (A2 c_lt I W: class):
  $ wi ph (wcel W (cchn A2 c_lt)) $ >
  $ wi ph (wcel I (cchn (co cc0 (cfv W chash) cfzo) clt)) $ >
  $ wi ph (wceq (cfv (ccom W I) chash) (cfv I chash)) $;

--| An order-preserving subsequence of an ordered chain is itself a chain. (Contributed by Ender Ting, 22-Jan-2026.)
theorem chnsubseq (ph: wff) (A2 c_lt I W: class):
  $ wi ph (wcel W (cchn A2 c_lt)) $ >
  $ wi ph (wcel I (cchn (co cc0 (cfv W chash) cfzo) clt)) $ >
  $ wi ph (wpo A2 c_lt) $ >
  $ wi ph (wcel (ccom W I) (cchn A2 c_lt)) $;

--| Length of a subsequence is bounded by the length of original chain. (Contributed by Ender Ting, 30-Jan-2026.)
theorem chnsuslle (ph: wff) (A2 c_lt I W: class):
  $ wi ph (wcel W (cchn A2 c_lt)) $ >
  $ wi ph (wcel I (cchn (co cc0 (cfv W chash) cfzo) clt)) $ >
  $ wi ph (wpo A2 c_lt) $ >
  $ wi ph (wbr (cfv (ccom W I) chash) (cfv W chash) cle) $;

--| In a chain constructed on an equivalence relation, the last element is equivalent to any. This theorem is a translation of ~ chnub to equivalence relations. (Contributed by Ender Ting, 29-Jan-2026.)
theorem chnerlem1 (ph: wff) (A2 C c_sm J: class):
  $ wi ph (wer A2 c_sm) $ >
  $ wi ph (wcel C (cchn A2 c_sm)) $ >
  $ wi ph (wcel J (co cc0 (cfv C chash) cfzo)) $ >
  $ wi ph (wbr (cfv J C) (cfv C clsw) c_sm) $;

--| Lemma for ~ chner where the I-th element comes before the J-th. (Contributed by Ender Ting, 29-Jan-2026.)
theorem chnerlem2 (ph: wff) (A2 C c_sm I J: class):
  $ wi ph (wer A2 c_sm) $ >
  $ wi ph (wcel C (cchn A2 c_sm)) $ >
  $ wi ph (wcel J (co cc0 (cfv C chash) cfzo)) $ >
  $ wi (wa ph (wcel I (co cc0 J cfzo))) (wbr (cfv I C) (cfv J C) c_sm) $;

--| Lemma for ~ chner - trichotomy of integers within the word's domain. (Contributed by Ender Ting, 29-Jan-2026.)
theorem chnerlem3 (ph: wff) (A2 C c_sm I J: class):
  $ wi ph (wer A2 c_sm) $ >
  $ wi ph (wcel C (cchn A2 c_sm)) $ >
  $ wi ph (wcel J (co cc0 (cfv C chash) cfzo)) $ >
  $ wi ph (wcel I (co cc0 (cfv C chash) cfzo)) $ >
  $ wi ph (w3o (wcel I (co cc0 J cfzo)) (wcel J (co cc0 I cfzo)) (wceq I J)) $;

--| Any two elements are equivalent in a chain constructed on an equivalence relation. (Contributed by Ender Ting, 29-Jan-2026.)
theorem chner (ph: wff) (A2 C c_sm I J: class):
  $ wi ph (wer A2 c_sm) $ >
  $ wi ph (wcel C (cchn A2 c_sm)) $ >
  $ wi ph (wcel J (co cc0 (cfv C chash) cfzo)) $ >
  $ wi ph (wcel I (co cc0 (cfv C chash) cfzo)) $ >
  $ wi ph (wbr (cfv I C) (cfv J C) c_sm) $;

--| A word in two alphabets is also a word under their intersection. (Contributed by Ender Ting, 24-Jul-2026.)
theorem wrddin (A2 B2 C: class):
  $ wi (wa (wcel A2 (cword B2)) (wcel A2 (cword C))) (wcel A2 (cword (cin B2 C))) $;

--| A word whose alphabet is intersection of two classes is also a word in each of those alphabets. (Contributed by Ender Ting, 24-Jul-2026.)
theorem wrddrin (A2 B2 C: class):
  $ wi (wcel A2 (cword (cin B2 C))) (wa (wcel A2 (cword B2)) (wcel A2 (cword C))) $;

--| Distribution of word class constructor over class intersection. (Contributed by Ender Ting, 24-Jul-2026.)
theorem wrddin2 (B2 C: class):
  $ wceq (cword (cin B2 C)) (cin (cword B2) (cword C)) $;

--| Words in either of two alphabets are words in their union. (Contributed by Ender Ting, 24-Jul-2026.)
theorem wrddun (A2 B2 C: class):
  $ wi (wo (wcel A2 (cword B2)) (wcel A2 (cword C))) (wcel A2 (cword (cun B2 C))) $;

--| Superadditivity of word constructor. Class of words over union alphabet includes all words over either alphabet in the union; if ` B ` and ` C ` are non-empty and different, then this subclass relation is strict because of the words which have symbols both from ` B ` and from ` C ` . (Contributed by Ender Ting, 24-Jul-2026.)
theorem wrddun2 (B2 C: class):
  $ wss (cun (cword B2) (cword C)) (cword (cun B2 C)) $;

--| A chain in two alphabets at once is also a chain in their intersection. (Contributed by Ender Ting, 24-Jul-2026.)
theorem chndin (A2 B2 C R: class):
  $ wi (wa (wcel A2 (cchn B2 R)) (wcel A2 (cchn C R))) (wcel A2 (cchn (cin B2 C) R)) $;

--| A chain whose alphabet is intersection of two classes is also a chain in each of those alphabets. (Contributed by Ender Ting, 24-Jul-2026.)
theorem chndrin (A2 B2 C R: class):
  $ wi (wcel A2 (cchn (cin B2 C) R)) (wa (wcel A2 (cchn B2 R)) (wcel A2 (cchn C R))) $;

--| Distribution of chain class constructor over alphabet intersection. (Contributed by Ender Ting, 24-Jul-2026.)
theorem chndin2 (B2 C R: class):
  $ wceq (cchn (cin B2 C) R) (cin (cchn B2 R) (cchn C R)) $;

--| Chains in either of two alphabets are chains in their union. (Contributed by Ender Ting, 24-Jul-2026.)
theorem chndun (A2 B2 C R: class):
  $ wi (wo (wcel A2 (cchn B2 R)) (wcel A2 (cchn C R))) (wcel A2 (cchn (cun B2 C) R)) $;

--| Superaddivity of chain constructor over alphabet parameter. (Contributed by Ender Ting, 24-Jul-2026.)
theorem chndun2 (B2 C R: class):
  $ wss (cun (cchn B2 R) (cchn C R)) (cchn (cun B2 C) R) $;

--| Satisfying two chain relations makes a chain under their intersection. (Contributed by Ender Ting, 24-Jul-2026.)
theorem chnrin (A2 B2 R c_lt: class):
  $ wi (wa (wcel A2 (cchn B2 R)) (wcel A2 (cchn B2 c_lt))) (wcel A2 (cchn B2 (cin R c_lt))) $;

--| A chain of elements satisfying two relations at once is a chain under either of them. (Contributed by Ender Ting, 24-Jul-2026.)
theorem chnrrin (A2 B2 R c_lt: class):
  $ wi (wcel A2 (cchn B2 (cin R c_lt))) (wa (wcel A2 (cchn B2 R)) (wcel A2 (cchn B2 c_lt))) $;

--| Distribution of chain class constructor over relation intersection. (Contributed by Ender Ting, 24-Jul-2026.)
theorem chnrin2 (B2 R c_lt: class):
  $ wceq (cchn B2 (cin R c_lt)) (cin (cchn B2 R) (cchn B2 c_lt)) $;

--| Satisfying either of two chain relations is sufficient to make a chain under their union. (Contributed by Ender Ting, 24-Jul-2026.)
theorem chnrun (A2 B2 R c_lt: class):
  $ wi (wo (wcel A2 (cchn B2 R)) (wcel A2 (cchn B2 c_lt))) (wcel A2 (cchn B2 (cun R c_lt))) $;

--| Superadditivity of chain constructor over relation parameter. (Contributed by Ender Ting, 24-Jul-2026.)
theorem chnrun2 (B2 R c_lt: class):
  $ wss (cun (cchn B2 R) (cchn B2 c_lt)) (cchn B2 (cun R c_lt)) $;

--| If an integer is multiplied by its sum with an odd number (thus changing its parity), the result is even. (Contributed by Ender Ting, 30-Apr-2025.)
theorem evenwodadd (ph: wff) (I J: class):
  $ wi ph (wcel I cz) $ >
  $ wi ph (wcel J cz) $ >
  $ wi ph (wn (wbr c2 J cdvds)) $ >
  $ wi ph (wbr c2 (co I (co I J caddc) cmul) cdvds) $;

--| If a real value is squeezed between two others, its square is less than square of at least one of them. Deduction form. (Contributed by Ender Ting, 31-Oct-2025.)
theorem squeezedltsq (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wbr A2 B2 clt) $ >
  $ wi ph (wbr B2 C clt) $ >
  $ wi ph (wo (wbr (co B2 B2 cmul) (co A2 A2 cmul) clt) (wbr (co B2 B2 cmul) (co C C cmul) clt)) $;

--| Square root of a natural number is algebraic. (Contributed by Ender Ting, 21-Jul-2026.)
theorem sqrtnnaa (A2: class):
  $ wi (wcel A2 cn) (wcel (cfv A2 csqrt) caa) $;

--| Square root of a nonzero rational is algebraic. (Contributed by Ender Ting, 22-Jul-2026.)
theorem sqrtnzqaa (A2: class):
  $ wi (wa (wcel A2 cq) (wne A2 cc0)) (wcel (cfv A2 csqrt) caa) $;

--| Square root of a rational number is algebraic. (Contributed by Ender Ting, 22-Jul-2026.)
theorem sqrtqaa (A2: class):
  $ wi (wcel A2 cq) (wcel (cfv A2 csqrt) caa) $;

--| Certain number sets and fields form a tower. In particular, singleton 1, natural numbers, natural numbers with zero, integers, rationals, algebraic reals (notice that current definition allows algebraic numbers to be complex thus the restriction), reals and complex number sets are a tower of proper subsets. (Contributed by Ender Ting, 31-Jul-2026.)
theorem numtowerdt:
  $ wcel (cs8 (csn c1) cn cn0 cz cq (cin caa cr) cr cc) (cchn cvv crpss) $;

--| Triple-angle formula for sine, in pure sine form. (Contributed by Ender Ting, 16-Mar-2026.)
theorem sin3t (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv (co c3 A2 cmul) csin) (co (co c3 (cfv A2 csin) cmul) (co c4 (co (cfv A2 csin) c3 cexp) cmul) cmin)) $;

--| Triple-angle formula for cosine, in pure cosine form. (Contributed by Ender Ting, 16-Mar-2026.)
theorem cos3t (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv (co c3 A2 cmul) ccos) (co (co c4 (co (cfv A2 ccos) c3 cexp) cmul) (co c3 (cfv A2 ccos) cmul) cmin)) $;

--| Lemma 1 for quintupled angle sine calculation, expanding triple-angle sine times double-angle cosine. (Contributed by Ender Ting, 16-Mar-2026.)
theorem sin5tlem1 (N: class):
  $ wi (wcel N cc) (wceq (co (co (co c3 N cmul) (co c4 (co N c3 cexp) cmul) cmin) (co c1 (co c2 (co N c2 cexp) cmul) cmin) cmul) (co (co (co c8 (co N c5 cexp) cmul) (co (cdc c1 cc0) (co N c3 cexp) cmul) cmin) (co c3 N cmul) caddc)) $;

--| Lemma 2 for quintupled angle sine calculation, multiplicating triple angle cosine by cosine straight and converting into sine. (Contributed by Ender Ting, 16-Apr-2026.)
theorem sin5tlem2 (M N: class):
  $ wi (w3a (wcel N cc) (wcel M cc) (wceq (co N c2 cexp) (co c1 (co M c2 cexp) cmin))) (wceq (co (co (co c4 (co N c3 cexp) cmul) (co c3 N cmul) cmin) N cmul) (co (co c4 (co (co c1 (co c2 (co M c2 cexp) cmul) cmin) (co M c4 cexp) caddc) cmul) (co c3 (co c1 (co M c2 cexp) cmin) cmul) cmin)) $;

--| Lemma 3 for quintupled angle sine calculation, multiplicating triple angle cosine by double angle sine. (Contributed by Ender Ting, 16-Apr-2026.)
theorem sin5tlem3 (M N: class):
  $ wi (w3a (wcel N cc) (wcel M cc) (wceq (co N c2 cexp) (co c1 (co M c2 cexp) cmin))) (wceq (co (co (co c4 (co N c3 cexp) cmul) (co c3 N cmul) cmin) (co c2 (co M N cmul) cmul) cmul) (co (co (co c4 (co (co c1 (co c2 (co M c2 cexp) cmul) cmin) (co M c4 cexp) caddc) cmul) (co c3 (co c1 (co M c2 cexp) cmin) cmul) cmin) (co c2 M cmul) cmul)) $;

--| Lemma 4 for quintupled angle sine calculation: expanding lemma 3 result to difference of polynomials. (Contributed by Ender Ting, 17-Apr-2026.)
theorem sin5tlem4 (M N: class):
  $ wi (w3a (wcel N cc) (wcel M cc) (wceq (co N c2 cexp) (co c1 (co M c2 cexp) cmin))) (wceq (co (co (co c4 (co N c3 cexp) cmul) (co c3 N cmul) cmin) (co c2 (co M N cmul) cmul) cmul) (co (co (co (co c8 (co M c5 cexp) cmul) (co (cdc c1 c6) (co M c3 cexp) cmul) cmin) (co c8 M cmul) caddc) (co (co c6 M cmul) (co c6 (co M c3 cexp) cmul) cmin) cmin)) $;

--| Lemma 5 for quintupled angle sine calculation: sine of triple-angle and double-angle sum, as a polynomial in sine straight. (Contributed by Ender Ting, 17-Apr-2026.)
theorem sin5tlem5 (M N: class):
  $ wi (w3a (wcel N cc) (wcel M cc) (wceq (co N c2 cexp) (co c1 (co M c2 cexp) cmin))) (wceq (co (co (co (co c3 M cmul) (co c4 (co M c3 cexp) cmul) cmin) (co c1 (co c2 (co M c2 cexp) cmul) cmin) cmul) (co (co (co c4 (co N c3 cexp) cmul) (co c3 N cmul) cmin) (co c2 (co M N cmul) cmul) cmul) caddc) (co (co (co (cdc c1 c6) (co M c5 cexp) cmul) (co (cdc c2 cc0) (co M c3 cexp) cmul) cmin) (co c5 M cmul) caddc)) $;

--| Five-times-angle formula for sine, in pure sine form. (Contributed by Ender Ting, 17-Apr-2026.)
theorem sin5t (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv (co c5 A2 cmul) csin) (co (co (co (cdc c1 c6) (co (cfv A2 csin) c5 cexp) cmul) (co (cdc c2 cc0) (co (cfv A2 csin) c3 cexp) cmul) cmin) (co c5 (cfv A2 csin) cmul) caddc)) $;

--| Five-times-angle formula for cosine, in pure cosine form. (Contributed by Ender Ting, 20-Apr-2026.)
theorem cos5t (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv (co c5 A2 cmul) ccos) (co (co (co (cdc c1 c6) (co (cfv A2 ccos) c5 cexp) cmul) (co (cdc c2 cc0) (co (cfv A2 ccos) c3 cexp) cmul) cmin) (co c5 (cfv A2 ccos) cmul) caddc)) $;

--| Five-times-angle formula for cosine, substitution helper. (Contributed by Ender Ting, 9-May-2026.)
theorem cos5teq (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wceq B2 (co c5 A2 cmul)) (wceq C (cfv A2 ccos))) (wceq (cfv B2 ccos) (co (co (co (cdc c1 c6) (co C c5 cexp) cmul) (co (cdc c2 cc0) (co C c3 cexp) cmul) cmin) (co c5 C cmul) caddc)) $;

--| Factorization of a polynomial which has golden ratio among its roots, done by term-by-term-by-term multiplying and summing a few shorter polynomials. (Contributed by Ender Ting, 24-Jul-2026.)
theorem goldpolyfactor (F: class):
  $ wcel F cc $ >
  $ wceq (co (co (co (co (co F c2 cexp) F cmin) c1 cmin) (co (co (co F c2 cexp) F cmin) c1 cmin) cmul) (co F c2 caddc) cmul) (co (co (co (co F c5 cexp) (co c5 (co F c3 cexp) cmul) cmin) (co c5 F cmul) caddc) c2 caddc) $;

--| The golden ratio is a real value. (Contributed by Ender Ting, 15-Mar-2026.)
theorem goldrarr (F: class):
  $ wceq F (co c2 (cfv (co cpi c5 cdiv) ccos) cmul) $ >
  $ wcel F cr $;

--| Alternative trigonometric formula for the golden ratio. (Contributed by Ender Ting, 15-Mar-2026.)
theorem goldrasin (F: class):
  $ wceq F (co c2 (cfv (co cpi c5 cdiv) ccos) cmul) $ >
  $ wceq F (co c2 (cfv (co cpi (co c3 (cdc c1 cc0) cdiv) cmul) csin) cmul) $;

--| Golden ratio is positive. (Contributed by Ender Ting, 16-Apr-2026.)
theorem goldrapos (F: class):
  $ wceq F (co c2 (cfv (co cpi c5 cdiv) ccos) cmul) $ >
  $ wbr cc0 F clt $;

--| The golden ratio is a positive real. (Contributed by Ender Ting, 16-Apr-2026.)
theorem goldrarp (F: class):
  $ wceq F (co c2 (cfv (co cpi c5 cdiv) ccos) cmul) $ >
  $ wcel F crp $;

--| Lemma 1 for determining the value of golden ratio. (Contributed by Ender Ting, 9-May-2026.)
theorem goldracos5teq (F: class):
  $ wceq F (co c2 (cfv (co cpi c5 cdiv) ccos) cmul) $ >
  $ wceq (cfv cpi ccos) (co (co (co (cdc c1 c6) (co (co F c2 cdiv) c5 cexp) cmul) (co (cdc c2 cc0) (co (co F c2 cdiv) c3 cexp) cmul) cmin) (co c5 (co F c2 cdiv) cmul) caddc) $;

--| Lemma 2 for determining the value of golden ratio. (Contributed by Ender Ting, 9-May-2026.)
theorem goldratmolem2 (F: class):
  $ wceq F (co c2 (cfv (co cpi c5 cdiv) ccos) cmul) $ >
  $ wceq (cneg c1) (co (co (co (co F c5 cexp) c2 cdiv) (co c5 (co (co F c3 cexp) c2 cdiv) cmul) cmin) (co c5 (co F c2 cdiv) cmul) caddc) $;

--| Lemma 3 for determining the value of golden ratio. (Contributed by Ender Ting, 23-Jul-2026.)
theorem goldratmolem3 (F: class):
  $ wceq F (co c2 (cfv (co cpi c5 cdiv) ccos) cmul) $ >
  $ wceq (co (co (co (co F c5 cexp) (co c5 (co F c3 cexp) cmul) cmin) (co c5 F cmul) caddc) c2 caddc) cc0 $;

--| Lemma 4 for determining the value of golden ratio. (Contributed by Ender Ting, 24-Jul-2026.)
theorem goldratmolem4 (F: class):
  $ wceq F (co c2 (cfv (co cpi c5 cdiv) ccos) cmul) $ >
  $ wceq (co (co (co F c2 cexp) F cmin) c1 cmin) cc0 $;

--| Value of the golden ratio. (Contributed by Ender Ting, 24-Jul-2026.)
theorem goldratval (F: class):
  $ wceq F (co c2 (cfv (co cpi c5 cdiv) ccos) cmul) $ >
  $ wceq F (co (co c1 (cfv c5 csqrt) caddc) c2 cdiv) $;

--| A value of Lambert W (product logarithm) function at zero. (Contributed by Ender Ting, 13-Nov-2025.)
theorem lambert0 {x3: setvar} (R: class x3):
  $ wceq R (ccnv (cmpt x3 cc (co (cv x3) (cfv (cv x3) ce) cmul))) $ >
  $ wbr cc0 cc0 R $;

--| A value of Lambert W (product logarithm) function at ` _e ` . (Contributed by Ender Ting, 13-Nov-2025.)
theorem lamberte {x3: setvar} (R: class x3):
  $ wceq R (ccnv (cmpt x3 cc (co (cv x3) (cfv (cv x3) ce) cmul))) $ >
  $ wbr ceu c1 R $;

--| Complex conjugation operator is not a polynomial with complex coefficients. Indeed; if it was, then multiplying ` x ` conjugate by ` x ` itself and adding 1 would yield a nowhere-zero non-constant polynomial, contrary to the ~ fta . (Contributed by Ender Ting, 8-Dec-2025.)
theorem cjnpoly:
  $ wn (wcel ccj (cfv cc cply)) $;

--| The tangent function is not a polynomial with complex coefficients, as it is not defined on the whole complex plane. (Contributed by Ender Ting, 10-Dec-2025.)
theorem tannpoly:
  $ wn (wcel ctan (cfv cc cply)) $;

--| Sine function is not a polynomial with complex coefficients. Indeed, it has infinitely many zeros but is not constant zero, contrary to ~ fta1 . (Contributed by Ender Ting, 10-Dec-2025.)
theorem sinnpoly:
  $ wn (wcel csin (cfv cc cply)) $;

--| Real square root is not a polynomial with real coefficients, because its value is imaginary for negative arguments. (Contributed by Ender Ting, 22-Jul-2026.)
theorem sqrtrrnpoly:
  $ wn (wcel csqrt (cfv cr cply)) $;

--| Square root function is not polynomial with complex coefficients either. Otherwise, its composition with a square monomial - the identity - would have to be of even degree. (Contributed by Ender Ting, 22-Jul-2026.)
theorem sqrtnpoly:
  $ wn (wcel csqrt (cfv cc cply)) $;

--| The class of all tapes is a set. (Contributed by Ender Ting, 27-Jul-2026.)
theorem tmachlem_extapes {y1 z: setvar} (ph: wff) (A2 S T U I: class):
  $ wi ph (wcel U cfn) $ >
  $ wi ph (wcel I cvv) $ >
  $ wi ph (wceq T (co U I cmap)) $ >
  $ wi ph (wf T (cin (cpw I) cfn) S) $ >
  $ wi ph (wceq A2 (cmpt z T (crab y1 (wceq (cres (cv y1) (cfv (cv z) S)) (cres (cv z) (cfv (cv z) S))) T))) $ >
  $ wi ph (wral z (wral y1 (wceq (cfv (cv y1) S) (cfv (cv z) S)) (cfv (cv z) A2)) T) $ >
  $ wi ph (wcel T cvv) $;

--| Execution on any tape only scanned a finite number of cells. (Contributed by Ender Ting, 27-Jul-2026.)
theorem tmachlem_finscan {y1 z: setvar} (ph: wff) (A2 S T U I: class) (a: setvar):
  $ wi ph (wcel U cfn) $ >
  $ wi ph (wcel I cvv) $ >
  $ wi ph (wceq T (co U I cmap)) $ >
  $ wi ph (wf T (cin (cpw I) cfn) S) $ >
  $ wi ph (wceq A2 (cmpt z T (crab y1 (wceq (cres (cv y1) (cfv (cv z) S)) (cres (cv z) (cfv (cv z) S))) T))) $ >
  $ wi ph (wral z (wral y1 (wceq (cfv (cv y1) S) (cfv (cv z) S)) (cfv (cv z) A2)) T) $ >
  $ wi (wa ph (wcel (cv a) T)) (wcel (cfv (cv a) S) cfn) $;

--| Any tape belongs to its own agreement set. (Contributed by Ender Ting, 27-Jul-2026.)
theorem tmachlem_agreeself {y1 z: setvar} (ph: wff) (A2 S T U I: class) (a: setvar):
  $ wi ph (wcel U cfn) $ >
  $ wi ph (wcel I cvv) $ >
  $ wi ph (wceq T (co U I cmap)) $ >
  $ wi ph (wf T (cin (cpw I) cfn) S) $ >
  $ wi ph (wceq A2 (cmpt z T (crab y1 (wceq (cres (cv y1) (cfv (cv z) S)) (cres (cv z) (cfv (cv z) S))) T))) $ >
  $ wi ph (wral z (wral y1 (wceq (cfv (cv y1) S) (cfv (cv z) S)) (cfv (cv z) A2)) T) $ >
  $ wi (wa ph (wcel (cv a) T)) (wcel (cv a) (cfv (cv a) A2)) $;

--| Agreement set can be written as infinite product of acceptable values for tape's cells. (Contributed by Ender Ting, 27-Jul-2026.)
theorem tmachlem_agreeprod {y1 z i: setvar} (ph: wff) (A2 S T U I: class) (a: setvar):
  $ wi ph (wcel U cfn) $ >
  $ wi ph (wcel I cvv) $ >
  $ wi ph (wceq T (co U I cmap)) $ >
  $ wi ph (wf T (cin (cpw I) cfn) S) $ >
  $ wi ph (wceq A2 (cmpt z T (crab y1 (wceq (cres (cv y1) (cfv (cv z) S)) (cres (cv z) (cfv (cv z) S))) T))) $ >
  $ wi ph (wral z (wral y1 (wceq (cfv (cv y1) S) (cfv (cv z) S)) (cfv (cv z) A2)) T) $ >
  $ wi (wa ph (wcel (cv a) T)) (wceq (cfv (cv a) A2) (cixp i I (cif (wcel (cv i) (cfv (cv a) S)) (csn (cfv (cv i) (cv a))) U))) $;

--| Product (discrete) topology of tapes is compact by Tychonoff's theorem. To work for infinite index sets (such as ` ZZ ` for ` I ` which is the main interpretation), it requires Choice. (Contributed by Ender Ting, 27-Jul-2026.)
theorem tmachlem_tpcomp {y1 z i: setvar} (ph: wff) (A2 S T U I: class):
  $ wi ph (wcel U cfn) $ >
  $ wi ph (wcel I cvv) $ >
  $ wi ph (wceq T (co U I cmap)) $ >
  $ wi ph (wf T (cin (cpw I) cfn) S) $ >
  $ wi ph (wceq A2 (cmpt z T (crab y1 (wceq (cres (cv y1) (cfv (cv z) S)) (cres (cv z) (cfv (cv z) S))) T))) $ >
  $ wi ph (wral z (wral y1 (wceq (cfv (cv y1) S) (cfv (cv z) S)) (cfv (cv z) A2)) T) $ >
  $ wi ph (wcel (cfv (cmpt i I (cpw U)) cpt) ccmp) $;

--| The base set of product topology of tapes is the set of tapes. (Contributed by Ender Ting, 28-Jul-2026.)
theorem tmachlem_tpbase {y1 z i: setvar} (ph: wff) (A2 S T U I: class):
  $ wi ph (wcel U cfn) $ >
  $ wi ph (wcel I cvv) $ >
  $ wi ph (wceq T (co U I cmap)) $ >
  $ wi ph (wf T (cin (cpw I) cfn) S) $ >
  $ wi ph (wceq A2 (cmpt z T (crab y1 (wceq (cres (cv y1) (cfv (cv z) S)) (cres (cv z) (cfv (cv z) S))) T))) $ >
  $ wi ph (wral z (wral y1 (wceq (cfv (cv y1) S) (cfv (cv z) S)) (cfv (cv z) A2)) T) $ >
  $ wi ph (wceq (cuni (cfv (cmpt i I (cpw U)) cpt)) T) $;

--| Topology lemma. (Contributed by Ender Ting, 27-Jul-2026.)
theorem tmachlem_tpitem {y1 z i: setvar} (ph: wff) (A2 S T U I: class) (a: setvar):
  $ wi ph (wcel U cfn) $ >
  $ wi ph (wcel I cvv) $ >
  $ wi ph (wceq T (co U I cmap)) $ >
  $ wi ph (wf T (cin (cpw I) cfn) S) $ >
  $ wi ph (wceq A2 (cmpt z T (crab y1 (wceq (cres (cv y1) (cfv (cv z) S)) (cres (cv z) (cfv (cv z) S))) T))) $ >
  $ wi ph (wral z (wral y1 (wceq (cfv (cv y1) S) (cfv (cv z) S)) (cfv (cv z) A2)) T) $ >
  $ wi (wa ph (wcel (cv a) I)) (wceq (cfv (cv a) (cmpt i I (cpw U))) (cpw U)) $;

--| Agreement sets are open in the product topology of tapes. (Contributed by Ender Ting, 27-Jul-2026.)
theorem tmachlem_tpopen {y1 z i b: setvar} (ph: wff) (A2 S T U I: class) (a: setvar):
  $ wi ph (wcel U cfn) $ >
  $ wi ph (wcel I cvv) $ >
  $ wi ph (wceq T (co U I cmap)) $ >
  $ wi ph (wf T (cin (cpw I) cfn) S) $ >
  $ wi ph (wceq A2 (cmpt z T (crab y1 (wceq (cres (cv y1) (cfv (cv z) S)) (cres (cv z) (cfv (cv z) S))) T))) $ >
  $ wi ph (wral z (wral y1 (wceq (cfv (cv y1) S) (cfv (cv z) S)) (cfv (cv z) A2)) T) $ >
  $ wi (wa ph (wcel (cv a) T)) (wcel (cixp b I (cif (wcel (cv b) (cfv (cv a) S)) (csn (cfv (cv b) (cv a))) U)) (cfv (cmpt i I (cpw U)) cpt)) $;

--| Variable-renaming lemma connecting ~ tmachlem-agreeprod and ~ tmachlem-tpopen . (Contributed by Ender Ting, 27-Jul-2026.)
theorem tmachlem_tpopen2 {y1 z b: setvar} (ph: wff) (A2 S T U I: class) (a: setvar):
  $ wi ph (wcel U cfn) $ >
  $ wi ph (wcel I cvv) $ >
  $ wi ph (wceq T (co U I cmap)) $ >
  $ wi ph (wf T (cin (cpw I) cfn) S) $ >
  $ wi ph (wceq A2 (cmpt z T (crab y1 (wceq (cres (cv y1) (cfv (cv z) S)) (cres (cv z) (cfv (cv z) S))) T))) $ >
  $ wi ph (wral z (wral y1 (wceq (cfv (cv y1) S) (cfv (cv z) S)) (cfv (cv z) A2)) T) $ >
  $ wi (wa ph (wcel (cv a) T)) (wcel (cfv (cv a) A2) (cfv (cmpt b I (cpw U)) cpt)) $;

--| Union of all agreement sets only includes tapes. (Contributed by Ender Ting, 28-Jul-2026.)
theorem tmachlem_uassst {y1 z: setvar} (ph: wff) (A2 S T U I: class):
  $ wi ph (wcel U cfn) $ >
  $ wi ph (wcel I cvv) $ >
  $ wi ph (wceq T (co U I cmap)) $ >
  $ wi ph (wf T (cin (cpw I) cfn) S) $ >
  $ wi ph (wceq A2 (cmpt z T (crab y1 (wceq (cres (cv y1) (cfv (cv z) S)) (cres (cv z) (cfv (cv z) S))) T))) $ >
  $ wi ph (wral z (wral y1 (wceq (cfv (cv y1) S) (cfv (cv z) S)) (cfv (cv z) A2)) T) $ >
  $ wi ph (wss (cuni (crn A2)) T) $;

--| Product topology of tapes has an open cover. (Contributed by Ender Ting, 28-Jul-2026.)
theorem tmachlem_exlargecover {y1 z: setvar} (ph: wff) (A2 S T U I: class):
  $ wi ph (wcel U cfn) $ >
  $ wi ph (wcel I cvv) $ >
  $ wi ph (wceq T (co U I cmap)) $ >
  $ wi ph (wf T (cin (cpw I) cfn) S) $ >
  $ wi ph (wceq A2 (cmpt z T (crab y1 (wceq (cres (cv y1) (cfv (cv z) S)) (cres (cv z) (cfv (cv z) S))) T))) $ >
  $ wi ph (wral z (wral y1 (wceq (cfv (cv y1) S) (cfv (cv z) S)) (cfv (cv z) A2)) T) $ >
  $ wi ph (wceq (cuni (crn A2)) T) $;

--| Product topology of tapes admits finite cover. (Contributed by Ender Ting, 28-Jul-2026.)
theorem tmachlem_extpcover {y1 z i a: setvar} (ph: wff) (A2 S T U I: class):
  $ wi ph (wcel U cfn) $ >
  $ wi ph (wcel I cvv) $ >
  $ wi ph (wceq T (co U I cmap)) $ >
  $ wi ph (wf T (cin (cpw I) cfn) S) $ >
  $ wi ph (wceq A2 (cmpt z T (crab y1 (wceq (cres (cv y1) (cfv (cv z) S)) (cres (cv z) (cfv (cv z) S))) T))) $ >
  $ wi ph (wral z (wral y1 (wceq (cfv (cv y1) S) (cfv (cv z) S)) (cfv (cv z) A2)) T) $ >
  $ wi ph (wrex a (wceq (cuni (cfv (cmpt i I (cpw U)) cpt)) (cuni (cv a))) (cin (cpw (crn A2)) cfn)) $;

--| Particular properties of the finite cover of agreesets. (Contributed by Ender Ting, 28-Jul-2026.)
theorem tmachlem_exagreecover {y1 z a: setvar} (ph: wff) (A2 S T U I: class):
  $ wi ph (wcel U cfn) $ >
  $ wi ph (wcel I cvv) $ >
  $ wi ph (wceq T (co U I cmap)) $ >
  $ wi ph (wf T (cin (cpw I) cfn) S) $ >
  $ wi ph (wceq A2 (cmpt z T (crab y1 (wceq (cres (cv y1) (cfv (cv z) S)) (cres (cv z) (cfv (cv z) S))) T))) $ >
  $ wi ph (wral z (wral y1 (wceq (cfv (cv y1) S) (cfv (cv z) S)) (cfv (cv z) A2)) T) $ >
  $ wi ph (wex a (w3a (wss (cv a) (crn A2)) (wcel (cv a) cfn) (wceq T (cuni (cv a))))) $;

--| Scans for all tapes of a single agreement set are identical. (Contributed by Ender Ting, 28-Jul-2026.)
theorem tmachlem_agreesn {y1 z a: setvar} (ph: wff) (A2 S T U I: class):
  $ wi ph (wcel U cfn) $ >
  $ wi ph (wcel I cvv) $ >
  $ wi ph (wceq T (co U I cmap)) $ >
  $ wi ph (wf T (cin (cpw I) cfn) S) $ >
  $ wi ph (wceq A2 (cmpt z T (crab y1 (wceq (cres (cv y1) (cfv (cv z) S)) (cres (cv z) (cfv (cv z) S))) T))) $ >
  $ wi ph (wral z (wral y1 (wceq (cfv (cv y1) S) (cfv (cv z) S)) (cfv (cv z) A2)) T) $ >
  $ wi (wa ph (wcel (cv a) T)) (wceq (cima S (cfv (cv a) A2)) (csn (cfv (cv a) S))) $;

--| Any agreement set has a finite (singleton) list of possible scans. (Contributed by Ender Ting, 28-Jul-2026.)
theorem tmachlem_agreefin {y1 z: setvar} (ph: wff) (A2 S T U I: class) (b: setvar):
  $ wi ph (wcel U cfn) $ >
  $ wi ph (wcel I cvv) $ >
  $ wi ph (wceq T (co U I cmap)) $ >
  $ wi ph (wf T (cin (cpw I) cfn) S) $ >
  $ wi ph (wceq A2 (cmpt z T (crab y1 (wceq (cres (cv y1) (cfv (cv z) S)) (cres (cv z) (cfv (cv z) S))) T))) $ >
  $ wi ph (wral z (wral y1 (wceq (cfv (cv y1) S) (cfv (cv z) S)) (cfv (cv z) A2)) T) $ >
  $ wi (wa ph (wcel (cv b) (crn A2))) (wcel (cima S (cv b)) cfn) $;

--| There is a finite number of different scan sets. (Contributed by Ender Ting, 28-Jul-2026.)
theorem tmachlem_franscan {y1 z: setvar} (ph: wff) (A2 S T U I: class):
  $ wi ph (wcel U cfn) $ >
  $ wi ph (wcel I cvv) $ >
  $ wi ph (wceq T (co U I cmap)) $ >
  $ wi ph (wf T (cin (cpw I) cfn) S) $ >
  $ wi ph (wceq A2 (cmpt z T (crab y1 (wceq (cres (cv y1) (cfv (cv z) S)) (cres (cv z) (cfv (cv z) S))) T))) $ >
  $ wi ph (wral z (wral y1 (wceq (cfv (cv y1) S) (cfv (cv z) S)) (cfv (cv z) A2)) T) $ >
  $ wi ph (wcel (crn S) cfn) $;

--| Any scan set is finite. (Contributed by Ender Ting, 28-Jul-2026.)
theorem tmachlem_fssscan {y1 z: setvar} (ph: wff) (A2 S T U I: class):
  $ wi ph (wcel U cfn) $ >
  $ wi ph (wcel I cvv) $ >
  $ wi ph (wceq T (co U I cmap)) $ >
  $ wi ph (wf T (cin (cpw I) cfn) S) $ >
  $ wi ph (wceq A2 (cmpt z T (crab y1 (wceq (cres (cv y1) (cfv (cv z) S)) (cres (cv z) (cfv (cv z) S))) T))) $ >
  $ wi ph (wral z (wral y1 (wceq (cfv (cv y1) S) (cfv (cv z) S)) (cfv (cv z) A2)) T) $ >
  $ wi ph (wss (crn S) cfn) $;

--| Folk theorem. For any algorithm deterministically processing a stream of data (essentially, an infinite tape with cell indices ` I ` and finite alphabet ` U ` ), if it terminates on every possible input, then it never looks beyond a finite portion ` U. ran S ` of the input. Termination is expressed here with a weaker condition: that an execution may only look at a finite number of cells. Obviously, a program which finishes in a finite number of steps can only scan finite set of cells. This theorem has many corollaries, such as: any encoding scheme able to represent all integers has at least one non-decodable tape (in other terms, encoding of the infinity). I no longer have the source for this theorem but I believe I first read about it on LessWrong. My gratitude to Grok for suggesting that this theorem will require Axiom of Choice, and to DeepSeek for suggesting the topology-based proof route. (Contributed by Ender Ting, 28-Jul-2026.)
theorem tmachfullfin {y1 z: setvar} (ph: wff) (A2 S T U I: class):
  $ wi ph (wcel U cfn) $ >
  $ wi ph (wcel I cvv) $ >
  $ wi ph (wceq T (co U I cmap)) $ >
  $ wi ph (wf T (cin (cpw I) cfn) S) $ >
  $ wi ph (wceq A2 (cmpt z T (crab y1 (wceq (cres (cv y1) (cfv (cv z) S)) (cres (cv z) (cfv (cv z) S))) T))) $ >
  $ wi ph (wral z (wral y1 (wceq (cfv (cv y1) S) (cfv (cv z) S)) (cfv (cv z) A2)) T) $ >
  $ wi ph (wcel (cuni (crn S)) cfn) $;

--| The third axiom of a system called "L" but proven to be a theorem since set.mm uses a different third axiom. This is named hirst after Holly P. Hirst and Jeffry L. Hirst. Axiom A3 of [Mendelson] p. 35. (Contributed by Jarvin Udandy, 7-Feb-2015.) (Proof modification is discouraged.)
theorem hirstL_ax3 (ph ps: wff):
  $ wi (wi (wn ph) (wn ps)) (wi (wi (wn ph) ps) ph) $;

--| Recover ~ ax-3 from ~ hirstL-ax3 . (Contributed by Jarvin Udandy, 3-Jul-2015.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem ax3h (ph ps: wff):
  $ wi (wi (wn ph) (wn ps)) (wi ps ph) $;

--| A closed form showing (a implies b and b implies a) same-as (a same-as b). (Contributed by Jarvin Udandy, 3-Sep-2016.)
theorem aibandbiaiffaiffb (ph ps: wff):
  $ wb (wa (wi ph ps) (wi ps ph)) (wb ph ps) $;

--| A closed form showing (a implies b and b implies a) implies (a same-as b). (Contributed by Jarvin Udandy, 3-Sep-2016.)
theorem aibandbiaiaiffb (ph ps: wff):
  $ wi (wa (wi ph ps) (wi ps ph)) (wb ph ps) $;

--| Do not use. Use intnanr instead. Given not a, there exists a proof for not (a and b). (Contributed by Jarvin Udandy, 31-Aug-2016.)
theorem notatnand (ph ps: wff):
  $ wn ph $ >
  $ wn (wa ph ps) $;

--| Given a is equivalent to ` T. ` , there exists a proof for a. (Contributed by Jarvin Udandy, 30-Aug-2016.)
theorem aistia (ph: wff):
  $ wb ph wtru $ >
  $ ph $;

--| Given a is equivalent to ` F. ` , there exists a proof for not a. (Contributed by Jarvin Udandy, 30-Aug-2016.)
theorem aisfina (ph: wff):
  $ wb ph wfal $ >
  $ wn ph $;

--| Given both a, b are equivalent to ` T. ` , there exists a proof for a is the same as b. (Contributed by Jarvin Udandy, 31-Aug-2016.)
theorem bothtbothsame (ph ps: wff):
  $ wb ph wtru $ >
  $ wb ps wtru $ >
  $ wb ph ps $;

--| Given both a, b are equivalent to ` F. ` , there exists a proof for a is the same as b. (Contributed by Jarvin Udandy, 31-Aug-2016.)
theorem bothfbothsame (ph ps: wff):
  $ wb ph wfal $ >
  $ wb ps wfal $ >
  $ wb ph ps $;

--| Given a is equivalent to b, b is equivalent to ` T. ` there exists a proof for a is equivalent to T. (Contributed by Jarvin Udandy, 29-Aug-2016.)
theorem aiffbbtat (ph ps: wff):
  $ wb ph ps $ >
  $ wb ps wtru $ >
  $ wb ph wtru $;

--| Given a is equivalent to b, b is equivalent to ` F. ` there exists a proof for a is equivalent to F. (Contributed by Jarvin Udandy, 30-Aug-2016.)
theorem aisbbisfaisf (ph ps: wff):
  $ wb ph ps $ >
  $ wb ps wfal $ >
  $ wb ph wfal $;

--| Given a is exclusive to b, there exists a proof for (not (a if-and-only-if b)); ~ df-xor is a closed form of this. (Contributed by Jarvin Udandy, 7-Sep-2016.)
theorem axorbtnotaiffb (ph ps: wff):
  $ wxo ph ps $ >
  $ wn (wb ph ps) $;

--| Given a is equivalent to (not b), c is equivalent to a, there exists a proof for ( not ( c iff b ) ). (Contributed by Jarvin Udandy, 7-Sep-2016.)
theorem aiffnbandciffatnotciffb (ph ps ch: wff):
  $ wb ph (wn ps) $ >
  $ wb ch ph $ >
  $ wn (wb ch ps) $;

--| Given a is equivalent to (not b), c is equivalent to a. there exists a proof for ( c xor b ). (Contributed by Jarvin Udandy, 7-Sep-2016.)
theorem axorbciffatcxorb (ph ps ch: wff):
  $ wxo ph ps $ >
  $ wb ch ph $ >
  $ wxo ch ps $;

--| Given a implies b, (not b), there exists a proof for (not a). (Contributed by Jarvin Udandy, 1-Sep-2016.)
theorem aibnbna (ph ps: wff):
  $ wi ph ps $ >
  $ wn ps $ >
  $ wn ph $;

--| Given a implies b, not b, there exists a proof for a is F. (Contributed by Jarvin Udandy, 1-Sep-2016.)
theorem aibnbaif (ph ps: wff):
  $ wi ph ps $ >
  $ wn ps $ >
  $ wb ph wfal $;

--| Given a is equivalent to b, T. is equivalent to b. there exists a proof for a is equivalent to T. (Contributed by Jarvin Udandy, 29-Aug-2016.)
theorem aiffbtbat (ph ps: wff):
  $ wb ph ps $ >
  $ wb wtru ps $ >
  $ wb ph wtru $;

--| Given a is equivalent to T., also given that b is equivalent to T, there exists a proof for a and b is equivalent to T. (Contributed by Jarvin Udandy, 29-Aug-2016.)
theorem astbstanbst (ph ps: wff):
  $ wb ph wtru $ >
  $ wb ps wtru $ >
  $ wb (wa ph ps) wtru $;

--| Given a is equivalent to T., also given that b is equivalent to T, there exists a proof for (a and b). (Contributed by Jarvin Udandy, 9-Sep-2016.)
theorem aistbistaandb (ph ps: wff):
  $ wb ph wtru $ >
  $ wb ps wtru $ >
  $ wa ph ps $;

--| Given a is equivalent to b, there exists a proof for (not (a xor b)). (Contributed by Jarvin Udandy, 28-Aug-2016.)
theorem aisbnaxb (ph ps: wff):
  $ wb ph ps $ >
  $ wn (wxo ph ps) $;

--| If a implies b, then a implies not not b. (Contributed by Jarvin Udandy, 28-Aug-2016.)
theorem atbiffatnnb (ph ps: wff):
  $ wi (wi ph ps) (wi ph (wn (wn ps))) $;

--| Application of bicom1 with a, b swapped. (Contributed by Jarvin Udandy, 31-Aug-2016.)
theorem bisaiaisb (ph ps: wff):
  $ wi (wb ps ph) (wb ph ps) $;

--| If a implies b, then a implies not not b. (Contributed by Jarvin Udandy, 29-Aug-2016.)
theorem atbiffatnnbalt (ph ps: wff):
  $ wi (wi ph ps) (wi ph (wn (wn ps))) $;

--| Assuming a, not b, there exists a proof a-xor-b.) (Contributed by Jarvin Udandy, 31-Aug-2016.)
theorem abnotbtaxb (ph ps: wff):
  $ ph $ >
  $ wn ps $ >
  $ wxo ph ps $;

--| Assuming not a, b, there exists a proof a-xor-b.) (Contributed by Jarvin Udandy, 31-Aug-2016.)
theorem abnotataxb (ph ps: wff):
  $ wn ph $ >
  $ ps $ >
  $ wxo ph ps $;

--| Assuming a, not b, and a implies b, there exists a proof that a is false.) (Contributed by Jarvin Udandy, 28-Aug-2016.)
theorem conimpf (ph ps: wff):
  $ ph $ >
  $ wn ps $ >
  $ wi ph ps $ >
  $ wb ph wfal $;

--| Assuming a, not b, and a implies b, there exists a proof that a is false.) (Contributed by Jarvin Udandy, 29-Aug-2016.)
theorem conimpfalt (ph ps: wff):
  $ ph $ >
  $ wn ps $ >
  $ wi ph ps $ >
  $ wb ph wfal $;

--| Given a is equivalent to T., Given b is equivalent to F. there exists a proof for a-xor-b. (Contributed by Jarvin Udandy, 31-Aug-2016.)
theorem aistbisfiaxb (ph ps: wff):
  $ wb ph wtru $ >
  $ wb ps wfal $ >
  $ wxo ph ps $;

--| Given a is equivalent to F., Given b is equivalent to T., there exists a proof for a-xor-b. (Contributed by Jarvin Udandy, 31-Aug-2016.)
theorem aisfbistiaxb (ph ps: wff):
  $ wb ph wfal $ >
  $ wb ps wtru $ >
  $ wxo ph ps $;

--| Given a is equivalent to T., Given b is equivalent to F., there exists a proof for that a implies b is false. (Contributed by Jarvin Udandy, 7-Sep-2020.)
theorem aifftbifffaibif (ph ps: wff):
  $ wb ph wtru $ >
  $ wb ps wfal $ >
  $ wb (wi ph ps) wfal $;

--| Given a is equivalent to T., Given b is equivalent to F., there exists a proof for that a iff b is false. (Contributed by Jarvin Udandy, 7-Sep-2020.)
theorem aifftbifffaibifff (ph ps: wff):
  $ wb ph wtru $ >
  $ wb ps wfal $ >
  $ wb (wb ph ps) wfal $;

--| Given a, it is not the case a implies a self contradiction. (Contributed by Jarvin Udandy, 7-Sep-2020.)
theorem atnaiana (ph: wff):
  $ ph $ >
  $ wn (wi ph (wa ph (wn ph))) $;

--| Given a, a implies it is not the case a implies a self contradiction. (Contributed by Jarvin Udandy, 7-Sep-2020.)
theorem ainaiaandna (ph: wff):
  $ ph $ >
  $ wi ph (wn (wi ph (wa ph (wn ph)))) $;

--| Given (((a and b) and c) and d), there exists a proof for a. (Contributed by Jarvin Udandy, 3-Sep-2016.)
theorem abcdta (ph ps ch th: wff):
  $ wa (wa (wa ph ps) ch) th $ >
  $ ph $;

--| Given (((a and b) and c) and d), there exists a proof for b. (Contributed by Jarvin Udandy, 3-Sep-2016.)
theorem abcdtb (ph ps ch th: wff):
  $ wa (wa (wa ph ps) ch) th $ >
  $ ps $;

--| Given (((a and b) and c) and d), there exists a proof for c. (Contributed by Jarvin Udandy, 3-Sep-2016.)
theorem abcdtc (ph ps ch th: wff):
  $ wa (wa (wa ph ps) ch) th $ >
  $ ch $;

--| Given (((a and b) and c) and d), there exists a proof for d. (Contributed by Jarvin Udandy, 3-Sep-2016.)
theorem abcdtd (ph ps ch th: wff):
  $ wa (wa (wa ph ps) ch) th $ >
  $ th $;

--| Operands in a biconditional expression converted negated. Additionally biconditional converted to show antecedent implies sequent. Closed form. (Contributed by Jarvin Udandy, 7-Sep-2020.)
theorem abciffcbatnabciffncba (ph ps ch: wff):
  $ wi (wn (wa (wa ph ps) ch)) (wn (wa (wa ch ps) ph)) $;

--| Operands in a biconditional expression converted negated. Additionally biconditional converted to show antecedent implies sequent. (Contributed by Jarvin Udandy, 7-Sep-2020.)
theorem abciffcbatnabciffncbai (ph ps ch: wff):
  $ wb (wa (wa ph ps) ch) (wa (wa ch ps) ph) $ >
  $ wi (wn (wa (wa ph ps) ch)) (wn (wa (wa ch ps) ph)) $;

--| not ( a -> ( b /\ c ) ) we can show: not a implies ( b /\ c ). (Contributed by Jarvin Udandy, 7-Sep-2020.)
theorem nabctnabc (ph ps ch: wff):
  $ wn (wi ph (wa ps ch)) $ >
  $ wi (wn ph) (wa ps ch) $;

--| For when pm3.4 lacks a pm3.4i. (Contributed by Jarvin Udandy, 9-Sep-2020.)
theorem jabtaib (ph ps: wff):
  $ wa ph ps $ >
  $ wi ph ps $;

--| From one negated implication it is not the case its nonnegated form and a random others are both true. (Contributed by Jarvin Udandy, 11-Sep-2020.)
theorem onenotinotbothi (ph ps ch th: wff):
  $ wn (wi ph ps) $ >
  $ wn (wa (wi ph ps) (wi ch th)) $;

--| From these two negated implications it is not the case their nonnegated forms are both true. (Contributed by Jarvin Udandy, 11-Sep-2020.)
theorem twonotinotbothi (ph ps ch th: wff):
  $ wn (wi ph ps) $ >
  $ wn (wi ch th) $ >
  $ wn (wa (wi ph ps) (wi ch th)) $;

--| show d is the same as an if-else involving a,b. (Contributed by Jarvin Udandy, 20-Sep-2020.)
theorem clifte (ph ps ch th: wff):
  $ wa ph (wn ch) $ >
  $ th $ >
  $ wb th (wo (wa ph (wn ch)) (wa ps ch)) $;

--| show d is the same as an if-else involving a,b. (Contributed by Jarvin Udandy, 20-Sep-2020.)
theorem cliftet (ph ps ch th: wff):
  $ wa ph ch $ >
  $ th $ >
  $ wb th (wo (wa ph ch) (wa ps (wn ch))) $;

--| show d is the same as an if-else involving a,b. (Contributed by Jarvin Udandy, 20-Sep-2020.)
theorem clifteta (ph ps ch th: wff):
  $ wo (wa ph (wn ch)) (wa ps ch) $ >
  $ th $ >
  $ wb th (wo (wa ph (wn ch)) (wa ps ch)) $;

--| show d is the same as an if-else involving a,b. (Contributed by Jarvin Udandy, 20-Sep-2020.)
theorem cliftetb (ph ps ch th: wff):
  $ wo (wa ph ch) (wa ps (wn ch)) $ >
  $ th $ >
  $ wb th (wo (wa ph ch) (wa ps (wn ch))) $;

--| Given the hypotheses there exists a proof for (c implies ( d iff a ) ). (Contributed by Jarvin Udandy, 6-Sep-2020.)
theorem confun (ph ps ch th: wff):
  $ ph $ >
  $ wi ch ps $ >
  $ wi ch th $ >
  $ wi ph (wi ph ps) $ >
  $ wi ch (wb th ph) $;

--| Confun simplified to two propositions. (Contributed by Jarvin Udandy, 6-Sep-2020.)
theorem confun2 (ph ps: wff):
  $ wi ps ph $ >
  $ wi ps (wn (wi ps (wa ps (wn ps)))) $ >
  $ wi (wi ps ph) (wi (wi ps ph) ph) $ >
  $ wi ps (wb (wn (wi ps (wa ps (wn ps)))) (wi ps ph)) $;

--| Confun's more complex form where both a,d have been "defined". (Contributed by Jarvin Udandy, 6-Sep-2020.)
theorem confun3 (ph ps ch th: wff):
  $ wb ph (wi ch ps) $ >
  $ wb th (wn (wi ch (wa ch (wn ch)))) $ >
  $ wi ch ps $ >
  $ wi ch (wn (wi ch (wa ch (wn ch)))) $ >
  $ wi (wi ch ps) (wi (wi ch ps) ps) $ >
  $ wi ch (wb (wn (wi ch (wa ch (wn ch)))) (wi ch ps)) $;

--| An attempt at derivative. Resisted simplest path to a proof. (Contributed by Jarvin Udandy, 6-Sep-2020.)
theorem confun4 (ph ps ch th ta et: wff):
  $ ph $ >
  $ wi (wi ph ps) ps $ >
  $ wi ps (wi ph ch) $ >
  $ wi (wi ch th) (wb (wi ph th) ps) $ >
  $ wb ta (wi ch th) $ >
  $ wb et (wn (wi ch (wa ch (wn ch)))) $ >
  $ ps $ >
  $ wi ch th $ >
  $ wi ch (wi ps ta) $;

--| An attempt at derivative. Resisted simplest path to a proof. Interesting that ch, th, ta, et were all provable. (Contributed by Jarvin Udandy, 7-Sep-2020.)
theorem confun5 (ph ps ch th ta et: wff):
  $ ph $ >
  $ wi (wi ph ps) ps $ >
  $ wi ps (wi ph ch) $ >
  $ wi (wi ch th) (wb (wi ph th) ps) $ >
  $ wb ta (wi ch th) $ >
  $ wb et (wn (wi ch (wa ch (wn ch)))) $ >
  $ ps $ >
  $ wi ch th $ >
  $ wi ch (wb et ta) $;

--| Given, a,b and a "definition" for c, c is demonstrated. (Contributed by Jarvin Udandy, 8-Sep-2020.)
theorem plcofph (ph ps ch: wff):
  $ wb ch (wa (wi (wb (wa ph ps) ph) (wa ph (wn (wa ph (wn ph))))) (wa ph (wn (wa ph (wn ph))))) $ >
  $ ph $ >
  $ ps $ >
  $ ch $;

--| Given, a,b c, d, "definition" for e, e is demonstrated. (Contributed by Jarvin Udandy, 8-Sep-2020.)
theorem pldofph (ph ps ch th ta: wff):
  $ wb ta (w3a (wi ch th) (wb ph ch) (wi (wi ph ps) (wb ps th))) $ >
  $ ph $ >
  $ ps $ >
  $ ch $ >
  $ th $ >
  $ ta $;

--| Given, a,b,d, and "definitions" for c, e, f: f is demonstrated. (Contributed by Jarvin Udandy, 8-Sep-2020.)
theorem plvcofph (ph ps ch th ta et: wff):
  $ wb ch (wa (wi (wb (wa ph ps) ph) (wa ph (wn (wa ph (wn ph))))) (wa ph (wn (wa ph (wn ph))))) $ >
  $ wb ta (w3a (wi ch th) (wb ph ch) (wi (wi ph ps) (wb ps th))) $ >
  $ wb et (wa ch ta) $ >
  $ ph $ >
  $ ps $ >
  $ th $ >
  $ et $;

--| Given, a,b,d, and "definitions" for c, e, f, g: g is demonstrated. (Contributed by Jarvin Udandy, 8-Sep-2020.)
theorem plvcofphax (ph ps ch th ta et ze: wff):
  $ wb ch (wa (wi (wb (wa ph ps) ph) (wa ph (wn (wa ph (wn ph))))) (wa ph (wn (wa ph (wn ph))))) $ >
  $ wb ta (w3a (wi ch th) (wb ph ch) (wi (wi ph ps) (wb ps th))) $ >
  $ wb et (wa ch ta) $ >
  $ ph $ >
  $ ps $ >
  $ th $ >
  $ wb ze (wn (wa ps (wn ta))) $ >
  $ ze $;

--| rh is derivable because ONLY one of ch, th, ta, et is implied by mu. (Contributed by Jarvin Udandy, 11-Sep-2020.)
theorem plvofpos (ph ps ch th ta et ze si rh mu: wff):
  $ wb ch (wa (wn ph) (wn ps)) $ >
  $ wb th (wa (wn ph) ps) $ >
  $ wb ta (wa ph (wn ps)) $ >
  $ wb et (wa ph ps) $ >
  $ wb ze (wa (wa (wa (wa (wa (wn (wa (wi mu ch) (wi mu th))) (wn (wa (wi mu ch) (wi mu ta)))) (wn (wa (wi mu ch) (wi ch et)))) (wn (wa (wi mu th) (wi mu ta)))) (wn (wa (wi mu th) (wi mu et)))) (wn (wa (wi mu ta) (wi mu et)))) $ >
  $ wb si (wo (wo (wi mu ch) (wi mu th)) (wo (wi mu ta) (wi mu et))) $ >
  $ wb rh (wa ze si) $ >
  $ ze $ >
  $ si $ >
  $ rh $;


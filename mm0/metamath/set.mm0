--| Lemma for proof of part 14 in [Baer] p. 50. (Contributed by NM, 6-Jun-2015.)
theorem hdmap14lem12 {y1: setvar} (ph: wff) (A2: class) (B2 C P R: class y1) (S c_xb c_x U F G: class) (H K: class y1) (V: class) (W: class y1) (X c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq c_xb (cfv C cvsca) $ >
  $ wceq S (cfv W (cfv K chdma)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel F B2) $ >
  $ wceq P (cfv C csca) $ >
  $ wceq A2 (cfv P cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel G A2) $ >
  $ wi ph (wb (wceq (cfv (co F X c_x) S) (co G (cfv X S) c_xb)) (wral y1 (wceq (cfv (co F (cv y1) c_x) S) (co G (cfv (cv y1) S) c_xb)) (cdif V (csn c_0)))) $;

--| Lemma for proof of part 14 in [Baer] p. 50. (Contributed by NM, 6-Jun-2015.)
theorem hdmap14lem13 {y1: setvar} (ph: wff) (A2: class) (B2 C P R: class y1) (S c_xb c_x U F G: class) (H K: class y1) (V: class) (W: class y1) (X c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq c_xb (cfv C cvsca) $ >
  $ wceq S (cfv W (cfv K chdma)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel F B2) $ >
  $ wceq P (cfv C csca) $ >
  $ wceq A2 (cfv P cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel G A2) $ >
  $ wi ph (wb (wceq (cfv (co F X c_x) S) (co G (cfv X S) c_xb)) (wral y1 (wceq (cfv (co F (cv y1) c_x) S) (co G (cfv (cv y1) S) c_xb)) V)) $;

--| Part of proof of part 14 in [Baer] p. 50 line 3. (Contributed by NM, 6-Jun-2015.)
theorem hdmap14lem14 {x3 g2: setvar} (ph: wff) (A2: class) (B2: class x3) (C: class) (P R: class x3) (S c_xb c_x U F: class) (H K: class x3 g2) (V: class) (W: class x3 g2):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq c_xb (cfv C cvsca) $ >
  $ wceq S (cfv W (cfv K chdma)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel F B2) $ >
  $ wceq P (cfv C csca) $ >
  $ wceq A2 (cfv P cbs) $ >
  $ wi ph (wreu g2 (wral x3 (wceq (cfv (co F (cv x3) c_x) S) (co (cv g2) (cfv (cv x3) S) c_xb)) V) A2) $;

--| Part of proof of part 14 in [Baer] p. 50 line 3. Convert scalar base of dual to scalar base of vector space. (Contributed by NM, 6-Jun-2015.)
theorem hdmap14lem15 {x3 g2: setvar} (ph: wff) (B2: class x3) (C: class) (R: class x3) (S c_xb c_x U F: class) (H K: class x3 g2) (V: class) (W: class x3 g2):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq c_xb (cfv C cvsca) $ >
  $ wceq S (cfv W (cfv K chdma)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wreu g2 (wral x3 (wceq (cfv (co F (cv x3) c_x) S) (co (cv g2) (cfv (cv x3) S) c_xb)) V) B2) $;

--| Extend class notation with g-map.
term chg: class;

--| Define map from the scalar division ring of the vector space to the scalar division ring of its closed kernel dual. (Contributed by NM, 25-Mar-2015.)
axiom df_hgmap {x3 y1 w v u k m a b: setvar}:
  $ wceq chg (cmpt k cvv (cmpt w (cfv (cv k) clh) (cab a (wsbc u (wsbc b (wsbc m (wcel (cv a) (cmpt x3 (cv b) (crio y1 (wral v (wceq (cfv (co (cv x3) (cv v) (cfv (cv u) cvsca)) (cv m)) (co (cv y1) (cfv (cv v) (cv m)) (cfv (cfv (cv w) (cfv (cv k) clcd)) cvsca))) (cfv (cv u) cbs)) (cv b)))) (cfv (cv w) (cfv (cv k) chdma))) (cfv (cfv (cv u) csca) cbs)) (cfv (cv w) (cfv (cv k) cdvh)))))) $;

--| Map from the scalar division ring of the vector space to the scalar division ring of its closed kernel dual. (Contributed by NM, 25-Mar-2015.)
theorem hgmapffval {x3 y1 w v u m a b: setvar} (H: class x3 y1 v u m a b) (K: class) (X: class x3 y1 w v u m a b):
  $ wceq H (cfv K clh) $ >
  $ wi (wcel K X) (wceq (cfv K chg) (cmpt w H (cab a (wsbc u (wsbc b (wsbc m (wcel (cv a) (cmpt x3 (cv b) (crio y1 (wral v (wceq (cfv (co (cv x3) (cv v) (cfv (cv u) cvsca)) (cv m)) (co (cv y1) (cfv (cv v) (cv m)) (cfv (cfv (cv w) (cfv K clcd)) cvsca))) (cfv (cv u) cbs)) (cv b)))) (cfv (cv w) (cfv K chdma))) (cfv (cfv (cv u) csca) cbs)) (cfv (cv w) (cfv K cdvh)))))) $;

--| Map from the scalar division ring of the vector space to the scalar division ring of its closed kernel dual. (Contributed by NM, 25-Mar-2015.)
theorem hgmapfval {x3 y1 v: setvar} (ph: wff x3 y1 v) (B2: class) (C R c_xb c_x: class x3 y1 v) (U: class) (H I: class x3 y1 v) (K M: class) (V: class x3 y1) (W: class) (Y: class x3 y1 v):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq c_xb (cfv C cvsca) $ >
  $ wceq M (cfv W (cfv K chdma)) $ >
  $ wceq I (cfv W (cfv K chg)) $ >
  $ wi ph (wa (wcel K Y) (wcel W H)) $ >
  $ wi ph (wceq I (cmpt x3 B2 (crio y1 (wral v (wceq (cfv (co (cv x3) (cv v) c_x) M) (co (cv y1) (cfv (cv v) M) c_xb)) V) B2))) $;

--| Value of map from the scalar division ring of the vector space to the scalar division ring of its closed kernel dual. Function sigma of scalar f in part 14 of [Baer] p. 50 line 4. TODO: variable names are inherited from older version. Maybe make more consistent with ~ hdmap14lem15 . (Contributed by NM, 25-Mar-2015.)
theorem hgmapval {y1 v: setvar} (ph: wff y1 v) (B2: class) (C R c_xb c_x: class y1 v) (U: class) (H I: class y1 v) (K M: class) (V: class y1) (W X: class) (Y: class y1 v):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq c_xb (cfv C cvsca) $ >
  $ wceq M (cfv W (cfv K chdma)) $ >
  $ wceq I (cfv W (cfv K chg)) $ >
  $ wi ph (wa (wcel K Y) (wcel W H)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wceq (cfv X I) (crio y1 (wral v (wceq (cfv (co X (cv v) c_x) M) (co (cv y1) (cfv (cv v) M) c_xb)) V) B2)) $;

--| Functionality of scalar sigma map. (Contributed by NM, 7-Jun-2015.) (New usage is discouraged.)
theorem hgmapfnN (ph: wff) (B2 R U G H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq G (cfv W (cfv K chg)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wfn G B2) $;

--| Closure of scalar sigma map i.e. the map from the vector space scalar base to the dual space scalar base. (Contributed by NM, 6-Jun-2015.)
theorem hgmapcl (ph: wff) (B2 R U F G H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq G (cfv W (cfv K chg)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel (cfv F G) B2) $;

--| Closure of the vector space to dual space scalar map, in the scalar sigma map. (Contributed by NM, 6-Jun-2015.)
theorem hgmapdcl (ph: wff) (A2 B2 C Q R U F G H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq Q (cfv C csca) $ >
  $ wceq A2 (cfv Q cbs) $ >
  $ wceq G (cfv W (cfv K chg)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wcel (cfv F G) A2) $;

--| Part 15 of [Baer] p. 50 line 6. Also line 15 in [Holland95] p. 14. (Contributed by NM, 6-Jun-2015.)
theorem hgmapvs (ph: wff) (B2 C R S c_xb c_x U F G H K V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq c_xb (cfv C cvsca) $ >
  $ wceq S (cfv W (cfv K chdma)) $ >
  $ wceq G (cfv W (cfv K chg)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel F B2) $ >
  $ wi ph (wceq (cfv (co F X c_x) S) (co (cfv F G) (cfv X S) c_xb)) $;

--| Value of the scalar sigma map at zero. (Contributed by NM, 12-Jun-2015.)
theorem hgmapval0 (ph: wff) (R U G H K W c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq G (cfv W (cfv K chg)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wceq (cfv c_0 G) c_0) $;

--| Value of the scalar sigma map at one. (Contributed by NM, 12-Jun-2015.)
theorem hgmapval1 (ph: wff) (R U c_1 G H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq c_1 (cfv R cur) $ >
  $ wceq G (cfv W (cfv K chg)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wceq (cfv c_1 G) c_1) $;

--| Part 15 of [Baer] p. 50 line 13. (Contributed by NM, 6-Jun-2015.)
theorem hgmapadd (ph: wff) (B2 c_pl R U G H K W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq G (cfv W (cfv K chg)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (cfv (co X Y c_pl) G) (co (cfv X G) (cfv Y G) c_pl)) $;

--| Part 15 of [Baer] p. 50 line 16. The multiplication is reversed after converting to the dual space scalar to the vector space scalar. (Contributed by NM, 7-Jun-2015.)
theorem hgmapmul (ph: wff) (B2 R c_x U G H K W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv R cmulr) $ >
  $ wceq G (cfv W (cfv K chg)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (cfv (co X Y c_x) G) (co (cfv Y G) (cfv X G) c_x)) $;

--| Lemma for ~ hgmaprnN . (Contributed by NM, 7-Jun-2015.) (New usage is discouraged.)
theorem hgmaprnlem1N {z t k s1: setvar} (ph: wff z t k s1) (A2 B2 C D P Q R S c_xb c_x U G H K V W c_0: class z t k s1):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq D (cfv C cbs) $ >
  $ wceq P (cfv C csca) $ >
  $ wceq A2 (cfv P cbs) $ >
  $ wceq c_xb (cfv C cvsca) $ >
  $ wceq Q (cfv C c0g) $ >
  $ wceq S (cfv W (cfv K chdma)) $ >
  $ wceq G (cfv W (cfv K chg)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel (cv z) A2) $ >
  $ wi ph (wcel (cv t) (cdif V (csn c_0))) $ >
  $ wi ph (wcel (cv s1) V) $ >
  $ wi ph (wceq (cfv (cv s1) S) (co (cv z) (cfv (cv t) S) c_xb)) $ >
  $ wi ph (wcel (cv k) B2) $ >
  $ wi ph (wceq (cv s1) (co (cv k) (cv t) c_x)) $ >
  $ wi ph (wcel (cv z) (crn G)) $;

--| Lemma for ~ hgmaprnN . Part 15 of [Baer] p. 50 line 20. We only require a subset relation, rather than equality, so that the case of zero ` z ` is taken care of automatically. (Contributed by NM, 7-Jun-2015.) (New usage is discouraged.)
theorem hgmaprnlem2N {z t s1: setvar} (ph: wff z t s1) (A2 B2 C D P Q R S c_xb c_x U G H K L M N V W c_0: class z t s1):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq D (cfv C cbs) $ >
  $ wceq P (cfv C csca) $ >
  $ wceq A2 (cfv P cbs) $ >
  $ wceq c_xb (cfv C cvsca) $ >
  $ wceq Q (cfv C c0g) $ >
  $ wceq S (cfv W (cfv K chdma)) $ >
  $ wceq G (cfv W (cfv K chg)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel (cv z) A2) $ >
  $ wi ph (wcel (cv t) (cdif V (csn c_0))) $ >
  $ wi ph (wcel (cv s1) V) $ >
  $ wi ph (wceq (cfv (cv s1) S) (co (cv z) (cfv (cv t) S) c_xb)) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq L (cfv C clspn) $ >
  $ wi ph (wss (cfv (csn (cv s1)) N) (cfv (csn (cv t)) N)) $;


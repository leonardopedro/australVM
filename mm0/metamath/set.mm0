  $ wi ph (wcel G F) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wceq (cfv (cfv (csn X) N) M) (cfv (csn G) J)) $ >
  $ wi ph (wa (wcel (cv h) F) (wa (wceq (cfv (cfv (csn Y) N) M) (cfv (csn (cv h)) J)) (wceq (cfv (cfv (csn (co X Y c_mi)) N) M) (cfv (csn (co G (cv h) R)) J)))) $ >
  $ wi ph (wa (wcel (cv i) F) (wa (wceq (cfv (cfv (csn Y) N) M) (cfv (csn (cv i)) J)) (wceq (cfv (cfv (csn (co X Y c_mi)) N) M) (cfv (csn (co G (cv i) R)) J)))) $ >
  $ wi ph (wne (cv i) (cfv C c0g)) $;

--| Lemma for ~ mapdpg . Baer p. 45 line 12: "Then we have Gy' = Gy'' and G(x'-y') = G(x'-y'')." (Contributed by NM, 21-Mar-2015.)
theorem mapdpglem25 {h i: setvar} (ph: wff h i) (C R U F G H J K M c_mi N V W X Y c_0: class h i):
  $ wceq H (cfv K clh) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq F (cfv C cbs) $ >
  $ wceq R (cfv C csg) $ >
  $ wceq J (cfv C clspn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel Y (cdif V (csn c_0))) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wceq (cfv (cfv (csn X) N) M) (cfv (csn G) J)) $ >
  $ wi ph (wa (wcel (cv h) F) (wa (wceq (cfv (cfv (csn Y) N) M) (cfv (csn (cv h)) J)) (wceq (cfv (cfv (csn (co X Y c_mi)) N) M) (cfv (csn (co G (cv h) R)) J)))) $ >
  $ wi ph (wa (wcel (cv i) F) (wa (wceq (cfv (cfv (csn Y) N) M) (cfv (csn (cv i)) J)) (wceq (cfv (cfv (csn (co X Y c_mi)) N) M) (cfv (csn (co G (cv i) R)) J)))) $ >
  $ wi ph (wa (wceq (cfv (csn (cv h)) J) (cfv (csn (cv i)) J)) (wceq (cfv (csn (co G (cv h) R)) J) (cfv (csn (co G (cv i) R)) J))) $;

--| Lemma for ~ mapdpg . Baer p. 45 line 14: "Consequently there exist numbers u,v in G neither of which is 0 such that y = uy'' and..." (We scope $d ` u ph ` locally to avoid clashes with later substitutions into ` ph ` .) (Contributed by NM, 22-Mar-2015.)
theorem mapdpglem26 {u h i: setvar} (ph: wff h i) (A2: class u h i) (B2 C: class h i) (R: class u h i) (c_x: class h i) (U F G H J K M c_mi N: class u h i) (O: class h i) (V W X Y c_0: class u h i):
  $ wceq H (cfv K clh) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq F (cfv C cbs) $ >
  $ wceq R (cfv C csg) $ >
  $ wceq J (cfv C clspn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel Y (cdif V (csn c_0))) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wceq (cfv (cfv (csn X) N) M) (cfv (csn G) J)) $ >
  $ wi ph (wa (wcel (cv h) F) (wa (wceq (cfv (cfv (csn Y) N) M) (cfv (csn (cv h)) J)) (wceq (cfv (cfv (csn (co X Y c_mi)) N) M) (cfv (csn (co G (cv h) R)) J)))) $ >
  $ wi ph (wa (wcel (cv i) F) (wa (wceq (cfv (cfv (csn Y) N) M) (cfv (csn (cv i)) J)) (wceq (cfv (cfv (csn (co X Y c_mi)) N) M) (cfv (csn (co G (cv i) R)) J)))) $ >
  $ wceq A2 (cfv U csca) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_x (cfv C cvsca) $ >
  $ wceq O (cfv A2 c0g) $ >
  $ wi ph (wrex u (wceq (cv h) (co (cv u) (cv i) c_x)) (cdif B2 (csn O))) $;

--| Lemma for ~ mapdpg . Baer p. 45 line 16: "v(x'-y'') = x'-y'" (with equality swapped). (Contributed by NM, 22-Mar-2015.)
theorem mapdpglem27 {v h i: setvar} (ph: wff h i) (A2: class v h i) (B2 C R c_x: class h i) (U F: class v h i) (G: class h i) (H J K M c_mi N: class v h i) (O: class h i) (V W X Y c_0: class v h i):
  $ wceq H (cfv K clh) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq F (cfv C cbs) $ >
  $ wceq R (cfv C csg) $ >
  $ wceq J (cfv C clspn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel Y (cdif V (csn c_0))) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wceq (cfv (cfv (csn X) N) M) (cfv (csn G) J)) $ >
  $ wi ph (wa (wcel (cv h) F) (wa (wceq (cfv (cfv (csn Y) N) M) (cfv (csn (cv h)) J)) (wceq (cfv (cfv (csn (co X Y c_mi)) N) M) (cfv (csn (co G (cv h) R)) J)))) $ >
  $ wi ph (wa (wcel (cv i) F) (wa (wceq (cfv (cfv (csn Y) N) M) (cfv (csn (cv i)) J)) (wceq (cfv (cfv (csn (co X Y c_mi)) N) M) (cfv (csn (co G (cv i) R)) J)))) $ >
  $ wceq A2 (cfv U csca) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_x (cfv C cvsca) $ >
  $ wceq O (cfv A2 c0g) $ >
  $ wi ph (wrex v (wceq (co G (cv h) R) (co (cv v) (co G (cv i) R) c_x)) (cdif B2 (csn O))) $;

--| Lemma for ~ mapdpg . Baer p. 45 line 16: "But Gx' and Gy'' are distinct points and so x' and y'' are independent elements in B. (Contributed by NM, 22-Mar-2015.)
theorem mapdpglem29 {v u h i: setvar} (ph: wff v u h i) (A2: class v u h i) (B2 C: class h i) (R: class u h i) (c_x: class h i) (U F: class v u h i) (G: class u h i) (H J K M c_mi N: class v u h i) (O: class h i) (V W X Y c_0: class v u h i):
  $ wceq H (cfv K clh) $ >

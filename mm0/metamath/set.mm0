  $ wb ps (wal j (wi (wa (wcel (cv j) com) (wcel (csuc (cv j)) (cv n))) (wceq (cfv (csuc (cv j)) (cv f2)) (ciun y1 (cfv (cv j) (cv f2)) (c_bnj14 A2 R (cv y1)))))) $;


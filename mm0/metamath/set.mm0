  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wrex r (wa (wn (wbr (cv r) W c_le)) (wn (wbr (cv r) (co P Q c_or) c_le))) A2) $;


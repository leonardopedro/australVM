  $ wceq P (cfv R cpl1) $ >
  $ wceq Y (co N P cmat) $ >
  $ wceq c_xp (cfv Y cmulr) $ >
  $ wceq c_mi (cfv Y csg) $ >
  $ wceq c_0 (cfv Y c0g) $ >
  $ wceq T (co N R cmat2pmat) $ >
  $ wceq C (co N R cchpmat) $ >
  $ wceq K (cfv M C) $ >
  $ wceq G (cmpt n cn0 (cif (wceq (cv n) cc0) (co c_0 (co (cfv M T) (cfv (cfv cc0 (cv b)) T) c_xp) c_mi) (cif (wceq (cv n) (co (cv s1) c1 caddc)) (cfv (cfv (cv s1) (cv b)) T) (cif (wbr (co (cv s1) c1 caddc) (cv n) clt) c_0 (co (cfv (cfv (co (cv n) c1 cmin) (cv b)) T) (co (cfv M T) (cfv (cfv (cv n) (cv b)) T) c_xp) c_mi))))) $ >
  $ wceq W (cfv Y cbs) $ >
  $ wceq c_1 (cfv A2 cur) $ >
  $ wceq c_as (cfv A2 cvsca) $ >
  $ wceq U (co N R ccpmat2mat) $ >
  $ wi (w3a (wcel N cfn) (wcel R ccrg) (wcel M B2)) (wrex s1 (wrex b (wral n (wceq (cfv (cfv (cv n) G) U) (co (cfv (cv n) (cfv K cco1)) c_1 c_as)) cn0) (co B2 (co cc0 (cv s1) cfz) cmap)) cn) $;

--| Lemma for ~ cayhamlem4 . (Contributed by AV, 24-Nov-2019.) (Revised by AV, 15-Dec-2019.)
theorem cayhamlem3 {n s1 b: setvar} (A2 B2: class) (C: class n s1 b) (P R T: class) (c_x: class n s1 b) (c_xp U c_1: class s1 b) (c_ex: class n s1 b) (G c_as K: class s1 b) (M c_mi N: class) (W: class s1 b) (Y: class) (c_0: class s1 b):

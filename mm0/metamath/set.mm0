  $ wceq D (cfv U cld) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq O (cfv C c0g) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wceq O c_0) $;

--| Value of the zero functional at any vector. (Contributed by NM, 28-Mar-2015.) (New usage is discouraged.)
theorem lcd0vvalN (ph: wff) (C S U H K O V W X c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq S (cfv U csca) $ >
  $ wceq c_0 (cfv S c0g) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq O (cfv C c0g) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wceq (cfv X O) c_0) $;

--| Closure of the zero functional in the set of functionals with closed kernels. (Contributed by NM, 15-Mar-2015.)
theorem lcd0vcl (ph: wff) (C H K O V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq V (cfv C cbs) $ >
  $ wceq O (cfv C c0g) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel O V) $;

--| A scalar zero times a functional is the zero functional. (Contributed by NM, 20-Mar-2015.)
theorem lcd0vs (ph: wff) (C R c_x U G H K O V W c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq c_0 (cfv R c0g) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq V (cfv C cbs) $ >
  $ wceq c_x (cfv C cvsca) $ >
  $ wceq O (cfv C c0g) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wceq (co c_0 G c_x) O) $;

--| A scalar times the zero functional is the zero functional. (Contributed by NM, 20-Mar-2015.) (New usage is discouraged.)
theorem lcdvs0N (ph: wff) (C R S c_x U H K W X c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv U csca) $ >
  $ wceq R (cfv S cbs) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq c_x (cfv C cvsca) $ >
  $ wceq c_0 (cfv C c0g) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X R) $ >
  $ wi ph (wceq (co X c_0 c_x) c_0) $;

--| The value of vector subtraction in the closed kernel dual space. (Contributed by NM, 22-Mar-2015.)
theorem lcdvsub (ph: wff) (C c_pl S c_x U c_1 F G H K c_mi N V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv U csca) $ >
  $ wceq N (cfv S cminusg) $ >
  $ wceq c_1 (cfv S cur) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq V (cfv C cbs) $ >
  $ wceq c_pl (cfv C cplusg) $ >
  $ wceq c_x (cfv C cvsca) $ >
  $ wceq c_mi (cfv C csg) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel F V) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wceq (co F G c_mi) (co F (co (cfv c_1 N) G c_x) c_pl)) $;

--| The value of the value of vector addition in the closed kernel vector space dual. (Contributed by NM, 11-Jun-2015.)
theorem lcdvsubval (ph: wff) (C D R S U F G H K c_mi V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq S (cfv R csg) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq D (cfv C cbs) $ >
  $ wceq c_mi (cfv C csg) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel F D) $ >
  $ wi ph (wcel G D) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wceq (cfv X (co F G c_mi)) (co (cfv X F) (cfv X G) S)) $;

--| Subspaces of a dual vector space of functionals with closed kernels. (Contributed by NM, 13-Mar-2015.)
theorem lcdlss {f2: setvar} (ph: wff f2) (B2 C: class f2) (D: class) (S T: class f2) (U F: class) (H: class f2) (K L O W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq O (cfv W (cfv K coch)) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq S (cfv C clss) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq D (cfv U cld) $ >
  $ wceq T (cfv D clss) $ >
  $ wceq B2 (crab f2 (wceq (cfv (cfv (cfv (cv f2) L) O) O) (cfv (cv f2) L)) F) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wceq S (cin T (cpw B2))) $;

--| Subspaces of a dual vector space of functionals with closed kernels. (Contributed by NM, 13-Mar-2015.) (New usage is discouraged.)
theorem lcdlss2N (ph: wff) (C D S T U H K V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq S (cfv C clss) $ >
  $ wceq V (cfv C cbs) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq D (cfv U cld) $ >
  $ wceq T (cfv D clss) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wceq S (cin T (cpw V))) $;

--| Span in the set of functionals with closed kernels. (Contributed by NM, 28-Mar-2015.)
theorem lcdlsp (ph: wff) (C D U F G H K M N W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq D (cfv U cld) $ >
  $ wceq M (cfv D clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq F (cfv C cbs) $ >
  $ wceq N (cfv C clspn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wss G F) $ >
  $ wi ph (wceq (cfv G N) (cfv G M)) $;

--| Colinear functionals have equal kernels. (Contributed by NM, 28-Mar-2015.) (New usage is discouraged.)
theorem lcdlkreqN (ph: wff) (C U G H I K L N V W c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq c_0 (cfv C c0g) $ >
  $ wceq N (cfv C clspn) $ >
  $ wceq V (cfv C cbs) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wcel G (cfv (csn I) N)) $ >
  $ wi ph (wne G c_0) $ >
  $ wi ph (wceq (cfv G L) (cfv I L)) $;

--| Colinear functionals have equal kernels. (Contributed by NM, 28-Mar-2015.) (New usage is discouraged.)
theorem lcdlkreq2N (ph: wff) (A2 C R S c_x U G H I K L V W c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv U csca) $ >
  $ wceq R (cfv S cbs) $ >
  $ wceq c_0 (cfv S c0g) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq V (cfv C cbs) $ >
  $ wceq c_x (cfv C cvsca) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel A2 (cdif R (csn c_0))) $ >
  $ wi ph (wcel I V) $ >
  $ wi ph (wceq G (co A2 I c_x)) $ >
  $ wi ph (wceq (cfv G L) (cfv I L)) $;

--| Extend class notation with projectivity from subspaces of vector space H to subspaces of functionals with closed kernels.
term cmpd: class;

--| Extend class notation with a one-to-one onto ( ~ mapd1o ), order-preserving ( ~ mapdord ) map, called a projectivity (definition of projectivity in [Baer] p. 40), from subspaces of vector space H to those subspaces of the dual space having functionals with closed kernels. (Contributed by NM, 25-Jan-2015.)
axiom df_mapd {w f2 k s1: setvar}:
  $ wceq cmpd (cmpt k cvv (cmpt w (cfv (cv k) clh) (cmpt s1 (cfv (cfv (cv w) (cfv (cv k) cdvh)) clss) (crab f2 (wa (wceq (cfv (cfv (cfv (cv f2) (cfv (cfv (cv w) (cfv (cv k) cdvh)) clk)) (cfv (cv w) (cfv (cv k) coch))) (cfv (cv w) (cfv (cv k) coch))) (cfv (cv f2) (cfv (cfv (cv w) (cfv (cv k) cdvh)) clk))) (wss (cfv (cfv (cv f2) (cfv (cfv (cv w) (cfv (cv k) cdvh)) clk)) (cfv (cv w) (cfv (cv k) coch))) (cv s1))) (cfv (cfv (cv w) (cfv (cv k) cdvh)) clfn))))) $;

--| Projectivity from vector space H to dual space. (Contributed by NM, 25-Jan-2015.)
theorem mapdffval {w f2 s1: setvar} (H: class f2 s1) (K: class) (X: class w f2 s1):
  $ wceq H (cfv K clh) $ >
  $ wi (wcel K X) (wceq (cfv K cmpd) (cmpt w H (cmpt s1 (cfv (cfv (cv w) (cfv K cdvh)) clss) (crab f2 (wa (wceq (cfv (cfv (cfv (cv f2) (cfv (cfv (cv w) (cfv K cdvh)) clk)) (cfv (cv w) (cfv K coch))) (cfv (cv w) (cfv K coch))) (cfv (cv f2) (cfv (cfv (cv w) (cfv K cdvh)) clk))) (wss (cfv (cfv (cv f2) (cfv (cfv (cv w) (cfv K cdvh)) clk)) (cfv (cv w) (cfv K coch))) (cv s1))) (cfv (cfv (cv w) (cfv K cdvh)) clfn))))) $;

--| Projectivity from vector space H to dual space. (Contributed by NM, 25-Jan-2015.)
theorem mapdfval {f2 s1: setvar} (S: class f2) (U: class f2 s1) (F: class s1) (H: class f2 s1) (K: class) (L M O: class f2 s1) (W: class) (X: class f2 s1):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq O (cfv W (cfv K coch)) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wi (wa (wcel K X) (wcel W H)) (wceq M (cmpt s1 S (crab f2 (wa (wceq (cfv (cfv (cfv (cv f2) L) O) O) (cfv (cv f2) L)) (wss (cfv (cfv (cv f2) L) O) (cv s1))) F))) $;

--| Value of projectivity from vector space H to dual space. (Contributed by NM, 27-Jan-2015.)
theorem mapdval {f2: setvar} (ph: wff f2) (S: class f2) (T: class) (U: class f2) (F: class) (H: class f2) (K: class) (L M O: class f2) (W: class) (X: class f2):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq O (cfv W (cfv K coch)) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wi ph (wa (wcel K X) (wcel W H)) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wceq (cfv T M) (crab f2 (wa (wceq (cfv (cfv (cfv (cv f2) L) O) O) (cfv (cv f2) L)) (wss (cfv (cfv (cv f2) L) O) T)) F)) $;


--| Use ~ cdlemg37 to eliminate ` E. r e. A ` from ~ cdlemg36 . TODO: Fix comment. (Contributed by NM, 31-May-2013.)
theorem cdlemg38 (A2 P Q R T F G H c_or K c_le c_an W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >

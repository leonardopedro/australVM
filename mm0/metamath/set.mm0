theorem _1lt10:
  $ wbr c1 (cdc c1 cc0) clt $;

--| Obsolete version of ~ 1lt10 as of 10-Jun-2026. (Contributed by NM, 7-Nov-2012.) (Revised by Mario Carneiro, 9-Mar-2015.) (Revised by AV, 8-Sep-2021.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem _1lt10OLD:
  $ wbr c1 (cdc c1 cc0) clt $;

--| Decompose base 4 into base 2. (Contributed by Mario Carneiro, 18-Feb-2014.)
theorem decbin0 (A2: class):
  $ wcel A2 cn0 $ >
  $ wceq (co c4 A2 cmul) (co c2 (co c2 A2 cmul) cmul) $;

--| Decompose base 4 into base 2. (Contributed by Mario Carneiro, 18-Feb-2014.)
theorem decbin2 (A2: class):
  $ wcel A2 cn0 $ >
  $ wceq (co (co c4 A2 cmul) c2 caddc) (co c2 (co (co c2 A2 cmul) c1 caddc) cmul) $;

--| Decompose base 4 into base 2. (Contributed by Mario Carneiro, 18-Feb-2014.)
theorem decbin3 (A2: class):
  $ wcel A2 cn0 $ >
  $ wceq (co (co c4 A2 cmul) c3 caddc) (co (co c2 (co (co c2 A2 cmul) c1 caddc) cmul) c1 caddc) $;

--| One fifth minus one sixth. (Contributed by Scott Fenton, 9-Jan-2017.)
theorem _5recm6rec:
  $ wceq (co (co c1 c5 cdiv) (co c1 c6 cdiv) cmin) (co c1 (cdc c3 cc0) cdiv) $;

--| Extend class notation with the upper integer function. Read " ` ZZ>= `` M ` " as "the set of integers greater than or equal to ` M ` ".
term cuz: class;

--| Define a function whose value at ` j ` is the semi-infinite set of contiguous integers starting at ` j ` , which we will also call the upper integers starting at ` j ` . Read " ` ZZ>= `` M ` " as "the set of integers greater than or equal to ` M ` ". See ~ uzval for its value, ~ uzssz for its relationship to ` ZZ ` , ~ nnuz and ~ nn0uz for its relationships to ` NN ` and ` NN0 ` , and ~ eluz1 and ~ eluz2 for its membership relations. (Contributed by NM, 5-Sep-2005.)
axiom df_uz {j k: setvar}:
  $ wceq cuz (cmpt j cz (crab k (wbr (cv j) (cv k) cle) cz)) $;

--| The value of the upper integers function. (Contributed by NM, 5-Sep-2005.) (Revised by Mario Carneiro, 3-Nov-2013.)
theorem uzval {k: setvar} (N: class):
  $ wi (wcel N cz) (wceq (cfv N cuz) (crab k (wbr N (cv k) cle) cz)) $;

--| The domain and codomain of the upper integers function. (Contributed by Scott Fenton, 8-Aug-2013.) (Revised by Mario Carneiro, 3-Nov-2013.)
theorem uzf:
  $ wf cz (cpw cz) cuz $;

--| Membership in the upper set of integers starting at ` M ` . (Contributed by NM, 5-Sep-2005.)
theorem eluz1 (M N: class):
  $ wi (wcel M cz) (wb (wcel N (cfv M cuz)) (wa (wcel N cz) (wbr M N cle))) $;

--| Implication of membership in an upper set of integers. (Contributed by NM, 6-Sep-2005.) (Revised by Mario Carneiro, 3-Nov-2013.)
theorem eluzel2 (M N: class):
  $ wi (wcel N (cfv M cuz)) (wcel M cz) $;

--| Membership in an upper set of integers. We use the fact that a function's value (under our function value definition) is empty outside of its domain to show ` M e. ZZ ` . (Contributed by NM, 5-Sep-2005.) (Revised by Mario Carneiro, 3-Nov-2013.)
theorem eluz2 (M N: class):
  $ wb (wcel N (cfv M cuz)) (w3a (wcel M cz) (wcel N cz) (wbr M N cle)) $;

--| Membership in an earlier upper set of integers. (Contributed by Thierry Arnoux, 8-Oct-2018.)
theorem eluzmn (M N: class):
  $ wi (wa (wcel M cz) (wcel N cn0)) (wcel M (cfv (co M N cmin) cuz)) $;

--| Membership in an upper set of integers. (Contributed by NM, 5-Sep-2005.)
theorem eluz1i (M N: class):
  $ wcel M cz $ >
  $ wb (wcel N (cfv M cuz)) (wa (wcel N cz) (wbr M N cle)) $;

--| An integer in an upper set of integers is an element of an upper set of integers with a smaller bound. (Contributed by Alexander van der Vekens, 17-Jun-2018.)
theorem eluzuzle (A2 B2 C: class):
  $ wi (wa (wcel B2 cz) (wbr B2 A2 cle)) (wi (wcel C (cfv A2 cuz)) (wcel C (cfv B2 cuz))) $;

--| A member of an upper set of integers is an integer. (Contributed by NM, 6-Sep-2005.)
theorem eluzelz (M N: class):
  $ wi (wcel N (cfv M cuz)) (wcel N cz) $;

--| A member of an upper set of integers is a real. (Contributed by Mario Carneiro, 31-Aug-2013.)
theorem eluzelre (M N: class):
  $ wi (wcel N (cfv M cuz)) (wcel N cr) $;

--| A member of an upper set of integers is a complex number. (Contributed by Glauco Siliprandi, 29-Jun-2017.)
theorem eluzelcn (M N: class):
  $ wi (wcel N (cfv M cuz)) (wcel N cc) $;

--| Implication of membership in an upper set of integers. (Contributed by NM, 6-Sep-2005.)
theorem eluzle (M N: class):
  $ wi (wcel N (cfv M cuz)) (wbr M N cle) $;

--| Membership in an upper set of integers. (Contributed by NM, 2-Oct-2005.)
theorem eluz (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wcel N (cfv M cuz)) (wbr M N cle)) $;

--| Membership of the least member in an upper set of integers. (Contributed by NM, 2-Sep-2005.)
theorem uzid (M: class):
  $ wi (wcel M cz) (wcel M (cfv M cuz)) $;

--| Membership of the least member in an upper set of integers. (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem uzidd (ph: wff) (M: class):
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel M (cfv M cuz)) $;

--| The upper integers are all nonempty. (Contributed by Mario Carneiro, 16-Jan-2014.)
theorem uzn0 (M: class):
  $ wi (wcel M (crn cuz)) (wne M c0) $;

--| Transitive law for sets of upper integers. (Contributed by NM, 20-Sep-2005.)
theorem uztrn (K M N: class):
  $ wi (wa (wcel M (cfv K cuz)) (wcel K (cfv N cuz))) (wcel M (cfv N cuz)) $;

--| Transitive law for sets of upper integers. (Contributed by Mario Carneiro, 26-Dec-2013.)
theorem uztrn2 (K M N Z: class):
  $ wceq Z (cfv K cuz) $ >
  $ wi (wa (wcel N Z) (wcel M (cfv N cuz))) (wcel M Z) $;

--| Contraposition law for upper integers. (Contributed by NM, 28-Nov-2005.)
theorem uzneg (M N: class):
  $ wi (wcel N (cfv M cuz)) (wcel (cneg M) (cfv (cneg N) cuz)) $;

--| An upper set of integers is a subset of all integers. (Contributed by NM, 2-Sep-2005.) (Revised by Mario Carneiro, 3-Nov-2013.)
theorem uzssz (M: class):
  $ wss (cfv M cuz) cz $;

--| An upper set of integers is a subset of the reals. (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem uzssre (M: class):
  $ wss (cfv M cuz) cr $;

--| Subset relationship for two sets of upper integers. (Contributed by NM, 5-Sep-2005.)
theorem uzss (M N: class):
  $ wi (wcel N (cfv M cuz)) (wss (cfv N cuz) (cfv M cuz)) $;

--| Totality of the ordering relation on integers, stated in terms of upper integers. (Contributed by NM, 6-Jul-2005.) (Revised by Mario Carneiro, 25-Jun-2013.)
theorem uztric (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wo (wcel N (cfv M cuz)) (wcel M (cfv N cuz))) $;

--| The upper integers function is one-to-one. (Contributed by NM, 12-Dec-2005.)
theorem uz11 (M N: class):
  $ wi (wcel M cz) (wb (wceq (cfv M cuz) (cfv N cuz)) (wceq M N)) $;

--| Membership in the next upper set of integers. (Contributed by NM, 12-Sep-2005.)
theorem eluzp1m1 (M N: class):
  $ wi (wa (wcel M cz) (wcel N (cfv (co M c1 caddc) cuz))) (wcel (co N c1 cmin) (cfv M cuz)) $;

--| Strict ordering implied by membership in the next upper set of integers. (Contributed by NM, 12-Sep-2005.)
theorem eluzp1l (M N: class):
  $ wi (wa (wcel M cz) (wcel N (cfv (co M c1 caddc) cuz))) (wbr M N clt) $;

--| Membership in the next upper set of integers. (Contributed by NM, 5-Oct-2005.)
theorem eluzp1p1 (M N: class):
  $ wi (wcel N (cfv M cuz)) (wcel (co N c1 caddc) (cfv (co M c1 caddc) cuz)) $;

--| Membership in a later upper set of integers. (Contributed by Jeff Madsen, 2-Sep-2009.) (Proof shortened by SN, 7-Feb-2025.)
theorem eluzadd (K M N: class):
  $ wi (wa (wcel N (cfv M cuz)) (wcel K cz)) (wcel (co N K caddc) (cfv (co M K caddc) cuz)) $;

--| Membership in an earlier upper set of integers. (Contributed by Jeff Madsen, 2-Sep-2009.) (Proof shortened by SN, 7-Feb-2025.)
theorem eluzsub (K M N: class):
  $ wi (w3a (wcel M cz) (wcel K cz) (wcel N (cfv (co M K caddc) cuz))) (wcel (co N K cmin) (cfv M cuz)) $;

--| Membership in a later upper set of integers. (Contributed by Paul Chapman, 22-Nov-2007.) Shorten and remove ` M e. ZZ ` hypothesis. (Revised by SN, 7-Feb-2025.)
theorem eluzaddi (K M N: class):
  $ wcel K cz $ >
  $ wi (wcel N (cfv M cuz)) (wcel (co N K caddc) (cfv (co M K caddc) cuz)) $;

--| Membership in an earlier upper set of integers. (Contributed by Paul Chapman, 22-Nov-2007.) (Proof shortened by SN, 7-Feb-2025.)
theorem eluzsubi (K M N: class):
  $ wcel M cz $ >
  $ wcel K cz $ >
  $ wi (wcel N (cfv (co M K caddc) cuz)) (wcel (co N K cmin) (cfv M cuz)) $;

--| Membership of a difference in an earlier upper set of integers. (Contributed by AV, 10-May-2022.)
theorem subeluzsub (K M N: class):
  $ wi (wa (wcel M cz) (wcel N (cfv K cuz))) (wcel (co M K cmin) (cfv (co M N cmin) cuz)) $;

--| Choices for an element of an upper interval of integers. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem uzm1 (M N: class):
  $ wi (wcel N (cfv M cuz)) (wo (wceq N M) (wcel (co N c1 cmin) (cfv M cuz))) $;

--| The nonnegative difference of integers is a nonnegative integer. (Contributed by NM, 4-Sep-2005.)
theorem uznn0sub (M N: class):
  $ wi (wcel N (cfv M cuz)) (wcel (co N M cmin) cn0) $;

--| Intersection of two upper intervals of integers. (Contributed by Mario Carneiro, 24-Dec-2013.)
theorem uzin (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wceq (cin (cfv M cuz) (cfv N cuz)) (cfv (cif (wbr M N cle) N M) cuz)) $;

--| Choices for an element of an upper interval of integers. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem uzp1 (M N: class):
  $ wi (wcel N (cfv M cuz)) (wo (wceq N M) (wcel N (cfv (co M c1 caddc) cuz))) $;

--| Nonnegative integers expressed as an upper set of integers. (Contributed by NM, 2-Sep-2005.)
theorem nn0uz:
  $ wceq cn0 (cfv cc0 cuz) $;

--| Positive integers expressed as an upper set of integers. (Contributed by NM, 2-Sep-2005.)
theorem nnuz:
  $ wceq cn (cfv c1 cuz) $;

--| A positive integer expressed as a member of an upper set of integers. (Contributed by NM, 6-Jun-2006.)
theorem elnnuz (N: class):
  $ wb (wcel N cn) (wcel N (cfv c1 cuz)) $;

--| A nonnegative integer expressed as a member an upper set of integers. (Contributed by NM, 6-Jun-2006.)
theorem elnn0uz (N: class):
  $ wb (wcel N cn0) (wcel N (cfv cc0 cuz)) $;

--| 1 is an integer greater than or equal to 0. (Contributed by Alexander van der Vekens, 8-Jun-2018.)
theorem _1eluzge0:
  $ wcel c1 (cfv cc0 cuz) $;

--| 2 is an integer greater than or equal to 0. (Contributed by Alexander van der Vekens, 8-Jun-2018.) (Proof shortened by OpenAI, 25-Mar-2020.)
theorem _2eluzge0:
  $ wcel c2 (cfv cc0 cuz) $;

--| 2 is an integer greater than or equal to 1. (Contributed by Alexander van der Vekens, 8-Jun-2018.)
theorem _2eluzge1:
  $ wcel c2 (cfv c1 cuz) $;

--| 5 is an integer greater than or equal to 3. (Contributed by AV, 7-Sep-2025.)
theorem _5eluz3:
  $ wcel c5 (cfv c3 cuz) $;

--| An integer greater than or equal to 3 is an integer greater than or equal to 2. (Contributed by Alexander van der Vekens, 17-Sep-2018.)
theorem uzuzle23 (A2: class):
  $ wi (wcel A2 (cfv c3 cuz)) (wcel A2 (cfv c2 cuz)) $;

--| An integer greater than or equal to 4 is an integer greater than or equal to 2. (Contributed by AV, 30-May-2023.)
theorem uzuzle24 (X: class):
  $ wi (wcel X (cfv c4 cuz)) (wcel X (cfv c2 cuz)) $;

--| An integer greater than or equal to 4 is an integer greater than or equal to 3. (Contributed by AV, 5-Sep-2025.)
theorem uzuzle34 (X: class):
  $ wi (wcel X (cfv c4 cuz)) (wcel X (cfv c3 cuz)) $;

--| An integer greater than or equal to 5 is an integer greater than or equal to 3. (Contributed by AV, 15-Nov-2025.)
theorem uzuzle35 (A2: class):
  $ wi (wcel A2 (cfv c5 cuz)) (wcel A2 (cfv c3 cuz)) $;

--| An integer greater than or equal to 2 is a positive integer. (Contributed by AV, 3-Nov-2018.)
theorem eluz2nn (A2: class):
  $ wi (wcel A2 (cfv c2 cuz)) (wcel A2 cn) $;

--| An integer greater than or equal to 3 is a positive integer. (Contributed by Alexander van der Vekens, 17-Sep-2018.) (Proof shortened by AV, 30-Nov-2025.)
theorem eluz3nn (N: class):
  $ wi (wcel N (cfv c3 cuz)) (wcel N cn) $;

--| An integer greater than or equal to 4 is a positive integer. (Contributed by AV, 30-May-2023.)
theorem eluz4nn (X: class):
  $ wi (wcel X (cfv c4 cuz)) (wcel X cn) $;

--| An integer greater than or equal to 5 is a positive integer. (Contributed by AV, 22-Nov-2025.)
theorem eluz5nn (N: class):
  $ wi (wcel N (cfv c5 cuz)) (wcel N cn) $;

--| If an integer is greater than or equal to 2, then it is a nonnegative integer. (Contributed by AV, 27-Aug-2018.) (Proof shortened by AV, 3-Nov-2018.)
theorem eluzge2nn0 (N: class):
  $ wi (wcel N (cfv c2 cuz)) (wcel N cn0) $;

--| An integer greater than or equal to 2 is not 0. (Contributed by AV, 25-May-2020.)
theorem eluz2n0 (N: class):
  $ wi (wcel N (cfv c2 cuz)) (wne N cc0) $;

--| An integer greater than or equal to 3 decreased by 2 is a positive integer, analogous to ~ uz2m1nn . (Contributed by Alexander van der Vekens, 17-Sep-2018.)
theorem uz3m2nn (N: class):
  $ wi (wcel N (cfv c3 cuz)) (wcel (co N c2 cmin) cn) $;

--| The upper integers starting from a natural are a subset of the naturals. (Contributed by Scott Fenton, 29-Jun-2013.)
theorem uznnssnn (N: class):
  $ wi (wcel N cn) (wss (cfv N cuz) cn) $;

--| Restricted universal quantification in an upper set of integers. (Contributed by NM, 9-Sep-2005.)
theorem raluz {n: setvar} (ph: wff n) (M: class):
  $ wi (wcel M cz) (wb (wral n ph (cfv M cuz)) (wral n (wi (wbr M (cv n) cle) ph) cz)) $;

--| Restricted universal quantification in an upper set of integers. (Contributed by NM, 9-Sep-2005.)
theorem raluz2 {n: setvar} (ph: wff n) (M: class):
  $ wb (wral n ph (cfv M cuz)) (wi (wcel M cz) (wral n (wi (wbr M (cv n) cle) ph) cz)) $;

--| Restricted existential quantification in an upper set of integers. (Contributed by NM, 9-Sep-2005.)
theorem rexuz {n: setvar} (ph: wff n) (M: class):
  $ wi (wcel M cz) (wb (wrex n ph (cfv M cuz)) (wrex n (wa (wbr M (cv n) cle) ph) cz)) $;

--| Restricted existential quantification in an upper set of integers. (Contributed by NM, 9-Sep-2005.)
theorem rexuz2 {n: setvar} (ph: wff n) (M: class):
  $ wb (wrex n ph (cfv M cuz)) (wa (wcel M cz) (wrex n (wa (wbr M (cv n) cle) ph) cz)) $;

--| Double existential quantification in an upper set of integers. (Contributed by NM, 3-Nov-2005.)
theorem _2rexuz {m n: setvar} (ph: wff m n):
  $ wb (wex m (wrex n ph (cfv (cv m) cuz))) (wrex m (wrex n (wa (wbr (cv m) (cv n) cle) ph) cz) cz) $;

--| Second Peano postulate for an upper set of integers. (Contributed by NM, 7-Sep-2005.)
theorem peano2uz (M N: class):
  $ wi (wcel N (cfv M cuz)) (wcel (co N c1 caddc) (cfv M cuz)) $;

--| Second Peano postulate for an upper set of integers. (Contributed by Mario Carneiro, 26-Dec-2013.)
theorem peano2uzs (M N Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi (wcel N Z) (wcel (co N c1 caddc) Z) $;

--| Reversed second Peano axiom for upper integers. (Contributed by NM, 2-Jan-2006.)
theorem peano2uzr (M N: class):
  $ wi (wa (wcel M cz) (wcel N (cfv (co M c1 caddc) cuz))) (wcel N (cfv M cuz)) $;

--| Addition closure law for an upper set of integers. (Contributed by NM, 4-Jun-2006.)
theorem uzaddcl (K M N: class):
  $ wi (wa (wcel N (cfv M cuz)) (wcel K cn0)) (wcel (co N K caddc) (cfv M cuz)) $;

--| The sum of a nonnegative integer and an integer is an integer greater than or equal to that integer. (Contributed by Alexander van der Vekens, 3-Oct-2018.)
theorem nn0pzuz (N Z: class):
  $ wi (wa (wcel N cn0) (wcel Z cz)) (wcel (co N Z caddc) (cfv Z cuz)) $;

--| Induction on the upper set of integers that starts at an integer ` M ` . The first four hypotheses give us the substitution instances we need, and the last two are the basis and the induction step. (Contributed by NM, 7-Sep-2005.)
theorem uzind4 {j k: setvar} (ph: wff j) (ps ch th ta: wff k) (M: class) (N: class k):
  $ wi (wceq (cv j) M) (wb ph ps) $ >
  $ wi (wceq (cv j) (cv k)) (wb ph ch) $ >
  $ wi (wceq (cv j) (co (cv k) c1 caddc)) (wb ph th) $ >
  $ wi (wceq (cv j) N) (wb ph ta) $ >
  $ wi (wcel M cz) ps $ >
  $ wi (wcel (cv k) (cfv M cuz)) (wi ch th) $ >
  $ wi (wcel N (cfv M cuz)) ta $;

--| Induction on the upper set of integers that starts at an integer ` M ` . The last four hypotheses give us the substitution instances we need; the first two are the basis and the induction step. Either ~ uzind4 or ~ uzind4ALT may be used; see comment for ~ nnind . (Contributed by NM, 7-Sep-2005.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem uzind4ALT {j k: setvar} (ph: wff j) (ps ch th ta: wff k) (M: class) (N: class k):
  $ wi (wcel M cz) ps $ >
  $ wi (wcel (cv k) (cfv M cuz)) (wi ch th) $ >
  $ wi (wceq (cv j) M) (wb ph ps) $ >
  $ wi (wceq (cv j) (cv k)) (wb ph ch) $ >
  $ wi (wceq (cv j) (co (cv k) c1 caddc)) (wb ph th) $ >
  $ wi (wceq (cv j) N) (wb ph ta) $ >
  $ wi (wcel N (cfv M cuz)) ta $;

--| Induction on the upper set of integers that starts at an integer ` M ` , using explicit substitution. The hypotheses are the basis and the induction step. (Contributed by NM, 4-Nov-2005.)
theorem uzind4s {k: setvar} (ph: wff k) (M: class) (N: class k):
  $ wi (wcel M cz) (wsbc k ph M) $ >
  $ wi (wcel (cv k) (cfv M cuz)) (wi ph (wsbc k ph (co (cv k) c1 caddc))) $ >
  $ wi (wcel N (cfv M cuz)) (wsbc k ph N) $;

--| Induction on the upper set of integers that starts at an integer ` M ` , using explicit substitution. The hypotheses are the basis and the induction step. Use this instead of ~ uzind4s when ` j ` and ` k ` must be distinct in ` [. ( k + 1 ) / j ]. ph ` . (Contributed by NM, 16-Nov-2005.)
theorem uzind4s2 {j k: setvar} (ph: wff j) (M: class j) (N: class j k):
  $ wi (wcel M cz) (wsbc j ph M) $ >
  $ wi (wcel (cv k) (cfv M cuz)) (wi (wsbc j ph (cv k)) (wsbc j ph (co (cv k) c1 caddc))) $ >
  $ wi (wcel N (cfv M cuz)) (wsbc j ph N) $;

--| Induction on the upper integers that start at ` M ` . The first four give us the substitution instances we need, and the last two are the basis and the induction step. This is a stronger version of ~ uzind4 assuming that ` ps ` holds unconditionally. Notice that ` N e. ( ZZ>= `` M ) ` implies that the lower bound ` M ` is an integer ( ` M e. ZZ ` , see ~ eluzel2 ). (Contributed by NM, 4-Sep-2005.) (Revised by AV, 13-Jul-2022.)
theorem uzind4i {j k: setvar} (ph: wff j) (ps ch th ta: wff k) (M: class) (N: class k):
  $ wi (wceq (cv j) M) (wb ph ps) $ >
  $ wi (wceq (cv j) (cv k)) (wb ph ch) $ >
  $ wi (wceq (cv j) (co (cv k) c1 caddc)) (wb ph th) $ >
  $ wi (wceq (cv j) N) (wb ph ta) $ >
  $ ps $ >
  $ wi (wcel (cv k) (cfv M cuz)) (wi ch th) $ >
  $ wi (wcel N (cfv M cuz)) ta $;

--| Well-ordering principle: any nonempty subset of an upper set of integers has a least element. (Contributed by NM, 8-Oct-2005.)
theorem uzwo {j k: setvar} (S: class) (M: class j k):
  $ wi (wa (wss S (cfv M cuz)) (wne S c0)) (wrex j (wral k (wbr (cv j) (cv k) cle) S) S) $;

--| Well-ordering principle: any nonempty subset of an upper set of integers has a unique least element. (Contributed by NM, 8-Oct-2005.)
theorem uzwo2 {j k: setvar} (S: class) (M: class j k):
  $ wi (wa (wss S (cfv M cuz)) (wne S c0)) (wreu j (wral k (wbr (cv j) (cv k) cle) S) S) $;

--| Well-ordering principle: any nonempty set of positive integers has a least element. Theorem I.37 (well-ordering principle) of [Apostol] p. 34. (Contributed by NM, 17-Aug-2001.)
theorem nnwo {x3 y1: setvar} (A2: class):
  $ wi (wa (wss A2 cn) (wne A2 c0)) (wrex x3 (wral y1 (wbr (cv x3) (cv y1) cle) A2) A2) $;

--| Well-ordering principle: any nonempty set of positive integers has a least element. This version allows ` x ` and ` y ` to be present in ` A ` as long as they are effectively not free. (Contributed by NM, 17-Aug-2001.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem nnwof {x3 y1: setvar} (A2: class x3 y1):
  $ wnfc x3 A2 $ >
  $ wnfc y1 A2 $ >
  $ wi (wa (wss A2 cn) (wne A2 c0)) (wrex x3 (wral y1 (wbr (cv x3) (cv y1) cle) A2) A2) $;

--| Well-ordering principle: any nonempty set of positive integers has a least element (schema form). (Contributed by NM, 17-Aug-2001.)
theorem nnwos {x3 y1: setvar} (ph: wff x3) (ps: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wrex x3 ph cn) (wrex x3 (wa ph (wral y1 (wi ps (wbr (cv x3) (cv y1) cle)) cn)) cn) $;

--| Strong Mathematical Induction for positive integers (inference schema). (Contributed by NM, 17-Aug-2001.)
theorem indstr {x3 y1: setvar} (ph: wff x3) (ps: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wcel (cv x3) cn) (wi (wral y1 (wi (wbr (cv y1) (cv x3) clt) ps) cn) ph) $ >
  $ wi (wcel (cv x3) cn) ph $;

--| Membership in a nonnegative upper set of integers implies membership in ` NN0 ` . (Contributed by Paul Chapman, 22-Jun-2011.)
theorem eluznn0 (M N: class):
  $ wi (wa (wcel N cn0) (wcel M (cfv N cuz))) (wcel M cn0) $;

--| Membership in a positive upper set of integers implies membership in ` NN ` . (Contributed by JJ, 1-Oct-2018.)
theorem eluznn (M N: class):
  $ wi (wa (wcel N cn) (wcel M (cfv N cuz))) (wcel M cn) $;

--| Two ways to say "an integer greater than or equal to 2". (Contributed by Paul Chapman, 23-Nov-2012.)
theorem eluz2b1 (N: class):
  $ wb (wcel N (cfv c2 cuz)) (wa (wcel N cz) (wbr c1 N clt)) $;

--| An integer greater than or equal to 2 is greater than 1. (Contributed by AV, 24-May-2020.)
theorem eluz2gt1 (N: class):
  $ wi (wcel N (cfv c2 cuz)) (wbr c1 N clt) $;

--| Two ways to say "an integer greater than or equal to 2". (Contributed by Paul Chapman, 23-Nov-2012.)
theorem eluz2b2 (N: class):
  $ wb (wcel N (cfv c2 cuz)) (wa (wcel N cn) (wbr c1 N clt)) $;

--| Two ways to say "an integer greater than or equal to 2". (Contributed by Paul Chapman, 23-Nov-2012.)
theorem eluz2b3 (N: class):
  $ wb (wcel N (cfv c2 cuz)) (wa (wcel N cn) (wne N c1)) $;

--| One less than an integer greater than or equal to 2 is a positive integer. (Contributed by Paul Chapman, 17-Nov-2012.)
theorem uz2m1nn (N: class):
  $ wi (wcel N (cfv c2 cuz)) (wcel (co N c1 cmin) cn) $;

--| 1 is not in ` ( ZZ>= `` 2 ) ` . (Contributed by Paul Chapman, 21-Nov-2012.)
theorem _1nuz2:
  $ wn (wcel c1 (cfv c2 cuz)) $;

--| A positive integer is either 1 or greater than or equal to 2. (Contributed by Paul Chapman, 17-Nov-2012.)
theorem elnn1uz2 (N: class):
  $ wb (wcel N cn) (wo (wceq N c1) (wcel N (cfv c2 cuz))) $;

--| Closure of multiplication of integers greater than or equal to 2. (Contributed by Paul Chapman, 26-Oct-2012.)
theorem uz2mulcl (M N: class):
  $ wi (wa (wcel M (cfv c2 cuz)) (wcel N (cfv c2 cuz))) (wcel (co M N cmul) (cfv c2 cuz)) $;

--| Strong Mathematical Induction for positive integers (inference schema). The first two hypotheses give us the substitution instances we need; the last two are the basis and the induction step. (Contributed by Paul Chapman, 21-Nov-2012.)
theorem indstr2 {x3 y1: setvar} (ph: wff x3) (ps: wff y1) (ch: wff x3 y1):
  $ wi (wceq (cv x3) c1) (wb ph ch) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ ch $ >
  $ wi (wcel (cv x3) (cfv c2 cuz)) (wi (wral y1 (wi (wbr (cv y1) (cv x3) clt) ps) cn) ph) $ >
  $ wi (wcel (cv x3) cn) ph $;

--| Extract the lower bound of an upper set of integers as its infimum. (Contributed by NM, 7-Oct-2005.) (Revised by AV, 4-Sep-2020.)
theorem uzinfi (M: class):
  $ wcel M cz $ >
  $ wceq (cinf (cfv M cuz) cr clt) M $;

--| The infimum of the set of positive integers is one. (Contributed by NM, 16-Jun-2005.) (Revised by AV, 5-Sep-2020.)
theorem nninf:
  $ wceq (cinf cn cr clt) c1 $;

--| The infimum of the set of nonnegative integers is zero. (Contributed by NM, 16-Jun-2005.) (Revised by AV, 5-Sep-2020.)
theorem nn0inf:
  $ wceq (cinf cn0 cr clt) cc0 $;

--| The infimum of a subset of an upper set of integers is less than or equal to all members of the subset. (Contributed by NM, 11-Oct-2005.) (Revised by AV, 5-Sep-2020.)
theorem infssuzle (A2 S M: class):
  $ wi (wa (wss S (cfv M cuz)) (wcel A2 S)) (wbr (cinf S cr clt) A2 cle) $;

--| The infimum of a subset of an upper set of integers belongs to the subset. (Contributed by NM, 11-Oct-2005.) (Revised by AV, 5-Sep-2020.)
theorem infssuzcl (S M: class):
  $ wi (wa (wss S (cfv M cuz)) (wne S c0)) (wcel (cinf S cr clt) S) $;

--| The image under negation of a bounded-above set of reals is bounded below. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem ublbneg {x3 y1 z: setvar} (A2: class):
  $ wi (wrex x3 (wral y1 (wbr (cv y1) (cv x3) cle) A2) cr) (wrex x3 (wral y1 (wbr (cv x3) (cv y1) cle) (crab z (wcel (cneg (cv z)) A2) cr)) cr) $;

--| Two ways to express the image under negation of a set of integers. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem eqreznegel {z: setvar} (A2: class):
  $ wi (wss A2 cz) (wceq (crab z (wcel (cneg (cv z)) A2) cr) (crab z (wcel (cneg (cv z)) A2) cz)) $;

--| The supremum of a bounded-above set of reals is the negation of the infimum of that set's image under negation. (Contributed by Paul Chapman, 21-Mar-2011.) ( Revised by AV, 13-Sep-2020.)
theorem supminf {x3 y1 z: setvar} (A2: class):
  $ wi (w3a (wss A2 cr) (wne A2 c0) (wrex x3 (wral y1 (wbr (cv y1) (cv x3) cle) A2) cr)) (wceq (csup A2 cr clt) (cneg (cinf (crab z (wcel (cneg (cv z)) A2) cr) cr clt))) $;

--| If a set of reals is bounded below, it is bounded below by an integer. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem lbzbi {x3 y1: setvar} (A2: class):
  $ wi (wss A2 cr) (wb (wrex x3 (wral y1 (wbr (cv x3) (cv y1) cle) A2) cr) (wrex x3 (wral y1 (wbr (cv x3) (cv y1) cle) A2) cz)) $;

--| Any nonempty bounded subset of integers has a supremum in the set. (The proof does not use ~ ax-pre-sup .) (Contributed by Mario Carneiro, 21-Apr-2015.)
theorem zsupss {x3 y1 z: setvar} (A2: class) (B2: class y1 z):
  $ wi (w3a (wss A2 cz) (wne A2 c0) (wrex x3 (wral y1 (wbr (cv y1) (cv x3) cle) A2) cz)) (wrex x3 (wa (wral y1 (wn (wbr (cv x3) (cv y1) clt)) A2) (wral y1 (wi (wbr (cv y1) (cv x3) clt) (wrex z (wbr (cv y1) (cv z) clt) A2)) B2)) A2) $;

--| The supremum of a bounded-above set of integers is a member of the set. (This version of ~ suprzcl avoids ~ ax-pre-sup .) (Contributed by Mario Carneiro, 21-Apr-2015.) (Revised by Mario Carneiro, 24-Dec-2016.)
theorem suprzcl2 {x3 y1: setvar} (A2: class):
  $ wi (w3a (wss A2 cz) (wne A2 c0) (wrex x3 (wral y1 (wbr (cv y1) (cv x3) cle) A2) cz)) (wcel (csup A2 cr clt) A2) $;

--| The supremum of a bounded-above set of integers is greater than any member of the set. (Contributed by Mario Carneiro, 21-Apr-2015.)
theorem suprzub {x3 y1: setvar} (A2: class) (B2: class y1):
  $ wi (w3a (wss A2 cz) (wrex x3 (wral y1 (wbr (cv y1) (cv x3) cle) A2) cz) (wcel B2 A2)) (wbr B2 (csup A2 cr clt) cle) $;

--| Any bounded subset of an upper set of integers has a supremum. (Contributed by Mario Carneiro, 22-Jul-2014.) (Revised by Mario Carneiro, 21-Apr-2015.)
theorem uzsupss {x3 y1 z: setvar} (A2: class) (M: class z) (Z: class y1 z):
  $ wceq Z (cfv M cuz) $ >
  $ wi (w3a (wcel M cz) (wss A2 Z) (wrex x3 (wral y1 (wbr (cv y1) (cv x3) cle) A2) cz)) (wrex x3 (wa (wral y1 (wn (wbr (cv x3) (cv y1) clt)) A2) (wral y1 (wi (wbr (cv y1) (cv x3) clt) (wrex z (wbr (cv y1) (cv z) clt) A2)) Z)) Z) $;

--| A (nonnegative) integer between 1 and 3 must be 1, 2 or 3. (Contributed by Alexander van der Vekens, 13-Sep-2018.)
theorem nn01to3 (N: class):
  $ wi (w3a (wcel N cn0) (wbr c1 N cle) (wbr N c3 cle)) (w3o (wceq N c1) (wceq N c2) (wceq N c3)) $;

--| Alternate proof of ~ nn0ge2m1nn : If a nonnegative integer is greater than or equal to two, the integer decreased by 1 is a positive integer. This version is proved using ~ eluz2 , a theorem for upper sets of integers, which are defined later than the positive and nonnegative integers. This proof is, however, much shorter than the proof of ~ nn0ge2m1nn . (Contributed by Alexander van der Vekens, 1-Aug-2018.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem nn0ge2m1nnALT (N: class):
  $ wi (wa (wcel N cn0) (wbr c2 N cle)) (wcel (co N c1 cmin) cn) $;

--| Well-ordering principle: any nonempty subset of an upper set of integers has a unique least element. This generalization of ~ uzwo2 allows the lower bound ` B ` to be any real number. See also ~ nnwo and ~ nnwos . (Contributed by NM, 12-Nov-2004.) (Proof shortened by Mario Carneiro, 2-Oct-2015.) (Proof shortened by AV, 27-Sep-2020.)
theorem uzwo3 {x3 y1 z: setvar} (A2 B2: class):
  $ wi (wa (wcel B2 cr) (wa (wss A2 (crab z (wbr B2 (cv z) cle) cz)) (wne A2 c0))) (wreu x3 (wral y1 (wbr (cv x3) (cv y1) cle) A2) A2) $;

--| There is a unique smallest integer greater than or equal to a given real number. (Contributed by NM, 12-Nov-2004.) (Revised by Mario Carneiro, 13-Jun-2014.)
theorem zmin {x3 y1: setvar} (A2: class):
  $ wi (wcel A2 cr) (wreu x3 (wa (wbr A2 (cv x3) cle) (wral y1 (wi (wbr A2 (cv y1) cle) (wbr (cv x3) (cv y1) cle)) cz)) cz) $;

--| There is a unique largest integer less than or equal to a given real number. (Contributed by NM, 15-Nov-2004.)
theorem zmax {x3 y1: setvar} (A2: class):
  $ wi (wcel A2 cr) (wreu x3 (wa (wbr (cv x3) A2 cle) (wral y1 (wi (wbr (cv y1) A2 cle) (wbr (cv y1) (cv x3) cle)) cz)) cz) $;

--| There is a unique integer between a real number and the number plus one. Exercise 5 of [Apostol] p. 28. (Contributed by NM, 13-Nov-2004.)
theorem zbtwnre {x3: setvar} (A2: class):
  $ wi (wcel A2 cr) (wreu x3 (wa (wbr A2 (cv x3) cle) (wbr (cv x3) (co A2 c1 caddc) clt)) cz) $;

--| There is a unique greatest integer less than or equal to a real number. Exercise 4 of [Apostol] p. 28. (Contributed by NM, 15-Nov-2004.)
theorem rebtwnz {x3: setvar} (A2: class):
  $ wi (wcel A2 cr) (wreu x3 (wa (wbr (cv x3) A2 cle) (wbr A2 (co (cv x3) c1 caddc) clt)) cz) $;

--| Extend class notation to include the class of rationals.
term cq: class;

--| Define the set of rational numbers. Based on definition of rationals in [Apostol] p. 22. See ~ elq for the relation "is rational". (Contributed by NM, 8-Jan-2002.)
axiom df_q:
  $ wceq cq (cima cdiv (cxp cz cn)) $;

--| Membership in the set of rationals. (Contributed by NM, 8-Jan-2002.) (Revised by Mario Carneiro, 28-Jan-2014.)
theorem elq {x3 y1: setvar} (A2: class):
  $ wb (wcel A2 cq) (wrex x3 (wrex y1 (wceq A2 (co (cv x3) (cv y1) cdiv)) cn) cz) $;

--| If ` A ` is rational, then some integer multiple of it is an integer. (Contributed by NM, 7-Nov-2008.) (Revised by Mario Carneiro, 22-Jul-2014.)
theorem qmulz {x3: setvar} (A2: class):
  $ wi (wcel A2 cq) (wrex x3 (wcel (co A2 (cv x3) cmul) cz) cn) $;

--| The ratio of an integer and a positive integer is a rational number. (Contributed by NM, 12-Jan-2002.)
theorem znq (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cn)) (wcel (co A2 B2 cdiv) cq) $;

--| A rational number is a real number. (Contributed by NM, 14-Nov-2002.)
theorem qre (A2: class):
  $ wi (wcel A2 cq) (wcel A2 cr) $;

--| An integer is a rational number. (Contributed by NM, 9-Jan-2002.) (Proof shortened by Steven Nguyen, 23-Mar-2023.)
theorem zq (A2: class):
  $ wi (wcel A2 cz) (wcel A2 cq) $;

--| A rational number is a real number. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem qred (ph: wff) (A2: class):
  $ wi ph (wcel A2 cq) $ >
  $ wi ph (wcel A2 cr) $;

--| The integers are a subset of the rationals. (Contributed by NM, 9-Jan-2002.)
theorem zssq:
  $ wss cz cq $;

--| The nonnegative integers are a subset of the rationals. (Contributed by NM, 31-Jul-2004.)
theorem nn0ssq:
  $ wss cn0 cq $;

--| The positive integers are a subset of the rationals. (Contributed by NM, 31-Jul-2004.)
theorem nnssq:
  $ wss cn cq $;

--| The rationals are a subset of the reals. (Contributed by NM, 9-Jan-2002.)
theorem qssre:
  $ wss cq cr $;

--| The rationals are a subset of the complex numbers. (Contributed by NM, 2-Aug-2004.)
theorem qsscn:
  $ wss cq cc $;

--| The set of rational numbers exists. See also ~ qexALT . (Contributed by NM, 30-Jul-2004.) (Revised by Mario Carneiro, 17-Nov-2014.)
theorem qex:
  $ wcel cq cvv $;

--| A positive integer is rational. (Contributed by NM, 17-Nov-2004.)
theorem nnq (A2: class):
  $ wi (wcel A2 cn) (wcel A2 cq) $;

--| A rational number is a complex number. (Contributed by NM, 2-Aug-2004.)
theorem qcn (A2: class):
  $ wi (wcel A2 cq) (wcel A2 cc) $;

--| Alternate proof of ~ qex . (Contributed by NM, 30-Jul-2004.) (Revised by Mario Carneiro, 16-Jun-2013.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem qexALT:
  $ wcel cq cvv $;

--| The number 1 is rational. (Contributed by SN, 30-Aug-2026.)
theorem _1q:
  $ wcel c1 cq $;

--| Closure of addition of rationals. (Contributed by NM, 1-Aug-2004.)
theorem qaddcl (A2 B2: class):
  $ wi (wa (wcel A2 cq) (wcel B2 cq)) (wcel (co A2 B2 caddc) cq) $;

--| Closure law for the negative of a rational. (Contributed by NM, 2-Aug-2004.) (Revised by Mario Carneiro, 15-Sep-2014.)
theorem qnegcl (A2: class):
  $ wi (wcel A2 cq) (wcel (cneg A2) cq) $;

--| Closure of multiplication of rationals. (Contributed by NM, 1-Aug-2004.)
theorem qmulcl (A2 B2: class):
  $ wi (wa (wcel A2 cq) (wcel B2 cq)) (wcel (co A2 B2 cmul) cq) $;

--| Closure of subtraction of rationals. (Contributed by NM, 2-Aug-2004.)
theorem qsubcl (A2 B2: class):
  $ wi (wa (wcel A2 cq) (wcel B2 cq)) (wcel (co A2 B2 cmin) cq) $;

--| Closure of reciprocal of rationals. (Contributed by NM, 3-Aug-2004.)
theorem qreccl (A2: class):
  $ wi (wa (wcel A2 cq) (wne A2 cc0)) (wcel (co c1 A2 cdiv) cq) $;

--| Closure of division of rationals. (Contributed by NM, 3-Aug-2004.)
theorem qdivcl (A2 B2: class):
  $ wi (w3a (wcel A2 cq) (wcel B2 cq) (wne B2 cc0)) (wcel (co A2 B2 cdiv) cq) $;

--| Reverse closure law for addition of rationals. (Contributed by NM, 2-Aug-2004.)
theorem qrevaddcl (A2 B2: class):
  $ wi (wcel B2 cq) (wb (wa (wcel A2 cc) (wcel (co A2 B2 caddc) cq)) (wcel A2 cq)) $;

--| The reciprocal of a positive integer is rational. (Contributed by NM, 17-Nov-2004.)
theorem nnrecq (A2: class):
  $ wi (wcel A2 cn) (wcel (co c1 A2 cdiv) cq) $;

--| The sum of an irrational number and a rational number is irrational. (Contributed by NM, 7-Nov-2008.)
theorem irradd (A2 B2: class):
  $ wi (wa (wcel A2 (cdif cr cq)) (wcel B2 cq)) (wcel (co A2 B2 caddc) (cdif cr cq)) $;

--| The product of an irrational with a nonzero rational is irrational. (Contributed by NM, 7-Nov-2008.)
theorem irrmul (A2 B2: class):
  $ wi (w3a (wcel A2 (cdif cr cq)) (wcel B2 cq) (wne B2 cc0)) (wcel (co A2 B2 cmul) (cdif cr cq)) $;

--| A positive rational is the quotient of two positive integers. (Contributed by AV, 29-Dec-2022.)
theorem elpq {x3 y1: setvar} (A2: class):
  $ wi (wa (wcel A2 cq) (wbr cc0 A2 clt)) (wrex x3 (wrex y1 (wceq A2 (co (cv x3) (cv y1) cdiv)) cn) cn) $;

--| A class is a positive rational iff it is the quotient of two positive integers. (Contributed by AV, 30-Dec-2022.)
theorem elpqb {x3 y1: setvar} (A2: class):
  $ wb (wa (wcel A2 cq) (wbr cc0 A2 clt)) (wrex x3 (wrex y1 (wceq A2 (co (cv x3) (cv y1) cdiv)) cn) cn) $;

--| Lemma for ~ rpnnen1 . (Contributed by Mario Carneiro, 12-May-2013.)
theorem rpnnen1lem2 {x3 k n: setvar} (T: class x3 k) (F: class):
  $ wceq T (crab n (wbr (co (cv n) (cv k) cdiv) (cv x3) clt) cz) $ >
  $ wceq F (cmpt x3 cr (cmpt k cn (co (csup T cr clt) (cv k) cdiv))) $ >
  $ wi (wa (wcel (cv x3) cr) (wcel (cv k) cn)) (wcel (csup T cr clt) cz) $;

--| Lemma for ~ rpnnen1 . (Contributed by Mario Carneiro, 12-May-2013.) (Revised by NM, 13-Aug-2021.) (Proof modification is discouraged.)
theorem rpnnen1lem1 {x3 k n: setvar} (T: class x3 k) (F: class):
  $ wceq T (crab n (wbr (co (cv n) (cv k) cdiv) (cv x3) clt) cz) $ >
  $ wceq F (cmpt x3 cr (cmpt k cn (co (csup T cr clt) (cv k) cdiv))) $ >
  $ wcel cn cvv $ >
  $ wcel cq cvv $ >
  $ wi (wcel (cv x3) cr) (wcel (cfv (cv x3) F) (co cq cn cmap)) $;

--| Lemma for ~ rpnnen1 . (Contributed by Mario Carneiro, 12-May-2013.) (Revised by NM, 13-Aug-2021.) (Proof modification is discouraged.)
theorem rpnnen1lem3 {x3 k n: setvar} (T: class x3 k) (F: class):
  $ wceq T (crab n (wbr (co (cv n) (cv k) cdiv) (cv x3) clt) cz) $ >
  $ wceq F (cmpt x3 cr (cmpt k cn (co (csup T cr clt) (cv k) cdiv))) $ >
  $ wcel cn cvv $ >
  $ wcel cq cvv $ >
  $ wi (wcel (cv x3) cr) (wral n (wbr (cv n) (cv x3) cle) (crn (cfv (cv x3) F))) $;

--| Lemma for ~ rpnnen1 . (Contributed by Mario Carneiro, 12-May-2013.) (Revised by NM, 13-Aug-2021.) (Proof modification is discouraged.)
theorem rpnnen1lem4 {x3 k n: setvar} (T: class x3 k) (F: class):
  $ wceq T (crab n (wbr (co (cv n) (cv k) cdiv) (cv x3) clt) cz) $ >
  $ wceq F (cmpt x3 cr (cmpt k cn (co (csup T cr clt) (cv k) cdiv))) $ >
  $ wcel cn cvv $ >
  $ wcel cq cvv $ >
  $ wi (wcel (cv x3) cr) (wcel (csup (crn (cfv (cv x3) F)) cr clt) cr) $;

--| Lemma for ~ rpnnen1 . (Contributed by Mario Carneiro, 12-May-2013.) (Revised by NM, 13-Aug-2021.) (Proof modification is discouraged.)
theorem rpnnen1lem5 {x3 k n: setvar} (T: class x3 k) (F: class):
  $ wceq T (crab n (wbr (co (cv n) (cv k) cdiv) (cv x3) clt) cz) $ >
  $ wceq F (cmpt x3 cr (cmpt k cn (co (csup T cr clt) (cv k) cdiv))) $ >
  $ wcel cn cvv $ >
  $ wcel cq cvv $ >
  $ wi (wcel (cv x3) cr) (wceq (csup (crn (cfv (cv x3) F)) cr clt) (cv x3)) $;

--| Lemma for ~ rpnnen1 . (Contributed by Mario Carneiro, 12-May-2013.) (Revised by NM, 15-Aug-2021.) (Proof modification is discouraged.)
theorem rpnnen1lem6 {x3 k n: setvar} (T: class x3 k) (F: class):
  $ wceq T (crab n (wbr (co (cv n) (cv k) cdiv) (cv x3) clt) cz) $ >
  $ wceq F (cmpt x3 cr (cmpt k cn (co (csup T cr clt) (cv k) cdiv))) $ >
  $ wcel cn cvv $ >
  $ wcel cq cvv $ >
  $ wbr cr (co cq cn cmap) cdom $;

--| One half of ~ rpnnen , where we show an injection from the real numbers to sequences of rational numbers. Specifically, we map a real number ` x ` to the sequence ` ( F `` x ) : NN --> QQ ` (see ~ rpnnen1lem6 ) such that ` ( ( F `` x ) `` k ) ` is the largest rational number with denominator ` k ` that is strictly less than ` x ` . In this manner, we get a monotonically increasing sequence that converges to ` x ` , and since each sequence converges to a unique real number, this mapping from reals to sequences of rational numbers is injective. Note: The ` NN ` and ` QQ ` existence hypotheses provide for use with either ~ nnex and ~ qex , or ~ nnexALT and ~ qexALT . The proof should not be modified to use any of those 4 theorems. (Contributed by Mario Carneiro, 13-May-2013.) (Revised by Mario Carneiro, 16-Jun-2013.) (Revised by NM, 15-Aug-2021.) (Proof modification is discouraged.)
theorem rpnnen1:
  $ wcel cn cvv $ >
  $ wcel cq cvv $ >
  $ wbr cr (co cq cn cmap) cdom $;

--| Alternate proof of ~ reex . (Contributed by NM, 30-Jul-2004.) (Revised by Mario Carneiro, 23-Aug-2014.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem reexALT:
  $ wcel cr cvv $;

--| There is a natural one-to-one mapping from ` ( RR X. RR ) ` to ` CC ` , where we map ` <. x , y >. ` to ` ( x + ( _i x. y ) ) ` . In our construction of the complex numbers, this is in fact our _definition_ of ` CC ` (see ~ df-c ), but in the axiomatic treatment we can only show that there is the expected mapping between these two sets. (Contributed by Mario Carneiro, 16-Jun-2013.) (Revised by Mario Carneiro, 17-Feb-2014.)
theorem cnref1o {x3 y1: setvar} (F: class x3 y1):
  $ wceq F (cmpo x3 y1 cr cr (co (cv x3) (co ci (cv y1) cmul) caddc)) $ >
  $ wf1o (cxp cr cr) cc F $;

--| The set of complex numbers exists. This theorem shows that ~ ax-cnex is redundant if we assume ~ ax-rep . See also ~ ax-cnex . (Contributed by NM, 30-Jul-2004.) (Revised by Mario Carneiro, 16-Jun-2013.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem cnexALT:
  $ wcel cc cvv $;

--| The set of extended reals exists. (Contributed by NM, 24-Dec-2006.)
theorem xrex:
  $ wcel cxr cvv $;

--| The addition operation is a set. Version of ~ addex using maps-to notation , which does not require ~ ax-addf . (Contributed by GG, 31-Mar-2025.)
theorem mpoaddex {x3 y1: setvar}:
  $ wcel (cmpo x3 y1 cc cc (co (cv x3) (cv y1) caddc)) cvv $;

--| The addition operation is a set. (Contributed by NM, 19-Oct-2004.) (Revised by Mario Carneiro, 17-Nov-2014.)
theorem addex:
  $ wcel caddc cvv $;

--| The multiplication operation is a set. Version of ~ mulex using maps-to notation , which does not require ~ ax-mulf . (Contributed by GG, 16-Mar-2025.)
theorem mpomulex {x3 y1: setvar}:
  $ wcel (cmpo x3 y1 cc cc (co (cv x3) (cv y1) cmul)) cvv $;

--| The multiplication operation is a set. (Contributed by NM, 19-Oct-2004.) (Revised by Mario Carneiro, 17-Nov-2014.)
theorem mulex:
  $ wcel cmul cvv $;

--| Extend class notation to include the class of positive reals.
term crp: class;

--| Define the set of positive reals. Definition of positive numbers in [Apostol] p. 20. (Contributed by NM, 27-Oct-2007.)
axiom df_rp {x3: setvar}:
  $ wceq crp (crab x3 (wbr cc0 (cv x3) clt) cr) $;

--| Membership in the set of positive reals. (Contributed by NM, 27-Oct-2007.)
theorem elrp (A2: class):
  $ wb (wcel A2 crp) (wa (wcel A2 cr) (wbr cc0 A2 clt)) $;

--| Membership in the set of positive reals. (Contributed by NM, 23-Feb-2008.)
theorem elrpii (A2: class):
  $ wcel A2 cr $ >
  $ wbr cc0 A2 clt $ >
  $ wcel A2 crp $;

--| 1 is a positive real. (Contributed by Jeff Hankins, 23-Nov-2008.)
theorem _1rp:
  $ wcel c1 crp $;

--| 2 is a positive real. (Contributed by Mario Carneiro, 28-May-2016.)
theorem _2rp:
  $ wcel c2 crp $;

--| 3 is a positive real. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem _3rp:
  $ wcel c3 crp $;

--| 5 is a positive real. (Contributed by SN, 26-Aug-2025.)
theorem _5rp:
  $ wcel c5 crp $;

--| The positive reals are a subset of the reals. (Contributed by NM, 24-Feb-2008.)
theorem rpssre:
  $ wss crp cr $;

--| A positive real is a real. (Contributed by NM, 27-Oct-2007.) (Proof shortened by Steven Nguyen, 8-Oct-2022.)
theorem rpre (A2: class):
  $ wi (wcel A2 crp) (wcel A2 cr) $;

--| A positive real is an extended real. (Contributed by Mario Carneiro, 21-Aug-2015.)
theorem rpxr (A2: class):
  $ wi (wcel A2 crp) (wcel A2 cxr) $;

--| A positive real is a complex number. (Contributed by NM, 11-Nov-2008.)
theorem rpcn (A2: class):
  $ wi (wcel A2 crp) (wcel A2 cc) $;

--| A positive integer is a positive real. (Contributed by NM, 28-Nov-2008.)
theorem nnrp (A2: class):
  $ wi (wcel A2 cn) (wcel A2 crp) $;

--| A positive real is greater than zero. (Contributed by FL, 27-Dec-2007.)
theorem rpgt0 (A2: class):
  $ wi (wcel A2 crp) (wbr cc0 A2 clt) $;

--| A positive real is greater than or equal to zero. (Contributed by NM, 22-Feb-2008.)
theorem rpge0 (A2: class):
  $ wi (wcel A2 crp) (wbr cc0 A2 cle) $;

--| A positive real is a positive real number. (Contributed by NM, 11-Nov-2008.) (Revised by Mario Carneiro, 31-Jan-2014.)
theorem rpregt0 (A2: class):
  $ wi (wcel A2 crp) (wa (wcel A2 cr) (wbr cc0 A2 clt)) $;

--| A positive real is a nonnegative real number. (Contributed by Mario Carneiro, 31-Jan-2014.)
theorem rprege0 (A2: class):
  $ wi (wcel A2 crp) (wa (wcel A2 cr) (wbr cc0 A2 cle)) $;

--| A positive real is nonzero. (Contributed by NM, 18-Jul-2008.)
theorem rpne0 (A2: class):
  $ wi (wcel A2 crp) (wne A2 cc0) $;

--| A positive real is a nonzero real number. (Contributed by NM, 11-Nov-2008.)
theorem rprene0 (A2: class):
  $ wi (wcel A2 crp) (wa (wcel A2 cr) (wne A2 cc0)) $;

--| A positive real is a nonzero complex number. (Contributed by NM, 11-Nov-2008.)
theorem rpcnne0 (A2: class):
  $ wi (wcel A2 crp) (wa (wcel A2 cc) (wne A2 cc0)) $;

--| The negative of a positive number is less than the number itself. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem neglt (A2: class):
  $ wi (wcel A2 crp) (wbr (cneg A2) A2 clt) $;

--| A positive real number is a complex number not being 0. (Contributed by AV, 29-May-2020.)
theorem rpcndif0 (A2: class):
  $ wi (wcel A2 crp) (wcel A2 (cdif cc (csn cc0))) $;

--| Quantification over positive reals. (Contributed by NM, 12-Feb-2008.)
theorem ralrp {x3: setvar} (ph: wff x3):
  $ wb (wral x3 ph crp) (wral x3 (wi (wbr cc0 (cv x3) clt) ph) cr) $;

--| Quantification over positive reals. (Contributed by Mario Carneiro, 21-May-2014.)
theorem rexrp {x3: setvar} (ph: wff x3):
  $ wb (wrex x3 ph crp) (wrex x3 (wa (wbr cc0 (cv x3) clt) ph) cr) $;

--| Closure law for addition of positive reals. Part of Axiom 7 of [Apostol] p. 20. (Contributed by NM, 27-Oct-2007.)
theorem rpaddcl (A2 B2: class):
  $ wi (wa (wcel A2 crp) (wcel B2 crp)) (wcel (co A2 B2 caddc) crp) $;

--| Closure law for multiplication of positive reals. Part of Axiom 7 of [Apostol] p. 20. (Contributed by NM, 27-Oct-2007.)
theorem rpmulcl (A2 B2: class):
  $ wi (wa (wcel A2 crp) (wcel B2 crp)) (wcel (co A2 B2 cmul) crp) $;

--| "Minus times minus is plus", see also ~ nnmtmip , holds for positive reals, too (formalized to "The product of two negative reals is a positive real"). "The reason for this" in this case is that ` ( -u A x. -u B ) ` ` = ( A x. B ) ` for all complex numbers ` A ` and ` B ` because of ~ mul2neg , ` A ` and ` B ` are complex numbers because of ~ rpcn , and ` ( A x. B ) e. RR+ ` because of ~ rpmulcl . Note that the opposites ` -u A ` and ` -u B ` of the positive reals ` A ` and ` B ` are negative reals. (Contributed by AV, 23-Dec-2022.)
theorem rpmtmip (A2 B2: class):
  $ wi (wa (wcel A2 crp) (wcel B2 crp)) (wcel (co (cneg A2) (cneg B2) cmul) crp) $;

--| Closure law for division of positive reals. (Contributed by FL, 27-Dec-2007.)
theorem rpdivcl (A2 B2: class):
  $ wi (wa (wcel A2 crp) (wcel B2 crp)) (wcel (co A2 B2 cdiv) crp) $;

--| Closure law for reciprocation of positive reals. (Contributed by Jeff Hankins, 23-Nov-2008.)
theorem rpreccl (A2: class):
  $ wi (wcel A2 crp) (wcel (co c1 A2 cdiv) crp) $;

--| Closure law for half of a positive real. (Contributed by Mario Carneiro, 31-Jan-2014.)
theorem rphalfcl (A2: class):
  $ wi (wcel A2 crp) (wcel (co A2 c2 cdiv) crp) $;

--| A number greater than or equal to a positive real is positive real. (Contributed by Mario Carneiro, 28-May-2016.)
theorem rpgecl (A2 B2: class):
  $ wi (w3a (wcel A2 crp) (wcel B2 cr) (wbr A2 B2 cle)) (wcel B2 crp) $;

--| Half of a positive real is less than the original number. (Contributed by Mario Carneiro, 21-May-2014.)
theorem rphalflt (A2: class):
  $ wi (wcel A2 crp) (wbr (co A2 c2 cdiv) A2 clt) $;

--| Closure law for division of a real by a positive real. (Contributed by NM, 10-Nov-2008.)
theorem rerpdivcl (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 crp)) (wcel (co A2 B2 cdiv) cr) $;

--| A nonnegative number plus one is a positive number. (Contributed by Mario Carneiro, 5-Oct-2015.)
theorem ge0p1rp (A2: class):
  $ wi (wa (wcel A2 cr) (wbr cc0 A2 cle)) (wcel (co A2 c1 caddc) crp) $;

--| Either a nonzero real or its negation is a positive real, but not both. Axiom 8 of [Apostol] p. 20. (Contributed by NM, 7-Nov-2008.)
theorem rpneg (A2: class):
  $ wi (wa (wcel A2 cr) (wne A2 cc0)) (wb (wcel A2 crp) (wn (wcel (cneg A2) crp))) $;

--| Elementhood of a negation in the positive real numbers. (Contributed by Thierry Arnoux, 19-Sep-2018.)
theorem negelrp (A2: class):
  $ wi (wcel A2 cr) (wb (wcel (cneg A2) crp) (wbr A2 cc0 clt)) $;

--| The negation of a negative number is in the positive real numbers. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem negelrpd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wbr A2 cc0 clt) $ >
  $ wi ph (wcel (cneg A2) crp) $;

--| Zero is not a positive real. Axiom 9 of [Apostol] p. 20. (Contributed by NM, 27-Oct-2007.)
theorem _0nrp:
  $ wn (wcel cc0 crp) $;

--| Subtracting a positive real from another number decreases it. (Contributed by FL, 27-Dec-2007.)
theorem ltsubrp (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 crp)) (wbr (co A2 B2 cmin) A2 clt) $;

--| Adding a positive number to another number increases it. (Contributed by FL, 27-Dec-2007.)
theorem ltaddrp (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 crp)) (wbr A2 (co A2 B2 caddc) clt) $;

--| Two ways to say one number is less than another. (Contributed by Mario Carneiro, 21-May-2014.)
theorem difrp (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wb (wbr A2 B2 clt) (wcel (co B2 A2 cmin) crp)) $;

--| Membership in the set of positive reals. (Contributed by Mario Carneiro, 28-May-2016.)
theorem elrpd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wbr cc0 A2 clt) $ >
  $ wi ph (wcel A2 crp) $;

--| A positive integer is a positive real. (Contributed by Mario Carneiro, 28-May-2016.)
theorem nnrpd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel A2 crp) $;

--| An integer greater than 1 is a positive real number not equal to 0 or 1. Useful for working with integer logarithm bases (which is a common case, e.g., base 2, base 3, or base 10). (Contributed by Thierry Arnoux, 26-Sep-2017.) (Proof shortened by AV, 9-Jul-2022.)
theorem zgt1rpn0n1 (B2: class):
  $ wi (wcel B2 (cfv c2 cuz)) (w3a (wcel B2 crp) (wne B2 cc0) (wne B2 c1)) $;

--| A positive real is a real. (Contributed by Mario Carneiro, 28-May-2016.)
theorem rpred (ph: wff) (A2: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel A2 cr) $;

--| A positive real is an extended real. (Contributed by Mario Carneiro, 28-May-2016.)
theorem rpxrd (ph: wff) (A2: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel A2 cxr) $;

--| A positive real is a complex number. (Contributed by Mario Carneiro, 28-May-2016.)
theorem rpcnd (ph: wff) (A2: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel A2 cc) $;

--| A positive real is greater than zero. (Contributed by Mario Carneiro, 28-May-2016.)
theorem rpgt0d (ph: wff) (A2: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wbr cc0 A2 clt) $;

--| A positive real is greater than or equal to zero. (Contributed by Mario Carneiro, 28-May-2016.)
theorem rpge0d (ph: wff) (A2: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wbr cc0 A2 cle) $;

--| A positive real is nonzero. (Contributed by Mario Carneiro, 28-May-2016.)
theorem rpne0d (ph: wff) (A2: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wne A2 cc0) $;

--| A positive real is real and greater than zero. (Contributed by Mario Carneiro, 28-May-2016.)
theorem rpregt0d (ph: wff) (A2: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wa (wcel A2 cr) (wbr cc0 A2 clt)) $;

--| A positive real is real and greater than or equal to zero. (Contributed by Mario Carneiro, 28-May-2016.)
theorem rprege0d (ph: wff) (A2: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wa (wcel A2 cr) (wbr cc0 A2 cle)) $;

--| A positive real is a nonzero real number. (Contributed by Mario Carneiro, 28-May-2016.)
theorem rprene0d (ph: wff) (A2: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wa (wcel A2 cr) (wne A2 cc0)) $;

--| A positive real is a nonzero complex number. (Contributed by Mario Carneiro, 28-May-2016.)
theorem rpcnne0d (ph: wff) (A2: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wa (wcel A2 cc) (wne A2 cc0)) $;

--| Closure law for reciprocation of positive reals. (Contributed by Mario Carneiro, 28-May-2016.)
theorem rpreccld (ph: wff) (A2: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel (co c1 A2 cdiv) crp) $;

--| Closure law for reciprocation of positive reals. (Contributed by Mario Carneiro, 28-May-2016.)
theorem rprecred (ph: wff) (A2: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel (co c1 A2 cdiv) cr) $;

--| Closure law for half of a positive real. (Contributed by Mario Carneiro, 28-May-2016.)
theorem rphalfcld (ph: wff) (A2: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel (co A2 c2 cdiv) crp) $;

--| The reciprocal of a positive number less than 1 is greater than 1. (Contributed by Mario Carneiro, 28-May-2016.)
theorem reclt1d (ph: wff) (A2: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wb (wbr A2 c1 clt) (wbr c1 (co c1 A2 cdiv) clt)) $;

--| The reciprocal of a positive number greater than 1 is less than 1. (Contributed by Mario Carneiro, 28-May-2016.)
theorem recgt1d (ph: wff) (A2: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wb (wbr c1 A2 clt) (wbr (co c1 A2 cdiv) c1 clt)) $;

--| Closure law for addition of positive reals. Part of Axiom 7 of [Apostol] p. 20. (Contributed by Mario Carneiro, 28-May-2016.)
theorem rpaddcld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wcel (co A2 B2 caddc) crp) $;

--| Closure law for multiplication of positive reals. Part of Axiom 7 of [Apostol] p. 20. (Contributed by Mario Carneiro, 28-May-2016.)
theorem rpmulcld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wcel (co A2 B2 cmul) crp) $;

--| Closure law for division of positive reals. (Contributed by Mario Carneiro, 28-May-2016.)
theorem rpdivcld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wcel (co A2 B2 cdiv) crp) $;

--| The reciprocal of both sides of 'less than'. (Contributed by Mario Carneiro, 28-May-2016.)
theorem ltrecd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wb (wbr A2 B2 clt) (wbr (co c1 B2 cdiv) (co c1 A2 cdiv) clt)) $;

--| The reciprocal of both sides of 'less than or equal to'. (Contributed by Mario Carneiro, 28-May-2016.)
theorem lerecd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wb (wbr A2 B2 cle) (wbr (co c1 B2 cdiv) (co c1 A2 cdiv) cle)) $;

--| Reciprocal swap in a 'less than' relation. (Contributed by Mario Carneiro, 28-May-2016.)
theorem ltrec1d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wbr (co c1 A2 cdiv) B2 clt) $ >
  $ wi ph (wbr (co c1 B2 cdiv) A2 clt) $;

--| Reciprocal swap in a 'less than or equal to' relation. (Contributed by Mario Carneiro, 28-May-2016.)
theorem lerec2d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wbr A2 (co c1 B2 cdiv) cle) $ >
  $ wi ph (wbr B2 (co c1 A2 cdiv) cle) $;

--| Division of both sides of 'less than or equal to' into a nonnegative number. (Contributed by Mario Carneiro, 28-May-2016.)
theorem lediv2ad (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wbr cc0 C cle) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wi ph (wbr (co C B2 cdiv) (co C A2 cdiv) cle) $;

--| Division of a positive number by both sides of 'less than'. (Contributed by Mario Carneiro, 28-May-2016.)
theorem ltdiv2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wcel C crp) $ >
  $ wi ph (wb (wbr A2 B2 clt) (wbr (co C B2 cdiv) (co C A2 cdiv) clt)) $;

--| Division of a positive number by both sides of 'less than or equal to'. (Contributed by Mario Carneiro, 28-May-2016.)
theorem lediv2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wcel C crp) $ >
  $ wi ph (wb (wbr A2 B2 cle) (wbr (co C B2 cdiv) (co C A2 cdiv) cle)) $;

--| Invert ratios of positive numbers and swap their ordering. (Contributed by Mario Carneiro, 28-May-2016.)
theorem ledivdivd (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wcel C crp) $ >
  $ wi ph (wcel D crp) $ >
  $ wi ph (wbr (co A2 B2 cdiv) (co C D cdiv) cle) $ >
  $ wi ph (wbr (co D C cdiv) (co B2 A2 cdiv) cle) $;

--| The ratio of a number over a smaller positive number is larger than 1. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem divge1 (A2 B2: class):
  $ wi (w3a (wcel A2 crp) (wcel B2 cr) (wbr A2 B2 cle)) (wbr c1 (co B2 A2 cdiv) cle) $;

--| A real number divided by a positive real number is less than 1 iff the real number is less than the positive real number. (Contributed by AV, 25-May-2020.)
theorem divlt1lt (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 crp)) (wb (wbr (co A2 B2 cdiv) c1 clt) (wbr A2 B2 clt)) $;

--| A real number divided by a positive real number is less than or equal to 1 iff the real number is less than or equal to the positive real number. (Contributed by AV, 29-Jun-2021.)
theorem divle1le (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 crp)) (wb (wbr (co A2 B2 cdiv) c1 cle) (wbr A2 B2 cle)) $;

--| If a number is less than or equal to another number, the number divided by a positive number greater than or equal to one is less than or equal to the other number. (Contributed by AV, 29-Jun-2021.)
theorem ledivge1le (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 crp) (wa (wcel C crp) (wbr c1 C cle))) (wi (wbr A2 B2 cle) (wbr (co A2 C cdiv) B2 cle)) $;

--| A nonnegative number plus one is a positive number. (Contributed by Mario Carneiro, 28-May-2016.)
theorem ge0p1rpd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wbr cc0 A2 cle) $ >
  $ wi ph (wcel (co A2 c1 caddc) crp) $;

--| Closure law for division of a real by a positive real. (Contributed by Mario Carneiro, 28-May-2016.)
theorem rerpdivcld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wcel (co A2 B2 cdiv) cr) $;

--| Subtracting a positive real from another number decreases it. (Contributed by Mario Carneiro, 28-May-2016.)
theorem ltsubrpd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wbr (co A2 B2 cmin) A2 clt) $;

--| Adding a positive number to another number increases it. (Contributed by Mario Carneiro, 28-May-2016.)
theorem ltaddrpd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wbr A2 (co A2 B2 caddc) clt) $;

--| Adding a positive number to another number increases it. (Contributed by Mario Carneiro, 28-May-2016.)
theorem ltaddrp2d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wbr A2 (co B2 A2 caddc) clt) $;

--| Multiplication by a number greater than 1. (Contributed by Mario Carneiro, 28-May-2016.)
theorem ltmulgt11d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wb (wbr c1 A2 clt) (wbr B2 (co B2 A2 cmul) clt)) $;

--| Multiplication by a number greater than 1. (Contributed by Mario Carneiro, 28-May-2016.)
theorem ltmulgt12d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wb (wbr c1 A2 clt) (wbr B2 (co A2 B2 cmul) clt)) $;

--| Division of a positive number by a positive number. (Contributed by Mario Carneiro, 28-May-2016.)
theorem gt0divd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wb (wbr cc0 A2 clt) (wbr cc0 (co A2 B2 cdiv) clt)) $;

--| Division of a nonnegative number by a positive number. (Contributed by Mario Carneiro, 28-May-2016.)
theorem ge0divd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wb (wbr cc0 A2 cle) (wbr cc0 (co A2 B2 cdiv) cle)) $;

--| A number greater than or equal to a positive real is positive real. (Contributed by Mario Carneiro, 28-May-2016.)
theorem rpgecld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wbr B2 A2 cle) $ >
  $ wi ph (wcel A2 crp) $;

--| The ratio of nonnegative and positive numbers is nonnegative. (Contributed by Mario Carneiro, 28-May-2016.)
theorem divge0d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wbr cc0 A2 cle) $ >
  $ wi ph (wbr cc0 (co A2 B2 cdiv) cle) $;

--| The ratio of nonnegative and positive numbers is nonnegative. (Contributed by Mario Carneiro, 28-May-2016.)
theorem ltmul1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C crp) $ >
  $ wi ph (wb (wbr A2 B2 clt) (wbr (co A2 C cmul) (co B2 C cmul) clt)) $;

--| Multiplication of both sides of 'less than' by a positive number. Theorem I.19 of [Apostol] p. 20. (Contributed by Mario Carneiro, 28-May-2016.)
theorem ltmul2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C crp) $ >
  $ wi ph (wb (wbr A2 B2 clt) (wbr (co C A2 cmul) (co C B2 cmul) clt)) $;

--| Multiplication of both sides of 'less than or equal to' by a positive number. (Contributed by Mario Carneiro, 28-May-2016.)
theorem lemul1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C crp) $ >
  $ wi ph (wb (wbr A2 B2 cle) (wbr (co A2 C cmul) (co B2 C cmul) cle)) $;

--| Multiplication of both sides of 'less than or equal to' by a positive number. (Contributed by Mario Carneiro, 28-May-2016.)
theorem lemul2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C crp) $ >
  $ wi ph (wb (wbr A2 B2 cle) (wbr (co C A2 cmul) (co C B2 cmul) cle)) $;

--| Division of both sides of 'less than' by a positive number. (Contributed by Mario Carneiro, 28-May-2016.)
theorem ltdiv1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C crp) $ >
  $ wi ph (wb (wbr A2 B2 clt) (wbr (co A2 C cdiv) (co B2 C cdiv) clt)) $;

--| Division of both sides of a less than or equal to relation by a positive number. (Contributed by Mario Carneiro, 28-May-2016.)
theorem lediv1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C crp) $ >
  $ wi ph (wb (wbr A2 B2 cle) (wbr (co A2 C cdiv) (co B2 C cdiv) cle)) $;

--| 'Less than' relationship between division and multiplication. (Contributed by Mario Carneiro, 28-May-2016.)
theorem ltmuldivd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C crp) $ >
  $ wi ph (wb (wbr (co A2 C cmul) B2 clt) (wbr A2 (co B2 C cdiv) clt)) $;

--| 'Less than' relationship between division and multiplication. (Contributed by Mario Carneiro, 28-May-2016.)
theorem ltmuldiv2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C crp) $ >
  $ wi ph (wb (wbr (co C A2 cmul) B2 clt) (wbr A2 (co B2 C cdiv) clt)) $;

--| 'Less than or equal to' relationship between division and multiplication. (Contributed by Mario Carneiro, 30-May-2016.)
theorem lemuldivd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C crp) $ >
  $ wi ph (wb (wbr (co A2 C cmul) B2 cle) (wbr A2 (co B2 C cdiv) cle)) $;

--| 'Less than or equal to' relationship between division and multiplication. (Contributed by Mario Carneiro, 30-May-2016.)
theorem lemuldiv2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C crp) $ >
  $ wi ph (wb (wbr (co C A2 cmul) B2 cle) (wbr A2 (co B2 C cdiv) cle)) $;

--| 'Less than' relationship between division and multiplication. (Contributed by Mario Carneiro, 28-May-2016.)
theorem ltdivmuld (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C crp) $ >
  $ wi ph (wb (wbr (co A2 C cdiv) B2 clt) (wbr A2 (co C B2 cmul) clt)) $;

--| 'Less than' relationship between division and multiplication. (Contributed by Mario Carneiro, 28-May-2016.)
theorem ltdivmul2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C crp) $ >
  $ wi ph (wb (wbr (co A2 C cdiv) B2 clt) (wbr A2 (co B2 C cmul) clt)) $;

--| 'Less than or equal to' relationship between division and multiplication. (Contributed by Mario Carneiro, 28-May-2016.)
theorem ledivmuld (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C crp) $ >
  $ wi ph (wb (wbr (co A2 C cdiv) B2 cle) (wbr A2 (co C B2 cmul) cle)) $;

--| 'Less than or equal to' relationship between division and multiplication. (Contributed by Mario Carneiro, 28-May-2016.)
theorem ledivmul2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C crp) $ >
  $ wi ph (wb (wbr (co A2 C cdiv) B2 cle) (wbr A2 (co B2 C cmul) cle)) $;

--| The ratio of nonnegative and positive numbers is nonnegative. (Contributed by Mario Carneiro, 30-May-2016.)
theorem ltmul1dd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C crp) $ >
  $ wi ph (wbr A2 B2 clt) $ >
  $ wi ph (wbr (co A2 C cmul) (co B2 C cmul) clt) $;

--| Multiplication of both sides of 'less than' by a positive number. Theorem I.19 of [Apostol] p. 20. (Contributed by Mario Carneiro, 30-May-2016.)
theorem ltmul2dd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C crp) $ >
  $ wi ph (wbr A2 B2 clt) $ >
  $ wi ph (wbr (co C A2 cmul) (co C B2 cmul) clt) $;

--| Division of both sides of 'less than' by a positive number. (Contributed by Mario Carneiro, 30-May-2016.)
theorem ltdiv1dd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C crp) $ >
  $ wi ph (wbr A2 B2 clt) $ >
  $ wi ph (wbr (co A2 C cdiv) (co B2 C cdiv) clt) $;

--| Division of both sides of a less than or equal to relation by a positive number. (Contributed by Mario Carneiro, 30-May-2016.)
theorem lediv1dd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C crp) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wi ph (wbr (co A2 C cdiv) (co B2 C cdiv) cle) $;

--| Comparison of ratio of two nonnegative numbers. (Contributed by Mario Carneiro, 28-May-2016.)
theorem lediv12ad (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C crp) $ >
  $ wi ph (wcel D cr) $ >
  $ wi ph (wbr cc0 A2 cle) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wi ph (wbr C D cle) $ >
  $ wi ph (wbr (co A2 D cdiv) (co B2 C cdiv) cle) $;

--| If the result of a multiplication is strictly negative, then multiplicands are of different signs. (Contributed by Thierry Arnoux, 19-Sep-2018.)
theorem mul2lt0rlt0 (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr (co A2 B2 cmul) cc0 clt) $ >
  $ wi (wa ph (wbr B2 cc0 clt)) (wbr cc0 A2 clt) $;

--| If the result of a multiplication is strictly negative, then multiplicands are of different signs. (Contributed by Thierry Arnoux, 19-Sep-2018.)
theorem mul2lt0rgt0 (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr (co A2 B2 cmul) cc0 clt) $ >
  $ wi (wa ph (wbr cc0 B2 clt)) (wbr A2 cc0 clt) $;

--| If the result of a multiplication is strictly negative, then multiplicands are of different signs. (Contributed by Thierry Arnoux, 19-Sep-2018.)
theorem mul2lt0llt0 (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr (co A2 B2 cmul) cc0 clt) $ >
  $ wi (wa ph (wbr A2 cc0 clt)) (wbr cc0 B2 clt) $;

--| If the result of a multiplication is strictly negative, then multiplicands are of different signs. (Contributed by Thierry Arnoux, 2-Oct-2018.)
theorem mul2lt0lgt0 (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr (co A2 B2 cmul) cc0 clt) $ >
  $ wi (wa ph (wbr cc0 A2 clt)) (wbr B2 cc0 clt) $;

--| If the result of a multiplication is strictly negative, then multiplicands are of different signs. (Contributed by Thierry Arnoux, 19-Sep-2018.)
theorem mul2lt0bi (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wb (wbr (co A2 B2 cmul) cc0 clt) (wo (wa (wbr A2 cc0 clt) (wbr cc0 B2 clt)) (wa (wbr cc0 A2 clt) (wbr B2 cc0 clt)))) $;

--| Infer that a multiplicand is nonnegative from a positive multiplier and nonnegative product. (Contributed by NM, 2-Jul-2005.) (Revised by Mario Carneiro, 27-May-2016.) (Revised by AV, 9-Jul-2022.)
theorem prodge0rd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr cc0 (co A2 B2 cmul) cle) $ >
  $ wi ph (wbr cc0 B2 cle) $;

--| Infer that a multiplier is nonnegative from a positive multiplicand and nonnegative product. (Contributed by NM, 2-Jul-2005.) (Revised by AV, 9-Jul-2022.)
theorem prodge0ld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wbr cc0 (co A2 B2 cmul) cle) $ >
  $ wi ph (wbr cc0 A2 cle) $;

--| Swap denominator with other side of 'less than'. (Contributed by Mario Carneiro, 28-May-2016.)
theorem ltdiv23d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wcel C crp) $ >
  $ wi ph (wbr (co A2 B2 cdiv) C clt) $ >
  $ wi ph (wbr (co A2 C cdiv) B2 clt) $;

--| Swap denominator with other side of 'less than or equal to'. (Contributed by Mario Carneiro, 28-May-2016.)
theorem lediv23d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wcel C crp) $ >
  $ wi ph (wbr (co A2 B2 cdiv) C cle) $ >
  $ wi ph (wbr (co A2 C cdiv) B2 cle) $;

--| The ratio of nonnegative and positive numbers is nonnegative. (Contributed by Mario Carneiro, 28-May-2016.)
theorem lt2mul2divd (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wcel D crp) $ >
  $ wi ph (wb (wbr (co A2 B2 cmul) (co C D cmul) clt) (wbr (co A2 D cdiv) (co C B2 cdiv) clt)) $;

--| Division of a positive integer by a positive number is less than or equal to the integer iff the number is greater than or equal to 1. (Contributed by AV, 19-Jun-2021.)
theorem nnledivrp (A2 B2: class):
  $ wi (wa (wcel A2 cn) (wcel B2 crp)) (wb (wbr c1 B2 cle) (wbr (co A2 B2 cdiv) A2 cle)) $;

--| Division of a nonnegative integer by a positive integer is less than or equal to the integer. (Contributed by AV, 19-Jun-2021.)
theorem nn0ledivnn (A2 B2: class):
  $ wi (wa (wcel A2 cn0) (wcel B2 cn)) (wbr (co A2 B2 cdiv) A2 cle) $;

--| If the sum of a real number and a positive real number is less than or equal to a third real number, the first real number is less than the third real number. (Contributed by AV, 1-Jul-2021.)
theorem addlelt (A2 M N: class):
  $ wi (w3a (wcel M cr) (wcel N cr) (wcel A2 crp)) (wi (wbr (co M A2 caddc) N cle) (wbr M N clt)) $;

--| Half of an integer greater than 1 is less than or equal to the integer minus 1. (Contributed by AV, 1-Sep-2025.)
theorem ge2halflem1 (N: class):
  $ wi (wcel N (cfv c2 cuz)) (wbr (co N c2 cdiv) (co N c1 cmin) cle) $;

--| Extend class notation to include the negative of an extended real.
term cxne (A2: class): class;

--| Extend class notation to include addition of extended reals.
term cxad: class;

--| Extend class notation to include multiplication of extended reals.
term cxmu: class;

--| Define the negative of an extended real number. (Contributed by FL, 26-Dec-2011.)
axiom df_xneg (A2: class):
  $ wceq (cxne A2) (cif (wceq A2 cpnf) cmnf (cif (wceq A2 cmnf) cpnf (cneg A2))) $;

--| Define addition over extended real numbers. (Contributed by Mario Carneiro, 20-Aug-2015.)
axiom df_xadd {x3 y1: setvar}:
  $ wceq cxad (cmpo x3 y1 cxr cxr (cif (wceq (cv x3) cpnf) (cif (wceq (cv y1) cmnf) cc0 cpnf) (cif (wceq (cv x3) cmnf) (cif (wceq (cv y1) cpnf) cc0 cmnf) (cif (wceq (cv y1) cpnf) cpnf (cif (wceq (cv y1) cmnf) cmnf (co (cv x3) (cv y1) caddc)))))) $;

--| Define multiplication over extended real numbers. (Contributed by Mario Carneiro, 20-Aug-2015.)
axiom df_xmul {x3 y1: setvar}:
  $ wceq cxmu (cmpo x3 y1 cxr cxr (cif (wo (wceq (cv x3) cc0) (wceq (cv y1) cc0)) cc0 (cif (wo (wo (wa (wbr cc0 (cv y1) clt) (wceq (cv x3) cpnf)) (wa (wbr (cv y1) cc0 clt) (wceq (cv x3) cmnf))) (wo (wa (wbr cc0 (cv x3) clt) (wceq (cv y1) cpnf)) (wa (wbr (cv x3) cc0 clt) (wceq (cv y1) cmnf)))) cpnf (cif (wo (wo (wa (wbr cc0 (cv y1) clt) (wceq (cv x3) cmnf)) (wa (wbr (cv y1) cc0 clt) (wceq (cv x3) cpnf))) (wo (wa (wbr cc0 (cv x3) clt) (wceq (cv y1) cmnf)) (wa (wbr (cv x3) cc0 clt) (wceq (cv y1) cpnf)))) cmnf (co (cv x3) (cv y1) cmul))))) $;

--| The 'less than' binary relation on the set of extended reals. Definition 12-3.1 of [Gleason] p. 173. (Contributed by NM, 14-Oct-2005.)
theorem ltxr (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wb (wbr A2 B2 clt) (wo (wo (wa (wa (wcel A2 cr) (wcel B2 cr)) (wbr A2 B2 cltrr)) (wa (wceq A2 cmnf) (wceq B2 cpnf))) (wo (wa (wcel A2 cr) (wceq B2 cpnf)) (wa (wceq A2 cmnf) (wcel B2 cr))))) $;

--| Membership in the set of extended reals. (Contributed by NM, 14-Oct-2005.)
theorem elxr (A2: class):
  $ wb (wcel A2 cxr) (w3o (wcel A2 cr) (wceq A2 cpnf) (wceq A2 cmnf)) $;

--| An extended real other than minus infinity is real or positive infinite. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xrnemnf (A2: class):
  $ wb (wa (wcel A2 cxr) (wne A2 cmnf)) (wo (wcel A2 cr) (wceq A2 cpnf)) $;

--| An extended real other than plus infinity is real or negative infinite. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xrnepnf (A2: class):
  $ wb (wa (wcel A2 cxr) (wne A2 cpnf)) (wo (wcel A2 cr) (wceq A2 cmnf)) $;

--| The extended real 'less than' is irreflexive. (Contributed by NM, 14-Oct-2005.)
theorem xrltnr (A2: class):
  $ wi (wcel A2 cxr) (wn (wbr A2 A2 clt)) $;

--| Any (finite) real is less than plus infinity. (Contributed by NM, 14-Oct-2005.)
theorem ltpnf (A2: class):
  $ wi (wcel A2 cr) (wbr A2 cpnf clt) $;

--| Any (finite) real is less than plus infinity. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem ltpnfd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wbr A2 cpnf clt) $;

--| Zero is less than plus infinity. (Contributed by David A. Wheeler, 8-Dec-2018.)
theorem _0ltpnf:
  $ wbr cc0 cpnf clt $;

--| Minus infinity is less than any (finite) real. (Contributed by NM, 14-Oct-2005.)
theorem mnflt (A2: class):
  $ wi (wcel A2 cr) (wbr cmnf A2 clt) $;

--| Minus infinity is less than any (finite) real. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem mnfltd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wbr cmnf A2 clt) $;

--| Minus infinity is less than 0. (Contributed by David A. Wheeler, 8-Dec-2018.)
theorem mnflt0:
  $ wbr cmnf cc0 clt $;

--| Minus infinity is less than plus infinity. (Contributed by NM, 14-Oct-2005.)
theorem mnfltpnf:
  $ wbr cmnf cpnf clt $;

--| Minus infinity is less than an extended real that is either real or plus infinity. (Contributed by NM, 2-Feb-2006.)
theorem mnfltxr (A2: class):
  $ wi (wo (wcel A2 cr) (wceq A2 cpnf)) (wbr cmnf A2 clt) $;

--| No extended real is greater than plus infinity. (Contributed by NM, 15-Oct-2005.)
theorem pnfnlt (A2: class):
  $ wi (wcel A2 cxr) (wn (wbr cpnf A2 clt)) $;

--| No extended real is less than minus infinity. (Contributed by NM, 15-Oct-2005.)
theorem nltmnf (A2: class):
  $ wi (wcel A2 cxr) (wn (wbr A2 cmnf clt)) $;

--| Plus infinity is an upper bound for extended reals. (Contributed by NM, 30-Jan-2006.)
theorem pnfge (A2: class):
  $ wi (wcel A2 cxr) (wbr A2 cpnf cle) $;

--| Plus infinity is an upper bound for extended reals. (Contributed by Glauco Siliprandi, 5-Feb-2022.)
theorem pnfged (ph: wff) (A2: class):
  $ wi ph (wcel A2 cxr) $ >
  $ wi ph (wbr A2 cpnf cle) $;

--| An extended nonnegative integer is neither 0 nor 1 if and only if it is greater than or equal to 2. (Contributed by AV, 5-Apr-2021.)
theorem xnn0n0n1ge2b (N: class):
  $ wi (wcel N cxnn0) (wb (wa (wne N cc0) (wne N c1)) (wbr c2 N cle)) $;

--| 0 less than or equal to positive infinity. (Contributed by David A. Wheeler, 8-Dec-2018.)
theorem _0lepnf:
  $ wbr cc0 cpnf cle $;

--| An extended nonnegative integer is greater than or equal to 0. (Contributed by Alexander van der Vekens, 6-Jan-2018.) (Revised by AV, 10-Dec-2020.)
theorem xnn0ge0 (N: class):
  $ wi (wcel N cxnn0) (wbr cc0 N cle) $;

--| Minus infinity is less than or equal to any extended real. (Contributed by NM, 19-Jan-2006.)
theorem mnfle (A2: class):
  $ wi (wcel A2 cxr) (wbr cmnf A2 cle) $;

--| Minus infinity is less than or equal to any extended real. (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem mnfled (ph: wff) (A2: class):
  $ wi ph (wcel A2 cxr) $ >
  $ wi ph (wbr cmnf A2 cle) $;

--| Ordering on the extended reals is not symmetric. (Contributed by NM, 15-Oct-2005.)
theorem xrltnsym (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wi (wbr A2 B2 clt) (wn (wbr B2 A2 clt))) $;

--| 'Less than' is antisymmetric and irreflexive for extended reals. (Contributed by NM, 6-Feb-2007.)
theorem xrltnsym2 (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wn (wa (wbr A2 B2 clt) (wbr B2 A2 clt))) $;

--| Ordering on the extended reals satisfies strict trichotomy. New proofs should generally use this instead of ~ ax-pre-lttri or ~ axlttri . (Contributed by NM, 14-Oct-2005.)
theorem xrlttri (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wb (wbr A2 B2 clt) (wn (wo (wceq A2 B2) (wbr B2 A2 clt)))) $;

--| Ordering on the extended reals is transitive. (Contributed by NM, 15-Oct-2005.)
theorem xrlttr (A2 B2 C: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cxr)) (wi (wa (wbr A2 B2 clt) (wbr B2 C clt)) (wbr A2 C clt)) $;

--| 'Less than' is a strict ordering on the extended reals. (Contributed by NM, 15-Oct-2005.)
theorem xrltso:
  $ wor cxr clt $;

--| Trichotomy law for 'less than' for extended reals. (Contributed by NM, 10-Dec-2007.)
theorem xrlttri2 (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wb (wne A2 B2) (wo (wbr A2 B2 clt) (wbr B2 A2 clt))) $;

--| Trichotomy law for 'less than' for extended reals. (Contributed by NM, 9-Feb-2006.)
theorem xrlttri3 (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wb (wceq A2 B2) (wa (wn (wbr A2 B2 clt)) (wn (wbr B2 A2 clt)))) $;

--| 'Less than or equal' expressed in terms of 'less than' or 'equals', for extended reals. (Contributed by NM, 19-Jan-2006.)
theorem xrleloe (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wb (wbr A2 B2 cle) (wo (wbr A2 B2 clt) (wceq A2 B2))) $;

--| 'Less than or equal to' implies 'less than' is not 'equals', for extended reals. (Contributed by NM, 9-Feb-2006.)
theorem xrleltne (A2 B2: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wbr A2 B2 cle)) (wb (wbr A2 B2 clt) (wne B2 A2)) $;

--| 'Less than' expressed in terms of 'less than or equal to'. (Contributed by Mario Carneiro, 6-Nov-2015.)
theorem xrltlen (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wb (wbr A2 B2 clt) (wa (wbr A2 B2 cle) (wne B2 A2))) $;

--| Alternative definition of 'less than or equal to' in terms of 'less than'. (Contributed by Mario Carneiro, 6-Nov-2015.)
theorem dfle2:
  $ wceq cle (cun clt (cres cid cxr)) $;

--| Alternative definition of 'less than' in terms of 'less than or equal to'. (Contributed by Mario Carneiro, 6-Nov-2015.)
theorem dflt2:
  $ wceq clt (cdif cle cid) $;

--| 'Less than' implies 'less than or equal' for extended reals. (Contributed by NM, 19-Jan-2006.)
theorem xrltle (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wi (wbr A2 B2 clt) (wbr A2 B2 cle)) $;

--| 'Less than' implies 'less than or equal to' for extended reals. Deduction form of ~ xrltle . (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem xrltled (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cxr) $ >
  $ wi ph (wcel B2 cxr) $ >
  $ wi ph (wbr A2 B2 clt) $ >
  $ wi ph (wbr A2 B2 cle) $;

--| 'Less than or equal to' is reflexive for extended reals. (Contributed by NM, 7-Feb-2007.)
theorem xrleid (A2: class):
  $ wi (wcel A2 cxr) (wbr A2 A2 cle) $;

--| 'Less than or equal to' is reflexive for extended reals. Deduction form of ~ xrleid . (Contributed by Glauco Siliprandi, 26-Jun-2021.)
theorem xrleidd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cxr) $ >
  $ wi ph (wbr A2 A2 cle) $;

--| Trichotomy law for extended reals. (Contributed by NM, 7-Feb-2007.)
theorem xrletri (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wo (wbr A2 B2 cle) (wbr B2 A2 cle)) $;

--| Trichotomy law for extended reals. (Contributed by FL, 2-Aug-2009.)
theorem xrletri3 (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wb (wceq A2 B2) (wa (wbr A2 B2 cle) (wbr B2 A2 cle))) $;

--| Trichotomy law for extended reals. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem xrletrid (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cxr) $ >
  $ wi ph (wcel B2 cxr) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wi ph (wbr B2 A2 cle) $ >
  $ wi ph (wceq A2 B2) $;

--| Transitive law for ordering on extended reals. (Contributed by NM, 19-Jan-2006.)
theorem xrlelttr (A2 B2 C: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cxr)) (wi (wa (wbr A2 B2 cle) (wbr B2 C clt)) (wbr A2 C clt)) $;

--| Transitive law for ordering on extended reals. (Contributed by NM, 19-Jan-2006.)
theorem xrltletr (A2 B2 C: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cxr)) (wi (wa (wbr A2 B2 clt) (wbr B2 C cle)) (wbr A2 C clt)) $;

--| Transitive law for ordering on extended reals. (Contributed by NM, 9-Feb-2006.)
theorem xrletr (A2 B2 C: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cxr)) (wi (wa (wbr A2 B2 cle) (wbr B2 C cle)) (wbr A2 C cle)) $;

--| Transitive law for ordering on extended reals. (Contributed by Mario Carneiro, 23-Aug-2015.)
theorem xrlttrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cxr) $ >
  $ wi ph (wcel B2 cxr) $ >
  $ wi ph (wcel C cxr) $ >
  $ wi ph (wbr A2 B2 clt) $ >
  $ wi ph (wbr B2 C clt) $ >
  $ wi ph (wbr A2 C clt) $;

--| Transitive law for ordering on extended reals. (Contributed by Mario Carneiro, 23-Aug-2015.)
theorem xrlelttrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cxr) $ >
  $ wi ph (wcel B2 cxr) $ >
  $ wi ph (wcel C cxr) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wi ph (wbr B2 C clt) $ >
  $ wi ph (wbr A2 C clt) $;

--| Transitive law for ordering on extended reals. (Contributed by Mario Carneiro, 23-Aug-2015.)
theorem xrltletrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cxr) $ >
  $ wi ph (wcel B2 cxr) $ >
  $ wi ph (wcel C cxr) $ >
  $ wi ph (wbr A2 B2 clt) $ >
  $ wi ph (wbr B2 C cle) $ >
  $ wi ph (wbr A2 C clt) $;

--| Transitive law for ordering on extended reals. (Contributed by Mario Carneiro, 23-Aug-2015.)
theorem xrletrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cxr) $ >
  $ wi ph (wcel B2 cxr) $ >
  $ wi ph (wcel C cxr) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wi ph (wbr B2 C cle) $ >
  $ wi ph (wbr A2 C cle) $;

--| 'Less than' implies not equal for extended reals. (Contributed by NM, 20-Jan-2006.)
theorem xrltne (A2 B2: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wbr A2 B2 clt)) (wne B2 A2) $;

--| 'Greater than' implies not equal. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem xrgtned (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cxr) $ >
  $ wi ph (wcel B2 cxr) $ >
  $ wi ph (wbr A2 B2 clt) $ >
  $ wi ph (wne B2 A2) $;

--| An extended real is not less than plus infinity iff they are equal. (Contributed by NM, 30-Jan-2006.)
theorem nltpnft (A2: class):
  $ wi (wcel A2 cxr) (wb (wceq A2 cpnf) (wn (wbr A2 cpnf clt))) $;

--| An extended real which is greater than plus infinity is plus infinity. (Contributed by Thierry Arnoux, 18-Dec-2016.)
theorem xgepnf (A2: class):
  $ wi (wcel A2 cxr) (wb (wbr cpnf A2 cle) (wceq A2 cpnf)) $;

--| An extended real is not greater than minus infinity iff they are equal. (Contributed by NM, 2-Feb-2006.)
theorem ngtmnft (A2: class):
  $ wi (wcel A2 cxr) (wb (wceq A2 cmnf) (wn (wbr cmnf A2 clt))) $;

--| An extended real which is less than minus infinity is minus infinity. (Contributed by Thierry Arnoux, 18-Feb-2018.)
theorem xlemnf (A2: class):
  $ wi (wcel A2 cxr) (wb (wbr A2 cmnf cle) (wceq A2 cmnf)) $;

--| An extended real is real iff it is strictly bounded by infinities. (Contributed by NM, 2-Feb-2006.)
theorem xrrebnd (A2: class):
  $ wi (wcel A2 cxr) (wb (wcel A2 cr) (wa (wbr cmnf A2 clt) (wbr A2 cpnf clt))) $;

--| A way of proving that an extended real is real. (Contributed by NM, 9-Mar-2006.)
theorem xrre (A2 B2: class):
  $ wi (wa (wa (wcel A2 cxr) (wcel B2 cr)) (wa (wbr cmnf A2 clt) (wbr A2 B2 cle))) (wcel A2 cr) $;

--| An extended real between two others is real. (Contributed by NM, 6-Feb-2007.)
theorem xrre2 (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cxr)) (wa (wbr A2 B2 clt) (wbr B2 C clt))) (wcel B2 cr) $;

--| A way of proving that an extended real is real. (Contributed by FL, 29-May-2014.)
theorem xrre3 (A2 B2: class):
  $ wi (wa (wa (wcel A2 cxr) (wcel B2 cr)) (wa (wbr B2 A2 cle) (wbr A2 cpnf clt))) (wcel A2 cr) $;

--| A nonnegative extended real is greater than negative infinity. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem ge0gtmnf (A2: class):
  $ wi (wa (wcel A2 cxr) (wbr cc0 A2 cle)) (wbr cmnf A2 clt) $;

--| A nonnegative extended real is greater than negative infinity. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem ge0nemnf (A2: class):
  $ wi (wa (wcel A2 cxr) (wbr cc0 A2 cle)) (wne A2 cmnf) $;

--| A nonnegative extended real that is less than a real bound is real. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xrrege0 (A2 B2: class):
  $ wi (wa (wa (wcel A2 cxr) (wcel B2 cr)) (wa (wbr cc0 A2 cle) (wbr A2 B2 cle))) (wcel A2 cr) $;

--| An extended real is less than or equal to the maximum of it and another. (Contributed by NM, 7-Feb-2007.)
theorem xrmax1 (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wbr A2 (cif (wbr A2 B2 cle) B2 A2) cle) $;

--| An extended real is less than or equal to the maximum of it and another. (Contributed by NM, 7-Feb-2007.)
theorem xrmax2 (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wbr B2 (cif (wbr A2 B2 cle) B2 A2) cle) $;

--| The minimum of two extended reals is less than or equal to one of them. (Contributed by NM, 7-Feb-2007.)
theorem xrmin1 (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wbr (cif (wbr A2 B2 cle) A2 B2) A2 cle) $;

--| The minimum of two extended reals is less than or equal to one of them. (Contributed by NM, 7-Feb-2007.)
theorem xrmin2 (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wbr (cif (wbr A2 B2 cle) A2 B2) B2 cle) $;

--| The maximum of two extended reals is equal to the first if the first is bigger. (Contributed by Mario Carneiro, 25-Mar-2015.)
theorem xrmaxeq (A2 B2: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wbr B2 A2 cle)) (wceq (cif (wbr A2 B2 cle) B2 A2) A2) $;

--| The minimum of two extended reals is equal to the second if the first is bigger. (Contributed by Mario Carneiro, 25-Mar-2015.)
theorem xrmineq (A2 B2: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wbr B2 A2 cle)) (wceq (cif (wbr A2 B2 cle) A2 B2) B2) $;

--| Two ways of saying the maximum of two extended reals is less than a third. (Contributed by NM, 7-Feb-2007.)
theorem xrmaxlt (A2 B2 C: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cxr)) (wb (wbr (cif (wbr A2 B2 cle) B2 A2) C clt) (wa (wbr A2 C clt) (wbr B2 C clt))) $;

--| Two ways of saying an extended real is less than the minimum of two others. (Contributed by NM, 7-Feb-2007.)
theorem xrltmin (A2 B2 C: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cxr)) (wb (wbr A2 (cif (wbr B2 C cle) B2 C) clt) (wa (wbr A2 B2 clt) (wbr A2 C clt))) $;

--| Two ways of saying the maximum of two numbers is less than or equal to a third. (Contributed by Mario Carneiro, 18-Jun-2014.)
theorem xrmaxle (A2 B2 C: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cxr)) (wb (wbr (cif (wbr A2 B2 cle) B2 A2) C cle) (wa (wbr A2 C cle) (wbr B2 C cle))) $;

--| Two ways of saying a number is less than or equal to the minimum of two others. (Contributed by Mario Carneiro, 18-Jun-2014.)
theorem xrlemin (A2 B2 C: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cxr)) (wb (wbr A2 (cif (wbr B2 C cle) B2 C) cle) (wa (wbr A2 B2 cle) (wbr A2 C cle))) $;

--| A number is less than or equal to the maximum of it and another. See also ~ max1ALT . (Contributed by NM, 3-Apr-2005.)
theorem max1 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wbr A2 (cif (wbr A2 B2 cle) B2 A2) cle) $;

--| A number is less than or equal to the maximum of it and another. This version of ~ max1 omits the ` B e. RR ` antecedent. Although it doesn't exploit undefined behavior, it is still considered poor style, and the use of ~ max1 is preferred. (Proof modification is discouraged.) (New usage is discouraged.) (Contributed by NM, 3-Apr-2005.)
theorem max1ALT (A2 B2: class):
  $ wi (wcel A2 cr) (wbr A2 (cif (wbr A2 B2 cle) B2 A2) cle) $;

--| A number is less than or equal to the maximum of it and another. (Contributed by NM, 3-Apr-2005.)
theorem max2 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wbr B2 (cif (wbr A2 B2 cle) B2 A2) cle) $;

--| The supremum of two real numbers is the maximum of these two numbers. (Contributed by AV, 8-Jun-2021.)
theorem _2resupmax (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wceq (csup (cpr A2 B2) cr clt) (cif (wbr A2 B2 cle) B2 A2)) $;

--| The minimum of two numbers is less than or equal to the first. (Contributed by NM, 3-Aug-2007.)
theorem min1 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wbr (cif (wbr A2 B2 cle) A2 B2) A2 cle) $;

--| The minimum of two numbers is less than or equal to the second. (Contributed by NM, 3-Aug-2007.)
theorem min2 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wbr (cif (wbr A2 B2 cle) A2 B2) B2 cle) $;

--| Two ways of saying the maximum of two numbers is less than or equal to a third. (Contributed by NM, 29-Sep-2005.)
theorem maxle (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wb (wbr (cif (wbr A2 B2 cle) B2 A2) C cle) (wa (wbr A2 C cle) (wbr B2 C cle))) $;

--| Two ways of saying a number is less than or equal to the minimum of two others. (Contributed by NM, 3-Aug-2007.)
theorem lemin (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wb (wbr A2 (cif (wbr B2 C cle) B2 C) cle) (wa (wbr A2 B2 cle) (wbr A2 C cle))) $;

--| Two ways of saying the maximum of two numbers is less than a third. (Contributed by NM, 3-Aug-2007.)
theorem maxlt (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wb (wbr (cif (wbr A2 B2 cle) B2 A2) C clt) (wa (wbr A2 C clt) (wbr B2 C clt))) $;

--| Two ways of saying a number is less than the minimum of two others. (Contributed by NM, 1-Sep-2006.)
theorem ltmin (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wb (wbr A2 (cif (wbr B2 C cle) B2 C) clt) (wa (wbr A2 B2 clt) (wbr A2 C clt))) $;

--| A real number which is less than or equal to a second real number is less than or equal to the maximum/supremum of the second real number and a third real number. (Contributed by AV, 8-Jun-2021.)
theorem lemaxle (A2 B2 C: class):
  $ wi (w3a (wa (wcel B2 cr) (wcel C cr)) (wcel A2 cr) (wbr A2 B2 cle)) (wbr A2 (cif (wbr C B2 cle) B2 C) cle) $;

--| Decompose a real number into positive and negative parts. (Contributed by Mario Carneiro, 6-Aug-2014.)
theorem max0sub (A2: class):
  $ wi (wcel A2 cr) (wceq (co (cif (wbr cc0 A2 cle) A2 cc0) (cif (wbr cc0 (cneg A2) cle) (cneg A2) cc0) cmin) A2) $;

--| An if statement transforms an implication into an inequality of terms. (Contributed by Mario Carneiro, 31-Aug-2014.)
theorem ifle (ph ps: wff) (A2 B2: class):
  $ wi (wa (w3a (wcel A2 cr) (wcel B2 cr) (wbr B2 A2 cle)) (wi ph ps)) (wbr (cif ph A2 B2) (cif ps A2 B2) cle) $;

--| There exists an integer greater than or equal to any two others. (Contributed by NM, 28-Aug-2005.)
theorem z2ge {k: setvar} (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wrex k (wa (wbr M (cv k) cle) (wbr N (cv k) cle)) cz) $;

--| The rational numbers are dense in ` RR ` : any two real numbers have a rational between them. Exercise 6 of [Apostol] p. 28. (Contributed by NM, 18-Nov-2004.) (Proof shortened by Mario Carneiro, 13-Jun-2014.)
theorem qbtwnre {x3: setvar} (A2 B2: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wbr A2 B2 clt)) (wrex x3 (wa (wbr A2 (cv x3) clt) (wbr (cv x3) B2 clt)) cq) $;

--| The rational numbers are dense in ` RR* ` : any two extended real numbers have a rational between them. (Contributed by NM, 6-Feb-2007.) (Proof shortened by Mario Carneiro, 23-Aug-2015.)
theorem qbtwnxr {x3: setvar} (A2 B2: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wbr A2 B2 clt)) (wrex x3 (wa (wbr A2 (cv x3) clt) (wbr (cv x3) B2 clt)) cq) $;

--| If a nonnegative real is less than any positive rational, it is zero. (Contributed by NM, 6-Feb-2007.)
theorem qsqueeze {x3: setvar} (A2: class):
  $ wi (w3a (wcel A2 cr) (wbr cc0 A2 cle) (wral x3 (wi (wbr cc0 (cv x3) clt) (wbr A2 (cv x3) clt)) cq)) (wceq A2 cc0) $;

--| Lemma for ~ qextlt and qextle . (Contributed by Mario Carneiro, 3-Oct-2014.)
theorem qextltlem {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wi (wbr A2 B2 clt) (wrex x3 (wa (wn (wb (wbr (cv x3) A2 clt) (wbr (cv x3) B2 clt))) (wn (wb (wbr (cv x3) A2 cle) (wbr (cv x3) B2 cle)))) cq)) $;

--| An extensionality-like property for extended real ordering. (Contributed by Mario Carneiro, 3-Oct-2014.)
theorem qextlt {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wb (wceq A2 B2) (wral x3 (wb (wbr (cv x3) A2 clt) (wbr (cv x3) B2 clt)) cq)) $;

--| An extensionality-like property for extended real ordering. (Contributed by Mario Carneiro, 3-Oct-2014.)
theorem qextle {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wb (wceq A2 B2) (wral x3 (wb (wbr (cv x3) A2 cle) (wbr (cv x3) B2 cle)) cq)) $;

--| Show that ` A ` is less than ` B ` by showing that there is no positive bound on the difference. (Contributed by Mario Carneiro, 12-Jun-2014.)
theorem xralrple {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cr)) (wb (wbr A2 B2 cle) (wral x3 (wbr A2 (co B2 (cv x3) caddc) cle) crp)) $;

--| Show that ` A ` is less than ` B ` by showing that there is no positive bound on the difference. (Contributed by Mario Carneiro, 12-Jun-2014.)
theorem alrple {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wb (wbr A2 B2 cle) (wral x3 (wbr A2 (co B2 (cv x3) caddc) cle) crp)) $;

--| Equality of two extended numbers with ` -e ` in front of them. (Contributed by FL, 26-Dec-2011.) (Proof shortened by Mario Carneiro, 20-Aug-2015.)
theorem xnegeq (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (cxne A2) (cxne B2)) $;

--| A negative extended real exists as a set. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xnegex (A2: class):
  $ wcel (cxne A2) cvv $;

--| Minus ` +oo ` . Remark of [BourbakiTop1] p. IV.15. (Contributed by FL, 26-Dec-2011.)
theorem xnegpnf:
  $ wceq (cxne cpnf) cmnf $;

--| Minus ` -oo ` . Remark of [BourbakiTop1] p. IV.15. (Contributed by FL, 26-Dec-2011.) (Revised by Mario Carneiro, 20-Aug-2015.)
theorem xnegmnf:
  $ wceq (cxne cmnf) cpnf $;

--| Minus a real number. Remark [BourbakiTop1] p. IV.15. (Contributed by FL, 26-Dec-2011.) (Proof shortened by Mario Carneiro, 20-Aug-2015.)
theorem rexneg (A2: class):
  $ wi (wcel A2 cr) (wceq (cxne A2) (cneg A2)) $;

--| The negative of zero. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xneg0:
  $ wceq (cxne cc0) cc0 $;

--| Closure of extended real negative. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xnegcl (A2: class):
  $ wi (wcel A2 cxr) (wcel (cxne A2) cxr) $;

--| Extended real version of ~ negneg . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xnegneg (A2: class):
  $ wi (wcel A2 cxr) (wceq (cxne (cxne A2)) A2) $;

--| Extended real version of ~ neg11 . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xneg11 (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wb (wceq (cxne A2) (cxne B2)) (wceq A2 B2)) $;

--| Forward direction of ~ xltneg . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xltnegi (A2 B2: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wbr A2 B2 clt)) (wbr (cxne B2) (cxne A2) clt) $;

--| Extended real version of ~ ltneg . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xltneg (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wb (wbr A2 B2 clt) (wbr (cxne B2) (cxne A2) clt)) $;

--| Extended real version of ~ leneg . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xleneg (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wb (wbr A2 B2 cle) (wbr (cxne B2) (cxne A2) cle)) $;

--| Extended real version of ~ lt0neg1 . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xlt0neg1 (A2: class):
  $ wi (wcel A2 cxr) (wb (wbr A2 cc0 clt) (wbr cc0 (cxne A2) clt)) $;

--| Extended real version of ~ lt0neg2 . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xlt0neg2 (A2: class):
  $ wi (wcel A2 cxr) (wb (wbr cc0 A2 clt) (wbr (cxne A2) cc0 clt)) $;

--| Extended real version of ~ le0neg1 . (Contributed by Mario Carneiro, 9-Sep-2015.)
theorem xle0neg1 (A2: class):
  $ wi (wcel A2 cxr) (wb (wbr A2 cc0 cle) (wbr cc0 (cxne A2) cle)) $;

--| Extended real version of ~ le0neg2 . (Contributed by Mario Carneiro, 9-Sep-2015.)
theorem xle0neg2 (A2: class):
  $ wi (wcel A2 cxr) (wb (wbr cc0 A2 cle) (wbr (cxne A2) cc0 cle)) $;

--| Value of the extended real addition operation. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xaddval (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wceq (co A2 B2 cxad) (cif (wceq A2 cpnf) (cif (wceq B2 cmnf) cc0 cpnf) (cif (wceq A2 cmnf) (cif (wceq B2 cpnf) cc0 cmnf) (cif (wceq B2 cpnf) cpnf (cif (wceq B2 cmnf) cmnf (co A2 B2 caddc)))))) $;

--| The extended real addition operation is closed in extended reals. (Contributed by Mario Carneiro, 21-Aug-2015.)
theorem xaddf:
  $ wf (cxp cxr cxr) cxr cxad $;

--| Value of the extended real multiplication operation. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xmulval (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wceq (co A2 B2 cxmu) (cif (wo (wceq A2 cc0) (wceq B2 cc0)) cc0 (cif (wo (wo (wa (wbr cc0 B2 clt) (wceq A2 cpnf)) (wa (wbr B2 cc0 clt) (wceq A2 cmnf))) (wo (wa (wbr cc0 A2 clt) (wceq B2 cpnf)) (wa (wbr A2 cc0 clt) (wceq B2 cmnf)))) cpnf (cif (wo (wo (wa (wbr cc0 B2 clt) (wceq A2 cmnf)) (wa (wbr B2 cc0 clt) (wceq A2 cpnf))) (wo (wa (wbr cc0 A2 clt) (wceq B2 cmnf)) (wa (wbr A2 cc0 clt) (wceq B2 cpnf)))) cmnf (co A2 B2 cmul))))) $;

--| Addition of positive infinity on the right. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xaddpnf1 (A2: class):
  $ wi (wa (wcel A2 cxr) (wne A2 cmnf)) (wceq (co A2 cpnf cxad) cpnf) $;

--| Addition of positive infinity on the left. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xaddpnf2 (A2: class):
  $ wi (wa (wcel A2 cxr) (wne A2 cmnf)) (wceq (co cpnf A2 cxad) cpnf) $;

--| Addition of negative infinity on the right. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xaddmnf1 (A2: class):
  $ wi (wa (wcel A2 cxr) (wne A2 cpnf)) (wceq (co A2 cmnf cxad) cmnf) $;

--| Addition of negative infinity on the left. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xaddmnf2 (A2: class):
  $ wi (wa (wcel A2 cxr) (wne A2 cpnf)) (wceq (co cmnf A2 cxad) cmnf) $;

--| Addition of positive and negative infinity. This is often taken to be a "null" value or out of the domain, but we define it (somewhat arbitrarily) to be zero so that the resulting function is total, which simplifies proofs. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem pnfaddmnf:
  $ wceq (co cpnf cmnf cxad) cc0 $;

--| Addition of negative and positive infinity. This is often taken to be a "null" value or out of the domain, but we define it (somewhat arbitrarily) to be zero so that the resulting function is total, which simplifies proofs. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem mnfaddpnf:
  $ wceq (co cmnf cpnf cxad) cc0 $;

--| The extended real addition operation when both arguments are real. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem rexadd (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wceq (co A2 B2 cxad) (co A2 B2 caddc)) $;

--| Extended real subtraction when both arguments are real. (Contributed by Mario Carneiro, 23-Aug-2015.)
theorem rexsub (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wceq (co A2 (cxne B2) cxad) (co A2 B2 cmin)) $;

--| The extended real addition operation when both arguments are real. Deduction version of ~ rexadd . (Contributed by Glauco Siliprandi, 24-Dec-2020.)
theorem rexaddd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wceq (co A2 B2 cxad) (co A2 B2 caddc)) $;

--| The extended nonnegative integers are closed under extended addition. (Contributed by AV, 10-Dec-2020.)
theorem xnn0xaddcl (A2 B2: class):
  $ wi (wa (wcel A2 cxnn0) (wcel B2 cxnn0)) (wcel (co A2 B2 cxad) cxnn0) $;

--| Closure of extended real addition in the subset ` RR* / { -oo } ` . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xaddnemnf (A2 B2: class):
  $ wi (wa (wa (wcel A2 cxr) (wne A2 cmnf)) (wa (wcel B2 cxr) (wne B2 cmnf))) (wne (co A2 B2 cxad) cmnf) $;

--| Closure of extended real addition in the subset ` RR* / { +oo } ` . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xaddnepnf (A2 B2: class):
  $ wi (wa (wa (wcel A2 cxr) (wne A2 cpnf)) (wa (wcel B2 cxr) (wne B2 cpnf))) (wne (co A2 B2 cxad) cpnf) $;

--| Extended real version of ~ negid . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xnegid (A2: class):
  $ wi (wcel A2 cxr) (wceq (co A2 (cxne A2) cxad) cc0) $;

--| The extended real addition operation is closed in extended reals. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xaddcl (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wcel (co A2 B2 cxad) cxr) $;

--| The extended real addition operation is commutative. (Contributed by NM, 26-Dec-2011.)
theorem xaddcom (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wceq (co A2 B2 cxad) (co B2 A2 cxad)) $;

--| Extended real version of ~ addrid . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xaddrid (A2: class):
  $ wi (wcel A2 cxr) (wceq (co A2 cc0 cxad) A2) $;

--| Extended real version of ~ addlid . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xaddlid (A2: class):
  $ wi (wcel A2 cxr) (wceq (co cc0 A2 cxad) A2) $;

--| ` 0 ` is a right identity for extended real addition. (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem xaddridd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cxr) $ >
  $ wi ph (wceq (co A2 cc0 cxad) A2) $;

--| Extended nonnegative integer ordering relation. (Contributed by Thierry Arnoux, 30-Jul-2023.)
theorem xnn0lem1lt (M N: class):
  $ wi (wa (wcel M cn0) (wcel N cxnn0)) (wb (wbr M N cle) (wbr (co M c1 cmin) N clt)) $;

--| An extended nonnegative integer which is less than or equal to a nonnegative integer is a nonnegative integer. (Contributed by AV, 24-Nov-2021.)
theorem xnn0lenn0nn0 (M N: class):
  $ wi (w3a (wcel M cxnn0) (wcel N cn0) (wbr M N cle)) (wcel M cn0) $;

--| An extended nonnegative integer which is less than or equal to 2 is either 0 or 1 or 2. (Contributed by AV, 24-Nov-2021.)
theorem xnn0le2is012 (N: class):
  $ wi (wa (wcel N cxnn0) (wbr N c2 cle)) (w3o (wceq N cc0) (wceq N c1) (wceq N c2)) $;

--| The sum of two extended nonnegative integers is ` 0 ` iff each of the two extended nonnegative integers is ` 0 ` . (Contributed by AV, 14-Dec-2020.)
theorem xnn0xadd0 (A2 B2: class):
  $ wi (wa (wcel A2 cxnn0) (wcel B2 cxnn0)) (wb (wceq (co A2 B2 cxad) cc0) (wa (wceq A2 cc0) (wceq B2 cc0))) $;

--| Extended real version of ~ negdi . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xnegdi (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wceq (cxne (co A2 B2 cxad)) (co (cxne A2) (cxne B2) cxad)) $;

--| Associativity of extended real addition. The correct condition here is "it is not the case that both ` +oo ` and ` -oo ` appear as one of ` A , B , C ` , i.e. ` -. { +oo , -oo } C_ { A , B , C } ` ", but this condition is difficult to work with, so we break the theorem into two parts: this one, where ` -oo ` is not present in ` A , B , C ` , and ~ xaddass2 , where ` +oo ` is not present. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xaddass (A2 B2 C: class):
  $ wi (w3a (wa (wcel A2 cxr) (wne A2 cmnf)) (wa (wcel B2 cxr) (wne B2 cmnf)) (wa (wcel C cxr) (wne C cmnf))) (wceq (co (co A2 B2 cxad) C cxad) (co A2 (co B2 C cxad) cxad)) $;

--| Associativity of extended real addition. See ~ xaddass for notes on the hypotheses. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xaddass2 (A2 B2 C: class):
  $ wi (w3a (wa (wcel A2 cxr) (wne A2 cpnf)) (wa (wcel B2 cxr) (wne B2 cpnf)) (wa (wcel C cxr) (wne C cpnf))) (wceq (co (co A2 B2 cxad) C cxad) (co A2 (co B2 C cxad) cxad)) $;

--| Extended real version of ~ pncan . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xpncan (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cr)) (wceq (co (co A2 B2 cxad) (cxne B2) cxad) A2) $;

--| Extended real version of ~ npcan . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xnpcan (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cr)) (wceq (co (co A2 (cxne B2) cxad) B2 cxad) A2) $;

--| Extended real version of ~ leadd1 ; note that the converse implication is not true, unlike the real version (for example ` 0 < 1 ` but ` ( 1 +e +oo ) <_ ( 0 +e +oo ) ` ). (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xleadd1a (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cxr)) (wbr A2 B2 cle)) (wbr (co A2 C cxad) (co B2 C cxad) cle) $;

--| Commuted form of ~ xleadd1a . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xleadd2a (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cxr)) (wbr A2 B2 cle)) (wbr (co C A2 cxad) (co C B2 cxad) cle) $;

--| Weakened version of ~ xleadd1a under which the reverse implication is true. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xleadd1 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cr)) (wb (wbr A2 B2 cle) (wbr (co A2 C cxad) (co B2 C cxad) cle)) $;

--| Extended real version of ~ ltadd1 . (Contributed by Mario Carneiro, 23-Aug-2015.)
theorem xltadd1 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cr)) (wb (wbr A2 B2 clt) (wbr (co A2 C cxad) (co B2 C cxad) clt)) $;

--| Extended real version of ~ ltadd2 . (Contributed by Mario Carneiro, 23-Aug-2015.)
theorem xltadd2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cr)) (wb (wbr A2 B2 clt) (wbr (co C A2 cxad) (co C B2 cxad) clt)) $;

--| The sum of nonnegative extended reals is nonnegative. (Contributed by Mario Carneiro, 21-Aug-2015.)
theorem xaddge0 (A2 B2: class):
  $ wi (wa (wa (wcel A2 cxr) (wcel B2 cxr)) (wa (wbr cc0 A2 cle) (wbr cc0 B2 cle))) (wbr cc0 (co A2 B2 cxad) cle) $;

--| Extended real version of ~ le2add . (Contributed by Mario Carneiro, 23-Aug-2015.)
theorem xle2add (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cxr) (wcel B2 cxr)) (wa (wcel C cxr) (wcel D cxr))) (wi (wa (wbr A2 C cle) (wbr B2 D cle)) (wbr (co A2 B2 cxad) (co C D cxad) cle)) $;

--| Extended real version of ~ lt2add . Note that ~ ltleadd , which has weaker assumptions, is not true for the extended reals (since ` 0 + +oo < 1 + +oo ` fails). (Contributed by Mario Carneiro, 23-Aug-2015.)
theorem xlt2add (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cxr) (wcel B2 cxr)) (wa (wcel C cxr) (wcel D cxr))) (wi (wa (wbr A2 C clt) (wbr B2 D clt)) (wbr (co A2 B2 cxad) (co C D cxad) clt)) $;

--| Extended real version of ~ subge0 . (Contributed by Mario Carneiro, 24-Aug-2015.)
theorem xsubge0 (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wb (wbr cc0 (co A2 (cxne B2) cxad) cle) (wbr B2 A2 cle)) $;

--| Extended real version of ~ posdif . (Contributed by Mario Carneiro, 24-Aug-2015.)
theorem xposdif (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wb (wbr A2 B2 clt) (wbr cc0 (co B2 (cxne A2) cxad) clt)) $;

--| Under certain conditions, the conclusion of ~ lesubadd is true even in the extended reals. (Contributed by Mario Carneiro, 4-Sep-2015.)
theorem xlesubadd (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cxr)) (w3a (wbr cc0 A2 cle) (wne B2 cmnf) (wbr cc0 C cle))) (wb (wbr (co A2 (cxne B2) cxad) C cle) (wbr A2 (co C B2 cxad) cle)) $;

--| Lemma for ~ rexmul . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xmullem (A2 B2: class):
  $ wi (wa (wa (wa (wa (wcel A2 cxr) (wcel B2 cxr)) (wn (wo (wceq A2 cc0) (wceq B2 cc0)))) (wn (wo (wo (wa (wbr cc0 B2 clt) (wceq A2 cpnf)) (wa (wbr B2 cc0 clt) (wceq A2 cmnf))) (wo (wa (wbr cc0 A2 clt) (wceq B2 cpnf)) (wa (wbr A2 cc0 clt) (wceq B2 cmnf)))))) (wn (wo (wo (wa (wbr cc0 B2 clt) (wceq A2 cmnf)) (wa (wbr B2 cc0 clt) (wceq A2 cpnf))) (wo (wa (wbr cc0 A2 clt) (wceq B2 cmnf)) (wa (wbr A2 cc0 clt) (wceq B2 cpnf)))))) (wcel A2 cr) $;

--| Lemma for ~ xmulneg1 . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xmullem2 (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wi (wo (wo (wa (wbr cc0 B2 clt) (wceq A2 cpnf)) (wa (wbr B2 cc0 clt) (wceq A2 cmnf))) (wo (wa (wbr cc0 A2 clt) (wceq B2 cpnf)) (wa (wbr A2 cc0 clt) (wceq B2 cmnf)))) (wn (wo (wo (wa (wbr cc0 B2 clt) (wceq A2 cmnf)) (wa (wbr B2 cc0 clt) (wceq A2 cpnf))) (wo (wa (wbr cc0 A2 clt) (wceq B2 cmnf)) (wa (wbr A2 cc0 clt) (wceq B2 cpnf)))))) $;

--| Extended real multiplication is commutative. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xmulcom (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wceq (co A2 B2 cxmu) (co B2 A2 cxmu)) $;

--| Extended real version of ~ mul01 . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xmul01 (A2: class):
  $ wi (wcel A2 cxr) (wceq (co A2 cc0 cxmu) cc0) $;

--| Extended real version of ~ mul02 . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xmul02 (A2: class):
  $ wi (wcel A2 cxr) (wceq (co cc0 A2 cxmu) cc0) $;

--| Extended real version of ~ mulneg1 . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xmulneg1 (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wceq (co (cxne A2) B2 cxmu) (cxne (co A2 B2 cxmu))) $;

--| Extended real version of ~ mulneg2 . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xmulneg2 (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wceq (co A2 (cxne B2) cxmu) (cxne (co A2 B2 cxmu))) $;

--| The extended real multiplication when both arguments are real. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem rexmul (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wceq (co A2 B2 cxmu) (co A2 B2 cmul)) $;

--| The extended real multiplication operation is closed in extended reals. (Contributed by Mario Carneiro, 21-Aug-2015.)
theorem xmulf:
  $ wf (cxp cxr cxr) cxr cxmu $;

--| Closure of extended real multiplication. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xmulcl (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wcel (co A2 B2 cxmu) cxr) $;

--| Multiplication by plus infinity on the right. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xmulpnf1 (A2: class):
  $ wi (wa (wcel A2 cxr) (wbr cc0 A2 clt)) (wceq (co A2 cpnf cxmu) cpnf) $;

--| Multiplication by plus infinity on the left. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xmulpnf2 (A2: class):
  $ wi (wa (wcel A2 cxr) (wbr cc0 A2 clt)) (wceq (co cpnf A2 cxmu) cpnf) $;

--| Multiplication by minus infinity on the right. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xmulmnf1 (A2: class):
  $ wi (wa (wcel A2 cxr) (wbr cc0 A2 clt)) (wceq (co A2 cmnf cxmu) cmnf) $;

--| Multiplication by minus infinity on the left. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xmulmnf2 (A2: class):
  $ wi (wa (wcel A2 cxr) (wbr cc0 A2 clt)) (wceq (co cmnf A2 cxmu) cmnf) $;

--| Multiplication by plus infinity on the right, for negative input. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xmulpnf1n (A2: class):
  $ wi (wa (wcel A2 cxr) (wbr A2 cc0 clt)) (wceq (co A2 cpnf cxmu) cmnf) $;

--| Extended real version of ~ mulrid . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xmulrid (A2: class):
  $ wi (wcel A2 cxr) (wceq (co A2 c1 cxmu) A2) $;

--| Extended real version of ~ mullid . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xmullid (A2: class):
  $ wi (wcel A2 cxr) (wceq (co c1 A2 cxmu) A2) $;

--| Extended real version of ~ mulm1 . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xmulm1 (A2: class):
  $ wi (wcel A2 cxr) (wceq (co (cneg c1) A2 cxmu) (cxne A2)) $;

--| Lemma for ~ xmulass . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xmulasslem2 (ph: wff) (A2: class):
  $ wi (wa (wbr cc0 A2 clt) (wceq A2 cmnf)) ph $;

--| Extended real version of ~ mulgt0 . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xmulgt0 (A2 B2: class):
  $ wi (wa (wa (wcel A2 cxr) (wbr cc0 A2 clt)) (wa (wcel B2 cxr) (wbr cc0 B2 clt))) (wbr cc0 (co A2 B2 cxmu) clt) $;

--| Extended real version of ~ mulge0 . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xmulge0 (A2 B2: class):
  $ wi (wa (wa (wcel A2 cxr) (wbr cc0 A2 cle)) (wa (wcel B2 cxr) (wbr cc0 B2 cle))) (wbr cc0 (co A2 B2 cxmu) cle) $;

--| Lemma for ~ xmulass . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xmulasslem {x3: setvar} (ph: wff) (ps: wff x3) (D E F X Y: class):
  $ wi (wceq (cv x3) D) (wb ps (wceq X Y)) $ >
  $ wi (wceq (cv x3) (cxne D)) (wb ps (wceq E F)) $ >
  $ wi ph (wcel X cxr) $ >
  $ wi ph (wcel Y cxr) $ >
  $ wi ph (wcel D cxr) $ >
  $ wi (wa ph (wa (wcel (cv x3) cxr) (wbr cc0 (cv x3) clt))) ps $ >
  $ wi ph (wi (wceq (cv x3) cc0) ps) $ >
  $ wi ph (wceq E (cxne X)) $ >
  $ wi ph (wceq F (cxne Y)) $ >
  $ wi ph (wceq X Y) $;

--| Lemma for ~ xmulass . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xmulasslem3 (A2 B2 C: class):
  $ wi (w3a (wa (wcel A2 cxr) (wbr cc0 A2 clt)) (wa (wcel B2 cxr) (wbr cc0 B2 clt)) (wa (wcel C cxr) (wbr cc0 C clt))) (wceq (co (co A2 B2 cxmu) C cxmu) (co A2 (co B2 C cxmu) cxmu)) $;

--| Associativity of the extended real multiplication operation. Surprisingly, there are no restrictions on the values, unlike ~ xaddass which has to avoid the "undefined" combinations ` +oo +e -oo ` and ` -oo +e +oo ` . The equivalent "undefined" expression here would be ` 0 *e +oo ` , but since this is defined to equal ` 0 ` any zeroes in the expression make the whole thing evaluate to zero (on both sides), thus establishing the identity in this case. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xmulass (A2 B2 C: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cxr)) (wceq (co (co A2 B2 cxmu) C cxmu) (co A2 (co B2 C cxmu) cxmu)) $;

--| Extended real version of ~ lemul1a . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xlemul1a (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cxr) (wcel B2 cxr) (wa (wcel C cxr) (wbr cc0 C cle))) (wbr A2 B2 cle)) (wbr (co A2 C cxmu) (co B2 C cxmu) cle) $;

--| Extended real version of ~ lemul2a . (Contributed by Mario Carneiro, 8-Sep-2015.)
theorem xlemul2a (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cxr) (wcel B2 cxr) (wa (wcel C cxr) (wbr cc0 C cle))) (wbr A2 B2 cle)) (wbr (co C A2 cxmu) (co C B2 cxmu) cle) $;

--| Extended real version of ~ lemul1 . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xlemul1 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C crp)) (wb (wbr A2 B2 cle) (wbr (co A2 C cxmu) (co B2 C cxmu) cle)) $;

--| Extended real version of ~ lemul2 . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xlemul2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C crp)) (wb (wbr A2 B2 cle) (wbr (co C A2 cxmu) (co C B2 cxmu) cle)) $;

--| Extended real version of ~ ltmul1 . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xltmul1 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C crp)) (wb (wbr A2 B2 clt) (wbr (co A2 C cxmu) (co B2 C cxmu) clt)) $;

--| Extended real version of ~ ltmul2 . (Contributed by Mario Carneiro, 8-Sep-2015.)
theorem xltmul2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C crp)) (wb (wbr A2 B2 clt) (wbr (co C A2 cxmu) (co C B2 cxmu) clt)) $;

--| Lemma for ~ xadddi . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xadddilem (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cr) (wcel B2 cxr) (wcel C cxr)) (wbr cc0 A2 clt)) (wceq (co A2 (co B2 C cxad) cxmu) (co (co A2 B2 cxmu) (co A2 C cxmu) cxad)) $;

--| Distributive property for extended real addition and multiplication. Like ~ xaddass , this has an unusual domain of correctness due to counterexamples like ` ( +oo x. ( 2 - 1 ) ) = -oo =/= ` ` ( ( +oo x. 2 ) - ( +oo x. 1 ) ) = ( +oo - +oo ) = 0 ` . In this theorem we show that if the multiplier is real then everything works as expected. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xadddi (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cxr) (wcel C cxr)) (wceq (co A2 (co B2 C cxad) cxmu) (co (co A2 B2 cxmu) (co A2 C cxmu) cxad)) $;

--| Commuted version of ~ xadddi . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xadddir (A2 B2 C: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cr)) (wceq (co (co A2 B2 cxad) C cxmu) (co (co A2 C cxmu) (co B2 C cxmu) cxad)) $;

--| The assumption that the multiplier be real in ~ xadddi can be relaxed if the addends have the same sign. (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xadddi2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cxr) (wa (wcel B2 cxr) (wbr cc0 B2 cle)) (wa (wcel C cxr) (wbr cc0 C cle))) (wceq (co A2 (co B2 C cxad) cxmu) (co (co A2 B2 cxmu) (co A2 C cxmu) cxad)) $;

--| Commuted version of ~ xadddi2 . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem xadddi2r (A2 B2 C: class):
  $ wi (w3a (wa (wcel A2 cxr) (wbr cc0 A2 cle)) (wa (wcel B2 cxr) (wbr cc0 B2 cle)) (wcel C cxr)) (wceq (co (co A2 B2 cxad) C cxmu) (co (co A2 C cxmu) (co B2 C cxmu) cxad)) $;

--| Extended real version of ~ 2times . (Contributed by Mario Carneiro, 20-Aug-2015.)
theorem x2times (A2: class):
  $ wi (wcel A2 cxr) (wceq (co c2 A2 cxmu) (co A2 A2 cxad)) $;

--| Closure of extended real negative. (Contributed by Mario Carneiro, 28-May-2016.)
theorem xnegcld (ph: wff) (A2: class):
  $ wi ph (wcel A2 cxr) $ >
  $ wi ph (wcel (cxne A2) cxr) $;

--| The extended real addition operation is closed in extended reals. (Contributed by Mario Carneiro, 28-May-2016.)
theorem xaddcld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cxr) $ >
  $ wi ph (wcel B2 cxr) $ >
  $ wi ph (wcel (co A2 B2 cxad) cxr) $;

--| Closure of extended real multiplication. (Contributed by Mario Carneiro, 28-May-2016.)
theorem xmulcld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cxr) $ >
  $ wi ph (wcel B2 cxr) $ >
  $ wi ph (wcel (co A2 B2 cxmu) cxr) $;

--| Rearrangement of 4 terms in a sum for extended addition, analogous to ~ add4d . (Contributed by Alexander van der Vekens, 21-Dec-2017.)
theorem xadd4d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wa (wcel A2 cxr) (wne A2 cmnf)) $ >
  $ wi ph (wa (wcel B2 cxr) (wne B2 cmnf)) $ >
  $ wi ph (wa (wcel C cxr) (wne C cmnf)) $ >
  $ wi ph (wa (wcel D cxr) (wne D cmnf)) $ >
  $ wi ph (wceq (co (co A2 B2 cxad) (co C D cxad) cxad) (co (co A2 C cxad) (co B2 D cxad) cxad)) $;

--| Rearrangement of 4 terms in a sum for extended addition of extended nonnegative integers, analogous to ~ xadd4d . (Contributed by AV, 12-Dec-2020.)
theorem xnn0add4d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 cxnn0) $ >
  $ wi ph (wcel B2 cxnn0) $ >
  $ wi ph (wcel C cxnn0) $ >
  $ wi ph (wcel D cxnn0) $ >
  $ wi ph (wceq (co (co A2 B2 cxad) (co C D cxad) cxad) (co (co A2 C cxad) (co B2 D cxad) cxad)) $;

--| Adding minus infinity to a set does not affect the existence of its supremum. (Contributed by NM, 26-Oct-2005.)
theorem xrsupexmnf {x3 y1 z: setvar} (A2: class):
  $ wi (wrex x3 (wa (wral y1 (wn (wbr (cv x3) (cv y1) clt)) A2) (wral y1 (wi (wbr (cv y1) (cv x3) clt) (wrex z (wbr (cv y1) (cv z) clt) A2)) cxr)) cxr) (wrex x3 (wa (wral y1 (wn (wbr (cv x3) (cv y1) clt)) (cun A2 (csn cmnf))) (wral y1 (wi (wbr (cv y1) (cv x3) clt) (wrex z (wbr (cv y1) (cv z) clt) (cun A2 (csn cmnf)))) cxr)) cxr) $;

--| Adding plus infinity to a set does not affect the existence of its infimum. (Contributed by NM, 19-Jan-2006.)
theorem xrinfmexpnf {x3 y1 z: setvar} (A2: class):
  $ wi (wrex x3 (wa (wral y1 (wn (wbr (cv y1) (cv x3) clt)) A2) (wral y1 (wi (wbr (cv x3) (cv y1) clt) (wrex z (wbr (cv z) (cv y1) clt) A2)) cxr)) cxr) (wrex x3 (wa (wral y1 (wn (wbr (cv y1) (cv x3) clt)) (cun A2 (csn cpnf))) (wral y1 (wi (wbr (cv x3) (cv y1) clt) (wrex z (wbr (cv z) (cv y1) clt) (cun A2 (csn cpnf)))) cxr)) cxr) $;

--| Lemma for ~ xrsupss . (Contributed by NM, 25-Oct-2005.)
theorem xrsupsslem {x3 y1 z: setvar} (A2: class):
  $ wi (wa (wss A2 cxr) (wo (wss A2 cr) (wcel cpnf A2))) (wrex x3 (wa (wral y1 (wn (wbr (cv x3) (cv y1) clt)) A2) (wral y1 (wi (wbr (cv y1) (cv x3) clt) (wrex z (wbr (cv y1) (cv z) clt) A2)) cxr)) cxr) $;

--| Lemma for ~ xrinfmss . (Contributed by NM, 19-Jan-2006.)
theorem xrinfmsslem {x3 y1 z: setvar} (A2: class):
  $ wi (wa (wss A2 cxr) (wo (wss A2 cr) (wcel cmnf A2))) (wrex x3 (wa (wral y1 (wn (wbr (cv y1) (cv x3) clt)) A2) (wral y1 (wi (wbr (cv x3) (cv y1) clt) (wrex z (wbr (cv z) (cv y1) clt) A2)) cxr)) cxr) $;

--| Any subset of extended reals has a supremum. (Contributed by NM, 25-Oct-2005.)
theorem xrsupss {x3 y1 z: setvar} (A2: class):
  $ wi (wss A2 cxr) (wrex x3 (wa (wral y1 (wn (wbr (cv x3) (cv y1) clt)) A2) (wral y1 (wi (wbr (cv y1) (cv x3) clt) (wrex z (wbr (cv y1) (cv z) clt) A2)) cxr)) cxr) $;

--| Any subset of extended reals has an infimum. (Contributed by NM, 25-Oct-2005.)
theorem xrinfmss {x3 y1 z: setvar} (A2: class):
  $ wi (wss A2 cxr) (wrex x3 (wa (wral y1 (wn (wbr (cv y1) (cv x3) clt)) A2) (wral y1 (wi (wbr (cv x3) (cv y1) clt) (wrex z (wbr (cv z) (cv y1) clt) A2)) cxr)) cxr) $;

--| Any subset of extended reals has an infimum. (Contributed by Mario Carneiro, 16-Mar-2014.)
theorem xrinfmss2 {x3 y1 z: setvar} (A2: class):
  $ wi (wss A2 cxr) (wrex x3 (wa (wral y1 (wn (wbr (cv x3) (cv y1) (ccnv clt))) A2) (wral y1 (wi (wbr (cv y1) (cv x3) (ccnv clt)) (wrex z (wbr (cv y1) (cv z) (ccnv clt)) A2)) cxr)) cxr) $;

--| By quantifying only over reals, we can specify any extended real upper bound for any set of extended reals. (Contributed by NM, 9-Apr-2006.)
theorem xrub {x3 y1: setvar} (A2 B2: class):
  $ wi (wa (wss A2 cxr) (wcel B2 cxr)) (wb (wral x3 (wi (wbr (cv x3) B2 clt) (wrex y1 (wbr (cv x3) (cv y1) clt) A2)) cr) (wral x3 (wi (wbr (cv x3) B2 clt) (wrex y1 (wbr (cv x3) (cv y1) clt) A2)) cxr)) $;

--| The supremum of a set of extended reals. (Contributed by NM, 9-Apr-2006.) (Revised by Mario Carneiro, 21-Apr-2015.)
theorem supxr {x3 y1: setvar} (A2 B2: class):
  $ wi (wa (wa (wss A2 cxr) (wcel B2 cxr)) (wa (wral x3 (wn (wbr B2 (cv x3) clt)) A2) (wral x3 (wi (wbr (cv x3) B2 clt) (wrex y1 (wbr (cv x3) (cv y1) clt) A2)) cr))) (wceq (csup A2 cxr clt) B2) $;

--| The supremum of a set of extended reals. (Contributed by NM, 9-Apr-2006.)
theorem supxr2 {x3 y1: setvar} (A2 B2: class):
  $ wi (wa (wa (wss A2 cxr) (wcel B2 cxr)) (wa (wral x3 (wbr (cv x3) B2 cle) A2) (wral x3 (wi (wbr (cv x3) B2 clt) (wrex y1 (wbr (cv x3) (cv y1) clt) A2)) cr))) (wceq (csup A2 cxr clt) B2) $;

--| The supremum of an arbitrary set of extended reals is an extended real. (Contributed by NM, 24-Oct-2005.)
theorem supxrcl (A2: class):
  $ wi (wss A2 cxr) (wcel (csup A2 cxr clt) cxr) $;

--| The supremum of the union of two sets of extended reals equals the largest of their suprema. (Contributed by NM, 19-Jan-2006.)
theorem supxrun (A2 B2: class):
  $ wi (w3a (wss A2 cxr) (wss B2 cxr) (wbr (csup A2 cxr clt) (csup B2 cxr clt) cle)) (wceq (csup (cun A2 B2) cxr clt) (csup B2 cxr clt)) $;

--| Adding minus infinity to a set does not affect its supremum. (Contributed by NM, 19-Jan-2006.)
theorem supxrmnf (A2: class):
  $ wi (wss A2 cxr) (wceq (csup (cun A2 (csn cmnf)) cxr clt) (csup A2 cxr clt)) $;

--| The supremum of a set of extended reals containing plus infinity is plus infinity. (Contributed by NM, 15-Oct-2005.)
theorem supxrpnf (A2: class):
  $ wi (wa (wss A2 cxr) (wcel cpnf A2)) (wceq (csup A2 cxr clt) cpnf) $;

--| The supremum of an unbounded-above set of extended reals is plus infinity. (Contributed by NM, 19-Jan-2006.)
theorem supxrunb1 {x3 y1: setvar} (A2: class):
  $ wi (wss A2 cxr) (wb (wral x3 (wrex y1 (wbr (cv x3) (cv y1) cle) A2) cr) (wceq (csup A2 cxr clt) cpnf)) $;

--| The supremum of an unbounded-above set of extended reals is plus infinity. (Contributed by NM, 19-Jan-2006.)
theorem supxrunb2 {x3 y1: setvar} (A2: class):
  $ wi (wss A2 cxr) (wb (wral x3 (wrex y1 (wbr (cv x3) (cv y1) clt) A2) cr) (wceq (csup A2 cxr clt) cpnf)) $;

--| The supremum of a bounded-above set of extended reals is less than infinity. (Contributed by NM, 30-Jan-2006.)
theorem supxrbnd1 {x3 y1: setvar} (A2: class):
  $ wi (wss A2 cxr) (wb (wrex x3 (wral y1 (wbr (cv y1) (cv x3) clt) A2) cr) (wbr (csup A2 cxr clt) cpnf clt)) $;

--| The supremum of a bounded-above set of extended reals is less than infinity. (Contributed by NM, 30-Jan-2006.)
theorem supxrbnd2 {x3 y1: setvar} (A2: class):
  $ wi (wss A2 cxr) (wb (wrex x3 (wral y1 (wbr (cv y1) (cv x3) cle) A2) cr) (wbr (csup A2 cxr clt) cpnf clt)) $;

--| The supremum of an empty set under the extended reals is minus infinity. (Contributed by NM, 15-Oct-2005.)
theorem xrsup0:
  $ wceq (csup c0 cxr clt) cmnf $;

--| A member of a set of extended reals is less than or equal to the set's supremum. (Contributed by NM, 7-Feb-2006.)
theorem supxrub (A2 B2: class):
  $ wi (wa (wss A2 cxr) (wcel B2 A2)) (wbr B2 (csup A2 cxr clt) cle) $;

--| The supremum of a set of extended reals is less than or equal to an upper bound. (Contributed by Mario Carneiro, 13-Sep-2015.)
theorem supxrlub {x3: setvar} (A2 B2: class):
  $ wi (wa (wss A2 cxr) (wcel B2 cxr)) (wb (wbr B2 (csup A2 cxr clt) clt) (wrex x3 (wbr B2 (cv x3) clt) A2)) $;

--| The supremum of a set of extended reals is less than or equal to an upper bound. (Contributed by NM, 22-Feb-2006.) (Revised by Mario Carneiro, 6-Sep-2014.)
theorem supxrleub {x3: setvar} (A2 B2: class):
  $ wi (wa (wss A2 cxr) (wcel B2 cxr)) (wb (wbr (csup A2 cxr clt) B2 cle) (wral x3 (wbr (cv x3) B2 cle) A2)) $;

--| The real and extended real suprema match when the real supremum exists. (Contributed by NM, 18-Oct-2005.) (Proof shortened by Mario Carneiro, 7-Sep-2014.)
theorem supxrre {x3 y1: setvar} (A2: class):
  $ wi (w3a (wss A2 cr) (wne A2 c0) (wrex x3 (wral y1 (wbr (cv y1) (cv x3) cle) A2) cr)) (wceq (csup A2 cxr clt) (csup A2 cr clt)) $;

--| The supremum of a bounded-above nonempty set of reals is real. (Contributed by NM, 19-Jan-2006.)
theorem supxrbnd (A2: class):
  $ wi (w3a (wss A2 cr) (wne A2 c0) (wbr (csup A2 cxr clt) cpnf clt)) (wcel (csup A2 cxr clt) cr) $;

--| The supremum of a nonempty set of reals is greater than minus infinity. (Contributed by NM, 2-Feb-2006.)
theorem supxrgtmnf (A2: class):
  $ wi (wa (wss A2 cr) (wne A2 c0)) (wbr cmnf (csup A2 cxr clt) clt) $;

--| The supremum of a nonempty set of reals is real iff it is less than plus infinity. (Contributed by NM, 5-Feb-2006.)
theorem supxrre1 (A2: class):
  $ wi (wa (wss A2 cr) (wne A2 c0)) (wb (wcel (csup A2 cxr clt) cr) (wbr (csup A2 cxr clt) cpnf clt)) $;

--| The supremum of a nonempty set of reals is real iff it is not plus infinity. (Contributed by NM, 5-Feb-2006.)
theorem supxrre2 (A2: class):
  $ wi (wa (wss A2 cr) (wne A2 c0)) (wb (wcel (csup A2 cxr clt) cr) (wne (csup A2 cxr clt) cpnf)) $;

--| Smaller sets of extended reals have smaller suprema. (Contributed by Mario Carneiro, 1-Apr-2015.)
theorem supxrss (A2 B2: class):
  $ wi (wa (wss A2 B2) (wss B2 cxr)) (wbr (csup A2 cxr clt) (csup B2 cxr clt) cle) $;

--| Inequality deduction for supremum of an extended real subset. (Contributed by Thierry Arnoux, 21-Mar-2017.)
theorem xrsupssd (ph: wff) (B2 C: class):
  $ wi ph (wss B2 C) $ >
  $ wi ph (wss C cxr) $ >
  $ wi ph (wbr (csup B2 cxr clt) (csup C cxr clt) cle) $;

--| The infimum of an arbitrary set of extended reals is an extended real. (Contributed by NM, 19-Jan-2006.) (Revised by AV, 5-Sep-2020.)
theorem infxrcl (A2: class):
  $ wi (wss A2 cxr) (wcel (cinf A2 cxr clt) cxr) $;

--| A member of a set of extended reals is greater than or equal to the set's infimum. (Contributed by Mario Carneiro, 16-Mar-2014.) (Revised by AV, 5-Sep-2020.)
theorem infxrlb (A2 B2: class):
  $ wi (wa (wss A2 cxr) (wcel B2 A2)) (wbr (cinf A2 cxr clt) B2 cle) $;

--| The infimum of a set of extended reals is greater than or equal to a lower bound. (Contributed by Mario Carneiro, 16-Mar-2014.) (Revised by AV, 5-Sep-2020.)
theorem infxrgelb {x3: setvar} (A2 B2: class):
  $ wi (wa (wss A2 cxr) (wcel B2 cxr)) (wb (wbr B2 (cinf A2 cxr clt) cle) (wral x3 (wbr B2 (cv x3) cle) A2)) $;

--| The real and extended real infima match when the real infimum exists. (Contributed by Mario Carneiro, 7-Sep-2014.) (Revised by AV, 5-Sep-2020.)
theorem infxrre {x3 y1: setvar} (A2: class):
  $ wi (w3a (wss A2 cr) (wne A2 c0) (wrex x3 (wral y1 (wbr (cv x3) (cv y1) cle) A2) cr)) (wceq (cinf A2 cxr clt) (cinf A2 cr clt)) $;

--| The infinimum of a set of extended reals containing minus infinity is minus infinity. (Contributed by Thierry Arnoux, 18-Feb-2018.) (Revised by AV, 28-Sep-2020.)
theorem infxrmnf (A2: class):
  $ wi (wa (wss A2 cxr) (wcel cmnf A2)) (wceq (cinf A2 cxr clt) cmnf) $;

--| The infimum of the empty set under the extended reals is positive infinity. (Contributed by Mario Carneiro, 21-Apr-2015.) (Revised by AV, 5-Sep-2020.)
theorem xrinf0:
  $ wceq (cinf c0 cxr clt) cpnf $;

--| Larger sets of extended reals have smaller infima. (Contributed by Glauco Siliprandi, 11-Dec-2019.) (Revised by AV, 13-Sep-2020.)
theorem infxrss (A2 B2: class):
  $ wi (wa (wss A2 B2) (wss B2 cxr)) (wbr (cinf B2 cxr clt) (cinf A2 cxr clt) cle) $;

--| For all real numbers there is a smaller real number. (Contributed by AV, 5-Sep-2020.)
theorem reltre {x3 y1: setvar}:
  $ wral x3 (wrex y1 (wbr (cv y1) (cv x3) clt) cr) cr $;

--| For all positive real numbers there is a smaller positive real number. (Contributed by AV, 5-Sep-2020.)
theorem rpltrp {x3 y1: setvar}:
  $ wral x3 (wrex y1 (wbr (cv y1) (cv x3) clt) crp) crp $;

--| For all extended real numbers not being minus infinity there is a smaller real number. (Contributed by AV, 5-Sep-2020.)
theorem reltxrnmnf {x3 y1: setvar}:
  $ wral x3 (wi (wbr cmnf (cv x3) clt) (wrex y1 (wbr (cv y1) (cv x3) clt) cr)) cxr $;

--| The infimum of the reals is minus infinity. (Contributed by AV, 5-Sep-2020.)
theorem infmremnf:
  $ wceq (cinf cr cxr clt) cmnf $;

--| The infimum of the positive reals is 0. (Contributed by AV, 5-Sep-2020.)
theorem infmrp1:
  $ wceq (cinf crp cr clt) cc0 $;

--| Extend class notation with the set of open intervals of extended reals.
term cioo: class;

--| Extend class notation with the set of open-below, closed-above intervals of extended reals.
term cioc: class;

--| Extend class notation with the set of closed-below, open-above intervals of extended reals.
term cico: class;

--| Extend class notation with the set of closed intervals of extended reals.
term cicc: class;

--| Define the set of open intervals of extended reals. (Contributed by NM, 24-Dec-2006.)
axiom df_ioo {x3 y1 z: setvar}:
  $ wceq cioo (cmpo x3 y1 cxr cxr (crab z (wa (wbr (cv x3) (cv z) clt) (wbr (cv z) (cv y1) clt)) cxr)) $;

--| Define the set of open-below, closed-above intervals of extended reals. (Contributed by NM, 24-Dec-2006.)
axiom df_ioc {x3 y1 z: setvar}:
  $ wceq cioc (cmpo x3 y1 cxr cxr (crab z (wa (wbr (cv x3) (cv z) clt) (wbr (cv z) (cv y1) cle)) cxr)) $;

--| Define the set of closed-below, open-above intervals of extended reals. (Contributed by NM, 24-Dec-2006.)
axiom df_ico {x3 y1 z: setvar}:
  $ wceq cico (cmpo x3 y1 cxr cxr (crab z (wa (wbr (cv x3) (cv z) cle) (wbr (cv z) (cv y1) clt)) cxr)) $;

--| Define the set of closed intervals of extended reals. (Contributed by NM, 24-Dec-2006.)
axiom df_icc {x3 y1 z: setvar}:
  $ wceq cicc (cmpo x3 y1 cxr cxr (crab z (wa (wbr (cv x3) (cv z) cle) (wbr (cv z) (cv y1) cle)) cxr)) $;

--| Value of the interval function. (Contributed by Mario Carneiro, 3-Nov-2013.)
theorem ixxval {x3 y1 z: setvar} (A2 B2 R S: class) (O: class x3 y1 z):
  $ wceq O (cmpo x3 y1 cxr cxr (crab z (wa (wbr (cv x3) (cv z) R) (wbr (cv z) (cv y1) S)) cxr)) $ >
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wceq (co A2 B2 O) (crab z (wa (wbr A2 (cv z) R) (wbr (cv z) B2 S)) cxr)) $;

--| Membership in an interval of extended reals. (Contributed by Mario Carneiro, 3-Nov-2013.)
theorem elixx1 {x3 y1 z: setvar} (A2 B2 C R S: class) (O: class x3 y1 z):
  $ wceq O (cmpo x3 y1 cxr cxr (crab z (wa (wbr (cv x3) (cv z) R) (wbr (cv z) (cv y1) S)) cxr)) $ >
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wb (wcel C (co A2 B2 O)) (w3a (wcel C cxr) (wbr A2 C R) (wbr C B2 S))) $;

--| The set of intervals of extended reals maps to subsets of extended reals. (Contributed by FL, 14-Jun-2007.) (Revised by Mario Carneiro, 16-Nov-2013.)
theorem ixxf {x3 y1 z: setvar} (R S: class) (O: class x3 y1 z):
  $ wceq O (cmpo x3 y1 cxr cxr (crab z (wa (wbr (cv x3) (cv z) R) (wbr (cv z) (cv y1) S)) cxr)) $ >
  $ wf (cxp cxr cxr) (cpw cxr) O $;

--| The set of intervals of extended reals exists. (Contributed by Mario Carneiro, 3-Nov-2013.) (Revised by Mario Carneiro, 17-Nov-2014.)
theorem ixxex {x3 y1 z: setvar} (R S: class) (O: class x3 y1 z):
  $ wceq O (cmpo x3 y1 cxr cxr (crab z (wa (wbr (cv x3) (cv z) R) (wbr (cv z) (cv y1) S)) cxr)) $ >
  $ wcel O cvv $;

--| The set of intervals of extended reals maps to subsets of extended reals. (Contributed by Mario Carneiro, 4-Jul-2014.)
theorem ixxssxr {x3 y1 z: setvar} (A2 B2 R S: class) (O: class x3 y1 z):
  $ wceq O (cmpo x3 y1 cxr cxr (crab z (wa (wbr (cv x3) (cv z) R) (wbr (cv z) (cv y1) S)) cxr)) $ >
  $ wss (co A2 B2 O) cxr $;

--| Membership in a set of open intervals of extended reals. We use the fact that an operation's value is empty outside of its domain to show ` A e. RR* ` and ` B e. RR* ` . (Contributed by Mario Carneiro, 3-Nov-2013.)
theorem elixx3g {x3 y1 z: setvar} (A2 B2 C R S: class) (O: class x3 y1 z):
  $ wceq O (cmpo x3 y1 cxr cxr (crab z (wa (wbr (cv x3) (cv z) R) (wbr (cv z) (cv y1) S)) cxr)) $ >
  $ wb (wcel C (co A2 B2 O)) (wa (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cxr)) (wa (wbr A2 C R) (wbr C B2 S))) $;

--| An interval is a subset of its closure. (Contributed by Paul Chapman, 18-Oct-2007.) (Revised by Mario Carneiro, 3-Nov-2013.)
theorem ixxssixx {x3 y1 z w: setvar} (A2 B2: class) (P: class x3 y1 z) (R S T U: class w) (O: class x3 y1 z):
  $ wceq O (cmpo x3 y1 cxr cxr (crab z (wa (wbr (cv x3) (cv z) R) (wbr (cv z) (cv y1) S)) cxr)) $ >
  $ wceq P (cmpo x3 y1 cxr cxr (crab z (wa (wbr (cv x3) (cv z) T) (wbr (cv z) (cv y1) U)) cxr)) $ >
  $ wi (wa (wcel A2 cxr) (wcel (cv w) cxr)) (wi (wbr A2 (cv w) R) (wbr A2 (cv w) T)) $ >
  $ wi (wa (wcel (cv w) cxr) (wcel B2 cxr)) (wi (wbr (cv w) B2 S) (wbr (cv w) B2 U)) $ >
  $ wss (co A2 B2 O) (co A2 B2 P) $;

--| Split an interval into disjoint pieces. (Contributed by Mario Carneiro, 16-Jun-2014.)
theorem ixxdisj {x3 y1 z w: setvar} (A2 B2 C: class) (P: class x3 y1 z) (R S T U: class w) (O: class x3 y1 z):
  $ wceq O (cmpo x3 y1 cxr cxr (crab z (wa (wbr (cv x3) (cv z) R) (wbr (cv z) (cv y1) S)) cxr)) $ >
  $ wceq P (cmpo x3 y1 cxr cxr (crab z (wa (wbr (cv x3) (cv z) T) (wbr (cv z) (cv y1) U)) cxr)) $ >
  $ wi (wa (wcel B2 cxr) (wcel (cv w) cxr)) (wb (wbr B2 (cv w) T) (wn (wbr (cv w) B2 S))) $ >
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cxr)) (wceq (cin (co A2 B2 O) (co B2 C P)) c0) $;

--| Split an interval into two parts. (Contributed by Mario Carneiro, 16-Jun-2014.)
theorem ixxun {x3 y1 z w: setvar} (A2 B2 C: class) (P Q: class x3 y1 z) (R S T U: class w) (O W X: class x3 y1 z):
  $ wceq O (cmpo x3 y1 cxr cxr (crab z (wa (wbr (cv x3) (cv z) R) (wbr (cv z) (cv y1) S)) cxr)) $ >
  $ wceq P (cmpo x3 y1 cxr cxr (crab z (wa (wbr (cv x3) (cv z) T) (wbr (cv z) (cv y1) U)) cxr)) $ >
  $ wi (wa (wcel B2 cxr) (wcel (cv w) cxr)) (wb (wbr B2 (cv w) T) (wn (wbr (cv w) B2 S))) $ >
  $ wceq Q (cmpo x3 y1 cxr cxr (crab z (wa (wbr (cv x3) (cv z) R) (wbr (cv z) (cv y1) U)) cxr)) $ >
  $ wi (w3a (wcel (cv w) cxr) (wcel B2 cxr) (wcel C cxr)) (wi (wa (wbr (cv w) B2 S) (wbr B2 C X)) (wbr (cv w) C U)) $ >
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel (cv w) cxr)) (wi (wa (wbr A2 B2 W) (wbr B2 (cv w) T)) (wbr A2 (cv w) R)) $ >
  $ wi (wa (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cxr)) (wa (wbr A2 B2 W) (wbr B2 C X))) (wceq (cun (co A2 B2 O) (co B2 C P)) (co A2 C Q)) $;

--| Intersection of two intervals of extended reals. (Contributed by Mario Carneiro, 3-Nov-2013.)
theorem ixxin {x3 y1 z: setvar} (A2 B2 C D R S: class) (O: class x3 y1 z):
  $ wceq O (cmpo x3 y1 cxr cxr (crab z (wa (wbr (cv x3) (cv z) R) (wbr (cv z) (cv y1) S)) cxr)) $ >
  $ wi (w3a (wcel A2 cxr) (wcel C cxr) (wcel (cv z) cxr)) (wb (wbr (cif (wbr A2 C cle) C A2) (cv z) R) (wa (wbr A2 (cv z) R) (wbr C (cv z) R))) $ >
  $ wi (w3a (wcel (cv z) cxr) (wcel B2 cxr) (wcel D cxr)) (wb (wbr (cv z) (cif (wbr B2 D cle) B2 D) S) (wa (wbr (cv z) B2 S) (wbr (cv z) D S))) $ >
  $ wi (wa (wa (wcel A2 cxr) (wcel B2 cxr)) (wa (wcel C cxr) (wcel D cxr))) (wceq (cin (co A2 B2 O) (co C D O)) (co (cif (wbr A2 C cle) C A2) (cif (wbr B2 D cle) B2 D) O)) $;

--| Subset relationship for intervals of extended reals. (Contributed by Mario Carneiro, 3-Nov-2013.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem ixxss1 {x3 y1 z w: setvar} (A2 B2 C: class) (P: class x3 y1 z) (R S T: class w) (O W: class x3 y1 z):
  $ wceq O (cmpo x3 y1 cxr cxr (crab z (wa (wbr (cv x3) (cv z) R) (wbr (cv z) (cv y1) S)) cxr)) $ >
  $ wceq P (cmpo x3 y1 cxr cxr (crab z (wa (wbr (cv x3) (cv z) T) (wbr (cv z) (cv y1) S)) cxr)) $ >
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel (cv w) cxr)) (wi (wa (wbr A2 B2 W) (wbr B2 (cv w) T)) (wbr A2 (cv w) R)) $ >
  $ wi (wa (wcel A2 cxr) (wbr A2 B2 W)) (wss (co B2 C P) (co A2 C O)) $;

--| Subset relationship for intervals of extended reals. (Contributed by Mario Carneiro, 3-Nov-2013.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem ixxss2 {x3 y1 z w: setvar} (A2 B2 C: class) (P: class x3 y1 z) (R S T: class w) (O W: class x3 y1 z):
  $ wceq O (cmpo x3 y1 cxr cxr (crab z (wa (wbr (cv x3) (cv z) R) (wbr (cv z) (cv y1) S)) cxr)) $ >
  $ wceq P (cmpo x3 y1 cxr cxr (crab z (wa (wbr (cv x3) (cv z) R) (wbr (cv z) (cv y1) T)) cxr)) $ >
  $ wi (w3a (wcel (cv w) cxr) (wcel B2 cxr) (wcel C cxr)) (wi (wa (wbr (cv w) B2 T) (wbr B2 C W)) (wbr (cv w) C S)) $ >
  $ wi (wa (wcel C cxr) (wbr B2 C W)) (wss (co A2 B2 P) (co A2 C O)) $;

--| Subset relationship for intervals of extended reals. (Contributed by Mario Carneiro, 20-Feb-2015.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem ixxss12 {x3 y1 z w: setvar} (A2 B2 C D: class) (P: class x3 y1 z) (R S T U: class w) (O W X: class x3 y1 z):
  $ wceq O (cmpo x3 y1 cxr cxr (crab z (wa (wbr (cv x3) (cv z) R) (wbr (cv z) (cv y1) S)) cxr)) $ >
  $ wceq P (cmpo x3 y1 cxr cxr (crab z (wa (wbr (cv x3) (cv z) T) (wbr (cv z) (cv y1) U)) cxr)) $ >
  $ wi (w3a (wcel A2 cxr) (wcel C cxr) (wcel (cv w) cxr)) (wi (wa (wbr A2 C W) (wbr C (cv w) T)) (wbr A2 (cv w) R)) $ >
  $ wi (w3a (wcel (cv w) cxr) (wcel D cxr) (wcel B2 cxr)) (wi (wa (wbr (cv w) D U) (wbr D B2 X)) (wbr (cv w) B2 S)) $ >
  $ wi (wa (wa (wcel A2 cxr) (wcel B2 cxr)) (wa (wbr A2 C W) (wbr D B2 X))) (wss (co C D P) (co A2 B2 O)) $;

--| Extract the upper bound of an interval. (Contributed by Mario Carneiro, 17-Jun-2014.)
theorem ixxub {x3 y1 z w: setvar} (A2 B2: class) (R S: class w) (O: class x3 y1 z):
  $ wceq O (cmpo x3 y1 cxr cxr (crab z (wa (wbr (cv x3) (cv z) R) (wbr (cv z) (cv y1) S)) cxr)) $ >
  $ wi (wa (wcel (cv w) cxr) (wcel B2 cxr)) (wi (wbr (cv w) B2 clt) (wbr (cv w) B2 S)) $ >
  $ wi (wa (wcel (cv w) cxr) (wcel B2 cxr)) (wi (wbr (cv w) B2 S) (wbr (cv w) B2 cle)) $ >
  $ wi (wa (wcel A2 cxr) (wcel (cv w) cxr)) (wi (wbr A2 (cv w) clt) (wbr A2 (cv w) R)) $ >
  $ wi (wa (wcel A2 cxr) (wcel (cv w) cxr)) (wi (wbr A2 (cv w) R) (wbr A2 (cv w) cle)) $ >
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wne (co A2 B2 O) c0)) (wceq (csup (co A2 B2 O) cxr clt) B2) $;

--| Extract the lower bound of an interval. (Contributed by Mario Carneiro, 17-Jun-2014.) (Revised by AV, 12-Sep-2020.)
theorem ixxlb {x3 y1 z w: setvar} (A2 B2: class) (R S: class w) (O: class x3 y1 z):
  $ wceq O (cmpo x3 y1 cxr cxr (crab z (wa (wbr (cv x3) (cv z) R) (wbr (cv z) (cv y1) S)) cxr)) $ >
  $ wi (wa (wcel (cv w) cxr) (wcel B2 cxr)) (wi (wbr (cv w) B2 clt) (wbr (cv w) B2 S)) $ >
  $ wi (wa (wcel (cv w) cxr) (wcel B2 cxr)) (wi (wbr (cv w) B2 S) (wbr (cv w) B2 cle)) $ >
  $ wi (wa (wcel A2 cxr) (wcel (cv w) cxr)) (wi (wbr A2 (cv w) clt) (wbr A2 (cv w) R)) $ >
  $ wi (wa (wcel A2 cxr) (wcel (cv w) cxr)) (wi (wbr A2 (cv w) R) (wbr A2 (cv w) cle)) $ >
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wne (co A2 B2 O) c0)) (wceq (cinf (co A2 B2 O) cxr clt) A2) $;

--| The set of open intervals of extended reals exists. (Contributed by NM, 6-Feb-2007.) (Revised by Mario Carneiro, 3-Nov-2013.)
theorem iooex:
  $ wcel cioo cvv $;

--| Value of the open interval function. (Contributed by NM, 24-Dec-2006.) (Revised by Mario Carneiro, 3-Nov-2013.)
theorem iooval {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wceq (co A2 B2 cioo) (crab x3 (wa (wbr A2 (cv x3) clt) (wbr (cv x3) B2 clt)) cxr)) $;

--| An empty open interval of extended reals. (Contributed by NM, 6-Feb-2007.)
theorem ioo0 (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wb (wceq (co A2 B2 cioo) c0) (wbr B2 A2 cle)) $;

--| An open interval of extended reals is nonempty iff the lower argument is less than the upper argument. (Contributed by NM, 2-Mar-2007.)
theorem ioon0 (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wb (wne (co A2 B2 cioo) c0) (wbr A2 B2 clt)) $;

--| The open interval function's value is empty outside of its domain. (Contributed by NM, 21-Jun-2007.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem ndmioo (A2 B2: class):
  $ wi (wn (wa (wcel A2 cxr) (wcel B2 cxr))) (wceq (co A2 B2 cioo) c0) $;

--| An open interval with identical lower and upper bounds is empty. (Contributed by NM, 21-Jun-2007.) (Revised by Mario Carneiro, 3-Nov-2013.)
theorem iooid (A2: class):
  $ wceq (co A2 A2 cioo) c0 $;

--| Membership in a set of open intervals of extended reals. We use the fact that an operation's value is empty outside of its domain to show ` A e. RR* ` and ` B e. RR* ` . (Contributed by NM, 24-Dec-2006.) (Revised by Mario Carneiro, 3-Nov-2013.)
theorem elioo3g (A2 B2 C: class):
  $ wb (wcel C (co A2 B2 cioo)) (wa (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cxr)) (wa (wbr A2 C clt) (wbr C B2 clt))) $;

--| A member of an open interval of reals is a real. (Contributed by NM, 17-Aug-2008.) (Revised by Mario Carneiro, 3-Nov-2013.)
theorem elioore (A2 B2 C: class):
  $ wi (wcel A2 (co B2 C cioo)) (wcel A2 cr) $;

--| An open interval does not contain its left endpoint. (Contributed by Mario Carneiro, 29-Dec-2016.)
theorem lbioo (A2 B2: class):
  $ wn (wcel A2 (co A2 B2 cioo)) $;

--| An open interval does not contain its right endpoint. (Contributed by Mario Carneiro, 29-Dec-2016.)
theorem ubioo (A2 B2: class):
  $ wn (wcel B2 (co A2 B2 cioo)) $;

--| Value of the open interval function. (Contributed by NM, 6-Feb-2007.) (Revised by Mario Carneiro, 3-Nov-2013.)
theorem iooval2 {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wceq (co A2 B2 cioo) (crab x3 (wa (wbr A2 (cv x3) clt) (wbr (cv x3) B2 clt)) cr)) $;

--| Intersection of two open intervals of extended reals. (Contributed by NM, 7-Feb-2007.) (Revised by Mario Carneiro, 3-Nov-2013.)
theorem iooin (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cxr) (wcel B2 cxr)) (wa (wcel C cxr) (wcel D cxr))) (wceq (cin (co A2 B2 cioo) (co C D cioo)) (co (cif (wbr A2 C cle) C A2) (cif (wbr B2 D cle) B2 D) cioo)) $;

--| Subset relationship for open intervals of extended reals. (Contributed by NM, 7-Feb-2007.) (Revised by Mario Carneiro, 20-Feb-2015.)
theorem iooss1 (A2 B2 C: class):
  $ wi (wa (wcel A2 cxr) (wbr A2 B2 cle)) (wss (co B2 C cioo) (co A2 C cioo)) $;

--| Subset relationship for open intervals of extended reals. (Contributed by NM, 7-Feb-2007.) (Revised by Mario Carneiro, 3-Nov-2013.)
theorem iooss2 (A2 B2 C: class):
  $ wi (wa (wcel C cxr) (wbr B2 C cle)) (wss (co A2 B2 cioo) (co A2 C cioo)) $;

--| Value of the open-below, closed-above interval function. (Contributed by NM, 24-Dec-2006.) (Revised by Mario Carneiro, 3-Nov-2013.)
theorem iocval {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wceq (co A2 B2 cioc) (crab x3 (wa (wbr A2 (cv x3) clt) (wbr (cv x3) B2 cle)) cxr)) $;

--| Value of the closed-below, open-above interval function. (Contributed by NM, 24-Dec-2006.) (Revised by Mario Carneiro, 3-Nov-2013.)
theorem icoval {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wceq (co A2 B2 cico) (crab x3 (wa (wbr A2 (cv x3) cle) (wbr (cv x3) B2 clt)) cxr)) $;

--| Value of the closed interval function. (Contributed by NM, 24-Dec-2006.) (Revised by Mario Carneiro, 3-Nov-2013.)
theorem iccval {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wceq (co A2 B2 cicc) (crab x3 (wa (wbr A2 (cv x3) cle) (wbr (cv x3) B2 cle)) cxr)) $;

--| Membership in an open interval of extended reals. (Contributed by NM, 24-Dec-2006.) (Revised by Mario Carneiro, 3-Nov-2013.)
theorem elioo1 (A2 B2 C: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wb (wcel C (co A2 B2 cioo)) (w3a (wcel C cxr) (wbr A2 C clt) (wbr C B2 clt))) $;

--| Membership in an open interval of extended reals. (Contributed by NM, 6-Feb-2007.)
theorem elioo2 (A2 B2 C: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wb (wcel C (co A2 B2 cioo)) (w3a (wcel C cr) (wbr A2 C clt) (wbr C B2 clt))) $;

--| Membership in an open-below, closed-above interval of extended reals. (Contributed by NM, 24-Dec-2006.) (Revised by Mario Carneiro, 3-Nov-2013.)
theorem elioc1 (A2 B2 C: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wb (wcel C (co A2 B2 cioc)) (w3a (wcel C cxr) (wbr A2 C clt) (wbr C B2 cle))) $;

--| Membership in a closed-below, open-above interval of extended reals. (Contributed by NM, 24-Dec-2006.) (Revised by Mario Carneiro, 3-Nov-2013.)
theorem elico1 (A2 B2 C: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wb (wcel C (co A2 B2 cico)) (w3a (wcel C cxr) (wbr A2 C cle) (wbr C B2 clt))) $;

--| Membership in a closed interval of extended reals. (Contributed by NM, 24-Dec-2006.) (Revised by Mario Carneiro, 3-Nov-2013.)
theorem elicc1 (A2 B2 C: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wb (wcel C (co A2 B2 cicc)) (w3a (wcel C cxr) (wbr A2 C cle) (wbr C B2 cle))) $;

--| A closed interval with identical lower and upper bounds is a singleton. (Contributed by Jeff Hankins, 13-Jul-2009.)
theorem iccid (A2: class):
  $ wi (wcel A2 cxr) (wceq (co A2 A2 cicc) (csn A2)) $;

--| An empty open interval of extended reals. (Contributed by FL, 30-May-2014.)
theorem ico0 (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wb (wceq (co A2 B2 cico) c0) (wbr B2 A2 cle)) $;

--| An empty open interval of extended reals. (Contributed by FL, 30-May-2014.)
theorem ioc0 (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wb (wceq (co A2 B2 cioc) c0) (wbr B2 A2 cle)) $;

--| An empty closed interval of extended reals. (Contributed by FL, 30-May-2014.)
theorem icc0 (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cxr)) (wb (wceq (co A2 B2 cicc) c0) (wbr B2 A2 clt)) $;

--| Alternate definition of the positive real numbers. (Contributed by Thierry Arnoux, 4-May-2020.)
theorem dfrp2:
  $ wceq crp (co cc0 cpnf cioo) $;

--| Membership in a left-closed right-open interval. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem elicod (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cxr) $ >
  $ wi ph (wcel B2 cxr) $ >
  $ wi ph (wcel C cxr) $ >
  $ wi ph (wbr A2 C cle) $ >
  $ wi ph (wbr C B2 clt) $ >
  $ wi ph (wcel C (co A2 B2 cico)) $;

--| An element of a left-closed right-open interval is greater than or equal to its lower bound. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem icogelb (A2 B2 C: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C (co A2 B2 cico))) (wbr A2 C cle) $;

--| An element of a left-closed right-open interval is greater than or equal to its lower bound. (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem icogelbd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cxr) $ >
  $ wi ph (wcel B2 cxr) $ >
  $ wi ph (wcel C (co A2 B2 cico)) $ >
  $ wi ph (wbr A2 C cle) $;

--| A member of a left-closed right-open interval of reals is real. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem elicore (A2 B2 C: class):
  $ wi (wa (wcel A2 cr) (wcel C (co A2 B2 cico))) (wcel C cr) $;

--| The upper bound belongs to an open-below, closed-above interval. See ~ ubicc2 . (Contributed by FL, 29-May-2014.)
theorem ubioc1 (A2 B2: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wbr A2 B2 clt)) (wcel B2 (co A2 B2 cioc)) $;

--| The lower bound belongs to a closed-below, open-above interval. See ~ lbicc2 . (Contributed by FL, 29-May-2014.)
theorem lbico1 (A2 B2: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wbr A2 B2 clt)) (wcel A2 (co A2 B2 cico)) $;

--| An element of a closed interval is less than or equal to its upper bound. (Contributed by Jeff Hankins, 14-Jul-2009.)
theorem iccleub (A2 B2 C: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C (co A2 B2 cicc))) (wbr C B2 cle) $;

--| An element of a closed interval is more than or equal to its lower bound. (Contributed by Thierry Arnoux, 23-Dec-2016.)
theorem iccgelb (A2 B2 C: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C (co A2 B2 cicc))) (wbr A2 C cle) $;

--| Membership in an open interval of extended reals. (Contributed by NM, 17-Aug-2008.)
theorem elioo5 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cxr)) (wb (wcel C (co A2 B2 cioo)) (wa (wbr A2 C clt) (wbr C B2 clt))) $;

--| A nonempty open interval spans an interval of extended reals. (Contributed by NM, 17-Aug-2008.)
theorem eliooxr (A2 B2 C: class):
  $ wi (wcel A2 (co B2 C cioo)) (wa (wcel B2 cxr) (wcel C cxr)) $;

--| Ordering implied by a member of an open interval of reals. (Contributed by NM, 17-Aug-2008.) (Revised by Mario Carneiro, 9-May-2014.)
theorem eliooord (A2 B2 C: class):
  $ wi (wcel A2 (co B2 C cioo)) (wa (wbr B2 A2 clt) (wbr A2 C clt)) $;

--| Membership in an open interval of extended reals. (Contributed by NM, 8-Jun-2007.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem elioo4g (A2 B2 C: class):
  $ wb (wcel C (co A2 B2 cioo)) (wa (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cr)) (wa (wbr A2 C clt) (wbr C B2 clt))) $;

--| An open interval is a set of reals. (Contributed by NM, 31-May-2007.)
theorem ioossre (A2 B2: class):
  $ wss (co A2 B2 cioo) cr $;

--| An open interval is a set of complex numbers. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem ioosscn (A2 B2: class):
  $ wss (co A2 B2 cioo) cc $;

--| Membership in an open-below, closed-above real interval. (Contributed by Paul Chapman, 30-Dec-2007.) (Revised by Mario Carneiro, 14-Jun-2014.)
theorem elioc2 (A2 B2 C: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cr)) (wb (wcel C (co A2 B2 cioc)) (w3a (wcel C cr) (wbr A2 C clt) (wbr C B2 cle))) $;

--| Membership in a closed-below, open-above real interval. (Contributed by Paul Chapman, 21-Jan-2008.) (Revised by Mario Carneiro, 14-Jun-2014.)
theorem elico2 (A2 B2 C: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cxr)) (wb (wcel C (co A2 B2 cico)) (w3a (wcel C cr) (wbr A2 C cle) (wbr C B2 clt))) $;

--| Membership in a closed real interval. (Contributed by Paul Chapman, 21-Sep-2007.) (Revised by Mario Carneiro, 14-Jun-2014.)
theorem elicc2 (A2 B2 C: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wb (wcel C (co A2 B2 cicc)) (w3a (wcel C cr) (wbr A2 C cle) (wbr C B2 cle))) $;

--| Inference for membership in a closed interval. (Contributed by Scott Fenton, 3-Jun-2013.)
theorem elicc2i (A2 B2 C: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wb (wcel C (co A2 B2 cicc)) (w3a (wcel C cr) (wbr A2 C cle) (wbr C B2 cle)) $;

--| Membership in a closed real interval. (Contributed by Stefan O'Rear, 16-Nov-2014.) (Proof shortened by Mario Carneiro, 1-Jan-2017.)
theorem elicc4 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cxr)) (wb (wcel C (co A2 B2 cicc)) (wa (wbr A2 C cle) (wbr C B2 cle))) $;

--| Condition for a closed interval to be a subset of another closed interval. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 20-Feb-2015.)
theorem iccss (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cr) (wcel B2 cr)) (wa (wbr A2 C cle) (wbr D B2 cle))) (wss (co C D cicc) (co A2 B2 cicc)) $;

--| Condition for a closed interval to be a subset of an open interval. (Contributed by Mario Carneiro, 20-Feb-2015.)
theorem iccssioo (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cxr) (wcel B2 cxr)) (wa (wbr A2 C clt) (wbr D B2 clt))) (wss (co C D cicc) (co A2 B2 cioo)) $;

--| Condition for a closed-below, open-above interval to be a subset of a closed-below, open-above interval. (Contributed by Thierry Arnoux, 21-Sep-2017.)
theorem icossico (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cxr) (wcel B2 cxr)) (wa (wbr A2 C cle) (wbr D B2 cle))) (wss (co C D cico) (co A2 B2 cico)) $;

--| Condition for a closed interval to be a subset of another closed interval. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem iccss2 (A2 B2 C D: class):
  $ wi (wa (wcel C (co A2 B2 cicc)) (wcel D (co A2 B2 cicc))) (wss (co C D cicc) (co A2 B2 cicc)) $;

--| Condition for a closed interval to be a subset of a half-open interval. (Contributed by Mario Carneiro, 9-Sep-2015.)
theorem iccssico (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cxr) (wcel B2 cxr)) (wa (wbr A2 C cle) (wbr D B2 clt))) (wss (co C D cicc) (co A2 B2 cico)) $;

--| Condition for a closed interval to be a subset of an open interval. (Contributed by Mario Carneiro, 20-Feb-2015.)
theorem iccssioo2 (A2 B2 C D: class):
  $ wi (wa (wcel C (co A2 B2 cioo)) (wcel D (co A2 B2 cioo))) (wss (co C D cicc) (co A2 B2 cioo)) $;

--| Condition for a closed interval to be a subset of a closed-below, open-above interval. (Contributed by Mario Carneiro, 20-Feb-2015.)
theorem iccssico2 (A2 B2 C D: class):
  $ wi (wa (wcel C (co A2 B2 cico)) (wcel D (co A2 B2 cico))) (wss (co C D cicc) (co A2 B2 cico)) $;

--| Condition for a closed-below, open-above interval to be a subset of a closed-below, open-above interval. (Contributed by Glauco Siliprandi, 2-Jan-2022.)
theorem icossico2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel B2 cxr) $ >
  $ wi ph (wcel C cxr) $ >
  $ wi ph (wbr B2 A2 cle) $ >
  $ wi ph (wss (co A2 C cico) (co B2 C cico)) $;

--| The open interval from minus to plus infinity. (Contributed by NM, 6-Feb-2007.)
theorem ioomax:
  $ wceq (co cmnf cpnf cioo) cr $;

--| The closed interval from minus to plus infinity. (Contributed by Mario Carneiro, 4-Jul-2014.)
theorem iccmax:
  $ wceq (co cmnf cpnf cicc) cxr $;

--| The set of positive reals expressed as an open interval. (Contributed by NM, 7-May-2007.)
theorem ioopos {x3: setvar}:
  $ wceq (co cc0 cpnf cioo) (crab x3 (wbr cc0 (cv x3) clt) cr) $;

--| The set of positive reals expressed as an open interval. (Contributed by Steve Rodriguez, 25-Nov-2007.)
theorem ioorp:
  $ wceq (co cc0 cpnf cioo) crp $;

--| Shift the arguments of the open interval function. (Contributed by NM, 17-Aug-2008.)
theorem iooshf (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cr) (wcel B2 cr)) (wa (wcel C cr) (wcel D cr))) (wb (wcel (co A2 B2 cmin) (co C D cioo)) (wcel A2 (co (co C B2 caddc) (co D B2 caddc) cioo))) $;

--| A closed-above interval with real upper bound is a set of reals. (Contributed by FL, 29-May-2014.)
theorem iocssre (A2 B2: class):
  $ wi (wa (wcel A2 cxr) (wcel B2 cr)) (wss (co A2 B2 cioc) cr) $;

--| A closed-below interval with real lower bound is a set of reals. (Contributed by Mario Carneiro, 14-Jun-2014.)
theorem icossre (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cxr)) (wss (co A2 B2 cico) cr) $;

--| A closed real interval is a set of reals. (Contributed by FL, 6-Jun-2007.) (Proof shortened by Paul Chapman, 21-Jan-2008.)
theorem iccssre (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wss (co A2 B2 cicc) cr) $;

--| A closed interval is a set of extended reals. (Contributed by FL, 28-Jul-2008.) (Revised by Mario Carneiro, 4-Jul-2014.)
theorem iccssxr (A2 B2: class):
  $ wss (co A2 B2 cicc) cxr $;

--| An open-below, closed-above interval is a subset of the extended reals. (Contributed by FL, 29-May-2014.) (Revised by Mario Carneiro, 4-Jul-2014.)
theorem iocssxr (A2 B2: class):
  $ wss (co A2 B2 cioc) cxr $;

--| A closed-below, open-above interval is a subset of the extended reals. (Contributed by FL, 29-May-2014.) (Revised by Mario Carneiro, 4-Jul-2014.)
theorem icossxr (A2 B2: class):
  $ wss (co A2 B2 cico) cxr $;

--| An open interval is a subset of its closure. (Contributed by Paul Chapman, 18-Oct-2007.)
theorem ioossicc (A2 B2: class):
  $ wss (co A2 B2 cioo) (co A2 B2 cicc) $;

--| A closed real interval is a set of reals. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem iccssred (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wss (co A2 B2 cicc) cr) $;

--| A member of a closed interval is an extended real. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem eliccxr (A2 B2 C: class):
  $ wi (wcel A2 (co B2 C cicc)) (wcel A2 cxr) $;

--| A closed-below, open-above interval is a subset of its closure. (Contributed by Thierry Arnoux, 25-Oct-2016.)
theorem icossicc (A2 B2: class):
  $ wss (co A2 B2 cico) (co A2 B2 cicc) $;

--| A closed-above, open-below interval is a subset of its closure. (Contributed by Thierry Arnoux, 1-Apr-2017.)
theorem iocssicc (A2 B2: class):
  $ wss (co A2 B2 cioc) (co A2 B2 cicc) $;

--| An open interval is a subset of its closure-below. (Contributed by Thierry Arnoux, 3-Mar-2017.)
theorem ioossico (A2 B2: class):
  $ wss (co A2 B2 cioo) (co A2 B2 cico) $;

--| Condition for a closed interval to be a subset of an open interval. (Contributed by Thierry Arnoux, 29-Mar-2017.)
theorem iocssioo (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cxr) (wcel B2 cxr)) (wa (wbr A2 C cle) (wbr D B2 clt))) (wss (co C D cioc) (co A2 B2 cioo)) $;

--| Condition for a closed interval to be a subset of an open interval. (Contributed by Thierry Arnoux, 29-Mar-2017.)
theorem icossioo (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cxr) (wcel B2 cxr)) (wa (wbr A2 C clt) (wbr D B2 cle))) (wss (co C D cico) (co A2 B2 cioo)) $;

--| Condition for an open interval to be a subset of an open interval. (Contributed by Thierry Arnoux, 26-Sep-2017.)
theorem ioossioo (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cxr) (wcel B2 cxr)) (wa (wbr A2 C cle) (wbr D B2 cle))) (wss (co C D cioo) (co A2 B2 cioo)) $;

--| A nonempty subset of a closed real interval satisfies the conditions for the existence of its supremum (see ~ suprcl ). (Contributed by Paul Chapman, 21-Jan-2008.)
theorem iccsupr {x3 y1: setvar} (A2: class x3) (B2: class) (C: class x3 y1) (S: class):
  $ wi (w3a (wa (wcel A2 cr) (wcel B2 cr)) (wss S (co A2 B2 cicc)) (wcel C S)) (w3a (wss S cr) (wne S c0) (wrex x3 (wral y1 (wbr (cv y1) (cv x3) cle) S) cr)) $;

--| Membership in an unbounded interval of extended reals. (Contributed by Mario Carneiro, 18-Jun-2014.)
theorem elioopnf (A2 B2: class):
  $ wi (wcel A2 cxr) (wb (wcel B2 (co A2 cpnf cioo)) (wa (wcel B2 cr) (wbr A2 B2 clt))) $;

--| Membership in an unbounded interval of extended reals. (Contributed by Mario Carneiro, 18-Jun-2014.)
theorem elioomnf (A2 B2: class):
  $ wi (wcel A2 cxr) (wb (wcel B2 (co cmnf A2 cioo)) (wa (wcel B2 cr) (wbr B2 A2 clt))) $;

--| Membership in a closed unbounded interval of reals. (Contributed by Mario Carneiro, 16-Sep-2014.)
theorem elicopnf (A2 B2: class):
  $ wi (wcel A2 cr) (wb (wcel B2 (co A2 cpnf cico)) (wa (wcel B2 cr) (wbr A2 B2 cle))) $;

--| Two ways of saying that a real number is positive. (Contributed by NM, 7-May-2007.)
theorem repos (A2: class):
  $ wb (wcel A2 (co cc0 cpnf cioo)) (wa (wcel A2 cr) (wbr cc0 A2 clt)) $;

--| The set of open intervals of extended reals maps to subsets of reals. (Contributed by NM, 7-Feb-2007.) (Revised by Mario Carneiro, 16-Nov-2013.)
theorem ioof:
  $ wf (cxp cxr cxr) (cpw cr) cioo $;

--| The set of closed intervals of extended reals maps to subsets of extended reals. (Contributed by FL, 14-Jun-2007.) (Revised by Mario Carneiro, 3-Nov-2013.)
theorem iccf:
  $ wf (cxp cxr cxr) (cpw cxr) cicc $;

--| The union of the range of the open interval function. (Contributed by NM, 7-May-2007.) (Revised by Mario Carneiro, 30-Jan-2014.)
theorem unirnioo:
  $ wceq cr (cuni (crn cioo)) $;

--| Alternate definition of the set of open intervals of extended reals. (Contributed by NM, 1-Mar-2007.) (Revised by Mario Carneiro, 1-Sep-2015.)
theorem dfioo2 {x3 y1 w: setvar}:
  $ wceq cioo (cmpo x3 y1 cxr cxr (crab w (wa (wbr (cv x3) (cv w) clt) (wbr (cv w) (cv y1) clt)) cr)) $;

--| Open intervals are elements of the set of all open intervals. (Contributed by Mario Carneiro, 26-Mar-2015.)
theorem ioorebas (A2 B2: class):
  $ wcel (co A2 B2 cioo) (crn cioo) $;

--| A nonnegative extended real is not equal to minus infinity. (Contributed by Thierry Arnoux, 9-Jun-2017.) (Proof shortened by Glauco Siliprandi, 17-Aug-2020.)
theorem xrge0neqmnf (A2: class):
  $ wi (wcel A2 (co cc0 cpnf cicc)) (wne A2 cmnf) $;

--| An extended real which is not a real is plus infinity. (Contributed by Thierry Arnoux, 16-Oct-2017.)
theorem xrge0nre (A2: class):
  $ wi (wa (wcel A2 (co cc0 cpnf cicc)) (wn (wcel A2 cr))) (wceq A2 cpnf) $;

--| The predicate "is a nonnegative real". (Contributed by Jeff Madsen, 2-Sep-2009.) (Proof shortened by Mario Carneiro, 18-Jun-2014.)
theorem elrege0 (A2: class):
  $ wb (wcel A2 (co cc0 cpnf cico)) (wa (wcel A2 cr) (wbr cc0 A2 cle)) $;

--| A nonnegative integer is a nonnegative real number. (Contributed by AV, 24-May-2020.)
theorem nn0rp0 (N: class):
  $ wi (wcel N cn0) (wcel N (co cc0 cpnf cico)) $;

--| Nonnegative real numbers are real numbers. (Contributed by Thierry Arnoux, 9-Sep-2018.) (Proof shortened by AV, 8-Sep-2019.)
theorem rge0ssre:
  $ wss (co cc0 cpnf cico) cr $;

--| Elementhood in the set of nonnegative extended reals. (Contributed by Mario Carneiro, 28-Jun-2014.)
theorem elxrge0 (A2: class):
  $ wb (wcel A2 (co cc0 cpnf cicc)) (wa (wcel A2 cxr) (wbr cc0 A2 cle)) $;

--| 0 is a member of ` ( 0 [,) +oo ) ` . (Contributed by David A. Wheeler, 8-Dec-2018.)
theorem _0e0icopnf:
  $ wcel cc0 (co cc0 cpnf cico) $;

--| 0 is a member of ` ( 0 [,] +oo ) ` . (Contributed by David A. Wheeler, 8-Dec-2018.)
theorem _0e0iccpnf:
  $ wcel cc0 (co cc0 cpnf cicc) $;

--| The nonnegative reals are closed under addition. (Contributed by Mario Carneiro, 19-Jun-2014.)
theorem ge0addcl (A2 B2: class):
  $ wi (wa (wcel A2 (co cc0 cpnf cico)) (wcel B2 (co cc0 cpnf cico))) (wcel (co A2 B2 caddc) (co cc0 cpnf cico)) $;

--| The nonnegative reals are closed under multiplication. (Contributed by Mario Carneiro, 19-Jun-2014.)
theorem ge0mulcl (A2 B2: class):
  $ wi (wa (wcel A2 (co cc0 cpnf cico)) (wcel B2 (co cc0 cpnf cico))) (wcel (co A2 B2 cmul) (co cc0 cpnf cico)) $;

--| The nonnegative reals are closed under addition. (Contributed by Mario Carneiro, 26-Aug-2015.)
theorem ge0xaddcl (A2 B2: class):
  $ wi (wa (wcel A2 (co cc0 cpnf cicc)) (wcel B2 (co cc0 cpnf cicc))) (wcel (co A2 B2 cxad) (co cc0 cpnf cicc)) $;

--| The nonnegative extended reals are closed under multiplication. (Contributed by Mario Carneiro, 26-Aug-2015.)
theorem ge0xmulcl (A2 B2: class):
  $ wi (wa (wcel A2 (co cc0 cpnf cicc)) (wcel B2 (co cc0 cpnf cicc))) (wcel (co A2 B2 cxmu) (co cc0 cpnf cicc)) $;

--| The lower bound of a closed interval is a member of it. (Contributed by Paul Chapman, 26-Nov-2007.) (Revised by FL, 29-May-2014.) (Revised by Mario Carneiro, 9-Sep-2015.)
theorem lbicc2 (A2 B2: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wbr A2 B2 cle)) (wcel A2 (co A2 B2 cicc)) $;

--| The upper bound of a closed interval is a member of it. (Contributed by Paul Chapman, 26-Nov-2007.) (Revised by FL, 29-May-2014.)
theorem ubicc2 (A2 B2: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wbr A2 B2 cle)) (wcel B2 (co A2 B2 cicc)) $;

--| Membership in the closed real interval between 0 and 1, also called the closed unit interval. (Contributed by AV, 20-Aug-2022.)
theorem elicc01 (X: class):
  $ wb (wcel X (co cc0 c1 cicc)) (w3a (wcel X cr) (wbr cc0 X cle) (wbr X c1 cle)) $;

--| The closed unit interval is a subset of the set of the real numbers. Useful lemma for manipulating probabilities within the closed unit interval. (Contributed by Thierry Arnoux, 21-Dec-2016.)
theorem elunitrn (A2: class):
  $ wi (wcel A2 (co cc0 c1 cicc)) (wcel A2 cr) $;

--| The closed unit interval is a subset of the set of the complex numbers. Useful lemma for manipulating probabilities within the closed unit interval. (Contributed by Thierry Arnoux, 21-Dec-2016.)
theorem elunitcn (A2: class):
  $ wi (wcel A2 (co cc0 c1 cicc)) (wcel A2 cc) $;

--| Zero is an element of the closed unit interval. (Contributed by Scott Fenton, 11-Jun-2013.)
theorem _0elunit:
  $ wcel cc0 (co cc0 c1 cicc) $;

--| One is an element of the closed unit interval. (Contributed by Scott Fenton, 11-Jun-2013.)
theorem _1elunit:
  $ wcel c1 (co cc0 c1 cicc) $;

--| Membership in a negated open real interval. (Contributed by Paul Chapman, 26-Nov-2007.)
theorem iooneg (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wb (wcel C (co A2 B2 cioo)) (wcel (cneg C) (co (cneg B2) (cneg A2) cioo))) $;

--| Membership in a negated closed real interval. (Contributed by Paul Chapman, 26-Nov-2007.)
theorem iccneg (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wb (wcel C (co A2 B2 cicc)) (wcel (cneg C) (co (cneg B2) (cneg A2) cicc))) $;

--| A shifted real is a member of a shifted, closed-below, open-above real interval. (Contributed by Paul Chapman, 25-Mar-2008.)
theorem icoshft (A2 B2 C X: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wi (wcel X (co A2 B2 cico)) (wcel (co X C caddc) (co (co A2 C caddc) (co B2 C caddc) cico))) $;

--| Shifting a closed-below, open-above interval is one-to-one onto. (Contributed by Paul Chapman, 25-Mar-2008.) (Proof shortened by Mario Carneiro, 1-Sep-2015.)
theorem icoshftf1o {x3: setvar} (A2 B2 C: class) (F: class x3):
  $ wceq F (cmpt x3 (co A2 B2 cico) (co (cv x3) C caddc)) $ >
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wf1o (co A2 B2 cico) (co (co A2 C caddc) (co B2 C caddc) cico) F) $;

--| The union of two adjacent left-closed right-open real intervals is a left-closed right-open real interval. (Contributed by Paul Chapman, 15-Mar-2008.) (Proof shortened by Mario Carneiro, 16-Jun-2014.)
theorem icoun (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cxr)) (wa (wbr A2 B2 cle) (wbr B2 C cle))) (wceq (cun (co A2 B2 cico) (co B2 C cico)) (co A2 C cico)) $;

--| Adjacent left-closed right-open real intervals are disjoint. (Contributed by Mario Carneiro, 16-Jun-2014.)
theorem icodisj (A2 B2 C: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cxr)) (wceq (cin (co A2 B2 cico) (co B2 C cico)) c0) $;

--| The union of an open interval with its upper endpoint is a left-open right-closed interval. (Contributed by Jon Pennant, 8-Jun-2019.)
theorem ioounsn (A2 B2: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wbr A2 B2 clt)) (wceq (cun (co A2 B2 cioo) (csn B2)) (co A2 B2 cioc)) $;

--| The closure of one end of an open real interval. (Contributed by Paul Chapman, 15-Mar-2008.) (Proof shortened by Mario Carneiro, 16-Jun-2014.)
theorem snunioo (A2 B2: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wbr A2 B2 clt)) (wceq (cun (csn A2) (co A2 B2 cioo)) (co A2 B2 cico)) $;

--| The closure of the open end of a right-open real interval. (Contributed by Mario Carneiro, 16-Jun-2014.)
theorem snunico (A2 B2: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wbr A2 B2 cle)) (wceq (cun (co A2 B2 cico) (csn B2)) (co A2 B2 cicc)) $;

--| The closure of the open end of a left-open real interval. (Contributed by Thierry Arnoux, 28-Mar-2017.)
theorem snunioc (A2 B2: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wbr A2 B2 cle)) (wceq (cun (csn A2) (co A2 B2 cioc)) (co A2 B2 cicc)) $;

--| The closure of an open real interval. (Contributed by Paul Chapman, 15-Mar-2008.) (Proof shortened by Mario Carneiro, 16-Jun-2014.)
theorem prunioo (A2 B2: class):
  $ wi (w3a (wcel A2 cxr) (wcel B2 cxr) (wbr A2 B2 cle)) (wceq (cun (co A2 B2 cioo) (cpr A2 B2)) (co A2 B2 cicc)) $;

--| If the upper bound of one open interval is less than or equal to the lower bound of the other, the intervals are disjoint. (Contributed by Jeff Hankins, 13-Jul-2009.)
theorem ioodisj (A2 B2 C D: class):
  $ wi (wa (wa (wa (wcel A2 cxr) (wcel B2 cxr)) (wa (wcel C cxr) (wcel D cxr))) (wbr B2 C cle)) (wceq (cin (co A2 B2 cioo) (co C D cioo)) c0) $;

--| Join two open intervals to create a third. (Contributed by NM, 11-Aug-2008.) (Proof shortened by Mario Carneiro, 16-Jun-2014.)
theorem ioojoin (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cxr) (wcel B2 cxr) (wcel C cxr)) (wa (wbr A2 B2 clt) (wbr B2 C clt))) (wceq (cun (cun (co A2 B2 cioo) (csn B2)) (co B2 C cioo)) (co A2 C cioo)) $;

--| The class difference of ` RR ` and a closed interval. (Contributed by FL, 18-Jun-2007.)
theorem difreicc (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wceq (cdif cr (co A2 B2 cicc)) (cun (co cmnf A2 cioo) (co B2 cpnf cioo))) $;

--| Split a closed interval into the union of two closed intervals. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem iccsplit (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C (co A2 B2 cicc))) (wceq (co A2 B2 cicc) (cun (co A2 C cicc) (co C B2 cicc))) $;

--| Membership in a shifted interval. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem iccshftr (A2 B2 C D R X: class):
  $ wceq (co A2 R caddc) C $ >
  $ wceq (co B2 R caddc) D $ >
  $ wi (wa (wa (wcel A2 cr) (wcel B2 cr)) (wa (wcel X cr) (wcel R cr))) (wb (wcel X (co A2 B2 cicc)) (wcel (co X R caddc) (co C D cicc))) $;

--| Membership in a shifted interval. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem iccshftri (A2 B2 C D R X: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wcel R cr $ >
  $ wceq (co A2 R caddc) C $ >
  $ wceq (co B2 R caddc) D $ >
  $ wi (wcel X (co A2 B2 cicc)) (wcel (co X R caddc) (co C D cicc)) $;

--| Membership in a shifted interval. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem iccshftl (A2 B2 C D R X: class):
  $ wceq (co A2 R cmin) C $ >
  $ wceq (co B2 R cmin) D $ >
  $ wi (wa (wa (wcel A2 cr) (wcel B2 cr)) (wa (wcel X cr) (wcel R cr))) (wb (wcel X (co A2 B2 cicc)) (wcel (co X R cmin) (co C D cicc))) $;

--| Membership in a shifted interval. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem iccshftli (A2 B2 C D R X: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wcel R cr $ >
  $ wceq (co A2 R cmin) C $ >
  $ wceq (co B2 R cmin) D $ >
  $ wi (wcel X (co A2 B2 cicc)) (wcel (co X R cmin) (co C D cicc)) $;

--| Membership in a dilated interval. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem iccdil (A2 B2 C D R X: class):
  $ wceq (co A2 R cmul) C $ >
  $ wceq (co B2 R cmul) D $ >
  $ wi (wa (wa (wcel A2 cr) (wcel B2 cr)) (wa (wcel X cr) (wcel R crp))) (wb (wcel X (co A2 B2 cicc)) (wcel (co X R cmul) (co C D cicc))) $;

--| Membership in a dilated interval. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem iccdili (A2 B2 C D R X: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wcel R crp $ >
  $ wceq (co A2 R cmul) C $ >
  $ wceq (co B2 R cmul) D $ >
  $ wi (wcel X (co A2 B2 cicc)) (wcel (co X R cmul) (co C D cicc)) $;

--| Membership in a contracted interval. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem icccntr (A2 B2 C D R X: class):
  $ wceq (co A2 R cdiv) C $ >
  $ wceq (co B2 R cdiv) D $ >
  $ wi (wa (wa (wcel A2 cr) (wcel B2 cr)) (wa (wcel X cr) (wcel R crp))) (wb (wcel X (co A2 B2 cicc)) (wcel (co X R cdiv) (co C D cicc))) $;

--| Membership in a contracted interval. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem icccntri (A2 B2 C D R X: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wcel R crp $ >
  $ wceq (co A2 R cdiv) C $ >
  $ wceq (co B2 R cdiv) D $ >
  $ wi (wcel X (co A2 B2 cicc)) (wcel (co X R cdiv) (co C D cicc)) $;

--| A condition for a ratio to be a member of the closed unit interval. (Contributed by Scott Fenton, 11-Jun-2013.)
theorem divelunit (A2 B2: class):
  $ wi (wa (wa (wcel A2 cr) (wbr cc0 A2 cle)) (wa (wcel B2 cr) (wbr cc0 B2 clt))) (wb (wcel (co A2 B2 cdiv) (co cc0 c1 cicc)) (wbr A2 B2 cle)) $;

--| A linear combination of two reals which lies in the interval between them. (Contributed by Jeff Madsen, 2-Sep-2009.) (Proof shortened by Mario Carneiro, 8-Sep-2015.)
theorem lincmb01cmp (A2 B2 T: class):
  $ wi (wa (w3a (wcel A2 cr) (wcel B2 cr) (wbr A2 B2 clt)) (wcel T (co cc0 c1 cicc))) (wcel (co (co (co c1 T cmin) A2 cmul) (co T B2 cmul) caddc) (co A2 B2 cicc)) $;

--| Describe a bijection from ` [ 0 , 1 ] ` to an arbitrary nontrivial closed interval ` [ A , B ] ` . (Contributed by Mario Carneiro, 8-Sep-2015.)
theorem iccf1o {x3 y1: setvar} (A2 B2: class) (F: class x3 y1):
  $ wceq F (cmpt x3 (co cc0 c1 cicc) (co (co (cv x3) B2 cmul) (co (co c1 (cv x3) cmin) A2 cmul) caddc)) $ >
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wbr A2 B2 clt)) (wa (wf1o (co cc0 c1 cicc) (co A2 B2 cicc) F) (wceq (ccnv F) (cmpt y1 (co A2 B2 cicc) (co (co (cv y1) A2 cmin) (co B2 A2 cmin) cdiv)))) $;

--| Any nontrivial closed interval is equinumerous to the unit interval. (Contributed by Mario Carneiro, 26-Jul-2014.) (Revised by Mario Carneiro, 8-Sep-2015.)
theorem iccen (A2 B2: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wbr A2 B2 clt)) (wbr (co cc0 c1 cicc) (co A2 B2 cicc) cen) $;

--| A complex number ` X ` is positive real iff ` X / ( 1 + X ) ` is in ` ( 0 (,) 1 ) ` . Deduction form. (Contributed by David Moews, 28-Feb-2017.)
theorem xov1plusxeqvd (ph: wff) (X: class):
  $ wi ph (wcel X cc) $ >
  $ wi ph (wne X (cneg c1)) $ >
  $ wi ph (wb (wcel X crp) (wcel (co X (co c1 X caddc) cdiv) (co cc0 c1 cioo))) $;

--| ` ( 0 [,] 1 ) ` is a subset of the reals. (Contributed by David Moews, 28-Feb-2017.)
theorem unitssre:
  $ wss (co cc0 c1 cicc) cr $;

--| The closed unit interval is a subset of the set of the complex numbers. Useful lemma for manipulating probabilities within the closed unit interval. (Contributed by Thierry Arnoux, 12-Dec-2016.)
theorem unitsscn:
  $ wss (co cc0 c1 cicc) cc $;

--| Supremum of a bounded set of real numbers. (Contributed by Thierry Arnoux, 17-May-2019.)
theorem supicc (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wss A2 (co B2 C cicc)) $ >
  $ wi ph (wne A2 c0) $ >
  $ wi ph (wcel (csup A2 cr clt) (co B2 C cicc)) $;

--| The supremum of a bounded set of real numbers is an upper bound. (Contributed by Thierry Arnoux, 20-May-2019.)
theorem supiccub (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wss A2 (co B2 C cicc)) $ >
  $ wi ph (wne A2 c0) $ >
  $ wi ph (wcel D A2) $ >
  $ wi ph (wbr D (csup A2 cr clt) cle) $;

--| The supremum of a bounded set of real numbers is the least upper bound. (Contributed by Thierry Arnoux, 23-May-2019.)
theorem supicclub {z: setvar} (ph: wff z) (A2: class) (B2 C: class z) (D: class):
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wss A2 (co B2 C cicc)) $ >
  $ wi ph (wne A2 c0) $ >
  $ wi ph (wcel D A2) $ >
  $ wi ph (wb (wbr D (csup A2 cr clt) clt) (wrex z (wbr D (cv z) clt) A2)) $;

--| The supremum of a bounded set of real numbers is the least upper bound. (Contributed by Thierry Arnoux, 23-May-2019.)
theorem supicclub2 {z: setvar} (ph: wff) (A2: class) (B2 C: class z) (D: class):
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wss A2 (co B2 C cicc)) $ >
  $ wi ph (wne A2 c0) $ >
  $ wi ph (wcel D A2) $ >
  $ wi (wa ph (wcel (cv z) A2)) (wbr (cv z) D cle) $ >
  $ wi ph (wbr (csup A2 cr clt) D cle) $;

--| The sum of an integer and a real number between 0 and 1 is less than or equal to a second integer iff the sum is less than the second integer. (Contributed by AV, 1-Jul-2021.)
theorem zltaddlt1le (A2 M N: class):
  $ wi (w3a (wcel M cz) (wcel N cz) (wcel A2 (co cc0 c1 cioo))) (wb (wbr (co M A2 caddc) N clt) (wbr (co M A2 caddc) N cle)) $;

--| An extended nonnegative integer is an extended nonnegative real. (Contributed by AV, 10-Dec-2020.)
theorem xnn0xrge0 (A2: class):
  $ wi (wcel A2 cxnn0) (wcel A2 (co cc0 cpnf cicc)) $;

--| The reciprocal of an integer greater than 1 is in the right open interval between 0 and 1. (Contributed by AV, 10-Apr-2026.)
theorem nnge2recico01 (N: class):
  $ wi (wcel N (cfv c2 cuz)) (wcel (co c1 N cdiv) (co cc0 c1 cico)) $;

--| Extend class notation to include the notation for a contiguous finite set of integers. Read " ` M ... N ` " as "the set of integers from ` M ` to ` N ` inclusive". This symbol is also used informally in some comments to denote an ellipsis, e.g., ` A + A ^ 2 + ... + A ^ ( N - 1 ) ` .
term cfz: class;

--| Define an operation that produces a finite set of sequential integers. Read " ` M ... N ` " as "the set of integers from ` M ` to ` N ` inclusive". See ~ fzval for its value and additional comments. (Contributed by NM, 6-Sep-2005.)
axiom df_fz {k m n: setvar}:
  $ wceq cfz (cmpo m n cz cz (crab k (wa (wbr (cv m) (cv k) cle) (wbr (cv k) (cv n) cle)) cz)) $;

--| The value of a finite set of sequential integers. E.g., ` 2 ... 5 ` means the set ` { 2 , 3 , 4 , 5 } ` . A special case of this definition (starting at 1) appears as Definition 11-2.1 of [Gleason] p. 141, where ` NN `_k means our ` 1 ... k ` ; he calls these sets _segments_ of the integers. (Contributed by NM, 6-Sep-2005.) (Revised by Mario Carneiro, 3-Nov-2013.)
theorem fzval {k: setvar} (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wceq (co M N cfz) (crab k (wa (wbr M (cv k) cle) (wbr (cv k) N cle)) cz)) $;

--| An alternative way of expressing a finite set of sequential integers. (Contributed by Mario Carneiro, 3-Nov-2013.)
theorem fzval2 (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wceq (co M N cfz) (cin (co M N cicc) cz)) $;

--| Establish the domain and codomain of the finite integer sequence function. (Contributed by Scott Fenton, 8-Aug-2013.) (Revised by Mario Carneiro, 16-Nov-2013.)
theorem fzf:
  $ wf (cxp cz cz) (cpw cz) cfz $;

--| Membership in a finite set of sequential integers. (Contributed by NM, 21-Jul-2005.)
theorem elfz1 (K M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wcel K (co M N cfz)) (w3a (wcel K cz) (wbr M K cle) (wbr K N cle))) $;

--| Membership in a finite set of sequential integers. (Contributed by NM, 29-Sep-2005.)
theorem elfz (K M N: class):
  $ wi (w3a (wcel K cz) (wcel M cz) (wcel N cz)) (wb (wcel K (co M N cfz)) (wa (wbr M K cle) (wbr K N cle))) $;

--| Membership in a finite set of sequential integers. We use the fact that an operation's value is empty outside of its domain to show ` M e. ZZ ` and ` N e. ZZ ` . (Contributed by NM, 6-Sep-2005.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem elfz2 (K M N: class):
  $ wb (wcel K (co M N cfz)) (wa (w3a (wcel M cz) (wcel N cz) (wcel K cz)) (wa (wbr M K cle) (wbr K N cle))) $;

--| Membership in a finite set of sequential integers. (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem elfzd (ph: wff) (K M N: class):
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wcel K cz) $ >
  $ wi ph (wbr M K cle) $ >
  $ wi ph (wbr K N cle) $ >
  $ wi ph (wcel K (co M N cfz)) $;

--| Membership in a finite set of sequential integers. (Contributed by NM, 26-Dec-2005.)
theorem elfz5 (K M N: class):
  $ wi (wa (wcel K (cfv M cuz)) (wcel N cz)) (wb (wcel K (co M N cfz)) (wbr K N cle)) $;

--| Membership in a finite set of sequential integers. (Contributed by NM, 21-Jul-2005.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem elfz4 (K M N: class):
  $ wi (wa (w3a (wcel M cz) (wcel N cz) (wcel K cz)) (wa (wbr M K cle) (wbr K N cle))) (wcel K (co M N cfz)) $;

--| Membership in a finite set of sequential integers in terms of sets of upper integers. (Contributed by NM, 18-Sep-2005.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem elfzuzb (K M N: class):
  $ wb (wcel K (co M N cfz)) (wa (wcel K (cfv M cuz)) (wcel N (cfv K cuz))) $;

--| Membership in a finite set of sequential integers. (Contributed by NM, 4-Oct-2005.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem eluzfz (K M N: class):
  $ wi (wa (wcel K (cfv M cuz)) (wcel N (cfv K cuz))) (wcel K (co M N cfz)) $;

--| A member of a finite set of sequential integers belongs to an upper set of integers. (Contributed by NM, 17-Sep-2005.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem elfzuz (K M N: class):
  $ wi (wcel K (co M N cfz)) (wcel K (cfv M cuz)) $;

--| Membership in a finite set of sequential integers implies membership in an upper set of integers. (Contributed by NM, 28-Sep-2005.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem elfzuz3 (K M N: class):
  $ wi (wcel K (co M N cfz)) (wcel N (cfv K cuz)) $;

--| Membership in a finite set of sequential integer implies the upper bound is an integer. (Contributed by NM, 6-Sep-2005.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem elfzel2 (K M N: class):
  $ wi (wcel K (co M N cfz)) (wcel N cz) $;

--| Membership in a finite set of sequential integer implies the lower bound is an integer. (Contributed by NM, 6-Sep-2005.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem elfzel1 (K M N: class):
  $ wi (wcel K (co M N cfz)) (wcel M cz) $;

--| A member of a finite set of sequential integers is an integer. (Contributed by NM, 6-Sep-2005.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem elfzelz (K M N: class):
  $ wi (wcel K (co M N cfz)) (wcel K cz) $;

--| A member of a finite set of sequential integers is an integer. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem elfzelzd (ph: wff) (K M N: class):
  $ wi ph (wcel K (co M N cfz)) $ >
  $ wi ph (wcel K cz) $;

--| A finite sequence of integers is a set of integers. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem fzssz (M N: class):
  $ wss (co M N cfz) cz $;

--| A finite sequence of integers is a set of real numbers. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem fzssre (M N: class):
  $ wss (co M N cfz) cr $;

--| A member of a finite set of sequential integer is greater than or equal to the lower bound. (Contributed by NM, 6-Sep-2005.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem elfzle1 (K M N: class):
  $ wi (wcel K (co M N cfz)) (wbr M K cle) $;

--| A member of a finite set of sequential integer is less than or equal to the upper bound. (Contributed by NM, 6-Sep-2005.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem elfzle2 (K M N: class):
  $ wi (wcel K (co M N cfz)) (wbr K N cle) $;

--| Implication of membership in a finite set of sequential integers. (Contributed by NM, 20-Sep-2005.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem elfzuz2 (K M N: class):
  $ wi (wcel K (co M N cfz)) (wcel N (cfv M cuz)) $;

--| Membership in a finite set of sequential integer implies the bounds are comparable. (Contributed by NM, 18-Sep-2005.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem elfzle3 (K M N: class):
  $ wi (wcel K (co M N cfz)) (wbr M N cle) $;

--| Membership in a finite set of sequential integers - special case. (Contributed by NM, 21-Jul-2005.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem eluzfz1 (M N: class):
  $ wi (wcel N (cfv M cuz)) (wcel M (co M N cfz)) $;

--| Membership in a finite set of sequential integers - special case. (Contributed by NM, 13-Sep-2005.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem eluzfz2 (M N: class):
  $ wi (wcel N (cfv M cuz)) (wcel N (co M N cfz)) $;

--| Membership in a finite set of sequential integers - special case. (Contributed by NM, 14-Sep-2005.)
theorem eluzfz2b (M N: class):
  $ wb (wcel N (cfv M cuz)) (wcel N (co M N cfz)) $;

--| Membership in a finite set of sequential integers containing one integer. (Contributed by NM, 21-Jul-2005.)
theorem elfz3 (N: class):
  $ wi (wcel N cz) (wcel N (co N N cfz)) $;

--| Membership in a finite set of sequential integers containing one integer. (Contributed by NM, 19-Sep-2005.)
theorem elfz1eq (K N: class):
  $ wi (wcel K (co N N cfz)) (wceq K N) $;

--| If there is a member in a finite set of sequential integers, the upper bound is also a member of this finite set of sequential integers. (Contributed by Alexander van der Vekens, 31-May-2018.)
theorem elfzubelfz (K M N: class):
  $ wi (wcel K (co M N cfz)) (wcel N (co M N cfz)) $;

--| A Peano-postulate-like theorem for downward closure of a finite set of sequential integers. (Contributed by Mario Carneiro, 27-May-2014.)
theorem peano2fzr (K M N: class):
  $ wi (wa (wcel K (cfv M cuz)) (wcel (co K c1 caddc) (co M N cfz))) (wcel K (co M N cfz)) $;

--| Properties of a finite interval of integers which is nonempty. (Contributed by Jeff Madsen, 17-Jun-2010.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem fzn0 (M N: class):
  $ wb (wne (co M N cfz) c0) (wcel N (cfv M cuz)) $;

--| A finite set of sequential integers is empty if its bounds are not integers. (Contributed by AV, 13-Oct-2018.)
theorem fz0 (M N: class):
  $ wi (wo (wnel M cz) (wnel N cz)) (wceq (co M N cfz) c0) $;

--| A finite set of sequential integers is empty if the bounds are reversed. (Contributed by NM, 22-Aug-2005.)
theorem fzn (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wbr N M clt) (wceq (co M N cfz) c0)) $;

--| A shifted finite set of sequential integers is equinumerous to the original set. (Contributed by Paul Chapman, 11-Apr-2009.)
theorem fzen (K M N: class):
  $ wi (w3a (wcel M cz) (wcel N cz) (wcel K cz)) (wbr (co M N cfz) (co (co M K caddc) (co N K caddc) cfz) cen) $;

--| A 1-based finite set of sequential integers is empty iff it ends at index ` 0 ` . (Contributed by Paul Chapman, 22-Jun-2011.)
theorem fz1n (N: class):
  $ wi (wcel N cn0) (wb (wceq (co c1 N cfz) c0) (wceq N cc0)) $;

--| 0 is not an element of a finite interval of integers starting at 1. (Contributed by AV, 27-Aug-2020.)
theorem _0nelfz1 (N: class):
  $ wnel cc0 (co c1 N cfz) $;

--| Two ways to say a finite 1-based sequence is empty. (Contributed by Paul Chapman, 26-Oct-2012.)
theorem _0fz1 (F N: class):
  $ wi (wa (wcel N cn0) (wfn F (co c1 N cfz))) (wb (wceq F c0) (wceq N cc0)) $;

--| There are no integers between 1 and 0. (Contributed by Jeff Madsen, 16-Jun-2010.) (Proof shortened by Mario Carneiro, 28-Apr-2015.)
theorem fz10:
  $ wceq (co c1 cc0 cfz) c0 $;

--| There are no integers between 0 and minus 1. (Contributed by Scott Fenton, 5-Jan-2018.)
theorem fz00m1:
  $ wceq (co cc0 (co cc0 c1 cmin) cfz) c0 $;

--| Membership of an integer greater than L decreased by ( L - M ) in an M-based finite set of sequential integers. (Contributed by Alexander van der Vekens, 14-Sep-2018.)
theorem uzsubsubfz (L M N: class):
  $ wi (wa (wcel L (cfv M cuz)) (wcel N (cfv L cuz))) (wcel (co N (co L M cmin) cmin) (co M N cfz)) $;

--| Membership of an integer greater than L decreased by ( L - 1 ) in a 1-based finite set of sequential integers. (Contributed by Alexander van der Vekens, 14-Sep-2018.)
theorem uzsubsubfz1 (L N: class):
  $ wi (wa (wcel L cn) (wcel N (cfv L cuz))) (wcel (co N (co L c1 cmin) cmin) (co c1 N cfz)) $;

--| Membership of an integer greater than 2 decreased by 2 in a 1-based finite set of sequential integers. (Contributed by Alexander van der Vekens, 14-Sep-2018.)
theorem ige3m2fz (N: class):
  $ wi (wcel N (cfv c3 cuz)) (wcel (co N c2 cmin) (co c1 N cfz)) $;

--| Split a finite interval of integers into two parts. (Contributed by Mario Carneiro, 13-Apr-2016.)
theorem fzsplit2 (K M N: class):
  $ wi (wa (wcel (co K c1 caddc) (cfv M cuz)) (wcel N (cfv K cuz))) (wceq (co M N cfz) (cun (co M K cfz) (co (co K c1 caddc) N cfz))) $;

--| Split a finite interval of integers into two parts. (Contributed by Jeff Madsen, 17-Jun-2010.) (Revised by Mario Carneiro, 13-Apr-2016.)
theorem fzsplit (K M N: class):
  $ wi (wcel K (co M N cfz)) (wceq (co M N cfz) (cun (co M K cfz) (co (co K c1 caddc) N cfz))) $;

--| Condition for two finite intervals of integers to be disjoint. (Contributed by Jeff Madsen, 17-Jun-2010.)
theorem fzdisj (J K M N: class):
  $ wi (wbr K M clt) (wceq (cin (co J K cfz) (co M N cfz)) c0) $;

--| 0-based and 1-based finite sets of sequential integers are equinumerous. (Contributed by Paul Chapman, 11-Apr-2009.)
theorem fz01en (N: class):
  $ wi (wcel N cz) (wbr (co cc0 (co N c1 cmin) cfz) (co c1 N cfz) cen) $;

--| A member of a finite set of sequential integers starting at 1 is a positive integer. (Contributed by NM, 24-Aug-2005.)
theorem elfznn (K N: class):
  $ wi (wcel K (co c1 N cfz)) (wcel K cn) $;

--| A nonempty finite range of integers contains its end point. (Contributed by Stefan O'Rear, 10-Oct-2014.)
theorem elfz1end (A2: class):
  $ wb (wcel A2 cn) (wcel A2 (co c1 A2 cfz)) $;

--| A finite set of positive integers is a set of positive integers. (Contributed by Stefan O'Rear, 16-Oct-2014.)
theorem fz1ssnn (A2: class):
  $ wss (co c1 A2 cfz) cn $;

--| Subtraction closure for a member of a finite set of sequential integers. (Contributed by NM, 16-Sep-2005.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem fznn0sub (K M N: class):
  $ wi (wcel K (co M N cfz)) (wcel (co N K cmin) cn0) $;

--| Subtracting the difference of a member of a finite range of integers and the lower bound of the range from the difference of the upper bound and the lower bound of the range results in the difference of the upper bound of the range and the member. (Contributed by Alexander van der Vekens, 27-May-2018.)
theorem fzmmmeqm (L M N: class):
  $ wi (wcel M (co L N cfz)) (wceq (co (co N L cmin) (co M L cmin) cmin) (co N M cmin)) $;

--| Membership of a sum in a finite set of sequential integers. (Contributed by NM, 30-Jul-2005.)
theorem fzaddel (J K M N: class):
  $ wi (wa (wa (wcel M cz) (wcel N cz)) (wa (wcel J cz) (wcel K cz))) (wb (wcel J (co M N cfz)) (wcel (co J K caddc) (co (co M K caddc) (co N K caddc) cfz))) $;

--| Membership of a sum in a finite interval of integers. (Contributed by Jeff Madsen, 17-Jun-2010.)
theorem fzadd2 (P J K M N O: class):
  $ wi (wa (wa (wcel M cz) (wcel N cz)) (wa (wcel O cz) (wcel P cz))) (wi (wa (wcel J (co M N cfz)) (wcel K (co O P cfz))) (wcel (co J K caddc) (co (co M O caddc) (co N P caddc) cfz))) $;

--| Membership of a difference in a finite set of sequential integers. (Contributed by NM, 30-Jul-2005.)
theorem fzsubel (J K M N: class):
  $ wi (wa (wa (wcel M cz) (wcel N cz)) (wa (wcel J cz) (wcel K cz))) (wb (wcel J (co M N cfz)) (wcel (co J K cmin) (co (co M K cmin) (co N K cmin) cfz))) $;

--| A finite set of sequential integers has the ordered pair property (compare ~ opth ) under certain conditions. (Contributed by NM, 31-Oct-2005.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem fzopth (J K M N: class):
  $ wi (wcel N (cfv M cuz)) (wb (wceq (co M N cfz) (co J K cfz)) (wa (wceq M J) (wceq N K))) $;

--| Two ways to express a nondecreasing sequence of four integers. (Contributed by Stefan O'Rear, 15-Aug-2015.)
theorem fzass4 (A2 B2 C D: class):
  $ wb (wa (wcel B2 (co A2 D cfz)) (wcel C (co B2 D cfz))) (wa (wcel B2 (co A2 C cfz)) (wcel C (co A2 D cfz))) $;

--| Subset relationship for finite sets of sequential integers. (Contributed by NM, 28-Sep-2005.) (Proof shortened by Mario Carneiro, 28-Apr-2015.)
theorem fzss1 (K M N: class):
  $ wi (wcel K (cfv M cuz)) (wss (co K N cfz) (co M N cfz)) $;

--| Subset relationship for finite sets of sequential integers. (Contributed by NM, 4-Oct-2005.) (Revised by Mario Carneiro, 30-Apr-2015.)
theorem fzss2 (K M N: class):
  $ wi (wcel N (cfv K cuz)) (wss (co M K cfz) (co M N cfz)) $;

--| A finite set of sequential integers is a subset of an upper set of integers. (Contributed by NM, 28-Oct-2005.)
theorem fzssuz (M N: class):
  $ wss (co M N cfz) (cfv M cuz) $;

--| A finite interval of integers with one element. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem fzsn (M: class):
  $ wi (wcel M cz) (wceq (co M M cfz) (csn M)) $;

--| Subset relationship for finite sets of sequential integers. (Contributed by NM, 21-Jul-2005.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem fzssp1 (M N: class):
  $ wss (co M N cfz) (co M (co N c1 caddc) cfz) $;

--| Finite sets of sequential integers starting from a natural are a subset of the positive integers. (Contributed by Thierry Arnoux, 4-Aug-2017.)
theorem fzssnn (M N: class):
  $ wi (wcel M cn) (wss (co M N cfz) cn) $;

--| A subset of a finite sequence of integers extended by an integer is a subset of a (possibly extended) finite sequence of integers. (Contributed by AV, 13-Nov-2021.)
theorem ssfzunsnext (S I M N: class):
  $ wi (wa (wss S (co M N cfz)) (w3a (wcel M cz) (wcel N cz) (wcel I cz))) (wss (cun S (csn I)) (co (cif (wbr I M cle) I M) (cif (wbr I N cle) N I) cfz)) $;

--| A subset of a finite sequence of integers extended by an integer is a subset of a (possibly extended) finite sequence of integers. (Contributed by AV, 8-Jun-2021.) (Proof shortened by AV, 13-Nov-2021.)
theorem ssfzunsn (S I M N: class):
  $ wi (w3a (wss S (co M N cfz)) (wcel N cz) (wcel I (cfv M cuz))) (wss (cun S (csn I)) (co M (cif (wbr I N cle) N I) cfz)) $;

--| Join a successor to the end of a finite set of sequential integers. (Contributed by NM, 19-Jul-2008.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem fzsuc (M N: class):
  $ wi (wcel N (cfv M cuz)) (wceq (co M (co N c1 caddc) cfz) (cun (co M N cfz) (csn (co N c1 caddc)))) $;

--| Join a predecessor to the beginning of a finite set of sequential integers. (Contributed by AV, 24-Aug-2019.)
theorem fzpred (M N: class):
  $ wi (wcel N (cfv M cuz)) (wceq (co M N cfz) (cun (csn M) (co (co M c1 caddc) N cfz))) $;

--| A finite set of sequential integers is disjoint with its predecessor. (Contributed by AV, 24-Aug-2019.)
theorem fzpreddisj (M N: class):
  $ wi (wcel N (cfv M cuz)) (wceq (cin (csn M) (co (co M c1 caddc) N cfz)) c0) $;

--| Append an element to a finite set of sequential integers. (Contributed by NM, 19-Sep-2005.) (Proof shortened by Mario Carneiro, 28-Apr-2015.)
theorem elfzp1 (K M N: class):
  $ wi (wcel N (cfv M cuz)) (wb (wcel K (co M (co N c1 caddc) cfz)) (wo (wcel K (co M N cfz)) (wceq K (co N c1 caddc)))) $;

--| Subset relationship for finite sets of sequential integers. (Contributed by NM, 26-Jul-2005.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem fzp1ss (M N: class):
  $ wi (wcel M cz) (wss (co (co M c1 caddc) N cfz) (co M N cfz)) $;

--| Membership in a set of sequential integers with an appended element. (Contributed by NM, 7-Dec-2005.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem fzelp1 (K M N: class):
  $ wi (wcel K (co M N cfz)) (wcel K (co M (co N c1 caddc) cfz)) $;

--| Add one to an element of a finite set of integers. (Contributed by Jeff Madsen, 6-Jun-2010.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem fzp1elp1 (K M N: class):
  $ wi (wcel K (co M N cfz)) (wcel (co K c1 caddc) (co M (co N c1 caddc) cfz)) $;

--| Shift membership in a finite sequence of naturals. (Contributed by Scott Fenton, 17-Jul-2013.)
theorem fznatpl1 (I N: class):
  $ wi (wa (wcel N cn) (wcel I (co c1 (co N c1 cmin) cfz))) (wcel (co I c1 caddc) (co c1 N cfz)) $;

--| A finite interval of integers with two elements. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem fzpr (M: class):
  $ wi (wcel M cz) (wceq (co M (co M c1 caddc) cfz) (cpr M (co M c1 caddc))) $;

--| A finite interval of integers with three elements. (Contributed by NM, 13-Sep-2011.) (Revised by Mario Carneiro, 7-Mar-2014.)
theorem fztp (M: class):
  $ wi (wcel M cz) (wceq (co M (co M c2 caddc) cfz) (ctp M (co M c1 caddc) (co M c2 caddc))) $;

--| An integer range between 1 and 2 is a pair. (Contributed by AV, 11-Jan-2023.)
theorem fz12pr:
  $ wceq (co c1 c2 cfz) (cpr c1 c2) $;

--| Join a successor to the end of a finite set of sequential integers. (Contributed by Mario Carneiro, 7-Mar-2014.)
theorem fzsuc2 (M N: class):
  $ wi (wa (wcel M cz) (wcel N (cfv (co M c1 cmin) cuz))) (wceq (co M (co N c1 caddc) cfz) (cun (co M N cfz) (csn (co N c1 caddc)))) $;

--| ` ( M ... ( N + 1 ) ) ` is the disjoint union of ` ( M ... N ) ` with ` { ( N + 1 ) } ` . (Contributed by Mario Carneiro, 7-Mar-2014.)
theorem fzp1disj (M N: class):
  $ wceq (cin (co M N cfz) (csn (co N c1 caddc))) c0 $;

--| Remove a successor from the end of a finite set of sequential integers. (Contributed by AV, 4-Sep-2019.)
theorem fzdifsuc (M N: class):
  $ wi (wcel N (cfv M cuz)) (wceq (co M N cfz) (cdif (co M (co N c1 caddc) cfz) (csn (co N c1 caddc)))) $;

--| Two ways of defining the first two values of a sequence on ` NN ` . (Contributed by NM, 5-Sep-2011.)
theorem fzprval {x3: setvar} (A2 B2 F: class):
  $ wb (wral x3 (wceq (cfv (cv x3) F) (cif (wceq (cv x3) c1) A2 B2)) (co c1 c2 cfz)) (wa (wceq (cfv c1 F) A2) (wceq (cfv c2 F) B2)) $;

--| Two ways of defining the first three values of a sequence on ` NN ` . (Contributed by NM, 13-Sep-2011.)
theorem fztpval {x3: setvar} (A2 B2 C F: class):
  $ wb (wral x3 (wceq (cfv (cv x3) F) (cif (wceq (cv x3) c1) A2 (cif (wceq (cv x3) c2) B2 C))) (co c1 c3 cfz)) (w3a (wceq (cfv c1 F) A2) (wceq (cfv c2 F) B2) (wceq (cfv c3 F) C)) $;

--| Reversal of start and end of a finite set of sequential integers. (Contributed by NM, 25-Nov-2005.)
theorem fzrev (J K M N: class):
  $ wi (wa (wa (wcel M cz) (wcel N cz)) (wa (wcel J cz) (wcel K cz))) (wb (wcel K (co (co J N cmin) (co J M cmin) cfz)) (wcel (co J K cmin) (co M N cfz))) $;

--| Reversal of start and end of a finite set of sequential integers. (Contributed by NM, 25-Nov-2005.)
theorem fzrev2 (J K M N: class):
  $ wi (wa (wa (wcel M cz) (wcel N cz)) (wa (wcel J cz) (wcel K cz))) (wb (wcel K (co M N cfz)) (wcel (co J K cmin) (co (co J N cmin) (co J M cmin) cfz))) $;

--| Reversal of start and end of a finite set of sequential integers. (Contributed by NM, 25-Nov-2005.)
theorem fzrev2i (J K M N: class):
  $ wi (wa (wcel J cz) (wcel K (co M N cfz))) (wcel (co J K cmin) (co (co J N cmin) (co J M cmin) cfz)) $;

--| The "complement" of a member of a finite set of sequential integers. (Contributed by NM, 20-Nov-2005.)
theorem fzrev3 (K M N: class):
  $ wi (wcel K cz) (wb (wcel K (co M N cfz)) (wcel (co (co M N caddc) K cmin) (co M N cfz))) $;

--| The "complement" of a member of a finite set of sequential integers. (Contributed by NM, 20-Nov-2005.)
theorem fzrev3i (K M N: class):
  $ wi (wcel K (co M N cfz)) (wcel (co (co M N caddc) K cmin) (co M N cfz)) $;

--| Finite set of sequential integers starting at 1. (Contributed by NM, 31-Aug-2011.) (Revised by Mario Carneiro, 18-Jun-2015.)
theorem fznn (K N: class):
  $ wi (wcel N cz) (wb (wcel K (co c1 N cfz)) (wa (wcel K cn) (wbr K N cle))) $;

--| Membership in a 1-based finite set of sequential integers. (Contributed by AV, 30-Oct-2018.) (Proof shortened by AV, 23-Jan-2022.)
theorem elfz1b (M N: class):
  $ wb (wcel N (co c1 M cfz)) (w3a (wcel N cn) (wcel M cn) (wbr N M cle)) $;

--| Membership in a 1-based finite set of sequential integers with an upper integer. (Contributed by AV, 23-Jan-2022.)
theorem elfz1uz (M N: class):
  $ wi (wa (wcel N cn) (wcel M (cfv N cuz))) (wcel N (co c1 M cfz)) $;

--| Membership in a finite set of sequential integers. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem elfzm11 (K M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wcel K (co M (co N c1 cmin) cfz)) (w3a (wcel K cz) (wbr M K cle) (wbr K N clt))) $;

--| Express an upper integer set as the disjoint (see ~ uzdisj ) union of the first ` N ` values and the rest. (Contributed by Mario Carneiro, 24-Apr-2014.)
theorem uzsplit (M N: class):
  $ wi (wcel N (cfv M cuz)) (wceq (cfv M cuz) (cun (co M (co N c1 cmin) cfz) (cfv N cuz))) $;

--| The first ` N ` elements of an upper integer set are distinct from any later members. (Contributed by Mario Carneiro, 24-Apr-2014.)
theorem uzdisj (M N: class):
  $ wceq (cin (co M (co N c1 cmin) cfz) (cfv N cuz)) c0 $;

--| Add/remove an item to/from the end of a finite sequence. (Contributed by Paul Chapman, 17-Nov-2012.) (Revised by Mario Carneiro, 7-Mar-2014.)
theorem fseq1p1m1 (A2 B2 F G H N: class):
  $ wceq H (csn (cop (co N c1 caddc) B2)) $ >
  $ wi (wcel N cn0) (wb (w3a (wf (co c1 N cfz) A2 F) (wcel B2 A2) (wceq G (cun F H))) (w3a (wf (co c1 (co N c1 caddc) cfz) A2 G) (wceq (cfv (co N c1 caddc) G) B2) (wceq F (cres G (co c1 N cfz))))) $;

--| Add/remove an item to/from the end of a finite sequence. (Contributed by Paul Chapman, 17-Nov-2012.)
theorem fseq1m1p1 (A2 B2 F G H N: class):
  $ wceq H (csn (cop N B2)) $ >
  $ wi (wcel N cn) (wb (w3a (wf (co c1 (co N c1 cmin) cfz) A2 F) (wcel B2 A2) (wceq G (cun F H))) (w3a (wf (co c1 N cfz) A2 G) (wceq (cfv N G) B2) (wceq F (cres G (co c1 (co N c1 cmin) cfz))))) $;

--| Quantification over a one-member finite set of sequential integers in terms of substitution. (Contributed by NM, 28-Nov-2005.)
theorem fz1sbc {k: setvar} (ph: wff k) (N: class):
  $ wi (wcel N cz) (wb (wral k ph (co N N cfz)) (wsbc k ph N)) $;

--| An integer is a member of a 0-based finite set of sequential integers iff its successor is a member of the corresponding 1-based set. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem elfzp1b (K N: class):
  $ wi (wa (wcel K cz) (wcel N cz)) (wb (wcel K (co cc0 (co N c1 cmin) cfz)) (wcel (co K c1 caddc) (co c1 N cfz))) $;

--| An integer is a member of a 1-based finite set of sequential integers iff its predecessor is a member of the corresponding 0-based set. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem elfzm1b (K N: class):
  $ wi (wa (wcel K cz) (wcel N cz)) (wb (wcel K (co c1 N cfz)) (wcel (co K c1 cmin) (co cc0 (co N c1 cmin) cfz))) $;

--| Options for membership in a finite interval of integers. (Contributed by Jeff Madsen, 18-Jun-2010.)
theorem elfzp12 (K M N: class):
  $ wi (wcel N (cfv M cuz)) (wb (wcel K (co M N cfz)) (wo (wceq K M) (wcel K (co (co M c1 caddc) N cfz)))) $;

--| Elementhood in a finite set of sequential integers, except its lower bound. (Contributed by Thierry Arnoux, 1-Jan-2024.)
theorem fzne1 (K M N: class):
  $ wi (wa (wcel K (co M N cfz)) (wne K M)) (wcel K (co (co M c1 caddc) N cfz)) $;

--| Split the first element of a finite set of sequential integers. More generic than ~ fzpred . Analogous to ~ fzdif2 . (Contributed by AV, 12-Sep-2025.)
theorem fzdif1 (M N: class):
  $ wi (wcel N (cfv M cuz)) (wceq (cdif (co M N cfz) (csn M)) (co (co M c1 caddc) N cfz)) $;

--| Split the first element of a finite set of sequential nonnegative integers. (Contributed by AV, 12-Sep-2025.)
theorem fz0dif1 (N: class):
  $ wi (wcel N cn0) (wceq (cdif (co cc0 N cfz) (csn cc0)) (co c1 N cfz)) $;

--| Choices for an element of a finite interval of integers. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem fzm1 (K M N: class):
  $ wi (wcel N (cfv M cuz)) (wb (wcel K (co M N cfz)) (wo (wcel K (co M (co N c1 cmin) cfz)) (wceq K N))) $;

--| No finite set of sequential integers equals an upper set of integers. (Contributed by NM, 11-Dec-2005.)
theorem fzneuz (K M N: class):
  $ wi (wa (wcel N (cfv M cuz)) (wcel K cz)) (wn (wceq (co M N cfz) (cfv K cuz))) $;

--| Disjointness of the upper integers and a finite sequence. (Contributed by Mario Carneiro, 30-Jun-2013.) (Revised by Mario Carneiro, 24-Aug-2013.)
theorem fznuz (K M N: class):
  $ wi (wcel K (co M N cfz)) (wn (wcel K (cfv (co N c1 caddc) cuz))) $;

--| Disjointness of the upper integers and a finite sequence. (Contributed by Mario Carneiro, 24-Aug-2013.)
theorem uznfz (K M N: class):
  $ wi (wcel K (cfv N cuz)) (wn (wcel K (co M (co N c1 cmin) cfz))) $;

--| One plus the upper bound of a finite set of integers is not a member of that set. (Contributed by Scott Fenton, 16-Dec-2017.)
theorem fzp1nel (M N: class):
  $ wn (wcel (co N c1 caddc) (co M N cfz)) $;

--| Reversal of scanning order inside of a universal quantification restricted to a finite set of sequential integers. (Contributed by NM, 25-Nov-2005.)
theorem fzrevral {j k: setvar} (ph: wff j) (K M N: class):
  $ wi (w3a (wcel M cz) (wcel N cz) (wcel K cz)) (wb (wral j ph (co M N cfz)) (wral k (wsbc j ph (co K (cv k) cmin)) (co (co K N cmin) (co K M cmin) cfz))) $;

--| Reversal of scanning order inside of a universal quantification restricted to a finite set of sequential integers. (Contributed by NM, 25-Nov-2005.)
theorem fzrevral2 {j k: setvar} (ph: wff j) (K M N: class):
  $ wi (w3a (wcel M cz) (wcel N cz) (wcel K cz)) (wb (wral j ph (co (co K N cmin) (co K M cmin) cfz)) (wral k (wsbc j ph (co K (cv k) cmin)) (co M N cfz))) $;

--| Reversal of scanning order inside of a universal quantification restricted to a finite set of sequential integers. (Contributed by NM, 20-Nov-2005.)
theorem fzrevral3 {j k: setvar} (ph: wff j) (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wral j ph (co M N cfz)) (wral k (wsbc j ph (co (co M N caddc) (cv k) cmin)) (co M N cfz))) $;

--| Shift the scanning order inside of a universal quantification restricted to a finite set of sequential integers. (Contributed by NM, 27-Nov-2005.)
theorem fzshftral {j k: setvar} (ph: wff j) (K M N: class):
  $ wi (w3a (wcel M cz) (wcel N cz) (wcel K cz)) (wb (wral j ph (co M N cfz)) (wral k (wsbc j ph (co (cv k) K cmin)) (co (co M K caddc) (co N K caddc) cfz))) $;

--| Membership of an integer greater than 1 decreased by 1 in a 1-based finite set of sequential integers. (Contributed by Alexander van der Vekens, 14-Sep-2018.)
theorem ige2m1fz1 (N: class):
  $ wi (wcel N (cfv c2 cuz)) (wcel (co N c1 cmin) (co c1 N cfz)) $;

--| Membership in a 0-based finite set of sequential integers. (Contributed by Alexander van der Vekens, 18-Jun-2018.) (Proof shortened by Alexander van der Vekens, 15-Sep-2018.)
theorem ige2m1fz (N: class):
  $ wi (wa (wcel N cn0) (wbr c2 N cle)) (wcel (co N c1 cmin) (co cc0 N cfz)) $;

--| Membership in a finite set of sequential nonnegative integers. (Contributed by NM, 16-Sep-2005.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem elfz2nn0 (K N: class):
  $ wb (wcel K (co cc0 N cfz)) (w3a (wcel K cn0) (wcel N cn0) (wbr K N cle)) $;

--| Characterization of a finite set of sequential nonnegative integers. (Contributed by NM, 1-Aug-2005.)
theorem fznn0 (K N: class):
  $ wi (wcel N cn0) (wb (wcel K (co cc0 N cfz)) (wa (wcel K cn0) (wbr K N cle))) $;

--| A member of a finite set of sequential nonnegative integers is a nonnegative integer. (Contributed by NM, 5-Aug-2005.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem elfznn0 (K N: class):
  $ wi (wcel K (co cc0 N cfz)) (wcel K cn0) $;

--| The upper bound of a nonempty finite set of sequential nonnegative integers is a nonnegative integer. (Contributed by NM, 16-Sep-2005.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem elfz3nn0 (K N: class):
  $ wi (wcel K (co cc0 N cfz)) (wcel N cn0) $;

--| Finite sets of sequential nonnegative integers starting with 0 are subsets of NN0. (Contributed by JJ, 1-Jun-2021.)
theorem fz0ssnn0 (N: class):
  $ wss (co cc0 N cfz) cn0 $;

--| Subset relationship for finite sets of sequential integers. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem fz1ssfz0 (N: class):
  $ wss (co c1 N cfz) (co cc0 N cfz) $;

--| 0 is an element of a finite set of sequential nonnegative integers with a nonnegative integer as upper bound. (Contributed by AV, 6-Apr-2018.)
theorem _0elfz (N: class):
  $ wi (wcel N cn0) (wcel cc0 (co cc0 N cfz)) $;

--| A nonnegative integer is always part of the finite set of sequential nonnegative integers with this integer as upper bound. (Contributed by Scott Fenton, 21-Mar-2018.)
theorem nn0fz0 (N: class):
  $ wb (wcel N cn0) (wcel N (co cc0 N cfz)) $;

--| An element of a finite set of sequential nonnegative integers is an element of an extended finite set of sequential nonnegative integers. (Contributed by Alexander van der Vekens, 28-Mar-2018.) (Proof shortened by OpenAI, 25-Mar-2020.)
theorem elfz0add (A2 B2 N: class):
  $ wi (wa (wcel A2 cn0) (wcel B2 cn0)) (wi (wcel N (co cc0 A2 cfz)) (wcel N (co cc0 (co A2 B2 caddc) cfz))) $;

--| An integer range from 0 to 0 is a singleton. (Contributed by AV, 18-Apr-2021.)
theorem fz0sn:
  $ wceq (co cc0 cc0 cfz) (csn cc0) $;

--| An integer range from 0 to 2 is an unordered triple. (Contributed by Alexander van der Vekens, 1-Feb-2018.)
theorem fz0tp:
  $ wceq (co cc0 c2 cfz) (ctp cc0 c1 c2) $;

--| An integer range from 0 to 3 is the union of two unordered pairs. (Contributed by AV, 7-Feb-2021.)
theorem fz0to3un2pr:
  $ wceq (co cc0 c3 cfz) (cun (cpr cc0 c1) (cpr c2 c3)) $;

--| An integer range from 0 to 4 is the union of a triple and a pair. (Contributed by Alexander van der Vekens, 13-Aug-2017.) (Proof shortened by AV, 7-Aug-2025.)
theorem fz0to4untppr:
  $ wceq (co cc0 c4 cfz) (cun (ctp cc0 c1 c2) (cpr c3 c4)) $;

--| An integer range from 0 to 5 is the union of two triples. (Contributed by AV, 30-Jul-2025.)
theorem fz0to5un2tp:
  $ wceq (co cc0 c5 cfz) (cun (ctp cc0 c1 c2) (ctp c3 c4 c5)) $;

--| An element of a finite set of sequential nonnegative integers is an element of a finite set of sequential nonnegative integers with the upper bound being an element of the finite set of sequential nonnegative integers with the same lower bound as for the first interval and the element under consideration as upper bound. (Contributed by Alexander van der Vekens, 3-Apr-2018.)
theorem elfz0ubfz0 (K L N: class):
  $ wi (wa (wcel K (co cc0 N cfz)) (wcel L (co K N cfz))) (wcel K (co cc0 L cfz)) $;

--| A member of a finite set of sequential nonnegative integers is a member of a finite set of sequential nonnegative integers with a member of a finite set of sequential nonnegative integers starting at the upper bound of the first interval. (Contributed by Alexander van der Vekens, 27-May-2018.)
theorem elfz0fzfz0 (L M N X: class):
  $ wi (wa (wcel M (co cc0 L cfz)) (wcel N (co L X cfz))) (wcel M (co cc0 N cfz)) $;

--| If a member of a finite set of sequential integers with a lower bound being a member of a finite set of sequential nonnegative integers with the same upper bound, this member is also a member of the finite set of sequential nonnegative integers. (Contributed by Alexander van der Vekens, 21-Apr-2018.)
theorem fz0fzelfz0 (R M N: class):
  $ wi (wa (wcel N (co cc0 R cfz)) (wcel M (co N R cfz))) (wcel M (co cc0 R cfz)) $;

--| Subtraction closure for a member of a finite set of sequential nonnegative integers. (Contributed by NM, 26-Sep-2005.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem fznn0sub2 (K N: class):
  $ wi (wcel K (co cc0 N cfz)) (wcel (co N K cmin) (co cc0 N cfz)) $;

--| Membership of an integer greater than L decreased by L in a finite set of sequential nonnegative integers. (Contributed by Alexander van der Vekens, 16-Sep-2018.)
theorem uzsubfz0 (L N: class):
  $ wi (wa (wcel L cn0) (wcel N (cfv L cuz))) (wcel (co N L cmin) (co cc0 N cfz)) $;

--| The difference of an integer in a finite set of sequential nonnegative integers and and an integer of a finite set of sequential integers with the same upper bound and the nonnegative integer as lower bound is a member of the finite set of sequential nonnegative integers. (Contributed by Alexander van der Vekens, 6-Jun-2018.)
theorem fz0fzdiffz0 (K M N: class):
  $ wi (wa (wcel M (co cc0 N cfz)) (wcel K (co M N cfz))) (wcel (co K M cmin) (co cc0 N cfz)) $;

--| Subtracting the lower bound of a finite set of sequential integers from an element of this set. (Contributed by Alexander van der Vekens, 29-Mar-2018.) (Proof shortened by OpenAI, 25-Mar-2020.)
theorem elfzmlbm (K M N: class):
  $ wi (wcel K (co M N cfz)) (wcel (co K M cmin) (co cc0 (co N M cmin) cfz)) $;

--| Subtracting the lower bound of a finite set of sequential integers from an element of this set. (Contributed by Alexander van der Vekens, 29-Mar-2018.)
theorem elfzmlbp (K M N: class):
  $ wi (wa (wcel N cz) (wcel K (co M (co M N caddc) cfz))) (wcel (co K M cmin) (co cc0 N cfz)) $;

--| Lemma for theorems about the central binomial coefficient. (Contributed by Mario Carneiro, 8-Mar-2014.) (Revised by Mario Carneiro, 2-Aug-2014.)
theorem fzctr (N: class):
  $ wi (wcel N cn0) (wcel N (co cc0 (co c2 N cmul) cfz)) $;

--| The difference of two integers from a finite set of sequential nonnegative integers is also element of this finite set of sequential integers. (Contributed by Alexander van der Vekens, 12-Jun-2018.)
theorem difelfzle (K M N: class):
  $ wi (w3a (wcel K (co cc0 N cfz)) (wcel M (co cc0 N cfz)) (wbr K M cle)) (wcel (co M K cmin) (co cc0 N cfz)) $;

--| The difference of two integers from a finite set of sequential nonnegative integers increased by the upper bound is also element of this finite set of sequential integers. (Contributed by Alexander van der Vekens, 12-Jun-2018.)
theorem difelfznle (K M N: class):
  $ wi (w3a (wcel K (co cc0 N cfz)) (wcel M (co cc0 N cfz)) (wn (wbr K M cle))) (wcel (co (co M N caddc) K cmin) (co cc0 N cfz)) $;

--| Express the set of nonnegative integers as the disjoint (see ~ nn0disj ) union of the first ` N + 1 ` values and the rest. (Contributed by AV, 8-Nov-2019.)
theorem nn0split (N: class):
  $ wi (wcel N cn0) (wceq cn0 (cun (co cc0 N cfz) (cfv (co N c1 caddc) cuz))) $;

--| The first ` N + 1 ` elements of the set of nonnegative integers are distinct from any later members. (Contributed by AV, 8-Nov-2019.)
theorem nn0disj (N: class):
  $ wceq (cin (co cc0 N cfz) (cfv (co N c1 caddc) cuz)) c0 $;

--| A finite set of sequential nonnegative integers is the union of the singleton containing 0 and a finite set of sequential positive integers. (Contributed by AV, 20-Mar-2021.)
theorem fz0sn0fz1 (N: class):
  $ wi (wcel N cn0) (wceq (co cc0 N cfz) (cun (csn cc0) (co c1 N cfz))) $;

--| The function value of a function from a finite interval of nonnegative integers. (Contributed by AV, 13-Feb-2021.)
theorem fvffz0 (P I N V: class):
  $ wi (wa (w3a (wcel N cn0) (wcel I cn0) (wbr I N clt)) (wf (co cc0 N cfz) V P)) (wcel (cfv I P) V) $;

--| A function on a singleton. (Contributed by Alexander van der Vekens, 3-Dec-2017.) (Proof shortened by AV, 18-Apr-2021.)
theorem _1fv (P N V: class):
  $ wi (wa (wcel N V) (wceq P (csn (cop cc0 N)))) (wa (wf (co cc0 cc0 cfz) V P) (wceq (cfv cc0 P) N)) $;

--| The first four function values of a word of length at least 4. (Contributed by Alexander van der Vekens, 18-Nov-2017.)
theorem _4fvwrd4 {a b c d: setvar} (P: class) (L: class a b c d) (V: class):
  $ wi (wa (wcel L (cfv c3 cuz)) (wf (co cc0 L cfz) V P)) (wrex a (wrex b (wrex c (wrex d (wa (wa (wceq (cfv cc0 P) (cv a)) (wceq (cfv c1 P) (cv b))) (wa (wceq (cfv c2 P) (cv c)) (wceq (cfv c3 P) (cv d)))) V) V) V) V) $;

--| Two functions over 0-based finite set of sequential integers are equal if and only if their domains have the same length and the function values are the same at each position. (Contributed by Alexander van der Vekens, 30-Jun-2018.)
theorem _2ffzeq {i: setvar} (P F M: class) (N X Y: class i):
  $ wi (w3a (wcel M cn0) (wf (co cc0 M cfz) X F) (wf (co cc0 N cfz) Y P)) (wb (wceq F P) (wa (wceq M N) (wral i (wceq (cfv (cv i) F) (cfv (cv i) P)) (co cc0 M cfz)))) $;

--| The value of the predecessor class over an upper integer set. (Contributed by Scott Fenton, 16-May-2014.)
theorem preduz (M N: class):
  $ wi (wcel N (cfv M cuz)) (wceq (cpred (cfv M cuz) clt N) (co M (co N c1 cmin) cfz)) $;

--| The value of the predecessor class over the naturals. (Contributed by Scott Fenton, 6-Aug-2013.)
theorem prednn (N: class):
  $ wi (wcel N cn) (wceq (cpred cn clt N) (co c1 (co N c1 cmin) cfz)) $;

--| The value of the predecessor class over ` NN0 ` . (Contributed by Scott Fenton, 9-May-2014.)
theorem prednn0 (N: class):
  $ wi (wcel N cn0) (wceq (cpred cn0 clt N) (co cc0 (co N c1 cmin) cfz)) $;

--| Calculate the predecessor of an integer under a finite set of integers. (Contributed by Scott Fenton, 8-Aug-2013.) (Proof shortened by Mario Carneiro, 3-May-2015.)
theorem predfz (K M N: class):
  $ wi (wcel K (co M N cfz)) (wceq (cpred (co M N cfz) clt K) (co M (co K c1 cmin) cfz)) $;

--| Syntax for half-open integer ranges.
term cfzo: class;

--| Define a function generating sets of integers using a _half-open_ range. Read ` ( M ..^ N ) ` as the integers from ` M ` up to, but not including, ` N ` ; contrast with ` ( M ... N ) ` ~ df-fz , which includes ` N ` . Not including the endpoint simplifies a number of formulas related to cardinality and splitting; contrast ~ fzosplit with ~ fzsplit , for instance. (Contributed by Stefan O'Rear, 14-Aug-2015.)
axiom df_fzo {m n: setvar}:
  $ wceq cfzo (cmpo m n cz cz (co (cv m) (co (cv n) c1 cmin) cfz)) $;

--| Functionality of the half-open integer set function. (Contributed by Stefan O'Rear, 14-Aug-2015.)
theorem fzof:
  $ wf (cxp cz cz) (cpw cz) cfzo $;

--| Reverse closure for half-open integer sets. (Contributed by Stefan O'Rear, 14-Aug-2015.)
theorem elfzoel1 (A2 B2 C: class):
  $ wi (wcel A2 (co B2 C cfzo)) (wcel B2 cz) $;

--| Reverse closure for half-open integer sets. (Contributed by Stefan O'Rear, 14-Aug-2015.)
theorem elfzoel2 (A2 B2 C: class):
  $ wi (wcel A2 (co B2 C cfzo)) (wcel C cz) $;

--| Reverse closure for half-open integer sets. (Contributed by Stefan O'Rear, 14-Aug-2015.)
theorem elfzoelz (A2 B2 C: class):
  $ wi (wcel A2 (co B2 C cfzo)) (wcel A2 cz) $;

--| Value of the half-open integer set in terms of the closed integer set. (Contributed by Stefan O'Rear, 14-Aug-2015.)
theorem fzoval (M N: class):
  $ wi (wcel N cz) (wceq (co M N cfzo) (co M (co N c1 cmin) cfz)) $;

--| Membership in a half-open finite set of integers. (Contributed by Stefan O'Rear, 15-Aug-2015.)
theorem elfzo (K M N: class):
  $ wi (w3a (wcel K cz) (wcel M cz) (wcel N cz)) (wb (wcel K (co M N cfzo)) (wa (wbr M K cle) (wbr K N clt))) $;

--| Membership in a half-open integer interval. (Contributed by Mario Carneiro, 29-Sep-2015.)
theorem elfzo2 (K M N: class):
  $ wb (wcel K (co M N cfzo)) (w3a (wcel K (cfv M cuz)) (wcel N cz) (wbr K N clt)) $;

--| Membership in a half-open integer interval. (Contributed by Glauco Siliprandi, 23-Oct-2021.)
theorem elfzod (ph: wff) (K M N: class):
  $ wi ph (wcel K (cfv M cuz)) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wbr K N clt) $ >
  $ wi ph (wcel K (co M N cfzo)) $;

--| Membership in a half-open integer interval. (Contributed by Mario Carneiro, 29-Sep-2015.)
theorem elfzouz (K M N: class):
  $ wi (wcel K (co M N cfzo)) (wcel K (cfv M cuz)) $;

--| An integer not being a member of a half-open finite set of integers. (Contributed by AV, 29-Apr-2020.)
theorem nelfzo (K M N: class):
  $ wi (w3a (wcel K cz) (wcel M cz) (wcel N cz)) (wb (wnel K (co M N cfzo)) (wo (wbr K M clt) (wbr N K cle))) $;

--| The left endpoint of a half-open integer interval is in the set iff the two arguments are integers with ` M < N ` . This provides an alternative notation for the "strict upper integer" predicate by analogy to the "weak upper integer" predicate ` M e. ( ZZ>= `` N ) ` . (Contributed by Mario Carneiro, 29-Sep-2015.)
theorem fzolb (M N: class):
  $ wb (wcel M (co M N cfzo)) (w3a (wcel M cz) (wcel N cz) (wbr M N clt)) $;

--| The left endpoint of a half-open integer interval is in the set iff the two arguments are integers with ` M < N ` . This provides an alternative notation for the "strict upper integer" predicate by analogy to the "weak upper integer" predicate ` M e. ( ZZ>= `` N ) ` . (Contributed by Mario Carneiro, 29-Sep-2015.)
theorem fzolb2 (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wcel M (co M N cfzo)) (wbr M N clt)) $;

--| A member in a half-open integer interval is greater than or equal to the lower bound. (Contributed by Stefan O'Rear, 15-Aug-2015.)
theorem elfzole1 (K M N: class):
  $ wi (wcel K (co M N cfzo)) (wbr M K cle) $;

--| A member in a half-open integer interval is less than the upper bound. (Contributed by Stefan O'Rear, 15-Aug-2015.)
theorem elfzolt2 (K M N: class):
  $ wi (wcel K (co M N cfzo)) (wbr K N clt) $;

--| Membership in a half-open integer interval implies that the bounds are unequal. (Contributed by Stefan O'Rear, 15-Aug-2015.)
theorem elfzolt3 (K M N: class):
  $ wi (wcel K (co M N cfzo)) (wbr M N clt) $;

--| A member in a half-open integer interval is less than the upper bound. (Contributed by Mario Carneiro, 29-Sep-2015.)
theorem elfzolt2b (K M N: class):
  $ wi (wcel K (co M N cfzo)) (wcel K (co K N cfzo)) $;

--| Membership in a half-open integer interval implies that the bounds are unequal. (Contributed by Mario Carneiro, 29-Sep-2015.)
theorem elfzolt3b (K M N: class):
  $ wi (wcel K (co M N cfzo)) (wcel M (co M N cfzo)) $;

--| A member in a half-open integer interval plus 1 is less than or equal to the upper bound. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem elfzop1le2 (K M N: class):
  $ wi (wcel K (co M N cfzo)) (wbr (co K c1 caddc) N cle) $;

--| A half-open range does not contain its right endpoint. (Contributed by Stefan O'Rear, 25-Aug-2015.)
theorem fzonel (A2 B2: class):
  $ wn (wcel B2 (co A2 B2 cfzo)) $;

--| The upper bound of a half-open range is greater than or equal to an element of the range. (Contributed by Mario Carneiro, 29-Sep-2015.)
theorem elfzouz2 (K M N: class):
  $ wi (wcel K (co M N cfzo)) (wcel N (cfv K cuz)) $;

--| A half-open range is contained in the corresponding closed range. (Contributed by Stefan O'Rear, 23-Aug-2015.)
theorem elfzofz (K M N: class):
  $ wi (wcel K (co M N cfzo)) (wcel K (co M N cfz)) $;

--| Express membership in a half-open integer interval in terms of the "less than or equal to" and "less than" predicates on integers, resp. ` K e. ( ZZ>= `` M ) <-> M <_ K ` , ` K e. ( K ..^ N ) <-> K < N ` . (Contributed by Mario Carneiro, 29-Sep-2015.)
theorem elfzo3 (K M N: class):
  $ wb (wcel K (co M N cfzo)) (wa (wcel K (cfv M cuz)) (wcel K (co K N cfzo))) $;

--| A half-open integer interval is nonempty iff it contains its left endpoint. (Contributed by Mario Carneiro, 29-Sep-2015.)
theorem fzon0 (M N: class):
  $ wb (wne (co M N cfzo) c0) (wcel M (co M N cfzo)) $;

--| A half-open range is contained in the corresponding closed range. (Contributed by Stefan O'Rear, 23-Aug-2015.) (Revised by Mario Carneiro, 29-Sep-2015.)
theorem fzossfz (A2 B2: class):
  $ wss (co A2 B2 cfzo) (co A2 B2 cfz) $;

--| A half-open integer interval is a set of integers. (Contributed by Glauco Siliprandi, 8-Apr-2021.)
theorem fzossz (M N: class):
  $ wss (co M N cfzo) cz $;

--| A half-open set of sequential integers is empty if the bounds are equal or reversed. (Contributed by Alexander van der Vekens, 30-Oct-2017.)
theorem fzon (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wbr N M cle) (wceq (co M N cfzo) c0)) $;

--| A half-open range of nonnegative integers is empty iff the upper bound is not positive. (Contributed by AV, 2-May-2020.)
theorem fzo0n (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wbr N M cle) (wceq (co cc0 (co N M cmin) cfzo) c0)) $;

--| A half-open integer range is empty if the bounds are equal or reversed. (Contributed by AV, 20-Oct-2018.)
theorem fzonlt0 (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wn (wbr M N clt)) (wceq (co M N cfzo) c0)) $;

--| Half-open sets with equal endpoints are empty. (Contributed by Stefan O'Rear, 15-Aug-2015.) (Revised by Mario Carneiro, 29-Sep-2015.)
theorem fzo0 (A2: class):
  $ wceq (co A2 A2 cfzo) c0 $;

--| If ` K < N ` then ` N - K ` is a positive integer. (Contributed by Mario Carneiro, 29-Sep-2015.) (Revised by Mario Carneiro, 1-Jan-2017.)
theorem fzonnsub (K M N: class):
  $ wi (wcel K (co M N cfzo)) (wcel (co N K cmin) cn) $;

--| If ` M < N ` then ` N - M ` is a positive integer. (Contributed by Mario Carneiro, 1-Jan-2017.)
theorem fzonnsub2 (K M N: class):
  $ wi (wcel K (co M N cfzo)) (wcel (co N M cmin) cn) $;

--| Subset relationship for half-open sequences of integers. (Contributed by Stefan O'Rear, 15-Aug-2015.) (Revised by Mario Carneiro, 29-Sep-2015.)
theorem fzoss1 (K M N: class):
  $ wi (wcel K (cfv M cuz)) (wss (co K N cfzo) (co M N cfzo)) $;

--| Subset relationship for half-open sequences of integers. (Contributed by Stefan O'Rear, 15-Aug-2015.) (Revised by Mario Carneiro, 29-Sep-2015.)
theorem fzoss2 (K M N: class):
  $ wi (wcel N (cfv K cuz)) (wss (co M K cfzo) (co M N cfzo)) $;

--| Subset of a half-open range. (Contributed by Alexander van der Vekens, 1-Nov-2017.)
theorem fzossrbm1 (N: class):
  $ wi (wcel N cz) (wss (co cc0 (co N c1 cmin) cfzo) (co cc0 N cfzo)) $;

--| Subset relationship for half-open integer ranges with lower bounds 0 and 1. (Contributed by Alexander van der Vekens, 18-Mar-2018.)
theorem fzo0ss1 (N: class):
  $ wss (co c1 N cfzo) (co cc0 N cfzo) $;

--| A half-open integer range starting at a nonnegative integer is a subset of the nonnegative integers. (Contributed by Alexander van der Vekens, 13-May-2018.)
theorem fzossnn0 (M N: class):
  $ wi (wcel M cn0) (wss (co M N cfzo) cn0) $;

--| One direction of splitting a half-open integer range in half. (Contributed by Stefan O'Rear, 14-Aug-2015.)
theorem fzospliti (A2 B2 C D: class):
  $ wi (wa (wcel A2 (co B2 C cfzo)) (wcel D cz)) (wo (wcel A2 (co B2 D cfzo)) (wcel A2 (co D C cfzo))) $;

--| Split a half-open integer range in half. (Contributed by Stefan O'Rear, 14-Aug-2015.)
theorem fzosplit (B2 C D: class):
  $ wi (wcel D (co B2 C cfz)) (wceq (co B2 C cfzo) (cun (co B2 D cfzo) (co D C cfzo))) $;

--| Abutting half-open integer ranges are disjoint. (Contributed by Stefan O'Rear, 14-Aug-2015.)
theorem fzodisj (A2 B2 C: class):
  $ wceq (cin (co A2 B2 cfzo) (co B2 C cfzo)) c0 $;

--| Split an upper integer set into a half-open integer range and another upper integer set. (Contributed by Mario Carneiro, 21-Sep-2016.)
theorem fzouzsplit (A2 B2: class):
  $ wi (wcel B2 (cfv A2 cuz)) (wceq (cfv A2 cuz) (cun (co A2 B2 cfzo) (cfv B2 cuz))) $;

--| A half-open integer range does not overlap the upper integer range starting at the endpoint of the first range. (Contributed by Mario Carneiro, 21-Sep-2016.)
theorem fzouzdisj (A2 B2: class):
  $ wceq (cin (co A2 B2 cfzo) (cfv B2 cuz)) c0 $;

--| A half-open integer range as union of two half-open integer ranges. (Contributed by AV, 23-Apr-2022.)
theorem fzoun (A2 B2 C: class):
  $ wi (wa (wcel B2 (cfv A2 cuz)) (wcel C cn0)) (wceq (co A2 (co B2 C caddc) cfzo) (cun (co A2 B2 cfzo) (co B2 (co B2 C caddc) cfzo))) $;

--| A half-open integer range and the singleton of its upper bound are disjoint. (Contributed by AV, 7-Mar-2021.)
theorem fzodisjsn (A2 B2: class):
  $ wceq (cin (co A2 B2 cfzo) (csn B2)) c0 $;

--| The intersection of a half-open integer range and the pair of its outer left borders is empty. (Contributed by AV, 9-Jan-2021.)
theorem prinfzo0 (M N: class):
  $ wi (wcel M cz) (wceq (cin (cpr M N) (co (co M c1 caddc) N cfzo)) c0) $;

--| An integer is strictly greater than zero iff it is a member of ` NN ` . (Contributed by Mario Carneiro, 29-Sep-2015.)
theorem lbfzo0 (A2: class):
  $ wb (wcel cc0 (co cc0 A2 cfzo)) (wcel A2 cn) $;

--| Membership in a half-open integer range based at 0. (Contributed by Stefan O'Rear, 15-Aug-2015.) (Revised by Mario Carneiro, 29-Sep-2015.)
theorem elfzo0 (A2 B2: class):
  $ wb (wcel A2 (co cc0 B2 cfzo)) (w3a (wcel A2 cn0) (wcel B2 cn) (wbr A2 B2 clt)) $;

--| Membership in a half-open range of nonnegative integers, generalization of ~ elfzo0 requiring the upper bound to be an integer only. (Contributed by Alexander van der Vekens, 23-Sep-2018.)
theorem elfzo0z (A2 B2: class):
  $ wb (wcel A2 (co cc0 B2 cfzo)) (w3a (wcel A2 cn0) (wcel B2 cz) (wbr A2 B2 clt)) $;

--| A nonnegative integer increased by 1 which is less than or equal to another integer is an element of a half-open range of integers. (Contributed by AV, 27-Feb-2021.)
theorem nn0p1elfzo (K N: class):
  $ wi (w3a (wcel K cn0) (wcel N cn0) (wbr (co K c1 caddc) N cle)) (wcel K (co cc0 N cfzo)) $;

--| A member in a half-open range of nonnegative integers is less than or equal to the upper bound of the range. (Contributed by Alexander van der Vekens, 23-Sep-2018.)
theorem elfzo0le (A2 B2: class):
  $ wi (wcel A2 (co cc0 B2 cfzo)) (wbr A2 B2 cle) $;

--| A member in a half-open integer interval is less than or equal to the upper bound minus 1 . (Contributed by Glauco Siliprandi, 17-Aug-2020.)
theorem elfzolem1 (K M N: class):
  $ wi (wcel K (co M N cfzo)) (wbr K (co N c1 cmin) cle) $;

--| The difference of the upper bound of a half-open range of nonnegative integers and an element of this range is greater than or equal to 1. (Contributed by AV, 1-Sep-2025.) (Proof shortened by SN, 18-Sep-2025.)
theorem elfzo0subge1 (A2 B2: class):
  $ wi (wcel A2 (co cc0 B2 cfzo)) (wbr c1 (co B2 A2 cmin) cle) $;

--| The difference of the upper bound of a half-open range of nonnegative integers and an element of this range is less than or equal to the upper bound. (Contributed by AV, 1-Sep-2025.) (Proof shortened by SN, 18-Sep-2025.)
theorem elfzo0suble (A2 B2: class):
  $ wi (wcel A2 (co cc0 B2 cfzo)) (wbr (co B2 A2 cmin) B2 cle) $;

--| A member of a half-open range of nonnegative integers is a nonnegative integer. (Contributed by Alexander van der Vekens, 21-May-2018.)
theorem elfzonn0 (K N: class):
  $ wi (wcel K (co cc0 N cfzo)) (wcel K cn0) $;

--| The result of subtracting a nonnegative integer from a positive integer and adding another nonnegative integer which is less than the first one is less than the positive integer. (Contributed by Alexander van der Vekens, 19-May-2018.)
theorem fzonmapblen (A2 B2 N: class):
  $ wi (w3a (wcel A2 (co cc0 N cfzo)) (wcel B2 (co cc0 N cfzo)) (wbr B2 A2 clt)) (wbr (co B2 (co N A2 cmin) caddc) N clt) $;

--| If a nonnegative integer in a finite interval of integers is not the upper bound of the interval, it is contained in the corresponding half-open integer range. (Contributed by Alexander van der Vekens, 15-Jun-2018.)
theorem fzofzim (K M: class):
  $ wi (wa (wne K M) (wcel K (co cc0 M cfz))) (wcel K (co cc0 M cfzo)) $;

--| Translation of one between closed and open integer ranges. (Contributed by Thierry Arnoux, 28-Jul-2020.)
theorem fz1fzo0m1 (M N: class):
  $ wi (wcel M (co c1 N cfz)) (wcel (co M c1 cmin) (co cc0 N cfzo)) $;

--| Half-open integer ranges starting with 1 are subsets of ` NN ` . (Contributed by Thierry Arnoux, 28-Dec-2016.)
theorem fzossnn (N: class):
  $ wss (co c1 N cfzo) cn $;

--| Membership in a half-open integer range based at 1. (Contributed by Thierry Arnoux, 14-Feb-2017.)
theorem elfzo1 (M N: class):
  $ wb (wcel N (co c1 M cfzo)) (w3a (wcel N cn) (wcel M cn) (wbr N M clt)) $;

--| 1 is the left endpoint of a half-open integer range based at 1 iff the right endpoint is an integer greater than 1. (Contributed by AV, 4-Sep-2025.)
theorem fzo1lb (N: class):
  $ wb (wcel c1 (co c1 N cfzo)) (wcel N (cfv c2 cuz)) $;

--| 1 is in a half-open range of positive integers iff its upper bound is greater than 1. (Contributed by AV, 22-Nov-2022.)
theorem _1elfzo1 (M: class):
  $ wb (wcel c1 (co c1 M cfzo)) (wa (wcel M cn) (wbr c1 M clt)) $;

--| An integer between 1 and an upper bound of a half-open integer range is not 0 and between 0 and the upper bound of the half-open integer range. (Contributed by Alexander van der Vekens, 21-Mar-2018.)
theorem fzo1fzo0n0 (K N: class):
  $ wb (wcel K (co c1 N cfzo)) (wa (wcel K (co cc0 N cfzo)) (wne K cc0)) $;

--| A half-open integer range based at 0 is nonempty precisely if the upper bound is a positive integer. (Contributed by Stefan O'Rear, 15-Aug-2015.) (Revised by Mario Carneiro, 29-Sep-2015.)
theorem fzo0n0 (A2: class):
  $ wb (wne (co cc0 A2 cfzo) c0) (wcel A2 cn) $;

--| Translate membership in a half-open integer range. (Contributed by Stefan O'Rear, 15-Aug-2015.)
theorem fzoaddel (A2 B2 C D: class):
  $ wi (wa (wcel A2 (co B2 C cfzo)) (wcel D cz)) (wcel (co A2 D caddc) (co (co B2 D caddc) (co C D caddc) cfzo)) $;

--| Translate membership in a 0-based half-open integer range. (Contributed by AV, 30-Apr-2020.)
theorem fzo0addel (A2 C D: class):
  $ wi (wa (wcel A2 (co cc0 C cfzo)) (wcel D cz)) (wcel (co A2 D caddc) (co D (co C D caddc) cfzo)) $;

--| Translate membership in a 0-based half-open integer range. (Contributed by AV, 30-Apr-2020.)
theorem fzo0addelr (A2 C D: class):
  $ wi (wa (wcel A2 (co cc0 C cfzo)) (wcel D cz)) (wcel (co A2 D caddc) (co D (co D C caddc) cfzo)) $;

--| Translate membership in a shifted-down half-open integer range. (Contributed by Stefan O'Rear, 15-Aug-2015.)
theorem fzoaddel2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 (co cc0 (co B2 C cmin) cfzo)) (wcel B2 cz) (wcel C cz)) (wcel (co A2 C caddc) (co C B2 cfzo)) $;

--| Membership of an integer in an extended open range of integers, extension added to the left. (Contributed by AV, 31-Aug-2025.) Generalized by replacing the left border of the ranges. (Revised by SN, 18-Sep-2025.)
theorem elfzoextl (I M N Z: class):
  $ wi (wa (wcel Z (co M N cfzo)) (wcel I cn0)) (wcel Z (co M (co I N caddc) cfzo)) $;

--| Membership of an integer in an extended open range of integers, extension added to the right. (Contributed by AV, 30-Apr-2020.) (Proof shortened by AV, 23-Sep-2025.)
theorem elfzoext (I M N Z: class):
  $ wi (wa (wcel Z (co M N cfzo)) (wcel I cn0)) (wcel Z (co M (co N I caddc) cfzo)) $;

--| Membership of an increased integer in a correspondingly extended half-open range of integers. (Contributed by AV, 30-Apr-2020.)
theorem elincfzoext (I M N Z: class):
  $ wi (wa (wcel Z (co M N cfzo)) (wcel I cn0)) (wcel (co Z I caddc) (co M (co N I caddc) cfzo)) $;

--| Translate membership in a half-open integer range. (Contributed by Stefan O'Rear, 15-Aug-2015.)
theorem fzosubel (A2 B2 C D: class):
  $ wi (wa (wcel A2 (co B2 C cfzo)) (wcel D cz)) (wcel (co A2 D cmin) (co (co B2 D cmin) (co C D cmin) cfzo)) $;

--| Membership in a translated half-open integer range implies translated membership in the original range. (Contributed by Stefan O'Rear, 15-Aug-2015.)
theorem fzosubel2 (A2 B2 C D: class):
  $ wi (wa (wcel A2 (co (co B2 C caddc) (co B2 D caddc) cfzo)) (w3a (wcel B2 cz) (wcel C cz) (wcel D cz))) (wcel (co A2 B2 cmin) (co C D cfzo)) $;

--| Membership in a translated half-open integer range when the original range is zero-based. (Contributed by Stefan O'Rear, 15-Aug-2015.)
theorem fzosubel3 (A2 B2 D: class):
  $ wi (wa (wcel A2 (co B2 (co B2 D caddc) cfzo)) (wcel D cz)) (wcel (co A2 B2 cmin) (co cc0 D cfzo)) $;

--| Membership of the difference of integers in a half-open range of nonnegative integers. (Contributed by Alexander van der Vekens, 17-Sep-2018.)
theorem eluzgtdifelfzo (A2 B2 N: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cz)) (wi (wa (wcel N (cfv A2 cuz)) (wbr B2 A2 clt)) (wcel (co N A2 cmin) (co cc0 (co N B2 cmin) cfzo))) $;

--| Membership of an integer greater than 1 decreased by 2 in a half-open range of nonnegative integers. (Contributed by Alexander van der Vekens, 3-Oct-2018.)
theorem ige2m2fzo (N: class):
  $ wi (wcel N (cfv c2 cuz)) (wcel (co N c2 cmin) (co cc0 (co N c1 cmin) cfzo)) $;

--| Translate membership in a half-open integer range. (Contributed by Thierry Arnoux, 28-Sep-2018.)
theorem fzocatel (A2 B2 C: class):
  $ wi (wa (wa (wcel A2 (co cc0 (co B2 C caddc) cfzo)) (wn (wcel A2 (co cc0 B2 cfzo)))) (wa (wcel B2 cz) (wcel C cz))) (wcel (co A2 B2 cmin) (co cc0 C cfzo)) $;

--| If an integer in a 1-based finite set of sequential integers is subtracted from the upper bound of this finite set of sequential integers, the result is contained in a half-open range of nonnegative integers with the same upper bound. (Contributed by AV, 18-Mar-2018.) (Revised by AV, 30-Oct-2018.)
theorem ubmelfzo (K N: class):
  $ wi (wcel K (co c1 N cfz)) (wcel (co N K cmin) (co cc0 N cfzo)) $;

--| If an integer is in a half-open range of nonnegative integers with a difference as upper bound, the sum of the integer with the subtrahend of the difference is in a half-open range of nonnegative integers containing the minuend of the difference. (Contributed by AV, 13-Nov-2018.)
theorem elfzodifsumelfzo (P I M N: class):
  $ wi (wa (wcel M (co cc0 N cfz)) (wcel N (co cc0 P cfz))) (wi (wcel I (co cc0 (co N M cmin) cfzo)) (wcel (co I M caddc) (co cc0 P cfzo))) $;

--| Membership of an integer incremented by one in a half-open range of nonnegative integers. (Contributed by Alexander van der Vekens, 24-Jun-2018.) (Proof shortened by AV, 5-Jan-2020.)
theorem elfzom1elp1fzo (I N: class):
  $ wi (wa (wcel N cz) (wcel I (co cc0 (co N c1 cmin) cfzo))) (wcel (co I c1 caddc) (co cc0 N cfzo)) $;

--| Membership in a half-open range of nonnegative integers. (Contributed by Alexander van der Vekens, 18-Jun-2018.)
theorem elfzom1elfzo (I N: class):
  $ wi (wa (wcel N cz) (wcel I (co cc0 (co N c1 cmin) cfzo))) (wcel I (co cc0 N cfzo)) $;

--| Expressing a closed integer range as a half-open integer range. (Contributed by Stefan O'Rear, 15-Aug-2015.)
theorem fzval3 (M N: class):
  $ wi (wcel N cz) (wceq (co M N cfz) (co M (co N c1 caddc) cfzo)) $;

--| Translate membership in a 0-based half-open integer range into membership in a 1-based finite sequence of integers. (Contributed by Alexander van der Vekens, 23-Nov-2017.)
theorem fz0add1fz1 (N X: class):
  $ wi (wa (wcel N cn0) (wcel X (co cc0 N cfzo))) (wcel (co X c1 caddc) (co c1 N cfz)) $;

--| Expressing a singleton as a half-open range. (Contributed by Stefan O'Rear, 23-Aug-2015.)
theorem fzosn (A2: class):
  $ wi (wcel A2 cz) (wceq (co A2 (co A2 c1 caddc) cfzo) (csn A2)) $;

--| Membership of an integer in the smallest open range of integers. (Contributed by Alexander van der Vekens, 22-Sep-2018.)
theorem elfzomin (Z: class):
  $ wi (wcel Z cz) (wcel Z (co Z (co Z c1 caddc) cfzo)) $;

--| Membership of an integer increased by a nonnegative integer in a half- open integer range. (Contributed by Alexander van der Vekens, 22-Sep-2018.)
theorem zpnn0elfzo (N Z: class):
  $ wi (wa (wcel Z cz) (wcel N cn0)) (wcel (co Z N caddc) (co Z (co (co Z N caddc) c1 caddc) cfzo)) $;

--| Membership of an integer increased by a nonnegative integer in a half- open integer range. (Contributed by Alexander van der Vekens, 22-Sep-2018.)
theorem zpnn0elfzo1 (N Z: class):
  $ wi (wa (wcel Z cz) (wcel N cn0)) (wcel (co Z N caddc) (co Z (co Z (co N c1 caddc) caddc) cfzo)) $;

--| Removing a singleton from a half-open integer range at the end. (Contributed by Alexander van der Vekens, 23-Mar-2018.)
theorem fzosplitsnm1 (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 (cfv (co A2 c1 caddc) cuz))) (wceq (co A2 B2 cfzo) (cun (co A2 (co B2 c1 cmin) cfzo) (csn (co B2 c1 cmin)))) $;

--| If an element of a half-open integer range is not less than the upper bound of the range decreased by 1, it must be equal to the upper bound of the range decreased by 1. (Contributed by AV, 3-Nov-2018.)
theorem elfzonlteqm1 (A2 B2: class):
  $ wi (wa (wcel A2 (co cc0 B2 cfzo)) (wn (wbr A2 (co B2 c1 cmin) clt))) (wceq A2 (co B2 c1 cmin)) $;

--| A nonnegative integer is an element of the half-open range of nonnegative integers with the element increased by one as an upper bound. (Contributed by Alexander van der Vekens, 5-Aug-2018.)
theorem fzonn0p1 (N: class):
  $ wi (wcel N cn0) (wcel N (co cc0 (co N c1 caddc) cfzo)) $;

--| A half-open range of nonnegative integers is a subset of a half-open range of nonnegative integers with the upper bound increased by one. (Contributed by Alexander van der Vekens, 5-Aug-2018.)
theorem fzossfzop1 (N: class):
  $ wi (wcel N cn0) (wss (co cc0 N cfzo) (co cc0 (co N c1 caddc) cfzo)) $;

--| If a nonnegative integer is an element of a half-open range of nonnegative integers, increasing this integer by one results in an element of a half- open range of nonnegative integers with the upper bound increased by one. (Contributed by Alexander van der Vekens, 5-Aug-2018.)
theorem fzonn0p1p1 (I N: class):
  $ wi (wcel I (co cc0 N cfzo)) (wcel (co I c1 caddc) (co cc0 (co N c1 caddc) cfzo)) $;

--| Increasing an element of a half-open range of nonnegative integers by 1 results in an element of the half-open range of nonnegative integers with an upper bound increased by 1. (Contributed by Alexander van der Vekens, 1-Aug-2018.) (Proof shortened by Thierry Arnoux, 14-Dec-2023.)
theorem elfzom1p1elfzo (N X: class):
  $ wi (wa (wcel N cn) (wcel X (co cc0 (co N c1 cmin) cfzo))) (wcel (co X c1 caddc) (co cc0 N cfzo)) $;

--| Half-open integer ranges starting with 0 are subsets of NN0. (Contributed by Thierry Arnoux, 8-Oct-2018.) (Proof shortened by JJ, 1-Jun-2021.)
theorem fzo0ssnn0 (N: class):
  $ wss (co cc0 N cfzo) cn0 $;

--| Expressing the singleton of ` 0 ` as a half-open integer range. (Contributed by Stefan O'Rear, 15-Aug-2015.)
theorem fzo01:
  $ wceq (co cc0 c1 cfzo) (csn cc0) $;

--| A 1-based half-open integer interval up to, but not including, 2 is a singleton. (Contributed by Alexander van der Vekens, 31-Jan-2018.)
theorem fzo12sn:
  $ wceq (co c1 c2 cfzo) (csn c1) $;

--| A 1-based half-open integer interval up to, but not including, 3 is a pair. (Contributed by Thierry Arnoux, 11-Jul-2020.)
theorem fzo13pr:
  $ wceq (co c1 c3 cfzo) (cpr c1 c2) $;

--| A half-open integer range from 0 to 2 is an unordered pair. (Contributed by Alexander van der Vekens, 4-Dec-2017.)
theorem fzo0to2pr:
  $ wceq (co cc0 c2 cfzo) (cpr cc0 c1) $;

--| An integer range between 0 and 1 is a pair. (Contributed by AV, 11-Sep-2025.)
theorem fz01pr:
  $ wceq (co cc0 c1 cfz) (cpr cc0 c1) $;

--| A half-open integer range from 0 to 3 is an unordered triple. (Contributed by Alexander van der Vekens, 9-Nov-2017.)
theorem fzo0to3tp:
  $ wceq (co cc0 c3 cfzo) (ctp cc0 c1 c2) $;

--| A half-open integer range from 0 to 4 is a union of two unordered pairs. (Contributed by Alexander van der Vekens, 17-Nov-2017.)
theorem fzo0to42pr:
  $ wceq (co cc0 c4 cfzo) (cun (cpr cc0 c1) (cpr c2 c3)) $;

--| A half-open integer range from 1 to 4 is an unordered triple. (Contributed by AV, 28-Jul-2021.)
theorem fzo1to4tp:
  $ wceq (co c1 c4 cfzo) (ctp c1 c2 c3) $;

--| A half-open range of nonnegative integers is the union of the singleton set containing 0 and a half-open range of positive integers. (Contributed by Alexander van der Vekens, 18-May-2018.)
theorem fzo0sn0fzo1 (N: class):
  $ wi (wcel N cn) (wceq (co cc0 N cfzo) (cun (csn cc0) (co c1 N cfzo))) $;

--| A member of a half-open range of nonnegative integers is either 0 or a member of the corresponding half-open range of positive integers. (Contributed by AV, 5-Feb-2021.)
theorem elfzo0l (K N: class):
  $ wi (wcel K (co cc0 N cfzo)) (wo (wceq K cc0) (wcel K (co c1 N cfzo))) $;

--| The endpoint of a half-open integer range. (Contributed by Mario Carneiro, 29-Sep-2015.)
theorem fzoend (A2 B2: class):
  $ wi (wcel A2 (co A2 B2 cfzo)) (wcel (co B2 c1 cmin) (co A2 B2 cfzo)) $;

--| The endpoint of a zero-based half-open range. (Contributed by Stefan O'Rear, 27-Aug-2015.) (Revised by Mario Carneiro, 29-Sep-2015.)
theorem fzo0end (B2: class):
  $ wi (wcel B2 cn) (wcel (co B2 c1 cmin) (co cc0 B2 cfzo)) $;

--| Subset relationship for half-open integer ranges. (Contributed by Alexander van der Vekens, 16-Mar-2018.)
theorem ssfzo12 (K L M N: class):
  $ wi (w3a (wcel K cz) (wcel L cz) (wbr K L clt)) (wi (wss (co K L cfzo) (co M N cfzo)) (wa (wbr M K cle) (wbr L N cle))) $;

--| If a half-open integer range is a subset of a half-open range of nonnegative integers, but its lower bound is greater than or equal to the upper bound of the containing range, or its upper bound is less than or equal to 0, then its upper bound is less than or equal to its lower bound (and therefore it is actually empty). (Contributed by Alexander van der Vekens, 24-May-2018.)
theorem ssfzoulel (A2 B2 N: class):
  $ wi (w3a (wcel N cn0) (wcel A2 cz) (wcel B2 cz)) (wi (wo (wbr N A2 cle) (wbr B2 cc0 cle)) (wi (wss (co A2 B2 cfzo) (co cc0 N cfzo)) (wbr B2 A2 cle))) $;

--| Subset relationship for half-open integer ranges. (Contributed by Alexander van der Vekens, 5-Nov-2018.)
theorem ssfzo12bi (K L M N: class):
  $ wi (w3a (wa (wcel K cz) (wcel L cz)) (wa (wcel M cz) (wcel N cz)) (wbr K L clt)) (wb (wss (co K L cfzo) (co M N cfzo)) (wa (wbr M K cle) (wbr L N cle))) $;

--| A half-open integer range can represent an ordered pair, analogous to ~ fzopth . (Contributed by Alexander van der Vekens, 1-Jul-2018.)
theorem fzoopth (J K M N: class):
  $ wi (w3a (wcel M cz) (wcel N cz) (wbr M N clt)) (wb (wceq (co M N cfzo) (co J K cfzo)) (wa (wceq M J) (wceq N K))) $;

--| The result of subtracting 1 and an integer of a half-open range of nonnegative integers from the upper bound of this range is contained in this range. (Contributed by AV, 23-Mar-2018.) (Revised by AV, 30-Oct-2018.)
theorem ubmelm1fzo (K N: class):
  $ wi (wcel K (co cc0 N cfzo)) (wcel (co (co N K cmin) c1 cmin) (co cc0 N cfzo)) $;

--| If a point is in a half-open range, the next point is in the closed range. (Contributed by Stefan O'Rear, 23-Aug-2015.)
theorem fzofzp1 (A2 B2 C: class):
  $ wi (wcel C (co A2 B2 cfzo)) (wcel (co C c1 caddc) (co A2 B2 cfz)) $;

--| If a point is in a half-open range, the next point is in the closed range. (Contributed by Mario Carneiro, 27-Sep-2015.)
theorem fzofzp1b (A2 B2 C: class):
  $ wi (wcel C (cfv A2 cuz)) (wb (wcel C (co A2 B2 cfzo)) (wcel (co C c1 caddc) (co A2 B2 cfz))) $;

--| An integer is a member of a 1-based finite set of sequential integers iff its predecessor is a member of the corresponding 0-based set. (Contributed by Mario Carneiro, 27-Sep-2015.)
theorem elfzom1b (K N: class):
  $ wi (wa (wcel K cz) (wcel N cz)) (wb (wcel K (co c1 N cfzo)) (wcel (co K c1 cmin) (co cc0 (co N c1 cmin) cfzo))) $;

--| Membership of a nonnegative integer incremented by one in a half-open range of positive integers. (Contributed by AV, 20-Mar-2021.)
theorem elfzom1elp1fzo1 (I N: class):
  $ wi (wa (wcel N cz) (wcel I (co cc0 (co N c1 cmin) cfzo))) (wcel (co I c1 caddc) (co c1 N cfzo)) $;

--| Membership of a positive integer decremented by one in a half-open range of nonnegative integers. (Contributed by AV, 20-Mar-2021.)
theorem elfzo1elm1fzo0 (I N: class):
  $ wi (wcel I (co c1 N cfzo)) (wcel (co I c1 cmin) (co cc0 (co N c1 cmin) cfzo)) $;

--| If an element of a half-open integer range is not contained in the lower subrange, it must be in the upper subrange. (Contributed by Alexander van der Vekens, 30-Mar-2018.)
theorem elfzonelfzo (R K M N: class):
  $ wi (wcel N cz) (wi (wa (wcel K (co M R cfzo)) (wn (wcel K (co M N cfzo)))) (wcel K (co N R cfzo))) $;

--| If an integer ` M ` is in an open interval starting at ` 0 ` , except ` 0 ` , then ` ( M - 1 ) ` is also in that interval. (Contributed by Thierry Arnoux, 19-Oct-2025.)
theorem elfzodif0 (ph: wff) (M N: class):
  $ wi ph (wcel M (cdif (co cc0 N cfzo) (csn cc0))) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel (co M c1 cmin) (co cc0 N cfzo)) $;

--| If an element of a half-open integer range is not in the upper part of the range, it is in the lower part of the range. (Contributed by Alexander van der Vekens, 29-Oct-2018.)
theorem fzonfzoufzol (I M N: class):
  $ wi (w3a (wcel M cz) (wbr M N clt) (wcel I (co cc0 N cfzo))) (wi (wn (wcel I (co (co N M cmin) N cfzo))) (wcel I (co cc0 (co N M cmin) cfzo))) $;

--| An integer increased by another integer is an element of a half-open integer range if and only if the integer is contained in the half-open integer range with bounds decreased by the other integer. (Contributed by Alexander van der Vekens, 30-Mar-2018.)
theorem elfzomelpfzo (K L M N: class):
  $ wi (wa (wa (wcel M cz) (wcel N cz)) (wa (wcel K cz) (wcel L cz))) (wb (wcel K (co (co M L cmin) (co N L cmin) cfzo)) (wcel (co K L caddc) (co M N cfzo))) $;

--| A value in a finite set of sequential integers is a border value if it is not contained in the half-open integer range contained in the finite set of sequential integers. (Contributed by Alexander van der Vekens, 31-Oct-2017.) (Revised by Thierry Arnoux, 22-Dec-2021.)
theorem elfznelfzo (K M: class):
  $ wi (wa (wcel M (co cc0 K cfz)) (wn (wcel M (co c1 K cfzo)))) (wo (wceq M cc0) (wceq M K)) $;

--| A value in a finite set of sequential integers is a border value if and only if it is not contained in the half-open integer range contained in the finite set of sequential integers. (Contributed by Alexander van der Vekens, 17-Jan-2018.) (Revised by Thierry Arnoux, 22-Dec-2021.)
theorem elfznelfzob (K M: class):
  $ wi (wcel M (co cc0 K cfz)) (wb (wn (wcel M (co c1 K cfzo))) (wo (wceq M cc0) (wceq M K))) $;

--| A Peano-postulate-like theorem for downward closure of a half-open integer range. (Contributed by Mario Carneiro, 1-Oct-2015.)
theorem peano2fzor (K M N: class):
  $ wi (wa (wcel K (cfv M cuz)) (wcel (co K c1 caddc) (co M N cfzo))) (wcel K (co M N cfzo)) $;

--| Extending a half-open range by a singleton on the end. (Contributed by Stefan O'Rear, 23-Aug-2015.)
theorem fzosplitsn (A2 B2: class):
  $ wi (wcel B2 (cfv A2 cuz)) (wceq (co A2 (co B2 c1 caddc) cfzo) (cun (co A2 B2 cfzo) (csn B2))) $;

--| Extending a half-open integer range by an unordered pair at the end. (Contributed by Alexander van der Vekens, 22-Sep-2018.)
theorem fzosplitpr (A2 B2: class):
  $ wi (wcel B2 (cfv A2 cuz)) (wceq (co A2 (co B2 c2 caddc) cfzo) (cun (co A2 B2 cfzo) (cpr B2 (co B2 c1 caddc)))) $;

--| Extending a half-open integer range by an unordered pair at the end. (Contributed by Alexander van der Vekens, 22-Sep-2018.) (Proof shortened by AV, 25-Jun-2022.)
theorem fzosplitprm1 (A2 B2: class):
  $ wi (w3a (wcel A2 cz) (wcel B2 cz) (wbr A2 B2 clt)) (wceq (co A2 (co B2 c1 caddc) cfzo) (cun (co A2 (co B2 c1 cmin) cfzo) (cpr (co B2 c1 cmin) B2))) $;

--| Membership in a half-open range extended by a singleton. (Contributed by Stefan O'Rear, 23-Aug-2015.)
theorem fzosplitsni (A2 B2 C: class):
  $ wi (wcel B2 (cfv A2 cuz)) (wb (wcel C (co A2 (co B2 c1 caddc) cfzo)) (wo (wcel C (co A2 B2 cfzo)) (wceq C B2))) $;

--| A finite interval of integers as union of a half-open integer range and a singleton. (Contributed by Alexander van der Vekens, 15-Jun-2018.)
theorem fzisfzounsn (A2 B2: class):
  $ wi (wcel B2 (cfv A2 cuz)) (wceq (co A2 B2 cfz) (cun (co A2 B2 cfzo) (csn B2))) $;

--| A member of a finite interval of integers is either a member of the corresponding half-open integer range or the upper bound of the interval. (Contributed by AV, 5-Feb-2021.)
theorem elfzr (K M N: class):
  $ wi (wcel K (co M N cfz)) (wo (wcel K (co M N cfzo)) (wceq K N)) $;

--| A member of a finite interval of integers is either its lower bound or its upper bound or an element of its interior. (Contributed by AV, 5-Feb-2021.)
theorem elfzlmr (K M N: class):
  $ wi (wcel K (co M N cfz)) (w3o (wceq K M) (wcel K (co (co M c1 caddc) N cfzo)) (wceq K N)) $;

--| A member of a finite interval of nonnegative integers is either 0 or its upper bound or an element of its interior. (Contributed by AV, 5-Feb-2021.)
theorem elfz0lmr (K N: class):
  $ wi (wcel K (co cc0 N cfz)) (w3o (wceq K cc0) (wcel K (co c1 N cfzo)) (wceq K N)) $;

--| Elementhood in a half-open interval, except its lower bound. (Contributed by Thierry Arnoux, 1-Jan-2024.)
theorem fzone1 (K M N: class):
  $ wi (wa (wcel K (co M N cfzo)) (wne K M)) (wcel K (co (co M c1 caddc) N cfzo)) $;

--| Elementhood in a half-open interval, except the lower bound, shifted by one. (Contributed by Thierry Arnoux, 1-Jan-2024.)
theorem fzom1ne1 (K M N: class):
  $ wi (wa (wcel K (co M N cfzo)) (wne K M)) (wcel (co K c1 cmin) (co M (co N c1 cmin) cfzo)) $;

--| Two possibilities for a number one greater than a number in a half-open range. (Contributed by Stefan O'Rear, 23-Aug-2015.)
theorem fzostep1 (A2 B2 C: class):
  $ wi (wcel A2 (co B2 C cfzo)) (wo (wcel (co A2 c1 caddc) (co B2 C cfzo)) (wceq (co A2 c1 caddc) C)) $;

--| Shift the scanning order inside of a universal quantification restricted to a half-open integer range, analogous to ~ fzshftral . (Contributed by Alexander van der Vekens, 23-Sep-2018.)
theorem fzoshftral {j k: setvar} (ph: wff j) (K M N: class):
  $ wi (w3a (wcel M cz) (wcel N cz) (wcel K cz)) (wb (wral j ph (co M N cfzo)) (wral k (wsbc j ph (co (cv k) K cmin)) (co (co M K caddc) (co N K caddc) cfzo))) $;

--| Induction on the integers from ` M ` to ` N ` inclusive. The first four hypotheses give us the substitution instances we need; the last two are the basis and the induction step. Version of ~ fzind using integer range definitions. (Contributed by Mario Carneiro, 6-Feb-2016.)
theorem fzind2 {x3 y1: setvar} (ph: wff x3) (ps ch th ta: wff y1) (K: class y1) (M N: class):
  $ wi (wceq (cv x3) M) (wb ph ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ch) $ >
  $ wi (wceq (cv x3) (co (cv y1) c1 caddc)) (wb ph th) $ >
  $ wi (wceq (cv x3) K) (wb ph ta) $ >
  $ wi (wcel N (cfv M cuz)) ps $ >
  $ wi (wcel (cv y1) (co M N cfzo)) (wi ch th) $ >
  $ wi (wcel K (co M N cfz)) ta $;

--| The function values for the borders of a finite interval of integers, which is the domain of the function, are not in the image of the interior of the interval iff the intersection of the images of the interior and the borders is empty. (Contributed by Alexander van der Vekens, 31-Oct-2017.) (Revised by AV, 5-Feb-2021.)
theorem fvinim0ffz (F K V: class):
  $ wi (wa (wf (co cc0 K cfz) V F) (wcel K cn0)) (wb (wceq (cin (cima F (cpr cc0 K)) (cima F (co c1 K cfzo))) c0) (wa (wnel (cfv cc0 F) (cima F (co c1 K cfzo))) (wnel (cfv K F) (cima F (co c1 K cfzo))))) $;

--| Lemma for ~ injresinj . (Contributed by Alexander van der Vekens, 31-Oct-2017.) (Proof shortened by AV, 14-Feb-2021.) (Revised by Thierry Arnoux, 23-Dec-2021.)
theorem injresinjlem (F K V X Y: class):
  $ wi (wn (wcel Y (co c1 K cfzo))) (wi (wne (cfv cc0 F) (cfv K F)) (wi (wa (wf (co cc0 K cfz) V F) (wcel K cn0)) (wi (wceq (cin (cima F (cpr cc0 K)) (cima F (co c1 K cfzo))) c0) (wi (wa (wcel X (co cc0 K cfz)) (wcel Y (co cc0 K cfz))) (wi (wceq (cfv X F) (cfv Y F)) (wceq X Y)))))) $;

--| A function whose restriction is injective and the values of the remaining arguments are different from all other values is injective itself. (Contributed by Alexander van der Vekens, 31-Oct-2017.)
theorem injresinj (F K V: class):
  $ wi (wcel K cn0) (wi (w3a (wf (co cc0 K cfz) V F) (wfun (ccnv (cres F (co c1 K cfzo)))) (wne (cfv cc0 F) (cfv K F))) (wi (wceq (cin (cima F (cpr cc0 K)) (cima F (co c1 K cfzo))) c0) (wfun (ccnv F)))) $;

--| If a function with a sequence of nonnegative integers (starting at 0) as its domain is one-to-one when 0 is removed, and if the range of that restriction does not contain the function's value at the removed integer, then the function is itself one-to-one. (Contributed by BTernaryTau, 4-Oct-2023.) (Revised by Mingli Yuan, 15-Aug-2026.)
theorem f1resfz0f1d (ph: wff) (F K V: class):
  $ wi ph (wcel K cn0) $ >
  $ wi ph (wf (co cc0 K cfz) V F) $ >
  $ wi ph (wfun (ccnv (cres F (co c1 K cfz)))) $ >
  $ wi ph (wceq (cin (cima F (csn cc0)) (cima F (co c1 K cfz))) c0) $ >
  $ wi ph (wf1 (co cc0 K cfz) V F) $;

--| The difference between two elements in a half-open range of nonnegative integers is greater than the negation of the upper bound and less than the upper bound of the range. (Contributed by AV, 20-Mar-2021.)
theorem subfzo0 (I J N: class):
  $ wi (wa (wcel I (co cc0 N cfzo)) (wcel J (co cc0 N cfzo))) (wa (wbr (cneg N) (co I J cmin) clt) (wbr (co I J cmin) N clt)) $;

--| Values of a one-to-one function between two sets with three elements. Actually, such a function is a bijection. (Contributed by AV, 23-Jul-2025.)
theorem fvf1tp (F X Y Z: class):
  $ wi (wf1 (co cc0 c3 cfzo) (ctp X Y Z) F) (w3o (wo (w3a (wceq (cfv cc0 F) X) (wceq (cfv c1 F) Y) (wceq (cfv c2 F) Z)) (w3a (wceq (cfv cc0 F) X) (wceq (cfv c1 F) Z) (wceq (cfv c2 F) Y))) (wo (w3a (wceq (cfv cc0 F) Y) (wceq (cfv c1 F) X) (wceq (cfv c2 F) Z)) (w3a (wceq (cfv cc0 F) Y) (wceq (cfv c1 F) Z) (wceq (cfv c2 F) X))) (wo (w3a (wceq (cfv cc0 F) Z) (wceq (cfv c1 F) X) (wceq (cfv c2 F) Y)) (w3a (wceq (cfv cc0 F) Z) (wceq (cfv c1 F) Y) (wceq (cfv c2 F) X)))) $;

--| Extend class notation with floor (greatest integer) function.
term cfl: class;

--| Extend class notation to include the ceiling function.
term cceil: class;

--| Define the floor (greatest integer less than or equal to) function. See ~ flval for its value, ~ fllelt for its basic property, and ~ flcl for its closure. For example, ` ( |_ `` ( 3 / 2 ) ) = 1 ` while ` ( |_ `` -u ( 3 / 2 ) ) = -u 2 ` ( ~ ex-fl ). The term "floor" was coined by Ken Iverson. He also invented a mathematical notation for floor, consisting of an L-shaped left bracket and its reflection as a right bracket. In APL, the left-bracket alone is used, and we borrow this idea. (Thanks to Paul Chapman for this information.) (Contributed by NM, 14-Nov-2004.)
axiom df_fl {x3 y1: setvar}:
  $ wceq cfl (cmpt x3 cr (crio y1 (wa (wbr (cv y1) (cv x3) cle) (wbr (cv x3) (co (cv y1) c1 caddc) clt)) cz)) $;

--| The ceiling (least integer greater than or equal to) function. Defined in ISO 80000-2:2009(E) operation 2-9.18 and the "NIST Digital Library of Mathematical Functions" , front introduction, "Common Notations and Definitions" section at ~ http://dlmf.nist.gov/front/introduction#Sx4 . See ~ ceilval for its value, ~ ceilge and ~ ceilm1lt for its basic properties, and ~ ceilcl for its closure. For example, ` ( |^ `` ( 3 / 2 ) ) = 2 ` while ` ( |^ `` -u ( 3 / 2 ) ) = -u 1 ` ( ~ ex-ceil ). The symbol ` |^ ` is inspired by the gamma shaped left bracket of the usual notation. (Contributed by David A. Wheeler, 19-May-2015.)
axiom df_ceil {x3: setvar}:
  $ wceq cceil (cmpt x3 cr (cneg (cfv (cneg (cv x3)) cfl))) $;

--| Value of the floor (greatest integer) function. The floor of ` A ` is the (unique) integer less than or equal to ` A ` whose successor is strictly greater than ` A ` . (Contributed by NM, 14-Nov-2004.) (Revised by Mario Carneiro, 2-Nov-2013.)
theorem flval {x3: setvar} (A2: class):
  $ wi (wcel A2 cr) (wceq (cfv A2 cfl) (crio x3 (wa (wbr (cv x3) A2 cle) (wbr A2 (co (cv x3) c1 caddc) clt)) cz)) $;

--| The floor (greatest integer) function is an integer (closure law). (Contributed by NM, 15-Nov-2004.) (Revised by Mario Carneiro, 2-Nov-2013.)
theorem flcl (A2: class):
  $ wi (wcel A2 cr) (wcel (cfv A2 cfl) cz) $;

--| The floor (greatest integer) function is real. (Contributed by NM, 15-Jul-2008.)
theorem reflcl (A2: class):
  $ wi (wcel A2 cr) (wcel (cfv A2 cfl) cr) $;

--| A basic property of the floor (greatest integer) function. (Contributed by NM, 15-Nov-2004.) (Revised by Mario Carneiro, 2-Nov-2013.)
theorem fllelt (A2: class):
  $ wi (wcel A2 cr) (wa (wbr (cfv A2 cfl) A2 cle) (wbr A2 (co (cfv A2 cfl) c1 caddc) clt)) $;

--| The floor (greatest integer) function is an integer (closure law). (Contributed by Mario Carneiro, 28-May-2016.)
theorem flcld (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel (cfv A2 cfl) cz) $;

--| A basic property of the floor (greatest integer) function. (Contributed by NM, 24-Feb-2005.)
theorem flle (A2: class):
  $ wi (wcel A2 cr) (wbr (cfv A2 cfl) A2 cle) $;

--| A basic property of the floor (greatest integer) function. (Contributed by NM, 24-Feb-2005.)
theorem flltp1 (A2: class):
  $ wi (wcel A2 cr) (wbr A2 (co (cfv A2 cfl) c1 caddc) clt) $;

--| A basic property of the floor (greatest integer) function. (Contributed by Mario Carneiro, 21-May-2016.)
theorem fllep1 (A2: class):
  $ wi (wcel A2 cr) (wbr A2 (co (cfv A2 cfl) c1 caddc) cle) $;

--| The fractional part of a real number is less than one. (Contributed by NM, 15-Jul-2008.)
theorem fraclt1 (A2: class):
  $ wi (wcel A2 cr) (wbr (co A2 (cfv A2 cfl) cmin) c1 clt) $;

--| The fractional part of a real number is less than or equal to one. (Contributed by Mario Carneiro, 21-May-2016.)
theorem fracle1 (A2: class):
  $ wi (wcel A2 cr) (wbr (co A2 (cfv A2 cfl) cmin) c1 cle) $;

--| The fractional part of a real number is nonnegative. (Contributed by NM, 17-Jul-2008.)
theorem fracge0 (A2: class):
  $ wi (wcel A2 cr) (wbr cc0 (co A2 (cfv A2 cfl) cmin) cle) $;

--| The floor function value is the greatest integer less than or equal to its argument. (Contributed by NM, 15-Nov-2004.) (Proof shortened by Fan Zheng, 14-Jul-2016.)
theorem flge (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cz)) (wb (wbr B2 A2 cle) (wbr B2 (cfv A2 cfl) cle)) $;

--| The floor function value is less than the next integer. (Contributed by NM, 24-Feb-2005.)
theorem fllt (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cz)) (wb (wbr A2 B2 clt) (wbr (cfv A2 cfl) B2 clt)) $;

--| Move floor function between strict and non-strict inequality. (Contributed by Brendan Leahy, 25-Oct-2017.)
theorem flflp1 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wb (wbr (cfv A2 cfl) B2 cle) (wbr A2 (co (cfv B2 cfl) c1 caddc) clt)) $;

--| An integer is its own floor. (Contributed by NM, 15-Nov-2004.)
theorem flid (A2: class):
  $ wi (wcel A2 cz) (wceq (cfv A2 cfl) A2) $;

--| The floor function is idempotent. (Contributed by NM, 17-Aug-2008.)
theorem flidm (A2: class):
  $ wi (wcel A2 cr) (wceq (cfv (cfv A2 cfl) cfl) (cfv A2 cfl)) $;

--| A real number equals its floor iff it is an integer. (Contributed by NM, 11-Nov-2008.)
theorem flidz (A2: class):
  $ wi (wcel A2 cr) (wb (wceq (cfv A2 cfl) A2) (wcel A2 cz)) $;

--| The floor of a non-integer real is less than it. (Contributed by Glauco Siliprandi, 11-Dec-2019.)
theorem flltnz (A2: class):
  $ wi (wa (wcel A2 cr) (wn (wcel A2 cz))) (wbr (cfv A2 cfl) A2 clt) $;

--| Ordering relation for the floor function. (Contributed by NM, 31-Dec-2005.) (Proof shortened by Fan Zheng, 14-Jul-2016.)
theorem flwordi (A2 B2: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wbr A2 B2 cle)) (wbr (cfv A2 cfl) (cfv B2 cfl) cle) $;

--| Ordering relation for the floor function. (Contributed by Mario Carneiro, 7-Jun-2016.)
theorem flword2 (A2 B2: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wbr A2 B2 cle)) (wcel (cfv B2 cfl) (cfv (cfv A2 cfl) cuz)) $;

--| An alternate way to define the floor function. (Contributed by NM, 16-Nov-2004.)
theorem flval2 {x3 y1: setvar} (A2: class):
  $ wi (wcel A2 cr) (wceq (cfv A2 cfl) (crio x3 (wa (wbr (cv x3) A2 cle) (wral y1 (wi (wbr (cv y1) A2 cle) (wbr (cv y1) (cv x3) cle)) cz)) cz)) $;

--| An alternate way to define the floor function, as the supremum of all integers less than or equal to its argument. (Contributed by NM, 15-Nov-2004.) (Proof shortened by Mario Carneiro, 6-Sep-2014.)
theorem flval3 {x3: setvar} (A2: class):
  $ wi (wcel A2 cr) (wceq (cfv A2 cfl) (csup (crab x3 (wbr (cv x3) A2 cle) cz) cr clt)) $;

--| A condition equivalent to floor. (Contributed by NM, 11-Mar-2005.) (Revised by Mario Carneiro, 2-Nov-2013.)
theorem flbi (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cz)) (wb (wceq (cfv A2 cfl) B2) (wa (wbr B2 A2 cle) (wbr A2 (co B2 c1 caddc) clt))) $;

--| A condition equivalent to floor. (Contributed by NM, 15-Aug-2008.)
theorem flbi2 (F N: class):
  $ wi (wa (wcel N cz) (wcel F cr)) (wb (wceq (cfv (co N F caddc) cfl) N) (wa (wbr cc0 F cle) (wbr F c1 clt))) $;

--| The floor of a sum of an integer and a fraction is equal to the integer iff the denominator of the fraction is less than the numerator. (Contributed by AV, 14-Jul-2021.)
theorem adddivflid (A2 B2 C: class):
  $ wi (w3a (wcel A2 cz) (wcel B2 cn0) (wcel C cn)) (wb (wbr B2 C clt) (wceq (cfv (co A2 (co B2 C cdiv) caddc) cfl) A2)) $;

--| The floor of a real number in ` [ 0 , 1 ) ` is 0. Remark: may shorten the proof of ~ modid or a version of it where the antecedent is membership in an interval. (Contributed by BJ, 29-Jun-2019.)
theorem ico01fl0 (A2: class):
  $ wi (wcel A2 (co cc0 c1 cico)) (wceq (cfv A2 cfl) cc0) $;

--| The floor of a number greater than or equal to 0 is a nonnegative integer. (Contributed by NM, 26-Apr-2005.)
theorem flge0nn0 (A2: class):
  $ wi (wa (wcel A2 cr) (wbr cc0 A2 cle)) (wcel (cfv A2 cfl) cn0) $;

--| The floor of a number greater than or equal to 1 is a positive integer. (Contributed by NM, 26-Apr-2005.)
theorem flge1nn (A2: class):
  $ wi (wa (wcel A2 cr) (wbr c1 A2 cle)) (wcel (cfv A2 cfl) cn) $;

--| The floor function of a division of a nonnegative integer by a positive integer is a nonnegative integer. (Contributed by Alexander van der Vekens, 14-Apr-2018.)
theorem fldivnn0 (K L: class):
  $ wi (wa (wcel K cn0) (wcel L cn)) (wcel (cfv (co K L cdiv) cfl) cn0) $;

--| The floor function of a division of a real number by a positive real number is a real number. (Contributed by Alexander van der Vekens, 14-Apr-2018.)
theorem refldivcl (K L: class):
  $ wi (wa (wcel K cr) (wcel L crp)) (wcel (cfv (co K L cdiv) cfl) cr) $;

--| The floor of a fraction is 0 iff the denominator is less than the numerator. (Contributed by AV, 8-Jul-2021.)
theorem divfl0 (A2 B2: class):
  $ wi (wa (wcel A2 cn0) (wcel B2 cn)) (wb (wbr A2 B2 clt) (wceq (cfv (co A2 B2 cdiv) cfl) cc0)) $;

--| An integer can be moved in and out of the floor of a sum. (Contributed by NM, 27-Apr-2005.) (Proof shortened by Fan Zheng, 16-Jun-2016.)
theorem fladdz (A2 N: class):
  $ wi (wa (wcel A2 cr) (wcel N cz)) (wceq (cfv (co A2 N caddc) cfl) (co (cfv A2 cfl) N caddc)) $;

--| An integer can be moved in and out of the floor of a sum. (Contributed by NM, 2-Jan-2009.)
theorem flzadd (A2 N: class):
  $ wi (wa (wcel N cz) (wcel A2 cr)) (wceq (cfv (co N A2 caddc) cfl) (co N (cfv A2 cfl) caddc)) $;

--| Move a nonnegative integer in and out of a floor. (Contributed by NM, 2-Jan-2009.) (Proof shortened by Fan Zheng, 7-Jun-2016.)
theorem flmulnn0 (A2 N: class):
  $ wi (wa (wcel N cn0) (wcel A2 cr)) (wbr (co N (cfv A2 cfl) cmul) (cfv (co N A2 cmul) cfl) cle) $;

--| A real bounded between an integer and its successor is nonnegative iff the integer is nonnegative. Second half of Lemma 13-4.1 of [Gleason] p. 217. (For the first half see ~ rebtwnz .) (Contributed by NM, 12-Mar-2005.)
theorem btwnzge0 (A2 N: class):
  $ wi (wa (wa (wcel A2 cr) (wcel N cz)) (wa (wbr N A2 cle) (wbr A2 (co N c1 caddc) clt))) (wb (wbr cc0 A2 cle) (wbr cc0 N cle)) $;

--| Two times an integer plus one is not negative iff the integer is not negative. (Contributed by AV, 19-Jun-2021.) (Proof shortened by AV, 10-Jul-2022.)
theorem _2tnp1ge0ge0 (N: class):
  $ wi (wcel N cz) (wb (wbr cc0 (co (co c2 N cmul) c1 caddc) cle) (wbr cc0 N cle)) $;

--| Ordering relation for the floor of half of an integer. (Contributed by NM, 1-Jan-2006.) (Proof shortened by Mario Carneiro, 7-Jun-2016.)
theorem flhalf (N: class):
  $ wi (wcel N cz) (wbr N (co c2 (cfv (co (co N c1 caddc) c2 cdiv) cfl) cmul) cle) $;

--| The floor function of a division of a real number by a positive real number is less than or equal to the division. (Contributed by Alexander van der Vekens, 14-Apr-2018.)
theorem fldivle (K L: class):
  $ wi (wa (wcel K cr) (wcel L crp)) (wbr (cfv (co K L cdiv) cfl) (co K L cdiv) cle) $;

--| The floor function of a division of a nonnegative integer by a positive integer is less than or equal to the division. (Contributed by Alexander van der Vekens, 14-Apr-2018.)
theorem fldivnn0le (K L: class):
  $ wi (wa (wcel K cn0) (wcel L cn)) (wbr (cfv (co K L cdiv) cfl) (co K L cdiv) cle) $;

--| The floor function of a division of a nonnegative integer by a positive integer is less than the division of a greater dividend by the same positive integer. (Contributed by Alexander van der Vekens, 14-Apr-2018.)
theorem flltdivnn0lt (K L N: class):
  $ wi (w3a (wcel K cn0) (wcel N cn0) (wcel L cn)) (wi (wbr K N clt) (wbr (cfv (co K L cdiv) cfl) (co N L cdiv) clt)) $;

--| If the dividend of a division is less than the difference between a real number and the divisor, the floor function of the division plus 1 is less than the division of the real number by the divisor. (Contributed by Alexander van der Vekens, 14-Apr-2018.)
theorem ltdifltdiv (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 crp) (wcel C cr)) (wi (wbr A2 (co C B2 cmin) clt) (wbr (co (cfv (co A2 B2 cdiv) cfl) c1 caddc) (co C B2 cdiv) clt)) $;

--| The floor of an integer equal to 3 or greater than 4, increased by 1, is less than or equal to the half of the integer minus 1. (Contributed by AV, 8-Jul-2021.)
theorem fldiv4p1lem1div2 (N: class):
  $ wi (wo (wceq N c3) (wcel N (cfv c5 cuz))) (wbr (co (cfv (co N c4 cdiv) cfl) c1 caddc) (co (co N c1 cmin) c2 cdiv) cle) $;

--| The floor of an integer greater than 1, divided by 4 is less than or equal to the half of the integer minus 1. (Contributed by AV, 5-Jul-2021.) (Proof shortened by AV, 9-Jul-2022.)
theorem fldiv4lem1div2uz2 (N: class):
  $ wi (wcel N (cfv c2 cuz)) (wbr (cfv (co N c4 cdiv) cfl) (co (co N c1 cmin) c2 cdiv) cle) $;

--| The floor of a positive integer divided by 4 is less than or equal to the half of the integer minus 1. (Contributed by AV, 9-Jul-2021.)
theorem fldiv4lem1div2 (N: class):
  $ wi (wcel N cn) (wbr (cfv (co N c4 cdiv) cfl) (co (co N c1 cmin) c2 cdiv) cle) $;

--| The value of the ceiling function. (Contributed by David A. Wheeler, 19-May-2015.)
theorem ceilval (A2: class):
  $ wi (wcel A2 cr) (wceq (cfv A2 cceil) (cneg (cfv (cneg A2) cfl))) $;

--| Alternative definition of the ceiling function using restricted iota. (Contributed by AV, 1-Dec-2018.)
theorem dfceil2 {x3 y1: setvar}:
  $ wceq cceil (cmpt x3 cr (crio y1 (wa (wbr (cv x3) (cv y1) cle) (wbr (cv y1) (co (cv x3) c1 caddc) clt)) cz)) $;

--| The value of the ceiling function using restricted iota. (Contributed by AV, 1-Dec-2018.)
theorem ceilval2 {y1: setvar} (A2: class):
  $ wi (wcel A2 cr) (wceq (cfv A2 cceil) (crio y1 (wa (wbr A2 (cv y1) cle) (wbr (cv y1) (co A2 c1 caddc) clt)) cz)) $;

--| The ceiling function returns an integer (closure law). (Contributed by Jeff Hankins, 10-Jun-2007.)
theorem ceicl (A2: class):
  $ wi (wcel A2 cr) (wcel (cneg (cfv (cneg A2) cfl)) cz) $;

--| Closure of the ceiling function. (Contributed by David A. Wheeler, 19-May-2015.)
theorem ceilcl (A2: class):
  $ wi (wcel A2 cr) (wcel (cfv A2 cceil) cz) $;

--| Closure of the ceiling function. (Contributed by Glauco Siliprandi, 2-Jan-2022.)
theorem ceilcld (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel (cfv A2 cceil) cz) $;

--| The ceiling of a real number is greater than or equal to that number. (Contributed by Jeff Hankins, 10-Jun-2007.)
theorem ceige (A2: class):
  $ wi (wcel A2 cr) (wbr A2 (cneg (cfv (cneg A2) cfl)) cle) $;

--| The ceiling of a real number is greater than or equal to that number. (Contributed by AV, 30-Nov-2018.)
theorem ceilge (A2: class):
  $ wi (wcel A2 cr) (wbr A2 (cfv A2 cceil) cle) $;

--| The ceiling of a real number is greater than or equal to that number. (Contributed by Glauco Siliprandi, 2-Jan-2022.)
theorem ceilged (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wbr A2 (cfv A2 cceil) cle) $;

--| One less than the ceiling of a real number is strictly less than that number. (Contributed by Jeff Hankins, 10-Jun-2007.)
theorem ceim1l (A2: class):
  $ wi (wcel A2 cr) (wbr (co (cneg (cfv (cneg A2) cfl)) c1 cmin) A2 clt) $;

--| One less than the ceiling of a real number is strictly less than that number. (Contributed by AV, 30-Nov-2018.)
theorem ceilm1lt (A2: class):
  $ wi (wcel A2 cr) (wbr (co (cfv A2 cceil) c1 cmin) A2 clt) $;

--| The ceiling of a real number is the smallest integer greater than or equal to it. (Contributed by Jeff Hankins, 10-Jun-2007.)
theorem ceile (A2 B2: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cz) (wbr A2 B2 cle)) (wbr (cneg (cfv (cneg A2) cfl)) B2 cle) $;

--| The ceiling of a real number is the smallest integer greater than or equal to it. (Contributed by AV, 30-Nov-2018.)
theorem ceille (A2 B2: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cz) (wbr A2 B2 cle)) (wbr (cfv A2 cceil) B2 cle) $;

--| An integer is its own ceiling. (Contributed by AV, 30-Nov-2018.)
theorem ceilid (A2: class):
  $ wi (wcel A2 cz) (wceq (cfv A2 cceil) A2) $;

--| A real number equals its ceiling iff it is an integer. (Contributed by AV, 30-Nov-2018.)
theorem ceilidz (A2: class):
  $ wi (wcel A2 cr) (wb (wcel A2 cz) (wceq (cfv A2 cceil) A2)) $;

--| The floor of a real number is less than or equal to its ceiling. (Contributed by AV, 30-Nov-2018.)
theorem flleceil (A2: class):
  $ wi (wcel A2 cr) (wbr (cfv A2 cfl) (cfv A2 cceil) cle) $;

--| A real number is an integer iff its floor equals its ceiling. (Contributed by AV, 30-Nov-2018.)
theorem fleqceilz (A2: class):
  $ wi (wcel A2 cr) (wb (wcel A2 cz) (wceq (cfv A2 cfl) (cfv A2 cceil))) $;

--| Quotient and remainder of an integer divided by a positive integer. TODO - is this really needed for anything? Should we use ` mod ` to simplify it? Remark (AV): This is a special case of ~ divalg . (Contributed by NM, 14-Aug-2008.)
theorem quoremz (A2 B2 Q R: class):
  $ wceq Q (cfv (co A2 B2 cdiv) cfl) $ >
  $ wceq R (co A2 (co B2 Q cmul) cmin) $ >
  $ wi (wa (wcel A2 cz) (wcel B2 cn)) (wa (wa (wcel Q cz) (wcel R cn0)) (wa (wbr R B2 clt) (wceq A2 (co (co B2 Q cmul) R caddc)))) $;

--| Quotient and remainder of a nonnegative integer divided by a positive integer. (Contributed by NM, 14-Aug-2008.)
theorem quoremnn0 (A2 B2 Q R: class):
  $ wceq Q (cfv (co A2 B2 cdiv) cfl) $ >
  $ wceq R (co A2 (co B2 Q cmul) cmin) $ >
  $ wi (wa (wcel A2 cn0) (wcel B2 cn)) (wa (wa (wcel Q cn0) (wcel R cn0)) (wa (wbr R B2 clt) (wceq A2 (co (co B2 Q cmul) R caddc)))) $;

--| Alternate proof of ~ quoremnn0 not using ~ quoremz . TODO - Keep either ~ quoremnn0ALT (if we don't keep ~ quoremz ) or ~ quoremnn0 ? (Contributed by NM, 14-Aug-2008.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem quoremnn0ALT (A2 B2 Q R: class):
  $ wceq Q (cfv (co A2 B2 cdiv) cfl) $ >
  $ wceq R (co A2 (co B2 Q cmul) cmin) $ >
  $ wi (wa (wcel A2 cn0) (wcel B2 cn)) (wa (wa (wcel Q cn0) (wcel R cn0)) (wa (wbr R B2 clt) (wceq A2 (co (co B2 Q cmul) R caddc)))) $;

--| Decompose a real into integer and fractional parts. TODO - should we replace this with ~ intfrac ? (Contributed by NM, 16-Aug-2008.)
theorem intfrac2 (A2 F Z: class):
  $ wceq Z (cfv A2 cfl) $ >
  $ wceq F (co A2 Z cmin) $ >
  $ wi (wcel A2 cr) (w3a (wbr cc0 F cle) (wbr F c1 clt) (wceq A2 (co Z F caddc))) $;

--| Decompose a rational number, expressed as a ratio, into integer and fractional parts. The fractional part has a tighter bound than that of ~ intfrac2 . (Contributed by NM, 16-Aug-2008.)
theorem intfracq (F M N Z: class):
  $ wceq Z (cfv (co M N cdiv) cfl) $ >
  $ wceq F (co (co M N cdiv) Z cmin) $ >
  $ wi (wa (wcel M cz) (wcel N cn)) (w3a (wbr cc0 F cle) (wbr F (co (co N c1 cmin) N cdiv) cle) (wceq (co M N cdiv) (co Z F caddc))) $;

--| Cancellation of the embedded floor of a real divided by an integer. (Contributed by NM, 16-Aug-2008.)
theorem fldiv (A2 N: class):
  $ wi (wa (wcel A2 cr) (wcel N cn)) (wceq (cfv (co (cfv A2 cfl) N cdiv) cfl) (cfv (co A2 N cdiv) cfl)) $;

--| Cancellation of an embedded floor of a ratio. Generalization of Equation 2.4 in [CormenLeisersonRivest] p. 33 (where ` A ` must be an integer). (Contributed by NM, 9-Nov-2008.)
theorem fldiv2 (A2 M N: class):
  $ wi (w3a (wcel A2 cr) (wcel M cn) (wcel N cn)) (wceq (cfv (co (cfv (co A2 M cdiv) cfl) N cdiv) cfl) (cfv (co A2 (co M N cmul) cdiv) cfl)) $;

--| Finite set of sequential integers starting at 1 and ending at a real number. (Contributed by Mario Carneiro, 3-May-2016.)
theorem fznnfl (K N: class):
  $ wi (wcel N cr) (wb (wcel K (co c1 (cfv N cfl) cfz)) (wa (wcel K cn) (wbr K N cle))) $;

--| An upper set of integers is unbounded above. (Contributed by Mario Carneiro, 7-May-2016.)
theorem uzsup (M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi (wcel M cz) (wceq (csup Z cxr clt) cpnf) $;

--| An upper set of reals is unbounded above. (Contributed by Mario Carneiro, 7-May-2016.)
theorem ioopnfsup (A2: class):
  $ wi (wa (wcel A2 cxr) (wne A2 cpnf)) (wceq (csup (co A2 cpnf cioo) cxr clt) cpnf) $;

--| An upper set of reals is unbounded above. (Contributed by Mario Carneiro, 7-May-2016.)
theorem icopnfsup (A2: class):
  $ wi (wa (wcel A2 cxr) (wne A2 cpnf)) (wceq (csup (co A2 cpnf cico) cxr clt) cpnf) $;

--| The positive reals are unbounded above. (Contributed by Mario Carneiro, 7-May-2016.)
theorem rpsup:
  $ wceq (csup crp cxr clt) cpnf $;

--| The real numbers are unbounded above. (Contributed by Mario Carneiro, 7-May-2016.)
theorem resup:
  $ wceq (csup cr cxr clt) cpnf $;

--| The extended real numbers are unbounded above. (Contributed by Mario Carneiro, 7-May-2016.)
theorem xrsup:
  $ wceq (csup cxr cxr clt) cpnf $;

--| Extend class notation with the modulo operation.
term cmo: class;

--| Define the modulo (remainder) operation. See ~ modval for its value. For example, ` ( 5 mod 3 ) = 2 ` and ` ( -u 7 mod 2 ) = 1 ` ( ~ ex-mod ). (Contributed by NM, 10-Nov-2008.)
axiom df_mod {x3 y1: setvar}:
  $ wceq cmo (cmpo x3 y1 cr crp (co (cv x3) (co (cv y1) (cfv (co (cv x3) (cv y1) cdiv) cfl) cmul) cmin)) $;

--| The value of the modulo operation. The modulo congruence notation of number theory, ` J == K ` (modulo ` N ` ), can be expressed in our notation as ` ( J mod N ) = ( K mod N ) ` . Definition 1 in Knuth, _The Art of Computer Programming_, Vol. I (1972), p. 38. Knuth uses "mod" for the operation and "modulo" for the congruence. Unlike Knuth, we restrict the second argument to positive reals to simplify certain theorems. (This also gives us future flexibility to extend it to any one of several different conventions for a zero or negative second argument, should there be an advantage in doing so.) (Contributed by NM, 10-Nov-2008.) (Revised by Mario Carneiro, 3-Nov-2013.)
theorem modval (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 crp)) (wceq (co A2 B2 cmo) (co A2 (co B2 (cfv (co A2 B2 cdiv) cfl) cmul) cmin)) $;

--| The value of the modulo operation (multiplication in reversed order). (Contributed by Alexander van der Vekens, 14-Apr-2018.)
theorem modvalr (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 crp)) (wceq (co A2 B2 cmo) (co A2 (co (cfv (co A2 B2 cdiv) cfl) B2 cmul) cmin)) $;

--| Closure law for the modulo operation. (Contributed by NM, 10-Nov-2008.)
theorem modcl (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 crp)) (wcel (co A2 B2 cmo) cr) $;

--| Partition of a division into its integer part and the remainder. (Contributed by Alexander van der Vekens, 14-Apr-2018.)
theorem flpmodeq (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 crp)) (wceq (co (co (cfv (co A2 B2 cdiv) cfl) B2 cmul) (co A2 B2 cmo) caddc) A2) $;

--| Closure law for the modulo operation. (Contributed by Mario Carneiro, 28-May-2016.)
theorem modcld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wcel (co A2 B2 cmo) cr) $;

--| ` A mod B ` is zero iff ` A ` is evenly divisible by ` B ` . (Contributed by Jeff Madsen, 2-Sep-2009.) (Proof shortened by Fan Zheng, 7-Jun-2016.)
theorem mod0 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 crp)) (wb (wceq (co A2 B2 cmo) cc0) (wcel (co A2 B2 cdiv) cz)) $;

--| The product of an integer and a positive real number is 0 modulo the positive real number. (Contributed by Alexander van der Vekens, 17-May-2018.) (Revised by AV, 5-Jul-2020.)
theorem mulmod0 (A2 M: class):
  $ wi (wa (wcel A2 cz) (wcel M crp)) (wceq (co (co A2 M cmul) M cmo) cc0) $;

--| ` A ` is divisible by ` B ` iff its negative is. (Contributed by Jeff Madsen, 2-Sep-2009.) (Proof shortened by Fan Zheng, 7-Jun-2016.)
theorem negmod0 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 crp)) (wb (wceq (co A2 B2 cmo) cc0) (wceq (co (cneg A2) B2 cmo) cc0)) $;

--| The modulo operation is nonnegative. (Contributed by NM, 10-Nov-2008.)
theorem modge0 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 crp)) (wbr cc0 (co A2 B2 cmo) cle) $;

--| The modulo operation is less than its second argument. (Contributed by NM, 10-Nov-2008.)
theorem modlt (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 crp)) (wbr (co A2 B2 cmo) B2 clt) $;

--| Modular reduction produces a half-open interval. (Contributed by Stefan O'Rear, 12-Sep-2014.)
theorem modelico (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 crp)) (wcel (co A2 B2 cmo) (co cc0 B2 cico)) $;

--| Value of the modulo operation rewritten to give two ways of expressing the quotient when " ` A ` is divided by ` B ` using Euclidean division." Multiplying both sides by ` B ` , this implies that ` A mod B ` differs from ` A ` by an integer multiple of ` B ` . (Contributed by Jeff Madsen, 17-Jun-2010.) (Revised by Mario Carneiro, 6-Sep-2016.)
theorem moddiffl (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 crp)) (wceq (co (co A2 (co A2 B2 cmo) cmin) B2 cdiv) (cfv (co A2 B2 cdiv) cfl)) $;

--| The modulo operation differs from ` A ` by an integer multiple of ` B ` . (Contributed by Mario Carneiro, 15-Jul-2014.)
theorem moddifz (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 crp)) (wcel (co (co A2 (co A2 B2 cmo) cmin) B2 cdiv) cz) $;

--| The fractional part of a number is the number modulo 1. (Contributed by NM, 11-Nov-2008.)
theorem modfrac (A2: class):
  $ wi (wcel A2 cr) (wceq (co A2 c1 cmo) (co A2 (cfv A2 cfl) cmin)) $;

--| The floor function expressed in terms of the modulo operation. (Contributed by NM, 11-Nov-2008.)
theorem flmod (A2: class):
  $ wi (wcel A2 cr) (wceq (cfv A2 cfl) (co A2 (co A2 c1 cmo) cmin)) $;

--| Break a number into its integer part and its fractional part. (Contributed by NM, 31-Dec-2008.)
theorem intfrac (A2: class):
  $ wi (wcel A2 cr) (wceq A2 (co (cfv A2 cfl) (co A2 c1 cmo) caddc)) $;

--| An integer modulo 1 is 0. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem zmod10 (N: class):
  $ wi (wcel N cz) (wceq (co N c1 cmo) cc0) $;

--| Two arbitrary integers are congruent modulo 1, see example 4 in [ApostolNT] p. 107. (Contributed by AV, 21-Jul-2021.)
theorem zmod1congr (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cz)) (wceq (co A2 c1 cmo) (co B2 c1 cmo)) $;

--| Move a positive integer in and out of a floor in the first argument of a modulo operation. (Contributed by NM, 2-Jan-2009.)
theorem modmulnn (A2 M N: class):
  $ wi (w3a (wcel N cn) (wcel A2 cr) (wcel M cn)) (wbr (co (co N (cfv A2 cfl) cmul) (co N M cmul) cmo) (co (cfv (co N A2 cmul) cfl) (co N M cmul) cmo) cle) $;

--| The value of the modulo operation (expressed with sum of denominator and nominator). (Contributed by Alexander van der Vekens, 14-Apr-2018.)
theorem modvalp1 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 crp)) (wceq (co (co A2 B2 caddc) (co (co (cfv (co A2 B2 cdiv) cfl) c1 caddc) B2 cmul) cmin) (co A2 B2 cmo)) $;

--| Closure law for the modulo operation restricted to integers. (Contributed by NM, 27-Nov-2008.)
theorem zmodcl (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cn)) (wcel (co A2 B2 cmo) cn0) $;

--| Closure law for the modulo operation restricted to integers. (Contributed by Mario Carneiro, 28-May-2016.)
theorem zmodcld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wcel (co A2 B2 cmo) cn0) $;

--| An integer mod ` B ` lies in the first ` B ` nonnegative integers. (Contributed by Jeff Madsen, 17-Jun-2010.)
theorem zmodfz (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cn)) (wcel (co A2 B2 cmo) (co cc0 (co B2 c1 cmin) cfz)) $;

--| An integer mod ` B ` lies in the first ` B ` nonnegative integers. (Contributed by Stefan O'Rear, 6-Sep-2015.)
theorem zmodfzo (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cn)) (wcel (co A2 B2 cmo) (co cc0 B2 cfzo)) $;

--| An integer mod ` B ` lies in the first ` B + 1 ` nonnegative integers. (Contributed by AV, 27-Oct-2018.)
theorem zmodfzp1 (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cn)) (wcel (co A2 B2 cmo) (co cc0 B2 cfz)) $;

--| Identity law for modulo. (Contributed by NM, 29-Dec-2008.)
theorem modid (A2 B2: class):
  $ wi (wa (wa (wcel A2 cr) (wcel B2 crp)) (wa (wbr cc0 A2 cle) (wbr A2 B2 clt))) (wceq (co A2 B2 cmo) A2) $;

--| A positive real number modulo itself is 0. (Contributed by Alexander van der Vekens, 15-May-2018.)
theorem modid0 (N: class):
  $ wi (wcel N crp) (wceq (co N N cmo) cc0) $;

--| Identity law for modulo. (Contributed by NM, 29-Dec-2008.)
theorem modid2 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 crp)) (wb (wceq (co A2 B2 cmo) A2) (wa (wbr cc0 A2 cle) (wbr A2 B2 clt))) $;

--| Identity law for modulo restricted to integers. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem zmodid2 (M N: class):
  $ wi (wa (wcel M cz) (wcel N cn)) (wb (wceq (co M N cmo) M) (wcel M (co cc0 (co N c1 cmin) cfz))) $;

--| Identity law for modulo restricted to integers. (Contributed by AV, 27-Oct-2018.)
theorem zmodidfzo (M N: class):
  $ wi (wa (wcel M cz) (wcel N cn)) (wb (wceq (co M N cmo) M) (wcel M (co cc0 N cfzo))) $;

--| Identity law for modulo restricted to integers. (Contributed by AV, 27-Oct-2018.)
theorem zmodidfzoimp (M N: class):
  $ wi (wcel M (co cc0 N cfzo)) (wceq (co M N cmo) M) $;

--| Special case: 0 modulo a positive real number is 0. (Contributed by Mario Carneiro, 22-Feb-2014.)
theorem _0mod (N: class):
  $ wi (wcel N crp) (wceq (co cc0 N cmo) cc0) $;

--| Special case: 1 modulo a real number greater than 1 is 1. (Contributed by Mario Carneiro, 18-Feb-2014.)
theorem _1mod (N: class):
  $ wi (wa (wcel N cr) (wbr c1 N clt)) (wceq (co c1 N cmo) c1) $;

--| Absorption law for modulo. (Contributed by NM, 29-Dec-2008.)
theorem modabs (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cr) (wcel B2 crp) (wcel C crp)) (wbr B2 C cle)) (wceq (co (co A2 B2 cmo) C cmo) (co A2 B2 cmo)) $;

--| Absorption law for modulo. (Contributed by NM, 29-Dec-2008.)
theorem modabs2 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 crp)) (wceq (co (co A2 B2 cmo) B2 cmo) (co A2 B2 cmo)) $;

--| The modulo operation is periodic. (Contributed by NM, 10-Nov-2008.)
theorem modcyc (A2 B2 N: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 crp) (wcel N cz)) (wceq (co (co A2 (co N B2 cmul) caddc) B2 cmo) (co A2 B2 cmo)) $;

--| The modulo operation is periodic. (Contributed by NM, 12-Nov-2008.)
theorem modcyc2 (A2 B2 N: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 crp) (wcel N cz)) (wceq (co (co A2 (co B2 N cmul) cmin) B2 cmo) (co A2 B2 cmo)) $;

--| Addition property of the modulo operation. (Contributed by NM, 12-Nov-2008.)
theorem modadd1 (A2 B2 C D: class):
  $ wi (w3a (wa (wcel A2 cr) (wcel B2 cr)) (wa (wcel C cr) (wcel D crp)) (wceq (co A2 D cmo) (co B2 D cmo))) (wceq (co (co A2 C caddc) D cmo) (co (co B2 C caddc) D cmo)) $;

--| Addition property of the modulo operation. Biconditional version of ~ modadd1 by applying ~ modadd1 twice. (Contributed by AV, 14-Nov-2025.)
theorem modaddb (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cr) (wcel B2 cr)) (wa (wcel C cr) (wcel D crp))) (wb (wceq (co A2 D cmo) (co B2 D cmo)) (wceq (co (co A2 C caddc) D cmo) (co (co B2 C caddc) D cmo))) $;

--| The sums of two nonnegative integers less than the modulus and an integer are equal iff the two nonnegative integers are equal. (Contributed by AV, 14-Nov-2025.)
theorem modaddid (I K N X Y: class):
  $ wceq I (co cc0 N cfzo) $ >
  $ wi (w3a (wcel N (cfv c3 cuz)) (wa (wcel X I) (wcel Y I)) (wcel K cz)) (wb (wceq (co (co X K caddc) N cmo) (co (co Y K caddc) N cmo)) (wceq X Y)) $;

--| Absorption law for modulo. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem modaddabs (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C crp)) (wceq (co (co (co A2 C cmo) (co B2 C cmo) caddc) C cmo) (co (co A2 B2 caddc) C cmo)) $;

--| The sum of a real number modulo a positive real number and another real number equals the sum of the two real numbers modulo the positive real number. (Contributed by Alexander van der Vekens, 13-May-2018.)
theorem modaddmod (A2 B2 M: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel M crp)) (wceq (co (co (co A2 M cmo) B2 caddc) M cmo) (co (co A2 B2 caddc) M cmo)) $;

--| The sum of a positive real number less than an upper bound and the product of an integer and the upper bound is the positive real number modulo the upper bound. (Contributed by AV, 5-Jul-2020.)
theorem muladdmodid (A2 M N: class):
  $ wi (w3a (wcel N cz) (wcel M crp) (wcel A2 (co cc0 M cico))) (wceq (co (co (co N M cmul) A2 caddc) M cmo) A2) $;

--| The product of an integer and an integer greater than 1 increased by 1 is 1 modulo the integer greater than 1. (Contributed by AV, 15-Jul-2021.)
theorem mulp1mod1 (A2 N: class):
  $ wi (wa (wcel A2 cz) (wcel N (cfv c2 cuz))) (wceq (co (co (co N A2 cmul) c1 caddc) N cmo) c1) $;

--| A real number is the sum of the number and a multiple of a positive real number modulo the positive real number. (Contributed by AV, 7-Sep-2025.)
theorem muladdmod (A2 M N: class):
  $ wi (w3a (wcel A2 cr) (wcel M crp) (wcel N cz)) (wceq (co (co (co N M cmul) A2 caddc) M cmo) (co A2 M cmo)) $;

--| Decomposition of an integer into a multiple of a modulus and a remainder. (Contributed by AV, 14-Jul-2021.)
theorem modmuladd {k: setvar} (A2 B2 M: class):
  $ wi (w3a (wcel A2 cz) (wcel B2 (co cc0 M cico)) (wcel M crp)) (wb (wceq (co A2 M cmo) B2) (wrex k (wceq A2 (co (co (cv k) M cmul) B2 caddc)) cz)) $;

--| Implication of a decomposition of an integer into a multiple of a modulus and a remainder. (Contributed by AV, 14-Jul-2021.)
theorem modmuladdim {k: setvar} (A2 B2 M: class):
  $ wi (wa (wcel A2 cz) (wcel M crp)) (wi (wceq (co A2 M cmo) B2) (wrex k (wceq A2 (co (co (cv k) M cmul) B2 caddc)) cz)) $;

--| Implication of a decomposition of a nonnegative integer into a multiple of a modulus and a remainder. (Contributed by AV, 14-Jul-2021.)
theorem modmuladdnn0 {k: setvar} (A2 B2 M: class):
  $ wi (wa (wcel A2 cn0) (wcel M crp)) (wi (wceq (co A2 M cmo) B2) (wrex k (wceq A2 (co (co (cv k) M cmul) B2 caddc)) cn0)) $;

--| The negation of a number modulo a positive number is equal to the difference of the modulus and the number modulo the modulus. (Contributed by AV, 5-Jul-2020.)
theorem negmod (A2 N: class):
  $ wi (wa (wcel A2 cr) (wcel N crp)) (wceq (co (cneg A2) N cmo) (co (co N A2 cmin) N cmo)) $;

--| Minus one modulo a positive integer is equal to the integer minus one. (Contributed by AV, 14-Jul-2021.)
theorem m1modnnsub1 (M: class):
  $ wi (wcel M cn) (wceq (co (cneg c1) M cmo) (co M c1 cmin)) $;

--| Minus one modulo an integer greater than two is greater than one. (Contributed by AV, 14-Jul-2021.)
theorem m1modge3gt1 (M: class):
  $ wi (wcel M (cfv c3 cuz)) (wbr c1 (co (cneg c1) M cmo) clt) $;

--| The sum of a positive integer and a nonnegative integer less than the positive integer is equal to the nonnegative integer modulo the positive integer. (Contributed by Alexander van der Vekens, 30-Oct-2018.) (Proof shortened by AV, 5-Jul-2020.)
theorem addmodid (A2 M: class):
  $ wi (w3a (wcel A2 cn0) (wcel M cn) (wbr A2 M clt)) (wceq (co (co M A2 caddc) M cmo) A2) $;

--| The sum of a positive integer and a nonnegative integer less than the positive integer is equal to the nonnegative integer modulo the positive integer. (Contributed by AV, 19-Mar-2021.)
theorem addmodidr (A2 M: class):
  $ wi (w3a (wcel A2 cn0) (wcel M cn) (wbr A2 M clt)) (wceq (co (co A2 M caddc) M cmo) A2) $;

--| The sum of a real number modulo a positive real number and another real number equals the sum of the two real numbers modulo the positive real number. (Contributed by Alexander van der Vekens, 17-May-2018.)
theorem modadd2mod (A2 B2 M: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel M crp)) (wceq (co (co B2 (co A2 M cmo) caddc) M cmo) (co (co B2 A2 caddc) M cmo)) $;

--| If a real number modulo a positive real number equals the positive real number decreased by 1, the real number increased by 1 modulo the positive real number equals 0. (Contributed by AV, 2-Nov-2018.)
theorem modm1p1mod0 (A2 M: class):
  $ wi (wa (wcel A2 cr) (wcel M crp)) (wi (wceq (co A2 M cmo) (co M c1 cmin)) (wceq (co (co A2 c1 caddc) M cmo) cc0)) $;

--| If a real number modulo a positive real number is less than the positive real number decreased by 1, the real number increased by 1 modulo the positive real number equals the real number modulo the positive real number increased by 1. (Contributed by AV, 2-Nov-2018.)
theorem modltm1p1mod (A2 M: class):
  $ wi (w3a (wcel A2 cr) (wcel M crp) (wbr (co A2 M cmo) (co M c1 cmin) clt)) (wceq (co (co A2 c1 caddc) M cmo) (co (co A2 M cmo) c1 caddc)) $;

--| Multiplication property of the modulo operation. Note that the multiplier ` C ` must be an integer. (Contributed by NM, 12-Nov-2008.)
theorem modmul1 (A2 B2 C D: class):
  $ wi (w3a (wa (wcel A2 cr) (wcel B2 cr)) (wa (wcel C cz) (wcel D crp)) (wceq (co A2 D cmo) (co B2 D cmo))) (wceq (co (co A2 C cmul) D cmo) (co (co B2 C cmul) D cmo)) $;

--| Multiplication property of the modulo operation, see theorem 5.2(b) in [ApostolNT] p. 107. (Contributed by Mario Carneiro, 5-Feb-2015.)
theorem modmul12d (ph: wff) (A2 B2 C D E: class):
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wcel B2 cz) $ >
  $ wi ph (wcel C cz) $ >
  $ wi ph (wcel D cz) $ >
  $ wi ph (wcel E crp) $ >
  $ wi ph (wceq (co A2 E cmo) (co B2 E cmo)) $ >
  $ wi ph (wceq (co C E cmo) (co D E cmo)) $ >
  $ wi ph (wceq (co (co A2 C cmul) E cmo) (co (co B2 D cmul) E cmo)) $;

--| Negation property of the modulo operation. (Contributed by Mario Carneiro, 9-Sep-2016.)
theorem modnegd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C crp) $ >
  $ wi ph (wceq (co A2 C cmo) (co B2 C cmo)) $ >
  $ wi ph (wceq (co (cneg A2) C cmo) (co (cneg B2) C cmo)) $;

--| Additive property of the modulo operation. (Contributed by Mario Carneiro, 9-Sep-2016.)
theorem modadd12d (ph: wff) (A2 B2 C D E: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wcel D cr) $ >
  $ wi ph (wcel E crp) $ >
  $ wi ph (wceq (co A2 E cmo) (co B2 E cmo)) $ >
  $ wi ph (wceq (co C E cmo) (co D E cmo)) $ >
  $ wi ph (wceq (co (co A2 C caddc) E cmo) (co (co B2 D caddc) E cmo)) $;

--| Subtraction property of the modulo operation. (Contributed by Mario Carneiro, 9-Sep-2016.)
theorem modsub12d (ph: wff) (A2 B2 C D E: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wcel D cr) $ >
  $ wi ph (wcel E crp) $ >
  $ wi ph (wceq (co A2 E cmo) (co B2 E cmo)) $ >
  $ wi ph (wceq (co C E cmo) (co D E cmo)) $ >
  $ wi ph (wceq (co (co A2 C cmin) E cmo) (co (co B2 D cmin) E cmo)) $;

--| The difference of a real number modulo a positive real number and another real number equals the difference of the two real numbers modulo the positive real number. (Contributed by Alexander van der Vekens, 17-May-2018.)
theorem modsubmod (A2 B2 M: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel M crp)) (wceq (co (co (co A2 M cmo) B2 cmin) M cmo) (co (co A2 B2 cmin) M cmo)) $;

--| The difference of a real number modulo a positive real number and another real number modulo this positive real number equals the difference of the two real numbers modulo the positive real number. (Contributed by Alexander van der Vekens, 17-May-2018.)
theorem modsubmodmod (A2 B2 M: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel M crp)) (wceq (co (co (co A2 M cmo) (co B2 M cmo) cmin) M cmo) (co (co A2 B2 cmin) M cmo)) $;

--| Two times a positive real number modulo the real number is zero. (Contributed by Alexander van der Vekens, 8-Jun-2018.)
theorem _2txmodxeq0 (X: class):
  $ wi (wcel X crp) (wceq (co (co c2 X cmul) X cmo) cc0) $;

--| If a real number is between a positive real number and twice the positive real number, the real number modulo the positive real number equals the real number minus the positive real number. (Contributed by Alexander van der Vekens, 13-May-2018.)
theorem _2submod (A2 B2: class):
  $ wi (wa (wa (wcel A2 cr) (wcel B2 crp)) (wa (wbr B2 A2 cle) (wbr A2 (co c2 B2 cmul) clt))) (wceq (co A2 B2 cmo) (co A2 B2 cmin)) $;

--| If a nonnegative integer is less than twice a positive integer, the nonnegative integer modulo the positive integer equals the nonnegative integer or the nonnegative integer minus the positive integer. (Contributed by Alexander van der Vekens, 21-May-2018.)
theorem modifeq2int (A2 B2: class):
  $ wi (w3a (wcel A2 cn0) (wcel B2 cn) (wbr A2 (co c2 B2 cmul) clt)) (wceq (co A2 B2 cmo) (cif (wbr A2 B2 clt) A2 (co A2 B2 cmin))) $;

--| The sum of an integer modulo a positive integer and another integer minus the positive integer equals the sum of the two integers modulo the positive integer if the other integer is in the upper part of the range between 0 and the positive integer. (Contributed by AV, 30-Oct-2018.)
theorem modaddmodup (A2 B2 M: class):
  $ wi (wa (wcel A2 cz) (wcel M cn)) (wi (wcel B2 (co (co M (co A2 M cmo) cmin) M cfzo)) (wceq (co (co B2 (co A2 M cmo) caddc) M cmin) (co (co B2 A2 caddc) M cmo))) $;

--| The sum of an integer modulo a positive integer and another integer equals the sum of the two integers modulo the positive integer if the other integer is in the lower part of the range between 0 and the positive integer. (Contributed by AV, 30-Oct-2018.)
theorem modaddmodlo (A2 B2 M: class):
  $ wi (wa (wcel A2 cz) (wcel M cn)) (wi (wcel B2 (co cc0 (co M (co A2 M cmo) cmin) cfzo)) (wceq (co B2 (co A2 M cmo) caddc) (co (co B2 A2 caddc) M cmo))) $;

--| The product of a real number modulo a positive real number and an integer equals the product of the real number and the integer modulo the positive real number. (Contributed by Alexander van der Vekens, 17-May-2018.)
theorem modmulmod (A2 B2 M: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cz) (wcel M crp)) (wceq (co (co (co A2 M cmo) B2 cmul) M cmo) (co (co A2 B2 cmul) M cmo)) $;

--| The product of an integer and a real number modulo a positive real number equals the product of the integer and the real number modulo the positive real number. (Contributed by Alexander van der Vekens, 9-Jul-2021.)
theorem modmulmodr (A2 B2 M: class):
  $ wi (w3a (wcel A2 cz) (wcel B2 cr) (wcel M crp)) (wceq (co (co A2 (co B2 M cmo) cmul) M cmo) (co (co A2 B2 cmul) M cmo)) $;

--| The sum of a real number and the product of a second real number modulo a positive real number and an integer equals the sum of the real number and the product of the other real number and the integer modulo the positive real number. (Contributed by Alexander van der Vekens, 17-May-2018.)
theorem modaddmulmod (A2 B2 C M: class):
  $ wi (wa (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cz)) (wcel M crp)) (wceq (co (co A2 (co (co B2 M cmo) C cmul) caddc) M cmo) (co (co A2 (co B2 C cmul) caddc) M cmo)) $;

--| Distribute multiplication over a modulo operation. (Contributed by NM, 11-Nov-2008.)
theorem moddi (A2 B2 C: class):
  $ wi (w3a (wcel A2 crp) (wcel B2 cr) (wcel C crp)) (wceq (co A2 (co B2 C cmo) cmul) (co (co A2 B2 cmul) (co A2 C cmul) cmo)) $;

--| Distribute the modulo operation over a subtraction. (Contributed by NM, 30-Dec-2008.)
theorem modsubdir (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C crp)) (wb (wbr (co B2 C cmo) (co A2 C cmo) cle) (wceq (co (co A2 B2 cmin) C cmo) (co (co A2 C cmo) (co B2 C cmo) cmin))) $;

--| A real number equals the difference of the real number and a positive real number modulo the positive real number. (Contributed by AV, 3-Nov-2018.)
theorem modeqmodmin (A2 M: class):
  $ wi (wa (wcel A2 cr) (wcel M crp)) (wceq (co A2 M cmo) (co (co A2 M cmin) M cmo)) $;

--| A number modulo an irrational multiple of it is nonzero. (Contributed by NM, 11-Nov-2008.)
theorem modirr (A2 B2: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 crp) (wcel (co A2 B2 cdiv) (cdif cr cq))) (wne (co A2 B2 cmo) cc0) $;

--| For a number within a half-open range of nonnegative integers with one excluded integer there is a positive integer so that the number is equal to the sum of the positive integer and the excluded integer modulo the upper bound of the range. (Contributed by AV, 19-Mar-2021.)
theorem modfzo0difsn {i: setvar} (J K N: class):
  $ wi (wa (wcel J (co cc0 N cfzo)) (wcel K (cdif (co cc0 N cfzo) (csn J)))) (wrex i (wceq K (co (co (cv i) J caddc) N cmo)) (co c1 N cfzo)) $;

--| The sum of a number within a half-open range of positive integers is an element of the corresponding open range of nonnegative integers with one excluded integer modulo the excluded integer. (Contributed by AV, 19-Mar-2021.)
theorem modsumfzodifsn (J K N: class):
  $ wi (wa (wcel J (co cc0 N cfzo)) (wcel K (co c1 N cfzo))) (wcel (co (co K J caddc) N cmo) (cdif (co cc0 N cfzo) (csn J))) $;

--| Two nonnegative integers less than the modulus are equal iff they are equal modulo the modulus. (Contributed by AV, 14-Mar-2021.)
theorem modlteq (I J N: class):
  $ wi (wa (wcel I (co cc0 N cfzo)) (wcel J (co cc0 N cfzo))) (wb (wceq (co I N cmo) (co J N cmo)) (wceq I J)) $;

--| Two nonnegative integers less than the modulus are equal iff the sums of these integer with another integer are equal modulo the modulus. A much shorter proof exists if the "divides" relation ` || ` can be used, see ~ addmodlteqALT . (Contributed by AV, 20-Mar-2021.)
theorem addmodlteq (S I J N: class):
  $ wi (w3a (wcel I (co cc0 N cfzo)) (wcel J (co cc0 N cfzo)) (wcel S cz)) (wb (wceq (co (co I S caddc) N cmo) (co (co J S caddc) N cmo)) (wceq I J)) $;

--| The mapping ` G ` is a one-to-one mapping from ` _om ` onto upper integers that will be used to construct a recursive definition generator. Ordinal natural number 0 maps to complex number ` C ` (normally 0 for the upper integers ` NN0 ` or 1 for the upper integers ` NN ` ), 1 maps to ` C ` + 1, etc. This theorem shows the value of ` G ` at ordinal natural number zero. (This series of theorems generalizes an earlier series for ` NN0 ` contributed by Raph Levien, 10-Apr-2004.) (Contributed by NM, 3-Oct-2004.) (Revised by Mario Carneiro, 13-Sep-2013.)
theorem om2uz0i {x3: setvar} (C: class) (G: class x3):
  $ wcel C cz $ >
  $ wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1 caddc)) C) com) $ >
  $ wceq (cfv c0 G) C $;

--| The value of ` G ` (see ~ om2uz0i ) at a successor. (Contributed by NM, 3-Oct-2004.) (Revised by Mario Carneiro, 13-Sep-2013.)
theorem om2uzsuci {x3: setvar} (A2: class x3) (C: class) (G: class x3):
  $ wcel C cz $ >
  $ wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1 caddc)) C) com) $ >
  $ wi (wcel A2 com) (wceq (cfv (csuc A2) G) (co (cfv A2 G) c1 caddc)) $;

--| The value ` G ` (see ~ om2uz0i ) at an ordinal natural number is in the upper integers. (Contributed by NM, 3-Oct-2004.) (Revised by Mario Carneiro, 13-Sep-2013.)
theorem om2uzuzi {x3: setvar} (A2: class x3) (C: class) (G: class x3):
  $ wcel C cz $ >
  $ wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1 caddc)) C) com) $ >
  $ wi (wcel A2 com) (wcel (cfv A2 G) (cfv C cuz)) $;

--| Less-than relation for ` G ` (see ~ om2uz0i ). (Contributed by NM, 3-Oct-2004.) (Revised by Mario Carneiro, 13-Sep-2013.)
theorem om2uzlti {x3: setvar} (A2 B2: class x3) (C: class) (G: class x3):
  $ wcel C cz $ >
  $ wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1 caddc)) C) com) $ >
  $ wi (wa (wcel A2 com) (wcel B2 com)) (wi (wcel A2 B2) (wbr (cfv A2 G) (cfv B2 G) clt)) $;

--| The mapping ` G ` (see ~ om2uz0i ) preserves order. (Contributed by NM, 4-May-2005.) (Revised by Mario Carneiro, 13-Sep-2013.)
theorem om2uzlt2i {x3: setvar} (A2 B2: class x3) (C: class) (G: class x3):
  $ wcel C cz $ >
  $ wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1 caddc)) C) com) $ >
  $ wi (wa (wcel A2 com) (wcel B2 com)) (wb (wcel A2 B2) (wbr (cfv A2 G) (cfv B2 G) clt)) $;

--| Range of ` G ` (see ~ om2uz0i ). (Contributed by NM, 3-Oct-2004.) (Revised by Mario Carneiro, 13-Sep-2013.)
theorem om2uzrani {x3: setvar} (C: class) (G: class x3):
  $ wcel C cz $ >
  $ wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1 caddc)) C) com) $ >
  $ wceq (crn G) (cfv C cuz) $;

--| ` G ` (see ~ om2uz0i ) is a one-to-one onto mapping. (Contributed by NM, 3-Oct-2004.) (Revised by Mario Carneiro, 13-Sep-2013.)
theorem om2uzf1oi {x3: setvar} (C: class) (G: class x3):
  $ wcel C cz $ >
  $ wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1 caddc)) C) com) $ >
  $ wf1o com (cfv C cuz) G $;

--| ` G ` (see ~ om2uz0i ) is an isomorphism from natural ordinals to upper integers. (Contributed by NM, 9-Oct-2008.) (Revised by Mario Carneiro, 13-Sep-2013.)
theorem om2uzisoi {x3: setvar} (C: class) (G: class x3):
  $ wcel C cz $ >
  $ wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1 caddc)) C) com) $ >
  $ wiso com (cfv C cuz) cep clt G $;

--| An alternative definition of ` G ` in terms of ~ df-oi . (Contributed by Mario Carneiro, 2-Jun-2015.)
theorem om2uzoi {x3: setvar} (C: class) (G: class x3):
  $ wcel C cz $ >
  $ wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1 caddc)) C) com) $ >
  $ wceq G (coi (cfv C cuz) clt) $;

--| A helper lemma for the value of a recursive definition generator on upper integers (typically either ` NN ` or ` NN0 ` ) with characteristic function ` F ( x , y ) ` and initial value ` A ` . Normally ` F ` is a function on the partition, and ` A ` is a member of the partition. See also comment in ~ om2uz0i . (Contributed by Mario Carneiro, 26-Jun-2013.) (Revised by Mario Carneiro, 18-Nov-2014.)
theorem om2uzrdg {x3 y1: setvar} (A2: class x3) (B2: class x3 y1) (C: class) (R: class x3 y1) (F: class) (G: class x3):
  $ wcel C cz $ >
  $ wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1 caddc)) C) com) $ >
  $ wcel A2 cvv $ >
  $ wceq R (cres (crdg (cmpo x3 y1 cvv cvv (cop (co (cv x3) c1 caddc) (co (cv x3) (cv y1) F))) (cop C A2)) com) $ >
  $ wi (wcel B2 com) (wceq (cfv B2 R) (cop (cfv B2 G) (cfv (cfv B2 R) c2nd))) $;

--| A helper lemma for the value of a recursive definition generator on upper integers. (Contributed by Mario Carneiro, 26-Jun-2013.) (Revised by Mario Carneiro, 18-Nov-2014.)
theorem uzrdglem {x3 y1: setvar} (A2: class x3) (B2: class x3 y1) (C: class) (R: class x3 y1) (F: class) (G: class x3):
  $ wcel C cz $ >
  $ wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1 caddc)) C) com) $ >
  $ wcel A2 cvv $ >
  $ wceq R (cres (crdg (cmpo x3 y1 cvv cvv (cop (co (cv x3) c1 caddc) (co (cv x3) (cv y1) F))) (cop C A2)) com) $ >
  $ wi (wcel B2 (cfv C cuz)) (wcel (cop B2 (cfv (cfv (cfv B2 (ccnv G)) R) c2nd)) (crn R)) $;

--| The recursive definition generator on upper integers is a function. See comment in ~ om2uzrdg . (Contributed by Mario Carneiro, 26-Jun-2013.) (Revised by Mario Carneiro, 4-May-2015.)
theorem uzrdgfni {x3 y1: setvar} (A2: class x3) (C: class) (R S: class x3 y1) (F: class) (G: class x3):
  $ wcel C cz $ >
  $ wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1 caddc)) C) com) $ >
  $ wcel A2 cvv $ >
  $ wceq R (cres (crdg (cmpo x3 y1 cvv cvv (cop (co (cv x3) c1 caddc) (co (cv x3) (cv y1) F))) (cop C A2)) com) $ >
  $ wceq S (crn R) $ >
  $ wfn S (cfv C cuz) $;

--| Initial value of a recursive definition generator on upper integers. See comment in ~ om2uzrdg . (Contributed by Mario Carneiro, 26-Jun-2013.) (Revised by Mario Carneiro, 18-Nov-2014.)
theorem uzrdg0i {x3 y1: setvar} (A2: class x3) (C: class) (R S: class x3 y1) (F: class) (G: class x3):
  $ wcel C cz $ >
  $ wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1 caddc)) C) com) $ >
  $ wcel A2 cvv $ >
  $ wceq R (cres (crdg (cmpo x3 y1 cvv cvv (cop (co (cv x3) c1 caddc) (co (cv x3) (cv y1) F))) (cop C A2)) com) $ >
  $ wceq S (crn R) $ >
  $ wceq (cfv C S) A2 $;

--| Successor value of a recursive definition generator on upper integers. See comment in ~ om2uzrdg . (Contributed by Mario Carneiro, 26-Jun-2013.) (Revised by Mario Carneiro, 13-Sep-2013.)
theorem uzrdgsuci {x3 y1: setvar} (A2: class x3) (B2: class x3 y1) (C: class) (R S: class x3 y1) (F: class) (G: class x3):
  $ wcel C cz $ >
  $ wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1 caddc)) C) com) $ >
  $ wcel A2 cvv $ >
  $ wceq R (cres (crdg (cmpo x3 y1 cvv cvv (cop (co (cv x3) c1 caddc) (co (cv x3) (cv y1) F))) (cop C A2)) com) $ >
  $ wceq S (crn R) $ >
  $ wi (wcel B2 (cfv C cuz)) (wceq (cfv (co B2 c1 caddc) S) (co B2 (cfv B2 S) F)) $;

--| ` < ` is a well-founded relation on any sequence of upper integers. (Contributed by Andrew Salmon, 13-Nov-2011.) (Revised by Mario Carneiro, 26-Jun-2015.)
theorem ltweuz (A2: class):
  $ wwe (cfv A2 cuz) clt $;

--| Less than well-orders the naturals. (Contributed by Scott Fenton, 6-Aug-2013.)
theorem ltwenn:
  $ wwe cn clt $;

--| Less than well-orders a set of finite integers. (Contributed by Scott Fenton, 8-Aug-2013.)
theorem ltwefz (M N: class):
  $ wwe (co M N cfz) clt $;

--| An upper integer set is denumerable. (Contributed by Mario Carneiro, 15-Oct-2015.)
theorem uzenom (M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi (wcel M cz) (wbr Z com cen) $;

--| An upper integer set is infinite. (Contributed by Mario Carneiro, 12-Mar-2015.) (Revised by Mario Carneiro, 26-Jun-2015.)
theorem uzinf (M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi (wcel M cz) (wn (wcel Z cfn)) $;

--| The set of positive integers is infinite. (Contributed by Glauco Siliprandi, 11-Oct-2020.)
theorem nnnfi:
  $ wn (wcel cn cfn) $;

--| Transfer the value of the recursive sequence builder from one base to another. (Contributed by Mario Carneiro, 1-Apr-2014.)
theorem uzrdgxfr {x3: setvar} (A2 B2: class) (G H N: class x3):
  $ wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1 caddc)) A2) com) $ >
  $ wceq H (cres (crdg (cmpt x3 cvv (co (cv x3) c1 caddc)) B2) com) $ >
  $ wcel A2 cz $ >
  $ wcel B2 cz $ >
  $ wi (wcel N com) (wceq (cfv N G) (co (cfv N H) (co A2 B2 cmin) caddc)) $;

--| The cardinality of a finite set of sequential integers. (See ~ om2uz0i for a description of the hypothesis.) (Contributed by Mario Carneiro, 12-Feb-2013.) (Revised by Mario Carneiro, 7-Mar-2014.)
theorem fzennn {x3: setvar} (G N: class x3):
  $ wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1 caddc)) cc0) com) $ >
  $ wi (wcel N cn0) (wbr (co c1 N cfz) (cfv N (ccnv G)) cen) $;

--| The cardinality of a finite set of sequential integers with arbitrary endpoints. (Contributed by Mario Carneiro, 13-Feb-2014.)
theorem fzen2 {x3: setvar} (G M N: class x3):
  $ wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1 caddc)) cc0) com) $ >
  $ wi (wcel N (cfv M cuz)) (wbr (co M N cfz) (cfv (co (co N c1 caddc) M cmin) (ccnv G)) cen) $;

--| The cardinality of a finite set of sequential integers. (See ~ om2uz0i for a description of the hypothesis.) (Contributed by NM, 7-Nov-2008.) (Revised by Mario Carneiro, 15-Sep-2013.)
theorem cardfz {x3: setvar} (G N: class x3):
  $ wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1 caddc)) cc0) com) $ >
  $ wi (wcel N cn0) (wceq (cfv (co c1 N cfz) ccrd) (cfv N (ccnv G))) $;

--| ` G ` maps ` _om ` one-to-one onto ` NN0 ` . (Contributed by Paul Chapman, 22-Jun-2011.) (Revised by Mario Carneiro, 13-Sep-2013.)
theorem hashgf1o {x3: setvar} (G: class x3):
  $ wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1 caddc)) cc0) com) $ >
  $ wf1o com cn0 G $;

--| A finite interval of integers is finite. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 12-Mar-2015.)
theorem fzfi (M N: class):
  $ wcel (co M N cfz) cfn $;

--| Commonly used special case of ~ fzfi . (Contributed by Mario Carneiro, 25-May-2014.)
theorem fzfid (ph: wff) (M N: class):
  $ wi ph (wcel (co M N cfz) cfn) $;

--| Half-open integer sets are finite. (Contributed by Stefan O'Rear, 15-Aug-2015.)
theorem fzofi (M N: class):
  $ wcel (co M N cfzo) cfn $;

--| The values of a finite real sequence have an upper bound. (Contributed by NM, 19-Sep-2005.) (Proof shortened by Mario Carneiro, 28-Apr-2015.)
theorem fsequb {x3 k: setvar} (F M N: class):
  $ wi (wral k (wcel (cfv (cv k) F) cr) (co M N cfz)) (wrex x3 (wral k (wbr (cfv (cv k) F) (cv x3) clt) (co M N cfz)) cr) $;

--| The values of a finite real sequence have an upper bound. (Contributed by NM, 20-Sep-2005.) (Proof shortened by Mario Carneiro, 28-Apr-2015.)
theorem fsequb2 {x3 y1: setvar} (F M N: class):
  $ wi (wf (co M N cfz) cr F) (wrex x3 (wral y1 (wbr (cv y1) (cv x3) cle) (crn F)) cr) $;

--| The values of a finite real sequence have a supremum. (Contributed by NM, 20-Sep-2005.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem fseqsupcl (F M N: class):
  $ wi (wa (wcel N (cfv M cuz)) (wf (co M N cfz) cr F)) (wcel (csup (crn F) cr clt) cr) $;

--| The values of a finite real sequence are bounded by their supremum. (Contributed by NM, 20-Sep-2005.)
theorem fseqsupubi (F K M N: class):
  $ wi (wa (wcel K (co M N cfz)) (wf (co M N cfz) cr F)) (wbr (cfv K F) (csup (crn F) cr clt) cle) $;

--| The nonnegative integers are equinumerous to the positive integers. (Contributed by NM, 19-Jul-2004.)
theorem nn0ennn:
  $ wbr cn0 cn cen $;

--| The set of positive integers (as a subset of complex numbers) is equinumerous to omega (the set of finite ordinal numbers). (Contributed by NM, 31-Jul-2004.) (Revised by Mario Carneiro, 15-Sep-2013.)
theorem nnenom:
  $ wbr cn com cen $;

--| ` NN ` is countable. (Contributed by Thierry Arnoux, 29-Dec-2016.)
theorem nnct:
  $ wbr cn com cdom $;

--| Indirect strong induction on the upper integers. (Contributed by Stefan O'Rear, 25-Aug-2015.)
theorem uzindi {x3 y1: setvar} (ph: wff) (ps: wff x3) (ch th: wff y1) (A2: class y1) (R: class x3) (S: class y1) (T L: class) (V: class x3 y1):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel T (cfv L cuz)) $ >
  $ wi (w3a ph (wcel R (co L T cfz)) (wal y1 (wi (wcel S (co L R cfzo)) ch))) ps $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ps ch) $ >
  $ wi (wceq (cv x3) A2) (wb ps th) $ >
  $ wi (wceq (cv x3) (cv y1)) (wceq R S) $ >
  $ wi (wceq (cv x3) A2) (wceq R T) $ >
  $ wi ph th $;

--| Lemma for ~ axdc4uz . (Contributed by Mario Carneiro, 8-Jan-2014.) (Revised by Mario Carneiro, 26-Dec-2014.)
theorem axdc4uzlem {x3 y1 g2 k n: setvar} (A2: class y1) (C: class x3 y1 k n) (F G: class y1) (H: class x3 y1 g2 n) (M: class) (Z: class y1 k):
  $ wcel M cz $ >
  $ wceq Z (cfv M cuz) $ >
  $ wcel A2 cvv $ >
  $ wceq G (cres (crdg (cmpt y1 cvv (co (cv y1) c1 caddc)) M) com) $ >
  $ wceq H (cmpo n x3 com A2 (co (cfv (cv n) G) (cv x3) F)) $ >
  $ wi (wa (wcel C A2) (wf (cxp Z A2) (cdif (cpw A2) (csn c0)) F)) (wex g2 (w3a (wf Z A2 (cv g2)) (wceq (cfv M (cv g2)) C) (wral k (wcel (cfv (co (cv k) c1 caddc) (cv g2)) (co (cv k) (cfv (cv k) (cv g2)) F)) Z))) $;

--| A version of ~ axdc4 that works on an upper set of integers instead of ` _om ` . (Contributed by Mario Carneiro, 8-Jan-2014.)
theorem axdc4uz {g2 k: setvar} (A2: class) (C: class k) (F M: class) (V: class g2 k) (Z: class k):
  $ wcel M cz $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi (w3a (wcel A2 V) (wcel C A2) (wf (cxp Z A2) (cdif (cpw A2) (csn c0)) F)) (wex g2 (w3a (wf Z A2 (cv g2)) (wceq (cfv M (cv g2)) C) (wral k (wcel (cfv (co (cv k) c1 caddc) (cv g2)) (co (cv k) (cfv (cv k) (cv g2)) F)) Z))) $;

--| A subset of the nonnegative integers is finite if and only if there is a nonnegative integer so that all integers greater than this integer are not contained in the subset. (Contributed by AV, 3-Oct-2019.)
theorem ssnn0fi {x3 s1: setvar} (S: class):
  $ wi (wss S cn0) (wb (wcel S cfn) (wrex s1 (wral x3 (wi (wbr (cv s1) (cv x3) clt) (wnel (cv x3) S)) cn0) cn0)) $;

--| A subset of the nonnegative integers defined by a restricted class abstraction is finite if there is a nonnegative integer so that for all integers greater than this integer the condition of the class abstraction is not fulfilled. (Contributed by AV, 3-Oct-2019.)
theorem rabssnn0fi {x3 s1: setvar} (ph: wff x3):
  $ wb (wcel (crab x3 ph cn0) cfn) (wrex s1 (wral x3 (wi (wbr (cv s1) (cv x3) clt) (wn ph)) cn0) cn0) $;

--| Strong (or "total") induction principle over an upper set of integers. (Contributed by Scott Fenton, 16-May-2014.)
theorem uzsinds {x3 y1: setvar} (ph: wff x3) (ps ch: wff y1) (M: class) (N: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wceq (cv x3) N) (wb ph ch) $ >
  $ wi (wcel (cv x3) (cfv M cuz)) (wi (wral y1 ps (co M (co (cv x3) c1 cmin) cfz)) ph) $ >
  $ wi (wcel N (cfv M cuz)) ch $;

--| Strong (or "total") induction principle over the naturals. (Contributed by Scott Fenton, 16-May-2014.)
theorem nnsinds {x3 y1: setvar} (ph: wff x3) (ps ch: wff y1) (N: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wceq (cv x3) N) (wb ph ch) $ >
  $ wi (wcel (cv x3) cn) (wi (wral y1 ps (co c1 (co (cv x3) c1 cmin) cfz)) ph) $ >
  $ wi (wcel N cn) ch $;

--| Strong (or "total") induction principle over the nonnegative integers. (Contributed by Scott Fenton, 16-May-2014.)
theorem nn0sinds {x3 y1: setvar} (ph: wff x3) (ps ch: wff y1) (N: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wceq (cv x3) N) (wb ph ch) $ >
  $ wi (wcel (cv x3) cn0) (wi (wral y1 ps (co cc0 (co (cv x3) c1 cmin) cfz)) ph) $ >
  $ wi (wcel N cn0) ch $;

--| Lemma for ~ fsuppmapnn0fiub and ~ fsuppmapnn0fiubex . (Contributed by AV, 2-Oct-2019.)
theorem fsuppmapnn0fiublem {f2: setvar} (R: class) (S: class f2) (U M V Z: class):
  $ wceq U (ciun f2 M (co (cv f2) Z csupp)) $ >
  $ wceq S (csup U cr clt) $ >
  $ wi (w3a (wss M (co R cn0 cmap)) (wcel M cfn) (wcel Z V)) (wi (wa (wral f2 (wbr (cv f2) Z cfsupp) M) (wne U c0)) (wcel S cn0)) $;

--| If all functions of a finite set of functions over the nonnegative integers are finitely supported, then the support of all these functions is contained in a finite set of sequential integers starting at 0 and ending with the supremum of the union of the support of these functions. (Contributed by AV, 2-Oct-2019.) (Proof shortened by JJ, 2-Aug-2021.)
theorem fsuppmapnn0fiub {f2: setvar} (R: class) (S: class f2) (U M V Z: class):
  $ wceq U (ciun f2 M (co (cv f2) Z csupp)) $ >
  $ wceq S (csup U cr clt) $ >
  $ wi (w3a (wss M (co R cn0 cmap)) (wcel M cfn) (wcel Z V)) (wi (wa (wral f2 (wbr (cv f2) Z cfsupp) M) (wne U c0)) (wral f2 (wss (co (cv f2) Z csupp) (co cc0 S cfz)) M)) $;

--| If all functions of a finite set of functions over the nonnegative integers are finitely supported, then the support of all these functions is contained in a finite set of sequential integers starting at 0. (Contributed by AV, 2-Oct-2019.)
theorem fsuppmapnn0fiubex {f2 m: setvar} (R M V Z: class):
  $ wi (w3a (wss M (co R cn0 cmap)) (wcel M cfn) (wcel Z V)) (wi (wral f2 (wbr (cv f2) Z cfsupp) M) (wrex m (wral f2 (wss (co (cv f2) Z csupp) (co cc0 (cv m) cfz)) M) cn0)) $;

--| If all functions of a finite set of functions over the nonnegative integers are finitely supported, then all these functions are zero for all integers greater than a fixed integer. (Contributed by AV, 3-Oct-2019.)
theorem fsuppmapnn0fiub0 {x3 f2 m: setvar} (R M V Z: class):
  $ wi (w3a (wss M (co R cn0 cmap)) (wcel M cfn) (wcel Z V)) (wi (wral f2 (wbr (cv f2) Z cfsupp) M) (wrex m (wral f2 (wral x3 (wi (wbr (cv m) (cv x3) clt) (wceq (cfv (cv x3) (cv f2)) Z)) cn0) M) cn0)) $;

--| Condition for a function over the nonnegative integers to have a support contained in a finite set of sequential integers. (Contributed by AV, 9-Oct-2019.)
theorem suppssfz {x3: setvar} (ph: wff x3) (B2: class x3) (S F: class) (V: class x3) (Z: class):
  $ wi ph (wcel Z V) $ >
  $ wi ph (wcel F (co B2 cn0 cmap)) $ >
  $ wi ph (wcel S cn0) $ >
  $ wi ph (wral x3 (wi (wbr S (cv x3) clt) (wceq (cfv (cv x3) F) Z)) cn0) $ >
  $ wi ph (wss (co F Z csupp) (co cc0 S cfz)) $;

--| If a function over the nonnegative integers is finitely supported, then there is an upper bound for the arguments resulting in nonzero values. (Contributed by AV, 6-Oct-2019.)
theorem fsuppmapnn0ub {x3 m: setvar} (R: class x3 m) (F: class) (V: class m) (Z: class):
  $ wi (wa (wcel F (co R cn0 cmap)) (wcel Z V)) (wi (wbr F Z cfsupp) (wrex m (wral x3 (wi (wbr (cv m) (cv x3) clt) (wceq (cfv (cv x3) F) Z)) cn0) cn0)) $;

--| If a function over the nonnegative integers is finitely supported, then there is an upper bound for a finite set of sequential integers containing the support of the function. (Contributed by AV, 30-Sep-2019.) (Proof shortened by AV, 6-Oct-2019.)
theorem fsuppmapnn0fz {m: setvar} (R F V Z: class):
  $ wi (wa (wcel F (co R cn0 cmap)) (wcel Z V)) (wi (wbr F Z cfsupp) (wrex m (wss (co F Z csupp) (co cc0 (cv m) cfz)) cn0)) $;

--| A mapping from the nonnegative integers is finitely supported under certain conditions. (Contributed by AV, 5-Oct-2019.) (Revised by AV, 23-Dec-2019.)
theorem mptnn0fsupp {x3 k s1: setvar} (ph: wff) (B2: class x3 s1) (C: class k) (V: class x3 k s1) (c_0: class k):
  $ wi ph (wcel c_0 V) $ >
  $ wi (wa ph (wcel (cv k) cn0)) (wcel C B2) $ >
  $ wi ph (wrex s1 (wral x3 (wi (wbr (cv s1) (cv x3) clt) (wceq (csb k (cv x3) C) c_0)) cn0) cn0) $ >
  $ wi ph (wbr (cmpt k cn0 C) c_0 cfsupp) $;

--| A mapping from the nonnegative integers is finitely supported under certain conditions. (Contributed by AV, 2-Dec-2019.) (Revised by AV, 23-Dec-2019.)
theorem mptnn0fsuppd {x3 k s1: setvar} (ph: wff) (B2: class x3 s1) (C: class k) (D: class x3 s1) (V: class x3 k s1) (c_0: class k):
  $ wi ph (wcel c_0 V) $ >
  $ wi (wa ph (wcel (cv k) cn0)) (wcel C B2) $ >
  $ wi (wceq (cv k) (cv x3)) (wceq C D) $ >
  $ wi ph (wrex s1 (wral x3 (wi (wbr (cv s1) (cv x3) clt) (wceq D c_0)) cn0) cn0) $ >
  $ wi ph (wbr (cmpt k cn0 C) c_0 cfsupp) $;

--| A finitely supported mapping from the nonnegative integers fulfills certain conditions. (Contributed by AV, 3-Nov-2019.) (Revised by AV, 23-Dec-2019.)
theorem mptnn0fsuppr {x3 k s1: setvar} (ph: wff) (B2: class x3 s1) (C: class k) (V: class x3 k s1) (c_0: class k):
  $ wi ph (wcel c_0 V) $ >
  $ wi (wa ph (wcel (cv k) cn0)) (wcel C B2) $ >
  $ wi ph (wbr (cmpt k cn0 C) c_0 cfsupp) $ >
  $ wi ph (wrex s1 (wral x3 (wi (wbr (cv s1) (cv x3) clt) (wceq (csb k (cv x3) C) c_0)) cn0) cn0) $;

--| A one-to-one function with the domain { 0, 1 ,2 } in terms of function values. (Contributed by Alexander van der Vekens, 26-Jan-2018.)
theorem f13idfv (A2 B2 F: class):
  $ wceq A2 (co cc0 c2 cfz) $ >
  $ wb (wf1 A2 B2 F) (wa (wf A2 B2 F) (w3a (wne (cfv cc0 F) (cfv c1 F)) (wne (cfv cc0 F) (cfv c2 F)) (wne (cfv c1 F) (cfv c2 F)))) $;

--| Extend class notation with recursive sequence builder.
term cseq (c_pl F M: class): class;

--| Define a general-purpose operation that builds a recursive sequence (i.e., a function on an upper integer set such as ` NN ` or ` NN0 ` ) whose value at an index is a function of its previous value and the value of an input sequence at that index. This definition is complicated, but fortunately it is not intended to be used directly. Instead, the only purpose of this definition is to provide us with an object that has the properties expressed by ~ seq1 and ~ seqp1 . Typically, those are the main theorems that would be used in practice. The first operand in the parentheses is the operation that is applied to the previous value and the value of the input sequence (second operand). The operand to the left of the parenthesis is the integer to start from. For example, for the operation ` + ` , an input sequence ` F ` with values 1, 1/2, 1/4, 1/8,... would be transformed into the output sequence ` seq 1 ( + , F ) ` with values 1, 3/2, 7/4, 15/8,.., so that ` ( seq 1 ( + , F ) `` 1 ) = 1 ` , ` ( seq 1 ( + , F ) `` 2 ) = ` 3/2, etc. In other words, ` seq M ( + , F ) ` transforms a sequence ` F ` into an infinite series. ` seq M ( + , F ) ~~> 2 ` means "the sum of F(n) from n = M to infinity is 2". Since limits are unique ( ~ climuni ), by ~ climdm the "sum of F(n) from n = 1 to infinity" can be expressed as ` ( ~~> `` seq 1 ( + , F ) ) ` (provided the sequence converges) and evaluates to 2 in this example. Internally, the ` rec ` function generates as its values a set of ordered pairs starting at ` <. M , ( F `` M ) >. ` , with the first member of each pair incremented by one in each successive value. So, the range of ` rec ` is exactly the sequence we want, and we just extract the range (restricted to omega) and throw away the domain. This definition has its roots in a series of theorems from ~ om2uz0i through ~ om2uzf1oi , originally proved by Raph Levien for use with ~ df-exp and later generalized for arbitrary recursive sequences. Definition ~ df-sum extracts the summation values from partial (finite) and complete (infinite) series. (Contributed by NM, 18-Apr-2005.) (Revised by Mario Carneiro, 4-Sep-2013.)
axiom df_seq {x3 y1: setvar} (c_pl F M: class):
  $ wceq (cseq c_pl F M) (cima (crdg (cmpo x3 y1 cvv cvv (cop (co (cv x3) c1 caddc) (co (cv y1) (cfv (co (cv x3) c1 caddc) F) c_pl))) (cop M (cfv M F))) com) $;

--| Existence of the sequence builder operation. (Contributed by Mario Carneiro, 4-Sep-2013.)
theorem seqex (c_pl F M: class):
  $ wcel (cseq c_pl F M) cvv $;

--| Equality theorem for the sequence builder operation. (Contributed by Mario Carneiro, 4-Sep-2013.)
theorem seqeq1 (c_pl F M N: class):
  $ wi (wceq M N) (wceq (cseq c_pl F M) (cseq c_pl F N)) $;

--| Equality theorem for the sequence builder operation. (Contributed by Mario Carneiro, 4-Sep-2013.)
theorem seqeq2 (c_pl Q F M: class):
  $ wi (wceq c_pl Q) (wceq (cseq c_pl F M) (cseq Q F M)) $;

--| Equality theorem for the sequence builder operation. (Contributed by Mario Carneiro, 4-Sep-2013.)
theorem seqeq3 (c_pl F G M: class):
  $ wi (wceq F G) (wceq (cseq c_pl F M) (cseq c_pl G M)) $;

--| Equality deduction for the sequence builder operation. (Contributed by Mario Carneiro, 7-Sep-2013.)
theorem seqeq1d (ph: wff) (A2 B2 c_pl F: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cseq c_pl F A2) (cseq c_pl F B2)) $;

--| Equality deduction for the sequence builder operation. (Contributed by Mario Carneiro, 7-Sep-2013.)
theorem seqeq2d (ph: wff) (A2 B2 F M: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cseq A2 F M) (cseq B2 F M)) $;

--| Equality deduction for the sequence builder operation. (Contributed by Mario Carneiro, 7-Sep-2013.)
theorem seqeq3d (ph: wff) (A2 B2 c_pl M: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cseq c_pl A2 M) (cseq c_pl B2 M)) $;

--| Equality deduction for the sequence builder operation. (Contributed by Mario Carneiro, 7-Sep-2013.)
theorem seqeq123d (ph: wff) (c_pl Q F G M N: class):
  $ wi ph (wceq M N) $ >
  $ wi ph (wceq c_pl Q) $ >
  $ wi ph (wceq F G) $ >
  $ wi ph (wceq (cseq c_pl F M) (cseq Q G N)) $;

--| Hypothesis builder for the sequence builder operation. (Contributed by Mario Carneiro, 24-Jun-2013.) (Revised by Mario Carneiro, 15-Oct-2016.)
theorem nfseq {x3: setvar} (c_pl F M: class x3):
  $ wnfc x3 M $ >
  $ wnfc x3 c_pl $ >
  $ wnfc x3 F $ >
  $ wnfc x3 (cseq c_pl F M) $;

--| Value of the sequence builder function. (Contributed by Mario Carneiro, 24-Jun-2013.)
theorem seqval {x3 y1 z w: setvar} (c_pl: class) (R: class x3 y1 z w) (F: class) (M: class z w):
  $ wceq R (cres (crdg (cmpo x3 y1 cvv cvv (cop (co (cv x3) c1 caddc) (co (cv x3) (cv y1) (cmpo z w cvv cvv (co (cv w) (cfv (co (cv z) c1 caddc) F) c_pl))))) (cop M (cfv M F))) com) $ >
  $ wceq (cseq c_pl F M) (crn R) $;

--| The sequence builder function is a function. (Contributed by Mario Carneiro, 24-Jun-2013.) (Revised by Mario Carneiro, 15-Sep-2013.)
theorem seqfn (c_pl F M: class):
  $ wi (wcel M cz) (wfn (cseq c_pl F M) (cfv M cuz)) $;

--| Value of the sequence builder function at its initial value. (Contributed by Mario Carneiro, 24-Jun-2013.) (Revised by Mario Carneiro, 15-Sep-2013.)
theorem seq1 (c_pl F M: class):
  $ wi (wcel M cz) (wceq (cfv M (cseq c_pl F M)) (cfv M F)) $;

--| Value of the sequence builder function at its initial value. (Contributed by Mario Carneiro, 30-Apr-2014.)
theorem seq1i (ph: wff) (A2 c_pl F M: class):
  $ wcel M cz $ >
  $ wi ph (wceq (cfv M F) A2) $ >
  $ wi ph (wceq (cfv M (cseq c_pl F M)) A2) $;

--| Value of the sequence builder function at a successor. (Contributed by Mario Carneiro, 24-Jun-2013.) (Revised by Mario Carneiro, 15-Sep-2013.)
theorem seqp1 (c_pl F M N: class):
  $ wi (wcel N (cfv M cuz)) (wceq (cfv (co N c1 caddc) (cseq c_pl F M)) (co (cfv N (cseq c_pl F M)) (cfv (co N c1 caddc) F) c_pl)) $;

--| Weak version of ~ seqex that holds without ~ ax-rep . A sequence builder exists when its binary operation input exists and its starting index is an integer. (Contributed by Rohan Ridenour, 14-Aug-2023.)
theorem seqexw (c_pl F M: class):
  $ wcel c_pl cvv $ >
  $ wcel M cz $ >
  $ wcel (cseq c_pl F M) cvv $;

--| Value of the sequence builder function at a successor, deduction form. (Contributed by Mario Carneiro, 30-Apr-2014.) (Revised by AV, 3-May-2024.)
theorem seqp1d (ph: wff) (A2 B2 c_pl F K M N Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel N Z) $ >
  $ wceq K (co N c1 caddc) $ >
  $ wi ph (wceq (cfv N (cseq c_pl F M)) A2) $ >
  $ wi ph (wceq (cfv K F) B2) $ >
  $ wi ph (wceq (cfv K (cseq c_pl F M)) (co A2 B2 c_pl)) $;

--| Value of the sequence builder function at a successor. (Contributed by Mario Carneiro, 24-Jun-2013.)
theorem seqm1 (c_pl F M N: class):
  $ wi (wa (wcel M cz) (wcel N (cfv (co M c1 caddc) cuz))) (wceq (cfv N (cseq c_pl F M)) (co (cfv (co N c1 cmin) (cseq c_pl F M)) (cfv N F) c_pl)) $;

--| Closure properties of the recursive sequence builder. (Contributed by Mario Carneiro, 2-Jul-2013.) (Revised by Mario Carneiro, 27-May-2014.)
theorem seqcl2 {x3 y1: setvar} (ph: wff) (C D c_pl F M: class) (N: class y1):
  $ wi ph (wcel (cfv M F) C) $ >
  $ wi (wa ph (wa (wcel (cv x3) C) (wcel (cv y1) D))) (wcel (co (cv x3) (cv y1) c_pl) C) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv x3) (co (co M c1 caddc) N cfz))) (wcel (cfv (cv x3) F) D) $ >
  $ wi ph (wcel (cfv N (cseq c_pl F M)) C) $;

--| Range of the recursive sequence builder. (Contributed by Mario Carneiro, 24-Jun-2013.) (Revised by Mario Carneiro, 27-May-2014.)
theorem seqf2 {x3 y1: setvar} (ph: wff) (C D c_pl F M: class) (Z: class x3 y1):
  $ wi ph (wcel (cfv M F) C) $ >
  $ wi (wa ph (wa (wcel (cv x3) C) (wcel (cv y1) D))) (wcel (co (cv x3) (cv y1) c_pl) C) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi (wa ph (wcel (cv x3) (cfv (co M c1 caddc) cuz))) (wcel (cfv (cv x3) F) D) $ >
  $ wi ph (wf Z C (cseq c_pl F M)) $;

--| Closure properties of the recursive sequence builder. (Contributed by Mario Carneiro, 2-Jul-2013.) (Revised by Mario Carneiro, 27-May-2014.)
theorem seqcl {x3 y1: setvar} (ph: wff) (c_pl S F M: class) (N: class y1):
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv x3) (co M N cfz))) (wcel (cfv (cv x3) F) S) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wcel (co (cv x3) (cv y1) c_pl) S) $ >
  $ wi ph (wcel (cfv N (cseq c_pl F M)) S) $;

--| Range of the recursive sequence builder (special case of ~ seqf2 ). (Contributed by Mario Carneiro, 24-Jun-2013.)
theorem seqf {x3 y1: setvar} (ph: wff) (c_pl S F M: class) (Z: class y1):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi (wa ph (wcel (cv x3) Z)) (wcel (cfv (cv x3) F) S) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wcel (co (cv x3) (cv y1) c_pl) S) $ >
  $ wi ph (wf Z S (cseq c_pl F M)) $;

--| Equality of sequences. (Contributed by NM, 17-Mar-2005.) (Revised by Mario Carneiro, 27-May-2014.)
theorem seqfveq2 {k: setvar} (ph: wff) (c_pl: class k) (F G K: class) (M: class k) (N: class):
  $ wi ph (wcel K (cfv M cuz)) $ >
  $ wi ph (wceq (cfv K (cseq c_pl F M)) (cfv K G)) $ >
  $ wi ph (wcel N (cfv K cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co (co K c1 caddc) N cfz))) (wceq (cfv (cv k) F) (cfv (cv k) G)) $ >
  $ wi ph (wceq (cfv N (cseq c_pl F M)) (cfv N (cseq c_pl G K))) $;

--| Equality of sequences. (Contributed by Mario Carneiro, 13-Jul-2013.) (Revised by Mario Carneiro, 27-May-2014.)
theorem seqfeq2 {k: setvar} (ph: wff) (c_pl: class k) (F G K: class) (M: class k):
  $ wi ph (wcel K (cfv M cuz)) $ >
  $ wi ph (wceq (cfv K (cseq c_pl F M)) (cfv K G)) $ >
  $ wi (wa ph (wcel (cv k) (cfv (co K c1 caddc) cuz))) (wceq (cfv (cv k) F) (cfv (cv k) G)) $ >
  $ wi ph (wceq (cres (cseq c_pl F M) (cfv K cuz)) (cseq c_pl G K)) $;

--| Equality of sequences. (Contributed by NM, 17-Mar-2005.) (Revised by Mario Carneiro, 27-May-2014.)
theorem seqfveq {k: setvar} (ph: wff) (c_pl: class k) (F G M N: class):
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wceq (cfv (cv k) F) (cfv (cv k) G)) $ >
  $ wi ph (wceq (cfv N (cseq c_pl F M)) (cfv N (cseq c_pl G M))) $;

--| Equality of sequences. (Contributed by Mario Carneiro, 13-Jul-2013.) (Revised by Mario Carneiro, 27-May-2014.)
theorem seqfeq {k: setvar} (ph: wff) (c_pl: class k) (F G M: class):
  $ wi ph (wcel M cz) $ >
  $ wi (wa ph (wcel (cv k) (cfv M cuz))) (wceq (cfv (cv k) F) (cfv (cv k) G)) $ >
  $ wi ph (wceq (cseq c_pl F M) (cseq c_pl G M)) $;

--| Shifting the index set of a sequence. (Contributed by Mario Carneiro, 27-Feb-2014.) (Revised by Mario Carneiro, 27-May-2014.)
theorem seqshft2 {k: setvar} (ph: wff) (c_pl: class k) (F G K M N: class):
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi ph (wcel K cz) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wceq (cfv (cv k) F) (cfv (co (cv k) K caddc) G)) $ >
  $ wi ph (wceq (cfv N (cseq c_pl F M)) (cfv (co N K caddc) (cseq c_pl G (co M K caddc)))) $;

--| Restricting its characteristic function to ` ( ZZ>= `` M ) ` does not affect the ` seq ` function. (Contributed by Mario Carneiro, 24-Jun-2013.) (Revised by Mario Carneiro, 27-May-2014.)
theorem seqres (c_pl F M: class):
  $ wi (wcel M cz) (wceq (cseq c_pl (cres F (cfv M cuz)) M) (cseq c_pl F M)) $;

--| An infinite series of complex terms is a function from ` NN ` to ` CC ` . (Contributed by NM, 18-Apr-2005.) (Revised by Mario Carneiro, 27-May-2014.)
theorem serf {k: setvar} (ph: wff) (F M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wi ph (wf Z cc (cseq caddc F M)) $;

--| An infinite series of real numbers is a function from ` NN ` to ` RR ` . (Contributed by NM, 18-Apr-2005.) (Revised by Mario Carneiro, 27-May-2014.)
theorem serfre {k: setvar} (ph: wff) (F M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cr) $ >
  $ wi ph (wf Z cr (cseq caddc F M)) $;

--| Ordering relation for a monotonic sequence, increasing case. (Contributed by NM, 13-Mar-2005.) (Revised by Mario Carneiro, 9-Feb-2014.)
theorem monoord {k: setvar} (ph: wff) (F M N: class):
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel (cfv (cv k) F) cr) $ >
  $ wi (wa ph (wcel (cv k) (co M (co N c1 cmin) cfz))) (wbr (cfv (cv k) F) (cfv (co (cv k) c1 caddc) F) cle) $ >
  $ wi ph (wbr (cfv M F) (cfv N F) cle) $;

--| Ordering relation for a monotonic sequence, decreasing case. (Contributed by Mario Carneiro, 18-Jul-2014.)
theorem monoord2 {k: setvar} (ph: wff) (F M N: class):
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel (cfv (cv k) F) cr) $ >
  $ wi (wa ph (wcel (cv k) (co M (co N c1 cmin) cfz))) (wbr (cfv (co (cv k) c1 caddc) F) (cfv (cv k) F) cle) $ >
  $ wi ph (wbr (cfv N F) (cfv M F) cle) $;

--| The partial sums in an infinite series of positive terms form a monotonic sequence. (Contributed by NM, 17-Mar-2005.) (Revised by Mario Carneiro, 30-Jun-2013.)
theorem sermono {x3: setvar} (ph: wff) (F K M N: class):
  $ wi ph (wcel K (cfv M cuz)) $ >
  $ wi ph (wcel N (cfv K cuz)) $ >
  $ wi (wa ph (wcel (cv x3) (co M N cfz))) (wcel (cfv (cv x3) F) cr) $ >
  $ wi (wa ph (wcel (cv x3) (co (co K c1 caddc) N cfz))) (wbr cc0 (cfv (cv x3) F) cle) $ >
  $ wi ph (wbr (cfv K (cseq caddc F M)) (cfv N (cseq caddc F M)) cle) $;

--| Split a sequence into two sequences. (Contributed by NM, 17-Mar-2005.) (Revised by Mario Carneiro, 27-May-2014.)
theorem seqsplit {x3 y1 z: setvar} (ph: wff) (c_pl S F K M N: class):
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wcel (co (cv x3) (cv y1) c_pl) S) $ >
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wceq (co (co (cv x3) (cv y1) c_pl) (cv z) c_pl) (co (cv x3) (co (cv y1) (cv z) c_pl) c_pl)) $ >
  $ wi ph (wcel N (cfv (co M c1 caddc) cuz)) $ >
  $ wi ph (wcel M (cfv K cuz)) $ >
  $ wi (wa ph (wcel (cv x3) (co K N cfz))) (wcel (cfv (cv x3) F) S) $ >
  $ wi ph (wceq (cfv N (cseq c_pl F K)) (co (cfv M (cseq c_pl F K)) (cfv N (cseq c_pl F (co M c1 caddc))) c_pl)) $;

--| Removing the first term from a sequence. (Contributed by NM, 17-Mar-2005.) (Revised by Mario Carneiro, 27-May-2014.)
theorem seq1p {x3 y1 z: setvar} (ph: wff) (c_pl S F M N: class):
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wcel (co (cv x3) (cv y1) c_pl) S) $ >
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wceq (co (co (cv x3) (cv y1) c_pl) (cv z) c_pl) (co (cv x3) (co (cv y1) (cv z) c_pl) c_pl)) $ >
  $ wi ph (wcel N (cfv (co M c1 caddc) cuz)) $ >
  $ wi ph (wcel M cz) $ >
  $ wi (wa ph (wcel (cv x3) (co M N cfz))) (wcel (cfv (cv x3) F) S) $ >
  $ wi ph (wceq (cfv N (cseq c_pl F M)) (co (cfv M F) (cfv N (cseq c_pl F (co M c1 caddc))) c_pl)) $;

--| Lemma for ~ seqcaopr2 . (Contributed by Mario Carneiro, 25-Apr-2016.)
theorem seqcaopr3 {x3 y1 k n: setvar} (ph: wff) (c_pl: class k) (Q: class) (S: class n) (F G: class) (H: class x3 y1) (M N: class):
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wcel (co (cv x3) (cv y1) c_pl) S) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wcel (co (cv x3) (cv y1) Q) S) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel (cfv (cv k) F) S) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel (cfv (cv k) G) S) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wceq (cfv (cv k) H) (co (cfv (cv k) F) (cfv (cv k) G) Q)) $ >
  $ wi (wa ph (wcel (cv n) (co M N cfzo))) (wceq (co (co (cfv (cv n) (cseq c_pl F M)) (cfv (cv n) (cseq c_pl G M)) Q) (co (cfv (co (cv n) c1 caddc) F) (cfv (co (cv n) c1 caddc) G) Q) c_pl) (co (co (cfv (cv n) (cseq c_pl F M)) (cfv (co (cv n) c1 caddc) F) c_pl) (co (cfv (cv n) (cseq c_pl G M)) (cfv (co (cv n) c1 caddc) G) c_pl) Q)) $ >
  $ wi ph (wceq (cfv N (cseq c_pl H M)) (co (cfv N (cseq c_pl F M)) (cfv N (cseq c_pl G M)) Q)) $;

--| The sum of two infinite series (generalized to an arbitrary commutative and associative operation). (Contributed by Mario Carneiro, 30-May-2014.)
theorem seqcaopr2 {x3 y1 z w k: setvar} (ph: wff) (c_pl: class k) (Q S F G: class) (H: class x3 y1 w) (M: class) (N: class w):
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wcel (co (cv x3) (cv y1) c_pl) S) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wcel (co (cv x3) (cv y1) Q) S) $ >
  $ wi (wa ph (wa (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wa (wcel (cv z) S) (wcel (cv w) S)))) (wceq (co (co (cv x3) (cv z) Q) (co (cv y1) (cv w) Q) c_pl) (co (co (cv x3) (cv y1) c_pl) (co (cv z) (cv w) c_pl) Q)) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel (cfv (cv k) F) S) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel (cfv (cv k) G) S) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wceq (cfv (cv k) H) (co (cfv (cv k) F) (cfv (cv k) G) Q)) $ >
  $ wi ph (wceq (cfv N (cseq c_pl H M)) (co (cfv N (cseq c_pl F M)) (cfv N (cseq c_pl G M)) Q)) $;

--| The sum of two infinite series (generalized to an arbitrary commutative and associative operation). (Contributed by NM, 17-Mar-2005.) (Revised by Mario Carneiro, 30-May-2014.)
theorem seqcaopr {x3 y1 z k: setvar} (ph: wff) (c_pl S: class) (F G H M N: class x3 y1 z):
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wcel (co (cv x3) (cv y1) c_pl) S) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wceq (co (cv x3) (cv y1) c_pl) (co (cv y1) (cv x3) c_pl)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wceq (co (co (cv x3) (cv y1) c_pl) (cv z) c_pl) (co (cv x3) (co (cv y1) (cv z) c_pl) c_pl)) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel (cfv (cv k) F) S) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel (cfv (cv k) G) S) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wceq (cfv (cv k) H) (co (cfv (cv k) F) (cfv (cv k) G) c_pl)) $ >
  $ wi ph (wceq (cfv N (cseq c_pl H M)) (co (cfv N (cseq c_pl F M)) (cfv N (cseq c_pl G M)) c_pl)) $;

--| Lemma for ~ seqf1o . (Contributed by Mario Carneiro, 24-Apr-2016.)
theorem seqf1olem2a {x3 y1 z: setvar} (ph: wff) (A2: class x3 y1 z) (C c_pl S G K M N: class):
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wcel (co (cv x3) (cv y1) c_pl) S) $ >
  $ wi (wa ph (wa (wcel (cv x3) C) (wcel (cv y1) C))) (wceq (co (cv x3) (cv y1) c_pl) (co (cv y1) (cv x3) c_pl)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wceq (co (co (cv x3) (cv y1) c_pl) (cv z) c_pl) (co (cv x3) (co (cv y1) (cv z) c_pl) c_pl)) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi ph (wss C S) $ >
  $ wi ph (wf A2 C G) $ >
  $ wi ph (wcel K A2) $ >
  $ wi ph (wss (co M N cfz) A2) $ >
  $ wi ph (wceq (co (cfv K G) (cfv N (cseq c_pl G M)) c_pl) (co (cfv N (cseq c_pl G M)) (cfv K G) c_pl)) $;

--| Lemma for ~ seqf1o . (Contributed by Mario Carneiro, 26-Feb-2014.) (Revised by Mario Carneiro, 27-May-2014.)
theorem seqf1olem1 {x3 y1 z k: setvar} (ph: wff) (C c_pl S F G: class) (J: class k) (K M N: class):
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wcel (co (cv x3) (cv y1) c_pl) S) $ >
  $ wi (wa ph (wa (wcel (cv x3) C) (wcel (cv y1) C))) (wceq (co (cv x3) (cv y1) c_pl) (co (cv y1) (cv x3) c_pl)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wceq (co (co (cv x3) (cv y1) c_pl) (cv z) c_pl) (co (cv x3) (co (cv y1) (cv z) c_pl) c_pl)) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi ph (wss C S) $ >
  $ wi ph (wf1o (co M (co N c1 caddc) cfz) (co M (co N c1 caddc) cfz) F) $ >
  $ wi ph (wf (co M (co N c1 caddc) cfz) C G) $ >
  $ wceq J (cmpt k (co M N cfz) (cfv (cif (wbr (cv k) K clt) (cv k) (co (cv k) c1 caddc)) F)) $ >
  $ wceq K (cfv (co N c1 caddc) (ccnv F)) $ >
  $ wi ph (wf1o (co M N cfz) (co M N cfz) J) $;

--| Lemma for ~ seqf1o . (Contributed by Mario Carneiro, 27-Feb-2014.) (Revised by Mario Carneiro, 24-Apr-2016.)
theorem seqf1olem2 {x3 y1 z f2 g2 k: setvar} (ph: wff) (C c_pl: class) (S: class f2 g2) (F G: class) (J: class k) (K: class f2 g2) (M N: class):
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wcel (co (cv x3) (cv y1) c_pl) S) $ >
  $ wi (wa ph (wa (wcel (cv x3) C) (wcel (cv y1) C))) (wceq (co (cv x3) (cv y1) c_pl) (co (cv y1) (cv x3) c_pl)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wceq (co (co (cv x3) (cv y1) c_pl) (cv z) c_pl) (co (cv x3) (co (cv y1) (cv z) c_pl) c_pl)) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi ph (wss C S) $ >
  $ wi ph (wf1o (co M (co N c1 caddc) cfz) (co M (co N c1 caddc) cfz) F) $ >
  $ wi ph (wf (co M (co N c1 caddc) cfz) C G) $ >
  $ wceq J (cmpt k (co M N cfz) (cfv (cif (wbr (cv k) K clt) (cv k) (co (cv k) c1 caddc)) F)) $ >
  $ wceq K (cfv (co N c1 caddc) (ccnv F)) $ >
  $ wi ph (wal g2 (wal f2 (wi (wa (wf1o (co M N cfz) (co M N cfz) (cv f2)) (wf (co M N cfz) C (cv g2))) (wceq (cfv N (cseq c_pl (ccom (cv g2) (cv f2)) M)) (cfv N (cseq c_pl (cv g2) M)))))) $ >
  $ wi ph (wceq (cfv (co N c1 caddc) (cseq c_pl (ccom G F) M)) (cfv (co N c1 caddc) (cseq c_pl G M))) $;

--| Rearrange a sum via an arbitrary bijection on ` ( M ... N ) ` . (Contributed by Mario Carneiro, 27-Feb-2014.) (Revised by Mario Carneiro, 24-Apr-2016.)
theorem seqf1o {x3 y1 z k: setvar} (ph: wff) (C c_pl S F G: class) (H: class x3 y1 z) (M N: class):
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wcel (co (cv x3) (cv y1) c_pl) S) $ >
  $ wi (wa ph (wa (wcel (cv x3) C) (wcel (cv y1) C))) (wceq (co (cv x3) (cv y1) c_pl) (co (cv y1) (cv x3) c_pl)) $ >
  $ wi (wa ph (w3a (wcel (cv x3) S) (wcel (cv y1) S) (wcel (cv z) S))) (wceq (co (co (cv x3) (cv y1) c_pl) (cv z) c_pl) (co (cv x3) (co (cv y1) (cv z) c_pl) c_pl)) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi ph (wss C S) $ >
  $ wi ph (wf1o (co M N cfz) (co M N cfz) F) $ >
  $ wi (wa ph (wcel (cv x3) (co M N cfz))) (wcel (cfv (cv x3) G) C) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wceq (cfv (cv k) H) (cfv (cfv (cv k) F) G)) $ >
  $ wi ph (wceq (cfv N (cseq c_pl H M)) (cfv N (cseq c_pl G M))) $;

--| The sum of two infinite series. (Contributed by NM, 17-Mar-2005.) (Revised by Mario Carneiro, 26-May-2014.)
theorem seradd {k: setvar} (ph: wff) (F G H M N: class):
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel (cfv (cv k) F) cc) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel (cfv (cv k) G) cc) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wceq (cfv (cv k) H) (co (cfv (cv k) F) (cfv (cv k) G) caddc)) $ >
  $ wi ph (wceq (cfv N (cseq caddc H M)) (co (cfv N (cseq caddc F M)) (cfv N (cseq caddc G M)) caddc)) $;

--| The difference of two infinite series. (Contributed by NM, 17-Mar-2005.) (Revised by Mario Carneiro, 27-May-2014.)
theorem sersub {k: setvar} (ph: wff) (F G H M N: class):
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel (cfv (cv k) F) cc) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel (cfv (cv k) G) cc) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wceq (cfv (cv k) H) (co (cfv (cv k) F) (cfv (cv k) G) cmin)) $ >
  $ wi ph (wceq (cfv N (cseq caddc H M)) (co (cfv N (cseq caddc F M)) (cfv N (cseq caddc G M)) cmin)) $;

--| A sequence that consists entirely of "zeroes" sums to "zero". More precisely, a constant sequence with value an element which is a ` .+ ` -idempotent sums (or " ` .+ ` 's") to that element. (Contributed by Mario Carneiro, 15-Dec-2014.)
theorem seqid3 {x3: setvar} (ph: wff) (c_pl F M N Z: class):
  $ wi ph (wceq (co Z Z c_pl) Z) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv x3) (co M N cfz))) (wceq (cfv (cv x3) F) Z) $ >
  $ wi ph (wceq (cfv N (cseq c_pl F M)) Z) $;

--| Discarding the first few terms of a sequence that starts with all zeroes (or any element which is a left-identity for ` .+ ` ) has no effect on its sum. (Contributed by Mario Carneiro, 13-Jul-2013.) (Revised by Mario Carneiro, 27-May-2014.)
theorem seqid {x3: setvar} (ph: wff) (c_pl S F M N Z: class):
  $ wi (wa ph (wcel (cv x3) S)) (wceq (co Z (cv x3) c_pl) (cv x3)) $ >
  $ wi ph (wcel Z S) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi ph (wcel (cfv N F) S) $ >
  $ wi (wa ph (wcel (cv x3) (co M (co N c1 cmin) cfz))) (wceq (cfv (cv x3) F) Z) $ >
  $ wi ph (wceq (cres (cseq c_pl F M) (cfv N cuz)) (cseq c_pl F N)) $;

--| The last few partial sums of a sequence that ends with all zeroes (or any element which is a right-identity for ` .+ ` ) are all the same. (Contributed by Mario Carneiro, 13-Jul-2013.) (Revised by Mario Carneiro, 27-May-2014.)
theorem seqid2 {x3: setvar} (ph: wff) (c_pl S F K M N Z: class):
  $ wi (wa ph (wcel (cv x3) S)) (wceq (co (cv x3) Z c_pl) (cv x3)) $ >
  $ wi ph (wcel K (cfv M cuz)) $ >
  $ wi ph (wcel N (cfv K cuz)) $ >
  $ wi ph (wcel (cfv K (cseq c_pl F M)) S) $ >
  $ wi (wa ph (wcel (cv x3) (co (co K c1 caddc) N cfz))) (wceq (cfv (cv x3) F) Z) $ >
  $ wi ph (wceq (cfv K (cseq c_pl F M)) (cfv N (cseq c_pl F M))) $;

--| Apply a homomorphism to a sequence. (Contributed by Mario Carneiro, 28-Jul-2013.) (Revised by Mario Carneiro, 27-May-2014.)
theorem seqhomo {x3 y1: setvar} (ph: wff) (c_pl Q S F: class) (G: class y1) (H M N: class):
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wcel (co (cv x3) (cv y1) c_pl) S) $ >
  $ wi (wa ph (wcel (cv x3) (co M N cfz))) (wcel (cfv (cv x3) F) S) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wceq (cfv (co (cv x3) (cv y1) c_pl) H) (co (cfv (cv x3) H) (cfv (cv y1) H) Q)) $ >
  $ wi (wa ph (wcel (cv x3) (co M N cfz))) (wceq (cfv (cfv (cv x3) F) H) (cfv (cv x3) G)) $ >
  $ wi ph (wceq (cfv (cfv N (cseq c_pl F M)) H) (cfv N (cseq Q G M))) $;

--| If the operation ` .+ ` has an absorbing element ` Z ` (a.k.a. zero element), then any sequence containing a ` Z ` evaluates to ` Z ` . (Contributed by Mario Carneiro, 27-May-2014.)
theorem seqz {x3 y1: setvar} (ph: wff) (c_pl S F K M N: class) (V: class x3 y1) (Z: class):
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wcel (co (cv x3) (cv y1) c_pl) S) $ >
  $ wi (wa ph (wcel (cv x3) (co M N cfz))) (wcel (cfv (cv x3) F) S) $ >
  $ wi (wa ph (wcel (cv x3) S)) (wceq (co Z (cv x3) c_pl) Z) $ >
  $ wi (wa ph (wcel (cv x3) S)) (wceq (co (cv x3) Z c_pl) Z) $ >
  $ wi ph (wcel K (co M N cfz)) $ >
  $ wi ph (wcel N V) $ >
  $ wi ph (wceq (cfv K F) Z) $ >
  $ wi ph (wceq (cfv N (cseq c_pl F M)) Z) $;

--| Equality of series under different addition operations which agree on an additively closed subset. (Contributed by Mario Carneiro, 25-Apr-2016.)
theorem seqfeq4 {x3 y1: setvar} (ph: wff) (c_pl Q S F M N: class):
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv x3) (co M N cfz))) (wcel (cfv (cv x3) F) S) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wcel (co (cv x3) (cv y1) c_pl) S) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wceq (co (cv x3) (cv y1) c_pl) (co (cv x3) (cv y1) Q)) $ >
  $ wi ph (wceq (cfv N (cseq c_pl F M)) (cfv N (cseq Q F M))) $;

--| Equality of series under different addition operations which agree on an additively closed subset. (Contributed by Stefan O'Rear, 21-Mar-2015.) (Revised by Mario Carneiro, 25-Apr-2016.)
theorem seqfeq3 {x3 y1: setvar} (ph: wff) (c_pl Q S F M: class):
  $ wi ph (wcel M cz) $ >
  $ wi (wa ph (wcel (cv x3) (cfv M cuz))) (wcel (cfv (cv x3) F) S) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wcel (co (cv x3) (cv y1) c_pl) S) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wceq (co (cv x3) (cv y1) c_pl) (co (cv x3) (cv y1) Q)) $ >
  $ wi ph (wceq (cseq c_pl F M) (cseq Q F M)) $;

--| The distributive property for series. (Contributed by Mario Carneiro, 28-Jul-2013.) (Revised by Mario Carneiro, 27-May-2014.)
theorem seqdistr {x3 y1: setvar} (ph: wff) (C c_pl S T: class) (F: class y1) (G M N: class):
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wcel (co (cv x3) (cv y1) c_pl) S) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wceq (co C (co (cv x3) (cv y1) c_pl) T) (co (co C (cv x3) T) (co C (cv y1) T) c_pl)) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv x3) (co M N cfz))) (wcel (cfv (cv x3) G) S) $ >
  $ wi (wa ph (wcel (cv x3) (co M N cfz))) (wceq (cfv (cv x3) F) (co C (cfv (cv x3) G) T)) $ >
  $ wi ph (wceq (cfv N (cseq c_pl F M)) (co C (cfv N (cseq c_pl G M)) T)) $;

--| The value of the partial sums in a zero-valued infinite series. (Contributed by Mario Carneiro, 31-Aug-2013.) (Revised by Mario Carneiro, 15-Dec-2014.)
theorem ser0 (M N Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi (wcel N Z) (wceq (cfv N (cseq caddc (cxp Z (csn cc0)) M)) cc0) $;

--| A zero-valued infinite series is equal to the constant zero function. (Contributed by Mario Carneiro, 8-Feb-2014.)
theorem ser0f (M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi (wcel M cz) (wceq (cseq caddc (cxp Z (csn cc0)) M) (cxp Z (csn cc0))) $;

--| A finite sum of nonnegative terms is nonnegative. (Contributed by Mario Carneiro, 8-Feb-2014.) (Revised by Mario Carneiro, 27-May-2014.)
theorem serge0 {k: setvar} (ph: wff) (F M N: class):
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel (cfv (cv k) F) cr) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wbr cc0 (cfv (cv k) F) cle) $ >
  $ wi ph (wbr cc0 (cfv N (cseq caddc F M)) cle) $;

--| Comparison of partial sums of two infinite series of reals. (Contributed by NM, 27-Dec-2005.) (Revised by Mario Carneiro, 27-May-2014.)
theorem serle {k: setvar} (ph: wff) (F G M N: class):
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel (cfv (cv k) F) cr) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel (cfv (cv k) G) cr) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wbr (cfv (cv k) F) (cfv (cv k) G) cle) $ >
  $ wi ph (wbr (cfv N (cseq caddc F M)) (cfv N (cseq caddc G M)) cle) $;

--| Value of the partial series sum of a constant function. (Contributed by NM, 8-Aug-2005.) (Revised by Mario Carneiro, 16-Feb-2014.)
theorem ser1const (A2 N: class):
  $ wi (wa (wcel A2 cc) (wcel N cn)) (wceq (cfv N (cseq caddc (cxp cn (csn A2)) c1)) (co N A2 cmul)) $;

--| Distribute function operation through a sequence. Note that ` G ( z ) ` is an implicit function on ` z ` . (Contributed by Mario Carneiro, 3-Mar-2015.)
theorem seqof {x3 z: setvar} (ph: wff) (A2 c_pl F: class) (G: class z) (M N: class) (V: class x3 z):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv x3) (co M N cfz))) (wceq (cfv (cv x3) F) (cmpt z A2 (cfv (cv x3) G))) $ >
  $ wi ph (wceq (cfv N (cseq (cof c_pl) F M)) (cmpt z A2 (cfv N (cseq c_pl G M)))) $;

--| Distribute function operation through a sequence. Maps-to notation version of ~ seqof . (Contributed by Mario Carneiro, 7-Jul-2017.)
theorem seqof2 {x3 z: setvar} (ph: wff) (A2: class) (B2: class z) (c_pl: class x3) (M N: class) (V W X: class x3 z):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi ph (wss (co M N cfz) B2) $ >
  $ wi (wa ph (wa (wcel (cv x3) B2) (wcel (cv z) A2))) (wcel X W) $ >
  $ wi ph (wceq (cfv N (cseq (cof c_pl) (cmpt x3 B2 (cmpt z A2 X)) M)) (cmpt z A2 (cfv N (cseq c_pl (cmpt x3 B2 X) M)))) $;

--| Extend class notation to include exponentiation of a complex number to an integer power.
term cexp: class;

--| Define exponentiation of complex numbers with integer exponents. For example, ` ( 5 ^ 2 ) = 2 5 ` ( ~ ex-exp ). Terminology: In general, "exponentiation" is the operation of raising a "base" ` x ` to the power of the "exponent" ` y ` , resulting in the "power" ` ( x ^ y ) ` , also called "x to the power of y". In this case, "integer exponentiation" is the operation of raising a complex "base" ` x ` to the power of an integer ` y ` , resulting in the "integer power" ` ( x ^ y ) ` . This definition is not meant to be used directly; instead, ~ exp0 and ~ expp1 provide the standard recursive definition. The up-arrow notation is used by Donald Knuth for iterated exponentiation (_Science_ 194, 1235-1242, 1976) and is convenient for us since we do not have superscripts. 10-Jun-2005: The definition was extended from positive exponents to nonnegative exponent, so that ` 0 ^ 0 = 1 ` , following standard convention, for instance Definition 10-4.1 of [Gleason] p. 134 ( ~ 0exp0e1 ). 4-Jun-2014: The definition was extended to integer exponents. For example, ` ( -u 3 ^ -u 2 ) = ( 1 / 9 ) ` ( ~ ex-exp ). The case ` x = 0 , y < 0 ` gives the "value" ` ( 1 / 0 ) ` ; relying on this should be avoided in applications. For a definition of exponentiation including complex exponents see ~ df-cxp (complex exponentiation). Both definitions are equivalent for integer exponents, see ~ cxpexpz . (Contributed by Raph Levien, 20-May-2004.) (Revised by NM, 15-Oct-2004.)
axiom df_exp {x3 y1: setvar}:
  $ wceq cexp (cmpo x3 y1 cc cz (cif (wceq (cv y1) cc0) c1 (cif (wbr cc0 (cv y1) clt) (cfv (cv y1) (cseq cmul (cxp cn (csn (cv x3))) c1)) (co c1 (cfv (cneg (cv y1)) (cseq cmul (cxp cn (csn (cv x3))) c1)) cdiv)))) $;

--| Value of exponentiation to integer powers. (Contributed by NM, 20-May-2004.) (Revised by Mario Carneiro, 4-Jun-2014.)
theorem expval (A2 N: class):
  $ wi (wa (wcel A2 cc) (wcel N cz)) (wceq (co A2 N cexp) (cif (wceq N cc0) c1 (cif (wbr cc0 N clt) (cfv N (cseq cmul (cxp cn (csn A2)) c1)) (co c1 (cfv (cneg N) (cseq cmul (cxp cn (csn A2)) c1)) cdiv)))) $;

--| Value of exponentiation to positive integer powers. (Contributed by Mario Carneiro, 4-Jun-2014.)
theorem expnnval (A2 N: class):
  $ wi (wa (wcel A2 cc) (wcel N cn)) (wceq (co A2 N cexp) (cfv N (cseq cmul (cxp cn (csn A2)) c1))) $;

--| Value of a complex number raised to the zeroth power. Under our definition, ` 0 ^ 0 = 1 ` ( ~ 0exp0e1 ), following standard convention, for instance Definition 10-4.1 of [Gleason] p. 134. (Contributed by NM, 20-May-2004.) (Revised by Mario Carneiro, 4-Jun-2014.)
theorem exp0 (A2: class):
  $ wi (wcel A2 cc) (wceq (co A2 cc0 cexp) c1) $;

--| The zeroth power of zero equals one. See comment of ~ exp0 . (Contributed by David A. Wheeler, 8-Dec-2018.)
theorem _0exp0e1:
  $ wceq (co cc0 cc0 cexp) c1 $;

--| Value of a complex number raised to the first power. (Contributed by NM, 20-Oct-2004.) (Revised by Mario Carneiro, 2-Jul-2013.)
theorem exp1 (A2: class):
  $ wi (wcel A2 cc) (wceq (co A2 c1 cexp) A2) $;

--| Value of a complex number raised to a nonnegative integer power plus one. Part of Definition 10-4.1 of [Gleason] p. 134. When ` A ` is nonzero, this holds for all integers ` N ` , see ~ expneg . (Contributed by NM, 20-May-2005.) (Revised by Mario Carneiro, 2-Jul-2013.)
theorem expp1 (A2 N: class):
  $ wi (wa (wcel A2 cc) (wcel N cn0)) (wceq (co A2 (co N c1 caddc) cexp) (co (co A2 N cexp) A2 cmul)) $;

--| Value of a complex number raised to a nonpositive integer power. When ` A = 0 ` and ` N ` is nonzero, both sides have the "value" ` ( 1 / 0 ) ` ; relying on that should be avoid in applications. (Contributed by Mario Carneiro, 4-Jun-2014.)
theorem expneg (A2 N: class):
  $ wi (wa (wcel A2 cc) (wcel N cn0)) (wceq (co A2 (cneg N) cexp) (co c1 (co A2 N cexp) cdiv)) $;

--| Value of a complex number raised to a nonpositive integer power. When ` A = 0 ` and ` N ` is nonzero, both sides have the "value" ` ( 1 / 0 ) ` ; relying on that should be avoid in applications. (Contributed by Mario Carneiro, 4-Jun-2014.)
theorem expneg2 (A2 N: class):
  $ wi (w3a (wcel A2 cc) (wcel N cc) (wcel (cneg N) cn0)) (wceq (co A2 N cexp) (co c1 (co A2 (cneg N) cexp) cdiv)) $;

--| A complex number raised to the negative one power is its reciprocal. When ` A = 0 ` , both sides have the "value" ` ( 1 / 0 ) ` ; relying on that should be avoid in applications. (Contributed by Mario Carneiro, 4-Jun-2014.)
theorem expn1 (A2: class):
  $ wi (wcel A2 cc) (wceq (co A2 (cneg c1) cexp) (co c1 A2 cdiv)) $;

--| Lemma for proving nonnegative integer exponentiation closure laws. (Contributed by NM, 14-Dec-2005.)
theorem expcllem {x3 y1: setvar} (A2: class) (B2: class y1) (F: class):
  $ wss F cc $ >
  $ wi (wa (wcel (cv x3) F) (wcel (cv y1) F)) (wcel (co (cv x3) (cv y1) cmul) F) $ >
  $ wcel c1 F $ >
  $ wi (wa (wcel A2 F) (wcel B2 cn0)) (wcel (co A2 B2 cexp) F) $;

--| Lemma for proving integer exponentiation closure laws. (Contributed by Mario Carneiro, 4-Jun-2014.) (Revised by Mario Carneiro, 9-Sep-2014.)
theorem expcl2lem {x3 y1: setvar} (A2: class) (B2: class y1) (F: class):
  $ wss F cc $ >
  $ wi (wa (wcel (cv x3) F) (wcel (cv y1) F)) (wcel (co (cv x3) (cv y1) cmul) F) $ >
  $ wcel c1 F $ >
  $ wi (wa (wcel (cv x3) F) (wne (cv x3) cc0)) (wcel (co c1 (cv x3) cdiv) F) $ >
  $ wi (w3a (wcel A2 F) (wne A2 cc0) (wcel B2 cz)) (wcel (co A2 B2 cexp) F) $;

--| Closure of exponentiation of nonnegative integers. (Contributed by NM, 16-Dec-2005.)
theorem nnexpcl (A2 N: class):
  $ wi (wa (wcel A2 cn) (wcel N cn0)) (wcel (co A2 N cexp) cn) $;

--| Closure of exponentiation of nonnegative integers. (Contributed by NM, 14-Dec-2005.)
theorem nn0expcl (A2 N: class):
  $ wi (wa (wcel A2 cn0) (wcel N cn0)) (wcel (co A2 N cexp) cn0) $;

--| Closure of exponentiation of integers. (Contributed by NM, 16-Dec-2005.)
theorem zexpcl (A2 N: class):
  $ wi (wa (wcel A2 cz) (wcel N cn0)) (wcel (co A2 N cexp) cz) $;

--| Closure of exponentiation of rationals. For integer exponents, see ~ qexpclz . (Contributed by NM, 16-Dec-2005.)
theorem qexpcl (A2 N: class):
  $ wi (wa (wcel A2 cq) (wcel N cn0)) (wcel (co A2 N cexp) cq) $;

--| Closure of exponentiation of reals. For integer exponents, see ~ reexpclz . (Contributed by NM, 14-Dec-2005.)
theorem reexpcl (A2 N: class):
  $ wi (wa (wcel A2 cr) (wcel N cn0)) (wcel (co A2 N cexp) cr) $;

--| Closure law for nonnegative integer exponentiation. For integer exponents, see ~ expclz . (Contributed by NM, 26-May-2005.)
theorem expcl (A2 N: class):
  $ wi (wa (wcel A2 cc) (wcel N cn0)) (wcel (co A2 N cexp) cc) $;

--| Closure law for integer exponentiation of positive reals. (Contributed by NM, 24-Feb-2008.) (Revised by Mario Carneiro, 9-Sep-2014.)
theorem rpexpcl (A2 N: class):
  $ wi (wa (wcel A2 crp) (wcel N cz)) (wcel (co A2 N cexp) crp) $;

--| Closure of integer exponentiation of rational numbers. (Contributed by Mario Carneiro, 9-Sep-2014.)
theorem qexpclz (A2 N: class):
  $ wi (w3a (wcel A2 cq) (wne A2 cc0) (wcel N cz)) (wcel (co A2 N cexp) cq) $;

--| Closure of integer exponentiation of reals. (Contributed by Mario Carneiro, 4-Jun-2014.) (Revised by Mario Carneiro, 9-Sep-2014.)
theorem reexpclz (A2 N: class):
  $ wi (w3a (wcel A2 cr) (wne A2 cc0) (wcel N cz)) (wcel (co A2 N cexp) cr) $;

--| Lemma for ~ expclz . (Contributed by Mario Carneiro, 4-Jun-2014.)
theorem expclzlem (A2 N: class):
  $ wi (w3a (wcel A2 cc) (wne A2 cc0) (wcel N cz)) (wcel (co A2 N cexp) (cdif cc (csn cc0))) $;

--| Closure law for integer exponentiation of complex numnbers. (Contributed by Mario Carneiro, 4-Jun-2014.)
theorem expclz (A2 N: class):
  $ wi (w3a (wcel A2 cc) (wne A2 cc0) (wcel N cz)) (wcel (co A2 N cexp) cc) $;

--| Closure of integer exponentiation of negative one. (Contributed by Mario Carneiro, 18-Jun-2015.)
theorem m1expcl2 (N: class):
  $ wi (wcel N cz) (wcel (co (cneg c1) N cexp) (cpr (cneg c1) c1)) $;

--| Closure of exponentiation of negative one. (Contributed by Mario Carneiro, 18-Jun-2015.)
theorem m1expcl (N: class):
  $ wi (wcel N cz) (wcel (co (cneg c1) N cexp) cz) $;

--| Closure of exponentiation of integers, deduction form. (Contributed by SN, 15-Sep-2024.)
theorem zexpcld (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel (co A2 N cexp) cz) $;

--| Closure of exponentiation of nonnegative integers. (Contributed by Mario Carneiro, 17-Apr-2015.)
theorem nn0expcli (A2 N: class):
  $ wcel A2 cn0 $ >
  $ wcel N cn0 $ >
  $ wcel (co A2 N cexp) cn0 $;

--| The square of a nonnegative integer is a nonnegative integer. (Contributed by Stefan O'Rear, 16-Oct-2014.)
theorem nn0sqcl (A2: class):
  $ wi (wcel A2 cn0) (wcel (co A2 c2 cexp) cn0) $;

--| Exponentiation in terms of predecessor exponent. (Contributed by NM, 19-Dec-2005.)
theorem expm1t (A2 N: class):
  $ wi (wa (wcel A2 cc) (wcel N cn)) (wceq (co A2 N cexp) (co (co A2 (co N c1 cmin) cexp) A2 cmul)) $;

--| Value of 1 raised to an integer power. (Contributed by NM, 15-Dec-2005.) (Revised by Mario Carneiro, 4-Jun-2014.)
theorem _1exp (N: class):
  $ wi (wcel N cz) (wceq (co c1 N cexp) c1) $;

--| A positive integer power is zero if and only if its base is zero. (Contributed by NM, 23-Feb-2005.)
theorem expeq0 (A2 N: class):
  $ wi (wa (wcel A2 cc) (wcel N cn)) (wb (wceq (co A2 N cexp) cc0) (wceq A2 cc0)) $;

--| A positive integer power is nonzero if and only if its base is nonzero. (Contributed by NM, 6-May-2005.)
theorem expne0 (A2 N: class):
  $ wi (wa (wcel A2 cc) (wcel N cn)) (wb (wne (co A2 N cexp) cc0) (wne A2 cc0)) $;

--| An integer power is nonzero if its base is nonzero. (Contributed by NM, 2-Aug-2006.) (Revised by Mario Carneiro, 4-Jun-2014.)
theorem expne0i (A2 N: class):
  $ wi (w3a (wcel A2 cc) (wne A2 cc0) (wcel N cz)) (wne (co A2 N cexp) cc0) $;

--| A positive real raised to an integer power is positive. (Contributed by NM, 16-Dec-2005.) (Revised by Mario Carneiro, 4-Jun-2014.)
theorem expgt0 (A2 N: class):
  $ wi (w3a (wcel A2 cr) (wcel N cz) (wbr cc0 A2 clt)) (wbr cc0 (co A2 N cexp) clt) $;

--| Value of a nonzero complex number raised to the negative of an integer power. (Contributed by Mario Carneiro, 4-Jun-2014.)
theorem expnegz (A2 N: class):
  $ wi (w3a (wcel A2 cc) (wne A2 cc0) (wcel N cz)) (wceq (co A2 (cneg N) cexp) (co c1 (co A2 N cexp) cdiv)) $;

--| Value of zero raised to a positive integer power. (Contributed by NM, 19-Aug-2004.)
theorem _0exp (N: class):
  $ wi (wcel N cn) (wceq (co cc0 N cexp) cc0) $;

--| A nonnegative real raised to a nonnegative integer is nonnegative. (Contributed by NM, 16-Dec-2005.) (Revised by Mario Carneiro, 4-Jun-2014.)
theorem expge0 (A2 N: class):
  $ wi (w3a (wcel A2 cr) (wcel N cn0) (wbr cc0 A2 cle)) (wbr cc0 (co A2 N cexp) cle) $;

--| A real greater than or equal to 1 raised to a nonnegative integer is greater than or equal to 1. (Contributed by NM, 21-Feb-2005.) (Revised by Mario Carneiro, 4-Jun-2014.)
theorem expge1 (A2 N: class):
  $ wi (w3a (wcel A2 cr) (wcel N cn0) (wbr c1 A2 cle)) (wbr c1 (co A2 N cexp) cle) $;

--| A real greater than 1 raised to a positive integer is greater than 1. (Contributed by NM, 13-Feb-2005.) (Revised by Mario Carneiro, 4-Jun-2014.)
theorem expgt1 (A2 N: class):
  $ wi (w3a (wcel A2 cr) (wcel N cn) (wbr c1 A2 clt)) (wbr c1 (co A2 N cexp) clt) $;

--| Nonnegative integer exponentiation of a product. Proposition 10-4.2(c) of [Gleason] p. 135, restricted to nonnegative integer exponents. (Contributed by NM, 13-Feb-2005.)
theorem mulexp (A2 B2 N: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel N cn0)) (wceq (co (co A2 B2 cmul) N cexp) (co (co A2 N cexp) (co B2 N cexp) cmul)) $;

--| Integer exponentiation of a product. Proposition 10-4.2(c) of [Gleason] p. 135. (Contributed by Mario Carneiro, 4-Jun-2014.)
theorem mulexpz (A2 B2 N: class):
  $ wi (w3a (wa (wcel A2 cc) (wne A2 cc0)) (wa (wcel B2 cc) (wne B2 cc0)) (wcel N cz)) (wceq (co (co A2 B2 cmul) N cexp) (co (co A2 N cexp) (co B2 N cexp) cmul)) $;

--| Integer exponentiation of a reciprocal. (Contributed by NM, 2-Aug-2006.) (Revised by Mario Carneiro, 4-Jun-2014.)
theorem exprec (A2 N: class):
  $ wi (w3a (wcel A2 cc) (wne A2 cc0) (wcel N cz)) (wceq (co (co c1 A2 cdiv) N cexp) (co c1 (co A2 N cexp) cdiv)) $;

--| Sum of exponents law for nonnegative integer exponentiation. Proposition 10-4.2(a) of [Gleason] p. 135. (Contributed by NM, 30-Nov-2004.)
theorem expadd (A2 M N: class):
  $ wi (w3a (wcel A2 cc) (wcel M cn0) (wcel N cn0)) (wceq (co A2 (co M N caddc) cexp) (co (co A2 M cexp) (co A2 N cexp) cmul)) $;

--| Lemma for ~ expaddz . (Contributed by Mario Carneiro, 4-Jun-2014.)
theorem expaddzlem (A2 M N: class):
  $ wi (w3a (wa (wcel A2 cc) (wne A2 cc0)) (wa (wcel M cr) (wcel (cneg M) cn)) (wcel N cn0)) (wceq (co A2 (co M N caddc) cexp) (co (co A2 M cexp) (co A2 N cexp) cmul)) $;

--| Sum of exponents law for integer exponentiation. Proposition 10-4.2(a) of [Gleason] p. 135. (Contributed by Mario Carneiro, 4-Jun-2014.)
theorem expaddz (A2 M N: class):
  $ wi (wa (wa (wcel A2 cc) (wne A2 cc0)) (wa (wcel M cz) (wcel N cz))) (wceq (co A2 (co M N caddc) cexp) (co (co A2 M cexp) (co A2 N cexp) cmul)) $;

--| Product of exponents law for nonnegative integer exponentiation. Proposition 10-4.2(b) of [Gleason] p. 135, restricted to nonnegative integer exponents. (Contributed by NM, 4-Jan-2006.)
theorem expmul (A2 M N: class):
  $ wi (w3a (wcel A2 cc) (wcel M cn0) (wcel N cn0)) (wceq (co A2 (co M N cmul) cexp) (co (co A2 M cexp) N cexp)) $;

--| Product of exponents law for integer exponentiation. Proposition 10-4.2(b) of [Gleason] p. 135. (Contributed by Mario Carneiro, 7-Jul-2014.)
theorem expmulz (A2 M N: class):
  $ wi (wa (wa (wcel A2 cc) (wne A2 cc0)) (wa (wcel M cz) (wcel N cz))) (wceq (co A2 (co M N cmul) cexp) (co (co A2 M cexp) N cexp)) $;

--| Exponentiation of negative one to an even power. (Contributed by Scott Fenton, 17-Jan-2018.)
theorem m1expeven (N: class):
  $ wi (wcel N cz) (wceq (co (cneg c1) (co c2 N cmul) cexp) c1) $;

--| Exponent subtraction law for integer exponentiation. (Contributed by NM, 2-Aug-2006.) (Revised by Mario Carneiro, 4-Jun-2014.)
theorem expsub (A2 M N: class):
  $ wi (wa (wa (wcel A2 cc) (wne A2 cc0)) (wa (wcel M cz) (wcel N cz))) (wceq (co A2 (co M N cmin) cexp) (co (co A2 M cexp) (co A2 N cexp) cdiv)) $;

--| Value of a nonzero complex number raised to an integer power plus one. (Contributed by Mario Carneiro, 4-Jun-2014.)
theorem expp1z (A2 N: class):
  $ wi (w3a (wcel A2 cc) (wne A2 cc0) (wcel N cz)) (wceq (co A2 (co N c1 caddc) cexp) (co (co A2 N cexp) A2 cmul)) $;

--| Value of a nonzero complex number raised to an integer power minus one. (Contributed by NM, 25-Dec-2008.) (Revised by Mario Carneiro, 4-Jun-2014.)
theorem expm1 (A2 N: class):
  $ wi (w3a (wcel A2 cc) (wne A2 cc0) (wcel N cz)) (wceq (co A2 (co N c1 cmin) cexp) (co (co A2 N cexp) A2 cdiv)) $;

--| Nonnegative integer exponentiation of a quotient. (Contributed by NM, 2-Aug-2006.) (Revised by Mario Carneiro, 4-Jun-2014.)
theorem expdiv (A2 B2 N: class):
  $ wi (w3a (wcel A2 cc) (wa (wcel B2 cc) (wne B2 cc0)) (wcel N cn0)) (wceq (co (co A2 B2 cdiv) N cexp) (co (co A2 N cexp) (co B2 N cexp) cdiv)) $;

--| Value of the square of a complex number. (Contributed by Raph Levien, 10-Apr-2004.)
theorem sqval (A2: class):
  $ wi (wcel A2 cc) (wceq (co A2 c2 cexp) (co A2 A2 cmul)) $;

--| The square of the negative of a number. (Contributed by NM, 15-Jan-2006.)
theorem sqneg (A2: class):
  $ wi (wcel A2 cc) (wceq (co (cneg A2) c2 cexp) (co A2 c2 cexp)) $;

--| The square of the negative of a number. (Contributed by Igor Ieskov, 21-Jan-2024.)
theorem sqnegd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (co (cneg A2) c2 cexp) (co A2 c2 cexp)) $;

--| Swap the order of subtraction in a square. (Contributed by Scott Fenton, 10-Jun-2013.)
theorem sqsubswap (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co (co A2 B2 cmin) c2 cexp) (co (co B2 A2 cmin) c2 cexp)) $;

--| Closure of square. (Contributed by NM, 10-Aug-1999.)
theorem sqcl (A2: class):
  $ wi (wcel A2 cc) (wcel (co A2 c2 cexp) cc) $;

--| Distribution of squaring over multiplication. (Contributed by NM, 21-Mar-2008.)
theorem sqmul (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co (co A2 B2 cmul) c2 cexp) (co (co A2 c2 cexp) (co B2 c2 cexp) cmul)) $;

--| A complex number is zero iff its square is zero. (Contributed by NM, 11-Mar-2006.)
theorem sqeq0 (A2: class):
  $ wi (wcel A2 cc) (wb (wceq (co A2 c2 cexp) cc0) (wceq A2 cc0)) $;

--| Distribution of squaring over division. (Contributed by Scott Fenton, 7-Jun-2013.) (Proof shortened by Mario Carneiro, 9-Jul-2013.)
theorem sqdiv (A2 B2: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wne B2 cc0)) (wceq (co (co A2 B2 cdiv) c2 cexp) (co (co A2 c2 cexp) (co B2 c2 cexp) cdiv)) $;

--| The square of a nonzero complex number divided by itself equals that number. (Contributed by AV, 19-Jul-2021.)
theorem sqdivid (A2: class):
  $ wi (wa (wcel A2 cc) (wne A2 cc0)) (wceq (co (co A2 c2 cexp) A2 cdiv) A2) $;

--| A complex number is nonzero if and only if its square is nonzero. (Contributed by NM, 11-Mar-2006.)
theorem sqne0 (A2: class):
  $ wi (wcel A2 cc) (wb (wne (co A2 c2 cexp) cc0) (wne A2 cc0)) $;

--| Closure of squaring in reals. (Contributed by NM, 18-Oct-1999.)
theorem resqcl (A2: class):
  $ wi (wcel A2 cr) (wcel (co A2 c2 cexp) cr) $;

--| Closure of squaring in reals, deduction form. (Contributed by Mario Carneiro, 28-May-2016.)
theorem resqcld (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel (co A2 c2 cexp) cr) $;

--| The square of a nonzero real is positive. (Contributed by NM, 8-Sep-2007.)
theorem sqgt0 (A2: class):
  $ wi (wa (wcel A2 cr) (wne A2 cc0)) (wbr cc0 (co A2 c2 cexp) clt) $;

--| The square of a nonzero real is a positive real. (Contributed by AV, 5-Mar-2023.)
theorem sqn0rp (A2: class):
  $ wi (wa (wcel A2 cr) (wne A2 cc0)) (wcel (co A2 c2 cexp) crp) $;

--| The positive naturals are closed under squaring. (Contributed by Scott Fenton, 29-Mar-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem nnsqcl (A2: class):
  $ wi (wcel A2 cn) (wcel (co A2 c2 cexp) cn) $;

--| Integers are closed under squaring. (Contributed by Scott Fenton, 18-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem zsqcl (A2: class):
  $ wi (wcel A2 cz) (wcel (co A2 c2 cexp) cz) $;

--| The square of a rational is rational. (Contributed by Stefan O'Rear, 15-Sep-2014.)
theorem qsqcl (A2: class):
  $ wi (wcel A2 cq) (wcel (co A2 c2 cexp) cq) $;

--| The square function is one-to-one for nonnegative reals. (Contributed by NM, 8-Apr-2001.) (Proof shortened by Mario Carneiro, 28-May-2016.)
theorem sq11 (A2 B2: class):
  $ wi (wa (wa (wcel A2 cr) (wbr cc0 A2 cle)) (wa (wcel B2 cr) (wbr cc0 B2 cle))) (wb (wceq (co A2 c2 cexp) (co B2 c2 cexp)) (wceq A2 B2)) $;

--| The square function is one-to-one for nonnegative integers. (Contributed by AV, 25-Jun-2023.)
theorem nn0sq11 (A2 B2: class):
  $ wi (wa (wcel A2 cn0) (wcel B2 cn0)) (wb (wceq (co A2 c2 cexp) (co B2 c2 cexp)) (wceq A2 B2)) $;

--| The square function is increasing on nonnegative reals. (Contributed by NM, 24-Feb-2006.)
theorem lt2sq (A2 B2: class):
  $ wi (wa (wa (wcel A2 cr) (wbr cc0 A2 cle)) (wa (wcel B2 cr) (wbr cc0 B2 cle))) (wb (wbr A2 B2 clt) (wbr (co A2 c2 cexp) (co B2 c2 cexp) clt)) $;

--| The square function is nondecreasing on nonnegative reals. (Contributed by NM, 18-Oct-1999.)
theorem le2sq (A2 B2: class):
  $ wi (wa (wa (wcel A2 cr) (wbr cc0 A2 cle)) (wa (wcel B2 cr) (wbr cc0 B2 cle))) (wb (wbr A2 B2 cle) (wbr (co A2 c2 cexp) (co B2 c2 cexp) cle)) $;

--| The square function is nondecreasing on the nonnegative reals. (Contributed by NM, 21-Mar-2008.)
theorem le2sq2 (A2 B2: class):
  $ wi (wa (wa (wcel A2 cr) (wbr cc0 A2 cle)) (wa (wcel B2 cr) (wbr A2 B2 cle))) (wbr (co A2 c2 cexp) (co B2 c2 cexp) cle) $;

--| The square of a real is nonnegative. (Contributed by NM, 18-Oct-1999.)
theorem sqge0 (A2: class):
  $ wi (wcel A2 cr) (wbr cc0 (co A2 c2 cexp) cle) $;

--| The square of a real is nonnegative, deduction form. (Contributed by Mario Carneiro, 28-May-2016.)
theorem sqge0d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wbr cc0 (co A2 c2 cexp) cle) $;

--| The square of an integer is a nonnegative integer. (Contributed by Mario Carneiro, 18-Apr-2014.) (Revised by Mario Carneiro, 14-Jul-2014.)
theorem zsqcl2 (A2: class):
  $ wi (wcel A2 cz) (wcel (co A2 c2 cexp) cn0) $;

--| Value of zero raised to a positive integer power. (Contributed by Mario Carneiro, 28-May-2016.)
theorem _0expd (ph: wff) (N: class):
  $ wi ph (wcel N cn) $ >
  $ wi ph (wceq (co cc0 N cexp) cc0) $;

--| Value of a complex number raised to the zeroth power. (Contributed by Mario Carneiro, 28-May-2016.)
theorem exp0d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (co A2 cc0 cexp) c1) $;

--| Value of a complex number raised to the first power. (Contributed by Mario Carneiro, 28-May-2016.)
theorem exp1d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (co A2 c1 cexp) A2) $;

--| If a positive integer power is zero, then its base is zero. (Contributed by Mario Carneiro, 28-May-2016.)
theorem expeq0d (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wceq (co A2 N cexp) cc0) $ >
  $ wi ph (wceq A2 cc0) $;

--| Value of square. Inference version. (Contributed by Mario Carneiro, 28-May-2016.)
theorem sqvald (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (co A2 c2 cexp) (co A2 A2 cmul)) $;

--| Closure of square. (Contributed by Mario Carneiro, 28-May-2016.)
theorem sqcld (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel (co A2 c2 cexp) cc) $;

--| A number is zero iff its square is zero. (Contributed by Mario Carneiro, 28-May-2016.)
theorem sqeq0d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (co A2 c2 cexp) cc0) $ >
  $ wi ph (wceq A2 cc0) $;

--| Closure law for nonnegative integer exponentiation. (Contributed by Mario Carneiro, 28-May-2016.)
theorem expcld (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel (co A2 N cexp) cc) $;

--| Value of a complex number raised to a nonnegative integer power plus one. Part of Definition 10-4.1 of [Gleason] p. 134. (Contributed by Mario Carneiro, 28-May-2016.)
theorem expp1d (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (co A2 (co N c1 caddc) cexp) (co (co A2 N cexp) A2 cmul)) $;

--| Sum of exponents law for nonnegative integer exponentiation. Proposition 10-4.2(a) of [Gleason] p. 135. (Contributed by Mario Carneiro, 28-May-2016.)
theorem expaddd (ph: wff) (A2 M N: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wceq (co A2 (co M N caddc) cexp) (co (co A2 M cexp) (co A2 N cexp) cmul)) $;

--| Product of exponents law for positive integer exponentiation. Proposition 10-4.2(b) of [Gleason] p. 135, restricted to nonnegative integer exponents. (Contributed by Mario Carneiro, 28-May-2016.)
theorem expmuld (ph: wff) (A2 M N: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wceq (co A2 (co M N cmul) cexp) (co (co A2 M cexp) N cexp)) $;

--| Square of reciprocal is reciprocal of square. (Contributed by Mario Carneiro, 28-May-2016.)
theorem sqrecd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wceq (co (co c1 A2 cdiv) c2 cexp) (co c1 (co A2 c2 cexp) cdiv)) $;

--| Closure law for integer exponentiation. (Contributed by Mario Carneiro, 28-May-2016.)
theorem expclzd (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wcel (co A2 N cexp) cc) $;

--| A nonnegative integer power is nonzero if its base is nonzero. (Contributed by Mario Carneiro, 28-May-2016.)
theorem expne0d (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wne (co A2 N cexp) cc0) $;

--| Value of a nonzero complex number raised to the negative of an integer power. (Contributed by Mario Carneiro, 28-May-2016.)
theorem expnegd (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wceq (co A2 (cneg N) cexp) (co c1 (co A2 N cexp) cdiv)) $;

--| An integer power of a reciprocal is the reciprocal of the integer power with same exponent. (Contributed by Mario Carneiro, 28-May-2016.)
theorem exprecd (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wceq (co (co c1 A2 cdiv) N cexp) (co c1 (co A2 N cexp) cdiv)) $;

--| Value of a nonzero complex number raised to an integer power plus one. (Contributed by Mario Carneiro, 28-May-2016.)
theorem expp1zd (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wceq (co A2 (co N c1 caddc) cexp) (co (co A2 N cexp) A2 cmul)) $;

--| Value of a nonzero complex number raised to an integer power minus one. (Contributed by Mario Carneiro, 28-May-2016.)
theorem expm1d (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wceq (co A2 (co N c1 cmin) cexp) (co (co A2 N cexp) A2 cdiv)) $;

--| Exponent subtraction law for integer exponentiation. (Contributed by Mario Carneiro, 28-May-2016.)
theorem expsubd (ph: wff) (A2 M N: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wceq (co A2 (co M N cmin) cexp) (co (co A2 M cexp) (co A2 N cexp) cdiv)) $;

--| Distribution of squaring over multiplication. (Contributed by Mario Carneiro, 28-May-2016.)
theorem sqmuld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wceq (co (co A2 B2 cmul) c2 cexp) (co (co A2 c2 cexp) (co B2 c2 cexp) cmul)) $;

--| Distribution of squaring over division. (Contributed by Mario Carneiro, 28-May-2016.)
theorem sqdivd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wne B2 cc0) $ >
  $ wi ph (wceq (co (co A2 B2 cdiv) c2 cexp) (co (co A2 c2 cexp) (co B2 c2 cexp) cdiv)) $;

--| Nonnegative integer exponentiation of a quotient. (Contributed by Mario Carneiro, 28-May-2016.)
theorem expdivd (ph: wff) (A2 B2 N: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wne B2 cc0) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (co (co A2 B2 cdiv) N cexp) (co (co A2 N cexp) (co B2 N cexp) cdiv)) $;

--| Nonnegative integer exponentiation of a product. Proposition 10-4.2(c) of [Gleason] p. 135, restricted to nonnegative integer exponents. (Contributed by Mario Carneiro, 28-May-2016.)
theorem mulexpd (ph: wff) (A2 B2 N: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (co (co A2 B2 cmul) N cexp) (co (co A2 N cexp) (co B2 N cexp) cmul)) $;

--| The square of a nonzero integer is a positive integer. (Contributed by Thierry Arnoux, 2-Feb-2020.)
theorem znsqcld (ph: wff) (N: class):
  $ wi ph (wcel N cz) $ >
  $ wi ph (wne N cc0) $ >
  $ wi ph (wcel (co N c2 cexp) cn) $;

--| Closure of exponentiation of reals. (Contributed by Mario Carneiro, 28-May-2016.)
theorem reexpcld (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel (co A2 N cexp) cr) $;

--| A nonnegative real raised to a nonnegative integer is nonnegative. (Contributed by Mario Carneiro, 28-May-2016.)
theorem expge0d (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wbr cc0 A2 cle) $ >
  $ wi ph (wbr cc0 (co A2 N cexp) cle) $;

--| A real greater than or equal to 1 raised to a nonnegative integer is greater than or equal to 1. (Contributed by Mario Carneiro, 28-May-2016.)
theorem expge1d (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wbr c1 A2 cle) $ >
  $ wi ph (wbr c1 (co A2 N cexp) cle) $;

--| Exponent ordering relationship for exponentiation of a fixed real base greater than 1 to integer exponents. (Contributed by NM, 2-Aug-2006.) (Revised by Mario Carneiro, 4-Jun-2014.)
theorem ltexp2a (A2 M N: class):
  $ wi (wa (w3a (wcel A2 cr) (wcel M cz) (wcel N cz)) (wa (wbr c1 A2 clt) (wbr M N clt))) (wbr (co A2 M cexp) (co A2 N cexp) clt) $;

--| Base ordering relationship for exponentiation of nonnegative reals to a fixed positive integer power. (Contributed by Stefan O'Rear, 16-Oct-2014.)
theorem expmordi (A2 B2 N: class):
  $ wi (w3a (wa (wcel A2 cr) (wcel B2 cr)) (wa (wbr cc0 A2 cle) (wbr A2 B2 clt)) (wcel N cn)) (wbr (co A2 N cexp) (co B2 N cexp) clt) $;

--| Base ordering relationship for exponentiation of positive reals to a fixed positive integer exponent. (Contributed by Stefan O'Rear, 16-Oct-2014.)
theorem rpexpmord (A2 B2 N: class):
  $ wi (w3a (wcel N cn) (wcel A2 crp) (wcel B2 crp)) (wb (wbr A2 B2 clt) (wbr (co A2 N cexp) (co B2 N cexp) clt)) $;

--| Cancellation law for integer exponentiation of reals. (Contributed by NM, 2-Aug-2006.) (Revised by Mario Carneiro, 4-Jun-2014.)
theorem expcan (A2 M N: class):
  $ wi (wa (w3a (wcel A2 cr) (wcel M cz) (wcel N cz)) (wbr c1 A2 clt)) (wb (wceq (co A2 M cexp) (co A2 N cexp)) (wceq M N)) $;

--| Strict ordering law for exponentiation of a fixed real base greater than 1 to integer exponents. (Contributed by NM, 2-Aug-2006.) (Revised by Mario Carneiro, 5-Jun-2014.)
theorem ltexp2 (A2 M N: class):
  $ wi (wa (w3a (wcel A2 cr) (wcel M cz) (wcel N cz)) (wbr c1 A2 clt)) (wb (wbr M N clt) (wbr (co A2 M cexp) (co A2 N cexp) clt)) $;

--| Ordering law for exponentiation of a fixed real base greater than 1 to integer exponents. (Contributed by Mario Carneiro, 26-Apr-2016.)
theorem leexp2 (A2 M N: class):
  $ wi (wa (w3a (wcel A2 cr) (wcel M cz) (wcel N cz)) (wbr c1 A2 clt)) (wb (wbr M N cle) (wbr (co A2 M cexp) (co A2 N cexp) cle)) $;

--| Weak ordering relationship for exponentiation of a fixed real base greater than or equal to 1 to integer exponents. (Contributed by NM, 14-Dec-2005.) (Revised by Mario Carneiro, 5-Jun-2014.)
theorem leexp2a (A2 M N: class):
  $ wi (w3a (wcel A2 cr) (wbr c1 A2 cle) (wcel N (cfv M cuz))) (wbr (co A2 M cexp) (co A2 N cexp) cle) $;

--| The integer powers of a fixed positive real less than 1 decrease as the exponent increases. (Contributed by NM, 2-Aug-2006.) (Revised by Mario Carneiro, 5-Jun-2014.)
theorem ltexp2r (A2 M N: class):
  $ wi (wa (w3a (wcel A2 crp) (wcel M cz) (wcel N cz)) (wbr A2 c1 clt)) (wb (wbr M N clt) (wbr (co A2 N cexp) (co A2 M cexp) clt)) $;

--| Weak ordering relationship for exponentiation of a fixed real base in ` [ 0 , 1 ] ` to integer exponents. (Contributed by Paul Chapman, 14-Jan-2008.) (Revised by Mario Carneiro, 29-Apr-2014.)
theorem leexp2r (A2 M N: class):
  $ wi (wa (w3a (wcel A2 cr) (wcel M cn0) (wcel N (cfv M cuz))) (wa (wbr cc0 A2 cle) (wbr A2 c1 cle))) (wbr (co A2 N cexp) (co A2 M cexp) cle) $;

--| Weak base ordering relationship for exponentiation of real bases to a fixed nonnegative integer exponent. (Contributed by NM, 18-Dec-2005.)
theorem leexp1a (A2 B2 N: class):
  $ wi (wa (w3a (wcel A2 cr) (wcel B2 cr) (wcel N cn0)) (wa (wbr cc0 A2 cle) (wbr A2 B2 cle))) (wbr (co A2 N cexp) (co B2 N cexp) cle) $;

--| Weak base ordering relationship for exponentiation, a deduction version. (Contributed by metakunt, 22-May-2024.)
theorem leexp1ad (ph: wff) (A2 B2 N: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wbr cc0 A2 cle) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wi ph (wbr (co A2 N cexp) (co B2 N cexp) cle) $;

--| A real between 0 and 1 inclusive raised to a nonnegative integer power is less than or equal to 1. (Contributed by Paul Chapman, 29-Dec-2007.) (Revised by Mario Carneiro, 5-Jun-2014.)
theorem exple1 (A2 N: class):
  $ wi (wa (w3a (wcel A2 cr) (wbr cc0 A2 cle) (wbr A2 c1 cle)) (wcel N cn0)) (wbr (co A2 N cexp) c1 cle) $;

--| An upper bound on ` A ^ N ` when ` 2 <_ A ` . (Contributed by NM, 19-Dec-2005.)
theorem expubnd (A2 N: class):
  $ wi (w3a (wcel A2 cr) (wcel N cn0) (wbr c2 A2 cle)) (wbr (co A2 N cexp) (co (co c2 N cexp) (co (co A2 c1 cmin) N cexp) cmul) cle) $;

--| The sum of two squres of reals is zero if and only if both reals are zero. (Contributed by NM, 29-Apr-2005.) (Revised by Stefan O'Rear, 5-Oct-2014.) (Proof shortened by Mario Carneiro, 28-May-2016.)
theorem sumsqeq0 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wb (wa (wceq A2 cc0) (wceq B2 cc0)) (wceq (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) cc0)) $;

--| Value of square. Inference version. (Contributed by NM, 1-Aug-1999.)
theorem sqvali (A2: class):
  $ wcel A2 cc $ >
  $ wceq (co A2 c2 cexp) (co A2 A2 cmul) $;

--| Closure of square. (Contributed by NM, 2-Aug-1999.)
theorem sqcli (A2: class):
  $ wcel A2 cc $ >
  $ wcel (co A2 c2 cexp) cc $;

--| A complex number is zero iff its square is zero. (Contributed by NM, 2-Oct-1999.)
theorem sqeq0i (A2: class):
  $ wcel A2 cc $ >
  $ wb (wceq (co A2 c2 cexp) cc0) (wceq A2 cc0) $;

--| The square of a reciprocal is the reciprocal of the square. (Contributed by NM, 17-Sep-1999.)
theorem sqrecii (A2: class):
  $ wcel A2 cc $ >
  $ wne A2 cc0 $ >
  $ wceq (co (co c1 A2 cdiv) c2 cexp) (co c1 (co A2 c2 cexp) cdiv) $;

--| Distribution of squaring over multiplication. (Contributed by NM, 3-Sep-1999.)
theorem sqmuli (A2 B2: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wceq (co (co A2 B2 cmul) c2 cexp) (co (co A2 c2 cexp) (co B2 c2 cexp) cmul) $;

--| Distribution of squaring over division. (Contributed by NM, 20-Aug-2001.)
theorem sqdivi (A2 B2: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wne B2 cc0 $ >
  $ wceq (co (co A2 B2 cdiv) c2 cexp) (co (co A2 c2 cexp) (co B2 c2 cexp) cdiv) $;

--| Closure of square in reals. (Contributed by NM, 2-Aug-1999.)
theorem resqcli (A2: class):
  $ wcel A2 cr $ >
  $ wcel (co A2 c2 cexp) cr $;

--| The square of a nonzero real is positive. (Contributed by NM, 17-Sep-1999.)
theorem sqgt0i (A2: class):
  $ wcel A2 cr $ >
  $ wi (wne A2 cc0) (wbr cc0 (co A2 c2 cexp) clt) $;

--| The square of a real is nonnegative. (Contributed by NM, 3-Aug-1999.)
theorem sqge0i (A2: class):
  $ wcel A2 cr $ >
  $ wbr cc0 (co A2 c2 cexp) cle $;

--| The square function on nonnegative reals is increasing. (Contributed by NM, 12-Sep-1999.)
theorem lt2sqi (A2 B2: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wi (wa (wbr cc0 A2 cle) (wbr cc0 B2 cle)) (wb (wbr A2 B2 clt) (wbr (co A2 c2 cexp) (co B2 c2 cexp) clt)) $;

--| The square function on nonnegative reals is nondecreasing. (Contributed by NM, 12-Sep-1999.)
theorem le2sqi (A2 B2: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wi (wa (wbr cc0 A2 cle) (wbr cc0 B2 cle)) (wb (wbr A2 B2 cle) (wbr (co A2 c2 cexp) (co B2 c2 cexp) cle)) $;

--| The square function is one-to-one for nonnegative reals. (Contributed by NM, 27-Oct-1999.)
theorem sq11i (A2 B2: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wi (wa (wbr cc0 A2 cle) (wbr cc0 B2 cle)) (wb (wceq (co A2 c2 cexp) (co B2 c2 cexp)) (wceq A2 B2)) $;

--| The square of 0 is 0. (Contributed by NM, 6-Jun-2006.)
theorem sq0:
  $ wceq (co cc0 c2 cexp) cc0 $;

--| If a number is zero, then its square is zero. (Contributed by FL, 10-Dec-2006.)
theorem sq0i (A2: class):
  $ wi (wceq A2 cc0) (wceq (co A2 c2 cexp) cc0) $;

--| If a number is zero, then its square is zero. Deduction form of ~ sq0i . Converse of ~ sqeq0d . (Contributed by David Moews, 28-Feb-2017.)
theorem sq0id (ph: wff) (A2: class):
  $ wi ph (wceq A2 cc0) $ >
  $ wi ph (wceq (co A2 c2 cexp) cc0) $;

--| The square of 1 is 1. (Contributed by NM, 22-Aug-1999.)
theorem sq1:
  $ wceq (co c1 c2 cexp) c1 $;

--| The square of ` -u 1 ` is 1. (Contributed by David A. Wheeler, 8-Dec-2018.)
theorem neg1sqe1:
  $ wceq (co (cneg c1) c2 cexp) c1 $;

--| The square of 2 is 4. (Contributed by NM, 22-Aug-1999.)
theorem sq2:
  $ wceq (co c2 c2 cexp) c4 $;

--| The square of 3 is 9. (Contributed by NM, 26-Apr-2006.)
theorem sq3:
  $ wceq (co c3 c2 cexp) c9 $;

--| The square of 4 is 2 times 8. (Contributed by AV, 20-Jul-2021.)
theorem sq4e2t8:
  $ wceq (co c4 c2 cexp) (co c2 c8 cmul) $;

--| The cube of 2 is 8. (Contributed by NM, 2-Aug-2004.)
theorem cu2:
  $ wceq (co c2 c3 cexp) c8 $;

--| Raising a number to the fourth power is equivalent to squaring it twice. (Contributed by SN, 21-Aug-2024.)
theorem exp4sqsq (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (co A2 c4 cexp) (co (co A2 c2 cexp) c2 cexp)) $;

--| The reciprocal of ` _i ` . (Contributed by NM, 11-Oct-1999.)
theorem irec:
  $ wceq (co c1 ci cdiv) (cneg ci) $;

--| ` _i ` squared. (Contributed by NM, 6-May-1999.)
theorem i2:
  $ wceq (co ci c2 cexp) (cneg c1) $;

--| ` _i ` cubed. (Contributed by NM, 31-Jan-2007.)
theorem i3:
  $ wceq (co ci c3 cexp) (cneg ci) $;

--| ` _i ` to the fourth power. (Contributed by NM, 31-Jan-2007.)
theorem i4:
  $ wceq (co ci c4 cexp) c1 $;

--| A positive integer is less than or equal to its square. For general integers, see ~ zzlesq . (Contributed by NM, 15-Sep-1999.) (Revised by Mario Carneiro, 12-Sep-2015.)
theorem nnlesq (N: class):
  $ wi (wcel N cn) (wbr N (co N c2 cexp) cle) $;

--| An integer is less than or equal to its square. (Contributed by BJ, 6-Feb-2025.)
theorem zzlesq (N: class):
  $ wi (wcel N cz) (wbr N (co N c2 cexp) cle) $;

--| Taking ` _i ` to the ` K ` -th power is the same as using the ` K mod 4 ` -th power instead, by ~ i4 . (Contributed by Mario Carneiro, 7-Jul-2014.)
theorem iexpcyc (K: class):
  $ wi (wcel K cz) (wceq (co ci (co K c4 cmo) cexp) (co ci K cexp)) $;

--| A counterexample showing that exponentiation is not associative. (Contributed by Stefan Allan and G&eacute;rard Lang, 21-Sep-2010.)
theorem expnass:
  $ wbr (co (co c3 c3 cexp) c3 cexp) (co c3 (co c3 c3 cexp) cexp) clt $;

--| Cancel one factor of a square in a ` <_ ` comparison. Unlike ~ lemul1 , the common factor ` A ` may be zero. (Contributed by NM, 17-Jan-2008.)
theorem sqlecan (A2 B2: class):
  $ wi (wa (wa (wcel A2 cr) (wbr cc0 A2 cle)) (wa (wcel B2 cr) (wbr cc0 B2 cle))) (wb (wbr (co A2 c2 cexp) (co B2 A2 cmul) cle) (wbr A2 B2 cle)) $;

--| Factor the difference of two squares. (Contributed by NM, 21-Feb-2008.)
theorem subsq (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co (co A2 c2 cexp) (co B2 c2 cexp) cmin) (co (co A2 B2 caddc) (co A2 B2 cmin) cmul)) $;

--| Express the difference of the squares of two numbers as a polynomial in the difference of the numbers. (Contributed by NM, 21-Feb-2008.)
theorem subsq2 (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co (co A2 c2 cexp) (co B2 c2 cexp) cmin) (co (co (co A2 B2 cmin) c2 cexp) (co (co c2 B2 cmul) (co A2 B2 cmin) cmul) caddc)) $;

--| The square of a binomial. (Contributed by NM, 11-Aug-1999.)
theorem binom2i (A2 B2: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wceq (co (co A2 B2 caddc) c2 cexp) (co (co (co A2 c2 cexp) (co c2 (co A2 B2 cmul) cmul) caddc) (co B2 c2 cexp) caddc) $;

--| Factor the difference of two squares. (Contributed by NM, 7-Feb-2005.)
theorem subsqi (A2 B2: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wceq (co (co A2 c2 cexp) (co B2 c2 cexp) cmin) (co (co A2 B2 caddc) (co A2 B2 cmin) cmul) $;

--| The squares of two complex numbers are equal iff one number equals the other or its negative. Lemma 15-4.7 of [Gleason] p. 311 and its converse. (Contributed by NM, 15-Jan-2006.)
theorem sqeqori (A2 B2: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wb (wceq (co A2 c2 cexp) (co B2 c2 cexp)) (wo (wceq A2 B2) (wceq A2 (cneg B2))) $;

--| The two solutions to the difference of squares set equal to zero. (Contributed by NM, 25-Apr-2006.)
theorem subsq0i (A2 B2: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wb (wceq (co (co A2 c2 cexp) (co B2 c2 cexp) cmin) cc0) (wo (wceq A2 B2) (wceq A2 (cneg B2))) $;

--| The squares of two complex numbers are equal iff one number equals the other or its negative. Lemma 15-4.7 of [Gleason] p. 311 and its converse. (Contributed by Paul Chapman, 15-Mar-2008.)
theorem sqeqor (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wb (wceq (co A2 c2 cexp) (co B2 c2 cexp)) (wo (wceq A2 B2) (wceq A2 (cneg B2)))) $;

--| The square of a binomial. (Contributed by FL, 10-Dec-2006.)
theorem binom2 (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co (co A2 B2 caddc) c2 cexp) (co (co (co A2 c2 cexp) (co c2 (co A2 B2 cmul) cmul) caddc) (co B2 c2 cexp) caddc)) $;

--| Deduction form of ~ binom2 . (Contributed by Igor Ieskov, 14-Dec-2023.)
theorem binom2d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wceq (co (co A2 B2 caddc) c2 cexp) (co (co (co A2 c2 cexp) (co c2 (co A2 B2 cmul) cmul) caddc) (co B2 c2 cexp) caddc)) $;

--| Special case of ~ binom2 where ` B = 1 ` . (Contributed by Scott Fenton, 11-May-2014.)
theorem binom21 (A2: class):
  $ wi (wcel A2 cc) (wceq (co (co A2 c1 caddc) c2 cexp) (co (co (co A2 c2 cexp) (co c2 A2 cmul) caddc) c1 caddc)) $;

--| Expand the square of a subtraction. (Contributed by Scott Fenton, 10-Jun-2013.)
theorem binom2sub (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co (co A2 B2 cmin) c2 cexp) (co (co (co A2 c2 cexp) (co c2 (co A2 B2 cmul) cmul) cmin) (co B2 c2 cexp) caddc)) $;

--| Special case of ~ binom2sub where ` B = 1 ` . (Contributed by AV, 2-Aug-2021.)
theorem binom2sub1 (A2: class):
  $ wi (wcel A2 cc) (wceq (co (co A2 c1 cmin) c2 cexp) (co (co (co A2 c2 cexp) (co c2 A2 cmul) cmin) c1 caddc)) $;

--| Expand the square of a subtraction. (Contributed by Scott Fenton, 13-Jun-2013.)
theorem binom2subi (A2 B2: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wceq (co (co A2 B2 cmin) c2 cexp) (co (co (co A2 c2 cexp) (co c2 (co A2 B2 cmul) cmul) cmin) (co B2 c2 cexp) caddc) $;

--| The square of a binomial with factor. (Contributed by AV, 19-Jul-2021.)
theorem mulbinom2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (co (co (co C A2 cmul) B2 caddc) c2 cexp) (co (co (co (co C A2 cmul) c2 cexp) (co (co c2 C cmul) (co A2 B2 cmul) cmul) caddc) (co B2 c2 cexp) caddc)) $;

--| The cube of a binomial. (Contributed by Mario Carneiro, 24-Apr-2015.)
theorem binom3 (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co (co A2 B2 caddc) c3 cexp) (co (co (co A2 c3 cexp) (co c3 (co (co A2 c2 cexp) B2 cmul) cmul) caddc) (co (co c3 (co A2 (co B2 c2 cexp) cmul) cmul) (co B2 c3 cexp) caddc) caddc)) $;

--| If a complex number equals its square, it must be 0 or 1. (Contributed by NM, 6-Jun-2006.)
theorem sq01 (A2: class):
  $ wi (wcel A2 cc) (wb (wceq (co A2 c2 cexp) A2) (wo (wceq A2 cc0) (wceq A2 c1))) $;

--| An integer is even iff its square is even. (Contributed by Mario Carneiro, 12-Sep-2015.)
theorem zesq (N: class):
  $ wi (wcel N cz) (wb (wcel (co N c2 cdiv) cz) (wcel (co (co N c2 cexp) c2 cdiv) cz)) $;

--| A positive integer is even iff its square is even. (Contributed by NM, 20-Aug-2001.) (Revised by Mario Carneiro, 12-Sep-2015.)
theorem nnesq (N: class):
  $ wi (wcel N cn) (wb (wcel (co N c2 cdiv) cn) (wcel (co (co N c2 cexp) c2 cdiv) cn)) $;

--| Reciprocal of a complex number in terms of real and imaginary components. Remark in [Apostol] p. 361. (Contributed by NM, 29-Apr-2005.) (Proof shortened by Jeff Hankins, 16-Dec-2013.)
theorem crreczi (A2 B2: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wi (wo (wne A2 cc0) (wne B2 cc0)) (wceq (co c1 (co A2 (co ci B2 cmul) caddc) cdiv) (co (co A2 (co ci B2 cmul) cmin) (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) cdiv)) $;

--| Bernoulli's inequality, due to Johan Bernoulli (1667-1748). (Contributed by NM, 21-Feb-2005.)
theorem bernneq (A2 N: class):
  $ wi (w3a (wcel A2 cr) (wcel N cn0) (wbr (cneg c1) A2 cle)) (wbr (co c1 (co A2 N cmul) caddc) (co (co c1 A2 caddc) N cexp) cle) $;

--| Variation of Bernoulli's inequality ~ bernneq . (Contributed by NM, 18-Oct-2007.)
theorem bernneq2 (A2 N: class):
  $ wi (w3a (wcel A2 cr) (wcel N cn0) (wbr cc0 A2 cle)) (wbr (co (co (co A2 c1 cmin) N cmul) c1 caddc) (co A2 N cexp) cle) $;

--| A corollary of ~ bernneq . (Contributed by Mario Carneiro, 11-Mar-2014.)
theorem bernneq3 (P N: class):
  $ wi (wa (wcel P (cfv c2 cuz)) (wcel N cn0)) (wbr N (co P N cexp) clt) $;

--| Exponentiation with a base greater than 1 has no upper bound. (Contributed by NM, 20-Oct-2007.)
theorem expnbnd {k: setvar} (A2 B2: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wbr c1 B2 clt)) (wrex k (wbr A2 (co B2 (cv k) cexp) clt) cn) $;

--| The reciprocal of exponentiation with a base greater than 1 has no positive lower bound. (Contributed by NM, 18-Jul-2008.)
theorem expnlbnd {k: setvar} (A2 B2: class):
  $ wi (w3a (wcel A2 crp) (wcel B2 cr) (wbr c1 B2 clt)) (wrex k (wbr (co c1 (co B2 (cv k) cexp) cdiv) A2 clt) cn) $;

--| The reciprocal of exponentiation with a base greater than 1 has no positive lower bound. (Contributed by NM, 18-Jul-2008.) (Proof shortened by Mario Carneiro, 5-Jun-2014.)
theorem expnlbnd2 {j k: setvar} (A2 B2: class):
  $ wi (w3a (wcel A2 crp) (wcel B2 cr) (wbr c1 B2 clt)) (wrex j (wral k (wbr (co c1 (co B2 (cv k) cexp) cdiv) A2 clt) (cfv (cv j) cuz)) cn) $;

--| Exponentiation with a base greater than 1 is not bounded by any linear function. (Contributed by Mario Carneiro, 31-Mar-2015.)
theorem expmulnbnd {j k: setvar} (A2 B2: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wbr c1 B2 clt)) (wrex j (wral k (wbr (co A2 (cv k) cmul) (co B2 (cv k) cexp) clt) (cfv (cv j) cuz)) cn0) $;

--| Two ways to express the ` K ` th digit in the decimal (when base ` B = 1 0 ` ) expansion of a number ` A ` . ` K = 1 ` corresponds to the first digit after the decimal point. (Contributed by NM, 25-Dec-2008.)
theorem digit2 (A2 B2 K: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cn) (wcel K cn)) (wceq (co (cfv (co (co B2 K cexp) A2 cmul) cfl) B2 cmo) (co (cfv (co (co B2 K cexp) A2 cmul) cfl) (co B2 (cfv (co (co B2 (co K c1 cmin) cexp) A2 cmul) cfl) cmul) cmin)) $;

--| Two ways to express the ` K ` th digit in the decimal expansion of a number ` A ` (when base ` B = 1 0 ` ). ` K = 1 ` corresponds to the first digit after the decimal point. (Contributed by NM, 3-Jan-2009.)
theorem digit1 (A2 B2 K: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cn) (wcel K cn)) (wceq (co (cfv (co (co B2 K cexp) A2 cmul) cfl) B2 cmo) (co (co (cfv (co (co B2 K cexp) A2 cmul) cfl) (co B2 K cexp) cmo) (co (co B2 (cfv (co (co B2 (co K c1 cmin) cexp) A2 cmul) cfl) cmul) (co B2 K cexp) cmo) cmin)) $;

--| Exponentiation property of the modulo operation, see theorem 5.2(c) in [ApostolNT] p. 107. (Contributed by Mario Carneiro, 28-Feb-2014.)
theorem modexp (A2 B2 C D: class):
  $ wi (w3a (wa (wcel A2 cz) (wcel B2 cz)) (wa (wcel C cn0) (wcel D crp)) (wceq (co A2 D cmo) (co B2 D cmo))) (wceq (co (co A2 C cexp) D cmo) (co (co B2 C cexp) D cmo)) $;

--| A nonnegative quadratic form has nonnegative leading coefficient. (Contributed by Mario Carneiro, 4-Jun-2014.)
theorem discr1 {x3: setvar} (ph: wff) (A2 B2 C X: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi (wa ph (wcel (cv x3) cr)) (wbr cc0 (co (co (co A2 (co (cv x3) c2 cexp) cmul) (co B2 (cv x3) cmul) caddc) C caddc) cle) $ >
  $ wceq X (cif (wbr c1 (co (co (co B2 (cif (wbr cc0 C cle) C cc0) caddc) c1 caddc) (cneg A2) cdiv) cle) (co (co (co B2 (cif (wbr cc0 C cle) C cc0) caddc) c1 caddc) (cneg A2) cdiv) c1) $ >
  $ wi ph (wbr cc0 A2 cle) $;

--| If a quadratic polynomial with real coefficients is nonnegative for all values, then its discriminant is nonpositive. (Contributed by NM, 10-Aug-1999.) (Revised by Mario Carneiro, 4-Jun-2014.)
theorem discr {x3: setvar} (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi (wa ph (wcel (cv x3) cr)) (wbr cc0 (co (co (co A2 (co (cv x3) c2 cexp) cmul) (co B2 (cv x3) cmul) caddc) C caddc) cle) $ >
  $ wi ph (wbr (co (co B2 c2 cexp) (co c4 (co A2 C cmul) cmul) cmin) cc0 cle) $;

--| If an integer power with a positive integer base is greater than 1, then the exponent is positive. (Contributed by AV, 28-Dec-2022.)
theorem expnngt1 (A2 B2: class):
  $ wi (w3a (wcel A2 cn) (wcel B2 cz) (wbr c1 (co A2 B2 cexp) clt)) (wcel B2 cn) $;

--| An integer power with an integer base greater than 1 is greater than 1 iff the exponent is positive. (Contributed by AV, 28-Dec-2022.)
theorem expnngt1b (A2 B2: class):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel B2 cz)) (wb (wbr c1 (co A2 B2 cexp) clt) (wcel B2 cn)) $;

--| A squared odd number minus 1 divided by 8 is the odd number multiplied with its successor divided by 2. (Contributed by AV, 19-Jul-2021.)
theorem sqoddm1div8 (M N: class):
  $ wi (wa (wcel N cz) (wceq M (co (co c2 N cmul) c1 caddc))) (wceq (co (co (co M c2 cexp) c1 cmin) c8 cdiv) (co (co N (co N c1 caddc) cmul) c2 cdiv)) $;

--| The naturals are closed under squaring. (Contributed by Mario Carneiro, 28-May-2016.)
theorem nnsqcld (ph: wff) (A2: class):
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel (co A2 c2 cexp) cn) $;

--| Closure of exponentiation of nonnegative integers. (Contributed by Mario Carneiro, 28-May-2016.)
theorem nnexpcld (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel (co A2 N cexp) cn) $;

--| Closure of exponentiation of nonnegative integers. (Contributed by Mario Carneiro, 28-May-2016.)
theorem nn0expcld (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 cn0) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel (co A2 N cexp) cn0) $;

--| Closure law for exponentiation of positive reals. (Contributed by Mario Carneiro, 28-May-2016.)
theorem rpexpcld (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wcel (co A2 N cexp) crp) $;

--| The power of a positive number less than 1 decreases as its exponent increases. (Contributed by Mario Carneiro, 28-May-2016.)
theorem ltexp2rd (ph: wff) (A2 M N: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wbr A2 c1 clt) $ >
  $ wi ph (wb (wbr M N clt) (wbr (co A2 N cexp) (co A2 M cexp) clt)) $;

--| Closure of exponentiation of reals. (Contributed by Mario Carneiro, 28-May-2016.)
theorem reexpclzd (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wcel (co A2 N cexp) cr) $;

--| The square of a nonzero real is positive. (Contributed by Mario Carneiro, 28-May-2016.)
theorem sqgt0d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wbr cc0 (co A2 c2 cexp) clt) $;

--| Ordering relationship for exponentiation. (Contributed by Mario Carneiro, 28-May-2016.)
theorem ltexp2d (ph: wff) (A2 M N: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wbr c1 A2 clt) $ >
  $ wi ph (wb (wbr M N clt) (wbr (co A2 M cexp) (co A2 N cexp) clt)) $;

--| Ordering law for exponentiation. (Contributed by Mario Carneiro, 28-May-2016.)
theorem leexp2d (ph: wff) (A2 M N: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wbr c1 A2 clt) $ >
  $ wi ph (wb (wbr M N cle) (wbr (co A2 M cexp) (co A2 N cexp) cle)) $;

--| Ordering relationship for exponentiation. (Contributed by Mario Carneiro, 28-May-2016.)
theorem expcand (ph: wff) (A2 M N: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wbr c1 A2 clt) $ >
  $ wi ph (wceq (co A2 M cexp) (co A2 N cexp)) $ >
  $ wi ph (wceq M N) $;

--| Ordering relationship for exponentiation. (Contributed by Mario Carneiro, 28-May-2016.)
theorem leexp2ad (ph: wff) (A2 M N: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wbr c1 A2 cle) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi ph (wbr (co A2 M cexp) (co A2 N cexp) cle) $;

--| Ordering relationship for exponentiation. (Contributed by Mario Carneiro, 28-May-2016.)
theorem leexp2rd (ph: wff) (A2 M N: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi ph (wbr cc0 A2 cle) $ >
  $ wi ph (wbr A2 c1 cle) $ >
  $ wi ph (wbr (co A2 N cexp) (co A2 M cexp) cle) $;

--| The square function on nonnegative reals is strictly monotonic. (Contributed by Mario Carneiro, 28-May-2016.)
theorem lt2sqd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr cc0 A2 cle) $ >
  $ wi ph (wbr cc0 B2 cle) $ >
  $ wi ph (wb (wbr A2 B2 clt) (wbr (co A2 c2 cexp) (co B2 c2 cexp) clt)) $;

--| The square function on nonnegative reals is monotonic. (Contributed by Mario Carneiro, 28-May-2016.)
theorem le2sqd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr cc0 A2 cle) $ >
  $ wi ph (wbr cc0 B2 cle) $ >
  $ wi ph (wb (wbr A2 B2 cle) (wbr (co A2 c2 cexp) (co B2 c2 cexp) cle)) $;

--| The square function is one-to-one for nonnegative reals. (Contributed by Mario Carneiro, 28-May-2016.)
theorem sq11d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr cc0 A2 cle) $ >
  $ wi ph (wbr cc0 B2 cle) $ >
  $ wi ph (wceq (co A2 c2 cexp) (co B2 c2 cexp)) $ >
  $ wi ph (wceq A2 B2) $;

--| Elevating to a positive power does not affect inequalities. Similar to ~ ltmul1d for exponentiation of positive reals. (Contributed by Steven Nguyen, 22-Aug-2023.)
theorem ltexp1d (ph: wff) (A2 B2 N: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wb (wbr A2 B2 clt) (wbr (co A2 N cexp) (co B2 N cexp) clt)) $;

--| Raising both sides of 'less than' to the same positive integer preserves ordering. (Contributed by Steven Nguyen, 24-Aug-2023.)
theorem ltexp1dd (ph: wff) (A2 B2 N: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr A2 B2 clt) $ >
  $ wi ph (wbr (co A2 N cexp) (co B2 N cexp) clt) $;

--| The function elevating nonnegative reals to a positive integer is one-to-one. Similar to ~ sq11d for positive real bases and positive integer exponents. The base cannot be generalized much further, since if ` N ` is even then we have ` A ^ N = -u A ^ N ` . (Contributed by SN, 14-Sep-2023.)
theorem exp11nnd (ph: wff) (A2 B2 N: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wceq (co A2 N cexp) (co B2 N cexp)) $ >
  $ wi ph (wceq A2 B2) $;

--| The square of a binomial with factor minus a number divided by a nonzero number. (Contributed by AV, 19-Jul-2021.)
theorem mulsubdivbinom2 (A2 B2 C D: class):
  $ wi (wa (w3a (wcel A2 cc) (wcel B2 cc) (wcel D cc)) (wa (wcel C cc) (wne C cc0))) (wceq (co (co (co (co (co C A2 cmul) B2 caddc) c2 cexp) D cmin) C cdiv) (co (co (co C (co A2 c2 cexp) cmul) (co c2 (co A2 B2 cmul) cmul) caddc) (co (co (co B2 c2 cexp) D cmin) C cdiv) caddc)) $;

--| The square of a binomial with factor divided by a nonzero number. (Contributed by AV, 19-Jul-2021.)
theorem muldivbinom2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wa (wcel C cc) (wne C cc0))) (wceq (co (co (co (co C A2 cmul) B2 caddc) c2 cexp) C cdiv) (co (co (co C (co A2 c2 cexp) cmul) (co c2 (co A2 B2 cmul) cmul) caddc) (co (co B2 c2 cexp) C cdiv) caddc)) $;

--| The square of 10 is 100. (Contributed by AV, 14-Jun-2021.) (Revised by AV, 1-Aug-2021.)
theorem sq10:
  $ wceq (co (cdc c1 cc0) c2 cexp) (cdc (cdc c1 cc0) cc0) $;

--| The square of 10 is 99 plus 1. (Contributed by AV, 14-Jun-2021.) (Revised by AV, 1-Aug-2021.)
theorem sq10e99m1:
  $ wceq (co (cdc c1 cc0) c2 cexp) (co (cdc c9 c9) c1 caddc) $;

--| A "decimal constructor" which is used to build up "decimal integers" or "numeric terms" in base 10 with 3 "digits". (Contributed by AV, 14-Jun-2021.) (Revised by AV, 1-Aug-2021.)
theorem _3dec (A2 B2 C: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 cn0 $ >
  $ wceq (cdc (cdc A2 B2) C) (co (co (co (co (cdc c1 cc0) c2 cexp) A2 cmul) (co (cdc c1 cc0) B2 cmul) caddc) C caddc) $;

--| The square function on nonnegative integers is monotonic. (Contributed by Raph Levien, 10-Dec-2002.)
theorem nn0le2msqi (A2 B2: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 cn0 $ >
  $ wb (wbr A2 B2 cle) (wbr (co A2 A2 cmul) (co B2 B2 cmul) cle) $;

--| A rather pretty lemma for ~ nn0opthi . (Contributed by Raph Levien, 10-Dec-2002.)
theorem nn0opthlem1 (A2 C: class):
  $ wcel A2 cn0 $ >
  $ wcel C cn0 $ >
  $ wb (wbr A2 C clt) (wbr (co (co A2 A2 cmul) (co c2 A2 cmul) caddc) (co C C cmul) clt) $;

--| Lemma for ~ nn0opthi . (Contributed by Raph Levien, 10-Dec-2002.) (Revised by Scott Fenton, 8-Sep-2010.)
theorem nn0opthlem2 (A2 B2 C D: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 cn0 $ >
  $ wcel C cn0 $ >
  $ wcel D cn0 $ >
  $ wi (wbr (co A2 B2 caddc) C clt) (wne (co (co C C cmul) D caddc) (co (co (co A2 B2 caddc) (co A2 B2 caddc) cmul) B2 caddc)) $;

--| An ordered pair theorem for nonnegative integers. Theorem 17.3 of [Quine] p. 124. We can represent an ordered pair of nonnegative integers ` A ` and ` B ` by ` ( ( ( A + B ) x. ( A + B ) ) + B ) ` . If two such ordered pairs are equal, their first elements are equal and their second elements are equal. Contrast this ordered pair representation with the standard one ~ df-op that works for any set. (Contributed by Raph Levien, 10-Dec-2002.) (Proof shortened by Scott Fenton, 8-Sep-2010.)
theorem nn0opthi (A2 B2 C D: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 cn0 $ >
  $ wcel C cn0 $ >
  $ wcel D cn0 $ >
  $ wb (wceq (co (co (co A2 B2 caddc) (co A2 B2 caddc) cmul) B2 caddc) (co (co (co C D caddc) (co C D caddc) cmul) D caddc)) (wa (wceq A2 C) (wceq B2 D)) $;

--| An ordered pair theorem for nonnegative integers. Theorem 17.3 of [Quine] p. 124. See comments for ~ nn0opthi . (Contributed by NM, 22-Jul-2004.)
theorem nn0opth2i (A2 B2 C D: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 cn0 $ >
  $ wcel C cn0 $ >
  $ wcel D cn0 $ >
  $ wb (wceq (co (co (co A2 B2 caddc) c2 cexp) B2 caddc) (co (co (co C D caddc) c2 cexp) D caddc)) (wa (wceq A2 C) (wceq B2 D)) $;

--| An ordered pair theorem for nonnegative integers. Theorem 17.3 of [Quine] p. 124. See ~ nn0opthi . (Contributed by NM, 22-Jul-2004.)
theorem nn0opth2 (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cn0) (wcel B2 cn0)) (wa (wcel C cn0) (wcel D cn0))) (wb (wceq (co (co (co A2 B2 caddc) c2 cexp) B2 caddc) (co (co (co C D caddc) c2 cexp) D caddc)) (wa (wceq A2 C) (wceq B2 D))) $;

--| Extend class notation to include the factorial of nonnegative integers.
term cfa: class;

--| Define the factorial function on nonnegative integers. For example, ` ( ! `` 5 ) = 1 2 0 ` because ` 1 x. 2 x. 3 x. 4 x. 5 = 1 2 0 ` ( ~ ex-fac ). In the literature, the factorial function is written as a postscript exclamation point. (Contributed by NM, 2-Dec-2004.)
axiom df_fac:
  $ wceq cfa (cun (csn (cop cc0 c1)) (cseq cmul cid c1)) $;

--| Value of the factorial function for positive integers. (Contributed by NM, 2-Dec-2004.) (Revised by Mario Carneiro, 13-Jul-2013.)
theorem facnn (N: class):
  $ wi (wcel N cn) (wceq (cfv N cfa) (cfv N (cseq cmul cid c1))) $;

--| The factorial of 0. (Contributed by NM, 2-Dec-2004.) (Revised by Mario Carneiro, 13-Jul-2013.)
theorem fac0:
  $ wceq (cfv cc0 cfa) c1 $;

--| The factorial of 1. (Contributed by NM, 2-Dec-2004.) (Revised by Mario Carneiro, 13-Jul-2013.)
theorem fac1:
  $ wceq (cfv c1 cfa) c1 $;

--| The factorial of a successor. (Contributed by NM, 2-Dec-2004.) (Revised by Mario Carneiro, 13-Jul-2013.)
theorem facp1 (N: class):
  $ wi (wcel N cn0) (wceq (cfv (co N c1 caddc) cfa) (co (cfv N cfa) (co N c1 caddc) cmul)) $;

--| The factorial of 2. (Contributed by NM, 17-Mar-2005.)
theorem fac2:
  $ wceq (cfv c2 cfa) c2 $;

--| The factorial of 3. (Contributed by NM, 17-Mar-2005.)
theorem fac3:
  $ wceq (cfv c3 cfa) c6 $;

--| The factorial of 4. (Contributed by Mario Carneiro, 18-Jun-2015.)
theorem fac4:
  $ wceq (cfv c4 cfa) (cdc c2 c4) $;

--| Value of the factorial function expressed recursively. (Contributed by NM, 2-Dec-2004.)
theorem facnn2 (N: class):
  $ wi (wcel N cn) (wceq (cfv N cfa) (co (cfv (co N c1 cmin) cfa) N cmul)) $;

--| Closure of the factorial function. (Contributed by NM, 2-Dec-2004.)
theorem faccl (N: class):
  $ wi (wcel N cn0) (wcel (cfv N cfa) cn) $;

--| Closure of the factorial function, deduction version of ~ faccl . (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem faccld (ph: wff) (N: class):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel (cfv N cfa) cn) $;

--| The factorial function restricted to positive integers is a mapping from the positive integers to the positive integers. (Contributed by AV, 8-Aug-2020.)
theorem facmapnn {n: setvar}:
  $ wcel (cmpt n cn (cfv (cv n) cfa)) (co cn cn cmap) $;

--| The factorial function is nonzero. (Contributed by NM, 26-Apr-2005.)
theorem facne0 (N: class):
  $ wi (wcel N cn0) (wne (cfv N cfa) cc0) $;

--| A positive integer divides the factorial of an equal or larger number. (Contributed by NM, 2-May-2005.)
theorem facdiv (M N: class):
  $ wi (w3a (wcel M cn0) (wcel N cn) (wbr N M cle)) (wcel (co (cfv M cfa) N cdiv) cn) $;

--| No positive integer (greater than one) divides the factorial plus one of an equal or larger number. (Contributed by NM, 3-May-2005.)
theorem facndiv (M N: class):
  $ wi (wa (wa (wcel M cn0) (wcel N cn)) (wa (wbr c1 N clt) (wbr N M cle))) (wn (wcel (co (co (cfv M cfa) c1 caddc) N cdiv) cz)) $;

--| Ordering property of factorial. (Contributed by NM, 9-Dec-2005.)
theorem facwordi (M N: class):
  $ wi (w3a (wcel M cn0) (wcel N cn0) (wbr M N cle)) (wbr (cfv M cfa) (cfv N cfa) cle) $;

--| A lower bound for the factorial function. (Contributed by NM, 17-Dec-2005.)
theorem faclbnd (M N: class):
  $ wi (wa (wcel M cn0) (wcel N cn0)) (wbr (co M (co N c1 caddc) cexp) (co (co M M cexp) (cfv N cfa) cmul) cle) $;

--| A lower bound for the factorial function. (Contributed by NM, 17-Dec-2005.)
theorem faclbnd2 (N: class):
  $ wi (wcel N cn0) (wbr (co (co c2 N cexp) c2 cdiv) (cfv N cfa) cle) $;

--| A lower bound for the factorial function. (Contributed by NM, 19-Dec-2005.)
theorem faclbnd3 (M N: class):
  $ wi (wa (wcel M cn0) (wcel N cn0)) (wbr (co M N cexp) (co (co M M cexp) (cfv N cfa) cmul) cle) $;

--| Lemma for ~ faclbnd4 . Prepare the induction step. (Contributed by NM, 20-Dec-2005.)
theorem faclbnd4lem1 (K M N: class):
  $ wcel N cn $ >
  $ wcel K cn0 $ >
  $ wcel M cn0 $ >
  $ wi (wbr (co (co (co N c1 cmin) K cexp) (co M (co N c1 cmin) cexp) cmul) (co (co (co c2 (co K c2 cexp) cexp) (co M (co M K caddc) cexp) cmul) (cfv (co N c1 cmin) cfa) cmul) cle) (wbr (co (co N (co K c1 caddc) cexp) (co M N cexp) cmul) (co (co (co c2 (co (co K c1 caddc) c2 cexp) cexp) (co M (co M (co K c1 caddc) caddc) cexp) cmul) (cfv N cfa) cmul) cle) $;

--| Lemma for ~ faclbnd4 . Use the weak deduction theorem to convert the hypotheses of ~ faclbnd4lem1 to antecedents. (Contributed by NM, 23-Dec-2005.)
theorem faclbnd4lem2 (K M N: class):
  $ wi (w3a (wcel M cn0) (wcel K cn0) (wcel N cn)) (wi (wbr (co (co (co N c1 cmin) K cexp) (co M (co N c1 cmin) cexp) cmul) (co (co (co c2 (co K c2 cexp) cexp) (co M (co M K caddc) cexp) cmul) (cfv (co N c1 cmin) cfa) cmul) cle) (wbr (co (co N (co K c1 caddc) cexp) (co M N cexp) cmul) (co (co (co c2 (co (co K c1 caddc) c2 cexp) cexp) (co M (co M (co K c1 caddc) caddc) cexp) cmul) (cfv N cfa) cmul) cle)) $;

--| Lemma for ~ faclbnd4 . The ` N = 0 ` case. (Contributed by NM, 23-Dec-2005.)
theorem faclbnd4lem3 (K M N: class):
  $ wi (wa (wa (wcel M cn0) (wcel K cn0)) (wceq N cc0)) (wbr (co (co N K cexp) (co M N cexp) cmul) (co (co (co c2 (co K c2 cexp) cexp) (co M (co M K caddc) cexp) cmul) (cfv N cfa) cmul) cle) $;

--| Lemma for ~ faclbnd4 . Prove the ` 0 < N ` case by induction on ` K ` . (Contributed by NM, 19-Dec-2005.)
theorem faclbnd4lem4 (K M N: class):
  $ wi (w3a (wcel N cn) (wcel K cn0) (wcel M cn0)) (wbr (co (co N K cexp) (co M N cexp) cmul) (co (co (co c2 (co K c2 cexp) cexp) (co M (co M K caddc) cexp) cmul) (cfv N cfa) cmul) cle) $;

--| Variant of ~ faclbnd5 providing a non-strict lower bound. (Contributed by NM, 23-Dec-2005.)
theorem faclbnd4 (K M N: class):
  $ wi (w3a (wcel N cn0) (wcel K cn0) (wcel M cn0)) (wbr (co (co N K cexp) (co M N cexp) cmul) (co (co (co c2 (co K c2 cexp) cexp) (co M (co M K caddc) cexp) cmul) (cfv N cfa) cmul) cle) $;

--| The factorial function grows faster than powers and exponentiations. If we consider ` K ` and ` M ` to be constants, the right-hand side of the inequality is a constant times ` N ` -factorial. (Contributed by NM, 24-Dec-2005.)
theorem faclbnd5 (K M N: class):
  $ wi (w3a (wcel N cn0) (wcel K cn0) (wcel M cn)) (wbr (co (co N K cexp) (co M N cexp) cmul) (co (co c2 (co (co c2 (co K c2 cexp) cexp) (co M (co M K caddc) cexp) cmul) cmul) (cfv N cfa) cmul) clt) $;

--| Geometric lower bound for the factorial function, where N is usually held constant. (Contributed by Paul Chapman, 28-Dec-2007.)
theorem faclbnd6 (M N: class):
  $ wi (wa (wcel N cn0) (wcel M cn0)) (wbr (co (cfv N cfa) (co (co N c1 caddc) M cexp) cmul) (cfv (co N M caddc) cfa) cle) $;

--| An upper bound for the factorial function. (Contributed by Mario Carneiro, 15-Apr-2016.)
theorem facubnd (N: class):
  $ wi (wcel N cn0) (wbr (cfv N cfa) (co N N cexp) cle) $;

--| The product of two factorials is greater than or equal to the factorial of (the floor of) their average. (Contributed by NM, 9-Dec-2005.)
theorem facavg (M N: class):
  $ wi (wa (wcel M cn0) (wcel N cn0)) (wbr (cfv (cfv (co (co M N caddc) c2 cdiv) cfl) cfa) (co (cfv M cfa) (cfv N cfa) cmul) cle) $;

--| Extend class notation to include the binomial coefficient operation (combinatorial choose operation).
term cbc: class;

--| Define the binomial coefficient operation. For example, ` ( 5 _C 3 ) = 1 0 ` ( ~ ex-bc ). In the literature, this function is often written as a column vector of the two arguments, or with the arguments as subscripts before and after the letter "C". The expression ` ( N _C K ) ` is read " ` N ` choose ` K ` ". Definition of binomial coefficient in [Gleason] p. 295. As suggested by Gleason, we define it to be 0 when ` 0 <_ k <_ n ` does not hold. (Contributed by NM, 10-Jul-2005.)
axiom df_bc {k n: setvar}:
  $ wceq cbc (cmpo n k cn0 cz (cif (wcel (cv k) (co cc0 (cv n) cfz)) (co (cfv (cv n) cfa) (co (cfv (co (cv n) (cv k) cmin) cfa) (cfv (cv k) cfa) cmul) cdiv) cc0)) $;

--| Value of the binomial coefficient, ` N ` choose ` K ` . Definition of binomial coefficient in [Gleason] p. 295. As suggested by Gleason, we define it to be 0 when ` 0 <_ K <_ N ` does not hold. See ~ bcval2 for the value in the standard domain. (Contributed by NM, 10-Jul-2005.) (Revised by Mario Carneiro, 7-Nov-2013.)
theorem bcval (K N: class):
  $ wi (wa (wcel N cn0) (wcel K cz)) (wceq (co N K cbc) (cif (wcel K (co cc0 N cfz)) (co (cfv N cfa) (co (cfv (co N K cmin) cfa) (cfv K cfa) cmul) cdiv) cc0)) $;

--| Value of the binomial coefficient, ` N ` choose ` K ` , in its standard domain. (Contributed by NM, 9-Jun-2005.) (Revised by Mario Carneiro, 7-Nov-2013.)
theorem bcval2 (K N: class):
  $ wi (wcel K (co cc0 N cfz)) (wceq (co N K cbc) (co (cfv N cfa) (co (cfv (co N K cmin) cfa) (cfv K cfa) cmul) cdiv)) $;

--| Value of the binomial coefficient, ` N ` choose ` K ` , outside of its standard domain. Remark in [Gleason] p. 295. (Contributed by NM, 14-Jul-2005.) (Revised by Mario Carneiro, 8-Nov-2013.)
theorem bcval3 (K N: class):
  $ wi (w3a (wcel N cn0) (wcel K cz) (wn (wcel K (co cc0 N cfz)))) (wceq (co N K cbc) cc0) $;

--| Value of the binomial coefficient, ` N ` choose ` K ` , outside of its standard domain. Remark in [Gleason] p. 295. (Contributed by NM, 14-Jul-2005.) (Revised by Mario Carneiro, 7-Nov-2013.)
theorem bcval4 (K N: class):
  $ wi (w3a (wcel N cn0) (wcel K cz) (wo (wbr K cc0 clt) (wbr N K clt))) (wceq (co N K cbc) cc0) $;

--| Closure of the binomial coefficient in the positive reals. (This is mostly a lemma before we have ~ bccl2 .) (Contributed by Mario Carneiro, 10-Mar-2014.)
theorem bcrpcl (K N: class):
  $ wi (wcel K (co cc0 N cfz)) (wcel (co N K cbc) crp) $;

--| "Complementing" its second argument doesn't change a binary coefficient. (Contributed by NM, 21-Jun-2005.) (Revised by Mario Carneiro, 5-Mar-2014.)
theorem bccmpl (K N: class):
  $ wi (wa (wcel N cn0) (wcel K cz)) (wceq (co N K cbc) (co N (co N K cmin) cbc)) $;

--| ` N ` choose 0 is 1. Remark in [Gleason] p. 296. (Contributed by NM, 17-Jun-2005.) (Revised by Mario Carneiro, 8-Nov-2013.)
theorem bcn0 (N: class):
  $ wi (wcel N cn0) (wceq (co N cc0 cbc) c1) $;

--| The binomial coefficient " 0 choose ` K ` " is 0 for a positive integer K. Note that ` ( 0 _C 0 ) = 1 ` (see ~ bcn0 ). (Contributed by Alexander van der Vekens, 1-Jan-2018.)
theorem bc0k (K: class):
  $ wi (wcel K cn) (wceq (co cc0 K cbc) cc0) $;

--| ` N ` choose ` N ` is 1. Remark in [Gleason] p. 296. (Contributed by NM, 17-Jun-2005.) (Revised by Mario Carneiro, 8-Nov-2013.)
theorem bcnn (N: class):
  $ wi (wcel N cn0) (wceq (co N N cbc) c1) $;

--| Binomial coefficient: ` N ` choose ` 1 ` . (Contributed by NM, 21-Jun-2005.) (Revised by Mario Carneiro, 8-Nov-2013.)
theorem bcn1 (N: class):
  $ wi (wcel N cn0) (wceq (co N c1 cbc) N) $;

--| Binomial coefficient: ` N + 1 ` choose ` N ` . (Contributed by NM, 20-Jun-2005.) (Revised by Mario Carneiro, 8-Nov-2013.)
theorem bcnp1n (N: class):
  $ wi (wcel N cn0) (wceq (co (co N c1 caddc) N cbc) (co N c1 caddc)) $;

--| The proportion of one binomial coefficient to another with ` K ` decreased by 1. (Contributed by Mario Carneiro, 10-Mar-2014.)
theorem bcm1k (K N: class):
  $ wi (wcel K (co c1 N cfz)) (wceq (co N K cbc) (co (co N (co K c1 cmin) cbc) (co (co N (co K c1 cmin) cmin) K cdiv) cmul)) $;

--| The proportion of one binomial coefficient to another with ` N ` increased by 1. (Contributed by Mario Carneiro, 10-Mar-2014.)
theorem bcp1n (K N: class):
  $ wi (wcel K (co cc0 N cfz)) (wceq (co (co N c1 caddc) K cbc) (co (co N K cbc) (co (co N c1 caddc) (co (co N c1 caddc) K cmin) cdiv) cmul)) $;

--| The proportion of one binomial coefficient to another with ` N ` and ` K ` increased by 1. (Contributed by Mario Carneiro, 16-Jan-2015.)
theorem bcp1nk (K N: class):
  $ wi (wcel K (co cc0 N cfz)) (wceq (co (co N c1 caddc) (co K c1 caddc) cbc) (co (co N K cbc) (co (co N c1 caddc) (co K c1 caddc) cdiv) cmul)) $;

--| Write out the top and bottom parts of the binomial coefficient ` ( N _C K ) = ( N x. ( N - 1 ) x. ... x. ( ( N - K ) + 1 ) ) / K ! ` explicitly. In this form, it is valid even for ` N < K ` , although it is no longer valid for nonpositive ` K ` . (Contributed by Mario Carneiro, 22-May-2014.)
theorem bcval5 (K N: class):
  $ wi (wa (wcel N cn0) (wcel K cn)) (wceq (co N K cbc) (co (cfv N (cseq cmul cid (co (co N K cmin) c1 caddc))) (cfv K cfa) cdiv)) $;

--| Binomial coefficient: ` N ` choose ` 2 ` . (Contributed by Mario Carneiro, 22-May-2014.)
theorem bcn2 (N: class):
  $ wi (wcel N cn0) (wceq (co N c2 cbc) (co (co N (co N c1 cmin) cmul) c2 cdiv)) $;

--| Compute the binomial coefficient of ` ( N + 1 ) ` over ` ( N - 1 ) ` (Contributed by Scott Fenton, 11-May-2014.) (Revised by Mario Carneiro, 22-May-2014.)
theorem bcp1m1 (N: class):
  $ wi (wcel N cn0) (wceq (co (co N c1 caddc) (co N c1 cmin) cbc) (co (co (co N c1 caddc) N cmul) c2 cdiv)) $;

--| Pascal's rule for the binomial coefficient, generalized to all integers ` K ` . Equation 2 of [Gleason] p. 295. (Contributed by NM, 13-Jul-2005.) (Revised by Mario Carneiro, 10-Mar-2014.)
theorem bcpasc (K N: class):
  $ wi (wa (wcel N cn0) (wcel K cz)) (wceq (co (co N K cbc) (co N (co K c1 cmin) cbc) caddc) (co (co N c1 caddc) K cbc)) $;

--| A binomial coefficient, in its extended domain, is a nonnegative integer. (Contributed by NM, 10-Jul-2005.) (Revised by Mario Carneiro, 9-Nov-2013.)
theorem bccl (K N: class):
  $ wi (wa (wcel N cn0) (wcel K cz)) (wcel (co N K cbc) cn0) $;

--| A binomial coefficient, in its standard domain, is a positive integer. (Contributed by NM, 3-Jan-2006.) (Revised by Mario Carneiro, 10-Mar-2014.)
theorem bccl2 (K N: class):
  $ wi (wcel K (co cc0 N cfz)) (wcel (co N K cbc) cn) $;

--| Compute the binomial coefficient " ` N ` choose 2 " from " ` ( N - 1 ) ` choose 2 ": (N-1) + ( (N-1) 2 ) = ( N 2 ). (Contributed by Alexander van der Vekens, 7-Jan-2018.)
theorem bcn2m1 (N: class):
  $ wi (wcel N cn) (wceq (co (co N c1 cmin) (co (co N c1 cmin) c2 cbc) caddc) (co N c2 cbc)) $;

--| Compute the binomial coefficient " ` ( N + 1 ) ` choose 2 " from " ` N ` choose 2 ": N + ( N 2 ) = ( (N+1) 2 ). (Contributed by Alexander van der Vekens, 8-Jan-2018.)
theorem bcn2p1 (N: class):
  $ wi (wcel N cn0) (wceq (co N (co N c2 cbc) caddc) (co (co N c1 caddc) c2 cbc)) $;

--| The number of permutations of ` N - R ` objects from a collection of ` N ` objects is a positive integer. (Contributed by Jason Orendorff, 24-Jan-2007.)
theorem permnn (R N: class):
  $ wi (wcel R (co cc0 N cfz)) (wcel (co (cfv N cfa) (cfv R cfa) cdiv) cn) $;

--| The binomial coefficient of ` ( N - 1 ) ` is ` N ` . (Contributed by Scott Fenton, 16-May-2014.)
theorem bcnm1 (N: class):
  $ wi (wcel N cn0) (wceq (co N (co N c1 cmin) cbc) N) $;

--| The value of four choose three. (Contributed by Scott Fenton, 11-Jun-2016.)
theorem _4bc3eq4:
  $ wceq (co c4 c3 cbc) c4 $;

--| The value of four choose two. (Contributed by Scott Fenton, 9-Jan-2017.)
theorem _4bc2eq6:
  $ wceq (co c4 c2 cbc) c6 $;

--| Extend the definition of a class to include the set size function.
term chash: class;

--| Define the set size function ` # ` , which gives the cardinality of a finite set as a member of ` NN0 ` , and assigns all infinite sets the value ` +oo ` . For example, ` ( # `` { 0 , 1 , 2 } ) = 3 ` ( ~ ex-hash ). (Contributed by Paul Chapman, 22-Jun-2011.)
axiom df_hash {x3: setvar}:
  $ wceq chash (cun (ccom (cres (crdg (cmpt x3 cvv (co (cv x3) c1 caddc)) cc0) com) ccrd) (cxp (cdif cvv cfn) (csn cpnf))) $;

--| The finite part of the size function maps all finite sets to their cardinality, as members of ` NN0 ` . (Contributed by Mario Carneiro, 13-Sep-2013.) (Revised by Mario Carneiro, 26-Dec-2014.)
theorem hashkf {x3: setvar} (G K: class x3):
  $ wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1 caddc)) cc0) com) $ >
  $ wceq K (ccom G ccrd) $ >
  $ wf cfn cn0 K $;

--| The value of the ` # ` function in terms of the mapping ` G ` from ` _om ` to ` NN0 ` . The proof avoids the use of ~ ax-ac . (Contributed by Paul Chapman, 22-Jun-2011.) (Revised by Mario Carneiro, 26-Dec-2014.)
theorem hashgval {x3: setvar} (A2: class) (G: class x3):
  $ wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1 caddc)) cc0) com) $ >
  $ wi (wcel A2 cfn) (wceq (cfv (cfv A2 ccrd) G) (cfv A2 chash)) $;

--| The converse of ` G ` maps the size function's value to ` card ` . (Contributed by Paul Chapman, 22-Jun-2011.) (Revised by Mario Carneiro, 15-Sep-2013.)
theorem hashginv {x3: setvar} (A2: class) (G: class x3):
  $ wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1 caddc)) cc0) com) $ >
  $ wi (wcel A2 cfn) (wceq (cfv (cfv A2 chash) (ccnv G)) (cfv A2 ccrd)) $;

--| The value of the ` # ` function on an infinite set. (Contributed by Mario Carneiro, 13-Jul-2014.)
theorem hashinf (A2 V: class):
  $ wi (wa (wcel A2 V) (wn (wcel A2 cfn))) (wceq (cfv A2 chash) cpnf) $;

--| If ` A ` has size bounded by an integer ` B ` , then ` A ` is finite. (Contributed by Mario Carneiro, 14-Jun-2015.)
theorem hashbnd (A2 B2 V: class):
  $ wi (w3a (wcel A2 V) (wcel B2 cn0) (wbr (cfv A2 chash) B2 cle)) (wcel A2 cfn) $;

--| The size function is a function into the extended nonnegative integers. (Contributed by Mario Carneiro, 13-Sep-2013.) (Revised by AV, 10-Dec-2020.)
theorem hashfxnn0:
  $ wf cvv cxnn0 chash $;

--| The size function maps all finite sets to their cardinality, as members of ` NN0 ` , and infinite sets to ` +oo ` . TODO-AV: mark as OBSOLETE and replace it by ~ hashfxnn0 ? (Contributed by Mario Carneiro, 13-Sep-2013.) (Revised by Mario Carneiro, 13-Jul-2014.) (Proof shortened by AV, 24-Oct-2021.)
theorem hashf:
  $ wf cvv (cun cn0 (csn cpnf)) chash $;

--| The value of the hash function for a set is an extended nonnegative integer. (Contributed by Alexander van der Vekens, 6-Dec-2017.) (Revised by AV, 10-Dec-2020.)
theorem hashxnn0 (M V: class):
  $ wi (wcel M V) (wcel (cfv M chash) cxnn0) $;

--| Restriction of the domain of the size function. (Contributed by Thierry Arnoux, 31-Jan-2017.)
theorem hashresfn (A2: class):
  $ wfn (cres chash A2) A2 $;

--| Restriction of the domain of the size function. (Contributed by Thierry Arnoux, 12-Jan-2017.)
theorem dmhashres (A2: class):
  $ wceq (cdm (cres chash A2)) A2 $;

--| The value of the hash function for a set is either a nonnegative integer or positive infinity. TODO-AV: mark as OBSOLETE and replace it by ~ hashxnn0 ? (Contributed by Alexander van der Vekens, 6-Dec-2017.)
theorem hashnn0pnf (M V: class):
  $ wi (wcel M V) (wo (wcel (cfv M chash) cn0) (wceq (cfv M chash) cpnf)) $;

--| If the size of a set is not a nonnegative integer, it is greater than or equal to any nonnegative integer. (Contributed by Alexander van der Vekens, 6-Dec-2017.)
theorem hashnnn0genn0 (M N V: class):
  $ wi (w3a (wcel M V) (wnel (cfv M chash) cn0) (wcel N cn0)) (wbr N (cfv M chash) cle) $;

--| The size of a set is never minus infinity. (Contributed by Alexander van der Vekens, 21-Dec-2017.)
theorem hashnemnf (A2 V: class):
  $ wi (wcel A2 V) (wne (cfv A2 chash) cmnf) $;

--| The size of a set is either 0 or 1 or greater than 1. (Contributed by Alexander van der Vekens, 29-Dec-2017.)
theorem hashv01gt1 (M V: class):
  $ wi (wcel M V) (w3o (wceq (cfv M chash) cc0) (wceq (cfv M chash) c1) (wbr c1 (cfv M chash) clt)) $;

--| The set ` ( 1 ... N ) ` has ` N ` elements. (Contributed by Paul Chapman, 22-Jun-2011.) (Revised by Mario Carneiro, 15-Sep-2013.)
theorem hashfz1 (N: class):
  $ wi (wcel N cn0) (wceq (cfv (co c1 N cfz) chash) N) $;

--| Two finite sets have the same number of elements iff they are equinumerous. (Contributed by Paul Chapman, 22-Jun-2011.) (Revised by Mario Carneiro, 15-Sep-2013.)
theorem hashen (A2 B2: class):
  $ wi (wa (wcel A2 cfn) (wcel B2 cfn)) (wb (wceq (cfv A2 chash) (cfv B2 chash)) (wbr A2 B2 cen)) $;

--| Equinumerous sets have the same number of elements (even if they are not finite). (Contributed by Mario Carneiro, 15-Apr-2015.)
theorem hasheni (A2 B2: class):
  $ wi (wbr A2 B2 cen) (wceq (cfv A2 chash) (cfv B2 chash)) $;

--| The size of two finite sets is equal if and only if there is a bijection mapping one of the sets onto the other. (Contributed by Alexander van der Vekens, 17-Dec-2017.)
theorem hasheqf1o {f2: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cfn) (wcel B2 cfn)) (wb (wceq (cfv A2 chash) (cfv B2 chash)) (wex f2 (wf1o A2 B2 (cv f2)))) $;

--| There is no bijection between a finite set and an infinite set. (Contributed by Alexander van der Vekens, 25-Dec-2017.)
theorem fiinfnf1o {f2: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cfn) (wn (wcel B2 cfn))) (wn (wex f2 (wf1o A2 B2 (cv f2)))) $;

--| The size of two sets is equal if there is a bijection mapping one of the sets onto the other. (Contributed by Alexander van der Vekens, 25-Dec-2017.) (Revised by AV, 4-May-2021.)
theorem hasheqf1oi {f2: setvar} (A2 B2 V: class):
  $ wi (wcel A2 V) (wi (wex f2 (wf1o A2 B2 (cv f2))) (wceq (cfv A2 chash) (cfv B2 chash))) $;

--| The size of a finite set which is a one-to-one function is equal to the size of the function's range. (Contributed by Alexander van der Vekens, 12-Jan-2018.) (Revised by AV, 4-May-2021.)
theorem hashf1rn (A2 B2 F V: class):
  $ wi (wa (wcel A2 V) (wf1 A2 B2 F)) (wceq (cfv F chash) (cfv (crn F) chash)) $;

--| The size of two sets is equal if there is a bijection mapping one of the sets onto the other. (Contributed by AV, 4-May-2021.)
theorem hasheqf1od (ph: wff) (A2 B2 U F: class):
  $ wi ph (wcel A2 U) $ >
  $ wi ph (wf1o A2 B2 F) $ >
  $ wi ph (wceq (cfv A2 chash) (cfv B2 chash)) $;

--| Two possibly-empty 1-based finite sets of sequential integers are equal iff their endpoints are equal. (Contributed by Paul Chapman, 22-Jun-2011.) (Proof shortened by Mario Carneiro, 29-Mar-2014.)
theorem fz1eqb (M N: class):
  $ wi (wa (wcel M cn0) (wcel N cn0)) (wb (wceq (co c1 M cfz) (co c1 N cfz)) (wceq M N)) $;

--| The size function of the cardinality function. (Contributed by Mario Carneiro, 19-Sep-2013.) (Revised by Mario Carneiro, 4-Nov-2013.)
theorem hashcard (A2: class):
  $ wi (wcel A2 cfn) (wceq (cfv (cfv A2 ccrd) chash) (cfv A2 chash)) $;

--| Closure of the ` # ` function. (Contributed by Paul Chapman, 26-Oct-2012.) (Revised by Mario Carneiro, 13-Jul-2014.)
theorem hashcl (A2: class):
  $ wi (wcel A2 cfn) (wcel (cfv A2 chash) cn0) $;

--| Extended real closure of the ` # ` function. (Contributed by Mario Carneiro, 22-Apr-2015.)
theorem hashxrcl (A2 V: class):
  $ wi (wcel A2 V) (wcel (cfv A2 chash) cxr) $;

--| Reverse closure of the ` # ` function. (Contributed by Mario Carneiro, 15-Jan-2015.)
theorem hashclb (A2 V: class):
  $ wi (wcel A2 V) (wb (wcel A2 cfn) (wcel (cfv A2 chash) cn0)) $;

--| The size of any infinite set is always greater than or equal to the size of any set. (Contributed by AV, 13-Nov-2020.)
theorem nfile (A2 B2 V W: class):
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wn (wcel B2 cfn))) (wbr (cfv A2 chash) (cfv B2 chash) cle) $;

--| A set of finite size is a finite set. (Contributed by Alexander van der Vekens, 8-Dec-2017.)
theorem hashvnfin (S N V: class):
  $ wi (wa (wcel S V) (wcel N cn0)) (wi (wceq (cfv S chash) N) (wcel S cfn)) $;

--| The size of an infinite set is not a nonnegative integer. (Contributed by Alexander van der Vekens, 21-Dec-2017.) (Proof shortened by Alexander van der Vekens, 18-Jan-2018.)
theorem hashnfinnn0 (A2 V: class):
  $ wi (wa (wcel A2 V) (wn (wcel A2 cfn))) (wnel (cfv A2 chash) cn0) $;

--| A finite set is equinumerous to the range of integers from one up to the hash value of the set. In other words, counting objects with natural numbers works if and only if it is a finite collection. (Contributed by Richard Penner, 26-Feb-2020.)
theorem isfinite4 (A2: class):
  $ wb (wcel A2 cfn) (wbr (co c1 (cfv A2 chash) cfz) A2 cen) $;

--| Two ways of saying a set is empty. (Contributed by Paul Chapman, 26-Oct-2012.) (Revised by Mario Carneiro, 27-Jul-2014.)
theorem hasheq0 (A2 V: class):
  $ wi (wcel A2 V) (wb (wceq (cfv A2 chash) cc0) (wceq A2 c0)) $;

--| Two ways of saying a set is not empty. (Contributed by Alexander van der Vekens, 23-Sep-2018.)
theorem hashneq0 (A2 V: class):
  $ wi (wcel A2 V) (wb (wbr cc0 (cfv A2 chash) clt) (wne A2 c0)) $;

--| If the size of a set is greater than 0, the set is not empty. (Contributed by AV, 5-Aug-2018.) (Proof shortened by AV, 18-Nov-2018.)
theorem hashgt0n0 (A2 V: class):
  $ wi (wa (wcel A2 V) (wbr cc0 (cfv A2 chash) clt)) (wne A2 c0) $;

--| Positive natural closure of the hash function. (Contributed by Mario Carneiro, 16-Jan-2015.)
theorem hashnncl (A2: class):
  $ wi (wcel A2 cfn) (wb (wcel (cfv A2 chash) cn) (wne A2 c0)) $;

--| The empty set has size zero. (Contributed by Mario Carneiro, 8-Jul-2014.)
theorem hash0:
  $ wceq (cfv c0 chash) cc0 $;

--| A set with an element has nonzero size. (Contributed by Rohan Ridenour, 3-Aug-2023.)
theorem hashelne0d (ph: wff) (A2 B2 V: class):
  $ wi ph (wcel B2 A2) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wn (wceq (cfv A2 chash) cc0)) $;

--| The size of a singleton. (Contributed by Paul Chapman, 26-Oct-2012.) (Proof shortened by Mario Carneiro, 13-Feb-2013.)
theorem hashsng (A2 V: class):
  $ wi (wcel A2 V) (wceq (cfv (csn A2) chash) c1) $;

--| A set has size 1 if and only if it is equinumerous to the ordinal 1. (Contributed by AV, 14-Apr-2019.)
theorem hashen1 (A2 V: class):
  $ wi (wcel A2 V) (wb (wceq (cfv A2 chash) c1) (wbr A2 c1o cen)) $;

--| A set of size 1 with a known element is the singleton of that element. (Contributed by Rohan Ridenour, 3-Aug-2023.)
theorem hash1elsn (ph: wff) (A2 B2 V: class):
  $ wi ph (wceq (cfv A2 chash) c1) $ >
  $ wi ph (wcel B2 A2) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wceq A2 (csn B2)) $;

--| The size of a restricted class abstraction restricted to a singleton is a nonnegative integer. (Contributed by Alexander van der Vekens, 22-Dec-2017.)
theorem hashrabrsn {x3: setvar} (ph: wff x3) (A2: class):
  $ wcel (cfv (crab x3 ph (csn A2)) chash) cn0 $;

--| The size of a restricted class abstraction restricted to a singleton is either 0 or 1. (Contributed by Alexander van der Vekens, 3-Sep-2018.)
theorem hashrabsn01 {x3: setvar} (ph: wff x3) (A2: class) (N: class x3):
  $ wi (wceq (cfv (crab x3 ph (csn A2)) chash) N) (wo (wceq N cc0) (wceq N c1)) $;

--| If the size of a restricted class abstraction restricted to a singleton is 1, the condition of the class abstraction must hold for the singleton. (Contributed by Alexander van der Vekens, 3-Sep-2018.)
theorem hashrabsn1 {x3: setvar} (ph: wff x3) (A2: class):
  $ wi (wceq (cfv (crab x3 ph (csn A2)) chash) c1) (wsbc x3 ph A2) $;

--| A function is equinumerous to its domain. (Contributed by Mario Carneiro, 12-Mar-2015.)
theorem hashfn (A2 F: class):
  $ wi (wfn F A2) (wceq (cfv F chash) (cfv A2 chash)) $;

--| The value of the size function on a finite 1-based sequence. (Contributed by Paul Chapman, 26-Oct-2012.) (Proof shortened by Mario Carneiro, 12-Mar-2015.)
theorem fseq1hash (F N: class):
  $ wi (wa (wcel N cn0) (wfn F (co c1 N cfz))) (wceq (cfv F chash) N) $;

--| ` G ` maps ordinal addition to integer addition. (Contributed by Paul Chapman, 30-Nov-2012.) (Revised by Mario Carneiro, 15-Sep-2013.)
theorem hashgadd {x3: setvar} (A2 B2 G: class x3):
  $ wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1 caddc)) cc0) com) $ >
  $ wi (wa (wcel A2 com) (wcel B2 com)) (wceq (cfv (co A2 B2 coa) G) (co (cfv A2 G) (cfv B2 G) caddc)) $;

--| A short expression for the ` G ` function of ~ hashgf1o . (Contributed by Mario Carneiro, 24-Jan-2015.)
theorem hashgval2 {x3: setvar}:
  $ wceq (cres chash com) (cres (crdg (cmpt x3 cvv (co (cv x3) c1 caddc)) cc0) com) $;

--| Dominance relation for the size function. (Contributed by Mario Carneiro, 22-Sep-2013.) (Revised by Mario Carneiro, 22-Apr-2015.)
theorem hashdom (A2 B2 V: class):
  $ wi (wa (wcel A2 cfn) (wcel B2 V)) (wb (wbr (cfv A2 chash) (cfv B2 chash) cle) (wbr A2 B2 cdom)) $;

--| Non-strict order relation of the ` # ` function on the full cardinal poset. (Contributed by Stefan O'Rear, 12-Sep-2015.)
theorem hashdomi (A2 B2: class):
  $ wi (wbr A2 B2 cdom) (wbr (cfv A2 chash) (cfv B2 chash) cle) $;

--| Strict dominance relation for the size function. (Contributed by Mario Carneiro, 18-Aug-2014.)
theorem hashsdom (A2 B2: class):
  $ wi (wa (wcel A2 cfn) (wcel B2 cfn)) (wb (wbr (cfv A2 chash) (cfv B2 chash) clt) (wbr A2 B2 csdm)) $;

--| The size of the union of disjoint finite sets is the sum of their sizes. (Contributed by Paul Chapman, 30-Nov-2012.) (Revised by Mario Carneiro, 15-Sep-2013.)
theorem hashun (A2 B2: class):
  $ wi (w3a (wcel A2 cfn) (wcel B2 cfn) (wceq (cin A2 B2) c0)) (wceq (cfv (cun A2 B2) chash) (co (cfv A2 chash) (cfv B2 chash) caddc)) $;

--| The size of the union of finite sets is less than or equal to the sum of their sizes. (Contributed by Mario Carneiro, 23-Sep-2013.) (Proof shortened by Mario Carneiro, 27-Jul-2014.)
theorem hashun2 (A2 B2: class):
  $ wi (wa (wcel A2 cfn) (wcel B2 cfn)) (wbr (cfv (cun A2 B2) chash) (co (cfv A2 chash) (cfv B2 chash) caddc) cle) $;

--| The size of the union of finite sets is the sum of their sizes minus the size of the intersection. (Contributed by Mario Carneiro, 6-Aug-2017.)
theorem hashun3 (A2 B2: class):
  $ wi (wa (wcel A2 cfn) (wcel B2 cfn)) (wceq (cfv (cun A2 B2) chash) (co (co (cfv A2 chash) (cfv B2 chash) caddc) (cfv (cin A2 B2) chash) cmin)) $;

--| The extended real addition of the size of an infinite set with the size of an arbitrary set yields plus infinity. (Contributed by Alexander van der Vekens, 20-Dec-2017.)
theorem hashinfxadd (A2 B2 V W: class):
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wnel (cfv A2 chash) cn0)) (wceq (co (cfv A2 chash) (cfv B2 chash) cxad) cpnf) $;

--| The size of the union of disjoint sets is the result of the extended real addition of their sizes, analogous to ~ hashun . (Contributed by Alexander van der Vekens, 21-Dec-2017.)
theorem hashunx (A2 B2 V W: class):
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wceq (cin A2 B2) c0)) (wceq (cfv (cun A2 B2) chash) (co (cfv A2 chash) (cfv B2 chash) cxad)) $;

--| The cardinality of a set is greater than or equal to zero. (Contributed by Thierry Arnoux, 2-Mar-2017.)
theorem hashge0 (A2 V: class):
  $ wi (wcel A2 V) (wbr cc0 (cfv A2 chash) cle) $;

--| The cardinality of a nonempty set is greater than zero. (Contributed by Thierry Arnoux, 2-Mar-2017.)
theorem hashgt0 (A2 V: class):
  $ wi (wa (wcel A2 V) (wne A2 c0)) (wbr cc0 (cfv A2 chash) clt) $;

--| The cardinality of a nonempty set is greater than or equal to one. (Contributed by Thierry Arnoux, 20-Jun-2017.)
theorem hashge1 (A2 V: class):
  $ wi (wa (wcel A2 V) (wne A2 c0)) (wbr c1 (cfv A2 chash) cle) $;

--| 1 is an element of the finite set of sequential nonnegative integers bounded by the size of a nonempty finite set. (Contributed by AV, 9-May-2020.)
theorem _1elfz0hash (A2: class):
  $ wi (wa (wcel A2 cfn) (wne A2 c0)) (wcel c1 (co cc0 (cfv A2 chash) cfz)) $;

--| If a nonnegative integer is the size of a set which contains at least one element, this integer is a positive integer. (Contributed by Alexander van der Vekens, 9-Jan-2018.)
theorem hashnn0n0nn (N V W Y: class):
  $ wi (wa (wa (wcel V W) (wcel Y cn0)) (wa (wceq (cfv V chash) Y) (wcel N V))) (wcel Y cn) $;

--| The size of the union of a finite set with a disjoint singleton is one more than the size of the set. (Contributed by Paul Chapman, 30-Nov-2012.)
theorem hashunsng (A2 B2 V: class):
  $ wi (wcel B2 V) (wi (wa (wcel A2 cfn) (wn (wcel B2 A2))) (wceq (cfv (cun A2 (csn B2)) chash) (co (cfv A2 chash) c1 caddc))) $;

--| The size of the union of a set with a disjoint singleton is the extended real addition of the size of the set and 1, analogous to ~ hashunsng . (Contributed by BTernaryTau, 9-Sep-2023.)
theorem hashunsngx (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wi (wn (wcel B2 A2)) (wceq (cfv (cun A2 (csn B2)) chash) (co (cfv A2 chash) c1 cxad))) $;

--| The size of a set is greater than a nonnegative integer N if and only if the size of the union of that set with a disjoint singleton is greater than N + 1. (Contributed by BTernaryTau, 10-Sep-2023.)
theorem hashunsnggt (A2 B2 N V W: class):
  $ wi (wa (w3a (wcel A2 V) (wcel B2 W) (wcel N cn0)) (wn (wcel B2 A2))) (wb (wbr N (cfv A2 chash) clt) (wbr (co N c1 caddc) (cfv (cun A2 (csn B2)) chash) clt)) $;

--| The size of an unordered pair. (Contributed by Mario Carneiro, 27-Sep-2013.) (Revised by Mario Carneiro, 5-May-2016.) (Revised by AV, 18-Sep-2021.)
theorem hashprg (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wne A2 B2) (wceq (cfv (cpr A2 B2) chash) c2)) $;

--| If one element of an unordered pair is not a set, the size of the unordered pair is not 2. (Contributed by Alexander van der Vekens, 7-Oct-2017.)
theorem elprchashprn2 (M N: class):
  $ wi (wn (wcel M cvv)) (wn (wceq (cfv (cpr M N) chash) c2)) $;

--| The size of an unordered pair is 2 if and only if its elements are different sets. (Contributed by Alexander van der Vekens, 17-Jan-2018.)
theorem hashprb (M N: class):
  $ wb (w3a (wcel M cvv) (wcel N cvv) (wne M N)) (wceq (cfv (cpr M N) chash) c2) $;

--| The elements of an unordered pair of size 2 are different sets. (Contributed by AV, 27-Jan-2020.)
theorem hashprdifel (A2 B2 S: class):
  $ wceq S (cpr A2 B2) $ >
  $ wi (wceq (cfv S chash) c2) (w3a (wcel A2 S) (wcel B2 S) (wne A2 B2)) $;

--| There is (at least) one set with two different elements: the unordered pair containing ` 0 ` and ` 1 ` . In contrast to ~ pr0hash2ex , numbers are used instead of sets because their representation is shorter (and more comprehensive). (Contributed by AV, 29-Jan-2020.)
theorem prhash2ex:
  $ wceq (cfv (cpr cc0 c1) chash) c2 $;

--| If the size of a set is less than or equal to zero, the set must be empty. (Contributed by Alexander van der Vekens, 6-Jan-2018.) (Proof shortened by AV, 24-Oct-2021.)
theorem hashle00 (V W: class):
  $ wi (wcel V W) (wb (wbr (cfv V chash) cc0 cle) (wceq V c0)) $;

--| If the size of a set is greater than zero, then the set must contain at least one element. (Contributed by Alexander van der Vekens, 6-Jan-2018.)
theorem hashgt0elex {x3: setvar} (V: class) (W: class x3):
  $ wi (wa (wcel V W) (wbr cc0 (cfv V chash) clt)) (wex x3 (wcel (cv x3) V)) $;

--| The size of a set is greater than zero if and only if the set contains at least one element. (Contributed by Alexander van der Vekens, 18-Jan-2018.)
theorem hashgt0elexb {x3: setvar} (V: class) (W: class x3):
  $ wi (wcel V W) (wb (wbr cc0 (cfv V chash) clt) (wex x3 (wcel (cv x3) V))) $;

--| Size of a finite ordinal. (Contributed by Mario Carneiro, 5-Jan-2016.)
theorem hashp1i (A2 B2 M N: class):
  $ wcel A2 com $ >
  $ wceq B2 (csuc A2) $ >
  $ wceq (cfv A2 chash) M $ >
  $ wceq (co M c1 caddc) N $ >
  $ wceq (cfv B2 chash) N $;

--| Size of a finite ordinal. (Contributed by Mario Carneiro, 5-Jan-2016.)
theorem hash1:
  $ wceq (cfv c1o chash) c1 $;

--| Size of a finite ordinal. (Contributed by Mario Carneiro, 5-Jan-2016.)
theorem hash2:
  $ wceq (cfv c2o chash) c2 $;

--| Size of a finite ordinal. (Contributed by Mario Carneiro, 5-Jan-2016.)
theorem hash3:
  $ wceq (cfv c3o chash) c3 $;

--| Size of a finite ordinal. (Contributed by Mario Carneiro, 5-Jan-2016.)
theorem hash4:
  $ wceq (cfv c4o chash) c4 $;

--| There is (at least) one set with two different elements: the unordered pair containing the empty set and the singleton containing the empty set. (Contributed by AV, 29-Jan-2020.)
theorem pr0hash2ex:
  $ wceq (cfv (cpr c0 (csn c0)) chash) c2 $;

--| The size of a subset is less than or equal to the size of its superset. (Contributed by Alexander van der Vekens, 14-Jul-2018.)
theorem hashss (A2 B2 V: class):
  $ wi (wa (wcel A2 V) (wss B2 A2)) (wbr (cfv B2 chash) (cfv A2 chash) cle) $;

--| The size of a proper subset is less than the size of its finite superset. (Contributed by Thierry Arnoux, 13-Oct-2025.)
theorem hashpss (A2 B2: class):
  $ wi (wa (wcel A2 cfn) (wpss B2 A2)) (wbr (cfv B2 chash) (cfv A2 chash) clt) $;

--| The size of a superset of a proper unordered pair is greater than 1. (Contributed by AV, 6-Feb-2021.)
theorem prsshashgt1 (A2 B2 C U V W: class):
  $ wi (wa (w3a (wcel A2 V) (wcel B2 W) (wne A2 B2)) (wcel C U)) (wi (wss (cpr A2 B2) C) (wbr c2 (cfv C chash) cle)) $;

--| The size of the intersection of a set and a class is less than or equal to the size of the set. (Contributed by AV, 4-Jan-2021.)
theorem hashin (A2 B2 V: class):
  $ wi (wcel A2 V) (wbr (cfv (cin A2 B2) chash) (cfv A2 chash) cle) $;

--| The size of the difference of a finite set and a subset is the set's size minus the subset's. (Contributed by Steve Rodriguez, 24-Oct-2015.)
theorem hashssdif (A2 B2: class):
  $ wi (wa (wcel A2 cfn) (wss B2 A2)) (wceq (cfv (cdif A2 B2) chash) (co (cfv A2 chash) (cfv B2 chash) cmin)) $;

--| The size of the difference of a finite set and another set is the first set's size minus that of the intersection of both. (Contributed by Steve Rodriguez, 24-Oct-2015.)
theorem hashdif (A2 B2: class):
  $ wi (wcel A2 cfn) (wceq (cfv (cdif A2 B2) chash) (co (cfv A2 chash) (cfv (cin A2 B2) chash) cmin)) $;

--| The size of the difference of a finite set and a singleton subset is the set's size minus 1. (Contributed by Alexander van der Vekens, 6-Jan-2018.)
theorem hashdifsn (A2 B2: class):
  $ wi (wa (wcel A2 cfn) (wcel B2 A2)) (wceq (cfv (cdif A2 (csn B2)) chash) (co (cfv A2 chash) c1 cmin)) $;

--| The size of the difference of a finite set and a proper pair of its elements is the set's size minus 2. (Contributed by AV, 16-Dec-2020.)
theorem hashdifpr (A2 B2 C: class):
  $ wi (wa (wcel A2 cfn) (w3a (wcel B2 A2) (wcel C A2) (wne B2 C))) (wceq (cfv (cdif A2 (cpr B2 C)) chash) (co (cfv A2 chash) c2 cmin)) $;

--| The size of a singleton is either 0 or 1. (Contributed by AV, 23-Feb-2021.)
theorem hashsn01 (A2: class):
  $ wo (wceq (cfv (csn A2) chash) cc0) (wceq (cfv (csn A2) chash) c1) $;

--| The size of a singleton is less than or equal to 1. (Contributed by AV, 23-Feb-2021.)
theorem hashsnle1 (A2: class):
  $ wbr (cfv (csn A2) chash) c1 cle $;

--| Get an upper bound on a concretely specified finite set. Base case: singleton set. (Contributed by Mario Carneiro, 11-Feb-2015.) (Proof shortened by AV, 23-Feb-2021.)
theorem hashsnlei (A2: class):
  $ wa (wcel (csn A2) cfn) (wbr (cfv (csn A2) chash) c1 cle) $;

--| The size of a set is 1 if and only if it is a singleton (containing a set). (Contributed by Alexander van der Vekens, 7-Dec-2017.)
theorem hash1snb {a: setvar} (V: class) (W: class a):
  $ wi (wcel V W) (wb (wceq (cfv V chash) c1) (wex a (wceq V (csn (cv a))))) $;

--| The size of a set is 1 in terms of existential uniqueness. (Contributed by Alexander van der Vekens, 8-Feb-2018.)
theorem euhash1 {a: setvar} (V: class) (W: class a):
  $ wi (wcel V W) (wb (wceq (cfv V chash) c1) (weu a (wcel (cv a) V))) $;

--| If the size of a set is 1 the set is not empty. (Contributed by AV, 23-Dec-2020.)
theorem hash1n0 (A2 V: class):
  $ wi (wa (wcel A2 V) (wceq (cfv A2 chash) c1)) (wne A2 c0) $;

--| In a set with more than one element are two different elements. (Contributed by Alexander van der Vekens, 15-Nov-2017.)
theorem hashgt12el {a b: setvar} (V: class) (W: class b):
  $ wi (wa (wcel V W) (wbr c1 (cfv V chash) clt)) (wrex a (wrex b (wne (cv a) (cv b)) V) V) $;

--| In a set with more than one element are two different elements. (Contributed by Alexander van der Vekens, 15-Nov-2017.)
theorem hashgt12el2 {b: setvar} (A2 V: class) (W: class b):
  $ wi (w3a (wcel V W) (wbr c1 (cfv V chash) clt) (wcel A2 V)) (wrex b (wne A2 (cv b)) V) $;

--| A set with more than two elements has at least three different elements. (Contributed by BTernaryTau, 21-Sep-2023.)
theorem hashgt23el {a b c: setvar} (V: class) (W: class b c):
  $ wi (wa (wcel V W) (wbr c2 (cfv V chash) clt)) (wrex a (wrex b (wrex c (w3a (wne (cv a) (cv b)) (wne (cv a) (cv c)) (wne (cv b) (cv c))) V) V) V) $;

--| Get an upper bound on a concretely specified finite set. Induction step: union of two finite bounded sets. (Contributed by Mario Carneiro, 11-Feb-2015.)
theorem hashunlei (A2 B2 C K M N: class):
  $ wceq C (cun A2 B2) $ >
  $ wa (wcel A2 cfn) (wbr (cfv A2 chash) K cle) $ >
  $ wa (wcel B2 cfn) (wbr (cfv B2 chash) M cle) $ >
  $ wcel K cn0 $ >
  $ wcel M cn0 $ >
  $ wceq (co K M caddc) N $ >
  $ wa (wcel C cfn) (wbr (cfv C chash) N cle) $;

--| Get an upper bound on a concretely specified finite set. Transfer boundedness to a subset. (Contributed by Mario Carneiro, 11-Feb-2015.)
theorem hashsslei (A2 B2 N: class):
  $ wss B2 A2 $ >
  $ wa (wcel A2 cfn) (wbr (cfv A2 chash) N cle) $ >
  $ wcel N cn0 $ >
  $ wa (wcel B2 cfn) (wbr (cfv B2 chash) N cle) $;

--| Value of the numeric cardinality of a nonempty integer range. (Contributed by Stefan O'Rear, 12-Sep-2014.) (Proof shortened by Mario Carneiro, 15-Apr-2015.)
theorem hashfz (A2 B2: class):
  $ wi (wcel B2 (cfv A2 cuz)) (wceq (cfv (co A2 B2 cfz) chash) (co (co B2 A2 cmin) c1 caddc)) $;

--| Condition for finite ranges to have a strict dominance relation. (Contributed by Stefan O'Rear, 12-Sep-2014.) (Revised by Mario Carneiro, 15-Apr-2015.)
theorem fzsdom2 (A2 B2 C: class):
  $ wi (wa (wa (wcel B2 (cfv A2 cuz)) (wcel C cz)) (wbr B2 C clt)) (wbr (co A2 B2 cfz) (co A2 C cfz) csdm) $;

--| Cardinality of a half-open set of integers. (Contributed by Stefan O'Rear, 15-Aug-2015.)
theorem hashfzo (A2 B2: class):
  $ wi (wcel B2 (cfv A2 cuz)) (wceq (cfv (co A2 B2 cfzo) chash) (co B2 A2 cmin)) $;

--| Cardinality of a half-open set of integers based at zero. (Contributed by Stefan O'Rear, 15-Aug-2015.)
theorem hashfzo0 (B2: class):
  $ wi (wcel B2 cn0) (wceq (cfv (co cc0 B2 cfzo) chash) B2) $;

--| Value of the numeric cardinality of a (possibly empty) integer range. (Contributed by AV, 19-Jun-2021.)
theorem hashfzp1 (A2 B2: class):
  $ wi (wcel B2 (cfv A2 cuz)) (wceq (cfv (co (co A2 c1 caddc) B2 cfz) chash) (co B2 A2 cmin)) $;

--| Value of the numeric cardinality of a nonempty range of nonnegative integers. (Contributed by Alexander van der Vekens, 21-Jul-2018.)
theorem hashfz0 (B2: class):
  $ wi (wcel B2 cn0) (wceq (cfv (co cc0 B2 cfz) chash) (co B2 c1 caddc)) $;

--| Lemma for ~ hashxp . (Contributed by Paul Chapman, 30-Nov-2012.)
theorem hashxplem (A2 B2: class):
  $ wcel B2 cfn $ >
  $ wi (wcel A2 cfn) (wceq (cfv (cxp A2 B2) chash) (co (cfv A2 chash) (cfv B2 chash) cmul)) $;

--| The size of the Cartesian product of two finite sets is the product of their sizes. (Contributed by Paul Chapman, 30-Nov-2012.)
theorem hashxp (A2 B2: class):
  $ wi (wa (wcel A2 cfn) (wcel B2 cfn)) (wceq (cfv (cxp A2 B2) chash) (co (cfv A2 chash) (cfv B2 chash) cmul)) $;

--| The size of the set exponential of two finite sets is the exponential of their sizes. (This is the original motivation behind the notation for set exponentiation.) (Contributed by Mario Carneiro, 5-Aug-2014.) (Proof shortened by AV, 18-Jul-2022.)
theorem hashmap (A2 B2: class):
  $ wi (wa (wcel A2 cfn) (wcel B2 cfn)) (wceq (cfv (co A2 B2 cmap) chash) (co (cfv A2 chash) (cfv B2 chash) cexp)) $;

--| The size of the power set of a finite set is 2 raised to the power of the size of the set. (Contributed by Paul Chapman, 30-Nov-2012.) (Proof shortened by Mario Carneiro, 5-Aug-2014.)
theorem hashpw (A2: class):
  $ wi (wcel A2 cfn) (wceq (cfv (cpw A2) chash) (co c2 (cfv A2 chash) cexp)) $;

--| A finite set is a function iff it is equinumerous to its domain. (Contributed by Mario Carneiro, 26-Sep-2013.) (Revised by Mario Carneiro, 12-Mar-2015.)
theorem hashfun (F: class):
  $ wi (wcel F cfn) (wb (wfun F) (wceq (cfv F chash) (cfv (cdm F) chash))) $;

--| The number of elements of a finite function restricted to a subset of its domain is equal to the number of elements of that subset. (Contributed by AV, 15-Dec-2021.)
theorem hashres (A2 B2: class):
  $ wi (w3a (wfun A2) (wcel A2 cfn) (wss B2 (cdm A2))) (wceq (cfv (cres A2 B2) chash) (cfv B2 chash)) $;

--| The number of elements of a finite function expressed by a restriction. (Contributed by AV, 15-Dec-2021.)
theorem hashreshashfun (A2 B2: class):
  $ wi (w3a (wfun A2) (wcel A2 cfn) (wss B2 (cdm A2))) (wceq (cfv A2 chash) (co (cfv (cres A2 B2) chash) (cfv (cdif (cdm A2) B2) chash) caddc)) $;

--| The size of the image of a one-to-one function ` E ` under the range of a function ` F ` which is a one-to-one function into the domain of ` E ` equals the size of the function ` F ` . (Contributed by Alexander van der Vekens, 4-Feb-2018.) (Proof shortened by AV, 4-May-2021.)
theorem hashimarn (E F V: class):
  $ wi (wa (wf1 (cdm E) (crn E) E) (wcel E V)) (wi (wf1 (co cc0 (cfv F chash) cfzo) (cdm E) F) (wceq (cfv (cima E (crn F)) chash) (cfv F chash))) $;

--| If the size of the image of a one-to-one function ` E ` under the range of a function ` F ` which is a one-to-one function into the domain of ` E ` is a nonnegative integer, the size of the function ` F ` is the same nonnegative integer. (Contributed by Alexander van der Vekens, 4-Feb-2018.)
theorem hashimarni (P E F N V: class):
  $ wi (wa (wf1 (cdm E) (crn E) E) (wcel E V)) (wi (w3a (wf1 (co cc0 (cfv F chash) cfzo) (cdm E) F) (wceq P (cima E (crn F))) (wceq (cfv P chash) N)) (wceq (cfv F chash) N)) $;

--| The size of a set function is equal to the size of its domain. (Contributed by BTernaryTau, 30-Sep-2023.)
theorem hashfundm (F V: class):
  $ wi (wa (wcel F V) (wfun F)) (wceq (cfv F chash) (cfv (cdm F) chash)) $;

--| The size of the domain of a one-to-one set function is equal to the size of its range. (Contributed by BTernaryTau, 1-Oct-2023.)
theorem hashf1dmrn (A2 B2 F V: class):
  $ wi (wa (wcel F V) (wf1 A2 B2 F)) (wceq (cfv A2 chash) (cfv (crn F) chash)) $;

--| The size of the domain of a one-to-one set function is less than or equal to the size of its codomain, if it exists. (Contributed by BTernaryTau, 1-Oct-2023.)
theorem hashf1dmcdm (A2 B2 F V W: class):
  $ wi (w3a (wcel F V) (wcel B2 W) (wf1 A2 B2 F)) (wbr (cfv A2 chash) (cfv B2 chash) cle) $;

--| TODO-AV: Revise using ` F e. Word dom I ` ? Formerly part of proof of ~ eupth2lem3 : The union of a restriction by an image over an open range of nonnegative integers and a singleton of an ordered pair is a restriction by an image over an interval of nonnegative integers. (Contributed by Mario Carneiro, 8-Apr-2015.) (Revised by AV, 20-Feb-2021.)
theorem resunimafz0 (ph: wff) (F I N: class):
  $ wi ph (wfun I) $ >
  $ wi ph (wf (co cc0 (cfv F chash) cfzo) (cdm I) F) $ >
  $ wi ph (wcel N (co cc0 (cfv F chash) cfzo)) $ >
  $ wi ph (wceq (cres I (cima F (co cc0 N cfz))) (cun (cres I (cima F (co cc0 N cfzo))) (csn (cop (cfv N F) (cfv (cfv N F) I))))) $;

--| The size of a function on a finite set of sequential nonnegative integers. (Contributed by Alexander van der Vekens, 25-Jun-2018.)
theorem fnfz0hash (F N: class):
  $ wi (wa (wcel N cn0) (wfn F (co cc0 N cfz))) (wceq (cfv F chash) (co N c1 caddc)) $;

--| The size of a function on a finite set of sequential nonnegative integers equals the upper bound of the sequence increased by 1. (Contributed by Alexander van der Vekens, 15-Mar-2018.) (Proof shortened by AV, 11-Apr-2021.)
theorem ffz0hash (B2 F N: class):
  $ wi (wa (wcel N cn0) (wf (co cc0 N cfz) B2 F)) (wceq (cfv F chash) (co N c1 caddc)) $;

--| The size of a function on a finite set of sequential nonnegative integers is a nonnegative integer. (Contributed by AV, 10-Apr-2021.)
theorem fnfz0hashnn0 (F N: class):
  $ wi (wfn F (co cc0 N cfz)) (wcel (cfv F chash) cn0) $;

--| The size of a function on a half-open range of nonnegative integers. (Contributed by Alexander van der Vekens, 25-Mar-2018.)
theorem ffzo0hash (F N: class):
  $ wi (wa (wcel N cn0) (wfn F (co cc0 N cfzo))) (wceq (cfv F chash) N) $;

--| The size of a function on a half-open range of nonnegative integers equals the upper bound of this range. (Contributed by Alexander van der Vekens, 26-Jan-2018.) (Proof shortened by AV, 11-Apr-2021.)
theorem fnfzo0hash (B2 F N: class):
  $ wi (wa (wcel N cn0) (wf (co cc0 N cfzo) B2 F)) (wceq (cfv F chash) N) $;

--| The value of the size function on a half-open range of nonnegative integers is a nonnegative integer. (Contributed by AV, 10-Apr-2021.)
theorem fnfzo0hashnn0 (F N: class):
  $ wi (wfn F (co cc0 N cfzo)) (wcel (cfv F chash) cn0) $;

--| Lemma for ~ hashbc : inductive step. (Contributed by Mario Carneiro, 13-Jul-2014.)
theorem hashbclem {x3 z j: setvar} (ph: wff z j) (A2: class) (K: class z):
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wn (wcel (cv z) A2)) $ >
  $ wi ph (wral j (wceq (co (cfv A2 chash) (cv j) cbc) (cfv (crab x3 (wceq (cfv (cv x3) chash) (cv j)) (cpw A2)) chash)) cz) $ >
  $ wi ph (wcel K cz) $ >
  $ wi ph (wceq (co (cfv (cun A2 (csn (cv z))) chash) K cbc) (cfv (crab x3 (wceq (cfv (cv x3) chash) K) (cpw (cun A2 (csn (cv z))))) chash)) $;

--| The binomial coefficient counts the number of subsets of a finite set of a given size. This is Metamath 100 proof #58 (formula for the number of combinations). (Contributed by Mario Carneiro, 13-Jul-2014.)
theorem hashbc {x3: setvar} (A2 K: class):
  $ wi (wa (wcel A2 cfn) (wcel K cz)) (wceq (co (cfv A2 chash) K cbc) (cfv (crab x3 (wceq (cfv (cv x3) chash) K) (cpw A2)) chash)) $;

--| The number of bijections between two sets is a cardinal invariant. (Contributed by Mario Carneiro, 21-Jan-2015.) (Proof shortened by AV, 7-Aug-2024.)
theorem hashfacen {f2: setvar} (A2 B2 C D: class):
  $ wi (wa (wbr A2 B2 cen) (wbr C D cen)) (wbr (cab f2 (wf1o A2 C (cv f2))) (cab f2 (wf1o B2 D (cv f2))) cen) $;

--| Lemma for ~ hashf1 . (Contributed by Mario Carneiro, 17-Apr-2015.) (Proof shortened by AV, 14-Aug-2024.)
theorem hashf1lem1 {z f2: setvar} (ph: wff z) (A2 B2 F: class z):
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wn (wcel (cv z) A2)) $ >
  $ wi ph (wbr (co (cfv A2 chash) c1 caddc) (cfv B2 chash) cle) $ >
  $ wi ph (wf1 A2 B2 F) $ >
  $ wi ph (wbr (cab f2 (wa (wceq (cres (cv f2) A2) F) (wf1 (cun A2 (csn (cv z))) B2 (cv f2)))) (cdif B2 (crn F)) cen) $;

--| Lemma for ~ hashf1 . (Contributed by Mario Carneiro, 17-Apr-2015.)
theorem hashf1lem2 {z f2: setvar} (ph: wff z) (A2 B2: class z):
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wn (wcel (cv z) A2)) $ >
  $ wi ph (wbr (co (cfv A2 chash) c1 caddc) (cfv B2 chash) cle) $ >
  $ wi ph (wceq (cfv (cab f2 (wf1 (cun A2 (csn (cv z))) B2 (cv f2))) chash) (co (co (cfv B2 chash) (cfv A2 chash) cmin) (cfv (cab f2 (wf1 A2 B2 (cv f2))) chash) cmul)) $;

--| The permutation number ` | A | ! x. ( | B | _C | A | ) = ` ` | B | ! / ( | B | - | A | ) ! ` counts the number of injections from ` A ` to ` B ` . (Contributed by Mario Carneiro, 21-Jan-2015.)
theorem hashf1 {f2: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cfn) (wcel B2 cfn)) (wceq (cfv (cab f2 (wf1 A2 B2 (cv f2))) chash) (co (cfv (cfv A2 chash) cfa) (co (cfv B2 chash) (cfv A2 chash) cbc) cmul)) $;

--| A factorial counts the number of bijections on a finite set. (Contributed by Mario Carneiro, 21-Jan-2015.) (Proof shortened by Mario Carneiro, 17-Apr-2015.)
theorem hashfac {f2: setvar} (A2: class):
  $ wi (wcel A2 cfn) (wceq (cfv (cab f2 (wf1o A2 A2 (cv f2))) chash) (cfv (cfv A2 chash) cfa)) $;

--| Two ways to write a strictly increasing function on the reals. (Contributed by Mario Carneiro, 9-Sep-2015.)
theorem leiso (A2 B2 F: class):
  $ wi (wa (wss A2 cxr) (wss B2 cxr)) (wb (wiso A2 B2 clt clt F) (wiso A2 B2 cle cle F)) $;

--| Version of ~ isorel for strictly increasing functions on the reals. (Contributed by Mario Carneiro, 6-Apr-2015.) (Revised by Mario Carneiro, 9-Sep-2015.)
theorem leisorel (A2 B2 C D F: class):
  $ wi (w3a (wiso A2 B2 clt clt F) (wa (wss A2 cxr) (wss B2 cxr)) (wa (wcel C A2) (wcel D A2))) (wb (wbr C D cle) (wbr (cfv C F) (cfv D F) cle)) $;

--| Lemma for ~ fz1iso . (Contributed by Mario Carneiro, 2-Apr-2014.)
theorem fz1isolem {f2 n: setvar} (A2: class) (B2: class n) (C: class f2 n) (R G O: class n):
  $ wceq G (cres (crdg (cmpt n cvv (co (cv n) c1 caddc)) c1) com) $ >
  $ wceq B2 (cin cn (cima (ccnv clt) (csn (co (cfv A2 chash) c1 caddc)))) $ >
  $ wceq C (cin com (cfv (co (cfv A2 chash) c1 caddc) (ccnv G))) $ >
  $ wceq O (coi A2 R) $ >
  $ wi (wa (wor A2 R) (wcel A2 cfn)) (wex f2 (wiso (co c1 (cfv A2 chash) cfz) A2 clt R (cv f2))) $;

--| Any finite ordered set has an order isomorphism to a one-based finite sequence. (Contributed by Mario Carneiro, 2-Apr-2014.)
theorem fz1iso {f2: setvar} (A2 R: class):
  $ wi (wa (wor A2 R) (wcel A2 cfn)) (wex f2 (wiso (co c1 (cfv A2 chash) cfz) A2 clt R (cv f2))) $;

--| Any set that is not finite contains subsets of arbitrarily large finite cardinality. Cf. ~ isinf . (Contributed by Thierry Arnoux, 5-Jul-2017.)
theorem ishashinf {x3 n: setvar} (A2: class):
  $ wi (wn (wcel A2 cfn)) (wral n (wrex x3 (wceq (cfv (cv x3) chash) (cv n)) (cpw A2)) cn) $;

--| The function ` F ` contains a sparse set of nonzero values to be summed. The function ` G ` is an order isomorphism from the set of nonzero values of ` F ` to a 1-based finite sequence, and ` H ` collects these nonzero values together. Under these conditions, the sum over the values in ` H ` yields the same result as the sum over the original set ` F ` . (Contributed by Mario Carneiro, 2-Apr-2014.)
theorem seqcoll {k n: setvar} (ph: wff) (A2 c_pl S F G: class) (H: class k) (M: class) (N: class k n) (Z: class n):
  $ wi (wa ph (wcel (cv k) S)) (wceq (co Z (cv k) c_pl) (cv k)) $ >
  $ wi (wa ph (wcel (cv k) S)) (wceq (co (cv k) Z c_pl) (cv k)) $ >
  $ wi (wa ph (wa (wcel (cv k) S) (wcel (cv n) S))) (wcel (co (cv k) (cv n) c_pl) S) $ >
  $ wi ph (wcel Z S) $ >
  $ wi ph (wiso (co c1 (cfv A2 chash) cfz) A2 clt clt G) $ >
  $ wi ph (wcel N (co c1 (cfv A2 chash) cfz)) $ >
  $ wi ph (wss A2 (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M (cfv (cfv A2 chash) G) cfz))) (wcel (cfv (cv k) F) S) $ >
  $ wi (wa ph (wcel (cv k) (cdif (co M (cfv (cfv A2 chash) G) cfz) A2))) (wceq (cfv (cv k) F) Z) $ >
  $ wi (wa ph (wcel (cv n) (co c1 (cfv A2 chash) cfz))) (wceq (cfv (cv n) H) (cfv (cfv (cv n) G) F)) $ >
  $ wi ph (wceq (cfv (cfv N G) (cseq c_pl F M)) (cfv N (cseq c_pl H c1))) $;

--| The function ` F ` contains a sparse set of nonzero values to be summed. The function ` G ` is an order isomorphism from the set of nonzero values of ` F ` to a 1-based finite sequence, and ` H ` collects these nonzero values together. Under these conditions, the sum over the values in ` H ` yields the same result as the sum over the original set ` F ` . (Contributed by Mario Carneiro, 13-Dec-2014.)
theorem seqcoll2 {k n: setvar} (ph: wff) (A2 c_pl S F G: class) (H: class k) (M: class) (N Z: class n):
  $ wi (wa ph (wcel (cv k) S)) (wceq (co Z (cv k) c_pl) (cv k)) $ >
  $ wi (wa ph (wcel (cv k) S)) (wceq (co (cv k) Z c_pl) (cv k)) $ >
  $ wi (wa ph (wa (wcel (cv k) S) (wcel (cv n) S))) (wcel (co (cv k) (cv n) c_pl) S) $ >
  $ wi ph (wcel Z S) $ >
  $ wi ph (wiso (co c1 (cfv A2 chash) cfz) A2 clt clt G) $ >
  $ wi ph (wne A2 c0) $ >
  $ wi ph (wss A2 (co M N cfz)) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel (cfv (cv k) F) S) $ >
  $ wi (wa ph (wcel (cv k) (cdif (co M N cfz) A2))) (wceq (cfv (cv k) F) Z) $ >
  $ wi (wa ph (wcel (cv n) (co c1 (cfv A2 chash) cfz))) (wceq (cfv (cv n) H) (cfv (cfv (cv n) G) F)) $ >
  $ wi ph (wceq (cfv N (cseq c_pl F M)) (cfv (cfv A2 chash) (cseq c_pl H c1))) $;

--| Corollary of the Pigeonhole Principle using equality. Equivalent of ~ phpeqd expressed using the hash function. (Contributed by Rohan Ridenour, 3-Aug-2023.)
theorem phphashd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wss B2 A2) $ >
  $ wi ph (wceq (cfv A2 chash) (cfv B2 chash)) $ >
  $ wi ph (wceq A2 B2) $;

--| Corollary of the Pigeonhole Principle using equality. Equivalent of ~ phphashd with reversed arguments. (Contributed by Rohan Ridenour, 3-Aug-2023.)
theorem phphashrd (ph: wff) (A2 B2: class):
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wceq (cfv A2 chash) (cfv B2 chash)) $ >
  $ wi ph (wceq A2 B2) $;

--| An unordered pair has at most two elements. (Contributed by Mario Carneiro, 11-Feb-2015.)
theorem hashprlei (A2 B2: class):
  $ wa (wcel (cpr A2 B2) cfn) (wbr (cfv (cpr A2 B2) chash) c2 cle) $;

--| A set of size two is an unordered pair. (Contributed by Alexander van der Vekens, 8-Dec-2017.)
theorem hash2pr {a b: setvar} (V: class) (W: class a b):
  $ wi (wa (wcel V W) (wceq (cfv V chash) c2)) (wex a (wex b (wceq V (cpr (cv a) (cv b))))) $;

--| A set of size two is an unordered pair of two different elements. (Contributed by Alexander van der Vekens, 8-Dec-2017.)
theorem hash2prde {a b: setvar} (V W: class):
  $ wi (wa (wcel V W) (wceq (cfv V chash) c2)) (wex a (wex b (wa (wne (cv a) (cv b)) (wceq V (cpr (cv a) (cv b)))))) $;

--| A set of size two is an unordered pair if and only if it contains two different elements. (Contributed by Alexander van der Vekens, 14-Jan-2018.)
theorem hash2exprb {a b: setvar} (V W: class):
  $ wi (wcel V W) (wb (wceq (cfv V chash) c2) (wex a (wex b (wa (wne (cv a) (cv b)) (wceq V (cpr (cv a) (cv b))))))) $;

--| A set of size two is a proper unordered pair. (Contributed by AV, 1-Nov-2020.)
theorem hash2prb {a b: setvar} (V W: class):
  $ wi (wcel V W) (wb (wceq (cfv V chash) c2) (wrex a (wrex b (wa (wne (cv a) (cv b)) (wceq V (cpr (cv a) (cv b)))) V) V)) $;

--| The set of proper pairs of elements of a given set expressed in two ways. (Contributed by AV, 24-Nov-2020.)
theorem prprrab {x3: setvar} (A2: class x3):
  $ wceq (crab x3 (wceq (cfv (cv x3) chash) c2) (cdif (cpw A2) (csn c0))) (crab x3 (wceq (cfv (cv x3) chash) c2) (cpw A2)) $;

--| The cardinality of a set with two distinct elements. (Contributed by Thierry Arnoux, 27-Aug-2019.)
theorem nehash2 (ph: wff) (A2 B2 P V: class):
  $ wi ph (wcel P V) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wbr c2 (cfv P chash) cle) $;

--| A set of size two is an unordered pair if it contains two different elements. (Contributed by Alexander van der Vekens, 9-Dec-2018.) (Proof shortened by AV, 16-Jun-2022.)
theorem hash2prd (P V X Y: class):
  $ wi (wa (wcel P V) (wceq (cfv P chash) c2)) (wi (w3a (wcel X P) (wcel Y P) (wne X Y)) (wceq P (cpr X Y))) $;

--| If the size of a subset of an unordered pair is 2, the subset is the pair itself. (Contributed by Alexander van der Vekens, 9-Dec-2018.)
theorem hash2pwpr (P X Y: class):
  $ wi (wa (wceq (cfv P chash) c2) (wcel P (cpw (cpr X Y)))) (wceq P (cpr X Y)) $;

--| A nonempty set of size less than or equal to two is an unordered pair of sets. (Contributed by AV, 24-Nov-2021.)
theorem hashle2pr {a b: setvar} (P: class) (V: class a b):
  $ wi (wa (wcel P V) (wne P c0)) (wb (wbr (cfv P chash) c2 cle) (wex a (wex b (wceq P (cpr (cv a) (cv b)))))) $;

--| A nonempty subset of a powerset of a class ` V ` has size less than or equal to two iff it is an unordered pair of elements of ` V ` . (Contributed by AV, 24-Nov-2021.)
theorem hashle2prv {a b: setvar} (P V: class):
  $ wi (wcel P (cdif (cpw V) (csn c0))) (wb (wbr (cfv P chash) c2 cle) (wrex a (wrex b (wceq P (cpr (cv a) (cv b))) V) V)) $;

--| The set of subsets of a pair having length 2 is the set of the pair as singleton. (Contributed by AV, 9-Dec-2018.)
theorem pr2pwpr {p: setvar} (A2 B2: class) (V W: class p):
  $ wi (w3a (wcel A2 V) (wcel B2 W) (wne A2 B2)) (wceq (crab p (wbr (cv p) c2o cen) (cpw (cpr A2 B2))) (csn (cpr A2 B2))) $;

--| A set with size at least 2 has at least 2 different elements. (Contributed by AV, 18-Mar-2019.)
theorem hashge2el2dif {x3 y1: setvar} (D V: class):
  $ wi (wa (wcel D V) (wbr c2 (cfv D chash) cle)) (wrex x3 (wrex y1 (wne (cv x3) (cv y1)) D) D) $;

--| A set with at least 2 different elements has size at least 2. (Contributed by AV, 14-Oct-2020.)
theorem hashge2el2difr {x3 y1: setvar} (D V: class):
  $ wi (wa (wcel D V) (wrex x3 (wrex y1 (wne (cv x3) (cv y1)) D) D)) (wbr c2 (cfv D chash) cle) $;

--| A set has size at least 2 iff it has at least 2 different elements. (Contributed by AV, 14-Oct-2020.)
theorem hashge2el2difb {x3 y1: setvar} (D V: class):
  $ wi (wcel D V) (wb (wbr c2 (cfv D chash) cle) (wrex x3 (wrex y1 (wne (cv x3) (cv y1)) D) D)) $;

--| The size of the domain of a class which contains two ordered pairs with different first components is greater than or equal to 2. (Contributed by AV, 12-Nov-2021.)
theorem hashdmpropge2 (ph: wff) (A2 B2 C D F V W X Y Z: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wcel C X) $ >
  $ wi ph (wcel D Y) $ >
  $ wi ph (wcel F Z) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wss (cpr (cop A2 C) (cop B2 D)) F) $ >
  $ wi ph (wbr c2 (cfv (cdm F) chash) cle) $;

--| An unordered triple has at most three elements. (Contributed by Mario Carneiro, 11-Feb-2015.)
theorem hashtplei (A2 B2 C: class):
  $ wa (wcel (ctp A2 B2 C) cfn) (wbr (cfv (ctp A2 B2 C) chash) c3 cle) $;

--| The size of an unordered triple of three different elements. (Contributed by Alexander van der Vekens, 10-Nov-2017.) (Revised by AV, 18-Sep-2021.)
theorem hashtpg (A2 B2 C U V W: class):
  $ wi (w3a (wcel A2 U) (wcel B2 V) (wcel C W)) (wb (w3a (wne A2 B2) (wne B2 C) (wne C A2)) (wceq (cfv (ctp A2 B2 C) chash) c3)) $;

--| The size of an unordered set of seven different elements. (Contributed by AV, 2-Aug-2025.)
theorem hash7g (A2 B2 C D E F G V: class):
  $ wi (wa (w3a (w3a (wcel A2 V) (wcel B2 V) (wcel C V)) (wcel D V) (w3a (wcel E V) (wcel F V) (wcel G V))) (wa (w3a (wa (w3a (wne A2 B2) (wne A2 C) (wne A2 D)) (w3a (wne A2 E) (wne A2 F) (wne A2 G))) (wa (wa (wne B2 C) (wne B2 D)) (w3a (wne B2 E) (wne B2 F) (wne B2 G))) (wa (wne C D) (w3a (wne C E) (wne C F) (wne C G)))) (wa (w3a (wne D E) (wne D F) (wne D G)) (w3a (wne E F) (wne E G) (wne F G))))) (wceq (cfv (cun (cun (ctp A2 B2 C) (csn D)) (ctp E F G)) chash) c7) $;

--| A set with size at least 3 has at least 3 different elements. In contrast to ~ hashge2el2dif , which has an elementary proof, the dominance relation and 1-1 functions from a set with three elements which are known to be different are used to prove this theorem. Although there is also an elementary proof for this theorem, it might be much longer. After all, this proof should be kept because it can be used as template for proofs for higher cardinalities. (Contributed by AV, 20-Mar-2019.) (Proof modification is discouraged.)
theorem hashge3el3dif {x3 y1 z: setvar} (D: class) (V: class x3 y1 z):
  $ wi (wa (wcel D V) (wbr c3 (cfv D chash) cle)) (wrex x3 (wrex y1 (wrex z (w3a (wne (cv x3) (cv y1)) (wne (cv x3) (cv z)) (wne (cv y1) (cv z))) D) D) D) $;

--| An element of the set of subsets with two elements is a proper unordered pair. (Contributed by AV, 1-Nov-2020.)
theorem elss2prb {x3 y1 z: setvar} (P V: class):
  $ wb (wcel P (crab z (wceq (cfv (cv z) chash) c2) (cpw V))) (wrex x3 (wrex y1 (wa (wne (cv x3) (cv y1)) (wceq P (cpr (cv x3) (cv y1)))) V) V) $;

--| A subset of size two is an unordered pair of elements of its superset. (Contributed by Alexander van der Vekens, 12-Jul-2017.) (Proof shortened by AV, 4-Nov-2020.)
theorem hash2sspr {a b: setvar} (P V: class):
  $ wi (wa (wcel P (cpw V)) (wceq (cfv P chash) c2)) (wrex a (wrex b (wceq P (cpr (cv a) (cv b))) V) V) $;

--| If there is an element of the set of subsets with two elements in a set, an unordered pair of sets is in the set. (Contributed by Alexander van der Vekens, 12-Jul-2018.)
theorem exprelprel {w v e p: setvar} (V: class) (X: class e):
  $ wi (wrex p (wcel (cv p) X) (crab e (wceq (cfv (cv e) chash) c2) (cpw V))) (wrex v (wrex w (wcel (cpr (cv v) (cv w)) X) V) V) $;

--| A set of size three is an unordered triple. (Contributed by Alexander van der Vekens, 13-Sep-2018.)
theorem hash3tr {a b c: setvar} (V: class) (W: class a b c):
  $ wi (wa (wcel V W) (wceq (cfv V chash) c3)) (wex a (wex b (wex c (wceq V (ctp (cv a) (cv b) (cv c)))))) $;

--| If the size of a set is between 1 and 3 (inclusively), the set is a singleton or an unordered pair or an unordered triple. (Contributed by Alexander van der Vekens, 13-Sep-2018.)
theorem hash1to3 {a b c: setvar} (V: class):
  $ wi (w3a (wcel V cfn) (wbr c1 (cfv V chash) cle) (wbr (cfv V chash) c3 cle)) (wex a (wex b (wex c (w3o (wceq V (csn (cv a))) (wceq V (cpr (cv a) (cv b))) (wceq V (ctp (cv a) (cv b) (cv c))))))) $;

--| A set of size three is an unordered triple of three different elements. (Contributed by AV, 21-Jul-2025.)
theorem hash3tpde {a b c: setvar} (V W: class):
  $ wi (wa (wcel V W) (wceq (cfv V chash) c3)) (wex a (wex b (wex c (wa (w3a (wne (cv a) (cv b)) (wne (cv a) (cv c)) (wne (cv b) (cv c))) (wceq V (ctp (cv a) (cv b) (cv c))))))) $;

--| A set of size three is an unordered triple if and only if it contains three different elements. (Contributed by AV, 21-Jul-2025.)
theorem hash3tpexb {a b c: setvar} (V W: class):
  $ wi (wcel V W) (wb (wceq (cfv V chash) c3) (wex a (wex b (wex c (wa (w3a (wne (cv a) (cv b)) (wne (cv a) (cv c)) (wne (cv b) (cv c))) (wceq V (ctp (cv a) (cv b) (cv c)))))))) $;

--| A set of size three is a proper unordered triple. (Contributed by AV, 21-Jul-2025.)
theorem hash3tpb {a b c: setvar} (V W: class):
  $ wi (wcel V W) (wb (wceq (cfv V chash) c3) (wrex a (wrex b (wrex c (wa (w3a (wne (cv a) (cv b)) (wne (cv a) (cv c)) (wne (cv b) (cv c))) (wceq V (ctp (cv a) (cv b) (cv c)))) V) V) V)) $;

--| The value of a one-to-one function onto a triple at 0. (Contributed by AV, 20-Jul-2025.)
theorem tpf1ofv0 {x3: setvar} (A2: class) (B2 C F: class x3) (V: class):
  $ wceq F (cmpt x3 (co cc0 c3 cfzo) (cif (wceq (cv x3) cc0) A2 (cif (wceq (cv x3) c1) B2 C))) $ >
  $ wi (wcel A2 V) (wceq (cfv cc0 F) A2) $;

--| The value of a one-to-one function onto a triple at 1. (Contributed by AV, 20-Jul-2025.)
theorem tpf1ofv1 {x3: setvar} (A2 B2: class) (C F: class x3) (V: class):
  $ wceq F (cmpt x3 (co cc0 c3 cfzo) (cif (wceq (cv x3) cc0) A2 (cif (wceq (cv x3) c1) B2 C))) $ >
  $ wi (wcel B2 V) (wceq (cfv c1 F) B2) $;

--| The value of a one-to-one function onto a triple at 2. (Contributed by AV, 20-Jul-2025.)
theorem tpf1ofv2 {x3: setvar} (A2 B2 C: class) (F: class x3) (V: class):
  $ wceq F (cmpt x3 (co cc0 c3 cfzo) (cif (wceq (cv x3) cc0) A2 (cif (wceq (cv x3) c1) B2 C))) $ >
  $ wi (wcel C V) (wceq (cfv c2 F) C) $;

--| A function into a (proper) triple. (Contributed by AV, 20-Jul-2025.)
theorem tpf {x3: setvar} (A2 B2 C T: class) (F: class x3) (V: class):
  $ wceq F (cmpt x3 (co cc0 c3 cfzo) (cif (wceq (cv x3) cc0) A2 (cif (wceq (cv x3) c1) B2 C))) $ >
  $ wceq T (ctp A2 B2 C) $ >
  $ wi (w3a (wcel A2 V) (wcel B2 V) (wcel C V)) (wf (co cc0 c3 cfzo) T F) $;

--| A function onto a (proper) triple. (Contributed by AV, 20-Jul-2025.)
theorem tpfo {x3: setvar} (A2 B2 C T: class) (F: class x3) (V: class):
  $ wceq F (cmpt x3 (co cc0 c3 cfzo) (cif (wceq (cv x3) cc0) A2 (cif (wceq (cv x3) c1) B2 C))) $ >
  $ wceq T (ctp A2 B2 C) $ >
  $ wi (w3a (wcel A2 V) (wcel B2 V) (wcel C V)) (wfo (co cc0 c3 cfzo) T F) $;

--| A bijection onto a (proper) triple. (Contributed by AV, 21-Jul-2025.)
theorem tpf1o {x3: setvar} (A2 B2 C T: class) (F: class x3) (V: class):
  $ wceq F (cmpt x3 (co cc0 c3 cfzo) (cif (wceq (cv x3) cc0) A2 (cif (wceq (cv x3) c1) B2 C))) $ >
  $ wceq T (ctp A2 B2 C) $ >
  $ wi (wa (w3a (wcel A2 V) (wcel B2 V) (wcel C V)) (wceq (cfv T chash) c3)) (wf1o (co cc0 c3 cfzo) T F) $;

--| A function with a domain containing (at least) two different elements is not an ordered pair. This stronger version of ~ fundmge2nop (with the less restrictive requirement that ` ( G \ { (/) } ) ` needs to be a function instead of ` G ` ) is useful for proofs for extensible structures, see ~ structn0fun . (Contributed by AV, 12-Oct-2020.) (Revised by AV, 7-Jun-2021.) (Proof shortened by AV, 15-Nov-2021.)
theorem fundmge2nop0 (G: class):
  $ wi (wa (wfun (cdif G (csn c0))) (wbr c2 (cfv (cdm G) chash) cle)) (wn (wcel G (cxp cvv cvv))) $;

--| A function with a domain containing (at least) two different elements is not an ordered pair. (Contributed by AV, 12-Oct-2020.) (Proof shortened by AV, 9-Jun-2021.)
theorem fundmge2nop (G: class):
  $ wi (wa (wfun G) (wbr c2 (cfv (cdm G) chash) cle)) (wn (wcel G (cxp cvv cvv))) $;

--| A function with a domain containing (at least) two different elements is not an ordered pair. This stronger version of ~ fun2dmnop (with the less restrictive requirement that ` ( G \ { (/) } ) ` needs to be a function instead of ` G ` ) is useful for proofs for extensible structures, see ~ structn0fun . (Contributed by AV, 21-Sep-2020.) (Revised by AV, 7-Jun-2021.)
theorem fun2dmnop0 (A2 B2 G: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (w3a (wfun (cdif G (csn c0))) (wne A2 B2) (wss (cpr A2 B2) (cdm G))) (wn (wcel G (cxp cvv cvv))) $;

--| A function with a domain containing (at least) two different elements is not an ordered pair. (Contributed by AV, 21-Sep-2020.) (Proof shortened by AV, 9-Jun-2021.)
theorem fun2dmnop (A2 B2 G: class):
  $ wcel A2 cvv $ >
  $ wcel B2 cvv $ >
  $ wi (w3a (wfun G) (wne A2 B2) (wss (cpr A2 B2) (cdm G))) (wn (wcel G (cxp cvv cvv))) $;

--| If the size of a set is a nonnegative integer increased by 1, the size of the set with one of its elements removed is this nonnegative integer. (Contributed by Alexander van der Vekens, 7-Jan-2018.)
theorem hashdifsnp1 (N V W Y: class):
  $ wi (w3a (wcel V W) (wcel N V) (wcel Y cn0)) (wi (wceq (cfv V chash) (co Y c1 caddc)) (wceq (cfv (cdif V (csn N)) chash) Y)) $;

--| Properties of an ordered pair with a finite first component with at least L elements, proven by finite induction on the size of the first component. This theorem can be applied for graphs (represented as ordered pairs of vertices and edges) with a finite number of vertices, usually with ` L = 0 ` (see ~ opfi1ind ) or ` L = 1 ` . (Contributed by AV, 22-Oct-2020.) (Revised by AV, 28-Mar-2021.)
theorem fi1uzind {y1 w v e f2 n a b: setvar} (ph: wff y1 w f2 a b) (ps: wff v e a b) (ch: wff y1 v e n a b) (th: wff y1 w f2 a b) (rh: wff a b) (E: class y1 w f2 b) (F: class y1 v e n b) (L: class w f2 a b) (V: class y1 w f2):
  $ wcel F cvv $ >
  $ wcel L cn0 $ >
  $ wi (wa (wceq (cv v) V) (wceq (cv e) E)) (wb ps ph) $ >
  $ wi (wa (wceq (cv v) (cv w)) (wceq (cv e) (cv f2))) (wb ps th) $ >
  $ wi (wa (wsbc a (wsbc b rh (cv e)) (cv v)) (wcel (cv n) (cv v))) (wsbc a (wsbc b rh F) (cdif (cv v) (csn (cv n)))) $ >
  $ wi (wa (wceq (cv w) (cdif (cv v) (csn (cv n)))) (wceq (cv f2) F)) (wb th ch) $ >
  $ wi (wa (wsbc a (wsbc b rh (cv e)) (cv v)) (wceq (cfv (cv v) chash) L)) ps $ >
  $ wi (wa (wa (wcel (co (cv y1) c1 caddc) cn0) (w3a (wsbc a (wsbc b rh (cv e)) (cv v)) (wceq (cfv (cv v) chash) (co (cv y1) c1 caddc)) (wcel (cv n) (cv v)))) ch) ps $ >
  $ wi (w3a (wsbc a (wsbc b rh E) V) (wcel V cfn) (wbr L (cfv V chash) cle)) ph $;

--| Properties of a binary relation with a finite first component with at least L elements, proven by finite induction on the size of the first component. This theorem can be applied for graphs (as binary relation between the set of vertices and an edge function) with a finite number of vertices, usually with ` L = 0 ` (see ~ brfi1ind ) or ` L = 1 ` . (Contributed by Alexander van der Vekens, 7-Jan-2018.) (Proof shortened by AV, 23-Oct-2020.) (Revised by AV, 28-Mar-2021.)
theorem brfi1uzind {y1 w v e f2 n: setvar} (ph: wff y1 w f2) (ps: wff v e) (ch: wff y1 v e n) (th: wff y1 w f2) (E: class y1 w f2) (F: class y1 v e n) (G: class) (L: class w f2) (V: class y1 w f2):
  $ wrel G $ >
  $ wcel F cvv $ >
  $ wcel L cn0 $ >
  $ wi (wa (wceq (cv v) V) (wceq (cv e) E)) (wb ps ph) $ >
  $ wi (wa (wceq (cv v) (cv w)) (wceq (cv e) (cv f2))) (wb ps th) $ >
  $ wi (wa (wbr (cv v) (cv e) G) (wcel (cv n) (cv v))) (wbr (cdif (cv v) (csn (cv n))) F G) $ >
  $ wi (wa (wceq (cv w) (cdif (cv v) (csn (cv n)))) (wceq (cv f2) F)) (wb th ch) $ >
  $ wi (wa (wbr (cv v) (cv e) G) (wceq (cfv (cv v) chash) L)) ps $ >
  $ wi (wa (wa (wcel (co (cv y1) c1 caddc) cn0) (w3a (wbr (cv v) (cv e) G) (wceq (cfv (cv v) chash) (co (cv y1) c1 caddc)) (wcel (cv n) (cv v)))) ch) ps $ >
  $ wi (w3a (wbr V E G) (wcel V cfn) (wbr L (cfv V chash) cle)) ph $;

--| Properties of a binary relation with a finite first component, proven by finite induction on the size of the first component. (Contributed by Alexander van der Vekens, 7-Jan-2018.) (Revised by AV, 28-Mar-2021.)
theorem brfi1ind {y1 w v e f2 n: setvar} (ph: wff y1 w f2) (ps: wff v e) (ch: wff y1 v e n) (th: wff y1 w f2) (E: class y1 w f2) (F: class y1 v e n) (G: class) (V: class y1 w f2):
  $ wrel G $ >
  $ wcel F cvv $ >
  $ wi (wa (wceq (cv v) V) (wceq (cv e) E)) (wb ps ph) $ >
  $ wi (wa (wceq (cv v) (cv w)) (wceq (cv e) (cv f2))) (wb ps th) $ >
  $ wi (wa (wbr (cv v) (cv e) G) (wcel (cv n) (cv v))) (wbr (cdif (cv v) (csn (cv n))) F G) $ >
  $ wi (wa (wceq (cv w) (cdif (cv v) (csn (cv n)))) (wceq (cv f2) F)) (wb th ch) $ >
  $ wi (wa (wbr (cv v) (cv e) G) (wceq (cfv (cv v) chash) cc0)) ps $ >
  $ wi (wa (wa (wcel (co (cv y1) c1 caddc) cn0) (w3a (wbr (cv v) (cv e) G) (wceq (cfv (cv v) chash) (co (cv y1) c1 caddc)) (wcel (cv n) (cv v)))) ch) ps $ >
  $ wi (wa (wbr V E G) (wcel V cfn)) ph $;

--| Alternate proof of ~ brfi1ind , which does not use ~ brfi1uzind . (Contributed by Alexander van der Vekens, 7-Jan-2018.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem brfi1indALT {y1 w v e f2 n: setvar} (ph: wff y1 w f2) (ps: wff v e) (ch: wff y1 v e n) (th: wff y1 w f2) (E: class y1 w f2) (F: class y1 v e n) (G: class) (V: class y1 w f2):
  $ wrel G $ >
  $ wcel F cvv $ >
  $ wi (wa (wceq (cv v) V) (wceq (cv e) E)) (wb ps ph) $ >
  $ wi (wa (wceq (cv v) (cv w)) (wceq (cv e) (cv f2))) (wb ps th) $ >
  $ wi (wa (wbr (cv v) (cv e) G) (wcel (cv n) (cv v))) (wbr (cdif (cv v) (csn (cv n))) F G) $ >
  $ wi (wa (wceq (cv w) (cdif (cv v) (csn (cv n)))) (wceq (cv f2) F)) (wb th ch) $ >
  $ wi (wa (wbr (cv v) (cv e) G) (wceq (cfv (cv v) chash) cc0)) ps $ >
  $ wi (wa (wa (wcel (co (cv y1) c1 caddc) cn0) (w3a (wbr (cv v) (cv e) G) (wceq (cfv (cv v) chash) (co (cv y1) c1 caddc)) (wcel (cv n) (cv v)))) ch) ps $ >
  $ wi (wa (wbr V E G) (wcel V cfn)) ph $;

--| Properties of an ordered pair with a finite first component with at least L elements, proven by finite induction on the size of the first component. This theorem can be applied for graphs (represented as ordered pairs of vertices and edges) with a finite number of vertices, usually with ` L = 0 ` (see ~ opfi1ind ) or ` L = 1 ` . (Contributed by AV, 22-Oct-2020.) (Revised by AV, 28-Mar-2021.)
theorem opfi1uzind {y1 w v e f2 n: setvar} (ph: wff y1 w f2) (ps: wff v e) (ch: wff y1 v e n) (th: wff y1 w f2) (E: class y1 w f2) (F: class y1 v e n) (G: class) (L: class w f2) (V: class y1 w f2):
  $ wcel E cvv $ >
  $ wcel F cvv $ >
  $ wcel L cn0 $ >
  $ wi (wa (wceq (cv v) V) (wceq (cv e) E)) (wb ps ph) $ >
  $ wi (wa (wceq (cv v) (cv w)) (wceq (cv e) (cv f2))) (wb ps th) $ >
  $ wi (wa (wcel (cop (cv v) (cv e)) G) (wcel (cv n) (cv v))) (wcel (cop (cdif (cv v) (csn (cv n))) F) G) $ >
  $ wi (wa (wceq (cv w) (cdif (cv v) (csn (cv n)))) (wceq (cv f2) F)) (wb th ch) $ >
  $ wi (wa (wcel (cop (cv v) (cv e)) G) (wceq (cfv (cv v) chash) L)) ps $ >
  $ wi (wa (wa (wcel (co (cv y1) c1 caddc) cn0) (w3a (wcel (cop (cv v) (cv e)) G) (wceq (cfv (cv v) chash) (co (cv y1) c1 caddc)) (wcel (cv n) (cv v)))) ch) ps $ >
  $ wi (w3a (wcel (cop V E) G) (wcel V cfn) (wbr L (cfv V chash) cle)) ph $;

--| Properties of an ordered pair with a finite first component, proven by finite induction on the size of the first component. This theorem can be applied for graphs (represented as ordered pairs of vertices and edges) with a finite number of vertices, e.g., ~ fusgrfis . (Contributed by AV, 22-Oct-2020.) (Revised by AV, 28-Mar-2021.)
theorem opfi1ind {y1 w v e f2 n: setvar} (ph: wff y1 w f2) (ps: wff v e) (ch: wff y1 v e n) (th: wff y1 w f2) (E: class y1 w f2) (F: class y1 v e n) (G: class) (V: class y1 w f2):
  $ wcel E cvv $ >
  $ wcel F cvv $ >
  $ wi (wa (wceq (cv v) V) (wceq (cv e) E)) (wb ps ph) $ >
  $ wi (wa (wceq (cv v) (cv w)) (wceq (cv e) (cv f2))) (wb ps th) $ >
  $ wi (wa (wcel (cop (cv v) (cv e)) G) (wcel (cv n) (cv v))) (wcel (cop (cdif (cv v) (csn (cv n))) F) G) $ >
  $ wi (wa (wceq (cv w) (cdif (cv v) (csn (cv n)))) (wceq (cv f2) F)) (wb th ch) $ >
  $ wi (wa (wcel (cop (cv v) (cv e)) G) (wceq (cfv (cv v) chash) cc0)) ps $ >
  $ wi (wa (wa (wcel (co (cv y1) c1 caddc) cn0) (w3a (wcel (cop (cv v) (cv e)) G) (wceq (cfv (cv v) chash) (co (cv y1) c1 caddc)) (wcel (cv n) (cv v)))) ch) ps $ >
  $ wi (wa (wcel (cop V E) G) (wcel V cfn)) ph $;

--| Syntax for the Word operator.
term cword (S: class): class;

--| Define the class of _words over a set_. A word (sometimes also called a _string_) is a finite sequence of symbols from a set (alphabet) ` S ` . Definition in Section 9.1 of [AhoHopUll] p. 318. The domain is forced to be an initial segment of ` NN0 ` so that two words with the same symbols in the same order be equal. The set ` Word S ` is sometimes denoted by S*, using the Kleene star, although the Kleene star, or Kleene closure, is sometimes reserved to denote an operation on languages. The set ` Word S ` equipped with concatenation is the free monoid over ` S ` , and the monoid unit is the empty word (see ~ frmdval ). (Contributed by FL, 14-Jan-2014.) (Revised by Stefan O'Rear, 14-Aug-2015.) (Revised by Mario Carneiro, 26-Feb-2016.)
axiom df_word {w l: setvar} (S: class):
  $ wceq (cword S) (cab w (wrex l (wf (co cc0 (cv l) cfzo) S (cv w)) cn0)) $;

--| Property of being a word over a set with an existential quantifier over the length. (Contributed by Stefan O'Rear, 15-Aug-2015.) (Revised by Mario Carneiro, 26-Feb-2016.) (Proof shortened by AV, 13-May-2020.)
theorem iswrd {l: setvar} (S W: class):
  $ wb (wcel W (cword S)) (wrex l (wf (co cc0 (cv l) cfzo) S W) cn0) $;

--| Value of the set of words over a set. (Contributed by Stefan O'Rear, 10-Aug-2015.) (Revised by Mario Carneiro, 26-Feb-2016.)
theorem wrdval {l: setvar} (S V: class):
  $ wi (wcel S V) (wceq (cword S) (ciun l cn0 (co S (co cc0 (cv l) cfzo) cmap))) $;

--| A zero-based sequence is a word. (Contributed by Stefan O'Rear, 15-Aug-2015.) (Revised by Mario Carneiro, 26-Feb-2016.)
theorem iswrdi (S L W: class):
  $ wi (wf (co cc0 L cfzo) S W) (wcel W (cword S)) $;

--| A word is a zero-based sequence with a recoverable upper limit. (Contributed by Stefan O'Rear, 15-Aug-2015.)
theorem wrdf (S W: class):
  $ wi (wcel W (cword S)) (wf (co cc0 (cfv W chash) cfzo) S W) $;

--| A word is a zero-based sequence with a recoverable upper limit, deduction version. (Contributed by Thierry Arnoux, 22-Dec-2021.)
theorem wrdfd (ph: wff) (S N W: class):
  $ wi ph (wceq N (cfv W chash)) $ >
  $ wi ph (wcel W (cword S)) $ >
  $ wi ph (wf (co cc0 N cfzo) S W) $;

--| A word over an alphabet is a function from an open range of nonnegative integers (of length equal to the length of the word) into the alphabet. (Contributed by Alexander van der Vekens, 30-Jul-2018.)
theorem iswrdb (S W: class):
  $ wb (wcel W (cword S)) (wf (co cc0 (cfv W chash) cfzo) S W) $;

--| The indices of a word (i.e. its domain regarded as function) are elements of an open range of nonnegative integers (of length equal to the length of the word). (Contributed by AV, 2-May-2020.)
theorem wrddm (S W: class):
  $ wi (wcel W (cword S)) (wceq (cdm W) (co cc0 (cfv W chash) cfzo)) $;

--| The set of words respects ordering on the base set. (Contributed by Stefan O'Rear, 15-Aug-2015.) (Revised by Mario Carneiro, 26-Feb-2016.) (Proof shortened by AV, 13-May-2020.)
theorem sswrd (S T: class):
  $ wi (wss S T) (wss (cword S) (cword T)) $;

--| A singleton of an ordered pair (with 0 as first component) is a word. (Contributed by AV, 23-Nov-2018.) (Proof shortened by AV, 18-Apr-2021.)
theorem snopiswrd (S V: class):
  $ wi (wcel S V) (wcel (csn (cop cc0 S)) (cword V)) $;

--| The set of words over a set is a set. (Contributed by Mario Carneiro, 26-Feb-2016.) (Proof shortened by JJ, 18-Nov-2022.)
theorem wrdexg (S V: class):
  $ wi (wcel S V) (wcel (cword S) cvv) $;

--| The set of words over a set is a set, bidirectional version. (Contributed by Mario Carneiro, 26-Feb-2016.) (Proof shortened by AV, 23-Nov-2018.)
theorem wrdexb (S: class):
  $ wb (wcel S cvv) (wcel (cword S) cvv) $;

--| The set of words over a set is a set, inference form. (Contributed by AV, 23-May-2021.)
theorem wrdexi (S: class):
  $ wcel S cvv $ >
  $ wcel (cword S) cvv $;

--| A symbol within a word over an alphabet belongs to the alphabet. (Contributed by Alexander van der Vekens, 28-Jun-2018.)
theorem wrdsymbcl (I V W: class):
  $ wi (wa (wcel W (cword V)) (wcel I (co cc0 (cfv W chash) cfzo))) (wcel (cfv I W) V) $;

--| A word is a function with a zero-based sequence of integers as domain. (Contributed by Alexander van der Vekens, 13-Apr-2018.)
theorem wrdfn (S W: class):
  $ wi (wcel W (cword S)) (wfn W (co cc0 (cfv W chash) cfzo)) $;

--| A word over an alphabet is a word over the universal class. (Contributed by AV, 8-Feb-2021.) (Proof shortened by JJ, 18-Nov-2022.)
theorem wrdv (V W: class):
  $ wi (wcel W (cword V)) (wcel W (cword cvv)) $;

--| The length of a word is not in the domain of the word (regarded as a function). (Contributed by AV, 3-Mar-2021.) (Proof shortened by JJ, 18-Nov-2022.)
theorem wrdlndm (V W: class):
  $ wi (wcel W (cword V)) (wnel (cfv W chash) (cdm W)) $;

--| An arbitrary word is a word over an alphabet if all of its symbols belong to the alphabet. (Contributed by AV, 23-Jan-2021.)
theorem iswrdsymb {i: setvar} (V W: class):
  $ wi (wa (wcel W (cword cvv)) (wral i (wcel (cfv (cv i) W) V) (co cc0 (cfv W chash) cfzo))) (wcel W (cword V)) $;

--| A word is a finite set. (Contributed by Stefan O'Rear, 2-Nov-2015.) (Proof shortened by AV, 18-Nov-2018.)
theorem wrdfin (S W: class):
  $ wi (wcel W (cword S)) (wcel W cfn) $;

--| The length of a word is a nonnegative integer. This corresponds to the definition in Section 9.1 of [AhoHopUll] p. 318. (Contributed by Stefan O'Rear, 27-Aug-2015.)
theorem lencl (S W: class):
  $ wi (wcel W (cword S)) (wcel (cfv W chash) cn0) $;

--| The length of a nonempty word is a positive integer. (Contributed by Mario Carneiro, 1-Oct-2015.)
theorem lennncl (S W: class):
  $ wi (wa (wcel W (cword S)) (wne W c0)) (wcel (cfv W chash) cn) $;

--| A word is a function from a finite interval of integers. (Contributed by AV, 10-Feb-2021.)
theorem wrdffz (S W: class):
  $ wi (wcel W (cword S)) (wf (co cc0 (co (cfv W chash) c1 cmin) cfz) S W) $;

--| Equality theorem for the set of words. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem wrdeq (S T: class):
  $ wi (wceq S T) (wceq (cword S) (cword T)) $;

--| Equality theorem for the set of words, inference form. (Contributed by AV, 23-May-2021.)
theorem wrdeqi (S T: class):
  $ wceq S T $ >
  $ wceq (cword S) (cword T) $;

--| A function with empty domain is a word. (Contributed by AV, 13-Oct-2018.)
theorem iswrddm0 (S W: class):
  $ wi (wf c0 S W) (wcel W (cword S)) $;

--| The empty set is a word (the _empty word_, frequently denoted &#949; in this context). This corresponds to the definition in Section 9.1 of [AhoHopUll] p. 318. (Contributed by Stefan O'Rear, 15-Aug-2015.) (Proof shortened by AV, 13-May-2020.)
theorem wrd0 (S: class):
  $ wcel c0 (cword S) $;

--| The empty word is the only word over an empty alphabet. (Contributed by AV, 25-Oct-2018.)
theorem _0wrd0 (W: class):
  $ wb (wcel W (cword c0)) (wceq W c0) $;

--| A sequence with zero-based indices is a word. (Contributed by AV, 31-Jan-2018.) (Proof shortened by AV, 13-Oct-2018.) (Proof shortened by JJ, 18-Nov-2022.)
theorem ffz0iswrd (S L W: class):
  $ wi (wf (co cc0 L cfz) S W) (wcel W (cword S)) $;

--| A word is a word over the symbols it consists of. (Contributed by AV, 1-Dec-2022.)
theorem wrdsymb (A2 S: class):
  $ wi (wcel S (cword A2)) (wcel S (cword (cima S (co cc0 (cfv S chash) cfzo)))) $;

--| Hypothesis builder for ` Word S ` . (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem nfwrd {x3: setvar} (S: class x3):
  $ wnfc x3 S $ >
  $ wnfc x3 (cword S) $;

--| Class substitution for the symbols of a word. (Contributed by Alexander van der Vekens, 15-Jul-2018.)
theorem csbwrdg {x3: setvar} (S V: class):
  $ wi (wcel S V) (wceq (csb x3 S (cword (cv x3))) (cword S)) $;

--| Words of a fixed length are mappings from a fixed half-open integer interval. (Contributed by Alexander van der Vekens, 25-Mar-2018.) (Proof shortened by AV, 13-May-2020.)
theorem wrdnval {w: setvar} (N V X: class):
  $ wi (wa (wcel V X) (wcel N cn0)) (wceq (crab w (wceq (cfv (cv w) chash) N) (cword V)) (co V (co cc0 N cfzo) cmap)) $;

--| Words as a mapping. (Contributed by Thierry Arnoux, 4-Mar-2020.)
theorem wrdmap (N V W X: class):
  $ wi (wa (wcel V X) (wcel N cn0)) (wb (wa (wcel W (cword V)) (wceq (cfv W chash) N)) (wcel W (co V (co cc0 N cfzo) cmap))) $;

--| If there is only a finite number of symbols, the number of words of a fixed length over these sysmbols is the number of these symbols raised to the power of the length. (Contributed by Alexander van der Vekens, 25-Mar-2018.)
theorem hashwrdn {w: setvar} (N V: class):
  $ wi (wa (wcel V cfn) (wcel N cn0)) (wceq (cfv (crab w (wceq (cfv (cv w) chash) N) (cword V)) chash) (co (cfv V chash) N cexp)) $;

--| If there is only a finite number of symbols, the number of words of a fixed length over these symbols is also finite. (Contributed by Alexander van der Vekens, 25-Mar-2018.) Remove unnecessary antecedent. (Revised by JJ, 18-Nov-2022.)
theorem wrdnfi {w: setvar} (N V: class):
  $ wi (wcel V cfn) (wcel (crab w (wceq (cfv (cv w) chash) N) (cword V)) cfn) $;

--| A symbol at a position "outside" of a word. (Contributed by Alexander van der Vekens, 26-May-2018.) (Proof shortened by AV, 2-May-2020.)
theorem wrdsymb0 (I V W: class):
  $ wi (wa (wcel W (cword V)) (wcel I cz)) (wi (wo (wbr I cc0 clt) (wbr (cfv W chash) I cle)) (wceq (cfv I W) c0)) $;

--| A word with length at least 1 is not empty. (Contributed by AV, 14-Oct-2018.)
theorem wrdlenge1n0 (V W: class):
  $ wi (wcel W (cword V)) (wb (wne W c0) (wbr c1 (cfv W chash) cle)) $;

--| The length of a word is a positive integer iff the word is not empty. (Contributed by AV, 22-Mar-2022.)
theorem len0nnbi (S W: class):
  $ wi (wcel W (cword S)) (wb (wne W c0) (wcel (cfv W chash) cn)) $;

--| A word with length at least 2 is not empty. (Contributed by AV, 18-Jun-2018.) (Proof shortened by AV, 14-Oct-2018.)
theorem wrdlenge2n0 (V W: class):
  $ wi (wa (wcel W (cword V)) (wbr c2 (cfv W chash) cle)) (wne W c0) $;

--| The first symbol of a nonempty word over an alphabet belongs to the alphabet. (Contributed by Alexander van der Vekens, 28-Jun-2018.)
theorem wrdsymb1 (V W: class):
  $ wi (wa (wcel W (cword V)) (wbr c1 (cfv W chash) cle)) (wcel (cfv cc0 W) V) $;

--| A word of length 1 starts with a symbol. (Contributed by AV, 20-Jul-2018.) (Proof shortened by AV, 19-Oct-2018.)
theorem wrdlen1 {v: setvar} (V W: class):
  $ wi (wa (wcel W (cword V)) (wceq (cfv W chash) c1)) (wrex v (wceq (cfv cc0 W) (cv v)) V) $;

--| The first symbol of a nonempty word is an element of the alphabet for the word. (Contributed by AV, 28-Sep-2018.) (Proof shortened by AV, 14-Oct-2018.)
theorem fstwrdne (V W: class):
  $ wi (wa (wcel W (cword V)) (wne W c0)) (wcel (cfv cc0 W) V) $;

--| The first symbol of a nonempty word is an element of the alphabet for the word. (Contributed by AV, 29-Sep-2018.) (Proof shortened by AV, 14-Oct-2018.)
theorem fstwrdne0 (N V W: class):
  $ wi (wa (wcel N cn) (wa (wcel W (cword V)) (wceq (cfv W chash) N))) (wcel (cfv cc0 W) V) $;

--| Two words are equal iff they have the same length and the same symbol at each position. (Contributed by AV, 13-Apr-2018.) (Revised by JJ, 30-Dec-2023.)
theorem eqwrd {i: setvar} (S T: class i) (U W: class):
  $ wi (wa (wcel U (cword S)) (wcel W (cword T))) (wb (wceq U W) (wa (wceq (cfv U chash) (cfv W chash)) (wral i (wceq (cfv (cv i) U) (cfv (cv i) W)) (co cc0 (cfv U chash) cfzo)))) $;

--| Implications for the value of an operation defined by the maps-to notation with a class abstraction of words as a result having an element. Note that ` ph ` may depend on ` z ` as well as on ` v ` and ` y ` . (Contributed by Alexander van der Vekens, 15-Jul-2018.)
theorem elovmpowrd {y1 z v: setvar} (ph: wff y1 z v) (O: class y1 z v) (V Y: class) (Z: class y1 v):
  $ wceq O (cmpo v y1 cvv cvv (crab z ph (cword (cv v)))) $ >
  $ wi (wcel Z (co V Y O)) (w3a (wcel V cvv) (wcel Y cvv) (wcel Z (cword V))) $;

--| Implications for the value of an operation defined by the maps-to notation with a function of nonnegative integers into a class abstraction of words as a result having an element. Note that ` ph ` may depend on ` z ` as well as on ` v ` and ` y ` and ` n ` . (Contributed by AV, 16-Jul-2018.) (Revised by AV, 16-May-2019.)
theorem elovmptnn0wrd {y1 z v n: setvar} (ph: wff y1 z v n) (N: class y1 v) (O: class y1 z v n) (V Y: class) (Z: class y1 v n):
  $ wceq O (cmpo v y1 cvv cvv (cmpt n cn0 (crab z ph (cword (cv v))))) $ >
  $ wi (wcel Z (cfv N (co V Y O))) (wa (wa (wcel V cvv) (wcel Y cvv)) (wa (wcel N cn0) (wcel Z (cword V)))) $;

--| A word truncated by a symbol is a word. (Contributed by AV, 29-Jan-2021.)
theorem wrdred1 (S F: class):
  $ wi (wcel F (cword S)) (wcel (cres F (co cc0 (co (cfv F chash) c1 cmin) cfzo)) (cword S)) $;

--| The length of a word truncated by a symbol. (Contributed by Alexander van der Vekens, 1-Nov-2017.) (Revised by AV, 29-Jan-2021.)
theorem wrdred1hash (S F: class):
  $ wi (wa (wcel F (cword S)) (wbr c1 (cfv F chash) cle)) (wceq (cfv (cres F (co cc0 (co (cfv F chash) c1 cmin) cfzo)) chash) (co (cfv F chash) c1 cmin)) $;

--| Extend class notation with the Last Symbol of a word.
term clsw: class;

--| Extract the last symbol of a word. May be not meaningful for other sets which are not words. The name ` lastS ` (as abbreviation of "lastSymbol") is a compromise between usually used names for corresponding functions in computer programs (as last() or lastChar()), the terminology used for words in set.mm ("symbol" instead of "character") and brevity ("lastS" is shorter than "lastChar" and "lastSymbol"). Labels of theorems about last symbols of a word will contain the abbreviation "lsw" (Last Symbol of a Word). (Contributed by Alexander van der Vekens, 18-Mar-2018.)
axiom df_lsw {w: setvar}:
  $ wceq clsw (cmpt w cvv (cfv (co (cfv (cv w) chash) c1 cmin) (cv w))) $;

--| Extract the last symbol of a word. May be not meaningful for other sets which are not words. (Contributed by Alexander van der Vekens, 18-Mar-2018.)
theorem lsw (W X: class):
  $ wi (wcel W X) (wceq (cfv W clsw) (cfv (co (cfv W chash) c1 cmin) W)) $;

--| The last symbol of an empty word does not exist. (Contributed by Alexander van der Vekens, 19-Mar-2018.) (Proof shortened by AV, 2-May-2020.)
theorem lsw0 (V W: class):
  $ wi (wa (wcel W (cword V)) (wceq (cfv W chash) cc0)) (wceq (cfv W clsw) c0) $;

--| The last symbol of an empty word does not exist. (Contributed by Alexander van der Vekens, 11-Nov-2018.)
theorem lsw0g:
  $ wceq (cfv c0 clsw) c0 $;

--| The last symbol of a word of length 1 is the first symbol of this word. (Contributed by Alexander van der Vekens, 19-Mar-2018.)
theorem lsw1 (V W: class):
  $ wi (wa (wcel W (cword V)) (wceq (cfv W chash) c1)) (wceq (cfv W clsw) (cfv cc0 W)) $;

--| Closure of the last symbol: the last symbol of a nonempty word belongs to the alphabet for the word. (Contributed by AV, 2-Aug-2018.) (Proof shortened by AV, 29-Apr-2020.)
theorem lswcl (V W: class):
  $ wi (wa (wcel W (cword V)) (wne W c0)) (wcel (cfv W clsw) V) $;

--| The last symbol of a nonempty word is an element of the alphabet for the word. (Contributed by Alexander van der Vekens, 1-Oct-2018.) (Proof shortened by AV, 29-Apr-2020.)
theorem lswlgt0cl (N V W: class):
  $ wi (wa (wcel N cn) (wa (wcel W (cword V)) (wceq (cfv W chash) N))) (wcel (cfv W clsw) V) $;

--| Syntax for the concatenation operator.
term cconcat: class;

--| Define the concatenation operator which combines two words. Definition in Section 9.1 of [AhoHopUll] p. 318. (Contributed by FL, 14-Jan-2014.) (Revised by Stefan O'Rear, 15-Aug-2015.)
axiom df_concat {x3 t s1: setvar}:
  $ wceq cconcat (cmpo s1 t cvv cvv (cmpt x3 (co cc0 (co (cfv (cv s1) chash) (cfv (cv t) chash) caddc) cfzo) (cif (wcel (cv x3) (co cc0 (cfv (cv s1) chash) cfzo)) (cfv (cv x3) (cv s1)) (cfv (co (cv x3) (cfv (cv s1) chash) cmin) (cv t))))) $;

--| The concatenation operator is a two-argument function. (Contributed by Mario Carneiro, 27-Sep-2015.) (Proof shortened by AV, 29-Apr-2020.)
theorem ccatfn:
  $ wfn cconcat (cxp cvv cvv) $;

--| Value of the concatenation operator. (Contributed by Stefan O'Rear, 15-Aug-2015.)
theorem ccatfval {x3: setvar} (S T: class) (V W: class x3):
  $ wi (wa (wcel S V) (wcel T W)) (wceq (co S T cconcat) (cmpt x3 (co cc0 (co (cfv S chash) (cfv T chash) caddc) cfzo) (cif (wcel (cv x3) (co cc0 (cfv S chash) cfzo)) (cfv (cv x3) S) (cfv (co (cv x3) (cfv S chash) cmin) T)))) $;

--| The concatenation of two words is a word. (Contributed by FL, 2-Feb-2014.) (Proof shortened by Stefan O'Rear, 15-Aug-2015.) (Proof shortened by AV, 29-Apr-2020.)
theorem ccatcl (B2 S T: class):
  $ wi (wa (wcel S (cword B2)) (wcel T (cword B2))) (wcel (co S T cconcat) (cword B2)) $;

--| The length of a concatenated word. (Contributed by Stefan O'Rear, 15-Aug-2015.) (Revised by JJ, 1-Jan-2024.)
theorem ccatlen (A2 B2 S T: class):
  $ wi (wa (wcel S (cword A2)) (wcel T (cword B2))) (wceq (cfv (co S T cconcat) chash) (co (cfv S chash) (cfv T chash) caddc)) $;

--| The concatenation of two words is empty iff the two words are empty. (Contributed by AV, 4-Mar-2022.) (Revised by JJ, 18-Jan-2024.)
theorem ccat0 (A2 B2 S T: class):
  $ wi (wa (wcel S (cword A2)) (wcel T (cword B2))) (wb (wceq (co S T cconcat) c0) (wa (wceq S c0) (wceq T c0))) $;

--| Value of a symbol in the left half of a concatenated word. (Contributed by Stefan O'Rear, 15-Aug-2015.) (Revised by Mario Carneiro, 22-Sep-2015.) (Proof shortened by AV, 30-Apr-2020.) (Revised by JJ, 18-Jan-2024.)
theorem ccatval1 (A2 B2 S T I: class):
  $ wi (w3a (wcel S (cword A2)) (wcel T (cword B2)) (wcel I (co cc0 (cfv S chash) cfzo))) (wceq (cfv I (co S T cconcat)) (cfv I S)) $;

--| Value of a symbol in the right half of a concatenated word. (Contributed by Stefan O'Rear, 15-Aug-2015.) (Revised by Mario Carneiro, 22-Sep-2015.)
theorem ccatval2 (B2 S T I: class):
  $ wi (w3a (wcel S (cword B2)) (wcel T (cword B2)) (wcel I (co (cfv S chash) (co (cfv S chash) (cfv T chash) caddc) cfzo))) (wceq (cfv I (co S T cconcat)) (cfv (co I (cfv S chash) cmin) T)) $;

--| Value of a symbol in the right half of a concatenated word, using an index relative to the subword. (Contributed by Stefan O'Rear, 16-Aug-2015.) (Proof shortened by AV, 30-Apr-2020.)
theorem ccatval3 (B2 S T I: class):
  $ wi (w3a (wcel S (cword B2)) (wcel T (cword B2)) (wcel I (co cc0 (cfv T chash) cfzo))) (wceq (cfv (co I (cfv S chash) caddc) (co S T cconcat)) (cfv I T)) $;

--| An element of a finite set of sequential integers up to the length of a word is an element of an extended finite set of sequential integers up to the length of a concatenation of this word with another word. (Contributed by Alexander van der Vekens, 28-Mar-2018.)
theorem elfzelfzccat (A2 B2 N V: class):
  $ wi (wa (wcel A2 (cword V)) (wcel B2 (cword V))) (wi (wcel N (co cc0 (cfv A2 chash) cfz)) (wcel N (co cc0 (cfv (co A2 B2 cconcat) chash) cfz))) $;

--| The concatenation of two words is a function over the half-open integer range having the sum of the lengths of the word as length. (Contributed by Alexander van der Vekens, 30-Mar-2018.)
theorem ccatvalfn (A2 B2 V: class):
  $ wi (wa (wcel A2 (cword V)) (wcel B2 (cword V))) (wfn (co A2 B2 cconcat) (co cc0 (co (cfv A2 chash) (cfv B2 chash) caddc) cfzo)) $;

--| The domain of a concatenated word is a superset of the domain of the first word. (Contributed by Thierry Arnoux, 19-Jun-2025.)
theorem ccatdmss (ph: wff) (A2 B2 S: class):
  $ wi ph (wcel A2 (cword S)) $ >
  $ wi ph (wcel B2 (cword S)) $ >
  $ wi ph (wss (cdm A2) (cdm (co A2 B2 cconcat))) $;

--| The symbol at a given position in a concatenated word. (Contributed by AV, 26-May-2018.) (Proof shortened by AV, 24-Nov-2018.)
theorem ccatsymb (A2 B2 I V: class):
  $ wi (w3a (wcel A2 (cword V)) (wcel B2 (cword V)) (wcel I cz)) (wceq (cfv I (co A2 B2 cconcat)) (cif (wbr I (cfv A2 chash) clt) (cfv I A2) (cfv (co I (cfv A2 chash) cmin) B2))) $;

--| The first symbol of a concatenation of two words is the first symbol of the first word if the first word is not empty. (Contributed by Alexander van der Vekens, 22-Sep-2018.)
theorem ccatfv0 (A2 B2 V: class):
  $ wi (w3a (wcel A2 (cword V)) (wcel B2 (cword V)) (wbr cc0 (cfv A2 chash) clt)) (wceq (cfv cc0 (co A2 B2 cconcat)) (cfv cc0 A2)) $;

--| The last symbol of the left (nonempty) half of a concatenated word. (Contributed by Alexander van der Vekens, 3-Oct-2018.) (Proof shortened by AV, 1-May-2020.)
theorem ccatval1lsw (A2 B2 V: class):
  $ wi (w3a (wcel A2 (cword V)) (wcel B2 (cword V)) (wne A2 c0)) (wceq (cfv (co (cfv A2 chash) c1 cmin) (co A2 B2 cconcat)) (cfv A2 clsw)) $;

--| The first symbol of the right (nonempty) half of a concatenated word. (Contributed by AV, 23-Apr-2022.)
theorem ccatval21sw (A2 B2 V: class):
  $ wi (w3a (wcel A2 (cword V)) (wcel B2 (cword V)) (wne B2 c0)) (wceq (cfv (cfv A2 chash) (co A2 B2 cconcat)) (cfv cc0 B2)) $;

--| Concatenation of a word by the empty word on the left. (Contributed by Stefan O'Rear, 15-Aug-2015.) (Proof shortened by AV, 1-May-2020.)
theorem ccatlid (B2 S: class):
  $ wi (wcel S (cword B2)) (wceq (co c0 S cconcat) S) $;

--| Concatenation of a word by the empty word on the right. (Contributed by Stefan O'Rear, 15-Aug-2015.) (Proof shortened by AV, 1-May-2020.)
theorem ccatrid (B2 S: class):
  $ wi (wcel S (cword B2)) (wceq (co S c0 cconcat) S) $;

--| Associative law for concatenation of words. (Contributed by Stefan O'Rear, 15-Aug-2015.)
theorem ccatass (B2 S T U: class):
  $ wi (w3a (wcel S (cword B2)) (wcel T (cword B2)) (wcel U (cword B2))) (wceq (co (co S T cconcat) U cconcat) (co S (co T U cconcat) cconcat)) $;

--| The range of a concatenated word. (Contributed by Stefan O'Rear, 15-Aug-2015.)
theorem ccatrn (B2 S T: class):
  $ wi (wa (wcel S (cword B2)) (wcel T (cword B2))) (wceq (crn (co S T cconcat)) (cun (crn S) (crn T))) $;

--| Conditions for a concatenation to be injective. (Contributed by Thierry Arnoux, 11-Dec-2023.)
theorem ccatf1 (ph: wff) (A2 B2 S V: class):
  $ wi ph (wcel S V) $ >
  $ wi ph (wcel A2 (cword S)) $ >
  $ wi ph (wcel B2 (cword S)) $ >
  $ wi ph (wf1 (cdm A2) S A2) $ >
  $ wi ph (wf1 (cdm B2) S B2) $ >
  $ wi ph (wceq (cin (crn A2) (crn B2)) c0) $ >
  $ wi ph (wf1 (cdm (co A2 B2 cconcat)) S (co A2 B2 cconcat)) $;

--| Concatenation of the empty word by the empty word. (Contributed by AV, 26-Mar-2022.)
theorem ccatidid:
  $ wceq (co c0 c0 cconcat) c0 $;

--| The last symbol of a word concatenated with a nonempty word is the last symbol of the nonempty word. (Contributed by AV, 22-Oct-2018.) (Proof shortened by AV, 1-May-2020.)
theorem lswccatn0lsw (A2 B2 V: class):
  $ wi (w3a (wcel A2 (cword V)) (wcel B2 (cword V)) (wne B2 c0)) (wceq (cfv (co A2 B2 cconcat) clsw) (cfv B2 clsw)) $;

--| The last symbol of a word concatenated with the empty word is the last symbol of the word. (Contributed by AV, 22-Oct-2018.) (Proof shortened by AV, 1-May-2020.)
theorem lswccat0lsw (V W: class):
  $ wi (wcel W (cword V)) (wceq (cfv (co W c0 cconcat) clsw) (cfv W clsw)) $;

--| A concatenation of two arbitrary words is a word over an alphabet iff the symbols of both words belong to the alphabet. (Contributed by AV, 28-Feb-2021.)
theorem ccatalpha (A2 B2 S: class):
  $ wi (wa (wcel A2 (cword cvv)) (wcel B2 (cword cvv))) (wb (wcel (co A2 B2 cconcat) (cword S)) (wa (wcel A2 (cword S)) (wcel B2 (cword S)))) $;

--| Reverse closure of a concatenation: If the concatenation of two arbitrary words is a word over an alphabet then the symbols of the first word belong to the alphabet. (Contributed by AV, 3-Mar-2021.)
theorem ccatrcl1 (A2 B2 S W X Y: class):
  $ wi (w3a (wcel A2 (cword X)) (wcel B2 (cword Y)) (wa (wceq W (co A2 B2 cconcat)) (wcel W (cword S)))) (wcel A2 (cword S)) $;

--| Syntax for the singleton word constructor.
term cs1 (A2: class): class;

--| Define the canonical injection from symbols to words. Although not required, ` A ` should usually be a set. Otherwise, the singleton word ` <" A "> ` would be the singleton word consisting of the empty set, see ~ s1prc , and not, as maybe expected, the empty word, see also ~ s1nz . (Contributed by Stefan O'Rear, 15-Aug-2015.) (Revised by Mario Carneiro, 26-Feb-2016.)
axiom df_s1 (A2: class):
  $ wceq (cs1 A2) (csn (cop cc0 (cfv A2 cid))) $;

--| Identity function protection for a singleton word. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem ids1 (A2: class):
  $ wceq (cs1 A2) (cs1 (cfv A2 cid)) $;

--| Value of a singleton word. (Contributed by Stefan O'Rear, 15-Aug-2015.) (Revised by Mario Carneiro, 26-Feb-2016.)
theorem s1val (A2 V: class):
  $ wi (wcel A2 V) (wceq (cs1 A2) (csn (cop cc0 A2))) $;

--| The range of a singleton word. (Contributed by Mario Carneiro, 18-Jul-2016.)
theorem s1rn (A2 V: class):
  $ wi (wcel A2 V) (wceq (crn (cs1 A2)) (csn A2)) $;

--| Equality theorem for a singleton word. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem s1eq (A2 B2: class):
  $ wi (wceq A2 B2) (wceq (cs1 A2) (cs1 B2)) $;

--| Equality theorem for a singleton word. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem s1eqd (ph: wff) (A2 B2: class):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cs1 A2) (cs1 B2)) $;

--| A singleton word is a word. (Contributed by Stefan O'Rear, 15-Aug-2015.) (Revised by Mario Carneiro, 26-Feb-2016.) (Proof shortened by AV, 23-Nov-2018.)
theorem s1cl (A2 B2: class):
  $ wi (wcel A2 B2) (wcel (cs1 A2) (cword B2)) $;

--| A singleton word is a word. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem s1cld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 B2) $ >
  $ wi ph (wcel (cs1 A2) (cword B2)) $;

--| Value of a singleton word if the symbol is a proper class. (Contributed by AV, 26-Mar-2022.)
theorem s1prc (A2: class):
  $ wi (wn (wcel A2 cvv)) (wceq (cs1 A2) (cs1 c0)) $;

--| A singleton word is a word. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem s1cli (A2: class):
  $ wcel (cs1 A2) (cword cvv) $;

--| Length of a singleton word. (Contributed by Stefan O'Rear, 15-Aug-2015.) (Revised by Mario Carneiro, 26-Feb-2016.)
theorem s1len (A2: class):
  $ wceq (cfv (cs1 A2) chash) c1 $;

--| A singleton word is not the empty string. (Contributed by Mario Carneiro, 27-Feb-2016.) (Proof shortened by Kyle Wyonch, 18-Jul-2021.)
theorem s1nz (A2: class):
  $ wne (cs1 A2) c0 $;

--| The domain of a singleton word is a singleton. (Contributed by AV, 9-Jan-2020.)
theorem s1dm (A2: class):
  $ wceq (cdm (cs1 A2)) (csn cc0) $;

--| A singleton word is a function on the singleton ` { 0 } ` . See also ~ s2mapd . (Contributed by Thierry Arnoux, 10-Oct-2026.)
theorem s1mapd (ph: wff) (S V X: class):
  $ wi ph (wcel S V) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wcel (cs1 X) (co S (csn cc0) cmap)) $;

--| Conditions for a length 1 string to be a one-to-one function. (Contributed by Thierry Arnoux, 11-Dec-2023.)
theorem s1f1 (ph: wff) (D I: class):
  $ wi ph (wcel I D) $ >
  $ wi ph (wf1 (cdm (cs1 I)) D (cs1 I)) $;

--| Alternate version of ~ s1dm , having a shorter proof, but requiring that ` A ` is a set. (Contributed by AV, 9-Jan-2020.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem s1dmALT (A2 S: class):
  $ wi (wcel A2 S) (wceq (cdm (cs1 A2)) (csn cc0)) $;

--| Sole symbol of a singleton word. (Contributed by Stefan O'Rear, 15-Aug-2015.) (Revised by Mario Carneiro, 26-Feb-2016.)
theorem s1fv (A2 B2: class):
  $ wi (wcel A2 B2) (wceq (cfv cc0 (cs1 A2)) A2) $;

--| The last symbol of a singleton word is its symbol. (Contributed by AV, 22-Oct-2018.)
theorem lsws1 (A2 V: class):
  $ wi (wcel A2 V) (wceq (cfv (cs1 A2) clsw) A2) $;

--| A word of length 1 is a singleton word. (Contributed by Stefan O'Rear, 23-Aug-2015.) (Proof shortened by AV, 1-May-2020.)
theorem eqs1 (A2 W: class):
  $ wi (wa (wcel W (cword A2)) (wceq (cfv W chash) c1)) (wceq W (cs1 (cfv cc0 W))) $;

--| A word of length 1 is a singleton word. (Contributed by AV, 24-Jan-2021.)
theorem wrdl1exs1 {s1: setvar} (S W: class):
  $ wi (wa (wcel W (cword S)) (wceq (cfv W chash) c1)) (wrex s1 (wceq W (cs1 (cv s1))) S) $;

--| A word of length 1 is a singleton word consisting of the first symbol of the word. (Contributed by AV, 22-Jul-2018.) (Proof shortened by AV, 14-Oct-2018.)
theorem wrdl1s1 (S V W: class):
  $ wi (wcel S V) (wb (wceq W (cs1 S)) (w3a (wcel W (cword V)) (wceq (cfv W chash) c1) (wceq (cfv cc0 W) S))) $;

--| The singleton word function is injective. (Contributed by Mario Carneiro, 1-Oct-2015.) (Revised by Mario Carneiro, 26-Feb-2016.)
theorem s111 (A2 S T: class):
  $ wi (wa (wcel S A2) (wcel T A2)) (wb (wceq (cs1 S) (cs1 T)) (wceq S T)) $;

--| The concatenation of a word with a singleton word is a word. (Contributed by Alexander van der Vekens, 22-Sep-2018.)
theorem ccatws1cl (V W X: class):
  $ wi (wa (wcel W (cword V)) (wcel X V)) (wcel (co W (cs1 X) cconcat) (cword V)) $;

--| The concatenation of a word with a singleton word (which can be over a different alphabet) is a word. (Contributed by AV, 5-Mar-2022.)
theorem ccatws1clv (V W X: class):
  $ wi (wcel W (cword V)) (wcel (co W (cs1 X) cconcat) (cword cvv)) $;

--| The concatenation of two singleton words is a word. (Contributed by Alexander van der Vekens, 22-Sep-2018.)
theorem ccat2s1cl (V X Y: class):
  $ wi (wa (wcel X V) (wcel Y V)) (wcel (co (cs1 X) (cs1 Y) cconcat) (cword V)) $;

--| A concatenation of a word with a singleton word is a word over an alphabet ` S ` iff the symbols of both words belong to the alphabet ` S ` . (Contributed by AV, 27-Mar-2022.)
theorem ccats1alpha (A2 S U V X: class):
  $ wi (wa (wcel A2 (cword V)) (wcel X U)) (wb (wcel (co A2 (cs1 X) cconcat) (cword S)) (wa (wcel A2 (cword S)) (wcel X S))) $;

--| The length of the concatenation of a word with a singleton word. (Contributed by Alexander van der Vekens, 22-Sep-2018.) (Revised by AV, 4-Mar-2022.)
theorem ccatws1len (V W X: class):
  $ wi (wcel W (cword V)) (wceq (cfv (co W (cs1 X) cconcat) chash) (co (cfv W chash) c1 caddc)) $;

--| The length of a word is ` N ` iff the length of the concatenation of the word with a singleton word is ` N + 1 ` . (Contributed by AV, 4-Mar-2022.)
theorem ccatws1lenp1b (N V W X: class):
  $ wi (wa (wcel W (cword V)) (wcel N cn0)) (wb (wceq (cfv (co W (cs1 X) cconcat) chash) (co N c1 caddc)) (wceq (cfv W chash) N)) $;

--| The length of a word is the length of the word concatenated with a singleton word minus 1. (Contributed by AV, 28-Jun-2018.) (Revised by AV, 5-Mar-2022.)
theorem wrdlenccats1lenm1 (S V W: class):
  $ wi (wcel W (cword V)) (wceq (co (cfv (co W (cs1 S) cconcat) chash) c1 cmin) (cfv W chash)) $;

--| The length of the concatenation of two singleton words. (Contributed by Alexander van der Vekens, 22-Sep-2018.) (Revised by JJ, 14-Jan-2024.)
theorem ccat2s1len (X Y: class):
  $ wceq (cfv (co (cs1 X) (cs1 Y) cconcat) chash) c2 $;

--| The concatenation of a word with two singleton words is a word. (Contributed by Alexander van der Vekens, 22-Sep-2018.)
theorem ccatw2s1cl (V W X Y: class):
  $ wi (w3a (wcel W (cword V)) (wcel X V) (wcel Y V)) (wcel (co (co W (cs1 X) cconcat) (cs1 Y) cconcat) (cword V)) $;

--| The length of the concatenation of a word with two singleton words. (Contributed by Alexander van der Vekens, 22-Sep-2018.) (Revised by AV, 5-Mar-2022.)
theorem ccatw2s1len (V W X Y: class):
  $ wi (wcel W (cword V)) (wceq (cfv (co (co W (cs1 X) cconcat) (cs1 Y) cconcat) chash) (co (cfv W chash) c2 caddc)) $;

--| Value of a symbol in the left half of a word concatenated with a single symbol. (Contributed by Alexander van der Vekens, 5-Aug-2018.) (Revised by JJ, 20-Jan-2024.)
theorem ccats1val1 (S I V W: class):
  $ wi (wa (wcel W (cword V)) (wcel I (co cc0 (cfv W chash) cfzo))) (wceq (cfv I (co W (cs1 S) cconcat)) (cfv I W)) $;

--| Value of the symbol concatenated with a word. (Contributed by Alexander van der Vekens, 5-Aug-2018.) (Proof shortened by Alexander van der Vekens, 14-Oct-2018.)
theorem ccats1val2 (S I V W: class):
  $ wi (w3a (wcel W (cword V)) (wcel S V) (wceq I (cfv W chash))) (wceq (cfv I (co W (cs1 S) cconcat)) S) $;

--| The first symbol of a word concatenated with its first symbol is the first symbol of the word. This theorem holds even if ` W ` is the empty word. (Contributed by AV, 26-Mar-2022.)
theorem ccat1st1st (V W: class):
  $ wi (wcel W (cword V)) (wceq (cfv cc0 (co W (cs1 (cfv cc0 W)) cconcat)) (cfv cc0 W)) $;

--| Extract the first of two concatenated singleton words. (Contributed by Alexander van der Vekens, 22-Sep-2018.) (Revised by JJ, 20-Jan-2024.)
theorem ccat2s1p1 (V X Y: class):
  $ wi (wcel X V) (wceq (cfv cc0 (co (cs1 X) (cs1 Y) cconcat)) X) $;

--| Extract the second of two concatenated singleton words. (Contributed by Alexander van der Vekens, 22-Sep-2018.) (Revised by JJ, 20-Jan-2024.)
theorem ccat2s1p2 (V X Y: class):
  $ wi (wcel Y V) (wceq (cfv c1 (co (cs1 X) (cs1 Y) cconcat)) Y) $;

--| Associative law for a concatenation of a word with two singleton words. (Contributed by Alexander van der Vekens, 22-Sep-2018.)
theorem ccatw2s1ass (V W X Y: class):
  $ wi (wcel W (cword V)) (wceq (co (co W (cs1 X) cconcat) (cs1 Y) cconcat) (co W (co (cs1 X) (cs1 Y) cconcat) cconcat)) $;

--| The concatenation of a word with a singleton word is not the empty set. (Contributed by Alexander van der Vekens, 29-Sep-2018.) (Revised by AV, 5-Mar-2022.)
theorem ccatws1n0 (V W X: class):
  $ wi (wcel W (cword V)) (wne (co W (cs1 X) cconcat) c0) $;

--| The last symbol of the concatenation of a word with a singleton word is the symbol of the singleton word. (Contributed by AV, 29-Sep-2018.) (Proof shortened by AV, 14-Oct-2018.)
theorem ccatws1ls (V W X: class):
  $ wi (wa (wcel W (cword V)) (wcel X V)) (wceq (cfv (cfv W chash) (co W (cs1 X) cconcat)) X) $;

--| The last symbol of a word concatenated with a singleton word is the symbol of the singleton word. (Contributed by AV, 6-Aug-2018.) (Proof shortened by AV, 22-Oct-2018.)
theorem lswccats1 (S V W: class):
  $ wi (wa (wcel W (cword V)) (wcel S V)) (wceq (cfv (co W (cs1 S) cconcat) clsw) S) $;

--| The last symbol of a nonempty word concatenated with its first symbol is the first symbol. (Contributed by AV, 28-Jun-2018.) (Proof shortened by AV, 1-May-2020.)
theorem lswccats1fst (P V: class):
  $ wi (wa (wcel P (cword V)) (wbr c1 (cfv P chash) cle)) (wceq (cfv (co P (cs1 (cfv cc0 P)) cconcat) clsw) (cfv cc0 (co P (cs1 (cfv cc0 P)) cconcat))) $;

--| Extract the symbol of the first singleton word of a word concatenated with this singleton word and another singleton word. (Contributed by Alexander van der Vekens, 22-Sep-2018.) (Proof shortened by AV, 1-May-2020.) (Revised by AV, 1-May-2020.) (Revised by AV, 29-Jan-2024.)
theorem ccatw2s1p1 (N V W X Y: class):
  $ wi (w3a (wcel W (cword V)) (wceq (cfv W chash) N) (wcel X V)) (wceq (cfv N (co (co W (cs1 X) cconcat) (cs1 Y) cconcat)) X) $;

--| Extract the second of two single symbols concatenated with a word. (Contributed by Alexander van der Vekens, 22-Sep-2018.) (Proof shortened by AV, 1-May-2020.)
theorem ccatw2s1p2 (N V W X Y: class):
  $ wi (wa (wa (wcel W (cword V)) (wceq (cfv W chash) N)) (wa (wcel X V) (wcel Y V))) (wceq (cfv (co N c1 caddc) (co (co W (cs1 X) cconcat) (cs1 Y) cconcat)) Y) $;

--| Extract a symbol of a word from the concatenation of the word with two single symbols. (Contributed by AV, 22-Sep-2018.) (Revised by AV, 13-Jan-2020.) (Proof shortened by AV, 1-May-2020.) (Revised by AV, 28-Jan-2024.)
theorem ccat2s1fvw (I V W X Y: class):
  $ wi (w3a (wcel W (cword V)) (wcel I cn0) (wbr I (cfv W chash) clt)) (wceq (cfv I (co (co W (cs1 X) cconcat) (cs1 Y) cconcat)) (cfv I W)) $;

--| The first symbol of the concatenation of a word with two single symbols. (Contributed by Alexander van der Vekens, 22-Sep-2018.) (Revised by AV, 28-Jan-2024.)
theorem ccat2s1fst (V W X Y: class):
  $ wi (wa (wcel W (cword V)) (wbr cc0 (cfv W chash) clt)) (wceq (cfv cc0 (co (co W (cs1 X) cconcat) (cs1 Y) cconcat)) (cfv cc0 W)) $;

--| Syntax for the subword operator.
term csubstr: class;

--| Define an operation which extracts portions (called _subwords_ or _substrings_) of words. Definition in Section 9.1 of [AhoHopUll] p. 318. (Contributed by Stefan O'Rear, 15-Aug-2015.)
axiom df_substr {x3 s1 b: setvar}:
  $ wceq csubstr (cmpo s1 b cvv (cxp cz cz) (cif (wss (co (cfv (cv b) c1st) (cfv (cv b) c2nd) cfzo) (cdm (cv s1))) (cmpt x3 (co cc0 (co (cfv (cv b) c2nd) (cfv (cv b) c1st) cmin) cfzo) (cfv (co (cv x3) (cfv (cv b) c1st) caddc) (cv s1))) c0)) $;

--| The value of a subword operation for noninteger arguments is the empty set. (This is due to our definition of function values for out-of-domain arguments, see ~ ndmfv ). (Contributed by AV, 2-Dec-2022.) (New usage is discouraged.)
theorem swrdnznd (S F L: class):
  $ wi (wn (wa (wcel F cz) (wcel L cz))) (wceq (co S (cop F L) csubstr) c0) $;

--| Value of a subword. (Contributed by Stefan O'Rear, 15-Aug-2015.)
theorem swrdval {x3: setvar} (S F L V: class):
  $ wi (w3a (wcel S V) (wcel F cz) (wcel L cz)) (wceq (co S (cop F L) csubstr) (cif (wss (co F L cfzo) (cdm S)) (cmpt x3 (co cc0 (co L F cmin) cfzo) (cfv (co (cv x3) F caddc) S)) c0)) $;

--| A zero length substring. (Contributed by Stefan O'Rear, 27-Aug-2015.)
theorem swrd00 (S X: class):
  $ wceq (co S (cop X X) csubstr) c0 $;

--| Closure of the subword extractor. (Contributed by Stefan O'Rear, 16-Aug-2015.) (Revised by Mario Carneiro, 26-Feb-2016.)
theorem swrdcl (A2 S F L: class):
  $ wi (wcel S (cword A2)) (wcel (co S (cop F L) csubstr) (cword A2)) $;

--| Value of the subword extractor in its intended domain. (Contributed by Stefan O'Rear, 15-Aug-2015.) (Proof shortened by AV, 2-May-2020.)
theorem swrdval2 {x3: setvar} (A2 S F L: class):
  $ wi (w3a (wcel S (cword A2)) (wcel F (co cc0 L cfz)) (wcel L (co cc0 (cfv S chash) cfz))) (wceq (co S (cop F L) csubstr) (cmpt x3 (co cc0 (co L F cmin) cfzo) (cfv (co (cv x3) F caddc) S))) $;

--| Length of an extracted subword. (Contributed by Stefan O'Rear, 16-Aug-2015.)
theorem swrdlen (A2 S F L: class):
  $ wi (w3a (wcel S (cword A2)) (wcel F (co cc0 L cfz)) (wcel L (co cc0 (cfv S chash) cfz))) (wceq (cfv (co S (cop F L) csubstr) chash) (co L F cmin)) $;

--| A symbol in an extracted subword, indexed using the subword's indices. (Contributed by Stefan O'Rear, 16-Aug-2015.)
theorem swrdfv (A2 S F L X: class):
  $ wi (wa (w3a (wcel S (cword A2)) (wcel F (co cc0 L cfz)) (wcel L (co cc0 (cfv S chash) cfz))) (wcel X (co cc0 (co L F cmin) cfzo))) (wceq (cfv X (co S (cop F L) csubstr)) (cfv (co X F caddc) S)) $;

--| The first symbol in an extracted subword. (Contributed by AV, 27-Apr-2022.)
theorem swrdfv0 (A2 S F L: class):
  $ wi (w3a (wcel S (cword A2)) (wcel F (co cc0 L cfzo)) (wcel L (co cc0 (cfv S chash) cfz))) (wceq (cfv cc0 (co S (cop F L) csubstr)) (cfv F S)) $;

--| A subword of a word is a function from a half-open range of nonnegative integers of the same length as the subword to the set of symbols for the original word. (Contributed by AV, 13-Nov-2018.)
theorem swrdf (M N V W: class):
  $ wi (w3a (wcel W (cword V)) (wcel M (co cc0 N cfz)) (wcel N (co cc0 (cfv W chash) cfz))) (wf (co cc0 (co N M cmin) cfzo) V (co W (cop M N) csubstr)) $;

--| Condition for a subword to be injective. (Contributed by Thierry Arnoux, 12-Dec-2023.)
theorem swrdf1 (ph: wff) (D M N W: class):
  $ wi ph (wcel W (cword D)) $ >
  $ wi ph (wcel M (co cc0 N cfz)) $ >
  $ wi ph (wcel N (co cc0 (cfv W chash) cfz)) $ >
  $ wi ph (wf1 (cdm W) D W) $ >
  $ wi ph (wf1 (cdm (co W (cop M N) csubstr)) D (co W (cop M N) csubstr)) $;

--| Value of the subword extractor as function with domain. (Contributed by Alexander van der Vekens, 28-Mar-2018.) (Proof shortened by AV, 2-May-2020.)
theorem swrdvalfn (S F L V: class):
  $ wi (w3a (wcel S (cword V)) (wcel F (co cc0 L cfz)) (wcel L (co cc0 (cfv S chash) cfz))) (wfn (co S (cop F L) csubstr) (co cc0 (co L F cmin) cfzo)) $;

--| The range of a subword of a word is a subset of the set of symbols for the word. (Contributed by AV, 13-Nov-2018.)
theorem swrdrn (M N V W: class):
  $ wi (w3a (wcel W (cword V)) (wcel M (co cc0 N cfz)) (wcel N (co cc0 (cfv W chash) cfz))) (wss (crn (co W (cop M N) csubstr)) V) $;

--| Express the range of a subword. Stronger version of ~ swrdrn2 . (Contributed by Thierry Arnoux, 13-Dec-2023.)
theorem swrdrn3 (M N V W: class):
  $ wi (w3a (wcel W (cword V)) (wcel M (co cc0 N cfz)) (wcel N (co cc0 (cfv W chash) cfz))) (wceq (crn (co W (cop M N) csubstr)) (cima W (co M N cfzo))) $;

--| The value of the subword extractor is the empty set (undefined) if the range is not valid. (Contributed by Alexander van der Vekens, 16-Mar-2018.) (Proof shortened by AV, 2-May-2020.)
theorem swrdlend (F L V W: class):
  $ wi (w3a (wcel W (cword V)) (wcel F cz) (wcel L cz)) (wi (wbr L F cle) (wceq (co W (cop F L) csubstr) c0)) $;

--| The value of the subword extractor is the empty set (undefined) if the range is not valid. (Contributed by Alexander van der Vekens, 16-Mar-2018.) (Proof shortened by AV, 2-May-2020.)
theorem swrdnd (F L V W: class):
  $ wi (w3a (wcel W (cword V)) (wcel F cz) (wcel L cz)) (wi (w3o (wbr F cc0 clt) (wbr L F cle) (wbr (cfv W chash) L clt)) (wceq (co W (cop F L) csubstr) c0)) $;

--| Value of the subword extractor outside its intended domain. (Contributed by Alexander van der Vekens, 24-May-2018.)
theorem swrdnd2 (A2 B2 V W: class):
  $ wi (w3a (wcel W (cword V)) (wcel A2 cz) (wcel B2 cz)) (wi (w3o (wbr B2 A2 cle) (wbr (cfv W chash) A2 cle) (wbr B2 cc0 cle)) (wceq (co W (cop A2 B2) csubstr) c0)) $;

--| The value of a subword operation for arguments not being nonnegative integers is the empty set. (Contributed by AV, 2-Dec-2022.)
theorem swrdnnn0nd (S F L V: class):
  $ wi (wa (wcel S (cword V)) (wn (wa (wcel F cn0) (wcel L cn0)))) (wceq (co S (cop F L) csubstr) c0) $;

--| The value of a subword operation for inproper arguments is the empty set. (Contributed by AV, 2-Dec-2022.)
theorem swrdnd0 (S F L V: class):
  $ wi (wcel S (cword V)) (wi (wn (wa (wcel F (co cc0 L cfz)) (wcel L (co cc0 (cfv S chash) cfz)))) (wceq (co S (cop F L) csubstr) c0)) $;

--| A subword of an empty set is always the empty set. (Contributed by AV, 31-Mar-2018.) (Revised by AV, 20-Oct-2018.) (Proof shortened by AV, 2-May-2020.)
theorem swrd0 (F L: class):
  $ wceq (co c0 (cop F L) csubstr) c0 $;

--| Length of a right-anchored subword. (Contributed by Alexander van der Vekens, 5-Apr-2018.)
theorem swrdrlen (I V W: class):
  $ wi (wa (wcel W (cword V)) (wcel I (co cc0 (cfv W chash) cfz))) (wceq (cfv (co W (cop I (cfv W chash)) csubstr) chash) (co (cfv W chash) I cmin)) $;

--| Length of an extracted subword. (Contributed by AV, 5-May-2020.)
theorem swrdlen2 (S F L V: class):
  $ wi (w3a (wcel S (cword V)) (wa (wcel F cn0) (wcel L (cfv F cuz))) (wbr L (cfv S chash) cle)) (wceq (cfv (co S (cop F L) csubstr) chash) (co L F cmin)) $;

--| A symbol in an extracted subword, indexed using the word's indices. (Contributed by AV, 5-May-2020.)
theorem swrdfv2 (S F L V X: class):
  $ wi (wa (w3a (wcel S (cword V)) (wa (wcel F cn0) (wcel L (cfv F cuz))) (wbr L (cfv S chash) cle)) (wcel X (co F L cfzo))) (wceq (cfv (co X F cmin) (co S (cop F L) csubstr)) (cfv X S)) $;

--| A subword is a word over the symbols it consists of. (Contributed by AV, 2-Dec-2022.)
theorem swrdwrdsymb (A2 S M N: class):
  $ wi (wcel S (cword A2)) (wcel (co S (cop M N) csubstr) (cword (cima S (co M N cfzo)))) $;

--| Two subwords with the same bounds are equal if the range is not valid. (Contributed by AV, 4-May-2020.)
theorem swrdsb0eq (U M N V W: class):
  $ wi (w3a (wa (wcel W (cword V)) (wcel U (cword V))) (wa (wcel M cn0) (wcel N cn0)) (wbr N M cle)) (wceq (co W (cop M N) csubstr) (co U (cop M N) csubstr)) $;

--| Two subwords with the same bounds have the same length. (Contributed by AV, 4-May-2020.)
theorem swrdsbslen (U M N V W: class):
  $ wi (w3a (wa (wcel W (cword V)) (wcel U (cword V))) (wa (wcel M cn0) (wcel N cn0)) (wa (wbr N (cfv W chash) cle) (wbr N (cfv U chash) cle))) (wceq (cfv (co W (cop M N) csubstr) chash) (cfv (co U (cop M N) csubstr) chash)) $;

--| Two words have a common subword (starting at the same position with the same length) iff they have the same symbols at each position. (Contributed by Alexander van der Vekens, 7-Aug-2018.) (Proof shortened by AV, 7-May-2020.)
theorem swrdspsleq {i: setvar} (U M N V W: class):
  $ wi (w3a (wa (wcel W (cword V)) (wcel U (cword V))) (wa (wcel M cn0) (wcel N cn0)) (wa (wbr N (cfv W chash) cle) (wbr N (cfv U chash) cle))) (wb (wceq (co W (cop M N) csubstr) (co U (cop M N) csubstr)) (wral i (wceq (cfv (cv i) W) (cfv (cv i) U)) (co M N cfzo))) $;

--| Extract a single symbol from a word. (Contributed by Stefan O'Rear, 23-Aug-2015.)
theorem swrds1 (A2 I W: class):
  $ wi (wa (wcel W (cword A2)) (wcel I (co cc0 (cfv W chash) cfzo))) (wceq (co W (cop I (co I c1 caddc)) csubstr) (cs1 (cfv I W))) $;

--| Extract the last single symbol from a word. (Contributed by Alexander van der Vekens, 23-Sep-2018.)
theorem swrdlsw (V W: class):
  $ wi (wa (wcel W (cword V)) (wne W c0)) (wceq (co W (cop (co (cfv W chash) c1 cmin) (cfv W chash)) csubstr) (cs1 (cfv W clsw))) $;

--| Joining two adjacent subwords makes a longer subword. (Contributed by Stefan O'Rear, 20-Aug-2015.)
theorem ccatswrd (A2 S X Y Z: class):
  $ wi (wa (wcel S (cword A2)) (w3a (wcel X (co cc0 Y cfz)) (wcel Y (co cc0 Z cfz)) (wcel Z (co cc0 (cfv S chash) cfz)))) (wceq (co (co S (cop X Y) csubstr) (co S (cop Y Z) csubstr) cconcat) (co S (cop X Z) csubstr)) $;

--| Recover the right half of a concatenated word. (Contributed by Mario Carneiro, 27-Sep-2015.)
theorem swrdccat2 (B2 S T: class):
  $ wi (wa (wcel S (cword B2)) (wcel T (cword B2))) (wceq (co (co S T cconcat) (cop (cfv S chash) (co (cfv S chash) (cfv T chash) caddc)) csubstr) T) $;

--| Syntax for the prefix operator.
term cpfx: class;

--| Define an operation which extracts prefixes of words, i.e. subwords (or substrings) starting at the beginning of a word (or string). In other words, ` ( S prefix L ) ` is the prefix of the word ` S ` of length ` L ` . Definition in Section 9.1 of [AhoHopUll] p. 318. See also Wikipedia "Substring" ~ https://en.wikipedia.org/wiki/Substring#Prefix . (Contributed by AV, 2-May-2020.)
axiom df_pfx {s1 l: setvar}:
  $ wceq cpfx (cmpo s1 l cvv cn0 (co (cv s1) (cop cc0 (cv l)) csubstr)) $;

--| The value of a prefix operation for out-of-domain arguments. (This is due to our definition of function values for out-of-domain arguments, see ~ ndmfv ). (Contributed by AV, 3-Dec-2022.) (New usage is discouraged.)
theorem pfxnndmnd (S L: class):
  $ wi (wn (wa (wcel S cvv) (wcel L cn0))) (wceq (co S L cpfx) c0) $;

--| Value of a prefix operation. (Contributed by AV, 2-May-2020.)
theorem pfxval (S L V: class):
  $ wi (wa (wcel S V) (wcel L cn0)) (wceq (co S L cpfx) (co S (cop cc0 L) csubstr)) $;

--| The zero length prefix is the empty set. (Contributed by AV, 2-May-2020.)
theorem pfx00 (S: class):
  $ wceq (co S cc0 cpfx) c0 $;

--| A prefix of an empty set is always the empty set. (Contributed by AV, 3-May-2020.)
theorem pfx0 (L: class):
  $ wceq (co c0 L cpfx) c0 $;

--| Value of a prefix operation. This theorem should only be used in proofs if ` L e. NN0 ` is not available. Otherwise (and usually), ~ pfxval should be used. (Contributed by AV, 3-Dec-2022.) (New usage is discouraged.)
theorem pfxval0 (A2 S L: class):
  $ wi (wcel S (cword A2)) (wceq (co S L cpfx) (co S (cop cc0 L) csubstr)) $;

--| Closure of the prefix extractor. (Contributed by AV, 2-May-2020.)
theorem pfxcl (A2 S L: class):
  $ wi (wcel S (cword A2)) (wcel (co S L cpfx) (cword A2)) $;

--| Value of the prefix extractor as a mapping. (Contributed by AV, 2-May-2020.)
theorem pfxmpt {x3: setvar} (A2 S L: class):
  $ wi (wa (wcel S (cword A2)) (wcel L (co cc0 (cfv S chash) cfz))) (wceq (co S L cpfx) (cmpt x3 (co cc0 L cfzo) (cfv (cv x3) S))) $;

--| Value of the prefix extractor as the restriction of a word. (Contributed by Stefan O'Rear, 24-Aug-2015.) (Revised by AV, 2-May-2020.)
theorem pfxres (A2 S L: class):
  $ wi (wa (wcel S (cword A2)) (wcel L (co cc0 (cfv S chash) cfz))) (wceq (co S L cpfx) (cres S (co cc0 L cfzo))) $;

--| A prefix of a word is a function from a half-open range of nonnegative integers of the same length as the prefix to the set of symbols for the original word. (Contributed by AV, 2-May-2020.)
theorem pfxf (L V W: class):
  $ wi (wa (wcel W (cword V)) (wcel L (co cc0 (cfv W chash) cfz))) (wf (co cc0 L cfzo) V (co W L cpfx)) $;

--| Value of the prefix extractor as function with domain. (Contributed by AV, 2-May-2020.)
theorem pfxfn (S L V: class):
  $ wi (wa (wcel S (cword V)) (wcel L (co cc0 (cfv S chash) cfz))) (wfn (co S L cpfx) (co cc0 L cfzo)) $;

--| A symbol in a prefix of a word, indexed using the prefix' indices. (Contributed by Alexander van der Vekens, 16-Jun-2018.) (Revised by AV, 3-May-2020.)
theorem pfxfv (I L V W: class):
  $ wi (w3a (wcel W (cword V)) (wcel L (co cc0 (cfv W chash) cfz)) (wcel I (co cc0 L cfzo))) (wceq (cfv I (co W L cpfx)) (cfv I W)) $;

--| Length of a prefix. (Contributed by Stefan O'Rear, 24-Aug-2015.) (Revised by AV, 2-May-2020.)
theorem pfxlen (A2 S L: class):
  $ wi (wa (wcel S (cword A2)) (wcel L (co cc0 (cfv S chash) cfz))) (wceq (cfv (co S L cpfx) chash) L) $;

--| A word is a prefix of itself. (Contributed by Stefan O'Rear, 16-Aug-2015.) (Revised by AV, 2-May-2020.)
theorem pfxid (A2 S: class):
  $ wi (wcel S (cword A2)) (wceq (co S (cfv S chash) cpfx) S) $;

--| The range of a prefix of a word is a subset of the set of symbols for the word. (Contributed by AV, 2-May-2020.)
theorem pfxrn (L V W: class):
  $ wi (wa (wcel W (cword V)) (wcel L (co cc0 (cfv W chash) cfz))) (wss (crn (co W L cpfx)) V) $;

--| A prefix consisting of at least one symbol is not empty. (Contributed by Alexander van der Vekens, 4-Aug-2018.) (Revised by AV, 2-May-2020.)
theorem pfxn0 (L V W: class):
  $ wi (w3a (wcel W (cword V)) (wcel L cn) (wbr L (cfv W chash) cle)) (wne (co W L cpfx) c0) $;

--| The value of a prefix operation for a length argument larger than the word length is the empty set. (This is due to our definition of function values for out-of-domain arguments, see ~ ndmfv ). (Contributed by AV, 3-May-2020.)
theorem pfxnd (L V W: class):
  $ wi (w3a (wcel W (cword V)) (wcel L cn0) (wbr (cfv W chash) L clt)) (wceq (co W L cpfx) c0) $;

--| The value of a prefix operation for a length argument not in the range of the word length is the empty set. (This is due to our definition of function values for out-of-domain arguments, see ~ ndmfv ). (Contributed by AV, 3-Dec-2022.)
theorem pfxnd0 (L V W: class):
  $ wi (wa (wcel W (cword V)) (wnel L (co cc0 (cfv W chash) cfz))) (wceq (co W L cpfx) c0) $;

--| A prefix of a word is a word over the symbols it consists of. (Contributed by AV, 3-Dec-2022.)
theorem pfxwrdsymb (A2 S L: class):
  $ wi (wcel S (cword A2)) (wcel (co S L cpfx) (cword (cima S (co cc0 L cfzo)))) $;

--| The sum of the lengths of two parts of a word is the length of the word. (Contributed by AV, 21-Oct-2018.) (Revised by AV, 3-May-2020.)
theorem addlenpfx (M V W: class):
  $ wi (wa (wcel W (cword V)) (wcel M (co cc0 (cfv W chash) cfz))) (wceq (co (cfv (co W M cpfx) chash) (cfv (co W (cop M (cfv W chash)) csubstr) chash) caddc) (cfv W chash)) $;

--| The first symbol of a prefix is the first symbol of the word. (Contributed by Alexander van der Vekens, 16-Jun-2018.) (Revised by AV, 3-May-2020.)
theorem pfxfv0 (L V W: class):
  $ wi (wa (wcel W (cword V)) (wcel L (co c1 (cfv W chash) cfz))) (wceq (cfv cc0 (co W L cpfx)) (cfv cc0 W)) $;

--| A symbol in a word truncated by one symbol. (Contributed by Alexander van der Vekens, 16-Jun-2018.) (Revised by AV, 3-May-2020.)
theorem pfxtrcfv (I V W: class):
  $ wi (w3a (wcel W (cword V)) (wne W c0) (wcel I (co cc0 (co (cfv W chash) c1 cmin) cfzo))) (wceq (cfv I (co W (co (cfv W chash) c1 cmin) cpfx)) (cfv I W)) $;

--| The first symbol in a word truncated by one symbol. (Contributed by Alexander van der Vekens, 16-Jun-2018.) (Revised by AV, 3-May-2020.)
theorem pfxtrcfv0 (V W: class):
  $ wi (wa (wcel W (cword V)) (wbr c2 (cfv W chash) cle)) (wceq (cfv cc0 (co W (co (cfv W chash) c1 cmin) cpfx)) (cfv cc0 W)) $;

--| The last symbol in a nonempty prefix of a word. (Contributed by Alexander van der Vekens, 24-Jun-2018.) (Revised by AV, 3-May-2020.)
theorem pfxfvlsw (L V W: class):
  $ wi (wa (wcel W (cword V)) (wcel L (co c1 (cfv W chash) cfz))) (wceq (cfv (co W L cpfx) clsw) (cfv (co L c1 cmin) W)) $;

--| The prefixes of two words are equal iff they have the same length and the same symbols at each position. (Contributed by Alexander van der Vekens, 7-Aug-2018.) (Revised by AV, 4-May-2020.)
theorem pfxeq {i: setvar} (U M N V W: class):
  $ wi (w3a (wa (wcel W (cword V)) (wcel U (cword V))) (wa (wcel M cn0) (wcel N cn0)) (wa (wbr M (cfv W chash) cle) (wbr N (cfv U chash) cle))) (wb (wceq (co W M cpfx) (co U N cpfx)) (wa (wceq M N) (wral i (wceq (cfv (cv i) W) (cfv (cv i) U)) (co cc0 M cfzo)))) $;

--| The last symbol in a word truncated by one symbol. (Contributed by AV, 16-Jun-2018.) (Revised by AV, 5-May-2020.)
theorem pfxtrcfvl (V W: class):
  $ wi (wa (wcel W (cword V)) (wbr c2 (cfv W chash) cle)) (wceq (cfv (co W (co (cfv W chash) c1 cmin) cpfx) clsw) (cfv (co (cfv W chash) c2 cmin) W)) $;

--| Two words are equal if and only if they have the same prefix and the same suffix. (Contributed by Alexander van der Vekens, 23-Sep-2018.) (Revised by AV, 5-May-2020.)
theorem pfxsuffeqwrdeq (S I V W: class):
  $ wi (w3a (wcel W (cword V)) (wcel S (cword V)) (wcel I (co cc0 (cfv W chash) cfzo))) (wb (wceq W S) (wa (wceq (cfv W chash) (cfv S chash)) (wa (wceq (co W I cpfx) (co S I cpfx)) (wceq (co W (cop I (cfv W chash)) csubstr) (co S (cop I (cfv W chash)) csubstr))))) $;

--| Two (nonempty) words are equal if and only if they have the same prefix and the same single symbol suffix. (Contributed by Alexander van der Vekens, 23-Sep-2018.) (Revised by AV, 6-May-2020.)
theorem pfxsuff1eqwrdeq (U V W: class):
  $ wi (w3a (wcel W (cword V)) (wcel U (cword V)) (wbr cc0 (cfv W chash) clt)) (wb (wceq W U) (wa (wceq (cfv W chash) (cfv U chash)) (wa (wceq (co W (co (cfv W chash) c1 cmin) cpfx) (co U (co (cfv W chash) c1 cmin) cpfx)) (wceq (cfv W clsw) (cfv U clsw))))) $;

--| Sets of words are disjoint if each set contains exactly the extensions of distinct words of a fixed length. Remark: A word ` W ` is called an "extension" of a word ` P ` if ` P ` is a prefix of ` W ` . (Contributed by AV, 29-Jul-2018.) (Revised by AV, 6-May-2020.)
theorem disjwrdpfx {x3 y1: setvar} (N: class x3) (V: class y1) (W: class x3 y1):
  $ wdisj y1 W (crab x3 (wceq (co (cv x3) N cpfx) (cv y1)) (cword V)) $;

--| Concatenating a prefix with an adjacent subword makes a longer prefix. (Contributed by AV, 7-May-2020.)
theorem ccatpfx (A2 S Y Z: class):
  $ wi (w3a (wcel S (cword A2)) (wcel Y (co cc0 Z cfz)) (wcel Z (co cc0 (cfv S chash) cfz))) (wceq (co (co S Y cpfx) (co S (cop Y Z) csubstr) cconcat) (co S Z cpfx)) $;

--| Recover the left half of a concatenated word. (Contributed by Mario Carneiro, 27-Sep-2015.) (Revised by AV, 6-May-2020.)
theorem pfxccat1 (B2 S T: class):
  $ wi (wa (wcel S (cword B2)) (wcel T (cword B2))) (wceq (co (co S T cconcat) (cfv S chash) cpfx) S) $;

--| The prefix of length one of a nonempty word expressed as a singleton word. (Contributed by AV, 15-May-2020.)
theorem pfx1 (V W: class):
  $ wi (wa (wcel W (cword V)) (wne W c0)) (wceq (co W c1 cpfx) (cs1 (cfv cc0 W))) $;

--| Lemma for ~ swrdswrd . (Contributed by Alexander van der Vekens, 4-Apr-2018.)
theorem swrdswrdlem (K L M N V W: class):
  $ wi (wa (w3a (wcel W (cword V)) (wcel N (co cc0 (cfv W chash) cfz)) (wcel M (co cc0 N cfz))) (wa (wcel K (co cc0 (co N M cmin) cfz)) (wcel L (co K (co N M cmin) cfz)))) (w3a (wcel W (cword V)) (wcel (co M K caddc) (co cc0 (co M L caddc) cfz)) (wcel (co M L caddc) (co cc0 (cfv W chash) cfz))) $;

--| A subword of a subword is a subword. (Contributed by Alexander van der Vekens, 4-Apr-2018.)
theorem swrdswrd (K L M N V W: class):
  $ wi (w3a (wcel W (cword V)) (wcel N (co cc0 (cfv W chash) cfz)) (wcel M (co cc0 N cfz))) (wi (wa (wcel K (co cc0 (co N M cmin) cfz)) (wcel L (co K (co N M cmin) cfz))) (wceq (co (co W (cop M N) csubstr) (cop K L) csubstr) (co W (cop (co M K caddc) (co M L caddc)) csubstr))) $;

--| A prefix of a subword is a subword. (Contributed by AV, 2-Apr-2018.) (Revised by AV, 8-May-2020.)
theorem pfxswrd (L M N V W: class):
  $ wi (w3a (wcel W (cword V)) (wcel N (co cc0 (cfv W chash) cfz)) (wcel M (co cc0 N cfz))) (wi (wcel L (co cc0 (co N M cmin) cfz)) (wceq (co (co W (cop M N) csubstr) L cpfx) (co W (cop M (co M L caddc)) csubstr))) $;

--| A subword of a prefix is a subword. (Contributed by Alexander van der Vekens, 6-Apr-2018.) (Revised by AV, 8-May-2020.)
theorem swrdpfx (K L N V W: class):
  $ wi (wa (wcel W (cword V)) (wcel N (co cc0 (cfv W chash) cfz))) (wi (wa (wcel K (co cc0 N cfz)) (wcel L (co K N cfz))) (wceq (co (co W N cpfx) (cop K L) csubstr) (co W (cop K L) csubstr))) $;

--| A prefix of a prefix is a prefix. (Contributed by Alexander van der Vekens, 7-Apr-2018.) (Revised by AV, 8-May-2020.)
theorem pfxpfx (L N V W: class):
  $ wi (w3a (wcel W (cword V)) (wcel N (co cc0 (cfv W chash) cfz)) (wcel L (co cc0 N cfz))) (wceq (co (co W N cpfx) L cpfx) (co W L cpfx)) $;

--| A prefix of a prefix with the same length is the original prefix. In other words, the operation "prefix of length ` N ` " is idempotent. (Contributed by AV, 5-Apr-2018.) (Revised by AV, 8-May-2020.)
theorem pfxpfxid (N V W: class):
  $ wi (wa (wcel W (cword V)) (wcel N (co cc0 (cfv W chash) cfz))) (wceq (co (co W N cpfx) N cpfx) (co W N cpfx)) $;

--| The concatenation of the prefix of a word and the rest of the word yields the word itself. (Contributed by AV, 21-Oct-2018.) (Revised by AV, 9-May-2020.)
theorem pfxcctswrd (M V W: class):
  $ wi (wa (wcel W (cword V)) (wcel M (co cc0 (cfv W chash) cfz))) (wceq (co (co W M cpfx) (co W (cop M (cfv W chash)) csubstr) cconcat) W) $;

--| The length of the concatenation of the prefix of a word and the rest of the word is the length of the word. (Contributed by AV, 21-Oct-2018.) (Revised by AV, 9-May-2020.)
theorem lenpfxcctswrd (M V W: class):
  $ wi (wa (wcel W (cword V)) (wcel M (co cc0 (cfv W chash) cfz))) (wceq (cfv (co (co W M cpfx) (co W (cop M (cfv W chash)) csubstr) cconcat) chash) (cfv W chash)) $;

--| The length of the concatenation of the rest of a word and the prefix of the word is the length of the word. (Contributed by Alexander van der Vekens, 1-Apr-2018.) (Revised by AV, 9-May-2020.)
theorem lenrevpfxcctswrd (M V W: class):
  $ wi (wa (wcel W (cword V)) (wcel M (co cc0 (cfv W chash) cfz))) (wceq (cfv (co (co W (cop M (cfv W chash)) csubstr) (co W M cpfx) cconcat) chash) (cfv W chash)) $;

--| Reconstruct a nonempty word from its prefix and last symbol. (Contributed by Alexander van der Vekens, 5-Aug-2018.) (Revised by AV, 9-May-2020.)
theorem pfxlswccat (V W: class):
  $ wi (wa (wcel W (cword V)) (wne W c0)) (wceq (co (co W (co (cfv W chash) c1 cmin) cpfx) (cs1 (cfv W clsw)) cconcat) W) $;

--| The last symbol of a word concatenated with the word with the last symbol removed results in the word itself. (Contributed by Alexander van der Vekens, 24-Oct-2018.) (Revised by AV, 9-May-2020.)
theorem ccats1pfxeq (U V W: class):
  $ wi (w3a (wcel W (cword V)) (wcel U (cword V)) (wceq (cfv U chash) (co (cfv W chash) c1 caddc))) (wi (wceq W (co U (cfv W chash) cpfx)) (wceq U (co W (cs1 (cfv U clsw)) cconcat))) $;

--| There exists a symbol such that its concatenation after the prefix obtained by deleting the last symbol of a nonempty word results in the word itself. (Contributed by AV, 5-Oct-2018.) (Revised by AV, 9-May-2020.)
theorem ccats1pfxeqrex {s1: setvar} (U V W: class):
  $ wi (w3a (wcel W (cword V)) (wcel U (cword V)) (wceq (cfv U chash) (co (cfv W chash) c1 caddc))) (wi (wceq W (co U (cfv W chash) cpfx)) (wrex s1 (wceq U (co W (cs1 (cv s1)) cconcat)) V)) $;

--| An ~ opth -like theorem for recovering the two halves of a concatenated word. (Contributed by Mario Carneiro, 1-Oct-2015.) (Proof shortened by AV, 12-Oct-2022.)
theorem ccatopth (A2 B2 C D X: class):
  $ wi (w3a (wa (wcel A2 (cword X)) (wcel B2 (cword X))) (wa (wcel C (cword X)) (wcel D (cword X))) (wceq (cfv A2 chash) (cfv C chash))) (wb (wceq (co A2 B2 cconcat) (co C D cconcat)) (wa (wceq A2 C) (wceq B2 D))) $;

--| An ~ opth -like theorem for recovering the two halves of a concatenated word. (Contributed by Mario Carneiro, 1-Oct-2015.)
theorem ccatopth2 (A2 B2 C D X: class):
  $ wi (w3a (wa (wcel A2 (cword X)) (wcel B2 (cword X))) (wa (wcel C (cword X)) (wcel D (cword X))) (wceq (cfv B2 chash) (cfv D chash))) (wb (wceq (co A2 B2 cconcat) (co C D cconcat)) (wa (wceq A2 C) (wceq B2 D))) $;

--| Concatenation of words is left-cancellative. (Contributed by Mario Carneiro, 2-Oct-2015.)
theorem ccatlcan (A2 B2 C X: class):
  $ wi (w3a (wcel A2 (cword X)) (wcel B2 (cword X)) (wcel C (cword X))) (wb (wceq (co C A2 cconcat) (co C B2 cconcat)) (wceq A2 B2)) $;

--| Concatenation of words is right-cancellative. (Contributed by Mario Carneiro, 2-Oct-2015.)
theorem ccatrcan (A2 B2 C X: class):
  $ wi (w3a (wcel A2 (cword X)) (wcel B2 (cword X)) (wcel C (cword X))) (wb (wceq (co A2 C cconcat) (co B2 C cconcat)) (wceq A2 B2)) $;

--| Decompose a nonempty word by separating off the first symbol. (Contributed by Stefan O'Rear, 25-Aug-2015.) (Revised by Mario Carneiro, 1-Oct-2015.) (Proof shortened by AV, 12-Oct-2022.)
theorem wrdeqs1cat (A2 W: class):
  $ wi (wa (wcel W (cword A2)) (wne W c0)) (wceq W (co (cs1 (cfv cc0 W)) (co W (cop c1 (cfv W chash)) csubstr) cconcat)) $;

--| Express a word with an extra symbol as the union of the word and the new value. (Contributed by Mario Carneiro, 28-Feb-2016.)
theorem cats1un (A2 B2 X: class):
  $ wi (wa (wcel A2 (cword X)) (wcel B2 X)) (wceq (co A2 (cs1 B2) cconcat) (cun A2 (csn (cop (cfv A2 chash) B2)))) $;

--| Perform induction over the structure of a word. (Contributed by Mario Carneiro, 27-Sep-2015.) (Revised by Mario Carneiro, 26-Feb-2016.) (Proof shortened by AV, 12-Oct-2022.)
theorem wrdind {x3 y1 z: setvar} (ph: wff x3) (ps: wff x3 y1 z) (ch th ta: wff y1 z) (A2: class y1 z) (B2: class):
  $ wi (wceq (cv x3) c0) (wb ph ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ch) $ >
  $ wi (wceq (cv x3) (co (cv y1) (cs1 (cv z)) cconcat)) (wb ph th) $ >
  $ wi (wceq (cv x3) A2) (wb ph ta) $ >
  $ ps $ >
  $ wi (wa (wcel (cv y1) (cword B2)) (wcel (cv z) B2)) (wi ch th) $ >
  $ wi (wcel A2 (cword B2)) ta $;

--| Perform induction over the structure of two words of the same length. (Contributed by AV, 23-Jan-2019.) (Proof shortened by AV, 12-Oct-2022.)
theorem wrd2ind {x3 y1 z w u s1: setvar} (ph: wff x3 w) (ps: wff x3 y1 z w u s1) (ch th: wff y1 z u s1) (ta: wff y1 z w u s1) (rh: wff x3 y1 z u s1) (A2: class y1 z u s1) (B2: class u s1) (X Y: class):
  $ wi (wa (wceq (cv x3) c0) (wceq (cv w) c0)) (wb ph ps) $ >
  $ wi (wa (wceq (cv x3) (cv y1)) (wceq (cv w) (cv u))) (wb ph ch) $ >
  $ wi (wa (wceq (cv x3) (co (cv y1) (cs1 (cv z)) cconcat)) (wceq (cv w) (co (cv u) (cs1 (cv s1)) cconcat))) (wb ph th) $ >
  $ wi (wceq (cv x3) A2) (wb rh ta) $ >
  $ wi (wceq (cv w) B2) (wb ph rh) $ >
  $ ps $ >
  $ wi (w3a (wa (wcel (cv y1) (cword X)) (wcel (cv z) X)) (wa (wcel (cv u) (cword Y)) (wcel (cv s1) Y)) (wceq (cfv (cv y1) chash) (cfv (cv u) chash))) (wi ch th) $ >
  $ wi (w3a (wcel A2 (cword X)) (wcel B2 (cword Y)) (wceq (cfv A2 chash) (cfv B2 chash))) ta $;

--| The subword of a concatenation as function. (Contributed by Alexander van der Vekens, 27-May-2018.)
theorem swrdccatfn (A2 B2 M N V: class):
  $ wi (wa (wa (wcel A2 (cword V)) (wcel B2 (cword V))) (wa (wcel M (co cc0 N cfz)) (wcel N (co cc0 (co (cfv A2 chash) (cfv B2 chash) caddc) cfz)))) (wfn (co (co A2 B2 cconcat) (cop M N) csubstr) (co cc0 (co N M cmin) cfzo)) $;

--| The subword of a concatenation of two words within the first of the concatenated words. (Contributed by Alexander van der Vekens, 28-Mar-2018.)
theorem swrdccatin1 (A2 B2 M N V: class):
  $ wi (wa (wcel A2 (cword V)) (wcel B2 (cword V))) (wi (wa (wcel M (co cc0 N cfz)) (wcel N (co cc0 (cfv A2 chash) cfz))) (wceq (co (co A2 B2 cconcat) (cop M N) csubstr) (co A2 (cop M N) csubstr))) $;

--| Lemma 4 for ~ pfxccatin12 . (Contributed by Alexander van der Vekens, 30-Mar-2018.) (Revised by Alexander van der Vekens, 23-May-2018.)
theorem pfxccatin12lem4 (K L M N: class):
  $ wi (w3a (wcel L cn0) (wcel M cn0) (wcel N cz)) (wi (wa (wcel K (co cc0 (co N M cmin) cfzo)) (wn (wcel K (co cc0 (co L M cmin) cfzo)))) (wcel K (co (co L M cmin) (co (co L M cmin) (co N L cmin) caddc) cfzo))) $;

--| Lemma for ~ pfxccatin12lem2 . (Contributed by AV, 30-Mar-2018.) (Revised by AV, 27-May-2018.)
theorem pfxccatin12lem2a (K L M N X: class):
  $ wi (wa (wcel M (co cc0 L cfz)) (wcel N (co L X cfz))) (wi (wa (wcel K (co cc0 (co N M cmin) cfzo)) (wn (wcel K (co cc0 (co L M cmin) cfzo)))) (wcel (co K M caddc) (co L X cfzo))) $;

--| Lemma 1 for ~ pfxccatin12 . (Contributed by AV, 30-Mar-2018.) (Revised by AV, 9-May-2020.)
theorem pfxccatin12lem1 (K L M N X: class):
  $ wi (wa (wcel M (co cc0 L cfz)) (wcel N (co L X cfz))) (wi (wa (wcel K (co cc0 (co N M cmin) cfzo)) (wn (wcel K (co cc0 (co L M cmin) cfzo)))) (wcel (co K (co L M cmin) cmin) (co cc0 (co N L cmin) cfzo))) $;

--| The subword of a concatenation of two words within the second of the concatenated words. (Contributed by Alexander van der Vekens, 28-Mar-2018.) (Revised by Alexander van der Vekens, 27-May-2018.)
theorem swrdccatin2 (A2 B2 L M N V: class):
  $ wceq L (cfv A2 chash) $ >
  $ wi (wa (wcel A2 (cword V)) (wcel B2 (cword V))) (wi (wa (wcel M (co L N cfz)) (wcel N (co L (co L (cfv B2 chash) caddc) cfz))) (wceq (co (co A2 B2 cconcat) (cop M N) csubstr) (co B2 (cop (co M L cmin) (co N L cmin)) csubstr))) $;

--| Lemma for ~ pfxccatin12lem2 and ~ pfxccatin12lem3 . (Contributed by AV, 30-Mar-2018.) (Revised by AV, 27-May-2018.)
theorem pfxccatin12lem2c (A2 B2 L M N V: class):
  $ wceq L (cfv A2 chash) $ >
  $ wi (wa (wa (wcel A2 (cword V)) (wcel B2 (cword V))) (wa (wcel M (co cc0 L cfz)) (wcel N (co L (co L (cfv B2 chash) caddc) cfz)))) (w3a (wcel (co A2 B2 cconcat) (cword V)) (wcel M (co cc0 N cfz)) (wcel N (co cc0 (cfv (co A2 B2 cconcat) chash) cfz))) $;

--| Lemma 2 for ~ pfxccatin12 . (Contributed by AV, 30-Mar-2018.) (Revised by AV, 9-May-2020.)
theorem pfxccatin12lem2 (A2 B2 K L M N V: class):
  $ wceq L (cfv A2 chash) $ >
  $ wi (wa (wa (wcel A2 (cword V)) (wcel B2 (cword V))) (wa (wcel M (co cc0 L cfz)) (wcel N (co L (co L (cfv B2 chash) caddc) cfz)))) (wi (wa (wcel K (co cc0 (co N M cmin) cfzo)) (wn (wcel K (co cc0 (co L M cmin) cfzo)))) (wceq (cfv K (co (co A2 B2 cconcat) (cop M N) csubstr)) (cfv (co K (cfv (co A2 (cop M L) csubstr) chash) cmin) (co B2 (co N L cmin) cpfx)))) $;

--| Lemma 3 for ~ pfxccatin12 . (Contributed by AV, 30-Mar-2018.) (Revised by AV, 27-May-2018.)
theorem pfxccatin12lem3 (A2 B2 K L M N V: class):
  $ wceq L (cfv A2 chash) $ >
  $ wi (wa (wa (wcel A2 (cword V)) (wcel B2 (cword V))) (wa (wcel M (co cc0 L cfz)) (wcel N (co L (co L (cfv B2 chash) caddc) cfz)))) (wi (wa (wcel K (co cc0 (co N M cmin) cfzo)) (wcel K (co cc0 (co L M cmin) cfzo))) (wceq (cfv K (co (co A2 B2 cconcat) (cop M N) csubstr)) (cfv K (co A2 (cop M L) csubstr)))) $;

--| The subword of a concatenation of two words within both of the concatenated words. (Contributed by Alexander van der Vekens, 5-Apr-2018.) (Revised by AV, 9-May-2020.)
theorem pfxccatin12 (A2 B2 L M N V: class):
  $ wceq L (cfv A2 chash) $ >
  $ wi (wa (wcel A2 (cword V)) (wcel B2 (cword V))) (wi (wa (wcel M (co cc0 L cfz)) (wcel N (co L (co L (cfv B2 chash) caddc) cfz))) (wceq (co (co A2 B2 cconcat) (cop M N) csubstr) (co (co A2 (cop M L) csubstr) (co B2 (co N L cmin) cpfx) cconcat))) $;

--| The subword of a concatenation is either a subword of the first concatenated word or a subword of the second concatenated word or a concatenation of a suffix of the first word with a prefix of the second word. (Contributed by Alexander van der Vekens, 30-Mar-2018.) (Revised by AV, 10-May-2020.)
theorem pfxccat3 (A2 B2 L M N V: class):
  $ wceq L (cfv A2 chash) $ >
  $ wi (wa (wcel A2 (cword V)) (wcel B2 (cword V))) (wi (wa (wcel M (co cc0 N cfz)) (wcel N (co cc0 (co L (cfv B2 chash) caddc) cfz))) (wceq (co (co A2 B2 cconcat) (cop M N) csubstr) (cif (wbr N L cle) (co A2 (cop M N) csubstr) (cif (wbr L M cle) (co B2 (cop (co M L cmin) (co N L cmin)) csubstr) (co (co A2 (cop M L) csubstr) (co B2 (co N L cmin) cpfx) cconcat))))) $;

--| The subword of a concatenation of two words as concatenation of subwords of the two concatenated words. (Contributed by Alexander van der Vekens, 29-May-2018.)
theorem swrdccat (A2 B2 L M N V: class):
  $ wceq L (cfv A2 chash) $ >
  $ wi (wa (wcel A2 (cword V)) (wcel B2 (cword V))) (wi (wa (wcel M (co cc0 N cfz)) (wcel N (co cc0 (co L (cfv B2 chash) caddc) cfz))) (wceq (co (co A2 B2 cconcat) (cop M N) csubstr) (co (co A2 (cop M (cif (wbr N L cle) N L)) csubstr) (co B2 (cop (cif (wbr cc0 (co M L cmin) cle) (co M L cmin) cc0) (co N L cmin)) csubstr) cconcat))) $;

--| A prefix of a concatenation being a prefix of the first concatenated word. (Contributed by AV, 10-May-2020.)
theorem pfxccatpfx1 (A2 B2 L N V: class):
  $ wceq L (cfv A2 chash) $ >
  $ wi (w3a (wcel A2 (cword V)) (wcel B2 (cword V)) (wcel N (co cc0 L cfz))) (wceq (co (co A2 B2 cconcat) N cpfx) (co A2 N cpfx)) $;

--| A prefix of a concatenation of two words being the first word concatenated with a prefix of the second word. (Contributed by AV, 10-May-2020.)
theorem pfxccatpfx2 (A2 B2 L M N V: class):
  $ wceq L (cfv A2 chash) $ >
  $ wceq M (cfv B2 chash) $ >
  $ wi (w3a (wcel A2 (cword V)) (wcel B2 (cword V)) (wcel N (co (co L c1 caddc) (co L M caddc) cfz))) (wceq (co (co A2 B2 cconcat) N cpfx) (co A2 (co B2 (co N L cmin) cpfx) cconcat)) $;

--| A prefix of a concatenation is either a prefix of the first concatenated word or a concatenation of the first word with a prefix of the second word. (Contributed by Alexander van der Vekens, 31-Mar-2018.) (Revised by AV, 10-May-2020.)
theorem pfxccat3a (A2 B2 L M N V: class):
  $ wceq L (cfv A2 chash) $ >
  $ wceq M (cfv B2 chash) $ >
  $ wi (wa (wcel A2 (cword V)) (wcel B2 (cword V))) (wi (wcel N (co cc0 (co L M caddc) cfz)) (wceq (co (co A2 B2 cconcat) N cpfx) (cif (wbr N L cle) (co A2 N cpfx) (co A2 (co B2 (co N L cmin) cpfx) cconcat)))) $;

--| Lemma for ~ swrdccat3b . (Contributed by AV, 30-May-2018.)
theorem swrdccat3blem (A2 B2 L M V: class):
  $ wceq L (cfv A2 chash) $ >
  $ wi (wa (wa (wa (wcel A2 (cword V)) (wcel B2 (cword V))) (wcel M (co cc0 (co L (cfv B2 chash) caddc) cfz))) (wbr (co L (cfv B2 chash) caddc) L cle)) (wceq (cif (wbr L M cle) (co B2 (cop (co M L cmin) (cfv B2 chash)) csubstr) (co (co A2 (cop M L) csubstr) B2 cconcat)) (co A2 (cop M (co L (cfv B2 chash) caddc)) csubstr)) $;

--| A suffix of a concatenation is either a suffix of the second concatenated word or a concatenation of a suffix of the first word with the second word. (Contributed by Alexander van der Vekens, 31-Mar-2018.) (Revised by Alexander van der Vekens, 30-May-2018.) (Proof shortened by AV, 14-Oct-2022.)
theorem swrdccat3b (A2 B2 L M V: class):
  $ wceq L (cfv A2 chash) $ >
  $ wi (wa (wcel A2 (cword V)) (wcel B2 (cword V))) (wi (wcel M (co cc0 (co L (cfv B2 chash) caddc) cfz)) (wceq (co (co A2 B2 cconcat) (cop M (co L (cfv B2 chash) caddc)) csubstr) (cif (wbr L M cle) (co B2 (cop (co M L cmin) (cfv B2 chash)) csubstr) (co (co A2 (cop M L) csubstr) B2 cconcat)))) $;

--| A prefix of a concatenation of length of the first concatenated word is the first word itself. (Contributed by Alexander van der Vekens, 20-Sep-2018.) (Revised by AV, 10-May-2020.)
theorem pfxccatid (A2 B2 N V: class):
  $ wi (w3a (wcel A2 (cword V)) (wcel B2 (cword V)) (wceq N (cfv A2 chash))) (wceq (co (co A2 B2 cconcat) N cpfx) A2) $;

--| A word is a prefix of a word with length greater by 1 than the first word iff the second word is the first word concatenated with the last symbol of the second word. (Contributed by AV, 24-Oct-2018.) (Revised by AV, 10-May-2020.)
theorem ccats1pfxeqbi (U V W: class):
  $ wi (w3a (wcel W (cword V)) (wcel U (cword V)) (wceq (cfv U chash) (co (cfv W chash) c1 caddc))) (wb (wceq W (co U (cfv W chash) cpfx)) (wceq U (co W (cs1 (cfv U clsw)) cconcat))) $;

--| The subword of a concatenation of two words within the first of the concatenated words. (Contributed by AV, 31-May-2018.) (Revised by Mario Carneiro/AV, 21-Oct-2018.)
theorem swrdccatin1d (ph: wff) (A2 B2 L M N V: class):
  $ wi ph (wceq (cfv A2 chash) L) $ >
  $ wi ph (wa (wcel A2 (cword V)) (wcel B2 (cword V))) $ >
  $ wi ph (wcel M (co cc0 N cfz)) $ >
  $ wi ph (wcel N (co cc0 L cfz)) $ >
  $ wi ph (wceq (co (co A2 B2 cconcat) (cop M N) csubstr) (co A2 (cop M N) csubstr)) $;

--| The subword of a concatenation of two words within the second of the concatenated words. (Contributed by AV, 31-May-2018.) (Revised by Mario Carneiro/AV, 21-Oct-2018.)
theorem swrdccatin2d (ph: wff) (A2 B2 L M N V: class):
  $ wi ph (wceq (cfv A2 chash) L) $ >
  $ wi ph (wa (wcel A2 (cword V)) (wcel B2 (cword V))) $ >
  $ wi ph (wcel M (co L N cfz)) $ >
  $ wi ph (wcel N (co L (co L (cfv B2 chash) caddc) cfz)) $ >
  $ wi ph (wceq (co (co A2 B2 cconcat) (cop M N) csubstr) (co B2 (cop (co M L cmin) (co N L cmin)) csubstr)) $;

--| The subword of a concatenation of two words within both of the concatenated words. (Contributed by AV, 31-May-2018.) (Revised by AV, 10-May-2020.)
theorem pfxccatin12d (ph: wff) (A2 B2 L M N V: class):
  $ wi ph (wceq (cfv A2 chash) L) $ >
  $ wi ph (wa (wcel A2 (cword V)) (wcel B2 (cword V))) $ >
  $ wi ph (wcel M (co cc0 L cfz)) $ >
  $ wi ph (wcel N (co L (co L (cfv B2 chash) caddc) cfz)) $ >
  $ wi ph (wceq (co (co A2 B2 cconcat) (cop M N) csubstr) (co (co A2 (cop M L) csubstr) (co B2 (co N L cmin) cpfx) cconcat)) $;

--| Lemma for ~ reuccatpfxs1 . (Contributed by Alexander van der Vekens, 5-Oct-2018.) (Revised by AV, 9-May-2020.)
theorem reuccatpfxs1lem {x3 s1: setvar} (S: class x3) (U: class s1) (V W X: class):
  $ wi (w3a (wa (wcel W (cword V)) (wcel U X)) (wral s1 (wi (wcel (co W (cs1 (cv s1)) cconcat) X) (wceq S (cv s1))) V) (wral x3 (wa (wcel (cv x3) (cword V)) (wceq (cfv (cv x3) chash) (co (cfv W chash) c1 caddc))) X)) (wi (wceq W (co U (cfv W chash) cpfx)) (wceq U (co W (cs1 S) cconcat))) $;

--| There is a unique word having the length of a given word increased by 1 with the given word as prefix if there is a unique symbol which extends the given word. (Contributed by Alexander van der Vekens, 6-Oct-2018.) (Revised by AV, 21-Jan-2022.) (Revised by AV, 13-Oct-2022.)
theorem reuccatpfxs1 {x3 v: setvar} (V W: class) (X: class v):
  $ wnfc v X $ >
  $ wi (wa (wcel W (cword V)) (wral x3 (wa (wcel (cv x3) (cword V)) (wceq (cfv (cv x3) chash) (co (cfv W chash) c1 caddc))) X)) (wi (wreu v (wcel (co W (cs1 (cv v)) cconcat) X) V) (wreu x3 (wceq W (co (cv x3) (cfv W chash) cpfx)) X)) $;

--| There is a unique word having the length of a given word increased by 1 with the given word as prefix if there is a unique symbol which extends the given word. (Contributed by Alexander van der Vekens, 6-Oct-2018.) (Revised by AV, 21-Jan-2022.) (Revised by AV, 10-May-2022.) (Proof shortened by AV, 13-Oct-2022.)
theorem reuccatpfxs1v {x3 v: setvar} (V W X: class):
  $ wi (wa (wcel W (cword V)) (wral x3 (wa (wcel (cv x3) (cword V)) (wceq (cfv (cv x3) chash) (co (cfv W chash) c1 caddc))) X)) (wi (wreu v (wcel (co W (cs1 (cv v)) cconcat) X) V) (wreu x3 (wceq W (co (cv x3) (cfv W chash) cpfx)) X)) $;

--| Syntax for the word splicing operator.
term csplice: class;

--| Define an operation which replaces portions of words. (Contributed by Stefan O'Rear, 15-Aug-2015.) (Revised by AV, 14-Oct-2022.)
axiom df_splice {s1 b: setvar}:
  $ wceq csplice (cmpo s1 b cvv cvv (co (co (co (cv s1) (cfv (cfv (cv b) c1st) c1st) cpfx) (cfv (cv b) c2nd) cconcat) (co (cv s1) (cop (cfv (cfv (cv b) c1st) c2nd) (cfv (cv s1) chash)) csubstr) cconcat)) $;

--| Value of the substring replacement operator. (Contributed by Stefan O'Rear, 15-Aug-2015.) (Revised by AV, 11-May-2020.) (Revised by AV, 15-Oct-2022.)
theorem splval (R S T F V W X Y: class):
  $ wi (wa (wcel S V) (w3a (wcel F W) (wcel T X) (wcel R Y))) (wceq (co S (cotp F T R) csplice) (co (co (co S F cpfx) R cconcat) (co S (cop T (cfv S chash)) csubstr) cconcat)) $;

--| Closure of the substring replacement operator. (Contributed by Stefan O'Rear, 26-Aug-2015.) (Proof shortened by AV, 15-Oct-2022.)
theorem splcl (A2 R S T F: class):
  $ wi (wa (wcel S (cword A2)) (wcel R (cword A2))) (wcel (co S (cotp F T R) csplice) (cword A2)) $;

--| Splicing a subword for the same subword makes no difference. (Contributed by Stefan O'Rear, 20-Aug-2015.) (Proof shortened by AV, 14-Oct-2022.)
theorem splid (A2 S X Y: class):
  $ wi (wa (wcel S (cword A2)) (wa (wcel X (co cc0 Y cfz)) (wcel Y (co cc0 (cfv S chash) cfz)))) (wceq (co S (cotp X Y (co S (cop X Y) csubstr)) csplice) S) $;

--| The length of a splice. (Contributed by Stefan O'Rear, 23-Aug-2015.) (Proof shortened by AV, 15-Oct-2022.)
theorem spllen (ph: wff) (A2 R S T F: class):
  $ wi ph (wcel S (cword A2)) $ >
  $ wi ph (wcel F (co cc0 T cfz)) $ >
  $ wi ph (wcel T (co cc0 (cfv S chash) cfz)) $ >
  $ wi ph (wcel R (cword A2)) $ >
  $ wi ph (wceq (cfv (co S (cotp F T R) csplice) chash) (co (cfv S chash) (co (cfv R chash) (co T F cmin) cmin) caddc)) $;

--| Symbols to the left of a splice are unaffected. (Contributed by Stefan O'Rear, 23-Aug-2015.) (Proof shortened by AV, 15-Oct-2022.)
theorem splfv1 (ph: wff) (A2 R S T F X: class):
  $ wi ph (wcel S (cword A2)) $ >
  $ wi ph (wcel F (co cc0 T cfz)) $ >
  $ wi ph (wcel T (co cc0 (cfv S chash) cfz)) $ >
  $ wi ph (wcel R (cword A2)) $ >
  $ wi ph (wcel X (co cc0 F cfzo)) $ >
  $ wi ph (wceq (cfv X (co S (cotp F T R) csplice)) (cfv X S)) $;

--| Symbols within the replacement region of a splice, expressed using the coordinates of the replacement region. (Contributed by Stefan O'Rear, 23-Aug-2015.) (Proof shortened by AV, 15-Oct-2022.)
theorem splfv2a (ph: wff) (A2 R S T F X: class):
  $ wi ph (wcel S (cword A2)) $ >
  $ wi ph (wcel F (co cc0 T cfz)) $ >
  $ wi ph (wcel T (co cc0 (cfv S chash) cfz)) $ >
  $ wi ph (wcel R (cword A2)) $ >
  $ wi ph (wcel X (co cc0 (cfv R chash) cfzo)) $ >
  $ wi ph (wceq (cfv (co F X caddc) (co S (cotp F T R) csplice)) (cfv X R)) $;

--| Value of a splice, assuming the input word ` S ` has already been decomposed into its pieces. (Contributed by Mario Carneiro, 1-Oct-2015.) (Proof shortened by AV, 15-Oct-2022.)
theorem splval2 (ph: wff) (A2 B2 C R S T F X: class):
  $ wi ph (wcel A2 (cword X)) $ >
  $ wi ph (wcel B2 (cword X)) $ >
  $ wi ph (wcel C (cword X)) $ >
  $ wi ph (wcel R (cword X)) $ >
  $ wi ph (wceq S (co (co A2 B2 cconcat) C cconcat)) $ >
  $ wi ph (wceq F (cfv A2 chash)) $ >
  $ wi ph (wceq T (co F (cfv B2 chash) caddc)) $ >
  $ wi ph (wceq (co S (cotp F T R) csplice) (co (co A2 R cconcat) C cconcat)) $;

--| Syntax for the word reverse operator.
term creverse: class;

--| Define an operation which reverses the order of symbols in a word. This operation is also known as "word reversal" and "word mirroring". (Contributed by Stefan O'Rear, 26-Aug-2015.)
axiom df_reverse {x3 s1: setvar}:
  $ wceq creverse (cmpt s1 cvv (cmpt x3 (co cc0 (cfv (cv s1) chash) cfzo) (cfv (co (co (cfv (cv s1) chash) c1 cmin) (cv x3) cmin) (cv s1)))) $;

--| Value of the word reversing function. (Contributed by Stefan O'Rear, 26-Aug-2015.)
theorem revval {x3: setvar} (V: class x3) (W: class):
  $ wi (wcel W V) (wceq (cfv W creverse) (cmpt x3 (co cc0 (cfv W chash) cfzo) (cfv (co (co (cfv W chash) c1 cmin) (cv x3) cmin) W))) $;

--| The reverse of a word is a word. (Contributed by Stefan O'Rear, 26-Aug-2015.)
theorem revcl (A2 W: class):
  $ wi (wcel W (cword A2)) (wcel (cfv W creverse) (cword A2)) $;

--| The reverse of a word has the same length as the original. (Contributed by Stefan O'Rear, 26-Aug-2015.)
theorem revlen (A2 W: class):
  $ wi (wcel W (cword A2)) (wceq (cfv (cfv W creverse) chash) (cfv W chash)) $;

--| Reverse of a word at a point. (Contributed by Stefan O'Rear, 26-Aug-2015.)
theorem revfv (A2 W X: class):
  $ wi (wa (wcel W (cword A2)) (wcel X (co cc0 (cfv W chash) cfzo))) (wceq (cfv X (cfv W creverse)) (cfv (co (co (cfv W chash) c1 cmin) X cmin) W)) $;

--| The empty word is its own reverse. (Contributed by Stefan O'Rear, 26-Aug-2015.)
theorem rev0:
  $ wceq (cfv c0 creverse) c0 $;

--| Singleton words are their own reverses. (Contributed by Stefan O'Rear, 26-Aug-2015.) (Revised by Mario Carneiro, 26-Feb-2016.)
theorem revs1 (S: class):
  $ wceq (cfv (cs1 S) creverse) (cs1 S) $;

--| Antiautomorphic property of the reversal operation. (Contributed by Stefan O'Rear, 27-Aug-2015.)
theorem revccat (A2 S T: class):
  $ wi (wa (wcel S (cword A2)) (wcel T (cword A2))) (wceq (cfv (co S T cconcat) creverse) (co (cfv T creverse) (cfv S creverse) cconcat)) $;

--| Reversal is an involution on words. (Contributed by Mario Carneiro, 1-Oct-2015.)
theorem revrev (A2 W: class):
  $ wi (wcel W (cword A2)) (wceq (cfv (cfv W creverse) creverse) W) $;

--| The reverse of a prefix of a word is equal to the same-length suffix of the reverse of that word. (Contributed by BTernaryTau, 2-Dec-2023.)
theorem revpfxsfxrev (L V W: class):
  $ wi (wa (wcel W (cword V)) (wcel L (co cc0 (cfv W chash) cfz))) (wceq (cfv (co W L cpfx) creverse) (co (cfv W creverse) (cop (co (cfv W chash) L cmin) (cfv W chash)) csubstr)) $;

--| A subword expressed in terms of reverses and prefixes. (Contributed by BTernaryTau, 3-Dec-2023.)
theorem swrdrevpfx (F L V W: class):
  $ wi (w3a (wcel W (cword V)) (wcel F (co cc0 L cfz)) (wcel L (co cc0 (cfv W chash) cfz))) (wceq (co W (cop F L) csubstr) (cfv (co (cfv (co W L cpfx) creverse) (co L F cmin) cpfx) creverse)) $;

--| Extend class notation with words consisting of one repeated symbol.
term creps: class;

--| Definition to construct a word consisting of one repeated symbol, often called "repeated symbol word" for short in the following. (Contributed by Alexander van der Vekens, 4-Nov-2018.)
axiom df_reps {x3 n s1: setvar}:
  $ wceq creps (cmpo s1 n cvv cn0 (cmpt x3 (co cc0 (cv n) cfzo) (cv s1))) $;

--| Construct a function mapping a half-open range of nonnegative integers to a constant. (Contributed by AV, 4-Nov-2018.)
theorem reps {x3: setvar} (S N: class) (V: class x3):
  $ wi (wa (wcel S V) (wcel N cn0)) (wceq (co S N creps) (cmpt x3 (co cc0 N cfzo) S)) $;

--| A function mapping a half-open range of nonnegative integers with an upper bound not being a nonnegative integer to a constant is the empty set (in the meaning of "undefined"). (Contributed by AV, 5-Nov-2018.)
theorem repsundef (S N: class):
  $ wi (wnel N cn0) (wceq (co S N creps) c0) $;

--| Construct a function mapping a half-open range of nonnegative integers to a constant, see also ~ fconstmpt . (Contributed by AV, 4-Nov-2018.)
theorem repsconst (S N V: class):
  $ wi (wa (wcel S V) (wcel N cn0)) (wceq (co S N creps) (cxp (co cc0 N cfzo) (csn S))) $;

--| The constructed function mapping a half-open range of nonnegative integers to a constant is a function. (Contributed by AV, 4-Nov-2018.)
theorem repsf (S N V: class):
  $ wi (wa (wcel S V) (wcel N cn0)) (wf (co cc0 N cfzo) V (co S N creps)) $;

--| The symbols of a "repeated symbol word". (Contributed by AV, 4-Nov-2018.)
theorem repswsymb (S I N V: class):
  $ wi (w3a (wcel S V) (wcel N cn0) (wcel I (co cc0 N cfzo))) (wceq (cfv I (co S N creps)) S) $;

--| A function mapping a half-open range of nonnegative integers to a constant is a word consisting of one symbol repeated several times ("repeated symbol word"). (Contributed by AV, 4-Nov-2018.)
theorem repsw (S N V: class):
  $ wi (wa (wcel S V) (wcel N cn0)) (wcel (co S N creps) (cword V)) $;

--| The length of a "repeated symbol word". (Contributed by AV, 4-Nov-2018.)
theorem repswlen (S N V: class):
  $ wi (wa (wcel S V) (wcel N cn0)) (wceq (cfv (co S N creps) chash) N) $;

--| The "repeated symbol word" of length 0. (Contributed by AV, 4-Nov-2018.)
theorem repsw0 (S V: class):
  $ wi (wcel S V) (wceq (co S cc0 creps) c0) $;

--| Alternative definition of a "repeated symbol word". (Contributed by AV, 7-Nov-2018.)
theorem repsdf2 {i: setvar} (S N: class) (V: class i) (W: class):
  $ wi (wa (wcel S V) (wcel N cn0)) (wb (wceq W (co S N creps)) (w3a (wcel W (cword V)) (wceq (cfv W chash) N) (wral i (wceq (cfv (cv i) W) S) (co cc0 N cfzo)))) $;

--| All the symbols of a "repeated symbol word" are the same. (Contributed by AV, 10-Nov-2018.)
theorem repswsymball {i: setvar} (S: class) (V: class i) (W: class):
  $ wi (wa (wcel W (cword V)) (wcel S V)) (wi (wceq W (co S (cfv W chash) creps)) (wral i (wceq (cfv (cv i) W) S) (co cc0 (cfv W chash) cfzo))) $;

--| A word is a "repeated symbol word" iff each of its symbols equals the first symbol of the word. (Contributed by AV, 10-Nov-2018.)
theorem repswsymballbi {i: setvar} (V: class i) (W: class):
  $ wi (wcel W (cword V)) (wb (wceq W (co (cfv cc0 W) (cfv W chash) creps)) (wral i (wceq (cfv (cv i) W) (cfv cc0 W)) (co cc0 (cfv W chash) cfzo))) $;

--| The first symbol of a nonempty "repeated symbol word". (Contributed by AV, 4-Nov-2018.)
theorem repswfsts (S N V: class):
  $ wi (wa (wcel S V) (wcel N cn)) (wceq (cfv cc0 (co S N creps)) S) $;

--| The last symbol of a nonempty "repeated symbol word". (Contributed by AV, 4-Nov-2018.)
theorem repswlsw (S N V: class):
  $ wi (wa (wcel S V) (wcel N cn)) (wceq (cfv (co S N creps) clsw) S) $;

--| The "repeated symbol word" of length 1. (Contributed by AV, 4-Nov-2018.)
theorem repsw1 (S V: class):
  $ wi (wcel S V) (wceq (co S c1 creps) (cs1 S)) $;

--| A subword of a "repeated symbol word" is again a "repeated symbol word". The assumption ` N <_ L ` is required, because otherwise ` ( L < N ) ` : ` ( ( S repeatS L ) substr <. M , N >. ) = (/) ` , but for M < N ` ( S repeatS ( N - M ) ) ) =/= (/) ` ! The proof is relatively long because the border cases ( ` M = N ` , ` -. ( M ..^ N ) C_ ( 0 ..^ L ) ` must have been considered. (Contributed by AV, 6-Nov-2018.)
theorem repswswrd (S L M N V: class):
  $ wi (w3a (wa (wcel S V) (wcel L cn0)) (wa (wcel M cn0) (wcel N cn0)) (wbr N L cle)) (wceq (co (co S L creps) (cop M N) csubstr) (co S (co N M cmin) creps)) $;

--| A prefix of a repeated symbol word is a repeated symbol word. (Contributed by AV, 11-May-2020.)
theorem repswpfx (S L N V: class):
  $ wi (w3a (wcel S V) (wcel N cn0) (wcel L (co cc0 N cfz))) (wceq (co (co S N creps) L cpfx) (co S L creps)) $;

--| The concatenation of two "repeated symbol words" with the same symbol is again a "repeated symbol word". (Contributed by AV, 4-Nov-2018.)
theorem repswccat (S M N V: class):
  $ wi (w3a (wcel S V) (wcel N cn0) (wcel M cn0)) (wceq (co (co S N creps) (co S M creps) cconcat) (co S (co N M caddc) creps)) $;

--| The reverse of a "repeated symbol word". (Contributed by AV, 6-Nov-2018.)
theorem repswrevw (S N V: class):
  $ wi (wa (wcel S V) (wcel N cn0)) (wceq (cfv (co S N creps) creverse) (co S N creps)) $;

--| Extend class notation with Cyclical Shifts.
term ccsh: class;

--| Perform a cyclical shift for an arbitrary class. Meaningful only for words ` w e. Word S ` or at least functions over half-open ranges of nonnegative integers. (Contributed by Alexander van der Vekens, 20-May-2018.) (Revised by Mario Carneiro/Alexander van der Vekens/ Gerard Lang, 17-Nov-2018.) (Revised by AV, 4-Nov-2022.)
axiom df_csh {w f2 n l: setvar}:
  $ wceq ccsh (cmpo w n (cab f2 (wrex l (wfn (cv f2) (co cc0 (cv l) cfzo)) cn0)) cz (cif (wceq (cv w) c0) c0 (co (co (cv w) (cop (co (cv n) (cfv (cv w) chash) cmo) (cfv (cv w) chash)) csubstr) (co (cv w) (co (cv n) (cfv (cv w) chash) cmo) cpfx) cconcat))) $;

--| Perform a cyclical shift for a function over a half-open range of nonnegative integers. (Contributed by AV, 20-May-2018.) (Revised by AV, 17-Nov-2018.) (Revised by AV, 4-Nov-2022.)
theorem cshfn {f2 l: setvar} (N W: class f2 l):
  $ wi (wa (wcel W (cab f2 (wrex l (wfn (cv f2) (co cc0 (cv l) cfzo)) cn0))) (wcel N cz)) (wceq (co W N ccsh) (cif (wceq W c0) c0 (co (co W (cop (co N (cfv W chash) cmo) (cfv W chash)) csubstr) (co W (co N (cfv W chash) cmo) cpfx) cconcat))) $;

--| Perform a cyclical shift for a word. (Contributed by Alexander van der Vekens, 20-May-2018.) (Revised by AV, 12-Oct-2022.)
theorem cshword (N V W: class):
  $ wi (wa (wcel W (cword V)) (wcel N cz)) (wceq (co W N ccsh) (co (co W (cop (co N (cfv W chash) cmo) (cfv W chash)) csubstr) (co W (co N (cfv W chash) cmo) cpfx) cconcat)) $;

--| A cyclical shift is the empty set if the number of shifts is not an integer. (Contributed by Alexander van der Vekens, 21-May-2018.) (Revised by AV, 17-Nov-2018.)
theorem cshnz (N W: class):
  $ wi (wn (wcel N cz)) (wceq (co W N ccsh) c0) $;

--| Cyclically shifting an empty set/word always results in the empty word/set. (Contributed by AV, 25-Oct-2018.) (Revised by AV, 17-Nov-2018.)
theorem _0csh0 (N: class):
  $ wceq (co c0 N ccsh) c0 $;

--| A word cyclically shifted by 0 is the word itself. (Contributed by AV, 16-May-2018.) (Revised by AV, 20-May-2018.) (Revised by AV, 26-Oct-2018.)
theorem cshw0 (V W: class):
  $ wi (wcel W (cword V)) (wceq (co W cc0 ccsh) W) $;

--| Cyclically shifting a word is invariant regarding modulo the word's length. (Contributed by AV, 26-Oct-2018.) (Proof shortened by AV, 16-Oct-2022.)
theorem cshwmodn (N V W: class):
  $ wi (wa (wcel W (cword V)) (wcel N cz)) (wceq (co W N ccsh) (co W (co N (cfv W chash) cmo) ccsh)) $;

--| Cyclically shifting a word is invariant regarding subtraction of the word's length. (Contributed by AV, 3-Nov-2018.)
theorem cshwsublen (N V W: class):
  $ wi (wa (wcel W (cword V)) (wcel N cz)) (wceq (co W N ccsh) (co W (co N (cfv W chash) cmin) ccsh)) $;

--| A word cyclically shifted by its length is the word itself. (Contributed by AV, 16-May-2018.) (Revised by AV, 20-May-2018.) (Revised by AV, 26-Oct-2018.)
theorem cshwn (V W: class):
  $ wi (wcel W (cword V)) (wceq (co W (cfv W chash) ccsh) W) $;

--| A cyclically shifted word is a word over the same set as for the original word. (Contributed by AV, 16-May-2018.) (Revised by AV, 21-May-2018.) (Revised by AV, 27-Oct-2018.)
theorem cshwcl (N V W: class):
  $ wi (wcel W (cword V)) (wcel (co W N ccsh) (cword V)) $;

--| The length of a cyclically shifted word is the same as the length of the original word. (Contributed by AV, 16-May-2018.) (Revised by AV, 20-May-2018.) (Revised by AV, 27-Oct-2018.) (Proof shortened by AV, 16-Oct-2022.)
theorem cshwlen (N V W: class):
  $ wi (wa (wcel W (cword V)) (wcel N cz)) (wceq (cfv (co W N ccsh) chash) (cfv W chash)) $;

--| A cyclically shifted word is a function from a half-open range of integers of the same length as the word as domain to the set of symbols for the word. (Contributed by AV, 12-Nov-2018.)
theorem cshwf (A2 N W: class):
  $ wi (wa (wcel W (cword A2)) (wcel N cz)) (wf (co cc0 (cfv W chash) cfzo) A2 (co W N ccsh)) $;

--| A cyclically shifted word is a function with a half-open range of integers of the same length as the word as domain. (Contributed by AV, 12-Nov-2018.)
theorem cshwfn (N V W: class):
  $ wi (wa (wcel W (cword V)) (wcel N cz)) (wfn (co W N ccsh) (co cc0 (cfv W chash) cfzo)) $;

--| The range of a cyclically shifted word is a subset of the set of symbols for the word. (Contributed by AV, 12-Nov-2018.)
theorem cshwrn (N V W: class):
  $ wi (wa (wcel W (cword V)) (wcel N cz)) (wss (crn (co W N ccsh)) V) $;

--| The symbol at a given index of a cyclically shifted nonempty word is the symbol at the shifted index of the original word. (Contributed by AV, 13-May-2018.) (Revised by AV, 21-May-2018.) (Revised by AV, 30-Oct-2018.) (Proof shortened by AV, 12-Oct-2022.)
theorem cshwidxmod (I N V W: class):
  $ wi (w3a (wcel W (cword V)) (wcel N cz) (wcel I (co cc0 (cfv W chash) cfzo))) (wceq (cfv I (co W N ccsh)) (cfv (co (co I N caddc) (cfv W chash) cmo) W)) $;

--| The symbol at a given index of a cyclically shifted nonempty word is the symbol at the shifted index of the original word. (Contributed by AV, 17-Mar-2021.)
theorem cshwidxmodr (I N V W: class):
  $ wi (w3a (wcel W (cword V)) (wcel N cz) (wcel I (co cc0 (cfv W chash) cfzo))) (wceq (cfv (co (co I N cmin) (cfv W chash) cmo) (co W N ccsh)) (cfv I W)) $;

--| The symbol at index 0 of a cyclically shifted nonempty word is the symbol at index N (modulo the length of the word) of the original word. (Contributed by AV, 30-Oct-2018.)
theorem cshwidx0mod (N V W: class):
  $ wi (w3a (wcel W (cword V)) (wne W c0) (wcel N cz)) (wceq (cfv cc0 (co W N ccsh)) (cfv (co N (cfv W chash) cmo) W)) $;

--| The symbol at index 0 of a cyclically shifted nonempty word is the symbol at index N of the original word. (Contributed by AV, 15-May-2018.) (Revised by AV, 21-May-2018.) (Revised by AV, 30-Oct-2018.)
theorem cshwidx0 (N V W: class):
  $ wi (wa (wcel W (cword V)) (wcel N (co cc0 (cfv W chash) cfzo))) (wceq (cfv cc0 (co W N ccsh)) (cfv N W)) $;

--| The symbol at index ((n-N)-1) of a word of length n (not 0) cyclically shifted by N positions is the symbol at index (n-1) of the original word. (Contributed by AV, 23-Mar-2018.) (Revised by AV, 21-May-2018.) (Revised by AV, 30-Oct-2018.)
theorem cshwidxm1 (N V W: class):
  $ wi (wa (wcel W (cword V)) (wcel N (co cc0 (cfv W chash) cfzo))) (wceq (cfv (co (co (cfv W chash) N cmin) c1 cmin) (co W N ccsh)) (cfv (co (cfv W chash) c1 cmin) W)) $;

--| The symbol at index (n-N) of a word of length n (not 0) cyclically shifted by N positions (not 0) is the symbol at index 0 of the original word. (Contributed by AV, 18-May-2018.) (Revised by AV, 21-May-2018.) (Revised by AV, 30-Oct-2018.)
theorem cshwidxm (N V W: class):
  $ wi (wa (wcel W (cword V)) (wcel N (co c1 (cfv W chash) cfz))) (wceq (cfv (co (cfv W chash) N cmin) (co W N ccsh)) (cfv cc0 W)) $;

--| The symbol at index (n-1) of a word of length n (not 0) cyclically shifted by N positions (not 0) is the symbol at index (N-1) of the original word. (Contributed by AV, 18-May-2018.) (Revised by AV, 21-May-2018.) (Revised by AV, 30-Oct-2018.)
theorem cshwidxn (N V W: class):
  $ wi (wa (wcel W (cword V)) (wcel N (co c1 (cfv W chash) cfz))) (wceq (cfv (co (cfv W chash) c1 cmin) (co W N ccsh)) (cfv (co N c1 cmin) W)) $;

--| Cyclically shifting a word which contains a symbol at most once results in a word which contains a symbol at most once. (Contributed by AV, 14-Mar-2021.)
theorem cshf1 (A2 S F G: class):
  $ wi (w3a (wf1 (co cc0 (cfv F chash) cfzo) A2 F) (wcel S cz) (wceq G (co F S ccsh))) (wf1 (co cc0 (cfv F chash) cfzo) A2 G) $;

--| If a word is injectiv (regarded as function), the cyclically shifted word is also injective. (Contributed by AV, 14-Mar-2021.)
theorem cshinj (A2 S F G: class):
  $ wi (w3a (wcel F (cword A2)) (wfun (ccnv F)) (wcel S cz)) (wi (wceq G (co F S ccsh)) (wfun (ccnv G))) $;

--| A cyclically shifted "repeated symbol word". (Contributed by Alexander van der Vekens, 7-Nov-2018.) (Proof shortened by AV, 16-Oct-2022.)
theorem repswcshw (S I N V: class):
  $ wi (w3a (wcel S V) (wcel N cn0) (wcel I cz)) (wceq (co (co S N creps) I ccsh) (co S N creps)) $;

--| Cyclically shifting a word two times. (Contributed by AV, 7-Apr-2018.) (Revised by AV, 4-Jun-2018.) (Revised by AV, 31-Oct-2018.)
theorem _2cshw (M N V W: class):
  $ wi (w3a (wcel W (cword V)) (wcel M cz) (wcel N cz)) (wceq (co (co W M ccsh) N ccsh) (co W (co M N caddc) ccsh)) $;

--| Cyclically shifting a word two times resulting in the word itself. (Contributed by AV, 7-Apr-2018.) (Revised by AV, 5-Jun-2018.) (Revised by AV, 1-Nov-2018.)
theorem _2cshwid (N V W: class):
  $ wi (wa (wcel W (cword V)) (wcel N cz)) (wceq (co (co W N ccsh) (co (cfv W chash) N cmin) ccsh) W) $;

--| The last symbol of a word cyclically shifted by N positions is the symbol at index (N-1) of the original word. (Contributed by AV, 21-Mar-2018.) (Revised by AV, 5-Jun-2018.) (Revised by AV, 1-Nov-2018.)
theorem lswcshw (N V W: class):
  $ wi (wa (wcel W (cword V)) (wcel N (co c1 (cfv W chash) cfz))) (wceq (cfv (co W N ccsh) clsw) (cfv (co N c1 cmin) W)) $;

--| Cyclically shifting a word two times is commutative. (Contributed by AV, 21-Apr-2018.) (Revised by AV, 5-Jun-2018.) (Revised by Mario Carneiro/AV, 1-Nov-2018.)
theorem _2cshwcom (M N V W: class):
  $ wi (w3a (wcel W (cword V)) (wcel N cz) (wcel M cz)) (wceq (co (co W N ccsh) M ccsh) (co (co W M ccsh) N ccsh)) $;

--| If the results of cyclically shifting two words are equal, the length of the two words was equal. (Contributed by AV, 21-Apr-2018.) (Revised by AV, 5-Jun-2018.) (Revised by AV, 1-Nov-2018.)
theorem cshwleneq (U M N V W: class):
  $ wi (w3a (wa (wcel W (cword V)) (wcel U (cword V))) (wa (wcel N cz) (wcel M cz)) (wceq (co W N ccsh) (co U M ccsh))) (wceq (cfv W chash) (cfv U chash)) $;

--| Cyclically shifting a word three times results in a once cyclically shifted word under certain circumstances. (Contributed by AV, 6-Jun-2018.) (Revised by AV, 1-Nov-2018.)
theorem _3cshw (M N V W: class):
  $ wi (w3a (wcel W (cword V)) (wcel N cz) (wcel M cz)) (wceq (co W N ccsh) (co (co (co W M ccsh) N ccsh) (co (cfv W chash) M cmin) ccsh)) $;

--| If cyclically shifting two words (of the same length) results in the same word, cyclically shifting one of the words by the difference of the numbers of shifts results in the other word. (Contributed by AV, 21-Apr-2018.) (Revised by AV, 6-Jun-2018.) (Revised by AV, 1-Nov-2018.)
theorem cshweqdif2 (U M N V W: class):
  $ wi (wa (wa (wcel W (cword V)) (wcel U (cword V))) (wa (wcel N cz) (wcel M cz))) (wi (wceq (co W N ccsh) (co U M ccsh)) (wceq (co U (co M N cmin) ccsh) W)) $;

--| If cyclically shifting a word by two positions results in the same word, cyclically shifting the word by the difference of these two positions results in the original word itself. (Contributed by AV, 21-Apr-2018.) (Revised by AV, 7-Jun-2018.) (Revised by AV, 1-Nov-2018.)
theorem cshweqdifid (M N V W: class):
  $ wi (w3a (wcel W (cword V)) (wcel N cz) (wcel M cz)) (wi (wceq (co W N ccsh) (co W M ccsh)) (wceq (co W (co M N cmin) ccsh) W)) $;

--| If cyclically shifting a word by L position results in the word itself, the symbol at any position is repeated at multiples of L (modulo the length of the word) positions in the word. (Contributed by AV, 13-May-2018.) (Revised by AV, 7-Jun-2018.) (Revised by AV, 1-Nov-2018.)
theorem cshweqrep {j: setvar} (I L V W: class):
  $ wi (wa (wcel W (cword V)) (wcel L cz)) (wi (wa (wceq (co W L ccsh) W) (wcel I (co cc0 (cfv W chash) cfzo))) (wral j (wceq (cfv I W) (cfv (co (co I (co (cv j) L cmul) caddc) (cfv W chash) cmo) W)) cn0)) $;

--| If cyclically shifting a word by 1 position results in the word itself, the word is build of identical symbols. Remark: also "valid" for an empty word! (Contributed by AV, 13-May-2018.) (Revised by AV, 7-Jun-2018.) (Proof shortened by AV, 1-Nov-2018.)
theorem cshw1 {i: setvar} (V W: class):
  $ wi (wa (wcel W (cword V)) (wceq (co W c1 ccsh) W)) (wral i (wceq (cfv (cv i) W) (cfv cc0 W)) (co cc0 (cfv W chash) cfzo)) $;

--| If cyclically shifting a word by 1 position results in the word itself, the word is a "repeated symbol word". Remark: also "valid" for an empty word! (Contributed by AV, 8-Nov-2018.) (Proof shortened by AV, 10-Nov-2018.)
theorem cshw1repsw (V W: class):
  $ wi (wa (wcel W (cword V)) (wceq (co W c1 ccsh) W)) (wceq W (co (cfv cc0 W) (cfv W chash) creps)) $;

--| The class of (different!) words resulting by cyclically shifting something (not necessarily a word) is a set. (Contributed by AV, 8-Jun-2018.) (Revised by Mario Carneiro/AV, 25-Oct-2018.) (Proof shortened by SN, 15-Jan-2025.)
theorem cshwsexa {w n: setvar} (V: class w n) (W: class):
  $ wcel (crab w (wrex n (wceq (co W (cv n) ccsh) (cv w)) (co cc0 (cfv W chash) cfzo)) (cword V)) cvv $;

--| If a word is a cyclically shifted word, and a second word is the result of cyclically shifting the same word, then the second word is the result of cyclically shifting the first word. (Contributed by AV, 11-May-2018.) (Revised by AV, 12-Jun-2018.) (Proof shortened by AV, 3-Nov-2018.)
theorem _2cshwcshw {m n: setvar} (K N V X Y Z: class):
  $ wi (wa (wcel Y (cword V)) (wceq (cfv Y chash) N)) (wi (w3a (wcel K (co cc0 N cfz)) (wceq X (co Y K ccsh)) (wrex m (wceq Z (co Y (cv m) ccsh)) (co cc0 N cfz))) (wrex n (wceq Z (co X (cv n) ccsh)) (co cc0 N cfz))) $;

--| For a nonempty word the sets of shifted words, expressd by a finite interval of integers or by a half-open integer range are identical. (Contributed by Alexander van der Vekens, 15-Jun-2018.)
theorem scshwfzeqfzo {y1 n: setvar} (N V X: class):
  $ wi (w3a (wcel X (cword V)) (wne X c0) (wceq N (cfv X chash))) (wceq (crab y1 (wrex n (wceq (cv y1) (co X (cv n) ccsh)) (co cc0 N cfz)) (cword V)) (crab y1 (wrex n (wceq (cv y1) (co X (cv n) ccsh)) (co cc0 N cfzo)) (cword V))) $;

--| A cyclically shifted word can be reconstructed by cyclically shifting it again. Lemma for ~ erclwwlksym and ~ erclwwlknsym . (Contributed by AV, 8-Apr-2018.) (Revised by AV, 11-Jun-2018.) (Proof shortened by AV, 3-Nov-2018.)
theorem cshwcshid {x3 y1 n: setvar} (ph: wff x3 y1 n) (m: setvar) (V: class x3 y1 n):
  $ wi ph (wcel (cv y1) (cword V)) $ >
  $ wi ph (wceq (cfv (cv x3) chash) (cfv (cv y1) chash)) $ >
  $ wi ph (wi (wa (wcel (cv m) (co cc0 (cfv (cv y1) chash) cfz)) (wceq (cv x3) (co (cv y1) (cv m) ccsh))) (wrex n (wceq (cv y1) (co (cv x3) (cv n) ccsh)) (co cc0 (cfv (cv x3) chash) cfz))) $;

--| A cyclically shifted word can be reconstructed by cyclically shifting it again twice. Lemma for ~ erclwwlktr and ~ erclwwlkntr . (Contributed by AV, 9-Apr-2018.) (Revised by AV, 11-Jun-2018.) (Proof shortened by AV, 3-Nov-2018.)
theorem cshwcsh2id {x3 y1 z n: setvar} (ph: wff x3 y1 z n) (k m: setvar) (V: class x3 y1 z n):
  $ wi ph (wcel (cv z) (cword V)) $ >
  $ wi ph (wa (wceq (cfv (cv y1) chash) (cfv (cv z) chash)) (wceq (cfv (cv x3) chash) (cfv (cv y1) chash))) $ >
  $ wi ph (wi (wa (wa (wcel (cv m) (co cc0 (cfv (cv y1) chash) cfz)) (wceq (cv x3) (co (cv y1) (cv m) ccsh))) (wa (wcel (cv k) (co cc0 (cfv (cv z) chash) cfz)) (wceq (cv y1) (co (cv z) (cv k) ccsh)))) (wrex n (wceq (cv x3) (co (cv z) (cv n) ccsh)) (co cc0 (cfv (cv z) chash) cfz))) $;

--| The image of a cyclically shifted word under its domain without its left bound is the image of a cyclically shifted word under its domain without the number of shifted symbols. (Contributed by AV, 19-Mar-2021.)
theorem cshimadifsn (S F J N: class):
  $ wi (w3a (wcel F (cword S)) (wceq N (cfv F chash)) (wcel J (co cc0 N cfzo))) (wceq (cima F (cdif (co cc0 N cfzo) (csn J))) (cima (co F J ccsh) (co c1 N cfzo))) $;

--| The image of a cyclically shifted word under its domain without its upper bound is the image of a cyclically shifted word under its domain without the number of shifted symbols. (Contributed by AV, 19-Mar-2021.)
theorem cshimadifsn0 (S F J N: class):
  $ wi (w3a (wcel F (cword S)) (wceq N (cfv F chash)) (wcel J (co cc0 N cfzo))) (wceq (cima F (cdif (co cc0 N cfzo) (csn J))) (cima (co F (co J c1 caddc) ccsh) (co cc0 (co N c1 cmin) cfzo))) $;

--| Mapping a word by a function. (Contributed by Stefan O'Rear, 27-Aug-2015.)
theorem wrdco (A2 B2 F W: class):
  $ wi (wa (wcel W (cword A2)) (wf A2 B2 F)) (wcel (ccom F W) (cword B2)) $;

--| Length of a mapped word is unchanged. (Contributed by Stefan O'Rear, 27-Aug-2015.)
theorem lenco (A2 B2 F W: class):
  $ wi (wa (wcel W (cword A2)) (wf A2 B2 F)) (wceq (cfv (ccom F W) chash) (cfv W chash)) $;

--| Mapping of a singleton word. (Contributed by Mario Carneiro, 27-Sep-2015.) (Revised by Mario Carneiro, 26-Feb-2016.)
theorem s1co (A2 B2 S F: class):
  $ wi (wa (wcel S A2) (wf A2 B2 F)) (wceq (ccom F (cs1 S)) (cs1 (cfv S F))) $;

--| Mapping of words (i.e., a letterwise mapping) commutes with reversal. (Contributed by Stefan O'Rear, 27-Aug-2015.)
theorem revco (A2 B2 F W: class):
  $ wi (wa (wcel W (cword A2)) (wf A2 B2 F)) (wceq (ccom F (cfv W creverse)) (cfv (ccom F W) creverse)) $;

--| Mapping of words commutes with concatenation. (Contributed by Stefan O'Rear, 27-Aug-2015.)
theorem ccatco (A2 B2 S T F: class):
  $ wi (w3a (wcel S (cword A2)) (wcel T (cword A2)) (wf A2 B2 F)) (wceq (ccom F (co S T cconcat)) (co (ccom F S) (ccom F T) cconcat)) $;

--| Mapping of words commutes with the "cyclical shift" operation. (Contributed by AV, 12-Nov-2018.)
theorem cshco (A2 B2 F N W: class):
  $ wi (w3a (wcel W (cword A2)) (wcel N cz) (wf A2 B2 F)) (wceq (ccom F (co W N ccsh)) (co (ccom F W) N ccsh)) $;

--| Mapping of words commutes with the substring operation. (Contributed by AV, 11-Nov-2018.)
theorem swrdco (A2 B2 F M N W: class):
  $ wi (w3a (wcel W (cword A2)) (wa (wcel M (co cc0 N cfz)) (wcel N (co cc0 (cfv W chash) cfz))) (wf A2 B2 F)) (wceq (ccom F (co W (cop M N) csubstr)) (co (ccom F W) (cop M N) csubstr)) $;

--| Mapping of words commutes with the prefix operation. (Contributed by AV, 15-May-2020.)
theorem pfxco (A2 B2 F N W: class):
  $ wi (w3a (wcel W (cword A2)) (wcel N (co cc0 (cfv W chash) cfz)) (wf A2 B2 F)) (wceq (ccom F (co W N cpfx)) (co (ccom F W) N cpfx)) $;

--| Mapping of (nonempty) words commutes with the "last symbol" operation. This theorem would not hold if ` W = (/) ` , ` ( F `` (/) ) =/= (/) ` and ` (/) e. A ` , because then ` ( lastS `` ( F o. W ) ) ` ` = ( lastS `` (/) ) = (/) =/= ( F `` (/) ) = ( F ( lastS `` W ) ) ` . (Contributed by AV, 11-Nov-2018.)
theorem lswco (A2 B2 F W: class):
  $ wi (w3a (wcel W (cword A2)) (wne W c0) (wf A2 B2 F)) (wceq (cfv (ccom F W) clsw) (cfv (cfv W clsw) F)) $;

--| Mapping of words commutes with the "repeated symbol" operation. (Contributed by AV, 11-Nov-2018.)
theorem repsco (A2 B2 S F N: class):
  $ wi (w3a (wcel S A2) (wcel N cn0) (wf A2 B2 F)) (wceq (ccom F (co S N creps)) (co (cfv S F) N creps)) $;

--| Syntax for the length 2 word constructor.
term cs2 (A2 B2: class): class;

--| Syntax for the length 3 word constructor.
term cs3 (A2 B2 C: class): class;

--| Syntax for the length 4 word constructor.
term cs4 (A2 B2 C D: class): class;

--| Syntax for the length 5 word constructor.
term cs5 (A2 B2 C D E: class): class;

--| Syntax for the length 6 word constructor.
term cs6 (A2 B2 C D E F: class): class;

--| Syntax for the length 7 word constructor.
term cs7 (A2 B2 C D E F G: class): class;

--| Syntax for the length 8 word constructor.
term cs8 (A2 B2 C D E F G H: class): class;

--| Define the length 2 word constructor. (Contributed by Mario Carneiro, 26-Feb-2016.)
axiom df_s2 (A2 B2: class):
  $ wceq (cs2 A2 B2) (co (cs1 A2) (cs1 B2) cconcat) $;

--| Define the length 3 word constructor. (Contributed by Mario Carneiro, 26-Feb-2016.)
axiom df_s3 (A2 B2 C: class):
  $ wceq (cs3 A2 B2 C) (co (cs2 A2 B2) (cs1 C) cconcat) $;

--| Define the length 4 word constructor. (Contributed by Mario Carneiro, 26-Feb-2016.)
axiom df_s4 (A2 B2 C D: class):
  $ wceq (cs4 A2 B2 C D) (co (cs3 A2 B2 C) (cs1 D) cconcat) $;

--| Define the length 5 word constructor. (Contributed by Mario Carneiro, 26-Feb-2016.)
axiom df_s5 (A2 B2 C D E: class):
  $ wceq (cs5 A2 B2 C D E) (co (cs4 A2 B2 C D) (cs1 E) cconcat) $;

--| Define the length 6 word constructor. (Contributed by Mario Carneiro, 26-Feb-2016.)
axiom df_s6 (A2 B2 C D E F: class):
  $ wceq (cs6 A2 B2 C D E F) (co (cs5 A2 B2 C D E) (cs1 F) cconcat) $;

--| Define the length 7 word constructor. (Contributed by Mario Carneiro, 26-Feb-2016.)
axiom df_s7 (A2 B2 C D E F G: class):
  $ wceq (cs7 A2 B2 C D E F G) (co (cs6 A2 B2 C D E F) (cs1 G) cconcat) $;

--| Define the length 8 word constructor. (Contributed by Mario Carneiro, 26-Feb-2016.)
axiom df_s8 (A2 B2 C D E F G H: class):
  $ wceq (cs8 A2 B2 C D E F G H) (co (cs7 A2 B2 C D E F G) (cs1 H) cconcat) $;

--| Closure of concatenation with a singleton word. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem cats1cld (ph: wff) (A2 S T X: class):
  $ wceq T (co S (cs1 X) cconcat) $ >
  $ wi ph (wcel S (cword A2)) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel T (cword A2)) $;

--| Closure of concatenation with a singleton word. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem cats1co (ph: wff) (A2 B2 S T U F V X: class):
  $ wceq T (co S (cs1 X) cconcat) $ >
  $ wi ph (wcel S (cword A2)) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wf A2 B2 F) $ >
  $ wi ph (wceq (ccom F S) U) $ >
  $ wceq V (co U (cs1 (cfv X F)) cconcat) $ >
  $ wi ph (wceq (ccom F T) V) $;

--| Closure of concatenation with a singleton word. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem cats1cli (S T X: class):
  $ wceq T (co S (cs1 X) cconcat) $ >
  $ wcel S (cword cvv) $ >
  $ wcel T (cword cvv) $;

--| The last symbol of a concatenation with a singleton word. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem cats1fvn (S T M V X: class):
  $ wceq T (co S (cs1 X) cconcat) $ >
  $ wcel S (cword cvv) $ >
  $ wceq (cfv S chash) M $ >
  $ wi (wcel X V) (wceq (cfv M T) X) $;

--| A symbol other than the last in a concatenation with a singleton word. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem cats1fv (S T M N V X Y: class):
  $ wceq T (co S (cs1 X) cconcat) $ >
  $ wcel S (cword cvv) $ >
  $ wceq (cfv S chash) M $ >
  $ wi (wcel Y V) (wceq (cfv N S) Y) $ >
  $ wcel N cn0 $ >
  $ wbr N M clt $ >
  $ wi (wcel Y V) (wceq (cfv N T) Y) $;

--| The length of concatenation with a singleton word. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem cats1len (S T M N X: class):
  $ wceq T (co S (cs1 X) cconcat) $ >
  $ wcel S (cword cvv) $ >
  $ wceq (cfv S chash) M $ >
  $ wceq (co M c1 caddc) N $ >
  $ wceq (cfv T chash) N $;

--| Closure of concatenation with a singleton word. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem cats1cat (A2 B2 C S T X: class):
  $ wceq T (co S (cs1 X) cconcat) $ >
  $ wcel A2 (cword cvv) $ >
  $ wcel S (cword cvv) $ >
  $ wceq C (co B2 (cs1 X) cconcat) $ >
  $ wceq B2 (co A2 S cconcat) $ >
  $ wceq C (co A2 T cconcat) $;

--| Closure of concatenation of concatenations with singleton words. (Contributed by AV, 1-Mar-2021.)
theorem cats2cat (A2 B2 C D X Y: class):
  $ wcel B2 (cword cvv) $ >
  $ wcel D (cword cvv) $ >
  $ wceq A2 (co B2 (cs1 X) cconcat) $ >
  $ wceq C (co (cs1 Y) D cconcat) $ >
  $ wceq (co A2 C cconcat) (co (co B2 (cs2 X Y) cconcat) D cconcat) $;

--| Equality theorem for a doubleton word. (Contributed by Mario Carneiro, 27-Feb-2016.)
theorem s2eqd (ph: wff) (A2 B2 N O: class):
  $ wi ph (wceq A2 N) $ >
  $ wi ph (wceq B2 O) $ >
  $ wi ph (wceq (cs2 A2 B2) (cs2 N O)) $;

--| Equality theorem for a length 3 word. (Contributed by Mario Carneiro, 27-Feb-2016.)
theorem s3eqd (ph: wff) (A2 B2 C P N O: class):
  $ wi ph (wceq A2 N) $ >
  $ wi ph (wceq B2 O) $ >
  $ wi ph (wceq C P) $ >
  $ wi ph (wceq (cs3 A2 B2 C) (cs3 N O P)) $;

--| Equality theorem for a length 4 word. (Contributed by Mario Carneiro, 27-Feb-2016.)
theorem s4eqd (ph: wff) (A2 B2 C D P Q N O: class):
  $ wi ph (wceq A2 N) $ >
  $ wi ph (wceq B2 O) $ >
  $ wi ph (wceq C P) $ >
  $ wi ph (wceq D Q) $ >
  $ wi ph (wceq (cs4 A2 B2 C D) (cs4 N O P Q)) $;

--| Equality theorem for a length 5 word. (Contributed by Mario Carneiro, 27-Feb-2016.)
theorem s5eqd (ph: wff) (A2 B2 C D P Q R E N O: class):
  $ wi ph (wceq A2 N) $ >
  $ wi ph (wceq B2 O) $ >
  $ wi ph (wceq C P) $ >
  $ wi ph (wceq D Q) $ >
  $ wi ph (wceq E R) $ >
  $ wi ph (wceq (cs5 A2 B2 C D E) (cs5 N O P Q R)) $;

--| Equality theorem for a length 6 word. (Contributed by Mario Carneiro, 27-Feb-2016.)
theorem s6eqd (ph: wff) (A2 B2 C D P Q R S E F N O: class):
  $ wi ph (wceq A2 N) $ >
  $ wi ph (wceq B2 O) $ >
  $ wi ph (wceq C P) $ >
  $ wi ph (wceq D Q) $ >
  $ wi ph (wceq E R) $ >
  $ wi ph (wceq F S) $ >
  $ wi ph (wceq (cs6 A2 B2 C D E F) (cs6 N O P Q R S)) $;

--| Equality theorem for a length 7 word. (Contributed by Mario Carneiro, 27-Feb-2016.)
theorem s7eqd (ph: wff) (A2 B2 C D P Q R S T E F G N O: class):
  $ wi ph (wceq A2 N) $ >
  $ wi ph (wceq B2 O) $ >
  $ wi ph (wceq C P) $ >
  $ wi ph (wceq D Q) $ >
  $ wi ph (wceq E R) $ >
  $ wi ph (wceq F S) $ >
  $ wi ph (wceq G T) $ >
  $ wi ph (wceq (cs7 A2 B2 C D E F G) (cs7 N O P Q R S T)) $;

--| Equality theorem for a length 8 word. (Contributed by Mario Carneiro, 27-Feb-2016.)
theorem s8eqd (ph: wff) (A2 B2 C D P Q R S T U E F G H N O: class):
  $ wi ph (wceq A2 N) $ >
  $ wi ph (wceq B2 O) $ >
  $ wi ph (wceq C P) $ >
  $ wi ph (wceq D Q) $ >
  $ wi ph (wceq E R) $ >
  $ wi ph (wceq F S) $ >
  $ wi ph (wceq G T) $ >
  $ wi ph (wceq H U) $ >
  $ wi ph (wceq (cs8 A2 B2 C D E F G H) (cs8 N O P Q R S T U)) $;

--| Equality theorem for a length 3 word for the second symbol. (Contributed by AV, 4-Jan-2022.)
theorem s3eq2 (A2 B2 C D: class):
  $ wi (wceq B2 D) (wceq (cs3 A2 B2 C) (cs3 A2 D C)) $;

--| A doubleton word is a word. (Contributed by Mario Carneiro, 27-Feb-2016.)
theorem s2cld (ph: wff) (A2 B2 X: class):
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wcel B2 X) $ >
  $ wi ph (wcel (cs2 A2 B2) (cword X)) $;

--| A length 3 string is a word. (Contributed by Mario Carneiro, 27-Feb-2016.)
theorem s3cld (ph: wff) (A2 B2 C X: class):
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wcel B2 X) $ >
  $ wi ph (wcel C X) $ >
  $ wi ph (wcel (cs3 A2 B2 C) (cword X)) $;

--| A length 4 string is a word. (Contributed by Mario Carneiro, 27-Feb-2016.)
theorem s4cld (ph: wff) (A2 B2 C D X: class):
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wcel B2 X) $ >
  $ wi ph (wcel C X) $ >
  $ wi ph (wcel D X) $ >
  $ wi ph (wcel (cs4 A2 B2 C D) (cword X)) $;

--| A length 5 string is a word. (Contributed by Mario Carneiro, 27-Feb-2016.)
theorem s5cld (ph: wff) (A2 B2 C D E X: class):
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wcel B2 X) $ >
  $ wi ph (wcel C X) $ >
  $ wi ph (wcel D X) $ >
  $ wi ph (wcel E X) $ >
  $ wi ph (wcel (cs5 A2 B2 C D E) (cword X)) $;

--| A length 6 string is a word. (Contributed by Mario Carneiro, 27-Feb-2016.)
theorem s6cld (ph: wff) (A2 B2 C D E F X: class):
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wcel B2 X) $ >
  $ wi ph (wcel C X) $ >
  $ wi ph (wcel D X) $ >
  $ wi ph (wcel E X) $ >
  $ wi ph (wcel F X) $ >
  $ wi ph (wcel (cs6 A2 B2 C D E F) (cword X)) $;

--| A length 7 string is a word. (Contributed by Mario Carneiro, 27-Feb-2016.)
theorem s7cld (ph: wff) (A2 B2 C D E F G X: class):
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wcel B2 X) $ >
  $ wi ph (wcel C X) $ >
  $ wi ph (wcel D X) $ >
  $ wi ph (wcel E X) $ >
  $ wi ph (wcel F X) $ >
  $ wi ph (wcel G X) $ >
  $ wi ph (wcel (cs7 A2 B2 C D E F G) (cword X)) $;

--| A length 8 string is a word. (Contributed by Mario Carneiro, 27-Feb-2016.)
theorem s8cld (ph: wff) (A2 B2 C D E F G H X: class):
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wcel B2 X) $ >
  $ wi ph (wcel C X) $ >
  $ wi ph (wcel D X) $ >
  $ wi ph (wcel E X) $ >
  $ wi ph (wcel F X) $ >
  $ wi ph (wcel G X) $ >
  $ wi ph (wcel H X) $ >
  $ wi ph (wcel (cs8 A2 B2 C D E F G H) (cword X)) $;

--| A doubleton word is a word. (Contributed by Stefan O'Rear, 23-Aug-2015.) (Revised by Mario Carneiro, 26-Feb-2016.)
theorem s2cl (A2 B2 X: class):
  $ wi (wa (wcel A2 X) (wcel B2 X)) (wcel (cs2 A2 B2) (cword X)) $;

--| A length 3 string is a word. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem s3cl (A2 B2 C X: class):
  $ wi (w3a (wcel A2 X) (wcel B2 X) (wcel C X)) (wcel (cs3 A2 B2 C) (cword X)) $;

--| A doubleton word is a word. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem s2cli (A2 B2: class):
  $ wcel (cs2 A2 B2) (cword cvv) $;

--| A length 3 string is a word. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem s3cli (A2 B2 C: class):
  $ wcel (cs3 A2 B2 C) (cword cvv) $;

--| A length 4 string is a word. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem s4cli (A2 B2 C D: class):
  $ wcel (cs4 A2 B2 C D) (cword cvv) $;

--| A length 5 string is a word. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem s5cli (A2 B2 C D E: class):
  $ wcel (cs5 A2 B2 C D E) (cword cvv) $;

--| A length 6 string is a word. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem s6cli (A2 B2 C D E F: class):
  $ wcel (cs6 A2 B2 C D E F) (cword cvv) $;

--| A length 7 string is a word. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem s7cli (A2 B2 C D E F G: class):
  $ wcel (cs7 A2 B2 C D E F G) (cword cvv) $;

--| A length 8 string is a word. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem s8cli (A2 B2 C D E F G H: class):
  $ wcel (cs8 A2 B2 C D E F G H) (cword cvv) $;

--| Extract the first symbol from a doubleton word. (Contributed by Stefan O'Rear, 23-Aug-2015.) (Revised by Mario Carneiro, 26-Feb-2016.)
theorem s2fv0 (A2 B2 V: class):
  $ wi (wcel A2 V) (wceq (cfv cc0 (cs2 A2 B2)) A2) $;

--| Extract the second symbol from a doubleton word. (Contributed by Stefan O'Rear, 23-Aug-2015.) (Revised by Mario Carneiro, 26-Feb-2016.)
theorem s2fv1 (A2 B2 V: class):
  $ wi (wcel B2 V) (wceq (cfv c1 (cs2 A2 B2)) B2) $;

--| The length of a doubleton word. (Contributed by Stefan O'Rear, 23-Aug-2015.) (Revised by Mario Carneiro, 26-Feb-2016.)
theorem s2len (A2 B2: class):
  $ wceq (cfv (cs2 A2 B2) chash) c2 $;

--| The domain of a doubleton word is an unordered pair. (Contributed by AV, 9-Jan-2020.)
theorem s2dm (A2 B2: class):
  $ wceq (cdm (cs2 A2 B2)) (cpr cc0 c1) $;

--| A doubleton word is a function on the doubleton ` ( 0 ..^ 2 ) ` (which is equal to ` { 0 , 1 } ` by ~ fzo0to2pr ). See also ~ s3rexrd . (Contributed by Thierry Arnoux, 10-Oct-2026.)
theorem s2mapd (ph: wff) (S V X Y: class):
  $ wi ph (wcel S V) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wcel Y S) $ >
  $ wi ph (wcel (cs2 X Y) (co S (co cc0 c2 cfzo) cmap)) $;

--| Extract the first symbol from a length 3 string. (Contributed by Mario Carneiro, 13-Jan-2017.)
theorem s3fv0 (A2 B2 C V: class):
  $ wi (wcel A2 V) (wceq (cfv cc0 (cs3 A2 B2 C)) A2) $;

--| Extract the second symbol from a length 3 string. (Contributed by Mario Carneiro, 13-Jan-2017.)
theorem s3fv1 (A2 B2 C V: class):
  $ wi (wcel B2 V) (wceq (cfv c1 (cs3 A2 B2 C)) B2) $;

--| Extract the third symbol from a length 3 string. (Contributed by Mario Carneiro, 13-Jan-2017.)
theorem s3fv2 (A2 B2 C V: class):
  $ wi (wcel C V) (wceq (cfv c2 (cs3 A2 B2 C)) C) $;

--| The length of a length 3 string. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem s3len (A2 B2 C: class):
  $ wceq (cfv (cs3 A2 B2 C) chash) c3 $;

--| Extract the first symbol from a length 4 string. (Contributed by Thierry Arnoux, 8-Oct-2020.)
theorem s4fv0 (A2 B2 C D V: class):
  $ wi (wcel A2 V) (wceq (cfv cc0 (cs4 A2 B2 C D)) A2) $;

--| Extract the second symbol from a length 4 string. (Contributed by Thierry Arnoux, 8-Oct-2020.)
theorem s4fv1 (A2 B2 C D V: class):
  $ wi (wcel B2 V) (wceq (cfv c1 (cs4 A2 B2 C D)) B2) $;

--| Extract the third symbol from a length 4 string. (Contributed by Thierry Arnoux, 8-Oct-2020.)
theorem s4fv2 (A2 B2 C D V: class):
  $ wi (wcel C V) (wceq (cfv c2 (cs4 A2 B2 C D)) C) $;

--| Extract the fourth symbol from a length 4 string. (Contributed by Thierry Arnoux, 8-Oct-2020.)
theorem s4fv3 (A2 B2 C D V: class):
  $ wi (wcel D V) (wceq (cfv c3 (cs4 A2 B2 C D)) D) $;

--| The length of a length 4 string. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem s4len (A2 B2 C D: class):
  $ wceq (cfv (cs4 A2 B2 C D) chash) c4 $;

--| The length of a length 5 string. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem s5len (A2 B2 C D E: class):
  $ wceq (cfv (cs5 A2 B2 C D E) chash) c5 $;

--| The length of a length 6 string. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem s6len (A2 B2 C D E F: class):
  $ wceq (cfv (cs6 A2 B2 C D E F) chash) c6 $;

--| The length of a length 7 string. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem s7len (A2 B2 C D E F G: class):
  $ wceq (cfv (cs7 A2 B2 C D E F G) chash) c7 $;

--| The length of a length 8 string. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem s8len (A2 B2 C D E F G H: class):
  $ wceq (cfv (cs8 A2 B2 C D E F G H) chash) c8 $;

--| The last symbol of a doubleton word is its second symbol. (Contributed by AV, 8-Feb-2021.)
theorem lsws2 (A2 B2 V: class):
  $ wi (wcel B2 V) (wceq (cfv (cs2 A2 B2) clsw) B2) $;

--| The last symbol of a 3 letter word is its third symbol. (Contributed by AV, 8-Feb-2021.)
theorem lsws3 (A2 B2 C V: class):
  $ wi (wcel C V) (wceq (cfv (cs3 A2 B2 C) clsw) C) $;

--| The last symbol of a 4 letter word is its fourth symbol. (Contributed by AV, 8-Feb-2021.)
theorem lsws4 (A2 B2 C D V: class):
  $ wi (wcel D V) (wceq (cfv (cs4 A2 B2 C D) clsw) D) $;

--| A length 2 word is an unordered pair of ordered pairs. (Contributed by Alexander van der Vekens, 14-Aug-2017.)
theorem s2prop (A2 B2 S: class):
  $ wi (wa (wcel A2 S) (wcel B2 S)) (wceq (cs2 A2 B2) (cpr (cop cc0 A2) (cop c1 B2))) $;

--| Alternate version of ~ s2dm , having a shorter proof, but requiring that ` A ` and ` B ` are sets. (Contributed by AV, 9-Jan-2020.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem s2dmALT (A2 B2 S: class):
  $ wi (wa (wcel A2 S) (wcel B2 S)) (wceq (cdm (cs2 A2 B2)) (cpr cc0 c1)) $;

--| A length 3 word is an unordered triple of ordered pairs. (Contributed by AV, 23-Jan-2021.)
theorem s3tpop (A2 B2 C S: class):
  $ wi (w3a (wcel A2 S) (wcel B2 S) (wcel C S)) (wceq (cs3 A2 B2 C) (ctp (cop cc0 A2) (cop c1 B2) (cop c2 C))) $;

--| A length 4 word is a union of two unordered pairs of ordered pairs. (Contributed by Alexander van der Vekens, 14-Aug-2017.)
theorem s4prop (A2 B2 C D S: class):
  $ wi (wa (wa (wcel A2 S) (wcel B2 S)) (wa (wcel C S) (wcel D S))) (wceq (cs4 A2 B2 C D) (cun (cpr (cop cc0 A2) (cop c1 B2)) (cpr (cop c2 C) (cop c3 D)))) $;

--| A length 3 word is a function with a triple as domain. (Contributed by Alexander van der Vekens, 5-Dec-2017.) (Revised by AV, 23-Jan-2021.)
theorem s3fn (A2 B2 C V: class):
  $ wi (w3a (wcel A2 V) (wcel B2 V) (wcel C V)) (wfn (cs3 A2 B2 C) (ctp cc0 c1 c2)) $;

--| The converse of a singleton word is a function. (Contributed by AV, 22-Jan-2021.)
theorem funcnvs1 (A2: class):
  $ wfun (ccnv (cs1 A2)) $;

--| The converse of a length 2 word is a function if its symbols are different sets. (Contributed by AV, 23-Jan-2021.)
theorem funcnvs2 (A2 B2 V: class):
  $ wi (w3a (wcel A2 V) (wcel B2 V) (wne A2 B2)) (wfun (ccnv (cs2 A2 B2))) $;

--| The converse of a length 3 word is a function if its symbols are different sets. (Contributed by Alexander van der Vekens, 31-Jan-2018.) (Revised by AV, 23-Jan-2021.)
theorem funcnvs3 (A2 B2 C V: class):
  $ wi (wa (w3a (wcel A2 V) (wcel B2 V) (wcel C V)) (w3a (wne A2 B2) (wne A2 C) (wne B2 C))) (wfun (ccnv (cs3 A2 B2 C))) $;

--| The converse of a length 4 word is a function if its symbols are different sets. (Contributed by AV, 10-Feb-2021.)
theorem funcnvs4 (A2 B2 C D V: class):
  $ wi (wa (wa (wa (wcel A2 V) (wcel B2 V)) (wa (wcel C V) (wcel D V))) (w3a (w3a (wne A2 B2) (wne A2 C) (wne A2 D)) (wa (wne B2 C) (wne B2 D)) (wne C D))) (wfun (ccnv (cs4 A2 B2 C D))) $;

--| A length 2 word with mutually different symbols is a one-to-one function onto the set of the symbols. (Contributed by Alexander van der Vekens, 14-Aug-2017.)
theorem s2f1o (A2 B2 S E: class):
  $ wi (w3a (wcel A2 S) (wcel B2 S) (wne A2 B2)) (wi (wceq E (cs2 A2 B2)) (wf1o (cpr cc0 c1) (cpr A2 B2) E)) $;

--| A union of unordered pairs of ordered pairs with different elements is a one-to-one onto function. (Contributed by Alexander van der Vekens, 14-Aug-2017.)
theorem f1oun2prg (A2 B2 C D V W X Y: class):
  $ wi (wa (wa (wcel A2 V) (wcel B2 W)) (wa (wcel C X) (wcel D Y))) (wi (wa (w3a (wne A2 B2) (wne A2 C) (wne A2 D)) (w3a (wne B2 C) (wne B2 D) (wne C D))) (wf1o (cun (cpr cc0 c1) (cpr c2 c3)) (cun (cpr A2 B2) (cpr C D)) (cun (cpr (cop cc0 A2) (cop c1 B2)) (cpr (cop c2 C) (cop c3 D))))) $;

--| A length 4 word with mutually different symbols is a one-to-one function onto the set of the symbols. (Contributed by Alexander van der Vekens, 14-Aug-2017.)
theorem s4f1o (A2 B2 C D S E: class):
  $ wi (wa (wa (wcel A2 S) (wcel B2 S)) (wa (wcel C S) (wcel D S))) (wi (wa (w3a (wne A2 B2) (wne A2 C) (wne A2 D)) (w3a (wne B2 C) (wne B2 D) (wne C D))) (wi (wceq E (cs4 A2 B2 C D)) (wf1o (cdm E) (cun (cpr A2 B2) (cpr C D)) E))) $;

--| The domain of a length 4 word is the union of two (disjunct) pairs. (Contributed by Alexander van der Vekens, 15-Aug-2017.)
theorem s4dom (A2 B2 C D S E: class):
  $ wi (wa (wa (wcel A2 S) (wcel B2 S)) (wa (wcel C S) (wcel D S))) (wi (wceq E (cs4 A2 B2 C D)) (wceq (cdm E) (cun (cpr cc0 c1) (cpr c2 c3)))) $;

--| Mapping a doubleton word by a function. (Contributed by Mario Carneiro, 27-Feb-2016.)
theorem s2co (ph: wff) (A2 B2 F X Y: class):
  $ wi ph (wf X Y F) $ >
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wcel B2 X) $ >
  $ wi ph (wceq (ccom F (cs2 A2 B2)) (cs2 (cfv A2 F) (cfv B2 F))) $;

--| Mapping a length 3 string by a function. (Contributed by Mario Carneiro, 27-Feb-2016.)
theorem s3co (ph: wff) (A2 B2 C F X Y: class):
  $ wi ph (wf X Y F) $ >
  $ wi ph (wcel A2 X) $ >
  $ wi ph (wcel B2 X) $ >
  $ wi ph (wcel C X) $ >
  $ wi ph (wceq (ccom F (cs3 A2 B2 C)) (cs3 (cfv A2 F) (cfv B2 F) (cfv C F))) $;

--| Concatenation of fixed length strings. (This special case of ~ ccatlid is provided to complete the pattern ~ s0s1 , ~ df-s2 , ~ df-s3 , ...) (Contributed by Mario Carneiro, 28-Feb-2016.)
theorem s0s1 (A2: class):
  $ wceq (cs1 A2) (co c0 (cs1 A2) cconcat) $;

--| Concatenation of fixed length strings. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem s1s2 (A2 B2 C: class):
  $ wceq (cs3 A2 B2 C) (co (cs1 A2) (cs2 B2 C) cconcat) $;

--| Concatenation of fixed length strings. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem s1s3 (A2 B2 C D: class):
  $ wceq (cs4 A2 B2 C D) (co (cs1 A2) (cs3 B2 C D) cconcat) $;

--| Concatenation of fixed length strings. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem s1s4 (A2 B2 C D E: class):
  $ wceq (cs5 A2 B2 C D E) (co (cs1 A2) (cs4 B2 C D E) cconcat) $;

--| Concatenation of fixed length strings. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem s1s5 (A2 B2 C D E F: class):
  $ wceq (cs6 A2 B2 C D E F) (co (cs1 A2) (cs5 B2 C D E F) cconcat) $;

--| Concatenation of fixed length strings. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem s1s6 (A2 B2 C D E F G: class):
  $ wceq (cs7 A2 B2 C D E F G) (co (cs1 A2) (cs6 B2 C D E F G) cconcat) $;

--| Concatenation of fixed length strings. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem s1s7 (A2 B2 C D E F G H: class):
  $ wceq (cs8 A2 B2 C D E F G H) (co (cs1 A2) (cs7 B2 C D E F G H) cconcat) $;

--| Concatenation of fixed length strings. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem s2s2 (A2 B2 C D: class):
  $ wceq (cs4 A2 B2 C D) (co (cs2 A2 B2) (cs2 C D) cconcat) $;

--| Concatenation of fixed length strings. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem s4s2 (A2 B2 C D E F: class):
  $ wceq (cs6 A2 B2 C D E F) (co (cs4 A2 B2 C D) (cs2 E F) cconcat) $;

--| Concatenation of fixed length strings. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem s4s3 (A2 B2 C D E F G: class):
  $ wceq (cs7 A2 B2 C D E F G) (co (cs4 A2 B2 C D) (cs3 E F G) cconcat) $;

--| Concatenation of fixed length strings. (Contributed by Mario Carneiro, 26-Feb-2016.)
theorem s4s4 (A2 B2 C D E F G H: class):
  $ wceq (cs8 A2 B2 C D E F G H) (co (cs4 A2 B2 C D) (cs4 E F G H) cconcat) $;

--| Concatenation of fixed length strings. (Contributed by AV, 1-Mar-2021.)
theorem s3s4 (A2 B2 C D E F G: class):
  $ wceq (cs7 A2 B2 C D E F G) (co (cs3 A2 B2 C) (cs4 D E F G) cconcat) $;

--| Concatenation of fixed length strings. (Contributed by AV, 1-Mar-2021.)
theorem s2s5 (A2 B2 C D E F G: class):
  $ wceq (cs7 A2 B2 C D E F G) (co (cs2 A2 B2) (cs5 C D E F G) cconcat) $;

--| Concatenation of fixed length strings. (Contributed by AV, 1-Mar-2021.)
theorem s5s2 (A2 B2 C D E F G: class):
  $ wceq (cs7 A2 B2 C D E F G) (co (cs5 A2 B2 C D E) (cs2 F G) cconcat) $;

--| Two length 2 words are equal iff the corresponding singleton words consisting of their symbols are equal. (Contributed by Alexander van der Vekens, 24-Sep-2018.)
theorem s2eq2s1eq (A2 B2 C D V: class):
  $ wi (wa (wa (wcel A2 V) (wcel B2 V)) (wa (wcel C V) (wcel D V))) (wb (wceq (cs2 A2 B2) (cs2 C D)) (wa (wceq (cs1 A2) (cs1 C)) (wceq (cs1 B2) (cs1 D)))) $;

--| Two length 2 words are equal iff the corresponding symbols are equal. (Contributed by AV, 20-Oct-2018.)
theorem s2eq2seq (A2 B2 C D V: class):
  $ wi (wa (wa (wcel A2 V) (wcel B2 V)) (wa (wcel C V) (wcel D V))) (wb (wceq (cs2 A2 B2) (cs2 C D)) (wa (wceq A2 C) (wceq B2 D))) $;

--| Two length 3 words are equal iff the corresponding length 2 words and singleton words consisting of their symbols are equal. (Contributed by AV, 4-Jan-2022.)
theorem s3eqs2s1eq (A2 B2 C D E F V: class):
  $ wi (wa (w3a (wcel A2 V) (wcel B2 V) (wcel C V)) (w3a (wcel D V) (wcel E V) (wcel F V))) (wb (wceq (cs3 A2 B2 C) (cs3 D E F)) (wa (wceq (cs2 A2 B2) (cs2 D E)) (wceq (cs1 C) (cs1 F)))) $;

--| Two length 3 words are equal iff the corresponding symbols are equal. (Contributed by AV, 4-Jan-2022.)
theorem s3eq3seq (A2 B2 C D E F V: class):
  $ wi (wa (w3a (wcel A2 V) (wcel B2 V) (wcel C V)) (w3a (wcel D V) (wcel E V) (wcel F V))) (wb (wceq (cs3 A2 B2 C) (cs3 D E F)) (w3a (wceq A2 D) (wceq B2 E) (wceq C F))) $;

--| Extract two adjacent symbols from a word. (Contributed by Stefan O'Rear, 23-Aug-2015.) (Revised by Mario Carneiro, 26-Feb-2016.)
theorem swrds2 (A2 I W: class):
  $ wi (w3a (wcel W (cword A2)) (wcel I cn0) (wcel (co I c1 caddc) (co cc0 (cfv W chash) cfzo))) (wceq (co W (cop I (co I c2 caddc)) csubstr) (cs2 (cfv I W) (cfv (co I c1 caddc) W))) $;

--| Extract two adjacent symbols from a word in reverse direction. (Contributed by AV, 11-May-2022.)
theorem swrds2m (N V W: class):
  $ wi (wa (wcel W (cword V)) (wcel N (co c2 (cfv W chash) cfz))) (wceq (co W (cop (co N c2 cmin) N) csubstr) (cs2 (cfv (co N c2 cmin) W) (cfv (co N c1 cmin) W))) $;

--| Implications of a word of length two. (Contributed by AV, 27-Jul-2018.) (Proof shortened by AV, 14-Oct-2018.)
theorem wrdlen2i (S T V W: class):
  $ wi (wa (wcel S V) (wcel T V)) (wi (wceq W (cpr (cop cc0 S) (cop c1 T))) (wa (wa (wcel W (cword V)) (wceq (cfv W chash) c2)) (wa (wceq (cfv cc0 W) S) (wceq (cfv c1 W) T)))) $;

--| A word of length two represented as unordered pair of ordered pairs. (Contributed by AV, 20-Oct-2018.) (Proof shortened by AV, 26-Jan-2021.)
theorem wrd2pr2op (V W: class):
  $ wi (wa (wcel W (cword V)) (wceq (cfv W chash) c2)) (wceq W (cpr (cop cc0 (cfv cc0 W)) (cop c1 (cfv c1 W)))) $;

--| A word of length two. (Contributed by AV, 20-Oct-2018.)
theorem wrdlen2 (S T V W: class):
  $ wi (wa (wcel S V) (wcel T V)) (wb (wceq W (cpr (cop cc0 S) (cop c1 T))) (wa (wa (wcel W (cword V)) (wceq (cfv W chash) c2)) (wa (wceq (cfv cc0 W) S) (wceq (cfv c1 W) T)))) $;

--| A word of length two as doubleton word. (Contributed by AV, 20-Oct-2018.)
theorem wrdlen2s2 (V W: class):
  $ wi (wa (wcel W (cword V)) (wceq (cfv W chash) c2)) (wceq W (cs2 (cfv cc0 W) (cfv c1 W))) $;

--| A word of length two is a doubleton word. (Contributed by AV, 25-Jan-2021.)
theorem wrdl2exs2 {t s1: setvar} (S W: class):
  $ wi (wa (wcel W (cword S)) (wceq (cfv W chash) c2)) (wrex s1 (wrex t (wceq W (cs2 (cv s1) (cv t))) S) S) $;

--| A prefix of length two. (Contributed by AV, 15-May-2020.)
theorem pfx2 (V W: class):
  $ wi (wa (wcel W (cword V)) (wbr c2 (cfv W chash) cle)) (wceq (co W c2 cpfx) (cs2 (cfv cc0 W) (cfv c1 W))) $;

--| A word of length three represented as triple of ordered pairs. (Contributed by AV, 26-Jan-2021.)
theorem wrd3tpop (V W: class):
  $ wi (wa (wcel W (cword V)) (wceq (cfv W chash) c3)) (wceq W (ctp (cop cc0 (cfv cc0 W)) (cop c1 (cfv c1 W)) (cop c2 (cfv c2 W)))) $;

--| A word of length three as length 3 string. (Contributed by AV, 26-Jan-2021.)
theorem wrdlen3s3 (V W: class):
  $ wi (wa (wcel W (cword V)) (wceq (cfv W chash) c3)) (wceq W (cs3 (cfv cc0 W) (cfv c1 W) (cfv c2 W))) $;

--| Membership in a family of words of length 3. (Contributed by Thierry Arnoux, 23-Aug-2026.)
theorem s3rex {x3 y1 z: setvar} (A2 S: class):
  $ wcel S cvv $ >
  $ wb (wcel A2 (co S (co cc0 c3 cfzo) cmap)) (wrex x3 (wrex y1 (wrex z (wceq A2 (cs3 (cv x3) (cv y1) (cv z))) S) S) S) $;

--| Converse of ~ s3rex , deduction form. (Contributed by Thierry Arnoux, 23-Aug-2026.)
theorem s3rexrd (ph: wff) (S V X Y Z: class):
  $ wi ph (wcel S V) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wcel Y S) $ >
  $ wi ph (wcel Z S) $ >
  $ wi ph (wcel (cs3 X Y Z) (co S (co cc0 c3 cfzo) cmap)) $;

--| The "repeated symbol word" of length two. (Contributed by AV, 6-Nov-2018.)
theorem repsw2 (S V: class):
  $ wi (wcel S V) (wceq (co S c2 creps) (cs2 S S)) $;

--| The "repeated symbol word" of length three. (Contributed by AV, 6-Nov-2018.)
theorem repsw3 (S V: class):
  $ wi (wcel S V) (wceq (co S c3 creps) (cs3 S S S)) $;

--| Extract the last two symbols from a word. (Contributed by Alexander van der Vekens, 23-Sep-2018.)
theorem swrd2lsw (V W: class):
  $ wi (wa (wcel W (cword V)) (wbr c1 (cfv W chash) clt)) (wceq (co W (cop (co (cfv W chash) c2 cmin) (cfv W chash)) csubstr) (cs2 (cfv (co (cfv W chash) c2 cmin) W) (cfv W clsw))) $;

--| Two words of length at least two are equal if and only if they have the same prefix and the same two single symbols suffix. (Contributed by AV, 24-Sep-2018.) (Revised by AV, 12-Oct-2022.)
theorem _2swrd2eqwrdeq (U V W: class):
  $ wi (w3a (wcel W (cword V)) (wcel U (cword V)) (wbr c1 (cfv W chash) clt)) (wb (wceq W U) (wa (wceq (cfv W chash) (cfv U chash)) (w3a (wceq (co W (co (cfv W chash) c2 cmin) cpfx) (co U (co (cfv W chash) c2 cmin) cpfx)) (wceq (cfv (co (cfv W chash) c2 cmin) W) (cfv (co (cfv W chash) c2 cmin) U)) (wceq (cfv W clsw) (cfv U clsw))))) $;

--| The concatenation of a word with two singleton words equals the concatenation of the word with the doubleton word consisting of the symbols of the two singletons. (Contributed by Mario Carneiro/AV, 21-Oct-2018.) (Revised by AV, 29-Jan-2024.)
theorem ccatw2s1ccatws2 (V W X Y: class):
  $ wi (wcel W (cword V)) (wceq (co (co W (cs1 X) cconcat) (cs1 Y) cconcat) (co W (cs2 X Y) cconcat)) $;

--| Alternate proof of ~ ccat2s1fvw using words of length 2, see ~ df-s2 . A symbol of the concatenation of a word with two single symbols corresponding to the symbol of the word. (Contributed by AV, 22-Sep-2018.) (Proof shortened by Mario Carneiro/AV, 21-Oct-2018.) (Revised by AV, 28-Jan-2024.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem ccat2s1fvwALT (I V W X Y: class):
  $ wi (w3a (wcel W (cword V)) (wcel I cn0) (wbr I (cfv W chash) clt)) (wceq (cfv I (co (co W (cs1 X) cconcat) (cs1 Y) cconcat)) (cfv I W)) $;

--| Lemma 1 for ~ wrd2f1tovbij . (Contributed by Alexander van der Vekens, 27-Jul-2018.)
theorem wwlktovf {w t n: setvar} (D: class w n) (P: class) (R: class w n) (F: class w t n) (V: class) (X: class t):
  $ wceq D (crab w (w3a (wceq (cfv (cv w) chash) c2) (wceq (cfv cc0 (cv w)) P) (wcel (cpr (cfv cc0 (cv w)) (cfv c1 (cv w))) X)) (cword V)) $ >
  $ wceq R (crab n (wcel (cpr P (cv n)) X) V) $ >
  $ wceq F (cmpt t D (cfv c1 (cv t))) $ >
  $ wf D R F $;

--| Lemma 2 for ~ wrd2f1tovbij . (Contributed by Alexander van der Vekens, 27-Jul-2018.)
theorem wwlktovf1 {w t n: setvar} (D: class w n) (P: class) (R: class w n) (F: class w t n) (V: class) (X: class t):
  $ wceq D (crab w (w3a (wceq (cfv (cv w) chash) c2) (wceq (cfv cc0 (cv w)) P) (wcel (cpr (cfv cc0 (cv w)) (cfv c1 (cv w))) X)) (cword V)) $ >
  $ wceq R (crab n (wcel (cpr P (cv n)) X) V) $ >
  $ wceq F (cmpt t D (cfv c1 (cv t))) $ >
  $ wf1 D R F $;

--| Lemma 3 for ~ wrd2f1tovbij . (Contributed by Alexander van der Vekens, 27-Jul-2018.)
theorem wwlktovfo {w t n: setvar} (D: class w n) (P: class) (R: class w n) (F: class w t n) (V: class) (X: class t):
  $ wceq D (crab w (w3a (wceq (cfv (cv w) chash) c2) (wceq (cfv cc0 (cv w)) P) (wcel (cpr (cfv cc0 (cv w)) (cfv c1 (cv w))) X)) (cword V)) $ >
  $ wceq R (crab n (wcel (cpr P (cv n)) X) V) $ >
  $ wceq F (cmpt t D (cfv c1 (cv t))) $ >
  $ wi (wcel P V) (wfo D R F) $;

--| Lemma 4 for ~ wrd2f1tovbij . (Contributed by Alexander van der Vekens, 28-Jul-2018.)
theorem wwlktovf1o {w t n: setvar} (D: class w n) (P: class) (R: class w n) (F: class w t n) (V: class) (X: class t):
  $ wceq D (crab w (w3a (wceq (cfv (cv w) chash) c2) (wceq (cfv cc0 (cv w)) P) (wcel (cpr (cfv cc0 (cv w)) (cfv c1 (cv w))) X)) (cword V)) $ >
  $ wceq R (crab n (wcel (cpr P (cv n)) X) V) $ >
  $ wceq F (cmpt t D (cfv c1 (cv t))) $ >
  $ wi (wcel P V) (wf1o D R F) $;

--| There is a bijection between words of length two with a fixed first symbol contained in a pair and the symbols contained in a pair together with the fixed symbol. (Contributed by Alexander van der Vekens, 28-Jul-2018.)
theorem wrd2f1tovbij {w f2 n: setvar} (P V X: class) (Y: class w f2 n):
  $ wi (wa (wcel V Y) (wcel P V)) (wex f2 (wf1o (crab w (w3a (wceq (cfv (cv w) chash) c2) (wceq (cfv cc0 (cv w)) P) (wcel (cpr (cfv cc0 (cv w)) (cfv c1 (cv w))) X)) (cword V)) (crab n (wcel (cpr P (cv n)) X) V) (cv f2))) $;

--| A word is equal with a length 3 string iff it has length 3 and the same symbol at each position. (Contributed by AV, 12-May-2021.)
theorem eqwrds3 (A2 B2 C V W: class):
  $ wi (wa (wcel W (cword V)) (w3a (wcel A2 V) (wcel B2 V) (wcel C V))) (wb (wceq W (cs3 A2 B2 C)) (wa (wceq (cfv W chash) c3) (w3a (wceq (cfv cc0 W) A2) (wceq (cfv c1 W) B2) (wceq (cfv c2 W) C)))) $;

--| A word of length 3 is a length 3 string. (Contributed by AV, 18-May-2021.)
theorem wrdl3s3 {a b c: setvar} (V W: class):
  $ wb (wa (wcel W (cword V)) (wceq (cfv W chash) c3)) (wrex a (wrex b (wrex c (wceq W (cs3 (cv a) (cv b) (cv c))) V) V) V) $;

--| Range of a length 2 string. (Contributed by Thierry Arnoux, 19-Sep-2023.) (Proof shortened by AV, 1-Aug-2025.)
theorem s2rn (ph: wff) (D I J: class):
  $ wi ph (wcel I D) $ >
  $ wi ph (wcel J D) $ >
  $ wi ph (wceq (crn (cs2 I J)) (cpr I J)) $;

--| Range of a length 3 string. (Contributed by Thierry Arnoux, 19-Sep-2023.) (Proof shortened by AV, 1-Aug-2025.)
theorem s3rn (ph: wff) (D I J K: class):
  $ wi ph (wcel I D) $ >
  $ wi ph (wcel J D) $ >
  $ wi ph (wcel K D) $ >
  $ wi ph (wceq (crn (cs3 I J K)) (ctp I J K)) $;

--| Range of a length 7 string. (Contributed by AV, 30-Jul-2025.)
theorem s7rn (ph: wff) (A2 B2 C D E F G V: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wcel C V) $ >
  $ wi ph (wcel D V) $ >
  $ wi ph (wcel E V) $ >
  $ wi ph (wcel F V) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wceq (crn (cs7 A2 B2 C D E F G)) (cun (cun (ctp A2 B2 C) (csn D)) (ctp E F G))) $;

--| A length 7 word with mutually different symbols is a one-to-one function onto the set of the symbols. (Contributed by AV, 2-Aug-2025.)
theorem s7f1o (A2 B2 C D E F G K V: class):
  $ wi (wa (w3a (w3a (wcel A2 V) (wcel B2 V) (wcel C V)) (wcel D V) (w3a (wcel E V) (wcel F V) (wcel G V))) (wa (w3a (wa (w3a (wne A2 B2) (wne A2 C) (wne A2 D)) (w3a (wne A2 E) (wne A2 F) (wne A2 G))) (wa (wa (wne B2 C) (wne B2 D)) (w3a (wne B2 E) (wne B2 F) (wne B2 G))) (wa (wne C D) (w3a (wne C E) (wne C F) (wne C G)))) (wa (w3a (wne D E) (wne D F) (wne D G)) (w3a (wne E F) (wne E G) (wne F G))))) (wi (wceq K (cs7 A2 B2 C D E F G)) (wf1o (co cc0 c7 cfzo) (cun (cun (ctp A2 B2 C) (csn D)) (ctp E F G)) K)) $;

--| The singletons consisting of length 3 strings which have distinct third symbols are disjunct. (Contributed by AV, 17-May-2021.)
theorem s3sndisj {c: setvar} (A2 B2 X Y Z: class):
  $ wi (wa (wcel A2 X) (wcel B2 Y)) (wdisj c Z (csn (cs3 A2 B2 (cv c)))) $;

--| The union of singletons consisting of length 3 strings which have distinct first and third symbols are disjunct. (Contributed by AV, 17-May-2021.)
theorem s3iunsndisj {a c: setvar} (B2 X Y Z: class):
  $ wi (wcel B2 X) (wdisj a Y (ciun c (cdif Z (csn (cv a))) (csn (cs3 (cv a) B2 (cv c))))) $;

--| Letterwise operations on word concatenations. (Contributed by Thierry Arnoux, 28-Sep-2018.)
theorem ofccat (ph: wff) (R S T E F G H: class):
  $ wi ph (wcel E (cword S)) $ >
  $ wi ph (wcel F (cword S)) $ >
  $ wi ph (wcel G (cword T)) $ >
  $ wi ph (wcel H (cword T)) $ >
  $ wi ph (wceq (cfv E chash) (cfv G chash)) $ >
  $ wi ph (wceq (cfv F chash) (cfv H chash)) $ >
  $ wi ph (wceq (co (co E F cconcat) (co G H cconcat) (cof R)) (co (co E G (cof R)) (co F H (cof R)) cconcat)) $;

--| Letterwise operations on a single letter word. (Contributed by Thierry Arnoux, 7-Oct-2018.)
theorem ofs1 (A2 B2 R S T: class):
  $ wi (wa (wcel A2 S) (wcel B2 T)) (wceq (co (cs1 A2) (cs1 B2) (cof R)) (cs1 (co A2 B2 R))) $;

--| Letterwise operations on a double letter word. (Contributed by Thierry Arnoux, 7-Oct-2018.)
theorem ofs2 (A2 B2 C D R S T: class):
  $ wi (wa (wa (wcel A2 S) (wcel B2 S)) (wa (wcel C T) (wcel D T))) (wceq (co (cs2 A2 B2) (cs2 C D) (cof R)) (cs2 (co A2 C R) (co B2 D R))) $;

--| Subset deduction for composition of two classes. (Contributed by RP, 24-Dec-2019.)
theorem coss12d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wss C D) $ >
  $ wi ph (wss (ccom A2 C) (ccom B2 D)) $;

--| The composition of subclasses of a transitive relation is a subclass of that relation. (Contributed by RP, 24-Dec-2019.)
theorem trrelssd (ph: wff) (R S T: class):
  $ wi ph (wss (ccom R R) R) $ >
  $ wi ph (wss S R) $ >
  $ wi ph (wss T R) $ >
  $ wi ph (wss (ccom S T) R) $;

--| The most interesting case of the composition of two Cartesian products. (Contributed by RP, 24-Dec-2019.)
theorem xpcogend (ph: wff) (A2 B2 C D: class):
  $ wi ph (wne (cin B2 C) c0) $ >
  $ wi ph (wceq (ccom (cxp C D) (cxp A2 B2)) (cxp A2 D)) $;

--| If two classes are not disjoint, then the composition of their Cartesian product with itself is idempotent. (Contributed by RP, 24-Dec-2019.)
theorem xpcoidgend (ph: wff) (A2 B2: class):
  $ wi ph (wne (cin A2 B2) c0) $ >
  $ wi ph (wceq (ccom (cxp A2 B2) (cxp A2 B2)) (cxp A2 B2)) $;

--| Two ways of saying that the composition of two relations is included in a third relation. See its special instance ~ cotr2 for the main application. (Contributed by RP, 22-Mar-2020.)
theorem cotr2g {x3 y1 z: setvar} (A2 B2 C D: class) (E: class x3) (F: class x3 y1):
  $ wss (cdm B2) D $ >
  $ wss (cin (crn B2) (cdm A2)) E $ >
  $ wss (crn A2) F $ >
  $ wb (wss (ccom A2 B2) C) (wral x3 (wral y1 (wral z (wi (wa (wbr (cv x3) (cv y1) B2) (wbr (cv y1) (cv z) A2)) (wbr (cv x3) (cv z) C)) F) E) D) $;

--| Two ways of saying a relation is transitive. Special instance of ~ cotr2g . (Contributed by RP, 22-Mar-2020.)
theorem cotr2 {x3 y1 z: setvar} (A2: class) (B2: class x3) (C: class x3 y1) (R: class):
  $ wss (cdm R) A2 $ >
  $ wss (cin (cdm R) (crn R)) B2 $ >
  $ wss (crn R) C $ >
  $ wb (wss (ccom R R) R) (wral x3 (wral y1 (wral z (wi (wa (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv z) R)) (wbr (cv x3) (cv z) R)) C) B2) A2) $;

--| Two ways of saying a relation is transitive. (Contributed by RP, 22-Mar-2020.)
theorem cotr3 {x3 y1 z: setvar} (A2: class) (B2: class x3) (C: class x3 y1) (R: class):
  $ wceq A2 (cdm R) $ >
  $ wceq B2 (cin A2 C) $ >
  $ wceq C (crn R) $ >
  $ wb (wss (ccom R R) R) (wral x3 (wral y1 (wral z (wi (wa (wbr (cv x3) (cv y1) R) (wbr (cv y1) (cv z) R)) (wbr (cv x3) (cv z) R)) C) B2) A2) $;

--| Deduction about composition of classes with no relational content in common. (Contributed by RP, 24-Dec-2019.)
theorem coemptyd (ph: wff) (A2 B2: class):
  $ wi ph (wceq (cin (cdm A2) (crn B2)) c0) $ >
  $ wi ph (wceq (ccom A2 B2) c0) $;

--| The cross product is always a transitive relation. (Contributed by RP, 24-Dec-2019.)
theorem xptrrel (A2 B2: class):
  $ wss (ccom (cxp A2 B2) (cxp A2 B2)) (cxp A2 B2) $;

--| The empty class is a transitive relation. (Contributed by RP, 24-Dec-2019.)
theorem _0trrel:
  $ wss (ccom c0 c0) c0 $;

--| Equality implies bijection. (Contributed by RP, 9-May-2020.)
theorem cleq1lem (ph: wff) (A2 B2 C: class):
  $ wi (wceq A2 B2) (wb (wa (wss A2 C) ph) (wa (wss B2 C) ph)) $;

--| Equality of relations implies equality of closures. (Contributed by RP, 9-May-2020.)
theorem cleq1 {r: setvar} (ph: wff r) (R S: class):
  $ wi (wceq R S) (wceq (cint (cab r (wa (wss R (cv r)) ph))) (cint (cab r (wa (wss S (cv r)) ph)))) $;

--| The closure of a subclass is a subclass of the closure. (Contributed by RP, 16-May-2020.)
theorem clsslem {r: setvar} (ph: wff r) (R S: class):
  $ wi (wss R S) (wss (cint (cab r (wa (wss R (cv r)) ph))) (cint (cab r (wa (wss S (cv r)) ph)))) $;

--| Extend class notation to include the transitive closure symbol.
term ctcl: class;

--| Extend class notation with reflexive-transitive closure.
term crtcl: class;

--| Transitive closure of a relation. This is the smallest superset which has the transitive property. (Contributed by FL, 27-Jun-2011.)
axiom df_trcl {x3 z: setvar}:
  $ wceq ctcl (cmpt x3 cvv (cint (cab z (wa (wss (cv x3) (cv z)) (wss (ccom (cv z) (cv z)) (cv z)))))) $;

--| Reflexive-transitive closure of a relation. This is the smallest superset which is reflexive property over all elements of its domain and range and has the transitive property. (Contributed by FL, 27-Jun-2011.)
axiom df_rtrcl {x3 z: setvar}:
  $ wceq crtcl (cmpt x3 cvv (cint (cab z (w3a (wss (cres cid (cun (cdm (cv x3)) (crn (cv x3)))) (cv z)) (wss (cv x3) (cv z)) (wss (ccom (cv z) (cv z)) (cv z)))))) $;

--| Equality of relations implies equality of transitive closures. (Contributed by RP, 9-May-2020.)
theorem trcleq1 {r: setvar} (R S: class):
  $ wi (wceq R S) (wceq (cint (cab r (wa (wss R (cv r)) (wss (ccom (cv r) (cv r)) (cv r))))) (cint (cab r (wa (wss S (cv r)) (wss (ccom (cv r) (cv r)) (cv r)))))) $;

--| The transitive closure (as a relation) of a subclass is a subclass of the transitive closure. (Contributed by RP, 3-May-2020.)
theorem trclsslem {r: setvar} (R S: class):
  $ wi (wss R S) (wss (cint (cab r (wa (wss R (cv r)) (wss (ccom (cv r) (cv r)) (cv r))))) (cint (cab r (wa (wss S (cv r)) (wss (ccom (cv r) (cv r)) (cv r)))))) $;

--| Equality implies bijection. (Contributed by RP, 5-May-2020.)
theorem trcleq2lem (A2 B2 R: class):
  $ wi (wceq A2 B2) (wb (wa (wss R A2) (wss (ccom A2 A2) A2)) (wa (wss R B2) (wss (ccom B2 B2) B2))) $;

--| Change of bound variable in class of all transitive relations which are supersets of a relation. (Contributed by RP, 5-May-2020.)
theorem cvbtrcl {x3 y1: setvar} (R: class):
  $ wceq (cab x3 (wa (wss R (cv x3)) (wss (ccom (cv x3) (cv x3)) (cv x3)))) (cab y1 (wa (wss R (cv y1)) (wss (ccom (cv y1) (cv y1)) (cv y1)))) $;

--| Equality implies bijection. (Contributed by RP, 9-May-2020.)
theorem trcleq12lem (A2 B2 R S: class):
  $ wi (wa (wceq R S) (wceq A2 B2)) (wb (wa (wss R A2) (wss (ccom A2 A2) A2)) (wa (wss S B2) (wss (ccom B2 B2) B2))) $;

--| Existence of relation implies existence of union with Cartesian product of domain and range. (Contributed by RP, 5-May-2020.)
theorem trclexlem (R V: class):
  $ wi (wcel R V) (wcel (cun R (cxp (cdm R) (crn R))) cvv) $;

--| If a relation exists then the class of transitive relations which are supersets of that relation is not empty. (Contributed by RP, 28-Apr-2020.)
theorem trclublem {x3: setvar} (R: class) (V: class x3):
  $ wi (wcel R V) (wcel (cun R (cxp (cdm R) (crn R))) (cab x3 (wa (wss R (cv x3)) (wss (ccom (cv x3) (cv x3)) (cv x3))))) $;

--| The Cartesian product of the domain and range of a relation is an upper bound for its transitive closure. (Contributed by RP, 2-Jan-2020.) (Revised by RP, 28-Apr-2020.) (Revised by AV, 26-Mar-2021.)
theorem trclubi {s1: setvar} (R: class):
  $ wrel R $ >
  $ wcel R cvv $ >
  $ wss (cint (cab s1 (wa (wss R (cv s1)) (wss (ccom (cv s1) (cv s1)) (cv s1))))) (cxp (cdm R) (crn R)) $;

--| The union with the Cartesian product of its domain and range is an upper bound for a set's transitive closure. (Contributed by RP, 3-Jan-2020.) (Revised by RP, 28-Apr-2020.) (Revised by AV, 26-Mar-2021.)
theorem trclubgi {s1: setvar} (R: class):
  $ wcel R cvv $ >
  $ wss (cint (cab s1 (wa (wss R (cv s1)) (wss (ccom (cv s1) (cv s1)) (cv s1))))) (cun R (cxp (cdm R) (crn R))) $;

--| The Cartesian product of the domain and range of a relation is an upper bound for its transitive closure. (Contributed by RP, 17-May-2020.)
theorem trclub {r: setvar} (R: class) (V: class r):
  $ wi (wa (wcel R V) (wrel R)) (wss (cint (cab r (wa (wss R (cv r)) (wss (ccom (cv r) (cv r)) (cv r))))) (cxp (cdm R) (crn R))) $;

--| The union with the Cartesian product of its domain and range is an upper bound for a set's transitive closure (as a relation). (Contributed by RP, 17-May-2020.)
theorem trclubg {r: setvar} (R: class) (V: class r):
  $ wi (wcel R V) (wss (cint (cab r (wa (wss R (cv r)) (wss (ccom (cv r) (cv r)) (cv r))))) (cun R (cxp (cdm R) (crn R)))) $;

--| The transitive closure of a relation. (Contributed by RP, 28-Apr-2020.)
theorem trclfv {x3: setvar} (R: class) (V: class x3):
  $ wi (wcel R V) (wceq (cfv R ctcl) (cint (cab x3 (wa (wss R (cv x3)) (wss (ccom (cv x3) (cv x3)) (cv x3)))))) $;

--| Two ways to express a binary relation which is the intersection of a class. (Contributed by RP, 4-Apr-2020.)
theorem brintclab {x3: setvar} (ph: wff x3) (A2 B2: class):
  $ wb (wbr A2 B2 (cint (cab x3 ph))) (wal x3 (wi ph (wcel (cop A2 B2) (cv x3)))) $;

--| Two ways of expressing the transitive closure of a binary relation. (Contributed by RP, 9-May-2020.)
theorem brtrclfv {r: setvar} (A2 B2 R: class) (V: class r):
  $ wi (wcel R V) (wb (wbr A2 B2 (cfv R ctcl)) (wal r (wi (wa (wss R (cv r)) (wss (ccom (cv r) (cv r)) (cv r))) (wbr A2 B2 (cv r))))) $;

--| Two ways of expressing the transitive closure of the converse of a binary relation. (Contributed by RP, 9-May-2020.)
theorem brcnvtrclfv {r: setvar} (A2 B2 R: class) (U V W: class r):
  $ wi (w3a (wcel R U) (wcel A2 V) (wcel B2 W)) (wb (wbr A2 B2 (ccnv (cfv R ctcl))) (wal r (wi (wa (wss R (cv r)) (wss (ccom (cv r) (cv r)) (cv r))) (wbr B2 A2 (cv r))))) $;

--| Two ways of expressing the transitive closure of the converse of a binary relation. (Contributed by RP, 10-May-2020.)
theorem brtrclfvcnv {r: setvar} (A2 B2 R: class) (V: class r):
  $ wi (wcel R V) (wb (wbr A2 B2 (cfv (ccnv R) ctcl)) (wal r (wi (wa (wss (ccnv R) (cv r)) (wss (ccom (cv r) (cv r)) (cv r))) (wbr A2 B2 (cv r))))) $;

--| Two ways of expressing the transitive closure of the converse of the converse of a binary relation. (Contributed by RP, 10-May-2020.)
theorem brcnvtrclfvcnv {r: setvar} (A2 B2 R: class) (U V W: class r):
  $ wi (w3a (wcel R U) (wcel A2 V) (wcel B2 W)) (wb (wbr A2 B2 (ccnv (cfv (ccnv R) ctcl))) (wal r (wi (wa (wss (ccnv R) (cv r)) (wss (ccom (cv r) (cv r)) (cv r))) (wbr B2 A2 (cv r))))) $;

--| The transitive closure (as a relation) of a subclass is a subclass of the transitive closure. (Contributed by RP, 3-May-2020.)
theorem trclfvss (R S V W: class):
  $ wi (w3a (wcel R V) (wcel S W) (wss R S)) (wss (cfv R ctcl) (cfv S ctcl)) $;

--| The transitive closure of a relation has an upper bound. (Contributed by RP, 28-Apr-2020.)
theorem trclfvub (R V: class):
  $ wi (wcel R V) (wss (cfv R ctcl) (cun R (cxp (cdm R) (crn R)))) $;

--| The transitive closure of a relation has a lower bound. (Contributed by RP, 28-Apr-2020.)
theorem trclfvlb (R V: class):
  $ wi (wcel R V) (wss R (cfv R ctcl)) $;

--| The transitive closure of a relation is a transitive relation. (Contributed by RP, 29-Apr-2020.)
theorem trclfvcotr (R V: class):
  $ wi (wcel R V) (wss (ccom (cfv R ctcl) (cfv R ctcl)) (cfv R ctcl)) $;

--| The transitive closure of a relation has a lower bound. (Contributed by RP, 8-May-2020.)
theorem trclfvlb2 (R V: class):
  $ wi (wcel R V) (wss (ccom R R) (cfv R ctcl)) $;

--| The transitive closure of a relation has a lower bound. (Contributed by RP, 8-May-2020.)
theorem trclfvlb3 (R V: class):
  $ wi (wcel R V) (wss (cun R (ccom R R)) (cfv R ctcl)) $;

--| The transitive closure of a transitive relation. (Contributed by RP, 28-Apr-2020.)
theorem cotrtrclfv (R V: class):
  $ wi (wa (wcel R V) (wss (ccom R R) R)) (wceq (cfv R ctcl) R) $;

--| The transitive closure of a relation is idempotent. (Contributed by RP, 29-Apr-2020.)
theorem trclidm (R V: class):
  $ wi (wcel R V) (wceq (cfv (cfv R ctcl) ctcl) (cfv R ctcl)) $;

--| Transitive closure of a union of relations. (Contributed by RP, 5-May-2020.)
theorem trclun (R S V W: class):
  $ wi (wa (wcel R V) (wcel S W)) (wceq (cfv (cun R S) ctcl) (cfv (cun (cfv R ctcl) (cfv S ctcl)) ctcl)) $;

--| The value of the transitive closure of a relation is a superset or (for proper classes) the empty set. (Contributed by RP, 8-May-2020.)
theorem trclfvg (R: class):
  $ wo (wss R (cfv R ctcl)) (wceq (cfv R ctcl) c0) $;

--| The value of the transitive closure of a relation is always a transitive relation. (Contributed by RP, 8-May-2020.)
theorem trclfvcotrg (R: class):
  $ wss (ccom (cfv R ctcl) (cfv R ctcl)) (cfv R ctcl) $;

--| The transitive closure of a relation is a relation. (Contributed by RP, 9-May-2020.)
theorem reltrclfv (R V: class):
  $ wi (wa (wcel R V) (wrel R)) (wrel (cfv R ctcl)) $;

--| The domain of the transitive closure is equal to the domain of the relation. (Contributed by RP, 9-May-2020.)
theorem dmtrclfv (R V: class):
  $ wi (wcel R V) (wceq (cdm (cfv R ctcl)) (cdm R)) $;

--| Extend class notation to include relation exponentiation.
term crelexp: class;

--| Definition of repeated composition of a relation with itself, aka relation exponentiation. (Contributed by Drahflow, 12-Nov-2015.) (Revised by RP, 22-May-2020.)
axiom df_relexp {x3 y1 z n r: setvar}:
  $ wceq crelexp (cmpo r n cvv cn0 (cif (wceq (cv n) cc0) (cres cid (cun (cdm (cv r)) (crn (cv r)))) (cfv (cv n) (cseq (cmpo x3 y1 cvv cvv (ccom (cv x3) (cv r))) (cmpt z cvv (cv r)) c1)))) $;

--| The domain of the repeated composition of a relation is a relation. (Contributed by AV, 12-Jul-2024.)
theorem reldmrelexp:
  $ wrel (cdm crelexp) $;

--| A relation composed zero times is the (restricted) identity. (Contributed by RP, 22-May-2020.)
theorem relexp0g (R V: class):
  $ wi (wcel R V) (wceq (co R cc0 crelexp) (cres cid (cun (cdm R) (crn R)))) $;

--| A relation composed zero times is the (restricted) identity. (Contributed by RP, 22-May-2020.)
theorem relexp0 (R V: class):
  $ wi (wa (wcel R V) (wrel R)) (wceq (co R cc0 crelexp) (cres cid (cuni (cuni R)))) $;

--| A relation composed zero times is the (restricted) identity. (Contributed by Drahflow, 12-Nov-2015.) (Revised by RP, 30-May-2020.) (Revised by AV, 12-Jul-2024.)
theorem relexp0d (ph: wff) (R V: class):
  $ wi ph (wrel R) $ >
  $ wi ph (wcel R V) $ >
  $ wi ph (wceq (co R cc0 crelexp) (cres cid (cuni (cuni R)))) $;

--| A reduction for relation exponentiation to the right. (Contributed by RP, 22-May-2020.)
theorem relexpsucnnr (R N V: class):
  $ wi (wa (wcel R V) (wcel N cn)) (wceq (co R (co N c1 caddc) crelexp) (ccom (co R N crelexp) R)) $;

--| A relation composed once is itself. (Contributed by RP, 22-May-2020.)
theorem relexp1g (R V: class):
  $ wi (wcel R V) (wceq (co R c1 crelexp) R) $;

--| Identity relation is equal to relational exponentiation to the first power. (Contributed by RP, 9-Jun-2020.)
theorem dfid5 {x3: setvar}:
  $ wceq cid (cmpt x3 cvv (co (cv x3) c1 crelexp)) $;

--| Identity relation expressed as indexed union of relational powers. (Contributed by RP, 9-Jun-2020.)
theorem dfid6 {x3 n: setvar}:
  $ wceq cid (cmpt x3 cvv (ciun n (csn c1) (co (cv x3) (cv n) crelexp))) $;

--| A relation composed once is itself. (Contributed by Drahflow, 12-Nov-2015.) (Revised by RP, 30-May-2020.) (Revised by AV, 12-Jul-2024.)
theorem relexp1d (ph: wff) (R V: class):
  $ wi ph (wcel R V) $ >
  $ wi ph (wceq (co R c1 crelexp) R) $;

--| A reduction for relation exponentiation to the left. (Contributed by RP, 23-May-2020.)
theorem relexpsucnnl (R N V: class):
  $ wi (wa (wcel R V) (wcel N cn)) (wceq (co R (co N c1 caddc) crelexp) (ccom R (co R N crelexp))) $;

--| A reduction for relation exponentiation to the left. (Contributed by RP, 23-May-2020.)
theorem relexpsucl (R N V: class):
  $ wi (w3a (wcel R V) (wrel R) (wcel N cn0)) (wceq (co R (co N c1 caddc) crelexp) (ccom R (co R N crelexp))) $;

--| A reduction for relation exponentiation to the right. (Contributed by RP, 23-May-2020.)
theorem relexpsucr (R N V: class):
  $ wi (w3a (wcel R V) (wrel R) (wcel N cn0)) (wceq (co R (co N c1 caddc) crelexp) (ccom (co R N crelexp) R)) $;

--| A reduction for relation exponentiation to the right. (Contributed by Drahflow, 12-Nov-2015.) (Revised by RP, 30-May-2020.) (Revised by AV, 12-Jul-2024.)
theorem relexpsucrd (ph: wff) (R N: class):
  $ wi ph (wrel R) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (co R (co N c1 caddc) crelexp) (ccom (co R N crelexp) R)) $;

--| A reduction for relation exponentiation to the left. (Contributed by Drahflow, 12-Nov-2015.) (Revised by RP, 30-May-2020.) (Revised by AV, 12-Jul-2024.)
theorem relexpsucld (ph: wff) (R N: class):
  $ wi ph (wrel R) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (co R (co N c1 caddc) crelexp) (ccom R (co R N crelexp))) $;

--| Commutation of converse and relation exponentiation. (Contributed by RP, 23-May-2020.)
theorem relexpcnv (R N V: class):
  $ wi (wa (wcel N cn0) (wcel R V)) (wceq (ccnv (co R N crelexp)) (co (ccnv R) N crelexp)) $;

--| Commutation of converse and relation exponentiation. (Contributed by Drahflow, 12-Nov-2015.) (Revised by RP, 30-May-2020.) (Revised by AV, 12-Jul-2024.)
theorem relexpcnvd (ph: wff) (R N V: class):
  $ wi ph (wcel R V) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (ccnv (co R N crelexp)) (co (ccnv R) N crelexp)) $;

--| The exponentiation of a class to zero is a relation. (Contributed by RP, 23-May-2020.)
theorem relexp0rel (R V: class):
  $ wi (wcel R V) (wrel (co R cc0 crelexp)) $;

--| The exponentiation of a class is a relation except when the exponent is one and the class is not a relation. (Contributed by RP, 23-May-2020.)
theorem relexprelg (R N V: class):
  $ wi (w3a (wcel N cn0) (wcel R V) (wi (wceq N c1) (wrel R))) (wrel (co R N crelexp)) $;

--| The exponentiation of a relation is a relation. (Contributed by RP, 23-May-2020.)
theorem relexprel (R N V: class):
  $ wi (w3a (wcel N cn0) (wcel R V) (wrel R)) (wrel (co R N crelexp)) $;

--| The exponentiation of a relation is a relation. (Contributed by Drahflow, 12-Nov-2015.) (Revised by RP, 30-May-2020.) (Revised by AV, 12-Jul-2024.)
theorem relexpreld (ph: wff) (R N: class):
  $ wi ph (wrel R) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wrel (co R N crelexp)) $;

--| The domain of an exponentiation of a relation a subset of the relation's field. (Contributed by RP, 23-May-2020.)
theorem relexpnndm (R N V: class):
  $ wi (wa (wcel N cn) (wcel R V)) (wss (cdm (co R N crelexp)) (cdm R)) $;

--| The domain of an exponentiation of a relation a subset of the relation's field. (Contributed by RP, 23-May-2020.)
theorem relexpdmg (R N V: class):
  $ wi (wa (wcel N cn0) (wcel R V)) (wss (cdm (co R N crelexp)) (cun (cdm R) (crn R))) $;

--| The domain of an exponentiation of a relation a subset of the relation's field. (Contributed by RP, 23-May-2020.)
theorem relexpdm (R N V: class):
  $ wi (wa (wcel N cn0) (wcel R V)) (wss (cdm (co R N crelexp)) (cuni (cuni R))) $;

--| The domain of an exponentiation of a relation a subset of the relation's field. (Contributed by Drahflow, 12-Nov-2015.) (Revised by RP, 30-May-2020.) (Revised by AV, 12-Jul-2024.)
theorem relexpdmd (ph: wff) (R N: class):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wss (cdm (co R N crelexp)) (cuni (cuni R))) $;

--| The range of an exponentiation of a relation a subset of the relation's field. (Contributed by RP, 23-May-2020.)
theorem relexpnnrn (R N V: class):
  $ wi (wa (wcel N cn) (wcel R V)) (wss (crn (co R N crelexp)) (crn R)) $;

--| The range of an exponentiation of a relation a subset of the relation's field. (Contributed by RP, 23-May-2020.)
theorem relexprng (R N V: class):
  $ wi (wa (wcel N cn0) (wcel R V)) (wss (crn (co R N crelexp)) (cun (cdm R) (crn R))) $;

--| The range of an exponentiation of a relation a subset of the relation's field. (Contributed by RP, 23-May-2020.)
theorem relexprn (R N V: class):
  $ wi (wa (wcel N cn0) (wcel R V)) (wss (crn (co R N crelexp)) (cuni (cuni R))) $;

--| The range of an exponentiation of a relation a subset of the relation's field. (Contributed by Drahflow, 12-Nov-2015.) (Revised by RP, 30-May-2020.) (Revised by AV, 12-Jul-2024.)
theorem relexprnd (ph: wff) (R N: class):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wss (crn (co R N crelexp)) (cuni (cuni R))) $;

--| The field of an exponentiation of a relation a subset of the relation's field. (Contributed by RP, 23-May-2020.)
theorem relexpfld (R N V: class):
  $ wi (wa (wcel N cn0) (wcel R V)) (wss (cuni (cuni (co R N crelexp))) (cuni (cuni R))) $;

--| The field of an exponentiation of a relation a subset of the relation's field. (Contributed by Drahflow, 12-Nov-2015.) (Revised by RP, 30-May-2020.) (Revised by AV, 12-Jul-2024.)
theorem relexpfldd (ph: wff) (R N: class):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wss (cuni (cuni (co R N crelexp))) (cuni (cuni R))) $;

--| Relation composition becomes addition under exponentiation. (Contributed by RP, 23-May-2020.)
theorem relexpaddnn (R M N V: class):
  $ wi (w3a (wcel N cn) (wcel M cn) (wcel R V)) (wceq (ccom (co R N crelexp) (co R M crelexp)) (co R (co N M caddc) crelexp)) $;

--| The exponentiation of a class to an integer greater than 1 is a relation. (Contributed by RP, 23-May-2020.)
theorem relexpuzrel (R N V: class):
  $ wi (wa (wcel N (cfv c2 cuz)) (wcel R V)) (wrel (co R N crelexp)) $;

--| Relation composition becomes addition under exponentiation except when the exponents total to one and the class isn't a relation. (Contributed by RP, 30-May-2020.)
theorem relexpaddg (R M N V: class):
  $ wi (wa (wcel N cn0) (w3a (wcel M cn0) (wcel R V) (wi (wceq (co N M caddc) c1) (wrel R)))) (wceq (ccom (co R N crelexp) (co R M crelexp)) (co R (co N M caddc) crelexp)) $;

--| Relation composition becomes addition under exponentiation. (Contributed by Drahflow, 12-Nov-2015.) (Revised by RP, 30-May-2020.) (Revised by AV, 12-Jul-2024.)
theorem relexpaddd (ph: wff) (R M N: class):
  $ wi ph (wrel R) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wceq (ccom (co R N crelexp) (co R M crelexp)) (co R (co N M caddc) crelexp)) $;

--| Extend class notation with recursively defined reflexive, transitive closure.
term crtrcl: class;

--| The reflexive, transitive closure of a relation constructed as the union of all finite exponentiations. (Contributed by Drahflow, 12-Nov-2015.)
axiom df_rtrclrec {n r: setvar}:
  $ wceq crtrcl (cmpt r cvv (ciun n cn0 (co (cv r) (cv n) crelexp))) $;

--| The reflexive, transitive closure is indeed a closure. (Contributed by Drahflow, 12-Nov-2015.) (Revised by RP, 30-May-2020.) (Revised by AV, 12-Jul-2024.)
theorem rtrclreclem1 (ph: wff) (R V: class):
  $ wi ph (wcel R V) $ >
  $ wi ph (wss R (cfv R crtrcl)) $;

--| If two elements are connected by a reflexive, transitive closure, then they are connected via ` n ` instances the relation, for some ` n ` . (Contributed by Drahflow, 12-Nov-2015.) (Revised by AV, 13-Jul-2024.)
theorem dfrtrclrec2 {n: setvar} (ph: wff n) (A2 B2 R: class):
  $ wi ph (wrel R) $ >
  $ wi ph (wb (wbr A2 B2 (cfv R crtrcl)) (wrex n (wbr A2 B2 (co R (cv n) crelexp)) cn0)) $;

--| The reflexive, transitive closure is indeed reflexive. (Contributed by Drahflow, 12-Nov-2015.) (Revised by RP, 30-May-2020.) (Revised by AV, 13-Jul-2024.)
theorem rtrclreclem2 (ph: wff) (R V: class):
  $ wi ph (wrel R) $ >
  $ wi ph (wcel R V) $ >
  $ wi ph (wss (cres cid (cuni (cuni R))) (cfv R crtrcl)) $;

--| The reflexive, transitive closure is indeed transitive. (Contributed by Drahflow, 12-Nov-2015.) (Revised by RP, 30-May-2020.) (Revised by AV, 13-Jul-2024.)
theorem rtrclreclem3 (ph: wff) (R: class):
  $ wi ph (wrel R) $ >
  $ wi ph (wss (ccom (cfv R crtrcl) (cfv R crtrcl)) (cfv R crtrcl)) $;

--| The reflexive, transitive closure of ` R ` is the smallest reflexive, transitive relation which contains ` R ` and the identity. (Contributed by Drahflow, 12-Nov-2015.) (Revised by RP, 30-May-2020.) (Revised by AV, 13-Jul-2024.)
theorem rtrclreclem4 {s1: setvar} (ph: wff) (R: class s1):
  $ wi ph (wrel R) $ >
  $ wi ph (wal s1 (wi (w3a (wss (cres cid (cun (cdm R) (crn R))) (cv s1)) (wss R (cv s1)) (wss (ccom (cv s1) (cv s1)) (cv s1))) (wss (cfv R crtrcl) (cv s1)))) $;

--| The two definitions ` t* ` and ` t*rec ` of the reflexive, transitive closure coincide if ` R ` is indeed a relation. (Contributed by Drahflow, 12-Nov-2015.) (Revised by RP, 30-May-2020.) (Revised by AV, 13-Jul-2024.)
theorem dfrtrcl2 (ph: wff) (R: class):
  $ wi ph (wrel R) $ >
  $ wi ph (wceq (cfv R crtcl) (cfv R crtrcl)) $;

--| Principle of transitive induction, finite and non-class version. The first three hypotheses give various existences, the next three give necessary substitutions and the last two are the basis and the induction hypothesis. (Contributed by Drahflow, 12-Nov-2015.) (Revised by RP, 30-May-2020.) (Proof shortened by Peter Mazsa, 2-Oct-2022.) (Revised by AV, 13-Jul-2024.)
theorem relexpindlem {x3 i j: setvar} (ph: wff i) (ps: wff x3) (ch th: wff x3 j) (et: wff) (R S: class) (n: setvar) (V: class x3 i j):
  $ wi et (wrel R) $ >
  $ wi et (wcel S V) $ >
  $ wi (wceq (cv i) S) (wb ph ch) $ >
  $ wi (wceq (cv i) (cv x3)) (wb ph ps) $ >
  $ wi (wceq (cv i) (cv j)) (wb ph th) $ >
  $ wi et ch $ >
  $ wi et (wi (wbr (cv j) (cv x3) R) (wi th ps)) $ >
  $ wi et (wi (wcel (cv n) cn0) (wi (wbr S (cv x3) (co R (cv n) crelexp)) ps)) $;

--| Principle of transitive induction, finite version. The first three hypotheses give various existences, the next four give necessary substitutions and the last two are the basis and the induction hypothesis. (Contributed by Drahflow, 12-Nov-2015.) (Revised by RP, 30-May-2020.) (Revised by AV, 13-Jul-2024.)
theorem relexpind {x3 i j: setvar} (ph: wff i) (ps: wff x3) (ch th: wff x3 j) (ta: wff i j) (et: wff) (R S: class) (n: setvar) (V W: class x3 i j) (X: class i j):
  $ wi et (wrel R) $ >
  $ wi et (wcel S V) $ >
  $ wi et (wcel X W) $ >
  $ wi (wceq (cv i) S) (wb ph ch) $ >
  $ wi (wceq (cv i) (cv x3)) (wb ph ps) $ >
  $ wi (wceq (cv i) (cv j)) (wb ph th) $ >
  $ wi (wceq (cv x3) X) (wb ps ta) $ >
  $ wi et ch $ >
  $ wi et (wi (wbr (cv j) (cv x3) R) (wi th ps)) $ >
  $ wi et (wi (wcel (cv n) cn0) (wi (wbr S X (co R (cv n) crelexp)) ta)) $;

--| Principle of transitive induction. The first three hypotheses give various existences, the next four give necessary substitutions and the last two are the basis and the induction step. (Contributed by Drahflow, 12-Nov-2015.) (Revised by AV, 13-Jul-2024.)
theorem rtrclind {x3 i j: setvar} (ph: wff i) (ps: wff x3) (ch th: wff x3 j) (ta: wff i j) (et: wff) (R S: class) (V W: class x3 i j) (X: class i j):
  $ wi et (wrel R) $ >
  $ wi et (wcel S V) $ >
  $ wi et (wcel X W) $ >
  $ wi (wceq (cv i) S) (wb ph ch) $ >
  $ wi (wceq (cv i) (cv x3)) (wb ph ps) $ >
  $ wi (wceq (cv i) (cv j)) (wb ph th) $ >
  $ wi (wceq (cv x3) X) (wb ps ta) $ >
  $ wi et ch $ >
  $ wi et (wi (wbr (cv j) (cv x3) R) (wi th ps)) $ >
  $ wi et (wi (wbr S X (cfv R crtcl)) ta) $;

--| Extend class notation with function shifter.
term cshi: class;

--| Define a function shifter. This operation offsets the value argument of a function (ordinarily on a subset of ` CC ` ) and produces a new function on ` CC ` . See ~ shftval for its value. (Contributed by NM, 20-Jul-2005.)
axiom df_shft {x3 y1 z f2: setvar}:
  $ wceq cshi (cmpo f2 x3 cvv cc (copab y1 z (wa (wcel (cv y1) cc) (wbr (co (cv y1) (cv x3) cmin) (cv z) (cv f2))))) $;

--| Two ways to write a shifted set ` ( B + A ) ` . (Contributed by Mario Carneiro, 3-Nov-2013.)
theorem shftlem {x3 y1: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wss B2 cc)) (wceq (crab x3 (wcel (co (cv x3) A2 cmin) B2) cc) (cab x3 (wrex y1 (wceq (cv x3) (co (cv y1) A2 caddc)) B2))) $;

--| A shift of the upper integers. (Contributed by Mario Carneiro, 5-Nov-2013.)
theorem shftuz {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cz)) (wceq (crab x3 (wcel (co (cv x3) A2 cmin) (cfv B2 cuz)) cc) (cfv (co B2 A2 caddc) cuz)) $;

--| The value of the sequence shifter operation is a function on ` CC ` . ` A ` is ordinarily an integer. (Contributed by NM, 20-Jul-2005.) (Revised by Mario Carneiro, 3-Nov-2013.)
theorem shftfval {x3 y1: setvar} (A2 F: class):
  $ wcel F cvv $ >
  $ wi (wcel A2 cc) (wceq (co F A2 cshi) (copab x3 y1 (wa (wcel (cv x3) cc) (wbr (co (cv x3) A2 cmin) (cv y1) F)))) $;

--| Domain of a relation shifted by ` A ` . The set on the right is more commonly notated as ` ( dom F + A ) ` (meaning add ` A ` to every element of ` dom F ` ). (Contributed by Mario Carneiro, 3-Nov-2013.)
theorem shftdm {x3: setvar} (A2 F: class):
  $ wcel F cvv $ >
  $ wi (wcel A2 cc) (wceq (cdm (co F A2 cshi)) (crab x3 (wcel (co (cv x3) A2 cmin) (cdm F)) cc)) $;

--| Value of a fiber of the relation ` F ` . (Contributed by Mario Carneiro, 4-Nov-2013.)
theorem shftfib (A2 B2 F: class):
  $ wcel F cvv $ >
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (cima (co F A2 cshi) (csn B2)) (cima F (csn (co B2 A2 cmin)))) $;

--| Functionality and domain of a sequence shifted by ` A ` . (Contributed by NM, 20-Jul-2005.) (Revised by Mario Carneiro, 3-Nov-2013.)
theorem shftfn {x3: setvar} (A2 B2 F: class):
  $ wcel F cvv $ >
  $ wi (wa (wfn F B2) (wcel A2 cc)) (wfn (co F A2 cshi) (crab x3 (wcel (co (cv x3) A2 cmin) B2) cc)) $;

--| Value of a sequence shifted by ` A ` . (Contributed by NM, 20-Jul-2005.) (Revised by Mario Carneiro, 4-Nov-2013.)
theorem shftval (A2 B2 F: class):
  $ wcel F cvv $ >
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (cfv B2 (co F A2 cshi)) (cfv (co B2 A2 cmin) F)) $;

--| Value of a sequence shifted by ` A - B ` . (Contributed by NM, 20-Jul-2005.) (Revised by Mario Carneiro, 5-Nov-2013.)
theorem shftval2 (A2 B2 C F: class):
  $ wcel F cvv $ >
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wceq (cfv (co A2 C caddc) (co F (co A2 B2 cmin) cshi)) (cfv (co B2 C caddc) F)) $;

--| Value of a sequence shifted by ` A - B ` . (Contributed by NM, 20-Jul-2005.)
theorem shftval3 (A2 B2 F: class):
  $ wcel F cvv $ >
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (cfv A2 (co F (co A2 B2 cmin) cshi)) (cfv B2 F)) $;

--| Value of a sequence shifted by ` -u A ` . (Contributed by NM, 18-Aug-2005.) (Revised by Mario Carneiro, 5-Nov-2013.)
theorem shftval4 (A2 B2 F: class):
  $ wcel F cvv $ >
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (cfv B2 (co F (cneg A2) cshi)) (cfv (co A2 B2 caddc) F)) $;

--| Value of a shifted sequence. (Contributed by NM, 19-Aug-2005.) (Revised by Mario Carneiro, 5-Nov-2013.)
theorem shftval5 (A2 B2 F: class):
  $ wcel F cvv $ >
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (cfv (co B2 A2 caddc) (co F A2 cshi)) (cfv B2 F)) $;

--| Functionality of a shifted sequence. (Contributed by NM, 19-Aug-2005.) (Revised by Mario Carneiro, 5-Nov-2013.)
theorem shftf {x3: setvar} (A2 B2: class) (C: class x3) (F: class):
  $ wcel F cvv $ >
  $ wi (wa (wf B2 C F) (wcel A2 cc)) (wf (crab x3 (wcel (co (cv x3) A2 cmin) B2) cc) C (co F A2 cshi)) $;

--| Composite shift operations. (Contributed by NM, 19-Aug-2005.) (Revised by Mario Carneiro, 5-Nov-2013.)
theorem _2shfti (A2 B2 F: class):
  $ wcel F cvv $ >
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co (co F A2 cshi) B2 cshi) (co F (co A2 B2 caddc) cshi)) $;

--| Identity law for the shift operation. (Contributed by Mario Carneiro, 5-Nov-2013.)
theorem shftidt2 (F: class):
  $ wcel F cvv $ >
  $ wceq (co F cc0 cshi) (cres F cc) $;

--| Identity law for the shift operation. (Contributed by NM, 19-Aug-2005.) (Revised by Mario Carneiro, 5-Nov-2013.)
theorem shftidt (A2 F: class):
  $ wcel F cvv $ >
  $ wi (wcel A2 cc) (wceq (cfv A2 (co F cc0 cshi)) (cfv A2 F)) $;

--| Cancellation law for the shift operation. (Contributed by NM, 4-Aug-2005.) (Revised by Mario Carneiro, 5-Nov-2013.)
theorem shftcan1 (A2 B2 F: class):
  $ wcel F cvv $ >
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (cfv B2 (co (co F A2 cshi) (cneg A2) cshi)) (cfv B2 F)) $;

--| Cancellation law for the shift operation. (Contributed by NM, 4-Aug-2005.) (Revised by Mario Carneiro, 5-Nov-2013.)
theorem shftcan2 (A2 B2 F: class):
  $ wcel F cvv $ >
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (cfv B2 (co (co F (cneg A2) cshi) A2 cshi)) (cfv B2 F)) $;

--| Shifting the index set of a sequence. (Contributed by NM, 17-Mar-2005.) (Revised by Mario Carneiro, 27-Feb-2014.)
theorem seqshft (c_pl F M N: class):
  $ wcel F cvv $ >
  $ wi (wa (wcel M cz) (wcel N cz)) (wceq (cseq c_pl (co F N cshi) M) (co (cseq c_pl F (co M N cmin)) N cshi)) $;

--| Extend class notation to include the Signum function.
term csgn: class;

--| Signum function. We do not call it "sign", which is homophonic with "sine" ( ~ df-sin ). Defined as "sgn" in ISO 80000-2:2009(E) operation 2-9.13. It is named "sign" (with the same definition) in the "NIST Digital Library of Mathematical Functions" , front introduction, "Common Notations and Definitions" section at ~ http://dlmf.nist.gov/front/introduction#Sx4 . We define this over ` RR* ` ( ~ df-xr ) instead of ` RR ` so that it can accept ` +oo ` and ` -oo ` . Note that ~ df-psgn defines the sign of a permutation, which is different. Value shown in ~ sgnval . (Contributed by David A. Wheeler, 15-May-2015.)
axiom df_sgn {x3: setvar}:
  $ wceq csgn (cmpt x3 cxr (cif (wceq (cv x3) cc0) cc0 (cif (wbr (cv x3) cc0 clt) (cneg c1) c1))) $;

--| Value of the signum function. (Contributed by David A. Wheeler, 15-May-2015.)
theorem sgnval (A2: class):
  $ wi (wcel A2 cxr) (wceq (cfv A2 csgn) (cif (wceq A2 cc0) cc0 (cif (wbr A2 cc0 clt) (cneg c1) c1))) $;

--| The signum of 0 is 0. (Contributed by David A. Wheeler, 15-May-2015.)
theorem sgn0:
  $ wceq (cfv cc0 csgn) cc0 $;

--| The signum of a positive extended real is 1. (Contributed by David A. Wheeler, 15-May-2015.)
theorem sgnp (A2: class):
  $ wi (wa (wcel A2 cxr) (wbr cc0 A2 clt)) (wceq (cfv A2 csgn) c1) $;

--| The signum of a positive real is 1. (Contributed by David A. Wheeler, 18-May-2015.)
theorem sgnrrp (A2: class):
  $ wi (wcel A2 crp) (wceq (cfv A2 csgn) c1) $;

--| The signum of 1 is 1. (Contributed by David A. Wheeler, 26-Jun-2016.)
theorem sgn1:
  $ wceq (cfv c1 csgn) c1 $;

--| The signum of ` +oo ` is 1. (Contributed by David A. Wheeler, 26-Jun-2016.)
theorem sgnpnf:
  $ wceq (cfv cpnf csgn) c1 $;

--| The signum of a negative extended real is -1. (Contributed by David A. Wheeler, 15-May-2015.)
theorem sgnn (A2: class):
  $ wi (wa (wcel A2 cxr) (wbr A2 cc0 clt)) (wceq (cfv A2 csgn) (cneg c1)) $;

--| The signum of ` -oo ` is -1. (Contributed by David A. Wheeler, 26-Jun-2016.)
theorem sgnmnf:
  $ wceq (cfv cmnf csgn) (cneg c1) $;

--| The domain of the signum function. (Contributed by AV, 16-Jun-2026.)
theorem sgndm:
  $ wceq (cdm csgn) cxr $;

--| Closure of the signum: The signum of an extended real is either -1 or 0 or 1. (Contributed by Thierry Arnoux, 28-Sep-2018.)
theorem sgncl (A2: class):
  $ wi (wcel A2 cxr) (wcel (cfv A2 csgn) (ctp (cneg c1) cc0 c1)) $;

--| The range of the signum function. (Contributed by AV, 16-Jun-2026.) (Proof shortened by TA, 21-Jun-2026.)
theorem sgnrn:
  $ wceq (crn csgn) (ctp (cneg c1) cc0 c1) $;

--| The signum function as onto function. (Contributed by AV, 16-Jun-2026.)
theorem sgnfo:
  $ wfo cxr (ctp (cneg c1) cc0 c1) csgn $;

--| Negation of the signum. (Contributed by Thierry Arnoux, 1-Oct-2018.)
theorem sgnneg (A2: class):
  $ wi (wcel A2 cr) (wceq (cfv (cneg A2) csgn) (cneg (cfv A2 csgn))) $;

--| A conditional containing a signum is true if it is true in all three possible cases. (Contributed by Thierry Arnoux, 1-Oct-2018.)
theorem sgn3da (ph ps ch th ta: wff) (A2: class):
  $ wi ph (wcel A2 cxr) $ >
  $ wi (wceq (cfv A2 csgn) cc0) (wb ps ch) $ >
  $ wi (wceq (cfv A2 csgn) c1) (wb ps th) $ >
  $ wi (wceq (cfv A2 csgn) (cneg c1)) (wb ps ta) $ >
  $ wi (wa ph (wceq A2 cc0)) ch $ >
  $ wi (wa ph (wbr cc0 A2 clt)) th $ >
  $ wi (wa ph (wbr A2 cc0 clt)) ta $ >
  $ wi ph ps $;

--| Closure of the signum for real numbers. (Contributed by Thierry Arnoux, 28-Sep-2018.)
theorem sgnclre (A2: class):
  $ wi (wcel A2 cr) (wcel (cfv A2 csgn) cr) $;

--| Zero signum. (Contributed by Thierry Arnoux, 10-Oct-2018.)
theorem sgn0bi (A2: class):
  $ wi (wcel A2 cxr) (wb (wceq (cfv A2 csgn) cc0) (wceq A2 cc0)) $;

--| Negative signum. (Contributed by Thierry Arnoux, 2-Oct-2018.)
theorem sgnnbi (A2: class):
  $ wi (wcel A2 cxr) (wb (wceq (cfv A2 csgn) (cneg c1)) (wbr A2 cc0 clt)) $;

--| Positive signum. (Contributed by Thierry Arnoux, 2-Oct-2018.)
theorem sgnpbi (A2: class):
  $ wi (wcel A2 cxr) (wb (wceq (cfv A2 csgn) c1) (wbr cc0 A2 clt)) $;

--| Signum of a difference with a number of opposite sign. (Contributed by Thierry Arnoux, 2-Oct-2018.)
theorem sgnsub (A2 B2: class):
  $ wi (wa (wa (wcel A2 cr) (wcel B2 cr)) (wbr (co A2 B2 cmul) cc0 clt)) (wceq (cfv (co A2 B2 cmin) csgn) (cfv A2 csgn)) $;

--| Signum of a product. (Contributed by Thierry Arnoux, 2-Oct-2018.)
theorem sgnmul (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wceq (cfv (co A2 B2 cmul) csgn) (co (cfv A2 csgn) (cfv B2 csgn) cmul)) $;

--| Multiplication by a positive number does not affect signum. (Contributed by Thierry Arnoux, 2-Oct-2018.)
theorem sgnmulrp2 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 crp)) (wceq (cfv (co A2 B2 cmul) csgn) (cfv A2 csgn)) $;

--| If two real numbers are of different signs, so are their signums. (Contributed by Thierry Arnoux, 12-Oct-2018.)
theorem sgnmulsgn (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wb (wbr (co A2 B2 cmul) cc0 clt) (wbr (co (cfv A2 csgn) (cfv B2 csgn) cmul) cc0 clt)) $;

--| Extend class notation to include complex conjugate function.
term ccj: class;

--| Extend class notation to include real part of a complex number.
term cre: class;

--| Extend class notation to include imaginary part of a complex number.
term cim: class;

--| Define the complex conjugate function. See ~ cjcli for its closure and ~ cjval for its value. (Contributed by NM, 9-May-1999.) (Revised by Mario Carneiro, 6-Nov-2013.)
axiom df_cj {x3 y1: setvar}:
  $ wceq ccj (cmpt x3 cc (crio y1 (wa (wcel (co (cv x3) (cv y1) caddc) cr) (wcel (co ci (co (cv x3) (cv y1) cmin) cmul) cr)) cc)) $;

--| Define a function whose value is the real part of a complex number. See ~ reval for its value, ~ recli for its closure, and ~ replim for its use in decomposing a complex number. (Contributed by NM, 9-May-1999.)
axiom df_re {x3: setvar}:
  $ wceq cre (cmpt x3 cc (co (co (cv x3) (cfv (cv x3) ccj) caddc) c2 cdiv)) $;

--| Define a function whose value is the imaginary part of a complex number. See ~ imval for its value, ~ imcli for its closure, and ~ replim for its use in decomposing a complex number. (Contributed by NM, 9-May-1999.)
axiom df_im {x3: setvar}:
  $ wceq cim (cmpt x3 cc (cfv (co (cv x3) ci cdiv) cre)) $;

--| The value of the conjugate of a complex number. (Contributed by Mario Carneiro, 6-Nov-2013.)
theorem cjval {x3: setvar} (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv A2 ccj) (crio x3 (wa (wcel (co A2 (cv x3) caddc) cr) (wcel (co ci (co A2 (cv x3) cmin) cmul) cr)) cc)) $;

--| The defining property of the complex conjugate. (Contributed by Mario Carneiro, 6-Nov-2013.)
theorem cjth (A2: class):
  $ wi (wcel A2 cc) (wa (wcel (co A2 (cfv A2 ccj) caddc) cr) (wcel (co ci (co A2 (cfv A2 ccj) cmin) cmul) cr)) $;

--| Domain and codomain of the conjugate function. (Contributed by Mario Carneiro, 6-Nov-2013.)
theorem cjf:
  $ wf cc cc ccj $;

--| The conjugate of a complex number is a complex number (closure law). (Contributed by NM, 10-May-1999.) (Revised by Mario Carneiro, 6-Nov-2013.)
theorem cjcl (A2: class):
  $ wi (wcel A2 cc) (wcel (cfv A2 ccj) cc) $;

--| The value of the real part of a complex number. (Contributed by NM, 9-May-1999.) (Revised by Mario Carneiro, 6-Nov-2013.)
theorem reval (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv A2 cre) (co (co A2 (cfv A2 ccj) caddc) c2 cdiv)) $;

--| The value of the imaginary part of a complex number. (Contributed by NM, 9-May-1999.) (Revised by Mario Carneiro, 6-Nov-2013.)
theorem imval (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv A2 cim) (cfv (co A2 ci cdiv) cre)) $;

--| The imaginary part of a complex number in terms of the real part function. (Contributed by NM, 12-May-2005.) (Revised by Mario Carneiro, 6-Nov-2013.)
theorem imre (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv A2 cim) (cfv (co (cneg ci) A2 cmul) cre)) $;

--| The real part of a complex number in terms of the imaginary part function. (Contributed by Mario Carneiro, 31-Mar-2015.)
theorem reim (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv A2 cre) (cfv (co ci A2 cmul) cim)) $;

--| The real part of a complex number is real. (Contributed by NM, 9-May-1999.) (Revised by Mario Carneiro, 6-Nov-2013.)
theorem recl (A2: class):
  $ wi (wcel A2 cc) (wcel (cfv A2 cre) cr) $;

--| The imaginary part of a complex number is real. (Contributed by NM, 9-May-1999.) (Revised by Mario Carneiro, 6-Nov-2013.)
theorem imcl (A2: class):
  $ wi (wcel A2 cc) (wcel (cfv A2 cim) cr) $;

--| Domain and codomain of the real part function. (Contributed by Paul Chapman, 22-Oct-2007.) (Revised by Mario Carneiro, 6-Nov-2013.)
theorem ref:
  $ wf cc cr cre $;

--| Domain and codomain of the imaginary part function. (Contributed by Paul Chapman, 22-Oct-2007.) (Revised by Mario Carneiro, 6-Nov-2013.)
theorem imf:
  $ wf cc cr cim $;

--| The real part of a complex number representation. Definition 10-3.1 of [Gleason] p. 132. (Contributed by NM, 12-May-2005.) (Revised by Mario Carneiro, 7-Nov-2013.)
theorem crre (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wceq (cfv (co A2 (co ci B2 cmul) caddc) cre) A2) $;

--| The real part of a complex number representation. Definition 10-3.1 of [Gleason] p. 132. (Contributed by NM, 12-May-2005.) (Revised by Mario Carneiro, 7-Nov-2013.)
theorem crim (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wceq (cfv (co A2 (co ci B2 cmul) caddc) cim) B2) $;

--| Reconstruct a complex number from its real and imaginary parts. (Contributed by NM, 10-May-1999.) (Revised by Mario Carneiro, 7-Nov-2013.)
theorem replim (A2: class):
  $ wi (wcel A2 cc) (wceq A2 (co (cfv A2 cre) (co ci (cfv A2 cim) cmul) caddc)) $;

--| Value of the conjugate of a complex number. The value is the real part minus ` _i ` times the imaginary part. Definition 10-3.2 of [Gleason] p. 132. (Contributed by NM, 10-May-1999.) (Revised by Mario Carneiro, 7-Nov-2013.)
theorem remim (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv A2 ccj) (co (cfv A2 cre) (co ci (cfv A2 cim) cmul) cmin)) $;

--| The imaginary part of a real number is 0. (Contributed by NM, 18-Mar-2005.) (Revised by Mario Carneiro, 7-Nov-2013.)
theorem reim0 (A2: class):
  $ wi (wcel A2 cr) (wceq (cfv A2 cim) cc0) $;

--| A number is real iff its imaginary part is 0. (Contributed by NM, 26-Sep-2005.)
theorem reim0b (A2: class):
  $ wi (wcel A2 cc) (wb (wcel A2 cr) (wceq (cfv A2 cim) cc0)) $;

--| A number is real iff it equals its real part. Proposition 10-3.4(f) of [Gleason] p. 133. (Contributed by NM, 20-Aug-2008.)
theorem rereb (A2: class):
  $ wi (wcel A2 cc) (wb (wcel A2 cr) (wceq (cfv A2 cre) A2)) $;

--| A product with a nonzero real multiplier is real iff the multiplicand is real. (Contributed by NM, 21-Aug-2008.)
theorem mulre (A2 B2: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cr) (wne B2 cc0)) (wb (wcel A2 cr) (wcel (co B2 A2 cmul) cr)) $;

--| A real number equals its real part. One direction of Proposition 10-3.4(f) of [Gleason] p. 133. (Contributed by Paul Chapman, 7-Sep-2007.)
theorem rere (A2: class):
  $ wi (wcel A2 cr) (wceq (cfv A2 cre) A2) $;

--| A number is real iff it equals its complex conjugate. Proposition 10-3.4(f) of [Gleason] p. 133. (Contributed by NM, 2-Jul-2005.) (Revised by Mario Carneiro, 14-Jul-2014.)
theorem cjreb (A2: class):
  $ wi (wcel A2 cc) (wb (wcel A2 cr) (wceq (cfv A2 ccj) A2)) $;

--| Real part of a complex conjugate. (Contributed by Mario Carneiro, 14-Jul-2014.)
theorem recj (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv (cfv A2 ccj) cre) (cfv A2 cre)) $;

--| Real part of negative. (Contributed by NM, 17-Mar-2005.) (Revised by Mario Carneiro, 14-Jul-2014.)
theorem reneg (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv (cneg A2) cre) (cneg (cfv A2 cre))) $;

--| Real part distributes over addition. (Contributed by NM, 17-Mar-2005.) (Revised by Mario Carneiro, 14-Jul-2014.)
theorem readd (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (cfv (co A2 B2 caddc) cre) (co (cfv A2 cre) (cfv B2 cre) caddc)) $;

--| Real part distributes over subtraction. (Contributed by NM, 17-Mar-2005.)
theorem resub (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (cfv (co A2 B2 cmin) cre) (co (cfv A2 cre) (cfv B2 cre) cmin)) $;

--| Lemma for ~ remul , ~ immul , and ~ cjmul . (Contributed by NM, 28-Jul-1999.) (Revised by Mario Carneiro, 14-Jul-2014.)
theorem remullem (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (w3a (wceq (cfv (co A2 B2 cmul) cre) (co (co (cfv A2 cre) (cfv B2 cre) cmul) (co (cfv A2 cim) (cfv B2 cim) cmul) cmin)) (wceq (cfv (co A2 B2 cmul) cim) (co (co (cfv A2 cre) (cfv B2 cim) cmul) (co (cfv A2 cim) (cfv B2 cre) cmul) caddc)) (wceq (cfv (co A2 B2 cmul) ccj) (co (cfv A2 ccj) (cfv B2 ccj) cmul))) $;

--| Real part of a product. (Contributed by NM, 28-Jul-1999.) (Revised by Mario Carneiro, 14-Jul-2014.)
theorem remul (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (cfv (co A2 B2 cmul) cre) (co (co (cfv A2 cre) (cfv B2 cre) cmul) (co (cfv A2 cim) (cfv B2 cim) cmul) cmin)) $;

--| Real part of a product. (Contributed by Mario Carneiro, 2-Aug-2014.)
theorem remul2 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cc)) (wceq (cfv (co A2 B2 cmul) cre) (co A2 (cfv B2 cre) cmul)) $;

--| Real part of a division. Related to ~ remul2 . (Contributed by David A. Wheeler, 10-Jun-2015.)
theorem rediv (A2 B2: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cr) (wne B2 cc0)) (wceq (cfv (co A2 B2 cdiv) cre) (co (cfv A2 cre) B2 cdiv)) $;

--| Imaginary part of a complex conjugate. (Contributed by NM, 18-Mar-2005.) (Revised by Mario Carneiro, 14-Jul-2014.)
theorem imcj (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv (cfv A2 ccj) cim) (cneg (cfv A2 cim))) $;

--| The imaginary part of a negative number. (Contributed by NM, 18-Mar-2005.) (Revised by Mario Carneiro, 14-Jul-2014.)
theorem imneg (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv (cneg A2) cim) (cneg (cfv A2 cim))) $;

--| Imaginary part distributes over addition. (Contributed by NM, 18-Mar-2005.) (Revised by Mario Carneiro, 14-Jul-2014.)
theorem imadd (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (cfv (co A2 B2 caddc) cim) (co (cfv A2 cim) (cfv B2 cim) caddc)) $;

--| Imaginary part distributes over subtraction. (Contributed by NM, 18-Mar-2005.)
theorem imsub (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (cfv (co A2 B2 cmin) cim) (co (cfv A2 cim) (cfv B2 cim) cmin)) $;

--| Imaginary part of a product. (Contributed by NM, 28-Jul-1999.) (Revised by Mario Carneiro, 14-Jul-2014.)
theorem immul (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (cfv (co A2 B2 cmul) cim) (co (co (cfv A2 cre) (cfv B2 cim) cmul) (co (cfv A2 cim) (cfv B2 cre) cmul) caddc)) $;

--| Imaginary part of a product. (Contributed by Mario Carneiro, 2-Aug-2014.)
theorem immul2 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cc)) (wceq (cfv (co A2 B2 cmul) cim) (co A2 (cfv B2 cim) cmul)) $;

--| Imaginary part of a division. Related to ~ immul2 . (Contributed by Mario Carneiro, 20-Jun-2015.)
theorem imdiv (A2 B2: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cr) (wne B2 cc0)) (wceq (cfv (co A2 B2 cdiv) cim) (co (cfv A2 cim) B2 cdiv)) $;

--| A real number equals its complex conjugate. Proposition 10-3.4(f) of [Gleason] p. 133. (Contributed by NM, 8-Oct-1999.)
theorem cjre (A2: class):
  $ wi (wcel A2 cr) (wceq (cfv A2 ccj) A2) $;

--| The conjugate of the conjugate is the original complex number. Proposition 10-3.4(e) of [Gleason] p. 133. (Contributed by NM, 29-Jul-1999.) (Proof shortened by Mario Carneiro, 14-Jul-2014.)
theorem cjcj (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv (cfv A2 ccj) ccj) A2) $;

--| Complex conjugate distributes over addition. Proposition 10-3.4(a) of [Gleason] p. 133. (Contributed by NM, 31-Jul-1999.) (Revised by Mario Carneiro, 14-Jul-2014.)
theorem cjadd (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (cfv (co A2 B2 caddc) ccj) (co (cfv A2 ccj) (cfv B2 ccj) caddc)) $;

--| Complex conjugate distributes over multiplication. Proposition 10-3.4(c) of [Gleason] p. 133. (Contributed by NM, 29-Jul-1999.) (Proof shortened by Mario Carneiro, 14-Jul-2014.)
theorem cjmul (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (cfv (co A2 B2 cmul) ccj) (co (cfv A2 ccj) (cfv B2 ccj) cmul)) $;

--| Standard inner product on complex numbers. (Contributed by NM, 29-Jul-1999.) (Revised by Mario Carneiro, 14-Jul-2014.)
theorem ipcnval (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (cfv (co A2 (cfv B2 ccj) cmul) cre) (co (co (cfv A2 cre) (cfv B2 cre) cmul) (co (cfv A2 cim) (cfv B2 cim) cmul) caddc)) $;

--| A complex number times its conjugate is real. (Contributed by NM, 26-Mar-2005.) (Revised by Mario Carneiro, 14-Jul-2014.)
theorem cjmulrcl (A2: class):
  $ wi (wcel A2 cc) (wcel (co A2 (cfv A2 ccj) cmul) cr) $;

--| A complex number times its conjugate. (Contributed by NM, 1-Feb-2007.) (Revised by Mario Carneiro, 14-Jul-2014.)
theorem cjmulval (A2: class):
  $ wi (wcel A2 cc) (wceq (co A2 (cfv A2 ccj) cmul) (co (co (cfv A2 cre) c2 cexp) (co (cfv A2 cim) c2 cexp) caddc)) $;

--| A complex number times its conjugate is nonnegative. (Contributed by NM, 26-Mar-2005.) (Revised by Mario Carneiro, 14-Jul-2014.)
theorem cjmulge0 (A2: class):
  $ wi (wcel A2 cc) (wbr cc0 (co A2 (cfv A2 ccj) cmul) cle) $;

--| Complex conjugate of negative. (Contributed by NM, 27-Feb-2005.) (Revised by Mario Carneiro, 14-Jul-2014.)
theorem cjneg (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv (cneg A2) ccj) (cneg (cfv A2 ccj))) $;

--| A number plus its conjugate is twice its real part. Compare Proposition 10-3.4(h) of [Gleason] p. 133. (Contributed by NM, 21-Jan-2007.) (Revised by Mario Carneiro, 14-Jul-2014.)
theorem addcj (A2: class):
  $ wi (wcel A2 cc) (wceq (co A2 (cfv A2 ccj) caddc) (co c2 (cfv A2 cre) cmul)) $;

--| Complex conjugate distributes over subtraction. (Contributed by NM, 28-Apr-2005.)
theorem cjsub (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (cfv (co A2 B2 cmin) ccj) (co (cfv A2 ccj) (cfv B2 ccj) cmin)) $;

--| Complex conjugate of positive integer exponentiation. (Contributed by NM, 7-Jun-2006.)
theorem cjexp (A2 N: class):
  $ wi (wa (wcel A2 cc) (wcel N cn0)) (wceq (cfv (co A2 N cexp) ccj) (co (cfv A2 ccj) N cexp)) $;

--| The imaginary part of a number in terms of complex conjugate. (Contributed by NM, 30-Apr-2005.)
theorem imval2 (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv A2 cim) (co (co A2 (cfv A2 ccj) cmin) (co c2 ci cmul) cdiv)) $;

--| The real part of zero. (Contributed by NM, 27-Jul-1999.)
theorem re0:
  $ wceq (cfv cc0 cre) cc0 $;

--| The imaginary part of zero. (Contributed by NM, 27-Jul-1999.)
theorem im0:
  $ wceq (cfv cc0 cim) cc0 $;

--| The real part of one. (Contributed by Scott Fenton, 9-Jun-2006.)
theorem re1:
  $ wceq (cfv c1 cre) c1 $;

--| The imaginary part of one. (Contributed by Scott Fenton, 9-Jun-2006.)
theorem im1:
  $ wceq (cfv c1 cim) cc0 $;

--| The real part of ` _i ` . (Contributed by Scott Fenton, 9-Jun-2006.)
theorem rei:
  $ wceq (cfv ci cre) cc0 $;

--| The imaginary part of ` _i ` . (Contributed by Scott Fenton, 9-Jun-2006.)
theorem imi:
  $ wceq (cfv ci cim) c1 $;

--| The conjugate of zero. (Contributed by NM, 27-Jul-1999.)
theorem cj0:
  $ wceq (cfv cc0 ccj) cc0 $;

--| The complex conjugate of the imaginary unit. (Contributed by NM, 26-Mar-2005.)
theorem cji:
  $ wceq (cfv ci ccj) (cneg ci) $;

--| The conjugate of a representation of a complex number in terms of real and imaginary parts. (Contributed by NM, 1-Jul-2005.)
theorem cjreim (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wceq (cfv (co A2 (co ci B2 cmul) caddc) ccj) (co A2 (co ci B2 cmul) cmin)) $;

--| The conjugate of the representation of a complex number in terms of real and imaginary parts. (Contributed by NM, 1-Jul-2005.) (Proof shortened by Mario Carneiro, 29-May-2016.)
theorem cjreim2 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wceq (cfv (co A2 (co ci B2 cmul) cmin) ccj) (co A2 (co ci B2 cmul) caddc)) $;

--| Complex conjugate is a one-to-one function. (Contributed by NM, 29-Apr-2005.) (Proof shortened by Eric Schmidt, 2-Jul-2009.)
theorem cj11 (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wb (wceq (cfv A2 ccj) (cfv B2 ccj)) (wceq A2 B2)) $;

--| A number is nonzero iff its complex conjugate is nonzero. (Contributed by NM, 29-Apr-2005.)
theorem cjne0 (A2: class):
  $ wi (wcel A2 cc) (wb (wne A2 cc0) (wne (cfv A2 ccj) cc0)) $;

--| Complex conjugate distributes over division. (Contributed by NM, 29-Apr-2005.) (Proof shortened by Mario Carneiro, 29-May-2016.)
theorem cjdiv (A2 B2: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wne B2 cc0)) (wceq (cfv (co A2 B2 cdiv) ccj) (co (cfv A2 ccj) (cfv B2 ccj) cdiv)) $;

--| The inverse to the canonical bijection from ` ( RR X. RR ) ` to ` CC ` from ~ cnref1o . (Contributed by Mario Carneiro, 25-Aug-2014.)
theorem cnrecnv {x3 y1 z: setvar} (F: class x3 y1):
  $ wceq F (cmpo x3 y1 cr cr (co (cv x3) (co ci (cv y1) cmul) caddc)) $ >
  $ wceq (ccnv F) (cmpt z cc (cop (cfv (cv z) cre) (cfv (cv z) cim))) $;

--| A deduction for showing two numbers whose squares are equal are themselves equal. (Contributed by Mario Carneiro, 3-Apr-2015.)
theorem sqeqd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wceq (co A2 c2 cexp) (co B2 c2 cexp)) $ >
  $ wi ph (wbr cc0 (cfv A2 cre) cle) $ >
  $ wi ph (wbr cc0 (cfv B2 cre) cle) $ >
  $ wi (w3a ph (wceq (cfv A2 cre) cc0) (wceq (cfv B2 cre) cc0)) (wceq A2 B2) $ >
  $ wi ph (wceq A2 B2) $;

--| The real part of a complex number is real (closure law). (Contributed by NM, 11-May-1999.)
theorem recli (A2: class):
  $ wcel A2 cc $ >
  $ wcel (cfv A2 cre) cr $;

--| The imaginary part of a complex number is real (closure law). (Contributed by NM, 11-May-1999.)
theorem imcli (A2: class):
  $ wcel A2 cc $ >
  $ wcel (cfv A2 cim) cr $;

--| Closure law for complex conjugate. (Contributed by NM, 11-May-1999.)
theorem cjcli (A2: class):
  $ wcel A2 cc $ >
  $ wcel (cfv A2 ccj) cc $;

--| Construct a complex number from its real and imaginary parts. (Contributed by NM, 1-Oct-1999.)
theorem replimi (A2: class):
  $ wcel A2 cc $ >
  $ wceq A2 (co (cfv A2 cre) (co ci (cfv A2 cim) cmul) caddc) $;

--| The conjugate of the conjugate is the original complex number. Proposition 10-3.4(e) of [Gleason] p. 133. (Contributed by NM, 11-May-1999.)
theorem cjcji (A2: class):
  $ wcel A2 cc $ >
  $ wceq (cfv (cfv A2 ccj) ccj) A2 $;

--| A number is real iff its imaginary part is 0. (Contributed by NM, 29-May-1999.)
theorem reim0bi (A2: class):
  $ wcel A2 cc $ >
  $ wb (wcel A2 cr) (wceq (cfv A2 cim) cc0) $;

--| A real number equals its real part. Proposition 10-3.4(f) of [Gleason] p. 133. (Contributed by NM, 27-Oct-1999.)
theorem rerebi (A2: class):
  $ wcel A2 cc $ >
  $ wb (wcel A2 cr) (wceq (cfv A2 cre) A2) $;

--| A number is real iff it equals its complex conjugate. Proposition 10-3.4(f) of [Gleason] p. 133. (Contributed by NM, 11-Oct-1999.)
theorem cjrebi (A2: class):
  $ wcel A2 cc $ >
  $ wb (wcel A2 cr) (wceq (cfv A2 ccj) A2) $;

--| Real part of a complex conjugate. (Contributed by NM, 2-Oct-1999.)
theorem recji (A2: class):
  $ wcel A2 cc $ >
  $ wceq (cfv (cfv A2 ccj) cre) (cfv A2 cre) $;

--| Imaginary part of a complex conjugate. (Contributed by NM, 2-Oct-1999.)
theorem imcji (A2: class):
  $ wcel A2 cc $ >
  $ wceq (cfv (cfv A2 ccj) cim) (cneg (cfv A2 cim)) $;

--| A complex number times its conjugate is real. (Contributed by NM, 11-May-1999.)
theorem cjmulrcli (A2: class):
  $ wcel A2 cc $ >
  $ wcel (co A2 (cfv A2 ccj) cmul) cr $;

--| A complex number times its conjugate. (Contributed by NM, 2-Oct-1999.)
theorem cjmulvali (A2: class):
  $ wcel A2 cc $ >
  $ wceq (co A2 (cfv A2 ccj) cmul) (co (co (cfv A2 cre) c2 cexp) (co (cfv A2 cim) c2 cexp) caddc) $;

--| A complex number times its conjugate is nonnegative. (Contributed by NM, 28-May-1999.)
theorem cjmulge0i (A2: class):
  $ wcel A2 cc $ >
  $ wbr cc0 (co A2 (cfv A2 ccj) cmul) cle $;

--| Real part of negative. (Contributed by NM, 2-Aug-1999.)
theorem renegi (A2: class):
  $ wcel A2 cc $ >
  $ wceq (cfv (cneg A2) cre) (cneg (cfv A2 cre)) $;

--| Imaginary part of negative. (Contributed by NM, 2-Aug-1999.)
theorem imnegi (A2: class):
  $ wcel A2 cc $ >
  $ wceq (cfv (cneg A2) cim) (cneg (cfv A2 cim)) $;

--| Complex conjugate of negative. (Contributed by NM, 2-Aug-1999.)
theorem cjnegi (A2: class):
  $ wcel A2 cc $ >
  $ wceq (cfv (cneg A2) ccj) (cneg (cfv A2 ccj)) $;

--| A number plus its conjugate is twice its real part. Compare Proposition 10-3.4(h) of [Gleason] p. 133. (Contributed by NM, 2-Oct-1999.)
theorem addcji (A2: class):
  $ wcel A2 cc $ >
  $ wceq (co A2 (cfv A2 ccj) caddc) (co c2 (cfv A2 cre) cmul) $;

--| Real part distributes over addition. (Contributed by NM, 28-Jul-1999.)
theorem readdi (A2 B2: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wceq (cfv (co A2 B2 caddc) cre) (co (cfv A2 cre) (cfv B2 cre) caddc) $;

--| Imaginary part distributes over addition. (Contributed by NM, 28-Jul-1999.)
theorem imaddi (A2 B2: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wceq (cfv (co A2 B2 caddc) cim) (co (cfv A2 cim) (cfv B2 cim) caddc) $;

--| Real part of a product. (Contributed by NM, 28-Jul-1999.)
theorem remuli (A2 B2: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wceq (cfv (co A2 B2 cmul) cre) (co (co (cfv A2 cre) (cfv B2 cre) cmul) (co (cfv A2 cim) (cfv B2 cim) cmul) cmin) $;

--| Imaginary part of a product. (Contributed by NM, 28-Jul-1999.)
theorem immuli (A2 B2: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wceq (cfv (co A2 B2 cmul) cim) (co (co (cfv A2 cre) (cfv B2 cim) cmul) (co (cfv A2 cim) (cfv B2 cre) cmul) caddc) $;

--| Complex conjugate distributes over addition. Proposition 10-3.4(a) of [Gleason] p. 133. (Contributed by NM, 28-Jul-1999.)
theorem cjaddi (A2 B2: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wceq (cfv (co A2 B2 caddc) ccj) (co (cfv A2 ccj) (cfv B2 ccj) caddc) $;

--| Complex conjugate distributes over multiplication. Proposition 10-3.4(c) of [Gleason] p. 133. (Contributed by NM, 28-Jul-1999.)
theorem cjmuli (A2 B2: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wceq (cfv (co A2 B2 cmul) ccj) (co (cfv A2 ccj) (cfv B2 ccj) cmul) $;

--| Standard inner product on complex numbers. (Contributed by NM, 2-Oct-1999.)
theorem ipcni (A2 B2: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wceq (cfv (co A2 (cfv B2 ccj) cmul) cre) (co (co (cfv A2 cre) (cfv B2 cre) cmul) (co (cfv A2 cim) (cfv B2 cim) cmul) caddc) $;

--| Complex conjugate distributes over division. (Contributed by NM, 29-Apr-2005.) (Revised by Mario Carneiro, 29-May-2016.)
theorem cjdivi (A2 B2: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wi (wne B2 cc0) (wceq (cfv (co A2 B2 cdiv) ccj) (co (cfv A2 ccj) (cfv B2 ccj) cdiv)) $;

--| The real part of a complex number representation. Definition 10-3.1 of [Gleason] p. 132. (Contributed by NM, 10-May-1999.)
theorem crrei (A2 B2: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wceq (cfv (co A2 (co ci B2 cmul) caddc) cre) A2 $;

--| The imaginary part of a complex number representation. Definition 10-3.1 of [Gleason] p. 132. (Contributed by NM, 10-May-1999.)
theorem crimi (A2 B2: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wceq (cfv (co A2 (co ci B2 cmul) caddc) cim) B2 $;

--| The real part of a complex number is real (closure law). (Contributed by Mario Carneiro, 29-May-2016.)
theorem recld (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel (cfv A2 cre) cr) $;

--| The imaginary part of a complex number is real (closure law). (Contributed by Mario Carneiro, 29-May-2016.)
theorem imcld (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel (cfv A2 cim) cr) $;

--| Closure law for complex conjugate. (Contributed by Mario Carneiro, 29-May-2016.)
theorem cjcld (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel (cfv A2 ccj) cc) $;

--| Construct a complex number from its real and imaginary parts. (Contributed by Mario Carneiro, 29-May-2016.)
theorem replimd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq A2 (co (cfv A2 cre) (co ci (cfv A2 cim) cmul) caddc)) $;

--| Value of the conjugate of a complex number. The value is the real part minus ` _i ` times the imaginary part. Definition 10-3.2 of [Gleason] p. 132. (Contributed by Mario Carneiro, 29-May-2016.)
theorem remimd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (cfv A2 ccj) (co (cfv A2 cre) (co ci (cfv A2 cim) cmul) cmin)) $;

--| The conjugate of the conjugate is the original complex number. Proposition 10-3.4(e) of [Gleason] p. 133. (Contributed by Mario Carneiro, 29-May-2016.)
theorem cjcjd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (cfv (cfv A2 ccj) ccj) A2) $;

--| A number is real iff its imaginary part is 0. (Contributed by Mario Carneiro, 29-May-2016.)
theorem reim0bd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (cfv A2 cim) cc0) $ >
  $ wi ph (wcel A2 cr) $;

--| A real number equals its real part. Proposition 10-3.4(f) of [Gleason] p. 133. (Contributed by Mario Carneiro, 29-May-2016.)
theorem rerebd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (cfv A2 cre) A2) $ >
  $ wi ph (wcel A2 cr) $;

--| A number is real iff it equals its complex conjugate. Proposition 10-3.4(f) of [Gleason] p. 133. (Contributed by Mario Carneiro, 29-May-2016.)
theorem cjrebd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (cfv A2 ccj) A2) $ >
  $ wi ph (wcel A2 cr) $;

--| A number is nonzero iff its complex conjugate is nonzero. (Contributed by Mario Carneiro, 29-May-2016.)
theorem cjne0d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wne (cfv A2 ccj) cc0) $;

--| Real part of a complex conjugate. (Contributed by Mario Carneiro, 29-May-2016.)
theorem recjd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (cfv (cfv A2 ccj) cre) (cfv A2 cre)) $;

--| Imaginary part of a complex conjugate. (Contributed by Mario Carneiro, 29-May-2016.)
theorem imcjd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (cfv (cfv A2 ccj) cim) (cneg (cfv A2 cim))) $;

--| A complex number times its conjugate is real. (Contributed by Mario Carneiro, 29-May-2016.)
theorem cjmulrcld (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel (co A2 (cfv A2 ccj) cmul) cr) $;

--| A complex number times its conjugate. (Contributed by Mario Carneiro, 29-May-2016.)
theorem cjmulvald (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (co A2 (cfv A2 ccj) cmul) (co (co (cfv A2 cre) c2 cexp) (co (cfv A2 cim) c2 cexp) caddc)) $;

--| A complex number times its conjugate is nonnegative. (Contributed by Mario Carneiro, 29-May-2016.)
theorem cjmulge0d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wbr cc0 (co A2 (cfv A2 ccj) cmul) cle) $;

--| Real part of negative. (Contributed by Mario Carneiro, 29-May-2016.)
theorem renegd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (cfv (cneg A2) cre) (cneg (cfv A2 cre))) $;

--| Imaginary part of negative. (Contributed by Mario Carneiro, 29-May-2016.)
theorem imnegd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (cfv (cneg A2) cim) (cneg (cfv A2 cim))) $;

--| Complex conjugate of negative. (Contributed by Mario Carneiro, 29-May-2016.)
theorem cjnegd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (cfv (cneg A2) ccj) (cneg (cfv A2 ccj))) $;

--| A number plus its conjugate is twice its real part. Compare Proposition 10-3.4(h) of [Gleason] p. 133. (Contributed by Mario Carneiro, 29-May-2016.)
theorem addcjd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (co A2 (cfv A2 ccj) caddc) (co c2 (cfv A2 cre) cmul)) $;

--| Complex conjugate of positive integer exponentiation. (Contributed by Mario Carneiro, 29-May-2016.)
theorem cjexpd (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (cfv (co A2 N cexp) ccj) (co (cfv A2 ccj) N cexp)) $;

--| Real part distributes over addition. (Contributed by Mario Carneiro, 29-May-2016.)
theorem readdd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wceq (cfv (co A2 B2 caddc) cre) (co (cfv A2 cre) (cfv B2 cre) caddc)) $;

--| Imaginary part distributes over addition. (Contributed by Mario Carneiro, 29-May-2016.)
theorem imaddd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wceq (cfv (co A2 B2 caddc) cim) (co (cfv A2 cim) (cfv B2 cim) caddc)) $;

--| Real part distributes over subtraction. (Contributed by Mario Carneiro, 29-May-2016.)
theorem resubd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wceq (cfv (co A2 B2 cmin) cre) (co (cfv A2 cre) (cfv B2 cre) cmin)) $;

--| Imaginary part distributes over subtraction. (Contributed by Mario Carneiro, 29-May-2016.)
theorem imsubd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wceq (cfv (co A2 B2 cmin) cim) (co (cfv A2 cim) (cfv B2 cim) cmin)) $;

--| Real part of a product. (Contributed by Mario Carneiro, 29-May-2016.)
theorem remuld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wceq (cfv (co A2 B2 cmul) cre) (co (co (cfv A2 cre) (cfv B2 cre) cmul) (co (cfv A2 cim) (cfv B2 cim) cmul) cmin)) $;

--| Imaginary part of a product. (Contributed by Mario Carneiro, 29-May-2016.)
theorem immuld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wceq (cfv (co A2 B2 cmul) cim) (co (co (cfv A2 cre) (cfv B2 cim) cmul) (co (cfv A2 cim) (cfv B2 cre) cmul) caddc)) $;

--| Complex conjugate distributes over addition. Proposition 10-3.4(a) of [Gleason] p. 133. (Contributed by Mario Carneiro, 29-May-2016.)
theorem cjaddd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wceq (cfv (co A2 B2 caddc) ccj) (co (cfv A2 ccj) (cfv B2 ccj) caddc)) $;

--| Complex conjugate distributes over multiplication. Proposition 10-3.4(c) of [Gleason] p. 133. (Contributed by Mario Carneiro, 29-May-2016.)
theorem cjmuld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wceq (cfv (co A2 B2 cmul) ccj) (co (cfv A2 ccj) (cfv B2 ccj) cmul)) $;

--| Standard inner product on complex numbers. (Contributed by Mario Carneiro, 29-May-2016.)
theorem ipcnd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wceq (cfv (co A2 (cfv B2 ccj) cmul) cre) (co (co (cfv A2 cre) (cfv B2 cre) cmul) (co (cfv A2 cim) (cfv B2 cim) cmul) caddc)) $;

--| Complex conjugate distributes over division. (Contributed by Mario Carneiro, 29-May-2016.)
theorem cjdivd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wne B2 cc0) $ >
  $ wi ph (wceq (cfv (co A2 B2 cdiv) ccj) (co (cfv A2 ccj) (cfv B2 ccj) cdiv)) $;

--| A real number equals its real part. One direction of Proposition 10-3.4(f) of [Gleason] p. 133. (Contributed by Mario Carneiro, 29-May-2016.)
theorem rered (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wceq (cfv A2 cre) A2) $;

--| The imaginary part of a real number is 0. (Contributed by Mario Carneiro, 29-May-2016.)
theorem reim0d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wceq (cfv A2 cim) cc0) $;

--| A real number equals its complex conjugate. Proposition 10-3.4(f) of [Gleason] p. 133. (Contributed by Mario Carneiro, 29-May-2016.)
theorem cjred (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wceq (cfv A2 ccj) A2) $;

--| Real part of a product. (Contributed by Mario Carneiro, 29-May-2016.)
theorem remul2d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wceq (cfv (co A2 B2 cmul) cre) (co A2 (cfv B2 cre) cmul)) $;

--| Imaginary part of a product. (Contributed by Mario Carneiro, 29-May-2016.)
theorem immul2d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wceq (cfv (co A2 B2 cmul) cim) (co A2 (cfv B2 cim) cmul)) $;

--| Real part of a division. Related to ~ remul2 . (Contributed by Mario Carneiro, 29-May-2016.)
theorem redivd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wceq (cfv (co B2 A2 cdiv) cre) (co (cfv B2 cre) A2 cdiv)) $;

--| Imaginary part of a division. Related to ~ remul2 . (Contributed by Mario Carneiro, 29-May-2016.)
theorem imdivd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wceq (cfv (co B2 A2 cdiv) cim) (co (cfv B2 cim) A2 cdiv)) $;

--| The real part of a complex number representation. Definition 10-3.1 of [Gleason] p. 132. (Contributed by Mario Carneiro, 29-May-2016.)
theorem crred (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wceq (cfv (co A2 (co ci B2 cmul) caddc) cre) A2) $;

--| The imaginary part of a complex number representation. Definition 10-3.1 of [Gleason] p. 132. (Contributed by Mario Carneiro, 29-May-2016.)
theorem crimd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wceq (cfv (co A2 (co ci B2 cmul) caddc) cim) B2) $;

--| Extend class notation to include square root of a complex number.
term csqrt: class;

--| Extend class notation to include a function for the absolute value (modulus) of a complex number.
term cabs: class;

--| Define a function whose value is the square root of a complex number. For example, ` ( sqrt `` 2 5 ) = 5 ` ( ~ ex-sqrt ). Since ` ( y ^ 2 ) = x ` iff ` ( -u y ^ 2 ) = x ` , we ensure uniqueness by restricting the range to numbers with positive real part, or numbers with 0 real part and nonnegative imaginary part. A description can be found under "Principal square root of a complex number" at ~ http://en.wikipedia.org/wiki/Square_root . The square root symbol was introduced in 1525 by Christoff Rudolff. See ~ sqrtcl for its closure, ~ sqrtval for its value, ~ sqrtth and ~ sqsqrti for its relationship to squares, and ~ sqrt11i for uniqueness. (Contributed by NM, 27-Jul-1999.) (Revised by Mario Carneiro, 8-Jul-2013.)
axiom df_sqrt {x3 y1: setvar}:
  $ wceq csqrt (cmpt x3 cc (crio y1 (w3a (wceq (co (cv y1) c2 cexp) (cv x3)) (wbr cc0 (cfv (cv y1) cre) cle) (wnel (co ci (cv y1) cmul) crp)) cc)) $;

--| Define the function for the absolute value (modulus) of a complex number. See ~ abscli for its closure and ~ absval or ~ absval2i for its value. For example, ` ( abs `` -u 2 ) = 2 ` ( ~ ex-abs ). (Contributed by NM, 27-Jul-1999.)
axiom df_abs {x3: setvar}:
  $ wceq cabs (cmpt x3 cc (cfv (co (cv x3) (cfv (cv x3) ccj) cmul) csqrt)) $;

--| Value of square root function. (Contributed by Mario Carneiro, 8-Jul-2013.)
theorem sqrtval {x3: setvar} (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv A2 csqrt) (crio x3 (w3a (wceq (co (cv x3) c2 cexp) A2) (wbr cc0 (cfv (cv x3) cre) cle) (wnel (co ci (cv x3) cmul) crp)) cc)) $;

--| The absolute value (modulus) of a complex number. Proposition 10-3.7(a) of [Gleason] p. 133. (Contributed by NM, 27-Jul-1999.) (Revised by Mario Carneiro, 7-Nov-2013.)
theorem absval (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv A2 cabs) (cfv (co A2 (cfv A2 ccj) cmul) csqrt)) $;

--| A real number does not lie on the negative imaginary axis. (Contributed by Mario Carneiro, 8-Jul-2013.)
theorem rennim (A2: class):
  $ wi (wcel A2 cr) (wnel (co ci A2 cmul) crp) $;

--| The specification of restriction to the right half-plane partitions the complex plane without 0 into two disjoint pieces, which are related by a reflection about the origin (under the map ` x |-> -u x ` ). (Contributed by Mario Carneiro, 8-Jul-2013.)
theorem cnpart (A2: class):
  $ wi (wa (wcel A2 cc) (wne A2 cc0)) (wb (wa (wbr cc0 (cfv A2 cre) cle) (wnel (co ci A2 cmul) crp)) (wn (wa (wbr cc0 (cfv (cneg A2) cre) cle) (wnel (co ci (cneg A2) cmul) crp)))) $;

--| The square root of zero is zero. (Contributed by Mario Carneiro, 9-Jul-2013.)
theorem sqrt0:
  $ wceq (cfv cc0 csqrt) cc0 $;

--| Lemma for ~ 01sqrex . (Contributed by Mario Carneiro, 10-Jul-2013.)
theorem _01sqrexlem1 {x3 y1: setvar} (A2: class) (B2 S: class x3):
  $ wceq S (crab x3 (wbr (co (cv x3) c2 cexp) A2 cle) crp) $ >
  $ wceq B2 (csup S cr clt) $ >
  $ wi (wa (wcel A2 crp) (wbr A2 c1 cle)) (wral y1 (wbr (cv y1) c1 cle) S) $;

--| Lemma for ~ 01sqrex . (Contributed by Mario Carneiro, 10-Jul-2013.)
theorem _01sqrexlem2 {x3: setvar} (A2: class) (B2 S: class x3):
  $ wceq S (crab x3 (wbr (co (cv x3) c2 cexp) A2 cle) crp) $ >
  $ wceq B2 (csup S cr clt) $ >
  $ wi (wa (wcel A2 crp) (wbr A2 c1 cle)) (wcel A2 S) $;

--| Lemma for ~ 01sqrex . (Contributed by Mario Carneiro, 10-Jul-2013.)
theorem _01sqrexlem3 {x3 y1 z: setvar} (A2: class) (B2 S: class x3):
  $ wceq S (crab x3 (wbr (co (cv x3) c2 cexp) A2 cle) crp) $ >
  $ wceq B2 (csup S cr clt) $ >
  $ wi (wa (wcel A2 crp) (wbr A2 c1 cle)) (w3a (wss S cr) (wne S c0) (wrex z (wral y1 (wbr (cv y1) (cv z) cle) S) cr)) $;

--| Lemma for ~ 01sqrex . (Contributed by Mario Carneiro, 10-Jul-2013.)
theorem _01sqrexlem4 {x3: setvar} (A2: class) (B2 S: class x3):
  $ wceq S (crab x3 (wbr (co (cv x3) c2 cexp) A2 cle) crp) $ >
  $ wceq B2 (csup S cr clt) $ >
  $ wi (wa (wcel A2 crp) (wbr A2 c1 cle)) (wa (wcel B2 crp) (wbr B2 c1 cle)) $;

--| Lemma for ~ 01sqrex . (Contributed by Mario Carneiro, 10-Jul-2013.)
theorem _01sqrexlem5 {x3 y1 v u a b: setvar} (A2: class u) (B2: class x3 u a b) (S: class x3) (T: class x3 y1 a b):
  $ wceq S (crab x3 (wbr (co (cv x3) c2 cexp) A2 cle) crp) $ >
  $ wceq B2 (csup S cr clt) $ >
  $ wceq T (cab y1 (wrex a (wrex b (wceq (cv y1) (co (cv a) (cv b) cmul)) S) S)) $ >
  $ wi (wa (wcel A2 crp) (wbr A2 c1 cle)) (wa (w3a (wss T cr) (wne T c0) (wrex v (wral u (wbr (cv u) (cv v) cle) T) cr)) (wceq (co B2 c2 cexp) (csup T cr clt))) $;

--| Lemma for ~ 01sqrex . (Contributed by Mario Carneiro, 10-Jul-2013.)
theorem _01sqrexlem6 {x3 y1 a b: setvar} (A2: class) (B2: class x3 a b) (S: class x3) (T: class x3 y1 a b):
  $ wceq S (crab x3 (wbr (co (cv x3) c2 cexp) A2 cle) crp) $ >
  $ wceq B2 (csup S cr clt) $ >
  $ wceq T (cab y1 (wrex a (wrex b (wceq (cv y1) (co (cv a) (cv b) cmul)) S) S)) $ >
  $ wi (wa (wcel A2 crp) (wbr A2 c1 cle)) (wbr (co B2 c2 cexp) A2 cle) $;

--| Lemma for ~ 01sqrex . (Contributed by Mario Carneiro, 10-Jul-2013.) (Proof shortened by AV, 9-Jul-2022.)
theorem _01sqrexlem7 {x3 y1 a b: setvar} (A2: class) (B2: class x3 a b) (S: class x3) (T: class x3 y1 a b):
  $ wceq S (crab x3 (wbr (co (cv x3) c2 cexp) A2 cle) crp) $ >
  $ wceq B2 (csup S cr clt) $ >
  $ wceq T (cab y1 (wrex a (wrex b (wceq (cv y1) (co (cv a) (cv b) cmul)) S) S)) $ >
  $ wi (wa (wcel A2 crp) (wbr A2 c1 cle)) (wceq (co B2 c2 cexp) A2) $;

--| Existence of a square root for reals in the interval ` ( 0 , 1 ] ` . (Contributed by Mario Carneiro, 10-Jul-2013.)
theorem _01sqrex {x3: setvar} (A2: class):
  $ wi (wa (wcel A2 crp) (wbr A2 c1 cle)) (wrex x3 (wa (wbr (cv x3) c1 cle) (wceq (co (cv x3) c2 cexp) A2)) crp) $;

--| Existence of a square root for positive reals. (Contributed by Mario Carneiro, 9-Jul-2013.)
theorem resqrex {x3: setvar} (A2: class):
  $ wi (wa (wcel A2 cr) (wbr cc0 A2 cle)) (wrex x3 (wa (wbr cc0 (cv x3) cle) (wceq (co (cv x3) c2 cexp) A2)) cr) $;

--| Uniqueness for the square root function. (Contributed by Mario Carneiro, 9-Jul-2013.) (Revised by NM, 17-Jun-2017.)
theorem sqrmo {x3: setvar} (A2: class):
  $ wi (wcel A2 cc) (wrmo x3 (w3a (wceq (co (cv x3) c2 cexp) A2) (wbr cc0 (cfv (cv x3) cre) cle) (wnel (co ci (cv x3) cmul) crp)) cc) $;

--| Existence and uniqueness for the real square root function. (Contributed by Mario Carneiro, 9-Jul-2013.)
theorem resqreu {x3: setvar} (A2: class):
  $ wi (wa (wcel A2 cr) (wbr cc0 A2 cle)) (wreu x3 (w3a (wceq (co (cv x3) c2 cexp) A2) (wbr cc0 (cfv (cv x3) cre) cle) (wnel (co ci (cv x3) cmul) crp)) cc) $;

--| Closure of the square root function. (Contributed by Mario Carneiro, 9-Jul-2013.)
theorem resqrtcl (A2: class):
  $ wi (wa (wcel A2 cr) (wbr cc0 A2 cle)) (wcel (cfv A2 csqrt) cr) $;

--| Lemma for ~ resqrtth . (Contributed by Mario Carneiro, 9-Jul-2013.)
theorem resqrtthlem (A2: class):
  $ wi (wa (wcel A2 cr) (wbr cc0 A2 cle)) (w3a (wceq (co (cfv A2 csqrt) c2 cexp) A2) (wbr cc0 (cfv (cfv A2 csqrt) cre) cle) (wnel (co ci (cfv A2 csqrt) cmul) crp)) $;

--| Square root theorem over the reals. Theorem I.35 of [Apostol] p. 29. (Contributed by Mario Carneiro, 9-Jul-2013.)
theorem resqrtth (A2: class):
  $ wi (wa (wcel A2 cr) (wbr cc0 A2 cle)) (wceq (co (cfv A2 csqrt) c2 cexp) A2) $;

--| Square of square root. (Contributed by Mario Carneiro, 10-Jul-2013.)
theorem remsqsqrt (A2: class):
  $ wi (wa (wcel A2 cr) (wbr cc0 A2 cle)) (wceq (co (cfv A2 csqrt) (cfv A2 csqrt) cmul) A2) $;

--| The square root function is nonnegative for nonnegative input. (Contributed by NM, 26-May-1999.) (Revised by Mario Carneiro, 9-Jul-2013.)
theorem sqrtge0 (A2: class):
  $ wi (wa (wcel A2 cr) (wbr cc0 A2 cle)) (wbr cc0 (cfv A2 csqrt) cle) $;

--| The square root function is positive for positive input. (Contributed by Mario Carneiro, 10-Jul-2013.) (Revised by Mario Carneiro, 6-Sep-2013.)
theorem sqrtgt0 (A2: class):
  $ wi (wa (wcel A2 cr) (wbr cc0 A2 clt)) (wbr cc0 (cfv A2 csqrt) clt) $;

--| Square root distributes over multiplication. (Contributed by NM, 30-Jul-1999.) (Revised by Mario Carneiro, 29-May-2016.)
theorem sqrtmul (A2 B2: class):
  $ wi (wa (wa (wcel A2 cr) (wbr cc0 A2 cle)) (wa (wcel B2 cr) (wbr cc0 B2 cle))) (wceq (cfv (co A2 B2 cmul) csqrt) (co (cfv A2 csqrt) (cfv B2 csqrt) cmul)) $;

--| Square root is monotonic. (Contributed by NM, 17-Mar-2005.) (Proof shortened by Mario Carneiro, 29-May-2016.)
theorem sqrtle (A2 B2: class):
  $ wi (wa (wa (wcel A2 cr) (wbr cc0 A2 cle)) (wa (wcel B2 cr) (wbr cc0 B2 cle))) (wb (wbr A2 B2 cle) (wbr (cfv A2 csqrt) (cfv B2 csqrt) cle)) $;

--| Square root is strictly monotonic. Closed form of ~ sqrtlti . (Contributed by Scott Fenton, 17-Apr-2014.) (Proof shortened by Mario Carneiro, 29-May-2016.)
theorem sqrtlt (A2 B2: class):
  $ wi (wa (wa (wcel A2 cr) (wbr cc0 A2 cle)) (wa (wcel B2 cr) (wbr cc0 B2 cle))) (wb (wbr A2 B2 clt) (wbr (cfv A2 csqrt) (cfv B2 csqrt) clt)) $;

--| The square root function is one-to-one. (Contributed by Scott Fenton, 11-Jun-2013.)
theorem sqrt11 (A2 B2: class):
  $ wi (wa (wa (wcel A2 cr) (wbr cc0 A2 cle)) (wa (wcel B2 cr) (wbr cc0 B2 cle))) (wb (wceq (cfv A2 csqrt) (cfv B2 csqrt)) (wceq A2 B2)) $;

--| A square root is zero iff its argument is 0. (Contributed by NM, 27-Jul-1999.) (Proof shortened by Mario Carneiro, 29-May-2016.)
theorem sqrt00 (A2: class):
  $ wi (wa (wcel A2 cr) (wbr cc0 A2 cle)) (wb (wceq (cfv A2 csqrt) cc0) (wceq A2 cc0)) $;

--| The square root of a positive real is a positive real. (Contributed by NM, 22-Feb-2008.)
theorem rpsqrtcl (A2: class):
  $ wi (wcel A2 crp) (wcel (cfv A2 csqrt) crp) $;

--| Square root distributes over division. (Contributed by Mario Carneiro, 5-May-2016.)
theorem sqrtdiv (A2 B2: class):
  $ wi (wa (wa (wcel A2 cr) (wbr cc0 A2 cle)) (wcel B2 crp)) (wceq (cfv (co A2 B2 cdiv) csqrt) (co (cfv A2 csqrt) (cfv B2 csqrt) cdiv)) $;

--| The square root of a negative number. (Contributed by Mario Carneiro, 9-Jul-2013.)
theorem sqrtneglem (A2: class):
  $ wi (wa (wcel A2 cr) (wbr cc0 A2 cle)) (w3a (wceq (co (co ci (cfv A2 csqrt) cmul) c2 cexp) (cneg A2)) (wbr cc0 (cfv (co ci (cfv A2 csqrt) cmul) cre) cle) (wnel (co ci (co ci (cfv A2 csqrt) cmul) cmul) crp)) $;

--| The square root of a negative number. (Contributed by Mario Carneiro, 9-Jul-2013.)
theorem sqrtneg (A2: class):
  $ wi (wa (wcel A2 cr) (wbr cc0 A2 cle)) (wceq (cfv (cneg A2) csqrt) (co ci (cfv A2 csqrt) cmul)) $;

--| Relationship between square root and squares. (Contributed by NM, 31-Jul-1999.) (Revised by Mario Carneiro, 29-May-2016.)
theorem sqrtsq2 (A2 B2: class):
  $ wi (wa (wa (wcel A2 cr) (wbr cc0 A2 cle)) (wa (wcel B2 cr) (wbr cc0 B2 cle))) (wb (wceq (cfv A2 csqrt) B2) (wceq A2 (co B2 c2 cexp))) $;

--| Square root of square. (Contributed by NM, 14-Jan-2006.) (Revised by Mario Carneiro, 29-May-2016.)
theorem sqrtsq (A2: class):
  $ wi (wa (wcel A2 cr) (wbr cc0 A2 cle)) (wceq (cfv (co A2 c2 cexp) csqrt) A2) $;

--| Square root of square. (Contributed by NM, 2-Aug-1999.) (Revised by Mario Carneiro, 29-May-2016.)
theorem sqrtmsq (A2: class):
  $ wi (wa (wcel A2 cr) (wbr cc0 A2 cle)) (wceq (cfv (co A2 A2 cmul) csqrt) A2) $;

--| The square root of 1 is 1. (Contributed by NM, 31-Jul-1999.)
theorem sqrt1:
  $ wceq (cfv c1 csqrt) c1 $;

--| The square root of 4 is 2. (Contributed by NM, 3-Aug-1999.)
theorem sqrt4:
  $ wceq (cfv c4 csqrt) c2 $;

--| The square root of 9 is 3. (Contributed by NM, 11-May-2004.)
theorem sqrt9:
  $ wceq (cfv c9 csqrt) c3 $;

--| The square root of 2 is bounded by 1 and 2. (Contributed by Roy F. Longton, 8-Aug-2005.) (Revised by Mario Carneiro, 6-Sep-2013.)
theorem sqrt2gt1lt2:
  $ wa (wbr c1 (cfv c2 csqrt) clt) (wbr (cfv c2 csqrt) c2 clt) $;

--| The imaginary unit is the square root of negative 1. A lot of people like to call this the "definition" of ` _i ` , but the definition of ` sqrt ` ~ df-sqrt has already been crafted with ` _i ` being mentioned explicitly, and in any case it doesn't make too much sense to define a value based on a function evaluated outside its domain. A more appropriate view is to take ~ ax-i2m1 or ~ i2 as the "definition", and simply postulate the existence of a number satisfying this property. This is the approach we take here. (Contributed by Mario Carneiro, 10-Jul-2013.)
theorem sqrtm1:
  $ wceq ci (cfv (cneg c1) csqrt) $;

--| A natural number with square one is equal to one. (Contributed by Thierry Arnoux, 2-Feb-2020.) (Proof shortened by Thierry Arnoux, 6-Jun-2023.)
theorem nn0sqeq1 (N: class):
  $ wi (wa (wcel N cn0) (wceq (co N c2 cexp) c1)) (wceq N c1) $;

--| Absolute value of the negative. (Contributed by NM, 27-Feb-2005.)
theorem absneg (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv (cneg A2) cabs) (cfv A2 cabs)) $;

--| Real closure of absolute value. (Contributed by NM, 3-Oct-1999.)
theorem abscl (A2: class):
  $ wi (wcel A2 cc) (wcel (cfv A2 cabs) cr) $;

--| The absolute value of a number and its conjugate are the same. Proposition 10-3.7(b) of [Gleason] p. 133. (Contributed by NM, 28-Apr-2005.)
theorem abscj (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv (cfv A2 ccj) cabs) (cfv A2 cabs)) $;

--| Square of value of absolute value function. (Contributed by NM, 16-Jan-2006.)
theorem absvalsq (A2: class):
  $ wi (wcel A2 cc) (wceq (co (cfv A2 cabs) c2 cexp) (co A2 (cfv A2 ccj) cmul)) $;

--| Square of value of absolute value function. (Contributed by NM, 1-Feb-2007.)
theorem absvalsq2 (A2: class):
  $ wi (wcel A2 cc) (wceq (co (cfv A2 cabs) c2 cexp) (co (co (cfv A2 cre) c2 cexp) (co (cfv A2 cim) c2 cexp) caddc)) $;

--| Square of absolute value of sum. Proposition 10-3.7(g) of [Gleason] p. 133. (Contributed by NM, 21-Jan-2007.)
theorem sqabsadd (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co (cfv (co A2 B2 caddc) cabs) c2 cexp) (co (co (co (cfv A2 cabs) c2 cexp) (co (cfv B2 cabs) c2 cexp) caddc) (co c2 (cfv (co A2 (cfv B2 ccj) cmul) cre) cmul) caddc)) $;

--| Square of absolute value of difference. (Contributed by NM, 21-Jan-2007.)
theorem sqabssub (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co (cfv (co A2 B2 cmin) cabs) c2 cexp) (co (co (co (cfv A2 cabs) c2 cexp) (co (cfv B2 cabs) c2 cexp) caddc) (co c2 (cfv (co A2 (cfv B2 ccj) cmul) cre) cmul) cmin)) $;

--| Value of absolute value function. Definition 10.36 of [Gleason] p. 133. (Contributed by NM, 17-Mar-2005.)
theorem absval2 (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv A2 cabs) (cfv (co (co (cfv A2 cre) c2 cexp) (co (cfv A2 cim) c2 cexp) caddc) csqrt)) $;

--| The absolute value of 0. (Contributed by NM, 26-Mar-2005.) (Revised by Mario Carneiro, 29-May-2016.)
theorem abs0:
  $ wceq (cfv cc0 cabs) cc0 $;

--| The absolute value of the imaginary unit. (Contributed by NM, 26-Mar-2005.)
theorem absi:
  $ wceq (cfv ci cabs) c1 $;

--| Absolute value is nonnegative. (Contributed by NM, 20-Nov-2004.) (Revised by Mario Carneiro, 29-May-2016.)
theorem absge0 (A2: class):
  $ wi (wcel A2 cc) (wbr cc0 (cfv A2 cabs) cle) $;

--| The absolute value of a nonzero number is a positive real. (Contributed by FL, 27-Dec-2007.) (Proof shortened by Mario Carneiro, 29-May-2016.)
theorem absrpcl (A2: class):
  $ wi (wa (wcel A2 cc) (wne A2 cc0)) (wcel (cfv A2 cabs) crp) $;

--| The absolute value of a number is zero iff the number is zero. Proposition 10-3.7(c) of [Gleason] p. 133. (Contributed by NM, 26-Sep-2005.) (Proof shortened by Mario Carneiro, 29-May-2016.)
theorem abs00 (A2: class):
  $ wi (wcel A2 cc) (wb (wceq (cfv A2 cabs) cc0) (wceq A2 cc0)) $;

--| A complex number is zero iff its absolute value is zero. Deduction form of ~ abs00 . (Contributed by David Moews, 28-Feb-2017.)
theorem abs00ad (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wb (wceq (cfv A2 cabs) cc0) (wceq A2 cc0)) $;

--| If a complex number is zero, its absolute value is zero. Converse of ~ abs00d . One-way deduction form of ~ abs00 . (Contributed by David Moews, 28-Feb-2017.)
theorem abs00bd (ph: wff) (A2: class):
  $ wi ph (wceq A2 cc0) $ >
  $ wi ph (wceq (cfv A2 cabs) cc0) $;

--| Square of the absolute value of a number that has been decomposed into real and imaginary parts. (Contributed by NM, 1-Feb-2007.)
theorem absreimsq (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wceq (co (cfv (co A2 (co ci B2 cmul) caddc) cabs) c2 cexp) (co (co A2 c2 cexp) (co B2 c2 cexp) caddc)) $;

--| Absolute value of a number that has been decomposed into real and imaginary parts. (Contributed by NM, 14-Jan-2006.)
theorem absreim (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wceq (cfv (co A2 (co ci B2 cmul) caddc) cabs) (cfv (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) csqrt)) $;

--| Absolute value distributes over multiplication. Proposition 10-3.7(f) of [Gleason] p. 133. (Contributed by NM, 11-Oct-1999.) (Revised by Mario Carneiro, 29-May-2016.)
theorem absmul (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (cfv (co A2 B2 cmul) cabs) (co (cfv A2 cabs) (cfv B2 cabs) cmul)) $;

--| Absolute value distributes over division. (Contributed by NM, 27-Apr-2005.)
theorem absdiv (A2 B2: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wne B2 cc0)) (wceq (cfv (co A2 B2 cdiv) cabs) (co (cfv A2 cabs) (cfv B2 cabs) cdiv)) $;

--| A nonnegative number is its own absolute value. (Contributed by NM, 11-Oct-1999.) (Revised by Mario Carneiro, 29-May-2016.)
theorem absid (A2: class):
  $ wi (wa (wcel A2 cr) (wbr cc0 A2 cle)) (wceq (cfv A2 cabs) A2) $;

--| The absolute value of one is one. (Contributed by David A. Wheeler, 16-Jul-2016.)
theorem abs1:
  $ wceq (cfv c1 cabs) c1 $;

--| For a negative number, its absolute value is its negation. (Contributed by NM, 27-Feb-2005.)
theorem absnid (A2: class):
  $ wi (wa (wcel A2 cr) (wbr A2 cc0 cle)) (wceq (cfv A2 cabs) (cneg A2)) $;

--| A real number is less than or equal to its absolute value. (Contributed by NM, 27-Feb-2005.)
theorem leabs (A2: class):
  $ wi (wcel A2 cr) (wbr A2 (cfv A2 cabs) cle) $;

--| The absolute value of a real number is either that number or its negative. (Contributed by NM, 27-Feb-2005.)
theorem absor (A2: class):
  $ wi (wcel A2 cr) (wo (wceq (cfv A2 cabs) A2) (wceq (cfv A2 cabs) (cneg A2))) $;

--| Absolute value of a real number. (Contributed by NM, 17-Mar-2005.)
theorem absre (A2: class):
  $ wi (wcel A2 cr) (wceq (cfv A2 cabs) (cfv (co A2 c2 cexp) csqrt)) $;

--| Square of the absolute value of a real number. (Contributed by NM, 16-Jan-2006.)
theorem absresq (A2: class):
  $ wi (wcel A2 cr) (wceq (co (cfv A2 cabs) c2 cexp) (co A2 c2 cexp)) $;

--| ` A ` is divisible by ` B ` iff its absolute value is. (Contributed by Jeff Madsen, 2-Sep-2009.)
theorem absmod0 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 crp)) (wb (wceq (co A2 B2 cmo) cc0) (wceq (co (cfv A2 cabs) B2 cmo) cc0)) $;

--| Absolute value of positive integer exponentiation. (Contributed by NM, 5-Jan-2006.)
theorem absexp (A2 N: class):
  $ wi (wa (wcel A2 cc) (wcel N cn0)) (wceq (cfv (co A2 N cexp) cabs) (co (cfv A2 cabs) N cexp)) $;

--| Absolute value of integer exponentiation. (Contributed by Mario Carneiro, 6-Apr-2015.)
theorem absexpz (A2 N: class):
  $ wi (w3a (wcel A2 cc) (wne A2 cc0) (wcel N cz)) (wceq (cfv (co A2 N cexp) cabs) (co (cfv A2 cabs) N cexp)) $;

--| Square can be moved in and out of absolute value. (Contributed by Scott Fenton, 18-Apr-2014.) (Proof shortened by Mario Carneiro, 29-May-2016.)
theorem abssq (A2: class):
  $ wi (wcel A2 cc) (wceq (co (cfv A2 cabs) c2 cexp) (cfv (co A2 c2 cexp) cabs)) $;

--| The squares of two reals are equal iff their absolute values are equal. (Contributed by NM, 6-Mar-2009.)
theorem sqabs (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wb (wceq (co A2 c2 cexp) (co B2 c2 cexp)) (wceq (cfv A2 cabs) (cfv B2 cabs))) $;

--| The absolute value of a complex number is greater than or equal to the absolute value of its real part. (Contributed by NM, 1-Apr-2005.)
theorem absrele (A2: class):
  $ wi (wcel A2 cc) (wbr (cfv (cfv A2 cre) cabs) (cfv A2 cabs) cle) $;

--| The absolute value of a complex number is greater than or equal to the absolute value of its imaginary part. (Contributed by NM, 17-Mar-2005.) (Proof shortened by Mario Carneiro, 29-May-2016.)
theorem absimle (A2: class):
  $ wi (wcel A2 cc) (wbr (cfv (cfv A2 cim) cabs) (cfv A2 cabs) cle) $;

--| The sum of the positive and negative part functions is the absolute value function over the reals. (Contributed by Mario Carneiro, 24-Aug-2014.)
theorem max0add (A2: class):
  $ wi (wcel A2 cr) (wceq (co (cif (wbr cc0 A2 cle) A2 cc0) (cif (wbr cc0 (cneg A2) cle) (cneg A2) cc0) caddc) (cfv A2 cabs)) $;

--| A real number is an integer iff its absolute value is an integer. (Contributed by Jeff Madsen, 2-Sep-2009.) (Proof shortened by Mario Carneiro, 29-May-2016.)
theorem absz (A2: class):
  $ wi (wcel A2 cr) (wb (wcel A2 cz) (wcel (cfv A2 cabs) cz)) $;

--| The absolute value of an integer is a nonnegative integer. (Contributed by NM, 27-Feb-2005.) (Proof shortened by Mario Carneiro, 29-May-2016.)
theorem nn0abscl (A2: class):
  $ wi (wcel A2 cz) (wcel (cfv A2 cabs) cn0) $;

--| The absolute value of an integer is an integer. (Contributed by Stefan O'Rear, 24-Sep-2014.)
theorem zabscl (A2: class):
  $ wi (wcel A2 cz) (wcel (cfv A2 cabs) cz) $;

--| An integer has an absolute value less than 1 iff it is 0. (Contributed by AV, 21-Nov-2025.)
theorem zabs0b (X: class):
  $ wi (wcel X cz) (wb (wbr (cfv X cabs) c1 clt) (wceq X cc0)) $;

--| Absolute value and 'less than' relation. (Contributed by NM, 6-Apr-2005.) (Revised by Mario Carneiro, 29-May-2016.)
theorem abslt (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wb (wbr (cfv A2 cabs) B2 clt) (wa (wbr (cneg B2) A2 clt) (wbr A2 B2 clt))) $;

--| Absolute value and 'less than or equal to' relation. (Contributed by NM, 6-Apr-2005.) (Revised by Mario Carneiro, 29-May-2016.)
theorem absle (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wb (wbr (cfv A2 cabs) B2 cle) (wa (wbr (cneg B2) A2 cle) (wbr A2 B2 cle))) $;

--| If the absolute value of a complex number is less than a real, its difference from the real is nonzero. (Contributed by NM, 2-Nov-2007.) (Proof shortened by Mario Carneiro, 29-May-2016.)
theorem abssubne0 (A2 B2: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cr) (wbr (cfv A2 cabs) B2 clt)) (wne (co B2 A2 cmin) cc0) $;

--| The absolute value of a difference and 'less than' relation. (Contributed by Paul Chapman, 18-Sep-2007.)
theorem absdiflt (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wb (wbr (cfv (co A2 B2 cmin) cabs) C clt) (wa (wbr (co B2 C cmin) A2 clt) (wbr A2 (co B2 C caddc) clt))) $;

--| The absolute value of a difference and 'less than or equal to' relation. (Contributed by Paul Chapman, 18-Sep-2007.)
theorem absdifle (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wb (wbr (cfv (co A2 B2 cmin) cabs) C cle) (wa (wbr (co B2 C cmin) A2 cle) (wbr A2 (co B2 C caddc) cle))) $;

--| Membership in a symmetric closed real interval. (Contributed by Stefan O'Rear, 16-Nov-2014.)
theorem elicc4abs (A2 B2 C: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wcel C cr)) (wb (wcel C (co (co A2 B2 cmin) (co A2 B2 caddc) cicc)) (wbr (cfv (co C A2 cmin) cabs) B2 cle)) $;

--| Comparison to a nonnegative number based on comparison to squares. (Contributed by NM, 16-Jan-2006.)
theorem lenegsq (A2 B2: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wbr cc0 B2 cle)) (wb (wa (wbr A2 B2 cle) (wbr (cneg A2) B2 cle)) (wbr (co A2 c2 cexp) (co B2 c2 cexp) cle)) $;

--| The real part of a number is less than or equal to its absolute value. Proposition 10-3.7(d) of [Gleason] p. 133. (Contributed by NM, 1-Apr-2005.)
theorem releabs (A2: class):
  $ wi (wcel A2 cc) (wbr (cfv A2 cre) (cfv A2 cabs) cle) $;

--| Reciprocal expressed with a real denominator. (Contributed by Mario Carneiro, 1-Apr-2015.)
theorem recval (A2: class):
  $ wi (wa (wcel A2 cc) (wne A2 cc0)) (wceq (co c1 A2 cdiv) (co (cfv A2 ccj) (co (cfv A2 cabs) c2 cexp) cdiv)) $;

--| The absolute value function is idempotent. (Contributed by NM, 20-Nov-2004.)
theorem absidm (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv (cfv A2 cabs) cabs) (cfv A2 cabs)) $;

--| The absolute value of a nonzero number is positive. (Contributed by NM, 1-Oct-1999.) (Proof shortened by Mario Carneiro, 29-May-2016.)
theorem absgt0 (A2: class):
  $ wi (wcel A2 cc) (wb (wne A2 cc0) (wbr cc0 (cfv A2 cabs) clt)) $;

--| The absolute value of a nonzero integer is a positive integer. (Contributed by Paul Chapman, 21-Mar-2011.) (Proof shortened by Andrew Salmon, 25-May-2011.)
theorem nnabscl (N: class):
  $ wi (wa (wcel N cz) (wne N cc0)) (wcel (cfv N cabs) cn) $;

--| Swapping order of subtraction doesn't change the absolute value. (Contributed by NM, 1-Oct-1999.) (Proof shortened by Mario Carneiro, 29-May-2016.)
theorem abssub (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (cfv (co A2 B2 cmin) cabs) (cfv (co B2 A2 cmin) cabs)) $;

--| Absolute value of a nonnegative difference. (Contributed by NM, 14-Feb-2008.)
theorem abssubge0 (A2 B2: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wbr A2 B2 cle)) (wceq (cfv (co B2 A2 cmin) cabs) (co B2 A2 cmin)) $;

--| Absolute value of a nonpositive difference. (Contributed by FL, 3-Jan-2008.)
theorem abssuble0 (A2 B2: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wbr A2 B2 cle)) (wceq (cfv (co A2 B2 cmin) cabs) (co B2 A2 cmin)) $;

--| The maximum of two numbers using absolute value. (Contributed by NM, 7-Aug-2008.)
theorem absmax (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wceq (cif (wbr A2 B2 cle) B2 A2) (co (co (co A2 B2 caddc) (cfv (co A2 B2 cmin) cabs) caddc) c2 cdiv)) $;

--| Triangle inequality for absolute value. Proposition 10-3.7(h) of [Gleason] p. 133. (Contributed by NM, 7-Mar-2005.) (Proof shortened by Mario Carneiro, 29-May-2016.)
theorem abstri (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wbr (cfv (co A2 B2 caddc) cabs) (co (cfv A2 cabs) (cfv B2 cabs) caddc) cle) $;

--| Absolute value of differences around common element. (Contributed by FL, 9-Oct-2006.)
theorem abs3dif (A2 B2 C: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel C cc)) (wbr (cfv (co A2 B2 cmin) cabs) (co (cfv (co A2 C cmin) cabs) (cfv (co C B2 cmin) cabs) caddc) cle) $;

--| Difference of absolute values. (Contributed by Paul Chapman, 7-Sep-2007.)
theorem abs2dif (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wbr (co (cfv A2 cabs) (cfv B2 cabs) cmin) (cfv (co A2 B2 cmin) cabs) cle) $;

--| Difference of absolute values. (Contributed by Mario Carneiro, 14-Apr-2016.)
theorem abs2dif2 (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wbr (cfv (co A2 B2 cmin) cabs) (co (cfv A2 cabs) (cfv B2 cabs) caddc) cle) $;

--| Absolute value of difference of absolute values. (Contributed by Paul Chapman, 7-Sep-2007.)
theorem abs2difabs (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wbr (cfv (co (cfv A2 cabs) (cfv B2 cabs) cmin) cabs) (cfv (co A2 B2 cmin) cabs) cle) $;

--| For any complex number, there exists a unit-magnitude multiplier that produces its absolute value. Part of proof of Theorem 13-2.12 of [Gleason] p. 195. (Contributed by NM, 26-Mar-2005.)
theorem abs1m {x3: setvar} (A2: class):
  $ wi (wcel A2 cc) (wrex x3 (wa (wceq (cfv (cv x3) cabs) c1) (wceq (cfv A2 cabs) (co (cv x3) A2 cmul))) cc) $;

--| Cancellation law involving the real part of a complex number. (Contributed by NM, 12-May-2005.)
theorem recan {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wb (wral x3 (wceq (cfv (co (cv x3) A2 cmul) cre) (cfv (co (cv x3) B2 cmul) cre)) cc) (wceq A2 B2)) $;

--| Mapping domain and codomain of the absolute value function. (Contributed by NM, 30-Aug-2007.) (Revised by Mario Carneiro, 7-Nov-2013.)
theorem absf:
  $ wf cc cr cabs $;

--| Lemma involving absolute value of differences. (Contributed by NM, 2-Oct-1999.)
theorem abs3lem (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cc) (wcel B2 cc)) (wa (wcel C cc) (wcel D cr))) (wi (wa (wbr (cfv (co A2 C cmin) cabs) (co D c2 cdiv) clt) (wbr (cfv (co C B2 cmin) cabs) (co D c2 cdiv) clt)) (wbr (cfv (co A2 B2 cmin) cabs) D clt)) $;

--| Lemma involving absolute values. (Contributed by NM, 11-Oct-1999.) (Revised by Mario Carneiro, 29-May-2016.)
theorem abslem2 (A2: class):
  $ wi (wa (wcel A2 cc) (wne A2 cc0)) (wceq (co (co (cfv (co A2 (cfv A2 cabs) cdiv) ccj) A2 cmul) (co (co A2 (cfv A2 cabs) cdiv) (cfv A2 ccj) cmul) caddc) (co c2 (cfv A2 cabs) cmul)) $;

--| The difference between a real number and its nearest integer is less than or equal to one half. (Contributed by Jeff Madsen, 2-Sep-2009.) (Proof shortened by Mario Carneiro, 14-Sep-2015.)
theorem rddif (A2: class):
  $ wi (wcel A2 cr) (wbr (cfv (co (cfv (co A2 (co c1 c2 cdiv) caddc) cfl) A2 cmin) cabs) (co c1 c2 cdiv) cle) $;

--| Bound on the absolute value of a real number rounded to the nearest integer. (Contributed by Jeff Madsen, 2-Sep-2009.) (Proof shortened by Mario Carneiro, 14-Sep-2015.)
theorem absrdbnd (A2: class):
  $ wi (wcel A2 cr) (wbr (cfv (cfv (co A2 (co c1 c2 cdiv) caddc) cfl) cabs) (co (cfv (cfv A2 cabs) cfl) c1 caddc) cle) $;

--| Lemma for ~ fzomaxdif . (Contributed by Stefan O'Rear, 6-Sep-2015.)
theorem fzomaxdiflem (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 (co C D cfzo)) (wcel B2 (co C D cfzo))) (wbr A2 B2 cle)) (wcel (cfv (co B2 A2 cmin) cabs) (co cc0 (co D C cmin) cfzo)) $;

--| A bound on the separation of two points in a half-open range. (Contributed by Stefan O'Rear, 6-Sep-2015.)
theorem fzomaxdif (A2 B2 C D: class):
  $ wi (wa (wcel A2 (co C D cfzo)) (wcel B2 (co C D cfzo))) (wcel (cfv (co A2 B2 cmin) cabs) (co cc0 (co D C cmin) cfzo)) $;

--| The upper integers are closed under intersection. (Contributed by Mario Carneiro, 24-Dec-2013.)
theorem uzin2 (A2 B2: class):
  $ wi (wa (wcel A2 (crn cuz)) (wcel B2 (crn cuz))) (wcel (cin A2 B2) (crn cuz)) $;

--| Combine two different upper integer properties into one. (Contributed by Mario Carneiro, 25-Dec-2013.)
theorem rexanuz {j k: setvar} (ph ps: wff k):
  $ wb (wrex j (wral k (wa ph ps) (cfv (cv j) cuz)) cz) (wa (wrex j (wral k ph (cfv (cv j) cuz)) cz) (wrex j (wral k ps (cfv (cv j) cuz)) cz)) $;

--| Combine two different upper real properties into one. (Contributed by Mario Carneiro, 8-May-2016.)
theorem rexanre {j k: setvar} (ph ps: wff k) (A2: class):
  $ wi (wss A2 cr) (wb (wrex j (wral k (wi (wbr (cv j) (cv k) cle) (wa ph ps)) A2) cr) (wa (wrex j (wral k (wi (wbr (cv j) (cv k) cle) ph) A2) cr) (wrex j (wral k (wi (wbr (cv j) (cv k) cle) ps) A2) cr))) $;

--| Combine finitely many different upper integer properties into one. (Contributed by Mario Carneiro, 6-Jun-2014.)
theorem rexfiuz {j k n: setvar} (ph: wff k n) (A2: class):
  $ wi (wcel A2 cfn) (wb (wrex j (wral k (wral n ph A2) (cfv (cv j) cuz)) cz) (wral n (wrex j (wral k ph (cfv (cv j) cuz)) cz) A2)) $;

--| Restrict the base of the upper integers set to another upper integers set. (Contributed by Mario Carneiro, 26-Dec-2013.)
theorem rexuz3 {j k: setvar} (ph: wff k) (M: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi (wcel M cz) (wb (wrex j (wral k ph (cfv (cv j) cuz)) Z) (wrex j (wral k ph (cfv (cv j) cuz)) cz)) $;

--| Combine two different upper integer properties into one. (Contributed by Mario Carneiro, 26-Dec-2013.)
theorem rexanuz2 {j k: setvar} (ph ps: wff k) (M: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wb (wrex j (wral k (wa ph ps) (cfv (cv j) cuz)) Z) (wa (wrex j (wral k ph (cfv (cv j) cuz)) Z) (wrex j (wral k ps (cfv (cv j) cuz)) Z)) $;

--| A version of ~ 19.29 for upper integer quantifiers. (Contributed by Mario Carneiro, 10-Feb-2014.)
theorem r19_29uz {j k: setvar} (ph: wff k) (ps: wff j k) (M: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi (wa (wral k ph Z) (wrex j (wral k ps (cfv (cv j) cuz)) Z)) (wrex j (wral k (wa ph ps) (cfv (cv j) cuz)) Z) $;

--| A version of ~ r19.2z for upper integer quantifiers. (Contributed by Mario Carneiro, 15-Feb-2014.)
theorem r19_2uz {j k: setvar} (ph: wff k) (M: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi (wrex j (wral k ph (cfv (cv j) cuz)) Z) (wrex k ph Z) $;

--| Convert an upper real quantifier to an upper integer quantifier. (Contributed by Mario Carneiro, 7-May-2016.)
theorem rexuzre {j k: setvar} (ph: wff k) (M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi (wcel M cz) (wb (wrex j (wral k ph (cfv (cv j) cuz)) Z) (wrex j (wral k (wi (wbr (cv j) (cv k) cle) ph) Z) cr)) $;

--| Restrict the base of an upper real quantifier to an upper real set. (Contributed by Mario Carneiro, 12-May-2016.)
theorem rexico {j k: setvar} (ph: wff k) (A2 B2: class):
  $ wi (wa (wss A2 cr) (wcel B2 cr)) (wb (wrex j (wral k (wi (wbr (cv j) (cv k) cle) ph) A2) (co B2 cpnf cico)) (wrex j (wral k (wi (wbr (cv j) (cv k) cle) ph) A2) cr)) $;

--| Lemma for ~ cau3 . (Contributed by Mario Carneiro, 15-Feb-2014.) (Revised by Mario Carneiro, 1-May-2014.)
theorem cau3lem {x3 j k m: setvar} (ph: wff) (ps: wff j k) (ch: wff x3 j) (th: wff x3 j m) (ta: wff j k m) (D F G: class j) (Z: class j k m):
  $ wss Z cz $ >
  $ wi ta ps $ >
  $ wi (wceq (cfv (cv k) F) (cfv (cv j) F)) (wb ps ch) $ >
  $ wi (wceq (cfv (cv k) F) (cfv (cv m) F)) (wb ps th) $ >
  $ wi (w3a ph ch ps) (wceq (cfv (co (cfv (cv j) F) (cfv (cv k) F) D) G) (cfv (co (cfv (cv k) F) (cfv (cv j) F) D) G)) $ >
  $ wi (w3a ph th ch) (wceq (cfv (co (cfv (cv m) F) (cfv (cv j) F) D) G) (cfv (co (cfv (cv j) F) (cfv (cv m) F) D) G)) $ >
  $ wi (w3a ph (wa ps th) (wa ch (wcel (cv x3) cr))) (wi (wa (wbr (cfv (co (cfv (cv k) F) (cfv (cv j) F) D) G) (co (cv x3) c2 cdiv) clt) (wbr (cfv (co (cfv (cv j) F) (cfv (cv m) F) D) G) (co (cv x3) c2 cdiv) clt)) (wbr (cfv (co (cfv (cv k) F) (cfv (cv m) F) D) G) (cv x3) clt)) $ >
  $ wi ph (wb (wral x3 (wrex j (wral k (wa ta (wbr (cfv (co (cfv (cv k) F) (cfv (cv j) F) D) G) (cv x3) clt)) (cfv (cv j) cuz)) Z) crp) (wral x3 (wrex j (wral k (wa ta (wral m (wbr (cfv (co (cfv (cv k) F) (cfv (cv m) F) D) G) (cv x3) clt) (cfv (cv k) cuz))) (cfv (cv j) cuz)) Z) crp)) $;

--| Convert between three-quantifier and four-quantifier versions of the Cauchy criterion. (In particular, the four-quantifier version has no occurrence of ` j ` in the assertion, so it can be used with ~ rexanuz and friends.) (Contributed by Mario Carneiro, 15-Feb-2014.)
theorem cau3 {x3 j k m: setvar} (F: class) (M Z: class m):
  $ wceq Z (cfv M cuz) $ >
  $ wb (wral x3 (wrex j (wral k (wa (wcel (cfv (cv k) F) cc) (wbr (cfv (co (cfv (cv k) F) (cfv (cv j) F) cmin) cabs) (cv x3) clt)) (cfv (cv j) cuz)) Z) crp) (wral x3 (wrex j (wral k (wa (wcel (cfv (cv k) F) cc) (wral m (wbr (cfv (co (cfv (cv k) F) (cfv (cv m) F) cmin) cabs) (cv x3) clt) (cfv (cv k) cuz))) (cfv (cv j) cuz)) Z) crp) $;

--| Change the base of a Cauchy criterion. (Contributed by Mario Carneiro, 18-Mar-2014.)
theorem cau4 {x3 j k: setvar} (F M N W Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wceq W (cfv N cuz) $ >
  $ wi (wcel N Z) (wb (wral x3 (wrex j (wral k (wa (wcel (cfv (cv k) F) cc) (wbr (cfv (co (cfv (cv k) F) (cfv (cv j) F) cmin) cabs) (cv x3) clt)) (cfv (cv j) cuz)) Z) crp) (wral x3 (wrex j (wral k (wa (wcel (cfv (cv k) F) cc) (wbr (cfv (co (cfv (cv k) F) (cfv (cv j) F) cmin) cabs) (cv x3) clt)) (cfv (cv j) cuz)) W) crp)) $;

--| A Cauchy sequence of complex numbers is eventually bounded. (Contributed by Mario Carneiro, 14-Feb-2014.)
theorem caubnd2 {x3 y1 j k: setvar} (F: class) (M: class y1) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi (wral x3 (wrex j (wral k (wa (wcel (cfv (cv k) F) cc) (wbr (cfv (co (cfv (cv k) F) (cfv (cv j) F) cmin) cabs) (cv x3) clt)) (cfv (cv j) cuz)) Z) crp) (wrex y1 (wrex j (wral k (wbr (cfv (cfv (cv k) F) cabs) (cv y1) clt) (cfv (cv j) cuz)) Z) cr) $;

--| A Cauchy sequence of complex numbers is bounded. (Contributed by NM, 4-Apr-2005.) (Revised by Mario Carneiro, 14-Feb-2014.)
theorem caubnd {x3 y1 j k: setvar} (F: class) (M: class y1) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi (wa (wral k (wcel (cfv (cv k) F) cc) Z) (wral x3 (wrex j (wral k (wbr (cfv (co (cfv (cv k) F) (cfv (cv j) F) cmin) cabs) (cv x3) clt) (cfv (cv j) cuz)) Z) crp)) (wrex y1 (wral k (wbr (cfv (cfv (cv k) F) cabs) (cv y1) clt) Z) cr) $;

--| Lemma for ~ sqreu : write a general complex square root in terms of the square root function over nonnegative reals. (Contributed by Mario Carneiro, 9-Jul-2013.)
theorem sqreulem (A2 B2: class):
  $ wceq B2 (co (cfv (cfv A2 cabs) csqrt) (co (co (cfv A2 cabs) A2 caddc) (cfv (co (cfv A2 cabs) A2 caddc) cabs) cdiv) cmul) $ >
  $ wi (wa (wcel A2 cc) (wne (co (cfv A2 cabs) A2 caddc) cc0)) (w3a (wceq (co B2 c2 cexp) A2) (wbr cc0 (cfv B2 cre) cle) (wnel (co ci B2 cmul) crp)) $;

--| Existence and uniqueness for the square root function in general. (Contributed by Mario Carneiro, 9-Jul-2013.)
theorem sqreu {x3: setvar} (A2: class):
  $ wi (wcel A2 cc) (wreu x3 (w3a (wceq (co (cv x3) c2 cexp) A2) (wbr cc0 (cfv (cv x3) cre) cle) (wnel (co ci (cv x3) cmul) crp)) cc) $;

--| Closure of the square root function over the complex numbers. (Contributed by Mario Carneiro, 10-Jul-2013.)
theorem sqrtcl (A2: class):
  $ wi (wcel A2 cc) (wcel (cfv A2 csqrt) cc) $;

--| Lemma for ~ sqrtth . (Contributed by Mario Carneiro, 10-Jul-2013.)
theorem sqrtthlem (A2: class):
  $ wi (wcel A2 cc) (w3a (wceq (co (cfv A2 csqrt) c2 cexp) A2) (wbr cc0 (cfv (cfv A2 csqrt) cre) cle) (wnel (co ci (cfv A2 csqrt) cmul) crp)) $;

--| Mapping domain and codomain of the square root function. (Contributed by Mario Carneiro, 13-Sep-2015.)
theorem sqrtf:
  $ wf cc cc csqrt $;

--| Square root theorem over the complex numbers. Theorem I.35 of [Apostol] p. 29. (Contributed by Mario Carneiro, 10-Jul-2013.)
theorem sqrtth (A2: class):
  $ wi (wcel A2 cc) (wceq (co (cfv A2 csqrt) c2 cexp) A2) $;

--| The square root function must make a choice between the two roots, which differ by a sign change. In the general complex case, the choice of "positive" and "negative" is not so clear. The convention we use is to take the root with positive real part, unless ` A ` is a nonpositive real (in which case both roots have 0 real part); in this case we take the one in the positive imaginary direction. Another way to look at this is that we choose the root that is largest with respect to lexicographic order on the complex numbers (sorting by real part first, then by imaginary part as tie-breaker). (Contributed by Mario Carneiro, 10-Jul-2013.)
theorem sqrtrege0 (A2: class):
  $ wi (wcel A2 cc) (wbr cc0 (cfv (cfv A2 csqrt) cre) cle) $;

--| Solve an equation containing a square. (Contributed by Mario Carneiro, 23-Apr-2015.)
theorem eqsqrtor (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wb (wceq (co A2 c2 cexp) B2) (wo (wceq A2 (cfv B2 csqrt)) (wceq A2 (cneg (cfv B2 csqrt))))) $;

--| A deduction for showing that a number equals the square root of another. (Contributed by Mario Carneiro, 3-Apr-2015.)
theorem eqsqrtd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wceq (co A2 c2 cexp) B2) $ >
  $ wi ph (wbr cc0 (cfv A2 cre) cle) $ >
  $ wi ph (wn (wcel (co ci A2 cmul) crp)) $ >
  $ wi ph (wceq A2 (cfv B2 csqrt)) $;

--| A deduction for showing that a number equals the square root of another. (Contributed by Mario Carneiro, 3-Apr-2015.)
theorem eqsqrt2d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wceq (co A2 c2 cexp) B2) $ >
  $ wi ph (wbr cc0 (cfv A2 cre) clt) $ >
  $ wi ph (wceq A2 (cfv B2 csqrt)) $;

--| Arithmetic-geometric mean inequality for ` n = 2 ` . (Contributed by Mario Carneiro, 2-Jul-2014.) (Proof shortened by AV, 9-Jul-2022.)
theorem amgm2 (A2 B2: class):
  $ wi (wa (wa (wcel A2 cr) (wbr cc0 A2 cle)) (wa (wcel B2 cr) (wbr cc0 B2 cle))) (wbr (cfv (co A2 B2 cmul) csqrt) (co (co A2 B2 caddc) c2 cdiv) cle) $;

--| Square root theorem. Theorem I.35 of [Apostol] p. 29. (Contributed by NM, 26-May-1999.) (Revised by Mario Carneiro, 6-Sep-2013.)
theorem sqrtthi (A2: class):
  $ wcel A2 cr $ >
  $ wi (wbr cc0 A2 cle) (wceq (co (cfv A2 csqrt) (cfv A2 csqrt) cmul) A2) $;

--| The square root of a nonnegative real is a real. (Contributed by NM, 26-May-1999.) (Revised by Mario Carneiro, 6-Sep-2013.)
theorem sqrtcli (A2: class):
  $ wcel A2 cr $ >
  $ wi (wbr cc0 A2 cle) (wcel (cfv A2 csqrt) cr) $;

--| The square root of a positive real is positive. (Contributed by NM, 26-May-1999.) (Revised by Mario Carneiro, 6-Sep-2013.)
theorem sqrtgt0i (A2: class):
  $ wcel A2 cr $ >
  $ wi (wbr cc0 A2 clt) (wbr cc0 (cfv A2 csqrt) clt) $;

--| Square root of square. (Contributed by NM, 2-Aug-1999.)
theorem sqrtmsqi (A2: class):
  $ wcel A2 cr $ >
  $ wi (wbr cc0 A2 cle) (wceq (cfv (co A2 A2 cmul) csqrt) A2) $;

--| Square root of square. (Contributed by NM, 11-Aug-1999.)
theorem sqrtsqi (A2: class):
  $ wcel A2 cr $ >
  $ wi (wbr cc0 A2 cle) (wceq (cfv (co A2 c2 cexp) csqrt) A2) $;

--| Square of square root. (Contributed by NM, 11-Aug-1999.)
theorem sqsqrti (A2: class):
  $ wcel A2 cr $ >
  $ wi (wbr cc0 A2 cle) (wceq (co (cfv A2 csqrt) c2 cexp) A2) $;

--| The square root of a nonnegative real is nonnegative. (Contributed by NM, 26-May-1999.) (Revised by Mario Carneiro, 6-Sep-2013.)
theorem sqrtge0i (A2: class):
  $ wcel A2 cr $ >
  $ wi (wbr cc0 A2 cle) (wbr cc0 (cfv A2 csqrt) cle) $;

--| A nonnegative number is its own absolute value. (Contributed by NM, 2-Aug-1999.)
theorem absidi (A2: class):
  $ wcel A2 cr $ >
  $ wi (wbr cc0 A2 cle) (wceq (cfv A2 cabs) A2) $;

--| A negative number is the negative of its own absolute value. (Contributed by NM, 2-Aug-1999.)
theorem absnidi (A2: class):
  $ wcel A2 cr $ >
  $ wi (wbr A2 cc0 cle) (wceq (cfv A2 cabs) (cneg A2)) $;

--| A real number is less than or equal to its absolute value. (Contributed by NM, 2-Aug-1999.)
theorem leabsi (A2: class):
  $ wcel A2 cr $ >
  $ wbr A2 (cfv A2 cabs) cle $;

--| The absolute value of a real number is either that number or its negative. (Contributed by NM, 30-Sep-1999.)
theorem absori (A2: class):
  $ wcel A2 cr $ >
  $ wo (wceq (cfv A2 cabs) A2) (wceq (cfv A2 cabs) (cneg A2)) $;

--| Absolute value of a real number. (Contributed by NM, 3-Aug-1999.)
theorem absrei (A2: class):
  $ wcel A2 cr $ >
  $ wceq (cfv A2 cabs) (cfv (co A2 c2 cexp) csqrt) $;

--| The square root of a positive real is a real. (Contributed by Mario Carneiro, 6-Sep-2013.)
theorem sqrtpclii (A2: class):
  $ wcel A2 cr $ >
  $ wbr cc0 A2 clt $ >
  $ wcel (cfv A2 csqrt) cr $;

--| The square root of a positive real is positive. (Contributed by NM, 26-May-1999.) (Revised by Mario Carneiro, 6-Sep-2013.)
theorem sqrtgt0ii (A2: class):
  $ wcel A2 cr $ >
  $ wbr cc0 A2 clt $ >
  $ wbr cc0 (cfv A2 csqrt) clt $;

--| The square root function is one-to-one. (Contributed by NM, 27-Jul-1999.)
theorem sqrt11i (A2 B2: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wi (wa (wbr cc0 A2 cle) (wbr cc0 B2 cle)) (wb (wceq (cfv A2 csqrt) (cfv B2 csqrt)) (wceq A2 B2)) $;

--| Square root distributes over multiplication. (Contributed by NM, 30-Jul-1999.)
theorem sqrtmuli (A2 B2: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wi (wa (wbr cc0 A2 cle) (wbr cc0 B2 cle)) (wceq (cfv (co A2 B2 cmul) csqrt) (co (cfv A2 csqrt) (cfv B2 csqrt) cmul)) $;

--| Square root distributes over multiplication. (Contributed by NM, 30-Jul-1999.)
theorem sqrtmulii (A2 B2: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wbr cc0 A2 cle $ >
  $ wbr cc0 B2 cle $ >
  $ wceq (cfv (co A2 B2 cmul) csqrt) (co (cfv A2 csqrt) (cfv B2 csqrt) cmul) $;

--| Relationship between square root and squares. (Contributed by NM, 31-Jul-1999.)
theorem sqrtmsq2i (A2 B2: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wi (wa (wbr cc0 A2 cle) (wbr cc0 B2 cle)) (wb (wceq (cfv A2 csqrt) B2) (wceq A2 (co B2 B2 cmul))) $;

--| Square root is monotonic. (Contributed by NM, 3-Aug-1999.)
theorem sqrtlei (A2 B2: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wi (wa (wbr cc0 A2 cle) (wbr cc0 B2 cle)) (wb (wbr A2 B2 cle) (wbr (cfv A2 csqrt) (cfv B2 csqrt) cle)) $;

--| Square root is strictly monotonic. (Contributed by Roy F. Longton, 8-Aug-2005.)
theorem sqrtlti (A2 B2: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wi (wa (wbr cc0 A2 cle) (wbr cc0 B2 cle)) (wb (wbr A2 B2 clt) (wbr (cfv A2 csqrt) (cfv B2 csqrt) clt)) $;

--| Absolute value and 'less than' relation. (Contributed by NM, 6-Apr-2005.)
theorem abslti (A2 B2: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wb (wbr (cfv A2 cabs) B2 clt) (wa (wbr (cneg B2) A2 clt) (wbr A2 B2 clt)) $;

--| Absolute value and 'less than or equal to' relation. (Contributed by NM, 6-Apr-2005.)
theorem abslei (A2 B2: class):
  $ wcel A2 cr $ >
  $ wcel B2 cr $ >
  $ wb (wbr (cfv A2 cabs) B2 cle) (wa (wbr (cneg B2) A2 cle) (wbr A2 B2 cle)) $;

--| A square root of a complex number is zero iff its argument is 0. Version of ~ sqrt00 for complex numbers. (Contributed by AV, 26-Jan-2023.)
theorem cnsqrt00 (A2: class):
  $ wi (wcel A2 cc) (wb (wceq (cfv A2 csqrt) cc0) (wceq A2 cc0)) $;

--| Square of value of absolute value function. (Contributed by NM, 2-Oct-1999.)
theorem absvalsqi (A2: class):
  $ wcel A2 cc $ >
  $ wceq (co (cfv A2 cabs) c2 cexp) (co A2 (cfv A2 ccj) cmul) $;

--| Square of value of absolute value function. (Contributed by NM, 2-Oct-1999.)
theorem absvalsq2i (A2: class):
  $ wcel A2 cc $ >
  $ wceq (co (cfv A2 cabs) c2 cexp) (co (co (cfv A2 cre) c2 cexp) (co (cfv A2 cim) c2 cexp) caddc) $;

--| Real closure of absolute value. (Contributed by NM, 2-Aug-1999.)
theorem abscli (A2: class):
  $ wcel A2 cc $ >
  $ wcel (cfv A2 cabs) cr $;

--| Absolute value is nonnegative. (Contributed by NM, 2-Aug-1999.)
theorem absge0i (A2: class):
  $ wcel A2 cc $ >
  $ wbr cc0 (cfv A2 cabs) cle $;

--| Value of absolute value function. Definition 10.36 of [Gleason] p. 133. (Contributed by NM, 2-Oct-1999.)
theorem absval2i (A2: class):
  $ wcel A2 cc $ >
  $ wceq (cfv A2 cabs) (cfv (co (co (cfv A2 cre) c2 cexp) (co (cfv A2 cim) c2 cexp) caddc) csqrt) $;

--| The absolute value of a number is zero iff the number is zero. Proposition 10-3.7(c) of [Gleason] p. 133. (Contributed by NM, 28-Jul-1999.)
theorem abs00i (A2: class):
  $ wcel A2 cc $ >
  $ wb (wceq (cfv A2 cabs) cc0) (wceq A2 cc0) $;

--| The absolute value of a nonzero number is positive. Remark in [Apostol] p. 363. (Contributed by NM, 1-Oct-1999.)
theorem absgt0i (A2: class):
  $ wcel A2 cc $ >
  $ wb (wne A2 cc0) (wbr cc0 (cfv A2 cabs) clt) $;

--| Absolute value of negative. (Contributed by NM, 2-Aug-1999.)
theorem absnegi (A2: class):
  $ wcel A2 cc $ >
  $ wceq (cfv (cneg A2) cabs) (cfv A2 cabs) $;

--| The absolute value of a number and its conjugate are the same. Proposition 10-3.7(b) of [Gleason] p. 133. (Contributed by NM, 2-Oct-1999.)
theorem abscji (A2: class):
  $ wcel A2 cc $ >
  $ wceq (cfv (cfv A2 ccj) cabs) (cfv A2 cabs) $;

--| The real part of a number is less than or equal to its absolute value. Proposition 10-3.7(d) of [Gleason] p. 133. (Contributed by NM, 2-Oct-1999.)
theorem releabsi (A2: class):
  $ wcel A2 cc $ >
  $ wbr (cfv A2 cre) (cfv A2 cabs) cle $;

--| Swapping order of subtraction doesn't change the absolute value. Example of [Apostol] p. 363. (Contributed by NM, 1-Oct-1999.)
theorem abssubi (A2 B2: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wceq (cfv (co A2 B2 cmin) cabs) (cfv (co B2 A2 cmin) cabs) $;

--| Absolute value distributes over multiplication. Proposition 10-3.7(f) of [Gleason] p. 133. (Contributed by NM, 1-Oct-1999.)
theorem absmuli (A2 B2: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wceq (cfv (co A2 B2 cmul) cabs) (co (cfv A2 cabs) (cfv B2 cabs) cmul) $;

--| Square of absolute value of sum. Proposition 10-3.7(g) of [Gleason] p. 133. (Contributed by NM, 2-Oct-1999.)
theorem sqabsaddi (A2 B2: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wceq (co (cfv (co A2 B2 caddc) cabs) c2 cexp) (co (co (co (cfv A2 cabs) c2 cexp) (co (cfv B2 cabs) c2 cexp) caddc) (co c2 (cfv (co A2 (cfv B2 ccj) cmul) cre) cmul) caddc) $;

--| Square of absolute value of difference. (Contributed by Steve Rodriguez, 20-Jan-2007.)
theorem sqabssubi (A2 B2: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wceq (co (cfv (co A2 B2 cmin) cabs) c2 cexp) (co (co (co (cfv A2 cabs) c2 cexp) (co (cfv B2 cabs) c2 cexp) caddc) (co c2 (cfv (co A2 (cfv B2 ccj) cmul) cre) cmul) cmin) $;

--| Absolute value distributes over division. (Contributed by NM, 26-Mar-2005.)
theorem absdivzi (A2 B2: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wi (wne B2 cc0) (wceq (cfv (co A2 B2 cdiv) cabs) (co (cfv A2 cabs) (cfv B2 cabs) cdiv)) $;

--| Triangle inequality for absolute value. Proposition 10-3.7(h) of [Gleason] p. 133. This is Metamath 100 proof #91. (Contributed by NM, 2-Oct-1999.)
theorem abstrii (A2 B2: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wbr (cfv (co A2 B2 caddc) cabs) (co (cfv A2 cabs) (cfv B2 cabs) caddc) cle $;

--| Absolute value of differences around common element. (Contributed by NM, 2-Oct-1999.)
theorem abs3difi (A2 B2 C: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wcel C cc $ >
  $ wbr (cfv (co A2 B2 cmin) cabs) (co (cfv (co A2 C cmin) cabs) (cfv (co C B2 cmin) cabs) caddc) cle $;

--| Lemma involving absolute value of differences. (Contributed by NM, 2-Oct-1999.)
theorem abs3lemi (A2 B2 C D: class):
  $ wcel A2 cc $ >
  $ wcel B2 cc $ >
  $ wcel C cc $ >
  $ wcel D cr $ >
  $ wi (wa (wbr (cfv (co A2 C cmin) cabs) (co D c2 cdiv) clt) (wbr (cfv (co C B2 cmin) cabs) (co D c2 cdiv) clt)) (wbr (cfv (co A2 B2 cmin) cabs) D clt) $;

--| The square root of a positive real is positive. (Contributed by Mario Carneiro, 29-May-2016.)
theorem rpsqrtcld (ph: wff) (A2: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel (cfv A2 csqrt) crp) $;

--| The square root of a positive real is positive. (Contributed by Mario Carneiro, 29-May-2016.)
theorem sqrtgt0d (ph: wff) (A2: class):
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wbr cc0 (cfv A2 csqrt) clt) $;

--| A negative number is the negative of its own absolute value. (Contributed by Mario Carneiro, 29-May-2016.)
theorem absnidd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wbr A2 cc0 cle) $ >
  $ wi ph (wceq (cfv A2 cabs) (cneg A2)) $;

--| A real number is less than or equal to its absolute value. (Contributed by Mario Carneiro, 29-May-2016.)
theorem leabsd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wbr A2 (cfv A2 cabs) cle) $;

--| The absolute value of a real number is either that number or its negative. (Contributed by Mario Carneiro, 29-May-2016.)
theorem absord (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wo (wceq (cfv A2 cabs) A2) (wceq (cfv A2 cabs) (cneg A2))) $;

--| Absolute value of a real number. (Contributed by Mario Carneiro, 29-May-2016.)
theorem absred (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wceq (cfv A2 cabs) (cfv (co A2 c2 cexp) csqrt)) $;

--| The square root of a nonnegative real is a real. (Contributed by Mario Carneiro, 29-May-2016.)
theorem resqrtcld (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wbr cc0 A2 cle) $ >
  $ wi ph (wcel (cfv A2 csqrt) cr) $;

--| Square root of square. (Contributed by Mario Carneiro, 29-May-2016.)
theorem sqrtmsqd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wbr cc0 A2 cle) $ >
  $ wi ph (wceq (cfv (co A2 A2 cmul) csqrt) A2) $;

--| Square root of square. (Contributed by Mario Carneiro, 29-May-2016.)
theorem sqrtsqd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wbr cc0 A2 cle) $ >
  $ wi ph (wceq (cfv (co A2 c2 cexp) csqrt) A2) $;

--| The square root of a nonnegative real is nonnegative. (Contributed by Mario Carneiro, 29-May-2016.)
theorem sqrtge0d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wbr cc0 A2 cle) $ >
  $ wi ph (wbr cc0 (cfv A2 csqrt) cle) $;

--| The square root of a negative number. (Contributed by Mario Carneiro, 29-May-2016.)
theorem sqrtnegd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wbr cc0 A2 cle) $ >
  $ wi ph (wceq (cfv (cneg A2) csqrt) (co ci (cfv A2 csqrt) cmul)) $;

--| A nonnegative number is its own absolute value. (Contributed by Mario Carneiro, 29-May-2016.)
theorem absidd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wbr cc0 A2 cle) $ >
  $ wi ph (wceq (cfv A2 cabs) A2) $;

--| Square root distributes over division. (Contributed by Mario Carneiro, 29-May-2016.)
theorem sqrtdivd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wbr cc0 A2 cle) $ >
  $ wi ph (wcel B2 crp) $ >
  $ wi ph (wceq (cfv (co A2 B2 cdiv) csqrt) (co (cfv A2 csqrt) (cfv B2 csqrt) cdiv)) $;

--| Square root distributes over multiplication. (Contributed by Mario Carneiro, 29-May-2016.)
theorem sqrtmuld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wbr cc0 A2 cle) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr cc0 B2 cle) $ >
  $ wi ph (wceq (cfv (co A2 B2 cmul) csqrt) (co (cfv A2 csqrt) (cfv B2 csqrt) cmul)) $;

--| Relationship between square root and squares. (Contributed by Mario Carneiro, 29-May-2016.)
theorem sqrtsq2d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wbr cc0 A2 cle) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr cc0 B2 cle) $ >
  $ wi ph (wb (wceq (cfv A2 csqrt) B2) (wceq A2 (co B2 c2 cexp))) $;

--| Square root is monotonic. (Contributed by Mario Carneiro, 29-May-2016.)
theorem sqrtled (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wbr cc0 A2 cle) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr cc0 B2 cle) $ >
  $ wi ph (wb (wbr A2 B2 cle) (wbr (cfv A2 csqrt) (cfv B2 csqrt) cle)) $;

--| Square root is strictly monotonic. (Contributed by Mario Carneiro, 29-May-2016.)
theorem sqrtltd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wbr cc0 A2 cle) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr cc0 B2 cle) $ >
  $ wi ph (wb (wbr A2 B2 clt) (wbr (cfv A2 csqrt) (cfv B2 csqrt) clt)) $;

--| The square root function is one-to-one. (Contributed by Mario Carneiro, 29-May-2016.)
theorem sqr11d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wbr cc0 A2 cle) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr cc0 B2 cle) $ >
  $ wi ph (wceq (cfv A2 csqrt) (cfv B2 csqrt)) $ >
  $ wi ph (wceq A2 B2) $;

--| A nonnegative integer is its own absolute value. (Contributed by AV, 22-Nov-2025.)
theorem nn0absid (N: class):
  $ wi (wcel N cn0) (wceq (cfv N cabs) N) $;

--| A nonnegative integer is its own absolute value (inference form). (Contributed by AV, 22-Nov-2025.)
theorem nn0absidi (N: class):
  $ wcel N cn0 $ >
  $ wceq (cfv N cabs) N $;

--| Absolute value and 'less than' relation. (Contributed by Mario Carneiro, 29-May-2016.)
theorem absltd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wb (wbr (cfv A2 cabs) B2 clt) (wa (wbr (cneg B2) A2 clt) (wbr A2 B2 clt))) $;

--| Absolute value and 'less than or equal to' relation. (Contributed by Mario Carneiro, 29-May-2016.)
theorem absled (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wb (wbr (cfv A2 cabs) B2 cle) (wa (wbr (cneg B2) A2 cle) (wbr A2 B2 cle))) $;

--| Absolute value of a nonnegative difference. (Contributed by Mario Carneiro, 29-May-2016.)
theorem abssubge0d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wi ph (wceq (cfv (co B2 A2 cmin) cabs) (co B2 A2 cmin)) $;

--| Absolute value of a nonpositive difference. (Contributed by Mario Carneiro, 29-May-2016.)
theorem abssuble0d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wbr A2 B2 cle) $ >
  $ wi ph (wceq (cfv (co A2 B2 cmin) cabs) (co B2 A2 cmin)) $;

--| The absolute value of a difference and 'less than' relation. (Contributed by Mario Carneiro, 29-May-2016.)
theorem absdifltd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wb (wbr (cfv (co A2 B2 cmin) cabs) C clt) (wa (wbr (co B2 C cmin) A2 clt) (wbr A2 (co B2 C caddc) clt))) $;

--| The absolute value of a difference and 'less than or equal to' relation. (Contributed by Mario Carneiro, 29-May-2016.)
theorem absdifled (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wb (wbr (cfv (co A2 B2 cmin) cabs) C cle) (wa (wbr (co B2 C cmin) A2 cle) (wbr A2 (co B2 C caddc) cle))) $;

--| Two elements in a half-open interval have separation _strictly_ less than the difference between the endpoints. (Contributed by Stefan O'Rear, 12-Sep-2014.)
theorem icodiamlt (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cr) (wcel B2 cr)) (wa (wcel C (co A2 B2 cico)) (wcel D (co A2 B2 cico)))) (wbr (cfv (co C D cmin) cabs) (co B2 A2 cmin) clt) $;

--| Real closure of absolute value. (Contributed by Mario Carneiro, 29-May-2016.)
theorem abscld (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel (cfv A2 cabs) cr) $;

--| Closure of the square root function over the complex numbers. (Contributed by Mario Carneiro, 29-May-2016.)
theorem sqrtcld (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel (cfv A2 csqrt) cc) $;

--| The real part of the square root function is nonnegative. (Contributed by Mario Carneiro, 29-May-2016.)
theorem sqrtrege0d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wbr cc0 (cfv (cfv A2 csqrt) cre) cle) $;

--| Square root theorem. Theorem I.35 of [Apostol] p. 29. (Contributed by Mario Carneiro, 29-May-2016.)
theorem sqsqrtd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (co (cfv A2 csqrt) c2 cexp) A2) $;

--| Square root theorem. Theorem I.35 of [Apostol] p. 29. (Contributed by Mario Carneiro, 29-May-2016.)
theorem msqsqrtd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (co (cfv A2 csqrt) (cfv A2 csqrt) cmul) A2) $;

--| A square root is zero iff its argument is 0. (Contributed by Mario Carneiro, 29-May-2016.)
theorem sqr00d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (cfv A2 csqrt) cc0) $ >
  $ wi ph (wceq A2 cc0) $;

--| Square of value of absolute value function. (Contributed by Mario Carneiro, 29-May-2016.)
theorem absvalsqd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (co (cfv A2 cabs) c2 cexp) (co A2 (cfv A2 ccj) cmul)) $;

--| Square of value of absolute value function. (Contributed by Mario Carneiro, 29-May-2016.)
theorem absvalsq2d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (co (cfv A2 cabs) c2 cexp) (co (co (cfv A2 cre) c2 cexp) (co (cfv A2 cim) c2 cexp) caddc)) $;

--| Absolute value is nonnegative. (Contributed by Mario Carneiro, 29-May-2016.)
theorem absge0d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wbr cc0 (cfv A2 cabs) cle) $;

--| Value of absolute value function. Definition 10.36 of [Gleason] p. 133. (Contributed by Mario Carneiro, 29-May-2016.)
theorem absval2d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (cfv A2 cabs) (cfv (co (co (cfv A2 cre) c2 cexp) (co (cfv A2 cim) c2 cexp) caddc) csqrt)) $;

--| The absolute value of a number is zero iff the number is zero. Proposition 10-3.7(c) of [Gleason] p. 133. (Contributed by Mario Carneiro, 29-May-2016.)
theorem abs00d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (cfv A2 cabs) cc0) $ >
  $ wi ph (wceq A2 cc0) $;

--| The absolute value of a number is zero iff the number is zero. Proposition 10-3.7(c) of [Gleason] p. 133. (Contributed by Mario Carneiro, 29-May-2016.)
theorem absne0d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wne (cfv A2 cabs) cc0) $;

--| The absolute value of a nonzero number is a positive real. (Contributed by Mario Carneiro, 29-May-2016.)
theorem absrpcld (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wne A2 cc0) $ >
  $ wi ph (wcel (cfv A2 cabs) crp) $;

--| Absolute value of negative. (Contributed by Mario Carneiro, 29-May-2016.)
theorem absnegd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (cfv (cneg A2) cabs) (cfv A2 cabs)) $;

--| The absolute value of a number and its conjugate are the same. Proposition 10-3.7(b) of [Gleason] p. 133. (Contributed by Mario Carneiro, 29-May-2016.)
theorem abscjd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wceq (cfv (cfv A2 ccj) cabs) (cfv A2 cabs)) $;

--| The real part of a number is less than or equal to its absolute value. Proposition 10-3.7(d) of [Gleason] p. 133. (Contributed by Mario Carneiro, 29-May-2016.)
theorem releabsd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wbr (cfv A2 cre) (cfv A2 cabs) cle) $;

--| Absolute value of positive integer exponentiation. (Contributed by Mario Carneiro, 29-May-2016.)
theorem absexpd (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (cfv (co A2 N cexp) cabs) (co (cfv A2 cabs) N cexp)) $;

--| Swapping order of subtraction doesn't change the absolute value. Example of [Apostol] p. 363. (Contributed by Mario Carneiro, 29-May-2016.)
theorem abssubd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wceq (cfv (co A2 B2 cmin) cabs) (cfv (co B2 A2 cmin) cabs)) $;

--| Absolute value distributes over multiplication. Proposition 10-3.7(f) of [Gleason] p. 133. (Contributed by Mario Carneiro, 29-May-2016.)
theorem absmuld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wceq (cfv (co A2 B2 cmul) cabs) (co (cfv A2 cabs) (cfv B2 cabs) cmul)) $;

--| Absolute value distributes over division. (Contributed by Mario Carneiro, 29-May-2016.)
theorem absdivd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wne B2 cc0) $ >
  $ wi ph (wceq (cfv (co A2 B2 cdiv) cabs) (co (cfv A2 cabs) (cfv B2 cabs) cdiv)) $;

--| Triangle inequality for absolute value. Proposition 10-3.7(h) of [Gleason] p. 133. (Contributed by Mario Carneiro, 29-May-2016.)
theorem abstrid (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wbr (cfv (co A2 B2 caddc) cabs) (co (cfv A2 cabs) (cfv B2 cabs) caddc) cle) $;

--| Difference of absolute values. (Contributed by Mario Carneiro, 29-May-2016.)
theorem abs2difd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wbr (co (cfv A2 cabs) (cfv B2 cabs) cmin) (cfv (co A2 B2 cmin) cabs) cle) $;

--| Difference of absolute values. (Contributed by Mario Carneiro, 29-May-2016.)
theorem abs2dif2d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wbr (cfv (co A2 B2 cmin) cabs) (co (cfv A2 cabs) (cfv B2 cabs) caddc) cle) $;

--| Absolute value of difference of absolute values. (Contributed by Mario Carneiro, 29-May-2016.)
theorem abs2difabsd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wbr (cfv (co (cfv A2 cabs) (cfv B2 cabs) cmin) cabs) (cfv (co A2 B2 cmin) cabs) cle) $;

--| Absolute value of differences around common element. (Contributed by Mario Carneiro, 29-May-2016.)
theorem abs3difd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wbr (cfv (co A2 B2 cmin) cabs) (co (cfv (co A2 C cmin) cabs) (cfv (co C B2 cmin) cabs) caddc) cle) $;

--| Lemma involving absolute value of differences. (Contributed by Mario Carneiro, 29-May-2016.)
theorem abs3lemd (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wcel D cr) $ >
  $ wi ph (wbr (cfv (co A2 C cmin) cabs) (co D c2 cdiv) clt) $ >
  $ wi ph (wbr (cfv (co C B2 cmin) cabs) (co D c2 cdiv) clt) $ >
  $ wi ph (wbr (cfv (co A2 B2 cmin) cabs) D clt) $;

--| A complex number is the square of exactly one complex number iff the given complex number is zero. (Contributed by AV, 21-Jun-2023.)
theorem reusq0 {x3: setvar} (X: class):
  $ wi (wcel X cc) (wb (wreu x3 (wceq (co (cv x3) c2 cexp) X) cc) (wceq X cc0)) $;

--| The Brahmagupta-Fibonacci identity for complex numbers. Express the product of two sums of two squares as a sum of two squares. First result. (Contributed by Thierry Arnoux, 1-Feb-2020.) Generalization for complex numbers proposed by GL. (Revised by AV, 8-Jun-2023.)
theorem bhmafibid1cn (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cc) (wcel B2 cc)) (wa (wcel C cc) (wcel D cc))) (wceq (co (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co (co C c2 cexp) (co D c2 cexp) caddc) cmul) (co (co (co (co A2 C cmul) (co B2 D cmul) cmin) c2 cexp) (co (co (co A2 D cmul) (co B2 C cmul) caddc) c2 cexp) caddc)) $;

--| The Brahmagupta-Fibonacci identity for complex numbers. Express the product of two sums of two squares as a sum of two squares. Second result. (Contributed by Thierry Arnoux, 1-Feb-2020.) Generalization for complex numbers proposed by GL. (Revised by AV, 8-Jun-2023.)
theorem bhmafibid2cn (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cc) (wcel B2 cc)) (wa (wcel C cc) (wcel D cc))) (wceq (co (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co (co C c2 cexp) (co D c2 cexp) caddc) cmul) (co (co (co (co A2 C cmul) (co B2 D cmul) caddc) c2 cexp) (co (co (co A2 D cmul) (co B2 C cmul) cmin) c2 cexp) caddc)) $;

--| The Brahmagupta-Fibonacci identity. Express the product of two sums of two squares as a sum of two squares. First result. Remark: The proof uses a different approach than the proof of ~ bhmafibid1cn , and is a little bit shorter. (Contributed by Thierry Arnoux, 1-Feb-2020.) (Proof modification is discouraged.)
theorem bhmafibid1 (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cr) (wcel B2 cr)) (wa (wcel C cr) (wcel D cr))) (wceq (co (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co (co C c2 cexp) (co D c2 cexp) caddc) cmul) (co (co (co (co A2 C cmul) (co B2 D cmul) cmin) c2 cexp) (co (co (co A2 D cmul) (co B2 C cmul) caddc) c2 cexp) caddc)) $;

--| The Brahmagupta-Fibonacci identity. Express the product of two sums of two squares as a sum of two squares. Second result. (Contributed by Thierry Arnoux, 1-Feb-2020.)
theorem bhmafibid2 (A2 B2 C D: class):
  $ wi (wa (wa (wcel A2 cr) (wcel B2 cr)) (wa (wcel C cr) (wcel D cr))) (wceq (co (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co (co C c2 cexp) (co D c2 cexp) caddc) cmul) (co (co (co (co A2 C cmul) (co B2 D cmul) caddc) c2 cexp) (co (co (co A2 D cmul) (co B2 C cmul) cmin) c2 cexp) caddc)) $;

--| Extend class notation to include the limsup function.
term clsp: class;

--| Define the superior limit of an infinite sequence of extended real numbers. Definition 12-4.1 of [Gleason] p. 175. See ~ limsupval for its value. (Contributed by NM, 26-Oct-2005.) (Revised by AV, 11-Sep-2020.)
axiom df_limsup {x3 k: setvar}:
  $ wceq clsp (cmpt x3 cvv (cinf (crn (cmpt k cr (csup (cin (cima (cv x3) (co (cv k) cpnf cico)) cxr) cxr clt))) cxr clt)) $;

--| Ordering property of the superior limit function. (Contributed by Mario Carneiro, 7-Sep-2014.) (Revised by Mario Carneiro, 7-May-2016.)
theorem limsupgord (A2 B2 F: class):
  $ wi (w3a (wcel A2 cr) (wcel B2 cr) (wbr A2 B2 cle)) (wbr (csup (cin (cima F (co B2 cpnf cico)) cxr) cxr clt) (csup (cin (cima F (co A2 cpnf cico)) cxr) cxr clt) cle) $;

--| Closure of the superior limit. (Contributed by NM, 26-Oct-2005.) (Revised by AV, 12-Sep-2020.)
theorem limsupcl (F V: class):
  $ wi (wcel F V) (wcel (cfv F clsp) cxr) $;

--| The superior limit of an infinite sequence ` F ` of extended real numbers, which is the infimum of the set of suprema of all upper infinite subsequences of ` F ` . Definition 12-4.1 of [Gleason] p. 175. (Contributed by NM, 26-Oct-2005.) (Revised by AV, 12-Sep-2014.)
theorem limsupval {k: setvar} (F: class) (G V: class k):
  $ wceq G (cmpt k cr (csup (cin (cima F (co (cv k) cpnf cico)) cxr) cxr clt)) $ >
  $ wi (wcel F V) (wceq (cfv F clsp) (cinf (crn G) cxr clt)) $;

--| Closure of the superior limit function. (Contributed by Mario Carneiro, 7-Sep-2014.) (Revised by Mario Carneiro, 7-May-2016.)
theorem limsupgf {k: setvar} (F: class) (G: class k):
  $ wceq G (cmpt k cr (csup (cin (cima F (co (cv k) cpnf cico)) cxr) cxr clt)) $ >
  $ wf cr cxr G $;

--| Value of the superior limit function. (Contributed by Mario Carneiro, 7-Sep-2014.) (Revised by Mario Carneiro, 7-May-2016.)
theorem limsupgval {k: setvar} (F: class) (G: class k) (M: class):
  $ wceq G (cmpt k cr (csup (cin (cima F (co (cv k) cpnf cico)) cxr) cxr clt)) $ >
  $ wi (wcel M cr) (wceq (cfv M G) (csup (cin (cima F (co M cpnf cico)) cxr) cxr clt)) $;

--| The defining property of the superior limit function. (Contributed by Mario Carneiro, 5-Sep-2014.) (Revised by Mario Carneiro, 7-May-2016.)
theorem limsupgle {j k: setvar} (A2 B2: class k) (C F: class) (G: class j k):
  $ wceq G (cmpt k cr (csup (cin (cima F (co (cv k) cpnf cico)) cxr) cxr clt)) $ >
  $ wi (w3a (wa (wss B2 cr) (wf B2 cxr F)) (wcel C cr) (wcel A2 cxr)) (wb (wbr (cfv C G) A2 cle) (wral j (wi (wbr C (cv j) cle) (wbr (cfv (cv j) F) A2 cle)) B2)) $;

--| The defining property of the superior limit. (Contributed by Mario Carneiro, 7-Sep-2014.) (Revised by AV, 12-Sep-2020.)
theorem limsuple {j k: setvar} (A2 B2: class k) (F: class) (G: class k):
  $ wceq G (cmpt k cr (csup (cin (cima F (co (cv k) cpnf cico)) cxr) cxr clt)) $ >
  $ wi (w3a (wss B2 cr) (wf B2 cxr F) (wcel A2 cxr)) (wb (wbr A2 (cfv F clsp) cle) (wral j (wbr A2 (cfv (cv j) G) cle) cr)) $;

--| The defining property of the superior limit. (Contributed by Mario Carneiro, 7-Sep-2014.) (Revised by AV, 12-Sep-2020.)
theorem limsuplt {j k: setvar} (A2 B2: class k) (F: class) (G: class k):
  $ wceq G (cmpt k cr (csup (cin (cima F (co (cv k) cpnf cico)) cxr) cxr clt)) $ >
  $ wi (w3a (wss B2 cr) (wf B2 cxr F) (wcel A2 cxr)) (wb (wbr (cfv F clsp) A2 clt) (wrex j (wbr (cfv (cv j) G) A2 clt) cr)) $;

--| The superior limit, relativized to an unbounded set. (Contributed by Mario Carneiro, 7-Sep-2014.) (Revised by AV, 12-Sep-2020.)
theorem limsupval2 {k: setvar} (ph: wff k) (A2 F: class) (G V: class k):
  $ wceq G (cmpt k cr (csup (cin (cima F (co (cv k) cpnf cico)) cxr) cxr clt)) $ >
  $ wi ph (wcel F V) $ >
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wceq (csup A2 cxr clt) cpnf) $ >
  $ wi ph (wceq (cfv F clsp) (cinf (cima G A2) cxr clt)) $;

--| If a sequence of real numbers has upper bounded limit supremum, then all the partial suprema are real. (Contributed by Mario Carneiro, 7-Sep-2014.) (Revised by AV, 12-Sep-2020.)
theorem limsupgre {k: setvar} (F: class) (G: class k) (M Z: class):
  $ wceq G (cmpt k cr (csup (cin (cima F (co (cv k) cpnf cico)) cxr) cxr clt)) $ >
  $ wceq Z (cfv M cuz) $ >
  $ wi (w3a (wcel M cz) (wf Z cr F) (wbr (cfv F clsp) cpnf clt)) (wf cr cr G) $;

--| If a sequence is eventually at most ` A ` , then the limsup is also at most ` A ` . (The converse is only true if the less or equal is replaced by strictly less than; consider the sequence ` 1 / n ` which is never less or equal to zero even though the limsup is.) (Contributed by Mario Carneiro, 7-Sep-2014.) (Revised by AV, 12-Sep-2020.)
theorem limsupbnd1 {j k: setvar} (ph: wff) (A2 B2 F: class):
  $ wi ph (wss B2 cr) $ >
  $ wi ph (wf B2 cxr F) $ >
  $ wi ph (wcel A2 cxr) $ >
  $ wi ph (wrex k (wral j (wi (wbr (cv k) (cv j) cle) (wbr (cfv (cv j) F) A2 cle)) B2) cr) $ >
  $ wi ph (wbr (cfv F clsp) A2 cle) $;

--| If a sequence is eventually greater than ` A ` , then the limsup is also greater than ` A ` . (Contributed by Mario Carneiro, 7-Sep-2014.) (Revised by AV, 12-Sep-2020.)
theorem limsupbnd2 {j k: setvar} (ph: wff) (A2 B2 F: class):
  $ wi ph (wss B2 cr) $ >
  $ wi ph (wf B2 cxr F) $ >
  $ wi ph (wcel A2 cxr) $ >
  $ wi ph (wceq (csup B2 cxr clt) cpnf) $ >
  $ wi ph (wrex k (wral j (wi (wbr (cv k) (cv j) cle) (wbr A2 (cfv (cv j) F) cle)) B2) cr) $ >
  $ wi ph (wbr A2 (cfv F clsp) cle) $;

--| Extend class notation with convergence relation for limits.
term cli: class;

--| Extend class notation with real convergence relation for limits.
term crli: class;

--| Extend class notation with the set of all eventually bounded functions.
term co1: class;

--| Extend class notation with the set of all eventually upper bounded functions.
term clo1: class;

--| Define the limit relation for complex number sequences. See ~ clim for its relational expression. (Contributed by NM, 28-Aug-2005.)
axiom df_clim {x3 y1 f2 j k: setvar}:
  $ wceq cli (copab f2 y1 (wa (wcel (cv y1) cc) (wral x3 (wrex j (wral k (wa (wcel (cfv (cv k) (cv f2)) cc) (wbr (cfv (co (cfv (cv k) (cv f2)) (cv y1) cmin) cabs) (cv x3) clt)) (cfv (cv j) cuz)) cz) crp))) $;

--| Define the limit relation for partial functions on the reals. See ~ rlim for its relational expression. (Contributed by Mario Carneiro, 16-Sep-2014.)
axiom df_rlim {x3 y1 z w f2: setvar}:
  $ wceq crli (copab f2 x3 (wa (wa (wcel (cv f2) (co cc cr cpm)) (wcel (cv x3) cc)) (wral y1 (wrex z (wral w (wi (wbr (cv z) (cv w) cle) (wbr (cfv (co (cfv (cv w) (cv f2)) (cv x3) cmin) cabs) (cv y1) clt)) (cdm (cv f2))) cr) crp))) $;

--| Define the set of eventually bounded functions. We don't bother to build the full conception of big-O notation, because we can represent any big-O in terms of ` O(1) ` and division, and any little-O in terms of a limit and division. We could also use limsup for this, but it only works on integer sequences, while this will work for real sequences or integer sequences. (Contributed by Mario Carneiro, 15-Sep-2014.)
axiom df_o1 {x3 y1 f2 m: setvar}:
  $ wceq co1 (crab f2 (wrex x3 (wrex m (wral y1 (wbr (cfv (cfv (cv y1) (cv f2)) cabs) (cv m) cle) (cin (cdm (cv f2)) (co (cv x3) cpnf cico))) cr) cr) (co cc cr cpm)) $;

--| Define the set of eventually upper bounded real functions. This fills a gap in ` O(1) ` coverage, to express statements like ` f ( x ) <_ g ( x ) + O ( x ) ` via ` ( x e. RR+ |-> ( f ( x ) - g ( x ) ) / x ) e. <_O(1) ` . (Contributed by Mario Carneiro, 25-May-2016.)
axiom df_lo1 {x3 y1 f2 m: setvar}:
  $ wceq clo1 (crab f2 (wrex x3 (wrex m (wral y1 (wbr (cfv (cv y1) (cv f2)) (cv m) cle) (cin (cdm (cv f2)) (co (cv x3) cpnf cico))) cr) cr) (co cr cr cpm)) $;

--| The limit relation is a relation. (Contributed by NM, 28-Aug-2005.) (Revised by Mario Carneiro, 31-Jan-2014.)
theorem climrel:
  $ wrel cli $;

--| The limit relation is a relation. (Contributed by Mario Carneiro, 24-Sep-2014.)
theorem rlimrel:
  $ wrel crli $;

--| Express the predicate: The limit of complex number sequence ` F ` is ` A ` , or ` F ` converges to ` A ` . This means that for any real ` x ` , no matter how small, there always exists an integer ` j ` such that the absolute difference of any later complex number in the sequence and the limit is less than ` x ` . (Contributed by NM, 28-Aug-2005.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem clim {x3 j k: setvar} (ph: wff) (A2: class) (B2: class x3 j k) (F: class) (V: class x3 j k):
  $ wi ph (wcel F V) $ >
  $ wi (wa ph (wcel (cv k) cz)) (wceq (cfv (cv k) F) B2) $ >
  $ wi ph (wb (wbr F A2 cli) (wa (wcel A2 cc) (wral x3 (wrex j (wral k (wa (wcel B2 cc) (wbr (cfv (co B2 A2 cmin) cabs) (cv x3) clt)) (cfv (cv j) cuz)) cz) crp))) $;

--| Express the predicate: The limit of complex number function ` F ` is ` C ` , or ` F ` converges to ` C ` , in the real sense. This means that for any real ` x ` , no matter how small, there always exists a number ` y ` such that the absolute difference of any number in the function beyond ` y ` and the limit is less than ` x ` . (Contributed by Mario Carneiro, 16-Sep-2014.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem rlim {x3 y1 z: setvar} (ph: wff) (A2: class x3 y1) (B2: class x3 y1 z) (C F: class):
  $ wi ph (wf A2 cc F) $ >
  $ wi ph (wss A2 cr) $ >
  $ wi (wa ph (wcel (cv z) A2)) (wceq (cfv (cv z) F) B2) $ >
  $ wi ph (wb (wbr F C crli) (wa (wcel C cc) (wral x3 (wrex y1 (wral z (wi (wbr (cv y1) (cv z) cle) (wbr (cfv (co B2 C cmin) cabs) (cv x3) clt)) A2) cr) crp))) $;

--| Rewrite ~ rlim for a mapping operation. (Contributed by Mario Carneiro, 16-Sep-2014.) (Revised by Mario Carneiro, 28-Feb-2015.)
theorem rlim2 {x3 y1 z: setvar} (ph: wff z) (A2: class) (B2: class z) (C: class):
  $ wi ph (wral z (wcel B2 cc) A2) $ >
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wb (wbr (cmpt z A2 B2) C crli) (wral x3 (wrex y1 (wral z (wi (wbr (cv y1) (cv z) cle) (wbr (cfv (co B2 C cmin) cabs) (cv x3) clt)) A2) cr) crp)) $;

--| Use strictly less-than in place of less equal in the real limit predicate. (Contributed by Mario Carneiro, 18-Sep-2014.)
theorem rlim2lt {x3 y1 z: setvar} (ph: wff z) (A2: class) (B2: class z) (C: class):
  $ wi ph (wral z (wcel B2 cc) A2) $ >
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wb (wbr (cmpt z A2 B2) C crli) (wral x3 (wrex y1 (wral z (wi (wbr (cv y1) (cv z) clt) (wbr (cfv (co B2 C cmin) cabs) (cv x3) clt)) A2) cr) crp)) $;

--| Restrict the range of the domain bound to reals greater than some ` D e. RR ` . (Contributed by Mario Carneiro, 16-Sep-2014.)
theorem rlim3 {x3 y1 z: setvar} (ph: wff z) (A2: class) (B2: class z) (C: class) (D: class x3):
  $ wi ph (wral z (wcel B2 cc) A2) $ >
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wcel D cr) $ >
  $ wi ph (wb (wbr (cmpt z A2 B2) C crli) (wral x3 (wrex y1 (wral z (wi (wbr (cv y1) (cv z) cle) (wbr (cfv (co B2 C cmin) cabs) (cv x3) clt)) A2) (co D cpnf cico)) crp)) $;

--| Closure of the limit of a sequence of complex numbers. (Contributed by NM, 28-Aug-2005.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem climcl (A2 F: class):
  $ wi (wbr F A2 cli) (wcel A2 cc) $;

--| Closure of a function with a limit in the complex numbers. (Contributed by Mario Carneiro, 16-Sep-2014.)
theorem rlimpm (A2 F: class):
  $ wi (wbr F A2 crli) (wcel F (co cc cr cpm)) $;

--| Closure of a function with a limit in the complex numbers. (Contributed by Mario Carneiro, 16-Sep-2014.)
theorem rlimf (A2 F: class):
  $ wi (wbr F A2 crli) (wf (cdm F) cc F) $;

--| Domain closure of a function with a limit in the complex numbers. (Contributed by Mario Carneiro, 16-Sep-2014.)
theorem rlimss (A2 F: class):
  $ wi (wbr F A2 crli) (wss (cdm F) cr) $;

--| Closure of the limit of a sequence of complex numbers. (Contributed by Mario Carneiro, 16-Sep-2014.) (Revised by Mario Carneiro, 28-Apr-2015.)
theorem rlimcl (A2 F: class):
  $ wi (wbr F A2 crli) (wcel A2 cc) $;

--| Express the predicate: The limit of complex number sequence ` F ` is ` A ` , or ` F ` converges to ` A ` , with more general quantifier restrictions than ~ clim . (Contributed by NM, 6-Jan-2007.) (Revised by Mario Carneiro, 31-Jan-2014.)
theorem clim2 {x3 j k: setvar} (ph: wff) (A2: class) (B2: class x3 j k) (F: class) (M: class x3 k) (V: class x3 j k) (Z: class x3):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel F V) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) B2) $ >
  $ wi ph (wb (wbr F A2 cli) (wa (wcel A2 cc) (wral x3 (wrex j (wral k (wa (wcel B2 cc) (wbr (cfv (co B2 A2 cmin) cabs) (cv x3) clt)) (cfv (cv j) cuz)) Z) crp))) $;

--| Express the predicate ` F ` converges to ` A ` . (Contributed by NM, 24-Feb-2008.) (Revised by Mario Carneiro, 31-Jan-2014.)
theorem clim2c {x3 j k: setvar} (ph: wff) (A2: class) (B2: class x3 j k) (F: class) (M: class x3 k) (V: class x3 j k) (Z: class x3):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel F V) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) B2) $ >
  $ wi ph (wcel A2 cc) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel B2 cc) $ >
  $ wi ph (wb (wbr F A2 cli) (wral x3 (wrex j (wral k (wbr (cfv (co B2 A2 cmin) cabs) (cv x3) clt) (cfv (cv j) cuz)) Z) crp)) $;

--| Express the predicate ` F ` converges to ` 0 ` . (Contributed by NM, 24-Feb-2008.) (Revised by Mario Carneiro, 31-Jan-2014.)
theorem clim0 {x3 j k: setvar} (ph: wff) (B2: class x3 j k) (F: class) (M: class x3 k) (V: class x3 j k) (Z: class x3):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel F V) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) B2) $ >
  $ wi ph (wb (wbr F cc0 cli) (wral x3 (wrex j (wral k (wa (wcel B2 cc) (wbr (cfv B2 cabs) (cv x3) clt)) (cfv (cv j) cuz)) Z) crp)) $;

--| Express the predicate ` F ` converges to ` 0 ` . (Contributed by NM, 24-Feb-2008.) (Revised by Mario Carneiro, 31-Jan-2014.)
theorem clim0c {x3 j k: setvar} (ph: wff) (B2: class x3 j k) (F: class) (M: class x3 k) (V: class x3 j k) (Z: class x3):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel F V) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) B2) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel B2 cc) $ >
  $ wi ph (wb (wbr F cc0 cli) (wral x3 (wrex j (wral k (wbr (cfv B2 cabs) (cv x3) clt) (cfv (cv j) cuz)) Z) crp)) $;

--| Express the predicate ` B ( z ) ` converges to ` 0 ` . (Contributed by Mario Carneiro, 16-Sep-2014.) (Revised by Mario Carneiro, 28-Feb-2015.)
theorem rlim0 {x3 y1 z: setvar} (ph: wff z) (A2: class) (B2: class z):
  $ wi ph (wral z (wcel B2 cc) A2) $ >
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wb (wbr (cmpt z A2 B2) cc0 crli) (wral x3 (wrex y1 (wral z (wi (wbr (cv y1) (cv z) cle) (wbr (cfv B2 cabs) (cv x3) clt)) A2) cr) crp)) $;

--| Use strictly less-than in place of less equal in the real limit predicate. (Contributed by Mario Carneiro, 18-Sep-2014.) (Revised by Mario Carneiro, 28-Feb-2015.)
theorem rlim0lt {x3 y1 z: setvar} (ph: wff z) (A2: class) (B2: class z):
  $ wi ph (wral z (wcel B2 cc) A2) $ >
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wb (wbr (cmpt z A2 B2) cc0 crli) (wral x3 (wrex y1 (wral z (wi (wbr (cv y1) (cv z) clt) (wbr (cfv B2 cabs) (cv x3) clt)) A2) cr) crp)) $;

--| Convergence of a sequence of complex numbers. (Contributed by NM, 11-Jan-2007.) (Revised by Mario Carneiro, 31-Jan-2014.)
theorem climi {j k: setvar} (ph: wff) (A2: class) (B2: class j k) (C F: class) (M: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel C crp) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) B2) $ >
  $ wi ph (wbr F A2 cli) $ >
  $ wi ph (wrex j (wral k (wa (wcel B2 cc) (wbr (cfv (co B2 A2 cmin) cabs) C clt)) (cfv (cv j) cuz)) Z) $;

--| Convergence of a sequence of complex numbers. (Contributed by NM, 11-Jan-2007.) (Revised by Mario Carneiro, 31-Jan-2014.)
theorem climi2 {j k: setvar} (ph: wff) (A2: class) (B2: class j k) (C F: class) (M: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel C crp) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) B2) $ >
  $ wi ph (wbr F A2 cli) $ >
  $ wi ph (wrex j (wral k (wbr (cfv (co B2 A2 cmin) cabs) C clt) (cfv (cv j) cuz)) Z) $;

--| Convergence of a sequence of complex numbers to zero. (Contributed by NM, 11-Jan-2007.) (Revised by Mario Carneiro, 31-Jan-2014.)
theorem climi0 {j k: setvar} (ph: wff) (B2: class j k) (C F: class) (M: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel C crp) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) B2) $ >
  $ wi ph (wbr F cc0 cli) $ >
  $ wi ph (wrex j (wral k (wbr (cfv B2 cabs) C clt) (cfv (cv j) cuz)) Z) $;

--| Convergence at infinity of a function on the reals. (Contributed by Mario Carneiro, 28-Feb-2015.)
theorem rlimi {y1 z: setvar} (ph: wff z) (A2: class) (B2: class z) (C R: class) (V: class y1):
  $ wi ph (wral z (wcel B2 V) A2) $ >
  $ wi ph (wcel R crp) $ >
  $ wi ph (wbr (cmpt z A2 B2) C crli) $ >
  $ wi ph (wrex y1 (wral z (wi (wbr (cv y1) (cv z) cle) (wbr (cfv (co B2 C cmin) cabs) R clt)) A2) cr) $;

--| Convergence at infinity of a function on the reals. (Contributed by Mario Carneiro, 12-May-2016.)
theorem rlimi2 {y1 z: setvar} (ph: wff z) (A2: class) (B2: class z) (C D R: class) (V: class y1):
  $ wi ph (wral z (wcel B2 V) A2) $ >
  $ wi ph (wcel R crp) $ >
  $ wi ph (wbr (cmpt z A2 B2) C crli) $ >
  $ wi ph (wcel D cr) $ >
  $ wi ph (wrex y1 (wral z (wi (wbr (cv y1) (cv z) cle) (wbr (cfv (co B2 C cmin) cabs) R clt)) A2) (co D cpnf cico)) $;

--| Elementhood in the set of eventually upper bounded functions. (Contributed by Mario Carneiro, 26-May-2016.)
theorem ello1 {x3 y1 m: setvar} (F: class):
  $ wb (wcel F clo1) (wa (wcel F (co cr cr cpm)) (wrex x3 (wrex m (wral y1 (wbr (cfv (cv y1) F) (cv m) cle) (cin (cdm F) (co (cv x3) cpnf cico))) cr) cr)) $;

--| Elementhood in the set of eventually upper bounded functions. (Contributed by Mario Carneiro, 26-May-2016.)
theorem ello12 {x3 y1 m: setvar} (A2 F: class):
  $ wi (wa (wf A2 cr F) (wss A2 cr)) (wb (wcel F clo1) (wrex x3 (wrex m (wral y1 (wi (wbr (cv x3) (cv y1) cle) (wbr (cfv (cv y1) F) (cv m) cle)) A2) cr) cr)) $;

--| Sufficient condition for elementhood in the set of eventually upper bounded functions. (Contributed by Mario Carneiro, 26-May-2016.)
theorem ello12r {x3: setvar} (A2 C F M: class):
  $ wi (w3a (wa (wf A2 cr F) (wss A2 cr)) (wa (wcel C cr) (wcel M cr)) (wral x3 (wi (wbr C (cv x3) cle) (wbr (cfv (cv x3) F) M cle)) A2)) (wcel F clo1) $;

--| An eventually upper bounded function is a function. (Contributed by Mario Carneiro, 26-May-2016.)
theorem lo1f (F: class):
  $ wi (wcel F clo1) (wf (cdm F) cr F) $;

--| An eventually upper bounded function's domain is a subset of the reals. (Contributed by Mario Carneiro, 26-May-2016.)
theorem lo1dm (F: class):
  $ wi (wcel F clo1) (wss (cdm F) cr) $;

--| The defining property of an eventually upper bounded function. (Contributed by Mario Carneiro, 26-May-2016.)
theorem lo1bdd {x3 y1 m: setvar} (A2 F: class):
  $ wi (wa (wcel F clo1) (wf A2 cr F)) (wrex x3 (wrex m (wral y1 (wi (wbr (cv x3) (cv y1) cle) (wbr (cfv (cv y1) F) (cv m) cle)) A2) cr) cr) $;

--| Elementhood in the set of eventually upper bounded functions. (Contributed by Mario Carneiro, 26-May-2016.)
theorem ello1mpt {x3 y1 m: setvar} (ph: wff) (A2: class) (B2: class x3):
  $ wi ph (wss A2 cr) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi ph (wb (wcel (cmpt x3 A2 B2) clo1) (wrex y1 (wrex m (wral x3 (wi (wbr (cv y1) (cv x3) cle) (wbr B2 (cv m) cle)) A2) cr) cr)) $;

--| Elementhood in the set of eventually upper bounded functions. (Contributed by Mario Carneiro, 26-May-2016.)
theorem ello1mpt2 {x3 y1 m: setvar} (ph: wff) (A2: class) (B2: class x3) (C: class):
  $ wi ph (wss A2 cr) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wb (wcel (cmpt x3 A2 B2) clo1) (wrex y1 (wrex m (wral x3 (wi (wbr (cv y1) (cv x3) cle) (wbr B2 (cv m) cle)) A2) cr) (co C cpnf cico))) $;

--| Sufficient condition for elementhood in the set of eventually upper bounded functions. (Contributed by Mario Carneiro, 26-May-2016.)
theorem ello1d {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (C M: class):
  $ wi ph (wss A2 cr) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wcel M cr) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wbr C (cv x3) cle))) (wbr B2 M cle) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) clo1) $;

--| If an eventually bounded function is bounded on every interval ` A i^i ( -oo , y ) ` by a function ` M ( y ) ` , then the function is bounded on the whole domain. (Contributed by Mario Carneiro, 9-Apr-2016.)
theorem lo1bdd2 {x3 y1 m: setvar} (ph: wff m) (A2: class) (B2: class x3) (C: class m) (M: class y1):
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) clo1) $ >
  $ wi (wa ph (wa (wcel (cv y1) cr) (wbr C (cv y1) cle))) (wcel M cr) $ >
  $ wi (wa (wa ph (wcel (cv x3) A2)) (wa (wa (wcel (cv y1) cr) (wbr C (cv y1) cle)) (wbr (cv x3) (cv y1) clt))) (wbr B2 M cle) $ >
  $ wi ph (wrex m (wral x3 (wbr B2 (cv m) cle) A2) cr) $;

--| Refine ~ o1bdd2 to give a strictly positive upper bound. (Contributed by Mario Carneiro, 25-May-2016.)
theorem lo1bddrp {x3 y1 m: setvar} (ph: wff m) (A2: class) (B2: class x3) (C: class m) (M: class y1):
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) clo1) $ >
  $ wi (wa ph (wa (wcel (cv y1) cr) (wbr C (cv y1) cle))) (wcel M cr) $ >
  $ wi (wa (wa ph (wcel (cv x3) A2)) (wa (wa (wcel (cv y1) cr) (wbr C (cv y1) cle)) (wbr (cv x3) (cv y1) clt))) (wbr B2 M cle) $ >
  $ wi ph (wrex m (wral x3 (wbr B2 (cv m) cle) A2) crp) $;

--| Elementhood in the set of eventually bounded functions. (Contributed by Mario Carneiro, 15-Sep-2014.)
theorem elo1 {x3 y1 m: setvar} (F: class):
  $ wb (wcel F co1) (wa (wcel F (co cc cr cpm)) (wrex x3 (wrex m (wral y1 (wbr (cfv (cfv (cv y1) F) cabs) (cv m) cle) (cin (cdm F) (co (cv x3) cpnf cico))) cr) cr)) $;

--| Elementhood in the set of eventually bounded functions. (Contributed by Mario Carneiro, 15-Sep-2014.)
theorem elo12 {x3 y1 m: setvar} (A2 F: class):
  $ wi (wa (wf A2 cc F) (wss A2 cr)) (wb (wcel F co1) (wrex x3 (wrex m (wral y1 (wi (wbr (cv x3) (cv y1) cle) (wbr (cfv (cfv (cv y1) F) cabs) (cv m) cle)) A2) cr) cr)) $;

--| Sufficient condition for elementhood in the set of eventually bounded functions. (Contributed by Mario Carneiro, 15-Sep-2014.)
theorem elo12r {x3: setvar} (A2 C F M: class):
  $ wi (w3a (wa (wf A2 cc F) (wss A2 cr)) (wa (wcel C cr) (wcel M cr)) (wral x3 (wi (wbr C (cv x3) cle) (wbr (cfv (cfv (cv x3) F) cabs) M cle)) A2)) (wcel F co1) $;

--| An eventually bounded function is a function. (Contributed by Mario Carneiro, 15-Sep-2014.)
theorem o1f (F: class):
  $ wi (wcel F co1) (wf (cdm F) cc F) $;

--| An eventually bounded function's domain is a subset of the reals. (Contributed by Mario Carneiro, 15-Sep-2014.)
theorem o1dm (F: class):
  $ wi (wcel F co1) (wss (cdm F) cr) $;

--| The defining property of an eventually bounded function. (Contributed by Mario Carneiro, 15-Sep-2014.)
theorem o1bdd {x3 y1 m: setvar} (A2 F: class):
  $ wi (wa (wcel F co1) (wf A2 cc F)) (wrex x3 (wrex m (wral y1 (wi (wbr (cv x3) (cv y1) cle) (wbr (cfv (cfv (cv y1) F) cabs) (cv m) cle)) A2) cr) cr) $;

--| A function is eventually bounded iff its absolute value is eventually upper bounded. (Contributed by Mario Carneiro, 26-May-2016.)
theorem lo1o1 (A2 F: class):
  $ wi (wf A2 cc F) (wb (wcel F co1) (wcel (ccom cabs F) clo1)) $;

--| A function is eventually bounded iff its absolute value is eventually upper bounded. (This function is useful for converting theorems about ` <_O(1) ` to ` O(1) ` .) (Contributed by Mario Carneiro, 26-May-2016.)
theorem lo1o12 {x3: setvar} (ph: wff) (A2: class) (B2: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cc) $ >
  $ wi ph (wb (wcel (cmpt x3 A2 B2) co1) (wcel (cmpt x3 A2 (cfv B2 cabs)) clo1)) $;

--| Elementhood in the set of eventually bounded functions. (Contributed by Mario Carneiro, 21-Sep-2014.) (Proof shortened by Mario Carneiro, 26-May-2016.)
theorem elo1mpt {x3 y1 m: setvar} (ph: wff) (A2: class) (B2: class x3):
  $ wi ph (wss A2 cr) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cc) $ >
  $ wi ph (wb (wcel (cmpt x3 A2 B2) co1) (wrex y1 (wrex m (wral x3 (wi (wbr (cv y1) (cv x3) cle) (wbr (cfv B2 cabs) (cv m) cle)) A2) cr) cr)) $;

--| Elementhood in the set of eventually bounded functions. (Contributed by Mario Carneiro, 12-May-2016.) (Proof shortened by Mario Carneiro, 26-May-2016.)
theorem elo1mpt2 {x3 y1 m: setvar} (ph: wff) (A2: class) (B2: class x3) (C: class):
  $ wi ph (wss A2 cr) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cc) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wb (wcel (cmpt x3 A2 B2) co1) (wrex y1 (wrex m (wral x3 (wi (wbr (cv y1) (cv x3) cle) (wbr (cfv B2 cabs) (cv m) cle)) A2) cr) (co C cpnf cico))) $;

--| Sufficient condition for elementhood in the set of eventually bounded functions. (Contributed by Mario Carneiro, 21-Sep-2014.) (Proof shortened by Mario Carneiro, 26-May-2016.)
theorem elo1d {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (C M: class):
  $ wi ph (wss A2 cr) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cc) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wcel M cr) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wbr C (cv x3) cle))) (wbr (cfv B2 cabs) M cle) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) co1) $;

--| A real function is eventually bounded iff it is eventually lower bounded and eventually upper bounded. (Contributed by Mario Carneiro, 25-May-2016.)
theorem o1lo1 {x3: setvar} (ph: wff) (A2: class) (B2: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi ph (wb (wcel (cmpt x3 A2 B2) co1) (wa (wcel (cmpt x3 A2 B2) clo1) (wcel (cmpt x3 A2 (cneg B2)) clo1))) $;

--| A lower bounded real function is eventually bounded iff it is eventually upper bounded. (Contributed by Mario Carneiro, 26-May-2016.)
theorem o1lo12 {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (M: class):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi ph (wcel M cr) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wbr M B2 cle) $ >
  $ wi ph (wb (wcel (cmpt x3 A2 B2) co1) (wcel (cmpt x3 A2 B2) clo1)) $;

--| A real eventually bounded function is eventually upper bounded. (Contributed by Mario Carneiro, 26-May-2016.)
theorem o1lo1d {x3: setvar} (ph: wff) (A2: class) (B2: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) co1) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) clo1) $;

--| Derive eventual boundedness from separate upper and lower eventual bounds. (Contributed by Mario Carneiro, 15-Apr-2016.)
theorem icco1 {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (C M N: class):
  $ wi ph (wss A2 cr) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi ph (wcel M cr) $ >
  $ wi ph (wcel N cr) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wbr C (cv x3) cle))) (wcel B2 (co M N cicc)) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) co1) $;

--| If an eventually bounded function is bounded on every interval ` A i^i ( -oo , y ) ` by a function ` M ( y ) ` , then the function is bounded on the whole domain. (Contributed by Mario Carneiro, 9-Apr-2016.) (Proof shortened by Mario Carneiro, 26-May-2016.)
theorem o1bdd2 {x3 y1 m: setvar} (ph: wff m) (A2: class) (B2: class x3) (C: class m) (M: class y1):
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cc) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) co1) $ >
  $ wi (wa ph (wa (wcel (cv y1) cr) (wbr C (cv y1) cle))) (wcel M cr) $ >
  $ wi (wa (wa ph (wcel (cv x3) A2)) (wa (wa (wcel (cv y1) cr) (wbr C (cv y1) cle)) (wbr (cv x3) (cv y1) clt))) (wbr (cfv B2 cabs) M cle) $ >
  $ wi ph (wrex m (wral x3 (wbr (cfv B2 cabs) (cv m) cle) A2) cr) $;

--| Refine ~ o1bdd2 to give a strictly positive upper bound. (Contributed by Mario Carneiro, 25-May-2016.)
theorem o1bddrp {x3 y1 m: setvar} (ph: wff m) (A2: class) (B2: class x3) (C: class m) (M: class y1):
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wcel C cr) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cc) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) co1) $ >
  $ wi (wa ph (wa (wcel (cv y1) cr) (wbr C (cv y1) cle))) (wcel M cr) $ >
  $ wi (wa (wa ph (wcel (cv x3) A2)) (wa (wa (wcel (cv y1) cr) (wbr C (cv y1) cle)) (wbr (cv x3) (cv y1) clt))) (wbr (cfv B2 cabs) M cle) $ >
  $ wi ph (wrex m (wral x3 (wbr (cfv B2 cabs) (cv m) cle) A2) crp) $;

--| An (eventually) constant sequence converges to its value. (Contributed by NM, 28-Aug-2005.) (Revised by Mario Carneiro, 31-Jan-2014.)
theorem climconst {k: setvar} (ph: wff) (A2 F: class) (M V: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel F V) $ >
  $ wi ph (wcel A2 cc) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) A2) $ >
  $ wi ph (wbr F A2 cli) $;

--| A constant sequence converges to its value. (Contributed by Mario Carneiro, 16-Sep-2014.)
theorem rlimconst {x3: setvar} (A2 B2: class):
  $ wi (wa (wss A2 cr) (wcel B2 cc)) (wbr (cmpt x3 A2 B2) B2 crli) $;

--| Forward direction of ~ rlimclim . (Contributed by Mario Carneiro, 16-Sep-2014.)
theorem rlimclim1 (ph: wff) (A2 F M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wbr F A2 crli) $ >
  $ wi ph (wss Z (cdm F)) $ >
  $ wi ph (wbr F A2 cli) $;

--| A sequence on an upper integer set converges in the real sense iff it converges in the integer sense. (Contributed by Mario Carneiro, 16-Sep-2014.)
theorem rlimclim (ph: wff) (A2 F M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wf Z cc F) $ >
  $ wi ph (wb (wbr F A2 crli) (wbr F A2 cli)) $;

--| Produce a real limit from an integer limit, where the real function is only dependent on the integer part of ` x ` . (Contributed by Mario Carneiro, 2-May-2016.)
theorem climrlim2 {x3 n: setvar} (ph: wff) (A2 B2: class n) (C: class x3) (D: class n) (M: class x3 n) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi (wceq (cv n) (cfv (cv x3) cfl)) (wceq B2 C) $ >
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wbr (cmpt n Z B2) D cli) $ >
  $ wi (wa ph (wcel (cv n) Z)) (wcel B2 cc) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wbr M (cv x3) cle) $ >
  $ wi ph (wbr (cmpt x3 A2 C) D crli) $;

--| A constant sequence converges to its value. (Contributed by NM, 6-Feb-2008.) (Revised by Mario Carneiro, 31-Jan-2014.)
theorem climconst2 (A2 M Z: class):
  $ wss (cfv M cuz) Z $ >
  $ wcel Z cvv $ >
  $ wi (wa (wcel A2 cc) (wcel M cz)) (wbr (cxp Z (csn A2)) A2 cli) $;

--| The zero sequence converges to zero. (Contributed by NM, 2-Oct-1999.) (Revised by Mario Carneiro, 31-Jan-2014.)
theorem climz:
  $ wbr (cxp cz (csn cc0)) cc0 cli $;

--| A real function whose domain is unbounded above converges to at most one limit. (Contributed by Mario Carneiro, 8-May-2016.)
theorem rlimuni (ph: wff) (A2 B2 C F: class):
  $ wi ph (wf A2 cc F) $ >
  $ wi ph (wceq (csup A2 cxr clt) cpnf) $ >
  $ wi ph (wbr F B2 crli) $ >
  $ wi ph (wbr F C crli) $ >
  $ wi ph (wceq B2 C) $;

--| Two ways to express that a function has a limit. (The expression ` ( ~~>r `` F ) ` is sometimes useful as a shorthand for "the unique limit of the function ` F ` "). (Contributed by Mario Carneiro, 8-May-2016.)
theorem rlimdm (ph: wff) (A2 F: class):
  $ wi ph (wf A2 cc F) $ >
  $ wi ph (wceq (csup A2 cxr clt) cpnf) $ >
  $ wi ph (wb (wcel F (cdm crli)) (wbr F (cfv F crli) crli)) $;

--| An infinite sequence of complex numbers converges to at most one limit. (Contributed by NM, 2-Oct-1999.) (Proof shortened by Mario Carneiro, 31-Jan-2014.)
theorem climuni (A2 B2 F: class):
  $ wi (wa (wbr F A2 cli) (wbr F B2 cli)) (wceq A2 B2) $;

--| The limit relation is function-like, and with codomain the complex numbers. (Contributed by Mario Carneiro, 31-Jan-2014.)
theorem fclim:
  $ wf (cdm cli) cc cli $;

--| Two ways to express that a function has a limit. (The expression ` ( ~~> `` F ) ` is sometimes useful as a shorthand for "the unique limit of the function ` F ` "). (Contributed by Mario Carneiro, 18-Mar-2014.)
theorem climdm (F: class):
  $ wb (wcel F (cdm cli)) (wbr F (cfv F cli) cli) $;

--| An infinite sequence of complex numbers converges to at most one limit. (Contributed by NM, 25-Dec-2005.)
theorem climeu {x3: setvar} (A2: class x3) (F: class):
  $ wi (wbr F A2 cli) (weu x3 (wbr F (cv x3) cli)) $;

--| An infinite sequence of complex numbers converges to at most one limit. (Contributed by NM, 25-Dec-2005.)
theorem climreu {x3: setvar} (A2: class x3) (F: class):
  $ wi (wbr F A2 cli) (wreu x3 (wbr F (cv x3) cli) cc) $;

--| An infinite sequence of complex numbers converges to at most one limit. (Contributed by Mario Carneiro, 13-Jul-2013.)
theorem climmo {x3: setvar} (F: class):
  $ wmo x3 (wbr F (cv x3) cli) $;

--| The restriction of a function converges if the original converges. (Contributed by Mario Carneiro, 16-Sep-2014.)
theorem rlimres (A2 B2 F: class):
  $ wi (wbr F A2 crli) (wbr (cres F B2) A2 crli) $;

--| The restriction of an eventually upper bounded function is eventually upper bounded. (Contributed by Mario Carneiro, 15-Sep-2014.)
theorem lo1res (A2 F: class):
  $ wi (wcel F clo1) (wcel (cres F A2) clo1) $;

--| The restriction of an eventually bounded function is eventually bounded. (Contributed by Mario Carneiro, 15-Sep-2014.) (Proof shortened by Mario Carneiro, 26-May-2016.)
theorem o1res (A2 F: class):
  $ wi (wcel F co1) (wcel (cres F A2) co1) $;

--| The restriction of a function converges if the original converges. (Contributed by Mario Carneiro, 16-Sep-2014.)
theorem rlimres2 {x3: setvar} (ph: wff x3) (A2 B2: class) (C D: class x3):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wbr (cmpt x3 B2 C) D crli) $ >
  $ wi ph (wbr (cmpt x3 A2 C) D crli) $;

--| The restriction of a function is eventually bounded if the original is. (Contributed by Mario Carneiro, 26-May-2016.)
theorem lo1res2 {x3: setvar} (ph: wff x3) (A2 B2: class) (C: class x3):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wcel (cmpt x3 B2 C) clo1) $ >
  $ wi ph (wcel (cmpt x3 A2 C) clo1) $;

--| The restriction of a function is eventually bounded if the original is. (Contributed by Mario Carneiro, 21-May-2016.)
theorem o1res2 {x3: setvar} (ph: wff x3) (A2 B2: class) (C: class x3):
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wcel (cmpt x3 B2 C) co1) $ >
  $ wi ph (wcel (cmpt x3 A2 C) co1) $;

--| The restriction of a function to an unbounded-above interval is eventually upper bounded iff the original is eventually upper bounded. (Contributed by Mario Carneiro, 26-May-2016.)
theorem lo1resb (ph: wff) (A2 B2 F: class):
  $ wi ph (wf A2 cr F) $ >
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wb (wcel F clo1) (wcel (cres F (co B2 cpnf cico)) clo1)) $;

--| The restriction of a function to an unbounded-above interval converges iff the original converges. (Contributed by Mario Carneiro, 16-Sep-2014.)
theorem rlimresb (ph: wff) (A2 B2 C F: class):
  $ wi ph (wf A2 cc F) $ >
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wb (wbr F C crli) (wbr (cres F (co B2 cpnf cico)) C crli)) $;

--| The restriction of a function to an unbounded-above interval is eventually bounded iff the original is eventually bounded. (Contributed by Mario Carneiro, 9-Apr-2016.)
theorem o1resb (ph: wff) (A2 B2 F: class):
  $ wi ph (wf A2 cc F) $ >
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wb (wcel F co1) (wcel (cres F (co B2 cpnf cico)) co1)) $;

--| Two functions that are eventually equal to one another have the same limit. (Contributed by Mario Carneiro, 5-Nov-2013.) (Revised by Mario Carneiro, 31-Jan-2014.)
theorem climeq {k: setvar} (ph: wff) (A2 F G: class) (M V W: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel F V) $ >
  $ wi ph (wcel G W) $ >
  $ wi ph (wcel M cz) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) (cfv (cv k) G)) $ >
  $ wi ph (wb (wbr F A2 cli) (wbr G A2 cli)) $;

--| Two functions that are eventually equal to one another are eventually bounded if one of them is. (Contributed by Mario Carneiro, 26-May-2016.)
theorem lo1eq {x3: setvar} (ph: wff) (A2: class) (B2 C: class x3) (D: class):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C cr) $ >
  $ wi ph (wcel D cr) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wbr D (cv x3) cle))) (wceq B2 C) $ >
  $ wi ph (wb (wcel (cmpt x3 A2 B2) clo1) (wcel (cmpt x3 A2 C) clo1)) $;

--| Two functions that are eventually equal to one another have the same limit. (Contributed by Mario Carneiro, 16-Sep-2014.)
theorem rlimeq {x3: setvar} (ph: wff) (A2: class) (B2 C: class x3) (D: class) (E: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cc) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C cc) $ >
  $ wi ph (wcel D cr) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wbr D (cv x3) cle))) (wceq B2 C) $ >
  $ wi ph (wb (wbr (cmpt x3 A2 B2) E crli) (wbr (cmpt x3 A2 C) E crli)) $;

--| Two functions that are eventually equal to one another are eventually bounded if one of them is. (Contributed by Mario Carneiro, 26-May-2016.)
theorem o1eq {x3: setvar} (ph: wff) (A2: class) (B2 C: class x3) (D: class):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cc) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C cc) $ >
  $ wi ph (wcel D cr) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wbr D (cv x3) cle))) (wceq B2 C) $ >
  $ wi ph (wb (wcel (cmpt x3 A2 B2) co1) (wcel (cmpt x3 A2 C) co1)) $;

--| Exhibit a function ` G ` with the same convergence properties as the not-quite-function ` F ` . (Contributed by Mario Carneiro, 31-Jan-2014.)
theorem climmpt {k: setvar} (A2 F: class) (G M V: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wceq G (cmpt k Z (cfv (cv k) F)) $ >
  $ wi (wa (wcel M cz) (wcel F V)) (wb (wbr F A2 cli) (wbr G A2 cli)) $;

--| If two sequences converge to each other, they converge to the same limit. (Contributed by NM, 24-Dec-2005.) (Proof shortened by Mario Carneiro, 31-Jan-2014.)
theorem _2clim {x3 j k: setvar} (ph: wff x3) (A2: class x3) (F G: class) (M: class x3 k) (V: class x3 j k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel G V) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) G) cc) $ >
  $ wi ph (wral x3 (wrex j (wral k (wbr (cfv (co (cfv (cv k) F) (cfv (cv k) G) cmin) cabs) (cv x3) clt) (cfv (cv j) cuz)) Z) crp) $ >
  $ wi ph (wbr F A2 cli) $ >
  $ wi ph (wbr G A2 cli) $;

--| Relate an integer limit on a not-quite-function to a real limit. (Contributed by Mario Carneiro, 17-Sep-2014.)
theorem climmpt2 {k n: setvar} (ph: wff) (A2: class k) (F: class) (M V: class k n) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel F V) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wi ph (wb (wbr F A2 cli) (wbr (cmpt n Z (cfv (cv n) F)) A2 crli)) $;

--| A shifted function converges if the original function converges. (Contributed by Mario Carneiro, 5-Nov-2013.)
theorem climshftlem (A2 F M: class):
  $ wcel F cvv $ >
  $ wi (wcel M cz) (wi (wbr F A2 cli) (wbr (co F M cshi) A2 cli)) $;

--| A function restricted to upper integers converges iff the original function converges. (Contributed by Mario Carneiro, 13-Jul-2013.) (Revised by Mario Carneiro, 31-Jan-2014.)
theorem climres (A2 F M V: class):
  $ wi (wa (wcel M cz) (wcel F V)) (wb (wbr (cres F (cfv M cuz)) A2 cli) (wbr F A2 cli)) $;

--| A shifted function converges iff the original function converges. (Contributed by NM, 16-Aug-2005.) (Revised by Mario Carneiro, 31-Jan-2014.)
theorem climshft (A2 F M V: class):
  $ wi (wa (wcel M cz) (wcel F V)) (wb (wbr (co F M cshi) A2 cli) (wbr F A2 cli)) $;

--| The zero series converges to zero. (Contributed by Paul Chapman, 9-Feb-2008.) (Proof shortened by Mario Carneiro, 31-Jan-2014.)
theorem serclim0 (M: class):
  $ wi (wcel M cz) (wbr (cseq caddc (cxp (cfv M cuz) (csn cc0)) M) cc0 cli) $;

--| If ` D ` is a closed set in the topology of the complex numbers (stated here in basic form), and all the elements of the sequence lie in ` D ` , then the limit of the sequence also lies in ` D ` . (Contributed by Mario Carneiro, 10-May-2016.)
theorem rlimcld2 {x3 y1 z: setvar} (ph: wff) (A2: class) (B2: class x3) (C D: class) (R: class y1):
  $ wi ph (wceq (csup A2 cxr clt) cpnf) $ >
  $ wi ph (wbr (cmpt x3 A2 B2) C crli) $ >
  $ wi ph (wss D cc) $ >
  $ wi (wa ph (wcel (cv y1) (cdif cc D))) (wcel R crp) $ >
  $ wi (wa (wa ph (wcel (cv y1) (cdif cc D))) (wcel (cv z) D)) (wbr R (cfv (co (cv z) (cv y1) cmin) cabs) cle) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 D) $ >
  $ wi ph (wcel C D) $;

--| The limit of a sequence of complex numbers with nonnegative real part has nonnegative real part. (Contributed by Mario Carneiro, 10-May-2016.)
theorem rlimrege0 {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (C: class):
  $ wi ph (wceq (csup A2 cxr clt) cpnf) $ >
  $ wi ph (wbr (cmpt x3 A2 B2) C crli) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cc) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wbr cc0 (cfv B2 cre) cle) $ >
  $ wi ph (wbr cc0 (cfv C cre) cle) $;

--| The limit of a real sequence is real. (Contributed by Mario Carneiro, 9-May-2016.)
theorem rlimrecl {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (C: class):
  $ wi ph (wceq (csup A2 cxr clt) cpnf) $ >
  $ wi ph (wbr (cmpt x3 A2 B2) C crli) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi ph (wcel C cr) $;

--| The limit of a sequence of nonnegative reals is nonnegative. (Contributed by Mario Carneiro, 10-May-2016.)
theorem rlimge0 {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (C: class):
  $ wi ph (wceq (csup A2 cxr clt) cpnf) $ >
  $ wi ph (wbr (cmpt x3 A2 B2) C crli) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wbr cc0 B2 cle) $ >
  $ wi ph (wbr cc0 C cle) $;

--| A shifted function converges iff the original function converges. (Contributed by Paul Chapman, 21-Nov-2007.) (Revised by Mario Carneiro, 6-Feb-2014.)
theorem climshft2 {k: setvar} (ph: wff) (A2 F G K M: class) (W X: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel K cz) $ >
  $ wi ph (wcel F W) $ >
  $ wi ph (wcel G X) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (co (cv k) K caddc) G) (cfv (cv k) F)) $ >
  $ wi ph (wb (wbr F A2 cli) (wbr G A2 cli)) $;

--| The limit of a convergent real sequence is real. Corollary 12-2.5 of [Gleason] p. 172. (Contributed by NM, 10-Sep-2005.) (Proof shortened by Mario Carneiro, 10-May-2016.)
theorem climrecl {k: setvar} (ph: wff) (A2 F M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wbr F A2 cli) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cr) $ >
  $ wi ph (wcel A2 cr) $;

--| A nonnegative sequence converges to a nonnegative number. (Contributed by NM, 11-Sep-2005.) (Proof shortened by Mario Carneiro, 10-May-2016.)
theorem climge0 {k: setvar} (ph: wff) (A2 F M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wbr F A2 cli) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cr) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wbr cc0 (cfv (cv k) F) cle) $ >
  $ wi ph (wbr cc0 A2 cle) $;

--| Convergence to zero of the absolute value is equivalent to convergence to zero. (Contributed by NM, 8-Jul-2008.) (Revised by Mario Carneiro, 31-Jan-2014.)
theorem climabs0 {k: setvar} (ph: wff) (F G: class) (M V W: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel F V) $ >
  $ wi ph (wcel G W) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) G) (cfv (cfv (cv k) F) cabs)) $ >
  $ wi ph (wb (wbr F cc0 cli) (wbr G cc0 cli)) $;

--| Sufficient condition for transforming the index set of an eventually bounded function. (Contributed by Mario Carneiro, 12-May-2016.)
theorem o1co {x3 y1 m: setvar} (ph: wff) (A2 B2 F G: class):
  $ wi ph (wf A2 cc F) $ >
  $ wi ph (wcel F co1) $ >
  $ wi ph (wf B2 A2 G) $ >
  $ wi ph (wss B2 cr) $ >
  $ wi (wa ph (wcel (cv m) cr)) (wrex x3 (wral y1 (wi (wbr (cv x3) (cv y1) cle) (wbr (cv m) (cfv (cv y1) G) cle)) B2) cr) $ >
  $ wi ph (wcel (ccom F G) co1) $;

--| Sufficient condition for transforming the index set of an eventually bounded function. (Contributed by Mario Carneiro, 12-May-2016.)
theorem o1compt {x3 y1 m: setvar} (ph: wff) (A2 B2: class) (C F: class y1):
  $ wi ph (wf A2 cc F) $ >
  $ wi ph (wcel F co1) $ >
  $ wi (wa ph (wcel (cv y1) B2)) (wcel C A2) $ >
  $ wi ph (wss B2 cr) $ >
  $ wi (wa ph (wcel (cv m) cr)) (wrex x3 (wral y1 (wi (wbr (cv x3) (cv y1) cle) (wbr (cv m) C cle)) B2) cr) $ >
  $ wi ph (wcel (ccom F (cmpt y1 B2 C)) co1) $;

--| Image of a limit under a continuous map. (Contributed by Mario Carneiro, 17-Sep-2014.)
theorem rlimcn1 {x3 y1 z: setvar} (ph: wff z) (A2: class z) (C F G: class) (X: class x3 y1):
  $ wi ph (wf A2 X G) $ >
  $ wi ph (wcel C X) $ >
  $ wi ph (wbr G C crli) $ >
  $ wi ph (wf X cc F) $ >
  $ wi (wa ph (wcel (cv x3) crp)) (wrex y1 (wral z (wi (wbr (cfv (co (cv z) C cmin) cabs) (cv y1) clt) (wbr (cfv (co (cfv (cv z) F) (cfv C F) cmin) cabs) (cv x3) clt)) X) crp) $ >
  $ wi ph (wbr (ccom F G) (cfv C F) crli) $;

--| Image of a limit under a continuous map. (Contributed by Mario Carneiro, 10-May-2016.)
theorem rlimcn1b {x3 y1 z k: setvar} (ph: wff z) (A2: class) (B2 C: class k) (F: class) (X: class x3 y1):
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 X) $ >
  $ wi ph (wcel C X) $ >
  $ wi ph (wbr (cmpt k A2 B2) C crli) $ >
  $ wi ph (wf X cc F) $ >
  $ wi (wa ph (wcel (cv x3) crp)) (wrex y1 (wral z (wi (wbr (cfv (co (cv z) C cmin) cabs) (cv y1) clt) (wbr (cfv (co (cfv (cv z) F) (cfv C F) cmin) cabs) (cv x3) clt)) X) crp) $ >
  $ wi ph (wbr (cmpt k A2 (cfv B2 F)) (cfv C F) crli) $;

--| Image of a limit under a continuous map, two-arg version. Originally a subproof of ~ rlimcn2 . (Contributed by SN, 27-Sep-2024.)
theorem rlimcn3 {x3 z v u s1 r: setvar} (ph: wff v u) (A2: class v u) (B2: class z) (C: class z u) (R S F: class) (X: class x3 v s1 r) (Y: class x3 s1 r):
  $ wi (wa ph (wcel (cv z) A2)) (wcel B2 X) $ >
  $ wi (wa ph (wcel (cv z) A2)) (wcel C Y) $ >
  $ wi (wa ph (wcel (cv z) A2)) (wcel (co B2 C F) cc) $ >
  $ wi ph (wcel (co R S F) cc) $ >
  $ wi ph (wbr (cmpt z A2 B2) R crli) $ >
  $ wi ph (wbr (cmpt z A2 C) S crli) $ >
  $ wi (wa ph (wcel (cv x3) crp)) (wrex r (wrex s1 (wral u (wral v (wi (wa (wbr (cfv (co (cv u) R cmin) cabs) (cv r) clt) (wbr (cfv (co (cv v) S cmin) cabs) (cv s1) clt)) (wbr (cfv (co (co (cv u) (cv v) F) (co R S F) cmin) cabs) (cv x3) clt)) Y) X) crp) crp) $ >
  $ wi ph (wbr (cmpt z A2 (co B2 C F)) (co R S F) crli) $;

--| Image of a limit under a continuous map, two-arg version. (Contributed by Mario Carneiro, 17-Sep-2014.)
theorem rlimcn2 {x3 z v u s1 r: setvar} (ph: wff v u) (A2: class v u) (B2: class z) (C: class z u) (R S F: class) (X: class x3 v s1 r) (Y: class x3 s1 r):
  $ wi (wa ph (wcel (cv z) A2)) (wcel B2 X) $ >
  $ wi (wa ph (wcel (cv z) A2)) (wcel C Y) $ >
  $ wi ph (wcel R X) $ >
  $ wi ph (wcel S Y) $ >
  $ wi ph (wbr (cmpt z A2 B2) R crli) $ >
  $ wi ph (wbr (cmpt z A2 C) S crli) $ >
  $ wi ph (wf (cxp X Y) cc F) $ >
  $ wi (wa ph (wcel (cv x3) crp)) (wrex r (wrex s1 (wral u (wral v (wi (wa (wbr (cfv (co (cv u) R cmin) cabs) (cv r) clt) (wbr (cfv (co (cv v) S cmin) cabs) (cv s1) clt)) (wbr (cfv (co (co (cv u) (cv v) F) (co R S F) cmin) cabs) (cv x3) clt)) Y) X) crp) crp) $ >
  $ wi ph (wbr (cmpt z A2 (co B2 C F)) (co R S F) crli) $;

--| Image of a limit under a continuous map. (Contributed by Mario Carneiro, 31-Jan-2014.)
theorem climcn1 {x3 y1 z k: setvar} (ph: wff) (A2: class) (B2: class x3 y1) (F: class) (G: class x3) (H: class y1 z) (M W: class x3 y1 z k) (Z: class x3 z):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi (wa ph (wcel (cv z) B2)) (wcel (cfv (cv z) F) cc) $ >
  $ wi ph (wbr G A2 cli) $ >
  $ wi ph (wcel H W) $ >
  $ wi (wa ph (wcel (cv x3) crp)) (wrex y1 (wral z (wi (wbr (cfv (co (cv z) A2 cmin) cabs) (cv y1) clt) (wbr (cfv (co (cfv (cv z) F) (cfv A2 F) cmin) cabs) (cv x3) clt)) B2) crp) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) G) B2) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) H) (cfv (cfv (cv k) G) F)) $ >
  $ wi ph (wbr H (cfv A2 F) cli) $;

--| Image of a limit under a continuous map, two-arg version. (Contributed by Mario Carneiro, 31-Jan-2014.)
theorem climcn2 {x3 y1 z v u k: setvar} (ph: wff) (A2 B2: class) (C D: class x3 y1 z) (F: class) (G: class x3) (H: class x3 u) (K: class y1 z v u) (M W: class x3 y1 z v u k) (Z: class x3 v u):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel A2 C) $ >
  $ wi ph (wcel B2 D) $ >
  $ wi (wa ph (wa (wcel (cv u) C) (wcel (cv v) D))) (wcel (co (cv u) (cv v) F) cc) $ >
  $ wi ph (wbr G A2 cli) $ >
  $ wi ph (wbr H B2 cli) $ >
  $ wi ph (wcel K W) $ >
  $ wi (wa ph (wcel (cv x3) crp)) (wrex y1 (wrex z (wral u (wral v (wi (wa (wbr (cfv (co (cv u) A2 cmin) cabs) (cv y1) clt) (wbr (cfv (co (cv v) B2 cmin) cabs) (cv z) clt)) (wbr (cfv (co (co (cv u) (cv v) F) (co A2 B2 F) cmin) cabs) (cv x3) clt)) D) C) crp) crp) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) G) C) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) H) D) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) K) (co (cfv (cv k) G) (cfv (cv k) H) F)) $ >
  $ wi ph (wbr K (co A2 B2 F) cli) $;

--| Complex number addition is a continuous function. Part of Proposition 14-4.16 of [Gleason] p. 243. (We write out the definition directly because ~ df-cn and ~ df-cncf are not yet available to us. See ~ addcn for the abbreviated version.) (Contributed by Mario Carneiro, 31-Jan-2014.)
theorem addcn2 {y1 z v u: setvar} (A2 B2 C: class):
  $ wi (w3a (wcel A2 crp) (wcel B2 cc) (wcel C cc)) (wrex y1 (wrex z (wral u (wral v (wi (wa (wbr (cfv (co (cv u) B2 cmin) cabs) (cv y1) clt) (wbr (cfv (co (cv v) C cmin) cabs) (cv z) clt)) (wbr (cfv (co (co (cv u) (cv v) caddc) (co B2 C caddc) cmin) cabs) A2 clt)) cc) cc) crp) crp) $;

--| Complex number subtraction is a continuous function. Part of Proposition 14-4.16 of [Gleason] p. 243. (Contributed by Mario Carneiro, 31-Jan-2014.)
theorem subcn2 {y1 z v u: setvar} (A2 B2 C: class):
  $ wi (w3a (wcel A2 crp) (wcel B2 cc) (wcel C cc)) (wrex y1 (wrex z (wral u (wral v (wi (wa (wbr (cfv (co (cv u) B2 cmin) cabs) (cv y1) clt) (wbr (cfv (co (cv v) C cmin) cabs) (cv z) clt)) (wbr (cfv (co (co (cv u) (cv v) cmin) (co B2 C cmin) cmin) cabs) A2 clt)) cc) cc) crp) crp) $;

--| Complex number multiplication is a continuous function. Part of Proposition 14-4.16 of [Gleason] p. 243. (Contributed by Mario Carneiro, 31-Jan-2014.)
theorem mulcn2 {y1 z v u: setvar} (A2 B2 C: class):
  $ wi (w3a (wcel A2 crp) (wcel B2 cc) (wcel C cc)) (wrex y1 (wrex z (wral u (wral v (wi (wa (wbr (cfv (co (cv u) B2 cmin) cabs) (cv y1) clt) (wbr (cfv (co (cv v) C cmin) cabs) (cv z) clt)) (wbr (cfv (co (co (cv u) (cv v) cmul) (co B2 C cmul) cmin) cabs) A2 clt)) cc) cc) crp) crp) $;

--| The reciprocal function is continuous. (Contributed by Mario Carneiro, 9-Feb-2014.) (Revised by Mario Carneiro, 22-Sep-2014.)
theorem reccn2 {y1 z: setvar} (A2 B2 T: class):
  $ wceq T (co (cif (wbr c1 (co (cfv A2 cabs) B2 cmul) cle) c1 (co (cfv A2 cabs) B2 cmul)) (co (cfv A2 cabs) c2 cdiv) cmul) $ >
  $ wi (wa (wcel A2 (cdif cc (csn cc0))) (wcel B2 crp)) (wrex y1 (wral z (wi (wbr (cfv (co (cv z) A2 cmin) cabs) (cv y1) clt) (wbr (cfv (co (co c1 (cv z) cdiv) (co c1 A2 cdiv) cmin) cabs) B2 clt)) (cdif cc (csn cc0))) crp) $;

--| A sufficient condition for a function to be continuous. (Contributed by Mario Carneiro, 9-Feb-2014.)
theorem cn1lem {y1 z: setvar} (x3: setvar) (A2: class) (F: class z):
  $ wf cc cc F $ >
  $ wi (wa (wcel (cv z) cc) (wcel A2 cc)) (wbr (cfv (co (cfv (cv z) F) (cfv A2 F) cmin) cabs) (cfv (co (cv z) A2 cmin) cabs) cle) $ >
  $ wi (wa (wcel A2 cc) (wcel (cv x3) crp)) (wrex y1 (wral z (wi (wbr (cfv (co (cv z) A2 cmin) cabs) (cv y1) clt) (wbr (cfv (co (cfv (cv z) F) (cfv A2 F) cmin) cabs) (cv x3) clt)) cc) crp) $;

--| The absolute value function is continuous. (Contributed by Mario Carneiro, 9-Feb-2014.)
theorem abscn2 {y1 z: setvar} (x3: setvar) (A2: class):
  $ wi (wa (wcel A2 cc) (wcel (cv x3) crp)) (wrex y1 (wral z (wi (wbr (cfv (co (cv z) A2 cmin) cabs) (cv y1) clt) (wbr (cfv (co (cfv (cv z) cabs) (cfv A2 cabs) cmin) cabs) (cv x3) clt)) cc) crp) $;

--| The complex conjugate function is continuous. (Contributed by Mario Carneiro, 9-Feb-2014.)
theorem cjcn2 {y1 z: setvar} (x3: setvar) (A2: class):
  $ wi (wa (wcel A2 cc) (wcel (cv x3) crp)) (wrex y1 (wral z (wi (wbr (cfv (co (cv z) A2 cmin) cabs) (cv y1) clt) (wbr (cfv (co (cfv (cv z) ccj) (cfv A2 ccj) cmin) cabs) (cv x3) clt)) cc) crp) $;

--| The real part function is continuous. (Contributed by Mario Carneiro, 9-Feb-2014.)
theorem recn2 {y1 z: setvar} (x3: setvar) (A2: class):
  $ wi (wa (wcel A2 cc) (wcel (cv x3) crp)) (wrex y1 (wral z (wi (wbr (cfv (co (cv z) A2 cmin) cabs) (cv y1) clt) (wbr (cfv (co (cfv (cv z) cre) (cfv A2 cre) cmin) cabs) (cv x3) clt)) cc) crp) $;

--| The imaginary part function is continuous. (Contributed by Mario Carneiro, 9-Feb-2014.)
theorem imcn2 {y1 z: setvar} (x3: setvar) (A2: class):
  $ wi (wa (wcel A2 cc) (wcel (cv x3) crp)) (wrex y1 (wral z (wi (wbr (cfv (co (cv z) A2 cmin) cabs) (cv y1) clt) (wbr (cfv (co (cfv (cv z) cim) (cfv A2 cim) cmin) cabs) (cv x3) clt)) cc) crp) $;

--| The limit of a continuous function, theorem form. (Contributed by Mario Carneiro, 9-Feb-2014.)
theorem climcn1lem {x3 y1 z k: setvar} (ph: wff) (A2: class) (F: class x3) (G: class y1 z) (H: class) (M: class x3 y1 z) (W: class x3 y1 z k) (Z: class x3 z):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wbr F A2 cli) $ >
  $ wi ph (wcel G W) $ >
  $ wi ph (wcel M cz) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wf cc cc H $ >
  $ wi (wa (wcel A2 cc) (wcel (cv x3) crp)) (wrex y1 (wral z (wi (wbr (cfv (co (cv z) A2 cmin) cabs) (cv y1) clt) (wbr (cfv (co (cfv (cv z) H) (cfv A2 H) cmin) cabs) (cv x3) clt)) cc) crp) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) G) (cfv (cfv (cv k) F) H)) $ >
  $ wi ph (wbr G (cfv A2 H) cli) $;

--| Limit of the absolute value of a sequence. Proposition 12-2.4(c) of [Gleason] p. 172. (Contributed by NM, 7-Jun-2006.) (Revised by Mario Carneiro, 9-Feb-2014.)
theorem climabs {k: setvar} (ph: wff) (A2 F G M: class) (W: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wbr F A2 cli) $ >
  $ wi ph (wcel G W) $ >
  $ wi ph (wcel M cz) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) G) (cfv (cfv (cv k) F) cabs)) $ >
  $ wi ph (wbr G (cfv A2 cabs) cli) $;

--| Limit of the complex conjugate of a sequence. Proposition 12-2.4(c) of [Gleason] p. 172. (Contributed by NM, 7-Jun-2006.) (Revised by Mario Carneiro, 9-Feb-2014.)
theorem climcj {k: setvar} (ph: wff) (A2 F G M: class) (W: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wbr F A2 cli) $ >
  $ wi ph (wcel G W) $ >
  $ wi ph (wcel M cz) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) G) (cfv (cfv (cv k) F) ccj)) $ >
  $ wi ph (wbr G (cfv A2 ccj) cli) $;

--| Limit of the real part of a sequence. Proposition 12-2.4(c) of [Gleason] p. 172. (Contributed by NM, 7-Jun-2006.) (Revised by Mario Carneiro, 9-Feb-2014.)
theorem climre {k: setvar} (ph: wff) (A2 F G M: class) (W: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wbr F A2 cli) $ >
  $ wi ph (wcel G W) $ >
  $ wi ph (wcel M cz) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) G) (cfv (cfv (cv k) F) cre)) $ >
  $ wi ph (wbr G (cfv A2 cre) cli) $;

--| Limit of the imaginary part of a sequence. Proposition 12-2.4(c) of [Gleason] p. 172. (Contributed by NM, 7-Jun-2006.) (Revised by Mario Carneiro, 9-Feb-2014.)
theorem climim {k: setvar} (ph: wff) (A2 F G M: class) (W: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wbr F A2 cli) $ >
  $ wi ph (wcel G W) $ >
  $ wi ph (wcel M cz) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) G) (cfv (cfv (cv k) F) cim)) $ >
  $ wi ph (wbr G (cfv A2 cim) cli) $;

--| Reverse closure for a real limit. (Contributed by Mario Carneiro, 10-May-2016.)
theorem rlimmptrcl {k: setvar} (ph: wff) (A2: class) (B2 C V: class k):
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 V) $ >
  $ wi ph (wbr (cmpt k A2 B2) C crli) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $;

--| Limit of the absolute value of a sequence. Proposition 12-2.4(c) of [Gleason] p. 172. (Contributed by Mario Carneiro, 10-May-2016.)
theorem rlimabs {k: setvar} (ph: wff) (A2: class) (B2 C V: class k):
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 V) $ >
  $ wi ph (wbr (cmpt k A2 B2) C crli) $ >
  $ wi ph (wbr (cmpt k A2 (cfv B2 cabs)) (cfv C cabs) crli) $;

--| Limit of the complex conjugate of a sequence. Proposition 12-2.4(c) of [Gleason] p. 172. (Contributed by Mario Carneiro, 10-May-2016.)
theorem rlimcj {k: setvar} (ph: wff) (A2: class) (B2 C V: class k):
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 V) $ >
  $ wi ph (wbr (cmpt k A2 B2) C crli) $ >
  $ wi ph (wbr (cmpt k A2 (cfv B2 ccj)) (cfv C ccj) crli) $;

--| Limit of the real part of a sequence. Proposition 12-2.4(c) of [Gleason] p. 172. (Contributed by Mario Carneiro, 10-May-2016.)
theorem rlimre {k: setvar} (ph: wff) (A2: class) (B2 C V: class k):
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 V) $ >
  $ wi ph (wbr (cmpt k A2 B2) C crli) $ >
  $ wi ph (wbr (cmpt k A2 (cfv B2 cre)) (cfv C cre) crli) $;

--| Limit of the imaginary part of a sequence. Proposition 12-2.4(c) of [Gleason] p. 172. (Contributed by Mario Carneiro, 10-May-2016.)
theorem rlimim {k: setvar} (ph: wff) (A2: class) (B2 C V: class k):
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 V) $ >
  $ wi ph (wbr (cmpt k A2 B2) C crli) $ >
  $ wi ph (wbr (cmpt k A2 (cfv B2 cim)) (cfv C cim) crli) $;

--| Show that a binary operation preserves eventual boundedness. (Contributed by Mario Carneiro, 15-Sep-2014.)
theorem o1of2 {x3 y1 m n: setvar} (R F G: class) (M: class m n):
  $ wi (wa (wcel (cv m) cr) (wcel (cv n) cr)) (wcel M cr) $ >
  $ wi (wa (wcel (cv x3) cc) (wcel (cv y1) cc)) (wcel (co (cv x3) (cv y1) R) cc) $ >
  $ wi (wa (wa (wcel (cv m) cr) (wcel (cv n) cr)) (wa (wcel (cv x3) cc) (wcel (cv y1) cc))) (wi (wa (wbr (cfv (cv x3) cabs) (cv m) cle) (wbr (cfv (cv y1) cabs) (cv n) cle)) (wbr (cfv (co (cv x3) (cv y1) R) cabs) M cle)) $ >
  $ wi (wa (wcel F co1) (wcel G co1)) (wcel (co F G (cof R)) co1) $;

--| The sum of two eventually bounded functions is eventually bounded. (Contributed by Mario Carneiro, 15-Sep-2014.) (Proof shortened by Fan Zheng, 14-Jul-2016.)
theorem o1add (F G: class):
  $ wi (wa (wcel F co1) (wcel G co1)) (wcel (co F G (cof caddc)) co1) $;

--| The product of two eventually bounded functions is eventually bounded. (Contributed by Mario Carneiro, 15-Sep-2014.) (Proof shortened by Fan Zheng, 14-Jul-2016.)
theorem o1mul (F G: class):
  $ wi (wa (wcel F co1) (wcel G co1)) (wcel (co F G (cof cmul)) co1) $;

--| The difference of two eventually bounded functions is eventually bounded. (Contributed by Mario Carneiro, 15-Sep-2014.) (Proof shortened by Fan Zheng, 14-Jul-2016.)
theorem o1sub (F G: class):
  $ wi (wa (wcel F co1) (wcel G co1)) (wcel (co F G (cof cmin)) co1) $;

--| Any function with a finite limit is eventually bounded. (Contributed by Mario Carneiro, 18-Sep-2014.)
theorem rlimo1 (A2 F: class):
  $ wi (wbr F A2 crli) (wcel F co1) $;

--| A convergent function is eventually bounded. (Contributed by Mario Carneiro, 12-May-2016.)
theorem rlimdmo1 (F: class):
  $ wi (wcel F (cdm crli)) (wcel F co1) $;

--| The product of an eventually bounded function and a function of limit zero has limit zero. (Contributed by Mario Carneiro, 18-Sep-2014.)
theorem o1rlimmul (F G: class):
  $ wi (wa (wcel F co1) (wbr G cc0 crli)) (wbr (co F G (cof cmul)) cc0 crli) $;

--| A constant function is eventually bounded. (Contributed by Mario Carneiro, 15-Sep-2014.) (Proof shortened by Mario Carneiro, 26-May-2016.)
theorem o1const {x3: setvar} (A2 B2: class):
  $ wi (wa (wss A2 cr) (wcel B2 cc)) (wcel (cmpt x3 A2 B2) co1) $;

--| A constant function is eventually upper bounded. (Contributed by Mario Carneiro, 26-May-2016.)
theorem lo1const {x3: setvar} (A2 B2: class):
  $ wi (wa (wss A2 cr) (wcel B2 cr)) (wcel (cmpt x3 A2 B2) clo1) $;

--| Reverse closure for an eventually upper bounded function. (Contributed by Mario Carneiro, 26-May-2016.)
theorem lo1mptrcl {x3: setvar} (ph: wff) (A2: class) (B2 V: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) clo1) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $;

--| Reverse closure for an eventually bounded function. (Contributed by Mario Carneiro, 26-May-2016.)
theorem o1mptrcl {x3: setvar} (ph: wff) (A2: class) (B2 V: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) co1) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cc) $;

--| The sum of two eventually bounded functions is eventually bounded. (Contributed by Mario Carneiro, 26-May-2016.)
theorem o1add2 {x3: setvar} (ph: wff) (A2: class) (B2 C V: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C V) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) co1) $ >
  $ wi ph (wcel (cmpt x3 A2 C) co1) $ >
  $ wi ph (wcel (cmpt x3 A2 (co B2 C caddc)) co1) $;

--| The product of two eventually bounded functions is eventually bounded. (Contributed by Mario Carneiro, 26-May-2016.)
theorem o1mul2 {x3: setvar} (ph: wff) (A2: class) (B2 C V: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C V) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) co1) $ >
  $ wi ph (wcel (cmpt x3 A2 C) co1) $ >
  $ wi ph (wcel (cmpt x3 A2 (co B2 C cmul)) co1) $;

--| The product of two eventually bounded functions is eventually bounded. (Contributed by Mario Carneiro, 15-Sep-2014.)
theorem o1sub2 {x3: setvar} (ph: wff) (A2: class) (B2 C V: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C V) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) co1) $ >
  $ wi ph (wcel (cmpt x3 A2 C) co1) $ >
  $ wi ph (wcel (cmpt x3 A2 (co B2 C cmin)) co1) $;

--| The sum of two eventually upper bounded functions is eventually upper bounded. (Contributed by Mario Carneiro, 26-May-2016.)
theorem lo1add {x3: setvar} (ph: wff) (A2: class) (B2 C V: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C V) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) clo1) $ >
  $ wi ph (wcel (cmpt x3 A2 C) clo1) $ >
  $ wi ph (wcel (cmpt x3 A2 (co B2 C caddc)) clo1) $;

--| The product of an eventually upper bounded function and a positive eventually upper bounded function is eventually upper bounded. (Contributed by Mario Carneiro, 26-May-2016.)
theorem lo1mul {x3: setvar} (ph: wff) (A2: class) (B2 C V: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C V) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) clo1) $ >
  $ wi ph (wcel (cmpt x3 A2 C) clo1) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wbr cc0 B2 cle) $ >
  $ wi ph (wcel (cmpt x3 A2 (co B2 C cmul)) clo1) $;

--| The product of an eventually upper bounded function and a positive eventually upper bounded function is eventually upper bounded. (Contributed by Mario Carneiro, 26-May-2016.)
theorem lo1mul2 {x3: setvar} (ph: wff) (A2: class) (B2 C V: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C V) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) clo1) $ >
  $ wi ph (wcel (cmpt x3 A2 C) clo1) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wbr cc0 B2 cle) $ >
  $ wi ph (wcel (cmpt x3 A2 (co C B2 cmul)) clo1) $;

--| If the difference of two functions is eventually bounded, eventual boundedness of either one implies the other. (Contributed by Mario Carneiro, 26-May-2016.)
theorem o1dif {x3: setvar} (ph: wff) (A2: class) (B2 C: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cc) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C cc) $ >
  $ wi ph (wcel (cmpt x3 A2 (co B2 C cmin)) co1) $ >
  $ wi ph (wb (wcel (cmpt x3 A2 B2) co1) (wcel (cmpt x3 A2 C) co1)) $;

--| The difference of an eventually upper bounded function and an eventually bounded function is eventually upper bounded. The "correct" sharp result here takes the second function to be eventually lower bounded instead of just bounded, but our notation for this is simply ` ( x e. A |-> -u C ) e. <_O(1) ` , so it is just a special case of ~ lo1add . (Contributed by Mario Carneiro, 31-May-2016.)
theorem lo1sub {x3: setvar} (ph: wff) (A2: class) (B2 C V: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C cr) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) clo1) $ >
  $ wi ph (wcel (cmpt x3 A2 C) co1) $ >
  $ wi ph (wcel (cmpt x3 A2 (co B2 C cmin)) clo1) $;

--| Limit of the sum of two converging sequences. Proposition 12-2.1(a) of [Gleason] p. 168. (Contributed by NM, 24-Sep-2005.) (Proof shortened by Mario Carneiro, 31-Jan-2014.)
theorem climadd {k: setvar} (ph: wff) (A2 B2 F G H M: class) (X: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wbr F A2 cli) $ >
  $ wi ph (wcel H X) $ >
  $ wi ph (wbr G B2 cli) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) G) cc) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) H) (co (cfv (cv k) F) (cfv (cv k) G) caddc)) $ >
  $ wi ph (wbr H (co A2 B2 caddc) cli) $;

--| Limit of the product of two converging sequences. Proposition 12-2.1(c) of [Gleason] p. 168. (Contributed by NM, 27-Dec-2005.) (Proof shortened by Mario Carneiro, 1-Feb-2014.)
theorem climmul {k: setvar} (ph: wff) (A2 B2 F G H M: class) (X: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wbr F A2 cli) $ >
  $ wi ph (wcel H X) $ >
  $ wi ph (wbr G B2 cli) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) G) cc) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) H) (co (cfv (cv k) F) (cfv (cv k) G) cmul)) $ >
  $ wi ph (wbr H (co A2 B2 cmul) cli) $;

--| Limit of the difference of two converging sequences. Proposition 12-2.1(b) of [Gleason] p. 168. (Contributed by NM, 4-Aug-2007.) (Proof shortened by Mario Carneiro, 1-Feb-2014.)
theorem climsub {k: setvar} (ph: wff) (A2 B2 F G H M: class) (X: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wbr F A2 cli) $ >
  $ wi ph (wcel H X) $ >
  $ wi ph (wbr G B2 cli) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) G) cc) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) H) (co (cfv (cv k) F) (cfv (cv k) G) cmin)) $ >
  $ wi ph (wbr H (co A2 B2 cmin) cli) $;

--| Limit of a constant ` C ` added to each term of a sequence. (Contributed by NM, 24-Sep-2005.) (Revised by Mario Carneiro, 3-Feb-2014.)
theorem climaddc1 {k: setvar} (ph: wff) (A2 C F G M: class) (W: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wbr F A2 cli) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wcel G W) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) G) (co (cfv (cv k) F) C caddc)) $ >
  $ wi ph (wbr G (co A2 C caddc) cli) $;

--| Limit of a constant ` C ` added to each term of a sequence. (Contributed by NM, 24-Sep-2005.) (Revised by Mario Carneiro, 3-Feb-2014.)
theorem climaddc2 {k: setvar} (ph: wff) (A2 C F G M: class) (W: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wbr F A2 cli) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wcel G W) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) G) (co C (cfv (cv k) F) caddc)) $ >
  $ wi ph (wbr G (co C A2 caddc) cli) $;

--| Limit of a sequence multiplied by a constant ` C ` . Corollary 12-2.2 of [Gleason] p. 171. (Contributed by NM, 24-Sep-2005.) (Revised by Mario Carneiro, 3-Feb-2014.)
theorem climmulc2 {k: setvar} (ph: wff) (A2 C F G M: class) (W: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wbr F A2 cli) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wcel G W) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) G) (co C (cfv (cv k) F) cmul)) $ >
  $ wi ph (wbr G (co C A2 cmul) cli) $;

--| Limit of a constant ` C ` subtracted from each term of a sequence. (Contributed by Mario Carneiro, 9-Feb-2014.)
theorem climsubc1 {k: setvar} (ph: wff) (A2 C F G M: class) (W: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wbr F A2 cli) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wcel G W) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) G) (co (cfv (cv k) F) C cmin)) $ >
  $ wi ph (wbr G (co A2 C cmin) cli) $;

--| Limit of a constant ` C ` minus each term of a sequence. (Contributed by NM, 24-Sep-2005.) (Revised by Mario Carneiro, 9-Feb-2014.)
theorem climsubc2 {k: setvar} (ph: wff) (A2 C F G M: class) (W: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wbr F A2 cli) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wcel G W) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) G) (co C (cfv (cv k) F) cmin)) $ >
  $ wi ph (wbr G (co C A2 cmin) cli) $;

--| Comparison of the limits of two sequences. (Contributed by Paul Chapman, 10-Sep-2007.) (Revised by Mario Carneiro, 1-Feb-2014.)
theorem climle {k: setvar} (ph: wff) (A2 B2 F G M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wbr F A2 cli) $ >
  $ wi ph (wbr G B2 cli) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cr) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) G) cr) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wbr (cfv (cv k) F) (cfv (cv k) G) cle) $ >
  $ wi ph (wbr A2 B2 cle) $;

--| Convergence of a sequence sandwiched between another converging sequence and its limit. (Contributed by NM, 6-Feb-2008.) (Revised by Mario Carneiro, 3-Feb-2014.)
theorem climsqz {k: setvar} (ph: wff) (A2 F G M: class) (W: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wbr F A2 cli) $ >
  $ wi ph (wcel G W) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cr) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) G) cr) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wbr (cfv (cv k) F) (cfv (cv k) G) cle) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wbr (cfv (cv k) G) A2 cle) $ >
  $ wi ph (wbr G A2 cli) $;

--| Convergence of a sequence sandwiched between another converging sequence and its limit. (Contributed by NM, 14-Feb-2008.) (Revised by Mario Carneiro, 3-Feb-2014.)
theorem climsqz2 {k: setvar} (ph: wff) (A2 F G M: class) (W: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wbr F A2 cli) $ >
  $ wi ph (wcel G W) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cr) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) G) cr) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wbr (cfv (cv k) G) (cfv (cv k) F) cle) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wbr A2 (cfv (cv k) G) cle) $ >
  $ wi ph (wbr G A2 cli) $;

--| Limit of the sum of two converging functions. Proposition 12-2.1(a) of [Gleason] p. 168. (Contributed by Mario Carneiro, 22-Sep-2014.)
theorem rlimadd {x3: setvar} (ph: wff) (A2: class) (B2 C: class x3) (D E: class) (V: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C V) $ >
  $ wi ph (wbr (cmpt x3 A2 B2) D crli) $ >
  $ wi ph (wbr (cmpt x3 A2 C) E crli) $ >
  $ wi ph (wbr (cmpt x3 A2 (co B2 C caddc)) (co D E caddc) crli) $;

--| Limit of the difference of two converging functions. Proposition 12-2.1(b) of [Gleason] p. 168. (Contributed by Mario Carneiro, 22-Sep-2014.)
theorem rlimsub {x3: setvar} (ph: wff) (A2: class) (B2 C: class x3) (D E: class) (V: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C V) $ >
  $ wi ph (wbr (cmpt x3 A2 B2) D crli) $ >
  $ wi ph (wbr (cmpt x3 A2 C) E crli) $ >
  $ wi ph (wbr (cmpt x3 A2 (co B2 C cmin)) (co D E cmin) crli) $;

--| Limit of the product of two converging functions. Proposition 12-2.1(c) of [Gleason] p. 168. (Contributed by Mario Carneiro, 22-Sep-2014.)
theorem rlimmul {x3: setvar} (ph: wff) (A2: class) (B2 C: class x3) (D E: class) (V: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C V) $ >
  $ wi ph (wbr (cmpt x3 A2 B2) D crli) $ >
  $ wi ph (wbr (cmpt x3 A2 C) E crli) $ >
  $ wi ph (wbr (cmpt x3 A2 (co B2 C cmul)) (co D E cmul) crli) $;

--| Limit of the quotient of two converging functions. Proposition 12-2.1(a) of [Gleason] p. 168. (Contributed by Mario Carneiro, 22-Sep-2014.)
theorem rlimdiv {x3: setvar} (ph: wff) (A2: class) (B2 C: class x3) (D E: class) (V: class x3):
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C V) $ >
  $ wi ph (wbr (cmpt x3 A2 B2) D crli) $ >
  $ wi ph (wbr (cmpt x3 A2 C) E crli) $ >
  $ wi ph (wne E cc0) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wne C cc0) $ >
  $ wi ph (wbr (cmpt x3 A2 (co B2 C cdiv)) (co D E cdiv) crli) $;

--| Limit of the negative of a sequence. (Contributed by Mario Carneiro, 18-May-2016.)
theorem rlimneg {k: setvar} (ph: wff) (A2: class) (B2: class k) (C: class) (V: class k):
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 V) $ >
  $ wi ph (wbr (cmpt k A2 B2) C crli) $ >
  $ wi ph (wbr (cmpt k A2 (cneg B2)) (cneg C) crli) $;

--| Comparison of the limits of two sequences. (Contributed by Mario Carneiro, 10-May-2016.)
theorem rlimle {x3: setvar} (ph: wff) (A2: class) (B2 C: class x3) (D E: class):
  $ wi ph (wceq (csup A2 cxr clt) cpnf) $ >
  $ wi ph (wbr (cmpt x3 A2 B2) D crli) $ >
  $ wi ph (wbr (cmpt x3 A2 C) E crli) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C cr) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wbr B2 C cle) $ >
  $ wi ph (wbr D E cle) $;

--| Lemma for ~ rlimsqz and ~ rlimsqz2 . (Contributed by Mario Carneiro, 18-Sep-2014.) (Revised by Mario Carneiro, 20-May-2016.)
theorem rlimsqzlem {x3: setvar} (ph: wff) (A2: class) (B2 C: class x3) (D E M: class):
  $ wi ph (wcel M cr) $ >
  $ wi ph (wcel E cc) $ >
  $ wi ph (wbr (cmpt x3 A2 B2) D crli) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cc) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C cc) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wbr M (cv x3) cle))) (wbr (cfv (co C E cmin) cabs) (cfv (co B2 D cmin) cabs) cle) $ >
  $ wi ph (wbr (cmpt x3 A2 C) E crli) $;

--| Convergence of a sequence sandwiched between another converging sequence and its limit. (Contributed by Mario Carneiro, 18-Sep-2014.) (Revised by Mario Carneiro, 20-May-2016.)
theorem rlimsqz {x3: setvar} (ph: wff) (A2: class) (B2 C: class x3) (D M: class):
  $ wi ph (wcel D cr) $ >
  $ wi ph (wcel M cr) $ >
  $ wi ph (wbr (cmpt x3 A2 B2) D crli) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C cr) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wbr M (cv x3) cle))) (wbr B2 C cle) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wbr M (cv x3) cle))) (wbr C D cle) $ >
  $ wi ph (wbr (cmpt x3 A2 C) D crli) $;

--| Convergence of a sequence sandwiched between another converging sequence and its limit. (Contributed by Mario Carneiro, 3-Feb-2014.) (Revised by Mario Carneiro, 20-May-2016.)
theorem rlimsqz2 {x3: setvar} (ph: wff) (A2: class) (B2 C: class x3) (D M: class):
  $ wi ph (wcel D cr) $ >
  $ wi ph (wcel M cr) $ >
  $ wi ph (wbr (cmpt x3 A2 B2) D crli) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cr) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C cr) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wbr M (cv x3) cle))) (wbr C B2 cle) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wbr M (cv x3) cle))) (wbr D C cle) $ >
  $ wi ph (wbr (cmpt x3 A2 C) D crli) $;

--| Transfer eventual upper boundedness from a larger function to a smaller function. (Contributed by Mario Carneiro, 26-May-2016.)
theorem lo1le {x3: setvar} (ph: wff) (A2: class) (B2 C: class x3) (M: class) (V: class x3):
  $ wi ph (wcel M cr) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) clo1) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C cr) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wbr M (cv x3) cle))) (wbr C B2 cle) $ >
  $ wi ph (wcel (cmpt x3 A2 C) clo1) $;

--| Transfer eventual boundedness from a larger function to a smaller function. (Contributed by Mario Carneiro, 25-Sep-2014.) (Proof shortened by Mario Carneiro, 26-May-2016.)
theorem o1le {x3: setvar} (ph: wff) (A2: class) (B2 C: class x3) (M: class) (V: class x3):
  $ wi ph (wcel M cr) $ >
  $ wi ph (wcel (cmpt x3 A2 B2) co1) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 V) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel C cc) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wbr M (cv x3) cle))) (wbr (cfv C cabs) (cfv B2 cabs) cle) $ >
  $ wi ph (wcel (cmpt x3 A2 C) co1) $;

--| A function whose inverse converges to zero is unbounded. (Contributed by Mario Carneiro, 30-May-2016.)
theorem rlimno1 {x3: setvar} (ph: wff) (A2: class) (B2: class x3):
  $ wi ph (wceq (csup A2 cxr clt) cpnf) $ >
  $ wi ph (wbr (cmpt x3 A2 (co c1 B2 cdiv)) cc0 crli) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cc) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wne B2 cc0) $ >
  $ wi ph (wn (wcel (cmpt x3 A2 B2) co1)) $;

--| The limit of an infinite series with an initial segment removed. (Contributed by Paul Chapman, 9-Feb-2008.) (Revised by Mario Carneiro, 1-Feb-2014.)
theorem clim2ser {k: setvar} (ph: wff) (A2 F M N Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel N Z) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wi ph (wbr (cseq caddc F M) A2 cli) $ >
  $ wi ph (wbr (cseq caddc F (co N c1 caddc)) (co A2 (cfv N (cseq caddc F M)) cmin) cli) $;

--| The limit of an infinite series with an initial segment added. (Contributed by Paul Chapman, 9-Feb-2008.) (Revised by Mario Carneiro, 1-Feb-2014.)
theorem clim2ser2 {k: setvar} (ph: wff) (A2 F M N Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel N Z) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wi ph (wbr (cseq caddc F (co N c1 caddc)) A2 cli) $ >
  $ wi ph (wbr (cseq caddc F M) (co A2 (cfv N (cseq caddc F M)) caddc) cli) $;

--| An infinite series converges, if and only if the series does with initial terms removed. (Contributed by Paul Chapman, 9-Feb-2008.) (Revised by Mario Carneiro, 27-Apr-2014.)
theorem iserex {k: setvar} (ph: wff) (F M N Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel N Z) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wi ph (wb (wcel (cseq caddc F M) (cdm cli)) (wcel (cseq caddc F N) (cdm cli))) $;

--| Multiplication of an infinite series by a constant. (Contributed by Paul Chapman, 14-Nov-2007.) (Revised by Mario Carneiro, 1-Feb-2014.)
theorem isermulc2 {k: setvar} (ph: wff) (A2 C F G M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wbr (cseq caddc F M) A2 cli) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) G) (co C (cfv (cv k) F) cmul)) $ >
  $ wi ph (wbr (cseq caddc G M) (co C A2 cmul) cli) $;

--| Comparison of a constant to the limit of a sequence. (Contributed by NM, 28-Feb-2008.) (Revised by Mario Carneiro, 1-Feb-2014.)
theorem climlec2 {k: setvar} (ph: wff) (A2 B2 F M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wbr F B2 cli) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cr) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wbr A2 (cfv (cv k) F) cle) $ >
  $ wi ph (wbr A2 B2 cle) $;

--| Comparison of the limits of two infinite series. (Contributed by Paul Chapman, 12-Nov-2007.) (Revised by Mario Carneiro, 3-Feb-2014.)
theorem iserle {k: setvar} (ph: wff) (A2 B2 F G M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wbr (cseq caddc F M) A2 cli) $ >
  $ wi ph (wbr (cseq caddc G M) B2 cli) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cr) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) G) cr) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wbr (cfv (cv k) F) (cfv (cv k) G) cle) $ >
  $ wi ph (wbr A2 B2 cle) $;

--| The limit of an infinite series of nonnegative reals is nonnegative. (Contributed by Paul Chapman, 9-Feb-2008.) (Revised by Mario Carneiro, 3-Feb-2014.)
theorem iserge0 {k: setvar} (ph: wff) (A2 F M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wbr (cseq caddc F M) A2 cli) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cr) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wbr cc0 (cfv (cv k) F) cle) $ >
  $ wi ph (wbr cc0 A2 cle) $;

--| The limit of a monotonic sequence is an upper bound. (Contributed by NM, 18-Mar-2005.) (Revised by Mario Carneiro, 10-Feb-2014.)
theorem climub {k: setvar} (ph: wff) (A2 F M N Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel N Z) $ >
  $ wi ph (wbr F A2 cli) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cr) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wbr (cfv (cv k) F) (cfv (co (cv k) c1 caddc) F) cle) $ >
  $ wi ph (wbr (cfv N F) A2 cle) $;

--| The partial sums of a converging infinite series with nonnegative terms are bounded by its limit. (Contributed by NM, 27-Dec-2005.) (Revised by Mario Carneiro, 9-Feb-2014.)
theorem climserle {k: setvar} (ph: wff) (A2 F M N Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel N Z) $ >
  $ wi ph (wbr (cseq caddc F M) A2 cli) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cr) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wbr cc0 (cfv (cv k) F) cle) $ >
  $ wi ph (wbr (cfv N (cseq caddc F M)) A2 cle) $;

--| Index shift of the limit of an infinite series. (Contributed by Mario Carneiro, 6-Sep-2013.) (Revised by Mario Carneiro, 5-Nov-2013.)
theorem isershft (A2 c_pl F M N: class):
  $ wcel F cvv $ >
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wbr (cseq c_pl F M) A2 cli) (wbr (cseq c_pl (co F N cshi) (co M N caddc)) A2 cli)) $;

--| Lemma for ~ isercoll . (Contributed by Mario Carneiro, 6-Apr-2015.)
theorem isercolllem1 {k: setvar} (ph: wff) (S: class k) (G M: class) (Z: class k):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wf cn Z G) $ >
  $ wi (wa ph (wcel (cv k) cn)) (wbr (cfv (cv k) G) (cfv (co (cv k) c1 caddc) G) clt) $ >
  $ wi (wa ph (wss S cn)) (wiso S (cima G S) clt clt (cres G S)) $;

--| Lemma for ~ isercoll . (Contributed by Mario Carneiro, 6-Apr-2015.)
theorem isercolllem2 {k: setvar} (ph: wff) (G M N: class) (Z: class k):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wf cn Z G) $ >
  $ wi (wa ph (wcel (cv k) cn)) (wbr (cfv (cv k) G) (cfv (co (cv k) c1 caddc) G) clt) $ >
  $ wi (wa ph (wcel N (cfv (cfv c1 G) cuz))) (wceq (co c1 (cfv (cima G (cima (ccnv G) (co M N cfz))) chash) cfz) (cima (ccnv G) (co M N cfz))) $;

--| Lemma for ~ isercoll . (Contributed by Mario Carneiro, 6-Apr-2015.)
theorem isercolllem3 {k n: setvar} (ph: wff) (F G H M N: class) (Z: class k):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wf cn Z G) $ >
  $ wi (wa ph (wcel (cv k) cn)) (wbr (cfv (cv k) G) (cfv (co (cv k) c1 caddc) G) clt) $ >
  $ wi (wa ph (wcel (cv n) (cdif Z (crn G)))) (wceq (cfv (cv n) F) cc0) $ >
  $ wi (wa ph (wcel (cv n) Z)) (wcel (cfv (cv n) F) cc) $ >
  $ wi (wa ph (wcel (cv k) cn)) (wceq (cfv (cv k) H) (cfv (cfv (cv k) G) F)) $ >
  $ wi (wa ph (wcel N (cfv (cfv c1 G) cuz))) (wceq (cfv N (cseq caddc F M)) (cfv (cfv (cima G (cima (ccnv G) (co M N cfz))) chash) (cseq caddc H c1))) $;

--| Rearrange an infinite series by spacing out the terms using an order isomorphism. (Contributed by Mario Carneiro, 6-Apr-2015.)
theorem isercoll {k n: setvar} (ph: wff) (A2 F G H M: class) (Z: class k):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wf cn Z G) $ >
  $ wi (wa ph (wcel (cv k) cn)) (wbr (cfv (cv k) G) (cfv (co (cv k) c1 caddc) G) clt) $ >
  $ wi (wa ph (wcel (cv n) (cdif Z (crn G)))) (wceq (cfv (cv n) F) cc0) $ >
  $ wi (wa ph (wcel (cv n) Z)) (wcel (cfv (cv n) F) cc) $ >
  $ wi (wa ph (wcel (cv k) cn)) (wceq (cfv (cv k) H) (cfv (cfv (cv k) G) F)) $ >
  $ wi ph (wb (wbr (cseq caddc H c1) A2 cli) (wbr (cseq caddc F M) A2 cli)) $;

--| Generalize ~ isercoll so that both sequences have arbitrary starting point. (Contributed by Mario Carneiro, 6-Apr-2015.)
theorem isercoll2 {k n: setvar} (ph: wff) (A2 F G H M: class) (N W: class k) (Z: class n):
  $ wceq Z (cfv M cuz) $ >
  $ wceq W (cfv N cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wf Z W G) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wbr (cfv (cv k) G) (cfv (co (cv k) c1 caddc) G) clt) $ >
  $ wi (wa ph (wcel (cv n) (cdif W (crn G)))) (wceq (cfv (cv n) F) cc0) $ >
  $ wi (wa ph (wcel (cv n) W)) (wcel (cfv (cv n) F) cc) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) H) (cfv (cfv (cv k) G) F)) $ >
  $ wi ph (wb (wbr (cseq caddc H M) A2 cli) (wbr (cseq caddc F N) A2 cli)) $;

--| A bounded monotonic sequence converges to the supremum of its range. Theorem 12-5.1 of [Gleason] p. 180. (Contributed by NM, 13-Mar-2005.) (Revised by Mario Carneiro, 10-Feb-2014.)
theorem climsup {x3 k: setvar} (ph: wff x3) (F: class) (M: class x3 k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wf Z cr F) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wbr (cfv (cv k) F) (cfv (co (cv k) c1 caddc) F) cle) $ >
  $ wi ph (wrex x3 (wral k (wbr (cfv (cv k) F) (cv x3) cle) Z) cr) $ >
  $ wi ph (wbr F (csup (crn F) cr clt) cli) $;

--| A converging sequence of complex numbers is a Cauchy sequence. Theorem 12-5.3 of [Gleason] p. 180 (necessity part). (Contributed by NM, 16-Apr-2005.) (Revised by Mario Carneiro, 26-Apr-2014.)
theorem climcau {x3 j k: setvar} (F M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi (wa (wcel M cz) (wcel F (cdm cli))) (wral x3 (wrex j (wral k (wbr (cfv (co (cfv (cv k) F) (cfv (cv j) F) cmin) cabs) (cv x3) clt) (cfv (cv j) cuz)) Z) crp) $;

--| A converging sequence of complex numbers is bounded. (Contributed by Mario Carneiro, 9-Jul-2017.)
theorem climbdd {x3 k: setvar} (F M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi (w3a (wcel M cz) (wcel F (cdm cli)) (wral k (wcel (cfv (cv k) F) cc) Z)) (wrex x3 (wral k (wbr (cfv (cfv (cv k) F) cabs) (cv x3) cle) Z) cr) $;

--| Lemma for ~ caurcvgr . (Contributed by Mario Carneiro, 15-Feb-2014.) (Revised by AV, 12-Sep-2020.)
theorem caucvgrlem {x3 j k: setvar} (ph: wff) (A2 R F: class):
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wf A2 cr F) $ >
  $ wi ph (wceq (csup A2 cxr clt) cpnf) $ >
  $ wi ph (wral x3 (wrex j (wral k (wi (wbr (cv j) (cv k) cle) (wbr (cfv (co (cfv (cv k) F) (cfv (cv j) F) cmin) cabs) (cv x3) clt)) A2) A2) crp) $ >
  $ wi ph (wcel R crp) $ >
  $ wi ph (wrex j (wa (wcel (cfv F clsp) cr) (wral k (wi (wbr (cv j) (cv k) cle) (wbr (cfv (co (cfv (cv k) F) (cfv F clsp) cmin) cabs) (co c3 R cmul) clt)) A2)) A2) $;

--| A Cauchy sequence of real numbers converges to its limit supremum. The third hypothesis specifies that ` F ` is a Cauchy sequence. (Contributed by Mario Carneiro, 7-May-2016.) (Revised by AV, 12-Sep-2020.)
theorem caurcvgr {x3 j k: setvar} (ph: wff) (A2 F: class):
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wf A2 cr F) $ >
  $ wi ph (wceq (csup A2 cxr clt) cpnf) $ >
  $ wi ph (wral x3 (wrex j (wral k (wi (wbr (cv j) (cv k) cle) (wbr (cfv (co (cfv (cv k) F) (cfv (cv j) F) cmin) cabs) (cv x3) clt)) A2) A2) crp) $ >
  $ wi ph (wbr F (cfv F clsp) crli) $;

--| Lemma for ~ caucvgr . (Contributed by NM, 4-Apr-2005.) (Proof shortened by Mario Carneiro, 8-May-2016.)
theorem caucvgrlem2 {x3 j k n: setvar} (ph: wff) (A2 F H: class):
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wf A2 cc F) $ >
  $ wi ph (wceq (csup A2 cxr clt) cpnf) $ >
  $ wi ph (wral x3 (wrex j (wral k (wi (wbr (cv j) (cv k) cle) (wbr (cfv (co (cfv (cv k) F) (cfv (cv j) F) cmin) cabs) (cv x3) clt)) A2) A2) crp) $ >
  $ wf cc cr H $ >
  $ wi (wa (wcel (cfv (cv k) F) cc) (wcel (cfv (cv j) F) cc)) (wbr (cfv (co (cfv (cfv (cv k) F) H) (cfv (cfv (cv j) F) H) cmin) cabs) (cfv (co (cfv (cv k) F) (cfv (cv j) F) cmin) cabs) cle) $ >
  $ wi ph (wbr (cmpt n A2 (cfv (cfv (cv n) F) H)) (cfv (ccom H F) crli) crli) $;

--| A Cauchy sequence of complex numbers converges to a complex number. Theorem 12-5.3 of [Gleason] p. 180 (sufficiency part). (Contributed by NM, 20-Dec-2006.) (Revised by Mario Carneiro, 8-May-2016.)
theorem caucvgr {x3 j k: setvar} (ph: wff) (A2 F: class):
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wf A2 cc F) $ >
  $ wi ph (wceq (csup A2 cxr clt) cpnf) $ >
  $ wi ph (wral x3 (wrex j (wral k (wi (wbr (cv j) (cv k) cle) (wbr (cfv (co (cfv (cv k) F) (cfv (cv j) F) cmin) cabs) (cv x3) clt)) A2) A2) crp) $ >
  $ wi ph (wcel F (cdm crli)) $;

--| A Cauchy sequence of real numbers converges to its limit supremum. The fourth hypothesis specifies that ` F ` is a Cauchy sequence. (Contributed by NM, 4-Apr-2005.) (Revised by AV, 12-Sep-2020.)
theorem caurcvg {x3 k m: setvar} (ph: wff) (F: class) (M: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wf Z cr F) $ >
  $ wi ph (wral x3 (wrex m (wral k (wbr (cfv (co (cfv (cv k) F) (cfv (cv m) F) cmin) cabs) (cv x3) clt) (cfv (cv m) cuz)) Z) crp) $ >
  $ wi ph (wbr F (cfv F clsp) cli) $;

--| A Cauchy sequence of real numbers converges, existence version. (Contributed by NM, 4-Apr-2005.) (Revised by Mario Carneiro, 7-Sep-2014.)
theorem caurcvg2 {x3 j k: setvar} (ph: wff) (F M: class) (V: class x3 j k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel F V) $ >
  $ wi ph (wral x3 (wrex j (wral k (wa (wcel (cfv (cv k) F) cr) (wbr (cfv (co (cfv (cv k) F) (cfv (cv j) F) cmin) cabs) (cv x3) clt)) (cfv (cv j) cuz)) Z) crp) $ >
  $ wi ph (wcel F (cdm cli)) $;

--| A Cauchy sequence of complex numbers converges to a complex number. Theorem 12-5.3 of [Gleason] p. 180 (sufficiency part). (Contributed by NM, 20-Dec-2006.) (Proof shortened by Mario Carneiro, 15-Feb-2014.) (Revised by Mario Carneiro, 8-May-2016.)
theorem caucvg {x3 j k: setvar} (ph: wff) (F M: class) (V: class x3 j k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wi ph (wral x3 (wrex j (wral k (wbr (cfv (co (cfv (cv k) F) (cfv (cv j) F) cmin) cabs) (cv x3) clt) (cfv (cv j) cuz)) Z) crp) $ >
  $ wi ph (wcel F V) $ >
  $ wi ph (wcel F (cdm cli)) $;

--| A function is convergent if and only if it is Cauchy. Theorem 12-5.3 of [Gleason] p. 180. (Contributed by Mario Carneiro, 15-Feb-2014.)
theorem caucvgb {x3 j k: setvar} (F M: class) (V: class x3 j) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi (wa (wcel M cz) (wcel F V)) (wb (wcel F (cdm cli)) (wral x3 (wrex j (wral k (wa (wcel (cfv (cv k) F) cc) (wbr (cfv (co (cfv (cv k) F) (cfv (cv j) F) cmin) cabs) (cv x3) clt)) (cfv (cv j) cuz)) Z) crp)) $;

--| If an infinite series converges, its underlying sequence converges to zero. (Contributed by NM, 2-Sep-2005.) (Revised by Mario Carneiro, 16-Feb-2014.)
theorem serf0 {k: setvar} (ph: wff) (F M V Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel F V) $ >
  $ wi ph (wcel (cseq caddc F M) (cdm cli)) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wi ph (wbr F cc0 cli) $;

--| Lemma for ~ iseralt . A decreasing sequence with limit zero consists of positive terms. (Contributed by Mario Carneiro, 6-Apr-2015.)
theorem iseraltlem1 {k: setvar} (ph: wff) (G M N Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wf Z cr G) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wbr (cfv (co (cv k) c1 caddc) G) (cfv (cv k) G) cle) $ >
  $ wi ph (wbr G cc0 cli) $ >
  $ wi (wa ph (wcel N Z)) (wbr cc0 (cfv N G) cle) $;

--| Lemma for ~ iseralt . The terms of an alternating series form a chain of inequalities in alternate terms, so that for example ` S ( 1 ) <_ S ( 3 ) <_ S ( 5 ) <_ ... ` and ` ... <_ S ( 4 ) <_ S ( 2 ) <_ S ( 0 ) ` (assuming ` M = 0 ` so that these terms are defined). (Contributed by Mario Carneiro, 6-Apr-2015.)
theorem iseraltlem2 {k: setvar} (ph: wff) (F G K M N Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wf Z cr G) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wbr (cfv (co (cv k) c1 caddc) G) (cfv (cv k) G) cle) $ >
  $ wi ph (wbr G cc0 cli) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) (co (co (cneg c1) (cv k) cexp) (cfv (cv k) G) cmul)) $ >
  $ wi (w3a ph (wcel N Z) (wcel K cn0)) (wbr (co (co (cneg c1) N cexp) (cfv (co N (co c2 K cmul) caddc) (cseq caddc F M)) cmul) (co (co (cneg c1) N cexp) (cfv N (cseq caddc F M)) cmul) cle) $;

--| Lemma for ~ iseralt . From ~ iseraltlem2 , we have ` ( -u 1 ^ n ) x. S ( n + 2 k ) <_ ( -u 1 ^ n ) x. S ( n ) ` and ` ( -u 1 ^ n ) x. S ( n + 1 ) <_ ( -u 1 ^ n ) x. S ( n + 2 k + 1 ) ` , and we also have ` ( -u 1 ^ n ) x. S ( n + 1 ) = ` ` ( -u 1 ^ n ) x. S ( n ) - G ( n + 1 ) ` for each ` n ` by the definition of the partial sum ` S ` , so combining the inequalities we get ` ( -u 1 ^ n ) x. S ( n ) - G ( n + 1 ) = ` ` ( -u 1 ^ n ) x. S ( n + 1 ) <_ ` ` ( -u 1 ^ n ) x. S ( n + 2 k + 1 ) = ` ` ( -u 1 ^ n ) x. S ( n + 2 k ) - G ( n + 2 k + 1 ) <_ ` ` ( -u 1 ^ n ) x. S ( n + 2 k ) <_ ( -u 1 ^ n ) x. S ( n ) <_ ` ` ( -u 1 ^ n ) x. S ( n ) + G ( n + 1 ) ` , so ` | ( -u 1 ^ n ) x. S ( n + 2 k + 1 ) - ( -u 1 ^ n ) x. S ( n ) | = ` ` | S ( n + 2 k + 1 ) - S ( n ) | <_ G ( n + 1 ) ` and ` | ( -u 1 ^ n ) x. S ( n + 2 k ) - ( -u 1 ^ n ) x. S ( n ) | = ` ` | S ( n + 2 k ) - S ( n ) | <_ G ( n + 1 ) ` . Thus, both even and odd partial sums are Cauchy if ` G ` converges to ` 0 ` . (Contributed by Mario Carneiro, 6-Apr-2015.)
theorem iseraltlem3 {k: setvar} (ph: wff) (F G K M N Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wf Z cr G) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wbr (cfv (co (cv k) c1 caddc) G) (cfv (cv k) G) cle) $ >
  $ wi ph (wbr G cc0 cli) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) (co (co (cneg c1) (cv k) cexp) (cfv (cv k) G) cmul)) $ >
  $ wi (w3a ph (wcel N Z) (wcel K cn0)) (wa (wbr (cfv (co (cfv (co N (co c2 K cmul) caddc) (cseq caddc F M)) (cfv N (cseq caddc F M)) cmin) cabs) (cfv (co N c1 caddc) G) cle) (wbr (cfv (co (cfv (co (co N (co c2 K cmul) caddc) c1 caddc) (cseq caddc F M)) (cfv N (cseq caddc F M)) cmin) cabs) (cfv (co N c1 caddc) G) cle)) $;

--| The alternating series test. If ` G ( k ) ` is a decreasing sequence that converges to ` 0 ` , then ` sum_ k e. Z ( -u 1 ^ k ) x. G ( k ) ` is a convergent series. (Note that the first term is positive if ` M ` is even, and negative if ` M ` is odd. If the parity of your series does not match up with this, you will need to post-compose the series with multiplication by ` -u 1 ` using ~ isermulc2 .) (Contributed by Mario Carneiro, 7-Apr-2015.) (Proof shortened by AV, 9-Jul-2022.)
theorem iseralt {k: setvar} (ph: wff) (F G M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wf Z cr G) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wbr (cfv (co (cv k) c1 caddc) G) (cfv (cv k) G) cle) $ >
  $ wi ph (wbr G cc0 cli) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) (co (co (cneg c1) (cv k) cexp) (cfv (cv k) G) cmul)) $ >
  $ wi ph (wcel (cseq caddc F M) (cdm cli)) $;

--| Extend class notation to include finite and infinite summations. (An underscore was added to the ASCII token in order to facilitate set.mm text searches, since "sum" is a commonly used word in comments.)
term csu {k: setvar} (A2: class) (B2: class k): class;

--| Define the sum of a series with an index set of integers ` A ` . The variable ` k ` is normally a free variable in ` B ` , i.e., ` B ` can be thought of as ` B ( k ) ` . This definition is the result of a collection of discussions over the most general definition for a sum that does not need the index set to have a specified ordering. This definition is in two parts, one for finite sums and one for subsets of the upper integers. When summing over a subset of the upper integers, we extend the index set to the upper integers by adding zero outside the domain, and then sum the set in order, setting the result to the limit of the partial sums, if it exists. This means that conditionally convergent sums can be evaluated meaningfully. For finite sums, we are explicitly order-independent, by picking any bijection to a 1-based finite sequence and summing in the induced order. These two methods of summation produce the same result on their common region of definition (i.e., finite sets of integers) by ~ summo . Examples: ` sum_ k e. { 1 , 2 , 4 } k ` means ` 1 + 2 + 4 = 7 ` , and ` sum_ k e. NN ( 1 / ( 2 ^ k ) ) = 1 ` means 1/2 + 1/4 + 1/8 + ... = 1 ( ~ geoihalfsum ). (Contributed by NM, 11-Dec-2005.) (Revised by Mario Carneiro, 13-Jun-2019.)
axiom df_sum {x3 f2 k m n: setvar} (A2 B2: class k):
  $ wceq (csu k A2 B2) (cio x3 (wo (wrex m (wa (wss A2 (cfv (cv m) cuz)) (wbr (cseq caddc (cmpt n cz (cif (wcel (cv n) A2) (csb k (cv n) B2) cc0)) (cv m)) (cv x3) cli)) cz) (wrex m (wex f2 (wa (wf1o (co c1 (cv m) cfz) A2 (cv f2)) (wceq (cv x3) (cfv (cv m) (cseq caddc (cmpt n cn (csb k (cfv (cv n) (cv f2)) B2)) c1))))) cn))) $;

--| A sum is a set. (Contributed by NM, 11-Dec-2005.) (Revised by Mario Carneiro, 13-Jun-2019.)
theorem sumex {k: setvar} (A2 B2: class k):
  $ wcel (csu k A2 B2) cvv $;

--| Equality theorem for a sum. (Contributed by NM, 11-Dec-2005.) (Revised by Mario Carneiro, 13-Jun-2019.)
theorem sumeq1 {k: setvar} (A2 B2 C: class k):
  $ wi (wceq A2 B2) (wceq (csu k A2 C) (csu k B2 C)) $;

--| Bound-variable hypothesis builder for sum. (Contributed by NM, 11-Dec-2005.) (Revised by Mario Carneiro, 13-Jun-2019.)
theorem nfsum1 {k: setvar} (A2 B2: class k):
  $ wnfc k A2 $ >
  $ wnfc k (csu k A2 B2) $;

--| Bound-variable hypothesis builder for sum: if ` x ` is (effectively) not free in ` A ` and ` B ` , it is not free in ` sum_ k e. A B ` . Version of ~ nfsum with a disjoint variable condition, which does not require ~ ax-13 . (Contributed by NM, 11-Dec-2005.) (Revised by GG, 24-Feb-2024.)
theorem nfsum {x3 k: setvar} (A2 B2: class x3 k):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 (csu k A2 B2) $;

--| Equality theorem for sum, when the class expressions ` B ` and ` C ` are equal everywhere. Proved using only Extensionality. (Contributed by Mario Carneiro, 24-Jun-2014.) (Revised by Mario Carneiro, 13-Jun-2019.)
theorem sumeq2w {k: setvar} (A2 B2 C: class k):
  $ wi (wal k (wceq B2 C)) (wceq (csu k A2 B2) (csu k A2 C)) $;

--| Equality theorem for sum, with the class expressions ` B ` and ` C ` guarded by ` _I ` to be always sets. (Contributed by Mario Carneiro, 13-Jun-2019.)
theorem sumeq2ii {k: setvar} (A2: class) (B2 C: class k):
  $ wi (wral k (wceq (cfv B2 cid) (cfv C cid)) A2) (wceq (csu k A2 B2) (csu k A2 C)) $;

--| Equality theorem for sum. (Contributed by NM, 11-Dec-2005.) (Revised by Mario Carneiro, 13-Jul-2013.)
theorem sumeq2 {k: setvar} (A2: class) (B2 C: class k):
  $ wi (wral k (wceq B2 C) A2) (wceq (csu k A2 B2) (csu k A2 C)) $;

--| Change bound variable in a sum. (Contributed by NM, 11-Dec-2005.) (Revised by Mario Carneiro, 13-Jun-2019.)
theorem cbvsum {j k: setvar} (A2 B2 C: class j k):
  $ wi (wceq (cv j) (cv k)) (wceq B2 C) $ >
  $ wnfc k B2 $ >
  $ wnfc j C $ >
  $ wceq (csu j A2 B2) (csu k A2 C) $;

--| Change bound variable in a sum. (Contributed by NM, 11-Dec-2005.) (Revised by Mario Carneiro, 13-Jul-2013.)
theorem cbvsumv {j k: setvar} (A2: class j k) (B2: class j) (C: class k):
  $ wi (wceq (cv j) (cv k)) (wceq B2 C) $ >
  $ wceq (csu j A2 B2) (csu k A2 C) $;

--| Equality inference for sum. (Contributed by NM, 2-Jan-2006.)
theorem sumeq1i {k: setvar} (A2 B2 C: class k):
  $ wceq A2 B2 $ >
  $ wceq (csu k A2 C) (csu k B2 C) $;

--| Equality inference for sum. (Contributed by NM, 3-Dec-2005.)
theorem sumeq2i {k: setvar} (A2: class) (B2 C: class k):
  $ wi (wcel (cv k) A2) (wceq B2 C) $ >
  $ wceq (csu k A2 B2) (csu k A2 C) $;

--| Equality inference for sum. (Contributed by FL, 10-Dec-2006.)
theorem sumeq12i {k: setvar} (A2 B2: class) (C D: class k):
  $ wceq A2 B2 $ >
  $ wi (wcel (cv k) A2) (wceq C D) $ >
  $ wceq (csu k A2 C) (csu k B2 D) $;

--| Equality deduction for sum. (Contributed by NM, 1-Nov-2005.)
theorem sumeq1d {k: setvar} (ph: wff k) (A2 B2 C: class k):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (csu k A2 C) (csu k B2 C)) $;

--| Equality deduction for sum. Note that unlike ~ sumeq2dv , ` k ` may occur in ` ph ` . (Contributed by NM, 1-Nov-2005.)
theorem sumeq2d {k: setvar} (ph: wff k) (A2: class) (B2 C: class k):
  $ wi ph (wral k (wceq B2 C) A2) $ >
  $ wi ph (wceq (csu k A2 B2) (csu k A2 C)) $;

--| Equality deduction for sum. (Contributed by NM, 3-Jan-2006.) (Revised by Mario Carneiro, 31-Jan-2014.)
theorem sumeq2dv {k: setvar} (ph: wff) (A2: class) (B2 C: class k):
  $ wi (wa ph (wcel (cv k) A2)) (wceq B2 C) $ >
  $ wi ph (wceq (csu k A2 B2) (csu k A2 C)) $;

--| Equality deduction for sum. (Contributed by NM, 3-Jan-2006.) (Proof shortened by Glauco Siliprandi, 5-Apr-2020.) Avoid axioms. (Revised by GG, 14-Aug-2025.)
theorem sumeq2sdv {k: setvar} (ph: wff) (A2 B2 C: class k):
  $ wi ph (wceq B2 C) $ >
  $ wi ph (wceq (csu k A2 B2) (csu k A2 C)) $;

--| Equality deduction for double sum. (Contributed by NM, 3-Jan-2006.) (Revised by Mario Carneiro, 31-Jan-2014.)
theorem _2sumeq2dv {j k: setvar} (ph: wff) (A2: class) (B2: class j) (C D: class j k):
  $ wi (w3a ph (wcel (cv j) A2) (wcel (cv k) B2)) (wceq C D) $ >
  $ wi ph (wceq (csu j A2 (csu k B2 C)) (csu j A2 (csu k B2 D))) $;

--| Equality deduction for sum. (Contributed by NM, 1-Dec-2005.)
theorem sumeq12dv {k: setvar} (ph: wff) (A2 B2: class) (C D: class k):
  $ wi ph (wceq A2 B2) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wceq C D) $ >
  $ wi ph (wceq (csu k A2 C) (csu k B2 D)) $;

--| Equality deduction for sum. (Contributed by NM, 1-Dec-2005.)
theorem sumeq12rdv {k: setvar} (ph: wff) (A2 B2: class) (C D: class k):
  $ wi ph (wceq A2 B2) $ >
  $ wi (wa ph (wcel (cv k) B2)) (wceq C D) $ >
  $ wi ph (wceq (csu k A2 C) (csu k B2 D)) $;

--| The second class argument to a sum can be chosen so that it is always a set. (Contributed by NM, 11-Dec-2005.) (Revised by Mario Carneiro, 13-Jul-2013.)
theorem sum2id {k: setvar} (A2: class) (B2: class k):
  $ wceq (csu k A2 B2) (csu k A2 (cfv B2 cid)) $;

--| A lemma to facilitate conversions from the function form to the class-variable form of a sum. (Contributed by Mario Carneiro, 12-Aug-2013.) (Revised by Mario Carneiro, 23-Apr-2014.)
theorem sumfc {j k: setvar} (A2: class) (B2: class k):
  $ wceq (csu j A2 (cfv (cv j) (cmpt k A2 B2))) (csu k A2 B2) $;

--| A lemma for working with finite sums. (Contributed by Mario Carneiro, 22-Apr-2014.)
theorem fz1f1o {f2: setvar} (A2: class):
  $ wi (wcel A2 cfn) (wo (wceq A2 c0) (wa (wcel (cfv A2 chash) cn) (wex f2 (wf1o (co c1 (cfv A2 chash) cfz) A2 (cv f2))))) $;

--| Lemma for ~ sumrb . (Contributed by Mario Carneiro, 12-Aug-2013.)
theorem sumrblem {k: setvar} (ph: wff) (A2: class) (B2: class k) (F M N: class):
  $ wceq F (cmpt k cz (cif (wcel (cv k) A2) B2 cc0)) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wss A2 (cfv N cuz))) (wceq (cres (cseq caddc F M) (cfv N cuz)) (cseq caddc F N)) $;

--| The sequence of partial sums of a finite sum converges to the whole sum. (Contributed by Mario Carneiro, 20-Apr-2014.)
theorem fsumcvg {k: setvar} (ph: wff) (A2: class) (B2: class k) (F M N: class):
  $ wceq F (cmpt k cz (cif (wcel (cv k) A2) B2 cc0)) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi ph (wss A2 (co M N cfz)) $ >
  $ wi ph (wbr (cseq caddc F M) (cfv N (cseq caddc F M)) cli) $;

--| Rebase the starting point of a sum. (Contributed by Mario Carneiro, 14-Jul-2013.) (Revised by Mario Carneiro, 9-Apr-2014.)
theorem sumrb {k: setvar} (ph: wff) (A2: class) (B2 C: class k) (F M N: class):
  $ wceq F (cmpt k cz (cif (wcel (cv k) A2) B2 cc0)) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wss A2 (cfv M cuz)) $ >
  $ wi ph (wss A2 (cfv N cuz)) $ >
  $ wi ph (wb (wbr (cseq caddc F M) C cli) (wbr (cseq caddc F N) C cli)) $;

--| Lemma for ~ summo . (Contributed by Mario Carneiro, 29-Mar-2014.)
theorem summolem3 {f2 k n: setvar} (ph: wff f2) (A2: class) (B2: class k) (F: class) (G: class f2) (H: class f2 k n) (K M N: class f2):
  $ wceq F (cmpt k cz (cif (wcel (cv k) A2) B2 cc0)) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wceq G (cmpt n cn (csb k (cfv (cv n) (cv f2)) B2)) $ >
  $ wceq H (cmpt n cn (csb k (cfv (cv n) K) B2)) $ >
  $ wi ph (wa (wcel M cn) (wcel N cn)) $ >
  $ wi ph (wf1o (co c1 M cfz) A2 (cv f2)) $ >
  $ wi ph (wf1o (co c1 N cfz) A2 K) $ >
  $ wi ph (wceq (cfv M (cseq caddc G c1)) (cfv N (cseq caddc H c1))) $;

--| Lemma for ~ summo . (Contributed by Mario Carneiro, 3-Apr-2014.) (Revised by Mario Carneiro, 20-Apr-2014.)
theorem summolem2a {f2 k n: setvar} (ph: wff f2) (A2: class) (B2: class k) (F: class) (G: class f2) (H: class f2 k n) (K M N: class f2):
  $ wceq F (cmpt k cz (cif (wcel (cv k) A2) B2 cc0)) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wceq G (cmpt n cn (csb k (cfv (cv n) (cv f2)) B2)) $ >
  $ wceq H (cmpt n cn (csb k (cfv (cv n) K) B2)) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wss A2 (cfv M cuz)) $ >
  $ wi ph (wf1o (co c1 N cfz) A2 (cv f2)) $ >
  $ wi ph (wiso (co c1 (cfv A2 chash) cfz) A2 clt clt K) $ >
  $ wi ph (wbr (cseq caddc F M) (cfv N (cseq caddc G c1)) cli) $;

--| Lemma for ~ summo . (Contributed by Mario Carneiro, 3-Apr-2014.)
theorem summolem2 {f2 k m n: setvar} (ph: wff) (x3 y1: setvar) (A2: class) (B2: class k) (F: class) (G: class f2):
  $ wceq F (cmpt k cz (cif (wcel (cv k) A2) B2 cc0)) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wceq G (cmpt n cn (csb k (cfv (cv n) (cv f2)) B2)) $ >
  $ wi (wa ph (wrex m (wa (wss A2 (cfv (cv m) cuz)) (wbr (cseq caddc F (cv m)) (cv x3) cli)) cz)) (wi (wrex m (wex f2 (wa (wf1o (co c1 (cv m) cfz) A2 (cv f2)) (wceq (cv y1) (cfv (cv m) (cseq caddc G c1))))) cn) (wceq (cv x3) (cv y1))) $;

--| A sum has at most one limit. (Contributed by Mario Carneiro, 3-Apr-2014.) (Revised by Mario Carneiro, 23-Aug-2014.)
theorem summo {x3 f2 k m n: setvar} (ph: wff) (A2: class) (B2: class k) (F: class) (G: class f2):
  $ wceq F (cmpt k cz (cif (wcel (cv k) A2) B2 cc0)) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wceq G (cmpt n cn (csb k (cfv (cv n) (cv f2)) B2)) $ >
  $ wi ph (wmo x3 (wo (wrex m (wa (wss A2 (cfv (cv m) cuz)) (wbr (cseq caddc F (cv m)) (cv x3) cli)) cz) (wrex m (wex f2 (wa (wf1o (co c1 (cv m) cfz) A2 (cv f2)) (wceq (cv x3) (cfv (cv m) (cseq caddc G c1))))) cn))) $;

--| Series sum with index set a subset of the upper integers. (Contributed by Mario Carneiro, 13-Jun-2019.)
theorem zsum {k: setvar} (ph: wff) (A2: class) (B2: class k) (F M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wss A2 Z) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) (cif (wcel (cv k) A2) B2 cc0)) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi ph (wceq (csu k A2 B2) (cfv (cseq caddc F M) cli)) $;

--| Series sum with an upper integer index set (i.e. an infinite series). (Contributed by Mario Carneiro, 15-Jul-2013.) (Revised by Mario Carneiro, 7-Apr-2014.)
theorem isum {k: setvar} (ph: wff) (B2: class k) (F M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) B2) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel B2 cc) $ >
  $ wi ph (wceq (csu k Z B2) (cfv (cseq caddc F M) cli)) $;

--| The value of a sum over a nonempty finite set. (Contributed by Mario Carneiro, 20-Apr-2014.) (Revised by Mario Carneiro, 13-Jun-2019.)
theorem fsum {k n: setvar} (ph: wff) (A2: class) (B2: class k) (C: class n) (F G M: class):
  $ wi (wceq (cv k) (cfv (cv n) F)) (wceq B2 C) $ >
  $ wi ph (wcel M cn) $ >
  $ wi ph (wf1o (co c1 M cfz) A2 F) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi (wa ph (wcel (cv n) (co c1 M cfz))) (wceq (cfv (cv n) G) C) $ >
  $ wi ph (wceq (csu k A2 B2) (cfv M (cseq caddc G c1))) $;

--| Any sum over the empty set is zero. (Contributed by Mario Carneiro, 12-Aug-2013.) (Revised by Mario Carneiro, 20-Apr-2014.)
theorem sum0 {k: setvar} (A2: class k):
  $ wceq (csu k c0 A2) cc0 $;

--| Any sum of zero over a summable set is zero. (Contributed by Mario Carneiro, 12-Aug-2013.) (Revised by Mario Carneiro, 20-Apr-2014.)
theorem sumz {k: setvar} (A2 M: class):
  $ wi (wo (wss A2 (cfv M cuz)) (wcel A2 cfn)) (wceq (csu k A2 cc0) cc0) $;

--| Re-index a finite sum using a bijection. (Contributed by Mario Carneiro, 20-Apr-2014.)
theorem fsumf1o {k n: setvar} (ph: wff) (A2: class) (B2 C: class k) (D: class n) (F: class k) (G: class n):
  $ wi (wceq (cv k) G) (wceq B2 D) $ >
  $ wi ph (wcel C cfn) $ >
  $ wi ph (wf1o C A2 F) $ >
  $ wi (wa ph (wcel (cv n) C)) (wceq (cfv (cv n) F) G) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi ph (wceq (csu k A2 B2) (csu n C D)) $;

--| Change the index set to a subset in an upper integer sum. (Contributed by Mario Carneiro, 21-Apr-2014.)
theorem sumss {k: setvar} (ph: wff) (A2 B2: class) (C: class k) (M: class):
  $ wi ph (wss A2 B2) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel C cc) $ >
  $ wi (wa ph (wcel (cv k) (cdif B2 A2))) (wceq C cc0) $ >
  $ wi ph (wss B2 (cfv M cuz)) $ >
  $ wi ph (wceq (csu k A2 C) (csu k B2 C)) $;

--| Change the index set to a subset in a finite sum. (Contributed by Mario Carneiro, 21-Apr-2014.)
theorem fsumss {k: setvar} (ph: wff) (A2 B2: class) (C: class k):
  $ wi ph (wss A2 B2) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel C cc) $ >
  $ wi (wa ph (wcel (cv k) (cdif B2 A2))) (wceq C cc0) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wceq (csu k A2 C) (csu k B2 C)) $;

--| Change the index set of a sum by adding zeroes. (Contributed by Mario Carneiro, 15-Jul-2013.) (Revised by Mario Carneiro, 20-Apr-2014.)
theorem sumss2 {k: setvar} (A2 B2: class) (C M: class k):
  $ wi (wa (wa (wss A2 B2) (wral k (wcel C cc) A2)) (wo (wss B2 (cfv M cuz)) (wcel B2 cfn))) (wceq (csu k A2 C) (csu k B2 (cif (wcel (cv k) A2) C cc0))) $;

--| The sequence of partial sums of a finite sum converges to the whole sum. (Contributed by Mario Carneiro, 20-Apr-2014.)
theorem fsumcvg2 {k: setvar} (ph: wff) (A2: class) (B2: class k) (F M N: class):
  $ wi (wa ph (wcel (cv k) (cfv M cuz))) (wceq (cfv (cv k) F) (cif (wcel (cv k) A2) B2 cc0)) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi ph (wss A2 (co M N cfz)) $ >
  $ wi ph (wbr (cseq caddc F M) (cfv N (cseq caddc F M)) cli) $;

--| Special case of series sum over a finite upper integer index set. (Contributed by Mario Carneiro, 26-Jul-2013.) (Revised by Mario Carneiro, 21-Apr-2014.)
theorem fsumsers {k: setvar} (ph: wff) (A2: class) (B2: class k) (F M N: class):
  $ wi (wa ph (wcel (cv k) (cfv M cuz))) (wceq (cfv (cv k) F) (cif (wcel (cv k) A2) B2 cc0)) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi ph (wss A2 (co M N cfz)) $ >
  $ wi ph (wceq (csu k A2 B2) (cfv N (cseq caddc F M))) $;

--| A finite sum is convergent. (Contributed by Mario Carneiro, 24-Apr-2014.)
theorem fsumcvg3 {k: setvar} (ph: wff) (A2: class) (B2: class k) (F M: class) (Z: class k):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wss A2 Z) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) (cif (wcel (cv k) A2) B2 cc0)) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi ph (wcel (cseq caddc F M) (cdm cli)) $;

--| A finite sum expressed in terms of a partial sum of an infinite series. The recursive definition follows as ~ fsum1 and ~ fsump1i , which should make our notation clear and from which, along with closure ~ fsumcl , we will derive the basic properties of finite sums. (Contributed by NM, 11-Dec-2005.) (Revised by Mario Carneiro, 21-Apr-2014.)
theorem fsumser {k: setvar} (ph: wff) (A2: class k) (F M N: class):
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wceq (cfv (cv k) F) A2) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel A2 cc) $ >
  $ wi ph (wceq (csu k (co M N cfz) A2) (cfv N (cseq caddc F M))) $;

--| - Lemma for finite sum closures. (The "-" before "Lemma" forces the math content to be displayed in the Statement List - NM 11-Feb-2008.) (Contributed by Mario Carneiro, 3-Jun-2014.)
theorem fsumcl2lem {x3 y1 k: setvar} (ph: wff) (A2: class) (B2: class k) (S: class):
  $ wi ph (wss S cc) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wcel (co (cv x3) (cv y1) caddc) S) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 S) $ >
  $ wi ph (wne A2 c0) $ >
  $ wi ph (wcel (csu k A2 B2) S) $;

--| - Lemma for finite sum closures. (The "-" before "Lemma" forces the math content to be displayed in the Statement List - NM 11-Feb-2008.) (Contributed by NM, 9-Nov-2005.) (Revised by Mario Carneiro, 3-Jun-2014.)
theorem fsumcllem {x3 y1 k: setvar} (ph: wff) (A2: class) (B2: class k) (S: class):
  $ wi ph (wss S cc) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wcel (co (cv x3) (cv y1) caddc) S) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 S) $ >
  $ wi ph (wcel cc0 S) $ >
  $ wi ph (wcel (csu k A2 B2) S) $;

--| Closure of a finite sum of complex numbers ` A ( k ) ` . (Contributed by NM, 9-Nov-2005.) (Revised by Mario Carneiro, 22-Apr-2014.)
theorem fsumcl {k: setvar} (ph: wff) (A2: class) (B2: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi ph (wcel (csu k A2 B2) cc) $;

--| Closure of a finite sum of reals. (Contributed by NM, 9-Nov-2005.) (Revised by Mario Carneiro, 22-Apr-2014.)
theorem fsumrecl {k: setvar} (ph: wff) (A2: class) (B2: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cr) $ >
  $ wi ph (wcel (csu k A2 B2) cr) $;

--| Closure of a finite sum of integers. (Contributed by NM, 9-Nov-2005.) (Revised by Mario Carneiro, 22-Apr-2014.)
theorem fsumzcl {k: setvar} (ph: wff) (A2: class) (B2: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cz) $ >
  $ wi ph (wcel (csu k A2 B2) cz) $;

--| Closure of a finite sum of nonnegative integers. (Contributed by Mario Carneiro, 23-Apr-2015.)
theorem fsumnn0cl {k: setvar} (ph: wff) (A2: class) (B2: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cn0) $ >
  $ wi ph (wcel (csu k A2 B2) cn0) $;

--| Closure of a finite sum of positive reals. (Contributed by Mario Carneiro, 3-Jun-2014.)
theorem fsumrpcl {k: setvar} (ph: wff) (A2: class) (B2: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wne A2 c0) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 crp) $ >
  $ wi ph (wcel (csu k A2 B2) crp) $;

--| Closure of a finite sum of complex numbers ` A ( k ) ` . A version of ~ fsumcl using bound-variable hypotheses instead of distinct variable conditions. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem fsumclf {k: setvar} (ph: wff k) (A2: class) (B2: class k):
  $ wnf k ph $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi ph (wcel (csu k A2 B2) cc) $;

--| A finite sum with integer summands is an integer. (Contributed by Alexander van der Vekens, 31-Aug-2018.)
theorem fsumzcl2 {k: setvar} (A2: class) (B2: class k):
  $ wi (wa (wcel A2 cfn) (wral k (wcel B2 cz) A2)) (wcel (csu k A2 B2) cz) $;

--| The sum of two finite sums. (Contributed by NM, 14-Nov-2005.) (Revised by Mario Carneiro, 22-Apr-2014.)
theorem fsumadd {k: setvar} (ph: wff) (A2: class) (B2 C: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel C cc) $ >
  $ wi ph (wceq (csu k A2 (co B2 C caddc)) (co (csu k A2 B2) (csu k A2 C) caddc)) $;

--| Split a sum into two parts. (Contributed by Mario Carneiro, 18-Aug-2013.) (Revised by Mario Carneiro, 22-Apr-2014.)
theorem fsumsplit {k: setvar} (ph: wff) (A2 B2: class) (C: class k) (U: class):
  $ wi ph (wceq (cin A2 B2) c0) $ >
  $ wi ph (wceq U (cun A2 B2)) $ >
  $ wi ph (wcel U cfn) $ >
  $ wi (wa ph (wcel (cv k) U)) (wcel C cc) $ >
  $ wi ph (wceq (csu k U C) (co (csu k A2 C) (csu k B2 C) caddc)) $;

--| Split a sum into two parts. A version of ~ fsumsplit using bound-variable hypotheses instead of distinct variable conditions. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem fsumsplitf {k: setvar} (ph: wff k) (A2 B2: class) (C: class k) (U: class):
  $ wnf k ph $ >
  $ wi ph (wceq (cin A2 B2) c0) $ >
  $ wi ph (wceq U (cun A2 B2)) $ >
  $ wi ph (wcel U cfn) $ >
  $ wi (wa ph (wcel (cv k) U)) (wcel C cc) $ >
  $ wi ph (wceq (csu k U C) (co (csu k A2 C) (csu k B2 C) caddc)) $;

--| A sum of a singleton is the term. A version of ~ sumsn using bound-variable hypotheses instead of distinct variable conditions. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem sumsnf {k: setvar} (A2 B2: class k) (M V: class):
  $ wnfc k B2 $ >
  $ wi (wceq (cv k) M) (wceq A2 B2) $ >
  $ wi (wa (wcel M V) (wcel B2 cc)) (wceq (csu k (csn M) A2) B2) $;

--| Separate out a term in a finite sum. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem fsumsplitsn {k: setvar} (ph: wff k) (A2 B2: class) (C D: class k) (V: class):
  $ wnf k ph $ >
  $ wnfc k D $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wn (wcel B2 A2)) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel C cc) $ >
  $ wi (wceq (cv k) B2) (wceq C D) $ >
  $ wi ph (wcel D cc) $ >
  $ wi ph (wceq (csu k (cun A2 (csn B2)) C) (co (csu k A2 C) D caddc)) $;

--| Separate out a term in a finite sum. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem fsumsplit1 {k: setvar} (ph: wff k) (A2: class) (B2: class k) (C: class) (D: class k):
  $ wnf k ph $ >
  $ wnfc k D $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi ph (wcel C A2) $ >
  $ wi (wceq (cv k) C) (wceq B2 D) $ >
  $ wi ph (wceq (csu k A2 B2) (co D (csu k (cdif A2 (csn C)) B2) caddc)) $;

--| A sum of a singleton is the term. (Contributed by Mario Carneiro, 22-Apr-2014.)
theorem sumsn {k: setvar} (A2: class k) (B2 M V: class):
  $ wi (wceq (cv k) M) (wceq A2 B2) $ >
  $ wi (wa (wcel M V) (wcel B2 cc)) (wceq (csu k (csn M) A2) B2) $;

--| The finite sum of ` A ( k ) ` from ` k = M ` to ` M ` (i.e. a sum with only one term) is ` B ` i.e. ` A ( M ) ` . (Contributed by NM, 8-Nov-2005.) (Revised by Mario Carneiro, 21-Apr-2014.)
theorem fsum1 {k: setvar} (A2: class k) (B2 M: class):
  $ wi (wceq (cv k) M) (wceq A2 B2) $ >
  $ wi (wa (wcel M cz) (wcel B2 cc)) (wceq (csu k (co M M cfz) A2) B2) $;

--| A sum over a pair is the sum of the elements. (Contributed by Thierry Arnoux, 12-Dec-2016.)
theorem sumpr {k: setvar} (ph: wff) (A2 B2: class) (C: class k) (D E V W: class):
  $ wi (wceq (cv k) A2) (wceq C D) $ >
  $ wi (wceq (cv k) B2) (wceq C E) $ >
  $ wi ph (wa (wcel D cc) (wcel E cc)) $ >
  $ wi ph (wa (wcel A2 V) (wcel B2 W)) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wceq (csu k (cpr A2 B2) C) (co D E caddc)) $;

--| A sum over a triple is the sum of the elements. (Contributed by AV, 24-Jul-2020.)
theorem sumtp {k: setvar} (ph: wff) (A2 B2 C: class) (D: class k) (E F G V W X: class):
  $ wi (wceq (cv k) A2) (wceq D E) $ >
  $ wi (wceq (cv k) B2) (wceq D F) $ >
  $ wi (wceq (cv k) C) (wceq D G) $ >
  $ wi ph (w3a (wcel E cc) (wcel F cc) (wcel G cc)) $ >
  $ wi ph (w3a (wcel A2 V) (wcel B2 W) (wcel C X)) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wne A2 C) $ >
  $ wi ph (wne B2 C) $ >
  $ wi ph (wceq (csu k (ctp A2 B2 C) D) (co (co E F caddc) G caddc)) $;

--| A sum of a singleton is the term. (Contributed by Mario Carneiro, 22-Apr-2014.)
theorem sumsns {k: setvar} (A2: class k) (M: class) (V: class k):
  $ wi (wa (wcel M V) (wcel (csb k M A2) cc)) (wceq (csu k (csn M) A2) (csb k M A2)) $;

--| Separate out the last term in a finite sum. (Contributed by Mario Carneiro, 26-Apr-2014.)
theorem fsumm1 {k: setvar} (ph: wff) (A2: class k) (B2 M N: class):
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel A2 cc) $ >
  $ wi (wceq (cv k) N) (wceq A2 B2) $ >
  $ wi ph (wceq (csu k (co M N cfz) A2) (co (csu k (co M (co N c1 cmin) cfz) A2) B2 caddc)) $;

--| Separate out the last term in a finite sum. (Contributed by Mario Carneiro, 13-Apr-2016.)
theorem fzosump1 {k: setvar} (ph: wff) (A2: class k) (B2 M N: class):
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel A2 cc) $ >
  $ wi (wceq (cv k) N) (wceq A2 B2) $ >
  $ wi ph (wceq (csu k (co M (co N c1 caddc) cfzo) A2) (co (csu k (co M N cfzo) A2) B2 caddc)) $;

--| Separate out the first term in a finite sum. (Contributed by NM, 3-Jan-2006.) (Revised by Mario Carneiro, 23-Apr-2014.)
theorem fsum1p {k: setvar} (ph: wff) (A2: class k) (B2 M N: class):
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel A2 cc) $ >
  $ wi (wceq (cv k) M) (wceq A2 B2) $ >
  $ wi ph (wceq (csu k (co M N cfz) A2) (co B2 (csu k (co (co M c1 caddc) N cfz) A2) caddc)) $;

--| A finite sum all of whose summands are integers is itself an integer (case where the summation set is the union of a finite set and a singleton). (Contributed by Alexander van der Vekens, 1-Sep-2018.) (Revised by AV, 17-Dec-2021.)
theorem fsummsnunz {k: setvar} (A2: class) (B2: class k) (Z: class):
  $ wi (wa (wcel A2 cfn) (wral k (wcel B2 cz) (cun A2 (csn Z)))) (wcel (csu k (cun A2 (csn Z)) B2) cz) $;

--| Separate out a term in a finite sum by splitting the sum into two parts. (Contributed by Alexander van der Vekens, 1-Sep-2018.) (Revised by AV, 17-Dec-2021.)
theorem fsumsplitsnun {k: setvar} (A2: class) (B2 V: class k) (Z: class):
  $ wi (w3a (wcel A2 cfn) (wa (wcel Z V) (wnel Z A2)) (wral k (wcel B2 cz) (cun A2 (csn Z)))) (wceq (csu k (cun A2 (csn Z)) B2) (co (csu k A2 B2) (csb k Z B2) caddc)) $;

--| The addition of the next term in a finite sum of ` A ( k ) ` is the current term plus ` B ` i.e. ` A ( N + 1 ) ` . (Contributed by NM, 4-Nov-2005.) (Revised by Mario Carneiro, 21-Apr-2014.) (Proof shortened by SN, 22-Mar-2025.)
theorem fsump1 {k: setvar} (ph: wff) (A2: class k) (B2 M N: class):
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M (co N c1 caddc) cfz))) (wcel A2 cc) $ >
  $ wi (wceq (cv k) (co N c1 caddc)) (wceq A2 B2) $ >
  $ wi ph (wceq (csu k (co M (co N c1 caddc) cfz) A2) (co (csu k (co M N cfz) A2) B2 caddc)) $;

--| An infinite sum equals the value its series converges to. (Contributed by NM, 25-Dec-2005.) (Revised by Mario Carneiro, 23-Apr-2014.)
theorem isumclim {k: setvar} (ph: wff) (A2 B2: class k) (F M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) A2) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel A2 cc) $ >
  $ wi ph (wbr (cseq caddc F M) B2 cli) $ >
  $ wi ph (wceq (csu k Z A2) B2) $;

--| A converging series converges to its infinite sum. (Contributed by NM, 2-Jan-2006.) (Revised by Mario Carneiro, 23-Apr-2014.)
theorem isumclim2 {k: setvar} (ph: wff) (A2: class k) (F M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) A2) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel A2 cc) $ >
  $ wi ph (wcel (cseq caddc F M) (cdm cli)) $ >
  $ wi ph (wbr (cseq caddc F M) (csu k Z A2) cli) $;

--| The sequence of partial finite sums of a converging infinite series converges to the infinite sum of the series. Note that ` j ` must not occur in ` A ` . (Contributed by NM, 9-Jan-2006.) (Revised by Mario Carneiro, 23-Apr-2014.)
theorem isumclim3 {j k: setvar} (ph: wff) (A2 F: class k) (M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel F (cdm cli)) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel A2 cc) $ >
  $ wi (wa ph (wcel (cv j) Z)) (wceq (cfv (cv j) F) (csu k (co M (cv j) cfz) A2)) $ >
  $ wi ph (wbr F (csu k Z A2) cli) $;

--| The sum of a non-convergent infinite series evaluates to the empty set. (Contributed by Paul Chapman, 4-Nov-2007.) (Revised by Mario Carneiro, 23-Apr-2014.)
theorem sumnul {k: setvar} (ph: wff) (A2: class k) (F M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) A2) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel A2 cc) $ >
  $ wi ph (wn (wcel (cseq caddc F M) (cdm cli))) $ >
  $ wi ph (wceq (csu k Z A2) c0) $;

--| The sum of a converging infinite series is a complex number. (Contributed by NM, 13-Dec-2005.) (Revised by Mario Carneiro, 23-Apr-2014.)
theorem isumcl {k: setvar} (ph: wff) (A2: class k) (F M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) A2) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel A2 cc) $ >
  $ wi ph (wcel (cseq caddc F M) (cdm cli)) $ >
  $ wi ph (wcel (csu k Z A2) cc) $;

--| An infinite sum multiplied by a constant. (Contributed by NM, 12-Nov-2005.) (Revised by Mario Carneiro, 23-Apr-2014.)
theorem isummulc2 {k: setvar} (ph: wff) (A2: class k) (B2 F M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) A2) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel A2 cc) $ >
  $ wi ph (wcel (cseq caddc F M) (cdm cli)) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wceq (co B2 (csu k Z A2) cmul) (csu k Z (co B2 A2 cmul))) $;

--| An infinite sum multiplied by a constant. (Contributed by NM, 13-Nov-2005.) (Revised by Mario Carneiro, 23-Apr-2014.)
theorem isummulc1 {k: setvar} (ph: wff) (A2: class k) (B2 F M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) A2) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel A2 cc) $ >
  $ wi ph (wcel (cseq caddc F M) (cdm cli)) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wceq (co (csu k Z A2) B2 cmul) (csu k Z (co A2 B2 cmul))) $;

--| An infinite sum divided by a constant. (Contributed by NM, 2-Jan-2006.) (Revised by Mario Carneiro, 23-Apr-2014.)
theorem isumdivc {k: setvar} (ph: wff) (A2: class k) (B2 F M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) A2) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel A2 cc) $ >
  $ wi ph (wcel (cseq caddc F M) (cdm cli)) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wne B2 cc0) $ >
  $ wi ph (wceq (co (csu k Z A2) B2 cdiv) (csu k Z (co A2 B2 cdiv))) $;

--| The sum of a converging infinite real series is a real number. (Contributed by Mario Carneiro, 24-Apr-2014.)
theorem isumrecl {k: setvar} (ph: wff) (A2: class k) (F M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) A2) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel A2 cr) $ >
  $ wi ph (wcel (cseq caddc F M) (cdm cli)) $ >
  $ wi ph (wcel (csu k Z A2) cr) $;

--| An infinite sum of nonnegative terms is nonnegative. (Contributed by Mario Carneiro, 28-Apr-2014.)
theorem isumge0 {k: setvar} (ph: wff) (A2: class k) (F M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) A2) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel A2 cr) $ >
  $ wi ph (wcel (cseq caddc F M) (cdm cli)) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wbr cc0 A2 cle) $ >
  $ wi ph (wbr cc0 (csu k Z A2) cle) $;

--| Addition of infinite sums. (Contributed by Mario Carneiro, 18-Aug-2013.) (Revised by Mario Carneiro, 23-Apr-2014.)
theorem isumadd {k: setvar} (ph: wff) (A2 B2: class k) (F G M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) A2) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel A2 cc) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) G) B2) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel B2 cc) $ >
  $ wi ph (wcel (cseq caddc F M) (cdm cli)) $ >
  $ wi ph (wcel (cseq caddc G M) (cdm cli)) $ >
  $ wi ph (wceq (csu k Z (co A2 B2 caddc)) (co (csu k Z A2) (csu k Z B2) caddc)) $;

--| Split a sum into two parts. (Contributed by Mario Carneiro, 18-Aug-2013.) (Revised by Mario Carneiro, 23-Apr-2014.)
theorem sumsplit {k: setvar} (ph: wff) (A2 B2: class) (C: class k) (F G M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wceq (cin A2 B2) c0) $ >
  $ wi ph (wss (cun A2 B2) Z) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) (cif (wcel (cv k) A2) C cc0)) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) G) (cif (wcel (cv k) B2) C cc0)) $ >
  $ wi (wa ph (wcel (cv k) (cun A2 B2))) (wcel C cc) $ >
  $ wi ph (wcel (cseq caddc F M) (cdm cli)) $ >
  $ wi ph (wcel (cseq caddc G M) (cdm cli)) $ >
  $ wi ph (wceq (csu k (cun A2 B2) C) (co (csu k A2 C) (csu k B2 C) caddc)) $;

--| Optimized version of ~ fsump1 for making sums of a concrete number of terms. (Contributed by Mario Carneiro, 23-Apr-2014.)
theorem fsump1i {k: setvar} (ph: wff) (A2: class k) (B2: class) (S T: class k) (K M N: class) (Z: class k):
  $ wceq Z (cfv M cuz) $ >
  $ wceq N (co K c1 caddc) $ >
  $ wi (wceq (cv k) N) (wceq A2 B2) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel A2 cc) $ >
  $ wi ph (wa (wcel K Z) (wceq (csu k (co M K cfz) A2) S)) $ >
  $ wi ph (wceq (co S B2 caddc) T) $ >
  $ wi ph (wa (wcel N Z) (wceq (csu k (co M N cfz) A2) T)) $;

--| Lemma for ~ fsum2d - induction step. (Contributed by Mario Carneiro, 23-Apr-2014.)
theorem fsum2dlem {x3 y1 z j k: setvar} (ph: wff x3 y1) (ps: wff x3 y1 z j k) (A2: class) (B2: class j) (C: class j k) (D: class z):
  $ wi (wceq (cv z) (cop (cv j) (cv k))) (wceq D C) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv j) A2)) (wcel B2 cfn) $ >
  $ wi (wa ph (wa (wcel (cv j) A2) (wcel (cv k) B2))) (wcel C cc) $ >
  $ wi ph (wn (wcel (cv y1) (cv x3))) $ >
  $ wi ph (wss (cun (cv x3) (csn (cv y1))) A2) $ >
  $ wb ps (wceq (csu j (cv x3) (csu k B2 C)) (csu z (ciun j (cv x3) (cxp (csn (cv j)) B2)) D)) $ >
  $ wi (wa ph ps) (wceq (csu j (cun (cv x3) (csn (cv y1))) (csu k B2 C)) (csu z (ciun j (cun (cv x3) (csn (cv y1))) (cxp (csn (cv j)) B2)) D)) $;

--| Write a double sum as a sum over a two-dimensional region. Note that ` B ( j ) ` is a function of ` j ` . (Contributed by Mario Carneiro, 27-Apr-2014.)
theorem fsum2d {z j k: setvar} (ph: wff) (A2: class) (B2: class j) (C: class j k) (D: class z):
  $ wi (wceq (cv z) (cop (cv j) (cv k))) (wceq D C) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv j) A2)) (wcel B2 cfn) $ >
  $ wi (wa ph (wa (wcel (cv j) A2) (wcel (cv k) B2))) (wcel C cc) $ >
  $ wi ph (wceq (csu j A2 (csu k B2 C)) (csu z (ciun j A2 (cxp (csn (cv j)) B2)) D)) $;

--| Combine two sums into a single sum over the cartesian product. (Contributed by Mario Carneiro, 23-Apr-2014.)
theorem fsumxp {z j k: setvar} (ph: wff) (A2 B2: class) (C: class j k) (D: class z):
  $ wi (wceq (cv z) (cop (cv j) (cv k))) (wceq D C) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi (wa ph (wa (wcel (cv j) A2) (wcel (cv k) B2))) (wcel C cc) $ >
  $ wi ph (wceq (csu j A2 (csu k B2 C)) (csu z (cxp A2 B2) D)) $;

--| Transform a region of summation by using the converse operation. (Contributed by Mario Carneiro, 23-Apr-2014.)
theorem fsumcnv {x3 y1 j k: setvar} (ph: wff j k) (A2: class j k) (B2: class x3) (C: class y1) (D: class j k):
  $ wi (wceq (cv x3) (cop (cv j) (cv k))) (wceq B2 D) $ >
  $ wi (wceq (cv y1) (cop (cv k) (cv j))) (wceq C D) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wrel A2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cc) $ >
  $ wi ph (wceq (csu x3 A2 B2) (csu y1 (ccnv A2) C)) $;

--| Interchange order of summation. Note that ` B ( j ) ` and ` D ( k ) ` are not necessarily constant expressions. (Contributed by Mario Carneiro, 28-Apr-2014.) (Revised by Mario Carneiro, 8-Apr-2016.) (Proof shortened by JJ, 2-Aug-2021.)
theorem fsumcom2 {j k: setvar} (ph: wff) (A2: class) (B2: class j) (C: class) (D: class k) (E: class j k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wcel C cfn) $ >
  $ wi (wa ph (wcel (cv j) A2)) (wcel B2 cfn) $ >
  $ wi ph (wb (wa (wcel (cv j) A2) (wcel (cv k) B2)) (wa (wcel (cv k) C) (wcel (cv j) D))) $ >
  $ wi (wa ph (wa (wcel (cv j) A2) (wcel (cv k) B2))) (wcel E cc) $ >
  $ wi ph (wceq (csu j A2 (csu k B2 E)) (csu k C (csu j D E))) $;

--| Interchange order of summation. (Contributed by NM, 15-Nov-2005.) (Revised by Mario Carneiro, 23-Apr-2014.)
theorem fsumcom {j k: setvar} (ph: wff) (A2 B2: class) (C: class j k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi (wa ph (wa (wcel (cv j) A2) (wcel (cv k) B2))) (wcel C cc) $ >
  $ wi ph (wceq (csu j A2 (csu k B2 C)) (csu k B2 (csu j A2 C))) $;

--| Lemma for ~ fsum0diag . (Contributed by Mario Carneiro, 28-Apr-2014.) (Revised by Mario Carneiro, 8-Apr-2016.)
theorem fsum0diaglem (j k: setvar) (N: class):
  $ wi (wa (wcel (cv j) (co cc0 N cfz)) (wcel (cv k) (co cc0 (co N (cv j) cmin) cfz))) (wa (wcel (cv k) (co cc0 N cfz)) (wcel (cv j) (co cc0 (co N (cv k) cmin) cfz))) $;

--| Two ways to express "the sum of ` A ( j , k ) ` over the triangular region ` M <_ j ` , ` M <_ k ` , ` j + k <_ N ` ". (Contributed by NM, 31-Dec-2005.) (Proof shortened by Mario Carneiro, 28-Apr-2014.) (Revised by Mario Carneiro, 8-Apr-2016.)
theorem fsum0diag {j k: setvar} (ph: wff) (A2: class j k) (N: class):
  $ wi (wa ph (wa (wcel (cv j) (co cc0 N cfz)) (wcel (cv k) (co cc0 (co N (cv j) cmin) cfz)))) (wcel A2 cc) $ >
  $ wi ph (wceq (csu j (co cc0 N cfz) (csu k (co cc0 (co N (cv j) cmin) cfz) A2)) (csu k (co cc0 N cfz) (csu j (co cc0 (co N (cv k) cmin) cfz) A2))) $;

--| 1-1 onto function in maps-to notation which shifts a finite set of sequential integers. Formerly part of proof for ~ fsumshft . (Contributed by AV, 24-Aug-2019.)
theorem mptfzshft {j: setvar} (ph: wff) (K M N: class):
  $ wi ph (wcel K cz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wf1o (co (co M K caddc) (co N K caddc) cfz) (co M N cfz) (cmpt j (co (co M K caddc) (co N K caddc) cfz) (co (cv j) K cmin))) $;

--| Reversal of a finite sum. (Contributed by NM, 26-Nov-2005.) (Revised by Mario Carneiro, 24-Apr-2014.)
theorem fsumrev {j k: setvar} (ph: wff) (A2: class j) (B2: class k) (K M N: class):
  $ wi ph (wcel K cz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi (wa ph (wcel (cv j) (co M N cfz))) (wcel A2 cc) $ >
  $ wi (wceq (cv j) (co K (cv k) cmin)) (wceq A2 B2) $ >
  $ wi ph (wceq (csu j (co M N cfz) A2) (csu k (co (co K N cmin) (co K M cmin) cfz) B2)) $;

--| Index shift of a finite sum. (Contributed by NM, 27-Nov-2005.) (Revised by Mario Carneiro, 24-Apr-2014.) (Proof shortened by AV, 8-Sep-2019.)
theorem fsumshft {j k: setvar} (ph: wff) (A2: class j) (B2: class k) (K M N: class):
  $ wi ph (wcel K cz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi (wa ph (wcel (cv j) (co M N cfz))) (wcel A2 cc) $ >
  $ wi (wceq (cv j) (co (cv k) K cmin)) (wceq A2 B2) $ >
  $ wi ph (wceq (csu j (co M N cfz) A2) (csu k (co (co M K caddc) (co N K caddc) cfz) B2)) $;

--| Negative index shift of a finite sum. (Contributed by NM, 28-Nov-2005.) (Revised by Mario Carneiro, 24-Apr-2014.)
theorem fsumshftm {j k: setvar} (ph: wff) (A2: class j) (B2: class k) (K M N: class):
  $ wi ph (wcel K cz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi (wa ph (wcel (cv j) (co M N cfz))) (wcel A2 cc) $ >
  $ wi (wceq (cv j) (co (cv k) K caddc)) (wceq A2 B2) $ >
  $ wi ph (wceq (csu j (co M N cfz) A2) (csu k (co (co M K cmin) (co N K cmin) cfz) B2)) $;

--| Reversal of a finite sum. (Contributed by NM, 27-Nov-2005.) (Revised by Mario Carneiro, 13-Apr-2016.)
theorem fsumrev2 {j k: setvar} (ph: wff) (A2: class j) (B2: class k) (M N: class):
  $ wi (wa ph (wcel (cv j) (co M N cfz))) (wcel A2 cc) $ >
  $ wi (wceq (cv j) (co (co M N caddc) (cv k) cmin)) (wceq A2 B2) $ >
  $ wi ph (wceq (csu j (co M N cfz) A2) (csu k (co M N cfz) B2)) $;

--| Two ways to express "the sum of ` A ( j , k ) ` over the triangular region ` 0 <_ j ` , ` 0 <_ k ` , ` j + k <_ N ` ". (Contributed by Mario Carneiro, 21-Jul-2014.)
theorem fsum0diag2 {x3 j k: setvar} (ph: wff x3) (A2: class j k) (B2: class x3 j) (C: class j k) (N: class):
  $ wi (wceq (cv x3) (cv k)) (wceq B2 A2) $ >
  $ wi (wceq (cv x3) (co (cv k) (cv j) cmin)) (wceq B2 C) $ >
  $ wi (wa ph (wa (wcel (cv j) (co cc0 N cfz)) (wcel (cv k) (co cc0 (co N (cv j) cmin) cfz)))) (wcel A2 cc) $ >
  $ wi ph (wceq (csu j (co cc0 N cfz) (csu k (co cc0 (co N (cv j) cmin) cfz) A2)) (csu k (co cc0 N cfz) (csu j (co cc0 (cv k) cfz) C))) $;

--| A finite sum multiplied by a constant. (Contributed by NM, 12-Nov-2005.) (Revised by Mario Carneiro, 24-Apr-2014.)
theorem fsummulc2 {k: setvar} (ph: wff) (A2: class) (B2: class k) (C: class):
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wcel C cc) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi ph (wceq (co C (csu k A2 B2) cmul) (csu k A2 (co C B2 cmul))) $;

--| A finite sum multiplied by a constant. (Contributed by NM, 13-Nov-2005.) (Revised by Mario Carneiro, 24-Apr-2014.)
theorem fsummulc1 {k: setvar} (ph: wff) (A2: class) (B2: class k) (C: class):
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wcel C cc) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi ph (wceq (co (csu k A2 B2) C cmul) (csu k A2 (co B2 C cmul))) $;

--| A finite sum divided by a constant. (Contributed by NM, 2-Jan-2006.) (Revised by Mario Carneiro, 24-Apr-2014.)
theorem fsumdivc {k: setvar} (ph: wff) (A2: class) (B2: class k) (C: class):
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wcel C cc) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi ph (wne C cc0) $ >
  $ wi ph (wceq (co (csu k A2 B2) C cdiv) (csu k A2 (co B2 C cdiv))) $;

--| Negation of a finite sum. (Contributed by Scott Fenton, 12-Jun-2013.) (Revised by Mario Carneiro, 24-Apr-2014.)
theorem fsumneg {k: setvar} (ph: wff) (A2: class) (B2: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi ph (wceq (csu k A2 (cneg B2)) (cneg (csu k A2 B2))) $;

--| Split a finite sum over a subtraction. (Contributed by Scott Fenton, 12-Jun-2013.) (Revised by Mario Carneiro, 24-Apr-2014.)
theorem fsumsub {k: setvar} (ph: wff) (A2: class) (B2 C: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel C cc) $ >
  $ wi ph (wceq (csu k A2 (co B2 C cmin)) (co (csu k A2 B2) (csu k A2 C) cmin)) $;

--| Separate the nested sum of the product ` C ( j ) x. D ( k ) ` . (Contributed by NM, 13-Nov-2005.) (Revised by Mario Carneiro, 24-Apr-2014.)
theorem fsum2mul {j k: setvar} (ph: wff) (A2 B2: class) (C: class j) (D: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi (wa ph (wcel (cv j) A2)) (wcel C cc) $ >
  $ wi (wa ph (wcel (cv k) B2)) (wcel D cc) $ >
  $ wi ph (wceq (csu j A2 (csu k B2 (co C D cmul))) (co (csu j A2 C) (csu k B2 D) cmul)) $;

--| The sum of constant terms ( ` k ` is not free in ` B ` ). (Contributed by NM, 24-Dec-2005.) (Revised by Mario Carneiro, 24-Apr-2014.)
theorem fsumconst {k: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cfn) (wcel B2 cc)) (wceq (csu k A2 B2) (co (cfv A2 chash) B2 cmul)) $;

--| The sum of 1 over a finite set equals the size of the set. (Contributed by AV, 10-Apr-2026.)
theorem fsumconst1 {k: setvar} (A2: class):
  $ wi (wcel A2 cfn) (wceq (csu k A2 c1) (cfv A2 chash)) $;

--| The sum of constant terms ( ` k ` is not free in ` C ` ) over an index set excluding a singleton. (Contributed by AV, 7-Jan-2022.)
theorem fsumdifsnconst {k: setvar} (A2 B2 C: class):
  $ wi (w3a (wcel A2 cfn) (wcel B2 A2) (wcel C cc)) (wceq (csu k (cdif A2 (csn B2)) C) (co (co (cfv A2 chash) c1 cmin) C cmul)) $;

--| Lemma 1 for ~ modfsummods . (Contributed by Alexander van der Vekens, 1-Sep-2018.)
theorem modfsummodslem1 {z k: setvar} (A2: class z) (B2: class z k):
  $ wi (wral k (wcel B2 cz) (cun A2 (csn (cv z)))) (wcel (csb k (cv z) B2) cz) $;

--| Induction step for ~ modfsummod . (Contributed by Alexander van der Vekens, 1-Sep-2018.)
theorem modfsummods {z k: setvar} (A2: class z) (B2: class z k) (N: class z):
  $ wi (w3a (wcel A2 cfn) (wcel N cn) (wral k (wcel B2 cz) (cun A2 (csn (cv z))))) (wi (wceq (co (csu k A2 B2) N cmo) (co (csu k A2 (co B2 N cmo)) N cmo)) (wceq (co (csu k (cun A2 (csn (cv z))) B2) N cmo) (co (csu k (cun A2 (csn (cv z))) (co B2 N cmo)) N cmo))) $;

--| A finite sum modulo a positive integer equals the finite sum of their summands modulo the positive integer, modulo the positive integer. (Contributed by Alexander van der Vekens, 1-Sep-2018.)
theorem modfsummod {k: setvar} (ph: wff k) (A2: class) (B2: class k) (N: class):
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wral k (wcel B2 cz) A2) $ >
  $ wi ph (wceq (co (csu k A2 B2) N cmo) (co (csu k A2 (co B2 N cmo)) N cmo)) $;

--| If all of the terms of a finite sum are nonnegative, so is the sum. (Contributed by NM, 26-Dec-2005.) (Revised by Mario Carneiro, 24-Apr-2014.)
theorem fsumge0 {k: setvar} (ph: wff) (A2: class) (B2: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cr) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wbr cc0 B2 cle) $ >
  $ wi ph (wbr cc0 (csu k A2 B2) cle) $;

--| A shorter sum of nonnegative terms is smaller than a longer one. (Contributed by NM, 26-Dec-2005.) (Proof shortened by Mario Carneiro, 24-Apr-2014.)
theorem fsumless {k: setvar} (ph: wff) (A2: class) (B2: class k) (C: class):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cr) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wbr cc0 B2 cle) $ >
  $ wi ph (wss C A2) $ >
  $ wi ph (wbr (csu k C B2) (csu k A2 B2) cle) $;

--| A sum of nonnegative numbers is greater than or equal to any one of its terms. (Contributed by Jeff Madsen, 2-Sep-2009.) (Proof shortened by Mario Carneiro, 4-Jun-2014.)
theorem fsumge1 {k: setvar} (ph: wff) (A2: class) (B2: class k) (C M: class):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cr) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wbr cc0 B2 cle) $ >
  $ wi (wceq (cv k) M) (wceq B2 C) $ >
  $ wi ph (wcel M A2) $ >
  $ wi ph (wbr C (csu k A2 B2) cle) $;

--| A sum of nonnegative numbers is zero iff all terms are zero. (Contributed by Jeff Madsen, 2-Sep-2009.) (Proof shortened by Mario Carneiro, 24-Apr-2014.)
theorem fsum00 {k: setvar} (ph: wff) (A2: class) (B2: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cr) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wbr cc0 B2 cle) $ >
  $ wi ph (wb (wceq (csu k A2 B2) cc0) (wral k (wceq B2 cc0) A2)) $;

--| If all of the terms of finite sums compare, so do the sums. (Contributed by NM, 11-Dec-2005.) (Proof shortened by Mario Carneiro, 24-Apr-2014.)
theorem fsumle {k: setvar} (ph: wff) (A2: class) (B2 C: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cr) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel C cr) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wbr B2 C cle) $ >
  $ wi ph (wbr (csu k A2 B2) (csu k A2 C) cle) $;

--| If every term in one finite sum is less than the corresponding term in another, then the first sum is less than the second. (Contributed by Jeff Madsen, 2-Sep-2009.) (Revised by Mario Carneiro, 3-Jun-2014.)
theorem fsumlt {k: setvar} (ph: wff) (A2: class) (B2 C: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wne A2 c0) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cr) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel C cr) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wbr B2 C clt) $ >
  $ wi ph (wbr (csu k A2 B2) (csu k A2 C) clt) $;

--| Generalized triangle inequality: the absolute value of a finite sum is less than or equal to the sum of absolute values. (Contributed by NM, 9-Nov-2005.) (Revised by Mario Carneiro, 24-Apr-2014.)
theorem fsumabs {k: setvar} (ph: wff) (A2: class) (B2: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi ph (wbr (cfv (csu k A2 B2) cabs) (csu k A2 (cfv B2 cabs)) cle) $;

--| Sum of a telescoping series, using half-open intervals. (Contributed by Mario Carneiro, 2-May-2016.)
theorem telfsumo {j k: setvar} (ph: wff) (A2: class k) (B2 C D E: class j) (M N: class):
  $ wi (wceq (cv k) (cv j)) (wceq A2 B2) $ >
  $ wi (wceq (cv k) (co (cv j) c1 caddc)) (wceq A2 C) $ >
  $ wi (wceq (cv k) M) (wceq A2 D) $ >
  $ wi (wceq (cv k) N) (wceq A2 E) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel A2 cc) $ >
  $ wi ph (wceq (csu j (co M N cfzo) (co B2 C cmin)) (co D E cmin)) $;

--| Sum of a telescoping series. (Contributed by Mario Carneiro, 2-May-2016.)
theorem telfsumo2 {j k: setvar} (ph: wff) (A2: class k) (B2 C D E: class j) (M N: class):
  $ wi (wceq (cv k) (cv j)) (wceq A2 B2) $ >
  $ wi (wceq (cv k) (co (cv j) c1 caddc)) (wceq A2 C) $ >
  $ wi (wceq (cv k) M) (wceq A2 D) $ >
  $ wi (wceq (cv k) N) (wceq A2 E) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel A2 cc) $ >
  $ wi ph (wceq (csu j (co M N cfzo) (co C B2 cmin)) (co E D cmin)) $;

--| Sum of a telescoping series. (Contributed by Scott Fenton, 24-Apr-2014.) (Revised by Mario Carneiro, 2-May-2016.)
theorem telfsum {j k: setvar} (ph: wff) (A2: class k) (B2 C D E: class j) (M N: class):
  $ wi (wceq (cv k) (cv j)) (wceq A2 B2) $ >
  $ wi (wceq (cv k) (co (cv j) c1 caddc)) (wceq A2 C) $ >
  $ wi (wceq (cv k) M) (wceq A2 D) $ >
  $ wi (wceq (cv k) (co N c1 caddc)) (wceq A2 E) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wcel (co N c1 caddc) (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M (co N c1 caddc) cfz))) (wcel A2 cc) $ >
  $ wi ph (wceq (csu j (co M N cfz) (co B2 C cmin)) (co D E cmin)) $;

--| Sum of a telescoping series. (Contributed by Mario Carneiro, 15-Jun-2014.) (Revised by Mario Carneiro, 2-May-2016.)
theorem telfsum2 {j k: setvar} (ph: wff) (A2: class k) (B2 C D E: class j) (M N: class):
  $ wi (wceq (cv k) (cv j)) (wceq A2 B2) $ >
  $ wi (wceq (cv k) (co (cv j) c1 caddc)) (wceq A2 C) $ >
  $ wi (wceq (cv k) M) (wceq A2 D) $ >
  $ wi (wceq (cv k) (co N c1 caddc)) (wceq A2 E) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wcel (co N c1 caddc) (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M (co N c1 caddc) cfz))) (wcel A2 cc) $ >
  $ wi ph (wceq (csu j (co M N cfz) (co C B2 cmin)) (co E D cmin)) $;

--| Summation by parts. (Contributed by Mario Carneiro, 13-Apr-2016.)
theorem fsumparts {j k: setvar} (ph: wff) (A2: class k) (B2 C D E: class j) (M N: class) (V: class k) (W X Y Z: class j):
  $ wi (wceq (cv k) (cv j)) (wa (wceq A2 B2) (wceq V W)) $ >
  $ wi (wceq (cv k) (co (cv j) c1 caddc)) (wa (wceq A2 C) (wceq V X)) $ >
  $ wi (wceq (cv k) M) (wa (wceq A2 D) (wceq V Y)) $ >
  $ wi (wceq (cv k) N) (wa (wceq A2 E) (wceq V Z)) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel A2 cc) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel V cc) $ >
  $ wi ph (wceq (csu j (co M N cfzo) (co B2 (co X W cmin) cmul)) (co (co (co E Z cmul) (co D Y cmul) cmin) (csu j (co M N cfzo) (co (co C B2 cmin) X cmul)) cmin)) $;

--| Lemma for ~ fsumre , ~ fsumim , and ~ fsumcj . (Contributed by Mario Carneiro, 25-Jul-2014.) (Revised by Mario Carneiro, 27-Dec-2014.)
theorem fsumrelem {x3 y1 k: setvar} (ph: wff) (A2: class) (B2: class k) (F: class):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wf cc cc F $ >
  $ wi (wa (wcel (cv x3) cc) (wcel (cv y1) cc)) (wceq (cfv (co (cv x3) (cv y1) caddc) F) (co (cfv (cv x3) F) (cfv (cv y1) F) caddc)) $ >
  $ wi ph (wceq (cfv (csu k A2 B2) F) (csu k A2 (cfv B2 F))) $;

--| The real part of a sum. (Contributed by Paul Chapman, 9-Nov-2007.) (Revised by Mario Carneiro, 25-Jul-2014.)
theorem fsumre {k: setvar} (ph: wff) (A2: class) (B2: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi ph (wceq (cfv (csu k A2 B2) cre) (csu k A2 (cfv B2 cre))) $;

--| The imaginary part of a sum. (Contributed by Paul Chapman, 9-Nov-2007.) (Revised by Mario Carneiro, 25-Jul-2014.)
theorem fsumim {k: setvar} (ph: wff) (A2: class) (B2: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi ph (wceq (cfv (csu k A2 B2) cim) (csu k A2 (cfv B2 cim))) $;

--| The complex conjugate of a sum. (Contributed by Paul Chapman, 9-Nov-2007.) (Revised by Mario Carneiro, 25-Jul-2014.)
theorem fsumcj {k: setvar} (ph: wff) (A2: class) (B2: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi ph (wceq (cfv (csu k A2 B2) ccj) (csu k A2 (cfv B2 ccj))) $;

--| Limit of a finite sum of converging sequences. Note that ` C ( k ) ` is a collection of functions with implicit parameter ` k ` , each of which converges to ` D ( k ) ` as ` n ~~> +oo ` . (Contributed by Mario Carneiro, 22-May-2016.)
theorem fsumrlim {x3 k: setvar} (ph: wff) (A2 B2: class) (C D V: class x3 k):
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv k) B2))) (wcel C V) $ >
  $ wi (wa ph (wcel (cv k) B2)) (wbr (cmpt x3 A2 C) D crli) $ >
  $ wi ph (wbr (cmpt x3 A2 (csu k B2 C)) (csu k B2 D) crli) $;

--| The finite sum of eventually bounded functions (where the index set ` B ` does not depend on ` x ` ) is eventually bounded. (Contributed by Mario Carneiro, 30-Apr-2016.) (Proof shortened by Mario Carneiro, 22-May-2016.)
theorem fsumo1 {x3 k: setvar} (ph: wff) (A2 B2: class) (C V: class x3 k):
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv k) B2))) (wcel C V) $ >
  $ wi (wa ph (wcel (cv k) B2)) (wcel (cmpt x3 A2 C) co1) $ >
  $ wi ph (wcel (cmpt x3 A2 (csu k B2 C)) co1) $;

--| If ` A ( k ) ` is O(1), then ` sum_ k <_ x , A ( k ) ` is O( ` x ` ). (Contributed by Mario Carneiro, 23-May-2016.)
theorem o1fsum {x3 k: setvar} (ph: wff) (A2: class k) (V: class x3 k):
  $ wi (wa ph (wcel (cv k) cn)) (wcel A2 V) $ >
  $ wi ph (wcel (cmpt k cn A2) co1) $ >
  $ wi ph (wcel (cmpt x3 crp (co (csu k (co c1 (cfv (cv x3) cfl) cfz) A2) (cv x3) cdiv)) co1) $;

--| Generalized triangle inequality: the absolute value of a finite sum is less than or equal to the sum of absolute values. (Contributed by Mario Carneiro, 26-Mar-2014.) (Revised by Mario Carneiro, 27-May-2014.)
theorem seqabs {k: setvar} (ph: wff) (F G M N: class):
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel (cfv (cv k) F) cc) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wceq (cfv (cv k) G) (cfv (cfv (cv k) F) cabs)) $ >
  $ wi ph (wbr (cfv (cfv N (cseq caddc F M)) cabs) (cfv N (cseq caddc G M)) cle) $;

--| Generalized triangle inequality: the absolute value of an infinite sum is less than or equal to the sum of absolute values. (Contributed by Paul Chapman, 10-Sep-2007.) (Revised by Mario Carneiro, 27-May-2014.)
theorem iserabs {k: setvar} (ph: wff) (A2 B2: class k) (F G M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wbr (cseq caddc F M) A2 cli) $ >
  $ wi ph (wbr (cseq caddc G M) B2 cli) $ >
  $ wi ph (wcel M cz) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) G) (cfv (cfv (cv k) F) cabs)) $ >
  $ wi ph (wbr (cfv A2 cabs) B2 cle) $;

--| A comparison test for convergence of a real infinite series. Exercise 3 of [Gleason] p. 182. (Contributed by NM, 1-May-2005.) (Revised by Mario Carneiro, 24-Mar-2014.)
theorem cvgcmp {k: setvar} (ph: wff) (F G M N Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel N Z) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cr) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) G) cr) $ >
  $ wi ph (wcel (cseq caddc F M) (cdm cli)) $ >
  $ wi (wa ph (wcel (cv k) (cfv N cuz))) (wbr cc0 (cfv (cv k) G) cle) $ >
  $ wi (wa ph (wcel (cv k) (cfv N cuz))) (wbr (cfv (cv k) G) (cfv (cv k) F) cle) $ >
  $ wi ph (wcel (cseq caddc G M) (cdm cli)) $;

--| An upper bound for the limit of a real infinite series. This theorem can also be used to compare two infinite series. (Contributed by Mario Carneiro, 24-Mar-2014.)
theorem cvgcmpub {k: setvar} (ph: wff) (A2 B2: class k) (F G M N Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel N Z) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cr) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) G) cr) $ >
  $ wi ph (wbr (cseq caddc F M) A2 cli) $ >
  $ wi ph (wbr (cseq caddc G M) B2 cli) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wbr (cfv (cv k) G) (cfv (cv k) F) cle) $ >
  $ wi ph (wbr B2 A2 cle) $;

--| A comparison test for convergence of a complex infinite series. (Contributed by NM, 25-Apr-2005.) (Revised by Mario Carneiro, 27-May-2014.)
theorem cvgcmpce {k: setvar} (ph: wff) (C F G M N Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel N Z) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cr) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) G) cc) $ >
  $ wi ph (wcel (cseq caddc F M) (cdm cli)) $ >
  $ wi ph (wcel C cr) $ >
  $ wi (wa ph (wcel (cv k) (cfv N cuz))) (wbr (cfv (cfv (cv k) G) cabs) (co C (cfv (cv k) F) cmul) cle) $ >
  $ wi ph (wcel (cseq caddc G M) (cdm cli)) $;

--| An absolutely convergent series is convergent. (Contributed by Mario Carneiro, 28-Apr-2014.)
theorem abscvgcvg {k: setvar} (ph: wff) (F G M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) (cfv (cfv (cv k) G) cabs)) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) G) cc) $ >
  $ wi ph (wcel (cseq caddc F M) (cdm cli)) $ >
  $ wi ph (wcel (cseq caddc G M) (cdm cli)) $;

--| Limit of a finite sum of converging sequences. Note that ` F ( k ) ` is a collection of functions with implicit parameter ` k ` , each of which converges to ` B ( k ) ` as ` n ~~> +oo ` . (Contributed by Mario Carneiro, 22-Jul-2014.) (Proof shortened by Mario Carneiro, 22-May-2016.)
theorem climfsum {k n: setvar} (ph: wff) (A2: class) (B2 F H M: class k) (W: class k n) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wbr F B2 cli) $ >
  $ wi ph (wcel H W) $ >
  $ wi (wa ph (wa (wcel (cv k) A2) (wcel (cv n) Z))) (wcel (cfv (cv n) F) cc) $ >
  $ wi (wa ph (wcel (cv n) Z)) (wceq (cfv (cv n) H) (csu k A2 (cfv (cv n) F))) $ >
  $ wi ph (wbr H (csu k A2 B2) cli) $;

--| Sum over a disjoint indexed union. (Contributed by Mario Carneiro, 1-Jul-2015.) (Revised by Mario Carneiro, 10-Dec-2016.)
theorem fsumiun {x3 k: setvar} (ph: wff) (A2: class) (B2: class x3) (C: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cfn) $ >
  $ wi ph (wdisj x3 A2 B2) $ >
  $ wi (wa ph (wa (wcel (cv x3) A2) (wcel (cv k) B2))) (wcel C cc) $ >
  $ wi ph (wceq (csu k (ciun x3 A2 B2) C) (csu x3 A2 (csu k B2 C))) $;

--| The cardinality of a disjoint indexed union. (Contributed by Mario Carneiro, 24-Jan-2015.) (Revised by Mario Carneiro, 10-Dec-2016.)
theorem hashiun {x3: setvar} (ph: wff) (A2: class) (B2: class x3):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cfn) $ >
  $ wi ph (wdisj x3 A2 B2) $ >
  $ wi ph (wceq (cfv (ciun x3 A2 B2) chash) (csu x3 A2 (cfv B2 chash))) $;

--| The cardinality of a nested disjoint indexed union. (Contributed by AV, 9-Jan-2022.)
theorem hash2iun {x3 y1: setvar} (ph: wff) (A2: class) (B2: class x3) (C: class x3 y1):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cfn) $ >
  $ wi (w3a ph (wcel (cv x3) A2) (wcel (cv y1) B2)) (wcel C cfn) $ >
  $ wi ph (wdisj x3 A2 (ciun y1 B2 C)) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wdisj y1 B2 C) $ >
  $ wi ph (wceq (cfv (ciun x3 A2 (ciun y1 B2 C)) chash) (csu x3 A2 (csu y1 B2 (cfv C chash)))) $;

--| The cardinality of a nested disjoint indexed union. (Contributed by AV, 9-Jan-2022.)
theorem hash2iun1dif1 {x3 y1: setvar} (ph: wff) (A2: class) (B2: class x3) (C: class x3 y1):
  $ wi ph (wcel A2 cfn) $ >
  $ wceq B2 (cdif A2 (csn (cv x3))) $ >
  $ wi (w3a ph (wcel (cv x3) A2) (wcel (cv y1) B2)) (wcel C cfn) $ >
  $ wi ph (wdisj x3 A2 (ciun y1 B2 C)) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wdisj y1 B2 C) $ >
  $ wi (w3a ph (wcel (cv x3) A2) (wcel (cv y1) B2)) (wceq (cfv C chash) c1) $ >
  $ wi ph (wceq (cfv (ciun x3 A2 (ciun y1 B2 C)) chash) (co (cfv A2 chash) (co (cfv A2 chash) c1 cmin) cmul)) $;

--| The number of elements in a class abstraction with a restricted existential quantification. (Contributed by Alexander van der Vekens, 29-Jul-2018.)
theorem hashrabrex {x3 y1: setvar} (ph: wff x3) (ps: wff x3 y1) (X Y: class):
  $ wi ph (wcel Y cfn) $ >
  $ wi (wa ph (wcel (cv y1) Y)) (wcel (crab x3 ps X) cfn) $ >
  $ wi ph (wdisj y1 Y (crab x3 ps X)) $ >
  $ wi ph (wceq (cfv (crab x3 (wrex y1 ps Y) X) chash) (csu y1 Y (cfv (crab x3 ps X) chash))) $;

--| The cardinality of a disjoint union. (Contributed by Mario Carneiro, 24-Jan-2015.)
theorem hashuni {x3: setvar} (ph: wff) (A2: class):
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wss A2 cfn) $ >
  $ wi ph (wdisj x3 A2 (cv x3)) $ >
  $ wi ph (wceq (cfv (cuni A2) chash) (csu x3 A2 (cfv (cv x3) chash))) $;

--| The cardinality of a set with an equivalence relation is the sum of the cardinalities of its equivalence classes. (Contributed by Mario Carneiro, 16-Jan-2015.)
theorem qshash {x3: setvar} (ph: wff) (A2 c_sm: class):
  $ wi ph (wer A2 c_sm) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wceq (cfv A2 chash) (csu x3 (cqs A2 c_sm) (cfv (cv x3) chash))) $;

--| Finite sum of a product with the indicator function / Cartesian product with the indicator function. Note: this theorem cannot be efficiently shortened using ~ sumss2 , unless there are some additional auxiliary theorems like ` ( if ( x e. A , 1 , 0 ) x. B ) = ` ` if ( x e. A , B , 0 ) ` . (Contributed by Thierry Arnoux, 14-Aug-2017.) (Proof shortened by AV, 11-Apr-2026.)
theorem indsum {x3: setvar} (ph: wff) (A2: class) (B2: class x3) (O: class):
  $ wi ph (wcel O cfn) $ >
  $ wi ph (wss A2 O) $ >
  $ wi (wa ph (wcel (cv x3) O)) (wcel B2 cc) $ >
  $ wi ph (wceq (csu x3 O (co (cfv (cv x3) (cfv A2 (cfv O cind))) B2 cmul)) (csu x3 A2 B2)) $;

--| The finite sum of the indicator function is the number of elements of the corresponding subset. (Contributed by AV, 10-Apr-2026.)
theorem indsumhash {k: setvar} (A2: class) (c_1: class k) (O: class):
  $ wceq c_1 (cfv A2 (cfv O cind)) $ >
  $ wi (wa (wcel O cfn) (wss A2 O)) (wceq (csu k O (cfv (cv k) c_1)) (cfv A2 chash)) $;

--| Translate the Ackermann bijection ~ ackbij1 onto the positive integers. (Contributed by Mario Carneiro, 16-Jan-2015.)
theorem ackbijnn {x3 y1: setvar} (F: class x3 y1):
  $ wceq F (cmpt x3 (cin (cpw cn0) cfn) (csu y1 (cv x3) (co c2 (cv y1) cexp))) $ >
  $ wf1o (cin (cpw cn0) cfn) cn0 F $;

--| Lemma for ~ binom (binomial theorem). Inductive step. (Contributed by NM, 6-Dec-2005.) (Revised by Mario Carneiro, 24-Apr-2014.)
theorem binomlem {k: setvar} (ph: wff) (ps: wff k) (A2 B2 N: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ps (wceq (co (co A2 B2 caddc) N cexp) (csu k (co cc0 N cfz) (co (co N (cv k) cbc) (co (co A2 (co N (cv k) cmin) cexp) (co B2 (cv k) cexp) cmul) cmul))) $ >
  $ wi (wa ph ps) (wceq (co (co A2 B2 caddc) (co N c1 caddc) cexp) (csu k (co cc0 (co N c1 caddc) cfz) (co (co (co N c1 caddc) (cv k) cbc) (co (co A2 (co (co N c1 caddc) (cv k) cmin) cexp) (co B2 (cv k) cexp) cmul) cmul))) $;

--| The binomial theorem: ` ( A + B ) ^ N ` is the sum from ` k = 0 ` to ` N ` of ` ( N _C k ) x. ( ( A ^ k ) x. ( B ^ ( N - k ) ) ` . Theorem 15-2.8 of [Gleason] p. 296. This part of the proof sets up the induction and does the base case, with the bulk of the work (the induction step) in ~ binomlem . This is Metamath 100 proof #44. (Contributed by NM, 7-Dec-2005.) (Proof shortened by Mario Carneiro, 24-Apr-2014.)
theorem binom {k: setvar} (A2 B2 N: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel N cn0)) (wceq (co (co A2 B2 caddc) N cexp) (csu k (co cc0 N cfz) (co (co N (cv k) cbc) (co (co A2 (co N (cv k) cmin) cexp) (co B2 (cv k) cexp) cmul) cmul))) $;

--| Special case of the binomial theorem for ` ( 1 + A ) ^ N ` . (Contributed by Paul Chapman, 10-May-2007.)
theorem binom1p {k: setvar} (A2 N: class):
  $ wi (wa (wcel A2 cc) (wcel N cn0)) (wceq (co (co c1 A2 caddc) N cexp) (csu k (co cc0 N cfz) (co (co N (cv k) cbc) (co A2 (cv k) cexp) cmul))) $;

--| Special case of the binomial theorem for ` 2 ^ N ` . (Contributed by Mario Carneiro, 13-Mar-2014.)
theorem binom11 {k: setvar} (N: class):
  $ wi (wcel N cn0) (wceq (co c2 N cexp) (csu k (co cc0 N cfz) (co N (cv k) cbc))) $;

--| A summation for the difference between ` ( ( A + 1 ) ^ N ) ` and ` ( A ^ N ) ` . (Contributed by Scott Fenton, 9-Apr-2014.) (Revised by Mario Carneiro, 22-May-2014.)
theorem binom1dif {k: setvar} (A2 N: class):
  $ wi (wa (wcel A2 cc) (wcel N cn0)) (wceq (co (co (co A2 c1 caddc) N cexp) (co A2 N cexp) cmin) (csu k (co cc0 (co N c1 cmin) cfz) (co (co N (cv k) cbc) (co A2 (cv k) cexp) cmul))) $;

--| Lemma for ~ bcxmas . (Contributed by Paul Chapman, 18-May-2007.)
theorem bcxmaslem1 (A2 B2 N: class):
  $ wi (wceq A2 B2) (wceq (co (co N A2 caddc) A2 cbc) (co (co N B2 caddc) B2 cbc)) $;

--| Parallel summation (Christmas Stocking) theorem for Pascal's Triangle. (Contributed by Paul Chapman, 18-May-2007.) (Revised by Mario Carneiro, 24-Apr-2014.)
theorem bcxmas {j: setvar} (M N: class):
  $ wi (wa (wcel N cn0) (wcel M cn0)) (wceq (co (co (co N c1 caddc) M caddc) M cbc) (csu j (co cc0 M cfz) (co (co N (cv j) caddc) (cv j) cbc))) $;

--| Lemma for ~ incexc . (Contributed by Mario Carneiro, 7-Aug-2017.)
theorem incexclem {s1: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cfn) (wcel B2 cfn)) (wceq (co (cfv B2 chash) (cfv (cin B2 (cuni A2)) chash) cmin) (csu s1 (cpw A2) (co (co (cneg c1) (cfv (cv s1) chash) cexp) (cfv (cin B2 (cint (cv s1))) chash) cmul))) $;

--| The inclusion/exclusion principle for counting the elements of a finite union of finite sets. This is Metamath 100 proof #96. (Contributed by Mario Carneiro, 7-Aug-2017.)
theorem incexc {s1: setvar} (A2: class):
  $ wi (wa (wcel A2 cfn) (wss A2 cfn)) (wceq (cfv (cuni A2) chash) (csu s1 (cdif (cpw A2) (csn c0)) (co (co (cneg c1) (co (cfv (cv s1) chash) c1 cmin) cexp) (cfv (cint (cv s1)) chash) cmul))) $;

--| The inclusion/exclusion principle for counting the elements of a finite union of finite sets. (Contributed by Mario Carneiro, 7-Aug-2017.)
theorem incexc2 {k n s1: setvar} (A2: class):
  $ wi (wa (wcel A2 cfn) (wss A2 cfn)) (wceq (cfv (cuni A2) chash) (csu n (co c1 (cfv A2 chash) cfz) (co (co (cneg c1) (co (cv n) c1 cmin) cexp) (csu s1 (crab k (wceq (cfv (cv k) chash) (cv n)) (cpw A2)) (cfv (cint (cv s1)) chash)) cmul))) $;

--| Index shift of an infinite sum. (Contributed by Paul Chapman, 31-Oct-2007.) (Revised by Mario Carneiro, 24-Apr-2014.)
theorem isumshft {j k: setvar} (ph: wff) (A2: class j) (B2: class k) (K: class) (M: class j k) (W: class) (Z: class j):
  $ wceq Z (cfv M cuz) $ >
  $ wceq W (cfv (co M K caddc) cuz) $ >
  $ wi (wceq (cv j) (co K (cv k) caddc)) (wceq A2 B2) $ >
  $ wi ph (wcel K cz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi (wa ph (wcel (cv j) W)) (wcel A2 cc) $ >
  $ wi ph (wceq (csu j W A2) (csu k Z B2)) $;

--| Split off the first ` N ` terms of an infinite sum. (Contributed by Paul Chapman, 9-Feb-2008.) (Revised by Mario Carneiro, 24-Apr-2014.)
theorem isumsplit {k: setvar} (ph: wff) (A2: class k) (F M N W Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wceq W (cfv N cuz) $ >
  $ wi ph (wcel N Z) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) A2) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel A2 cc) $ >
  $ wi ph (wcel (cseq caddc F M) (cdm cli)) $ >
  $ wi ph (wceq (csu k Z A2) (co (csu k (co M (co N c1 cmin) cfz) A2) (csu k W A2) caddc)) $;

--| The infinite sum of a converging infinite series equals the first term plus the infinite sum of the rest of it. (Contributed by NM, 2-Jan-2006.) (Revised by Mario Carneiro, 24-Apr-2014.)
theorem isum1p {k: setvar} (ph: wff) (A2: class k) (F M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) A2) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel A2 cc) $ >
  $ wi ph (wcel (cseq caddc F M) (cdm cli)) $ >
  $ wi ph (wceq (csu k Z A2) (co (cfv M F) (csu k (cfv (co M c1 caddc) cuz) A2) caddc)) $;

--| Sum from 0 to infinity in terms of sum from 1 to infinity. (Contributed by NM, 2-Jan-2006.) (Revised by Mario Carneiro, 24-Apr-2014.)
theorem isumnn0nn {k: setvar} (ph: wff) (A2: class k) (B2 F: class):
  $ wi (wceq (cv k) cc0) (wceq A2 B2) $ >
  $ wi (wa ph (wcel (cv k) cn0)) (wceq (cfv (cv k) F) A2) $ >
  $ wi (wa ph (wcel (cv k) cn0)) (wcel A2 cc) $ >
  $ wi ph (wcel (cseq caddc F cc0) (cdm cli)) $ >
  $ wi ph (wceq (csu k cn0 A2) (co B2 (csu k cn A2) caddc)) $;

--| The infinite sum of positive reals is positive. (Contributed by Paul Chapman, 9-Feb-2008.) (Revised by Mario Carneiro, 24-Apr-2014.)
theorem isumrpcl {k: setvar} (ph: wff) (A2: class k) (F M N W Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wceq W (cfv N cuz) $ >
  $ wi ph (wcel N Z) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) A2) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel A2 crp) $ >
  $ wi ph (wcel (cseq caddc F M) (cdm cli)) $ >
  $ wi ph (wcel (csu k W A2) crp) $;

--| Comparison of two infinite sums. (Contributed by Paul Chapman, 13-Nov-2007.) (Revised by Mario Carneiro, 24-Apr-2014.)
theorem isumle {k: setvar} (ph: wff) (A2 B2: class k) (F G M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) A2) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel A2 cr) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) G) B2) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel B2 cr) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wbr A2 B2 cle) $ >
  $ wi ph (wcel (cseq caddc F M) (cdm cli)) $ >
  $ wi ph (wcel (cseq caddc G M) (cdm cli)) $ >
  $ wi ph (wbr (csu k Z A2) (csu k Z B2) cle) $;

--| A finite sum of nonnegative numbers is less than or equal to its limit. (Contributed by Mario Carneiro, 24-Apr-2014.)
theorem isumless {k: setvar} (ph: wff) (A2: class) (B2: class k) (F M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wss A2 Z) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) B2) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel B2 cr) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wbr cc0 B2 cle) $ >
  $ wi ph (wcel (cseq caddc F M) (cdm cli)) $ >
  $ wi ph (wbr (csu k A2 B2) (csu k Z B2) cle) $;

--| An infinite sum of nonnegative terms is equal to the supremum of the partial sums. (Contributed by Mario Carneiro, 12-Jun-2014.)
theorem isumsup2 {x3 j k: setvar} (ph: wff x3) (A2: class k) (F: class) (G: class k) (M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wceq G (cseq caddc F M) $ >
  $ wi ph (wcel M cz) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) A2) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel A2 cr) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wbr cc0 A2 cle) $ >
  $ wi ph (wrex x3 (wral j (wbr (cfv (cv j) G) (cv x3) cle) Z) cr) $ >
  $ wi ph (wbr G (csup (crn G) cr clt) cli) $;

--| An infinite sum of nonnegative terms is equal to the supremum of the partial sums. (Contributed by Mario Carneiro, 12-Jun-2014.)
theorem isumsup {x3 j k: setvar} (ph: wff x3) (A2: class k) (F: class) (G: class k) (M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wceq G (cseq caddc F M) $ >
  $ wi ph (wcel M cz) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) A2) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel A2 cr) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wbr cc0 A2 cle) $ >
  $ wi ph (wrex x3 (wral j (wbr (cfv (cv j) G) (cv x3) cle) Z) cr) $ >
  $ wi ph (wceq (csu k Z A2) (csup (crn G) cr clt)) $;

--| A partial sum of a series with positive terms is less than the infinite sum. (Contributed by Jeff Madsen, 2-Sep-2009.) (Proof shortened by Mario Carneiro, 12-Mar-2015.)
theorem isumltss {k: setvar} (ph: wff) (A2: class) (B2: class k) (F M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wss A2 Z) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) B2) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel B2 crp) $ >
  $ wi ph (wcel (cseq caddc F M) (cdm cli)) $ >
  $ wi ph (wbr (csu k A2 B2) (csu k Z B2) clt) $;

--| Lemma for ~ climcnds : bound the original series by the condensed series. (Contributed by Mario Carneiro, 18-Jul-2014.)
theorem climcndslem1 {k n: setvar} (ph: wff) (F G: class) (N: class k n):
  $ wi (wa ph (wcel (cv k) cn)) (wcel (cfv (cv k) F) cr) $ >
  $ wi (wa ph (wcel (cv k) cn)) (wbr cc0 (cfv (cv k) F) cle) $ >
  $ wi (wa ph (wcel (cv k) cn)) (wbr (cfv (co (cv k) c1 caddc) F) (cfv (cv k) F) cle) $ >
  $ wi (wa ph (wcel (cv n) cn0)) (wceq (cfv (cv n) G) (co (co c2 (cv n) cexp) (cfv (co c2 (cv n) cexp) F) cmul)) $ >
  $ wi (wa ph (wcel N cn0)) (wbr (cfv (co (co c2 (co N c1 caddc) cexp) c1 cmin) (cseq caddc F c1)) (cfv N (cseq caddc G cc0)) cle) $;

--| Lemma for ~ climcnds : bound the condensed series by the original series. (Contributed by Mario Carneiro, 18-Jul-2014.) (Proof shortened by AV, 10-Jul-2022.)
theorem climcndslem2 {k n: setvar} (ph: wff) (F G: class) (N: class k n):
  $ wi (wa ph (wcel (cv k) cn)) (wcel (cfv (cv k) F) cr) $ >
  $ wi (wa ph (wcel (cv k) cn)) (wbr cc0 (cfv (cv k) F) cle) $ >
  $ wi (wa ph (wcel (cv k) cn)) (wbr (cfv (co (cv k) c1 caddc) F) (cfv (cv k) F) cle) $ >
  $ wi (wa ph (wcel (cv n) cn0)) (wceq (cfv (cv n) G) (co (co c2 (cv n) cexp) (cfv (co c2 (cv n) cexp) F) cmul)) $ >
  $ wi (wa ph (wcel N cn)) (wbr (cfv N (cseq caddc G c1)) (co c2 (cfv (co c2 N cexp) (cseq caddc F c1)) cmul) cle) $;

--| The Cauchy condensation test. If ` a ( k ) ` is a decreasing sequence of nonnegative terms, then ` sum_ k e. NN a ( k ) ` converges iff ` sum_ n e. NN0 2 ^ n x. a ( 2 ^ n ) ` converges. (Contributed by Mario Carneiro, 18-Jul-2014.) (Proof shortened by AV, 10-Jul-2022.)
theorem climcnds {k n: setvar} (ph: wff) (F G: class):
  $ wi (wa ph (wcel (cv k) cn)) (wcel (cfv (cv k) F) cr) $ >
  $ wi (wa ph (wcel (cv k) cn)) (wbr cc0 (cfv (cv k) F) cle) $ >
  $ wi (wa ph (wcel (cv k) cn)) (wbr (cfv (co (cv k) c1 caddc) F) (cfv (cv k) F) cle) $ >
  $ wi (wa ph (wcel (cv n) cn0)) (wceq (cfv (cv n) G) (co (co c2 (cv n) cexp) (cfv (co c2 (cv n) cexp) F) cmul)) $ >
  $ wi ph (wb (wcel (cseq caddc F c1) (cdm cli)) (wcel (cseq caddc G cc0) (cdm cli))) $;

--| The sequence of reciprocals of real numbers, multiplied by the factor ` A ` , converges to zero. (Contributed by Mario Carneiro, 18-Sep-2014.)
theorem divrcnv {n: setvar} (A2: class):
  $ wi (wcel A2 cc) (wbr (cmpt n crp (co A2 (cv n) cdiv)) cc0 crli) $;

--| The sequence of reciprocals of positive integers, multiplied by the factor ` A ` , converges to zero. (Contributed by NM, 6-Feb-2008.) (Revised by Mario Carneiro, 18-Sep-2014.)
theorem divcnv {n: setvar} (A2: class):
  $ wi (wcel A2 cc) (wbr (cmpt n cn (co A2 (cv n) cdiv)) cc0 cli) $;

--| The floor function satisfies ` |_ ( x ) = x + O(1) ` . (Contributed by Mario Carneiro, 21-May-2016.)
theorem flo1 {x3: setvar}:
  $ wcel (cmpt x3 cr (co (cv x3) (cfv (cv x3) cfl) cmin)) co1 $;

--| Limit of a ratio function. (Contributed by Scott Fenton, 16-Dec-2017.)
theorem divcnvshft {k: setvar} (ph: wff) (A2 B2 F M: class) (V: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cz) $ >
  $ wi ph (wcel F V) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) (co A2 (co (cv k) B2 caddc) cdiv)) $ >
  $ wi ph (wbr F cc0 cli) $;

--| Extract a sequence ` f ` in ` X ` such that the image of the points in the bounded set ` A ` converges to the supremum ` S ` of the set. Similar to Equation 4 of [Kreyszig] p. 144. The proof uses countable choice ~ ax-cc . (Contributed by Mario Carneiro, 15-Feb-2013.) (Proof shortened by Mario Carneiro, 26-Apr-2014.)
theorem supcvg {x3 y1 f2 n: setvar} (ph: wff x3 y1) (A2: class f2 n) (R: class y1 n) (S: class x3 y1 f2) (F X: class y1 n):
  $ wcel X cvv $ >
  $ wceq S (csup A2 cr clt) $ >
  $ wceq R (cmpt n cn (co S (co c1 (cv n) cdiv) cmin)) $ >
  $ wi ph (wne X c0) $ >
  $ wi ph (wfo X A2 F) $ >
  $ wi ph (wss A2 cr) $ >
  $ wi ph (wrex x3 (wral y1 (wbr (cv y1) (cv x3) cle) A2) cr) $ >
  $ wi ph (wex f2 (wa (wf cn X (cv f2)) (wbr (ccom F (cv f2)) S cli))) $;

--| Auxiliary theorem for applications of ~ supcvg . Hypothesis for several supremum theorems. (Contributed by NM, 8-Feb-2008.)
theorem infcvgaux1i {x3 y1 z w: setvar} (A2: class y1 z w) (R: class x3 y1) (X Z: class z w):
  $ wceq R (cab x3 (wrex y1 (wceq (cv x3) (cneg A2)) X)) $ >
  $ wi (wcel (cv y1) X) (wcel A2 cr) $ >
  $ wcel Z X $ >
  $ wrex z (wral w (wbr (cv w) (cv z) cle) R) cr $ >
  $ w3a (wss R cr) (wne R c0) (wrex z (wral w (wbr (cv w) (cv z) cle) R) cr) $;

--| Auxiliary theorem for applications of ~ supcvg . (Contributed by NM, 4-Mar-2008.)
theorem infcvgaux2i {x3 y1 z w: setvar} (A2: class y1 z w) (B2: class z w) (C: class x3 z w) (R: class x3 y1) (S: class x3 y1 z w) (X Z: class z w):
  $ wceq R (cab x3 (wrex y1 (wceq (cv x3) (cneg A2)) X)) $ >
  $ wi (wcel (cv y1) X) (wcel A2 cr) $ >
  $ wcel Z X $ >
  $ wrex z (wral w (wbr (cv w) (cv z) cle) R) cr $ >
  $ wceq S (cneg (csup R cr clt)) $ >
  $ wi (wceq (cv y1) C) (wceq A2 B2) $ >
  $ wi (wcel C X) (wbr S B2 cle) $;

--| The harmonic series ` H ` diverges. This fact follows from the stronger ~ emcl , which establishes that the harmonic series grows as ` log n + gamma + ` _o_(1), but this uses a more elementary method, attributed to Nicole Oresme (1323-1382). This is Metamath 100 proof #34. (Contributed by Mario Carneiro, 11-Jul-2014.)
theorem harmonic {n: setvar} (F H: class n):
  $ wceq F (cmpt n cn (co c1 (cv n) cdiv)) $ >
  $ wceq H (cseq caddc F c1) $ >
  $ wn (wcel H (cdm cli)) $;

--| Arithmetic series sum of the first ` N ` positive integers. This is Metamath 100 proof #68. (Contributed by FL, 16-Nov-2006.) (Proof shortened by Mario Carneiro, 22-May-2014.)
theorem arisum {k: setvar} (N: class):
  $ wi (wcel N cn0) (wceq (csu k (co c1 N cfz) (cv k)) (co (co (co N c2 cexp) N caddc) c2 cdiv)) $;

--| Arithmetic series sum of the first ` N ` nonnegative integers. (Contributed by Mario Carneiro, 17-Apr-2015.) (Proof shortened by AV, 2-Aug-2021.) (Proof shortened by Timothy J. O'Malley, 9-Oct-2026.)
theorem arisum2 {k: setvar} (N: class):
  $ wi (wcel N cn0) (wceq (csu k (co cc0 (co N c1 cmin) cfz) (cv k)) (co (co (co N c2 cexp) N cmin) c2 cdiv)) $;

--| Lemma for ~ trirecip . Show that the sum converges. (Contributed by Scott Fenton, 22-Apr-2014.) (Revised by Mario Carneiro, 22-May-2014.)
theorem trireciplem {n: setvar} (F: class n):
  $ wceq F (cmpt n cn (co c1 (co (cv n) (co (cv n) c1 caddc) cmul) cdiv)) $ >
  $ wbr (cseq caddc F c1) c1 cli $;

--| The sum of the reciprocals of the triangle numbers converge to two. This is Metamath 100 proof #42. (Contributed by Scott Fenton, 23-Apr-2014.) (Revised by Mario Carneiro, 22-May-2014.)
theorem trirecip {k: setvar}:
  $ wceq (csu k cn (co c2 (co (cv k) (co (cv k) c1 caddc) cmul) cdiv)) c2 $;

--| A sequence of powers of a complex number ` A ` with absolute value less than 1 converges to zero. (Contributed by NM, 8-May-2006.) (Proof shortened by Mario Carneiro, 26-Apr-2014.)
theorem expcnv {n: setvar} (ph: wff n) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wbr (cfv A2 cabs) c1 clt) $ >
  $ wi ph (wbr (cmpt n cn0 (co A2 (cv n) cexp)) cc0 cli) $;

--| A sequence of terms converges to zero when it is less than powers of a number ` A ` whose absolute value is less than 1. (Contributed by NM, 19-Jul-2008.) (Revised by Mario Carneiro, 26-Apr-2014.)
theorem explecnv {k: setvar} (ph: wff) (A2 F M: class) (V: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel F V) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wbr (cfv A2 cabs) c1 clt) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wbr (cfv (cfv (cv k) F) cabs) (co A2 (cv k) cexp) cle) $ >
  $ wi ph (wbr F cc0 cli) $;

--| The value of the finite geometric series ` A ^ M + A ^ ( M + 1 ) + ` ... ` + A ^ ( N - 1 ) ` . (Contributed by Mario Carneiro, 2-May-2016.)
theorem geoserg {k: setvar} (ph: wff) (A2 M N: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wne A2 c1) $ >
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi ph (wceq (csu k (co M N cfzo) (co A2 (cv k) cexp)) (co (co (co A2 M cexp) (co A2 N cexp) cmin) (co c1 A2 cmin) cdiv)) $;

--| The value of the finite geometric series ` 1 + A ^ 1 + A ^ 2 + ` ... ` + A ^ ( N - 1 ) ` . This is Metamath 100 proof #66. (Contributed by NM, 12-May-2006.) (Proof shortened by Mario Carneiro, 15-Jun-2014.)
theorem geoser {k: setvar} (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wne A2 c1) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (csu k (co cc0 (co N c1 cmin) cfz) (co A2 (cv k) cexp)) (co (co c1 (co A2 N cexp) cmin) (co c1 A2 cmin) cdiv)) $;

--| The difference of two numbers to the same power is the difference of the two numbers multiplied with a finite sum. Generalization of ~ subsq . See Wikipedia "Fermat number", section "Other theorems about Fermat numbers", ~ https://en.wikipedia.org/wiki/Fermat_number , 5-Aug-2021. (Contributed by AV, 6-Aug-2021.) (Revised by AV, 19-Aug-2021.)
theorem pwdif {k: setvar} (A2 B2 N: class):
  $ wi (w3a (wcel N cn0) (wcel A2 cc) (wcel B2 cc)) (wceq (co (co A2 N cexp) (co B2 N cexp) cmin) (co (co A2 B2 cmin) (csu k (co cc0 N cfzo) (co (co A2 (cv k) cexp) (co B2 (co (co N (cv k) cmin) c1 cmin) cexp) cmul)) cmul)) $;

--| The n-th power of a number decreased by 1 expressed by the finite geometric series ` 1 + A ^ 1 + A ^ 2 + ` ... ` + A ^ ( N - 1 ) ` . (Contributed by AV, 14-Aug-2021.) (Proof shortened by AV, 19-Aug-2021.)
theorem pwm1geoser {k: setvar} (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (co (co A2 N cexp) c1 cmin) (co (co A2 c1 cmin) (csu k (co cc0 (co N c1 cmin) cfz) (co A2 (cv k) cexp)) cmul)) $;

--| The partial sums in the infinite series ` 1 + A ^ 1 + A ^ 2 ` ... converge to ` ( 1 / ( 1 - A ) ) ` . (Contributed by NM, 15-May-2006.)
theorem geolim {k: setvar} (ph: wff) (A2 F: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wbr (cfv A2 cabs) c1 clt) $ >
  $ wi (wa ph (wcel (cv k) cn0)) (wceq (cfv (cv k) F) (co A2 (cv k) cexp)) $ >
  $ wi ph (wbr (cseq caddc F cc0) (co c1 (co c1 A2 cmin) cdiv) cli) $;

--| The partial sums in the geometric series ` A ^ M + A ^ ( M + 1 ) ` ... converge to ` ( ( A ^ M ) / ( 1 - A ) ) ` . (Contributed by NM, 6-Jun-2006.) (Revised by Mario Carneiro, 26-Apr-2014.)
theorem geolim2 {k: setvar} (ph: wff) (A2 F M: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wbr (cfv A2 cabs) c1 clt) $ >
  $ wi ph (wcel M cn0) $ >
  $ wi (wa ph (wcel (cv k) (cfv M cuz))) (wceq (cfv (cv k) F) (co A2 (cv k) cexp)) $ >
  $ wi ph (wbr (cseq caddc F M) (co (co A2 M cexp) (co c1 A2 cmin) cdiv) cli) $;

--| The limit of a geometric series of reciprocals. (Contributed by Paul Chapman, 28-Dec-2007.) (Revised by Mario Carneiro, 26-Apr-2014.)
theorem georeclim {k: setvar} (ph: wff) (A2 F: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wbr c1 (cfv A2 cabs) clt) $ >
  $ wi (wa ph (wcel (cv k) cn0)) (wceq (cfv (cv k) F) (co (co c1 A2 cdiv) (cv k) cexp)) $ >
  $ wi ph (wbr (cseq caddc F cc0) (co A2 (co A2 c1 cmin) cdiv) cli) $;

--| The value of the finite geometric series ` 2 ^ -u 1 + 2 ^ -u 2 + ` ... ` + 2 ^ -u N ` , multiplied by a constant. (Contributed by Mario Carneiro, 17-Mar-2014.) (Revised by Mario Carneiro, 26-Apr-2014.)
theorem geo2sum {k: setvar} (A2 N: class):
  $ wi (wa (wcel N cn) (wcel A2 cc)) (wceq (csu k (co c1 N cfz) (co A2 (co c2 (cv k) cexp) cdiv)) (co A2 (co A2 (co c2 N cexp) cdiv) cmin)) $;

--| The value of the finite geometric series ` 1 + 2 + 4 + 8 + ` ... ` + 2 ^ ( N - 1 ) ` . (Contributed by Mario Carneiro, 7-Sep-2016.)
theorem geo2sum2 {k: setvar} (N: class):
  $ wi (wcel N cn0) (wceq (csu k (co cc0 N cfzo) (co c2 (cv k) cexp)) (co (co c2 N cexp) c1 cmin)) $;

--| The value of the infinite geometric series ` 2 ^ -u 1 + 2 ^ -u 2 + ` ... , multiplied by a constant. (Contributed by Mario Carneiro, 15-Jun-2014.)
theorem geo2lim {k: setvar} (A2: class) (F: class k):
  $ wceq F (cmpt k cn (co A2 (co c2 (cv k) cexp) cdiv)) $ >
  $ wi (wcel A2 cc) (wbr (cseq caddc F c1) A2 cli) $;

--| The geometric series converges even if it is multiplied by ` k ` to result in the larger series ` k x. A ^ k ` . (Contributed by Mario Carneiro, 27-Mar-2015.)
theorem geomulcvg {k: setvar} (A2: class) (F: class k):
  $ wceq F (cmpt k cn0 (co (cv k) (co A2 (cv k) cexp) cmul)) $ >
  $ wi (wa (wcel A2 cc) (wbr (cfv A2 cabs) c1 clt)) (wcel (cseq caddc F cc0) (cdm cli)) $;

--| The infinite sum of ` 1 + A ^ 1 + A ^ 2 ` ... is ` ( 1 / ( 1 - A ) ) ` . (Contributed by NM, 15-May-2006.) (Revised by Mario Carneiro, 26-Apr-2014.)
theorem geoisum {k: setvar} (A2: class):
  $ wi (wa (wcel A2 cc) (wbr (cfv A2 cabs) c1 clt)) (wceq (csu k cn0 (co A2 (cv k) cexp)) (co c1 (co c1 A2 cmin) cdiv)) $;

--| The infinite sum of reciprocals ` 1 + ( 1 / A ) ^ 1 + ( 1 / A ) ^ 2 ` ... is ` A / ( A - 1 ) ` . (Contributed by rpenner, 3-Nov-2007.) (Revised by Mario Carneiro, 26-Apr-2014.)
theorem geoisumr {k: setvar} (A2: class):
  $ wi (wa (wcel A2 cc) (wbr c1 (cfv A2 cabs) clt)) (wceq (csu k cn0 (co (co c1 A2 cdiv) (cv k) cexp)) (co A2 (co A2 c1 cmin) cdiv)) $;

--| The infinite sum of ` A ^ 1 + A ^ 2 ` ... is ` ( A / ( 1 - A ) ) ` . (Contributed by NM, 1-Nov-2007.) (Revised by Mario Carneiro, 26-Apr-2014.)
theorem geoisum1 {k: setvar} (A2: class):
  $ wi (wa (wcel A2 cc) (wbr (cfv A2 cabs) c1 clt)) (wceq (csu k cn (co A2 (cv k) cexp)) (co A2 (co c1 A2 cmin) cdiv)) $;

--| The infinite sum of ` A x. ( R ^ 1 ) + A x. ( R ^ 2 ) ` ... is ` ( A x. R ) / ( 1 - R ) ` . (Contributed by NM, 2-Nov-2007.) (Revised by Mario Carneiro, 26-Apr-2014.)
theorem geoisum1c {k: setvar} (A2 R: class):
  $ wi (w3a (wcel A2 cc) (wcel R cc) (wbr (cfv R cabs) c1 clt)) (wceq (csu k cn (co A2 (co R (cv k) cexp) cmul)) (co (co A2 R cmul) (co c1 R cmin) cdiv)) $;

--| The recurring decimal 0.999..., which is defined as the infinite sum 0.9 + 0.09 + 0.009 + ... i.e. ` 9 / 1 0 ^ 1 + 9 / 1 0 ^ 2 + 9 / 1 0 ^ 3 ` ` + ... ` , is exactly equal to 1, according to ZF set theory. Interestingly, about 40% of the people responding to a poll at ~ http://forum.physorg.com/index.php?showtopic=13177 disagree. (Contributed by NM, 2-Nov-2007.) (Revised by AV, 8-Sep-2021.)
theorem _0_999___ {k: setvar}:
  $ wceq (csu k cn (co c9 (co (cdc c1 cc0) (cv k) cexp) cdiv)) c1 $;

--| Prove that the infinite geometric series of 1/2, 1/2 + 1/4 + 1/8 + ... = 1. Uses ~ geoisum1 . This is a representation of .111... in binary with an infinite number of 1's. Theorem ~ 0.999... proves a similar claim for .999... in base 10. (Contributed by David A. Wheeler, 4-Jan-2017.) (Proof shortened by AV, 9-Jul-2022.)
theorem geoihalfsum {k: setvar}:
  $ wceq (csu k cn (co c1 (co c2 (cv k) cexp) cdiv)) c1 $;

--| Ratio test for convergence of a complex infinite series. If the ratio ` A ` of the absolute values of successive terms in an infinite sequence ` F ` is less than 1 for all terms beyond some index ` B ` , then the infinite sum of the terms of ` F ` converges to a complex number. Equivalent to first part of Exercise 4 of [Gleason] p. 182. (Contributed by NM, 26-Apr-2005.) (Proof shortened by Mario Carneiro, 27-Apr-2014.)
theorem cvgrat {k: setvar} (ph: wff) (A2 F M N W Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wceq W (cfv N cuz) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wbr A2 c1 clt) $ >
  $ wi ph (wcel N Z) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wi (wa ph (wcel (cv k) W)) (wbr (cfv (cfv (co (cv k) c1 caddc) F) cabs) (co A2 (cfv (cfv (cv k) F) cabs) cmul) cle) $ >
  $ wi ph (wcel (cseq caddc F M) (cdm cli)) $;

--| Lemma for ~ mertens . (Contributed by Mario Carneiro, 29-Apr-2014.)
theorem mertenslem1 {y1 z w t j k m n s1: setvar} (ph: wff w t n s1) (ps: wff w s1) (A2: class z w j) (B2: class w k) (T: class s1) (E: class w) (F: class z w t k s1) (G: class w t) (H: class z w t j n s1) (K: class w):
  $ wi (wa ph (wcel (cv j) cn0)) (wceq (cfv (cv j) F) A2) $ >
  $ wi (wa ph (wcel (cv j) cn0)) (wceq (cfv (cv j) K) (cfv A2 cabs)) $ >
  $ wi (wa ph (wcel (cv j) cn0)) (wcel A2 cc) $ >
  $ wi (wa ph (wcel (cv k) cn0)) (wceq (cfv (cv k) G) B2) $ >
  $ wi (wa ph (wcel (cv k) cn0)) (wcel B2 cc) $ >
  $ wi (wa ph (wcel (cv k) cn0)) (wceq (cfv (cv k) H) (csu j (co cc0 (cv k) cfz) (co A2 (cfv (co (cv k) (cv j) cmin) G) cmul))) $ >
  $ wi ph (wcel (cseq caddc K cc0) (cdm cli)) $ >
  $ wi ph (wcel (cseq caddc G cc0) (cdm cli)) $ >
  $ wi ph (wcel E crp) $ >
  $ wceq T (cab z (wrex n (wceq (cv z) (cfv (csu k (cfv (co (cv n) c1 caddc) cuz) (cfv (cv k) G)) cabs)) (co cc0 (co (cv s1) c1 cmin) cfz))) $ >
  $ wb ps (wa (wcel (cv s1) cn) (wral n (wbr (cfv (csu k (cfv (co (cv n) c1 caddc) cuz) (cfv (cv k) G)) cabs) (co (co E c2 cdiv) (co (csu j cn0 (cfv (cv j) K)) c1 caddc) cdiv) clt) (cfv (cv s1) cuz))) $ >
  $ wi ph (wa ps (wa (wcel (cv t) cn0) (wral m (wbr (cfv (cv m) K) (co (co (co E c2 cdiv) (cv s1) cdiv) (co (csup T cr clt) c1 caddc) cdiv) clt) (cfv (cv t) cuz)))) $ >
  $ wi ph (wa (wbr cc0 (csup T cr clt) cle) (w3a (wss T cr) (wne T c0) (wrex z (wral w (wbr (cv w) (cv z) cle) T) cr))) $ >
  $ wi ph (wrex y1 (wral m (wbr (cfv (csu j (co cc0 (cv m) cfz) (co A2 (csu k (cfv (co (co (cv m) (cv j) cmin) c1 caddc) cuz) B2) cmul)) cabs) E clt) (cfv (cv y1) cuz)) cn0) $;

--| Lemma for ~ mertens . (Contributed by Mario Carneiro, 28-Apr-2014.)
theorem mertenslem2 {y1 z j k m n s1: setvar} (ph: wff) (ps: wff s1) (A2: class z j) (B2: class k) (T: class s1) (E: class) (F: class z k s1) (G: class) (H: class z j n s1) (K: class):
  $ wi (wa ph (wcel (cv j) cn0)) (wceq (cfv (cv j) F) A2) $ >
  $ wi (wa ph (wcel (cv j) cn0)) (wceq (cfv (cv j) K) (cfv A2 cabs)) $ >
  $ wi (wa ph (wcel (cv j) cn0)) (wcel A2 cc) $ >
  $ wi (wa ph (wcel (cv k) cn0)) (wceq (cfv (cv k) G) B2) $ >
  $ wi (wa ph (wcel (cv k) cn0)) (wcel B2 cc) $ >
  $ wi (wa ph (wcel (cv k) cn0)) (wceq (cfv (cv k) H) (csu j (co cc0 (cv k) cfz) (co A2 (cfv (co (cv k) (cv j) cmin) G) cmul))) $ >
  $ wi ph (wcel (cseq caddc K cc0) (cdm cli)) $ >
  $ wi ph (wcel (cseq caddc G cc0) (cdm cli)) $ >
  $ wi ph (wcel E crp) $ >
  $ wceq T (cab z (wrex n (wceq (cv z) (cfv (csu k (cfv (co (cv n) c1 caddc) cuz) (cfv (cv k) G)) cabs)) (co cc0 (co (cv s1) c1 cmin) cfz))) $ >
  $ wb ps (wa (wcel (cv s1) cn) (wral n (wbr (cfv (csu k (cfv (co (cv n) c1 caddc) cuz) (cfv (cv k) G)) cabs) (co (co E c2 cdiv) (co (csu j cn0 (cfv (cv j) K)) c1 caddc) cdiv) clt) (cfv (cv s1) cuz))) $ >
  $ wi ph (wrex y1 (wral m (wbr (cfv (csu j (co cc0 (cv m) cfz) (co A2 (csu k (cfv (co (co (cv m) (cv j) cmin) c1 caddc) cuz) B2) cmul)) cabs) E clt) (cfv (cv y1) cuz)) cn0) $;

--| Mertens' theorem. If ` A ( j ) ` is an absolutely convergent series and ` B ( k ) ` is convergent, then ` ( sum_ j e. NN0 A ( j ) x. sum_ k e. NN0 B ( k ) ) = ` ` sum_ k e. NN0 sum_ j e. ( 0 ... k ) ( A ( j ) x. B ( k - j ) ) ` (and this latter series is convergent). This latter sum is commonly known as the Cauchy product of the sequences. The proof follows the outline at ~ http://en.wikipedia.org/wiki/Cauchy_product#Proof_of_Mertens.27_theorem . (Contributed by Mario Carneiro, 29-Apr-2014.)
theorem mertens {j k: setvar} (ph: wff) (A2: class j) (B2 F: class k) (G: class) (H: class j) (K: class):
  $ wi (wa ph (wcel (cv j) cn0)) (wceq (cfv (cv j) F) A2) $ >
  $ wi (wa ph (wcel (cv j) cn0)) (wceq (cfv (cv j) K) (cfv A2 cabs)) $ >
  $ wi (wa ph (wcel (cv j) cn0)) (wcel A2 cc) $ >
  $ wi (wa ph (wcel (cv k) cn0)) (wceq (cfv (cv k) G) B2) $ >
  $ wi (wa ph (wcel (cv k) cn0)) (wcel B2 cc) $ >
  $ wi (wa ph (wcel (cv k) cn0)) (wceq (cfv (cv k) H) (csu j (co cc0 (cv k) cfz) (co A2 (cfv (co (cv k) (cv j) cmin) G) cmul))) $ >
  $ wi ph (wcel (cseq caddc K cc0) (cdm cli)) $ >
  $ wi ph (wcel (cseq caddc G cc0) (cdm cli)) $ >
  $ wi ph (wbr (cseq caddc H cc0) (co (csu j cn0 A2) (csu k cn0 B2) cmul) cli) $;

--| An infinite product of complex terms is a function from an upper set of integers to ` CC ` . (Contributed by Scott Fenton, 4-Dec-2017.)
theorem prodf {k: setvar} (ph: wff) (F M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wi ph (wf Z cc (cseq cmul F M)) $;

--| The limit of an infinite product with an initial segment added. (Contributed by Scott Fenton, 18-Dec-2017.)
theorem clim2prod {k: setvar} (ph: wff) (A2 F M N Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel N Z) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wi ph (wbr (cseq cmul F (co N c1 caddc)) A2 cli) $ >
  $ wi ph (wbr (cseq cmul F M) (co (cfv N (cseq cmul F M)) A2 cmul) cli) $;

--| The limit of an infinite product with an initial segment removed. (Contributed by Scott Fenton, 20-Dec-2017.)
theorem clim2div {k: setvar} (ph: wff) (A2: class k) (F M N Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel N Z) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wi ph (wbr (cseq cmul F M) A2 cli) $ >
  $ wi ph (wne (cfv N (cseq cmul F M)) cc0) $ >
  $ wi ph (wbr (cseq cmul F (co N c1 caddc)) (co A2 (cfv N (cseq cmul F M)) cdiv) cli) $;

--| The product of two infinite products. (Contributed by Scott Fenton, 18-Dec-2017.)
theorem prodfmul {k: setvar} (ph: wff) (F G H M N: class):
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel (cfv (cv k) F) cc) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel (cfv (cv k) G) cc) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wceq (cfv (cv k) H) (co (cfv (cv k) F) (cfv (cv k) G) cmul)) $ >
  $ wi ph (wceq (cfv N (cseq cmul H M)) (co (cfv N (cseq cmul F M)) (cfv N (cseq cmul G M)) cmul)) $;

--| The value of the partial products in a one-valued infinite product. (Contributed by Scott Fenton, 5-Dec-2017.)
theorem prodf1 (M N Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi (wcel N Z) (wceq (cfv N (cseq cmul (cxp Z (csn c1)) M)) c1) $;

--| A one-valued infinite product is equal to the constant one function. (Contributed by Scott Fenton, 5-Dec-2017.)
theorem prodf1f (M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi (wcel M cz) (wceq (cseq cmul (cxp Z (csn c1)) M) (cxp Z (csn c1))) $;

--| The constant one product converges to one. (Contributed by Scott Fenton, 5-Dec-2017.)
theorem prodfclim1 (M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi (wcel M cz) (wbr (cseq cmul (cxp Z (csn c1)) M) c1 cli) $;

--| No term of a nonzero infinite product is zero. (Contributed by Scott Fenton, 14-Jan-2018.)
theorem prodfn0 {k: setvar} (ph: wff) (F M N: class):
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel (cfv (cv k) F) cc) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wne (cfv (cv k) F) cc0) $ >
  $ wi ph (wne (cfv N (cseq cmul F M)) cc0) $;

--| The reciprocal of an infinite product. (Contributed by Scott Fenton, 15-Jan-2018.)
theorem prodfrec {k: setvar} (ph: wff) (F G M N: class):
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel (cfv (cv k) F) cc) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wne (cfv (cv k) F) cc0) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wceq (cfv (cv k) G) (co c1 (cfv (cv k) F) cdiv)) $ >
  $ wi ph (wceq (cfv N (cseq cmul G M)) (co c1 (cfv N (cseq cmul F M)) cdiv)) $;

--| The quotient of two infinite products. (Contributed by Scott Fenton, 15-Jan-2018.)
theorem prodfdiv {k: setvar} (ph: wff) (F G H M N: class):
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel (cfv (cv k) F) cc) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel (cfv (cv k) G) cc) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wne (cfv (cv k) G) cc0) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wceq (cfv (cv k) H) (co (cfv (cv k) F) (cfv (cv k) G) cdiv)) $ >
  $ wi ph (wceq (cfv N (cseq cmul H M)) (co (cfv N (cseq cmul F M)) (cfv N (cseq cmul G M)) cdiv)) $;

--| A non-trivially converging infinite product converges. (Contributed by Scott Fenton, 18-Dec-2017.)
theorem ntrivcvg {y1 k n: setvar} (ph: wff) (F M: class) (Z: class n):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wrex n (wex y1 (wa (wne (cv y1) cc0) (wbr (cseq cmul F (cv n)) (cv y1) cli))) Z) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wi ph (wcel (cseq cmul F M) (cdm cli)) $;

--| A product that converges to a nonzero value converges non-trivially. (Contributed by Scott Fenton, 18-Dec-2017.)
theorem ntrivcvgn0 {y1 n: setvar} (ph: wff y1 n) (F M: class) (X: class n) (Z: class y1):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wbr (cseq cmul F M) X cli) $ >
  $ wi ph (wne X cc0) $ >
  $ wi ph (wrex n (wex y1 (wa (wne (cv y1) cc0) (wbr (cseq cmul F (cv n)) (cv y1) cli))) Z) $;

--| Any value of a product sequence that converges to a nonzero value is itself nonzero. (Contributed by Scott Fenton, 20-Dec-2017.)
theorem ntrivcvgfvn0 {k: setvar} (ph: wff) (F M N: class) (X: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel N Z) $ >
  $ wi ph (wbr (cseq cmul F M) X cli) $ >
  $ wi ph (wne X cc0) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wi ph (wne (cfv N (cseq cmul F M)) cc0) $;

--| A tail of a non-trivially convergent sequence converges non-trivially. (Contributed by Scott Fenton, 20-Dec-2017.)
theorem ntrivcvgtail {k: setvar} (ph: wff) (F M N: class) (X: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel N Z) $ >
  $ wi ph (wbr (cseq cmul F M) X cli) $ >
  $ wi ph (wne X cc0) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wi ph (wa (wne (cfv (cseq cmul F N) cli) cc0) (wbr (cseq cmul F N) (cfv (cseq cmul F N) cli) cli)) $;

--| Lemma for ~ ntrivcvgmul . (Contributed by Scott Fenton, 19-Dec-2017.)
theorem ntrivcvgmullem {w k q: setvar} (ph: wff w q) (P: class) (F: class q) (G: class w q) (H: class) (M: class w k q) (N: class w q) (X: class w k q) (Y: class k q) (Z: class w):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel N Z) $ >
  $ wi ph (wcel P Z) $ >
  $ wi ph (wne X cc0) $ >
  $ wi ph (wne Y cc0) $ >
  $ wi ph (wbr (cseq cmul F N) X cli) $ >
  $ wi ph (wbr (cseq cmul G P) Y cli) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) G) cc) $ >
  $ wi ph (wbr N P cle) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) H) (co (cfv (cv k) F) (cfv (cv k) G) cmul)) $ >
  $ wi ph (wrex q (wex w (wa (wne (cv w) cc0) (wbr (cseq cmul H (cv q)) (cv w) cli))) Z) $;

--| The product of two non-trivially converging products converges non-trivially. (Contributed by Scott Fenton, 18-Dec-2017.)
theorem ntrivcvgmul {y1 z w k m n p: setvar} (ph: wff w p) (F: class y1 n p) (G: class z m p) (H: class) (M: class y1 z w k m n p) (Z: class w):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wrex n (wex y1 (wa (wne (cv y1) cc0) (wbr (cseq cmul F (cv n)) (cv y1) cli))) Z) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) F) cc) $ >
  $ wi ph (wrex m (wex z (wa (wne (cv z) cc0) (wbr (cseq cmul G (cv m)) (cv z) cli))) Z) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel (cfv (cv k) G) cc) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) H) (co (cfv (cv k) F) (cfv (cv k) G) cmul)) $ >
  $ wi ph (wrex p (wex w (wa (wne (cv w) cc0) (wbr (cseq cmul H (cv p)) (cv w) cli))) Z) $;

--| Extend class notation to include complex products.
term cprod {k: setvar} (A2 B2: class k): class;

--| Define the product of a series with an index set of integers ` A ` . This definition takes most of the aspects of ~ df-sum and adapts them for multiplication instead of addition. However, we insist that in the infinite case, there is a nonzero tail of the sequence. This ensures that the convergence criteria match those of infinite sums. (Contributed by Scott Fenton, 4-Dec-2017.)
axiom df_prod {x3 y1 f2 k m n: setvar} (A2 B2: class k):
  $ wceq (cprod k A2 B2) (cio x3 (wo (wrex m (w3a (wss A2 (cfv (cv m) cuz)) (wrex n (wex y1 (wa (wne (cv y1) cc0) (wbr (cseq cmul (cmpt k cz (cif (wcel (cv k) A2) B2 c1)) (cv n)) (cv y1) cli))) (cfv (cv m) cuz)) (wbr (cseq cmul (cmpt k cz (cif (wcel (cv k) A2) B2 c1)) (cv m)) (cv x3) cli)) cz) (wrex m (wex f2 (wa (wf1o (co c1 (cv m) cfz) A2 (cv f2)) (wceq (cv x3) (cfv (cv m) (cseq cmul (cmpt n cn (csb k (cfv (cv n) (cv f2)) B2)) c1))))) cn))) $;

--| A product is a set. (Contributed by Scott Fenton, 4-Dec-2017.)
theorem prodex {k: setvar} (A2 B2: class k):
  $ wcel (cprod k A2 B2) cvv $;

--| Equality theorem for a product. (Contributed by Scott Fenton, 1-Dec-2017.)
theorem prodeq1f {k: setvar} (A2 B2 C: class k):
  $ wnfc k A2 $ >
  $ wnfc k B2 $ >
  $ wi (wceq A2 B2) (wceq (cprod k A2 C) (cprod k B2 C)) $;

--| Equality theorem for a product. (Contributed by Scott Fenton, 1-Dec-2017.)
theorem prodeq1 {k: setvar} (A2 B2: class) (C: class k):
  $ wi (wceq A2 B2) (wceq (cprod k A2 C) (cprod k B2 C)) $;

--| Bound-variable hypothesis builder for product. (Contributed by Scott Fenton, 4-Dec-2017.)
theorem nfcprod1 {k: setvar} (A2: class) (B2: class k):
  $ wnfc k A2 $ >
  $ wnfc k (cprod k A2 B2) $;

--| Bound-variable hypothesis builder for product: if ` x ` is (effectively) not free in ` A ` and ` B ` , it is not free in ` prod_ k e. A B ` . (Contributed by Scott Fenton, 1-Dec-2017.)
theorem nfcprod {x3 k: setvar} (A2 B2: class x3 k):
  $ wnfc x3 A2 $ >
  $ wnfc x3 B2 $ >
  $ wnfc x3 (cprod k A2 B2) $;

--| Equality theorem for product, when the class expressions ` B ` and ` C ` are equal everywhere. Proved using only Extensionality. (Contributed by Scott Fenton, 4-Dec-2017.)
theorem prodeq2w {k: setvar} (A2: class) (B2 C: class k):
  $ wi (wal k (wceq B2 C)) (wceq (cprod k A2 B2) (cprod k A2 C)) $;

--| Equality theorem for product, with the class expressions ` B ` and ` C ` guarded by ` _I ` to be always sets. (Contributed by Scott Fenton, 4-Dec-2017.)
theorem prodeq2ii {k: setvar} (A2: class) (B2 C: class k):
  $ wi (wral k (wceq (cfv B2 cid) (cfv C cid)) A2) (wceq (cprod k A2 B2) (cprod k A2 C)) $;

--| Equality theorem for product. (Contributed by Scott Fenton, 4-Dec-2017.)
theorem prodeq2 {k: setvar} (A2: class) (B2 C: class k):
  $ wi (wral k (wceq B2 C) A2) (wceq (cprod k A2 B2) (cprod k A2 C)) $;

--| Change bound variable in a product. (Contributed by Scott Fenton, 4-Dec-2017.)
theorem cbvprod {j k: setvar} (A2 B2 C: class j k):
  $ wi (wceq (cv j) (cv k)) (wceq B2 C) $ >
  $ wnfc k A2 $ >
  $ wnfc j A2 $ >
  $ wnfc k B2 $ >
  $ wnfc j C $ >
  $ wceq (cprod j A2 B2) (cprod k A2 C) $;

--| Change bound variable in a product. (Contributed by Scott Fenton, 4-Dec-2017.)
theorem cbvprodv {j k: setvar} (A2: class) (B2: class j) (C: class k):
  $ wi (wceq (cv j) (cv k)) (wceq B2 C) $ >
  $ wceq (cprod j A2 B2) (cprod k A2 C) $;

--| Change bound variable in a product. (Contributed by Scott Fenton, 4-Dec-2017.)
theorem cbvprodi {j k: setvar} (A2: class) (B2 C: class j k):
  $ wnfc k B2 $ >
  $ wnfc j C $ >
  $ wi (wceq (cv j) (cv k)) (wceq B2 C) $ >
  $ wceq (cprod j A2 B2) (cprod k A2 C) $;

--| Equality inference for product. (Contributed by Scott Fenton, 4-Dec-2017.) Remove DV conditions. (Revised by GG, 1-Sep-2025.)
theorem prodeq1i {k: setvar} (A2 B2 C: class k):
  $ wceq A2 B2 $ >
  $ wceq (cprod k A2 C) (cprod k B2 C) $;

--| Equality inference for product. (Contributed by Scott Fenton, 4-Dec-2017.)
theorem prodeq2i {k: setvar} (A2: class) (B2 C: class k):
  $ wi (wcel (cv k) A2) (wceq B2 C) $ >
  $ wceq (cprod k A2 B2) (cprod k A2 C) $;

--| Equality inference for product. (Contributed by Scott Fenton, 4-Dec-2017.)
theorem prodeq12i {k: setvar} (A2 B2: class) (C D: class k):
  $ wceq A2 B2 $ >
  $ wi (wcel (cv k) A2) (wceq C D) $ >
  $ wceq (cprod k A2 C) (cprod k B2 D) $;

--| Equality deduction for product. (Contributed by Scott Fenton, 4-Dec-2017.)
theorem prodeq1d {k: setvar} (ph: wff k) (A2 B2: class) (C: class k):
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq (cprod k A2 C) (cprod k B2 C)) $;

--| Equality deduction for product. Note that unlike ~ prodeq2dv , ` k ` may occur in ` ph ` . (Contributed by Scott Fenton, 4-Dec-2017.)
theorem prodeq2d {k: setvar} (ph: wff k) (A2: class) (B2 C: class k):
  $ wi ph (wral k (wceq B2 C) A2) $ >
  $ wi ph (wceq (cprod k A2 B2) (cprod k A2 C)) $;

--| Equality deduction for product. (Contributed by Scott Fenton, 4-Dec-2017.)
theorem prodeq2dv {k: setvar} (ph: wff) (A2: class) (B2 C: class k):
  $ wi (wa ph (wcel (cv k) A2)) (wceq B2 C) $ >
  $ wi ph (wceq (cprod k A2 B2) (cprod k A2 C)) $;

--| Equality deduction for product. (Contributed by Scott Fenton, 4-Dec-2017.) Avoid axioms. (Revised by GG, 1-Sep-2025.)
theorem prodeq2sdv {k: setvar} (ph: wff) (A2 B2 C: class k):
  $ wi ph (wceq B2 C) $ >
  $ wi ph (wceq (cprod k A2 B2) (cprod k A2 C)) $;

--| Equality deduction for double product. (Contributed by Scott Fenton, 4-Dec-2017.)
theorem _2cprodeq2dv {j k: setvar} (ph: wff) (A2: class) (B2: class j) (C D: class j k):
  $ wi (w3a ph (wcel (cv j) A2) (wcel (cv k) B2)) (wceq C D) $ >
  $ wi ph (wceq (cprod j A2 (cprod k B2 C)) (cprod j A2 (cprod k B2 D))) $;

--| Equality deduction for product. (Contributed by Scott Fenton, 4-Dec-2017.)
theorem prodeq12dv {k: setvar} (ph: wff) (A2 B2: class) (C D: class k):
  $ wi ph (wceq A2 B2) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wceq C D) $ >
  $ wi ph (wceq (cprod k A2 C) (cprod k B2 D)) $;

--| Equality deduction for product. (Contributed by Scott Fenton, 4-Dec-2017.)
theorem prodeq12rdv {k: setvar} (ph: wff) (A2 B2: class) (C D: class k):
  $ wi ph (wceq A2 B2) $ >
  $ wi (wa ph (wcel (cv k) B2)) (wceq C D) $ >
  $ wi ph (wceq (cprod k A2 C) (cprod k B2 D)) $;

--| The second class argument to a product can be chosen so that it is always a set. (Contributed by Scott Fenton, 4-Dec-2017.)
theorem prod2id {k: setvar} (A2: class) (B2: class k):
  $ wceq (cprod k A2 B2) (cprod k A2 (cfv B2 cid)) $;

--| Lemma for ~ prodrb . (Contributed by Scott Fenton, 4-Dec-2017.)
theorem prodrblem {k: setvar} (ph: wff) (A2: class) (B2: class k) (F: class) (M N: class k):
  $ wceq F (cmpt k cz (cif (wcel (cv k) A2) B2 c1)) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wss A2 (cfv N cuz))) (wceq (cres (cseq cmul F M) (cfv N cuz)) (cseq cmul F N)) $;

--| The sequence of partial products of a finite product converges to the whole product. (Contributed by Scott Fenton, 4-Dec-2017.)
theorem fprodcvg {k: setvar} (ph: wff) (A2: class) (B2: class k) (F M N: class):
  $ wceq F (cmpt k cz (cif (wcel (cv k) A2) B2 c1)) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi ph (wss A2 (co M N cfz)) $ >
  $ wi ph (wbr (cseq cmul F M) (cfv N (cseq cmul F M)) cli) $;

--| Lemma for ~ prodrb . (Contributed by Scott Fenton, 4-Dec-2017.)
theorem prodrblem2 {k: setvar} (ph: wff) (A2: class) (B2 C: class k) (F M N: class):
  $ wceq F (cmpt k cz (cif (wcel (cv k) A2) B2 c1)) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wss A2 (cfv M cuz)) $ >
  $ wi ph (wss A2 (cfv N cuz)) $ >
  $ wi (wa ph (wcel N (cfv M cuz))) (wb (wbr (cseq cmul F M) C cli) (wbr (cseq cmul F N) C cli)) $;

--| Rebase the starting point of a product. (Contributed by Scott Fenton, 4-Dec-2017.)
theorem prodrb {k: setvar} (ph: wff) (A2: class) (B2 C: class k) (F M N: class):
  $ wceq F (cmpt k cz (cif (wcel (cv k) A2) B2 c1)) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wss A2 (cfv M cuz)) $ >
  $ wi ph (wss A2 (cfv N cuz)) $ >
  $ wi ph (wb (wbr (cseq cmul F M) C cli) (wbr (cseq cmul F N) C cli)) $;

--| Lemma for ~ prodmo . (Contributed by Scott Fenton, 4-Dec-2017.)
theorem prodmolem3 {f2 j k: setvar} (ph: wff f2) (A2: class f2 j) (B2: class f2 k) (F: class f2 j) (G: class f2 k) (H: class f2 j k) (K M: class f2 k) (N: class f2 j k):
  $ wceq F (cmpt k cz (cif (wcel (cv k) A2) B2 c1)) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wceq G (cmpt j cn (csb k (cfv (cv j) (cv f2)) B2)) $ >
  $ wceq H (cmpt j cn (csb k (cfv (cv j) K) B2)) $ >
  $ wi ph (wa (wcel M cn) (wcel N cn)) $ >
  $ wi ph (wf1o (co c1 M cfz) A2 (cv f2)) $ >
  $ wi ph (wf1o (co c1 N cfz) A2 K) $ >
  $ wi ph (wceq (cfv M (cseq cmul G c1)) (cfv N (cseq cmul H c1))) $;

--| Lemma for ~ prodmo . (Contributed by Scott Fenton, 4-Dec-2017.)
theorem prodmolem2a {f2 j k: setvar} (ph: wff f2) (A2: class f2) (B2: class f2 k) (F: class f2 j) (G: class f2 k) (H: class f2 j k) (K M N: class f2):
  $ wceq F (cmpt k cz (cif (wcel (cv k) A2) B2 c1)) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wceq G (cmpt j cn (csb k (cfv (cv j) (cv f2)) B2)) $ >
  $ wceq H (cmpt j cn (csb k (cfv (cv j) K) B2)) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wss A2 (cfv M cuz)) $ >
  $ wi ph (wf1o (co c1 N cfz) A2 (cv f2)) $ >
  $ wi ph (wiso (co c1 (cfv A2 chash) cfz) A2 clt clt K) $ >
  $ wi ph (wbr (cseq cmul F M) (cfv N (cseq cmul G c1)) cli) $;

--| Lemma for ~ prodmo . (Contributed by Scott Fenton, 4-Dec-2017.)
theorem prodmolem2 {y1 f2 j k m n: setvar} (ph: wff y1) (x3 z: setvar) (A2: class y1) (B2: class y1 f2 k m n) (F: class y1) (G: class y1 f2 k m n):
  $ wceq F (cmpt k cz (cif (wcel (cv k) A2) B2 c1)) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wceq G (cmpt j cn (csb k (cfv (cv j) (cv f2)) B2)) $ >
  $ wi (wa ph (wrex m (w3a (wss A2 (cfv (cv m) cuz)) (wrex n (wex y1 (wa (wne (cv y1) cc0) (wbr (cseq cmul F (cv n)) (cv y1) cli))) (cfv (cv m) cuz)) (wbr (cseq cmul F (cv m)) (cv x3) cli)) cz)) (wi (wrex m (wex f2 (wa (wf1o (co c1 (cv m) cfz) A2 (cv f2)) (wceq (cv z) (cfv (cv m) (cseq cmul G c1))))) cn) (wceq (cv x3) (cv z))) $;

--| A product has at most one limit. (Contributed by Scott Fenton, 4-Dec-2017.)
theorem prodmo {x3 y1 f2 j k m n: setvar} (ph: wff y1) (A2: class y1) (B2: class x3 y1 k n) (F: class y1) (G: class y1 f2 k m n):
  $ wceq F (cmpt k cz (cif (wcel (cv k) A2) B2 c1)) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wceq G (cmpt j cn (csb k (cfv (cv j) (cv f2)) B2)) $ >
  $ wi ph (wmo x3 (wo (wrex m (w3a (wss A2 (cfv (cv m) cuz)) (wrex n (wex y1 (wa (wne (cv y1) cc0) (wbr (cseq cmul F (cv n)) (cv y1) cli))) (cfv (cv m) cuz)) (wbr (cseq cmul F (cv m)) (cv x3) cli)) cz) (wrex m (wex f2 (wa (wf1o (co c1 (cv m) cfz) A2 (cv f2)) (wceq (cv x3) (cfv (cv m) (cseq cmul G c1))))) cn))) $;

--| Series product with index set a subset of the upper integers. (Contributed by Scott Fenton, 5-Dec-2017.)
theorem zprod {y1 k n: setvar} (ph: wff) (A2: class) (B2: class k) (F: class y1 n) (M: class n) (Z: class y1 k):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wrex n (wex y1 (wa (wne (cv y1) cc0) (wbr (cseq cmul F (cv n)) (cv y1) cli))) Z) $ >
  $ wi ph (wss A2 Z) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) (cif (wcel (cv k) A2) B2 c1)) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi ph (wceq (cprod k A2 B2) (cfv (cseq cmul F M) cli)) $;

--| Series product with an upper integer index set (i.e. an infinite product.) (Contributed by Scott Fenton, 5-Dec-2017.)
theorem iprod {y1 k n: setvar} (ph: wff) (B2: class k) (F: class y1 n) (M: class n) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wrex n (wex y1 (wa (wne (cv y1) cc0) (wbr (cseq cmul F (cv n)) (cv y1) cli))) Z) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) B2) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel B2 cc) $ >
  $ wi ph (wceq (cprod k Z B2) (cfv (cseq cmul F M) cli)) $;

--| Nonzero series product with index set a subset of the upper integers. (Contributed by Scott Fenton, 6-Dec-2017.)
theorem zprodn0 {k: setvar} (ph: wff) (A2: class) (B2: class k) (F M: class) (X Z: class k):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wne X cc0) $ >
  $ wi ph (wbr (cseq cmul F M) X cli) $ >
  $ wi ph (wss A2 Z) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) (cif (wcel (cv k) A2) B2 c1)) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi ph (wceq (cprod k A2 B2) X) $;

--| Nonzero series product with an upper integer index set (i.e. an infinite product.) (Contributed by Scott Fenton, 6-Dec-2017.)
theorem iprodn0 {k: setvar} (ph: wff) (B2: class k) (F M: class) (X: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wne X cc0) $ >
  $ wi ph (wbr (cseq cmul F M) X cli) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) B2) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel B2 cc) $ >
  $ wi ph (wceq (cprod k Z B2) X) $;

--| The value of a product over a nonempty finite set. (Contributed by Scott Fenton, 6-Dec-2017.)
theorem fprod {k n: setvar} (ph: wff) (A2: class) (B2: class k) (C: class n) (F G M: class):
  $ wi (wceq (cv k) (cfv (cv n) F)) (wceq B2 C) $ >
  $ wi ph (wcel M cn) $ >
  $ wi ph (wf1o (co c1 M cfz) A2 F) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi (wa ph (wcel (cv n) (co c1 M cfz))) (wceq (cfv (cv n) G) C) $ >
  $ wi ph (wceq (cprod k A2 B2) (cfv M (cseq cmul G c1))) $;

--| A non-triviality lemma for finite sequences. (Contributed by Scott Fenton, 16-Dec-2017.)
theorem fprodntriv {y1 k n: setvar} (ph: wff y1 k) (A2: class) (B2: class k) (M: class y1 k n) (N: class k) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel N Z) $ >
  $ wi ph (wss A2 (co M N cfz)) $ >
  $ wi ph (wrex n (wex y1 (wa (wne (cv y1) cc0) (wbr (cseq cmul (cmpt k Z (cif (wcel (cv k) A2) B2 c1)) (cv n)) (cv y1) cli))) Z) $;

--| A product over the empty set is one. (Contributed by Scott Fenton, 5-Dec-2017.)
theorem prod0 {k: setvar} (A2: class k):
  $ wceq (cprod k c0 A2) c1 $;

--| Any product of one over a valid set is one. (Contributed by Scott Fenton, 7-Dec-2017.)
theorem prod1 {k: setvar} (A2 M: class):
  $ wi (wo (wss A2 (cfv M cuz)) (wcel A2 cfn)) (wceq (cprod k A2 c1) c1) $;

--| A lemma to facilitate conversions from the function form to the class-variable form of a product. (Contributed by Scott Fenton, 7-Dec-2017.)
theorem prodfc {j k: setvar} (A2: class) (B2: class k):
  $ wceq (cprod j A2 (cfv (cv j) (cmpt k A2 B2))) (cprod k A2 B2) $;

--| Re-index a finite product using a bijection. (Contributed by Scott Fenton, 7-Dec-2017.)
theorem fprodf1o {k n: setvar} (ph: wff) (A2: class) (B2 C: class k) (D: class n) (F: class k) (G: class n):
  $ wi (wceq (cv k) G) (wceq B2 D) $ >
  $ wi ph (wcel C cfn) $ >
  $ wi ph (wf1o C A2 F) $ >
  $ wi (wa ph (wcel (cv n) C)) (wceq (cfv (cv n) F) G) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi ph (wceq (cprod k A2 B2) (cprod n C D)) $;

--| Change the index set to a subset in an upper integer product. (Contributed by Scott Fenton, 11-Dec-2017.)
theorem prodss {y1 k n: setvar} (ph: wff) (A2 B2: class) (C: class k) (M: class):
  $ wi ph (wss A2 B2) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel C cc) $ >
  $ wi ph (wrex n (wex y1 (wa (wne (cv y1) cc0) (wbr (cseq cmul (cmpt k (cfv M cuz) (cif (wcel (cv k) B2) C c1)) (cv n)) (cv y1) cli))) (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (cdif B2 A2))) (wceq C c1) $ >
  $ wi ph (wss B2 (cfv M cuz)) $ >
  $ wi ph (wceq (cprod k A2 C) (cprod k B2 C)) $;

--| Change the index set to a subset in a finite product. (Contributed by Scott Fenton, 16-Dec-2017.)
theorem fprodss {k: setvar} (ph: wff) (A2 B2: class) (C: class k):
  $ wi ph (wss A2 B2) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel C cc) $ >
  $ wi (wa ph (wcel (cv k) (cdif B2 A2))) (wceq C c1) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi ph (wceq (cprod k A2 C) (cprod k B2 C)) $;

--| A finite product expressed in terms of a partial product of an infinite sequence. The recursive definition of a finite product follows from here. (Contributed by Scott Fenton, 14-Dec-2017.)
theorem fprodser {k: setvar} (ph: wff) (A2: class k) (F M N: class):
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wceq (cfv (cv k) F) A2) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel A2 cc) $ >
  $ wi ph (wceq (cprod k (co M N cfz) A2) (cfv N (cseq cmul F M))) $;

--| Finite product closure lemma. (Contributed by Scott Fenton, 14-Dec-2017.)
theorem fprodcl2lem {x3 y1 k: setvar} (ph: wff) (A2: class) (B2: class k) (S: class):
  $ wi ph (wss S cc) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wcel (co (cv x3) (cv y1) cmul) S) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 S) $ >
  $ wi ph (wne A2 c0) $ >
  $ wi ph (wcel (cprod k A2 B2) S) $;

--| Finite product closure lemma. (Contributed by Scott Fenton, 14-Dec-2017.)
theorem fprodcllem {x3 y1 k: setvar} (ph: wff) (A2: class) (B2: class k) (S: class):
  $ wi ph (wss S cc) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wcel (co (cv x3) (cv y1) cmul) S) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 S) $ >
  $ wi ph (wcel c1 S) $ >
  $ wi ph (wcel (cprod k A2 B2) S) $;

--| Closure of a finite product of complex numbers. (Contributed by Scott Fenton, 14-Dec-2017.)
theorem fprodcl {k: setvar} (ph: wff) (A2: class) (B2: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi ph (wcel (cprod k A2 B2) cc) $;

--| Closure of a finite product of real numbers. (Contributed by Scott Fenton, 14-Dec-2017.)
theorem fprodrecl {k: setvar} (ph: wff) (A2: class) (B2: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cr) $ >
  $ wi ph (wcel (cprod k A2 B2) cr) $;

--| Closure of a finite product of integers. (Contributed by Scott Fenton, 14-Dec-2017.)
theorem fprodzcl {k: setvar} (ph: wff) (A2: class) (B2: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cz) $ >
  $ wi ph (wcel (cprod k A2 B2) cz) $;

--| Closure of a finite product of positive integers. (Contributed by Scott Fenton, 14-Dec-2017.)
theorem fprodnncl {k: setvar} (ph: wff) (A2: class) (B2: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cn) $ >
  $ wi ph (wcel (cprod k A2 B2) cn) $;

--| Closure of a finite product of positive reals. (Contributed by Scott Fenton, 14-Dec-2017.)
theorem fprodrpcl {k: setvar} (ph: wff) (A2: class) (B2: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 crp) $ >
  $ wi ph (wcel (cprod k A2 B2) crp) $;

--| Closure of a finite product of nonnegative integers. (Contributed by Scott Fenton, 14-Dec-2017.)
theorem fprodnn0cl {k: setvar} (ph: wff) (A2: class) (B2: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cn0) $ >
  $ wi ph (wcel (cprod k A2 B2) cn0) $;

--| Finite product closure lemma. A version of ~ fprodcllem using bound-variable hypotheses instead of distinct variable conditions. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem fprodcllemf {x3 y1 k: setvar} (ph: wff k) (A2: class) (B2: class k) (S: class):
  $ wnf k ph $ >
  $ wi ph (wss S cc) $ >
  $ wi (wa ph (wa (wcel (cv x3) S) (wcel (cv y1) S))) (wcel (co (cv x3) (cv y1) cmul) S) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 S) $ >
  $ wi ph (wcel c1 S) $ >
  $ wi ph (wcel (cprod k A2 B2) S) $;

--| Closure of a finite product of real numbers. A version of ~ fprodrecl using bound-variable hypotheses instead of distinct variable conditions. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem fprodreclf {k: setvar} (ph: wff k) (A2: class) (B2: class k):
  $ wnf k ph $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cr) $ >
  $ wi ph (wcel (cprod k A2 B2) cr) $;

--| The product of two finite products. (Contributed by Scott Fenton, 14-Dec-2017.)
theorem fprodmul {k: setvar} (ph: wff) (A2: class) (B2 C: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel C cc) $ >
  $ wi ph (wceq (cprod k A2 (co B2 C cmul)) (co (cprod k A2 B2) (cprod k A2 C) cmul)) $;

--| The quotient of two finite products. (Contributed by Scott Fenton, 15-Jan-2018.)
theorem fproddiv {k: setvar} (ph: wff) (A2: class) (B2 C: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel C cc) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wne C cc0) $ >
  $ wi ph (wceq (cprod k A2 (co B2 C cdiv)) (co (cprod k A2 B2) (cprod k A2 C) cdiv)) $;

--| A product of a singleton is the term. (Contributed by Scott Fenton, 14-Dec-2017.)
theorem prodsn {k: setvar} (A2: class k) (B2 M V: class):
  $ wi (wceq (cv k) M) (wceq A2 B2) $ >
  $ wi (wa (wcel M V) (wcel B2 cc)) (wceq (cprod k (csn M) A2) B2) $;

--| A finite product of only one term is the term itself. (Contributed by Scott Fenton, 14-Dec-2017.)
theorem fprod1 {k: setvar} (A2: class k) (B2 M: class):
  $ wi (wceq (cv k) M) (wceq A2 B2) $ >
  $ wi (wa (wcel M cz) (wcel B2 cc)) (wceq (cprod k (co M M cfz) A2) B2) $;

--| A product of a singleton is the term. A version of ~ prodsn using bound-variable hypotheses instead of distinct variable conditions. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem prodsnf {k: setvar} (A2 B2: class k) (M V: class):
  $ wnfc k B2 $ >
  $ wi (wceq (cv k) M) (wceq A2 B2) $ >
  $ wi (wa (wcel M V) (wcel B2 cc)) (wceq (cprod k (csn M) A2) B2) $;

--| The limit of a product over one. (Contributed by Scott Fenton, 15-Dec-2017.)
theorem climprod1 (ph: wff) (M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wbr (cseq cmul (cxp Z (csn c1)) M) c1 cli) $;

--| Split a finite product into two parts. (Contributed by Scott Fenton, 16-Dec-2017.)
theorem fprodsplit {k: setvar} (ph: wff) (A2 B2: class) (C: class k) (U: class):
  $ wi ph (wceq (cin A2 B2) c0) $ >
  $ wi ph (wceq U (cun A2 B2)) $ >
  $ wi ph (wcel U cfn) $ >
  $ wi (wa ph (wcel (cv k) U)) (wcel C cc) $ >
  $ wi ph (wceq (cprod k U C) (co (cprod k A2 C) (cprod k B2 C) cmul)) $;

--| Separate out the last term in a finite product. (Contributed by Scott Fenton, 16-Dec-2017.)
theorem fprodm1 {k: setvar} (ph: wff) (A2: class k) (B2 M N: class):
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel A2 cc) $ >
  $ wi (wceq (cv k) N) (wceq A2 B2) $ >
  $ wi ph (wceq (cprod k (co M N cfz) A2) (co (cprod k (co M (co N c1 cmin) cfz) A2) B2 cmul)) $;

--| Separate out the first term in a finite product. (Contributed by Scott Fenton, 24-Dec-2017.)
theorem fprod1p {k: setvar} (ph: wff) (A2: class k) (B2 M N: class):
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel A2 cc) $ >
  $ wi (wceq (cv k) M) (wceq A2 B2) $ >
  $ wi ph (wceq (cprod k (co M N cfz) A2) (co B2 (cprod k (co (co M c1 caddc) N cfz) A2) cmul)) $;

--| Multiply in the last term in a finite product. (Contributed by Scott Fenton, 24-Dec-2017.)
theorem fprodp1 {k: setvar} (ph: wff) (A2: class k) (B2 M N: class):
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M (co N c1 caddc) cfz))) (wcel A2 cc) $ >
  $ wi (wceq (cv k) (co N c1 caddc)) (wceq A2 B2) $ >
  $ wi ph (wceq (cprod k (co M (co N c1 caddc) cfz) A2) (co (cprod k (co M N cfz) A2) B2 cmul)) $;

--| Separate out the last term in a finite product. (Contributed by Scott Fenton, 27-Dec-2017.)
theorem fprodm1s {k: setvar} (ph: wff) (A2: class k) (M N: class):
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M N cfz))) (wcel A2 cc) $ >
  $ wi ph (wceq (cprod k (co M N cfz) A2) (co (cprod k (co M (co N c1 cmin) cfz) A2) (csb k N A2) cmul)) $;

--| Multiply in the last term in a finite product. (Contributed by Scott Fenton, 27-Dec-2017.)
theorem fprodp1s {k: setvar} (ph: wff) (A2: class k) (M N: class):
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi (wa ph (wcel (cv k) (co M (co N c1 caddc) cfz))) (wcel A2 cc) $ >
  $ wi ph (wceq (cprod k (co M (co N c1 caddc) cfz) A2) (co (cprod k (co M N cfz) A2) (csb k (co N c1 caddc) A2) cmul)) $;

--| A product of the singleton is the term. (Contributed by Scott Fenton, 25-Dec-2017.)
theorem prodsns {k: setvar} (A2: class k) (M: class) (V: class k):
  $ wi (wa (wcel M V) (wcel (csb k M A2) cc)) (wceq (cprod k (csn M) A2) (csb k M A2)) $;

--| Factorial using product notation. (Contributed by Scott Fenton, 15-Dec-2017.)
theorem fprodfac {k: setvar} (A2: class):
  $ wi (wcel A2 cn0) (wceq (cfv A2 cfa) (cprod k (co c1 A2 cfz) (cv k))) $;

--| The absolute value of a finite product. (Contributed by Scott Fenton, 25-Dec-2017.)
theorem fprodabs {k: setvar} (ph: wff) (A2: class k) (M N Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel N Z) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel A2 cc) $ >
  $ wi ph (wceq (cfv (cprod k (co M N cfz) A2) cabs) (cprod k (co M N cfz) (cfv A2 cabs))) $;

--| Any finite product containing a zero term is itself zero. (Contributed by Scott Fenton, 27-Dec-2017.)
theorem fprodeq0 {k: setvar} (ph: wff) (A2: class k) (K M N Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel N Z) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel A2 cc) $ >
  $ wi (wa ph (wceq (cv k) N)) (wceq A2 cc0) $ >
  $ wi (wa ph (wcel K (cfv N cuz))) (wceq (cprod k (co M K cfz) A2) cc0) $;

--| Shift the index of a finite product. (Contributed by Scott Fenton, 5-Jan-2018.)
theorem fprodshft {j k: setvar} (ph: wff) (A2: class j) (B2: class k) (K M N: class):
  $ wi ph (wcel K cz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi (wa ph (wcel (cv j) (co M N cfz))) (wcel A2 cc) $ >
  $ wi (wceq (cv j) (co (cv k) K cmin)) (wceq A2 B2) $ >
  $ wi ph (wceq (cprod j (co M N cfz) A2) (cprod k (co (co M K caddc) (co N K caddc) cfz) B2)) $;

--| Reversal of a finite product. (Contributed by Scott Fenton, 5-Jan-2018.)
theorem fprodrev {j k: setvar} (ph: wff) (A2: class j) (B2: class k) (K M N: class):
  $ wi ph (wcel K cz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi (wa ph (wcel (cv j) (co M N cfz))) (wcel A2 cc) $ >
  $ wi (wceq (cv j) (co K (cv k) cmin)) (wceq A2 B2) $ >
  $ wi ph (wceq (cprod j (co M N cfz) A2) (cprod k (co (co K N cmin) (co K M cmin) cfz) B2)) $;

--| The product of constant terms ( ` k ` is not free in ` B ` ). (Contributed by Scott Fenton, 12-Jan-2018.)
theorem fprodconst {k: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cfn) (wcel B2 cc)) (wceq (cprod k A2 B2) (co B2 (cfv A2 chash) cexp)) $;

--| A finite product of nonzero terms is nonzero. (Contributed by Scott Fenton, 15-Jan-2018.)
theorem fprodn0 {k: setvar} (ph: wff) (A2: class) (B2: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wne B2 cc0) $ >
  $ wi ph (wne (cprod k A2 B2) cc0) $;

--| Lemma for ~ fprod2d - induction step. (Contributed by Scott Fenton, 30-Jan-2018.)
theorem fprod2dlem {x3 y1 z j k: setvar} (ph: wff x3 y1) (ps: wff x3 y1 z j k) (A2: class x3 y1 z) (B2: class x3 y1 j) (C: class x3 y1 j k) (D: class x3 y1 z):
  $ wi (wceq (cv z) (cop (cv j) (cv k))) (wceq D C) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv j) A2)) (wcel B2 cfn) $ >
  $ wi (wa ph (wa (wcel (cv j) A2) (wcel (cv k) B2))) (wcel C cc) $ >
  $ wi ph (wn (wcel (cv y1) (cv x3))) $ >
  $ wi ph (wss (cun (cv x3) (csn (cv y1))) A2) $ >
  $ wb ps (wceq (cprod j (cv x3) (cprod k B2 C)) (cprod z (ciun j (cv x3) (cxp (csn (cv j)) B2)) D)) $ >
  $ wi (wa ph ps) (wceq (cprod j (cun (cv x3) (csn (cv y1))) (cprod k B2 C)) (cprod z (ciun j (cun (cv x3) (csn (cv y1))) (cxp (csn (cv j)) B2)) D)) $;

--| Write a double product as a product over a two-dimensional region. Compare ~ fsum2d . (Contributed by Scott Fenton, 30-Jan-2018.)
theorem fprod2d {z j k: setvar} (ph: wff) (A2: class) (B2: class j) (C: class j k) (D: class z):
  $ wi (wceq (cv z) (cop (cv j) (cv k))) (wceq D C) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv j) A2)) (wcel B2 cfn) $ >
  $ wi (wa ph (wa (wcel (cv j) A2) (wcel (cv k) B2))) (wcel C cc) $ >
  $ wi ph (wceq (cprod j A2 (cprod k B2 C)) (cprod z (ciun j A2 (cxp (csn (cv j)) B2)) D)) $;

--| Combine two products into a single product over the cartesian product. (Contributed by Scott Fenton, 1-Feb-2018.)
theorem fprodxp {z j k: setvar} (ph: wff) (A2 B2: class) (C: class j k) (D: class z):
  $ wi (wceq (cv z) (cop (cv j) (cv k))) (wceq D C) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi (wa ph (wa (wcel (cv j) A2) (wcel (cv k) B2))) (wcel C cc) $ >
  $ wi ph (wceq (cprod j A2 (cprod k B2 C)) (cprod z (cxp A2 B2) D)) $;

--| Transform a product region using the converse operation. (Contributed by Scott Fenton, 1-Feb-2018.)
theorem fprodcnv {x3 y1 j k: setvar} (ph: wff j k) (A2: class j k) (B2: class x3) (C: class x3 y1) (D: class j k):
  $ wi (wceq (cv x3) (cop (cv j) (cv k))) (wceq B2 D) $ >
  $ wi (wceq (cv y1) (cop (cv k) (cv j))) (wceq C D) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wrel A2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel B2 cc) $ >
  $ wi ph (wceq (cprod x3 A2 B2) (cprod y1 (ccnv A2) C)) $;

--| Interchange order of multiplication. Note that ` B ( j ) ` and ` D ( k ) ` are not necessarily constant expressions. (Contributed by Scott Fenton, 1-Feb-2018.) (Proof shortened by JJ, 2-Aug-2021.)
theorem fprodcom2 {j k: setvar} (ph: wff) (A2: class) (B2: class j) (C: class) (D: class k) (E: class j k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wcel C cfn) $ >
  $ wi (wa ph (wcel (cv j) A2)) (wcel B2 cfn) $ >
  $ wi ph (wb (wa (wcel (cv j) A2) (wcel (cv k) B2)) (wa (wcel (cv k) C) (wcel (cv j) D))) $ >
  $ wi (wa ph (wa (wcel (cv j) A2) (wcel (cv k) B2))) (wcel E cc) $ >
  $ wi ph (wceq (cprod j A2 (cprod k B2 E)) (cprod k C (cprod j D E))) $;

--| Interchange product order. (Contributed by Scott Fenton, 2-Feb-2018.)
theorem fprodcom {j k: setvar} (ph: wff) (A2 B2: class) (C: class j k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wcel B2 cfn) $ >
  $ wi (wa ph (wa (wcel (cv j) A2) (wcel (cv k) B2))) (wcel C cc) $ >
  $ wi ph (wceq (cprod j A2 (cprod k B2 C)) (cprod k B2 (cprod j A2 C))) $;

--| Two ways to express "the product of ` A ( j , k ) ` over the triangular region ` M <_ j ` , ` M <_ k ` , ` j + k <_ N ` . Compare ~ fsum0diag . (Contributed by Scott Fenton, 2-Feb-2018.)
theorem fprod0diag {j k: setvar} (ph: wff) (A2: class j k) (N: class):
  $ wi (wa ph (wa (wcel (cv j) (co cc0 N cfz)) (wcel (cv k) (co cc0 (co N (cv j) cmin) cfz)))) (wcel A2 cc) $ >
  $ wi ph (wceq (cprod j (co cc0 N cfz) (cprod k (co cc0 (co N (cv j) cmin) cfz) A2)) (cprod k (co cc0 N cfz) (cprod j (co cc0 (co N (cv k) cmin) cfz) A2))) $;

--| The quotient of two finite products. A version of ~ fproddiv using bound-variable hypotheses instead of distinct variable conditions. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem fproddivf {k: setvar} (ph: wff k) (A2: class) (B2 C: class k):
  $ wnf k ph $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel C cc) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wne C cc0) $ >
  $ wi ph (wceq (cprod k A2 (co B2 C cdiv)) (co (cprod k A2 B2) (cprod k A2 C) cdiv)) $;

--| Split a finite product into two parts. A version of ~ fprodsplit using bound-variable hypotheses instead of distinct variable conditions. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem fprodsplitf {k: setvar} (ph: wff k) (A2 B2: class) (C: class k) (U: class):
  $ wnf k ph $ >
  $ wi ph (wceq (cin A2 B2) c0) $ >
  $ wi ph (wceq U (cun A2 B2)) $ >
  $ wi ph (wcel U cfn) $ >
  $ wi (wa ph (wcel (cv k) U)) (wcel C cc) $ >
  $ wi ph (wceq (cprod k U C) (co (cprod k A2 C) (cprod k B2 C) cmul)) $;

--| Separate out a term in a finite product. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem fprodsplitsn {k: setvar} (ph: wff k) (A2 B2: class) (C D: class k) (V: class):
  $ wnf k ph $ >
  $ wnfc k D $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wcel B2 V) $ >
  $ wi ph (wn (wcel B2 A2)) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel C cc) $ >
  $ wi (wceq (cv k) B2) (wceq C D) $ >
  $ wi ph (wcel D cc) $ >
  $ wi ph (wceq (cprod k (cun A2 (csn B2)) C) (co (cprod k A2 C) D cmul)) $;

--| Separate out a term in a finite product. A version of ~ fprodsplit1 using bound-variable hypotheses instead of distinct variable conditions. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem fprodsplit1f {k: setvar} (ph: wff k) (A2: class) (B2: class k) (C: class) (D: class k):
  $ wnf k ph $ >
  $ wi ph (wnfc k D) $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi ph (wcel C A2) $ >
  $ wi (wa ph (wceq (cv k) C)) (wceq B2 D) $ >
  $ wi ph (wceq (cprod k A2 B2) (co D (cprod k (cdif A2 (csn C)) B2) cmul)) $;

--| A finite product of nonzero terms is nonzero. A version of ~ fprodn0 using bound-variable hypotheses instead of distinct variable conditions. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem fprodn0f {k: setvar} (ph: wff k) (A2: class) (B2: class k):
  $ wnf k ph $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wne B2 cc0) $ >
  $ wi ph (wne (cprod k A2 B2) cc0) $;

--| Closure of a finite product of complex numbers. A version of ~ fprodcl using bound-variable hypotheses instead of distinct variable conditions. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem fprodclf {k: setvar} (ph: wff k) (A2: class) (B2: class k):
  $ wnf k ph $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi ph (wcel (cprod k A2 B2) cc) $;

--| If all the terms of a finite product are nonnegative, so is the product. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem fprodge0 {k: setvar} (ph: wff k) (A2: class) (B2: class k):
  $ wnf k ph $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cr) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wbr cc0 B2 cle) $ >
  $ wi ph (wbr cc0 (cprod k A2 B2) cle) $;

--| Any finite product containing a zero term is itself zero. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem fprodeq0g {k: setvar} (ph: wff k) (A2: class) (B2: class k) (C: class):
  $ wnf k ph $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cc) $ >
  $ wi ph (wcel C A2) $ >
  $ wi (wa ph (wceq (cv k) C)) (wceq B2 cc0) $ >
  $ wi ph (wceq (cprod k A2 B2) cc0) $;

--| If all of the terms of a finite product are greater than or equal to ` 1 ` , so is the product. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem fprodge1 {k: setvar} (ph: wff k) (A2: class) (B2: class k):
  $ wnf k ph $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cr) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wbr c1 B2 cle) $ >
  $ wi ph (wbr c1 (cprod k A2 B2) cle) $;

--| If all the terms of two finite products are nonnegative and compare, so do the two products. (Contributed by Glauco Siliprandi, 5-Apr-2020.)
theorem fprodle {k: setvar} (ph: wff k) (A2: class) (B2 C: class k):
  $ wnf k ph $ >
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cr) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wbr cc0 B2 cle) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel C cr) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wbr B2 C cle) $ >
  $ wi ph (wbr (cprod k A2 B2) (cprod k A2 C) cle) $;

--| If all factors of two finite products are equal modulo ` M ` , the products are equal modulo ` M ` . (Contributed by AV, 7-Jul-2021.)
theorem fprodmodd {k: setvar} (ph: wff) (A2: class) (B2 C: class k) (M: class):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cz) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel C cz) $ >
  $ wi ph (wcel M cn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wceq (co B2 M cmo) (co C M cmo)) $ >
  $ wi ph (wceq (co (cprod k A2 B2) M cmo) (co (cprod k A2 C) M cmo)) $;

--| An infinite product equals the value its sequence converges to. (Contributed by Scott Fenton, 18-Dec-2017.)
theorem iprodclim {y1 k n: setvar} (ph: wff) (A2: class k) (B2: class y1 k n) (F: class y1 n) (M: class n) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wrex n (wex y1 (wa (wne (cv y1) cc0) (wbr (cseq cmul F (cv n)) (cv y1) cli))) Z) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) A2) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel A2 cc) $ >
  $ wi ph (wbr (cseq cmul F M) B2 cli) $ >
  $ wi ph (wceq (cprod k Z A2) B2) $;

--| A converging product converges to its infinite product. (Contributed by Scott Fenton, 18-Dec-2017.)
theorem iprodclim2 {y1 k n: setvar} (ph: wff) (A2: class k) (F M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wrex n (wex y1 (wa (wne (cv y1) cc0) (wbr (cseq cmul F (cv n)) (cv y1) cli))) Z) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) A2) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel A2 cc) $ >
  $ wi ph (wbr (cseq cmul F M) (cprod k Z A2) cli) $;

--| The sequence of partial finite product of a converging infinite product converge to the infinite product of the series. Note that ` j ` must not occur in ` A ` . (Contributed by Scott Fenton, 18-Dec-2017.)
theorem iprodclim3 {y1 j k n: setvar} (ph: wff) (A2: class k) (F: class y1 k n) (M: class n) (Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wrex n (wex y1 (wa (wne (cv y1) cc0) (wbr (cseq cmul (cmpt k Z A2) (cv n)) (cv y1) cli))) Z) $ >
  $ wi ph (wcel F (cdm cli)) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel A2 cc) $ >
  $ wi (wa ph (wcel (cv j) Z)) (wceq (cfv (cv j) F) (cprod k (co M (cv j) cfz) A2)) $ >
  $ wi ph (wbr F (cprod k Z A2) cli) $;

--| The product of a non-trivially converging infinite sequence is a complex number. (Contributed by Scott Fenton, 18-Dec-2017.)
theorem iprodcl {y1 k n: setvar} (ph: wff) (A2: class k) (F M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wrex n (wex y1 (wa (wne (cv y1) cc0) (wbr (cseq cmul F (cv n)) (cv y1) cli))) Z) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) A2) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel A2 cc) $ >
  $ wi ph (wcel (cprod k Z A2) cc) $;

--| The product of a non-trivially converging infinite real sequence is a real number. (Contributed by Scott Fenton, 18-Dec-2017.)
theorem iprodrecl {y1 k n: setvar} (ph: wff) (A2: class k) (F M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wrex n (wex y1 (wa (wne (cv y1) cc0) (wbr (cseq cmul F (cv n)) (cv y1) cli))) Z) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) A2) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel A2 cr) $ >
  $ wi ph (wcel (cprod k Z A2) cr) $;

--| Multiplication of infinite sums. (Contributed by Scott Fenton, 18-Dec-2017.)
theorem iprodmul {y1 z k m n: setvar} (ph: wff) (A2: class z k m) (B2: class y1 k n) (F G M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wrex n (wex y1 (wa (wne (cv y1) cc0) (wbr (cseq cmul F (cv n)) (cv y1) cli))) Z) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) F) A2) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel A2 cc) $ >
  $ wi ph (wrex m (wex z (wa (wne (cv z) cc0) (wbr (cseq cmul G (cv m)) (cv z) cli))) Z) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wceq (cfv (cv k) G) B2) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel B2 cc) $ >
  $ wi ph (wceq (cprod k Z (co A2 B2 cmul)) (co (cprod k Z A2) (cprod k Z B2) cmul)) $;

--| Declare the syntax for the falling factorial.
term cfallfac: class;

--| Declare the syntax for the rising factorial.
term crisefac: class;

--| Define the rising factorial function. This is the function ` ( A x. ( A + 1 ) x. ... ( A + N ) ) ` for complex ` A ` and nonnegative integers ` N ` . (Contributed by Scott Fenton, 5-Jan-2018.)
axiom df_risefac {x3 k n: setvar}:
  $ wceq crisefac (cmpo x3 n cc cn0 (cprod k (co cc0 (co (cv n) c1 cmin) cfz) (co (cv x3) (cv k) caddc))) $;

--| Define the falling factorial function. This is the function ` ( A x. ( A - 1 ) x. ... ( A - N ) ) ` for complex ` A ` and nonnegative integers ` N ` . (Contributed by Scott Fenton, 5-Jan-2018.)
axiom df_fallfac {x3 k n: setvar}:
  $ wceq cfallfac (cmpo x3 n cc cn0 (cprod k (co cc0 (co (cv n) c1 cmin) cfz) (co (cv x3) (cv k) cmin))) $;

--| The value of the rising factorial function. (Contributed by Scott Fenton, 5-Jan-2018.)
theorem risefacval {k: setvar} (A2 N: class):
  $ wi (wa (wcel A2 cc) (wcel N cn0)) (wceq (co A2 N crisefac) (cprod k (co cc0 (co N c1 cmin) cfz) (co A2 (cv k) caddc))) $;

--| The value of the falling factorial function. (Contributed by Scott Fenton, 5-Jan-2018.)
theorem fallfacval {k: setvar} (A2 N: class):
  $ wi (wa (wcel A2 cc) (wcel N cn0)) (wceq (co A2 N cfallfac) (cprod k (co cc0 (co N c1 cmin) cfz) (co A2 (cv k) cmin))) $;

--| One-based value of rising factorial. (Contributed by Scott Fenton, 15-Jan-2018.)
theorem risefacval2 {k: setvar} (A2 N: class):
  $ wi (wa (wcel A2 cc) (wcel N cn0)) (wceq (co A2 N crisefac) (cprod k (co c1 N cfz) (co A2 (co (cv k) c1 cmin) caddc))) $;

--| One-based value of falling factorial. (Contributed by Scott Fenton, 15-Jan-2018.)
theorem fallfacval2 {k: setvar} (A2 N: class):
  $ wi (wa (wcel A2 cc) (wcel N cn0)) (wceq (co A2 N cfallfac) (cprod k (co c1 N cfz) (co A2 (co (cv k) c1 cmin) cmin))) $;

--| A product representation of falling factorial when ` A ` is a nonnegative integer. (Contributed by Scott Fenton, 20-Mar-2018.)
theorem fallfacval3 {k: setvar} (A2 N: class):
  $ wi (wcel N (co cc0 A2 cfz)) (wceq (co A2 N cfallfac) (cprod k (co (co A2 (co N c1 cmin) cmin) A2 cfz) (cv k))) $;

--| Lemma for rising factorial closure laws. (Contributed by Scott Fenton, 5-Jan-2018.)
theorem risefaccllem {x3 y1 k: setvar} (A2 S N: class):
  $ wss S cc $ >
  $ wcel c1 S $ >
  $ wi (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wcel (co (cv x3) (cv y1) cmul) S) $ >
  $ wi (wa (wcel A2 S) (wcel (cv k) cn0)) (wcel (co A2 (cv k) caddc) S) $ >
  $ wi (wa (wcel A2 S) (wcel N cn0)) (wcel (co A2 N crisefac) S) $;

--| Lemma for falling factorial closure laws. (Contributed by Scott Fenton, 5-Jan-2018.)
theorem fallfaccllem {x3 y1 k: setvar} (A2 S N: class):
  $ wss S cc $ >
  $ wcel c1 S $ >
  $ wi (wa (wcel (cv x3) S) (wcel (cv y1) S)) (wcel (co (cv x3) (cv y1) cmul) S) $ >
  $ wi (wa (wcel A2 S) (wcel (cv k) cn0)) (wcel (co A2 (cv k) cmin) S) $ >
  $ wi (wa (wcel A2 S) (wcel N cn0)) (wcel (co A2 N cfallfac) S) $;

--| Closure law for rising factorial. (Contributed by Scott Fenton, 5-Jan-2018.)
theorem risefaccl (A2 N: class):
  $ wi (wa (wcel A2 cc) (wcel N cn0)) (wcel (co A2 N crisefac) cc) $;

--| Closure law for falling factorial. (Contributed by Scott Fenton, 5-Jan-2018.)
theorem fallfaccl (A2 N: class):
  $ wi (wa (wcel A2 cc) (wcel N cn0)) (wcel (co A2 N cfallfac) cc) $;

--| Closure law for rising factorial. (Contributed by Scott Fenton, 5-Jan-2018.)
theorem rerisefaccl (A2 N: class):
  $ wi (wa (wcel A2 cr) (wcel N cn0)) (wcel (co A2 N crisefac) cr) $;

--| Closure law for falling factorial. (Contributed by Scott Fenton, 5-Jan-2018.)
theorem refallfaccl (A2 N: class):
  $ wi (wa (wcel A2 cr) (wcel N cn0)) (wcel (co A2 N cfallfac) cr) $;

--| Closure law for rising factorial. (Contributed by Scott Fenton, 5-Jan-2018.)
theorem nnrisefaccl (A2 N: class):
  $ wi (wa (wcel A2 cn) (wcel N cn0)) (wcel (co A2 N crisefac) cn) $;

--| Closure law for rising factorial. (Contributed by Scott Fenton, 5-Jan-2018.)
theorem zrisefaccl (A2 N: class):
  $ wi (wa (wcel A2 cz) (wcel N cn0)) (wcel (co A2 N crisefac) cz) $;

--| Closure law for falling factorial. (Contributed by Scott Fenton, 5-Jan-2018.)
theorem zfallfaccl (A2 N: class):
  $ wi (wa (wcel A2 cz) (wcel N cn0)) (wcel (co A2 N cfallfac) cz) $;

--| Closure law for rising factorial. (Contributed by Scott Fenton, 5-Jan-2018.)
theorem nn0risefaccl (A2 N: class):
  $ wi (wa (wcel A2 cn0) (wcel N cn0)) (wcel (co A2 N crisefac) cn0) $;

--| Closure law for rising factorial. (Contributed by Scott Fenton, 9-Jan-2018.)
theorem rprisefaccl (A2 N: class):
  $ wi (wa (wcel A2 crp) (wcel N cn0)) (wcel (co A2 N crisefac) crp) $;

--| A relationship between rising and falling factorials. (Contributed by Scott Fenton, 15-Jan-2018.)
theorem risefallfac (N X: class):
  $ wi (wa (wcel X cc) (wcel N cn0)) (wceq (co X N crisefac) (co (co (cneg c1) N cexp) (co (cneg X) N cfallfac) cmul)) $;

--| A relationship between falling and rising factorials. (Contributed by Scott Fenton, 17-Jan-2018.)
theorem fallrisefac (N X: class):
  $ wi (wa (wcel X cc) (wcel N cn0)) (wceq (co X N cfallfac) (co (co (cneg c1) N cexp) (co (cneg X) N crisefac) cmul)) $;

--| The value of the rising factorial when ` N = 0 ` . (Contributed by Scott Fenton, 5-Jan-2018.)
theorem risefac0 (A2: class):
  $ wi (wcel A2 cc) (wceq (co A2 cc0 crisefac) c1) $;

--| The value of the falling factorial when ` N = 0 ` . (Contributed by Scott Fenton, 5-Jan-2018.)
theorem fallfac0 (A2: class):
  $ wi (wcel A2 cc) (wceq (co A2 cc0 cfallfac) c1) $;

--| The value of the rising factorial at a successor. (Contributed by Scott Fenton, 5-Jan-2018.)
theorem risefacp1 (A2 N: class):
  $ wi (wa (wcel A2 cc) (wcel N cn0)) (wceq (co A2 (co N c1 caddc) crisefac) (co (co A2 N crisefac) (co A2 N caddc) cmul)) $;

--| The value of the falling factorial at a successor. (Contributed by Scott Fenton, 5-Jan-2018.)
theorem fallfacp1 (A2 N: class):
  $ wi (wa (wcel A2 cc) (wcel N cn0)) (wceq (co A2 (co N c1 caddc) cfallfac) (co (co A2 N cfallfac) (co A2 N cmin) cmul)) $;

--| The value of the rising factorial at a successor. (Contributed by Scott Fenton, 19-Mar-2018.)
theorem risefacp1d (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (co A2 (co N c1 caddc) crisefac) (co (co A2 N crisefac) (co A2 N caddc) cmul)) $;

--| The value of the falling factorial at a successor. (Contributed by Scott Fenton, 19-Mar-2018.)
theorem fallfacp1d (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (co A2 (co N c1 caddc) cfallfac) (co (co A2 N cfallfac) (co A2 N cmin) cmul)) $;

--| The value of rising factorial at one. (Contributed by Scott Fenton, 5-Jan-2018.)
theorem risefac1 (A2: class):
  $ wi (wcel A2 cc) (wceq (co A2 c1 crisefac) A2) $;

--| The value of falling factorial at one. (Contributed by Scott Fenton, 5-Jan-2018.)
theorem fallfac1 (A2: class):
  $ wi (wcel A2 cc) (wceq (co A2 c1 cfallfac) A2) $;

--| Relate rising factorial to factorial. (Contributed by Scott Fenton, 5-Jan-2018.)
theorem risefacfac (N: class):
  $ wi (wcel N cn0) (wceq (co c1 N crisefac) (cfv N cfa)) $;

--| The forward difference of a falling factorial. (Contributed by Scott Fenton, 21-Jan-2018.)
theorem fallfacfwd (A2 N: class):
  $ wi (wa (wcel A2 cc) (wcel N cn)) (wceq (co (co (co A2 c1 caddc) N cfallfac) (co A2 N cfallfac) cmin) (co N (co A2 (co N c1 cmin) cfallfac) cmul)) $;

--| The value of the zero falling factorial at natural ` N ` . (Contributed by Scott Fenton, 17-Feb-2018.)
theorem _0fallfac (N: class):
  $ wi (wcel N cn) (wceq (co cc0 N cfallfac) cc0) $;

--| The value of the zero rising factorial at natural ` N ` . (Contributed by Scott Fenton, 17-Feb-2018.)
theorem _0risefac (N: class):
  $ wi (wcel N cn) (wceq (co cc0 N crisefac) cc0) $;

--| Lemma for ~ binomfallfac . Closure law. (Contributed by Scott Fenton, 13-Mar-2018.)
theorem binomfallfaclem1 (ph: wff) (A2 B2 K N: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi (wa ph (wcel K (co cc0 N cfz))) (wcel (co (co N K cbc) (co (co A2 (co N K cmin) cfallfac) (co B2 (co K c1 caddc) cfallfac) cmul) cmul) cc) $;

--| Lemma for ~ binomfallfac . Inductive step. (Contributed by Scott Fenton, 13-Mar-2018.)
theorem binomfallfaclem2 {k: setvar} (ph: wff) (ps: wff k) (A2 B2 N: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ps (wceq (co (co A2 B2 caddc) N cfallfac) (csu k (co cc0 N cfz) (co (co N (cv k) cbc) (co (co A2 (co N (cv k) cmin) cfallfac) (co B2 (cv k) cfallfac) cmul) cmul))) $ >
  $ wi (wa ph ps) (wceq (co (co A2 B2 caddc) (co N c1 caddc) cfallfac) (csu k (co cc0 (co N c1 caddc) cfz) (co (co (co N c1 caddc) (cv k) cbc) (co (co A2 (co (co N c1 caddc) (cv k) cmin) cfallfac) (co B2 (cv k) cfallfac) cmul) cmul))) $;

--| A version of the binomial theorem using falling factorials instead of exponentials. (Contributed by Scott Fenton, 13-Mar-2018.)
theorem binomfallfac {k: setvar} (A2 B2 N: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel N cn0)) (wceq (co (co A2 B2 caddc) N cfallfac) (csu k (co cc0 N cfz) (co (co N (cv k) cbc) (co (co A2 (co N (cv k) cmin) cfallfac) (co B2 (cv k) cfallfac) cmul) cmul))) $;

--| A version of the binomial theorem using rising factorials instead of exponentials. (Contributed by Scott Fenton, 16-Mar-2018.)
theorem binomrisefac {k: setvar} (A2 B2 N: class):
  $ wi (w3a (wcel A2 cc) (wcel B2 cc) (wcel N cn0)) (wceq (co (co A2 B2 caddc) N crisefac) (csu k (co cc0 N cfz) (co (co N (cv k) cbc) (co (co A2 (co N (cv k) cmin) crisefac) (co B2 (cv k) crisefac) cmul) cmul))) $;

--| Represent the falling factorial via factorials when the first argument is a natural. (Contributed by Scott Fenton, 20-Mar-2018.)
theorem fallfacval4 (A2 N: class):
  $ wi (wcel N (co cc0 A2 cfz)) (wceq (co A2 N cfallfac) (co (cfv A2 cfa) (cfv (co A2 N cmin) cfa) cdiv)) $;

--| Binomial coefficient in terms of falling factorials. (Contributed by Scott Fenton, 20-Mar-2018.)
theorem bcfallfac (K N: class):
  $ wi (wcel K (co cc0 N cfz)) (wceq (co N K cbc) (co (co N K cfallfac) (cfv K cfa) cdiv)) $;

--| Relate falling factorial to factorial. (Contributed by Scott Fenton, 5-Jan-2018.)
theorem fallfacfac (N: class):
  $ wi (wcel N cn0) (wceq (co N N cfallfac) (cfv N cfa)) $;

--| Declare the constant for the Bernoulli polynomial operator.
term cbp: class;

--| Define the Bernoulli polynomials. Here we use well-founded recursion to define the Bernoulli polynomials. This agrees with most textbook definitions, although explicit formulas do exist. (Contributed by Scott Fenton, 22-May-2014.)
axiom df_bpoly {x3 g2 k m n: setvar}:
  $ wceq cbp (cmpo m x3 cn0 cc (cfv (cv m) (cwrecs cn0 clt (cmpt g2 cvv (csb n (cfv (cdm (cv g2)) chash) (co (co (cv x3) (cv n) cexp) (csu k (cdm (cv g2)) (co (co (cv n) (cv k) cbc) (co (cfv (cv k) (cv g2)) (co (co (cv n) (cv k) cmin) c1 caddc) cdiv) cmul)) cmin)))))) $;

--| Lemma for ~ bpolyval . (Contributed by Scott Fenton, 22-May-2014.) (Revised by Mario Carneiro, 23-Aug-2014.)
theorem bpolylem {g2 k n: setvar} (F: class) (G: class g2 k n) (N X: class):
  $ wceq G (cmpt g2 cvv (csb n (cfv (cdm (cv g2)) chash) (co (co X (cv n) cexp) (csu k (cdm (cv g2)) (co (co (cv n) (cv k) cbc) (co (cfv (cv k) (cv g2)) (co (co (cv n) (cv k) cmin) c1 caddc) cdiv) cmul)) cmin))) $ >
  $ wceq F (cwrecs cn0 clt G) $ >
  $ wi (wa (wcel N cn0) (wcel X cc)) (wceq (co N X cbp) (co (co X N cexp) (csu k (co cc0 (co N c1 cmin) cfz) (co (co N (cv k) cbc) (co (co (cv k) X cbp) (co (co N (cv k) cmin) c1 caddc) cdiv) cmul)) cmin)) $;

--| The value of the Bernoulli polynomials. (Contributed by Scott Fenton, 16-May-2014.)
theorem bpolyval {k: setvar} (N X: class):
  $ wi (wa (wcel N cn0) (wcel X cc)) (wceq (co N X cbp) (co (co X N cexp) (csu k (co cc0 (co N c1 cmin) cfz) (co (co N (cv k) cbc) (co (co (cv k) X cbp) (co (co N (cv k) cmin) c1 caddc) cdiv) cmul)) cmin)) $;

--| The value of the Bernoulli polynomials at zero. (Contributed by Scott Fenton, 16-May-2014.)
theorem bpoly0 (X: class):
  $ wi (wcel X cc) (wceq (co cc0 X cbp) c1) $;

--| The value of the Bernoulli polynomials at one. (Contributed by Scott Fenton, 16-May-2014.)
theorem bpoly1 (X: class):
  $ wi (wcel X cc) (wceq (co c1 X cbp) (co X (co c1 c2 cdiv) cmin)) $;

--| Closure law for Bernoulli polynomials. (Contributed by Scott Fenton, 16-May-2014.) (Proof shortened by Mario Carneiro, 22-May-2014.)
theorem bpolycl (N X: class):
  $ wi (wa (wcel N cn0) (wcel X cc)) (wcel (co N X cbp) cc) $;

--| A sum for Bernoulli polynomials. (Contributed by Scott Fenton, 16-May-2014.) (Proof shortened by Mario Carneiro, 22-May-2014.)
theorem bpolysum {k: setvar} (N X: class):
  $ wi (wa (wcel N cn0) (wcel X cc)) (wceq (csu k (co cc0 N cfz) (co (co N (cv k) cbc) (co (co (cv k) X cbp) (co (co N (cv k) cmin) c1 caddc) cdiv) cmul)) (co X N cexp)) $;

--| Lemma for ~ bpolydif . (Contributed by Scott Fenton, 12-Jun-2014.)
theorem bpolydiflem {k: setvar} (ph: wff) (N X: class):
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel X cc) $ >
  $ wi (wa ph (wcel (cv k) (co c1 (co N c1 cmin) cfz))) (wceq (co (co (cv k) (co X c1 caddc) cbp) (co (cv k) X cbp) cmin) (co (cv k) (co X (co (cv k) c1 cmin) cexp) cmul)) $ >
  $ wi ph (wceq (co (co N (co X c1 caddc) cbp) (co N X cbp) cmin) (co N (co X (co N c1 cmin) cexp) cmul)) $;

--| Calculate the difference between successive values of the Bernoulli polynomials. (Contributed by Scott Fenton, 16-May-2014.) (Proof shortened by Mario Carneiro, 26-May-2014.)
theorem bpolydif (N X: class):
  $ wi (wa (wcel N cn) (wcel X cc)) (wceq (co (co N (co X c1 caddc) cbp) (co N X cbp) cmin) (co N (co X (co N c1 cmin) cexp) cmul)) $;

--| A closed-form expression for the sum of ` K ` -th powers. (Contributed by Scott Fenton, 16-May-2014.) This is Metamath 100 proof #77. (Revised by Mario Carneiro, 16-Jun-2014.)
theorem fsumkthpow {n: setvar} (K M: class):
  $ wi (wa (wcel K cn0) (wcel M cn0)) (wceq (csu n (co cc0 M cfz) (co (cv n) K cexp)) (co (co (co (co K c1 caddc) (co M c1 caddc) cbp) (co (co K c1 caddc) cc0 cbp) cmin) (co K c1 caddc) cdiv)) $;

--| The Bernoulli polynomials at two. (Contributed by Scott Fenton, 8-Jul-2015.)
theorem bpoly2 (X: class):
  $ wi (wcel X cc) (wceq (co c2 X cbp) (co (co (co X c2 cexp) X cmin) (co c1 c6 cdiv) caddc)) $;

--| The Bernoulli polynomials at three. (Contributed by Scott Fenton, 8-Jul-2015.)
theorem bpoly3 (X: class):
  $ wi (wcel X cc) (wceq (co c3 X cbp) (co (co (co X c3 cexp) (co (co c3 c2 cdiv) (co X c2 cexp) cmul) cmin) (co (co c1 c2 cdiv) X cmul) caddc)) $;

--| The Bernoulli polynomials at four. (Contributed by Scott Fenton, 8-Jul-2015.)
theorem bpoly4 (X: class):
  $ wi (wcel X cc) (wceq (co c4 X cbp) (co (co (co (co X c4 cexp) (co c2 (co X c3 cexp) cmul) cmin) (co X c2 cexp) caddc) (co c1 (cdc c3 cc0) cdiv) cmin)) $;

--| Express the sum of cubes in closed terms. (Contributed by Scott Fenton, 16-Jun-2015.)
theorem fsumcube {k: setvar} (T: class):
  $ wi (wcel T cn0) (wceq (csu k (co cc0 T cfz) (co (cv k) c3 cexp)) (co (co (co T c2 cexp) (co (co T c1 caddc) c2 cexp) cmul) c4 cdiv)) $;

--| Extend class notation to include the exponential function.
term ce: class;

--| Extend class notation to include Euler's constant ` _e ` = 2.71828....
term ceu: class;

--| Extend class notation to include the sine function.
term csin: class;

--| Extend class notation to include the cosine function.
term ccos: class;

--| Extend class notation to include the tangent function.
term ctan: class;

--| Extend class notation to include the constant pi, ` _pi ` = 3.14159....
term cpi: class;

--| Define the exponential function. Its value at the complex number ` A ` is ` ( exp `` A ) ` and is called the "exponential of ` A ` "; see ~ efval . (Contributed by NM, 14-Mar-2005.)
axiom df_ef {x3 k: setvar}:
  $ wceq ce (cmpt x3 cc (csu k cn0 (co (co (cv x3) (cv k) cexp) (cfv (cv k) cfa) cdiv))) $;

--| Define Euler's constant ` _e ` = 2.71828.... (Contributed by NM, 14-Mar-2005.)
axiom df_e:
  $ wceq ceu (cfv c1 ce) $;

--| Define the sine function. (Contributed by NM, 14-Mar-2005.)
axiom df_sin {x3: setvar}:
  $ wceq csin (cmpt x3 cc (co (co (cfv (co ci (cv x3) cmul) ce) (cfv (co (cneg ci) (cv x3) cmul) ce) cmin) (co c2 ci cmul) cdiv)) $;

--| Define the cosine function. (Contributed by NM, 14-Mar-2005.)
axiom df_cos {x3: setvar}:
  $ wceq ccos (cmpt x3 cc (co (co (cfv (co ci (cv x3) cmul) ce) (cfv (co (cneg ci) (cv x3) cmul) ce) caddc) c2 cdiv)) $;

--| Define the tangent function. We define it this way for ~ cmpt , which requires the form ` ( x e. A |-> B ) ` . (Contributed by Mario Carneiro, 14-Mar-2014.)
axiom df_tan {x3: setvar}:
  $ wceq ctan (cmpt x3 (cima (ccnv ccos) (cdif cc (csn cc0))) (co (cfv (cv x3) csin) (cfv (cv x3) ccos) cdiv)) $;

--| Define the constant pi, ` _pi ` = 3.14159..., which is the smallest positive number whose sine is zero. Definition of ` _pi ` in [Gleason] p. 311. (Contributed by Paul Chapman, 23-Jan-2008.) (Revised by AV, 14-Sep-2020.)
axiom df_pi:
  $ wceq cpi (cinf (cin crp (cima (ccnv csin) (csn cc0))) cr clt) $;

--| Closure of a term in the series expansion of the exponential function. (Contributed by Paul Chapman, 11-Sep-2007.)
theorem eftcl (A2 K: class):
  $ wi (wa (wcel A2 cc) (wcel K cn0)) (wcel (co (co A2 K cexp) (cfv K cfa) cdiv) cc) $;

--| The terms of the series expansion of the exponential function at a real number are real. (Contributed by Paul Chapman, 15-Jan-2008.)
theorem reeftcl (A2 K: class):
  $ wi (wa (wcel A2 cr) (wcel K cn0)) (wcel (co (co A2 K cexp) (cfv K cfa) cdiv) cr) $;

--| The absolute value of a term in the series expansion of the exponential function. (Contributed by Paul Chapman, 23-Nov-2007.)
theorem eftabs (A2 K: class):
  $ wi (wa (wcel A2 cc) (wcel K cn0)) (wceq (cfv (co (co A2 K cexp) (cfv K cfa) cdiv) cabs) (co (co (cfv A2 cabs) K cexp) (cfv K cfa) cdiv)) $;

--| The value of a term in the series expansion of the exponential function. (Contributed by Paul Chapman, 21-Aug-2007.) (Revised by Mario Carneiro, 28-Apr-2014.)
theorem eftval {n: setvar} (A2: class) (F: class n) (N: class):
  $ wceq F (cmpt n cn0 (co (co A2 (cv n) cexp) (cfv (cv n) cfa) cdiv)) $ >
  $ wi (wcel N cn0) (wceq (cfv N F) (co (co A2 N cexp) (cfv N cfa) cdiv)) $;

--| Lemma for ~ efcl . The series that defines the exponential function converges, in the case where its argument is nonzero. The ratio test ~ cvgrat is used to show convergence. (Contributed by NM, 26-Apr-2005.) (Proof shortened by Mario Carneiro, 28-Apr-2014.) (Proof shortened by AV, 9-Jul-2022.)
theorem efcllem {n: setvar} (A2: class) (F: class n):
  $ wceq F (cmpt n cn0 (co (co A2 (cv n) cexp) (cfv (cv n) cfa) cdiv)) $ >
  $ wi (wcel A2 cc) (wcel (cseq caddc F cc0) (cdm cli)) $;

--| The series defining the exponential function converges in the (trivial) case of a zero argument. (Contributed by Steve Rodriguez, 7-Jun-2006.) (Revised by Mario Carneiro, 28-Apr-2014.)
theorem ef0lem {n: setvar} (A2: class) (F: class n):
  $ wceq F (cmpt n cn0 (co (co A2 (cv n) cexp) (cfv (cv n) cfa) cdiv)) $ >
  $ wi (wceq A2 cc0) (wbr (cseq caddc F cc0) c1 cli) $;

--| Value of the exponential function. (Contributed by NM, 8-Jan-2006.) (Revised by Mario Carneiro, 10-Nov-2013.)
theorem efval {k: setvar} (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv A2 ce) (csu k cn0 (co (co A2 (cv k) cexp) (cfv (cv k) cfa) cdiv))) $;

--| Value of Euler's constant ` _e ` = 2.71828.... (Contributed by Steve Rodriguez, 5-Mar-2006.)
theorem esum {k: setvar}:
  $ wceq ceu (csu k cn0 (co c1 (cfv (cv k) cfa) cdiv)) $;

--| Domain and codomain of the exponential function. (Contributed by Paul Chapman, 22-Oct-2007.) (Proof shortened by Mario Carneiro, 28-Apr-2014.)
theorem eff:
  $ wf cc cc ce $;

--| Closure law for the exponential function. (Contributed by NM, 8-Jan-2006.) (Revised by Mario Carneiro, 10-Nov-2013.)
theorem efcl (A2: class):
  $ wi (wcel A2 cc) (wcel (cfv A2 ce) cc) $;

--| Closure law for the exponential function, deduction version. (Contributed by Thierry Arnoux, 1-Dec-2021.)
theorem efcld (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel (cfv A2 ce) cc) $;

--| Value of the exponential function. (Contributed by Mario Carneiro, 29-Apr-2014.)
theorem efval2 {k n: setvar} (A2: class) (F: class n):
  $ wceq F (cmpt n cn0 (co (co A2 (cv n) cexp) (cfv (cv n) cfa) cdiv)) $ >
  $ wi (wcel A2 cc) (wceq (cfv A2 ce) (csu k cn0 (cfv (cv k) F))) $;

--| The series that defines the exponential function converges to it. (Contributed by NM, 9-Jan-2006.) (Revised by Mario Carneiro, 28-Apr-2014.)
theorem efcvg {n: setvar} (A2: class) (F: class n):
  $ wceq F (cmpt n cn0 (co (co A2 (cv n) cexp) (cfv (cv n) cfa) cdiv)) $ >
  $ wi (wcel A2 cc) (wbr (cseq caddc F cc0) (cfv A2 ce) cli) $;

--| Exponential function convergence in terms of a sequence of partial finite sums. (Contributed by NM, 10-Jan-2006.) (Revised by Mario Carneiro, 28-Apr-2014.)
theorem efcvgfsum {k n: setvar} (A2: class) (F: class k n):
  $ wceq F (cmpt n cn0 (csu k (co cc0 (cv n) cfz) (co (co A2 (cv k) cexp) (cfv (cv k) cfa) cdiv))) $ >
  $ wi (wcel A2 cc) (wbr F (cfv A2 ce) cli) $;

--| The exponential function is real if its argument is real. (Contributed by NM, 27-Apr-2005.) (Revised by Mario Carneiro, 28-Apr-2014.)
theorem reefcl (A2: class):
  $ wi (wcel A2 cr) (wcel (cfv A2 ce) cr) $;

--| The exponential function is real if its argument is real. (Contributed by Mario Carneiro, 29-May-2016.)
theorem reefcld (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel (cfv A2 ce) cr) $;

--| Euler's constant ` _e ` = 2.71828... is a real number. (Contributed by NM, 19-Mar-2005.) (Revised by Steve Rodriguez, 8-Mar-2006.)
theorem ere:
  $ wcel ceu cr $;

--| Lemma for ~ egt2lt3 . (Contributed by NM, 20-Mar-2005.) (Proof shortened by Mario Carneiro, 28-Apr-2014.)
theorem ege2le3 {n: setvar} (F G: class n):
  $ wceq F (cmpt n cn (co c2 (co (co c1 c2 cdiv) (cv n) cexp) cmul)) $ >
  $ wceq G (cmpt n cn0 (co c1 (cfv (cv n) cfa) cdiv)) $ >
  $ wa (wbr c2 ceu cle) (wbr ceu c3 cle) $;

--| Value of the exponential function at 0. Equation 2 of [Gleason] p. 308. (Contributed by Steve Rodriguez, 27-Jun-2006.) (Revised by Mario Carneiro, 28-Apr-2014.)
theorem ef0:
  $ wceq (cfv cc0 ce) c1 $;

--| The exponential of a complex conjugate. Equation 3 of [Gleason] p. 308. (Contributed by NM, 29-Apr-2005.) (Revised by Mario Carneiro, 28-Apr-2014.)
theorem efcj (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv (cfv A2 ccj) ce) (cfv (cfv A2 ce) ccj)) $;

--| Lemma for ~ efadd (exponential function addition law). (Contributed by Mario Carneiro, 29-Apr-2014.)
theorem efaddlem {n: setvar} (ph: wff n) (A2 B2: class) (F G H: class n):
  $ wceq F (cmpt n cn0 (co (co A2 (cv n) cexp) (cfv (cv n) cfa) cdiv)) $ >
  $ wceq G (cmpt n cn0 (co (co B2 (cv n) cexp) (cfv (cv n) cfa) cdiv)) $ >
  $ wceq H (cmpt n cn0 (co (co (co A2 B2 caddc) (cv n) cexp) (cfv (cv n) cfa) cdiv)) $ >
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wceq (cfv (co A2 B2 caddc) ce) (co (cfv A2 ce) (cfv B2 ce) cmul)) $;

--| Sum of exponents law for exponential function. (Contributed by NM, 10-Jan-2006.) (Proof shortened by Mario Carneiro, 29-Apr-2014.)
theorem efadd (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (cfv (co A2 B2 caddc) ce) (co (cfv A2 ce) (cfv B2 ce) cmul)) $;

--| Move the exponential function from inside a finite product to outside a finite sum. (Contributed by Scott Fenton, 26-Dec-2017.)
theorem fprodefsum {k: setvar} (ph: wff) (A2: class k) (M N Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wi ph (wcel N Z) $ >
  $ wi (wa ph (wcel (cv k) Z)) (wcel A2 cc) $ >
  $ wi ph (wceq (cprod k (co M N cfz) (cfv A2 ce)) (cfv (csu k (co M N cfz) A2) ce)) $;

--| Cancellation law for exponential function. Equation 27 of [Rudin] p. 164. (Contributed by NM, 13-Jan-2006.)
theorem efcan (A2: class):
  $ wi (wcel A2 cc) (wceq (co (cfv A2 ce) (cfv (cneg A2) ce) cmul) c1) $;

--| The exponential of a complex number is nonzero, deduction form. (Contributed by NM, 13-Jan-2006.) (Revised by Mario Carneiro, 29-Apr-2014.) (Revised by SN, 25-Apr-2025.)
theorem efne0d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wne (cfv A2 ce) cc0) $;

--| The exponential of a complex number is nonzero. Corollary 15-4.3 of [Gleason] p. 309. (Contributed by NM, 13-Jan-2006.) (Revised by Mario Carneiro, 29-Apr-2014.) (Proof shortened by TA, 14-Nov-2025.)
theorem efne0 (A2: class):
  $ wi (wcel A2 cc) (wne (cfv A2 ce) cc0) $;

--| Obsolete version of ~ efne0 as of 14-Nov-2025. The exponential of a complex number is nonzero. Corollary 15-4.3 of [Gleason] p. 309. (Contributed by NM, 13-Jan-2006.) (Revised by Mario Carneiro, 29-Apr-2014.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem efne0OLD (A2: class):
  $ wi (wcel A2 cc) (wne (cfv A2 ce) cc0) $;

--| The exponential of the opposite is the inverse of the exponential. (Contributed by Mario Carneiro, 10-May-2014.)
theorem efneg (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv (cneg A2) ce) (co c1 (cfv A2 ce) cdiv)) $;

--| The exponential function maps the complex numbers to the nonzero complex numbers. (Contributed by Paul Chapman, 16-Apr-2008.)
theorem eff2:
  $ wf cc (cdif cc (csn cc0)) ce $;

--| Difference of exponents law for exponential function. (Contributed by Steve Rodriguez, 25-Nov-2007.)
theorem efsub (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (cfv (co A2 B2 cmin) ce) (co (cfv A2 ce) (cfv B2 ce) cdiv)) $;

--| The exponential of an integer power. Corollary 15-4.4 of [Gleason] p. 309, restricted to integers. (Contributed by NM, 13-Jan-2006.) (Revised by Mario Carneiro, 5-Jun-2014.)
theorem efexp (A2 N: class):
  $ wi (wa (wcel A2 cc) (wcel N cz)) (wceq (cfv (co N A2 cmul) ce) (co (cfv A2 ce) N cexp)) $;

--| Value of the exponential function for integers. Special case of ~ efval . Equation 30 of [Rudin] p. 164. (Contributed by Steve Rodriguez, 15-Sep-2006.) (Revised by Mario Carneiro, 5-Jun-2014.)
theorem efzval (N: class):
  $ wi (wcel N cz) (wceq (cfv N ce) (co ceu N cexp)) $;

--| The exponential of a real number is greater than 0. (Contributed by Paul Chapman, 21-Aug-2007.) (Revised by Mario Carneiro, 30-Apr-2014.)
theorem efgt0 (A2: class):
  $ wi (wcel A2 cr) (wbr cc0 (cfv A2 ce) clt) $;

--| The exponential of a real number is a positive real. (Contributed by Mario Carneiro, 10-Nov-2013.)
theorem rpefcl (A2: class):
  $ wi (wcel A2 cr) (wcel (cfv A2 ce) crp) $;

--| The exponential of a real number is a positive real. (Contributed by Mario Carneiro, 29-May-2016.)
theorem rpefcld (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel (cfv A2 ce) crp) $;

--| The tail series of the exponential function are convergent. (Contributed by Mario Carneiro, 29-Apr-2014.)
theorem eftlcvg {n: setvar} (A2: class) (F: class n) (M: class):
  $ wceq F (cmpt n cn0 (co (co A2 (cv n) cexp) (cfv (cv n) cfa) cdiv)) $ >
  $ wi (wa (wcel A2 cc) (wcel M cn0)) (wcel (cseq caddc F M) (cdm cli)) $;

--| Closure of the sum of an infinite tail of the series defining the exponential function. (Contributed by Paul Chapman, 17-Jan-2008.) (Revised by Mario Carneiro, 30-Apr-2014.)
theorem eftlcl {k n: setvar} (A2: class) (F: class n) (M: class):
  $ wceq F (cmpt n cn0 (co (co A2 (cv n) cexp) (cfv (cv n) cfa) cdiv)) $ >
  $ wi (wa (wcel A2 cc) (wcel M cn0)) (wcel (csu k (cfv M cuz) (cfv (cv k) F)) cc) $;

--| Closure of the sum of an infinite tail of the series defining the exponential function. (Contributed by Paul Chapman, 17-Jan-2008.) (Revised by Mario Carneiro, 30-Apr-2014.)
theorem reeftlcl {k n: setvar} (A2: class) (F: class n) (M: class):
  $ wceq F (cmpt n cn0 (co (co A2 (cv n) cexp) (cfv (cv n) cfa) cdiv)) $ >
  $ wi (wa (wcel A2 cr) (wcel M cn0)) (wcel (csu k (cfv M cuz) (cfv (cv k) F)) cr) $;

--| An upper bound on the absolute value of the infinite tail of the series expansion of the exponential function on the closed unit disk. (Contributed by Paul Chapman, 19-Jan-2008.) (Proof shortened by Mario Carneiro, 29-Apr-2014.)
theorem eftlub {k n: setvar} (ph: wff n) (A2: class) (F G: class n) (H: class k n) (M: class):
  $ wceq F (cmpt n cn0 (co (co A2 (cv n) cexp) (cfv (cv n) cfa) cdiv)) $ >
  $ wceq G (cmpt n cn0 (co (co (cfv A2 cabs) (cv n) cexp) (cfv (cv n) cfa) cdiv)) $ >
  $ wceq H (cmpt n cn0 (co (co (co (cfv A2 cabs) M cexp) (cfv M cfa) cdiv) (co (co c1 (co M c1 caddc) cdiv) (cv n) cexp) cmul)) $ >
  $ wi ph (wcel M cn) $ >
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wbr (cfv A2 cabs) c1 cle) $ >
  $ wi ph (wbr (cfv (csu k (cfv M cuz) (cfv (cv k) F)) cabs) (co (co (cfv A2 cabs) M cexp) (co (co M c1 caddc) (co (cfv M cfa) M cmul) cdiv) cmul) cle) $;

--| Separate out the next term of the power series expansion of the exponential function. The last hypothesis allows the separated terms to be rearranged as desired. (Contributed by Paul Chapman, 23-Nov-2007.) (Revised by Mario Carneiro, 29-Apr-2014.)
theorem efsep {k n: setvar} (ph: wff n) (A2: class) (B2 D: class k n) (F: class n) (M N: class):
  $ wceq F (cmpt n cn0 (co (co A2 (cv n) cexp) (cfv (cv n) cfa) cdiv)) $ >
  $ wceq N (co M c1 caddc) $ >
  $ wcel M cn0 $ >
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wceq (cfv A2 ce) (co B2 (csu k (cfv M cuz) (cfv (cv k) F)) caddc)) $ >
  $ wi ph (wceq (co B2 (co (co A2 M cexp) (cfv M cfa) cdiv) caddc) D) $ >
  $ wi ph (wceq (cfv A2 ce) (co D (csu k (cfv N cuz) (cfv (cv k) F)) caddc)) $;

--| The partial sums of the series expansion of the exponential function at a positive real number are bounded by the value of the function. (Contributed by Paul Chapman, 21-Aug-2007.) (Revised by Mario Carneiro, 29-Apr-2014.)
theorem effsumlt {n: setvar} (ph: wff n) (A2: class) (F N: class n):
  $ wceq F (cmpt n cn0 (co (co A2 (cv n) cexp) (cfv (cv n) cfa) cdiv)) $ >
  $ wi ph (wcel A2 crp) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wbr (cfv N (cseq caddc F cc0)) (cfv A2 ce) clt) $;

--| The value of the first term of the series expansion of the exponential function is 1. (Contributed by Paul Chapman, 21-Aug-2007.) (Revised by Mario Carneiro, 29-Apr-2014.)
theorem eft0val (A2: class):
  $ wi (wcel A2 cc) (wceq (co (co A2 cc0 cexp) (cfv cc0 cfa) cdiv) c1) $;

--| Separate out the first four terms of the infinite series expansion of the exponential function. (Contributed by Paul Chapman, 19-Jan-2008.) (Revised by Mario Carneiro, 29-Apr-2014.)
theorem ef4p {k n: setvar} (A2: class) (F: class n):
  $ wceq F (cmpt n cn0 (co (co A2 (cv n) cexp) (cfv (cv n) cfa) cdiv)) $ >
  $ wi (wcel A2 cc) (wceq (cfv A2 ce) (co (co (co (co c1 A2 caddc) (co (co A2 c2 cexp) c2 cdiv) caddc) (co (co A2 c3 cexp) c6 cdiv) caddc) (csu k (cfv c4 cuz) (cfv (cv k) F)) caddc)) $;

--| The exponential of a positive real number is greater than the sum of the first three terms of the series expansion. (Contributed by Mario Carneiro, 15-Sep-2014.)
theorem efgt1p2 (A2: class):
  $ wi (wcel A2 crp) (wbr (co (co c1 A2 caddc) (co (co A2 c2 cexp) c2 cdiv) caddc) (cfv A2 ce) clt) $;

--| The exponential of a positive real number is greater than 1 plus that number. (Contributed by Mario Carneiro, 14-Mar-2014.) (Revised by Mario Carneiro, 30-Apr-2014.)
theorem efgt1p (A2: class):
  $ wi (wcel A2 crp) (wbr (co c1 A2 caddc) (cfv A2 ce) clt) $;

--| The exponential of a positive real number is greater than 1. (Contributed by Paul Chapman, 21-Aug-2007.) (Revised by Mario Carneiro, 30-Apr-2014.)
theorem efgt1 (A2: class):
  $ wi (wcel A2 crp) (wbr c1 (cfv A2 ce) clt) $;

--| The exponential function on the reals is strictly increasing. (Contributed by Paul Chapman, 21-Aug-2007.) (Revised by Mario Carneiro, 17-Jul-2014.)
theorem eflt (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wb (wbr A2 B2 clt) (wbr (cfv A2 ce) (cfv B2 ce) clt)) $;

--| The exponential function on the reals is nondecreasing. (Contributed by Mario Carneiro, 11-Mar-2014.)
theorem efle (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wb (wbr A2 B2 cle) (wbr (cfv A2 ce) (cfv B2 ce) cle)) $;

--| The exponential function on real numbers is one-to-one. (Contributed by NM, 21-Aug-2008.) (Revised by Mario Carneiro, 11-Mar-2014.)
theorem reef11 (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wb (wceq (cfv A2 ce) (cfv B2 ce)) (wceq A2 B2)) $;

--| The exponential function maps real arguments one-to-one to positive reals. (Contributed by Steve Rodriguez, 25-Aug-2007.) (Revised by Mario Carneiro, 10-Nov-2013.)
theorem reeff1:
  $ wf1 cr crp (cres ce cr) $;

--| The exponential function on the reals between 0 and 1 lies below the comparable geometric series sum. (Contributed by Paul Chapman, 11-Sep-2007.)
theorem eflegeo (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wbr cc0 A2 cle) $ >
  $ wi ph (wbr A2 c1 clt) $ >
  $ wi ph (wbr (cfv A2 ce) (co c1 (co c1 A2 cmin) cdiv) cle) $;

--| Value of the sine function. (Contributed by NM, 14-Mar-2005.) (Revised by Mario Carneiro, 10-Nov-2013.)
theorem sinval (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv A2 csin) (co (co (cfv (co ci A2 cmul) ce) (cfv (co (cneg ci) A2 cmul) ce) cmin) (co c2 ci cmul) cdiv)) $;

--| Value of the cosine function. (Contributed by NM, 14-Mar-2005.) (Revised by Mario Carneiro, 10-Nov-2013.)
theorem cosval (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv A2 ccos) (co (co (cfv (co ci A2 cmul) ce) (cfv (co (cneg ci) A2 cmul) ce) caddc) c2 cdiv)) $;

--| Domain and codomain of the sine function. (Contributed by Paul Chapman, 22-Oct-2007.) (Revised by Mario Carneiro, 30-Apr-2014.)
theorem sinf:
  $ wf cc cc csin $;

--| Domain and codomain of the cosine function. (Contributed by Paul Chapman, 22-Oct-2007.) (Revised by Mario Carneiro, 30-Apr-2014.)
theorem cosf:
  $ wf cc cc ccos $;

--| Closure of the sine function. (Contributed by NM, 28-Apr-2005.) (Revised by Mario Carneiro, 30-Apr-2014.)
theorem sincl (A2: class):
  $ wi (wcel A2 cc) (wcel (cfv A2 csin) cc) $;

--| Closure of the cosine function with a complex argument. (Contributed by NM, 28-Apr-2005.) (Revised by Mario Carneiro, 30-Apr-2014.)
theorem coscl (A2: class):
  $ wi (wcel A2 cc) (wcel (cfv A2 ccos) cc) $;

--| Value of the tangent function. (Contributed by Mario Carneiro, 14-Mar-2014.)
theorem tanval (A2: class):
  $ wi (wa (wcel A2 cc) (wne (cfv A2 ccos) cc0)) (wceq (cfv A2 ctan) (co (cfv A2 csin) (cfv A2 ccos) cdiv)) $;

--| The closure of the tangent function with a complex argument. (Contributed by David A. Wheeler, 15-Mar-2014.)
theorem tancl (A2: class):
  $ wi (wa (wcel A2 cc) (wne (cfv A2 ccos) cc0)) (wcel (cfv A2 ctan) cc) $;

--| Closure of the sine function. (Contributed by Mario Carneiro, 29-May-2016.)
theorem sincld (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel (cfv A2 csin) cc) $;

--| Closure of the cosine function. (Contributed by Mario Carneiro, 29-May-2016.)
theorem coscld (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel (cfv A2 ccos) cc) $;

--| Closure of the tangent function. (Contributed by Mario Carneiro, 29-May-2016.)
theorem tancld (ph: wff) (A2: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wne (cfv A2 ccos) cc0) $ >
  $ wi ph (wcel (cfv A2 ctan) cc) $;

--| Express the tangent function directly in terms of ` exp ` . (Contributed by Mario Carneiro, 25-Feb-2015.)
theorem tanval2 (A2: class):
  $ wi (wa (wcel A2 cc) (wne (cfv A2 ccos) cc0)) (wceq (cfv A2 ctan) (co (co (cfv (co ci A2 cmul) ce) (cfv (co (cneg ci) A2 cmul) ce) cmin) (co ci (co (cfv (co ci A2 cmul) ce) (cfv (co (cneg ci) A2 cmul) ce) caddc) cmul) cdiv)) $;

--| Express the tangent function directly in terms of ` exp ` . (Contributed by Mario Carneiro, 25-Feb-2015.)
theorem tanval3 (A2: class):
  $ wi (wa (wcel A2 cc) (wne (co (cfv (co c2 (co ci A2 cmul) cmul) ce) c1 caddc) cc0)) (wceq (cfv A2 ctan) (co (co (cfv (co c2 (co ci A2 cmul) cmul) ce) c1 cmin) (co ci (co (cfv (co c2 (co ci A2 cmul) cmul) ce) c1 caddc) cmul) cdiv)) $;

--| The sine of a real number in terms of the exponential function. (Contributed by NM, 30-Apr-2005.)
theorem resinval (A2: class):
  $ wi (wcel A2 cr) (wceq (cfv A2 csin) (cfv (cfv (co ci A2 cmul) ce) cim)) $;

--| The cosine of a real number in terms of the exponential function. (Contributed by NM, 30-Apr-2005.)
theorem recosval (A2: class):
  $ wi (wcel A2 cr) (wceq (cfv A2 ccos) (cfv (cfv (co ci A2 cmul) ce) cre)) $;

--| Separate out the first four terms of the infinite series expansion of the exponential function. (Contributed by Paul Chapman, 19-Jan-2008.) (Revised by Mario Carneiro, 30-Apr-2014.)
theorem efi4p {k n: setvar} (A2: class) (F: class n):
  $ wceq F (cmpt n cn0 (co (co (co ci A2 cmul) (cv n) cexp) (cfv (cv n) cfa) cdiv)) $ >
  $ wi (wcel A2 cc) (wceq (cfv (co ci A2 cmul) ce) (co (co (co c1 (co (co A2 c2 cexp) c2 cdiv) cmin) (co ci (co A2 (co (co A2 c3 cexp) c6 cdiv) cmin) cmul) caddc) (csu k (cfv c4 cuz) (cfv (cv k) F)) caddc)) $;

--| Separate out the first four terms of the infinite series expansion of the sine of a real number. (Contributed by Paul Chapman, 19-Jan-2008.) (Revised by Mario Carneiro, 30-Apr-2014.)
theorem resin4p {k n: setvar} (A2: class) (F: class n):
  $ wceq F (cmpt n cn0 (co (co (co ci A2 cmul) (cv n) cexp) (cfv (cv n) cfa) cdiv)) $ >
  $ wi (wcel A2 cr) (wceq (cfv A2 csin) (co (co A2 (co (co A2 c3 cexp) c6 cdiv) cmin) (cfv (csu k (cfv c4 cuz) (cfv (cv k) F)) cim) caddc)) $;

--| Separate out the first four terms of the infinite series expansion of the cosine of a real number. (Contributed by Paul Chapman, 19-Jan-2008.) (Revised by Mario Carneiro, 30-Apr-2014.)
theorem recos4p {k n: setvar} (A2: class) (F: class n):
  $ wceq F (cmpt n cn0 (co (co (co ci A2 cmul) (cv n) cexp) (cfv (cv n) cfa) cdiv)) $ >
  $ wi (wcel A2 cr) (wceq (cfv A2 ccos) (co (co c1 (co (co A2 c2 cexp) c2 cdiv) cmin) (cfv (csu k (cfv c4 cuz) (cfv (cv k) F)) cre) caddc)) $;

--| The sine of a real number is real. (Contributed by NM, 30-Apr-2005.)
theorem resincl (A2: class):
  $ wi (wcel A2 cr) (wcel (cfv A2 csin) cr) $;

--| The cosine of a real number is real. (Contributed by NM, 30-Apr-2005.)
theorem recoscl (A2: class):
  $ wi (wcel A2 cr) (wcel (cfv A2 ccos) cr) $;

--| The closure of the tangent function with a real argument. (Contributed by David A. Wheeler, 15-Mar-2014.)
theorem retancl (A2: class):
  $ wi (wa (wcel A2 cr) (wne (cfv A2 ccos) cc0)) (wcel (cfv A2 ctan) cr) $;

--| Closure of the sine function. (Contributed by Mario Carneiro, 29-May-2016.)
theorem resincld (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel (cfv A2 csin) cr) $;

--| Closure of the cosine function. (Contributed by Mario Carneiro, 29-May-2016.)
theorem recoscld (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel (cfv A2 ccos) cr) $;

--| Closure of the tangent function. (Contributed by Mario Carneiro, 29-May-2016.)
theorem retancld (ph: wff) (A2: class):
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wne (cfv A2 ccos) cc0) $ >
  $ wi ph (wcel (cfv A2 ctan) cr) $;

--| The sine of a negative is the negative of the sine. (Contributed by NM, 30-Apr-2005.)
theorem sinneg (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv (cneg A2) csin) (cneg (cfv A2 csin))) $;

--| The cosines of a number and its negative are the same. (Contributed by NM, 30-Apr-2005.)
theorem cosneg (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv (cneg A2) ccos) (cfv A2 ccos)) $;

--| The tangent of a negative is the negative of the tangent. (Contributed by David A. Wheeler, 23-Mar-2014.)
theorem tanneg (A2: class):
  $ wi (wa (wcel A2 cc) (wne (cfv A2 ccos) cc0)) (wceq (cfv (cneg A2) ctan) (cneg (cfv A2 ctan))) $;

--| Value of the sine function at 0. (Contributed by Steve Rodriguez, 14-Mar-2005.)
theorem sin0:
  $ wceq (cfv cc0 csin) cc0 $;

--| Value of the cosine function at 0. (Contributed by NM, 30-Apr-2005.)
theorem cos0:
  $ wceq (cfv cc0 ccos) c1 $;

--| The value of the tangent function at zero is zero. (Contributed by David A. Wheeler, 16-Mar-2014.)
theorem tan0:
  $ wceq (cfv cc0 ctan) cc0 $;

--| The exponential function in terms of sine and cosine. (Contributed by NM, 30-Apr-2005.)
theorem efival (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv (co ci A2 cmul) ce) (co (cfv A2 ccos) (co ci (cfv A2 csin) cmul) caddc)) $;

--| The exponential function in terms of sine and cosine. (Contributed by NM, 14-Jan-2006.)
theorem efmival (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv (co (cneg ci) A2 cmul) ce) (co (cfv A2 ccos) (co ci (cfv A2 csin) cmul) cmin)) $;

--| Value of the hyperbolic sine of a complex number. (Contributed by Mario Carneiro, 4-Apr-2015.)
theorem sinhval (A2: class):
  $ wi (wcel A2 cc) (wceq (co (cfv (co ci A2 cmul) csin) ci cdiv) (co (co (cfv A2 ce) (cfv (cneg A2) ce) cmin) c2 cdiv)) $;

--| Value of the hyperbolic cosine of a complex number. (Contributed by Mario Carneiro, 4-Apr-2015.)
theorem coshval (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv (co ci A2 cmul) ccos) (co (co (cfv A2 ce) (cfv (cneg A2) ce) caddc) c2 cdiv)) $;

--| The hyperbolic sine of a real number is real. (Contributed by Mario Carneiro, 4-Apr-2015.)
theorem resinhcl (A2: class):
  $ wi (wcel A2 cr) (wcel (co (cfv (co ci A2 cmul) csin) ci cdiv) cr) $;

--| The hyperbolic cosine of a real number is a positive real. (Contributed by Mario Carneiro, 4-Apr-2015.)
theorem rpcoshcl (A2: class):
  $ wi (wcel A2 cr) (wcel (cfv (co ci A2 cmul) ccos) crp) $;

--| The hyperbolic cosine of a real number is real. (Contributed by Mario Carneiro, 4-Apr-2015.)
theorem recoshcl (A2: class):
  $ wi (wcel A2 cr) (wcel (cfv (co ci A2 cmul) ccos) cr) $;

--| The hyperbolic tangent of a real number is real. (Contributed by Mario Carneiro, 4-Apr-2015.)
theorem retanhcl (A2: class):
  $ wi (wcel A2 cr) (wcel (co (cfv (co ci A2 cmul) ctan) ci cdiv) cr) $;

--| The hyperbolic tangent of a real number is upper bounded by ` 1 ` . (Contributed by Mario Carneiro, 4-Apr-2015.)
theorem tanhlt1 (A2: class):
  $ wi (wcel A2 cr) (wbr (co (cfv (co ci A2 cmul) ctan) ci cdiv) c1 clt) $;

--| The hyperbolic tangent of a real number is bounded by ` 1 ` . (Contributed by Mario Carneiro, 4-Apr-2015.)
theorem tanhbnd (A2: class):
  $ wi (wcel A2 cr) (wcel (co (cfv (co ci A2 cmul) ctan) ci cdiv) (co (cneg c1) c1 cioo)) $;

--| Eulerian representation of the complex exponential. (Suggested by Jeff Hankins, 3-Jul-2006.) (Contributed by NM, 4-Jul-2006.)
theorem efeul (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv A2 ce) (co (cfv (cfv A2 cre) ce) (co (cfv (cfv A2 cim) ccos) (co ci (cfv (cfv A2 cim) csin) cmul) caddc) cmul)) $;

--| The exponentials of two imaginary numbers are equal iff their sine and cosine components are equal. (Contributed by Paul Chapman, 15-Mar-2008.)
theorem efieq (A2 B2: class):
  $ wi (wa (wcel A2 cr) (wcel B2 cr)) (wb (wceq (cfv (co ci A2 cmul) ce) (cfv (co ci B2 cmul) ce)) (wa (wceq (cfv A2 ccos) (cfv B2 ccos)) (wceq (cfv A2 csin) (cfv B2 csin)))) $;

--| Addition formula for sine. Equation 14 of [Gleason] p. 310. (Contributed by Steve Rodriguez, 10-Nov-2006.) (Revised by Mario Carneiro, 30-Apr-2014.)
theorem sinadd (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (cfv (co A2 B2 caddc) csin) (co (co (cfv A2 csin) (cfv B2 ccos) cmul) (co (cfv A2 ccos) (cfv B2 csin) cmul) caddc)) $;

--| Addition formula for cosine. Equation 15 of [Gleason] p. 310. (Contributed by NM, 15-Jan-2006.) (Revised by Mario Carneiro, 30-Apr-2014.)
theorem cosadd (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (cfv (co A2 B2 caddc) ccos) (co (co (cfv A2 ccos) (cfv B2 ccos) cmul) (co (cfv A2 csin) (cfv B2 csin) cmul) cmin)) $;

--| A useful intermediate step in ~ tanadd when showing that the addition of tangents is well-defined. (Contributed by Mario Carneiro, 4-Apr-2015.)
theorem tanaddlem (A2 B2: class):
  $ wi (wa (wa (wcel A2 cc) (wcel B2 cc)) (wa (wne (cfv A2 ccos) cc0) (wne (cfv B2 ccos) cc0))) (wb (wne (cfv (co A2 B2 caddc) ccos) cc0) (wne (co (cfv A2 ctan) (cfv B2 ctan) cmul) c1)) $;

--| Addition formula for tangent. (Contributed by Mario Carneiro, 4-Apr-2015.)
theorem tanadd (A2 B2: class):
  $ wi (wa (wa (wcel A2 cc) (wcel B2 cc)) (w3a (wne (cfv A2 ccos) cc0) (wne (cfv B2 ccos) cc0) (wne (cfv (co A2 B2 caddc) ccos) cc0))) (wceq (cfv (co A2 B2 caddc) ctan) (co (co (cfv A2 ctan) (cfv B2 ctan) caddc) (co c1 (co (cfv A2 ctan) (cfv B2 ctan) cmul) cmin) cdiv)) $;

--| Sine of difference. (Contributed by Paul Chapman, 12-Oct-2007.)
theorem sinsub (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (cfv (co A2 B2 cmin) csin) (co (co (cfv A2 csin) (cfv B2 ccos) cmul) (co (cfv A2 ccos) (cfv B2 csin) cmul) cmin)) $;

--| Cosine of difference. (Contributed by Paul Chapman, 12-Oct-2007.)
theorem cossub (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (cfv (co A2 B2 cmin) ccos) (co (co (cfv A2 ccos) (cfv B2 ccos) cmul) (co (cfv A2 csin) (cfv B2 csin) cmul) caddc)) $;

--| Sum of sines. (Contributed by Paul Chapman, 12-Oct-2007.)
theorem addsin (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co (cfv A2 csin) (cfv B2 csin) caddc) (co c2 (co (cfv (co (co A2 B2 caddc) c2 cdiv) csin) (cfv (co (co A2 B2 cmin) c2 cdiv) ccos) cmul) cmul)) $;

--| Difference of sines. (Contributed by Paul Chapman, 12-Oct-2007.)
theorem subsin (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co (cfv A2 csin) (cfv B2 csin) cmin) (co c2 (co (cfv (co (co A2 B2 caddc) c2 cdiv) ccos) (cfv (co (co A2 B2 cmin) c2 cdiv) csin) cmul) cmul)) $;

--| Product of sines can be rewritten as half the difference of certain cosines. This follows from ~ cosadd and ~ cossub . (Contributed by David A. Wheeler, 26-May-2015.)
theorem sinmul (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co (cfv A2 csin) (cfv B2 csin) cmul) (co (co (cfv (co A2 B2 cmin) ccos) (cfv (co A2 B2 caddc) ccos) cmin) c2 cdiv)) $;

--| Product of cosines can be rewritten as half the sum of certain cosines. This follows from ~ cosadd and ~ cossub . (Contributed by David A. Wheeler, 26-May-2015.)
theorem cosmul (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co (cfv A2 ccos) (cfv B2 ccos) cmul) (co (co (cfv (co A2 B2 cmin) ccos) (cfv (co A2 B2 caddc) ccos) caddc) c2 cdiv)) $;

--| Sum of cosines. (Contributed by Paul Chapman, 12-Oct-2007.)
theorem addcos (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co (cfv A2 ccos) (cfv B2 ccos) caddc) (co c2 (co (cfv (co (co A2 B2 caddc) c2 cdiv) ccos) (cfv (co (co A2 B2 cmin) c2 cdiv) ccos) cmul) cmul)) $;

--| Difference of cosines. (Contributed by Paul Chapman, 12-Oct-2007.) (Revised by Mario Carneiro, 10-May-2014.)
theorem subcos (A2 B2: class):
  $ wi (wa (wcel A2 cc) (wcel B2 cc)) (wceq (co (cfv B2 ccos) (cfv A2 ccos) cmin) (co c2 (co (cfv (co (co A2 B2 caddc) c2 cdiv) csin) (cfv (co (co A2 B2 cmin) c2 cdiv) csin) cmul) cmul)) $;

--| Sine squared plus cosine squared is 1. Equation 17 of [Gleason] p. 311. Note that this holds for non-real arguments, even though individually each term is unbounded. (Contributed by NM, 15-Jan-2006.)
theorem sincossq (A2: class):
  $ wi (wcel A2 cc) (wceq (co (co (cfv A2 csin) c2 cexp) (co (cfv A2 ccos) c2 cexp) caddc) c1) $;

--| Double-angle formula for sine. (Contributed by Paul Chapman, 17-Jan-2008.)
theorem sin2t (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv (co c2 A2 cmul) csin) (co c2 (co (cfv A2 csin) (cfv A2 ccos) cmul) cmul)) $;

--| Double-angle formula for cosine. (Contributed by Paul Chapman, 24-Jan-2008.)
theorem cos2t (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv (co c2 A2 cmul) ccos) (co (co c2 (co (cfv A2 ccos) c2 cexp) cmul) c1 cmin)) $;

--| Double-angle formula for cosine in terms of sine. (Contributed by NM, 12-Sep-2008.)
theorem cos2tsin (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv (co c2 A2 cmul) ccos) (co c1 (co c2 (co (cfv A2 csin) c2 cexp) cmul) cmin)) $;

--| The sine of a real number lies between -1 and 1. Equation 18 of [Gleason] p. 311. (Contributed by NM, 16-Jan-2006.)
theorem sinbnd (A2: class):
  $ wi (wcel A2 cr) (wa (wbr (cneg c1) (cfv A2 csin) cle) (wbr (cfv A2 csin) c1 cle)) $;

--| The cosine of a real number lies between -1 and 1. Equation 18 of [Gleason] p. 311. (Contributed by NM, 16-Jan-2006.)
theorem cosbnd (A2: class):
  $ wi (wcel A2 cr) (wa (wbr (cneg c1) (cfv A2 ccos) cle) (wbr (cfv A2 ccos) c1 cle)) $;

--| The sine of a real number is in the closed interval from -1 to 1. (Contributed by Mario Carneiro, 12-May-2014.)
theorem sinbnd2 (A2: class):
  $ wi (wcel A2 cr) (wcel (cfv A2 csin) (co (cneg c1) c1 cicc)) $;

--| The cosine of a real number is in the closed interval from -1 to 1. (Contributed by Mario Carneiro, 12-May-2014.)
theorem cosbnd2 (A2: class):
  $ wi (wcel A2 cr) (wcel (cfv A2 ccos) (co (cneg c1) c1 cicc)) $;

--| Lemma for ~ sin01bnd and ~ cos01bnd . (Contributed by Paul Chapman, 19-Jan-2008.)
theorem ef01bndlem {k n: setvar} (A2: class) (F: class n):
  $ wceq F (cmpt n cn0 (co (co (co ci A2 cmul) (cv n) cexp) (cfv (cv n) cfa) cdiv)) $ >
  $ wi (wcel A2 (co cc0 c1 cioc)) (wbr (cfv (csu k (cfv c4 cuz) (cfv (cv k) F)) cabs) (co (co A2 c4 cexp) c6 cdiv) clt) $;

--| Bounds on the sine of a positive real number less than or equal to 1. (Contributed by Paul Chapman, 19-Jan-2008.) (Revised by Mario Carneiro, 30-Apr-2014.)
theorem sin01bnd (A2: class):
  $ wi (wcel A2 (co cc0 c1 cioc)) (wa (wbr (co A2 (co (co A2 c3 cexp) c3 cdiv) cmin) (cfv A2 csin) clt) (wbr (cfv A2 csin) A2 clt)) $;

--| Bounds on the cosine of a positive real number less than or equal to 1. (Contributed by Paul Chapman, 19-Jan-2008.) (Revised by Mario Carneiro, 30-Apr-2014.)
theorem cos01bnd (A2: class):
  $ wi (wcel A2 (co cc0 c1 cioc)) (wa (wbr (co c1 (co c2 (co (co A2 c2 cexp) c3 cdiv) cmul) cmin) (cfv A2 ccos) clt) (wbr (cfv A2 ccos) (co c1 (co (co A2 c2 cexp) c3 cdiv) cmin) clt)) $;

--| Bounds on the cosine of 1. (Contributed by Paul Chapman, 19-Jan-2008.)
theorem cos1bnd:
  $ wa (wbr (co c1 c3 cdiv) (cfv c1 ccos) clt) (wbr (cfv c1 ccos) (co c2 c3 cdiv) clt) $;

--| Bounds on the cosine of 2. (Contributed by Paul Chapman, 19-Jan-2008.)
theorem cos2bnd:
  $ wa (wbr (cneg (co c7 c9 cdiv)) (cfv c2 ccos) clt) (wbr (cfv c2 ccos) (cneg (co c1 c9 cdiv)) clt) $;

--| The sine of a positive real number is less than its argument. (Contributed by Mario Carneiro, 29-Jul-2014.)
theorem sinltx (A2: class):
  $ wi (wcel A2 crp) (wbr (cfv A2 csin) A2 clt) $;

--| The sine of a positive real number less than or equal to 1 is positive. (Contributed by Paul Chapman, 19-Jan-2008.) (Revised by Wolf Lammen, 25-Sep-2020.)
theorem sin01gt0 (A2: class):
  $ wi (wcel A2 (co cc0 c1 cioc)) (wbr cc0 (cfv A2 csin) clt) $;

--| The cosine of a positive real number less than or equal to 1 is positive. (Contributed by Paul Chapman, 19-Jan-2008.)
theorem cos01gt0 (A2: class):
  $ wi (wcel A2 (co cc0 c1 cioc)) (wbr cc0 (cfv A2 ccos) clt) $;

--| The sine of a positive real number less than or equal to 2 is positive. (Contributed by Paul Chapman, 19-Jan-2008.)
theorem sin02gt0 (A2: class):
  $ wi (wcel A2 (co cc0 c2 cioc)) (wbr cc0 (cfv A2 csin) clt) $;

--| The signs of the sine and cosine of 1. (Contributed by Paul Chapman, 19-Jan-2008.)
theorem sincos1sgn:
  $ wa (wbr cc0 (cfv c1 csin) clt) (wbr cc0 (cfv c1 ccos) clt) $;

--| The signs of the sine and cosine of 2. (Contributed by Paul Chapman, 19-Jan-2008.)
theorem sincos2sgn:
  $ wa (wbr cc0 (cfv c2 csin) clt) (wbr (cfv c2 ccos) cc0 clt) $;

--| The sine of 4 is negative. (Contributed by Paul Chapman, 19-Jan-2008.)
theorem sin4lt0:
  $ wbr (cfv c4 csin) cc0 clt $;

--| The absolute value of the exponential of an imaginary number is one. Equation 48 of [Rudin] p. 167. (Contributed by Jason Orendorff, 9-Feb-2007.)
theorem absefi (A2: class):
  $ wi (wcel A2 cr) (wceq (cfv (cfv (co ci A2 cmul) ce) cabs) c1) $;

--| The absolute value of the exponential is the exponential of the real part. (Contributed by Paul Chapman, 13-Sep-2007.)
theorem absef (A2: class):
  $ wi (wcel A2 cc) (wceq (cfv (cfv A2 ce) cabs) (cfv (cfv A2 cre) ce)) $;

--| A complex number is real iff the exponential of its product with ` _i ` has absolute value one. (Contributed by NM, 21-Aug-2008.)
theorem absefib (A2: class):
  $ wi (wcel A2 cc) (wb (wcel A2 cr) (wceq (cfv (cfv (co ci A2 cmul) ce) cabs) c1)) $;

--| A number whose imaginary exponential is one is real. (Contributed by NM, 21-Aug-2008.)
theorem efieq1re (A2: class):
  $ wi (wa (wcel A2 cc) (wceq (cfv (co ci A2 cmul) ce) c1)) (wcel A2 cr) $;

--| De Moivre's Formula. Proof by induction given at ~ http://en.wikipedia.org/wiki/De&#x5F;Moivre&#x27;s&#x5F;formula , but restricted to nonnegative integer powers. See also ~ demoivreALT for an alternate longer proof not using the exponential function. (Contributed by NM, 24-Jul-2007.)
theorem demoivre (A2 N: class):
  $ wi (wa (wcel A2 cc) (wcel N cz)) (wceq (co (co (cfv A2 ccos) (co ci (cfv A2 csin) cmul) caddc) N cexp) (co (cfv (co N A2 cmul) ccos) (co ci (cfv (co N A2 cmul) csin) cmul) caddc)) $;

--| Alternate proof of ~ demoivre . It is longer but does not use the exponential function. This is Metamath 100 proof #17. (Contributed by Steve Rodriguez, 10-Nov-2006.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem demoivreALT (A2 N: class):
  $ wi (wa (wcel A2 cc) (wcel N cn0)) (wceq (co (co (cfv A2 ccos) (co ci (cfv A2 csin) cmul) caddc) N cexp) (co (cfv (co N A2 cmul) ccos) (co ci (cfv (co N A2 cmul) csin) cmul) caddc)) $;

--| Extend class notation to include the constant tau, ` _tau ` = 6.28318....
term ctau: class;

--| Define the circle constant tau, ` _tau ` = 6.28318..., which is the smallest positive real number whose cosine is one. Various notations have been used or proposed for this number including ` _tau ` , a three-legged variant of ` _pi ` , or ` 2 _pi ` . Note the difference between this constant ` _tau ` and the formula variable ` ta ` . Following our convention, the constant is displayed in upright font while the variable is in italic font; furthermore, the colors are different. (Contributed by Jim Kingdon, 9-Apr-2018.) (Revised by AV, 1-Oct-2020.)
axiom df_tau:
  $ wceq ctau (cinf (cin crp (cima (ccnv ccos) (csn c1))) cr clt) $;

--| Lemma for ~ eirr . (Contributed by Paul Chapman, 9-Feb-2008.) (Revised by Mario Carneiro, 29-Apr-2014.)
theorem eirrlem {n: setvar} (ph: wff n) (P: class n) (Q: class) (F: class n):
  $ wceq F (cmpt n cn0 (co c1 (cfv (cv n) cfa) cdiv)) $ >
  $ wi ph (wcel P cz) $ >
  $ wi ph (wcel Q cn) $ >
  $ wi ph (wceq ceu (co P Q cdiv)) $ >
  $ wn ph $;

--| ` _e ` is irrational. (Contributed by Paul Chapman, 9-Feb-2008.) (Proof shortened by Mario Carneiro, 29-Apr-2014.)
theorem eirr:
  $ wnel ceu cq $;

--| Euler's constant ` _e ` = 2.71828... is strictly bounded below by 2 and above by 3. (Contributed by NM, 28-Nov-2008.) (Revised by Mario Carneiro, 29-Apr-2014.)
theorem egt2lt3:
  $ wa (wbr c2 ceu clt) (wbr ceu c3 clt) $;

--| Euler's constant ` _e ` is greater than 0. (Contributed by Jeff Hankins, 22-Nov-2008.)
theorem epos:
  $ wbr cc0 ceu clt $;

--| Euler's constant ` _e ` is a positive real. (Contributed by Jeff Hankins, 22-Nov-2008.)
theorem epr:
  $ wcel ceu crp $;

--| ` _e ` is not 0. (Contributed by David A. Wheeler, 17-Oct-2017.)
theorem ene0:
  $ wne ceu cc0 $;

--| ` _e ` is not 1. (Contributed by David A. Wheeler, 17-Oct-2017.)
theorem ene1:
  $ wne ceu c1 $;

--| The Cartesian product of the set of positive integers with itself is equinumerous to the set of positive integers. (Contributed by NM, 1-Aug-2004.) (Revised by Mario Carneiro, 9-Mar-2013.)
theorem xpnnen:
  $ wbr (cxp cn cn) cn cen $;

--| The set of integers and the set of positive integers are equinumerous. Exercise 1 of [Gleason] p. 140. (Contributed by NM, 31-Jul-2004.) (Proof shortened by Mario Carneiro, 13-Jun-2014.)
theorem znnen:
  $ wbr cz cn cen $;

--| The rational numbers are countable. This proof does not use the Axiom of Choice, even though it uses an onto function, because the base set ` ( ZZ X. NN ) ` is numerable. Exercise 2 of [Enderton] p. 133. For purposes of the Metamath 100 list, we are considering Mario Carneiro's revision as the date this proof was completed. This is Metamath 100 proof #3. (Contributed by NM, 31-Jul-2004.) (Revised by Mario Carneiro, 3-Mar-2013.)
theorem qnnen:
  $ wbr cq cn cen $;

--| Lemma for ~ rpnnen2 . (Contributed by Mario Carneiro, 13-May-2013.)
theorem rpnnen2lem1 {x3 n: setvar} (A2: class) (F: class x3 n) (N: class x3):
  $ wceq F (cmpt x3 (cpw cn) (cmpt n cn (cif (wcel (cv n) (cv x3)) (co (co c1 c3 cdiv) (cv n) cexp) cc0))) $ >
  $ wi (wa (wss A2 cn) (wcel N cn)) (wceq (cfv N (cfv A2 F)) (cif (wcel N A2) (co (co c1 c3 cdiv) N cexp) cc0)) $;

--| Lemma for ~ rpnnen2 . (Contributed by Mario Carneiro, 13-May-2013.) (Revised by Mario Carneiro, 23-Aug-2014.)
theorem rpnnen2lem2 {x3 n: setvar} (A2: class) (F: class x3 n):
  $ wceq F (cmpt x3 (cpw cn) (cmpt n cn (cif (wcel (cv n) (cv x3)) (co (co c1 c3 cdiv) (cv n) cexp) cc0))) $ >
  $ wi (wss A2 cn) (wf cn cr (cfv A2 F)) $;

--| Lemma for ~ rpnnen2 . (Contributed by Mario Carneiro, 13-May-2013.)
theorem rpnnen2lem3 {x3 n: setvar} (F: class x3 n):
  $ wceq F (cmpt x3 (cpw cn) (cmpt n cn (cif (wcel (cv n) (cv x3)) (co (co c1 c3 cdiv) (cv n) cexp) cc0))) $ >
  $ wbr (cseq caddc (cfv cn F) c1) (co c1 c2 cdiv) cli $;

--| Lemma for ~ rpnnen2 . (Contributed by Mario Carneiro, 13-May-2013.) (Revised by Mario Carneiro, 31-Aug-2014.)
theorem rpnnen2lem4 {x3 n: setvar} (A2 B2: class) (k: setvar) (F: class x3 n):
  $ wceq F (cmpt x3 (cpw cn) (cmpt n cn (cif (wcel (cv n) (cv x3)) (co (co c1 c3 cdiv) (cv n) cexp) cc0))) $ >
  $ wi (w3a (wss A2 B2) (wss B2 cn) (wcel (cv k) cn)) (wa (wbr cc0 (cfv (cv k) (cfv A2 F)) cle) (wbr (cfv (cv k) (cfv A2 F)) (cfv (cv k) (cfv B2 F)) cle)) $;

--| Lemma for ~ rpnnen2 . (Contributed by Mario Carneiro, 13-May-2013.) (Revised by Mario Carneiro, 30-Apr-2014.)
theorem rpnnen2lem5 {x3 n: setvar} (A2: class) (F: class x3 n) (M: class):
  $ wceq F (cmpt x3 (cpw cn) (cmpt n cn (cif (wcel (cv n) (cv x3)) (co (co c1 c3 cdiv) (cv n) cexp) cc0))) $ >
  $ wi (wa (wss A2 cn) (wcel M cn)) (wcel (cseq caddc (cfv A2 F) M) (cdm cli)) $;

--| Lemma for ~ rpnnen2 . (Contributed by Mario Carneiro, 13-May-2013.) (Revised by Mario Carneiro, 30-Apr-2014.)
theorem rpnnen2lem6 {x3 k n: setvar} (A2: class) (F: class x3 n) (M: class):
  $ wceq F (cmpt x3 (cpw cn) (cmpt n cn (cif (wcel (cv n) (cv x3)) (co (co c1 c3 cdiv) (cv n) cexp) cc0))) $ >
  $ wi (wa (wss A2 cn) (wcel M cn)) (wcel (csu k (cfv M cuz) (cfv (cv k) (cfv A2 F))) cr) $;

--| Lemma for ~ rpnnen2 . (Contributed by Mario Carneiro, 13-May-2013.) (Revised by Mario Carneiro, 30-Apr-2014.)
theorem rpnnen2lem7 {x3 k n: setvar} (A2 B2: class) (F: class x3 n) (M: class):
  $ wceq F (cmpt x3 (cpw cn) (cmpt n cn (cif (wcel (cv n) (cv x3)) (co (co c1 c3 cdiv) (cv n) cexp) cc0))) $ >
  $ wi (w3a (wss A2 B2) (wss B2 cn) (wcel M cn)) (wbr (csu k (cfv M cuz) (cfv (cv k) (cfv A2 F))) (csu k (cfv M cuz) (cfv (cv k) (cfv B2 F))) cle) $;

--| Lemma for ~ rpnnen2 . (Contributed by Mario Carneiro, 13-May-2013.) (Revised by Mario Carneiro, 30-Apr-2014.)
theorem rpnnen2lem8 {x3 k n: setvar} (A2: class) (F: class x3 n) (M: class):
  $ wceq F (cmpt x3 (cpw cn) (cmpt n cn (cif (wcel (cv n) (cv x3)) (co (co c1 c3 cdiv) (cv n) cexp) cc0))) $ >
  $ wi (wa (wss A2 cn) (wcel M cn)) (wceq (csu k cn (cfv (cv k) (cfv A2 F))) (co (csu k (co c1 (co M c1 cmin) cfz) (cfv (cv k) (cfv A2 F))) (csu k (cfv M cuz) (cfv (cv k) (cfv A2 F))) caddc)) $;

--| Lemma for ~ rpnnen2 . (Contributed by Mario Carneiro, 13-May-2013.) (Revised by Mario Carneiro, 30-Apr-2014.)
theorem rpnnen2lem9 {x3 k n: setvar} (F: class x3 n) (M: class):
  $ wceq F (cmpt x3 (cpw cn) (cmpt n cn (cif (wcel (cv n) (cv x3)) (co (co c1 c3 cdiv) (cv n) cexp) cc0))) $ >
  $ wi (wcel M cn) (wceq (csu k (cfv M cuz) (cfv (cv k) (cfv (cdif cn (csn M)) F))) (co cc0 (co (co (co c1 c3 cdiv) (co M c1 caddc) cexp) (co c1 (co c1 c3 cdiv) cmin) cdiv) caddc)) $;

--| Lemma for ~ rpnnen2 . (Contributed by Mario Carneiro, 13-May-2013.) (Revised by Mario Carneiro, 30-Apr-2014.)
theorem rpnnen2lem10 {x3 k m n: setvar} (ph: wff x3 m n) (ps: wff x3 k m n) (A2 B2: class m) (F: class x3 n):
  $ wceq F (cmpt x3 (cpw cn) (cmpt n cn (cif (wcel (cv n) (cv x3)) (co (co c1 c3 cdiv) (cv n) cexp) cc0))) $ >
  $ wi ph (wss A2 cn) $ >
  $ wi ph (wss B2 cn) $ >
  $ wi ph (wcel (cv m) (cdif A2 B2)) $ >
  $ wi ph (wral n (wi (wbr (cv n) (cv m) clt) (wb (wcel (cv n) A2) (wcel (cv n) B2))) cn) $ >
  $ wb ps (wceq (csu k cn (cfv (cv k) (cfv A2 F))) (csu k cn (cfv (cv k) (cfv B2 F)))) $ >
  $ wi (wa ph ps) (wceq (csu k (cfv (cv m) cuz) (cfv (cv k) (cfv A2 F))) (csu k (cfv (cv m) cuz) (cfv (cv k) (cfv B2 F)))) $;

--| Lemma for ~ rpnnen2 . (Contributed by Mario Carneiro, 13-May-2013.)
theorem rpnnen2lem11 {x3 k m n: setvar} (ph: wff x3 m n) (ps: wff x3 k m n) (A2 B2: class m) (F: class x3 n):
  $ wceq F (cmpt x3 (cpw cn) (cmpt n cn (cif (wcel (cv n) (cv x3)) (co (co c1 c3 cdiv) (cv n) cexp) cc0))) $ >
  $ wi ph (wss A2 cn) $ >
  $ wi ph (wss B2 cn) $ >
  $ wi ph (wcel (cv m) (cdif A2 B2)) $ >
  $ wi ph (wral n (wi (wbr (cv n) (cv m) clt) (wb (wcel (cv n) A2) (wcel (cv n) B2))) cn) $ >
  $ wb ps (wceq (csu k cn (cfv (cv k) (cfv A2 F))) (csu k cn (cfv (cv k) (cfv B2 F)))) $ >
  $ wi ph (wn ps) $;

--| Lemma for ~ rpnnen2 . (Contributed by Mario Carneiro, 13-May-2013.)
theorem rpnnen2lem12 {x3 n: setvar} (F: class x3 n):
  $ wceq F (cmpt x3 (cpw cn) (cmpt n cn (cif (wcel (cv n) (cv x3)) (co (co c1 c3 cdiv) (cv n) cexp) cc0))) $ >
  $ wbr (cpw cn) (co cc0 c1 cicc) cdom $;

--| The other half of ~ rpnnen , where we show an injection from sets of positive integers to real numbers. The obvious choice for this is binary expansion, but it has the unfortunate property that it does not produce an injection on numbers which end with all 0's or all 1's (the more well-known decimal version of this is ~ 0.999... ). Instead, we opt for a ternary expansion, which produces (a scaled version of) the Cantor set. Since the Cantor set is riddled with gaps, we can show that any two sequences that are not equal must differ somewhere, and when they do, they are placed a finite distance apart, thus ensuring that the map is injective. Our map assigns to each subset ` A ` of the positive integers the number ` sum_ k e. A ( 3 ^ -u k ) = sum_ k e. NN ( ( F `` A ) `` k ) ` , where ` ( ( F `` A ) `` k ) = if ( k e. A , ( 3 ^ -u k ) , 0 ) ) ` ( ~ rpnnen2lem1 ). This is an infinite sum of real numbers ( ~ rpnnen2lem2 ), and since ` A C_ B ` implies ` ( F `` A ) <_ ( F `` B ) ` ( ~ rpnnen2lem4 ) and ` ( F `` NN ) ` converges to ` 1 / 2 ` ( ~ rpnnen2lem3 ) by ~ geoisum1 , the sum is convergent to some real ( ~ rpnnen2lem5 and ~ rpnnen2lem6 ) by the comparison test for convergence ~ cvgcmp . The comparison test also tells us that ` A C_ B ` implies ` sum_ ( F `` A ) <_ sum_ ( F `` B ) ` ( ~ rpnnen2lem7 ). Putting it all together, if we have two sets ` x =/= y ` , there must differ somewhere, and so there must be an ` m ` such that ` A. n < m ( n e. x <-> n e. y ) ` but ` m e. ( x \ y ) ` or vice versa. In this case, we split off the first ` m - 1 ` terms ( ~ rpnnen2lem8 ) and cancel them ( ~ rpnnen2lem10 ), since these are the same for both sets. For the remaining terms, we use the subset property to establish that ` sum_ ( F `` y ) <_ sum_ ( F `` ( NN \ { m } ) ) ` and ` sum_ ( F `` { m } ) <_ sum_ ( F `` x ) ` (where these sums are only over ` ( ZZ>= `` m ) ` ), and since ` sum_ ( F `` ( NN \ { m } ) ) = ( 3 ^ -u m ) / 2 ` ( ~ rpnnen2lem9 ) and ` sum_ ( F `` { m } ) = ( 3 ^ -u m ) ` , we establish that ` sum_ ( F `` y ) < sum_ ( F `` x ) ` ( ~ rpnnen2lem11 ) so that they must be different. By contraposition ( ~ rpnnen2lem12 ), we find that this map is an injection. (Contributed by Mario Carneiro, 13-May-2013.) (Proof shortened by Mario Carneiro, 30-Apr-2014.) (Revised by NM, 17-Aug-2021.)
theorem rpnnen2:
  $ wbr (cpw cn) (co cc0 c1 cicc) cdom $;

--| The cardinality of the continuum is the same as the powerset of ` _om ` . This is a stronger statement than ~ ruc , which only asserts that ` RR ` is uncountable, i.e. has a cardinality larger than ` _om ` . The main proof is in two parts, ~ rpnnen1 and ~ rpnnen2 , each showing an injection in one direction, and this last part uses ~ sbth to prove that the sets are equinumerous. By constructing explicit injections, we avoid the use of AC. (Contributed by Mario Carneiro, 13-May-2013.) (Revised by Mario Carneiro, 23-Aug-2014.)
theorem rpnnen:
  $ wbr cr (cpw cn) cen $;

--| The real numbers are equinumerous to their own Cartesian product, even though it is not necessarily true that ` RR ` is well-orderable (so we cannot use ~ infxpidm2 directly). (Contributed by NM, 30-Jul-2004.) (Revised by Mario Carneiro, 16-Jun-2013.)
theorem rexpen:
  $ wbr (cxp cr cr) cr cen $;

--| The complex numbers are equinumerous to the powerset of the positive integers. (Contributed by Mario Carneiro, 16-Jun-2013.)
theorem cpnnen:
  $ wbr cc (cpw cn) cen $;

--| Alternate proof of ~ ruc . This proof is a simple corollary of ~ rpnnen , which determines the exact cardinality of the reals. For an alternate proof discussed at ~ mmcomplex.html#uncountable , see ~ ruc . (Contributed by NM, 13-Oct-2004.) (Revised by Mario Carneiro, 13-May-2013.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem rucALT:
  $ wbr cn cr csdm $;

--| Lemma for ~ ruc (the reals are uncountable). Substitutions for the function ` D ` . (Contributed by Mario Carneiro, 28-May-2014.) (Revised by Fan Zheng, 6-Jun-2016.)
theorem ruclem1 {x3 y1 m: setvar} (ph: wff x3 y1 m) (A2 B2: class) (D: class x3 y1 m) (F M: class) (X Y: class x3 y1 m):
  $ wi ph (wf cn cr F) $ >
  $ wi ph (wceq D (cmpo x3 y1 (cxp cr cr) cr (csb m (co (co (cfv (cv x3) c1st) (cfv (cv x3) c2nd) caddc) c2 cdiv) (cif (wbr (cv m) (cv y1) clt) (cop (cfv (cv x3) c1st) (cv m)) (cop (co (co (cv m) (cfv (cv x3) c2nd) caddc) c2 cdiv) (cfv (cv x3) c2nd)))))) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel M cr) $ >
  $ wceq X (cfv (co (cop A2 B2) M D) c1st) $ >
  $ wceq Y (cfv (co (cop A2 B2) M D) c2nd) $ >
  $ wi ph (w3a (wcel (co (cop A2 B2) M D) (cxp cr cr)) (wceq X (cif (wbr (co (co A2 B2 caddc) c2 cdiv) M clt) A2 (co (co (co (co A2 B2 caddc) c2 cdiv) B2 caddc) c2 cdiv))) (wceq Y (cif (wbr (co (co A2 B2 caddc) c2 cdiv) M clt) (co (co A2 B2 caddc) c2 cdiv) B2))) $;

--| Lemma for ~ ruc . Ordering property for the input to ` D ` . (Contributed by Mario Carneiro, 28-May-2014.)
theorem ruclem2 {x3 y1 m: setvar} (ph: wff x3 y1 m) (A2 B2: class) (D: class x3 y1 m) (F M: class) (X Y: class x3 y1 m):
  $ wi ph (wf cn cr F) $ >
  $ wi ph (wceq D (cmpo x3 y1 (cxp cr cr) cr (csb m (co (co (cfv (cv x3) c1st) (cfv (cv x3) c2nd) caddc) c2 cdiv) (cif (wbr (cv m) (cv y1) clt) (cop (cfv (cv x3) c1st) (cv m)) (cop (co (co (cv m) (cfv (cv x3) c2nd) caddc) c2 cdiv) (cfv (cv x3) c2nd)))))) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel M cr) $ >
  $ wceq X (cfv (co (cop A2 B2) M D) c1st) $ >
  $ wceq Y (cfv (co (cop A2 B2) M D) c2nd) $ >
  $ wi ph (wbr A2 B2 clt) $ >
  $ wi ph (w3a (wbr A2 X cle) (wbr X Y clt) (wbr Y B2 cle)) $;

--| Lemma for ~ ruc . The constructed interval ` [ X , Y ] ` always excludes ` M ` . (Contributed by Mario Carneiro, 28-May-2014.)
theorem ruclem3 {x3 y1 m: setvar} (ph: wff x3 y1 m) (A2 B2: class) (D: class x3 y1 m) (F M: class) (X Y: class x3 y1 m):
  $ wi ph (wf cn cr F) $ >
  $ wi ph (wceq D (cmpo x3 y1 (cxp cr cr) cr (csb m (co (co (cfv (cv x3) c1st) (cfv (cv x3) c2nd) caddc) c2 cdiv) (cif (wbr (cv m) (cv y1) clt) (cop (cfv (cv x3) c1st) (cv m)) (cop (co (co (cv m) (cfv (cv x3) c2nd) caddc) c2 cdiv) (cfv (cv x3) c2nd)))))) $ >
  $ wi ph (wcel A2 cr) $ >
  $ wi ph (wcel B2 cr) $ >
  $ wi ph (wcel M cr) $ >
  $ wceq X (cfv (co (cop A2 B2) M D) c1st) $ >
  $ wceq Y (cfv (co (cop A2 B2) M D) c2nd) $ >
  $ wi ph (wbr A2 B2 clt) $ >
  $ wi ph (wo (wbr M X clt) (wbr Y M clt)) $;

--| Lemma for ~ ruc . Initial value of the interval sequence. (Contributed by Mario Carneiro, 28-May-2014.)
theorem ruclem4 {x3 y1 m: setvar} (ph: wff x3 y1 m) (C D: class x3 y1 m) (F G: class):
  $ wi ph (wf cn cr F) $ >
  $ wi ph (wceq D (cmpo x3 y1 (cxp cr cr) cr (csb m (co (co (cfv (cv x3) c1st) (cfv (cv x3) c2nd) caddc) c2 cdiv) (cif (wbr (cv m) (cv y1) clt) (cop (cfv (cv x3) c1st) (cv m)) (cop (co (co (cv m) (cfv (cv x3) c2nd) caddc) c2 cdiv) (cfv (cv x3) c2nd)))))) $ >
  $ wceq C (cun (csn (cop cc0 (cop cc0 c1))) F) $ >
  $ wceq G (cseq D C cc0) $ >
  $ wi ph (wceq (cfv cc0 G) (cop cc0 c1)) $;

--| Lemma for ~ ruc . Domain and codomain of the interval sequence. (Contributed by Mario Carneiro, 28-May-2014.)
theorem ruclem6 {x3 y1 m: setvar} (ph: wff x3 y1 m) (C D: class x3 y1 m) (F G: class):
  $ wi ph (wf cn cr F) $ >
  $ wi ph (wceq D (cmpo x3 y1 (cxp cr cr) cr (csb m (co (co (cfv (cv x3) c1st) (cfv (cv x3) c2nd) caddc) c2 cdiv) (cif (wbr (cv m) (cv y1) clt) (cop (cfv (cv x3) c1st) (cv m)) (cop (co (co (cv m) (cfv (cv x3) c2nd) caddc) c2 cdiv) (cfv (cv x3) c2nd)))))) $ >
  $ wceq C (cun (csn (cop cc0 (cop cc0 c1))) F) $ >
  $ wceq G (cseq D C cc0) $ >
  $ wi ph (wf cn0 (cxp cr cr) G) $;

--| Lemma for ~ ruc . Successor value for the interval sequence. (Contributed by Mario Carneiro, 28-May-2014.)
theorem ruclem7 {x3 y1 m: setvar} (ph: wff x3 y1 m) (C D: class x3 y1 m) (F G N: class):
  $ wi ph (wf cn cr F) $ >
  $ wi ph (wceq D (cmpo x3 y1 (cxp cr cr) cr (csb m (co (co (cfv (cv x3) c1st) (cfv (cv x3) c2nd) caddc) c2 cdiv) (cif (wbr (cv m) (cv y1) clt) (cop (cfv (cv x3) c1st) (cv m)) (cop (co (co (cv m) (cfv (cv x3) c2nd) caddc) c2 cdiv) (cfv (cv x3) c2nd)))))) $ >
  $ wceq C (cun (csn (cop cc0 (cop cc0 c1))) F) $ >
  $ wceq G (cseq D C cc0) $ >
  $ wi (wa ph (wcel N cn0)) (wceq (cfv (co N c1 caddc) G) (co (cfv N G) (cfv (co N c1 caddc) F) D)) $;

--| Lemma for ~ ruc . The intervals of the ` G ` sequence are all nonempty. (Contributed by Mario Carneiro, 28-May-2014.)
theorem ruclem8 {x3 y1 m: setvar} (ph: wff x3 y1 m) (C D: class x3 y1 m) (F G N: class):
  $ wi ph (wf cn cr F) $ >
  $ wi ph (wceq D (cmpo x3 y1 (cxp cr cr) cr (csb m (co (co (cfv (cv x3) c1st) (cfv (cv x3) c2nd) caddc) c2 cdiv) (cif (wbr (cv m) (cv y1) clt) (cop (cfv (cv x3) c1st) (cv m)) (cop (co (co (cv m) (cfv (cv x3) c2nd) caddc) c2 cdiv) (cfv (cv x3) c2nd)))))) $ >
  $ wceq C (cun (csn (cop cc0 (cop cc0 c1))) F) $ >
  $ wceq G (cseq D C cc0) $ >
  $ wi (wa ph (wcel N cn0)) (wbr (cfv (cfv N G) c1st) (cfv (cfv N G) c2nd) clt) $;

--| Lemma for ~ ruc . The first components of the ` G ` sequence are increasing, and the second components are decreasing. (Contributed by Mario Carneiro, 28-May-2014.)
theorem ruclem9 {x3 y1 m: setvar} (ph: wff x3 y1 m) (C D: class x3 y1 m) (F G M N: class):
  $ wi ph (wf cn cr F) $ >
  $ wi ph (wceq D (cmpo x3 y1 (cxp cr cr) cr (csb m (co (co (cfv (cv x3) c1st) (cfv (cv x3) c2nd) caddc) c2 cdiv) (cif (wbr (cv m) (cv y1) clt) (cop (cfv (cv x3) c1st) (cv m)) (cop (co (co (cv m) (cfv (cv x3) c2nd) caddc) c2 cdiv) (cfv (cv x3) c2nd)))))) $ >
  $ wceq C (cun (csn (cop cc0 (cop cc0 c1))) F) $ >
  $ wceq G (cseq D C cc0) $ >
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi ph (wa (wbr (cfv (cfv M G) c1st) (cfv (cfv N G) c1st) cle) (wbr (cfv (cfv N G) c2nd) (cfv (cfv M G) c2nd) cle)) $;

--| Lemma for ~ ruc . Every first component of the ` G ` sequence is less than every second component. That is, the sequences form a chain a_1 ` < ` a_2 ` < ` ... ` < ` b_2 ` < ` b_1, where a_i are the first components and b_i are the second components. (Contributed by Mario Carneiro, 28-May-2014.)
theorem ruclem10 {x3 y1 m: setvar} (ph: wff x3 y1 m) (C D: class x3 y1 m) (F G M N: class):
  $ wi ph (wf cn cr F) $ >
  $ wi ph (wceq D (cmpo x3 y1 (cxp cr cr) cr (csb m (co (co (cfv (cv x3) c1st) (cfv (cv x3) c2nd) caddc) c2 cdiv) (cif (wbr (cv m) (cv y1) clt) (cop (cfv (cv x3) c1st) (cv m)) (cop (co (co (cv m) (cfv (cv x3) c2nd) caddc) c2 cdiv) (cfv (cv x3) c2nd)))))) $ >
  $ wceq C (cun (csn (cop cc0 (cop cc0 c1))) F) $ >
  $ wceq G (cseq D C cc0) $ >
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wbr (cfv (cfv M G) c1st) (cfv (cfv N G) c2nd) clt) $;

--| Lemma for ~ ruc . Closure lemmas for supremum. (Contributed by Mario Carneiro, 28-May-2014.)
theorem ruclem11 {x3 y1 z m: setvar} (ph: wff x3 y1 m) (C D: class x3 y1 m) (F G: class):
  $ wi ph (wf cn cr F) $ >
  $ wi ph (wceq D (cmpo x3 y1 (cxp cr cr) cr (csb m (co (co (cfv (cv x3) c1st) (cfv (cv x3) c2nd) caddc) c2 cdiv) (cif (wbr (cv m) (cv y1) clt) (cop (cfv (cv x3) c1st) (cv m)) (cop (co (co (cv m) (cfv (cv x3) c2nd) caddc) c2 cdiv) (cfv (cv x3) c2nd)))))) $ >
  $ wceq C (cun (csn (cop cc0 (cop cc0 c1))) F) $ >
  $ wceq G (cseq D C cc0) $ >
  $ wi ph (w3a (wss (crn (ccom c1st G)) cr) (wne (crn (ccom c1st G)) c0) (wral z (wbr (cv z) c1 cle) (crn (ccom c1st G)))) $;

--| Lemma for ~ ruc . The supremum of the increasing sequence ` 1st o. G ` is a real number that is not in the range of ` F ` . (Contributed by Mario Carneiro, 28-May-2014.)
theorem ruclem12 {x3 y1 m: setvar} (ph: wff x3 y1 m) (C D S: class x3 y1 m) (F G: class):
  $ wi ph (wf cn cr F) $ >
  $ wi ph (wceq D (cmpo x3 y1 (cxp cr cr) cr (csb m (co (co (cfv (cv x3) c1st) (cfv (cv x3) c2nd) caddc) c2 cdiv) (cif (wbr (cv m) (cv y1) clt) (cop (cfv (cv x3) c1st) (cv m)) (cop (co (co (cv m) (cfv (cv x3) c2nd) caddc) c2 cdiv) (cfv (cv x3) c2nd)))))) $ >
  $ wceq C (cun (csn (cop cc0 (cop cc0 c1))) F) $ >
  $ wceq G (cseq D C cc0) $ >
  $ wceq S (csup (crn (ccom c1st G)) cr clt) $ >
  $ wi ph (wcel S (cdif cr (crn F))) $;

--| Lemma for ~ ruc . There is no function that maps ` NN ` onto ` RR ` . (Use ~ nex if you want this in the form ` -. E. f f : NN -onto-> RR ` .) (Contributed by NM, 14-Oct-2004.) (Proof shortened by Fan Zheng, 6-Jun-2016.)
theorem ruclem13 (F: class):
  $ wn (wfo cn cr F) $;

--| The set of positive integers is strictly dominated by the set of real numbers, i.e. the real numbers are uncountable. The proof consists of lemmas ~ ruclem1 through ~ ruclem13 and this final piece. Our proof is based on the proof of Theorem 5.18 of [Truss] p. 114. See ~ ruclem13 for the function existence version of this theorem. For an informal discussion of this proof, see ~ mmcomplex.html#uncountable . For an alternate proof see ~ rucALT . This is Metamath 100 proof #22. (Contributed by NM, 13-Oct-2004.)
theorem ruc:
  $ wbr cn cr csdm $;

--| The set of rationals is strictly less equinumerous than the set of reals ( ` RR ` strictly dominates ` QQ ` ). (Contributed by NM, 18-Dec-2004.)
theorem resdomq:
  $ wbr cq cr csdm $;

--| There are at least aleph-one real numbers. (Contributed by NM, 2-Feb-2005.)
theorem aleph1re:
  $ wbr (cfv c1o cale) cr cdom $;

--| There are at least aleph-one irrationals. (Contributed by NM, 2-Feb-2005.)
theorem aleph1irr:
  $ wbr (cfv c1o cale) (cdif cr cq) cdom $;

--| The complex numbers can be linearly ordered. (Contributed by Stefan O'Rear, 16-Nov-2014.)
theorem cnso {x3: setvar}:
  $ wex x3 (wor cc (cv x3)) $;

--| Lemma for ~ sqrt2irr . This is the core of the proof: if ` A / B = sqrt ( 2 ) ` , then ` A ` and ` B ` are even, so ` A / 2 ` and ` B / 2 ` are smaller representatives, which is absurd by the method of infinite descent (here implemented by strong induction). This is Metamath 100 proof #1. (Contributed by NM, 20-Aug-2001.) (Revised by Mario Carneiro, 12-Sep-2015.) (Proof shortened by JV, 4-Jan-2022.)
theorem sqrt2irrlem (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wceq (cfv c2 csqrt) (co A2 B2 cdiv)) $ >
  $ wi ph (wa (wcel (co A2 c2 cdiv) cz) (wcel (co B2 c2 cdiv) cn)) $;

--| The square root of 2 is irrational. See ~ zsqrtelqelz for a generalization to all non-square integers. The proof's core is proven in ~ sqrt2irrlem , which shows that if ` A / B = sqrt ( 2 ) ` , then ` A ` and ` B ` are even, so ` A / 2 ` and ` B / 2 ` are smaller representatives, which is absurd. An older version of this proof was included in _The Seventeen Provers of the World_ compiled by Freek Wiedijk. It is also the first of the "top 100" mathematical theorems whose formalization is tracked by Freek Wiedijk on his _Formalizing 100 Theorems_ page at ~ http://www.cs.ru.nl/~~freek/100/ . (Contributed by NM, 8-Jan-2002.) (Proof shortened by Mario Carneiro, 12-Sep-2015.)
theorem sqrt2irr:
  $ wnel (cfv c2 csqrt) cq $;

--| The square root of 2 exists and is a real number. (Contributed by NM, 3-Dec-2004.)
theorem sqrt2re:
  $ wcel (cfv c2 csqrt) cr $;

--| The square root of 2 is an irrational number. (Contributed by AV, 23-Dec-2022.)
theorem sqrt2irr0:
  $ wcel (cfv c2 csqrt) (cdif cr cq) $;

--| The sequence ` NN ` , ` ZZ ` , ` QQ ` , ` RR ` , and ` CC ` forms a chain of proper subsets. In each case the proper subset relationship is shown by demonstrating a number that belongs to one set but not the other. We show that zero belongs to ` ZZ ` but not ` NN ` , one-half belongs to ` QQ ` but not ` ZZ ` , the square root of 2 belongs to ` RR ` but not ` QQ ` , and finally that the imaginary number ` _i ` belongs to ` CC ` but not ` RR ` . See ~ nthruz for a further refinement. (Contributed by NM, 12-Jan-2002.)
theorem nthruc:
  $ wa (wa (wpss cn cz) (wpss cz cq)) (wa (wpss cq cr) (wpss cr cc)) $;

--| The sequence ` NN ` , ` NN0 ` , and ` ZZ ` forms a chain of proper subsets. In each case the proper subset relationship is shown by demonstrating a number that belongs to one set but not the other. We show that zero belongs to ` NN0 ` but not ` NN ` and minus one belongs to ` ZZ ` but not ` NN0 ` . This theorem refines the chain of proper subsets ~ nthruc . (Contributed by NM, 9-May-2004.)
theorem nthruz:
  $ wa (wpss cn cn0) (wpss cn0 cz) $;

--| Extend the definition of a class to include the divides relation. See ~ df-dvds .
term cdvds: class;

--| Define the divides relation, see definition in [ApostolNT] p. 14. (Contributed by Paul Chapman, 21-Mar-2011.)
axiom df_dvds {x3 y1 n: setvar}:
  $ wceq cdvds (copab x3 y1 (wa (wa (wcel (cv x3) cz) (wcel (cv y1) cz)) (wrex n (wceq (co (cv n) (cv x3) cmul) (cv y1)) cz))) $;

--| Define the divides relation. ` M || N ` means ` M ` divides into ` N ` with no remainder. For example, ` 3 || 6 ` ( ~ ex-dvds ). As proven in ~ dvdsval3 , ` M || N <-> ( N mod M ) = 0 ` . See ~ divides and ~ dvdsval2 for other equivalent expressions. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem divides {n: setvar} (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wbr M N cdvds) (wrex n (wceq (co (cv n) M cmul) N) cz)) $;

--| One nonzero integer divides another integer if and only if their quotient is an integer. (Contributed by Jeff Hankins, 29-Sep-2013.)
theorem dvdsval2 (M N: class):
  $ wi (w3a (wcel M cz) (wne M cc0) (wcel N cz)) (wb (wbr M N cdvds) (wcel (co N M cdiv) cz)) $;

--| One nonzero integer divides another integer if and only if the remainder upon division is zero, see remark in [ApostolNT] p. 106. (Contributed by Mario Carneiro, 22-Feb-2014.) (Revised by Mario Carneiro, 15-Jul-2014.)
theorem dvdsval3 (M N: class):
  $ wi (wa (wcel M cn) (wcel N cz)) (wb (wbr M N cdvds) (wceq (co N M cmo) cc0)) $;

--| Reverse closure for the divisibility relation. (Contributed by Stefan O'Rear, 5-Sep-2015.)
theorem dvdszrcl (X Y: class):
  $ wi (wbr X Y cdvds) (wa (wcel X cz) (wcel Y cz)) $;

--| If a positive integer divides another integer, then the remainder upon division is zero. (Contributed by AV, 3-Mar-2022.)
theorem dvdsmod0 (M N: class):
  $ wi (wa (wcel M cn) (wbr M N cdvds)) (wceq (co N M cmo) cc0) $;

--| If a number greater than 1 divides another number, the second number increased by 1 is 1 modulo the first number. (Contributed by AV, 19-Mar-2022.)
theorem p1modz1 (A2 M: class):
  $ wi (wa (wbr M A2 cdvds) (wbr c1 M clt)) (wceq (co (co A2 c1 caddc) M cmo) c1) $;

--| If a positive integer divides another integer, this other integer is equal to its positive powers modulo the positive integer. (Formerly part of the proof for ~ fermltl ). (Contributed by Mario Carneiro, 28-Feb-2014.) (Revised by AV, 19-Mar-2022.)
theorem dvdsmodexp (A2 B2 N: class):
  $ wi (w3a (wcel N cn) (wcel B2 cn) (wbr N A2 cdvds)) (wceq (co (co A2 B2 cexp) N cmo) (co A2 N cmo)) $;

--| Strong form of ~ dvdsval2 for positive integers. (Contributed by Stefan O'Rear, 13-Sep-2014.)
theorem nndivdvds (A2 B2: class):
  $ wi (wa (wcel A2 cn) (wcel B2 cn)) (wb (wbr B2 A2 cdvds) (wcel (co A2 B2 cdiv) cn)) $;

--| Definition of the divides relation for positive integers. (Contributed by AV, 26-Jul-2021.)
theorem nndivides {n: setvar} (M N: class):
  $ wi (wa (wcel M cn) (wcel N cn)) (wb (wbr M N cdvds) (wrex n (wceq (co (cv n) M cmul) N) cn)) $;

--| Two ways to say ` A == B ` (mod ` N ` ), see also definition in [ApostolNT] p. 106. (Contributed by Mario Carneiro, 18-Feb-2014.)
theorem moddvds (A2 B2 N: class):
  $ wi (w3a (wcel N cn) (wcel A2 cz) (wcel B2 cz)) (wb (wceq (co A2 N cmo) (co B2 N cmo)) (wbr N (co A2 B2 cmin) cdvds)) $;

--| An integer greater than one divides another integer minus one iff the second integer modulo the first integer is one. (Contributed by AV, 30-May-2023.)
theorem modm1div (A2 N: class):
  $ wi (wa (wcel N (cfv c2 cuz)) (wcel A2 cz)) (wb (wceq (co A2 N cmo) c1) (wbr N (co A2 c1 cmin) cdvds)) $;

--| An integer plus a product is itself modulo a positive integer iff the product is divisible by the positive integer. (Contributed by AV, 8-Sep-2025.)
theorem addmulmodb (A2 B2 C N: class):
  $ wi (wa (wcel N cn) (w3a (wcel A2 cz) (wcel B2 cz) (wcel C cz))) (wb (wbr N (co B2 C cmul) cdvds) (wceq (co (co A2 (co B2 C cmul) caddc) N cmo) (co A2 N cmo))) $;

--| A lemma to assist theorems of ` || ` with no antecedents. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem dvds0lem (K M N: class):
  $ wi (wa (w3a (wcel K cz) (wcel M cz) (wcel N cz)) (wceq (co K M cmul) N)) (wbr M N cdvds) $;

--| A lemma to assist theorems of ` || ` with one antecedent. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem dvds1lem {x3: setvar} (ph: wff) (J K M N: class) (Z: class x3):
  $ wi ph (wa (wcel J cz) (wcel K cz)) $ >
  $ wi ph (wa (wcel M cz) (wcel N cz)) $ >
  $ wi (wa ph (wcel (cv x3) cz)) (wcel Z cz) $ >
  $ wi (wa ph (wcel (cv x3) cz)) (wi (wceq (co (cv x3) J cmul) K) (wceq (co Z M cmul) N)) $ >
  $ wi ph (wi (wbr J K cdvds) (wbr M N cdvds)) $;

--| A lemma to assist theorems of ` || ` with two antecedents. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem dvds2lem {x3 y1: setvar} (ph: wff) (I J K L M N: class) (Z: class x3 y1):
  $ wi ph (wa (wcel I cz) (wcel J cz)) $ >
  $ wi ph (wa (wcel K cz) (wcel L cz)) $ >
  $ wi ph (wa (wcel M cz) (wcel N cz)) $ >
  $ wi (wa ph (wa (wcel (cv x3) cz) (wcel (cv y1) cz))) (wcel Z cz) $ >
  $ wi (wa ph (wa (wcel (cv x3) cz) (wcel (cv y1) cz))) (wi (wa (wceq (co (cv x3) I cmul) J) (wceq (co (cv y1) K cmul) L)) (wceq (co Z M cmul) N)) $ >
  $ wi ph (wi (wa (wbr I J cdvds) (wbr K L cdvds)) (wbr M N cdvds)) $;

--| An integer divides itself. Theorem 1.1(a) in [ApostolNT] p. 14 (reflexive property of the divides relation). (Contributed by Paul Chapman, 21-Mar-2011.)
theorem iddvds (N: class):
  $ wi (wcel N cz) (wbr N N cdvds) $;

--| 1 divides any integer. Theorem 1.1(f) in [ApostolNT] p. 14. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem _1dvds (N: class):
  $ wi (wcel N cz) (wbr c1 N cdvds) $;

--| Any integer divides 0. Theorem 1.1(g) in [ApostolNT] p. 14. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem dvds0 (N: class):
  $ wi (wcel N cz) (wbr N cc0 cdvds) $;

--| An integer divides another iff its negation does. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem negdvdsb (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wbr M N cdvds) (wbr (cneg M) N cdvds)) $;

--| An integer divides another iff it divides its negation. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem dvdsnegb (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wbr M N cdvds) (wbr M (cneg N) cdvds)) $;

--| An integer divides another iff its absolute value does. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem absdvdsb (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wbr M N cdvds) (wbr (cfv M cabs) N cdvds)) $;

--| An integer divides another iff it divides its absolute value. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem dvdsabsb (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wbr M N cdvds) (wbr M (cfv N cabs) cdvds)) $;

--| Only 0 is divisible by 0. Theorem 1.1(h) in [ApostolNT] p. 14. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem _0dvds (N: class):
  $ wi (wcel N cz) (wb (wbr cc0 N cdvds) (wceq N cc0)) $;

--| An integer divides a multiple of itself. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem dvdsmul1 (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wbr M (co M N cmul) cdvds) $;

--| An integer divides a multiple of itself. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem dvdsmul2 (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wbr N (co M N cmul) cdvds) $;

--| An integer divides a positive integer power of itself. (Contributed by Paul Chapman, 26-Oct-2012.)
theorem iddvdsexp (M N: class):
  $ wi (wa (wcel M cz) (wcel N cn)) (wbr M (co M N cexp) cdvds) $;

--| If a product divides an integer, so does one of its factors. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem muldvds1 (K M N: class):
  $ wi (w3a (wcel K cz) (wcel M cz) (wcel N cz)) (wi (wbr (co K M cmul) N cdvds) (wbr K N cdvds)) $;

--| If a product divides an integer, so does one of its factors. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem muldvds2 (K M N: class):
  $ wi (w3a (wcel K cz) (wcel M cz) (wcel N cz)) (wi (wbr (co K M cmul) N cdvds) (wbr M N cdvds)) $;

--| Multiplication by a constant maintains the divides relation. Theorem 1.1(d) in [ApostolNT] p. 14 (multiplication property of the divides relation). (Contributed by Paul Chapman, 21-Mar-2011.)
theorem dvdscmul (K M N: class):
  $ wi (w3a (wcel M cz) (wcel N cz) (wcel K cz)) (wi (wbr M N cdvds) (wbr (co K M cmul) (co K N cmul) cdvds)) $;

--| Multiplication by a constant maintains the divides relation. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem dvdsmulc (K M N: class):
  $ wi (w3a (wcel M cz) (wcel N cz) (wcel K cz)) (wi (wbr M N cdvds) (wbr (co M K cmul) (co N K cmul) cdvds)) $;

--| Cancellation law for the divides relation. Theorem 1.1(e) in [ApostolNT] p. 14. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem dvdscmulr (K M N: class):
  $ wi (w3a (wcel M cz) (wcel N cz) (wa (wcel K cz) (wne K cc0))) (wb (wbr (co K M cmul) (co K N cmul) cdvds) (wbr M N cdvds)) $;

--| Cancellation law for the divides relation. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem dvdsmulcr (K M N: class):
  $ wi (w3a (wcel M cz) (wcel N cz) (wa (wcel K cz) (wne K cc0))) (wb (wbr (co M K cmul) (co N K cmul) cdvds) (wbr M N cdvds)) $;

--| The sum of two integers modulo a positive integer equals zero iff the first of the two integers equals the negative of the other integer modulo the positive integer. (Contributed by AV, 25-Jul-2021.)
theorem summodnegmod (A2 B2 N: class):
  $ wi (w3a (wcel A2 cz) (wcel B2 cz) (wcel N cn)) (wb (wceq (co (co A2 B2 caddc) N cmo) cc0) (wceq (co A2 N cmo) (co (cneg B2) N cmo))) $;

--| The difference of two integers modulo a positive integer equals zero iff the two integers are equal modulo the positive integer. (Contributed by AV, 15-Nov-2025.)
theorem difmod0 (A2 B2 N: class):
  $ wi (w3a (wcel A2 cz) (wcel B2 cz) (wcel N cn)) (wb (wceq (co (co A2 B2 cmin) N cmo) cc0) (wceq (co A2 N cmo) (co B2 N cmo))) $;

--| Constant multiplication in a modulo operation, see theorem 5.3 in [ApostolNT] p. 108. (Contributed by AV, 21-Jul-2021.)
theorem modmulconst (A2 B2 C M: class):
  $ wi (wa (w3a (wcel A2 cz) (wcel B2 cz) (wcel C cn)) (wcel M cn)) (wb (wceq (co A2 M cmo) (co B2 M cmo)) (wceq (co (co C A2 cmul) (co C M cmul) cmo) (co (co C B2 cmul) (co C M cmul) cmo))) $;

--| If an integer divides each of two other integers, it divides any linear combination of them. Theorem 1.1(c) in [ApostolNT] p. 14 (linearity property of the divides relation). (Contributed by Paul Chapman, 21-Mar-2011.)
theorem dvds2ln (I J K M N: class):
  $ wi (wa (wa (wcel I cz) (wcel J cz)) (w3a (wcel K cz) (wcel M cz) (wcel N cz))) (wi (wa (wbr K M cdvds) (wbr K N cdvds)) (wbr K (co (co I M cmul) (co J N cmul) caddc) cdvds)) $;

--| If an integer divides each of two other integers, it divides their sum. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem dvds2add (K M N: class):
  $ wi (w3a (wcel K cz) (wcel M cz) (wcel N cz)) (wi (wa (wbr K M cdvds) (wbr K N cdvds)) (wbr K (co M N caddc) cdvds)) $;

--| If an integer divides each of two other integers, it divides their difference. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem dvds2sub (K M N: class):
  $ wi (w3a (wcel K cz) (wcel M cz) (wcel N cz)) (wi (wa (wbr K M cdvds) (wbr K N cdvds)) (wbr K (co M N cmin) cdvds)) $;

--| Deduction form of ~ dvds2add . (Contributed by SN, 21-Aug-2024.)
theorem dvds2addd (ph: wff) (K M N: class):
  $ wi ph (wcel K cz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wbr K M cdvds) $ >
  $ wi ph (wbr K N cdvds) $ >
  $ wi ph (wbr K (co M N caddc) cdvds) $;

--| Deduction form of ~ dvds2sub . (Contributed by Stanislas Polu, 9-Mar-2020.)
theorem dvds2subd (ph: wff) (K M N: class):
  $ wi ph (wcel K cz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wbr K M cdvds) $ >
  $ wi ph (wbr K N cdvds) $ >
  $ wi ph (wbr K (co M N cmin) cdvds) $;

--| The divides relation is transitive. Theorem 1.1(b) in [ApostolNT] p. 14 (transitive property of the divides relation). (Contributed by Paul Chapman, 21-Mar-2011.)
theorem dvdstr (K M N: class):
  $ wi (w3a (wcel K cz) (wcel M cz) (wcel N cz)) (wi (wa (wbr K M cdvds) (wbr M N cdvds)) (wbr K N cdvds)) $;

--| The divides relation is transitive, a deduction version of ~ dvdstr . (Contributed by metakunt, 12-May-2024.)
theorem dvdstrd (ph: wff) (K M N: class):
  $ wi ph (wcel K cz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wbr K M cdvds) $ >
  $ wi ph (wbr M N cdvds) $ >
  $ wi ph (wbr K N cdvds) $;

--| If an integer divides another, it divides a multiple of it. (Contributed by Paul Chapman, 17-Nov-2012.)
theorem dvdsmultr1 (K M N: class):
  $ wi (w3a (wcel K cz) (wcel M cz) (wcel N cz)) (wi (wbr K M cdvds) (wbr K (co M N cmul) cdvds)) $;

--| Deduction form of ~ dvdsmultr1 . (Contributed by Stanislas Polu, 9-Mar-2020.)
theorem dvdsmultr1d (ph: wff) (K M N: class):
  $ wi ph (wcel K cz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wbr K M cdvds) $ >
  $ wi ph (wbr K (co M N cmul) cdvds) $;

--| If an integer divides another, it divides a multiple of it. (Contributed by Paul Chapman, 17-Nov-2012.)
theorem dvdsmultr2 (K M N: class):
  $ wi (w3a (wcel K cz) (wcel M cz) (wcel N cz)) (wi (wbr K N cdvds) (wbr K (co M N cmul) cdvds)) $;

--| Deduction form of ~ dvdsmultr2 . (Contributed by SN, 23-Aug-2024.)
theorem dvdsmultr2d (ph: wff) (K M N: class):
  $ wi ph (wcel K cz) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wbr K N cdvds) $ >
  $ wi ph (wbr K (co M N cmul) cdvds) $;

--| If an integer divides either of two others, it divides their product. (Contributed by Paul Chapman, 17-Nov-2012.) (Proof shortened by Mario Carneiro, 17-Jul-2014.)
theorem ordvdsmul (K M N: class):
  $ wi (w3a (wcel K cz) (wcel M cz) (wcel N cz)) (wi (wo (wbr K M cdvds) (wbr K N cdvds)) (wbr K (co M N cmul) cdvds)) $;

--| If an integer divides a difference, then it divides one term iff it divides the other. (Contributed by Mario Carneiro, 13-Jul-2014.)
theorem dvdssub2 (K M N: class):
  $ wi (wa (w3a (wcel K cz) (wcel M cz) (wcel N cz)) (wbr K (co M N cmin) cdvds)) (wb (wbr K M cdvds) (wbr K N cdvds)) $;

--| An integer divides another iff it divides their sum. (Contributed by Paul Chapman, 31-Mar-2011.) (Revised by Mario Carneiro, 13-Jul-2014.)
theorem dvdsadd (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wbr M N cdvds) (wbr M (co M N caddc) cdvds)) $;

--| An integer divides another iff it divides their sum. (Contributed by Paul Chapman, 31-Mar-2011.)
theorem dvdsaddr (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wbr M N cdvds) (wbr M (co N M caddc) cdvds)) $;

--| An integer divides another iff it divides their difference. (Contributed by Paul Chapman, 31-Mar-2011.)
theorem dvdssub (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wbr M N cdvds) (wbr M (co M N cmin) cdvds)) $;

--| An integer divides another iff it divides their difference. (Contributed by Paul Chapman, 31-Mar-2011.)
theorem dvdssubr (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wbr M N cdvds) (wbr M (co N M cmin) cdvds)) $;

--| Adding a multiple of the base does not affect divisibility. (Contributed by Stefan O'Rear, 23-Sep-2014.)
theorem dvdsadd2b (A2 B2 C: class):
  $ wi (w3a (wcel A2 cz) (wcel B2 cz) (wa (wcel C cz) (wbr A2 C cdvds))) (wb (wbr A2 B2 cdvds) (wbr A2 (co C B2 caddc) cdvds)) $;

--| Adding a multiple of the base does not affect divisibility. Variant of ~ dvdsadd2b only requiring ` B ` to be a real number (not necessarily an integer). (Contributed by AV, 19-Jul-2021.)
theorem dvdsaddre2b (A2 B2 C: class):
  $ wi (w3a (wcel A2 cz) (wcel B2 cr) (wa (wcel C cz) (wbr A2 C cdvds))) (wb (wbr A2 B2 cdvds) (wbr A2 (co C B2 caddc) cdvds)) $;

--| If every term in a sum is divisible by ` N ` , then so is the sum. (Contributed by Mario Carneiro, 17-Jan-2015.)
theorem fsumdvds {k: setvar} (ph: wff) (A2: class) (B2: class k) (N: class):
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wcel N cz) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cz) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wbr N B2 cdvds) $ >
  $ wi ph (wbr N (csu k A2 B2) cdvds) $;

--| Lemma for ~ dvdsle . (Contributed by Paul Chapman, 21-Mar-2011.)
theorem dvdslelem (K M N: class):
  $ wcel M cz $ >
  $ wcel N cn $ >
  $ wcel K cz $ >
  $ wi (wbr N M clt) (wne (co K M cmul) N) $;

--| The divisors of a positive integer are bounded by it. The proof does not use ` / ` . (Contributed by Paul Chapman, 21-Mar-2011.)
theorem dvdsle (M N: class):
  $ wi (wa (wcel M cz) (wcel N cn)) (wi (wbr M N cdvds) (wbr M N cle)) $;

--| The divisors of a nonzero integer are bounded by its absolute value. Theorem 1.1(i) in [ApostolNT] p. 14 (comparison property of the divides relation). (Contributed by Paul Chapman, 21-Mar-2011.) (Proof shortened by Fan Zheng, 3-Jul-2016.)
theorem dvdsleabs (M N: class):
  $ wi (w3a (wcel M cz) (wcel N cz) (wne N cc0)) (wi (wbr M N cdvds) (wbr M (cfv N cabs) cle)) $;

--| Transfer divisibility to an order constraint on absolute values. (Contributed by Stefan O'Rear, 24-Sep-2014.)
theorem dvdsleabs2 (M N: class):
  $ wi (w3a (wcel M cz) (wcel N cz) (wne N cc0)) (wi (wbr M N cdvds) (wbr (cfv M cabs) (cfv N cabs) cle)) $;

--| If two integers divide each other, they must be equal, up to a difference in sign. Theorem 1.1(j) in [ApostolNT] p. 14. (Contributed by Mario Carneiro, 30-May-2014.) (Revised by AV, 7-Aug-2021.)
theorem dvdsabseq (M N: class):
  $ wi (wa (wbr M N cdvds) (wbr N M cdvds)) (wceq (cfv M cabs) (cfv N cabs)) $;

--| If two nonnegative integers divide each other, they must be equal. (Contributed by Mario Carneiro, 30-May-2014.) (Proof shortened by AV, 7-Aug-2021.)
theorem dvdseq (M N: class):
  $ wi (wa (wa (wcel M cn0) (wcel N cn0)) (wa (wbr M N cdvds) (wbr N M cdvds))) (wceq M N) $;

--| If a nonzero integer ` M ` divides another integer ` N ` , the other integer ` N ` divided by the nonzero integer ` M ` (i.e. the _divisor conjugate_ of ` N ` to ` M ` ) divides the other integer ` N ` . Theorem 1.1(k) in [ApostolNT] p. 14. (Contributed by AV, 7-Aug-2021.)
theorem divconjdvds (M N: class):
  $ wi (wa (wbr M N cdvds) (wne M cc0)) (wbr (co N M cdiv) N cdvds) $;

--| The complement of a divisor of ` N ` is also a divisor of ` N ` . (Contributed by Mario Carneiro, 2-Jul-2015.) (Proof shortened by AV, 9-Aug-2021.)
theorem dvdsdivcl {x3: setvar} (A2 N: class):
  $ wi (wa (wcel N cn) (wcel A2 (crab x3 (wbr (cv x3) N cdvds) cn))) (wcel (co N A2 cdiv) (crab x3 (wbr (cv x3) N cdvds) cn)) $;

--| An involution of the divisors of a number. (Contributed by Stefan O'Rear, 12-Sep-2015.) (Proof shortened by Mario Carneiro, 13-May-2016.)
theorem dvdsflip {x3 y1: setvar} (A2: class x3) (F: class x3 y1) (N: class):
  $ wceq A2 (crab x3 (wbr (cv x3) N cdvds) cn) $ >
  $ wceq F (cmpt y1 A2 (co N (cv y1) cdiv)) $ >
  $ wi (wcel N cn) (wf1o A2 A2 F) $;

--| The set of divisors of a number is a subset of a finite set. (Contributed by Mario Carneiro, 22-Sep-2014.)
theorem dvdsssfz1 {p: setvar} (A2: class):
  $ wi (wcel A2 cn) (wss (crab p (wbr (cv p) A2 cdvds) cn) (co c1 A2 cfz)) $;

--| The only nonnegative integer that divides 1 is 1. (Contributed by Mario Carneiro, 2-Jul-2015.)
theorem dvds1 (M: class):
  $ wi (wcel M cn0) (wb (wbr M c1 cdvds) (wceq M c1)) $;

--| Only 0 is divisible by all integers. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem alzdvds {x3: setvar} (N: class):
  $ wi (wcel N cz) (wb (wral x3 (wbr (cv x3) N cdvds) cz) (wceq N cc0)) $;

--| Poset extensionality for division. (Contributed by Stefan O'Rear, 6-Sep-2015.)
theorem dvdsext {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cn0) (wcel B2 cn0)) (wb (wceq A2 B2) (wral x3 (wb (wbr A2 (cv x3) cdvds) (wbr B2 (cv x3) cdvds)) cn0)) $;

--| No number from ` 1 ` to ` M - 1 ` is a multiple of ` M ` . (Contributed by Mario Carneiro, 24-Jan-2015.)
theorem fzm1ndvds (M N: class):
  $ wi (wa (wcel M cn) (wcel N (co c1 (co M c1 cmin) cfz))) (wn (wbr M N cdvds)) $;

--| Zero is the only one of the first ` A ` nonnegative integers that is divisible by ` A ` . (Contributed by Stefan O'Rear, 6-Sep-2015.)
theorem fzo0dvdseq (A2 B2: class):
  $ wi (wcel B2 (co cc0 A2 cfzo)) (wb (wbr A2 B2 cdvds) (wceq B2 cc0)) $;

--| Two different elements of a half-open range are not congruent mod its length. (Contributed by Stefan O'Rear, 6-Sep-2015.)
theorem fzocongeq (A2 B2 C D: class):
  $ wi (wa (wcel A2 (co C D cfzo)) (wcel B2 (co C D cfzo))) (wb (wbr (co D C cmin) (co A2 B2 cmin) cdvds) (wceq A2 B2)) $;

--| Two nonnegative integers less than the modulus are equal iff the sums of these integer with another integer are equal modulo the modulus. Shorter proof of ~ addmodlteq based on the "divides" relation. (Contributed by AV, 14-Mar-2021.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem addmodlteqALT (S I J N: class):
  $ wi (w3a (wcel I (co cc0 N cfzo)) (wcel J (co cc0 N cfzo)) (wcel S cz)) (wb (wceq (co (co I S caddc) N cmo) (co (co J S caddc) N cmo)) (wceq I J)) $;

--| A positive integer divides any greater factorial. (Contributed by Paul Chapman, 28-Nov-2012.)
theorem dvdsfac (K N: class):
  $ wi (wa (wcel K cn) (wcel N (cfv K cuz))) (wbr K (cfv N cfa) cdvds) $;

--| If an integer divides another integer, then it also divides any of its powers. (Contributed by Scott Fenton, 7-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem dvdsexp2im (K M N: class):
  $ wi (w3a (wcel K cz) (wcel M cz) (wcel N cn)) (wi (wbr K M cdvds) (wbr K (co M N cexp) cdvds)) $;

--| A power divides a power with a greater exponent. (Contributed by Mario Carneiro, 23-Feb-2014.)
theorem dvdsexp (A2 M N: class):
  $ wi (w3a (wcel A2 cz) (wcel M cn0) (wcel N (cfv M cuz))) (wbr (co A2 M cexp) (co A2 N cexp) cdvds) $;

--| Any number ` K ` whose mod base ` N ` is divisible by a divisor ` P ` of the base is also divisible by ` P ` . This means that primes will also be relatively prime to the base when reduced ` mod N ` for any base. (Contributed by Mario Carneiro, 13-Mar-2014.)
theorem dvdsmod (P K N: class):
  $ wi (wa (w3a (wcel P cn) (wcel N cn) (wcel K cz)) (wbr P N cdvds)) (wb (wbr P (co K N cmo) cdvds) (wbr P K cdvds)) $;

--| If an integer is divisible by a positive integer, the product of this integer with another integer modulo the positive integer is 0. (Contributed by Alexander van der Vekens, 30-Aug-2018.) (Proof shortened by AV, 18-Mar-2022.)
theorem mulmoddvds (A2 B2 N: class):
  $ wi (w3a (wcel N cn) (wcel A2 cz) (wcel B2 cz)) (wi (wbr N A2 cdvds) (wceq (co (co A2 B2 cmul) N cmo) cc0)) $;

--| A rule for divisibility by 3 of a number written in base 10. This is Metamath 100 proof #85. (Contributed by Mario Carneiro, 14-Jul-2014.) (Revised by Mario Carneiro, 17-Jan-2015.) (Revised by AV, 8-Sep-2021.)
theorem _3dvds {k: setvar} (F N: class):
  $ wi (wa (wcel N cn0) (wf (co cc0 N cfz) cz F)) (wb (wbr c3 (csu k (co cc0 N cfz) (co (cfv (cv k) F) (co (cdc c1 cc0) (cv k) cexp) cmul)) cdvds) (wbr c3 (csu k (co cc0 N cfz) (cfv (cv k) F)) cdvds)) $;

--| A decimal number is divisible by three iff the sum of its two "digits" is divisible by three. The term "digits" in its narrow sense is only correct if ` A ` and ` B ` actually are digits (i.e. nonnegative integers less than 10). However, this theorem holds for arbitrary nonnegative integers ` A ` and ` B ` , especially if ` A ` is itself a decimal number, e.g., ` A = ; C D ` . (Contributed by AV, 14-Jun-2021.) (Revised by AV, 8-Sep-2021.)
theorem _3dvdsdec (A2 B2: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 cn0 $ >
  $ wb (wbr c3 (cdc A2 B2) cdvds) (wbr c3 (co A2 B2 caddc) cdvds) $;

--| A decimal number is divisible by three iff the sum of its three "digits" is divisible by three. The term "digits" in its narrow sense is only correct if ` A ` , ` B ` and ` C ` actually are digits (i.e. nonnegative integers less than 10). However, this theorem holds for arbitrary nonnegative integers ` A ` , ` B ` and ` C ` . (Contributed by AV, 14-Jun-2021.) (Revised by AV, 1-Aug-2021.)
theorem _3dvds2dec (A2 B2 C: class):
  $ wcel A2 cn0 $ >
  $ wcel B2 cn0 $ >
  $ wcel C cn0 $ >
  $ wb (wbr c3 (cdc (cdc A2 B2) C) cdvds) (wbr c3 (co (co A2 B2 caddc) C caddc) cdvds) $;

--| A finite product of integers is divisible by any of its factors being function values. (Contributed by AV, 1-Aug-2021.)
theorem fprodfvdvdsd {x3 k: setvar} (ph: wff) (A2: class x3) (B2: class x3 k) (F: class x3):
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wf B2 cz F) $ >
  $ wi ph (wral x3 (wbr (cfv (cv x3) F) (cprod k A2 (cfv (cv k) F)) cdvds) A2) $;

--| A finite product of integers is divisible by any of its factors. (Contributed by AV, 14-Aug-2020.) (Proof shortened by AV, 2-Aug-2021.)
theorem fproddvdsd {x3 k: setvar} (ph: wff) (A2: class x3):
  $ wi ph (wcel A2 cfn) $ >
  $ wi ph (wss A2 cz) $ >
  $ wi ph (wral x3 (wbr (cv x3) (cprod k A2 (cv k)) cdvds) A2) $;

--| An even number is an integer. This follows immediately from the reverse closure of the divides relation, see ~ dvdszrcl . (Contributed by AV, 22-Jun-2021.)
theorem evenelz (N: class):
  $ wi (wbr c2 N cdvds) (wcel N cz) $;

--| An integer is even or odd. With this representation of even and odd integers, this variant of ~ zeo follows immediately from the law of excluded middle, see ~ exmidd . (Contributed by AV, 17-Jun-2021.)
theorem zeo3 (N: class):
  $ wi (wcel N cz) (wo (wbr c2 N cdvds) (wn (wbr c2 N cdvds))) $;

--| An integer is even or odd but not both. With this representation of even and odd integers, this variant of ~ zeo2 follows immediately from the principle of double negation, see ~ notnotb . (Contributed by AV, 17-Jun-2021.)
theorem zeo4 (N: class):
  $ wi (wcel N cz) (wb (wbr c2 N cdvds) (wn (wn (wbr c2 N cdvds)))) $;

--| No even integer equals an odd integer (i.e. no integer can be both even and odd). Exercise 10(a) of [Apostol] p. 28. This variant of ~ zneo follows immediately from the fact that a contradiction implies anything, see ~ pm2.21i . (Contributed by AV, 22-Jun-2021.)
theorem zeneo (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cz)) (wi (wa (wbr c2 A2 cdvds) (wn (wbr c2 B2 cdvds))) (wne A2 B2)) $;

--| Lemma for ~ odd2np1 . (Contributed by Scott Fenton, 3-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem odd2np1lem {k n: setvar} (N: class):
  $ wi (wcel N cn0) (wo (wrex n (wceq (co (co c2 (cv n) cmul) c1 caddc) N) cz) (wrex k (wceq (co (cv k) c2 cmul) N) cz)) $;

--| An integer is odd iff it is one plus twice another integer. (Contributed by Scott Fenton, 3-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem odd2np1 {n: setvar} (N: class):
  $ wi (wcel N cz) (wb (wn (wbr c2 N cdvds)) (wrex n (wceq (co (co c2 (cv n) cmul) c1 caddc) N) cz)) $;

--| An integer is even iff it is twice another integer. (Contributed by AV, 25-Jun-2020.)
theorem even2n {n: setvar} (N: class):
  $ wb (wbr c2 N cdvds) (wrex n (wceq (co c2 (cv n) cmul) N) cz) $;

--| An integer is odd iff its predecessor is even. (Contributed by Mario Carneiro, 5-Sep-2016.)
theorem oddm1even (N: class):
  $ wi (wcel N cz) (wb (wn (wbr c2 N cdvds)) (wbr c2 (co N c1 cmin) cdvds)) $;

--| An integer is odd iff its successor is even. (Contributed by Mario Carneiro, 5-Sep-2016.)
theorem oddp1even (N: class):
  $ wi (wcel N cz) (wb (wn (wbr c2 N cdvds)) (wbr c2 (co N c1 caddc) cdvds)) $;

--| The exponential of the negative of a number, when the exponent is odd. (Contributed by Mario Carneiro, 25-Apr-2015.) (Proof shortened by AV, 10-Jul-2022.)
theorem oexpneg (A2 N: class):
  $ wi (w3a (wcel A2 cc) (wcel N cn) (wn (wbr c2 N cdvds))) (wceq (co (cneg A2) N cexp) (cneg (co A2 N cexp))) $;

--| An integer is 0 modulo 2 iff it is even (i.e. divisible by 2), see example 2 in [ApostolNT] p. 107. (Contributed by AV, 21-Jul-2021.)
theorem mod2eq0even (N: class):
  $ wi (wcel N cz) (wb (wceq (co N c2 cmo) cc0) (wbr c2 N cdvds)) $;

--| An integer is 1 modulo 2 iff it is odd (i.e. not divisible by 2), see example 3 in [ApostolNT] p. 107. (Contributed by AV, 24-May-2020.) (Proof shortened by AV, 5-Jul-2020.)
theorem mod2eq1n2dvds (N: class):
  $ wi (wcel N cz) (wb (wceq (co N c2 cmo) c1) (wn (wbr c2 N cdvds))) $;

--| A nonnegative integer is odd iff it is one plus twice another nonnegative integer. (Contributed by AV, 19-Jun-2021.)
theorem oddnn02np1 {n: setvar} (N: class):
  $ wi (wcel N cn0) (wb (wn (wbr c2 N cdvds)) (wrex n (wceq (co (co c2 (cv n) cmul) c1 caddc) N) cn0)) $;

--| An integer greater than one is odd iff it is one plus twice a positive integer. (Contributed by AV, 16-Aug-2021.) (Proof shortened by AV, 9-Jul-2022.)
theorem oddge22np1 {n: setvar} (N: class):
  $ wi (wcel N (cfv c2 cuz)) (wb (wn (wbr c2 N cdvds)) (wrex n (wceq (co (co c2 (cv n) cmul) c1 caddc) N) cn)) $;

--| A nonnegative integer is even iff it is twice another nonnegative integer. (Contributed by AV, 12-Aug-2021.) (Proof shortened by AV, 10-Jul-2022.)
theorem evennn02n {n: setvar} (N: class):
  $ wi (wcel N cn0) (wb (wbr c2 N cdvds) (wrex n (wceq (co c2 (cv n) cmul) N) cn0)) $;

--| A positive integer is even iff it is twice another positive integer. (Contributed by AV, 12-Aug-2021.)
theorem evennn2n {n: setvar} (N: class):
  $ wi (wcel N cn) (wb (wbr c2 N cdvds) (wrex n (wceq (co c2 (cv n) cmul) N) cn)) $;

--| A number which is twice an integer increased by 1 is odd. (Contributed by AV, 16-Jul-2021.)
theorem _2tp1odd (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wceq B2 (co (co c2 A2 cmul) c1 caddc))) (wn (wbr c2 B2 cdvds)) $;

--| An integer multiplied with its successor divided by 2 yields an integer, i.e. an integer multiplied with its successor is even. (Contributed by AV, 19-Jul-2021.)
theorem mulsucdiv2z (N: class):
  $ wi (wcel N cz) (wcel (co (co N (co N c1 caddc) cmul) c2 cdiv) cz) $;

--| A squared odd number minus 1 divided by 8 is an integer. (Contributed by AV, 19-Jul-2021.)
theorem sqoddm1div8z (N: class):
  $ wi (wa (wcel N cz) (wn (wbr c2 N cdvds))) (wcel (co (co (co N c2 cexp) c1 cmin) c8 cdiv) cz) $;

--| A number which is twice an integer is even. (Contributed by AV, 16-Jul-2021.)
theorem _2teven (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wceq B2 (co c2 A2 cmul))) (wbr c2 B2 cdvds) $;

--| An integer is either even or odd, version of ~ zeo3 avoiding the negation of the representation of an odd number. (Proposed by BJ, 21-Jun-2021.) (Contributed by AV, 26-Jun-2021.)
theorem zeo5 (N: class):
  $ wi (wcel N cz) (wo (wbr c2 N cdvds) (wbr c2 (co N c1 caddc) cdvds)) $;

--| An integer is even iff its quotient with 2 is an integer. This is a representation of even numbers without using the divides relation, see ~ zeo and ~ zeo2 . (Contributed by AV, 22-Jun-2021.)
theorem evend2 (N: class):
  $ wi (wcel N cz) (wb (wbr c2 N cdvds) (wcel (co N c2 cdiv) cz)) $;

--| An integer is odd iff its successor divided by 2 is an integer. This is a representation of odd numbers without using the divides relation, see ~ zeo and ~ zeo2 . (Contributed by AV, 22-Jun-2021.)
theorem oddp1d2 (N: class):
  $ wi (wcel N cz) (wb (wn (wbr c2 N cdvds)) (wcel (co (co N c1 caddc) c2 cdiv) cz)) $;

--| Alternate characterizations of an odd number. (Contributed by AV, 7-Jun-2020.)
theorem zob (N: class):
  $ wi (wcel N cz) (wb (wcel (co (co N c1 caddc) c2 cdiv) cz) (wcel (co (co N c1 cmin) c2 cdiv) cz)) $;

--| An integer is odd iff its predecessor divided by 2 is an integer. This is another representation of odd numbers without using the divides relation. (Contributed by AV, 18-Jun-2021.) (Proof shortened by AV, 22-Jun-2021.)
theorem oddm1d2 (N: class):
  $ wi (wcel N cz) (wb (wn (wbr c2 N cdvds)) (wcel (co (co N c1 cmin) c2 cdiv) cz)) $;

--| An integer is less than half of an odd number iff it is less than or equal to the half of the predecessor of the odd number (which is an even number). (Contributed by AV, 29-Jun-2021.)
theorem ltoddhalfle (M N: class):
  $ wi (w3a (wcel N cz) (wn (wbr c2 N cdvds)) (wcel M cz)) (wb (wbr M (co N c2 cdiv) clt) (wbr M (co (co N c1 cmin) c2 cdiv) cle)) $;

--| An integer is greater than half of an odd number iff it is greater than or equal to the half of the odd number. (Contributed by AV, 1-Jul-2021.)
theorem halfleoddlt (M N: class):
  $ wi (w3a (wcel N cz) (wn (wbr c2 N cdvds)) (wcel M cz)) (wb (wbr (co N c2 cdiv) M cle) (wbr (co N c2 cdiv) M clt)) $;

--| The sum of two odds is even. (Contributed by Scott Fenton, 7-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem opoe (A2 B2: class):
  $ wi (wa (wa (wcel A2 cz) (wn (wbr c2 A2 cdvds))) (wa (wcel B2 cz) (wn (wbr c2 B2 cdvds)))) (wbr c2 (co A2 B2 caddc) cdvds) $;

--| The difference of two odds is even. (Contributed by Scott Fenton, 7-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem omoe (A2 B2: class):
  $ wi (wa (wa (wcel A2 cz) (wn (wbr c2 A2 cdvds))) (wa (wcel B2 cz) (wn (wbr c2 B2 cdvds)))) (wbr c2 (co A2 B2 cmin) cdvds) $;

--| The sum of an odd and an even is odd. (Contributed by Scott Fenton, 7-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem opeo (A2 B2: class):
  $ wi (wa (wa (wcel A2 cz) (wn (wbr c2 A2 cdvds))) (wa (wcel B2 cz) (wbr c2 B2 cdvds))) (wn (wbr c2 (co A2 B2 caddc) cdvds)) $;

--| The difference of an odd and an even is odd. (Contributed by Scott Fenton, 7-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem omeo (A2 B2: class):
  $ wi (wa (wa (wcel A2 cz) (wn (wbr c2 A2 cdvds))) (wa (wcel B2 cz) (wbr c2 B2 cdvds))) (wn (wbr c2 (co A2 B2 cmin) cdvds)) $;

--| 2 divides 0. That means 0 is even. (Contributed by AV, 11-Feb-2020.) (Revised by AV, 23-Jun-2021.)
theorem z0even:
  $ wbr c2 cc0 cdvds $;

--| 2 does not divide 1. That means 1 is odd. (Contributed by David A. Wheeler, 8-Dec-2018.) (Proof shortened by Steven Nguyen, 3-May-2023.)
theorem n2dvds1:
  $ wn (wbr c2 c1 cdvds) $;

--| 2 does not divide -1. That means -1 is odd. (Contributed by AV, 15-Aug-2021.)
theorem n2dvdsm1:
  $ wn (wbr c2 (cneg c1) cdvds) $;

--| 2 divides 2. That means 2 is even. (Contributed by AV, 12-Feb-2020.) (Revised by AV, 23-Jun-2021.)
theorem z2even:
  $ wbr c2 c2 cdvds $;

--| 2 does not divide 3. That means 3 is odd. (Contributed by AV, 28-Feb-2021.) (Proof shortened by Steven Nguyen, 3-May-2023.)
theorem n2dvds3:
  $ wn (wbr c2 c3 cdvds) $;

--| 2 divides 4. That means 4 is even. (Contributed by AV, 23-Jul-2020.) (Revised by AV, 4-Jul-2021.)
theorem z4even:
  $ wbr c2 c4 cdvds $;

--| An integer which is divisible by 4 is divisible by 2, that is, is even. (Contributed by AV, 4-Jul-2021.)
theorem _4dvdseven (N: class):
  $ wi (wbr c4 N cdvds) (wbr c2 N cdvds) $;

--| Exponentiation of -1 by an even power. Variant of ~ m1expeven . (Contributed by AV, 25-Jun-2021.)
theorem m1expe (N: class):
  $ wi (wbr c2 N cdvds) (wceq (co (cneg c1) N cexp) c1) $;

--| Exponentiation of -1 by an odd power. (Contributed by AV, 26-Jun-2021.)
theorem m1expo (N: class):
  $ wi (wa (wcel N cz) (wn (wbr c2 N cdvds))) (wceq (co (cneg c1) N cexp) (cneg c1)) $;

--| Exponentiation of negative one is one iff the exponent is even. (Contributed by AV, 20-Jun-2021.)
theorem m1exp1 (N: class):
  $ wi (wcel N cz) (wb (wceq (co (cneg c1) N cexp) c1) (wbr c2 N cdvds)) $;

--| A positive integer is an even nonnegative integer iff it is an even positive integer. (Contributed by AV, 30-May-2020.)
theorem nn0enne (N: class):
  $ wi (wcel N cn) (wb (wcel (co N c2 cdiv) cn0) (wcel (co N c2 cdiv) cn)) $;

--| The half of an even nonnegative integer is a nonnegative integer. (Contributed by AV, 22-Jun-2020.) (Revised by AV, 28-Jun-2021.) (Proof shortened by AV, 10-Jul-2022.)
theorem nn0ehalf (N: class):
  $ wi (wa (wcel N cn0) (wbr c2 N cdvds)) (wcel (co N c2 cdiv) cn0) $;

--| The half of an even positive integer is a positive integer. (Contributed by AV, 28-Jun-2021.)
theorem nnehalf (N: class):
  $ wi (wa (wcel N cn) (wbr c2 N cdvds)) (wcel (co N c2 cdiv) cn) $;

--| An odd nonnegative integer is positive. (Contributed by Steven Nguyen, 25-Mar-2023.)
theorem nn0onn (N: class):
  $ wi (wa (wcel N cn0) (wn (wbr c2 N cdvds))) (wcel N cn) $;

--| An odd nonnegative integer is either 1 or greater than 2. (Contributed by AV, 2-Jun-2020.)
theorem nn0o1gt2 (N: class):
  $ wi (wa (wcel N cn0) (wcel (co (co N c1 caddc) c2 cdiv) cn0)) (wo (wceq N c1) (wbr c2 N clt)) $;

--| An alternate characterization of an odd integer greater than 1. (Contributed by AV, 2-Jun-2020.) (Proof shortened by AV, 10-Jul-2022.)
theorem nno (N: class):
  $ wi (wa (wcel N (cfv c2 cuz)) (wcel (co (co N c1 caddc) c2 cdiv) cn0)) (wcel (co (co N c1 cmin) c2 cdiv) cn) $;

--| An alternate characterization of an odd nonnegative integer. (Contributed by AV, 28-May-2020.) (Proof shortened by AV, 2-Jun-2020.)
theorem nn0o (N: class):
  $ wi (wa (wcel N cn0) (wcel (co (co N c1 caddc) c2 cdiv) cn0)) (wcel (co (co N c1 cmin) c2 cdiv) cn0) $;

--| Alternate characterizations of an odd nonnegative integer. (Contributed by AV, 4-Jun-2020.)
theorem nn0ob (N: class):
  $ wi (wcel N cn0) (wb (wcel (co (co N c1 caddc) c2 cdiv) cn0) (wcel (co (co N c1 cmin) c2 cdiv) cn0)) $;

--| A positive integer is odd iff its predecessor divided by 2 is a positive integer. (Contributed by AV, 28-Jun-2021.) (Proof shortened by AV, 10-Jul-2022.)
theorem nn0oddm1d2 (N: class):
  $ wi (wcel N cn0) (wb (wn (wbr c2 N cdvds)) (wcel (co (co N c1 cmin) c2 cdiv) cn0)) $;

--| A positive integer is odd iff its successor divided by 2 is a positive integer. (Contributed by AV, 28-Jun-2021.)
theorem nnoddm1d2 (N: class):
  $ wi (wcel N cn) (wb (wn (wbr c2 N cdvds)) (wcel (co (co N c1 caddc) c2 cdiv) cn)) $;

--| If every term in a sum is even, then so is the sum. (Contributed by AV, 14-Aug-2021.)
theorem sumeven {k: setvar} (ph: wff) (A2: class) (B2: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cz) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wbr c2 B2 cdvds) $ >
  $ wi ph (wbr c2 (csu k A2 B2) cdvds) $;

--| If every term in a sum is odd, then the sum is even iff the number of terms in the sum is even. (Contributed by AV, 14-Aug-2021.)
theorem sumodd {k: setvar} (ph: wff) (A2: class) (B2: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cz) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wn (wbr c2 B2 cdvds)) $ >
  $ wi ph (wb (wbr c2 (cfv A2 chash) cdvds) (wbr c2 (csu k A2 B2) cdvds)) $;

--| If every term in a sum with an even number of terms is odd, then the sum is even. (Contributed by AV, 14-Aug-2021.)
theorem evensumodd {k: setvar} (ph: wff) (A2: class) (B2: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cz) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wn (wbr c2 B2 cdvds)) $ >
  $ wi ph (wbr c2 (cfv A2 chash) cdvds) $ >
  $ wi ph (wbr c2 (csu k A2 B2) cdvds) $;

--| If every term in a sum with an odd number of terms is odd, then the sum is odd. (Contributed by AV, 14-Aug-2021.)
theorem oddsumodd {k: setvar} (ph: wff) (A2: class) (B2: class k):
  $ wi ph (wcel A2 cfn) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wcel B2 cz) $ >
  $ wi (wa ph (wcel (cv k) A2)) (wn (wbr c2 B2 cdvds)) $ >
  $ wi ph (wn (wbr c2 (cfv A2 chash) cdvds)) $ >
  $ wi ph (wn (wbr c2 (csu k A2 B2) cdvds)) $;

--| The n-th power of a number increased by 1 expressed by a product with a finite sum. (Contributed by AV, 15-Aug-2021.)
theorem pwp1fsum {k: setvar} (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wceq (co (co (co (cneg c1) (co N c1 cmin) cexp) (co A2 N cexp) cmul) c1 caddc) (co (co A2 c1 caddc) (csu k (co cc0 (co N c1 cmin) cfz) (co (co (cneg c1) (cv k) cexp) (co A2 (cv k) cexp) cmul)) cmul)) $;

--| An odd power of a number increased by 1 expressed by a product with a finite sum. (Contributed by AV, 15-Aug-2021.)
theorem oddpwp1fsum {k: setvar} (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wn (wbr c2 N cdvds)) $ >
  $ wi ph (wceq (co (co A2 N cexp) c1 caddc) (co (co A2 c1 caddc) (csu k (co cc0 (co N c1 cmin) cfz) (co (co (cneg c1) (cv k) cexp) (co A2 (cv k) cexp) cmul)) cmul)) $;

--| Lemma for ~ divalg . (Contributed by Paul Chapman, 21-Mar-2011.)
theorem divalglem0 (D R K N: class):
  $ wcel N cz $ >
  $ wcel D cz $ >
  $ wi (wa (wcel R cz) (wcel K cz)) (wi (wbr D (co N R cmin) cdvds) (wbr D (co N (co R (co K (cfv D cabs) cmul) cmin) cmin) cdvds)) $;

--| Lemma for ~ divalg . (Contributed by Paul Chapman, 21-Mar-2011.)
theorem divalglem1 (D N: class):
  $ wcel N cz $ >
  $ wcel D cz $ >
  $ wne D cc0 $ >
  $ wbr cc0 (co N (cfv (co N D cmul) cabs) caddc) cle $;

--| Lemma for ~ divalg . (Contributed by Paul Chapman, 21-Mar-2011.) (Revised by AV, 2-Oct-2020.)
theorem divalglem2 {r: setvar} (D: class) (S: class r) (N: class):
  $ wcel N cz $ >
  $ wcel D cz $ >
  $ wne D cc0 $ >
  $ wceq S (crab r (wbr D (co N (cv r) cmin) cdvds) cn0) $ >
  $ wcel (cinf S cr clt) S $;

--| Lemma for ~ divalg . (Contributed by Paul Chapman, 21-Mar-2011.)
theorem divalglem4 {r q: setvar} (D: class) (S: class r q) (N: class):
  $ wcel N cz $ >
  $ wcel D cz $ >
  $ wne D cc0 $ >
  $ wceq S (crab r (wbr D (co N (cv r) cmin) cdvds) cn0) $ >
  $ wceq S (crab r (wrex q (wceq N (co (co (cv q) D cmul) (cv r) caddc)) cz) cn0) $;

--| Lemma for ~ divalg . (Contributed by Paul Chapman, 21-Mar-2011.) (Revised by AV, 2-Oct-2020.)
theorem divalglem5 {r: setvar} (D: class) (R S: class r) (N: class):
  $ wcel N cz $ >
  $ wcel D cz $ >
  $ wne D cc0 $ >
  $ wceq S (crab r (wbr D (co N (cv r) cmin) cdvds) cn0) $ >
  $ wceq R (cinf S cr clt) $ >
  $ wa (wbr cc0 R cle) (wbr R (cfv D cabs) clt) $;

--| Lemma for ~ divalg . (Contributed by Paul Chapman, 21-Mar-2011.)
theorem divalglem6 (A2 K X: class):
  $ wcel A2 cn $ >
  $ wcel X (co cc0 (co A2 c1 cmin) cfz) $ >
  $ wcel K cz $ >
  $ wi (wne K cc0) (wn (wcel (co X (co K A2 cmul) caddc) (co cc0 (co A2 c1 cmin) cfz))) $;

--| Lemma for ~ divalg . (Contributed by Paul Chapman, 21-Mar-2011.)
theorem divalglem7 (D K X: class):
  $ wcel D cz $ >
  $ wne D cc0 $ >
  $ wi (wa (wcel X (co cc0 (co (cfv D cabs) c1 cmin) cfz)) (wcel K cz)) (wi (wne K cc0) (wn (wcel (co X (co K (cfv D cabs) cmul) caddc) (co cc0 (co (cfv D cabs) c1 cmin) cfz)))) $;

--| Lemma for ~ divalg . (Contributed by Paul Chapman, 21-Mar-2011.)
theorem divalglem8 {r: setvar} (D: class) (S K: class r) (N: class) (X Y: class r):
  $ wcel N cz $ >
  $ wcel D cz $ >
  $ wne D cc0 $ >
  $ wceq S (crab r (wbr D (co N (cv r) cmin) cdvds) cn0) $ >
  $ wi (wa (wa (wcel X S) (wcel Y S)) (wa (wbr X (cfv D cabs) clt) (wbr Y (cfv D cabs) clt))) (wi (wcel K cz) (wi (wceq (co K (cfv D cabs) cmul) (co Y X cmin)) (wceq X Y))) $;

--| Lemma for ~ divalg . (Contributed by Paul Chapman, 21-Mar-2011.) (Revised by AV, 2-Oct-2020.)
theorem divalglem9 {x3 r: setvar} (D: class) (R S: class r) (N: class):
  $ wcel N cz $ >
  $ wcel D cz $ >
  $ wne D cc0 $ >
  $ wceq S (crab r (wbr D (co N (cv r) cmin) cdvds) cn0) $ >
  $ wceq R (cinf S cr clt) $ >
  $ wreu x3 (wbr (cv x3) (cfv D cabs) clt) S $;

--| Lemma for ~ divalg . (Contributed by Paul Chapman, 21-Mar-2011.) (Proof shortened by AV, 2-Oct-2020.)
theorem divalglem10 {r q: setvar} (D: class) (S: class r q) (N: class):
  $ wcel N cz $ >
  $ wcel D cz $ >
  $ wne D cc0 $ >
  $ wceq S (crab r (wbr D (co N (cv r) cmin) cdvds) cn0) $ >
  $ wreu r (wrex q (w3a (wbr cc0 (cv r) cle) (wbr (cv r) (cfv D cabs) clt) (wceq N (co (co (cv q) D cmul) (cv r) caddc))) cz) cz $;

--| The division algorithm (theorem). Dividing an integer ` N ` by a nonzero integer ` D ` produces a (unique) quotient ` q ` and a unique remainder ` 0 <_ r < ( abs `` D ) ` . Theorem 1.14 in [ApostolNT] p. 19. The proof does not use ` / ` or ` |_ ` or ` mod ` . (Contributed by Paul Chapman, 21-Mar-2011.)
theorem divalg {r q: setvar} (D N: class):
  $ wi (w3a (wcel N cz) (wcel D cz) (wne D cc0)) (wreu r (wrex q (w3a (wbr cc0 (cv r) cle) (wbr (cv r) (cfv D cabs) clt) (wceq N (co (co (cv q) D cmul) (cv r) caddc))) cz) cz) $;

--| Express the division algorithm as stated in ~ divalg in terms of ` || ` . (Contributed by Paul Chapman, 31-Mar-2011.)
theorem divalgb {r q: setvar} (D N: class):
  $ wi (w3a (wcel N cz) (wcel D cz) (wne D cc0)) (wb (wreu r (wrex q (w3a (wbr cc0 (cv r) cle) (wbr (cv r) (cfv D cabs) clt) (wceq N (co (co (cv q) D cmul) (cv r) caddc))) cz) cz) (wreu r (wa (wbr (cv r) (cfv D cabs) clt) (wbr D (co N (cv r) cmin) cdvds)) cn0)) $;

--| The division algorithm (theorem) for a positive divisor. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem divalg2 {r: setvar} (D N: class):
  $ wi (wa (wcel N cz) (wcel D cn)) (wreu r (wa (wbr (cv r) D clt) (wbr D (co N (cv r) cmin) cdvds)) cn0) $;

--| The result of the ` mod ` operator satisfies the requirements for the remainder ` R ` in the division algorithm for a positive divisor (compare ~ divalg2 and ~ divalgb ). This demonstration theorem justifies the use of ` mod ` to yield an explicit remainder from this point forward. (Contributed by Paul Chapman, 31-Mar-2011.) (Revised by AV, 21-Aug-2021.)
theorem divalgmod (D R N: class):
  $ wi (wa (wcel N cz) (wcel D cn)) (wb (wceq R (co N D cmo)) (wa (wcel R cn0) (wa (wbr R D clt) (wbr D (co N R cmin) cdvds)))) $;

--| The result of the ` mod ` operator satisfies the requirements for the remainder ` R ` in the division algorithm for a positive divisor. Variant of ~ divalgmod . (Contributed by Stefan O'Rear, 17-Oct-2014.) (Proof shortened by AV, 21-Aug-2021.)
theorem divalgmodcl (D R N: class):
  $ wi (w3a (wcel N cz) (wcel D cn) (wcel R cn0)) (wb (wceq R (co N D cmo)) (wa (wbr R D clt) (wbr D (co N R cmin) cdvds))) $;

--| The result of the modulo operation is the remainder of the division algorithm. (Contributed by AV, 19-Aug-2021.)
theorem modremain {z: setvar} (D R N: class):
  $ wi (w3a (wcel N cz) (wcel D cn) (wa (wcel R cn0) (wbr R D clt))) (wb (wceq (co N D cmo) R) (wrex z (wceq (co (co (cv z) D cmul) R caddc) N) cz)) $;

--| Corollary of the division algorithm. If an integer ` D ` greater than ` 1 ` divides ` N ` , then it does not divide any of ` N - 1 ` , ` N - 2 ` ... ` N - ( D - 1 ) ` . (Contributed by Paul Chapman, 31-Mar-2011.)
theorem ndvdssub (D K N: class):
  $ wi (w3a (wcel N cz) (wcel D cn) (wa (wcel K cn) (wbr K D clt))) (wi (wbr D N cdvds) (wn (wbr D (co N K cmin) cdvds))) $;

--| Corollary of the division algorithm. If an integer ` D ` greater than ` 1 ` divides ` N ` , then it does not divide any of ` N + 1 ` , ` N + 2 ` ... ` N + ( D - 1 ) ` . (Contributed by Paul Chapman, 31-Mar-2011.)
theorem ndvdsadd (D K N: class):
  $ wi (w3a (wcel N cz) (wcel D cn) (wa (wcel K cn) (wbr K D clt))) (wi (wbr D N cdvds) (wn (wbr D (co N K caddc) cdvds))) $;

--| Special case of ~ ndvdsadd . If an integer ` D ` greater than ` 1 ` divides ` N ` , it does not divide ` N + 1 ` . (Contributed by Paul Chapman, 31-Mar-2011.)
theorem ndvdsp1 (D N: class):
  $ wi (w3a (wcel N cz) (wcel D cn) (wbr c1 D clt)) (wi (wbr D N cdvds) (wn (wbr D (co N c1 caddc) cdvds))) $;

--| A quick test for non-divisibility. (Contributed by Mario Carneiro, 18-Feb-2014.)
theorem ndvdsi (A2 B2 Q R: class):
  $ wcel A2 cn $ >
  $ wcel Q cn0 $ >
  $ wcel R cn $ >
  $ wceq (co (co A2 Q cmul) R caddc) B2 $ >
  $ wbr R A2 clt $ >
  $ wn (wbr A2 B2 cdvds) $;

--| 5 does not divide 3. (Contributed by AV, 8-Sep-2025.)
theorem _5ndvds3:
  $ wn (wbr c5 c3 cdvds) $;

--| 5 does not divide 6. (Contributed by AV, 8-Sep-2025.)
theorem _5ndvds6:
  $ wn (wbr c5 c6 cdvds) $;

--| The floor of an odd integer divided by 4. (Contributed by AV, 17-Jun-2021.)
theorem flodddiv4 (M N: class):
  $ wi (wa (wcel M cz) (wceq N (co (co c2 M cmul) c1 caddc))) (wceq (cfv (co N c4 cdiv) cfl) (cif (wbr c2 M cdvds) (co M c2 cdiv) (co (co M c1 cmin) c2 cdiv))) $;

--| The floor of an integer divided by a nonzero integer not dividing the first integer is less than the integer divided by the positive integer. (Contributed by AV, 4-Jul-2021.)
theorem fldivndvdslt (K L: class):
  $ wi (w3a (wcel K cz) (wa (wcel L cz) (wne L cc0)) (wn (wbr L K cdvds))) (wbr (cfv (co K L cdiv) cfl) (co K L cdiv) clt) $;

--| The floor of an odd number divided by 4 is less than the odd number divided by 4. (Contributed by AV, 4-Jul-2021.)
theorem flodddiv4lt (N: class):
  $ wi (wa (wcel N cz) (wn (wbr c2 N cdvds))) (wbr (cfv (co N c4 cdiv) cfl) (co N c4 cdiv) clt) $;

--| The floor of an odd number divided by 4, multiplied by 2 is less than the half of the odd number. (Contributed by AV, 4-Jul-2021.) (Proof shortened by AV, 10-Jul-2022.)
theorem flodddiv4t2lthalf (N: class):
  $ wi (wa (wcel N cz) (wn (wbr c2 N cdvds))) (wbr (co (cfv (co N c4 cdiv) cfl) c2 cmul) (co N c2 cdiv) clt) $;

--| Define the binary bits of an integer.
term cbits: class;

--| Define the sequence addition on bit sequences.
term csad: class;

--| Define the sequence multiplication on bit sequences.
term csmu: class;

--| Define the binary bits of an integer. The expression ` M e. ( bits `` N ) ` means that the ` M ` -th bit of ` N ` is 1 (and its negation means the bit is 0). (Contributed by Mario Carneiro, 4-Sep-2016.)
axiom df_bits {m n: setvar}:
  $ wceq cbits (cmpt n cz (crab m (wn (wbr c2 (cfv (co (cv n) (co c2 (cv m) cexp) cdiv) cfl) cdvds)) cn0)) $;

--| Expand the definition of the bits of an integer. (Contributed by Mario Carneiro, 5-Sep-2016.)
theorem bitsfval {m: setvar} (N: class):
  $ wi (wcel N cz) (wceq (cfv N cbits) (crab m (wn (wbr c2 (cfv (co N (co c2 (cv m) cexp) cdiv) cfl) cdvds)) cn0)) $;

--| Expand the definition of the bits of an integer. (Contributed by Mario Carneiro, 5-Sep-2016.)
theorem bitsval (M N: class):
  $ wb (wcel M (cfv N cbits)) (w3a (wcel N cz) (wcel M cn0) (wn (wbr c2 (cfv (co N (co c2 M cexp) cdiv) cfl) cdvds))) $;

--| Expand the definition of the bits of an integer. (Contributed by Mario Carneiro, 5-Sep-2016.)
theorem bitsval2 (M N: class):
  $ wi (wa (wcel N cz) (wcel M cn0)) (wb (wcel M (cfv N cbits)) (wn (wbr c2 (cfv (co N (co c2 M cexp) cdiv) cfl) cdvds))) $;

--| The set of bits of an integer is a subset of ` NN0 ` . (Contributed by Mario Carneiro, 5-Sep-2016.)
theorem bitsss (N: class):
  $ wss (cfv N cbits) cn0 $;

--| The ` bits ` function is a function from integers to subsets of nonnegative integers. (Contributed by Mario Carneiro, 5-Sep-2016.)
theorem bitsf:
  $ wf cz (cpw cn0) cbits $;

--| Value of the zeroth bit. (Contributed by Mario Carneiro, 5-Sep-2016.)
theorem bits0 (N: class):
  $ wi (wcel N cz) (wb (wcel cc0 (cfv N cbits)) (wn (wbr c2 N cdvds))) $;

--| The zeroth bit of an even number is zero. (Contributed by Mario Carneiro, 5-Sep-2016.)
theorem bits0e (N: class):
  $ wi (wcel N cz) (wn (wcel cc0 (cfv (co c2 N cmul) cbits))) $;

--| The zeroth bit of an odd number is one. (Contributed by Mario Carneiro, 5-Sep-2016.)
theorem bits0o (N: class):
  $ wi (wcel N cz) (wcel cc0 (cfv (co (co c2 N cmul) c1 caddc) cbits)) $;

--| The ` M + 1 ` -th bit of ` N ` is the ` M ` -th bit of ` |_ ( N / 2 ) ` . (Contributed by Mario Carneiro, 5-Sep-2016.)
theorem bitsp1 (M N: class):
  $ wi (wa (wcel N cz) (wcel M cn0)) (wb (wcel (co M c1 caddc) (cfv N cbits)) (wcel M (cfv (cfv (co N c2 cdiv) cfl) cbits))) $;

--| The ` M + 1 ` -th bit of ` 2 N ` is the ` M ` -th bit of ` N ` . (Contributed by Mario Carneiro, 5-Sep-2016.)
theorem bitsp1e (M N: class):
  $ wi (wa (wcel N cz) (wcel M cn0)) (wb (wcel (co M c1 caddc) (cfv (co c2 N cmul) cbits)) (wcel M (cfv N cbits))) $;

--| The ` M + 1 ` -th bit of ` 2 N + 1 ` is the ` M ` -th bit of ` N ` . (Contributed by Mario Carneiro, 5-Sep-2016.)
theorem bitsp1o (M N: class):
  $ wi (wa (wcel N cz) (wcel M cn0)) (wb (wcel (co M c1 caddc) (cfv (co (co c2 N cmul) c1 caddc) cbits)) (wcel M (cfv N cbits))) $;

--| Lemma for ~ bitsfzo . (Contributed by Mario Carneiro, 5-Sep-2016.) (Revised by AV, 1-Oct-2020.)
theorem bitsfzolem {n: setvar} (ph: wff n) (S M: class n) (N: class):
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wss (cfv N cbits) (co cc0 M cfzo)) $ >
  $ wceq S (cinf (crab n (wbr N (co c2 (cv n) cexp) clt) cn0) cr clt) $ >
  $ wi ph (wcel N (co cc0 (co c2 M cexp) cfzo)) $;

--| The bits of a number are all at positions less than ` M ` iff the number is nonnegative and less than ` 2 ^ M ` . (Contributed by Mario Carneiro, 5-Sep-2016.) (Proof shortened by AV, 1-Oct-2020.)
theorem bitsfzo (M N: class):
  $ wi (wa (wcel N cz) (wcel M cn0)) (wb (wcel N (co cc0 (co c2 M cexp) cfzo)) (wss (cfv N cbits) (co cc0 M cfzo))) $;

--| Truncating the bit sequence after some ` M ` is equivalent to reducing the argument ` mod 2 ^ M ` . (Contributed by Mario Carneiro, 6-Sep-2016.)
theorem bitsmod (M N: class):
  $ wi (wa (wcel N cz) (wcel M cn0)) (wceq (cfv (co N (co c2 M cexp) cmo) cbits) (cin (cfv N cbits) (co cc0 M cfzo))) $;

--| Every number is associated with a finite set of bits. (Contributed by Mario Carneiro, 5-Sep-2016.)
theorem bitsfi (N: class):
  $ wi (wcel N cn0) (wcel (cfv N cbits) cfn) $;

--| The bit complement of ` N ` is ` -u N - 1 ` . (Thus, by ~ bitsfi , all negative numbers have cofinite ` bits ` representations.) (Contributed by Mario Carneiro, 5-Sep-2016.)
theorem bitscmp (N: class):
  $ wi (wcel N cz) (wceq (cdif cn0 (cfv N cbits)) (cfv (co (cneg N) c1 cmin) cbits)) $;

--| The bits of zero. (Contributed by Mario Carneiro, 6-Sep-2016.)
theorem _0bits:
  $ wceq (cfv cc0 cbits) c0 $;

--| The bits of negative one. (Contributed by Mario Carneiro, 5-Sep-2016.)
theorem m1bits:
  $ wceq (cfv (cneg c1) cbits) cn0 $;

--| Lemma for ~ bitsinv1 . (Contributed by Mario Carneiro, 22-Sep-2016.)
theorem bitsinv1lem (M N: class):
  $ wi (wa (wcel N cz) (wcel M cn0)) (wceq (co N (co c2 (co M c1 caddc) cexp) cmo) (co (co N (co c2 M cexp) cmo) (cif (wcel M (cfv N cbits)) (co c2 M cexp) cc0) caddc)) $;

--| There is an explicit inverse to the ` bits ` function for nonnegative integers (which can be extended to negative integers using ~ bitscmp ), part 1. (Contributed by Mario Carneiro, 7-Sep-2016.)
theorem bitsinv1 {n: setvar} (N: class):
  $ wi (wcel N cn0) (wceq (csu n (cfv N cbits) (co c2 (cv n) cexp)) N) $;

--| There is an explicit inverse to the ` bits ` function for nonnegative integers, part 2. (Contributed by Mario Carneiro, 8-Sep-2016.)
theorem bitsinv2 {n: setvar} (A2: class):
  $ wi (wcel A2 (cin (cpw cn0) cfn)) (wceq (cfv (csu n A2 (co c2 (cv n) cexp)) cbits) A2) $;

--| The ` bits ` function restricted to nonnegative integers is a bijection from the integers to the finite sets of integers. It is in fact the inverse of the Ackermann bijection ~ ackbijnn . (Contributed by Mario Carneiro, 8-Sep-2016.)
theorem bitsf1ocnv {x3 n: setvar}:
  $ wa (wf1o cn0 (cin (cpw cn0) cfn) (cres cbits cn0)) (wceq (ccnv (cres cbits cn0)) (cmpt x3 (cin (cpw cn0) cfn) (csu n (cv x3) (co c2 (cv n) cexp)))) $;

--| The ` bits ` function restricted to nonnegative integers is a bijection from the integers to the finite sets of integers. It is in fact the inverse of the Ackermann bijection ~ ackbijnn . (Contributed by Mario Carneiro, 8-Sep-2016.)
theorem bitsf1o:
  $ wf1o cn0 (cin (cpw cn0) cfn) (cres cbits cn0) $;

--| The ` bits ` function is an injection from ` ZZ ` to ` ~P NN0 ` . It is obviously not a bijection (by Cantor's theorem ~ canth2 ), and in fact its range is the set of finite and cofinite subsets of ` NN0 ` . (Contributed by Mario Carneiro, 22-Sep-2016.)
theorem bitsf1:
  $ wf1 cz (cpw cn0) cbits $;

--| The bits of a power of two. (Contributed by Mario Carneiro, 5-Sep-2016.)
theorem _2ebits (N: class):
  $ wi (wcel N cn0) (wceq (cfv (co c2 N cexp) cbits) (csn N)) $;

--| The inverse of the ` bits ` function. (Contributed by Mario Carneiro, 8-Sep-2016.)
theorem bitsinv {k: setvar} (A2: class) (K: class k):
  $ wceq K (ccnv (cres cbits cn0)) $ >
  $ wi (wcel A2 (cin (cpw cn0) cfn)) (wceq (cfv A2 K) (csu k A2 (co c2 (cv k) cexp))) $;

--| Recursive definition of the inverse of the ` bits ` function. (Contributed by Mario Carneiro, 8-Sep-2016.)
theorem bitsinvp1 (A2 K N: class):
  $ wceq K (ccnv (cres cbits cn0)) $ >
  $ wi (wa (wss A2 cn0) (wcel N cn0)) (wceq (cfv (cin A2 (co cc0 (co N c1 caddc) cfzo)) K) (co (cfv (cin A2 (co cc0 N cfzo)) K) (cif (wcel N A2) (co c2 N cexp) cc0) caddc)) $;

--| The core of the proof of ~ sadadd2 . The intuitive justification for this is that ` cadd ` is true if at least two arguments are true, and ` hadd ` is true if an odd number of arguments are true, so altogether the result is ` n x. A ` where ` n ` is the number of true arguments, which is equivalently obtained by adding together one ` A ` for each true argument, on the right side. (Contributed by Mario Carneiro, 8-Sep-2016.)
theorem sadadd2lem2 (ph ps ch: wff) (A2: class):
  $ wi (wcel A2 cc) (wceq (co (cif (whad ph ps ch) A2 cc0) (cif (wcad ph ps ch) (co c2 A2 cmul) cc0) caddc) (co (co (cif ph A2 cc0) (cif ps A2 cc0) caddc) (cif ch A2 cc0) caddc)) $;

--| Define the addition of two bit sequences, using ~ df-had and ~ df-cad bit operations. (Contributed by Mario Carneiro, 5-Sep-2016.)
axiom df_sad {x3 y1 k m n c: setvar}:
  $ wceq csad (cmpo x3 y1 (cpw cn0) (cpw cn0) (crab k (whad (wcel (cv k) (cv x3)) (wcel (cv k) (cv y1)) (wcel c0 (cfv (cv k) (cseq (cmpo c m c2o cn0 (cif (wcad (wcel (cv m) (cv x3)) (wcel (cv m) (cv y1)) (wcel c0 (cv c))) c1o c0)) (cmpt n cn0 (cif (wceq (cv n) cc0) c0 (co (cv n) c1 cmin))) cc0)))) cn0)) $;

--| Define the addition of two bit sequences, using ~ df-had and ~ df-cad bit operations. (Contributed by Mario Carneiro, 5-Sep-2016.)
theorem sadfval {k m n c: setvar} (ph: wff m n c) (A2 B2: class n) (C: class m n c):
  $ wi ph (wss A2 cn0) $ >
  $ wi ph (wss B2 cn0) $ >
  $ wceq C (cseq (cmpo c m c2o cn0 (cif (wcad (wcel (cv m) A2) (wcel (cv m) B2) (wcel c0 (cv c))) c1o c0)) (cmpt n cn0 (cif (wceq (cv n) cc0) c0 (co (cv n) c1 cmin))) cc0) $ >
  $ wi ph (wceq (co A2 B2 csad) (crab k (whad (wcel (cv k) A2) (wcel (cv k) B2) (wcel c0 (cfv (cv k) C))) cn0)) $;

--| The carry sequence is a sequence of elements of ` 2o ` encoding a "sequence of wffs". (Contributed by Mario Carneiro, 5-Sep-2016.)
theorem sadcf {m n c: setvar} (ph: wff m n c) (A2 B2: class n) (C: class m n c):
  $ wi ph (wss A2 cn0) $ >
  $ wi ph (wss B2 cn0) $ >
  $ wceq C (cseq (cmpo c m c2o cn0 (cif (wcad (wcel (cv m) A2) (wcel (cv m) B2) (wcel c0 (cv c))) c1o c0)) (cmpt n cn0 (cif (wceq (cv n) cc0) c0 (co (cv n) c1 cmin))) cc0) $ >
  $ wi ph (wf cn0 c2o C) $;

--| The initial element of the carry sequence is ` F. ` . (Contributed by Mario Carneiro, 5-Sep-2016.)
theorem sadc0 {m n c: setvar} (ph: wff m n c) (A2 B2: class n) (C: class m n c):
  $ wi ph (wss A2 cn0) $ >
  $ wi ph (wss B2 cn0) $ >
  $ wceq C (cseq (cmpo c m c2o cn0 (cif (wcad (wcel (cv m) A2) (wcel (cv m) B2) (wcel c0 (cv c))) c1o c0)) (cmpt n cn0 (cif (wceq (cv n) cc0) c0 (co (cv n) c1 cmin))) cc0) $ >
  $ wi ph (wn (wcel c0 (cfv cc0 C))) $;

--| The carry sequence (which is a sequence of wffs, encoded as ` 1o ` and ` (/) ` ) is defined recursively as the carry operation applied to the previous carry and the two current inputs. (Contributed by Mario Carneiro, 5-Sep-2016.)
theorem sadcp1 {m n c: setvar} (ph: wff m n c) (A2 B2: class n) (C: class m n c) (N: class m c):
  $ wi ph (wss A2 cn0) $ >
  $ wi ph (wss B2 cn0) $ >
  $ wceq C (cseq (cmpo c m c2o cn0 (cif (wcad (wcel (cv m) A2) (wcel (cv m) B2) (wcel c0 (cv c))) c1o c0)) (cmpt n cn0 (cif (wceq (cv n) cc0) c0 (co (cv n) c1 cmin))) cc0) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wb (wcel c0 (cfv (co N c1 caddc) C)) (wcad (wcel N A2) (wcel N B2) (wcel c0 (cfv N C)))) $;

--| The full adder sequence is the half adder function applied to the inputs and the carry sequence. (Contributed by Mario Carneiro, 5-Sep-2016.)
theorem sadval {m n c: setvar} (ph: wff m n c) (A2 B2: class n) (C: class m n c) (N: class m c):
  $ wi ph (wss A2 cn0) $ >
  $ wi ph (wss B2 cn0) $ >
  $ wceq C (cseq (cmpo c m c2o cn0 (cif (wcad (wcel (cv m) A2) (wcel (cv m) B2) (wcel c0 (cv c))) c1o c0)) (cmpt n cn0 (cif (wceq (cv n) cc0) c0 (co (cv n) c1 cmin))) cc0) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wb (wcel N (co A2 B2 csad)) (whad (wcel N A2) (wcel N B2) (wcel c0 (cfv N C)))) $;

--| Lemma for ~ sadcadd . (Contributed by Mario Carneiro, 8-Sep-2016.)
theorem sadcaddlem {m n c: setvar} (ph: wff m n c) (A2 B2: class n) (C K: class m n c) (N: class m c):
  $ wi ph (wss A2 cn0) $ >
  $ wi ph (wss B2 cn0) $ >
  $ wceq C (cseq (cmpo c m c2o cn0 (cif (wcad (wcel (cv m) A2) (wcel (cv m) B2) (wcel c0 (cv c))) c1o c0)) (cmpt n cn0 (cif (wceq (cv n) cc0) c0 (co (cv n) c1 cmin))) cc0) $ >
  $ wi ph (wcel N cn0) $ >
  $ wceq K (ccnv (cres cbits cn0)) $ >
  $ wi ph (wb (wcel c0 (cfv N C)) (wbr (co c2 N cexp) (co (cfv (cin A2 (co cc0 N cfzo)) K) (cfv (cin B2 (co cc0 N cfzo)) K) caddc) cle)) $ >
  $ wi ph (wb (wcel c0 (cfv (co N c1 caddc) C)) (wbr (co c2 (co N c1 caddc) cexp) (co (cfv (cin A2 (co cc0 (co N c1 caddc) cfzo)) K) (cfv (cin B2 (co cc0 (co N c1 caddc) cfzo)) K) caddc) cle)) $;

--| Non-recursive definition of the carry sequence. (Contributed by Mario Carneiro, 8-Sep-2016.)
theorem sadcadd {m n c: setvar} (ph: wff m n c) (A2 B2: class n) (C K: class m n c) (N: class m c):
  $ wi ph (wss A2 cn0) $ >
  $ wi ph (wss B2 cn0) $ >
  $ wceq C (cseq (cmpo c m c2o cn0 (cif (wcad (wcel (cv m) A2) (wcel (cv m) B2) (wcel c0 (cv c))) c1o c0)) (cmpt n cn0 (cif (wceq (cv n) cc0) c0 (co (cv n) c1 cmin))) cc0) $ >
  $ wi ph (wcel N cn0) $ >
  $ wceq K (ccnv (cres cbits cn0)) $ >
  $ wi ph (wb (wcel c0 (cfv N C)) (wbr (co c2 N cexp) (co (cfv (cin A2 (co cc0 N cfzo)) K) (cfv (cin B2 (co cc0 N cfzo)) K) caddc) cle)) $;

--| Lemma for ~ sadadd2 . (Contributed by Mario Carneiro, 9-Sep-2016.)
theorem sadadd2lem {m n c: setvar} (ph: wff m n c) (A2 B2: class n) (C K: class m n c) (N: class m c):
  $ wi ph (wss A2 cn0) $ >
  $ wi ph (wss B2 cn0) $ >
  $ wceq C (cseq (cmpo c m c2o cn0 (cif (wcad (wcel (cv m) A2) (wcel (cv m) B2) (wcel c0 (cv c))) c1o c0)) (cmpt n cn0 (cif (wceq (cv n) cc0) c0 (co (cv n) c1 cmin))) cc0) $ >
  $ wi ph (wcel N cn0) $ >
  $ wceq K (ccnv (cres cbits cn0)) $ >
  $ wi ph (wceq (co (cfv (cin (co A2 B2 csad) (co cc0 N cfzo)) K) (cif (wcel c0 (cfv N C)) (co c2 N cexp) cc0) caddc) (co (cfv (cin A2 (co cc0 N cfzo)) K) (cfv (cin B2 (co cc0 N cfzo)) K) caddc)) $ >
  $ wi ph (wceq (co (cfv (cin (co A2 B2 csad) (co cc0 (co N c1 caddc) cfzo)) K) (cif (wcel c0 (cfv (co N c1 caddc) C)) (co c2 (co N c1 caddc) cexp) cc0) caddc) (co (cfv (cin A2 (co cc0 (co N c1 caddc) cfzo)) K) (cfv (cin B2 (co cc0 (co N c1 caddc) cfzo)) K) caddc)) $;

--| Sum of initial segments of the ` sadd ` sequence. (Contributed by Mario Carneiro, 8-Sep-2016.)
theorem sadadd2 {m n c: setvar} (ph: wff m n c) (A2 B2: class n) (C K: class m n c) (N: class m c):
  $ wi ph (wss A2 cn0) $ >
  $ wi ph (wss B2 cn0) $ >
  $ wceq C (cseq (cmpo c m c2o cn0 (cif (wcad (wcel (cv m) A2) (wcel (cv m) B2) (wcel c0 (cv c))) c1o c0)) (cmpt n cn0 (cif (wceq (cv n) cc0) c0 (co (cv n) c1 cmin))) cc0) $ >
  $ wi ph (wcel N cn0) $ >
  $ wceq K (ccnv (cres cbits cn0)) $ >
  $ wi ph (wceq (co (cfv (cin (co A2 B2 csad) (co cc0 N cfzo)) K) (cif (wcel c0 (cfv N C)) (co c2 N cexp) cc0) caddc) (co (cfv (cin A2 (co cc0 N cfzo)) K) (cfv (cin B2 (co cc0 N cfzo)) K) caddc)) $;

--| Sum of initial segments of the ` sadd ` sequence. (Contributed by Mario Carneiro, 9-Sep-2016.)
theorem sadadd3 {m n c: setvar} (ph: wff m n c) (A2 B2: class n) (C K: class m n c) (N: class m c):
  $ wi ph (wss A2 cn0) $ >
  $ wi ph (wss B2 cn0) $ >
  $ wceq C (cseq (cmpo c m c2o cn0 (cif (wcad (wcel (cv m) A2) (wcel (cv m) B2) (wcel c0 (cv c))) c1o c0)) (cmpt n cn0 (cif (wceq (cv n) cc0) c0 (co (cv n) c1 cmin))) cc0) $ >
  $ wi ph (wcel N cn0) $ >
  $ wceq K (ccnv (cres cbits cn0)) $ >
  $ wi ph (wceq (co (cfv (cin (co A2 B2 csad) (co cc0 N cfzo)) K) (co c2 N cexp) cmo) (co (co (cfv (cin A2 (co cc0 N cfzo)) K) (cfv (cin B2 (co cc0 N cfzo)) K) caddc) (co c2 N cexp) cmo)) $;

--| The sum of two sequences is a sequence. (Contributed by Mario Carneiro, 5-Sep-2016.)
theorem sadcl (A2 B2: class):
  $ wi (wa (wss A2 cn0) (wss B2 cn0)) (wss (co A2 B2 csad) cn0) $;

--| The adder sequence function is commutative. (Contributed by Mario Carneiro, 5-Sep-2016.)
theorem sadcom (A2 B2: class):
  $ wi (wa (wss A2 cn0) (wss B2 cn0)) (wceq (co A2 B2 csad) (co B2 A2 csad)) $;

--| Lemma for ~ sadadd . (Contributed by Mario Carneiro, 9-Sep-2016.)
theorem saddisjlem {m n c: setvar} (ph: wff m n c) (A2 B2: class n) (C: class m n c) (N: class m c):
  $ wi ph (wss A2 cn0) $ >
  $ wi ph (wss B2 cn0) $ >
  $ wi ph (wceq (cin A2 B2) c0) $ >
  $ wceq C (cseq (cmpo c m c2o cn0 (cif (wcad (wcel (cv m) A2) (wcel (cv m) B2) (wcel c0 (cv c))) c1o c0)) (cmpt n cn0 (cif (wceq (cv n) cc0) c0 (co (cv n) c1 cmin))) cc0) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wb (wcel N (co A2 B2 csad)) (wcel N (cun A2 B2))) $;

--| The sum of disjoint sequences is the union of the sequences. (In this case, there are no carried bits.) (Contributed by Mario Carneiro, 9-Sep-2016.)
theorem saddisj (ph: wff) (A2 B2: class):
  $ wi ph (wss A2 cn0) $ >
  $ wi ph (wss B2 cn0) $ >
  $ wi ph (wceq (cin A2 B2) c0) $ >
  $ wi ph (wceq (co A2 B2 csad) (cun A2 B2)) $;

--| Lemma for ~ sadadd . (Contributed by Mario Carneiro, 9-Sep-2016.)
theorem sadaddlem {m n c: setvar} (ph: wff m n c) (A2 B2: class n) (C K: class m n c) (N: class m c):
  $ wceq C (cseq (cmpo c m c2o cn0 (cif (wcad (wcel (cv m) (cfv A2 cbits)) (wcel (cv m) (cfv B2 cbits)) (wcel c0 (cv c))) c1o c0)) (cmpt n cn0 (cif (wceq (cv n) cc0) c0 (co (cv n) c1 cmin))) cc0) $ >
  $ wceq K (ccnv (cres cbits cn0)) $ >
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wcel B2 cz) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (cin (co (cfv A2 cbits) (cfv B2 cbits) csad) (co cc0 N cfzo)) (cfv (co (co A2 B2 caddc) (co c2 N cexp) cmo) cbits)) $;

--| For sequences that correspond to valid integers, the adder sequence function produces the sequence for the sum. This is effectively a proof of the correctness of the ripple carry adder, implemented with logic gates corresponding to ~ df-had and ~ df-cad . It is interesting to consider in what sense the ` sadd ` function can be said to be "adding" things outside the range of the ` bits ` function, that is, when adding sequences that are not eventually constant and so do not denote any integer. The correct interpretation is that the sequences are representations of 2-adic integers, which have a natural ring structure. (Contributed by Mario Carneiro, 9-Sep-2016.)
theorem sadadd (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cz)) (wceq (co (cfv A2 cbits) (cfv B2 cbits) csad) (cfv (co A2 B2 caddc) cbits)) $;

--| The adder sequence function has a left identity, the empty set, which is the representation of the integer zero. (Contributed by Mario Carneiro, 9-Sep-2016.)
theorem sadid1 (A2: class):
  $ wi (wss A2 cn0) (wceq (co A2 c0 csad) A2) $;

--| The adder sequence function has a right identity, the empty set, which is the representation of the integer zero. (Contributed by Mario Carneiro, 9-Sep-2016.)
theorem sadid2 (A2: class):
  $ wi (wss A2 cn0) (wceq (co c0 A2 csad) A2) $;

--| Lemma for ~ sadass . (Contributed by Mario Carneiro, 9-Sep-2016.)
theorem sadasslem (ph: wff) (A2 B2 C N: class):
  $ wi ph (wss A2 cn0) $ >
  $ wi ph (wss B2 cn0) $ >
  $ wi ph (wss C cn0) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (cin (co (co A2 B2 csad) C csad) (co cc0 N cfzo)) (cin (co A2 (co B2 C csad) csad) (co cc0 N cfzo))) $;

--| Sequence addition is associative. (Contributed by Mario Carneiro, 9-Sep-2016.)
theorem sadass (A2 B2 C: class):
  $ wi (w3a (wss A2 cn0) (wss B2 cn0) (wss C cn0)) (wceq (co (co A2 B2 csad) C csad) (co A2 (co B2 C csad) csad)) $;

--| Any element of a sequence sum only depends on the values of the argument sequences up to and including that point. (Contributed by Mario Carneiro, 9-Sep-2016.)
theorem sadeq (ph: wff) (A2 B2 N: class):
  $ wi ph (wss A2 cn0) $ >
  $ wi ph (wss B2 cn0) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (cin (co A2 B2 csad) (co cc0 N cfzo)) (cin (co (cin A2 (co cc0 N cfzo)) (cin B2 (co cc0 N cfzo)) csad) (co cc0 N cfzo))) $;

--| Restrict the bits of a number to an upper integer set. (Contributed by Mario Carneiro, 5-Sep-2016.)
theorem bitsres (A2 N: class):
  $ wi (wa (wcel A2 cz) (wcel N cn0)) (wceq (cin (cfv A2 cbits) (cfv N cuz)) (cfv (co (cfv (co A2 (co c2 N cexp) cdiv) cfl) (co c2 N cexp) cmul) cbits)) $;

--| The bits of a number are all at least ` N ` iff the number is divisible by ` 2 ^ N ` . (Contributed by Mario Carneiro, 21-Sep-2016.)
theorem bitsuz (A2 N: class):
  $ wi (wa (wcel A2 cz) (wcel N cn0)) (wb (wbr (co c2 N cexp) A2 cdvds) (wss (cfv A2 cbits) (cfv N cuz))) $;

--| Shifting a bit sequence to the left (toward the more significant bits) causes the number to be multiplied by a power of two. (Contributed by Mario Carneiro, 22-Sep-2016.)
theorem bitsshft {n: setvar} (A2 N: class):
  $ wi (wa (wcel A2 cz) (wcel N cn0)) (wceq (crab n (wcel (co (cv n) N cmin) (cfv A2 cbits)) cn0) (cfv (co A2 (co c2 N cexp) cmul) cbits)) $;

--| Define the multiplication of two bit sequences, using repeated sequence addition. (Contributed by Mario Carneiro, 9-Sep-2016.)
axiom df_smu {x3 y1 k m n p: setvar}:
  $ wceq csmu (cmpo x3 y1 (cpw cn0) (cpw cn0) (crab k (wcel (cv k) (cfv (co (cv k) c1 caddc) (cseq (cmpo p m (cpw cn0) cn0 (co (cv p) (crab n (wa (wcel (cv m) (cv x3)) (wcel (co (cv n) (cv m) cmin) (cv y1))) cn0) csad)) (cmpt n cn0 (cif (wceq (cv n) cc0) c0 (co (cv n) c1 cmin))) cc0))) cn0)) $;

--| The multiplication of two bit sequences as repeated sequence addition. (Contributed by Mario Carneiro, 9-Sep-2016.)
theorem smufval {k m n p: setvar} (ph: wff m p) (A2 B2: class) (P: class m n p):
  $ wi ph (wss A2 cn0) $ >
  $ wi ph (wss B2 cn0) $ >
  $ wceq P (cseq (cmpo p m (cpw cn0) cn0 (co (cv p) (crab n (wa (wcel (cv m) A2) (wcel (co (cv n) (cv m) cmin) B2)) cn0) csad)) (cmpt n cn0 (cif (wceq (cv n) cc0) c0 (co (cv n) c1 cmin))) cc0) $ >
  $ wi ph (wceq (co A2 B2 csmu) (crab k (wcel (cv k) (cfv (co (cv k) c1 caddc) P)) cn0)) $;

--| The sequence of partial sums of the sequence multiplication. (Contributed by Mario Carneiro, 9-Sep-2016.)
theorem smupf {m n p: setvar} (ph: wff m p) (A2 B2: class) (P: class m n p):
  $ wi ph (wss A2 cn0) $ >
  $ wi ph (wss B2 cn0) $ >
  $ wceq P (cseq (cmpo p m (cpw cn0) cn0 (co (cv p) (crab n (wa (wcel (cv m) A2) (wcel (co (cv n) (cv m) cmin) B2)) cn0) csad)) (cmpt n cn0 (cif (wceq (cv n) cc0) c0 (co (cv n) c1 cmin))) cc0) $ >
  $ wi ph (wf cn0 (cpw cn0) P) $;

--| The initial element of the partial sum sequence. (Contributed by Mario Carneiro, 9-Sep-2016.)
theorem smup0 {m n p: setvar} (ph: wff m p) (A2 B2: class) (P: class m n p):
  $ wi ph (wss A2 cn0) $ >
  $ wi ph (wss B2 cn0) $ >
  $ wceq P (cseq (cmpo p m (cpw cn0) cn0 (co (cv p) (crab n (wa (wcel (cv m) A2) (wcel (co (cv n) (cv m) cmin) B2)) cn0) csad)) (cmpt n cn0 (cif (wceq (cv n) cc0) c0 (co (cv n) c1 cmin))) cc0) $ >
  $ wi ph (wceq (cfv cc0 P) c0) $;

--| The initial element of the partial sum sequence. (Contributed by Mario Carneiro, 9-Sep-2016.)
theorem smupp1 {m n p: setvar} (ph: wff m p) (A2 B2: class) (P: class m n p) (N: class m p):
  $ wi ph (wss A2 cn0) $ >
  $ wi ph (wss B2 cn0) $ >
  $ wceq P (cseq (cmpo p m (cpw cn0) cn0 (co (cv p) (crab n (wa (wcel (cv m) A2) (wcel (co (cv n) (cv m) cmin) B2)) cn0) csad)) (cmpt n cn0 (cif (wceq (cv n) cc0) c0 (co (cv n) c1 cmin))) cc0) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (cfv (co N c1 caddc) P) (co (cfv N P) (crab n (wa (wcel N A2) (wcel (co (cv n) N cmin) B2)) cn0) csad)) $;

--| Define the addition of two bit sequences, using ~ df-had and ~ df-cad bit operations. (Contributed by Mario Carneiro, 9-Sep-2016.)
theorem smuval {m n p: setvar} (ph: wff m p) (A2 B2: class) (P: class m n p) (N: class m p):
  $ wi ph (wss A2 cn0) $ >
  $ wi ph (wss B2 cn0) $ >
  $ wceq P (cseq (cmpo p m (cpw cn0) cn0 (co (cv p) (crab n (wa (wcel (cv m) A2) (wcel (co (cv n) (cv m) cmin) B2)) cn0) csad)) (cmpt n cn0 (cif (wceq (cv n) cc0) c0 (co (cv n) c1 cmin))) cc0) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wb (wcel N (co A2 B2 csmu)) (wcel N (cfv (co N c1 caddc) P))) $;

--| The partial sum sequence stabilizes at ` N ` after the ` N + 1 ` -th element of the sequence; this stable value is the value of the sequence multiplication. (Contributed by Mario Carneiro, 9-Sep-2016.)
theorem smuval2 {m n p: setvar} (ph: wff m p) (A2 B2: class) (P M: class m n p) (N: class m p):
  $ wi ph (wss A2 cn0) $ >
  $ wi ph (wss B2 cn0) $ >
  $ wceq P (cseq (cmpo p m (cpw cn0) cn0 (co (cv p) (crab n (wa (wcel (cv m) A2) (wcel (co (cv n) (cv m) cmin) B2)) cn0) csad)) (cmpt n cn0 (cif (wceq (cv n) cc0) c0 (co (cv n) c1 cmin))) cc0) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wcel M (cfv (co N c1 caddc) cuz)) $ >
  $ wi ph (wb (wcel N (co A2 B2 csmu)) (wcel N (cfv M P))) $;

--| If ` A ` only has elements less than ` N ` , then all elements of the partial sum sequence past ` N ` already equal the final value. (Contributed by Mario Carneiro, 20-Sep-2016.)
theorem smupvallem {m n p: setvar} (ph: wff m p) (A2 B2: class) (P M: class m n p) (N: class m p):
  $ wi ph (wss A2 cn0) $ >
  $ wi ph (wss B2 cn0) $ >
  $ wceq P (cseq (cmpo p m (cpw cn0) cn0 (co (cv p) (crab n (wa (wcel (cv m) A2) (wcel (co (cv n) (cv m) cmin) B2)) cn0) csad)) (cmpt n cn0 (cif (wceq (cv n) cc0) c0 (co (cv n) c1 cmin))) cc0) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wss A2 (co cc0 N cfzo)) $ >
  $ wi ph (wcel M (cfv N cuz)) $ >
  $ wi ph (wceq (cfv M P) (co A2 B2 csmu)) $;

--| The product of two sequences is a sequence. (Contributed by Mario Carneiro, 19-Sep-2016.)
theorem smucl (A2 B2: class):
  $ wi (wa (wss A2 cn0) (wss B2 cn0)) (wss (co A2 B2 csmu) cn0) $;

--| Lemma for ~ smu01 and ~ smu02 . (Contributed by Mario Carneiro, 19-Sep-2016.)
theorem smu01lem {k n: setvar} (ph: wff) (A2 B2: class):
  $ wi ph (wss A2 cn0) $ >
  $ wi ph (wss B2 cn0) $ >
  $ wi (wa ph (wa (wcel (cv k) cn0) (wcel (cv n) cn0))) (wn (wa (wcel (cv k) A2) (wcel (co (cv n) (cv k) cmin) B2))) $ >
  $ wi ph (wceq (co A2 B2 csmu) c0) $;

--| Multiplication of a sequence by ` 0 ` on the right. (Contributed by Mario Carneiro, 19-Sep-2016.)
theorem smu01 (A2: class):
  $ wi (wss A2 cn0) (wceq (co A2 c0 csmu) c0) $;

--| Multiplication of a sequence by ` 0 ` on the left. (Contributed by Mario Carneiro, 9-Sep-2016.)
theorem smu02 (A2: class):
  $ wi (wss A2 cn0) (wceq (co c0 A2 csmu) c0) $;

--| Rewrite the elements of the partial sum sequence in terms of sequence multiplication. (Contributed by Mario Carneiro, 20-Sep-2016.)
theorem smupval {m n p: setvar} (ph: wff m p) (A2 B2: class) (P: class m n p) (N: class):
  $ wi ph (wss A2 cn0) $ >
  $ wi ph (wss B2 cn0) $ >
  $ wceq P (cseq (cmpo p m (cpw cn0) cn0 (co (cv p) (crab n (wa (wcel (cv m) A2) (wcel (co (cv n) (cv m) cmin) B2)) cn0) csad)) (cmpt n cn0 (cif (wceq (cv n) cc0) c0 (co (cv n) c1 cmin))) cc0) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (cfv N P) (co (cin A2 (co cc0 N cfzo)) B2 csmu)) $;

--| Rewrite ~ smupp1 using only ` smul ` instead of the internal recursive function ` P ` . (Contributed by Mario Carneiro, 20-Sep-2016.)
theorem smup1 {n: setvar} (ph: wff) (A2 B2 N: class):
  $ wi ph (wss A2 cn0) $ >
  $ wi ph (wss B2 cn0) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (co (cin A2 (co cc0 (co N c1 caddc) cfzo)) B2 csmu) (co (co (cin A2 (co cc0 N cfzo)) B2 csmu) (crab n (wa (wcel N A2) (wcel (co (cv n) N cmin) B2)) cn0) csad)) $;

--| Any element of a sequence multiplication only depends on the values of the argument sequences up to and including that point. (Contributed by Mario Carneiro, 20-Sep-2016.)
theorem smueqlem {m n p: setvar} (ph: wff m p) (A2 B2: class) (P Q: class m n p) (N: class):
  $ wi ph (wss A2 cn0) $ >
  $ wi ph (wss B2 cn0) $ >
  $ wi ph (wcel N cn0) $ >
  $ wceq P (cseq (cmpo p m (cpw cn0) cn0 (co (cv p) (crab n (wa (wcel (cv m) A2) (wcel (co (cv n) (cv m) cmin) B2)) cn0) csad)) (cmpt n cn0 (cif (wceq (cv n) cc0) c0 (co (cv n) c1 cmin))) cc0) $ >
  $ wceq Q (cseq (cmpo p m (cpw cn0) cn0 (co (cv p) (crab n (wa (wcel (cv m) A2) (wcel (co (cv n) (cv m) cmin) (cin B2 (co cc0 N cfzo)))) cn0) csad)) (cmpt n cn0 (cif (wceq (cv n) cc0) c0 (co (cv n) c1 cmin))) cc0) $ >
  $ wi ph (wceq (cin (co A2 B2 csmu) (co cc0 N cfzo)) (cin (co (cin A2 (co cc0 N cfzo)) (cin B2 (co cc0 N cfzo)) csmu) (co cc0 N cfzo))) $;

--| Any element of a sequence multiplication only depends on the values of the argument sequences up to and including that point. (Contributed by Mario Carneiro, 20-Sep-2016.)
theorem smueq (ph: wff) (A2 B2 N: class):
  $ wi ph (wss A2 cn0) $ >
  $ wi ph (wss B2 cn0) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (cin (co A2 B2 csmu) (co cc0 N cfzo)) (cin (co (cin A2 (co cc0 N cfzo)) (cin B2 (co cc0 N cfzo)) csmu) (co cc0 N cfzo))) $;

--| Lemma for ~ smumul . (Contributed by Mario Carneiro, 22-Sep-2016.)
theorem smumullem (ph: wff) (A2 B2 N: class):
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wcel B2 cz) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wceq (co (cin (cfv A2 cbits) (co cc0 N cfzo)) (cfv B2 cbits) csmu) (cfv (co (co A2 (co c2 N cexp) cmo) B2 cmul) cbits)) $;

--| For sequences that correspond to valid integers, the sequence multiplication function produces the sequence for the product. This is effectively a proof of the correctness of the multiplication process, implemented in terms of logic gates for ~ df-sad , whose correctness is verified in ~ sadadd . Outside this range, the sequences cannot be representing integers, but the ` smul ` function still "works". This extended function is best interpreted in terms of the ring structure of the 2-adic integers. (Contributed by Mario Carneiro, 22-Sep-2016.)
theorem smumul (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cz)) (wceq (co (cfv A2 cbits) (cfv B2 cbits) csmu) (cfv (co A2 B2 cmul) cbits)) $;

--| Extend the definition of a class to include the greatest common divisor operator.
term cgcd: class;

--| Define the ` gcd ` operator. For example, ` ( -u 6 gcd 9 ) = 3 ` ( ~ ex-gcd ). For an alternate definition, based on the definition in [ApostolNT] p. 15, see ~ dfgcd2 . (Contributed by Paul Chapman, 21-Mar-2011.)
axiom df_gcd {x3 y1 n: setvar}:
  $ wceq cgcd (cmpo x3 y1 cz cz (cif (wa (wceq (cv x3) cc0) (wceq (cv y1) cc0)) cc0 (csup (crab n (wa (wbr (cv n) (cv x3) cdvds) (wbr (cv n) (cv y1) cdvds)) cz) cr clt))) $;

--| The value of the ` gcd ` operator. ` ( M gcd N ) ` is the greatest common divisor of ` M ` and ` N ` . If ` M ` and ` N ` are both ` 0 ` , the result is defined conventionally as ` 0 ` . (Contributed by Paul Chapman, 21-Mar-2011.) (Revised by Mario Carneiro, 10-Nov-2013.)
theorem gcdval {n: setvar} (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wceq (co M N cgcd) (cif (wa (wceq M cc0) (wceq N cc0)) cc0 (csup (crab n (wa (wbr (cv n) M cdvds) (wbr (cv n) N cdvds)) cz) cr clt))) $;

--| The value, by convention, of the ` gcd ` operator when both operands are 0. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem gcd0val:
  $ wceq (co cc0 cc0 cgcd) cc0 $;

--| The value of the ` gcd ` operator when at least one operand is nonzero. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem gcdn0val {n: setvar} (M N: class):
  $ wi (wa (wa (wcel M cz) (wcel N cz)) (wn (wa (wceq M cc0) (wceq N cc0)))) (wceq (co M N cgcd) (csup (crab n (wa (wbr (cv n) M cdvds) (wbr (cv n) N cdvds)) cz) cr clt)) $;

--| Lemma for ~ gcdn0cl , ~ gcddvds and ~ dvdslegcd . (Contributed by Paul Chapman, 21-Mar-2011.)
theorem gcdcllem1 {x3 y1 z n: setvar} (A2: class) (S: class y1 z n):
  $ wceq S (crab z (wral n (wbr (cv z) (cv n) cdvds) A2) cz) $ >
  $ wi (wa (wss A2 cz) (wrex n (wne (cv n) cc0) A2)) (wa (wne S c0) (wrex x3 (wral y1 (wbr (cv y1) (cv x3) cle) S) cz)) $;

--| Lemma for ~ gcdn0cl , ~ gcddvds and ~ dvdslegcd . (Contributed by Paul Chapman, 21-Mar-2011.)
theorem gcdcllem2 {z n: setvar} (R S: class z n) (M N: class):
  $ wceq S (crab z (wral n (wbr (cv z) (cv n) cdvds) (cpr M N)) cz) $ >
  $ wceq R (crab z (wa (wbr (cv z) M cdvds) (wbr (cv z) N cdvds)) cz) $ >
  $ wi (wa (wcel M cz) (wcel N cz)) (wceq R S) $;

--| Lemma for ~ gcdn0cl , ~ gcddvds and ~ dvdslegcd . (Contributed by Paul Chapman, 21-Mar-2011.)
theorem gcdcllem3 {z n: setvar} (R S: class z n) (K: class n) (M N: class):
  $ wceq S (crab z (wral n (wbr (cv z) (cv n) cdvds) (cpr M N)) cz) $ >
  $ wceq R (crab z (wa (wbr (cv z) M cdvds) (wbr (cv z) N cdvds)) cz) $ >
  $ wi (wa (wa (wcel M cz) (wcel N cz)) (wn (wa (wceq M cc0) (wceq N cc0)))) (w3a (wcel (csup R cr clt) cn) (wa (wbr (csup R cr clt) M cdvds) (wbr (csup R cr clt) N cdvds)) (wi (w3a (wcel K cz) (wbr K M cdvds) (wbr K N cdvds)) (wbr K (csup R cr clt) cle))) $;

--| Closure of the ` gcd ` operator. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem gcdn0cl (M N: class):
  $ wi (wa (wa (wcel M cz) (wcel N cz)) (wn (wa (wceq M cc0) (wceq N cc0)))) (wcel (co M N cgcd) cn) $;

--| The gcd of two integers divides each of them. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem gcddvds (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wa (wbr (co M N cgcd) M cdvds) (wbr (co M N cgcd) N cdvds)) $;

--| An integer which divides both operands of the ` gcd ` operator is bounded by it. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem dvdslegcd (K M N: class):
  $ wi (wa (w3a (wcel K cz) (wcel M cz) (wcel N cz)) (wn (wa (wceq M cc0) (wceq N cc0)))) (wi (wa (wbr K M cdvds) (wbr K N cdvds)) (wbr K (co M N cgcd) cle)) $;

--| A positive integer which divides both positive operands of the ` gcd ` operator is bounded by it. (Contributed by AV, 9-Aug-2020.)
theorem nndvdslegcd (K M N: class):
  $ wi (w3a (wcel K cn) (wcel M cn) (wcel N cn)) (wi (wa (wbr K M cdvds) (wbr K N cdvds)) (wbr K (co M N cgcd) cle)) $;

--| Closure of the ` gcd ` operator. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem gcdcl (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wcel (co M N cgcd) cn0) $;

--| Closure of the ` gcd ` operator. (Contributed by Thierry Arnoux, 2-Feb-2020.)
theorem gcdnncl (M N: class):
  $ wi (wa (wcel M cn) (wcel N cn)) (wcel (co M N cgcd) cn) $;

--| Closure of the ` gcd ` operator. (Contributed by Mario Carneiro, 29-May-2016.)
theorem gcdcld (ph: wff) (M N: class):
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wcel (co M N cgcd) cn0) $;

--| Closure of the ` gcd ` operator if the second operand is not 0. (Contributed by AV, 10-Jul-2021.)
theorem gcd2n0cl (M N: class):
  $ wi (w3a (wcel M cz) (wcel N cz) (wne N cc0)) (wcel (co M N cgcd) cn) $;

--| The greatest common divisor of a positive integer and another integer is less than or equal to the positive integer. (Contributed by SN, 25-Aug-2024.)
theorem gcdle1d (ph: wff) (M N: class):
  $ wi ph (wcel M cn) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wbr (co M N cgcd) M cle) $;

--| The greatest common divisor of a positive integer and another integer is less than or equal to the positive integer. (Contributed by SN, 25-Aug-2024.)
theorem gcdle2d (ph: wff) (M N: class):
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wbr (co M N cgcd) N cle) $;

--| An integer is the product of an integer and the gcd of it and another integer. (Contributed by AV, 11-Jul-2021.)
theorem zeqzmulgcd {n: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cz)) (wrex n (wceq A2 (co (cv n) (co A2 B2 cgcd) cmul)) cz) $;

--| An integer divided by the gcd of it and a nonzero integer is an integer. (Contributed by AV, 11-Jul-2021.)
theorem divgcdz (A2 B2: class):
  $ wi (w3a (wcel A2 cz) (wcel B2 cz) (wne B2 cc0)) (wcel (co A2 (co A2 B2 cgcd) cdiv) cz) $;

--| Domain and codomain of the ` gcd ` operator. (Contributed by Paul Chapman, 31-Mar-2011.) (Revised by Mario Carneiro, 16-Nov-2013.)
theorem gcdf:
  $ wf (cxp cz cz) cn0 cgcd $;

--| The ` gcd ` operator is commutative. Theorem 1.4(a) in [ApostolNT] p. 16. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem gcdcom (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wceq (co M N cgcd) (co N M cgcd)) $;

--| The ` gcd ` operator is commutative, deduction version. (Contributed by SN, 24-Aug-2024.)
theorem gcdcomd (ph: wff) (M N: class):
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wceq (co M N cgcd) (co N M cgcd)) $;

--| A positive integer divided by the gcd of it and another integer is a positive integer. (Contributed by AV, 10-Jul-2021.)
theorem divgcdnn (A2 B2: class):
  $ wi (wa (wcel A2 cn) (wcel B2 cz)) (wcel (co A2 (co A2 B2 cgcd) cdiv) cn) $;

--| A positive integer divided by the gcd of it and another integer is a positive integer. (Contributed by AV, 10-Jul-2021.)
theorem divgcdnnr (A2 B2: class):
  $ wi (wa (wcel A2 cn) (wcel B2 cz)) (wcel (co A2 (co B2 A2 cgcd) cdiv) cn) $;

--| The gcd of two integers is zero iff they are both zero. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem gcdeq0 (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wceq (co M N cgcd) cc0) (wa (wceq M cc0) (wceq N cc0))) $;

--| The gcd of two integers is positive (nonzero) iff they are not both zero. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem gcdn0gt0 (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wn (wa (wceq M cc0) (wceq N cc0))) (wbr cc0 (co M N cgcd) clt)) $;

--| The gcd of 0 and an integer is the integer's absolute value. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem gcd0id (N: class):
  $ wi (wcel N cz) (wceq (co cc0 N cgcd) (cfv N cabs)) $;

--| The gcd of an integer and 0 is the integer's absolute value. Theorem 1.4(d)2 in [ApostolNT] p. 16. (Contributed by Paul Chapman, 31-Mar-2011.)
theorem gcdid0 (N: class):
  $ wi (wcel N cz) (wceq (co N cc0 cgcd) (cfv N cabs)) $;

--| The gcd of a nonnegative integer with 0 is itself. (Contributed by Paul Chapman, 31-Mar-2011.)
theorem nn0gcdid0 (N: class):
  $ wi (wcel N cn0) (wceq (co N cc0 cgcd) N) $;

--| Negating one operand of the ` gcd ` operator does not alter the result. (Contributed by Paul Chapman, 21-Mar-2011.)
theorem gcdneg (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wceq (co M (cneg N) cgcd) (co M N cgcd)) $;

--| Negating one operand of the ` gcd ` operator does not alter the result. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem neggcd (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wceq (co (cneg M) N cgcd) (co M N cgcd)) $;

--| Lemma for ~ gcdaddm . (Contributed by Paul Chapman, 31-Mar-2011.)
theorem gcdaddmlem (K M N: class):
  $ wcel K cz $ >
  $ wcel M cz $ >
  $ wcel N cz $ >
  $ wceq (co M N cgcd) (co M (co (co K M cmul) N caddc) cgcd) $;

--| Adding a multiple of one operand of the ` gcd ` operator to the other does not alter the result. (Contributed by Paul Chapman, 31-Mar-2011.)
theorem gcdaddm (K M N: class):
  $ wi (w3a (wcel K cz) (wcel M cz) (wcel N cz)) (wceq (co M N cgcd) (co M (co N (co K M cmul) caddc) cgcd)) $;

--| The gcd of two numbers is the same as the gcd of the left and their sum. (Contributed by Scott Fenton, 20-Apr-2014.)
theorem gcdadd (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wceq (co M N cgcd) (co M (co N M caddc) cgcd)) $;

--| The gcd of a number and itself is its absolute value. (Contributed by Paul Chapman, 31-Mar-2011.)
theorem gcdid (N: class):
  $ wi (wcel N cz) (wceq (co N N cgcd) (cfv N cabs)) $;

--| The gcd of a nonnegative integer and itself is the integer. (Contributed by SN, 25-Aug-2024.)
theorem gcdnn0id (N: class):
  $ wi (wcel N cn0) (wceq (co N N cgcd) N) $;

--| The gcd of a number with 1 is 1. Theorem 1.4(d)1 in [ApostolNT] p. 16. (Contributed by Mario Carneiro, 19-Feb-2014.)
theorem gcd1 (M: class):
  $ wi (wcel M cz) (wceq (co M c1 cgcd) c1) $;

--| The gcd of the absolute value of the first operator. (Contributed by Scott Fenton, 2-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem gcdabs1 (M N: class):
  $ wi (wa (wcel N cz) (wcel M cz)) (wceq (co (cfv N cabs) M cgcd) (co N M cgcd)) $;

--| The gcd of the absolute value of the second operator. (Contributed by Scott Fenton, 2-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem gcdabs2 (M N: class):
  $ wi (wa (wcel N cz) (wcel M cz)) (wceq (co N (cfv M cabs) cgcd) (co N M cgcd)) $;

--| The gcd of two integers is the same as that of their absolute values. (Contributed by Paul Chapman, 31-Mar-2011.) (Proof shortened by SN, 15-Sep-2024.)
theorem gcdabs (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wceq (co (cfv M cabs) (cfv N cabs) cgcd) (co M N cgcd)) $;

--| The gcd remains unchanged if one operand is replaced with its remainder modulo the other. (Contributed by Paul Chapman, 31-Mar-2011.)
theorem modgcd (M N: class):
  $ wi (wa (wcel M cz) (wcel N cn)) (wceq (co (co M N cmo) N cgcd) (co M N cgcd)) $;

--| The gcd of one and an integer is one. (Contributed by Scott Fenton, 17-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem _1gcd (M: class):
  $ wi (wcel M cz) (wceq (co c1 M cgcd) c1) $;

--| The greatest common divisor of a nonnegative integer ` M ` and a multiple of it is ` M ` itself. (Contributed by Rohan Ridenour, 3-Aug-2023.)
theorem gcdmultipled (ph: wff) (M N: class):
  $ wi ph (wcel M cn0) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wceq (co M (co N M cmul) cgcd) M) $;

--| The gcd of a multiple of an integer is the integer itself. (Contributed by Scott Fenton, 18-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.) (Proof shortened by AV, 12-Jan-2023.)
theorem gcdmultiplez (M N: class):
  $ wi (wa (wcel M cn) (wcel N cz)) (wceq (co M (co M N cmul) cgcd) M) $;

--| The gcd of a multiple of a positive integer is the positive integer itself. (Contributed by Scott Fenton, 12-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.) (Proof shortened by AV, 12-Jan-2023.)
theorem gcdmultiple (M N: class):
  $ wi (wa (wcel M cn) (wcel N cn)) (wceq (co M (co M N cmul) cgcd) M) $;

--| The greatest common divisor of a positive integer and another integer it divides is itself. (Contributed by Rohan Ridenour, 3-Aug-2023.)
theorem dvdsgcdidd (ph: wff) (M N: class):
  $ wi ph (wcel M cn) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wbr M N cdvds) $ >
  $ wi ph (wceq (co M N cgcd) M) $;

--| The greatest common divisor of six and four is two. To calculate this gcd, a simple form of Euclid's algorithm is used: ` ( 6 gcd 4 ) = ( ( 4 + 2 ) gcd 4 ) = ( 2 gcd 4 ) ` and ` ( 2 gcd 4 ) = ( 2 gcd ( 2 + 2 ) ) = ( 2 gcd 2 ) = 2 ` . (Contributed by AV, 27-Aug-2020.)
theorem _6gcd4e2:
  $ wceq (co c6 c4 cgcd) c2 $;

--| Lemma for ~ bezout . (Contributed by Mario Carneiro, 15-Mar-2014.)
theorem bezoutlem1 {x3 y1 z: setvar} (ph: wff) (A2 B2: class) (M: class x3 y1 z):
  $ wceq M (crab z (wrex x3 (wrex y1 (wceq (cv z) (co (co A2 (cv x3) cmul) (co B2 (cv y1) cmul) caddc)) cz) cz) cn) $ >
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wcel B2 cz) $ >
  $ wi ph (wi (wne A2 cc0) (wcel (cfv A2 cabs) M)) $;

--| Lemma for ~ bezout . (Contributed by Mario Carneiro, 15-Mar-2014.) ( Revised by AV, 30-Sep-2020.)
theorem bezoutlem2 {x3 y1 z: setvar} (ph: wff) (A2 B2 G: class) (M: class x3 y1 z):
  $ wceq M (crab z (wrex x3 (wrex y1 (wceq (cv z) (co (co A2 (cv x3) cmul) (co B2 (cv y1) cmul) caddc)) cz) cz) cn) $ >
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wcel B2 cz) $ >
  $ wceq G (cinf M cr clt) $ >
  $ wi ph (wn (wa (wceq A2 cc0) (wceq B2 cc0))) $ >
  $ wi ph (wcel G M) $;

--| Lemma for ~ bezout . (Contributed by Mario Carneiro, 22-Feb-2014.) ( Revised by AV, 30-Sep-2020.)
theorem bezoutlem3 {x3 y1 z: setvar} (ph: wff) (A2 B2 C G: class) (M: class z):
  $ wceq M (crab z (wrex x3 (wrex y1 (wceq (cv z) (co (co A2 (cv x3) cmul) (co B2 (cv y1) cmul) caddc)) cz) cz) cn) $ >
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wcel B2 cz) $ >
  $ wceq G (cinf M cr clt) $ >
  $ wi ph (wn (wa (wceq A2 cc0) (wceq B2 cc0))) $ >
  $ wi ph (wi (wcel C M) (wbr G C cdvds)) $;

--| Lemma for ~ bezout . (Contributed by Mario Carneiro, 22-Feb-2014.)
theorem bezoutlem4 {x3 y1 z: setvar} (ph: wff) (A2 B2 G: class) (M: class z):
  $ wceq M (crab z (wrex x3 (wrex y1 (wceq (cv z) (co (co A2 (cv x3) cmul) (co B2 (cv y1) cmul) caddc)) cz) cz) cn) $ >
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wcel B2 cz) $ >
  $ wceq G (cinf M cr clt) $ >
  $ wi ph (wn (wa (wceq A2 cc0) (wceq B2 cc0))) $ >
  $ wi ph (wcel (co A2 B2 cgcd) M) $;

--| B&eacute;zout's identity: For any integers ` A ` and ` B ` , there are integers ` x , y ` such that ` ( A gcd B ) = A x. x + B x. y ` . This is Metamath 100 proof #60. (Contributed by Mario Carneiro, 22-Feb-2014.)
theorem bezout {x3 y1: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cz)) (wrex x3 (wrex y1 (wceq (co A2 B2 cgcd) (co (co A2 (cv x3) cmul) (co B2 (cv y1) cmul) caddc)) cz) cz) $;

--| An integer which divides each of two others also divides their gcd. (Contributed by Paul Chapman, 22-Jun-2011.) (Revised by Mario Carneiro, 30-May-2014.)
theorem dvdsgcd (K M N: class):
  $ wi (w3a (wcel K cz) (wcel M cz) (wcel N cz)) (wi (wa (wbr K M cdvds) (wbr K N cdvds)) (wbr K (co M N cgcd) cdvds)) $;

--| Biconditional form of ~ dvdsgcd . (Contributed by Scott Fenton, 2-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem dvdsgcdb (K M N: class):
  $ wi (w3a (wcel K cz) (wcel M cz) (wcel N cz)) (wb (wa (wbr K M cdvds) (wbr K N cdvds)) (wbr K (co M N cgcd) cdvds)) $;

--| Alternate definition of the ` gcd ` operator, see definition in [ApostolNT] p. 15. (Contributed by AV, 8-Aug-2021.)
theorem dfgcd2 {e: setvar} (D M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wceq D (co M N cgcd)) (w3a (wbr cc0 D cle) (wa (wbr D M cdvds) (wbr D N cdvds)) (wral e (wi (wa (wbr (cv e) M cdvds) (wbr (cv e) N cdvds)) (wbr (cv e) D cdvds)) cz))) $;

--| Associative law for ` gcd ` operator. Theorem 1.4(b) in [ApostolNT] p. 16. (Contributed by Scott Fenton, 2-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem gcdass (P M N: class):
  $ wi (w3a (wcel N cz) (wcel M cz) (wcel P cz)) (wceq (co (co N M cgcd) P cgcd) (co N (co M P cgcd) cgcd)) $;

--| Distribute multiplication by a nonnegative integer over gcd. (Contributed by Paul Chapman, 22-Jun-2011.) (Proof shortened by Mario Carneiro, 30-May-2014.)
theorem mulgcd (K M N: class):
  $ wi (w3a (wcel K cn0) (wcel M cz) (wcel N cz)) (wceq (co (co K M cmul) (co K N cmul) cgcd) (co K (co M N cgcd) cmul)) $;

--| Distribute absolute value of multiplication over gcd. Theorem 1.4(c) in [ApostolNT] p. 16. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem absmulgcd (K M N: class):
  $ wi (w3a (wcel K cz) (wcel M cz) (wcel N cz)) (wceq (co (co K M cmul) (co K N cmul) cgcd) (cfv (co K (co M N cgcd) cmul) cabs)) $;

--| Reverse distribution law for the ` gcd ` operator. (Contributed by Scott Fenton, 2-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem mulgcdr (A2 B2 C: class):
  $ wi (w3a (wcel A2 cz) (wcel B2 cz) (wcel C cn0)) (wceq (co (co A2 C cmul) (co B2 C cmul) cgcd) (co (co A2 B2 cgcd) C cmul)) $;

--| Division law for the ` gcd ` operator. (Contributed by Scott Fenton, 18-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem gcddiv (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cz) (wcel B2 cz) (wcel C cn)) (wa (wbr C A2 cdvds) (wbr C B2 cdvds))) (wceq (co (co A2 B2 cgcd) C cdiv) (co (co A2 C cdiv) (co B2 C cdiv) cgcd)) $;

--| A positive integer ` A ` is equal to its gcd with an integer ` B ` if and only if ` A ` divides ` B ` . Generalization of ~ gcdeq . (Contributed by AV, 1-Jul-2020.)
theorem gcdzeq (A2 B2: class):
  $ wi (wa (wcel A2 cn) (wcel B2 cz)) (wb (wceq (co A2 B2 cgcd) A2) (wbr A2 B2 cdvds)) $;

--| ` A ` is equal to its gcd with ` B ` if and only if ` A ` divides ` B ` . (Contributed by Mario Carneiro, 23-Feb-2014.) (Proof shortened by AV, 8-Aug-2021.)
theorem gcdeq (A2 B2: class):
  $ wi (wa (wcel A2 cn) (wcel B2 cn)) (wb (wceq (co A2 B2 cgcd) A2) (wbr A2 B2 cdvds)) $;

--| Unidirectional form of ~ dvdssq . (Contributed by Scott Fenton, 19-Apr-2014.)
theorem dvdssqim (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wi (wbr M N cdvds) (wbr (co M c2 cexp) (co N c2 cexp) cdvds)) $;

--| If two numbers are divisible, so are their nonnegative exponents. Similar to ~ dvdssqim for nonnegative exponents. (Contributed by Steven Nguyen, 2-Apr-2023.)
theorem dvdsexpim (A2 B2 N: class):
  $ wi (w3a (wcel A2 cz) (wcel B2 cz) (wcel N cn0)) (wi (wbr A2 B2 cdvds) (wbr (co A2 N cexp) (co B2 N cexp) cdvds)) $;

--| Deduction associated with ~ dvdsexpim . (Contributed by SN, 21-Aug-2024.)
theorem dvdsexpad (ph: wff) (A2 B2 N: class):
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wcel B2 cz) $ >
  $ wi ph (wcel N cn0) $ >
  $ wi ph (wbr A2 B2 cdvds) $ >
  $ wi ph (wbr (co A2 N cexp) (co B2 N cexp) cdvds) $;

--| A divisibility equivalent for ~ odmulg . (Contributed by Stefan O'Rear, 6-Sep-2015.)
theorem dvdsmulgcd (A2 B2 C: class):
  $ wi (wa (wcel B2 cz) (wcel C cz)) (wb (wbr A2 (co B2 C cmul) cdvds) (wbr A2 (co B2 (co C A2 cgcd) cmul) cdvds)) $;

--| If ` K ` and ` M ` are relatively prime, then the gcd of ` K ` and ` M x. N ` is the gcd of ` K ` and ` N ` . (Contributed by Scott Fenton, 12-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem rpmulgcd (K M N: class):
  $ wi (wa (w3a (wcel K cn) (wcel M cn) (wcel N cn)) (wceq (co K M cgcd) c1)) (wceq (co K (co M N cmul) cgcd) (co K N cgcd)) $;

--| If ` A ` and ` B ` are relatively prime, then so are ` A ^ N ` and ` B ` . (Contributed by Scott Fenton, 12-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem rplpwr (A2 B2 N: class):
  $ wi (w3a (wcel A2 cn) (wcel B2 cn) (wcel N cn)) (wi (wceq (co A2 B2 cgcd) c1) (wceq (co (co A2 N cexp) B2 cgcd) c1)) $;

--| If ` A ` and ` B ` are relatively prime, then so are ` A ` and ` B ^ N ` . Originally a subproof of ~ rppwr . (Contributed by SN, 21-Aug-2024.)
theorem rprpwr (A2 B2 N: class):
  $ wi (w3a (wcel A2 cn) (wcel B2 cn) (wcel N cn)) (wi (wceq (co A2 B2 cgcd) c1) (wceq (co A2 (co B2 N cexp) cgcd) c1)) $;

--| If ` A ` and ` B ` are relatively prime, then so are ` A ^ N ` and ` B ^ N ` . (Contributed by Scott Fenton, 12-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem rppwr (A2 B2 N: class):
  $ wi (w3a (wcel A2 cn) (wcel B2 cn) (wcel N cn)) (wi (wceq (co A2 B2 cgcd) c1) (wceq (co (co A2 N cexp) (co B2 N cexp) cgcd) c1)) $;

--| If ` A ` and ` B ` are relatively prime, then so are ` A ^ N ` and ` B ^ N ` . ~ rppwr extended to nonnegative integers. Less general than ~ rpexp12i . (Contributed by Steven Nguyen, 4-Apr-2023.)
theorem nn0rppwr (A2 B2 N: class):
  $ wi (w3a (wcel A2 cn0) (wcel B2 cn0) (wcel N cn0)) (wi (wceq (co A2 B2 cgcd) c1) (wceq (co (co A2 N cexp) (co B2 N cexp) cgcd) c1)) $;

--| Square distributes over gcd. (Contributed by Scott Fenton, 18-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem sqgcd (M N: class):
  $ wi (wa (wcel M cn) (wcel N cn)) (wceq (co (co M N cgcd) c2 cexp) (co (co M c2 cexp) (co N c2 cexp) cgcd)) $;

--| Exponentiation distributes over gcd. ~ sqgcd extended to nonnegative exponents. (Contributed by Steven Nguyen, 4-Apr-2023.)
theorem expgcd (A2 B2 N: class):
  $ wi (w3a (wcel A2 cn) (wcel B2 cn) (wcel N cn0)) (wceq (co (co A2 B2 cgcd) N cexp) (co (co A2 N cexp) (co B2 N cexp) cgcd)) $;

--| Exponentiation distributes over gcd. ~ nn0gcdsq extended to nonnegative exponents. ~ expgcd extended to nonnegative bases. (Contributed by Steven Nguyen, 5-Apr-2023.)
theorem nn0expgcd (A2 B2 N: class):
  $ wi (w3a (wcel A2 cn0) (wcel B2 cn0) (wcel N cn0)) (wceq (co (co A2 B2 cgcd) N cexp) (co (co A2 N cexp) (co B2 N cexp) cgcd)) $;

--| Exponentiation distributes over gcd. ~ zgcdsq extended to nonnegative exponents. ~ nn0expgcd extended to integer bases by symmetry. (Contributed by Steven Nguyen, 5-Apr-2023.)
theorem zexpgcd (A2 B2 N: class):
  $ wi (w3a (wcel A2 cz) (wcel B2 cz) (wcel N cn0)) (wceq (co (co A2 B2 cgcd) N cexp) (co (co A2 N cexp) (co B2 N cexp) cgcd)) $;

--| Two positive integers are divisible iff their positive integer powers are. (Contributed by Scott Fenton, 18-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.) Generalized to arbitrary positive integer exponents. (Revised by SN, 20-Aug-2024.)
theorem dvdsexpnn (A2 B2 N: class):
  $ wi (w3a (wcel A2 cn) (wcel B2 cn) (wcel N cn)) (wb (wbr A2 B2 cdvds) (wbr (co A2 N cexp) (co B2 N cexp) cdvds)) $;

--| Two positive integers are divisible iff their squares are. (Contributed by Scott Fenton, 18-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.) (Proof shortened by AV, 16-Sep-2026.)
theorem dvdssqnn (M N: class):
  $ wi (wa (wcel M cn) (wcel N cn)) (wb (wbr M N cdvds) (wbr (co M c2 cexp) (co N c2 cexp) cdvds)) $;

--| Two integers are divisible iff their squares are. (Contributed by Scott Fenton, 18-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem dvdssq (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wbr M N cdvds) (wbr (co M c2 cexp) (co N c2 cexp) cdvds)) $;

--| Partial converse to ~ bezout . Existence of a linear combination does not set the gcd, but it does upper bound it. (Contributed by Stefan O'Rear, 23-Sep-2014.)
theorem bezoutr (A2 B2 X Y: class):
  $ wi (wa (wa (wcel A2 cz) (wcel B2 cz)) (wa (wcel X cz) (wcel Y cz))) (wbr (co A2 B2 cgcd) (co (co A2 X cmul) (co B2 Y cmul) caddc) cdvds) $;

--| Converse of ~ bezout for when the greater common divisor is one (sufficient condition for relative primality). (Contributed by Stefan O'Rear, 23-Sep-2014.)
theorem bezoutr1 (A2 B2 X Y: class):
  $ wi (wa (wa (wcel A2 cz) (wcel B2 cz)) (wa (wcel X cz) (wcel Y cz))) (wi (wceq (co (co A2 X cmul) (co B2 Y cmul) caddc) c1) (wceq (co A2 B2 cgcd) c1)) $;

--| A strictly-decreasing nonnegative integer sequence with initial term ` N ` reaches zero by the ` N ` th term. Deduction version. (Contributed by Paul Chapman, 31-Mar-2011.)
theorem nn0seqcvgd {k: setvar} (ph: wff) (F N: class):
  $ wi ph (wf cn0 cn0 F) $ >
  $ wi ph (wceq N (cfv cc0 F)) $ >
  $ wi (wa ph (wcel (cv k) cn0)) (wi (wne (cfv (co (cv k) c1 caddc) F) cc0) (wbr (cfv (co (cv k) c1 caddc) F) (cfv (cv k) F) clt)) $ >
  $ wi ph (wceq (cfv N F) cc0) $;

--| A sequence whose iteration function ignores the second argument is only affected by the first point of the initial value function. (Contributed by Mario Carneiro, 11-Feb-2015.)
theorem seq1st (A2 R F M V Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wceq R (cseq (ccom F c1st) (cxp Z (csn A2)) M) $ >
  $ wi (wa (wcel M cz) (wcel A2 V)) (wceq R (cseq (ccom F c1st) (csn (cop M A2)) M)) $;

--| The value of the algorithm iterator ` R ` at ` 0 ` is the initial state ` A ` . (Contributed by Paul Chapman, 31-Mar-2011.) (Revised by Mario Carneiro, 28-May-2014.)
theorem algr0 (ph: wff) (A2 R S F M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wceq R (cseq (ccom F c1st) (cxp Z (csn A2)) M) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wceq (cfv M R) A2) $;

--| An algorithm is a step function ` F : S --> S ` on a state space ` S ` . An algorithm acts on an initial state ` A e. S ` by iteratively applying ` F ` to give ` A ` , ` ( F `` A ) ` , ` ( F `` ( F `` A ) ) ` and so on. An algorithm is said to halt if a fixed point of ` F ` is reached after a finite number of iterations. The algorithm iterator ` R : NN0 --> S ` "runs" the algorithm ` F ` so that ` ( R `` k ) ` is the state after ` k ` iterations of ` F ` on the initial state ` A ` . Domain and codomain of the algorithm iterator ` R ` . (Contributed by Paul Chapman, 31-Mar-2011.) (Revised by Mario Carneiro, 28-May-2014.)
theorem algrf (ph: wff) (A2 R S F M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wceq R (cseq (ccom F c1st) (cxp Z (csn A2)) M) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wf S S F) $ >
  $ wi ph (wf Z S R) $;

--| The value of the algorithm iterator ` R ` at ` ( K + 1 ) ` . (Contributed by Paul Chapman, 31-Mar-2011.) (Revised by Mario Carneiro, 27-Dec-2014.)
theorem algrp1 (ph: wff) (A2 R S F K M Z: class):
  $ wceq Z (cfv M cuz) $ >
  $ wceq R (cseq (ccom F c1st) (cxp Z (csn A2)) M) $ >
  $ wi ph (wcel M cz) $ >
  $ wi ph (wcel A2 S) $ >
  $ wi ph (wf S S F) $ >
  $ wi (wa ph (wcel K Z)) (wceq (cfv (co K c1 caddc) R) (cfv (cfv K R) F)) $;

--| If ` I ` is an invariant of ` F ` , then its value is unchanged after any number of iterations of ` F ` . (Contributed by Paul Chapman, 31-Mar-2011.)
theorem alginv {x3: setvar} (A2: class x3) (R S F I: class) (K: class x3):
  $ wceq R (cseq (ccom F c1st) (cxp cn0 (csn A2)) cc0) $ >
  $ wf S S F $ >
  $ wi (wcel (cv x3) S) (wceq (cfv (cfv (cv x3) F) I) (cfv (cv x3) I)) $ >
  $ wi (wa (wcel A2 S) (wcel K cn0)) (wceq (cfv (cfv K R) I) (cfv (cfv cc0 R) I)) $;

--| One way to prove that an algorithm halts is to construct a countdown function ` C : S --> NN0 ` whose value is guaranteed to decrease for each iteration of ` F ` until it reaches ` 0 ` . That is, if ` X e. S ` is not a fixed point of ` F ` , then ` ( C `` ( F `` X ) ) < ( C `` X ) ` . If ` C ` is a countdown function for algorithm ` F ` , the sequence ` ( C `` ( R `` k ) ) ` reaches ` 0 ` after at most ` N ` steps, where ` N ` is the value of ` C ` for the initial state ` A ` . (Contributed by Paul Chapman, 22-Jun-2011.)
theorem algcvg {z: setvar} (A2: class z) (C R S F: class) (N: class z):
  $ wf S S F $ >
  $ wceq R (cseq (ccom F c1st) (cxp cn0 (csn A2)) cc0) $ >
  $ wf S cn0 C $ >
  $ wi (wcel (cv z) S) (wi (wne (cfv (cfv (cv z) F) C) cc0) (wbr (cfv (cfv (cv z) F) C) (cfv (cv z) C) clt)) $ >
  $ wceq N (cfv A2 C) $ >
  $ wi (wcel A2 S) (wceq (cfv (cfv N R) C) cc0) $;

--| Lemma for ~ algcvgb . (Contributed by Paul Chapman, 31-Mar-2011.)
theorem algcvgblem (M N: class):
  $ wi (wa (wcel M cn0) (wcel N cn0)) (wb (wi (wne N cc0) (wbr N M clt)) (wa (wi (wne M cc0) (wbr N M clt)) (wi (wceq M cc0) (wceq N cc0)))) $;

--| Two ways of expressing that ` C ` is a countdown function for algorithm ` F ` . The first is used in these theorems. The second states the condition more intuitively as a conjunction: if the countdown function's value is currently nonzero, it must decrease at the next step; if it has reached zero, it must remain zero at the next step. (Contributed by Paul Chapman, 31-Mar-2011.)
theorem algcvgb (C S F X: class):
  $ wf S S F $ >
  $ wf S cn0 C $ >
  $ wi (wcel X S) (wb (wi (wne (cfv (cfv X F) C) cc0) (wbr (cfv (cfv X F) C) (cfv X C) clt)) (wa (wi (wne (cfv X C) cc0) (wbr (cfv (cfv X F) C) (cfv X C) clt)) (wi (wceq (cfv X C) cc0) (wceq (cfv (cfv X F) C) cc0)))) $;

--| The countdown function ` C ` remains ` 0 ` after ` N ` steps. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem algcvga {z: setvar} (A2: class z) (C R S F: class) (K N: class z):
  $ wf S S F $ >
  $ wceq R (cseq (ccom F c1st) (cxp cn0 (csn A2)) cc0) $ >
  $ wf S cn0 C $ >
  $ wi (wcel (cv z) S) (wi (wne (cfv (cfv (cv z) F) C) cc0) (wbr (cfv (cfv (cv z) F) C) (cfv (cv z) C) clt)) $ >
  $ wceq N (cfv A2 C) $ >
  $ wi (wcel A2 S) (wi (wcel K (cfv N cuz)) (wceq (cfv (cfv K R) C) cc0)) $;

--| If ` F ` reaches a fixed point when the countdown function ` C ` reaches ` 0 ` , ` F ` remains fixed after ` N ` steps. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem algfx {z: setvar} (A2: class z) (C R S F K N: class):
  $ wf S S F $ >
  $ wceq R (cseq (ccom F c1st) (cxp cn0 (csn A2)) cc0) $ >
  $ wf S cn0 C $ >
  $ wi (wcel (cv z) S) (wi (wne (cfv (cfv (cv z) F) C) cc0) (wbr (cfv (cfv (cv z) F) C) (cfv (cv z) C) clt)) $ >
  $ wceq N (cfv A2 C) $ >
  $ wi (wcel (cv z) S) (wi (wceq (cfv (cv z) C) cc0) (wceq (cfv (cv z) F) (cv z))) $ >
  $ wi (wcel A2 S) (wi (wcel K (cfv N cuz)) (wceq (cfv K R) (cfv N R))) $;

--| The value of the step function ` E ` for Euclid's Algorithm on an ordered pair. (Contributed by Paul Chapman, 31-Mar-2011.) (Revised by Mario Carneiro, 28-May-2014.)
theorem eucalgval2 {x3 y1: setvar} (E: class x3 y1) (M N: class):
  $ wceq E (cmpo x3 y1 cn0 cn0 (cif (wceq (cv y1) cc0) (cop (cv x3) (cv y1)) (cop (cv y1) (co (cv x3) (cv y1) cmo)))) $ >
  $ wi (wa (wcel M cn0) (wcel N cn0)) (wceq (co M N E) (cif (wceq N cc0) (cop M N) (cop N (co M N cmo)))) $;

--| Euclid's Algorithm ~ eucalg computes the greatest common divisor of two nonnegative integers by repeatedly replacing the larger of them with its remainder modulo the smaller until the remainder is 0. The value of the step function ` E ` for Euclid's Algorithm. (Contributed by Paul Chapman, 31-Mar-2011.) (Revised by Mario Carneiro, 28-May-2014.)
theorem eucalgval {x3 y1: setvar} (E: class x3 y1) (X: class):
  $ wceq E (cmpo x3 y1 cn0 cn0 (cif (wceq (cv y1) cc0) (cop (cv x3) (cv y1)) (cop (cv y1) (co (cv x3) (cv y1) cmo)))) $ >
  $ wi (wcel X (cxp cn0 cn0)) (wceq (cfv X E) (cif (wceq (cfv X c2nd) cc0) X (cop (cfv X c2nd) (cfv X cmo)))) $;

--| Domain and codomain of the step function ` E ` for Euclid's Algorithm. (Contributed by Paul Chapman, 31-Mar-2011.) (Revised by Mario Carneiro, 28-May-2014.)
theorem eucalgf {x3 y1: setvar} (E: class x3 y1):
  $ wceq E (cmpo x3 y1 cn0 cn0 (cif (wceq (cv y1) cc0) (cop (cv x3) (cv y1)) (cop (cv y1) (co (cv x3) (cv y1) cmo)))) $ >
  $ wf (cxp cn0 cn0) (cxp cn0 cn0) E $;

--| The invariant of the step function ` E ` for Euclid's Algorithm is the ` gcd ` operator applied to the state. (Contributed by Paul Chapman, 31-Mar-2011.) (Revised by Mario Carneiro, 29-May-2014.)
theorem eucalginv {x3 y1: setvar} (E: class x3 y1) (X: class):
  $ wceq E (cmpo x3 y1 cn0 cn0 (cif (wceq (cv y1) cc0) (cop (cv x3) (cv y1)) (cop (cv y1) (co (cv x3) (cv y1) cmo)))) $ >
  $ wi (wcel X (cxp cn0 cn0)) (wceq (cfv (cfv X E) cgcd) (cfv X cgcd)) $;

--| The second member of the state decreases with each iteration of the step function ` E ` for Euclid's Algorithm. (Contributed by Paul Chapman, 31-Mar-2011.) (Revised by Mario Carneiro, 29-May-2014.)
theorem eucalglt {x3 y1: setvar} (E: class x3 y1) (X: class):
  $ wceq E (cmpo x3 y1 cn0 cn0 (cif (wceq (cv y1) cc0) (cop (cv x3) (cv y1)) (cop (cv y1) (co (cv x3) (cv y1) cmo)))) $ >
  $ wi (wcel X (cxp cn0 cn0)) (wi (wne (cfv (cfv X E) c2nd) cc0) (wbr (cfv (cfv X E) c2nd) (cfv X c2nd) clt)) $;

--| Once Euclid's Algorithm halts after ` N ` steps, the second element of the state remains 0 . (Contributed by Paul Chapman, 22-Jun-2011.) (Revised by Mario Carneiro, 29-May-2014.)
theorem eucalgcvga {x3 y1: setvar} (A2: class) (R: class y1) (E K: class x3 y1) (N: class):
  $ wceq E (cmpo x3 y1 cn0 cn0 (cif (wceq (cv y1) cc0) (cop (cv x3) (cv y1)) (cop (cv y1) (co (cv x3) (cv y1) cmo)))) $ >
  $ wceq R (cseq (ccom E c1st) (cxp cn0 (csn A2)) cc0) $ >
  $ wceq N (cfv A2 c2nd) $ >
  $ wi (wcel A2 (cxp cn0 cn0)) (wi (wcel K (cfv N cuz)) (wceq (cfv (cfv K R) c2nd) cc0)) $;

--| Euclid's Algorithm computes the greatest common divisor of two nonnegative integers by repeatedly replacing the larger of them with its remainder modulo the smaller until the remainder is 0. Theorem 1.15 in [ApostolNT] p. 20. Upon halting, the first member of the final state ` ( R `` N ) ` is equal to the gcd of the values comprising the input state ` <. M , N >. ` . This is Metamath 100 proof #69 (greatest common divisor algorithm). (Contributed by Paul Chapman, 31-Mar-2011.) (Proof shortened by Mario Carneiro, 29-May-2014.)
theorem eucalg {x3 y1: setvar} (A2: class) (R: class y1) (E: class x3 y1) (M N: class):
  $ wceq E (cmpo x3 y1 cn0 cn0 (cif (wceq (cv y1) cc0) (cop (cv x3) (cv y1)) (cop (cv y1) (co (cv x3) (cv y1) cmo)))) $ >
  $ wceq R (cseq (ccom E c1st) (cxp cn0 (csn A2)) cc0) $ >
  $ wceq A2 (cop M N) $ >
  $ wi (wa (wcel M cn0) (wcel N cn0)) (wceq (cfv (cfv N R) c1st) (co M N cgcd)) $;

--| Extend the definition of a class to include the least common multiple operator.
term clcm: class;

--| Extend the definition of a class to include the least common multiple function.
term clcmf: class;

--| Define the ` lcm ` operator. For example, ` ( 6 lcm 9 ) = 1 8 ` ( ~ ex-lcm ). (Contributed by Steve Rodriguez, 20-Jan-2020.) (Revised by AV, 16-Sep-2020.)
axiom df_lcm {x3 y1 n: setvar}:
  $ wceq clcm (cmpo x3 y1 cz cz (cif (wo (wceq (cv x3) cc0) (wceq (cv y1) cc0)) cc0 (cinf (crab n (wa (wbr (cv x3) (cv n) cdvds) (wbr (cv y1) (cv n) cdvds)) cn) cr clt))) $;

--| Define the ` _lcm ` function on a set of integers. (Contributed by AV, 21-Aug-2020.) (Revised by AV, 16-Sep-2020.)
axiom df_lcmf {z m n: setvar}:
  $ wceq clcmf (cmpt z (cpw cz) (cif (wcel cc0 (cv z)) cc0 (cinf (crab n (wral m (wbr (cv m) (cv n) cdvds) (cv z)) cn) cr clt))) $;

--| Value of the ` lcm ` operator. ` ( M lcm N ) ` is the least common multiple of ` M ` and ` N ` . If either ` M ` or ` N ` is ` 0 ` , the result is defined conventionally as ` 0 ` . Contrast with ~ df-gcd and ~ gcdval . (Contributed by Steve Rodriguez, 20-Jan-2020.) (Revised by AV, 16-Sep-2020.)
theorem lcmval {n: setvar} (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wceq (co M N clcm) (cif (wo (wceq M cc0) (wceq N cc0)) cc0 (cinf (crab n (wa (wbr M (cv n) cdvds) (wbr N (cv n) cdvds)) cn) cr clt))) $;

--| The ` lcm ` operator is commutative. (Contributed by Steve Rodriguez, 20-Jan-2020.) (Proof shortened by AV, 16-Sep-2020.)
theorem lcmcom (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wceq (co M N clcm) (co N M clcm)) $;

--| The value, by convention, of the ` lcm ` operator when either operand is 0. (Use ~ lcmcom for a left-hand 0.) (Contributed by Steve Rodriguez, 20-Jan-2020.) (Proof shortened by AV, 16-Sep-2020.)
theorem lcm0val (M: class):
  $ wi (wcel M cz) (wceq (co M cc0 clcm) cc0) $;

--| The value of the ` lcm ` operator when both operands are nonzero. (Contributed by Steve Rodriguez, 20-Jan-2020.) (Revised by AV, 16-Sep-2020.)
theorem lcmn0val {n: setvar} (M N: class):
  $ wi (wa (wa (wcel M cz) (wcel N cz)) (wn (wo (wceq M cc0) (wceq N cc0)))) (wceq (co M N clcm) (cinf (crab n (wa (wbr M (cv n) cdvds) (wbr N (cv n) cdvds)) cn) cr clt)) $;

--| Lemma for ~ lcmn0cl and ~ dvdslcm . (Contributed by Steve Rodriguez, 20-Jan-2020.) (Proof shortened by AV, 16-Sep-2020.)
theorem lcmcllem {n: setvar} (M N: class):
  $ wi (wa (wa (wcel M cz) (wcel N cz)) (wn (wo (wceq M cc0) (wceq N cc0)))) (wcel (co M N clcm) (crab n (wa (wbr M (cv n) cdvds) (wbr N (cv n) cdvds)) cn)) $;

--| Closure of the ` lcm ` operator. (Contributed by Steve Rodriguez, 20-Jan-2020.)
theorem lcmn0cl (M N: class):
  $ wi (wa (wa (wcel M cz) (wcel N cz)) (wn (wo (wceq M cc0) (wceq N cc0)))) (wcel (co M N clcm) cn) $;

--| The lcm of two integers is divisible by each of them. (Contributed by Steve Rodriguez, 20-Jan-2020.)
theorem dvdslcm (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wa (wbr M (co M N clcm) cdvds) (wbr N (co M N clcm) cdvds)) $;

--| A positive integer which both operands of the ` lcm ` operator divide bounds it. (Contributed by Steve Rodriguez, 20-Jan-2020.) (Proof shortened by AV, 16-Sep-2020.)
theorem lcmledvds (K M N: class):
  $ wi (wa (w3a (wcel K cn) (wcel M cz) (wcel N cz)) (wn (wo (wceq M cc0) (wceq N cc0)))) (wi (wa (wbr M K cdvds) (wbr N K cdvds)) (wbr (co M N clcm) K cle)) $;

--| The lcm of two integers is zero iff either is zero. (Contributed by Steve Rodriguez, 20-Jan-2020.)
theorem lcmeq0 (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wceq (co M N clcm) cc0) (wo (wceq M cc0) (wceq N cc0))) $;

--| Closure of the ` lcm ` operator. (Contributed by Steve Rodriguez, 20-Jan-2020.)
theorem lcmcl (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wcel (co M N clcm) cn0) $;

--| The greatest common divisor of two numbers divides their least common multiple. (Contributed by Steve Rodriguez, 20-Jan-2020.)
theorem gcddvdslcm (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wbr (co M N cgcd) (co M N clcm) cdvds) $;

--| Negating one operand of the ` lcm ` operator does not alter the result. (Contributed by Steve Rodriguez, 20-Jan-2020.)
theorem lcmneg (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wceq (co M (cneg N) clcm) (co M N clcm)) $;

--| Negating one operand of the ` lcm ` operator does not alter the result. (Contributed by Steve Rodriguez, 20-Jan-2020.)
theorem neglcm (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wceq (co (cneg M) N clcm) (co M N clcm)) $;

--| The lcm of two integers is the same as that of their absolute values. (Contributed by Steve Rodriguez, 20-Jan-2020.)
theorem lcmabs (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wceq (co (cfv M cabs) (cfv N cabs) clcm) (co M N clcm)) $;

--| Lemma for ~ lcmgcd and ~ lcmdvds . Prove them for positive ` M ` , ` N ` , and ` K ` . (Contributed by Steve Rodriguez, 20-Jan-2020.) (Proof shortened by AV, 16-Sep-2020.)
theorem lcmgcdlem (K M N: class):
  $ wi (wa (wcel M cn) (wcel N cn)) (wa (wceq (co (co M N clcm) (co M N cgcd) cmul) (cfv (co M N cmul) cabs)) (wi (wa (wcel K cn) (wa (wbr M K cdvds) (wbr N K cdvds))) (wbr (co M N clcm) K cdvds))) $;

--| The product of two numbers' least common multiple and greatest common divisor is the absolute value of the product of the two numbers. In particular, that absolute value _is_ the least common multiple of two coprime numbers, for which ` ( M gcd N ) = 1 ` . Multiple methods exist for proving this, and it is often proven either as a consequence of the fundamental theorem of arithmetic ~ 1arith or of B&eacute;zout's identity ~ bezout ; see e.g., ~ https://proofwiki.org/wiki/Product_of_GCD_and_LCM and ~ https://math.stackexchange.com/a/470827 . This proof uses the latter to first confirm it for positive integers ` M ` and ` N ` (the "Second Proof" in the above Stack Exchange page), then shows that implies it for all nonzero integer inputs, then finally uses ~ lcm0val to show it applies when either or both inputs are zero. (Contributed by Steve Rodriguez, 20-Jan-2020.)
theorem lcmgcd (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wceq (co (co M N clcm) (co M N cgcd) cmul) (cfv (co M N cmul) cabs)) $;

--| The lcm of two integers divides any integer the two divide. (Contributed by Steve Rodriguez, 20-Jan-2020.)
theorem lcmdvds (K M N: class):
  $ wi (w3a (wcel K cz) (wcel M cz) (wcel N cz)) (wi (wa (wbr M K cdvds) (wbr N K cdvds)) (wbr (co M N clcm) K cdvds)) $;

--| The lcm of an integer and itself is its absolute value. (Contributed by Steve Rodriguez, 20-Jan-2020.)
theorem lcmid (M: class):
  $ wi (wcel M cz) (wceq (co M M clcm) (cfv M cabs)) $;

--| The lcm of an integer and 1 is the absolute value of the integer. (Contributed by AV, 23-Aug-2020.)
theorem lcm1 (M: class):
  $ wi (wcel M cz) (wceq (co M c1 clcm) (cfv M cabs)) $;

--| The product of two positive integers' least common multiple and greatest common divisor is the product of the two integers. (Contributed by AV, 27-Aug-2020.)
theorem lcmgcdnn (M N: class):
  $ wi (wa (wcel M cn) (wcel N cn)) (wceq (co (co M N clcm) (co M N cgcd) cmul) (co M N cmul)) $;

--| Two integers' absolute values are equal iff their least common multiple and greatest common divisor are equal. (Contributed by Steve Rodriguez, 20-Jan-2020.)
theorem lcmgcdeq (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wb (wceq (co M N clcm) (co M N cgcd)) (wceq (cfv M cabs) (cfv N cabs))) $;

--| Biconditional form of ~ lcmdvds . (Contributed by Steve Rodriguez, 20-Jan-2020.)
theorem lcmdvdsb (K M N: class):
  $ wi (w3a (wcel K cz) (wcel M cz) (wcel N cz)) (wb (wa (wbr M K cdvds) (wbr N K cdvds)) (wbr (co M N clcm) K cdvds)) $;

--| Associative law for ` lcm ` operator. (Contributed by Steve Rodriguez, 20-Jan-2020.) (Proof shortened by AV, 16-Sep-2020.)
theorem lcmass (P M N: class):
  $ wi (w3a (wcel N cz) (wcel M cz) (wcel P cz)) (wceq (co (co N M clcm) P clcm) (co N (co M P clcm) clcm)) $;

--| The least common multiple of three and two is six. In contrast to ~ 3lcm2e6 , this proof does not use the property of 2 and 3 being prime, therefore it is much longer. (Contributed by Steve Rodriguez, 20-Jan-2020.) (Revised by AV, 27-Aug-2020.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem _3lcm2e6woprm:
  $ wceq (co c3 c2 clcm) c6 $;

--| The least common multiple of six and four is twelve. (Contributed by AV, 27-Aug-2020.)
theorem _6lcm4e12:
  $ wceq (co c6 c4 clcm) (cdc c1 c2) $;

--| The absolute value of the product of the elements of a finite subset of the integers is divisible by each element of this subset. (Contributed by AV, 21-Aug-2020.)
theorem absproddvds {z m: setvar} (ph: wff) (P: class z m) (Z: class m):
  $ wi ph (wss Z cz) $ >
  $ wi ph (wcel Z cfn) $ >
  $ wceq P (cfv (cprod z Z (cv z)) cabs) $ >
  $ wi ph (wral m (wbr (cv m) P cdvds) Z) $;

--| The absolute value of the product of the elements of a finite subset of the integers not containing 0 is a poitive integer. (Contributed by AV, 21-Aug-2020.)
theorem absprodnn {z: setvar} (ph: wff) (P: class z) (Z: class):
  $ wi ph (wss Z cz) $ >
  $ wi ph (wcel Z cfn) $ >
  $ wceq P (cfv (cprod z Z (cv z)) cabs) $ >
  $ wi ph (wnel cc0 Z) $ >
  $ wi ph (wcel P cn) $;

--| For each finite subset of the integers not containing 0 there is a positive integer which is divisible by each element of this subset. (Contributed by AV, 21-Aug-2020.)
theorem fissn0dvds {m n: setvar} (Z: class):
  $ wi (w3a (wss Z cz) (wcel Z cfn) (wnel cc0 Z)) (wrex n (wral m (wbr (cv m) (cv n) cdvds) Z) cn) $;

--| For each finite subset of the integers not containing 0 there is a positive integer which is divisible by each element of this subset. (Contributed by AV, 21-Aug-2020.)
theorem fissn0dvdsn0 {m n: setvar} (Z: class):
  $ wi (w3a (wss Z cz) (wcel Z cfn) (wnel cc0 Z)) (wne (crab n (wral m (wbr (cv m) (cv n) cdvds) Z) cn) c0) $;

--| Value of the ` _lcm ` function. ` ( _lcm `` Z ) ` is the least common multiple of the integers contained in the finite subset of integers ` Z ` . If at least one of the elements of ` Z ` is ` 0 ` , the result is defined conventionally as ` 0 ` . (Contributed by AV, 21-Apr-2020.) (Revised by AV, 16-Sep-2020.)
theorem lcmfval {m n: setvar} (Z: class):
  $ wi (wa (wss Z cz) (wcel Z cfn)) (wceq (cfv Z clcmf) (cif (wcel cc0 Z) cc0 (cinf (crab n (wral m (wbr (cv m) (cv n) cdvds) Z) cn) cr clt))) $;

--| The value, by convention, of the least common multiple for a set containing 0 is 0. (Contributed by AV, 21-Apr-2020.) (Proof shortened by AV, 16-Sep-2020.)
theorem lcmf0val (Z: class):
  $ wi (wa (wss Z cz) (wcel cc0 Z)) (wceq (cfv Z clcmf) cc0) $;

--| The value of the ` _lcm ` function for a set without 0. (Contributed by AV, 21-Aug-2020.) (Revised by AV, 16-Sep-2020.)
theorem lcmfn0val {m n: setvar} (Z: class):
  $ wi (w3a (wss Z cz) (wcel Z cfn) (wnel cc0 Z)) (wceq (cfv Z clcmf) (cinf (crab n (wral m (wbr (cv m) (cv n) cdvds) Z) cn) cr clt)) $;

--| The value of the ` _lcm ` function for a subset of the positive integers. (Contributed by AV, 21-Aug-2020.) (Revised by AV, 16-Sep-2020.)
theorem lcmfnnval {m n: setvar} (Z: class):
  $ wi (wa (wss Z cn) (wcel Z cfn)) (wceq (cfv Z clcmf) (cinf (crab n (wral m (wbr (cv m) (cv n) cdvds) Z) cn) cr clt)) $;

--| Lemma for ~ lcmfn0cl and ~ dvdslcmf . (Contributed by AV, 21-Aug-2020.) (Proof shortened by AV, 16-Sep-2020.)
theorem lcmfcllem {m n: setvar} (Z: class):
  $ wi (w3a (wss Z cz) (wcel Z cfn) (wnel cc0 Z)) (wcel (cfv Z clcmf) (crab n (wral m (wbr (cv m) (cv n) cdvds) Z) cn)) $;

--| Closure of the ` _lcm ` function. (Contributed by AV, 21-Aug-2020.)
theorem lcmfn0cl (Z: class):
  $ wi (w3a (wss Z cz) (wcel Z cfn) (wnel cc0 Z)) (wcel (cfv Z clcmf) cn) $;

--| The value of the ` _lcm ` function for an unordered pair is the value of the ` lcm ` operator for both elements. (Contributed by AV, 22-Aug-2020.) (Proof shortened by AV, 16-Sep-2020.)
theorem lcmfpr (M N: class):
  $ wi (wa (wcel M cz) (wcel N cz)) (wceq (cfv (cpr M N) clcmf) (co M N clcm)) $;

--| Closure of the ` _lcm ` function. (Contributed by AV, 21-Aug-2020.)
theorem lcmfcl (Z: class):
  $ wi (wa (wss Z cz) (wcel Z cfn)) (wcel (cfv Z clcmf) cn0) $;

--| Closure of the ` _lcm ` function. (Contributed by AV, 20-Apr-2020.)
theorem lcmfnncl (Z: class):
  $ wi (wa (wss Z cn) (wcel Z cfn)) (wcel (cfv Z clcmf) cn) $;

--| The least common multiple of a set of integers is 0 iff at least one of its element is 0. (Contributed by AV, 21-Aug-2020.)
theorem lcmfeq0b (Z: class):
  $ wi (wa (wss Z cz) (wcel Z cfn)) (wb (wceq (cfv Z clcmf) cc0) (wcel cc0 Z)) $;

--| The least common multiple of a set of integers is divisible by each of its elements. (Contributed by AV, 22-Aug-2020.)
theorem dvdslcmf {x3: setvar} (Z: class):
  $ wi (wa (wss Z cz) (wcel Z cfn)) (wral x3 (wbr (cv x3) (cfv Z clcmf) cdvds) Z) $;

--| A positive integer which is divisible by all elements of a set of integers bounds the least common multiple of the set. (Contributed by AV, 22-Aug-2020.) (Proof shortened by AV, 16-Sep-2020.)
theorem lcmfledvds {m: setvar} (K Z: class):
  $ wi (w3a (wss Z cz) (wcel Z cfn) (wnel cc0 Z)) (wi (wa (wcel K cn) (wral m (wbr (cv m) K cdvds) Z)) (wbr (cfv Z clcmf) K cle)) $;

--| Characterization of the least common multiple of a set of integers (without 0): A positiven integer is the least common multiple of a set of integers iff it divides each of the elements of the set and every integer which divides each of the elements of the set is greater than or equal to this integer. (Contributed by AV, 22-Aug-2020.)
theorem lcmf {k m: setvar} (K Z: class):
  $ wi (wa (wcel K cn) (w3a (wss Z cz) (wcel Z cfn) (wnel cc0 Z))) (wb (wceq K (cfv Z clcmf)) (wa (wral m (wbr (cv m) K cdvds) Z) (wral k (wi (wral m (wbr (cv m) (cv k) cdvds) Z) (wbr K (cv k) cle)) cn))) $;

--| The least common multiple of the empty set is 1. (Contributed by AV, 22-Aug-2020.) (Proof shortened by AV, 16-Sep-2020.)
theorem lcmf0:
  $ wceq (cfv c0 clcmf) c1 $;

--| The least common multiple of a singleton is its absolute value. (Contributed by AV, 22-Aug-2020.)
theorem lcmfsn (M: class):
  $ wi (wcel M cz) (wceq (cfv (csn M) clcmf) (cfv M cabs)) $;

--| The least common multiple of a triple of integers is the least common multiple of the third integer and the least common multiple of the first two integers. Although there would be a shorter proof using ~ lcmfunsn , this explicit proof (not based on induction) should be kept. (Proof modification is discouraged.) (Contributed by AV, 23-Aug-2020.)
theorem lcmftp (A2 B2 C: class):
  $ wi (w3a (wcel A2 cz) (wcel B2 cz) (wcel C cz)) (wceq (cfv (ctp A2 B2 C) clcmf) (co (co A2 B2 clcm) C clcm)) $;

--| Lemma for ~ lcmfdvds and ~ lcmfunsnlem (Induction step part 1). (Contributed by AV, 25-Aug-2020.)
theorem lcmfunsnlem1 {k m n: setvar} (y1 z: setvar):
  $ wi (wa (w3a (wcel (cv z) cz) (wss (cv y1) cz) (wcel (cv y1) cfn)) (wa (wral k (wi (wral m (wbr (cv m) (cv k) cdvds) (cv y1)) (wbr (cfv (cv y1) clcmf) (cv k) cdvds)) cz) (wral n (wceq (cfv (cun (cv y1) (csn (cv n))) clcmf) (co (cfv (cv y1) clcmf) (cv n) clcm)) cz))) (wral k (wi (wral m (wbr (cv m) (cv k) cdvds) (cun (cv y1) (csn (cv z)))) (wbr (cfv (cun (cv y1) (csn (cv z))) clcmf) (cv k) cdvds)) cz) $;

--| Lemma 1 for ~ lcmfunsnlem2 . (Contributed by AV, 26-Aug-2020.)
theorem lcmfunsnlem2lem1 {z i k m n: setvar} (y1: setvar):
  $ wi (wa (w3a (wnel cc0 (cv y1)) (wne (cv z) cc0) (wne (cv n) cc0)) (wa (wcel (cv n) cz) (wa (w3a (wcel (cv z) cz) (wss (cv y1) cz) (wcel (cv y1) cfn)) (wa (wral k (wi (wral m (wbr (cv m) (cv k) cdvds) (cv y1)) (wbr (cfv (cv y1) clcmf) (cv k) cdvds)) cz) (wral n (wceq (cfv (cun (cv y1) (csn (cv n))) clcmf) (co (cfv (cv y1) clcmf) (cv n) clcm)) cz))))) (wral k (wi (wral i (wbr (cv i) (cv k) cdvds) (cun (cun (cv y1) (csn (cv z))) (csn (cv n)))) (wbr (co (cfv (cun (cv y1) (csn (cv z))) clcmf) (cv n) clcm) (cv k) cle)) cn) $;

--| Lemma 2 for ~ lcmfunsnlem2 . (Contributed by AV, 26-Aug-2020.)
theorem lcmfunsnlem2lem2 {z k m n: setvar} (y1: setvar):
  $ wi (wa (w3a (wnel cc0 (cv y1)) (wne (cv z) cc0) (wne (cv n) cc0)) (wa (wcel (cv n) cz) (wa (w3a (wcel (cv z) cz) (wss (cv y1) cz) (wcel (cv y1) cfn)) (wa (wral k (wi (wral m (wbr (cv m) (cv k) cdvds) (cv y1)) (wbr (cfv (cv y1) clcmf) (cv k) cdvds)) cz) (wral n (wceq (cfv (cun (cv y1) (csn (cv n))) clcmf) (co (cfv (cv y1) clcmf) (cv n) clcm)) cz))))) (wceq (cfv (cun (cun (cv y1) (csn (cv z))) (csn (cv n))) clcmf) (co (cfv (cun (cv y1) (csn (cv z))) clcmf) (cv n) clcm)) $;

--| Lemma for ~ lcmfunsn and ~ lcmfunsnlem (Induction step part 2). (Contributed by AV, 26-Aug-2020.)
theorem lcmfunsnlem2 {z k m n: setvar} (y1: setvar):
  $ wi (wa (w3a (wcel (cv z) cz) (wss (cv y1) cz) (wcel (cv y1) cfn)) (wa (wral k (wi (wral m (wbr (cv m) (cv k) cdvds) (cv y1)) (wbr (cfv (cv y1) clcmf) (cv k) cdvds)) cz) (wral n (wceq (cfv (cun (cv y1) (csn (cv n))) clcmf) (co (cfv (cv y1) clcmf) (cv n) clcm)) cz))) (wral n (wceq (cfv (cun (cun (cv y1) (csn (cv z))) (csn (cv n))) clcmf) (co (cfv (cun (cv y1) (csn (cv z))) clcmf) (cv n) clcm)) cz) $;

--| Lemma for ~ lcmfdvds and ~ lcmfunsn . These two theorems must be proven simultaneously by induction on the cardinality of a finite set ` Y ` , because they depend on each other. This can be seen by the two parts ~ lcmfunsnlem1 and ~ lcmfunsnlem2 of the induction step, each of them using both induction hypotheses. (Contributed by AV, 26-Aug-2020.)
theorem lcmfunsnlem {k m n: setvar} (Y: class):
  $ wi (wa (wss Y cz) (wcel Y cfn)) (wa (wral k (wi (wral m (wbr (cv m) (cv k) cdvds) Y) (wbr (cfv Y clcmf) (cv k) cdvds)) cz) (wral n (wceq (cfv (cun Y (csn (cv n))) clcmf) (co (cfv Y clcmf) (cv n) clcm)) cz)) $;

--| The least common multiple of a set of integers divides any integer which is divisible by all elements of the set. (Contributed by AV, 26-Aug-2020.)
theorem lcmfdvds {m: setvar} (K Z: class):
  $ wi (w3a (wcel K cz) (wss Z cz) (wcel Z cfn)) (wi (wral m (wbr (cv m) K cdvds) Z) (wbr (cfv Z clcmf) K cdvds)) $;

--| Biconditional form of ~ lcmfdvds . (Contributed by AV, 26-Aug-2020.)
theorem lcmfdvdsb {m: setvar} (K Z: class):
  $ wi (w3a (wcel K cz) (wss Z cz) (wcel Z cfn)) (wb (wral m (wbr (cv m) K cdvds) Z) (wbr (cfv Z clcmf) K cdvds)) $;

--| The ` _lcm ` function for a union of a set of integer and a singleton. (Contributed by AV, 26-Aug-2020.)
theorem lcmfunsn (N Y: class):
  $ wi (w3a (wss Y cz) (wcel Y cfn) (wcel N cz)) (wceq (cfv (cun Y (csn N)) clcmf) (co (cfv Y clcmf) N clcm)) $;

--| The ` _lcm ` function for a union of sets of integers. (Contributed by AV, 27-Aug-2020.)
theorem lcmfun (Y Z: class):
  $ wi (wa (wa (wss Y cz) (wcel Y cfn)) (wa (wss Z cz) (wcel Z cfn))) (wceq (cfv (cun Y Z) clcmf) (co (cfv Y clcmf) (cfv Z clcmf) clcm)) $;

--| Associative law for the ` _lcm ` function. (Contributed by AV, 27-Aug-2020.)
theorem lcmfass (Y Z: class):
  $ wi (wa (wa (wss Y cz) (wcel Y cfn)) (wa (wss Z cz) (wcel Z cfn))) (wceq (cfv (cun (csn (cfv Y clcmf)) Z) clcmf) (cfv (cun Y (csn (cfv Z clcmf))) clcmf)) $;

--| The least common multiple of 2 , 3 and 4 is 12. (Contributed by AV, 27-Aug-2020.)
theorem lcmf2a3a4e12:
  $ wceq (cfv (ctp c2 c3 c4) clcmf) (cdc c1 c2) $;

--| The least common multiple of all positive integers less than or equal to an integer is less than or equal to the factorial of the integer. (Contributed by AV, 16-Aug-2020.) (Revised by AV, 27-Aug-2020.)
theorem lcmflefac (N: class):
  $ wi (wcel N cn) (wbr (cfv (co c1 N cfz) clcmf) (cfv N cfa) cle) $;

--| Two positive integers are coprime, i.e. the only positive integer that divides both of them is 1, iff their greatest common divisor is 1. (Contributed by AV, 9-Aug-2020.)
theorem coprmgcdb {i: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cn) (wcel B2 cn)) (wb (wral i (wi (wa (wbr (cv i) A2 cdvds) (wbr (cv i) B2 cdvds)) (wceq (cv i) c1)) cn) (wceq (co A2 B2 cgcd) c1)) $;

--| Two positive integers are not coprime, i.e. there is an integer greater than 1 which divides both integers, iff their greatest common divisor is not 1. See ~ prmdvdsncoprmbd for a version where the existential quantifier is restricted to primes. (Contributed by AV, 9-Aug-2020.)
theorem ncoprmgcdne1b {i: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cn) (wcel B2 cn)) (wb (wrex i (wa (wbr (cv i) A2 cdvds) (wbr (cv i) B2 cdvds)) (cfv c2 cuz)) (wne (co A2 B2 cgcd) c1)) $;

--| Two positive integers are not coprime, i.e. there is an integer greater than 1 which divides both integers, iff their greatest common divisor is greater than 1. (Contributed by AV, 9-Aug-2020.)
theorem ncoprmgcdgt1b {i: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cn) (wcel B2 cn)) (wb (wrex i (wa (wbr (cv i) A2 cdvds) (wbr (cv i) B2 cdvds)) (cfv c2 cuz)) (wbr c1 (co A2 B2 cgcd) clt)) $;

--| If two positive integers are coprime, i.e. their greatest common divisor is 1, the only positive integer that divides both of them is 1. (Contributed by AV, 4-Aug-2021.)
theorem coprmdvds1 (F G I: class):
  $ wi (w3a (wcel F cn) (wcel G cn) (wceq (co F G cgcd) c1)) (wi (w3a (wcel I cn) (wbr I F cdvds) (wbr I G cdvds)) (wceq I c1)) $;

--| Euclid's Lemma (see ProofWiki "Euclid's Lemma", 10-Jul-2021, ~ https://proofwiki.org/wiki/Euclid's_Lemma ): If an integer divides the product of two integers and is coprime to one of them, then it divides the other. See also theorem 1.5 in [ApostolNT] p. 16. Generalization of ~ euclemma . (Contributed by Paul Chapman, 22-Jun-2011.) (Proof shortened by AV, 10-Jul-2021.)
theorem coprmdvds (K M N: class):
  $ wi (w3a (wcel K cz) (wcel M cz) (wcel N cz)) (wi (wa (wbr K (co M N cmul) cdvds) (wceq (co K M cgcd) c1)) (wbr K N cdvds)) $;

--| If an integer is divisible by two coprime integers, then it is divisible by their product. (Contributed by Mario Carneiro, 24-Feb-2014.)
theorem coprmdvds2 (K M N: class):
  $ wi (wa (w3a (wcel M cz) (wcel N cz) (wcel K cz)) (wceq (co M N cgcd) c1)) (wi (wa (wbr M K cdvds) (wbr N K cdvds)) (wbr (co M N cmul) K cdvds)) $;

--| One half of ~ rpmulgcd2 , which does not need the coprimality assumption. (Contributed by Mario Carneiro, 2-Jul-2015.)
theorem mulgcddvds (K M N: class):
  $ wi (w3a (wcel K cz) (wcel M cz) (wcel N cz)) (wbr (co K (co M N cmul) cgcd) (co (co K M cgcd) (co K N cgcd) cmul) cdvds) $;

--| If ` M ` is relatively prime to ` N ` , then the GCD of ` K ` with ` M x. N ` is the product of the GCDs with ` M ` and ` N ` respectively. (Contributed by Mario Carneiro, 2-Jul-2015.)
theorem rpmulgcd2 (K M N: class):
  $ wi (wa (w3a (wcel K cz) (wcel M cz) (wcel N cz)) (wceq (co M N cgcd) c1)) (wceq (co K (co M N cmul) cgcd) (co (co K M cgcd) (co K N cgcd) cmul)) $;

--| Two equal reduced fractions have the same numerator and denominator. (Contributed by Jeff Hankins, 29-Sep-2013.)
theorem qredeq (P Q M N: class):
  $ wi (w3a (w3a (wcel M cz) (wcel N cn) (wceq (co M N cgcd) c1)) (w3a (wcel P cz) (wcel Q cn) (wceq (co P Q cgcd) c1)) (wceq (co M N cdiv) (co P Q cdiv))) (wa (wceq M P) (wceq N Q)) $;

--| Every rational number has a unique reduced form. (Contributed by Jeff Hankins, 29-Sep-2013.)
theorem qredeu {x3: setvar} (A2: class):
  $ wi (wcel A2 cq) (wreu x3 (wa (wceq (co (cfv (cv x3) c1st) (cfv (cv x3) c2nd) cgcd) c1) (wceq A2 (co (cfv (cv x3) c1st) (cfv (cv x3) c2nd) cdiv))) (cxp cz cn)) $;

--| If ` K ` is relatively prime to ` M ` and to ` N ` , it is also relatively prime to their product. (Contributed by Mario Carneiro, 24-Feb-2014.) (Proof shortened by Mario Carneiro, 2-Jul-2015.)
theorem rpmul (K M N: class):
  $ wi (w3a (wcel K cz) (wcel M cz) (wcel N cz)) (wi (wa (wceq (co K M cgcd) c1) (wceq (co K N cgcd) c1)) (wceq (co K (co M N cmul) cgcd) c1)) $;

--| If ` K ` is relatively prime to ` N ` then it is also relatively prime to any divisor ` M ` of ` N ` . (Contributed by Mario Carneiro, 19-Jun-2015.)
theorem rpdvds (K M N: class):
  $ wi (wa (w3a (wcel K cz) (wcel M cz) (wcel N cz)) (wa (wceq (co K N cgcd) c1) (wbr M N cdvds))) (wceq (co K M cgcd) c1) $;

--| The product of the elements of a sequence of pairwise coprime positive integers is coprime to a positive integer which is coprime to all integers of the sequence. (Contributed by AV, 18-Aug-2020.)
theorem coprmprod {m n: setvar} (F: class n) (M N: class):
  $ wi (w3a (w3a (wcel M cfn) (wss M cn) (wcel N cn)) (wf cn cn F) (wral m (wceq (co (cfv (cv m) F) N cgcd) c1) M)) (wi (wral m (wral n (wceq (co (cfv (cv m) F) (cfv (cv n) F) cgcd) c1) (cdif M (csn (cv m)))) M) (wceq (co (cprod m M (cfv (cv m) F)) N cgcd) c1)) $;

--| Lemma for ~ coprmproddvds : Induction step. (Contributed by AV, 19-Aug-2020.)
theorem coprmproddvdslem {z m n: setvar} (y1: setvar) (F: class z) (K: class n):
  $ wi (wa (wcel (cv y1) cfn) (wn (wcel (cv z) (cv y1)))) (wi (wi (wa (wa (wss (cv y1) cn) (wa (wcel K cn) (wf cn cn F))) (wa (wral m (wral n (wceq (co (cfv (cv m) F) (cfv (cv n) F) cgcd) c1) (cdif (cv y1) (csn (cv m)))) (cv y1)) (wral m (wbr (cfv (cv m) F) K cdvds) (cv y1)))) (wbr (cprod m (cv y1) (cfv (cv m) F)) K cdvds)) (wi (wa (wa (wss (cun (cv y1) (csn (cv z))) cn) (wa (wcel K cn) (wf cn cn F))) (wa (wral m (wral n (wceq (co (cfv (cv m) F) (cfv (cv n) F) cgcd) c1) (cdif (cun (cv y1) (csn (cv z))) (csn (cv m)))) (cun (cv y1) (csn (cv z)))) (wral m (wbr (cfv (cv m) F) K cdvds) (cun (cv y1) (csn (cv z)))))) (wbr (cprod m (cun (cv y1) (csn (cv z))) (cfv (cv m) F)) K cdvds))) $;

--| If a positive integer is divisible by each element of a set of pairwise coprime positive integers, then it is divisible by their product. (Contributed by AV, 19-Aug-2020.)
theorem coprmproddvds {m n: setvar} (F: class) (K: class n) (M: class):
  $ wi (w3a (wa (wss M cn) (wcel M cfn)) (wa (wcel K cn) (wf cn cn F)) (wa (wral m (wral n (wceq (co (cfv (cv m) F) (cfv (cv n) F) cgcd) c1) (cdif M (csn (cv m)))) M) (wral m (wbr (cfv (cv m) F) K cdvds) M))) (wbr (cprod m M (cfv (cv m) F)) K cdvds) $;

--| Definition of congruence by integer multiple (see ProofWiki "Congruence (Number Theory)", 11-Jul-2021, ~ https://proofwiki.org/wiki/Definition:Congruence_(Number_Theory) ): An integer ` A ` is congruent to an integer ` B ` modulo ` M ` if their difference is a multiple of ` M ` . See also the definition in [ApostolNT] p. 104: "... ` a ` is congruent to ` b ` modulo ` m ` , and we write ` a == b ` (mod ` m ` ) if ` m ` divides the difference ` a - b ` ", or Wikipedia "Modular arithmetic - Congruence", ~ https://en.wikipedia.org/wiki/Modular_arithmetic#Congruence , 11-Jul-2021,: "Given an integer n > 1, called a modulus, two integers are said to be congruent modulo n, if n is a divisor of their difference (i.e., if there is an integer k such that a-b = kn)". (Contributed by AV, 11-Jul-2021.)
theorem congr {n: setvar} (A2 B2 M: class):
  $ wi (w3a (wcel A2 cz) (wcel B2 cz) (wcel M cn)) (wb (wceq (co A2 M cmo) (co B2 M cmo)) (wrex n (wceq (co (cv n) M cmul) (co A2 B2 cmin)) cz)) $;

--| Integers divided by gcd are coprime. (Contributed by AV, 12-Jul-2021.)
theorem divgcdcoprm0 (A2 B2: class):
  $ wi (w3a (wcel A2 cz) (wcel B2 cz) (wne B2 cc0)) (wceq (co (co A2 (co A2 B2 cgcd) cdiv) (co B2 (co A2 B2 cgcd) cdiv) cgcd) c1) $;

--| Integers divided by gcd are coprime (see ProofWiki "Integers Divided by GCD are Coprime", 11-Jul-2021, ~ https://proofwiki.org/wiki/Integers_Divided_by_GCD_are_Coprime ): Any pair of integers, not both zero, can be reduced to a pair of coprime ones by dividing them by their gcd. (Contributed by AV, 12-Jul-2021.)
theorem divgcdcoprmex {a b: setvar} (A2 B2 M: class):
  $ wi (w3a (wcel A2 cz) (wa (wcel B2 cz) (wne B2 cc0)) (wceq M (co A2 B2 cgcd))) (wrex a (wrex b (w3a (wceq A2 (co M (cv a) cmul)) (wceq B2 (co M (cv b) cmul)) (wceq (co (cv a) (cv b) cgcd) c1)) cz) cz) $;

--| One direction of the bicondition in ~ cncongr . Theorem 5.4 in [ApostolNT] p. 109. (Contributed by AV, 13-Jul-2021.)
theorem cncongr1 (A2 B2 C M N: class):
  $ wi (wa (w3a (wcel A2 cz) (wcel B2 cz) (wcel C cz)) (wa (wcel N cn) (wceq M (co N (co C N cgcd) cdiv)))) (wi (wceq (co (co A2 C cmul) N cmo) (co (co B2 C cmul) N cmo)) (wceq (co A2 M cmo) (co B2 M cmo))) $;

--| The other direction of the bicondition in ~ cncongr . (Contributed by AV, 11-Jul-2021.)
theorem cncongr2 (A2 B2 C M N: class):
  $ wi (wa (w3a (wcel A2 cz) (wcel B2 cz) (wcel C cz)) (wa (wcel N cn) (wceq M (co N (co C N cgcd) cdiv)))) (wi (wceq (co A2 M cmo) (co B2 M cmo)) (wceq (co (co A2 C cmul) N cmo) (co (co B2 C cmul) N cmo))) $;

--| Cancellability of Congruences (see ProofWiki "Cancellability of Congruences, ~ https://proofwiki.org/wiki/Cancellability_of_Congruences , 10-Jul-2021): Two products with a common factor are congruent modulo a positive integer iff the other factors are congruent modulo the integer divided by the greatest common divisor of the integer and the common factor. See also Theorem 5.4 "Cancellation law" in [ApostolNT] p. 109. (Contributed by AV, 13-Jul-2021.)
theorem cncongr (A2 B2 C M N: class):
  $ wi (wa (w3a (wcel A2 cz) (wcel B2 cz) (wcel C cz)) (wa (wcel N cn) (wceq M (co N (co C N cgcd) cdiv)))) (wb (wceq (co (co A2 C cmul) N cmo) (co (co B2 C cmul) N cmo)) (wceq (co A2 M cmo) (co B2 M cmo))) $;

--| Corollary 1 of Cancellability of Congruences: Two products with a common factor are congruent modulo an integer being coprime to the common factor iff the other factors are congruent modulo the integer. (Contributed by AV, 13-Jul-2021.)
theorem cncongrcoprm (A2 B2 C N: class):
  $ wi (wa (w3a (wcel A2 cz) (wcel B2 cz) (wcel C cz)) (wa (wcel N cn) (wceq (co C N cgcd) c1))) (wb (wceq (co (co A2 C cmul) N cmo) (co (co B2 C cmul) N cmo)) (wceq (co A2 N cmo) (co B2 N cmo))) $;

--| Extend the definition of a class to include the set of prime numbers.
term cprime: class;

--| Define the set of prime numbers. (Contributed by Paul Chapman, 22-Jun-2011.)
axiom df_prm {n p: setvar}:
  $ wceq cprime (crab p (wbr (crab n (wbr (cv n) (cv p) cdvds) cn) c2o cen) cn) $;

--| The predicate "is a prime number". A prime number is a positive integer with exactly two positive divisors. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem isprm {n: setvar} (P: class):
  $ wb (wcel P cprime) (wa (wcel P cn) (wbr (crab n (wbr (cv n) P cdvds) cn) c2o cen)) $;

--| A prime number is a positive integer. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem prmnn (P: class):
  $ wi (wcel P cprime) (wcel P cn) $;

--| A prime number is an integer. (Contributed by Paul Chapman, 22-Jun-2011.) (Proof shortened by Jonathan Yan, 16-Jul-2017.)
theorem prmz (P: class):
  $ wi (wcel P cprime) (wcel P cz) $;

--| The prime numbers are a subset of the positive integers. (Contributed by AV, 22-Jul-2020.)
theorem prmssnn:
  $ wss cprime cn $;

--| The set of prime numbers exists. (Contributed by AV, 22-Jul-2020.)
theorem prmex:
  $ wcel cprime cvv $;

--| 0 is not a prime number. Already Definition ~ df-prm excludes 0 from being prime ( ` Prime = { p e. NN | ... ` ), but even if ` p e. NN0 ` was allowed, the condition ` { n e. NN | n || p } ~~ 2o ` would not hold for ` p = 0 ` , because ` { n e. NN | n || 0 } = NN ` , see ~ dvds0 , and ` -. NN ~~ 2o ` (there are more than 2 positive integers). (Contributed by AV, 29-May-2023.)
theorem _0nprm:
  $ wn (wcel cc0 cprime) $;

--| 1 is not a prime number. (Contributed by Paul Chapman, 22-Jun-2011.) (Proof shortened by Fan Zheng, 3-Jul-2016.)
theorem _1nprm:
  $ wn (wcel c1 cprime) $;

--| The positive divisors of a positive integer include 1 and itself. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem _1idssfct {n: setvar} (N: class):
  $ wi (wcel N cn) (wss (cpr c1 N) (crab n (wbr (cv n) N cdvds) cn)) $;

--| Lemma for ~ isprm2 . (Contributed by Paul Chapman, 22-Jun-2011.)
theorem isprm2lem {n: setvar} (P: class):
  $ wi (wa (wcel P cn) (wne P c1)) (wb (wbr (crab n (wbr (cv n) P cdvds) cn) c2o cen) (wceq (crab n (wbr (cv n) P cdvds) cn) (cpr c1 P))) $;

--| The predicate "is a prime number". A prime number is an integer greater than or equal to 2 whose only positive divisors are 1 and itself. Definition in [ApostolNT] p. 16. (Contributed by Paul Chapman, 26-Oct-2012.)
theorem isprm2 {z: setvar} (P: class):
  $ wb (wcel P cprime) (wa (wcel P (cfv c2 cuz)) (wral z (wi (wbr (cv z) P cdvds) (wo (wceq (cv z) c1) (wceq (cv z) P))) cn)) $;

--| The predicate "is a prime number". A prime number is an integer greater than or equal to 2 with no divisors strictly between 1 and itself. (Contributed by Paul Chapman, 26-Oct-2012.)
theorem isprm3 {z: setvar} (P: class):
  $ wb (wcel P cprime) (wa (wcel P (cfv c2 cuz)) (wral z (wn (wbr (cv z) P cdvds)) (co c2 (co P c1 cmin) cfz))) $;

--| The predicate "is a prime number". A prime number is an integer greater than or equal to 2 whose only divisor greater than or equal to 2 is itself. (Contributed by Paul Chapman, 26-Oct-2012.)
theorem isprm4 {z: setvar} (P: class):
  $ wb (wcel P cprime) (wa (wcel P (cfv c2 cuz)) (wral z (wi (wbr (cv z) P cdvds) (wceq (cv z) P)) (cfv c2 cuz))) $;

--| A variation on ~ prmind assuming complete induction for primes. (Contributed by Mario Carneiro, 20-Jun-2015.)
theorem prmind2 {x3 y1 z: setvar} (ph: wff x3) (ps: wff x3 y1 z) (ch: wff y1) (th ta et: wff y1 z) (A2: class y1 z):
  $ wi (wceq (cv x3) c1) (wb ph ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ch) $ >
  $ wi (wceq (cv x3) (cv z)) (wb ph th) $ >
  $ wi (wceq (cv x3) (co (cv y1) (cv z) cmul)) (wb ph ta) $ >
  $ wi (wceq (cv x3) A2) (wb ph et) $ >
  $ ps $ >
  $ wi (wa (wcel (cv x3) cprime) (wral y1 ch (co c1 (co (cv x3) c1 cmin) cfz))) ph $ >
  $ wi (wa (wcel (cv y1) (cfv c2 cuz)) (wcel (cv z) (cfv c2 cuz))) (wi (wa ch th) ta) $ >
  $ wi (wcel A2 cn) et $;

--| Perform induction over the multiplicative structure of ` NN ` . If a property ` ph ( x ) ` holds for the primes and ` 1 ` and is preserved under multiplication, then it holds for every positive integer. (Contributed by Mario Carneiro, 20-Jun-2015.)
theorem prmind {x3 y1 z: setvar} (ph: wff x3) (ps: wff x3 y1 z) (ch: wff y1) (th ta et: wff y1 z) (A2: class y1 z):
  $ wi (wceq (cv x3) c1) (wb ph ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ch) $ >
  $ wi (wceq (cv x3) (cv z)) (wb ph th) $ >
  $ wi (wceq (cv x3) (co (cv y1) (cv z) cmul)) (wb ph ta) $ >
  $ wi (wceq (cv x3) A2) (wb ph et) $ >
  $ ps $ >
  $ wi (wcel (cv x3) cprime) ph $ >
  $ wi (wa (wcel (cv y1) (cfv c2 cuz)) (wcel (cv z) (cfv c2 cuz))) (wi (wa ch th) ta) $ >
  $ wi (wcel A2 cn) et $;

--| If ` M ` divides a prime, then ` M ` is either the prime or one. (Contributed by Scott Fenton, 8-Apr-2014.)
theorem dvdsprime (P M: class):
  $ wi (wa (wcel P cprime) (wcel M cn)) (wb (wbr M P cdvds) (wo (wceq M P) (wceq M c1))) $;

--| A product of two integers greater than one is composite. (Contributed by Mario Carneiro, 20-Jun-2015.)
theorem nprm (A2 B2: class):
  $ wi (wa (wcel A2 (cfv c2 cuz)) (wcel B2 (cfv c2 cuz))) (wn (wcel (co A2 B2 cmul) cprime)) $;

--| An inference for compositeness. (Contributed by Mario Carneiro, 18-Feb-2014.) (Revised by Mario Carneiro, 20-Jun-2015.)
theorem nprmi (A2 B2 N: class):
  $ wcel A2 cn $ >
  $ wcel B2 cn $ >
  $ wbr c1 A2 clt $ >
  $ wbr c1 B2 clt $ >
  $ wceq (co A2 B2 cmul) N $ >
  $ wn (wcel N cprime) $;

--| If a number is divisible by an integer greater than 1 and less than the number, the number is not prime. (Contributed by AV, 24-Jul-2021.)
theorem dvdsnprmd (ph: wff) (A2 N: class):
  $ wi ph (wbr c1 A2 clt) $ >
  $ wi ph (wbr A2 N clt) $ >
  $ wi ph (wbr A2 N cdvds) $ >
  $ wi ph (wn (wcel N cprime)) $;

--| A prime number is either 2 or odd. (Contributed by AV, 19-Jun-2021.)
theorem prm2orodd (P: class):
  $ wi (wcel P cprime) (wo (wceq P c2) (wn (wbr c2 P cdvds))) $;

--| 2 is a prime number. (Contributed by Paul Chapman, 22-Jun-2011.) (Proof shortened by Fan Zheng, 16-Jun-2016.)
theorem _2prm:
  $ wcel c2 cprime $;

--| A multiple of two is prime iff the multiplier is one. (Contributed by AV, 8-Jun-2023.)
theorem _2mulprm (A2: class):
  $ wi (wcel A2 cz) (wb (wcel (co c2 A2 cmul) cprime) (wceq A2 c1)) $;

--| 3 is a prime number. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem _3prm:
  $ wcel c3 cprime $;

--| 4 is not a prime number. (Contributed by Paul Chapman, 22-Jun-2011.) (Proof shortened by Mario Carneiro, 18-Feb-2014.)
theorem _4nprm:
  $ wn (wcel c4 cprime) $;

--| A prime number is an integer greater than or equal to 2. (Contributed by Paul Chapman, 17-Nov-2012.)
theorem prmuz2 (P: class):
  $ wi (wcel P cprime) (wcel P (cfv c2 cuz)) $;

--| The primes are integers greater than 1. (Contributed by AV, 10-Apr-2026.)
theorem prmssuz2:
  $ wss cprime (cfv c2 cuz) $;

--| A prime number is an integer greater than 1. (Contributed by Alexander van der Vekens, 17-May-2018.)
theorem prmgt1 (P: class):
  $ wi (wcel P cprime) (wbr c1 P clt) $;

--| Subtracting 2 from a prime number results in a nonnegative integer. (Contributed by Alexander van der Vekens, 30-Aug-2018.)
theorem prmm2nn0 (P: class):
  $ wi (wcel P cprime) (wcel (co P c2 cmin) cn0) $;

--| An odd prime is greater than 2. (Contributed by AV, 20-Aug-2021.)
theorem oddprmgt2 (P: class):
  $ wi (wcel P (cdif cprime (csn c2))) (wbr c2 P clt) $;

--| An odd prime is greater than or equal to 3. (Contributed by Alexander van der Vekens, 7-Oct-2018.) (Revised by AV, 20-Aug-2021.)
theorem oddprmge3 (P: class):
  $ wi (wcel P (cdif cprime (csn c2))) (wcel P (cfv c3 cuz)) $;

--| A composite integer greater than or equal to ` 2 ` is greater than or equal to ` 4 ` . (Contributed by AV, 5-Jun-2023.)
theorem ge2nprmge4 (X: class):
  $ wi (wa (wcel X (cfv c2 cuz)) (wnel X cprime)) (wcel X (cfv c4 cuz)) $;

--| A square is never prime. (Contributed by Mario Carneiro, 20-Jun-2015.)
theorem sqnprm (A2: class):
  $ wi (wcel A2 cz) (wn (wcel (co A2 c2 cexp) cprime)) $;

--| An integer greater than or equal to 2 divides a prime number iff it is equal to it. (Contributed by Paul Chapman, 26-Oct-2012.)
theorem dvdsprm (P N: class):
  $ wi (wa (wcel N (cfv c2 cuz)) (wcel P cprime)) (wb (wbr N P cdvds) (wceq N P)) $;

--| Every integer greater than or equal to 2 has a prime factor. (Contributed by Paul Chapman, 26-Oct-2012.) (Proof shortened by Mario Carneiro, 20-Jun-2015.)
theorem exprmfct {p: setvar} (N: class):
  $ wi (wcel N (cfv c2 cuz)) (wrex p (wbr (cv p) N cdvds) cprime) $;

--| Each integer greater than 1 and less than or equal to a fixed number is divisible by a prime less than or equal to this fixed number. (Contributed by AV, 15-Aug-2020.)
theorem prmdvdsfz {p: setvar} (I N: class):
  $ wi (wa (wcel N cn) (wcel I (co c2 N cfz))) (wrex p (wa (wbr (cv p) N cle) (wbr (cv p) I cdvds)) cprime) $;

--| No prime number divides 1. (Contributed by Paul Chapman, 17-Nov-2012.) (Proof shortened by Mario Carneiro, 2-Jul-2015.)
theorem nprmdvds1 (P: class):
  $ wi (wcel P cprime) (wn (wbr P c1 cdvds)) $;

--| One need only check prime divisors of ` P ` up to ` sqrt P ` in order to ensure primality. (Contributed by Mario Carneiro, 18-Feb-2014.)
theorem isprm5 {z: setvar} (P: class):
  $ wb (wcel P cprime) (wa (wcel P (cfv c2 cuz)) (wral z (wi (wbr (co (cv z) c2 cexp) P cle) (wn (wbr (cv z) P cdvds))) cprime)) $;

--| One need only check prime divisors of ` P ` up to ` sqrt P ` in order to ensure primality. This version of ~ isprm5 combines the primality and bound on ` z ` into a finite interval of prime numbers. (Contributed by Steve Rodriguez, 20-Jan-2020.)
theorem isprm7 {z: setvar} (P: class):
  $ wb (wcel P cprime) (wa (wcel P (cfv c2 cuz)) (wral z (wn (wbr (cv z) P cdvds)) (cin (co c2 (cfv (cfv P csqrt) cfl) cfz) cprime))) $;

--| The set of prime factors of an integer greater than or equal to 2 satisfies the conditions to have a supremum, and that supremum is a member of the set. (Contributed by Paul Chapman, 17-Nov-2012.)
theorem maxprmfct {x3 y1 z: setvar} (S: class z) (N: class):
  $ wceq S (crab z (wbr (cv z) N cdvds) cprime) $ >
  $ wi (wcel N (cfv c2 cuz)) (wa (w3a (wss S cz) (wne S c0) (wrex x3 (wral y1 (wbr (cv y1) (cv x3) cle) S) cz)) (wcel (csup S cr clt) S)) $;

--| Either ` A / ( A gcd B ) ` is odd or ` B / ( A gcd B ) ` is odd. (Contributed by Scott Fenton, 19-Apr-2014.)
theorem divgcdodd (A2 B2: class):
  $ wi (wa (wcel A2 cn) (wcel B2 cn)) (wo (wn (wbr c2 (co A2 (co A2 B2 cgcd) cdiv) cdvds)) (wn (wbr c2 (co B2 (co A2 B2 cgcd) cdiv) cdvds))) $;

--| A prime number either divides an integer or is coprime to it, but not both. Theorem 1.8 in [ApostolNT] p. 17. (Contributed by Paul Chapman, 22-Jun-2011.)
theorem coprm (P N: class):
  $ wi (wa (wcel P cprime) (wcel N cz)) (wb (wn (wbr P N cdvds)) (wceq (co P N cgcd) c1)) $;

--| Unequal prime numbers are relatively prime. (Contributed by Mario Carneiro, 23-Feb-2014.)
theorem prmrp (P Q: class):
  $ wi (wa (wcel P cprime) (wcel Q cprime)) (wb (wceq (co P Q cgcd) c1) (wne P Q)) $;

--| Euclid's lemma. A prime number divides the product of two integers iff it divides at least one of them. Theorem 1.9 in [ApostolNT] p. 17. (Contributed by Paul Chapman, 17-Nov-2012.)
theorem euclemma (P M N: class):
  $ wi (w3a (wcel P cprime) (wcel M cz) (wcel N cz)) (wb (wbr P (co M N cmul) cdvds) (wo (wbr P M cdvds) (wbr P N cdvds))) $;

--| A number is prime iff it satisfies Euclid's lemma ~ euclemma . (Contributed by Mario Carneiro, 6-Sep-2015.)
theorem isprm6 {x3 y1: setvar} (P: class):
  $ wb (wcel P cprime) (wa (wcel P (cfv c2 cuz)) (wral x3 (wral y1 (wi (wbr P (co (cv x3) (cv y1) cmul) cdvds) (wo (wbr P (cv x3) cdvds) (wbr P (cv y1) cdvds))) cz) cz)) $;

--| A prime divides a positive power of an integer iff it divides the integer. (Contributed by Mario Carneiro, 24-Feb-2014.) (Revised by Mario Carneiro, 17-Jul-2014.)
theorem prmdvdsexp (A2 P N: class):
  $ wi (w3a (wcel P cprime) (wcel A2 cz) (wcel N cn)) (wb (wbr P (co A2 N cexp) cdvds) (wbr P A2 cdvds)) $;

--| A prime divides a positive power of another iff they are equal. (Contributed by Paul Chapman, 30-Nov-2012.) (Revised by Mario Carneiro, 24-Feb-2014.)
theorem prmdvdsexpb (P Q N: class):
  $ wi (w3a (wcel P cprime) (wcel Q cprime) (wcel N cn)) (wb (wbr P (co Q N cexp) cdvds) (wceq P Q)) $;

--| If a prime divides a nonnegative power of another, then they are equal. (Contributed by Mario Carneiro, 16-Jan-2015.)
theorem prmdvdsexpr (P Q N: class):
  $ wi (w3a (wcel P cprime) (wcel Q cprime) (wcel N cn0)) (wi (wbr P (co Q N cexp) cdvds) (wceq P Q)) $;

--| Condition for a prime dividing a square. (Contributed by Scott Fenton, 8-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.) (Proof shortened by SN, 21-Aug-2024.)
theorem prmdvdssq (P M: class):
  $ wi (wa (wcel P cprime) (wcel M cz)) (wb (wbr P M cdvds) (wbr P (co M c2 cexp) cdvds)) $;

--| Two positive prime powers are equal iff the primes and the powers are equal. (Contributed by Paul Chapman, 30-Nov-2012.)
theorem prmexpb (P Q M N: class):
  $ wi (wa (wa (wcel P cprime) (wcel Q cprime)) (wa (wcel M cn) (wcel N cn))) (wb (wceq (co P M cexp) (co Q N cexp)) (wa (wceq P Q) (wceq M N))) $;

--| The factorial of a number only contains primes less than the base. (Contributed by Mario Carneiro, 6-Mar-2014.)
theorem prmfac1 (P N: class):
  $ wi (w3a (wcel N cn0) (wcel P cprime) (wbr P (cfv N cfa) cdvds)) (wbr P N cle) $;

--| Divisibility for an integer quotient. (Contributed by Thierry Arnoux, 17-Sep-2023.)
theorem dvdszzq (ph: wff) (A2 B2 P N: class):
  $ wceq N (co A2 B2 cdiv) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel N cz) $ >
  $ wi ph (wcel B2 cz) $ >
  $ wi ph (wne B2 cc0) $ >
  $ wi ph (wbr P A2 cdvds) $ >
  $ wi ph (wn (wbr P B2 cdvds)) $ >
  $ wi ph (wbr P N cdvds) $;

--| If two numbers ` A ` and ` B ` are relatively prime, then they are still relatively prime if raised to a power. (Contributed by Mario Carneiro, 24-Feb-2014.)
theorem rpexp (A2 B2 N: class):
  $ wi (w3a (wcel A2 cz) (wcel B2 cz) (wcel N cn)) (wb (wceq (co (co A2 N cexp) B2 cgcd) c1) (wceq (co A2 B2 cgcd) c1)) $;

--| Relative primality passes to asymmetric powers. (Contributed by Stefan O'Rear, 27-Sep-2014.)
theorem rpexp1i (A2 B2 M: class):
  $ wi (w3a (wcel A2 cz) (wcel B2 cz) (wcel M cn0)) (wi (wceq (co A2 B2 cgcd) c1) (wceq (co (co A2 M cexp) B2 cgcd) c1)) $;

--| Relative primality passes to symmetric powers. (Contributed by Stefan O'Rear, 27-Sep-2014.)
theorem rpexp12i (A2 B2 M N: class):
  $ wi (w3a (wcel A2 cz) (wcel B2 cz) (wa (wcel M cn0) (wcel N cn0))) (wi (wceq (co A2 B2 cgcd) c1) (wceq (co (co A2 M cexp) (co B2 N cexp) cgcd) c1)) $;

--| A prime number does not divide the factorial of a nonnegative integer less than the prime number. (Contributed by AV, 13-Jul-2021.)
theorem prmndvdsfaclt (P N: class):
  $ wi (wa (wcel P cprime) (wcel N cn0)) (wi (wbr N P clt) (wn (wbr P (cfv N cfa) cdvds))) $;

--| Condition for a prime number to divide a binomial coefficient. (Contributed by Thierry Arnoux, 17-Sep-2023.)
theorem prmdvdsbc (P N: class):
  $ wi (wa (wcel P cprime) (wcel N (co c1 (co P c1 cmin) cfz))) (wbr P (co P N cbc) cdvds) $;

--| Two positive integers are not coprime iff a prime divides both integers. Deduction version of ~ ncoprmgcdne1b with the existential quantifier over the primes instead of integers greater than or equal to 2. (Contributed by SN, 24-Aug-2024.)
theorem prmdvdsncoprmbd {p: setvar} (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wb (wrex p (wa (wbr (cv p) A2 cdvds) (wbr (cv p) B2 cdvds)) cprime) (wne (co A2 B2 cgcd) c1)) $;

--| If two positive integers are not coprime, the larger of them is not a prime number. (Contributed by AV, 9-Aug-2020.)
theorem ncoprmlnprm (A2 B2: class):
  $ wi (w3a (wcel A2 cn) (wcel B2 cn) (wbr A2 B2 clt)) (wi (wbr c1 (co A2 B2 cgcd) clt) (wnel B2 cprime)) $;

--| Corollary 2 of Cancellability of Congruences: Two products with a common factor are congruent modulo a prime number not dividing the common factor iff the other factors are congruent modulo the prime number. (Contributed by AV, 13-Jul-2021.)
theorem cncongrprm (A2 B2 C P: class):
  $ wi (wa (w3a (wcel A2 cz) (wcel B2 cz) (wcel C cz)) (wa (wcel P cprime) (wn (wbr P C cdvds)))) (wb (wceq (co (co A2 C cmul) P cmo) (co (co B2 C cmul) P cmo)) (wceq (co A2 P cmo) (co B2 P cmo))) $;

--| The predicate "is an even number". An even number and 2 have 2 as greatest common divisor. (Contributed by AV, 1-Jul-2020.) (Revised by AV, 8-Aug-2021.)
theorem isevengcd2 (Z: class):
  $ wi (wcel Z cz) (wb (wbr c2 Z cdvds) (wceq (co c2 Z cgcd) c2)) $;

--| The predicate "is an odd number". An odd number and 2 have 1 as greatest common divisor. (Contributed by AV, 1-Jul-2020.) (Revised by AV, 8-Aug-2021.)
theorem isoddgcd1 (Z: class):
  $ wi (wcel Z cz) (wb (wn (wbr c2 Z cdvds)) (wceq (co c2 Z cgcd) c1)) $;

--| The least common multiple of three and two is six. The operands are unequal primes and thus coprime, so the result is (the absolute value of) their product. (Contributed by Steve Rodriguez, 20-Jan-2020.) (Proof shortened by AV, 27-Aug-2020.)
theorem _3lcm2e6:
  $ wceq (co c3 c2 clcm) c6 $;

--| Extend class notation to include canonical numerator function.
term cnumer: class;

--| Extend class notation to include canonical denominator function.
term cdenom: class;

--| The canonical numerator of a rational is the numerator of the rational's reduced fraction representation (no common factors, denominator positive). (Contributed by Stefan O'Rear, 13-Sep-2014.)
axiom df_numer {x3 y1: setvar}:
  $ wceq cnumer (cmpt y1 cq (cfv (crio x3 (wa (wceq (co (cfv (cv x3) c1st) (cfv (cv x3) c2nd) cgcd) c1) (wceq (cv y1) (co (cfv (cv x3) c1st) (cfv (cv x3) c2nd) cdiv))) (cxp cz cn)) c1st)) $;

--| The canonical denominator of a rational is the denominator of the rational's reduced fraction representation (no common factors, denominator positive). (Contributed by Stefan O'Rear, 13-Sep-2014.)
axiom df_denom {x3 y1: setvar}:
  $ wceq cdenom (cmpt y1 cq (cfv (crio x3 (wa (wceq (co (cfv (cv x3) c1st) (cfv (cv x3) c2nd) cgcd) c1) (wceq (cv y1) (co (cfv (cv x3) c1st) (cfv (cv x3) c2nd) cdiv))) (cxp cz cn)) c2nd)) $;

--| Value of the canonical numerator function. (Contributed by Stefan O'Rear, 13-Sep-2014.)
theorem qnumval {x3: setvar} (A2: class):
  $ wi (wcel A2 cq) (wceq (cfv A2 cnumer) (cfv (crio x3 (wa (wceq (co (cfv (cv x3) c1st) (cfv (cv x3) c2nd) cgcd) c1) (wceq A2 (co (cfv (cv x3) c1st) (cfv (cv x3) c2nd) cdiv))) (cxp cz cn)) c1st)) $;

--| Value of the canonical denominator function. (Contributed by Stefan O'Rear, 13-Sep-2014.)
theorem qdenval {x3: setvar} (A2: class):
  $ wi (wcel A2 cq) (wceq (cfv A2 cdenom) (cfv (crio x3 (wa (wceq (co (cfv (cv x3) c1st) (cfv (cv x3) c2nd) cgcd) c1) (wceq A2 (co (cfv (cv x3) c1st) (cfv (cv x3) c2nd) cdiv))) (cxp cz cn)) c2nd)) $;

--| Lemma for ~ qnumcl and ~ qdencl . (Contributed by Stefan O'Rear, 13-Sep-2014.)
theorem qnumdencl (A2: class):
  $ wi (wcel A2 cq) (wa (wcel (cfv A2 cnumer) cz) (wcel (cfv A2 cdenom) cn)) $;

--| The canonical numerator of a rational is an integer. (Contributed by Stefan O'Rear, 13-Sep-2014.)
theorem qnumcl (A2: class):
  $ wi (wcel A2 cq) (wcel (cfv A2 cnumer) cz) $;

--| The canonical denominator is a positive integer. (Contributed by Stefan O'Rear, 13-Sep-2014.)
theorem qdencl (A2: class):
  $ wi (wcel A2 cq) (wcel (cfv A2 cdenom) cn) $;

--| Canonical numerator defines a function. (Contributed by Stefan O'Rear, 13-Sep-2014.)
theorem fnum:
  $ wf cq cz cnumer $;

--| Canonical denominator defines a function. (Contributed by Stefan O'Rear, 13-Sep-2014.)
theorem fden:
  $ wf cq cn cdenom $;

--| Two numbers are the canonical representation of a rational iff they are coprime and have the right quotient. (Contributed by Stefan O'Rear, 13-Sep-2014.)
theorem qnumdenbi (A2 B2 C: class):
  $ wi (w3a (wcel A2 cq) (wcel B2 cz) (wcel C cn)) (wb (wa (wceq (co B2 C cgcd) c1) (wceq A2 (co B2 C cdiv))) (wa (wceq (cfv A2 cnumer) B2) (wceq (cfv A2 cdenom) C))) $;

--| The canonical representation of a rational is fully reduced. (Contributed by Stefan O'Rear, 13-Sep-2014.)
theorem qnumdencoprm (A2: class):
  $ wi (wcel A2 cq) (wceq (co (cfv A2 cnumer) (cfv A2 cdenom) cgcd) c1) $;

--| Recover a rational number from its canonical representation. (Contributed by Stefan O'Rear, 13-Sep-2014.)
theorem qeqnumdivden (A2: class):
  $ wi (wcel A2 cq) (wceq A2 (co (cfv A2 cnumer) (cfv A2 cdenom) cdiv)) $;

--| Multiplying a rational by its denominator results in an integer. (Contributed by Stefan O'Rear, 13-Sep-2014.)
theorem qmuldeneqnum (A2: class):
  $ wi (wcel A2 cq) (wceq (co A2 (cfv A2 cdenom) cmul) (cfv A2 cnumer)) $;

--| Calculate the reduced form of a quotient using ` gcd ` . (Contributed by Stefan O'Rear, 13-Sep-2014.)
theorem divnumden (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cn)) (wa (wceq (cfv (co A2 B2 cdiv) cnumer) (co A2 (co A2 B2 cgcd) cdiv)) (wceq (cfv (co A2 B2 cdiv) cdenom) (co B2 (co A2 B2 cgcd) cdiv))) $;

--| Reducing a quotient never increases the denominator. (Contributed by Stefan O'Rear, 13-Sep-2014.)
theorem divdenle (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cn)) (wbr (cfv (co A2 B2 cdiv) cdenom) B2 cle) $;

--| A rational is positive iff its canonical numerator is. (Contributed by Stefan O'Rear, 15-Sep-2014.)
theorem qnumgt0 (A2: class):
  $ wi (wcel A2 cq) (wb (wbr cc0 A2 clt) (wbr cc0 (cfv A2 cnumer) clt)) $;

--| A rational is positive iff its canonical numerator is a positive integer. (Contributed by Stefan O'Rear, 15-Sep-2014.)
theorem qgt0numnn (A2: class):
  $ wi (wa (wcel A2 cq) (wbr cc0 A2 clt)) (wcel (cfv A2 cnumer) cn) $;

--| Squaring commutes with GCD, in particular two coprime numbers have coprime squares. (Contributed by Stefan O'Rear, 15-Sep-2014.)
theorem nn0gcdsq (A2 B2: class):
  $ wi (wa (wcel A2 cn0) (wcel B2 cn0)) (wceq (co (co A2 B2 cgcd) c2 cexp) (co (co A2 c2 cexp) (co B2 c2 cexp) cgcd)) $;

--| ~ nn0gcdsq extended to integers by symmetry. (Contributed by Stefan O'Rear, 15-Sep-2014.)
theorem zgcdsq (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cz)) (wceq (co (co A2 B2 cgcd) c2 cexp) (co (co A2 c2 cexp) (co B2 c2 cexp) cgcd)) $;

--| Squaring a rational squares its canonical components. (Contributed by Stefan O'Rear, 15-Sep-2014.)
theorem numdensq (A2: class):
  $ wi (wcel A2 cq) (wa (wceq (cfv (co A2 c2 cexp) cnumer) (co (cfv A2 cnumer) c2 cexp)) (wceq (cfv (co A2 c2 cexp) cdenom) (co (cfv A2 cdenom) c2 cexp))) $;

--| Square commutes with canonical numerator. (Contributed by Stefan O'Rear, 15-Sep-2014.)
theorem numsq (A2: class):
  $ wi (wcel A2 cq) (wceq (cfv (co A2 c2 cexp) cnumer) (co (cfv A2 cnumer) c2 cexp)) $;

--| Square commutes with canonical denominator. (Contributed by Stefan O'Rear, 15-Sep-2014.)
theorem densq (A2: class):
  $ wi (wcel A2 cq) (wceq (cfv (co A2 c2 cexp) cdenom) (co (cfv A2 cdenom) c2 cexp)) $;

--| A rational is an integer iff it has denominator 1. (Contributed by Stefan O'Rear, 15-Sep-2014.)
theorem qden1elz (A2: class):
  $ wi (wcel A2 cq) (wb (wceq (cfv A2 cdenom) c1) (wcel A2 cz)) $;

--| If an integer has a rational square root, that root must be an integer. (Contributed by Stefan O'Rear, 15-Sep-2014.)
theorem zsqrtelqelz (A2: class):
  $ wi (wa (wcel A2 cz) (wcel (cfv A2 csqrt) cq)) (wcel (cfv A2 csqrt) cz) $;

--| Any integer strictly between two adjacent squares has an irrational square root. (Contributed by Stefan O'Rear, 15-Sep-2014.)
theorem nonsq (A2 B2: class):
  $ wi (wa (wa (wcel A2 cn0) (wcel B2 cn0)) (wa (wbr (co B2 c2 cexp) A2 clt) (wbr A2 (co (co B2 c1 caddc) c2 cexp) clt))) (wn (wcel (cfv A2 csqrt) cq)) $;

--| When a positive rational squared is an integer, the rational is a positive integer. ~ zsqrtelqelz with all terms squared and positive. (Contributed by SN, 23-Aug-2024.)
theorem posqsqznn (ph: wff) (A2: class):
  $ wi ph (wcel (co A2 c2 cexp) cz) $ >
  $ wi ph (wcel A2 cq) $ >
  $ wi ph (wbr cc0 A2 clt) $ >
  $ wi ph (wcel A2 cn) $;

--| Elevating a rational number to the power ` N ` has the same effect on its canonical components. Same as ~ numdensq , extended to nonnegative exponents. (Contributed by Steven Nguyen, 5-Apr-2023.)
theorem numdenexp (A2 N: class):
  $ wi (wa (wcel A2 cq) (wcel N cn0)) (wa (wceq (cfv (co A2 N cexp) cnumer) (co (cfv A2 cnumer) N cexp)) (wceq (cfv (co A2 N cexp) cdenom) (co (cfv A2 cdenom) N cexp))) $;

--| Elevating to a nonnegative power commutes with canonical numerator. Similar to ~ numsq , extended to nonnegative exponents. (Contributed by Steven Nguyen, 5-Apr-2023.)
theorem numexp (A2 N: class):
  $ wi (wa (wcel A2 cq) (wcel N cn0)) (wceq (cfv (co A2 N cexp) cnumer) (co (cfv A2 cnumer) N cexp)) $;

--| Elevating to a nonnegative power commutes with canonical denominator. Similar to ~ densq , extended to nonnegative exponents. (Contributed by Steven Nguyen, 5-Apr-2023.)
theorem denexp (A2 N: class):
  $ wi (wa (wcel A2 cq) (wcel N cn0)) (wceq (cfv (co A2 N cexp) cdenom) (co (cfv A2 cdenom) N cexp)) $;

--| Extend class notation with the order function on the class of integers modulo N.
term codz: class;

--| Extend class notation with the Euler phi function.
term cphi: class;

--| Define the order function on the class of integers modulo N. (Contributed by Mario Carneiro, 23-Feb-2014.) (Revised by AV, 26-Sep-2020.)
axiom df_odz {x3 m n: setvar}:
  $ wceq codz (cmpt n cn (cmpt x3 (crab x3 (wceq (co (cv x3) (cv n) cgcd) c1) cz) (cinf (crab m (wbr (cv n) (co (co (cv x3) (cv m) cexp) c1 cmin) cdvds) cn) cr clt))) $;

--| Define the Euler phi function (also called "Euler totient function"), which counts the number of integers less than ` n ` and coprime to it, see definition in [ApostolNT] p. 25. (Contributed by Mario Carneiro, 23-Feb-2014.)
axiom df_phi {x3 n: setvar}:
  $ wceq cphi (cmpt n cn (cfv (crab x3 (wceq (co (cv x3) (cv n) cgcd) c1) (co c1 (cv n) cfz)) chash)) $;

--| Value of the Euler ` phi ` function. (Contributed by Mario Carneiro, 23-Feb-2014.)
theorem phival {x3: setvar} (N: class):
  $ wi (wcel N cn) (wceq (cfv N cphi) (cfv (crab x3 (wceq (co (cv x3) N cgcd) c1) (co c1 N cfz)) chash)) $;

--| Bounds and closure for the value of the Euler ` phi ` function. (Contributed by Mario Carneiro, 23-Feb-2014.)
theorem phicl2 (N: class):
  $ wi (wcel N cn) (wcel (cfv N cphi) (co c1 N cfz)) $;

--| Closure for the value of the Euler ` phi ` function. (Contributed by Mario Carneiro, 28-Feb-2014.)
theorem phicl (N: class):
  $ wi (wcel N cn) (wcel (cfv N cphi) cn) $;

--| Lemma for ~ phibnd . (Contributed by Mario Carneiro, 23-Feb-2014.)
theorem phibndlem {x3: setvar} (N: class):
  $ wi (wcel N (cfv c2 cuz)) (wss (crab x3 (wceq (co (cv x3) N cgcd) c1) (co c1 N cfz)) (co c1 (co N c1 cmin) cfz)) $;

--| A slightly tighter bound on the value of the Euler ` phi ` function. (Contributed by Mario Carneiro, 23-Feb-2014.)
theorem phibnd (N: class):
  $ wi (wcel N (cfv c2 cuz)) (wbr (cfv N cphi) (co N c1 cmin) cle) $;

--| Closure for the value of the Euler ` phi ` function. (Contributed by Mario Carneiro, 29-May-2016.)
theorem phicld (ph: wff) (N: class):
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel (cfv N cphi) cn) $;

--| Value of the Euler ` phi ` function at 1. (Contributed by Mario Carneiro, 23-Feb-2014.)
theorem phi1:
  $ wceq (cfv c1 cphi) c1 $;

--| Alternate definition of the Euler ` phi ` function. (Contributed by Mario Carneiro, 23-Feb-2014.) (Revised by Mario Carneiro, 2-May-2016.)
theorem dfphi2 {x3: setvar} (N: class):
  $ wi (wcel N cn) (wceq (cfv N cphi) (cfv (crab x3 (wceq (co (cv x3) N cgcd) c1) (co cc0 N cfzo)) chash)) $;

--| The number of numbers in a given residue class in a finite set of integers. (Contributed by Mario Carneiro, 12-Mar-2014.) (Proof shortened by Mario Carneiro, 7-Jun-2016.)
theorem hashdvds {x3: setvar} (ph: wff x3) (A2 B2 C N: class):
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wcel B2 (cfv (co A2 c1 cmin) cuz)) $ >
  $ wi ph (wcel C cz) $ >
  $ wi ph (wceq (cfv (crab x3 (wbr N (co (cv x3) C cmin) cdvds) (co A2 B2 cfz)) chash) (co (cfv (co (co B2 C cmin) N cdiv) cfl) (cfv (co (co (co A2 c1 cmin) C cmin) N cdiv) cfl) cmin)) $;

--| Value of the Euler ` phi ` function at a prime power. Theorem 2.5(a) in [ApostolNT] p. 28. (Contributed by Mario Carneiro, 24-Feb-2014.)
theorem phiprmpw (P K: class):
  $ wi (wa (wcel P cprime) (wcel K cn)) (wceq (cfv (co P K cexp) cphi) (co (co P (co K c1 cmin) cexp) (co P c1 cmin) cmul)) $;

--| Value of the Euler ` phi ` function at a prime. (Contributed by Mario Carneiro, 28-Feb-2014.)
theorem phiprm (P: class):
  $ wi (wcel P cprime) (wceq (cfv P cphi) (co P c1 cmin)) $;

--| The Chinese Remainder Theorem: the function that maps ` x ` to its remainder classes ` mod M ` and ` mod N ` is 1-1 and onto when ` M ` and ` N ` are coprime. (Contributed by Mario Carneiro, 24-Feb-2014.) (Proof shortened by Mario Carneiro, 2-May-2016.)
theorem crth {x3: setvar} (ph: wff) (S T: class) (F: class x3) (M N: class):
  $ wceq S (co cc0 (co M N cmul) cfzo) $ >
  $ wceq T (cxp (co cc0 M cfzo) (co cc0 N cfzo)) $ >
  $ wceq F (cmpt x3 S (cop (co (cv x3) M cmo) (co (cv x3) N cmo))) $ >
  $ wi ph (w3a (wcel M cn) (wcel N cn) (wceq (co M N cgcd) c1)) $ >
  $ wi ph (wf1o S T F) $;

--| Lemma for ~ phimul . (Contributed by Mario Carneiro, 24-Feb-2014.)
theorem phimullem {x3 y1: setvar} (ph: wff) (S: class) (T: class y1) (U: class x3 y1) (F: class x3) (M N: class) (V W: class x3 y1):
  $ wceq S (co cc0 (co M N cmul) cfzo) $ >
  $ wceq T (cxp (co cc0 M cfzo) (co cc0 N cfzo)) $ >
  $ wceq F (cmpt x3 S (cop (co (cv x3) M cmo) (co (cv x3) N cmo))) $ >
  $ wi ph (w3a (wcel M cn) (wcel N cn) (wceq (co M N cgcd) c1)) $ >
  $ wceq U (crab y1 (wceq (co (cv y1) M cgcd) c1) (co cc0 M cfzo)) $ >
  $ wceq V (crab y1 (wceq (co (cv y1) N cgcd) c1) (co cc0 N cfzo)) $ >
  $ wceq W (crab y1 (wceq (co (cv y1) (co M N cmul) cgcd) c1) S) $ >
  $ wi ph (wceq (cfv (co M N cmul) cphi) (co (cfv M cphi) (cfv N cphi) cmul)) $;

--| The Euler ` phi ` function is a multiplicative function, meaning that it distributes over multiplication at relatively prime arguments. Theorem 2.5(c) in [ApostolNT] p. 28. (Contributed by Mario Carneiro, 24-Feb-2014.)
theorem phimul (M N: class):
  $ wi (w3a (wcel M cn) (wcel N cn) (wceq (co M N cgcd) c1)) (wceq (cfv (co M N cmul) cphi) (co (cfv M cphi) (cfv N cphi) cmul)) $;

--| Lemma for ~ eulerth . (Contributed by Mario Carneiro, 8-May-2015.)
theorem eulerthlem1 {x3 y1: setvar} (ph: wff) (A2: class) (S: class y1) (T F G N: class):
  $ wi ph (w3a (wcel N cn) (wcel A2 cz) (wceq (co A2 N cgcd) c1)) $ >
  $ wceq S (crab y1 (wceq (co (cv y1) N cgcd) c1) (co cc0 N cfzo)) $ >
  $ wceq T (co c1 (cfv N cphi) cfz) $ >
  $ wi ph (wf1o T S F) $ >
  $ wceq G (cmpt x3 T (co (co A2 (cfv (cv x3) F) cmul) N cmo)) $ >
  $ wi ph (wf T S G) $;

--| Lemma for ~ eulerth . (Contributed by Mario Carneiro, 28-Feb-2014.)
theorem eulerthlem2 {x3 y1: setvar} (ph: wff) (A2: class) (S: class y1) (T F G N: class):
  $ wi ph (w3a (wcel N cn) (wcel A2 cz) (wceq (co A2 N cgcd) c1)) $ >
  $ wceq S (crab y1 (wceq (co (cv y1) N cgcd) c1) (co cc0 N cfzo)) $ >
  $ wceq T (co c1 (cfv N cphi) cfz) $ >
  $ wi ph (wf1o T S F) $ >
  $ wceq G (cmpt x3 T (co (co A2 (cfv (cv x3) F) cmul) N cmo)) $ >
  $ wi ph (wceq (co (co A2 (cfv N cphi) cexp) N cmo) (co c1 N cmo)) $;

--| Euler's theorem, a generalization of Fermat's little theorem. If ` A ` and ` N ` are coprime, then ` A ^ phi ( N ) == 1 ` (mod ` N ` ). This is Metamath 100 proof #10. Also called Euler-Fermat theorem, see theorem 5.17 in [ApostolNT] p. 113. (Contributed by Mario Carneiro, 28-Feb-2014.)
theorem eulerth (A2 N: class):
  $ wi (w3a (wcel N cn) (wcel A2 cz) (wceq (co A2 N cgcd) c1)) (wceq (co (co A2 (cfv N cphi) cexp) N cmo) (co c1 N cmo)) $;

--| Fermat's little theorem. When ` P ` is prime, ` A ^ P == A ` (mod ` P ` ) for any ` A ` , see theorem 5.19 in [ApostolNT] p. 114. (Contributed by Mario Carneiro, 28-Feb-2014.) (Proof shortened by AV, 19-Mar-2022.)
theorem fermltl (A2 P: class):
  $ wi (wa (wcel P cprime) (wcel A2 cz)) (wceq (co (co A2 P cexp) P cmo) (co A2 P cmo)) $;

--| Show an explicit expression for the modular inverse of ` A mod P ` . (Contributed by Mario Carneiro, 24-Jan-2015.)
theorem prmdiv (A2 P R: class):
  $ wceq R (co (co A2 (co P c2 cmin) cexp) P cmo) $ >
  $ wi (w3a (wcel P cprime) (wcel A2 cz) (wn (wbr P A2 cdvds))) (wa (wcel R (co c1 (co P c1 cmin) cfz)) (wbr P (co (co A2 R cmul) c1 cmin) cdvds)) $;

--| The modular inverse of ` A mod P ` is unique. (Contributed by Mario Carneiro, 24-Jan-2015.)
theorem prmdiveq (A2 P R S: class):
  $ wceq R (co (co A2 (co P c2 cmin) cexp) P cmo) $ >
  $ wi (w3a (wcel P cprime) (wcel A2 cz) (wn (wbr P A2 cdvds))) (wb (wa (wcel S (co cc0 (co P c1 cmin) cfz)) (wbr P (co (co A2 S cmul) c1 cmin) cdvds)) (wceq S R)) $;

--| The (modular) inverse of the inverse of a number is itself. (Contributed by Mario Carneiro, 24-Jan-2015.)
theorem prmdivdiv (A2 P R: class):
  $ wceq R (co (co A2 (co P c2 cmin) cexp) P cmo) $ >
  $ wi (wa (wcel P cprime) (wcel A2 (co c1 (co P c1 cmin) cfz))) (wceq A2 (co (co R (co P c2 cmin) cexp) P cmo)) $;

--| A correspondence between elements of specific GCD and relative primes in a smaller ring. (Contributed by Stefan O'Rear, 12-Sep-2015.)
theorem hashgcdlem {x3 y1 z: setvar} (A2 B2: class y1 z) (F: class x3 y1 z) (M N: class):
  $ wceq A2 (crab y1 (wceq (co (cv y1) (co M N cdiv) cgcd) c1) (co cc0 (co M N cdiv) cfzo)) $ >
  $ wceq B2 (crab z (wceq (co (cv z) M cgcd) N) (co cc0 M cfzo)) $ >
  $ wceq F (cmpt x3 A2 (co (cv x3) N cmul)) $ >
  $ wi (w3a (wcel M cn) (wcel N cn) (wbr N M cdvds)) (wf1o A2 B2 F) $;

--| A natural number has finitely many divisors. (Contributed by Jim Kingdon, 9-Oct-2025.)
theorem dvdsfi {x3: setvar} (N: class):
  $ wi (wcel N cn) (wcel (crab x3 (wbr (cv x3) N cdvds) cn) cfn) $;

--| Number of initial positive integers with specified divisors. (Contributed by Stefan O'Rear, 12-Sep-2015.)
theorem hashgcdeq {x3: setvar} (M N: class):
  $ wi (wa (wcel M cn) (wcel N cn)) (wceq (cfv (crab x3 (wceq (co (cv x3) M cgcd) N) (co cc0 M cfzo)) chash) (cif (wbr N M cdvds) (cfv (co M N cdiv) cphi) cc0)) $;

--| The divisor sum identity of the totient function. Theorem 2.2 in [ApostolNT] p. 26. (Contributed by Stefan O'Rear, 12-Sep-2015.)
theorem phisum {x3 d: setvar} (N: class):
  $ wi (wcel N cn) (wceq (csu d (crab x3 (wbr (cv x3) N cdvds) cn) (cfv (cv d) cphi)) N) $;

--| Value of the order function. This is a function of functions; the inner argument selects the base (i.e., mod ` N ` for some ` N ` , often prime) and the outer argument selects the integer or equivalence class (if you want to think about it that way) from the integers mod ` N ` . In order to ensure the supremum is well-defined, we only define the expression when ` A ` and ` N ` are coprime. (Contributed by Mario Carneiro, 23-Feb-2014.) (Revised by AV, 26-Sep-2020.)
theorem odzval {n: setvar} (A2 N: class):
  $ wi (w3a (wcel N cn) (wcel A2 cz) (wceq (co A2 N cgcd) c1)) (wceq (cfv A2 (cfv N codz)) (cinf (crab n (wbr N (co (co A2 (cv n) cexp) c1 cmin) cdvds) cn) cr clt)) $;

--| - Lemma for ~ odzcl , showing existence of a recurrent point for the exponential. (Contributed by Mario Carneiro, 28-Feb-2014.) (Proof shortened by AV, 26-Sep-2020.)
theorem odzcllem (A2 N: class):
  $ wi (w3a (wcel N cn) (wcel A2 cz) (wceq (co A2 N cgcd) c1)) (wa (wcel (cfv A2 (cfv N codz)) cn) (wbr N (co (co A2 (cfv A2 (cfv N codz)) cexp) c1 cmin) cdvds)) $;

--| The order of a group element is an integer. (Contributed by Mario Carneiro, 28-Feb-2014.)
theorem odzcl (A2 N: class):
  $ wi (w3a (wcel N cn) (wcel A2 cz) (wceq (co A2 N cgcd) c1)) (wcel (cfv A2 (cfv N codz)) cn) $;

--| Any element raised to the power of its order is ` 1 ` . (Contributed by Mario Carneiro, 28-Feb-2014.)
theorem odzid (A2 N: class):
  $ wi (w3a (wcel N cn) (wcel A2 cz) (wceq (co A2 N cgcd) c1)) (wbr N (co (co A2 (cfv A2 (cfv N codz)) cexp) c1 cmin) cdvds) $;

--| The only powers of ` A ` that are congruent to ` 1 ` are the multiples of the order of ` A ` . (Contributed by Mario Carneiro, 28-Feb-2014.) (Proof shortened by AV, 26-Sep-2020.)
theorem odzdvds (A2 K N: class):
  $ wi (wa (w3a (wcel N cn) (wcel A2 cz) (wceq (co A2 N cgcd) c1)) (wcel K cn0)) (wb (wbr N (co (co A2 K cexp) c1 cmin) cdvds) (wbr (cfv A2 (cfv N codz)) K cdvds)) $;

--| The order of any group element is a divisor of the Euler ` phi ` function. (Contributed by Mario Carneiro, 28-Feb-2014.)
theorem odzphi (A2 N: class):
  $ wi (w3a (wcel N cn) (wcel A2 cz) (wceq (co A2 N cgcd) c1)) (wbr (cfv A2 (cfv N codz)) (cfv N cphi) cdvds) $;

--| A prime number divides an integer minus 1 iff the integer modulo the prime number is 1. (Contributed by Alexander van der Vekens, 17-May-2018.) (Proof shortened by AV, 30-May-2023.)
theorem modprm1div (A2 P: class):
  $ wi (wa (wcel P cprime) (wcel A2 cz)) (wb (wceq (co A2 P cmo) c1) (wbr P (co A2 c1 cmin) cdvds)) $;

--| If an integer minus 1 is divisible by a prime number, the integer itself is not divisible by this prime number. (Contributed by Alexander van der Vekens, 30-Aug-2018.)
theorem m1dvdsndvds (A2 P: class):
  $ wi (wa (wcel P cprime) (wcel A2 cz)) (wi (wbr P (co A2 c1 cmin) cdvds) (wn (wbr P A2 cdvds))) $;

--| Show an explicit expression for the modular inverse of ` A mod P ` . This is an application of ~ prmdiv . (Contributed by Alexander van der Vekens, 15-May-2018.)
theorem modprminv (A2 P R: class):
  $ wceq R (co (co A2 (co P c2 cmin) cexp) P cmo) $ >
  $ wi (w3a (wcel P cprime) (wcel A2 cz) (wn (wbr P A2 cdvds))) (wa (wcel R (co c1 (co P c1 cmin) cfz)) (wceq (co (co A2 R cmul) P cmo) c1)) $;

--| The modular inverse of ` A mod P ` is unique. (Contributed by Alexander van der Vekens, 17-May-2018.)
theorem modprminveq (A2 P R S: class):
  $ wceq R (co (co A2 (co P c2 cmin) cexp) P cmo) $ >
  $ wi (w3a (wcel P cprime) (wcel A2 cz) (wn (wbr P A2 cdvds))) (wb (wa (wcel S (co cc0 (co P c1 cmin) cfz)) (wceq (co (co A2 S cmul) P cmo) c1)) (wceq S R)) $;

--| Variant of Fermat's little theorem if ` A ` is not a multiple of ` P ` , see theorem 5.18 in [ApostolNT] p. 113. (Contributed by AV, 21-Aug-2020.) (Proof shortened by AV, 5-Sep-2020.)
theorem vfermltl (A2 P: class):
  $ wi (w3a (wcel P cprime) (wcel A2 cz) (wn (wbr P A2 cdvds))) (wceq (co (co A2 (co P c1 cmin) cexp) P cmo) c1) $;

--| Alternate proof of ~ vfermltl , not using Euler's theorem. (Contributed by AV, 21-Aug-2020.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem vfermltlALT (A2 P: class):
  $ wi (w3a (wcel P cprime) (wcel A2 cz) (wn (wbr P A2 cdvds))) (wceq (co (co A2 (co P c1 cmin) cexp) P cmo) c1) $;

--| If an integer minus 1 is divisible by a prime number, then the integer to the power of the prime number minus 2 is 1 modulo the prime number. (Contributed by Alexander van der Vekens, 30-Aug-2018.)
theorem powm2modprm (A2 P: class):
  $ wi (wa (wcel P cprime) (wcel A2 cz)) (wi (wbr P (co A2 c1 cmin) cdvds) (wceq (co (co A2 (co P c2 cmin) cexp) P cmo) c1)) $;

--| For any prime number and for any positive integer less than this prime number, there is a unique modular inverse of this positive integer. (Contributed by Alexander van der Vekens, 12-May-2018.)
theorem reumodprminv {i: setvar} (P N: class):
  $ wi (wa (wcel P cprime) (wcel N (co c1 P cfzo))) (wreu i (wceq (co (co N (cv i) cmul) P cmo) c1) (co c1 (co P c1 cmin) cfz)) $;

--| For two positive integers less than a given prime number there is always a nonnegative integer (less than the given prime number) so that the sum of one of the two positive integers and the other of the positive integers multiplied by the nonnegative integer is 0 ( modulo the given prime number). (Contributed by Alexander van der Vekens, 17-May-2018.)
theorem modprm0 {j: setvar} (P I N: class):
  $ wi (w3a (wcel P cprime) (wcel N (co c1 P cfzo)) (wcel I (co c1 P cfzo))) (wrex j (wceq (co (co I (co (cv j) N cmul) caddc) P cmo) cc0) (co cc0 P cfzo)) $;

--| For a positive integer and a nonnegative integer both less than a given prime number there is always a second nonnegative integer (less than the given prime number) so that the sum of this second nonnegative integer multiplied with the positive integer and the first nonnegative integer is 0 ( modulo the given prime number). (Contributed by Alexander van der Vekens, 8-Nov-2018.)
theorem nnnn0modprm0 {j: setvar} (P I N: class):
  $ wi (w3a (wcel P cprime) (wcel N (co c1 P cfzo)) (wcel I (co cc0 P cfzo))) (wrex j (wceq (co (co I (co (cv j) N cmul) caddc) P cmo) cc0) (co cc0 P cfzo)) $;

--| For an integer not being 0 modulo a given prime number and a nonnegative integer less than the prime number, there is always a second nonnegative integer (less than the given prime number) so that the sum of this second nonnegative integer multiplied with the integer and the first nonnegative integer is 0 ( modulo the given prime number). (Contributed by Alexander van der Vekens, 10-Nov-2018.)
theorem modprmn0modprm0 {j: setvar} (P I N: class):
  $ wi (w3a (wcel P cprime) (wcel N cz) (wne (co N P cmo) cc0)) (wi (wcel I (co cc0 P cfzo)) (wrex j (wceq (co (co I (co (cv j) N cmul) caddc) P cmo) cc0) (co cc0 P cfzo))) $;

--| If three numbers are coprime, and the square of one is the product of the other two, then there is a formula for the other two in terms of ` gcd ` and square. (Contributed by Scott Fenton, 2-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem coprimeprodsq (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cn0) (wcel B2 cz) (wcel C cn0)) (wceq (co (co A2 B2 cgcd) C cgcd) c1)) (wi (wceq (co C c2 cexp) (co A2 B2 cmul)) (wceq A2 (co (co A2 C cgcd) c2 cexp))) $;

--| If three numbers are coprime, and the square of one is the product of the other two, then there is a formula for the other two in terms of ` gcd ` and square. (Contributed by Scott Fenton, 17-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem coprimeprodsq2 (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cz) (wcel B2 cn0) (wcel C cn0)) (wceq (co (co A2 B2 cgcd) C cgcd) c1)) (wi (wceq (co C c2 cexp) (co A2 B2 cmul)) (wceq B2 (co (co B2 C cgcd) c2 cexp))) $;

--| A prime not equal to ` 2 ` is odd. (Contributed by Mario Carneiro, 4-Feb-2015.) (Proof shortened by AV, 10-Jul-2022.)
theorem oddprm (N: class):
  $ wi (wcel N (cdif cprime (csn c2))) (wcel (co (co N c1 cmin) c2 cdiv) cn) $;

--| A prime not equal to ` 2 ` is an odd positive integer. (Contributed by AV, 28-Jun-2021.)
theorem nnoddn2prm (N: class):
  $ wi (wcel N (cdif cprime (csn c2))) (wa (wcel N cn) (wn (wbr c2 N cdvds))) $;

--| A prime not equal to ` 2 ` is odd. (Contributed by AV, 28-Jun-2021.)
theorem oddn2prm (N: class):
  $ wi (wcel N (cdif cprime (csn c2))) (wn (wbr c2 N cdvds)) $;

--| A number is a prime number not equal to ` 2 ` iff it is an odd prime number. Conversion theorem for two representations of odd primes. (Contributed by AV, 14-Jul-2021.)
theorem nnoddn2prmb (N: class):
  $ wb (wcel N (cdif cprime (csn c2))) (wa (wcel N cprime) (wn (wbr c2 N cdvds))) $;

--| A prime less than 5 is either 2 or 3. (Contributed by AV, 5-Jul-2021.)
theorem prm23lt5 (P: class):
  $ wi (wa (wcel P cprime) (wbr P c5 clt)) (wo (wceq P c2) (wceq P c3)) $;

--| A prime is either 2 or 3 or greater than or equal to 5. (Contributed by AV, 5-Jul-2021.)
theorem prm23ge5 (P: class):
  $ wi (wcel P cprime) (w3o (wceq P c2) (wceq P c3) (wcel P (cfv c5 cuz))) $;

--| Lemma for ~ pythagtrip . Prove a weaker version of one direction of the theorem. (Contributed by Scott Fenton, 28-Mar-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem pythagtriplem1 {k m n: setvar} (A2 B2 C: class):
  $ wi (wrex n (wrex m (wrex k (w3a (wceq A2 (co (cv k) (co (co (cv m) c2 cexp) (co (cv n) c2 cexp) cmin) cmul)) (wceq B2 (co (cv k) (co c2 (co (cv m) (cv n) cmul) cmul) cmul)) (wceq C (co (cv k) (co (co (cv m) c2 cexp) (co (cv n) c2 cexp) caddc) cmul))) cn) cn) cn) (wceq (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co C c2 cexp)) $;

--| Lemma for ~ pythagtrip . Prove the full version of one direction of the theorem. (Contributed by Scott Fenton, 28-Mar-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem pythagtriplem2 {k m n: setvar} (A2 B2 C: class):
  $ wi (wa (wcel A2 cn) (wcel B2 cn)) (wi (wrex n (wrex m (wrex k (wa (wceq (cpr A2 B2) (cpr (co (cv k) (co (co (cv m) c2 cexp) (co (cv n) c2 cexp) cmin) cmul) (co (cv k) (co c2 (co (cv m) (cv n) cmul) cmul) cmul))) (wceq C (co (cv k) (co (co (cv m) c2 cexp) (co (cv n) c2 cexp) caddc) cmul))) cn) cn) cn) (wceq (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co C c2 cexp))) $;

--| Lemma for ~ pythagtrip . Show that ` C ` and ` B ` are relatively prime under some conditions. (Contributed by Scott Fenton, 8-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem pythagtriplem3 (A2 B2 C: class):
  $ wi (w3a (w3a (wcel A2 cn) (wcel B2 cn) (wcel C cn)) (wceq (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co C c2 cexp)) (wa (wceq (co A2 B2 cgcd) c1) (wn (wbr c2 A2 cdvds)))) (wceq (co B2 C cgcd) c1) $;

--| Lemma for ~ pythagtrip . Show that ` C - B ` and ` C + B ` are relatively prime. (Contributed by Scott Fenton, 12-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem pythagtriplem4 (A2 B2 C: class):
  $ wi (w3a (w3a (wcel A2 cn) (wcel B2 cn) (wcel C cn)) (wceq (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co C c2 cexp)) (wa (wceq (co A2 B2 cgcd) c1) (wn (wbr c2 A2 cdvds)))) (wceq (co (co C B2 cmin) (co C B2 caddc) cgcd) c1) $;

--| Lemma for ~ pythagtrip . Show that ` C - B ` is positive. (Contributed by Scott Fenton, 17-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem pythagtriplem10 (A2 B2 C: class):
  $ wi (wa (w3a (wcel A2 cn) (wcel B2 cn) (wcel C cn)) (wceq (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co C c2 cexp))) (wbr cc0 (co C B2 cmin) clt) $;

--| Lemma for ~ pythagtrip . Calculate ` ( sqrt `` ( C - B ) ) ` . (Contributed by Scott Fenton, 18-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem pythagtriplem6 (A2 B2 C: class):
  $ wi (w3a (w3a (wcel A2 cn) (wcel B2 cn) (wcel C cn)) (wceq (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co C c2 cexp)) (wa (wceq (co A2 B2 cgcd) c1) (wn (wbr c2 A2 cdvds)))) (wceq (cfv (co C B2 cmin) csqrt) (co (co C B2 cmin) A2 cgcd)) $;

--| Lemma for ~ pythagtrip . Calculate ` ( sqrt `` ( C + B ) ) ` . (Contributed by Scott Fenton, 18-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem pythagtriplem7 (A2 B2 C: class):
  $ wi (w3a (w3a (wcel A2 cn) (wcel B2 cn) (wcel C cn)) (wceq (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co C c2 cexp)) (wa (wceq (co A2 B2 cgcd) c1) (wn (wbr c2 A2 cdvds)))) (wceq (cfv (co C B2 caddc) csqrt) (co (co C B2 caddc) A2 cgcd)) $;

--| Lemma for ~ pythagtrip . Show that ` ( sqrt `` ( C - B ) ) ` is a positive integer. (Contributed by Scott Fenton, 17-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem pythagtriplem8 (A2 B2 C: class):
  $ wi (w3a (w3a (wcel A2 cn) (wcel B2 cn) (wcel C cn)) (wceq (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co C c2 cexp)) (wa (wceq (co A2 B2 cgcd) c1) (wn (wbr c2 A2 cdvds)))) (wcel (cfv (co C B2 cmin) csqrt) cn) $;

--| Lemma for ~ pythagtrip . Show that ` ( sqrt `` ( C + B ) ) ` is a positive integer. (Contributed by Scott Fenton, 17-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem pythagtriplem9 (A2 B2 C: class):
  $ wi (w3a (w3a (wcel A2 cn) (wcel B2 cn) (wcel C cn)) (wceq (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co C c2 cexp)) (wa (wceq (co A2 B2 cgcd) c1) (wn (wbr c2 A2 cdvds)))) (wcel (cfv (co C B2 caddc) csqrt) cn) $;

--| Lemma for ~ pythagtrip . Show that ` M ` (which will eventually be closely related to the ` m ` in the final statement) is a natural. (Contributed by Scott Fenton, 17-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem pythagtriplem11 (A2 B2 C M: class):
  $ wceq M (co (co (cfv (co C B2 caddc) csqrt) (cfv (co C B2 cmin) csqrt) caddc) c2 cdiv) $ >
  $ wi (w3a (w3a (wcel A2 cn) (wcel B2 cn) (wcel C cn)) (wceq (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co C c2 cexp)) (wa (wceq (co A2 B2 cgcd) c1) (wn (wbr c2 A2 cdvds)))) (wcel M cn) $;

--| Lemma for ~ pythagtrip . Calculate the square of ` M ` . (Contributed by Scott Fenton, 17-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem pythagtriplem12 (A2 B2 C M: class):
  $ wceq M (co (co (cfv (co C B2 caddc) csqrt) (cfv (co C B2 cmin) csqrt) caddc) c2 cdiv) $ >
  $ wi (w3a (w3a (wcel A2 cn) (wcel B2 cn) (wcel C cn)) (wceq (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co C c2 cexp)) (wa (wceq (co A2 B2 cgcd) c1) (wn (wbr c2 A2 cdvds)))) (wceq (co M c2 cexp) (co (co C A2 caddc) c2 cdiv)) $;

--| Lemma for ~ pythagtrip . Show that ` N ` (which will eventually be closely related to the ` n ` in the final statement) is a natural. (Contributed by Scott Fenton, 17-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem pythagtriplem13 (A2 B2 C N: class):
  $ wceq N (co (co (cfv (co C B2 caddc) csqrt) (cfv (co C B2 cmin) csqrt) cmin) c2 cdiv) $ >
  $ wi (w3a (w3a (wcel A2 cn) (wcel B2 cn) (wcel C cn)) (wceq (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co C c2 cexp)) (wa (wceq (co A2 B2 cgcd) c1) (wn (wbr c2 A2 cdvds)))) (wcel N cn) $;

--| Lemma for ~ pythagtrip . Calculate the square of ` N ` . (Contributed by Scott Fenton, 17-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem pythagtriplem14 (A2 B2 C N: class):
  $ wceq N (co (co (cfv (co C B2 caddc) csqrt) (cfv (co C B2 cmin) csqrt) cmin) c2 cdiv) $ >
  $ wi (w3a (w3a (wcel A2 cn) (wcel B2 cn) (wcel C cn)) (wceq (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co C c2 cexp)) (wa (wceq (co A2 B2 cgcd) c1) (wn (wbr c2 A2 cdvds)))) (wceq (co N c2 cexp) (co (co C A2 cmin) c2 cdiv)) $;

--| Lemma for ~ pythagtrip . Show the relationship between ` M ` , ` N ` , and ` A ` . (Contributed by Scott Fenton, 17-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem pythagtriplem15 (A2 B2 C M N: class):
  $ wceq M (co (co (cfv (co C B2 caddc) csqrt) (cfv (co C B2 cmin) csqrt) caddc) c2 cdiv) $ >
  $ wceq N (co (co (cfv (co C B2 caddc) csqrt) (cfv (co C B2 cmin) csqrt) cmin) c2 cdiv) $ >
  $ wi (w3a (w3a (wcel A2 cn) (wcel B2 cn) (wcel C cn)) (wceq (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co C c2 cexp)) (wa (wceq (co A2 B2 cgcd) c1) (wn (wbr c2 A2 cdvds)))) (wceq A2 (co (co M c2 cexp) (co N c2 cexp) cmin)) $;

--| Lemma for ~ pythagtrip . Show the relationship between ` M ` , ` N ` , and ` B ` . (Contributed by Scott Fenton, 17-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem pythagtriplem16 (A2 B2 C M N: class):
  $ wceq M (co (co (cfv (co C B2 caddc) csqrt) (cfv (co C B2 cmin) csqrt) caddc) c2 cdiv) $ >
  $ wceq N (co (co (cfv (co C B2 caddc) csqrt) (cfv (co C B2 cmin) csqrt) cmin) c2 cdiv) $ >
  $ wi (w3a (w3a (wcel A2 cn) (wcel B2 cn) (wcel C cn)) (wceq (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co C c2 cexp)) (wa (wceq (co A2 B2 cgcd) c1) (wn (wbr c2 A2 cdvds)))) (wceq B2 (co c2 (co M N cmul) cmul)) $;

--| Lemma for ~ pythagtrip . Show the relationship between ` M ` , ` N ` , and ` C ` . (Contributed by Scott Fenton, 17-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem pythagtriplem17 (A2 B2 C M N: class):
  $ wceq M (co (co (cfv (co C B2 caddc) csqrt) (cfv (co C B2 cmin) csqrt) caddc) c2 cdiv) $ >
  $ wceq N (co (co (cfv (co C B2 caddc) csqrt) (cfv (co C B2 cmin) csqrt) cmin) c2 cdiv) $ >
  $ wi (w3a (w3a (wcel A2 cn) (wcel B2 cn) (wcel C cn)) (wceq (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co C c2 cexp)) (wa (wceq (co A2 B2 cgcd) c1) (wn (wbr c2 A2 cdvds)))) (wceq C (co (co M c2 cexp) (co N c2 cexp) caddc)) $;

--| Lemma for ~ pythagtrip . Wrap the previous ` M ` and ` N ` up in quantifiers. (Contributed by Scott Fenton, 18-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem pythagtriplem18 {m n: setvar} (A2 B2 C: class):
  $ wi (w3a (w3a (wcel A2 cn) (wcel B2 cn) (wcel C cn)) (wceq (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co C c2 cexp)) (wa (wceq (co A2 B2 cgcd) c1) (wn (wbr c2 A2 cdvds)))) (wrex n (wrex m (w3a (wceq A2 (co (co (cv m) c2 cexp) (co (cv n) c2 cexp) cmin)) (wceq B2 (co c2 (co (cv m) (cv n) cmul) cmul)) (wceq C (co (co (cv m) c2 cexp) (co (cv n) c2 cexp) caddc))) cn) cn) $;

--| Lemma for ~ pythagtrip . Introduce ` k ` and remove the relative primality requirement. (Contributed by Scott Fenton, 18-Apr-2014.) (Revised by Mario Carneiro, 19-Apr-2014.)
theorem pythagtriplem19 {k m n: setvar} (A2 B2 C: class):
  $ wi (w3a (w3a (wcel A2 cn) (wcel B2 cn) (wcel C cn)) (wceq (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co C c2 cexp)) (wn (wbr c2 (co A2 (co A2 B2 cgcd) cdiv) cdvds))) (wrex n (wrex m (wrex k (w3a (wceq A2 (co (cv k) (co (co (cv m) c2 cexp) (co (cv n) c2 cexp) cmin) cmul)) (wceq B2 (co (cv k) (co c2 (co (cv m) (cv n) cmul) cmul) cmul)) (wceq C (co (cv k) (co (co (cv m) c2 cexp) (co (cv n) c2 cexp) caddc) cmul))) cn) cn) cn) $;

--| Parameterize the Pythagorean triples. If ` A ` , ` B ` , and ` C ` are naturals, then they obey the Pythagorean triple formula iff they are parameterized by three naturals. This proof follows the Isabelle proof at ~ http://afp.sourceforge.net/entries/Fermat3_4.shtml . This is Metamath 100 proof #23. (Contributed by Scott Fenton, 19-Apr-2014.)
theorem pythagtrip {k m n: setvar} (A2 B2 C: class):
  $ wi (w3a (wcel A2 cn) (wcel B2 cn) (wcel C cn)) (wb (wceq (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co C c2 cexp)) (wrex n (wrex m (wrex k (wa (wceq (cpr A2 B2) (cpr (co (cv k) (co (co (cv m) c2 cexp) (co (cv n) c2 cexp) cmin) cmul) (co (cv k) (co c2 (co (cv m) (cv n) cmul) cmul) cmul))) (wceq C (co (cv k) (co (co (cv m) c2 cexp) (co (cv n) c2 cexp) caddc) cmul))) cn) cn) cn)) $;

--| Collect the odd terms in a sequence. (Contributed by Mario Carneiro, 7-Apr-2015.) (Proof shortened by AV, 10-Jul-2022.)
theorem iserodd {k n: setvar} (ph: wff) (A2: class k n) (B2: class n) (C: class k):
  $ wi (wa ph (wcel (cv k) cn0)) (wcel C cc) $ >
  $ wi (wceq (cv n) (co (co c2 (cv k) cmul) c1 caddc)) (wceq B2 C) $ >
  $ wi ph (wb (wbr (cseq caddc (cmpt k cn0 C) cc0) A2 cli) (wbr (cseq caddc (cmpt n cn (cif (wbr c2 (cv n) cdvds) cc0 B2)) c1) A2 cli)) $;

--| Extend class notation with the prime count function.
term cpc: class;

--| Define the prime count function, which returns the largest exponent of a given prime (or other positive integer) that divides the number. For rational numbers, it returns negative values according to the power of a prime in the denominator. (Contributed by Mario Carneiro, 23-Feb-2014.)
axiom df_pc {x3 y1 z n r p: setvar}:
  $ wceq cpc (cmpo p r cprime cq (cif (wceq (cv r) cc0) cpnf (cio z (wrex x3 (wrex y1 (wa (wceq (cv r) (co (cv x3) (cv y1) cdiv)) (wceq (cv z) (co (csup (crab n (wbr (co (cv p) (cv n) cexp) (cv x3) cdvds) cn0) cr clt) (csup (crab n (wbr (co (cv p) (cv n) cexp) (cv y1) cdvds) cn0) cr clt) cmin))) cn) cz)))) $;

--| - Lemma for the prime power pre-function's properties. (Contributed by Mario Carneiro, 23-Feb-2014.)
theorem pclem {x3 y1 n: setvar} (A2: class n) (P N: class):
  $ wceq A2 (crab n (wbr (co P (cv n) cexp) N cdvds) cn0) $ >
  $ wi (wa (wcel P (cfv c2 cuz)) (wa (wcel N cz) (wne N cc0))) (w3a (wss A2 cz) (wne A2 c0) (wrex x3 (wral y1 (wbr (cv y1) (cv x3) cle) A2) cz)) $;

--| Closure of the prime power pre-function. (Contributed by Mario Carneiro, 23-Feb-2014.)
theorem pcprecl {n: setvar} (A2: class n) (P: class) (S: class n) (N: class):
  $ wceq A2 (crab n (wbr (co P (cv n) cexp) N cdvds) cn0) $ >
  $ wceq S (csup A2 cr clt) $ >
  $ wi (wa (wcel P (cfv c2 cuz)) (wa (wcel N cz) (wne N cc0))) (wa (wcel S cn0) (wbr (co P S cexp) N cdvds)) $;

--| Non-divisibility property of the prime power pre-function. (Contributed by Mario Carneiro, 23-Feb-2014.)
theorem pcprendvds {n: setvar} (A2: class n) (P: class) (S: class n) (N: class):
  $ wceq A2 (crab n (wbr (co P (cv n) cexp) N cdvds) cn0) $ >
  $ wceq S (csup A2 cr clt) $ >
  $ wi (wa (wcel P (cfv c2 cuz)) (wa (wcel N cz) (wne N cc0))) (wn (wbr (co P (co S c1 caddc) cexp) N cdvds)) $;

--| Non-divisibility property of the prime power pre-function. (Contributed by Mario Carneiro, 23-Feb-2014.)
theorem pcprendvds2 {n: setvar} (A2: class n) (P: class) (S: class n) (N: class):
  $ wceq A2 (crab n (wbr (co P (cv n) cexp) N cdvds) cn0) $ >
  $ wceq S (csup A2 cr clt) $ >
  $ wi (wa (wcel P (cfv c2 cuz)) (wa (wcel N cz) (wne N cc0))) (wn (wbr P (co N (co P S cexp) cdiv) cdvds)) $;

--| Value of the prime power pre-function at 1. (Contributed by Mario Carneiro, 23-Feb-2014.) (Revised by Mario Carneiro, 26-Apr-2016.)
theorem pcpre1 {n: setvar} (A2: class n) (P: class) (S: class n) (N: class):
  $ wceq A2 (crab n (wbr (co P (cv n) cexp) N cdvds) cn0) $ >
  $ wceq S (csup A2 cr clt) $ >
  $ wi (wa (wcel P (cfv c2 cuz)) (wceq N c1)) (wceq S cc0) $;

--| Multiplicative property of the prime count pre-function. Note that the primality of ` P ` is essential for this property; ` ( 4 pCnt 2 ) = 0 ` but ` ( 4 pCnt ( 2 x. 2 ) ) = 1 =/= 2 x. ( 4 pCnt 2 ) = 0 ` . Since this is needed to show uniqueness for the real prime count function (over ` QQ ` ), we don't bother to define it off the primes. (Contributed by Mario Carneiro, 23-Feb-2014.)
theorem pcpremul {n: setvar} (P: class) (S T U: class n) (M N: class):
  $ wceq S (csup (crab n (wbr (co P (cv n) cexp) M cdvds) cn0) cr clt) $ >
  $ wceq T (csup (crab n (wbr (co P (cv n) cexp) N cdvds) cn0) cr clt) $ >
  $ wceq U (csup (crab n (wbr (co P (cv n) cexp) (co M N cmul) cdvds) cn0) cr clt) $ >
  $ wi (w3a (wcel P cprime) (wa (wcel M cz) (wne M cc0)) (wa (wcel N cz) (wne N cc0))) (wceq (co S T caddc) U) $;

--| The value of the prime power function. (Contributed by Mario Carneiro, 23-Feb-2014.) (Revised by Mario Carneiro, 3-Oct-2014.)
theorem pcval {x3 y1 z n: setvar} (P: class) (S T: class x3 y1 n) (N: class):
  $ wceq S (csup (crab n (wbr (co P (cv n) cexp) (cv x3) cdvds) cn0) cr clt) $ >
  $ wceq T (csup (crab n (wbr (co P (cv n) cexp) (cv y1) cdvds) cn0) cr clt) $ >
  $ wi (wa (wcel P cprime) (wa (wcel N cq) (wne N cc0))) (wceq (co P N cpc) (cio z (wrex x3 (wrex y1 (wa (wceq N (co (cv x3) (cv y1) cdiv)) (wceq (cv z) (co S T cmin))) cn) cz))) $;

--| Lemma for ~ pceu . (Contributed by Mario Carneiro, 23-Feb-2014.)
theorem pceulem {x3 y1 t n s1: setvar} (ph: wff x3 y1 t n s1) (P: class) (S T: class x3 y1 n) (U: class x3 y1 t n s1) (N: class) (V: class x3 y1 t n s1):
  $ wceq S (csup (crab n (wbr (co P (cv n) cexp) (cv x3) cdvds) cn0) cr clt) $ >
  $ wceq T (csup (crab n (wbr (co P (cv n) cexp) (cv y1) cdvds) cn0) cr clt) $ >
  $ wceq U (csup (crab n (wbr (co P (cv n) cexp) (cv s1) cdvds) cn0) cr clt) $ >
  $ wceq V (csup (crab n (wbr (co P (cv n) cexp) (cv t) cdvds) cn0) cr clt) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wne N cc0) $ >
  $ wi ph (wa (wcel (cv x3) cz) (wcel (cv y1) cn)) $ >
  $ wi ph (wceq N (co (cv x3) (cv y1) cdiv)) $ >
  $ wi ph (wa (wcel (cv s1) cz) (wcel (cv t) cn)) $ >
  $ wi ph (wceq N (co (cv s1) (cv t) cdiv)) $ >
  $ wi ph (wceq (co S T cmin) (co U V cmin)) $;

--| Uniqueness for the prime power function. (Contributed by Mario Carneiro, 23-Feb-2014.)
theorem pceu {x3 y1 z n: setvar} (P: class) (S T: class x3 y1 n) (N: class):
  $ wceq S (csup (crab n (wbr (co P (cv n) cexp) (cv x3) cdvds) cn0) cr clt) $ >
  $ wceq T (csup (crab n (wbr (co P (cv n) cexp) (cv y1) cdvds) cn0) cr clt) $ >
  $ wi (wa (wcel P cprime) (wa (wcel N cq) (wne N cc0))) (weu z (wrex x3 (wrex y1 (wa (wceq N (co (cv x3) (cv y1) cdiv)) (wceq (cv z) (co S T cmin))) cn) cz)) $;

--| Connect the prime count pre-function to the actual prime count function, when restricted to the integers. (Contributed by Mario Carneiro, 23-Feb-2014.) (Proof shortened by Mario Carneiro, 24-Dec-2016.)
theorem pczpre {n: setvar} (P: class) (S: class n) (N: class):
  $ wceq S (csup (crab n (wbr (co P (cv n) cexp) N cdvds) cn0) cr clt) $ >
  $ wi (wa (wcel P cprime) (wa (wcel N cz) (wne N cc0))) (wceq (co P N cpc) S) $;

--| Closure of the prime power function. (Contributed by Mario Carneiro, 23-Feb-2014.)
theorem pczcl (P N: class):
  $ wi (wa (wcel P cprime) (wa (wcel N cz) (wne N cc0))) (wcel (co P N cpc) cn0) $;

--| Closure of the prime power function. (Contributed by Mario Carneiro, 23-Feb-2014.)
theorem pccl (P N: class):
  $ wi (wa (wcel P cprime) (wcel N cn)) (wcel (co P N cpc) cn0) $;

--| Closure of the prime power function. (Contributed by Mario Carneiro, 29-May-2016.)
theorem pccld (ph: wff) (P N: class):
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel (co P N cpc) cn0) $;

--| Multiplication property of the prime power function. (Contributed by Mario Carneiro, 23-Feb-2014.)
theorem pcmul (A2 B2 P: class):
  $ wi (w3a (wcel P cprime) (wa (wcel A2 cz) (wne A2 cc0)) (wa (wcel B2 cz) (wne B2 cc0))) (wceq (co P (co A2 B2 cmul) cpc) (co (co P A2 cpc) (co P B2 cpc) caddc)) $;

--| Division property of the prime power function. (Contributed by Mario Carneiro, 1-Mar-2014.)
theorem pcdiv (A2 B2 P: class):
  $ wi (w3a (wcel P cprime) (wa (wcel A2 cz) (wne A2 cc0)) (wcel B2 cn)) (wceq (co P (co A2 B2 cdiv) cpc) (co (co P A2 cpc) (co P B2 cpc) cmin)) $;

--| Multiplication property of the prime power function. (Contributed by Mario Carneiro, 9-Sep-2014.)
theorem pcqmul (A2 B2 P: class):
  $ wi (w3a (wcel P cprime) (wa (wcel A2 cq) (wne A2 cc0)) (wa (wcel B2 cq) (wne B2 cc0))) (wceq (co P (co A2 B2 cmul) cpc) (co (co P A2 cpc) (co P B2 cpc) caddc)) $;

--| The value of the prime power function at zero. (Contributed by Mario Carneiro, 3-Oct-2014.)
theorem pc0 (P: class):
  $ wi (wcel P cprime) (wceq (co P cc0 cpc) cpnf) $;

--| Value of the prime count function at 1. (Contributed by Mario Carneiro, 23-Feb-2014.)
theorem pc1 (P: class):
  $ wi (wcel P cprime) (wceq (co P c1 cpc) cc0) $;

--| Closure of the general prime count function. (Contributed by Mario Carneiro, 23-Feb-2014.)
theorem pcqcl (P N: class):
  $ wi (wa (wcel P cprime) (wa (wcel N cq) (wne N cc0))) (wcel (co P N cpc) cz) $;

--| Division property of the prime power function. (Contributed by Mario Carneiro, 10-Aug-2015.)
theorem pcqdiv (A2 B2 P: class):
  $ wi (w3a (wcel P cprime) (wa (wcel A2 cq) (wne A2 cc0)) (wa (wcel B2 cq) (wne B2 cc0))) (wceq (co P (co A2 B2 cdiv) cpc) (co (co P A2 cpc) (co P B2 cpc) cmin)) $;

--| Prime power of a reciprocal. (Contributed by Mario Carneiro, 10-Aug-2015.)
theorem pcrec (A2 P: class):
  $ wi (wa (wcel P cprime) (wa (wcel A2 cq) (wne A2 cc0))) (wceq (co P (co c1 A2 cdiv) cpc) (cneg (co P A2 cpc))) $;

--| Prime power of an exponential. (Contributed by Mario Carneiro, 10-Aug-2015.)
theorem pcexp (A2 P N: class):
  $ wi (w3a (wcel P cprime) (wa (wcel A2 cq) (wne A2 cc0)) (wcel N cz)) (wceq (co P (co A2 N cexp) cpc) (co N (co P A2 cpc) cmul)) $;

--| Extended nonnegative integer closure of the general prime count function. (Contributed by Jim Kingdon, 13-Oct-2024.)
theorem pcxnn0cl (P N: class):
  $ wi (wa (wcel P cprime) (wcel N cz)) (wcel (co P N cpc) cxnn0) $;

--| Extended real closure of the general prime count function. (Contributed by Mario Carneiro, 3-Oct-2014.)
theorem pcxcl (P N: class):
  $ wi (wa (wcel P cprime) (wcel N cq)) (wcel (co P N cpc) cxr) $;

--| The prime count of an integer is greater than or equal to zero. (Contributed by Mario Carneiro, 3-Oct-2014.)
theorem pcge0 (P N: class):
  $ wi (wa (wcel P cprime) (wcel N cz)) (wbr cc0 (co P N cpc) cle) $;

--| Defining property of the prime count function. (Contributed by Mario Carneiro, 9-Sep-2014.)
theorem pczdvds (P N: class):
  $ wi (wa (wcel P cprime) (wa (wcel N cz) (wne N cc0))) (wbr (co P (co P N cpc) cexp) N cdvds) $;

--| Defining property of the prime count function. (Contributed by Mario Carneiro, 23-Feb-2014.)
theorem pcdvds (P N: class):
  $ wi (wa (wcel P cprime) (wcel N cn)) (wbr (co P (co P N cpc) cexp) N cdvds) $;

--| Defining property of the prime count function. (Contributed by Mario Carneiro, 3-Oct-2014.)
theorem pczndvds (P N: class):
  $ wi (wa (wcel P cprime) (wa (wcel N cz) (wne N cc0))) (wn (wbr (co P (co (co P N cpc) c1 caddc) cexp) N cdvds)) $;

--| Defining property of the prime count function. (Contributed by Mario Carneiro, 23-Feb-2014.)
theorem pcndvds (P N: class):
  $ wi (wa (wcel P cprime) (wcel N cn)) (wn (wbr (co P (co (co P N cpc) c1 caddc) cexp) N cdvds)) $;

--| The remainder after dividing out all factors of ` P ` is not divisible by ` P ` . (Contributed by Mario Carneiro, 9-Sep-2014.)
theorem pczndvds2 (P N: class):
  $ wi (wa (wcel P cprime) (wa (wcel N cz) (wne N cc0))) (wn (wbr P (co N (co P (co P N cpc) cexp) cdiv) cdvds)) $;

--| The remainder after dividing out all factors of ` P ` is not divisible by ` P ` . (Contributed by Mario Carneiro, 23-Feb-2014.)
theorem pcndvds2 (P N: class):
  $ wi (wa (wcel P cprime) (wcel N cn)) (wn (wbr P (co N (co P (co P N cpc) cexp) cdiv) cdvds)) $;

--| ` P ^ A ` divides ` N ` if and only if ` A ` is at most the count of ` P ` . (Contributed by Mario Carneiro, 3-Oct-2014.)
theorem pcdvdsb (A2 P N: class):
  $ wi (w3a (wcel P cprime) (wcel N cz) (wcel A2 cn0)) (wb (wbr A2 (co P N cpc) cle) (wbr (co P A2 cexp) N cdvds)) $;

--| There are a positive number of powers of a prime ` P ` in ` N ` iff ` P ` divides ` N ` . (Contributed by Mario Carneiro, 23-Feb-2014.)
theorem pcelnn (P N: class):
  $ wi (wa (wcel P cprime) (wcel N cn)) (wb (wcel (co P N cpc) cn) (wbr P N cdvds)) $;

--| There are zero powers of a prime ` P ` in ` N ` iff ` P ` does not divide ` N ` . (Contributed by Mario Carneiro, 23-Feb-2014.)
theorem pceq0 (P N: class):
  $ wi (wa (wcel P cprime) (wcel N cn)) (wb (wceq (co P N cpc) cc0) (wn (wbr P N cdvds))) $;

--| The prime count of a prime power. (Contributed by Mario Carneiro, 12-Mar-2014.)
theorem pcidlem (A2 P: class):
  $ wi (wa (wcel P cprime) (wcel A2 cn0)) (wceq (co P (co P A2 cexp) cpc) A2) $;

--| The prime count of a prime power. (Contributed by Mario Carneiro, 9-Sep-2014.)
theorem pcid (A2 P: class):
  $ wi (wa (wcel P cprime) (wcel A2 cz)) (wceq (co P (co P A2 cexp) cpc) A2) $;

--| The prime count of a negative number. (Contributed by Mario Carneiro, 13-Mar-2014.)
theorem pcneg (A2 P: class):
  $ wi (wa (wcel P cprime) (wcel A2 cq)) (wceq (co P (cneg A2) cpc) (co P A2 cpc)) $;

--| The prime count of an absolute value. (Contributed by Mario Carneiro, 13-Mar-2014.)
theorem pcabs (A2 P: class):
  $ wi (wa (wcel P cprime) (wcel A2 cq)) (wceq (co P (cfv A2 cabs) cpc) (co P A2 cpc)) $;

--| The prime count increases under the divisibility relation. (Contributed by Mario Carneiro, 13-Mar-2014.)
theorem pcdvdstr (A2 B2 P: class):
  $ wi (wa (wcel P cprime) (w3a (wcel A2 cz) (wcel B2 cz) (wbr A2 B2 cdvds))) (wbr (co P A2 cpc) (co P B2 cpc) cle) $;

--| The prime count of a GCD is the minimum of the prime counts of the arguments. (Contributed by Mario Carneiro, 3-Oct-2014.)
theorem pcgcd1 (A2 B2 P: class):
  $ wi (wa (w3a (wcel P cprime) (wcel A2 cz) (wcel B2 cz)) (wbr (co P A2 cpc) (co P B2 cpc) cle)) (wceq (co P (co A2 B2 cgcd) cpc) (co P A2 cpc)) $;

--| The prime count of a GCD is the minimum of the prime counts of the arguments. (Contributed by Mario Carneiro, 3-Oct-2014.)
theorem pcgcd (A2 B2 P: class):
  $ wi (w3a (wcel P cprime) (wcel A2 cz) (wcel B2 cz)) (wceq (co P (co A2 B2 cgcd) cpc) (cif (wbr (co P A2 cpc) (co P B2 cpc) cle) (co P A2 cpc) (co P B2 cpc))) $;

--| A characterization of divisibility in terms of prime count. (Contributed by Mario Carneiro, 23-Feb-2014.) (Revised by Mario Carneiro, 3-Oct-2014.)
theorem pc2dvds {p: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cz)) (wb (wbr A2 B2 cdvds) (wral p (wbr (co (cv p) A2 cpc) (co (cv p) B2 cpc) cle) cprime)) $;

--| The prime count function, viewed as a function from ` NN ` to ` ( NN ^m Prime ) ` , is one-to-one. (Contributed by Mario Carneiro, 23-Feb-2014.)
theorem pc11 {p: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cn0) (wcel B2 cn0)) (wb (wceq A2 B2) (wral p (wceq (co (cv p) A2 cpc) (co (cv p) B2 cpc)) cprime)) $;

--| The prime count function can be used as an indicator that a given rational number is an integer. (Contributed by Mario Carneiro, 23-Feb-2014.)
theorem pcz {p: setvar} (A2: class):
  $ wi (wcel A2 cq) (wb (wcel A2 cz) (wral p (wbr cc0 (co (cv p) A2 cpc) cle) cprime)) $;

--| Self-referential expression for a prime power. (Contributed by Mario Carneiro, 16-Jan-2015.)
theorem pcprmpw2 {n: setvar} (A2 P: class):
  $ wi (wa (wcel P cprime) (wcel A2 cn)) (wb (wrex n (wbr A2 (co P (cv n) cexp) cdvds) cn0) (wceq A2 (co P (co P A2 cpc) cexp))) $;

--| Self-referential expression for a prime power. (Contributed by Mario Carneiro, 16-Jan-2015.)
theorem pcprmpw {n: setvar} (A2 P: class):
  $ wi (wa (wcel P cprime) (wcel A2 cn)) (wb (wrex n (wceq A2 (co P (cv n) cexp)) cn0) (wceq A2 (co P (co P A2 cpc) cexp))) $;

--| If a positive integer divides a prime power, it is a prime power. (Contributed by AV, 25-Jul-2021.)
theorem dvdsprmpweq {n: setvar} (A2 P N: class):
  $ wi (w3a (wcel P cprime) (wcel A2 cn) (wcel N cn0)) (wi (wbr A2 (co P N cexp) cdvds) (wrex n (wceq A2 (co P (cv n) cexp)) cn0)) $;

--| If an integer greater than 1 divides a prime power, it is a (proper) prime power. (Contributed by AV, 13-Aug-2021.)
theorem dvdsprmpweqnn {n: setvar} (A2 P N: class):
  $ wi (w3a (wcel P cprime) (wcel A2 (cfv c2 cuz)) (wcel N cn0)) (wi (wbr A2 (co P N cexp) cdvds) (wrex n (wceq A2 (co P (cv n) cexp)) cn)) $;

--| If a positive integer divides a prime power, it is a prime power with a smaller exponent. (Contributed by AV, 25-Jul-2021.)
theorem dvdsprmpweqle {n: setvar} (A2 P N: class):
  $ wi (w3a (wcel P cprime) (wcel A2 cn) (wcel N cn0)) (wi (wbr A2 (co P N cexp) cdvds) (wrex n (wa (wbr (cv n) N cle) (wceq A2 (co P (cv n) cexp))) cn0)) $;

--| If the difference of two squares is a power of a prime, the prime divides twice the second squared number. (Contributed by AV, 13-Aug-2021.)
theorem difsqpwdvds (A2 B2 C D: class):
  $ wi (wa (w3a (wcel A2 cn0) (wcel B2 cn0) (wbr (co B2 c1 caddc) A2 clt)) (wa (wcel C cprime) (wcel D cn0))) (wi (wceq (co C D cexp) (co (co A2 c2 cexp) (co B2 c2 cexp) cmin)) (wbr C (co c2 B2 cmul) cdvds)) $;

--| Lemma for ~ pcadd . The original numbers ` A ` and ` B ` have been decomposed using the prime count function as ` ( P ^ M ) x. ( R / S ) ` where ` R , S ` are both not divisible by ` P ` and ` M = ( P pCnt A ) ` , and similarly for ` B ` . (Contributed by Mario Carneiro, 9-Sep-2014.)
theorem pcaddlem (ph: wff) (A2 B2 P R S T U M N: class):
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wceq A2 (co (co P M cexp) (co R S cdiv) cmul)) $ >
  $ wi ph (wceq B2 (co (co P N cexp) (co T U cdiv) cmul)) $ >
  $ wi ph (wcel N (cfv M cuz)) $ >
  $ wi ph (wa (wcel R cz) (wn (wbr P R cdvds))) $ >
  $ wi ph (wa (wcel S cn) (wn (wbr P S cdvds))) $ >
  $ wi ph (wa (wcel T cz) (wn (wbr P T cdvds))) $ >
  $ wi ph (wa (wcel U cn) (wn (wbr P U cdvds))) $ >
  $ wi ph (wbr M (co P (co A2 B2 caddc) cpc) cle) $;

--| An inequality for the prime count of a sum. This is the source of the ultrametric inequality for the p-adic metric. (Contributed by Mario Carneiro, 9-Sep-2014.)
theorem pcadd (ph: wff) (A2 B2 P: class):
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel A2 cq) $ >
  $ wi ph (wcel B2 cq) $ >
  $ wi ph (wbr (co P A2 cpc) (co P B2 cpc) cle) $ >
  $ wi ph (wbr (co P A2 cpc) (co P (co A2 B2 caddc) cpc) cle) $;

--| The inequality of ~ pcadd becomes an equality when one of the factors has prime count strictly less than the other. (Contributed by Mario Carneiro, 16-Jan-2015.) (Revised by Mario Carneiro, 26-Jun-2015.)
theorem pcadd2 (ph: wff) (A2 B2 P: class):
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wcel A2 cq) $ >
  $ wi ph (wcel B2 cq) $ >
  $ wi ph (wbr (co P A2 cpc) (co P B2 cpc) clt) $ >
  $ wi ph (wceq (co P A2 cpc) (co P (co A2 B2 caddc) cpc)) $;

--| Closure for the prime power map. (Contributed by Mario Carneiro, 12-Mar-2014.)
theorem pcmptcl {n: setvar} (ph: wff n) (A2 F: class n):
  $ wceq F (cmpt n cn (cif (wcel (cv n) cprime) (co (cv n) A2 cexp) c1)) $ >
  $ wi ph (wral n (wcel A2 cn0) cprime) $ >
  $ wi ph (wa (wf cn cn F) (wf cn cn (cseq cmul F c1))) $;

--| Construct a function with given prime count characteristics. (Contributed by Mario Carneiro, 12-Mar-2014.)
theorem pcmpt {n: setvar} (ph: wff n) (A2: class n) (B2 P: class) (F N: class n):
  $ wceq F (cmpt n cn (cif (wcel (cv n) cprime) (co (cv n) A2 cexp) c1)) $ >
  $ wi ph (wral n (wcel A2 cn0) cprime) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi (wceq (cv n) P) (wceq A2 B2) $ >
  $ wi ph (wceq (co P (cfv N (cseq cmul F c1)) cpc) (cif (wbr P N cle) B2 cc0)) $;

--| Dividing two prime count maps yields a number with all dividing primes confined to an interval. (Contributed by Mario Carneiro, 14-Mar-2014.)
theorem pcmpt2 {n: setvar} (ph: wff n) (A2: class n) (B2 P: class) (F M N: class n):
  $ wceq F (cmpt n cn (cif (wcel (cv n) cprime) (co (cv n) A2 cexp) c1)) $ >
  $ wi ph (wral n (wcel A2 cn0) cprime) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi (wceq (cv n) P) (wceq A2 B2) $ >
  $ wi ph (wcel M (cfv N cuz)) $ >
  $ wi ph (wceq (co P (co (cfv M (cseq cmul F c1)) (cfv N (cseq cmul F c1)) cdiv) cpc) (cif (wa (wbr P M cle) (wn (wbr P N cle))) B2 cc0)) $;

--| The partial products of the prime power map form a divisibility chain. (Contributed by Mario Carneiro, 12-Mar-2014.)
theorem pcmptdvds {n: setvar} (ph: wff n) (A2 F M N: class n):
  $ wceq F (cmpt n cn (cif (wcel (cv n) cprime) (co (cv n) A2 cexp) c1)) $ >
  $ wi ph (wral n (wcel A2 cn0) cprime) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wcel M (cfv N cuz)) $ >
  $ wi ph (wbr (cfv N (cseq cmul F c1)) (cfv M (cseq cmul F c1)) cdvds) $;

--| The product of the primes taken to their respective powers reconstructs the original number. (Contributed by Mario Carneiro, 12-Mar-2014.)
theorem pcprod {n: setvar} (F: class n) (N: class):
  $ wceq F (cmpt n cn (cif (wcel (cv n) cprime) (co (cv n) (co (cv n) N cpc) cexp) c1)) $ >
  $ wi (wcel N cn) (wceq (cfv N (cseq cmul F c1)) N) $;

--| The sum of 1 over a set is the size of the set. (Contributed by Mario Carneiro, 8-Mar-2014.) (Revised by Mario Carneiro, 20-May-2014.)
theorem sumhash {k: setvar} (A2 B2: class):
  $ wi (wa (wcel B2 cfn) (wss A2 B2)) (wceq (csu k B2 (cif (wcel (cv k) A2) c1 cc0)) (cfv A2 chash)) $;

--| The difference between the floors of adjacent fractions is either 1 or 0. (Contributed by Mario Carneiro, 8-Mar-2014.)
theorem fldivp1 (M N: class):
  $ wi (wa (wcel M cz) (wcel N cn)) (wceq (co (cfv (co (co M c1 caddc) N cdiv) cfl) (cfv (co M N cdiv) cfl) cmin) (cif (wbr N (co M c1 caddc) cdvds) c1 cc0)) $;

--| Lemma for ~ pcfac . (Contributed by Mario Carneiro, 20-May-2014.)
theorem pcfaclem (P M N: class):
  $ wi (w3a (wcel N cn0) (wcel M (cfv N cuz)) (wcel P cprime)) (wceq (cfv (co N (co P M cexp) cdiv) cfl) cc0) $;

--| Calculate the prime count of a factorial. (Contributed by Mario Carneiro, 11-Mar-2014.) (Revised by Mario Carneiro, 21-May-2014.)
theorem pcfac {k: setvar} (P M N: class):
  $ wi (w3a (wcel N cn0) (wcel M (cfv N cuz)) (wcel P cprime)) (wceq (co P (cfv N cfa) cpc) (csu k (co c1 M cfz) (cfv (co N (co P (cv k) cexp) cdiv) cfl))) $;

--| Calculate the prime count of a binomial coefficient. (Contributed by Mario Carneiro, 11-Mar-2014.) (Revised by Mario Carneiro, 21-May-2014.)
theorem pcbc {k: setvar} (P K N: class):
  $ wi (w3a (wcel N cn) (wcel K (co cc0 N cfz)) (wcel P cprime)) (wceq (co P (co N K cbc) cpc) (csu k (co c1 N cfz) (co (cfv (co N (co P (cv k) cexp) cdiv) cfl) (co (cfv (co (co N K cmin) (co P (cv k) cexp) cdiv) cfl) (cfv (co K (co P (cv k) cexp) cdiv) cfl) caddc) cmin))) $;

--| If a power of a rational number is an integer, then the number is an integer. In other words, all n-th roots are irrational unless they are integers (so that the original number is an n-th power). (Contributed by Mario Carneiro, 10-Aug-2015.)
theorem qexpz (A2 N: class):
  $ wi (w3a (wcel A2 cq) (wcel N cn) (wcel (co A2 N cexp) cz)) (wcel A2 cz) $;

--| A second or higher power of a rational number is not a prime number. Or by contraposition, the n-th root of a prime number is irrational. Suggested by Norm Megill. (Contributed by Mario Carneiro, 10-Aug-2015.)
theorem expnprm (A2 N: class):
  $ wi (wa (wcel A2 cq) (wcel N (cfv c2 cuz))) (wn (wcel (co A2 N cexp) cprime)) $;

--| Every positive integer which is not a power of two is divisible by an odd prime number. (Contributed by AV, 6-Aug-2021.)
theorem oddprmdvds {n p: setvar} (K: class):
  $ wi (wa (wcel K cn) (wn (wrex n (wceq K (co c2 (cv n) cexp)) cn0))) (wrex p (wbr (cv p) K cdvds) (cdif cprime (csn c2))) $;

--| A relation involving divisibility by a prime power. (Contributed by Mario Carneiro, 2-Mar-2014.)
theorem prmpwdvds (D P K N: class):
  $ wi (w3a (wa (wcel K cz) (wcel D cz)) (wa (wcel P cprime) (wcel N cn)) (wa (wbr D (co K (co P N cexp) cmul) cdvds) (wn (wbr D (co K (co P (co N c1 cmin) cexp) cmul) cdvds)))) (wbr (co P N cexp) D cdvds) $;

--| Lemma for ~ pockthg . (Contributed by Mario Carneiro, 2-Mar-2014.)
theorem pockthlem (ph: wff) (A2 B2 C P Q N: class):
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wbr B2 A2 clt) $ >
  $ wi ph (wceq N (co (co A2 B2 cmul) c1 caddc)) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wbr P N cdvds) $ >
  $ wi ph (wcel Q cprime) $ >
  $ wi ph (wcel (co Q A2 cpc) cn) $ >
  $ wi ph (wcel C cz) $ >
  $ wi ph (wceq (co (co C (co N c1 cmin) cexp) N cmo) c1) $ >
  $ wi ph (wceq (co (co (co C (co (co N c1 cmin) Q cdiv) cexp) c1 cmin) N cgcd) c1) $ >
  $ wi ph (wbr (co Q A2 cpc) (co Q (co P c1 cmin) cpc) cle) $;

--| The generalized Pocklington's theorem. If ` N - 1 = A x. B ` where ` B < A ` , then ` N ` is prime if and only if for every prime factor ` p ` of ` A ` , there is an ` x ` such that ` x ^ ( N - 1 ) = 1 ( mod N ) ` and ` gcd ( x ^ ( ( N - 1 ) / p ) - 1 , N ) = 1 ` . (Contributed by Mario Carneiro, 2-Mar-2014.)
theorem pockthg {x3 p: setvar} (ph: wff) (A2: class) (B2: class x3 p) (N: class):
  $ wi ph (wcel A2 cn) $ >
  $ wi ph (wcel B2 cn) $ >
  $ wi ph (wbr B2 A2 clt) $ >
  $ wi ph (wceq N (co (co A2 B2 cmul) c1 caddc)) $ >
  $ wi ph (wral p (wi (wbr (cv p) A2 cdvds) (wrex x3 (wa (wceq (co (co (cv x3) (co N c1 cmin) cexp) N cmo) c1) (wceq (co (co (co (cv x3) (co (co N c1 cmin) (cv p) cdiv) cexp) c1 cmin) N cgcd) c1)) cz)) cprime) $ >
  $ wi ph (wcel N cprime) $;

--| Pocklington's theorem, which gives a sufficient criterion for a number ` N ` to be prime. This is the preferred method for verifying large primes, being much more efficient to compute than trial division. This form has been optimized for application to specific large primes; see ~ pockthg for a more general closed-form version. (Contributed by Mario Carneiro, 2-Mar-2014.)
theorem pockthi (A2 D P E G M N: class):
  $ wcel P cprime $ >
  $ wcel G cn $ >
  $ wceq M (co G P cmul) $ >
  $ wceq N (co M c1 caddc) $ >
  $ wcel D cn $ >
  $ wcel E cn $ >
  $ wcel A2 cn $ >
  $ wceq M (co D (co P E cexp) cmul) $ >
  $ wbr D (co P E cexp) clt $ >
  $ wceq (co (co A2 M cexp) N cmo) (co c1 N cmo) $ >
  $ wceq (co (co (co A2 G cexp) c1 cmin) N cgcd) c1 $ >
  $ wcel N cprime $;

--| Lemma for ~ unben . (Contributed by NM, 5-May-2005.) (Revised by Mario Carneiro, 15-Sep-2013.)
theorem unbenlem {x3 m n: setvar} (A2 G: class x3):
  $ wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1 caddc)) c1) com) $ >
  $ wi (wa (wss A2 cn) (wral m (wrex n (wbr (cv m) (cv n) clt) A2) cn)) (wbr A2 com cen) $;

--| An unbounded set of positive integers is infinite. (Contributed by NM, 5-May-2005.) (Revised by Mario Carneiro, 15-Sep-2013.)
theorem unben {m n: setvar} (A2: class):
  $ wi (wa (wss A2 cn) (wral m (wrex n (wbr (cv m) (cv n) clt) A2) cn)) (wbr A2 cn cen) $;

--| Lemma for ~ infpn . The smallest divisor (greater than 1) ` M ` of ` N ! + 1 ` is a prime greater than ` N ` . (Contributed by NM, 5-May-2005.)
theorem infpnlem1 {j: setvar} (K M N: class):
  $ wceq K (co (cfv N cfa) c1 caddc) $ >
  $ wi (wa (wcel N cn) (wcel M cn)) (wi (wa (wa (wbr c1 M clt) (wcel (co K M cdiv) cn)) (wral j (wi (wa (wbr c1 (cv j) clt) (wcel (co K (cv j) cdiv) cn)) (wbr M (cv j) cle)) cn)) (wa (wbr N M clt) (wral j (wi (wcel (co M (cv j) cdiv) cn) (wo (wceq (cv j) c1) (wceq (cv j) M))) cn))) $;

--| Lemma for ~ infpn . For any positive integer ` N ` , there exists a prime number ` j ` greater than ` N ` . (Contributed by NM, 5-May-2005.)
theorem infpnlem2 {j k: setvar} (K N: class):
  $ wceq K (co (cfv N cfa) c1 caddc) $ >
  $ wi (wcel N cn) (wrex j (wa (wbr N (cv j) clt) (wral k (wi (wcel (co (cv j) (cv k) cdiv) cn) (wo (wceq (cv k) c1) (wceq (cv k) (cv j)))) cn)) cn) $;

--| There exist infinitely many prime numbers: for any positive integer ` N ` , there exists a prime number ` j ` greater than ` N ` . (See ~ infpn2 for the equinumerosity version.) (Contributed by NM, 1-Jun-2006.)
theorem infpn {j k: setvar} (N: class):
  $ wi (wcel N cn) (wrex j (wa (wbr N (cv j) clt) (wral k (wi (wcel (co (cv j) (cv k) cdiv) cn) (wo (wceq (cv k) c1) (wceq (cv k) (cv j)))) cn)) cn) $;

--| There exist infinitely many prime numbers: the set of all primes ` S ` is unbounded by ~ infpn , so by ~ unben it is infinite. This is Metamath 100 proof #11. (Contributed by NM, 5-May-2005.)
theorem infpn2 {m n: setvar} (S: class m n):
  $ wceq S (crab n (wa (wbr c1 (cv n) clt) (wral m (wi (wcel (co (cv n) (cv m) cdiv) cn) (wo (wceq (cv m) c1) (wceq (cv m) (cv n)))) cn)) cn) $ >
  $ wbr S cn cen $;

--| The primes are unbounded. (Contributed by Paul Chapman, 28-Nov-2012.)
theorem prmunb {p: setvar} (N: class):
  $ wi (wcel N cn) (wrex p (wbr N (cv p) clt) cprime) $;

--| There are an infinite number of primes. Theorem 1.7 in [ApostolNT] p. 16. (Contributed by Paul Chapman, 28-Nov-2012.)
theorem prminf:
  $ wbr cprime cn cen $;

--| Lemma for ~ prmrec . Properties of the "square part" function, which extracts the ` m ` of the decomposition ` N = r m ^ 2 ` , with ` m ` maximal and ` r ` squarefree. (Contributed by Mario Carneiro, 5-Aug-2014.)
theorem prmreclem1 {n r: setvar} (Q K: class n) (N: class):
  $ wceq Q (cmpt n cn (csup (crab r (wbr (co (cv r) c2 cexp) (cv n) cdvds) cn) cr clt)) $ >
  $ wi (wcel N cn) (w3a (wcel (cfv N Q) cn) (wbr (co (cfv N Q) c2 cexp) N cdvds) (wi (wcel K (cfv c2 cuz)) (wn (wbr (co K c2 cexp) (co N (co (cfv N Q) c2 cexp) cdiv) cdvds)))) $;

--| Lemma for ~ prmrec . There are at most ` 2 ^ K ` squarefree numbers which divide no primes larger than ` K ` . (We could strengthen this to ` 2 ^ # ( Prime i^i ( 1 ... K ) ) ` but there's no reason to.) We establish the inequality by showing that the prime counts of the number up to ` K ` completely determine it because all higher prime counts are zero, and they are all at most ` 1 ` because no square divides the number, so there are at most ` 2 ^ K ` possibilities. (Contributed by Mario Carneiro, 5-Aug-2014.) (Proof shortened by Timothy J. O'Malley, 9-Oct-2026.)
theorem prmreclem2 {x3 n r p: setvar} (ph: wff r) (Q F: class) (K M N: class r):
  $ wceq F (cmpt n cn (cif (wcel (cv n) cprime) (co c1 (cv n) cdiv) cc0)) $ >
  $ wi ph (wcel K cn) $ >
  $ wi ph (wcel N cn) $ >
  $ wceq M (crab n (wral p (wn (wbr (cv p) (cv n) cdvds)) (cdif cprime (co c1 K cfz))) (co c1 N cfz)) $ >
  $ wceq Q (cmpt n cn (csup (crab r (wbr (co (cv r) c2 cexp) (cv n) cdvds) cn) cr clt)) $ >
  $ wi ph (wbr (cfv (crab x3 (wceq (cfv (cv x3) Q) c1) M) chash) (co c2 K cexp) cle) $;

--| Lemma for ~ prmrec . The main inequality established here is ` # M <_ # { x e. M | ( Q `` x ) = 1 } x. sqrt N ` , where ` { x e. M | ( Q `` x ) = 1 } ` is the set of squarefree numbers in ` M ` . This is demonstrated by the map ` y |-> <. y / ( Q `` y ) ^ 2 , ( Q `` y ) >. ` where ` Q `` y ` is the largest number whose square divides ` y ` . (Contributed by Mario Carneiro, 5-Aug-2014.)
theorem prmreclem3 {n r p: setvar} (ph: wff r) (Q F: class) (K M N: class r):
  $ wceq F (cmpt n cn (cif (wcel (cv n) cprime) (co c1 (cv n) cdiv) cc0)) $ >
  $ wi ph (wcel K cn) $ >
  $ wi ph (wcel N cn) $ >
  $ wceq M (crab n (wral p (wn (wbr (cv p) (cv n) cdvds)) (cdif cprime (co c1 K cfz))) (co c1 N cfz)) $ >
  $ wceq Q (cmpt n cn (csup (crab r (wbr (co (cv r) c2 cexp) (cv n) cdvds) cn) cr clt)) $ >
  $ wi ph (wbr (cfv M chash) (co (co c2 K cexp) (cfv N csqrt) cmul) cle) $;

--| Lemma for ~ prmrec . Show by induction that the indexed (nondisjoint) union ` W `` k ` is at most the size of the prime reciprocal series. The key counting lemma is ~ hashdvds , to show that the number of numbers in ` 1 ... N ` that divide ` k ` is at most ` N / k ` . (Contributed by Mario Carneiro, 6-Aug-2014.)
theorem prmreclem4 {k n p: setvar} (ph: wff) (F K M N: class) (W: class n p):
  $ wceq F (cmpt n cn (cif (wcel (cv n) cprime) (co c1 (cv n) cdiv) cc0)) $ >
  $ wi ph (wcel K cn) $ >
  $ wi ph (wcel N cn) $ >
  $ wceq M (crab n (wral p (wn (wbr (cv p) (cv n) cdvds)) (cdif cprime (co c1 K cfz))) (co c1 N cfz)) $ >
  $ wi ph (wcel (cseq caddc F c1) (cdm cli)) $ >
  $ wi ph (wbr (csu k (cfv (co K c1 caddc) cuz) (cif (wcel (cv k) cprime) (co c1 (cv k) cdiv) cc0)) (co c1 c2 cdiv) clt) $ >
  $ wceq W (cmpt p cn (crab n (wa (wcel (cv p) cprime) (wbr (cv p) (cv n) cdvds)) (co c1 N cfz))) $ >
  $ wi ph (wi (wcel N (cfv K cuz)) (wbr (cfv (ciun k (co (co K c1 caddc) N cfz) (cfv (cv k) W)) chash) (co N (csu k (co (co K c1 caddc) N cfz) (cif (wcel (cv k) cprime) (co c1 (cv k) cdiv) cc0)) cmul) cle)) $;

--| Lemma for ~ prmrec . Here we show the inequality ` N / 2 < # M ` by decomposing the set ` ( 1 ... N ) ` into the disjoint union of the set ` M ` of those numbers that are not divisible by any "large" primes (above ` K ` ) and the indexed union over ` K < k ` of the numbers ` W `` k ` that divide the prime ` k ` . By ~ prmreclem4 the second of these has size less than ` N ` times the prime reciprocal series, which is less than ` 1 / 2 ` by assumption, we find that the complementary part ` M ` must be at least ` N / 2 ` large. (Contributed by Mario Carneiro, 6-Aug-2014.)
theorem prmreclem5 {k n p: setvar} (ph: wff) (F K M N: class) (W: class n p):
  $ wceq F (cmpt n cn (cif (wcel (cv n) cprime) (co c1 (cv n) cdiv) cc0)) $ >
  $ wi ph (wcel K cn) $ >
  $ wi ph (wcel N cn) $ >
  $ wceq M (crab n (wral p (wn (wbr (cv p) (cv n) cdvds)) (cdif cprime (co c1 K cfz))) (co c1 N cfz)) $ >
  $ wi ph (wcel (cseq caddc F c1) (cdm cli)) $ >
  $ wi ph (wbr (csu k (cfv (co K c1 caddc) cuz) (cif (wcel (cv k) cprime) (co c1 (cv k) cdiv) cc0)) (co c1 c2 cdiv) clt) $ >
  $ wceq W (cmpt p cn (crab n (wa (wcel (cv p) cprime) (wbr (cv p) (cv n) cdvds)) (co c1 N cfz))) $ >
  $ wi ph (wbr (co N c2 cdiv) (co (co c2 K cexp) (cfv N csqrt) cmul) clt) $;

--| Lemma for ~ prmrec . If the series ` F ` was convergent, there would be some ` k ` such that the sum starting from ` k + 1 ` sums to less than ` 1 / 2 ` ; this is a sufficient hypothesis for ~ prmreclem5 to produce the contradictory bound ` N / 2 < ( 2 ^ k ) sqrt N ` , which is false for ` N = 2 ^ ( 2 k + 2 ) ` . (Contributed by Mario Carneiro, 6-Aug-2014.)
theorem prmreclem6 {n: setvar} (F: class):
  $ wceq F (cmpt n cn (cif (wcel (cv n) cprime) (co c1 (cv n) cdiv) cc0)) $ >
  $ wn (wcel (cseq caddc F c1) (cdm cli)) $;

--| The sum of the reciprocals of the primes diverges. Theorem 1.13 in [ApostolNT] p. 18. This is the "second" proof at ~ http://en.wikipedia.org/wiki/Prime_harmonic_series , attributed to Paul Erd&#337;s. This is Metamath 100 proof #81. (Contributed by Mario Carneiro, 6-Aug-2014.)
theorem prmrec {k n: setvar} (F: class k n):
  $ wceq F (cmpt n cn (csu k (cin cprime (co c1 (cv n) cfz)) (co c1 (cv k) cdiv))) $ >
  $ wn (wcel F (cdm cli)) $;

--| Lemma for ~ 1arith . (Contributed by Mario Carneiro, 30-May-2014.)
theorem _1arithlem1 {n p: setvar} (M: class n p) (N: class):
  $ wceq M (cmpt n cn (cmpt p cprime (co (cv p) (cv n) cpc))) $ >
  $ wi (wcel N cn) (wceq (cfv N M) (cmpt p cprime (co (cv p) N cpc))) $;

--| Lemma for ~ 1arith . (Contributed by Mario Carneiro, 30-May-2014.)
theorem _1arithlem2 {n p: setvar} (P: class n) (M: class n p) (N: class):
  $ wceq M (cmpt n cn (cmpt p cprime (co (cv p) (cv n) cpc))) $ >
  $ wi (wa (wcel N cn) (wcel P cprime)) (wceq (cfv P (cfv N M)) (co P N cpc)) $;

--| Lemma for ~ 1arith . (Contributed by Mario Carneiro, 30-May-2014.)
theorem _1arithlem3 {n p: setvar} (M: class n p) (N: class):
  $ wceq M (cmpt n cn (cmpt p cprime (co (cv p) (cv n) cpc))) $ >
  $ wi (wcel N cn) (wf cprime cn0 (cfv N M)) $;

--| Lemma for ~ 1arith . (Contributed by Mario Carneiro, 30-May-2014.)
theorem _1arithlem4 {x3 y1 n q p: setvar} (ph: wff x3 n p) (F: class n p) (G: class y1) (M: class n p) (N: class y1):
  $ wceq M (cmpt n cn (cmpt p cprime (co (cv p) (cv n) cpc))) $ >
  $ wceq G (cmpt y1 cn (cif (wcel (cv y1) cprime) (co (cv y1) (cfv (cv y1) F) cexp) c1)) $ >
  $ wi ph (wf cprime cn0 F) $ >
  $ wi ph (wcel N cn) $ >
  $ wi (wa ph (wa (wcel (cv q) cprime) (wbr N (cv q) cle))) (wceq (cfv (cv q) F) cc0) $ >
  $ wi ph (wrex x3 (wceq F (cfv (cv x3) M)) cn) $;

--| Fundamental theorem of arithmetic, where a prime factorization is represented as a sequence of prime exponents, for which only finitely many primes have nonzero exponent. The function ` M ` maps the set of positive integers one-to-one onto the set of prime factorizations ` R ` . (Contributed by Paul Chapman, 17-Nov-2012.) (Proof shortened by Mario Carneiro, 30-May-2014.)
theorem _1arith {e n p: setvar} (R: class e p) (M: class n p):
  $ wceq M (cmpt n cn (cmpt p cprime (co (cv p) (cv n) cpc))) $ >
  $ wceq R (crab e (wcel (cima (ccnv (cv e)) cn) cfn) (co cn0 cprime cmap)) $ >
  $ wf1o cn R M $;

--| Fundamental theorem of arithmetic, where a prime factorization is represented as a finite monotonic 1-based sequence of primes. Every positive integer has a unique prime factorization. Theorem 1.10 in [ApostolNT] p. 17. This is Metamath 100 proof #80. (Contributed by Paul Chapman, 17-Nov-2012.) (Revised by Mario Carneiro, 30-May-2014.)
theorem _1arith2 {z e g2 n p: setvar} (R: class z e p) (M: class z n p):
  $ wceq M (cmpt n cn (cmpt p cprime (co (cv p) (cv n) cpc))) $ >
  $ wceq R (crab e (wcel (cima (ccnv (cv e)) cn) cfn) (co cn0 cprime cmap)) $ >
  $ wral z (wreu g2 (wceq (cfv (cv z) M) (cv g2)) R) cn $;

--| Extend class notation with the set of gaussian integers.
term cgz: class;

--| Define the set of gaussian integers, which are complex numbers whose real and imaginary parts are integers. (Note that the ` [ _i ] ` is actually part of the symbol token and has no independent meaning.) (Contributed by Mario Carneiro, 14-Jul-2014.)
axiom df_gz {x3: setvar}:
  $ wceq cgz (crab x3 (wa (wcel (cfv (cv x3) cre) cz) (wcel (cfv (cv x3) cim) cz)) cc) $;

--| Elementhood in the gaussian integers. (Contributed by Mario Carneiro, 14-Jul-2014.)
theorem elgz (A2: class):
  $ wb (wcel A2 cgz) (w3a (wcel A2 cc) (wcel (cfv A2 cre) cz) (wcel (cfv A2 cim) cz)) $;

--| A gaussian integer is a complex number. (Contributed by Mario Carneiro, 14-Jul-2014.)
theorem gzcn (A2: class):
  $ wi (wcel A2 cgz) (wcel A2 cc) $;

--| An integer is a gaussian integer. (Contributed by Mario Carneiro, 14-Jul-2014.)
theorem zgz (A2: class):
  $ wi (wcel A2 cz) (wcel A2 cgz) $;

--| ` _i ` is a gaussian integer. (Contributed by Mario Carneiro, 14-Jul-2014.)
theorem igz:
  $ wcel ci cgz $;

--| The gaussian integers are closed under negation. (Contributed by Mario Carneiro, 14-Jul-2014.)
theorem gznegcl (A2: class):
  $ wi (wcel A2 cgz) (wcel (cneg A2) cgz) $;

--| The gaussian integers are closed under conjugation. (Contributed by Mario Carneiro, 14-Jul-2014.)
theorem gzcjcl (A2: class):
  $ wi (wcel A2 cgz) (wcel (cfv A2 ccj) cgz) $;

--| The gaussian integers are closed under addition. (Contributed by Mario Carneiro, 14-Jul-2014.)
theorem gzaddcl (A2 B2: class):
  $ wi (wa (wcel A2 cgz) (wcel B2 cgz)) (wcel (co A2 B2 caddc) cgz) $;

--| The gaussian integers are closed under multiplication. (Contributed by Mario Carneiro, 14-Jul-2014.)
theorem gzmulcl (A2 B2: class):
  $ wi (wa (wcel A2 cgz) (wcel B2 cgz)) (wcel (co A2 B2 cmul) cgz) $;

--| Construct a gaussian integer from real and imaginary parts. (Contributed by Mario Carneiro, 16-Jul-2014.)
theorem gzreim (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cz)) (wcel (co A2 (co ci B2 cmul) caddc) cgz) $;

--| The gaussian integers are closed under subtraction. (Contributed by Mario Carneiro, 14-Jul-2014.)
theorem gzsubcl (A2 B2: class):
  $ wi (wa (wcel A2 cgz) (wcel B2 cgz)) (wcel (co A2 B2 cmin) cgz) $;

--| The squared norm of a gaussian integer is an integer. (Contributed by Mario Carneiro, 16-Jul-2014.)
theorem gzabssqcl (A2: class):
  $ wi (wcel A2 cgz) (wcel (co (cfv A2 cabs) c2 cexp) cn0) $;

--| Lemma for ~ 4sq . (Contributed by Mario Carneiro, 15-Jul-2014.)
theorem _4sqlem5 (ph: wff) (A2 B2 M: class):
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wcel M cn) $ >
  $ wceq B2 (co (co (co A2 (co M c2 cdiv) caddc) M cmo) (co M c2 cdiv) cmin) $ >
  $ wi ph (wa (wcel B2 cz) (wcel (co (co A2 B2 cmin) M cdiv) cz)) $;

--| Lemma for ~ 4sq . (Contributed by Mario Carneiro, 15-Jul-2014.)
theorem _4sqlem6 (ph: wff) (A2 B2 M: class):
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wcel M cn) $ >
  $ wceq B2 (co (co (co A2 (co M c2 cdiv) caddc) M cmo) (co M c2 cdiv) cmin) $ >
  $ wi ph (wa (wbr (cneg (co M c2 cdiv)) B2 cle) (wbr B2 (co M c2 cdiv) clt)) $;

--| Lemma for ~ 4sq . (Contributed by Mario Carneiro, 15-Jul-2014.)
theorem _4sqlem7 (ph: wff) (A2 B2 M: class):
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wcel M cn) $ >
  $ wceq B2 (co (co (co A2 (co M c2 cdiv) caddc) M cmo) (co M c2 cdiv) cmin) $ >
  $ wi ph (wbr (co B2 c2 cexp) (co (co (co M c2 cexp) c2 cdiv) c2 cdiv) cle) $;

--| Lemma for ~ 4sq . (Contributed by Mario Carneiro, 15-Jul-2014.)
theorem _4sqlem8 (ph: wff) (A2 B2 M: class):
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wcel M cn) $ >
  $ wceq B2 (co (co (co A2 (co M c2 cdiv) caddc) M cmo) (co M c2 cdiv) cmin) $ >
  $ wi ph (wbr M (co (co A2 c2 cexp) (co B2 c2 cexp) cmin) cdvds) $;

--| Lemma for ~ 4sq . (Contributed by Mario Carneiro, 15-Jul-2014.)
theorem _4sqlem9 (ph ps: wff) (A2 B2 M: class):
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wcel M cn) $ >
  $ wceq B2 (co (co (co A2 (co M c2 cdiv) caddc) M cmo) (co M c2 cdiv) cmin) $ >
  $ wi (wa ph ps) (wceq (co B2 c2 cexp) cc0) $ >
  $ wi (wa ph ps) (wbr (co M c2 cexp) (co A2 c2 cexp) cdvds) $;

--| Lemma for ~ 4sq . (Contributed by Mario Carneiro, 16-Jul-2014.)
theorem _4sqlem10 (ph ps: wff) (A2 B2 M: class):
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wcel M cn) $ >
  $ wceq B2 (co (co (co A2 (co M c2 cdiv) caddc) M cmo) (co M c2 cdiv) cmin) $ >
  $ wi (wa ph ps) (wceq (co (co (co (co M c2 cexp) c2 cdiv) c2 cdiv) (co B2 c2 cexp) cmin) cc0) $ >
  $ wi (wa ph ps) (wbr (co M c2 cexp) (co (co A2 c2 cexp) (co (co (co M c2 cexp) c2 cdiv) c2 cdiv) cmin) cdvds) $;

--| Lemma for ~ 4sq . The set ` S ` is the set of all numbers that are expressible as a sum of four squares. Our goal is to show that ` S = NN0 ` ; here we show one subset direction. (Contributed by Mario Carneiro, 14-Jul-2014.)
theorem _4sqlem1 {x3 y1 z w n: setvar} (S: class x3 y1 z w):
  $ wceq S (cab n (wrex x3 (wrex y1 (wrex z (wrex w (wceq (cv n) (co (co (co (cv x3) c2 cexp) (co (cv y1) c2 cexp) caddc) (co (co (cv z) c2 cexp) (co (cv w) c2 cexp) caddc) caddc)) cz) cz) cz) cz)) $ >
  $ wss S cn0 $;

--| Lemma for ~ 4sq . Change bound variables in ` S ` . (Contributed by Mario Carneiro, 14-Jul-2014.)
theorem _4sqlem2 {x3 y1 z w n a b c d: setvar} (A2 S: class x3 y1 z w):
  $ wceq S (cab n (wrex x3 (wrex y1 (wrex z (wrex w (wceq (cv n) (co (co (co (cv x3) c2 cexp) (co (cv y1) c2 cexp) caddc) (co (co (cv z) c2 cexp) (co (cv w) c2 cexp) caddc) caddc)) cz) cz) cz) cz)) $ >
  $ wb (wcel A2 S) (wrex a (wrex b (wrex c (wrex d (wceq A2 (co (co (co (cv a) c2 cexp) (co (cv b) c2 cexp) caddc) (co (co (cv c) c2 cexp) (co (cv d) c2 cexp) caddc) caddc)) cz) cz) cz) cz) $;

--| Lemma for ~ 4sq . Sufficient condition to be in ` S ` . (Contributed by Mario Carneiro, 14-Jul-2014.)
theorem _4sqlem3 {x3 y1 z w n: setvar} (A2 B2 C D S: class x3 y1 z w):
  $ wceq S (cab n (wrex x3 (wrex y1 (wrex z (wrex w (wceq (cv n) (co (co (co (cv x3) c2 cexp) (co (cv y1) c2 cexp) caddc) (co (co (cv z) c2 cexp) (co (cv w) c2 cexp) caddc) caddc)) cz) cz) cz) cz)) $ >
  $ wi (wa (wa (wcel A2 cz) (wcel B2 cz)) (wa (wcel C cz) (wcel D cz))) (wcel (co (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co (co C c2 cexp) (co D c2 cexp) caddc) caddc) S) $;

--| Lemma for ~ 4sqlem4 . (Contributed by Mario Carneiro, 14-Jul-2014.)
theorem _4sqlem4a {x3 y1 z w n: setvar} (A2 B2 S: class x3 y1 z w):
  $ wceq S (cab n (wrex x3 (wrex y1 (wrex z (wrex w (wceq (cv n) (co (co (co (cv x3) c2 cexp) (co (cv y1) c2 cexp) caddc) (co (co (cv z) c2 cexp) (co (cv w) c2 cexp) caddc) caddc)) cz) cz) cz) cz)) $ >
  $ wi (wa (wcel A2 cgz) (wcel B2 cgz)) (wcel (co (co (cfv A2 cabs) c2 cexp) (co (cfv B2 cabs) c2 cexp) caddc) S) $;

--| Lemma for ~ 4sq . We can express the four-square property more compactly in terms of gaussian integers, because the norms of gaussian integers are exactly sums of two squares. (Contributed by Mario Carneiro, 14-Jul-2014.)
theorem _4sqlem4 {x3 y1 z w v u n: setvar} (A2 S: class x3 y1 z w):
  $ wceq S (cab n (wrex x3 (wrex y1 (wrex z (wrex w (wceq (cv n) (co (co (co (cv x3) c2 cexp) (co (cv y1) c2 cexp) caddc) (co (co (cv z) c2 cexp) (co (cv w) c2 cexp) caddc) caddc)) cz) cz) cz) cz)) $ >
  $ wb (wcel A2 S) (wrex u (wrex v (wceq A2 (co (co (cfv (cv u) cabs) c2 cexp) (co (cfv (cv v) cabs) c2 cexp) caddc)) cgz) cgz) $;

--| Lemma for ~ mul4sq : algebraic manipulations. The extra assumptions involving ` M ` are for a part of ~ 4sqlem17 which needs to know not just that the product is a sum of squares, but also that it preserves divisibility by ` M ` . (Contributed by Mario Carneiro, 14-Jul-2014.)
theorem mul4sqlem {x3 y1 z w n: setvar} (ph: wff x3 y1 z w) (A2 B2 C D S M: class x3 y1 z w) (X Y: class x3 y1 z w n):
  $ wceq S (cab n (wrex x3 (wrex y1 (wrex z (wrex w (wceq (cv n) (co (co (co (cv x3) c2 cexp) (co (cv y1) c2 cexp) caddc) (co (co (cv z) c2 cexp) (co (cv w) c2 cexp) caddc) caddc)) cz) cz) cz) cz)) $ >
  $ wi ph (wcel A2 cgz) $ >
  $ wi ph (wcel B2 cgz) $ >
  $ wi ph (wcel C cgz) $ >
  $ wi ph (wcel D cgz) $ >
  $ wceq X (co (co (cfv A2 cabs) c2 cexp) (co (cfv B2 cabs) c2 cexp) caddc) $ >
  $ wceq Y (co (co (cfv C cabs) c2 cexp) (co (cfv D cabs) c2 cexp) caddc) $ >
  $ wi ph (wcel M cn) $ >
  $ wi ph (wcel (co (co A2 C cmin) M cdiv) cgz) $ >
  $ wi ph (wcel (co (co B2 D cmin) M cdiv) cgz) $ >
  $ wi ph (wcel (co X M cdiv) cn0) $ >
  $ wi ph (wcel (co (co X M cdiv) (co Y M cdiv) cmul) S) $;

--| Euler's four-square identity: The product of two sums of four squares is also a sum of four squares. This is usually quoted as an explicit formula involving eight real variables; we save some time by working with complex numbers (gaussian integers) instead, so that we only have to work with four variables, and also hiding the actual formula for the product in the proof of ~ mul4sqlem . (For the curious, the explicit formula that is used is ` ( | a | ^ 2 + | b | ^ 2 ) ( | c | ^ 2 + | d | ^ 2 ) = ` ` | a * x. c + b x. d * | ^ 2 + | a * x. d - b x. c * | ^ 2 ` .) (Contributed by Mario Carneiro, 14-Jul-2014.)
theorem mul4sq {x3 y1 z w n: setvar} (A2 B2 S: class x3 y1 z w):
  $ wceq S (cab n (wrex x3 (wrex y1 (wrex z (wrex w (wceq (cv n) (co (co (co (cv x3) c2 cexp) (co (cv y1) c2 cexp) caddc) (co (co (cv z) c2 cexp) (co (cv w) c2 cexp) caddc) caddc)) cz) cz) cz) cz)) $ >
  $ wi (wa (wcel A2 S) (wcel B2 S)) (wcel (co A2 B2 cmul) S) $;

--| Lemma for ~ 4sq . Use the pigeonhole principle to show that the sets ` { m ^ 2 | m e. ( 0 ... N ) } ` and ` { -u 1 - n ^ 2 | n e. ( 0 ... N ) } ` have a common element, ` mod P ` . (Contributed by Mario Carneiro, 15-Jul-2014.)
theorem _4sqlem11 {x3 y1 z w v u m n: setvar} (ph: wff x3 y1 z w) (A2: class x3 y1 z w u m) (P S: class x3 y1 z w) (F: class x3 y1 z w v u m) (N: class x3 y1 z w):
  $ wceq S (cab n (wrex x3 (wrex y1 (wrex z (wrex w (wceq (cv n) (co (co (co (cv x3) c2 cexp) (co (cv y1) c2 cexp) caddc) (co (co (cv z) c2 cexp) (co (cv w) c2 cexp) caddc) caddc)) cz) cz) cz) cz)) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wceq P (co (co c2 N cmul) c1 caddc)) $ >
  $ wi ph (wcel P cprime) $ >
  $ wceq A2 (cab u (wrex m (wceq (cv u) (co (co (cv m) c2 cexp) P cmo)) (co cc0 N cfz))) $ >
  $ wceq F (cmpt v A2 (co (co P c1 cmin) (cv v) cmin)) $ >
  $ wi ph (wne (cin A2 (crn F)) c0) $;

--| Lemma for ~ 4sq . For any odd prime ` P ` , there is a ` k < P ` such that ` k P - 1 ` is a sum of two squares. (Contributed by Mario Carneiro, 15-Jul-2014.)
theorem _4sqlem12 {x3 y1 z w v u k m n: setvar} (ph: wff x3 y1 z w) (A2: class x3 y1 z w u m) (P S: class x3 y1 z w) (F: class x3 y1 z w v u k m) (N: class x3 y1 z w):
  $ wceq S (cab n (wrex x3 (wrex y1 (wrex z (wrex w (wceq (cv n) (co (co (co (cv x3) c2 cexp) (co (cv y1) c2 cexp) caddc) (co (co (cv z) c2 cexp) (co (cv w) c2 cexp) caddc) caddc)) cz) cz) cz) cz)) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wceq P (co (co c2 N cmul) c1 caddc)) $ >
  $ wi ph (wcel P cprime) $ >
  $ wceq A2 (cab u (wrex m (wceq (cv u) (co (co (cv m) c2 cexp) P cmo)) (co cc0 N cfz))) $ >
  $ wceq F (cmpt v A2 (co (co P c1 cmin) (cv v) cmin)) $ >
  $ wi ph (wrex k (wrex u (wceq (co (co (cfv (cv u) cabs) c2 cexp) c1 caddc) (co (cv k) P cmul)) cgz) (co c1 (co P c1 cmin) cfz)) $;

--| Lemma for ~ 4sq . (Contributed by Mario Carneiro, 16-Jul-2014.) (Revised by AV, 14-Sep-2020.)
theorem _4sqlem13 {x3 y1 z w i n: setvar} (ph: wff x3 y1 z w i) (P S: class x3 y1 z w) (T: class x3 y1 z w i n) (M: class x3 y1 z w) (N: class x3 y1 z w i):
  $ wceq S (cab n (wrex x3 (wrex y1 (wrex z (wrex w (wceq (cv n) (co (co (co (cv x3) c2 cexp) (co (cv y1) c2 cexp) caddc) (co (co (cv z) c2 cexp) (co (cv w) c2 cexp) caddc) caddc)) cz) cz) cz) cz)) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wceq P (co (co c2 N cmul) c1 caddc)) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wss (co cc0 (co c2 N cmul) cfz) S) $ >
  $ wceq T (crab i (wcel (co (cv i) P cmul) S) cn) $ >
  $ wceq M (cinf T cr clt) $ >
  $ wi ph (wa (wne T c0) (wbr M P clt)) $;

--| Lemma for ~ 4sq . (Contributed by Mario Carneiro, 16-Jul-2014.) (Revised by AV, 14-Sep-2020.)
theorem _4sqlem14 {x3 y1 z w i n: setvar} (ph: wff x3 y1 z w i) (A2 B2 C D: class x3 y1 z w i) (P: class x3 y1 z w) (R: class x3 y1 z w n) (S: class x3 y1 z w) (T: class x3 y1 z w i n) (E F G H: class x3 y1 z w i) (M: class x3 y1 z w) (N: class x3 y1 z w i):
  $ wceq S (cab n (wrex x3 (wrex y1 (wrex z (wrex w (wceq (cv n) (co (co (co (cv x3) c2 cexp) (co (cv y1) c2 cexp) caddc) (co (co (cv z) c2 cexp) (co (cv w) c2 cexp) caddc) caddc)) cz) cz) cz) cz)) $ >
  $ wi ph (wcel N cn) $ >
  $ wi ph (wceq P (co (co c2 N cmul) c1 caddc)) $ >
  $ wi ph (wcel P cprime) $ >
  $ wi ph (wss (co cc0 (co c2 N cmul) cfz) S) $ >
  $ wceq T (crab i (wcel (co (cv i) P cmul) S) cn) $ >
  $ wceq M (cinf T cr clt) $ >
  $ wi ph (wcel M (cfv c2 cuz)) $ >
  $ wi ph (wcel A2 cz) $ >
  $ wi ph (wcel B2 cz) $ >
  $ wi ph (wcel C cz) $ >
  $ wi ph (wcel D cz) $ >
  $ wceq E (co (co (co A2 (co M c2 cdiv) caddc) M cmo) (co M c2 cdiv) cmin) $ >
  $ wceq F (co (co (co B2 (co M c2 cdiv) caddc) M cmo) (co M c2 cdiv) cmin) $ >
  $ wceq G (co (co (co C (co M c2 cdiv) caddc) M cmo) (co M c2 cdiv) cmin) $ >
  $ wceq H (co (co (co D (co M c2 cdiv) caddc) M cmo) (co M c2 cdiv) cmin) $ >
  $ wceq R (co (co (co (co E c2 cexp) (co F c2 cexp) caddc) (co (co G c2 cexp) (co H c2 cexp) caddc) caddc) M cdiv) $ >
  $ wi ph (wceq (co M P cmul) (co (co (co A2 c2 cexp) (co B2 c2 cexp) caddc) (co (co C c2 cexp) (co D c2 cexp) caddc) caddc)) $ >
  $ wi ph (wcel R cn0) $;

--| Lemma for ~ 4sq . (Contributed by Mario Carneiro, 16-Jul-2014.) (Revised by AV, 14-Sep-2020.)
theorem _4sqlem15 {x3 y1 z w i n: setvar} (ph: wff x3 y1 z w i) (A2 B2 C D: class x3 y1 z w i) (P: class x3 y1 z w) (R: class x3 y1 z w n) (S: class x3 y1 z w) (T: class x3 y1 z w i n) (E F G H: class x3 y1 z w i) (M: class x3 y1 z w) (N: class x3 y1 z w i):
  $ wceq S (cab n (wrex x3 (wrex y1 (wrex z (wrex w (wceq (cv n) (co (co (co (cv x3) c2 cexp) (co (cv y1) c2 cexp) caddc) (co (co (cv z) c2 cexp) (co (cv w) c2 cexp) caddc) caddc)) cz) cz) cz) cz)) $ >
  $ wi ph (wcel N cn) $ >

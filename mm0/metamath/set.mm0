  $ wceq E (co (co P Q c_or) (co D (co (co R T c_or) W c_an) c_or) c_an) $ >
  $ wi (w3a (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (w3a (wa (wcel R A2) (wn (wbr R W c_le))) (wa (wcel S A2) (wn (wbr S W c_le))) (wa (wcel T A2) (wn (wbr T W c_le)))) (w3a (wne P Q) (w3a (wbr R (co P Q c_or) c_le) (wn (wbr S (co P Q c_or) c_le)) (wn (wbr T (co P Q c_or) c_le))) (wn (wrex r (wa (wn (wbr (cv r) W c_le)) (wceq (co P (cv r) c_or) (co Q (cv r) c_or))) A2)))) (wceq G E) $;


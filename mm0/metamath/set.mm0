theorem dihord2pre {h: setvar} (A2 B2 P: class) (c_pl c_po Q R: class h) (T: class) (U E G: class h) (H: class) (I J c_or: class h) (K c_le: class) (c_an: class h) (N: class) (O: class h) (W: class) (X Y: class h):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wceq J (cfv W (cfv K cdic)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq O (cmpt h T (cres cid B2)) $ >
  $ wceq P (cfv W (cfv K coc)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq G (crio h (wceq (cfv P (cv h)) N) T) $ >
  $ wi (w3a (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel Q A2) (wn (wbr Q W c_le))) (wa (wcel N A2) (wn (wbr N W c_le)))) (wa (wcel X B2) (wcel Y B2)) (wss (co (cfv Q J) (cfv (co X W c_an) I) c_po) (co (cfv N J) (cfv (co Y W c_an) I) c_po))) (wbr (co X W c_an) (co Y W c_an) c_le) $;

--| Part of proof after Lemma N of [Crawley] p. 122. Reverse ordering property. (Contributed by NM, 4-Mar-2014.)
theorem dihord2pre2 {h: setvar} (A2 B2 P: class) (c_pl c_po Q R: class h) (T: class) (U E G: class h) (H: class) (I J c_or: class h) (K c_le: class) (c_an: class h) (N: class) (O: class h) (W: class) (X Y: class h):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wceq J (cfv W (cfv K cdic)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq O (cmpt h T (cres cid B2)) $ >
  $ wceq P (cfv W (cfv K coc)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq G (crio h (wceq (cfv P (cv h)) N) T) $ >
  $ wi (w3a (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel Q A2) (wn (wbr Q W c_le))) (wa (wcel N A2) (wn (wbr N W c_le)))) (wa (wcel X B2) (wcel Y B2)) (w3a (wceq (co Q (co X W c_an) c_or) X) (wceq (co N (co Y W c_an) c_or) Y) (wss (co (cfv Q J) (cfv (co X W c_an) I) c_po) (co (cfv N J) (cfv (co Y W c_an) I) c_po)))) (wbr (co Q (co X W c_an) c_or) (co N (co Y W c_an) c_or) c_le) $;

--| Part of proof after Lemma N of [Crawley] p. 122. Reverse ordering property. TODO: do we need ` -. X .<_ W ` and ` -. Y .<_ W ` ? (Contributed by NM, 4-Mar-2014.)
theorem dihord2 (A2 B2 c_po Q U H I J c_or K c_le c_an N W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wceq J (cfv W (cfv K cdic)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wi (w3a (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel Q A2) (wn (wbr Q W c_le))) (wa (wcel N A2) (wn (wbr N W c_le)))) (wa (wcel X B2) (wcel Y B2)) (w3a (wceq (co Q (co X W c_an) c_or) X) (wceq (co N (co Y W c_an) c_or) Y) (wss (co (cfv Q J) (cfv (co X W c_an) I) c_po) (co (cfv N J) (cfv (co Y W c_an) I) c_po)))) (wbr X Y c_le) $;

--| Extend class notation with isomorphism H.
term cdih: class;

--| Define isomorphism H. (Contributed by NM, 28-Jan-2014.)
axiom df_dih {x3 w u k q: setvar}:
  $ wceq cdih (cmpt k cvv (cmpt w (cfv (cv k) clh) (cmpt x3 (cfv (cv k) cbs) (cif (wbr (cv x3) (cv w) (cfv (cv k) cple)) (cfv (cv x3) (cfv (cv w) (cfv (cv k) cdib))) (crio u (wral q (wi (wa (wn (wbr (cv q) (cv w) (cfv (cv k) cple))) (wceq (co (cv q) (co (cv x3) (cv w) (cfv (cv k) cmee)) (cfv (cv k) cjn)) (cv x3))) (wceq (cv u) (co (cfv (cv q) (cfv (cv w) (cfv (cv k) cdic))) (cfv (co (cv x3) (cv w) (cfv (cv k) cmee)) (cfv (cv w) (cfv (cv k) cdib))) (cfv (cfv (cv w) (cfv (cv k) cdvh)) clsm)))) (cfv (cv k) catm)) (cfv (cfv (cv w) (cfv (cv k) cdvh)) clss)))))) $;

--| The isomorphism H for a lattice ` K ` . Definition of isomorphism map in [Crawley] p. 122 line 3. (Contributed by NM, 28-Jan-2014.)
theorem dihffval {x3 w u q: setvar} (A2: class x3 w u) (B2: class x3 w u q) (H: class x3 u q) (c_or: class x3 w u q) (K: class) (c_le c_an V: class x3 w u q):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wcel K V) (wceq (cfv K cdih) (cmpt w H (cmpt x3 B2 (cif (wbr (cv x3) (cv w) c_le) (cfv (cv x3) (cfv (cv w) (cfv K cdib))) (crio u (wral q (wi (wa (wn (wbr (cv q) (cv w) c_le)) (wceq (co (cv q) (co (cv x3) (cv w) c_an) c_or) (cv x3))) (wceq (cv u) (co (cfv (cv q) (cfv (cv w) (cfv K cdic))) (cfv (co (cv x3) (cv w) c_an) (cfv (cv w) (cfv K cdib))) (cfv (cfv (cv w) (cfv K cdvh)) clsm)))) A2) (cfv (cfv (cv w) (cfv K cdvh)) clss)))))) $;

--| Isomorphism H for a lattice ` K ` . Definition of isomorphism map in [Crawley] p. 122 line 3. (Contributed by NM, 28-Jan-2014.)
theorem dihfval {x3 u q: setvar} (A2: class x3 u) (B2: class u q) (C D c_po: class x3 u q) (S: class x3 q) (U H I c_or: class x3 u q) (K: class) (c_le c_an V: class x3 u q) (W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq D (cfv W (cfv K cdib)) $ >
  $ wceq C (cfv W (cfv K cdic)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wi (wa (wcel K V) (wcel W H)) (wceq I (cmpt x3 B2 (cif (wbr (cv x3) W c_le) (cfv (cv x3) D) (crio u (wral q (wi (wa (wn (wbr (cv q) W c_le)) (wceq (co (cv q) (co (cv x3) W c_an) c_or) (cv x3))) (wceq (cv u) (co (cfv (cv q) C) (cfv (co (cv x3) W c_an) D) c_po))) A2) S)))) $;

--| Value of isomorphism H for a lattice ` K ` . Definition of isomorphism map in [Crawley] p. 122 line 3. (Contributed by NM, 3-Feb-2014.)
theorem dihval {u q: setvar} (A2: class u) (B2 C D c_po: class u q) (S: class q) (U H I c_or: class u q) (K: class) (c_le c_an V: class u q) (W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq D (cfv W (cfv K cdib)) $ >
  $ wceq C (cfv W (cfv K cdic)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wcel X B2)) (wceq (cfv X I) (cif (wbr X W c_le) (cfv X D) (crio u (wral q (wi (wa (wn (wbr (cv q) W c_le)) (wceq (co (cv q) (co X W c_an) c_or) X)) (wceq (cv u) (co (cfv (cv q) C) (cfv (co X W c_an) D) c_po))) A2) S))) $;

--| Value of isomorphism H for a lattice ` K ` when ` -. X .<_ W ` . (Contributed by NM, 4-Mar-2014.)
theorem dihvalc {u q: setvar} (A2: class u) (B2 C D c_po: class u q) (S: class q) (U H I c_or: class u q) (K: class) (c_le c_an V: class u q) (W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq D (cfv W (cfv K cdib)) $ >
  $ wceq C (cfv W (cfv K cdic)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wa (wcel X B2) (wn (wbr X W c_le)))) (wceq (cfv X I) (crio u (wral q (wi (wa (wn (wbr (cv q) W c_le)) (wceq (co (cv q) (co X W c_an) c_or) X)) (wceq (cv u) (co (cfv (cv q) C) (cfv (co X W c_an) D) c_po))) A2) S)) $;

--| Closure of isomorphism H for a lattice ` K ` when ` -. X .<_ W ` . (Contributed by NM, 6-Mar-2014.)
theorem dihlsscpre (A2 B2 C D c_po S U H I c_or K c_le c_an W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq D (cfv W (cfv K cdib)) $ >
  $ wceq C (cfv W (cfv K cdic)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wn (wbr X W c_le)))) (wcel (cfv X I) S) $;

--| Value of isomorphism H for a lattice ` K ` when ` -. X .<_ W ` , given auxiliary atom ` Q ` . (Contributed by NM, 6-Mar-2014.)
theorem dihvalcqpre (A2 B2 C D c_po Q S U H I c_or K c_le c_an W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq D (cfv W (cfv K cdib)) $ >
  $ wceq C (cfv W (cfv K cdic)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wn (wbr X W c_le))) (wa (wa (wcel Q A2) (wn (wbr Q W c_le))) (wceq (co Q (co X W c_an) c_or) X))) (wceq (cfv X I) (co (cfv Q C) (cfv (co X W c_an) D) c_po)) $;

--| Value of isomorphism H for a lattice ` K ` when ` -. X .<_ W ` , given auxiliary atom ` Q ` . TODO: Use ~ dihvalcq2 (with ~ lhpmcvr3 for ` ( Q .\/ ( X ./\ W ) ) = X ` simplification) that changes ` C ` and ` D ` to ` I ` and make this obsolete. Do to other theorems as well. (Contributed by NM, 6-Mar-2014.)
theorem dihvalcq (A2 B2 C D c_po Q U H I c_or K c_le c_an W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq D (cfv W (cfv K cdib)) $ >
  $ wceq C (cfv W (cfv K cdic)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wn (wbr X W c_le))) (wa (wa (wcel Q A2) (wn (wbr Q W c_le))) (wceq (co Q (co X W c_an) c_or) X))) (wceq (cfv X I) (co (cfv Q C) (cfv (co X W c_an) D) c_po)) $;

--| Value of isomorphism H for a lattice ` K ` when ` X .<_ W ` . (Contributed by NM, 4-Mar-2014.)
theorem dihvalb (B2 D H I K c_le V W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq D (cfv W (cfv K cdib)) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wa (wcel X B2) (wbr X W c_le))) (wceq (cfv X I) (cfv X D)) $;

--| Ordered pair member of the partial isomorphism H for argument under ` W ` . (Contributed by NM, 21-Mar-2014.) (New usage is discouraged.)
theorem dihopelvalbN {g2: setvar} (B2 R S: class g2) (T: class) (F H I: class g2) (K: class) (c_le O V: class g2) (W: class) (X: class g2):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq O (cmpt g2 T (cres cid B2)) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi (wa (wa (wcel K V) (wcel W H)) (wa (wcel X B2) (wbr X W c_le))) (wb (wcel (cop F S) (cfv X I)) (wa (wa (wcel F T) (wbr (cfv F R) X c_le)) (wceq S O))) $;

--| Value of isomorphism H for a lattice ` K ` at an atom not under ` W ` . (Contributed by NM, 27-Mar-2014.)
theorem dihvalcqat (A2 Q H I J K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq J (cfv W (cfv K cdic)) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wceq (cfv Q I) (cfv Q J)) $;

--| Two expressions for a 1-dimensional subspace of vector space H (when ` F ` is a nonzero vector i.e. non-identity translation). (Contributed by NM, 27-Apr-2014.)
theorem dih1dimb {h: setvar} (B2: class) (R: class h) (T: class) (U F H I: class h) (K: class) (N O: class h) (W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq O (cmpt h T (cres cid B2)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq N (cfv U clspn) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel F T)) (wceq (cfv (cfv F R) I) (cfv (csn (cop F O)) N)) $;

--| Isomorphism H at an atom under ` W ` . (Contributed by NM, 27-Apr-2014.)
theorem dih1dimb2 {f2 h: setvar} (A2: class h) (B2: class f2) (Q: class h) (T: class) (U: class f2 h) (H: class h) (I: class f2 h) (K: class) (c_le: class h) (N O: class f2 h) (W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq O (cmpt h T (cres cid B2)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq N (cfv U clspn) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel Q A2) (wbr Q W c_le))) (wrex f2 (wa (wne (cv f2) (cres cid B2)) (wceq (cfv Q I) (cfv (csn (cop (cv f2) O)) N))) T) $;

--| Isomorphism H at an atom not under ` W ` . (Contributed by NM, 27-Apr-2014.)
theorem dih1dimc {f2: setvar} (A2 P Q T: class) (U F: class f2) (H: class) (I: class f2) (K c_le: class) (N: class f2) (W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq P (cfv W (cfv K coc)) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq F (crio f2 (wceq (cfv P (cv f2)) Q) T) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wceq (cfv Q I) (cfv (csn (cop F (cres cid T))) N)) $;

--| Extend ~ dia2dim to partial isomorphism B. (Contributed by NM, 22-Sep-2014.)
theorem dib2dim (ph: wff) (A2 P c_po Q U H I c_or K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq I (cfv W (cfv K cdib)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wa (wcel P A2) (wbr P W c_le)) $ >
  $ wi ph (wa (wcel Q A2) (wbr Q W c_le)) $ >
  $ wi ph (wss (cfv (co P Q c_or) I) (co (cfv P I) (cfv Q I) c_po)) $;

--| Extend ~ dib2dim to isomorphism H. (Contributed by NM, 22-Sep-2014.)
theorem dih2dimb (ph: wff) (A2 P c_po Q U H I c_or K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wa (wcel P A2) (wbr P W c_le)) $ >
  $ wi ph (wa (wcel Q A2) (wbr Q W c_le)) $ >
  $ wi ph (wss (cfv (co P Q c_or) I) (co (cfv P I) (cfv Q I) c_po)) $;

--| Extend ~ dia2dim to isomorphism H. (This version combines ~ dib2dim and ~ dih2dimb for shorter overall proof, but may be less easy to understand. TODO: decide which to use.) (Contributed by NM, 22-Sep-2014.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem dih2dimbALTN (ph: wff) (A2 P c_po Q U H I c_or K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wa (wcel P A2) (wbr P W c_le)) $ >
  $ wi ph (wa (wcel Q A2) (wbr Q W c_le)) $ >
  $ wi ph (wss (cfv (co P Q c_or) I) (co (cfv P I) (cfv Q I) c_po)) $;

--| Ordered pair member of the partial isomorphism H for atom argument not under ` W ` . TODO: remove .t hypothesis. (Contributed by NM, 30-Mar-2014.)
theorem dihopelvalcqat {g2: setvar} (A2 P: class g2) (Q: class) (S: class g2) (T: class) (E F G H I: class g2) (K: class) (c_le: class g2) (W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq P (cfv W (cfv K coc)) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq G (crio g2 (wceq (cfv P (cv g2)) Q) T) $ >
  $ wcel F cvv $ >
  $ wcel S cvv $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wb (wcel (cop F S) (cfv Q I)) (wa (wceq F (cfv G S)) (wcel S E))) $;

--| Value of isomorphism H for a lattice ` K ` when ` -. X .<_ W ` , given auxiliary atom ` Q ` . (Contributed by NM, 26-Sep-2014.)
theorem dihvalcq2 (A2 B2 c_po Q U H I c_or K c_le c_an W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wn (wbr X W c_le))) (wa (wa (wcel Q A2) (wn (wbr Q W c_le))) (wbr Q X c_le))) (wceq (cfv X I) (co (cfv Q I) (cfv (co X W c_an) I) c_po)) $;

--| Member of value of isomorphism H for a lattice ` K ` when ` -. X .<_ W ` , given auxiliary atom ` Q ` . TODO: refactor to be shorter and more understandable; add lemmas? (Contributed by NM, 13-Mar-2014.)
theorem dihopelvalcpre {g2 h a b: setvar} (A2: class h a b) (B2: class g2 a b) (C: class g2 h a b) (P: class h a b) (c_pl c_po: class g2 h a b) (Q: class h a b) (R S: class g2 h a b) (T: class) (U: class g2 h a b) (E: class g2 h) (F G: class g2 h a b) (H: class a b) (I c_or: class g2 h a b) (K: class) (c_le: class h a b) (c_an N O V: class g2 h a b) (W: class) (X Z: class g2 h a b):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq P (cfv W (cfv K coc)) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq G (crio g2 (wceq (cfv P (cv g2)) Q) T) $ >
  $ wcel F cvv $ >
  $ wcel S cvv $ >
  $ wceq Z (cmpt h T (cres cid B2)) $ >
  $ wceq N (cfv W (cfv K cdib)) $ >
  $ wceq C (cfv W (cfv K cdic)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq V (cfv U clss) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq O (cmpo a b E E (cmpt h T (ccom (cfv (cv h) (cv a)) (cfv (cv h) (cv b))))) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wn (wbr X W c_le))) (wa (wa (wcel Q A2) (wn (wbr Q W c_le))) (wceq (co Q (co X W c_an) c_or) X))) (wb (wcel (cop F S) (cfv X I)) (wa (wa (wcel F T) (wcel S E)) (wbr (cfv (ccom F (ccnv (cfv G S))) R) X c_le))) $;

--| Member of value of isomorphism H for a lattice ` K ` when ` -. X .<_ W ` , given auxiliary atom ` Q ` . (Contributed by NM, 13-Mar-2014.)
theorem dihopelvalc {g2: setvar} (A2: class) (B2: class g2) (P Q: class) (R S: class g2) (T: class) (E F G: class g2) (H: class) (I c_or: class g2) (K c_le: class) (c_an: class g2) (W: class) (X: class g2):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq P (cfv W (cfv K coc)) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq G (crio g2 (wceq (cfv P (cv g2)) Q) T) $ >
  $ wcel F cvv $ >
  $ wcel S cvv $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wn (wbr X W c_le))) (wa (wa (wcel Q A2) (wn (wbr Q W c_le))) (wceq (co Q (co X W c_an) c_or) X))) (wb (wcel (cop F S) (cfv X I)) (wa (wa (wcel F T) (wcel S E)) (wbr (cfv (ccom F (ccnv (cfv G S))) R) X c_le))) $;

--| The value of isomorphism H is a subspace. (Contributed by NM, 6-Mar-2014.)
theorem dihlss (B2 S U H I K W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv U clss) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel X B2)) (wcel (cfv X I) S) $;

--| The value of isomorphism H is a set of vectors. (Contributed by NM, 14-Mar-2014.)
theorem dihss (B2 U H I K V W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel X B2)) (wss (cfv X I) V) $;

--| An isomorphism H value is included in the vector space (expressed as ` T X. E ` ). (Contributed by NM, 26-Sep-2014.)
theorem dihssxp (ph: wff) (B2 T E H I K W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wss (cfv X I) (cxp T E)) $;

--| Closure of an ordered pair (vector) member of a value of isomorphism H. (Contributed by NM, 26-Sep-2014.)
theorem dihopcl (ph: wff) (B2 S T E F H I K W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel (cop F S) (cfv X I)) $ >
  $ wi ph (wa (wcel F T) (wcel S E)) $;

--| Ordered pair membership in a subspace sum of isomorphism H values. (Contributed by NM, 26-Sep-2014.) (New usage is discouraged.)
theorem xihopellsmN {u t f2 g2 h s1: setvar} (ph: wff f2 s1) (A2 B2 c_po: class u t f2 g2 h s1) (S: class f2 s1) (T: class u t f2 g2 h s1) (U: class f2 s1) (E: class u f2 g2 h) (F: class f2 s1) (H: class u h s1) (I: class f2 s1) (K: class u h) (L: class u t f2 g2 h s1) (W: class u h) (X Y: class f2 s1):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq A2 (cmpo s1 t E E (cmpt f2 T (ccom (cfv (cv f2) (cv s1)) (cfv (cv f2) (cv t))))) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq L (cfv U clss) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wb (wcel (cop F S) (co (cfv X I) (cfv Y I) c_po)) (wex g2 (wex t (wex h (wex u (wa (wa (wcel (cop (cv g2) (cv t)) (cfv X I)) (wcel (cop (cv h) (cv u)) (cfv Y I))) (wa (wceq F (ccom (cv g2) (cv h))) (wceq S (co (cv t) (cv u) A2))))))))) $;

--| Ordered pair membership in a subspace sum of isomorphism H values. (Contributed by NM, 26-Sep-2014.)
theorem dihopellsm {w v u t g2 h i: setvar} (ph: wff w v i) (A2 B2 c_po: class w v u t g2 h i) (S: class w v i) (T: class w v u t g2 h i) (U: class w v i) (E: class u t g2 h i) (F: class w v i) (H: class w v u h) (I: class w v i) (K: class u h) (L: class w v u t g2 h i) (W: class u h) (X Y: class w v i):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq A2 (cmpo v w E E (cmpt i T (ccom (cfv (cv i) (cv v)) (cfv (cv i) (cv w))))) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq L (cfv U clss) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wb (wcel (cop F S) (co (cfv X I) (cfv Y I) c_po)) (wex g2 (wex t (wex h (wex u (wa (wa (wcel (cop (cv g2) (cv t)) (cfv X I)) (wcel (cop (cv h) (cv u)) (cfv Y I))) (wa (wceq F (ccom (cv g2) (cv h))) (wceq S (co (cv t) (cv u) A2))))))))) $;

--| Part of proof that isomorphism H is order-preserving . (Contributed by NM, 7-Mar-2014.)
theorem dihord6apre {h q: setvar} (A2: class h) (B2: class) (P c_po: class h q) (T: class) (U E G: class h q) (H I: class h) (K: class) (c_le O: class h) (W: class) (X Y: class h):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq P (cfv W (cfv K coc)) $ >
  $ wceq O (cmpt h T (cres cid B2)) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq G (crio h (wceq (cfv P (cv h)) (cv q)) T) $ >
  $ wi (wa (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wn (wbr X W c_le))) (wa (wcel Y B2) (wbr Y W c_le))) (wss (cfv X I) (cfv Y I))) (wbr X Y c_le) $;

--| The isomorphism H for a lattice ` K ` is order-preserving in the region under co-atom ` W ` . (Contributed by NM, 6-Mar-2014.)
theorem dihord3 (B2 H I K c_le W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wbr X W c_le)) (wa (wcel Y B2) (wbr Y W c_le))) (wb (wss (cfv X I) (cfv Y I)) (wbr X Y c_le)) $;

--| The isomorphism H for a lattice ` K ` is order-preserving in the region not under co-atom ` W ` . TODO: reformat ` ( q e. A /\ -. q .<_ W ) ` to eliminate adant*. (Contributed by NM, 6-Mar-2014.)
theorem dihord4 (B2 H I K c_le W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wn (wbr X W c_le))) (wa (wcel Y B2) (wn (wbr Y W c_le)))) (wb (wss (cfv X I) (cfv Y I)) (wbr X Y c_le)) $;

--| Part of proof that isomorphism H is order-preserving. TODO: eliminate 3ad2ant1; combine with other way to have one lhpmcvr2 . (Contributed by NM, 7-Mar-2014.)
theorem dihord5b (B2 H I K c_le W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi (wa (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wbr X W c_le)) (wa (wcel Y B2) (wn (wbr Y W c_le)))) (wbr X Y c_le)) (wss (cfv X I) (cfv Y I)) $;

--| Part of proof that isomorphism H is order-preserving . (Contributed by NM, 7-Mar-2014.)
theorem dihord6b (B2 H I K c_le W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi (wa (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wn (wbr X W c_le))) (wa (wcel Y B2) (wbr Y W c_le))) (wbr X Y c_le)) (wss (cfv X I) (cfv Y I)) $;

--| Part of proof that isomorphism H is order-preserving . (Contributed by NM, 7-Mar-2014.)
theorem dihord6a (B2 H I K c_le W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi (wa (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wn (wbr X W c_le))) (wa (wcel Y B2) (wbr Y W c_le))) (wss (cfv X I) (cfv Y I))) (wbr X Y c_le) $;

--| Part of proof that isomorphism H is order-preserving . (Contributed by NM, 7-Mar-2014.)
theorem dihord5apre (A2 B2 c_po U H I c_or K c_le c_an W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi (wa (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wbr X W c_le)) (wa (wcel Y B2) (wn (wbr Y W c_le)))) (wss (cfv X I) (cfv Y I))) (wbr X Y c_le) $;

--| Part of proof that isomorphism H is order-preserving . (Contributed by NM, 7-Mar-2014.)
theorem dihord5a (B2 H I K c_le W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi (wa (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wbr X W c_le)) (wa (wcel Y B2) (wn (wbr Y W c_le)))) (wss (cfv X I) (cfv Y I))) (wbr X Y c_le) $;

--| The isomorphism H is order-preserving. Part of proof after Lemma N of [Crawley] p. 122 line 6. (Contributed by NM, 7-Mar-2014.)
theorem dihord (B2 H I K c_le W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel X B2) (wcel Y B2)) (wb (wss (cfv X I) (cfv Y I)) (wbr X Y c_le)) $;

--| The isomorphism H is one-to-one. Part of proof after Lemma N of [Crawley] p. 122 line 6. (Contributed by NM, 7-Mar-2014.)
theorem dih11 (B2 H I K W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel X B2) (wcel Y B2)) (wb (wceq (cfv X I) (cfv Y I)) (wceq X Y)) $;

--| Functionality of the isomorphism H. (Contributed by NM, 6-Mar-2014.)
theorem dihf11lem (B2 S U H I K W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv U clss) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wf B2 S I) $;

--| The isomorphism H for a lattice ` K ` is a one-to-one function. Part of proof after Lemma N of [Crawley] p. 122 line 6. (Contributed by NM, 7-Mar-2014.)
theorem dihf11 (B2 S U H I K W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv U clss) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wf1 B2 S I) $;

--| Functionality and domain of isomorphism H. (Contributed by NM, 9-Mar-2014.)
theorem dihfn (B2 H I K W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wfn I B2) $;

--| Domain of isomorphism H. (Contributed by NM, 9-Mar-2014.)
theorem dihdm (B2 H I K W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wceq (cdm I) B2) $;

--| Closure of isomorphism H. (Contributed by NM, 8-Mar-2014.)
theorem dihcl (B2 H I K W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel X B2)) (wcel (cfv X I) (crn I)) $;

--| Closure of isomorphism H converse. (Contributed by NM, 8-Mar-2014.)
theorem dihcnvcl (B2 H I K W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel X (crn I))) (wcel (cfv X (ccnv I)) B2) $;

--| The converse isomorphism of an isomorphism. (Contributed by NM, 5-Aug-2014.)
theorem dihcnvid1 (B2 H I K W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel X B2)) (wceq (cfv (cfv X I) (ccnv I)) X) $;

--| The isomorphism of a converse isomorphism. (Contributed by NM, 5-Aug-2014.)
theorem dihcnvid2 (H I K W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel X (crn I))) (wceq (cfv (cfv X (ccnv I)) I) X) $;

--| Ordering property for converse of isomorphism H. (Contributed by NM, 17-Aug-2014.)
theorem dihcnvord (ph: wff) (H I K c_le W X Y: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (crn I)) $ >
  $ wi ph (wcel Y (crn I)) $ >
  $ wi ph (wb (wbr (cfv X (ccnv I)) (cfv Y (ccnv I)) c_le) (wss X Y)) $;

--| The converse of isomorphism H is one-to-one. (Contributed by NM, 17-Aug-2014.)
theorem dihcnv11 (ph: wff) (H I K W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (crn I)) $ >
  $ wi ph (wcel Y (crn I)) $ >
  $ wi ph (wb (wceq (cfv X (ccnv I)) (cfv Y (ccnv I))) (wceq X Y)) $;

--| The isomorphism H maps to subspaces. (Contributed by NM, 14-Mar-2014.)
theorem dihsslss (S U H I K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq S (cfv U clss) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wss (crn I) S) $;

--| The isomorphism H maps to subspaces. (Contributed by NM, 14-Mar-2014.)
theorem dihrnlss (S U H I K W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq S (cfv U clss) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel X (crn I))) (wcel X S) $;

--| The isomorphism H maps to a set of vectors. (Contributed by NM, 14-Mar-2014.)
theorem dihrnss (U H I K V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel X (crn I))) (wss X V) $;

--| The value of isomorphism H is a relation. (Contributed by NM, 9-Mar-2014.)
theorem dihvalrel (H I K W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wrel (cfv X I)) $;

--| The value of isomorphism H at the lattice zero is the singleton of the zero vector i.e. the zero subspace. (Contributed by NM, 9-Mar-2014.)
theorem dih0 (U H I K O W c_0: class):
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq O (cfv U c0g) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wceq (cfv c_0 I) (csn O)) $;

--| A lattice element is zero iff its isomorphism is the zero subspace. (Contributed by NM, 16-Aug-2014.) (New usage is discouraged.)
theorem dih0bN (ph: wff) (B2 U H I K W X c_0 Z: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq Z (cfv U c0g) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wb (wceq X c_0) (wceq (cfv X I) (csn Z))) $;

--| A vector is zero iff its span is the isomorphism of lattice zero. (Contributed by NM, 16-Aug-2014.) (New usage is discouraged.)
theorem dih0vbN (ph: wff) (U H I K N V W X c_0 Z: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq Z (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wb (wceq X Z) (wceq (cfv (csn X) N) (cfv c_0 I))) $;

--| The isomorphism H converse value of the zero subspace is the lattice zero. (Contributed by NM, 19-Jun-2014.)
theorem dih0cnv (U H I K W c_0 Z: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq Z (cfv U c0g) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wceq (cfv (csn Z) (ccnv I)) c_0) $;

--| The zero subspace belongs to the range of isomorphism H. (Contributed by NM, 27-Apr-2014.)
theorem dih0rn (U H I K W c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wcel (csn c_0) (crn I)) $;

--| A subspace is zero iff the converse of its isomorphism is lattice zero. (Contributed by NM, 17-Aug-2014.)
theorem dih0sb (ph: wff) (U H I K N V W X c_0 Z: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq Z (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (crn I)) $ >
  $ wi ph (wb (wceq X (csn Z)) (wceq (cfv X (ccnv I)) c_0)) $;

--| The value of isomorphism H at the lattice unity is the set of all vectors. (Contributed by NM, 13-Mar-2014.)
theorem dih1 (U c_1 H I K V W: class):
  $ wceq c_1 (cfv K cp1) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wceq (cfv c_1 I) V) $;

--| The full vector space belongs to the range of isomorphism H. (Contributed by NM, 19-Jun-2014.)
theorem dih1rn (U H I K V W: class):
  $ wceq H (cfv K clh) $ >

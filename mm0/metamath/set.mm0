  $ wceq G (cmpt x3 B2 (cif (wa (wne P Q) (wn (wbr (cv x3) W c_le))) (crio z (wral s1 (wi (wa (wn (wbr (cv s1) W c_le)) (wceq (co (cv s1) (co (cv x3) W c_an) c_or) (cv x3))) (wceq (cv z) (co (cif (wbr (cv s1) (co P Q c_or) c_le) (crio y1 (wral t (wi (wa (wn (wbr (cv t) W c_le)) (wn (wbr (cv t) (co P Q c_or) c_le))) (wceq (cv y1) E)) A2) B2) (csb t (cv s1) D)) (co (cv x3) W c_an) c_or))) A2) B2) (cv x3))) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wa (wcel F T) (wceq (cfv P F) Q))) (wceq F G) $;


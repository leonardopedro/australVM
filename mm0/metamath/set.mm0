  $ wceq B2 (co (co (co G H c_or) I c_or) Y c_an) $ >
  $ wi (w3a ph (wceq Y Z) ps) (wbr F B2 c_le) $;

--| Lemma for ~ dath . ` B ` is an axis of perspectivity (almost). (Contributed by NM, 11-Aug-2012.)
theorem dalem60 {c d: setvar} (ph ps: wff c d) (A2 B2 C D P Q R S T U E G H I c_or K c_le c_an O Y Z: class c d):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wb ps (w3a (wa (wcel (cv c) A2) (wcel (cv d) A2)) (wn (wbr (cv c) Y c_le)) (w3a (wne (cv d) (cv c)) (wn (wbr (cv d) Y c_le)) (wbr C (co (cv c) (cv d) c_or) c_le))) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wceq Z (co (co S T c_or) U c_or) $ >
  $ wceq D (co (co P Q c_or) (co S T c_or) c_an) $ >
  $ wceq E (co (co Q R c_or) (co T U c_or) c_an) $ >
  $ wceq G (co (co (cv c) P c_or) (co (cv d) S c_or) c_an) $ >
  $ wceq H (co (co (cv c) Q c_or) (co (cv d) T c_or) c_an) $ >
  $ wceq I (co (co (cv c) R c_or) (co (cv d) U c_or) c_an) $ >
  $ wceq B2 (co (co (co G H c_or) I c_or) Y c_an) $ >
  $ wi (w3a ph (wceq Y Z) ps) (wceq (co D E c_or) B2) $;

--| Lemma for ~ dath . Show that atoms ` D ` , ` E ` , and ` F ` lie on the same line (axis of perspectivity). Eliminate hypotheses containing dummy atoms ` c ` and ` d ` . (Contributed by NM, 11-Aug-2012.)
theorem dalem61 {c d: setvar} (ph ps: wff c d) (A2 C D P Q R S T U E F c_or K c_le c_an O Y Z: class c d):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wb ps (w3a (wa (wcel (cv c) A2) (wcel (cv d) A2)) (wn (wbr (cv c) Y c_le)) (w3a (wne (cv d) (cv c)) (wn (wbr (cv d) Y c_le)) (wbr C (co (cv c) (cv d) c_or) c_le))) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wceq Z (co (co S T c_or) U c_or) $ >
  $ wceq D (co (co P Q c_or) (co S T c_or) c_an) $ >
  $ wceq E (co (co Q R c_or) (co T U c_or) c_an) $ >
  $ wceq F (co (co R P c_or) (co U S c_or) c_an) $ >
  $ wi (w3a ph (wceq Y Z) ps) (wbr F (co D E c_or) c_le) $;

--| Lemma for ~ dath . Eliminate the condition ` ps ` containing dummy variables ` c ` and ` d ` . (Contributed by NM, 11-Aug-2012.)
theorem dalem62 (ph: wff) (A2 C D P Q R S T U E F c_or K c_le c_an O Y Z: class):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wceq Z (co (co S T c_or) U c_or) $ >
  $ wceq D (co (co P Q c_or) (co S T c_or) c_an) $ >
  $ wceq E (co (co Q R c_or) (co T U c_or) c_an) $ >
  $ wceq F (co (co R P c_or) (co U S c_or) c_an) $ >
  $ wi (wa ph (wceq Y Z)) (wbr F (co D E c_or) c_le) $;

--| Lemma for ~ dath . Combine the cases where ` Y ` and ` Z ` are different planes with the case where ` Y ` and ` Z ` are the same plane. (Contributed by NM, 11-Aug-2012.)
theorem dalem63 (ph: wff) (A2 C D P Q R S T U E F c_or K c_le c_an O Y Z: class):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wceq Z (co (co S T c_or) U c_or) $ >
  $ wceq D (co (co P Q c_or) (co S T c_or) c_an) $ >
  $ wceq E (co (co Q R c_or) (co T U c_or) c_an) $ >
  $ wceq F (co (co R P c_or) (co U S c_or) c_an) $ >
  $ wi ph (wbr F (co D E c_or) c_le) $;

--| Desargues's theorem of projective geometry (proved for a Hilbert lattice). Assume each triple of atoms (points) ` P Q R ` and ` S T U ` forms a triangle (i.e. determines a plane). Assume that lines ` P S ` , ` Q T ` , and ` R U ` meet at a "center of perspectivity" ` C ` . (We also assume that ` C ` is not on any of the 6 lines forming the two triangles.) Then the atoms ` D = ( P .\/ Q ) ./\ ( S .\/ T ) ` , ` E = ( Q .\/ R ) ./\ ( T .\/ U ) ` , ` F = ( R .\/ P ) ./\ ( U .\/ S ) ` are colinear, forming an "axis of perspectivity". Our proof roughly follows Theorem 2.7.1, p. 78 in Beutelspacher and Rosenbaum, _Projective Geometry: From Foundations to Applications_, Cambridge University Press (1988). Unlike them, we do not assume that ` C ` is an atom to make this theorem slightly more general for easier future use. However, we prove that ` C ` must be an atom in ~ dalemcea . For a visual demonstration, see the "Desargues's theorem" applet at ~ http://www.dynamicgeometry.com/JavaSketchpad/Gallery.html . The points I, J, and K there define the axis of perspectivity. See Theorems ~ dalaw for Desargues's law, which eliminates all of the preconditions on the atoms except for central perspectivity. This is Metamath 100 proof #87. (Contributed by NM, 20-Aug-2012.)
theorem dath (A2 B2 C D P Q R S T U E F c_or K c_le c_an O: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq D (co (co P Q c_or) (co S T c_or) c_an) $ >
  $ wceq E (co (co Q R c_or) (co T U c_or) c_an) $ >
  $ wceq F (co (co R P c_or) (co U S c_or) c_an) $ >
  $ wi (w3a (w3a (wa (wcel K chlt) (wcel C B2)) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel (co (co P Q c_or) R c_or) O) (wcel (co (co S T c_or) U c_or) O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) (wbr F (co D E c_or) c_le) $;

--| Version of Desargues's theorem ~ dath with a different variable ordering. (Contributed by NM, 7-Oct-2012.)
theorem dath2 (A2 B2 C D P Q R S T U E F c_or K c_le c_an O: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq D (co (co P Q c_or) (co S T c_or) c_an) $ >
  $ wceq E (co (co Q R c_or) (co T U c_or) c_an) $ >
  $ wceq F (co (co R P c_or) (co U S c_or) c_an) $ >
  $ wi (w3a (w3a (wa (wcel K chlt) (wcel C B2)) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel (co (co P Q c_or) R c_or) O) (wcel (co (co S T c_or) U c_or) O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) (wbr D (co E F c_or) c_le) $;

--| The set of lines in a Hilbert lattice. (Contributed by NM, 19-Sep-2011.)
theorem lineset {s1 r q p: setvar} (A2: class) (B2: class s1 r q p) (c_or: class r q p) (K: class) (c_le: class r q p) (N: class s1 r q p):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq N (cfv K clines) $ >
  $ wi (wcel K B2) (wceq N (cab s1 (wrex q (wrex r (wa (wne (cv q) (cv r)) (wceq (cv s1) (crab p (wbr (cv p) (co (cv q) (cv r) c_or) c_le) A2))) A2) A2))) $;

--| The predicate "is a line". (Contributed by NM, 19-Sep-2011.)
theorem isline {r q p: setvar} (A2: class) (D c_or: class r q p) (K: class) (c_le N: class r q p) (X: class p):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq N (cfv K clines) $ >
  $ wi (wcel K D) (wb (wcel X N) (wrex q (wrex r (wa (wne (cv q) (cv r)) (wceq X (crab p (wbr (cv p) (co (cv q) (cv r) c_or) c_le) A2))) A2) A2)) $;

--| Condition implying "is a line". (Contributed by NM, 3-Feb-2012.)
theorem islinei {p: setvar} (A2: class) (D: class p) (Q R: class) (c_or: class p) (K: class) (c_le N X: class p):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq N (cfv K clines) $ >
  $ wi (wa (w3a (wcel K D) (wcel Q A2) (wcel R A2)) (wa (wne Q R) (wceq X (crab p (wbr (cv p) (co Q R c_or) c_le) A2)))) (wcel X N) $;

--| The set of points in a Hilbert lattice. (Contributed by NM, 2-Oct-2011.) (New usage is discouraged.)
theorem pointsetN {p a: setvar} (A2: class) (B2 P: class p a) (K: class a):
  $ wceq A2 (cfv K catm) $ >
  $ wceq P (cfv K cpointsN) $ >
  $ wi (wcel K B2) (wceq P (cab p (wrex a (wceq (cv p) (csn (cv a))) A2))) $;

--| The predicate "is a point". (Contributed by NM, 2-Oct-2011.) (New usage is discouraged.)
theorem ispointN {a: setvar} (A2: class) (D P K: class a) (X: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq P (cfv K cpointsN) $ >
  $ wi (wcel K D) (wb (wcel X P) (wrex a (wceq X (csn (cv a))) A2)) $;

--| The singleton of an atom is a point. (Contributed by NM, 14-Jan-2012.) (New usage is discouraged.)
theorem atpointN (A2 D P K X: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq P (cfv K cpointsN) $ >
  $ wi (wa (wcel K D) (wcel X A2)) (wcel (csn X) P) $;

--| The set of projective subspaces in a Hilbert lattice. (Contributed by NM, 2-Oct-2011.)
theorem psubspset {s1 r q p: setvar} (A2: class q p) (B2 S c_or: class s1 r q p) (K: class) (c_le: class s1 r q p):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq S (cfv K cpsubsp) $ >
  $ wi (wcel K B2) (wceq S (cab s1 (wa (wss (cv s1) A2) (wral p (wral q (wral r (wi (wbr (cv r) (co (cv p) (cv q) c_or) c_le) (wcel (cv r) (cv s1))) A2) (cv s1)) (cv s1))))) $;

--| The predicate "is a projective subspace". (Contributed by NM, 2-Oct-2011.)
theorem ispsubsp {r q p: setvar} (A2: class q p) (D S c_or: class r q p) (K: class) (c_le: class r q p) (X: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq S (cfv K cpsubsp) $ >
  $ wi (wcel K D) (wb (wcel X S) (wa (wss X A2) (wral p (wral q (wral r (wi (wbr (cv r) (co (cv p) (cv q) c_or) c_le) (wcel (cv r) X)) A2) X) X))) $;

--| The predicate "is a projective subspace". (Contributed by NM, 13-Jan-2012.)
theorem ispsubsp2 {r q p: setvar} (A2: class) (D S c_or: class r q p) (K: class) (c_le: class r q p) (X: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq S (cfv K cpsubsp) $ >
  $ wi (wcel K D) (wb (wcel X S) (wa (wss X A2) (wral p (wi (wrex q (wrex r (wbr (cv p) (co (cv q) (cv r) c_or) c_le) X) X) (wcel (cv p) X)) A2))) $;

--| Property of a projective subspace. (Contributed by NM, 13-Jan-2012.)
theorem psubspi {r q: setvar} (A2: class) (D: class r q) (P: class) (S c_or: class r q) (K: class) (c_le: class r q) (X: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq S (cfv K cpsubsp) $ >
  $ wi (wa (w3a (wcel K D) (wcel X S) (wcel P A2)) (wrex q (wrex r (wbr P (co (cv q) (cv r) c_or) c_le) X) X)) (wcel P X) $;

--| Property of a projective subspace. (Contributed by NM, 13-Jan-2012.) (New usage is discouraged.)
theorem psubspi2N (A2 D P Q R S c_or K c_le X: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq S (cfv K cpsubsp) $ >
  $ wi (wa (w3a (wcel K D) (wcel X S) (wcel P A2)) (w3a (wcel Q X) (wcel R X) (wbr P (co Q R c_or) c_le))) (wcel P X) $;

--| The empty set is a projective subspace. Remark below Definition 15.1 of [MaedaMaeda] p. 61. (Contributed by NM, 13-Oct-2011.) (New usage is discouraged.)
theorem _0psubN (S K V: class):
  $ wceq S (cfv K cpsubsp) $ >
  $ wi (wcel K V) (wcel c0 S) $;

--| The singleton of an atom is a projective subspace. (Contributed by NM, 9-Sep-2013.) (New usage is discouraged.)
theorem snatpsubN (A2 P S K: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq S (cfv K cpsubsp) $ >
  $ wi (wa (wcel K cal) (wcel P A2)) (wcel (csn P) S) $;

--| A point (singleton of an atom) is a projective subspace. Remark below Definition 15.1 of [MaedaMaeda] p. 61. (Contributed by NM, 13-Oct-2011.) (New usage is discouraged.)
theorem pointpsubN (P S K X: class):
  $ wceq P (cfv K cpointsN) $ >
  $ wceq S (cfv K cpsubsp) $ >
  $ wi (wa (wcel K cal) (wcel X P)) (wcel X S) $;

--| A line is a projective subspace. (Contributed by NM, 16-Oct-2011.) (New usage is discouraged.)
theorem linepsubN (S K N X: class):
  $ wceq N (cfv K clines) $ >
  $ wceq S (cfv K cpsubsp) $ >
  $ wi (wa (wcel K clat) (wcel X N)) (wcel X S) $;

--| The set of all atoms is a projective subspace. Remark below Definition 15.1 of [MaedaMaeda] p. 61. (Contributed by NM, 13-Oct-2011.) (New usage is discouraged.)
theorem atpsubN (A2 S K V: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq S (cfv K cpsubsp) $ >
  $ wi (wcel K V) (wcel A2 S) $;

--| A projective subspace consists of atoms. (Contributed by NM, 4-Nov-2011.)
theorem psubssat (A2 B2 S K X: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq S (cfv K cpsubsp) $ >
  $ wi (wa (wcel K B2) (wcel X S)) (wss X A2) $;

--| A member of a projective subspace is an atom. (Contributed by NM, 4-Nov-2011.) (New usage is discouraged.)
theorem psubatN (A2 B2 S K X Y: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq S (cfv K cpsubsp) $ >
  $ wi (w3a (wcel K B2) (wcel X S) (wcel Y X)) (wcel Y A2) $;

--| The projective map of a Hilbert lattice. (Contributed by NM, 2-Oct-2011.)
theorem pmapfval {x3 a: setvar} (A2: class x3) (B2: class a) (C: class x3 a) (K: class) (c_le M: class x3 a):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wi (wcel K C) (wceq M (cmpt x3 B2 (crab a (wbr (cv a) (cv x3) c_le) A2))) $;

--| Value of the projective map of a Hilbert lattice. Definition in Theorem 15.5 of [MaedaMaeda] p. 62. (Contributed by NM, 2-Oct-2011.)
theorem pmapval {a: setvar} (A2: class) (B2 C: class a) (K: class) (c_le M: class a) (X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wi (wa (wcel K C) (wcel X B2)) (wceq (cfv X M) (crab a (wbr (cv a) X c_le) A2)) $;

--| Member of a projective map. (Contributed by NM, 27-Jan-2012.)
theorem elpmap (A2 B2 C P K c_le M X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wi (wa (wcel K C) (wcel X B2)) (wb (wcel P (cfv X M)) (wa (wcel P A2) (wbr P X c_le))) $;

--| The projective map of a Hilbert lattice is a set of atoms. (Contributed by NM, 14-Jan-2012.)
theorem pmapssat (A2 B2 C K M X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wi (wa (wcel K C) (wcel X B2)) (wss (cfv X M) A2) $;

--| A weakening of ~ pmapssat to shorten some proofs. (Contributed by NM, 7-Mar-2012.) (New usage is discouraged.)
theorem pmapssbaN (B2 C K M X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wi (wa (wcel K C) (wcel X B2)) (wss (cfv X M) B2) $;

--| The projective map of a Hilbert lattice preserves ordering. Part of Theorem 15.5 of [MaedaMaeda] p. 62. (Contributed by NM, 22-Oct-2011.)
theorem pmaple (B2 K c_le M X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wi (w3a (wcel K chlt) (wcel X B2) (wcel Y B2)) (wb (wbr X Y c_le) (wss (cfv X M) (cfv Y M))) $;

--| The projective map of a Hilbert lattice is one-to-one. Part of Theorem 15.5 of [MaedaMaeda] p. 62. (Contributed by NM, 22-Oct-2011.)
theorem pmap11 (B2 K M X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wi (w3a (wcel K chlt) (wcel X B2) (wcel Y B2)) (wb (wceq (cfv X M) (cfv Y M)) (wceq X Y)) $;

--| The projective map of an atom. (Contributed by NM, 25-Jan-2012.)
theorem pmapat (A2 P K M: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wi (wa (wcel K chlt) (wcel P A2)) (wceq (cfv P M) (csn P)) $;

--| Member of the projective map of an atom. (Contributed by NM, 27-Jan-2012.)
theorem elpmapat (A2 P K M X: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wi (wa (wcel K chlt) (wcel P A2)) (wb (wcel X (cfv P M)) (wceq X P)) $;

--| Value of the projective map of a Hilbert lattice at lattice zero. Part of Theorem 15.5.1 of [MaedaMaeda] p. 62. (Contributed by NM, 17-Oct-2011.)
theorem pmap0 (K M c_0: class):
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wi (wcel K cal) (wceq (cfv c_0 M) c0) $;

--| A projective map value is zero iff its argument is lattice zero. (Contributed by NM, 27-Jan-2012.)
theorem pmapeq0 (B2 K M X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wi (wa (wcel K chlt) (wcel X B2)) (wb (wceq (cfv X M) c0) (wceq X c_0)) $;

--| Value of the projective map of a Hilbert lattice at lattice unity. Part of Theorem 15.5.1 of [MaedaMaeda] p. 62. (Contributed by NM, 22-Oct-2011.) (New usage is discouraged.)
theorem pmap1N (A2 c_1 K M: class):
  $ wceq c_1 (cfv K cp1) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wi (wcel K cops) (wceq (cfv c_1 M) A2) $;

--| The projective map of a Hilbert lattice maps to projective subspaces. Part of Theorem 15.5 of [MaedaMaeda] p. 62. (Contributed by NM, 17-Oct-2011.)
theorem pmapsub (B2 S K M X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq S (cfv K cpsubsp) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wi (wa (wcel K clat) (wcel X B2)) (wcel (cfv X M) S) $;

--| The projective map of the GLB of a set of lattice elements. Index-set version of ~ pmapglb , where we read ` S ` as ` S ( i ) ` . Theorem 15.5.2 of [MaedaMaeda] p. 62. (Contributed by NM, 5-Dec-2011.)
theorem pmapglbx {y1 i: setvar} (B2: class) (S: class i) (G: class y1 i) (I K: class) (M: class y1 i):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq G (cfv K cglb) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wi (w3a (wcel K chlt) (wral i (wcel S B2) I) (wne I c0)) (wceq (cfv (cfv (cab y1 (wrex i (wceq (cv y1) S) I)) G) M) (ciin i I (cfv S M))) $;

--| The projective map of the GLB of a set of lattice elements ` S ` . Variant of Theorem 15.5.2 of [MaedaMaeda] p. 62. (Contributed by NM, 5-Dec-2011.)
theorem pmapglb {x3: setvar} (B2 S: class) (G: class x3) (K: class) (M: class x3):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq G (cfv K cglb) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wi (w3a (wcel K chlt) (wss S B2) (wne S c0)) (wceq (cfv (cfv S G) M) (ciin x3 S (cfv (cv x3) M))) $;

--| The projective map of the GLB of a set of lattice elements ` S ` . Variant of Theorem 15.5.2 of [MaedaMaeda] p. 62. Allows ` S = (/) ` . (Contributed by NM, 21-Jan-2012.) (New usage is discouraged.)
theorem pmapglb2N {x3: setvar} (A2 B2 S: class) (G: class x3) (K: class) (M: class x3):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq G (cfv K cglb) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wi (wa (wcel K chlt) (wss S B2)) (wceq (cfv (cfv S G) M) (cin A2 (ciin x3 S (cfv (cv x3) M)))) $;

--| The projective map of the GLB of a set of lattice elements. Index-set version of ~ pmapglb2N , where we read ` S ` as ` S ( i ) ` . Extension of Theorem 15.5.2 of [MaedaMaeda] p. 62 that allows ` I = (/) ` . (Contributed by NM, 21-Jan-2012.) (New usage is discouraged.)
theorem pmapglb2xN {y1 i: setvar} (A2: class y1) (B2: class) (S: class i) (G: class y1 i) (I K: class) (M: class y1 i):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq G (cfv K cglb) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wi (wa (wcel K chlt) (wral i (wcel S B2) I)) (wceq (cfv (cfv (cab y1 (wrex i (wceq (cv y1) S) I)) G) M) (cin A2 (ciin i I (cfv S M)))) $;

--| The projective map of a meet. (Contributed by NM, 25-Jan-2012.)
theorem pmapmeet (A2 B2 P K c_an X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq P (cfv K cpmap) $ >
  $ wi (w3a (wcel K chlt) (wcel X B2) (wcel Y B2)) (wceq (cfv (co X Y c_an) P) (cin (cfv X P) (cfv Y P))) $;

--| Definition of line in terms of projective map. (Contributed by NM, 25-Jan-2012.)
theorem isline2 {q p: setvar} (A2: class) (c_or: class q p) (K: class) (M N: class q p) (X: class):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq N (cfv K clines) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wi (wcel K clat) (wb (wcel X N) (wrex p (wrex q (wa (wne (cv p) (cv q)) (wceq X (cfv (co (cv p) (cv q) c_or) M))) A2) A2)) $;

--| A line described with a projective map. (Contributed by NM, 3-Feb-2012.)
theorem linepmap (A2 P Q c_or K M N: class):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq N (cfv K clines) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wi (wa (w3a (wcel K clat) (wcel P A2) (wcel Q A2)) (wne P Q)) (wcel (cfv (co P Q c_or) M) N) $;

--| Definition of line in terms of original lattice elements. (Contributed by NM, 29-Apr-2012.)
theorem isline3 {q p: setvar} (A2 B2: class) (c_or: class q p) (K M: class) (N: class q p) (X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq N (cfv K clines) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wi (wa (wcel K chlt) (wcel X B2)) (wb (wcel (cfv X M) N) (wrex p (wrex q (wa (wne (cv p) (cv q)) (wceq X (co (cv p) (cv q) c_or))) A2) A2)) $;

--| Definition of line in terms of original lattice elements. (Contributed by NM, 16-Jun-2012.) (New usage is discouraged.)
theorem isline4N {p: setvar} (A2 B2: class) (C: class p) (K M: class) (N: class p) (X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq N (cfv K clines) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wi (wa (wcel K chlt) (wcel X B2)) (wb (wcel (cfv X M) N) (wrex p (wbr (cv p) X C) A2)) $;

--| A line equals the join of any two of its distinct points (atoms). (Contributed by NM, 29-Apr-2012.)
theorem lneq2at (A2 B2 P Q c_or K c_le M N X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq N (cfv K clines) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wi (w3a (w3a (wcel K chlt) (wcel X B2) (wcel (cfv X M) N)) (w3a (wcel P A2) (wcel Q A2) (wne P Q)) (wa (wbr P X c_le) (wbr Q X c_le))) (wceq X (co P Q c_or)) $;

--| There is an atom in a line different from any other. (Contributed by NM, 30-Apr-2012.) (New usage is discouraged.)
theorem lnatexN {q: setvar} (A2: class) (B2: class q) (P: class) (K: class q) (c_le: class) (M N: class q) (X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq N (cfv K clines) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wi (w3a (wcel K chlt) (wcel X B2) (wcel (cfv X M) N)) (wrex q (wa (wne (cv q) P) (wbr (cv q) X c_le)) A2) $;

--| Given an atom in a line, there is another atom which when joined equals the line. (Contributed by NM, 30-Apr-2012.) (New usage is discouraged.)
theorem lnjatN {q: setvar} (A2 B2 P: class) (c_or: class q) (K c_le M N X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq N (cfv K clines) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wi (wa (w3a (wcel K chlt) (wcel X B2) (wcel P A2)) (wa (wcel (cfv X M) N) (wbr P X c_le))) (wrex q (wa (wne (cv q) P) (wceq X (co P (cv q) c_or))) A2) $;

--| A lattice element covered by a line is an atom. (Contributed by NM, 28-Apr-2012.) (New usage is discouraged.)
theorem lncvrelatN (A2 B2 C P K M N X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq N (cfv K clines) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wi (wa (w3a (wcel K chlt) (wcel X B2) (wcel P B2)) (wa (wcel (cfv X M) N) (wbr P X C))) (wcel P A2) $;

--| A line covers the atoms it contains. (Contributed by NM, 30-Apr-2012.)
theorem lncvrat (A2 B2 C P K c_le M N X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq N (cfv K clines) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wi (wa (w3a (wcel K chlt) (wcel X B2) (wcel P A2)) (wa (wcel (cfv X M) N) (wbr P X c_le))) (wbr P X C) $;

--| If two lines are comparable, they are equal. (Contributed by NM, 30-Apr-2012.)
theorem lncmp (B2 K c_le M N X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq N (cfv K clines) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wi (wa (w3a (wcel K chlt) (wcel X B2) (wcel Y B2)) (wa (wcel (cfv X M) N) (wcel (cfv Y M) N))) (wb (wbr X Y c_le) (wceq X Y)) $;

--| Two intersecting lines intersect at an atom. (Contributed by NM, 30-Apr-2012.)
theorem _2lnat (A2 B2 F K c_an N X Y c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq N (cfv K clines) $ >
  $ wceq F (cfv K cpmap) $ >
  $ wi (w3a (w3a (wcel K chlt) (wcel X B2) (wcel Y B2)) (wa (wcel (cfv X F) N) (wcel (cfv Y F) N)) (wa (wne X Y) (wne (co X Y c_an) c_0))) (wcel (co X Y c_an) A2) $;

--| Two joins with a common atom have a nonzero meet. (Contributed by NM, 4-Jul-2012.) (New usage is discouraged.)
theorem _2atm2atN (A2 P Q R c_or K c_an c_0: class):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel R A2))) (wne (co (co R P c_or) (co R Q c_or) c_an) c_0) $;

--| Generalization of ~ 2llnma1 . (Contributed by NM, 26-Apr-2013.)
theorem _2llnma1b (A2 B2 P Q c_or K c_le c_an X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel X B2) (wcel P A2) (wcel Q A2)) (wn (wbr Q (co P X c_or) c_le))) (wceq (co (co P X c_or) (co P Q c_or) c_an) P) $;

--| Two different intersecting lines (expressed in terms of atoms) meet at their common point (atom). (Contributed by NM, 11-Oct-2012.)
theorem _2llnma1 (A2 P Q R c_or K c_le c_an: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wn (wbr R (co P Q c_or) c_le))) (wceq (co (co Q P c_or) (co Q R c_or) c_an) Q) $;

--| Two different intersecting lines (expressed in terms of atoms) meet at their common point (atom). (Contributed by NM, 30-Apr-2013.)
theorem _2llnma3r (A2 P Q R c_or K c_le c_an: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wne (co P R c_or) (co Q R c_or))) (wceq (co (co P R c_or) (co Q R c_or) c_an) R) $;

--| Two different intersecting lines (expressed in terms of atoms) meet at their common point (atom). (Contributed by NM, 28-May-2012.)
theorem _2llnma2 (A2 P Q R c_or K c_le c_an: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wa (wne P Q) (wn (wbr R (co P Q c_or) c_le)))) (wceq (co (co R P c_or) (co R Q c_or) c_an) R) $;

--| Two different intersecting lines (expressed in terms of atoms) meet at their common point (atom). (Contributed by NM, 2-May-2013.) (New usage is discouraged.)
theorem _2llnma2rN (A2 P Q R c_or K c_le c_an: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wa (wne P Q) (wn (wbr R (co P Q c_or) c_le)))) (wceq (co (co P R c_or) (co Q R c_or) c_an) R) $;

--| A condition for required for proof of Lemma A in [Crawley] p. 112. (Contributed by NM, 29-Apr-2012.) (New usage is discouraged.)
theorem cdlema1N (A2 B2 P Q R F c_or K c_le c_an N X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq N (cfv K clines) $ >
  $ wceq F (cfv K cpmap) $ >
  $ wi (w3a (w3a (wcel K chlt) (wcel X B2) (wcel Y B2)) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wa (wne R P) (wbr R (co P Q c_or) c_le)) (wa (wbr P X c_le) (wbr Q Y c_le)) (w3a (wcel (cfv Y F) N) (wcel (co X Y c_an) A2) (wn (wbr Q X c_le))))) (wceq (co X R c_or) (co X Y c_or)) $;

--| A condition for required for proof of Lemma A in [Crawley] p. 112. (Contributed by NM, 9-May-2012.) (New usage is discouraged.)
theorem cdlema2N (A2 B2 P Q R c_or K c_le c_an X c_0: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel X B2)) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (wa (wa (wne R P) (wbr R (co P Q c_or) c_le)) (wa (wbr P X c_le) (wn (wbr Q X c_le))))) (wceq (co R X c_an) c_0) $;

--| Lemma for ~ cdlemb . (Contributed by NM, 8-May-2012.)
theorem cdlemblem (u: setvar) (A2 B2 C P Q c_lt c_1 c_or K c_le c_an V X: class) (r: setvar):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_1 (cfv K cp1) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_lt (cfv K cplt) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq V (co (co P Q c_or) X c_an) $ >
  $ wi (w3a (w3a (w3a (wcel K chlt) (wcel P A2) (wcel Q A2)) (wa (wcel X B2) (wne P Q)) (w3a (wbr X c_1 C) (wn (wbr P X c_le)) (wn (wbr Q X c_le)))) (wa (wcel (cv u) A2) (wa (wne (cv u) V) (wbr (cv u) X c_lt))) (wa (wcel (cv r) A2) (w3a (wne (cv r) P) (wne (cv r) (cv u)) (wbr (cv r) (co P (cv u) c_or) c_le)))) (wa (wn (wbr (cv r) X c_le)) (wn (wbr (cv r) (co P Q c_or) c_le))) $;

--| Given two atoms not less than or equal to an element covered by 1, there is a third. Lemma B in [Crawley] p. 112. (Contributed by NM, 8-May-2012.)
theorem cdlemb {r: setvar} (A2 B2 C P Q c_1 c_or K c_le X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_1 (cfv K cp1) $ >
  $ wceq C (cfv K ccvr) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (w3a (wcel K chlt) (wcel P A2) (wcel Q A2)) (wa (wcel X B2) (wne P Q)) (w3a (wbr X c_1 C) (wn (wbr P X c_le)) (wn (wbr Q X c_le)))) (wrex r (wa (wn (wbr (cv r) X c_le)) (wn (wbr (cv r) (co P Q c_or) c_le))) A2) $;

--| Extend class notation with projective subspace sum.
term cpadd: class;

--| Define projective sum of two subspaces (or more generally two sets of atoms), which is the union of all lines generated by pairs of atoms from each subspace. Lemma 16.2 of [MaedaMaeda] p. 68. For convenience, our definition is generalized to apply to empty sets. (Contributed by NM, 29-Dec-2011.)
axiom df_padd {m n r q p l: setvar}:
  $ wceq cpadd (cmpt l cvv (cmpo m n (cpw (cfv (cv l) catm)) (cpw (cfv (cv l) catm)) (cun (cun (cv m) (cv n)) (crab p (wrex q (wrex r (wbr (cv p) (co (cv q) (cv r) (cfv (cv l) cjn)) (cfv (cv l) cple)) (cv n)) (cv m)) (cfv (cv l) catm))))) $;

--| Projective subspace sum operation. (Contributed by NM, 29-Dec-2011.)
theorem paddfval {m n r q p: setvar} (A2: class r q) (B2 c_pl c_or: class m n r q p) (K: class) (c_le: class m n r q p):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wcel K B2) (wceq c_pl (cmpo m n (cpw A2) (cpw A2) (cun (cun (cv m) (cv n)) (crab p (wrex q (wrex r (wbr (cv p) (co (cv q) (cv r) c_or) c_le) (cv n)) (cv m)) A2)))) $;

--| Projective subspace sum operation value. (Contributed by NM, 29-Dec-2011.)
theorem paddval {r q p: setvar} (A2: class r q) (B2 c_pl c_or: class r q p) (K: class) (c_le: class r q p) (X: class r) (Y: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (w3a (wcel K B2) (wss X A2) (wss Y A2)) (wceq (co X Y c_pl) (cun (cun X Y) (crab p (wrex q (wrex r (wbr (cv p) (co (cv q) (cv r) c_or) c_le) Y) X) A2))) $;

--| Member of a projective subspace sum. (Contributed by NM, 29-Dec-2011.)
theorem elpadd {r q: setvar} (A2 B2 c_pl: class r q) (S: class) (c_or: class r q) (K: class) (c_le: class r q) (X: class r) (Y: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (w3a (wcel K B2) (wss X A2) (wss Y A2)) (wb (wcel S (co X Y c_pl)) (wo (wo (wcel S X) (wcel S Y)) (wa (wcel S A2) (wrex q (wrex r (wbr S (co (cv q) (cv r) c_or) c_le) Y) X)))) $;

--| Member of projective subspace sum of nonempty sets. (Contributed by NM, 3-Jan-2012.)
theorem elpaddn0 {r q: setvar} (A2: class) (c_pl: class r q) (S c_or K c_le X Y: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (w3a (wcel K clat) (wss X A2) (wss Y A2)) (wa (wne X c0) (wne Y c0))) (wb (wcel S (co X Y c_pl)) (wa (wcel S A2) (wrex q (wrex r (wbr S (co (cv q) (cv r) c_or) c_le) Y) X))) $;

--| Projective subspace sum operation value for nonempty sets. (Contributed by NM, 27-Jan-2012.) (New usage is discouraged.)
theorem paddvaln0N {r q p: setvar} (A2: class) (c_pl: class r q p) (c_or K c_le X Y: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (w3a (wcel K clat) (wss X A2) (wss Y A2)) (wa (wne X c0) (wne Y c0))) (wceq (co X Y c_pl) (crab p (wrex q (wrex r (wbr (cv p) (co (cv q) (cv r) c_or) c_le) Y) X) A2)) $;

--| Condition implying membership in a projective subspace sum. (Contributed by NM, 8-Jan-2012.)
theorem elpaddri (A2 c_pl Q R S c_or K c_le X Y: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (w3a (w3a (wcel K clat) (wss X A2) (wss Y A2)) (wa (wcel Q X) (wcel R Y)) (wa (wcel S A2) (wbr S (co Q R c_or) c_le))) (wcel S (co X Y c_pl)) $;

--| Condition implying membership in a projective subspace sum with a point. (Contributed by NM, 1-Feb-2012.) (New usage is discouraged.)
theorem elpaddatriN (A2 c_pl Q R S c_or K c_le X: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (w3a (wcel K clat) (wss X A2) (wcel Q A2)) (w3a (wcel R X) (wcel S A2) (wbr S (co R Q c_or) c_le))) (wcel S (co X (csn Q) c_pl)) $;

--| Membership in a projective subspace sum with a point. (Contributed by NM, 29-Jan-2012.)
theorem elpaddat {p: setvar} (A2: class) (c_pl: class p) (Q S c_or K c_le X: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (w3a (wcel K clat) (wss X A2) (wcel Q A2)) (wne X c0)) (wb (wcel S (co X (csn Q) c_pl)) (wa (wcel S A2) (wrex p (wbr S (co (cv p) Q c_or) c_le) X))) $;

--| Consequence of membership in a projective subspace sum with a point. (Contributed by NM, 2-Feb-2012.) (New usage is discouraged.)
theorem elpaddatiN {p: setvar} (A2: class) (c_pl: class p) (Q R c_or K c_le X: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (w3a (wcel K clat) (wss X A2) (wcel Q A2)) (wa (wne X c0) (wcel R (co X (csn Q) c_pl)))) (wrex p (wbr R (co (cv p) Q c_or) c_le) X) $;

--| Membership in a projective subspace sum of two points. (Contributed by NM, 29-Jan-2012.)
theorem elpadd2at (A2 c_pl Q R S c_or K c_le: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (w3a (wcel K clat) (wcel Q A2) (wcel R A2)) (wb (wcel S (co (csn Q) (csn R) c_pl)) (wa (wcel S A2) (wbr S (co Q R c_or) c_le))) $;

--| Membership in a projective subspace sum of two points. (Contributed by NM, 8-Mar-2012.)
theorem elpadd2at2 (A2 c_pl Q R S c_or K c_le: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (wcel K clat) (w3a (wcel Q A2) (wcel R A2) (wcel S A2))) (wb (wcel S (co (csn Q) (csn R) c_pl)) (wbr S (co Q R c_or) c_le)) $;

--| Projective subspace sum includes the set union of its arguments. (Contributed by NM, 12-Jan-2012.) (New usage is discouraged.)
theorem paddunssN (A2 B2 c_pl K X Y: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (w3a (wcel K B2) (wss X A2) (wss Y A2)) (wss (cun X Y) (co X Y c_pl)) $;

--| Member of projective subspace sum with at least one empty set. (Contributed by NM, 29-Dec-2011.)
theorem elpadd0 (A2 B2 c_pl S K X Y: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (w3a (wcel K B2) (wss X A2) (wss Y A2)) (wn (wa (wne X c0) (wne Y c0)))) (wb (wcel S (co X Y c_pl)) (wo (wcel S X) (wcel S Y))) $;

--| Projective subspace sum with at least one empty set. (Contributed by NM, 11-Jan-2012.)
theorem paddval0 (A2 B2 c_pl K X Y: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (w3a (wcel K B2) (wss X A2) (wss Y A2)) (wn (wa (wne X c0) (wne Y c0)))) (wceq (co X Y c_pl) (cun X Y)) $;

--| Projective subspace sum with an empty set. (Contributed by NM, 11-Jan-2012.)
theorem padd01 (A2 B2 c_pl K X: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (wcel K B2) (wss X A2)) (wceq (co X c0 c_pl) X) $;

--| Projective subspace sum with an empty set. (Contributed by NM, 11-Jan-2012.)
theorem padd02 (A2 B2 c_pl K X: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (wcel K B2) (wss X A2)) (wceq (co c0 X c_pl) X) $;

--| Projective subspace sum commutes. (Contributed by NM, 3-Jan-2012.)
theorem paddcom (A2 c_pl K X Y: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (w3a (wcel K clat) (wss X A2) (wss Y A2)) (wceq (co X Y c_pl) (co Y X c_pl)) $;

--| A projective subspace sum is a set of atoms. (Contributed by NM, 3-Jan-2012.)
theorem paddssat (A2 B2 c_pl K X Y: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (w3a (wcel K B2) (wss X A2) (wss Y A2)) (wss (co X Y c_pl) A2) $;

--| A projective subspace sum is a superset of its first summand. ( ~ ssun1 analog.) (Contributed by NM, 3-Jan-2012.)
theorem sspadd1 (A2 B2 c_pl K X Y: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (w3a (wcel K B2) (wss X A2) (wss Y A2)) (wss X (co X Y c_pl)) $;

--| A projective subspace sum is a superset of its second summand. ( ~ ssun2 analog.) (Contributed by NM, 3-Jan-2012.)
theorem sspadd2 (A2 B2 c_pl K X Y: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (w3a (wcel K B2) (wss X A2) (wss Y A2)) (wss X (co Y X c_pl)) $;

--| Subset law for projective subspace sum. ( ~ unss1 analog.) (Contributed by NM, 7-Mar-2012.)
theorem paddss1 (A2 B2 c_pl K X Y Z: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (w3a (wcel K B2) (wss Y A2) (wss Z A2)) (wi (wss X Y) (wss (co X Z c_pl) (co Y Z c_pl))) $;

--| Subset law for projective subspace sum. ( ~ unss2 analog.) (Contributed by NM, 7-Mar-2012.)
theorem paddss2 (A2 B2 c_pl K X Y Z: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (w3a (wcel K B2) (wss Y A2) (wss Z A2)) (wi (wss X Y) (wss (co Z X c_pl) (co Z Y c_pl))) $;

--| Subset law for projective subspace sum. ( ~ unss12 analog.) (Contributed by NM, 7-Mar-2012.)
theorem paddss12 (A2 B2 c_pl K W X Y Z: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (w3a (wcel K B2) (wss Y A2) (wss W A2)) (wi (wa (wss X Y) (wss Z W)) (wss (co X Z c_pl) (co Y W c_pl))) $;

--| Lemma for ~ paddass . (Contributed by NM, 8-Jan-2012.)
theorem paddasslem1 (x3 y1: setvar) (A2 c_or K c_le: class) (r: setvar):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (w3a (wcel K chlt) (w3a (wcel (cv x3) A2) (wcel (cv r) A2) (wcel (cv y1) A2)) (wne (cv x3) (cv y1))) (wn (wbr (cv r) (co (cv x3) (cv y1) c_or) c_le))) (wn (wbr (cv x3) (co (cv r) (cv y1) c_or) c_le)) $;

--| Lemma for ~ paddass . (Contributed by NM, 8-Jan-2012.)
theorem paddasslem2 (x3 y1 z: setvar) (A2 c_or K c_le: class) (r: setvar):
  $ wceq c_le (cfv K cple) $ >

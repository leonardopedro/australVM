theorem _1pneg1e0:
  $ wceq (co c1 (cneg c1) caddc) cc0 $;

--| 0 minus 0 equals 0. (Contributed by David A. Wheeler, 8-Dec-2018.)
theorem _0m0e0:
  $ wceq (co cc0 cc0 cmin) cc0 $;

--| 1 - 0 = 1. (Contributed by David A. Wheeler, 8-Dec-2018.)
theorem _1m0e1:
  $ wceq (co c1 cc0 cmin) c1 $;

--| 0 + 1 = 1. (Contributed by David A. Wheeler, 7-Jul-2016.)
theorem _0p1e1:
  $ wceq (co cc0 c1 caddc) c1 $;

--| Function value at ` N + 1 ` with ` N ` replaced by ` 0 ` . Technical theorem to be used to reduce the size of a significant number of proofs. (Contributed by AV, 13-Aug-2022.)
theorem fv0p1e1 (F N: class):
  $ wi (wceq N cc0) (wceq (cfv (co N c1 caddc) F) (cfv c1 F)) $;

--| 1 + 0 = 1. (Contributed by David A. Wheeler, 8-Dec-2018.)
theorem _1p0e1:
  $ wceq (co c1 cc0 caddc) c1 $;

--| 1 + 1 = 2. (Contributed by NM, 1-Apr-2008.)
theorem _1p1e2:
  $ wceq (co c1 c1 caddc) c2 $;

--| 2 - 1 = 1. The result is on the right-hand-side to be consistent with similar proofs like ~ 4p4e8 . (Contributed by David A. Wheeler, 4-Jan-2017.) (Proof shortened by Umit Teoman Dogan, 10-Jun-2026.)
theorem _2m1e1:
  $ wceq (co c2 c1 cmin) c1 $;


  $ wceq T (cif (wrex x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2) (cun (crio x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2)) c1o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv u) (cv v) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) B2)) B2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv u) (cv v) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) B2) (wceq (cfv (cv g2) (cv u)) (cv x3))) B2)))) $ >

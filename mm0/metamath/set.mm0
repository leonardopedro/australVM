  $ wi ph (wne (cfv Y (co E G c_pl)) c_0) $ >
  $ wi ph (wceq B2 (cfv U c0g)) $ >
  $ wi ph (wss (cfv G L) (cfv (co E G c_pl) L)) $;

--| Lemma for ~ lclkr . Thus, the sum has a closed kernel when ` B ` is zero. (Contributed by NM, 18-Jan-2015.)
theorem lclkrlem2s (ph: wff) (B2 D c_pl c_po S c_x c_xp U E F G H I K L c_mi N c_pe V W X Y c_0: class):

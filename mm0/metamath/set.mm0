  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq O (cmpt h T (cres cid B2)) $ >
  $ wceq F (cfv U csca) $ >
  $ wceq J (cfv F cinvr) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq G (crio h (wceq (cfv P (cv h)) (cfv P (cfv (cv f2) (cfv (cv s1) J)))) T) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel (cv f2) T) (wcel (cv s1) E)) (wne (cv s1) O)) (wb (wa (wceq (cv i) (cfv G (cv p))) (wcel (cv p) E)) (wa (wa (wcel (cv i) T) (wcel (cv p) E)) (wrex t (wa (wceq (cv i) (cfv (cv f2) (cv t))) (wceq (cv p) (ccom (cv t) (cv s1)))) E))) $;

--| Lemma for ~ dih1dimat . (Contributed by NM, 10-Apr-2014.)
theorem dih1dimatlem {f2 h s1: setvar} (A2: class f2 h s1) (B2 C: class f2 s1) (D: class f2 h s1) (P: class f2 s1) (R S: class f2 h s1) (T: class) (c_x: class f2 h s1) (U: class) (E: class h) (F G: class f2 h s1) (H: class) (I: class h) (J: class f2 s1) (K: class) (c_le: class f2 s1) (N: class h) (O: class f2 h s1) (V: class h) (W: class) (c_0: class f2 h s1):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq C (cfv K catm) $ >
  $ wceq P (cfv W (cfv K coc)) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq O (cmpt h T (cres cid B2)) $ >
  $ wceq F (cfv U csca) $ >
  $ wceq J (cfv F cinvr) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq G (crio h (wceq (cfv P (cv h)) (cfv P (cfv (cv f2) (cfv (cv s1) J)))) T) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel D A2)) (wcel D (crn I)) $;

--| Any 1-dimensional subspace is a value of isomorphism H. (Contributed by NM, 11-Apr-2014.)
theorem dih1dimat (A2 P U H I K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel P A2)) (wcel P (crn I)) $;

--| The span of a vector belongs to the range of isomorphism H. (Contributed by NM, 27-Apr-2014.)
theorem dihlsprn (U H I K N V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel X V)) (wcel (cfv (csn X) N) (crn I)) $;

--| A subspace included in a 1-dim subspace belongs to the range of isomorphism H. (Contributed by NM, 26-Apr-2014.) (New usage is discouraged.)
theorem dihlspsnssN (S T U H I K N V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel X V) (wss T (cfv (csn X) N))) (wb (wcel T S) (wcel T (crn I))) $;

--| The inverse isomorphism H of the span of a singleton is a Hilbert lattice atom. (Contributed by NM, 27-Apr-2014.)
theorem dihlspsnat (A2 U H I K N V W X c_0: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel X V) (wne X c_0)) (wcel (cfv (cfv (csn X) N) (ccnv I)) A2) $;

--| The isomorphism H of an atom is a 1-dim subspace. (Contributed by NM, 28-Apr-2014.)
theorem dihatlat (A2 Q U H I K L W: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq L (cfv U clsa) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel Q A2)) (wcel (cfv Q I) L) $;

--| There exists at least one atom in the subspaces of vector space H. (Contributed by NM, 12-Aug-2014.)
theorem dihat (ph: wff) (A2 P U H I K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq P (cfv W (cfv K coc)) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel (cfv P I) A2) $;

--| The value of isomorphism H at the fiducial atom ` P ` is determined by the vector ` <. 0 , S >. ` (the zero translation ~ ltrnid and a nonzero member of the endomorphism ring). In particular, ` S ` can be replaced with the ring unity ` ( _I |`` T ) ` . (Contributed by NM, 26-Aug-2014.) (New usage is discouraged.)
theorem dihpN {f2: setvar} (ph: wff f2) (B2 P: class) (S: class f2) (T: class) (U E: class f2) (H: class) (I: class f2) (K: class) (N O: class f2) (W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq P (cfv W (cfv K coc)) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq O (cmpt f2 T (cres cid B2)) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq N (cfv U clspn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wa (wcel S E) (wne S O)) $ >
  $ wi ph (wceq (cfv P I) (cfv (csn (cop (cres cid B2) S)) N)) $;

--| The reverse isomorphism H of a 1-dim subspace is an atom. (Contributed by NM, 28-Apr-2014.)
theorem dihlatat (A2 Q U H I K L W: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq L (cfv U clsa) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel Q L)) (wcel (cfv Q (ccnv I)) A2) $;

--| There is a nonzero vector that maps to every lattice atom. (Contributed by NM, 16-Aug-2014.)
theorem dihatexv {x3: setvar} (ph: wff) (A2 B2 Q: class) (U H: class x3) (I K N V W: class) (c_0: class x3):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel Q B2) $ >
  $ wi ph (wb (wcel Q A2) (wrex x3 (wceq (cfv Q I) (cfv (csn (cv x3)) N)) (cdif V (csn c_0)))) $;

--| There is a nonzero vector that maps to every lattice atom. (Contributed by NM, 17-Aug-2014.)
theorem dihatexv2 {x3: setvar} (ph: wff) (A2 Q: class) (U H: class x3) (I K N V W: class) (c_0: class x3):
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wb (wcel Q A2) (wrex x3 (wceq Q (cfv (cfv (csn (cv x3)) N) (ccnv I))) (cdif V (csn c_0)))) $;

--| Isomorphism H of a lattice glb. (Contributed by NM, 9-Apr-2014.)
theorem dihglblem6 {x3: setvar} (A2: class x3) (B2 D P S: class) (U: class x3) (G H I K c_le c_an W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq G (cfv K cglb) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq P (cfv U clss) $ >
  $ wceq D (cfv U clsa) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wss S B2) (wne S c0))) (wceq (cfv (cfv S G) I) (ciin x3 S (cfv (cv x3) I))) $;

--| Isomorphism H of a lattice glb. (Contributed by NM, 11-Apr-2014.)
theorem dihglb {x3: setvar} (B2 S G H I K W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq G (cfv K cglb) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wss S B2) (wne S c0))) (wceq (cfv (cfv S G) I) (ciin x3 S (cfv (cv x3) I))) $;

--| Isomorphism H of a lattice glb. (Contributed by NM, 11-Apr-2014.)
theorem dihglb2 {x3 y1: setvar} (B2 S: class) (U G: class x3 y1) (H: class x3) (I K: class) (V W: class x3):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq G (cfv K cglb) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wss S V)) (wceq (cfv (cfv (crab x3 (wss S (cfv (cv x3) I)) B2) G) I) (cint (crab y1 (wss S (cv y1)) (crn I)))) $;

--| Isomorphism H of a lattice meet. (Contributed by NM, 13-Apr-2014.)
theorem dihmeet (B2 H I K c_an W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wcel X B2) (wcel Y B2)) (wceq (cfv (co X Y c_an) I) (cin (cfv X I) (cfv Y I))) $;

--| The intersection of closed subspaces (the range of isomorphism H) is a closed subspace. (Contributed by NM, 14-Apr-2014.)
theorem dihintcl (S H I K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wss S (crn I)) (wne S c0))) (wcel (cint S) (crn I)) $;

--| Closure of closed subspace meet for ` DVecH ` vector space. (Contributed by NM, 5-Aug-2014.)
theorem dihmeetcl (H I K W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel X (crn I)) (wcel Y (crn I)))) (wcel (cin X Y) (crn I)) $;

--| Reverse isomorphism H of a closed subspace intersection. (Contributed by NM, 15-Jan-2015.)
theorem dihmeet2 (ph: wff) (H I K c_an W X Y: class):
  $ wceq c_an (cfv K cmee) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (crn I)) $ >
  $ wi ph (wcel Y (crn I)) $ >
  $ wi ph (wceq (cfv (cin X Y) (ccnv I)) (co (cfv X (ccnv I)) (cfv Y (ccnv I)) c_an)) $;

--| Extend class notation with subspace orthocomplement for ` DVecH ` vector space.
term coch: class;

--| Define subspace orthocomplement for ` DVecH ` vector space. Temporarily, we are using the range of the isomorphism instead of the set of closed subspaces. Later, when inner product is introduced, we will show that these are the same. (Contributed by NM, 14-Mar-2014.)
axiom df_doch {x3 y1 w k: setvar}:
  $ wceq coch (cmpt k cvv (cmpt w (cfv (cv k) clh) (cmpt x3 (cpw (cfv (cfv (cv w) (cfv (cv k) cdvh)) cbs)) (cfv (cfv (cfv (crab y1 (wss (cv x3) (cfv (cv y1) (cfv (cv w) (cfv (cv k) cdih)))) (cfv (cv k) cbs)) (cfv (cv k) cglb)) (cfv (cv k) coc)) (cfv (cv w) (cfv (cv k) cdih)))))) $;

--| Subspace orthocomplement for ` DVecH ` vector space. (Contributed by NM, 14-Mar-2014.)
theorem dochffval {x3 y1 w: setvar} (B2: class x3 w) (G: class x3 y1 w) (H: class x3 y1) (K: class) (c_pe V: class x3 y1 w):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq G (cfv K cglb) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wcel K V) (wceq (cfv K coch) (cmpt w H (cmpt x3 (cpw (cfv (cfv (cv w) (cfv K cdvh)) cbs)) (cfv (cfv (cfv (crab y1 (wss (cv x3) (cfv (cv y1) (cfv (cv w) (cfv K cdih)))) B2) G) c_pe) (cfv (cv w) (cfv K cdih)))))) $;

--| Subspace orthocomplement for ` DVecH ` vector space. (Contributed by NM, 14-Mar-2014.)
theorem dochfval {x3 y1: setvar} (B2: class x3) (U G H I: class x3 y1) (K: class) (N c_pe: class x3 y1) (V: class y1) (W: class) (X: class x3 y1):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq G (cfv K cglb) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq N (cfv W (cfv K coch)) $ >
  $ wi (wa (wcel K X) (wcel W H)) (wceq N (cmpt x3 (cpw V) (cfv (cfv (cfv (crab y1 (wss (cv x3) (cfv (cv y1) I)) B2) G) c_pe) I))) $;

--| Subspace orthocomplement for ` DVecH ` vector space. (Contributed by NM, 14-Mar-2014.)
theorem dochval {y1: setvar} (B2: class) (U G H I: class y1) (K: class) (N c_pe V: class y1) (W X: class) (Y: class y1):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq G (cfv K cglb) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq N (cfv W (cfv K coch)) $ >
  $ wi (wa (wa (wcel K Y) (wcel W H)) (wss X V)) (wceq (cfv X N) (cfv (cfv (cfv (crab y1 (wss X (cfv (cv y1) I)) B2) G) c_pe) I)) $;

--| Subspace orthocomplement for ` DVecH ` vector space. (Contributed by NM, 14-Apr-2014.)
theorem dochval2 {z: setvar} (U: class z) (H I K: class) (N c_pe: class z) (V W X: class):
  $ wceq c_pe (cfv K coc) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq N (cfv W (cfv K coch)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wss X V)) (wceq (cfv X N) (cfv (cfv (cfv (cint (crab z (wss X (cv z)) (crn I))) (ccnv I)) c_pe) I)) $;

--| Closure of subspace orthocomplement for ` DVecH ` vector space. (Contributed by NM, 9-Mar-2014.)
theorem dochcl (U H I K c_pe V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wss X V)) (wcel (cfv X c_pe) (crn I)) $;

--| A subspace orthocomplement is a subspace of the ` DVecH ` vector space. (Contributed by NM, 22-Jul-2014.)
theorem dochlss (S U H K c_pe V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wss X V)) (wcel (cfv X c_pe) S) $;

--| A subspace orthocomplement belongs to the ` DVecH ` vector space. (Contributed by NM, 22-Jul-2014.)
theorem dochssv (U H K c_pe V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wss X V)) (wss (cfv X c_pe) V) $;

--| Domain and codomain of the subspace orthocomplement for the ` DVecH ` vector space. (Contributed by NM, 27-Dec-2014.) (New usage is discouraged.)
theorem dochfN (ph: wff) (U H I K c_pe V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wf (cpw V) (crn I) c_pe) $;

--| Orthocomplement of a closed subspace. (Contributed by NM, 14-Mar-2014.)
theorem dochvalr (H I K N c_pe W X: class):
  $ wceq c_pe (cfv K coc) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq N (cfv W (cfv K coch)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel X (crn I))) (wceq (cfv X N) (cfv (cfv (cfv X (ccnv I)) c_pe) I)) $;

--| Orthocomplement of the zero subspace. (Contributed by NM, 19-Jun-2014.)
theorem doch0 (U H K c_pe V W c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wceq (cfv (csn c_0) c_pe) V) $;

--| Orthocomplement of the unit subspace (all vectors). (Contributed by NM, 19-Jun-2014.)
theorem doch1 (U H K c_pe V W c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wceq (cfv V c_pe) (csn c_0)) $;

--| The zero subspace is closed. (Contributed by NM, 16-Feb-2015.)
theorem dochoc0 (ph: wff) (U H K c_pe W c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wceq (cfv (cfv (csn c_0) c_pe) c_pe) (csn c_0)) $;

--| The unit subspace (all vectors) is closed. (Contributed by NM, 16-Feb-2015.)
theorem dochoc1 (ph: wff) (U H K c_pe V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wceq (cfv (cfv V c_pe) c_pe) V) $;

--| Orthocomplement of a closed subspace. (Contributed by NM, 21-Jul-2014.)
theorem dochvalr2 (B2 H I K N c_pe W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_pe (cfv K coc) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq N (cfv W (cfv K coch)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel X B2)) (wceq (cfv (cfv X I) N) (cfv (cfv X c_pe) I)) $;

--| Orthocomplement of a closed subspace. (Contributed by NM, 15-Jan-2015.)
theorem dochvalr3 (ph: wff) (H I K N c_pe W X: class):
  $ wceq c_pe (cfv K coc) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq N (cfv W (cfv K coch)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (crn I)) $ >
  $ wi ph (wceq (cfv (cfv X (ccnv I)) c_pe) (cfv (cfv X N) (ccnv I))) $;

--| Double orthocomplement for ` DVecH ` vector space. (Contributed by NM, 26-Jul-2014.)
theorem doch2val2 {z: setvar} (ph: wff z) (U: class z) (H I K: class) (c_pe: class z) (V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wss X V) $ >
  $ wi ph (wceq (cfv (cfv X c_pe) c_pe) (cint (crab z (wss X (cv z)) (crn I)))) $;

--| Subset law for orthocomplement. (Contributed by NM, 16-Apr-2014.)
theorem dochss (U H K c_pe V W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wss Y V) (wss X Y)) (wss (cfv Y c_pe) (cfv X c_pe)) $;

--| Double negative law for orthocomplement of an arbitrary set of vectors. (Contributed by NM, 16-Apr-2014.)
theorem dochocss (U H K c_pe V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wss X V)) (wss X (cfv (cfv X c_pe) c_pe)) $;

--| Double negative law for orthocomplement of a closed subspace. (Contributed by NM, 14-Mar-2014.)
theorem dochoc (H I K c_pe W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel X (crn I))) (wceq (cfv (cfv X c_pe) c_pe) X) $;

--| If a set of vectors is included in a closed set, so is its closure. (Contributed by NM, 17-Jun-2015.)
theorem dochsscl (ph: wff) (U H I K c_pe V W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wss X V) $ >
  $ wi ph (wcel Y (crn I)) $ >
  $ wi ph (wb (wss X Y) (wss (cfv (cfv X c_pe) c_pe) Y)) $;

--| A set of vectors is closed iff it equals its double orthocomplent. (Contributed by NM, 1-Jan-2015.)
theorem dochoccl (ph: wff) (U H I K c_pe V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wss X V) $ >
  $ wi ph (wb (wcel X (crn I)) (wceq (cfv (cfv X c_pe) c_pe) X)) $;

--| Ordering law for orthocomplement. (Contributed by NM, 12-Aug-2014.)
theorem dochord (ph: wff) (H I K c_pe W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (crn I)) $ >
  $ wi ph (wcel Y (crn I)) $ >
  $ wi ph (wb (wss X Y) (wss (cfv Y c_pe) (cfv X c_pe))) $;

--| Ordering law for orthocomplement. (Contributed by NM, 29-Oct-2014.) (New usage is discouraged.)
theorem dochord2N (ph: wff) (H I K c_pe W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (crn I)) $ >
  $ wi ph (wcel Y (crn I)) $ >
  $ wi ph (wb (wss (cfv X c_pe) Y) (wss (cfv Y c_pe) X)) $;

--| Ordering law for orthocomplement. (Contributed by NM, 9-Mar-2015.)
theorem dochord3 (ph: wff) (H I K c_pe W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (crn I)) $ >
  $ wi ph (wcel Y (crn I)) $ >
  $ wi ph (wb (wss X (cfv Y c_pe)) (wss Y (cfv X c_pe))) $;

--| Orthocomplement is one-to-one. (Contributed by NM, 12-Aug-2014.)
theorem doch11 (ph: wff) (H I K c_pe W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (crn I)) $ >
  $ wi ph (wcel Y (crn I)) $ >
  $ wi ph (wb (wceq (cfv X c_pe) (cfv Y c_pe)) (wceq X Y)) $;

--| Strict ordering law for orthocomplement. (Contributed by NM, 12-Aug-2014.) (New usage is discouraged.)
theorem dochsordN (ph: wff) (H I K c_pe W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (crn I)) $ >
  $ wi ph (wcel Y (crn I)) $ >
  $ wi ph (wb (wpss X Y) (wpss (cfv Y c_pe) (cfv X c_pe))) $;

--| An orthocomplement is nonzero iff the double orthocomplement is not the whole vector space. (Contributed by NM, 1-Jan-2015.)
theorem dochn0nv (ph: wff) (U H K c_pe V W X c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wss X V) $ >
  $ wi ph (wb (wne (cfv X c_pe) (csn c_0)) (wne (cfv (cfv X c_pe) c_pe) V)) $;

--| Version of ~ dihoml4 with closed subspaces. (Contributed by NM, 15-Jan-2015.)
theorem dihoml4c (ph: wff) (H I K c_pe W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (crn I)) $ >
  $ wi ph (wcel Y (crn I)) $ >
  $ wi ph (wss X Y) $ >
  $ wi ph (wceq (cin (cfv (cin (cfv X c_pe) Y) c_pe) Y) X) $;

--| Orthomodular law for constructed vector space H. Lemma 3.3(1) in [Holland95] p. 215. ( ~ poml4N analog.) (Contributed by NM, 15-Jan-2015.)
theorem dihoml4 (ph: wff) (S U H K c_pe W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wcel Y S) $ >
  $ wi ph (wceq (cfv (cfv Y c_pe) c_pe) Y) $ >
  $ wi ph (wss X Y) $ >
  $ wi ph (wceq (cin (cfv (cin (cfv X c_pe) Y) c_pe) Y) (cfv (cfv X c_pe) c_pe)) $;

--| The span of a set of vectors is included in their double orthocomplement. (Contributed by NM, 26-Jul-2014.)
theorem dochspss (ph: wff) (U H K N c_pe V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq N (cfv U clspn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wss X V) $ >
  $ wi ph (wss (cfv X N) (cfv (cfv X c_pe) c_pe)) $;

--| The span of an orthocomplement equals the orthocomplement of the span. (Contributed by NM, 7-Aug-2014.)
theorem dochocsp (ph: wff) (U H K N c_pe V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq N (cfv U clspn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wss X V) $ >
  $ wi ph (wceq (cfv (cfv X N) c_pe) (cfv X c_pe)) $;

--| The span of an orthocomplement equals the orthocomplement of the span. (Contributed by NM, 7-Aug-2014.) (New usage is discouraged.)
theorem dochspocN (ph: wff) (U H K N c_pe V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq N (cfv U clspn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wss X V) $ >
  $ wi ph (wceq (cfv (cfv X c_pe) N) (cfv (cfv X N) c_pe)) $;

--| The double orthocomplement of a singleton is its span. (Contributed by NM, 13-Jan-2015.)
theorem dochocsn (ph: wff) (U H K N c_pe V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq N (cfv U clspn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wceq (cfv (cfv (csn X) c_pe) c_pe) (cfv (csn X) N)) $;

--| Swap vectors in an orthocomplement of a singleton. (Contributed by NM, 17-Jun-2015.)
theorem dochsncom (ph: wff) (U H K c_pe V W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wb (wcel X (cfv (csn Y) c_pe)) (wcel Y (cfv (csn X) c_pe))) $;

--| The double orthocomplement of an atom is an atom. (Contributed by NM, 29-Oct-2014.)
theorem dochsat (ph: wff) (A2 Q S U H K c_pe W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel Q S) $ >
  $ wi ph (wb (wcel (cfv (cfv Q c_pe) c_pe) A2) (wcel Q A2)) $;

--| If a hyperplane is not closed, its closure equals the vector space. (Contributed by NM, 29-Oct-2014.)
theorem dochshpncl (ph: wff) (U H K c_pe V W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq Y (cfv U clsh) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X Y) $ >
  $ wi ph (wb (wne (cfv (cfv X c_pe) c_pe) X) (wceq (cfv (cfv X c_pe) c_pe) V)) $;

--| Equivalent conditions for the closure of a kernel to be a hyperplane. (Contributed by NM, 29-Oct-2014.)
theorem dochlkr (ph: wff) (U F G H K L c_pe W Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq Y (cfv U clsh) $ >
  $ wceq L (cfv U clk) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wb (wcel (cfv (cfv (cfv G L) c_pe) c_pe) Y) (wa (wceq (cfv (cfv (cfv G L) c_pe) c_pe) (cfv G L)) (wcel (cfv G L) Y))) $;

--| The closure of a kernel is a hyperplane iff it doesn't contain all vectors. (Contributed by NM, 1-Nov-2014.)
theorem dochkrshp (ph: wff) (U F G H K L c_pe V W Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq Y (cfv U clsh) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wb (wne (cfv (cfv (cfv G L) c_pe) c_pe) V) (wcel (cfv (cfv (cfv G L) c_pe) c_pe) Y)) $;

--| Properties of the closure of the kernel of a functional. (Contributed by NM, 1-Jan-2015.)
theorem dochkrshp2 (ph: wff) (U F G H K L c_pe V W Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq Y (cfv U clsh) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wb (wne (cfv (cfv (cfv G L) c_pe) c_pe) V) (wa (wceq (cfv (cfv (cfv G L) c_pe) c_pe) (cfv G L)) (wcel (cfv G L) Y))) $;

--| Properties of the closure of the kernel of a functional. (Contributed by NM, 1-Jan-2015.)
theorem dochkrshp3 (ph: wff) (U F G H K L c_pe V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wb (wne (cfv (cfv (cfv G L) c_pe) c_pe) V) (wa (wceq (cfv (cfv (cfv G L) c_pe) c_pe) (cfv G L)) (wne (cfv G L) V))) $;

--| Properties of the closure of the kernel of a functional. (Contributed by NM, 1-Jan-2015.)
theorem dochkrshp4 (ph: wff) (U F G H K L c_pe V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wb (wceq (cfv (cfv (cfv G L) c_pe) c_pe) (cfv G L)) (wo (wne (cfv (cfv (cfv G L) c_pe) c_pe) V) (wceq (cfv G L) V))) $;

--| De Morgan-like law for subspace orthocomplement. (Contributed by NM, 5-Aug-2014.)
theorem dochdmj1 (U H K c_pe V W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wss X V) (wss Y V)) (wceq (cfv (cun X Y) c_pe) (cin (cfv X c_pe) (cfv Y c_pe))) $;

--| Law of noncontradiction. The intersection of a subspace and its orthocomplement is the zero subspace. (Contributed by NM, 16-Apr-2014.)
theorem dochnoncon (S U H K c_pe W X c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wcel X S)) (wceq (cin X (cfv X c_pe)) (csn c_0)) $;

--| A nonzero member of a subspace doesn't belong to the orthocomplement of the subspace. (Contributed by NM, 28-Feb-2015.)
theorem dochnel2 (ph: wff) (S T U H K c_pe W X c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel T S) $ >
  $ wi ph (wcel X (cdif T (csn c_0))) $ >
  $ wi ph (wn (wcel X (cfv T c_pe))) $;

--| A nonzero vector doesn't belong to the orthocomplement of its singleton. (Contributed by NM, 27-Oct-2014.)
theorem dochnel (ph: wff) (U H K c_pe V W X c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wn (wcel X (cfv (csn X) c_pe))) $;

--| Extend class notation with subspace join for ` DVecH ` vector space.
term cdjh: class;

--| Define (closed) subspace join for ` DVecH ` vector space. (Contributed by NM, 19-Jul-2014.)
axiom df_djh {x3 y1 w k: setvar}:
  $ wceq cdjh (cmpt k cvv (cmpt w (cfv (cv k) clh) (cmpo x3 y1 (cpw (cfv (cfv (cv w) (cfv (cv k) cdvh)) cbs)) (cpw (cfv (cfv (cv w) (cfv (cv k) cdvh)) cbs)) (cfv (cin (cfv (cv x3) (cfv (cv w) (cfv (cv k) coch))) (cfv (cv y1) (cfv (cv w) (cfv (cv k) coch)))) (cfv (cv w) (cfv (cv k) coch)))))) $;

--| Subspace join for ` DVecH ` vector space. (Contributed by NM, 19-Jul-2014.)
theorem djhffval {x3 y1 w: setvar} (H: class x3 y1) (K: class) (X: class x3 y1 w):
  $ wceq H (cfv K clh) $ >
  $ wi (wcel K X) (wceq (cfv K cdjh) (cmpt w H (cmpo x3 y1 (cpw (cfv (cfv (cv w) (cfv K cdvh)) cbs)) (cpw (cfv (cfv (cv w) (cfv K cdvh)) cbs)) (cfv (cin (cfv (cv x3) (cfv (cv w) (cfv K coch))) (cfv (cv y1) (cfv (cv w) (cfv K coch)))) (cfv (cv w) (cfv K coch)))))) $;

--| Subspace join for ` DVecH ` vector space. (Contributed by NM, 19-Jul-2014.)
theorem djhfval {x3 y1: setvar} (U H c_or: class x3 y1) (K: class) (c_pe: class x3 y1) (V W: class) (X: class x3 y1):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq c_or (cfv W (cfv K cdjh)) $ >
  $ wi (wa (wcel K X) (wcel W H)) (wceq c_or (cmpo x3 y1 (cpw V) (cpw V) (cfv (cin (cfv (cv x3) c_pe) (cfv (cv y1) c_pe)) c_pe))) $;

--| Subspace join for ` DVecH ` vector space. (Contributed by NM, 19-Jul-2014.)
theorem djhval (U H c_or K c_pe V W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq c_or (cfv W (cfv K cdjh)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wss X V) (wss Y V))) (wceq (co X Y c_or) (cfv (cin (cfv X c_pe) (cfv Y c_pe)) c_pe)) $;

--| Value of subspace join for ` DVecH ` vector space. (Contributed by NM, 6-Aug-2014.)
theorem djhval2 (U H c_or K c_pe V W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq c_or (cfv W (cfv K cdjh)) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (wss X V) (wss Y V)) (wceq (co X Y c_or) (cfv (cfv (cun X Y) c_pe) c_pe)) $;

--| Closure of subspace join for ` DVecH ` vector space. (Contributed by NM, 19-Jul-2014.)
theorem djhcl (U H I c_or K V W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_or (cfv W (cfv K cdjh)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wss X V) (wss Y V))) (wcel (co X Y c_or) (crn I)) $;

--| Transfer lattice join to ` DVecH ` vector space closed subspace join. (Contributed by NM, 19-Jul-2014.)
theorem djhlj (B2 H I J c_or K W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq J (cfv W (cfv K cdjh)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wa (wcel X B2) (wcel Y B2))) (wceq (cfv (co X Y c_or) I) (co (cfv X I) (cfv Y I) J)) $;

--| Lattice join in terms of ` DVecH ` vector space closed subspace join. (Contributed by NM, 17-Aug-2014.) (New usage is discouraged.)
theorem djhljjN (ph: wff) (B2 H I J c_or K W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq J (cfv W (cfv K cdjh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wceq (co X Y c_or) (cfv (co (cfv X I) (cfv Y I) J) (ccnv I))) $;

--| ` DVecH ` vector space closed subspace join in terms of lattice join. (Contributed by NM, 9-Aug-2014.)
theorem djhjlj (ph: wff) (H I J c_or K W X Y: class):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq J (cfv W (cfv K cdjh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (crn I)) $ >
  $ wi ph (wcel Y (crn I)) $ >
  $ wi ph (wceq (co X Y J) (cfv (co (cfv X (ccnv I)) (cfv Y (ccnv I)) c_or) I)) $;

--| ` DVecH ` vector space closed subspace join in terms of lattice join. (Contributed by NM, 17-Aug-2014.)
theorem djhj (ph: wff) (H I J c_or K W X Y: class):
  $ wceq c_or (cfv K cjn) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq J (cfv W (cfv K cdjh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (crn I)) $ >
  $ wi ph (wcel Y (crn I)) $ >
  $ wi ph (wceq (cfv (co X Y J) (ccnv I)) (co (cfv X (ccnv I)) (cfv Y (ccnv I)) c_or)) $;

--| Subspace join is commutative. (Contributed by NM, 8-Aug-2014.)
theorem djhcom (ph: wff) (U H c_or K V W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_or (cfv W (cfv K cdjh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wss X V) $ >
  $ wi ph (wss Y V) $ >
  $ wi ph (wceq (co X Y c_or) (co Y X c_or)) $;

--| Subspace span of union is a subset of subspace join. (Contributed by NM, 6-Aug-2014.)
theorem djhspss (ph: wff) (U H c_or K N V W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq c_or (cfv W (cfv K cdjh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wss X V) $ >
  $ wi ph (wss Y V) $ >
  $ wi ph (wss (cfv (cun X Y) N) (co X Y c_or)) $;

--| Subspace sum is a subset of subspace join. (Contributed by NM, 6-Aug-2014.)
theorem djhsumss (ph: wff) (c_po U H c_or K V W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq c_or (cfv W (cfv K cdjh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wss X V) $ >
  $ wi ph (wss Y V) $ >
  $ wi ph (wss (co X Y c_po) (co X Y c_or)) $;

--| The subspace sum of two isomorphisms of lattice elements is less than the isomorphism of their lattice join. (Contributed by NM, 23-Sep-2014.)
theorem dihsumssj (ph: wff) (B2 c_po U H I c_or K W X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wss (co (cfv X I) (cfv Y I) c_po) (cfv (co X Y c_or) I)) $;

--| Subspace union is a subset of subspace join. (Contributed by NM, 6-Aug-2014.) (New usage is discouraged.)
theorem djhunssN (ph: wff) (U H c_or K V W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_or (cfv W (cfv K cdjh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wss X V) $ >
  $ wi ph (wss Y V) $ >
  $ wi ph (wss (cun X Y) (co X Y c_or)) $;

--| De Morgan-like law for closed subspace orthocomplement. (Contributed by NM, 13-Jan-2015.)
theorem dochdmm1 (ph: wff) (U H I c_or K c_pe V W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq c_or (cfv W (cfv K cdjh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (crn I)) $ >
  $ wi ph (wcel Y (crn I)) $ >
  $ wi ph (wceq (cfv (cin X Y) c_pe) (co (cfv X c_pe) (cfv Y c_pe) c_or)) $;

--| Excluded middle property of ` DVecH ` vector space closed subspace join. (Contributed by NM, 22-Jul-2014.)
theorem djhexmid (U H c_or K c_pe V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq c_or (cfv W (cfv K cdjh)) $ >
  $ wi (wa (wa (wcel K chlt) (wcel W H)) (wss X V)) (wceq (co X (cfv X c_pe) c_or) V) $;

--| Closed subspace join with zero. (Contributed by NM, 9-Aug-2014.)
theorem djh01 (ph: wff) (U H I c_or K W X c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq c_or (cfv W (cfv K cdjh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (crn I)) $ >
  $ wi ph (wceq (co X (csn c_0) c_or) X) $;

--| Closed subspace join with zero. (Contributed by NM, 9-Aug-2014.)
theorem djh02 (ph: wff) (U H I c_or K W X c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq c_or (cfv W (cfv K cdjh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (crn I)) $ >
  $ wi ph (wceq (co (csn c_0) X c_or) X) $;

--| A closed subspace sum equals subspace join. ( ~ shjshseli analog.) (Contributed by NM, 13-Aug-2014.)
theorem djhlsmcl (ph: wff) (c_po S U H I c_or K V W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq c_or (cfv W (cfv K cdjh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wcel Y S) $ >
  $ wi ph (wb (wcel (co X Y c_po) (crn I)) (wceq (co X Y c_po) (co X Y c_or))) $;

--| A covering property. ( ~ cvrat42 analog.) (Contributed by NM, 17-Aug-2014.)
theorem djhcvat42 {z: setvar} (ph: wff) (S: class) (U H: class z) (I: class) (c_or: class z) (K N V W X Y: class) (c_0: class z):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq c_or (cfv W (cfv K cdjh)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel S (crn I)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel Y (cdif V (csn c_0))) $ >
  $ wi ph (wi (wa (wne S (csn c_0)) (wss (cfv (csn X) N) (co S (cfv (csn Y) N) c_or))) (wrex z (wa (wss (cfv (csn (cv z)) N) S) (wss (cfv (csn X) N) (co (cfv (csn (cv z)) N) (cfv (csn Y) N) c_or))) (cdif V (csn c_0)))) $;

--| Isomorphism H of lattice join of two atoms under the fiducial hyperplane. (Contributed by NM, 23-Sep-2014.)
theorem dihjatb (ph: wff) (A2 P c_po Q U H I c_or K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wa (wcel P A2) (wbr P W c_le)) $ >
  $ wi ph (wa (wcel Q A2) (wbr Q W c_le)) $ >
  $ wi ph (wceq (cfv (co P Q c_or) I) (co (cfv P I) (cfv Q I) c_po)) $;

--| Isomorphism H of lattice join of an element under the fiducial hyperplane with atom not under it. (Contributed by NM, 26-Aug-2014.)
theorem dihjatc (ph: wff) (A2 B2 P c_po U H I c_or K c_le W X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wa (wcel X B2) (wbr X W c_le)) $ >
  $ wi ph (wa (wcel P A2) (wn (wbr P W c_le))) $ >
  $ wi ph (wceq (cfv (co X P c_or) I) (co (cfv X I) (cfv P I) c_po)) $;

--| Lemma for isomorphism H of lattice join of two atoms not under the fiducial hyperplane. (Contributed by NM, 26-Sep-2014.)
theorem dihjatcclem1 (ph: wff) (A2 B2 P c_po Q U H I c_or K c_le c_an V W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq V (co (co P Q c_or) W c_an) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wa (wcel P A2) (wn (wbr P W c_le))) $ >
  $ wi ph (wa (wcel Q A2) (wn (wbr Q W c_le))) $ >
  $ wi ph (wceq (cfv (co P Q c_or) I) (co (co (cfv P I) (cfv Q I) c_po) (cfv V I) c_po)) $;

--| Lemma for isomorphism H of lattice join of two atoms not under the fiducial hyperplane. (Contributed by NM, 26-Sep-2014.)
theorem dihjatcclem2 (ph: wff) (A2 B2 P c_po Q U H I c_or K c_le c_an V W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq V (co (co P Q c_or) W c_an) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wa (wcel P A2) (wn (wbr P W c_le))) $ >
  $ wi ph (wa (wcel Q A2) (wn (wbr Q W c_le))) $ >
  $ wi ph (wss (cfv V I) (co (cfv P I) (cfv Q I) c_po)) $ >
  $ wi ph (wceq (cfv (co P Q c_or) I) (co (cfv P I) (cfv Q I) c_po)) $;

--| Lemma for ~ dihjatcc . (Contributed by NM, 28-Sep-2014.)
theorem dihjatcclem3 {d: setvar} (ph: wff d) (A2 B2 C: class) (D: class d) (P: class) (c_po: class d) (Q: class) (R: class d) (T: class) (U E G: class d) (H: class) (I c_or: class d) (K c_le: class) (c_an V: class d) (W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq V (co (co P Q c_or) W c_an) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wa (wcel P A2) (wn (wbr P W c_le))) $ >
  $ wi ph (wa (wcel Q A2) (wn (wbr Q W c_le))) $ >
  $ wceq C (cfv W (cfv K coc)) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq G (crio d (wceq (cfv C (cv d)) P) T) $ >
  $ wceq D (crio d (wceq (cfv C (cv d)) Q) T) $ >
  $ wi ph (wceq (cfv (ccom G (ccnv D)) R) V) $;

--| Lemma for isomorphism H of lattice join of two atoms not under the fiducial hyperplane. (Contributed by NM, 29-Sep-2014.)
theorem dihjatcclem4 {a b d: setvar} (ph: wff a b d) (A2 B2 C: class a b) (D: class a b d) (P: class a b) (c_po: class a b d) (Q: class a b) (R: class a b d) (T: class) (U: class a b d) (E: class d) (G: class a b d) (H: class a b) (I J c_or: class a b d) (K: class) (c_le: class a b) (c_an N V: class a b d) (W: class) (c_0: class a b d):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wceq V (co (co P Q c_or) W c_an) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wa (wcel P A2) (wn (wbr P W c_le))) $ >
  $ wi ph (wa (wcel Q A2) (wn (wbr Q W c_le))) $ >
  $ wceq C (cfv W (cfv K coc)) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq E (cfv W (cfv K ctendo)) $ >
  $ wceq G (crio d (wceq (cfv C (cv d)) P) T) $ >
  $ wceq D (crio d (wceq (cfv C (cv d)) Q) T) $ >
  $ wceq N (cmpt a E (cmpt d T (ccnv (cfv (cv d) (cv a))))) $ >
  $ wceq c_0 (cmpt d T (cres cid B2)) $ >
  $ wceq J (cmpo a b E E (cmpt d T (ccom (cfv (cv d) (cv a)) (cfv (cv d) (cv b))))) $ >
  $ wi ph (wss (cfv V I) (co (cfv P I) (cfv Q I) c_po)) $;

--| Isomorphism H of lattice join of two atoms not under the fiducial hyperplane. (Contributed by NM, 29-Sep-2014.)
theorem dihjatcc (ph: wff) (A2 P c_po Q U H I c_or K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wa (wcel P A2) (wn (wbr P W c_le))) $ >
  $ wi ph (wa (wcel Q A2) (wn (wbr Q W c_le))) $ >
  $ wi ph (wceq (cfv (co P Q c_or) I) (co (cfv P I) (cfv Q I) c_po)) $;

--| Isomorphism H of lattice join of two atoms. (Contributed by NM, 29-Sep-2014.)
theorem dihjat (ph: wff) (A2 P c_po Q U H I c_or K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq I (cfv W (cfv K cdih)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >

  $ wi (w3a (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wa (wne P Q) (wa (wcel R A2) (wn (wbr R W c_le)))) ps) (wb (wral s1 (wi (wa (wa (wn (wbr (cv s1) W c_le)) ph) (wceq (co (cv s1) (co R W c_an) c_or) R)) (wceq (cv z) (co N (co R W c_an) c_or))) A2) (wceq (cv z) (csb s1 R N))) $;


--| Lemma for surreal distribution. Expand the left hand side of the main expression. (Contributed by Scott Fenton, 8-Mar-2025.)
theorem addsdilem1 {a xL xR yL yR zL zR: setvar} (ph: wff a xL xR yL yR zL zR) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wceq (co A2 (co B2 C cadds) cmuls) (co (cun (cun (cab a (wrex xL (wrex yL (wceq (cv a) (co (co (co (cv xL) (co B2 C cadds) cmuls) (co A2 (co (cv yL) C cadds) cmuls) cadds) (co (cv xL) (co (cv yL) C cadds) cmuls) csubs)) (cfv B2 cleft)) (cfv A2 cleft))) (cab a (wrex xL (wrex zL (wceq (cv a) (co (co (co (cv xL) (co B2 C cadds) cmuls) (co A2 (co B2 (cv zL) cadds) cmuls) cadds) (co (cv xL) (co B2 (cv zL) cadds) cmuls) csubs)) (cfv C cleft)) (cfv A2 cleft)))) (cun (cab a (wrex xR (wrex yR (wceq (cv a) (co (co (co (cv xR) (co B2 C cadds) cmuls) (co A2 (co (cv yR) C cadds) cmuls) cadds) (co (cv xR) (co (cv yR) C cadds) cmuls) csubs)) (cfv B2 cright)) (cfv A2 cright))) (cab a (wrex xR (wrex zR (wceq (cv a) (co (co (co (cv xR) (co B2 C cadds) cmuls) (co A2 (co B2 (cv zR) cadds) cmuls) cadds) (co (cv xR) (co B2 (cv zR) cadds) cmuls) csubs)) (cfv C cright)) (cfv A2 cright))))) (cun (cun (cab a (wrex xL (wrex yR (wceq (cv a) (co (co (co (cv xL) (co B2 C cadds) cmuls) (co A2 (co (cv yR) C cadds) cmuls) cadds) (co (cv xL) (co (cv yR) C cadds) cmuls) csubs)) (cfv B2 cright)) (cfv A2 cleft))) (cab a (wrex xL (wrex zR (wceq (cv a) (co (co (co (cv xL) (co B2 C cadds) cmuls) (co A2 (co B2 (cv zR) cadds) cmuls) cadds) (co (cv xL) (co B2 (cv zR) cadds) cmuls) csubs)) (cfv C cright)) (cfv A2 cleft)))) (cun (cab a (wrex xR (wrex yL (wceq (cv a) (co (co (co (cv xR) (co B2 C cadds) cmuls) (co A2 (co (cv yL) C cadds) cmuls) cadds) (co (cv xR) (co (cv yL) C cadds) cmuls) csubs)) (cfv B2 cleft)) (cfv A2 cright))) (cab a (wrex xR (wrex zL (wceq (cv a) (co (co (co (cv xR) (co B2 C cadds) cmuls) (co A2 (co B2 (cv zL) cadds) cmuls) cadds) (co (cv xR) (co B2 (cv zL) cadds) cmuls) csubs)) (cfv C cleft)) (cfv A2 cright))))) ccuts)) $;

--| Lemma for surreal distribution. Expand the right hand side of the main expression. (Contributed by Scott Fenton, 8-Mar-2025.)
theorem addsdilem2 {a xL xR yL yR zL zR: setvar} (ph: wff a xL xR yL yR zL zR) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wceq (co (co A2 B2 cmuls) (co A2 C cmuls) cadds) (co (cun (cun (cab a (wrex xL (wrex yL (wceq (cv a) (co (co (co (co (cv xL) B2 cmuls) (co A2 (cv yL) cmuls) cadds) (co (cv xL) (cv yL) cmuls) csubs) (co A2 C cmuls) cadds)) (cfv B2 cleft)) (cfv A2 cleft))) (cab a (wrex xR (wrex yR (wceq (cv a) (co (co (co (co (cv xR) B2 cmuls) (co A2 (cv yR) cmuls) cadds) (co (cv xR) (cv yR) cmuls) csubs) (co A2 C cmuls) cadds)) (cfv B2 cright)) (cfv A2 cright)))) (cun (cab a (wrex xL (wrex zL (wceq (cv a) (co (co A2 B2 cmuls) (co (co (co (cv xL) C cmuls) (co A2 (cv zL) cmuls) cadds) (co (cv xL) (cv zL) cmuls) csubs) cadds)) (cfv C cleft)) (cfv A2 cleft))) (cab a (wrex xR (wrex zR (wceq (cv a) (co (co A2 B2 cmuls) (co (co (co (cv xR) C cmuls) (co A2 (cv zR) cmuls) cadds) (co (cv xR) (cv zR) cmuls) csubs) cadds)) (cfv C cright)) (cfv A2 cright))))) (cun (cun (cab a (wrex xL (wrex yR (wceq (cv a) (co (co (co (co (cv xL) B2 cmuls) (co A2 (cv yR) cmuls) cadds) (co (cv xL) (cv yR) cmuls) csubs) (co A2 C cmuls) cadds)) (cfv B2 cright)) (cfv A2 cleft))) (cab a (wrex xR (wrex yL (wceq (cv a) (co (co (co (co (cv xR) B2 cmuls) (co A2 (cv yL) cmuls) cadds) (co (cv xR) (cv yL) cmuls) csubs) (co A2 C cmuls) cadds)) (cfv B2 cleft)) (cfv A2 cright)))) (cun (cab a (wrex xL (wrex zR (wceq (cv a) (co (co A2 B2 cmuls) (co (co (co (cv xL) C cmuls) (co A2 (cv zR) cmuls) cadds) (co (cv xL) (cv zR) cmuls) csubs) cadds)) (cfv C cright)) (cfv A2 cleft))) (cab a (wrex xR (wrex zL (wceq (cv a) (co (co A2 B2 cmuls) (co (co (co (cv xR) C cmuls) (co A2 (cv zL) cmuls) cadds) (co (cv xR) (cv zL) cmuls) csubs) cadds)) (cfv C cleft)) (cfv A2 cright))))) ccuts)) $;

--| Lemma for ~ addsdi . Show one of the equalities involved in the final expression. (Contributed by Scott Fenton, 9-Mar-2025.)
theorem addsdilem3 {xO yO: setvar} (ph ps: wff xO yO) (A2 B2 C X: class) (Y: class xO):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wral xO (wceq (co (cv xO) (co B2 C cadds) cmuls) (co (co (cv xO) B2 cmuls) (co (cv xO) C cmuls) cadds)) (cun (cfv A2 cleft) (cfv A2 cright))) $ >
  $ wi ph (wral yO (wceq (co A2 (co (cv yO) C cadds) cmuls) (co (co A2 (cv yO) cmuls) (co A2 C cmuls) cadds)) (cun (cfv B2 cleft) (cfv B2 cright))) $ >
  $ wi ph (wral xO (wral yO (wceq (co (cv xO) (co (cv yO) C cadds) cmuls) (co (co (cv xO) (cv yO) cmuls) (co (cv xO) C cmuls) cadds)) (cun (cfv B2 cleft) (cfv B2 cright))) (cun (cfv A2 cleft) (cfv A2 cright))) $ >
  $ wi ps (wcel X (cun (cfv A2 cleft) (cfv A2 cright))) $ >
  $ wi ps (wcel Y (cun (cfv B2 cleft) (cfv B2 cright))) $ >
  $ wi (wa ph ps) (wceq (co (co (co X (co B2 C cadds) cmuls) (co A2 (co Y C cadds) cmuls) cadds) (co X (co Y C cadds) cmuls) csubs) (co (co (co (co X B2 cmuls) (co A2 Y cmuls) cadds) (co X Y cmuls) csubs) (co A2 C cmuls) cadds)) $;

--| Lemma for ~ addsdi . Show one of the equalities involved in the final expression. (Contributed by Scott Fenton, 9-Mar-2025.)
theorem addsdilem4 {xO zO: setvar} (ph ps: wff xO zO) (A2 B2 C X: class) (Z: class xO):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wral xO (wceq (co (cv xO) (co B2 C cadds) cmuls) (co (co (cv xO) B2 cmuls) (co (cv xO) C cmuls) cadds)) (cun (cfv A2 cleft) (cfv A2 cright))) $ >
  $ wi ph (wral zO (wceq (co A2 (co B2 (cv zO) cadds) cmuls) (co (co A2 B2 cmuls) (co A2 (cv zO) cmuls) cadds)) (cun (cfv C cleft) (cfv C cright))) $ >
  $ wi ph (wral xO (wral zO (wceq (co (cv xO) (co B2 (cv zO) cadds) cmuls) (co (co (cv xO) B2 cmuls) (co (cv xO) (cv zO) cmuls) cadds)) (cun (cfv C cleft) (cfv C cright))) (cun (cfv A2 cleft) (cfv A2 cright))) $ >
  $ wi ps (wcel X (cun (cfv A2 cleft) (cfv A2 cright))) $ >
  $ wi ps (wcel Z (cun (cfv C cleft) (cfv C cright))) $ >
  $ wi (wa ph ps) (wceq (co (co (co X (co B2 C cadds) cmuls) (co A2 (co B2 Z cadds) cmuls) cadds) (co X (co B2 Z cadds) cmuls) csubs) (co (co A2 B2 cmuls) (co (co (co X C cmuls) (co A2 Z cmuls) cadds) (co X Z cmuls) csubs) cadds)) $;

--| Distributive law for surreal numbers. Commuted form of part of theorem 7 of [Conway] p. 19. (Contributed by Scott Fenton, 9-Mar-2025.)
theorem addsdi (A2 B2 C: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wcel C csur)) (wceq (co A2 (co B2 C cadds) cmuls) (co (co A2 B2 cmuls) (co A2 C cmuls) cadds)) $;

--| Distributive law for surreal numbers. Commuted form of part of theorem 7 of [Conway] p. 19. (Contributed by Scott Fenton, 9-Mar-2025.)
theorem addsdid (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wceq (co A2 (co B2 C cadds) cmuls) (co (co A2 B2 cmuls) (co A2 C cmuls) cadds)) $;

--| Distributive law for surreal numbers. Part of theorem 7 of [Conway] p. 19. (Contributed by Scott Fenton, 9-Mar-2025.)
theorem addsdird (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wceq (co (co A2 B2 cadds) C cmuls) (co (co A2 C cmuls) (co B2 C cmuls) cadds)) $;

--| Distribution of surreal multiplication over subtraction. (Contributed by Scott Fenton, 9-Mar-2025.)
theorem subsdid (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wceq (co A2 (co B2 C csubs) cmuls) (co (co A2 B2 cmuls) (co A2 C cmuls) csubs)) $;

--| Distribution of surreal multiplication over subtraction. (Contributed by Scott Fenton, 9-Mar-2025.)
theorem subsdird (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wceq (co (co A2 B2 csubs) C cmuls) (co (co A2 C cmuls) (co B2 C cmuls) csubs)) $;

--| Product with negative is negative of product. Part of theorem 7 of [Conway] p. 19. (Contributed by Scott Fenton, 10-Mar-2025.)
theorem mulnegs1d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wceq (co (cfv A2 cnegs) B2 cmuls) (cfv (co A2 B2 cmuls) cnegs)) $;

--| Product with negative is negative of product. Part of theorem 7 of [Conway] p. 19. (Contributed by Scott Fenton, 10-Mar-2025.)
theorem mulnegs2d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wceq (co A2 (cfv B2 cnegs) cmuls) (cfv (co A2 B2 cmuls) cnegs)) $;

--| Surreal product of two negatives. (Contributed by Scott Fenton, 15-Mar-2025.)
theorem mul2negsd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wceq (co (cfv A2 cnegs) (cfv B2 cnegs) cmuls) (co A2 B2 cmuls)) $;

--| Lemma for ~ mulsass . Expand the left hand side of the formula. (Contributed by Scott Fenton, 9-Mar-2025.)
theorem mulsasslem1 {a xL xR yL yR zL zR: setvar} (ph: wff a xL xR yL yR zL zR) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wceq (co (co A2 B2 cmuls) C cmuls) (co (cun (cun (cab a (wrex xL (wrex yL (wrex zL (wceq (cv a) (co (co (co (co (co (co (cv xL) B2 cmuls) (co A2 (cv yL) cmuls) cadds) (co (cv xL) (cv yL) cmuls) csubs) C cmuls) (co (co A2 B2 cmuls) (cv zL) cmuls) cadds) (co (co (co (co (cv xL) B2 cmuls) (co A2 (cv yL) cmuls) cadds) (co (cv xL) (cv yL) cmuls) csubs) (cv zL) cmuls) csubs)) (cfv C cleft)) (cfv B2 cleft)) (cfv A2 cleft))) (cab a (wrex xR (wrex yR (wrex zL (wceq (cv a) (co (co (co (co (co (co (cv xR) B2 cmuls) (co A2 (cv yR) cmuls) cadds) (co (cv xR) (cv yR) cmuls) csubs) C cmuls) (co (co A2 B2 cmuls) (cv zL) cmuls) cadds) (co (co (co (co (cv xR) B2 cmuls) (co A2 (cv yR) cmuls) cadds) (co (cv xR) (cv yR) cmuls) csubs) (cv zL) cmuls) csubs)) (cfv C cleft)) (cfv B2 cright)) (cfv A2 cright)))) (cun (cab a (wrex xL (wrex yR (wrex zR (wceq (cv a) (co (co (co (co (co (co (cv xL) B2 cmuls) (co A2 (cv yR) cmuls) cadds) (co (cv xL) (cv yR) cmuls) csubs) C cmuls) (co (co A2 B2 cmuls) (cv zR) cmuls) cadds) (co (co (co (co (cv xL) B2 cmuls) (co A2 (cv yR) cmuls) cadds) (co (cv xL) (cv yR) cmuls) csubs) (cv zR) cmuls) csubs)) (cfv C cright)) (cfv B2 cright)) (cfv A2 cleft))) (cab a (wrex xR (wrex yL (wrex zR (wceq (cv a) (co (co (co (co (co (co (cv xR) B2 cmuls) (co A2 (cv yL) cmuls) cadds) (co (cv xR) (cv yL) cmuls) csubs) C cmuls) (co (co A2 B2 cmuls) (cv zR) cmuls) cadds) (co (co (co (co (cv xR) B2 cmuls) (co A2 (cv yL) cmuls) cadds) (co (cv xR) (cv yL) cmuls) csubs) (cv zR) cmuls) csubs)) (cfv C cright)) (cfv B2 cleft)) (cfv A2 cright))))) (cun (cun (cab a (wrex xL (wrex yL (wrex zR (wceq (cv a) (co (co (co (co (co (co (cv xL) B2 cmuls) (co A2 (cv yL) cmuls) cadds) (co (cv xL) (cv yL) cmuls) csubs) C cmuls) (co (co A2 B2 cmuls) (cv zR) cmuls) cadds) (co (co (co (co (cv xL) B2 cmuls) (co A2 (cv yL) cmuls) cadds) (co (cv xL) (cv yL) cmuls) csubs) (cv zR) cmuls) csubs)) (cfv C cright)) (cfv B2 cleft)) (cfv A2 cleft))) (cab a (wrex xR (wrex yR (wrex zR (wceq (cv a) (co (co (co (co (co (co (cv xR) B2 cmuls) (co A2 (cv yR) cmuls) cadds) (co (cv xR) (cv yR) cmuls) csubs) C cmuls) (co (co A2 B2 cmuls) (cv zR) cmuls) cadds) (co (co (co (co (cv xR) B2 cmuls) (co A2 (cv yR) cmuls) cadds) (co (cv xR) (cv yR) cmuls) csubs) (cv zR) cmuls) csubs)) (cfv C cright)) (cfv B2 cright)) (cfv A2 cright)))) (cun (cab a (wrex xL (wrex yR (wrex zL (wceq (cv a) (co (co (co (co (co (co (cv xL) B2 cmuls) (co A2 (cv yR) cmuls) cadds) (co (cv xL) (cv yR) cmuls) csubs) C cmuls) (co (co A2 B2 cmuls) (cv zL) cmuls) cadds) (co (co (co (co (cv xL) B2 cmuls) (co A2 (cv yR) cmuls) cadds) (co (cv xL) (cv yR) cmuls) csubs) (cv zL) cmuls) csubs)) (cfv C cleft)) (cfv B2 cright)) (cfv A2 cleft))) (cab a (wrex xR (wrex yL (wrex zL (wceq (cv a) (co (co (co (co (co (co (cv xR) B2 cmuls) (co A2 (cv yL) cmuls) cadds) (co (cv xR) (cv yL) cmuls) csubs) C cmuls) (co (co A2 B2 cmuls) (cv zL) cmuls) cadds) (co (co (co (co (cv xR) B2 cmuls) (co A2 (cv yL) cmuls) cadds) (co (cv xR) (cv yL) cmuls) csubs) (cv zL) cmuls) csubs)) (cfv C cleft)) (cfv B2 cleft)) (cfv A2 cright))))) ccuts)) $;

--| Lemma for ~ mulsass . Expand the right hand side of the formula. (Contributed by Scott Fenton, 9-Mar-2025.)
theorem mulsasslem2 {a xL xR yL yR zL zR: setvar} (ph: wff a xL xR yL yR zL zR) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wceq (co A2 (co B2 C cmuls) cmuls) (co (cun (cun (cab a (wrex xL (wrex yL (wrex zL (wceq (cv a) (co (co (co (cv xL) (co B2 C cmuls) cmuls) (co A2 (co (co (co (cv yL) C cmuls) (co B2 (cv zL) cmuls) cadds) (co (cv yL) (cv zL) cmuls) csubs) cmuls) cadds) (co (cv xL) (co (co (co (cv yL) C cmuls) (co B2 (cv zL) cmuls) cadds) (co (cv yL) (cv zL) cmuls) csubs) cmuls) csubs)) (cfv C cleft)) (cfv B2 cleft)) (cfv A2 cleft))) (cab a (wrex xL (wrex yR (wrex zR (wceq (cv a) (co (co (co (cv xL) (co B2 C cmuls) cmuls) (co A2 (co (co (co (cv yR) C cmuls) (co B2 (cv zR) cmuls) cadds) (co (cv yR) (cv zR) cmuls) csubs) cmuls) cadds) (co (cv xL) (co (co (co (cv yR) C cmuls) (co B2 (cv zR) cmuls) cadds) (co (cv yR) (cv zR) cmuls) csubs) cmuls) csubs)) (cfv C cright)) (cfv B2 cright)) (cfv A2 cleft)))) (cun (cab a (wrex xR (wrex yL (wrex zR (wceq (cv a) (co (co (co (cv xR) (co B2 C cmuls) cmuls) (co A2 (co (co (co (cv yL) C cmuls) (co B2 (cv zR) cmuls) cadds) (co (cv yL) (cv zR) cmuls) csubs) cmuls) cadds) (co (cv xR) (co (co (co (cv yL) C cmuls) (co B2 (cv zR) cmuls) cadds) (co (cv yL) (cv zR) cmuls) csubs) cmuls) csubs)) (cfv C cright)) (cfv B2 cleft)) (cfv A2 cright))) (cab a (wrex xR (wrex yR (wrex zL (wceq (cv a) (co (co (co (cv xR) (co B2 C cmuls) cmuls) (co A2 (co (co (co (cv yR) C cmuls) (co B2 (cv zL) cmuls) cadds) (co (cv yR) (cv zL) cmuls) csubs) cmuls) cadds) (co (cv xR) (co (co (co (cv yR) C cmuls) (co B2 (cv zL) cmuls) cadds) (co (cv yR) (cv zL) cmuls) csubs) cmuls) csubs)) (cfv C cleft)) (cfv B2 cright)) (cfv A2 cright))))) (cun (cun (cab a (wrex xL (wrex yL (wrex zR (wceq (cv a) (co (co (co (cv xL) (co B2 C cmuls) cmuls) (co A2 (co (co (co (cv yL) C cmuls) (co B2 (cv zR) cmuls) cadds) (co (cv yL) (cv zR) cmuls) csubs) cmuls) cadds) (co (cv xL) (co (co (co (cv yL) C cmuls) (co B2 (cv zR) cmuls) cadds) (co (cv yL) (cv zR) cmuls) csubs) cmuls) csubs)) (cfv C cright)) (cfv B2 cleft)) (cfv A2 cleft))) (cab a (wrex xL (wrex yR (wrex zL (wceq (cv a) (co (co (co (cv xL) (co B2 C cmuls) cmuls) (co A2 (co (co (co (cv yR) C cmuls) (co B2 (cv zL) cmuls) cadds) (co (cv yR) (cv zL) cmuls) csubs) cmuls) cadds) (co (cv xL) (co (co (co (cv yR) C cmuls) (co B2 (cv zL) cmuls) cadds) (co (cv yR) (cv zL) cmuls) csubs) cmuls) csubs)) (cfv C cleft)) (cfv B2 cright)) (cfv A2 cleft)))) (cun (cab a (wrex xR (wrex yL (wrex zL (wceq (cv a) (co (co (co (cv xR) (co B2 C cmuls) cmuls) (co A2 (co (co (co (cv yL) C cmuls) (co B2 (cv zL) cmuls) cadds) (co (cv yL) (cv zL) cmuls) csubs) cmuls) cadds) (co (cv xR) (co (co (co (cv yL) C cmuls) (co B2 (cv zL) cmuls) cadds) (co (cv yL) (cv zL) cmuls) csubs) cmuls) csubs)) (cfv C cleft)) (cfv B2 cleft)) (cfv A2 cright))) (cab a (wrex xR (wrex yR (wrex zR (wceq (cv a) (co (co (co (cv xR) (co B2 C cmuls) cmuls) (co A2 (co (co (co (cv yR) C cmuls) (co B2 (cv zR) cmuls) cadds) (co (cv yR) (cv zR) cmuls) csubs) cmuls) cadds) (co (cv xR) (co (co (co (cv yR) C cmuls) (co B2 (cv zR) cmuls) cadds) (co (cv yR) (cv zR) cmuls) csubs) cmuls) csubs)) (cfv C cright)) (cfv B2 cright)) (cfv A2 cright))))) ccuts)) $;

--| Lemma for ~ mulsass . Demonstrate the central equality. (Contributed by Scott Fenton, 10-Mar-2025.)
theorem mulsasslem3 {x3 y1 z xO yO zO: setvar} (ph: wff xO yO zO) (A2 B2 C: class x3 y1 z) (P: class x3 xO yO zO) (Q: class x3 y1 xO yO zO) (R: class x3 y1 z xO yO zO) (a: setvar):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wss P (cun (cfv A2 cleft) (cfv A2 cright)) $ >
  $ wss Q (cun (cfv B2 cleft) (cfv B2 cright)) $ >
  $ wss R (cun (cfv C cleft) (cfv C cright)) $ >
  $ wi ph (wral xO (wral yO (wral zO (wceq (co (co (cv xO) (cv yO) cmuls) (cv zO) cmuls) (co (cv xO) (co (cv yO) (cv zO) cmuls) cmuls)) (cun (cfv C cleft) (cfv C cright))) (cun (cfv B2 cleft) (cfv B2 cright))) (cun (cfv A2 cleft) (cfv A2 cright))) $ >
  $ wi ph (wral xO (wral yO (wceq (co (co (cv xO) (cv yO) cmuls) C cmuls) (co (cv xO) (co (cv yO) C cmuls) cmuls)) (cun (cfv B2 cleft) (cfv B2 cright))) (cun (cfv A2 cleft) (cfv A2 cright))) $ >
  $ wi ph (wral xO (wral zO (wceq (co (co (cv xO) B2 cmuls) (cv zO) cmuls) (co (cv xO) (co B2 (cv zO) cmuls) cmuls)) (cun (cfv C cleft) (cfv C cright))) (cun (cfv A2 cleft) (cfv A2 cright))) $ >
  $ wi ph (wral yO (wral zO (wceq (co (co A2 (cv yO) cmuls) (cv zO) cmuls) (co A2 (co (cv yO) (cv zO) cmuls) cmuls)) (cun (cfv C cleft) (cfv C cright))) (cun (cfv B2 cleft) (cfv B2 cright))) $ >
  $ wi ph (wral xO (wceq (co (co (cv xO) B2 cmuls) C cmuls) (co (cv xO) (co B2 C cmuls) cmuls)) (cun (cfv A2 cleft) (cfv A2 cright))) $ >
  $ wi ph (wral yO (wceq (co (co A2 (cv yO) cmuls) C cmuls) (co A2 (co (cv yO) C cmuls) cmuls)) (cun (cfv B2 cleft) (cfv B2 cright))) $ >
  $ wi ph (wral zO (wceq (co (co A2 B2 cmuls) (cv zO) cmuls) (co A2 (co B2 (cv zO) cmuls) cmuls)) (cun (cfv C cleft) (cfv C cright))) $ >
  $ wi ph (wb (wrex x3 (wrex y1 (wrex z (wceq (cv a) (co (co (co (co (co (co (cv x3) B2 cmuls) (co A2 (cv y1) cmuls) cadds) (co (cv x3) (cv y1) cmuls) csubs) C cmuls) (co (co A2 B2 cmuls) (cv z) cmuls) cadds) (co (co (co (co (cv x3) B2 cmuls) (co A2 (cv y1) cmuls) cadds) (co (cv x3) (cv y1) cmuls) csubs) (cv z) cmuls) csubs)) R) Q) P) (wrex x3 (wrex y1 (wrex z (wceq (cv a) (co (co (co (cv x3) (co B2 C cmuls) cmuls) (co A2 (co (co (co (cv y1) C cmuls) (co B2 (cv z) cmuls) cadds) (co (cv y1) (cv z) cmuls) csubs) cmuls) cadds) (co (cv x3) (co (co (co (cv y1) C cmuls) (co B2 (cv z) cmuls) cadds) (co (cv y1) (cv z) cmuls) csubs) cmuls) csubs)) R) Q) P)) $;

--| Associative law for surreal multiplication. Part of theorem 7 of [Conway] p. 19. Much like the case for additive groups, this theorem together with ~ mulscom , ~ addsdi , ~ mulsgt0 , and the addition theorems would make the surreals into an ordered ring except that they are a proper class. (Contributed by Scott Fenton, 10-Mar-2025.)
theorem mulsass (A2 B2 C: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wcel C csur)) (wceq (co (co A2 B2 cmuls) C cmuls) (co A2 (co B2 C cmuls) cmuls)) $;

--| Associative law for surreal multiplication. Part of theorem 7 of [Conway] p. 19. (Contributed by Scott Fenton, 10-Mar-2025.)
theorem mulsassd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wceq (co (co A2 B2 cmuls) C cmuls) (co A2 (co B2 C cmuls) cmuls)) $;

--| Rearrangement of four surreal factors. (Contributed by Scott Fenton, 16-Apr-2025.)
theorem muls4d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wcel D csur) $ >
  $ wi ph (wceq (co (co A2 B2 cmuls) (co C D cmuls) cmuls) (co (co A2 C cmuls) (co B2 D cmuls) cmuls)) $;

--| Lemma for ~ mulsunif2 . State the theorem with extra disjoint variable conditions. (Contributed by Scott Fenton, 16-Mar-2025.)
theorem mulsunif2lem {w v u t s1 r q p a b c d: setvar} (ph: wff) (A2 B2 R S L M: class):
  $ wi ph (wbr L R cslts) $ >
  $ wi ph (wbr M S cslts) $ >
  $ wi ph (wceq A2 (co L R ccuts)) $ >
  $ wi ph (wceq B2 (co M S ccuts)) $ >
  $ wi ph (wceq (co A2 B2 cmuls) (co (cun (cab a (wrex p (wrex q (wceq (cv a) (co (co A2 B2 cmuls) (co (co A2 (cv p) csubs) (co B2 (cv q) csubs) cmuls) csubs)) M) L)) (cab b (wrex r (wrex s1 (wceq (cv b) (co (co A2 B2 cmuls) (co (co (cv r) A2 csubs) (co (cv s1) B2 csubs) cmuls) csubs)) S) R))) (cun (cab c (wrex t (wrex u (wceq (cv c) (co (co A2 B2 cmuls) (co (co A2 (cv t) csubs) (co (cv u) B2 csubs) cmuls) cadds)) S) L)) (cab d (wrex v (wrex w (wceq (cv d) (co (co A2 B2 cmuls) (co (co (cv v) A2 csubs) (co B2 (cv w) csubs) cmuls) cadds)) M) R))) ccuts)) $;

--| Alternate expression for surreal multiplication. Note from [Conway] p. 19. (Contributed by Scott Fenton, 16-Mar-2025.)
theorem mulsunif2 {w v u t s1 r q p a b c d: setvar} (ph: wff w v u t s1 r q p a b c d) (A2 B2: class) (R: class w u t s1 q p a c) (S: class w v q p a d) (L: class w v u s1 r q b d) (M: class u t s1 r b c):
  $ wi ph (wbr L R cslts) $ >
  $ wi ph (wbr M S cslts) $ >
  $ wi ph (wceq A2 (co L R ccuts)) $ >
  $ wi ph (wceq B2 (co M S ccuts)) $ >
  $ wi ph (wceq (co A2 B2 cmuls) (co (cun (cab a (wrex p (wrex q (wceq (cv a) (co (co A2 B2 cmuls) (co (co A2 (cv p) csubs) (co B2 (cv q) csubs) cmuls) csubs)) M) L)) (cab b (wrex r (wrex s1 (wceq (cv b) (co (co A2 B2 cmuls) (co (co (cv r) A2 csubs) (co (cv s1) B2 csubs) cmuls) csubs)) S) R))) (cun (cab c (wrex t (wrex u (wceq (cv c) (co (co A2 B2 cmuls) (co (co A2 (cv t) csubs) (co (cv u) B2 csubs) cmuls) cadds)) S) L)) (cab d (wrex v (wrex w (wceq (cv d) (co (co A2 B2 cmuls) (co (co (cv v) A2 csubs) (co B2 (cv w) csubs) cmuls) cadds)) M) R))) ccuts)) $;

--| Alternate expression for surreal multiplication. Note from [Conway] p. 19. (Contributed by Scott Fenton, 16-Mar-2025.)
theorem mulsunif2_b {w v a: setvar} (ph: wff w v a) (A2 B2: class) (R: class w) (S: class) (L: class w) (M: class):
  $ wi ph (wbr L R cslts) $ >
  $ wi ph (wbr M S cslts) $ >
  $ wi ph (wceq A2 (co L R ccuts)) $ >
  $ wi ph (wceq B2 (co M S ccuts)) $ >
  $ wi ph (wceq (co A2 B2 cmuls) (co (cun (cab a (wrex v (wrex w (wceq (cv a) (co (co A2 B2 cmuls) (co (co A2 (cv v) csubs) (co B2 (cv w) csubs) cmuls) csubs)) M) L)) (cab a (wrex v (wrex w (wceq (cv a) (co (co A2 B2 cmuls) (co (co (cv v) A2 csubs) (co (cv w) B2 csubs) cmuls) csubs)) S) R))) (cun (cab a (wrex v (wrex w (wceq (cv a) (co (co A2 B2 cmuls) (co (co A2 (cv v) csubs) (co (cv w) B2 csubs) cmuls) cadds)) S) L)) (cab a (wrex v (wrex w (wceq (cv a) (co (co A2 B2 cmuls) (co (co (cv v) A2 csubs) (co B2 (cv w) csubs) cmuls) cadds)) M) R))) ccuts)) $;

--| Multiplication of both sides of surreal less-than by a positive number. (Contributed by Scott Fenton, 10-Mar-2025.)
theorem ltmuls2 (A2 B2 C: class):
  $ wi (w3a (wa (wcel A2 csur) (wbr c0s A2 clts)) (wcel B2 csur) (wcel C csur)) (wb (wbr B2 C clts) (wbr (co A2 B2 cmuls) (co A2 C cmuls) clts)) $;

--| Multiplication of both sides of surreal less-than by a positive number. (Contributed by Scott Fenton, 10-Mar-2025.)
theorem ltmuls2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wbr c0s C clts) $ >
  $ wi ph (wb (wbr A2 B2 clts) (wbr (co C A2 cmuls) (co C B2 cmuls) clts)) $;

--| Multiplication of both sides of surreal less-than by a positive number. (Contributed by Scott Fenton, 10-Mar-2025.)
theorem ltmuls1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wbr c0s C clts) $ >
  $ wi ph (wb (wbr A2 B2 clts) (wbr (co A2 C cmuls) (co B2 C cmuls) clts)) $;

--| Multiplication of both sides of surreal less-than or equal by a positive number. (Contributed by Scott Fenton, 10-Mar-2025.)
theorem lemuls2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wbr c0s C clts) $ >
  $ wi ph (wb (wbr A2 B2 cles) (wbr (co C A2 cmuls) (co C B2 cmuls) cles)) $;

--| Multiplication of both sides of surreal less-than or equal by a positive number. (Contributed by Scott Fenton, 10-Mar-2025.)
theorem lemuls1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wbr c0s C clts) $ >
  $ wi ph (wb (wbr A2 B2 cles) (wbr (co A2 C cmuls) (co B2 C cmuls) cles)) $;

--| Multiplication of both sides of surreal less-than by a negative number. (Contributed by Scott Fenton, 14-Mar-2025.)
theorem ltmulnegs1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wbr C c0s clts) $ >
  $ wi ph (wb (wbr A2 B2 clts) (wbr (co B2 C cmuls) (co A2 C cmuls) clts)) $;

--| Multiplication of both sides of surreal less-than by a negative number. (Contributed by Scott Fenton, 14-Mar-2025.)
theorem ltmulnegs2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wbr C c0s clts) $ >
  $ wi ph (wb (wbr A2 B2 clts) (wbr (co C B2 cmuls) (co C A2 cmuls) clts)) $;

--| Lemma for ~ mulscan2d . Cancellation of multiplication when the right term is positive. (Contributed by Scott Fenton, 10-Mar-2025.)
theorem mulscan2dlem (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wbr c0s C clts) $ >
  $ wi ph (wb (wceq (co A2 C cmuls) (co B2 C cmuls)) (wceq A2 B2)) $;

--| Cancellation of surreal multiplication when the right term is nonzero. (Contributed by Scott Fenton, 10-Mar-2025.)
theorem mulscan2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wne C c0s) $ >
  $ wi ph (wb (wceq (co A2 C cmuls) (co B2 C cmuls)) (wceq A2 B2)) $;

--| Cancellation of surreal multiplication when the left term is nonzero. (Contributed by Scott Fenton, 10-Mar-2025.)
theorem mulscan1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wne C c0s) $ >
  $ wi ph (wb (wceq (co C A2 cmuls) (co C B2 cmuls)) (wceq A2 B2)) $;

--| Commutative/associative law for surreal multiplication. (Contributed by Scott Fenton, 14-Mar-2025.)
theorem muls12d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wceq (co A2 (co B2 C cmuls) cmuls) (co B2 (co A2 C cmuls) cmuls)) $;

--| Multiplication of both sides of surreal less-than or equal by a non-negative number. (Contributed by Scott Fenton, 17-Apr-2025.)
theorem lemuls1ad (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wbr c0s C cles) $ >
  $ wi ph (wbr A2 B2 cles) $ >
  $ wi ph (wbr (co A2 C cmuls) (co B2 C cmuls) cles) $;

--| Comparison of the product of two positive surreals. (Contributed by Scott Fenton, 17-Apr-2025.)
theorem ltmuls12ad (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wcel D csur) $ >
  $ wi ph (wbr c0s A2 cles) $ >
  $ wi ph (wbr A2 B2 clts) $ >
  $ wi ph (wbr c0s C cles) $ >
  $ wi ph (wbr C D clts) $ >
  $ wi ph (wbr (co A2 C cmuls) (co B2 D cmuls) clts) $;

--| Uniqueness of surreal inversion. Given a nonzero surreal ` A ` , there is at most one surreal giving a particular product. (Contributed by Scott Fenton, 10-Mar-2025.)
theorem divsmo {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wne A2 c0s)) (wrmo x3 (wceq (co A2 (cv x3) cmuls) B2) csur) $;

--| If a surreal product is zero, one of its factors must be zero. (Contributed by Scott Fenton, 16-Apr-2025.)
theorem muls0ord (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wb (wceq (co A2 B2 cmuls) c0s) (wo (wceq A2 c0s) (wceq B2 c0s))) $;

--| The product of two nonzero surreals is nonzero. (Contributed by Scott Fenton, 16-Apr-2025.)
theorem mulsne0bd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wb (wne (co A2 B2 cmuls) c0s) (wa (wne A2 c0s) (wne B2 c0s))) $;

--| Declare the syntax for surreal division.
term cdivs: class;

--| Define surreal division. This is not the definition used in the literature, but we use it here because it is technically easier to work with. (Contributed by Scott Fenton, 12-Mar-2025.)
axiom df_divs {x3 y1 z: setvar}:
  $ wceq cdivs (cmpo x3 y1 csur (cdif csur (csn c0s)) (crio z (wceq (co (cv y1) (cv z) cmuls) (cv x3)) csur)) $;

--| The value of surreal division. (Contributed by Scott Fenton, 12-Mar-2025.)
theorem divsval {x3: setvar} (A2 B2: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wne B2 c0s)) (wceq (co A2 B2 cdivs) (crio x3 (wceq (co B2 (cv x3) cmuls) A2) csur)) $;

--| If a surreal has a reciprocal, then it has any division. (Contributed by Scott Fenton, 12-Mar-2025.)
theorem norecdiv {x3 y1: setvar} (A2: class) (B2: class x3):
  $ wi (wa (w3a (wcel A2 csur) (wne A2 c0s) (wcel B2 csur)) (wrex x3 (wceq (co A2 (cv x3) cmuls) c1s) csur)) (wrex y1 (wceq (co A2 (cv y1) cmuls) B2) csur) $;

--| If a surreal has a reciprocal, then it has unique division. (Contributed by Scott Fenton, 12-Mar-2025.)
theorem noreceuw {x3 y1: setvar} (A2: class) (B2: class x3):
  $ wi (wa (w3a (wcel A2 csur) (wne A2 c0s) (wcel B2 csur)) (wrex x3 (wceq (co A2 (cv x3) cmuls) c1s) csur)) (wreu y1 (wceq (co A2 (cv y1) cmuls) B2) csur) $;

--| If a surreal has a reciprocal, then it is nonzero. (Contributed by Scott Fenton, 5-Sep-2025.)
theorem recsne0 {x3: setvar} (ph: wff x3) (A2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wrex x3 (wceq (co A2 (cv x3) cmuls) c1s) csur) $ >
  $ wi ph (wne A2 c0s) $;

--| Relationship between surreal division and multiplication. Weak version that does not assume reciprocals. Later, when we prove ~ precsex , we can eliminate the existence hypothesis (see ~ divmuls ). (Contributed by Scott Fenton, 12-Mar-2025.)
theorem divmulsw {x3: setvar} (A2 B2: class x3) (C: class):
  $ wi (wa (w3a (wcel A2 csur) (wcel B2 csur) (wa (wcel C csur) (wne C c0s))) (wrex x3 (wceq (co C (cv x3) cmuls) c1s) csur)) (wb (wceq (co A2 C cdivs) B2) (wceq (co C B2 cmuls) A2)) $;

--| Relationship between surreal division and multiplication. Weak version that does not assume reciprocals. (Contributed by Scott Fenton, 12-Mar-2025.)
theorem divmulswd {x3: setvar} (ph: wff x3) (A2 B2: class x3) (C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wne C c0s) $ >
  $ wi ph (wrex x3 (wceq (co C (cv x3) cmuls) c1s) csur) $ >
  $ wi ph (wb (wceq (co A2 C cdivs) B2) (wceq (co C B2 cmuls) A2)) $;

--| Weak division closure law. (Contributed by Scott Fenton, 12-Mar-2025.)
theorem divsclw {x3: setvar} (A2: class x3) (B2: class):
  $ wi (wa (w3a (wcel A2 csur) (wcel B2 csur) (wne B2 c0s)) (wrex x3 (wceq (co B2 (cv x3) cmuls) c1s) csur)) (wcel (co A2 B2 cdivs) csur) $;

--| Weak division closure law. (Contributed by Scott Fenton, 12-Mar-2025.)
theorem divsclwd {x3: setvar} (ph: wff x3) (A2: class x3) (B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wne B2 c0s) $ >
  $ wi ph (wrex x3 (wceq (co B2 (cv x3) cmuls) c1s) csur) $ >
  $ wi ph (wcel (co A2 B2 cdivs) csur) $;

--| A weak cancellation law for surreal division. (Contributed by Scott Fenton, 13-Mar-2025.)
theorem divscan2wd {x3: setvar} (ph: wff x3) (A2: class x3) (B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wne B2 c0s) $ >
  $ wi ph (wrex x3 (wceq (co B2 (cv x3) cmuls) c1s) csur) $ >
  $ wi ph (wceq (co B2 (co A2 B2 cdivs) cmuls) A2) $;

--| A weak cancellation law for surreal division. (Contributed by Scott Fenton, 13-Mar-2025.)
theorem divscan1wd {x3: setvar} (ph: wff x3) (A2: class x3) (B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wne B2 c0s) $ >
  $ wi ph (wrex x3 (wceq (co B2 (cv x3) cmuls) c1s) csur) $ >
  $ wi ph (wceq (co (co A2 B2 cdivs) B2 cmuls) A2) $;

--| Surreal less-than relationship between division and multiplication. Weak version. (Contributed by Scott Fenton, 14-Mar-2025.)
theorem ltdivmulswd {x3: setvar} (ph: wff x3) (A2 B2: class x3) (C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wbr c0s C clts) $ >
  $ wi ph (wrex x3 (wceq (co C (cv x3) cmuls) c1s) csur) $ >
  $ wi ph (wb (wbr (co A2 C cdivs) B2 clts) (wbr A2 (co C B2 cmuls) clts)) $;

--| Surreal less-than relationship between division and multiplication. Weak version. (Contributed by Scott Fenton, 14-Mar-2025.)
theorem ltdivmuls2wd {x3: setvar} (ph: wff x3) (A2 B2: class x3) (C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wbr c0s C clts) $ >
  $ wi ph (wrex x3 (wceq (co C (cv x3) cmuls) c1s) csur) $ >
  $ wi ph (wb (wbr (co A2 C cdivs) B2 clts) (wbr A2 (co B2 C cmuls) clts)) $;

--| Surreal less-than relationship between division and multiplication. Weak version. (Contributed by Scott Fenton, 14-Mar-2025.)
theorem ltmuldivswd {x3: setvar} (ph: wff x3) (A2 B2: class x3) (C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wbr c0s C clts) $ >
  $ wi ph (wrex x3 (wceq (co C (cv x3) cmuls) c1s) csur) $ >
  $ wi ph (wb (wbr (co A2 C cmuls) B2 clts) (wbr A2 (co B2 C cdivs) clts)) $;

--| Surreal less-than relationship between division and multiplication. Weak version. (Contributed by Scott Fenton, 14-Mar-2025.)
theorem ltmuldivs2wd {x3: setvar} (ph: wff x3) (A2 B2: class x3) (C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wbr c0s C clts) $ >
  $ wi ph (wrex x3 (wceq (co C (cv x3) cmuls) c1s) csur) $ >
  $ wi ph (wb (wbr (co C A2 cmuls) B2 clts) (wbr A2 (co B2 C cdivs) clts)) $;

--| An associative law for surreal division. Weak version. (Contributed by Scott Fenton, 14-Mar-2025.)
theorem divsasswd {x3: setvar} (ph: wff x3) (A2 B2: class x3) (C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wne C c0s) $ >
  $ wi ph (wrex x3 (wceq (co C (cv x3) cmuls) c1s) csur) $ >
  $ wi ph (wceq (co (co A2 B2 cmuls) C cdivs) (co A2 (co B2 C cdivs) cmuls)) $;

--| A surreal divided by one is itself. (Contributed by Scott Fenton, 13-Mar-2025.)
theorem divs1 (A2: class):
  $ wi (wcel A2 csur) (wceq (co A2 c1s cdivs) A2) $;

--| A surreal divided by one is itself. Deduction version. (Contributed by Scott Fenton, 27-Feb-2026.)
theorem divs1d (ph: wff) (A2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wceq (co A2 c1s cdivs) A2) $;

--| Lemma for surreal reciprocals. Change some bound variables. (Contributed by Scott Fenton, 15-Mar-2025.)
theorem precsexlemcbv {x3 z w t m s1 r q p a b l xL xR yL yR zL zR: setvar} (A2: class) (F: class x3 z w t m s1 r q p a b l xL xR yL yR zL zR):
  $ wceq F (crdg (cmpt p cvv (csb l (cfv (cv p) c1st) (csb r (cfv (cv p) c2nd) (cop (cun (cv l) (cun (cab a (wrex xR (wrex yL (wceq (cv a) (co (co c1s (co (co (cv xR) A2 csubs) (cv yL) cmuls) cadds) (cv xR) cdivs)) (cv l)) (cfv A2 cright))) (cab a (wrex xL (wrex yR (wceq (cv a) (co (co c1s (co (co (cv xL) A2 csubs) (cv yR) cmuls) cadds) (cv xL) cdivs)) (cv r)) (crab x3 (wbr c0s (cv x3) clts) (cfv A2 cleft)))))) (cun (cv r) (cun (cab a (wrex xL (wrex yL (wceq (cv a) (co (co c1s (co (co (cv xL) A2 csubs) (cv yL) cmuls) cadds) (cv xL) cdivs)) (cv l)) (crab x3 (wbr c0s (cv x3) clts) (cfv A2 cleft)))) (cab a (wrex xR (wrex yR (wceq (cv a) (co (co c1s (co (co (cv xR) A2 csubs) (cv yR) cmuls) cadds) (cv xR) cdivs)) (cv r)) (cfv A2 cright))))))))) (cop (csn c0s) c0)) $ >
  $ wceq F (crdg (cmpt q cvv (csb m (cfv (cv q) c1st) (csb s1 (cfv (cv q) c2nd) (cop (cun (cv m) (cun (cab b (wrex zR (wrex w (wceq (cv b) (co (co c1s (co (co (cv zR) A2 csubs) (cv w) cmuls) cadds) (cv zR) cdivs)) (cv m)) (cfv A2 cright))) (cab b (wrex zL (wrex t (wceq (cv b) (co (co c1s (co (co (cv zL) A2 csubs) (cv t) cmuls) cadds) (cv zL) cdivs)) (cv s1)) (crab z (wbr c0s (cv z) clts) (cfv A2 cleft)))))) (cun (cv s1) (cun (cab b (wrex zL (wrex w (wceq (cv b) (co (co c1s (co (co (cv zL) A2 csubs) (cv w) cmuls) cadds) (cv zL) cdivs)) (cv m)) (crab z (wbr c0s (cv z) clts) (cfv A2 cleft)))) (cab b (wrex zR (wrex t (wceq (cv b) (co (co c1s (co (co (cv zR) A2 csubs) (cv t) cmuls) cadds) (cv zR) cdivs)) (cv s1)) (cfv A2 cright))))))))) (cop (csn c0s) c0)) $;

--| Lemma for surreal reciprocals. Calculate the value of the recursive left function at zero. (Contributed by Scott Fenton, 13-Mar-2025.)
theorem precsexlem1 {x3 r p a l xL xR yL yR: setvar} (A2 R F L: class x3 r p a l xL xR yL yR):
  $ wceq F (crdg (cmpt p cvv (csb l (cfv (cv p) c1st) (csb r (cfv (cv p) c2nd) (cop (cun (cv l) (cun (cab a (wrex xR (wrex yL (wceq (cv a) (co (co c1s (co (co (cv xR) A2 csubs) (cv yL) cmuls) cadds) (cv xR) cdivs)) (cv l)) (cfv A2 cright))) (cab a (wrex xL (wrex yR (wceq (cv a) (co (co c1s (co (co (cv xL) A2 csubs) (cv yR) cmuls) cadds) (cv xL) cdivs)) (cv r)) (crab x3 (wbr c0s (cv x3) clts) (cfv A2 cleft)))))) (cun (cv r) (cun (cab a (wrex xL (wrex yL (wceq (cv a) (co (co c1s (co (co (cv xL) A2 csubs) (cv yL) cmuls) cadds) (cv xL) cdivs)) (cv l)) (crab x3 (wbr c0s (cv x3) clts) (cfv A2 cleft)))) (cab a (wrex xR (wrex yR (wceq (cv a) (co (co c1s (co (co (cv xR) A2 csubs) (cv yR) cmuls) cadds) (cv xR) cdivs)) (cv r)) (cfv A2 cright))))))))) (cop (csn c0s) c0)) $ >
  $ wceq L (ccom c1st F) $ >
  $ wceq R (ccom c2nd F) $ >
  $ wceq (cfv c0 L) (csn c0s) $;

--| Lemma for surreal reciprocals. Calculate the value of the recursive right function at zero. (Contributed by Scott Fenton, 13-Mar-2025.)
theorem precsexlem2 {x3 r p a l xL xR yL yR: setvar} (A2 R F L: class x3 r p a l xL xR yL yR):
  $ wceq F (crdg (cmpt p cvv (csb l (cfv (cv p) c1st) (csb r (cfv (cv p) c2nd) (cop (cun (cv l) (cun (cab a (wrex xR (wrex yL (wceq (cv a) (co (co c1s (co (co (cv xR) A2 csubs) (cv yL) cmuls) cadds) (cv xR) cdivs)) (cv l)) (cfv A2 cright))) (cab a (wrex xL (wrex yR (wceq (cv a) (co (co c1s (co (co (cv xL) A2 csubs) (cv yR) cmuls) cadds) (cv xL) cdivs)) (cv r)) (crab x3 (wbr c0s (cv x3) clts) (cfv A2 cleft)))))) (cun (cv r) (cun (cab a (wrex xL (wrex yL (wceq (cv a) (co (co c1s (co (co (cv xL) A2 csubs) (cv yL) cmuls) cadds) (cv xL) cdivs)) (cv l)) (crab x3 (wbr c0s (cv x3) clts) (cfv A2 cleft)))) (cab a (wrex xR (wrex yR (wceq (cv a) (co (co c1s (co (co (cv xR) A2 csubs) (cv yR) cmuls) cadds) (cv xR) cdivs)) (cv r)) (cfv A2 cright))))))))) (cop (csn c0s) c0)) $ >
  $ wceq L (ccom c1st F) $ >
  $ wceq R (ccom c2nd F) $ >
  $ wceq (cfv c0 R) c0 $;

--| Lemma for surreal reciprocals. Calculate the value of the recursive function at a successor. (Contributed by Scott Fenton, 12-Mar-2025.)
theorem precsexlem3 {x3 r p a l xL xR yL yR: setvar} (A2: class yL yR) (R: class x3 p yL) (F: class x3 r a xL xR yL yR) (I: class) (L: class x3 r p yR):
  $ wceq F (crdg (cmpt p cvv (csb l (cfv (cv p) c1st) (csb r (cfv (cv p) c2nd) (cop (cun (cv l) (cun (cab a (wrex xR (wrex yL (wceq (cv a) (co (co c1s (co (co (cv xR) A2 csubs) (cv yL) cmuls) cadds) (cv xR) cdivs)) (cv l)) (cfv A2 cright))) (cab a (wrex xL (wrex yR (wceq (cv a) (co (co c1s (co (co (cv xL) A2 csubs) (cv yR) cmuls) cadds) (cv xL) cdivs)) (cv r)) (crab x3 (wbr c0s (cv x3) clts) (cfv A2 cleft)))))) (cun (cv r) (cun (cab a (wrex xL (wrex yL (wceq (cv a) (co (co c1s (co (co (cv xL) A2 csubs) (cv yL) cmuls) cadds) (cv xL) cdivs)) (cv l)) (crab x3 (wbr c0s (cv x3) clts) (cfv A2 cleft)))) (cab a (wrex xR (wrex yR (wceq (cv a) (co (co c1s (co (co (cv xR) A2 csubs) (cv yR) cmuls) cadds) (cv xR) cdivs)) (cv r)) (cfv A2 cright))))))))) (cop (csn c0s) c0)) $ >
  $ wceq L (ccom c1st F) $ >
  $ wceq R (ccom c2nd F) $ >
  $ wi (wcel I com) (wceq (cfv (csuc I) F) (cop (cun (cfv I L) (cun (cab a (wrex xR (wrex yL (wceq (cv a) (co (co c1s (co (co (cv xR) A2 csubs) (cv yL) cmuls) cadds) (cv xR) cdivs)) (cfv I L)) (cfv A2 cright))) (cab a (wrex xL (wrex yR (wceq (cv a) (co (co c1s (co (co (cv xL) A2 csubs) (cv yR) cmuls) cadds) (cv xL) cdivs)) (cfv I R)) (crab x3 (wbr c0s (cv x3) clts) (cfv A2 cleft)))))) (cun (cfv I R) (cun (cab a (wrex xL (wrex yL (wceq (cv a) (co (co c1s (co (co (cv xL) A2 csubs) (cv yL) cmuls) cadds) (cv xL) cdivs)) (cfv I L)) (crab x3 (wbr c0s (cv x3) clts) (cfv A2 cleft)))) (cab a (wrex xR (wrex yR (wceq (cv a) (co (co c1s (co (co (cv xR) A2 csubs) (cv yR) cmuls) cadds) (cv xR) cdivs)) (cfv I R)) (cfv A2 cright))))))) $;

--| Lemma for surreal reciprocals. Calculate the value of the recursive left function at a successor. (Contributed by Scott Fenton, 13-Mar-2025.)
theorem precsexlem4 {x3 r p a l xL xR yL yR: setvar} (A2: class yL yR) (R: class x3 p yL) (F: class x3 r a xL xR yL yR) (I: class) (L: class x3 r p yR):
  $ wceq F (crdg (cmpt p cvv (csb l (cfv (cv p) c1st) (csb r (cfv (cv p) c2nd) (cop (cun (cv l) (cun (cab a (wrex xR (wrex yL (wceq (cv a) (co (co c1s (co (co (cv xR) A2 csubs) (cv yL) cmuls) cadds) (cv xR) cdivs)) (cv l)) (cfv A2 cright))) (cab a (wrex xL (wrex yR (wceq (cv a) (co (co c1s (co (co (cv xL) A2 csubs) (cv yR) cmuls) cadds) (cv xL) cdivs)) (cv r)) (crab x3 (wbr c0s (cv x3) clts) (cfv A2 cleft)))))) (cun (cv r) (cun (cab a (wrex xL (wrex yL (wceq (cv a) (co (co c1s (co (co (cv xL) A2 csubs) (cv yL) cmuls) cadds) (cv xL) cdivs)) (cv l)) (crab x3 (wbr c0s (cv x3) clts) (cfv A2 cleft)))) (cab a (wrex xR (wrex yR (wceq (cv a) (co (co c1s (co (co (cv xR) A2 csubs) (cv yR) cmuls) cadds) (cv xR) cdivs)) (cv r)) (cfv A2 cright))))))))) (cop (csn c0s) c0)) $ >
  $ wceq L (ccom c1st F) $ >
  $ wceq R (ccom c2nd F) $ >
  $ wi (wcel I com) (wceq (cfv (csuc I) L) (cun (cfv I L) (cun (cab a (wrex xR (wrex yL (wceq (cv a) (co (co c1s (co (co (cv xR) A2 csubs) (cv yL) cmuls) cadds) (cv xR) cdivs)) (cfv I L)) (cfv A2 cright))) (cab a (wrex xL (wrex yR (wceq (cv a) (co (co c1s (co (co (cv xL) A2 csubs) (cv yR) cmuls) cadds) (cv xL) cdivs)) (cfv I R)) (crab x3 (wbr c0s (cv x3) clts) (cfv A2 cleft))))))) $;

--| Lemma for surreal reciprocals. Calculate the value of the recursive right function at a successor. (Contributed by Scott Fenton, 13-Mar-2025.)
theorem precsexlem5 {x3 r p a l xL xR yL yR: setvar} (A2: class yL yR) (R: class x3 p yL) (F: class x3 r a xL xR yL yR) (I: class) (L: class x3 r p yR):
  $ wceq F (crdg (cmpt p cvv (csb l (cfv (cv p) c1st) (csb r (cfv (cv p) c2nd) (cop (cun (cv l) (cun (cab a (wrex xR (wrex yL (wceq (cv a) (co (co c1s (co (co (cv xR) A2 csubs) (cv yL) cmuls) cadds) (cv xR) cdivs)) (cv l)) (cfv A2 cright))) (cab a (wrex xL (wrex yR (wceq (cv a) (co (co c1s (co (co (cv xL) A2 csubs) (cv yR) cmuls) cadds) (cv xL) cdivs)) (cv r)) (crab x3 (wbr c0s (cv x3) clts) (cfv A2 cleft)))))) (cun (cv r) (cun (cab a (wrex xL (wrex yL (wceq (cv a) (co (co c1s (co (co (cv xL) A2 csubs) (cv yL) cmuls) cadds) (cv xL) cdivs)) (cv l)) (crab x3 (wbr c0s (cv x3) clts) (cfv A2 cleft)))) (cab a (wrex xR (wrex yR (wceq (cv a) (co (co c1s (co (co (cv xR) A2 csubs) (cv yR) cmuls) cadds) (cv xR) cdivs)) (cv r)) (cfv A2 cright))))))))) (cop (csn c0s) c0)) $ >
  $ wceq L (ccom c1st F) $ >
  $ wceq R (ccom c2nd F) $ >
  $ wi (wcel I com) (wceq (cfv (csuc I) R) (cun (cfv I R) (cun (cab a (wrex xL (wrex yL (wceq (cv a) (co (co c1s (co (co (cv xL) A2 csubs) (cv yL) cmuls) cadds) (cv xL) cdivs)) (cfv I L)) (crab x3 (wbr c0s (cv x3) clts) (cfv A2 cleft)))) (cab a (wrex xR (wrex yR (wceq (cv a) (co (co c1s (co (co (cv xR) A2 csubs) (cv yR) cmuls) cadds) (cv xR) cdivs)) (cfv I R)) (cfv A2 cright)))))) $;

--| Lemma for surreal reciprocal. Show that ` L ` is non-strictly increasing in its argument. (Contributed by Scott Fenton, 15-Mar-2025.)
theorem precsexlem6 {x3 r p a l xL xR yL yR: setvar} (A2: class yL) (R: class x3 p yL) (F: class x3 r a xL xR yL yR) (I: class) (J: class x3 r p a l xL xR yL yR) (L: class x3 r p yR):
  $ wceq F (crdg (cmpt p cvv (csb l (cfv (cv p) c1st) (csb r (cfv (cv p) c2nd) (cop (cun (cv l) (cun (cab a (wrex xR (wrex yL (wceq (cv a) (co (co c1s (co (co (cv xR) A2 csubs) (cv yL) cmuls) cadds) (cv xR) cdivs)) (cv l)) (cfv A2 cright))) (cab a (wrex xL (wrex yR (wceq (cv a) (co (co c1s (co (co (cv xL) A2 csubs) (cv yR) cmuls) cadds) (cv xL) cdivs)) (cv r)) (crab x3 (wbr c0s (cv x3) clts) (cfv A2 cleft)))))) (cun (cv r) (cun (cab a (wrex xL (wrex yL (wceq (cv a) (co (co c1s (co (co (cv xL) A2 csubs) (cv yL) cmuls) cadds) (cv xL) cdivs)) (cv l)) (crab x3 (wbr c0s (cv x3) clts) (cfv A2 cleft)))) (cab a (wrex xR (wrex yR (wceq (cv a) (co (co c1s (co (co (cv xR) A2 csubs) (cv yR) cmuls) cadds) (cv xR) cdivs)) (cv r)) (cfv A2 cright))))))))) (cop (csn c0s) c0)) $ >
  $ wceq L (ccom c1st F) $ >
  $ wceq R (ccom c2nd F) $ >
  $ wi (w3a (wcel I com) (wcel J com) (wss I J)) (wss (cfv I L) (cfv J L)) $;

--| Lemma for surreal reciprocal. Show that ` R ` is non-strictly increasing in its argument. (Contributed by Scott Fenton, 15-Mar-2025.)
theorem precsexlem7 {x3 r p a l xL xR yL yR: setvar} (A2: class yL) (R: class x3 p yL) (F: class x3 r a xL xR yL yR) (I: class) (J: class x3 r p a l xL xR yL yR) (L: class x3 r p yR):
  $ wceq F (crdg (cmpt p cvv (csb l (cfv (cv p) c1st) (csb r (cfv (cv p) c2nd) (cop (cun (cv l) (cun (cab a (wrex xR (wrex yL (wceq (cv a) (co (co c1s (co (co (cv xR) A2 csubs) (cv yL) cmuls) cadds) (cv xR) cdivs)) (cv l)) (cfv A2 cright))) (cab a (wrex xL (wrex yR (wceq (cv a) (co (co c1s (co (co (cv xL) A2 csubs) (cv yR) cmuls) cadds) (cv xL) cdivs)) (cv r)) (crab x3 (wbr c0s (cv x3) clts) (cfv A2 cleft)))))) (cun (cv r) (cun (cab a (wrex xL (wrex yL (wceq (cv a) (co (co c1s (co (co (cv xL) A2 csubs) (cv yL) cmuls) cadds) (cv xL) cdivs)) (cv l)) (crab x3 (wbr c0s (cv x3) clts) (cfv A2 cleft)))) (cab a (wrex xR (wrex yR (wceq (cv a) (co (co c1s (co (co (cv xR) A2 csubs) (cv yR) cmuls) cadds) (cv xR) cdivs)) (cv r)) (cfv A2 cright))))))))) (cop (csn c0s) c0)) $ >
  $ wceq L (ccom c1st F) $ >
  $ wceq R (ccom c2nd F) $ >
  $ wi (w3a (wcel I com) (wcel J com) (wss I J)) (wss (cfv I R) (cfv J R)) $;

--| Lemma for surreal reciprocal. Show that the left and right functions give sets of surreals. (Contributed by Scott Fenton, 13-Mar-2025.)
theorem precsexlem8 {x3 y1 r p a l xO xL xR yL yR: setvar} (ph: wff x3 y1 r p l xO) (A2: class) (R: class x3 y1 p xO) (F: class x3 y1 r a xO xL xR yL yR) (I: class x3 y1 r p a l xO xL xR yL yR) (L: class x3 y1 r p xO):
  $ wceq F (crdg (cmpt p cvv (csb l (cfv (cv p) c1st) (csb r (cfv (cv p) c2nd) (cop (cun (cv l) (cun (cab a (wrex xR (wrex yL (wceq (cv a) (co (co c1s (co (co (cv xR) A2 csubs) (cv yL) cmuls) cadds) (cv xR) cdivs)) (cv l)) (cfv A2 cright))) (cab a (wrex xL (wrex yR (wceq (cv a) (co (co c1s (co (co (cv xL) A2 csubs) (cv yR) cmuls) cadds) (cv xL) cdivs)) (cv r)) (crab x3 (wbr c0s (cv x3) clts) (cfv A2 cleft)))))) (cun (cv r) (cun (cab a (wrex xL (wrex yL (wceq (cv a) (co (co c1s (co (co (cv xL) A2 csubs) (cv yL) cmuls) cadds) (cv xL) cdivs)) (cv l)) (crab x3 (wbr c0s (cv x3) clts) (cfv A2 cleft)))) (cab a (wrex xR (wrex yR (wceq (cv a) (co (co c1s (co (co (cv xR) A2 csubs) (cv yR) cmuls) cadds) (cv xR) cdivs)) (cv r)) (cfv A2 cright))))))))) (cop (csn c0s) c0)) $ >
  $ wceq L (ccom c1st F) $ >
  $ wceq R (ccom c2nd F) $ >
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wbr c0s A2 clts) $ >
  $ wi ph (wral xO (wi (wbr c0s (cv xO) clts) (wrex y1 (wceq (co (cv xO) (cv y1) cmuls) c1s) csur)) (cun (cfv A2 cleft) (cfv A2 cright))) $ >
  $ wi (wa ph (wcel I com)) (wa (wss (cfv I L) csur) (wss (cfv I R) csur)) $;

--| Lemma for surreal reciprocal. Show that the product of ` A ` and a left element is less than one and the product of ` A ` and a right element is greater than one. (Contributed by Scott Fenton, 14-Mar-2025.)
theorem precsexlem9 {x3 y1 r p a b c l xO xL xR yL yR: setvar} (ph: wff x3 y1 p b c l xO) (A2: class) (R: class x3 y1 p b xO) (F: class x3 y1 r a b c xO xL xR yL yR) (I: class x3 y1 r p a l xO xL xR yL yR) (L: class x3 y1 p c xO):
  $ wceq F (crdg (cmpt p cvv (csb l (cfv (cv p) c1st) (csb r (cfv (cv p) c2nd) (cop (cun (cv l) (cun (cab a (wrex xR (wrex yL (wceq (cv a) (co (co c1s (co (co (cv xR) A2 csubs) (cv yL) cmuls) cadds) (cv xR) cdivs)) (cv l)) (cfv A2 cright))) (cab a (wrex xL (wrex yR (wceq (cv a) (co (co c1s (co (co (cv xL) A2 csubs) (cv yR) cmuls) cadds) (cv xL) cdivs)) (cv r)) (crab x3 (wbr c0s (cv x3) clts) (cfv A2 cleft)))))) (cun (cv r) (cun (cab a (wrex xL (wrex yL (wceq (cv a) (co (co c1s (co (co (cv xL) A2 csubs) (cv yL) cmuls) cadds) (cv xL) cdivs)) (cv l)) (crab x3 (wbr c0s (cv x3) clts) (cfv A2 cleft)))) (cab a (wrex xR (wrex yR (wceq (cv a) (co (co c1s (co (co (cv xR) A2 csubs) (cv yR) cmuls) cadds) (cv xR) cdivs)) (cv r)) (cfv A2 cright))))))))) (cop (csn c0s) c0)) $ >
  $ wceq L (ccom c1st F) $ >
  $ wceq R (ccom c2nd F) $ >
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wbr c0s A2 clts) $ >
  $ wi ph (wral xO (wi (wbr c0s (cv xO) clts) (wrex y1 (wceq (co (cv xO) (cv y1) cmuls) c1s) csur)) (cun (cfv A2 cleft) (cfv A2 cright))) $ >
  $ wi (wa ph (wcel I com)) (wa (wral b (wbr (co A2 (cv b) cmuls) c1s clts) (cfv I L)) (wral c (wbr c1s (co A2 (cv c) cmuls) clts) (cfv I R))) $;

--| Lemma for surreal reciprocal. Show that the union of the left sets is less than the union of the right sets. Note that this is the first theorem in the surreal numbers to require the axiom of infinity. (Contributed by Scott Fenton, 15-Mar-2025.)
theorem precsexlem10 {x3 y1 r p a l xO xL xR yL yR: setvar} (ph: wff x3 y1 p l xO) (A2: class) (R: class x3 y1 p xO) (F: class x3 y1 r a xO xL xR yL yR) (L: class x3 y1 p xO):
  $ wceq F (crdg (cmpt p cvv (csb l (cfv (cv p) c1st) (csb r (cfv (cv p) c2nd) (cop (cun (cv l) (cun (cab a (wrex xR (wrex yL (wceq (cv a) (co (co c1s (co (co (cv xR) A2 csubs) (cv yL) cmuls) cadds) (cv xR) cdivs)) (cv l)) (cfv A2 cright))) (cab a (wrex xL (wrex yR (wceq (cv a) (co (co c1s (co (co (cv xL) A2 csubs) (cv yR) cmuls) cadds) (cv xL) cdivs)) (cv r)) (crab x3 (wbr c0s (cv x3) clts) (cfv A2 cleft)))))) (cun (cv r) (cun (cab a (wrex xL (wrex yL (wceq (cv a) (co (co c1s (co (co (cv xL) A2 csubs) (cv yL) cmuls) cadds) (cv xL) cdivs)) (cv l)) (crab x3 (wbr c0s (cv x3) clts) (cfv A2 cleft)))) (cab a (wrex xR (wrex yR (wceq (cv a) (co (co c1s (co (co (cv xR) A2 csubs) (cv yR) cmuls) cadds) (cv xR) cdivs)) (cv r)) (cfv A2 cright))))))))) (cop (csn c0s) c0)) $ >
  $ wceq L (ccom c1st F) $ >
  $ wceq R (ccom c2nd F) $ >
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wbr c0s A2 clts) $ >
  $ wi ph (wral xO (wi (wbr c0s (cv xO) clts) (wrex y1 (wceq (co (cv xO) (cv y1) cmuls) c1s) csur)) (cun (cfv A2 cleft) (cfv A2 cright))) $ >
  $ wi ph (wbr (cuni (cima L com)) (cuni (cima R com)) cslts) $;

--| Lemma for surreal reciprocal. Show that the cut of the left and right sets is a multiplicative inverse for ` A ` . (Contributed by Scott Fenton, 15-Mar-2025.)
theorem precsexlem11 {x3 y1 r p a l xO xL xR yL yR: setvar} (ph: wff x3 y1 p l xO) (A2: class) (R: class x3 y1 p xO) (F: class x3 y1 r a xO xL xR yL yR) (L: class x3 y1 p xO) (Y: class x3 y1 r p a l xO xL xR yL yR):
  $ wceq F (crdg (cmpt p cvv (csb l (cfv (cv p) c1st) (csb r (cfv (cv p) c2nd) (cop (cun (cv l) (cun (cab a (wrex xR (wrex yL (wceq (cv a) (co (co c1s (co (co (cv xR) A2 csubs) (cv yL) cmuls) cadds) (cv xR) cdivs)) (cv l)) (cfv A2 cright))) (cab a (wrex xL (wrex yR (wceq (cv a) (co (co c1s (co (co (cv xL) A2 csubs) (cv yR) cmuls) cadds) (cv xL) cdivs)) (cv r)) (crab x3 (wbr c0s (cv x3) clts) (cfv A2 cleft)))))) (cun (cv r) (cun (cab a (wrex xL (wrex yL (wceq (cv a) (co (co c1s (co (co (cv xL) A2 csubs) (cv yL) cmuls) cadds) (cv xL) cdivs)) (cv l)) (crab x3 (wbr c0s (cv x3) clts) (cfv A2 cleft)))) (cab a (wrex xR (wrex yR (wceq (cv a) (co (co c1s (co (co (cv xR) A2 csubs) (cv yR) cmuls) cadds) (cv xR) cdivs)) (cv r)) (cfv A2 cright))))))))) (cop (csn c0s) c0)) $ >
  $ wceq L (ccom c1st F) $ >
  $ wceq R (ccom c2nd F) $ >
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wbr c0s A2 clts) $ >
  $ wi ph (wral xO (wi (wbr c0s (cv xO) clts) (wrex y1 (wceq (co (cv xO) (cv y1) cmuls) c1s) csur)) (cun (cfv A2 cleft) (cfv A2 cright))) $ >
  $ wceq Y (co (cuni (cima L com)) (cuni (cima R com)) ccuts) $ >
  $ wi ph (wceq (co A2 Y cmuls) c1s) $;

--| Every positive surreal has a reciprocal. Theorem 10(iv) of [Conway] p. 21. (Contributed by Scott Fenton, 15-Mar-2025.)
theorem precsex {y1: setvar} (A2: class):
  $ wi (wa (wcel A2 csur) (wbr c0s A2 clts)) (wrex y1 (wceq (co A2 (cv y1) cmuls) c1s) csur) $;

--| A nonzero surreal has a reciprocal. (Contributed by Scott Fenton, 15-Mar-2025.)
theorem recsex {x3: setvar} (A2: class):
  $ wi (wa (wcel A2 csur) (wne A2 c0s)) (wrex x3 (wceq (co A2 (cv x3) cmuls) c1s) csur) $;

--| A nonzero surreal has a reciprocal. (Contributed by Scott Fenton, 16-Mar-2025.)
theorem recsexd {x3: setvar} (ph: wff x3) (A2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wne A2 c0s) $ >
  $ wi ph (wrex x3 (wceq (co A2 (cv x3) cmuls) c1s) csur) $;

--| Relationship between surreal division and multiplication. (Contributed by Scott Fenton, 16-Mar-2025.)
theorem divmuls (A2 B2 C: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wa (wcel C csur) (wne C c0s))) (wb (wceq (co A2 C cdivs) B2) (wceq (co C B2 cmuls) A2)) $;

--| Relationship between surreal division and multiplication. (Contributed by Scott Fenton, 16-Mar-2025.)
theorem divmulsd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wne C c0s) $ >
  $ wi ph (wb (wceq (co A2 C cdivs) B2) (wceq (co C B2 cmuls) A2)) $;

--| Surreal division closure law. (Contributed by Scott Fenton, 16-Mar-2025.)
theorem divscl (A2 B2: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wne B2 c0s)) (wcel (co A2 B2 cdivs) csur) $;

--| Surreal division closure law. (Contributed by Scott Fenton, 16-Mar-2025.)
theorem divscld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wne B2 c0s) $ >
  $ wi ph (wcel (co A2 B2 cdivs) csur) $;

--| A cancellation law for surreal division. (Contributed by Scott Fenton, 16-Mar-2025.)
theorem divscan2d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wne B2 c0s) $ >
  $ wi ph (wceq (co B2 (co A2 B2 cdivs) cmuls) A2) $;

--| A cancellation law for surreal division. (Contributed by Scott Fenton, 16-Mar-2025.)
theorem divscan1d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wne B2 c0s) $ >
  $ wi ph (wceq (co (co A2 B2 cdivs) B2 cmuls) A2) $;

--| Surreal less-than relationship between division and multiplication. (Contributed by Scott Fenton, 16-Mar-2025.)
theorem ltdivmulsd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wbr c0s C clts) $ >
  $ wi ph (wb (wbr (co A2 C cdivs) B2 clts) (wbr A2 (co C B2 cmuls) clts)) $;

--| Surreal less-than relationship between division and multiplication. (Contributed by Scott Fenton, 16-Mar-2025.)
theorem ltdivmuls2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wbr c0s C clts) $ >
  $ wi ph (wb (wbr (co A2 C cdivs) B2 clts) (wbr A2 (co B2 C cmuls) clts)) $;

--| Surreal less-than relationship between division and multiplication. (Contributed by Scott Fenton, 16-Mar-2025.)
theorem ltmuldivsd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wbr c0s C clts) $ >
  $ wi ph (wb (wbr (co A2 C cmuls) B2 clts) (wbr A2 (co B2 C cdivs) clts)) $;

--| Surreal less-than relationship between division and multiplication. (Contributed by Scott Fenton, 16-Mar-2025.)
theorem ltmuldivs2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wbr c0s C clts) $ >
  $ wi ph (wb (wbr (co C A2 cmuls) B2 clts) (wbr A2 (co B2 C cdivs) clts)) $;

--| An associative law for surreal division. (Contributed by Scott Fenton, 16-Mar-2025.)
theorem divsassd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wne C c0s) $ >
  $ wi ph (wceq (co (co A2 B2 cmuls) C cdivs) (co A2 (co B2 C cdivs) cmuls)) $;

--| Multiplication of two surreal ratios. (Contributed by Scott Fenton, 16-Apr-2025.)
theorem divmuldivsd (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wcel D csur) $ >
  $ wi ph (wne B2 c0s) $ >
  $ wi ph (wne D c0s) $ >
  $ wi ph (wceq (co (co A2 B2 cdivs) (co C D cdivs) cmuls) (co (co A2 C cmuls) (co B2 D cmuls) cdivs)) $;

--| Surreal division into a fraction. (Contributed by Scott Fenton, 7-Aug-2025.)
theorem divdivs1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wne B2 c0s) $ >
  $ wi ph (wne C c0s) $ >
  $ wi ph (wceq (co (co A2 B2 cdivs) C cdivs) (co A2 (co B2 C cmuls) cdivs)) $;

--| Relationship between surreal division and reciprocal. (Contributed by Scott Fenton, 13-Aug-2025.)
theorem divsrecd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wne B2 c0s) $ >
  $ wi ph (wceq (co A2 B2 cdivs) (co A2 (co c1s B2 cdivs) cmuls)) $;

--| Distribution of surreal division over addition. (Contributed by Scott Fenton, 13-Aug-2025.)
theorem divsdird (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wne C c0s) $ >
  $ wi ph (wceq (co (co A2 B2 cadds) C cdivs) (co (co A2 C cdivs) (co B2 C cdivs) cadds)) $;

--| A cancellation law for surreal division. (Contributed by Scott Fenton, 13-Aug-2025.)
theorem divscan3d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wne B2 c0s) $ >
  $ wi ph (wceq (co (co B2 A2 cmuls) B2 cdivs) A2) $;

--| Declare the syntax for surreal absolute value.
term cabss: class;

--| Define the surreal absolute value function. See ~ abssval for its value and ~ absscl for its closure. (Contributed by Scott Fenton, 16-Apr-2025.)
axiom df_abss {x3: setvar}:
  $ wceq cabss (cmpt x3 csur (cif (wbr c0s (cv x3) cles) (cv x3) (cfv (cv x3) cnegs))) $;

--| The value of surreal absolute value. (Contributed by Scott Fenton, 16-Apr-2025.)
theorem abssval (A2: class):
  $ wi (wcel A2 csur) (wceq (cfv A2 cabss) (cif (wbr c0s A2 cles) A2 (cfv A2 cnegs))) $;

--| Closure law for surreal absolute value. (Contributed by Scott Fenton, 16-Apr-2025.)
theorem absscl (A2: class):
  $ wi (wcel A2 csur) (wcel (cfv A2 cabss) csur) $;

--| The absolute value of a non-negative surreal is itself. (Contributed by Scott Fenton, 16-Apr-2025.)
theorem abssid (A2: class):
  $ wi (wa (wcel A2 csur) (wbr c0s A2 cles)) (wceq (cfv A2 cabss) A2) $;

--| The absolute value of surreal zero. (Contributed by Scott Fenton, 16-Apr-2025.)
theorem abs0s:
  $ wceq (cfv c0s cabss) c0s $;

--| For a negative surreal, its absolute value is its negation. (Contributed by Scott Fenton, 16-Apr-2025.)
theorem abssnid (A2: class):
  $ wi (wa (wcel A2 csur) (wbr A2 c0s cles)) (wceq (cfv A2 cabss) (cfv A2 cnegs)) $;

--| Surreal absolute value distributes over multiplication. (Contributed by Scott Fenton, 16-Apr-2025.)
theorem absmuls (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wceq (cfv (co A2 B2 cmuls) cabss) (co (cfv A2 cabss) (cfv B2 cabss) cmuls)) $;

--| The absolute value of a surreal number is non-negative. (Contributed by Scott Fenton, 16-Apr-2025.)
theorem abssge0 (A2: class):
  $ wi (wcel A2 csur) (wbr c0s (cfv A2 cabss) cles) $;

--| The absolute value of a surreal is either that surreal or its negative. (Contributed by Scott Fenton, 16-Apr-2025.)
theorem abssor (A2: class):
  $ wi (wcel A2 csur) (wo (wceq (cfv A2 cabss) A2) (wceq (cfv A2 cabss) (cfv A2 cnegs))) $;

--| Surreal absolute value of the negative. (Contributed by Scott Fenton, 16-Apr-2025.)
theorem absnegs (A2: class):
  $ wi (wcel A2 csur) (wceq (cfv (cfv A2 cnegs) cabss) (cfv A2 cabss)) $;

--| A surreal is less than or equal to its absolute value. (Contributed by Scott Fenton, 16-Apr-2025.)
theorem leabss (A2: class):
  $ wi (wcel A2 csur) (wbr A2 (cfv A2 cabss) cles) $;

--| Surreal absolute value and less-than relation. (Contributed by Scott Fenton, 16-Apr-2025.)
theorem abslts (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wb (wbr (cfv A2 cabss) B2 clts) (wa (wbr (cfv B2 cnegs) A2 clts) (wbr A2 B2 clts))) $;

--| Swapping order of surreal subtraction doesn't change the absolute value. (Contributed by Scott Fenton, 29-Jan-2026.)
theorem abssubs (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wceq (cfv (co A2 B2 csubs) cabss) (cfv (co B2 A2 csubs) cabss)) $;

--| Declare the syntax for surreal ordinals.
term cons: class;

--| Define the surreal ordinals. These are the maximum members of each generation of surreals. Variant of definition from [Conway] p. 27. (Contributed by Scott Fenton, 18-Mar-2025.)
axiom df_ons {x3: setvar}:
  $ wceq cons (crab x3 (wceq (cfv (cv x3) cright) c0) csur) $;

--| Membership in the class of surreal ordinals. (Contributed by Scott Fenton, 18-Mar-2025.)
theorem elons (A2: class):
  $ wb (wcel A2 cons) (wa (wcel A2 csur) (wceq (cfv A2 cright) c0)) $;

--| The surreal ordinals are a subclass of the surreals. (Contributed by Scott Fenton, 18-Mar-2025.)
theorem onssno:
  $ wss cons csur $;

--| A surreal ordinal is a surreal. (Contributed by Scott Fenton, 18-Mar-2025.)
theorem onno (A2: class):
  $ wi (wcel A2 cons) (wcel A2 csur) $;

--| Surreal zero is a surreal ordinal. (Contributed by Scott Fenton, 18-Mar-2025.)
theorem _0ons:
  $ wcel c0s cons $;

--| Surreal one is a surreal ordinal. (Contributed by Scott Fenton, 18-Mar-2025.)
theorem _1ons:
  $ wcel c1s cons $;

--| A surreal is ordinal iff it is the cut of some set of surreals and the empty set. Definition from [Conway] p. 27. (Contributed by Scott Fenton, 19-Mar-2025.)
theorem elons2 {a: setvar} (A2: class):
  $ wb (wcel A2 cons) (wrex a (wceq A2 (co (cv a) c0 ccuts)) (cpw csur)) $;

--| The cut of any set of surreals and the empty set is a surreal ordinal. (Contributed by Scott Fenton, 19-Mar-2025.)
theorem elons2d (ph: wff) (A2 V X: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wss A2 csur) $ >
  $ wi ph (wceq X (co A2 c0 ccuts)) $ >
  $ wi ph (wcel X cons) $;

--| The left set of a surreal ordinal is the same as its old set. (Contributed by Scott Fenton, 6-Nov-2025.)
theorem onleft (A2: class):
  $ wi (wcel A2 cons) (wceq (cfv (cfv A2 cbday) cold) (cfv A2 cleft)) $;

--| The class of ordinals less than any surreal is a subset of that surreal's old set. (Contributed by Scott Fenton, 22-Mar-2025.)
theorem ltonold {x3: setvar} (A2: class):
  $ wi (wcel A2 csur) (wss (crab x3 (wbr (cv x3) A2 clts) cons) (cfv (cfv A2 cbday) cold)) $;

--| The class of ordinals less than any particular surreal is a set. Theorem 14 of [Conway] p. 27. (Contributed by Scott Fenton, 22-Mar-2025.)
theorem ltonsex {x3: setvar} (A2: class):
  $ wi (wcel A2 csur) (wcel (crab x3 (wbr (cv x3) A2 clts) cons) cvv) $;

--| A surreal ordinal is equal to the cut of its left set and the empty set. (Contributed by Scott Fenton, 29-Mar-2025.)
theorem oncutleft (A2: class):
  $ wi (wcel A2 cons) (wceq A2 (co (cfv A2 cleft) c0 ccuts)) $;

--| A surreal ordinal is the simplest number greater than all previous surreal ordinals. Theorem 15 of [Conway] p. 28. (Contributed by Scott Fenton, 4-Nov-2025.)
theorem oncutlt {x3: setvar} (A2: class):
  $ wi (wcel A2 cons) (wceq A2 (co (crab x3 (wbr (cv x3) A2 clts) cons) c0 ccuts)) $;

--| The birthday function is one-to-one over the surreal ordinals. (Contributed by Scott Fenton, 6-Nov-2025.)
theorem bday11on (A2 B2: class):
  $ wi (w3a (wcel A2 cons) (wcel B2 cons) (wceq (cfv A2 cbday) (cfv B2 cbday))) (wceq A2 B2) $;

--| If a surreal ordinal is less than a given surreal, then it is simpler. (Contributed by Scott Fenton, 7-Nov-2025.)
theorem onnolt (A2 B2: class):
  $ wi (w3a (wcel A2 cons) (wcel B2 csur) (wbr A2 B2 clts)) (wcel (cfv A2 cbday) (cfv B2 cbday)) $;

--| Less-than is the same as birthday comparison over surreal ordinals. (Contributed by Scott Fenton, 7-Nov-2025.)
theorem onlts (A2 B2: class):
  $ wi (wa (wcel A2 cons) (wcel B2 cons)) (wb (wbr A2 B2 clts) (wcel (cfv A2 cbday) (cfv B2 cbday))) $;

--| Less-than or equal is the same as non-strict birthday comparison over surreal ordinals. (Contributed by Scott Fenton, 25-Feb-2026.)
theorem onles (A2 B2: class):
  $ wi (wa (wcel A2 cons) (wcel B2 cons)) (wb (wbr A2 B2 cles) (wss (cfv A2 cbday) (cfv B2 cbday))) $;

--| Less-than is the same as birthday comparison over surreal ordinals. Deduction version. (Contributed by Scott Fenton, 25-Feb-2026.)
theorem onltsd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cons) $ >
  $ wi ph (wcel B2 cons) $ >
  $ wi ph (wb (wbr A2 B2 clts) (wcel (cfv A2 cbday) (cfv B2 cbday))) $;

--| Less-than or equal is the same as non-strict birthday comparison over surreal ordinals. Deduction version. (Contributed by Scott Fenton, 25-Feb-2026.)
theorem onlesd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 cons) $ >
  $ wi ph (wcel B2 cons) $ >
  $ wi ph (wb (wbr A2 B2 cles) (wss (cfv A2 cbday) (cfv B2 cbday))) $;

--| The birthday function restricted to the surreal ordinals forms an order-preserving isomorphism with the regular ordinals. (Contributed by Scott Fenton, 8-Nov-2025.)
theorem oniso:
  $ wiso cons con0 clts cep (cres cbday cons) $;

--| Surreal less-than well-orders the surreal ordinals. Part of Theorem 15 of [Conway] p. 28. (Contributed by Scott Fenton, 6-Nov-2025.)
theorem onswe:
  $ wwe cons clts $;

--| Surreal less-than is set-like over the surreal ordinals. (Contributed by Scott Fenton, 6-Nov-2025.)
theorem onsse:
  $ wse cons clts $;

--| Transfinite induction schema for surreal ordinals. (Contributed by Scott Fenton, 6-Nov-2025.)
theorem onsis {x3 y1: setvar} (ph: wff x3) (ps ch: wff y1) (A2: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wceq (cv x3) A2) (wb ph ch) $ >
  $ wi (wcel (cv x3) cons) (wi (wral y1 (wi (wbr (cv y1) (cv x3) clts) ps) cons) ph) $ >
  $ wi (wcel A2 cons) ch $;

--| Double induction schema for surreal ordinals. (Contributed by Scott Fenton, 22-Feb-2026.)
theorem ons2ind {x3 y1 xO yO: setvar} (ph: wff x3 y1 yO) (ps: wff y1 xO) (ch: wff x3 xO yO) (th: wff x3 y1 yO) (ta: wff y1 xO yO) (et: wff x3 xO yO) (A2: class xO yO) (B2: class x3 xO yO):
  $ wi (wceq (cv x3) (cv xO)) (wb ph ps) $ >
  $ wi (wceq (cv y1) (cv yO)) (wb ps ch) $ >
  $ wi (wceq (cv x3) (cv xO)) (wb th ch) $ >
  $ wi (wceq (cv x3) A2) (wb ph ta) $ >
  $ wi (wceq (cv y1) B2) (wb ta et) $ >
  $ wi (wa (wcel (cv x3) cons) (wcel (cv y1) cons)) (wi (w3a (wral xO (wral yO (wi (wa (wbr (cv xO) (cv x3) clts) (wbr (cv yO) (cv y1) clts)) ch) cons) cons) (wral xO (wi (wbr (cv xO) (cv x3) clts) ps) cons) (wral yO (wi (wbr (cv yO) (cv y1) clts) th) cons)) ph) $ >
  $ wi (wa (wcel A2 cons) (wcel B2 cons)) et $;

--| The birthday of a surreal ordinal is the set of all previous ordinal birthdays. (Contributed by Scott Fenton, 7-Nov-2025.)
theorem bdayons {x3: setvar} (A2: class):
  $ wi (wcel A2 cons) (wceq (cfv A2 cbday) (cima cbday (crab x3 (wbr (cv x3) A2 clts) cons))) $;

--| The surreal ordinals are closed under addition. (Contributed by Scott Fenton, 22-Aug-2025.)
theorem onaddscl (A2 B2: class):
  $ wi (wa (wcel A2 cons) (wcel B2 cons)) (wcel (co A2 B2 cadds) cons) $;

--| The surreal ordinals are closed under multiplication. (Contributed by Scott Fenton, 22-Aug-2025.)
theorem onmulscl (A2 B2: class):
  $ wi (wa (wcel A2 cons) (wcel B2 cons)) (wcel (co A2 B2 cmuls) cons) $;

--| The birthday of the sum of two ordinals is the natural sum of their birthdays. (Contributed by Scott Fenton, 22-Feb-2026.)
theorem addonbday (A2 B2: class):
  $ wi (wa (wcel A2 cons) (wcel B2 cons)) (wceq (cfv (co A2 B2 cadds) cbday) (co (cfv A2 cbday) (cfv B2 cbday) cnadd)) $;

--| The successor of a surreal ordinal is a surreal ordinal. (Contributed by Scott Fenton, 22-Aug-2025.)
theorem peano2ons (A2: class):
  $ wi (wcel A2 cons) (wcel (co A2 c1s cadds) cons) $;

--| The surreals of a given birthday are bounded above by that ordinal. (Contributed by Scott Fenton, 22-Feb-2026.)
theorem onsbnd (A2 B2: class):
  $ wi (wa (wcel A2 cons) (wcel B2 (cfv (cfv A2 cbday) cmade))) (wbr B2 A2 cles) $;

--| The surreals of a given birthday are bounded below by the negative of that ordinal. (Contributed by Scott Fenton, 22-Feb-2026.)
theorem onsbnd2 (A2 B2: class):
  $ wi (wa (wcel A2 cons) (wcel B2 (cfv (cfv A2 cbday) cmade))) (wbr (cfv A2 cnegs) B2 cles) $;

--| Extend class notation with the surreal recursive sequence builder.
term cseqs (c_pl F M: class): class;

--| Define a general-purpose sequence builder for surreal numbers. Compare ~ df-seq . Note that in the theorems we develop here, we do not require ` M ` to be an integer. This is because there are infinite surreal numbers and we may want to start our sequence there. (Contributed by Scott Fenton, 18-Apr-2025.)
axiom df_seqs {x3 y1: setvar} (c_pl F M: class):
  $ wceq (cseqs c_pl F M) (cima (crdg (cmpo x3 y1 cvv cvv (cop (co (cv x3) c1s cadds) (co (cv y1) (cfv (co (cv x3) c1s cadds) F) c_pl))) (cop M (cfv M F))) com) $;

--| Existence of the surreal sequence builder operation. (Contributed by Scott Fenton, 18-Apr-2025.)
theorem seqsex (c_pl F M: class):
  $ wcel (cseqs c_pl F M) cvv $;

--| Equality deduction for the surreal sequence builder. (Contributed by Scott Fenton, 18-Apr-2025.)
theorem seqseq123d (ph: wff) (c_pl Q F G M N: class):
  $ wi ph (wceq M N) $ >
  $ wi ph (wceq c_pl Q) $ >
  $ wi ph (wceq F G) $ >
  $ wi ph (wceq (cseqs c_pl F M) (cseqs Q G N)) $;

--| Hypothesis builder for the surreal sequence builder. (Contributed by Scott Fenton, 18-Apr-2025.)
theorem nfseqs {x3: setvar} (c_pl F M: class x3):
  $ wnfc x3 M $ >
  $ wnfc x3 c_pl $ >
  $ wnfc x3 F $ >
  $ wnfc x3 (cseqs c_pl F M) $;

--| The value of the surreal sequence builder. (Contributed by Scott Fenton, 18-Apr-2025.)
theorem seqsval {x3 y1 z w: setvar} (ph: wff x3 y1 z w) (c_pl: class) (R: class x3 y1 z w) (F: class) (M: class z w):
  $ wi ph (wceq R (cres (crdg (cmpo x3 y1 cvv cvv (cop (co (cv x3) c1s cadds) (co (cv x3) (cv y1) (cmpo z w cvv cvv (co (cv w) (cfv (co (cv z) c1s cadds) F) c_pl))))) (cop M (cfv M F))) com)) $ >
  $ wi ph (wceq (cseqs c_pl F M) (crn R)) $;

--| The next several theorems develop the concept of a countable sequence of surreals. This set is denoted by ` Z ` here and is the analogue of the upper integer sets for surreal numbers. However, we do not require the starting point to be an integer so we can accommodate infinite numbers. This first theorem establishes that ` Z ` is a set. (Contributed by Scott Fenton, 18-Apr-2025.)
theorem noseqex {x3: setvar} (ph: wff x3) (A2 Z: class x3):
  $ wi ph (wceq Z (cima (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) A2) com)) $ >
  $ wi ph (wcel Z cvv) $;

--| The surreal ` A ` is a member of the sequence starting at ` A ` . (Contributed by Scott Fenton, 18-Apr-2025.)
theorem noseq0 {x3: setvar} (ph: wff x3) (A2 Z: class x3):
  $ wi ph (wceq Z (cima (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) A2) com)) $ >
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel A2 Z) $;

--| One plus an element of ` Z ` is an element of ` Z ` . (Contributed by Scott Fenton, 18-Apr-2025.)
theorem noseqp1 {x3: setvar} (ph: wff x3) (A2: class x3) (B2: class) (Z: class x3):
  $ wi ph (wceq Z (cima (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) A2) com)) $ >
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 Z) $ >
  $ wi ph (wcel (co B2 c1s cadds) Z) $;

--| Peano's inductive postulate for surreal sequences. (Contributed by Scott Fenton, 18-Apr-2025.)
theorem noseqind {x3 y1: setvar} (ph: wff x3) (A2 B2: class x3) (Z: class x3 y1):
  $ wi ph (wceq Z (cima (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) A2) com)) $ >
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel A2 B2) $ >
  $ wi (wa ph (wcel (cv y1) B2)) (wcel (co (cv y1) c1s cadds) B2) $ >
  $ wi ph (wss Z B2) $;

--| Induction schema for surreal sequences. (Contributed by Scott Fenton, 18-Apr-2025.)
theorem noseqinds {x3 y1 z: setvar} (ph ps: wff x3 y1) (ch th ta et: wff x3 z) (A2: class x3) (B2: class x3 z) (Z: class x3):
  $ wi ph (wceq Z (cima (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) A2) com)) $ >
  $ wi ph (wcel A2 csur) $ >
  $ wi (wceq (cv y1) A2) (wb ps ch) $ >
  $ wi (wceq (cv y1) (cv z)) (wb ps th) $ >
  $ wi (wceq (cv y1) (co (cv z) c1s cadds)) (wb ps ta) $ >
  $ wi (wceq (cv y1) B2) (wb ps et) $ >
  $ wi ph ch $ >
  $ wi (wa ph (wcel (cv z) Z)) (wi th ta) $ >
  $ wi (wa ph (wcel B2 Z)) et $;

--| A surreal sequence is a subset of the surreals. (Contributed by Scott Fenton, 18-Apr-2025.)
theorem noseqssno {x3: setvar} (ph: wff x3) (A2 Z: class x3):
  $ wi ph (wceq Z (cima (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) A2) com)) $ >
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wss Z csur) $;

--| An element of a surreal sequence is a surreal. (Contributed by Scott Fenton, 18-Apr-2025.)
theorem noseqno {x3: setvar} (ph: wff x3) (A2 B2 Z: class x3):
  $ wi ph (wceq Z (cima (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) A2) com)) $ >
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 Z) $ >
  $ wi ph (wcel B2 csur) $;

--| The mapping ` G ` is a one-to-one mapping from ` _om ` onto a countable sequence of surreals that will be used to show the properties of ` seq_s ` . This theorem shows the value of ` G ` at ordinal zero. Compare the series of theorems starting at ~ om2uz0i . (Contributed by Scott Fenton, 18-Apr-2025.)
theorem om2noseq0 {x3: setvar} (ph: wff x3) (C G: class x3):
  $ wi ph (wcel C csur) $ >
  $ wi ph (wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) C) com)) $ >
  $ wi ph (wceq (cfv c0 G) C) $;

--| The value of ` G ` at a successor. (Contributed by Scott Fenton, 18-Apr-2025.)
theorem om2noseqsuc {x3: setvar} (ph: wff x3) (A2: class x3) (C: class) (G: class x3):
  $ wi ph (wcel C csur) $ >
  $ wi ph (wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) C) com)) $ >
  $ wi ph (wcel A2 com) $ >
  $ wi ph (wceq (cfv (csuc A2) G) (co (cfv A2 G) c1s cadds)) $;

--| Function statement for ` G ` . (Contributed by Scott Fenton, 18-Apr-2025.)
theorem om2noseqfo {x3: setvar} (ph: wff x3) (C G Z: class x3):
  $ wi ph (wcel C csur) $ >
  $ wi ph (wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) C) com)) $ >
  $ wi ph (wceq Z (cima (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) C) com)) $ >
  $ wi ph (wfo com Z G) $;

--| Surreal less-than relation for ` G ` . (Contributed by Scott Fenton, 18-Apr-2025.)
theorem om2noseqlt {x3: setvar} (ph: wff x3) (A2 B2: class x3) (C: class) (G Z: class x3):
  $ wi ph (wcel C csur) $ >
  $ wi ph (wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) C) com)) $ >
  $ wi ph (wceq Z (cima (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) C) com)) $ >
  $ wi (wa ph (wa (wcel A2 com) (wcel B2 com))) (wi (wcel A2 B2) (wbr (cfv A2 G) (cfv B2 G) clts)) $;

--| The mapping ` G ` preserves order. (Contributed by Scott Fenton, 18-Apr-2025.)
theorem om2noseqlt2 {x3: setvar} (ph: wff x3) (A2 B2: class x3) (C: class) (G Z: class x3):
  $ wi ph (wcel C csur) $ >
  $ wi ph (wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) C) com)) $ >
  $ wi ph (wceq Z (cima (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) C) com)) $ >
  $ wi (wa ph (wa (wcel A2 com) (wcel B2 com))) (wb (wcel A2 B2) (wbr (cfv A2 G) (cfv B2 G) clts)) $;

--| ` G ` is a bijection. (Contributed by Scott Fenton, 18-Apr-2025.)
theorem om2noseqf1o {x3: setvar} (ph: wff x3) (C: class) (G Z: class x3):
  $ wi ph (wcel C csur) $ >
  $ wi ph (wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) C) com)) $ >
  $ wi ph (wceq Z (cima (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) C) com)) $ >
  $ wi ph (wf1o com Z G) $;

--| ` G ` is an isomorphism from the finite ordinals to a surreal sequence. (Contributed by Scott Fenton, 18-Apr-2025.)
theorem om2noseqiso {x3: setvar} (ph: wff x3) (C: class) (G Z: class x3):
  $ wi ph (wcel C csur) $ >
  $ wi ph (wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) C) com)) $ >
  $ wi ph (wceq Z (cima (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) C) com)) $ >
  $ wi ph (wiso com Z cep clts G) $;

--| An alternative definition of ` G ` in terms of ~ df-oi . (Contributed by Scott Fenton, 18-Apr-2025.)
theorem om2noseqoi {x3: setvar} (ph: wff x3) (C: class) (G Z: class x3):
  $ wi ph (wcel C csur) $ >
  $ wi ph (wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) C) com)) $ >
  $ wi ph (wceq Z (cima (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) C) com)) $ >
  $ wi ph (wceq G (coi Z clts)) $;

--| A helper lemma for the value of a recursive definition generator on a surreal sequence with characteristic function ` F ( x , y ) ` and initial value ` A ` . (Contributed by Scott Fenton, 18-Apr-2025.)
theorem om2noseqrdg {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1) (C: class y1) (R: class x3 y1) (F: class) (G V Z: class x3 y1):
  $ wi ph (wcel C csur) $ >
  $ wi ph (wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) C) com)) $ >
  $ wi ph (wceq Z (cima (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) C) com)) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wceq R (cres (crdg (cmpo x3 y1 cvv cvv (cop (co (cv x3) c1s cadds) (co (cv x3) (cv y1) F))) (cop C A2)) com)) $ >
  $ wi (wa ph (wcel B2 com)) (wceq (cfv B2 R) (cop (cfv B2 G) (cfv (cfv B2 R) c2nd))) $;

--| A helper lemma for the value of a recursive defintion generator on surreal sequences. (Contributed by Scott Fenton, 18-Apr-2025.)
theorem noseqrdglem {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class x3 y1) (C: class y1) (R: class x3 y1) (F: class) (G V Z: class x3 y1):
  $ wi ph (wcel C csur) $ >
  $ wi ph (wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) C) com)) $ >
  $ wi ph (wceq Z (cima (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) C) com)) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wceq R (cres (crdg (cmpo x3 y1 cvv cvv (cop (co (cv x3) c1s cadds) (co (cv x3) (cv y1) F))) (cop C A2)) com)) $ >
  $ wi (wa ph (wcel B2 Z)) (wcel (cop B2 (cfv (cfv (cfv B2 (ccnv G)) R) c2nd)) (crn R)) $;

--| The recursive definition generator on surreal sequences is a function. (Contributed by Scott Fenton, 18-Apr-2025.)
theorem noseqrdgfn {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1) (C: class y1) (R S: class x3 y1) (F: class) (G V Z: class x3 y1):
  $ wi ph (wcel C csur) $ >
  $ wi ph (wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) C) com)) $ >
  $ wi ph (wceq Z (cima (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) C) com)) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wceq R (cres (crdg (cmpo x3 y1 cvv cvv (cop (co (cv x3) c1s cadds) (co (cv x3) (cv y1) F))) (cop C A2)) com)) $ >
  $ wi ph (wceq S (crn R)) $ >
  $ wi ph (wfn S Z) $;

--| Initial value of a recursive definition generator on surreal sequences. (Contributed by Scott Fenton, 18-Apr-2025.)
theorem noseqrdg0 {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1) (C: class y1) (R S: class x3 y1) (F: class) (G V Z: class x3 y1):
  $ wi ph (wcel C csur) $ >
  $ wi ph (wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) C) com)) $ >
  $ wi ph (wceq Z (cima (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) C) com)) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wceq R (cres (crdg (cmpo x3 y1 cvv cvv (cop (co (cv x3) c1s cadds) (co (cv x3) (cv y1) F))) (cop C A2)) com)) $ >
  $ wi ph (wceq S (crn R)) $ >
  $ wi ph (wceq (cfv C S) A2) $;

--| Successor value of a recursive definition generator on surreal sequences. (Contributed by Scott Fenton, 19-Apr-2025.)
theorem noseqrdgsuc {x3 y1: setvar} (ph: wff x3 y1) (A2: class x3 y1) (B2 C: class y1) (R S: class x3 y1) (F: class) (G V Z: class x3 y1):
  $ wi ph (wcel C csur) $ >
  $ wi ph (wceq G (cres (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) C) com)) $ >
  $ wi ph (wceq Z (cima (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) C) com)) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wceq R (cres (crdg (cmpo x3 y1 cvv cvv (cop (co (cv x3) c1s cadds) (co (cv x3) (cv y1) F))) (cop C A2)) com)) $ >
  $ wi ph (wceq S (crn R)) $ >
  $ wi (wa ph (wcel B2 Z)) (wceq (cfv (co B2 c1s cadds) S) (co B2 (cfv B2 S) F)) $;

--| The surreal sequence builder is a function. (Contributed by Scott Fenton, 19-Apr-2025.)
theorem seqsfn {x3: setvar} (ph: wff x3) (c_pl F M Z: class x3):
  $ wi ph (wcel M csur) $ >
  $ wi ph (wceq Z (cima (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) M) com)) $ >
  $ wi ph (wfn (cseqs c_pl F M) Z) $;

--| The value of the surreal sequence builder function at its initial value. (Contributed by Scott Fenton, 19-Apr-2025.)
theorem seqs1 (ph: wff) (c_pl F M: class):
  $ wi ph (wcel M csur) $ >
  $ wi ph (wceq (cfv M (cseqs c_pl F M)) (cfv M F)) $;

--| The value of the surreal sequence builder at a successor. (Contributed by Scott Fenton, 19-Apr-2025.)
theorem seqsp1 {x3: setvar} (ph: wff x3) (c_pl F M N Z: class x3):
  $ wi ph (wcel M csur) $ >
  $ wi ph (wceq Z (cima (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) M) com)) $ >
  $ wi ph (wcel N Z) $ >
  $ wi ph (wceq (cfv (co N c1s cadds) (cseqs c_pl F M)) (co (cfv N (cseqs c_pl F M)) (cfv (co N c1s cadds) F) c_pl)) $;

--| Declare the syntax for surreal non-negative integers.
term cn0s: class;

--| Declare the syntax for surreal positive integers.
term cnns: class;

--| Define the set of non-negative surreal integers. This set behaves similarly to ` _om ` and ` NN0 ` , but it is a set of surreal numbers. Like those two sets, it satisfies the Peano axioms and is closed under (surreal) addition and multiplication. Compare ~ df-nn . (Contributed by Scott Fenton, 17-Mar-2025.)
axiom df_n0s {x3: setvar}:
  $ wceq cn0s (cima (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) c0s) com) $;

--| Define the set of positive surreal integers. (Contributed by Scott Fenton, 17-Mar-2025.)
axiom df_nns:
  $ wceq cnns (cdif cn0s (csn c0s)) $;

--| The set of all non-negative surreal integers exists. This theorem avoids the axiom of infinity by including it as an antecedent. (Contributed by Scott Fenton, 20-Feb-2025.)
theorem n0sexg:
  $ wi (wcel com cvv) (wcel cn0s cvv) $;

--| The set of all non-negative surreal integers exists. (Contributed by Scott Fenton, 17-Mar-2025.)
theorem n0sex:
  $ wcel cn0s cvv $;

--| The set of all positive surreal integers exists. (Contributed by Scott Fenton, 17-Mar-2025.)
theorem nnsex:
  $ wcel cnns cvv $;

--| Peano's inductive postulate for non-negative surreal integers. (Contributed by Scott Fenton, 17-Mar-2025.)
theorem peano5n0s {x3: setvar} (A2: class):
  $ wi (wa (wcel c0s A2) (wral x3 (wcel (co (cv x3) c1s cadds) A2) A2)) (wss cn0s A2) $;

--| The non-negative surreal integers are a subset of the surreals. (Contributed by Scott Fenton, 17-Mar-2025.)
theorem n0ssno:
  $ wss cn0s csur $;

--| The positive surreal integers are a subset of the non-negative surreal integers. (Contributed by Scott Fenton, 17-Mar-2025.)
theorem nnssn0s:
  $ wss cnns cn0s $;

--| The positive surreal integers are a subset of the surreals. (Contributed by Scott Fenton, 17-Mar-2025.)
theorem nnssno:
  $ wss cnns csur $;

--| A non-negative surreal integer is a surreal. (Contributed by Scott Fenton, 15-Apr-2025.)
theorem n0no (A2: class):
  $ wi (wcel A2 cn0s) (wcel A2 csur) $;

--| A positive surreal integer is a surreal. (Contributed by Scott Fenton, 15-Apr-2025.)
theorem nnno (A2: class):
  $ wi (wcel A2 cnns) (wcel A2 csur) $;

--| A non-negative surreal integer is a surreal. (Contributed by Scott Fenton, 15-Apr-2025.)
theorem n0nod (ph: wff) (A2: class):
  $ wi ph (wcel A2 cn0s) $ >
  $ wi ph (wcel A2 csur) $;

--| A positive surreal integer is a surreal. (Contributed by Scott Fenton, 15-Apr-2025.)
theorem nnnod (ph: wff) (A2: class):
  $ wi ph (wcel A2 cnns) $ >
  $ wi ph (wcel A2 csur) $;

--| A positive surreal integer is a non-negative surreal integer. (Contributed by Scott Fenton, 26-May-2025.)
theorem nnn0s (A2: class):
  $ wi (wcel A2 cnns) (wcel A2 cn0s) $;

--| A positive surreal integer is a non-negative surreal integer. (Contributed by Scott Fenton, 26-May-2025.)
theorem nnn0sd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cnns) $ >
  $ wi ph (wcel A2 cn0s) $;

--| Peano postulate: ` 0s ` is a non-negative surreal integer. (Contributed by Scott Fenton, 17-Mar-2025.)
theorem _0n0s:
  $ wcel c0s cn0s $;

--| Peano postulate: the successor of a non-negative surreal integer is a non-negative surreal integer. (Contributed by Scott Fenton, 17-Mar-2025.)
theorem peano2n0s (A2: class):
  $ wi (wcel A2 cn0s) (wcel (co A2 c1s cadds) cn0s) $;

--| Peano postulate: the successor of a non-negative surreal integer is a non-negative surreal integer. Deduction form. (Contributed by Scott Fenton, 27-Feb-2026.)
theorem peano2n0sd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cn0s) $ >
  $ wi ph (wcel (co A2 c1s cadds) cn0s) $;

--| Alternate definition of the set of non-negative surreal integers. (Contributed by Scott Fenton, 17-Mar-2025.)
theorem dfn0s2 {x3 y1: setvar}:
  $ wceq cn0s (cint (cab x3 (wa (wcel c0s (cv x3)) (wral y1 (wcel (co (cv y1) c1s cadds) (cv x3)) (cv x3))))) $;

--| Principle of Mathematical Induction (inference schema). Compare ~ nnind and ~ finds . (Contributed by Scott Fenton, 17-Mar-2025.)
theorem n0sind {x3 y1: setvar} (ph: wff x3) (ps ch th ta: wff y1) (A2: class y1):
  $ wi (wceq (cv x3) c0s) (wb ph ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ch) $ >
  $ wi (wceq (cv x3) (co (cv y1) c1s cadds)) (wb ph th) $ >
  $ wi (wceq (cv x3) A2) (wb ph ta) $ >
  $ ps $ >
  $ wi (wcel (cv y1) cn0s) (wi ch th) $ >
  $ wi (wcel A2 cn0s) ta $;

--| A cut form for non-negative surreal integers. (Contributed by Scott Fenton, 2-Apr-2025.)
theorem n0cut (A2: class):
  $ wi (wcel A2 cn0s) (wceq A2 (co (csn (co A2 c1s csubs)) c0 ccuts)) $;

--| A cut form for the successor of a non-negative surreal integer. (Contributed by Scott Fenton, 7-Nov-2025.)
theorem n0cut2 (A2: class):
  $ wi (wcel A2 cn0s) (wceq (co A2 c1s cadds) (co (csn A2) c0 ccuts)) $;

--| A surreal natural is a surreal ordinal. (Contributed by Scott Fenton, 2-Apr-2025.)
theorem n0on (A2: class):
  $ wi (wcel A2 cn0s) (wcel A2 cons) $;

--| A surreal positive integer is nonzero. (Contributed by Scott Fenton, 15-Apr-2025.)
theorem nnne0s (A2: class):
  $ wi (wcel A2 cnns) (wne A2 c0s) $;

--| A non-negative integer is greater than or equal to zero. (Contributed by Scott Fenton, 15-Apr-2025.)
theorem n0sge0 (A2: class):
  $ wi (wcel A2 cn0s) (wbr c0s A2 cles) $;

--| A positive integer is greater than zero. (Contributed by Scott Fenton, 15-Apr-2025.)
theorem nnsgt0 (A2: class):
  $ wi (wcel A2 cnns) (wbr c0s A2 clts) $;

--| Membership in the positive surreal integers. (Contributed by Scott Fenton, 15-Apr-2025.)
theorem elnns (A2: class):
  $ wb (wcel A2 cnns) (wa (wcel A2 cn0s) (wne A2 c0s)) $;

--| A positive surreal integer is a non-negative surreal integer greater than zero. (Contributed by Scott Fenton, 15-Apr-2025.)
theorem elnns2 (A2: class):
  $ wb (wcel A2 cnns) (wa (wcel A2 cn0s) (wbr c0s A2 clts)) $;

--| A non-negative surreal integer is either zero or a successor. (Contributed by Scott Fenton, 26-Jul-2025.)
theorem n0s0suc {x3: setvar} (A2: class):
  $ wi (wcel A2 cn0s) (wo (wceq A2 c0s) (wrex x3 (wceq A2 (co (cv x3) c1s cadds)) cn0s)) $;

--| A positive surreal integer is greater than or equal to one. (Contributed by Scott Fenton, 26-Jul-2025.)
theorem nnsge1 (N: class):
  $ wi (wcel N cnns) (wbr c1s N cles) $;

--| The non-negative surreal integers are closed under addition. (Contributed by Scott Fenton, 15-Apr-2025.)
theorem n0addscl (A2 B2: class):
  $ wi (wa (wcel A2 cn0s) (wcel B2 cn0s)) (wcel (co A2 B2 cadds) cn0s) $;

--| The non-negative surreal integers are closed under multiplication. (Contributed by Scott Fenton, 15-Apr-2025.)
theorem n0mulscl (A2 B2: class):
  $ wi (wa (wcel A2 cn0s) (wcel B2 cn0s)) (wcel (co A2 B2 cmuls) cn0s) $;

--| The positive surreal integers are closed under addition. (Contributed by Scott Fenton, 15-Apr-2025.)
theorem nnaddscl (A2 B2: class):
  $ wi (wa (wcel A2 cnns) (wcel B2 cnns)) (wcel (co A2 B2 cadds) cnns) $;

--| The positive surreal integers are closed under multiplication. (Contributed by Scott Fenton, 15-Apr-2025.)
theorem nnmulscl (A2 B2: class):
  $ wi (wa (wcel A2 cnns) (wcel B2 cnns)) (wcel (co A2 B2 cmuls) cnns) $;

--| Surreal one is a non-negative surreal integer. (Contributed by Scott Fenton, 15-Apr-2025.)
theorem _1n0s:
  $ wcel c1s cn0s $;

--| Surreal one is a positive surreal integer. (Contributed by Scott Fenton, 15-Apr-2025.)
theorem _1nns:
  $ wcel c1s cnns $;

--| Peano postulate for positive surreal integers. One plus a positive surreal integer is a positive surreal integer. (Contributed by Scott Fenton, 15-Apr-2025.)
theorem peano2nns (A2: class):
  $ wi (wcel A2 cnns) (wcel (co A2 c1s cadds) cnns) $;

--| The reciprocal of a positive surreal integer is positive. (Contributed by Scott Fenton, 19-Apr-2025.)
theorem nnsrecgt0d (ph: wff) (A2: class):
  $ wi ph (wcel A2 cnns) $ >
  $ wi ph (wbr c0s (co c1s A2 cdivs) clts) $;

--| A non-negative surreal integer has a finite birthday. (Contributed by Scott Fenton, 18-Apr-2025.)
theorem n0bday (A2: class):
  $ wi (wcel A2 cn0s) (wcel (cfv A2 cbday) com) $;

--| The non-negative surreal integers are a subset of the old set of ` _om ` . To avoid the axiom of infinity, we include it as an antecedent. (Contributed by Scott Fenton, 20-Feb-2026.)
theorem n0ssoldg:
  $ wi (wcel com cvv) (wss cn0s (cfv com cold)) $;

--| The non-negative surreal integers are a subset of the old set of ` _om ` . (Contributed by Scott Fenton, 18-Apr-2025.)
theorem n0ssold:
  $ wss cn0s (cfv com cold) $;

--| The simplest number greater than a finite set of non-negative surreal integers is a non-negative surreal integer. (Contributed by Scott Fenton, 5-Nov-2025.)
theorem n0fincut (A2: class):
  $ wi (wa (wss A2 cn0s) (wcel A2 cfn)) (wcel (co A2 c0 ccuts) cn0s) $;

--| A surreal ordinal with a finite birthday is a non-negative surreal integer. (Contributed by Scott Fenton, 4-Nov-2025.)
theorem onsfi (A2: class):
  $ wi (wa (wcel A2 cons) (wcel (cfv A2 cbday) com)) (wcel A2 cn0s) $;

--| A non-negative surreal integer is a surreal ordinal with a finite birthday. (Contributed by Scott Fenton, 27-Feb-2026.)
theorem eln0s2 (A2: class):
  $ wb (wcel A2 cn0s) (wa (wcel A2 cons) (wcel (cfv A2 cbday) com)) $;

--| A surreal ordinal that is less than a non-negative integer is a non-negative integer. (Contributed by Scott Fenton, 7-Nov-2025.)
theorem onltn0s (A2 B2: class):
  $ wi (w3a (wcel A2 cons) (wcel B2 cn0s) (wbr A2 B2 clts)) (wcel A2 cn0s) $;

--| A non-negative surreal integer is the simplest number greater than all previous non-negative surreal integers. (Contributed by Scott Fenton, 7-Nov-2025.)
theorem n0cutlt {x3: setvar} (A2: class):
  $ wi (wcel A2 cn0s) (wceq A2 (co (crab x3 (wbr (cv x3) A2 clts) cn0s) c0 ccuts)) $;

--| The surreal sequence builder is a function over ` NN0_s ` when started from zero. (Contributed by Scott Fenton, 19-Apr-2025.)
theorem seqn0sfn (ph: wff) (c_pl F: class):
  $ wi ph (wfn (cseqs c_pl F c0s) cn0s) $;

--| A non-negative surreal integer is zero or a positive surreal integer. (Contributed by Scott Fenton, 26-May-2025.)
theorem eln0s (A2: class):
  $ wb (wcel A2 cn0s) (wo (wcel A2 cnns) (wceq A2 c0s)) $;

--| Every non-negative surreal integer is either zero or a successor. (Contributed by Scott Fenton, 26-May-2025.)
theorem n0s0m1 (A2: class):
  $ wi (wcel A2 cn0s) (wo (wceq A2 c0s) (wcel (co A2 c1s csubs) cn0s)) $;

--| Subtraction of non-negative surreal integers. (Contributed by Scott Fenton, 26-May-2025.)
theorem n0subs (M N: class):
  $ wi (wa (wcel M cn0s) (wcel N cn0s)) (wb (wbr M N cles) (wcel (co N M csubs) cn0s)) $;

--| Subtraction of non-negative surreal integers. (Contributed by Scott Fenton, 7-Nov-2025.)
theorem n0subs2 (M N: class):
  $ wi (wa (wcel M cn0s) (wcel N cn0s)) (wb (wbr M N clts) (wcel (co N M csubs) cnns)) $;

--| Non-negative surreal ordering relation. (Contributed by Scott Fenton, 7-Nov-2025.)
theorem n0ltsp1le (M N: class):
  $ wi (wa (wcel M cn0s) (wcel N cn0s)) (wb (wbr M N clts) (wbr (co M c1s cadds) N cles)) $;

--| Non-negative surreal ordering relation. (Contributed by Scott Fenton, 7-Nov-2025.)
theorem n0lesltp1 (M N: class):
  $ wi (wa (wcel M cn0s) (wcel N cn0s)) (wb (wbr M N cles) (wbr M (co N c1s cadds) clts)) $;

--| Non-negative surreal ordering relation. (Contributed by Scott Fenton, 8-Nov-2025.)
theorem n0lesm1lt (M N: class):
  $ wi (wa (wcel M cn0s) (wcel N cn0s)) (wb (wbr M N cles) (wbr (co M c1s csubs) N clts)) $;

--| A non-negative surreal integer is less than one iff it is zero. (Contributed by Scott Fenton, 23-Feb-2026.)
theorem n0lts1e0 (A2: class):
  $ wi (wcel A2 cn0s) (wb (wbr A2 c1s clts) (wceq A2 c0s)) $;

--| The birthday of ` A +s 1s ` is the successor of the birthday of ` A ` when ` A ` is a non-negative surreal integer. (Contributed by Scott Fenton, 7-Nov-2025.)
theorem bdayn0p1 (A2: class):
  $ wi (wcel A2 cn0s) (wceq (cfv (co A2 c1s cadds) cbday) (csuc (cfv A2 cbday))) $;

--| The birthday function restricted to the non-negative surreal integers is a bijection with the finite ordinals. (Contributed by Scott Fenton, 7-Nov-2025.)
theorem bdayn0sf1o:
  $ wf1o cn0s com (cres cbday cn0s) $;

--| One plus a non-negative surreal integer is a positive surreal integer. (Contributed by Scott Fenton, 26-May-2025.)
theorem n0p1nns (A2: class):
  $ wi (wcel A2 cn0s) (wcel (co A2 c1s cadds) cnns) $;

--| Alternate definition of the positive surreal integers. Compare ~ df-nn . (Contributed by Scott Fenton, 6-Aug-2025.)
theorem dfnns2 {x3: setvar}:
  $ wceq cnns (cima (crdg (cmpt x3 cvv (co (cv x3) c1s cadds)) c1s) com) $;

--| Principle of Mathematical Induction (inference schema). (Contributed by Scott Fenton, 6-Aug-2025.)
theorem nnsind {x3 y1: setvar} (ph: wff x3) (ps ch th ta: wff y1) (A2: class y1):
  $ wi (wceq (cv x3) c1s) (wb ph ps) $ >
  $ wi (wceq (cv x3) (cv y1)) (wb ph ch) $ >
  $ wi (wceq (cv x3) (co (cv y1) c1s cadds)) (wb ph th) $ >
  $ wi (wceq (cv x3) A2) (wb ph ta) $ >
  $ ps $ >
  $ wi (wcel (cv y1) cnns) (wi ch th) $ >
  $ wi (wcel A2 cnns) ta $;

--| Every positive surreal integer is either one or a successor. (Contributed by Scott Fenton, 8-Nov-2025.)
theorem nn1m1nns (A2: class):
  $ wi (wcel A2 cnns) (wo (wceq A2 c1s) (wcel (co A2 c1s csubs) cnns)) $;

--| A positive surreal integer minus one is a non-negative surreal integer. (Contributed by Scott Fenton, 8-Nov-2025.)
theorem nnm1n0s (N: class):
  $ wi (wcel N cnns) (wcel (co N c1s csubs) cn0s) $;

--| Euclid's division lemma for surreal numbers. (Contributed by Scott Fenton, 8-Nov-2025.)
theorem eucliddivs {q p: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cn0s) (wcel B2 cnns)) (wrex p (wrex q (wa (wceq A2 (co (co B2 (cv p) cmuls) (cv q) cadds)) (wbr (cv q) B2 clts)) cn0s) cn0s) $;

--| The old set of an ordinal is finite iff the ordinal is finite. (Contributed by Scott Fenton, 19-Feb-2026.)
theorem oldfib (A2: class):
  $ wi (wcel A2 con0) (wb (wcel A2 com) (wcel (cfv A2 cold) cfn)) $;

--| Declare the syntax for surreal integers.
term czs: class;

--| Define the surreal integers. Compare ~ dfz2 . (Contributed by Scott Fenton, 17-May-2025.)
axiom df_zs:
  $ wceq czs (cima csubs (cxp cnns cnns)) $;

--| The surreal integers form a set. (Contributed by Scott Fenton, 17-May-2025.)
theorem zsex:
  $ wcel czs cvv $;

--| The surreal integers are a subset of the surreals. (Contributed by Scott Fenton, 17-May-2025.)
theorem zssno:
  $ wss czs csur $;

--| A surreal integer is a surreal. (Contributed by Scott Fenton, 17-May-2025.)
theorem zno (A2: class):
  $ wi (wcel A2 czs) (wcel A2 csur) $;

--| A surreal integer is a surreal. Deduction form. (Contributed by Scott Fenton, 17-May-2025.)
theorem znod (ph: wff) (A2: class):
  $ wi ph (wcel A2 czs) $ >
  $ wi ph (wcel A2 csur) $;

--| Membership in the set of surreal integers. (Contributed by Scott Fenton, 17-May-2025.)
theorem elzs {x3 y1: setvar} (A2: class):
  $ wb (wcel A2 czs) (wrex x3 (wrex y1 (wceq A2 (co (cv x3) (cv y1) csubs)) cnns) cnns) $;

--| The difference of two surreal positive integers is an integer. (Contributed by Scott Fenton, 25-Jul-2025.)
theorem nnzsubs (A2 B2: class):
  $ wi (wa (wcel A2 cnns) (wcel B2 cnns)) (wcel (co A2 B2 csubs) czs) $;

--| A positive surreal integer is a surreal integer. (Contributed by Scott Fenton, 17-May-2025.)
theorem nnzs (A2: class):
  $ wi (wcel A2 cnns) (wcel A2 czs) $;

--| A positive surreal integer is a surreal integer. Deduction form. (Contributed by Scott Fenton, 26-May-2025.)
theorem nnzsd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cnns) $ >
  $ wi ph (wcel A2 czs) $;

--| Zero is a surreal integer. (Contributed by Scott Fenton, 26-May-2025.)
theorem _0zs:
  $ wcel c0s czs $;

--| A non-negative surreal integer is a surreal integer. (Contributed by Scott Fenton, 26-May-2025.)
theorem n0zs (A2: class):
  $ wi (wcel A2 cn0s) (wcel A2 czs) $;

--| A non-negative surreal integer is a surreal integer. (Contributed by Scott Fenton, 26-May-2025.)
theorem n0zsd (ph: wff) (A2: class):
  $ wi ph (wcel A2 cn0s) $ >
  $ wi ph (wcel A2 czs) $;

--| One is a surreal integer. (Contributed by Scott Fenton, 24-Jul-2025.)
theorem _1zs:
  $ wcel c1s czs $;

--| The surreal integers are closed under negation. (Contributed by Scott Fenton, 26-May-2025.)
theorem znegscl (A2: class):
  $ wi (wcel A2 czs) (wcel (cfv A2 cnegs) czs) $;

--| The surreal integers are closed under negation. (Contributed by Scott Fenton, 26-May-2025.)
theorem znegscld (ph: wff) (A2: class):
  $ wi ph (wcel A2 czs) $ >
  $ wi ph (wcel (cfv A2 cnegs) czs) $;

--| The surreal integers are closed under addition. (Contributed by Scott Fenton, 25-Jul-2025.)
theorem zaddscl (A2 B2: class):
  $ wi (wa (wcel A2 czs) (wcel B2 czs)) (wcel (co A2 B2 cadds) czs) $;

--| The surreal integers are closed under addition. (Contributed by Scott Fenton, 25-Jul-2025.)
theorem zaddscld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 czs) $ >
  $ wi ph (wcel B2 czs) $ >
  $ wi ph (wcel (co A2 B2 cadds) czs) $;

--| The surreal integers are closed under subtraction. (Contributed by Scott Fenton, 25-Jul-2025.)
theorem zsubscld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 czs) $ >
  $ wi ph (wcel B2 czs) $ >
  $ wi ph (wcel (co A2 B2 csubs) czs) $;

--| The surreal integers are closed under multiplication. (Contributed by Scott Fenton, 20-Aug-2025.)
theorem zmulscld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 czs) $ >
  $ wi ph (wcel B2 czs) $ >
  $ wi ph (wcel (co A2 B2 cmuls) czs) $;

--| A surreal integer is a surreal that is a non-negative integer or whose negative is a non-negative integer. (Contributed by Scott Fenton, 26-May-2025.)
theorem elzn0s (A2: class):
  $ wb (wcel A2 czs) (wa (wcel A2 csur) (wo (wcel A2 cn0s) (wcel (cfv A2 cnegs) cn0s))) $;

--| A surreal integer is either a positive integer, zero, or the negative of a positive integer. (Contributed by Scott Fenton, 25-Jul-2025.)
theorem elzs2 (N: class):
  $ wb (wcel N czs) (wa (wcel N csur) (w3o (wcel N cnns) (wceq N c0s) (wcel (cfv N cnegs) cnns))) $;

--| Non-negative surreal integer property expressed in terms of integers. (Contributed by Scott Fenton, 25-Jul-2025.)
theorem eln0zs (N: class):
  $ wb (wcel N cn0s) (wa (wcel N czs) (wbr c0s N cles)) $;

--| Positive surreal integer property expressed in terms of integers. (Contributed by Scott Fenton, 25-Jul-2025.)
theorem elnnzs (N: class):
  $ wb (wcel N cnns) (wa (wcel N czs) (wbr c0s N clts)) $;

--| Surreal integer property expressed in terms of positive integers and non-negative integers. (Contributed by Scott Fenton, 25-Jul-2025.)
theorem elznns (N: class):
  $ wb (wcel N czs) (wa (wcel N csur) (wo (wcel N cnns) (wcel (cfv N cnegs) cn0s))) $;

--| The non-negative difference of surreal integers is a non-negative integer. (Contributed by Scott Fenton, 25-Jul-2025.)
theorem zn0subs (M N: class):
  $ wi (wa (wcel M czs) (wcel N czs)) (wb (wbr M N cles) (wcel (co N M csubs) cn0s)) $;

--| Peano's inductive postulate for upper surreal integers. (Contributed by Scott Fenton, 25-Jul-2025.)
theorem peano5uzs {x3 k: setvar} (ph: wff) (A2: class k) (N: class):
  $ wi ph (wcel N czs) $ >
  $ wi ph (wcel N A2) $ >
  $ wi (wa ph (wcel (cv x3) A2)) (wcel (co (cv x3) c1s cadds) A2) $ >
  $ wi ph (wss (crab k (wbr N (cv k) cles) czs) A2) $;

--| Induction on the upper surreal integers that start at ` M ` . (Contributed by Scott Fenton, 25-Jul-2025.)
theorem uzsind {j k: setvar} (ph: wff j) (ps ch th ta: wff k) (M: class) (N: class k):
  $ wi (wceq (cv j) M) (wb ph ps) $ >
  $ wi (wceq (cv j) (cv k)) (wb ph ch) $ >
  $ wi (wceq (cv j) (co (cv k) c1s cadds)) (wb ph th) $ >
  $ wi (wceq (cv j) N) (wb ph ta) $ >
  $ wi (wcel M czs) ps $ >
  $ wi (w3a (wcel M czs) (wcel (cv k) czs) (wbr M (cv k) cles)) (wi ch th) $ >
  $ wi (w3a (wcel M czs) (wcel N czs) (wbr M N cles)) ta $;

--| A surreal integer has a finite birthday. (Contributed by Scott Fenton, 26-May-2025.)
theorem zsbday (A2: class):
  $ wi (wcel A2 czs) (wcel (cfv A2 cbday) com) $;

--| A cut expression for surreal integers. (Contributed by Scott Fenton, 20-Aug-2025.)
theorem zcuts (A2: class):
  $ wi (wcel A2 czs) (wceq A2 (co (csn (co A2 c1s csubs)) (csn (co A2 c1s cadds)) ccuts)) $;

--| Either the left or right set of a surreal integer is empty. (Contributed by Scott Fenton, 21-Feb-2026.)
theorem zcuts0 (A2: class):
  $ wi (wcel A2 czs) (wo (wceq (cfv A2 cleft) c0) (wceq (cfv A2 cright) c0)) $;

--| The surreal integers form an ordered ring. Note that we have to restrict the operations here since ` No ` is a proper class. (Contributed by Scott Fenton, 23-Dec-2025.)
theorem zsoring (K: class):
  $ wceq czs (cfv K cbs) $ >
  $ wceq (cres cadds (cxp czs czs)) (cfv K cplusg) $ >
  $ wceq (cres cmuls (cxp czs czs)) (cfv K cmulr) $ >
  $ wceq (cin cles (cxp czs czs)) (cfv K cple) $ >
  $ wceq c0s (cfv K c0g) $ >
  $ wcel K corng $;

--| Declare the syntax for surreal two.
term c2s: class;

--| Define surreal two. This is the simplest number greater than one. See ~ 1p1e2s for its addition version. (Contributed by Scott Fenton, 27-May-2025.)
axiom df_2s:
  $ wceq c2s (co (csn c1s) c0 ccuts) $;

--| Declare the syntax for surreal exponentiation.
term cexps: class;

--| Define surreal exponentiation. Compare ~ df-exp . (Contributed by Scott Fenton, 27-May-2025.)
axiom df_exps {x3 y1: setvar}:
  $ wceq cexps (cmpo x3 y1 csur czs (cif (wceq (cv y1) c0s) c1s (cif (wbr c0s (cv y1) clts) (cfv (cv y1) (cseqs cmuls (cxp cnns (csn (cv x3))) c1s)) (co c1s (cfv (cfv (cv y1) cnegs) (cseqs cmuls (cxp cnns (csn (cv x3))) c1s)) cdivs)))) $;

--| Define the syntax for the set of surreal dyadic fractions.
term cz12s: class;

--| Define the set of dyadic rationals. This is the set of rationals whose denominator is a power of two. Later we will prove that this is precisely the set of surreals with a finite birthday. (Contributed by Scott Fenton, 27-May-2025.)
axiom df_z12s {x3 y1 z: setvar}:
  $ wceq cz12s (cab x3 (wrex y1 (wrex z (wceq (cv x3) (co (cv y1) (co c2s (cv z) cexps) cdivs)) cn0s) czs)) $;

--| One plus one is two. Surreal version. (Contributed by Scott Fenton, 27-May-2025.)
theorem _1p1e2s:
  $ wceq (co c1s c1s cadds) c2s $;

--| Version of ~ 2times for surreal numbers. (Contributed by Scott Fenton, 23-Jul-2025.)
theorem no2times (A2: class):
  $ wi (wcel A2 csur) (wceq (co c2s A2 cmuls) (co A2 A2 cadds)) $;

--| Surreal two is a surreal natural. (Contributed by Scott Fenton, 23-Jul-2025.)
theorem _2nns:
  $ wcel c2s cnns $;

--| Surreal two is a surreal number. (Contributed by Scott Fenton, 23-Jul-2025.)
theorem _2no:
  $ wcel c2s csur $;

--| Surreal two is nonzero. (Contributed by Scott Fenton, 23-Jul-2025.)
theorem _2ne0s:
  $ wne c2s c0s $;

--| A non-negative surreal integer is either even or odd. (Contributed by Scott Fenton, 19-Aug-2025.)
theorem n0seo {x3: setvar} (N: class):
  $ wi (wcel N cn0s) (wo (wrex x3 (wceq N (co c2s (cv x3) cmuls)) cn0s) (wrex x3 (wceq N (co (co c2s (cv x3) cmuls) c1s cadds)) cn0s)) $;

--| A surreal integer is either even or odd. (Contributed by Scott Fenton, 19-Aug-2025.)
theorem zseo {x3: setvar} (N: class):
  $ wi (wcel N czs) (wo (wrex x3 (wceq N (co c2s (cv x3) cmuls)) czs) (wrex x3 (wceq N (co (co c2s (cv x3) cmuls) c1s cadds)) czs)) $;

--| Two times the cut of zero and one is one. (Contributed by Scott Fenton, 5-Sep-2025.)
theorem twocut:
  $ wceq (co c2s (co (csn c0s) (csn c1s) ccuts) cmuls) c1s $;

--| An explicit expression for one half. This theorem avoids the axiom of infinity. (Contributed by Scott Fenton, 23-Jul-2025.)
theorem nohalf:
  $ wceq (co c1s c2s cdivs) (co (csn c0s) (csn c1s) ccuts) $;

--| The value of surreal exponentiation. (Contributed by Scott Fenton, 24-Jul-2025.)
theorem expsval (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 czs)) (wceq (co A2 B2 cexps) (cif (wceq B2 c0s) c1s (cif (wbr c0s B2 clts) (cfv B2 (cseqs cmuls (cxp cnns (csn A2)) c1s)) (co c1s (cfv (cfv B2 cnegs) (cseqs cmuls (cxp cnns (csn A2)) c1s)) cdivs)))) $;

--| Value of surreal exponentiation at a natural number. (Contributed by Scott Fenton, 25-Jul-2025.)
theorem expnnsval (A2 N: class):
  $ wi (wa (wcel A2 csur) (wcel N cnns)) (wceq (co A2 N cexps) (cfv N (cseqs cmuls (cxp cnns (csn A2)) c1s))) $;

--| Surreal exponentiation to zero. (Contributed by Scott Fenton, 24-Jul-2025.)
theorem exps0 (A2: class):
  $ wi (wcel A2 csur) (wceq (co A2 c0s cexps) c1s) $;

--| Surreal exponentiation to one. (Contributed by Scott Fenton, 24-Jul-2025.)
theorem exps1 (A2: class):
  $ wi (wcel A2 csur) (wceq (co A2 c1s cexps) A2) $;

--| Value of a surreal number raised to a non-negative integer power plus one. (Contributed by Scott Fenton, 6-Aug-2025.)
theorem expsp1 (A2 N: class):
  $ wi (wa (wcel A2 csur) (wcel N cn0s)) (wceq (co A2 (co N c1s cadds) cexps) (co (co A2 N cexps) A2 cmuls)) $;

--| Lemma for proving non-negative surreal integer exponentiation closure. (Contributed by Scott Fenton, 7-Nov-2025.)
theorem expscllem {x3 y1: setvar} (A2 F N: class):
  $ wss F csur $ >
  $ wi (wa (wcel (cv x3) F) (wcel (cv y1) F)) (wcel (co (cv x3) (cv y1) cmuls) F) $ >
  $ wcel c1s F $ >
  $ wi (wa (wcel A2 F) (wcel N cn0s)) (wcel (co A2 N cexps) F) $;

--| Closure law for surreal exponentiation. (Contributed by Scott Fenton, 7-Aug-2025.)
theorem expscl (A2 N: class):
  $ wi (wa (wcel A2 csur) (wcel N cn0s)) (wcel (co A2 N cexps) csur) $;

--| Closure law for non-negative surreal integer exponentiation. (Contributed by Scott Fenton, 7-Nov-2025.)
theorem n0expscl (A2 N: class):
  $ wi (wa (wcel A2 cn0s) (wcel N cn0s)) (wcel (co A2 N cexps) cn0s) $;

--| Closure law for positive surreal integer exponentiation. (Contributed by Scott Fenton, 8-Nov-2025.)
theorem nnexpscl (A2 N: class):
  $ wi (wa (wcel A2 cnns) (wcel N cn0s)) (wcel (co A2 N cexps) cnns) $;

--| Closure law for surreal integer exponentiation. (Contributed by Scott Fenton, 11-Dec-2025.)
theorem zexpscl (A2 N: class):
  $ wi (wa (wcel A2 czs) (wcel N cn0s)) (wcel (co A2 N cexps) czs) $;

--| Sum of exponents law for surreals. (Contributed by Scott Fenton, 7-Nov-2025.)
theorem expadds (A2 M N: class):
  $ wi (w3a (wcel A2 csur) (wcel M cn0s) (wcel N cn0s)) (wceq (co A2 (co M N cadds) cexps) (co (co A2 M cexps) (co A2 N cexps) cmuls)) $;

--| A non-negative surreal integer power is nonzero if its base is nonzero. (Contributed by Scott Fenton, 7-Aug-2025.)
theorem expsne0 (A2 N: class):
  $ wi (w3a (wcel A2 csur) (wne A2 c0s) (wcel N cn0s)) (wne (co A2 N cexps) c0s) $;

--| A non-negative surreal integer power is positive if its base is positive. (Contributed by Scott Fenton, 7-Aug-2025.)
theorem expsgt0 (A2 N: class):
  $ wi (w3a (wcel A2 csur) (wcel N cn0s) (wbr c0s A2 clts)) (wbr c0s (co A2 N cexps) clts) $;

--| Any power of two has a multiplicative inverse. Note that this theorem does not require the axiom of infinity. (Contributed by Scott Fenton, 5-Sep-2025.)
theorem pw2recs {x3: setvar} (N: class):
  $ wi (wcel N cn0s) (wrex x3 (wceq (co (co c2s N cexps) (cv x3) cmuls) c1s) csur) $;

--| Division closure for powers of two. (Contributed by Scott Fenton, 7-Nov-2025.)
theorem pw2divscld (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel N cn0s) $ >
  $ wi ph (wcel (co A2 (co c2s N cexps) cdivs) csur) $;

--| Relationship between surreal division and multiplication for powers of two. (Contributed by Scott Fenton, 7-Nov-2025.)
theorem pw2divmulsd (ph: wff) (A2 B2 N: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel N cn0s) $ >
  $ wi ph (wb (wceq (co A2 (co c2s N cexps) cdivs) B2) (wceq (co (co c2s N cexps) B2 cmuls) A2)) $;

--| Cancellation law for surreal division by powers of two. (Contributed by Scott Fenton, 7-Nov-2025.)
theorem pw2divscan3d (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel N cn0s) $ >
  $ wi ph (wceq (co (co (co c2s N cexps) A2 cmuls) (co c2s N cexps) cdivs) A2) $;

--| A cancellation law for surreal division by powers of two. (Contributed by Scott Fenton, 7-Nov-2025.)
theorem pw2divscan2d (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel N cn0s) $ >
  $ wi ph (wceq (co (co c2s N cexps) (co A2 (co c2s N cexps) cdivs) cmuls) A2) $;

--| An associative law for division by powers of two. (Contributed by Scott Fenton, 11-Dec-2025.)
theorem pw2divsassd (ph: wff) (A2 B2 N: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel N cn0s) $ >
  $ wi ph (wceq (co (co A2 B2 cmuls) (co c2s N cexps) cdivs) (co A2 (co B2 (co c2s N cexps) cdivs) cmuls)) $;

--| Cancellation law for divison by powers of two. (Contributed by Scott Fenton, 11-Dec-2025.)
theorem pw2divscan4d (ph: wff) (A2 M N: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel N cn0s) $ >
  $ wi ph (wcel M cn0s) $ >
  $ wi ph (wceq (co A2 (co c2s N cexps) cdivs) (co (co (co c2s M cexps) A2 cmuls) (co c2s (co N M cadds) cexps) cdivs)) $;

--| Division of a positive surreal by a power of two. (Contributed by Scott Fenton, 7-Nov-2025.)
theorem pw2gt0divsd (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel N cn0s) $ >
  $ wi ph (wb (wbr c0s A2 clts) (wbr c0s (co A2 (co c2s N cexps) cdivs) clts)) $;

--| Divison of a non-negative surreal by a power of two. (Contributed by Scott Fenton, 7-Nov-2025.)
theorem pw2ge0divsd (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel N cn0s) $ >
  $ wi ph (wb (wbr c0s A2 cles) (wbr c0s (co A2 (co c2s N cexps) cdivs) cles)) $;

--| Relationship between surreal division and reciprocal for powers of two. (Contributed by Scott Fenton, 7-Nov-2025.)
theorem pw2divsrecd (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel N cn0s) $ >
  $ wi ph (wceq (co A2 (co c2s N cexps) cdivs) (co A2 (co c1s (co c2s N cexps) cdivs) cmuls)) $;

--| Distribution of surreal division over addition for powers of two. (Contributed by Scott Fenton, 7-Nov-2025.)
theorem pw2divsdird (ph: wff) (A2 B2 N: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel N cn0s) $ >
  $ wi ph (wceq (co (co A2 B2 cadds) (co c2s N cexps) cdivs) (co (co A2 (co c2s N cexps) cdivs) (co B2 (co c2s N cexps) cdivs) cadds)) $;

--| Move negative sign inside of a power of two division. (Contributed by Scott Fenton, 8-Nov-2025.)
theorem pw2divsnegd (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel N cn0s) $ >
  $ wi ph (wceq (cfv (co A2 (co c2s N cexps) cdivs) cnegs) (co (cfv A2 cnegs) (co c2s N cexps) cdivs)) $;

--| Surreal less-than relationship between division and multiplication for powers of two. (Contributed by Scott Fenton, 11-Dec-2025.)
theorem pw2ltdivmulsd (ph: wff) (A2 B2 N: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel N cn0s) $ >
  $ wi ph (wb (wbr (co A2 (co c2s N cexps) cdivs) B2 clts) (wbr A2 (co (co c2s N cexps) B2 cmuls) clts)) $;

--| Surreal less-than relationship between division and multiplication for powers of two. (Contributed by Scott Fenton, 11-Dec-2025.)
theorem pw2ltmuldivs2d (ph: wff) (A2 B2 N: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel N cn0s) $ >
  $ wi ph (wb (wbr (co (co c2s N cexps) A2 cmuls) B2 clts) (wbr A2 (co B2 (co c2s N cexps) cdivs) clts)) $;

--| Surreal less-than relationship for division by a power of two. (Contributed by Scott Fenton, 18-Jan-2026.)
theorem pw2ltsdiv1d (ph: wff) (A2 B2 N: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel N cn0s) $ >
  $ wi ph (wb (wbr A2 B2 clts) (wbr (co A2 (co c2s N cexps) cdivs) (co B2 (co c2s N cexps) cdivs) clts)) $;

--| Ordering property for average. (Contributed by Scott Fenton, 11-Dec-2025.)
theorem avglts1d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wb (wbr A2 B2 clts) (wbr A2 (co (co A2 B2 cadds) c2s cdivs) clts)) $;

--| Ordering property for average. (Contributed by Scott Fenton, 11-Dec-2025.)
theorem avglts2d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wb (wbr A2 B2 clts) (wbr (co (co A2 B2 cadds) c2s cdivs) B2 clts)) $;

--| Division into zero is zero for a power of two. (Contributed by Scott Fenton, 21-Feb-2026.)
theorem pw2divs0d (ph: wff) (N: class):
  $ wi ph (wcel N cn0s) $ >
  $ wi ph (wceq (co c0s (co c2s N cexps) cdivs) c0s) $;

--| Identity law for division over powers of two. (Contributed by Scott Fenton, 21-Feb-2026.)
theorem pw2divsidd (ph: wff) (N: class):
  $ wi ph (wcel N cn0s) $ >
  $ wi ph (wceq (co (co c2s N cexps) (co c2s N cexps) cdivs) c1s) $;

--| Surreal less-than relationship between division and multiplication for powers of two. (Contributed by Scott Fenton, 23-Feb-2026.)
theorem pw2ltdivmuls2d (ph: wff) (A2 B2 N: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel N cn0s) $ >
  $ wi ph (wb (wbr (co A2 (co c2s N cexps) cdivs) B2 clts) (wbr A2 (co B2 (co c2s N cexps) cmuls) clts)) $;

--| Relate the cut of twice of two numbers to the cut of the numbers. Lemma 4.2 of [Gonshor] p. 28. (Contributed by Scott Fenton, 7-Aug-2025.) Avoid the axiom of infinity. (Proof modified by Scott Fenton, 6-Sep-2025.)
theorem halfcut (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wbr A2 B2 clts) $ >
  $ wi ph (wceq (co (csn (co c2s A2 cmuls)) (csn (co c2s B2 cmuls)) ccuts) (co A2 B2 cadds)) $ >
  $ wceq C (co (csn A2) (csn B2) ccuts) $ >
  $ wi ph (wceq C (co (co A2 B2 cadds) c2s cdivs)) $;

--| The cut of a surreal non-negative integer and its successor is the original number plus one half. Part of theorem 4.2 of [Gonshor] p. 30. (Contributed by Scott Fenton, 13-Aug-2025.)
theorem addhalfcut (ph: wff) (A2: class):
  $ wi ph (wcel A2 cn0s) $ >
  $ wi ph (wceq (co (csn A2) (csn (co A2 c1s cadds)) ccuts) (co A2 (co c1s c2s cdivs) cadds)) $;

--| Extend ~ halfcut to arbitrary powers of two. Part of theorem 4.2 of [Gonshor] p. 28. (Contributed by Scott Fenton, 18-Aug-2025.)
theorem pw2cut (ph: wff) (A2 B2 N: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel N cn0s) $ >
  $ wi ph (wbr A2 B2 clts) $ >
  $ wi ph (wceq (co (csn (co c2s A2 cmuls)) (csn (co c2s B2 cmuls)) ccuts) (co A2 B2 cadds)) $ >
  $ wi ph (wceq (co (csn (co A2 (co c2s N cexps) cdivs)) (csn (co B2 (co c2s N cexps) cdivs)) ccuts) (co (co A2 B2 cadds) (co c2s (co N c1s cadds) cexps) cdivs)) $;

--| Simplify ~ pw2cut in the case of successors of surreal integers. (Contributed by Scott Fenton, 11-Nov-2025.)
theorem pw2cutp1 (ph: wff) (A2 N: class):
  $ wi ph (wcel A2 czs) $ >
  $ wi ph (wcel N cn0s) $ >
  $ wi ph (wceq (co (csn (co A2 (co c2s N cexps) cdivs)) (csn (co (co A2 c1s cadds) (co c2s N cexps) cdivs)) ccuts) (co (co (co c2s A2 cmuls) c1s cadds) (co c2s (co N c1s cadds) cexps) cdivs)) $;

--| Cut expression for powers of two. Theorem 12 of [Conway] p. 12-13. (Contributed by Scott Fenton, 18-Jan-2026.)
theorem pw2cut2 (A2 N: class):
  $ wi (wa (wcel A2 czs) (wcel N cn0s)) (wceq (co A2 (co c2s N cexps) cdivs) (co (csn (co (co A2 c1s csubs) (co c2s N cexps) cdivs)) (csn (co (co A2 c1s cadds) (co c2s N cexps) cdivs)) ccuts)) $;

--| Lemma for ~ bdaypw2n0bnd . Prove the case with a successor. (Contributed by Scott Fenton, 21-Feb-2026.)
theorem bdaypw2n0bndlem (A2 N: class):
  $ wi (w3a (wcel A2 cn0s) (wcel N cn0s) (wbr A2 (co c2s (co N c1s cadds) cexps) clts)) (wss (cfv (co A2 (co c2s (co N c1s cadds) cexps) cdivs) cbday) (csuc (cfv (co N c1s cadds) cbday))) $;

--| Upper bound for the birthday of a proper fraction of a power of two. This is actually a strict equality when ` A ` is odd, but we do not need this for the rest of our development. (Contributed by Scott Fenton, 22-Feb-2026.)
theorem bdaypw2n0bnd (A2 N: class):
  $ wi (w3a (wcel A2 cn0s) (wcel N cn0s) (wbr A2 (co c2s N cexps) clts)) (wss (cfv (co A2 (co c2s N cexps) cdivs) cbday) (csuc (cfv N cbday))) $;

--| Birthday bounding rule for non-negative dyadic rationals. (Contributed by Scott Fenton, 25-Feb-2026.)
theorem bdaypw2bnd (ph: wff) (P N X Y: class):
  $ wi ph (wcel N cn0s) $ >
  $ wi ph (wcel X cn0s) $ >
  $ wi ph (wcel Y cn0s) $ >
  $ wi ph (wcel P cn0s) $ >
  $ wi ph (wbr Y (co c2s P cexps) clts) $ >
  $ wi ph (wbr (co X P cadds) N clts) $ >
  $ wi ph (wss (cfv (co X (co Y (co c2s P cexps) cdivs) cadds) cbday) (cfv N cbday)) $;

--| Lemma for ~ bdayfinbnd . Change some bound variables. (Contributed by Scott Fenton, 25-Feb-2026.)
theorem bdayfinbndcbv {x3 y1 z w q p a b: setvar} (ph: wff x3 y1 z w q p a b) (N: class):
  $ wi ph (wcel N cn0s) $ >
  $ wi ph (wral z (wi (wa (wss (cfv (cv z) cbday) (cfv N cbday)) (wbr c0s (cv z) cles)) (wo (wceq (cv z) N) (wrex x3 (wrex y1 (wrex p (w3a (wceq (cv z) (co (cv x3) (co (cv y1) (co c2s (cv p) cexps) cdivs) cadds)) (wbr (cv y1) (co c2s (cv p) cexps) clts) (wbr (co (cv x3) (cv p) cadds) N clts)) cn0s) cn0s) cn0s))) csur) $ >
  $ wi ph (wral w (wi (wa (wss (cfv (cv w) cbday) (cfv N cbday)) (wbr c0s (cv w) cles)) (wo (wceq (cv w) N) (wrex a (wrex b (wrex q (w3a (wceq (cv w) (co (cv a) (co (cv b) (co c2s (cv q) cexps) cdivs) cadds)) (wbr (cv b) (co c2s (cv q) cexps) clts) (wbr (co (cv a) (cv q) cadds) N clts)) cn0s) cn0s) cn0s))) csur) $;

--| Lemma for ~ bdayfinbnd . Show the first half of the inductive step. (Contributed by Scott Fenton, 26-Feb-2026.)
theorem bdayfinbndlem1 {x3 y1 z w q p a b: setvar} (ph: wff z) (N: class):
  $ wi ph (wcel N cn0s) $ >
  $ wi ph (wral z (wi (wa (wss (cfv (cv z) cbday) (cfv N cbday)) (wbr c0s (cv z) cles)) (wo (wceq (cv z) N) (wrex x3 (wrex y1 (wrex p (w3a (wceq (cv z) (co (cv x3) (co (cv y1) (co c2s (cv p) cexps) cdivs) cadds)) (wbr (cv y1) (co c2s (cv p) cexps) clts) (wbr (co (cv x3) (cv p) cadds) N clts)) cn0s) cn0s) cn0s))) csur) $ >
  $ wi ph (wral w (wi (wa (wss (cfv (cv w) cbday) (cfv (co N c1s cadds) cbday)) (wbr c0s (cv w) cles)) (wo (wceq (cv w) (co N c1s cadds)) (wrex a (wrex b (wrex q (w3a (wceq (cv w) (co (cv a) (co (cv b) (co c2s (cv q) cexps) cdivs) cadds)) (wbr (cv b) (co c2s (cv q) cexps) clts) (wbr (co (cv a) (cv q) cadds) (co N c1s cadds) clts)) cn0s) cn0s) cn0s))) csur) $;

--| Lemma for ~ bdayfinbnd . Conduct the induction. (Contributed by Scott Fenton, 26-Feb-2026.)
theorem bdayfinbndlem2 {x3 y1 z p: setvar} (N: class):
  $ wi (wcel N cn0s) (wral z (wi (wa (wss (cfv (cv z) cbday) (cfv N cbday)) (wbr c0s (cv z) cles)) (wo (wceq (cv z) N) (wrex x3 (wrex y1 (wrex p (w3a (wceq (cv z) (co (cv x3) (co (cv y1) (co c2s (cv p) cexps) cdivs) cadds)) (wbr (cv y1) (co c2s (cv p) cexps) clts) (wbr (co (cv x3) (cv p) cadds) N clts)) cn0s) cn0s) cn0s))) csur) $;

--| Given a non-negative integer and a non-negative surreal of lesser or equal birthday, show that the surreal can be expressed as a dyadic fraction with an upper bound on the integer and exponent. This proof follows the proof from Mizar at ~ https://mizar.uwb.edu.pl/version/current/html/surrealn.html . (Contributed by Scott Fenton, 26-Feb-2026.)
theorem bdayfinbnd {x3 y1 p: setvar} (ph: wff x3 y1 p) (N Z: class):
  $ wi ph (wcel N cn0s) $ >
  $ wi ph (wcel Z csur) $ >
  $ wi ph (wss (cfv Z cbday) (cfv N cbday)) $ >
  $ wi ph (wbr c0s Z cles) $ >
  $ wi ph (wo (wceq Z N) (wrex x3 (wrex y1 (wrex p (w3a (wceq Z (co (cv x3) (co (cv y1) (co c2s (cv p) cexps) cdivs) cadds)) (wbr (cv y1) (co c2s (cv p) cexps) clts) (wbr (co (cv x3) (cv p) cadds) N clts)) cn0s) cn0s) cn0s)) $;

--| Lemma for ~ z12bday . Prove an inequality for birthday ordering. (Contributed by Scott Fenton, 22-Feb-2026.)
theorem z12bdaylem1 (ph: wff) (P M N: class):
  $ wi ph (wcel N cn0s) $ >
  $ wi ph (wcel M cn0s) $ >
  $ wi ph (wcel P cn0s) $ >
  $ wi ph (wbr (co (co c2s M cmuls) c1s cadds) (co c2s P cexps) clts) $ >
  $ wi ph (wne (co N (co (co (co c2s M cmuls) c1s cadds) (co c2s P cexps) cdivs) cadds) (co N P cadds)) $;

--| Lemma for ~ z12bday . Show the first half of the equality. (Contributed by Scott Fenton, 22-Feb-2026.)
theorem z12bdaylem2 (ph: wff) (P M N: class):
  $ wi ph (wcel N cn0s) $ >
  $ wi ph (wcel M cn0s) $ >
  $ wi ph (wcel P cn0s) $ >
  $ wi ph (wbr (co (co c2s M cmuls) c1s cadds) (co c2s P cexps) clts) $ >
  $ wi ph (wss (cfv (co N (co (co (co c2s M cmuls) c1s cadds) (co c2s P cexps) cdivs) cadds) cbday) (cfv (co (co N P cadds) c1s cadds) cbday)) $;

--| Membership in the dyadic fractions. (Contributed by Scott Fenton, 7-Aug-2025.)
theorem elz12s {x3 y1: setvar} (A2: class):
  $ wb (wcel A2 cz12s) (wrex x3 (wrex y1 (wceq A2 (co (cv x3) (co c2s (cv y1) cexps) cdivs)) cn0s) czs) $;

--| Inference form of membership in the dyadic fractions. (Contributed by Scott Fenton, 21-Feb-2026.)
theorem elz12si (A2 N: class):
  $ wi (wa (wcel A2 czs) (wcel N cn0s)) (wcel (co A2 (co c2s N cexps) cdivs) cz12s) $;

--| The class of dyadic fractions is a set. (Contributed by Scott Fenton, 7-Aug-2025.)
theorem z12sex:
  $ wcel cz12s cvv $;

--| A surreal integer is a dyadic fraction. (Contributed by Scott Fenton, 7-Aug-2025.)
theorem zz12s (A2: class):
  $ wi (wcel A2 czs) (wcel A2 cz12s) $;

--| A dyadic is a surreal. (Contributed by Scott Fenton, 11-Dec-2025.)
theorem z12no (A2: class):
  $ wi (wcel A2 cz12s) (wcel A2 csur) $;

--| The dyadics are closed under addition. (Contributed by Scott Fenton, 11-Dec-2025.)
theorem z12addscl (A2 B2: class):
  $ wi (wa (wcel A2 cz12s) (wcel B2 cz12s)) (wcel (co A2 B2 cadds) cz12s) $;

--| The dyadics are closed under negation. (Contributed by Scott Fenton, 9-Nov-2025.)
theorem z12negscl (A2: class):
  $ wi (wcel A2 cz12s) (wcel (cfv A2 cnegs) cz12s) $;

--| The dyadics are closed under subtraction. (Contributed by Scott Fenton, 12-Dec-2025.)
theorem z12subscl (A2 B2: class):
  $ wi (wa (wcel A2 cz12s) (wcel B2 cz12s)) (wcel (co A2 B2 csubs) cz12s) $;

--| Half of a dyadic is a dyadic. (Contributed by Scott Fenton, 11-Dec-2025.)
theorem z12shalf (A2: class):
  $ wi (wcel A2 cz12s) (wcel (co A2 c2s cdivs) cz12s) $;

--| A surreal is a dyadic fraction iff its negative is. (Contributed by Scott Fenton, 9-Nov-2025.)
theorem z12negsclb (A2: class):
  $ wi (wcel A2 csur) (wb (wcel A2 cz12s) (wcel (cfv A2 cnegs) cz12s)) $;

--| A dyadic fraction is either an integer or an odd number divided by a positive power of two. (Contributed by Scott Fenton, 5-Dec-2025.)
theorem z12zsodd {x3 y1: setvar} (A2: class):
  $ wi (wcel A2 cz12s) (wo (wcel A2 czs) (wrex x3 (wrex y1 (wceq A2 (co (co (co c2s (cv x3) cmuls) c1s cadds) (co c2s (cv y1) cexps) cdivs)) cnns) czs)) $;

--| An expression for non-negative dyadic rationals. (Contributed by Scott Fenton, 8-Nov-2025.)
theorem z12sge0 {x3 y1 p: setvar} (A2: class):
  $ wi (wa (wcel A2 csur) (wbr c0s A2 cles)) (wb (wcel A2 cz12s) (wrex x3 (wrex y1 (wrex p (wa (wceq A2 (co (cv x3) (co (cv y1) (co c2s (cv p) cexps) cdivs) cadds)) (wbr (cv y1) (co c2s (cv p) cexps) clts)) cn0s) cn0s) cn0s)) $;

--| Lemma for ~ z12bday . Handle the non-negative case. (Contributed by Scott Fenton, 22-Feb-2026.)
theorem z12bdaylem (A2: class):
  $ wi (wa (wcel A2 cz12s) (wbr c0s A2 cles)) (wcel (cfv A2 cbday) com) $;

--| A dyadic fraction has a finite birthday. (Contributed by Scott Fenton, 20-Aug-2025.) (Proof shortened by Scott Fenton, 22-Feb-2026.)
theorem z12bday (A2: class):
  $ wi (wcel A2 cz12s) (wcel (cfv A2 cbday) com) $;

--| Lemma for ~ bdayfin . Handle the non-negative case. (Contributed by Scott Fenton, 26-Feb-2026.)
theorem bdayfinlem (A2: class):
  $ wi (w3a (wcel A2 csur) (wbr c0s A2 cles) (wcel (cfv A2 cbday) com)) (wcel A2 cz12s) $;

--| A surreal has a finite birthday iff it is a dyadic fraction. (Contributed by Scott Fenton, 26-Feb-2026.)
theorem bdayfin (A2: class):
  $ wi (wcel A2 csur) (wb (wcel A2 cz12s) (wcel (cfv A2 cbday) com)) $;

--| The set of dyadic fractions is the same as the old set of ` _om ` . (Contributed by Scott Fenton, 26-Feb-2026.)
theorem dfz12s2:
  $ wceq cz12s (cfv com cold) $;

--| Declare the syntax for the surreal reals.
term creno: class;

--| Define the surreal reals. These are the finite numbers without any infintesimal parts. Definition from [Conway] p. 24. (Contributed by Scott Fenton, 15-Apr-2025.)
axiom df_reno {x3 y1 n: setvar}:
  $ wceq creno (crab x3 (wa (wrex n (wa (wbr (cfv (cv n) cnegs) (cv x3) clts) (wbr (cv x3) (cv n) clts)) cnns) (wceq (cv x3) (co (cab y1 (wrex n (wceq (cv y1) (co (cv x3) (co c1s (cv n) cdivs) csubs)) cnns)) (cab y1 (wrex n (wceq (cv y1) (co (cv x3) (co c1s (cv n) cdivs) cadds)) cnns)) ccuts))) csur) $;

--| Membership in the set of surreal reals. (Contributed by Scott Fenton, 15-Apr-2025.)
theorem elreno {x3 n: setvar} (A2: class):
  $ wb (wcel A2 creno) (wa (wcel A2 csur) (wa (wrex n (wa (wbr (cfv (cv n) cnegs) A2 clts) (wbr A2 (cv n) clts)) cnns) (wceq A2 (co (cab x3 (wrex n (wceq (cv x3) (co A2 (co c1s (cv n) cdivs) csubs)) cnns)) (cab x3 (wrex n (wceq (cv x3) (co A2 (co c1s (cv n) cdivs) cadds)) cnns)) ccuts)))) $;

--| A surreal real is a surreal number. (Contributed by Scott Fenton, 19-Feb-2026.)
theorem reno (A2: class):
  $ wi (wcel A2 creno) (wcel A2 csur) $;

--| A surreal real is a surreal number. (Contributed by Scott Fenton, 19-Feb-2026.)
theorem renod (ph: wff) (A2: class):
  $ wi ph (wcel A2 creno) $ >
  $ wi ph (wcel A2 csur) $;

--| The cut involved in defining surreal reals is a genuine cut. (Contributed by Scott Fenton, 15-Apr-2025.)
theorem recut {x3 n: setvar} (A2: class):
  $ wi (wcel A2 csur) (wbr (cab x3 (wrex n (wceq (cv x3) (co A2 (co c1s (cv n) cdivs) csubs)) cnns)) (cab x3 (wrex n (wceq (cv x3) (co A2 (co c1s (cv n) cdivs) cadds)) cnns)) cslts) $;

--| Alternate characterization of the surreal reals. Theorem 4.4(b) of [Gonshor] p. 39. (Contributed by Scott Fenton, 29-Jan-2026.)
theorem elreno2 {n xO: setvar} (A2: class):
  $ wb (wcel A2 creno) (wa (wcel A2 csur) (wa (wrex n (wa (wbr (cfv (cv n) cnegs) A2 clts) (wbr A2 (cv n) clts)) cnns) (wral xO (wrex n (wbr (co c1s (cv n) cdivs) (cfv (co A2 (cv xO) csubs) cabss) cles) cnns) (cun (cfv A2 cleft) (cfv A2 cright))))) $;

--| Surreal zero is a surreal real. (Contributed by Scott Fenton, 15-Apr-2025.)
theorem _0reno:
  $ wcel c0s creno $;

--| Surreal one is a surreal real. (Contributed by Scott Fenton, 18-Feb-2026.)
theorem _1reno:
  $ wcel c1s creno $;

--| The surreal reals are closed under negation. Part of theorem 13(ii) of [Conway] p. 24. (Contributed by Scott Fenton, 15-Apr-2025.)
theorem renegscl (A2: class):
  $ wi (wcel A2 creno) (wcel (cfv A2 cnegs) creno) $;

--| The surreal reals are closed under addition. Part of theorem 13(ii) of [Conway] p. 24. (Contributed by Scott Fenton, 15-Apr-2025.)
theorem readdscl (A2 B2: class):
  $ wi (wa (wcel A2 creno) (wcel B2 creno)) (wcel (co A2 B2 cadds) creno) $;

--| Lemma for ~ remulscl . Split a product of reciprocals of naturals. (Contributed by Scott Fenton, 16-Apr-2025.)
theorem remulscllem1 {n q p: setvar} (A2 B2 F: class):
  $ wb (wrex p (wrex q (wceq A2 (co B2 (co (co c1s (cv p) cdivs) (co c1s (cv q) cdivs) cmuls) F)) cnns) cnns) (wrex n (wceq A2 (co B2 (co c1s (cv n) cdivs) F)) cnns) $;

--| Lemma for ~ remulscl . Bound ` A ` and ` B ` above and below. (Contributed by Scott Fenton, 16-Apr-2025.)
theorem remulscllem2 {p: setvar} (A2 B2 M N: class):
  $ wi (wa (wa (wcel A2 csur) (wcel B2 csur)) (wa (wa (wcel N cnns) (wcel M cnns)) (wa (wa (wbr (cfv N cnegs) A2 clts) (wbr A2 N clts)) (wa (wbr (cfv M cnegs) B2 clts) (wbr B2 M clts))))) (wrex p (wa (wbr (cfv (cv p) cnegs) (co A2 B2 cmuls) clts) (wbr (co A2 B2 cmuls) (cv p) clts)) cnns) $;

--| The surreal reals are closed under multiplication. Part of theorem 13(ii) of [Conway] p. 24. (Contributed by Scott Fenton, 16-Apr-2025.)
theorem remulscl (A2 B2: class):
  $ wi (wa (wcel A2 creno) (wcel B2 creno)) (wcel (co A2 B2 cmuls) creno) $;

--| Extends class notation with the class of Tarski geometries.
term cstrkg: class;

--| Extends class notation with the class of geometries fulfilling the congruence axioms.
term cstrkgc: class;

--| Extends class notation with the class of geometries fulfilling the betweenness axioms.
term cstrkgb: class;

--| Extends class notation with the class of geometries fulfilling the congruence and betweenness axioms.
term cstrkgcb: class;

--| Extends class notation with the relation for geometries fulfilling the lower dimension axioms.
term cstrkgld: class;

--| Extends class notation with the class of geometries fulfilling Euclid's axiom.
term cstrkge: class;

--| Declare the syntax for the Interval (segment) index extractor.
term citv: class;

--| Declare the syntax for the Line function.
term clng: class;

--| Define the Interval (segment) index extractor for Tarski geometries. The interval is closed ( ~ tgbtwntriv1 and ~ tgbtwntriv2 ). Also known as the betweenness relation. (Contributed by Thierry Arnoux, 24-Aug-2017.) Use its index-independent form ~ itvid instead. (New usage is discouraged.)
axiom df_itv:
  $ wceq citv (cslot (cdc c1 c6)) $;

--| Define the line index extractor for geometries. (Contributed by Thierry Arnoux, 27-Mar-2019.) Use its index-independent form ~ lngid instead. (New usage is discouraged.)
axiom df_lng:
  $ wceq clng (cslot (cdc c1 c7)) $;

--| Index value of the Interval (segment) slot. Use ~ ndxarg . (Contributed by Thierry Arnoux, 24-Aug-2017.) (New usage is discouraged.)
theorem itvndx:
  $ wceq (cfv cnx citv) (cdc c1 c6) $;

--| Index value of the "line" slot. Use ~ ndxarg . (Contributed by Thierry Arnoux, 27-Mar-2019.) (New usage is discouraged.)
theorem lngndx:
  $ wceq (cfv cnx clng) (cdc c1 c7) $;

--| Utility theorem: index-independent form of ~ df-itv . (Contributed by Thierry Arnoux, 24-Aug-2017.)
theorem itvid:
  $ wceq citv (cslot (cfv cnx citv)) $;

--| Utility theorem: index-independent form of ~ df-lng . (Contributed by Thierry Arnoux, 27-Mar-2019.)
theorem lngid:
  $ wceq clng (cslot (cfv cnx clng)) $;

--| The slots ` Base ` , ` +g ` , ` .s ` and ` dist ` are different from the slot ` Itv ` . Formerly part of ~ ttglem and proofs using it. (Contributed by AV, 29-Oct-2024.)
theorem slotsinbpsd:
  $ wa (wa (wne (cfv cnx citv) (cfv cnx cbs)) (wne (cfv cnx citv) (cfv cnx cplusg))) (wa (wne (cfv cnx citv) (cfv cnx cvsca)) (wne (cfv cnx citv) (cfv cnx cds))) $;

--| The slots ` Base ` , ` +g ` , ` .s ` and ` dist ` are different from the slot ` LineG ` . Formerly part of ~ ttglem and proofs using it. (Contributed by AV, 29-Oct-2024.)
theorem slotslnbpsd:
  $ wa (wa (wne (cfv cnx clng) (cfv cnx cbs)) (wne (cfv cnx clng) (cfv cnx cplusg))) (wa (wne (cfv cnx clng) (cfv cnx cvsca)) (wne (cfv cnx clng) (cfv cnx cds))) $;

--| The slot for the line is not the slot for the Interval (segment) in an extensible structure. Formerly part of proof for ~ ttgval . (Contributed by AV, 9-Nov-2024.)
theorem lngndxnitvndx:
  $ wne (cfv cnx clng) (cfv cnx citv) $;

--| Functionality of a Tarski geometry. (Contributed by Thierry Arnoux, 24-Aug-2017.)
theorem trkgstr (D U I W: class):
  $ wceq W (ctp (cop (cfv cnx cbs) U) (cop (cfv cnx cds) D) (cop (cfv cnx citv) I)) $ >
  $ wbr W (cop c1 (cdc c1 c6)) cstr $;

--| The base set of a Tarski geometry. (Contributed by Thierry Arnoux, 24-Aug-2017.)
theorem trkgbas (D U I V W: class):
  $ wceq W (ctp (cop (cfv cnx cbs) U) (cop (cfv cnx cds) D) (cop (cfv cnx citv) I)) $ >
  $ wi (wcel U V) (wceq U (cfv W cbs)) $;

--| The measure of a distance in a Tarski geometry. (Contributed by Thierry Arnoux, 24-Aug-2017.)
theorem trkgdist (D U I V W: class):
  $ wceq W (ctp (cop (cfv cnx cbs) U) (cop (cfv cnx cds) D) (cop (cfv cnx citv) I)) $ >
  $ wi (wcel D V) (wceq D (cfv W cds)) $;

--| The congruence relation in a Tarski geometry. (Contributed by Thierry Arnoux, 24-Aug-2017.)
theorem trkgitv (D U I V W: class):
  $ wceq W (ctp (cop (cfv cnx cbs) U) (cop (cfv cnx cds) D) (cop (cfv cnx citv) I)) $ >
  $ wi (wcel I V) (wceq I (cfv W citv)) $;

--| Define the class of geometries fulfilling the congruence axioms of reflexivity, identity and transitivity. These are axioms A1 to A3 of [Schwabhauser] p. 10. With our distance based notation for congruence, transitivity of congruence boils down to transitivity of equality and is already given by ~ eqtr , so it is not listed in this definition. (Contributed by Thierry Arnoux, 24-Aug-2017.)
axiom df_trkgc {x3 y1 z f2 p d: setvar}:
  $ wceq cstrkgc (cab f2 (wsbc p (wsbc d (wa (wral x3 (wral y1 (wceq (co (cv x3) (cv y1) (cv d)) (co (cv y1) (cv x3) (cv d))) (cv p)) (cv p)) (wral x3 (wral y1 (wral z (wi (wceq (co (cv x3) (cv y1) (cv d)) (co (cv z) (cv z) (cv d))) (wceq (cv x3) (cv y1))) (cv p)) (cv p)) (cv p))) (cfv (cv f2) cds)) (cfv (cv f2) cbs))) $;

--| Define the class of geometries fulfilling the 3 betweenness axioms in Tarski's Axiomatization of Geometry: identity, Axiom A6 of [Schwabhauser] p. 11, axiom of Pasch, Axiom A7 of [Schwabhauser] p. 12, and continuity, Axiom A11 of [Schwabhauser] p. 13. (Contributed by Thierry Arnoux, 24-Aug-2017.)
axiom df_trkgb {x3 y1 z v u t f2 i s1 p a b: setvar}:
  $ wceq cstrkgb (cab f2 (wsbc p (wsbc i (w3a (wral x3 (wral y1 (wi (wcel (cv y1) (co (cv x3) (cv x3) (cv i))) (wceq (cv x3) (cv y1))) (cv p)) (cv p)) (wral x3 (wral y1 (wral z (wral u (wral v (wi (wa (wcel (cv u) (co (cv x3) (cv z) (cv i))) (wcel (cv v) (co (cv y1) (cv z) (cv i)))) (wrex a (wa (wcel (cv a) (co (cv u) (cv y1) (cv i))) (wcel (cv a) (co (cv v) (cv x3) (cv i)))) (cv p))) (cv p)) (cv p)) (cv p)) (cv p)) (cv p)) (wral s1 (wral t (wi (wrex a (wral x3 (wral y1 (wcel (cv x3) (co (cv a) (cv y1) (cv i))) (cv t)) (cv s1)) (cv p)) (wrex b (wral x3 (wral y1 (wcel (cv b) (co (cv x3) (cv y1) (cv i))) (cv t)) (cv s1)) (cv p))) (cpw (cv p))) (cpw (cv p)))) (cfv (cv f2) citv)) (cfv (cv f2) cbs))) $;

--| Define the class of geometries fulfilling the five segment axiom, Axiom A5 of [Schwabhauser] p. 11, and segment construction axiom, Axiom A4 of [Schwabhauser] p. 11. (Contributed by Thierry Arnoux, 14-Mar-2019.)
axiom df_trkgcb {x3 y1 z v u f2 i p a b c d: setvar}:
  $ wceq cstrkgcb (cab f2 (wsbc p (wsbc d (wsbc i (wa (wral x3 (wral y1 (wral z (wral u (wral a (wral b (wral c (wral v (wi (wa (w3a (wne (cv x3) (cv y1)) (wcel (cv y1) (co (cv x3) (cv z) (cv i))) (wcel (cv b) (co (cv a) (cv c) (cv i)))) (wa (wa (wceq (co (cv x3) (cv y1) (cv d)) (co (cv a) (cv b) (cv d))) (wceq (co (cv y1) (cv z) (cv d)) (co (cv b) (cv c) (cv d)))) (wa (wceq (co (cv x3) (cv u) (cv d)) (co (cv a) (cv v) (cv d))) (wceq (co (cv y1) (cv u) (cv d)) (co (cv b) (cv v) (cv d)))))) (wceq (co (cv z) (cv u) (cv d)) (co (cv c) (cv v) (cv d)))) (cv p)) (cv p)) (cv p)) (cv p)) (cv p)) (cv p)) (cv p)) (cv p)) (wral x3 (wral y1 (wral a (wral b (wrex z (wa (wcel (cv y1) (co (cv x3) (cv z) (cv i))) (wceq (co (cv y1) (cv z) (cv d)) (co (cv a) (cv b) (cv d)))) (cv p)) (cv p)) (cv p)) (cv p)) (cv p))) (cfv (cv f2) citv)) (cfv (cv f2) cds)) (cfv (cv f2) cbs))) $;

--| Define the class of geometries fulfilling Euclid's axiom, Axiom A10 of [Schwabhauser] p. 13. (Contributed by Thierry Arnoux, 14-Mar-2019.)
axiom df_trkge {x3 y1 z v u f2 i p a b: setvar}:
  $ wceq cstrkge (cab f2 (wsbc p (wsbc i (wral x3 (wral y1 (wral z (wral u (wral v (wi (w3a (wcel (cv u) (co (cv x3) (cv v) (cv i))) (wcel (cv u) (co (cv y1) (cv z) (cv i))) (wne (cv x3) (cv u))) (wrex a (wrex b (w3a (wcel (cv y1) (co (cv x3) (cv a) (cv i))) (wcel (cv z) (co (cv x3) (cv b) (cv i))) (wcel (cv v) (co (cv a) (cv b) (cv i)))) (cv p)) (cv p))) (cv p)) (cv p)) (cv p)) (cv p)) (cv p)) (cfv (cv f2) citv)) (cfv (cv f2) cbs))) $;

--| Define the class of geometries fulfilling the lower dimension axiom for dimension ` n ` . For such geometries, there are three non-colinear points that are equidistant from ` n - 1 ` distinct points. Derived from remarks in _Tarski's System of Geometry_, Alfred Tarski and Steven Givant, Bulletin of Symbolic Logic, Volume 5, Number 2 (1999), 175-214. (Contributed by Scott Fenton, 22-Apr-2013.) (Revised by Thierry Arnoux, 23-Nov-2019.)
axiom df_trkgld {x3 y1 z f2 g2 i j n p d: setvar}:
  $ wceq cstrkgld (copab g2 n (wsbc p (wsbc d (wsbc i (wex f2 (wa (wf1 (co c1 (cv n) cfzo) (cv p) (cv f2)) (wrex x3 (wrex y1 (wrex z (wa (wral j (w3a (wceq (co (cfv c1 (cv f2)) (cv x3) (cv d)) (co (cfv (cv j) (cv f2)) (cv x3) (cv d))) (wceq (co (cfv c1 (cv f2)) (cv y1) (cv d)) (co (cfv (cv j) (cv f2)) (cv y1) (cv d))) (wceq (co (cfv c1 (cv f2)) (cv z) (cv d)) (co (cfv (cv j) (cv f2)) (cv z) (cv d)))) (co c2 (cv n) cfzo)) (wn (w3o (wcel (cv z) (co (cv x3) (cv y1) (cv i))) (wcel (cv x3) (co (cv z) (cv y1) (cv i))) (wcel (cv y1) (co (cv x3) (cv z) (cv i)))))) (cv p)) (cv p)) (cv p)))) (cfv (cv g2) citv)) (cfv (cv g2) cds)) (cfv (cv g2) cbs))) $;

--| Define the class of Tarski geometries. A Tarski geometry is a set of points, equipped with a betweenness relation (denoting that a point lies on a line segment between two other points) and a congruence relation (denoting equality of line segment lengths). <HTML>Here, we are using the following:<UL> <LI> for congruence, ` ( x .- y ) = ( z .- w ) ` where ` .- = ( dist `` W ) ` <LI> for betweenness, ` y e. ( x I z ) ` , where ` I = ( Itv `` W ) ` </UL> With this definition, the axiom A2 is actually equivalent to the transitivity of equality, ~ eqtrd .<P> Tarski originally had more axioms, but later reduced his list to 11:<UL> <LI> A1 A kind of reflexivity for the congruence relation ( ` TarskiGC ` ) <LI> A2 Transitivity for the congruence relation ( ` TarskiGC ` ) <LI> A3 Identity for the congruence relation ( ` TarskiGC ` ) <LI> A4 Axiom of segment construction ( ` TarskiGCB ` ) <LI> A5 5-segment axiom ( ` TarskiGCB ` ) <LI> A6 Identity for the betweenness relation ( ` TarskiGB ` ) <LI> A7 Axiom of Pasch ( ` TarskiGB ` ) <LI> A8 Lower dimension axiom ` ( ``' TarskiGDim>= " { 2 } ) ` <LI> A9 Upper dimension axiom ` ( _V \ ( ``' TarskiGDim>= " { 3 } ) ) ` <LI> A10 Euclid's axiom ( ` TarskiGE ` ) <LI> A11 Axiom of continuity ( ` TarskiGB ` ) </UL> Our definition is split into 5 parts:<UL> <LI> congruence axioms ` TarskiGC ` (which metric spaces fulfill) <LI> betweenness axioms ` TarskiGB ` <LI> congruence and betweenness axioms ` TarskiGCB ` <LI> upper and lower dimension axioms ` TarskiGDim>= ` <LI> axiom of Euclid / parallel postulate ` TarskiGE ` </UL></HTML> So our definition of a Tarskian Geometry includes the 3 axioms for the quaternary congruence relation (A1, A2, A3), the 3 axioms for the ternary betweenness relation (A6, A7, A11), and the 2 axioms of compatibility of the congruence and the betweenness relations (A4,A5). It does not include Euclid's axiom A10, nor the 2-dimensional axioms A8 (Lower dimension axiom) and A9 (Upper dimension axiom) so the number of dimensions of the geometry it formalizes is not constrained. Considering A2 as one of the 3 axioms for the quaternary congruence relation is somewhat conventional, because the transitivity of the congruence relation is automatically given by our choice to take the distance as this congruence relation in our definition of Tarski geometries. (Contributed by Thierry Arnoux, 24-Aug-2017.) (Revised by Thierry Arnoux, 27-Apr-2019.)
axiom df_trkg {x3 y1 z f2 i p: setvar}:
  $ wceq cstrkg (cin (cin cstrkgc cstrkgb) (cin cstrkgcb (cab f2 (wsbc p (wsbc i (wceq (cfv (cv f2) clng) (cmpo x3 y1 (cv p) (cdif (cv p) (csn (cv x3))) (crab z (w3o (wcel (cv z) (co (cv x3) (cv y1) (cv i))) (wcel (cv x3) (co (cv z) (cv y1) (cv i))) (wcel (cv y1) (co (cv x3) (cv z) (cv i)))) (cv p)))) (cfv (cv f2) citv)) (cfv (cv f2) cbs))))) $;

--| Property of being a Tarski geometry - congruence part. (Contributed by Thierry Arnoux, 14-Mar-2019.)
theorem istrkgc {x3 y1 z: setvar} (P: class) (G: class x3 y1 z) (I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wb (wcel G cstrkgc) (wa (wcel G cvv) (wa (wral x3 (wral y1 (wceq (co (cv x3) (cv y1) c_mi) (co (cv y1) (cv x3) c_mi)) P) P) (wral x3 (wral y1 (wral z (wi (wceq (co (cv x3) (cv y1) c_mi) (co (cv z) (cv z) c_mi)) (wceq (cv x3) (cv y1))) P) P) P))) $;

--| Property of being a Tarski geometry - betweenness part. (Contributed by Thierry Arnoux, 14-Mar-2019.)
theorem istrkgb {x3 y1 z v u t s1 a b: setvar} (P: class) (G: class x3 y1 z v u t s1 a b) (I: class) (c_mi: class t s1):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wb (wcel G cstrkgb) (wa (wcel G cvv) (w3a (wral x3 (wral y1 (wi (wcel (cv y1) (co (cv x3) (cv x3) I)) (wceq (cv x3) (cv y1))) P) P) (wral x3 (wral y1 (wral z (wral u (wral v (wi (wa (wcel (cv u) (co (cv x3) (cv z) I)) (wcel (cv v) (co (cv y1) (cv z) I))) (wrex a (wa (wcel (cv a) (co (cv u) (cv y1) I)) (wcel (cv a) (co (cv v) (cv x3) I))) P)) P) P) P) P) P) (wral s1 (wral t (wi (wrex a (wral x3 (wral y1 (wcel (cv x3) (co (cv a) (cv y1) I)) (cv t)) (cv s1)) P) (wrex b (wral x3 (wral y1 (wcel (cv b) (co (cv x3) (cv y1) I)) (cv t)) (cv s1)) P)) (cpw P)) (cpw P)))) $;

--| Property of being a Tarski geometry - congruence and betweenness part. (Contributed by Thierry Arnoux, 14-Mar-2019.)
theorem istrkgcb {x3 y1 z v u a b c: setvar} (P: class) (G: class x3 y1 z v u a b c) (I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wb (wcel G cstrkgcb) (wa (wcel G cvv) (wa (wral x3 (wral y1 (wral z (wral u (wral a (wral b (wral c (wral v (wi (wa (w3a (wne (cv x3) (cv y1)) (wcel (cv y1) (co (cv x3) (cv z) I)) (wcel (cv b) (co (cv a) (cv c) I))) (wa (wa (wceq (co (cv x3) (cv y1) c_mi) (co (cv a) (cv b) c_mi)) (wceq (co (cv y1) (cv z) c_mi) (co (cv b) (cv c) c_mi))) (wa (wceq (co (cv x3) (cv u) c_mi) (co (cv a) (cv v) c_mi)) (wceq (co (cv y1) (cv u) c_mi) (co (cv b) (cv v) c_mi))))) (wceq (co (cv z) (cv u) c_mi) (co (cv c) (cv v) c_mi))) P) P) P) P) P) P) P) P) (wral x3 (wral y1 (wral a (wral b (wrex z (wa (wcel (cv y1) (co (cv x3) (cv z) I)) (wceq (co (cv y1) (cv z) c_mi) (co (cv a) (cv b) c_mi))) P) P) P) P) P))) $;

--| Property of fulfilling Euclid's axiom. (Contributed by Thierry Arnoux, 14-Mar-2019.)
theorem istrkge {x3 y1 z v u a b: setvar} (P: class) (G: class x3 y1 z v u a b) (I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wb (wcel G cstrkge) (wa (wcel G cvv) (wral x3 (wral y1 (wral z (wral u (wral v (wi (w3a (wcel (cv u) (co (cv x3) (cv v) I)) (wcel (cv u) (co (cv y1) (cv z) I)) (wne (cv x3) (cv u))) (wrex a (wrex b (w3a (wcel (cv y1) (co (cv x3) (cv a) I)) (wcel (cv z) (co (cv x3) (cv b) I)) (wcel (cv v) (co (cv a) (cv b) I))) P) P)) P) P) P) P) P)) $;

--| Building lines from the segment property. (Contributed by Thierry Arnoux, 14-Mar-2019.)
theorem istrkgl {x3 y1 z f2 i p: setvar} (P: class) (G: class x3 y1 z) (I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wb (wcel G (cab f2 (wsbc p (wsbc i (wceq (cfv (cv f2) clng) (cmpo x3 y1 (cv p) (cdif (cv p) (csn (cv x3))) (crab z (w3o (wcel (cv z) (co (cv x3) (cv y1) (cv i))) (wcel (cv x3) (co (cv z) (cv y1) (cv i))) (wcel (cv y1) (co (cv x3) (cv z) (cv i)))) (cv p)))) (cfv (cv f2) citv)) (cfv (cv f2) cbs)))) (wa (wcel G cvv) (wceq (cfv G clng) (cmpo x3 y1 P (cdif P (csn (cv x3))) (crab z (w3o (wcel (cv z) (co (cv x3) (cv y1) I)) (wcel (cv x3) (co (cv z) (cv y1) I)) (wcel (cv y1) (co (cv x3) (cv z) I))) P)))) $;

--| Property of fulfilling the lower dimension ` N ` axiom. (Contributed by Thierry Arnoux, 20-Nov-2019.)
theorem istrkgld {x3 y1 z f2 j: setvar} (P: class) (G: class x3 y1 z j) (I c_mi N: class) (V: class x3 y1 z f2 j):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi (wa (wcel G V) (wcel N (cfv c2 cuz))) (wb (wbr G N cstrkgld) (wex f2 (wa (wf1 (co c1 N cfzo) P (cv f2)) (wrex x3 (wrex y1 (wrex z (wa (wral j (w3a (wceq (co (cfv c1 (cv f2)) (cv x3) c_mi) (co (cfv (cv j) (cv f2)) (cv x3) c_mi)) (wceq (co (cfv c1 (cv f2)) (cv y1) c_mi) (co (cfv (cv j) (cv f2)) (cv y1) c_mi)) (wceq (co (cfv c1 (cv f2)) (cv z) c_mi) (co (cfv (cv j) (cv f2)) (cv z) c_mi))) (co c2 N cfzo)) (wn (w3o (wcel (cv z) (co (cv x3) (cv y1) I)) (wcel (cv x3) (co (cv z) (cv y1) I)) (wcel (cv y1) (co (cv x3) (cv z) I))))) P) P) P)))) $;

--| Property of fulfilling the lower dimension 2 axiom. (Contributed by Thierry Arnoux, 20-Nov-2019.) Avoid ~ ax-rep . (Revised by GG, 2-Apr-2026.)
theorem istrkg2ld {x3 y1 z: setvar} (P: class) (G: class x3 y1 z) (I c_mi: class) (V: class x3 y1 z):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi (wcel G V) (wb (wbr G c2 cstrkgld) (wrex x3 (wrex y1 (wrex z (wn (w3o (wcel (cv z) (co (cv x3) (cv y1) I)) (wcel (cv x3) (co (cv z) (cv y1) I)) (wcel (cv y1) (co (cv x3) (cv z) I)))) P) P) P)) $;

--| Property of fulfilling the lower dimension 3 axiom. (Contributed by Thierry Arnoux, 12-Jul-2020.)
theorem istrkg3ld {x3 y1 z v u: setvar} (P: class) (G: class x3 y1 z v u) (I c_mi: class) (V: class x3 y1 z v u):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi (wcel G V) (wb (wbr G c3 cstrkgld) (wrex u (wrex v (wa (wne (cv u) (cv v)) (wrex x3 (wrex y1 (wrex z (wa (w3a (wceq (co (cv u) (cv x3) c_mi) (co (cv v) (cv x3) c_mi)) (wceq (co (cv u) (cv y1) c_mi) (co (cv v) (cv y1) c_mi)) (wceq (co (cv u) (cv z) c_mi) (co (cv v) (cv z) c_mi))) (wn (w3o (wcel (cv z) (co (cv x3) (cv y1) I)) (wcel (cv x3) (co (cv z) (cv y1) I)) (wcel (cv y1) (co (cv x3) (cv z) I))))) P) P) P)) P) P)) $;

--| Axiom of reflexivity of congruence, Axiom A1 of [Schwabhauser] p. 10. (Contributed by Thierry Arnoux, 14-Mar-2019.)
theorem axtgcgrrflx (ph: wff) (P G I c_mi X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wceq (co X Y c_mi) (co Y X c_mi)) $;

--| Axiom of identity of congruence, Axiom A3 of [Schwabhauser] p. 10. (Contributed by Thierry Arnoux, 14-Mar-2019.)
theorem axtgcgrid (ph: wff) (P G I c_mi X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wceq (co X Y c_mi) (co Z Z c_mi)) $ >
  $ wi ph (wceq X Y) $;

--| Axiom of segment construction, Axiom A4 of [Schwabhauser] p. 11. As discussed in Axiom 4 of [Tarski1999] p. 178, "The intuitive content [is that] given any line segment ` A B ` , one can construct a line segment congruent to it, starting at any point ` Y ` and going in the direction of any ray containing ` Y ` . The ray is determined by the point ` Y ` and a second point ` X ` , the endpoint of the ray. The other endpoint of the line segment to be constructed is just the point ` z ` whose existence is asserted." (Contributed by Thierry Arnoux, 15-Mar-2019.)
theorem axtgsegcon {z: setvar} (ph: wff z) (A2 B2 P: class) (G: class z) (I c_mi X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wrex z (wa (wcel Y (co X (cv z) I)) (wceq (co Y (cv z) c_mi) (co A2 B2 c_mi))) P) $;

--| Five segments axiom, Axiom A5 of [Schwabhauser] p. 11. Take two triangles ` X Z U ` and ` A C V ` , a point ` Y ` on ` X Z ` , and a point ` B ` on ` A C ` . If all corresponding line segments except for ` Z U ` and ` C V ` are congruent ( i.e., ` X Y .~ A B ` , ` Y Z .~ B C ` , ` X U .~ A V ` , and ` Y U .~ B V ` ), then ` Z U ` and ` C V ` are also congruent. As noted in Axiom 5 of [Tarski1999] p. 178, "this axiom is similar in character to the well-known theorems of Euclidean geometry that allow one to conclude, from hypotheses about the congruence of certain corresponding sides and angles in two triangles, the congruence of other corresponding sides and angles." (Contributed by Thierry Arnoux, 14-Mar-2019.)
theorem axtg5seg (ph: wff) (A2 B2 C P U G I c_mi V X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel U P) $ >
  $ wi ph (wcel V P) $ >
  $ wi ph (wne X Y) $ >
  $ wi ph (wcel Y (co X Z I)) $ >
  $ wi ph (wcel B2 (co A2 C I)) $ >
  $ wi ph (wceq (co X Y c_mi) (co A2 B2 c_mi)) $ >
  $ wi ph (wceq (co Y Z c_mi) (co B2 C c_mi)) $ >
  $ wi ph (wceq (co X U c_mi) (co A2 V c_mi)) $ >
  $ wi ph (wceq (co Y U c_mi) (co B2 V c_mi)) $ >
  $ wi ph (wceq (co Z U c_mi) (co C V c_mi)) $;

--| Identity of Betweenness. Axiom A6 of [Schwabhauser] p. 11. (Contributed by Thierry Arnoux, 15-Mar-2019.)
theorem axtgbtwnid (ph: wff) (P G I c_mi X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Y (co X X I)) $ >
  $ wi ph (wceq X Y) $;

--| Axiom of (Inner) Pasch, Axiom A7 of [Schwabhauser] p. 12. Given triangle ` X Y Z ` , point ` U ` in segment ` X Z ` , and point ` V ` in segment ` Y Z ` , there exists a point ` a ` on both the segment ` U Y ` and the segment ` V X ` . This axiom is essentially a subset of the general Pasch axiom. The general Pasch axiom asserts that on a plane "a line intersecting a triangle in one of its sides, and not intersecting any of the vertices, must intersect one of the other two sides" (per the discussion about Axiom 7 of [Tarski1999] p. 179). The (general) Pasch axiom was used implicitly by Euclid, but never stated; Moritz Pasch discovered its omission in 1882. As noted in the Metamath book, this means that the omission of Pasch's axiom from Euclid went unnoticed for 2000 years. Only the inner Pasch algorithm is included as an axiom; the "outer" form of the Pasch axiom can be proved using the inner form (see theorem 9.6 of [Schwabhauser] p. 69 and the brief discussion in axiom 7.1 of [Tarski1999] p. 180). (Contributed by Thierry Arnoux, 15-Mar-2019.)
theorem axtgpasch {a: setvar} (ph: wff a) (P U: class) (G: class a) (I c_mi V X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel U P) $ >
  $ wi ph (wcel V P) $ >
  $ wi ph (wcel U (co X Z I)) $ >
  $ wi ph (wcel V (co Y Z I)) $ >
  $ wi ph (wrex a (wa (wcel (cv a) (co U Y I)) (wcel (cv a) (co V X I))) P) $;

--| Axiom of Continuity. Axiom A11 of [Schwabhauser] p. 13. This axiom (scheme) asserts that any two sets ` S ` and ` T ` (of points) such that the elements of ` S ` precede the elements of ` T ` with respect to some point ` a ` (that is, ` x ` is between ` a ` and ` y ` whenever ` x ` is in ` X ` and ` y ` is in ` Y ` ) are separated by some point ` b ` ; this is explained in Axiom 11 of [Tarski1999] p. 185. (Contributed by Thierry Arnoux, 16-Mar-2019.)
theorem axtgcont1 {x3 y1 a b: setvar} (ph: wff x3 y1 a b) (P: class) (S: class y1) (T: class) (G: class x3 y1 a b) (I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wss S P) $ >
  $ wi ph (wss T P) $ >
  $ wi ph (wi (wrex a (wral x3 (wral y1 (wcel (cv x3) (co (cv a) (cv y1) I)) T) S) P) (wrex b (wral x3 (wral y1 (wcel (cv b) (co (cv x3) (cv y1) I)) T) S) P)) $;

--| Axiom of Continuity. Axiom A11 of [Schwabhauser] p. 13. For more information see ~ axtgcont1 . (Contributed by Thierry Arnoux, 16-Mar-2019.)
theorem axtgcont {x3 y1 v u b: setvar} (ph: wff x3 y1 b) (A2 P: class) (S: class y1) (T: class) (G: class x3 y1 v u b) (I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wss S P) $ >
  $ wi ph (wss T P) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi (w3a ph (wcel (cv u) S) (wcel (cv v) T)) (wcel (cv u) (co A2 (cv v) I)) $ >
  $ wi ph (wrex b (wral x3 (wral y1 (wcel (cv b) (co (cv x3) (cv y1) I)) T) S) P) $;

--| Lower dimension axiom for dimension 2, Axiom A8 of [Schwabhauser] p. 13. There exist 3 non-colinear points. (Contributed by Thierry Arnoux, 20-Nov-2019.)
theorem axtglowdim2 {x3 y1 z: setvar} (ph: wff x3 y1 z) (P: class) (G: class x3 y1 z) (I c_mi: class) (V: class x3 y1 z):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wi ph (wrex x3 (wrex y1 (wrex z (wn (w3o (wcel (cv z) (co (cv x3) (cv y1) I)) (wcel (cv x3) (co (cv z) (cv y1) I)) (wcel (cv y1) (co (cv x3) (cv z) I)))) P) P) P) $;

--| Upper dimension axiom for dimension 2, Axiom A9 of [Schwabhauser] p. 13. Three points ` X ` , ` Y ` and ` Z ` equidistant to two given two points ` U ` and ` V ` must be colinear. (Contributed by Thierry Arnoux, 29-May-2019.) (Revised by Thierry Arnoux, 11-Jul-2020.)
theorem axtgupdim2 (ph: wff) (P U G I c_mi V X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel U P) $ >
  $ wi ph (wcel V P) $ >
  $ wi ph (wne U V) $ >
  $ wi ph (wceq (co U X c_mi) (co V X c_mi)) $ >
  $ wi ph (wceq (co U Y c_mi) (co V Y c_mi)) $ >
  $ wi ph (wceq (co U Z c_mi) (co V Z c_mi)) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wn (wbr G c3 cstrkgld)) $ >
  $ wi ph (w3o (wcel Z (co X Y I)) (wcel X (co Z Y I)) (wcel Y (co X Z I))) $;

--| Euclid's Axiom. Axiom A10 of [Schwabhauser] p. 13. This is equivalent to Euclid's parallel postulate when combined with other axioms. (Contributed by Thierry Arnoux, 16-Mar-2019.)
theorem axtgeucl {a b: setvar} (ph: wff a b) (P U: class) (G: class a b) (I c_mi V X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkge) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel U P) $ >
  $ wi ph (wcel V P) $ >
  $ wi ph (wcel U (co X V I)) $ >
  $ wi ph (wcel U (co Y Z I)) $ >
  $ wi ph (wne X U) $ >
  $ wi ph (wrex a (wrex b (w3a (wcel Y (co X (cv a) I)) (wcel Z (co X (cv b) I)) (wcel V (co (cv a) (cv b) I))) P) P) $;

--| Given any function ` F ` , equality of the image by ` F ` is an equivalence relation. (Contributed by Thierry Arnoux, 25-Jan-2023.)
theorem tgjustf {x3 y1 r: setvar} (A2 F: class) (V: class x3 y1 r):
  $ wi (wcel A2 V) (wex r (wa (wer A2 (cv r)) (wral x3 (wral y1 (wb (wbr (cv x3) (cv y1) (cv r)) (wceq (cfv (cv x3) F) (cfv (cv y1) F))) A2) A2))) $;

--| Given any equivalence relation ` R ` , one can define a function ` f ` such that all elements of an equivalence classe of ` R ` have the same image by ` f ` . (Contributed by Thierry Arnoux, 25-Jan-2023.)
theorem tgjustr {x3 y1 f2: setvar} (A2 R: class) (V: class f2):
  $ wi (wa (wcel A2 V) (wer A2 R)) (wex f2 (wa (wfn (cv f2) A2) (wral x3 (wral y1 (wb (wbr (cv x3) (cv y1) R) (wceq (cfv (cv x3) (cv f2)) (cfv (cv y1) (cv f2)))) A2) A2))) $;

--| A justification for using distance equality instead of the textbook relation on pairs of points for congruence. (Contributed by Thierry Arnoux, 29-Jan-2023.)
theorem tgjustc1 {x3 y1 z w r: setvar} (P: class) (G: class x3 y1 z w r) (c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wex r (wa (wer (cxp P P) (cv r)) (wral w (wral x3 (wral y1 (wral z (wb (wbr (cop (cv w) (cv x3)) (cop (cv y1) (cv z)) (cv r)) (wceq (co (cv w) (cv x3) c_mi) (co (cv y1) (cv z) c_mi))) P) P) P) P)) $;

--| A justification for using distance equality instead of the textbook relation on pairs of points for congruence. (Contributed by Thierry Arnoux, 29-Jan-2023.)
theorem tgjustc2 {x3 y1 z w d: setvar} (P R: class) (G: class x3 y1 z w d):
  $ wceq P (cfv G cbs) $ >
  $ wer (cxp P P) R $ >
  $ wex d (wa (wfn (cv d) (cxp P P)) (wral w (wral x3 (wral y1 (wral z (wb (wbr (cop (cv w) (cv x3)) (cop (cv y1) (cv z)) R) (wceq (co (cv w) (cv x3) (cv d)) (co (cv y1) (cv z) (cv d)))) P) P) P) P)) $;

--| Congruence commutes on the RHS. Theorem 2.5 of [Schwabhauser] p. 27. (Contributed by David A. Wheeler, 29-Jun-2020.)
theorem tgcgrcomimp (ph: wff) (A2 B2 C D P G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wi (wceq (co A2 B2 c_mi) (co C D c_mi)) (wceq (co A2 B2 c_mi) (co D C c_mi))) $;

--| Congruence commutes on the RHS. Variant of Theorem 2.5 of [Schwabhauser] p. 27, but in a convenient form for a common case. (Contributed by David A. Wheeler, 29-Jun-2020.)
theorem tgcgrcomr (ph: wff) (A2 B2 C D P G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co C D c_mi)) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co D C c_mi)) $;

--| Congruence commutes on the LHS. Variant of Theorem 2.5 of [Schwabhauser] p. 27, but in a convenient form for a common case. (Contributed by David A. Wheeler, 29-Jun-2020.)
theorem tgcgrcoml (ph: wff) (A2 B2 C D P G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co C D c_mi)) $ >
  $ wi ph (wceq (co B2 A2 c_mi) (co C D c_mi)) $;

--| Congruence commutes on both sides. (Contributed by Thierry Arnoux, 23-Mar-2019.)
theorem tgcgrcomlr (ph: wff) (A2 B2 C D P G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co C D c_mi)) $ >
  $ wi ph (wceq (co B2 A2 c_mi) (co D C c_mi)) $;

--| Congruence and equality. (Contributed by Thierry Arnoux, 27-Aug-2019.)
theorem tgcgreqb (ph: wff) (A2 B2 C D P G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co C D c_mi)) $ >
  $ wi ph (wb (wceq A2 B2) (wceq C D)) $;

--| Congruence and equality. (Contributed by Thierry Arnoux, 27-Aug-2019.)
theorem tgcgreq (ph: wff) (A2 B2 C D P G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co C D c_mi)) $ >
  $ wi ph (wceq A2 B2) $ >
  $ wi ph (wceq C D) $;

--| Congruence and equality. (Contributed by Thierry Arnoux, 27-Aug-2019.)
theorem tgcgrneq (ph: wff) (A2 B2 C D P G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co C D c_mi)) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wne C D) $;

--| Degenerate segments are congruent. Theorem 2.8 of [Schwabhauser] p. 28. (Contributed by Thierry Arnoux, 23-Mar-2019.)
theorem tgcgrtriv (ph: wff) (A2 B2 P G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wceq (co A2 A2 c_mi) (co B2 B2 c_mi)) $;

--| Link congruence over a pair of line segments. Theorem 2.11 of [Schwabhauser] p. 29. (Contributed by Thierry Arnoux, 23-Mar-2019.) (Shortened by David A. Wheeler and Thierry Arnoux, 22-Apr-2020.)
theorem tgcgrextend (ph: wff) (A2 B2 C D P E F G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel B2 (co A2 C I)) $ >
  $ wi ph (wcel E (co D F I)) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co D E c_mi)) $ >
  $ wi ph (wceq (co B2 C c_mi) (co E F c_mi)) $ >
  $ wi ph (wceq (co A2 C c_mi) (co D F c_mi)) $;

--| Two points that satisfy the conclusion of ~ axtgsegcon are identical. Uniqueness portion of Theorem 2.12 of [Schwabhauser] p. 29. (Contributed by Thierry Arnoux, 23-Mar-2019.)
theorem tgsegconeq (ph: wff) (A2 B2 C D P E F G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wne D A2) $ >
  $ wi ph (wcel A2 (co D E I)) $ >
  $ wi ph (wcel A2 (co D F I)) $ >
  $ wi ph (wceq (co A2 E c_mi) (co B2 C c_mi)) $ >
  $ wi ph (wceq (co A2 F c_mi) (co B2 C c_mi)) $ >
  $ wi ph (wceq E F) $;

--| The point constructed in ~ axtgsegcon is unique. (Contributed by Thierry Arnoux, 23-Aug-2026.)
theorem tgsegconeu {z: setvar} (ph: wff) (A2 B2 P: class) (G: class z) (I c_mi X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wne X Y) $ >
  $ wi ph (wreu z (wa (wcel Y (co X (cv z) I)) (wceq (co Y (cv z) c_mi) (co A2 B2 c_mi))) P) $;

--| Betweenness always holds for the second endpoint. Theorem 3.1 of [Schwabhauser] p. 30. (Contributed by Thierry Arnoux, 15-Mar-2019.)
theorem tgbtwntriv2 (ph: wff) (A2 B2 P G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel B2 (co A2 B2 I)) $;

--| Betweenness commutes. Theorem 3.2 of [Schwabhauser] p. 30. (Contributed by Thierry Arnoux, 15-Mar-2019.)
theorem tgbtwncom (ph: wff) (A2 B2 C P G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel B2 (co A2 C I)) $ >
  $ wi ph (wcel B2 (co C A2 I)) $;

--| Betweenness commutes, biconditional version. (Contributed by Thierry Arnoux, 3-Apr-2019.)
theorem tgbtwncomb (ph: wff) (A2 B2 C P G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wb (wcel B2 (co A2 C I)) (wcel B2 (co C A2 I))) $;

--| Betweenness and inequality. (Contributed by Thierry Arnoux, 1-Dec-2019.)
theorem tgbtwnne (ph: wff) (A2 B2 C P G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel B2 (co A2 C I)) $ >
  $ wi ph (wne B2 A2) $ >
  $ wi ph (wne A2 C) $;

--| Betweenness always holds for the first endpoint. Theorem 3.3 of [Schwabhauser] p. 30. (Contributed by Thierry Arnoux, 15-Mar-2019.)
theorem tgbtwntriv1 (ph: wff) (A2 B2 P G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel A2 (co A2 B2 I)) $;

--| If you can swap the first two arguments of a betweenness statement, then those arguments are identical. Theorem 3.4 of [Schwabhauser] p. 30. (Contributed by Thierry Arnoux, 16-Mar-2019.)
theorem tgbtwnswapid (ph: wff) (A2 B2 C P G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel A2 (co B2 C I)) $ >
  $ wi ph (wcel B2 (co A2 C I)) $ >
  $ wi ph (wceq A2 B2) $;

--| Inner transitivity law for betweenness. Left-hand side of Theorem 3.5 of [Schwabhauser] p. 30. (Contributed by Thierry Arnoux, 18-Mar-2019.)
theorem tgbtwnintr (ph: wff) (A2 B2 C D P G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel A2 (co B2 D I)) $ >
  $ wi ph (wcel B2 (co C D I)) $ >
  $ wi ph (wcel B2 (co A2 C I)) $;

--| Exchange the first endpoint in betweenness. Left-hand side of Theorem 3.6 of [Schwabhauser] p. 30. (Contributed by Thierry Arnoux, 18-Mar-2019.)
theorem tgbtwnexch3 (ph: wff) (A2 B2 C D P G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel B2 (co A2 C I)) $ >
  $ wi ph (wcel C (co A2 D I)) $ >
  $ wi ph (wcel C (co B2 D I)) $;

--| Outer transitivity law for betweenness. Left-hand side of Theorem 3.7 of [Schwabhauser] p. 30. (Contributed by Thierry Arnoux, 18-Mar-2019.)
theorem tgbtwnouttr2 (ph: wff) (A2 B2 C D P G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wne B2 C) $ >
  $ wi ph (wcel B2 (co A2 C I)) $ >
  $ wi ph (wcel C (co B2 D I)) $ >
  $ wi ph (wcel C (co A2 D I)) $;

--| Exchange the outer point of two betweenness statements. Right-hand side of Theorem 3.5 of [Schwabhauser] p. 30. (Contributed by Thierry Arnoux, 23-Mar-2019.)
theorem tgbtwnexch2 (ph: wff) (A2 B2 C D P G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel B2 (co A2 D I)) $ >
  $ wi ph (wcel C (co B2 D I)) $ >
  $ wi ph (wcel C (co A2 D I)) $;

--| Outer transitivity law for betweenness. Right-hand side of Theorem 3.7 of [Schwabhauser] p. 30. (Contributed by Thierry Arnoux, 23-Mar-2019.)
theorem tgbtwnouttr (ph: wff) (A2 B2 C D P G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wne B2 C) $ >
  $ wi ph (wcel B2 (co A2 C I)) $ >
  $ wi ph (wcel C (co B2 D I)) $ >
  $ wi ph (wcel B2 (co A2 D I)) $;

--| Outer transitivity law for betweenness. Right-hand side of Theorem 3.6 of [Schwabhauser] p. 30. (Contributed by Thierry Arnoux, 23-Mar-2019.)
theorem tgbtwnexch (ph: wff) (A2 B2 C D P G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel B2 (co A2 C I)) $ >
  $ wi ph (wcel C (co A2 D I)) $ >
  $ wi ph (wcel B2 (co A2 D I)) $;

--| A line segment between two sides of a triange intersects a segment crossing from the remaining side to the opposite vertex. Theorem 3.17 of [Schwabhauser] p. 33. (Contributed by Thierry Arnoux, 23-Mar-2019.)
theorem tgtrisegint {q: setvar} (ph: wff) (A2 B2 C D P E F: class) (G: class q) (I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel B2 (co A2 C I)) $ >
  $ wi ph (wcel E (co D C I)) $ >
  $ wi ph (wcel F (co A2 D I)) $ >
  $ wi ph (wrex q (wa (wcel (cv q) (co F C I)) (wcel (cv q) (co B2 E I))) P) $;

--| Lower dimension axiom for one dimension. In dimension at least 1, there are at least two distinct points. The condition "the space is of dimension 1 or more" is written here as ` 2 <_ ( # `` P ) ` to avoid a new definition, but a different convention could be chosen. (Contributed by Thierry Arnoux, 23-Mar-2019.)
theorem tglowdim1 {x3 y1: setvar} (ph: wff x3 y1) (P: class) (G I c_mi: class x3 y1):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr c2 (cfv P chash) cle) $ >
  $ wi ph (wrex x3 (wrex y1 (wne (cv x3) (cv y1)) P) P) $;

--| Lower dimension axiom for one dimension. (Contributed by Thierry Arnoux, 28-May-2019.)
theorem tglowdim1i {y1: setvar} (ph: wff y1) (P: class) (G I c_mi: class y1) (X: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr c2 (cfv P chash) cle) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wrex y1 (wne X (cv y1)) P) $;

--| Excluded-middle like statement allowing to treat dimension zero as a special case. (Contributed by Thierry Arnoux, 11-Apr-2019.)
theorem tgldimor (ph: wff) (A2 P E F: class):
  $ wceq P (cfv F E) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wo (wceq (cfv P chash) c1) (wbr c2 (cfv P chash) cle)) $;

--| In dimension zero, any two points are equal. (Contributed by Thierry Arnoux, 11-Apr-2019.)
theorem tgldim0eq (ph: wff) (A2 B2 P E F: class):
  $ wceq P (cfv F E) $ >
  $ wi ph (wceq (cfv P chash) c1) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wceq A2 B2) $;

--| In dimension zero, any two points are equal. (Contributed by Thierry Arnoux, 12-Apr-2019.)
theorem tgldim0itv (ph: wff) (A2 B2 C P G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wceq (cfv P chash) c1) $ >
  $ wi ph (wcel A2 (co B2 C I)) $;

--| In dimension zero, any two pairs of points are congruent. (Contributed by Thierry Arnoux, 12-Apr-2019.)
theorem tgldim0cgr (ph: wff) (A2 B2 C D P G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wceq (cfv P chash) c1) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co C D c_mi)) $;

--| There is always a ` c ` distinct from ` B ` such that ` B ` lies between ` A ` and ` c ` . Theorem 3.14 of [Schwabhauser] p. 32. The condition "the space is of dimension 1 or more" is written here as ` 2 <_ ( # `` P ) ` for simplicity. (Contributed by Thierry Arnoux, 23-Mar-2019.)
theorem tgbtwndiff {c: setvar} (ph: wff) (A2 B2 P: class) (G: class c) (I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wbr c2 (cfv P chash) cle) $ >
  $ wi ph (wrex c (wa (wcel B2 (co A2 (cv c) I)) (wne B2 (cv c))) P) $;

--| In geometries of dimension less than 2, all points are colinear. (Contributed by Thierry Arnoux, 27-Aug-2019.)
theorem tgdim01 (ph: wff) (P G I V X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wn (wbr G c2 cstrkgld)) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (w3o (wcel Z (co X Y I)) (wcel X (co Z Y I)) (wcel Y (co X Z I))) $;

--| Inner five segment congruence. Take two triangles, ` A D C ` and ` E H K ` , with ` B ` between ` A ` and ` C ` and ` F ` between ` E ` and ` K ` . If the other components of the triangles are congruent, then so are ` B D ` and ` F H ` . Theorem 4.2 of [Schwabhauser] p. 34. (Contributed by Thierry Arnoux, 24-Mar-2019.)
theorem tgifscgr (ph: wff) (A2 B2 C D P E F G H I K c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel K P) $ >
  $ wi ph (wcel H P) $ >
  $ wi ph (wcel B2 (co A2 C I)) $ >
  $ wi ph (wcel F (co E K I)) $ >
  $ wi ph (wceq (co A2 C c_mi) (co E K c_mi)) $ >
  $ wi ph (wceq (co B2 C c_mi) (co F K c_mi)) $ >
  $ wi ph (wceq (co A2 D c_mi) (co E H c_mi)) $ >
  $ wi ph (wceq (co C D c_mi) (co K H c_mi)) $ >
  $ wi ph (wceq (co B2 D c_mi) (co F H c_mi)) $;

--| Removing identical parts from the end of a line segment preserves congruence. Theorem 4.3 of [Schwabhauser] p. 35. (Contributed by Thierry Arnoux, 3-Apr-2019.)
theorem tgcgrsub (ph: wff) (A2 B2 C D P E F G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel B2 (co A2 C I)) $ >
  $ wi ph (wcel E (co D F I)) $ >
  $ wi ph (wceq (co A2 C c_mi) (co D F c_mi)) $ >
  $ wi ph (wceq (co B2 C c_mi) (co E F c_mi)) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co D E c_mi)) $;

--| Declare the constant for the congruence between shapes relation.
term ccgrg: class;

--| Define the relation of congruence between shapes. Definition 4.4 of [Schwabhauser] p. 35. A "shape" is a finite sequence of points, and a triangle can be represented as a shape with three points. Two shapes are congruent if all corresponding segments between all corresponding points are congruent. Many systems of geometry define triangle congruence as requiring both segment congruence and angle congruence. Such systems, such as Hilbert's axiomatic system, typically have a primitive notion of angle congruence in addition to segment congruence. Here, angle congruence is instead a derived notion, defined later in ~ df-cgra and expanded in ~ iscgra . This does not mean our system is weaker; ~ dfcgrg2 proves that these two definitions are equivalent, and using the Tarski definition instead (given in [Schwabhauser] p. 35) is simpler. Once two triangles are proven congruent as defined here, you can use various theorems to prove that corresponding parts of congruent triangles are congruent (CPCTC). For example, see ~ cgr3simp1 , ~ cgr3simp2 , ~ cgr3simp3 , ~ cgrcgra , and permutation laws such as ~ cgr3swap12 and ~ dfcgrg2 . Ideally, we would define this for functions of any set, but we will use words (see ~ df-word ) in most cases. (Contributed by Thierry Arnoux, 3-Apr-2019.)
axiom df_cgrg {g2 i j a b: setvar}:
  $ wceq ccgrg (cmpt g2 cvv (copab a b (wa (wa (wcel (cv a) (co (cfv (cv g2) cbs) cr cpm)) (wcel (cv b) (co (cfv (cv g2) cbs) cr cpm))) (wa (wceq (cdm (cv a)) (cdm (cv b))) (wral i (wral j (wceq (co (cfv (cv i) (cv a)) (cfv (cv j) (cv a)) (cfv (cv g2) cds)) (co (cfv (cv i) (cv b)) (cfv (cv j) (cv b)) (cfv (cv g2) cds))) (cdm (cv a))) (cdm (cv a))))))) $;

--| The congruence property for sequences of points. (Contributed by Thierry Arnoux, 3-Apr-2019.)
theorem iscgrg {i j: setvar} (A2 B2: class) (P c_sm: class i j) (G: class) (c_mi V: class i j):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq c_sm (cfv G ccgrg) $ >
  $ wi (wcel G V) (wb (wbr A2 B2 c_sm) (wa (wa (wcel A2 (co P cr cpm)) (wcel B2 (co P cr cpm))) (wa (wceq (cdm A2) (cdm B2)) (wral i (wral j (wceq (co (cfv (cv i) A2) (cfv (cv j) A2) c_mi) (co (cfv (cv i) B2) (cfv (cv j) B2) c_mi)) (cdm A2)) (cdm A2))))) $;

--| The property for two sequences ` A ` and ` B ` of points to be congruent. (Contributed by Thierry Arnoux, 3-Apr-2019.)
theorem iscgrgd {i j: setvar} (ph: wff i j) (A2 B2: class) (D P c_sm: class i j) (G: class) (c_mi V: class i j):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq c_sm (cfv G ccgrg) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wss D cr) $ >
  $ wi ph (wf D P A2) $ >
  $ wi ph (wf D P B2) $ >
  $ wi ph (wb (wbr A2 B2 c_sm) (wral i (wral j (wceq (co (cfv (cv i) A2) (cfv (cv j) A2) c_mi) (co (cfv (cv i) B2) (cfv (cv j) B2) c_mi)) (cdm A2)) (cdm A2))) $;

--| The property for two sequences ` A ` and ` B ` of points to be congruent, where the congruence is only required for indices verifying a less-than relation. (Contributed by Thierry Arnoux, 7-Oct-2020.)
theorem iscgrglt {i j: setvar} (ph: wff) (A2 B2: class) (D P c_sm: class i j) (G c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq c_sm (cfv G ccgrg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wss D cr) $ >
  $ wi ph (wf D P A2) $ >
  $ wi ph (wf D P B2) $ >
  $ wi ph (wb (wbr A2 B2 c_sm) (wral i (wral j (wi (wbr (cv i) (cv j) clt) (wceq (co (cfv (cv i) A2) (cfv (cv j) A2) c_mi) (co (cfv (cv i) B2) (cfv (cv j) B2) c_mi))) (cdm A2)) (cdm A2))) $;

--| The property for two triangles to be congruent to each other. (Contributed by Thierry Arnoux, 3-Apr-2019.)
theorem trgcgrg (ph: wff) (A2 B2 C D P c_sm E F G c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq c_sm (cfv G ccgrg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wb (wbr (cs3 A2 B2 C) (cs3 D E F) c_sm) (w3a (wceq (co A2 B2 c_mi) (co D E c_mi)) (wceq (co B2 C c_mi) (co E F c_mi)) (wceq (co C A2 c_mi) (co F D c_mi)))) $;

--| Triangle congruence. (Contributed by Thierry Arnoux, 27-Apr-2019.)
theorem trgcgr (ph: wff) (A2 B2 C D P c_sm E F G c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq c_sm (cfv G ccgrg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co D E c_mi)) $ >
  $ wi ph (wceq (co B2 C c_mi) (co E F c_mi)) $ >
  $ wi ph (wceq (co C A2 c_mi) (co F D c_mi)) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) c_sm) $;

--| The shape congruence relation is an equivalence relation. Statement 4.4 of [Schwabhauser] p. 35. (Contributed by Thierry Arnoux, 9-Apr-2019.)
theorem ercgrg (P G: class):
  $ wceq P (cfv G cbs) $ >
  $ wi (wcel G cstrkg) (wer (co P cr cpm) (cfv G ccgrg)) $;

--| A line segment can be divided at the same place as a congruent line segment is divided. Theorem 4.5 of [Schwabhauser] p. 35. (Contributed by Thierry Arnoux, 9-Apr-2019.)
theorem tgcgrxfr {e: setvar} (ph: wff) (A2 B2 C D P c_sm F: class) (G: class e) (I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_sm (cfv G ccgrg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel B2 (co A2 C I)) $ >
  $ wi ph (wceq (co A2 C c_mi) (co D F c_mi)) $ >
  $ wi ph (wrex e (wa (wcel (cv e) (co D F I)) (wbr (cs3 A2 B2 C) (cs3 D (cv e) F) c_sm)) P) $;

--| Reflexivity law for three-place congruence. (Contributed by Thierry Arnoux, 28-Apr-2019.)
theorem cgr3id (ph: wff) (A2 B2 C P c_sm G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_sm (cfv G ccgrg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 A2 B2 C) c_sm) $;

--| Deduce segment congruence from a triangle congruence. This is a portion of the theorem that corresponding parts of congruent triangles are congruent (CPCTC), focusing on a specific segment. (Contributed by Thierry Arnoux, 27-Apr-2019.)
theorem cgr3simp1 (ph: wff) (A2 B2 C D P c_sm E F G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_sm (cfv G ccgrg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) c_sm) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co D E c_mi)) $;

--| Deduce segment congruence from a triangle congruence. This is a portion of CPCTC, focusing on a specific segment. (Contributed by Thierry Arnoux, 27-Apr-2019.)
theorem cgr3simp2 (ph: wff) (A2 B2 C D P c_sm E F G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_sm (cfv G ccgrg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) c_sm) $ >
  $ wi ph (wceq (co B2 C c_mi) (co E F c_mi)) $;

--| Deduce segment congruence from a triangle congruence. This is a portion of CPCTC, focusing on a specific segment. (Contributed by Thierry Arnoux, 27-Apr-2019.)
theorem cgr3simp3 (ph: wff) (A2 B2 C D P c_sm E F G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_sm (cfv G ccgrg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) c_sm) $ >
  $ wi ph (wceq (co C A2 c_mi) (co F D c_mi)) $;

--| Permutation law for three-place congruence. (Contributed by Thierry Arnoux, 27-Apr-2019.)
theorem cgr3swap12 (ph: wff) (A2 B2 C D P c_sm E F G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_sm (cfv G ccgrg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) c_sm) $ >
  $ wi ph (wbr (cs3 B2 A2 C) (cs3 E D F) c_sm) $;

--| Permutation law for three-place congruence. (Contributed by Thierry Arnoux, 27-Apr-2019.)
theorem cgr3swap23 (ph: wff) (A2 B2 C D P c_sm E F G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_sm (cfv G ccgrg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) c_sm) $ >
  $ wi ph (wbr (cs3 A2 C B2) (cs3 D F E) c_sm) $;

--| Permutation law for three-place congruence. (Contributed by Thierry Arnoux, 3-Oct-2020.)
theorem cgr3swap13 (ph: wff) (A2 B2 C D P c_sm E F G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_sm (cfv G ccgrg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) c_sm) $ >
  $ wi ph (wbr (cs3 C B2 A2) (cs3 F E D) c_sm) $;

--| Permutation law for three-place congruence. (Contributed by Thierry Arnoux, 1-Aug-2020.)
theorem cgr3rotr (ph: wff) (A2 B2 C D P c_sm E F G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_sm (cfv G ccgrg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) c_sm) $ >
  $ wi ph (wbr (cs3 C A2 B2) (cs3 F D E) c_sm) $;

--| Permutation law for three-place congruence. (Contributed by Thierry Arnoux, 1-Aug-2020.)
theorem cgr3rotl (ph: wff) (A2 B2 C D P c_sm E F G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_sm (cfv G ccgrg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) c_sm) $ >
  $ wi ph (wbr (cs3 B2 C A2) (cs3 E F D) c_sm) $;

--| Commutative law for three-place congruence. (Contributed by Thierry Arnoux, 27-Apr-2019.)
theorem trgcgrcom (ph: wff) (A2 B2 C D P c_sm E F G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_sm (cfv G ccgrg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) c_sm) $ >
  $ wi ph (wbr (cs3 D E F) (cs3 A2 B2 C) c_sm) $;

--| Transitivity law for three-place congruence. (Contributed by Thierry Arnoux, 27-Apr-2019.)
theorem cgr3tr (ph: wff) (A2 B2 C D P c_sm E F G I J K L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_sm (cfv G ccgrg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) c_sm) $ >
  $ wi ph (wcel J P) $ >
  $ wi ph (wcel K P) $ >
  $ wi ph (wcel L P) $ >
  $ wi ph (wbr (cs3 D E F) (cs3 J K L) c_sm) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 J K L) c_sm) $;

--| A condition for extending betweenness to a new set of points based on congruence with another set of points. Theorem 4.6 of [Schwabhauser] p. 36. (Contributed by Thierry Arnoux, 27-Apr-2019.)
theorem tgbtwnxfr (ph: wff) (A2 B2 C D P c_sm E F G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_sm (cfv G ccgrg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) c_sm) $ >
  $ wi ph (wcel B2 (co A2 C I)) $ >
  $ wi ph (wcel E (co D F I)) $;

--| Two quadrilaterals to be congruent to each other if one triangle formed by their vertices is, and the additional points are equidistant too. (Contributed by Thierry Arnoux, 8-Oct-2020.)
theorem tgcgr4 (ph: wff) (A2 B2 C D P c_sm G I c_mi W X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_sm (cfv G ccgrg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wb (wbr (cs4 A2 B2 C D) (cs4 W X Y Z) c_sm) (wa (wbr (cs3 A2 B2 C) (cs3 W X Y) c_sm) (w3a (wceq (co A2 D c_mi) (co W Z c_mi)) (wceq (co B2 D c_mi) (co X Z c_mi)) (wceq (co C D c_mi) (co Y Z c_mi))))) $;

--| Declare the constant for the isometry builder.
term cismt: class;

--| Define the set of isometries between two structures. Definition 4.8 of [Schwabhauser] p. 36. See ~ isismt . (Contributed by Thierry Arnoux, 13-Dec-2019.)
axiom df_ismt {f2 g2 h a b: setvar}:
  $ wceq cismt (cmpo g2 h cvv cvv (cab f2 (wa (wf1o (cfv (cv g2) cbs) (cfv (cv h) cbs) (cv f2)) (wral a (wral b (wceq (co (cfv (cv a) (cv f2)) (cfv (cv b) (cv f2)) (cfv (cv h) cds)) (co (cv a) (cv b) (cfv (cv g2) cds))) (cfv (cv g2) cbs)) (cfv (cv g2) cbs))))) $;

--| Property of being an isometry. Compare with ~ isismty . (Contributed by Thierry Arnoux, 13-Dec-2019.)
theorem isismt {a b: setvar} (B2: class) (D P: class a b) (F G H: class) (c_mi V W: class a b):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq P (cfv H cbs) $ >
  $ wceq D (cfv G cds) $ >
  $ wceq c_mi (cfv H cds) $ >
  $ wi (wa (wcel G V) (wcel H W)) (wb (wcel F (co G H cismt)) (wa (wf1o B2 P F) (wral a (wral b (wceq (co (cfv (cv a) F) (cfv (cv b) F) c_mi) (co (cv a) (cv b) D)) B2) B2))) $;

--| Property of being an isometry mapping to the same space. In geometry, this is also called a motion. (Contributed by Thierry Arnoux, 15-Dec-2019.)
theorem ismot {a b: setvar} (P F G: class) (c_mi V: class a b):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi (wcel G V) (wb (wcel F (co G G cismt)) (wa (wf1o P P F) (wral a (wral b (wceq (co (cfv (cv a) F) (cfv (cv b) F) c_mi) (co (cv a) (cv b) c_mi)) P) P))) $;

--| Property of a motion: distances are preserved. (Contributed by Thierry Arnoux, 15-Dec-2019.)
theorem motcgr (ph: wff) (A2 B2 P F G c_mi V: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel F (co G G cismt)) $ >
  $ wi ph (wceq (co (cfv A2 F) (cfv B2 F) c_mi) (co A2 B2 c_mi)) $;

--| The identity is a motion. (Contributed by Thierry Arnoux, 15-Dec-2019.)
theorem idmot (ph: wff) (P G c_mi V: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wcel (cres cid P) (co G G cismt)) $;

--| Motions are bijections. (Contributed by Thierry Arnoux, 15-Dec-2019.)
theorem motf1o (ph: wff) (P F G c_mi V: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wcel F (co G G cismt)) $ >
  $ wi ph (wf1o P P F) $;

--| Closure of motions. (Contributed by Thierry Arnoux, 15-Dec-2019.)
theorem motcl (ph: wff) (A2 P F G c_mi V: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wcel F (co G G cismt)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel (cfv A2 F) P) $;

--| The composition of two motions is a motion. (Contributed by Thierry Arnoux, 15-Dec-2019.)
theorem motco (ph: wff) (P F G H c_mi V: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wcel F (co G G cismt)) $ >
  $ wi ph (wcel H (co G G cismt)) $ >
  $ wi ph (wcel (ccom F H) (co G G cismt)) $;

--| The converse of a motion is a motion. (Contributed by Thierry Arnoux, 15-Dec-2019.)
theorem cnvmot (ph: wff) (P F G c_mi V: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wcel F (co G G cismt)) $ >
  $ wi ph (wcel (ccnv F) (co G G cismt)) $;

--| The operation for motions is their composition. (Contributed by Thierry Arnoux, 15-Dec-2019.)
theorem motplusg {f2 g2: setvar} (ph: wff f2 g2) (P F: class f2 g2) (G: class) (H I c_mi V: class f2 g2):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wcel G V) $ >
  $ wceq I (cpr (cop (cfv cnx cbs) (co G G cismt)) (cop (cfv cnx cplusg) (cmpo f2 g2 (co G G cismt) (co G G cismt) (ccom (cv f2) (cv g2))))) $ >
  $ wi ph (wcel F (co G G cismt)) $ >
  $ wi ph (wcel H (co G G cismt)) $ >
  $ wi ph (wceq (co F H (cfv I cplusg)) (ccom F H)) $;

--| The motions of a geometry form a group with respect to function composition, called the Isometry group. (Contributed by Thierry Arnoux, 15-Dec-2019.)
theorem motgrp {f2 g2: setvar} (ph: wff) (P G I: class) (c_mi V: class f2 g2):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wcel G V) $ >
  $ wceq I (cpr (cop (cfv cnx cbs) (co G G cismt)) (cop (cfv cnx cplusg) (cmpo f2 g2 (co G G cismt) (co G G cismt) (ccom (cv f2) (cv g2))))) $ >
  $ wi ph (wcel I cgrp) $;

--| Property of a motion: distances are preserved. (Contributed by Thierry Arnoux, 15-Dec-2019.)
theorem motcgrg {f2 g2: setvar} (ph: wff) (P: class) (c_sm T F: class f2 g2) (G I: class) (c_mi V: class f2 g2):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wcel G V) $ >
  $ wceq I (cpr (cop (cfv cnx cbs) (co G G cismt)) (cop (cfv cnx cplusg) (cmpo f2 g2 (co G G cismt) (co G G cismt) (ccom (cv f2) (cv g2))))) $ >
  $ wceq c_sm (cfv G ccgrg) $ >
  $ wi ph (wcel T (cword P)) $ >
  $ wi ph (wcel F (co G G cismt)) $ >
  $ wi ph (wbr (ccom F T) T c_sm) $;

--| Property of a motion: distances are preserved, special case of triangles. (Contributed by Thierry Arnoux, 15-Dec-2019.)
theorem motcgr3 (ph: wff) (A2 B2 C D P c_sm E F G H c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq c_sm (cfv G ccgrg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wceq D (cfv A2 H)) $ >
  $ wi ph (wceq E (cfv B2 H)) $ >
  $ wi ph (wceq F (cfv C H)) $ >
  $ wi ph (wcel H (co G G cismt)) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) c_sm) $;

--| Lines of a Tarski Geometry. This relates to both Definition 4.10 of [Schwabhauser] p. 36. and Definition 6.14 of [Schwabhauser] p. 45. (Contributed by Thierry Arnoux, 28-Mar-2019.)
theorem tglng {x3 y1 z: setvar} (P G I: class) (L: class x3 y1 z):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq I (cfv G citv) $ >
  $ wi (wcel G cstrkg) (wceq L (cmpo x3 y1 P (cdif P (csn (cv x3))) (crab z (w3o (wcel (cv z) (co (cv x3) (cv y1) I)) (wcel (cv x3) (co (cv z) (cv y1) I)) (wcel (cv y1) (co (cv x3) (cv z) I))) P))) $;

--| Lines as functions. (Contributed by Thierry Arnoux, 25-May-2019.)
theorem tglnfn (P G I L: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq I (cfv G citv) $ >
  $ wi (wcel G cstrkg) (wfn L (cdif (cxp P P) cid)) $;

--| Lines are sets of points. (Contributed by Thierry Arnoux, 25-May-2019.)
theorem tglnunirn (P G I L: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq I (cfv G citv) $ >
  $ wi (wcel G cstrkg) (wss (cuni (crn L)) P) $;

--| Lines are sets of points. (Contributed by Thierry Arnoux, 17-Oct-2019.)
theorem tglnpt (ph: wff) (A2 P G I L X: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel X P) $;

--| It takes two different points to form a line. (Contributed by Thierry Arnoux, 6-Aug-2019.)
theorem tglngne (ph: wff) (P G I L X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z (co X Y L)) $ >
  $ wi ph (wne X Y) $;

--| The line going through points ` X ` and ` Y ` . (Contributed by Thierry Arnoux, 28-Mar-2019.)
theorem tglngval {z: setvar} (ph: wff) (P G I: class) (L: class z) (X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wne X Y) $ >
  $ wi ph (wceq (co X Y L) (crab z (w3o (wcel (cv z) (co X Y I)) (wcel X (co (cv z) Y I)) (wcel Y (co X (cv z) I))) P)) $;

--| Lines are subset of the geometry base set. That is, lines are sets of points. (Contributed by Thierry Arnoux, 17-May-2019.)
theorem tglnssp (ph: wff) (P G I L X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wne X Y) $ >
  $ wi ph (wss (co X Y L) P) $;

--| Property of lying on the line going through points ` X ` and ` Y ` . Definition 4.10 of [Schwabhauser] p. 36. We choose the notation ` Z e. ( X ( LineG `` G ) Y ) ` instead of "colinear" because ` LineG ` is a common structure slot for other axiomatizations of geometry. (Contributed by Thierry Arnoux, 28-Mar-2019.)
theorem tgellng (ph: wff) (P G I L X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wne X Y) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wb (wcel Z (co X Y L)) (w3o (wcel Z (co X Y I)) (wcel X (co Z Y I)) (wcel Y (co X Z I)))) $;

--| We choose the notation ` ( Z e. ( X L Y ) \/ X = Y ) ` instead of "colinear" in order to avoid defining an additional symbol for colinearity because ` LineG ` is a common structure slot for other axiomatizations of geometry. (Contributed by Thierry Arnoux, 25-May-2019.)
theorem tgcolg (ph: wff) (P G I L X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wb (wo (wcel Z (co X Y L)) (wceq X Y)) (w3o (wcel Z (co X Y I)) (wcel X (co Z Y I)) (wcel Y (co X Z I)))) $;

--| Betweenness implies colinearity. (Contributed by Thierry Arnoux, 28-Mar-2019.)
theorem btwncolg1 (ph: wff) (P G I L X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel Z (co X Y I)) $ >
  $ wi ph (wo (wcel Z (co X Y L)) (wceq X Y)) $;

--| Betweenness implies colinearity. (Contributed by Thierry Arnoux, 28-Mar-2019.)
theorem btwncolg2 (ph: wff) (P G I L X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel X (co Z Y I)) $ >
  $ wi ph (wo (wcel Z (co X Y L)) (wceq X Y)) $;

--| Betweenness implies colinearity. (Contributed by Thierry Arnoux, 28-Mar-2019.)
theorem btwncolg3 (ph: wff) (P G I L X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel Y (co X Z I)) $ >
  $ wi ph (wo (wcel Z (co X Y L)) (wceq X Y)) $;

--| Swapping the points defining a line keeps it unchanged. Part of Theorem 4.11 of [Schwabhauser] p. 34. (Contributed by Thierry Arnoux, 3-Apr-2019.)
theorem colcom (ph: wff) (P G I L X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wo (wcel Z (co X Y L)) (wceq X Y)) $ >
  $ wi ph (wo (wcel Z (co Y X L)) (wceq Y X)) $;

--| Rotating the points defining a line. Part of Theorem 4.11 of [Schwabhauser] p. 34. (Contributed by Thierry Arnoux, 3-Apr-2019.)
theorem colrot1 (ph: wff) (P G I L X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wo (wcel Z (co X Y L)) (wceq X Y)) $ >
  $ wi ph (wo (wcel X (co Y Z L)) (wceq Y Z)) $;

--| Rotating the points defining a line. Part of Theorem 4.11 of [Schwabhauser] p. 34. (Contributed by Thierry Arnoux, 3-Apr-2019.)
theorem colrot2 (ph: wff) (P G I L X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wo (wcel Z (co X Y L)) (wceq X Y)) $ >
  $ wi ph (wo (wcel Y (co Z X L)) (wceq Z X)) $;

--| Swapping non-colinear points. (Contributed by Thierry Arnoux, 19-Oct-2019.)
theorem ncolcom (ph: wff) (P G I L X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wn (wo (wcel Z (co X Y L)) (wceq X Y))) $ >
  $ wi ph (wn (wo (wcel Z (co Y X L)) (wceq Y X))) $;

--| Rotating non-colinear points. (Contributed by Thierry Arnoux, 19-Oct-2019.)
theorem ncolrot1 (ph: wff) (P G I L X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wn (wo (wcel Z (co X Y L)) (wceq X Y))) $ >
  $ wi ph (wn (wo (wcel X (co Y Z L)) (wceq Y Z))) $;

--| Rotating non-colinear points. (Contributed by Thierry Arnoux, 19-Oct-2019.)
theorem ncolrot2 (ph: wff) (P G I L X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wn (wo (wcel Z (co X Y L)) (wceq X Y))) $ >
  $ wi ph (wn (wo (wcel Y (co Z X L)) (wceq Z X))) $;

--| In geometries of dimension less than two, then any three points are colinear. (Contributed by Thierry Arnoux, 27-Aug-2019.)
theorem tgdim01ln (ph: wff) (P G I L X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wn (wbr G c2 cstrkgld)) $ >
  $ wi ph (wo (wcel Z (co X Y L)) (wceq X Y)) $;

--| If there are three non-colinear points, then the dimension is at least two. Converse of ~ tglowdim2l . (Contributed by Thierry Arnoux, 23-Feb-2020.)
theorem ncoltgdim2 (ph: wff) (P G I L X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wn (wo (wcel Z (co X Y L)) (wceq X Y))) $ >
  $ wi ph (wbr G c2 cstrkgld) $;

--| Transfer law for colinearity. Theorem 4.13 of [Schwabhauser] p. 37. (Contributed by Thierry Arnoux, 27-Apr-2019.)
theorem lnxfr (ph: wff) (A2 B2 C P c_sm G I L X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wceq c_sm (cfv G ccgrg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wo (wcel Y (co X Z L)) (wceq X Z)) $ >
  $ wi ph (wbr (cs3 X Y Z) (cs3 A2 B2 C) c_sm) $ >
  $ wi ph (wo (wcel B2 (co A2 C L)) (wceq A2 C)) $;

--| Extend a line with a missing point. Theorem 4.14 of [Schwabhauser] p. 37. (Contributed by Thierry Arnoux, 27-Apr-2019.)
theorem lnext {c: setvar} (ph: wff) (A2 B2 P c_sm: class) (G: class c) (I: class) (L: class c) (c_mi X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wceq c_sm (cfv G ccgrg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wo (wcel Y (co X Z L)) (wceq X Z)) $ >
  $ wi ph (wceq (co X Y c_mi) (co A2 B2 c_mi)) $ >
  $ wi ph (wrex c (wbr (cs3 X Y Z) (cs3 A2 B2 (cv c)) c_sm) P) $;

--| Congruence law for the general five segment configuration. Theorem 4.16 of [Schwabhauser] p. 37. (Contributed by Thierry Arnoux, 27-Apr-2019.)
theorem tgfscgr (ph: wff) (A2 B2 C D P c_sm T G I L c_mi X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wceq c_sm (cfv G ccgrg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wcel T P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wo (wcel Y (co X Z L)) (wceq X Z)) $ >
  $ wi ph (wbr (cs3 X Y Z) (cs3 A2 B2 C) c_sm) $ >
  $ wi ph (wceq (co X T c_mi) (co A2 D c_mi)) $ >
  $ wi ph (wceq (co Y T c_mi) (co B2 D c_mi)) $ >
  $ wi ph (wne X Y) $ >
  $ wi ph (wceq (co Z T c_mi) (co C D c_mi)) $;

--| Congruence rule for lines. Theorem 4.17 of [Schwabhauser] p. 37. (Contributed by Thierry Arnoux, 28-Apr-2019.)
theorem lncgr (ph: wff) (A2 B2 P c_sm G I L c_mi X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wceq c_sm (cfv G ccgrg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wne X Y) $ >
  $ wi ph (wo (wcel Y (co X Z L)) (wceq X Z)) $ >
  $ wi ph (wceq (co X A2 c_mi) (co X B2 c_mi)) $ >
  $ wi ph (wceq (co Y A2 c_mi) (co Y B2 c_mi)) $ >
  $ wi ph (wceq (co Z A2 c_mi) (co Z B2 c_mi)) $;

--| Identity law for points on lines. Theorem 4.18 of [Schwabhauser] p. 38. (Contributed by Thierry Arnoux, 28-Apr-2019.)
theorem lnid (ph: wff) (A2 B2 P c_sm G I L c_mi X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wceq c_sm (cfv G ccgrg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wne X Y) $ >
  $ wi ph (wo (wcel Y (co X Z L)) (wceq X Z)) $ >
  $ wi ph (wceq (co X Z c_mi) (co X A2 c_mi)) $ >
  $ wi ph (wceq (co Y Z c_mi) (co Y A2 c_mi)) $ >
  $ wi ph (wceq Z A2) $;

--| Law for finding a point inside a segment. Theorem 4.19 of [Schwabhauser] p. 38. (Contributed by Thierry Arnoux, 28-Apr-2019.)
theorem tgidinside (ph: wff) (A2 B2 P c_sm G I L c_mi X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wceq c_sm (cfv G ccgrg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wcel Z (co X Y I)) $ >
  $ wi ph (wceq (co X Z c_mi) (co X A2 c_mi)) $ >
  $ wi ph (wceq (co Y Z c_mi) (co Y A2 c_mi)) $ >
  $ wi ph (wceq Z A2) $;

--| Lemma for ~ tgbtwnconn1 . (Contributed by Thierry Arnoux, 30-Apr-2019.)
theorem tgbtwnconn1lem1 (ph: wff) (A2 B2 C D P E F G H I J c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wcel B2 (co A2 C I)) $ >
  $ wi ph (wcel B2 (co A2 D I)) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel H P) $ >
  $ wi ph (wcel J P) $ >
  $ wi ph (wcel D (co A2 E I)) $ >
  $ wi ph (wcel C (co A2 F I)) $ >
  $ wi ph (wcel E (co A2 H I)) $ >
  $ wi ph (wcel F (co A2 J I)) $ >
  $ wi ph (wceq (co E D c_mi) (co C D c_mi)) $ >
  $ wi ph (wceq (co C F c_mi) (co C D c_mi)) $ >
  $ wi ph (wceq (co E H c_mi) (co B2 C c_mi)) $ >
  $ wi ph (wceq (co F J c_mi) (co B2 D c_mi)) $ >
  $ wi ph (wceq H J) $;

--| Lemma for ~ tgbtwnconn1 . (Contributed by Thierry Arnoux, 30-Apr-2019.)
theorem tgbtwnconn1lem2 (ph: wff) (A2 B2 C D P E F G H I J c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wcel B2 (co A2 C I)) $ >
  $ wi ph (wcel B2 (co A2 D I)) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel H P) $ >
  $ wi ph (wcel J P) $ >
  $ wi ph (wcel D (co A2 E I)) $ >
  $ wi ph (wcel C (co A2 F I)) $ >
  $ wi ph (wcel E (co A2 H I)) $ >
  $ wi ph (wcel F (co A2 J I)) $ >
  $ wi ph (wceq (co E D c_mi) (co C D c_mi)) $ >
  $ wi ph (wceq (co C F c_mi) (co C D c_mi)) $ >
  $ wi ph (wceq (co E H c_mi) (co B2 C c_mi)) $ >
  $ wi ph (wceq (co F J c_mi) (co B2 D c_mi)) $ >
  $ wi ph (wceq (co E F c_mi) (co C D c_mi)) $;

--| Lemma for ~ tgbtwnconn1 . (Contributed by Thierry Arnoux, 30-Apr-2019.)
theorem tgbtwnconn1lem3 (ph: wff) (A2 B2 C D P E F G H I J c_mi X: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wcel B2 (co A2 C I)) $ >
  $ wi ph (wcel B2 (co A2 D I)) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel H P) $ >
  $ wi ph (wcel J P) $ >
  $ wi ph (wcel D (co A2 E I)) $ >
  $ wi ph (wcel C (co A2 F I)) $ >
  $ wi ph (wcel E (co A2 H I)) $ >
  $ wi ph (wcel F (co A2 J I)) $ >
  $ wi ph (wceq (co E D c_mi) (co C D c_mi)) $ >
  $ wi ph (wceq (co C F c_mi) (co C D c_mi)) $ >
  $ wi ph (wceq (co E H c_mi) (co B2 C c_mi)) $ >
  $ wi ph (wceq (co F J c_mi) (co B2 D c_mi)) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel X (co C E I)) $ >
  $ wi ph (wcel X (co D F I)) $ >
  $ wi ph (wne C E) $ >
  $ wi ph (wceq D F) $;

--| Connectivity law for betweenness. Theorem 5.1 of [Schwabhauser] p. 39-41. In earlier presentations of Tarski's axioms, this theorem appeared as an additional axiom. It was derived from the other axioms by Gupta, 1965. (Contributed by Thierry Arnoux, 30-Apr-2019.)
theorem tgbtwnconn1 (ph: wff) (A2 B2 C D P G I: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wcel B2 (co A2 C I)) $ >
  $ wi ph (wcel B2 (co A2 D I)) $ >
  $ wi ph (wo (wcel C (co A2 D I)) (wcel D (co A2 C I))) $;

--| Another connectivity law for betweenness. Theorem 5.2 of [Schwabhauser] p. 41. (Contributed by Thierry Arnoux, 17-May-2019.)
theorem tgbtwnconn2 (ph: wff) (A2 B2 C D P G I: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wcel B2 (co A2 C I)) $ >
  $ wi ph (wcel B2 (co A2 D I)) $ >
  $ wi ph (wo (wcel C (co B2 D I)) (wcel D (co B2 C I))) $;

--| Inner connectivity law for betweenness. Theorem 5.3 of [Schwabhauser] p. 41. (Contributed by Thierry Arnoux, 17-May-2019.)
theorem tgbtwnconn3 (ph: wff) (A2 B2 C D P G I: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel B2 (co A2 D I)) $ >
  $ wi ph (wcel C (co A2 D I)) $ >
  $ wi ph (wo (wcel B2 (co A2 C I)) (wcel C (co A2 B2 I))) $;

--| Derive colinearity from betweenness. (Contributed by Thierry Arnoux, 17-May-2019.)
theorem tgbtwnconnln3 (ph: wff) (A2 B2 C D P G I L: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel B2 (co A2 D I)) $ >
  $ wi ph (wcel C (co A2 D I)) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wo (wcel B2 (co A2 C L)) (wceq A2 C)) $;

--| Double connectivity law for betweenness. (Contributed by Thierry Arnoux, 1-Dec-2019.)
theorem tgbtwnconn22 (ph: wff) (A2 B2 C D P E G I: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wne C B2) $ >
  $ wi ph (wcel B2 (co A2 C I)) $ >
  $ wi ph (wcel B2 (co A2 D I)) $ >
  $ wi ph (wcel B2 (co C E I)) $ >
  $ wi ph (wcel B2 (co D E I)) $;

--| Derive colinearity from betweenness. (Contributed by Thierry Arnoux, 17-May-2019.)
theorem tgbtwnconnln1 (ph: wff) (A2 B2 C D P G I L: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wcel B2 (co A2 C I)) $ >
  $ wi ph (wcel B2 (co A2 D I)) $ >
  $ wi ph (wo (wcel A2 (co C D L)) (wceq C D)) $;

--| Derive colinearity from betweenness. (Contributed by Thierry Arnoux, 17-May-2019.)
theorem tgbtwnconnln2 (ph: wff) (A2 B2 C D P G I L: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wcel B2 (co A2 C I)) $ >
  $ wi ph (wcel B2 (co A2 D I)) $ >
  $ wi ph (wo (wcel B2 (co C D L)) (wceq C D)) $;

--| Less-than relation for geometric congruences.
term cleg: class;

--| Define the less-than relationship between geometric distance congruence classes. See ~ legval . (Contributed by Thierry Arnoux, 21-Jun-2019.)
axiom df_leg {x3 y1 z e f2 g2 i p d: setvar}:
  $ wceq cleg (cmpt g2 cvv (copab e f2 (wsbc p (wsbc d (wsbc i (wrex x3 (wrex y1 (wa (wceq (cv f2) (co (cv x3) (cv y1) (cv d))) (wrex z (wa (wcel (cv z) (co (cv x3) (cv y1) (cv i))) (wceq (cv e) (co (cv x3) (cv z) (cv d)))) (cv p))) (cv p)) (cv p)) (cfv (cv g2) citv)) (cfv (cv g2) cds)) (cfv (cv g2) cbs)))) $;

--| Value of the less-than relationship. (Contributed by Thierry Arnoux, 21-Jun-2019.)
theorem legval {x3 y1 z e f2: setvar} (ph: wff x3 y1 z e f2) (P: class) (G: class x3 y1 z) (I: class e f2) (c_le: class x3 y1 z e f2) (c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_le (cfv G cleg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wceq c_le (copab e f2 (wrex x3 (wrex y1 (wa (wceq (cv f2) (co (cv x3) (cv y1) c_mi)) (wrex z (wa (wcel (cv z) (co (cv x3) (cv y1) I)) (wceq (cv e) (co (cv x3) (cv z) c_mi))) P)) P) P))) $;

--| Value of the less-than relationship. Definition 5.4 of [Schwabhauser] p. 41. (Contributed by Thierry Arnoux, 21-Jun-2019.)
theorem legov {z: setvar} (ph: wff) (A2 B2 C D P G I: class) (c_le: class z) (c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_le (cfv G cleg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wb (wbr (co A2 B2 c_mi) (co C D c_mi) c_le) (wrex z (wa (wcel (cv z) (co C D I)) (wceq (co A2 B2 c_mi) (co C (cv z) c_mi))) P)) $;

--| An equivalent definition of the less-than relationship. Definition 5.5 of [Schwabhauser] p. 41. (Contributed by Thierry Arnoux, 21-Jun-2019.)
theorem legov2 {x3: setvar} (ph: wff) (A2 B2 C D P G I: class) (c_le: class x3) (c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_le (cfv G cleg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wb (wbr (co A2 B2 c_mi) (co C D c_mi) c_le) (wrex x3 (wa (wcel B2 (co A2 (cv x3) I)) (wceq (co A2 (cv x3) c_mi) (co C D c_mi))) P)) $;

--| Reflexivity of the less-than relationship. Proposition 5.7 of [Schwabhauser] p. 42. (Contributed by Thierry Arnoux, 27-Jun-2019.)
theorem legid (ph: wff) (A2 B2 P G I c_le c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_le (cfv G cleg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wbr (co A2 B2 c_mi) (co A2 B2 c_mi) c_le) $;

--| Betweenness implies less-than relation. (Contributed by Thierry Arnoux, 3-Jul-2019.)
theorem btwnleg (ph: wff) (A2 B2 C P G I c_le c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_le (cfv G cleg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel B2 (co A2 C I)) $ >
  $ wi ph (wbr (co A2 B2 c_mi) (co A2 C c_mi) c_le) $;

--| Transitivity of the less-than relationship. Proposition 5.8 of [Schwabhauser] p. 42. (Contributed by Thierry Arnoux, 27-Jun-2019.)
theorem legtrd (ph: wff) (A2 B2 C D P E F G I c_le c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_le (cfv G cleg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (co A2 B2 c_mi) (co C D c_mi) c_le) $ >
  $ wi ph (wbr (co C D c_mi) (co E F c_mi) c_le) $ >
  $ wi ph (wbr (co A2 B2 c_mi) (co E F c_mi) c_le) $;

--| Equality from the less-than relationship. Proposition 5.9 of [Schwabhauser] p. 42. (Contributed by Thierry Arnoux, 27-Jun-2019.)
theorem legtri3 (ph: wff) (A2 B2 C D P G I c_le c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_le (cfv G cleg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wbr (co A2 B2 c_mi) (co C D c_mi) c_le) $ >
  $ wi ph (wbr (co C D c_mi) (co A2 B2 c_mi) c_le) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co C D c_mi)) $;

--| Trichotomy law for the less-than relationship. Proposition 5.10 of [Schwabhauser] p. 42. (Contributed by Thierry Arnoux, 27-Jun-2019.)
theorem legtrid (ph: wff) (A2 B2 C D P G I c_le c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_le (cfv G cleg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wo (wbr (co A2 B2 c_mi) (co C D c_mi) c_le) (wbr (co C D c_mi) (co A2 B2 c_mi) c_le)) $;

--| Degenerated (zero-length) segments are minimal. Proposition 5.11 of [Schwabhauser] p. 42. (Contributed by Thierry Arnoux, 27-Jun-2019.)
theorem leg0 (ph: wff) (A2 B2 C D P G I c_le c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_le (cfv G cleg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wbr (co A2 A2 c_mi) (co C D c_mi) c_le) $;

--| Deduce equality from "less than" null segments. (Contributed by Thierry Arnoux, 12-Aug-2019.)
theorem legeq (ph: wff) (A2 B2 C D P G I c_le c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_le (cfv G cleg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wbr (co A2 B2 c_mi) (co C C c_mi) c_le) $ >
  $ wi ph (wceq A2 B2) $;

--| Deduce betweenness from "less than" relation. Corresponds loosely to Proposition 6.13 of [Schwabhauser] p. 45. (Contributed by Thierry Arnoux, 25-Aug-2019.)
theorem legbtwn (ph: wff) (A2 B2 C D P G I c_le c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_le (cfv G cleg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wo (wcel A2 (co C B2 I)) (wcel B2 (co C A2 I))) $ >
  $ wi ph (wbr (co C A2 c_mi) (co C B2 c_mi) c_le) $ >
  $ wi ph (wcel A2 (co C B2 I)) $;

--| Removing identical parts from the end of a line segment preserves congruence. In this version the order of points is not known. (Contributed by Thierry Arnoux, 3-Apr-2019.)
theorem tgcgrsub2 (ph: wff) (A2 B2 C D P E F G I c_le c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_le (cfv G cleg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wo (wcel B2 (co A2 C I)) (wcel C (co A2 B2 I))) $ >
  $ wi ph (wo (wcel E (co D F I)) (wcel F (co D E I))) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co D E c_mi)) $ >
  $ wi ph (wceq (co A2 C c_mi) (co D F c_mi)) $ >
  $ wi ph (wceq (co B2 C c_mi) (co E F c_mi)) $;

--| The set ` E ` denotes the possible values of the congruence. (Contributed by Thierry Arnoux, 15-Dec-2019.)
theorem ltgseg {x3 y1: setvar} (ph: wff) (A2 P: class) (E G I c_le: class x3 y1) (c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_le (cfv G cleg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq E (cima c_mi (cxp P P)) $ >
  $ wi ph (wfun c_mi) $ >
  $ wi ph (wcel A2 E) $ >
  $ wi ph (wrex x3 (wrex y1 (wceq A2 (co (cv x3) (cv y1) c_mi)) P) P) $;

--| Strict "shorter than" geometric relation between segments. (Contributed by Thierry Arnoux, 15-Dec-2019.)
theorem ltgov (ph: wff) (A2 B2 C D P c_lt E G I c_le c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_le (cfv G cleg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq E (cima c_mi (cxp P P)) $ >
  $ wi ph (wfun c_mi) $ >
  $ wceq c_lt (cdif (cres c_le E) cid) $ >
  $ wi ph (wss (cxp P P) (cdm c_mi)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wb (wbr (co A2 B2 c_mi) (co C D c_mi) c_lt) (wa (wbr (co A2 B2 c_mi) (co C D c_mi) c_le) (wne (co A2 B2 c_mi) (co C D c_mi)))) $;

--| An equivalent definition of the less-than relationship, from the strict relation. (Contributed by Thierry Arnoux, 15-Dec-2019.)
theorem legov3 (ph: wff) (A2 B2 C D P c_lt E G I c_le c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_le (cfv G cleg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq E (cima c_mi (cxp P P)) $ >
  $ wi ph (wfun c_mi) $ >
  $ wceq c_lt (cdif (cres c_le E) cid) $ >
  $ wi ph (wss (cxp P P) (cdm c_mi)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wb (wbr (co A2 B2 c_mi) (co C D c_mi) c_le) (wo (wbr (co A2 B2 c_mi) (co C D c_mi) c_lt) (wceq (co A2 B2 c_mi) (co C D c_mi)))) $;

--| The "shorter than" relation induces an order on pairs. Remark 5.13 of [Schwabhauser] p. 42. (Contributed by Thierry Arnoux, 27-Jun-2019.)
theorem legso (ph: wff) (P c_lt E G I c_le c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_le (cfv G cleg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq E (cima c_mi (cxp P P)) $ >
  $ wi ph (wfun c_mi) $ >
  $ wceq c_lt (cdif (cres c_le E) cid) $ >
  $ wi ph (wss (cxp P P) (cdm c_mi)) $ >
  $ wi ph (wor E c_lt) $;

--| Function producing the relation "belong to the same half-line".
term chlg: class;

--| Define the function producting the relation "belong to the same half-line". (Contributed by Thierry Arnoux, 15-Aug-2020.)
axiom df_hlg {g2 a b c: setvar}:
  $ wceq chlg (cmpt g2 cvv (cmpt c (cfv (cv g2) cbs) (copab a b (wa (wa (wcel (cv a) (cfv (cv g2) cbs)) (wcel (cv b) (cfv (cv g2) cbs))) (w3a (wne (cv a) (cv c)) (wne (cv b) (cv c)) (wo (wcel (cv a) (co (cv c) (cv b) (cfv (cv g2) citv))) (wcel (cv b) (co (cv c) (cv a) (cfv (cv g2) citv))))))))) $;

--| Alternate version of ~ ishlg , including closure. (Contributed by Thierry Arnoux, 13-Jul-2026.)
theorem ishlg2 (ph: wff) (A2 B2 C P G I K V: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wb (wbr A2 B2 (cfv C K)) (wa (wa (wcel A2 P) (wcel B2 P)) (w3a (wne A2 C) (wne B2 C) (wo (wcel A2 (co C B2 I)) (wcel B2 (co C A2 I)))))) $;

--| Reverse closure for rays. (Contributed by Thierry Arnoux, 13-Jul-2026.)
theorem hlgrcl1 (ph: wff) (A2 B2 C P G I K V: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wbr A2 B2 (cfv C K)) $ >
  $ wi ph (wcel A2 P) $;

--| Reverse closure for rays. (Contributed by Thierry Arnoux, 13-Jul-2026.)
theorem hlgrcl2 (ph: wff) (A2 B2 C P G I K V: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wbr A2 B2 (cfv C K)) $ >
  $ wi ph (wcel B2 P) $;

--| Rays : Definition 6.1 of [Schwabhauser] p. 43. With this definition, ` A ( K `` C ) B ` means that ` A ` and ` B ` are on the same ray with initial point ` C ` . This follows the same notation as Schwabhauser where rays are first defined as a relation. It is possible to recover the ray itself using e.g., ` ( ( K `` C ) " { A } ) ` . (Contributed by Thierry Arnoux, 21-Dec-2019.)
theorem ishlg (ph: wff) (A2 B2 C P G I K V: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wb (wbr A2 B2 (cfv C K)) (w3a (wne A2 C) (wne B2 C) (wo (wcel A2 (co C B2 I)) (wcel B2 (co C A2 I))))) $;

--| The half-line relation is symmetric. Theorem 6.6 of [Schwabhauser] p. 44. (Contributed by Thierry Arnoux, 21-Feb-2020.)
theorem hlcomb (ph: wff) (A2 B2 C P G I K V: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wb (wbr A2 B2 (cfv C K)) (wbr B2 A2 (cfv C K))) $;

--| The half-line relation is symmetric. Theorem 6.6 of [Schwabhauser] p. 44. (Contributed by Thierry Arnoux, 21-Feb-2020.)
theorem hlcomd (ph: wff) (A2 B2 C P G I K V: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wbr A2 B2 (cfv C K)) $ >
  $ wi ph (wbr B2 A2 (cfv C K)) $;

--| The half-line relation implies inequality. (Contributed by Thierry Arnoux, 22-Feb-2020.)
theorem hlne1 (ph: wff) (A2 B2 C P G I K V: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wbr A2 B2 (cfv C K)) $ >
  $ wi ph (wne A2 C) $;

--| The half-line relation implies inequality. (Contributed by Thierry Arnoux, 22-Feb-2020.)
theorem hlne2 (ph: wff) (A2 B2 C P G I K V: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wbr A2 B2 (cfv C K)) $ >
  $ wi ph (wne B2 C) $;

--| The half-line relation implies colinearity, part of Theorem 6.4 of [Schwabhauser] p. 44. (Contributed by Thierry Arnoux, 22-Feb-2020.)
theorem hlln (ph: wff) (A2 B2 C P G I K L: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wbr A2 B2 (cfv C K)) $ >
  $ wi ph (wcel A2 (co B2 C L)) $;

--| The endpoint does not belong to the half-line. (Contributed by Thierry Arnoux, 3-Mar-2020.)
theorem hleqnid (ph: wff) (A2 B2 C P G I K: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wn (wbr A2 B2 (cfv A2 K))) $;

--| The half-line relation is reflexive. Theorem 6.5 of [Schwabhauser] p. 44. (Contributed by Thierry Arnoux, 21-Feb-2020.)
theorem hlid (ph: wff) (A2 B2 C P G I K: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wne A2 C) $ >
  $ wi ph (wbr A2 A2 (cfv C K)) $;

--| The half-line relation is transitive. Theorem 6.7 of [Schwabhauser] p. 44. (Contributed by Thierry Arnoux, 23-Feb-2020.)
theorem hltr (ph: wff) (A2 B2 C D P G I K: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wbr A2 B2 (cfv D K)) $ >
  $ wi ph (wbr B2 C (cfv D K)) $ >
  $ wi ph (wbr A2 C (cfv D K)) $;

--| Betweenness is a sufficient condition to swap half-lines. (Contributed by Thierry Arnoux, 21-Feb-2020.)
theorem hlbtwn (ph: wff) (A2 B2 C D P G I K: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel D (co C B2 I)) $ >
  $ wi ph (wne B2 C) $ >
  $ wi ph (wne D C) $ >
  $ wi ph (wb (wbr A2 B2 (cfv C K)) (wbr A2 D (cfv C K))) $;

--| Deduce half-line from betweenness. (Contributed by Thierry Arnoux, 4-Mar-2020.)
theorem btwnhl1 (ph: wff) (A2 B2 C D P G I K: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel C (co A2 B2 I)) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wne C A2) $ >
  $ wi ph (wbr C B2 (cfv A2 K)) $;

--| Deduce half-line from betweenness. (Contributed by Thierry Arnoux, 4-Mar-2020.)
theorem btwnhl2 (ph: wff) (A2 B2 C D P G I K: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel C (co A2 B2 I)) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wne C B2) $ >
  $ wi ph (wbr C A2 (cfv B2 K)) $;

--| Swap betweenness for a half-line. (Contributed by Thierry Arnoux, 2-Mar-2020.)
theorem btwnhl (ph: wff) (A2 B2 C D P G I K: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wbr A2 B2 (cfv D K)) $ >
  $ wi ph (wcel D (co A2 C I)) $ >
  $ wi ph (wcel D (co B2 C I)) $;

--| Either a point ` C ` on the line AB is on the same side as ` A ` or on the opposite side. (Contributed by Thierry Arnoux, 21-Sep-2020.)
theorem lnhl (ph: wff) (A2 B2 C D P G I K L: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D P) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel C (co A2 B2 L)) $ >
  $ wi ph (wo (wbr C A2 (cfv B2 K)) (wcel B2 (co A2 C I))) $;

--| Construct a point on a half-line, at a given distance of its origin. (Contributed by Thierry Arnoux, 1-Aug-2020.)
theorem hlcgrex {x3: setvar} (ph: wff) (A2 B2 C D P: class) (G: class x3) (I K c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D P) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wne D A2) $ >
  $ wi ph (wne B2 C) $ >
  $ wi ph (wrex x3 (wa (wbr (cv x3) D (cfv A2 K)) (wceq (co A2 (cv x3) c_mi) (co B2 C c_mi))) P) $;

--| Lemma for ~ hlcgreu . (Contributed by Thierry Arnoux, 9-Aug-2020.)
theorem hlcgreulem (ph: wff) (A2 B2 C D P G I K c_mi X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D P) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wne D A2) $ >
  $ wi ph (wne B2 C) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wbr X D (cfv A2 K)) $ >
  $ wi ph (wbr Y D (cfv A2 K)) $ >
  $ wi ph (wceq (co A2 X c_mi) (co B2 C c_mi)) $ >
  $ wi ph (wceq (co A2 Y c_mi) (co B2 C c_mi)) $ >
  $ wi ph (wceq X Y) $;

--| The point constructed in ~ hlcgrex is unique. Theorem 6.11 of [Schwabhauser] p. 44. (Contributed by Thierry Arnoux, 9-Aug-2020.)
theorem hlcgreu {x3: setvar} (ph: wff) (A2 B2 C D P: class) (G: class x3) (I K c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D P) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wne D A2) $ >
  $ wi ph (wne B2 C) $ >
  $ wi ph (wreu x3 (wa (wbr (cv x3) D (cfv A2 K)) (wceq (co A2 (cv x3) c_mi) (co B2 C c_mi))) P) $;

--| A constructed point on a half-line, at a given distance of its origin, (see ~ hlcgrex ) is unique. Theorem 6.11 of [Schwabhauser] p. 44. (Contributed by Thierry Arnoux, 9-Aug-2020.)
theorem hlcgreq (ph: wff) (A2 B2 C D P G K c_mi X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wne D A2) $ >
  $ wi ph (wne B2 C) $ >
  $ wi ph (wbr X D (cfv A2 K)) $ >
  $ wi ph (wbr Y D (cfv A2 K)) $ >
  $ wi ph (wceq (co A2 X c_mi) (co B2 C c_mi)) $ >
  $ wi ph (wceq (co A2 Y c_mi) (co B2 C c_mi)) $ >
  $ wi ph (wceq X Y) $;

--| Removing identical parts from the end of a ray segment preserves congruence. (Contributed by Thierry Arnoux, 23-Aug-2026.)
theorem tghlsub (ph: wff) (A2 B2 C D P E F G K c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wbr A2 C (cfv B2 K)) $ >
  $ wi ph (wbr D F (cfv E K)) $ >
  $ wi ph (wceq (co B2 C c_mi) (co E F c_mi)) $ >
  $ wi ph (wceq (co B2 A2 c_mi) (co E D c_mi)) $ >
  $ wi ph (wceq (co C A2 c_mi) (co F D c_mi)) $;

--| Betweenness implies colinearity. (Contributed by Thierry Arnoux, 28-Mar-2019.)
theorem btwnlng1 (ph: wff) (P G I L X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wne X Y) $ >
  $ wi ph (wcel Z (co X Y I)) $ >
  $ wi ph (wcel Z (co X Y L)) $;

--| Betweenness implies colinearity. (Contributed by Thierry Arnoux, 28-Mar-2019.)
theorem btwnlng2 (ph: wff) (P G I L X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wne X Y) $ >
  $ wi ph (wcel X (co Z Y I)) $ >
  $ wi ph (wcel Z (co X Y L)) $;

--| Betweenness implies colinearity. (Contributed by Thierry Arnoux, 28-Mar-2019.)
theorem btwnlng3 (ph: wff) (P G I L X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wne X Y) $ >
  $ wi ph (wcel Y (co X Z I)) $ >
  $ wi ph (wcel Z (co X Y L)) $;

--| Swapping the points defining a line keeps it unchanged. Part of Theorem 4.11 of [Schwabhauser] p. 34. (Contributed by Thierry Arnoux, 3-Apr-2019.)
theorem lncom (ph: wff) (P G I L X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wne X Y) $ >
  $ wi ph (wcel Z (co Y X L)) $ >
  $ wi ph (wcel Z (co X Y L)) $;

--| Rotating the points defining a line. Part of Theorem 4.11 of [Schwabhauser] p. 34. (Contributed by Thierry Arnoux, 3-Apr-2019.)
theorem lnrot1 (ph: wff) (P G I L X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wne X Y) $ >
  $ wi ph (wcel Y (co Z X L)) $ >
  $ wi ph (wne Z X) $ >
  $ wi ph (wcel Z (co X Y L)) $;

--| Rotating the points defining a line. Part of Theorem 4.11 of [Schwabhauser] p. 34. (Contributed by Thierry Arnoux, 3-Apr-2019.)
theorem lnrot2 (ph: wff) (P G I L X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wne X Y) $ >
  $ wi ph (wcel X (co Y Z L)) $ >
  $ wi ph (wne Y Z) $ >
  $ wi ph (wcel Z (co X Y L)) $;

--| Non-colinear points are different. (Contributed by Thierry Arnoux, 8-Aug-2019.)
theorem ncolne1 (ph: wff) (B2 G I L X Y Z: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wn (wo (wcel X (co Y Z L)) (wceq Y Z))) $ >
  $ wi ph (wne X Y) $;

--| Non-colinear points are different. (Contributed by Thierry Arnoux, 8-Aug-2019.) TODO (NM): maybe ~ ncolne2 could be simplified out and deleted, replaced by ~ ncolcom .
theorem ncolne2 (ph: wff) (B2 G I L X Y Z: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel Z B2) $ >
  $ wi ph (wn (wo (wcel X (co Y Z L)) (wceq Y Z))) $ >
  $ wi ph (wne X Z) $;

--| The property of being a proper line, generated by two distinct points. (Contributed by Thierry Arnoux, 25-May-2019.)
theorem tgisline {x3 y1: setvar} (ph: wff) (A2 B2 G I: class) (L: class x3 y1):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wrex x3 (wrex y1 (wa (wceq A2 (co (cv x3) (cv y1) L)) (wne (cv x3) (cv y1))) B2) B2) $;

--| It takes two different points to form a line. (Contributed by Thierry Arnoux, 27-Nov-2019.)
theorem tglnne (ph: wff) (B2 G I L X Y: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wcel (co X Y L) (crn L)) $ >
  $ wi ph (wne X Y) $;

--| There are no lines in dimension 0. (Contributed by Thierry Arnoux, 18-Oct-2019.)
theorem tglndim0 (ph: wff) (A2 B2 G I L: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wceq (cfv B2 chash) c1) $ >
  $ wi ph (wn (wcel A2 (crn L))) $;

--| The property of being a proper line, generated by two distinct points. (Contributed by Thierry Arnoux, 25-May-2019.)
theorem tgelrnln (ph: wff) (B2 G I L X Y: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wne X Y) $ >
  $ wi ph (wcel (co X Y L) (crn L)) $;

--| Transitivity law for lines, one half of ~ tglineelsb2 . (Contributed by Thierry Arnoux, 25-May-2019.)
theorem tglineeltr (ph: wff) (B2 P Q R S G I L: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel P B2) $ >
  $ wi ph (wcel Q B2) $ >
  $ wi ph (wne P Q) $ >
  $ wi ph (wcel S B2) $ >
  $ wi ph (wne S P) $ >
  $ wi ph (wcel S (co P Q L)) $ >
  $ wi ph (wcel R B2) $ >
  $ wi ph (wcel R (co P S L)) $ >
  $ wi ph (wcel R (co P Q L)) $;

--| If ` S ` lies on PQ , then PQ = PS . Theorem 6.16 of [Schwabhauser] p. 45. (Contributed by Thierry Arnoux, 17-May-2019.)
theorem tglineelsb2 (ph: wff) (B2 P Q S G I L: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel P B2) $ >
  $ wi ph (wcel Q B2) $ >
  $ wi ph (wne P Q) $ >
  $ wi ph (wcel S B2) $ >
  $ wi ph (wne S P) $ >
  $ wi ph (wcel S (co P Q L)) $ >
  $ wi ph (wceq (co P Q L) (co P S L)) $;

--| Reflexivity law for line membership. Part of theorem 6.17 of [Schwabhauser] p. 45. (Contributed by Thierry Arnoux, 17-May-2019.)
theorem tglinerflx1 (ph: wff) (B2 P Q G I L: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel P B2) $ >
  $ wi ph (wcel Q B2) $ >
  $ wi ph (wne P Q) $ >
  $ wi ph (wcel P (co P Q L)) $;

--| Reflexivity law for line membership. Part of theorem 6.17 of [Schwabhauser] p. 45. (Contributed by Thierry Arnoux, 17-May-2019.)
theorem tglinerflx2 (ph: wff) (B2 P Q G I L: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel P B2) $ >
  $ wi ph (wcel Q B2) $ >
  $ wi ph (wne P Q) $ >
  $ wi ph (wcel Q (co P Q L)) $;

--| Commutativity law for lines. Part of theorem 6.17 of [Schwabhauser] p. 45. (Contributed by Thierry Arnoux, 17-May-2019.)
theorem tglinecom (ph: wff) (B2 P Q G I L: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel P B2) $ >
  $ wi ph (wcel Q B2) $ >
  $ wi ph (wne P Q) $ >
  $ wi ph (wceq (co P Q L) (co Q P L)) $;

--| If ` A ` is a line containing two distinct points ` P ` and ` Q ` , then ` A ` is the line through ` P ` and ` Q ` . Theorem 6.18 of [Schwabhauser] p. 45. (Contributed by Thierry Arnoux, 25-May-2019.)
theorem tglinethru (ph: wff) (A2 B2 P Q G I L: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel P B2) $ >
  $ wi ph (wcel Q B2) $ >
  $ wi ph (wne P Q) $ >
  $ wi ph (wne P Q) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel P A2) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wceq A2 (co P Q L)) $;

--| There is a line through any two distinct points. Hilbert's axiom I.1 for geometry. (Contributed by Thierry Arnoux, 25-May-2019.)
theorem tghilberti1 {x3: setvar} (ph: wff) (B2 P Q G I L: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel P B2) $ >
  $ wi ph (wcel Q B2) $ >
  $ wi ph (wne P Q) $ >
  $ wi ph (wrex x3 (wa (wcel P (cv x3)) (wcel Q (cv x3))) (crn L)) $;

--| There is at most one line through any two distinct points. Hilbert's axiom I.2 for geometry. (Contributed by Thierry Arnoux, 25-May-2019.)
theorem tghilberti2 {x3: setvar} (ph: wff) (B2 P Q G I L: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel P B2) $ >
  $ wi ph (wcel Q B2) $ >
  $ wi ph (wne P Q) $ >
  $ wi ph (wrmo x3 (wa (wcel P (cv x3)) (wcel Q (cv x3))) (crn L)) $;

--| There is a unique line going through any two distinct points. Theorem 6.19 of [Schwabhauser] p. 46. (Contributed by Thierry Arnoux, 25-May-2019.)
theorem tglinethrueu {x3: setvar} (ph: wff) (B2 P Q G I L: class):
  $ wceq B2 (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel P B2) $ >
  $ wi ph (wcel Q B2) $ >
  $ wi ph (wne P Q) $ >
  $ wi ph (wreu x3 (wa (wcel P (cv x3)) (wcel Q (cv x3))) (crn L)) $;

--| If a line is a subset of another line, they are equal. (Contributed by Thierry Arnoux, 17-Jun-2026.)
theorem tglinesseq (ph: wff) (A2 B2 G L: class):
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel B2 (crn L)) $ >
  $ wi ph (wss A2 B2) $ >
  $ wi ph (wceq A2 B2) $;

--| A line ` A ` has at least one point. (Contributed by Thierry Arnoux, 4-Mar-2020.)
theorem tglnne0 (ph: wff) (A2 G L: class):
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wne A2 c0) $;

--| Two distinct lines intersect in at most one point. Theorem 6.21 of [Schwabhauser] p. 46. (Contributed by Thierry Arnoux, 25-May-2019.)
theorem tglineintmo {x3: setvar} (ph: wff) (A2 B2: class) (P G I L: class x3):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel B2 (crn L)) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wmo x3 (wa (wcel (cv x3) A2) (wcel (cv x3) B2))) $;

--| Two distinct lines intersect in at most one point, variation. Theorem 6.21 of [Schwabhauser] p. 46. (Contributed by Thierry Arnoux, 6-Aug-2019.)
theorem tglineineq (ph: wff) (A2 B2 P G I L X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel B2 (crn L)) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wcel X (cin A2 B2)) $ >
  $ wi ph (wcel Y (cin A2 B2)) $ >
  $ wi ph (wceq X Y) $;

--| If two distinct lines intersect, it is at a single point. Theorem 6.21 of [Schwabhauser] p. 46. (Contributed by Thierry Arnoux, 17-Jun-2026.)
theorem tglineinsn (ph: wff) (A2 B2 P G I L X: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel B2 (crn L)) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wcel X (cin A2 B2)) $ >
  $ wi ph (wceq (cin A2 B2) (csn X)) $;

--| Given three non-colinear points, build two different lines. (Contributed by Thierry Arnoux, 6-Aug-2019.)
theorem tglineneq (ph: wff) (A2 B2 C D P G I L: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wn (wo (wcel A2 (co B2 C L)) (wceq B2 C))) $ >
  $ wi ph (wne (co A2 B2 L) (co C D L)) $;

--| Two distinct lines intersect in at most one point. Theorem 6.21 of [Schwabhauser] p. 46. (Contributed by Thierry Arnoux, 6-Aug-2019.)
theorem tglineinteq (ph: wff) (A2 B2 C D P G I L X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wn (wo (wcel A2 (co B2 C L)) (wceq B2 C))) $ >
  $ wi ph (wcel X (co A2 B2 L)) $ >
  $ wi ph (wcel Y (co A2 B2 L)) $ >
  $ wi ph (wcel X (co C D L)) $ >
  $ wi ph (wcel Y (co C D L)) $ >
  $ wi ph (wceq X Y) $;

--| Deduce non-colinearity from non-colinearity and colinearity. (Contributed by Thierry Arnoux, 27-Aug-2019.)
theorem ncolncol (ph: wff) (A2 B2 C D P G I L: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wn (wo (wcel A2 (co B2 C L)) (wceq B2 C))) $ >
  $ wi ph (wcel D (co A2 B2 L)) $ >
  $ wi ph (wne D B2) $ >
  $ wi ph (wn (wo (wcel D (co B2 C L)) (wceq B2 C))) $;

--| A transitivity law for colinearity. (Contributed by Thierry Arnoux, 27-Nov-2019.)
theorem coltr (ph: wff) (A2 B2 C D P G I L: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel A2 (co B2 C L)) $ >
  $ wi ph (wo (wcel B2 (co C D L)) (wceq C D)) $ >
  $ wi ph (wo (wcel A2 (co C D L)) (wceq C D)) $;

--| A transitivity law for colinearity. (Contributed by Thierry Arnoux, 27-Nov-2019.)
theorem coltr3 (ph: wff) (A2 B2 C D P G I L: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel A2 (co B2 C L)) $ >
  $ wi ph (wcel D (co A2 C I)) $ >
  $ wi ph (wcel D (co B2 C L)) $;

--| Three points are colinear iff there is a line through all three of them. Theorem 6.23 of [Schwabhauser] p. 46. (Contributed by Thierry Arnoux, 28-May-2019.)
theorem colline {a: setvar} (ph: wff) (P G I: class a) (L X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wbr c2 (cfv P chash) cle) $ >
  $ wi ph (wb (wo (wcel X (co Y Z L)) (wceq Y Z)) (wrex a (w3a (wcel X (cv a)) (wcel Y (cv a)) (wcel Z (cv a))) (crn L))) $;

--| Reformulation of the lower dimension axiom for dimension two. There exist three non-colinear points. Theorem 6.24 of [Schwabhauser] p. 46. (Contributed by Thierry Arnoux, 30-May-2019.)
theorem tglowdim2l {a b c: setvar} (ph: wff) (P G I: class) (L: class a b c):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wi ph (wrex a (wrex b (wrex c (wn (wo (wcel (cv c) (co (cv a) (cv b) L)) (wceq (cv a) (cv b)))) P) P) P) $;

--| There is always one point outside of any line. Theorem 6.25 of [Schwabhauser] p. 46. (Contributed by Thierry Arnoux, 16-Nov-2019.)
theorem tglowdim2ln {c: setvar} (ph: wff) (A2 B2 P G I L: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wrex c (wn (wcel (cv c) (co A2 B2 L))) P) $;

--| Find a second point on a line. (Contributed by Thierry Arnoux, 18-Oct-2019.)
theorem tglnpt2 {y1: setvar} (ph: wff y1) (A2: class) (P G I L: class y1) (X: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wrex y1 (wne X (cv y1)) A2) $;

--| Find a third point on a line. (Contributed by Thierry Arnoux, 17-Jun-2026.)
theorem tglnpt3 {z: setvar} (ph: wff) (A2 P G I: class) (L: class z) (X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y A2) $ >
  $ wi ph (wne X Y) $ >
  $ wi ph (wrex z (wa (wne (cv z) X) (wne (cv z) Y)) A2) $;

--| Find a second point on a line, outside of a second line. (Contributed by Thierry Arnoux, 17-Jun-2026.)
theorem tglnpt4 {z: setvar} (ph: wff) (A2 B2 P G I: class) (L: class z) (X: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel B2 (crn L)) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wrex z (wne (cv z) X) (cdif A2 B2)) $;

--| Declare the constant for the point inversion function.
term cmir: class;

--| Define the point inversion ("mirror") function. Definition 7.5 of [Schwabhauser] p. 49. See ~ mirval and ~ ismir . (Contributed by Thierry Arnoux, 30-May-2019.)
axiom df_mir {g2 m a b: setvar}:
  $ wceq cmir (cmpt g2 cvv (cmpt m (cfv (cv g2) cbs) (cmpt a (cfv (cv g2) cbs) (crio b (wa (wceq (co (cv m) (cv b) (cfv (cv g2) cds)) (co (cv m) (cv a) (cfv (cv g2) cds))) (wcel (cv m) (co (cv b) (cv a) (cfv (cv g2) citv)))) (cfv (cv g2) cbs))))) $;

--| Existential uniqueness of the mirror point. Theorem 7.8 of [Schwabhauser] p. 49. (Contributed by Thierry Arnoux, 30-May-2019.)
theorem mirreu3 {b: setvar} (ph: wff) (A2 P: class) (G: class b) (I M c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel M P) $ >
  $ wi ph (wreu b (wa (wceq (co M (cv b) c_mi) (co M A2 c_mi)) (wcel M (co (cv b) A2 I))) P) $;

--| Value of the point inversion function ` S ` . Definition 7.5 of [Schwabhauser] p. 49. (Contributed by Thierry Arnoux, 30-May-2019.)
theorem mirval {y1 z: setvar} (ph: wff) (A2 P: class) (S: class y1 z) (G I: class) (L: class y1 z) (c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wceq (cfv A2 S) (cmpt y1 P (crio z (wa (wceq (co A2 (cv z) c_mi) (co A2 (cv y1) c_mi)) (wcel A2 (co (cv z) (cv y1) I))) P))) $;

--| Value of the point inversion function ` M ` . Definition 7.5 of [Schwabhauser] p. 49. (Contributed by Thierry Arnoux, 30-May-2019.)
theorem mirfv {z: setvar} (ph: wff) (A2 B2 P: class) (S: class z) (G I: class) (L: class z) (M c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wceq M (cfv A2 S) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wceq (cfv B2 M) (crio z (wa (wceq (co A2 (cv z) c_mi) (co A2 B2 c_mi)) (wcel A2 (co (cv z) B2 I))) P)) $;

--| Property of the image by the point inversion function. Definition 7.5 of [Schwabhauser] p. 49. (Contributed by Thierry Arnoux, 3-Jun-2019.)
theorem mircgr (ph: wff) (A2 B2 P S G I L M c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wceq M (cfv A2 S) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wceq (co A2 (cfv B2 M) c_mi) (co A2 B2 c_mi)) $;

--| Property of the image by the point inversion function. Definition 7.5 of [Schwabhauser] p. 49. (Contributed by Thierry Arnoux, 3-Jun-2019.)
theorem mirbtwn (ph: wff) (A2 B2 P S G I L M c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wceq M (cfv A2 S) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel A2 (co (cfv B2 M) B2 I)) $;

--| Property of the image by the point inversion function. Definition 7.5 of [Schwabhauser] p. 49. (Contributed by Thierry Arnoux, 3-Jun-2019.)
theorem ismir (ph: wff) (A2 B2 C P S G I L M c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wceq M (cfv A2 S) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wceq (co A2 C c_mi) (co A2 B2 c_mi)) $ >
  $ wi ph (wcel A2 (co C B2 I)) $ >
  $ wi ph (wceq C (cfv B2 M)) $;

--| Point inversion as function. (Contributed by Thierry Arnoux, 30-May-2019.)
theorem mirf (ph: wff) (A2 P S G I L M c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wceq M (cfv A2 S) $ >
  $ wi ph (wf P P M) $;

--| Closure of the point inversion function. (Contributed by Thierry Arnoux, 20-Oct-2019.)
theorem mircl (ph: wff) (A2 P S G I L M c_mi X: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wceq M (cfv A2 S) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel (cfv X M) P) $;

--| The point inversion function is an involution. Theorem 7.7 of [Schwabhauser] p. 49. (Contributed by Thierry Arnoux, 3-Jun-2019.)
theorem mirmir (ph: wff) (A2 B2 P S G I L M c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wceq M (cfv A2 S) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wceq (cfv (cfv B2 M) M) B2) $;

--| Variation on ~ mirmir . (Contributed by Thierry Arnoux, 10-Nov-2019.)
theorem mircom (ph: wff) (A2 B2 C P S G I L M c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wceq M (cfv A2 S) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wceq (cfv B2 M) C) $ >
  $ wi ph (wceq (cfv C M) B2) $;

--| Any point has a unique antecedent through point inversion. Theorem 7.8 of [Schwabhauser] p. 50. (Contributed by Thierry Arnoux, 3-Jun-2019.)
theorem mirreu {a: setvar} (ph: wff) (A2: class a) (B2 P: class) (S G I L: class a) (M: class) (c_mi: class a):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wceq M (cfv A2 S) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wreu a (wceq (cfv (cv a) M) B2) P) $;

--| Equality deduction for point inversion. Theorem 7.9 of [Schwabhauser] p. 50. (Contributed by Thierry Arnoux, 30-May-2019.)
theorem mireq (ph: wff) (A2 B2 C P S G I L M c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wceq M (cfv A2 S) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wceq (cfv B2 M) (cfv C M)) $ >
  $ wi ph (wceq B2 C) $;

--| The only invariant point of a point inversion Theorem 7.3 of [Schwabhauser] p. 49, Theorem 7.10 of [Schwabhauser] p. 50. (Contributed by Thierry Arnoux, 30-Jul-2019.)
theorem mirinv (ph: wff) (A2 B2 P S G I L M c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wceq M (cfv A2 S) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wb (wceq (cfv B2 M) B2) (wceq A2 B2)) $;

--| Mirror of non-center point cannot be the center point. (Contributed by Thierry Arnoux, 27-Sep-2020.)
theorem mirne (ph: wff) (A2 B2 P S G I L M c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wceq M (cfv A2 S) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wne B2 A2) $ >
  $ wi ph (wne (cfv B2 M) A2) $;

--| The center point is invariant of a point inversion. (Contributed by Thierry Arnoux, 25-Aug-2019.)
theorem mircinv (ph: wff) (A2 P S G I L M c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wceq M (cfv A2 S) $ >
  $ wi ph (wceq (cfv A2 M) A2) $;

--| The point inversion function ` M ` is a bijection. Theorem 7.11 of [Schwabhauser] p. 50. (Contributed by Thierry Arnoux, 6-Jun-2019.)
theorem mirf1o (ph: wff) (A2 P S G I L M c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wceq M (cfv A2 S) $ >
  $ wi ph (wf1o P P M) $;

--| The point inversion function is an isometry, i.e., it preserves congruence. Because it is also a bijection, it is also a motion. Theorem 7.13 of [Schwabhauser] p. 50. (Contributed by Thierry Arnoux, 6-Jun-2019.)
theorem miriso (ph: wff) (A2 P S G I L M c_mi X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wceq M (cfv A2 S) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wceq (co (cfv X M) (cfv Y M) c_mi) (co X Y c_mi)) $;

--| Point inversion preserves betweenness, first half of Theorem 7.15 of [Schwabhauser] p. 51. (Contributed by Thierry Arnoux, 9-Jun-2019.)
theorem mirbtwni (ph: wff) (A2 P S G I L M c_mi X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wceq M (cfv A2 S) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel Y (co X Z I)) $ >
  $ wi ph (wcel (cfv Y M) (co (cfv X M) (cfv Z M) I)) $;

--| Point inversion preserves betweenness. Theorem 7.15 of [Schwabhauser] p. 51. (Contributed by Thierry Arnoux, 9-Jun-2019.)
theorem mirbtwnb (ph: wff) (A2 P S G I L M c_mi X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wceq M (cfv A2 S) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wb (wcel Y (co X Z I)) (wcel (cfv Y M) (co (cfv X M) (cfv Z M) I))) $;

--| Point inversion preserves congruence. Theorem 7.16 of [Schwabhauser] p. 51. (Contributed by Thierry Arnoux, 30-Jul-2019.)
theorem mircgrs (ph: wff) (A2 P S T G I L M c_mi X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wceq M (cfv A2 S) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel T P) $ >
  $ wi ph (wceq (co X Y c_mi) (co Z T c_mi)) $ >
  $ wi ph (wceq (co (cfv X M) (cfv Y M) c_mi) (co (cfv Z M) (cfv T M) c_mi)) $;

--| Point inversion of a point inversion through another point. (Contributed by Thierry Arnoux, 3-Nov-2019.)
theorem mirmir2 (ph: wff) (A2 P S G I L M c_mi X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wceq M (cfv A2 S) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wceq (cfv (cfv X (cfv Y S)) M) (cfv (cfv X M) (cfv (cfv Y M) S))) $;

--| Point investion is a motion of the geometric space. Theorem 7.14 of [Schwabhauser] p. 51. (Contributed by Thierry Arnoux, 15-Dec-2019.)
theorem mirmot (ph: wff) (A2 P S G I L M c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq M (cfv A2 S) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel M (co G G cismt)) $;

--| If two points are on the same line, so is the mirror point of one through the other. (Contributed by Thierry Arnoux, 21-Dec-2019.)
theorem mirln (ph: wff) (A2 B2 D P S G I L M c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq M (cfv A2 S) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel A2 D) $ >
  $ wi ph (wcel B2 D) $ >
  $ wi ph (wcel (cfv B2 M) D) $;

--| If a point and its mirror point are both on the same line, so is the center of the point inversion. (Contributed by Thierry Arnoux, 3-Mar-2020.)
theorem mirln2 (ph: wff) (A2 B2 D P S G I L M c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq M (cfv A2 S) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 D) $ >
  $ wi ph (wcel (cfv B2 M) D) $ >
  $ wi ph (wcel A2 D) $;

--| Point inversion of connectedness. (Contributed by Thierry Arnoux, 2-Mar-2020.)
theorem mirconn (ph: wff) (A2 P S G I L M c_mi X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq M (cfv A2 S) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wo (wcel X (co A2 Y I)) (wcel Y (co A2 X I))) $ >
  $ wi ph (wcel A2 (co X (cfv Y M) I)) $;

--| If two points ` X ` and ` Y ` are on the same half-line from ` Z ` , the same applies to the mirror points. (Contributed by Thierry Arnoux, 21-Feb-2020.)
theorem mirhl (ph: wff) (A2 P S G I K L M c_mi X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq M (cfv A2 S) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wbr X Y (cfv Z K)) $ >
  $ wi ph (wbr (cfv X M) (cfv Y M) (cfv (cfv Z M) K)) $;

--| If the center of the point inversion ` A ` is between two points ` X ` and ` Y ` , then the half lines are mirrored. (Contributed by Thierry Arnoux, 3-Mar-2020.)
theorem mirbtwnhl (ph: wff) (A2 P S G I K L M c_mi X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq M (cfv A2 S) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wne X A2) $ >
  $ wi ph (wne Y A2) $ >
  $ wi ph (wcel A2 (co X Y I)) $ >
  $ wi ph (wb (wbr Z X (cfv A2 K)) (wbr (cfv Z M) Y (cfv A2 K))) $;

--| Deduce half-line relation from mirror point. (Contributed by Thierry Arnoux, 8-Aug-2020.)
theorem mirhl2 (ph: wff) (A2 P S G I K L M c_mi X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq M (cfv A2 S) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wne X A2) $ >
  $ wi ph (wne Y A2) $ >
  $ wi ph (wcel A2 (co X (cfv Y M) I)) $ >
  $ wi ph (wbr X Y (cfv A2 K)) $;

--| Link congruence over a pair of mirror points. cf ~ tgcgrextend . (Contributed by Thierry Arnoux, 4-Oct-2020.)
theorem mircgrextend (ph: wff) (A2 B2 P c_sm S G I L M c_mi N X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq c_sm (cfv G ccgrg) $ >
  $ wceq M (cfv B2 S) $ >
  $ wceq N (cfv Y S) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co X Y c_mi)) $ >
  $ wi ph (wceq (co A2 (cfv A2 M) c_mi) (co X (cfv X N) c_mi)) $;

--| Point inversion of one point of a triangle around another point preserves triangle congruence. (Contributed by Thierry Arnoux, 4-Oct-2020.)
theorem mirtrcgr (ph: wff) (A2 B2 C P c_sm S G I L M c_mi N X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq c_sm (cfv G ccgrg) $ >
  $ wceq M (cfv B2 S) $ >
  $ wceq N (cfv Y S) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 X Y Z) c_sm) $ >
  $ wi ph (wbr (cs3 (cfv A2 M) B2 C) (cs3 (cfv X N) Y Z) c_sm) $;

--| Point inversion preserves point inversion. (Contributed by Thierry Arnoux, 30-Jul-2019.)
theorem mirauto (ph: wff) (A2 B2 C P S T G I L M c_mi X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq M (cfv T S) $ >
  $ wceq X (cfv A2 M) $ >
  $ wceq Y (cfv B2 M) $ >
  $ wceq Z (cfv C M) $ >
  $ wi ph (wcel T P) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wceq (cfv B2 (cfv A2 S)) C) $ >
  $ wi ph (wceq (cfv Y (cfv X S)) Z) $;

--| Uniqueness of the middle point, expressed with point inversion. Theorem 7.17 of [Schwabhauser] p. 51. (Contributed by Thierry Arnoux, 30-Jul-2019.)
theorem miduniq (ph: wff) (A2 B2 P S G I L c_mi X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wceq (cfv X (cfv A2 S)) Y) $ >
  $ wi ph (wceq (cfv X (cfv B2 S)) Y) $ >
  $ wi ph (wceq A2 B2) $;

--| Uniqueness of the middle point, expressed with point inversion. Theorem 7.18 of [Schwabhauser] p. 52. (Contributed by Thierry Arnoux, 30-Jul-2019.)
theorem miduniq1 (ph: wff) (A2 B2 P S G I L c_mi X: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wceq (cfv X (cfv A2 S)) (cfv X (cfv B2 S))) $ >
  $ wi ph (wceq A2 B2) $;

--| If two point inversions commute, they are identical. Theorem 7.19 of [Schwabhauser] p. 52. (Contributed by Thierry Arnoux, 30-Jul-2019.)
theorem miduniq2 (ph: wff) (A2 B2 P S G I L c_mi X: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wceq (cfv (cfv X (cfv B2 S)) (cfv A2 S)) (cfv (cfv X (cfv A2 S)) (cfv B2 S))) $ >
  $ wi ph (wceq A2 B2) $;

--| Colinearity and equidistance implies midpoint. Theorem 7.20 of [Schwabhauser] p. 52. (Contributed by Thierry Arnoux, 30-Jul-2019.)
theorem colmid (ph: wff) (A2 B2 P S G I L M c_mi X: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq M (cfv X S) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wo (wcel X (co A2 B2 L)) (wceq A2 B2)) $ >
  $ wi ph (wceq (co X A2 c_mi) (co X B2 c_mi)) $ >
  $ wi ph (wo (wceq B2 (cfv A2 M)) (wceq A2 B2)) $;

--| Lemma of the symmetrical quadrilateral. The diagonals of quadrilaterals with congruent opposing sides intersect at their middle point. In Euclidean geometry, such quadrilaterals are called parallelograms, as opposing sides are parallel. However, this is not necessarily true in the case of absolute geometry. Lemma 7.21 of [Schwabhauser] p. 52. (Contributed by Thierry Arnoux, 6-Aug-2019.)
theorem symquadlem (ph: wff) (A2 B2 C D P S G I L M c_mi X: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq M (cfv X S) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wn (wo (wcel A2 (co B2 C L)) (wceq B2 C))) $ >
  $ wi ph (wne B2 D) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co C D c_mi)) $ >
  $ wi ph (wceq (co B2 C c_mi) (co D A2 c_mi)) $ >
  $ wi ph (wo (wcel X (co A2 C L)) (wceq A2 C)) $ >
  $ wi ph (wo (wcel X (co B2 D L)) (wceq B2 D)) $ >
  $ wi ph (wceq A2 (cfv C M)) $;

--| Lemma for ~ krippen . We can assume krippen.7 "without loss of generality". (Contributed by Thierry Arnoux, 12-Aug-2019.)
theorem krippenlem (ph: wff) (A2 B2 C P S E F G I L c_le M c_mi N X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq M (cfv X S) $ >
  $ wceq N (cfv Y S) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel C (co A2 E I)) $ >
  $ wi ph (wcel C (co B2 F I)) $ >
  $ wi ph (wceq (co C A2 c_mi) (co C B2 c_mi)) $ >
  $ wi ph (wceq (co C E c_mi) (co C F c_mi)) $ >
  $ wi ph (wceq B2 (cfv A2 M)) $ >
  $ wi ph (wceq F (cfv E N)) $ >
  $ wceq c_le (cfv G cleg) $ >
  $ wi ph (wbr (co C A2 c_mi) (co C E c_mi) c_le) $ >
  $ wi ph (wcel C (co X Y I)) $;

--| Krippenlemma (German for crib's lemma) Lemma 7.22 of [Schwabhauser] p. 53. proven by Gupta 1965 as Theorem 3.45. (Contributed by Thierry Arnoux, 12-Aug-2019.)
theorem krippen (ph: wff) (A2 B2 C P S E F G I L M c_mi N X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq M (cfv X S) $ >
  $ wceq N (cfv Y S) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel C (co A2 E I)) $ >
  $ wi ph (wcel C (co B2 F I)) $ >
  $ wi ph (wceq (co C A2 c_mi) (co C B2 c_mi)) $ >
  $ wi ph (wceq (co C E c_mi) (co C F c_mi)) $ >
  $ wi ph (wceq B2 (cfv A2 M)) $ >
  $ wi ph (wceq F (cfv E N)) $ >
  $ wi ph (wcel C (co X Y I)) $;

--| Lemma for the existence of a middle point. Lemma 7.25 of [Schwabhauser] p. 55. This proof of the existence of a midpoint requires the existence of a third point ` C ` equidistant to ` A ` and ` B ` This condition will be removed later. Because the operation notation ` ( A ( midG `` G ) B ) ` for a midpoint implies its uniqueness, it cannot be used until uniqueness is proven, and until then, an equivalent mirror point notation ` B = ( M `` A ) ` has to be used. See ~ mideu for the existence and uniqueness of the midpoint. (Contributed by Thierry Arnoux, 25-Aug-2019.)
theorem midexlem {x3: setvar} (ph: wff) (A2 B2 C P S: class) (G: class x3) (I L: class) (M: class x3) (c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq M (cfv (cv x3) S) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wceq (co C A2 c_mi) (co C B2 c_mi)) $ >
  $ wi ph (wrex x3 (wceq B2 (cfv A2 M)) P) $;

--| Lemma for ~ symquadprlnglem . (Contributed by Thierry Arnoux, 20-Jul-2026.)
theorem symquadprlnglem (ph: wff) (P T G L c_mi W X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wceq (co X Y c_mi) (co Z W c_mi)) $ >
  $ wi ph (wceq (co Y Z c_mi) (co W X c_mi)) $ >
  $ wi ph (wn (wo (wcel X (co Y Z L)) (wceq Y Z))) $ >
  $ wi ph (wne Y W) $ >
  $ wi ph (wcel T (co X Z L)) $ >
  $ wi ph (wcel T (co Y W L)) $ >
  $ wi ph (wn (wo (wcel W (co Z Y L)) (wceq Z Y))) $;

--| Equality theorem for point mirroring. (Contributed by Thierry Arnoux, 13-Jul-2026.)
theorem mirleqb (ph: wff) (A2 P S G M X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq S (cfv G cmir) $ >
  $ wceq M (cfv A2 S) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wb (wceq X Y) (wceq (cfv X M) (cfv Y M))) $;

--| The mirror of a point ` X ` on a line ` ( Y L Z ) ` is on the mirrored line ` ( ( M `` Y ) L ( M `` Z ) ) ` . (Contributed by Thierry Arnoux, 13-Jul-2026.)
theorem mirlni (ph: wff) (A2 P S G L M X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wceq M (cfv A2 S) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wne Z Y) $ >
  $ wi ph (wcel X (co Y Z L)) $ >
  $ wi ph (wcel (cfv X M) (co (cfv Y M) (cfv Z M) L)) $;

--| Declare the constant for the class of right angles.
term crag: class;

--| Define the class of right angles. Definition 8.1 of [Schwabhauser] p. 57. See ~ israg . (Contributed by Thierry Arnoux, 25-Aug-2019.)
axiom df_rag {w g2: setvar}:
  $ wceq crag (cmpt g2 cvv (crab w (wa (wceq (cfv (cv w) chash) c3) (wceq (co (cfv cc0 (cv w)) (cfv c2 (cv w)) (cfv (cv g2) cds)) (co (cfv cc0 (cv w)) (cfv (cfv c2 (cv w)) (cfv (cfv c1 (cv w)) (cfv (cv g2) cmir))) (cfv (cv g2) cds)))) (cword (cfv (cv g2) cbs)))) $;

--| Declare the constant for the perpendicular relation.
term cperpg: class;

--| Define the "perpendicular" relation. Definition 8.11 of [Schwabhauser] p. 59. See ~ isperp . (Contributed by Thierry Arnoux, 8-Sep-2019.)
axiom df_perpg {x3 v u g2 a b: setvar}:
  $ wceq cperpg (cmpt g2 cvv (copab a b (wa (wa (wcel (cv a) (crn (cfv (cv g2) clng))) (wcel (cv b) (crn (cfv (cv g2) clng)))) (wrex x3 (wral u (wral v (wcel (cs3 (cv u) (cv x3) (cv v)) (cfv (cv g2) crag)) (cv b)) (cv a)) (cin (cv a) (cv b)))))) $;

--| Property for 3 points A, B, C to form a right angle. Definition 8.1 of [Schwabhauser] p. 57. (Contributed by Thierry Arnoux, 25-Aug-2019.)
theorem israg (ph: wff) (A2 B2 C P S G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wb (wcel (cs3 A2 B2 C) (cfv G crag)) (wceq (co A2 C c_mi) (co A2 (cfv C (cfv B2 S)) c_mi))) $;

--| Commutative rule for right angles. Theorem 8.2 of [Schwabhauser] p. 57. (Contributed by Thierry Arnoux, 25-Aug-2019.)
theorem ragcom (ph: wff) (A2 B2 C P S G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel (cs3 A2 B2 C) (cfv G crag)) $ >
  $ wi ph (wcel (cs3 C B2 A2) (cfv G crag)) $;

--| The right angle property is independent of the choice of point on one side. Theorem 8.3 of [Schwabhauser] p. 58. (Contributed by Thierry Arnoux, 25-Aug-2019.)
theorem ragcol (ph: wff) (A2 B2 C D P S G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel (cs3 A2 B2 C) (cfv G crag)) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wo (wcel A2 (co B2 D L)) (wceq B2 D)) $ >
  $ wi ph (wcel (cs3 D B2 C) (cfv G crag)) $;

--| Right angle property is preserved by point inversion. Theorem 8.4 of [Schwabhauser] p. 58. (Contributed by Thierry Arnoux, 25-Aug-2019.)
theorem ragmir (ph: wff) (A2 B2 C P S G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel (cs3 A2 B2 C) (cfv G crag)) $ >
  $ wi ph (wcel (cs3 A2 B2 (cfv C (cfv B2 S))) (cfv G crag)) $;

--| Right angle is conserved by point inversion. (Contributed by Thierry Arnoux, 3-Nov-2019.)
theorem mirrag (ph: wff) (A2 B2 C D P S G I L M c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel (cs3 A2 B2 C) (cfv G crag)) $ >
  $ wceq M (cfv D S) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel (cs3 (cfv A2 M) (cfv B2 M) (cfv C M)) (cfv G crag)) $;

--| Trivial right angle. Theorem 8.5 of [Schwabhauser] p. 58. (Contributed by Thierry Arnoux, 25-Aug-2019.)
theorem ragtrivb (ph: wff) (A2 B2 C P S G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel (cs3 A2 B2 B2) (cfv G crag)) $;

--| Deduce equality from two right angles. Theorem 8.6 of [Schwabhauser] p. 58. (Contributed by Thierry Arnoux, 3-Sep-2019.)
theorem ragflat2 (ph: wff) (A2 B2 C D P S G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel (cs3 A2 B2 C) (cfv G crag)) $ >
  $ wi ph (wcel (cs3 D B2 C) (cfv G crag)) $ >
  $ wi ph (wcel C (co A2 D I)) $ >
  $ wi ph (wceq B2 C) $;

--| Deduce equality from two right angles. Theorem 8.7 of [Schwabhauser] p. 58. (Contributed by Thierry Arnoux, 3-Sep-2019.)
theorem ragflat (ph: wff) (A2 B2 C P S G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel (cs3 A2 B2 C) (cfv G crag)) $ >
  $ wi ph (wcel (cs3 A2 C B2) (cfv G crag)) $ >
  $ wi ph (wceq B2 C) $;

--| Trivial right angle. Theorem 8.8 of [Schwabhauser] p. 58. (Contributed by Thierry Arnoux, 3-Sep-2019.)
theorem ragtriva (ph: wff) (A2 B2 C P S G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel (cs3 A2 B2 A2) (cfv G crag)) $ >
  $ wi ph (wceq A2 B2) $;

--| Right angle and colinearity. Theorem 8.9 of [Schwabhauser] p. 58. (Contributed by Thierry Arnoux, 4-Sep-2019.)
theorem ragflat3 (ph: wff) (A2 B2 C P S G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel (cs3 A2 B2 C) (cfv G crag)) $ >
  $ wi ph (wo (wcel C (co A2 B2 L)) (wceq A2 B2)) $ >
  $ wi ph (wo (wceq A2 B2) (wceq C B2)) $;

--| Right angle and colinearity. Theorem 8.10 of [Schwabhauser] p. 58. (Contributed by Thierry Arnoux, 4-Sep-2019.)
theorem ragcgr (ph: wff) (A2 B2 C D P c_sm S E F G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wceq c_sm (cfv G ccgrg) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel (cs3 A2 B2 C) (cfv G crag)) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) c_sm) $ >
  $ wi ph (wcel (cs3 D E F) (cfv G crag)) $;

--| Right angles are preserved by motions. (Contributed by Thierry Arnoux, 16-Dec-2019.)
theorem motrag (ph: wff) (A2 B2 C P S F G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel F (co G G cismt)) $ >
  $ wi ph (wcel (cs3 A2 B2 C) (cfv G crag)) $ >
  $ wi ph (wcel (cs3 (cfv A2 F) (cfv B2 F) (cfv C F)) (cfv G crag)) $;

--| Right angle implies non-colinearity. A consequence of theorem 8.9 of [Schwabhauser] p. 58. (Contributed by Thierry Arnoux, 1-Dec-2019.)
theorem ragncol (ph: wff) (A2 B2 C P S G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel (cs3 A2 B2 C) (cfv G crag)) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wne C B2) $ >
  $ wi ph (wn (wo (wcel C (co A2 B2 L)) (wceq A2 B2))) $;

--| Derive a line from perpendicularity. (Contributed by Thierry Arnoux, 27-Nov-2019.)
theorem perpln1 (ph: wff) (A2 B2 G L: class):
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr A2 B2 (cfv G cperpg)) $ >
  $ wi ph (wcel A2 (crn L)) $;

--| Derive a line from perpendicularity. (Contributed by Thierry Arnoux, 27-Nov-2019.)
theorem perpln2 (ph: wff) (A2 B2 G L: class):
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr A2 B2 (cfv G cperpg)) $ >
  $ wi ph (wcel B2 (crn L)) $;

--| Property for 2 lines A, B to be perpendicular. Item (ii) of definition 8.11 of [Schwabhauser] p. 59. (Contributed by Thierry Arnoux, 16-Oct-2019.)
theorem isperp {x3 v u: setvar} (ph: wff) (A2 B2: class) (P: class x3 v u) (G: class) (I L c_mi: class x3 v u):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel B2 (crn L)) $ >
  $ wi ph (wb (wbr A2 B2 (cfv G cperpg)) (wrex x3 (wral u (wral v (wcel (cs3 (cv u) (cv x3) (cv v)) (cfv G crag)) B2) A2) (cin A2 B2))) $;

--| The "perpendicular" relation is symmetric. Theorem 8.12 of [Schwabhauser] p. 59. (Contributed by Thierry Arnoux, 16-Oct-2019.)
theorem perpcom (ph: wff) (A2 B2 P G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel B2 (crn L)) $ >
  $ wi ph (wbr A2 B2 (cfv G cperpg)) $ >
  $ wi ph (wbr B2 A2 (cfv G cperpg)) $;

--| Two perpendicular lines are different. Theorem 8.14 of [Schwabhauser] p. 59. (Contributed by Thierry Arnoux, 18-Oct-2019.)
theorem perpneq (ph: wff) (A2 B2 P G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel B2 (crn L)) $ >
  $ wi ph (wbr A2 B2 (cfv G cperpg)) $ >
  $ wi ph (wne A2 B2) $;

--| Property for 2 lines A, B, intersecting at a point X to be perpendicular. Item (i) of definition 8.13 of [Schwabhauser] p. 59. (Contributed by Thierry Arnoux, 16-Oct-2019.)
theorem isperp2 {v u: setvar} (ph: wff) (A2 B2: class) (P: class v u) (G: class) (I L c_mi: class v u) (X: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel B2 (crn L)) $ >
  $ wi ph (wcel X (cin A2 B2)) $ >
  $ wi ph (wb (wbr A2 B2 (cfv G cperpg)) (wral u (wral v (wcel (cs3 (cv u) X (cv v)) (cfv G crag)) B2) A2)) $;

--| One direction of ~ isperp2 . (Contributed by Thierry Arnoux, 10-Nov-2019.)
theorem isperp2d (ph: wff) (A2 B2 P U G I L c_mi V X: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel B2 (crn L)) $ >
  $ wi ph (wcel X (cin A2 B2)) $ >
  $ wi ph (wcel U A2) $ >
  $ wi ph (wcel V B2) $ >
  $ wi ph (wbr A2 B2 (cfv G cperpg)) $ >
  $ wi ph (wcel (cs3 U X V) (cfv G crag)) $;

--| Deduce that two lines are perpendicular from a right angle statement. One direction of theorem 8.13 of [Schwabhauser] p. 59. (Contributed by Thierry Arnoux, 20-Oct-2019.)
theorem ragperp (ph: wff) (A2 B2 P U G I L c_mi V X: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel B2 (crn L)) $ >
  $ wi ph (wcel X (cin A2 B2)) $ >
  $ wi ph (wcel U A2) $ >
  $ wi ph (wcel V B2) $ >
  $ wi ph (wne U X) $ >
  $ wi ph (wne V X) $ >
  $ wi ph (wcel (cs3 U X V) (cfv G crag)) $ >
  $ wi ph (wbr A2 B2 (cfv G cperpg)) $;

--| Alternative version of ~ footex which minimization requires a notably long time. (Contributed by Thierry Arnoux, 19-Oct-2019.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem footexALT {x3: setvar} (ph: wff) (A2 C P G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wn (wcel C A2)) $ >
  $ wi ph (wrex x3 (wbr (co C (cv x3) L) A2 (cfv G cperpg)) A2) $;

--| Lemma for ~ footex . (Contributed by Thierry Arnoux, 19-Oct-2019.) (Revised by Thierry Arnoux, 1-Jul-2023.)
theorem footexlem1 (ph: wff) (A2 C D P Q R E F G I L c_mi X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wn (wcel C A2)) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel R P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wceq A2 (co E F L)) $ >
  $ wi ph (wne E F) $ >
  $ wi ph (wcel E (co F Y I)) $ >
  $ wi ph (wceq (co E Y c_mi) (co E C c_mi)) $ >
  $ wi ph (wceq C (cfv Y (cfv R (cfv G cmir)))) $ >
  $ wi ph (wcel Y (co E Z I)) $ >
  $ wi ph (wceq (co Y Z c_mi) (co Y R c_mi)) $ >
  $ wi ph (wcel Q P) $ >
  $ wi ph (wcel Y (co R Q I)) $ >
  $ wi ph (wceq (co Y Q c_mi) (co Y E c_mi)) $ >
  $ wi ph (wcel Y (co (cfv Q (cfv Z (cfv G cmir))) D I)) $ >
  $ wi ph (wceq (co Y D c_mi) (co Y C c_mi)) $ >
  $ wi ph (wceq D (cfv C (cfv X (cfv G cmir)))) $ >
  $ wi ph (wcel X A2) $;

--| Lemma for ~ footex . (Contributed by Thierry Arnoux, 19-Oct-2019.) (Revised by Thierry Arnoux, 1-Jul-2023.)
theorem footexlem2 (ph: wff) (A2 C D P Q R E F G I L c_mi X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wn (wcel C A2)) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel R P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wceq A2 (co E F L)) $ >
  $ wi ph (wne E F) $ >
  $ wi ph (wcel E (co F Y I)) $ >
  $ wi ph (wceq (co E Y c_mi) (co E C c_mi)) $ >
  $ wi ph (wceq C (cfv Y (cfv R (cfv G cmir)))) $ >
  $ wi ph (wcel Y (co E Z I)) $ >
  $ wi ph (wceq (co Y Z c_mi) (co Y R c_mi)) $ >
  $ wi ph (wcel Q P) $ >
  $ wi ph (wcel Y (co R Q I)) $ >
  $ wi ph (wceq (co Y Q c_mi) (co Y E c_mi)) $ >
  $ wi ph (wcel Y (co (cfv Q (cfv Z (cfv G cmir))) D I)) $ >
  $ wi ph (wceq (co Y D c_mi) (co Y C c_mi)) $ >
  $ wi ph (wceq D (cfv C (cfv X (cfv G cmir)))) $ >
  $ wi ph (wbr (co C X L) A2 (cfv G cperpg)) $;

--| From a point ` C ` outside of a line ` A ` , there exists a point ` x ` on ` A ` such that ` ( C L x ) ` is perpendicular to ` A ` . This point is unique, see ~ foot . (Contributed by Thierry Arnoux, 19-Oct-2019.) (Revised by Thierry Arnoux, 1-Jul-2023.)
theorem footex {x3: setvar} (ph: wff) (A2 C P G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wn (wcel C A2)) $ >
  $ wi ph (wrex x3 (wbr (co C (cv x3) L) A2 (cfv G cperpg)) A2) $;

--| From a point ` C ` outside of a line ` A ` , there exists a unique point ` x ` on ` A ` such that ` ( C L x ) ` is perpendicular to ` A ` . That point is called the foot from ` C ` on ` A ` . Theorem 8.18 of [Schwabhauser] p. 60. (Contributed by Thierry Arnoux, 19-Oct-2019.)
theorem foot {x3: setvar} (ph: wff) (A2 C P G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wn (wcel C A2)) $ >
  $ wi ph (wreu x3 (wbr (co C (cv x3) L) A2 (cfv G cperpg)) A2) $;

--| Uniqueness of the foot point. (Contributed by Thierry Arnoux, 28-Feb-2020.)
theorem footne (ph: wff) (A2 P G I L c_mi X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wbr (co X Y L) A2 (cfv G cperpg)) $ >
  $ wi ph (wn (wcel Y A2)) $;

--| Uniqueness of the foot point. (Contributed by Thierry Arnoux, 1-Mar-2020.)
theorem footeq (ph: wff) (A2 P G I L c_mi X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y A2) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wbr (co X Z L) A2 (cfv G cperpg)) $ >
  $ wi ph (wbr (co Y Z L) A2 (cfv G cperpg)) $ >
  $ wi ph (wceq X Y) $;

--| If two lines ` A ` and ` B ` are perpendicular, then they intersect. (Contributed by Thierry Arnoux, 5-Jul-2026.)
theorem perpin (ph: wff) (A2 B2 G: class):
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr A2 B2 (cfv G cperpg)) $ >
  $ wi ph (wne (cin A2 B2) c0) $;

--| A point on a half-line which is perpendicular to a line cannot be on that line. (Contributed by Thierry Arnoux, 1-Mar-2020.)
theorem hlperpnel (ph: wff) (A2 P U G I K L c_mi V W: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel U A2) $ >
  $ wi ph (wcel V P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wbr A2 (co U V L) (cfv G cperpg)) $ >
  $ wi ph (wbr V W (cfv U K)) $ >
  $ wi ph (wn (wcel W A2)) $;

--| Deduce a right angle from perpendicular lines. (Contributed by Thierry Arnoux, 10-Nov-2019.)
theorem perprag (ph: wff) (A2 B2 C D P G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C (co A2 B2 L)) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wbr (co A2 B2 L) (co C D L) (cfv G cperpg)) $ >
  $ wi ph (wcel (cs3 A2 C D) (cfv G crag)) $;

--| Deduce a right angle from perpendicular lines. (Contributed by Thierry Arnoux, 12-Dec-2019.) (New usage is discouraged.) (Proof modification is discouraged.)
theorem perpdragALT (ph: wff) (A2 B2 C D P G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 D) $ >
  $ wi ph (wcel B2 D) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wbr D (co B2 C L) (cfv G cperpg)) $ >
  $ wi ph (wcel (cs3 A2 B2 C) (cfv G crag)) $;

--| Deduce a right angle from perpendicular lines. (Contributed by Thierry Arnoux, 12-Dec-2019.)
theorem perpdrag (ph: wff) (A2 B2 C D P G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 D) $ >
  $ wi ph (wcel B2 D) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wbr D (co B2 C L) (cfv G cperpg)) $ >
  $ wi ph (wcel (cs3 A2 B2 C) (cfv G crag)) $;

--| Deduce a perpendicularity from perpendicularity and colinearity. (Contributed by Thierry Arnoux, 8-Dec-2019.)
theorem colperp (ph: wff) (A2 B2 C D P G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wbr (co A2 B2 L) D (cfv G cperpg)) $ >
  $ wi ph (wo (wcel C (co A2 B2 L)) (wceq A2 B2)) $ >
  $ wi ph (wne A2 C) $ >
  $ wi ph (wbr (co A2 C L) D (cfv G cperpg)) $;

--| Lemma for ~ colperp . First part of lemma 8.20 of [Schwabhauser] p. 62. (Contributed by Thierry Arnoux, 27-Oct-2019.)
theorem colperpexlem1 (ph: wff) (A2 B2 C P Q S G I K L M c_mi N: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq S (cfv G cmir) $ >
  $ wceq M (cfv A2 S) $ >
  $ wceq N (cfv B2 S) $ >
  $ wceq K (cfv Q S) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel Q P) $ >
  $ wi ph (wcel (cs3 A2 B2 C) (cfv G crag)) $ >
  $ wi ph (wceq (cfv (cfv C M) K) (cfv C N)) $ >
  $ wi ph (wcel (cs3 B2 A2 Q) (cfv G crag)) $;

--| Lemma for ~ colperpex . Second part of lemma 8.20 of [Schwabhauser] p. 62. (Contributed by Thierry Arnoux, 10-Nov-2019.)
theorem colperpexlem2 (ph: wff) (A2 B2 C P Q S G I K L M c_mi N: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq S (cfv G cmir) $ >
  $ wceq M (cfv A2 S) $ >
  $ wceq N (cfv B2 S) $ >
  $ wceq K (cfv Q S) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel Q P) $ >
  $ wi ph (wcel (cs3 A2 B2 C) (cfv G crag)) $ >
  $ wi ph (wceq (cfv (cfv C M) K) (cfv C N)) $ >
  $ wi ph (wne B2 C) $ >
  $ wi ph (wne A2 Q) $;

--| Lemma for ~ colperpex . Case 1 of theorem 8.21 of [Schwabhauser] p. 63. (Contributed by Thierry Arnoux, 20-Nov-2019.)
theorem colperpexlem3 {t p: setvar} (ph: wff) (A2 B2 C P G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wn (wcel C (co A2 B2 L))) $ >
  $ wi ph (wrex p (wa (wbr (co A2 (cv p) L) (co A2 B2 L) (cfv G cperpg)) (wrex t (wa (wo (wcel (cv t) (co A2 B2 L)) (wceq A2 B2)) (wcel (cv t) (co C (cv p) I))) P)) P) $;

--| In dimension 2 and above, on a line ` ( A L B ) ` there is always a perpendicular ` P ` from ` A ` on a given plane (here given by ` C ` , in case ` C ` does not lie on the line). Theorem 8.21 of [Schwabhauser] p. 63. (Contributed by Thierry Arnoux, 20-Nov-2019.)
theorem colperpex {t p: setvar} (ph: wff) (A2 B2 C P G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wi ph (wrex p (wa (wbr (co A2 (cv p) L) (co A2 B2 L) (cfv G cperpg)) (wrex t (wa (wo (wcel (cv t) (co A2 B2 L)) (wceq A2 B2)) (wcel (cv t) (co C (cv p) I))) P)) P) $;

--| Lemma for ~ opphllem , which is itself used for ~ mideu . (Contributed by Thierry Arnoux, 19-Feb-2020.)
theorem mideulem2 (ph: wff) (A2 B2 P Q R S T G I L M c_mi O X Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wcel Q P) $ >
  $ wi ph (wcel O P) $ >
  $ wi ph (wcel T P) $ >
  $ wi ph (wbr (co A2 B2 L) (co Q B2 L) (cfv G cperpg)) $ >
  $ wi ph (wbr (co A2 B2 L) (co A2 O L) (cfv G cperpg)) $ >
  $ wi ph (wcel T (co A2 B2 L)) $ >
  $ wi ph (wcel T (co Q O I)) $ >
  $ wi ph (wcel R P) $ >
  $ wi ph (wcel R (co B2 Q I)) $ >
  $ wi ph (wceq (co A2 O c_mi) (co B2 R c_mi)) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel X (co T B2 I)) $ >
  $ wi ph (wcel X (co R O I)) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel X (co (cfv O (cfv A2 S)) Z I)) $ >
  $ wi ph (wceq (co X Z c_mi) (co X R c_mi)) $ >
  $ wi ph (wcel M P) $ >
  $ wi ph (wceq R (cfv Z (cfv M S))) $ >
  $ wi ph (wceq B2 M) $;

--| Lemma 8.24 of [Schwabhauser] p. 66. This is used later for ~ mideulem and later for ~ opphl . (Contributed by Thierry Arnoux, 21-Dec-2019.)
theorem opphllem {x3: setvar} (ph: wff) (A2 B2 P Q R: class) (S: class x3) (T: class) (G: class x3) (I: class) (L: class x3) (c_mi O: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wcel Q P) $ >
  $ wi ph (wcel O P) $ >
  $ wi ph (wcel T P) $ >
  $ wi ph (wbr (co A2 B2 L) (co Q B2 L) (cfv G cperpg)) $ >
  $ wi ph (wbr (co A2 B2 L) (co A2 O L) (cfv G cperpg)) $ >
  $ wi ph (wcel T (co A2 B2 L)) $ >
  $ wi ph (wcel T (co Q O I)) $ >
  $ wi ph (wcel R P) $ >
  $ wi ph (wcel R (co B2 Q I)) $ >
  $ wi ph (wceq (co A2 O c_mi) (co B2 R c_mi)) $ >
  $ wi ph (wrex x3 (wa (wceq B2 (cfv A2 (cfv (cv x3) S))) (wceq O (cfv R (cfv (cv x3) S)))) P) $;

--| Lemma for ~ mideu . We can assume mideulem.9 "without loss of generality". (Contributed by Thierry Arnoux, 25-Nov-2019.)
theorem mideulem {x3: setvar} (ph: wff) (A2 B2 P Q: class) (S: class x3) (T: class) (G: class x3) (I: class) (L: class x3) (c_mi O: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wcel Q P) $ >
  $ wi ph (wcel O P) $ >
  $ wi ph (wcel T P) $ >
  $ wi ph (wbr (co A2 B2 L) (co Q B2 L) (cfv G cperpg)) $ >
  $ wi ph (wbr (co A2 B2 L) (co A2 O L) (cfv G cperpg)) $ >
  $ wi ph (wcel T (co A2 B2 L)) $ >
  $ wi ph (wcel T (co Q O I)) $ >
  $ wi ph (wbr (co A2 O c_mi) (co B2 Q c_mi) (cfv G cleg)) $ >
  $ wi ph (wrex x3 (wceq B2 (cfv A2 (cfv (cv x3) S))) P) $;

--| Existence of the midpoint, part Theorem 8.22 of [Schwabhauser] p. 64. Note that this proof requires a construction in 2 dimensions or more, i.e. it does not prove the existence of a midpoint in dimension 1, for a geometry restricted to a line. (Contributed by Thierry Arnoux, 25-Nov-2019.)
theorem midex {x3: setvar} (ph: wff) (A2 B2 P S G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wi ph (wrex x3 (wceq B2 (cfv A2 (cfv (cv x3) S))) P) $;

--| Existence and uniqueness of the midpoint, Theorem 8.22 of [Schwabhauser] p. 64. (Contributed by Thierry Arnoux, 25-Nov-2019.)
theorem mideu {x3: setvar} (ph: wff) (A2 B2 P S G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wi ph (wreu x3 (wceq B2 (cfv A2 (cfv (cv x3) S))) P) $;

--| The property for two points ` A ` and ` B ` to lie on the opposite sides of a set ` D ` Definition 9.1 of [Schwabhauser] p. 67. (Contributed by Thierry Arnoux, 19-Dec-2019.)
theorem islnopp {t a b: setvar} (ph: wff t a b) (A2 B2: class a b) (D P: class t) (G: class t a b) (I: class t) (c_mi O: class t a b):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P D)) (wcel (cv b) (cdif P D))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) D))) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wb (wbr A2 B2 O) (wa (wa (wn (wcel A2 D)) (wn (wcel B2 D))) (wrex t (wcel (cv t) (co A2 B2 I)) D))) $;

--| Deduce that ` A ` and ` B ` lie on opposite sides of line ` L ` . (Contributed by Thierry Arnoux, 16-Aug-2020.)
theorem islnoppd {t a b: setvar} (ph: wff a b) (A2 B2 C: class a b) (D: class) (P: class t) (G: class t a b) (I: class) (c_mi O: class t a b):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P D)) (wcel (cv b) (cdif P D))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) D))) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C D) $ >
  $ wi ph (wn (wcel A2 D)) $ >
  $ wi ph (wn (wcel B2 D)) $ >
  $ wi ph (wcel C (co A2 B2 I)) $ >
  $ wi ph (wbr A2 B2 O) $;

--| Points lying on opposite sides of a line cannot be on the line. (Contributed by Thierry Arnoux, 3-Mar-2020.)
theorem oppne1 {t a b: setvar} (ph: wff a b) (A2 B2: class a b) (D P: class) (G: class a b) (I: class) (L c_mi O: class a b):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P D)) (wcel (cv b) (cdif P D))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) D))) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wbr A2 B2 O) $ >
  $ wi ph (wn (wcel A2 D)) $;

--| Points lying on opposite sides of a line cannot be on the line. (Contributed by Thierry Arnoux, 3-Mar-2020.)
theorem oppne2 {t a b: setvar} (ph: wff a b) (A2 B2: class a b) (D P: class) (G: class a b) (I: class) (L c_mi O: class a b):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P D)) (wcel (cv b) (cdif P D))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) D))) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wbr A2 B2 O) $ >
  $ wi ph (wn (wcel B2 D)) $;

--| Points lying on opposite sides of a line cannot be equal. (Contributed by Thierry Arnoux, 3-Aug-2020.)
theorem oppne3 {t a b: setvar} (ph: wff a b) (A2 B2: class a b) (D P: class) (G: class a b) (I: class) (L c_mi O: class a b):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P D)) (wcel (cv b) (cdif P D))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) D))) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wbr A2 B2 O) $ >
  $ wi ph (wne A2 B2) $;

--| Commutativity rule for "opposite" Theorem 9.2 of [Schwabhauser] p. 67. (Contributed by Thierry Arnoux, 19-Dec-2019.)
theorem oppcom {t a b: setvar} (ph: wff a b) (A2 B2: class a b) (D P: class) (G: class a b) (I: class) (L c_mi O: class a b):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P D)) (wcel (cv b) (cdif P D))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) D))) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wbr A2 B2 O) $ >
  $ wi ph (wbr B2 A2 O) $;

--| If two points opposite to a line exist, dimension must be 2 or more. (Contributed by Thierry Arnoux, 3-Mar-2020.)
theorem opptgdim2 {t a b: setvar} (ph: wff a b) (A2 B2: class a b) (D P: class) (G: class a b) (I: class) (L c_mi O: class a b):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P D)) (wcel (cv b) (cdif P D))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) D))) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wbr A2 B2 O) $ >
  $ wi ph (wbr G c2 cstrkgld) $;

--| The "opposite to a line" relation is irreflexive. (Contributed by Thierry Arnoux, 4-Mar-2020.)
theorem oppnid {t a b: setvar} (ph: wff a b) (A2: class a b) (D P: class) (G: class a b) (I: class) (L c_mi O: class a b):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P D)) (wcel (cv b) (cdif P D))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) D))) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wn (wbr A2 A2 O)) $;

--| Lemma for ~ opphl . (Contributed by Thierry Arnoux, 20-Dec-2019.)
theorem opphllem1 {t a b: setvar} (ph: wff a b) (A2 B2 C: class a b) (D P: class) (R S G: class a b) (I: class) (L M c_mi O: class a b):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P D)) (wcel (cv b) (cdif P D))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) D))) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq S (cfv M (cfv G cmir)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel R D) $ >
  $ wi ph (wbr A2 C O) $ >
  $ wi ph (wcel M D) $ >
  $ wi ph (wceq A2 (cfv C S)) $ >
  $ wi ph (wne A2 R) $ >
  $ wi ph (wne B2 R) $ >
  $ wi ph (wcel B2 (co R A2 I)) $ >
  $ wi ph (wbr B2 C O) $;

--| Lemma for ~ opphl . Lemma 9.3 of [Schwabhauser] p. 68. (Contributed by Thierry Arnoux, 21-Dec-2019.)
theorem opphllem2 {t a b: setvar} (ph: wff a b) (A2 B2 C: class a b) (D P: class) (R S G: class a b) (I: class) (L M c_mi O: class a b):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P D)) (wcel (cv b) (cdif P D))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) D))) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq S (cfv M (cfv G cmir)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel R D) $ >
  $ wi ph (wbr A2 C O) $ >
  $ wi ph (wcel M D) $ >
  $ wi ph (wceq A2 (cfv C S)) $ >
  $ wi ph (wne A2 R) $ >
  $ wi ph (wne B2 R) $ >
  $ wi ph (wo (wcel A2 (co R B2 I)) (wcel B2 (co R A2 I))) $ >
  $ wi ph (wbr B2 C O) $;

--| Lemma for ~ opphl : We assume opphllem3.l "without loss of generality". (Contributed by Thierry Arnoux, 21-Feb-2020.)
theorem opphllem3 {t a b: setvar} (ph: wff a b) (A2 C: class a b) (D P: class) (R S U G: class a b) (I: class) (K L M c_mi N O: class a b):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P D)) (wcel (cv b) (cdif P D))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) D))) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq K (cfv G chlg) $ >
  $ wceq N (cfv M (cfv G cmir)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel R D) $ >
  $ wi ph (wcel S D) $ >
  $ wi ph (wcel M P) $ >
  $ wi ph (wbr A2 C O) $ >
  $ wi ph (wbr D (co A2 R L) (cfv G cperpg)) $ >
  $ wi ph (wbr D (co C S L) (cfv G cperpg)) $ >
  $ wi ph (wne R S) $ >
  $ wi ph (wbr (co S C c_mi) (co R A2 c_mi) (cfv G cleg)) $ >
  $ wi ph (wcel U P) $ >
  $ wi ph (wceq (cfv R N) S) $ >
  $ wi ph (wb (wbr U A2 (cfv R K)) (wbr (cfv U N) C (cfv S K))) $;

--| Lemma for ~ opphl . (Contributed by Thierry Arnoux, 22-Feb-2020.)
theorem opphllem4 {t a b: setvar} (ph: wff a b) (A2 C: class a b) (D P: class) (R S U G: class a b) (I: class) (K L M c_mi N O V: class a b):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P D)) (wcel (cv b) (cdif P D))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) D))) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq K (cfv G chlg) $ >
  $ wceq N (cfv M (cfv G cmir)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel R D) $ >
  $ wi ph (wcel S D) $ >
  $ wi ph (wcel M P) $ >
  $ wi ph (wbr A2 C O) $ >
  $ wi ph (wbr D (co A2 R L) (cfv G cperpg)) $ >
  $ wi ph (wbr D (co C S L) (cfv G cperpg)) $ >
  $ wi ph (wne R S) $ >
  $ wi ph (wbr (co S C c_mi) (co R A2 c_mi) (cfv G cleg)) $ >
  $ wi ph (wcel U P) $ >
  $ wi ph (wceq (cfv R N) S) $ >
  $ wi ph (wcel V P) $ >
  $ wi ph (wbr U A2 (cfv R K)) $ >
  $ wi ph (wbr V C (cfv S K)) $ >
  $ wi ph (wbr U V O) $;

--| Second part of Lemma 9.4 of [Schwabhauser] p. 68. (Contributed by Thierry Arnoux, 2-Mar-2020.)
theorem opphllem5 {t a b: setvar} (ph: wff a b) (A2 C: class a b) (D P: class) (R S U G: class a b) (I: class) (K L M c_mi N O V: class a b):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P D)) (wcel (cv b) (cdif P D))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) D))) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq K (cfv G chlg) $ >
  $ wceq N (cfv M (cfv G cmir)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel R D) $ >
  $ wi ph (wcel S D) $ >
  $ wi ph (wcel M P) $ >
  $ wi ph (wbr A2 C O) $ >
  $ wi ph (wbr D (co A2 R L) (cfv G cperpg)) $ >
  $ wi ph (wbr D (co C S L) (cfv G cperpg)) $ >
  $ wi ph (wcel U P) $ >
  $ wi ph (wcel V P) $ >
  $ wi ph (wbr U A2 (cfv R K)) $ >
  $ wi ph (wbr V C (cfv S K)) $ >
  $ wi ph (wbr U V O) $;

--| First part of Lemma 9.4 of [Schwabhauser] p. 68. (Contributed by Thierry Arnoux, 3-Mar-2020.)
theorem opphllem6 {t a b: setvar} (ph: wff a b) (A2 C: class a b) (D P: class) (R S U G: class a b) (I: class) (K L M c_mi N O: class a b):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P D)) (wcel (cv b) (cdif P D))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) D))) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq K (cfv G chlg) $ >
  $ wceq N (cfv M (cfv G cmir)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel R D) $ >
  $ wi ph (wcel S D) $ >
  $ wi ph (wcel M P) $ >
  $ wi ph (wbr A2 C O) $ >
  $ wi ph (wbr D (co A2 R L) (cfv G cperpg)) $ >
  $ wi ph (wbr D (co C S L) (cfv G cperpg)) $ >
  $ wi ph (wcel U P) $ >
  $ wi ph (wceq (cfv R N) S) $ >
  $ wi ph (wb (wbr U A2 (cfv R K)) (wbr (cfv U N) C (cfv S K))) $;

--| Restating ~ colperpex using the "opposite side of a line" relation. (Contributed by Thierry Arnoux, 2-Aug-2020.)
theorem oppperpex {t p a b: setvar} (ph: wff a b) (A2 C: class a b) (D P: class) (G: class a b) (I: class) (K L c_mi: class a b) (O: class p a b):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P D)) (wcel (cv b) (cdif P D))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) D))) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel A2 D) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wn (wcel C D)) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wi ph (wrex p (wa (wbr (co A2 (cv p) L) D (cfv G cperpg)) (wbr C (cv p) O)) P) $;

--| If two points ` A ` and ` C ` lie on opposite sides of a line ` D ` , then any point of the half line ( ` R A ` ) also lies opposite to ` C ` . Theorem 9.5 of [Schwabhauser] p. 69. (Contributed by Thierry Arnoux, 3-Mar-2019.)
theorem opphl {t a b: setvar} (ph: wff a b) (A2 B2 C: class a b) (D P: class) (R G: class a b) (I: class) (K L c_mi O: class a b):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P D)) (wcel (cv b) (cdif P D))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) D))) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wbr A2 C O) $ >
  $ wi ph (wcel R D) $ >
  $ wi ph (wbr A2 B2 (cfv R K)) $ >
  $ wi ph (wbr B2 C O) $;

--| The segment between two points ` X ` and ` Y ` on opposite sides of a line ` D ` intersects ` D ` . (Contributed by Thierry Arnoux, 23-Aug-2026.)
theorem lnoppinn0 {t a b: setvar} (ph: wff a b) (D: class) (P: class t) (G: class t a b) (I: class) (L O V: class t a b) (X Y: class a b):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P D)) (wcel (cv b) (cdif P D))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) D))) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wbr X Y O) $ >
  $ wi ph (wne (cin D (co X Y I)) c0) $;

--| The mirror point with regard to a point ` X ` on a line ` A ` lies on the other side of ` A ` . (Contributed by Thierry Arnoux, 5-Jul-2026.)
theorem oppmir {t a b: setvar} (ph: wff a b) (A2: class) (P: class t) (S G: class t a b) (I: class) (L: class t a b) (M: class a b) (O: class t a b) (X Y: class a b):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq S (cfv G cmir) $ >
  $ wceq M (cfv X S) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P A2)) (wcel (cv b) (cdif P A2))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) A2))) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y (cdif P A2)) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wbr Y (cfv Y M) O) $;

--| Axiom of Pasch, outer form. This was proven by Gupta from other axioms and is therefore presented as Theorem 9.6 in [Schwabhauser] p. 70. (Contributed by Thierry Arnoux, 16-Aug-2020.)
theorem outpasch {x3: setvar} (ph: wff) (A2 B2 C P Q R G I L: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel R P) $ >
  $ wi ph (wcel Q P) $ >
  $ wi ph (wcel C (co A2 R I)) $ >
  $ wi ph (wcel Q (co B2 C I)) $ >
  $ wi ph (wrex x3 (wa (wcel (cv x3) (co A2 B2 I)) (wcel Q (co R (cv x3) I))) P) $;

--| An application of the axiom of Pasch for half-lines. (Contributed by Thierry Arnoux, 15-Sep-2020.)
theorem hlpasch {e: setvar} (ph: wff) (A2 B2 C D P G I K X: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wbr C D (cfv B2 K)) $ >
  $ wi ph (wcel A2 (co X C I)) $ >
  $ wi ph (wrex e (wa (wbr A2 (cv e) (cfv B2 K)) (wcel (cv e) (co X D I))) P) $;

--| "Belong to the same open half-plane" relation for points in a geometry.
term chpg: class;

--| Define the open half plane relation for a geometry ` G ` . Definition 9.7 of [Schwabhauser] p. 71. See ~ hpgbr to find the same formulation. (Contributed by Thierry Arnoux, 4-Mar-2020.)
axiom df_hpg {t g2 i p a b c d: setvar}:
  $ wceq chpg (cmpt g2 cvv (cmpt d (crn (cfv (cv g2) clng)) (copab a b (wsbc p (wsbc i (wrex c (wa (wa (wa (wcel (cv a) (cdif (cv p) (cv d))) (wcel (cv c) (cdif (cv p) (cv d)))) (wrex t (wcel (cv t) (co (cv a) (cv c) (cv i))) (cv d))) (wa (wa (wcel (cv b) (cdif (cv p) (cv d))) (wcel (cv c) (cdif (cv p) (cv d)))) (wrex t (wcel (cv t) (co (cv b) (cv c) (cv i))) (cv d)))) (cv p)) (cfv (cv g2) citv)) (cfv (cv g2) cbs))))) $;

--| Value of the half-plane relation for a given line ` D ` . (Contributed by Thierry Arnoux, 4-Mar-2020.)
theorem ishpg {t a b c: setvar} (ph: wff t a b c) (D P: class) (G: class t c) (I: class) (L O: class t a b c):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P D)) (wcel (cv b) (cdif P D))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) D))) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wceq (cfv D (cfv G chpg)) (copab a b (wrex c (wa (wbr (cv a) (cv c) O) (wbr (cv b) (cv c) O)) P))) $;

--| Half-planes : property for points ` A ` and ` B ` to belong to the same open half plane delimited by line ` D ` . Definition 9.7 of [Schwabhauser] p. 71. (Contributed by Thierry Arnoux, 4-Mar-2020.)
theorem hpgbr {t a b c: setvar} (ph: wff t a b c) (A2 B2: class t a b) (D P: class) (G: class t c) (I: class) (L: class t a b c) (O: class t c):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P D)) (wcel (cv b) (cdif P D))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) D))) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wb (wbr A2 B2 (cfv D (cfv G chpg))) (wrex c (wa (wbr A2 (cv c) O) (wbr B2 (cv c) O)) P)) $;

--| Points on the open half plane cannot lie on its border. (Contributed by Thierry Arnoux, 4-Mar-2020.)
theorem hpgne1 {t a b: setvar} (ph: wff a b) (A2 B2: class a b) (D P G I: class) (L: class a b) (O: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P D)) (wcel (cv b) (cdif P D))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) D))) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wbr A2 B2 (cfv D (cfv G chpg))) $ >
  $ wi ph (wn (wcel A2 D)) $;

--| Points on the open half plane cannot lie on its border. (Contributed by Thierry Arnoux, 4-Mar-2020.)
theorem hpgne2 {t a b: setvar} (ph: wff a b) (A2 B2: class a b) (D P G I: class) (L: class a b) (O: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P D)) (wcel (cv b) (cdif P D))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) D))) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wbr A2 B2 (cfv D (cfv G chpg))) $ >
  $ wi ph (wn (wcel B2 D)) $;

--| Theorem 9.8 of [Schwabhauser] p. 71. (Contributed by Thierry Arnoux, 4-Mar-2020.)
theorem lnopp2hpgb {t a b: setvar} (ph: wff a b) (A2 B2: class a b) (C D P G I L O: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P D)) (wcel (cv b) (cdif P D))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) D))) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wbr A2 C O) $ >
  $ wi ph (wb (wbr B2 C O) (wbr A2 B2 (cfv D (cfv G chpg)))) $;

--| If two points lie on the opposite side of a line ` D ` , they are not on the same half-plane. Theorem 9.9 of [Schwabhauser] p. 72. (Contributed by Thierry Arnoux, 4-Mar-2020.)
theorem lnoppnhpg {t a b: setvar} (ph: wff a b) (A2: class a b) (B2 D P G I L O: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P D)) (wcel (cv b) (cdif P D))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) D))) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wbr A2 B2 O) $ >
  $ wi ph (wn (wbr A2 B2 (cfv D (cfv G chpg)))) $;

--| Lemma for the proof that the half-plane relation is an equivalence relation. Lemma 9.10 of [Schwabhauser] p. 72. (Contributed by Thierry Arnoux, 4-Mar-2020.)
theorem hpgerlem {t a b c: setvar} (ph: wff a b) (A2: class a b) (D P G I: class) (L: class t a b c) (O: class c):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P D)) (wcel (cv b) (cdif P D))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) D))) $ >
  $ wi ph (wn (wcel A2 D)) $ >
  $ wi ph (wrex c (wbr A2 (cv c) O) P) $;

--| The half-plane relation is reflexive. Theorem 9.11 of [Schwabhauser] p. 72. (Contributed by Thierry Arnoux, 4-Mar-2020.)
theorem hpgid {t a b: setvar} (ph: wff a b) (A2: class a b) (D P G I: class) (L: class t a b) (O: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P D)) (wcel (cv b) (cdif P D))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) D))) $ >
  $ wi ph (wn (wcel A2 D)) $ >
  $ wi ph (wbr A2 A2 (cfv D (cfv G chpg))) $;

--| The half-plane relation is symmetric. Theorem 9.12 of [Schwabhauser] p. 72. (Contributed by Thierry Arnoux, 4-Mar-2020.)
theorem hpgcom {t a b: setvar} (ph: wff a b) (A2 B2: class a b) (D P G I: class) (L: class t a b) (O: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P D)) (wcel (cv b) (cdif P D))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) D))) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wbr A2 B2 (cfv D (cfv G chpg))) $ >
  $ wi ph (wbr B2 A2 (cfv D (cfv G chpg))) $;

--| The half-plane relation is transitive. Theorem 9.13 of [Schwabhauser] p. 72. (Contributed by Thierry Arnoux, 4-Mar-2020.)
theorem hpgtr {t a b: setvar} (ph: wff a b) (A2 B2: class a b) (C D P G I L O: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P D)) (wcel (cv b) (cdif P D))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) D))) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wbr A2 B2 (cfv D (cfv G chpg))) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wbr B2 C (cfv D (cfv G chpg))) $ >
  $ wi ph (wbr A2 C (cfv D (cfv G chpg))) $;

--| Opposite sides of a line for colinear points. Theorem 9.18 of [Schwabhauser] p. 73. (Contributed by Thierry Arnoux, 3-Aug-2020.)
theorem colopp {t a b: setvar} (ph: wff a b) (A2 B2 C: class a b) (D P G I L O: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P D)) (wcel (cv b) (cdif P D))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) D))) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C D) $ >
  $ wi ph (wo (wcel C (co A2 B2 L)) (wceq A2 B2)) $ >
  $ wi ph (wb (wbr A2 B2 O) (w3a (wcel C (co A2 B2 I)) (wn (wcel A2 D)) (wn (wcel B2 D)))) $;

--| Half-plane relation for colinear points. Theorem 9.19 of [Schwabhauser] p. 73. (Contributed by Thierry Arnoux, 3-Aug-2020.)
theorem colhp {t a b: setvar} (ph: wff a b) (A2: class) (B2: class a b) (C D P G I: class) (K: class t a b) (L O: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P D)) (wcel (cv b) (cdif P D))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) D))) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C D) $ >
  $ wi ph (wo (wcel C (co A2 B2 L)) (wceq A2 B2)) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wb (wbr A2 B2 (cfv D (cfv G chpg))) (wa (wbr A2 B2 (cfv C K)) (wn (wcel A2 D)))) $;

--| If two points are on the same half-line with endpoint on a line, they are on the same half-plane defined by this line. (Contributed by Thierry Arnoux, 9-Aug-2020.)
theorem hphl {t a b: setvar} (ph: wff a b) (A2 B2 C D P G I: class) (K: class t a b) (L O: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P D)) (wcel (cv b) (cdif P D))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) D))) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel A2 D) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wn (wcel B2 D)) $ >
  $ wi ph (wbr B2 C (cfv A2 K)) $ >
  $ wi ph (wbr B2 C (cfv D (cfv G chpg))) $;

--| If two points ` X ` and ` Y ` lie on opposite sides of a line ` A ` , then given a point ` Z ` on ` A ` , any point ` W ` on the line ` ( X L Z ) ` opposite to ` Y ` lies on the half line ( ` Z X ` ) (Contributed by Thierry Arnoux, 20-Jul-2026.)
theorem hlopp {t a b: setvar} (ph: wff a b) (A2 P G I: class) (K: class t a b) (L O W: class) (X: class a b) (Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P A2)) (wcel (cv b) (cdif P A2))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) A2))) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wbr X Y O) $ >
  $ wi ph (wcel Z A2) $ >
  $ wi ph (wbr W Y O) $ >
  $ wi ph (wcel W (co X Z L)) $ >
  $ wi ph (wbr W X (cfv Z K)) $;

--| Declare the constant for the class of planes.
term cplng: class;

--| Define the function building a plane from a line and a point not on that line. Definition 9.20 of [Schwabhauser] p. 74. (Contributed by Thierry Arnoux, 17-Jun-2026.)
axiom df_plng {x3 t g2 r a: setvar}:
  $ wceq cplng (cmpt g2 cvv (cmpo a r (crn (cfv (cv g2) clng)) (cdif (cfv (cv g2) cbs) (cv a)) (crab x3 (w3o (wcel (cv x3) (cv a)) (wbr (cv x3) (cv r) (cfv (cv a) (cfv (cv g2) chpg))) (wrex t (wcel (cv t) (co (cv x3) (cv r) (cfv (cv g2) citv))) (cv a))) (cfv (cv g2) cbs)))) $;

--| The plane generating function as a function. (Contributed by Thierry Arnoux, 17-Jun-2026.)
theorem tgplnfn (ph: wff) (P E G L V: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wfn E (cdif (cxp (crn L) P) (ccnv cep))) $;

--| The property of being a plane, generated by a line and a point. (Contributed by Thierry Arnoux, 17-Jun-2026.)
theorem tgelrnpln (ph: wff) (A2 P R E G L V: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel R (cdif P A2)) $ >
  $ wi ph (wcel (co A2 R E) (crn E)) $;

--| The plane defined by a line ` A ` and a point ` R ` outside of ` A ` . This is defined as the union of 3 parts: the line itself, the open half-plane containing ` R ` , and the points opposite to ` R ` (see ~ islnopp ). (Contributed by Thierry Arnoux, 17-Jun-2026.)
theorem plngval {x3 t: setvar} (ph: wff) (A2: class) (P: class t) (R: class) (E: class x3 t) (G: class) (I L: class x3 t):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel R (cdif P A2)) $ >
  $ wi ph (wceq (co A2 R E) (crab x3 (w3o (wcel (cv x3) A2) (wbr (cv x3) R (cfv A2 (cfv G chpg))) (wrex t (wcel (cv t) (co (cv x3) R I)) A2)) P)) $;

--| The property of being a plane. (Contributed by Thierry Arnoux, 17-Jun-2026.)
theorem isplng {r a: setvar} (ph: wff) (P: class a) (E: class r a) (G H: class) (I: class r a) (L: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel H (crn E)) $ >
  $ wi ph (wrex a (wrex r (wceq H (co (cv a) (cv r) E)) (cdif P (cv a))) (crn L)) $;

--| Planes are sets of points. (Contributed by Thierry Arnoux, 17-Jun-2026.)
theorem plngrnssp (ph: wff) (P E G H I L X: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel H (crn E)) $ >
  $ wi ph (wcel X H) $ >
  $ wi ph (wcel X P) $;

--| Elementhood in the plane defined by a line ` A ` and a point ` R ` . Definition 9.20 of [Schwabhauser] p. 74. (Contributed by Thierry Arnoux, 17-Jun-2026.)
theorem elplng {t a b: setvar} (ph: wff a b) (A2: class) (P: class t) (R: class a b) (E: class t a b) (G: class a b) (I: class t) (L O: class t a b) (X: class a b):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel R (cdif P A2)) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P A2)) (wcel (cv b) (cdif P A2))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) A2))) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wb (wcel X (co A2 R E)) (w3o (wcel X A2) (wbr X R (cfv A2 (cfv G chpg))) (wbr X R O))) $;

--| Planes are sets of points. (Contributed by Thierry Arnoux, 17-Jun-2026.)
theorem plngssp (ph: wff) (A2 P R E G I L X: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel R (cdif P A2)) $ >
  $ wi ph (wcel X (co A2 R E)) $ >
  $ wi ph (wcel X P) $;

--| The point ` R ` is itself an element of a plane defined by a line ` A ` and the point ` R ` . (Contributed by Thierry Arnoux, 17-Jun-2026.)
theorem elplngid (ph: wff) (A2 P R E G I L: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel R (cdif P A2)) $ >
  $ wi ph (wcel R (co A2 R E)) $;

--| The line ` A ` itself is a subset of a plane defined by the line ` A ` and a point ` R ` . (Contributed by Thierry Arnoux, 17-Jun-2026.)
theorem elplnglnid (ph: wff) (A2 P R E G I L: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel R (cdif P A2)) $ >
  $ wi ph (wss A2 (co A2 R E)) $;

--| If two lines ` A ` and ` B ` intersect, then ` B ` is in a plane defined by ` A ` and any point of ` B ` . Lemma 9.22 of [Schwabhauser] p. 74. (Contributed by Thierry Arnoux, 17-Jun-2026.)
theorem lnincplng (ph: wff) (A2 B2 P E G I L X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel B2 (crn L)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wne X Y) $ >
  $ wi ph (wceq (cin A2 B2) (csn Y)) $ >
  $ wi ph (wss B2 (co A2 X E)) $;

--| Lemma for ~ plngcp . (Contributed by Thierry Arnoux, 17-Jun-2026.)
theorem plngcplem {t a b: setvar} (ph: wff a b) (A2 P R S: class) (E: class t a b) (G I L O: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel R (cdif P A2)) $ >
  $ wi ph (wcel S (cdif (co A2 R E) A2)) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P A2)) (wcel (cv b) (cdif P A2))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) A2))) $ >
  $ wi ph (wceq (co A2 R E) (co A2 S E)) $;

--| The plane defined by a line ` A ` and a point ` R ` can also be defined using a different point ` R ` on the same plane: changes the point used to define the plane. Theorem 9.21 of [Schwabhauser] p. 74. (Contributed by Thierry Arnoux, 17-Jun-2026.)
theorem plngcp (ph: wff) (A2 P R S E G I L: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel R (cdif P A2)) $ >
  $ wi ph (wcel S (cdif (co A2 R E) A2)) $ >
  $ wi ph (wceq (co A2 R E) (co A2 S E)) $;

--| Lemma for ~ plngrot . (Contributed by Thierry Arnoux, 17-Jun-2026.)
theorem plngrotlem1 {t a b: setvar} (ph: wff a b) (P: class) (S E: class a b) (G I L O W X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X (cdif P (co Z Y L))) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z (cdif P (co X Y L))) $ >
  $ wi ph (wne X Y) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P (co X Y L))) (wcel (cv b) (cdif P (co X Y L)))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) (co X Y L)))) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wcel Y (co Z W I)) $ >
  $ wi ph (wne Y W) $ >
  $ wi ph (wcel S (co (co X Y L) Z E)) $ >
  $ wi ph (wo (wcel S (co X Y L)) (wbr S Z (cfv (co X Y L) (cfv G chpg)))) $ >
  $ wi ph (wcel S (co (co Z Y L) X E)) $;

--| Lemma for ~ plngrot . (Contributed by Thierry Arnoux, 17-Jun-2026.)
theorem plngrotlem2 {t a b: setvar} (ph: wff a b) (P: class) (E: class a b) (G I L O W X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X (cdif P (co Z Y L))) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z (cdif P (co X Y L))) $ >
  $ wi ph (wne X Y) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P (co X Y L))) (wcel (cv b) (cdif P (co X Y L)))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) (co X Y L)))) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wcel Y (co Z W I)) $ >
  $ wi ph (wne Y W) $ >
  $ wi ph (wss (co (co X Y L) Z E) (co (co Z Y L) X E)) $;

--| Lemma for ~ plngrot . (Contributed by Thierry Arnoux, 17-Jun-2026.)
theorem plngrotlem3 {t a b: setvar} (ph: wff a b) (P: class) (E: class a b) (G I L O X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X (cdif P (co Z Y L))) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z (cdif P (co X Y L))) $ >
  $ wi ph (wne X Y) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P (co X Y L))) (wcel (cv b) (cdif P (co X Y L)))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) (co X Y L)))) $ >
  $ wi ph (wss (co (co X Y L) Z E) (co (co Z Y L) X E)) $;

--| The plane defined by a line ` ( X L Y ) ` and a point ` Z ` is also defined by the line ` ( Z L Y ) ` and the point ` X ` . See first part of Theorem 9.24 of [Schwabhauser] p. 74. (Contributed by Thierry Arnoux, 17-Jun-2026.)
theorem plngrot (ph: wff) (P E G I L X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X (cdif P (co Z Y L))) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z (cdif P (co X Y L))) $ >
  $ wi ph (wne X Y) $ >
  $ wi ph (wceq (co (co X Y L) Z E) (co (co Z Y L) X E)) $;

--| Lemma for ~ lnssplng . (Contributed by Thierry Arnoux, 17-Jun-2026.)
theorem lnssplnglem {s1: setvar} (ph: wff) (A2 P R E: class) (G I: class s1) (L X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X (co A2 R E)) $ >
  $ wi ph (wcel Y (co A2 R E)) $ >
  $ wi ph (wne X Y) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel R (cdif P A2)) $ >
  $ wi ph (wne A2 (co X Y L)) $ >
  $ wi ph (wn (wcel Y A2)) $ >
  $ wi ph (wa (wss (co X Y L) (co A2 R E)) (wrex s1 (wceq (co A2 R E) (co (co X Y L) (cv s1) E)) (cdif P (co X Y L)))) $;

--| A line defined by two points ` X ` and ` Y ` , both on a plane ` H ` , is entirely contained in ` H ` . Theorem 9.25 of [Schwabhauser] p. 75. (Contributed by Thierry Arnoux, 17-Jun-2026.)
theorem lnssplng {s1: setvar} (ph: wff) (P E: class) (G: class s1) (H: class) (I: class s1) (L X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel H (crn E)) $ >
  $ wi ph (wcel X H) $ >
  $ wi ph (wcel Y H) $ >
  $ wi ph (wne X Y) $ >
  $ wi ph (wa (wss (co X Y L) H) (wrex s1 (wceq H (co (co X Y L) (cv s1) E)) (cdif P (co X Y L)))) $;

--| A line defined by two points ` X ` and ` Y ` , both on a plane ` H ` , is entirely contained in ` H ` . First part of Theorem 9.25 of [Schwabhauser] p. 75. (Contributed by Thierry Arnoux, 17-Jun-2026.)
theorem lnssplng1 (ph: wff) (P E G H I L X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel H (crn E)) $ >
  $ wi ph (wcel X H) $ >
  $ wi ph (wcel Y H) $ >
  $ wi ph (wne X Y) $ >
  $ wi ph (wss (co X Y L) H) $;

--| Given a line ` A ` and a point ` X ` not on ` A ` , then a point ` Y ` on the plane defined by ` A ` and ` X ` is either opposite to ` X ` , or opposite to the mirror point of ` X ` by any point ` Z ` of ` A ` . (Contributed by Thierry Arnoux, 5-Jul-2026.)
theorem plngmiropp {t a b: setvar} (ph: wff a b) (A2 P: class) (S E: class t a b) (G I L M O X Y: class) (Z: class a b):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wceq M (cfv Z S) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P A2)) (wcel (cv b) (cdif P A2))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) A2))) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel X (cdif P A2)) $ >
  $ wi ph (wcel Y (cdif (co A2 X E) A2)) $ >
  $ wi ph (wcel Z A2) $ >
  $ wi ph (wo (wbr X Y O) (wbr (cfv X M) Y O)) $;

--| The mirror of a point with regard to another point is in the same plane as the two points. (Contributed by Thierry Arnoux, 5-Jul-2026.)
theorem mirplncl (ph: wff) (P S E G H M X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq E (cfv G cplng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wceq M (cfv X S) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel H (crn E)) $ >
  $ wi ph (wcel X H) $ >
  $ wi ph (wcel Y H) $ >
  $ wi ph (wcel (cfv Y M) H) $;

--| Any point ` X ` on a half plane defined by a line ` A ` and another point ` Y ` is on the plane defined by ` A ` and ` Y ` . (Contributed by Thierry Arnoux, 5-Jul-2026.)
theorem hpgssplng (ph: wff) (A2 P E G L X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y (cdif P A2)) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr X Y (cfv A2 (cfv G chpg))) $ >
  $ wi ph (wcel X (co A2 Y E)) $;

--| If ` H ` is a plane containing a line ` A ` and a point ` R ` not on ` A ` , then ` H ` is the plane defined by ` A ` and ` R ` . Theorem 9.26 of [Schwabhauser] p. 76. See ~ tglinethru for the 2-point line equivalent. (Contributed by Thierry Arnoux, 17-Jun-2026.)
theorem plng3p (ph: wff) (A2 P R E G H L: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel H (crn E)) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel R (cdif H A2)) $ >
  $ wi ph (wss A2 H) $ >
  $ wi ph (wceq H (co A2 R E)) $;

--| If a point ` Z ` is on the plane defined by a line ` A ` and a point ` Y ` , but not on the same half-plane as ` Y ` , then its mirror point ` ( M `` Z ) ` by a point ` X ` on ` A ` is on the same half-plane as ` Y ` . (Contributed by Thierry Arnoux, 5-Jul-2026.)
theorem nhpmirhp (ph: wff) (A2 P S E G L M X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq S (cfv G cmir) $ >
  $ wceq E (cfv G cplng) $ >
  $ wceq M (cfv X S) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y (cdif P A2)) $ >
  $ wi ph (wcel Z (cdif (co A2 Y E) A2)) $ >
  $ wi ph (wn (wbr Y Z (cfv A2 (cfv G chpg)))) $ >
  $ wi ph (wbr Y (cfv Z M) (cfv A2 (cfv G chpg))) $;

--| Declare the constant for the midpoint operation.
term cmid: class;

--| Declare the constant for the line mirroring function.
term clmi: class;

--| Define the midpoint operation. Definition 10.1 of [Schwabhauser] p. 88. See ~ ismidb , ~ midbtwn , and ~ midcgr . (Contributed by Thierry Arnoux, 9-Jun-2019.)
axiom df_mid {g2 m a b: setvar}:
  $ wceq cmid (cmpt g2 cvv (cmpo a b (cfv (cv g2) cbs) (cfv (cv g2) cbs) (crio m (wceq (cv b) (cfv (cv a) (cfv (cv m) (cfv (cv g2) cmir)))) (cfv (cv g2) cbs)))) $;

--| Define the line mirroring function. Definition 10.3 of [Schwabhauser] p. 89. See ~ islmib . (Contributed by Thierry Arnoux, 1-Dec-2019.)
axiom df_lmi {g2 m a b: setvar}:
  $ wceq clmi (cmpt g2 cvv (cmpt m (crn (cfv (cv g2) clng)) (cmpt a (cfv (cv g2) cbs) (crio b (wa (wcel (co (cv a) (cv b) (cfv (cv g2) cmid)) (cv m)) (wo (wbr (cv m) (co (cv a) (cv b) (cfv (cv g2) clng)) (cfv (cv g2) cperpg)) (wceq (cv a) (cv b)))) (cfv (cv g2) cbs))))) $;

--| Midpoint as a function. (Contributed by Thierry Arnoux, 1-Dec-2019.)
theorem midf (ph: wff) (P G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wi ph (wf (cxp P P) P (cfv G cmid)) $;

--| Closure of the midpoint. (Contributed by Thierry Arnoux, 1-Dec-2019.)
theorem midcl (ph: wff) (A2 B2 P G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel (co A2 B2 (cfv G cmid)) P) $;

--| Property of the midpoint. (Contributed by Thierry Arnoux, 1-Dec-2019.)
theorem ismidb (ph: wff) (A2 B2 P S G I M c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wceq S (cfv G cmir) $ >
  $ wi ph (wcel M P) $ >
  $ wi ph (wb (wceq B2 (cfv A2 (cfv M S))) (wceq (co A2 B2 (cfv G cmid)) M)) $;

--| Betweenness of midpoint. (Contributed by Thierry Arnoux, 7-Dec-2019.)
theorem midbtwn (ph: wff) (A2 B2 P G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel (co A2 B2 (cfv G cmid)) (co A2 B2 I)) $;

--| Congruence of midpoint. (Contributed by Thierry Arnoux, 7-Dec-2019.)
theorem midcgr (ph: wff) (A2 B2 C P G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wceq (co A2 B2 (cfv G cmid)) C) $ >
  $ wi ph (wceq (co C A2 c_mi) (co C B2 c_mi)) $;

--| Midpoint of a null segment. (Contributed by Thierry Arnoux, 7-Dec-2019.)
theorem midid (ph: wff) (A2 B2 P G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wceq (co A2 A2 (cfv G cmid)) A2) $;

--| Commutativity rule for the midpoint. (Contributed by Thierry Arnoux, 2-Dec-2019.)
theorem midcom (ph: wff) (A2 B2 P G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wceq (co A2 B2 (cfv G cmid)) (co B2 A2 (cfv G cmid))) $;

--| Point inversion preserves midpoints. (Contributed by Thierry Arnoux, 12-Dec-2019.)
theorem mirmid (ph: wff) (A2 B2 P S G I M c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wceq S (cfv M (cfv G cmir)) $ >
  $ wi ph (wcel M P) $ >
  $ wi ph (wceq (co (cfv A2 S) (cfv B2 S) (cfv G cmid)) (cfv (co A2 B2 (cfv G cmid)) S)) $;

--| Uniqueness of the line mirror point. Theorem 10.2 of [Schwabhauser] p. 88. (Contributed by Thierry Arnoux, 1-Dec-2019.)
theorem lmieu {b: setvar} (ph: wff) (A2 D P G: class) (I: class b) (L: class) (c_mi: class b):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wreu b (wa (wcel (co A2 (cv b) (cfv G cmid)) D) (wo (wbr D (co A2 (cv b) L) (cfv G cperpg)) (wceq A2 (cv b)))) P) $;

--| Line mirror as a function. (Contributed by Thierry Arnoux, 11-Dec-2019.)
theorem lmif (ph: wff) (D P G I L M c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wceq M (cfv D (cfv G clmi)) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wf P P M) $;

--| Closure of the line mirror. (Contributed by Thierry Arnoux, 11-Dec-2019.)
theorem lmicl (ph: wff) (A2 D P G I L M c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wceq M (cfv D (cfv G clmi)) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel (cfv A2 M) P) $;

--| Property of the line mirror. (Contributed by Thierry Arnoux, 11-Dec-2019.)
theorem islmib (ph: wff) (A2 B2 D P G I L M c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wceq M (cfv D (cfv G clmi)) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wb (wceq B2 (cfv A2 M)) (wa (wcel (co A2 B2 (cfv G cmid)) D) (wo (wbr D (co A2 B2 L) (cfv G cperpg)) (wceq A2 B2)))) $;

--| The line mirroring function is an involution. Theorem 10.4 of [Schwabhauser] p. 89. (Contributed by Thierry Arnoux, 11-Dec-2019.)
theorem lmicom (ph: wff) (A2 B2 D P G I L M c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wceq M (cfv D (cfv G clmi)) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wceq (cfv A2 M) B2) $ >
  $ wi ph (wceq (cfv B2 M) A2) $;

--| Line mirroring is an involution. Theorem 10.5 of [Schwabhauser] p. 89. (Contributed by Thierry Arnoux, 11-Dec-2019.)
theorem lmilmi (ph: wff) (A2 D P G I L M c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wceq M (cfv D (cfv G clmi)) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wceq (cfv (cfv A2 M) M) A2) $;

--| Any point has a unique antecedent through line mirroring. Theorem 10.6 of [Schwabhauser] p. 89. (Contributed by Thierry Arnoux, 11-Dec-2019.)
theorem lmireu {b: setvar} (ph: wff) (A2 D P G: class) (I: class b) (L M: class) (c_mi: class b):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wceq M (cfv D (cfv G clmi)) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wreu b (wceq (cfv (cv b) M) A2) P) $;

--| Equality deduction for line mirroring. Theorem 10.7 of [Schwabhauser] p. 89. (Contributed by Thierry Arnoux, 11-Dec-2019.)
theorem lmieq (ph: wff) (A2 B2 D P G I L M c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wceq M (cfv D (cfv G clmi)) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wceq (cfv A2 M) (cfv B2 M)) $ >
  $ wi ph (wceq A2 B2) $;

--| The invariants of the line mirroring lie on the mirror line. Theorem 10.8 of [Schwabhauser] p. 89. (Contributed by Thierry Arnoux, 11-Dec-2019.)
theorem lmiinv (ph: wff) (A2 D P G I L M c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wceq M (cfv D (cfv G clmi)) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wb (wceq (cfv A2 M) A2) (wcel A2 D)) $;

--| The mirroring line is an invariant. (Contributed by Thierry Arnoux, 8-Aug-2020.)
theorem lmicinv (ph: wff) (A2 D P G I L M c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wceq M (cfv D (cfv G clmi)) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel A2 D) $ >
  $ wi ph (wceq (cfv A2 M) A2) $;

--| If we have a right angle, then the mirror point is the point inversion. (Contributed by Thierry Arnoux, 15-Dec-2019.)
theorem lmimid (ph: wff) (A2 B2 C D P S G I L M c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wceq M (cfv D (cfv G clmi)) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wceq S (cfv B2 (cfv G cmir)) $ >
  $ wi ph (wcel (cs3 A2 B2 C) (cfv G crag)) $ >
  $ wi ph (wcel A2 D) $ >
  $ wi ph (wcel B2 D) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wceq (cfv C M) (cfv C S)) $;

--| The line mirroring function ` M ` is a bijection. Theorem 10.9 of [Schwabhauser] p. 89. (Contributed by Thierry Arnoux, 11-Dec-2019.)
theorem lmif1o (ph: wff) (D P G I L M c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wceq M (cfv D (cfv G clmi)) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wf1o P P M) $;

--| Lemma for ~ lmiiso . (Contributed by Thierry Arnoux, 14-Dec-2019.)
theorem lmiisolem (ph: wff) (A2 B2 D P S G I L M c_mi Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wceq M (cfv D (cfv G clmi)) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wceq S (cfv Z (cfv G cmir)) $ >
  $ wceq Z (co (co A2 (cfv A2 M) (cfv G cmid)) (co B2 (cfv B2 M) (cfv G cmid)) (cfv G cmid)) $ >
  $ wi ph (wceq (co (cfv A2 M) (cfv B2 M) c_mi) (co A2 B2 c_mi)) $;

--| The line mirroring function is an isometry, i.e. it is conserves congruence. Because it is also a bijection, it is also a motion. Theorem 10.10 of [Schwabhauser] p. 89. (Contributed by Thierry Arnoux, 11-Dec-2019.)
theorem lmiiso (ph: wff) (A2 B2 D P G I L M c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wceq M (cfv D (cfv G clmi)) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wceq (co (cfv A2 M) (cfv B2 M) c_mi) (co A2 B2 c_mi)) $;

--| Line mirroring is a motion of the geometric space. Theorem 10.11 of [Schwabhauser] p. 90. (Contributed by Thierry Arnoux, 15-Dec-2019.)
theorem lmimot (ph: wff) (D P G I L M c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wceq M (cfv D (cfv G clmi)) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel M (co G G cismt)) $;

--| In a symmetrical quadrilateral, the midpoints of the diagonals coincide. Corollary of Lemma 7.21 of [Schwabhauser] p. 52. (Contributed by Thierry Arnoux, 20-Jul-2026.)
theorem symquadmid {t a b: setvar} (ph: wff a b) (P: class t) (G: class t a b) (I L: class t) (M: class a b) (c_mi O: class t a b) (W: class a b) (X: class) (Y: class a b) (Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq M (cfv G cmid) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P (co X Z L))) (wcel (cv b) (cdif P (co X Z L)))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) (co X Z L)))) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wn (wo (wcel X (co Y Z L)) (wceq Y Z))) $ >
  $ wi ph (wne Y W) $ >
  $ wi ph (wceq (co X Y c_mi) (co Z W c_mi)) $ >
  $ wi ph (wceq (co Y Z c_mi) (co W X c_mi)) $ >
  $ wi ph (wbr Y W O) $ >
  $ wi ph (wceq (co X Z M) (co Y W M)) $;

--| Lemma for ~ hypcgr , case where triangles share a cathetus. (Contributed by Thierry Arnoux, 15-Dec-2019.)
theorem hypcgrlem1 (ph: wff) (A2 B2 C D P S E F G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel (cs3 A2 B2 C) (cfv G crag)) $ >
  $ wi ph (wcel (cs3 D E F) (cfv G crag)) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co D E c_mi)) $ >
  $ wi ph (wceq (co B2 C c_mi) (co E F c_mi)) $ >
  $ wi ph (wceq B2 E) $ >
  $ wceq S (cfv (co (co A2 D (cfv G cmid)) B2 (cfv G clng)) (cfv G clmi)) $ >
  $ wi ph (wceq C F) $ >
  $ wi ph (wceq (co A2 C c_mi) (co D F c_mi)) $;

--| Lemma for ~ hypcgr , case where triangles share one vertex ` B ` . (Contributed by Thierry Arnoux, 16-Dec-2019.)
theorem hypcgrlem2 (ph: wff) (A2 B2 C D P S E F G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel (cs3 A2 B2 C) (cfv G crag)) $ >
  $ wi ph (wcel (cs3 D E F) (cfv G crag)) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co D E c_mi)) $ >
  $ wi ph (wceq (co B2 C c_mi) (co E F c_mi)) $ >
  $ wi ph (wceq B2 E) $ >
  $ wceq S (cfv (co (co C F (cfv G cmid)) B2 (cfv G clng)) (cfv G clmi)) $ >
  $ wi ph (wceq (co A2 C c_mi) (co D F c_mi)) $;

--| If the catheti of two right-angled triangles are congruent, so is their hypothenuse. Theorem 10.12 of [Schwabhauser] p. 91. (Contributed by Thierry Arnoux, 16-Dec-2019.)
theorem hypcgr (ph: wff) (A2 B2 C D P E F G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel (cs3 A2 B2 C) (cfv G crag)) $ >
  $ wi ph (wcel (cs3 D E F) (cfv G crag)) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co D E c_mi)) $ >
  $ wi ph (wceq (co B2 C c_mi) (co E F c_mi)) $ >
  $ wi ph (wceq (co A2 C c_mi) (co D F c_mi)) $;

--| Line mirroring produces points on the opposite side of the mirroring line. Theorem 10.14 of [Schwabhauser] p. 92. (Contributed by Thierry Arnoux, 2-Aug-2020.)
theorem lmiopp {t a b: setvar} (ph: wff) (A2 D P G I: class) (L: class t a b) (M c_mi: class) (O: class a b):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P D)) (wcel (cv b) (cdif P D))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) D))) $ >
  $ wceq M (cfv D (cfv G clmi)) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wn (wcel A2 D)) $ >
  $ wi ph (wbr A2 (cfv A2 M) O) $;

--| Existence of a perpendicular to a line ` L ` at a given point ` A ` . Theorem 10.15 of [Schwabhauser] p. 92. (Contributed by Thierry Arnoux, 2-Aug-2020.)
theorem lnperpex {t p a b: setvar} (ph: wff) (A2 D P Q G I L c_mi O: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P D)) (wcel (cv b) (cdif P D))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) D))) $ >
  $ wi ph (wcel A2 D) $ >
  $ wi ph (wcel Q P) $ >
  $ wi ph (wn (wcel Q D)) $ >
  $ wi ph (wrex p (wa (wbr D (co (cv p) A2 L) (cfv G cperpg)) (wbr (cv p) Q (cfv D (cfv G chpg)))) P) $;

--| Existence of a perpendicular to a line ` L ` at a given point ` A ` . Theorem 10.15 of [Schwabhauser] p. 92. (Contributed by Thierry Arnoux, 2-Aug-2020.)
theorem lnperpexs {p: setvar} (ph: wff) (A2 D P Q G L: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr G c2 cstrkgld) $ >
  $ wi ph (wcel D (crn L)) $ >
  $ wi ph (wcel A2 D) $ >
  $ wi ph (wcel Q P) $ >
  $ wi ph (wn (wcel Q D)) $ >
  $ wi ph (wrex p (wa (wbr D (co (cv p) A2 L) (cfv G cperpg)) (wbr (cv p) Q (cfv D (cfv G chpg)))) P) $;

--| Triangle construction: a copy of a given triangle can always be constructed in such a way that one side is lying on a half-line, and the third vertex is on a given half-plane: existence part. First part of Theorem 10.16 of [Schwabhauser] p. 92. (Contributed by Thierry Arnoux, 4-Aug-2020.)
theorem trgcopy {f2: setvar} (ph: wff) (A2 B2 C D P E F G I K L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wn (wo (wcel A2 (co B2 C L)) (wceq B2 C))) $ >
  $ wi ph (wn (wo (wcel D (co E F L)) (wceq E F))) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co D E c_mi)) $ >
  $ wi ph (wrex f2 (wa (wbr (cs3 A2 B2 C) (cs3 D E (cv f2)) (cfv G ccgrg)) (wbr (cv f2) F (cfv (co D E L) (cfv G chpg)))) P) $;

--| Lemma for ~ trgcopyeu . (Contributed by Thierry Arnoux, 8-Aug-2020.)
theorem trgcopyeulem {t a b: setvar} (ph: wff) (A2 B2 C D P E F G I: class) (K: class t b) (L c_mi O X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wn (wo (wcel A2 (co B2 C L)) (wceq B2 C))) $ >
  $ wi ph (wn (wo (wcel D (co E F L)) (wceq E F))) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co D E c_mi)) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P (co D E L))) (wcel (cv b) (cdif P (co D E L)))) (wrex t (wcel (cv t) (co (cv a) (cv b) I)) (co D E L)))) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E X) (cfv G ccgrg)) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E Y) (cfv G ccgrg)) $ >
  $ wi ph (wbr X F (cfv (co D E L) (cfv G chpg))) $ >
  $ wi ph (wbr Y F (cfv (co D E L) (cfv G chpg))) $ >
  $ wi ph (wceq X Y) $;

--| Triangle construction: a copy of a given triangle can always be constructed in such a way that one side is lying on a half-line, and the third vertex is on a given half-plane: uniqueness part. Second part of Theorem 10.16 of [Schwabhauser] p. 92. (Contributed by Thierry Arnoux, 8-Aug-2020.)
theorem trgcopyeu {f2: setvar} (ph: wff) (A2 B2 C D P E F G I K L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wn (wo (wcel A2 (co B2 C L)) (wceq B2 C))) $ >
  $ wi ph (wn (wo (wcel D (co E F L)) (wceq E F))) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co D E c_mi)) $ >
  $ wi ph (wreu f2 (wa (wbr (cs3 A2 B2 C) (cs3 D E (cv f2)) (cfv G ccgrg)) (wbr (cv f2) F (cfv (co D E L) (cfv G chpg)))) P) $;

--| Declare the constant for the congruence between angles relation.
term ccgra: class;

--| Define the congruence relation between angles. As for triangles we use "words of points". See ~ iscgra for a more human readable version. (Contributed by Thierry Arnoux, 30-Jul-2020.)
axiom df_cgra {x3 y1 g2 k p a b: setvar}:
  $ wceq ccgra (cmpt g2 cvv (copab a b (wsbc p (wsbc k (wa (wa (wcel (cv a) (co (cv p) (co cc0 c3 cfzo) cmap)) (wcel (cv b) (co (cv p) (co cc0 c3 cfzo) cmap))) (wrex x3 (wrex y1 (w3a (wbr (cv a) (cs3 (cv x3) (cfv c1 (cv b)) (cv y1)) (cfv (cv g2) ccgrg)) (wbr (cv x3) (cfv cc0 (cv b)) (cfv (cfv c1 (cv b)) (cv k))) (wbr (cv y1) (cfv c2 (cv b)) (cfv (cfv c1 (cv b)) (cv k)))) (cv p)) (cv p))) (cfv (cv g2) chlg)) (cfv (cv g2) cbs)))) $;

--| Property for two angles ABC and DEF to be congruent. This is a modified version of the definition 11.3 of [Schwabhauser] p. 95. where the number of constructed points has been reduced to two. We chose this version rather than the textbook version because it is shorter and therefore simpler to work with. Theorem ~ dfcgra2 shows that those definitions are indeed equivalent. (Contributed by Thierry Arnoux, 31-Jul-2020.)
theorem iscgra {x3 y1: setvar} (ph: wff) (A2 B2 C D P E F G I K: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wb (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) (wrex x3 (wrex y1 (w3a (wbr (cs3 A2 B2 C) (cs3 (cv x3) E (cv y1)) (cfv G ccgrg)) (wbr (cv x3) D (cfv E K)) (wbr (cv y1) F (cfv E K))) P) P)) $;

--| A special version of ~ iscgra where one distance is known to be equal. In this case, angle congruence can be written with only one quantifier. (Contributed by Thierry Arnoux, 9-Aug-2020.)
theorem iscgra1 {x3: setvar} (ph: wff) (A2 B2 C D P E F G I K: class) (c_mi: class x3):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wceq (co A2 B2 c_mi) (co D E c_mi)) $ >
  $ wi ph (wb (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) (wrex x3 (wa (wbr (cs3 A2 B2 C) (cs3 D E (cv x3)) (cfv G ccgrg)) (wbr (cv x3) F (cfv E K))) P)) $;

--| Sufficient conditions for angle congruence, deduction version. (Contributed by Thierry Arnoux, 1-Aug-2020.)
theorem iscgrad (ph: wff) (A2 B2 C D P E F G I K X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 X E Y) (cfv G ccgrg)) $ >
  $ wi ph (wbr X D (cfv E K)) $ >
  $ wi ph (wbr Y F (cfv E K)) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) $;

--| Angles imply inequality. (Contributed by Thierry Arnoux, 1-Aug-2020.)
theorem cgrane1 (ph: wff) (A2 B2 C D P E F G I K: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) $ >
  $ wi ph (wne A2 B2) $;

--| Angles imply inequality. (Contributed by Thierry Arnoux, 1-Aug-2020.)
theorem cgrane2 (ph: wff) (A2 B2 C D P E F G I K: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) $ >
  $ wi ph (wne B2 C) $;

--| Angles imply inequality. (Contributed by Thierry Arnoux, 1-Aug-2020.)
theorem cgrane3 (ph: wff) (A2 B2 C D P E F G I K: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) $ >
  $ wi ph (wne E D) $;

--| Angles imply inequality. (Contributed by Thierry Arnoux, 1-Aug-2020.)
theorem cgrane4 (ph: wff) (A2 B2 C D P E F G I K: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) $ >
  $ wi ph (wne E F) $;

--| Angle congruence is independent of the choice of points on the rays. Proposition 11.10 of [Schwabhauser] p. 95. (Contributed by Thierry Arnoux, 1-Aug-2020.)
theorem cgrahl1 (ph: wff) (A2 B2 C D P E F G I K X: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wbr X D (cfv E K)) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 X E F) (cfv G ccgra)) $;

--| Angle congruence is independent of the choice of points on the rays. Proposition 11.10 of [Schwabhauser] p. 95. (Contributed by Thierry Arnoux, 1-Aug-2020.)
theorem cgrahl2 (ph: wff) (A2 B2 C D P E F G I K X: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wbr X F (cfv E K)) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E X) (cfv G ccgra)) $;

--| First direction of proposition 11.4 of [Schwabhauser] p. 95. Again, this is "half" of the proposition, i.e. only two additional points are used, while Schwabhauser has four. (Contributed by Thierry Arnoux, 31-Jul-2020.)
theorem cgracgr (ph: wff) (A2 B2 C D P E F G I K c_mi X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) $ >
  $ wi ph (wcel X P) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wbr X A2 (cfv B2 K)) $ >
  $ wi ph (wbr Y C (cfv B2 K)) $ >
  $ wi ph (wceq (co B2 X c_mi) (co E D c_mi)) $ >
  $ wi ph (wceq (co B2 Y c_mi) (co E F c_mi)) $ >
  $ wi ph (wceq (co X Y c_mi) (co D F c_mi)) $;

--| Angle congruence is reflexive. Theorem 11.6 of [Schwabhauser] p. 96. (Contributed by Thierry Arnoux, 31-Jul-2020.)
theorem cgraid (ph: wff) (A2 B2 C P G I K: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wne B2 C) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 A2 B2 C) (cfv G ccgra)) $;

--| Swap rays in a congruence relation. Theorem 11.9 of [Schwabhauser] p. 96. (Contributed by Thierry Arnoux, 5-Mar-2020.)
theorem cgraswap (ph: wff) (A2 B2 C P G I K: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wne B2 C) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 C B2 A2) (cfv G ccgra)) $;

--| Triangle congruence implies angle congruence. This is a portion of CPCTC, focusing on a specific angle. (Contributed by Arnoux, 2-Aug-2020.)
theorem cgrcgra (ph: wff) (A2 B2 C D P E F G I K: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wne B2 C) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgrg)) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) $;

--| Angle congruence commutes. Theorem 11.7 of [Schwabhauser] p. 97. (Contributed by Thierry Arnoux, 5-Mar-2020.)
theorem cgracom (ph: wff) (A2 B2 C D P E F G I K: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) $ >
  $ wi ph (wbr (cs3 D E F) (cs3 A2 B2 C) (cfv G ccgra)) $;

--| Angle congruence is transitive. Theorem 11.8 of [Schwabhauser] p. 97. (Contributed by Thierry Arnoux, 5-Mar-2020.)
theorem cgratr (ph: wff) (A2 B2 C D P U E F G H I J K: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) $ >
  $ wi ph (wcel H P) $ >
  $ wi ph (wcel U P) $ >
  $ wi ph (wcel J P) $ >
  $ wi ph (wbr (cs3 D E F) (cs3 H U J) (cfv G ccgra)) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 H U J) (cfv G ccgra)) $;

--| Zero angles are congruent. Zero angles, that is, angles of degree zero, can be expressed by stating that points ` A ` and ` C ` are on the same ray starting at ` B ` , that is, ` A ( K `` B ) C ` . See also ~ flatcgra . (Contributed by Thierry Arnoux, 23-Aug-2026.)
theorem zerocgra (ph: wff) (A2 B2 C D P c_sm E F G K: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq c_sm (cfv G ccgra) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr A2 C (cfv B2 K)) $ >
  $ wi ph (wbr D F (cfv E K)) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) c_sm) $;

--| Flat angles are congruent. Flat angles, or straight angles, represent half a turn. They can be represented by points ` <" A B C "> ` where ` B ` is on the segment ` ( A I C ) ` . (Contributed by Thierry Arnoux, 13-Feb-2023.)
theorem flatcgra (ph: wff) (A2 B2 C D P E F G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel B2 (co A2 C I)) $ >
  $ wi ph (wcel E (co D F I)) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wne C B2) $ >
  $ wi ph (wne D E) $ >
  $ wi ph (wne F E) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) $;

--| Swap both side of angle congruence. (Contributed by Thierry Arnoux, 5-Oct-2020.)
theorem cgraswaplr (ph: wff) (A2 B2 C D P E F G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) $ >
  $ wi ph (wbr (cs3 C B2 A2) (cs3 F E D) (cfv G ccgra)) $;

--| Angle congruence preserves flat angles. Part of Theorem 11.21 of [Schwabhauser] p. 97. (Contributed by Thierry Arnoux, 9-Aug-2020.)
theorem cgrabtwn (ph: wff) (A2 B2 C D P E F G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) $ >
  $ wi ph (wcel B2 (co A2 C I)) $ >
  $ wi ph (wcel E (co D F I)) $;

--| Angle congruence preserves null angles. Part of Theorem 11.21 of [Schwabhauser] p. 97. (Contributed by Thierry Arnoux, 9-Aug-2020.)
theorem cgrahl (ph: wff) (A2 B2 C D P E F G I K c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wbr A2 C (cfv B2 K)) $ >
  $ wi ph (wbr D F (cfv E K)) $;

--| Angle congruence preserves colinearity. (Contributed by Thierry Arnoux, 9-Aug-2020.)
theorem cgracol (ph: wff) (A2 B2 C D P E F G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wo (wcel C (co A2 B2 L)) (wceq A2 B2)) $ >
  $ wi ph (wo (wcel F (co D E L)) (wceq D E)) $;

--| Angle congruence preserves non-colinearity. (Contributed by Thierry Arnoux, 9-Aug-2020.)
theorem cgrancol (ph: wff) (A2 B2 C D P E F G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wn (wo (wcel C (co A2 B2 L)) (wceq A2 B2))) $ >
  $ wi ph (wn (wo (wcel F (co D E L)) (wceq D E))) $;

--| This is the full statement of definition 11.2 of [Schwabhauser] p. 95. This proof serves to confirm that the definition we have chosen, ~ df-cgra is indeed equivalent to the textbook's definition. (Contributed by Thierry Arnoux, 2-Aug-2020.)
theorem dfcgra2 {f2 a c d: setvar} (ph: wff) (A2 B2 C D P E F G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wb (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) (w3a (wa (wne A2 B2) (wne C B2)) (wa (wne D E) (wne F E)) (wrex a (wrex c (wrex d (wrex f2 (w3a (wa (wa (wcel A2 (co B2 (cv a) I)) (wceq (co A2 (cv a) c_mi) (co E D c_mi))) (wa (wcel C (co B2 (cv c) I)) (wceq (co C (cv c) c_mi) (co E F c_mi)))) (wa (wa (wcel D (co E (cv d) I)) (wceq (co D (cv d) c_mi) (co B2 A2 c_mi))) (wa (wcel F (co E (cv f2) I)) (wceq (co F (cv f2) c_mi) (co B2 C c_mi)))) (wceq (co (cv a) (cv c) c_mi) (co (cv d) (cv f2) c_mi))) P) P) P) P))) $;

--| Supplementary angles of congruent angles are themselves congruent. Theorem 11.13 of [Schwabhauser] p. 98. (Contributed by Thierry Arnoux, 30-Sep-2020.) (Proof shortened by Igor Ieskov, 16-Feb-2023.)
theorem sacgr (ph: wff) (A2 B2 C D P E F G I c_mi X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgra)) $ >
  $ wi ph (wcel B2 (co A2 X I)) $ >
  $ wi ph (wcel E (co D Y I)) $ >
  $ wi ph (wne B2 X) $ >
  $ wi ph (wne E Y) $ >
  $ wi ph (wbr (cs3 X B2 C) (cs3 Y E F) (cfv G ccgra)) $;

--| Vertical angle theorem. Vertical, or opposite angles are the facing pair of angles formed when two lines intersect. Eudemus of Rhodes attributed the proof to Thales of Miletus. The proposition showed that since both of a pair of vertical angles are supplementary to both of the adjacent angles, the vertical angles are equal in measure. We follow the same path. Theorem 11.14 of [Schwabhauser] p. 98. (Contributed by Thierry Arnoux, 27-Sep-2020.)
theorem oacgr (ph: wff) (A2 B2 C D P E F G I c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel B2 (co A2 D I)) $ >
  $ wi ph (wcel B2 (co C F I)) $ >
  $ wi ph (wne B2 A2) $ >
  $ wi ph (wne B2 C) $ >
  $ wi ph (wne B2 D) $ >
  $ wi ph (wne B2 F) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D B2 F) (cfv G ccgra)) $;

--| Angle construction. Theorem 11.15 of [Schwabhauser] p. 98. This is Hilbert's axiom III.4 for geometry. (Contributed by Thierry Arnoux, 9-Aug-2020.)
theorem acopy {f2: setvar} (ph: wff) (A2 B2 C D P E F G I L c_mi: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wn (wo (wcel A2 (co B2 C L)) (wceq B2 C))) $ >
  $ wi ph (wn (wo (wcel D (co E F L)) (wceq E F))) $ >
  $ wi ph (wrex f2 (wa (wbr (cs3 A2 B2 C) (cs3 D E (cv f2)) (cfv G ccgra)) (wbr (cv f2) F (cfv (co D E L) (cfv G chpg)))) P) $;

--| Angle construction. Theorem 11.15 of [Schwabhauser] p. 98. This is Hilbert's axiom III.4 for geometry. Akin to a uniqueness theorem, this states that if two points ` X ` and ` Y ` both fulfill the conditions, then they are on the same half-line. (Contributed by Thierry Arnoux, 9-Aug-2020.)
theorem acopyeu (ph: wff) (A2 B2 C D P E F G I K L c_mi X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wn (wo (wcel A2 (co B2 C L)) (wceq B2 C))) $ >
  $ wi ph (wn (wo (wcel D (co E F L)) (wceq E F))) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E X) (cfv G ccgra)) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E Y) (cfv G ccgra)) $ >
  $ wi ph (wbr X F (cfv (co D E L) (cfv G chpg))) $ >
  $ wi ph (wbr Y F (cfv (co D E L) (cfv G chpg))) $ >
  $ wi ph (wbr X Y (cfv E K)) $;

--| Right angles are congruent with each other. Theorem 11.16 of [Schwabhauser] p. 98. (Contributed by Thierry Arnoux, 5-Jul-2026.)
theorem ragcgra (ph: wff) (A2 B2 C P G X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel (cs3 X Y Z) (cfv G crag)) $ >
  $ wi ph (wcel (cs3 A2 B2 C) (cfv G crag)) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wne B2 C) $ >
  $ wi ph (wne X Y) $ >
  $ wi ph (wne Y Z) $ >
  $ wi ph (wbr (cs3 X Y Z) (cs3 A2 B2 C) (cfv G ccgra)) $;

--| Any angle ` <" A B C "> ` congruent with a right angle ` <" X Y Z "> ` is a right angle. Theorem 11.17 of [Schwabhauser] p. 98. (Contributed by Thierry Arnoux, 13-Jul-2026.)
theorem cgrarag (ph: wff) (A2 B2 C P G X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel (cs3 X Y Z) (cfv G crag)) $ >
  $ wi ph (wbr (cs3 X Y Z) (cs3 A2 B2 C) (cfv G ccgra)) $ >
  $ wi ph (wcel (cs3 A2 B2 C) (cfv G crag)) $;

--| An angle ` <" X Y Z "> ` is a right angle exactly when it is congruent to its supplementary angle ` <" X Y W "> ` . Theorem 11.18 of [Schwabhauser] p. 98. (Contributed by Thierry Arnoux, 13-Jul-2026.)
theorem ragsupplcgra (ph: wff) (P G I W X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X (cdif P (csn Y))) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z (cdif P (csn Y))) $ >
  $ wi ph (wcel W (cdif P (csn Y))) $ >
  $ wi ph (wcel Y (co Z W I)) $ >
  $ wi ph (wb (wcel (cs3 X Y Z) (cfv G crag)) (wbr (cs3 X Y Z) (cs3 X Y W) (cfv G ccgra))) $;

--| Drawing two right angles at a point ` X ` on the same side of a line ` ( X L Y ) ` leads to points ` W ` and ` Z ` on the same ray from ` X ` . Theorem 11.19 of [Schwabhauser] p. 99. (Contributed by Thierry Arnoux, 5-Jul-2026.)
theorem ragraghl (ph: wff) (P G L W X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wne X Y) $ >
  $ wi ph (wcel (cs3 Y X Z) (cfv G crag)) $ >
  $ wi ph (wcel (cs3 Y X W) (cfv G crag)) $ >
  $ wi ph (wbr Z W (cfv (co Y X L) (cfv G chpg))) $ >
  $ wi ph (wbr Z W (cfv X (cfv G chlg))) $;

--| Lemma for ~ perpeq . (Contributed by Thierry Arnoux, 5-Jul-2026.)
theorem perpeqlem (ph: wff) (A2 P E G H L X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel H (crn E)) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wss A2 H) $ >
  $ wi ph (wcel Y H) $ >
  $ wi ph (wcel Z H) $ >
  $ wi ph (wbr (co X Y L) A2 (cfv G cperpg)) $ >
  $ wi ph (wbr (co X Z L) A2 (cfv G cperpg)) $ >
  $ wi ph (wbr Y Z (cfv A2 (cfv G chpg))) $ >
  $ wi ph (wceq (co X Y L) (co X Z L)) $;

--| Uniqueness of the perpendicular to a line ` A ` within a plane ` H ` at a point ` X ` . Theorem 11.20 of [Schwabhauser] p. 99. (Contributed by Thierry Arnoux, 5-Jul-2026.)
theorem perpeq (ph: wff) (A2 P E G H L X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq E (cfv G cplng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 (crn L)) $ >
  $ wi ph (wcel H (crn E)) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wss A2 H) $ >
  $ wi ph (wcel Y H) $ >
  $ wi ph (wcel Z H) $ >
  $ wi ph (wbr (co X Y L) A2 (cfv G cperpg)) $ >
  $ wi ph (wbr (co X Z L) A2 (cfv G cperpg)) $ >
  $ wi ph (wceq (co X Y L) (co X Z L)) $;

--| Lemma for ~ tgaaddcpbl . (Contributed by Thierry Arnoux, 2-Aug-2026.)
theorem tgaaddcpbllem1 {t s1 a b c d: setvar} (ph: wff a b c d) (P: class) (Q: class s1 a b) (c_sm: class a b c d) (R: class s1 a b c d) (S: class c d) (T: class s1 a b) (U G: class a b) (I: class) (K: class s1 a b c d) (L: class) (O: class t a b c d) (V: class a b) (W X: class a b c d) (Y: class c d) (Z: class a b c d):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq c_sm (cfv G ccgra) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P (co Y S L))) (wcel (cv b) (cdif P (co Y S L)))) (wrex s1 (wcel (cv s1) (co (cv a) (cv b) I)) (co Y S L)))) $ >
  $ wceq Q (copab c d (wa (wa (wcel (cv c) (cdif P (co V T L))) (wcel (cv d) (cdif P (co V T L)))) (wrex t (wcel (cv t) (co (cv c) (cv d) I)) (co V T L)))) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel S P) $ >
  $ wi ph (wcel T P) $ >
  $ wi ph (wcel U P) $ >
  $ wi ph (wcel V P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wne Y S) $ >
  $ wi ph (wne V T) $ >
  $ wi ph (wbr X Z O) $ >
  $ wi ph (wbr U W Q) $ >
  $ wi ph (wbr (cs3 X Y S) (cs3 U V T) c_sm) $ >
  $ wi ph (wbr (cs3 S Y Z) (cs3 T V W) c_sm) $ >
  $ wi ph (wn (wcel Y (co X Z I))) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel R (co Y S L)) $ >
  $ wi ph (wcel R (co X Z I)) $ >
  $ wi ph (wbr R S (cfv Y K)) $ >
  $ wi ph (wbr (cs3 X Y Z) (cs3 U V W) c_sm) $;

--| Lemma for ~ tgaaddcpbl . (Contributed by Thierry Arnoux, 2-Aug-2026.)
theorem tgaaddcpbllem2 {t s1 a b c d: setvar} (ph: wff a b) (P: class) (Q: class s1 a b) (c_sm: class a b c d) (R S: class c d) (T: class s1) (U G: class a b) (I: class) (K: class s1 a b c d) (L: class) (M: class s1) (O: class t a b c d) (V: class) (W X: class a b c d) (Y: class c d) (Z: class a b c d):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq c_sm (cfv G ccgra) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P (co Y S L))) (wcel (cv b) (cdif P (co Y S L)))) (wrex s1 (wcel (cv s1) (co (cv a) (cv b) I)) (co Y S L)))) $ >
  $ wceq Q (copab c d (wa (wa (wcel (cv c) (cdif P (co V T L))) (wcel (cv d) (cdif P (co V T L)))) (wrex t (wcel (cv t) (co (cv c) (cv d) I)) (co V T L)))) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel S P) $ >
  $ wi ph (wcel T P) $ >
  $ wi ph (wcel U P) $ >
  $ wi ph (wcel V P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wne Y S) $ >
  $ wi ph (wne V T) $ >
  $ wi ph (wbr X Z O) $ >
  $ wi ph (wbr U W Q) $ >
  $ wi ph (wbr (cs3 X Y S) (cs3 U V T) c_sm) $ >
  $ wi ph (wbr (cs3 S Y Z) (cs3 T V W) c_sm) $ >
  $ wi ph (wn (wcel Y (co X Z I))) $ >
  $ wi ph (wcel R (co Y S L)) $ >
  $ wi ph (wcel R (co X Z I)) $ >
  $ wi ph (wcel Y (co S R I)) $ >
  $ wceq M (cfv V (cfv G cmir)) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wbr (cs3 X Y Z) (cs3 U V W) c_sm) $;

--| Lemma for ~ tgaaddcpbl . (Contributed by Thierry Arnoux, 2-Aug-2026.)
theorem tgaaddcpbllem3 {t s1 a b c d: setvar} (ph: wff a b) (P: class) (Q: class s1 a b) (c_sm: class a b c d) (S: class) (T: class s1) (U: class a b) (G I L: class) (O: class t a b c d) (V: class) (W: class a b c d) (X: class a b) (Y: class) (Z: class a b):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq c_sm (cfv G ccgra) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P (co Y S L))) (wcel (cv b) (cdif P (co Y S L)))) (wrex s1 (wcel (cv s1) (co (cv a) (cv b) I)) (co Y S L)))) $ >
  $ wceq Q (copab c d (wa (wa (wcel (cv c) (cdif P (co V T L))) (wcel (cv d) (cdif P (co V T L)))) (wrex t (wcel (cv t) (co (cv c) (cv d) I)) (co V T L)))) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel S P) $ >
  $ wi ph (wcel T P) $ >
  $ wi ph (wcel U P) $ >
  $ wi ph (wcel V P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wne Y S) $ >
  $ wi ph (wne V T) $ >
  $ wi ph (wbr X Z O) $ >
  $ wi ph (wbr U W Q) $ >
  $ wi ph (wbr (cs3 X Y S) (cs3 U V T) c_sm) $ >
  $ wi ph (wbr (cs3 S Y Z) (cs3 T V W) c_sm) $ >
  $ wi ph (wn (wcel Y (co X Z I))) $ >
  $ wi ph (wbr (cs3 X Y Z) (cs3 U V W) c_sm) $;

--| The angular addition is compatible with angle congruence: by adding congruent angles together, we obtain congruent angles. Theorem 11.22 of [Schwabhauser] p. 99. The angles ` <" X Y S "> ` and ` <" S Y Z "> ` are added to result in ` <" X Y Z "> ` , and ` <" U V T "> ` and ` <" T V W "> ` are added to result in ` <" U V W "> ` . (Contributed by Thierry Arnoux, 2-Aug-2026.)
theorem tgaaddcpbl {t s1 a b c d: setvar} (ph: wff a b) (P: class) (Q: class s1 a b) (c_sm: class a b c d) (S: class) (T: class s1) (U: class a b) (G I L: class) (O: class t a b c d) (V: class) (W X: class a b) (Y: class) (Z: class a b):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq c_sm (cfv G ccgra) $ >
  $ wceq O (copab a b (wa (wa (wcel (cv a) (cdif P (co Y S L))) (wcel (cv b) (cdif P (co Y S L)))) (wrex s1 (wcel (cv s1) (co (cv a) (cv b) I)) (co Y S L)))) $ >
  $ wceq Q (copab c d (wa (wa (wcel (cv c) (cdif P (co V T L))) (wcel (cv d) (cdif P (co V T L)))) (wrex t (wcel (cv t) (co (cv c) (cv d) I)) (co V T L)))) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel S P) $ >
  $ wi ph (wcel T P) $ >
  $ wi ph (wcel U P) $ >
  $ wi ph (wcel V P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wne Y S) $ >
  $ wi ph (wne V T) $ >
  $ wi ph (wbr X Z O) $ >
  $ wi ph (wbr U W Q) $ >
  $ wi ph (wbr (cs3 X Y S) (cs3 U V T) c_sm) $ >
  $ wi ph (wbr (cs3 S Y Z) (cs3 T V W) c_sm) $ >
  $ wi ph (wbr (cs3 X Y Z) (cs3 U V W) c_sm) $;

--| The angular addition is compatible with angle congruence: by adding congruent angles together, we obtain congruent angles. Compared with ~ tgaaddcpbl , this version handles cases where ` U ` , ` V ` and ` W ` are aligned. (Contributed by Thierry Arnoux, 23-Aug-2026.)
theorem tgaaddcpbl2 (ph: wff) (P c_sm S T U G I L V W X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq L (cfv G clng) $ >
  $ wceq c_sm (cfv G ccgra) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel S P) $ >
  $ wi ph (wcel T P) $ >
  $ wi ph (wcel U P) $ >
  $ wi ph (wcel V P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wne Y S) $ >
  $ wi ph (wne V T) $ >
  $ wi ph (wne (cin (co Y S L) (co X Z I)) c0) $ >
  $ wi ph (wne (cin (co V T L) (co U W I)) c0) $ >
  $ wi ph (wbr (cs3 X Y S) (cs3 U V T) c_sm) $ >
  $ wi ph (wbr (cs3 S Y Z) (cs3 T V W) c_sm) $ >
  $ wi ph (wbr (cs3 X Y Z) (cs3 U V W) c_sm) $;

--| Extend class relation with the geometrical "point in angle" relation.
term cinag: class;

--| Extend class relation with the "angle less than" relation.
term cleag: class;

--| Definition of the geometrical "in angle" relation. (Contributed by Thierry Arnoux, 15-Aug-2020.)
axiom df_inag {x3 t g2 p: setvar}:
  $ wceq cinag (cmpt g2 cvv (copab p t (wa (wa (wcel (cv p) (cfv (cv g2) cbs)) (wcel (cv t) (co (cfv (cv g2) cbs) (co cc0 c3 cfzo) cmap))) (wa (w3a (wne (cfv cc0 (cv t)) (cfv c1 (cv t))) (wne (cfv c2 (cv t)) (cfv c1 (cv t))) (wne (cv p) (cfv c1 (cv t)))) (wrex x3 (wa (wcel (cv x3) (co (cfv cc0 (cv t)) (cfv c2 (cv t)) (cfv (cv g2) citv))) (wo (wceq (cv x3) (cfv c1 (cv t))) (wbr (cv x3) (cv p) (cfv (cfv c1 (cv t)) (cfv (cv g2) chlg))))) (cfv (cv g2) cbs)))))) $;

--| Property for point ` X ` to lie in the angle ` <" A B C "> ` . Definition 11.23 of [Schwabhauser] p. 101. (Contributed by Thierry Arnoux, 15-Aug-2020.)
theorem isinag {x3: setvar} (ph: wff) (A2 B2 C P G: class) (I K V: class x3) (X: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wb (wbr X (cs3 A2 B2 C) (cfv G cinag)) (wa (w3a (wne A2 B2) (wne C B2) (wne X B2)) (wrex x3 (wa (wcel (cv x3) (co A2 C I)) (wo (wceq (cv x3) B2) (wbr (cv x3) X (cfv B2 K)))) P))) $;

--| Sufficient conditions for in-angle relation, deduction version. (Contributed by Thierry Arnoux, 20-Oct-2020.)
theorem isinagd (ph: wff) (A2 B2 C P G I K V X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel G V) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wne C B2) $ >
  $ wi ph (wne X B2) $ >
  $ wi ph (wcel Y (co A2 C I)) $ >
  $ wi ph (wo (wceq Y B2) (wbr Y X (cfv B2 K))) $ >
  $ wi ph (wbr X (cs3 A2 B2 C) (cfv G cinag)) $;

--| Any point lies in a flat angle. (Contributed by Thierry Arnoux, 13-Feb-2023.)
theorem inagflat (ph: wff) (A2 B2 C P G I K X: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wne C B2) $ >
  $ wi ph (wne X B2) $ >
  $ wi ph (wcel B2 (co A2 C I)) $ >
  $ wi ph (wbr X (cs3 A2 B2 C) (cfv G cinag)) $;

--| Swap the order of the half lines delimiting the angle. Theorem 11.24 of [Schwabhauser] p. 101. (Contributed by Thierry Arnoux, 15-Aug-2020.)
theorem inagswap (ph: wff) (A2 B2 C P G I K X: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr X (cs3 A2 B2 C) (cfv G cinag)) $ >
  $ wi ph (wbr X (cs3 C B2 A2) (cfv G cinag)) $;

--| Deduce inequality from the in-angle relation. (Contributed by Thierry Arnoux, 29-Oct-2021.)
theorem inagne1 (ph: wff) (A2 B2 C P G I K X: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr X (cs3 A2 B2 C) (cfv G cinag)) $ >
  $ wi ph (wne A2 B2) $;

--| Deduce inequality from the in-angle relation. (Contributed by Thierry Arnoux, 29-Oct-2021.)
theorem inagne2 (ph: wff) (A2 B2 C P G I K X: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr X (cs3 A2 B2 C) (cfv G cinag)) $ >
  $ wi ph (wne C B2) $;

--| Deduce inequality from the in-angle relation. (Contributed by Thierry Arnoux, 29-Oct-2021.)
theorem inagne3 (ph: wff) (A2 B2 C P G I K X: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr X (cs3 A2 B2 C) (cfv G cinag)) $ >
  $ wi ph (wne X B2) $;

--| The "point lie in angle" relation is independent of the points chosen on the half lines starting from ` B ` . Theorem 11.25 of [Schwabhauser] p. 101. (Contributed by Thierry Arnoux, 27-Sep-2020.)
theorem inaghl (ph: wff) (A2 B2 C D P F G I K X Y: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq K (cfv G chlg) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wbr X (cs3 A2 B2 C) (cfv G cinag)) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wbr D A2 (cfv B2 K)) $ >
  $ wi ph (wbr F C (cfv B2 K)) $ >
  $ wi ph (wbr Y X (cfv B2 K)) $ >
  $ wi ph (wbr Y (cs3 D B2 F) (cfv G cinag)) $;

--| Definition of the geometrical "angle less than" relation. Definition 11.27 of [Schwabhauser] p. 102. (Contributed by Thierry Arnoux, 7-Oct-2020.)
axiom df_leag {x3 g2 a b: setvar}:
  $ wceq cleag (cmpt g2 cvv (copab a b (wa (wa (wcel (cv a) (co (cfv (cv g2) cbs) (co cc0 c3 cfzo) cmap)) (wcel (cv b) (co (cfv (cv g2) cbs) (co cc0 c3 cfzo) cmap))) (wrex x3 (wa (wbr (cv x3) (cs3 (cfv cc0 (cv b)) (cfv c1 (cv b)) (cfv c2 (cv b))) (cfv (cv g2) cinag)) (wbr (cs3 (cfv cc0 (cv a)) (cfv c1 (cv a)) (cfv c2 (cv a))) (cs3 (cfv cc0 (cv b)) (cfv c1 (cv b)) (cv x3)) (cfv (cv g2) ccgra))) (cfv (cv g2) cbs))))) $;

--| Geometrical "less than" property for angles. Definition 11.27 of [Schwabhauser] p. 102. (Contributed by Thierry Arnoux, 7-Oct-2020.)
theorem isleag {x3: setvar} (ph: wff) (A2 B2 C D P E F G: class):
  $ wceq P (cfv G cbs) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wb (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G cleag)) (wrex x3 (wa (wbr (cv x3) (cs3 D E F) (cfv G cinag)) (wbr (cs3 A2 B2 C) (cs3 D E (cv x3)) (cfv G ccgra))) P)) $;

--| Sufficient condition for "less than" angle relation, deduction version (Contributed by Thierry Arnoux, 12-Oct-2020.)
theorem isleagd (ph: wff) (A2 B2 C D P E F G c_le X: class):
  $ wceq P (cfv G cbs) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wceq c_le (cfv G cleag) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wbr X (cs3 D E F) (cfv G cinag)) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E X) (cfv G ccgra)) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) c_le) $;

--| Deduce inequality from the less-than angle relation. (Contributed by Thierry Arnoux, 25-Feb-2023.)
theorem leagne1 (ph: wff) (A2 B2 C D P E F G: class):
  $ wceq P (cfv G cbs) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G cleag)) $ >
  $ wi ph (wne A2 B2) $;

--| Deduce inequality from the less-than angle relation. (Contributed by Thierry Arnoux, 25-Feb-2023.)
theorem leagne2 (ph: wff) (A2 B2 C D P E F G: class):
  $ wceq P (cfv G cbs) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G cleag)) $ >
  $ wi ph (wne C B2) $;

--| Deduce inequality from the less-than angle relation. (Contributed by Thierry Arnoux, 25-Feb-2023.)
theorem leagne3 (ph: wff) (A2 B2 C D P E F G: class):
  $ wceq P (cfv G cbs) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G cleag)) $ >
  $ wi ph (wne D E) $;

--| Deduce inequality from the less-than angle relation. (Contributed by Thierry Arnoux, 25-Feb-2023.)
theorem leagne4 (ph: wff) (A2 B2 C D P E F G: class):
  $ wceq P (cfv G cbs) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G cleag)) $ >
  $ wi ph (wne F E) $;

--| Lemma 11.28 of [Schwabhauser] p. 102. Extend a congruence of three points with a fourth colinear point. (Contributed by Thierry Arnoux, 8-Oct-2020.)
theorem cgrg3col4 {y1: setvar} (ph: wff) (A2 B2 C D P E F G L X: class):
  $ wceq P (cfv G cbs) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel A2 P) $ >
  $ wi ph (wcel B2 P) $ >
  $ wi ph (wcel C P) $ >
  $ wi ph (wcel D P) $ >
  $ wi ph (wcel E P) $ >
  $ wi ph (wcel F P) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wbr (cs3 A2 B2 C) (cs3 D E F) (cfv G ccgrg)) $ >
  $ wi ph (wo (wcel X (co A2 C L)) (wceq A2 C)) $ >
  $ wi ph (wrex y1 (wbr (cs4 A2 B2 C X) (cs4 D E F (cv y1)) (cfv G ccgrg)) P) $;

--| Extend class relation with the "angle addition" magma.
term cangmgm: class;

--| Definition of the angle addition magma. See following theorems for better readable properties. Because the textbook's definition of angle congruence does not consider orientation (cf. ~ cgraswap ) , our notion of angle does not include reflex angles (angles larger than a straight angle). Therefore, like with ` NN0 ` , at this point, we can only build a _magma_ , which is e.g. _not_ isomorphic with the rotation group SO(2) . (Contributed by Thierry Arnoux, 20-Jul-2026.)
axiom df_angmgm {z e f2 g2 p a d: setvar}:
  $ wceq cangmgm (cmpt g2 cvv (csb p (cfv (cv g2) cbs) (csb a (crab d (wa (wne (cfv cc0 (cv d)) (cfv c1 (cv d))) (wne (cfv c1 (cv d)) (cfv c2 (cv d)))) (co (cv p) (co cc0 c3 cfzo) cmap)) (co (ctp (cop (cfv cnx cbs) (cv a)) (cop (cfv cnx cplusg) (cmpo e f2 (cv a) (cv a) (cif (wcel (cfv cc0 (cv e)) (co (cfv c1 (cv e)) (cfv c2 (cv e)) (cfv (cv g2) clng))) (cs3 (cfv cc0 (cv f2)) (cfv c1 (cv f2)) (crio z (wa (wbr (cs3 (cfv c2 (cv f2)) (cfv c1 (cv f2)) (cv z)) (cv e) (cfv (cv g2) ccgra)) (wceq (co (cfv c1 (cv f2)) (cv z) (cfv (cv g2) cds)) (co (cfv c1 (cv e)) (cfv cc0 (cv e)) (cfv (cv g2) cds)))) (cv p))) (cs3 (cfv cc0 (cv e)) (cfv c1 (cv e)) (crio z (w3a (wbr (cs3 (cfv c2 (cv e)) (cfv c1 (cv e)) (cv z)) (cv f2) (cfv (cv g2) ccgra)) (wceq (co (cfv c1 (cv e)) (cv z) (cfv (cv g2) cds)) (co (cfv c1 (cv f2)) (cfv cc0 (cv f2)) (cfv (cv g2) cds))) (wne (cin (co (cfv c1 (cv e)) (cfv c2 (cv e)) (cfv (cv g2) clng)) (co (cv z) (cfv cc0 (cv e)) (cfv (cv g2) citv))) c0)) (cv p)))))) (cop (cfv cnx cple) (cfv (cv g2) cleag))) (cfv (cv g2) ccgra) cqus)))) $;

--| Helper theorem for the membership in the base set of the angle addition monoid. (Contributed by Thierry Arnoux, 23-Aug-2026.)
theorem elcgrabasi {x3 y1 z d: setvar} (ph: wff x3 y1 z d) (A2: class z d) (P E: class):
  $ wcel P cvv $ >
  $ wceq A2 (crab d (wa (wne (cfv cc0 (cv d)) (cfv c1 (cv d))) (wne (cfv c1 (cv d)) (cfv c2 (cv d)))) (co P (co cc0 c3 cfzo) cmap)) $ >
  $ wi ph (wcel E A2) $ >
  $ wi ph (wrex x3 (wrex y1 (wrex z (wa (wceq E (cs3 (cv x3) (cv y1) (cv z))) (wa (wne (cv x3) (cv y1)) (wne (cv y1) (cv z)))) P) P) P) $;

--| Helper theorem for the membership in the base set of the angle addition monoid. (Contributed by Thierry Arnoux, 23-Aug-2026.)
theorem elcgrabasrd {d: setvar} (ph: wff d) (A2: class d) (P: class) (V: class d) (X Y Z: class):
  $ wceq A2 (crab d (wa (wne (cfv cc0 (cv d)) (cfv c1 (cv d))) (wne (cfv c1 (cv d)) (cfv c2 (cv d)))) (co P (co cc0 c3 cfzo) cmap)) $ >
  $ wi ph (wcel P V) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wne X Y) $ >
  $ wi ph (wne Y Z) $ >
  $ wi ph (wcel (cs3 X Y Z) A2) $;

--| The angle congruence relation is an equivalence relation. (Contributed by Thierry Arnoux, 31-Aug-2026.)
theorem cgraer {d: setvar} (ph: wff d) (A2: class d) (P: class) (c_sm G: class d):
  $ wceq P (cfv G cbs) $ >
  $ wceq A2 (crab d (wa (wne (cfv cc0 (cv d)) (cfv c1 (cv d))) (wne (cfv c1 (cv d)) (cfv c2 (cv d)))) (co P (co cc0 c3 cfzo) cmap)) $ >
  $ wceq c_sm (cfv G ccgra) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wer A2 (cin c_sm (cxp A2 A2))) $;

--| The angle congruence relation is hereditary. (Contributed by Thierry Arnoux, 31-Aug-2026.)
theorem cgrabasimass {d: setvar} (ph: wff d) (A2: class d) (P: class) (c_sm G: class d):
  $ wceq P (cfv G cbs) $ >
  $ wceq A2 (crab d (wa (wne (cfv cc0 (cv d)) (cfv c1 (cv d))) (wne (cfv c1 (cv d)) (cfv c2 (cv d)))) (co P (co cc0 c3 cfzo) cmap)) $ >
  $ wceq c_sm (cfv G ccgra) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wss (cima c_sm A2) A2) $;

--| There exists a unique point ` s ` satisfying the conditions of angle addition. General case. (Contributed by Thierry Arnoux, 23-Aug-2026.)
theorem angmgmaddeu1 {s1 d: setvar} (ph: wff) (A2: class s1 d) (P: class) (c_sm: class s1 d) (U G I L c_mi V W X Y Z: class):
  $ wceq P (cfv G cbs) $ >
  $ wceq A2 (crab d (wa (wne (cfv cc0 (cv d)) (cfv c1 (cv d))) (wne (cfv c1 (cv d)) (cfv c2 (cv d)))) (co P (co cc0 c3 cfzo) cmap)) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq c_sm (cfv G ccgra) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel U P) $ >
  $ wi ph (wcel V P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wne U V) $ >
  $ wi ph (wne V W) $ >
  $ wi ph (wne X Y) $ >
  $ wi ph (wne Y Z) $ >
  $ wi ph (wn (wcel X (co Y Z L))) $ >
  $ wi ph (wn (wcel U (co V W L))) $ >
  $ wi ph (wreu s1 (w3a (wbr (cs3 Z Y (cv s1)) (cs3 U V W) c_sm) (wceq (co Y (cv s1) c_mi) (co V U c_mi)) (wne (cin (co Y Z L) (co (cv s1) X I)) c0)) P) $;

--| Existence of a unique point for building angle addition. Case where the second angle is a zero angle. (Contributed by Thierry Arnoux, 23-Aug-2026.)
theorem angmgmaddeu2 {s1 d: setvar} (ph: wff d) (A2: class s1 d) (P: class d) (c_sm: class s1 d) (U G I: class d) (L: class s1 d) (c_mi V W X Y Z: class d):
  $ wceq P (cfv G cbs) $ >
  $ wceq A2 (crab d (wa (wne (cfv cc0 (cv d)) (cfv c1 (cv d))) (wne (cfv c1 (cv d)) (cfv c2 (cv d)))) (co P (co cc0 c3 cfzo) cmap)) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq c_sm (cfv G ccgra) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel U P) $ >
  $ wi ph (wcel V P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wne U V) $ >
  $ wi ph (wne V W) $ >
  $ wi ph (wne X Y) $ >
  $ wi ph (wne Y Z) $ >
  $ wi ph (wn (wcel X (co Y Z L))) $ >
  $ wi ph (wbr U W (cfv V (cfv G chlg))) $ >
  $ wi ph (wreu s1 (w3a (wbr (cs3 Z Y (cv s1)) (cs3 U V W) c_sm) (wceq (co Y (cv s1) c_mi) (co V U c_mi)) (wne (cin (co Y Z L) (co (cv s1) X I)) c0)) P) $;

--| Existence of a unique point for building angle addition. Case where the second angle is a flat angle. (Contributed by Thierry Arnoux, 23-Aug-2026.)
theorem angmgmaddeu3 {s1 d: setvar} (ph: wff d) (A2: class s1 d) (P: class d) (c_sm: class s1 d) (U: class d) (G: class s1 d) (I: class d) (L: class s1 d) (c_mi V: class d) (W X: class s1 d) (Y Z: class d):
  $ wceq P (cfv G cbs) $ >
  $ wceq A2 (crab d (wa (wne (cfv cc0 (cv d)) (cfv c1 (cv d))) (wne (cfv c1 (cv d)) (cfv c2 (cv d)))) (co P (co cc0 c3 cfzo) cmap)) $ >
  $ wceq I (cfv G citv) $ >
  $ wceq c_mi (cfv G cds) $ >
  $ wceq c_sm (cfv G ccgra) $ >
  $ wceq L (cfv G clng) $ >
  $ wi ph (wcel G cstrkg) $ >
  $ wi ph (wcel U P) $ >
  $ wi ph (wcel V P) $ >
  $ wi ph (wcel W P) $ >
  $ wi ph (wcel X P) $ >
  $ wi ph (wcel Y P) $ >
  $ wi ph (wcel Z P) $ >
  $ wi ph (wne U V) $ >
  $ wi ph (wne V W) $ >
  $ wi ph (wne X Y) $ >
  $ wi ph (wne Y Z) $ >
  $ wi ph (wn (wcel X (co Y Z L))) $ >
  $ wi ph (wcel V (co U W I)) $ >
  $ wi ph (wreu s1 (w3a (wbr (cs3 Z Y (cv s1)) (cs3 U V W) c_sm) (wceq (co Y (cv s1) c_mi) (co V U c_mi)) (wne (cin (co Y Z L) (co (cv s1) X I)) c0)) P) $;

--| There exists a unique point ` s ` satisfying the conditions of angle addition. Case where both angles are zero angles. (Contributed by Thierry Arnoux, 23-Aug-2026.)

--| Lemma for ~ dath . The auxiliary axis of perspectivity ` B ` is a line (analogous to the actual axis of perspectivity ` X ` in ~ dalem15 . (Contributed by NM, 8-Aug-2012.)
theorem dalem53 {c d: setvar} (ph ps: wff c d) (A2 B2 C P Q R S T U G H I c_or K c_le c_an N O Y Z: class c d):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wb ps (w3a (wa (wcel (cv c) A2) (wcel (cv d) A2)) (wn (wbr (cv c) Y c_le)) (w3a (wne (cv d) (cv c)) (wn (wbr (cv d) Y c_le)) (wbr C (co (cv c) (cv d) c_or) c_le))) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq N (cfv K clln) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wceq Z (co (co S T c_or) U c_or) $ >
  $ wceq G (co (co (cv c) P c_or) (co (cv d) S c_or) c_an) $ >
  $ wceq H (co (co (cv c) Q c_or) (co (cv d) T c_or) c_an) $ >
  $ wceq I (co (co (cv c) R c_or) (co (cv d) U c_or) c_an) $ >
  $ wceq B2 (co (co (co G H c_or) I c_or) Y c_an) $ >
  $ wi (w3a ph (wceq Y Z) ps) (wcel B2 N) $;

--| Lemma for ~ dath . Line ` G H ` intersects the auxiliary axis of perspectivity ` B ` . (Contributed by NM, 8-Aug-2012.)
theorem dalem54 {c d: setvar} (ph ps: wff c d) (A2 B2 C P Q R S T U G H I c_or K c_le c_an O Y Z: class c d):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wb ps (w3a (wa (wcel (cv c) A2) (wcel (cv d) A2)) (wn (wbr (cv c) Y c_le)) (w3a (wne (cv d) (cv c)) (wn (wbr (cv d) Y c_le)) (wbr C (co (cv c) (cv d) c_or) c_le))) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wceq Z (co (co S T c_or) U c_or) $ >
  $ wceq G (co (co (cv c) P c_or) (co (cv d) S c_or) c_an) $ >
  $ wceq H (co (co (cv c) Q c_or) (co (cv d) T c_or) c_an) $ >
  $ wceq I (co (co (cv c) R c_or) (co (cv d) U c_or) c_an) $ >
  $ wceq B2 (co (co (co G H c_or) I c_or) Y c_an) $ >
  $ wi (w3a ph (wceq Y Z) ps) (wcel (co (co G H c_or) B2 c_an) A2) $;

--| Lemma for ~ dath . Lines ` G H ` and ` P Q ` intersect at the auxiliary line ` B ` (later shown to be an axis of perspectivity; see ~ dalem60 ). (Contributed by NM, 8-Aug-2012.)
theorem dalem55 {c d: setvar} (ph ps: wff c d) (A2 B2 C P Q R S T U G H I c_or K c_le c_an O Y Z: class c d):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wb ps (w3a (wa (wcel (cv c) A2) (wcel (cv d) A2)) (wn (wbr (cv c) Y c_le)) (w3a (wne (cv d) (cv c)) (wn (wbr (cv d) Y c_le)) (wbr C (co (cv c) (cv d) c_or) c_le))) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wceq Z (co (co S T c_or) U c_or) $ >
  $ wceq G (co (co (cv c) P c_or) (co (cv d) S c_or) c_an) $ >
  $ wceq H (co (co (cv c) Q c_or) (co (cv d) T c_or) c_an) $ >
  $ wceq I (co (co (cv c) R c_or) (co (cv d) U c_or) c_an) $ >
  $ wceq B2 (co (co (co G H c_or) I c_or) Y c_an) $ >
  $ wi (w3a ph (wceq Y Z) ps) (wceq (co (co G H c_or) (co P Q c_or) c_an) (co (co G H c_or) B2 c_an)) $;


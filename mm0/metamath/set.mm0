  $ wi (w3a (wcel K chlt) (wcel P A2) (wcel Q A2)) (wn (wcel (co P Q c_or) V)) $;

--| No lattice volume is an atom. (Contributed by NM, 15-Jul-2012.) (New usage is discouraged.)
theorem lvolneatN (A2 K V X: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq V (cfv K clvol) $ >
  $ wi (wa (wcel K chlt) (wcel X V)) (wn (wcel X A2)) $;

--| No lattice volume is a lattice line. (Contributed by NM, 15-Jul-2012.)
theorem lvolnelln (K N V X: class):
  $ wceq N (cfv K clln) $ >
  $ wceq V (cfv K clvol) $ >
  $ wi (wa (wcel K chlt) (wcel X V)) (wn (wcel X N)) $;

--| No lattice volume is a lattice plane. (Contributed by NM, 19-Jun-2012.)
theorem lvolnelpln (P K V X: class):
  $ wceq P (cfv K clpl) $ >
  $ wceq V (cfv K clvol) $ >
  $ wi (wa (wcel K chlt) (wcel X V)) (wn (wcel X P)) $;

--| A lattice volume is nonzero. (Contributed by NM, 17-Jul-2012.) (New usage is discouraged.)
theorem lvoln0N (K V X c_0: class):
  $ wceq c_0 (cfv K cp0) $ >
  $ wceq V (cfv K clvol) $ >
  $ wi (wa (wcel K chlt) (wcel X V)) (wne X c_0) $;


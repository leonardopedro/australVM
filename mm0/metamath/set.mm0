--| Bounding law from above for the surreal infimum. Analagous to proposition 4.2 of [Lipparini] p. 6. (Contributed by Scott Fenton, 9-Aug-2024.)
theorem noinfbnd1 {x3 y1 v u g2: setvar} (B2: class) (T: class x3 y1 v u g2) (U: class u g2) (V: class y1 v u):
  $ wceq T (cif (wrex x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2) (cun (crio x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2)) c1o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv u) (cv v) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) B2)) B2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv u) (cv v) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) B2) (wceq (cfv (cv g2) (cv u)) (cv x3))) B2)))) $ >
  $ wi (w3a (wss B2 csur) (wcel B2 V) (wcel U B2)) (wbr T (cres U (cdm T)) clts) $;

--| Bounding law from below when a set of surreals has a minimum. (Contributed by Scott Fenton, 9-Aug-2024.)
theorem noinfbnd2lem1 {y1 b: setvar} (B2 U: class y1) (V: class y1 b) (Z: class y1):
  $ wi (w3a (wa (wcel U B2) (wral y1 (wn (wbr (cv y1) U clts)) B2)) (w3a (wss B2 csur) (wcel B2 V) (wcel Z csur)) (wral b (wbr Z (cv b) clts) B2)) (wn (wbr (cun U (csn (cop (cdm U) c1o))) (cres Z (csuc (cdm U))) clts)) $;

--| Bounding law from below for the surreal infimum. Analagous to proposition 4.3 of [Lipparini] p. 6. (Contributed by Scott Fenton, 9-Aug-2024.)
theorem noinfbnd2 {x3 y1 v u g2 b: setvar} (B2: class) (T: class x3 y1 v u) (V Z: class y1 v u):
  $ wceq T (cif (wrex x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2) (cun (crio x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2)) c1o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv u) (cv v) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) B2)) B2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv u) (cv v) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) B2) (wceq (cfv (cv g2) (cv u)) (cv x3))) B2)))) $ >
  $ wi (w3a (wss B2 csur) (wcel B2 V) (wcel Z csur)) (wb (wral b (wbr Z (cv b) clts) B2) (wn (wbr T (cres Z (cdm T)) clts))) $;

--| Given two sets of surreals, a surreal ` W ` separates them iff its restriction to the maximum of ` dom S ` and ` dom T ` separates them. Corollary 4.4 of [Lipparini] p. 7. (Contributed by Scott Fenton, 9-Aug-2024.)
theorem nosupinfsep {x3 y1 v u g2 a b: setvar} (A2: class b) (B2: class a) (S T W: class y1 v u):
  $ wceq S (cif (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (cun (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) c2o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) A2)) A2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) A2) (wceq (cfv (cv g2) (cv u)) (cv x3))) A2)))) $ >
  $ wceq T (cif (wrex x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2) (cun (crio x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2)) c1o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv u) (cv v) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) B2)) B2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv u) (cv v) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) B2) (wceq (cfv (cv g2) (cv u)) (cv x3))) B2)))) $ >
  $ wi (w3a (wa (wss A2 csur) (wcel A2 cvv)) (wa (wss B2 csur) (wcel B2 cvv)) (wcel W csur)) (wb (wa (wral a (wbr (cv a) W clts) A2) (wral b (wbr W (cv b) clts) B2)) (wa (wral a (wbr (cv a) (cres W (cun (cdm S) (cdm T))) clts) A2) (wral b (wbr (cres W (cun (cdm S) (cdm T))) (cv b) clts) B2))) $;

--| Lemma for ~ noeta . Establish that our final surreal really is a surreal. (Contributed by Scott Fenton, 6-Dec-2021.)
theorem noetasuplem1 {x3 y1 v u g2: setvar} (A2: class) (B2 S Z: class x3 y1 v u g2):
  $ wceq S (cif (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (cun (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) c2o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) A2)) A2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) A2) (wceq (cfv (cv g2) (cv u)) (cv x3))) A2)))) $ >
  $ wceq Z (cun S (cxp (cdif (csuc (cuni (cima cbday B2))) (cdm S)) (csn c1o))) $ >
  $ wi (w3a (wss A2 csur) (wcel A2 cvv) (wcel B2 cvv)) (wcel Z csur) $;

--| Lemma for ~ noeta . The restriction of ` Z ` to ` dom S ` is ` S ` . (Contributed by Scott Fenton, 9-Aug-2024.)
theorem noetasuplem2 {x3 y1 v u g2: setvar} (A2: class) (B2 S Z: class x3 y1 v u g2):
  $ wceq S (cif (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (cun (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) c2o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) A2)) A2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) A2) (wceq (cfv (cv g2) (cv u)) (cv x3))) A2)))) $ >
  $ wceq Z (cun S (cxp (cdif (csuc (cuni (cima cbday B2))) (cdm S)) (csn c1o))) $ >
  $ wi (w3a (wss A2 csur) (wcel A2 cvv) (wcel B2 cvv)) (wceq (cres Z (cdm S)) S) $;

--| Lemma for ~ noeta . ` Z ` is an upper bound for ` A ` . Part of Theorem 5.1 of [Lipparini] p. 7-8. (Contributed by Scott Fenton, 4-Dec-2021.)
theorem noetasuplem3 {x3 y1 v u g2: setvar} (A2: class) (B2 S: class x3 y1 v u g2) (X: class g2) (Z: class x3 y1 v u g2):
  $ wceq S (cif (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (cun (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) c2o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) A2)) A2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) A2) (wceq (cfv (cv g2) (cv u)) (cv x3))) A2)))) $ >
  $ wceq Z (cun S (cxp (cdif (csuc (cuni (cima cbday B2))) (cdm S)) (csn c1o))) $ >
  $ wi (wa (w3a (wss A2 csur) (wcel A2 cvv) (wcel B2 cvv)) (wcel X A2)) (wbr X Z clts) $;

--| Lemma for ~ noeta . When ` A ` and ` B ` are separated, then ` Z ` is a lower bound for ` B ` . Part of Theorem 5.1 of [Lipparini] p. 7-8. (Contributed by Scott Fenton, 7-Dec-2021.)
theorem noetasuplem4 {x3 y1 v u g2 a b: setvar} (A2: class) (B2: class x3 y1 v u g2) (S: class x3 y1 v u b) (Z: class x3 y1 v u g2 a b):
  $ wceq S (cif (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (cun (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) c2o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) A2)) A2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) A2) (wceq (cfv (cv g2) (cv u)) (cv x3))) A2)))) $ >
  $ wceq Z (cun S (cxp (cdif (csuc (cuni (cima cbday B2))) (cdm S)) (csn c1o))) $ >
  $ wi (w3a (wa (wss A2 csur) (wcel A2 cvv)) (wa (wss B2 csur) (wcel B2 cvv)) (wral a (wral b (wbr (cv a) (cv b) clts) B2) A2)) (wral b (wbr Z (cv b) clts) B2) $;

--| Lemma for ~ noeta . Establish that this particular construction gives a surreal. (Contributed by Scott Fenton, 9-Aug-2024.)
theorem noetainflem1 {x3 y1 v u g2: setvar} (A2: class x3 y1 v u g2) (B2: class) (T W: class x3 y1 v u g2):
  $ wceq T (cif (wrex x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2) (cun (crio x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2)) c1o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv u) (cv v) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) B2)) B2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv u) (cv v) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) B2) (wceq (cfv (cv g2) (cv u)) (cv x3))) B2)))) $ >
  $ wceq W (cun T (cxp (cdif (csuc (cuni (cima cbday A2))) (cdm T)) (csn c2o))) $ >
  $ wi (w3a (wcel A2 cvv) (wss B2 csur) (wcel B2 cvv)) (wcel W csur) $;

--| Lemma for ~ noeta . The restriction of ` W ` to the domain of ` T ` is ` T ` . (Contributed by Scott Fenton, 9-Aug-2024.)
theorem noetainflem2 {x3 y1 v u g2: setvar} (A2: class x3 y1 v u g2) (B2: class) (T W: class x3 y1 v u g2):
  $ wceq T (cif (wrex x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2) (cun (crio x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2)) c1o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv u) (cv v) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) B2)) B2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv u) (cv v) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) B2) (wceq (cfv (cv g2) (cv u)) (cv x3))) B2)))) $ >
  $ wceq W (cun T (cxp (cdif (csuc (cuni (cima cbday A2))) (cdm T)) (csn c2o))) $ >
  $ wi (wa (wss B2 csur) (wcel B2 cvv)) (wceq (cres W (cdm T)) T) $;

--| Lemma for ~ noeta . ` W ` bounds ` B ` below . (Contributed by Scott Fenton, 9-Aug-2024.)
theorem noetainflem3 {x3 y1 v u g2: setvar} (A2: class x3 y1 v u g2) (B2: class) (T W: class x3 y1 v u g2) (Y: class u g2):
  $ wceq T (cif (wrex x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2) (cun (crio x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2)) c1o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv u) (cv v) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) B2)) B2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv u) (cv v) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) B2) (wceq (cfv (cv g2) (cv u)) (cv x3))) B2)))) $ >
  $ wceq W (cun T (cxp (cdif (csuc (cuni (cima cbday A2))) (cdm T)) (csn c2o))) $ >
  $ wi (wa (w3a (wcel A2 cvv) (wss B2 csur) (wcel B2 cvv)) (wcel Y B2)) (wbr W Y clts) $;

--| Lemma for ~ noeta . If ` A ` precedes ` B ` , then ` W ` is greater than ` A ` . (Contributed by Scott Fenton, 9-Aug-2024.)
theorem noetainflem4 {x3 y1 v u g2 a b: setvar} (A2: class x3 y1 v u g2 b) (B2: class) (T: class x3 y1 v u a) (W: class x3 y1 v u g2 a b):
  $ wceq T (cif (wrex x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2) (cun (crio x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2)) c1o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv u) (cv v) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) B2)) B2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv u) (cv v) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) B2) (wceq (cfv (cv g2) (cv u)) (cv x3))) B2)))) $ >
  $ wceq W (cun T (cxp (cdif (csuc (cuni (cima cbday A2))) (cdm T)) (csn c2o))) $ >
  $ wi (w3a (wa (wss A2 csur) (wcel A2 cvv)) (wa (wss B2 csur) (wcel B2 cvv)) (wral a (wral b (wbr (cv a) (cv b) clts) B2) A2)) (wral a (wbr (cv a) W clts) A2) $;

--| Lemma for ~ noeta . Either ` S ` or ` T ` satisfies the final condition. (Contributed by Scott Fenton, 9-Aug-2024.)
theorem noetalem1 {x3 y1 v u g2 a b: setvar} (A2 B2: class) (S T: class y1 v u) (O: class x3 v g2 a b) (W Z: class y1 v u):
  $ wceq S (cif (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (cun (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) c2o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) A2)) A2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) A2) (wceq (cfv (cv g2) (cv u)) (cv x3))) A2)))) $ >
  $ wceq T (cif (wrex x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2) (cun (crio x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2)) c1o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv u) (cv v) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) B2)) B2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv u) (cv v) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) B2) (wceq (cfv (cv g2) (cv u)) (cv x3))) B2)))) $ >
  $ wceq Z (cun S (cxp (cdif (csuc (cuni (cima cbday B2))) (cdm S)) (csn c1o))) $ >
  $ wceq W (cun T (cxp (cdif (csuc (cuni (cima cbday A2))) (cdm T)) (csn c2o))) $ >
  $ wi (wa (w3a (wa (wss A2 csur) (wcel A2 cvv)) (wa (wss B2 csur) (wcel B2 cvv)) (wral a (wral b (wbr (cv a) (cv b) clts) B2) A2)) (wa (wcel O con0) (wss (cima cbday (cun A2 B2)) O))) (wo (wa (wcel S csur) (w3a (wral a (wbr (cv a) S clts) A2) (wral b (wbr S (cv b) clts) B2) (wss (cfv S cbday) O))) (wa (wcel T csur) (w3a (wral a (wbr (cv a) T clts) A2) (wral b (wbr T (cv b) clts) B2) (wss (cfv T cbday) O)))) $;

--| Lemma for ~ noeta . The full statement of the theorem with hypotheses in place. (Contributed by Scott Fenton, 10-Aug-2024.)
theorem noetalem2 {x3 y1 v u g2 a b c: setvar} (A2 B2: class) (S T: class y1 v u) (O: class x3 v g2 a b) (V W: class x3 y1 v u g2 a b c):
  $ wceq S (cif (wrex x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (cun (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv x3) (cv y1) clts)) A2) A2)) c2o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) A2)) A2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv v) (cv u) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) A2) (wceq (cfv (cv g2) (cv u)) (cv x3))) A2)))) $ >
  $ wceq T (cif (wrex x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2) (cun (crio x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2) (csn (cop (cdm (crio x3 (wral y1 (wn (wbr (cv y1) (cv x3) clts)) B2) B2)) c1o))) (cmpt g2 (cab y1 (wrex u (wa (wcel (cv y1) (cdm (cv u))) (wral v (wi (wn (wbr (cv u) (cv v) clts)) (wceq (cres (cv u) (csuc (cv y1))) (cres (cv v) (csuc (cv y1))))) B2)) B2)) (cio x3 (wrex u (w3a (wcel (cv g2) (cdm (cv u))) (wral v (wi (wn (wbr (cv u) (cv v) clts)) (wceq (cres (cv u) (csuc (cv g2))) (cres (cv v) (csuc (cv g2))))) B2) (wceq (cfv (cv g2) (cv u)) (cv x3))) B2)))) $ >
  $ wi (wa (w3a (wa (wss A2 csur) (wcel A2 V)) (wa (wss B2 csur) (wcel B2 W)) (wral a (wral b (wbr (cv a) (cv b) clts) B2) A2)) (wa (wcel O con0) (wss (cima cbday (cun A2 B2)) O))) (wrex c (w3a (wral a (wbr (cv a) (cv c) clts) A2) (wral b (wbr (cv c) (cv b) clts) B2) (wss (cfv (cv c) cbday) O)) csur) $;

--| The full-eta axiom for the surreal numbers. This is the single most important property of the surreals. It says that, given two sets of surreals such that one comes completely before the other, there is a surreal lying strictly between the two. Furthermore, if the birthdays of members of ` A ` and ` B ` are strictly bounded above by ` O ` , then ` O ` non-strictly bounds the separator. Axiom FE of [Alling] p. 185. (Contributed by Scott Fenton, 9-Aug-2024.)
theorem noeta {x3 y1 z: setvar} (A2 B2: class) (O: class x3 y1) (V W: class x3 y1 z):
  $ wi (wa (w3a (wa (wss A2 csur) (wcel A2 V)) (wa (wss B2 csur) (wcel B2 W)) (wral x3 (wral y1 (wbr (cv x3) (cv y1) clts) B2) A2)) (wa (wcel O con0) (wss (cima cbday (cun A2 B2)) O))) (wrex z (w3a (wral x3 (wbr (cv x3) (cv z) clts) A2) (wral y1 (wbr (cv z) (cv y1) clts) B2) (wss (cfv (cv z) cbday) O)) csur) $;

--| Declare the syntax for surreal less-than or equal.
term cles: class;

--| Define the surreal less-than or equal predicate. Compare ~ df-le . (Contributed by Scott Fenton, 8-Dec-2021.)
axiom df_les:
  $ wceq cles (cdif (cxp csur csur) (ccnv clts)) $;

--| Surreal less-than is irreflexive. (Contributed by Scott Fenton, 16-Jun-2011.)
theorem ltsirr (A2: class):
  $ wi (wcel A2 csur) (wn (wbr A2 A2 clts)) $;

--| Surreal less-than is transitive. (Contributed by Scott Fenton, 16-Jun-2011.)
theorem ltstr (A2 B2 C: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wcel C csur)) (wi (wa (wbr A2 B2 clts) (wbr B2 C clts)) (wbr A2 C clts)) $;

--| Surreal less-than is asymmetric. (Contributed by Scott Fenton, 16-Jun-2011.)
theorem ltsasym (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wi (wbr A2 B2 clts) (wn (wbr B2 A2 clts))) $;

--| Surreal less-than obeys trichotomy. (Contributed by Scott Fenton, 16-Jun-2011.)
theorem ltslin (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (w3o (wbr A2 B2 clts) (wceq A2 B2) (wbr B2 A2 clts)) $;

--| Trichotomy law for surreal less-than. (Contributed by Scott Fenton, 22-Apr-2012.)
theorem ltstrieq2 (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wb (wceq A2 B2) (wa (wn (wbr A2 B2 clts)) (wn (wbr B2 A2 clts)))) $;

--| Trichotomy law for surreals. (Contributed by Scott Fenton, 23-Nov-2021.)
theorem ltstrine (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wb (wne A2 B2) (wo (wbr A2 B2 clts) (wbr B2 A2 clts))) $;

--| Surreal less-than or equal in terms of less-than. (Contributed by Scott Fenton, 8-Dec-2021.)
theorem lenlts (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wb (wbr A2 B2 cles) (wn (wbr B2 A2 clts))) $;

--| Surreal less-than in terms of less-than or equal. (Contributed by Scott Fenton, 8-Dec-2021.)
theorem ltnles (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wb (wbr A2 B2 clts) (wn (wbr B2 A2 cles))) $;

--| Surreal less-than or equal in terms of less-than. (Contributed by Scott Fenton, 8-Dec-2021.)
theorem lesloe (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wb (wbr A2 B2 cles) (wo (wbr A2 B2 clts) (wceq A2 B2))) $;

--| Trichotomy law for surreal less-than or equal. (Contributed by Scott Fenton, 8-Dec-2021.)
theorem lestri3 (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wb (wceq A2 B2) (wa (wbr A2 B2 cles) (wbr B2 A2 cles))) $;

--| Surreal less-than or equal in terms of less-than. Deduction version. (Contributed by Scott Fenton, 25-Feb-2026.)
theorem lesnltd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wb (wbr A2 B2 cles) (wn (wbr B2 A2 clts))) $;

--| Surreal less-than in terms of less-than or equal. Deduction version. (Contributed by Scott Fenton, 25-Feb-2026.)
theorem ltsnled (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wb (wbr A2 B2 clts) (wn (wbr B2 A2 cles))) $;

--| Surreal less-than or equal in terms of less-than. Deduction version. (Contributed by Scott Fenton, 25-Feb-2026.)
theorem lesloed (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wb (wbr A2 B2 cles) (wo (wbr A2 B2 clts) (wceq A2 B2))) $;

--| Trichotomy law for surreal less-than or equal. Deduction version. (Contributed by Scott Fenton, 25-Feb-2026.)
theorem lestri3d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wb (wceq A2 B2) (wa (wbr A2 B2 cles) (wbr B2 A2 cles))) $;

--| Surreal transitive law. (Contributed by Scott Fenton, 8-Dec-2021.)
theorem ltlestr (A2 B2 C: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wcel C csur)) (wi (wa (wbr A2 B2 clts) (wbr B2 C cles)) (wbr A2 C clts)) $;

--| Surreal transitive law. (Contributed by Scott Fenton, 8-Dec-2021.)
theorem leltstr (A2 B2 C: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wcel C csur)) (wi (wa (wbr A2 B2 cles) (wbr B2 C clts)) (wbr A2 C clts)) $;

--| Surreal transitive law. (Contributed by Scott Fenton, 8-Dec-2021.)
theorem lestr (A2 B2 C: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wcel C csur)) (wi (wa (wbr A2 B2 cles) (wbr B2 C cles)) (wbr A2 C cles)) $;

--| Surreal less-than is transitive. (Contributed by Scott Fenton, 8-Dec-2021.)
theorem ltstrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wbr A2 B2 clts) $ >
  $ wi ph (wbr B2 C clts) $ >
  $ wi ph (wbr A2 C clts) $;

--| Surreal less-than is transitive. (Contributed by Scott Fenton, 8-Dec-2021.)
theorem ltlestrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wbr A2 B2 clts) $ >
  $ wi ph (wbr B2 C cles) $ >
  $ wi ph (wbr A2 C clts) $;

--| Surreal less-than is transitive. (Contributed by Scott Fenton, 8-Dec-2021.)
theorem leltstrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wbr A2 B2 cles) $ >
  $ wi ph (wbr B2 C clts) $ >
  $ wi ph (wbr A2 C clts) $;

--| Surreal less-than or equal is transitive. (Contributed by Scott Fenton, 8-Dec-2021.)
theorem lestrd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wbr A2 B2 cles) $ >
  $ wi ph (wbr B2 C cles) $ >
  $ wi ph (wbr A2 C cles) $;

--| Surreal less-than or equal is reflexive. Theorem 0(iii) of [Conway] p. 16. (Contributed by Scott Fenton, 7-Aug-2024.)
theorem lesid (A2: class):
  $ wi (wcel A2 csur) (wbr A2 A2 cles) $;

--| Surreal trichotomy law. (Contributed by Scott Fenton, 14-Feb-2025.)
theorem lestric (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wo (wbr A2 B2 cles) (wbr B2 A2 cles)) $;

--| A surreal is less than or equal to the maximum of it and another. (Contributed by Scott Fenton, 14-Feb-2025.)
theorem maxs1 (A2 B2: class):
  $ wi (wcel A2 csur) (wbr A2 (cif (wbr A2 B2 cles) B2 A2) cles) $;

--| A surreal is less than or equal to the maximum of it and another. (Contributed by Scott Fenton, 14-Feb-2025.)
theorem maxs2 (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wbr B2 (cif (wbr A2 B2 cles) B2 A2) cles) $;

--| The minimum of two surreals is less than or equal to the first. (Contributed by Scott Fenton, 14-Feb-2025.)
theorem mins1 (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wbr (cif (wbr A2 B2 cles) A2 B2) A2 cles) $;

--| The minimum of two surreals is less than or equal to the second. (Contributed by Scott Fenton, 14-Feb-2025.)
theorem mins2 (A2 B2: class):
  $ wi (wcel B2 csur) (wbr (cif (wbr A2 B2 cles) A2 B2) B2 cles) $;

--| Surreal less-than implies less-than or equal. (Contributed by Scott Fenton, 16-Feb-2025.)
theorem ltlesd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wbr A2 B2 clts) $ >
  $ wi ph (wbr A2 B2 cles) $;

--| Surreal less-than implies not equal. (Contributed by Scott Fenton, 12-Mar-2025.)
theorem ltsne (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wbr A2 B2 clts)) (wne B2 A2) $;

--| Surreal less-than in terms of less-than or equal. (Contributed by Scott Fenton, 15-Apr-2025.)
theorem ltlesnd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wb (wbr A2 B2 clts) (wa (wbr A2 B2 cles) (wne B2 A2))) $;

--| The birthday function is a function. (Contributed by Scott Fenton, 14-Jun-2011.)
theorem bdayfun:
  $ wfun cbday $;

--| The birthday function is a function over ` No ` . (Contributed by Scott Fenton, 30-Jun-2011.)
theorem bdayfn:
  $ wfn cbday csur $;

--| The birthday function's domain is ` No ` . (Contributed by Scott Fenton, 14-Jun-2011.) (Proof shortened by Umit Teoman Dogan, 10-Jun-2026.)
theorem bdaydm:
  $ wceq (cdm cbday) csur $;

--| Obsolete version of ~ bdaydm as of 10-Jun-2026. (Contributed by Scott Fenton, 14-Jun-2011.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem bdaydmOLD:
  $ wceq (cdm cbday) csur $;

--| The birthday function's range is ` On ` . (Contributed by Scott Fenton, 14-Jun-2011.)
theorem bdayrn:
  $ wceq (crn cbday) con0 $;

--| The value of the birthday function is always an ordinal. (Contributed by Scott Fenton, 14-Jun-2011.) (Proof shortened by Scott Fenton, 8-Dec-2021.)
theorem bdayon (A2: class):
  $ wcel (cfv A2 cbday) con0 $;

--| Any non-empty class of surreals has a birthday-minimal element. (Contributed by Scott Fenton, 11-Dec-2025.)
theorem nobdaymin {x3: setvar} (A2: class):
  $ wi (wa (wss A2 csur) (wne A2 c0)) (wrex x3 (wceq (cfv (cv x3) cbday) (cint (cima cbday A2))) A2) $;

--| Lemma for ~ nocvxmin . Given two birthday-minimal elements of a convex class of surreals, they are not comparable. (Contributed by Scott Fenton, 30-Jun-2011.)
theorem nocvxminlem {x3 y1 z: setvar} (A2 X: class) (Y: class x3):
  $ wi (wa (wss A2 csur) (wral x3 (wral y1 (wral z (wi (wa (wbr (cv x3) (cv z) clts) (wbr (cv z) (cv y1) clts)) (wcel (cv z) A2)) csur) A2) A2)) (wi (wa (wa (wcel X A2) (wcel Y A2)) (wa (wceq (cfv X cbday) (cint (cima cbday A2))) (wceq (cfv Y cbday) (cint (cima cbday A2))))) (wn (wbr X Y clts))) $;

--| Given a nonempty convex class of surreals, there is a unique birthday-minimal element of that class. Lemma 0 of [Alling] p. 185. (Contributed by Scott Fenton, 30-Jun-2011.)
theorem nocvxmin {x3 y1 z w: setvar} (A2: class):
  $ wi (w3a (wne A2 c0) (wss A2 csur) (wral x3 (wral y1 (wral z (wi (wa (wbr (cv x3) (cv z) clts) (wbr (cv z) (cv y1) clts)) (wcel (cv z) A2)) csur) A2) A2)) (wreu w (wceq (cfv (cv w) cbday) (cint (cima cbday A2))) A2) $;

--| The surreal numbers are a proper class. (Contributed by Scott Fenton, 16-Jun-2011.)
theorem noprc:
  $ wn (wcel csur cvv) $;

--| Declare the syntax for surreal set less-than.
term cslts: class;

--| Define the relation that holds iff one set of surreals completely precedes another. (Contributed by Scott Fenton, 7-Dec-2021.)
axiom df_slts {x3 y1 a b: setvar}:
  $ wceq cslts (copab a b (w3a (wss (cv a) csur) (wss (cv b) csur) (wral x3 (wral y1 (wbr (cv x3) (cv y1) clts) (cv b)) (cv a)))) $;

--| Declare the syntax for the surreal cut operator.
term ccuts: class;

--| Define the cut operator on surreal numbers. This operator, which Conway takes as the primitive operator over surreals, picks the surreal lying between two sets of surreals of minimal birthday. Definition from [Gonshor] p. 7. (Contributed by Scott Fenton, 7-Dec-2021.)
axiom df_cuts {x3 y1 a b: setvar}:
  $ wceq ccuts (cmpo a b (cpw csur) (cima cslts (csn (cv a))) (crio x3 (wceq (cfv (cv x3) cbday) (cint (cima cbday (crab y1 (wa (wbr (cv a) (csn (cv y1)) cslts) (wbr (csn (cv y1)) (cv b) cslts)) csur)))) (crab y1 (wa (wbr (cv a) (csn (cv y1)) cslts) (wbr (csn (cv y1)) (cv b) cslts)) csur))) $;

--| A version of ~ noeta with fewer hypotheses but a weaker upper bound (Contributed by Scott Fenton, 7-Dec-2021.)
theorem noeta2 {x3 y1 z: setvar} (A2 B2: class) (V W: class x3 y1 z):
  $ wi (w3a (wa (wss A2 csur) (wcel A2 V)) (wa (wss B2 csur) (wcel B2 W)) (wral x3 (wral y1 (wbr (cv x3) (cv y1) clts) B2) A2)) (wrex z (w3a (wral x3 (wbr (cv x3) (cv z) clts) A2) (wral y1 (wbr (cv z) (cv y1) clts) B2) (wss (cfv (cv z) cbday) (csuc (cuni (cima cbday (cun A2 B2)))))) csur) $;

--| Binary relation form of the surreal set less-than relation. (Contributed by Scott Fenton, 8-Dec-2021.)
theorem brslts {x3 y1: setvar} (A2 B2: class):
  $ wb (wbr A2 B2 cslts) (wa (wa (wcel A2 cvv) (wcel B2 cvv)) (w3a (wss A2 csur) (wss B2 csur) (wral x3 (wral y1 (wbr (cv x3) (cv y1) clts) B2) A2))) $;

--| The first argument of surreal set less-than exists. (Contributed by Scott Fenton, 8-Dec-2021.)
theorem sltsex1 (A2 B2: class):
  $ wi (wbr A2 B2 cslts) (wcel A2 cvv) $;

--| The second argument of surreal set less-than exists. (Contributed by Scott Fenton, 8-Dec-2021.)
theorem sltsex2 (A2 B2: class):
  $ wi (wbr A2 B2 cslts) (wcel B2 cvv) $;

--| The first argument of surreal set is a set of surreals. (Contributed by Scott Fenton, 8-Dec-2021.)
theorem sltsss1 (A2 B2: class):
  $ wi (wbr A2 B2 cslts) (wss A2 csur) $;

--| The second argument of surreal set is a set of surreals. (Contributed by Scott Fenton, 8-Dec-2021.)
theorem sltsss2 (A2 B2: class):
  $ wi (wbr A2 B2 cslts) (wss B2 csur) $;

--| The separation property of surreal set less-than. (Contributed by Scott Fenton, 8-Dec-2021.)
theorem sltssep {x3 y1: setvar} (A2 B2: class):
  $ wi (wbr A2 B2 cslts) (wral x3 (wral y1 (wbr (cv x3) (cv y1) clts) B2) A2) $;

--| Deduce surreal set less-than. (Contributed by Scott Fenton, 24-Sep-2024.)
theorem sltsd {x3 y1: setvar} (ph: wff) (A2 B2: class) (V W: class x3 y1):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wss A2 csur) $ >
  $ wi ph (wss B2 csur) $ >
  $ wi (w3a ph (wcel (cv x3) A2) (wcel (cv y1) B2)) (wbr (cv x3) (cv y1) clts) $ >
  $ wi ph (wbr A2 B2 cslts) $;

--| Surreal set less-than of two singletons. (Contributed by Scott Fenton, 18-Jan-2026.)
theorem sltssnb (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wb (wbr (csn A2) (csn B2) cslts) (wbr A2 B2 clts)) $;

--| Surreal set less-than of two singletons. (Contributed by Scott Fenton, 17-Mar-2025.)
theorem sltssn (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wbr A2 B2 clts) $ >
  $ wi ph (wbr (csn A2) (csn B2) cslts) $;

--| Two elements of separated sets obey less-than. (Contributed by Scott Fenton, 20-Aug-2024.)
theorem sltssepc (A2 B2 X Y: class):
  $ wi (w3a (wbr A2 B2 cslts) (wcel X A2) (wcel Y B2)) (wbr X Y clts) $;

--| Two elements of separated sets obey less-than. Deduction form of ~ sltssepc . (Contributed by Scott Fenton, 25-Sep-2024.)
theorem sltssepcd (ph: wff) (A2 B2 X Y: class):
  $ wi ph (wbr A2 B2 cslts) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wcel Y B2) $ >
  $ wi ph (wbr X Y clts) $;

--| Relation between surreal set less-than and subset. (Contributed by Scott Fenton, 9-Dec-2021.)
theorem ssslts1 (A2 B2 C: class):
  $ wi (wa (wbr A2 B2 cslts) (wss C A2)) (wbr C B2 cslts) $;

--| Relation between surreal set less-than and subset. (Contributed by Scott Fenton, 9-Dec-2021.)
theorem ssslts2 (A2 B2 C: class):
  $ wi (wa (wbr A2 B2 cslts) (wss C B2)) (wbr A2 C cslts) $;

--| The empty set is less-than any set of surreals. (Contributed by Scott Fenton, 8-Dec-2021.)
theorem nulslts (A2: class):
  $ wi (wcel A2 (cpw csur)) (wbr c0 A2 cslts) $;

--| The empty set is greater than any set of surreals. (Contributed by Scott Fenton, 8-Dec-2021.)
theorem nulsgts (A2: class):
  $ wi (wcel A2 (cpw csur)) (wbr A2 c0 cslts) $;

--| The empty set is less-than any set of surreals. Deduction version. (Contributed by Scott Fenton, 27-Feb-2026.)
theorem nulsltsd (ph: wff) (A2 V: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wss A2 csur) $ >
  $ wi ph (wbr c0 A2 cslts) $;

--| The empty set is greater than any set of surreals. Deduction version. (Contributed by Scott Fenton, 27-Feb-2026.)
theorem nulsgtsd (ph: wff) (A2 V: class):
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wss A2 csur) $ >
  $ wi ph (wbr A2 c0 cslts) $;

--| Conway's Simplicity Theorem. Given ` A ` preceeding ` B ` , there is a unique surreal of minimal length separating them. This is a fundamental property of surreals and will be used (via surreal cuts) to prove many properties later on. Theorem from [Alling] p. 185. (Contributed by Scott Fenton, 8-Dec-2021.)
theorem conway {x3 y1: setvar} (A2 B2: class):
  $ wi (wbr A2 B2 cslts) (wreu x3 (wceq (cfv (cv x3) cbday) (cint (cima cbday (crab y1 (wa (wbr A2 (csn (cv y1)) cslts) (wbr (csn (cv y1)) B2 cslts)) csur)))) (crab y1 (wa (wbr A2 (csn (cv y1)) cslts) (wbr (csn (cv y1)) B2 cslts)) csur)) $;

--| The value of the surreal cut operation. (Contributed by Scott Fenton, 8-Dec-2021.)
theorem cutsval {x3 y1: setvar} (A2 B2: class):
  $ wi (wbr A2 B2 cslts) (wceq (co A2 B2 ccuts) (crio x3 (wceq (cfv (cv x3) cbday) (cint (cima cbday (crab y1 (wa (wbr A2 (csn (cv y1)) cslts) (wbr (csn (cv y1)) B2 cslts)) csur)))) (crab y1 (wa (wbr A2 (csn (cv y1)) cslts) (wbr (csn (cv y1)) B2 cslts)) csur))) $;

--| Cut properties of the surreal cut operation. (Contributed by Scott Fenton, 8-Dec-2021.)
theorem cutcuts (A2 B2: class):
  $ wi (wbr A2 B2 cslts) (w3a (wcel (co A2 B2 ccuts) csur) (wbr A2 (csn (co A2 B2 ccuts)) cslts) (wbr (csn (co A2 B2 ccuts)) B2 cslts)) $;

--| Closure law for surreal cuts. (Contributed by Scott Fenton, 23-Aug-2024.)
theorem cutscl (A2 B2: class):
  $ wi (wbr A2 B2 cslts) (wcel (co A2 B2 ccuts) csur) $;

--| Closure law for surreal cuts. (Contributed by Scott Fenton, 23-Aug-2024.)
theorem cutscld (ph: wff) (A2 B2: class):
  $ wi ph (wbr A2 B2 cslts) $ >
  $ wi ph (wcel (co A2 B2 ccuts) csur) $;

--| The birthday of the surreal cut is equal to the minimum birthday in the gap. (Contributed by Scott Fenton, 8-Dec-2021.)
theorem cutbday {x3: setvar} (A2 B2: class):
  $ wi (wbr A2 B2 cslts) (wceq (cfv (co A2 B2 ccuts) cbday) (cint (cima cbday (crab x3 (wa (wbr A2 (csn (cv x3)) cslts) (wbr (csn (cv x3)) B2 cslts)) csur)))) $;

--| Condition for equality to a surreal cut. (Contributed by Scott Fenton, 8-Aug-2024.)
theorem eqcuts {y1: setvar} (R L: class) (X: class y1):
  $ wi (wa (wbr L R cslts) (wcel X csur)) (wb (wceq (co L R ccuts) X) (w3a (wbr L (csn X) cslts) (wbr (csn X) R cslts) (wceq (cfv X cbday) (cint (cima cbday (crab y1 (wa (wbr L (csn (cv y1)) cslts) (wbr (csn (cv y1)) R cslts)) csur)))))) $;

--| Condition for equality to a surreal cut. (Contributed by Scott Fenton, 8-Aug-2024.)
theorem eqcuts2 {y1: setvar} (R L X: class):
  $ wi (wa (wbr L R cslts) (wcel X csur)) (wb (wceq (co L R ccuts) X) (w3a (wbr L (csn X) cslts) (wbr (csn X) R cslts) (wral y1 (wi (wa (wbr L (csn (cv y1)) cslts) (wbr (csn (cv y1)) R cslts)) (wss (cfv X cbday) (cfv (cv y1) cbday))) csur))) $;

--| Transitive law for surreal set less-than. (Contributed by Scott Fenton, 9-Dec-2021.)
theorem sltstr (A2 B2 C: class):
  $ wi (w3a (wbr A2 B2 cslts) (wbr B2 C cslts) (wne B2 c0)) (wbr A2 C cslts) $;

--| Union law for surreal set less-than. (Contributed by Scott Fenton, 9-Dec-2021.)
theorem sltsun1 (A2 B2 C: class):
  $ wi (wa (wbr A2 C cslts) (wbr B2 C cslts)) (wbr (cun A2 B2) C cslts) $;

--| Union law for surreal set less-than. (Contributed by Scott Fenton, 9-Dec-2021.)
theorem sltsun2 (A2 B2 C: class):
  $ wi (wa (wbr A2 B2 cslts) (wbr A2 C cslts)) (wbr A2 (cun B2 C) cslts) $;

--| Union law for surreal cuts. (Contributed by Scott Fenton, 9-Dec-2021.)
theorem cutsun12 (A2 B2 C D: class):
  $ wi (w3a (wbr A2 B2 cslts) (wbr C (csn (co A2 B2 ccuts)) cslts) (wbr (csn (co A2 B2 ccuts)) D cslts)) (wceq (co (cun A2 C) (cun B2 D) ccuts) (co A2 B2 ccuts)) $;

--| The domain of the surreal cut operation is all separated surreal sets. (Contributed by Scott Fenton, 8-Dec-2021.)
theorem dmcuts:
  $ wceq (cdm ccuts) cslts $;

--| Functionality statement for the surreal cut operator. (Contributed by Scott Fenton, 15-Dec-2021.)
theorem cutsf:
  $ wf cslts csur ccuts $;

--| A restatement of ~ noeta using set less-than. (Contributed by Scott Fenton, 10-Aug-2024.)
theorem etaslts {x3: setvar} (A2 B2 O: class):
  $ wi (w3a (wbr A2 B2 cslts) (wcel O con0) (wss (cima cbday (cun A2 B2)) O)) (wrex x3 (w3a (wbr A2 (csn (cv x3)) cslts) (wbr (csn (cv x3)) B2 cslts) (wss (cfv (cv x3) cbday) O)) csur) $;

--| A version of ~ etaslts with fewer hypotheses but a weaker upper bound. (Contributed by Scott Fenton, 10-Dec-2021.)
theorem etaslts2 {x3: setvar} (A2 B2: class):
  $ wi (wbr A2 B2 cslts) (wrex x3 (w3a (wbr A2 (csn (cv x3)) cslts) (wbr (csn (cv x3)) B2 cslts) (wss (cfv (cv x3) cbday) (csuc (cuni (cima cbday (cun A2 B2)))))) csur) $;

--| An upper bound on the birthday of a surreal cut. (Contributed by Scott Fenton, 10-Aug-2024.)
theorem cutbdaybnd (A2 B2 O: class):
  $ wi (w3a (wbr A2 B2 cslts) (wcel O con0) (wss (cima cbday (cun A2 B2)) O)) (wss (cfv (co A2 B2 ccuts) cbday) O) $;

--| An upper bound on the birthday of a surreal cut. (Contributed by Scott Fenton, 10-Dec-2021.)
theorem cutbdaybnd2 (A2 B2: class):
  $ wi (wbr A2 B2 cslts) (wss (cfv (co A2 B2 ccuts) cbday) (csuc (cuni (cima cbday (cun A2 B2))))) $;

--| An upper bound on the birthday of a surreal cut when it is a limit birthday. (Contributed by Scott Fenton, 7-Aug-2024.)
theorem cutbdaybnd2lim (A2 B2: class):
  $ wi (wa (wbr A2 B2 cslts) (wlim (cfv (co A2 B2 ccuts) cbday))) (wss (cfv (co A2 B2 ccuts) cbday) (cuni (cima cbday (cun A2 B2)))) $;

--| If a surreal lies in a gap and is not equal to the cut, its birthday is greater than the cut's. (Contributed by Scott Fenton, 11-Dec-2021.)
theorem cutbdaylt (A2 B2 X: class):
  $ wi (w3a (wcel X csur) (wa (wbr A2 (csn X) cslts) (wbr (csn X) B2 cslts)) (wne X (co A2 B2 ccuts))) (wcel (cfv (co A2 B2 ccuts) cbday) (cfv X cbday)) $;

--| A comparison law for surreals considered as cuts of sets of surreals. Definition from [Conway] p. 4. Theorem 4 of [Alling] p. 186. Theorem 2.5 of [Gonshor] p. 9. (Contributed by Scott Fenton, 11-Dec-2021.)
theorem lesrec {a d: setvar} (A2 B2 C D X Y: class):
  $ wi (wa (wa (wbr A2 B2 cslts) (wbr C D cslts)) (wa (wceq X (co A2 B2 ccuts)) (wceq Y (co C D ccuts)))) (wb (wbr X Y cles) (wa (wral d (wbr X (cv d) clts) D) (wral a (wbr (cv a) Y clts) A2))) $;

--| A comparison law for surreals considered as cuts of sets of surreals. Definition from [Conway] p. 4. Theorem 4 of [Alling] p. 186. Theorem 2.5 of [Gonshor] p. 9. (Contributed by Scott Fenton, 5-Dec-2025.)
theorem lesrecd {a d: setvar} (ph: wff a d) (A2 B2 C D X Y: class):
  $ wi ph (wbr A2 B2 cslts) $ >
  $ wi ph (wbr C D cslts) $ >
  $ wi ph (wceq X (co A2 B2 ccuts)) $ >
  $ wi ph (wceq Y (co C D ccuts)) $ >
  $ wi ph (wb (wbr X Y cles) (wa (wral d (wbr X (cv d) clts) D) (wral a (wbr (cv a) Y clts) A2))) $;

--| A comparison law for surreals considered as cuts of sets of surreals. (Contributed by Scott Fenton, 11-Dec-2021.)
theorem ltsrec {b c: setvar} (A2 B2 C D X Y: class):
  $ wi (wa (wa (wbr A2 B2 cslts) (wbr C D cslts)) (wa (wceq X (co A2 B2 ccuts)) (wceq Y (co C D ccuts)))) (wb (wbr X Y clts) (wo (wrex c (wbr X (cv c) cles) C) (wrex b (wbr (cv b) Y cles) B2))) $;

--| A comparison law for surreals considered as cuts of sets of surreals. (Contributed by Scott Fenton, 5-Dec-2025.)
theorem ltsrecd {b c: setvar} (ph: wff b c) (A2 B2 C D X Y: class):
  $ wi ph (wbr A2 B2 cslts) $ >
  $ wi ph (wbr C D cslts) $ >
  $ wi ph (wceq X (co A2 B2 ccuts)) $ >
  $ wi ph (wceq Y (co C D ccuts)) $ >
  $ wi ph (wb (wbr X Y clts) (wo (wrex c (wbr X (cv c) cles) C) (wrex b (wbr (cv b) Y cles) B2))) $;

--| If ` A ` preceeds ` B ` , then ` A ` and ` B ` are disjoint. (Contributed by Scott Fenton, 18-Sep-2024.)
theorem sltsdisj (A2 B2: class):
  $ wi (wbr A2 B2 cslts) (wceq (cin A2 B2) c0) $;

--| A variant of the simplicity theorem - if ` B ` lies between the cut sets of ` A ` but none of its options do, then ` A = B ` . Theorem 11 of [Conway] p. 23. (Contributed by Scott Fenton, 28-Nov-2025.)
theorem eqcuts3 {xO: setvar} (ph: wff) (A2 B2: class xO) (R S L M: class):
  $ wi ph (wbr L R cslts) $ >
  $ wi ph (wbr M S cslts) $ >
  $ wi ph (wceq A2 (co L R ccuts)) $ >
  $ wi ph (wceq B2 (co M S ccuts)) $ >
  $ wi ph (wbr L (csn B2) cslts) $ >
  $ wi ph (wbr (csn B2) R cslts) $ >
  $ wi ph (wral xO (wn (wa (wbr L (csn (cv xO)) cslts) (wbr (csn (cv xO)) R cslts))) (cun M S)) $ >
  $ wi ph (wceq A2 B2) $;

--| Declare the class syntax for surreal zero.
term c0s: class;

--| Declare the class syntax for surreal one.
term c1s: class;

--| Define surreal zero. This is the simplest cut of surreal number sets. Definition from [Conway] p. 17. (Contributed by Scott Fenton, 7-Aug-2024.)
axiom df_0s:
  $ wceq c0s (co c0 c0 ccuts) $;

--| Define surreal one. This is the simplest number greater than surreal zero. Definition from [Conway] p. 18. (Contributed by Scott Fenton, 7-Aug-2024.)
axiom df_1s:
  $ wceq c1s (co (csn c0s) c0 ccuts) $;

--| Surreal zero is a surreal. (Contributed by Scott Fenton, 7-Aug-2024.)
theorem _0no:
  $ wcel c0s csur $;

--| Surreal one is a surreal. (Contributed by Scott Fenton, 7-Aug-2024.)
theorem _1no:
  $ wcel c1s csur $;

--| Calculate the birthday of surreal zero. (Contributed by Scott Fenton, 7-Aug-2024.)
theorem bday0:
  $ wceq (cfv c0s cbday) c0 $;

--| Surreal zero is less than surreal one. Theorem from [Conway] p. 7. (Contributed by Scott Fenton, 7-Aug-2024.)
theorem _0lt1s:
  $ wbr c0s c1s clts $;

--| The only surreal with birthday ` (/) ` is ` 0s ` . (Contributed by Scott Fenton, 8-Aug-2024.)
theorem bday0b (X: class):
  $ wi (wcel X csur) (wb (wceq (cfv X cbday) c0) (wceq X c0s)) $;

--| The birthday of surreal one is ordinal one. (Contributed by Scott Fenton, 8-Aug-2024.)
theorem bday1:
  $ wceq (cfv c1s cbday) c1o $;

--| Condition for a surreal cut to equal zero. (Contributed by Scott Fenton, 3-Feb-2025.)
theorem cuteq0 (ph: wff) (A2 B2: class):
  $ wi ph (wbr A2 (csn c0s) cslts) $ >
  $ wi ph (wbr (csn c0s) B2 cslts) $ >
  $ wi ph (wceq (co A2 B2 ccuts) c0s) $;

--| The simplest number greater than a negative number is zero. (Contributed by Scott Fenton, 4-Sep-2025.)
theorem cutneg (ph: wff) (A2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wbr A2 c0s clts) $ >
  $ wi ph (wceq (co (csn A2) c0 ccuts) c0s) $;

--| Condition for a surreal cut to equal one. (Contributed by Scott Fenton, 12-Mar-2025.)
theorem cuteq1 (ph: wff) (A2 B2: class):
  $ wi ph (wcel c0s A2) $ >
  $ wi ph (wbr A2 (csn c1s) cslts) $ >
  $ wi ph (wbr (csn c1s) B2 cslts) $ >
  $ wi ph (wceq (co A2 B2 ccuts) c1s) $;

--| A positive surreal is not equal to zero. (Contributed by Scott Fenton, 12-Mar-2025.)
theorem gt0ne0s (A2: class):
  $ wi (wbr c0s A2 clts) (wne A2 c0s) $;

--| A positive surreal is not equal to zero. (Contributed by Scott Fenton, 12-Mar-2025.)
theorem gt0ne0sd (ph: wff) (A2: class):
  $ wi ph (wbr c0s A2 clts) $ >
  $ wi ph (wne A2 c0s) $;

--| Surreal zero does not equal surreal one. (Contributed by Scott Fenton, 5-Sep-2025.)
theorem _1ne0s:
  $ wne c1s c0s $;

--| A surreal is non-negative iff all its right options are positive. (Contributed by Scott Fenton, 1-Jan-2026.)
theorem rightge0 {xR: setvar} (ph: wff xR) (A2 B2 X: class):
  $ wi ph (wbr A2 B2 cslts) $ >
  $ wi ph (wceq X (co A2 B2 ccuts)) $ >
  $ wi ph (wb (wbr c0s X cles) (wral xR (wbr c0s (cv xR) clts) B2)) $;

--| Declare the symbol for the made by function.
term cmade: class;

--| Declare the symbol for the older than function.
term cold: class;

--| Declare the symbol for the new on function.
term cnew: class;

--| Declare the symbol for the left option function.
term cleft: class;

--| Declare the symbol for the right option function.
term cright: class;

--| Define the made by function. This function carries an ordinal to all surreals made by sections of surreals older than it. Definition from [Conway] p. 29. (Contributed by Scott Fenton, 17-Dec-2021.)
axiom df_made {f2: setvar}:
  $ wceq cmade (crecs (cmpt f2 cvv (cima ccuts (cxp (cpw (cuni (crn (cv f2)))) (cpw (cuni (crn (cv f2)))))))) $;

--| Define the older than function. This function carries an ordinal to all surreals made by a previous ordinal. Definition from [Conway] p. 29. (Contributed by Scott Fenton, 17-Dec-2021.)
axiom df_old {x3: setvar}:
  $ wceq cold (cmpt x3 con0 (cuni (cima cmade (cv x3)))) $;

--| Define the newer than function. This function carries an ordinal to all surreals made on that day. Definition from [Conway] p. 29. (Contributed by Scott Fenton, 17-Dec-2021.)
axiom df_new {x3: setvar}:
  $ wceq cnew (cmpt x3 con0 (cdif (cfv (cv x3) cmade) (cfv (cv x3) cold))) $;

--| Define the left options of a surreal. This is the set of surreals that are simpler and less than the given surreal. (Contributed by Scott Fenton, 6-Aug-2024.)
axiom df_left {x3 y1: setvar}:
  $ wceq cleft (cmpt x3 csur (crab y1 (wbr (cv y1) (cv x3) clts) (cfv (cfv (cv x3) cbday) cold))) $;

--| Define the right options of a surreal. This is the set of surreals that are simpler and greater than the given surreal. (Contributed by Scott Fenton, 6-Aug-2024.)
axiom df_right {x3 y1: setvar}:
  $ wceq cright (cmpt x3 csur (crab y1 (wbr (cv x3) (cv y1) clts) (cfv (cfv (cv x3) cbday) cold))) $;

--| The value of the made by function. (Contributed by Scott Fenton, 17-Dec-2021.)
theorem madeval (A2: class):
  $ wi (wcel A2 con0) (wceq (cfv A2 cmade) (cima ccuts (cxp (cpw (cuni (cima cmade A2))) (cpw (cuni (cima cmade A2)))))) $;

--| Alternative characterization of the made by function. (Contributed by Scott Fenton, 17-Dec-2021.)
theorem madeval2 {x3 a b: setvar} (A2: class):
  $ wi (wcel A2 con0) (wceq (cfv A2 cmade) (crab x3 (wrex a (wrex b (wa (wbr (cv a) (cv b) cslts) (wceq (co (cv a) (cv b) ccuts) (cv x3))) (cpw (cuni (cima cmade A2)))) (cpw (cuni (cima cmade A2)))) csur)) $;

--| The value of the old options function. (Contributed by Scott Fenton, 6-Aug-2024.)
theorem oldval (A2: class):
  $ wi (wcel A2 con0) (wceq (cfv A2 cold) (cuni (cima cmade A2))) $;

--| The value of the new options function. (Contributed by Scott Fenton, 9-Oct-2024.)
theorem newval (A2: class):
  $ wceq (cfv A2 cnew) (cdif (cfv A2 cmade) (cfv A2 cold)) $;

--| The made function is a function from ordinals to sets of surreals. (Contributed by Scott Fenton, 6-Aug-2024.)
theorem madef:
  $ wf con0 (cpw csur) cmade $;

--| The older function is a function from ordinals to sets of surreals. (Contributed by Scott Fenton, 6-Aug-2024.)
theorem oldf:
  $ wf con0 (cpw csur) cold $;

--| The new function is a function from ordinals to sets of surreals. (Contributed by Scott Fenton, 6-Aug-2024.)
theorem newf:
  $ wf con0 (cpw csur) cnew $;

--| No surreal is older than ` (/) ` . (Contributed by Scott Fenton, 7-Aug-2024.)
theorem old0:
  $ wceq (cfv c0 cold) c0 $;

--| Made sets are surreals. (Contributed by Scott Fenton, 9-Oct-2024.)
theorem madessno (A2: class):
  $ wss (cfv A2 cmade) csur $;

--| Old sets are surreals. (Contributed by Scott Fenton, 9-Oct-2024.)
theorem oldssno (A2: class):
  $ wss (cfv A2 cold) csur $;

--| New sets are surreals. (Contributed by Scott Fenton, 9-Oct-2024.)
theorem newssno (A2: class):
  $ wss (cfv A2 cnew) csur $;

--| An element of a made set is a surreal. (Contributed by Scott Fenton, 27-Feb-2026.)
theorem madeno (A2 B2: class):
  $ wi (wcel A2 (cfv B2 cmade)) (wcel A2 csur) $;

--| An element of an old set is a surreal. (Contributed by Scott Fenton, 27-Feb-2026.)
theorem oldno (A2 B2: class):
  $ wi (wcel A2 (cfv B2 cold)) (wcel A2 csur) $;

--| An element of a new set is a surreal. (Contributed by Scott Fenton, 27-Feb-2026.)
theorem newno (A2 B2: class):
  $ wi (wcel A2 (cfv B2 cnew)) (wcel A2 csur) $;

--| An element of a made set is a surreal. (Contributed by Scott Fenton, 27-Feb-2026.)
theorem madenod (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 (cfv B2 cmade)) $ >
  $ wi ph (wcel A2 csur) $;

--| An element of an old set is a surreal. (Contributed by Scott Fenton, 27-Feb-2026.)
theorem oldnod (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 (cfv B2 cold)) $ >
  $ wi ph (wcel A2 csur) $;

--| An element of a new set is a surreal. (Contributed by Scott Fenton, 27-Feb-2026.)
theorem newnod (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 (cfv B2 cnew)) $ >
  $ wi ph (wcel A2 csur) $;

--| The value of the left options function. (Contributed by Scott Fenton, 9-Oct-2024.)
theorem leftval {x3: setvar} (A2: class):
  $ wceq (cfv A2 cleft) (crab x3 (wbr (cv x3) A2 clts) (cfv (cfv A2 cbday) cold)) $;

--| The value of the right options function. (Contributed by Scott Fenton, 9-Oct-2024.)
theorem rightval {x3: setvar} (A2: class):
  $ wceq (cfv A2 cright) (crab x3 (wbr A2 (cv x3) clts) (cfv (cfv A2 cbday) cold)) $;

--| Membership in the left set of a surreal. (Contributed by Scott Fenton, 7-Nov-2025.)
theorem elleft (A2 B2: class):
  $ wb (wcel A2 (cfv B2 cleft)) (wa (wcel A2 (cfv (cfv B2 cbday) cold)) (wbr A2 B2 clts)) $;

--| Membership in the right set of a surreal. (Contributed by Scott Fenton, 7-Nov-2025.)
theorem elright (A2 B2: class):
  $ wb (wcel A2 (cfv B2 cright)) (wa (wcel A2 (cfv (cfv B2 cbday) cold)) (wbr B2 A2 clts)) $;

--| A member of a surreal's left set is less than it. (Contributed by Scott Fenton, 7-Nov-2025.)
theorem leftlt (A2 B2: class):
  $ wi (wcel A2 (cfv B2 cleft)) (wbr A2 B2 clts) $;

--| A member of a surreal's right set is greater than it. (Contributed by Scott Fenton, 7-Nov-2025.)
theorem rightgt (A2 B2: class):
  $ wi (wcel A2 (cfv B2 cright)) (wbr B2 A2 clts) $;

--| The functionality of the left options function. (Contributed by Scott Fenton, 6-Aug-2024.)
theorem leftf:
  $ wf csur (cpw csur) cleft $;

--| The functionality of the right options function. (Contributed by Scott Fenton, 6-Aug-2024.)
theorem rightf:
  $ wf csur (cpw csur) cright $;

--| Membership in the made function. (Contributed by Scott Fenton, 6-Aug-2024.)
theorem elmade {r l: setvar} (A2 X: class):
  $ wi (wcel A2 con0) (wb (wcel X (cfv A2 cmade)) (wrex l (wrex r (wa (wbr (cv l) (cv r) cslts) (wceq (co (cv l) (cv r) ccuts) X)) (cpw (cuni (cima cmade A2)))) (cpw (cuni (cima cmade A2))))) $;

--| Membership in the made function in terms of the old function. (Contributed by Scott Fenton, 7-Aug-2024.)
theorem elmade2 {r l: setvar} (A2 X: class):
  $ wi (wcel A2 con0) (wb (wcel X (cfv A2 cmade)) (wrex l (wrex r (wa (wbr (cv l) (cv r) cslts) (wceq (co (cv l) (cv r) ccuts) X)) (cpw (cfv A2 cold))) (cpw (cfv A2 cold)))) $;

--| Membership in an old set. (Contributed by Scott Fenton, 7-Aug-2024.)
theorem elold {b: setvar} (A2 X: class):
  $ wi (wcel A2 con0) (wb (wcel X (cfv A2 cold)) (wrex b (wcel X (cfv (cv b) cmade)) A2)) $;

--| A surreal is greater than its left options. Theorem 0(ii) of [Conway] p. 16. (Contributed by Scott Fenton, 7-Aug-2024.)
theorem sltsleft (A2: class):
  $ wi (wcel A2 csur) (wbr (cfv A2 cleft) (csn A2) cslts) $;

--| A surreal is less than its right options. Theorem 0(i) of [Conway] p. 16. (Contributed by Scott Fenton, 7-Aug-2024.)
theorem sltsright (A2: class):
  $ wi (wcel A2 csur) (wbr (csn A2) (cfv A2 cright) cslts) $;

--| The left options of a surreal are strictly less than the right options of the same surreal. (Contributed by Scott Fenton, 6-Aug-2024.) (Revised by Scott Fenton, 21-Feb-2025.)
theorem lltr (A2: class):
  $ wbr (cfv A2 cleft) (cfv A2 cright) cslts $;

--| The only surreal made on day ` (/) ` is ` 0s ` . (Contributed by Scott Fenton, 7-Aug-2024.)
theorem made0:
  $ wceq (cfv c0 cmade) (csn c0s) $;

--| The only surreal new on day ` (/) ` is ` 0s ` . (Contributed by Scott Fenton, 8-Aug-2024.)
theorem new0:
  $ wceq (cfv c0 cnew) (csn c0s) $;

--| The only surreal older than ` 1o ` is ` 0s ` . (Contributed by Scott Fenton, 4-Feb-2025.)
theorem old1:
  $ wceq (cfv c1o cold) (csn c0s) $;

--| If ` A ` is less than or equal to ordinal ` B ` , then the made set of ` A ` is included in the made set of ` B ` . (Contributed by Scott Fenton, 9-Oct-2024.)
theorem madess (A2 B2: class):
  $ wi (wa (wcel B2 con0) (wss A2 B2)) (wss (cfv A2 cmade) (cfv B2 cmade)) $;

--| The older-than set is a subset of the made set. (Contributed by Scott Fenton, 9-Oct-2024.)
theorem oldssmade (A2: class):
  $ wss (cfv A2 cold) (cfv A2 cmade) $;

--| An element of an old set is an element of a made set. (Contributed by Scott Fenton, 27-Feb-2026.)
theorem oldmade (A2 B2: class):
  $ wi (wcel A2 (cfv B2 cold)) (wcel A2 (cfv B2 cmade)) $;

--| An element of an old set is an element of a made set. (Contributed by Scott Fenton, 27-Feb-2026.)
theorem oldmaded (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 (cfv B2 cold)) $ >
  $ wi ph (wcel A2 (cfv B2 cmade)) $;

--| If ` A ` is less than or equal to ordinal ` B ` , then the old set of ` A ` is included in the made set of ` B ` . (Contributed by Scott Fenton, 9-Oct-2024.)
theorem oldss (A2 B2: class):
  $ wi (wa (wcel B2 con0) (wss A2 B2)) (wss (cfv A2 cold) (cfv B2 cold)) $;

--| The left options are a subset of the old set. (Contributed by Scott Fenton, 9-Oct-2024.)
theorem leftssold (X: class):
  $ wss (cfv X cleft) (cfv (cfv X cbday) cold) $;

--| The right options are a subset of the old set. (Contributed by Scott Fenton, 9-Oct-2024.)
theorem rightssold (X: class):
  $ wss (cfv X cright) (cfv (cfv X cbday) cold) $;

--| The left set of a surreal number is a subset of the surreals. (Contributed by Scott Fenton, 9-Oct-2024.)
theorem leftssno (A2: class):
  $ wss (cfv A2 cleft) csur $;

--| The right set of a surreal number is a subset of the surreals. (Contributed by Scott Fenton, 9-Oct-2024.)
theorem rightssno (A2: class):
  $ wss (cfv A2 cright) csur $;

--| An element of a left set is an element of the old set. (Contributed by Scott Fenton, 27-Feb-2026.)
theorem leftold (A2 B2: class):
  $ wi (wcel A2 (cfv B2 cleft)) (wcel A2 (cfv (cfv B2 cbday) cold)) $;

--| An element of a right set is an element of the old set. (Contributed by Scott Fenton, 27-Feb-2026.)
theorem rightold (A2 B2: class):
  $ wi (wcel A2 (cfv B2 cright)) (wcel A2 (cfv (cfv B2 cbday) cold)) $;

--| An element of a left set is a surreal. (Contributed by Scott Fenton, 27-Feb-2026.)
theorem leftno (A2 B2: class):
  $ wi (wcel A2 (cfv B2 cleft)) (wcel A2 csur) $;

--| An element of a right set is a surreal. (Contributed by Scott Fenton, 27-Feb-2026.)
theorem rightno (A2 B2: class):
  $ wi (wcel A2 (cfv B2 cright)) (wcel A2 csur) $;

--| An element of a left set is an element of the old set. (Contributed by Scott Fenton, 27-Feb-2026.)
theorem leftoldd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 (cfv B2 cleft)) $ >
  $ wi ph (wcel A2 (cfv (cfv B2 cbday) cold)) $;

--| An element of a left set is a surreal. (Contributed by Scott Fenton, 27-Feb-2026.)
theorem leftnod (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 (cfv B2 cleft)) $ >
  $ wi ph (wcel A2 csur) $;

--| An element of a right set is an element of the old set. (Contributed by Scott Fenton, 27-Feb-2026.)
theorem rightoldd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 (cfv B2 cright)) $ >
  $ wi ph (wcel A2 (cfv (cfv B2 cbday) cold)) $;

--| An element of a right set is a surreal. (Contributed by Scott Fenton, 27-Feb-2026.)
theorem rightnod (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 (cfv B2 cright)) $ >
  $ wi ph (wcel A2 csur) $;

--| Given a section that is a subset of an old set, the cut is a member of the made set. (Contributed by Scott Fenton, 7-Aug-2024.)
theorem madecut (A2 R L: class):
  $ wi (wa (wa (wcel A2 con0) (wbr L R cslts)) (wa (wss L (cfv A2 cold)) (wss R (cfv A2 cold)))) (wcel (co L R ccuts) (cfv A2 cmade)) $;

--| The made set is the union of the old set and the new set. (Contributed by Scott Fenton, 9-Oct-2024.)
theorem madeun (A2: class):
  $ wceq (cfv A2 cmade) (cun (cfv A2 cold) (cfv A2 cnew)) $;

--| The made set is the old set of its successor. (Contributed by Scott Fenton, 8-Aug-2024.)
theorem madeoldsuc (A2: class):
  $ wi (wcel A2 con0) (wceq (cfv A2 cmade) (cfv (csuc A2) cold)) $;

--| The value of the old set at a successor. (Contributed by Scott Fenton, 8-Aug-2024.)
theorem oldsuc (A2: class):
  $ wi (wcel A2 con0) (wceq (cfv (csuc A2) cold) (cun (cfv A2 cold) (cfv A2 cnew))) $;

--| The value of the old set at a limit ordinal. (Contributed by Scott Fenton, 8-Aug-2024.)
theorem oldlim (A2 V: class):
  $ wi (wa (wlim A2) (wcel A2 V)) (wceq (cfv A2 cold) (cuni (cima cold A2))) $;

--| If a surreal is a member of a made set, its birthday is less than or equal to the level. (Contributed by Scott Fenton, 10-Aug-2024.)
theorem madebdayim (A2 X: class):
  $ wi (wcel X (cfv A2 cmade)) (wss (cfv X cbday) A2) $;

--| If ` X ` is in the old set for ` A ` , then the birthday of ` X ` is less than ` A ` . (Contributed by Scott Fenton, 10-Aug-2024.)
theorem oldbdayim (A2 X: class):
  $ wi (wcel X (cfv A2 cold)) (wcel (cfv X cbday) A2) $;

--| No surreal is a member of its birthday's old set. (Contributed by Scott Fenton, 10-Aug-2024.)
theorem oldirr (X: class):
  $ wn (wcel X (cfv (cfv X cbday) cold)) $;

--| No surreal is a member of its left set. (Contributed by Scott Fenton, 9-Oct-2024.)
theorem leftirr (X: class):
  $ wn (wcel X (cfv X cleft)) $;

--| No surreal is a member of its right set. (Contributed by Scott Fenton, 9-Oct-2024.)
theorem rightirr (X: class):
  $ wn (wcel X (cfv X cright)) $;

--| The left set of ` 0s ` is empty. (Contributed by Scott Fenton, 20-Aug-2024.)
theorem left0s:
  $ wceq (cfv c0s cleft) c0 $;

--| The right set of ` 0s ` is empty. (Contributed by Scott Fenton, 20-Aug-2024.)
theorem right0s:
  $ wceq (cfv c0s cright) c0 $;

--| The left set of ` 1s ` is the singleton of ` 0s ` . (Contributed by Scott Fenton, 4-Feb-2025.)
theorem left1s:
  $ wceq (cfv c1s cleft) (csn c0s) $;

--| The right set of ` 1s ` is empty . (Contributed by Scott Fenton, 4-Feb-2025.)
theorem right1s:
  $ wceq (cfv c1s cright) c0 $;

--| The union of the left and right options of a surreal make its old set. (Contributed by Scott Fenton, 9-Oct-2024.)
theorem lrold (A2: class):
  $ wceq (cun (cfv A2 cleft) (cfv A2 cright)) (cfv (cfv A2 cbday) cold) $;

--| Lemma for ~ madebday . If the inductive hypothesis of ~ madebday is satisfied, the converse of ~ oldbdayim holds. (Contributed by Scott Fenton, 19-Aug-2024.)
theorem madebdaylemold {y1 b: setvar} (A2: class y1) (X: class):
  $ wi (w3a (wcel A2 con0) (wral b (wral y1 (wi (wss (cfv (cv y1) cbday) (cv b)) (wcel (cv y1) (cfv (cv b) cmade))) csur) A2) (wcel X csur)) (wi (wcel (cfv X cbday) A2) (wcel X (cfv A2 cold))) $;

--| Lemma for ~ madebday . If the inductive hypothesis of ~ madebday is satisfied up to the birthday of ` X ` , then the conclusion of ~ lrcut holds. (Contributed by Scott Fenton, 19-Aug-2024.)
theorem madebdaylemlrcut {y1 b: setvar} (X: class):
  $ wi (wa (wral b (wral y1 (wi (wss (cfv (cv y1) cbday) (cv b)) (wcel (cv y1) (cfv (cv b) cmade))) csur) (cfv X cbday)) (wcel X csur)) (wceq (co (cfv X cleft) (cfv X cright) ccuts) X) $;

--| A surreal is part of the set made by ordinal ` A ` iff its birthday is less than or equal to ` A ` . Remark in [Conway] p. 29. (Contributed by Scott Fenton, 19-Aug-2024.)
theorem madebday (A2 X: class):
  $ wi (wa (wcel A2 con0) (wcel X csur)) (wb (wcel X (cfv A2 cmade)) (wss (cfv X cbday) A2)) $;

--| A surreal is part of the set older than ordinal ` A ` iff its birthday is less than ` A ` . Remark in [Conway] p. 29. (Contributed by Scott Fenton, 19-Aug-2024.)
theorem oldbday (A2 X: class):
  $ wi (wa (wcel A2 con0) (wcel X csur)) (wb (wcel X (cfv A2 cold)) (wcel (cfv X cbday) A2)) $;

--| A surreal is an element of a new set iff its birthday is equal to that ordinal. Remark in [Conway] p. 29. (Contributed by Scott Fenton, 19-Aug-2024.)
theorem newbday (A2 X: class):
  $ wi (wa (wcel A2 con0) (wcel X csur)) (wb (wcel X (cfv A2 cnew)) (wceq (cfv X cbday) A2)) $;

--| One direction of the biconditional in ~ newbday . (Contributed by Scott Fenton, 7-Nov-2025.)
theorem newbdayim (A2 X: class):
  $ wi (wcel X (cfv A2 cnew)) (wceq (cfv X cbday) A2) $;

--| A surreal is equal to the cut of its left and right sets. (Contributed by Scott Fenton, 19-Aug-2024.)
theorem lrcut (X: class):
  $ wi (wcel X csur) (wceq (co (cfv X cleft) (cfv X cright) ccuts) X) $;

--| The surreal cut function is onto. (Contributed by Scott Fenton, 23-Aug-2024.)
theorem cutsfo:
  $ wfo cslts csur ccuts $;

--| If ` X ` is less than ` Y ` , then either ` ( _Left `` Y ) ` or ` ( _Right `` X ) ` is non-empty. (Contributed by Scott Fenton, 10-Dec-2024.)
theorem ltsn0 (X Y: class):
  $ wi (w3a (wcel X csur) (wcel Y csur) (wbr X Y clts)) (wo (wne (cfv Y cleft) c0) (wne (cfv X cright) c0)) $;

--| If two surreals share a birthday, then the union of their left and right sets are equal. (Contributed by Scott Fenton, 17-Sep-2024.)
theorem lruneq (X Y: class):
  $ wi (w3a (wcel X csur) (wcel Y csur) (wceq (cfv X cbday) (cfv Y cbday))) (wceq (cun (cfv X cleft) (cfv X cright)) (cun (cfv Y cleft) (cfv Y cright))) $;

--| If two surreals share a birthday, then ` X <s Y ` iff the left set of ` X ` is a proper subset of the left set of ` Y ` . (Contributed by Scott Fenton, 17-Sep-2024.)
theorem ltslpss (X Y: class):
  $ wi (w3a (wcel X csur) (wcel Y csur) (wceq (cfv X cbday) (cfv Y cbday))) (wb (wbr X Y clts) (wpss (cfv X cleft) (cfv Y cleft))) $;

--| If two surreals ` A ` and ` B ` share a birthday, then ` A <_s B ` if and only if the left set of ` A ` is a non-strict subset of the left set of ` B ` . (Contributed by Scott Fenton, 21-Mar-2025.)
theorem leslss (A2 B2: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wceq (cfv A2 cbday) (cfv B2 cbday))) (wb (wbr A2 B2 cles) (wss (cfv A2 cleft) (cfv B2 cleft))) $;

--| Zero is in the old set of any nonzero number. (Contributed by Scott Fenton, 13-Mar-2025.)
theorem _0elold (ph: wff) (A2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wne A2 c0s) $ >
  $ wi ph (wcel c0s (cfv (cfv A2 cbday) cold)) $;

--| Zero is in the left set of any positive number. (Contributed by Scott Fenton, 13-Mar-2025.)
theorem _0elleft (ph: wff) (A2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wbr c0s A2 clts) $ >
  $ wi ph (wcel c0s (cfv A2 cleft)) $;

--| Zero is in the right set of any negative number. (Contributed by Scott Fenton, 13-Mar-2025.)
theorem _0elright (ph: wff) (A2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wbr A2 c0s clts) $ >
  $ wi ph (wcel c0s (cfv A2 cright)) $;

--| The made set of an ordinal natural is finite. (Contributed by Scott Fenton, 20-Aug-2025.) (Proof shortened by Vincent Gonzalez, 19-Aug-2026.)
theorem madefi (A2: class):
  $ wi (wcel A2 com) (wcel (cfv A2 cmade) cfn) $;

--| The old set of an ordinal natural is finite. (Contributed by Scott Fenton, 20-Aug-2025.)
theorem oldfi (A2: class):
  $ wi (wcel A2 com) (wcel (cfv A2 cold) cfn) $;

--| The birthday of a surreal is the least upper bound of the successors of the birthdays of its options. This is the definition of the birthday of a combinatorial game in the Lean Combinatorial Game Theory library at ~ https://github.com/vihdzp/combinatorial-games . (Contributed by Scott Fenton, 22-Nov-2025.)
theorem bdayiun {x3: setvar} (A2: class):
  $ wi (wcel A2 csur) (wceq (cfv A2 cbday) (ciun x3 (cfv (cfv A2 cbday) cold) (csuc (cfv (cv x3) cbday)))) $;

--| A condition for bounding a birthday above. (Contributed by Scott Fenton, 22-Nov-2025.)
theorem bdayle {y1: setvar} (O X: class):
  $ wi (wa (wcel X csur) (word O)) (wb (wss (cfv X cbday) O) (wral y1 (wcel (cfv (cv y1) cbday) O) (cfv (cfv X cbday) cold))) $;

--| Birthday comparison rule for surreals. (Contributed by Scott Fenton, 23-Feb-2026.)
theorem sltsbday (ph: wff) (A2 B2 R L: class):
  $ wi ph (wceq A2 (co L R ccuts)) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wbr L (csn B2) cslts) $ >
  $ wi ph (wbr (csn B2) R cslts) $ >
  $ wi ph (wss (cfv A2 cbday) (cfv B2 cbday)) $;

--| If every element of ` A ` is bounded above by some element of ` B ` and ` B ` precedes ` C ` , then ` A ` precedes ` C ` . Note - we will often use the term "cofinal" to denote that every element of ` A ` is bounded above by some element of ` B ` . Similarly, we will use the term "coinitial" to denote that every element of ` A ` is bounded below by some element of ` B ` . (Contributed by Scott Fenton, 24-Sep-2024.)
theorem cofslts {x3 y1: setvar} (A2: class y1) (B2: class) (C: class x3 y1):
  $ wi (w3a (wcel A2 (cpw csur)) (wral x3 (wrex y1 (wbr (cv x3) (cv y1) cles) B2) A2) (wbr B2 C cslts)) (wbr A2 C cslts) $;

--| If ` B ` is coinitial with ` C ` and ` A ` precedes ` C ` , then ` A ` precedes ` B ` . (Contributed by Scott Fenton, 24-Sep-2024.)
theorem coinitslts {x3 y1: setvar} (A2: class x3 y1) (B2: class y1) (C: class):
  $ wi (w3a (wcel B2 (cpw csur)) (wral x3 (wrex y1 (wbr (cv y1) (cv x3) cles) C) B2) (wbr A2 C cslts)) (wbr A2 B2 cslts) $;

--| If ` C ` is cofinal with ` A ` and ` D ` is coinitial with ` B ` and the cut of ` A ` and ` B ` lies between ` C ` and ` D ` , then the cut of ` C ` and ` D ` is equal to the cut of ` A ` and ` B ` . Theorem 2.6 of [Gonshor] p. 10. (Contributed by Scott Fenton, 25-Sep-2024.)
theorem cofcut1 {x3 y1 z w: setvar} (A2: class y1 z w) (B2: class x3 y1 w) (C: class z w) (D: class x3 y1):
  $ wi (w3a (wbr A2 B2 cslts) (wa (wral x3 (wrex y1 (wbr (cv x3) (cv y1) cles) C) A2) (wral z (wrex w (wbr (cv w) (cv z) cles) D) B2)) (wa (wbr C (csn (co A2 B2 ccuts)) cslts) (wbr (csn (co A2 B2 ccuts)) D cslts))) (wceq (co A2 B2 ccuts) (co C D ccuts)) $;

--| If ` C ` is cofinal with ` A ` and ` D ` is coinitial with ` B ` and the cut of ` A ` and ` B ` lies between ` C ` and ` D ` , then the cut of ` C ` and ` D ` is equal to the cut of ` A ` and ` B ` . Theorem 2.6 of [Gonshor] p. 10. (Contributed by Scott Fenton, 25-Sep-2024.)
theorem cofcut1_b {x3 y1: setvar} (A2 B2: class y1) (C D: class):
  $ wi (w3a (wbr A2 B2 cslts) (wa (wral x3 (wrex y1 (wbr (cv x3) (cv y1) cles) C) A2) (wral x3 (wrex y1 (wbr (cv y1) (cv x3) cles) D) B2)) (wa (wbr C (csn (co A2 B2 ccuts)) cslts) (wbr (csn (co A2 B2 ccuts)) D cslts))) (wceq (co A2 B2 ccuts) (co C D ccuts)) $;

--| If ` C ` is cofinal with ` A ` and ` D ` is coinitial with ` B ` and the cut of ` A ` and ` B ` lies between ` C ` and ` D ` , then the cut of ` C ` and ` D ` is equal to the cut of ` A ` and ` B ` . Theorem 2.6 of [Gonshor] p. 10. (Contributed by Scott Fenton, 25-Sep-2024.)
theorem cofcut1_b1 {x3 y1: setvar} (A2: class y1) (B2: class x3) (C D: class):
  $ wi (w3a (wbr A2 B2 cslts) (wa (wral x3 (wrex y1 (wbr (cv x3) (cv y1) cles) C) A2) (wral y1 (wrex x3 (wbr (cv x3) (cv y1) cles) D) B2)) (wa (wbr C (csn (co A2 B2 ccuts)) cslts) (wbr (csn (co A2 B2 ccuts)) D cslts))) (wceq (co A2 B2 ccuts) (co C D ccuts)) $;

--| If ` C ` is cofinal with ` A ` and ` D ` is coinitial with ` B ` and the cut of ` A ` and ` B ` lies between ` C ` and ` D ` , then the cut of ` C ` and ` D ` is equal to the cut of ` A ` and ` B ` . Theorem 2.6 of [Gonshor] p. 10. (Contributed by Scott Fenton, 23-Jan-2025.)
theorem cofcut1d {x3 y1 z w: setvar} (ph: wff x3 y1 z w) (A2: class y1 z w) (B2: class x3 y1 w) (C: class z w) (D: class x3 y1):
  $ wi ph (wbr A2 B2 cslts) $ >
  $ wi ph (wral x3 (wrex y1 (wbr (cv x3) (cv y1) cles) C) A2) $ >
  $ wi ph (wral z (wrex w (wbr (cv w) (cv z) cles) D) B2) $ >
  $ wi ph (wbr C (csn (co A2 B2 ccuts)) cslts) $ >
  $ wi ph (wbr (csn (co A2 B2 ccuts)) D cslts) $ >
  $ wi ph (wceq (co A2 B2 ccuts) (co C D ccuts)) $;

--| If ` C ` is cofinal with ` A ` and ` D ` is coinitial with ` B ` and the cut of ` A ` and ` B ` lies between ` C ` and ` D ` , then the cut of ` C ` and ` D ` is equal to the cut of ` A ` and ` B ` . Theorem 2.6 of [Gonshor] p. 10. (Contributed by Scott Fenton, 23-Jan-2025.)
theorem cofcut1d_b {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class y1) (C D: class):
  $ wi ph (wbr A2 B2 cslts) $ >
  $ wi ph (wral x3 (wrex y1 (wbr (cv x3) (cv y1) cles) C) A2) $ >
  $ wi ph (wral x3 (wrex y1 (wbr (cv y1) (cv x3) cles) D) B2) $ >
  $ wi ph (wbr C (csn (co A2 B2 ccuts)) cslts) $ >
  $ wi ph (wbr (csn (co A2 B2 ccuts)) D cslts) $ >
  $ wi ph (wceq (co A2 B2 ccuts) (co C D ccuts)) $;

--| If ` C ` is cofinal with ` A ` and ` D ` is coinitial with ` B ` and the cut of ` A ` and ` B ` lies between ` C ` and ` D ` , then the cut of ` C ` and ` D ` is equal to the cut of ` A ` and ` B ` . Theorem 2.6 of [Gonshor] p. 10. (Contributed by Scott Fenton, 23-Jan-2025.)
theorem cofcut1d_b1 {x3 y1: setvar} (ph: wff x3 y1) (A2: class y1) (B2: class x3) (C D: class):
  $ wi ph (wbr A2 B2 cslts) $ >
  $ wi ph (wral x3 (wrex y1 (wbr (cv x3) (cv y1) cles) C) A2) $ >
  $ wi ph (wral y1 (wrex x3 (wbr (cv x3) (cv y1) cles) D) B2) $ >
  $ wi ph (wbr C (csn (co A2 B2 ccuts)) cslts) $ >
  $ wi ph (wbr (csn (co A2 B2 ccuts)) D cslts) $ >
  $ wi ph (wceq (co A2 B2 ccuts) (co C D ccuts)) $;

--| If ` A ` and ` C ` are mutually cofinal and ` B ` and ` D ` are mutually coinitial, then the cut of ` A ` and ` B ` is equal to the cut of ` C ` and ` D ` . Theorem 2.7 of [Gonshor] p. 10. (Contributed by Scott Fenton, 25-Sep-2024.)
theorem cofcut2 {x3 y1 z w u t s1 r: setvar} (A2: class y1 z w s1 r) (B2: class x3 y1 w u t) (C: class z w u s1 r) (D: class x3 y1 u t s1):
  $ wi (w3a (w3a (wbr A2 B2 cslts) (wcel C (cpw csur)) (wcel D (cpw csur))) (wa (wral x3 (wrex y1 (wbr (cv x3) (cv y1) cles) C) A2) (wral z (wrex w (wbr (cv w) (cv z) cles) D) B2)) (wa (wral t (wrex u (wbr (cv t) (cv u) cles) A2) C) (wral r (wrex s1 (wbr (cv s1) (cv r) cles) B2) D))) (wceq (co A2 B2 ccuts) (co C D ccuts)) $;

--| If ` A ` and ` C ` are mutually cofinal and ` B ` and ` D ` are mutually coinitial, then the cut of ` A ` and ` B ` is equal to the cut of ` C ` and ` D ` . Theorem 2.7 of [Gonshor] p. 10. (Contributed by Scott Fenton, 25-Sep-2024.)
theorem cofcut2_b {x3 y1: setvar} (A2 B2 C D: class):
  $ wi (w3a (w3a (wbr A2 B2 cslts) (wcel C (cpw csur)) (wcel D (cpw csur))) (wa (wral x3 (wrex y1 (wbr (cv x3) (cv y1) cles) C) A2) (wral x3 (wrex y1 (wbr (cv y1) (cv x3) cles) D) B2)) (wa (wral x3 (wrex y1 (wbr (cv x3) (cv y1) cles) A2) C) (wral x3 (wrex y1 (wbr (cv y1) (cv x3) cles) B2) D))) (wceq (co A2 B2 ccuts) (co C D ccuts)) $;

--| If ` A ` and ` C ` are mutually cofinal and ` B ` and ` D ` are mutually coinitial, then the cut of ` A ` and ` B ` is equal to the cut of ` C ` and ` D ` . Theorem 2.7 of [Gonshor] p. 10. (Contributed by Scott Fenton, 23-Jan-2025.)
theorem cofcut2d {x3 y1 z w u t s1 r: setvar} (ph: wff x3 y1 z w u t s1 r) (A2: class y1 z w s1 r) (B2: class x3 y1 w u t) (C: class z w u s1 r) (D: class x3 y1 u t s1):
  $ wi ph (wbr A2 B2 cslts) $ >
  $ wi ph (wcel C (cpw csur)) $ >
  $ wi ph (wcel D (cpw csur)) $ >
  $ wi ph (wral x3 (wrex y1 (wbr (cv x3) (cv y1) cles) C) A2) $ >
  $ wi ph (wral z (wrex w (wbr (cv w) (cv z) cles) D) B2) $ >
  $ wi ph (wral t (wrex u (wbr (cv t) (cv u) cles) A2) C) $ >
  $ wi ph (wral r (wrex s1 (wbr (cv s1) (cv r) cles) B2) D) $ >
  $ wi ph (wceq (co A2 B2 ccuts) (co C D ccuts)) $;

--| If ` A ` and ` C ` are mutually cofinal and ` B ` and ` D ` are mutually coinitial, then the cut of ` A ` and ` B ` is equal to the cut of ` C ` and ` D ` . Theorem 2.7 of [Gonshor] p. 10. (Contributed by Scott Fenton, 23-Jan-2025.)
theorem cofcut2d_b {x3 y1: setvar} (ph: wff x3 y1) (A2 B2 C D: class):
  $ wi ph (wbr A2 B2 cslts) $ >
  $ wi ph (wcel C (cpw csur)) $ >
  $ wi ph (wcel D (cpw csur)) $ >
  $ wi ph (wral x3 (wrex y1 (wbr (cv x3) (cv y1) cles) C) A2) $ >
  $ wi ph (wral x3 (wrex y1 (wbr (cv y1) (cv x3) cles) D) B2) $ >
  $ wi ph (wral x3 (wrex y1 (wbr (cv x3) (cv y1) cles) A2) C) $ >
  $ wi ph (wral x3 (wrex y1 (wbr (cv y1) (cv x3) cles) B2) D) $ >
  $ wi ph (wceq (co A2 B2 ccuts) (co C D ccuts)) $;

--| If ` X ` is the cut of ` A ` and ` B ` , then ` A ` is cofinal with ` ( _Left `` X ) ` and ` B ` is coinitial with ` ( _Right `` X ) ` . Theorem 2.9 of [Gonshor] p. 12. (Contributed by Scott Fenton, 25-Sep-2024.)
theorem cofcutr {x3 y1 z w: setvar} (A2 B2 X: class):
  $ wi (wa (wbr A2 B2 cslts) (wceq X (co A2 B2 ccuts))) (wa (wral x3 (wrex y1 (wbr (cv x3) (cv y1) cles) A2) (cfv X cleft)) (wral z (wrex w (wbr (cv w) (cv z) cles) B2) (cfv X cright))) $;

--| If ` X ` is the cut of ` A ` and ` B ` , then ` A ` is cofinal with ` ( _Left `` X ) ` . First half of theorem 2.9 of [Gonshor] p. 12. (Contributed by Scott Fenton, 23-Jan-2025.)
theorem cofcutr1d {x3 y1: setvar} (ph: wff x3 y1) (A2 B2 X: class):
  $ wi ph (wbr A2 B2 cslts) $ >
  $ wi ph (wceq X (co A2 B2 ccuts)) $ >
  $ wi ph (wral x3 (wrex y1 (wbr (cv x3) (cv y1) cles) A2) (cfv X cleft)) $;

--| If ` X ` is the cut of ` A ` and ` B ` , then ` B ` is coinitial with ` ( _Right `` X ) ` . Second half of theorem 2.9 of [Gonshor] p. 12. (Contributed by Scott Fenton, 25-Sep-2024.)
theorem cofcutr2d {z w: setvar} (ph: wff z w) (A2 B2 X: class):
  $ wi ph (wbr A2 B2 cslts) $ >
  $ wi ph (wceq X (co A2 B2 ccuts)) $ >
  $ wi ph (wral z (wrex w (wbr (cv w) (cv z) cles) B2) (cfv X cright)) $;

--| If ` X ` is the cut of ` A ` and ` B ` and all of ` A ` and ` B ` are older than ` X ` , then ` ( _Left `` X ) ` is cofinal with ` A ` and ` ( _Right `` X ) ` is coinitial with ` B ` . Note: we will call a cut where all of the elements of the cut are older than the cut itself a "timely" cut. Part of Theorem 4.02(12) of [Alling] p. 125. (Contributed by Scott Fenton, 27-Sep-2024.)
theorem cofcutrtime {x3 y1 z w: setvar} (A2 B2: class y1 w) (X: class):
  $ wi (w3a (wss (cun A2 B2) (cfv (cfv X cbday) cold)) (wbr A2 B2 cslts) (wceq X (co A2 B2 ccuts))) (wa (wral x3 (wrex y1 (wbr (cv x3) (cv y1) cles) (cfv X cleft)) A2) (wral z (wrex w (wbr (cv w) (cv z) cles) (cfv X cright)) B2)) $;

--| If ` X ` is a timely cut of ` A ` and ` B ` , then ` ( _Left `` X ) ` is cofinal with ` A ` . (Contributed by Scott Fenton, 23-Jan-2025.)
theorem cofcutrtime1d {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class y1) (X: class):
  $ wi ph (wss (cun A2 B2) (cfv (cfv X cbday) cold)) $ >
  $ wi ph (wbr A2 B2 cslts) $ >
  $ wi ph (wceq X (co A2 B2 ccuts)) $ >
  $ wi ph (wral x3 (wrex y1 (wbr (cv x3) (cv y1) cles) (cfv X cleft)) A2) $;

--| If ` X ` is a timely cut of ` A ` and ` B ` , then ` ( _Right `` X ) ` is coinitial with ` B ` . (Contributed by Scott Fenton, 23-Jan-2025.)
theorem cofcutrtime2d {z w: setvar} (ph: wff z w) (A2 B2: class w) (X: class):
  $ wi ph (wss (cun A2 B2) (cfv (cfv X cbday) cold)) $ >
  $ wi ph (wbr A2 B2 cslts) $ >
  $ wi ph (wceq X (co A2 B2 ccuts)) $ >
  $ wi ph (wral z (wrex w (wbr (cv w) (cv z) cles) (cfv X cright)) B2) $;

--| Cofinality for a subset. (Contributed by Scott Fenton, 13-Mar-2025.)
theorem cofss {x3 y1: setvar} (ph: wff x3 y1) (A2: class) (B2: class y1):
  $ wi ph (wss A2 csur) $ >
  $ wi ph (wss B2 A2) $ >
  $ wi ph (wral x3 (wrex y1 (wbr (cv x3) (cv y1) cles) A2) B2) $;

--| Coinitiality for a subset. (Contributed by Scott Fenton, 13-Mar-2025.)
theorem coiniss {x3 y1: setvar} (ph: wff x3 y1) (A2: class) (B2: class y1):
  $ wi ph (wss A2 csur) $ >
  $ wi ph (wss B2 A2) $ >
  $ wi ph (wral x3 (wrex y1 (wbr (cv y1) (cv x3) cles) A2) B2) $;

--| Eliminating all elements below a given element of a cut does not affect the cut. (Contributed by Scott Fenton, 13-Mar-2025.)
theorem cutlt {y1: setvar} (ph: wff y1) (A2 R: class y1) (L X: class):
  $ wi ph (wbr L R cslts) $ >
  $ wi ph (wceq A2 (co L R ccuts)) $ >
  $ wi ph (wcel X L) $ >
  $ wi ph (wceq A2 (co (cun (csn X) (crab y1 (wbr X (cv y1) clts) L)) R ccuts)) $;

--| Reduce the elements of a cut for a positive number. (Contributed by Scott Fenton, 13-Mar-2025.)
theorem cutpos {x3: setvar} (ph: wff x3) (A2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wbr c0s A2 clts) $ >
  $ wi ph (wceq A2 (co (cun (csn c0s) (crab x3 (wbr c0s (cv x3) clts) (cfv A2 cleft))) (cfv A2 cright) ccuts)) $;

--| If ` A ` has a maximum, then the maximum may be used alone in the cut. (Contributed by Scott Fenton, 20-Aug-2025.)
theorem cutmax {y1: setvar} (ph: wff) (A2 B2 X: class):
  $ wi ph (wbr A2 B2 cslts) $ >
  $ wi ph (wcel X A2) $ >
  $ wi ph (wral y1 (wbr (cv y1) X cles) A2) $ >
  $ wi ph (wceq (co A2 B2 ccuts) (co (csn X) B2 ccuts)) $;

--| If ` B ` has a minimum, then the minimum may be used alone in the cut. (Contributed by Scott Fenton, 20-Aug-2025.)
theorem cutmin {y1: setvar} (ph: wff) (A2 B2 X: class):
  $ wi ph (wbr A2 B2 cslts) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wral y1 (wbr X (cv y1) cles) B2) $ >
  $ wi ph (wceq (co A2 B2 ccuts) (co A2 (csn X) ccuts)) $;

--| If the left set of ` X ` has a maximum and the right set of ` X ` has a minimum, then ` X ` is equal to the cut of the maximum and the minimum. (Contributed by Scott Fenton, 23-Feb-2026.)
theorem cutminmax {x3 y1: setvar} (ph: wff x3 y1) (R: class x3) (L: class y1) (X: class):
  $ wi ph (wcel L (cfv X cleft)) $ >
  $ wi ph (wral x3 (wbr (cv x3) L cles) (cfv X cleft)) $ >
  $ wi ph (wcel R (cfv X cright)) $ >
  $ wi ph (wral y1 (wbr R (cv y1) cles) (cfv X cright)) $ >
  $ wi ph (wceq X (co (csn L) (csn R) ccuts)) $;

--| Declare the syntax for surreal recursion of one variable.
term cnorec (F: class): class;

--| Define the recursion generator for surreal functions of one variable. This generator creates a recursive function of surreals from their value on their left and right sets. (Contributed by Scott Fenton, 19-Aug-2024.)
axiom df_norec {x3 y1: setvar} (F: class):
  $ wceq (cnorec F) (cfrecs csur (copab x3 y1 (wcel (cv x3) (cun (cfv (cv y1) cleft) (cfv (cv y1) cright)))) F) $;

--| The next step in the development of the surreals is to establish induction and recursion across left and right sets. To that end, we are going to develop a relationship ` R ` that is founded, partial, and set-like across the surreals. This first theorem just establishes the value of ` R ` . (Contributed by Scott Fenton, 19-Aug-2024.)
theorem lrrecval {x3 y1: setvar} (A2 B2: class) (R: class x3 y1):
  $ wceq R (copab x3 y1 (wcel (cv x3) (cun (cfv (cv y1) cleft) (cfv (cv y1) cright)))) $ >
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wb (wbr A2 B2 R) (wcel A2 (cun (cfv B2 cleft) (cfv B2 cright)))) $;

--| Next, we establish an alternate expression for ` R ` . (Contributed by Scott Fenton, 19-Aug-2024.)
theorem lrrecval2 {x3 y1: setvar} (A2 B2: class) (R: class x3 y1):
  $ wceq R (copab x3 y1 (wcel (cv x3) (cun (cfv (cv y1) cleft) (cfv (cv y1) cright)))) $ >
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wb (wbr A2 B2 R) (wcel (cfv A2 cbday) (cfv B2 cbday))) $;

--| Now, we establish that ` R ` is a partial ordering on ` No ` . (Contributed by Scott Fenton, 19-Aug-2024.)
theorem lrrecpo {x3 y1: setvar} (R: class x3 y1):
  $ wceq R (copab x3 y1 (wcel (cv x3) (cun (cfv (cv y1) cleft) (cfv (cv y1) cright)))) $ >
  $ wpo csur R $;

--| Next, we show that ` R ` is set-like over ` No ` . (Contributed by Scott Fenton, 19-Aug-2024.)
theorem lrrecse {x3 y1: setvar} (R: class x3 y1):
  $ wceq R (copab x3 y1 (wcel (cv x3) (cun (cfv (cv y1) cleft) (cfv (cv y1) cright)))) $ >
  $ wse csur R $;

--| Now we show that ` R ` is founded over ` No ` . (Contributed by Scott Fenton, 19-Aug-2024.)
theorem lrrecfr {x3 y1: setvar} (R: class x3 y1):
  $ wceq R (copab x3 y1 (wcel (cv x3) (cun (cfv (cv y1) cleft) (cfv (cv y1) cright)))) $ >
  $ wfr csur R $;

--| Finally, we calculate the value of the predecessor class over ` R ` . (Contributed by Scott Fenton, 19-Aug-2024.)
theorem lrrecpred {x3 y1: setvar} (A2: class) (R: class x3 y1):
  $ wceq R (copab x3 y1 (wcel (cv x3) (cun (cfv (cv y1) cleft) (cfv (cv y1) cright)))) $ >
  $ wi (wcel A2 csur) (wceq (cpred csur R A2) (cun (cfv A2 cleft) (cfv A2 cright))) $;

--| Induction principle for a single surreal. If a property passes from a surreal's left and right sets to the surreal itself, then it holds for all surreals. (Contributed by Scott Fenton, 19-Aug-2024.)
theorem noinds {x3 y1: setvar} (ph: wff x3) (ps ch: wff y1) (A2: class y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wceq (cv x3) A2) (wb ph ch) $ >
  $ wi (wcel (cv x3) csur) (wi (wral y1 ps (cun (cfv (cv x3) cleft) (cfv (cv x3) cright))) ph) $ >
  $ wi (wcel A2 csur) ch $;

--| Surreal recursion over one variable is a function over the surreals. (Contributed by Scott Fenton, 19-Aug-2024.)
theorem norecfn (F G: class):
  $ wceq F (cnorec G) $ >
  $ wfn F csur $;

--| Calculate the value of the surreal recursion operation. (Contributed by Scott Fenton, 19-Aug-2024.)
theorem norecov (A2 F G: class):
  $ wceq F (cnorec G) $ >
  $ wi (wcel A2 csur) (wceq (cfv A2 F) (co A2 (cres F (cun (cfv A2 cleft) (cfv A2 cright))) G)) $;

--| Declare the syntax for surreal recursion on two arguments.
term cnorec2 (F: class): class;

--| Define surreal recursion on two variables. This function is key to the development of most of surreal numbers. (Contributed by Scott Fenton, 20-Aug-2024.)
axiom df_norec2 {a b c d: setvar} (F: class):
  $ wceq (cnorec2 F) (cfrecs (cxp csur csur) (copab a b (w3a (wcel (cv a) (cxp csur csur)) (wcel (cv b) (cxp csur csur)) (w3a (wo (wbr (cfv (cv a) c1st) (cfv (cv b) c1st) (copab c d (wcel (cv c) (cun (cfv (cv d) cleft) (cfv (cv d) cright))))) (wceq (cfv (cv a) c1st) (cfv (cv b) c1st))) (wo (wbr (cfv (cv a) c2nd) (cfv (cv b) c2nd) (copab c d (wcel (cv c) (cun (cfv (cv d) cleft) (cfv (cv d) cright))))) (wceq (cfv (cv a) c2nd) (cfv (cv b) c2nd))) (wne (cv a) (cv b))))) F) $;

--| To get through most of the textbook definitions in surreal numbers we will need recursion on two variables. This set of theorems sets up the preconditions for double recursion. This theorem establishes the partial ordering. (Contributed by Scott Fenton, 19-Aug-2024.)
theorem noxpordpo {x3 y1 a b: setvar} (R: class a b) (S: class x3 y1 a b):
  $ wceq R (copab a b (wcel (cv a) (cun (cfv (cv b) cleft) (cfv (cv b) cright)))) $ >
  $ wceq S (copab x3 y1 (w3a (wcel (cv x3) (cxp csur csur)) (wcel (cv y1) (cxp csur csur)) (w3a (wo (wbr (cfv (cv x3) c1st) (cfv (cv y1) c1st) R) (wceq (cfv (cv x3) c1st) (cfv (cv y1) c1st))) (wo (wbr (cfv (cv x3) c2nd) (cfv (cv y1) c2nd) R) (wceq (cfv (cv x3) c2nd) (cfv (cv y1) c2nd))) (wne (cv x3) (cv y1))))) $ >
  $ wpo (cxp csur csur) S $;

--| Next we establish the foundedness of the relationship. (Contributed by Scott Fenton, 19-Aug-2024.)
theorem noxpordfr {x3 y1 a b: setvar} (R: class a b) (S: class x3 y1 a b):
  $ wceq R (copab a b (wcel (cv a) (cun (cfv (cv b) cleft) (cfv (cv b) cright)))) $ >
  $ wceq S (copab x3 y1 (w3a (wcel (cv x3) (cxp csur csur)) (wcel (cv y1) (cxp csur csur)) (w3a (wo (wbr (cfv (cv x3) c1st) (cfv (cv y1) c1st) R) (wceq (cfv (cv x3) c1st) (cfv (cv y1) c1st))) (wo (wbr (cfv (cv x3) c2nd) (cfv (cv y1) c2nd) R) (wceq (cfv (cv x3) c2nd) (cfv (cv y1) c2nd))) (wne (cv x3) (cv y1))))) $ >
  $ wfr (cxp csur csur) S $;

--| Next we establish the set-like nature of the relationship. (Contributed by Scott Fenton, 19-Aug-2024.)
theorem noxpordse {x3 y1 a b: setvar} (R: class a b) (S: class x3 y1 a b):
  $ wceq R (copab a b (wcel (cv a) (cun (cfv (cv b) cleft) (cfv (cv b) cright)))) $ >
  $ wceq S (copab x3 y1 (w3a (wcel (cv x3) (cxp csur csur)) (wcel (cv y1) (cxp csur csur)) (w3a (wo (wbr (cfv (cv x3) c1st) (cfv (cv y1) c1st) R) (wceq (cfv (cv x3) c1st) (cfv (cv y1) c1st))) (wo (wbr (cfv (cv x3) c2nd) (cfv (cv y1) c2nd) R) (wceq (cfv (cv x3) c2nd) (cfv (cv y1) c2nd))) (wne (cv x3) (cv y1))))) $ >
  $ wse (cxp csur csur) S $;

--| Next we calculate the predecessor class of the relationship. (Contributed by Scott Fenton, 19-Aug-2024.)
theorem noxpordpred {x3 y1 a b: setvar} (A2 B2: class) (R: class a b) (S: class x3 y1 a b):
  $ wceq R (copab a b (wcel (cv a) (cun (cfv (cv b) cleft) (cfv (cv b) cright)))) $ >
  $ wceq S (copab x3 y1 (w3a (wcel (cv x3) (cxp csur csur)) (wcel (cv y1) (cxp csur csur)) (w3a (wo (wbr (cfv (cv x3) c1st) (cfv (cv y1) c1st) R) (wceq (cfv (cv x3) c1st) (cfv (cv y1) c1st))) (wo (wbr (cfv (cv x3) c2nd) (cfv (cv y1) c2nd) R) (wceq (cfv (cv x3) c2nd) (cfv (cv y1) c2nd))) (wne (cv x3) (cv y1))))) $ >
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wceq (cpred (cxp csur csur) S (cop A2 B2)) (cdif (cxp (cun (cun (cfv A2 cleft) (cfv A2 cright)) (csn A2)) (cun (cun (cfv B2 cleft) (cfv B2 cright)) (csn B2))) (csn (cop A2 B2)))) $;

--| Double induction on surreals with explicit notation for the relationships. (Contributed by Scott Fenton, 22-Aug-2024.)
theorem no2indlesm {x3 y1 z w a b: setvar} (ph: wff x3 y1 w a b) (ps: wff y1 z a b) (ch: wff x3 z w a b) (th: wff x3 y1 w a b) (ta: wff y1 z w a b) (et: wff x3 z w a b) (A2: class z w a b) (B2: class x3 z w a b) (R: class a b):
  $ wceq R (copab a b (wcel (cv a) (cun (cfv (cv b) cleft) (cfv (cv b) cright)))) $ >
  $ wi (wceq (cv x3) (cv z)) (wb ph ps) $ >
  $ wi (wceq (cv y1) (cv w)) (wb ps ch) $ >
  $ wi (wceq (cv x3) (cv z)) (wb th ch) $ >
  $ wi (wceq (cv x3) A2) (wb ph ta) $ >
  $ wi (wceq (cv y1) B2) (wb ta et) $ >
  $ wi (wa (wcel (cv x3) csur) (wcel (cv y1) csur)) (wi (w3a (wral z (wral w ch (cun (cfv (cv y1) cleft) (cfv (cv y1) cright))) (cun (cfv (cv x3) cleft) (cfv (cv x3) cright))) (wral z ps (cun (cfv (cv x3) cleft) (cfv (cv x3) cright))) (wral w th (cun (cfv (cv y1) cleft) (cfv (cv y1) cright)))) ph) $ >
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) et $;

--| Double induction on surreals. The many substitution instances are to cover all possible cases. (Contributed by Scott Fenton, 22-Aug-2024.)
theorem no2inds {x3 y1 z w: setvar} (ph: wff x3 y1 w) (ps: wff y1 z) (ch: wff x3 z w) (th: wff x3 y1 w) (ta: wff y1 z w) (et: wff x3 z w) (A2: class z w) (B2: class x3 z w):
  $ wi (wceq (cv x3) (cv z)) (wb ph ps) $ >
  $ wi (wceq (cv y1) (cv w)) (wb ps ch) $ >
  $ wi (wceq (cv x3) (cv z)) (wb th ch) $ >
  $ wi (wceq (cv x3) A2) (wb ph ta) $ >
  $ wi (wceq (cv y1) B2) (wb ta et) $ >
  $ wi (wa (wcel (cv x3) csur) (wcel (cv y1) csur)) (wi (w3a (wral z (wral w ch (cun (cfv (cv y1) cleft) (cfv (cv y1) cright))) (cun (cfv (cv x3) cleft) (cfv (cv x3) cright))) (wral z ps (cun (cfv (cv x3) cleft) (cfv (cv x3) cright))) (wral w th (cun (cfv (cv y1) cleft) (cfv (cv y1) cright)))) ph) $ >
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) et $;

--| The double-recursion operator on surreals yields a function on pairs of surreals. (Contributed by Scott Fenton, 20-Aug-2024.)
theorem norec2fn (F G: class):
  $ wceq F (cnorec2 G) $ >
  $ wfn F (cxp csur csur) $;

--| The value of the double-recursion surreal function. (Contributed by Scott Fenton, 20-Aug-2024.)
theorem norec2ov (A2 B2 F G: class):
  $ wceq F (cnorec2 G) $ >
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wceq (co A2 B2 F) (co (cop A2 B2) (cres F (cdif (cxp (cun (cun (cfv A2 cleft) (cfv A2 cright)) (csn A2)) (cun (cun (cfv B2 cleft) (cfv B2 cright)) (csn B2))) (csn (cop A2 B2)))) G)) $;

--| Triple induction over surreal numbers. (Contributed by Scott Fenton, 9-Oct-2024.)
theorem no3inds {e f2 a b c d: setvar} (ph: wff e f2 a b c) (ps: wff f2 b c d) (ch: wff e a c d) (th: wff e f2 d) (ta: wff e f2 a b c) (et ze: wff f2 a b c d) (si: wff e a b c d) (rh: wff e f2 b c d) (mu: wff e f2 a c d) (la: wff e f2 a b d) (X Y Z: class):
  $ wi (wceq (cv a) (cv d)) (wb ph ps) $ >
  $ wi (wceq (cv b) (cv e)) (wb ps ch) $ >
  $ wi (wceq (cv c) (cv f2)) (wb ch th) $ >
  $ wi (wceq (cv a) (cv d)) (wb ta th) $ >
  $ wi (wceq (cv b) (cv e)) (wb et ta) $ >
  $ wi (wceq (cv b) (cv e)) (wb ze th) $ >
  $ wi (wceq (cv c) (cv f2)) (wb si ta) $ >
  $ wi (wceq (cv a) X) (wb ph rh) $ >
  $ wi (wceq (cv b) Y) (wb rh mu) $ >
  $ wi (wceq (cv c) Z) (wb mu la) $ >
  $ wi (w3a (wcel (cv a) csur) (wcel (cv b) csur) (wcel (cv c) csur)) (wi (w3a (w3a (wral d (wral e (wral f2 th (cun (cfv (cv c) cleft) (cfv (cv c) cright))) (cun (cfv (cv b) cleft) (cfv (cv b) cright))) (cun (cfv (cv a) cleft) (cfv (cv a) cright))) (wral d (wral e ch (cun (cfv (cv b) cleft) (cfv (cv b) cright))) (cun (cfv (cv a) cleft) (cfv (cv a) cright))) (wral d (wral f2 ze (cun (cfv (cv c) cleft) (cfv (cv c) cright))) (cun (cfv (cv a) cleft) (cfv (cv a) cright)))) (w3a (wral d ps (cun (cfv (cv a) cleft) (cfv (cv a) cright))) (wral e (wral f2 ta (cun (cfv (cv c) cleft) (cfv (cv c) cright))) (cun (cfv (cv b) cleft) (cfv (cv b) cright))) (wral e si (cun (cfv (cv b) cleft) (cfv (cv b) cright)))) (wral f2 et (cun (cfv (cv c) cleft) (cfv (cv c) cright)))) ph) $ >
  $ wi (w3a (wcel X csur) (wcel Y csur) (wcel Z csur)) la $;

--| Declare the syntax for surreal addition.
term cadds: class;

--| Define surreal addition. This is the first of the field operations on the surreals. Definition from [Conway] p. 5. Definition from [Gonshor] p. 13. (Contributed by Scott Fenton, 20-Aug-2024.)
axiom df_adds {x3 y1 z r a l: setvar}:
  $ wceq cadds (cnorec2 (cmpo x3 a cvv cvv (co (cun (cab y1 (wrex l (wceq (cv y1) (co (cv l) (cfv (cv x3) c2nd) (cv a))) (cfv (cfv (cv x3) c1st) cleft))) (cab z (wrex l (wceq (cv z) (co (cfv (cv x3) c1st) (cv l) (cv a))) (cfv (cfv (cv x3) c2nd) cleft)))) (cun (cab y1 (wrex r (wceq (cv y1) (co (cv r) (cfv (cv x3) c2nd) (cv a))) (cfv (cfv (cv x3) c1st) cright))) (cab z (wrex r (wceq (cv z) (co (cfv (cv x3) c1st) (cv r) (cv a))) (cfv (cfv (cv x3) c2nd) cright)))) ccuts))) $;

--| Surreal addition is a function over pairs of surreals. (Contributed by Scott Fenton, 20-Aug-2024.)
theorem addsfn:
  $ wfn cadds (cxp csur csur) $;

--| The value of surreal addition. Definition from [Conway] p. 5. (Contributed by Scott Fenton, 20-Aug-2024.)
theorem addsval {y1 z r l: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wceq (co A2 B2 cadds) (co (cun (cab y1 (wrex l (wceq (cv y1) (co (cv l) B2 cadds)) (cfv A2 cleft))) (cab z (wrex l (wceq (cv z) (co A2 (cv l) cadds)) (cfv B2 cleft)))) (cun (cab y1 (wrex r (wceq (cv y1) (co (cv r) B2 cadds)) (cfv A2 cright))) (cab z (wrex r (wceq (cv z) (co A2 (cv r) cadds)) (cfv B2 cright)))) ccuts)) $;

--| The value of surreal addition with different choices for each bound variable. Definition from [Conway] p. 5. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem addsval2 {y1 z w t m s1 r l: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wceq (co A2 B2 cadds) (co (cun (cab y1 (wrex l (wceq (cv y1) (co (cv l) B2 cadds)) (cfv A2 cleft))) (cab z (wrex m (wceq (cv z) (co A2 (cv m) cadds)) (cfv B2 cleft)))) (cun (cab w (wrex r (wceq (cv w) (co (cv r) B2 cadds)) (cfv A2 cright))) (cab t (wrex s1 (wceq (cv t) (co A2 (cv s1) cadds)) (cfv B2 cright)))) ccuts)) $;

--| The value of surreal addition with different choices for each bound variable. Definition from [Conway] p. 5. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem addsval2_b {y1 m r l: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wceq (co A2 B2 cadds) (co (cun (cab y1 (wrex l (wceq (cv y1) (co (cv l) B2 cadds)) (cfv A2 cleft))) (cab y1 (wrex m (wceq (cv y1) (co A2 (cv m) cadds)) (cfv B2 cleft)))) (cun (cab y1 (wrex r (wceq (cv y1) (co (cv r) B2 cadds)) (cfv A2 cright))) (cab y1 (wrex m (wceq (cv y1) (co A2 (cv m) cadds)) (cfv B2 cright)))) ccuts)) $;

--| The value of surreal addition with different choices for each bound variable. Definition from [Conway] p. 5. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem addsval2_b1 {y1 m s1 r l: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wceq (co A2 B2 cadds) (co (cun (cab y1 (wrex l (wceq (cv y1) (co (cv l) B2 cadds)) (cfv A2 cleft))) (cab y1 (wrex m (wceq (cv y1) (co A2 (cv m) cadds)) (cfv B2 cleft)))) (cun (cab y1 (wrex r (wceq (cv y1) (co (cv r) B2 cadds)) (cfv A2 cright))) (cab y1 (wrex s1 (wceq (cv y1) (co A2 (cv s1) cadds)) (cfv B2 cright)))) ccuts)) $;

--| Surreal addition to zero is identity. Part of Theorem 3 of [Conway] p. 17. (Contributed by Scott Fenton, 20-Aug-2024.)
theorem addsrid (A2: class):
  $ wi (wcel A2 csur) (wceq (co A2 c0s cadds) A2) $;

--| Surreal addition to zero is identity. Part of Theorem 3 of [Conway] p. 17. (Contributed by Scott Fenton, 20-Aug-2024.)
theorem addsridd (ph: wff) (A2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wceq (co A2 c0s cadds) A2) $;

--| Surreal addition is commutative. Part of Theorem 3 of [Conway] p. 17. (Contributed by Scott Fenton, 20-Aug-2024.)
theorem addscom (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wceq (co A2 B2 cadds) (co B2 A2 cadds)) $;

--| Surreal addition is commutative. Part of Theorem 3 of [Conway] p. 17. (Contributed by Scott Fenton, 20-Aug-2024.)
theorem addscomd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wceq (co A2 B2 cadds) (co B2 A2 cadds)) $;

--| Surreal addition to zero is identity. (Contributed by Scott Fenton, 3-Feb-2025.)
theorem addslid (A2: class):
  $ wi (wcel A2 csur) (wceq (co c0s A2 cadds) A2) $;

--| Lemma for surreal addition properties. To prove closure on surreal addition we need to prove that addition is compatible with order at the same time. We do this by inducting over the maximum of two natural sums of the birthdays of surreals numbers. In the final step we will loop around and use ~ tfr3 to prove this of all surreals. This first lemma just instantiates the inductive hypothesis so we do not need to do it continuously throughout the proof. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem addsproplem1 {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2: class) (B2: class x3) (C: class x3 y1) (X Y Z: class):
  $ wi ph (wral x3 (wral y1 (wral z (wi (wcel (cun (co (cfv (cv x3) cbday) (cfv (cv y1) cbday) cnadd) (co (cfv (cv x3) cbday) (cfv (cv z) cbday) cnadd)) (cun (co (cfv X cbday) (cfv Y cbday) cnadd) (co (cfv X cbday) (cfv Z cbday) cnadd))) (wa (wcel (co (cv x3) (cv y1) cadds) csur) (wi (wbr (cv y1) (cv z) clts) (wbr (co (cv y1) (cv x3) cadds) (co (cv z) (cv x3) cadds) clts)))) csur) csur) csur) $ >
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wcel (cun (co (cfv A2 cbday) (cfv B2 cbday) cnadd) (co (cfv A2 cbday) (cfv C cbday) cnadd)) (cun (co (cfv X cbday) (cfv Y cbday) cnadd) (co (cfv X cbday) (cfv Z cbday) cnadd))) $ >
  $ wi ph (wa (wcel (co A2 B2 cadds) csur) (wi (wbr B2 C clts) (wbr (co B2 A2 cadds) (co C A2 cadds) clts))) $;

--| Lemma for surreal addition properties. When proving closure for operations defined using ` norec ` and ` norec2 ` , it is a strictly stronger statement to say that the cut defined is actually a cut than it is to say that the operation is closed. We will often prove this stronger statement. Here, we do so for the cut involved in surreal addition. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem addsproplem2 {x3 y1 z w t m s1 r q p l: setvar} (ph: wff x3 y1 z) (X Y: class) (Z: class w t m s1 r q p l):
  $ wi ph (wral x3 (wral y1 (wral z (wi (wcel (cun (co (cfv (cv x3) cbday) (cfv (cv y1) cbday) cnadd) (co (cfv (cv x3) cbday) (cfv (cv z) cbday) cnadd)) (cun (co (cfv X cbday) (cfv Y cbday) cnadd) (co (cfv X cbday) (cfv Z cbday) cnadd))) (wa (wcel (co (cv x3) (cv y1) cadds) csur) (wi (wbr (cv y1) (cv z) clts) (wbr (co (cv y1) (cv x3) cadds) (co (cv z) (cv x3) cadds) clts)))) csur) csur) csur) $ >
  $ wi ph (wcel X csur) $ >
  $ wi ph (wcel Y csur) $ >
  $ wi ph (wbr (cun (cab p (wrex l (wceq (cv p) (co (cv l) Y cadds)) (cfv X cleft))) (cab q (wrex m (wceq (cv q) (co X (cv m) cadds)) (cfv Y cleft)))) (cun (cab w (wrex r (wceq (cv w) (co (cv r) Y cadds)) (cfv X cright))) (cab t (wrex s1 (wceq (cv t) (co X (cv s1) cadds)) (cfv Y cright)))) cslts) $;

--| Lemma for surreal addition properties. Show the cut properties of surreal addition. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem addsproplem3 {x3 y1 z w t m s1 r q p l: setvar} (ph: wff x3 y1 z) (X Y: class) (Z: class w t m s1 r q p l):
  $ wi ph (wral x3 (wral y1 (wral z (wi (wcel (cun (co (cfv (cv x3) cbday) (cfv (cv y1) cbday) cnadd) (co (cfv (cv x3) cbday) (cfv (cv z) cbday) cnadd)) (cun (co (cfv X cbday) (cfv Y cbday) cnadd) (co (cfv X cbday) (cfv Z cbday) cnadd))) (wa (wcel (co (cv x3) (cv y1) cadds) csur) (wi (wbr (cv y1) (cv z) clts) (wbr (co (cv y1) (cv x3) cadds) (co (cv z) (cv x3) cadds) clts)))) csur) csur) csur) $ >
  $ wi ph (wcel X csur) $ >
  $ wi ph (wcel Y csur) $ >
  $ wi ph (w3a (wcel (co X Y cadds) csur) (wbr (cun (cab p (wrex l (wceq (cv p) (co (cv l) Y cadds)) (cfv X cleft))) (cab q (wrex m (wceq (cv q) (co X (cv m) cadds)) (cfv Y cleft)))) (csn (co X Y cadds)) cslts) (wbr (csn (co X Y cadds)) (cun (cab w (wrex r (wceq (cv w) (co (cv r) Y cadds)) (cfv X cright))) (cab t (wrex s1 (wceq (cv t) (co X (cv s1) cadds)) (cfv Y cright)))) cslts)) $;

--| Lemma for surreal addition properties. Show the second half of the inductive hypothesis when ` Y ` is older than ` Z ` . (Contributed by Scott Fenton, 21-Jan-2025.)
theorem addsproplem4 {x3 y1 z: setvar} (ph: wff x3 y1 z) (X Y Z: class):
  $ wi ph (wral x3 (wral y1 (wral z (wi (wcel (cun (co (cfv (cv x3) cbday) (cfv (cv y1) cbday) cnadd) (co (cfv (cv x3) cbday) (cfv (cv z) cbday) cnadd)) (cun (co (cfv X cbday) (cfv Y cbday) cnadd) (co (cfv X cbday) (cfv Z cbday) cnadd))) (wa (wcel (co (cv x3) (cv y1) cadds) csur) (wi (wbr (cv y1) (cv z) clts) (wbr (co (cv y1) (cv x3) cadds) (co (cv z) (cv x3) cadds) clts)))) csur) csur) csur) $ >
  $ wi ph (wcel X csur) $ >
  $ wi ph (wcel Y csur) $ >
  $ wi ph (wcel Z csur) $ >
  $ wi ph (wbr Y Z clts) $ >
  $ wi ph (wcel (cfv Y cbday) (cfv Z cbday)) $ >
  $ wi ph (wbr (co Y X cadds) (co Z X cadds) clts) $;

--| Lemma for surreal addition properties. Show the second half of the inductive hypothesis when ` Z ` is older than ` Y ` . (Contributed by Scott Fenton, 21-Jan-2025.)
theorem addsproplem5 {x3 y1 z: setvar} (ph: wff x3 y1 z) (X Y Z: class):
  $ wi ph (wral x3 (wral y1 (wral z (wi (wcel (cun (co (cfv (cv x3) cbday) (cfv (cv y1) cbday) cnadd) (co (cfv (cv x3) cbday) (cfv (cv z) cbday) cnadd)) (cun (co (cfv X cbday) (cfv Y cbday) cnadd) (co (cfv X cbday) (cfv Z cbday) cnadd))) (wa (wcel (co (cv x3) (cv y1) cadds) csur) (wi (wbr (cv y1) (cv z) clts) (wbr (co (cv y1) (cv x3) cadds) (co (cv z) (cv x3) cadds) clts)))) csur) csur) csur) $ >
  $ wi ph (wcel X csur) $ >
  $ wi ph (wcel Y csur) $ >
  $ wi ph (wcel Z csur) $ >
  $ wi ph (wbr Y Z clts) $ >
  $ wi ph (wcel (cfv Z cbday) (cfv Y cbday)) $ >
  $ wi ph (wbr (co Y X cadds) (co Z X cadds) clts) $;

--| Lemma for surreal addition properties. Finally, we show the second half of the induction hypothesis when ` Y ` and ` Z ` are the same age. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem addsproplem6 {x3 y1 z: setvar} (ph: wff x3 y1 z) (X Y Z: class):
  $ wi ph (wral x3 (wral y1 (wral z (wi (wcel (cun (co (cfv (cv x3) cbday) (cfv (cv y1) cbday) cnadd) (co (cfv (cv x3) cbday) (cfv (cv z) cbday) cnadd)) (cun (co (cfv X cbday) (cfv Y cbday) cnadd) (co (cfv X cbday) (cfv Z cbday) cnadd))) (wa (wcel (co (cv x3) (cv y1) cadds) csur) (wi (wbr (cv y1) (cv z) clts) (wbr (co (cv y1) (cv x3) cadds) (co (cv z) (cv x3) cadds) clts)))) csur) csur) csur) $ >
  $ wi ph (wcel X csur) $ >
  $ wi ph (wcel Y csur) $ >
  $ wi ph (wcel Z csur) $ >
  $ wi ph (wbr Y Z clts) $ >
  $ wi ph (wceq (cfv Y cbday) (cfv Z cbday)) $ >
  $ wi ph (wbr (co Y X cadds) (co Z X cadds) clts) $;

--| Lemma for surreal addition properties. Putting together the three previous lemmas, we now show the second half of the inductive hypothesis unconditionally. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem addsproplem7 {x3 y1 z: setvar} (ph: wff x3 y1 z) (X Y Z: class):
  $ wi ph (wral x3 (wral y1 (wral z (wi (wcel (cun (co (cfv (cv x3) cbday) (cfv (cv y1) cbday) cnadd) (co (cfv (cv x3) cbday) (cfv (cv z) cbday) cnadd)) (cun (co (cfv X cbday) (cfv Y cbday) cnadd) (co (cfv X cbday) (cfv Z cbday) cnadd))) (wa (wcel (co (cv x3) (cv y1) cadds) csur) (wi (wbr (cv y1) (cv z) clts) (wbr (co (cv y1) (cv x3) cadds) (co (cv z) (cv x3) cadds) clts)))) csur) csur) csur) $ >
  $ wi ph (wcel X csur) $ >
  $ wi ph (wcel Y csur) $ >
  $ wi ph (wcel Z csur) $ >
  $ wi ph (wbr Y Z clts) $ >
  $ wi ph (wbr (co Y X cadds) (co Z X cadds) clts) $;

--| Inductively show that surreal addition is closed and compatible with less-than. This proof follows from induction on the birthdays of the surreal numbers involved. This pattern occurs throughout surreal development. Theorem 3.1 of [Gonshor] p. 14. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem addsprop (X Y Z: class):
  $ wi (w3a (wcel X csur) (wcel Y csur) (wcel Z csur)) (wa (wcel (co X Y cadds) csur) (wi (wbr Y Z clts) (wbr (co Y X cadds) (co Z X cadds) clts))) $;

--| Lemma for ~ addcuts . Show the statement with some additional distinct variable conditions. (Contributed by Scott Fenton, 8-Mar-2025.)
theorem addcutslem {w t m s1 r q p l: setvar} (ph: wff) (X Y: class):
  $ wi ph (wcel X csur) $ >
  $ wi ph (wcel Y csur) $ >
  $ wi ph (w3a (wcel (co X Y cadds) csur) (wbr (cun (cab p (wrex l (wceq (cv p) (co (cv l) Y cadds)) (cfv X cleft))) (cab q (wrex m (wceq (cv q) (co X (cv m) cadds)) (cfv Y cleft)))) (csn (co X Y cadds)) cslts) (wbr (csn (co X Y cadds)) (cun (cab w (wrex r (wceq (cv w) (co (cv r) Y cadds)) (cfv X cright))) (cab t (wrex s1 (wceq (cv t) (co X (cv s1) cadds)) (cfv Y cright)))) cslts)) $;

--| Demonstrate the cut properties of surreal addition. This gives us closure together with a pair of set-less-than relationships for surreal addition. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem addcuts {w t m s1 r q p l: setvar} (ph: wff w t m s1 r q p l) (X Y: class):
  $ wi ph (wcel X csur) $ >
  $ wi ph (wcel Y csur) $ >
  $ wi ph (w3a (wcel (co X Y cadds) csur) (wbr (cun (cab p (wrex l (wceq (cv p) (co (cv l) Y cadds)) (cfv X cleft))) (cab q (wrex m (wceq (cv q) (co X (cv m) cadds)) (cfv Y cleft)))) (csn (co X Y cadds)) cslts) (wbr (csn (co X Y cadds)) (cun (cab w (wrex r (wceq (cv w) (co (cv r) Y cadds)) (cfv X cright))) (cab t (wrex s1 (wceq (cv t) (co X (cv s1) cadds)) (cfv Y cright)))) cslts)) $;

--| Demonstrate the cut properties of surreal addition. This gives us closure together with a pair of set-less-than relationships for surreal addition. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem addcuts_b {w m r l: setvar} (ph: wff w m r l) (X Y: class):
  $ wi ph (wcel X csur) $ >
  $ wi ph (wcel Y csur) $ >
  $ wi ph (w3a (wcel (co X Y cadds) csur) (wbr (cun (cab w (wrex l (wceq (cv w) (co (cv l) Y cadds)) (cfv X cleft))) (cab w (wrex m (wceq (cv w) (co X (cv m) cadds)) (cfv Y cleft)))) (csn (co X Y cadds)) cslts) (wbr (csn (co X Y cadds)) (cun (cab w (wrex r (wceq (cv w) (co (cv r) Y cadds)) (cfv X cright))) (cab w (wrex m (wceq (cv w) (co X (cv m) cadds)) (cfv Y cright)))) cslts)) $;

--| Demonstrate the cut properties of surreal addition. This gives us closure together with a pair of set-less-than relationships for surreal addition. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem addcuts_b1 {w m s1 r l: setvar} (ph: wff w m s1 r l) (X Y: class):
  $ wi ph (wcel X csur) $ >
  $ wi ph (wcel Y csur) $ >
  $ wi ph (w3a (wcel (co X Y cadds) csur) (wbr (cun (cab w (wrex l (wceq (cv w) (co (cv l) Y cadds)) (cfv X cleft))) (cab w (wrex m (wceq (cv w) (co X (cv m) cadds)) (cfv Y cleft)))) (csn (co X Y cadds)) cslts) (wbr (csn (co X Y cadds)) (cun (cab w (wrex r (wceq (cv w) (co (cv r) Y cadds)) (cfv X cright))) (cab w (wrex s1 (wceq (cv w) (co X (cv s1) cadds)) (cfv Y cright)))) cslts)) $;

--| Show that the cut involved in surreal addition is legitimate. (Contributed by Scott Fenton, 8-Mar-2025.)
theorem addcuts2 {w t m s1 r q p l: setvar} (ph: wff w t m s1 r q p l) (X Y: class):
  $ wi ph (wcel X csur) $ >
  $ wi ph (wcel Y csur) $ >
  $ wi ph (wbr (cun (cab p (wrex l (wceq (cv p) (co (cv l) Y cadds)) (cfv X cleft))) (cab q (wrex m (wceq (cv q) (co X (cv m) cadds)) (cfv Y cleft)))) (cun (cab w (wrex r (wceq (cv w) (co (cv r) Y cadds)) (cfv X cright))) (cab t (wrex s1 (wceq (cv t) (co X (cv s1) cadds)) (cfv Y cright)))) cslts) $;

--| Show that the cut involved in surreal addition is legitimate. (Contributed by Scott Fenton, 8-Mar-2025.)
theorem addcuts2_b {w m r l: setvar} (ph: wff w m r l) (X Y: class):
  $ wi ph (wcel X csur) $ >
  $ wi ph (wcel Y csur) $ >
  $ wi ph (wbr (cun (cab w (wrex l (wceq (cv w) (co (cv l) Y cadds)) (cfv X cleft))) (cab w (wrex m (wceq (cv w) (co X (cv m) cadds)) (cfv Y cleft)))) (cun (cab w (wrex r (wceq (cv w) (co (cv r) Y cadds)) (cfv X cright))) (cab w (wrex m (wceq (cv w) (co X (cv m) cadds)) (cfv Y cright)))) cslts) $;

--| Show that the cut involved in surreal addition is legitimate. (Contributed by Scott Fenton, 8-Mar-2025.)
theorem addcuts2_b1 {w m s1 r l: setvar} (ph: wff w m s1 r l) (X Y: class):
  $ wi ph (wcel X csur) $ >
  $ wi ph (wcel Y csur) $ >
  $ wi ph (wbr (cun (cab w (wrex l (wceq (cv w) (co (cv l) Y cadds)) (cfv X cleft))) (cab w (wrex m (wceq (cv w) (co X (cv m) cadds)) (cfv Y cleft)))) (cun (cab w (wrex r (wceq (cv w) (co (cv r) Y cadds)) (cfv X cright))) (cab w (wrex s1 (wceq (cv w) (co X (cv s1) cadds)) (cfv Y cright)))) cslts) $;

--| Surreal numbers are closed under addition. Theorem 6(iii) of [Conway] p. 18. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem addscld (ph: wff) (X Y: class):
  $ wi ph (wcel X csur) $ >
  $ wi ph (wcel Y csur) $ >
  $ wi ph (wcel (co X Y cadds) csur) $;

--| Surreal numbers are closed under addition. Theorem 6(iii) of [Conway[ p. 18. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem addscl (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wcel (co A2 B2 cadds) csur) $;

--| Function statement for surreal addition. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem addsf:
  $ wf (cxp csur csur) csur cadds $;

--| Surreal addition is onto. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem addsfo:
  $ wfo (cxp csur csur) csur cadds $;

--| A theorem for surreals that is analogous to the second Peano postulate ~ peano2 . (Contributed by Scott Fenton, 17-Mar-2025.)
theorem peano2no (A2: class):
  $ wi (wcel A2 csur) (wcel (co A2 c1s cadds) csur) $;

--| Surreal less-than is preserved under addition. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem ltadds1im (A2 B2 C: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wcel C csur)) (wi (wbr A2 B2 clts) (wbr (co A2 C cadds) (co B2 C cadds) clts)) $;

--| Surreal less-than is preserved under addition. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem ltadds2im (A2 B2 C: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wcel C csur)) (wi (wbr A2 B2 clts) (wbr (co C A2 cadds) (co C B2 cadds) clts)) $;

--| Surreal less-than or equal cancels under addition. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem leadds1im (A2 B2 C: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wcel C csur)) (wi (wbr (co A2 C cadds) (co B2 C cadds) cles) (wbr A2 B2 cles)) $;

--| Surreal less-than or equal cancels under addition. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem leadds2im (A2 B2 C: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wcel C csur)) (wi (wbr (co C A2 cadds) (co C B2 cadds) cles) (wbr A2 B2 cles)) $;

--| Addition to both sides of surreal less-than or equal. Theorem 5 of [Conway] p. 18. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem leadds1 (A2 B2 C: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wcel C csur)) (wb (wbr A2 B2 cles) (wbr (co A2 C cadds) (co B2 C cadds) cles)) $;

--| Addition to both sides of surreal less-than or equal. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem leadds2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wcel C csur)) (wb (wbr A2 B2 cles) (wbr (co C A2 cadds) (co C B2 cadds) cles)) $;

--| Addition to both sides of surreal less-than. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem ltadds2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wcel C csur)) (wb (wbr A2 B2 clts) (wbr (co C A2 cadds) (co C B2 cadds) clts)) $;

--| Addition to both sides of surreal less-than. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem ltadds1 (A2 B2 C: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wcel C csur)) (wb (wbr A2 B2 clts) (wbr (co A2 C cadds) (co B2 C cadds) clts)) $;

--| Cancellation law for surreal addition. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem addscan2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wcel C csur)) (wb (wceq (co A2 C cadds) (co B2 C cadds)) (wceq A2 B2)) $;

--| Cancellation law for surreal addition. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem addscan1 (A2 B2 C: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wcel C csur)) (wb (wceq (co C A2 cadds) (co C B2 cadds)) (wceq A2 B2)) $;

--| Addition to both sides of surreal less-than or equal. Theorem 5 of [Conway] p. 18. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem leadds1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wb (wbr A2 B2 cles) (wbr (co A2 C cadds) (co B2 C cadds) cles)) $;

--| Addition to both sides of surreal less-than or equal. (Contributed by Scott Fenton, 5-Feb-2025.)
theorem leadds2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wb (wbr A2 B2 cles) (wbr (co C A2 cadds) (co C B2 cadds) cles)) $;

--| Addition to both sides of surreal less-than. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem ltadds2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wb (wbr A2 B2 clts) (wbr (co C A2 cadds) (co C B2 cadds) clts)) $;

--| Addition to both sides of surreal less-than. (Contributed by Scott Fenton, 5-Feb-2025.)
theorem ltadds1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wb (wbr A2 B2 clts) (wbr (co A2 C cadds) (co B2 C cadds) clts)) $;

--| Cancellation law for surreal addition. (Contributed by Scott Fenton, 5-Feb-2025.)
theorem addscan2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wb (wceq (co A2 C cadds) (co B2 C cadds)) (wceq A2 B2)) $;

--| Cancellation law for surreal addition. (Contributed by Scott Fenton, 5-Feb-2025.)
theorem addscan1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wb (wceq (co C A2 cadds) (co C B2 cadds)) (wceq A2 B2)) $;

--| Lemma for ~ addsunif . State the whole theorem with extra distinct variable conditions. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem addsuniflem {y1 z w t m s1 r l: setvar} (ph: wff) (A2: class y1 w) (B2: class z t) (R: class y1 z t m s1) (S: class y1 z w r l) (L: class z w t m) (M: class y1 w t l):
  $ wi ph (wbr L R cslts) $ >
  $ wi ph (wbr M S cslts) $ >
  $ wi ph (wceq A2 (co L R ccuts)) $ >
  $ wi ph (wceq B2 (co M S ccuts)) $ >
  $ wi ph (wceq (co A2 B2 cadds) (co (cun (cab y1 (wrex l (wceq (cv y1) (co (cv l) B2 cadds)) L)) (cab z (wrex m (wceq (cv z) (co A2 (cv m) cadds)) M))) (cun (cab w (wrex r (wceq (cv w) (co (cv r) B2 cadds)) R)) (cab t (wrex s1 (wceq (cv t) (co A2 (cv s1) cadds)) S))) ccuts)) $;

--| Uniformity theorem for surreal addition. This theorem states that we can use any cuts that define ` A ` and ` B ` in the definition of surreal addition. Theorem 3.2 of [Gonshor] p. 15. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem addsunif {y1 z w t m s1 r l: setvar} (ph: wff y1 z w t m s1 r l) (A2: class y1 w r l) (B2: class z t m s1) (R: class y1 z t m s1 l) (S: class y1 z w m r l) (L: class z w t m s1 r) (M: class y1 w t s1 r l):
  $ wi ph (wbr L R cslts) $ >
  $ wi ph (wbr M S cslts) $ >
  $ wi ph (wceq A2 (co L R ccuts)) $ >
  $ wi ph (wceq B2 (co M S ccuts)) $ >
  $ wi ph (wceq (co A2 B2 cadds) (co (cun (cab y1 (wrex l (wceq (cv y1) (co (cv l) B2 cadds)) L)) (cab z (wrex m (wceq (cv z) (co A2 (cv m) cadds)) M))) (cun (cab w (wrex r (wceq (cv w) (co (cv r) B2 cadds)) R)) (cab t (wrex s1 (wceq (cv t) (co A2 (cv s1) cadds)) S))) ccuts)) $;

--| Uniformity theorem for surreal addition. This theorem states that we can use any cuts that define ` A ` and ` B ` in the definition of surreal addition. Theorem 3.2 of [Gonshor] p. 15. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem addsunif_b {y1 m: setvar} (ph: wff y1 m) (A2 B2 R S L M: class):
  $ wi ph (wbr L R cslts) $ >
  $ wi ph (wbr M S cslts) $ >
  $ wi ph (wceq A2 (co L R ccuts)) $ >
  $ wi ph (wceq B2 (co M S ccuts)) $ >
  $ wi ph (wceq (co A2 B2 cadds) (co (cun (cab y1 (wrex m (wceq (cv y1) (co (cv m) B2 cadds)) L)) (cab y1 (wrex m (wceq (cv y1) (co A2 (cv m) cadds)) M))) (cun (cab y1 (wrex m (wceq (cv y1) (co (cv m) B2 cadds)) R)) (cab y1 (wrex m (wceq (cv y1) (co A2 (cv m) cadds)) S))) ccuts)) $;

--| Lemma for addition associativity. Expand one form of the triple sum. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem addsasslem1 {y1 z w m n r q p a b c l: setvar} (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wceq (co (co A2 B2 cadds) C cadds) (co (cun (cun (cab y1 (wrex l (wceq (cv y1) (co (co (cv l) B2 cadds) C cadds)) (cfv A2 cleft))) (cab z (wrex m (wceq (cv z) (co (co A2 (cv m) cadds) C cadds)) (cfv B2 cleft)))) (cab w (wrex n (wceq (cv w) (co (co A2 B2 cadds) (cv n) cadds)) (cfv C cleft)))) (cun (cun (cab a (wrex p (wceq (cv a) (co (co (cv p) B2 cadds) C cadds)) (cfv A2 cright))) (cab b (wrex q (wceq (cv b) (co (co A2 (cv q) cadds) C cadds)) (cfv B2 cright)))) (cab c (wrex r (wceq (cv c) (co (co A2 B2 cadds) (cv r) cadds)) (cfv C cright)))) ccuts)) $;

--| Lemma for addition associativity. Expand the other form of the triple sum. (Contributed by Scott Fenton, 21-Jan-2025.)
theorem addsasslem2 {y1 z w m n r q p a b c l: setvar} (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wceq (co A2 (co B2 C cadds) cadds) (co (cun (cun (cab y1 (wrex l (wceq (cv y1) (co (cv l) (co B2 C cadds) cadds)) (cfv A2 cleft))) (cab z (wrex m (wceq (cv z) (co A2 (co (cv m) C cadds) cadds)) (cfv B2 cleft)))) (cab w (wrex n (wceq (cv w) (co A2 (co B2 (cv n) cadds) cadds)) (cfv C cleft)))) (cun (cun (cab a (wrex p (wceq (cv a) (co (cv p) (co B2 C cadds) cadds)) (cfv A2 cright))) (cab b (wrex q (wceq (cv b) (co A2 (co (cv q) C cadds) cadds)) (cfv B2 cright)))) (cab c (wrex r (wceq (cv c) (co A2 (co B2 (cv r) cadds) cadds)) (cfv C cright)))) ccuts)) $;

--| Surreal addition is associative. Part of theorem 3 of [Conway] p. 17. (Contributed by Scott Fenton, 22-Jan-2025.)
theorem addsass (A2 B2 C: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wcel C csur)) (wceq (co (co A2 B2 cadds) C cadds) (co A2 (co B2 C cadds) cadds)) $;

--| Surreal addition is associative. Part of theorem 3 of [Conway] p. 17. (Contributed by Scott Fenton, 22-Jan-2025.)
theorem addsassd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wceq (co (co A2 B2 cadds) C cadds) (co A2 (co B2 C cadds) cadds)) $;

--| Commutative/associative law that swaps the last two terms in a triple sum. (Contributed by Scott Fenton, 22-Jan-2025.)
theorem adds32d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wceq (co (co A2 B2 cadds) C cadds) (co (co A2 C cadds) B2 cadds)) $;

--| Commutative/associative law that swaps the first two terms in a triple sum. (Contributed by Scott Fenton, 9-Mar-2025.)
theorem adds12d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wceq (co A2 (co B2 C cadds) cadds) (co B2 (co A2 C cadds) cadds)) $;

--| Rearrangement of four terms in a surreal sum. (Contributed by Scott Fenton, 5-Feb-2025.)
theorem adds4d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wcel D csur) $ >
  $ wi ph (wceq (co (co A2 B2 cadds) (co C D cadds) cadds) (co (co A2 C cadds) (co B2 D cadds) cadds)) $;

--| Rearrangement of four terms in a surreal sum. (Contributed by Scott Fenton, 5-Feb-2025.)
theorem adds42d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wcel D csur) $ >
  $ wi ph (wceq (co (co A2 B2 cadds) (co C D cadds) cadds) (co (co A2 C cadds) (co D B2 cadds) cadds)) $;

--| Addition of a positive number increases the sum. (Contributed by Scott Fenton, 15-Apr-2025.)
theorem ltaddspos1d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wb (wbr c0s A2 clts) (wbr B2 (co B2 A2 cadds) clts)) $;

--| Addition of a positive number increases the sum. (Contributed by Scott Fenton, 15-Apr-2025.)
theorem ltaddspos2d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wb (wbr c0s A2 clts) (wbr B2 (co A2 B2 cadds) clts)) $;

--| Adding both sides of two surreal less-than relations. (Contributed by Scott Fenton, 15-Apr-2025.)
theorem lt2addsd (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wcel D csur) $ >
  $ wi ph (wbr A2 C clts) $ >
  $ wi ph (wbr B2 D clts) $ >
  $ wi ph (wbr (co A2 B2 cadds) (co C D cadds) clts) $;

--| The sum of two positive surreals is positive. (Contributed by Scott Fenton, 15-Apr-2025.)
theorem addsgt0d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wbr c0s A2 clts) $ >
  $ wi ph (wbr c0s B2 clts) $ >
  $ wi ph (wbr c0s (co A2 B2 cadds) clts) $;

--| A surreal is less than itself plus one. (Contributed by Scott Fenton, 13-Aug-2025.)
theorem ltsp1d (ph: wff) (A2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wbr A2 (co A2 c1s cadds) clts) $;

--| A surreal is less-than or equal to itself plus a non-negative surreal. (Contributed by Scott Fenton, 24-Feb-2026.)
theorem addsge01d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wb (wbr c0s B2 cles) (wbr A2 (co A2 B2 cadds) cles)) $;

--| Lemma for ~ addbday . (Contributed by Scott Fenton, 13-Aug-2025.)
theorem addbdaylem {z yO yL: setvar} (ph: wff yO) (A2 B2: class) (S: class yO yL):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wral yO (wss (cfv (co A2 (cv yO) cadds) cbday) (co (cfv A2 cbday) (cfv (cv yO) cbday) cnadd)) (cun (cfv B2 cleft) (cfv B2 cright))) $ >
  $ wss S (cun (cfv B2 cleft) (cfv B2 cright)) $ >
  $ wi ph (wss (cima cbday (cab z (wrex yL (wceq (cv z) (co A2 (cv yL) cadds)) S))) (co (cfv A2 cbday) (cfv B2 cbday) cnadd)) $;

--| The birthday of the sum of two surreals is less than or equal to the natural ordinal sum of their individual birthdays. Theorem 6.1 of [Gonshor] p. 95. (Contributed by Scott Fenton, 12-Aug-2025.)
theorem addbday (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wss (cfv (co A2 B2 cadds) cbday) (co (cfv A2 cbday) (cfv B2 cbday) cnadd)) $;

--| Declare the syntax for surreal negation.
term cnegs: class;

--| Declare the syntax for surreal subtraction.
term csubs: class;

--| Define surreal negation. Definition from [Conway] p. 5. (Contributed by Scott Fenton, 20-Aug-2024.)
axiom df_negs {x3 n: setvar}:
  $ wceq cnegs (cnorec (cmpo x3 n cvv cvv (co (cima (cv n) (cfv (cv x3) cright)) (cima (cv n) (cfv (cv x3) cleft)) ccuts))) $;

--| Define surreal subtraction. (Contributed by Scott Fenton, 20-Aug-2024.)
axiom df_subs {x3 y1: setvar}:
  $ wceq csubs (cmpo x3 y1 csur csur (co (cv x3) (cfv (cv y1) cnegs) cadds)) $;

--| Surreal negation is a function over surreals. (Contributed by Scott Fenton, 20-Aug-2024.)
theorem negsfn:
  $ wfn cnegs csur $;

--| Surreal subtraction is a function over pairs of surreals. (Contributed by Scott Fenton, 22-Jan-2025.)
theorem subsfn:
  $ wfn csubs (cxp csur csur) $;

--| The value of the surreal negation function. (Contributed by Scott Fenton, 20-Aug-2024.)
theorem negsval (A2: class):
  $ wi (wcel A2 csur) (wceq (cfv A2 cnegs) (co (cima cnegs (cfv A2 cright)) (cima cnegs (cfv A2 cleft)) ccuts)) $;

--| Negative surreal zero is surreal zero. (Contributed by Scott Fenton, 20-Aug-2024.)
theorem neg0s:
  $ wceq (cfv c0s cnegs) c0s $;

--| An expression for negative surreal one. (Contributed by Scott Fenton, 24-Jul-2025.)
theorem neg1s:
  $ wceq (cfv c1s cnegs) (co c0 (csn c0s) ccuts) $;

--| Lemma for surreal negation. We prove a pair of properties of surreal negation simultaneously. First, we instantiate some quantifiers. (Contributed by Scott Fenton, 2-Feb-2025.)
theorem negsproplem1 {x3 y1: setvar} (ph: wff x3 y1) (A2 B2 X: class) (Y: class x3):
  $ wi ph (wral x3 (wral y1 (wi (wcel (cun (cfv (cv x3) cbday) (cfv (cv y1) cbday)) (cun (cfv A2 cbday) (cfv B2 cbday))) (wa (wcel (cfv (cv x3) cnegs) csur) (wi (wbr (cv x3) (cv y1) clts) (wbr (cfv (cv y1) cnegs) (cfv (cv x3) cnegs) clts)))) csur) csur) $ >
  $ wi ph (wcel X csur) $ >
  $ wi ph (wcel Y csur) $ >
  $ wi ph (wcel (cun (cfv X cbday) (cfv Y cbday)) (cun (cfv A2 cbday) (cfv B2 cbday))) $ >
  $ wi ph (wa (wcel (cfv X cnegs) csur) (wi (wbr X Y clts) (wbr (cfv Y cnegs) (cfv X cnegs) clts))) $;

--| Lemma for surreal negation. Show that the cut that defines negation is legitimate. (Contributed by Scott Fenton, 2-Feb-2025.)
theorem negsproplem2 {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class):
  $ wi ph (wral x3 (wral y1 (wi (wcel (cun (cfv (cv x3) cbday) (cfv (cv y1) cbday)) (cun (cfv A2 cbday) (cfv B2 cbday))) (wa (wcel (cfv (cv x3) cnegs) csur) (wi (wbr (cv x3) (cv y1) clts) (wbr (cfv (cv y1) cnegs) (cfv (cv x3) cnegs) clts)))) csur) csur) $ >
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wbr (cima cnegs (cfv A2 cright)) (cima cnegs (cfv A2 cleft)) cslts) $;

--| Lemma for surreal negation. Give the cut properties of surreal negation. (Contributed by Scott Fenton, 2-Feb-2025.)
theorem negsproplem3 {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class):
  $ wi ph (wral x3 (wral y1 (wi (wcel (cun (cfv (cv x3) cbday) (cfv (cv y1) cbday)) (cun (cfv A2 cbday) (cfv B2 cbday))) (wa (wcel (cfv (cv x3) cnegs) csur) (wi (wbr (cv x3) (cv y1) clts) (wbr (cfv (cv y1) cnegs) (cfv (cv x3) cnegs) clts)))) csur) csur) $ >
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (w3a (wcel (cfv A2 cnegs) csur) (wbr (cima cnegs (cfv A2 cright)) (csn (cfv A2 cnegs)) cslts) (wbr (csn (cfv A2 cnegs)) (cima cnegs (cfv A2 cleft)) cslts)) $;

--| Lemma for surreal negation. Show the second half of the inductive hypothesis when ` A ` is simpler than ` B ` . (Contributed by Scott Fenton, 2-Feb-2025.)
theorem negsproplem4 {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class):
  $ wi ph (wral x3 (wral y1 (wi (wcel (cun (cfv (cv x3) cbday) (cfv (cv y1) cbday)) (cun (cfv A2 cbday) (cfv B2 cbday))) (wa (wcel (cfv (cv x3) cnegs) csur) (wi (wbr (cv x3) (cv y1) clts) (wbr (cfv (cv y1) cnegs) (cfv (cv x3) cnegs) clts)))) csur) csur) $ >
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wbr A2 B2 clts) $ >
  $ wi ph (wcel (cfv A2 cbday) (cfv B2 cbday)) $ >
  $ wi ph (wbr (cfv B2 cnegs) (cfv A2 cnegs) clts) $;

--| Lemma for surreal negation. Show the second half of the inductive hypothesis when ` B ` is simpler than ` A ` . (Contributed by Scott Fenton, 3-Feb-2025.)
theorem negsproplem5 {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class):
  $ wi ph (wral x3 (wral y1 (wi (wcel (cun (cfv (cv x3) cbday) (cfv (cv y1) cbday)) (cun (cfv A2 cbday) (cfv B2 cbday))) (wa (wcel (cfv (cv x3) cnegs) csur) (wi (wbr (cv x3) (cv y1) clts) (wbr (cfv (cv y1) cnegs) (cfv (cv x3) cnegs) clts)))) csur) csur) $ >
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wbr A2 B2 clts) $ >
  $ wi ph (wcel (cfv B2 cbday) (cfv A2 cbday)) $ >
  $ wi ph (wbr (cfv B2 cnegs) (cfv A2 cnegs) clts) $;

--| Lemma for surreal negation. Show the second half of the inductive hypothesis when ` A ` is the same age as ` B ` . (Contributed by Scott Fenton, 3-Feb-2025.)
theorem negsproplem6 {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class):
  $ wi ph (wral x3 (wral y1 (wi (wcel (cun (cfv (cv x3) cbday) (cfv (cv y1) cbday)) (cun (cfv A2 cbday) (cfv B2 cbday))) (wa (wcel (cfv (cv x3) cnegs) csur) (wi (wbr (cv x3) (cv y1) clts) (wbr (cfv (cv y1) cnegs) (cfv (cv x3) cnegs) clts)))) csur) csur) $ >
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wbr A2 B2 clts) $ >
  $ wi ph (wceq (cfv A2 cbday) (cfv B2 cbday)) $ >
  $ wi ph (wbr (cfv B2 cnegs) (cfv A2 cnegs) clts) $;

--| Lemma for surreal negation. Show the second half of the inductive hypothesis unconditionally. (Contributed by Scott Fenton, 3-Feb-2025.)
theorem negsproplem7 {x3 y1: setvar} (ph: wff x3 y1) (A2 B2: class):
  $ wi ph (wral x3 (wral y1 (wi (wcel (cun (cfv (cv x3) cbday) (cfv (cv y1) cbday)) (cun (cfv A2 cbday) (cfv B2 cbday))) (wa (wcel (cfv (cv x3) cnegs) csur) (wi (wbr (cv x3) (cv y1) clts) (wbr (cfv (cv y1) cnegs) (cfv (cv x3) cnegs) clts)))) csur) csur) $ >
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wbr A2 B2 clts) $ >
  $ wi ph (wbr (cfv B2 cnegs) (cfv A2 cnegs) clts) $;

--| Show closure and ordering properties of negation. (Contributed by Scott Fenton, 3-Feb-2025.)
theorem negsprop (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wa (wcel (cfv A2 cnegs) csur) (wi (wbr A2 B2 clts) (wbr (cfv B2 cnegs) (cfv A2 cnegs) clts))) $;

--| The surreals are closed under negation. Theorem 6(ii) of [Conway] p. 18. (Contributed by Scott Fenton, 3-Feb-2025.)
theorem negscl (A2: class):
  $ wi (wcel A2 csur) (wcel (cfv A2 cnegs) csur) $;

--| The surreals are closed under negation. Theorem 6(ii) of [Conway] p. 18. (Contributed by Scott Fenton, 3-Feb-2025.)
theorem negscld (ph: wff) (A2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel (cfv A2 cnegs) csur) $;

--| The forward direction of the ordering properties of negation. (Contributed by Scott Fenton, 3-Feb-2025.)
theorem ltnegsim (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wi (wbr A2 B2 clts) (wbr (cfv B2 cnegs) (cfv A2 cnegs) clts)) $;

--| The cut properties of surreal negation. (Contributed by Scott Fenton, 3-Feb-2025.)
theorem negcut (A2: class):
  $ wi (wcel A2 csur) (w3a (wcel (cfv A2 cnegs) csur) (wbr (cima cnegs (cfv A2 cright)) (csn (cfv A2 cnegs)) cslts) (wbr (csn (cfv A2 cnegs)) (cima cnegs (cfv A2 cleft)) cslts)) $;

--| The cut that defines surreal negation is legitimate. (Contributed by Scott Fenton, 3-Feb-2025.)
theorem negcut2 (A2: class):
  $ wi (wcel A2 csur) (wbr (cima cnegs (cfv A2 cright)) (cima cnegs (cfv A2 cleft)) cslts) $;

--| Surreal addition of a number and its negative. Theorem 4(iii) of [Conway] p. 17. (Contributed by Scott Fenton, 3-Feb-2025.)
theorem negsid (A2: class):
  $ wi (wcel A2 csur) (wceq (co A2 (cfv A2 cnegs) cadds) c0s) $;

--| Surreal addition of a number and its negative. Theorem 4(iii) of [Conway] p. 17. (Contributed by Scott Fenton, 5-Feb-2025.)
theorem negsidd (ph: wff) (A2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wceq (co A2 (cfv A2 cnegs) cadds) c0s) $;

--| Every surreal has a negative. Note that this theorem, ~ addscl , ~ addscom , ~ addsass , ~ addsrid , and ~ ltadds1im are the ordered Abelian group axioms. However, the surreals cannot be said to be an ordered Abelian group because ` No ` is a proper class. (Contributed by Scott Fenton, 3-Feb-2025.)
theorem negsex {x3: setvar} (A2: class):
  $ wi (wcel A2 csur) (wrex x3 (wceq (co A2 (cv x3) cadds) c0s) csur) $;

--| A surreal is equal to the negative of its negative. Theorem 4(ii) of [Conway] p. 17. (Contributed by Scott Fenton, 3-Feb-2025.)
theorem negnegs (A2: class):
  $ wi (wcel A2 csur) (wceq (cfv (cfv A2 cnegs) cnegs) A2) $;

--| Negative of both sides of surreal less-than. (Contributed by Scott Fenton, 3-Feb-2025.)
theorem ltnegs (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wb (wbr A2 B2 clts) (wbr (cfv B2 cnegs) (cfv A2 cnegs) clts)) $;

--| Negative of both sides of surreal less-than or equal. (Contributed by Scott Fenton, 3-Feb-2025.)
theorem lenegs (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wb (wbr A2 B2 cles) (wbr (cfv B2 cnegs) (cfv A2 cnegs) cles)) $;

--| Negative of both sides of surreal less-than. (Contributed by Scott Fenton, 14-Mar-2025.)
theorem ltnegsd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wb (wbr A2 B2 clts) (wbr (cfv B2 cnegs) (cfv A2 cnegs) clts)) $;

--| Negative of both sides of surreal less-than or equal. (Contributed by Scott Fenton, 14-Mar-2025.)
theorem lenegsd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wb (wbr A2 B2 cles) (wbr (cfv B2 cnegs) (cfv A2 cnegs) cles)) $;

--| Surreal negation is one-to-one. (Contributed by Scott Fenton, 3-Feb-2025.)
theorem negs11 (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wb (wceq (cfv A2 cnegs) (cfv B2 cnegs)) (wceq A2 B2)) $;

--| Distribution of surreal negative over addition. (Contributed by Scott Fenton, 5-Feb-2025.)
theorem negsdi (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wceq (cfv (co A2 B2 cadds) cnegs) (co (cfv A2 cnegs) (cfv B2 cnegs) cadds)) $;

--| Comparison of a surreal and its negative to zero. (Contributed by Scott Fenton, 10-Mar-2025.)
theorem lt0negs2d (ph: wff) (A2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wb (wbr c0s A2 clts) (wbr (cfv A2 cnegs) c0s clts)) $;

--| Function statement for surreal negation. (Contributed by Scott Fenton, 3-Feb-2025.)
theorem negsf:
  $ wf csur csur cnegs $;

--| Function statement for surreal negation. (Contributed by Scott Fenton, 3-Feb-2025.)
theorem negsfo:
  $ wfo csur csur cnegs $;

--| Surreal negation is a bijection. (Contributed by Scott Fenton, 3-Feb-2025.)
theorem negsf1o:
  $ wf1o csur csur cnegs $;

--| Uniformity property for surreal negation. If ` L ` and ` R ` are any cut that represents ` A ` , then they may be used instead of ` ( _Left `` A ) ` and ` ( _Right `` A ) ` in the definition of negation. (Contributed by Scott Fenton, 14-Feb-2025.)
theorem negsunif (ph: wff) (A2 R L: class):
  $ wi ph (wbr L R cslts) $ >
  $ wi ph (wceq A2 (co L R ccuts)) $ >
  $ wi ph (wceq (cfv A2 cnegs) (co (cima cnegs R) (cima cnegs L) ccuts)) $;

--| Lemma for ~ negbday . Bound the birthday of the negative of a surreal number above. (Contributed by Scott Fenton, 8-Mar-2025.)
theorem negbdaylem (A2: class):
  $ wi (wcel A2 csur) (wss (cfv (cfv A2 cnegs) cbday) (cfv A2 cbday)) $;

--| Negation of a surreal number preserves birthday. (Contributed by Scott Fenton, 8-Mar-2025.)
theorem negbday (A2: class):
  $ wi (wcel A2 csur) (wceq (cfv (cfv A2 cnegs) cbday) (cfv A2 cbday)) $;

--| The left set of the negative of a surreal is the set of negatives of its right set. (Contributed by Scott Fenton, 21-Feb-2026.)
theorem negleft (A2: class):
  $ wi (wcel A2 csur) (wceq (cfv (cfv A2 cnegs) cleft) (cima cnegs (cfv A2 cright))) $;

--| The right set of the negative of a surreal is the set of negatives of its left set. (Contributed by Scott Fenton, 21-Feb-2026.)
theorem negright (A2: class):
  $ wi (wcel A2 csur) (wceq (cfv (cfv A2 cnegs) cright) (cima cnegs (cfv A2 cleft))) $;

--| The value of surreal subtraction. (Contributed by Scott Fenton, 3-Feb-2025.)
theorem subsval (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wceq (co A2 B2 csubs) (co A2 (cfv B2 cnegs) cadds)) $;

--| The value of surreal subtraction. (Contributed by Scott Fenton, 5-Feb-2025.)
theorem subsvald (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wceq (co A2 B2 csubs) (co A2 (cfv B2 cnegs) cadds)) $;

--| Closure law for surreal subtraction. (Contributed by Scott Fenton, 3-Feb-2025.)
theorem subscl (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wcel (co A2 B2 csubs) csur) $;

--| Closure law for surreal subtraction. (Contributed by Scott Fenton, 5-Feb-2025.)
theorem subscld (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel (co A2 B2 csubs) csur) $;

--| Function statement for surreal subtraction. (Contributed by Scott Fenton, 17-May-2025.)
theorem subsf:
  $ wf (cxp csur csur) csur csubs $;

--| Surreal subtraction is an onto function. (Contributed by Scott Fenton, 17-May-2025.)
theorem subsfo:
  $ wfo (cxp csur csur) csur csubs $;

--| Surreal negation in terms of subtraction. (Contributed by Scott Fenton, 15-Apr-2025.)
theorem negsval2 (A2: class):
  $ wi (wcel A2 csur) (wceq (cfv A2 cnegs) (co c0s A2 csubs)) $;

--| Surreal negation in terms of subtraction. (Contributed by Scott Fenton, 15-Apr-2025.)
theorem negsval2d (ph: wff) (A2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wceq (cfv A2 cnegs) (co c0s A2 csubs)) $;

--| Identity law for subtraction. (Contributed by Scott Fenton, 3-Feb-2025.)
theorem subsid1 (A2: class):
  $ wi (wcel A2 csur) (wceq (co A2 c0s csubs) A2) $;

--| Subtraction of a surreal from itself. (Contributed by Scott Fenton, 3-Feb-2025.)
theorem subsid (A2: class):
  $ wi (wcel A2 csur) (wceq (co A2 A2 csubs) c0s) $;

--| Relationship between addition and subtraction for surreals. (Contributed by Scott Fenton, 3-Feb-2025.)
theorem subadds (A2 B2 C: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wcel C csur)) (wb (wceq (co A2 B2 csubs) C) (wceq (co B2 C cadds) A2)) $;

--| Relationship between addition and subtraction for surreals. (Contributed by Scott Fenton, 5-Feb-2025.)
theorem subaddsd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wb (wceq (co A2 B2 csubs) C) (wceq (co B2 C cadds) A2)) $;

--| Cancellation law for surreal subtraction. (Contributed by Scott Fenton, 4-Feb-2025.)
theorem pncans (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wceq (co (co A2 B2 cadds) B2 csubs) A2) $;

--| Subtraction and addition of equals. (Contributed by Scott Fenton, 4-Feb-2025.)
theorem pncan3s (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wceq (co A2 (co B2 A2 csubs) cadds) B2) $;

--| Cancellation law for surreal subtraction. (Contributed by Scott Fenton, 16-Apr-2025.)
theorem pncan2s (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wceq (co (co A2 B2 cadds) A2 csubs) B2) $;

--| Cancellation law for surreal subtraction. (Contributed by Scott Fenton, 4-Feb-2025.)
theorem npcans (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wceq (co (co A2 B2 csubs) B2 cadds) A2) $;

--| Subtraction from both sides of surreal less-than. (Contributed by Scott Fenton, 4-Feb-2025.)
theorem ltsubs1 (A2 B2 C: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wcel C csur)) (wb (wbr A2 B2 clts) (wbr (co A2 C csubs) (co B2 C csubs) clts)) $;

--| Subtraction from both sides of surreal less-than. (Contributed by Scott Fenton, 4-Feb-2025.)
theorem ltsubs2 (A2 B2 C: class):
  $ wi (w3a (wcel A2 csur) (wcel B2 csur) (wcel C csur)) (wb (wbr A2 B2 clts) (wbr (co C B2 csubs) (co C A2 csubs) clts)) $;

--| Subtraction from both sides of surreal less-than. (Contributed by Scott Fenton, 5-Feb-2025.)
theorem ltsubs1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wb (wbr A2 B2 clts) (wbr (co A2 C csubs) (co B2 C csubs) clts)) $;

--| Subtraction from both sides of surreal less-than. (Contributed by Scott Fenton, 5-Feb-2025.)
theorem ltsubs2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wb (wbr A2 B2 clts) (wbr (co C B2 csubs) (co C A2 csubs) clts)) $;

--| Distribution of negative over subtraction. (Contributed by Scott Fenton, 5-Feb-2025.)
theorem negsubsdi2d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wceq (cfv (co A2 B2 csubs) cnegs) (co B2 A2 csubs)) $;

--| Associative-type law for surreal addition and subtraction. (Contributed by Scott Fenton, 6-Feb-2025.)
theorem addsubsassd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wceq (co (co A2 B2 cadds) C csubs) (co A2 (co B2 C csubs) cadds)) $;

--| Law for surreal addition and subtraction. (Contributed by Scott Fenton, 4-Mar-2025.)
theorem addsubsd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wceq (co (co A2 B2 cadds) C csubs) (co (co A2 C csubs) B2 cadds)) $;

--| Equivalence for the surreal less-than relationship between differences. (Contributed by Scott Fenton, 6-Feb-2025.)
theorem ltsubsubsbd (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wcel D csur) $ >
  $ wi ph (wb (wbr (co A2 C csubs) (co B2 D csubs) clts) (wbr (co A2 B2 csubs) (co C D csubs) clts)) $;

--| Equivalence for the surreal less-than relationship between differences. (Contributed by Scott Fenton, 21-Feb-2025.)
theorem ltsubsubs2bd (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wcel D csur) $ >
  $ wi ph (wb (wbr (co A2 B2 csubs) (co C D csubs) clts) (wbr (co D C csubs) (co B2 A2 csubs) clts)) $;

--| Equivalence for the surreal less-than relationship between differences. (Contributed by Scott Fenton, 21-Feb-2025.)
theorem ltsubsubs3bd (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wcel D csur) $ >
  $ wi ph (wb (wbr (co A2 C csubs) (co B2 D csubs) clts) (wbr (co D C csubs) (co B2 A2 csubs) clts)) $;

--| Equivalence for the surreal less-than or equal relationship between differences. (Contributed by Scott Fenton, 7-Mar-2025.)
theorem lesubsubsbd (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wcel D csur) $ >
  $ wi ph (wb (wbr (co A2 C csubs) (co B2 D csubs) cles) (wbr (co A2 B2 csubs) (co C D csubs) cles)) $;

--| Equivalence for the surreal less-than or equal relationship between differences. (Contributed by Scott Fenton, 7-Mar-2025.)
theorem lesubsubs2bd (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wcel D csur) $ >
  $ wi ph (wb (wbr (co A2 B2 csubs) (co C D csubs) cles) (wbr (co D C csubs) (co B2 A2 csubs) cles)) $;

--| Equivalence for the surreal less-than or equal relationship between differences. (Contributed by Scott Fenton, 7-Mar-2025.)
theorem lesubsubs3bd (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wcel D csur) $ >
  $ wi ph (wb (wbr (co A2 C csubs) (co B2 D csubs) cles) (wbr (co D C csubs) (co B2 A2 csubs) cles)) $;

--| Surreal less-than relationship between subtraction and addition. (Contributed by Scott Fenton, 27-Feb-2025.)
theorem ltsubaddsd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wb (wbr (co A2 B2 csubs) C clts) (wbr A2 (co C B2 cadds) clts)) $;

--| Surreal less-than relationship between subtraction and addition. (Contributed by Scott Fenton, 27-Feb-2025.)
theorem ltsubadds2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wb (wbr (co A2 B2 csubs) C clts) (wbr A2 (co B2 C cadds) clts)) $;

--| Surreal less-than relationship between subtraction and addition. (Contributed by Scott Fenton, 28-Feb-2025.)
theorem ltaddsubsd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wb (wbr (co A2 B2 cadds) C clts) (wbr A2 (co C B2 csubs) clts)) $;

--| Surreal less-than relationship between subtraction and addition. (Contributed by Scott Fenton, 28-Feb-2025.)
theorem ltaddsubs2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wb (wbr (co A2 B2 cadds) C clts) (wbr B2 (co C A2 csubs) clts)) $;

--| Surreal less-than or equal relationship between subtraction and addition. (Contributed by Scott Fenton, 26-May-2025.)
theorem lesubaddsd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wb (wbr (co A2 B2 csubs) C cles) (wbr A2 (co C B2 cadds) cles)) $;

--| Law for double surreal subtraction. (Contributed by Scott Fenton, 9-Mar-2025.)
theorem subsubs4d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wceq (co (co A2 B2 csubs) C csubs) (co A2 (co B2 C cadds) csubs)) $;

--| Law for double surreal subtraction. (Contributed by Scott Fenton, 16-Apr-2025.)
theorem subsubs2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wceq (co A2 (co B2 C csubs) csubs) (co A2 (co C B2 csubs) cadds)) $;

--| Swap subtrahends in a surreal inequality. (Contributed by Scott Fenton, 29-Jan-2026.)
theorem lesubsd (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wb (wbr A2 (co B2 C csubs) cles) (wbr C (co B2 A2 csubs) cles)) $;

--| Cancellation law for surreal subtraction. (Contributed by Scott Fenton, 16-Apr-2025.)
theorem nncansd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wceq (co A2 (co A2 B2 csubs) csubs) B2) $;

--| Comparison of two surreals whose difference is positive. (Contributed by Scott Fenton, 10-Mar-2025.)
theorem posdifsd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wb (wbr A2 B2 clts) (wbr c0s (co B2 A2 csubs) clts)) $;

--| Subtraction of a positive number decreases the sum. (Contributed by Scott Fenton, 15-Apr-2025.)
theorem ltsubsposd (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wb (wbr c0s A2 clts) (wbr (co B2 A2 csubs) B2 clts)) $;

--| Non-negative subtraction. (Contributed by Scott Fenton, 26-May-2025.)
theorem subsge0d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wb (wbr c0s (co A2 B2 csubs) cles) (wbr B2 A2 cles)) $;

--| Rearrangement of four terms in mixed addition and subtraction. Surreal version. (Contributed by Scott Fenton, 25-Jul-2025.)
theorem addsubs4d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wcel D csur) $ >
  $ wi ph (wceq (co (co A2 B2 cadds) (co C D cadds) csubs) (co (co A2 C csubs) (co B2 D csubs) cadds)) $;

--| A surreal is greater than itself minus one. (Contributed by Scott Fenton, 20-Aug-2025.)
theorem ltsm1d (ph: wff) (A2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wbr (co A2 c1s csubs) A2 clts) $;

--| Cancellation law for surreal subtraction. (Contributed by Scott Fenton, 7-Nov-2025.)
theorem subscan1d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wb (wceq (co C A2 csubs) (co C B2 csubs)) (wceq A2 B2)) $;

--| Cancellation law for surreal subtraction. (Contributed by Scott Fenton, 7-Nov-2025.)
theorem subscan2d (ph: wff) (A2 B2 C: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wcel C csur) $ >
  $ wi ph (wb (wceq (co A2 C csubs) (co B2 C csubs)) (wceq A2 B2)) $;

--| The difference between two surreals is zero iff they are equal. (Contributed by Scott Fenton, 7-Nov-2025.)
theorem subseq0d (ph: wff) (A2 B2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wcel B2 csur) $ >
  $ wi ph (wb (wceq (co A2 B2 csubs) c0s) (wceq A2 B2)) $;

--| Set up the syntax for surreal multiplication.
term cmuls: class;

--| Define surreal multiplication. Definition from [Conway] p. 5. (Contributed by Scott Fenton, 4-Feb-2025.)
axiom df_muls {x3 y1 z w v u t m s1 r q p a b c d: setvar}:
  $ wceq cmuls (cnorec2 (cmpo z m cvv cvv (csb x3 (cfv (cv z) c1st) (csb y1 (cfv (cv z) c2nd) (co (cun (cab a (wrex p (wrex q (wceq (cv a) (co (co (co (cv p) (cv y1) (cv m)) (co (cv x3) (cv q) (cv m)) cadds) (co (cv p) (cv q) (cv m)) csubs)) (cfv (cv y1) cleft)) (cfv (cv x3) cleft))) (cab b (wrex r (wrex s1 (wceq (cv b) (co (co (co (cv r) (cv y1) (cv m)) (co (cv x3) (cv s1) (cv m)) cadds) (co (cv r) (cv s1) (cv m)) csubs)) (cfv (cv y1) cright)) (cfv (cv x3) cright)))) (cun (cab c (wrex t (wrex u (wceq (cv c) (co (co (co (cv t) (cv y1) (cv m)) (co (cv x3) (cv u) (cv m)) cadds) (co (cv t) (cv u) (cv m)) csubs)) (cfv (cv y1) cright)) (cfv (cv x3) cleft))) (cab d (wrex v (wrex w (wceq (cv d) (co (co (co (cv v) (cv y1) (cv m)) (co (cv x3) (cv w) (cv m)) cadds) (co (cv v) (cv w) (cv m)) csubs)) (cfv (cv y1) cleft)) (cfv (cv x3) cright)))) ccuts))))) $;

--| Surreal multiplication is a function over surreals. (Contributed by Scott Fenton, 4-Feb-2025.)
theorem mulsfn:
  $ wfn cmuls (cxp csur csur) $;

--| The value of surreal multiplication. (Contributed by Scott Fenton, 4-Feb-2025.)
theorem mulsval {w v u t s1 r q p a b c d: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wceq (co A2 B2 cmuls) (co (cun (cab a (wrex p (wrex q (wceq (cv a) (co (co (co (cv p) B2 cmuls) (co A2 (cv q) cmuls) cadds) (co (cv p) (cv q) cmuls) csubs)) (cfv B2 cleft)) (cfv A2 cleft))) (cab b (wrex r (wrex s1 (wceq (cv b) (co (co (co (cv r) B2 cmuls) (co A2 (cv s1) cmuls) cadds) (co (cv r) (cv s1) cmuls) csubs)) (cfv B2 cright)) (cfv A2 cright)))) (cun (cab c (wrex t (wrex u (wceq (cv c) (co (co (co (cv t) B2 cmuls) (co A2 (cv u) cmuls) cadds) (co (cv t) (cv u) cmuls) csubs)) (cfv B2 cright)) (cfv A2 cleft))) (cab d (wrex v (wrex w (wceq (cv d) (co (co (co (cv v) B2 cmuls) (co A2 (cv w) cmuls) cadds) (co (cv v) (cv w) cmuls) csubs)) (cfv B2 cleft)) (cfv A2 cright)))) ccuts)) $;

--| Lemma for ~ mulsval2 . Change bound variables in one of the cases. (Contributed by Scott Fenton, 8-Mar-2025.)
theorem mulsval2lem {s1 r q p a b: setvar} (A2 B2: class) (X: class s1 q) (Y: class):
  $ wceq (cab a (wrex p (wrex q (wceq (cv a) (co (co (co (cv p) B2 cmuls) (co A2 (cv q) cmuls) cadds) (co (cv p) (cv q) cmuls) csubs)) Y) X)) (cab b (wrex r (wrex s1 (wceq (cv b) (co (co (co (cv r) B2 cmuls) (co A2 (cv s1) cmuls) cadds) (co (cv r) (cv s1) cmuls) csubs)) Y) X)) $;

--| The value of surreal multiplication, expressed with fewer distinct variable conditions. (Contributed by Scott Fenton, 8-Mar-2025.)
theorem mulsval2 {w v u t s1 r q p a b c d: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wceq (co A2 B2 cmuls) (co (cun (cab a (wrex p (wrex q (wceq (cv a) (co (co (co (cv p) B2 cmuls) (co A2 (cv q) cmuls) cadds) (co (cv p) (cv q) cmuls) csubs)) (cfv B2 cleft)) (cfv A2 cleft))) (cab b (wrex r (wrex s1 (wceq (cv b) (co (co (co (cv r) B2 cmuls) (co A2 (cv s1) cmuls) cadds) (co (cv r) (cv s1) cmuls) csubs)) (cfv B2 cright)) (cfv A2 cright)))) (cun (cab c (wrex t (wrex u (wceq (cv c) (co (co (co (cv t) B2 cmuls) (co A2 (cv u) cmuls) cadds) (co (cv t) (cv u) cmuls) csubs)) (cfv B2 cright)) (cfv A2 cleft))) (cab d (wrex v (wrex w (wceq (cv d) (co (co (co (cv v) B2 cmuls) (co A2 (cv w) cmuls) cadds) (co (cv v) (cv w) cmuls) csubs)) (cfv B2 cleft)) (cfv A2 cright)))) ccuts)) $;

--| The value of surreal multiplication, expressed with fewer distinct variable conditions. (Contributed by Scott Fenton, 8-Mar-2025.)
theorem mulsval2_b {w v u t a: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 csur) (wcel B2 csur)) (wceq (co A2 B2 cmuls) (co (cun (cab a (wrex t (wrex w (wceq (cv a) (co (co (co (cv t) B2 cmuls) (co A2 (cv w) cmuls) cadds) (co (cv t) (cv w) cmuls) csubs)) (cfv B2 cleft)) (cfv A2 cleft))) (cab a (wrex v (wrex u (wceq (cv a) (co (co (co (cv v) B2 cmuls) (co A2 (cv u) cmuls) cadds) (co (cv v) (cv u) cmuls) csubs)) (cfv B2 cright)) (cfv A2 cright)))) (cun (cab a (wrex t (wrex u (wceq (cv a) (co (co (co (cv t) B2 cmuls) (co A2 (cv u) cmuls) cadds) (co (cv t) (cv u) cmuls) csubs)) (cfv B2 cright)) (cfv A2 cleft))) (cab a (wrex v (wrex w (wceq (cv a) (co (co (co (cv v) B2 cmuls) (co A2 (cv w) cmuls) cadds) (co (cv v) (cv w) cmuls) csubs)) (cfv B2 cleft)) (cfv A2 cright)))) ccuts)) $;

--| Surreal multiplication by zero. (Contributed by Scott Fenton, 4-Feb-2025.)
theorem muls01 (A2: class):
  $ wi (wcel A2 csur) (wceq (co A2 c0s cmuls) c0s) $;

--| Surreal one is a right identity element for multiplication. (Contributed by Scott Fenton, 4-Feb-2025.)
theorem mulsrid (A2: class):
  $ wi (wcel A2 csur) (wceq (co A2 c1s cmuls) A2) $;

--| Surreal one is a right identity element for multiplication. (Contributed by Scott Fenton, 14-Mar-2025.)
theorem mulsridd (ph: wff) (A2: class):
  $ wi ph (wcel A2 csur) $ >
  $ wi ph (wceq (co A2 c1s cmuls) A2) $;

--| Lemma for surreal multiplication. Change some bound variables for later use. (Contributed by Scott Fenton, 5-Mar-2025.)
theorem mulsproplemcbv {e f2 g2 h i j k a b c d l: setvar} (ph: wff e f2 g2 h i j k a b c d l) (A2 B2 C D E F: class):
  $ wi ph (wral a (wral b (wral c (wral d (wral e (wral f2 (wi (wcel (cun (co (cfv (cv a) cbday) (cfv (cv b) cbday) cnadd) (cun (cun (co (cfv (cv c) cbday) (cfv (cv e) cbday) cnadd) (co (cfv (cv d) cbday) (cfv (cv f2) cbday) cnadd)) (cun (co (cfv (cv c) cbday) (cfv (cv f2) cbday) cnadd) (co (cfv (cv d) cbday) (cfv (cv e) cbday) cnadd)))) (cun (co (cfv A2 cbday) (cfv B2 cbday) cnadd) (cun (cun (co (cfv C cbday) (cfv E cbday) cnadd) (co (cfv D cbday) (cfv F cbday) cnadd)) (cun (co (cfv C cbday) (cfv F cbday) cnadd) (co (cfv D cbday) (cfv E cbday) cnadd))))) (wa (wcel (co (cv a) (cv b) cmuls) csur) (wi (wa (wbr (cv c) (cv d) clts) (wbr (cv e) (cv f2) clts)) (wbr (co (co (cv c) (cv f2) cmuls) (co (cv c) (cv e) cmuls) csubs) (co (co (cv d) (cv f2) cmuls) (co (cv d) (cv e) cmuls) csubs) clts)))) csur) csur) csur) csur) csur) csur) $ >

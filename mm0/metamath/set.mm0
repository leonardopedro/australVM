  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq D (cfv W (cfv K cedring)) $ >
  $ wceq O (cmpt f2 T (cres cid B2)) $ >
  $ wceq c_0 (cfv D c0g) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wceq c_0 O) $;

--| The division ring unity of an endomorphism ring. (Contributed by NM, 5-Nov-2013.) (Revised by Mario Carneiro, 23-Jun-2014.)
theorem erng1r (D T c_1 H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq D (cfv W (cfv K cedring)) $ >
  $ wceq c_1 (cfv D cur) $ >
  $ wi (wa (wcel K chlt) (wcel W H)) (wceq c_1 (cres cid T)) $;


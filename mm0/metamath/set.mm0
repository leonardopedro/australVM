  $ wceq A2 (cfv K catm) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wceq Z (co (co S T c_or) U c_or) $ >
  $ wceq W (co Y C c_or) $ >
  $ wi ph (wbr T W c_le) $;

--| Lemma for ~ dath . Plane ` Z ` belongs to the 3-dimensional space. (Contributed by NM, 21-Jul-2012.)
theorem dalem8 (ph: wff) (A2 C P Q R S T U c_or K c_le O W Y Z: class):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wceq Z (co (co S T c_or) U c_or) $ >
  $ wceq W (co Y C c_or) $ >
  $ wi ph (wbr Z W c_le) $;

--| Lemma for ~ dalem9 . Center of perspectivity ` C ` is not in plane ` Y ` (when ` Y ` and ` Z ` are different planes). (Contributed by NM, 13-Aug-2012.)
theorem dalem_cly (ph: wff) (A2 C P Q R S T U c_or K c_le O Y Z: class):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wceq Z (co (co S T c_or) U c_or) $ >
  $ wi (wa ph (wne Y Z)) (wn (wbr C Y c_le)) $;

--| Lemma for ~ dath . Since ` -. C .<_ Y ` , the join ` Y .\/ C ` forms a 3-dimensional space. (Contributed by NM, 20-Jul-2012.)
theorem dalem9 (ph: wff) (A2 C P Q R S T U c_or K c_le O V W Y Z: class):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq V (cfv K clvol) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wceq Z (co (co S T c_or) U c_or) $ >
  $ wceq W (co Y C c_or) $ >
  $ wi (wa ph (wne Y Z)) (wcel W V) $;

--| Lemma for ~ dath . Atom ` D ` belongs to the axis of perspectivity ` X ` . (Contributed by NM, 19-Jul-2012.)
theorem dalem10 (ph: wff) (A2 C D P Q R S T U c_or K c_le c_an O X Y Z: class):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wceq Z (co (co S T c_or) U c_or) $ >
  $ wceq X (co Y Z c_an) $ >
  $ wceq D (co (co P Q c_or) (co S T c_or) c_an) $ >
  $ wi ph (wbr D X c_le) $;

--| Lemma for ~ dath . Analogue of ~ dalem10 for ` E ` . (Contributed by NM, 23-Jul-2012.)
theorem dalem11 (ph: wff) (A2 C P Q R S T U E c_or K c_le c_an O X Y Z: class):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wceq Z (co (co S T c_or) U c_or) $ >
  $ wceq X (co Y Z c_an) $ >
  $ wceq E (co (co Q R c_or) (co T U c_or) c_an) $ >
  $ wi ph (wbr E X c_le) $;

--| Lemma for ~ dath . Analogue of ~ dalem10 for ` F ` . (Contributed by NM, 11-Aug-2012.)
theorem dalem12 (ph: wff) (A2 C P Q R S T U F c_or K c_le c_an O X Y Z: class):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wceq Z (co (co S T c_or) U c_or) $ >
  $ wceq X (co Y Z c_an) $ >
  $ wceq F (co (co R P c_or) (co U S c_or) c_an) $ >
  $ wi ph (wbr F X c_le) $;

--| Lemma for ~ dalem14 . (Contributed by NM, 21-Jul-2012.)
theorem dalem13 (ph: wff) (A2 C P Q R S T U c_or K c_le O W Y Z: class):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wceq Z (co (co S T c_or) U c_or) $ >
  $ wceq W (co Y C c_or) $ >
  $ wi (wa ph (wne Y Z)) (wceq (co Y Z c_or) W) $;

--| Lemma for ~ dath . Planes ` Y ` and ` Z ` form a 3-dimensional space (when they are different). (Contributed by NM, 22-Jul-2012.)
theorem dalem14 (ph: wff) (A2 C P Q R S T U c_or K c_le O V W Y Z: class):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq V (cfv K clvol) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wceq Z (co (co S T c_or) U c_or) $ >
  $ wceq W (co Y C c_or) $ >
  $ wi (wa ph (wne Y Z)) (wcel (co Y Z c_or) V) $;

--| Lemma for ~ dath . The axis of perspectivity ` X ` is a line. (Contributed by NM, 21-Jul-2012.)
theorem dalem15 (ph: wff) (A2 C P Q R S T U c_or K c_le c_an N O X Y Z: class):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq N (cfv K clln) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wceq Z (co (co S T c_or) U c_or) $ >
  $ wceq X (co Y Z c_an) $ >
  $ wi (wa ph (wne Y Z)) (wcel X N) $;

--| Lemma for ~ dath . The atoms ` D ` , ` E ` , and ` F ` form a line of perspectivity. This is Desargues's theorem for the special case where planes ` Y ` and ` Z ` are different. (Contributed by NM, 7-Aug-2012.)
theorem dalem16 (ph: wff) (A2 C D P Q R S T U E F c_or K c_le c_an O Y Z: class):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wceq Z (co (co S T c_or) U c_or) $ >
  $ wceq D (co (co P Q c_or) (co S T c_or) c_an) $ >
  $ wceq E (co (co Q R c_or) (co T U c_or) c_an) $ >
  $ wceq F (co (co R P c_or) (co U S c_or) c_an) $ >
  $ wi (wa ph (wne Y Z)) (wbr F (co D E c_or) c_le) $;

--| Lemma for ~ dath . When planes ` Y ` and ` Z ` are equal, the center of perspectivity ` C ` is in ` Y ` . (Contributed by NM, 1-Aug-2012.)
theorem dalem17 (ph: wff) (A2 C P Q R S T U c_or K c_le O Y Z: class):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wceq Z (co (co S T c_or) U c_or) $ >
  $ wi (wa ph (wceq Y Z)) (wbr C Y c_le) $;

--| Lemma for ~ dath . Show that a dummy atom ` c ` exists outside of the ` Y ` and ` Z ` planes (when those planes are equal). This requires that the projective space be 3-dimensional. (Desargues's theorem does not always hold in 2 dimensions.) (Contributed by NM, 29-Jul-2012.)
theorem dalem18 {c: setvar} (ph: wff c) (A2: class) (C: class c) (P Q R: class) (S T U: class c) (c_or: class) (K: class c) (c_le: class) (O Y Z: class c):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wi ph (wrex c (wn (wbr (cv c) Y c_le)) A2) $;

--| Lemma for ~ dath . Show that a second dummy atom ` d ` exists outside of the ` Y ` and ` Z ` planes (when those planes are equal). (Contributed by NM, 15-Aug-2012.)
theorem dalem19 {d: setvar} (ph: wff d) (A2 C: class) (P Q R S T U c_or: class d) (K c_le: class) (O: class d) (Y: class) (Z: class d) (c: setvar):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wceq Z (co (co S T c_or) U c_or) $ >
  $ wi (wa (wa (wa ph (wceq Y Z)) (wcel (cv c) A2)) (wn (wbr (cv c) Y c_le))) (wrex d (w3a (wne (cv d) (cv c)) (wn (wbr (cv d) Y c_le)) (wbr C (co (cv c) (cv d) c_or) c_le)) A2) $;

--| Lemma for ~ dath . Frequently-used utility lemma. (Contributed by NM, 15-Aug-2012.)
theorem dalemccea {c d: setvar} (ps: wff c d) (A2 C c_or c_le Y: class c d):
  $ wb ps (w3a (wa (wcel (cv c) A2) (wcel (cv d) A2)) (wn (wbr (cv c) Y c_le)) (w3a (wne (cv d) (cv c)) (wn (wbr (cv d) Y c_le)) (wbr C (co (cv c) (cv d) c_or) c_le))) $ >
  $ wi ps (wcel (cv c) A2) $;

--| Lemma for ~ dath . Frequently-used utility lemma. (Contributed by NM, 15-Aug-2012.)
theorem dalemddea {c d: setvar} (ps: wff c d) (A2 C c_or c_le Y: class c d):
  $ wb ps (w3a (wa (wcel (cv c) A2) (wcel (cv d) A2)) (wn (wbr (cv c) Y c_le)) (w3a (wne (cv d) (cv c)) (wn (wbr (cv d) Y c_le)) (wbr C (co (cv c) (cv d) c_or) c_le))) $ >
  $ wi ps (wcel (cv d) A2) $;

--| Lemma for ~ dath . Frequently-used utility lemma. (Contributed by NM, 15-Aug-2012.)
theorem dalem_ccly {c d: setvar} (ps: wff c d) (A2 C c_or c_le Y: class c d):
  $ wb ps (w3a (wa (wcel (cv c) A2) (wcel (cv d) A2)) (wn (wbr (cv c) Y c_le)) (w3a (wne (cv d) (cv c)) (wn (wbr (cv d) Y c_le)) (wbr C (co (cv c) (cv d) c_or) c_le))) $ >
  $ wi ps (wn (wbr (cv c) Y c_le)) $;

--| Lemma for ~ dath . Frequently-used utility lemma. (Contributed by NM, 15-Aug-2012.)
theorem dalem_ddly {c d: setvar} (ps: wff c d) (A2 C c_or c_le Y: class c d):
  $ wb ps (w3a (wa (wcel (cv c) A2) (wcel (cv d) A2)) (wn (wbr (cv c) Y c_le)) (w3a (wne (cv d) (cv c)) (wn (wbr (cv d) Y c_le)) (wbr C (co (cv c) (cv d) c_or) c_le))) $ >
  $ wi ps (wn (wbr (cv d) Y c_le)) $;

--| Lemma for ~ dath . Frequently-used utility lemma. (Contributed by NM, 15-Aug-2012.)
theorem dalemccnedd {c d: setvar} (ps: wff c d) (A2 C c_or c_le Y: class c d):
  $ wb ps (w3a (wa (wcel (cv c) A2) (wcel (cv d) A2)) (wn (wbr (cv c) Y c_le)) (w3a (wne (cv d) (cv c)) (wn (wbr (cv d) Y c_le)) (wbr C (co (cv c) (cv d) c_or) c_le))) $ >
  $ wi ps (wne (cv c) (cv d)) $;

--| Lemma for ~ dath . Frequently-used utility lemma. (Contributed by NM, 15-Aug-2012.)
theorem dalemclccjdd {c d: setvar} (ps: wff c d) (A2 C c_or c_le Y: class c d):
  $ wb ps (w3a (wa (wcel (cv c) A2) (wcel (cv d) A2)) (wn (wbr (cv c) Y c_le)) (w3a (wne (cv d) (cv c)) (wn (wbr (cv d) Y c_le)) (wbr C (co (cv c) (cv d) c_or) c_le))) $ >
  $ wi ps (wbr C (co (cv c) (cv d) c_or) c_le) $;

--| Lemma for ~ dath . Frequently-used utility lemma. (Contributed by NM, 15-Aug-2012.)
theorem dalemcceb {c d: setvar} (ps: wff c d) (A2 C c_or K c_le Y: class c d):
  $ wb ps (w3a (wa (wcel (cv c) A2) (wcel (cv d) A2)) (wn (wbr (cv c) Y c_le)) (w3a (wne (cv d) (cv c)) (wn (wbr (cv d) Y c_le)) (wbr C (co (cv c) (cv d) c_or) c_le))) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi ps (wcel (cv c) (cfv K cbs)) $;

--| Lemma for ~ dath . Swap the ` Y ` and ` Z ` planes, along with dummy concurrency (center of perspectivity) atoms ` c ` and ` d ` , to allow reuse of analogous proofs. (Contributed by NM, 17-Aug-2012.)
theorem dalemswapyzps {c d: setvar} (ph ps: wff c d) (A2 C P Q R S T U c_or K c_le O Y Z: class c d):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wb ps (w3a (wa (wcel (cv c) A2) (wcel (cv d) A2)) (wn (wbr (cv c) Y c_le)) (w3a (wne (cv d) (cv c)) (wn (wbr (cv d) Y c_le)) (wbr C (co (cv c) (cv d) c_or) c_le))) $ >
  $ wi (w3a ph (wceq Y Z) ps) (w3a (wa (wcel (cv d) A2) (wcel (cv c) A2)) (wn (wbr (cv d) Z c_le)) (w3a (wne (cv c) (cv d)) (wn (wbr (cv c) Z c_le)) (wbr C (co (cv d) (cv c) c_or) c_le))) $;

--| Lemma for ~ dath . Rotate triangles ` Y = P Q R ` and ` Z = S T U ` to allow reuse of analogous proofs. (Contributed by NM, 15-Aug-2012.)
theorem dalemrotps {c d: setvar} (ph ps: wff c d) (A2 C P Q R S T U c_or K c_le O Y Z: class c d):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wb ps (w3a (wa (wcel (cv c) A2) (wcel (cv d) A2)) (wn (wbr (cv c) Y c_le)) (w3a (wne (cv d) (cv c)) (wn (wbr (cv d) Y c_le)) (wbr C (co (cv c) (cv d) c_or) c_le))) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wi (wa ph ps) (w3a (wa (wcel (cv c) A2) (wcel (cv d) A2)) (wn (wbr (cv c) (co (co Q R c_or) P c_or) c_le)) (w3a (wne (cv d) (cv c)) (wn (wbr (cv d) (co (co Q R c_or) P c_or) c_le)) (wbr C (co (cv c) (cv d) c_or) c_le))) $;

--| Lemma for ~ dath . Show that the dummy atoms form a line. (Contributed by NM, 15-Aug-2012.)
theorem dalemcjden {c d: setvar} (ph ps: wff c d) (A2 C P Q R S T U c_or K c_le O Y Z: class c d):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wb ps (w3a (wa (wcel (cv c) A2) (wcel (cv d) A2)) (wn (wbr (cv c) Y c_le)) (w3a (wne (cv d) (cv c)) (wn (wbr (cv d) Y c_le)) (wbr C (co (cv c) (cv d) c_or) c_le))) $ >
  $ wi (wa ph ps) (wcel (co (cv c) (cv d) c_or) (cfv K clln)) $;

--| Lemma for ~ dath . Show that a second dummy atom ` d ` exists outside of the ` Y ` and ` Z ` planes (when those planes are equal). (Contributed by NM, 14-Aug-2012.)
theorem dalem20 {c d: setvar} (ph: wff d) (ps: wff c d) (A2: class) (C: class c) (P Q R: class d) (S T U: class c d) (c_or: class d) (K: class c) (c_le: class) (O: class c d) (Y: class) (Z: class d):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wb ps (w3a (wa (wcel (cv c) A2) (wcel (cv d) A2)) (wn (wbr (cv c) Y c_le)) (w3a (wne (cv d) (cv c)) (wn (wbr (cv d) Y c_le)) (wbr C (co (cv c) (cv d) c_or) c_le))) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wceq Z (co (co S T c_or) U c_or) $ >
  $ wi (wa ph (wceq Y Z)) (wex c (wex d ps)) $;

--| Lemma for ~ dath . Show that lines ` c d ` and ` P S ` intersect at an atom. (Contributed by NM, 2-Aug-2012.)
theorem dalem21 {c d: setvar} (ph ps: wff c d) (A2 C P Q R S T U c_or K c_le c_an O Y Z: class c d):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wb ps (w3a (wa (wcel (cv c) A2) (wcel (cv d) A2)) (wn (wbr (cv c) Y c_le)) (w3a (wne (cv d) (cv c)) (wn (wbr (cv d) Y c_le)) (wbr C (co (cv c) (cv d) c_or) c_le))) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wceq Z (co (co S T c_or) U c_or) $ >
  $ wi (w3a ph (wceq Y Z) ps) (wcel (co (co (cv c) (cv d) c_or) (co P S c_or) c_an) A2) $;

--| Lemma for ~ dath . Show that lines ` c d ` and ` P S ` determine a plane. (Contributed by NM, 2-Aug-2012.)
theorem dalem22 {c d: setvar} (ph ps: wff c d) (A2 C P Q R S T U c_or K c_le O Y Z: class c d):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wb ps (w3a (wa (wcel (cv c) A2) (wcel (cv d) A2)) (wn (wbr (cv c) Y c_le)) (w3a (wne (cv d) (cv c)) (wn (wbr (cv d) Y c_le)) (wbr C (co (cv c) (cv d) c_or) c_le))) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wceq Z (co (co S T c_or) U c_or) $ >
  $ wi (w3a ph (wceq Y Z) ps) (wcel (co (co (cv c) (cv d) c_or) (co P S c_or) c_or) O) $;

--| Lemma for ~ dath . Show that auxiliary atom ` G ` is an atom. (Contributed by NM, 2-Aug-2012.)
theorem dalem23 {c d: setvar} (ph ps: wff c d) (A2 C P Q R S T U G c_or K c_le c_an O Y Z: class c d):
  $ wb ph (w3a (w3a (wa (wcel K chlt) (wcel C (cfv K cbs))) (w3a (wcel P A2) (wcel Q A2) (wcel R A2)) (w3a (wcel S A2) (wcel T A2) (wcel U A2))) (wa (wcel Y O) (wcel Z O)) (w3a (w3a (wn (wbr C (co P Q c_or) c_le)) (wn (wbr C (co Q R c_or) c_le)) (wn (wbr C (co R P c_or) c_le))) (w3a (wn (wbr C (co S T c_or) c_le)) (wn (wbr C (co T U c_or) c_le)) (wn (wbr C (co U S c_or) c_le))) (w3a (wbr C (co P S c_or) c_le) (wbr C (co Q T c_or) c_le) (wbr C (co R U c_or) c_le)))) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wb ps (w3a (wa (wcel (cv c) A2) (wcel (cv d) A2)) (wn (wbr (cv c) Y c_le)) (w3a (wne (cv d) (cv c)) (wn (wbr (cv d) Y c_le)) (wbr C (co (cv c) (cv d) c_or) c_le))) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq O (cfv K clpl) $ >
  $ wceq Y (co (co P Q c_or) R c_or) $ >
  $ wceq Z (co (co S T c_or) U c_or) $ >
  $ wceq G (co (co (cv c) P c_or) (co (cv d) S c_or) c_an) $ >
  $ wi (w3a ph (wceq Y Z) ps) (wcel G A2) $;

--| Lemma for ~ dath . Show that auxiliary atom ` G ` is outside of plane ` Y ` . (Contributed by NM, 2-Aug-2012.)
theorem dalem24 {c d: setvar} (ph ps: wff c d) (A2 C P Q R S T U G c_or K c_le c_an O Y Z: class c d):

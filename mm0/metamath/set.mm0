  $ wi ph (wcel X csur) $ >
  $ wi ph (wcel Y csur) $ >
  $ wi ph (wcel Z csur) $ >
  $ wi ph (wcel W csur) $ >
  $ wi ph (wcel T csur) $ >
  $ wi ph (wcel U csur) $ >
  $ wi ph (wcel (cun (co (cfv X cbday) (cfv Y cbday) cnadd) (cun (cun (co (cfv Z cbday) (cfv T cbday) cnadd) (co (cfv W cbday) (cfv U cbday) cnadd)) (cun (co (cfv Z cbday) (cfv U cbday) cnadd) (co (cfv W cbday) (cfv T cbday) cnadd)))) (cun (co (cfv A2 cbday) (cfv B2 cbday) cnadd) (cun (cun (co (cfv C cbday) (cfv E cbday) cnadd) (co (cfv D cbday) (cfv F cbday) cnadd)) (cun (co (cfv C cbday) (cfv F cbday) cnadd) (co (cfv D cbday) (cfv E cbday) cnadd))))) $ >
  $ wi ph (wa (wcel (co X Y cmuls) csur) (wi (wa (wbr Z W clts) (wbr T U clts)) (wbr (co (co Z U cmuls) (co Z T cmuls) csubs) (co (co W U cmuls) (co W T cmuls) csubs) clts))) $;


  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (w3a (wcel K chlt) (w3a (wcel (cv p) A2) (wcel (cv r) A2) (wcel (cv s1) A2)) (w3a (wcel (cv x3) A2) (wcel (cv y1) A2) (wcel (cv z) A2))) (wa (w3a (wn (wbr (cv r) (co (cv x3) (cv y1) c_or) c_le)) (wbr (cv r) (co (cv y1) (cv z) c_or) c_le) (wbr (cv s1) (co (cv x3) (cv y1) c_or) c_le)) (wbr (cv s1) (co (cv p) (cv z) c_or) c_le))) (wbr (cv p) (co (cv s1) (cv z) c_or) c_le) $;

--| Lemma for ~ paddass . (Contributed by NM, 8-Jan-2012.)
theorem paddasslem8 (x3 y1 z: setvar) (A2 c_pl c_or K c_le X Y Z: class) (s1 p: setvar):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (w3a (wcel K chlt) (w3a (wss X A2) (wss Y A2) (wss Z A2)) (wa (wcel (cv p) A2) (wcel (cv s1) A2))) (w3a (w3a (wcel (cv x3) X) (wcel (cv y1) Y) (wcel (cv z) Z)) (wbr (cv s1) (co (cv x3) (cv y1) c_or) c_le) (wbr (cv p) (co (cv s1) (cv z) c_or) c_le))) (wcel (cv p) (co (co X Y c_pl) Z c_pl)) $;

--| Lemma for ~ paddass . Combine ~ paddasslem7 and ~ paddasslem8 . (Contributed by NM, 9-Jan-2012.)
theorem paddasslem9 (x3 y1 z: setvar) (A2 c_pl c_or K c_le X Y Z: class) (s1 r p: setvar):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (w3a (wcel K chlt) (w3a (wss X A2) (wss Y A2) (wss Z A2)) (wa (wcel (cv p) A2) (wcel (cv r) A2))) (w3a (w3a (wcel (cv x3) X) (wcel (cv y1) Y) (wcel (cv z) Z)) (wa (wn (wbr (cv r) (co (cv x3) (cv y1) c_or) c_le)) (wbr (cv r) (co (cv y1) (cv z) c_or) c_le)) (w3a (wcel (cv s1) A2) (wbr (cv s1) (co (cv x3) (cv y1) c_or) c_le) (wbr (cv s1) (co (cv p) (cv z) c_or) c_le)))) (wcel (cv p) (co (co X Y c_pl) Z c_pl)) $;

--| Lemma for ~ paddass . Use ~ paddasslem4 to eliminate ` s ` from ~ paddasslem9 . (Contributed by NM, 9-Jan-2012.)
theorem paddasslem10 (x3 y1 z: setvar) (A2 c_pl c_or K c_le X Y Z: class) (r p: setvar):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (w3a (w3a (wcel K chlt) (wne (cv p) (cv z)) (wne (cv x3) (cv y1))) (w3a (wss X A2) (wss Y A2) (wss Z A2)) (wa (wcel (cv p) A2) (wcel (cv r) A2))) (wa (w3a (wcel (cv x3) X) (wcel (cv y1) Y) (wcel (cv z) Z)) (w3a (wn (wbr (cv r) (co (cv x3) (cv y1) c_or) c_le)) (wbr (cv p) (co (cv x3) (cv r) c_or) c_le) (wbr (cv r) (co (cv y1) (cv z) c_or) c_le)))) (wcel (cv p) (co (co X Y c_pl) Z c_pl)) $;

--| Lemma for ~ paddass . The case when ` p = z ` . (Contributed by NM, 11-Jan-2012.)
theorem paddasslem11 (z: setvar) (A2 c_pl c_or K c_le X Y Z: class) (p: setvar):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (wa (wa (wcel K chlt) (wceq (cv p) (cv z))) (w3a (wss X A2) (wss Y A2) (wss Z A2))) (wcel (cv z) Z)) (wcel (cv p) (co (co X Y c_pl) Z c_pl)) $;

--| Lemma for ~ paddass . The case when ` x = y ` . (Contributed by NM, 11-Jan-2012.)
theorem paddasslem12 (x3 y1 z: setvar) (A2 c_pl c_or K c_le X Y Z: class) (r p: setvar):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (w3a (wa (wcel K chlt) (wceq (cv x3) (cv y1))) (w3a (wss X A2) (wss Y A2) (wss Z A2)) (wa (wcel (cv p) A2) (wcel (cv r) A2))) (wa (wa (wcel (cv y1) Y) (wcel (cv z) Z)) (wa (wbr (cv p) (co (cv x3) (cv r) c_or) c_le) (wbr (cv r) (co (cv y1) (cv z) c_or) c_le)))) (wcel (cv p) (co (co X Y c_pl) Z c_pl)) $;

--| Lemma for ~ paddass . The case when ` r .<_ ( x .\/ y ) ` . (Unlike the proof in Maeda and Maeda, we don't need ` x =/= y ` .) (Contributed by NM, 11-Jan-2012.)
theorem paddasslem13 (x3 y1 z: setvar) (A2 c_pl c_or K c_le X Y Z: class) (r p: setvar):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (w3a (wa (wcel K chlt) (wne (cv p) (cv z))) (w3a (wss X A2) (wss Y A2) (wss Z A2)) (wa (wcel (cv p) A2) (wcel (cv r) A2))) (wa (wa (wcel (cv x3) X) (wcel (cv y1) Y)) (wa (wbr (cv r) (co (cv x3) (cv y1) c_or) c_le) (wbr (cv p) (co (cv x3) (cv r) c_or) c_le)))) (wcel (cv p) (co (co X Y c_pl) Z c_pl)) $;

--| Lemma for ~ paddass . Remove ` p =/= z ` , ` x =/= y ` , and ` -. r .<_ ( x .\/ y ) ` from antecedent of ~ paddasslem10 , using ~ paddasslem11 , ~ paddasslem12 , and ~ paddasslem13 . (Contributed by NM, 11-Jan-2012.)
theorem paddasslem14 (x3 y1 z: setvar) (A2 c_pl c_or K c_le X Y Z: class) (r p: setvar):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (w3a (wcel K chlt) (w3a (wss X A2) (wss Y A2) (wss Z A2)) (wa (wcel (cv p) A2) (wcel (cv r) A2))) (wa (w3a (wcel (cv x3) X) (wcel (cv y1) Y) (wcel (cv z) Z)) (wa (wbr (cv p) (co (cv x3) (cv r) c_or) c_le) (wbr (cv r) (co (cv y1) (cv z) c_or) c_le)))) (wcel (cv p) (co (co X Y c_pl) Z c_pl)) $;

--| Lemma for ~ paddass . Use ~ elpaddn0 to eliminate ` y ` and ` z ` from ~ paddasslem14 . (Contributed by NM, 11-Jan-2012.)
theorem paddasslem15 (x3: setvar) (A2 c_pl c_or K c_le X Y Z: class) (r p: setvar):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (w3a (wcel K chlt) (w3a (wss X A2) (wss Y A2) (wss Z A2)) (wa (wne Y c0) (wne Z c0))) (w3a (wcel (cv p) A2) (wa (wcel (cv x3) X) (wcel (cv r) (co Y Z c_pl))) (wbr (cv p) (co (cv x3) (cv r) c_or) c_le))) (wcel (cv p) (co (co X Y c_pl) Z c_pl)) $;

--| Lemma for ~ paddass . Use ~ elpaddn0 to eliminate ` x ` and ` r ` from ~ paddasslem15 . (Contributed by NM, 11-Jan-2012.)
theorem paddasslem16 (A2 c_pl c_or K c_le X Y Z: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (w3a (wcel K chlt) (w3a (wss X A2) (wss Y A2) (wss Z A2)) (wa (wa (wne X c0) (wne (co Y Z c_pl) c0)) (wa (wne Y c0) (wne Z c0)))) (wss (co X (co Y Z c_pl) c_pl) (co (co X Y c_pl) Z c_pl)) $;

--| Lemma for ~ paddass . The case when at least one sum argument is empty. (Contributed by NM, 12-Jan-2012.)
theorem paddasslem17 (A2 c_pl K X Y Z: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (w3a (wcel K chlt) (w3a (wss X A2) (wss Y A2) (wss Z A2)) (wn (wa (wa (wne X c0) (wne (co Y Z c_pl) c0)) (wa (wne Y c0) (wne Z c0))))) (wss (co X (co Y Z c_pl) c_pl) (co (co X Y c_pl) Z c_pl)) $;

--| Lemma for ~ paddass . Combine ~ paddasslem16 and ~ paddasslem17 . (Contributed by NM, 12-Jan-2012.)
theorem paddasslem18 (A2 c_pl K X Y Z: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (wcel K chlt) (w3a (wss X A2) (wss Y A2) (wss Z A2))) (wss (co X (co Y Z c_pl) c_pl) (co (co X Y c_pl) Z c_pl)) $;

--| Projective subspace sum is associative. Equation 16.2.1 of [MaedaMaeda] p. 68. In our version, the subspaces do not have to be nonempty. (Contributed by NM, 29-Dec-2011.)
theorem paddass (A2 c_pl K X Y Z: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (wcel K chlt) (w3a (wss X A2) (wss Y A2) (wss Z A2))) (wceq (co (co X Y c_pl) Z c_pl) (co X (co Y Z c_pl) c_pl)) $;

--| Commutative/associative law for projective subspace sum. (Contributed by NM, 14-Jan-2012.) (New usage is discouraged.)
theorem padd12N (A2 c_pl K X Y Z: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (wcel K chlt) (w3a (wss X A2) (wss Y A2) (wss Z A2))) (wceq (co X (co Y Z c_pl) c_pl) (co Y (co X Z c_pl) c_pl)) $;

--| Rearrangement of 4 terms in a projective subspace sum. (Contributed by NM, 14-Jan-2012.) (New usage is discouraged.)
theorem padd4N (A2 c_pl K W X Y Z: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (w3a (wcel K chlt) (wa (wss X A2) (wss Y A2)) (wa (wss Z A2) (wss W A2))) (wceq (co (co X Y c_pl) (co Z W c_pl) c_pl) (co (co X Z c_pl) (co Y W c_pl) c_pl)) $;

--| Projective subspace sum is idempotent. Part of Lemma 16.2 of [MaedaMaeda] p. 68. (Contributed by NM, 13-Jan-2012.)
theorem paddidm (B2 c_pl S K X: class):
  $ wceq S (cfv K cpsubsp) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (wcel K B2) (wcel X S)) (wceq (co X X c_pl) X) $;

--| The projective sum of two subspaces is a subspace. Part of Lemma 16.2 of [MaedaMaeda] p. 68. (Contributed by NM, 14-Jan-2012.) (New usage is discouraged.)
theorem paddclN (c_pl S K X Y: class):
  $ wceq S (cfv K cpsubsp) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (w3a (wcel K chlt) (wcel X S) (wcel Y S)) (wcel (co X Y c_pl) S) $;

--| Subset law for projective subspace sum valid for all subsets of atoms. (Contributed by NM, 14-Mar-2012.)
theorem paddssw1 (A2 B2 c_pl K X Y Z: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (wcel K B2) (w3a (wss X A2) (wss Y A2) (wss Z A2))) (wi (wa (wss X Z) (wss Y Z)) (wss (co X Y c_pl) (co Z Z c_pl))) $;

--| Subset law for projective subspace sum valid for all subsets of atoms. (Contributed by NM, 14-Mar-2012.)
theorem paddssw2 (A2 B2 c_pl K X Y Z: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (wcel K B2) (w3a (wss X A2) (wss Y A2) (wss Z A2))) (wi (wss (co X Y c_pl) Z) (wa (wss X Z) (wss Y Z))) $;

--| Subset law for projective subspace sum. ( ~ unss analog.) (Contributed by NM, 7-Mar-2012.)
theorem paddss (A2 B2 c_pl S K X Y Z: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq S (cfv K cpsubsp) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (wcel K B2) (w3a (wss X A2) (wss Y A2) (wcel Z S))) (wb (wa (wss X Z) (wss Y Z)) (wss (co X Y c_pl) Z)) $;

--| Lemma for ~ pmod1i . (Contributed by NM, 9-Mar-2012.)
theorem pmodlem1 (A2 c_pl S c_or K c_le X Y Z: class) (r q p: setvar):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq S (cfv K cpsubsp) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (w3a (w3a (wcel K chlt) (wss X A2) (wss Y A2)) (w3a (wcel Z S) (wss X Z) (wcel (cv p) Z)) (w3a (wcel (cv q) X) (wcel (cv r) Y) (wbr (cv p) (co (cv q) (cv r) c_or) c_le))) (wcel (cv p) (co X (cin Y Z) c_pl)) $;

--| Lemma for ~ pmod1i . (Contributed by NM, 9-Mar-2012.)
theorem pmodlem2 (A2 c_pl S c_or K c_le X Y Z: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq S (cfv K cpsubsp) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (w3a (wcel K chlt) (w3a (wss X A2) (wss Y A2) (wcel Z S)) (wss X Z)) (wss (cin (co X Y c_pl) Z) (co X (cin Y Z) c_pl)) $;

--| The modular law holds in a projective subspace. (Contributed by NM, 10-Mar-2012.)
theorem pmod1i (A2 c_pl S K X Y Z: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq S (cfv K cpsubsp) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (wcel K chlt) (w3a (wss X A2) (wss Y A2) (wcel Z S))) (wi (wss X Z) (wceq (cin (co X Y c_pl) Z) (co X (cin Y Z) c_pl))) $;

--| Dual of the modular law. (Contributed by NM, 8-Apr-2012.) (New usage is discouraged.)
theorem pmod2iN (A2 c_pl S K X Y Z: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq S (cfv K cpsubsp) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (wcel K chlt) (w3a (wcel X S) (wss Y A2) (wss Z A2))) (wi (wss Z X) (wceq (co (cin X Y) Z c_pl) (cin X (co Y Z c_pl)))) $;

--| The modular law for projective subspaces. (Contributed by NM, 26-Mar-2012.) (New usage is discouraged.)
theorem pmodN (A2 c_pl S K X Y Z: class):
  $ wceq A2 (cfv K catm) $ >
  $ wceq S (cfv K cpsubsp) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (wcel K chlt) (w3a (wcel X S) (wss Y A2) (wss Z A2))) (wceq (cin X (co Y (cin X Z) c_pl)) (co (cin X Y) (cin X Z) c_pl)) $;

--| Lemma derived from modular law. (Contributed by NM, 8-Apr-2012.) (New usage is discouraged.)
theorem pmodl42N (c_pl S K W X Y Z: class):
  $ wceq S (cfv K cpsubsp) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (w3a (wcel K chlt) (wcel X S) (wcel Y S)) (wa (wcel Z S) (wcel W S))) (wceq (cin (co (co X Y c_pl) Z c_pl) (co (co X Y c_pl) W c_pl)) (co (co X Y c_pl) (cin (co X Z c_pl) (co Y W c_pl)) c_pl)) $;

--| The projective map of the join of two lattice elements. Part of Equation 15.5.3 of [MaedaMaeda] p. 63. (Contributed by NM, 27-Jan-2012.)
theorem pmapjoin (B2 c_pl c_or K M X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (w3a (wcel K clat) (wcel X B2) (wcel Y B2)) (wss (co (cfv X M) (cfv Y M) c_pl) (cfv (co X Y c_or) M)) $;

--| The projective map of the join of a lattice element and an atom. (Contributed by NM, 28-Jan-2012.)
theorem pmapjat1 (A2 B2 c_pl Q c_or K M X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (w3a (wcel K chlt) (wcel X B2) (wcel Q A2)) (wceq (cfv (co X Q c_or) M) (co (cfv X M) (cfv Q M) c_pl)) $;

--| The projective map of the join of an atom with a lattice element. (Contributed by NM, 12-May-2012.)
theorem pmapjat2 (A2 B2 c_pl Q c_or K M X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (w3a (wcel K chlt) (wcel X B2) (wcel Q A2)) (wceq (cfv (co Q X c_or) M) (co (cfv Q M) (cfv X M) c_pl)) $;

--| The projective map of the join of a lattice element and a lattice line (expressed as the join ` Q .\/ R ` of two atoms). (Contributed by NM, 16-Sep-2012.)
theorem pmapjlln1 (A2 B2 c_pl Q R c_or K M X: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq M (cfv K cpmap) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (wcel K chlt) (w3a (wcel X B2) (wcel Q A2) (wcel R A2))) (wceq (cfv (co X (co Q R c_or) c_or) M) (co (cfv X M) (cfv (co Q R c_or) M) c_pl)) $;

--| A version of the modular law ~ pmod1i that holds in a Hilbert lattice. (Contributed by NM, 13-May-2012.)
theorem hlmod1i (B2 c_pl F c_or K c_le c_an X Y Z: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq F (cfv K cpmap) $ >
  $ wceq c_pl (cfv K cpadd) $ >
  $ wi (wa (wcel K chlt) (w3a (wcel X B2) (wcel Y B2) (wcel Z B2))) (wi (wa (wbr X Z c_le) (wceq (cfv (co X Y c_or) F) (co (cfv X F) (cfv Y F) c_pl))) (wceq (co (co X Y c_or) Z c_an) (co X (co Y Z c_an) c_or))) $;

--| Version of modular law ~ pmod1i that holds in a Hilbert lattice, when one element is an atom. (Contributed by NM, 11-May-2012.) (Revised by Mario Carneiro, 10-May-2013.)
theorem atmod1i1 (A2 B2 P c_or K c_le c_an X Y: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (w3a (wcel K chlt) (w3a (wcel P A2) (wcel X B2) (wcel Y B2)) (wbr P Y c_le)) (wceq (co P (co X Y c_an) c_or) (co (co P X c_or) Y c_an)) $;

--| Version of modular law ~ pmod1i that holds in a Hilbert lattice, when an element meets an atom. (Contributed by NM, 2-Sep-2012.) (Revised by Mario Carneiro, 10-May-2013.)
theorem atmod1i1m (A2 B2 P c_or K c_le c_an X Y Z: class):

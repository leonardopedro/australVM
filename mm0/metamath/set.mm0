  $ wceq G (cmpt n cn0 (cif (wceq (cv n) cc0) (co c_0 (co (cfv M T) (cfv (cfv cc0 (cv b)) T) c_xp) c_mi) (cif (wceq (cv n) (co (cv s1) c1 caddc)) (cfv (cfv (cv s1) (cv b)) T) (cif (wbr (co (cv s1) c1 caddc) (cv n) clt) c_0 (co (cfv (cfv (co (cv n) c1 cmin) (cv b)) T) (co (cfv M T) (cfv (cfv (cv n) (cv b)) T) c_xp) c_mi))))) $ >

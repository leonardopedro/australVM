  $ wi ph (wceq (cfv (csn (co X Y c_pl)) c_pe) (cfv C L)) $;

--| Lemma for ~ lcfr . (Contributed by NM, 6-Mar-2015.)
theorem lcfrlem36 {x3 w v k: setvar} (ph: wff x3 w v k) (A2 B2 C D: class x3 w v k) (c_pl: class) (Q: class x3 w v k) (R: class w) (S: class x3 w v) (c_x: class) (U F H I J K L c_mi N: class x3 w v k) (c_pe: class) (V: class w k) (W: class x3 w v k) (X Y: class) (c_0: class w v k):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel Y (cdif V (csn c_0))) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wceq B2 (cin (cfv (cpr X Y) N) (cfv (csn (co X Y c_pl)) c_pe)) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq S (cfv U csca) $ >
  $ wceq Q (cfv S c0g) $ >
  $ wceq R (cfv S cbs) $ >
  $ wceq J (cmpt x3 (cdif V (csn c_0)) (cmpt v V (crio k (wrex w (wceq (cv v) (co (cv w) (co (cv k) (cv x3) c_x) c_pl)) (cfv (csn (cv x3)) c_pe)) R))) $ >
  $ wi ph (wcel I B2) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq D (cfv U cld) $ >
  $ wi ph (wne (cfv I (cfv Y J)) Q) $ >
  $ wceq F (cfv S cinvr) $ >
  $ wceq c_mi (cfv D csg) $ >
  $ wceq C (co (cfv X J) (co (co (cfv (cfv I (cfv Y J)) F) (cfv I (cfv X J)) (cfv S cmulr)) (cfv Y J) (cfv D cvsca)) c_mi) $ >
  $ wi ph (wcel (co X Y c_pl) (cfv (cfv C L) c_pe)) $;

--| Lemma for ~ lcfr . (Contributed by NM, 8-Mar-2015.)
theorem lcfrlem37 {x3 w v f2 g2 k: setvar} (ph: wff x3 w v f2) (A2 B2: class x3 w v f2 g2 k) (C D: class x3 w v f2) (c_pl: class) (Q: class x3 w v f2) (R: class w g2) (S: class x3 w v f2 g2) (c_x: class g2) (U: class x3 w v g2) (E F: class x3 w v f2 g2 k) (G: class x3 w v f2) (H: class x3 w v f2 g2 k) (I: class x3 w v f2) (J: class x3 w v) (K: class x3 w v f2 g2 k) (L: class x3 w v) (c_mi N: class x3 w v f2 g2 k) (c_pe: class) (V: class w k) (W: class x3 w v f2 g2 k) (X Y: class) (c_0: class w v f2 g2 k):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel Y (cdif V (csn c_0))) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wceq B2 (cin (cfv (cpr X Y) N) (cfv (csn (co X Y c_pl)) c_pe)) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq S (cfv U csca) $ >
  $ wceq Q (cfv S c0g) $ >
  $ wceq R (cfv S cbs) $ >
  $ wceq J (cmpt x3 (cdif V (csn c_0)) (cmpt v V (crio k (wrex w (wceq (cv v) (co (cv w) (co (cv k) (cv x3) c_x) c_pl)) (cfv (csn (cv x3)) c_pe)) R))) $ >
  $ wi ph (wcel I B2) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq D (cfv U cld) $ >
  $ wi ph (wne (cfv I (cfv Y J)) Q) $ >
  $ wceq F (cfv S cinvr) $ >
  $ wceq c_mi (cfv D csg) $ >
  $ wceq C (co (cfv X J) (co (co (cfv (cfv I (cfv Y J)) F) (cfv I (cfv X J)) (cfv S cmulr)) (cfv Y J) (cfv D cvsca)) c_mi) $ >
  $ wi ph (wcel G (cfv D clss)) $ >
  $ wi ph (wss G (crab f2 (wceq (cfv (cfv (cfv (cv f2) L) c_pe) c_pe) (cfv (cv f2) L)) (cfv U clfn))) $ >
  $ wceq E (ciun g2 G (cfv (cfv (cv g2) L) c_pe)) $ >
  $ wi ph (wcel X E) $ >
  $ wi ph (wcel Y E) $ >
  $ wi ph (wcel (co X Y c_pl) E) $;

--| Lemma for ~ lcfr . Combine ~ lcfrlem27 and ~ lcfrlem37 . (Contributed by NM, 11-Mar-2015.)
theorem lcfrlem38 {x3 w v f2 g2 k: setvar} (ph: wff x3 w v f2) (B2 C: class x3 w v f2 g2 k) (D: class x3 w v f2) (c_pl: class) (Q: class x3 w v f2 g2 k) (R: class w g2) (S: class x3 w v f2) (c_x: class g2) (U: class) (E F: class x3 w v f2 g2 k) (G: class x3 w v f2) (H: class x3 w v f2 g2 k) (I: class x3 w v f2) (J: class x3 w v) (K: class x3 w v f2 g2 k) (L: class x3 w v) (N: class x3 w v f2 g2 k) (c_pe: class) (V: class w k) (W: class x3 w v f2 g2 k) (X Y: class) (c_0: class w v):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq D (cfv U cld) $ >
  $ wceq Q (cfv D clss) $ >
  $ wceq C (crab f2 (wceq (cfv (cfv (cfv (cv f2) L) c_pe) c_pe) (cfv (cv f2) L)) (cfv U clfn)) $ >
  $ wceq E (ciun g2 G (cfv (cfv (cv g2) L) c_pe)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G Q) $ >
  $ wi ph (wss G C) $ >
  $ wi ph (wcel X E) $ >
  $ wi ph (wcel Y E) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wi ph (wne X c_0) $ >
  $ wi ph (wne Y c_0) $ >
  $ wceq N (cfv U clspn) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wceq B2 (cin (cfv (cpr X Y) N) (cfv (csn (co X Y c_pl)) c_pe)) $ >
  $ wi ph (wcel I B2) $ >
  $ wi ph (wne I c_0) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_x (cfv U cvsca) $ >
  $ wceq S (cfv U csca) $ >
  $ wceq R (cfv S cbs) $ >
  $ wceq J (cmpt x3 (cdif V (csn c_0)) (cmpt v V (crio k (wrex w (wceq (cv v) (co (cv w) (co (cv k) (cv x3) c_x) c_pl)) (cfv (csn (cv x3)) c_pe)) R))) $ >
  $ wi ph (wcel (co X Y c_pl) E) $;

--| Lemma for ~ lcfr . Eliminate ` J ` . (Contributed by NM, 11-Mar-2015.)
theorem lcfrlem39 {f2 g2: setvar} (ph: wff f2) (B2 C: class f2 g2) (D: class f2) (c_pl: class) (Q: class f2 g2) (U: class) (E F: class f2 g2) (G: class f2) (H: class f2 g2) (I: class f2) (K: class f2 g2) (L: class) (N: class f2 g2) (c_pe: class) (W: class f2 g2) (X Y c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq D (cfv U cld) $ >
  $ wceq Q (cfv D clss) $ >
  $ wceq C (crab f2 (wceq (cfv (cfv (cfv (cv f2) L) c_pe) c_pe) (cfv (cv f2) L)) (cfv U clfn)) $ >
  $ wceq E (ciun g2 G (cfv (cfv (cv g2) L) c_pe)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G Q) $ >
  $ wi ph (wss G C) $ >
  $ wi ph (wcel X E) $ >
  $ wi ph (wcel Y E) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wi ph (wne X c_0) $ >
  $ wi ph (wne Y c_0) $ >
  $ wceq N (cfv U clspn) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wceq B2 (cin (cfv (cpr X Y) N) (cfv (csn (co X Y c_pl)) c_pe)) $ >
  $ wi ph (wcel I B2) $ >
  $ wi ph (wne I c_0) $ >
  $ wi ph (wcel (co X Y c_pl) E) $;

--| Lemma for ~ lcfr . Eliminate ` B ` and ` I ` . (Contributed by NM, 11-Mar-2015.)
theorem lcfrlem40 {f2 g2: setvar} (ph: wff f2) (C: class f2 g2) (D: class f2) (c_pl: class) (Q: class f2 g2) (U: class) (E F: class f2 g2) (G: class f2) (H K: class f2 g2) (L: class) (N: class f2) (c_pe: class) (W: class f2 g2) (X Y c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq D (cfv U cld) $ >
  $ wceq Q (cfv D clss) $ >
  $ wceq C (crab f2 (wceq (cfv (cfv (cfv (cv f2) L) c_pe) c_pe) (cfv (cv f2) L)) (cfv U clfn)) $ >
  $ wceq E (ciun g2 G (cfv (cfv (cv g2) L) c_pe)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G Q) $ >
  $ wi ph (wss G C) $ >
  $ wi ph (wcel X E) $ >
  $ wi ph (wcel Y E) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wi ph (wne X c_0) $ >
  $ wi ph (wne Y c_0) $ >
  $ wceq N (cfv U clspn) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wcel (co X Y c_pl) E) $;

--| Lemma for ~ lcfr . Eliminate span condition. (Contributed by NM, 11-Mar-2015.)
theorem lcfrlem41 {f2 g2: setvar} (ph: wff f2) (C: class f2 g2) (D: class f2) (c_pl: class) (Q: class f2 g2) (U: class) (E F: class f2 g2) (G: class f2) (H K: class f2 g2) (L c_pe: class) (W: class f2 g2) (X Y c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq D (cfv U cld) $ >
  $ wceq Q (cfv D clss) $ >
  $ wceq C (crab f2 (wceq (cfv (cfv (cfv (cv f2) L) c_pe) c_pe) (cfv (cv f2) L)) (cfv U clfn)) $ >
  $ wceq E (ciun g2 G (cfv (cfv (cv g2) L) c_pe)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G Q) $ >
  $ wi ph (wss G C) $ >
  $ wi ph (wcel X E) $ >
  $ wi ph (wcel Y E) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wi ph (wne X c_0) $ >
  $ wi ph (wne Y c_0) $ >
  $ wi ph (wcel (co X Y c_pl) E) $;

--| Lemma for ~ lcfr . Eliminate nonzero condition. (Contributed by NM, 11-Mar-2015.)
theorem lcfrlem42 {f2 g2: setvar} (ph: wff f2) (C: class f2 g2) (D: class f2) (c_pl: class) (Q: class f2 g2) (U: class) (E F: class f2 g2) (G: class f2) (H K: class f2 g2) (L c_pe: class) (W: class f2 g2) (X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq c_pl (cfv U cplusg) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq D (cfv U cld) $ >
  $ wceq Q (cfv D clss) $ >
  $ wceq C (crab f2 (wceq (cfv (cfv (cfv (cv f2) L) c_pe) c_pe) (cfv (cv f2) L)) (cfv U clfn)) $ >
  $ wceq E (ciun g2 G (cfv (cfv (cv g2) L) c_pe)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G Q) $ >
  $ wi ph (wss G C) $ >
  $ wi ph (wcel X E) $ >
  $ wi ph (wcel Y E) $ >
  $ wi ph (wcel (co X Y c_pl) E) $;

--| Reconstruction of a subspace from a dual subspace of functionals with closed kernels. Our proof was suggested by Mario Carneiro, 20-Feb-2015. (Contributed by NM, 5-Mar-2015.)
theorem lcfr {f2 g2: setvar} (ph: wff f2 g2) (C D Q: class f2 g2) (R: class f2) (S T: class f2 g2) (U F: class g2) (H K: class f2 g2) (L c_pe: class) (W: class f2 g2):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq D (cfv U cld) $ >
  $ wceq T (cfv D clss) $ >
  $ wceq C (crab f2 (wceq (cfv (cfv (cfv (cv f2) L) c_pe) c_pe) (cfv (cv f2) L)) F) $ >
  $ wceq Q (ciun g2 R (cfv (cfv (cv g2) L) c_pe)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel R T) $ >
  $ wi ph (wss R C) $ >
  $ wi ph (wcel Q S) $;

--| Extend class notation with vector space of functionals with closed kernels.
term clcd: class;

--| Dual vector space of functionals with closed kernels. Note: we could also define this directly without ` mapd ` by using ~ mapdrn . TODO: see if it makes sense to go back and replace some of the ` LDual ` stuff with this. TODO: We could simplify ~ df-mapd using ` ( Base `` ( ( LCDual `` K ) `` W ) ) ` . (Contributed by NM, 13-Mar-2015.)
axiom df_lcdual {w f2 k: setvar}:
  $ wceq clcd (cmpt k cvv (cmpt w (cfv (cv k) clh) (co (cfv (cfv (cv w) (cfv (cv k) cdvh)) cld) (crab f2 (wceq (cfv (cfv (cfv (cv f2) (cfv (cfv (cv w) (cfv (cv k) cdvh)) clk)) (cfv (cv w) (cfv (cv k) coch))) (cfv (cv w) (cfv (cv k) coch))) (cfv (cv f2) (cfv (cfv (cv w) (cfv (cv k) cdvh)) clk))) (cfv (cfv (cv w) (cfv (cv k) cdvh)) clfn)) cress))) $;

--| Dual vector space of functionals with closed kernels. (Contributed by NM, 13-Mar-2015.)
theorem lcdfval {w f2: setvar} (H: class f2) (K: class) (X: class w f2):
  $ wceq H (cfv K clh) $ >
  $ wi (wcel K X) (wceq (cfv K clcd) (cmpt w H (co (cfv (cfv (cv w) (cfv K cdvh)) cld) (crab f2 (wceq (cfv (cfv (cfv (cv f2) (cfv (cfv (cv w) (cfv K cdvh)) clk)) (cfv (cv w) (cfv K coch))) (cfv (cv w) (cfv K coch))) (cfv (cv f2) (cfv (cfv (cv w) (cfv K cdvh)) clk))) (cfv (cfv (cv w) (cfv K cdvh)) clfn)) cress))) $;

--| Dual vector space of functionals with closed kernels. (Contributed by NM, 13-Mar-2015.)
theorem lcdval {f2: setvar} (ph: wff f2) (C D U: class f2) (F: class) (H: class f2) (K: class) (L c_pe: class f2) (W: class) (X: class f2):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq D (cfv U cld) $ >
  $ wi ph (wa (wcel K X) (wcel W H)) $ >
  $ wi ph (wceq C (co D (crab f2 (wceq (cfv (cfv (cfv (cv f2) L) c_pe) c_pe) (cfv (cv f2) L)) F) cress)) $;

--| Dual vector space of functionals with closed kernels. (Contributed by NM, 13-Mar-2015.)
theorem lcdval2 {f2: setvar} (ph: wff f2) (B2 C D U: class f2) (F: class) (H: class f2) (K: class) (L c_pe: class f2) (W: class) (X: class f2):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq D (cfv U cld) $ >
  $ wi ph (wa (wcel K X) (wcel W H)) $ >
  $ wceq B2 (crab f2 (wceq (cfv (cfv (cfv (cv f2) L) c_pe) c_pe) (cfv (cv f2) L)) F) $ >
  $ wi ph (wceq C (co D B2 cress)) $;

--| The dual vector space of functionals with closed kernels is a left vector space. (Contributed by NM, 14-Mar-2015.)
theorem lcdlvec (ph: wff) (C H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel C clvec) $;

--| The dual vector space of functionals with closed kernels is a left module. (Contributed by NM, 13-Mar-2015.)
theorem lcdlmod (ph: wff) (C H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel C clmod) $;

--| Vector base set of a dual vector space of functionals with closed kernels. (Contributed by NM, 13-Mar-2015.)
theorem lcdvbase {f2: setvar} (ph: wff f2) (B2 C U: class f2) (F: class) (H: class f2) (K: class) (L c_pe V: class f2) (W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq V (cfv C cbs) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq B2 (crab f2 (wceq (cfv (cfv (cfv (cv f2) L) c_pe) c_pe) (cfv (cv f2) L)) F) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wceq V B2) $;

--| The vector base set of the closed kernel dual space is a set of functionals. (Contributed by NM, 15-Mar-2015.)
theorem lcdvbasess (ph: wff) (C U F H K V W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq V (cfv C cbs) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq F (cfv U clfn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wss V F) $;

--| A vector in the base set of the closed kernel dual space is a functional. (Contributed by NM, 28-Mar-2015.)
theorem lcdvbaselfl (ph: wff) (C U F H K V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq V (cfv C cbs) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq F (cfv U clfn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel X F) $;

--| Closure of the value of a vector (functional) in the closed kernel dual space. (Contributed by NM, 28-Mar-2015.)
theorem lcdvbasecl (ph: wff) (C R S U E F H K V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq S (cfv U csca) $ >
  $ wceq R (cfv S cbs) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq E (cfv C cbs) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel F E) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel (cfv X F) R) $;

--| Vector addition for the closed kernel vector space dual. (Contributed by NM, 10-Jun-2015.)
theorem lcdvadd (ph: wff) (C D c_pl c_pb U H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq D (cfv U cld) $ >
  $ wceq c_pl (cfv D cplusg) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq c_pb (cfv C cplusg) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wceq c_pb c_pl) $;

--| The value of the value of vector addition in the closed kernel vector space dual. (Contributed by NM, 10-Jun-2015.)
theorem lcdvaddval (ph: wff) (C D c_pl c_pb R U F G H K V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq c_pl (cfv R cplusg) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq D (cfv C cbs) $ >
  $ wceq c_pb (cfv C cplusg) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel F D) $ >
  $ wi ph (wcel G D) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wceq (cfv X (co F G c_pb)) (co (cfv X F) (cfv X G) c_pl)) $;

--| The ring of scalars of the closed kernel dual space. (Contributed by NM, 16-Mar-2015.) (Revised by Mario Carneiro, 6-May-2015.)
theorem lcdsca (ph: wff) (C R U F H K O W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq F (cfv U csca) $ >
  $ wceq O (cfv F coppr) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq R (cfv C csca) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wceq R O) $;

--| Base set of scalar ring for the closed kernel dual of a vector space. (Contributed by NM, 18-Mar-2015.)
theorem lcdsbase (ph: wff) (C R S U F H K L W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq F (cfv U csca) $ >
  $ wceq L (cfv F cbs) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq S (cfv C csca) $ >
  $ wceq R (cfv S cbs) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wceq R L) $;

--| Scalar addition for the closed kernel vector space dual. (Contributed by NM, 6-Jun-2015.)
theorem lcdsadd (ph: wff) (C c_pl c_pb S U F H K W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq F (cfv U csca) $ >
  $ wceq c_pl (cfv F cplusg) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq S (cfv C csca) $ >
  $ wceq c_pb (cfv S cplusg) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wceq c_pb c_pl) $;

--| Scalar multiplication for the closed kernel vector space dual. (Contributed by NM, 20-Mar-2015.)
theorem lcdsmul (ph: wff) (C S c_xb c_x U F H K L W X Y: class):
  $ wceq H (cfv K clh) $ >

theorem cdlemkid3N {z g2 b: setvar} (A2 B2 P R T F G H c_or K c_le c_an N W: class) (X: class z g2 b) (Y: class g2 b) (Z: class z b):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wceq T (cfv W (cfv K cltrn)) $ >
  $ wceq R (cfv W (cfv K ctrl)) $ >
  $ wceq Z (co (co P (cfv (cv b) R) c_or) (co (cfv P N) (cfv (ccom (cv b) (ccnv F)) R) c_or) c_an) $ >
  $ wceq Y (co (co P (cfv (cv g2) R) c_or) (co Z (cfv (ccom (cv g2) (ccnv (cv b))) R) c_or) c_an) $ >
  $ wceq X (crio z (wral b (wi (w3a (wne (cv b) (cres cid B2)) (wne (cfv (cv b) R) (cfv F R)) (wne (cfv (cv b) R) (cfv (cv g2) R))) (wceq (cfv P (cv z)) Y)) T) T) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (w3a (wcel F T) (wcel N T) (wceq (cfv F R) (cfv N R))) (wa (wa (wcel P A2) (wn (wbr P W c_le))) (wceq G (cres cid B2)))) (wceq (csb g2 G X) (crio z (wral b (wi (w3a (wne (cv b) (cres cid B2)) (wne (cfv (cv b) R) (cfv F R)) (wne (cfv (cv b) R) (cfv G R))) (wceq (cfv P (cv z)) P)) T) T)) $;


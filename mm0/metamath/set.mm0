  $ wceq D (co (co R T c_or) (co P S c_or) c_an) $ >
  $ wi (wa ph (wceq C S)) (wrex z (wa (wn (wbr (cv z) W c_le)) (wceq (co P (cv z) c_or) (co S (cv z) c_or))) A2) $;

--| Lemma for ~ 4atexlem7 . (Contributed by NM, 25-Nov-2012.)
theorem _4atexlemex6 {z: setvar} (A2 P Q R S: class) (H: class z) (c_or: class) (K: class z) (c_le c_an W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (w3a (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wa (wa (wcel R A2) (wn (wbr R W c_le))) (wcel S A2)) (w3a (wceq (co P R c_or) (co Q R c_or)) (wne P Q) (wn (wbr S (co P Q c_or) c_le)))) (wrex z (wa (wn (wbr (cv z) W c_le)) (wceq (co P (cv z) c_or) (co S (cv z) c_or))) A2) $;

--| Whenever there are at least 4 atoms under ` P .\/ Q ` (specifically, ` P ` , ` Q ` , ` r ` , and ` ( P .\/ Q ) ./\ W ` ), there are also at least 4 atoms under ` P .\/ S ` . This proves the statement in Lemma E of [Crawley] p. 114, last line, "...p ` \/ ` q/0 and hence p ` \/ ` s/0 contains at least four atoms..." Note that by ~ cvlsupr2 , our ` ( P .\/ r ) = ( Q .\/ r ) ` is a shorter way to express ` r =/= P /\ r =/= Q /\ r .<_ ( P .\/ Q ) ` . With a longer proof, the condition ` -. S .<_ ( P .\/ Q ) ` could be eliminated (see ~ 4atex ), although for some purposes this more restricted lemma may be adequate. (Contributed by NM, 25-Nov-2012.)
theorem _4atexlem7 {z r: setvar} (A2 P Q S: class) (H: class z) (c_or K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (w3a (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le))) (wcel S A2)) (w3a (wne P Q) (wn (wbr S (co P Q c_or) c_le)) (wrex r (wa (wn (wbr (cv r) W c_le)) (wceq (co P (cv r) c_or) (co Q (cv r) c_or))) A2))) (wrex z (wa (wn (wbr (cv z) W c_le)) (wceq (co P (cv z) c_or) (co S (cv z) c_or))) A2) $;

--| Whenever there are at least 4 atoms under ` P .\/ Q ` (specifically, ` P ` , ` Q ` , ` r ` , and ` ( P .\/ Q ) ./\ W ` ), there are also at least 4 atoms under ` P .\/ S ` . This proves the statement in Lemma E of [Crawley] p. 114, last line, "...p ` \/ ` q/0 and hence p ` \/ ` s/0 contains at least four atoms..." Note that by ~ cvlsupr2 , our ` ( P .\/ r ) = ( Q .\/ r ) ` is a shorter way to express ` r =/= P /\ r =/= Q /\ r .<_ ( P .\/ Q ) ` . (Contributed by NM, 27-May-2013.)
theorem _4atex {z r: setvar} (A2 P Q S: class) (H: class z) (c_or K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (w3a (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le))) (wcel S A2)) (wa (wne P Q) (wrex r (wa (wn (wbr (cv r) W c_le)) (wceq (co P (cv r) c_or) (co Q (cv r) c_or))) A2))) (wrex z (wa (wn (wbr (cv z) W c_le)) (wceq (co P (cv z) c_or) (co S (cv z) c_or))) A2) $;

--| More general version of ~ 4atex for a line ` S .\/ T ` not necessarily connected to ` P .\/ Q ` . (Contributed by NM, 27-May-2013.)
theorem _4atex2 {z r: setvar} (A2 P Q S T: class) (H: class z) (c_or K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (w3a (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le))) (wa (wcel S A2) (wn (wbr S W c_le)))) (w3a (wne P Q) (wcel T A2) (wrex r (wa (wn (wbr (cv r) W c_le)) (wceq (co P (cv r) c_or) (co Q (cv r) c_or))) A2))) (wrex z (wa (wn (wbr (cv z) W c_le)) (wceq (co S (cv z) c_or) (co T (cv z) c_or))) A2) $;

--| Same as ~ 4atex2 except that ` S ` is zero. (Contributed by NM, 27-May-2013.) (New usage is discouraged.)
theorem _4atex2_0aOLDN {z r: setvar} (A2 P Q S T: class) (H: class z) (c_or K c_le W: class):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (w3a (wa (wcel K chlt) (wcel W H)) (w3a (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le))) (wceq S (cfv K cp0))) (w3a (wne P Q) (wa (wcel T A2) (wn (wbr T W c_le))) (wrex r (wa (wn (wbr (cv r) W c_le)) (wceq (co P (cv r) c_or) (co Q (cv r) c_or))) A2))) (wrex z (wa (wn (wbr (cv z) W c_le)) (wceq (co S (cv z) c_or) (co T (cv z) c_or))) A2) $;


  $ wi ph (wceq (cfv G L) (cfv (csn X) O)) $ >
  $ wi ph (wceq (cfv (cfv (csn X) N) M) (crab f2 (wss (cfv G L) (cfv (cv f2) L)) F)) $;

--| Value of the map defined by ~ df-mapd at the span of a singleton. (Contributed by NM, 17-Feb-2015.)
theorem mapdsn3 (ph: wff) (D P U F G H K L M N O V W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq O (cfv W (cfv K coch)) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >

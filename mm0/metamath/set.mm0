  $ wceq V (cfv U cbs) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wss (cfv (csn X) c_pe) (cfv G L)) $ >
  $ wi ph (wceq (cfv (cfv (cfv G L) c_pe) c_pe) (cfv G L)) $;

--| The set of functionals having closed kernels is closed under scalar product. (Contributed by NM, 28-Dec-2014.)
theorem lclkrlem1 {f2: setvar} (ph: wff f2) (B2 C D R: class f2) (c_x: class) (U: class f2) (F G: class) (H K: class f2) (L c_pe: class) (W: class f2) (X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq c_pe (cfv W (cfv K coch)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq F (cfv U clfn) $ >
  $ wceq L (cfv U clk) $ >
  $ wceq D (cfv U cld) $ >
  $ wceq R (cfv U csca) $ >
  $ wceq B2 (cfv R cbs) $ >
  $ wceq c_x (cfv D cvsca) $ >
  $ wceq C (crab f2 (wceq (cfv (cfv (cfv (cv f2) L) c_pe) c_pe) (cfv (cv f2) L)) F) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X B2) $ >
  $ wi ph (wcel G C) $ >
  $ wi ph (wcel (co X G c_x) C) $;


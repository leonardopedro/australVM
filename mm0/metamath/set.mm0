  $ wi (w3a (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wne P Q) (wa (wcel (cv s1) A2) (wa (wn (wbr (cv s1) W c_le)) ph))) (wcel N B2) $ >
  $ wi (w3a (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wa (wne P Q) (wa (wcel R A2) (wn (wbr R W c_le)))) ps) (wcel (csb s1 R N) B2) $ >
  $ wceq O (crio z (wral s1 (wi (wa (wn (wbr (cv s1) W c_le)) (wceq (co (cv s1) (co R W c_an) c_or) R)) (wceq (cv z) (co N (co R W c_an) c_or))) A2) B2) $ >
  $ wi (w3a (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wa (wne P Q) (wa (wcel R A2) (wn (wbr R W c_le)))) ps) (wcel O B2) $;

--| Part of proof of Lemma E in [Crawley] p. 113. Value of ` F ` at an atom not under ` W ` . TODO: FIX COMMENT. TODO: consolidate uses of ~ lhpmat here and elsewhere, and presence/absence of ` s .<_ ( P .\/ Q ) ` term. Also, why can proof be shortened with ~ cdleme29cl ? What is difference from ~ cdlemefs27cl ? (Contributed by NM, 29-Mar-2013.)
theorem cdlemefrs32fva {x3 z s1: setvar} (ph: wff x3 s1) (ps: wff x3) (A2 B2: class) (P Q: class x3) (R: class) (H: class x3) (c_or: class) (K: class x3) (c_le c_an: class) (N: class s1) (O: class x3 z s1) (W: class):
  $ wceq B2 (cfv K cbs) $ >
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq c_an (cfv K cmee) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wceq H (cfv K clh) $ >
  $ wi (wceq (cv s1) R) (wb ph ps) $ >
  $ wi (w3a (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wne P Q) (wa (wcel (cv s1) A2) (wa (wn (wbr (cv s1) W c_le)) ph))) (wcel N B2) $ >
  $ wi (w3a (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wa (wne P Q) (wa (wcel R A2) (wn (wbr R W c_le)))) ps) (wcel (csb s1 R N) B2) $ >
  $ wceq O (crio z (wral s1 (wi (wa (wn (wbr (cv s1) W c_le)) (wceq (co (cv s1) (co (cv x3) W c_an) c_or) (cv x3))) (wceq (cv z) (co N (co (cv x3) W c_an) c_or))) A2) B2) $ >
  $ wi (w3a (w3a (wa (wcel K chlt) (wcel W H)) (wa (wcel P A2) (wn (wbr P W c_le))) (wa (wcel Q A2) (wn (wbr Q W c_le)))) (wa (wne P Q) (wa (wcel R A2) (wn (wbr R W c_le)))) ps) (wceq (csb x3 R O) (csb s1 R N)) $;


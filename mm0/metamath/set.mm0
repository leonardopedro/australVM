--| Lemma for ~ paddass . Show ` s =/= z ` by contradiction. (Contributed by NM, 8-Jan-2012.)
theorem paddasslem5 (x3 y1 z: setvar) (A2 c_or K c_le: class) (s1 r: setvar):
  $ wceq c_le (cfv K cple) $ >
  $ wceq c_or (cfv K cjn) $ >
  $ wceq A2 (cfv K catm) $ >
  $ wi (wa (w3a (wcel K chlt) (wcel (cv r) A2) (w3a (wcel (cv x3) A2) (wcel (cv y1) A2) (wcel (cv z) A2))) (w3a (wn (wbr (cv r) (co (cv x3) (cv y1) c_or) c_le)) (wbr (cv r) (co (cv y1) (cv z) c_or) c_le) (wbr (cv s1) (co (cv x3) (cv y1) c_or) c_le))) (wne (cv s1) (cv z)) $;

--| Lemma for ~ paddass . (Contributed by NM, 8-Jan-2012.)
theorem paddasslem6 (z: setvar) (A2 c_or K c_le: class) (s1 p: setvar):
  $ wceq c_le (cfv K cple) $ >

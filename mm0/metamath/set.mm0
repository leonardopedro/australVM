  $ wceq B2 (cab d (wa (wss (cv d) A2) (wral x3 (wss (c_bnj14 A2 R (cv x3)) (cv d)) (cv d)))) $ >
  $ wceq Y (cop (cv x3) (cres (cv f2) (c_bnj14 A2 R (cv x3)))) $ >
  $ wceq C (cab f2 (wrex d (wa (wfn (cv f2) (cv d)) (wral x3 (wceq (cfv (cv x3) (cv f2)) (cfv Y G)) (cv d))) B2)) $ >
  $ wceq F (cuni C) $ >
  $ wb ph (wa (w_bnj15 A2 R) (wcel (cv x3) A2)) $ >
  $ wb ps (w3a ph (wcel (cv f2) C) (wcel (cv x3) (cdm (cv f2)))) $ >
  $ wb ch (w3a ps (wcel (cv d) B2) (wceq (cdm (cv f2)) (cv d))) $ >
  $ wi (w_bnj15 A2 R) (wral x3 (wceq (cfv (cv x3) F) (cfv (cop (cv x3) (cres F (c_bnj14 A2 R (cv x3)))) G)) A2) $;

--| Well-founded recursion, part 2 of 3. The proof has been taken from Chapter 4 of Don Monk's notes on Set Theory. See ~ http://euclid.colorado.edu/~~monkd/setth.pdf . (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj1500 {x3 f2 d: setvar} (A2: class) (B2: class x3 d) (C: class x3 f2 d) (R: class) (F: class x3 f2 d) (G: class) (Y: class x3 f2):
  $ wceq B2 (cab d (wa (wss (cv d) A2) (wral x3 (wss (c_bnj14 A2 R (cv x3)) (cv d)) (cv d)))) $ >
  $ wceq Y (cop (cv x3) (cres (cv f2) (c_bnj14 A2 R (cv x3)))) $ >
  $ wceq C (cab f2 (wrex d (wa (wfn (cv f2) (cv d)) (wral x3 (wceq (cfv (cv x3) (cv f2)) (cfv Y G)) (cv d))) B2)) $ >
  $ wceq F (cuni C) $ >
  $ wi (w_bnj15 A2 R) (wral x3 (wceq (cfv (cv x3) F) (cfv (cop (cv x3) (cres F (c_bnj14 A2 R (cv x3)))) G)) A2) $;

--| Technical lemma for ~ bnj1522 . This lemma may no longer be used or have become an indirect lemma of the theorem in question (i.e. a lemma of a lemma... of the theorem). (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj1525 {x3 f2 d: setvar} (ph ps: wff x3 f2 d) (A2: class f2 d) (B2 C: class x3 f2 d) (R: class f2 d) (F G: class x3 f2 d) (H: class f2 d) (Y: class x3 f2 d):
  $ wceq B2 (cab d (wa (wss (cv d) A2) (wral x3 (wss (c_bnj14 A2 R (cv x3)) (cv d)) (cv d)))) $ >
  $ wceq Y (cop (cv x3) (cres (cv f2) (c_bnj14 A2 R (cv x3)))) $ >
  $ wceq C (cab f2 (wrex d (wa (wfn (cv f2) (cv d)) (wral x3 (wceq (cfv (cv x3) (cv f2)) (cfv Y G)) (cv d))) B2)) $ >
  $ wceq F (cuni C) $ >
  $ wb ph (w3a (w_bnj15 A2 R) (wfn H A2) (wral x3 (wceq (cfv (cv x3) H) (cfv (cop (cv x3) (cres H (c_bnj14 A2 R (cv x3)))) G)) A2)) $ >
  $ wb ps (wa ph (wne F H)) $ >
  $ wi ps (wal x3 ps) $;

--| Technical lemma for ~ bnj1522 . This lemma may no longer be used or have become an indirect lemma of the theorem in question (i.e. a lemma of a lemma... of the theorem). (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj1529 {x3 y1 w: setvar} (ch: wff x3 y1 w) (A2 R: class) (F: class x3) (G: class):
  $ wi ch (wral x3 (wceq (cfv (cv x3) F) (cfv (cop (cv x3) (cres F (c_bnj14 A2 R (cv x3)))) G)) A2) $ >
  $ wi (wcel (cv w) F) (wal x3 (wcel (cv w) F)) $ >
  $ wi ch (wral y1 (wceq (cfv (cv y1) F) (cfv (cop (cv y1) (cres F (c_bnj14 A2 R (cv y1)))) G)) A2) $;

--| Technical lemma for ~ bnj1522 . This lemma may no longer be used or have become an indirect lemma of the theorem in question (i.e. a lemma of a lemma... of the theorem). (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj1523 {x3 y1 z f2 d: setvar} (ph ps: wff x3 y1 z f2 d) (ch: wff x3 z f2 d) (th: wff x3 y1 z f2 d) (A2: class) (B2: class x3 y1 z d) (C: class x3 y1 z f2 d) (D: class x3 f2 d) (R: class) (F: class x3 f2 d) (G: class z) (H: class f2 d) (Y: class x3 y1 z f2):
  $ wceq B2 (cab d (wa (wss (cv d) A2) (wral x3 (wss (c_bnj14 A2 R (cv x3)) (cv d)) (cv d)))) $ >
  $ wceq Y (cop (cv x3) (cres (cv f2) (c_bnj14 A2 R (cv x3)))) $ >
  $ wceq C (cab f2 (wrex d (wa (wfn (cv f2) (cv d)) (wral x3 (wceq (cfv (cv x3) (cv f2)) (cfv Y G)) (cv d))) B2)) $ >
  $ wceq F (cuni C) $ >
  $ wb ph (w3a (w_bnj15 A2 R) (wfn H A2) (wral x3 (wceq (cfv (cv x3) H) (cfv (cop (cv x3) (cres H (c_bnj14 A2 R (cv x3)))) G)) A2)) $ >
  $ wb ps (wa ph (wne F H)) $ >
  $ wb ch (w3a ps (wcel (cv x3) A2) (wne (cfv (cv x3) F) (cfv (cv x3) H))) $ >
  $ wceq D (crab x3 (wne (cfv (cv x3) F) (cfv (cv x3) H)) A2) $ >
  $ wb th (w3a ch (wcel (cv y1) D) (wral z (wn (wbr (cv z) (cv y1) R)) D)) $ >
  $ wi (w3a (w_bnj15 A2 R) (wfn H A2) (wral x3 (wceq (cfv (cv x3) H) (cfv (cop (cv x3) (cres H (c_bnj14 A2 R (cv x3)))) G)) A2)) (wceq F H) $;

--| Well-founded recursion, part 3 of 3. The proof has been taken from Chapter 4 of Don Monk's notes on Set Theory. See ~ http://euclid.colorado.edu/~~monkd/setth.pdf . (Contributed by Jonathan Ben-Naim, 3-Jun-2011.) (New usage is discouraged.)
theorem bnj1522 {x3 f2 d: setvar} (A2: class) (B2: class x3 d) (C: class x3 f2 d) (R: class) (F: class x3 f2 d) (G: class) (H: class f2 d) (Y: class x3 f2):
  $ wceq B2 (cab d (wa (wss (cv d) A2) (wral x3 (wss (c_bnj14 A2 R (cv x3)) (cv d)) (cv d)))) $ >
  $ wceq Y (cop (cv x3) (cres (cv f2) (c_bnj14 A2 R (cv x3)))) $ >
  $ wceq C (cab f2 (wrex d (wa (wfn (cv f2) (cv d)) (wral x3 (wceq (cfv (cv x3) (cv f2)) (cfv Y G)) (cv d))) B2)) $ >
  $ wceq F (cuni C) $ >
  $ wi (w3a (w_bnj15 A2 R) (wfn H A2) (wral x3 (wceq (cfv (cv x3) H) (cfv (cop (cv x3) (cres H (c_bnj14 A2 R (cv x3)))) G)) A2)) (wceq F H) $;

--| Variant of ~ nfan and commuted form of ~ nfan1 . (Contributed by BTernaryTau, 31-Jul-2025.)
theorem nfan1c {x3: setvar} (ph ps: wff x3):
  $ wnf x3 ph $ >
  $ wi ph (wnf x3 ps) $ >
  $ wnf x3 (wa ps ph) $;

--| Rule used to change bound variables, using implicit substitution. (Contributed by BTernaryTau, 31-Jul-2025.)
theorem cbvex1v {x3 y1: setvar} (ph ps ch: wff x3 y1):
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wi ph (wnf y1 ps) $ >
  $ wi ph (wnf x3 ch) $ >
  $ wi ph (wi (wceq (cv x3) (cv y1)) (wi ps ch)) $ >
  $ wi ph (wi (wex x3 ps) (wex y1 ch)) $;

--| Eliminate a disjoint variable condition from a universally quantified statement using cases. (Contributed by BTernaryTau, 31-Jul-2025.)
theorem dvelimalcased {x3 y1 z: setvar} (ph ps ch th: wff x3 y1 z):
  $ wnf x3 ph $ >
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wnf z ph) $ >
  $ wi (wa ph (wn (wal x3 (wceq (cv x3) (cv y1))))) (wnf x3 ps) $ >
  $ wi (wa ph (wn (wal x3 (wceq (cv x3) (cv y1))))) (wnf z th) $ >
  $ wi (wa ph (wn (wal x3 (wceq (cv x3) (cv y1))))) (wi (wceq (cv z) (cv x3)) (wi ps th)) $ >
  $ wi (wa ph (wal x3 (wceq (cv x3) (cv y1)))) (wi ch th) $ >
  $ wi ph (wal z ps) $ >
  $ wi ph (wal x3 ch) $ >
  $ wi ph (wal x3 th) $;

--| Eliminate a disjoint variable condition from a universally quantified statement using cases. Inference form of ~ dvelimalcased . See ~ axsepg2 for an example of its use. (Contributed by BTernaryTau, 31-Jul-2025.)
theorem dvelimalcasei {x3 y1 z: setvar} (ph ps ch: wff x3 y1 z):
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wnf x3 ph) $ >
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wnf z ch) $ >
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv z) (cv x3)) (wi ph ch)) $ >
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wi ps ch) $ >
  $ wal z ph $ >
  $ wal x3 ps $ >
  $ wal x3 ch $;

--| Eliminate a disjoint variable condition from an existentially quantified statement using cases. (Contributed by BTernaryTau, 31-Jul-2025.)
theorem dvelimexcased {x3 y1 z: setvar} (ph ps ch th: wff x3 y1 z):
  $ wnf x3 ph $ >
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wnf z ph) $ >
  $ wi (wa ph (wn (wal x3 (wceq (cv x3) (cv y1))))) (wnf x3 ps) $ >
  $ wi (wa ph (wn (wal x3 (wceq (cv x3) (cv y1))))) (wnf z th) $ >
  $ wi (wa ph (wn (wal x3 (wceq (cv x3) (cv y1))))) (wi (wceq (cv z) (cv x3)) (wi ps th)) $ >
  $ wi (wa ph (wal x3 (wceq (cv x3) (cv y1)))) (wi ch th) $ >
  $ wi ph (wex z ps) $ >
  $ wi ph (wex x3 ch) $ >
  $ wi ph (wex x3 th) $;

--| Eliminate a disjoint variable condition from an existentially quantified statement using cases. (Contributed by BTernaryTau, 31-Jul-2025.)
theorem dvelimexcased_b {x3 z: setvar} (ph ps ch th: wff x3 z):
  $ wnf x3 ph $ >
  $ wi (wn (wal x3 (wceq (cv x3) (cv x3)))) (wnf z ph) $ >
  $ wi (wa ph (wn (wal x3 (wceq (cv x3) (cv x3))))) (wnf x3 ps) $ >
  $ wi (wa ph (wn (wal x3 (wceq (cv x3) (cv x3))))) (wnf z th) $ >
  $ wi (wa ph (wn (wal x3 (wceq (cv x3) (cv x3))))) (wi (wceq (cv z) (cv x3)) (wi ps th)) $ >
  $ wi (wa ph (wal x3 (wceq (cv x3) (cv x3)))) (wi ch th) $ >
  $ wi ph (wex z ps) $ >
  $ wi ph (wex x3 ch) $ >
  $ wi ph (wex x3 th) $;

--| Eliminate a disjoint variable condition from an existentially quantified statement using cases. Inference form of ~ dvelimexcased . See ~ axnulg for an example of its use. (Contributed by BTernaryTau, 31-Jul-2025.)
theorem dvelimexcasei {x3 y1 z: setvar} (ph ps ch: wff x3 y1 z):
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wnf x3 ph) $ >
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wnf z ch) $ >
  $ wi (wn (wal x3 (wceq (cv x3) (cv y1)))) (wi (wceq (cv z) (cv x3)) (wi ph ch)) $ >
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wi ps ch) $ >
  $ wex z ph $ >
  $ wex x3 ps $ >
  $ wex x3 ch $;

--| Eliminate a disjoint variable condition from an existentially quantified statement using cases. Inference form of ~ dvelimexcased . See ~ axnulg for an example of its use. (Contributed by BTernaryTau, 31-Jul-2025.)
theorem dvelimexcasei_b {x3 z: setvar} (ph ps ch: wff x3 z):
  $ wi (wn (wal x3 (wceq (cv x3) (cv x3)))) (wnf x3 ph) $ >
  $ wi (wn (wal x3 (wceq (cv x3) (cv x3)))) (wnf z ch) $ >
  $ wi (wn (wal x3 (wceq (cv x3) (cv x3)))) (wi (wceq (cv z) (cv x3)) (wi ph ch)) $ >
  $ wi (wal x3 (wceq (cv x3) (cv x3))) (wi ps ch) $ >
  $ wex z ph $ >
  $ wex x3 ps $ >
  $ wex x3 ch $;

--| Version of ~ reu6 with disjoint variable condition replaced by nonfreeness hypothesis. (Contributed by BTernaryTau, 29-Sep-2026.)
theorem reu6f {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wnf y1 ph $ >
  $ wb (wreu x3 ph A2) (wrex y1 (wral x3 (wb ph (wceq (cv x3) (cv y1))) A2) A2) $;

--| Alternate version of ~ rmo2 where ` y ` has a restricted quantifier. The antecedent ` E. z z e. A ` on the right-hand side handles the case where ` A ` is empty. (Contributed by BTernaryTau, 29-Sep-2026.)
theorem rmo6 {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2: class):
  $ wnf y1 ph $ >
  $ wb (wrmo x3 ph A2) (wi (wex z (wcel (cv z) A2)) (wrex y1 (wral x3 (wi ph (wceq (cv x3) (cv y1))) A2) A2)) $;

--| Alternate version of ~ rmo2 where ` y ` has a restricted quantifier. The antecedent ` E. z z e. A ` on the right-hand side handles the case where ` A ` is empty. (Contributed by BTernaryTau, 29-Sep-2026.)
theorem rmo6_b {x3 y1: setvar} (ph: wff x3 y1) (A2: class):
  $ wnf y1 ph $ >
  $ wb (wrmo x3 ph A2) (wi (wex y1 (wcel (cv y1) A2)) (wrex y1 (wral x3 (wi ph (wceq (cv x3) (cv y1))) A2) A2)) $;

--| The intersection of the universal class with a class is itself. A commuted form of ~ inv1 . (Contributed by BTernaryTau, 24-Jun-2026.)
theorem inv2 (A2: class):
  $ wceq (cin cvv A2) A2 $;

--| Inference combining four equality antecedents into one equality of conditional operators antecedent. (Contributed by BTernaryTau, 14-Jul-2026.)
theorem jaeqifi (ph ps ch: wff) (A2 B2 C D: class):
  $ wi (wceq A2 C) ph $ >
  $ wi (wceq A2 D) ph $ >
  $ wi (wceq B2 C) ph $ >
  $ wi (wceq B2 D) ph $ >
  $ wi (wceq (cif ps A2 B2) (cif ch C D)) ph $;

--| There exists an element in a class excluding a singleton if and only if there exists an element in the original class not equal to the singleton element. (Contributed by BTernaryTau, 15-Sep-2023.)
theorem exdifsn {x3: setvar} (A2 B2: class x3):
  $ wb (wex x3 (wcel (cv x3) (cdif A2 (csn B2)))) (wrex x3 (wne (cv x3) B2) A2) $;

--| Alternate proof of ~ axnul , proved from propositional calculus, ~ ax-gen , ~ ax-4 , ~ ax-6 , and ~ ax-rep . (Proof modification is discouraged.) (New usage is discouraged.) (Contributed by BTernaryTau, 27-Mar-2026.)
theorem axnulALT2 {x3 y1: setvar}:
  $ wex x3 (wal y1 (wn (wcel (cv y1) (cv x3)))) $;

--| If the image under a one-to-one function exists, then the corresponding preimage also exists. (Contributed by BTernaryTau, 21-Jun-2026.)
theorem f1preimaex (A2 B2 C F V: class):
  $ wi (w3a (wf1 A2 B2 F) (wss C A2) (wcel (cima F C) V)) (wcel C cvv) $;

--| Condition for a function value to equal the intersection of an image that contains it. (Contributed by BTernaryTau, 23-Jun-2026.)
theorem fnfvintima {x3: setvar} (A2: class x3) (B2 C F: class):
  $ wi (w3a (wfn F A2) (wss B2 A2) (wcel C B2)) (wb (wceq (cfv C F) (cint (cima F B2))) (wral x3 (wss (cfv C F) (cfv (cv x3) F)) B2)) $;

--| If ` ps ` is function-like over ` A ` , then ` F ` matches its behavior. (Contributed by BTernaryTau, 28-Sep-2026.)
theorem fwfffun {x3 y1 z: setvar} (ph ps: wff x3 y1 z) (A2: class x3) (F: class x3 y1 z):
  $ wnf y1 ps $ >
  $ wi ph (wral x3 (wex y1 (wral z (wi ps (wceq (cv z) (cv y1))) A2)) A2) $ >
  $ wceq F (copab x3 z (w3a (wcel (cv x3) A2) (wcel (cv z) A2) ps)) $ >
  $ wi ph (wb (w3a (wcel (cv x3) A2) (wcel (cv z) A2) ps) (wa (wcel (cv x3) (cdm F)) (wceq (cfv (cv x3) F) (cv z)))) $;

--| If ` ps ` is function-like over ` A ` , then ` F ` matches its behavior over ` x ` . (Contributed by BTernaryTau, 28-Sep-2026.)
theorem fwfffunres {x3 y1 z w: setvar} (ph ps: wff x3 y1 z w) (A2: class x3 w) (F: class x3 y1 z w):
  $ wnf y1 ps $ >
  $ wi ph (wral w (wex y1 (wral z (wi ps (wceq (cv z) (cv y1))) A2)) A2) $ >
  $ wceq F (cres (copab w z (w3a (wcel (cv w) A2) (wcel (cv z) A2) ps)) (cv x3)) $ >
  $ wi ph (wb (wa (wcel (cv z) A2) (w3a (wcel (cv w) A2) (wcel (cv w) (cv x3)) ps)) (wa (wcel (cv w) (cdm F)) (wceq (cfv (cv w) F) (cv z)))) $;

--| The union of two ordinals is equal to their maximum. (Contributed by BTernaryTau, 7-Oct-2026.)
theorem ordunmax (A2 B2: class):
  $ wi (wa (word A2) (word B2)) (wceq (cun A2 B2) (cif (wss A2 B2) B2 A2)) $;

--| If an ordinal class is not a set, then it must be the proper class of all ordinals. (Contributed by BTernaryTau, 9-Jun-2026.)
theorem ordprcon (A2: class):
  $ wi (wa (word A2) (wn (wcel A2 cvv))) (wceq A2 con0) $;

--| ` _om ` is either an ordinal set or the proper class of all ordinal sets, but not both. This is a stronger version of ~ omon . (Contributed by BTernaryTau, 25-Jan-2026.)
theorem xoromon:
  $ wxo (wcel com con0) (wceq com con0) $;

--| Reconstruction of a member of a nested Cartesian product in terms of its ordered triple components. (Contributed by BTernaryTau, 9-Oct-2026.)
theorem ot1st2nd (A2 B2 C D: class):
  $ wi (wcel A2 (cxp (cxp B2 C) D)) (wceq A2 (cotp (cfv (cfv A2 c1st) c1st) (cfv (cfv A2 c1st) c2nd) (cfv A2 c2nd))) $;

--| The division algorithm for ordinal multiplication ( ~ omeu ) produces a unique quotient and remainder. (Contributed by BTernaryTau, 5-Oct-2026.)
theorem omeueq (ph: wff) (A2 B2 C D E: class):
  $ wi ph (wcel A2 con0) $ >
  $ wi ph (wne A2 c0) $ >
  $ wi ph (wcel B2 con0) $ >
  $ wi ph (wcel C A2) $ >
  $ wi ph (wcel D con0) $ >
  $ wi ph (wcel E A2) $ >
  $ wi ph (wceq (co (co A2 B2 comu) C coa) (co (co A2 D comu) E coa)) $ >
  $ wi ph (wa (wceq B2 D) (wceq C E)) $;

--| A strict order relation on an infinite set dominates that set. (Contributed by BTernaryTau, 14-Jul-2026.)
theorem soinfdom (A2 R V: class):
  $ wi (w3a (wor A2 R) (wcel R V) (wbr com A2 cdom)) (wbr A2 R cdom) $;

--| The class of well-orders of a set ` A ` and its subsets is a set. (Contributed by BTernaryTau, 2-Aug-2026.)
theorem abweex {x3 r: setvar} (A2: class) (V: class x3 r):
  $ wi (wcel A2 V) (wcel (cab r (wex x3 (w3a (wss (cv x3) A2) (wss (cv r) (cxp (cv x3) (cv x3))) (wwe (cv x3) (cv r))))) cvv) $;

--| A proper class with a set-like well-ordering is isomorphic to the proper class of all ordinal numbers. (Contributed by BTernaryTau, 9-Jun-2026.)
theorem ordtypeon (A2 R F: class):
  $ wceq F (coi A2 R) $ >
  $ wi (w3a (wwe A2 R) (wse A2 R) (wn (wcel A2 cvv))) (wiso con0 A2 cep R F) $;

--| If ` F ` maps ` A ` one-to-one into the ordinals, then ` R ` well-orders ` A ` . (Contributed by BTernaryTau, 16-Sep-2026.)
theorem onf1we {x3 y1: setvar} (A2 R: class x3 y1) (F: class):
  $ wceq R (copab x3 y1 (wcel (cfv (cv x3) F) (cfv (cv y1) F))) $ >
  $ wi (wf1 A2 con0 F) (wwe A2 R) $;

--| A function that preserves a relation also preserves predecessors. (Contributed by BTernaryTau, 16-Jul-2024.)
theorem fnrelpredd {x3 y1: setvar} (ph: wff y1) (A2: class x3) (C: class y1) (D R S F: class):
  $ wi ph (wfn F A2) $ >
  $ wi ph (wral x3 (wral y1 (wb (wbr (cv x3) (cv y1) R) (wbr (cfv (cv x3) F) (cfv (cv y1) F) S)) A2) A2) $ >
  $ wi ph (wss C A2) $ >
  $ wi ph (wcel D A2) $ >
  $ wi ph (wceq (cpred (cima F C) S (cfv D F)) (cima F (cpred C R D))) $;

--| The cardinality function preserves predecessors. (Contributed by BTernaryTau, 18-Jul-2024.)
theorem cardpred (A2 B2: class):
  $ wi (wa (wss A2 (cdm ccrd)) (wcel B2 (cdm ccrd))) (wceq (cpred (cima ccrd A2) cep (cfv B2 ccrd)) (cima ccrd (cpred A2 csdm B2))) $;

--| Every nonempty class of numerable sets has a minimal element. (Contributed by BTernaryTau, 18-Jul-2024.)
theorem nummin {x3: setvar} (A2: class):
  $ wi (wa (wss A2 (cdm ccrd)) (wne A2 c0)) (wrex x3 (wceq (cpred A2 csdm (cv x3)) c0) A2) $;

--| The Fundamental Theorem of Enumeration (see ~ https://sites.math.rutgers.edu/~~zeilberg/mamarim/mamarimPDF/enu.pdf ), extended to all sets. The expression ` U_ x e. A ( { x } X. B ) ` can be thought of as expressing an indexed disjoint union ` |_| x e. A B ` where each ` B ` has its elements tagged with the set ` x ` that generated it. See the comment directly before ~ undjudom for context on disjoint union as a representation of cardinal addition. This theorem is not limited to numerable sets, but it also does not depend on AC. See ~ 1enumcard for a version that uses the ` card ` function, ~ 1enumkard for a version that uses the ` kard ` function , and ~ 1enum for a version that uses an explicit sum of complex number 1s. (Contributed by BTernaryTau, 26-Jun-2026.)
theorem _1enumen {x3: setvar} (A2: class):
  $ wi (wcel A2 cvv) (wbr A2 (ciun x3 A2 (cxp (csn (cv x3)) c1o)) cen) $;

--| The Fundamental Theorem of Enumeration (see ~ https://sites.math.rutgers.edu/~~zeilberg/mamarim/mamarimPDF/enu.pdf ), extended to all sets. The expression ` U_ x e. A ( { x } X. B ) ` can be thought of as expressing an indexed disjoint union ` |_| x e. A B ` where each ` B ` has its elements tagged with the set ` x ` that generated it. See the comment directly before ~ undjudom for context on disjoint union as a representation of cardinal addition. This theorem does not depend on AC, but it is only meaningful for numerable sets. See ~ 1enumen and ~ 1enumkard for versions that are meaningful for non-numerable sets, and see ~ 1enum for a version that uses an explicit sum of complex number 1s. (Contributed by BTernaryTau, 26-Jun-2026.)
theorem _1enumcard {x3: setvar} (A2: class):
  $ wi (wcel A2 cvv) (wceq (cfv A2 ccrd) (cfv (ciun x3 A2 (cxp (csn (cv x3)) c1o)) ccrd)) $;

--| Value of the cumulative hierarchy of sets function at ` 1o ` . (Contributed by BTernaryTau, 24-Jan-2026.)
theorem r11:
  $ wceq (cfv c1o cr1) c1o $;

--| Value of the cumulative hierarchy of sets function at ` 2o ` . (Contributed by BTernaryTau, 25-Jan-2026.)
theorem r12:
  $ wceq (cfv c2o cr1) c2o $;

--| The rank of an ordinal number is itself. (Contributed by BTernaryTau, 3-Jul-2026.)
theorem onrankid (A2: class):
  $ wb (wcel A2 con0) (wceq (cfv A2 crnk) A2) $;

--| The rank of a finite well-founded set is less than a limit ordinal iff the ranks of all of its elements are less than that limit ordinal. (Contributed by BTernaryTau, 22-Jan-2026.)
theorem rankfilimb {x3: setvar} (A2 B2: class):
  $ wi (w3a (wcel A2 cfn) (wcel A2 (cuni (cima cr1 con0))) (wlim B2)) (wb (wcel (cfv A2 crnk) B2) (wral x3 (wcel (cfv (cv x3) crnk) B2) A2)) $;

--| A finite set appears in the cumulative hierarchy prior to a limit ordinal iff all of its elements appear in the cumulative hierarchy prior to that limit ordinal. (Contributed by BTernaryTau, 22-Jan-2026.)
theorem r1filim {x3: setvar} (A2 B2: class):
  $ wi (wa (wcel A2 cfn) (wlim B2)) (wb (wcel A2 (cuni (cima cr1 B2))) (wral x3 (wcel (cv x3) (cuni (cima cr1 B2))) A2)) $;

--| Obsolete theorem, use ~ hffi instead. Hereditarily finite sets are finite sets. (Contributed by BTernaryTau, 30-Dec-2025.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem r1omfi:
  $ wss (cuni (cima cr1 com)) cfn $;

--| A set is hereditarily finite iff it is finite and all of its elements are hereditarily finite. (Contributed by BTernaryTau, 19-Jan-2026.)
theorem r1omhf {x3: setvar} (A2: class):
  $ wb (wcel A2 (cuni (cima cr1 com))) (wa (wcel A2 cfn) (wral x3 (wcel (cv x3) (cuni (cima cr1 com))) A2)) $;

--| A set is a subset of the value of the cumulative hierarchy of sets function iff it is an element of the value at the successor. (Contributed by BTernaryTau, 15-Jan-2026.)
theorem r1ssel (A2 B2: class):
  $ wi (wcel B2 con0) (wb (wss A2 (cfv B2 cr1)) (wcel A2 (cfv (csuc B2) cr1))) $;

--| Alternate proof of ~ axnul , proved from propositional calculus, ~ ax-gen , ~ ax-4 , ~ ax-5 , and ~ ax-inf2 . (Contributed by BTernaryTau, 22-Jun-2025.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem axnulALT3 {x3 y1: setvar}:
  $ wex x3 (wal y1 (wn (wcel (cv y1) (cv x3)))) $;

--| Alternate proof of ~ axpr , proved from predicate calculus, ~ ax-rep , and ~ ax-inf2 . (Contributed by BTernaryTau, 26-Mar-2026.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem axprALT2 {x3 y1 z w: setvar}:
  $ wex z (wal w (wi (wo (wceq (cv w) (cv x3)) (wceq (cv w) (cv y1))) (wcel (cv w) (cv z)))) $;

--| The rank function maps the universe onto the ordinals. (Contributed by BTernaryTau, 23-Jun-2026.)
theorem rankfo:
  $ wfo cvv con0 crnk $;

--| The rank function is a function on the universe. (Contributed by BTernaryTau, 23-Jun-2026.)
theorem rankfn:
  $ wfn crnk cvv $;

--| If every element in a transitive class is finite, then every element is also hereditarily finite. (Contributed by BTernaryTau, 24-Jan-2026.)
theorem trssfir1om (A2: class):
  $ wi (wa (wtr A2) (wss A2 cfn)) (wss A2 (cuni (cima cr1 com))) $;

--| The class of all hereditarily finite sets is the only class with the property that all sets are members of it iff they are finite and all of their elements are members of it. (Contributed by BTernaryTau, 24-Jan-2026.)
theorem r1omhfb {x3 y1: setvar} (H: class):
  $ wb (wceq H (cuni (cima cr1 com))) (wal x3 (wb (wcel (cv x3) H) (wa (wcel (cv x3) cfn) (wral y1 (wcel (cv y1) H) (cv x3))))) $;

--| Construct a well-order given a relation ` R ( x ) ` that well-orders elements of the same rank. (Contributed by BTernaryTau, 16-Sep-2026.)
theorem werankwe {x3 y1 z w v: setvar} (A2: class) (R: class x3 z) (S: class x3 y1 z w v) (T: class z w v) (U: class z v):
  $ wceq S (copab x3 y1 (wo (wcel (cfv (cv x3) crnk) (cfv (cv y1) crnk)) (wa (wceq (cfv (cv x3) crnk) (cfv (cv y1) crnk)) (wbr (cv x3) (cv y1) R)))) $ >
  $ wi (wceq (cv w) (cfv (cv x3) crnk)) (wceq T R) $ >
  $ wi (wceq (cv v) (cv x3)) (wceq U R) $ >
  $ wi (wral x3 (wwe (crab z (wceq (cfv (cv z) crnk) (cfv (cv x3) crnk)) A2) R) A2) (wwe A2 S) $;

--| Construct a well-order given a relation that well-orders elements of the same rank. See ~ werankwe for a version where ` R ` can depend on ` w ` . (Contributed by BTernaryTau, 18-Sep-2026.)
theorem werankwe2 {x3 y1 z w: setvar} (A2: class) (R: class z) (S: class x3 y1 z w):
  $ wceq S (copab x3 y1 (wo (wcel (cfv (cv x3) crnk) (cfv (cv y1) crnk)) (wa (wceq (cfv (cv x3) crnk) (cfv (cv y1) crnk)) (wbr (cv x3) (cv y1) R)))) $ >
  $ wi (wral w (wwe (crab z (wceq (cfv (cv z) crnk) (cfv (cv w) crnk)) A2) R) A2) (wwe A2 S) $;

--| Construct a relation that is set-like on any class. (Contributed by BTernaryTau, 18-Sep-2026.)
theorem rankse {x3 y1: setvar} (ph: wff x3 y1) (A2: class) (S: class x3 y1):
  $ wceq S (copab x3 y1 (wo (wcel (cfv (cv x3) crnk) (cfv (cv y1) crnk)) (wa (wceq (cfv (cv x3) crnk) (cfv (cv y1) crnk)) ph))) $ >
  $ wse A2 S $;

--| Equality theorem for the Scott operation. Inference form of ~ scotteq . (Contributed by BTernaryTau, 3-Jul-2026.)
theorem scotteqi (A2 B2: class):
  $ wceq A2 B2 $ >
  $ wceq (cscott A2) (cscott B2) $;

--| Membership in a Scott's trick set. (Contributed by BTernaryTau, 3-Jul-2026.)
theorem elscott {x3: setvar} (A2 B2: class):
  $ wb (wcel A2 (cscott B2)) (wa (wcel A2 B2) (wral x3 (wss (cfv A2 crnk) (cfv (cv x3) crnk)) B2)) $;

--| Alternate definition of a Scott's trick set. (Contributed by BTernaryTau, 8-Jul-2026.)
theorem dfscott2 {x3: setvar} (A2: class):
  $ wceq (cscott A2) (crab x3 (wceq (cfv (cv x3) crnk) (cint (cima crnk A2))) A2) $;

--| Alternate definition of a Scott's trick set. (Contributed by BTernaryTau, 10-Jul-2026.)
theorem dfscott3 (A2: class):
  $ wceq (cscott A2) (cin A2 (cfv (csuc (cint (cima crnk A2))) cr1)) $;

--| Membership in a Scott's trick set. (Contributed by BTernaryTau, 10-Jul-2026.)
theorem elscott2 (A2 B2: class):
  $ wb (wcel A2 (cscott B2)) (wa (wcel A2 B2) (wceq (cfv A2 crnk) (cint (cima crnk B2)))) $;

--| The rank of an element in a Scott's trick set. (Contributed by BTernaryTau, 8-Jul-2026.)
theorem elscottrank (A2 B2: class):
  $ wi (wcel A2 (cscott B2)) (wceq (cfv A2 crnk) (cint (cima crnk B2))) $;

--| Elements in a Scott's trick set have the same rank. (Contributed by BTernaryTau, 9-Jul-2026.)
theorem elscottrankeq (A2 B2 C: class):
  $ wi (wa (wcel A2 (cscott C)) (wcel B2 (cscott C))) (wceq (cfv A2 crnk) (cfv B2 crnk)) $;

--| Relationship between the ranks of an element in a Scott's trick set and an element in the input class. (Contributed by BTernaryTau, 3-Jul-2026.)
theorem elscottrankss (A2 B2 C: class):
  $ wi (wa (wcel A2 (cscott B2)) (wcel C B2)) (wss (cfv A2 crnk) (cfv C crnk)) $;

--| If a member of the input class has the same rank as a member of the Scott's trick set, then it is also a member of the Scott's trick set. (Contributed by BTernaryTau, 10-Jul-2026.)
theorem scottrankeqel (A2 B2 C: class):
  $ wi (w3a (wcel A2 (cscott B2)) (wcel C B2) (wceq (cfv C crnk) (cfv A2 crnk))) (wcel C (cscott B2)) $;

--| If a member of the input class is not a member of the Scott's trick set, then its rank is greater than the rank of a member of the Scott's trick set. (Contributed by BTernaryTau, 10-Jul-2026.)
theorem nelscottrankgt (A2 B2 C: class):
  $ wi (w3a (wcel A2 (cscott B2)) (wcel C B2) (wn (wcel C (cscott B2)))) (wcel (cfv A2 crnk) (cfv C crnk)) $;

--| Applying Scott's trick to a singleton leaves it unchanged. (Contributed by BTernaryTau, 3-Jul-2026.)
theorem scottsn (A2: class):
  $ wceq (cscott (csn A2)) (csn A2) $;

--| Obsolete version of ~ scott0b as of 18-Jul-2026. (Contributed by BTernaryTau, 3-Jul-2026.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem scott0bOLD (A2: class):
  $ wb (wceq A2 c0) (wceq (cscott A2) c0) $;

--| If the input class has elements, then the Scott's trick set is not empty. (Contributed by BTernaryTau, 23-Aug-2026.)
theorem elscottn0 (A2 B2: class):
  $ wi (wcel A2 B2) (wne (cscott B2) c0) $;

--| If the empty set is an element of the input class, then the Scott's trick set is the singleton of the empty set. (Contributed by BTernaryTau, 23-Aug-2026.)
theorem _0elscott (A2: class):
  $ wi (wcel c0 A2) (wceq (cscott A2) (csn c0)) $;

--| The rank of a nonempty Scott's trick set. (Contributed by BTernaryTau, 8-Jul-2026.)
theorem rankscott (A2: class):
  $ wi (wne A2 c0) (wceq (cfv (cscott A2) crnk) (csuc (cint (cima crnk A2)))) $;

--| An upper bound on the rank of a Scott's trick set. (Contributed by BTernaryTau, 4-Jul-2026.)
theorem rankscottu (A2 B2: class):
  $ wi (wcel A2 B2) (wss (cfv (cscott B2) crnk) (csuc (cfv A2 crnk))) $;

--| Relationship between a Scott's trick set and the cumulative hierarchy. (Contributed by BTernaryTau, 3-Jul-2026.)
theorem scottssr1 (A2 B2: class):
  $ wi (wcel A2 B2) (wss (cscott B2) (cfv (csuc (cfv A2 crnk)) cr1)) $;

--| The Scott operation is idempotent. (Contributed by BTernaryTau, 23-Aug-2026.)
theorem scottidm (A2: class):
  $ wceq (cscott (cscott A2)) (cscott A2) $;

--| The Scott's trick set of a transitive class is also transitive. (Contributed by BTernaryTau, 20-Oct-2026.)
theorem trscott (A2: class):
  $ wi (wtr A2) (wtr (cscott A2)) $;

--| Applying the Scott operation to equivalence classes preserves their equality property. (Contributed by BTernaryTau, 20-Oct-2026.)
theorem erscottd {x3: setvar} (ph: wff) (A2 B2 R: class) (V: class x3):
  $ wi ph (wer V R) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wb (wbr A2 B2 R) (wceq (cscott (cab x3 (wbr (cv x3) A2 R))) (cscott (cab x3 (wbr (cv x3) B2 R))))) $;

--| Applying the Scott operation to equivalence classes preserves their equality property. (Contributed by BTernaryTau, 20-Oct-2026.)
theorem ecscottd (ph: wff) (A2 B2 R V: class):
  $ wi ph (wer V R) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wb (wbr A2 B2 R) (wceq (cscott (cec A2 R)) (cscott (cec B2 R)))) $;

--| Axiom of Choice equivalent: every set can be mapped one-to-one into the ordinals. (Contributed by BTernaryTau, 16-Sep-2026.)
theorem dfac15 {x3 f2: setvar}:
  $ wb wac (wal x3 (wex f2 (wf1 (cv x3) con0 (cv f2)))) $;

--| Axiom of Choice equivalent: for every pair of sets, one is dominated by the other (see also ~ entri3 ). (Contributed by BTernaryTau, 17-Sep-2026.)
theorem dfac16 {x3 y1: setvar}:
  $ wb wac (wal x3 (wal y1 (wo (wbr (cv x3) (cv y1) cdom) (wbr (cv y1) (cv x3) cdom)))) $;

--| The Axiom of Choice implies that any set is numerable. (Contributed by BTernaryTau, 3-Jul-2026.)
theorem acnum (A2 V: class):
  $ wi wac (wi (wcel A2 V) (wcel A2 (cdm ccrd))) $;

--| If a well-ordering of an infinite set exists, then a well-ordering equinumerous to the set exists. (Contributed by BTernaryTau, 31-Jul-2026.)
theorem weexenwe {s1 r: setvar} (A2: class):
  $ wi (wa (wex r (wwe A2 (cv r))) (wbr com A2 cdom)) (wex s1 (w3a (wss (cv s1) (cxp A2 A2)) (wwe A2 (cv s1)) (wbr (cv s1) A2 cen))) $;

--| Equivalence between two infiniteness criteria for numerable sets. (Contributed by BTernaryTau, 15-Jul-2026.)
theorem infinfnum (A2: class):
  $ wi (wcel A2 (cdm ccrd)) (wb (wn (wcel A2 cfn)) (wbr com A2 cdom)) $;

--| The Axiom of Choice implies that the cardinalities of the layers of the cumulative hierarchy form a proper class. (Contributed by BTernaryTau, 2-Jul-2026.)
theorem rncardr1prc:
  $ wi wac (wn (wcel (crn (ccom ccrd cr1)) cvv)) $;

--| Lemma for ~ acwer1prc . (Contributed by BTernaryTau, 31-Jul-2026.)
theorem acwer1prclem {x3 s1 r: setvar} (A2: class x3 r) (B2: class r) (W: class x3 s1 r):
  $ wceq W (cab r (wrex x3 (wa (wss (cv r) (cxp (cfv (cv x3) cr1) (cfv (cv x3) cr1))) (wwe (cfv (cv x3) cr1) (cv r))) con0)) $ >
  $ wi (w3a wac (wbr com A2 cdom) (wceq (cfv (cfv B2 cr1) ccrd) A2)) (wex s1 (wa (wcel (cfv (cv s1) ccrd) (cima ccrd W)) (wceq (cfv (cv s1) ccrd) A2))) $;

--| The class of all well-orderings of the stages of the cumulative hierarchy is a proper class. (Contributed by BTernaryTau, 31-Jul-2026.)
theorem acwer1prc {x3 r: setvar} (W: class x3 r):
  $ wceq W (cab r (wrex x3 (wa (wss (cv r) (cxp (cfv (cv x3) cr1) (cfv (cv x3) cr1))) (wwe (cfv (cv x3) cr1) (cv r))) con0)) $ >
  $ wi wac (wn (wcel W cvv)) $;

--| Extend the definition of a class to include the ordinal number 5.
term c5o: class;

--| Extend the definition of a class to include the ordinal number 6.
term c6o: class;

--| Extend the definition of a class to include the ordinal number 7.
term c7o: class;

--| Extend the definition of a class to include the ordinal number 8.
term c8o: class;

--| Extend the definition of a class to include the ordinal number 9.
term c9o: class;

--| Define the ordinal number 5. (Contributed by BTernaryTau, 2-Sep-2026.)
axiom df_5o:
  $ wceq c5o (csuc c4o) $;

--| Define the ordinal number 6. (Contributed by BTernaryTau, 2-Sep-2026.)
axiom df_6o:
  $ wceq c6o (csuc c5o) $;

--| Define the ordinal number 7. (Contributed by BTernaryTau, 2-Sep-2026.)
axiom df_7o:
  $ wceq c7o (csuc c6o) $;

--| Define the ordinal number 8. (Contributed by BTernaryTau, 2-Sep-2026.)
axiom df_8o:
  $ wceq c8o (csuc c7o) $;

--| Define the ordinal number 9. (Contributed by BTernaryTau, 2-Sep-2026.)
axiom df_9o:
  $ wceq c9o (csuc c8o) $;

--| Ordinal 5 is an ordinal number. (Contributed by BTernaryTau, 4-Sep-2026.)
theorem _5on:
  $ wcel c5o con0 $;

--| Ordinal 6 is an ordinal number. (Contributed by BTernaryTau, 4-Sep-2026.)
theorem _6on:
  $ wcel c6o con0 $;

--| Ordinal 7 is an ordinal number. (Contributed by BTernaryTau, 4-Sep-2026.)
theorem _7on:
  $ wcel c7o con0 $;

--| Ordinal 8 is an ordinal number. (Contributed by BTernaryTau, 4-Sep-2026.)
theorem _8on:
  $ wcel c8o con0 $;

--| Ordinal 9 is an ordinal number. (Contributed by BTernaryTau, 4-Sep-2026.)
theorem _9on:
  $ wcel c9o con0 $;

--| The ordinal 5 is a natural number. (Contributed by BTernaryTau, 4-Sep-2026.)
theorem _5onn:
  $ wcel c5o com $;

--| The ordinal 6 is a natural number. (Contributed by BTernaryTau, 4-Sep-2026.)
theorem _6onn:
  $ wcel c6o com $;

--| The ordinal 7 is a natural number. (Contributed by BTernaryTau, 4-Sep-2026.)
theorem _7onn:
  $ wcel c7o com $;

--| The ordinal 8 is a natural number. (Contributed by BTernaryTau, 4-Sep-2026.)
theorem _8onn:
  $ wcel c8o com $;

--| The ordinal 9 is a natural number. (Contributed by BTernaryTau, 4-Sep-2026.)
theorem _9onn:
  $ wcel c9o com $;

--| Any proper class is literally infinite, in the sense that it contains subsets of arbitrarily large finite cardinality. This proof holds regardless of whether the Axiom of Infinity is accepted or negated. (Contributed by BTernaryTau, 22-Jun-2025.)
theorem prcinf {x3 n: setvar} (A2: class):
  $ wi (wn (wcel A2 cvv)) (wral n (wex x3 (wa (wss (cv x3) A2) (wbr (cv x3) (cv n) cen))) com) $;

--| If all sets are finite, then the Axiom of Replacement becomes redundant. (Contributed by BTernaryTau, 12-Sep-2024.)
theorem fineqvrep {x3 y1 z w: setvar} (ph: wff x3 y1 z w):
  $ wi (wceq cfn cvv) (wi (wal w (wex y1 (wal z (wi (wal y1 ph) (wceq (cv z) (cv y1)))))) (wex y1 (wal z (wb (wcel (cv z) (cv y1)) (wex w (wa (wcel (cv w) (cv x3)) (wal y1 ph))))))) $;

--| If all sets are finite, then the Axiom of Power Sets becomes redundant. (Contributed by BTernaryTau, 12-Sep-2024.)
theorem fineqvpow {x3 y1 z w: setvar}:
  $ wi (wceq cfn cvv) (wex y1 (wal z (wi (wal w (wi (wcel (cv w) (cv z)) (wcel (cv w) (cv x3)))) (wcel (cv z) (cv y1))))) $;

--| If all sets are finite, then the Axiom of Choice becomes redundant. For a shorter proof using ~ ax-rep and ~ ax-pow , see ~ fineqvacALT . (Contributed by BTernaryTau, 21-Sep-2024.)
theorem fineqvac:
  $ wi (wceq cfn cvv) wac $;

--| Shorter proof of ~ fineqvac using ~ ax-rep and ~ ax-pow . (Contributed by BTernaryTau, 21-Sep-2024.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem fineqvacALT:
  $ wi (wceq cfn cvv) wac $;

--| If all sets are finite, then the class of all natural numbers equals the proper class of all ordinal numbers. (Contributed by BTernaryTau, 30-Dec-2025.)
theorem fineqvomon:
  $ wi (wceq cfn cvv) (wceq com con0) $;

--| All sets are finite iff all ordinal sets are finite. (Contributed by BTernaryTau, 25-Jan-2026.)
theorem fineqvomonb:
  $ wb (wceq cfn cvv) (wceq com con0) $;

--| The class of all finite ordinals is a proper class iff all ordinal sets are finite. (Contributed by BTernaryTau, 25-Jan-2026.)
theorem omprcomonb:
  $ wb (wn (wcel com cvv)) (wceq com con0) $;

--| Lemma for ~ fineqvnttrclse . (Contributed by BTernaryTau, 12-Jan-2026.)
theorem fineqvnttrclselem1 {d: setvar} (A2 B2: class):
  $ wi (wcel B2 (cdif com c1o)) (wcel (cuni (crab d (wceq (co A2 (cv d) coa) B2) con0)) com) $;

--| Lemma for ~ fineqvnttrclse . (Contributed by BTernaryTau, 12-Jan-2026.)
theorem fineqvnttrclselem2 {v d: setvar} (A2 B2: class) (F: class v) (N: class d):
  $ wceq F (cmpt v (csuc (csuc N)) (cuni (crab d (wceq (co (cv v) (cv d) coa) B2) con0))) $ >
  $ wi (w3a (wcel B2 (cdif com c1o)) (wcel N B2) (wcel A2 (csuc (csuc N)))) (wceq (co A2 (cfv A2 F) coa) B2) $;

--| Lemma for ~ fineqvnttrclse . (Contributed by BTernaryTau, 12-Jan-2026.)
theorem fineqvnttrclselem3 {x3 y1 v a d: setvar} (A2: class v a d) (B2: class x3 y1) (R: class x3 y1 v a d) (F: class v a) (N: class x3 y1 d):
  $ wceq R (copab x3 y1 (wa (wcel (cv x3) A2) (wceq (cv x3) (csuc (cv y1))))) $ >
  $ wceq A2 com $ >
  $ wceq F (cmpt v (csuc (csuc N)) (cuni (crab d (wceq (co (cv v) (cv d) coa) B2) con0))) $ >
  $ wi (wa (wcel B2 (cdif com c1o)) (wcel N B2)) (wral a (wbr (cfv (cv a) F) (cfv (csuc (cv a)) F) R) (csuc N)) $;

--| A counterexample demonstrating that ~ ttrclse does not hold when all sets are finite. (Contributed by BTernaryTau, 12-Jan-2026.)
theorem fineqvnttrclse {x3 y1: setvar} (A2: class) (R: class x3 y1):
  $ wceq R (copab x3 y1 (wa (wcel (cv x3) A2) (wceq (cv x3) (csuc (cv y1))))) $ >
  $ wceq A2 com $ >
  $ wi (wceq cfn cvv) (wa (wse A2 R) (wn (wse A2 (cttrcl (cres R A2))))) $;

--| A counterexample demonstrating that ~ tz9.1 does not hold when all sets are finite and an infinite descending ` e. ` -chain exists. (Contributed by BTernaryTau, 18-Feb-2026.)
theorem fineqvinfep {x3 y1: setvar} (A2: class x3 y1) (F: class):
  $ wceq A2 (csn (cfv c0 F)) $ >
  $ wi (w3a (wceq cfn cvv) (wf1 com cvv F) (wral x3 (wcel (cfv (csuc (cv x3)) F) (cfv (cv x3) F)) com)) (wn (wex y1 (wa (wss A2 (cv y1)) (wtr (cv y1))))) $;

--| A strong version of the Axiom of Regularity. It states that if there exists a set with property ` ph ` , then there must exist a set with property ` ph ` such that none of its elements have property ` ph ` . This axiom can be derived from the axioms of ZF set theory as shown in ~ axregs , but this derivation relies on ~ ax-inf2 and is thus not possible in a finitist context. (Contributed by BTernaryTau, 29-Dec-2025.)
axiom ax_regs {x3 y1 z: setvar} (ph: wff x3):
  $ wi (wex x3 ph) (wex y1 (wa (wal x3 (wi (wceq (cv x3) (cv y1)) ph)) (wal z (wi (wcel (cv z) (cv y1)) (wn (wal x3 (wi (wceq (cv x3) (cv z)) ph))))))) $;

--| Derivation of ~ ax-reg from ~ ax-regs and Tarski's FOL axiom schemes. This demonstrates the sense in which ~ ax-regs is a stronger version of ~ ax-reg . (Contributed by BTernaryTau, 30-Dec-2025.)
theorem axreg {y1 z: setvar} (x3: setvar):
  $ wi (wex y1 (wcel (cv y1) (cv x3))) (wex y1 (wa (wcel (cv y1) (cv x3)) (wal z (wi (wcel (cv z) (cv y1)) (wn (wcel (cv z) (cv x3))))))) $;

--| A version of ~ ax-regs with a class variable instead of a wff variable. Axiom D in G&#246;del, _The Consistency of the Axiom of Choice and of the Generalized Continuum Hypothesis with the Axioms of Set Theory_ (1940), p. 6. (Contributed by BTernaryTau, 30-Dec-2025.)
theorem axregscl {x3 y1 z: setvar} (A2: class):
  $ wi (wex x3 (wcel (cv x3) A2)) (wex y1 (wa (wcel (cv y1) A2) (wal z (wi (wcel (cv z) (cv y1)) (wn (wcel (cv z) A2)))))) $;

--| A version of ~ ax-regs with a class variable instead of a wff variable. Axiom D in G&#246;del, _The Consistency of the Axiom of Choice and of the Generalized Continuum Hypothesis with the Axioms of Set Theory_ (1940), p. 6. (Contributed by BTernaryTau, 30-Dec-2025.)
theorem axregscl_b {x3 z: setvar} (A2: class):
  $ wi (wex x3 (wcel (cv x3) A2)) (wex x3 (wa (wcel (cv x3) A2) (wal z (wi (wcel (cv z) (cv x3)) (wn (wcel (cv z) A2)))))) $;

--| Derivation of ~ zfregs using ~ ax-regs . (Contributed by BTernaryTau, 30-Dec-2025.)
theorem axregszf {x3: setvar} (A2: class):
  $ wi (wne A2 c0) (wrex x3 (wceq (cin (cv x3) A2) c0) A2) $;

--| Set (epsilon) induction. This version of ~ setind replaces ~ zfregs with ~ axregszf . (Contributed by BTernaryTau, 30-Dec-2025.)
theorem setindregs {x3: setvar} (A2: class):
  $ wi (wal x3 (wi (wss (cv x3) A2) (wcel (cv x3) A2))) (wceq A2 cvv) $;

--| Principle of set induction (or ` _E ` -induction). If a property passes from all elements of ` x ` to ` x ` itself, then it holds for all ` x ` . (Contributed by BTernaryTau, 31-Dec-2025.)
theorem setinds2regs {x3 y1: setvar} (ph: wff x3) (ps: wff y1):
  $ wi (wceq (cv x3) (cv y1)) (wb ph ps) $ >
  $ wi (wral y1 ps (cv x3)) ph $ >
  $ ph $;

--| There are no infinite descending ` e. ` -chains, proven using ~ ax-regs . (Contributed by BTernaryTau, 18-Feb-2026.)
theorem noinfepfnregs {x3: setvar} (F: class):
  $ wi (wfn F com) (wrex x3 (wnel (cfv (csuc (cv x3)) F) (cfv (cv x3) F)) com) $;

--| There are no infinite descending ` e. ` -chains, proven using ~ ax-regs . (Contributed by BTernaryTau, 18-Feb-2026.)
theorem noinfepregs {x3: setvar} (F: class):
  $ wrex x3 (wnel (cfv (csuc (cv x3)) F) (cfv (cv x3) F)) com $;

--| Every set has a transitive closure (the smallest transitive extension). This version of ~ tz9.1 depends on ~ ax-regs instead of ~ ax-reg and ~ ax-inf2 . This suggests a possible answer to the third question posed in ~ tz9.1 , namely that the missing property is that countably infinite classes must obey regularity. In ZF set theory we can prove this by showing that countably infinite classes are sets and thus ~ ax-reg applies to them directly, but in a finitist context it seems that an axiom like ~ ax-regs is required since countably infinite classes are proper classes. A related candidate for the missing property is the non-existence of infinite descending ` e. ` -chains, proven as ~ noinfep using ~ ax-reg and ~ ax-inf2 and as ~ noinfepregs using ~ ax-regs . If all sets are finite, then the existence of such a chain implies there is a set which does not have a transitive closure, as shown in ~ fineqvinfep . (Contributed by BTernaryTau, 31-Dec-2025.)
theorem tz9_1regs {x3 y1: setvar} (A2: class):
  $ wcel A2 cvv $ >
  $ wex x3 (w3a (wss A2 (cv x3)) (wtr (cv x3)) (wal y1 (wi (wa (wss A2 (cv y1)) (wtr (cv y1))) (wss (cv x3) (cv y1))))) $;

--| The cumulative hierarchy of sets covers the universe. This version of ~ unir1 replaces ~ setind with ~ setindregs . (Contributed by BTernaryTau, 30-Dec-2025.)
theorem unir1regs:
  $ wceq (cuni (cima cr1 con0)) cvv $;

--| If every element in a transitive class is finite, then every element is also hereditarily finite. This version of ~ trssfir1om replaces ~ setinds2 with ~ setinds2regs . (Contributed by BTernaryTau, 20-Jan-2026.)
theorem trssfir1omregs (A2: class):
  $ wi (wa (wtr A2) (wss A2 cfn)) (wss A2 (cuni (cima cr1 com))) $;

--| The class of all hereditarily finite sets is the only class with the property that all sets are members of it iff they are finite and all of their elements are members of it. This version of ~ r1omhfb replaces ~ setinds2 with ~ setinds2regs and ~ trssfir1om with ~ trssfir1omregs . (Contributed by BTernaryTau, 21-Jan-2026.)
theorem r1omhfbregs {x3 y1: setvar} (H: class):
  $ wb (wceq H (cuni (cima cr1 com))) (wal x3 (wb (wcel (cv x3) H) (wa (wcel (cv x3) cfn) (wral y1 (wcel (cv y1) H) (cv x3))))) $;

--| All sets are finite iff all sets are hereditarily finite. (Contributed by BTernaryTau, 30-Dec-2025.)
theorem fineqvr1ombregs:
  $ wb (wceq cfn cvv) (wceq (cuni (cima cr1 com)) cvv) $;

--| Derivation of ~ ax-regs from the axioms of ZF set theory. (Contributed by BTernaryTau, 29-Dec-2025.)
theorem axregs {x3 y1 z: setvar} (ph: wff x3):
  $ wi (wex x3 ph) (wex y1 (wa (wal x3 (wi (wceq (cv x3) (cv y1)) ph)) (wal z (wi (wcel (cv z) (cv y1)) (wn (wal x3 (wi (wceq (cv x3) (cv z)) ph))))))) $;

--| A generalization of ~ ax-sep in which ` x ` and ` z ` need not be distinct. This theorem scheme bundles ~ ax-sep with the degenerate instance ` E. y A. z ( z e. y <-> ( z e. z /\ ph ) ) ` which is satisfied by the existence of the empty set. Usage of this theorem is discouraged because it depends on ~ ax-13 . (Contributed by BTernaryTau, 21-May-2026.) (New usage is discouraged.)
theorem axsepg2 {x3 y1 z: setvar} (ph: wff x3):
  $ wex y1 (wal x3 (wb (wcel (cv x3) (cv y1)) (wa (wcel (cv x3) (cv z)) ph))) $;

--| A generalization of ~ ax-sep in which ` y ` and ` z ` need not be distinct. This theorem scheme bundles ~ ax-sep with the degenerate instance ` E. y A. x ( x e. y <-> ( x e. y /\ ph ) ) ` which is satisfied by the existence of the empty set. Usage of this theorem is discouraged because it depends on ~ ax-13 . (Contributed by BTernaryTau, 3-Aug-2025.) (New usage is discouraged.)
theorem axsepg3 {x3 y1 z: setvar} (ph: wff x3):
  $ wex y1 (wal x3 (wb (wcel (cv x3) (cv y1)) (wa (wcel (cv x3) (cv z)) ph))) $;

--| A generalization of ~ ax-sep in which ` y ` and ` z ` need not be distinct. This theorem scheme bundles ~ ax-sep with the degenerate instance ` E. y A. x ( x e. y <-> ( x e. y /\ ph ) ) ` which is satisfied by the existence of the empty set. Usage of this theorem is discouraged because it depends on ~ ax-13 . (Contributed by BTernaryTau, 3-Aug-2025.) (New usage is discouraged.)
theorem axsepg3_b {x3 y1: setvar} (ph: wff x3):
  $ wex y1 (wal x3 (wb (wcel (cv x3) (cv y1)) (wa (wcel (cv x3) (cv y1)) ph))) $;

--| Alternate proof of ~ axsepg3 , derived directly from ~ ax-sep with no additional set theory axioms. (Contributed by BTernaryTau, 3-Aug-2025.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem axsepg3ALT {x3 y1 z: setvar} (ph: wff x3):
  $ wex y1 (wal x3 (wb (wcel (cv x3) (cv y1)) (wa (wcel (cv x3) (cv z)) ph))) $;

--| A generalization of ~ ax-sep that combines ~ axsepg and ~ axsepg2 into a single theorem scheme. Unlike ~ ax-sep , this scheme lacks a distinct variable condition for ` ph ` and ` z ` as well as for ` x ` and ` z ` . Usage of this theorem is discouraged because it depends on ~ ax-13 . (Contributed by BTernaryTau, 24-May-2026.) (New usage is discouraged.)
theorem axsepg4 {x3 y1 z: setvar} (ph: wff x3 z):
  $ wex y1 (wal x3 (wb (wcel (cv x3) (cv y1)) (wa (wcel (cv x3) (cv z)) ph))) $;

--| A generalization of ~ ax-sep that combines ~ axsepg , ~ axsepg2 , and ~ axsepg3 into a single theorem scheme. Unlike ~ ax-sep , this scheme lacks a distinct variable condition for ` ph ` and ` z ` , for ` x ` and ` z ` , and for ` y ` and ` z ` . Usage of this theorem is discouraged because it depends on ~ ax-13 . (Contributed by BTernaryTau, 24-May-2026.) (New usage is discouraged.)
theorem axsepg5 {x3 y1 z: setvar} (ph: wff x3 z):
  $ wex y1 (wal x3 (wb (wcel (cv x3) (cv y1)) (wa (wcel (cv x3) (cv z)) ph))) $;

--| A generalization of ~ ax-nul in which ` x ` and ` y ` need not be distinct. This theorem scheme bundles ~ ax-nul with the degenerate instance ` E. x A. x -. x e. x ` which is satisfied by ~ elirrv . Usage of this theorem is discouraged because it depends on ~ ax-13 . (Contributed by BTernaryTau, 3-Aug-2025.) (New usage is discouraged.)
theorem axnulg {x3 y1: setvar}:
  $ wex x3 (wal y1 (wn (wcel (cv y1) (cv x3)))) $;

--| A generalization of ~ ax-pow that combines it and ~ zfpow into a single theorem scheme. Unlike ~ ax-pow , this scheme lacks a distinct variable condition for ` y ` and ` w ` . (Contributed by BTernaryTau, 26-May-2026.)
theorem axpowg {y1 z w: setvar} (x3: setvar):
  $ wex y1 (wal z (wi (wal w (wi (wcel (cv w) (cv z)) (wcel (cv w) (cv x3)))) (wcel (cv z) (cv y1)))) $;

--| A generalization of ~ ax-pow in which ` x ` and ` w ` need not be distinct. This theorem scheme bundles ~ ax-pow with the degenerate instance ` E. y A. z ( A. x ( x e. z -> x e. x ) -> z e. y ) ` which is satisfied by the existence of a set that contains all empty sets (see ~ axprlem1 ). Usage of this theorem is discouraged because it depends on ~ ax-13 . (Contributed by BTernaryTau, 26-May-2026.) (New usage is discouraged.)
theorem axpowg2 {x3 y1 z w: setvar}:
  $ wex y1 (wal z (wi (wal w (wi (wcel (cv w) (cv z)) (wcel (cv w) (cv x3)))) (wcel (cv z) (cv y1)))) $;

--| A generalization of ~ ax-pow that combines ~ axpowg and ~ axpowg2 into a single theorem scheme. Unlike ~ ax-pow , this scheme lacks a distinct variable condition for ` y ` and ` w ` as well as for ` x ` and ` w ` . Usage of this theorem is discouraged because it depends on ~ ax-13 . (Contributed by BTernaryTau, 26-May-2026.) (New usage is discouraged.)
theorem axpowg3 {x3 y1 z w: setvar}:
  $ wex y1 (wal z (wi (wal w (wi (wcel (cv w) (cv z)) (wcel (cv w) (cv x3)))) (wcel (cv z) (cv y1)))) $;

--| Extend class definition to include the alternative cardinal size function.
term ckard: class;

--| Define the alternative cardinal number function. Under this definition, the cardinal number of a set is the set of all sets equinumerous to it and having the least possible rank. Definition of [Enderton] p. 222. See ~ kardval for its value. The principal theorem relating this type of cardinality to equinumerosity is ~ kardeng . Our notation is from Enderton and differentiates this function from the standard cardinal size function defined in ~ df-card . (Contributed by BTernaryTau, 2-Jul-2026.)
axiom df_kard {x3 y1: setvar}:
  $ wceq ckard (cmpt x3 cvv (cscott (cab y1 (wbr (cv y1) (cv x3) cen)))) $;

--| The ` kard ` class is a function on the universe. This theorem depends on the Axiom of Regularity and the Axiom of Infinity, but it does not depend on the Axiom of Choice. (Contributed by BTernaryTau, 3-Jul-2026.)
theorem kardfn:
  $ wfn ckard cvv $;

--| The value of the ` kard ` function. This theorem depends on the Axiom of Regularity and the Axiom of Infinity, but it does not depend on the Axiom of Choice. See also ~ kardval2 . (Contributed by BTernaryTau, 3-Jul-2026.)
theorem kardval {x3: setvar} (A2: class):
  $ wceq (cfv A2 ckard) (cscott (cab x3 (wbr (cv x3) A2 cen))) $;

--| The value of the ` kard ` function. This theorem depends on the Axiom of Regularity and the Axiom of Infinity, but it does not depend on the Axiom of Choice. See also ~ kardval . (Contributed by BTernaryTau, 3-Jul-2026.)
theorem kardval2 {x3 y1: setvar} (A2: class):
  $ wceq (cfv A2 ckard) (cab x3 (wa (wbr (cv x3) A2 cen) (wal y1 (wi (wbr (cv y1) A2 cen) (wss (cfv (cv x3) crnk) (cfv (cv y1) crnk)))))) $;

--| The ` kard ` cardinality of the empty set is the singleton of the empty set. (Contributed by BTernaryTau, 3-Jul-2026.)
theorem kard0:
  $ wceq (cfv c0 ckard) (csn c0) $;

--| Any member of the ` kard ` cardinal number of a set is equinumerous to the set. Contrast with ~ cardne for ` card ` cardinals. (Contributed by BTernaryTau, 3-Jul-2026.)
theorem elkarden (A2 B2: class):
  $ wi (wcel A2 (cfv B2 ckard)) (wbr A2 B2 cen) $;

--| Applying ` kard ` to a class yields the empty set iff the class is a proper class. (Contributed by BTernaryTau, 3-Jul-2026.)
theorem kardeq0 (A2: class):
  $ wb (wceq (cfv A2 ckard) c0) (wn (wcel A2 cvv)) $;

--| Two sets are equinumerous iff their ` kard ` cardinal numbers are equal. Unlike ~ carden , this theorem does not depend on the Axiom of Choice, but it does depend on the Axiom of Regularity and the Axiom of Infinity. (Contributed by BTernaryTau, 3-Jul-2026.)
theorem kardeng (A2 B2 V: class):
  $ wi (wcel A2 V) (wb (wceq (cfv A2 ckard) (cfv B2 ckard)) (wbr A2 B2 cen)) $;

--| If two sets are equinumerous, then their ` kard ` cardinal numbers are equal. (Contributed by BTernaryTau, 4-Jul-2026.)
theorem kardenir (A2 B2: class):
  $ wi (wbr A2 B2 cen) (wceq (cfv A2 ckard) (cfv B2 ckard)) $;

--| The empty set is the only set with cardinality zero. This is the ` kard ` version of ~ cardeq0 . (Contributed by BTernaryTau, 3-Jul-2026.)
theorem kard0b (A2: class):
  $ wb (wceq (cfv A2 ckard) (cfv c0 ckard)) (wceq A2 c0) $;

--| A singleton has cardinality one. (Contributed by BTernaryTau, 4-Jul-2026.)
theorem kardsn (A2 V: class):
  $ wi (wcel A2 V) (wceq (cfv (csn A2) ckard) (cfv c1o ckard)) $;

--| One set dominates another iff an element in its ` kard ` cardinality dominates an element in the second set's ` kard ` cardinality. (Contributed by BTernaryTau, 4-Jul-2026.)
theorem karddom {x3 y1: setvar} (A2 B2: class):
  $ wb (wbr A2 B2 cdom) (wrex x3 (wrex y1 (wbr (cv x3) (cv y1) cdom) (cfv B2 ckard)) (cfv A2 ckard)) $;

--| One set strictly dominates another iff an element in its ` kard ` cardinality strictly dominates an element in the second set's ` kard ` cardinality. (Contributed by BTernaryTau, 6-Jul-2026.)
theorem kardsdom {x3 y1: setvar} (A2 B2: class):
  $ wb (wbr A2 B2 csdm) (wrex x3 (wrex y1 (wbr (cv x3) (cv y1) csdm) (cfv B2 ckard)) (cfv A2 ckard)) $;

--| One set is equinumerous to another iff an element in its ` kard ` cardinality is equinumerous to an element in the second set's ` kard ` cardinality. See ~ kardeng for a version with equality of cardinals. (Contributed by BTernaryTau, 7-Jul-2026.)
theorem kardexen {x3 y1: setvar} (A2 B2: class):
  $ wb (wbr A2 B2 cen) (wrex x3 (wrex y1 (wbr (cv x3) (cv y1) cen) (cfv B2 ckard)) (cfv A2 ckard)) $;

--| If two sets have equal nonzero ` card ` cardinalities, then they have equal ` kard ` cardinalities. This theorem does not depend on the Axiom of Choice. (Contributed by BTernaryTau, 3-Jul-2026.)
theorem kardcard2a (A2 B2: class):
  $ wi (wa (wceq (cfv A2 ccrd) (cfv B2 ccrd)) (wne (cfv A2 ccrd) c0)) (wceq (cfv A2 ckard) (cfv B2 ckard)) $;

--| If two sets have equal ` kard ` cardinalities, then they have equal ` card ` cardinalities. This theorem does not depend on the Axiom of Choice. (Contributed by BTernaryTau, 3-Jul-2026.)
theorem kardcard2b (A2 B2: class):
  $ wi (wceq (cfv A2 ckard) (cfv B2 ckard)) (wceq (cfv A2 ccrd) (cfv B2 ccrd)) $;

--| Two numerable sets have equal ` kard ` cardinalities iff they have equal ` card ` cardinalities. This theorem does not depend on the Axiom of Choice. (Contributed by BTernaryTau, 3-Jul-2026.)
theorem kardcard2 (A2 B2: class):
  $ wi (wa (wcel A2 (cdm ccrd)) (wcel B2 (cdm ccrd))) (wb (wceq (cfv A2 ckard) (cfv B2 ckard)) (wceq (cfv A2 ccrd) (cfv B2 ccrd))) $;

--| The Axiom of Choice implies that two sets have equal ` kard ` cardinalities iff they have equal ` card ` cardinalities. (Contributed by BTernaryTau, 3-Jul-2026.)
theorem ackardcard (A2 B2 V W: class):
  $ wi wac (wi (wa (wcel A2 V) (wcel B2 W)) (wb (wceq (cfv A2 ckard) (cfv B2 ckard)) (wceq (cfv A2 ccrd) (cfv B2 ccrd)))) $;

--| Two sets have equal ` kard ` cardinalities iff they have equal ` card ` cardinalities. This theorem depends on the Axiom of Choice. (Contributed by BTernaryTau, 3-Jul-2026.)
theorem kardcard (A2 B2 V W: class):
  $ wi (wa (wcel A2 V) (wcel B2 W)) (wb (wceq (cfv A2 ckard) (cfv B2 ckard)) (wceq (cfv A2 ccrd) (cfv B2 ccrd))) $;

--| The ` kard ` cardinal number of a finite ordinal is finite. (Contributed by BTernaryTau, 3-Jul-2026.)
theorem kardnnfi (A2: class):
  $ wi (wcel A2 com) (wcel (cfv A2 ckard) cfn) $;

--| The ` kard ` cardinal number of a finite set is finite. (Contributed by BTernaryTau, 3-Jul-2026.)
theorem kardfi (A2: class):
  $ wi (wcel A2 cfn) (wcel (cfv A2 ckard) cfn) $;

--| An upper bound on the rank of a ` kard ` cardinal. (Contributed by BTernaryTau, 4-Jul-2026.)
theorem rankkardu (A2: class):
  $ wss (cfv (cfv A2 ckard) crnk) (csuc (cfv A2 crnk)) $;

--| The Fundamental Theorem of Enumeration (see ~ https://sites.math.rutgers.edu/~~zeilberg/mamarim/mamarimPDF/enu.pdf ), extended to all sets. The expression ` U_ x e. A ( { x } X. B ) ` can be thought of as expressing an indexed disjoint union ` |_| x e. A B ` where each ` B ` has its elements tagged with the set ` x ` that generated it. See the comment directly before ~ undjudom for context on disjoint union as a representation of cardinal addition. This theorem is not limited to numerable sets, but it also does not depend on AC. See ~ 1enumen for a version that uses equinumerosity , ~ 1enumcard for a version that uses the ` card ` function, and ~ 1enum for a version that uses an explicit sum of complex number 1s. (Contributed by BTernaryTau, 4-Jul-2026.)
theorem _1enumkard {x3: setvar} (A2: class):
  $ wi (wcel A2 cvv) (wceq (cfv A2 ckard) (cfv (ciun x3 A2 (cxp (csn (cv x3)) c1o)) ckard)) $;

--| Extend the definition of a class to include the second converse function.
term ccnv2: class;

--| Extend the definition of a class to include the third converse function.
term ccnv3: class;

--| Extend the definition of a class to include the first G&ouml;del operation.
term cgdlop1: class;

--| Extend the definition of a class to include the second G&ouml;del operation.
term cgdlop2: class;

--| Extend the definition of a class to include the third G&ouml;del operation.
term cgdlop3: class;

--| Extend the definition of a class to include the fourth G&ouml;del operation.
term cgdlop4: class;

--| Extend the definition of a class to include the fifth G&ouml;del operation.
term cgdlop5: class;

--| Extend the definition of a class to include the sixth G&ouml;del operation.
term cgdlop6: class;

--| Extend the definition of a class to include the seventh G&ouml;del operation.
term cgdlop7: class;

--| Extend the definition of a class to include the eighth G&ouml;del operation.
term cgdlop8: class;

--| Extend the definition of a class to include the combined G&ouml;del operations.
term cgdlopc: class;

--| Define a function that returns the second converse of a set. The second converse of a set takes all ordered triples in the set and rotates them so the last argument becomes the first argument. Based on Definition 14.1(1) of [TakeutiZaring] p. 143. (Contributed by BTernaryTau, 2-Sep-2026.)
axiom df_cnv2 {x3 y1 z w: setvar}:
  $ wceq ccnv2 (cmpt w cvv (coprab x3 y1 z (wcel (cop (cop (cv z) (cv x3)) (cv y1)) (cv w)))) $;

--| Define a function that returns the third converse of a set. The third converse of a set takes all ordered triples in the set and swaps the second and third arguments. Based on Definition 14.1(2) of [TakeutiZaring] p. 143. (Contributed by BTernaryTau, 2-Sep-2026.)
axiom df_cnv3 {x3 y1 z w: setvar}:
  $ wceq ccnv3 (cmpt w cvv (coprab x3 y1 z (wcel (cop (cop (cv x3) (cv z)) (cv y1)) (cv w)))) $;

--| Define the first G&ouml;del operation. This function takes two arguments and returns the unordered pair containing both (see ~ df-pr ). Based on the first case of Definition 14.2 of [TakeutiZaring] p. 144. (Contributed by BTernaryTau, 2-Sep-2026.)
axiom df_gdlop1 {x3 y1: setvar}:
  $ wceq cgdlop1 (cmpo x3 y1 cvv cvv (cpr (cv x3) (cv y1))) $;

--| Define the second G&ouml;del operation. This function takes two arguments and returns the intersection of the first argument with the membership relation (see ~ df-in and ~ df-eprel ). The second argument is ignored. Based on the second case of Definition 14.2 of [TakeutiZaring] p. 144. (Contributed by BTernaryTau, 2-Sep-2026.)
axiom df_gdlop2 {x3 y1: setvar}:
  $ wceq cgdlop2 (cmpo x3 y1 cvv cvv (cin (cv x3) cep)) $;

--| Define the third G&ouml;del operation. This function takes two arguments and returns the first argument minus the second argument (see ~ df-dif ). Based on the third case of Definition 14.2 of [TakeutiZaring] p. 144. (Contributed by BTernaryTau, 2-Sep-2026.)
axiom df_gdlop3 {x3 y1: setvar}:
  $ wceq cgdlop3 (cmpo x3 y1 cvv cvv (cdif (cv x3) (cv y1))) $;

--| Define the fourth G&ouml;del operation. This function takes two arguments and returns the first argument restricted to the second argument (see ~ df-res ). Based on the fourth case of Definition 14.2 of [TakeutiZaring] p. 144. (Contributed by BTernaryTau, 2-Sep-2026.)
axiom df_gdlop4 {x3 y1: setvar}:
  $ wceq cgdlop4 (cmpo x3 y1 cvv cvv (cres (cv x3) (cv y1))) $;

--| Define the fifth G&ouml;del operation. This function takes two arguments and returns the intersection of the first argument with the domain of the second argument (see ~ df-in and ~ df-dm ). Based on the fifth case of Definition 14.2 of [TakeutiZaring] p. 144. (Contributed by BTernaryTau, 2-Sep-2026.)
axiom df_gdlop5 {x3 y1: setvar}:
  $ wceq cgdlop5 (cmpo x3 y1 cvv cvv (cin (cv x3) (cdm (cv y1)))) $;

--| Define the sixth G&ouml;del operation. This function takes two arguments and returns the intersection of the first argument with the converse of the second argument (see ~ df-in and ~ df-cnv ). Based on the sixth case of Definition 14.2 of [TakeutiZaring] p. 144. (Contributed by BTernaryTau, 2-Sep-2026.)
axiom df_gdlop6 {x3 y1: setvar}:
  $ wceq cgdlop6 (cmpo x3 y1 cvv cvv (cin (cv x3) (ccnv (cv y1)))) $;

--| Define the seventh G&ouml;del operation. This function takes two arguments and returns the intersection of the first argument with the second converse of the second argument (see ~ df-in and ~ df-cnv2 ). Based on the seventh case of Definition 14.2 of [TakeutiZaring] p. 144. (Contributed by BTernaryTau, 2-Sep-2026.)
axiom df_gdlop7 {x3 y1: setvar}:
  $ wceq cgdlop7 (cmpo x3 y1 cvv cvv (cin (cv x3) (cfv (cv y1) ccnv2))) $;

--| Define the eighth G&ouml;del operation. This function takes two arguments and returns the intersection of the first argument with the third converse of the second argument (see ~ df-in and ~ df-cnv3 ). Based on the eighth case of Definition 14.2 of [TakeutiZaring] p. 144. (Contributed by BTernaryTau, 2-Sep-2026.)
axiom df_gdlop8 {x3 y1: setvar}:
  $ wceq cgdlop8 (cmpo x3 y1 cvv cvv (cin (cv x3) (cfv (cv y1) ccnv3))) $;

--| Define the combined G&ouml;del operations. This function takes three arguments and uses the first to determine which of the eight G&ouml;del operations ~ df-gdlop1 through ~ df-gdlop8 to apply to the second and third arguments. Based on Definition 14.2 of [TakeutiZaring] p. 144. (Contributed by BTernaryTau, 2-Sep-2026.)
axiom df_gdlopc {x3 y1 n: setvar}:
  $ wceq cgdlopc (cmpt3 n x3 y1 (cdif c9o (csn c0)) cvv cvv (cif (wceq (cv n) c1o) (cfv (cop (cv x3) (cv y1)) cgdlop1) (cif (wceq (cv n) c2o) (cfv (cop (cv x3) (cv y1)) cgdlop2) (cif (wceq (cv n) c3o) (cfv (cop (cv x3) (cv y1)) cgdlop3) (cif (wceq (cv n) c4o) (cfv (cop (cv x3) (cv y1)) cgdlop4) (cif (wceq (cv n) c5o) (cfv (cop (cv x3) (cv y1)) cgdlop5) (cif (wceq (cv n) c6o) (cfv (cop (cv x3) (cv y1)) cgdlop6) (cif (wceq (cv n) c7o) (cfv (cop (cv x3) (cv y1)) cgdlop7) (cfv (cop (cv x3) (cv y1)) cgdlop8))))))))) $;

--| Extend the definition of a class to include the lexicographical ordering of ` On X. On ` .
term clexo: class;

--| Extend the definition of a class to include a set-like well-ordering of ` On X. On ` .
term cr0: class;

--| Extend the definition of a class to include the ` _R0 ` order isomorphism from ` On X. On ` to ` On ` .
term ccj0: class;

--| Extend the definition of a class to include an order isomorphism from ` ( On X. On ) X. 9o ` to ` On ` .
term cj: class;

--| Extend the definition of a class to include the first argument of the ` _J ` function.
term ck1: class;

--| Extend the definition of a class to include the second argument of the ` _J ` function.
term ck2: class;

--| Extend the definition of a class to include the third argument of the ` _J ` function.
term ck3: class;

--| Extend the definition of a class to include the constructible sets function.
term cfnl: class;

--| Extend the definition of a class to include the class of all constructible sets.
term cl: class;

--| Define the lexicographical ordering of ` On X. On ` . Based on Definition 7.55 of [TakeutiZaring] p. 54. (Contributed by BTernaryTau, 2-Sep-2026.)
axiom df_lexo {x3 y1: setvar}:
  $ wceq clexo (copab x3 y1 (wa (wa (wcel (cv x3) (cxp con0 con0)) (wcel (cv y1) (cxp con0 con0))) (wo (wcel (cfv (cv x3) c1st) (cfv (cv y1) c1st)) (wa (wceq (cfv (cv x3) c1st) (cfv (cv y1) c1st)) (wcel (cfv (cv x3) c2nd) (cfv (cv y1) c2nd)))))) $;

--| Define a particular set-like well-ordering of ` On X. On ` using the lexicographical ordering ` LexOrd ` . Based on Definition 7.57 of [TakeutiZaring] p. 54. See ~ r0weseon for a proof that this relation is a set-like well-order. (Contributed by BTernaryTau, 2-Sep-2026.)
axiom df_r0 {x3 y1: setvar}:
  $ wceq cr0 (copab x3 y1 (wa (wa (wcel (cv x3) (cxp con0 con0)) (wcel (cv y1) (cxp con0 con0))) (wo (wcel (cun (cfv (cv x3) c1st) (cfv (cv x3) c2nd)) (cun (cfv (cv y1) c1st) (cfv (cv y1) c2nd))) (wa (wceq (cun (cfv (cv x3) c1st) (cfv (cv x3) c2nd)) (cun (cfv (cv y1) c1st) (cfv (cv y1) c2nd))) (wbr (cv x3) (cv y1) clexo))))) $;

--| Define the ` _R0 ` order isomorphism of ` On X. On ` onto ` On ` . Equivalent to Definition 7.59 of [TakeutiZaring] p. 55 (see ~ j0iso ). (Contributed by BTernaryTau, 2-Sep-2026.)
axiom df_j0:
  $ wceq ccj0 (ccnv (coi (cxp con0 con0) cr0)) $;

--| Define an order isomorphism from ` ( On X. On ) X. 9o ` to ` On ` . Based on Definition 15.2 of [TakeutiZaring] p. 155. (Contributed by BTernaryTau, 2-Sep-2026.)
axiom df_j {x3 y1 n: setvar}:
  $ wceq cj (cmpt3 x3 y1 n con0 con0 c9o (co (co c9o (cfv (cop (cv x3) (cv y1)) ccj0) comu) (cv n) coa)) $;

--| Define a function that takes an ordinal and returns the first argument of the ordered triple ` <. x , y , n >. ` such that the ordinal equals ` ( J `` <. x , y , n >. ) ` . Based on the first case of Definition 15.7 of [TakeutiZaring] p. 156. (Contributed by BTernaryTau, 2-Sep-2026.)
axiom df_k1 {x3 y1 z n: setvar}:
  $ wceq ck1 (copab z x3 (wa (wcel (cv x3) con0) (wrex n (wrex y1 (wceq (cv z) (cfv (cotp (cv x3) (cv y1) (cv n)) cj)) con0) c9o))) $;

--| Define a function that takes an ordinal and returns the second argument of the ordered triple ` <. x , y , n >. ` such that the ordinal equals ` ( J `` <. x , y , n >. ) ` . Based on the second case of Definition 15.7 of [TakeutiZaring] p. 156. (Contributed by BTernaryTau, 2-Sep-2026.)
axiom df_k2 {x3 y1 z n: setvar}:
  $ wceq ck2 (copab z y1 (wa (wcel (cv y1) con0) (wrex n (wrex x3 (wceq (cv z) (cfv (cotp (cv x3) (cv y1) (cv n)) cj)) con0) c9o))) $;

--| Define a function that takes an ordinal and returns the third argument of the ordered triple ` <. x , y , n >. ` such that the ordinal equals ` ( J `` <. x , y , n >. ) ` . Based on the third case of Definition 15.7 of [TakeutiZaring] p. 156. (Contributed by BTernaryTau, 2-Sep-2026.)
axiom df_k3 {x3 y1 z n: setvar}:
  $ wceq ck3 (copab z n (wa (wcel (cv n) c9o) (wrex x3 (wrex y1 (wceq (cv z) (cfv (cotp (cv x3) (cv y1) (cv n)) cj)) con0) con0))) $;

--| Define a function whose range contains all and only the constructible sets. Based on Definition 15.13 of [TakeutiZaring] p. 158. (Contributed by BTernaryTau, 3-Sep-2026.)
axiom df_fnl {x3: setvar}:
  $ wceq cfnl (crecs (cmpt x3 cvv (cif (wceq (cfv (cdm (cv x3)) ck3) c0) (crn (cv x3)) (cfv (cotp (cfv (cdm (cv x3)) ck3) (cfv (cfv (cdm (cv x3)) ck1) (cv x3)) (cfv (cfv (cdm (cv x3)) ck2) (cv x3))) cgdlopc)))) $;

--| Define the class of all constructible sets. Definition 15.15 of [TakeutiZaring] p. 158. (Contributed by BTernaryTau, 3-Sep-2026.)
axiom df_l:
  $ wceq cl (cima cfnl con0) $;

--| Lexicographical order is a well-ordering of ` On X. On ` . Part of Proposition 7.56(1) of [TakeutiZaring] p. 54. Unlike ` _R0 ` , this order is _not_ set-like, as the preimage of ` <. 1o , (/) >. ` is the proper class ` ( { (/) } X. On ) ` . This theorem is ~ leweon expressed using ` LexOrd ` . (Contributed by BTernaryTau, 19-Sep-2026.)
theorem lexoweon:
  $ wwe (cxp con0 con0) clexo $;

--| Condition for two ordered pairs to be related by ` LexOrd ` . (Contributed by BTernaryTau, 20-Sep-2026.)
theorem brlexod (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 con0) $ >
  $ wi ph (wcel B2 con0) $ >
  $ wi ph (wcel C con0) $ >
  $ wi ph (wcel D con0) $ >
  $ wi ph (wb (wbr (cop A2 B2) (cop C D) clexo) (wo (wcel A2 C) (wa (wceq A2 C) (wcel B2 D)))) $;

--| ` _R0 ` is a set-like well-ordering of ` On X. On ` . Part of Proposition 7.58 of [TakeutiZaring] p. 54. This theorem is ~ r0weon expressed using ` _R0 ` . (Contributed by BTernaryTau, 19-Sep-2026.)
theorem r0weseon:
  $ wa (wwe (cxp con0 con0) cr0) (wse (cxp con0 con0) cr0) $;

--| Condition for two ordered pairs to be related by ` _R0 ` . (Contributed by BTernaryTau, 19-Sep-2026.)
theorem brr0d (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 con0) $ >
  $ wi ph (wcel B2 con0) $ >
  $ wi ph (wcel C con0) $ >
  $ wi ph (wcel D con0) $ >
  $ wi ph (wb (wbr (cop A2 B2) (cop C D) cr0) (wo (wcel (cun A2 B2) (cun C D)) (wa (wceq (cun A2 B2) (cun C D)) (wbr (cop A2 B2) (cop C D) clexo)))) $;

--| The domain of ` _R0 ` is a subset of ` On X. On ` . (Contributed by BTernaryTau, 22-Sep-2026.)
theorem dmr0ss:
  $ wss (cdm cr0) (cxp con0 con0) $;

--| If two ordered pairs are related by ` _R0 ` , then the maximum of the first pair is less than or equal to the maximum of the second pair. (The union of two ordinals is proven to be their maximum in ~ ordunmax .) (Contributed by BTernaryTau, 22-Sep-2026.)
theorem r0maxss (ph: wff) (A2 B2 C D: class):
  $ wi ph (wcel A2 con0) $ >
  $ wi ph (wcel B2 con0) $ >
  $ wi ph (wcel C con0) $ >
  $ wi ph (wcel D con0) $ >
  $ wi ph (wbr (cop A2 B2) (cop C D) cr0) $ >
  $ wi ph (wss (cun A2 B2) (cun C D)) $;

--| ` _J0 ` is the ` _R0 ` order isomorphism of ` On X. On ` onto ` On ` . Definition 7.59 of [TakeutiZaring] p. 55. This isomorphism is unique by ~ weisoeq and ~ r0weseon . (Contributed by BTernaryTau, 19-Sep-2026.)
theorem j0iso:
  $ wiso (cxp con0 con0) con0 cr0 cep ccj0 $;

--| ` _J0 ` is strictly monotonic over its second argument when its first argument is zero. (Contributed by BTernaryTau, 19-Sep-2026.)
theorem j00smo {x3: setvar} (F: class x3):
  $ wceq F (cmpt x3 con0 (cfv (cop c0 (cv x3)) ccj0)) $ >
  $ wsmo F $;

--| The value of ` _J0 ` is at least the maximum of its two arguments. Proposition 15.1(1) of [TakeutiZaring] p. 154. (Contributed by BTernaryTau, 22-Sep-2026.)
theorem maxssj0 (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wss (cun A2 B2) (cfv (cop A2 B2) ccj0)) $;

--| Lemma for ~ j0ltaleph . (Contributed by BTernaryTau, 25-Sep-2026.)
theorem j0ltalephlem (A2 B2: class):
  $ wi (wa (wcel A2 con0) (wcel B2 con0)) (wbr (cfv (cop A2 B2) ccj0) (cxp (csuc (cun A2 B2)) (csuc (cun A2 B2))) cdom) $;

--| The value of ` _J0 ` is less than an aleph if its two arguments are less than that aleph. Proposition 15.1(2) of [TakeutiZaring] p. 154. (Contributed by BTernaryTau, 25-Sep-2026.)
theorem j0ltaleph (A2 B2 C: class):
  $ wi (wa (wcel A2 (cfv C cale)) (wcel B2 (cfv C cale))) (wcel (cfv (cop A2 B2) ccj0) (cfv C cale)) $;

--| Alternate definition of ` _J ` as a one-argument function. (Contributed by BTernaryTau, 4-Oct-2026.)
theorem dfj2 {x3: setvar}:
  $ wceq cj (cmpt x3 (cxp (cxp con0 con0) c9o) (co (co c9o (cfv (cfv (cv x3) c1st) ccj0) comu) (cfv (cv x3) c2nd) coa)) $;

--| ` _J ` is a one-to-one function. Part of Proposition 15.3 of [TakeutiZaring] p. 155. (Contributed by BTernaryTau, 6-Oct-2026.)
theorem jf1:
  $ wf1 (cxp (cxp con0 con0) c9o) con0 cj $;

--| ` _J ` is a bijection from ` ( ( On X. On ) X. 9o ) ` to ` On ` . Proposition 15.3 of [TakeutiZaring] p. 155. (Contributed by BTernaryTau, 6-Oct-2026.)
theorem jf1o:
  $ wf1o (cxp (cxp con0 con0) c9o) con0 cj $;

--| Alternate definition of ` _K1 ` using maps-to notation. (Contributed by BTernaryTau, 9-Oct-2026.)
theorem dfk12 {x3: setvar}:
  $ wceq ck1 (cmpt x3 con0 (cfv (cfv (cfv (cv x3) (ccnv cj)) c1st) c1st)) $;

--| Alternate definition of ` _K2 ` using maps-to notation. (Contributed by BTernaryTau, 10-Oct-2026.)
theorem dfk22 {x3: setvar}:
  $ wceq ck2 (cmpt x3 con0 (cfv (cfv (cfv (cv x3) (ccnv cj)) c1st) c2nd)) $;

--| Alternate definition of ` _K3 ` using maps-to notation. (Contributed by BTernaryTau, 10-Oct-2026.)
theorem dfk32 {x3: setvar}:
  $ wceq ck3 (cmpt x3 con0 (cfv (cfv (cv x3) (ccnv cj)) c2nd)) $;

--| Values of the ` _K1 ` function are ordinals. (Contributed by BTernaryTau, 11-Oct-2026.)
theorem k1on (A2: class):
  $ wcel (cfv A2 ck1) con0 $;

--| Values of the ` _K2 ` function are ordinals. (Contributed by BTernaryTau, 11-Oct-2026.)
theorem k2on (A2: class):
  $ wcel (cfv A2 ck2) con0 $;

--| Values of the ` _K3 ` function are ordinals less than 9. (Contributed by BTernaryTau, 11-Oct-2026.)
theorem k39o (A2: class):
  $ wcel (cfv A2 ck3) c9o $;

--| Identity law for the ` _J ` function. Proposition 15.8 of [TakeutiZaring] p. 156. (Contributed by BTernaryTau, 11-Oct-2026.)
theorem jk1k2k3 (A2: class):
  $ wi (wcel A2 con0) (wceq A2 (cfv (cotp (cfv A2 ck1) (cfv A2 ck2) (cfv A2 ck3)) cj)) $;

--| An upper bound on the value of ` _J0 ` . (Contributed by BTernaryTau, 12-Oct-2026.)
theorem j0le (A2: class):
  $ wi (wcel A2 con0) (wss (cfv (cop (cfv A2 ck1) (cfv A2 ck2)) ccj0) A2) $;

--| A strict upper bound on the value of ` _J0 ` for nonzero values of ` _K3 ` . (Contributed by BTernaryTau, 12-Oct-2026.)
theorem k3n0j0lt (A2: class):
  $ wi (wa (wcel A2 con0) (wcel c0 (cfv A2 ck3))) (wcel (cfv (cop (cfv A2 ck1) (cfv A2 ck2)) ccj0) A2) $;

--| The value of ` _K1 ` is bounded by its argument. Part of Proposition 15.10(1) of [TakeutiZaring] p. 156. (Contributed by BTernaryTau, 12-Oct-2026.)
theorem k1le (A2: class):
  $ wi (wcel A2 con0) (wss (cfv A2 ck1) A2) $;

--| The value of ` _K2 ` is bounded by its argument. Part of Proposition 15.10(1) of [TakeutiZaring] p. 156. (Contributed by BTernaryTau, 12-Oct-2026.)
theorem k2le (A2: class):
  $ wi (wcel A2 con0) (wss (cfv A2 ck2) A2) $;

--| The value of ` _K1 ` is strictly bounded by its argument when the value of ` _K3 ` is nonzero. Part of Proposition 15.10(2) of [TakeutiZaring] p. 156. (Contributed by BTernaryTau, 12-Oct-2026.)
theorem k3n0k1lt (A2: class):
  $ wi (wa (wcel A2 con0) (wcel c0 (cfv A2 ck3))) (wcel (cfv A2 ck1) A2) $;

--| The value of ` _K2 ` is strictly bounded by its argument when the value of ` _K3 ` is nonzero. Part of Proposition 15.10(2) of [TakeutiZaring] p. 156. (Contributed by BTernaryTau, 12-Oct-2026.)
theorem k3n0k2lt (A2: class):
  $ wi (wa (wcel A2 con0) (wcel c0 (cfv A2 ck3))) (wcel (cfv A2 ck2) A2) $;

--| Lemma for ~ jltaleph . (Contributed by BTernaryTau, 16-Oct-2026.)
theorem jltalephlem (A2 B2 C: class):
  $ wi (wa (wcel C c9o) (wbr com (cfv (cop A2 B2) ccj0) cdom)) (wbr (co (co c9o (cfv (cop A2 B2) ccj0) comu) C coa) (cfv (cop A2 B2) ccj0) cen) $;

--| The value of ` _J ` is less than an aleph if its first two arguments are less than that aleph. Proposition 15.11 of [TakeutiZaring] p. 156. (Contributed by BTernaryTau, 16-Oct-2026.)
theorem jltaleph (A2 B2 C D: class):
  $ wi (w3a (wcel A2 (cfv D cale)) (wcel B2 (cfv D cale)) (wcel C c9o)) (wcel (cfv (cotp A2 B2 C) cj) (cfv D cale)) $;

--| The value of ` _FL ` when the value of ` _K3 ` is zero. Part of Proposition 15.14 of [TakeutiZaring] p. 158. (Contributed by BTernaryTau, 17-Oct-2026.)
theorem fnlfvk30 (A2: class):
  $ wi (wa (wcel A2 con0) (wceq (cfv A2 ck3) c0)) (wceq (cfv A2 cfnl) (cima cfnl A2)) $;

--| The value of ` _FL ` when the value of ` _K3 ` is nonzero. Part of Proposition 15.14 of [TakeutiZaring] p. 158. (Contributed by BTernaryTau, 17-Oct-2026.)
theorem fnlfvk3n0 (A2: class):
  $ wi (wa (wcel A2 con0) (wne (cfv A2 ck3) c0)) (wceq (cfv A2 cfnl) (cfv (cotp (cfv A2 ck3) (cfv (cfv A2 ck1) cfnl) (cfv (cfv A2 ck2) cfnl)) cgdlopc)) $;

--| If ` G ` is a global choice function, then the Axiom of Choice (in the form of the right-hand side of ~ dfac4 ) holds. Note that ` G ` must be a proper class by ~ fndmexb . This means we cannot show that the existence of a class that behaves as a global choice function is sufficient because we only have existential quantifiers for sets, not (proper) classes. However, if a class variant of ~ exlimiv were available, then it could be used alongside the closed form of this theorem to prove that result. (Contributed by BTernaryTau, 12-Dec-2024.)
theorem gblacfnacd {x3 z f2: setvar} (ph: wff f2) (G: class x3):
  $ wi ph (wfn G cvv) $ >
  $ wi ph (wal z (wi (wne (cv z) c0) (wcel (cfv (cv z) G) (cv z)))) $ >
  $ wi ph (wal x3 (wex f2 (wa (wfn (cv f2) (cv x3)) (wral z (wi (wne (cv z) c0) (wcel (cfv (cv z) (cv f2)) (cv z))) (cv x3))))) $;

--| If ` G ` is a global choice function, then the Axiom of Choice holds. This is ~ gblacfnacd expressed using ` CHOICE ` . (Contributed by BTernaryTau, 25-Sep-2026.)
theorem gblacfnac2d {z: setvar} (ph: wff) (G: class):
  $ wi ph (wfn G cvv) $ >
  $ wi ph (wal z (wi (wne (cv z) c0) (wcel (cfv (cv z) G) (cv z)))) $ >
  $ wi ph wac $;

--| Lemma for ~ onvf1od . (Contributed by BTernaryTau, 2-Dec-2025.)
theorem onvf1odlem1 {x3 y1: setvar} (A2: class) (V: class x3 y1):
  $ wi (wcel A2 V) (wrex x3 (wrex y1 (wn (wcel (cv y1) A2)) (cfv (cv x3) cr1)) con0) $;

--| Lemma for ~ onvf1od . (Contributed by BTernaryTau, 2-Dec-2025.)
theorem onvf1odlem2 {x3 y1 z: setvar} (ph: wff x3 y1 z) (A2: class) (G M: class x3 y1) (N V: class x3 y1 z):
  $ wi ph (wal z (wi (wne (cv z) c0) (wcel (cfv (cv z) G) (cv z)))) $ >
  $ wceq M (cint (crab x3 (wrex y1 (wn (wcel (cv y1) A2)) (cfv (cv x3) cr1)) con0)) $ >
  $ wceq N (cfv (cdif (cfv M cr1) A2) G) $ >
  $ wi ph (wi (wcel A2 V) (wcel N (cdif (cfv M cr1) A2))) $;

--| Lemma for ~ onvf1od . The value of ` F ` at an ordinal ` A ` . (Contributed by BTernaryTau, 2-Dec-2025.)
theorem onvf1odlem3 {x3 y1 w v u: setvar} (A2: class x3 y1 w) (B2 C: class x3 y1 w v u) (F: class x3 y1 w) (G: class x3 y1 v u) (M N: class x3 y1 w v u):
  $ wceq M (cint (crab x3 (wrex y1 (wn (wcel (cv y1) (crn (cv w)))) (cfv (cv x3) cr1)) con0)) $ >
  $ wceq N (cfv (cdif (cfv M cr1) (crn (cv w))) G) $ >
  $ wceq F (crecs (cmpt w cvv N)) $ >
  $ wceq B2 (cint (crab u (wrex v (wn (wcel (cv v) (cima F A2))) (cfv (cv u) cr1)) con0)) $ >
  $ wceq C (cfv (cdif (cfv B2 cr1) (cima F A2)) G) $ >
  $ wi (wcel A2 con0) (wceq (cfv A2 F) C) $;

--| Lemma for ~ onvf1od . If the range of ` F ` does not exist, then it must equal the universe. (Contributed by BTernaryTau, 4-Dec-2025.)
theorem onvf1odlem4 {x3 y1 z w v u t: setvar} (ph: wff x3 y1 z w u) (B2: class x3 y1 w v u t) (C: class x3 y1 z w v u t) (F: class x3 y1 w) (G: class x3 y1 v u t) (M N: class x3 y1 z w v u t):
  $ wi ph (wal z (wi (wne (cv z) c0) (wcel (cfv (cv z) G) (cv z)))) $ >
  $ wceq M (cint (crab x3 (wrex y1 (wn (wcel (cv y1) (crn (cv w)))) (cfv (cv x3) cr1)) con0)) $ >
  $ wceq N (cfv (cdif (cfv M cr1) (crn (cv w))) G) $ >
  $ wceq F (crecs (cmpt w cvv N)) $ >
  $ wceq B2 (cint (crab u (wrex v (wn (wcel (cv v) (cima F (cv t)))) (cfv (cv u) cr1)) con0)) $ >
  $ wceq C (cfv (cdif (cfv B2 cr1) (cima F (cv t))) G) $ >
  $ wi ph (wi (wn (wcel (crn F) cvv)) (wceq (crn F) cvv)) $;

--| If ` G ` is a global choice function, then ` F ` is a bijection from the ordinals to the universe. This is the ZFC version of (1 ` -> ` 2) in ~ https://tinyurl.com/hamkins-gblac . (Contributed by BTernaryTau, 5-Dec-2025.)
theorem onvf1od {x3 y1 z w: setvar} (ph: wff x3 y1 z w) (F: class x3 y1 w) (G: class x3 y1) (M N: class x3 y1 z w):
  $ wi ph (wal z (wi (wne (cv z) c0) (wcel (cfv (cv z) G) (cv z)))) $ >
  $ wceq M (cint (crab x3 (wrex y1 (wn (wcel (cv y1) (crn (cv w)))) (cfv (cv x3) cr1)) con0)) $ >
  $ wceq N (cfv (cdif (cfv M cr1) (crn (cv w))) G) $ >
  $ wceq F (crecs (cmpt w cvv N)) $ >
  $ wi ph (wf1o con0 cvv F) $;

--| If ` F ` maps the universe one-to-one into the ordinals, then ` R ` well-orders the universe. This is the ZFC version of (6 ` -> ` 3) which can be used in place of (7 ` -> ` 3) in ~ https://tinyurl.com/hamkins-gblac . Note that in NBG set theory the antecedent would be something like ` A. X E. F F : X -1-1-> On ` , but since we cannot quantify over classes, we instead consider only the case ` X = _V ` which is sufficient for this proof. (Contributed by BTernaryTau, 11-Jun-2026.)
theorem vonf1wev {x3 y1: setvar} (R: class x3 y1) (F: class):
  $ wceq R (copab x3 y1 (wcel (cfv (cv x3) F) (cfv (cv y1) F))) $ >
  $ wi (wf1 cvv con0 F) (wwe cvv R) $;

--| If ` F ` is a bijection from the universe to the ordinals, then ` R ` well-orders the universe. This is the ZFC version of (2 ` -> ` 3) in ~ https://tinyurl.com/hamkins-gblac . (Contributed by BTernaryTau, 6-Dec-2025.) (Proof shortened by BTernaryTau, 11-Jun-2026.)
theorem vonf1owev {x3 y1: setvar} (R: class x3 y1) (F: class):
  $ wceq R (copab x3 y1 (wcel (cfv (cv x3) F) (cfv (cv y1) F))) $ >
  $ wi (wf1o cvv con0 F) (wwe cvv R) $;

--| Obsolete version of ~ vonf1owev as of 11-Jun-2026. (Contributed by BTernaryTau, 6-Dec-2025.) (Proof modification is discouraged.) (New usage is discouraged.)
theorem vonf1owevOLD {x3 y1: setvar} (R: class x3 y1) (F: class):
  $ wceq R (copab x3 y1 (wcel (cfv (cv x3) F) (cfv (cv y1) F))) $ >
  $ wi (wf1o cvv con0 F) (wwe cvv R) $;

--| If ` R ` is a well-ordering of the universe, then ` G ` is a global choice function. Here ` G ` maps each set ` z ` to its minimal element with respect to ` R ` (except when ` z ` is the empty set, in which case it is mapped to the empty set, though this is only done for convenience). This is the ZFC version of (3 ` -> ` 1) in ~ https://tinyurl.com/hamkins-gblac . (Contributed by BTernaryTau, 29-Jun-2025.)
theorem wevgblacfn {x3 y1 z: setvar} (R: class) (G: class x3 y1 z):
  $ wceq G (cmpt z cvv (cuni (crab y1 (wral x3 (wn (wbr (cv x3) (cv y1) R)) (cv z)) (cv z)))) $ >
  $ wi (wwe cvv R) (wa (wfn G cvv) (wal z (wi (wne (cv z) c0) (wcel (cfv (cv z) G) (cv z))))) $;

--| If ` F ` is a bijection from the universe to the ordinals, then ` R ` is a set-like well-ordering of the universe. This is the ZFC version of (2 ` -> ` 4) which can be used in place of (3 ` -> ` 4) in ~ https://tinyurl.com/hamkins-gblac . This proof takes advantage of the fact that the well-order constructed in (2 ` -> ` 3) is also set-like. (Contributed by BTernaryTau, 8-Jun-2026.)
theorem vonf1osev {x3 y1: setvar} (R: class x3 y1) (F: class):
  $ wceq R (copab x3 y1 (wcel (cfv (cv x3) F) (cfv (cv y1) F))) $ >
  $ wi (wf1o cvv con0 F) (wa (wwe cvv R) (wse cvv R)) $;

--| If ` R ` is a well-ordering of the universe, then ` S ` is a set-like well-ordering of the universe. This is the ZFC version of (3 ` -> ` 4) in ~ https://tinyurl.com/hamkins-gblac . (Contributed by BTernaryTau, 18-Sep-2026.)
theorem wevsev {x3 y1: setvar} (R: class) (S: class x3 y1):
  $ wceq S (copab x3 y1 (wo (wcel (cfv (cv x3) crnk) (cfv (cv y1) crnk)) (wa (wceq (cfv (cv x3) crnk) (cfv (cv y1) crnk)) (wbr (cv x3) (cv y1) R)))) $ >
  $ wi (wwe cvv R) (wa (wwe cvv S) (wse cvv S)) $;

--| If ` R ` is a set-like well-ordering of the universe and ` A ` is a proper class, then ` F ` is a bijection from the ordinals to ` A ` . This is the ZFC version of (4 ` -> ` 5) in ~ https://tinyurl.com/hamkins-gblac . (Contributed by BTernaryTau, 9-Jun-2026.)
theorem wevonprcf1o (A2 R F: class):
  $ wceq F (coi A2 R) $ >
  $ wi (w3a (wwe cvv R) (wse cvv R) (wn (wcel A2 cvv))) (wf1o con0 A2 F) $;

--| If ` F ` is a bijection from the universe to the ordinals, then ` H ` maps ` A ` one-to-one into the ordinals. This is the ZFC version of (5 ` -> ` 6) in ~ https://tinyurl.com/hamkins-gblac . Note that in NBG set theory the antecedent would be something like ` A. X ( -. X e. _V -> E. F F : X -1-1-onto-> On ) ` , but since we cannot quantify over classes, we instead consider only the case ` X = _V ` which is sufficient for this proof. This theorem can also be viewed as (2 ` -> ` 6). (Contributed by BTernaryTau, 10-Jun-2026.)
theorem vonf1oonf1 (A2 F H: class):
  $ wceq H (cres F A2) $ >
  $ wi (wf1o cvv con0 F) (wf1 A2 con0 H) $;

--| If ` F ` maps the universe one-to-one into the ordinals and ` A ` is a proper class, then ` I ` maps the ordinals one-to-one into ` A ` and the Axiom of Choice holds. This is the ZFC version of (6 ` -> ` 7) in ~ https://tinyurl.com/hamkins-gblac . Note that in NBG set theory the first hypothesis would be something like ` ph -> A. X E. F F : X -1-1-> On ` , but since we cannot quantify over classes, we instead consider only the case ` X = _V ` which is sufficient for this proof. (Contributed by BTernaryTau, 22-Jun-2026.)
theorem vonf1onprcf1ac (ph: wff) (A2 F H I: class):
  $ wi ph (wf1 cvv con0 F) $ >
  $ wi ph (wn (wcel A2 cvv)) $ >
  $ wceq I (ccom (ccnv (cres F A2)) H) $ >
  $ wceq H (coi (cima F A2) cep) $ >
  $ wi ph (wa (wf1 con0 A2 I) wac) $;

--| Lemma for ~ onprcf1acwevd and ~ prconf1acwevd . (Contributed by BTernaryTau, 10-Sep-2026.)
theorem onprcf1acwevdlem1 {x3 y1 r: setvar} (A2: class x3 r) (B2: class r) (W: class x3 r):
  $ wceq W (cab r (wrex x3 (wa (wss (cv r) (cxp (cfv (cv x3) cr1) (cfv (cv x3) cr1))) (wwe (cfv (cv x3) cr1) (cv r))) con0)) $ >
  $ wi (w3a (wss A2 W) (wcel B2 con0) (wral y1 (wn (wwe (cfv B2 cr1) (cv y1))) A2)) (wcel A2 cvv) $;

--| Lemma for ~ onprcf1acwevd and ~ prconf1acwevd . (Contributed by BTernaryTau, 16-Sep-2026.)
theorem onprcf1acwevdlem2 {y1 z w u: setvar} (ph: wff z w) (R: class y1 z w u) (S: class y1 w u) (F: class):
  $ wceq R (copab y1 z (wo (wcel (cfv (cv y1) crnk) (cfv (cv z) crnk)) (wa (wceq (cfv (cv y1) crnk) (cfv (cv z) crnk)) (wbr (cv y1) (cv z) S)))) $ >
  $ wceq S (cfv (cint (crab w (wwe (cfv (csuc (cfv (cv y1) crnk)) cr1) (cfv (cv w) F)) con0)) F) $ >
  $ wi (wa ph (wcel (cv u) con0)) (wrex w (wwe (cfv (cv u) cr1) (cfv (cv w) F)) con0) $ >
  $ wi ph (wwe cvv R) $;

--| If ` F ` maps the ordinals one-to-one into the proper class ` W ` and the Axiom of Choice holds, then ` R ` well-orders the universe. This is the ZFC version of (7 ` -> ` 3) in ~ https://tinyurl.com/hamkins-gblac . Note that in NBG set theory the first hypothesis would be something like ` ( ph -> A. X ( -. X e. _V -> E. F F : On -1-1-> X ) ) ` , but since we cannot quantify over classes, we instead consider only the case ` X = W ` which is sufficient for this proof. (Contributed by BTernaryTau, 16-Sep-2026.)
theorem onprcf1acwevd {x3 y1 z w r: setvar} (ph: wff x3 z w r) (R: class x3 y1 z w r) (S: class x3 y1 w r) (F: class x3 r) (W: class x3 y1 z w r):
  $ wi ph (wi (wn (wcel W cvv)) (wf1 con0 W F)) $ >
  $ wi ph wac $ >
  $ wceq W (cab r (wrex x3 (wa (wss (cv r) (cxp (cfv (cv x3) cr1) (cfv (cv x3) cr1))) (wwe (cfv (cv x3) cr1) (cv r))) con0)) $ >
  $ wceq R (copab y1 z (wo (wcel (cfv (cv y1) crnk) (cfv (cv z) crnk)) (wa (wceq (cfv (cv y1) crnk) (cfv (cv z) crnk)) (wbr (cv y1) (cv z) S)))) $ >
  $ wceq S (cfv (cint (crab w (wwe (cfv (csuc (cfv (cv y1) crnk)) cr1) (cfv (cv w) F)) con0)) F) $ >
  $ wi ph (wwe cvv R) $;

--| If ` F ` maps the proper class ` W ` one-to-one into the ordinals and the Axiom of Choice holds, then ` R ` well-orders the universe. (Contributed by BTernaryTau, 16-Sep-2026.)
theorem prconf1acwevd {x3 y1 z w r: setvar} (ph: wff x3 z w r) (R: class x3 y1 z w r) (S: class x3 y1 w r) (F: class x3 r) (W: class x3 y1 z w r):
  $ wi ph (wi (wn (wcel W cvv)) (wf1 W con0 F)) $ >
  $ wi ph wac $ >
  $ wceq W (cab r (wrex x3 (wa (wss (cv r) (cxp (cfv (cv x3) cr1) (cfv (cv x3) cr1))) (wwe (cfv (cv x3) cr1) (cv r))) con0)) $ >
  $ wceq R (copab y1 z (wo (wcel (cfv (cv y1) crnk) (cfv (cv z) crnk)) (wa (wceq (cfv (cv y1) crnk) (cfv (cv z) crnk)) (wbr (cv y1) (cv z) S)))) $ >
  $ wceq S (cfv (cint (crab w (wwe (cfv (csuc (cfv (cv y1) crnk)) cr1) (cfv (cv w) (ccnv F))) con0)) (ccnv F)) $ >
  $ wi ph (wwe cvv R) $;

--| If ` F ` is a bijection from the ordinals to the universe and ` A ` is non-empty, then ` H ` maps the ordinals onto ` A ` . This is the ZFC version of (5 ` -> ` 8) in ~ https://tinyurl.com/hamkins-gblac , though it neglects to specify that ` A ` must be non-empty. Note that in NBG set theory the antecedent would be something like ` A. X ( -. X e. _V -> E. F F : X -1-1-onto-> On ) ` , but since we cannot quantify over classes, we instead consider only the case ` X = _V ` which is sufficient for this proof. This theorem can also be viewed as (2 ` -> ` 8). (Contributed by BTernaryTau, 11-Jun-2026.)
theorem vonf1oonfo {x3 y1: setvar} (A2: class) (D: class x3 y1) (F: class) (H: class x3 y1):
  $ wceq H (cmpt x3 con0 (cif (wcel (cfv (cv x3) F) A2) (cfv (cv x3) F) D)) $ >
  $ wceq D (cfv (cint (crab y1 (wcel (cfv (cv y1) F) A2) con0)) F) $ >
  $ wi (wa (wf1o con0 cvv F) (wne A2 c0)) (wfo con0 A2 H) $;

--| If ` F ` maps the ordinals onto the universe, then ` R ` well-orders the universe. This is the ZFC version of (8 ` -> ` 3) in ~ https://tinyurl.com/hamkins-gblac . Note that in NBG set theory the antecedent would be something like ` A. X ( X =/= (/) -> E. F F : On -onto-> X ) ` , but since we cannot quantify over classes, we instead consider only the case ` X = _V ` which is sufficient for this proof. (Contributed by BTernaryTau, 12-Jun-2026.)
theorem onvfowev {x3 y1 z: setvar} (R: class x3 y1 z) (F: class x3 y1) (H: class z):
  $ wceq R (copab x3 y1 (wcel (cfv (cv x3) H) (cfv (cv y1) H))) $ >
  $ wceq H (cmpt z cvv (cint (cima (ccnv F) (csn (cv z))))) $ >
  $ wi (wfo con0 cvv F) (wwe cvv R) $;

--| If ` F ` maps ` A ` one-to-one into the ordinals, then either ` A ` can be mapped one-to-one into the ordinals (by ` F ` ), or the ordinals can be mapped one-to-one into ` A ` . This is the ZFC version of (6 ` -> ` 9) in ~ https://tinyurl.com/hamkins-gblac . The proof is trivial but is included for completeness. (Contributed by BTernaryTau, 16-Sep-2026.)
theorem onf1onf1or (A2 F H: class):
  $ wi (wf1 A2 con0 F) (wo (wf1 A2 con0 F) (wf1 con0 A2 H)) $;

--| If ` F ` maps the proper class ` W ` one-to-one into the ordinals or ` H ` maps the ordinals one-to-one into the proper class ` W ` , and if every set can either be mapped one-to-one into the ordinals or have the ordinals mapped one-to-one into it, then ` R ` well-orders the universe. This is the ZFC version of (9 ` -> ` 3) in ~ https://tinyurl.com/hamkins-gblac . Note that in NBG set theory the first two hypotheses would be replaced by something like ` ( ph -> A. X ( E. F F : X -1-1-> On \/ E. H H : On -1-1-> X ) ) ` . However, we cannot quantify over classes, so we split this into the case where ` X ` is a set and the case where ` X ` is the proper class ` W ` which together are sufficient for this proof. (Contributed by BTernaryTau, 16-Sep-2026.)
theorem onf1oracwevd {x3 y1 z w v f2 h r: setvar} (ph: wff x3 z w v f2 h r) (A2: class x3 y1 w v f2 h r) (R: class x3 y1 z w v f2 h r) (F: class x3 v f2 h r) (H: class x3 y1 z w v f2 h r) (I W: class x3 v f2 h r):
  $ wi ph (wo (wf1 W con0 F) (wf1 con0 W H)) $ >
  $ wi ph (wal v (wo (wex f2 (wf1 (cv v) con0 (cv f2))) (wex h (wf1 con0 (cv v) (cv h))))) $ >
  $ wceq W (cab r (wrex x3 (wa (wss (cv r) (cxp (cfv (cv x3) cr1) (cfv (cv x3) cr1))) (wwe (cfv (cv x3) cr1) (cv r))) con0)) $ >
  $ wceq R (copab y1 z (wo (wcel (cfv (cv y1) crnk) (cfv (cv z) crnk)) (wa (wceq (cfv (cv y1) crnk) (cfv (cv z) crnk)) (wbr (cv y1) (cv z) A2)))) $ >
  $ wceq A2 (cfv (cint (crab w (wwe (cfv (csuc (cfv (cv y1) crnk)) cr1) (cfv (cv w) I)) con0)) I) $ >
  $ wceq I (cif (wf1 W con0 F) (ccnv F) H) $ >
  $ wi ph (wwe cvv R) $;

--| If ` F ` is a bijection from the ordinals to the universe and ` H ` is a bijection from the ordinals to the proper class ` B ` , then ` I ` maps ` A ` one-to-one into ` B ` . This is the ZFC version of (5 ` -> ` 10) in ~ https://tinyurl.com/hamkins-gblac in the case where one of the classes is a proper class. See ~ onprcf1of1orbd for the case where neither class is a proper class, and see ~ onprcf1of1ord for a theorem that covers both cases. Note that in NBG set theory the first two hypotheses would be replaced by something like ` ( ph -> A. X ( -. X e. _V -> E. F F : On -1-1-onto-> X ) ) ` . However, we cannot quantify over classes, so we split this into the case where ` X ` is the universe and the case where ` X ` is an arbitrary proper class ` B ` which together are sufficient for this proof. (Contributed by BTernaryTau, 17-Sep-2026.)
theorem onprcf1of1orad (ph: wff) (A2 B2 F H I: class):
  $ wi ph (wf1o con0 cvv F) $ >
  $ wi ph (wi (wn (wcel B2 cvv)) (wf1o con0 B2 H)) $ >
  $ wi ph (wn (wcel B2 cvv)) $ >
  $ wceq I (ccom H (cres (ccnv F) A2)) $ >
  $ wi ph (wf1 A2 B2 I) $;

--| If ` F ` is a bijection from the ordinals to the universe and both ` A ` and ` B ` are sets, then either ` A ` can be mapped one-to-one into ` B ` or ` B ` can be mapped one-to-one into ` A ` . This is the ZFC version of (5 ` -> ` 10) in ~ https://tinyurl.com/hamkins-gblac in the case where neither class is a proper class. See ~ onprcf1of1orad for the case where one of the classes is a proper class, and see ~ onprcf1of1ord for a theorem that covers both cases. Note that in NBG set theory the first hypothesis would be replaced by something like ` ( ph -> A. X ( -. X e. _V -> E. F F : On -1-1-onto-> X ) ) ` , but since we cannot quantify over classes, we instead consider only the case ` X = _V ` which is sufficient for this proof. (Contributed by BTernaryTau, 17-Sep-2026.)
theorem onprcf1of1orbd {f2 h: setvar} (ph: wff f2 h) (A2 B2: class) (F V W: class f2 h):
  $ wi ph (wf1o con0 cvv F) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wo (wex f2 (wf1 A2 B2 (cv f2))) (wex h (wf1 B2 A2 (cv h)))) $;

--| If ` F ` is a bijection from the ordinals to the universe and both ` A ` and ` B ` are sets, then either ` A ` can be mapped one-to-one into ` B ` or ` B ` can be mapped one-to-one into ` A ` . This is the ZFC version of (5 ` -> ` 10) in ~ https://tinyurl.com/hamkins-gblac in the case where neither class is a proper class. See ~ onprcf1of1orad for the case where one of the classes is a proper class, and see ~ onprcf1of1ord for a theorem that covers both cases. Note that in NBG set theory the first hypothesis would be replaced by something like ` ( ph -> A. X ( -. X e. _V -> E. F F : On -1-1-onto-> X ) ) ` , but since we cannot quantify over classes, we instead consider only the case ` X = _V ` which is sufficient for this proof. (Contributed by BTernaryTau, 17-Sep-2026.)
theorem onprcf1of1orbd_b {f2: setvar} (ph: wff f2) (A2 B2: class) (F V W: class f2):
  $ wi ph (wf1o con0 cvv F) $ >
  $ wi ph (wcel A2 V) $ >
  $ wi ph (wcel B2 W) $ >
  $ wi ph (wo (wex f2 (wf1 A2 B2 (cv f2))) (wex f2 (wf1 B2 A2 (cv f2)))) $;

--| If ` F ` is a bijection from the ordinals to the universe, ` H ` is a bijection from the ordinals to ` A ` if ` A ` is a proper class, and ` I ` is a bijection from the ordinals to ` B ` if ` B ` is a proper class, then ` J ` either maps ` A ` one-to-one into ` B ` or maps ` B ` one-to-one into ` A ` . This is the ZFC version of (5 ` -> ` 10) in ~ https://tinyurl.com/hamkins-gblac . Note that in NBG set theory the first three hypotheses would be replaced by something like ` ( ph -> A. X ( -. X e. _V -> E. F F : On -1-1-onto-> X ) ) ` . However, we cannot quantify over classes, so we split this into the case where ` X ` is the universe, the case where ` X ` is an arbitrary proper class ` A ` , and the case where ` X ` is an arbitrary proper class ` B ` , which together are sufficient for this proof. (Contributed by BTernaryTau, 17-Sep-2026.)
theorem onprcf1of1ord {x3: setvar} (ph: wff x3) (A2 B2 F: class) (H I J K: class x3):
  $ wi ph (wf1o con0 cvv F) $ >
  $ wi ph (wi (wn (wcel A2 cvv)) (wf1o con0 A2 H)) $ >
  $ wi ph (wi (wn (wcel B2 cvv)) (wf1o con0 B2 I)) $ >
  $ wceq J (cif (wcel A2 cvv) (cif (wcel B2 cvv) K (ccom I (cres (ccnv F) A2))) (ccom H (cres (ccnv F) B2))) $ >
  $ wceq K (cfv (cint (crab x3 (wo (wf1 A2 B2 (cfv (cv x3) F)) (wf1 B2 A2 (cfv (cv x3) F))) con0)) F) $ >
  $ wi ph (wo (wf1 A2 B2 J) (wf1 B2 A2 J)) $;

--| If ` F ` maps ` A ` one-to-one into the ordinals or ` H ` maps the ordinals one-to-one into ` A ` , then either ` A ` can be mapped one-to-one into the ordinals (by ` F ` ), or the ordinals can be mapped one-to-one into ` A ` (by ` H ` ). This is the ZFC version of (10 ` -> ` 9) in ~ https://tinyurl.com/hamkins-gblac . Note that in NBG set theory the antecedent would be something like ` A. A A. X ( E. F F : A -1-1-> X \/ E. H H : X -1-1-> A ) ` , but since we cannot quantify over classes, we instead consider only the case ` X = On ` which is sufficient for this proof. The proof is trivial but is included for completeness. (Contributed by BTernaryTau, 17-Sep-2026.)
theorem f1oronf1or (A2 F H: class):
  $ wi (wo (wf1 A2 con0 F) (wf1 con0 A2 H)) (wo (wf1 A2 con0 F) (wf1 con0 A2 H)) $;

--| Integer ordering relation. (Contributed by BTernaryTau, 24-Sep-2023.)
theorem zltp1ne (A2 B2: class):
  $ wi (wa (wcel A2 cz) (wcel B2 cz)) (wb (wbr (co A2 c1 caddc) B2 clt) (wa (wbr A2 B2 clt) (wne B2 (co A2 c1 caddc)))) $;

--| Positive integer ordering relation. (Contributed by BTernaryTau, 24-Sep-2023.)
theorem nnltp1ne (A2 B2: class):
  $ wi (wa (wcel A2 cn) (wcel B2 cn)) (wb (wbr (co A2 c1 caddc) B2 clt) (wa (wbr A2 B2 clt) (wne B2 (co A2 c1 caddc)))) $;

--| Nonnegative integer ordering relation. (Contributed by BTernaryTau, 24-Sep-2023.)
theorem nn0ltp1ne (A2 B2: class):
  $ wi (wa (wcel A2 cn0) (wcel B2 cn0)) (wb (wbr (co A2 c1 caddc) B2 clt) (wa (wbr A2 B2 clt) (wne B2 (co A2 c1 caddc)))) $;

--| A finite set is equal to its subset if they are the same size. (Contributed by BTernaryTau, 3-Oct-2023.)
theorem fisshasheq (A2 B2: class):
  $ wi (w3a (wcel B2 cfn) (wss A2 B2) (wceq (cfv A2 chash) (cfv B2 chash))) (wceq A2 B2) $;

--| The Fundamental Theorem of Enumeration. According to Doron Zeilberger (in ~ https://sites.math.rutgers.edu/~~zeilberg/mamarim/mamarimPDF/enu.pdf ), this theorem was independently discovered by several anonymous cave-dwellers. Zeilberger also states that "While this formula is still useful after all these years, enumerating specific finite sets is no longer considered mathematics. A genuine mathematical fact has to incorporate infinitely many facts". Fortunately, theorems in Metamath are actually theorem schemes that correspond to an infinite number of object-language theorems, so this concern does not apply to us. See ~ 1enumen for a version that uses equinumerosity , ~ 1enumcard for a version that uses the ` card ` function, and ~ 1enumkard for a version that uses the ` kard ` function. (Contributed by BTernaryTau, 26-Jun-2026.)
theorem _1enum {a: setvar} (A2: class):
  $ wi (wcel A2 cfn) (wceq (cfv A2 chash) (csu a A2 c1)) $;

--| Any two (distinct) vertices in a complete graph are connected to each other by at least one edge. (Contributed by BTernaryTau, 2-Oct-2023.)
theorem cplgredgex {e: setvar} (A2 B2 E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wcel G ccplgr) (wi (wa (wcel A2 V) (wcel B2 (cdif V (csn A2)))) (wrex e (wss (cpr A2 B2) (cv e)) E)) $;

--| Any two (distinct) vertices in a complete simple graph are connected to each other by an edge. (Contributed by BTernaryTau, 3-Oct-2023.)
theorem cusgredgex (A2 B2 E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wcel G ccusgr) (wi (wa (wcel A2 V) (wcel B2 (cdif V (csn A2)))) (wcel (cpr A2 B2) E)) $;

--| Any two distinct vertices in a complete simple graph are connected to each other by an edge. (Contributed by BTernaryTau, 4-Oct-2023.)
theorem cusgredgex2 (A2 B2 E G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq E (cfv G cedg) $ >
  $ wi (wcel G ccusgr) (wi (w3a (wcel A2 V) (wcel B2 V) (wne A2 B2)) (wcel (cpr A2 B2) E)) $;

--| Two words represent a walk if and only if their reverses also represent a walk. (Contributed by BTernaryTau, 4-Dec-2023.)
theorem revwlkb (P U F G W: class):
  $ wi (wa (wcel F (cword W)) (wcel P (cword U))) (wb (wbr F P (cfv G cwlks)) (wbr (cfv F creverse) (cfv P creverse) (cfv G cwlks))) $;

--| A non-trivial cycle in a simple graph has a length greater than 2. (Contributed by BTernaryTau, 24-Sep-2023.)
theorem usgrgt2cycl (P F G: class):
  $ wi (w3a (wcel G cusgr) (wbr F P (cfv G ccycls)) (wne F c0)) (wbr c2 (cfv F chash) clt) $;

--| A simple graph with a non-trivial cycle must have at least 3 vertices. (Contributed by BTernaryTau, 5-Oct-2023.)
theorem usgrcyclgt2v (P F G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (w3a (wcel G cusgr) (wbr F P (cfv G ccycls)) (wne F c0)) (wbr c2 (cfv V chash) clt) $;

--| Every complete simple graph with more than two vertices has a 3-cycle. (Contributed by BTernaryTau, 4-Oct-2023.)
theorem cusgr3cyclex {f2 p: setvar} (G: class) (V: class f2 p):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel G ccusgr) (wbr c2 (cfv V chash) clt)) (wex f2 (wex p (wa (wbr (cv f2) (cv p) (cfv G ccycls)) (wceq (cfv (cv f2) chash) c3)))) $;

--| Construction of a 2-cycle from two given edges in a graph. (Contributed by BTernaryTau, 16-Oct-2023.)
theorem _2cycl2d (ph: wff) (A2 B2 P F G I J K V: class):
  $ wceq P (cs3 A2 B2 A2) $ >
  $ wceq F (cs2 J K) $ >
  $ wi ph (wa (wcel A2 V) (wcel B2 V)) $ >
  $ wi ph (wne A2 B2) $ >
  $ wi ph (wa (wss (cpr A2 B2) (cfv J I)) (wss (cpr A2 B2) (cfv K I))) $ >
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi ph (wne J K) $ >
  $ wi ph (wbr F P (cfv G ccycls)) $;

--| A null graph (with no vertices) is an acyclic graph. (Contributed by BTernaryTau, 11-Oct-2023.)
theorem acycgr0v (G V W: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel G W) (wceq V c0)) (wcel G cacycgr) $;

--| A multigraph with one vertex is an acyclic graph. (Contributed by BTernaryTau, 12-Oct-2023.)
theorem acycgr1v (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel G cumgr) (wceq (cfv V chash) c1)) (wcel G cacycgr) $;

--| A simple graph with two vertices is an acyclic graph. (Contributed by BTernaryTau, 12-Oct-2023.)
theorem acycgr2v (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wa (wcel G cusgr) (wceq (cfv V chash) c2)) (wcel G cacycgr) $;

--| A proper class (representing a null graph, see ~ vtxvalprc ) has the property of an acyclic graph (see also ~ acycgr0v ). (Contributed by BTernaryTau, 11-Oct-2023.) (New usage is discouraged.)
theorem prclisacycgr {f2 p: setvar} (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wn (wcel G cvv)) (wn (wex f2 (wex p (wa (wbr (cv f2) (cv p) (cfv G ccycls)) (wne (cv f2) c0))))) $;

--| An acyclic hypergraph is a loop-free hypergraph. (Contributed by BTernaryTau, 15-Oct-2023.)
theorem acycgrislfgr {x3: setvar} (G: class) (I: class x3) (V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wceq I (cfv G ciedg) $ >
  $ wi (wa (wcel G cacycgr) (wcel G cuhgr)) (wf (cdm I) (crab x3 (wbr c2 (cfv (cv x3) chash) cle) (cpw V)) I) $;

--| An acyclic pseudograph is a multigraph. (Contributed by BTernaryTau, 15-Oct-2023.)
theorem upgracycumgr (G: class):
  $ wi (wa (wcel G cupgr) (wcel G cacycgr)) (wcel G cumgr) $;

--| An acyclic multigraph is a simple graph. (Contributed by BTernaryTau, 17-Oct-2023.)
theorem umgracycusgr (G: class):
  $ wi (wa (wcel G cumgr) (wcel G cacycgr)) (wcel G cusgr) $;

--| An acyclic pseudograph is a simple graph. (Contributed by BTernaryTau, 17-Oct-2023.)
theorem upgracycusgr (G: class):
  $ wi (wa (wcel G cupgr) (wcel G cacycgr)) (wcel G cusgr) $;

--| A complete simple graph is acyclic if and only if it has fewer than three vertices. (Contributed by BTernaryTau, 20-Oct-2023.)
theorem cusgracyclt3v (G V: class):
  $ wceq V (cfv G cvtx) $ >
  $ wi (wcel G ccusgr) (wb (wcel G cacycgr) (wbr (cfv V chash) c3 clt)) $;

--| A path in an acyclic graph is a simple path. (Contributed by BTernaryTau, 21-Oct-2023.)
theorem pthacycspth (P F G: class):
  $ wi (wa (wcel G cacycgr) (wbr F P (cfv G cpths))) (wbr F P (cfv G cspths)) $;

--| The subgraph of an acyclic graph is also acyclic. (Contributed by BTernaryTau, 23-Oct-2023.)
theorem acycgrsubgr (S G: class):
  $ wi (wa (wcel G cacycgr) (wbr S G csubgr)) (wcel S cacycgr) $;

--| Extend wff notation to include a predicate for standard models of the Axiom of Extensionality.
term wsmext (M: class): wff;

--| Extend wff notation to include a predicate for standard models of a strong version of the Axiom Scheme of Replacement.
term wsmrep (M: class): wff;

--| Define the standard model of Extensionality predicate, which is true for a class that is a model of the Axiom of Extensionality under the membership predicate. Our notation is similar to that of ~ df-prv and ~ df-gzext ( ` M |= AxExt ` ), but ` M |=. Ax-Ext ` uses a different double turnstile character and a different format for the axiom name. (Contributed by BTernaryTau, 2-Oct-2026.)
axiom df_smext {x3 y1 z: setvar} (M: class):
  $ wb (wsmext M) (wral x3 (wral y1 (wi (wral z (wb (wcel (cv z) (cv x3)) (wcel (cv z) (cv y1))) M) (wceq (cv x3) (cv y1))) M) M) $;

--| Define the strong Axiom Scheme of Replacement predicate, which is true for a class that is a standard model of the strong version of the Axiom Scheme of Replacement used in ~ wfaxrep (see comments there). Our notation includes an asterisk because we cannot guarantee that a standard model of the Axiom Scheme of Replacement will also be a standard model of this strong version. However, proving that a class is a standard model of the strong Axiom Scheme of Replacement is sufficient to prove that it is also a standard model of the ZF Axiom Scheme of Replacement. The exact expression used in ~ wfaxrep is unsuitable for use in a definition because it contains a wff metavariable that we cannot quantify over. Instead, this definition uses the specific instance where ` ph ` is replaced with ` ( Fun f /\ w e. dom f /\ ( f `` w ) = z ) ` . This allows the set ` f ` to effectively take on the role of the function-like wff, and since ` f ` is a setvar, we are free to add a universal quantifier over it. The full scheme can then be recovered from this definition using ~ smrepsrep . This approach works because we can use our ~ ax-rep to guarantee the existence of a suitable ` f ` in ` _V ` for any ` x ` and function-like ` ph ` . Note that ` M ` is not guaranteed to contain a suitable ` f ` (since it might not model the necessary axioms), so we must use an unrestricted universal quantifier for ` f ` . (Contributed by BTernaryTau, 30-Sep-2026.)
axiom df_smrep {x3 y1 z w f2: setvar} (M: class):
  $ wb (wsmrep M) (wal f2 (wral x3 (wi (wral w (wrex y1 (wral z (wi (wal y1 (w3a (wfun (cv f2)) (wcel (cv w) (cdm (cv f2))) (wceq (cfv (cv w) (cv f2)) (cv z)))) (wceq (cv z) (cv y1))) M) M) M) (wrex y1 (wral z (wb (wcel (cv z) (cv y1)) (wrex w (wa (wcel (cv w) (cv x3)) (wal y1 (w3a (wfun (cv f2)) (wcel (cv w) (cdm (cv f2))) (wceq (cfv (cv w) (cv f2)) (cv z))))) M)) M) M)) M)) $;

--| Lemma for ~ srepdf . (Contributed by BTernaryTau, 30-Sep-2026.)
theorem srepdflem1 {x3 y1 z w: setvar} (ph ps: wff x3 y1 z w) (F G: class x3 y1 z w) (M: class x3):
  $ wnf w ph $ >
  $ wi ph (wral w (wrex y1 (wral z (wi (wal y1 ps) (wceq (cv z) (cv y1))) M) M) M) $ >
  $ wceq F (cres G (cv x3)) $ >
  $ wceq G (copab w z (w3a (wcel (cv w) M) (wcel (cv z) M) (wal y1 ps))) $ >
  $ wi (wa ph (wcel (cv z) M)) (wb (wrex w (wa (wcel (cv w) (cv x3)) (wal y1 ps)) M) (wrex w (wa (wcel (cv w) (cv x3)) (wal y1 (w3a (wfun F) (wcel (cv w) (cdm F)) (wceq (cfv (cv w) F) (cv z))))) M)) $;

--| Lemma for ~ srepdf . (Contributed by BTernaryTau, 30-Sep-2026.)
theorem srepdflem2 {x3 y1 z w f2: setvar} (ph ps: wff x3 y1 z w f2) (F: class x3 y1 z w) (G: class x3 y1 z w f2) (M: class x3):
  $ wnf f2 ph $ >
  $ wnf w ph $ >
  $ wnf y1 ph $ >
  $ wnf z ph $ >
  $ wi ph (wcel (cv x3) M) $ >
  $ wi ph (wi (wral w (wrex y1 (wral z (wi (wal y1 (w3a (wfun (cv f2)) (wcel (cv w) (cdm (cv f2))) (wceq (cfv (cv w) (cv f2)) (cv z)))) (wceq (cv z) (cv y1))) M) M) M) (wrex y1 (wral z (wb (wcel (cv z) (cv y1)) (wrex w (wa (wcel (cv w) (cv x3)) (wal y1 (w3a (wfun (cv f2)) (wcel (cv w) (cdm (cv f2))) (wceq (cfv (cv w) (cv f2)) (cv z))))) M)) M) M)) $ >
  $ wi ph (wral w (wrex y1 (wral z (wi (wal y1 ps) (wceq (cv z) (cv y1))) M) M) M) $ >
  $ wceq F (cres G (cv x3)) $ >
  $ wceq G (copab w z (w3a (wcel (cv w) M) (wcel (cv z) M) (wal y1 ps))) $ >
  $ wi ph (wrex y1 (wral z (wb (wcel (cv z) (cv y1)) (wrex w (wa (wcel (cv w) (cv x3)) (wal y1 ps)) M)) M) M) $;

--| Derive the strong version of the Axiom Scheme of Replacement used in ~ wfaxrep (see comments there) from a particular instance of that version of Replacement. Note that this theorem depends on ~ ax-rep , so it does not follow that we could replace ~ ax-rep with an axiom that lacks a wff metavariable. (Contributed by BTernaryTau, 30-Sep-2026.)
theorem srepdf {x3 y1 z w f2: setvar} (ph ps: wff x3 y1 z w f2) (M: class x3):
  $ wnf f2 ph $ >
  $ wnf w ph $ >
  $ wnf x3 ph $ >
  $ wnf y1 ph $ >
  $ wnf z ph $ >
  $ wi ph (wral x3 (wi (wral w (wrex y1 (wral z (wi (wal y1 (w3a (wfun (cv f2)) (wcel (cv w) (cdm (cv f2))) (wceq (cfv (cv w) (cv f2)) (cv z)))) (wceq (cv z) (cv y1))) M) M) M) (wrex y1 (wral z (wb (wcel (cv z) (cv y1)) (wrex w (wa (wcel (cv w) (cv x3)) (wal y1 (w3a (wfun (cv f2)) (wcel (cv w) (cdm (cv f2))) (wceq (cfv (cv w) (cv f2)) (cv z))))) M)) M) M)) M) $ >
  $ wi ph (wral x3 (wi (wral w (wrex y1 (wral z (wi (wal y1 ps) (wceq (cv z) (cv y1))) M) M) M) (wrex y1 (wral z (wb (wcel (cv z) (cv y1)) (wrex w (wa (wcel (cv w) (cv x3)) (wal y1 ps)) M)) M) M)) M) $;

--| Derive the strong version of the Axiom Scheme of Replacement used in ~ wfaxrep (see comments there) from ` M |=. Ax-Rep* ` . (Contributed by BTernaryTau, 30-Sep-2026.)
theorem smrepsrep {x3 y1 z w: setvar} (ph: wff x3 y1 z w) (M: class):
  $ wi (wsmrep M) (wral x3 (wi (wral w (wrex y1 (wral z (wi (wal y1 ph) (wceq (cv z) (cv y1))) M) M) M) (wrex y1 (wral z (wb (wcel (cv z) (cv y1)) (wrex w (wa (wcel (cv w) (cv x3)) (wal y1 ph)) M)) M) M)) M) $;

--| The universe is a standard model of the Axiom of Extensionality. (Contributed by BTernaryTau, 2-Oct-2026.)
theorem vsmext:
  $ wsmext cvv $;

--| The universe is a standard model of the strong Axiom Scheme of Replacement. (Contributed by BTernaryTau, 2-Oct-2026.)
theorem vsmrep:
  $ wsmrep cvv $;

--| Distinct variable version of ~ ax-11 . (Contributed by Mario Carneiro, 14-Aug-2015.)
axiom ax_7d {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wal x3 (wal y1 ph)) (wal y1 (wal x3 ph)) $;

--| Distinct variable version of ~ ax-7 . (Contributed by Mario Carneiro, 14-Aug-2015.)
axiom ax_8d (x3 y1 z: setvar):
  $ wi (wceq (cv x3) (cv y1)) (wi (wceq (cv x3) (cv z)) (wceq (cv y1) (cv z))) $;

--| Distinct variable version of ~ ax-6 , equal variables case. (Contributed by Mario Carneiro, 14-Aug-2015.)
axiom ax_9d1 {x3: setvar}:
  $ wn (wal x3 (wn (wceq (cv x3) (cv x3)))) $;

--| Distinct variable version of ~ ax-6 , distinct variables case. (Contributed by Mario Carneiro, 14-Aug-2015.)
axiom ax_9d2 {x3: setvar} (y1: setvar):
  $ wn (wal x3 (wn (wceq (cv x3) (cv y1)))) $;

--| Distinct variable version of ~ axc11n . (Contributed by Mario Carneiro, 14-Aug-2015.)
axiom ax_10d {x3 y1: setvar}:
  $ wi (wal x3 (wceq (cv x3) (cv y1))) (wal y1 (wceq (cv y1) (cv x3))) $;

--| Distinct variable version of ~ ax-12 . (Contributed by Mario Carneiro, 14-Aug-2015.)
axiom ax_11d {x3 y1: setvar} (ph: wff x3 y1):
  $ wi (wceq (cv x3) (cv y1)) (wi (wal y1 ph) (wal x3 (wi (wceq (cv x3) (cv y1)) ph))) $;

--| The quartic equation, written out in full. This actually makes a fairly good Metamath stress test. Note that the length of this formula could be shortened significantly if the intermediate expressions were expanded and simplified, but it's not like this theorem will be used anyway. (Contributed by Mario Carneiro, 6-May-2015.)
theorem quartfull (ph: wff) (A2 B2 C D X: class):
  $ wi ph (wcel A2 cc) $ >
  $ wi ph (wcel B2 cc) $ >
  $ wi ph (wcel C cc) $ >
  $ wi ph (wcel D cc) $ >
  $ wi ph (wcel X cc) $ >
  $ wi ph (wne (co (co (co (co (co (cneg (co c2 (co (co B2 (co (co c3 c8 cdiv) (co A2 c2 cexp) cmul) cmin) c3 cexp) cmul)) (co (cdc c2 c7) (co (co (co C (co (co A2 B2 cmul) c2 cdiv) cmin) (co (co A2 c3 cexp) c8 cdiv) caddc) c2 cexp) cmul) cmin) (co (cdc c7 c2) (co (co B2 (co (co c3 c8 cdiv) (co A2 c2 cexp) cmul) cmin) (co (co D (co (co C A2 cmul) c4 cdiv) cmin) (co (co (co (co A2 c2 cexp) B2 cmul) (cdc c1 c6) cdiv) (co (co c3 (cdc (cdc c2 c5) c6) cdiv) (co A2 c4 cexp) cmul) cmin) caddc) cmul) cmul) caddc) (cfv (co (co (co (co (cneg (co c2 (co (co B2 (co (co c3 c8 cdiv) (co A2 c2 cexp) cmul) cmin) c3 cexp) cmul)) (co (cdc c2 c7) (co (co (co C (co (co A2 B2 cmul) c2 cdiv) cmin) (co (co A2 c3 cexp) c8 cdiv) caddc) c2 cexp) cmul) cmin) (co (cdc c7 c2) (co (co B2 (co (co c3 c8 cdiv) (co A2 c2 cexp) cmul) cmin) (co (co D (co (co C A2 cmul) c4 cdiv) cmin) (co (co (co (co A2 c2 cexp) B2 cmul) (cdc c1 c6) cdiv) (co (co c3 (cdc (cdc c2 c5) c6) cdiv) (co A2 c4 cexp) cmul) cmin) caddc) cmul) cmul) caddc) c2 cexp) (co c4 (co (co (co (co B2 (co (co c3 c8 cdiv) (co A2 c2 cexp) cmul) cmin) c2 cexp) (co (cdc c1 c2) (co (co D (co (co C A2 cmul) c4 cdiv) cmin) (co (co (co (co A2 c2 cexp) B2 cmul) (cdc c1 c6) cdiv) (co (co c3 (cdc (cdc c2 c5) c6) cdiv) (co A2 c4 cexp) cmul) cmin) caddc) cmul) caddc) c3 cexp) cmul) cmin) csqrt) caddc) c2 cdiv) (co c1 c3 cdiv) ccxp) cc0) $ >

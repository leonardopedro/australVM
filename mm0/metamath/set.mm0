  $ wceq (co c7 c2 caddc) c9 $;

--| 1 times 1 equals 1. (Contributed by David A. Wheeler, 7-Jul-2016.)
theorem _1t1e1:
  $ wceq (co c1 c1 cmul) c1 $;

--| 2 times 1 equals 2. (Contributed by David A. Wheeler, 6-Dec-2018.)
theorem _2t1e2:
  $ wceq (co c2 c1 cmul) c2 $;


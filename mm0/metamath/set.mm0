  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv U clss) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wcel (cfv X M) (crn M)) $;

--| Converse of the value of the map defined by ~ df-mapd . (Contributed by NM, 13-Mar-2015.) (New usage is discouraged.)
theorem mapdcnvid1N (ph: wff) (S U H K M W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv U clss) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wceq (cfv (cfv X M) (ccnv M)) X) $;

--| Strong ordering property of themap defined by ~ df-mapd . (Contributed by NM, 13-Mar-2015.)
theorem mapdsord (ph: wff) (S U H K M W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv U clss) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wcel Y S) $ >
  $ wi ph (wb (wpss (cfv X M) (cfv Y M)) (wpss X Y)) $;

--| The mapping of a subspace of vector space H is a subspace in the dual space of functionals with closed kernels. (Contributed by NM, 31-Jan-2015.)
theorem mapdcl2 (ph: wff) (C R S T U H K M W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq T (cfv C clss) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel R S) $ >
  $ wi ph (wcel (cfv R M) T) $;

--| Value of the converse of the map defined by ~ df-mapd . (Contributed by NM, 13-Mar-2015.)
theorem mapdcnvid2 (ph: wff) (H K M W X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (crn M)) $ >
  $ wi ph (wceq (cfv (cfv X (ccnv M)) M) X) $;

--| Ordering property of the converse of the map defined by ~ df-mapd . (Contributed by NM, 13-Mar-2015.) (New usage is discouraged.)
theorem mapdcnvordN (ph: wff) (H K M W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (crn M)) $ >
  $ wi ph (wcel Y (crn M)) $ >
  $ wi ph (wb (wss (cfv X (ccnv M)) (cfv Y (ccnv M))) (wss X Y)) $;

--| The converse of the map defined by ~ df-mapd is one-to-one. (Contributed by NM, 13-Mar-2015.) (New usage is discouraged.)
theorem mapdcnv11N (ph: wff) (H K M W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (crn M)) $ >
  $ wi ph (wcel Y (crn M)) $ >
  $ wi ph (wb (wceq (cfv X (ccnv M)) (cfv Y (ccnv M))) (wceq X Y)) $;

--| Covering property of the converse of the map defined by ~ df-mapd . (Contributed by NM, 14-Mar-2015.)
theorem mapdcv (ph: wff) (C D S U E H K M W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq C (cfv U clcv) $ >
  $ wceq D (cfv W (cfv K clcd)) $ >
  $ wceq E (cfv D clcv) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wcel Y S) $ >
  $ wi ph (wb (wbr X Y C) (wbr (cfv X M) (cfv Y M) E)) $;

--| Closure of dual subspace intersection for the map defined by ~ df-mapd . (Contributed by NM, 12-Apr-2015.)
theorem mapdincl (ph: wff) (C U H K M W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (crn M)) $ >
  $ wi ph (wcel Y (crn M)) $ >
  $ wi ph (wcel (cin X Y) (crn M)) $;

--| Subspace intersection is preserved by the map defined by ~ df-mapd . Part of property (e) in [Baer] p. 40. (Contributed by NM, 12-Apr-2015.)
theorem mapdin (ph: wff) (S U H K M W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv U clss) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wcel Y S) $ >
  $ wi ph (wceq (cfv (cin X Y) M) (cin (cfv X M) (cfv Y M))) $;

--| Closure of dual subspace sum for the map defined by ~ df-mapd . (Contributed by NM, 13-Mar-2015.)
theorem mapdlsmcl (ph: wff) (C c_po U H K M W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq c_po (cfv C clsm) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X (crn M)) $ >
  $ wi ph (wcel Y (crn M)) $ >
  $ wi ph (wcel (co X Y c_po) (crn M)) $;

--| Subspace sum is preserved by the map defined by ~ df-mapd . Part of property (e) in [Baer] p. 40. (Contributed by NM, 13-Mar-2015.)
theorem mapdlsm (ph: wff) (C c_pb c_po S U H K M W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq S (cfv U clss) $ >
  $ wceq c_po (cfv U clsm) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq c_pb (cfv C clsm) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X S) $ >
  $ wi ph (wcel Y S) $ >
  $ wi ph (wceq (cfv (co X Y c_po) M) (co (cfv X M) (cfv Y M) c_pb)) $;

--| Projectivity map of the zero subspace. Part of property (f) in [Baer] p. 40. TODO: does proof need to be this long for this simple fact? (Contributed by NM, 15-Mar-2015.)
theorem mapd0 (ph: wff) (C U H K M O W c_0: class):
  $ wceq H (cfv K clh) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq O (cfv U c0g) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq c_0 (cfv C c0g) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wceq (cfv (csn O) M) (csn c_0)) $;

--| Atoms are preserved by the map defined by ~ df-mapd . (Contributed by NM, 29-May-2015.) (New usage is discouraged.)
theorem mapdcnvatN (ph: wff) (A2 B2 C Q U H K M W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq B2 (cfv C clsa) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel Q B2) $ >
  $ wi ph (wcel (cfv Q (ccnv M)) A2) $;

--| Atoms are preserved by the map defined by ~ df-mapd . Property (g) in [Baer] p. 41. (Contributed by NM, 14-Mar-2015.)
theorem mapdat (ph: wff) (A2 B2 C Q U H K M W: class):
  $ wceq H (cfv K clh) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq A2 (cfv U clsa) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq B2 (cfv C clsa) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel Q A2) $ >
  $ wi ph (wcel (cfv Q M) B2) $;

--| The map of a span equals the dual span of some vector (functional). (Contributed by NM, 15-Mar-2015.)
theorem mapdspex {g2: setvar} (ph: wff g2) (B2 C: class) (U H: class g2) (J: class) (K: class g2) (M N: class) (V W: class g2) (X: class):
  $ wceq H (cfv K clh) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq B2 (cfv C cbs) $ >
  $ wceq J (cfv C clspn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wrex g2 (wceq (cfv (cfv (csn X) N) M) (cfv (csn (cv g2)) J)) B2) $;

--| Transfer nonzero property from domain to range of projectivity ` mapd ` . (Contributed by NM, 12-Apr-2015.)
theorem mapdn0 (ph: wff) (C D U F H J K M N V W X c_0 Z: class):
  $ wceq H (cfv K clh) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq D (cfv C cbs) $ >
  $ wceq J (cfv C clspn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel F D) $ >
  $ wi ph (wceq (cfv (cfv (csn X) N) M) (cfv (csn F) J)) $ >
  $ wceq c_0 (cfv U c0g) $ >
  $ wceq Z (cfv C c0g) $ >
  $ wi ph (wcel X (cdif V (csn c_0))) $ >
  $ wi ph (wcel F (cdif D (csn Z))) $;

--| Transfer non-colinearity from domain to range of projectivity ` mapd ` . (Contributed by NM, 11-Apr-2015.)
theorem mapdncol (ph: wff) (C D U F G H J K M N V W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq D (cfv C cbs) $ >
  $ wceq J (cfv C clspn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel F D) $ >
  $ wi ph (wceq (cfv (cfv (csn X) N) M) (cfv (csn F) J)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wcel G D) $ >
  $ wi ph (wceq (cfv (cfv (csn Y) N) M) (cfv (csn G) J)) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wne (cfv (csn F) J) (cfv (csn G) J)) $;

--| Transfer (part of) vector independence condition from domain to range of projectivity ` mapd ` . (Contributed by NM, 11-Apr-2015.)
theorem mapdindp (ph: wff) (C D U E F G H J K M N V W X Y Z: class):
  $ wceq H (cfv K clh) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wceq D (cfv C cbs) $ >
  $ wceq J (cfv C clspn) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel F D) $ >
  $ wi ph (wceq (cfv (cfv (csn X) N) M) (cfv (csn F) J)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wi ph (wcel G D) $ >
  $ wi ph (wceq (cfv (cfv (csn Y) N) M) (cfv (csn G) J)) $ >
  $ wi ph (wcel Z V) $ >
  $ wi ph (wcel E D) $ >
  $ wi ph (wceq (cfv (cfv (csn Z) N) M) (cfv (csn E) J)) $ >
  $ wi ph (wn (wcel X (cfv (cpr Y Z) N))) $ >
  $ wi ph (wn (wcel F (cfv (cpr G E) J))) $;

--| Lemma for ~ mapdpg . Baer p. 44, last line: "(F(x-y))* <= (Fx)*+(Fy)*." (Contributed by NM, 15-Mar-2015.)
theorem mapdpglem1 (ph: wff) (C c_po U H K M c_mi N V W X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wceq c_po (cfv C clsm) $ >
  $ wi ph (wss (cfv (cfv (csn (co X Y c_mi)) N) M) (co (cfv (cfv (csn X) N) M) (cfv (cfv (csn Y) N) M) c_po)) $;

--| Lemma for ~ mapdpg . Baer p. 45, lines 1 and 2: "we have (F(x-y))* = Gt where t necessarily belongs to (Fx)*+(Fy)*." (We scope $d ` t ph ` locally to avoid clashes with later substitutions into ` ph ` .) (Contributed by NM, 15-Mar-2015.)
theorem mapdpglem2 {t: setvar} (ph: wff) (C: class) (c_po U H: class t) (J: class) (K: class t) (M c_mi N: class) (V W: class t) (X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wceq c_po (cfv C clsm) $ >
  $ wceq J (cfv C clspn) $ >
  $ wi ph (wrex t (wceq (cfv (cfv (csn (co X Y c_mi)) N) M) (cfv (csn (cv t)) J)) (co (cfv (cfv (csn X) N) M) (cfv (cfv (csn Y) N) M) c_po)) $;

--| Lemma for ~ mapdpg . (Contributed by NM, 20-Mar-2015.)
theorem mapdpglem2a {t: setvar} (ph: wff t) (C: class) (c_po U F H: class t) (J: class) (K: class t) (M c_mi N: class) (V W: class t) (X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wceq c_po (cfv C clsm) $ >
  $ wceq J (cfv C clspn) $ >
  $ wceq F (cfv C cbs) $ >
  $ wi ph (wcel (cv t) (co (cfv (cfv (csn X) N) M) (cfv (cfv (csn Y) N) M) c_po)) $ >
  $ wi ph (wcel (cv t) F) $;

--| Lemma for ~ mapdpg . Baer p. 45, line 3: "infer ... the existence of a number g in G and of an element z in (Fy)* such that t = gx'-z." (We scope $d ` g w z ph ` locally to avoid clashes with later substitutions into ` ph ` .) (Contributed by NM, 18-Mar-2015.)
theorem mapdpglem3 {z t g2: setvar} (ph: wff t) (A2: class z t g2) (B2: class z t) (C: class) (c_po: class z t g2) (R c_x: class t) (U: class z t g2) (F: class z t) (G: class t) (H: class z t g2) (J: class) (K: class z t g2) (M: class) (c_mi: class z g2) (N: class) (V W: class z t g2) (X: class z g2) (Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wceq c_po (cfv C clsm) $ >
  $ wceq J (cfv C clspn) $ >
  $ wceq F (cfv C cbs) $ >
  $ wi ph (wcel (cv t) (co (cfv (cfv (csn X) N) M) (cfv (cfv (csn Y) N) M) c_po)) $ >
  $ wceq A2 (cfv U csca) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_x (cfv C cvsca) $ >
  $ wceq R (cfv C csg) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wceq (cfv (cfv (csn X) N) M) (cfv (csn G) J)) $ >
  $ wi ph (wrex g2 (wrex z (wceq (cv t) (co (co (cv g2) G c_x) (cv z) R)) (cfv (cfv (csn Y) N) M)) B2) $;

--| Lemma for ~ mapdpg . (Contributed by NM, 20-Mar-2015.) (New usage is discouraged.)
theorem mapdpglem4N {t: setvar} (ph: wff t) (A2 B2: class t) (C: class) (c_po Q R c_x U F G H: class t) (J: class) (K: class t) (M c_mi N: class) (V W: class t) (X Y: class):
  $ wceq H (cfv K clh) $ >
  $ wceq M (cfv W (cfv K cmpd)) $ >
  $ wceq U (cfv W (cfv K cdvh)) $ >
  $ wceq V (cfv U cbs) $ >
  $ wceq c_mi (cfv U csg) $ >
  $ wceq N (cfv U clspn) $ >
  $ wceq C (cfv W (cfv K clcd)) $ >
  $ wi ph (wa (wcel K chlt) (wcel W H)) $ >
  $ wi ph (wcel X V) $ >
  $ wi ph (wcel Y V) $ >
  $ wceq c_po (cfv C clsm) $ >
  $ wceq J (cfv C clspn) $ >
  $ wceq F (cfv C cbs) $ >
  $ wi ph (wcel (cv t) (co (cfv (cfv (csn X) N) M) (cfv (cfv (csn Y) N) M) c_po)) $ >
  $ wceq A2 (cfv U csca) $ >
  $ wceq B2 (cfv A2 cbs) $ >
  $ wceq c_x (cfv C cvsca) $ >
  $ wceq R (cfv C csg) $ >
  $ wi ph (wcel G F) $ >
  $ wi ph (wceq (cfv (cfv (csn X) N) M) (cfv (csn G) J)) $ >
  $ wceq Q (cfv U c0g) $ >
  $ wi ph (wne (cfv (csn X) N) (cfv (csn Y) N)) $ >
  $ wi ph (wne (co X Y c_mi) Q) $;

--| Lemma for ~ mapdpg . (Contributed by NM, 20-Mar-2015.) (New usage is discouraged.)
theorem mapdpglem5N {t: setvar} (ph: wff t) (A2 B2: class t) (C: class) (c_po Q R c_x U F G H: class t) (J: class) (K: class t) (M c_mi N: class) (V W: class t) (X Y: class):
  $ wceq H (cfv K clh) $ >

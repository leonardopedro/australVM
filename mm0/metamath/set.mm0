  $ wb ps (wral i (wi (wcel (csuc (cv i)) (cv n)) (wceq (cfv (csuc (cv i)) (cv f2)) (ciun y1 (cfv (cv i) (cv f2)) (c_bnj14 A2 R (cv y1))))) com) $ >
  $ wb ch (w3a (wfn (cv f2) (cv n)) ph ps) $ >
  $ wceq D (cdif com (csn c0)) $ >
  $ wb bnjwphm (wceq (cfv c0 (cv g2)) (c_bnj14 A2 R (cv x3))) $ >
  $ wb bnjwpsm (wral i (wi (wcel (csuc (cv i)) (cv n)) (wceq (cfv (csuc (cv i)) (cv g2)) (ciun y1 (cfv (cv i) (cv g2)) (c_bnj14 A2 R (cv y1))))) com) $ >
  $ wb bnjwchm (w3a (wfn (cv g2) (cv n)) bnjwphm bnjwpsm) $ >
  $ wb th (wi (w3a (wcel (cv n) D) ch bnjwchm) (wceq (cfv (cv j) (cv f2)) (cfv (cv j) (cv g2)))) $ >
  $ wb (wsbc j th (cv k)) (wi (w3a (wcel (cv n) D) ch bnjwchm) (wceq (cfv (cv k) (cv f2)) (cfv (cv k) (cv g2)))) $ >
  $ wb ta (wral k (wi (wbr (cv k) (cv j) cep) (wsbc j th (cv k))) (cv n)) $ >
  $ wi (wa (wcel (cv j) (cv n)) ta) th $;

